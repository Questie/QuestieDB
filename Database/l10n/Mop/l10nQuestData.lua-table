[28934] = {
  {
    'Esmagando a Coroa‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    'Mate 5 Técnicos da Coroa e use a Bomba de Kório do Garrafuso para destruir uma Carroça de Produtos Químicos a leste da Tumba de Khartut, em Uldum. Em seguida, fale novamente com o Inspetor Estrilo Garrafuso em Ventobravo.‡Убейте 5 техников химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами на заброшенной ферме к востоку от гробницы Хартута, рядом со входом со стороны Танариса. После этого вернитесь к инспектору Кромсу Гвоздезубу в Штормград.‡Tötet 5 Techniker der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich vom Grab des Khartut in Uldum zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡울둠에 있는 카르투트의 무덤 동쪽에서 왕관 폭력배 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가야 합니다.‡Mata a 5 técnicos de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de la Tumba de Khartut, en Uldum. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡‡Tuez 5 Laquais de La Royale et utilisez la Bombe en khorium de Tordboulon pour endommager un Chariot de produits chimiques à l’est de la Tombe de Khartut, dans Uldum, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡消灭5个皇冠技师，并使用滑栓的氪金炸弹摧毁奥丹姆卡塔图陵墓东边的一台药剂车。然后返回暴风城，去见探员斯尼普·滑栓。‡到卡爾吐特之墓東方的奧丹姆，殺掉5名王冠公司暴徒，並且使用凸栓的克銀炸彈來摧毀一台化學貨車，然後回暴風城找巡官史尼卜·凸栓。',
  }
},
[28935] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 техников химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами на заброшенной ферме к востоку от гробницы Хартута, рядом со входом со стороны Танариса. После этого вернитесь к детективу Крямсу Гвоздезубу в Оргриммар.‡Tötet 5 Techniker der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich vom Grab des Khartut in Uldum zu zerstören und kehrt zu Inspektor Snap Schnappbolz in Orgrimmar zurück.‡울둠에 있는 카르투트의 무덤 동쪽에서 왕관 폭력배 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 técnicos de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de la Tumba de Khartut, en Uldum. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡‡Tuez 5 Laquais de La Royale et utilisez la Bombe en khorium de Tordboulon pour endommager un Chariot de produits chimiques à l’est de la Tombe de Khartut, dans Uldum, puis retournez voir l\'Inspecteur Lapince Tordboulon à Hurlevent.‡消灭5个皇冠技师，并使用滑栓的氪金炸弹摧毁奥丹姆卡塔图陵墓东边的一台药剂车。然后返回奥格瑞玛，去见侦探斯奈普·滑栓。‡到卡爾吐特之墓東方的奧丹姆，殺掉5名王冠公司暴徒，並且使用凸栓的克銀炸彈來摧毀一台化學貨車，然後回奧格瑪找警探史內卜·凸栓。',
  }
},
[28936] = {
  {
    'Diva Dilemma‡Дилемма дивы‡Diva-Dilemma‡곤경에 빠진 여가수‡Dilema de divas‡Dilema de divas‡Le dilemme de la diva‡Diva Dilemma‡女歌唱家的窘境',
    nil,
    'Kill 6 naga.‡Убейте 6 наг.‡Tötet 6 Naga.‡나가 6마리를 처치해야 합니다.‡Mata a 6 nagas.‡Mata a 6 nagas.‡Tuez 6 Nagas.‡Kill 6 naga.‡殺死6隻納迦。',
  }
},
[28937] = {
  {
    'Alliance Breadcrumb‡Хлебные крошки Альянса‡Alliance Breadcrumb‡얼라이언스 빵 부스러기 추적‡Miga de la Alianza‡Miga de la Alianza‡Alliance Breadcrumb‡Alliance Breadcrumb‡聯盟的麵包屑',
    nil,
    'Talk to Lady Gurga in Faldir\'s Cove.‡Поговорите с Леди Гаргой в бухте Фальдира.‡Sprecht mit Lady Gurga in der Faldirbucht.‡팔디르의 만에 있는 레이디 가르가와 대화해야 합니다.‡Habla con Lady Gurga en la Cala de Faldir.‡Habla con Lady Gurga en la Cala de Faldir.‡Parlez à Dame Gurga à la Crique de Faldir.‡Talk to Lady Gurga in Faldir\'s Cove.‡去法迪爾海灣與女神格卡說話。',
  }
},
[28938] = {
  {
    'Save the Children‡Спасение маленьких мурлоков‡Rettet die Kinder‡아기들을 구하라‡Salva a los niños‡Salva a los niños‡Sauvez les enfantsa‡救救孩子‡拯救孩子',
    nil,
    'Save 6 baby murlocs.‡Спасите 6 маленьких мурлоков.‡Rettet 6 Murlocbabys.‡아기 멀록 6마리를 구해야 합니다.‡Salva a 6 bebés múrloc.‡Salva a 6 bebés múrloc.‡Sauvez 6 Bébés murlocs.‡拯救6个小鱼人。‡拯救6隻魚人寶寶。',
  }
},
[28939] = {
  {
    '‡Остерегайтесь чужаков‡Vorsicht vor Fremden‡‡No hables con desconocidos‡‡Faites attention aux étrangers‡‡',
    nil,
    '‡Убейте Темночешуя.‡‡‡Mata a Malaescama.‡‡Tuez Sinistrécaille.‡‡',
  }
},
[28940] = {
  {
    '‡Достать противоядие‡‡‡Conseguir el antídoto‡‡L\'antidote‡‡',
    nil,
    '‡Соберите 6 растений.‡‡‡Reúne 6 plantas.‡‡Ramassez 6 plantes.‡‡',
  }
},
[28941] = {
  {
    '‡Трансформация‡‡변신‡Transformación‡Transformación‡‡变形‡變形',
    nil,
    '‡Используйте нейтрализатор конфет на 6 мурлоках.‡‡‡Usa el limpiador de caramelos con 6 múrlocs.‡‡Utilisez le Nettoyeur de bonbons sur 6 Murlocs.‡‡',
  }
},
[28942] = {
  {
    '‡Месть!‡‡‡‡‡‡‡',
    nil,
    '‡Используйте предмет на Темночешуе.‡‡‡Utiliza el objeto en Malaescama.‡‡Utilisez l\'objet sur Sinistrécaille.‡‡',
  }
},
