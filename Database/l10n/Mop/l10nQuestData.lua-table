[5408] = {
  {
    '‡Камни приспешников плети‡Geißelsteine des Dieners‡‡Piedras de la Plaga del esbirro‡Piedras de la Plaga del esbirro‡Pierres du Fléau des serviteurs‡爪牙的天灾石‡',
