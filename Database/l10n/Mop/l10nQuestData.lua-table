},
[3001] = {
  {
    'Procurando Strahad‡В поисках Страхада‡Die Suche nach Strahad‡스트라드를 찾아‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Procure Strahad Farsan na Vila Catraca.‡Поговорите со Страхадом Фарсаном в Кабестане.‡Findet Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선을 찾아가야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Trouver Strahad Farsan, à Cabestan.‡在棘齿城找到斯坦哈德·法尔杉。‡在棘齒城找到斯坦哈德·法爾杉。',
  }
},
[3002] = {
  {
    'O orbe Gordunni‡Сфера Гордунни‡Die Gordunnikugel‡골두니 수정구‡El orbe Gordunni‡El orbe Gordunni‡L\'Orbe Gordunni‡戈杜尼宝珠‡',
    nil,
    'Leve o Orbe Gordunni para Uthel\'nay no Salão Agulhas Negras, em Orgrimmar.‡Отнести сферу Гордунни Утель\'наю в Пристанище Темнотерна в Оргриммаре.‡Bringt die Gordunnikugel zu Uthel\'nay in die Dunkeldornenlodge in Orgrimmar.‡오그리마의 검은장미 오두막에 있는 우텔나이에게 골두니 수정구를 가져가야 합니다.‡Lleva el orbe Gordunni a Uthel\'nay, que está en la Cabaña de Brezo de Orgrimmar.‡Lleva el orbe Gordunni a Uthel\'nay, que está en la Cabaña de Brezo de Orgrimmar.‡Apportez l\'Orbe Gordunni à Uthel\'nay, au pavillon de Buissombre, à Orgrimmar.‡将戈杜尼宝珠交给奥格瑞玛暗木小屋里的尤塞尔奈。‡',
  }
},
[3022] = {
  {
    'Manuseie com cuidado‡Не кантовать!‡Vorsichtig behandeln‡취급 주의‡Un envío frágil‡Un envío frágil‡À manipuler avec soin‡小心运送‡小心運送',
    nil,
    'Leve o Caixote Cuidadosamente Embalado para Erelas Ambarcéu, na Vila de Rut\'theran.‡Отнесите тщательно упакованный ящик Эреласу Янтарному Небу в деревню Рут\'теран.‡Bringt die sorgfältig verpackte Kiste zu Erelas Himmelsbern in das Dorf Rut\'theran.‡루테란 마을에 있는 에렐라스 앰버스카이에게 조심스럽게 포장된 상자를 가져가야 합니다.‡Llévale la caja cuidadosamente empaquetada a Erelas Cieloámbar, que está en Aldea Rut\'theran.‡Llévale la caja cuidadosamente empaquetada a Erelas Cieloámbar, que está en Aldea Rut\'theran.‡Apportez la Caisse soigneusement empaquetée à Erelas Ambreciel, au village de Rut\'theran.‡把仔细包装过的箱子交给鲁瑟兰村的艾瑞拉斯-琥珀。‡把仔細包裝過的木箱交給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[3023] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
