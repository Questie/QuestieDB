},
[28008] = {
  {
    'Procuram-se aventureiros: Bastilha da Presa Negra‡Требуются герои: крепость Темного Клыка‡Abenteurer gesucht: Burg Schattenfang‡모험가 모집: 그림자송곳니 성채‡Se buscan aventureros: Castillo de Colmillo Oscuro‡Se buscan aventureros: Castillo de Colmillo Oscuro‡On recherche : des aventuriers pour le donjon d\'Ombrecroc‡征召冒险者：影牙城堡‡徵集冒險者:影牙城堡',
    nil,
    'Fale com o Comandante Sicário Belmonte.‡Поговорите с командиром стражей смерти Бельмонтом.‡Sprecht mit Todespirscherkommandant Belmont.‡죽음추적자 사령관 벨몬트와 대화해야 합니다.‡Habla con el Comandante Mortacechador Belmont.‡Habla con el Comandante Mortacechador Belmont.‡Parlez au Commandant nécrotraqueur Belmont.‡与死亡猎手指挥官贝尔蒙特交谈。‡與亡靈哨兵指揮官貝爾蒙特交談。',
  }
},
[28009] = {
  {
    'Procuram-se aventureiros: Bastilha da Presa Negra‡Требуются герои: крепость Темного Клыка‡Abenteurer gesucht: Burg Schattenfang‡모험가 모집: 그림자송곳니 성채‡Se buscan aventureros: Castillo de Colmillo Oscuro‡Se buscan aventureros: Castillo de Colmillo Oscuro‡On recherche : des aventuriers pour le donjon d\'Ombrecroc‡征召冒险者：影牙城堡‡徵集冒險者:影牙城堡',
    nil,
    'Fale com o Líder da Matilha Ivar Dentessangue.‡Поговорите с вожаком стаи койотов Иваром Кровавым Клыком.‡Sprecht mit Rudelführer Ivar Blutfang.‡우두머리 이바르 블러드팽과 대화해야 합니다.‡Habla con el maestro de manada Ivar Colmillo de Sangre.‡Habla con el maestro de manada Ivar Colmillo de Sangre.‡Parlez au Chef de meute Ivar Croc-de-sang.‡与狼群首领伊瓦·血牙交谈。‡與狼群首領伊瓦·血牙交談。',
  }
},
[28010] = {
  {
    'Procuram-se aventureiros: Profundezas Negras‡Требуются герои: Непроглядная Пучина‡Abenteurer gesucht: Tiefschwarze Grotte‡모험가 모집: 검은심연 나락‡Se buscan aventureros: Cavernas de Brazanegra‡Se buscan aventureros: Cavernas de Brazanegra‡On recherche : des aventuriers pour les profondeurs de Brassenoire‡征召冒险者：黑暗深渊‡徵集冒險者:黑澗深淵',
    nil,
    'Fale com Je\'neu Sancrea.‡Поговорите с Дже\'неу Санкри.‡Sprecht mit Je\'neu Sancrea.‡제네우 생크리와 대화해야 합니다.‡Habla con Je\'neu Sancrea.‡Habla con Je\'neu Sancrea.‡Parlez à Je\'neu Sancrea.‡与耶努萨克雷交谈。‡和耶努薩克雷談話。',
  }
},
[28011] = {
  {
    'Procuram-se aventureiros: Profundezas Negras‡Требуются герои: Непроглядная Пучина‡Abenteurer gesucht: Tiefschwarze Grotte‡모험가 모집: 검은심연 나락‡Se buscan aventureros: Cavernas de Brazanegra‡Se buscan aventureros: Cavernas de Brazanegra‡On recherche : des aventuriers pour les profondeurs de Brassenoire‡征召冒险者：黑暗深渊‡徵集冒險者:黑澗深淵',
