[31894] = {
  {
    'Um equilíbrio delicado‡Хрупкое равновесие‡Ein empfindliches Gleichgewicht‡깨지기 쉬운 균형‡Un equilibrio delicado‡‡Un délicat équilibre‡微妙平衡‡',
    nil,
    'Fale com Orbiss, nos Reservatórios. Uma‡Поговорите с Орбиссом, который находится в Камышовых топях.‡Sprecht mit Orbiss in den Sumpfbinsen.‡진흙구렁에 있는 오르비스와 대화해야 합니다. 레벨 25 탕랑 평원‡Habla con Orbiss en el Sumidero.‡‡Parlez à Orbiss dans le Marais des Joncs.‡与激流潭的奥比斯谈一谈。‡',
  }
},
[31895] = {
  {
    'Direto à fonte‡Ужасы в изобилии‡Lieber Schrecken als verrecken‡황무지의 기적‡Directo al pavor‡‡Qui trop angoisse‡反击恐惧‡',
    nil,
    'Fale com a Arqueira Li Tsz-Wai no Espinhaço da Serpente. Uma‡Поговорите с лучницей Ли на Змеином Хребте.‡Sprecht mit Bogenmeisterin Li auf dem Schlangenrücken.‡용의 척추에 있는 명궁 리와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con la maestra arquera Li en el Espinazo del Dragón.‡‡Parlez au Maître-archer Li sur l’Échine du Serpent.‡去蟠龙脊和女射手李琪薇谈一谈。‡',
  }
},
[31897] = {
  {
    'Grã-mestra Trixxy‡Великая укротительница Трикси‡Großmeisterin Trixxy‡특급 조련사 트릭시‡Gran maestra Trixxy‡‡Le grand maître Trixxy‡驯宠宗师崔克斯‡',
    nil,
    'Vença Trixxy Coração de Pedra numa batalha de mascotes. Uma‡Победите Ледяную Трикси в битве питомцев. это‡Besiegt die eiskalte Trixxy in einem Haustierkampf.‡애완동물 대전에서 차디찬 트릭시를 꺾어야 합니다. 레벨 1‡Derrota a Trixxy Sangrefría en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Trixxy l’Impassible.‡在宠物战斗中击败“冷血”崔克斯。‡',
  }
},
[31902] = {
  {
    'Domadores de Batalha: Reinos do Leste‡Укротители боевых питомцев: Восточные королевства‡Kampfhaustierzähmer: Östliche Königreiche‡전투 애완동물 조련사: 동부 왕국‡Domadores de mascotas de duelo: Reinos del Este‡‡Dompteurs de mascottes de combat : les royaumes de l’Est‡战斗宠物训练师：东部王国‡',
    nil,
    'Derrote Davi Kosse, Deiza Chifre da Peste, Kortas Trevamalho, Eternessa e Durin Trevamalho em batalhas de mascote. Uma‡Победите Дэвида Косса, Дейзу Плейгхорн, Кортана Даркхаммера, Эверессу и Дурина Черномолота в битвах питомцев.‡Besiegt David Kosse, Deiza Seuchenhorn, Kortas Düsterhammer, Everessa und Durin Düsterhammer in Haustierkämpfen.‡애완동물 대전에서 데이비드 코세, 데이자 플레이그혼, 코르타스 다크해머, 에버레사, 두린 다크해머를 꺾어야 합니다.‡Derrota a David Kosse, a Deiza Plagacuerno, a Kortas Martilloscuro, a Everessa y a Durin Martilloscuro en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre David Kosse, Deiza Cornepeste, Kortas Sombremartel, Everessa et Durin Sombremartel.‡在宠物战斗中击败大卫·寇斯、德扎·疫角、科塔兹·黑锤、伊芙瑞莎和杜林·黑锤。‡',
  }
},
