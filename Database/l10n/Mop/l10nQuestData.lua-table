},
[30457] = {
  {
    'A fúria do líder guerreiro‡Бросить вызов предводителю‡Raus mit dem Anführer‡대장 나와라‡Atrae a su líder‡‡Appelez leur chef‡引出他们的头儿‡',
    nil,
    'Mate 10 Membros da Tribo Bataari no Desfiladeiro Kun-Lai até que o Guerreiro de Fogo Bataari apareça. Depois, mate-o. Uma‡Убейте 10 яунголов на Куньлайской дороге. После этого появится яунгол-военачальник. Убейте его.‡Tötet 10 Angehörige des Bataaristamms am Kun-Lai-Pass, bis der Feuerkrieger der Bataari auftaucht. Und dann tötet auch ihn.‡쿤라이 길에서 바타리 부족 10마리를 처치하고, 바타리 화염전사가 나타나면 무찔러야 합니다. 레벨 20 쿤라이 봉우리‡Acaba con 10 miembros de la tribu Bataari en el Paso Kun-Lai hasta que aparezca el guerrero de fuego Bataari. Entonces, mátalo.‡‡Tuez 10 Membres de la tribu bataari au Passage de Kun-Lai jusqu’à ce que le Guerrier-flammes bataari apparaisse. Puis éliminez-le. Un(e) quête.‡在昆莱小径上击败10个巴塔里部落的成员，等待巴塔里火战士出现。然后击败他。‡',
  }
},
[30458] = {
  {
    'Os batedores retornam‡Возвращение разведчиков‡Rückkehr der Späher‡정찰대의 귀환‡El regreso de los exploradores‡‡Le retour des éclaireurs‡侦查员归来‡',
    nil,
    'Fale com Rell Ventonegro na Aldeia Pinavidro, na Floresta de Jade. Uma‡Поговорите с Реллом Ночным Ветром в Деревне Жемчужного Плавника в Нефритовом лесу.‡Sprecht mit Rell Nachtwind im Perlflossendorf im Jadewald.‡비취 숲의 유리지느러미 마을에 있는 렐 나이트윈드와 대화해야 합니다. 레벨 10 비취 숲‡Habla con Rell Brisa Nocturna en el Poblado Aleta de Nácar, en El Bosque de Jade.‡‡Parlez à Rell Ventenuit à Nageperle, dans la Forêt de Jade.‡前往翡翠林的珠鳍村，与利尔·夜风谈一谈。‡',
  }
},
[30459] = {
  {
    'Todas as flechas‡Все стрелы‡Pfeile sammeln gehen‡화살을 모아요‡Todas las flechas‡‡Toutes les flèches‡多多益善‡',
    nil,
    'Colete 12 Flechas para o Comandante Hsieh. Uma‡Соберите 12 стрел для командира Се.‡Sammelt 12 Pfeile für Kommandantin Hsieh.‡사령관 시에를 위한 화살 12개를 모아야 합니다. 레벨 20 쿤라이 봉우리‡Recoge 12 flechas para la comandante Hsieh.‡‡Récupérez 12 Flèches pour le Commandant Hsieh.‡为指挥官萧合收集12支箭。‡',
  }
},
[30460] = {
  {
    'Medicina de guerra‡Сила врачевания‡Gute Medizin‡호랑이 연고‡Medicamento poderoso‡‡Un médicament puissant‡救死扶伤‡',
    nil,
    'Use o Dit-Da-Jow ou os seus próprios poderes de cura para ajudar 8 Guerreiros Binan Feridos. Uma‡Используйте дит да джоу или собственные способности к исцелению, чтобы помочь восьми раненым воинам из деревни Бинан.‡Benutzt die Dit Da Jow oder Eure eigenen Heilkräfte, um 8 verletzten Kriegern aus Binan zu helfen.‡호랑이 연고나 치유 능력을 사용하여 부상당한 빈안 전사 8명을 치유해야 합니다. 레벨 20 쿤라이 봉우리‡Utiliza el Dit Da Jow o tu propia sanación para ayudar a 8 guerreros de Binan heridos.‡‡Utilisez le Baume du tigre ou vos propres sorts de soin pour aider 8 Guerriers de Binan blessés.‡使用跌打酒或你自己的治疗法术救助8个受伤的滨岸村战士。‡',
  }
},
[30461] = {
  {
    'Rumo à selva‡Вперед, в глушь‡In die Wildnis‡밀림 속으로‡En la espesura‡‡Dans les étendues sauvages‡深入荒野‡',
    nil,
    'Encontre Koro Andarilho da Névoa no Templo da Garça Vermelha, que fica a sul, na foz do Rio Krasarang. Uma‡Найдите Коро Странника Туманов у храма Красного Журавля в южной дельте реки Красаранг.‡Findet Koro Nebelgänger in der Nähe des Tempels des Roten Kranichs an der südlichen Mündung des Krasarang.‡크라사랑 강 남쪽 끝의 주학사 근처에 있는 코로 미스트워커에게 가야 합니다. 레벨 15 크라사랑 밀림‡Busca a Koro Caminante Misterioso cerca del Templo de la Grulla Roja, en el extremo sur del río Krasarang.‡‡Trouvez Koro Marche la Brume près du Temple de la Grue rouge, à l’extrémité sud de la Rivière Krasarang.‡在卡桑琅河最南端的朱鹤寺附近找到科洛·迷雾行者。‡',
  }
},
[30462] = {
  {
    'Rumo à selva‡Вперед, в глушь‡In die Wildnis‡밀림 속으로‡En la espesura‡‡Dans les étendues sauvages‡深入荒野‡',
    nil,
    'Encontre Koro Andarilho da Névoa no Templo da Garça Vermelha, que fica a sul, na foz do Rio Krasarang. Uma‡Найдите Коро Странника Туманов у храма Красного Журавля в южной дельте реки Красаранг.‡Findet Koro Nebelgänger in der Nähe des Tempels des Roten Kranichs an der südlichen Mündung des Krasarang.‡크라사랑 강 남쪽 끝의 주학사 근처에 있는 코로 미스트워커에게 가야 합니다. 레벨 15 크라사랑 밀림‡Busca a Koro Caminante Misterioso cerca del Templo de la Grulla Roja, en el extremo sur del río Krasarang.‡‡Trouvez Koro Marche la Brume près du Temple de la Grue rouge, à l’extrémité sud de la Rivière Krasarang.‡在卡桑琅河最南端的朱鹤寺附近找到科洛·迷雾行者。‡',
  }
},
[30464] = {
  {
    'Rumo ao oeste‡На запад‡Auf in den Westen‡서쪽으로‡En marcha hacia el oeste‡‡Destination : l’ouest !‡一路向西‡',
    nil,
    'Viaje para o Refúgio Caça-manhã. Uma‡Отправляйтесь в Укрытие Искателей Зари.‡Reist zur Morgenjägerzuflucht.‡돈체이서 은거처로 가야 합니다. 레벨 15 크라사랑 밀림‡Viaja hasta el Retiro del Cazador del Alba.‡‡Voyagez jusqu’à la Retraite des Chasselaube.‡前往逐晨者营地。‡',
  }
},
[30465] = {
  {
    'Ao ataque‡Переход в наступление‡In die Offensive gehen‡공세 취하기‡Pasar a la ofensiva‡‡Passer à l’offensive‡准备进攻‡',
    nil,
    'Fale com Lyalia na Base Sentinela, que fica na Selva de Krasarang. Uma‡Поговорите с Лиалией в Лагере Часовых в Красарангских джунглях.‡Sprecht mit Lyalia beim Lager der Schildwachen in der Krasarangwildnis.‡크라사랑 밀림의 파수꾼 주둔지에 있는 리알리아와 대화해야 합니다. 레벨 15 크라사랑 밀림‡Habla con Lyalia en el Campamento Base de las Centinelas en la Espesura Krasarang.‡‡Parlez avec Lyalia au Camp de base des Sentinelles, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的哨兵营地和丽娅拉谈一谈。‡',
  }
},
[30466] = {
  {
    'Motivação suficiente‡Достаточная мотивация‡Genügend Motivation‡충분한 동기 부여‡La motivación necesaria‡‡Une motivation suffisante‡高效激励‡',
    nil,
    'Incentive 10 Hozens Preguiçosos. Uma‡Мотивируйте 10 ленивых хозенов.‡Motiviert 10 Faule Ho-zen.‡게으른 호젠 10명에게 동기를 부여해야 합니다. 레벨 10 비취 숲‡Motiva a 10 hozen vagos.‡‡Remotivez 10 Hozen fainéants.‡激励10个懒惰的猢狲。‡',
  }
},
[30467] = {
  {
    'Meu filho...‡Мой сын...‡Mein Sohn...‡우리 아들...‡Mi hijo...‡‡Mon fils…‡我的儿子……‡',
    nil,
    'Encontre Wu-Peng na Lagoa Guelra-pintada. Uma‡Найдите У-Пэна на озере Чернильной Жабры.‡Findet Wu-Peng am Tintenkiemenweiher.‡먹물아가미 호수에서 우펑을 찾아야 합니다. 레벨 20 쿤라이 봉우리‡Encuentra a Wu-Peng en la Presa Branquias de Tinta.‡‡Trouvez Wu Peng à l’Étang des Branchies-d’encre.‡在墨鳃潭找到武鹏。‡',
  }
},
[30468] = {
  {
    'Vingança enfurecida‡Ярость и возмездие‡Wütende Vergeltung‡분노에 찬 복수‡Venganza enfurecida‡‡Vengeance enragée‡复仇之怒‡',
    nil,
    'Mate 15 Jinyus Enraivecidos. Uma‡Убейте 15 разъяренных цзинь-юй.‡Tötet 15 wütende Jinyu.‡분노한 진위 15명을 처치해야 합니다. 레벨 20 쿤라이 봉우리‡Mata a 15 jinyu iracundos.‡‡Tuez 15 Jinyu enragés.‡击败15个暴怒的锦鱼人。‡',
  }
},
[30469] = {
  {
    'Retomada‡Возврат собственности‡Wiederinbesitznahme‡회수‡Recuperar las posesiones‡‡Recouvrement‡取回补给‡',
    nil,
    'Colete 8 Suprimentos Roubados. Uma‡Найдите 8 украденных припасов.‡Sammelt 8 gestohlene Versorgungsgüter.‡도난당한 보급품 8개를 되찾아야 합니다. 레벨 20 쿤라이 봉우리‡Reúne 8 suministros robados.‡‡Collectez 8 paquets de Provisions volées.‡收集8包失窃的补给品。‡',
  }
},
[30470] = {
  {
    'Presente para Tina‡Подарок для Тины‡Ein Geschenk für Tina‡티나를 위한 선물‡Un regalo para Tina‡‡Un cadeau pour Tina‡给迪娜的礼物‡',
    nil,
    'Obtenha um Crisoberílio Bruto. Uma‡Найдите нешлифованный хризоберилл.‡Findet einen rohen Chrysoberyll.‡가공하지 않은 묘안석을 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue un crisoberilo sin tallar.‡‡Procurez-vous un Chrysobéryl non taillé.‡获得一块未切割的金绿玉。‡',
  }
},
[30471] = {
  {
    'Presente para Tchi Tchi‡Подарок для Чи-Чи‡Ein Geschenk für Chi-Chi‡치 치를 위한 선물‡Un regalo para Chee Chee‡‡Un cadeau pour Chii Chii‡给吱吱的礼物‡',
    nil,
    'Obtenha uma Fritada do Vale Autêntica. Uma‡Добудьте настоящий стир-фрай долины.‡Besorgt ein authentisches Pfannengericht nach Vier-Winde-Art.‡원조 계곡 볶음 요리를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue un revuelto del valle auténtico.‡‡Procurez-vous un Authentique sauté de la vallée.‡获得一份正宗谷地小炒。‡',
  }
},
[30472] = {
  {
    'Presente para Sho‡Подарок для Шо‡Ein Geschenk für Sho‡쇼를 위한 선물‡Un regalo para Sho‡‡Un cadeau pour Sho‡给阿烁的礼物‡',
    nil,
    'Obtenha uma tigela de Sopa Yu-Ping. Uma‡Добудьте миску супа Юй-Пин.‡Besorgt eine Schüssel Yu-Ping-Suppe.‡위핑 수프 한 그릇을 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue un cuenco de sopa Yu-Ping.‡‡Procurez-vous un bol de Soupe Yu-Ping.‡获得一碗苹果鱼汤。‡',
  }
},
[30473] = {
  {
    'Presente para Peixe‡Подарок для Рыбы‡Ein Geschenk für Fischi‡피시를 위한 선물‡Un regalo para Pez‡‡Un cadeau pour Marée‡给玉儿的礼物‡',
    nil,
    'Obtenha uma Estatueta de Iaque de uma cabana dos hozens Kunzen. Uma‡Найдите в хижине хозенов Куньцзэнь статуэтку яка.‡Besorgt eine Yakstatuette aus einer Hütte der Kunzen-Ho-zen.‡쿤젠 호젠 오두막 안에서 야크 조각상을 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue una estatuilla de yak en el interior de una cabaña de hozen Kunzen.‡‡Procurez-vous une Statuette de yack à l’intérieur d’une Hutte de hozen à Kunzen.‡从昆森猢狲的棚屋中获得一个牦牛雕像。‡',
  }
},
[30474] = {
  {
    'Presente para Ella‡Подарок для Эллы‡Ein Geschenk für Ella‡엘라를 위한 선물‡Un regalo para Ella‡‡Un cadeau pour Ella‡给艾拉的礼物‡',
    nil,
    'Obtenha Bolinhos Apimentados de Camarão. Uma‡Достаньте острые клецки с раками-богомолами.‡Besorgt pikante Garnelenklößchen.‡매콤한 새우 만두를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue empanadillas de gambas picantes.‡‡Procurez-vous des Raviolis aux crevettes épicés.‡获得香辣虾饺。‡',
  }
},
[30475] = {
  {
    'Presente para Fung‡Подарок для Фуна‡Ein Geschenk für Fung‡펑을 위한 선물‡Un regalo para Fung‡‡Un cadeau pour Fung‡给老方的礼物‡',
    nil,
    'Obtenha uma Coxa Sangrenta de Falcão-da-planície de um Falcão-da-planície Monstruoso e a leve para Kol Pata de Ferro no Mercado de Meia Colina.‡Добудьте окровавленную ногу огромного равнинного ястреба, затем отнесите ее на рынок Полугорья и отдайте Кору Железной Лапе.‡Beschafft ein blutiges Ebenenfalkenbein von einem monströsen Ebenenfalken und bringt es dann zu Kol Eisentatz auf dem Halbhügelmarkt.‡괴물 초원매를 처치한 뒤 피묻은 초원매 다리를 획득해서 언덕골 시장에 있는 콜 아이언포우에게 가져가야 합니다.‡Consigue una pata de halcón de la llanura sangrienta de un halcón de la llanura monstruoso, y luego llévasela a Kol Zarpa Férrea a El Mercado del Alcor.‡‡Procurez-vous une Cuisse de faucon des plaines sanglante sur un Faucon des plaines monstrueux, puis rapportez-la à Kol Patte de Fer au Marché de Micolline.‡从巨大的平原鹰身上获得一根血淋淋的平原鹰腿，将其带给半山市集中的柯·铁掌。‡',
  }
},
[30476] = {
  {
    'Presente para o Velho Pata do Monte‡Подарок для старика Горной Лапы‡Ein Geschenk für den alten Hügelpranke‡늙은 힐포우를 위한 선물‡Un regalo para el viejo Zarpa Collado‡‡Un cadeau pour le Vieux Patte des Hauts‡给老农山掌的礼物‡',
    nil,
    'Encontre uma Pérola Azul de Água Doce. Uma‡Найдите синюю пресноводную жемчужину.‡Findet eine blaue Süßwasserperle.‡파란색 민물진주를 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra una perla de agua dulce azul.‡‡Trouvez une Perle d’eau douce bleue.‡找到一颗蓝色淡水珍珠。‡',
  }
},
[30477] = {
  {
    'Presente para Haohan‡Подарок для Хаоханя‡Ein Geschenk für Haohan‡하오한을 위한 선물‡Un regalo para Haohan‡‡Un cadeau pour Haohan‡给郝瀚的礼物‡',
    nil,
    'Consiga um Dente da Garoupa Enorme do Taboa. Uma‡Найдите зуб огромного камышового окуня.‡Besorgt den Zahn eines gewaltigen Rohrkolbenbarschs.‡거대한 부들개지 농어 이빨을 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue un diente de mero de las Eneas enorme.‡‡Procurez-vous une Dent d’énorme mérou du Lac aux Roseaux.‡获得一颗巨大的香蒲湖石斑鱼牙齿。‡',
  }
},
[30478] = {
  {
    'Presente para Jogu‡Подарок для Йогу‡Ein Geschenk für Jogu‡조구를 위한 선물‡Un regalo para Jogu‡‡Un cadeau pour Jogu‡给贾古的礼物‡',
    nil,
    'Pegue 8 Maçãs de Yoon e 50 Grouselhas de Yoon e leve-as para Bobo Pata de Ferro para que ele prepare um Goró Tutti-frutti. Uma‡Возьмите 8 яблок Юна, 50 ягод клюквы Юна и отнесите их Бобо Железной Лапе, чтобы он сварил из них яблочно-ягодную брагу.‡Bringt 8 von Yoons Äpfeln und 50 seiner Kranichbeeren zu Bobo Eisentatz, um daraus Apfelbeerenfusel brennen zu lassen.‡윤의 사과 8개, 윤의 학딸기 50개를 획득한 뒤 보보 아이언포우에게 가져가 사과딸기주를 만들어야 합니다.‡Consigue 8 manzanas de Yoon y 50 grubayas de Yoon, y luego llévaselas a Baobao Zarpa Férrea para que elabore su bebistrajo de manzana y bayas.‡‡Procurez-vous 8 Pommes de Yoon et 50 Gruelles de Yoon, puis apportez-les à Bobo Patte de Fer pour qu’il en fasse de la Gnôle pomme-fruits rouges.‡获得8个老愚的苹果和50个老愚的蔓越莓，然后将它们带给博布·铁掌并酿成莓果烈酒。‡',
  }
},
[30479] = {
  {
    'Presente para Gina‡Подарок для Джины‡Ein Geschenk für Gina‡지나를 위한 선물‡Un regalo para Gina‡‡Un cadeau pour Gina‡给吉娜的礼物‡',
    nil,
    'Consiga uma Orquídea Flamáurea. Uma‡Найдите златопламенную орхидею.‡Findet eine Goldfeuerorchidee.‡황금불 난초를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue una orquídea dorada.‡‡Procurez-vous une Orchidée feu-doré.‡获得一朵金火兰。‡',
  }
},
[30480] = {
  {
    'O ritual‡Ритуал‡Das Ritual‡의식‡El ritual‡‡Le rituel‡仪式‡',
    nil,
    'Fale com o Parlágua Gorai e depois complete o Ritual. Uma‡Поговорите с Говорящим с водой Гожаем, а затем завершите ритуал.‡Sprecht mit Wassersprecher Gorai und beendet dann das Ritual.‡물예언자 고라이와 대화하고 의식을 치릅니다. 레벨 20 쿤라이 봉우리‡Sana al sabio Liao para que vuelva a valerse por sí mismo.‡‡Parlez à l’Eaurable Goraï et accomplissez le Rituel.‡和水语者苟莱谈一谈并完成仪式。‡',
  }
},
[30481] = {
  {
    'Pedras pra que te quero‡Вырезано в камне‡In Stein gemeißelt‡갖고 싶은 돌‡Grabado en piedra‡‡De pierre en pierre‡刻入石中‡',
    nil,
    'Colete 12 Pedras Rúnicas de Guo-Lai. Uma‡Соберите 12 рунических камней Го-Лай.‡Sammelt 12 Guo-Lai-Runensteine zusammen.‡구오라이 마법석 12개를 모아야 합니다. 레벨 1 영원꽃 골짜기‡Reúne 12 piedras rúnicas Guo-Lai.‡‡Récupérez 12 Pierres runiques de Guo-Lai.‡收集12颗郭莱符文石。‡',
  }
},
[30482] = {
  {
    'O coletor de almas‡Собиратель душ‡Der Seelensammler‡영혼수확자‡El Recolector de Almas‡‡Le récolteur d’âmes‡‡',
    nil,
    'Mate o Mestre das Sombras Sydow e recupere as bolas do seu corpo. Uma‡Убейте повелителя теней Сайдоу и снимите c тела четки.‡Tötet Schattenmeister Sydow und sichert Euch seine Seelenperlen.‡어둠의 주인 사이도우를 처치하고 시체에서 묵주를 가져가야 합니다. 레벨 1 영원꽃 골짜기‡Mata al Maestro de las Sombras Sydow y recupera las cuentas de su cadáver.‡‡Tuez le Maître d’ombre Sydow et récupérez les Perles sur son cadavre.‡‡',
  }
},
[30483] = {
  {
    'NOT USED‡NOT USED‡NOT USED‡미사용‡NOT USED‡‡INUTILISÉ‡NOT USED‡',
    nil,
    'Uma‡‡‡레벨 1 영원꽃 골짜기‡‡‡‡‡',
  }
},
[30484] = {
  {
    'Avaliando nossos progressos‡Мера успеха‡Messung unseres Fortschritts‡진행 상황 확인‡Medir nuestro avance‡‡Évaluation des troupes‡评估进度‡',
    nil,
    'Fale com o Mestressombra Kiryn, Pinno Estalagarra, Shokia e Riko. Uma‡Получите доклады от темного мастера Кирин, Риветта Сталехвата, Шокии и Рико. задание.‡Besucht Schattenmeisterin Kiryn, Nieti Kuppelplopp, Shokia und Riko.‡그늘지배자 키린, 리벳 클러치팝, 쇼키아, 리코에게 훈련 상황을 확인해야 합니다. 레벨 10 비취 숲‡Habla con la maestra tétrica Kiryn, Perno Rompemarchas, Shokia y Riko.‡‡Rencontrez la Maîtresse de l’Ombre Kiryn, Rivett Popembraye, Shokia et Riko.‡听取匿踪大师琪麟、利维特·急刹、夏琪亚和里克的报告。‡',
  }
},
[30485] = {
  {
    'A última peça do quebra-cabeça‡Последний фрагмент головоломки‡Das letzte Puzzleteil‡퍼즐의 마지막 조각‡La última pieza del puzle‡‡La dernière pièce du puzzle‡最后一块拼图‡',
    nil,
    'Use o Legado de Cho no Templo da Família Cho, que fica no Mirante da Serpente.Fale com Mishi para obter transporte. Uma‡Используйте фамильную ценность Чо на площадке с видом на Нефритовую Змею в фамильном святилище Чо.Попросите Миши доставить вас туда.‡Benutzt Chos Erbstück bei Chos Familienschrein beim Schlangenblick.Um dorthin zu kommen, sprecht mit Mishi.‡용의 전망대, 초 가의 제단에서 초 가문의 가보를 사용해야 합니다.미스와 대화하면 이동할 수 있습니다.‡Usa la reliquia de Cho en el santuario de la familia Cho en el Mirador del Dragón.Habla con Mishi para transportarte. Un/una misión de World of Warcraft: Mists of Pandaria.‡‡Utilisez l’Héritage de la famille de Cho à l’Autel des ancêtres de Cho, sur le Surplomb du Serpent.Parlez avec Mishi pour le transport.‡在青龙瞭望台上的周家神龛使用周氏传家宝。和米师谈一谈，他会带你过去的。‡',
  }
},
[30486] = {
  {
    'Rastreamento de Fase do Dragão de Jade‡Выслеживание нефритового дракона‡Jadedrachen-verschobene Geländeverfolgung‡옥룡 위상별 지형 추적‡Jade Dragon Phased Terrain Tracking‡‡Suivi territoire phasé dragon de jade‡青龙定相地形追踪‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[30487] = {
  {
    'Dando a volta na montanha‡Умный гору обойдет‡Über den Bergpass‡산행‡Recorrer la montaña‡‡Le tour de la montagne‡环山路‡',
    nil,
    'Escolte o carrinho e os guias com segurança até o cume do Monte Neverest. Uma‡Сопроводите повозку и проводников до горы Неутомимых.‡Bringt den Wagen und die Wagenführer sicher durch das Nimmerlaya-Gebirge.‡네베레스트 산까지 상단을 안전하게 호위해야 합니다. 레벨 20 쿤라이 봉우리‡Escolta el carro y a los guías hasta el Monte Nieverest.‡‡Escortez la charrette et les guides dans leur ascension du Mont Sans-Repos jusqu’à ce qu’ils soient hors de danger.‡护送马车和向导安全登上不息山。‡',
  }
},
[30488] = {
  {
    'O Almiscarado desaparecido‡Мускусная Лапа: пропавший сын‡Der verschwundene Moschuspranken-Spross‡사라진 머스크포우‡El Zarpa Lanuda desaparecido‡‡Le Patte Musquée disparu‡找回麝香爪‡',
    nil,
    'Encontre o Almiscarado Jr. no Antro dos Galhofeiros. Uma‡Разыщите Мускусную Лапу – младшего в Пещере шаловливых духов.‡Findet Moschuspranke Jr. im Witzboldwinkel.‡장난꾸러기의 동굴에 가서 머스크포우 2세를 찾아야 합니다. 레벨 20 쿤라이 봉우리‡Encuentra a Zarpa Lanuda Jr. en el Escondrijo de los Bribones.‡‡Retrouvez Patte Musquée Jr. dans le Creux des Farceurs.‡去顽灵洞找到小麝香爪。‡',
  }
},
[30489] = {
  {
    'Cheiro de agulha fresca‡Пахучая иголка духов‡Frischer Nadelduft‡신선한 바늘잎 냄새‡Aroma a aguja fresca‡‡Un fumet d’aiguilles fraîches‡鲜松针的香味‡',
    nil,
    'Colete 20 Agulhas Pungentes de Duende. Uma‡Соберите 100 пахучих иголок духов.‡Sammelt 100 geruchsintensive Waldgeisternadeln ein.‡톡 쏘는 요마 바늘잎 100개를 모아야 합니다. 레벨 20 쿤라이 봉우리‡Consigue 100 agujas de duende afiladas.‡‡Ramassez 100 Aiguilles de lutin âpres.‡收集100根提神松针。‡',
  }
},
[30490] = {
  {
    'Matar, pilhar, queimar, roubar iaques‡Як и так, и сяк‡Hände weg von meinen Yaks!‡야크 도둑‡Yaks‡‡Yaungogols‡‡',
    nil,
    'Mate 9 Espoliadores Burilgi no Rancho do Almiscarado. Uma‡Убейте 9 хияккеров-разорителей на ферме Мускусной Лапы.‡Tötet 9 Räuber der Burilgi auf dem Gehöft Moschuspranke.‡머스크포우 목장에서 부릴기 약탈자 9명을 처치해야 합니다. 레벨 20 쿤라이 봉우리‡Mata a 9 hurtadores Burilgi en el Rancho Zarpa Lanuda.‡‡Tuez 9 Spoliateurs burilgi à la Ferme Patte Musquée.‡‡',
  }
},
[30491] = {
  {
    'No lavaiaque‡На якомойке‡In der Yaksalberei‡야크 세척장에서‡En el Lavadero de Yaks‡‡Le lave-o-yack‡洗牛站‡',
    nil,
    'Leve 6 Iaques Fugidos até a Fila de Lavagem no Lava-iaque Lao & Filho. Uma‡Приведите 6 сбежавших яков на якомойку "Лао и сын".‡Bringt 6 entlaufene Yaks zum Eingang der Yaksalberei Lao & Sohn.‡탈출한 야크 6마리를 라오 부자의 야크 세척장 입구로 데려와야 합니다. 레벨 20 쿤라이 봉우리‡Lleva a 6 yaks huidos a la entrada del Lavadero de Yaks Lao e Hijo.‡‡Ramenez 6 Yacks échappés à l’Entrée du lavage, au Lavage de yacks Lao et fils.‡把6头逃走的牦牛带到父子洗牛站的清洗入口处。‡',
  }
},
[30492] = {
  {
    'Cabeças de iaque‡И снова яки‡Sauberes Yak, gutes Yak‡야크로 쌤쌤‡Vuelta en yak‡‡Retour en yack‡再说牦牛‡',
    nil,
    'Leve os Iaques Lavados para Sortão Oitopratas no Bazar dos Grômulos, que fica no Monte Kun-Lai. Fale com Almiscarado Jr. novamente se perder os iaques.‡Отведите мытых яков к Счастливчику Серебрику на базар груммелей на вершине Кунь-Лай. Вернитесь к Мускусной Лапе – младшему, если яки потеряются.‡Bringt die gewaschenen Yaks zu Achtgroschen dem Glückspilz auf dem Grummelbasar am Kun-Lai-Gipfel. Kehrt zu Moschuspranke Jr. zurück, solltet Ihr die Yaks verlieren.‡쿤라이 봉우리의 그루멀 시장에 있는 행운의 여덟동전에게 씻긴 야크를 데려가야 합니다. 야크를 잃어버리면 머스크포우 2세에게 돌아가면 됩니다.‡Llévale los yaks limpios a Fortuno el Calderillas en El Bazar Grúmel, en la Cima Kun-Lai. Vuelve con Zarpa Lanuda Jr. si pierdes tus yaks.‡‡Emmenez les Yacks lavés à Sapèque le Verni au Bazar des grumelots, au Sommet de Kun-Lai. Retournez voir Patte Musquée Jr. si vous perdez vos yacks.‡把清洗干净的牦牛给昆莱山土地精集市上的八铜钱送去。如果你把牛弄丢了，就回去找小麝香爪。‡',
  }
},
[30495] = {
  {
    'Trabalhos de amor‡Любимое дело‡Liebesdienst‡총알 배달‡Trabajos de amor‡‡L’amour du travail bien fait‡爱的劳动‡',
    nil,
    'Entregue o jade ao Historiador Dinh, ao Topógrafo Sawa, ao Mestre-de-pipas Shoku e ao Capataz Emi. Uma‡Доставьте нефрит историку Дину, землемеру Саве, мастеру воздушных змеев Шоку и надсмотрщику Эми.‡Bringt die Jade zu Historiker Dinh, Feldmesser Sawa, Drachenmeister Shoku und Bauleiterin Emi.‡역사가 딘, 측량사 사와, 연 장인 쇼쿠, 작업반장 에미에게 비취를 배달해야 합니다. 레벨 10 비취 숲‡Entrega el jade al historiador Dinh, al perito Sawa, al maestro de cometas Shoku y a la capataz Emi.‡‡Livrez le jade à l’Historien Dinh, au Géomètre Sawa, au Maître des cerfs-volants Shoku et au Sous-chef Emi.‡把玉石交给历史学家丁先生、勘测员萨瓦、风筝大师卓续和监工艾米。‡',
  }
},
[30496] = {
  {
    'O cajado do parlágua‡Посох говорящего с водой‡Der Stab des Wassersprechers‡물예언자의 지팡이‡El bastón del orador del agua‡‡Le bâton de l’Eauracle‡水语者的法杖‡',
    nil,
    'Recupere o Cajado Ritual Guelra-pintada do Parlágua Gorai das mãos de Orachi, na Lagoa Guelra-pintada. Uma‡Верните ритуальный посох Чернильной Жабры, украденный у Говорящего с водой Гожая. Он находится у Орачи, на озере Чернильной Жабры.‡Holt Wassersprecher Gorais gestohlenen Ritualstab der Tintenkiemen von Orachi am Tintenkiemenweiher zurück.‡먹물아가미 호수에 있는 오라키한테서 물예언자 고라이의 도난당한 먹물아가미 의식 지팡이를 되찾아야 합니다.‡Arrebata a Orachi el bastón ritual de Branquias de Tinta robado del orador del agua Gorai, en la Presa Branquias de Tinta.‡‡Récupérez le Bâton rituel des Branchies-d’encre volé à l’Eauracle Goraï. Orachi l’a en sa possession, à l’Étang des Branchies-d’encre.‡从墨鳃潭的太蛇那里夺回水语者苟莱失窃的墨鳃仪式法杖。‡',
  }
},
[30498] = {
  {
    'Volte aqui!‡Вернись!‡Kommt zurück!‡돌아와!‡¡Vuelve aquí!‡‡Revenez au plus vite !‡快回来！‡',
    nil,
    'Fale com o Almirante Taylor na Aldeia Barbatana de Pérola. Uma‡Вернитесь к адмиралу Тейлору в Деревню Жемчужного Плавника.‡Meldet Euch bei Admiral Taylor im Dorf der Perlflossen.‡진주지느러미 마을에 있는 제독 테일러에게 보고해야 합니다. 레벨 10 비취 숲‡Preséntate ante el almirante Taylor en el Poblado Aleta de Nácar.‡‡Présentez-vous à l’Amiral Taylor à Nageperle.‡向珠鳍村中的海军上将泰勒汇报。‡',
  }
},
[30499] = {
  {
    'Volte aqui!‡Вернись!‡Kommt zurück!‡돌아와!‡¡Vuelve aquí!‡‡Revenez au plus vite !‡快回来！‡',
    nil,
    'Fale novamente com o General Nazgrim no Morro Bagarai. Uma‡Вернитесь к генералу Назгриму на холм Грукин.‡Kehrt zu General Nazgrim auf dem Flotschhügel zurück.‡그루끼끼 언덕에 있는 장군 나즈그림에게 가야 합니다. 레벨 10 비취 숲‡Reúnete con el general Nazgrim en Cerro Makaku.‡‡Retournez voir le Général Nazgrim au Tertre des Groukards.‡去古鲁金猴山找纳兹戈林将军。‡',
  }
},
[30500] = {
  {
    'Precipitação residual‡Эмоциональный всплеск‡Negative Konsequenzen‡잔류물 낙진‡Restos residuales‡‡Retombées résiduelles‡残存的影响‡',
    nil,
    'Destrua 10 Ecos de Sha. Uma‡Уничтожьте 10 отзвуков ша.‡Vernichtet 10 Sha-Echos.‡샤의 메아리 10마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 10 ecos del sha.‡‡Détruisez 10 Échos sha.‡消灭10个邪煞回响。‡',
  }
},
[30501] = {
  {
    'Gossip Accept Quest Test Case‡Gossip Accept Quest Test Case‡Gossip Accept Quest Test Case‡잡소리 퀘스트 받기 테스트‡Gossip Accept Quest Test Case‡‡Encadré de test d’acceptation de quête « Bavardage »‡接受小道消息测试例子‡',
    nil,
    'Uma‡‡‡레벨 1 영원꽃 골짜기‡‡‡‡‡',
  }
},
[30502] = {
  {
    'Coração de jade‡Нефритовое сердце‡Mitten ins Herz‡아련한 마음 한 덩이‡Corazón hastiado‡‡Le cœur de jade‡灵玉之心‡',
    nil,
    'Use Pedaços de Jade Celestial para derrotar 6 Remanescentes Sha. Uma‡С помощью кусков неземного нефрита победите 6 порождений ша.‡Benutzt Brocken himmlischer Jade, um 6 Sha-Rückstände zu vernichten.‡천신의 비취 덩어리를 이용하여 샤의 잔재 6마리를 처치해야 합니다. 레벨 10 비취 숲‡Usa trozos de jade celestial para derrotar a 6 remanentes de sha.‡‡Utilisez des morceaux de Jade céleste pour détruire 6 Vestiges de sha.‡使用天神灵玉削弱并击败6个邪煞残影。‡',
  }
},
[30504] = {
  {
    'Resposta emergencial‡Срочные меры‡Notfallplan‡응급 대응‡Respuesta de urgencia‡‡Réponse d’urgence‡紧急救援‡',
    nil,
    'Use os Fogos de Artifício de Cho perto do General Nazgrim, do Mestressombra Kiryn, de Shokia e de Pinno Estalagarra. Uma‡Используйте фейерверки Чо около генерала Назгрима, темного мастера Кирин, Шокии и Риветта Сталехвата.‡Benutzt Chos Feuerwerk in der Nähe von General Nazgrim, Schattenmeisterin Kiryn, Shokia und Nieti Kuppelplopp.‡장군 나즈그림, 그늘지배자 키린, 쇼키아, 리벳 클러치팝 근처에서 초의 폭죽을 사용해야 합니다. 레벨 10 비취 숲‡Usa los fuegos artificiales de Cho cerca del general Nazgrim, la maestra tétrica Kiryn, Shokia y Perno Rompemarchas.‡‡Utilisez les Feux d’artifice de Cho près du Général Nazgrim, de la Maîtresse de l’Ombre Kiryn, de Shokia et de Rivett Popembraye. Un(e) quête.‡在纳兹戈林将军、匿踪大师琪麟、夏琪亚和利维特·急刹附近使用周卓的烟火。‡',
  }
},
[30506] = {
  {
    'O despertar do almirante Taylor‡Адмирал Тейлор очнулся‡Admiral Taylor ist erwacht‡의식을 되찾은 제독 테일러‡El almirante Taylor se ha despertado‡‡L’amiral Taylor s’est réveillé‡海军上将泰勒醒了‡',
    nil,
    'Fale com o Almirante Taylor na Vila Binan, que fica no Monte Kun-Lai. Uma‡Поговорите с адмиралом Тейлором в деревне Бинан на вершине Кунь-Лай.‡Sprecht mit Admiral Taylor in Binan am Kun-Lai-Gipfel.‡쿤라이 봉우리의 빈안 마을에 있는 제독 테일러와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el almirante Taylor en la Aldea Binan, en la Cima Kun-Lai.‡‡Parlez avec l’Amiral Taylor à Binan au Sommet de Kun-Lai.‡去昆莱山的滨岸村和海军上将泰勒谈一谈。‡',
  }
},
[30507] = {
  {
    'O despertar do almirante Taylor‡Адмирал Тейлор очнулся‡Admiral Taylor ist erwacht‡의식을 되찾은 제독 테일러‡El almirante Taylor se ha despertado‡‡L’amiral Taylor s’est réveillé‡海军上将泰勒醒了‡',
    nil,
    'Fale com o Almirante Taylor na Vila Binan, que fica no Monte Kun-Lai. Uma‡Поговорите с адмиралом Тейлором в деревне Бинан на вершине Кунь-Лай.‡Sprecht mit Admiral Taylor in Binan am Kun-Lai-Gipfel.‡쿤라이 봉우리의 빈안 마을에 있는 제독 테일러와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el almirante Taylor en la Aldea Binan, en la Cima Kun-Lai.‡‡Parlez avec l’Amiral Taylor à Binan au Sommet de Kun-Lai.‡去昆莱山的滨岸村和海军上将泰勒谈一谈。‡',
  }
},
[30508] = {
  {
    'O despertar do almirante Taylor‡Адмирал Тейлор очнулся‡Admiral Taylor ist erwacht‡의식을 되찾은 제독 테일러‡El almirante Taylor se ha despertado‡‡L’amiral Taylor s’est réveillé‡海军上将泰勒醒了‡',
    nil,
    'Fale com o Almirante Taylor na Vila Binan, que fica no Monte Kun-Lai. Uma‡Поговорите с адмиралом Тейлором в деревне Бинан на вершине Кунь-Лай.‡Sprecht mit Admiral Taylor in Binan am Kun-Lai-Gipfel.‡쿤라이 봉우리의 빈안 마을에 있는 제독 테일러와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el almirante Taylor en la Aldea Binan, en la Cima Kun-Lai.‡‡Parlez avec l’Amiral Taylor à Binan au Sommet de Kun-Lai.‡去昆莱山的滨岸村和海军上将泰勒谈一谈。‡',
  }
},
[30509] = {
  {
    'O despertar do general Nazgrim‡Генерал Назгрим очнулся‡General Nazgrim ist erwacht‡의식을 되찾은 장군 나즈그림‡El general Nazgrim se ha despertado‡‡Le général Nazgrim s’est réveillé‡纳兹戈林将军苏醒了‡',
    nil,
    'Fale com o General Nazgrim na Vila Binan, que fica no Monte Kun-Lai. Uma‡Поговорите с генералом Назгримом в деревне Бинан на вершине Кунь-Лай.‡Sprecht mit General Nazgrim in Binan am Kun-Lai-Gipfel.‡쿤라이 봉우리의 빈안 마을에 있는 장군 나즈그림과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el general Nazgrim en la Aldea Binan, en la Cima Kun-Lai.‡‡Parlez avec le Général Nazgrim à Binan au Sommet de Kun-Lai.‡去昆莱山的滨岸村和纳兹戈林将军谈一谈。‡',
  }
},
[30510] = {
  {
    'O despertar do general Nazgrim‡Генерал Назгрим очнулся‡General Nazgrim ist erwacht‡의식을 되찾은 장군 나즈그림‡El general Nazgrim se ha despertado‡‡Le général Nazgrim s’est réveillé‡纳兹戈林将军苏醒了‡',
    nil,
    'Fale com o General Nazgrim na Vila Binan, que fica no Monte Kun-Lai. Uma‡Поговорите с генералом Назгримом в деревне Бинан на вершине Кунь-Лай.‡Sprecht mit General Nazgrim in Binan am Kun-Lai-Gipfel.‡쿤라이 봉우리의 빈안 마을에 있는 장군 나즈그림과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el general Nazgrim en la Aldea Binan, en la Cima Kun-Lai.‡‡Parlez avec le Général Nazgrim à Binan au Sommet de Kun-Lai.‡去昆莱山的滨岸村和纳兹戈林将军谈一谈。‡',
  }
},
[30511] = {
  {
    'O despertar do general Nazgrim‡Генерал Назгрим очнулся‡General Nazgrim ist erwacht‡의식을 되찾은 장군 나즈그림‡El general Nazgrim se ha despertado‡‡Le général Nazgrim s’est réveillé‡纳兹戈林将军苏醒了‡',
    nil,
    'Fale com o General Nazgrim na Vila Binan, que fica no Monte Kun-Lai. Uma‡Поговорите с генералом Назгримом в деревне Бинан на вершине Кунь-Лай.‡Sprecht mit General Nazgrim in Binan am Kun-Lai-Gipfel.‡쿤라이 봉우리의 빈안 마을에 있는 장군 나즈그림과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el general Nazgrim en la Aldea Binan, en la Cima Kun-Lai.‡‡Parlez avec le Général Nazgrim à Binan au Sommet de Kun-Lai.‡去昆莱山的滨岸村和纳兹戈林将军谈一谈。‡',
  }
},
[30512] = {
  {
    'Repouso do Vento Oeste‡Приют Западного Ветра‡Westwindruhestätte‡서풍의 쉼터‡Reposo Viento del Oeste‡‡Le Repos du Vent de l’Ouest‡西风之息‡',
    nil,
    'Fale com o Lavrador Bô e com o Ancião Tsulan no Avanço dos Yaungóis. Uma‡Поговорите с батраком Бо и со старейшиной Цуланем на Стоянке яунголов.‡Sprecht mit Landarbeiter Bo und dem Ältesten Tsulan beim Yaungolvorstoß.‡야운골 진군지에 있는 농장 일꾼 보, 장로 추란과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el granjero Bo y con el ancestro Tsulan en El Avance Yaungol.‡‡Parlez au Journalier Bo et à l’Ancien Tsulan à la Base avancée Yaungole.‡与野牛人前线的雇农小波和素兰长老谈一谈。‡',
  }
},
[30513] = {
  {
    'Repouso do Vento Leste‡Приют Восточного Ветра‡Die Ostwindruhestätte‡동풍의 쉼터‡Reposo Viento del Este‡‡Le Repos du Vent de l’Est‡东风之眠‡',
    nil,
    'Fale com o Lavrador Kô e o Ancião Shiao no Monte Kun Lai. Uma‡Поговорите с батраком Ко и со старейшиной Шиао на вершине Кунь-Лай.‡Sprecht mit Landarbeiter Ko und dem Ältesten Shiao am Kun-Lai-Gipfel.‡쿤라이 봉우리에 있는 농장 일꾼 코, 장로 스아오와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el mozo de labranza Ko y con el ancestro Shiao en Cima Kun-Lai.‡‡Parlez au Journalier Ko et à l\'Ancien Shiao au Sommet de Kun-Lai.‡和昆莱山的雇农小寇还有邵长老谈一谈。‡',
  }
},
[30514] = {
  {
    'Desafio aceito‡Вызов принят‡Gipfelherausforderung‡도전장을 내밀다‡Desafío aceptado‡‡Défi accepté‡接受挑战‡',
    nil,
    'Incendeie o Estandarte Yaungol para evocar Ur-Bataar. Depois, derrote-o em combate. Uma‡Подожгите знамя яунголов, чтобы бросить вызов Ур-Батаару, и победите его. задание.‡Setzt das Yaungolbanner in Flammen, um Ul-Bataar herbeizulocken, und besiegt ihn anschließend im Kampf.‡야운골 깃발에 불을 붙여 우르바타르를 불러낸 다음 그를 물리쳐야 합니다. 레벨 20 쿤라이 봉우리‡Prende fuego al estandarte yaungol para invocar a Ur-Bataar y luego derrótalo en combate.‡‡Embrasez la Bannière yaungole pour invoquer Ur-Bataar, puis remportez le combat.‡点燃野牛人旗帜，召唤并击败厄尔巴塔尔。‡',
  }
},
[30515] = {
  {
    'Desafio aceito‡Вызов принят‡Gipfelherausforderung‡도전장을 내밀다‡Desafío aceptado‡‡Défi accepté‡接受挑战‡',
    nil,
    'Incendeie o Estandarte Yaungol na Guarnição Avançada Bataar para evocar Ur-Bataar. Depois, derrote-o em combate. Uma‡Подожгите знамя яунголов в огненном лагере Батаар, чтобы бросить вызов Ур-Батаару, и победите его.‡Setzt das Yaungolbanner im Streitlager Bataar in Flammen, um Ul-Bataar herbeizulocken, und besiegt ihn anschließend im Kampf.‡불의 야영지 바타르로 가서 야운골 깃발에 불을 붙여 우르바타르를 불러낸 다음 그를 물리쳐야 합니다.‡Prende fuego al estandarte yaungol en el Campamento Bataar para invocar a Ur-Bataar y luego derrótalo en combate.‡‡Embrasez la Bannière yaungole au Campement Bataar pour invoquer Ur-Bataar, puis remportez le combat.‡在巴塔尔火营点燃野牛人旗帜，召唤并击败厄尔巴塔尔。‡',
  }
},
[30516] = {
  {
    'Expandindo a fazenda I: um probleminha‡Фермерство I: небольшая проблема‡Den Hof pflegen I: Ein kleines Problem‡농장 확장 1단계: 작은 문제‡Ampliar la granja I: Un pequeño problema‡‡Agrandir la ferme - Leçon 1 : un petit hic‡农场物语（一）：小麻烦‡',
    nil,
    'Colha 6 Raízes-aranha para Gai Lan. Uma‡Соберите 6 паучьих корней для Гай Ланя.‡Sammelt 6 Spinnenwurz für Gai Lan.‡가이 란을 위해 거미뿌리 6개를 모아야 합니다. 레벨 15 네 바람의 계곡‡Reúne 6 ceparañas para Gai Lan.‡‡Récoltez 6 Aranéicines pour Gai Lan.‡为蓝盖采集6株蛛棘根。‡',
  }
},
[30517] = {
  {
    'O voto do fazendeiro Fung I: ataque de iaque‡Голос фермера Фуна I: атака яков‡Bauer Fungs Stimme I: Yakangriff‡농부 펑의 한 표 I: 야크 공격‡El voto del granjero Fung: Ataque de yaks‡‡Le vote du fermier Fung (1) : les yacks attaquent‡农夫老方的选票（一）：牦牛跑了‡',
    nil,
    'Fale com o Fazendeiro Fung no Coração da Terra ou no Mercado de Meia Colina no Vale dos Quatro Ventos. Uma‡Поговорите с фермером Фуном, который находится в долине Четырех Ветров в Плодородных землях или на рынке Полугорья.‡Sprecht mit Bauer Fung im Kernland oder auf dem Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 언덕골 시장이나 심장지에 있는 농부 펑과 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con el granjero Fung en Los Cultivos Florecientes o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Parlez au Fermier Fung au Giron ou au Marché de Micolline, dans la Vallée des Quatre vents.‡去四风谷的汇风岭或半山市集，和农夫老方谈一谈。‡',
  }
},
[30518] = {
  {
    'O voto do fazendeiro Fung II: à solta‡Голос фермера Фуна II: на свободе‡Bauer Fungs Stimme II: In freier Wildbahn‡농부 펑의 한 표 II: 도망친 야크들‡El voto del granjero Fung: Yaks a la carrera‡‡Le vote du fermier Fung (2) : en cavale‡农夫老方的选票（二）：找回牦牛‡',
    nil,
    'Devolva 5 Pelestopas Fugidos ao padoque do Fazendeiro Fung, que fica na extremidade norte do Cinturão Verde. Uma‡Отведите 5 беглых лохмачей в загон фермера Фуна на северном краю Луговых угодий.‡Bringt 5 entlaufene Wollyaks zu Bauer Fungs Yakpferch am nördlichsten Ende des Grünen Gürtels zurück.‡농부 펑의 탈출한 긴털야크 5마리를 신록지대 바로 북쪽 끝에 있는 우리로 돌려보내야 합니다. 레벨 15 네 바람의 계곡‡Devuelve 5 pelomarañas huidos al establo del granjero Fung en el extremo norte de la Franja Verdeante.‡‡Rapportez 5 Longs-poils en fuite à l’enclos aux yacks du Fermier Fung, à l’extrême nord de la Ceinture verdoyante.‡将5只逃走的粗皮牛带回农夫老方位于翠绿草场最北边的牦牛棚。‡',
  }
},
[30519] = {
  {
    'O voto de Nana I: a receita secreta de Nana‡Голос Наны I: секретный рецепт Наны‡Nanas Stimme I: Nanas Geheimrezept‡나나의 한 표 I: 나나의 비밀‡El voto de Nana I: La receta secreta de Nana‡‡Le vote de Nana (1) : la recette secrète de Nana‡娜娜的选票（一）：娜娜的秘方‡',
    nil,
    'Fale com Nana Garra de Barro em Meia Colina, no Vale dos Quatro Ventos. Uma‡Поговорите с Наной Грязный Коготь в Полугорье, что в долине Четырех Ветров. Награда: .‡Sprecht mit Nana Lehmkrall in Halbhügel im Tal der Vier Winde.‡네 바람의 계곡의 언덕골에 있는 나나 머드클로와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Nana Zarpa Fangosa en El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Parlez à Nana Griffe de Tourbe à Micolline, dans la Vallée des Quatre vents.‡去四风谷的半山和娜娜·泥爪谈一谈。‡',
  }
},
[30520] = {
  {
    'Problema de barriga‡Несварение желудка‡Magenprobleme‡‡Problema estomacal‡‡Problèmes de digestion‡‡',
    nil,
    'Use Ganserejas para curar Moradores de Meia Colina doentes. Uma‡Используйте крыжовник, чтобы вылечить заболевших жителей Полугорья.‡Benutzt Gänsebeeren und heilt mit ihnen kranke Bewohner von Halbhügel.‡‡Utiliza grosellas para curar a los habitantes enfermos de El Alcor.‡‡Utilisez des Groseilles à maquereau pour guérir les Villageois de Micolline malades.‡‡',
  }
},
[30521] = {
  {
    'O voto de Haohan I: barraco no bangalô‡Голос Хаоханя I: вторжение‡Haohans Stimme I: Einbruch in der Hütte‡하오한의 한 표 I: 대저택 들어가기‡El voto de Haohan: Allanamiento de bungalow‡‡Le vote de Haohan (1) : effraction du bungalow‡郝瀚的选票（一）：不速之客‡',
    nil,
    'Fale com Haohan Garra de Barro no Coração da Terra ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Uma‡Поговорите с Хаоханем Грязным Когтем, который находится в долине Четырех Ветров в Плодородных землях или на рынке Полугорья.‡Sprecht mit Haohan Lehmkrall im Kernland oder auf dem Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 언덕골 시장이나 심장지에 있는 하오한 머드클로와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Haohan Zarpa Fangosa en Los Cultivos Florecientes o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Parlez à Haohan Griffe de Tourbe au Giron ou au Marché de Micolline, dans la Vallée des Quatre vents.‡去四风谷的汇风岭或半山市集和郝瀚·泥爪谈一谈。‡',
  }
},
[30522] = {
  {
    'O voto de Haohan II: os verdadeiros culpados‡Голос Хаоханя II: истинные виновники‡Haohans Stimme II: Die wahren Schuldigen‡하오한의 한 표 II: 진범‡El voto de Haohan II: Los verdaderos culpables‡‡Le vote de Haohan (2) : les véritables coupables‡郝瀚的选票（二）：真凶‡',
    nil,
    'Investigue 8 Pegadas Suspeitas. Uma‡Найдите 8 подозрительных следов.‡Untersucht 8 verdächtige Fußspuren.‡수상한 발자국 8개를 조사해야 합니다. 레벨 15 네 바람의 계곡‡Investiga 8 huellas sospechosas.‡‡Examinez 8 Empreintes suspectes.‡调查8处可疑的脚印。‡',
  }
},
[30523] = {
  {
    'Expandindo a fazenda II: a carroça quebrada‡Фермерство II: сломанная повозка‡Den Hof pflegen II: Der zerbrochene Wagen‡농장 확장 2단계: 부서진 수레‡Ampliar la granja II: El carro roto‡‡Agrandir la ferme - Leçon 2 : le chariot cassé‡农场物语（二）：破损的马车‡',
    nil,
    'Fale com Peixe Cana Alta no Lago Taboa ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Uma‡Поговорите с Рыбой Тростниковой Шкурой, которая находится на Камышовом озере или на рынке Полугорья, что в долине Четырех Ветров.‡Sprecht mit Fischi Rohrroder am Rohrkolbensee oder auf dem Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 부들개지 호수나 언덕골 시장에 있는 피시 펠리드와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Pez Junco Talado en el Lago de las Eneas o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Parlez à Marée Pelage de Roseau au Lac aux roseaux ou au Marché de Micolline, dans la Vallée des Quatre vents.‡去四风谷中的香蒲湖畔或半山市集找玉儿·采苇谈一谈。‡',
  }
},
[30524] = {
  {
    'Expandindo a fazenda II: bate na madeira‡Фермерство I: постучи по дереву‡Den Hof pflegen II: Klopf auf Holz‡농장 확장 2단계: 나무 찾기‡Ampliar la granja: Toca madera‡‡Agrandir la ferme - Leçon 2 : Toucher du bois‡农场物语（二）：找竹板‡',
    nil,
    'Pegue 100 Tábuas Enceradas. Uma‡Соберите 100 покрытых воском досок.‡Sammelt 100 gewachste Bretter zusammen.‡광나무 판자 100개를 수집해야 합니다. 레벨 15 네 바람의 계곡‡Reúne 100 tablones encerados.‡‡Repêchez 100 Planches cirées.‡收集100块打蜡的竹板。‡',
  }
},
[30525] = {
  {
    'O voto de Haohan III: puro veneno‡Голос Хаоханя III: чистый яд‡Haohans Stimme III: Pures Gift‡하오한의 한 표 III: 순수한 독‡El voto de Haohan III: Puro veneno‡‡Le vote de Haohan (3) : un pur poison‡郝瀚的选票（三）：致命毒药‡',
    nil,
    'Colha 1 Broto-de-sangue, 1 Lírio-da-caverna, 1 Cogumelo-fantasma e 1 Líquen-violeta. Uma‡Принесите 1 кроволист, 1 пещерную лилию, 1 призрачный гриб и 1 лиловый лишайник.‡Sammelt 1 Blutblüte, 1 Höhlenlilie, 1 Geisterkappe und 1 Veilchenflechte ein.‡혈초와 동굴 백합, 유령고깔, 그리고 보랏빛 이끼를 각각 1개씩 수집해야 합니다. 레벨 15 네 바람의 계곡‡Recoge 1 pétalo de sangre, 1 lirio cavernario, 1 hongo fantasma y 1 liquen violeta.‡‡Ramassez 1 Fleur de sang, 1 Lys troglodyte, 1 Amanite fantôme et 1 Lichen pourpre.‡收集1朵血色花、1朵岩洞百合、1朵鬼面菇和1朵紫地衣。‡',
  }
},
[30526] = {
  {
    'Perdido e solitário‡Голодный и одинокий‡Einsam und allein‡주인 잃은 외로운 강아지‡Perdido y solitario‡‡Perdu et esseulé‡迷失和孤独‡',
    nil,
    'Colete 20 Bistecas Deliciosas dos Mushans que vivem na Serra do Céu, que fica no Vale dos Quatro Ventos. Uma‡Соберите 20 кусков вкусной вырезки, охотясь на мушанов Небогорья в долине Четырех Ветров.‡Besorgt 20 köstliche T-Bone-Steaks von den Himmelsweitenmushan auf der Himmelsweite im Tal der Vier Winde.‡네 바람의 계곡의 하늘능선에 있는 하늘능선 무샨을 처치해 맛 좋은 꽃등심 20개를 수집해야 합니다. 을(를) 보상으로 줌.‡Reúne 20 chuletones sabrosos de los mushan de Firmamento, en el Valle de los Cuatro Vientos.‡‡Collectez 20 Délicieuses côtes à l’os sur les Mushans chaîne des Cieux à la Chaîne des Cieux, dans la Vallée des Quatre vents. Donne  en récompense.‡从四风谷摩天山脊的摩天穆山兽身上收集20根美味的丁骨肉排。‡',
  }
},
[30527] = {
  {
    'O voto de Haohan IV: melões para vilões‡Голос Хаоханя IV: похитители дынь‡Haohans Stimme IV: Melonenmanie‡하오한의 한 표 IV: 호젠에게 줄 멜론‡El voto de Haohan IV: Melones para bribones‡‡Le vote de Haohan (4) : melons et félons‡郝瀚的选票（四）：罪有应得‡',
    nil,
    'Plante e colha 4 Melões Listrados, depois entregue 20 Melões Listrados ao Fazendeiro Yoon.Sementes de Melão Listrado são vendidas pelo Mercador Moncampo no Mercado de Meia Colina. Depois de lavrar e cuidar da planta, você tem que esperar até o dia seguinte para colher Melões Listrados maduros.‡Посадите 4 полосатых дыни и соберите урожай. Затем доставьте 20 полосатых дынь фермеру Юну.Семена полосатой дыни можно купить у торговца Зеленое Поле на рынке Полугорья. После обработки почвы и ухода за растением вам нужно подождать один день, прежде чем собрать урожай полосатых дынь.‡Pflanzt und erntet 4 Streifenmelonen und bringt dann 20 Streifenmelonen zu Bauer Yoon.Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben. Nach dem Beackern und Pflegen Eurer Pflanze müsst Ihr bis zum nächsten Tag warten, um reife Streifenmelonen zu ernten.‡줄무늬 멜론 씨앗 4개를 심어 수확한 뒤 농부 윤에게 줄무늬 멜론 20개를 가져가야 합니다.줄무늬 멜론 씨앗은 언덕골 시장에 있는 상인 그린필드에게 구입할 수 있습니다. 줄무니 멜론을 씨앗을 심고 가꾼 후에 하루를 기다려야 잘 익은 줄무늬 멜론을 수확할 수 있습니다.‡Planta y cosecha 4 melones a rayas y luego entrega 20 melones a rayas al granjero Yoon.El mercader Campo Fértil vende semillas de melón a rayas en el Mercado del Alcor. Después de arar y cuidar de tu planta, tienes que esperar hasta el día siguiente para cosechar melones a rayas maduros.‡‡Plantez et récoltez 4 Melons à rayures, puis livrez 20 Melons à rayures au Fermier Yoon.Les Graines de melon à rayures peuvent être achetées chez le Marchand Verte Terre, au Marché de Micolline. Après avoir labouré le sol et vous être occupé de vos plants, vous devez attendre le lendemain pour récolter des Melons à rayures bien mûrs.‡种植并收获4颗菜瓜，然后将20颗菜瓜送给农夫老愚。你可以从半山市集的商人绿野那里买到菜瓜种子。耕种并灌溉后，你必须等到次日才能收获成熟的菜瓜。‡',
  }
},
[30528] = {
  {
    'O voto de Haohan V: Chefe Yip-Yip‡Голос Хаоханя V: вождь Хоп-Хоп‡Haohans Stimme V: Häuptling Yip-Yip‡하오한의 한 표 V: 주방장 입입‡El voto de Haohan V: Jefe Yip-Yip‡‡Le vote de Haohan (5) : chef Yip-Yip‡郝瀚的选票（五）：酋长伊普伊普‡',
    nil,
    'Mate o Chefe Yip-Yip na Caverna Kunzen a noroeste. Uma‡Убейте вождя Хоп-Хопа в Пещере Куньцзэнь на северо-западе.‡Tötet Häuptling Yip-Yip bei der Kunzen-Höhle im Nordwesten.‡북서쪽의 쿤젠 동굴에 있는 주방장 입입을 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata al jefe Yip-Yip en la Cueva Kunzen al noroeste.‡‡Tuez le Chef Yip-Yip à la Caverne des Kunzen au nord-ouest.‡去西北方的昆森洞窟击败酋长伊普伊普。‡',
  }
},
[30529] = {
  {
    'Expandindo a fazenda III: o penedo musgoso‡Фермерство III: замшелый валун‡Den Hof pflegen III: Der bemooste Felsbrocken‡농장 확장 3단계: 이끼 낀 바위‡Ampliar la granja III: La roca musgosa‡‡Agrandir la ferme - Leçon 3 : le rocher plein de mousse‡农场物语（三）：移走巨石‡',
    nil,
    'Fale com Haohan Garra de Barro no Coração da Terra ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Uma‡Поговорите с Хаоханем Грязным Когтем, который находится в долине Четырех Ветров в Плодородных землях или на рынке Полугорья.‡Sprecht mit Haohan Lehmkrall im Kernland oder auf dem Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 심장지나 언덕골 시장에 있는 하오한 머드클로와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Haohan Zarpa Fangosa en Los Cultivos Florecientes o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Parlez à Haohan Griffe de Tourbe au Giron ou au Marché de Micolline, dans la Vallée des Quatre vents.‡去四风谷的汇风岭或半山市集和郝瀚·泥爪谈一谈。‡',
  }
},
