},
[32166] = {
  {
    'Caçada do Senhor das Feras: o Caranguejo‡Охота повелителя зверей: краб‡Jagd des Bestienmeisters: Die Krabbe‡야수조련사의 사냥감: 거대 야물집게발‡La caza del maestro de bestias: el cangrejo‡‡Technique de chasse du belluaire : le crabe‡兽王的狩猎：螃蟹‡',
    nil,
    'Obtenha 30 Peixes Podres Fedidos dos Aldeões Ungá em Ungá Ingô. Uma‡Заберите 30 вонючих тухлых рыб у жителей поселения Унга-Ингу. это‡Besorgt 30 müffelnde verrottete Fische von Ungadorfbewohnern in Unga Ingu.‡웅가 잉구에 있는 웅가 주민에게서 냄새나는 썩은 물고기 30마리를 획득해야 합니다. 레벨 15‡Hazte con 30 pescados podridos hediondos de habitantes de Unga, en Unga Ingoo.‡‡Récupérez 30 Poissons pourris bizarres sur des Villageois d’Unga, à Unga Ingou.‡从盎迦猴岛的盎迦村民处获得30条恶臭烂鱼。‡',
  }
},
[32167] = {
  {
    'A queda da anciã‡Гибель Древнего‡Der Fall des Uralten‡고대 피의 왕관 학의 죽음‡La caída de un anciano‡‡La chute d’un ancien‡远古的败亡‡',
    nil,
    'Fale com Jorn Vidente do Céu no Ponto de Dominação, que fica na Selva de Krasarang. Uma‡Поговорите c Джорном Небесным Провидцем в Крепости Покорителей, что в Красарангских джунглях.‡Sprecht mit Jorn Himmelsdeuter an der Herrschaftsfeste in der Krasarangwildnis.‡크라사랑 밀림의 지배령 거점에 있는 조른 스카이시어와 대화해야 합니다. 레벨 15‡Habla con Jorn Vidente del Cielo en el Punto de Dominio, en la Espesura Krasarang.‡‡Parlez à Jorn Oeil-des-Cieux à la Halte de la Domination, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的统御岗哨与乔恩·星眼谈一谈。‡',
  }
},
[32168] = {
  {
    'O fim de um ancião‡Конец Древнего‡Das Ende eines Ältesten‡덩치 큰 크라사리 호랑이의 죽음‡El fin de un ancestro‡‡La fin d’un ancien‡老猫的末日‡',
    nil,
    'Fale com Jorn Vidente do Céu no Ponto de Dominação, que fica na Selva de Krasarang. Uma‡Поговорите c Джорном Небесным Провидцем в Крепости Покорителей, что в Красарангских джунглях.‡Sprecht mit Jorn Himmelsdeuter an der Herrschaftsfeste in der Krasarangwildnis.‡크라사랑 밀림의 지배령 거점에 있는 조른 스카이시어와 대화해야 합니다. 레벨 15‡Habla con Jorn Vidente del Cielo en el Punto de Dominio, en la Espesura Krasarang.‡‡Parlez à Jorn Oeil-des-Cieux à la Halte de la Domination, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的统御岗哨与乔恩·星眼谈一谈。‡',
  }
},
[32169] = {
  {
    'Uma vitória colossal‡Великая победа‡Ein kolossaler Sieg‡거대한 승리‡Una victoria colosal‡‡Une victoire colossale‡巨大的胜利‡',
    nil,
    'Fale com Jorn Vidente do Céu no Ponto de Dominação, que fica na Selva de Krasarang. Uma‡Поговорите c Джорном Небесным Провидцем в Крепости Покорителей, что в Красарангских джунглях.‡Sprecht mit Jorn Himmelsdeuter an der Herrschaftsfeste in der Krasarangwildnis.‡크라사랑 밀림의 지배령 거점에 있는 조른 스카이시어와 대화해야 합니다. 레벨 15‡Habla con Jorn Vidente del Cielo en el Punto de Dominio, en la Espesura Krasarang.‡‡Parlez à Jorn Oeil-des-Cieux à la Halte de la Domination, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的统御岗哨与乔恩·星眼谈一谈。‡',
  }
},
[32170] = {
  {
    'A queda da anciã‡Гибель Древнего‡Der Fall des Uralten‡고대 피의 왕관 학의 죽음‡La caída de un anciano‡‡La chute d’un ancien‡远古的败亡‡',
    nil,
    'Fale com o Guarda-caça Blake na Angra de Krasarang, que fica na Selva de Krasarang. Uma‡Поговорите с ловчим Блейком в Красарангской бухте, что в Красарангских джунглях.‡Sprecht mit Jäger Blake in der Krasarangbucht in der Krasarangwildnis.‡크라사랑 밀림의 크라사랑 만에 있는 사냥꾼 블레이크와 대화해야 합니다. 레벨 15‡Habla con el montero Blake en la Cala Krasarang, en la Espesura Krasarang.‡‡Parlez au Veneur Blake à la Crique de Krasarang, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的卡桑琅海湾与猎手布雷克谈一谈。‡',
  }
},
[32171] = {
  {
    'O fim de um ancião‡Конец Древнего‡Das Ende eines Ältesten‡덩치 큰 크라사리 호랑이의 죽음‡El fin de un ancestro‡‡La fin d’un ancien‡老猫的末日‡',
    nil,
    'Fale com o Guarda-caça Blake na Angra de Krasarang, que fica na Selva de Krasarang. Uma‡Поговорите с ловчим Блейком в Красарангской бухте, что в Красарангских джунглях.‡Sprecht mit Jäger Blake in der Krasarangbucht in der Krasarangwildnis.‡크라사랑 밀림의 크라사랑 만에 있는 사냥꾼 블레이크와 대화해야 합니다. 레벨 15‡Habla con el montero Blake en la Cala Krasarang, en la Espesura Krasarang.‡‡Parlez au Veneur Blake à la Crique de Krasarang, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的卡桑琅海湾与猎手布雷克谈一谈。‡',
  }
},
[32172] = {
  {
    'Uma vitória colossal‡Великая победа‡Ein kolossaler Sieg‡거대한 승리‡Una victoria colosal‡‡Une victoire colossale‡巨大的胜利‡',
    nil,
    'Fale com o Guarda-caça Blake no Ancoradouro do Leão, que fica na Selva de Krasarang. Uma‡Поговорите с ловчим Блейком в Львином лагере, что в Красарангских джунглях. задание.‡Sprecht mit Jäger Blake bei der Löwenlandung in der Krasarangwildnis.‡크라사랑 밀림의 사자의 상륙지에 있는 사냥꾼 블레이크와 대화해야 합니다. 레벨 15‡Habla con el montero Blake en el Desembarco del León, en la Espesura Krasarang.‡‡Parlez au Veneur Blake au Territoire du Lion, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的雄狮港与猎手布雷克谈一谈。‡',
  }
},
