[33229] = {
  {
    'Um clarão de bronze...‡Бронзовый блик...‡Ein bronzener Schimmer‡스치는 청동빛‡Un destello de bronce...‡‡Un scintillement de bronze…‡那一抹青铜色……‡',
    nil,
    'Fale com Crona no Trono do Conhecimento, no Vale das Flores Eternas. Uma‡Поговорите с Хроми у Обители Мудрости в Вечноцветущем доле.‡Sprecht mit Chromie beim Heim des Wissens im Tal der Ewigen Blüten.‡영원꽃 골짜기, 지식의 연단 바깥에 있는 크로미와 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con Cromi frente al Trono del Saber, en el Valle de la Flor Eterna.‡‡Parlez à Chromie devant le siège de la Connaissance, dans le Val de l’Éternel printemps.‡在锦绣谷的闻道之座外面与克罗米交谈。‡',
  }
},
[33230] = {
  {
    'Um clarão de bronze...‡Бронзовый блик...‡Ein bronzener Schimmer‡스치는 청동빛‡Un destello de bronce...‡‡Un scintillement de bronze…‡那一抹青铜色……‡',
    nil,
    'Fale com Crona no Trono do Conhecimento, no Vale das Flores Eternas. Uma‡Поговорите с Хроми у Обители Мудрости в Вечноцветущем доле.‡Sprecht mit Chromie beim Heim des Wissens im Tal der Ewigen Blüten.‡영원꽃 골짜기, 지식의 연단 바깥에 있는 크로미와 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con Cromi frente al Trono del Saber, en el Valle de la Flor Eterna.‡‡Parlez à Chromie devant le siège de la Connaissance, dans le Val de l’Éternel printemps.‡在锦绣谷的闻道之座外面与克罗米交谈。‡',
  }
},
[33231] = {
  {
    'Jornada à Ilha Perene‡Путешествие на Вневременный остров‡Die Reise zur Zeitlosen Insel‡영원의 섬으로‡Viaje a la Isla Intemporal‡‡En route pour l’île du Temps figé‡永恒岛之旅‡',
    nil,
    'Fale com a Vigia Lara na Ilha Perene, na costa da Floresta de Jade. Uma‡Поговорите со смотрительницей Ларой на Вневременном острове, что неподалеку от берега у Нефритового леса.‡Sprecht mit Behüterin Lara auf der Zeitlosen Insel, die vor der Küste des Jadewalds gelegen ist.‡비취 숲 동쪽 바다에 있는 영원의 섬에서 감시자 라라와 대화해야 합니다. 레벨 30 영원의 섬‡Habla con la vigía Lara en la Isla Intemporal, frente a la costa del Bosque de Jade.‡‡Parlez à la Veilleuse Lara sur l’Île du Temps figé, au large de la Forêt de Jade.‡到位于翡翠林沿海的永恒岛上与观察者劳拉交谈。‡',
  }
},
[33232] = {
  {
    'Jornada à Ilha Perene‡Путешествие на Вневременный остров‡Die Reise zur Zeitlosen Insel‡영원의 섬으로‡Viaje a la Isla Intemporal‡‡En route pour l’île du Temps figé‡永恒岛之旅‡',
    nil,
    'Fale com a Vigia Alundra na Ilha Perene, na costa da Floresta de Jade. Uma‡Поговорите со смотрительницей Алундрой на Вневременном острове, что неподалеку от берега у Нефритового леса.‡Sprecht mit Behüterin Alundra auf der Zeitlosen Insel, die vor der Küste des Jadewalds gelegen ist.‡비취 숲 동쪽 바다에 있는 영원의 섬에서 감시자 알룬드라와 대화해야 합니다. 레벨 30 영원의 섬‡Habla con la vigía Alundra en la Isla Intemporal, frente a la costa del Bosque de Jade.‡‡Parlez à la Veilleuse Alundra sur l’Île du Temps figé, au large de la Forêt de Jade.‡到位于翡翠林沿海的永恒岛上与观察者奥伦达拉交谈。‡',
  }
},
