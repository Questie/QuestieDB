[5521] = {
  {
    '‡Многоцветная драгоценность Рассвета‡Chromatischer Mantel der Dämmerung‡여명의 오색 장막‡Manto del Alba cromático‡Manto del Alba cromático‡Mantelet de l\'Aube chromatique‡多彩黎明衬肩‡炫彩黎明披肩',
    nil,
    '‡Принесите 25 знаков доблести Серебряного Рассвета интенданту Искре Света из лагеря Промозглого Ветра.‡Bringt 25 Ehrenmarken der Argentumdämmerung zu Rüstmeister Funkellicht im Zugwindlager in den Westlichen Pestländern.‡‡Lleva 25 muestras de valor de El Alba Argenta al intendente Chispillo en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Chispillo en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apportez 25 Marques de valeur de l\'Aube d\'argent au Quartier-maître Feuzopoudre au camp du Noroît, dans les Maleterres de l\'Ouest.‡把25个银色黎明勇气勋章交给西瘟疫之地冰风营地的银色黎明军需官莱斯巴克。‡',
  }
},
[5522] = {
  {
    'Leonid Bartolomeu‡Леонид Барталомей‡Leonidas Bartholomäus‡리어니드 바돌로매‡‡‡Leonid Barthalomew‡莱尼德·巴萨罗梅‡萊尼德·巴薩羅梅',
    nil,
    'Leve os Ovos Congelados para Leonid Bartolomeu, nas Terras Pestilentas Orientais.‡Принесите охлажденные яйца Леониду Бартоломею в Восточные Чумные земли.‡Bringt die gefrorenen Eier zu Leonidas Bartholomäus in den Östlichen Pestländern.‡동부 역병지대에 있는 리어니드 바돌로매에게 얼어붙은 알을 가져가야 합니다.‡Lleva los huevos congelados a Leonid Barthalomew a las Tierras de la Peste del Este.‡Lleva los huevos congelados a Leonid Barthalomew a las Tierras de la Peste del Este.‡Apporter les Oeufs congelés à Leonid Barthalomew dans les Maleterres de l\'est.‡把冰冻的龙蛋交给东瘟疫之地的莱尼德·巴萨罗梅。‡把冰凍的龍蛋交給東瘟疫之地的萊尼德·巴薩羅梅。',
  }
},
[5523] = {
