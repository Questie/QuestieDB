[8409] = {
  {
    '‡Поломанные бочки‡Verdorbenes Bier‡‡Los barriles dañados‡Los barriles dañados‡Des tonneaux gâtés‡恶臭的鸡蛋‡',
    nil,
    '‡Вернитесь к Янке Зовущей Тьму на фестиваль Ивового человека на Тирисфальских лесах.‡Kehrt zur Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡‡Ve a ver de nuevo a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Ve a ver de nuevo a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Retournez voir la sombre imploratrice Yanka à la Fête de l\'homme d\'osier dans les clairières de Tirisfal.‡向提瑞斯法林地的黑暗召唤者雅恩卡复命。‡',
  }
},
[8410] = {
  {
    'Mestre dos elementos‡Покорение стихий‡Elementarbeherrschung‡원소에 대한 깨달음‡Maestría elemental‡Maestría elemental‡La maîtrise des éléments‡元素掌握‡元素專精',
    nil,
    'Colete uma amostra de ar, fogo, terra e água para Bath\'rah, o Vigia dos Ventos.‡Соберите образцы воздуха, огня, земли и воды по поручению Бат\'ры Стража Ветра.‡Bath\'rah der Windbehüter möchte, dass Ihr jeweils eine Probe Luft, Feuer, Erde und Wasser für ihn sammelt.‡물, 불, 대지, 바람의 샘플을 수집하여 바람의감시자 바스라에게 가져가야 합니다.‡Recoge una muestra de aire, fuego, tierra y agua para Bath\'rah el Vigía del viento.‡Recoge una muestra de aire, fuego, tierra y agua para Bath\'rah el Vigía del viento.‡Rassembler un échantillon d\'air, de feu, de terre et d\'eau pour Bath\'rah la Vigie des vents.‡为捕风者巴斯拉收集一份空气样本、一份火元素样本、一份土元素样本和一份水元素样本。‡為『觀風者』巴斯拉收集一份空氣樣本、一份火元素樣本、一份土元素樣本和一份水元素樣本。',
  }
},
[8412] = {
  {
    '[DEPRECATED] Spirit Totem‡Тотем духов‡Geistertotem‡정기의 토템‡[DEPRECATED]Tótem de espíritu‡[DEPRECATED]Tótem de espíritu‡[PÉRIMÉ]Le totem des esprits‡[DEPRECATED] 灵魂图腾‡[DEPRECATED] Spirit Totem',
    nil,
    'Leve as partes para Bath\'rah, o Vigia dos Ventos, fazer o totem de espírito.‡Принесите части тотема Духа Бат\'ре Стражу Ветра.‡Bringt Bath\'rah dem Windbehüter die Komponenten für das Geistertotem.‡바람의감시자 바스라에게 정기의 토템을 만드는 데 필요한 재료들을 가져가야 합니다.‡Lleva lo necesario para el tótem del espíritu a Bath\'rah el Vigía del viento.‡Lleva lo necesario para el tótem del espíritu a Bath\'rah el Vigía del viento.‡Apportez les différents morceaux du Totem des esprits à Bath\'rah la Vigie des Vents.‡将灵魂图腾所需的材料交给捕风者巴斯拉。‡將靈魂圖騰所需的材料交給『觀風者』巴斯拉。',
  }
},
[8413] = {
  {
    'O Vodu‡Вуду‡Die Macht des Voodoos‡부두교 마법‡Vudú‡Vudú‡Vaudou !‡巫毒羽毛‡巫毒之術',
    nil,
    'Leve as Penas Vodu para Bath\'rah, o Vigia dos Ventos.‡Принесите вудуистские перья Бат\'ре Стражу Ветра.‡Bringt Bath\'rah dem Windbehüter die Voodoofedern.‡바람의감시자 바스라에게 부두 깃털들을 가져가야 합니다.‡Lleva las plumas vudú a Bath\'rah el Vigía del viento.‡Lleva las plumas vudú a Bath\'rah el Vigía del viento.‡Apportez les Plumes vaudou à Bath\'rah la Vigie des vents.‡将巫毒羽毛交给捕风者巴斯拉。‡將巫毒羽毛交給『觀風者』巴斯拉。',
  }
},
[8414] = {
  {
    'Dissipando o mal‡Борьба со злом‡Austreibung des Bösen‡악마 퇴치‡Expulsión de los demonios‡Expulsión de los demonios‡La dissipation du mal‡驱散邪恶‡驅散邪惡',
    nil,
    'Colete 20 Pedras do Flagelo do Lacaio e leve-as ao Sumo Sacerdote Thel\'danis nas Terras Pestilentas Ocidentais.‡Принесите 20 камней Плети приспешников верховному жрецу Тель\'данису в Западные Чумные земли.‡Sammelt 20 Geißelsteine des Dieners und bringt sie zu Hohepriester Thel\'danis in den Westlichen Pestländern.‡서부 역병지대에 있는 대사제 텔다니스에게 앞잡이의 스컬지석 20개를 모아 가져가야 합니다.‡Recoge 20 Piedras de la Plaga de esbirros y entrégaselas al sumo sacerdote Thel\'danis en las Tierras de la Peste del Oeste.‡Recoge 20 piedras de la Plaga del esbirro y entrégaselas al sumo sacerdote Thel\'danis en las Tierras de la Peste del Oeste.‡Récupérez 20 Pierres du Fléau des serviteurs et apportez-les au grand prêtre Thel\'danis dans les Maleterres de l\'Ouest.‡收集20个爪牙的天灾石，并将它们交给西瘟疫之地的高阶牧师赛尔丹尼斯。‡收集20個爪牙的天譴石並將它們交給西瘟疫之地的高階牧師賽爾鄧尼斯。',
  }
},
[8415] = {
  {
    'Acampamento Ventogelante‡Лагерь Промозглого Ветра‡Zugwindlager‡서리바람 야영지로‡Campamento del Orvallo‡Campamento del Orvallo‡La pointe du Noroît‡冰风岗‡冰風營地',
    nil,
    'Fale com o Comandante Ashlam Punhobom no Acampamento Ventogelante.‡Обратитесь к командиру Ашламу Отважному Кулаку в Лагерь Промозглого Ветра.‡Sprecht mit Kommandant Ashlam Ehrenschlag im Zugwindlager.‡서리바람 야영지에 있는 사령관 아쉬람 발러피스트와 대화해야 합니다.‡Habla con el comandante Ashlam Puñovalor en el Campamento del Orvallo.‡Habla con el comandante Ashlam Puñovalor en el Campamento del Orvallo.‡Parler au commandant Ashlam Vaillepoing au Camp du Noroît.‡与冰风岗的指挥官阿什拉姆·瓦罗菲斯特谈一谈。‡與冰風營地的指揮官阿胥拉姆·瓦羅菲斯特談一談。',
  }
},
[8416] = {
  {
    '‡Бездействующие камни Плети‡Gereinigte Geißelsteine‡‡Piedras de la Plaga inertes‡Piedras de la Plaga inertes‡Pierres du Fléau inertes‡惰性天灾石‡',
    nil,
    '‡Отнесите бездействующий камень командиру Ашламу Неутомимому на Берег Промозглого Ветра.‡Bringt den gereinigten Geißelstein zu Kommandant Ashlan Ehrenschlag an der Zugwindspitze.‡‡Lleva la piedra de la Plaga inerte al comandante Ashlam Puñovalor en el Alto del Orvallo.‡Lleva la piedra de la Plaga inerte al comandante Ashlam Puñovalor en el Alto del Orvallo.‡Apportez la Pierre du Fléau inerte au commandant Ashlam Vaillepoing à la pointe du Noroît.‡将惰性天灾石交给冰风岗的指挥官阿什拉姆·瓦罗菲斯特。‡',
  }
},
[8417] = {
  {
    'Um espírito atormentado‡Неупокоенный дух‡Ein geplagter Geist‡영혼이 된 영웅의 고통‡Un espíritu afligido‡Un espíritu afligido‡Un esprit troublé‡困扰的灵魂‡困擾的靈魂',
    nil,
    'Fale com o Herói Caído da Horda na entrada da Barreira do Inferno.‡Поговорите с павшим героем Орды у входа в Выжженные земли.‡Sprecht mit dem gefallenen Helden der Horde am Eingang zu den Verwüsteten Landen.‡저주받은 땅의 입구에 있는 호드 영웅의 넋과 대화해야 합니다.‡Habla con el héroe caído de la Horda en la entrada de Las Tierras Devastadas.‡Habla con el héroe caído de la Horda en la entrada de Las Tierras Devastadas.‡Parlez au Héros de la Horde tombé au combat, à l\'entrée des Terres Foudroyées.‡到诅咒之地的入口去，与部落英雄的灵魂谈一谈。‡到詛咒之地的入口去，與部落英雄的靈魂談一談。',
  }
},
[8418] = {
  {
    'Forjando o megalito‡Создание камня силы‡Erschaffung des Steins der Macht‡퇴마석 만들기‡La forja de la piedra de poderío‡La forja de la piedra de poderío‡Forger la pierre de pouvoir‡铸造力量之石‡鑄造力量之石',
    nil,
    'Collect Amber, Blue, and Green Voodoo Feathers from the trolls of Sunken Temple.‡Добудьте янтарные, синие и зеленые вудуистские перья у троллей из Затонувшего храма.‡Beschafft Euch gelbe, blaue und grüne Voodoofedern von den Trollen im Versunkenen Tempel.‡가라앉은 사원에 있는 트롤에게서 황색 부두 깃털, 청색 부두 깃털, 녹색 부두 깃털을 모아야 합니다.‡Obtén plumas vudú ámbar, azules y verdes de los trols del Templo Sumergido.‡Obtén plumas vudú ámbar, azules y verdes de los trols del Templo Sumergido.‡Apportez des Plumes vaudou ambres, bleues et vertes.‡前往沉没的神庙，从巨魔守护者们身上取得琥珀巫毒羽毛、蓝色巫毒羽毛和绿色巫毒羽毛。‡從沉沒的神廟裡的食人妖身上收集琥珀巫毒羽毛、藍色巫毒羽毛與綠色巫毒羽毛。',
  }
},
[8419] = {
  {
    'Pedido de diabrete‡Просьба беса‡Die Bitte eines Wichtels‡임프의 부탁‡Pedido de un diablillo‡Pedido de un diablillo‡La demande d\'un diablotin‡小鬼的要求‡小鬼的要求',
    nil,
    'Leve um pedaço de Tecido Vil para Diabretim, em Selva Maleva.‡Принесите отрез ткани Скверны Бесенку в Оскверненный лес.‡Bringt ein Stück Teufelsstoff zu Impsy im Teufelswald.‡악령숲에 있는 임프시에게 지옥 옷감을 한 장 가져가야 합니다.‡Lleva un retal de tela vil a Diblis a Frondavil.‡Lleva un retal de tela vil a Diblis a Frondavil.‡Apportez un morceau de Gangrétoffe à Démonet à Gangrebois.‡将一块恶魔布交给费伍德森林的伊普斯。‡將1塊惡魔布交給費伍德森林的伊普斯。',
  }
},
[8420] = {
  {
    'Quente e pinicante‡Пробирает!‡Heiß und brennend‡뜨거운 소유욕‡Caliente y picante‡Caliente y picante‡Chaud et piquant‡灼热的疼痛‡灼熱的疼痛',
    nil,
    'Leve um pedaço de Tecido Vil para Diabretim, em Selva Maleva.‡Принесите отрез ткани Скверны Бесенку в Оскверненный лес.‡Bringt ein Stück Teufelsstoff zu Impsy im Teufelswald.‡악령숲에 있는 임프시에게 지옥 옷감을 한 장 가져가야 합니다.‡Lleva un retal de tela vil a Diblis a Frondavil.‡Lleva un retal de tela vil a Diblis a Frondavil.‡Apportez un morceau de gangrétoffe à Démonet à Gangrebois.‡将一块恶魔布交给费伍德森林的伊普斯。‡將1塊惡魔布交給費伍德森林的伊普斯。',
  }
},
[8421] = {
  {
    'O enchimento errado‡Бросовый материал‡Das richtige Zeug‡인형 재료‡La mercancía equivocada‡La mercancía equivocada‡L\'anti-étoffe des héros‡奇怪的材料‡奇怪的材料',
    nil,
    'Leve 10 pedaços de Madeira Podre e 4 Essências de Peçonha para Diabretim em Selva Maleva.‡Принесите 10 кусков гнилой древесины и 4 порции экстракта Отравленной Крови Бесенку в Оскверненный лес.‡Bringt 10 Stück faules Holz und 4 Blutgiftessenzen zu Impsy im Teufelswald.‡악령숲에 있는 임프시에게 썩은 나무 10개와 피멍울 정수 4개를 가져가야 합니다.‡Lleva 10 maderas putrefactas y 4 esencias de veneno a Diblis a Frondavil.‡Lleva 10 maderas putrefactas y 4 esencias de veneno a Diblis a Frondavil.‡Apporter 10 morceaux de Bois pourri et 4 Essences de Vénéneuse à Démonet, en Gangrebois.‡将10块腐烂的木头和4个血毒精华交给费伍德森林的伊普斯。‡將10塊腐爛的木頭和4個血毒精華交給費伍德森林的伊普斯。',
  }
},
[8422] = {
  {
    'Penas de troll‡Тролли Пера‡Federn von Trollen‡트롤의 깃털‡Plumas de trol‡Plumas de trol‡Les trolls d\'un même plumage...‡巨魔的羽毛‡巨魔的羽毛',
    nil,
    'Leve um total de 6 Penas Vodu dos trolls do templo submerso.‡Принесите 6 вудуистских перьев троллей из затонувшего храма.‡Bringt 6 Voodoofedern von den Trollen aus dem Versunkenen Tempel.‡가라앉은 사원에 있는 트롤의 부두 깃털 6개를 가져가야 합니다.‡Reúne un total de 6 plumas vudú en el Templo Sumergido.‡Reúne un total de 6 plumas vudú en el Templo Sumergido.‡Apporter 6 Plumes vaudou des trolls du Temple englouti.‡到沉没的神庙去，从巨魔们身上获得6支巫毒羽毛。‡到沉沒的神廟去，從食人妖們身上獲取6枝巫毒羽毛。',
  }
},
[8423] = {
  {
    'Parentesco guerreiro‡Воинское испытание‡Kriegerverwandtschaft‡전사의 일족‡Parentesco guerrero‡Parentesco guerrero‡Fraternité entre guerriers‡战士的血脉‡戰士的血脈',
    nil,
    'Mate 7 Javiltuscos na Barreira do Inferno e fale novamente com o Herói Caído da Horda.‡Убейте 7 зловепрей в Выжженных землях и вернитесь к павшему герою Орды.‡Tötet 7 Hölleneber in den Verwüsteten Landen und kehrt zu dem gefallenen Helden der Horde zurück.‡저주받은 땅에 있는 지옥멧돼지 7마리를 처치하고 호드 영웅의 넋에게 가야 합니다.‡Mata a 7 jabinfernos de Las Tierras Devastadas y vuelve junto al héroe caído de la Horda.‡Mata a 7 jabinfernos de Las Tierras Devastadas y vuelve junto al héroe caído de la Horda.‡Tuez 7 Sangliers infernaux dans les Terres Foudroyées, et revenez voir le Héros de la Horde tombé au combat.‡杀死7头地狱野猪，然后回到部落英雄的灵魂那儿。‡在詛咒之地殺死7隻地獄野豬，然後回到部落英雄的靈魂那裡。',
  }
},
[8424] = {
  {
    'Guerra aos devotos da sombra‡Война против Приверженцев Тени‡Krieg den Schattenanbetern‡어둠혈맹과의 전쟁‡La guerra contra los Sombra Jurada‡La guerra contra los Sombra Jurada‡La guerre contre les liges d\'ombre‡魔誓者之战‡影誓者之戰',
    nil,
    'Mate os Devotos da Sombra na Barreira do Inferno e fale novamente com o Herói Caído da Horda.‡Убейте приверженцев тени в Выжженных землях и вернитесь к павшему герою Орды.‡Merzt die Schattenanbeter in den Verwüsteten Landen aus und kehrt zum gefallenen Helden der Horde zurück.‡저주받은 땅에서 어둠혈맹 숙련사제 20명, 이교도 10명, 암살단원 20명을 처치하고 호드 영웅의 넋에게 가야 합니다.‡Acaba con los Sombra Jurada en las Tierras Devastadas y regresa junto al Héroe Caído de la Horda.‡Acaba con los Sombra Jurada en Las Tierras Devastadas y regresa junto al héroe caído de la Horda.‡Tuez les Liges d\'ombre dans les Terres Foudroyées et revenez voir le Héros de la Horde tombé au combat.‡杀死诅咒之地的魔誓者，然后回到部落英雄的灵魂那儿。‡殺死詛咒之地的影誓祭司，然後回到部落英雄的靈魂那兒。',
  }
},
[8425] = {
  {
    'Penas Vodu‡Вудуистские перья‡Voodoofedern‡부두 깃털‡Plumas Vudú‡Plumas Vudú‡Plumes vaudou‡巫毒羽毛‡巫毒羽毛',
    nil,
    'Leve as Penas Vodu dos trolls do Templo Submerso para o Herói Caído da Horda.‡Принесите вудуистские перья павшему герою Орды, забрав их у троллей в Затонувшем храме.‡Bringt die Voodoofedern der Trolle im Versunkenen Tempel zu dem gefallenen Helden der Horde.‡호드 영웅의 넋에게 가라앉은 사원에 있는 트롤들에게서 황색 부두 깃털, 청색 부두 깃털, 녹색 부두 깃털을 빼앗아 각 2개씩 가져가야 합니다.‡Llévale las plumas vudú de los trols del Templo Sumergido al héroe caído de la Horda.‡Llévale las plumas vudú de los trols del Templo Sumergido al héroe caído de la Horda.‡Apportez les Plumes vaudou des trolls du Temple englouti au Héros de la Horde tombé au combat.‡将你从沉没的神庙的巨魔身上得到的巫毒羽毛交给部落英雄的灵魂。‡將你從沉沒的神廟的食人妖身上得到的巫毒羽毛交給部落英雄的靈魂。',
  }
},
[8430] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à l\'un des porteguerre de la Horde, devant les champs de bataille.‡棒极了！你在战歌峡谷保卫战中表现很出色！愿你的英雄事迹在我们的土地上流传开来。‡將3枚戰歌峽谷榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8436] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin Arathi‡资源竞赛‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8437] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin Arathi‡资源竞赛‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8438] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin Arathi‡资源竞赛‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8439] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin Arathi‡资源竞赛‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
