},
[27569] = {
  {
    'Táticos dos Ferro Negro‡Тактики из клана Черного Железа‡Strategen der Dunkeleisenzwerge‡검은무쇠 부족의 전술가‡Tácticos Hierro Negro‡Tácticos Hierro Negro‡Les tacticiens sombrefers‡黑铁战术家‡黑鐵戰術家',
    nil,
    'Mate o General Forjaversa e o Lorde Golem Argelmach.‡Убейте генерала Кузню Гнева и повелителя големов Аргелмаха.‡Tötet General Zornesschmied und Golemlord Argelmach.‡사령관 앵거포지와 골렘 군주 아젤마크를 처치해야 합니다.‡Mata al general Forjainquina y al Señor Gólem Argelmach.‡Mata al general Forjainquina y al Señor Gólem Argelmach.‡Tuez le Général Forgehargne et le Seigneur golem Argelmach.‡杀死怒炉将军和傀儡统帅阿格曼奇。‡殺死安格弗將軍和魔像領主阿格曼奇。',
  }
},
[27570] = {
  {
    '‡Текущая ситуация‡Der Stand der Dinge‡현재 상황‡La situación hasta ahora‡‡Rapport de situation‡‡',
    nil,
    '‡Поговорите с Готурой Четырьмя Ветрами в крепости Громмаш в Оргриммаре.‡Sprecht mit Gotura Vierwind in der Feste Grommash in Orgrimmar.‡오그리마 그롬마쉬 요새에 있는 고투라 포윈즈와 대화해야 합니다.‡Habla con Gotura Cuatro Vientos en el Fuerte Grommash en Orgrimmar.‡‡Allez voir Gotura Quatre-vents au Fort Grommash, à Orgrimmar.‡‡',
  }
},
[27571] = {
  {
    'O Glutão Implacável‡Трактир "Угрюмый обжора"‡Der Grimmige Säufer‡험상궂은 주정뱅이 선술집‡El Tragapenas‡El Tragapenas‡Le Sinistre écluseur‡黑铁酒吧‡黑鐵酒吧',
    nil,
    'Brigue com Hurley Bafonegro, Birra Guardachave e Ribas Parafuseta.‡Подеритесь с Харли Чернопыхом, Штоппором Наливалсом и Риббли Крутипробом.‡Kämpft gegen Hurley Pestatem, Stöpsel Zapfring und Ribbly Schraubstutz.‡헐레이 블랙브레스, 플러거 스패즈링, 리블리 스크류스피곳과 싸워야 합니다.‡Peléate con Hurley Negrálito, Plugger Aropatoso y Ribbly Llavenrosca.‡Peléate con Hurley Negrálito, Plugger Aropatoso y Ribbly Llavenrosca.‡Battez-vous contre Hurley Soufflenoir, Lanfiche Brouillecircuit et Ribbly Fermevanne.‡与霍尔雷·黑须、普拉格和雷布里·斯库比格特交手。‡和霍爾雷•黑鬚、普拉格•史帕齊林、雷布里•斯庫比格特交戰。',
  }
},
[27572] = {
  {
    '‡Собрание в Запределье‡Eine Versammlung in der Scherbenwelt‡아웃랜드 집결‡Una reunión en Terrallende‡‡Un rassemblement en Outreterre‡外域的聚会‡',
    nil,
    '‡Поговорите с Траллом у Трона стихий в Награнде.‡Sprecht mit Thrall am Thron der Elemente in Nagrand.‡나그란드 정령의 옥좌에 있는 스랄과 대화해야 합니다.‡Habla con Thrall en El Trono de los Elementos en Nagrand.‡‡Parlez à Thrall au Trône des éléments, en Nagrand.‡跟纳格兰元素王座的萨尔谈一谈。‡',
