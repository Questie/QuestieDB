[5047] = {
  {
    'Lépido Fagueiro, ao seu dispor!‡Пип Шустрикс, к вашим услугам!‡Pip Flitzwitz, zu Euren Diensten!‡핍 퀵윗, 명을 받듭니다!‡¡Pip Perspicaz, a su servicio!‡¡Pip Perspicaz, a tu servicio!‡Pépin Preste-Jugeote, à votre service !‡皮普·急智，为您效劳！‡皮普·捷思，為您效勞!',
    nil,
    'Fale com Málifus Trevamalho em Visteterna.‡Переговорите с Малифоем Черномолотом в Круговзоре.‡Sprecht mit Malyfous Düsterhammer in der Ewigen Warte.‡눈망루 마을에 있는 말리퍼스 다크해머와 대화해야 합니다.‡Habla con Malyfous Martilloscuro en Vista Eterna.‡Habla con Malyfous Martilloscuro en Vista Eterna.‡Parler à Malyfous Sombremartel à Long-Guet.‡与永望镇的玛雷弗斯·暗锤谈一谈。‡與永望鎮的瑪雷弗斯·暗錘談話。',
  }
},
[5048] = {
  {
    '‡Добросердечная Эмма‡Emma die Nette‡‡El buen carácter de Emma‡El buen carácter de Emma‡Emma la bonne pâte‡善良的艾玛‡',
    nil,
    '‡Найдите в Штормграде старушку Эмму и узнайте, действительно ли она – Эмма Фелстоун. Если да, то, может, ей понравится та посылочка, что собрала для нее Джанис Фелстоун.‡Sucht die alte Emma in Sturmwind und findet heraus, ob sie tatsächlich Emma Teufelsstein ist. Wenn sie es ist, dann möchte sie vielleicht das Paket haben, das Janice Teufelsstein für sie gepackt hat.‡‡Encuentra a la Vieja Emma en Ventormenta y descubre si realmente es Emma Piedra Mácula. Si lo es, quizás quiera el paquete que Janice Piedra Mácula hizo para ella.‡Encuentra a la Vieja Emma en Ventormenta y descubre si realmente es Emma Piedra Mácula. Si lo es, quizás quiera el paquete que Janice Piedra Mácula hizo para ella.‡Trouver la vieille Emma à Hurlevent, et découvrir si elle est en fait Emma Gangrepierre. Si c\'est le cas, elle appréciera peut-être le colis que Janice Gangrepierre lui a préparé.‡找到暴风城的艾玛并弄清她是否就是艾玛·费尔斯通。如果是的话，那么她可能想要拿到詹妮丝·费尔斯通给她的包裹。‡',
  }
},
[5049] = {
  {
    '‡Грусть Иеремии‡Der Jammer des Jeremiah‡‡La depre de Jeremiah‡La depre de Jeremiah‡Le blues de Jeremiah‡杰雷米亚的忧伤‡',
    nil,
    '‡Найдите в Подгороде Иеремию Пейсона и выясните, в самом ли деле он Иеремия Фелстоун. Если да, передайте ему посылку от Джанис Фелстоун.‡Sucht Jeremiah Payson in Unterstadt und findet heraus, ob er tatsächlich Jeremiah Teufelsstein ist. Wenn er es ist, dann möchte er vielleicht das Paket haben, das Janice Teufelsstein für ihn gepackt hat.‡‡Encuentra a Jeremiah Payson en Entrañas y averigua si en realidad es Jeremiah Piedra Mácula. Si es así, quizás quiera el paquete que Janice Piedra Mácula preparó para él.‡Encuentra a Jeremiah Payson en Entrañas y averigua si en realidad es Jeremiah Piedra Mácula. Si es así, quizás quiera el paquete que Janice Piedra Mácula preparó para él.‡Trouver Jeremiah Payson à Fossoyeuse et découvrir s\'il est en fait Jeremiah Gangrepierre. Si c\'est le cas, il appréciera peut-être le colis que Janice Gangrepierre lui a préparé.‡在幽暗城找到杰雷米亚·派森并查明他是否就是你要找的杰雷米亚·费尔斯通。如果他是的话，那么他可能会想要拿到詹妮丝·费尔斯通寄给他的包裹。‡',
  }
},
[5050] = {
  {
    'Pingente da Sorte‡Оберег удачи‡Glücksbringer‡행운의 부적‡Talismán de buena suerte‡Talismán de buena suerte‡Charme porte-bonheur‡好运护符‡好運符咒',
    nil,
    'Devolva o Meio-pingente da Sorte para Janice Pedravil nas Terras Pestilentas Ocidentais.‡Отнесите половинку талисмана Джанис Фелстоун в Западные Чумные земли.‡Bringt Janice Teufelsstein in den Westlichen Pestländern die Hälfte ihres Glücksbringers zurück.‡서부 역병지대에 있는 재니스 펠스톤에게 행운의 부적 조각을 돌려줘야 합니다.‡Devuelve a Janice Piedra Mácula en las Tierras de la Peste del Oeste su Medio talismán de buena suerte.‡Devuelve a Janice Piedra Mácula en las Tierras de la Peste del Oeste su Medio talismán de buena suerte.‡Rapporter son Demi-charme porte-bonheur à Janice Gangrepierre dans les Maleterres de l\'ouest.‡把半个好运护符还给西瘟疫之地的詹妮丝-费尔斯通。‡把半個好運符咒還給西瘟疫之地的詹妮絲‧費爾斯通。',
  }
},
[5051] = {
  {
    'Um só coração‡Вторая половина‡Zwei Hälften vereint‡두 개의 조각이 하나되어‡Dos mitades hacen una‡Dos mitades hacen una‡Deux moitiés deviennent Une‡两半合一‡合二為一',
    nil,
    'Localize a outra metade do Pingente da Sorte em algum lugar da Fazenda Pedravil, nas Terras Pestilentas Ocidentais, e monte-o novamente.|n|nDê o Pingente da Sorte a Janice Pedravil, na Fazenda Pedravil, que fica nas Terras Pestilentas Ocidentais.‡Отыщите вторую половину оберега Удачи на ферме Фелстоун в Западных Чумных землях и соберите его.|n|nОтдайте оберег Удачи Джанис Фелстоун.‡Sucht auf dem Teufelssteinfeld in den Westlichen Pestländern nach der anderen Hälfte des Glücksbringers und setzt ihn wieder zusammen.|n|nGebt den Glücksbringer Janice Teufelsstein auf dem Teufelssteinfeld in den Westlichen Pestländern.‡서부 역병지대에 있는 펠스톤 농장에서 행운의 부적 목줄을 찾아 붙이십시오.|n|n서부 역병지대의 펠스톤 농장에 있는 재니스 펠스톤에게 행운의 부적을 가져가야 합니다.‡Localiza la otra mitad del talismán de la suerte en algún lugar del Campo de Piedramácula, en las Tierras de la Peste del Oeste, y recomponlo.|n|nDale el talismán de la suerte a Janice Piedra Mácula en la Granja de Piedra Mácula, en las Tierras de la Peste del Oeste.‡Localiza la otra mitad del talismán de la suerte en algún lugar del Campo de Piedramácula, en las Tierras de la Peste del Oeste, y recomponlo.|n|nDale el talismán de la suerte a Janice Piedra Mácula en la Granja de Piedra Mácula, en las Tierras de la Peste del Oeste.‡Trouver l\'autre moitié du Charme porte-bonheur quelque part dans le périmètre de la Ferme Gangrepierre dans les Maleterres de l\'ouest et le recoller.|n|nDonner le Charme porte-bonheur à Janice Gangrepierre à la Ferme Gangrepierre, dans les Maleterres de l\'ouest.‡在西瘟疫之地的费尔斯通农场某地找到另外一半好运护符，并把两半护符合并。|n|n把好运护符交给西瘟疫之地费尔斯通农场的詹妮丝·费尔斯通。‡在西瘟疫之地的費爾斯通農場的某個地方找尋另外半個好運符並組合起來。|n|n把好運符交給西瘟疫之地費爾斯通農場的珍妮絲·菲爾斯通。',
  }
},
[5052] = {
  {
    '‡Кровавые осколки Агамаггана‡Blutsplitter von Agamaggan‡아감마간의 혈석 파편‡Esquirlas de sangre de Agamaggan‡Esquirlas de sangre de Agamaggan‡Joyaux de sang d\'Agamaggan‡阿迦玛甘的血岩碎片‡',
    nil,
    '‡Принесите кровавый осколок Кривозубу в Лагерь Таурахо в Степи.|n|nСоберите побольше кровавых осколков, и он одарит вас силой, дарованной ему Агамагганом.‡Bringt Quetschzahn im Camp Taurajo im Brachland einen Blutsplitter.|n|nSammelt weitere Blutsplitter, wenn Ihr von ihm mit Agamaggans Macht gesegnet werden möchtet.‡불모의 땅의 타우라조 야영지에 있는 뻐드렁니에게 혈석을 가져가야 합니다.|n|n아감마간의 힘을 빌린 축복을 받고 싶다면 최대한 많이 수집해야 합니다.‡Llévale una esquirla de sangre a Quebrantadientes en el Campamento Taurajo en Los Baldíos.|n|nReúne más esquirlas de sangre si quieres que te bendiga con el poder de Agamaggan.‡Llévale una esquirla de sangre a Quebrantadientes en el Campamento Taurajo en Los Baldíos.|n|nReúne más esquirlas de sangre si quieres que te bendiga con el poder de Agamaggan.‡Apporter un Joyau de sang à Mutiledent, au Camp Taurajo, dans les Tarides.|n|nCollectez plus de Joyaux de sang si vous souhaitez qu\'il vous gratifie de la puissance d\'Agamaggan.‡给陶拉祖营地的碎牙带去一块血岩碎片。|n|n如果你想要他赐予你阿迦玛甘的力量，就搜集更多的血岩碎片。‡',
  }
},
[5053] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Test quest to see if mail is sent to your mailbox. Just hit complete, then go check your mail.|n|nHave a nice day.‡Тестовый квест, чтобы проверить, придет ли письмо в почтовый ящик. Нажмите "Завершить", а потом проверьте почту.|n|nПриятного дня!‡Test-Quest, um zu sehen, ob Post in Eurem Briefkasten landet. Klickt einfach auf \'Abschließen\' und überprüft dann Euren Briefkasten.|n|nEinen schönen Tag noch.‡우편 전송 확인용 시험 퀘스트입니다. 완료를 누른 후 우편을 확인해야 합니다.|n|n좋은 하루 보내시길.‡Esta misión es una prueba para ver si se manda correo a tu buzón. Tan solo haz clic para completarla y comprueba tu correo.|n|nQue tengas un buen día.‡Misión de prueba para comprobar si el correo se envía a tu buzón. Tan solo presiona completar y luego ve a revisar tu correo.|n|nQue tengas un buen día.‡Testez la quête pour voir si le courrier est envoyé à votre boîte aux lettres. Cliquez sur Terminer, puis vérifiez votre courrier.|n|nBonne journée.‡测试任务，看看能不能给你的邮箱寄信。点击完成就行，然后去检查邮箱。|n|n祝你愉快。‡這個任務是為了確認郵件是否有送到你的信箱裡。點擊完成後，檢查郵件即可。|n|n祝你有個美好的一天。',
  }
},
[5054] = {
  {
    'Úrsius, o Dentilhaço‡Урсиус из щербозубов‡Ursius von den Splitterzahnbären‡톱니이빨곰 우르시우스‡Ursius de los Dentoesquirla‡Ursius de los Dentoesquirla‡Ursius des Crocs acérés‡碎齿熊尤西乌斯‡裂齒熊尤西烏斯',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você mate Úrsius.‡По просьбе Шторма Призрачное Копыто в Круговзоре в Зимних Ключах убейте Урсиуса.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Ursius tötet.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 우르시우스를 처치해 달라고 했습니다.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Ursius.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Ursius.‡Orage Sabot-d\'ombre, à Long-Guet au Berceau-de-l\'Hiver, veut que vous tuiez Ursius.‡永望镇的斯托姆·影蹄想要你去杀死尤西乌斯。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死尤西烏斯。',
  }
},
[5055] = {
  {
    'Brumeran dos Ventogelante‡Хладнокрылая Брумеран‡Brumeran von den Eiswindschimären‡서리바람 브룸랜‡Brumerán de los Orvallo‡Brumerán de los Orvallo‡Brumeran des Noroît‡冰风奇美拉布鲁米兰‡冰風奇美拉布魯米蘭',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você mate Brumeran.‡Убейте Брумеран по просьбе Шторма Призрачное Копыто в Круговзоре в Зимних Ключах.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Brumeran tötet.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 브룸랜을 처치해 달라고 했습니다.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Brumerán.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Brumerán.‡Orage Sabot-d\'ombre, à Long-Guet au Berceau-de-l\'Hiver, veut que vous tuiez Brumeran.‡永望镇的斯托姆·影蹄想要你去杀死布鲁米兰。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死布魯米蘭。',
  }
},
[5056] = {
  {
    'Shy-Rotam‡Ши-Ротам‡Shy-Rotam‡샤이로탐‡Shi-Rotam‡Shi-Rotam‡Shy-Rotam‡希洛塔姆‡希洛塔姆',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você derrote Shy-Rotam.‡Убейте Ши-Ротам для Шторма Призрачное Копыто.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Shy-Rotam besiegt.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 샤이로탐을 처치해 달라고 했습니다.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que acabes con Shi-Rotam.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que acabes con Shi-Rotam.‡Orage Sabot-d\'ombre, à Long-Guet au Berceau-de-l\'Hiver, veut que vous triomphiez de Shy-Rotam.‡永望镇的斯托姆-影蹄想要你去杀死希洛塔姆。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死希洛塔姆。',
  }
},
[5057] = {
  {
    '‡Прежние свершения‡Frühere Abenteuer‡‡Esfuerzos del pasado‡Esfuerzos del pasado‡Essais passés‡以往的努力‡',
    nil,
    '‡Отнесите Знак Шторма Призрачное Копыто Мелору Каменное Копыто в Громовой Утес.‡Bringt Storm Schattenhufs Gutschein zu Melor Steinhuf in Donnerfels.‡‡Lleva la Señal de Ventisca Pezuña Umbría a Melor Pezuña Pétrea de Cima del Trueno.‡Lleva la Señal de Ventisca Pezuña Umbría a Melor Pezuña Pétrea de Cima del Trueno.‡Apportez le Marqueur d\'Orage Sabot-d\'ombre à Melor Sabot-de-Pierre aux Pitons-du-Tonnerre.‡把斯托姆·影蹄的徽记交给雷霆崖的梅洛·石蹄。‡',
  }
},
[5058] = {
  {
    '‡Дневник миссис Далсон‡Frau Dalsons Tagebuch‡달슨 부인의 일기‡Diario de la señora Dalson‡Diario de la señora Dalson‡Journal de Mme Dalson‡达尔松夫人的日记‡達爾松夫人的日記',
    nil,
    nil,
  }
},
[5059] = {
  {
    '‡Под замком‡Weggeschlossen‡잠긴 화장실‡Encierro‡Encierro‡Enfermé‡被锁起来的农夫‡',
    nil,
    nil,
  }
},
[5060] = {
  {
    '‡Под замком‡Weggeschlossen‡잠긴 화장실‡Encierro‡Encierro‡Enfermé‡被锁起来的农夫‡',
    nil,
    nil,
  }
},
[5061] = {
  {
    'Forma aquática‡Водный облик‡Wassergestalt‡바다표범 변신‡Forma acuática‡Forma acuática‡Forme aquatique‡水栖形态‡水棲形態',
    nil,
    'Volte a Darnassus e mostre a Mathrengyl Ursivagus o Pingente do Leão Marinho.‡Вернитесь в Дарнас и покажите Матренгилу Медвежьей Лапе свою подвеску Морского Льва.‡Kehrt nach Darnassus zurück und zeigt Mathrengyl Bärenfährte den Anhänger des Seelöwen.‡다르나서스로 돌아가 마스렌길 베어워커에게 바다표범의 펜던트를 보여 줘야 합니다.‡Vuelve a Darnassus y enséñale el colgante del león marino a Mathrengyl Garroso.‡Vuelve a Darnassus y enséñale el colgante del león marino a Mathrengyl Garroso.‡Retourner à Darnassus et montrer le Pendentif du lion de mer à Mathrengyl Pasdelours.‡回到达纳苏斯，让玛斯雷·驭熊者看看你的海狮坠饰。‡回到達納蘇斯，讓瑪斯雷·馭熊者看看你的海獅墜飾。',
  }
},
[5062] = {
  {
    'Fogo sagrado‡Священное пламя‡Hochheiliges Feuer‡신성한 불‡El fuego Sagrado‡El fuego Sagrado‡Feu sacré‡神圣之火‡聖火',
    nil,
    'Reúna 10 punhados de Agave Incendia, depois consulte Magatha Temível Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Соберите 10 листов огненной агавы и поговорите с Магатой Зловещий Тотем на Вершине Старейшин в Громовом Утесе.‡Sammelt 10 Scheffel Brandpulveragaven und beratet Euch dann mit Magatha Grimmtotem auf der Anhöhe der Ältesten in Donnerfels.‡불꽃 용설란 10포기를 모아 썬더 블러프 장로의 봉우리에 있는 마가타 그림토템을 찾아가야 합니다.‡Recoge 10 montones de pitas incendiarias y después pide consejo a Magatha Tótem Siniestro en el Alto de los Ancestros de Cima del Trueno.‡Recoge 10 pitas incendiarias y después pide consejo a Magatha Tótem Siniestro en el Alto de los Ancestros de Cima del Trueno.‡Ramasser 10 boisseaux d\'agave d\'Incendia, puis consulter Magatha Totem-sinistre sur la Cime des Anciens dans les Pitons-du-Tonnerre.‡收集10支火岩龙舌兰，然后去找雷霆崖长者高地的玛加萨·恐怖图腾。‡採集10支火岩龍舌蘭，然後去雷霆崖的長者高地尋找瑪加薩·恐怖圖騰。',
  }
},
[5063] = {
  {
    'Casquete do Sábio Escarlate‡Шапка ученого из Алого ордена‡Kappe des Scharlachroten Wissenden‡붉은 학자의 모자‡Almete del Sabio Escarlata‡Almete del Sabio Escarlata‡La coiffe du savant écarlate‡血色学者之帽‡血色學者之帽',
    nil,
    'Para criar o Casquete do Sábio Escarlate, você precisa levar os seguintes itens para Málifus Trevamalho: 1 Pelego Imaculado da Fera; 5 Suturas de Abominação Puídas; 8 Cristais Arcanos; 5 Fios Escarlate Encantados. |n|nVocê também deverá pagar 50 ouros pela fabricação do item.‡Для изготовления шапки ученого из Алого ордена вам нужно принести Малифою Черномолоту 1 безупречную звериную шкуру, 5 кусков потертого шовного материала поганища, 8 чародейских кристаллов, 5 зачарованных алых нитей. |n|nВы также должны будете уплатить 50 золотых монет за изготовление головного убора.‡Um die Kappe des scharlachroten Wissenden herzustellen, müsst Ihr die folgenden Dinge zu Malyfous Düsterhammer bringen: 1 makelloser Balg der Bestie; 5 ausgefranste Monstrositätenstickereien; 8 Arkankristalle; 5 verzauberte scharlachrote Fäden.|n|nIhr müsst außerdem 50 Goldstücke für die Herstellung des Gegenstandes zahlen.‡붉은 학자의 모자를 얻으려면 말리퍼스 다크해머에게 다음 재료를 가져가야 합니다. 온전한 괴수의 가죽 1개, 닳아해진 누더기골렘 조각 5개, 신비한 수정 8개, 마력 깃든 붉은 실타래 5개|n|n제작비로 50골드도 가져가야 합니다.‡Para crear el Almete del Sabio Escarlata deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 8 cristales Arcanos; 5 hilos escarlata encantados.|n|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Para crear el Almete del Sabio Escarlata deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 8 cristales Arcanos; 5 hilos escarlata encantados.|n|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Pour créer la Coiffe du savant écarlate, il faut rapporter les éléments suivants à Malyfous Sombremartel : 1 Peau de la Bête en parfait état ; 5 Coutures d\'Abomination effilochées ; 8 Cristaux des arcanes ; 5 Fils écarlates enchantés.|n|nIl faudra aussi payer 50 pièces d\'or pour le travail de fabrication.‡为了制造血色学者之帽，你必须将下列物品交给玛雷弗斯·暗锤：1块比斯巨兽的皮，5根磨损的憎恶缝合线，8块奥术水晶，5根魔化红线。|n|n另外你还必须支付50金币的制作费用。‡為了製造血色學者之帽，你必須將下列物品交給瑪雷弗斯·暗錘:1塊比斯巨獸的皮，5根磨損的憎惡縫合線，8塊秘法水晶，5根附魔血色絲線。|n|n另外你還必須支付50金幣的製作費用。',
  }
},
[5064] = {
  {
    'Espiando os Temível Totem‡Наблюдение за Зловещим Тотемом‡Grimmtotemspionage‡그림토템 부족 염탐‡Espiando a los Tótem Siniestro‡Espiando a los Tótem Siniestro‡Espionner le Totem-sinistre‡恐怖图腾的密信‡偵察恐怖圖騰族',
    nil,
    'Localize e recupere os três Bilhetes Secretos no Pináculo da Nuvem Negra.‡Найдите и заберите три тайные записки на Пике Темного Облака.‡Sucht die drei geheimen Notizen im Düsterwolkengipfel und bringt sie zurück.‡먹구름 봉우리에 있는 비밀 쪽지 3개를 모아야 합니다.‡Localiza y reúne las 3 notas secretas que hay en Cumbre de la Nube Negra.‡Localiza y reúne las 3 notas secretas que hay en Cumbre de la Nube Negra.‡Trouver et récupérer les trois Notes Secrètes à la Cime de Noir-Nuage.‡在黑云峰拿到三封密信。‡在黑雲頂找出並拿回三封秘密訊息。',
  }
},
[5065] = {
  {
    'As tabuletas Mosh\'Aru perdidas‡Утраченные таблички Мошару‡Die verlorenen Schrifttafeln von Mosh\'aru‡모쉬아루의 잃어버린 서판‡Las tablillas perdidas Mosh\'aru‡Las tablillas perdidas Mosh\'aru‡Les tablettes perdues de Mosh\'aru‡失落的摩沙鲁石板‡失落的摩沙魯石板',
    nil,
    'Leve a Terceira e a Quarta Tabuletas Mosh\'Aru ao Prospector Botaférrea, em Tanaris.‡Принесите третью и четвертую таблички Мошару геологу Железному Башмаку в Танарис.‡Bringt Ausgrabungsleiter Eisenschuh in Tanaris die dritte und vierte Schrifttafel von Mosh\'aru.‡세 번째와 네 번째 모쉬아루 서판을 찾아 타나리스에 있는 발굴조사단장 아이언부트에게 가져가야 합니다.‡Llévale la tercera y cuarta tablillas Mosh\'aru al prospector Ferrobota, que está en Tanaris.‡Llévale la tercera y cuarta tablillas Mosh\'aru al prospector Ferrobota, que está en Tanaris.‡Apportez la Troisième et la Quatrième tablette Mosh\'aru au Prospecteur Botte-de-fer, à Tanaris.‡把第三块和第四块摩沙鲁石板交给塔纳利斯的勘查员詹斯·铁靴。‡把第三塊和第四塊摩沙魯石板交給塔納利斯的勘察員鐵靴。',
  }
},
[5066] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Comandante Ashlam Punhobom. Ele montou base no Acampamento Ventogelante, ao norte das Montanhas de Alterac.‡Найдите командира Ашлама Отважного Кулака в лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡사령관 아쉬람 발러피스트를 찾아야 합니다. 그의 주둔지는 알터랙 산맥 북쪽의 서리바람 야영지입니다.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouvez le commandant Ashlam Vaillepoing. Il s\'est installé au Camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[5067] = {
  {
    'Perneiras do Arcanismo‡Поножи тайны‡Gamaschen von Arcana‡아카나의 다리보호구‡Leotardos de Arcana‡Leotardos de Arcana‡Jambières d\'Arcana‡阿卡纳护腿‡阿卡納護腿',
    nil,
    'Para criar as Perneiras do Arcanismo, você precisa levar os seguintes itens para Málifus Trevamalho: 1 Pelego Imaculado da Fera; 5 Suturas de Abominação Puídas; 5 Barras de Arcanita; 5 Fluidos Embalsamadores de Friomúrmuro.|n|nVocê também deverá pagar 50 ouros pela fabricação do item.‡Для изготовления поножей тайны вам нужно принести Малифою Черномолоту 1 безупречную звериную шкуру, 5 кусков потертого шовного материала поганища, 5 арканитовых слитков и 5 порций бальзамировочного состава Снегошепота. |n|nВам придется также заплатить 50 золотых за изготовление этого предмета.‡Um die Gamaschen von Arcana herzustellen, müsst Ihr die folgenden Dinge zu Malyfous Düsterhammer bringen: 1 makelloser Balg der Bestie; 5 ausgefranste Monstrositätenstickereien; 5 Arkanitbarren; 5 Einheiten Frostraunens Balsamierungsflüssigkeit.|n|nIhr müsst außerdem 50 Goldstücke für die Herstellung des Gegenstandes zahlen.‡아카나의 다리보호구를 얻으려면 말리퍼스 다크해머에게 다음 재료를 가져가야 합니다. 온전한 괴수의 가죽 1개, 닳아해진 누더기골렘 조각 5개, 아케이나이트 주괴 5개, 프로스트위스퍼의 불변의 액체 5개.|n|n제작비로 50골드도 가져가야 합니다.‡Para crear los leotardos arcana deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 5 barras de arcanita; 5 líquidos de embalsamar de Murmuhielo.|n|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Para crear los leotardos arcana deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 5 barras de arcanita; 5 líquidos de embalsamar de Murmuhielo.|n|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Pour fabriquer les Jambières d\'Arcana, il faut rapporter les éléments suivants à Malyfous Sombremartel : 1 Peau de la Bête en parfait état ; 5 Coutures d\'Abomination effilochées ; 5 Barres d\'arcanite ; 5 Liquides d\'embaumement de Murmegivre.|n|nIl faudra également payer 50 pièces d\'or pour le travail de fabrication.‡为了制造阿卡纳护腿，你必须将下列物品交给玛雷弗斯·暗锤：1块比斯巨兽的皮，5根磨损的憎恶缝合线，5块奥金锭，5份莱斯·霜语的防腐液。|n|n另外你还必须支付50金币的制作费用。‡為了製造阿卡納護腿，你必須將下列物品交給瑪雷弗斯·暗錘:1塊比斯巨獸的皮，5根磨損的憎惡縫合線，5塊奧金錠，5份萊斯·霜語的防腐液。|n|n另外你還必須支付50金幣的製作費用。',
  }
},
[5068] = {
  {
    'Peitoral da Sede de Sangue‡Кираса кровавой жажды‡Brustplatte des Blutdurstes‡핏빛갈증의 가슴보호갑‡Coraza Sed de Sangre‡Coraza Sed de Sangre‡La cuirasse carnassière‡嗜血胸甲‡血嗜胸甲',
    nil,
    'Para criar o Peitoral da Sede de Sangue, você precisa levar os seguintes itens para Málifus Trevamalho: 1 Pelego Imaculado da Fera; 10 Suturas de Abominação Puídas; 5 Barras de Arcanita; 5 Peles de Sombra.|n|nVocê também deverá pagar 50 ouros pela fabricação do item.‡Для изготовления кирасы кровавой жажды вам нужно принести Малифою Черномолоту 1 безупречную звериную шкуру, 10 кусков потертого шовного материала поганища, 5 арканитовых слитков и 5 шкур тени.|n|nВы также должны будете уплатить 50 золотых за изготовление доспеха.‡Um die Brustplatte des Blutdurstes herzustellen, müsst Ihr die folgenden Dinge zu Malyfous Düsterhammer bringen: 1 makelloser Balg der Bestie; 10 ausgefranste Monstrositätenstickereien; 5 Arkanitbarren; 5 Häute des Schattens.|n|nIhr müsst außerdem 50 Goldstücke für die Herstellung des Gegenstandes zahlen.‡핏빛갈증의 가슴보호갑을 얻으려면 말리퍼스 다크해머에게 다음 재료를 가져가야 합니다. 온전한 괴수의 가죽 1개, 닳아해진 누더기골렘 조각 10개, 아케이나이트 주괴 5개, 어둠의 허물 5개.|n|n그리고 제작 비용으로 50골드도 갖고 가야 합니다.‡Para crear la coraza Sed de Sangre deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 10 costuras desgarradas de abominación; 5 barras de arcanita; 5 pieles de Sombra.|n|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Para crear la coraza Sed de Sangre deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 10 costuras desgarradas de abominación; 5 barras de arcanita; 5 pieles de Sombra.|n|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Pour fabriquer la Cuirasse carnassière, il faut rapporter les éléments suivants à Malyfous Sombremartel : 1 Peau de la Bête en parfait état ; 10 Coutures d\'Abomination effilochées ; 5 Barres d\'arcanite ; 5 Peaux des ombres.|n|nIl faudra également payer 50 pièces d\'or pour le travail de fabrication.‡为了制造嗜血胸甲，你必须将下列物品交给玛雷弗斯·暗锤：1块比斯巨兽的皮，10根磨损的憎恶缝合线，5块奥金锭，5块暗影之皮。|n|n另外你还必须支付50金币的制作费用。‡為了製造血嗜胸甲，你必須將下列物品交給瑪雷弗斯·暗錘:1塊比斯巨獸的皮，10根磨損的憎惡縫合線，5塊奧金錠，5塊暗影之皮。|n|n另外你還必須支付50金幣的製作費用。',
  }
},
[5081] = {
  {
    'A missão de Maxwell‡Миссия Максвелла‡Maxwells Mission‡맥스웰의 임무‡La misión de Maxwell‡La misión de Maxwell‡Mission de Maxwell‡麦克斯韦尔的任务‡麥斯威爾的任務',
    nil,
    'Travel to Blackrock Spire and destroy War Master Voone, Highlord Omokk, and Overlord Wyrmthalak.‡Отправляйтесь на пик Черной горы и устраните воеводу Вуна, вождя Омокка и повелителя Змейталака.‡Reist zur Schwarzfelsspitze und schaltet Kriegsmeister Voone, Hochlord Omokk und Oberanführer Wyrmthalak aus.‡‡Viaja a la Cumbre de Roca Negra y acaba con el maestro de guerra Voone, el alto señor Omokk y el señor supremo Vermiothalak.‡Viaja a la Cumbre de Roca Negra y acaba con el maestro de guerra Voone, el alto señor Omokk y el señor supremo Vermiothalak.‡Se rendre au Pic Rochenoire et tuer le maître de guerre Voone, le généralissime Omokk, et le seigneur Wyrmthalak.‡到黑石塔去消灭指挥官沃恩、欧莫克大王和维姆萨拉克。‡到黑石塔去消滅將領沃恩、歐莫克大王和維姆薩拉克主宰。',
  }
},
[5082] = {
  {
    '[DEPRECATED]Threat of the Winterfall‡Угроза со стороны Зимней Спячки‡Bedrohung durch die Winterfelle‡겨울눈 일족의 위협‡[DEPRECATED]La amenaza de los Nevada‡[DEPRECATED]La amenaza de los Nevada‡[PÉRIMÉ]La menace des Tombe-hiver‡冬泉熊怪的威胁‡[DEPRECATED]Threat of the Winterfall',
    nil,
    'Bruna Covaneve, de Hibérnia, quer que você mate 8 Desbravadores Invernosos, 8 Vigias do Covil dos Invernosos e 8 Totêmicos Invernosos.‡По просьбе Доновы Снегоноры из Зимних Ключей убейте 8 землепроходцев, 8 дозорных и 8 тотемистов из племени Зимней Спячки.‡Donova Schneeweh in Winterquell möchte, dass Ihr 8 Pfadfinder der Winterfelle, 8 Höhlenbehüter der Winterfelle und 8 Totemiker der Winterfelle erledigt.‡여명의 설원에 있는 도노바 스노우덴이 겨울눈 길잡이 8마리, 겨울눈 보초 8마리, 겨울눈 토템술사 8마리를 처치해 달라고 했습니다.‡Donova Cubilnevado de Cuna del Invierno quiere que mates 8 abrecaminos Nevada, 8 vigías del cubil Nevada y 8 totémicos Nevada.‡Donova Cubilnevado de Cuna del Invierno quiere que mates 8 abrecaminos Nevada, 8 vigías del cubil Nevada y 8 totémicos Nevada.‡Donova Antreneige du Berceau-de-l\'Hiver veut que vous tuiez 8 Guides, 8 Protecteurs et 8 Totémiques de la tribu Tombe-hiver.‡冬泉谷的多诺瓦·雪山要你去杀死8个冬泉探路者、8个冬泉巢穴守卫和8个冬泉图腾师。‡冬泉谷的多諾瓦·雪山要你去殺死8個冬泉探路者、8個冬泉巢穴守衛和8個冬泉圖騰師。',
  }
},
[5083] = {
  {
    '[DEPRECATED]Winterfall Firewater‡Огненная вода Зимней Спячки‡Feuerwasser der Winterfelle‡겨울눈 화주‡[DEPRECATED]Aguardiente Nevada‡[DEPRECATED]Aguardiente Nevada‡[PÉRIMÉ]L\'eau-de-feu de Tombe-hiver‡冬泉火酒‡[DEPRECATED]Winterfall Firewater',
    nil,
    'Leve o Frasco Vazio de Aguardente para Bruna Covaneve em Hibérnia.‡Принесите Донове Снегоноре пустую флягу из-под огненной воды.‡Bringt das leere Feuerwasserfläschchen zu Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 빈 화주 시험관을 가져가야 합니다.‡Lleva el frasco vacío de aguardiente a Donova Cubilnevado de Cuna del Invierno.‡Lleva el frasco vacío de aguardiente a Donova Cubilnevado de Cuna del Invierno.‡Apportez le Flacon d\'eau-de-feu vide à Donova Antreneige du Berceau-de-l\'Hiver.‡将空的火酒瓶交给冬泉谷的多诺瓦·雪山。‡將空的火水瓶交給冬泉谷的多諾瓦·雪山。',
  }
},
[5084] = {
  {
    '[DEPRECATED]Falling to Corruption‡Поддавшиеся порче‡Der Verderbnis erliegen‡타락에 빠지다‡[DEPRECATED]Sucumbir a la corrupción‡[DEPRECATED]Sucumbir a la corrupción‡[PÉRIMÉ]Corrompu‡堕落熊怪‡[DEPRECATED]Falling to Corruption',
    nil,
    'Investigue o acampamento dos pelursos Lenha Morta na parte norte de Selva Maleva para encontrar alguma pista.‡Исследуйте поселение фурболгов из племени Мертвого Леса в северной части Оскверненного леса в поисках ключа к разгадке.‡Durchsucht das Furbolglager der Totenwaldfelle im nördlichen Teil des Teufelswalds nach einem Hinweis.‡악령숲 북부에 있는 마른가지 펄볼그 야영지에서 단서를 찾아야 합니다.‡Busca una pista en el campamento fúrbolg Muertobosque en el norte de Frondavil.‡Busca una pista en el campamento fúrbolg Muertobosque en el norte de Frondavil.‡Chercher un indice dans le camp des furbolgs Mort-bois, dans le nord de Gangrebois.‡搜寻费伍德森林北部的死木熊怪的营帐，继续寻找线索。‡搜尋費伍德森林北部的死木熊怪的營帳，繼續尋找線索。',
  }
},
[5085] = {
  {
    '[DEPRECATED]Mystery Goo‡Таинственная слизь‡Geheimnisvoller Glibber‡신비한 액체‡[DEPRECATED]Baba misteriosa‡[DEPRECATED]Baba misteriosa‡[PÉRIMÉ]Gelée mystère‡神秘的粘液‡[DEPRECATED]Mystery Goo',
    nil,
    'Informe Bruna Covaneve sobre as suas descobertas.‡Вернитесь к Донове и сообщите ей о своих находках.‡Berichtet Donova Schneeweh von Euren Entdeckungen.‡발견한 사실을 도노바 스노우덴에게 알려야 합니다.‡Informa sobre tus descubrimientos a Donova Cubilnevado.‡Informa sobre tus descubrimientos a Donova Cubilnevado.‡Aller faire un rapport de vos trouvailles à Donova Antreneige.‡将你的发现报告给多诺瓦·雪山。‡帶著你的發現回去找多諾瓦·雪山。',
  }
},
[5086] = {
  {
    '[DEPRECATED]Toxic Horrors‡Ядовитый Ужас‡[DEPRECATED] Toxinschrecken‡맹독 정령‡[DEPRECATED]Horrores tóxicos‡[DEPRECATED]Horrores tóxicos‡[PÉRIMÉ]Horreurs toxiques‡剧毒之水‡[DEPRECATED]Toxic Horrors',
    nil,
    'Colha 3 Gotinhas de Horror Tóxico para Bruna Covaneve em Hibérnia.‡Соберите 3 капли ядовитого ужаса и принесите их Донове Снегоноре в Зимние Ключи.‡Sammelt 3 Toxinschreckentropfen für Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 맹독 정령 수액 3개를 가져가야 합니다.‡Recoge 3 gotitas de horror tóxico para Donova Cubilnevado de Cuna del Invierno.‡Recoge 3 gotitas de horror tóxico para Donova Cubilnevado de Cuna del Invierno.‡Récolter 3 Gouttelettes d\'Horreur toxique pour Donova Antreneige au Berceau-de-l\'Hiver.‡为冬泉谷的多诺瓦·雪山收集3份剧毒水滴。‡為冬泉谷的多諾瓦·雪山收集3份劇毒水滴。',
  }
},
[5087] = {
  {
    '[DEPRECATED]Winterfall Runners‡Гонцы Зимней Спячки‡Läufer der Winterfelle‡겨울눈 정찰꾼‡[DEPRECATED]Corredores Nevada‡[DEPRECATED]Corredores Nevada‡[PÉRIMÉ]Les messagers des Tombe-hiver‡冬泉信使‡[DEPRECATED]Winterfall Runners',
    nil,
    'Encontre os Mensageiros Invernosos e impeça-os de entregar o carregamento à Aldeia dos Invernosos.‡Найдите гонцов из племени Зимней Спячки и не позвольте им донести их груз до их деревни.‡Sucht die Läufer der Winterfelle und hindert sie daran, ihre Lieferung zum Lager der Winterfelle zu bringen.‡겨울눈 정찰꾼을 찾아 겨울눈 마을로 물건을 전달하는 것을 막아야 합니다.‡Encuentra a los corredores Nevada y detenlos antes de que entreguen su cargamento en Poblado Nevada.‡Encuentra a los corredores Nevada y detenlos antes de que entreguen su cargamento en Poblado Nevada.‡Trouver les Messagers tombe-hiver et les empêcher de livrer leur cargaison au Village des Tombe-hiver.‡找到冬泉信使，阻止他们向冬泉村运送物品。‡找到冬泉信差，阻止他們向冬泉村運送物品。',
  }
},
[5088] = {
  {
    'Arikara‡Арикара‡Arikara‡아리카라‡Arikara‡Arikara‡Arikara‡阿利卡拉‡阿利卡拉',
    nil,
    'Mate Arikara. Leve seus restos mortais e o pó de Incendia para Motega Barba de Fogo no Posto Confinalvo como prova do seu feito.‡Убейте Арикару и в качестве доказательства принесите ее останки вместе с воспламеняющим порошком Мотеге Огненной Гриве на заставу Белого Плеса.‡Erschlagt Arikara. Bringt ihre Überreste und das Brandpulver zu Motega Feuermähne im Weißgipfelposten als Beweis für Eure Tat.‡아리카라를 처치하고 그 증거물로 아리카라의 가죽과 불꽃 가루를 백사장 야영지에 있는 모테가 파이어메인에게 가져가야 합니다.‡Mata a Arikara. Llévale sus restos y el polvo de incendiaria a Motega Pirocabello al Campamento del Tramo Blanco como prueba de tus actos.‡Mata a Arikara. Llévale sus restos y el polvo de incendiaria a Motega Pirocabello al Campamento del Tramo Blanco como prueba de tus actos.‡Tuer Arikara. Rapporter sa dépouille et de la poudre d\'incendia à Motega Crin-de-feu au Poste de Blanc-relais comme preuve de votre acte.‡杀死阿利卡拉。把她的遗体和火岩粉交给白沙岗哨的莫特加·火鬃作为证明。‡殺死阿利卡拉。把她的遺體和火岩粉交給白沙崗哨的莫特加·火鬃作為證明。',
  }
},
[5089] = {
  {
    'Comando do General Drakkisath‡Распоряжения генерала Драккисата‡General Drakkisaths Befehl‡사령관 드라키사스의 명령서‡Orden del general Drakkisath‡Orden del general Drakkisath‡Ordres du général Drakkisath‡达基萨斯将军的命令‡達基薩斯將軍的命令',
    nil,
    'Leve o Comando do General Drakkisath para o Oficial Maxwell nas Estepes Ardentes.‡Отнесите приказ генерала Драккисата маршалу Максвеллу в Пылающие степи.‡Bringt den Befehl von General Drakkisath zu Marschall Maxwell in der Brennenden Steppe.‡불타는 평원에 있는 치안대장 맥스웰에게 사령관 드라키사스의 명령서를 가져가야 합니다.‡Llévale la orden del general Drakkisath al mariscal Maxwell en Las Estepas Ardientes.‡Llévale la orden del general Drakkisath al mariscal Maxwell en Las Estepas Ardientes.‡Remettez les Ordres du général Drakkisath au maréchal Maxwell dans les Steppes Ardentes.‡把达基萨斯将军的命令交给燃烧平原的麦克斯韦尔元帅。‡把達基薩斯將軍的命令交給燃燒平原的麥斯威爾元帥。',
  }
},
[5090] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Comandante Ashlam Punhobom. Ele montou base no Acampamento Ventogelante, ao norte das Montanhas de Alterac.‡Найдите командира Ашлама Неутомимого в Лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡알터랙 산맥 북쪽 서리바람 야영지에 본진을 두고 있는 아쉬람 발러피스트 사령관을 찾아가야 합니다.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouvez le commandant Ashlam Vaillepoing. Il s\'est installé au Camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[5091] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Comandante Ashlam Punhobom. Ele montou base no Acampamento Ventogelante, ao norte das Montanhas de Alterac.‡Найдите командира Ашлама Отважного Кулака в лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡아쉬람 발러피스트 사령관을 찾아가야 합니다. 그의 본진은 알터랙 산맥 북부 서리바람 야영지에 있습니다.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouvez le commandant Ashlam Vaillepoing. Il s\'est installé au Camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[5092] = {
  {
    'Abrindo caminho‡Зачистка территории‡Den Weg räumen‡통로 확보‡Despejar el camino‡Despejar el camino‡Nettoyer le passage‡扫清道路‡掃清道路',
    nil,
    'Mate 10 Esfoladores Descarnados e 10 Carniçais Salivantes na Colina do Pesar.|n|nFale novamente com o Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Убейте 10 скелетов-свежевателей и 10 слюнявых вурдалаков на холме Печали.|n|nВернитесь к командиру Ашламу Отважному Кулаку в лагерь Промозглого Ветра в Западных Чумных землях.‡Tötet 10 Skelettschinder und 10 sabbernde Ghuls in Trauerhügel.|n|nKehrt zu Kommandant Ashlam Ehrenschlag am Zugwindlager, westliche Pestländer, zurück.‡슬픔의 언덕에 있는 해골 타작꾼 10마리와 침 흘리는 구울 10마리를 처치해야 합니다.|n|n그런 다음 서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 돌아가십시오.‡Mata 10 despellejadores esqueléticos y 10 necrófagos esclavizantes en la Colina de las Penas.|n|nVuelve con el comandante Ashlam Puñovalor en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Mata 10 despellejadores esqueléticos y 10 necrófagos esclavizantes en la Colina de las Penas.|n|nVuelve con el comandante Ashlam Puñovalor en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Tuer 10 Ecorcheurs Squelettes et 10 Goules écumantes sur la Colline des chagrins.|n|nRetourner auprès du commandant Ashlam Vaillepoing au camp du Noroît, dans les Maleterres de l\'ouest.‡杀掉悔恨岭中的10个骷髅剥皮者和10个被奴役的食尸鬼。|n|n然后向西瘟疫之地冰风岗的指挥官阿什拉姆·瓦罗菲斯特复命。‡殺掉悔恨嶺中的10個骷髏撕掠者和10個被奴役的食屍鬼。|n|n然後向西瘟疫之地冰風營地的指揮官阿胥拉姆·瓦羅菲斯特覆命。',
  }
},
[5093] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Alto-executor Arcabuz. A base de operações dele fica no Baluarte, a leste das Clareiras de Tirisfal e da Cidade Baixa.‡Отыщите верховного палача Деррингтона. Его базовый лагерь находится у Бастиона, к востоку от Тирисфальских лесов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunk befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 데링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高階執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[5094] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Alto-executor Arcabuz. A base de operações dele fica no Baluarte, a leste das Clareiras de Tirisfal e da Cidade Baixa.‡Отыщите верховного палача Деррингтона. Его базовый лагерь находится у Бастиона, к востоку от Тирисфальских лесов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunk befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 데링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高階執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[5095] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Alto-executor Arcabuz. A base de operações dele fica no Baluarte, a leste das Clareiras de Tirisfal e da Cidade Baixa.‡Найдите верховного палача Деррингтона. Его базовый лагерь расположен в Бастионе к востоку от Тирисфальских лесов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunkt befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 데링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高階執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[5096] = {
  {
    'Distrações escarlate‡Вылазка в стан Алого ордена‡Scharlachrote Ablenkung‡붉은십자군의 주의 끌기‡Distracción Escarlata‡Distracción Escarlata‡Diversions écarlates‡误导血色十字军‡誤導血色十字軍',
    nil,
    'Vá até a base de operações da Cruzada Escarlate, que fica entre o Campo Pedravil e as Lágrimas de Dalson, e destrua a Tenda de Comando.|n|nPlante a bandeira do Flagelo no acampamento e fale novamente com o Alto-executor Arcabuz no Baluarte, nas Terras Pestilentas Ocidentais.‡Отправляйтесь в лагерь Алого ордена между полем Джанис и Слезами Далсона и уничтожьте командный шатер.|n|nРазместите в лагере знамя Плети и возвращайтесь к верховному палачу Деррингтону в Бастион, в Западные Чумные земли.‡Zieht zum Basislager des Scharlachroten Kreuzzugs zwischen dem Teufelssteinfeld und Dalsons Tränenfeld und zerstört sein Kommandozelt.|n|nLasst das Banner der Geißel im Lager wehen und kehrt dann zu Hochexekutor Derrington am Bollwerk in den Westlichen Pestländern zurück.‡펠스톤 농장과 달슨의 눈물 사이에 있는 붉은십자군의 야영지로 가서 지휘 막사를 파괴하십시오.|n|n기지에 스컬지 깃발을 세운 후, 서부 역병지대의 보루에 있는 고위집행관 데링턴에게 가야 합니다.‡Adéntrate en el campamento base de la Cruzada Escarlata entre el Campo de Piedramácula y el Llanto de Dalson y destruye su tienda de mando.|n|nColoca el estandarte de la Plaga en el campamento y vuelve con el sumo ejecutor Derrington en El Baluarte en las Tierras de la Peste del Oeste.‡Adéntrate en el campamento base de la Cruzada Escarlata entre el Campo de Piedramácula y el Llanto de Dalson y destruye su tienda de mando.|n|nColoca el estandarte de la Plaga en el campamento y vuelve con el sumo ejecutor Derrington en El Baluarte en las Tierras de la Peste del Oeste.‡Se rendre au camp de base de la Croisade écarlate situé entre le Champ de Gangrepierre et les Larmes de Dalson et détruire leur tente d\'état-major.|n|nPlacer la bannière du Fléau sur le camp, puis revenir auprès du Grand exécuteur Derrington à la Barricade, dans les Maleterres de l\'ouest.‡到血色十字军建在费尔斯通农场和达尔松之泪之间的营地去，摧毁他们的指挥帐篷。|n|n将亡灵天灾的战旗插在营地中，然后回到西瘟疫之地亡灵壁垒的高级执行官德灵顿那儿。‡到血色十字軍建在費爾斯通農場和達爾松之淚之間的營地去，摧毀他們的指揮帳篷。|n|n將天譴軍團旌旗插在營地中，然後回到西瘟疫之地亡靈壁壘的高階執行官德靈頓那兒。',
  }
},
[5097] = {
  {
    'Você não vê as torres?‡Сторожевые башни‡Turm um Turm‡감시탑 공격 준비‡Todas las atalayas‡Todas las atalayas‡Tout au long des tours de guet‡标记哨塔‡標記哨塔',
    nil,
    'Usando a Tocha Sinalizadora, marque cada torre em Andorhal. Você tem que ficar na entrada da torre para conseguir marcá-la.|n|nDepois de marcar as quatro torres, leve a Tocha Sinalizadora de volta para o Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Отметьте все башни Андорала при помощи сигнального факела; задействовать факел следует, находясь в дверном проеме каждой из башен.|n|nОтметив все четыре башни, следует вернуть сигнальный факел командиру Ашламу Отважному Кулаку в лагерь Промозглого Ветра в Западных Чумных землях.‡Markiert mit der Signalfackel jeden Turm in Andorhal; Ihr müsst im Eingang jedes Turmes stehen, um ihn erfolgreich zu markieren.|n|nWenn alle vier Türme markiert sind, bringt Ihr die Signalfackel zu Kommandant Ashlam Ehrenschlag am Zugwindlager, westliche Pestländer, zurück.‡신호 횃불로 안돌할의 각 탑을 표시해야 합니다. 성공적으로 표시하려면 탑의 입구에 서야 합니다.|n|n네 개의 감시탑에 모두 표시했으면 신호 횃불을 서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 가져가십시오.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.|n|nCuando estén marcadas las cuatro atalayas devuelve la antorcha de aviso al comandante Ashlam Puñovalor del Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.|n|nCuando estén marcadas las cuatro atalayas devuelve la antorcha de aviso al comandante Ashlam Puñovalor del Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡À l\'aide de la Torche-balise, marquer chaque tour à Andorhal ; il faut se tenir dans l\'embrasure de la porte de la tour pour pouvoir la marquer.|n|nQuand les quatre tours seront marquées, rapporter la Torche-balise au commandant Ashlam Vaillepoing au camp du Noroît, dans les Maleterres de l\'ouest.‡使用信号火炬为安多哈尔城中的四座哨塔做上标记，你必须站在哨塔门口才能成功地进行标记。|n|n在做完了标记之后，将信号火炬还给西瘟疫之地冰风岗的指挥官阿什拉姆·瓦罗菲斯特。‡使用信號火炬為安多哈爾城中的四座哨塔做上標記，你必須站在哨塔門口才能成功地進行標記。|n|n在做完了標記之後，將信號火炬還給西瘟疫之地冰風營地的指揮官阿胥拉姆·瓦羅菲斯特。',
  }
},
[5098] = {
  {
    'Você não vê as torres?‡Сторожевые башни‡Turm um Turm‡감시탑 공격 준비‡Todas las atalayas‡Todas las atalayas‡Tout au long des tours de guet‡标记哨塔‡標記哨塔',
    nil,
    'Usando a Tocha Sinalizadora, marque cada torre em Andorhal. Você tem que ficar na entrada da torre para conseguir marcá-la.|n|nDepois de marcar as quatro torres, leve a Tocha Sinalizadora de volta para o Alto-executor Arcabuz no Baluarte, nas Terras Pestilentas Ocidentais.‡Отметьте все башни Андорала при помощи сигнального факела; задействовать факел следует, находясь в дверном проеме каждой из башен.|n|nОтметив все четыре башни, следует вернуть сигнальный факел верховному палачу Деррингтону в Бастион в Западных Чумных землях.‡Markiert mit der Signalfackel jeden Turm in Andorhal; Ihr müsst im Eingang jedes Turmes stehen, um ihn erfolgreich zu markieren.|n|nWenn alle vier Türme markiert sind, bringt Ihr die Signalfackel zu Hochexekutor Derrington am Bollwerk in den Westlichen Pestländern, zurück.‡신호 횃불로 안돌할의 각 탑을 표시해야 합니다. 성공적으로 표시하려면 탑의 입구에 서야 합니다.|n|n네 개의 감시탑에 모두 표시했으면 신호 횃불을 서부 역병지대의 보루에 있는 고위집행관 데링턴에게 가져가야 합니다.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.|n|nCuando estén marcadas las cuatro atalayas, devuelve la antorcha de aviso al sumo ejecutor Derrington en El Baluarte, en las Tierras de la Peste del Oeste.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.|n|nCuando estén marcadas las cuatro atalayas, devuelve la antorcha de aviso al sumo ejecutor Derrington en El Baluarte, en las Tierras de la Peste del Oeste.‡À l\'aide de la Torche-balise, marquer chaque tour à Andorhal ; il faut se tenir dans l\'embrasure de la porte de la tour pour pouvoir la marquer.|n|nQuand les quatre tours seront marquées, rapporter la Torche-balise au Grand exécuteur Derrington à la Barricade, dans les Maleterres de l\'ouest.‡使用信号火炬为安多哈尔城中的四座哨塔做上标记，你必须站在哨塔门口才能成功地进行标记。|n|n在做完了标记之后，将信号火炬还给西瘟疫之地亡灵壁垒的高级执行官德灵顿。‡使用信號火炬為安多哈爾城中的四座哨塔做上標記，你必須站在哨塔門口才能成功地進行標記。|n|n在做完了標記之後，將信號火炬還給西瘟疫之地亡靈壁壘的高階執行官德靈頓。',
  }
},
[5101] = {
  {
    'Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Misión de prueba suprema de Lee... ¡apocalíptica!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!',
    nil,
    'Mate 6 ovelhas para o Dito e depois corra pela sua vida!|n|nTá... brincadeirinha... basta matar as ovelhas.‡Убейте 6 овец для Бенни и бегите со всех ног!|n|n|n|n|nНасчет ног я пошутил.‡Tötet 6 Schafe für Benny... und dann nehmt die Beine in die Hand und rennt, was das Zeug hält!|n|n|n|n|nWar nur \'n Scherz... was das Rennen angeht.‡베니에게 가져갈 양 6마리를 잡은 다음 눈썹이 휘날리게 달려가십시오!|n|n|n|n|n\'휘날리게\'는 농담이고... 양을 다 잡은 다음 베니에게 가면 됩니다.‡Mata 6 ovejas para Benny ¡y corre como el demonio!|n|n|n|n|nEs una broma... lo de correr como un demonio.‡Mata 6 ovejas para Benny ¡y corre como el demonio!|n|n|n|n|nEs una broma... lo de correr como un demonio.‡Tuez 6 moutons pour Benny puis prenez vos jambes à votre cou !|n|n|n|n|nNon, c’est une blague… pas besoin de courir.‡为贝尼消灭6只绵羊，随后乱跑！|n|n|n|n|n开玩笑的……跑的那部分不用。‡幫本尼殺死六隻羊然後趕快瘋狂地跑開!|n|n|n|n|n跑開的部分是開玩笑的。',
  }
},
[5102] = {
  {
    'O fim do General Drakkisath‡Кончина генерала Драккисата‡General Drakkisaths Niedergang‡사령관 드라키사스 처치‡Muerte al general Drakkisath‡Muerte al general Drakkisath‡La reddition du général Drakkisath‡达基萨斯将军之死‡達基薩斯將軍之死',
    nil,
    'Travel to Blackrock Spire and slay General Drakkisath.‡Отправьтесь на Пик Черной горы и устраните генерала Драккисата.‡Begebt Euch zur Schwarzfelsspitze und schaltet General Drakkisath aus.‡검은바위 첨탑으로 가서 사령관 드라키사스를 처치해야 합니다.‡Viaja hasta la Cumbre de Roca Negra y mata al general Drakkisath.‡Viaja hasta la Cumbre de Roca Negra y mata al general Drakkisath.‡Rendez-vous au Pic Rochenoire et tuez le général Drakkisath.‡到黑石塔去杀掉达基萨斯将军。‡去黑石塔殺掉達基薩斯將軍。',
  }
},
[5103] = {
  {
    'Morte muito ardente‡Смерть в огне‡Heißer, feuriger Tod‡뜨거운 화형‡Muerte abrasadora‡Muerte abrasadora‡Mort brûlante‡火热的死亡‡火熱的死亡',
    nil,
    'Alguém neste mundo deve saber o fazer com essas manoplas. Boa sorte!‡Наверняка в этом мире есть кто-то, кто знает, что делать с этими рукавицами.‡Jemand auf dieser Welt muss doch wissen, was mit diesen Stulpen zu tun ist. Viel Glück!‡아제로스 어딘가에 누군가가 이 건틀릿으로 뭘 해야 하는지 알고 있을 겁니다. 행운을 빕니다!‡Alguien en este mundo debe de saber qué hacer con estos guanteletes. ¡Suerte!‡Alguien en este mundo debe de saber qué hacer con estos guanteletes. ¡Suerte!‡Quelqu\'un dans ce monde doit bien savoir à quoi servent ces gantelets. Bonne chance !‡世界上一定有人知道关于这副手套的事情，祝你好运！‡世界上一定有人知道關於這副護手的事情，祝你好運!',
  }
},
[5121] = {
  {
    '[DEPRECATED]High Chief Winterfall‡Верховный вождь племени Зимней Спячки‡Oberhäuptling der Winterfelle‡대족장 겨울눈‡[DEPRECATED]Gran Jefe Nevada‡[DEPRECATED]Gran Jefe Nevada‡[PÉRIMÉ]Le grand chef tombe-hiver‡冬泉酋长‡[DEPRECATED]High Chief Winterfall',
    nil,
    'Bruna Covaneve em Hibérnia quer que você derrote o Chefe Supremo Invernoso.‡По просьбе Доновы Снегоноры из Зимних Ключей убейте верховного вождя племени Зимней Спячки.‡Donova Schneeweh in Winterquell möchte, dass Ihr den Oberhäuptling der Winterfelle besiegt.‡여명의 설원에 있는 도노바 스노우덴이 대족장 겨울눈을 처치해 달라고 했습니다.‡Donova Cubilnevado de Cuna del Invierno quiere que derrotes al Gran Jefe Nevada.‡Donova Cubilnevado de Cuna del Invierno quiere que derrotes al Gran Jefe Nevada.‡Donova Antreneige du Berceau-de-l\'Hiver veut que vous triomphiez du Grand chef tombe-hiver.‡冬泉谷的多诺瓦·雪山要你去击败冬泉酋长。‡冬泉谷的多諾瓦·雪山要你去擊敗冬泉酋長。',
  }
},
[5122] = {
  {
    '‡Медальон веры‡Das Medaillon des Glaubens‡신념의 메달‡El medallón de Fe‡El medallón de Fe‡Le médaillon de foi‡信仰奖章‡',
    nil,
    nil,
  }
},
[5123] = {
  {
    '[DEPRECATED]The Final Piece‡Последний фрагмент мозаики‡Das letzte Stück‡마지막 단서‡[DEPRECATED]La pieza final‡[DEPRECATED]La pieza final‡[PÉRIMÉ]Le dernier morceau‡最后一片‡[DEPRECATED]The Final Piece',
    nil,
    'Leve o Registro Escrito Grosseiramente para Bruna Covaneve em Hibérnia.‡Отнесите неразборчиво исписанный журнал Донове Снегоноре в Зимние Ключи.‡Bringt das kunstlos geschriebene Logbuch zu Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 휘갈겨 쓴 일지를 가져가야 합니다.‡Lleva el diario mal escrito a Donova Cubilnevado de Cuna del Invierno.‡Lleva el diario mal escrito a Donova Cubilnevado de Cuna del Invierno.‡Apportez le Journal mal écrit à Donova Antreneige au Berceau-de-l\'Hiver.‡把潦草的日志交给冬泉谷的多诺瓦-雪山。‡把字跡潦草的日誌帶去給冬泉谷的多諾瓦·雪山。',
  }
},
[5124] = {
  {
    'Manoplas de placa abrasadoras‡Огненные латные рукавицы‡Feurige Plattenstulpen‡불꽃의 판금 건틀릿‡Guanteletes de placas ígneas‡Guanteletes de placas ígneas‡Gantelets en plaques de feu‡炽热板甲护手‡熾熱鎧甲護手',
    nil,
    'Leve 6 Barras de Tório Encantado, 2 Essências do Fogo e 4 Rubis-estrela para Málifus Trevamalho. Você também vai ter que entregar suas Manoplas de Placa Crua.‡Принесите Малифою Черномолоту 6 зачарованных ториевых слитков, 2 сущности огня и 4 звездных рубина. Вам также нужно будет расстаться с неопалимыми латными рукавицами.‡Bringt Malyfous Düsterhammer 6 verzauberte Thoriumbarren, 2 Essenzen des Feuers und 4 Sternrubine. Ihr müsst außerdem Eure ungebrannten Plattenstulpen abgeben.‡마력 깃든 토륨 주괴 6개, 불의 정수 2개, 별루비 4개를 말리퍼스 다크해머에게 가져가야 합니다. 불타지 않은 판금 건틀릿도 가져가야 합니다.‡Lleva a Malyfous Martilloscuro 6 barras de torio encantado, 2 esencias de fuego y 4 rubíes estrellados. También tendrás que entregarle tus guanteletes de placas sin templar.‡Lleva a Malyfous Martilloscuro 6 barras de torio encantado, 2 esencias de fuego y 4 rubíes estrellados. También tendrás que entregarle tus guanteletes de placas sin templar.‡Apporter à Malyfous Sombremartel 6 Barres de thorium enchanté, 2 Essences de feu, et 4 Rubis étoilés. Lui remettre également vos Gantelets en plaques inachevés.‡将6块魔化瑟银锭、2份火焰精华和4颗红宝石交给玛雷弗斯·暗锤。另外你还得把未淬火的板甲护手也交给他。‡將6塊附魔瑟銀錠、2份火焰精華和4顆紅寶石交給瑪雷弗斯·暗錘。另外你還得把未淬火的鎧甲護手也交給他。',
  }
},
[5125] = {
  {
    '‡Слова Аурия‡Aurius\' Abrechnung‡아우리우스의 복수‡La estimación de Aurius‡La estimación de Aurius‡La rétribution d\'Aurius‡奥里克斯的清算‡',
    nil,
    nil,
  }
},
[5126] = {
  {
    '‡История Лоракса‡Lorax\' Geschichte‡‡La historia de Lorax‡La historia de Lorax‡L\'histoire de Lorax‡罗拉克斯的故事‡',
    nil,
    '‡Поговорите с Лораксом. Выслушайте то, что он вам расскажет.‡Sprecht mit Lorax. Hört, was er zu sagen hat.‡‡Habla con Lorax. Escucha todo lo que tiene que decirte.|n‡Habla con Lorax. Escucha todo lo que tiene que decirte.|n‡Parler à Lorax. Écouter ce qu\'il a à dire.‡与罗拉克斯谈一谈，听听他要说什么。‡',
  }
},
[5127] = {
  {
    'A forja demoníaca‡Демонова кузня‡Die Dämonenschmiede‡악마의 룬‡La forja demoníaca‡La forja demoníaca‡La forge démoniaque‡恶魔熔炉‡惡魔熔爐',
    nil,
    'Viaje para o Pico da Rocha Negra e encontre Goraluk Rachadastra. Mate-o e use o Pique Manchado de Sangue no cadáver dele. Quando a alma dele tiver sido canalizada, o pique ficará Manchado de Almas.|n|nVocê também precisa encontrar o Peitoral Rúnico de Metal Bruto.|n|nLeve o Pique Manchado de Almas e o Peitoral Rúnico de Metal Bruto para Vegax, em Hibérnia.‡Отправляйтесь на пик Черной горы и найдите Горалука Разбитую Наковальню. Убейте его, а потом воткните в труп окровавленную пику. Таким образом пика вытянет его душу и окрасится ей.|n|nКроме того, вам нужно найти заготовку рунической кирасы.|n|nОтнесите пику и кирасу Лораксу в Зимних Ключах.‡Begebt Euch zur Schwarzfelsspitze und sucht Goraluk Hammerbruch. Erschlagt ihn und wendet dann die blutbefleckte Pike auf seine Leiche an. Nachdem seine Seele abgesaugt wurde, wird die Pike seelenbefleckt sein.|n|nIhr müsst außerdem die ungeschmiedete runenbedeckte Brustplatte finden.|n|nBringt die seelenbefleckte Pike und die ungeschmiedete runenbedeckte Brustplate zu Lorax in Winterquell.‡검은바위 첨탑으로 가서 고랄루크 앤빌크랙을 찾아 처치한 후, 핏물이 깃든 창을 그의 심장에 꽂아야 합니다. 창이 그의 영혼을 흡수하면 영혼이 깃든 창으로 변합니다.|n|n벼리지 않은 룬문자 가슴보호갑도 찾아야 합니다.|n|n영혼이 깃든 창과 벼리지 않은 룬문자 가슴보호갑을 여명의 설원에 있는 로락스에게 가져가야 합니다.‡Viaja a la Cumbre de Roca Negra y encuentra a Goraluk Yunquegrieta. Mátale y utiliza el Pica manchada de sangre sobre su cadáver. Cuando hayas absorbido su alma, la pica estará manchada de alma.|n|nTambién debes encontrar la coraza cubierta de runas sin forjar.|n|nLleva la pica manchada de alma y la coraza cubierta de runas sin forjar a Lorax en Cuna del Invierno.‡Viaja a la Cumbre de Roca Negra y encuentra a Goraluk Yunquegrieta. Mátale y utiliza el Pica manchada de sangre sobre su cadáver. Cuando hayas absorbido su alma, la pica estará manchada de alma.|n|nTambién debes encontrar la coraza cubierta de runas sin forjar.|n|nLleva la pica manchada de alma y la coraza cubierta de runas sin forjar a Lorax en Cuna del Invierno.‡Se rendre au pic Rochenoire et trouver Goraluk Brisenclume. Le tuer puis utiliser la Pique tachée de sang sur son cadavre. Après avoir siphonné son âme, la pique sera devenue Tachée d\'âme.|n|nTrouver aussi la Cuirasse couverte de runes inachevée.|n|nRapporter la Pique tachée d\'âme et la Cuirasse couverte de runes inachevée à Lorax au Berceau-de-l\'Hiver.‡到黑石塔去找到古拉鲁克。杀死他，然后用血污长矛刺入他的尸体。当他的灵魂被吸干后，这支矛就会成为穿魂长矛。|n|n你还必须找到未铸造的符文覆饰胸甲。|n|n将穿魂长矛和未铸造的符文覆饰胸甲都交给冬泉谷的罗拉克斯。‡到黑石塔去找到古拉魯克。殺死他，然後用血染長矛刺入他的屍體。當他的靈魂被吸幹後，這支矛就會成為穿魂長矛。|n|n你還必須找到未鑄造的符文覆飾胸甲。|n|n將穿魂長矛和未鑄造的符文覆飾胸甲都交給冬泉谷的羅拉克斯。',
  }
},
[5128] = {
  {
    '‡‡Worte des Oberhäuptlings‡‡[DEPRECATED]Las palabras del Gran Jefe‡‡[PÉRIMÉ]Paroles du Grand Chef‡熊怪酋长的话‡',
    nil,
    '‡‡Bringt das kunstlos geschriebene Logbuch zu Kelek Himmelshüter im südlichen Teil des Teufelswalds.‡‡Lleva el registro escrito de forma rudimentaria a Kelek Guardacielo en el sur de Frondavil.‡‡Rapporter le Journal mal écrit à Kelek Gardeciel dans le sud de Gangrebois.‡将潦草的日志交给费伍德森林南部的科雷克-望天。‡',
  }
},
[5141] = {
  {
    '‡Кожевничество: чешуя дракона‡Drachenlederverarbeitung‡‡Peletería dragontina‡Peletería dragontina‡Travail du cuir de dragon‡龙鳞制皮‡',
    nil,
    '‡Принесите 2 жесткие кирасы скорпида, 2 пары жестких перчаток скорпида и 10 потертых чешуек дракона Питеру Галену в Азшару. |n|nПо выполнении этого задания вы получите возможность обучения кожевничеству школы Дракона. |n|nЕсли вы выполните это задание, вы не сможете изучать кожевничество школы традиций предков и школы силы стихий.‡Bringt 2 feste Skorpidbrustplatten, 2 feste Skorpidhandschuhe und 10 Drachenschuppen zu Peter Galen in Azshara.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Drachenlederverarbeitung erhalten.|n|nIhr könnt dann allerdings weder Elementarlederverarbeitung noch Stammeslederverarbeitung erlernen; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡‡Consigue 2 corazas de escórpido resistentes, 2 guantes de escórpido resistentes, y 10 dragontinas desgastadas para Peter Galen, en Azshara.|n|nSi completas esta misión tendrás acceso al arte de la peletería dragontina.|n|nSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Consigue 2 corazas de escórpido resistentes, 2 guantes de escórpido resistentes, y 10 dragontinas desgastadas para Peter Galen, en Azshara.|n|nSi completas esta misión tendrás acceso al arte de la peletería dragontina.|n|nSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Apporter 2 Cuirasses armées du scorpide, 2 Gants armés du scorpide et 10 Ecailles de dragon usées à Peter Galen, en Azshara.|n|nTerminer cette quête vous donnera accès aux arts du travail du cuir en écailles de dragon.|n|nTerminer cette quête avec succès vous interdira l\'apprentissage du travail du cuir élémentaire et du travail du cuir tribal. Prenez le temps de réfléchir à la voie que vous souhaitez emprunter, avant de prendre une décision.‡将2套硬化蝎壳胸甲、2套硬化蝎壳手套和10片龙鳞交给艾萨拉的彼得·加林。|n|n完成这项任务之后，你就可以学到龙鳞制皮技术了。|n|n同时，你也将永远无法学习元素制皮技术和部族制皮技术，在决定之前先考虑清楚。‡',
  }
},
[5142] = {
  {
    'A pequena Pâmela‡Малышка Памела‡Klein-Pamela‡꼬마 파멜라‡La pequeña Pamela‡La pequeña Pamela‡La petite Pamela‡小帕米拉‡小帕米拉',
    nil,
    'Find Pamela Redpath in Darrowshire.‡Найдите Памелу Редпат в Дарроушире.‡Sucht in Darroheim nach Pamela Rotpfad.‡다로우골에 있는 파멜라 레드패스를 찾아야 합니다.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Retrouver Pamela Senterouge à Comté-de-Darrow.‡在达隆郡找到帕米拉·雷德帕斯。‡到達隆郡找尋帕米拉·雷德帕斯。',
  }
},
[5143] = {
  {
    '‡Кожевничество: традиции предков‡Stammeslederverarbeitung‡‡Peletería tribal‡Peletería tribal‡Travail du cuir tribal‡部族制皮‡',
    nil,
    '‡Принесите дикарский кожаный жилет и дикарский кожаный шлем Кариссии Лунной Охотнице из Фераласа.|n|nВыполнив это задание, вы станете кожевником школы традиций предков.|n|nТакже вы лишитесь возможности изучать кожевничество школы Дракона и школы силы стихий; убедитесь, что избрали именно верный путь, прежде чем выполнять задание.‡Bringt eine Wildlederweste und einen Wildlederhelm zu Caryssia Jägermond in Feralas.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Stammeslederverarbeitung erhalten.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Elementarlederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡‡Lleva 1 jubón de cuero salvaje y 1 casco de cuero salvaje a Caryssia Cazaluna a Feralas.|n|nSi completas esta misión, tendrás acceso a las artes de Peletería tribal.|n|nSi lo haces, no podrás aprender peletería dragontina ni peletería elemental; asegúrate de que este es el camino que deseas seguir antes de completar la misión.‡Lleva 1 jubón de cuero salvaje y 1 casco de cuero salvaje a Caryssia Cazaluna a Feralas.|n|nSi completas esta misión, tendrás acceso a las artes de Peletería tribal.|n|nSi lo haces, no podrás aprender peletería dragontina ni peletería elemental; asegúrate de que este es el camino que deseas seguir antes de completar la misión.‡Apporter un Gilet en cuir fauve et un Casque en cuir fauve à Caryssia Chasselune en Féralas.|n|nL\'accomplissement de cette quête donne accès aux arts du travail du cuir tribal.|n|nL\'accomplissement de cette quête vous empêchera d\'apprendre le travail du cuir de dragon et le travail du cuir élémentaire ; il faut être sûr du chemin que l\'on veut suivre avant de faire ce choix.‡将1件蛮皮外衣和1件蛮皮头盔交给菲拉斯的凯雷希亚·猎月。|n|n完成这项任务之后，你就可以学到部族制皮技术了。|n|n同时，你也将永远无法学习元素制皮技术和龙鳞制皮技术，在决定之前先考虑清楚。‡',
  }
},
[5144] = {
  {
    '‡Кожевничество: сила стихий‡Elementarlederverarbeitung‡‡Peletería elemental‡Peletería elemental‡Travail du cuir élémentaire‡元素制皮‡',
    nil,
    '‡Принесите Саре Дубильщице 2 сердца огня, 2 сферы воды, 2 ядра земли и 2 дыхания ветра. |n|nВыполнение этого задания позволит вам изучать кожевничество школы силы стихий. |n|nКроме того, вы откажетесь от изучения кожевничества школ чешуи дракона и традиций предков. Нужно быть уверенным, что выбрана верная школа, прежде чем выполнять задание.‡Bringt 2 Herzen des Feuers, 2 Kugeln des Wassers, 2 Erdenkerne und 2 Odem des Windes zu Sarah Gerber in die Sengende Schlucht.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Elementarlederverarbeitung erhalten.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Stammeslederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡‡Lleva 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Sarah Peletero a La Garganta de Fuego. |n|nAl completar esta tarea aprenderás peletería elemental. |n|nSi te dedicas a este arte, no podrás aprender peletería dragontina ni peletería tribal; piénsatelo bien antes de decidirte.‡Lleva 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Sarah Peletero a La Garganta de Fuego. |n|nAl completar esta tarea aprenderás peletería elemental. |n|nSi te dedicas a este arte, no podrás aprender peletería dragontina ni peletería tribal; piénsatelo bien antes de decidirte.‡Apporter 2 Cœurs de feu, 2 Globes d\'eau, 2 Noyaux de terre, et 2 Souffles de vent à Sarah Tanner dans la Gorge des Vents brûlants.|n|nL\'accomplissement de cette quête donne accès aux arts du Travail du cuir élémentaire.|n|nL\'accomplissement de cette quête vous empêchera d\'apprendre le Travail du cuir de dragon et le Travail du cuir tribal ; il faut être sûr du chemin que l\'on veut suivre avant de faire ce choix.‡将2个火焰之心、2个纯水之球、2个大地之核和2个风之气息交给灼热峡谷的萨拉·坦尼。|n|n一旦你完成这项任务，就可以开始学习元素制皮技艺了。|n|n同时，你也就无法再学习龙鳞制皮和部落制皮了，在你决定之前要考虑清楚。‡',
  }
},
[5145] = {
  {
    '‡Кожевничество: чешуя дракона‡Drachenlederverarbeitung‡‡Peletería dragontina‡Peletería dragontina‡Travail du cuir de dragon‡龙鳞制皮‡',
    nil,
    '‡Принесите 2 жесткие кирасы скорпида, 2 пары жестких перчаток скорпида и 10 потертых чешуек дракона Торкафу Оку Дракона в Бесплодные земли. |n|nПо выполнении этого задания вы получите возможность обучения кожевничеству школы Дракона. |n|nЕсли вы выполните это задание, вы не сможете изучать кожевничество школы традиций предков и школы силы стихий.‡Bringt 2 feste Skorpidbrustplatten, 2 feste Skorpidhandschuhe und 10 Drachenschuppen zu Thorkaf Drachenaug im Ödland.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Drachenlederverarbeitung erhalten.|n|nIhr könnt dann allerdings weder Elementarlederverarbeitung noch Stammeslederverarbeitung erlernen; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡‡Consigue 2 corazas de escórpido resistentes, 2 guantes de escórpido resistentes, y 10 dragontinas desgastadas para Thorkaf Ojo de Dragón, en las Tierras Inhóspitas.|n|nSi completas esta misión tendrás acceso al arte de la peletería dragontina.|n|nSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Consigue 2 corazas de escórpido resistentes, 2 guantes de escórpido resistentes, y 10 dragontinas desgastadas para Thorkaf Ojo de Dragón, en las Tierras Inhóspitas.|n|nSi completas esta misión tendrás acceso al arte de la peletería dragontina.|n|nSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Apporter 2 Cuirasses armées du scorpide, 2 Gants armés du scorpide et 10 Ecailles de dragon usées à Thorkaf Oeil-de-dragon, dans les Terres ingrates.|n|nTerminer cette quête vous donnera accès aux arts du travail du cuir en écailles de dragon.|n|nTerminer cette quête avec succès vous interdira l\'apprentissage du travail du cuir élémentaire et du travail du cuir tribal. Prenez le temps de réfléchir à la voie que vous souhaitez emprunter, avant de prendre une décision.‡将2套硬化蝎壳胸甲、2套硬化蝎壳手套和10片龙鳞交给荒芜之地的索卡夫·龙眼。|n|n完成这项任务之后，你就可以学到龙鳞制皮技术了。|n|n同时，你也将永远无法学习元素制皮技术和部族制皮技术，在决定之前先考虑清楚。‡',
  }
},
[5146] = {
  {
    '‡Кожевничество: сила стихий‡Elementarlederverarbeitung‡‡Peletería elemental‡Peletería elemental‡Travail du cuir élémentaire‡元素制皮‡',
    nil,
    '‡Принесите Брумну Заиндевевшему Копыту на нагорье Арати 2 сердца огня, 2 сферы воды, 2 ядра земли и 2 дыхания ветра. |n|nВыполнение этого задания позволит вам изучать кожевничество школы силы стихий. |n|nКроме того, вы откажетесь от изучения кожевничества школ чешуи дракона и традиций предков. Нужно быть уверенным, что выбрана верная школа, прежде чем выполнять задание.‡Bringt 2 Herzen des Feuers, 2 Kugeln des Wassers, 2 Erdenkerne und 2 Odem des Windes zu Brumn Winterhuf in den Arathibergen.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Elementarlederverarbeitung erhalten.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Stammeslederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡‡Llévale 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Brumm Pezuña Invernal en las Tierras Altas de Arathi.|n|nCuando completes esta misión tendrás acceso a las artes de peletería elemental.|n|nSi completas esta misión, no podrás aprender peletería dragontina ni peletería tribal; asegúrate de que este es el camino que deseas seguir antes de tomarlo.‡Llévale 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Brumm Pezuña Invernal en las Tierras Altas de Arathi.|n|nCuando completes esta misión tendrás acceso a las artes de peletería elemental.|n|nSi completas esta misión, no podrás aprender peletería dragontina ni peletería tribal; asegúrate de que este es el camino que deseas seguir antes de tomarlo.‡Apporter 2 Cœurs de feu, 2 Globes d\'eau, 2 Noyaux de terre, et 2 Souffles de vent à Brumn Sabot-d\'hiver dans les montagnes d\'Arathi.|n|nL\'accomplissement de cette quête donne accès aux arts du travail du cuir élémentaire.|n|nL\'accomplissement de cette quête vous empêchera d\'apprendre le travail du cuir de dragon et le travail du cuir tribal ; il faut être sûr du chemin que l\'on veut suivre avant de faire ce choix.‡将2个火焰之心、2个纯水之球、2个大地之核和2个风之气息交给阿拉希山脉的布鲁姆·白蹄。|n|n一旦你完成这项任务，就可以开始学习元素制皮技艺了。|n|n同时，你也就无法再学习龙鳞制皮和部落制皮了，在你决定之前要考虑清楚。‡',
  }
},
[5147] = {
  {
    'Procura-se: Arnak Temível Totem‡Разыскивается: Арнак Зловещий Тотем‡GESUCHT: Arnak Grimmtotem‡현상 수배 - 아르낙 그림토템‡Se busca: Arnak Tótem Siniestro‡Se busca: Arnak Tótem Siniestro‡On recherche : Arnak Totem-sinistre‡通缉：阿纳克-恐怖图腾‡通緝:阿納克·恐怖圖騰',
    nil,
    'Mate Arnak Temível Totem e leve uma prova de seu feito para o Vigia do Rochedo Chifre Longo, na Aldeia Vento Livre.‡Убейте Арнака Зловещего Тотема и принесите доказательство дозорному утесов Долгорогу на заставу Вольного Ветра.‡Erschlagt Arnak Grimmtotem und bringt den Beweis Eurer Tat zu Klippenbehüter Langhorn im Freiwindposten.‡아르낙 그림토템을 처치하고 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 그 증거물을 가져가야 합니다.‡Mata a Arnak Tótem Siniestro y llévale una prueba de tu hazaña al vigiarrisco Cuerno Largo, que está en el Poblado Viento Libre.‡Mata a Arnak Tótem Siniestro y llévale una prueba de tu hazaña al vigiarrisco Cuerno Largo, que está en el Poblado Viento Libre.‡Tuer Arnak Totem-sinistre et apporter une preuve de votre acte au garde-falaise Longue-corne au Poste de Librevent.‡杀死阿纳克·恐怖图腾，并向乱风岗的峭壁卫兵图林·长角出示证据。‡殺死阿納克·恐怖圖騰，並向亂風崗的峭壁看守者長角出示證據。',
  }
},
[5148] = {
  {
    '‡Кожевничество: традиции предков‡Stammeslederverarbeitung‡‡Peletería tribal‡Peletería tribal‡Travail du cuir tribal‡部族制皮‡',
    nil,
    '‡Принесите дикарский кожаный жилет и дикарский кожаный шлем Сех\'Джибу в Тернистой долине.|n|nВыполнив это задание, вы станете кожевником школы традиций предков.|n|nТакже вы лишитесь возможности изучать кожевничество школы Дракона и школы силы стихий; убедитесь, что избрали верный путь, прежде чем выполнять задание.‡Bringt eine Wildlederweste und einen Wildlederhelm zu Se\'Jib im Schlingendorntal.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Stammeslederverarbeitung erhalten.|n|nWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Elementarlederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡‡Lleva un jubón de cuero salvaje y un casco de cuero salvaje a Se\'Jib en la Vega de Tuercespina.|n|nCompletar esta misión te proporcionará acceso a las artes de la peletería tribal.|n|nCompletar esta misión evitará que aprendas peletería dragontina y peletería elemental. Asegúrate que este es el camino que quieres seguir antes de hacerlo.‡Lleva un jubón de cuero salvaje y un casco de cuero salvaje a Se\'Jib en la Vega de Tuercespina.|n|nCompletar esta misión te proporcionará acceso a las artes de la peletería tribal.|n|nCompletar esta misión evitará que aprendas peletería dragontina y peletería elemental. Asegúrate que este es el camino que quieres seguir antes de hacerlo.‡Apporter un Gilet en cuir fauve et un Casque en cuir fauve à Se\'Jib dans la vallée de Strangleronce.|n|nL\'accomplissement de cette quête donne accès aux arts du travail du cuir tribal.|n|nL\'accomplissement de cette quête vous empêchera d\'apprendre le travail du cuir de dragon et le travail du cuir élémentaire ; il faut être sûr du chemin que l\'on veut suivre avant de faire ce choix.‡将1件蛮皮外衣和1件蛮皮头盔交给荆棘谷的瑟伊布。|n|n完成这项任务之后，你就可以学到部族制皮技术了。|n|n同时，你也将永远无法学习元素制皮技术和龙鳞制皮技术，在决定之前先考虑清楚。‡',
  }
},
[5149] = {
  {
    'A boneca de Pâmela‡Кукла Памелы‡Pamelas Puppe‡파멜라의 인형‡La muñeca de Pamela‡La muñeca de Pamela‡La poupée de Pamela‡帕米拉的洋娃娃‡帕米拉的洋娃娃',
    nil,
    'Encontre a boneca de Pâmela.‡Найдите куклу Памелы.‡Sucht Pamelas Puppe.‡파멜라의 인형을 찾아야 합니다.‡Encuentra la muñeca de Pamela.‡Encuentra la muñeca de Pamela.‡Trouver la poupée de Pamela.‡找到帕米拉的洋娃娃。‡找到帕米拉的洋娃娃。',
  }
},
[5150] = {
  {
    '‡Даданга проголодалась!‡Dadanga ist hungrig!‡배고픈 다단가!‡¡Dadanga tiene hambre!‡¡Dadanga tiene hambre!‡Dadanga a faim !‡达丹加饿了！‡',
    nil,
    nil,
  }
},
[5151] = {
  {
    'Dispositivo hipercapacitador‡Механизм гипервместимости‡Hyperkondensator-Dingsda‡초전도 장치‡Hipercondensador‡Hipercondensador‡Hypercapaciteur bidulotron‡超适应齿轮‡超適應齒輪',
    nil,
    'Mate a fera e traga de volta o Dispositivo Hipercapacitador e a Chave da Jaula da Pantera para Vizlo Limpajunta.‡Убейте зверя и принесите механизм гипервместимости и ключ от клетки пантеры Визло Фингалету.‡Erschlagt die Bestie und bringt den Hyperkondensator sowie den Pantherkäfigschlüssel zu Wizlo Lagerputzer zurück.‡퓨마를 처치하고 초전도 장치와 퓨마 우리 열쇠를 위즐로 베어링샤이너에게 돌려줘야 합니다.‡Acaba con la bestia y trae de regreso el hipercapacitor y la llave de la jaula a Wizlo Rodabrillante.‡Acaba con la bestia y trae de regreso el hipercondensador y la llave de la jaula de pantera a Wizlo Rodabrillante.‡Tuer la bête et rapporter l\'Hypercapaciteur et la Clé de la cage de la panthère à Wizlo Braquecoquard.‡杀了那头野兽，把超适应齿轮和钥匙交给维兹罗。‡殺了那隻野獸並把超適應齒輪和豹籠鑰匙帶回來交給維茲羅·擦軸人。',
  }
},
[5152] = {
  {
    'Tia Marlene‡Тетушка Марлен‡Tante Marlene‡말레네 고모‡Tía Marlene‡Tía Marlene‡Tante Marlene‡玛莱恩姑妈‡瑪萊恩姑媽',
    nil,
    'Fale com Marlene, ao sul das Ruínas de Andorhal.‡Поговорите с Марлен в южной части руин Андорала.‡Sprecht mit Marlene, südlich der Ruinen von Andorhal.‡안돌할의 폐허 남쪽에서 말레네와 대화해야 합니다.‡Habla con Marlene. Está al sur de las Ruinas de Andorhal.‡Habla con Marlene. Está al sur de las Ruinas de Andorhal.‡Parler à Marlene, au sud des ruines d\'Andorhal.‡与安多哈尔废墟南边的玛莱恩谈一谈。‡與安多哈爾廢墟南邊的瑪萊恩談話。',
  }
},
[5153] = {
  {
    'Uma historiadora estranha‡Странный историк‡Ein seltsamer Historiker‡이상한 역사가‡Una extraña historiadora‡Una extraña historiadora‡Un étrange historien‡古怪的历史学家‡古怪的歷史學家',
    nil,
    'Leve o Anel de Casamento do Josefo para Crona.‡Принесите Хроми обручальное кольцо Джозефа.‡Bringt Josephs Ehering zu Chromie.‡조셉의 결혼반지를 크로미에게 가져가야 합니다.‡Lleva la alianza de Joseph a Cromi.‡Lleva la alianza de Joseph a Cromi.‡Apporter l\'Alliance de Joseph à Chromie.‡把约瑟夫的结婚戒指交给安多哈尔的克罗米。‡把約瑟夫的結婚戒指交給安多哈爾的克羅米。',
  }
},
[5154] = {
  {
    'Os Anais da Vila das Flechas‡Анналы Дарроушира‡Die Annalen von Darroheim‡다로우골 연대기‡Las Crónicas de Villa Darrow‡Las Crónicas de Villa Darrow‡Les annales de Comté-de-Darrow‡达隆郡的历史‡達隆郡的歷史',
    nil,
    'Leve os Anais da Vila das Flechas para Crona em Andorhal.‡Принесите Анналы Дарроушира Хроми в Андорал.‡Bringt die \'Annalen von Darroheim\' zu Chromie in Andorhal.‡안돌할에 있는 다로우골 연대기를 크로미에게 가져가야 합니다.‡Lleva el libro Crónicas de Villa Darrow a Cromi a Andorhal.‡Lleva el libro Crónicas de Villa Darrow a Cromi a Andorhal.‡Apportez les Annales de Comté-de-Darrow à Chromie, à Andorhal.‡把《达隆郡的历史》交给安多哈尔的克罗米。‡把《達隆郡的歷史》交給安多哈爾的克羅米。',
  }
},
[5155] = {
  {
    '[DEPRECATED]Forces of Jaedenar‡Силы Джеденара‡Streitmacht von Jaedenar‡제데나르의 힘‡[DEPRECATED]Las fuerzas de Jaedenar‡[DEPRECATED]Las fuerzas de Jaedenar‡[PÉRIMÉ]Les forces de Jaedenar‡加德纳尔的势力‡[DEPRECATED]Forces of Jaedenar',
    nil,
    'Entre em Jaedenar e mate 4 Cães de Jaedenar, 4 Guardas de Jaedenar, 6 Adeptos de Jaedenar e 6 Sectários de Jaedenar. Depois, fale novamente com Greta Musgo no Casco, na Selva Maleva.‡Отправляйтесь в Джеденар и убейте 4 джеденарских гончих, 4 джеденарских стражей, 6 джеденарских адептов и 6 джеденарских сектантов, затем возвращайтесь к Грете Замшелое Копыто в Оскверненный лес.‡Betretet Jaedenar und erschlagt 4 Hunde von Jaedenar, 4 Gardisten von Jaedenar, 6 Adepten von Jaedenar und 6 Kultisten von Jaedenar, bevor Ihr zu Greta Mooshuf im Teufelswald zurückkehrt.‡제데나르에 가서 제데나르 사냥개 4마리, 제데나르 수호병 4명, 제데나르 숙련마술사 6명, 자제데나르 이교도 6명을 처치하고 그레타 모스후프에게 가야 합니다.‡Entra en Jaedenar y mata a 4 canes Jaedenar, 4 guardianes Jaedenar, 6 adeptos Jaedenar y 6 cultores Jaedenar antes de volver con Greta Pezuñamusgo a Frondavil.‡Entra en Jaedenar y mata a 4 canes Jaedenar, 4 guardianes Jaedenar, 6 adeptos Jaedenar y 6 cultores Jaedenar antes de volver con Greta Pezuñamusgo a Frondavil.‡Entrer dans Jaedenar et tuer 4 Molosses de Jaedenar, 4 Gardiens de Jaedenar, 6 Adeptes de Jaedenar, et 6 Sectateurs de Jaedenar avant de retourner auprès de Greta Sabot-de-mousse dans Gangrebois.‡到加德纳尔去杀掉4个加德纳尔恶犬、4个加德纳尔守护者、6个加德纳尔精兵和6个加德纳尔祭司，然后向费伍德森林的格雷塔·苔蹄复命。‡到加德納爾去殺掉4個加德納爾惡犬、4個加德納爾守護者、6個加德納爾精兵和6個加德納爾祭司，然後向費伍德森林的格雷塔·苔蹄覆命。',
  }
},
[5156] = {
  {
    '[DEPRECATED]Verifying the Corruption‡Проверка на порчу‡Die Verderbnis überprüfen‡오염 확인‡[DEPRECATED]Investigación acerca de la corrupción‡[DEPRECATED]Investigación acerca de la corrupción‡[PÉRIMÉ]Enquête sur la corruption‡验证腐蚀‡[DEPRECATED]Verifying the Corruption',
    nil,
    'Procure e destrua 2 Feras Entrópicas e 2 Horrores Entrópicos enquanto explora o Vale das Escaras Pungentes. Depois de ver se as crateras ainda estão cheias de água contaminada com vileza, fale novamente com Taronn Pena Vermelha, na Selva Maleva.‡Найдите и уничтожьте 2 энтропических зверей и 2 энтропических ужасов при обследовании долины Рваных Ран. После проверьте, по-прежнему ли заполнены кратеры оскверненной водой. Затем возвращайтесь к Таруну Красному Перу в Оскверненный лес.‡Sucht und zerstört 2 entropische Bestien und 2 entropische Schrecken, während Ihr den Narbengrund erforscht. Nachdem Ihr überprüft habt, ob die Krater immer noch mit verderbtem Wasser gefüllt sind, kehrt zu Taronn Rotfeder im Teufelswald zurück.‡불벼락 골짜기를 탐색하는 동안 혼돈의 불길 2마리와 혼돈의 소산물 2마리를 처치해야 합니다. 분화구를 조사해 아직도 부패한 물이 남아 있는지 확인하고 악령숲의 타론 레드페더에게 가야 합니다.‡Busca y destruye a 2 bestias entrópicas y 2 horrores entrópicos a la vez que exploras la Cañada Gran Cicatriz. Cuando hayas comprobado si los cráteres del lugar aún contienen agua vil corrupta, vuelve con Taronn Plumarroja a Frondavil.‡Busca y destruye a 2 bestias entrópicas y 2 horrores entrópicos a la vez que exploras la Cañada Gran Cicatriz. Cuando hayas comprobado si los cráteres del lugar aún contienen agua vil corrupta, vuelve con Taronn Plumarroja a Frondavil.‡Trouver et détruire 2 Bêtes d\'entropie et 2 Horreurs d\'entropie tout en explorant le Val Grêlé. Après avoir vérifié que les cratères à cet endroit sont toujours remplis d\'eau corrompue, retourner auprès de Taronn Plume-rouge dans Gangrebois.‡杀掉2个热能野兽和2个热能恐兽，并探索碎痕谷。然后查看凹坑中是否仍然充满了堕落的恶臭之水，完成这些任务之后，向费伍德森林中的塔诺恩·红羽复命。‡殺掉2個熱能野獸和2個熱能恐獸，並探索碎痕谷。然後查看凹坑中是否仍然充滿了墮落的惡臭之水，完成這些任務之後，向費伍德森林中的塔諾恩·紅羽覆命。',
  }
},
[5157] = {
  {
    '[DEPRECATED]Collection of the Corrupt Water‡Собрать оскверненную воду‡Verderbtes Wasser sammeln‡부패한 물 채취‡[DEPRECATED]Una muestra de agua corrupta‡[DEPRECATED]Una muestra de agua corrupta‡[PÉRIMÉ]Recueillir de l\'eau souillée‡收集堕落之水‡[DEPRECATED]Collection of the Corrupt Water',
    nil,
    'Leve o Cantil Vazio para o Poço Lunar no meio de Jaedenar e encha-o. Depois, fale novamente com Greta Musgo no Casco na Selva Maleva.‡Возьмите пустую флягу и наполните ее водой из лунного колодца, что находится в центре Джеденара. Возвращайтесь к Грете Замшелое Копыто в Оскверненный лес.‡Bringt die leere Feldflasche zum Mondbrunnen im Zentrum von Jaedenar und füllt sie, bevor Ihr zu Greta Mooshuf im Teufelswald zurückkehrt.‡빈 수통을 제데나르 중심부의 달샘으로 가져가서 채운 다음 악령숲에 있는 그레타 모스후프에게 가져가야 합니다.‡Lleva la cantimplora vacía a la Poza de la Luna que hay en el centro de Jaedenar y llénala antes de volver con Greta Pezuñamusgo a Frondavil.‡Lleva la cantimplora vacía a la Poza de la Luna que hay en el centro de Jaedenar y llénala antes de volver con Greta Pezuñamusgo a Frondavil.‡Amener la Gourde vide au Puits de lune au centre de Jaedenar et la remplir avant de retourner voir Greta Sabot-de-mousse dans Gangrebois.‡把空壶拿到加德纳尔中心的月亮井去，装满井水之后再回到费伍德森林的格雷塔·苔蹄那里。‡把空壺拿到加德納爾中心的月井去，裝滿井水之後再回到費伍德森林的格雷塔·苔蹄那裡。',
  }
},
[5158] = {
  {
    '[DEPRECATED]Seeking Spiritual Aid‡В поисках духовной помощи‡Spirituelle Hilfe suchen‡영혼의 도움을 찾아서‡[DEPRECATED]Buscando ayuda espiritual‡[DEPRECATED]Buscando ayuda espiritual‡[PÉRIMÉ]À la recherche de soutien spirituel‡水之魂的帮助‡[DEPRECATED]Seeking Spiritual Aid',
    nil,
    'Leve a Água Corrompida do Poço Lunar para Islen Vidente da Água, nos Sertões.‡Отнесите порченую воду из Лунного колодца Ислене Заклинательнице Воды в Степи.‡Bringt das verderbte Mondbrunnenwasser in das Brachland zu Islen Wasserdeuter.‡부패한 달샘 물을 불모의 땅에 있는 이슬렌 워터시어에게 가져가야 합니다.‡Lleva el agua de la Poza de la Luna corrupta a Islen Vidente del Agua a Los Baldíos.‡Lleva el agua de la Poza de la Luna corrupta a Islen Vidente del Agua a Los Baldíos.‡Apporter l\'Eau de Puits de lune corrompue à Islen Oeil-des-rivières dans les Tarides.‡把腐化的月亮井水交给贫瘠之地的水之先知伊斯伦。‡把腐化的月井水交給貧瘠之地的水之先知伊斯倫。',
  }
},
[5159] = {
  {
    '[DEPRECATED]Cleansed Water Returns to Felwood‡Чистая вода возвращается в Оскверненный лес‡Gesäubertes Wasser wird zum Teufelswald gebracht‡[재사용]악령숲으로 정화된 물 가져가기‡[DEPRECATED]El agua purificada vuelve a Frondavil‡[DEPRECATED]El agua purificada vuelve a Frondavil‡[PÉRIMÉ]L\'eau purifiée retourne à Gangrebois‡净化过的水‡[DEPRECATED]Cleansed Water Returns to Felwood',
    nil,
    'Leve a Água Purificada do Poço Lunar para Greta Musgo no Casco, na Selva Maleva.‡Отнесите очищенную воду из лунного колодца Грете Замшелое Копыто в Оскверненный лес.‡Bringt das geläuterte Mondbrunnenwasser zu Greta Mooshuf im Teufelswald.‡정화된 달샘 물을 악령숲에 있는 그레타 모스후프에게 가져가야 합니다.‡Lleva el agua de la Poza de la Luna purificada a Greta Pezuñamusgo en Frondavil.‡Lleva el agua de la Poza de la Luna purificada a Greta Pezuñamusgo en Frondavil.‡Apporter l\'Eau de Puits de lune purifiée à Greta Sabot-de-mousse dans Gangrebois.‡把净化过的月亮井水交给费伍德森林的格雷塔·苔蹄。‡把淨化過的月井水交給費伍德森林的格雷塔·苔蹄。',
  }
},
[5160] = {
  {
    'A protetorada-máter‡Матрона-защитница‡Die oberste Beschützerin‡대섭정‡El Protectorado de la matrona‡El Protectorado de la matrona‡Le Protectorat de la matrone‡监护者‡監護者',
    nil,
    'Viaje para Hibérnia e encontre Haleh. Entregue para ela a Escama do Albi.‡Дойдите до Зимних Ключей и найдите Хале. Отдайте ей пластину чешуи Ауби.‡Begebt Euch nach Winterquell und sucht Haleh. Gebt ihr Awbees Schuppe.‡여명의 설원으로 가서 헬레를 찾아 아우비의 비늘을 전해야 합니다.‡Viaja hasta la Cuna del Invierno y encuentra a Haleh. Dale la escama de Awbee.‡Viaja hasta la Cuna del Invierno y encuentra a Haleh. Dale la escama de Awbee.‡Aller jusqu\'au Berceau-de-l\'Hiver et trouver Haleh. Lui donner l\'Ecaille d\'Awbee.‡到冬泉谷去找到哈尔琳，把奥比的鳞片交给她。‡到冬泉谷去找到哈爾琳，把奧比的鱗片交給她。',
  }
},
[5161] = {
  {
    '‡Гнев синих драконов‡Der Zorn des blauen Drachenschwarms‡‡La cólera del Vuelo Azul‡La cólera del Vuelo Azul‡La colère du vol bleu‡蓝龙之怒‡',
    nil,
    '‡Если у вас есть желание продолжить, поговорите снова с Халех.‡Sprecht mit Haleh, wenn Ihr weitermachen wollt.‡‡Habla con Haleh si quieres continuar.‡Habla con Haleh si quieres continuar.‡Si vous souhaitez continuer, parlez à Haleh.‡要是你想继续的话，就与哈尔琳谈一谈。‡',
  }
},
[5162] = {
  {
    'Ira da Revoada Azul‡Гнев синих драконов‡Der Zorn des blauen Drachenschwarms‡푸른용군단의 분노‡La cólera del Vuelo Azul‡La cólera del Vuelo Azul‡La colère du vol bleu‡蓝龙之怒‡藍龍軍團之怒',
    nil,
    'Fale com Jezibá nas Terras Pestilentas. Ele mora em Andorhal.‡Поговорите с Джезибой в Чумных землях. Он обитает в Андорале.‡Sprecht mit Jeziba in den Pestländern. Er wohnt in Andorhal.‡역병지대로 가서 안돌할에 사는 제지바와 대화해야 합니다.‡Habla con Jeziba en las Tierras de la Peste. Vive en Andorhal.‡Habla con Jeziba en las Tierras de la Peste. Vive en Andorhal.‡Parler à Jeziba dans les Maleterres. Il vit à Andorhal.‡与瘟疫之地的耶兹巴交谈。他居住在安多哈尔。‡與瘟疫之地的耶茲巴交談。他居住在安多哈爾。',
  }
},
[5163] = {
  {
    '[DEPRECATED]Are We There, Yeti?‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡[DEPRECATED]Yeti... ¿ya hemos llegado?‡[DEPRECATED]Yeti... ¿ya hemos llegado?‡[PÉRIMÉ]Yéti ? Y es-tu ?‡雪怪计划！‡[DEPRECATED]Are We There, Yeti?',
    nil,
    'Leve o Yeti Mecânico da Umi e assuste os amigos dela:|n|nLegacki, em Visteterna (Hibérnia),|nSguisha, em Geringontzan (Tanaris) e|nQuixxil, no Refúgio do Marshal (Cratera Un\'Goro).|n|nQuando terminar, leve o Yeti Mecânico de volta para Umi.‡Возьмите механического йети Уми и напугайте им ее друзей:|n|n- Легакки в Круговзоре (Зимние Ключи), |n- Поливалку в Прибамбасске (Танарис), |n- Квикксиля в Укрытии Маршалла (Кратер Ун\'Горо)|n|nКогда проделаете все это, принесите механического йети обратно Уми.‡Nehmt Umis mechanischen Yeti und erschreckt ihre Freunde damit:|n|nLegacki in der Ewigen Warte (Winterquell)|nSprinkel in Gadgetzan (Tanaris)|nQuixxil in Marschalls Zuflucht (Krater von Un\'Goro)|n|nWenn Ihr damit fertig seid, bringt den mechanischen Yeti zu Umi zurück.‡우미의 기계설인을 가져가서 아래 친구들에게 겁을 줘야 합니다.|n|n여명의 설원, 눈망루 마을에 있는 레각키|n타나리스의 가젯잔에 있는 스프링클|n운고로 분화구, 마샬의 야영지에 있는 퀵실|n|n모두에게 겁을 주고 나서 기계설인을 도로 우미에게 데리고 가야 합니다.‡Coge el yeti mecánico de Umi y asusta con él a sus amigos:|n|nLegacki en Vista Eterna (Cuna del Invierno)|nRoxio en Gadgetzan (Tanaris)|nQuixxil en el Refugio de Marshal (Cráter de Un\'Goro)|n|nCuando hayas terminado, devuelve el yeti mecánico a Umi.‡Coge el yeti mecánico de Umi y asusta con él a sus amigos:|n|nLegacki en Vista Eterna (Cuna del Invierno)|nRoxio en Gadgetzan (Tanaris)|nQuixxil en el Refugio de Marshal (Cráter de Un\'Goro)|n|nCuando hayas terminado, devuelve el yeti mecánico a Umi.‡Prendre le yéti mécanique d\'Umi et effrayer ses amis avec :|n|nLegacki, à Long-Guet (Berceau-de-l\'Hiver)|nSaupoudr, à Gadgetzan (Tanaris)|nQuixxil, au refuge des Marshal (Cratère d\'Un\'Goro)|n|nQuand vous aurez terminé, rapporter le yéti mécanique à Umi.‡带着乌米的机械雪人去吓唬她的朋友：|n|n永望镇的莱加奇（冬泉谷）、加基森的斯普琳科（塔纳利斯），还有马绍尔营地的奎克希尔（安戈洛环形山）。|n|n当你完成任务之后，把机械雪人还给乌米。‡帶著烏米的機械雪人去嚇唬她的朋友:|n|n永望鎮的萊加奇(冬泉谷)、加基森的斯普琳科(塔納利斯)，還有馬紹爾營地的奎克希爾(安戈洛環形山)。|n|n當你完成任務之後，把機械雪人還給烏米。',
  }
},
[5164] = {
  {
    '‡Перечень Заблудших‡Verzeichnis der Abtrünnigen‡무법의 시대 일람‡Catálogo del Díscolo‡Catálogo del Díscolo‡Catalogue de l\'Indocile‡游荡者目录‡遊蕩者目錄',
    nil,
    '‡Прочитайте перечень Заблудших.‡Lest das \'Verzeichnis der Abtrünnigen\'.‡‡Lee el Catálogo del Díscolo.|n‡Lee el Catálogo del Díscolo.|n‡Lire le Guide de l\'Indocile.‡阅读游荡者目录。‡',
  }
},
[5165] = {
  {
    '‡‡‡‡‡‡[PÉRIMÉ]Éteindre les flammes de protection‡熄灭火焰‡',
    nil,
    '‡‡‡‡‡‡À l\'aide de l\'Eau de Puits de lune purifiée, éteignez les flammes des quatre braseros de protection à l\'intérieur du Fort des ombres dans Gangrebois. Retournez ensuite auprès de Greta Sabot-de-mousse au Sanctuaire d\'émeraude.‡使用净化过的月亮井水熄灭暗影堡内部的四座火盆的火焰，从而破除其保护效果，然后向翡翠圣地的格雷塔·苔蹄复命。‡',
  }
},
[5166] = {
  {
    'Peitoral da Revoada Cromática‡Кираса хроматических полетов‡Brustplatte des chromatischen Drachenschwarms‡오색용군단 가슴보호갑‡Coraza del Vuelo Cromático‡Coraza del Vuelo Cromático‡La cuirasse du vol chromatique‡多彩巨龙胸甲‡炫彩巨龍胸甲',
    nil,
    'Para forjar o Peitoral da Revoada Cromática, você deverá levar os seguintes itens para Jezibá, o Escultor:|n|n1 Carapaça Cromática.|n|n10 Escamas Cromáticas Brilhantes.|n|n10 Sangues dos Heróis.|n|n10 Suturas de Abominação Puídas.‡Джезиба "Скульптор" может сковать кирасу Всецветных драконов, если вы принесете ему следующее:|n|n1 всецветный панцирь.|n|n10 сверкающих всецветных чешуек.|n|n10 порций крови героев.|n|n10 истлевших шовных нитей поганища.‡Um die Brustplatte des chromatischen Drachenschwarms zu schmieden, müsst Ihr die folgenden Gegenstände zu Jeziba dem \'Bildhauer\' bringen:|n|n1 chromatischen Knochenpanzer.|n|n10 glänzende chromatische Schuppen.|n|n10 Einheiten Blut von Helden.|n|n10 ausgefranste Monstrositätenstickereien.‡오색용군단 가슴보호갑을 제작하려면 다음 재료를 모아 "조각사" 제지바에게 가져가야 합니다.|n오색 등껍질 1개|n반짝이는 오색 비늘 10개|n영웅의 피 10개|n닳아 해진 누더기골렘 조각 10개‡Para forjar la coraza del Vuelo Cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:|n|n1 caparazón cromático.|n|n10 escamas cromáticas luminosas.|n|n10 sangres de héroes.|n|n10 costuras desgarradas de abominación.‡Para forjar la coraza del Vuelo Cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:|n|n1 caparazón cromático.|n|n10 escamas cromáticas luminosas.|n|n10 sangres de héroes.|n|n10 costuras desgarradas de abominación.‡Pour forger la Cuirasse du vol chromatique, il faut apporter les éléments suivants à Jeziba le "Sculpteur" :|n|n1 Carapace chromatique.|n|n10 Ecailles chromatiques brillantes.|n|n10 doses de Sang des héros.|n|n10 Coutures d\'Abomination effilochées.‡为了铸造多彩巨龙胸甲，你必须把以下材料交给雕刻者耶兹巴：|n|n1块多彩龙鳞。|n|n10块闪亮的彩色龙鳞。|n|n10份英雄之血。|n|n10块磨损的憎恶缝合线。‡為了鑄造炫彩巨龍胸甲，你必須把以下材料交給雕刻者耶茲巴:|n|n1塊炫彩龍鱗。|n|n10塊閃亮的炫彩龍鱗。|n|n10份英雄之血。|n|n10條磨損的憎惡縫合線。',
  }
},
[5167] = {
  {
    'Coxotes do Desafiante Cromático‡Ножные латы всецветного воина‡Beinplatten des chromatischen Widersetzers‡오색 파멸자의 다리갑옷‡Quijotes del Desafiante cromático‡Quijotes del Desafiante cromático‡Les cuissards de duelliste chromatique‡多彩挑战者腿甲‡炫彩挑戰者腿鎧',
    nil,
    'Para forjar os Coxotes do Desafiante Cromático, você deverá levar os seguintes itens para Jezibá, o Escultor:|n|n1 Carapaça Cromática.|n|n10 Escamas Cromáticas Brilhantes.|n|n10 Sangues de Heróis.|n|n5 Peles de Sombra.‡Джезиба \'Скульптор\' может сковать ножные латы Всецветного воина, если вы принесете ему следующее:|n|n1 всецветный панцирь.|n|n10 сверкающих всецветных чешуек.|n|n10 порций крови героев.|n|n5 шкур тени.‡Um die Beinplatten des chromatischen Widersetzers zu schmieden, müsst Ihr die folgenden Gegenstände zu Jeziba dem \'Bildhauer\' bringen:|n|n1 chromatischer Knochenpanzer.|n|n10 glänzende chromatische Schuppen.|n|n10 Einheiten Blut von Helden.|n|n5 Häute des Schattens.‡오색 파멸자의 다리갑옷을 제작하려면 다음 재료를 모아 "조각사" 제지바에게 가져가야 합니다.|n오색 등껍질 1개|n반짝이는 오색 비늘 10개|n영웅의 피 10개|n어둠의 허물 5개‡Para forjar los quijotes del desafiante cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:|n|n1 caparazón cromático.|n|n10 escamas cromáticas luminosas.|n|n10 sangres de héroes.|n|n5 pieles de Sombra.‡Para forjar los quijotes del desafiante cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:|n|n1 caparazón cromático.|n|n10 escamas cromáticas luminosas.|n|n10 sangres de héroes.|n|n5 pieles de Sombra.‡Pour forger les Cuissards de duelliste chromatique, il faut apporter les éléments suivants à Jeziba le "Sculpteur" :|n|n1 Carapace chromatique.|n|n10 Ecailles chromatiques brillantes.|n|n10 doses de Sang des héros.|n|n5 Peaux des ombres.‡为了铸造多彩挑战者腿甲，你必须把以下材料交给雕刻者耶兹巴：|n|n1块多彩龙鳞。|n|n10块闪亮的彩色龙鳞。|n|n10份英雄之血。|n|n5块暗影之皮。‡為了鑄造炫彩挑戰者腿鎧，你必須把以下材料交給雕刻者耶茲巴:|n|n1塊炫彩龍鱗。|n|n10塊閃亮的炫彩龍鱗。|n|n10份英雄之血。|n|n5塊暗影之皮。',
  }
},
[5168] = {
  {
    'Heróis da Vila das Flechas‡Герои Дарроушира‡Helden von Darroheim‡다로우골의 영웅‡Los héroes de Villa Darrow‡Los héroes de Villa Darrow‡Les héros de Comté-de-Darrow‡达隆郡的英雄‡達隆郡的英雄',
    nil,
    'Leve o Incunábulo de Davil e o Escudo de Trilharrubra para Carlin Trilharrubra.‡Принесите книгу Дейвила и щит Редпата Карлину Редпату.‡Bringt Davils Buchband und Rotpfads Schild zu Carlin Rotpfad.‡카를린 레드패스에게 다빌의 성서와 레드패스의 방패를 가져가야 합니다.‡Lleva el Tratado de Davil y el Escudo de Rutagrana a Carlin Rutagrana.‡Lleva el Tratado de Davil y el Escudo de Rutagrana a Carlin Rutagrana.‡Apporter le Libram de Davil et le Bouclier de Senterouge à Carlin Senterouge.‡把达维的圣契和雷德帕斯之盾交给卡林·雷德帕斯。‡把達維的聖契和雷德帕斯之盾交給卡林·雷德帕斯。',
  }
},
[5181] = {
  {
    'Vilões da Vila das Flechas‡Негодяи Дарроушира‡Bösewichte von Darroheim‡다로우골의 악당들‡Los villanos de Villa Darrow‡Los villanos de Villa Darrow‡Les vilains de Comté-de-Darrow‡达隆郡的恶魔‡達隆郡的惡魔',
    nil,
    'Leve o Crânio de Horgus e a Espada Estilhaçada de Marduk para Carlin Trilharrubra na Capela Esperança da Luz.‡Принесите череп Хоргуса и сломанный меч Мардука Карлину Редпату в часовню Последней Надежды.‡Bringt den Schädel von Horgus und das zertrümmerte Schwert von Marduk zu Carlin Rotpfad in der Kapelle des Hoffnungsvollen Lichts.‡희망의 빛 예배당에 있는 카를린 레드패스에게 호르구스의 해골과 부러진 마르두크의 검을 가져가야 합니다.‡Lleva el cráneo de Horgus y la espada destrozada de Marduk a Carlin Rutagrana a la Capilla de la Esperanza de la Luz.‡Lleva el cráneo de Horgus y la espada destrozada de Marduk a Carlin Rutagrana a la Capilla de la Esperanza de la Luz.‡Rapporter le Crâne d\'Horgus et l\'Epée brisée de Marduk à Carlin Senterouge à la chapelle de l\'Espoir de Lumière.‡将霍古斯的徽记和马杜克的破碎之剑交给圣光之愿礼拜堂的卡林·雷德帕斯。‡將霍古斯的顱骨和馬杜克的破碎之劍交給聖光之願禮拜堂的卡林·雷德帕斯。',
  }
},
[5201] = {
  {
    'Invasão dos Invernosos‡Вторжение племени Зимней Спячки‡Eindringlinge der Winterfelle‡겨울눈 일족의 침략‡Intrusión Nevada‡Intrusión Nevada‡L\'incursion des Tombe-hiver‡冬泉熊怪的侵扰‡冬泉熊怪的侵擾',
    nil,
    'Ripárion Glaciares quer que você mate 5 Xamãs Invernosos e 5 Ursinos Invernosos.‡По заданию Риверна Холодного Ветра убейте 5 шаманов и 5 ведмедей из клана Зимней Спячки.‡Rivern Frostwind möchte, dass Ihr 5 Schamanen der Winterfelle und 5 Ursa der Winterfelle erschlagt.‡리베른 프로스트윈드가 겨울눈 주술사 5마리와 겨울눈 펄볼그 5마리를 처치해 달라고 했습니다.‡Rivern Ventogélido quiere que mates 5 chamanes Nevada y 5 ursas Nevada.‡Rivern Ventogélido quiere que mates 5 chamanes Nevada y 5 ursas Nevada.‡Rivern Givrevent veut que vous tuiez 5 Chamans tombe-hiver et 5 Ursas tombe-hiver.‡雷沃·霜翼要你去杀死5个冬泉萨满祭司和5个冬泉巨熊怪。‡雷沃·霜風要你去殺死5個冬泉薩滿和5個冬泉巨熊怪。',
  }
},
[5202] = {
  {
    '[DEPRECATED]A Strange Red Key‡Странный красный ключ‡Ein merkwürdiger roter Schlüssel‡[재사용]이상한 붉은 열쇠‡[DEPRECATED]Una extraña llave roja‡[DEPRECATED]Una extraña llave roja‡[PÉRIMÉ]Une étrange clé rouge‡奇怪的红钥匙‡[DEPRECATED]A Strange Red Key',
    nil,
    'Procure em Jaedenar o que pode ser aberto pela Chave Vermelho Sangue.‡Обыщите Джеденар и найдите замок, который открывается странным красным ключом.‡Durchsucht Jaedenar, um herauszufinden, wofür der blutrote Schlüssel verwendet wird.‡제데나르를 뒤져 이 붉은 열쇠의 용도를 알아내야 합니다.‡Recorre Jaedenar y descubre para qué se utiliza la llave roja de sangre.‡Recorre Jaedenar y descubre para qué se utiliza la llave roja de sangre.‡Chercher dans Jaedenar à quoi sert la Clé rouge sang.‡搜寻加德纳尔，找出血红钥匙的用途。‡搜尋加德納爾，找出血紅鑰匙的用途。',
  }
},
[5203] = {
  {
    '‡Спасение из Джеденара‡Rettung aus Jaedenar‡‡[DEPRECATED]El rescate en Jaedenar‡‡[PÉRIMÉ]Sauvetage à Jaedenar‡逃出加德纳尔‡',
    nil,
    '‡Сопроводите Арко\'нарин туда, где лежат меч Светлая Сталь и снаряжение Арко\'нарин, и защитите ее при побеге из Оплота Теней. Потом разыщите Джессиру Лунную Радугу в Оскверненном лесу и расскажите ей, что случилось с ее друзьями.‡Bringt Arko\'narin dorthin, wo Lichtschmied und ihre Ausrüstung aufbewahrt werden, und beschützt sie dann bei eurer Flucht aus der Schattenfeste. Sucht danach Jessir Mondsichel im Teufelswald auf und lasst sie wissen, was mit ihren Freunden geschehen ist.‡‡Escolta a Arko\'narin hasta el lugar en el que están Forjaluz y su equipo y protégela en la huida de la Guarida Sombría. Después, busca a Jessir Arcolunar en Frondavil para contarle lo que les ha ocurrido a sus amigos.‡Escolta a Arko\'narin hasta el lugar en el que están Forjaluz y su equipo y protégela en la huida de la Guarida Sombría. Después, busca a Jessir Arcolunar en Frondavil para contarle lo que les ha ocurrido a sus amigos.‡Escorter Arko\'narin à l\'endroit où Sancteforge et son équipement sont détenus, puis la protéger lors de l\'évasion du Fort des ombres. Ensuite, aller trouver Jessir Arquelune dans Gangrebois pour lui apprendre ce qui est arrivé à ses amis.‡护送亚科纳琳到莱弗治和她的装备所在的地方，然后保护她逃离暗影堡。之后，在费伍德森林找杰希尔·月弓，并告诉她刚才发生的事情。‡',
  }
},
[5204] = {
  {
    '‡‡‡‡‡‡‡光明的惩戒‡',
    nil,
    '‡‡‡‡‡‡‡回到加德纳尔杀了魅魔拉凯雅，然后找到特雷·莱弗治的残骸。‡',
  }
},
