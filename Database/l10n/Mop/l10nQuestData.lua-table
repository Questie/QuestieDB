    nil,
  }
},
[840] = {
  {
    'Recruta da Horda‡Новобранец Орды‡Freiwilliger der Horde‡호드의 징병‡Nuevo recluta de la Horda‡Nuevo recluta de la Horda‡Sous les drapeaux de la Horde‡部落的新兵‡部落的新兵',
    nil,
    'Entregue sua carta de recrutamento para Kargal Chaga de Guerra, no posto avançado dos Sertões.‡Отдайте Каргалу Боевому Шраму ваше письмо о найме.‡Gebt Kargal Schlachtnarbe im Brachlandaußenposten Euren Anwerbungsbrief.‡불모의 땅 전초기지에 있는 카르갈 배틀스카에게 징병 추천서를 전달해야 합니다.‡Entrega tu carta de reclutamiento a Kargal Marca de Guerra, en la Avanzada de Los Baldíos.‡Entrega tu carta de reclutamiento a Kargal Marca de Guerra, en la Avanzada de Los Baldíos.‡Donner votre Lettre de recrutement à Kargal Balafre-glorieuse, à l\'Avant-poste des Tarides.‡在贫瘠之地的前哨站找到卡加尔·战痕，将你的募兵信交给他。‡將你的募兵信交給在貧瘠之地前哨站的卡加爾‧戰痕。',
  }
},
[841] = {
  {
    'Outra fonte de energia?‡Еще один источник энергии?‡Eine weitere Kraftquelle?‡추가 동력원 필요?‡¿Otra fuente de alimentación?‡¿Otra fuente de alimentación?‡Une autre Source d\'énergie ?‡另一个能量源？‡另一個能量源?',
    nil,
    'Leve 10 Bolsas de Água do Errante para o Engenheiro-chefe Silvadágua em Geringontzan em troca de outra Fonte de Energia.‡Принесите 10 бурдюков с водой Скитальцев Пустыни главному инженеру Чепухастеру в Прибамбасск в обмен на еще один источник энергии.‡Bringt Chefingenieur Bilgenritzel in Gadgetzan 10 Wasserbeutel eines Wüstenläufers im Austausch gegen eine weitere Kraftquelle.‡가젯잔에 있는 선임기술자 빌지위즐에게 사막유랑단 물주머니 10개를 가져가 다른 동력원과 맞바꿔야 합니다.‡Llévale 10 faltriqueras de agua de Deambulador al ingeniero jefe Silvaina, que está en Gadgetzan, para conseguir otra fuente de alimentación.‡Llévale 10 faltriquera de agua de Vagayermos al ingeniero jefe Pasaquillas, que está en Gadgetzan, para conseguir otra fuente de alimentación.‡Apporter 10 Outres de Bat-le-désert à l\'ingénieur en chef Vizisanie à Gadgetzan pour qu\'il les échange contre une autre source d\'énergie.‡用10个废土水袋来和加基森的总工程师比格维兹换取另外一个能量源。‡用10個廢土水袋來和加基森的首席工程師膨嘯換取另外一個能量源。',
  }
},
[842] = {
  {
    'Recrutamento na Encruzilhada‡Рекрутский набор Перекрестка‡Wegekreuzwehrpflicht‡십자로의 징병‡Servicio militar en El Cruce‡Servicio militar en El Cruce‡Conscription à la Croisée‡十字路口征兵‡十字路口的徵兵行動',
    nil,
    'Deliver your signed recruitment letter to Sergra Darkthorn at the Crossroads. If you haven\'t already, you can hitch a ride there with the next caravan by talking to Halga Bloodeye at Far Watch Outpost.‡Отнесите подписанное письмо Сергре Черный Шип в Перекрестке. Можете присоединиться к ближайшему каравану, поговорив с Халгой Кровавый Глаз на Дальней заставе.‡Liefert Euren unterschriebenen Anwerbungsbrief bei Sergra Dunkeldorn am Wegekreuz ab. Wenn Ihr es nicht schon getan habt, könnt Ihr einen Platz in der nächsten Karawane dorthin bei Halga Blutauge in der Fernwacht bekommen.‡십자로에 있는 셀그라 다크쏜에게 서명된 징병 추천서를 전달해야 합니다. 아직 전달하지 않았다면, 천리길 경비초소에 있는 할가 블러드아이와 대화하여 짐마차에 탈 수 있습니다.‡Entrega tu carta de reclutamiento firmada a Sergra Espinoscura, que está en El Cruce. Si todavía no lo has hecho, puedes pedirle a Halga Ojosangre que te lleven con la siguiente caravana.‡Entrega tu carta de reclutamiento firmada a Sergra Espinoscura, que está en El Cruce. Si todavía no lo has hecho, puedes pedirle a Halga Ojosangre que te lleven con la siguiente caravana.‡Remettez votre lettre de recrutement signee à Sergra Sombreronce à la Croisée. Si vous ne l’avez pas déjà fait, vous pouvez faire la route avec la prochaine caravane en parlant à Halga Œil-sanglant au poste de Guet-Lointain.‡从卡加尔的前沿哨所往西走。|n|n在丁字路口往左拐，然后朝南走。|n|n在十字路口的道路交汇处找到瑟格拉·黑棘。‡將已簽署的募兵信帶去十字路口交給瑟格拉·黑棘。如果還沒這樣做過，你可以在前沿哨所和赫加·血眼談話，好與下一批車隊一同前往。',
  }
},
[843] = {
  {
    'Reivindicação de Gann‡Ответный удар Ганна‡Ganns Rekultivierung‡갠의 땅 회복‡La reclamación de Gann‡La reclamación de Gann‡La reconquête de Gann‡加恩的报复‡加恩的報復',
    nil,
    'Gann Agulha de Pedra quer que você mate 15 Escavadores de Bael\'Dun e 5 Capatazes de Bael\'dun.|n|nLeve o Diário de Khazgorm para Gann Agulha de Pedra.‡Ганн Каменное Копье попросил вас убить 15 бейл\'данских землечерпов и 5 бейл\'данских старшин.|n|nПринесите Ганну Каменному Копью записи Хазгорма.‡Gann Steinkeil möchte, dass Ihr 15 Ausgräber von Bael\'dun und 5 Großknechte von Bael\'dun tötet.|n|nBringt Gann Steinkeil dann Khazgorms Tagebuch.‡갠 스톤스파이어가 바엘던 발굴인부 15명과 바엘던 현장감독 5명을 처치해 달라고 했습니다.|n|n그리고 카즈고름의 보고서를 갠 스톤스파이어에게 가져가야 합니다.‡Gann Picopiedra quiere que mates a 15 excavadores de Bael\'dun y a 5 supervisores de Bael\'dun.|n|nLlévale el diario de Khazgorm a Gann Picopiedra.‡Gann Picopiedra quiere que mates a 15 excavadores de Bael\'dun y a 5 supervisores de Bael\'dun.|n|nLlévale el diario de Khazgorm a Gann Picopiedra.‡Gann Cime-de-pierre veut que vous tuiez 15 Excavateurs de Bael\'dun et 5 Surveillants de Bael\'dun.|n|nApporter le Journal de Khazgorm à Gann Cime-de-pierre.‡加恩·石塔让你杀死15个巴尔丹挖掘者和5个巴尔丹工头。|n|n把卡兹戈姆的日记交给加恩·石塔。‡加恩·石塔要你殺死15個巴爾丹挖掘者和5個巴爾丹工頭。|n|n把卡茲戈姆的日記交給加恩·石塔。',
  }
},
[844] = {
  {
    'A ameaça pinote‡Равнинные долгоноги‡Ebenenschreiterbedrohung‡초원타조의 위협‡La amenaza de los zancudos de llanura‡La amenaza de los zancudos de llanura‡La menace des trotteurs des plaines‡平原陆行鸟的威胁‡平原陸行鳥的威脅',
    nil,
    'Colete 7 Bicos de Pinote.‡Соберите 7 клювов равнинных долгоногов.‡Sammelt 7 Ebenenschreiterschnäbel.‡초원타조 부리 7개를 수집해야 합니다.‡Reúne 7 picos de zancudos de llanura.‡Reúne 7 picos de zancudos de llanura.‡Collectez 7 Becs de trotteur des plaines.‡收集7个陆行鸟的喙。‡收集7個陸行鳥的喙。',
  }
},
[845] = {
  {
    'As zevras‡Жевры‡Die Zhevras‡얼룩말‡La zhebra‡La zhebra‡Les zhévras‡斑马的威胁‡角斑馬',
    nil,
    'Mate Zevras Corredoras até conseguir 4 Cascos de Zevra.‡Убивайте жевр-бегунов, пока не наберете 4 пары копыт жевры.‡Erschlagt Zhevraläufer, um 4 Zhevrahufe zu erhalten.‡굶주린 얼룩말을 처치하여 얼룩말 발굽 4개를 모아야 합니다.‡Mata a galopadores zhebras para reunir 4 pezuñas de zhebras.‡Mata a galopadores zhebras para reunir 4 pezuñas de zhebras.‡Tuez des Messagers zhévras pour obtenir 4 Sabots de zhévra.‡杀死快步斑马并收集4只斑马蹄。‡殺死快步角斑馬並收集4只角斑馬蹄。',
  }
},
[846] = {
  {
    'A vingança de Gann‡Месть Ганна‡Ganns Rache‡갠의 복수‡La venganza de Gann‡La venganza de Gann‡La revanche de Gann‡加恩的报复‡加恩的復仇',
    nil,
    'Gann Agulha de Pedra quer que você leve para ele 6 ampolas de Nitroglicerina, 6 feixes de Polpa de Madeira e 6 amostras de Nitrato de Sódio.‡Ганн Каменное Копье попросил вас принести ему 6 сосудов с нитроглицерином, 6 пучков древесной сердцевины и 6 образцов натриевой селитры.‡Gann Steinkeil möchte, dass Ihr ihm 6 Phiolen Nitroglyzerin, 6 Teile Holzbrei und 6 Proben Natriumnitrat bringt.‡갠 스톤스파이어가 니트로글리세린 6병, 나무 펄프 6묶음, 질산나트륨 표본 6개를 가져다 달라고 했습니다.‡Gann Picopiedra quiere que le traigas 6 viales de nitroglicerina, 6 fajos de pulpa de madera y 6 muestras de nitrato sódico.‡Gann Picopiedra quiere que le traigas 6 viales de nitroglicerina, 6 fajos de pulpa de madera y 6 muestras de nitrato sódico.‡Gann Cime-de-pierre veut que vous lui apportiez 6 Fioles de Nitroglycérine, 6 Paquets de Pulpe de bois et 6 échantillons de Nitrate de sodium.‡加恩·石塔要你将6瓶硝化甘油、6份木浆和6份硝酸钠交给他。‡加恩·石塔要你帶6瓶硝化甘油、6份木漿和6份硝酸鈉給他。',
  }
},
[847] = {
  {
    '‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡',
    nil,
    '‡Поговорите с Тор\'ганом в Павшем Молоте, что на нагорье Арати.‡Sprecht mit Tor\'gan in Hammerfall im Arathihochland.‡‡Habla con Tor\'gan en Sentencia, en las Tierras Altas de Arathi.‡Habla con Tor\'gan en Sentencia, en las Tierras Altas de Arathi.‡Parler à Tor\'gan au Trépas-d\'Orgrim, dans les Hautes-terres Arathies.‡和托尔甘谈一谈。‡',
  }
},
[848] = {
  {
    'Esporos de Fungos‡Споры грибов‡Pilzsporen‡버섯 포자‡Esporas de hongos‡Esporas de hongos‡Spores fongiques‡菌类孢子‡菌類孢子',
    nil,
    'Colete 5 Esporos de Fungos de cogumelos dos Charcos Esquecidos.‡Соберите 5 порций спор грибов у Забытых прудов.‡Sammelt 5 Pilzsporen von den Pilzen an den Vergessenen Teichen.‡잊혀진 웅덩이에 있는 버섯에서 버섯 포자 5개를 수집해야 합니다.‡Reúne 5 esporas de hongos de los hongos de Las Charcas del Olvido.‡Reúne 5 esporas de hongos de los hongos de Las Charcas del Olvido.‡Récoltez 5 Spores fongiques sur des champignons dans les Bassins Oubliés.‡在遗忘之池收集5个菌类孢子。‡從遺忘之池的蘑菇那裡收集5個菌類孢子。',
  }
},
[849] = {
  {
    'A vingança de Gann‡Месть Ганна‡Ganns Rache‡갠의 복수‡La venganza de Gann‡La venganza de Gann‡La revanche de Gann‡加恩的报复‡加恩的復仇',
    nil,
    'Destrua a máquina voadora em Bael Modan e fale novamente com Gann Agulha de Pedra.‡Уничтожьте ветролет в Бейл Модане и возвращайтесь к Ганну Каменному Копью.‡Zerstört den Flugapparat bei Bael Modan und kehrt dann zu Gann Steinkeil zurück.‡바엘 모단에 있는 비행기를 파괴하고 갠 스톤스파이어에게 가야 합니다.‡Destruye la máquina voladora de Bael Modan y regresa junto a Gann Picopiedra.‡Destruye la máquina voladora de Bael Modan y regresa junto a Gann Picopiedra.‡Détruire la Machine volante à Bael Modan et retourner voir Gann Cime-de-pierre.‡摧毁巴尔莫丹的飞行器，然后向加恩·石塔回复。‡摧毀巴爾莫丹的飛行器，然後向加恩·石塔回覆。',
  }
},
[850] = {
  {
    'Os líderes Kolkar‡Главари племени Колкар‡Anführer der Kolkar‡콜카르 지도자‡Los jefes Kolkar‡Los jefes Kolkar‡Les chefs des Kolkars‡科卡尔首领‡科卡爾的首領',
    nil,
    'Mate Barak Findekodo e arranque a cabeça dele.‡Убейте Барака Кодобоя и отрубите ему голову.‡Tötet Barak Kodobann und nehmt seinen Kopf an Euch.‡바라크 코도베인을 처치하고 그의 머리띠를 입수해야 합니다.‡Asesina a Barak Aterrakodos y hazte con su cabeza.‡Asesina a Barak Aterrakodos y hazte con su cabeza.‡Tuez Barak Plaie-des-kodos et prenez sa tête.‡击败巴拉克，获得他的战利品。‡殺死巴拉克‧科多班恩並取得他的頭顱。',
  }
},
[851] = {
  {
    'Verog, o Dervixe‡Верог Дервиш‡Verog der Derwisch‡광신자 베로그‡Verog el Derviche‡Verog el Derviche‡Verog le Derviche‡狂热的维罗戈‡狂熱的維羅戈',
    nil,
    'Mate Wyneth para atrair Verog. Em seguida, mate-o e pegue a cabeça.‡Убейте Винет, чтобы выманить кентавра Верога, и отрубите ему голову.‡Tötet Wyneth, um Verog den Derwisch hervorzulocken. Erschlagt ihn dann und nehmt seinen Kopf an Euch.‡위네스를 처치해 광신자 베로그를 유인한 뒤, 베로그를 처치하고 그의 머리띠를 수집해야 합니다.‡Mata a Wyneth para atraer a Verog el Derviche, después asesínalo y hazte con su cabeza.‡Mata a Wyneth para atraer a Verog el Derviche, después asesínalo y hazte con su cabeza.‡Tuez Wyneth afin d\'attirer Verog le Derviche, puis tuez-le et prenez sa tête.‡杀死维内斯，将维罗戈引出来。然后杀死他，获取他的徽记。‡把維羅戈的頭顱交給十字路口的雷戈薩·死門。',
  }
},
[852] = {
  {
    'Hezrul Marca de Sangue‡Хэзрул Кровавая Отметина‡Hezrul Blutmal‡헤즈룰 블러드마크‡Hezrul Marcasangre‡Hezrul Marcasangre‡Hezrul Marque-de-sang‡赫兹鲁尔·血印‡赫茲盧爾·血印',
    nil,
    'Mate Hezrul Marca de Sangue e arranque a cabeça dele.‡Убейте Хэзрула и отрубите ему голову.‡Tötet Hezrul Blutmal und nehmt seinen Kopf an Euch.‡헤즈룰 블러드마크를 처치하고 그의 머리띠를 수집해야 합니다.‡Asesina a Hezrul Marcasangre y recoge su cabeza.‡Asesina a Hezrul Marcasangre y recoge su cabeza.‡Tuez Hezrul Marque-de-sang et prenez sa tête.‡击败赫兹鲁尔，获得他的战利品。‡殺死赫茲盧爾·血印並取得他的頭顱。',
  }
},
[853] = {
  {
    '[DEPRECATED] Apothecary Zamah‡[DEPRECATED]Аптекарь Зама‡Apothekerin Zamah‡[미사용]연금술사 자마‡[DEPRECATED] Apothecary Zamah‡[DEPRECATED] Apothecary Zamah‡[PÉRIMÉ]L\'apothicaire Zamah‡[DEPRECATED] 药剂师扎玛‡[DEPRICATED]藥劑師札瑪',
    nil,
    'Leve os Esporos Entregues para a Boticária Zaqueia no Penhasco do Trovão antes que o tempo se esgote.‡Отнесите топленые споры аптекарю Заме в Громовой Утес за отведенное время.‡Bringt der Apothekerin Zamah in Donnerfels die weiterverarbeiteten Sporen, bevor die Zeit abgelaufen ist.‡제한 시간 내에 썬더 블러프에 있는 연금술사 자마에게 정제된 포자를 가져가야 합니다.‡Llévale las esporas devueltas a la boticaria Zamah en Cima del Trueno antes de que se agote el límite de tiempo.‡Llévale las esporas devueltas a la boticaria Zamah en Cima del Trueno antes de que se agote el límite de tiempo.‡Apportez les Spores fondues à l\'Apothicaire Zamah aux Pitons-du-Tonnerre, avant que la limite de temps ne soit dépassée.‡在药剂的效力消失之前，把提炼过的孢子交给雷霆崖的药剂师扎玛。‡在藥劑的效力消失之前，把提煉過的孢子交給雷霆崖的藥劑師札瑪。',
  }
},
[854] = {
  {
    'Jornada para a Encruzilhada‡Путешествие в Перекресток‡Reise zum Wegekreuz‡십자로로의 여정‡Viaja a El Cruce‡Viaja a El Cruce‡Un voyage à la Croisée‡十字路口之旅‡十字路口之旅',
    nil,
    'Fale com Thork na Encruzilhada, nos Sertões.‡Поговорите с Тхорком на Перекрестке в Степях.‡Sprecht mit Thork beim Wegekreuz im Brachland.‡불모의 땅에 있는 톨크와 대화해야 합니다.‡Habla con Thork en El Cruce, en Los Baldíos.‡Habla con Thork en El Cruce, en Los Baldíos.‡Parler à Thork, à la Croisée des Tarides.‡去十字路口和索克谈一谈。‡去十字路口和索克談話。',
  }
},
[855] = {
  {
    'Braçadeiras de centauro‡Наручи кентавров‡Zentaurenarmschienen‡켄타우로스의 팔보호구‡Los brazales centauro‡Los brazales centauro‡Les bracelets de centaure‡半人马护腕‡半人馬護腕',
    nil,
    'Colete 10 Braçadeiras de Centauro dos Espoliadores Kolkar e das Profetisas da Tempestade Kolkar.‡Соберите 10 наручей кентавров-мародеров и предвестниц бури из племени Колкар.‡Sammelt 10 Zentaurenarmschienen von Marodeuren und Sturmsehern der Kolkar.‡콜카르 약탈자와 폭풍술사를 처치해 켄타우로스의 팔보호구 10개를 수집해야 합니다.‡Llévale 10 brazales centauro de maleantes y videntormentos Kolkar.‡Llévale 10 brazales centauro de maleantes y videntormentos Kolkar.‡Récupérez 10 Bracelets de centaure sur des Maraudeurs et des Prophètes-tempête kolkars.‡从科卡尔掠夺者和科卡尔风暴先知身上收集10个半人马护腕。‡從科卡爾掠奪者和科卡爾風暴先知那裡收集10個半人馬護腕。',
  }
},
[856] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Siga a estrada a partir do Acampamento Taurajo.|n|nVire à esquerda na bifurcação e continue rumo ao norte.|n|nVá ao Sábio Ancestral antes de entrar na Encruzilhada.‡Выйдите из лагеря Тауарахо и идите вдоль дороги.|n|nНа распутье поверните налево и продолжайте путь на север.|n|nУ стен Перекрестка вас будет ждать древний мудрец.‡Folgt der Straße, die aus dem Camp Taurajo herausführt.|n|nHaltet Euch bei der Einmündung links und geht weiter nach Norden.|n|nFolgt dem Pfad bis zum Vorfahrenweisen außerhalb des Wegekreuzes.‡타우라조 야영지에서 길을 따라 계속 이동해야 합니다.|n|n갈림길이 나오면 왼쪽으로 접어든 후, 북쪽으로 나아가야 합니다.|n|n길을 따라가 크로스로드 바깥에 있는 고대의 현자를 만나야 합니다.‡Sigue el camino desde el Campamento Taurajo.|n|nGira a la izquierda en la bifurcación y continúa hacia el norte.|n|nSigue el camino hasta llegar al Sabio Ancestral a las afueras de El Cruce.‡Sigue por el camino desde Campamento Taurajo.|n|nGira a la izquierda en la bifurcación y sigue hacia el norte.|n|nContinúa por el camino hasta llegar con el sabio ancestral en las afueras de El Cruce.‡Continuez à suivre la route depuis le camp Taurajo.|n|nTournez à gauche à l’intersection en T et continuez vers le nord.|n|nSuivez le chemin jusqu’au Sage ancestral à l’extérieur de la Croisée.‡从陶拉祖营地继续沿着路走。|n|n在丁字路口向左拐，然后往北走。|n|n沿着大路一直走到十字路口，和外面的先祖圣者谈一谈。‡出陶拉祖營地後沿著路一直走。|n|n在T字路口向左轉，並繼續向北走。|n|n沿著路徑找到十字路口外的先祖賢者。',
  }
},
[857] = {
  {
    'A Lágrima das Luas‡Слеза Лун‡Die Träne der Monde‡달의 눈물‡La Lágrima de las Lunas‡La Lágrima de las Lunas‡La larme des lunes‡众月之泪‡眾月之淚',
    nil,
    'Feegly, o Exilado, quer que você recupere a Lágrima das Luas para ele.‡Фриглай Изгнанник попросил вас вернуть ему слезу Лун.‡Feegly der Verbannte möchte, dass Ihr ihm die Träne der Monde zurückbringt.‡추방자 피글리가 달의 눈물을 되찾아 달라고 했습니다.‡Feegly el Exiliado quiere que le consigas la Lágrima de las Lunas.‡Feegly el Exiliado quiere que le consigas la Lágrima de las Lunas.‡Feegly l\'Exilé veut que vous retrouviez pour lui la Larme des lunes.‡被流放的费格雷要你取回他的众月之泪。‡被流放的費格雷要你取回他的眾月之淚。',
  }
},
[858] = {
  {
    'Ignição‡Зажигание‡Zündung‡시동‡La llave de contacto‡La llave de contacto‡Contact‡打火钥匙‡點火裝置',
    nil,
    'Pegue a Chave de Ignição do Supervisor Rancatraca.‡Добудьте ключ зажигания у бригадира Зубовиззла.‡Holt den Zündschlüssel von Vorsteher Lugwizz.‡관리자 러그위즐에게서 시동 열쇠를 얻어야 합니다.‡Consigue la llave de contacto del Supervisor Palarrastre.‡Consigue la llave de contacto del Supervisor Palarrastre.‡Allez chercher la Clé de contact auprès du Superviseur Trimballast.‡从鲁格维兹主管那里取得打火钥匙。‡從魯格維茲主管那裡取得點火裝置的鑰匙。',
  }
},
[859] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[860] = {
  {
    'Sergra Espinhonegro‡Сергра Черный Шип‡Sergra Dunkeldorn‡셀그라 다크쏜‡Sergra Espinoscura‡Sergra Espinoscura‡Sergra Sombreronce‡瑟格拉·黑棘‡瑟格拉·黑棘',
    nil,
    'Speak with Sergra Darkthorn at the Crossroads.‡Поговорите с Сергрой Черный Шип в Перекрестке.‡Sprecht beim Wegekreuz mit Sergra Dunkeldorn.‡십자로에 있는 셀그라 다크쏜과 대화해야 합니다.‡Habla con Sergra Espinoscura en El Cruce.‡Habla con Sergra Espinoscura en El Cruce.‡Parler à Sergra Sombreronce, à la Croisée.‡和十字路口的瑟格拉·黑棘谈一谈。‡和十字路口的瑟格拉·黑棘談話。',
  }
},
[861] = {
  {
    'A senda do caçador‡Путь охотника‡Der Weg der Jäger‡사냥꾼의 길‡Los hábitos del cazador‡Los hábitos del cazador‡Le chemin du chasseur‡猎人之道‡獵人之途',
    nil,
    'Recolha 4 Garras de Predador das Estepes.‡Принесите 4 когтя хищника плоскогорья.‡Erhaltet 4 Flachlandstreunerklauen.‡굶주린 평원퓨마 발톱 4개를 모아야 합니다.‡Reúne 4 garras de merodeador de las estepas.‡Reúne 4 garras de merodeador de las estepas.‡Récupérez 4 Griffes de Rôdeurs des basses plaines.‡收集4只平原徘徊者的爪子。‡收集4隻平原徘徊者的爪子。',
  }
},
[862] = {
  {
    'Ensopado de ratoupeira‡Похлебка из пещерной крысы‡Grubenratteneintopf‡들쥐 고기 스튜‡Estofado de ratas de madriguera‡Estofado de ratas de madriguera‡Brouet de rat‡掘地鼠炖肉‡掘地鼠燉肉',
    nil,
    'Leve 8 Ratoupeiras para Grude a leste da Encruzilhada.‡Принесите 8 пещерных крыс Грубу на востоке от Перекрестка.‡Bringt Grub östlich des Wegekreuzes 8 Grubenratten.‡십자로 동쪽에 있는 그럽에게 들쥐 고기 8개를 가져가야 합니다.‡Llévale 8 ratas de excavación a Larva al este de El Cruce.‡Llévale 8 ratas de madriguera a Larva al este de El Cruce.‡Apporter 8 Rats fouisseurs à Boustiff\' à l\'est de la Croisée.‡给十字路口的格拉布弄到8只掘地鼠。‡給十字路口的格拉布弄到8隻掘地鼠。',
  }
},
[863] = {
  {
    'A fuga‡Бегство‡Die Flucht‡탈출‡La fuga‡La fuga‡La fuite‡逃跑‡逃跑',
    nil,
    'Escolte o Manivela e o retalhador goblínico roubado para fora do Charco de Lodo.‡Охраняйте Зигзага и похищенный гоблинский крошшер по пути из Нефтяного болота.‡Beschützt Kurbelwizz und den gestohlenen Goblinschredder auf dem Weg aus dem Schlickmoor heraus.‡진흙 늪을 빠져나가는 동안 위즐크랭크와 훔쳐낸 고블린 벌목기를 보호해야 합니다.‡Protege a Rabiaire y la trituradora goblin robada hasta que salgan de El Fangal.‡Protege a Rabiaire y la trituradora goblin robada hasta que salgan de El Fangal.‡Protégez Crackelevier et le Déchiqueteur gobelin pendant la fuite hors de la Videfange.‡保护维兹克兰克以及他搞到的地精伐木机离开淤泥沼泽。‡保護維茲克蘭克以及他偷來的哥布林伐木機逃離淤泥沼澤。',
  }
},
[864] = {
  {
    'Fale novamente com a Boticária Zilda‡Возвращение к аптекарю Зинг‡Kehrt zu Apothekerin Zinge zurück‡연금술사 진게에게 돌아가기‡Regresa junto a la boticaria Zinge‡Regresa junto a la boticaria Zinge‡De retour vers l\'apothicaire Zinge‡向药剂师金格回报‡向藥劑師金格回報',
    nil,
    'Leve o Kit de Teste de Campo Lacrado para a Boticária Zilda na Cidade Baixa.‡Отнесите запечатанный набор для полевых испытаний аптекарю Зинг в Подгород.‡Bringt das versiegelte Feldtestset nach Unterstadt zu Apothekerin Zinge.‡언더시티에 있는 연금술사 진게에게 봉인된 분석 도구를 가져가야 합니다.‡Llévale el equipo de estudio de campo sellado a la boticaria Zinge, que está en Entrañas.‡Llévale el equipo de prueba de campo sellado a la boticaria Zinge, que está en Entrañas.‡Apportez la Trousse d\'analyse de terrain verrouillée à l\'apothicaire Zinge à Fossoyeuse.‡把实验工具包带给幽暗城的药剂师金格。‡把密封的野外實驗工具包帶給幽暗城的藥劑師金格。',
  }
},
[865] = {
  {
    'Só pode ser o chifre‡Всем рогам рог‡Es muss im Horn stecken‡랩터 뿔‡El secreto está en el cuerno‡El secreto está en el cuerno‡La corne, c\'est le pied‡一定是因为角‡一定是角',
    nil,
    'Consiga o Chifre do Rei Garra.‡Добудьте рог короля Дерущего Когтя.‡Erhaltet das Horn von König Schnitterklaue.‡왕 죽음발톱의 뿔을 획득해야 합니다.‡Consigue el cuerno del rey Zarpagarra.‡Consigue el cuerno del rey Zarpagarra.‡Procurez-vous la Corne du roi Griffe-acérée.‡获得镰爪之王的角。‡取得鐮爪王之角。',
  }
},
[866] = {
  {
    'Amostras de raiz‡Образцы корней‡Wurzelproben‡뿌리 표본‡Recoge muestras de raíces‡Recoge muestras de raíces‡Les échantillons de racines‡根须样本‡根鬚樣本',
    nil,
    'Colete 8 Amostras de Raízes das plantas dos Sertões Setentrionais.‡Соберите 8 образцов корней трав, растущих в Северных Степях.‡Sammelt 8 Wurzelproben von den Kräutern im Nördlichen Brachland.‡불모의 땅 북부 주변에서 뿌리 표본 8개를 수집해야 합니다.‡Llévale 8 muestras de raíces de hierbas de los alrededores de Los Baldíos del Norte.‡Llévale 8 muestras de raíces de hierbas de los alrededores de Los Baldíos del Norte.‡Récoltez 8 Échantillons de Racines sur des herbes des Tarides du Nord.‡在北贫瘠之地一带的草药上收集8份根须样本。‡在北貧瘠之地收集8個根鬚樣本。',
  }
},
[867] = {
  {
    'As harpias bandoleiras‡Гарпии-налетчицы‡Räuberische Harpyien‡하피의 습격‡Arpías saqueadoras‡Arpías saqueadoras‡Les harpies pillardes‡鹰身强盗‡鷹身劫掠者',
    nil,
    'Colete 6 Garras de Asabruxa de Harpias Asabruxa.‡Соберите 6 когтей гарпий из стаи Зачарованного Крыла.‡Sammelt 6 Krallen der Hexenschwingen von den Harpyien der Hexenschwingen.‡칼날바람 하피를 처치해 칼날바람 하피의 갈퀴발톱 6개를 모아야 합니다.‡Reúne 6 garras de Alabruja de arpías Alabruja.‡Reúne 6 garras de Alabruja de arpías Alabruja.‡Prélevez 6 Griffes d’Ensorçaile sur des Harpies et des Volplumes ensorçaile.‡从巫翼鹰身人身上收集6只巫翼鹰身人的爪子。‡從巫翼鷹身人身上收集6只巫翼鷹身人的爪子。',
  }
},
[868] = {
  {
    'Ovo tipo extra‡Охота за яйцами‡Eierjagd‡알 사냥‡¡A cazar huevos!‡¡A cazar huevos!‡La chasse aux œufs‡蝎卵‡獵蛋任務',
    nil,
    'Obtenha 12 Ovos de Silitídeo e devolva a Garra de Escavação para Korran na Encruzilhada.‡Принесите 12 яиц силитидов и вспарывающий коготь Коррану в Перекресток.‡Bringt Korran beim Wegekreuz 12 Silithideneier und die Gräberklaue.‡십자로에 있는 코란에게 실리시드의 알 12개와 발굴용 갈퀴를 가져가야 합니다.‡Llévale 12 huevos de silítido y la garra de excavación a Korran en El Cruce.‡Llévale 12 huevos de silítido y la garra de excavación a Korran en El Cruce.‡Apporter 12 Œufs de silithide et la Griffe d\'excavation à Korran, à la Croisée.‡把12枚异种蝎卵和掘地爪交给十字路口的科兰。‡把12枚異種蟲蛋和掘地爪交給十字路口的科蘭。',
  }
},
[869] = {
  {
    'Na cola dos larápios‡Выследить вора‡Wie man einen Dieb aufspürt‡도둑 추적‡El rastro del ladrón‡El rastro del ladrón‡Sur la piste du voleur‡追踪窃贼‡跟蹤竊賊',
    nil,
    'Os rastros levam para o lado leste do Morro dos Espinhos. Siga-os e tente descobrir alguma coisa.‡Следы ведут к восточной стороне Тернистого холма. Идите по ним и вы все поймете.‡Die Fährte führt zur Ostseite vom Dornenhügel. Folgt ihr und schaut, was sich herausfinden lässt.‡발자국이 가시덩굴 언덕의 동쪽으로 이어져 있습니다. 그 발자국을 따라가서 무엇을 찾을 수 있는지 알아내야 합니다.‡Las huellas llevan al lado este de Colina Espinosa. Síguelas para ver si encuentras algo.‡Las huellas llevan al lado este de Colina Espinosa. Síguelas para ver si encuentras algo.‡Les empreintes mènent du côté est de la Colline des Épines. Suivez-les et voyez si vous pouvez découvrir quelque chose.‡脚印一路延伸到了荆棘岭的东侧。跟着这串脚印，看看你能找到些什么。‡足跡通往荊棘嶺的東邊。跟著足跡走，看看你會找到什麼。',
  }
},
[870] = {
  {
    'Os Charcos Esquecidos‡Забытые пруды‡Die Vergessenen Teiche‡잊혀진 웅덩이‡Las Charcas del Olvido‡Las Charcas del Olvido‡Les bassins Oubliés‡遗忘之池‡遺忘之池',
    nil,
    'Examine o fundo dos Charcos Esquecidos a noroeste da Encruzilhada.‡Обследуйте дно Забытых прудов к северо-западу от Перекрестка.‡Sucht den Grund der Vergessenen Teiche nordwestlich des Wegekreuzes ab.‡십자로 북서쪽에 있는 잊혀진 웅덩이 바닥을 수색해야 합니다.‡Busca en Las Charcas del Olvido, al noroeste de El Cruce.‡Busca en Las Charcas del Olvido, al noroeste de El Cruce.‡Fouillez le fond des Bassins Oubliés au nord-ouest de la Croisée.‡搜索十字路口西北的遗忘之池的底部。‡搜查十字路口西北邊的遺忘之池的底部。',
  }
},
[871] = {
  {
    'Em defesa do Posto Remoto‡Защита Дальней заставы‡Die Verteidigung der Fernwacht‡서슬갈기 방어 작전‡Defender la Avanzada del Puente‡Defender la Avanzada del Puente‡La défense du poste de Guet-Lointain‡保卫前沿哨所‡保衛前沿哨所',
    nil,
    'Mate 8 Ladravazes Crinavalha e 3 Caçadores Crinavalha.‡Убейте 8 водоискателей и 3 охотника племени Иглогривых.‡Tötet 8 Brandschatzer der Klingenmähnen und 3 Jäger der Klingenmähnen‡서슬갈기 약탈자 8마리, 서슬갈기 사냥꾼 3마리를 처치해야 합니다.‡Mata a 8 desvalijadores y a 3 cazadores de la tribu Crines de Acero.‡Mata a 8 desvalijadores y a 3 cazadores de la tribu Crines de Acero.‡Dans la tribu Tranchecrin, tuez 8 Pilleurs et 3 Chasseurs.‡杀死8名钢鬃掠夺者和3名钢鬃猎手。‡殺掉8個剃鬃盜掠者和3個剃鬃獵手。',
  }
},
[872] = {
  {
    'A ofensiva do Posto Remoto‡Конец бесчинствам‡Der Angriff der Fernwacht‡서슬갈기 공격 작전‡La ofensiva de Avanzada del Puente‡La ofensiva de Avanzada del Puente‡L\'offensive du poste de Guet-Lointain‡前沿哨所的进攻‡前沿哨所進攻部隊',
    nil,
    'Mate 5 Defensores Crinavalha, 5 Tecespinhos Crinavalha e Kreenig Rosnento. Pegue a Presa de Kreenig Rosnento.‡Убейте 5 защитников и 5 терноплетов из племени Иглогривых, одолейте Кринига Грознорыла и возьмите его клык.‡Tötet 5 Verteidiger der Klingenmähnen, 5 Dornenwirker der Klingenmähnen und Kreenig Grantelschnauze. Nehmt Kreenig Grantelschnauzes Hauer an Euch.‡서슬갈기 가시마술사 5명과 서슬갈기 파수병 5명, 크리니그 스날스나웃을 처치해야 합니다. 그 후 증거로 크리니그 스날스나웃의 엄니를 가져가야 합니다.‡Mata a 5 defensores Crines de Acero, a 5 tejespinas Crines de Acero y a Kreenig Gruñucico. Consigue el colmillo de Gruñucico.‡Mata a 5 defensores Crines de Acero, a 5 tejespinas Crines de Acero y a Kreenig Gruñucico. Consigue el colmillo de Gruñucico.‡Tuez 5 Défenseurs et 5 Tisseuses d\'épines tranchecrin. Tuez aussi Kreenig Grondegroin et prenez-lui sa Défense.‡杀掉5名钢鬃防御者、5名钢鬃织棘者，以及克里尼格·糟鼻。拿到糟鼻的獠牙。‡殺掉5個剃鬃防衛者，5個剃鬃織棘者，以及克里尼格·糟鼻。|n|n取走克里尼格·糟鼻的獠牙。',
  }
},
[873] = {
  {
    'Isha Awak‡Иша Авак‡Isha Awak‡이샤 아와크‡Isha Awak‡Isha Awak‡Isha Awak‡依沙瓦克‡依沙瓦克',
    nil,
    'Leve o Coração de Isha Awak para Mahren Vidente do Céu.‡Принесите сердце Иши Авака Марен Небесной Провидице.‡Bringt Mahren Himmelsdeuter das Herz von Isha Awak.‡마렌 스카이시어에게 이샤 아와크의 심장을 가져가야 합니다.‡Llévale el corazón de Isha Awak a Mahren Vidente del Cielo.‡Llévale el corazón de Isha Awak a Mahren Vidente del Cielo.‡Apportez le Cœur d\'Isha Awak à Mahren Oeil-des-cieux.‡把依沙瓦克的心脏交给玛伦·星眼。‡把依沙瓦克的心臟交給瑪倫·星眼。',
  }
},
[874] = {
  {
    'Mahren Vidente do Céu‡Марен Небесная Провидица‡Mahren Himmelsdeuter‡마렌 스카이시어‡Mahren Vidente del Cielo‡Mahren Vidente del Cielo‡Mahren Œil-des-cieux‡玛伦·星眼‡瑪倫·星眼',
    nil,
    'Fale com Mahren Vidente do Céu.‡Поговорите с Марен Небесной Провидицей.‡Sprecht mit Mahren Himmelsdeuter.‡마렌 스카이시어와 대화해야 합니다.‡Habla con Mahren Vidente del Cielo.‡Habla con Mahren Vidente del Cielo.‡Parler à Mahren Oeil-des-cieux.‡和玛伦·星眼谈一谈。‡和瑪倫·星眼談話。',
  }
},
[875] = {
  {
    'Tenentes harpias‡Лейтенанты гарпий‡Offiziere der Harpyien‡하피 부대장‡Las tenientes arpías‡Las tenientes arpías‡Lieutenants harpies‡鹰身人首领‡鷹身人副官',
    nil,
    'Mate 6 Asabruxa Matadoras nos Montes Áridos, que ficam nos Sertões Setentrionais.‡Убейте 6 душегубок из стаи Зачарованного Крыла на Сухих холмах, что в Северных Степях.‡Tötet 6 Töterinnen der Hexenschwingen in den Trockenen Hügeln im Nördlichen Brachland.‡북부 불모의 땅의 메마른 언덕에서 칼날바람 암살자 6마리를 처치해야 합니다.‡Reúne 6 anillos de tenientes arpías de las destripadoras Alabruja en Los Baldíos del Norte.‡Reúne 6 anillos de tenientes arpías de las destripadoras Alabruja en Los Baldíos del Norte.‡Tuez 6 Tueuses ensorçaile dans les Collines Arides, dans les Tarides du Nord.‡在北贫瘠之地的无水岭消灭6只巫翼杀戮者。‡殺死北貧瘠之地位於無水嶺的6隻巫翼殺戮者。',
  }
},
[876] = {
  {
    'Serena Plumassangue‡Серена Кровавое Перо‡Serena Blutfeder‡붉은깃털 세레나‡Serena Sangrepluma‡Serena Sangrepluma‡Serena Plumesang‡塞瑞娜·血羽‡塞瑞娜‧血羽',
    nil,
    'Mate Serena Plumassangue e arranque a cabeça dela.‡Убейте Серену Кровавое Перо и отрубите ей голову.‡Erschlagt Serena Blutfeder und nehmt ihren Kopf an Euch.‡붉은깃털 세레나를 처치하고 그 증거로 그녀의 머리카락을 수집해야 합니다.‡Mata a Serena Sangrepluma y hazte con su cabeza.‡Mata a Serena Sangrepluma y hazte con su cabeza.‡Tuez Serena Plumesang et prenez sa tête.‡杀掉塞瑞娜·血羽，获得她的徽记。‡殺掉塞瑞娜‧血羽並取得她的頭顱。',
  }
},
[877] = {
  {
    'O Oásis Estagnado‡Застывший оазис‡Die Brackige Oase‡죽은 오아시스‡El Oasis Estancado‡El Oasis Estancado‡L\'oasis Stagnante‡死水绿洲‡死水綠洲',
    nil,
    'Use as Sementes Secas para investigar as fissuras do Oásis Estagnado.‡Проведите эксперимент с семенами в Застывшем оазисе.‡Benutzt die Samenkörner, um die Risse in der Brackigen Oase zu untersuchen.‡말라버린 씨앗을 사용해 죽은 오아시스에 있는 균열을 조사해야 합니다.‡Usa las semillas secas para investigar las fisuras en el Oasis Estancado.‡Usa las semillas secas para investigar las fisuras en el Oasis Estancado.‡Utilisez les graines séchées pour enquêter sur les fissures, à l\'Oasis Stagnante.‡使用干枯的种子调查死水绿洲底部的裂隙。‡使用乾枯的種子調查死水綠洲的裂隙。',
  }
},
[878] = {
  {
    'Tribos em guerra‡Воюющие племена‡Stämme im Krieg‡부족 간의 전쟁‡Tribus en guerra‡Tribus en guerra‡Tribus en guerre‡野猪人的内战‡野豬人的內戰',
    nil,
    'Mate 6 Rabdomantes Costagulha, 12 Tecespinhos Costagulha e 12 Geomantes Costagulha e fale novamente com Denterroto no Acampamento Taurajo, nos Sertões.‡Убейте 6 водоискателей, 12 терноплетов и 12 геомантов из племени Дыбогривов и возвращайтесь к Кривозубу в Лагерь Таурахо в Степях.‡Erledigt 6 Wassersucher der Borstennacken, 12 Dornenwirker der Borstennacken sowie 12 Geomanten der Borstennacken und kehrt zu Quetschzahn im Camp Taurajo im Brachland zurück.‡뾰족털 일족의 풍수사 6명, 가시마술사 12명, 흙점쟁이 12명을 처치해야 합니다. 임무를 완수한 후 불모의 땅, 타우라조 야영지에 있는 뻐드렁니에게 돌아가십시오.‡Mata a 6 buscaquas Erizapúas, 12 tejespinas Erizapúas y 12 geománticas Erizapúas y vuelve junto a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Mata a 6 buscaquas Erizapúas, 12 tejespinas Erizapúas y 12 geománticas Erizapúas y vuelve junto a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Tuer 6 Sourciers Dos-hirsute, 12 Tisseurs d\'épines Dos-hirsute et 12 Géomanciennes Dos-hirsute puis retourner auprès de Mutiledent au camp Taurajo dans les Tarides.‡杀掉6个刺背寻水者、12个刺背织棘者和12个刺背地卜师，然后到陶拉祖营地的碎牙那里复命。‡殺掉6個刺背尋水者、12個刺背織棘者和12個刺背地卜師，然後到陶拉祖營地的碎牙那裡覆命。',
  }
},
[879] = {
  {
    'Traição fatal‡Предатель в наших рядах‡Verräter in den eigenen Reihen‡내부의 배반자‡Traidores‡Traidores‡Une trahison de l\'intérieur‡内奸‡內奸',
    nil,
    'Mate Nak, Kâz e Lok Mataorc e leve o crânio deles para Denterroto no Acampamento Taurajo, que fica nos Sertões.‡Убейте Нака, Куза и Лока Оркобоя и принесите их черепа Кривозубу в Лагерь Таурахо в Степях.‡Tötet Nak, Kuz und Lok Orcfluch und bringt Quetschzahn im Camp Taurajo im Brachland ihre Schädel.‡나크와 쿠즈, 로크를 처단하여 그들의 해골을 불모의 땅의 타우라조 야영지에 있는 뻐드렁니에게 가져가야 합니다.‡Mata a Nak, Kuz y Lok Aterraorcos y lleva sus calaveras a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Mata a Nak, Kuz y Lok Aterraorcos y lleva sus calaveras a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Tuer Nak, Kuz et Lok Plaie-des-orcs et apporter leurs crânes à Mutiledent au Camp Taurajo dans les Tarides.‡杀掉纳克、卡兹和洛克·奥克班恩，把它们的徽记交给陶拉祖营地的碎牙。‡殺掉納克、卡茲和洛克·奧克班恩，把它們的顱骨交給陶拉祖營地的碎牙。',
  }
},
[880] = {
  {
    'Seres alterados‡Измененные существа‡Veränderte Wesen‡변화된 생물‡Seres alterados‡Seres alterados‡Source de vie‡变异的生物‡變異的生物',
    nil,
    'Colete 6 Cascos Alterados de Mordelisca, das Mordeliscas do Oásis Estagnado.‡Принесите 6 измененных панцирей хрустогрызов, обитающих в Застывшем оазисе.‡Sammelt 6 Schnappkieferpanzer von den Schnappkiefern in der Brackigen Oase.‡죽은 오아시스에서 변형된 무쇠턱거북 등껍질 6개를 수집해야 합니다.‡Reúne 6 caparazones de quijafortes alterados de los quijafortes de El Oasis Estancado.‡Reúne 6 caparazones de quijafortes alterados de los quijafortes de El Oasis Estancado.‡Prélevez 6 Carapaces de Gueules d\'acier altérées sur des Gueules d’acier de l’Oasis Stagnante.‡从死水绿洲的钳嘴龟那里收集6块变异的钳嘴龟壳。‡從死水綠洲的鉗嘴龜那裡收集6塊變異的鉗嘴龜殼。',
  }
},
[881] = {
  {
    'Echeyaki‡Ичияки‡Echeyakee‡에체야키‡Echeyakee‡Echeyakee‡Echeyakee‡埃其亚基‡埃其亞基',
    nil,
    'Sopre o berrante no covil de Echeyaki para evocá-lo. Subjugue-o ou mate-o.‡Подуйте в рог возле логова Ичияки, убейте его или подчините.‡Blast das Horn bei Echeyakees Unterschlupf, um ihn herbeizurufen. Tötet oder zähmt ihn.‡에체야키의 소굴에서 뿔피리를 불어 에체야키를 불러내 처치 또는 제압해야 합니다.‡Toca el cuerno en la guarida de Echeyakee para invocarlo. Mátalo o subyúgalo.‡Toca el cuerno en la guarida de Echeyakee para invocarlo. Mátalo o subyúgalo.‡Soufflez dans votre cor devant le repaire d\'Echekayee pour le faire apparaître. Tuez-le ou dominez-le.‡在埃其亚基的巢穴外吹响号角，然后杀死或制服它。‡在埃其亞基的巢穴吹響號角來召喚牠。殺死牠或讓牠屈服。',
  }
},
[882] = {
  {
    'Ishamuhale‡Ишамухал‡Ishamuhale‡이샤무헤일‡Ishamuhale‡Ishamuhale‡Ishamuhale‡伊沙姆哈尔‡伊沙姆哈爾',
    nil,
    'Leve a Presa de Ishamuhale para Jorn no Acampamento Taurajo.‡Принесите клык Ишамухала Джорну Искателю Неба в Лагерь Таурахо.‡Bringt Jorn Himmelsdeuter im Camp Taurajo Ishamuhales Fangzahn.‡타우라조 야영지에 있는 조른 스카이시어에게 이샤무헤일의 송곳니를 가져가야 합니다.‡Llévale el colmillo de Ishamuhale a Jorn en el Campamento Taurajo.‡Llévale el colmillo de Ishamuhale a Jorn en el Campamento Taurajo.‡Apporter le Croc d\'Ishamuhale à Jorn au Camp Taurajo.‡把伊沙姆哈尔的牙齿交给陶拉祖营地的乔恩。‡把伊沙姆哈爾的牙齒交給陶拉祖營地的喬恩。',
  }
},
[883] = {
  {
    'Lakota\'mani‡Лакота\'мани‡Lakota\'mani‡라코타마니‡Lakota\'mani‡Lakota\'mani‡Lakota\'mani‡拉克塔曼尼‡拉克塔曼尼',
    nil,
    'Leve o Casco de Lakota\'mani para Jorn no Acampamento Taurajo.‡Принесите копыто Лакота\'мани Джорну в Лагерь Таурахо.‡Bringt Jorn Himmelsdeuter im Camp Taurajo Lakota\'manis Huf.‡타우라조 야영지에 있는 조른 스카이시어에게 라코타마니의 발굽을 가져가야 합니다.‡Llévale la pezuña de Lakota\'mani a Jorn en el Campamento Taurajo.‡Llévale la pezuña de Lakota\'mani a Jorn en el Campamento Taurajo.‡Apportez le Sabot de Lakota\'mani à Jorn au Camp Taurajo.‡把拉克塔曼尼的蹄子交给陶拉祖营地的乔恩。‡把拉克塔曼尼的蹄子交給陶拉祖營地的喬恩。',
  }
},
[884] = {
  {
    'Owatanka‡Оватанка‡Owatanka‡오와탄카‡Owatanka‡Owatanka‡Owatanka‡奥瓦坦卡‡奧瓦坦卡',
    nil,
    'Leve a Ponta da Cauda de Owatanka para Jorn no Acampamento Taurajo.‡Принесите хвостовой зубец Оватанки Джорну Искателю Неба в Лагерь Таурахо.‡Bringt Jorn Himmelsdeuter im Camp Taurajo Owatankas Schwanzstachel.‡타우라조 야영지에 있는 조른 스카이시어에게 오와탄카의 꼬리가시를 가져가야 합니다.‡Llévale la punta de cola de Owatanka a Jorn en el Campamento Taurajo.‡Llévale la espina caudal de Owatanka a Jorn en el Campamento Taurajo.‡Apporter l\'Epine caudale d\'Owatanka à Jorn au Camp Taurajo.‡把奥瓦坦卡的尾刺交给陶拉祖营地的乔恩。‡把奧瓦坦卡的尾刺交給陶拉祖營地的喬恩。',
  }
},
[885] = {
  {
    '‡‡‡‡‡‡‡瓦希塔帕恩‡',
    nil,
    '‡Отнесите перо Ваште Пауни Джорну Заклинателю Небес в Лагерь Таурахо.‡Bringt Jorn Himmelsdeuter im Camp Taurajo Washte Pawnes Feder.‡‡Llévale la pluma de Washte Pawne a Jorn Vidente del Cielo en el Campamento Taurajo.‡Llévale la pluma de Washte Pawne a Jorn Vidente del Cielo en el Campamento Taurajo.‡Apportez la Plume de Washte Pawne à Jorn Oeil-des-cieux au Camp Taurajo.‡把瓦希塔帕恩的羽毛交给陶拉祖营地的乔恩·星眼。‡',
  }
},
[886] = {
  {
    'Oásis nos Sertões‡Оазисы Степей‡Die Oasen des Brachlandes‡불모의 땅 오아시스‡El oasis de Los Baldíos‡El oasis de Los Baldíos‡Les oasis des Tarides‡贫瘠之地的绿洲‡貧瘠之地的綠洲',
    nil,
    'Speak with Tonga Runetotem at the Crossroads.‡Поговорите на Перекрестке с Тонгой Руническим Тотемом.‡Sprecht beim Wegekreuz mit Tonga Runentotem.‡십자로에 있는 통가 룬토템과 대화해야 합니다.‡Habla con Tonga Tótem de Runa en El Cruce.‡Habla con Tonga Tótem de Runa en El Cruce.‡Parler à Tonga Totem-runique à la Croisée.‡和十字路口的图加·符文图腾谈一谈。‡和十字路口的圖加·符文圖騰談話。',
  }
},
[887] = {
  {
    'Os Flibusteiros dos Mares do Sul‡Флибустьеры Южных морей‡Südmeerfreibeuter‡남쪽바다 해적단‡Los filibusteros de los Mares del Sur‡Los filibusteros de los Mares del Sur‡Les flibustiers des mers du Sud‡南海海盗‡南海掠劫者',
    nil,
    'Mate 8 Degoladores ou Corsários dos Mares do Sul na Ilha da Peleja.‡Убейте 8 головорезов или каперов Южных морей на Острове Битв.‡Tötet 8 Halsabschneider oder Kaperer der Südmeerfreibeuter auf Prügeleiland.‡격투의 섬에서 남쪽바다 자객 또는 남쪽바다 선원 8명을 처치해야 합니다.‡Mata a 8 degolladores o corsarios de los Mares del Sur en Isla de Batalla.‡Mata a 8 degolladores o corsarios de los Mares del Sur en Isla de Batalla.‡Tuez 8 Coupe-gorge ou Corsaires des mers du Sud sur l’Île de la Dispute.‡在勇士岛上杀死8个南海杀手或南海私掠者。‡在勇士島上殺死8位南海殺手或南海私掠者。',
  }
},
[888] = {
  {
    '[DEPRICATED]Stolen Booty‡[DEPRECATED]Украденное добро‡Gestohlene Beute‡[미사용]도난당한 전리품‡[DEPRICATED] El botín robado‡[DEPRICATED] El botín robado‡[PÉRIMÉ]Course à la lentille‡[DEPRECATED] 被窃的货物‡[DEPRICATED]被竊的貨物',
    nil,
    'Recupere o Carregamento de Botas e a Lente Telescópica para Gasganete na Vila Catraca.‡Верните Газлоу из Кабестана посылку с сапогами и линзу от телескопа.‡Bringt Gazlowe in Ratschet die Stiefellieferung und die Teleskoplinse zurück.‡톱니항에 있는 가즈로를 위해 장화가 든 뱃짐과 망원경 렌즈를 회수해야 합니다.‡Recupera el envío de botas y las lentes telescópicas a Gazlowe en Trinquete.‡Recupera el envío de botas y las lentes telescópicas a Gazlowe en Trinquete.‡Retrouver la Cargaison de bottes et la Lentille de télescope pour Gazleu de Cabestan.‡帮棘齿城的加兹鲁维取回一箱靴子以及一块望远镜片。‡幫棘齒城的加茲魯維取回一箱靴子以及一塊望遠鏡片。',
  }
},
[889] = {
  {
    '‡Дух Ветра‡Geist des Windes‡‡El espíritu del viento‡El espíritu del viento‡L\'esprit du vent‡风之魂‡',
    nil,
    nil,
  }
},
[890] = {
  {
    '[DEPRECATED]The Missing Shipment‡[DEPRECATED]Пропавший груз‡Die verloren gegangene Lieferung‡[미사용]사라진 뱃짐‡[DEPRECATED] El envío perdido‡[DEPRECATED] El envío perdido‡[PÉRIMÉ]La livraison perdue‡‡',
    nil,
    'Leve o Livro-caixa do Gasganete para o Mestre Portuário Caruncho.‡Отнесите учетную книжку Газлоу управляющему пристанью Головокружилкинсу.‡Bringt Werftmeister Flunkerblick Gazlowes Geschäftsbuch.‡부두주임 디지위그에게 가즈로의 장부를 가져가야 합니다.‡Llévale el libro de contabilidad de Gazlowe al maestro de muelles Vertipeluca.‡Llévale el libro de contabilidad de Gazlowe al maestro de muelles Vertipeluca.‡Apporter le Grand Livre de Gazleu au Maître des quais Tournoupette.‡‡',
  }
},
[891] = {
  {
    'A vingança do capitão‡Месть капитана‡Die Rache des Kapitäns‡선장의 복수‡La venganza de un capitán‡La venganza de un capitán‡La vengeance d\'un capitaine‡船长的复仇‡船長的復仇',
    nil,
    'Colete 10 Medalhas dos Fuzileiros e Grumetes de Theramore. Mate os Tenentes Pyra e Buckland.‡Соберите 10 тераморских медалей матросов и стражей бухты, а также убейте лейтенантов Пира и Бакланда.‡Sammelt 10 Medaillen von Theramore von Theramore Marinesoldaten und Matrosen. Tötet die Leutnants Pyre und Buckland.‡테라모어 해병과 갑판원을 처치해 테라모어 휘장 10개를 모으고 부관 파이어와 벅랜드를 처치해야 합니다.‡Consigue 10 medallas de Theramore de marinos de Theramore y marineros de cubierta de Theramore. Mata a los tenientes Pira y Terraciervo.‡Consigue 10 medallas de Theramore de marinos de Theramore y marineros de cubierta de Theramore. Mata a los tenientes Pira y Terraciervo.‡Récupérez 10 Médailles de Theramore sur le cadavre de Soldats de marine et de Matelots de pont de Theramore. Tuez aussi les lieutenants Pyre et Buckland.‡从塞拉摩水兵和码头守卫那里收集10枚塞拉摩徽章。杀掉培里中尉和布克兰德中尉。‡從塞拉摩水兵和水手身上收集10枚塞拉摩徽章，殺死皮瑞中尉和巴克蘭中尉。',
  }
},
[892] = {
  {
    '[DEPRECATED]The Missing Shipment‡[DEPRECATED]Пропавший груз‡Die verloren gegangene Lieferung‡[미사용]사라진 뱃짐‡[DEPRECATED] El envío perdido‡[DEPRECATED] El envío perdido‡[PÉRIMÉ]La livraison perdue‡[DEPRECATED] 丢失的货物‡[DEPRECATED]丟失的貨物',
    nil,
    'Leve o Livro-caixa do Gasganete para o Gasganete na Vila Catraca.‡Верните Газлоу из Кабестана его регистр.‡Bringt Gazlowe in Ratschet sein Geschäftsbuch zurück.‡톱니항에 있는 가즈로에게 가즈로의 장부를 돌려줘야 합니다.‡Llévale el libro de contabilidad de Gazlowe a Gazlowe en Trinquete.‡Llévale el libro de contabilidad de Gazlowe a Gazlowe en Trinquete.‡Rapporter le Grand Livre de Gazleu à Gazleu à Cabestan.‡把加兹鲁维的账本交还给棘齿城的加兹鲁维。‡把加茲魯維的帳本交還給棘齒城的加茲魯維。',
  }
},
[893] = {
  {
    'Armas preferidas‡Предпочитаемое оружие‡Ausgewählte Waffen‡최고의 무기‡Una selección de armas‡Una selección de armas‡Des armes de choix‡野猪人的武器‡選擇武器',
    nil,
    'Leve um Punhal Crinavalha, uma Varinha de Crinavalha Carbonizada e um Escudo de Guerra Crinavalha ao Trapista Forjaço no Acampamento Taurajo, que fica nos Sertões.‡Принесите стилет Иглогривых, обгоревший жезл Иглогривых и боевой щит Иглогривых Таттернаку Стальному Горну в Лагерь Таурахо в Степях.‡Bringt Tatternack Stahlformer im Camp Taurajo im Brachland einen Klingenmähnenrückenstecher, einen verkohlten Klingenmähnenzauberstab und einen Klingenmähnenkriegsschild.‡불모의 땅, 타우라조 야영지에 있는 테터낵 스틸포지에게 서슬갈기 기습용 단검, 불타는 마법봉, 전투용 방패를 가져가야 합니다.‡Llévale 1 puñal Crines de Acero, 1 varita Crines de Acero carbonizada y 1 escudo de guerra Crines de Acero a Jironack Forjacero en Campamento Taurajo en Los Baldíos.‡Llévale 1 puñal Crines de Acero, 1 varita Crines de Acero carbonizada y 1 escudo de guerra Crines de Acero a Jironack Forjacero en Campamento Taurajo en Los Baldíos.‡Apporter un Eustache tranchecrin, une Baguette tranchecrin carbonisée et un Bouclier tranchecrin à Tatternack Forgacier au camp Taurajo dans les Tarides.‡给陶拉祖营地的塔特纳克·钢炉带去一把钢鬃背刺匕首、一根烧焦的钢鬃魔杖和一面钢鬃大盾。‡給陶拉祖營地的塔特納克·鋼爐帶去一把鋼鬃背刺匕首、一根燒焦的鋼鬃魔杖和一面鋼鬃大盾。',
  }
},
[894] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡負載平衡器',
    nil,
    'Acesse o Painel de Controle no laboratório da Empreendimentos S.A.‡Получите доступ к терминалу в исследовательском центре Торговой Компании.‡Verschafft Euch Zugang zur Steuerkonsole in der Forschungseinrichtung der Venture Company.‡투자개발회사 연구 시설의 제어장치에 가야 합니다.‡Accede a la consola de control del laboratorio de investigación de Ventura y Cía.‡Accede a la consola de control del laboratorio de investigación de Ventura y Cía.‡Accéder à la Console de contrôle au Centre de recherches de la KapitalRisk.‡在风险投资公司研究基地里找到控制台。‡在風險投資公司研究基地裡找到控制臺。',
  }
},
[895] = {
  {
    'Procura-se: Capitão Garvão‡РАЗЫСКИВАЕТСЯ: Капитан Шпрота‡GESUCHT: Käpt\'n Garvey‡가비 선장 현상 수배‡SE BUSCA: Capitán Garvey‡SE BUSCA: Capitán Garvey‡ON RECHERCHE : cap\'taine Garvey‡通缉：嘉维伊船长‡懸賞:葛瑞威船長',
    nil,
    'Leve a cabeça do Capitão Garvão a Gasganete na Vila Catraca.‡Принесите Газлоу в Кабестан голову барона капитана Шпроты.‡Bringt Gazlowe in Ratschet Käpt\'n Garveys Kopf.‡가비 선장의 머리카락을 톱니항에 있는 가즈로에게 가져가야 합니다.‡Llévale la cabeza del capitán Garvey a Gazlowe en Trinquete.‡Llévale la cabeza del capitán Garvey a Gazlowe en Trinquete.‡Apportez la tête du Cap\'taine Garvey à Gazleu à Cabestan.‡把嘉维伊船长的徽记带给棘齿城的加兹鲁维。‡把葛瑞威船長的頭顱帶去棘齒城交給加茲魯維。',
  }
},
[896] = {
  {
    'A fortuna do mineiro‡Удача шахтера‡Des Minenarbeiters Vermögen‡광부의 보석‡La fortuna de un minero‡La fortuna de un minero‡La bonne fortune d\'un mineur pauvre‡矿工的宝贝‡礦工的寶貝',
    nil,
    'Consiga a Esmeralda Olho-de-gato de um dos feitores ou seguranças da Empreendimentos S.A.‡Заберите изумруд "Кошачий глаз" у одного из надзирателей или головорезов Торговой Компании.‡Erhaltet den Katzenaugensmaragd von einem der Vorarbeiter oder Vollstrecker der Venture Co.‡투자개발회사 감독이나 투자개발회사 집행자로부터 고양이눈 에메랄드를 구해야 합니다.‡Recupera la esmeralda ojo de gato de un sobrestante o un déspota de Ventura y Cía.‡Recupera la esmeralda ojo de gato de un sobrestante o un déspota de Ventura y Cía.‡Récupérez l\'Émeraude œil-de-chat sur l\'un des Surveillants ou l\'un des Massacreurs de la KapitalRisk.‡从风险投资公司的某个监督或者执行者那里夺取猫眼翡翠。‡從風險投資公司的某個監督者或者執行者那裡奪取貓眼翡翠。',
  }
},
[897] = {
  {
    '‡Жнец‡Der Ernter‡‡El Cosechador‡El Cosechador‡Le Moissonneur‡收割者‡',
    nil,
    '‡Принесите голову Жнеца Джорну Заклинателю Небес.‡Bringt den Ernterkopf zu Jorn Himmelsdeuter.‡‡Llévale la cabeza del Cosechador a Jorn Vidente del Cielo.‡Llévale la cabeza del Cosechador a Jorn Vidente del Cielo.‡Apportez la Tête du Moissonneur à Jorn Oeil-des-cieux.‡把收割者的头颅交给乔恩·星眼。‡',
  }
},
[898] = {
  {
    'Ex-detento‡Свобода!‡Aus der Gefangenschaft befreit‡요새 탈출‡Escapar del fuerte‡Escapar del fuerte‡Hors du fort‡逃离监牢‡逃離監牢',
    nil,
    'Escolte Gilthares Galhareda em segurança até o Capitão Solaz, que está na Vila Catraca.‡Проводите Гилтареса Огненный Цветок к капитану Сияющему в Кабестан.‡Begleitet Gilthares Feuerzweig sicher zurück zu Kapitän Blendsonn in Ratschet.‡길사레즈 파이어바우를 톱니항에 있는 브라이트썬 선장에게 데려가야 합니다.‡Escolta a Gilthares Ramafuego de vuelta hasta Trinquete con el Capitán Solbrillante.‡Escolta a Gilthares Ramafuego de vuelta hasta Trinquete con el Capitán Solbrillante.‡Escorter en toute sécurité Gilthares Ramefeu jusqu\'au capitaine Brillesoleil à Cabestan.‡护送基尔萨瑞斯·火枝安全地返回棘齿城的沙罗萨斯船长那里。‡護送基爾薩瑞斯·火枝安全地返回棘齒城的沙羅薩斯船長那裡。',
  }
},
[899] = {
  {
    'Consumido pelo ódio‡Огонь ненависти‡Von Hass zerfressen‡타오르는 증오‡Consumido por el odio‡Consumido por el odio‡Consumé par la haine‡复仇的怒火‡復仇的怒火',
    nil,
    'Colete 30 Presas de Javatusco.‡Соберите 30 клыков свинобразов.‡Sammelt 30 Stacheleberhauer‡가시멧돼지 엄니 30개를 수집해야 합니다.‡Reúne 30 colmillos de jabaespín.‡Reúne 30 colmillos de jabaespín.‡Obtenez 30 Défenses de huran.‡收集30根刺背野猪人的獠牙。‡收集60根刺背野豬人的獠牙，把它們交給十字路口的曼寇里克。',
  }
},
[900] = {
  {
    '‡Самофланж‡Samophlang‡사모플랜지‡Churumbele‡Churumbele‡‡主动式负载平衡器‡主動式負載平衡器',
    nil,
    '‡Закройте топливный распределительный клапан, перепускной клапан и главный клапан управления, а потом снова попытайтесь воспользоваться панелью управления.‡Schließt das Treibstoffzufuhrventil, das Regelventil und das Hauptsteuerventil, und benutzt dann noch einmal die Steuerkonsole.‡연료 제어 밸브, 압력 조절 밸브, 주제어 밸브를 잠근 다음 제어장치를 다시 작동시켜야 합니다.‡Cierra la válvula de control de combustible, la válvula reguladora y la válvula de control principal y usa entonces de nuevo la consola de control.‡Cierra la válvula de control de combustible, la válvula reguladora y la válvula de control principal y usa entonces de nuevo la consola de control.‡Fermez la Valve de contrôle du carburant, la Valve de réglage et la Valve de contrôle principale, puis utilisez à nouveau la console de contrôle.‡关闭燃油控制阀、调节阀和主控制阀，然后再使用控制台。‡',
  }
},
[901] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡負載平衡器',
    nil,
    'Pegue a Chave do Painel do Engenhoqueiro Faísca.‡Возьмите у ремонтника Угрелова ключ от терминала.‡Besorgt Euch bei Tüftler Kichers den Konsolenschlüssel.‡땜장이 스니글즈에게서 제어장치 열쇠를 구해야 합니다.‡Consigue la llave de la consola de Manitas el Risitas.‡Consigue la llave de la consola de Manitas el Risitas.‡Récupérez la Clé de la console du Bricoleur Brokarde.‡从工匠斯尼格斯那里拿到控制台的钥匙。‡從技工斯尼格斯那裡拿到控制臺鑰匙。',
  }
},
[902] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡負載平衡器',
    nil,
    'Leve a Rebimboca para Cobogó no Acampamento do Macambúzio, que fica nos Sertões Setentrionais.‡Отнесите самофланж Пароклапану в Лагерь Котельника, что в Северных Степях.‡Bringt das Samophlang zu Stotterspritter in Düsentopfs Außenposten im Nördlichen Brachland zurück.‡사모플랜지를 북부 불모의 땅의 노즐팟의 전초기지에 있는 스퍼터밸브에게 가져가야 합니다.‡Llévale el churumbele a Petardol a la Avanzada de Ollaboquilla en Los Baldíos del Norte.‡Llévale el churumbele a Petardol a la Avanzada de Ollaboquilla en Los Baldíos del Norte.‡Rapportez le Samophlange à Krachevalve, à l’Avant-poste de Potuyère, dans les Tarides du Nord.‡把主动式负载平衡器交给北贫瘠之地诺兹波特的哨站的斯布特瓦夫。‡把負載平衡器帶去北貧瘠之地的管壺前哨給斯布特瓦夫。',
  }
},
[903] = {
  {
    'Dia da caça‡Охота на охотниц‡Jagt die Jägerin‡암사자 사냥‡Cazar a las cazadoras‡Cazar a las cazadoras‡La chasse aux chasseresses‡猎杀雌狮‡獵殺雌獅',
    nil,
    'Colete 5 Garras das Caçadoras da Savana.‡Добудьте 5 когтей охотниц саванны.‡Sammelt 5 Klauen der Jägerin von Savannenjägerinnen.‡사바나 암사자를 사냥해 암사자 발톱 5개를 수집해야 합니다.‡Reúne 5 garras de cazadora de las cazadoras de la sabana.‡Reúne 5 garras de cazadora de las cazadoras de la sabana.‡Prélevez 5 Griffes de chasseresse sur des Chasseresses des savanes.‡从雌性草原狮身上收集5只猎手之爪。‡從草原雌獅身上收集5個雌獅的爪子。',
  }
},
[904] = {
