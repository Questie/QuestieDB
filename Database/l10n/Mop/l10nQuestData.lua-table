},
[25018] = {
  {
    'Andoren nos ajudará‡Андорен должен узнать‡Andoren wird es wissen‡안도렌은 알고 있다‡Andoren lo sabrá‡Andoren lo sabrá‡Andoren saura quoi faire‡安多伦会知道‡安多連的覺悟',
    nil,
    'Entregue o artefato para Andoren Alvorada no Vale dos Vigilantes.‡Отнесите артефакт Андорену Восходу Солнца, который находится в долине Стражей.‡Bringt das Artefakt zu Andoren Morgendunst im Tal der Behüter.‡유물을 감시자의 골짜기에 있는 안도렌 돈라이즈에게 가져가야 합니다.‡Entrégale el artefacto a Andoren Alzalba en el Valle de los Vigías.‡Entrégale el artefacto a Andoren Alzalba en el Valle de los Vigías.‡Apportez l’artéfact à Andoren Montelaube, à la vallée des Guetteurs.‡把神器交给观察者之谷的安多伦·晨光。‡將神器帶去守衛之谷給安多連·曦揚。',
  }
},
[25019] = {
  {
    'Eu vi primeiro!‡Предъявить права‡Anspruch erheben‡소유권 주장‡Reivindicar la posesión‡Reivindicar la posesión‡C’est nainporte quoi !‡所有权‡佔取',
    nil,
    'Mate 10 Escavadores da Liga dos Exploradores.‡Убейте 10 дворфов-археологов.‡Tötet 10 Archäologen der Zwerge.‡탐험가 연맹 채굴꾼 10명을 처치해야 합니다.‡Mata a 10 enanos arqueólogos.‡Mata a 10 enanos arqueólogos.‡Tuez 10 Archéologues nains.‡击败10名矮人考古学家。‡殺死10名矮人考古學家。',
  }
},
[25020] = {
  {
    'Fragmentos da linguagem‡Фрагменты языка‡Sprachfragmente‡언어의 조각들‡Fragmentos de lenguaje‡Fragmentos de lenguaje‡Des fragments de langage‡语言的碎片‡斷簡殘片',
    nil,
    'Consiga 5 Hieroglifos Antigos.‡Соберите 5 древних иероглифов.‡Sammelt 5 uralte Hieroglyphen.‡고대의 성각문양 5개를 수집해야 합니다.‡Reúne 5 jeroglíficos antiguos.‡Reúne 5 jeroglíficos antiguos.‡Récupérez 5 Hiéroglyphes anciens.‡收集5份远古符文碑刻。‡收集5個古老的象形文字。',
