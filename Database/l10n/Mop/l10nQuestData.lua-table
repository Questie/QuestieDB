[8399] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Chanteguerres‡自然屏障‡自然屏障',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡將3枚戰歌峽谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
[8400] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Chanteguerres‡自然屏障‡自然屏障',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡將3枚戰歌峽谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
