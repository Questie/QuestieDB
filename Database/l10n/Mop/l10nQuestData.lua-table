[29703] = {
  {
    'Barrel of Monkies‡Бочка обезьян‡Ein Fass voller Affen‡원숭이의 술통‡Una panda de monos‡‡Tonneau, je ne boirai pas de ton eau‡Barrel of Monkies‡',
    nil,
    'Sally Fizzlefury wants you to kill 5 drunken monkies. Uma‡Салли хочет, чтобы вы убили 5 пьяных обезьян.‡Sally Zappenduster möchte, dass Ihr 5 betrunkene Affen tötet.‡샐리 피즐퓨리가 술 취한 원숭이 5마리를 처치해 달라고 했습니다. 레벨 1 유랑도‡Sally Chispira quiere que mates a 5 monos borrachos.‡‡Sally Furiplouf veut que vous éliminiez 5 Singes ivres.‡Sally Fizzlefury wants you to kill 5 drunken monkies.‡',
  }
},
[29704] = {
  {
    'Rastreamento Shokia‡Выслеживание Шокии‡Shokia VERFOLGEN‡쇼키아 추적‡Shokia TRACKING‡‡Suivi Shokia‡夏琪亚追踪‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[29705] = {
  {
    'Invasion of the Bottle Snatchers‡Нашествие расхитителей выпивки‡Invasion der Flaschendiebe‡‡La invasión de los ultramonos‡‡L’invasion des profanateurs de bouteilles‡‡',
    nil,
    'Sally Fizzlefury wants you to recover 5 stolen brewskies from the Brewhunters near the farm in Shen-zin Su. Uma‡Салли просит, чтобы вы отобрали 5 бутылок выпивки у охотников за выпивкой рядом с крестьянским двором в Шэнь-Цзынь Су.‡Sally Zappenduster möchte, dass Ihr 5 Flaschen gestohlenes Himmelsbräu von den Jägern des vergorenen Schatzes in der Nähe des Bauernhofs auf Shen-zin Su zurückerobert.‡‡Sally Fizzlefury wants you to recover 5 stolen brewskies from the Brewhunters near the farm in Shen-zin Su.‡‡Sally Furiplouf veut que vous récupériez 5 Bibines volées par les Chasseurs de bière près de la ferme, à Shen Zin Su.‡‡',
  }
},
[29706] = {
  {
    'Kegplosion‡Взрывочонок‡O\'zapft is!‡‡Kegplosion‡‡Dé-tonneau-ation‡‡',
    nil,
    'Kill 5 Enraged Spirit Walkers before they eat Sally Fizzlefury\'s face. Uma‡Убейте 5 разъяренных служителей духов, пока они не съели лицо Салли Шипяточек.‡Tötet 5 wütende Geistwandler, bevor sie das Gesicht von Sally Zappenduster verspeisen.‡‡Kill 5 Enraged Spirit Walkers before they eat Sally Fizzlefury\'s face.‡‡Tuez 5 Marcheurs des esprits enragés avant qu’ils ne grignotent le visage de Sally Furiplouf.‡‡',
  }
},
