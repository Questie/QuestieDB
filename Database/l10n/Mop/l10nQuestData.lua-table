[24776] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡El levantamiento de los Lanza Negra‡L\'ascension des Sombrelances‡暗矛的崛起‡暗矛中興',
    nil,
    'Fale com Ortezza no Campo de Treinamento Lançanegra.‡Найдите Ортеззой на тренировочной площадке Черного Копья.‡Trefft Ortezza auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 오르테자를 만나야 합니다.‡Reúnete con Ortezza en el Campo de Entrenamiento Lanza Negra.‡Reúnete con Ortezza en el Campo de Entrenamiento Lanza Negra.‡Allez voir Ortezza sur le Terrain d’entraînement des Sombrelances.‡与暗矛训练场中的欧塔扎谈谈。‡在暗矛訓練場和奧泰薩碰面。',
  }
},
[24777] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Dinge schlagen‡기본기: 연타‡A golpe de entrenamiento‡A golpe de entrenamiento‡La base : savoir frapper des trucs‡基础教程：攻击目标‡基本原則:攻擊',
    nil,
    'Destrua 6 Alvos Carrancas.‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다.‡Destruye 6 dianas Tiki.‡Destruye 6 dianas Tiki.‡Détruire 6 Cibles Tiki.‡摧毁6个蒂基面具假人。‡摧毀6個訓練假人。',
  }
},
[24778] = {
  {
    'A arte do caçador‡Искусство охотника‡Die Kunst des Jägers‡사냥꾼의 기술‡Las artes del cazador‡Las artes del cazador‡Les arts du chasseur‡猎人的技艺‡獵人之藝',
    nil,
    'Fale com Ortezza para treinar o Tiro Firme. Use o Tiro Firme 5 vezes em um Alvo Carranca.‡Поговорите с Ортеззой и потренируйтесь в освоении "Верного выстрела". Затем 5 раз сделайте "Верный выстрел" по манекенам-тики.‡Redet mit Ortezza, um \'zuverlässiger Schuss\' zu erlernen. Wendet ihn 5 Mal bei einem Tikiziel an.‡오르테자와 대화하여 고정 사격을 배운 다음, 티키 표적에 고정 사격을 5번 사용하여 연습해야 합니다.‡Habla con Ortezza para aprender Disparo firme. Usa Disparo firme 5 veces contra una diana Tiki.‡Habla con Ortezza para aprender Disparo firme. Usa Disparo firme 5 veces contra una diana Tiki.‡Parlez à Ortezza pour apprendre Tir assuré. Entraînez-vous en utilisant Tir assuré à 5 reprises contre une Cible Tiki.‡与欧塔扎交谈，进行稳固射击的训练。然后对一个蒂基面具假人使用5次稳固射击。‡與奧泰薩談話來訓練穩固射擊。在訓練假人身上使用5次穩固射擊。',
  }
},
[24779] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡Un duro comienzo‡Un début difficile‡粗暴的开始‡艱難的開始',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste.‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 회수해야 합니다.‡Consigue 6 pelajes de gato Ferocrín.‡Consigue 6 pelajes de gato Ferocrín.‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡取得6份蠻鬃山貓皮。',
  }
},
[24780] = {
  {
    'Fosso da prova‡Яма испытаний‡Grube der Bewährung‡시험의 구덩이‡Foso de pruebas‡Foso de pruebas‡La fosse de l\'épreuve‡试炼场‡試煉場',
    nil,
    'Fale com o Carcereiro Lançanegra, depois entre no fosso da prova e mate um Batedor Escamas Odiosas Cativo.‡Поговорите с тюремщиком Черного Копья, а затем спуститесь в яму испытаний и убейте пленного разведчика из клана Злобной Чешуи.‡Redet mit einem Gefängnisaufseher der Dunkelspeere, betretet dann die Grube der Bewährung und besiegt einen gefangenen Späher der Gallschuppen.‡검은창 교도관과 대화한 다음, 시험의 구덩이로 들어가 사로잡힌 원한비늘 정찰병을 처치해야 합니다.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Parlez à un Geôlier sombrelance, puis descendez dans la fosse de l\'épreuve et tuez un Éclaireur Vexécaille captif.‡同暗矛狱卒交谈，然后进入试炼场，杀死一名恶鳞斥候俘虏。‡和一名暗矛獄卒談話，然後進入試煉場殺死一名被俘虜的惡鱗斥候。',
  }
},
[24781] = {
  {
    'Melhor do que o esperado‡Превосходя ожидания‡Mehr als erwartet‡기대 이상‡Mejor de lo esperado‡Mejor de lo esperado‡Mieux que prévu‡喜出望外‡超乎預期',
    nil,
    'Apresente-se a Vol\'jin na Cidadela dos Lançanegra.‡Поговорите с Вол\'джином в крепости Черного Копья.‡Meldet Euch bei Vol\'jin in der Dunkelspeerfeste.‡검은창 요새에 있는 볼진에게 보고해야 합니다.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Présentez-vous à Vol\'jin au Bastion des Sombrelances.‡向暗矛要塞中的沃金报到。‡到暗矛要塞向沃金回報。',
  }
},
[24782] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡El levantamiento de los Lanza Negra‡L\'ascension des Sombrelances‡暗矛的崛起‡暗矛中興',
    nil,
    'Fale com Tunari no Campo de Treinamento Lançanegra.‡Найдите Тунари на тренировочной площадке Черного Копья.‡Trefft Tunari auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 투나리를 만나야 합니다.‡Reúnete con Tunari en el Campo de Entrenamiento Lanza Negra.‡Reúnete con Tunari en el Campo de Entrenamiento Lanza Negra.‡Allez voir Tunari sur le Terrain d’entraînement des Sombrelances.‡与暗矛训练场中的图娜尼谈谈。‡在暗矛訓練場和圖那利碰面。',
  }
},
[24783] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Ziele treffen‡기본기: 연타‡A golpe de entrenamiento‡A golpe de entrenamiento‡La base : savoir frapper des trucs‡基础教程：攻击目标‡基本原則:攻擊',
    nil,
    'Destrua 6 Alvos Carrancas.‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다.‡Destruye 6 dianas Tiki.‡Destruye 6 dianas Tiki.‡Détruire 6 Cibles Tiki.‡摧毁6个蒂基面具假人。‡摧毀6個訓練假人。',
  }
},
[24784] = {
  {
    'A arte do sacerdote‡Искусство жреца‡Die Künste eines Priesters‡사제의 기술‡Las artes del sacerdote‡Las artes del sacerdote‡Les arts du prêtre‡牧师的技艺‡牧師之藝',
    nil,
    'Fale com Tunari para treinar a Cura Célere. Use a Cura Célere 5 vezes para curar 5 Vigias Lançanegra Feridos espalhados pelo Campo de Treinamento Lançanegra.‡Поговорите с Тунари и потренируйтесь в освоении заклинания "Быстрое исцеление". Затем 5 раз примените "Быстрое исцеление", чтобы вылечить раненых дозорных племени Черного Копья у тренировочной площадки Черного Копья.‡Redet mit Tunari, um \'Blitzheilung\' zu erlernen. Wendet diese bei 5 verwundeten Wachen der Dunkelspeere beim Übungsgelände der Dunkelspeere an.‡투나리와 대화하여 순간 치유를 배운 다음, 검은창 훈련장 주위에 있는 부상당한 검은창 감시병에게 순간 치유를 5번 사용하여 연습해야 합니다.‡Habla con Tunari para aprender Sanación relámpago. Usa Sanación relámpago 5 veces para sanar vigilantes Lanza Negra heridos alrededor del Campo de Entrenamiento Lanza Negra.‡Habla con Tunari para aprender Sanación relámpago. Usa Sanación relámpago 5 veces para sanar vigilantes Lanza Negra heridos alrededor del Campo de Entrenamiento Lanza Negra.‡Parlez à Tunari pour apprendre Soins rapides. Entraînez-vous en lançant Soins rapides à 5 reprises sur des Guetteurs sombrelances blessés au Terrain d\'entraînement des Sombrelances.‡与图娜尼交谈，进行快速治疗的训练。然后对暗矛训练场一带受伤的暗矛卫士施放5次快速治疗。‡與圖那利談話來訓練快速治療。在暗矛訓練場附近的受傷的暗矛看守者身上使用5次快速治療來治癒他們。',
  }
},
[24785] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡Un duro comienzo‡Un début difficile‡粗暴的开始‡艱難的開始',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste.‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 회수해야 합니다.‡Consigue 6 pelajes de gato Ferocrín.‡Consigue 6 pelajes de gato Ferocrín.‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡取得6份蠻鬃山貓皮。',
  }
},
[24786] = {
  {
    'Fosso da prova‡Яма испытаний‡Grube der Bewährung‡시험의 구덩이‡Foso de pruebas‡Foso de pruebas‡La fosse de l\'épreuve‡试炼场‡試煉場',
