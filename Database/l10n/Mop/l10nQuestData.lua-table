[4804] = {
  {
    '‡Э\'ко хладнокрылов‡E\'ko einer Eiswindschimäre‡서리바람 키메라의 에코‡E\'ko Orvallo‡E\'ko Orvallo‡E\'ko de Noroît‡冰风魂精‡冰風魂精',
