},
[4806] = {
  {
    '‡Э\'ко великанов‡E\'ko der Frosthagelriesen‡서리망치거인의 에코‡E\'ko de los Machacahielo‡E\'ko de los Machacahielo‡E\'ko de Cognegivre‡霜槌魂精‡霜槌魂精',
