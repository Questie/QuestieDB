},
[25227] = {
  {
    'Thonk‡Тонк‡Thonk‡통크‡Thonk‡Thonk‡Thonk‡索恩克‡通克',
    nil,
    'Apresente-se ao Thonk na torre de guarda a noroeste do Monte Navalha.‡Найдите Тонка на сторожевой башне, что к северо-западу от Колючего Холма.‡Meldet Euch bei Thonk im Wachturm nordwestlich von Klingenhügel.‡칼바위 언덕 북서쪽에 있는 경비탑에서 통크와 대화해야 합니다.‡Preséntate ante Thonk en la torre de vigilancia al noroeste de Cerrotajo.‡Preséntate ante Thonk en la torre de vigilancia al noroeste de Cerrotajo.‡Présentez-vous à Thonk, à la tour de garde au nord-ouest de Tranchecolline.‡去找剃刀岭西北方哨塔上的索恩克。‡到剃刀嶺西北邊的警備塔上向通克回報。',
  }
},
[25228] = {
  {
    '‡Пророчества о конце света‡Untergangsverkündungen‡파멸의 예언‡Profecías de fatalidad‡Profecías de fatalidad‡Funestes auspices‡末日预言‡',
    nil,
    '‡Выслушайте речь вестника рока в Волоке и найдите копии листовок "Стенания души в пламени первородного огня", "Конец всего сущего – правда и домыслы" и "Мир обречен, но дух мой чист и безмятежен…".‡Hört Euch die Rede eines Weltuntergangsverkünders in der Gasse an, und beschafft Exemplare der Pamphlete "Elementarfeuer für die Seele", "Was bedeutet \'Das Ende der Schöpfung\' für mich?" sowie "Sicherheit und Geborgenheit in einer dem Untergang geweihten Welt".‡‡Escucha un discurso dado por un orador del Sino en La Calle Mayor y consigue copias de los panfletos "Fuego elemental para el alma", "¿Cómo me afecta a mí \'el fin de todas las cosas\'?" y "Seguridad y tranquilidad en un mundo condenado".‡Escucha un discurso dado por un orador del Sino en La Calle Mayor y consigue copias de los panfletos "Fuego elemental para el alma", "¿Cómo me afecta a mí \'el fin de todas las cosas\'?" y "Seguridad y tranquilidad en un mundo condenado".‡Écouter le discours prononcé par un Auspice funeste à la Herse et obtenir des copies des pamphlets « Feu élémentaire pour l\'âme », « Que signifie pour moi « La Fin de Toutes Choses » ? » et « Comment trouver la sécurité et le réconfort dans un monde condamné ».‡‡',
  }
},
[25229] = {
  {
    'Alguns bons gnomos‡Несколько хороших гномов‡Eine Frage der Gnomenehre‡신병 노움 모집‡Algunos gnomos buenos‡Algunos gnomos buenos‡Motivés, motivés, il faut les motiver…‡好侏儒寥寥‡一些好地精',
    nil,
    'Usa o Motivatrom para recrutar Cidadãos Gnomos do Beco da Gambiarra e leve-os para o Capitão Esteira Bicochispa na Garagem do Gradaço.‡Завербуйте несколько гномов-горожан из Города Механиков с помощью Мотиват-о-трона, после чего отведите их в Поселок Сталежара к капитану Ступу Искражу.‡Werbt mit Hilfe des Motivieratron Gnome aus Tüftlerstadt an und führt sie zu Hauptmann Tret Funkdüse bei Stahlrosts Depot.‡땜장이 마을에서 동기부여장치를 사용해 신병 노움 5명을 모집한 뒤 스틸그릴의 정비소에 있는 대장 트레드 스파크노즐에게 데려가야 합니다.‡Recluta ciudadanos gnomos de la Ciudad Manitas haciendo uso del Motivatrón y dirígelos al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Recluta ciudadanos gnomos de la Ciudad Manitas haciendo uso del Motivatrón y dirígelos al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡À l’aide du Motiva-tron, recrutez des Citoyens gnomes de Brikabrok, et conduisez-les au Capitaine Chape Étincetuyère au dépôt de Grillacier.‡使用激励仪，在侏儒区征募侏儒，并率领他们返回钢架补给站，去见崔德·火钻队长。‡在地精區使用激勵裝置募集5名新兵，然後帶著他們回去鋼架補給站見特瑞德‧炫鼻上尉。',
  }
},
[25230] = {
  {
    'Mais do que uma simples doença‡Не просто болезнь‡Mehr als Krankheit‡질병 그 이상‡Más que una enfermedad‡Más que una enfermedad‡Bien plus qu\'une maladie‡不只是病了‡不只是疾病',
    nil,
    'Mate 10 Dragonetes Nocivos.‡Убейте 10 зараженных дракончиков.‡Tötet 10 giftige Welpen.‡맹독 새끼용 10마리를 처치해야 합니다.‡Mata a 10 crías nocivas.‡Mata a 10 crías nocivas.‡Tuez 10 Dragonnets nocifs.‡杀死10头毒性雏龙。‡殺死10隻劇毒幼龍。',
  }
},
[25231] = {
  {
    '‡Подонки Южных морей‡Abschaum des Südmeers‡‡La escoria de los Mares del Sur‡‡La racaille des mers du Sud‡‡',
    nil,
    '‡Убейте 6 наемников Южных морей.‡Tötet 6 Söldner der Südmeerfreibeuter.‡‡Mata a 6 mercenarios de los Mares del Sur.‡‡Tuez 6 Mercenaires des mers du Sud.‡‡',
  }
},
[25232] = {
  {
    'A Lâmina Ardente‡Пылающий Клинок‡Die Brennende Klinge‡불타는 칼날단‡El Filo Ardiente‡El Filo Ardiente‡La Lame ardente‡火刃兽人‡燃刃部族',
    nil,
    'Tome 6 Pergaminhos de Feitiço de membros do clã Lâmina Ardente, na Caverna Sopravento.‡Отберите у последователей Пылающего Клинка 6 свитков заклинаний Пылающего Клинка в пещере Пыльного Ветра.‡Erhaltet 6 Zauberschriftrollen von den Mitgliedern der Brennenden Klinge in der Staubwindhöhle.‡먼지바람 동굴에 있는 불타는 칼날단 단원에게서 불타는 칼날단 마력두루마리를 6개 획득해야 합니다.‡Consigue 6 pergaminos de hechizos del Filo Ardiente de los miembros del Filo Ardiente en la Cueva Viento Seco.‡Consigue 6 pergaminos de hechizos del Filo Ardiente de los miembros del Filo Ardiente en la Cueva Viento Seco.‡Récupérez 6 Parchemins de sortilège de la Lame ardente sur des membres de la Lame ardente à la Caverne des Terrevent.‡从尘风洞穴的火刃成员那里夺得6份火刃魔法卷轴。‡從暮風洞穴裡的燃刃成員那裡取得6份燃刃法術卷軸。',
  }
},
[25233] = {
  {
    'Corte nos suprimentos‡Можно грабить караваны‡Das Ende der Versorgungslinie‡보급선 차단‡Fin de la línea de suministros‡Fin de la línea de suministros‡Le bas de la chaîne d\'approvisionnement‡补给线的尽头‡截斷補給線',
    nil,
    'Mate 4 Provedores do Crepúsculo na Trilha do Lobo, em Hyjal.‡Убейте 4 сумеречных проведиторов на Волчьей тропе, что на горе Хиджал.‡Tötet 4 Zwielichtordner in der Wolfsschlucht auf dem Hyjal.‡하이잘의 늑대의 터에서 황혼의 관리자 4마리를 처치해야 합니다.‡Asesina a 4 proveditores Crepusculares en la Senda del Lobo en Hyjal.‡Asesina a 4 proveditores Crepusculares en la Senda del Lobo en Hyjal.‡Tuez 4 Provéditeurs du Crépuscule sur la Piste du loup, à Hyjal.‡击败海加尔山狼神小径的4名暮光督工。‡到海加爾的狼之小徑，殺死4個暮光供應商。',
  }
},
[25234] = {
  {
    'Mercadoria interceptada‡Тыловые припасы‡Arme Deppen schleppen‡보급품의 정체‡En retaguardia con los suministros‡En retaguardia con los suministros‡On fait tourner le matos‡后勤保障‡馬上行動',
    nil,
    'Recolha 36 Suprimentos Crepusculares deixados para trás pelos Escravos do Crepúsculo libertados.‡Соберите 36 ящиков с припасами Сумеречного Молота, оставленных сумеречными рабами.‡Sammelt 36 Versorgungsgüter des Schattenhammers, die von befreiten Zwielichtsklaven zurückgelassen wurden.‡풀려난 황혼의 노예가 남기고 간 황혼의 보급품 36개를 수집해야 합니다.‡Reúne 36 suministros Crepusculares de los que abandonan los esclavos Crepusculares.‡Reúne 36 suministros Crepusculares de los que abandonan los esclavos Crepusculares.‡Récupérez 36 caisses de Matériel du Crépuscule abandonnées par des Esclaves du Crépuscule libérés.‡收集36份从暮光奴隶身上掉下来的暮光补给品。‡收集36個被釋放的暮光奴隸留下的暮光補給品。',
  }
},
[25235] = {
  {
    'Vul\'Gol vulgar‡Лощина Вул\'Гол‡Vulgäres Vul\'Gol‡벌골의 야만족‡El vulgar Vul\'Gol‡El vulgar Vul\'Gol‡Les vulgaires Vul\'Gol‡粗野的沃古尔‡粗俗的沃古爾',
    nil,
    'Mate 15 Ogros Punhalasca de qualquer tipo.‡Убейте любых 15 огров из клана Дробящего Кулака.‡Tötet 15 Oger der Splitterfäuste.‡망치주먹 오우거 15마리를 처치해야 합니다.‡Mata a 15 ogros Puñastilla cualesquiera.‡Mata a 15 ogros Puñastilla cualesquiera.‡Tuez 15 Ogres brisepoing de n’importe quel type.‡杀死15名任意种类的裂拳食人魔。‡殺死任何種類的裂拳巨魔15隻。',
  }
},
[25236] = {
  {
    'Trovoada que vem da água‡Подводное электричество‡Donner von unten‡가라앉은 천둥도마뱀‡Un trueno desde el fondo‡Un trueno desde el fondo‡Tonnerre sous-marin‡溺死的雷霆蜥蜴‡水底雷霆',
    nil,
    'Ate um Cabo de Magitrama a 8 Lagartos Trovejantes Afogados no Desfiladeiro do Trovão.‡Обвяжите магической веревкой 8 утонувших рокочущих ящериц на Громовом хребте.‡Befestigt die Magiestoffleine an 8 ertrunkenen Donnerechsen im Donnergrat.‡천둥 마루에서 익사한 천둥도마뱀 8마리에 마법매듭 밧줄을 묶어야 합니다.‡Fija una soga de tejido mágico a 8 truenagartos ahogados en el Monte del Trueno.‡Fija una soga de tejido mágico a 8 truenagartos ahogados en el Monte del Trueno.‡Attachez une Longe en tisse-mage à 8 Lézards-tonnerre noyés aux Falaises du Tonnerre.‡将一根魔纹拴绳绑在雷霆山的8条溺死的雷霆蜥蜴身上。‡將魔紋栓繩連結到雷霆山裡8隻溺斃的雷霆蜥蜴身上。',
  }
},
[25237] = {
  {
    'Lágrimas de pedra‡Каменные слезы‡Tränen der Steine‡바위의 눈물‡Lágrimas de piedra‡Lágrimas de piedra‡Des larmes de pierre‡石之泪‡石之淚',
    nil,
    'Colete 7 Lágrimas de Pedra.‡Соберите 7 каменных слез.‡Sammelt 7 Steintränen.‡바위눈물 7개를 모아야 합니다.‡Reúne 7 lacrilitos.‡Reúne 7 lacrilitos.‡Récupérez 7 Larmes de pierre.‡收集7颗石之泪。‡收集7顆石之淚。',
  }
},
