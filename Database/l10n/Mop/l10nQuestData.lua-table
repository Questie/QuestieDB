[30044] = {
  {
    'Muito a aprender‡Начало пути‡Viel zu lernen‡머나먼 배움의 길‡Mucho por aprender‡‡Beaucoup à apprendre‡‡',
    nil,
    'Fale com o Mestre Shang Xi. Uma‡Поговорите с мастером Шан Си.‡Sprecht mit Meister Shang Xi.‡사부 샹 시와 대화해야 합니다. 레벨 1 유랑도‡Habla con el maestro Shang Xi.‡‡Parlez à Maître Shang Xi.‡‡',
  }
},
[30045] = {
  {
    'Muito a aprender‡Начало пути‡Viel zu lernen‡‡Mucho por aprender‡‡Beaucoup à apprendre‡学海无涯‡',
    nil,
    'Fale com o Mestre Shang Xi. Uma‡Поговорите с мастером Шан Си.‡Sprecht mit Meister Shang Xi.‡‡Habla con el maestro Shang Xi.‡‡Parlez à Maître Shang Xi.‡与尚喜师父交谈。‡',
  }
},
[30046] = {
  {
    'A resolução de Chen‡Решительный Чэнь‡Chens Vorsatz‡첸의 해결책‡La decisión de Chen‡‡La résolution de Chen‡陈的决意‡',
    nil,
    'Encontre Chen Malte do Trovão em Meia Colina. Uma‡Поговорите с Чэнем Буйным Портером в Полугорье.‡Trefft Euch mit Chen Sturmbräu bei Halbhügel.‡언덕골에 있는 첸 스톰스타우트와 만나야 합니다. 레벨 15 네 바람의 계곡‡Reúnete con Chen Cerveza de Trueno en El Alcor.‡‡Rejoignez Chen Brune d’Orage à Micolline.‡在半山与陈·风暴烈酒碰面。‡',
  }
},
[30047] = {
  {
    'A degustação de Chen‡Дегустация Чэня‡Chens Geschmacksprobe‡첸의 시식‡La cata de Chen‡‡Le test de dégustation de Chen‡陈的口味‡',
    nil,
    'Fale novamente com Chen Malte do Trovão. Uma‡Возвращайтесь к Чэню Буйному Портеру.‡Kehrt zu Chen Sturmbräu zurück.‡첸 스톰스타우트에게 가야 합니다. 레벨 15 네 바람의 계곡‡Regresa con Chen Cerveza de Trueno.‡‡Retournez voir Chen Brune d’Orage.‡去找陈·风暴烈酒。‡',
  }
},
[30048] = {
  {
    'Li Li e os grãos‡Ли Ли и зерно‡Li Li und das Getreide‡리 리와 맥아‡Li Li y el grano‡‡Li Li et le grain‡丽丽和谷物‡',
    nil,
    'Fale com Li Li no Celeiro Imperial, que fica no Vale dos Quatro Ventos. Uma‡Отправляйтесь в долину Четырех Ветров и поговорите с Ли Ли в Императорском хранилище зерна.‡Sprecht mit Li Li bei der Kaiserlichen Kornkammer im Tal der Vier Winde.‡네 바람의 계곡의 황실 곡물창고에 있는 리 리와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Li Li en El Granero Imperial, en el Valle de los Cuatro Vientos.‡‡Parlez à Li Li au Grenier Impérial, dans la Vallée des Quatre vents.‡去四风谷的帝皇粮仓和丽丽谈一谈。‡',
  }
},
[30049] = {
  {
    'Por água abaixo‡Водоносы‡Wasserträger‡물 운반‡Bailarle el agua‡‡Porteur d’eau‡扛不动水‡',
    nil,
    'Fale com Caneca de Barro no Leque Dourado, que fica no Vale dos Quatro Ventos. Uma‡Отправляйтесь в долину Четырех Ветров и поговорите с Грязной Кружкой в Золоченом Веере.‡Sprecht mit Trübtrunk am Goldfächer im Tal der Vier Winde.‡네 바람의 계곡의 금빛 선상지에 있는 머드머그와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Caolín en El Abanico Dorado en el Valle de los Cuatro Vientos.‡‡Parlez à Gueule de Boue au Delta Doré, dans la Vallée des Quatre vents.‡和四风谷金扇泽的泥盏谈一谈。‡',
  }
},
[30050] = {
  {
    'Jardineira Fran e o regador‡Фран и лейка‡Nur die Harten kommen in\'n Garten‡원예사 프란과 물뿌리개‡La jardinera Frany y la regadera‡‡La jardinière Fran et son arrosoir‡园丁芳兰和洒水壶‡',
    nil,
    'Cumpra as ordens da Jardineira Fran e regue 60 plantas.Você pode regar sem descer da montaria. Uma‡Выслушайте распоряжения садовницы Фран и полейте ее 60 растений.Поливать можно сидя в седле.‡Befolgt Gärtnerin Frans Anweisung und wässert 60 ihrer Gemüsepflanzen.Pflanzen kann man auch vom Rücken eines Reittiers aus wässern.‡원예사 프란의 명령에 따라 채소 60개에 물을 줘야 합니다.탈 것에 탄 상태로도 물을 줄 수 있습니다.‡Escucha las órdenes de la jardinera Frany y riega 60 verduras.Puedes regar las plantas a lomos de una montura.‡‡Écoutez les instructions de la Jardinière Fran et arrosez 60 de ses légumes.Vous pouvez arroser des plants depuis votre monture. Un(e) quête.‡按园丁芳兰的吩咐给她的60颗蔬菜浇水。你可以骑在马上浇水。‡',
  }
},
[30051] = {
  {
    'A grande caçada aquática‡Великий забор воды‡Die Große Wasserjagd‡훌륭한 물을 찾아서‡La gran búsqueda del agua‡‡En quête d’eau‡寻找活水‡',
    nil,
    'Guie Caneca de Barro até os Lagos Redemoinhantes no Leque Dourado e ajude-o a pegar 30 punhados de Água das Clareiras.Se você se separar de Caneca de Barro, encontre-o novamente perto da banana gigante, no Leque Dourado.‡Проводите Грязную Кружку к Бурлящим лужам в Золоченом Веере и помогите ему набрать 30 пригоршней болотной воды.Если вы разделитесь, ищите Грязную Кружку у огромного банана в Золоченом Веере.‡Begleitet Trübtrunk zu den Wirbelnden Teichen des Goldfächers und helft ihm 30 Pfoten voll Wiesenwasser einzusammeln.Wenn Ihr Trübtrunk aus den Augen verliert, könnt Ihr ihn neben der riesigen Banane im Goldfächer wiederfinden.‡머드머그를 금빛 선상지에 있는 소용돌이치는 웅덩이로 안내해 금빛 물 30개를 수집하도록 도와야 합니다.머드머그와 떨어질 경우 금빛 선상지의 커다란 바나나 옆으로 가면 찾을 수 있습니다.‡Guía a Caolín hasta pozas arremolinadas en El Abanico Dorado, y ayúdale a reunir 30 puñados de aguaclara.Si te separas de Caolín, podrás encontrarlo junto al banano gigante de El Abanico Dorado.‡‡Guidez Gueule de Boue jusqu’au Bassin tourbillonnant de l’Éventail Doré et aidez-le à récolter 30 poignées d’Eau de la clairière.Si vous êtes séparé de Gueule de Boue, vous pourrez le retrouver près de la banane géante, à l’Éventail Doré.‡带泥盏去金扇泽的漩涡之池，帮他收集30捧沼泽活水。如果与泥盏走散了，你可以在金扇泽的大香蕉旁找到他。‡',
  }
},
[30052] = {
  {
    'Guerra das ervas‡Война с сорняками‡Unkrautvernichtung‡잡초 전쟁‡Guerra de malas hierbas‡‡Herbicide‡除草大战‡',
    nil,
    'Arranque 100 ervas daninhas do terreno de Gai Lan.Você pode arrancar ervas sem descer da montaria. Uma‡Вырвите 100 сорняков на поле Гай Ланя.Рвать сорняки можно и сидя в седле. задание из World of Warcraft: Mists of Pandaria.‡Befreit Gai Lans Feld von 100 Exemplaren Unkraut.Das Unkraut könnt Ihr auch vom Rücken eines Reittieres aus jäten.‡가이 란의 농장에서 잡초 100개를 뽑아내야 합니다.탈 것에 탄 채로도 잡초를 뽑을 수 있습니다. 월드 오브 워크래프트: 판다리아의 안개의‡Arranca 100 malas hierbas del campo de Gai Lan.Puedes arrancar las malas hierbas a lomos de una montura.‡‡Arrachez 100 Mauvaises herbes dans le champ de Gai Lan.Vous pouvez arracher des Mauvaises herbes depuis votre monture. Un/une quête de World of Warcraft : Mists of Pandaria.‡从蓝盖的地里拔掉100颗杂草。你可以在骑乘状态下拔草。‡',
  }
},
[30053] = {
  {
    'Caça ao lúpulo‡Охота на хмель‡Hopfjagd‡홉 열매 구하기‡La búsqueda de lúpulos‡‡Chasse au houblon‡寻找啤酒花‡',
    nil,
    'Peça lúpulo à Jardineira Fran, a Gai Lan e a Den Garra de Barro. Uma‡Попросите немного шишек хмеля у садовницы Фран, Гай Ланя и Дэна Грязного Когтя.‡Bittet Gärtnerin Fran, Gai Lan und Den Lehmkrall um Hopfen.‡원예사 프란, 가이 란, 덴 머드클로에게서 홉을 구해야 합니다. 레벨 15 네 바람의 계곡‡Pídeles lúpulos a la jardinera Frany, a Gai Lan y a Den Zarpa Fangosa.‡‡Demandez du houblon à la Jardinière Fran, à Gai Lan et à Den Griffe de Tourbe.‡向园丁芳兰、蓝盖和邓·泥爪索要啤酒花。‡',
  }
},
[30054] = {
  {
    'Já chega!‡С меня хватит, бортель-мортель!‡Schluss jetzt, verfiddelt noch mal!‡더는 참을 수 없다‡Ya está bien, dingue‡‡Trop c’est trop de chez trop !‡够了，真受够了‡',
    nil,
    'Consiga 100 Dentes de Vermingue. Uma‡Соберите 100 зубов гну-синей.‡Sammelt 100 Zähne von Shed-Ling ein.‡토깽 이빨 100개를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 100 dientes de mures.‡‡Rapportez 100 Dents de virmens.‡获得100颗兔妖门牙。‡',
  }
},
[30055] = {
  {
    'O lúpulo de Malte do Trovão‡Хмель Буйного Портера‡Sturmbräus Hopfnung‡스톰스타우트의 홉 열매‡Los lúpulos de Cerveza de Trueno‡‡Le houblon de Brune d’Orage‡风暴烈酒的啤酒花‡',
    nil,
    'Fale novamente com Chen Malte do Trovão em Meia Colina. Uma‡Вернитесь в Полугорье и поговорите с Чэнем Буйным Портером.‡Kehrt zu Chen Sturmbräu in Halbhügel zurück.‡언덕골에 있는 첸 스톰스타우트에게 가야 합니다. 레벨 15 네 바람의 계곡‡Reúnete con Chen Cerveza de Trueno en El Alcor.‡‡Retournez voir Chen Brune d’Orage à Micolline.‡回半山找陈·风暴烈酒。‡',
  }
},
[30056] = {
  {
    'A filha do fazendeiro‡Дочь фермера‡Die Bauerstochter‡농부의 딸‡La hija del granjero‡‡La fille du fermier‡农夫的女儿‡',
    nil,
    'Encontre Mina Garra de Barro. Uma‡Найдите Мину Грязный Коготь.‡Findet Mina Lehmkrall.‡미나 머드클로를 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra a Mina Zarpa Fangosa.‡‡Trouvez Mina Griffe de Tourbe.‡找到米娜·泥爪。‡',
  }
},
[30057] = {
  {
    'O ataque das cenouras assassinas‡Морковное безумие‡Die orangene Bedrohung‡당근은 이제 그만‡Vista naranja‡‡Voir orange‡眼放橙光‡',
    nil,
    'Leve Mina Garra de Barro de volta para casa. Uma‡Отведите Мину Грязный Коготь к отцу.‡Bringt Mina Lehmkrall zurück zu ihrem Vater.‡미나 머드클로를 아버지에게 데려가야 합니다. 레벨 15 네 바람의 계곡‡Lleva a Mina Zarpa Fangosa a casa con su padre.‡‡Ramenez Mina Griffe de Tourbe chez son père.‡将米娜·泥爪带回她父亲身边。‡',
  }
},
[30058] = {
  {
    'Maripozilla!‡Мотылянь!‡Mottallus!‡모스랄루스다!‡¡Alevón!‡‡Mothallus !‡魔丝勒斯！‡',
    nil,
    'Jogue a isca e derrote Maripozilla. Uma‡Приманите Мотылянь и победите ее.‡Lockt Mottallus an und besiegt sie.‡모스랄루스를 유인해 처치해야 합니다. 레벨 15 네 바람의 계곡‡Atrae y derrota a Alevón.‡‡Attirez et éliminez Mothallus.‡引诱并打败魔丝勒斯。‡',
  }
},
[30059] = {
  {
    'A rebelião das mariposas‡Восстание мотыльков‡Die Mottenrebellion‡나방의 반란‡La rebelión de las polillas‡‡La rébellion des phalènes‡飞蛾叛乱‡',
    nil,
    'Mate 6 Mariposas de Seda Mutantes e 8 Mariposas de Seda Mutantes Pequenas. Uma‡Уничтожьте 6 мутировавших шелкопрядов и 8 маленьких мутировавших шелкопрядов.‡Tötet 6 mutierte Seidenspinner und 8 winzige mutierte Seidenspinner.‡돌연변이 주단나방과 작은 돌연변이 주단나방 8마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 6 polillas de seda mutadas y 8 polillas de seda mutadas diminutas.‡‡Tuez 6 Soilènes mutés et 8 Soilènes mutés minuscules.‡杀死6只变异的魔丝蛾和8只小变异魔丝蛾。‡',
  }
},
[30063] = {
  {
    'Por trás das máscaras‡Срывая маски‡Hinter den Masken‡가면 뒤에는‡Tras las máscaras‡‡Derrière les masques‡面具背后‡',
    nil,
    'Junte 8 Máscaras da Dúvida. Uma‡Соберите 8 масок сомнения.‡Sammelt 8 Masken des Zweifels.‡의심의 가면 8개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 8 máscaras de la Duda.‡‡Récupérez 8 Masques du doute.‡收集8个怀疑面具。‡',
  }
},
[30064] = {
  {
    'Salvando os sutras‡Спасая сутры‡Rettung der Sutras‡경전 구출‡Salvar los sutras‡‡Sauver les sutras‡抢救经书‡',
    nil,
    'Colete 6 Sutras Antigos. Uma‡Соберите 6 древних сутр.‡Sammelt 6 uralte Sutras.‡고대 경전 6권을 모아야 합니다. 레벨 10 비취 숲‡Hazte con 6 sutras ancestrales.‡‡Ramassez 6 Sutras antiques.‡收集6本古旧的经书。‡',
  }
},
[30065] = {
  {
    'A flecha e o alvo‡Стрелы судьбы‡Pfeile des Glücks‡운명의 화살‡Las flechas de la fortuna‡‡Flèches de récupération‡命运之箭‡',
    nil,
    'Colete 8 Flechas dos Defensores. Uma‡Соберите 8 стрел защитника.‡Sammelt 8 Pfeile des Verteidigers.‡방어병의 화살 8개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 8 flechas del defensor.‡‡Récupérez 8 Flèches de défenseur.‡收集8支防御者的箭。‡',
  }
},
[30066] = {
  {
    'Poder oculto‡Невидимая сила‡Verborgene Macht‡숨은 힘‡Poder oculto‡‡Un pouvoir caché‡隐藏的力量‡',
    nil,
    'Entregue Mantras Antigos a 6 Guardiões de Yu\'lon ou Adeptos de Yu\'lon. Uma‡Доставьте древние мантры 6 стражам или адептам Юй-Лун.‡Bringt alte Mantras zu 6 Wächtern oder Adepten von Yu\'lon.‡고대의 진언을 위론 수호자나 위론 숙련마법사 6명에게 전달해야 합니다. 레벨 10 비취 숲‡Entrega mantras antiguos a 6 guardianes de Yu\'lon o adeptos de Yu\'lon.‡‡Livrez les Mantras antiques à 6 Gardiens de Yu’lon ou Adeptes de Yu’lon.‡把古老的真言交给6个玉珑守护者或玉珑助祭。‡',
  }
},
[30067] = {
  {
    'A Sombra da Dúvida‡Тень Сомнения‡Der Schatten des Zweifels‡의심의 그림자‡La Sombra de la Duda‡‡L’ombre du doute‡疑之影‡',
    nil,
    'Derrote a Sombra da Dúvida. Uma‡Победите Тень Сомнения.‡Besiegt den Schatten des Zweifels.‡의심의 그림자를 처치해야 합니다. 레벨 10 비취 숲‡Derrota a la Sombra de la Duda.‡‡Terrassez l’Ombre du doute.‡击败疑之影。‡',
  }
},
[30068] = {
  {
    'Chamas do Caos‡Пламя Бездны‡Flammen der Leere‡공허의 불꽃‡Llamas del Vacío‡‡Les flammes du Vide‡虚无之火‡',
    nil,
    'Voe com sua Serpente de Guerra por perto das Fontes de Água Pura. Depois, jogue água que ela carrega na boca sobre 6 Chamas do Caos. Um(a) missão.‡Летите на своем боевом змее к Чистому источнику, наберите в его рот воды и потушите 6 очагов Пламени Бездны.‡Fliegt mit Eurer Kriegsschlange zu reinem Quellwasser und löscht dann 6 Flammen der Leere mit dem Wasser aus ihrem Maul.‡전투 운룡을 타고 깨끗한 샘물로 날아가서 물을 담고, 용의 입에 담긴 물로 6곳의 공허의 불꽃을 꺼야 합니다.‡Vuela con tu dragón de guerra cerca de los manantiales de agua pura y rocía 6 llamas del Vacío con el agua que lleve en la boca. Un(a) misión.‡‡Faites voler votre Serpent de guerre près des Sources d’eau pure, puis éteignez 6 Flammes du Vide avec l’eau transportée dans sa gueule.‡驾乘作战翔龙飞到纯净泉水附近，然后让翔龙衔水扑灭6堆虚空烈焰。‡',
  }
},
[30069] = {
  {
    'O mapa não é o território‡Столкновение с противником расстраивает все планы‡Kein Plan überlebt den Feindkontakt‡적과 마주칠 때, 계획은 사치다‡Ningún plan sobrevive al contacto con el enemigo‡‡Aucun plan ne survit au contact de l’ennemi‡随机应变‡',
    nil,
    'Mate 6 Brutos de Garrosh\'ar e 6 Engraxa-catracas de Garrosh\'ar. Uma‡Убейте 6 рубак лагеря Гаррош\'ар и 6 ремонтников лагеря Гаррош\'ар.‡Tötet 6 Grunzer und 4 Kupplungsschmierer von Garrosh\'ar.‡가로쉬아르 그런트 6명과 가로쉬아르 기계정비공 6명을 처치해야 합니다. 레벨 10 비취 숲‡Mata a 6 brutos de Garrosh\'ar y a 6 engrasadores de tuercas de Garrosh\'ar.‡‡Tuez 6 Grunts garrosh’ar et 6 Graisse-rouages garrosh’ar.‡击败6个加尔鲁什尔步兵和6个加尔鲁什尔设备养护工。‡',
  }
},
[30070] = {
  {
    'A Queda de Ga\'trul‡Расправа над Га\'трулом‡Der Fall von Ga\'trul‡가트룰의 몰락‡La caída de Ga\'trul‡‡La chute de Ga’trul‡消灭加图尔‡',
    nil,
    'Mate Ga\'trul. Uma‡Убейте Га\'трула.‡Tötet Ga\'trul.‡가트룰을 처치해야 합니다. 레벨 10 비취 숲‡Mata a Ga\'trul.‡‡Tuez Ga’trul.‡击败加图尔。‡',
  }
},
[30072] = {
  {
    'De onde vem a seda‡Шелковый путь‡So geht Seide‡비단은 어떻게 만들어지는 걸까?‡De donde procede la seda‡‡D’où vient la soie‡蚕丝从哪里来‡',
    nil,
    'Colha Folhas de Mulboresa, alimente 5 Larvas Famintas e pegue um pouco de Seda Bruta. Uma‡Найдите листья шелковицы, накормите 5 голодных шелкопрядов и возьмите шелк-сырец.‡Sammelt Maulbeerblätter, füttert 5 hungrige Seidenraupen und besorgt Rohseide.‡뽕잎을 획득해 배고픈 누에 5마리에 먹이로 주고, 생사를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue hojas de morera, alimenta a 5 gusanos de seda hambrientos y consigue seda sin refinar.‡‡Trouvez des Feuilles de mûrier, nourrissez 5 Larves de ver à soie et obtenez de la Soie brute.‡获得桑叶，喂给5只饥饿的蚕宝宝，拿到生丝。‡',
  }
},
[30073] = {
  {
    'O imperador‡Император‡Das kaiserliche Gebräu‡황제‡El Emperador‡‡L’Empereur‡帝王酒‡',
    nil,
    'Fique por perto e ajude Chen Malte do Trovão com a cerveja. Uma‡Помогите Чэню Буйному Портеру сварить пиво.‡Bleibt vor Ort und helft Chen Sturmbräu, sein Gebräu herzustellen.‡첸 스톰스타우트 옆에서 맥주 양조를 도와야 합니다. 레벨 15 네 바람의 계곡‡Quédate con Chen Cerveza de Trueno y ayúdale a elaborar la cerveza.‡‡Aidez Chen Brune d’Orage à brasser sa bière.‡站在一旁，帮助陈·风暴烈酒酿酒。‡',
  }
},
[30074] = {
  {
    'Batendo à porta‡Стук в дверь‡Klopf, klopf‡문 두드리기‡Llamando a la puerta‡‡Frapper à la porte‡敲门‡',
    nil,
    'Encontre Chen Malte do Trovão na entrada da Cervejaria Malte do Trovão. Uma‡Разыщите Чэня Буйного Портера у входа в хмелеварню Буйных Портеров.‡Trefft Euch mit Chen Sturmbräu am Eingang der Brauerei Sturmbräu.‡스톰스타우트 양조장 입구에 있는 첸 스톰스타우트와 만나야 합니다. 레벨 15 네 바람의 계곡‡Reúnete con Chen Cerveza de Trueno en la entrada de la Cervecería del Trueno.‡‡Retrouvez Chen Brune d’Orage à l’entrée de la brasserie Brune d’Orage.‡去风暴烈酒酿造厂的入口处和陈·风暴烈酒碰面。‡',
  }
},
[30075] = {
  {
    'Abrindo caminho‡Прочь с дороги!‡Weg frei‡통로 확보‡Despejar el camino‡‡Dégager le passage‡扫清道路‡',
    nil,
    'Mate 10 Hozens Mamados ou Vermingues Encrenqueiros. Uma‡Уничтожьте 10 захмелевших хозенов или шаловливых гну-синей.‡Tötet 10 bierbenebelte Ho-zen oder schelmische Shed-Ling.‡짓궂은 토깽이나 맥주에 취한 호젠 10마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 10 hozen beodos o mures traviesos.‡‡Tuez 10 Hozen grisés par la bière ou Virmens malfaisants.‡击败10只酒臭猢狲或捣乱的兔妖‡',
  }
},
[30076] = {
  {
    'Água viva‡Волшебная вода‡Das beste Wasser‡상급수‡El agua con más duende‡‡De l’eau pas comme les autres‡最奇妙的液体‡',
    nil,
    'Consiga 3 Águas de Duende. Uma‡Найдите 3 экстракта духов воды.‡Sammelt 3 Geistwasseressenzen ein.‡요마물 정수 3개를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 3 esencias de aguaburbuja.‡‡Obtenez 3 Essences de lutins aquatiques.‡获得3个活水精华。‡',
  }
},
[30077] = {
  {
    'Barril é coisa de doido!‡Бочки‡Fasswerfen‡맥주통‡Barriles, ¿sabes?‡‡Attention aux tonneaux‡看那些木桶，伙计‡',
    nil,
    'Liberte 7 Pandarens Embarrilados. Uma‡Освободите из бочек 7 пандаренов.‡Befreit 7 abgefasste Pandaren.‡통에 갇힌 판다렌 7명을 탈출시켜야 합니다. 레벨 15 네 바람의 계곡‡Libera a 7 pandaren embarrilados.‡‡Libérez 7 Pandarens entonnelés.‡解救7个困在桶里的熊猫人。‡',
  }
},
[30078] = {
  {
    'Faxina na casa‡Домашняя уборка‡Hausputz‡양조장 청소‡Limpiar la casa‡‡Grand nettoyage‡忍无可忍‡',
    nil,
    'Derrote Eddy, Juga e o Elementalcóolico Loiro com Colarinho. Uma‡Победите Эдди, Йоогу и шипящего желтого хмелементаля.‡Besiegt Eddy, Jooga und den sprudelnden Bierlementar.‡에디, 주가, 그리고 톡 쏘는 노란 주령을 처치해야 합니다. 레벨 15 네 바람의 계곡‡Derrota a Eddy, Jooga y al elemental de cerveza amarillo burbujeante.‡‡Terrassez Eddy, Jooga et l’Élémenbière jaune gazeux.‡击败涡流、尤噶和碳酸黄酒元素。‡',
  }
},
[30079] = {
  {
    'Que bicho mordeu a Vigia de Zhu?‡Что же гложет дозор Чжу?‡Was ist mit Zhus Wacht los?‡쥬의 감시초소를 좀먹고 있는 건 무엇?‡¿Qué está pasando en la Atalaya de Zhu?‡‡Ce qui sape le guet de Zhu ?‡朱家堡之殇‡',
    nil,
    'Fale com os habitantes da Vigia de Zhu e encontre alguém disposto a falar com você. Uma‡Поговорите с обитателями дозора Чжу и найдите кого-нибудь, кто захочет с вами беседовать.‡Sprecht in Zhus Wacht mit Einwohnern und sucht jemanden, der sich mit Euch unterhalten möchte.‡쥬의 감시초소 주민들에게 말을 걸어, 대화를 할 용의가 있는 판다렌을 찾아야 합니다. 레벨 15 크라사랑 밀림‡Habla con los habitantes de la Atalaya de Zhu y encuentra a alguien dispuesto a hablar con vosotros.‡‡Allez voir les habitants du Guet de Zhu et trouvez quelqu’un qui accepte de vous parler.‡与朱家堡的居民交谈，找出愿意和你说话的人。‡',
  }
},
[30080] = {
  {
    'Procurando Uwe-Mo‡В поисках И-Мо‡Suche nach Yi-Mo‡이모우를 찾아서‡Buscando a Yi-Mo‡‡Trouvez Yi Mo‡找到易默‡',
    nil,
    'Procure Uwe-Mo Franja Longa em algum ponto a noroeste da Vigia de Zhu. Uma‡Разыщите И-Мо Длинную Бровь на северо-востоке от дозора Чжу.‡Sucht nach Yi-Mo Langbraue irgendwo nordöstlich von Zhus Wacht.‡쥬의 감시초소 북동쪽에 있는 이모우 롱브라우를 찾아야 합니다. 레벨 15 크라사랑 밀림‡Busca a Yi-Mo Frente Ancha por algún lugar al noreste de la Atalaya de Zhu.‡‡Cherchez Yi Mo Long Front quelque part au nord-est du Guet de Zhu.‡前往朱家堡的东北方寻找易默·长眉。‡',
  }
},
[30081] = {
  {
    'Matéria Médica‡Народная медицина‡Materia Medica‡약방문‡Materia médica‡‡Pharmacopée‡对症下药‡',
    nil,
    'Consiga 4 Blocos de Favos de Mel, 4 Muçuns Escorregadios e 4 Núcleos Salgados na Província de Zhu. Uma‡Соберите 4 комка медовых сот, 4 скользких ильных рыбы и 4 соляных глыбы в Провинции Чжу.‡Sammelt 4 Stücke einer Honigwabe, 4 glitschige Matschflosser und 4 salzige Kerne in der Zhu-Provinz.‡쥬 지구에서 벌집 덩어리, 미끈미끈 미꾸라지, 소금 결정을 각각 4개씩 모아야 합니다. 레벨 15 크라사랑 밀림‡Reúne 4 trozos de panal, 4 pezfangos escurridizos y 4 núcleos salados de la provincia Zhu.‡‡Récupérez 4 Morceaux de rayon de miel, 4 Éperlans luisants et 4 Noyaux salés dans la Province de Zhu.‡在朱家界收集4块蜂巢、4条滑溜的泥鱼和4块岩盐核心。‡',
  }
},
[30082] = {
  {
    'Se anima, Uwe-Mo‡Выше нос, И-Мо‡Kopf hoch, Yi-Mo‡힘을 내요, 이모우‡Anímate, Yi-Mo‡‡Haut les cœurs, Yi Mo !‡振作起来，易默‡',
    nil,
    'Leve Yi-Mo Franja Longa até a Vigia de Zhu. Uma‡Верните И-Мо Длинную Бровь обратно в дозор Чжу.‡Bringt Yi-Mo Langbraue zurück nach Zhus Wacht.‡이모우를 쥬의 감시초소로 데려가야 합니다. 레벨 15 크라사랑 밀림‡Lleva a Yi-Mo Frente Ancha de vuelta a la Atalaya de Zhu.‡‡Ramenez Yi Mo Long Front au Guet de Zhu.‡将易默·长眉带回朱家堡。‡',
  }
},
[30083] = {
  {
    'A segurança da província‡Защита провинции‡Sicherung der Provinz‡쥬 지구를 사수하라‡Protegiendo la provincia‡‡Sécuriser la province‡保卫朱家界‡',
    nil,
    'Mate 10 Sauroks Escamas Selvagens ou Herboristas Escamas Selvagens na Província de Zhu. Uma‡Убейте 10 cауроков или сборщиков трав из племени Дикой Чешуи в Провинции Чжу. задание.‡Tötet 10 Saurok oder Kräuterkundige der Wildschuppen in der Provinz Zhu.‡쥬 지구에 있는 야생비늘 사우록 또는 야생비늘 약초채집꾼을 10마리 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 10 saurok Escama Salvaje o herbalistas Escama Salvaje en la provincia Zhu.‡‡Tuez 10 Sauroks écailles-sauvages ou Herbalistes écailles-sauvages dans la Province de Zhu.‡在朱家界里击败10个野鳞蜥蜴人或野鳞草药师。‡',
  }
},
[30084] = {
  {
    'A fronteira‡На границе‡Grenzlande‡변방‡Zonas fronterizas‡‡Les frontières‡边境‡',
    nil,
    'Acenda a Chama Memorial de Zhu, a Chama Memorial de Rin e a Chama Memorial de Po na fronteira sudoeste da Província de Zhu. Uma‡Зажгите мемориальный огонь Чжу, мемориальный огонь Жинь и мемориальный огонь По вдоль юго-западной границы Провинции Чжу.‡Entzündet die Gedenkflamme von Zhu, die Gedenkflamme von Rin und die Gedenkflamme von Po entlang der südwestlichen Grenze der Zhu-Provinz.‡쥬 지구 남서쪽 경계를 따라 위치한 쥬의 추모 화로, 린의 추모 화로, 포의 추모 화로에 불을 지펴야 합니다.‡Enciende la llama honorífica de Zhu, la llama honorífica de Rin y la llama honorífica de Po a lo largo de la frontera suroeste de la provincia Zhu.‡‡Allumez la Flamme du souvenir de Zhu, la Flamme du souvenir de Rin et la Flamme du souvenir de Po le long de la frontière sud-ouest de la Province de Zhu.‡沿着朱家界西南边界点燃朱的纪念之火、林的纪念之火和珀的纪念之火。‡',
  }
},
[30085] = {
  {
    'Rumo à cervejaria‡Вперед, в хмелеварню‡In der Brauerei‡양조장 안으로‡En la cervecería‡‡Dans la brasserie‡进入酒坊‡',
    nil,
    'Fale com Chen Malte do Trovão na Cervejaria Malte do Trovão. Uma‡Поговорите с Чэнем Буйный Портером в хмелеварне Буйных Портеров.‡Sprecht mit Chen Sturmbräu in der Brauerei Sturmbräu.‡스톰스타우트 양조장 안에 있는 첸 스톰스타우트와 대화해야 합니다. 레벨 15 스톰스타우트 양조장‡Habla con Chen Cerveza de Trueno en la Cervecería del Trueno.‡‡Parlez à Chen Brune d’Orage dans la Brasserie Brune d’Orage.‡和风暴烈酒酿造厂里的陈·风暴烈酒谈一谈。‡',
  }
},
[30086] = {
  {
    'A busca pelo mestre oculto‡Поиски тайного мастера‡Die Suche nach dem verborgenen Meister‡은둔 고수를 찾아서‡La búsqueda del maestro oculto‡‡À la recherche du maître perdu‡寻找隐秘大师‡',
    nil,
    'Ouça Xiao e os companheiros dele. Uma‡Выслушайте Сяо и его товарищей.‡Hört Euch das Gespräch zwischen Xiao und seinen Freunden an.‡샤오와 동료의 이야기를 들어야 합니다. 레벨 15 네 바람의 계곡‡Escucha a Xiao y a sus acompañantes.‡‡Écoutez Xiao et ses compagnons.‡倾听晓和他同伴们的谈话。‡',
  }
},
[30087] = {
  {
    'BANDEIRA - Introdução do Kung Fu‡Кунг-фу: вступление‡FLAG - Kung Fu-Intro‡플래그 - 쿵푸 인트로‡FLAG - Introducción al kung fu‡‡FLAG - Kung Fu Intro‡FLAG—功夫介绍‡',
    nil,
    'Ouça Xiao e os companheiros dele. Vale dos Quatro Ventos de‡Выслушайте Сяо и его товарищей.‡Hört Euch das Gespräch zwischen Xiao und seinen Freunden an.‡샤오와 동료의 이야기를 들어야 합니다. 네 바람의 계곡‡Escucha a Xiao y a sus acompañantes.‡‡Écoutez Xiao et ses compagnons.‡倾听晓和他同伴们的谈话。‡',
  }
},
[30088] = {
  {
    'Por que tão sério?‡Что за грусть-печаль?‡Warum so ernst?‡뭐가 그리 심각해?‡¿Por qué tan serio?‡‡Pourquoi être si sérieux ?‡干嘛这么严肃？‡',
    nil,
    'Consiga 18 Presas de Pantera Enormes e 1 Jarro de Pigmento da Província de Zhu. Uma‡Достаньте 18 огромных клыков пантеры и один кувшин с красителем в провинции Чжу.‡Sammelt 18 riesige Pantherreißzähne und 1 Pigmentkrug aus der Provinz Zhu.‡쥬 지구에서 커다란 호랑이 송곳니 18개와 안료 단지 1개를 모아야 합니다. 레벨 15 크라사랑 밀림‡Consigue 18 colmillos de pantera enormes y 1 jarra de pigmento de la provincia Zhu.‡‡Récupérez 18 Énormes crocs de panthère et 1 Pot de pigment dans la Province de Zhu.‡从朱家界收集18颗巨大的豹牙和1罐颜料。‡',
  }
},
[30089] = {
  {
    'Aplicar diretamente na testa‡Прикрепить на лоб‡Ein Brett vor dem Kopf‡이마에 직접 붙이세요‡Aplicar directamente en la frente‡‡Appliquez directement sur le front‡变相怪杰‡',
    nil,
    'Use a Máscara de Ken-Ken para curar 8 Guardiões de Zhu Desanimados na Vigia de Zhu. Uma‡Излечите с помощью маски Кен-Кена 8 подавленных смотрителей Чжу в дозоре Чжу.‡Setze Ken-Kens Maske ein, um 8 bedrückte Wächter von Zhu in Zhus Wacht zu heilen.‡쥬의 감시초소에 있는 실의에 빠진 쥬의 감시자 8명에게 컨컨의 가면을 사용해야 합니다. 레벨 15 크라사랑 밀림‡Utiliza la máscara de Ken-Ken para curar a 8 celadores de Zhu decaídos en la Atalaya de Zhu.‡‡Utilisez le Masque de Ken-Ken pour soigner 8 Gardiens de Zhu déprimés au Guet de Zhu.‡在朱家堡使用肯肯的面具，治愈8名沮丧的朱家戒卫。‡',
  }
},
[30090] = {
  {
    'Desespero de Zhu‡Отчаяние Чжу‡Zhus Verzweiflung‡쥬의 절망‡La desesperación de Zhu‡‡Le désespoir de Zhu‡朱家堡的绝望‡',
    nil,
    'Exorcize a energia do Sha do Desespero que possuiu Yi-Mo Franja Longa na Vigia de Zhu. Uma‡Избавьте И-Мо Длинную Бровь в дозоре Чжу от Ша Отчаяния.‡Exorziert das Sha der Verzweiflung aus Yi-Mo Langbraue in Zhus Wacht.‡쥬의 감시초소에 있는 이모우 롱브라우에게서 절망의 샤를 몰아내야 합니다. 레벨 15 크라사랑 밀림‡Exorciza la energía de sha de la desesperación de Yi-Mo Frente Ancha en la Atalaya de Zhu.‡‡Exorcisez l’énergie du Sha du désespoir hors de Yi Mo Long Front au Guet de Zhu.‡在朱家堡驱除易默·长眉体内的惘之煞能量。‡',
  }
},
[30091] = {
  {
    'Lágrimas de Pandária‡Слезы Пандарии‡Tränen von Pandaria‡판다리아의 눈물‡Lágrimas de Pandaria‡‡Les larmes de la Pandarie‡潘达利亚之泪‡',
    nil,
    'Mate 12 Horrores Chorosos na Província de Zhu. Uma‡Убейте 12 стенающих ужасов в Провинции Чжу.‡Tötet 12 weinende Schrecken in der Zhu-Provinz.‡쥬 지구에서 흐느끼는 공포 12마리를 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 12 horrores sollozantes en la provincia Zhu.‡‡Tuez 12 Horreurs éplorées dans la Province de Zhu.‡在朱家界杀死12只悲泣恐魔。‡',
  }
},
[30092] = {
  {
    '‡Свой человек в Гилнеасе‡Der Spitzel von Gilneas‡길니아스에 있는 요원‡Nuestro hombre en Gilneas‡‡Notre homme se trouve à Gilnéas‡吉尔尼斯的密探‡',
    nil,
    '‡Найдите Заззо Пальцемелька неподалеку от руин столицы Гилнеаса.‡Macht Zazzo Glitzerfinger nahe der Ruinen von Gilneas in Gilneas ausfindig.‡길니아스의 길니아스 시 폐허에서 자조 트윙클핑거스를 찾아야 합니다.‡Busca a Zazzo Dedocentella cerca de las Ruinas de la Ciudad de Gilneas, en Gilneas.‡‡Recherchez Zazzo Doigts-d\'Or près des Ruines de Gilnéas, en Gilnéas.‡在吉尔尼斯的吉尔尼斯城废墟附近找到扎佐·耀指。‡',
  }
},
[30093] = {
  {
    '‡Убийца Кредо‡Altair assassinieren‡크리드를 암살하라‡Asesinar a Creed‡‡Assassinez Credo‡刺杀信条‡',
    nil,
    '‡Незаметно проберитесь в руины столицы Гилнеаса и убейте Хайрама Кредо; он находится в военном квартале.‡Schleicht Euch in die Ruinen von Gilneas und tötet Hiram Altair im Militärviertel.‡길니아스 시 폐허로 은신해 들어간 후 군사 지구에서 히람 크리드를 처치해야 합니다.‡Cuélate en las Ruinas de la Ciudad de Gilneas y mata a Hiram Creed en el Distrito Militar.‡‡Faufilez-vous discrètement dans les Ruines de Gilnéas et tuez Hiram Credo dans le Secteur militaire.‡潜入吉尔尼斯城废墟，杀死躲藏在军事区中的“信条”海勒姆。‡',
  }
},
[30094] = {
  {
    '‡Конец Времен‡Die Endzeit‡시간의 끝‡El Fin de los Días‡‡La Fin des temps‡时光之末‡',
    nil,
    '‡Поговорите с Ноздорму в Конце Времен.‡Sprecht mit Nozdormu in der Endzeit.‡시간의 끝에서 노즈도르무와 대화해야 합니다.‡Habla con Nozdormu en el Fin de los Días.‡‡Parlez à Nozdormu à la Fin des temps.‡和时光之末中的诺兹多姆谈一谈。‡',
  }
},
[30095] = {
  {
    '‡Конец Времен‡Die Endzeit‡시간의 끝‡El Fin de los Días‡‡La Fin des temps‡时光之末‡',
    nil,
    '‡Поговорите с Ноздорму в Конце Времен.‡Sprecht mit Nozdormu in der Endzeit.‡시간의 끝에서 노즈도르무와 대화해야 합니다.‡Habla con Nozdormu en el Fin de los Días.‡‡Parlez à Nozdormu à la Fin des temps.‡和时光之末中的诺兹多姆谈一谈。‡',
  }
},
[30096] = {
  {
    '‡Дорнозму‡‡무르도즈노‡‡‡‡姆诺兹多‡姆多茲諾',
    nil,
    '‡Убейте Дорнозму.‡Tötet Murozond.‡무르도즈노를 처치해야 합니다.‡Mata a Murozond.‡‡Tuez Murozond.‡杀死姆诺兹多。‡',
  }
},
[30097] = {
  {
    '‡Пополнение архива‡Hilfsarchivar‡보존 목적‡Para que conste‡‡Destiné à l\'archivage‡备份需要‡',
    nil,
    '‡Уничтожьте два эха в Конце Времен, позволив сосуду Алурми сохранить информацию о них.‡Tötet zwei der Echos in der Endzeit und gebt Alurmis Behältnis die Gelegenheit, ihre Informationen zu archivieren.‡시간의 끝 안에서 환영 두 개를 처치한 뒤 알룰미의 단지를 이용해 정보를 보존해야 합니다.‡Mata a dos de los Ecos en el Fin de los Días y deja que la vasija de Alurmi archive su información.‡‡Tuez deux échos à la Fin des temps, puis laissez le Calice d\'Alurmi archiver leurs informations.‡在时光之末中杀死两个残影，并使用艾鲁尔米的容器备份他们的信息。‡',
  }
},
[30098] = {
  {
    '‡Источник Вечности‡Der Brunnen der Ewigkeit‡영원의 샘‡El Pozo de la Eternidad‡‡Le Puits d\'éternité‡永恒之井‡',
    nil,
    '‡Поговорите с Ноздорму у Источника Вечности.‡Sprecht mit Nozdormu am Brunnen der Ewigkeit.‡영원의 샘에서 노즈도르무와 대화해야 합니다.‡Habla con Nozdormu en el Pozo de la Eternidad.‡‡Parlez à Nozdormu au Puits d\'Éternité.‡与永恒之井中的诺兹多姆谈一谈。‡',
  }
},
[30099] = {
  {
    '‡Им нет числа‡In Scharen‡끝없는 적군‡En número interminable‡‡En nombres infinis‡无穷无尽‡',
    nil,
    '‡Закройте три демонических портала и убейте Перот\'арна.‡Deaktiviert die drei Dämonenportale und erschlagt dann Peroth\'arn.‡악마의 차원문 3개를 멈추고 페로스안을 처치해야 합니다.‡Desactiva los tres portales demoníacos y, después, mata a Peroth\'arn.‡‡Neutralisez les trois portails démoniaques, puis tuez Peroth\'arn.‡关闭三座恶魔传送门，然后杀死佩罗萨恩。‡',
  }
},
[30100] = {
  {
    '‡Тщеславие‡Die Selbstherrlichen‡자만심‡La vanagloriosa‡‡La vaniteuse‡虚荣的女王‡',
    nil,
    '‡Не дайте королеве Азшаре помешать вашим планам.‡Beseitigt Königin Azshara.‡아즈샤라 여왕을 물리쳐야 합니다.‡Deshazte de la reina Azshara.‡‡Débarrassez-vous de la Reine Azshara.‡拖住艾萨拉女王。‡',
  }
},
[30101] = {
  {
    '‡Путь к Душе Дракона‡Der Weg zur Drachenseele‡용의 영혼으로 가는 길‡El camino al Alma de dragón‡‡Le chemin de l\'Âme des dragons‡通往巨龙之魂的道路‡',
    nil,
    '‡Убейте Маннорота.‡Tötet Mannoroth.‡만노로스를 처치해야 합니다.‡Mata a Mannoroth.‡‡Tuez Mannoroth.‡杀死玛诺洛斯。‡',
  }
},
[30102] = {
  {
    '‡Время Сумерек‡Die Stunde des Zwielichts‡황혼의 시간‡La Hora del Crepúsculo‡‡L\'Heure du Crépuscule‡暮光审判‡',
    nil,
    '‡Поговорите с Траллом во Времени Сумерек.‡Sprecht mit Thrall in der Stunde des Zwielichts.‡황혼의 시간에 있는 스랄과 대화해야 합니다.‡Habla con Thrall en la Hora del Crepúsculo.‡‡Parlez à Thrall à l\'Heure du Crépuscule.‡与暮光审判中的萨尔谈一谈。‡',
  }
},
[30103] = {
  {
    '‡В Храм Драконьего Покоя!‡Auf zum Wyrmruhtempel!‡고룡쉼터로!‡¡Al Reposo del Dragón!‡‡Au Repos du ver !‡进军龙眠神殿！‡',
    nil,
    '‡Сопроводите Тралла в Храм Драконьего Покоя.‡Eskortiert Thrall sicher zum Wyrmruhtempel.‡스랄을 고룡쉼터 사원까지 안전하게 호위해야 합니다.‡Escolta a Thrall para que llegue a salvo al Templo del Reposo del Dragón.‡‡Escortez Thrall jusqu\'au temple du Repos du ver.‡护送萨尔安全抵达龙眠神殿。‡',
  }
},
[30104] = {
  {
    '‡Архивация временных потоков‡Dokumentation der Zeitwege‡시간의 흐름 문서화‡Documentar los portales del tiempo‡‡Cartographier les voies temporelles‡记录时间流‡',
    nil,
    '‡Убейте демона Легиона, королевскую фрейлину и капитана Варо\'тена, при этом собрав информацию о них с помощью сосуда Алурми.‡Tötet einen Dämon der brennenden Legion, eine königliche Hofdame und Hauptmann Varo\'then und gebt Alurmis Behältnis die Gelegenheit, ihre Informationen zu archivieren.‡군단 악마, 왕실 시녀, 그리고 대장 바로덴을 처치한 뒤 알룰미의 단지에 그들의 정보를 담아야 합니다.‡Mata a un demonio de la Legión, a una fámula real y al capitán Varo\'then. Luego deja que la vasija de Alurmi archive la información.‡‡Tuez un Démon de la Légion, une Suivante royale et le Capitaine Varo\'then, puis laissez le Calice d\'Alurmi archiver leurs informations.‡杀死一个军团恶魔，一个皇家侍女以及禁卫队长瓦罗森，然后用艾鲁尔米的容器收集他们的信息。‡',
  }
},
[30105] = {
  {
    '‡Сумеречный Пророк‡Der Zwielichtprophet‡황혼의 예언자‡El profeta Crepuscular‡‡Le prophète du Crépuscule‡暮光先知‡',
    nil,
    '‡Найдите Сумеречного Пророка и сорвите с него маску.‡Findet und enttarnt den Zwielichtpropheten.‡황혼의 예언자를 찾아 정체를 밝혀야 합니다.‡Encuentra y desenmascara al profeta Crepuscular.‡‡Trouvez et démasquez le Prophète du Crépuscule.‡找到并揭露暮光先知的身份。‡',
  }
},
[30106] = {
  {
    '‡Дело сделано‡Es ist vollbracht‡폭파 완료‡Ya está hecho‡‡C\'est chose faite‡任务完成‡',
    nil,
    '‡Доложите о своей победе принцу Гневиону в поместье Черного Ворона, что в предгорьях Хилсбрада.‡‡‡‡‡‡‡',
  }
},
[30107] = {
  {
    '‡В поисках самоцветов‡Gelege im Gehege‡보석 갈무리‡Por un puñado de gemas‡‡Chopez les chapelets‡收集宝石簇‡',
    nil,
    '‡"Соберите 333 темных самоцвета из скоплений элементиевых самоцветов в рейде "Душа Дракона"."‡Sammelt 333 schattenhafte Edelsteine durch das Plündern von Elementiumedelsteinformationen von den Kreaturen in der Drachenseeleninstanz.‡용의 영혼 공격대 던전에서 몬스터를 처치하고 엘레멘티움 보석 덩어리를 얻어 그림자 보석을 333개 모아야 합니다.‡Obtén 333 gemas enigmáticas saqueando cúmulos de gemas de elementium de las criaturas del encuentro de banda Alma de Dragón.‡‡Recueillez 333 Gemmes ténébreuses en ramassant des Chapelets de gemmes en élémentium sur les créatures rencontrées au cours du raid de l\'Âme des dragons.‡在巨龙之魂团队副本内，从怪物身上收集源质宝石簇，并取得333颗暗影宝石。‡',
  }
},
[30108] = {
  {
    '‡Свой человек в Каражане‡Der Spitzel von Karazhan‡카라잔에 있는 동족‡Nuestro hombre en Karazhan‡‡Notre homme se trouve à Karazhan‡‡',
    nil,
    '‡Доложитесь Заззо Пальцемельку в руинах на юго-востоке от Каражана.‡Meldet Euch bei Zazzo Glitzerfinger in den Ruinen südöstlich von Karazhan.‡카라잔 남동쪽에서 자조 트윙클핑거스에게 보고해야 합니다.‡Preséntate ante Zazzo Dedocentella en las ruinas justo al sureste de Karazhan.‡‡Faites votre rapport à Zazzo Doigts-d\'Or dans les ruines au sud-est de Karazhan.‡‡',
  }
},
[30109] = {
  {
    '‡Кровь предателя‡Blut des Verräters‡배신자의 피‡La sangre de la traidora‡‡Le sang de la traîtresse‡‡',
    nil,
    '‡Проникните в хозяйский погреб в руинах вокруг Каражана, убейте Нэлис и добудьте фиал с кровью черного дракона.‡Schleicht Euch in den Keller des Meisters in den Ruinen um Karazhan, besiegt Yntrige und beschafft Euch eine Phiole mit schwarzem Drachenblut.‡카라잔 폐허에 있는 지배자의 지하실에 숨어들어, 날리스를 처치하고 검은용 피가 담긴 약병을 획득해야 합니다.‡Cuélate en el Sótano del Maestro, en las ruinas alrededor de Karazhan, derrota a Nalice y consigue un vial de sangre de dragón negra.‡‡Pénétrez discrètement dans la cave du Maître, dans les ruines autour de Karazhan, tuez Nalice et récupérez une Fiole de sang de dragon noir.‡‡',
  }
},
[30110] = {
  {
    'Localizador de Raides (1º)‡Raid Finder (1st)‡Raid Finder (1st)‡일일 2단계 영웅 (1번째)‡Buscador de bandas (1º)‡Buscador de bandas (1º)‡Outil Raids (1e)‡团队查找器（第一次）‡Raid Finder (1st)',
    nil,
    nil,
  }
},
[30111] = {
  {
    'Localizador de Raides (No.)‡Raid Finder (Nth)‡Raid Finder (Nth)‡일일 2단계 영웅 (1번째)‡Buscador de bandas (Nº)‡Buscador de bandas (Nº)‡Outil Raids (suivants)‡团队查找器（第N次）‡Raid Finder (Nth)',
    nil,
    nil,
  }
},
[30112] = {
  {
    'Ajuste de contas‡Сведение счетов‡Eine Rechnung begleichen‡받은 만큼 돌려주기‡Ajuste de cuentas‡Ajuste de cuentas‡Un compte à régler‡旗开得胜‡有待解決的宿怨',
    nil,
    'A Patrulheira Sombria Marrah quer que você mate o Príncipe Keleseth na Bastilha Utgarde.‡Темный следопыт Марра повелела вам отправиться в Утгард и убить принца Келесета.‡Dunkelläuferin Marrah möchte, dass Ihr Prinz Keleseth in Burg Utgarde tötet.‡어둠 순찰자 마라가 우트가드 성채에서 공작 켈레세스를 처치해 달라고 했습니다.‡La forestal oscura Marrah quiere que mates al príncipe Keleseth en la Fortaleza de Utgarde.‡La forestal oscura Marrah quiere que mates al príncipe Keleseth en la Fortaleza de Utgarde.‡Le Forestier-sombre Marrah vous demande de tuer le prince Keleseth à l’intérieur du Donjon d\'Utgarde.‡黑暗游侠玛尔拉要求你进入乌特加德城堡，杀死凯雷塞斯王子。‡黑暗遊俠瑪拉要你進入俄特加德要塞並殺掉凱雷希斯親王。',
  }
},
[30113] = {
  {
    '‡Из глубин – с победой‡Sieg in den Tiefen‡깊은 곳에서의 승리‡Victoria en las profundidades‡‡Victoire dans les profondeurs‡深渊中的胜利‡',
    nil,
    '‡Отнесите фиал с кровью черного дракона, а также кинжалы "Страх" и "Воздаяние" Гневиону в поместье Черного Ворона, что в предгорьях Хилсбрада.‡Bringt die Phiole mit konserviertem Drachenblut und Eure Dolche Furcht und Rache zu Furorion im Rabenholdtanwesen im Vorgebirge des Hügellands.‡보존된 용 피가 담긴 약병, 공포, 복수를 언덕마루 구릉지의 라벤홀트 장원에 있는 래시온에게 가져가야 합니다.‡Lleva el vial de sangre de dragón conservada, junto con tus dagas Miedo y Venganza, a Wrathion en la Mansión Ravenholdt en las Laderas de Trabalomas.‡‡Apportez la Fiole de sang de dragon préservé, ainsi que vos dagues Terreur et Vengeance à Irion, au Manoir de Ravenholdt, dans les Contreforts de Hautebrande.‡将一瓶密封的黑龙血以及你的双匕恐惧与复仇一起交给希尔斯布莱德丘陵的拉文霍德庄园里的拉希奥。‡',
  }
},
[30116] = {
  {
    '‡Заостряя клыки‡Wetzt Eure Klauen‡송곳니를 다듬고‡Afílate los colmillos‡‡Aiguiser vos crocs‡磨利你的牙‡',
    nil,
    '‡Соберите 60 скоплений элементиевых самоцветов в рейде "Душа Дракона".‡Sammelt 60 Elementiumedelsteinformationen von den Kreaturen in der Drachenseeleninstanz.‡용의 영혼 공격대 던전에서 엘레멘티움 보석 덩어리 60개를 모아야 합니다.‡Recoge 60 cúmulos de gemas de elementium de las criaturas del encuentro de banda Alma de Dragón.‡‡Récoltez 60 Chapelets de gemmes en élémentium sur des créatures rencontrées au cours du raid de l\'Âme des dragons.‡在巨龙之魂团队副本内，从怪物身上收集60个源质宝石簇。‡',
  }
},
[30117] = {
  {
    'Descendo redondo em Arado de Pedra‡Жажда Каменного Плуга‡Steinpflug ist durstig‡돌밭 갈증‡Sedientos en Villarroca‡‡Chasse-Pierre a soif‡石犁村的渴望‡',
    nil,
    'Entregue um barril da Imperador a Lun Mai em Arado de Pedra, que fica no Vale dos Quatro Ventos. Uma‡Доставьте бочонок "Императора" Лун Маю в Каменный Плуг, что в долине Четырех Ветров.‡Liefert ein Fässchen Kaiserbier an Lun Mai in Steinpflug im Tal der Vier Winde.‡네 바람의 계곡의 돌밭에 있는 룬 마이에게 황제 맥주통을 가져다줘야 합니다. 레벨 15 네 바람의 계곡‡Entrega un tonel de El Emperador a Loon Mai en Villarroca, en el Valle de los Cuatro Vientos.‡‡Livrez un Fût de l’Empereur à Loon Mai à Chasse-Pierre, dans la Vallée des Quatre vents.‡将一小桶“帝王酒”送给四风谷石犁村的麦龙。‡',
  }
},
[30118] = {
  {
    '‡Отцеубийство‡‡죄 많은 아버지‡‡‡‡‡',
    nil,
    '‡Убейте Смертокрыла и получите фрагмент его челюсти.‡Vernichtet Todesschwinge und bergt ein Fragment von seinem Kiefer.‡데스윙을 처치하고 데스윙의 턱뼈 조각을 획득해야 합니다.‡Acaba con Alamuerte y hazte con un fragmento de su mandíbula.‡‡Tuez Aile de mort et récupérez un Morceau de la mâchoire d\'Aile de mort.‡销毁死亡之翼并获取死亡之翼的片段。‡',
  }
},
[30119] = {
  {
    '‡‡‡영원의 샘 RP추적용‡Pozo de la Eternidad RP Tracker‡‡‡‡',
    nil,
    '‡Заберите из Огненных Просторов ветвь Нордрассила.‡Erlangt den Zweig von Nordrassil aus den Feuerlanden zurück.‡불의 땅에서 놀드랏실의 가지를 되찾아야 합니다.‡Recupera la rama de Nordrassil de las Tierras de Fuego.‡‡Récupérez la Branche de Nordrassil dans les Terres de Feu.‡去火焰之地夺回诺达希尔的分枝。‡',
  }
},
[30120] = {
  {
    'A limpeza de Drak\'Tharon‡Очищение Драк\'Тарона‡Die Reinigung Drak\'Tharons‡드락타론 정화‡Limpiar Drak\'Tharon‡Limpiar Drak\'Tharon‡La purification de Drak\'Tharon‡净化达克萨隆‡淨化德拉克薩隆',
    nil,
    'Drakuru quer que você use o Elixir de Drakuru no braseiro dentro de Drak\'Tharon. Para usar o Elixir do Drakuru, você precisará de 5 Mojos Implacáveis.‡Дракуру просит вас выпить эликсир возле его жаровни в Драк\'Тароне. Для использования эликсира вам понадобится пять настоев терпения.‡Drakuru möchte, dass Ihr Drakurus Elixier an seinem Kohlenbecken innerhalb Drak\'Tharons benutzt. Um das Elixier dort benutzen zu können, benötigt Ihr 5 Ausdauermojos.‡드라쿠루가 드락타론 성채 안에 있는 자신의 화로에서 드라쿠루의 비약을 사용해 달라고 했습니다. 성채에서 드라쿠루의 비약을 사용하려면 인내의 모조 5개가 필요합니다.‡Drakuru quiere que uses el elixir de Drakuru en su pedestal dentro de Drak\'Tharon. Para usar el elixir de Drakuru ahí vas a necesitar 5 mojos de resistencia.‡Drakuru quiere que uses el elixir de Drakuru en su pedestal dentro de Drak\'Tharon. Para usar el elixir de Drakuru ahí vas a necesitar 5 mojos de resistencia.‡Drakuru veut que vous utilisiez l’Élixir de Drakuru au piédestal qui se trouve dans Drak’Tharon. Pour ce faire, vous aurez besoin de 5 Mojos endurcis.‡达库鲁要求你前往达克萨隆，并对他的火盆使用达库鲁的药剂。使用达库鲁的药剂需要消耗5份耐久魔精。‡德拉庫魯需要你在德拉克薩隆的火盆上使用德拉庫魯的藥劑。你需要五個耐久魔精才能使用德拉庫魯的藥劑。',
  }
},
[30121] = {
  {
    'Grupo de busca‡Поисковый отряд‡Suchtrupp‡수색대‡Partida de búsqueda‡‡Le groupe de recherche‡搜索小分队‡',
    nil,
    'Vasculhe as Ruínas Krasari em busca de Chezin Caça-manhã. Uma‡Найдите в Красарангских руинах Чэцзыня Искателя Зари.‡Sucht in den Krasariruinen nach Chezin Morgenjäger.‡크라사리 폐허에서 체진 돈체이서를 찾아야 합니다. 레벨 15 크라사랑 밀림‡Busca a Chezin Senda Lejana en las Ruinas Krasari.‡‡Cherchez Chezin Chasselaube dans les Ruines de Krasari.‡在卡桑利废墟中搜寻切森·逐晨者。‡',
  }
},
[30123] = {
  {
    'Ensopado de rastejante‡Похлебка из быстролапов‡Huschereintopf‡소금쟁이 찌개‡Estofado arácnido‡‡Le râgout de glisseuse‡飞掠者炖肉‡',
    nil,
    'Junte 5 Glândulas de Rastejante Intactas. Uma‡Соберите 5 целых желез быстролапов.‡Sammelt 5 unversehrte Huscherdrüsen.‡온전한 소금쟁이 분비선을 5개 모아야 합니다. 레벨 15 크라사랑 밀림‡Reúne 5 glándulas de arácnida intactas.‡‡Rassemblez 5 Glandes de glisseuse intactes.‡收集5个完整的飞掠者腺体。‡',
  }
},
[30124] = {
  {
    'Cegue-os!‡Ослепить их!‡Blendet sie!‡놈들의 눈을 가려라!‡¡Ciégalos!‡‡Aveuglez-les !‡敌明我暗！‡',
    nil,
    'Mate a Escolta Darnassiana. Uma‡Убейте дарнасского разбойника.‡Tötet die Vorreiterin von Darnassus.‡다르나서스 척후병을 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a la escolta darnassiana.‡‡Tuez le Voltigeur darnassien.‡击败达纳苏斯先锋。‡',
  }
},
[30125] = {
  {
    'Maestria do lucro‡В погоне за прибылью‡Meisterlicher Profit‡‡Maestría rentable‡‡La maîtrise des profits‡‡',
    nil,
    'Consiga 12 Ampolas de Sangue de Tigre. Uma‡Соберите 12 сосудов тигриной крови.‡Besorgt 12 mit Tigerblut gefüllte Phiolen.‡‡Consigue 12 viales de sangre de tigre.‡‡Obtenez 12 Fioles de sang de tigre.‡‡',
  }
},
[30126] = {
  {
    'Maestria da envergadura moral‡Мастерство журавля‡Kranich-Meisterschaft‡‡Dominio de grullas‡‡La maîtrise des grues‡‡',
    nil,
    'Mate 8 Pega-carpas. Uma‡Убейте 8 ловцов карпов.‡Tötet 8 Karpfenjäger.‡‡Mata a 8 pescadores de carpas.‡‡Tuez 8 Chasseurs de carpes.‡‡',
  }
},
[30127] = {
  {
    'Ameaça de Dojan‡Руины Доцзян‡Bedrohung aus Dojan‡도잔의 위협‡Amenaza desde Dojan‡‡La menace qui venait de Dojan‡都阳的威胁‡',
    nil,
    'Mate 6 Recuperadores Dojani, 8 Topógrafos Dojani e 4 Impositores Dojani. Uma‡Убейте 6 искателей из Доцзяна, 8 разведчиков из Доцзяна и 4 головорезов из Доцзяна.‡Tötet 6 Dojanieroberer, 8 Dojanispäher und 4 Dojanivollstrecker.‡도자니 수복병 6명, 도자니 감독관 8명, 도자니 집행자 4명을 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 6 reivindicadores Dojani, a 8 peritos Dojani y a 4 déspotas Dojani.‡‡Tuez 6 Récupérateurs dojani, 8 Géomètres dojani et 4 Massacreurs dojani.‡击败6个都阳复国者，8个都阳勘测者和4个都阳暴徒。‡',
  }
},
[30128] = {
  {
    'As fontes da juventude‡Пруд Молодости‡Die Teiche der Jugend‡젊음의 웅덩이‡Las Pozas de la Juventud‡‡Les bassins de la Jeunesse‡青春之池‡',
    nil,
    'Busque água nas Fontes da Juventude. Uma‡Добудьте воду из Пруда Молодости.‡Besorgt Wasser aus den Teichen der Jugend.‡젊음의 웅덩이에서 물을 가져와야 합니다. 레벨 15 크라사랑 밀림‡Recoge agua de las Pozas de la Juventud.‡‡Récupérez l’eau des Bassins de la Jeunesse.‡获得青春之池中的泉水。‡',
  }
},
[30129] = {
  {
    'Os planos dos mogus‡Тайный план могу‡Die Moguagenda‡모구의 꿍꿍이‡Los planes de los mogu‡‡Le plan des mogu‡魔古的阴谋‡',
    nil,
    'Traga as Ordens dos Dojani. Uma‡Раздобудьте доцзянские приказы.‡Bergt die Dojani-Befehle.‡도자니 명령서를 찾아야 합니다. 레벨 15 크라사랑 밀림‡Recupera las órdenes Dojani.‡‡Récupérez les Ordres dojani.‡找回都阳指令。‡',
  }
},
[30130] = {
  {
    'Fitoterápicos‡Целебные травы‡Heilkräuter‡약초 요법‡Remedios herbales‡‡Remèdes médicinaux‡草药治疗‡',
    nil,
    'Colha 20 Folhas de Lótus-imperial. Uma‡Соберите 20 листьев императорского лотоса.‡Sucht 20 Kaiserliche Lotusblätter.‡황제의 연꽃 잎을 20개 구해야 합니다. 레벨 15 크라사랑 밀림‡Encuentra 20 hojas de loto imperial.‡‡Trouvez 20 Feuilles de lotus impérial.‡收集20片霸王莲叶子。‡',
  }
},
[30131] = {
  {
    'Vida‡Жизнь‡Leben‡생명‡Vida‡‡La Vie‡生命‡',
    nil,
    'Fale com o Andarilho do Sol Dezco e aguarde o nascimento. Uma‡Поговорите со Служителем Солнца Дезко и дождитесь появления новорожденного.‡Sprecht mit Sonnenläufer Dezco und wartet auf die Geburt.‡태양길잡이 데즈코와 대화한 후, 아기가 태어나기를 기다려야 합니다. 레벨 15 크라사랑 밀림‡Habla con el caminasol Dezco y espera al recién nacido.‡‡Parlez au Marche-soleil Dezco et attendez l’arrivée du nouveau-né.‡和烈日行者德兹科谈一谈，并等待孩子的降生。‡',
  }
},
[30132] = {
  {
    'Rumo ao oeste‡На запад‡Auf in den Westen‡서쪽으로‡En marcha hacia el oeste‡‡Destination : l’ouest !‡一路向西‡',
    nil,
    'Encontre o Batedor Andarilho do Sol Perto do Templo da Garça. Uma‡Найдите разведчика Служителей Солнца у храма Журавля.‡Sucht die Späherin der Sonnenläufer in der Nähe des Kranichtempels.‡주학사 근처에 있는 태양길잡이 정찰병을 찾아야 합니다. 레벨 15 크라사랑 밀림‡Encuentra al explorador Caminasol cerca del Templo de la Grulla.‡‡Retrouvez l’Éclaireur Marche-Soleil près du Temple de la Grue.‡找到朱鹤寺附近的烈日行者斥候。‡',
  }
},
[30133] = {
  {
    'Rumo à selva‡Вперед, в глушь‡In die Wildnis‡밀림 속으로‡En la espesura‡‡Dans les étendues sauvages‡深入荒野‡',
    nil,
    'Localize o Mensageiro da Vigia de Zhu que está perdido na área norte do Rio Dojani. Em seguida, siga para o Templo da Garça Vermelha e fale com Koro Andarilho da Névoa.‡Найдите пропавшего посыльного дозора Чжу в северной части реки Доцзян, а затем отправляйтесь в храм Красного Журавля и поговорите с Коро Странником Туманов.‡Findet den vermissten Kurier aus Zhus Wacht am nördlichen Flusslauf des Dojani, begebt Euch dann zum Tempel des Roten Kranichs und sprecht mit Koro Nebelgänger.‡도자니 강 북쪽 지역에 있는 쥬의 감시초소 급사를 찾은 후, 주학사로 가서 코로 미스트워커와 대화해야 합니다.‡Busca al mensajero de la Atalaya de Zhu perdido en el área al norte del río Dojani. Luego, prosigue hasta el Templo de la Grulla Roja y habla con Koro Caminante Misterioso.‡‡Localisez le Courrier du guet de Zhu disparu au nord de la Rivière Dojani, puis continuez vers le Temple de la Grue rouge et parlez avec Koro Marche la Brume.‡在都阳河的北部流域找到失踪的朱家堡信使，然后继续前往朱鹤寺和科洛·迷雾行者谈一谈。‡',
  }
},
[30134] = {
  {
    'Onde vivem os eruditos‡Дикость‡Wildes in der Wildnis‡야생의 존재들‡Cosas salvajes‡‡Histoires naturelles‡局势失控‡',
    nil,
    'Encontre o Instrutor Tong na Ilha Ventaneira, que fica na Floresta de Jade. Uma‡Найдите инструктора Туна на Наветренном острове в Нефритовом лесу.‡Findet Ausbilder Tong auf der Windwärtsinsel im Jadewald.‡비취 숲의 바람맞이 섬에서 교관 통을 찾아야 합니다. 레벨 10 비취 숲‡Encuentra al instructor Tong en la Isla de Barlovento, en El Bosque de Jade.‡‡Trouvez l’Instructeur Tong sur l’Île Front-du-Vent, dans la Forêt de Jade.‡去翡翠林的临风岛找佟教头。‡',
  }
},
[30135] = {
  {
    'Derrubando probabilidades‡Удачный исход‡Entgegen aller Wahrscheinlichkeit‡용을 내 자식처럼‡Contra toda probabilidad‡‡Garde-chasse‡放手一搏‡',
    nil,
    'Mate 8 Estripadores Escamas-lisas ou Ovirráptores Escamas-lisas. Uma‡Убейте 8 потрошителей или яйцеедов из клана Скользкой Чешуи.‡Tötet 8 Reißer der Schlängelschuppen oder Eitrinker der Schlängelschuppen.‡뱀비늘 학살자 또는 뱀비늘 알도둑 8마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 8 desgarradores Reptaescama o bebedores ovíparos Reptaescama.‡‡Tuez 8 Déchireurs ou Aspire-œuf ondulécailles.‡击败8个滑鳞切裂者或滑鳞啜蛋者。‡',
  }
},
[30136] = {
  {
    'Ninhos vazios‡Опустевшие гнезда‡Leere Nester‡텅 빈 둥지‡Nidos vacíos‡‡Des nids vides‡空荡荡的巢穴‡',
    nil,
    'Capture 6 Filhotes Ventaneiros e leve-os de volta para seus ninhos. Uma‡Возьмите на поводок 6 детенышей облачного змея Наветренного острова и верните их в родные гнезда.‡Fangt 6 Windwärtsjungtiere mit dem Seil ein und bringt sie zurück in ihre Nester.‡새끼 바람맞이 운룡 6마리를 붙잡아 둥지에 데려와야 합니다. 레벨 10 비취 숲‡Ata a 6 proles de Barlovento y devuélvelas a sus nidos.‡‡Attrapez et reconduisez 6 Jeunes serpents de Front-du-Vent à leur nid.‡拴住6只临风雏龙并把它们送回家。‡',
  }
},
[30137] = {
  {
    'Coleção de ovos‡Сбор яиц‡Eier sammeln‡알 수집‡Recolección de huevos‡‡Ramassage d’œufs‡收集龙蛋‡',
    nil,
    'Recolha 6 Ovos de Serpente. Uma‡Соберите 6 яиц облачного змея.‡Sammelt 6 Schlangeneier ein.‡운룡 알 6개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 6 huevos de dragón.‡‡Ramassez 6 Œufs de serpent.‡收集6个翔龙蛋。‡',
  }
},
[30138] = {
  {
    'Um ovo para chamar de seu‡Избранный‡Das Auserwählte‡단 하나의 선택‡Elegir al elegido‡‡Choisir l’élu‡选择龙蛋‡',
    nil,
    'Fale com o Instrutor Tong na Ilha Ventaneira, que fica na Floresta de Jade. Uma‡Поговорите с инструктором Туном на Наветренном острове, что в Нефритовом лесу.‡Sprecht mit Ausbilder Tong auf der Windwärtsinsel im Jadewald.‡비취 숲의 바람맞이 섬에 있는 교관 통과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el instructor Tong en la Isla de Barlovento, en el Bosque de Jade.‡‡Parlez à l’Instructeur Tong sur l’Île Front-du-Vent, dans la Forêt de Jade.‡去翡翠林的临风岛和佟教头谈一谈。‡',
  }
},
[30139] = {
  {
    'A jornada do cavalgante‡Путешествие наездника‡Des Reiters Reise‡기수의 여정‡El viaje del jinete‡‡Le voyage du chevaucheur‡骑士之旅‡',
    nil,
    'Fale novamente com o Instrutor Espinho Celeste no Arboreto, na Floresta de Jade. Uma‡Вернитесь к инструктору Небесному Шипу, который находится в Дендрарии, в Нефритовом лесу.‡Kehrt zu Ausbilder Himmelsdorn im Arboretum im Jadewald zurück.‡비취 숲의 도원에 있는 교관 스카이쏜에게 가야 합니다. 레벨 10 비취 숲‡Reúnete con el instructor Punta Celeste en El Arboretum, en El Bosque de Jade.‡‡Retournez voir l’Instructeur Ronce du Ciel à l’Arboretum, dans la Forêt de Jade.‡回翡翠林的百木园找天荆教头。‡',
  }
},
[30140] = {
  {
    'A jornada do cavalgante‡Путешествие наездника‡Des Reiters Reise‡기수의 여정‡El viaje del jinete‡‡Le voyage du chevaucheur‡骑士之旅‡',
    nil,
    'Fale novamente com o Instrutor Espinho Celeste no Arboreto, na Floresta de Jade. Uma‡Вернитесь к инструктору Небесному Шипу, который находится в Дендрарии, в Нефритовом лесу.‡Kehrt zu Ausbilder Himmelsdorn im Arboretum im Jadewald zurück.‡비취 숲의 도원에 있는 교관 스카이쏜에게 가야 합니다. 레벨 10 비취 숲‡Reúnete con el instructor Punta Celeste en El Arboretum, en El Bosque de Jade.‡‡Retournez voir l’Instructeur Ronce du Ciel à l’Arboretum, dans la Forêt de Jade.‡回翡翠林的百木园找天荆教头。‡',
  }
},
[30141] = {
  {
    'A jornada do cavalgante‡Путешествие наездника‡Des Reiters Reise‡기수의 여정‡El viaje del jinete‡‡Le voyage du chevaucheur‡骑士之旅‡',
    nil,
    'Fale novamente com o Instrutor Espinho Celeste no Arboreto, na Floresta de Jade. Uma‡Вернитесь к инструктору Небесному Шипу, который находится в Дендрарии, в Нефритовом лесу.‡Kehrt zu Ausbilder Himmelsdorn im Arboretum im Jadewald zurück.‡비취 숲의 도원에 있는 교관 스카이쏜에게 가야 합니다. 레벨 10 비취 숲‡Reúnete con el instructor Punta Celeste en El Arboretum, en El Bosque de Jade.‡‡Retournez voir l’Instructeur Ronce du Ciel à l’Arboretum, dans la Forêt de Jade.‡回翡翠林的百木园找天荆教头。‡',
  }
},
[30142] = {
  {
    'É um...‡Это...‡Es ist ein...‡축하합니다!‡Es...‡‡C’est un…‡这是个……‡',
    nil,
    'Veja seu ovo chocar. Uma‡Смотрите, как из яйца вылупится змей.‡Beobachtet das Ausschlüpfen Eures Eis.‡알이 부화하는 것을 지켜봐야 합니다. 레벨 10 비취 숲‡Observa cómo tu huevo eclosiona.‡‡Regardez votre œuf éclore.‡看着你的龙蛋孵化。‡',
  }
},
[30143] = {
  {
    'Crescem pra chuchu‡Растут, как сорняки‡Sie vermehren sich wie Unkraut‡잡초처럼 자라는‡Crecen como las malas hierbas‡‡Ils poussent comme du chiendent‡比杂草长得还快‡',
    nil,
    'Fale com a Instrutora Lâmina de Vento no Arboreto. Uma‡Поговорите с инструктором Режущий Ветер в Дендрарии.‡Sprecht mit Ausbilderin Windklinge im Arboretum.‡도원에 있는 교관 윈드블레이드와 대화해야 합니다. 레벨 10 비취 숲‡Habla con la instructora Hoja Liviana en El Arboretum.‡‡Parlez à l’Instructrice Lame du Vent à l’Arboretum.‡和百木园的风刃教头谈一谈。‡',
  }
},
[30144] = {
  {
    'Treinamento de voo: prova dos anéis‡Обучение полету: через кольцо‡Flugausbildung: Ringelreihen‡비행 훈련: 고리 통과‡Instrucción de vuelo: pasar por el aro‡‡Leçons de vol : les anneaux‡飞行训练：穿越云环‡',
    nil,
    'Atravesse 6 anéis de nuvem voando em sua serpente das nuvens. Uma‡Пролетите через 6 облачных колец на вашем облачном змее.‡Reitet Eure Wolkenschlange durch 6 Wolkenringe.‡운룡을 타고 구름 고리 6개를 통과해야 합니다. 레벨 10 비취 숲‡Vuela a través de 6 anillos de nubes a lomos de tu dragón nimbo.‡‡Volez à travers 6 Anneaux nuageux en chevauchant votre Serpent-nuage.‡骑乘云端翔龙穿越6个云之环。‡',
  }
},
[30145] = {
  {
    'Treinamento de voo: a toda velocidade‡Обучение полету: полный вперед‡Flugausbildung: Volle Kraft voraus‡비행 훈련: 전속력 전진‡Instrucción de vuelo: a toda velocidad‡‡Leçons de vol : à toute vitesse‡飞行训练：全速前进‡',
    nil,
    'Siga a Instrutora Lâmina de Vento. Uma‡Следуйте за инструктором Режущий Ветер.‡Folgt Ausbilderin Windklinge.‡교관 윈드블레이드를 따라가야 합니다. 레벨 10 비취 숲‡Sigue a la instructora Hoja Liviana.‡‡Suivez l’Instructrice Lame du Vent.‡跟上风刃教头。‡',
  }
},
[30146] = {
  {
    'Hora do lanche‡Пора перекусить‡Lieblingsgericht‡간식 시간‡Hora de picotear‡‡Une petite douceur‡打牙祭‡',
    nil,
    'Pesque 10 Vairões-doces em água doce ou salgada de Pandária. Uma‡Поймайте 10 сахарных гольянов в пресных или соленых водоемах Пандарии.‡Angelt 10 Zuckerelritzen aus Süß- oder Salzwassergewässern in Pandaria.‡판다리아에 있는 민물과 바닷물에서 설탕 송사리 10마리를 낚아야 합니다. 레벨 10 비취 숲‡Pesca 10 pezqueñines azucarados en cualquier agua dulce o salada de Pandaria.‡‡Pêchez 10 Vairons de sucre dans les eaux douces ou de mer de Pandarie.‡从潘达利亚的盐水或淡水湖中钓10条甜白鱼。‡',
  }
},
[30147] = {
  {
    'Fragmentos do passado‡Осколки прошлого‡Fragmente der Vergangenheit‡과거의 조각‡Fragmentos del pasado‡‡Les fragments du passé‡历史的残片‡',
    nil,
    'Visite as escavações arqueológicas em Pandária e use sua habilidade de Sondar para recuperar 6 Relíquias dos Cavalga-serpentes. Premia .‡Посетите места археологических раскопок в Пандарии и соберите 6 реликвий наездников на змеях с помощью вашей способности "Исследовать".‡Sucht archäologische Grabungsorte in ganz Pandaria auf und nutzt Eure Archäologenfertigkeiten, um 6 Schlangenreiterrelikte zu finden. Entlohnt .‡판다리아의 고고학 발굴현장을 찾아가, 조사 기술을 사용하여 용 기수 유물 6개를 발굴해야 합니다. 을(를) 보상으로 줌.‡Visita las excavaciones de arqueología en Pandaria y utiliza tu facultad de estudiar para recuperar 6 reliquias de jinetes de dragones. Otorga  como recompensa.‡‡Visitez les sites de fouilles archéologiques de la Pandarie et utilisez votre compétence de levé pour récupérer 6 Reliques du chevaucheur de serpents.‡探索潘达利亚的考古挖掘场，并利用你的考古学技能找到6件翔龙骑士遗物。‡',
  }
},
[30148] = {
  {
    'Só um arranhão‡Всего лишь царапина‡Nur eine Fleischwunde‡얕은 상처일 뿐‡Heridas superficiales‡‡Juste une égratignure‡只是皮肉伤‡',
    nil,
    'Use Bandagens de Lã do Vento ou Bandagens Grossas de Lã de Vento para curar 8 Filhotes Feridos na Ilha Ventaneira. Elas podem ser feitas por alfaiates ou compradas na Casa de Leilões.‡Перевяжите бинтами из ветрошерсти или плотными бинтами из ветрошерсти 8 раненых маленьких змеев на Наветренном острове. Бинты изготавливают портные, также их можно приобрести в аукционном доме.‡Verwendet Windwollverbände oder schwere Windwollverbände, um 8 verletzte Junge auf der Windwärtsinsel zu versorgen. Sie können von Schneidern angefertigt oder im Auktionshaus gekauft werden.‡바람맞이 섬에서 바람양모 붕대, 두꺼운 바람양모 붕대, 촘촘한 바람양모 붕대를 사용하여 부상당한 새끼 운룡 8마리를 치료해야 합니다. 붕대는 재봉사가 제작하거나 경매장에서 구입할 수 있습니다.‡Utiliza vendas de lanaviento o vendas de lanaviento pesadas para sanar a 8 proles heridas en la Isla de Barlovento. Las vendas las fabrican los sastres y también se pueden comprar en la casa de subastas.‡‡Utilisez des Bandages en éolaine ou des Bandages lourds en éolaine pour soigner 8 Jeunes serpents blessés sur l’Île Front-du-Vent. Vous pouvez en acquérir auprès des tailleurs ou à l’Hôtel des ventes.‡在临风岛使用风绒绷带或厚风绒绷带治疗8条受伤的雏龙。这些绷带可以由裁缝制造或者从拍卖行购买。‡',
  }
},
[30149] = {
  {
    'Um banquete para os sentidos‡Пир чувств‡Ein Fest für die Sinne‡미각의 향연‡Un festín para los sentidos‡‡Un festin pour les sens‡味觉盛宴‡',
    nil,
    'Junte 5 Bolinhos de Peixe. Uma‡Приготовьте 5 рыбных пирогов.‡Sammelt 5 Fischküchlein.‡어묵 완자 5개를 모아야 합니다. 레벨 10 비취 숲‡Reúne 5 pasteles de pescado.‡‡Cuisinez 5 Poissons panés.‡收集5份鱼饼。‡',
  }
},
[30150] = {
  {
    'Doce como o mel‡Сладкий как мед‡Süß wie Honig‡꿀처럼 달콤한‡Dulce como la miel‡‡Doux comme du miel‡甜如蜜‡',
    nil,
    'Colete 30 Favos de Mel de Guarda-méis Furiosos no Arboreto. Uma‡Заберите 30 медовых сот у злых медоносов в Дендрарии.‡Sammelt 30 Honigwaben von wütenden Honigbewahrern im Arboretum ein.‡도원에 있는 꿀지기에게서 벌집 30개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 30 panales de los guardamieles enfadados de El Arboretum.‡‡Récoltez 30 Rayons de miel sur des Garde-miels en colère, à l’Arboretum.‡在百木园从愤怒的蜂蜜守护者身上收集30份蜂巢。‡',
  }
},
[30151] = {
  {
    'Pense rápido!‡Лови!‡Fang!‡받아라!‡¡Atrápalo!‡‡Attrape !‡接球游戏！‡',
    nil,
    'Use a Bola Saltitante. Depois, pegue-a e devolva-a para seu filhote 8 vezes. Uma‡Подбросьте прыгучий мяч. Затем поймайте его и снова бросьте своему змею. Повторите 8 раз.‡Benutzt den Flummi. Dann fangt ihn und werft ihn achtmal zu Eurem Jungtier zurück.‡탱탱공을 사용한 후, 새끼 운룡과 함께 공을 8번 던지고 받아야 합니다. 레벨 10 비취 숲‡Usa la pelota de goma. Después, recógela y vuelve a lanzársela a tu prole 8 veces.‡‡Prenez la Balle rebondissante. Ensuite, attrapez-la et relancez-la 8 fois à votre Jeune serpent.‡将弹力球丢给你的翔龙，然后连续接球、丢球8次。‡',
  }
},
[30152] = {
  {
    'Corrida Celeste‡Небесная гонка‡Das Himmelsrennen‡하늘 경주‡La carrera de los cielos‡‡La course du ciel‡飞行竞技赛‡',
    nil,
    'Complete a Corrida Celeste passando pelos 10 pontos de controle e depois passando por baixo da Linha de Chegada, no Arboreto. Uma‡Примите участие в Небесной гонке, пролетев через 10 контрольных точек, а затем – под финишной чертой в Дендрарии.‡Beendet das Himmelsrennen, indem Ihr durch 10 Kontrollpunkte hindurchfliegt und dann die Ziellinie am Arboretum unterquert.‡하늘 경주에 참가해야 합니다. 통과 지점 10곳을 지난 후, 도원에 있는 결승선 아래를 통과하십시오.‡Para terminar la carrera de los cielos, vuela a través de 10 puntos de control y pasa por debajo de la línea de meta en El Arboretum. Un(a) misión.‡‡Terminez la Course du ciel en traversant 10 Points de contrôle, puis en passant sous la Ligne d’arrivée à l’Arboretum.‡飞越10个检查点来完成飞行竞技赛，然后从百木园的终点线下方穿过。‡',
  }
},
[30153] = {
  {
    'A toda velocidade‡Полный вперед‡Volle Kraft voraus‡‡A toda velocidad‡‡En avant toute‡‡',
    nil,
    'Siga a Instrutora Lâmina de Vento. Uma‡Следуйте за инструктором Режущий Ветер. это‡Folgt Ausbilderin Windklinge.‡‡Sigue a la instructora Hoja Liviana.‡‡Suivez l’Instructrice Lame du Vent.‡‡',
  }
},
[30154] = {
  {
    'O caminho mais fácil até o coração de uma serpente‡Самый легкий путь к сердцу змея‡Der schnellste Weg zum Herzen einer Schlange‡운룡의 기운을 북돋우는 가장 쉬운 방법‡Cómo hacer feliz a tu dragón‡‡Comment gagner le cœur d’un serpent‡想要抓住心，得先抓住胃‡',
    nil,
    'Colete 5 Quartos de Tigre. Uma‡Раздобудьте 5 тигриных боков.‡Sammelt 5 Tigerflanken.‡호랑이 살코기 5개를 모아야 합니다. 레벨 10 비취 숲‡Hazte con 5 costillares de tigre.‡‡Récupérez 5 Flanchets de tigre.‡收集5块老虎腰肉。‡',
  }
},
[30155] = {
  {
    'Restaurando o equilíbrio‡Восстановление равновесия‡Das Gleichgewicht wiederherstellen‡균형 회복‡Restablecer el equilibrio‡‡Restaurer l’équilibre‡恢复平衡‡',
    nil,
    'Mate 8 Estripadores Escama-lisa ou Ovirráptores Escama-lisa. Uma‡Убейте 8 потрошителей или яйцеедов из клана Скользкой Чешуи.‡Tötet 8 Reißer der Schlängelschuppen oder Eitrinker der Schlängelschuppen.‡뱀비늘 학살자나 뱀비늘 알도둑 8마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 8 desgarradores Reptaescama o bebedores ovíparos Reptaescama.‡‡Tuez 8 Déchireurs ou Aspire-œuf ondulécailles.‡击败8个滑鳞切裂者或滑鳞啜蛋者。‡',
  }
},
[30156] = {
  {
    'Hora de matar a fome‡Время кормления‡Fütterungszeit‡식사 시간‡Hora de comer‡‡À la bouffe !‡喂食时间‡',
    nil,
    'Colete 3 Nacos de Carne Salcosteira e dê de comer ao seu filhote. Uma‡Скормите вашему змею 3 больших куска мяса черепахи соленых вод.‡Sammelt 3 Stücke Salzrückenfleisch und verfüttert sie an Euer Jungtier.‡소금등 고기 3개를 모아서 자신의 새끼 운룡에게 먹여야 합니다. 레벨 10 비취 숲‡Reúne 3 trozos de carne de caparazón salino y dáselos de comer a tu prole mascota.‡‡Récupérez 3 Viandes de dos-salé et donnez-les à votre jeune serpent.‡收集3块盐背肉，并用来喂食你的雏龙小伙伴。‡',
  }
},
[30157] = {
  {
    'Ninhos ainda mais vazios‡Опустевшие гнезда‡Noch leerere Nester‡다시 텅 빈 둥지‡Nidos aún más vacíos‡‡Des nids trop vides‡空空如也的巢穴‡',
    nil,
    'Prenda 6 Filhotes Ventaneiros e leve-os de volta para seus ninhos. Uma‡Возьмите на поводок 6 детенышей облачных змеев Наветренного острова и верните их в родные гнезда.‡Fangt 6 Windwärtsjungtiere mit dem Seil ein und bringt sie zurück in ihre Nester.‡새끼 바람맞이 운룡 6마리를 붙잡아 둥지에 데려와야 합니다. 레벨 10 비취 숲‡Ata a 6 proles de Barlovento y devuélvelas a sus nidos.‡‡Attrapez et reconduisez 6 Jeunes serpents de Front-du-Vent à leur nid.‡拴住6只临风雏龙并把它们送回家。‡',
  }
},
[30158] = {
  {
    'Desarmando o inimigo‡Обезоруженный противник‡Entwaffnung des Feindes‡발톱 없는 호랑이‡Desarmar al enemigo‡‡Désarmer l’ennemi‡解除武装‡',
    nil,
    'Colete 5 Arpões dos Escama-lisa. Uma‡Соберите 5 гарпунов Скользкой Чешуи.‡Sammelt 5 Harpunen der Schlängelschuppen ein.‡뱀비늘 작살 5개를 모아야 합니다. 레벨 10 비취 숲‡Hazte con 5 arpones Reptaescama.‡‡Récupérez 5 Harpons ondulécailles.‡收集5支滑鳞鱼叉。‡',
  }
},
[30159] = {
  {
    'Preservação‡Сохранение‡Artenschutz‡보존‡Preservación‡‡Préservation‡保护龙蛋‡',
    nil,
    'Colete 8 Ovos Roubados. Uma‡Соберите 8 украденных яиц.‡Sammelt 8 gestohlene Eier.‡도난당한 알 8개를 되찾아야 합니다. 레벨 10 비취 숲‡Consigue 8 huevos robados.‡‡Récupérez 8 Œufs volés.‡收集8个被偷的蛋。‡',
  }
},
[30160] = {
  {
    'Um estilhaço de rubi para Ella‡Рубиновый осколок для Эллы‡Ein Rubinsplitter für Ella‡엘라를 위한 루비 파편‡Un fragmento de rubí para Ella‡‡Un éclat de rubis pour Ella‡给艾拉的红宝石碎片‡',
    nil,
    'Olá, &lt;name&gt;! Que bom ver você de novo. Uma‡О, Рохсе, рада снова тебя видеть.‡Hallo &lt;Name&gt;, schön, Euch wiederzusehen.‡레벨 15 네 바람의 계곡‡Vaya, &lt;nombre&gt;, Me alegro de volver a verte.‡‡Eh bien &lt;nom&gt;, ça fait plaisir de vous revoir.‡‡',
  }
},
[30163] = {
  {
    'Pela tribo‡За племя‡Für den Stamm‡부족을 위하여‡Por la tribu‡‡Pour la tribu‡为了部落‡',
    nil,
    'Resgate 8 Caça-manhãs Prisioneiros. Uma‡Освободите 8 плененных Искателей Зари.‡Rettet 8 Gefangene der Morgenjäger.‡돈체이서 포로를 8명 구출해야 합니다. 레벨 15 크라사랑 밀림‡Rescata a 8 cautivos Cazamañanas.‡‡Secourez 8 Captifs chasselaubes.‡营救8名逐晨者俘虏。‡',
  }
},
[30164] = {
  {
    'A caravana de Arado de Pedra‡Посланники из Каменного Плуга‡Der Steinpflug-Konvoi‡돌밭 호송대‡El convoy de Villarroca‡‡Le convoi des Chasse-Pierre‡石犁村守卫‡',
    nil,
    'Use o Emplastro de Lótus-imperial em 7 Enviados de Arado de Pedra. Uma‡Исцелите припаркой из императорского лотоса 7 посланников из Каменного Плуга.‡Wendet den kaiserlichen Lotusumschlag bei 7 Gesandten von Steinpflug an.‡돌밭 특사 7명에게 황제의 연꽃 고약을 사용해야 합니다. 레벨 15 크라사랑 밀림‡Utiliza la cataplasma de loto imperial con 7 enviados de Villarroca.‡‡Utilisez le Cataplasme de lotus impérial sur 7 Envoyés de Chasse-Pierre.‡对7个石犁使者使用霸王莲软膏。‡',
  }
},
[30165] = {
  {
    'Tracking Event: Pegar Serpente Azul‡Выслеживание: найден синий змей‡Verfolgungsereignis: Blaue Schlange gewählt‡이벤트 추적: 푸른색 운룡 선택‡Evento de seguimiento: dragón azul elegido‡‡Évènement de suivi : serpent bleu choisi‡追踪事件：挑选蓝色翔龙‡',
