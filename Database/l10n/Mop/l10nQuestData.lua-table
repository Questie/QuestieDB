[31302] = {
  {
    'Preparação para a grandeza‡Путь к величию‡Bereit für Großes‡달인이 되기 위한 준비‡Listo para la grandeza‡‡Prêt pour de grandes choses‡大展宏图‡',
    nil,
    'Prepare 5 tigelas de Arroz Doce e entregue-as à Guia dos Caminhos. Uma‡Приготовьте 5 порций рисового пудинга и отдайте их Показывающей Путь. это‡Bereitet 5 Schüsseln Milchreis zu und gebt sie der Gewährerin der Einblicke.‡쌀 푸딩을 5개 만들어서 요리 길잡이에게 가져가야 합니다. 레벨 10‡Haz 5 budines de arroz y dáselos a la guía de las tradiciones.‡‡Préparez 5 Riz au lait et donnez-les à la Guide des Voies.‡制作5碗八宝饭，然后把它们交给引路人。‡',
  }
},
[31303] = {
  {
    'O selo está rompido‡Печать сломана‡Das Siegel ist zerbrochen‡깨어진 봉인‡El sello está roto‡‡Le sceau est rompu‡破损的封印‡',
    nil,
    'Sele 12 Fendas de Sha para banir o Sha da Dúvida. Uma‡Закройте 12 трещин, чтобы изгнать Ша Сомнения.‡Versiegelt 12 Risse des Sha und verbannt das Sha des Zweifels.‡샤 균열 12개를 봉인하여 의심의 샤를 추방해야 합니다. 레벨 10 비취 숲‡Sella 12 fisuras de sha para expulsar al sha de la duda.‡‡Scellez 12 Fissures sha pour bannir le Sha du doute.‡封印12个怒煞裂隙以放逐疑之煞。‡',
  }
},
[31304] = {
  {
    'FLAG - Kafa Press‡FLAG - Kafa Press‡FLAG - Kafa Press‡FLAG - Kafa Press‡FLAG - Infusión de kafa‡‡MARQUEUR - Kafatière‡旗帜——咔啡压榨机‡',
    nil,
    'Vale dos Quatro Ventos de‡‡‡네 바람의 계곡‡‡‡‡‡',
  }
},
[31305] = {
  {
    'O Caminho da Grelha‡Путь Гриля‡Der Weg des Grills‡‡El arte de la parrilla‡‡La Voie du grill‡‡',
    nil,
    'Faça um Espeto de Galinha com Amendoim e entregue-o ao Mestre da Grelha. Uma‡Make a Skewered Peanut Chicken and give it to the Master of the Grill.‡Bereitet ein Hühnchenspieß mit Erdnusssoße zu und gebt es dem Meister des Grills.‡‡Prepara un pincho de gallina al cacahuete y dáselo al maestro de la parrilla.‡‡Préparez des Brochettes de poulet aux cacahuètes et donnez-les au Maître du grill.‡‡',
  }
},
[31306] = {
  {
    'Delírio do Buscador‡Причуда Искателя‡Pfad des Unwissenden‡구도자의 우둔함‡Perdición del Explorador‡‡La Folie du chercheur‡探索者末路‡',
    nil,
    'Desbrave a trilha conhecida como Delírio do Buscador para encontrar o Lendário Cho, parando para refletir nos três altares do caminho. Premia .‡Пройдите путь под названием "Причуда Искателя", чтобы найти хранителя истории Чо. По пути остановитесь у трех храмов.‡Bewältigt den Pfad des Unwissenden, um Euch mit dem Lehrensucher Cho zu treffen. Macht an allen Schreinen entlang des Weges Halt, um Euch dort auf Eure Gedanken zu konzentrieren.‡구도자의 우둔함의 길을 따라 제단 세 곳을 모두 순례한 후에, 전승지기 초를 찾아야 합니다. 레벨 20 쿤라이 봉우리‡Afronta la senda de la Perdición del Explorador para encontrarte con el eremita Cho, deteniéndote en los tres santuarios del camino para meditar.‡‡Engagez-vous sur la voie de la Folie du chercheur pour retrouver le Chroniqueur Cho, en faisant halte à chacun des trois sanctuaires qui jalonnent votre chemin.‡征服探索者末路，找到游学者周卓，并且在沿路的三个神龛稍停片刻，对自身进行一番反省。‡',
  }
},
[31307] = {
  {
    'FLAG - Jade Infused Blade‡FLAG - Jade Infused Blade‡FLAG - Jade Infused Blade‡플래그 - 비취가 주입된 검‡FLAG - Hoja imbuida de jade‡‡FLAG - Jade Infused Blade‡旗帜——镶玉之刃‡',
    nil,
    'Floresta de Jade de‡‡‡비취 숲‡‡‡‡‡',
  }
},
[31308] = {
  {
    'Pegando o jeito‡Изучение основ‡Erste Erfahrungen‡요령 익히기‡Aprendizaje inicial‡‡Apprendre les ficelles‡驯服宠物‡',
    nil,
    'Vencer uma batalha de mascotes. Uma‡Победите в битве питомцев. это‡Gewinnt einen Haustierkampf.‡애완동물 대전에서 승리해야 합니다. 레벨 1‡Gana un duelo de mascotas.‡‡Gagnez un combat de mascottes.‡赢得一场宠物战斗。‡',
  }
},
[31309] = {
  {
    'Cuidados médicos‡На поправку‡Auf dem Wege der Besserung‡채찍 다음엔 당근‡Mejorando‡‡Panser ses plaies‡治疗宠物‡',
    nil,
    'Fale com Erma, a Mestre de Estábulo, para curar suas mascotes de batalha completamente. Uma‡Излечите своих питомцев полностью, поговорив со смотрительницей стойл Ирмой.‡Stattet Erma der Stallmeisterin einen Besuch ab und heilt Eure Tiere vollständig.‡야수 관리인 엘마를 찾아가 애완동물을 완전히 치유해야 합니다. 레벨 1‡Ve a ver a Erma y sana tus mascotas al máximo.‡‡Soignez vos mascottes en allant voir Erma, le Maître des écuries.‡拜访兽栏管理员艾玛，治疗你的宠物。‡',
  }
},
[31310] = {
  {
    'Interrogation Tracking‡Interrogation Tracking‡Verhörsverfolgung‡심문 추적‡Interrogación Seguimiento‡‡Interrogation Tracking‡审问追踪‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31311] = {
  {
    'Caminho da Grelha‡Путь Гриля‡Weg des Grills‡직화요리의 길‡El arte de la parrilla‡‡La Voie du grill‡烧烤之道‡',
    nil,
    'Entregar 5 Bifes de Tigre Crus ao Mestre da Grelha. Uma‡Принесите 5 сырых стейков из тигриного мяса мастеру гриля. это‡Bringt 5 rohe Tigersteaks zum Meister des Grills.‡직화요리의 대가에게 호랑이 날고기 스테이크를 5개 가져가야 합니다. 레벨 10‡Llévale 5 filetes de tigre crudos al maestro de la parrilla.‡‡Apportez 5 Steaks de tigre crus au Maître du grill.‡带5份生虎排给烧烤大师。‡',
  }
},
[31312] = {
  {
    'O velho mapa‡Старая карта‡Die alte Karte‡오래된 지도‡El mapa antiguo‡‡La vieille carte‡陈旧的地图‡',
    nil,
    'Mostre o mapa a Peixe Cana Alta no Lago Taboa ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Uma‡Покажите карту Рыбе Тростниковой Шкуре на Камышовом озере или на рынке Полугорья в долине Четырех Ветров.‡Zeigt Fischi Rohrroder am Rohrkolbensee oder auf dem Halbhügelmarkt im Tal der Vier Winde die Karte.‡네 바람의 계곡의 언덕골 시장이나 부들개지 호수에 있는 피시 펠리드에게 지도를 보여줘야 합니다. 을(를) 보상으로 줌.‡Enséñale el mapa a Pez Junco Talado en el Lago de las Eneas o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Montrez la carte à Marée Pelage de Roseau au Lac aux Roseaux ou au Marché de Micolline, dans la Vallée des Quatre vents.‡去四风谷的香蒲湖或是半山市集让玉儿·采苇看一看这张地图。‡',
  }
},
[31313] = {
  {
    'Só uma lenda‡Просто легенда‡Nur eine Volkserzählung‡그저 전설일 뿐‡Solo un cuento de viejas‡‡Une histoire de vieux‡民间传说‡',
    nil,
    'Fale com o Cata-grãos Pei, o Entalhador Mac, a Mama Min e o Velho Bigodalvo. Uma‡Поговорите с сортировщиком зерна Пэем, резчиком Маком, мамой Минь и со стариком Седым Усом.‡Sprecht mit Korntrenner Pei, Steinmeißler Mac, Mama Min und dem alten Herrn Weißbart.‡곡물선별인 페이, 석공 맥, 왕언니 민, 노인 화이트위스커스와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con el selector de grano Pei, el tallapiedras Mac, mamá Min y el viejo Bigote Cano.‡‡Parlez au Trieur de grains Pei, au Tailleur de pierre Mac, à Mama Min et au Vieux Blanches Moustaches.‡和拣谷工小裴、刻石者马克、闵大妈还有白须老头谈一谈。‡',
  }
},
[31314] = {
  {
    'O tesouro do Velho Cardo‡Сокровище Старого Шипа‡Der Schatz des alten Distel‡늙은 엉겅퀴 노인의 보물‡El tesoro de Cardo el Viejo‡‡Le trésor du Vieux Chardon‡老农阿蓟的宝藏‡',
    nil,
    'Encontre a entrada da caverna e ache o tesouro escondido do Velho Cardo. Uma‡Найдите вход в пещеру и отыщите клад Старого Шипа.‡Findet den Höhleneingang und holt Euch den Schatz des alten Distel.‡동굴 입구를 찾아 늙은 엉겅퀴 노인의 보물을 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra la entrada de la cueva y recupera el tesoro escondido de Cardo el Viejo.‡‡Trouvez l’entrée de la caverne, puis le Trésor caché du Vieux Chardon.‡找到洞穴入口并取得老农阿蓟隐藏的宝藏。‡',
  }
},
[31315] = {
  {
    'O legado do Coração da Terra‡Наследие Плодородных Земель‡Das Kernlanderbe‡심장지의 유물‡El legado de Los Cultivos Florecientes‡‡Le legs de la terre‡汇风岭的遗产‡',
    nil,
    'Leve o Almanaque do Velho Cardo para o Guarda-sementes Shing Sing em Meia Colina, que fica no Vale dos Quatro Ventos. Uma‡Отнесите альманах Старого Шипа хранительнице семян Шин Син в Полугорье, что в долине Четырех Ветров.‡Bringt den Almanach des alten Distel zu Saatwärterin Shing Sing in Halbhügel im Tal der Vier Winde.‡늙은 엉겅퀴 노인의 연감을 네 바람의 계곡의 언덕골에 있는 씨앗관리인 슁 싱에게 가져가야 합니다. 을(를) 보상으로 줌.‡Llévale el anuario de Cardo el Viejo a la cuidasemillas Shing Sing a El Alcor, en el Valle de los Cuatro Vientos.‡‡Apportez l’Almanach du Vieux Chardon à la Gardienne des graines Shing Sing à Micolline, dans la Vallée des Quatre vents.‡把老农阿蓟的历书带给四风谷中半山市集的种子保管人辛辛。‡',
  }
},
[31316] = {
  {
    'Júlia, a adestradora de mascotes‡Джулия, укротительница питомцев‡Julia, die Tierzähmerin‡애완동물 조련사 줄리아‡Julia, la domadora de mascotas‡‡Julia la dompteuse de mascottes‡宠物训练师茱莉亚‡',
    nil,
    'Vença Júlia Esteves numa batalha de mascotes. Uma‡Победите Джулию Стивенс в битве питомцев. это‡Besiegt Julia Stevens in einem Haustierkampf.‡애완동물 대전에서 줄리아 스티븐스를 꺾어야 합니다. 레벨 1‡Derrota a Julia en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Julia Stevens.‡在宠物战斗中击败茱莉亚·史蒂文斯。‡',
  }
},
[31317] = {
  {
    'Tracking Event: Encontrou Entrada‡Tracking Event: Found Entrance‡Verfolgungsereignis: Eingang gefunden‡이벤트 추적: 입구 찾음‡Evento de seguimiento: Entrada encontrada‡‡Tracking Event: Found Entrance‡跟踪事件：找到入口‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31318] = {
  {
    'Tracking Event: Encontrou Tesouro‡Tracking Event: Found Treasure‡Verfolgungsereignis: Schatz gefunden‡이벤트 추적용: 보물 발견함‡Evento de seguimiento: Tesoro encontrado‡‡Tracking Event: Found Treasure‡跟踪事件：找到宝藏‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31319] = {
  {
    'Resposta emergencial‡Срочные меры‡Notfallplan‡응급 대응‡Respuesta de urgencia‡‡Réponse d’urgence‡紧急救援‡',
    nil,
    'Use os Fogos de Artifício de Cho perto do Almirante Taylor, de Mishka e de Sully. Uma‡Запустите фейерверки Чо рядом с адмиралом Тейлором, Мишкой и Салли.‡Benutzt Chos Feuerwerk in der Nähe von Admiral Taylor, Mishka und Sully.‡제독 테일러, 미시카, 설리 근처에서 초의 폭죽을 사용해야 합니다. 레벨 10 비취 숲‡Usa los fuegos artificiales de Cho cerca del almirante Taylor, Mishka y Sully.‡‡Utilisez les Feux d’artifice de Cho près de l’Amiral Taylor, de Mishka et de Sully.‡在海军上将泰勒、米希卡和苏利附近使用周卓的烟火。‡',
  }
},
[31320] = {
  {
    'Paga um drinque prum peixe?‡Как рыбке рюмка‡Einen Drink für einen Fisch?‡물고기에게 마실 것을 사준다고?‡¿Le pagas un trago a este pez?‡‡Offrir un coup à boire à un poisson ?‡给鱼买杯酒？‡',
    nil,
    'Entregue 1 Soju dos Quatro Ventos para Be Bum, o Ébrio. O Soju dos Quatro Ventos pode ser comprado da maioria dos comerciantes de alimentos de Pandária.‡Принесите 1 бутылку соджу четырех ветров Йогу Пьяному. Соджу Четырех Ветров можно приобрести у большинства барменов Пандарии.‡Bringt Jogu dem Betrunkenen 1 Vier-Winde-Soju. Vier-Winde-Soju kann von den meisten Schankkellnern in Pandaria erworben werden.‡주정뱅이 조구에게 네 바람 소주 1병을 가져다줘야 합니다. 네 바람 소주는 판다리아에 있는 아무 바텐더에게서나 살 수 있습니다.‡Llévale 1 soju de los Cuatro Vientos a Jogu el Ebrio. El soju de los Cuatro Vientos lo venden la mayoría de los taberneros de Pandaria. Un(a) misión.‡‡Apportez 1 Soju des Quatre vents à Jogu l’Ivrogne. La plupart des taverniers de Pandarie vous vendront du Soju des Quatre vents. Donne  en récompense.‡将1瓶四风烧酒交给醉鬼贾古。四风烧酒可以在潘达利亚大多数调酒师那里买到。‡',
  }
},
[31321] = {
  {
    'Paga uma rodada prum peixe?‡Как рыбке бутылка‡Eine Runde für einen Fisch?‡물고기에게 한잔 사준다고?‡¿Le pagas una ronda a este pez?‡‡Offrir une tournée à un poisson ?‡给鱼买壶酒？‡',
    nil,
    'Leve 5 Vinhos de Ameixa Pandarênicos a Be Bum, o Ébrio. O Vinho de Ameixa Pandarênico pode ser comprado com a maioria dos comerciantes de alimentos de Pandária.‡Принесите 5 бутылок пандаренского сливового вина Йогу Пьяному. Сливовое вино можно приобрести у большинства барменов Пандарии.‡Bringt Jogu dem Betrunkenen 5 Flaschen Pandarenpflaumenwein. Pandarenpflaumenwein kann von den meisten Schankkellnern in Pandaria erworben werden.‡주정뱅이 조구에게 판다렌 매실주 5병을 가져다줘야 합니다. 판다렌 매실주는 판다리아에 있는 아무 바텐더에게서나 살 수 있습니다.‡Llévale 5 vinos de ciruela pandaren a Jogu el Ebrio. El vino de ciruela pandaren lo venden la mayoría de los taberneros de Pandaria. Otorga  como recompensa.‡‡Apportez 5 bouteilles de Vin de prune pandaren à Jogu l’Ivrogne. La plupart des taverniers de Pandarie vous vendront du Vin de prune. Donne  en récompense.‡将5瓶熊猫人青梅酒给醉鬼贾古。熊猫人青梅酒可以在潘达利亚大多数调酒师那里买到。‡',
  }
},
[31322] = {
  {
    'Paga um barril prum peixe?‡Как рыбке бочка‡Ein Fässchen für einen Fisch?‡물고기에게 술통을 사준다고?‡¿Le pagas un barril a este pez?‡‡Offrir une barrique à un poisson ?‡给鱼买桶酒？‡',
    nil,
    'Entregue 10 Infusões da Bruxa de Jade para Be Bum, o Ébrio. A Infusão da Bruxa de Jade pode ser feita com a profissão Culinária. Premia .‡Принесите 10 бутылок отвара нефритовой ведьмы Йогу Пьяному. Отвар нефритовой ведьмы можно приготовить, используя умения кулинарии.‡Bringt Jogu dem Betrunkenen 10 Flaschen Jadehexenbräu. Jadehexenbräu kann durch Kochkunst hergestellt werden.‡주정뱅이 조구에게 옥의 마녀 맥주 10통을 가줘다줘야 합니다. 옥의 마녀 맥주는 요리 전문 기술을 사용해 만들 수 있습니다.‡Llévale 10 cervezas de la Bruja de Jade a Jogu el Ebrio. La cerveza de la Bruja de Jade se prepara con la profesión de cocina.‡‡Apportez 10 Mixtures de la sorcière de jade à Jogu l’Ivrogne. Vous pouvez fabriquer la Mixture de la sorcière de jade en utilisant le métier Cuisine.‡将10瓶青玉巫婆的老酒给醉鬼贾古。青玉巫婆的老酒可以通过烹饪专业技能制作。‡',
  }
},
[31323] = {
  {
    'Compra uma cervejaria prum peixe?‡Как рыбке хмелеварня‡Eine Brauerei für einen Fisch?‡물고기에게 양조장을 사준다고?‡¿Le pagas una cervecería a este pez?‡‡Offrir une brasserie à un poisson ?‡给鱼买个酒坊？‡',
    nil,
    'Leve 20 Cafés da Manhã do Cervejeiro Louco para Be Bum, o Ébrio. O Café da Manhã do Cervejeiro Louco pode ser feito com a profissão Culinária.‡Принесите 20 завтраков безумца Йогу Пьяному. Завтрак безумца можно приготовить, используя умения кулинарии.‡Bringt Jogu dem Betrunkenen 20 wahnsinnige Brauerfrühstücke. Wahnsinnige Brauerfrühstücke können durch Kochkunst hergestellt werden. Entlohnt .‡주정뱅이 조구에게 정신나간 양조장이의 아침식사 20개를 가져다줘야 합니다. 요리 전문 기술을 사용하면 정신나간 양조장이의 아침식사를 만들 수 있습니다.‡Llévale 20 desayunos del cervecero loco a Jogu el Ebrio. El desayuno del cervecero loco se prepara con la profesión de cocina.‡‡Apportez 20 Déjeuners du brasseur fou à Jogu l’Ivrogne. Vous pouvez préparer des Déjeuners du brasseur fou en utilisant le métier Cuisine.‡将20瓶疯酒师的早餐给醉鬼贾古。疯酒师的早餐可以通过烹饪专业技能制作。‡',
  }
},
[31324] = {
  {
    'Segredos de família‡Семейные тайны‡Familiengeheimnisse‡가문의 비밀‡Secretos de familia‡‡Secrets de famille‡祖传秘方‡',
    nil,
    'Recolha 5 Segredos do Malte do Trovão. Uma‡Соберите 5 секретов Буйного Портера.‡Sammelt 5 Geheimnisse der Sturmbräus.‡스톰스타우트가의 비밀 5개를 모아야 합니다. 레벨 15 스톰스타우트 양조장‡Hazte con 5 secretos de Cerveza de Trueno.‡‡Récupérez 5 Secrets des Brune d\'Orage.‡收集5份风暴烈酒秘方。‡',
  }
},
[31325] = {
  {
    'Um colar muito bonito‡Прекрасное ожерелье‡Eine sehr schöne Halskette‡아주 예쁜 목걸이‡Un collar muy bonito‡‡Un très joli collier‡极美的项链‡',
    nil,
    'Leve o colar para Tina Garra de Barro na Casa de Haohan ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Uma‡Отнесите ожерелье Тине Грязный Коготь в дом Хаоханя или на рынок Полугорья в долине Четырех Ветров.‡Bringt die Halskette zu Tina Lehmkrall in Haohans Haus oder zum Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 언덕골 시장이나 하오한 머드클로의 집에 있는 티나 머드클로에게 목걸이를 가져가야 합니다.‡Llévale el collar a Tina Zarpa Fangosa en casa de Haohan o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Apportez le Collier à Tina Griffe de Tourbe à la Maison de Haohan ou au Marché de Micolline, dans la Vallée des Quatre vents.‡将项链带给位于四风谷郝瀚房子里或者半山市集的迪娜·泥爪。‡',
  }
},
[31326] = {
  {
    'Tiara de Bom Gosto da Tina‡Роскошная тиара Тины‡Tinas elegante Tiara‡티나의 은근히 예쁜 티아라‡La tiara distinguida de Tina‡‡La tiare élégante de Tina‡迪娜的雅致头饰‡',
    nil,
    'Leve a Tiara de Bom Gosto da Tina para Tina Garra de Barro na Casa de Haohan ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos.‡Отнесите роскошную тиару Тине Грязный Коготь в дом Хаоханя или на рынок Полугорья в долине Четырех Ветров.‡Bringt die elegante Tiara zu Tina Lehmkrall in Haohans Haus oder zum Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 언덕골 시장이나 하오한 머드클로의 집에 있는 티나 머드클로에게 은근히 예쁜 티아라를 가져가야 합니다.‡Llévale la tiara distinguida a Tina Zarpa Fangosa en casa de Haohan o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Apportez la Tiare élégante à Tina Griffe de Tourbe à la Maison de Haohan ou au Marché de Micolline, dans la Vallée des Quatre vents. Donne  en récompense.‡将雅致的头饰带给位于四风谷郝瀚房子里或者半山市集的迪娜·泥爪。‡',
  }
},
[31327] = {
  {
    'Efeito de um kafazinho‡Проблемы хмелевара‡Ärger aus dem Fass‡어려운 양조의 길‡Se acercan problemas‡‡Brasserie coulée‡制造难题‡',
    nil,
    'Mate Yan-Zhu, o Desenvasado. Uma‡Убейте Янь-Чжу Высвобожденного.‡Tötet Yan-Zhu den Dekantierten.‡담기지 않는 옌주를 처치해야 합니다. 레벨 15 스톰스타우트 양조장‡Mata a Yan-Zhu el Peleón.‡‡Tuez Yan Zhu le Déballonné.‡杀死破桶而出的炎诛。‡',
  }
},
[31328] = {
  {
    'Um brinco requintado‡Изящная серьга‡Ein exquisiter Ohrring‡우아한 귀걸이‡Un pendiente exquisito‡‡Une exquise boucle d’oreille‡一只精致的耳环‡',
    nil,
    'Leve o Brinco Requintado para Tina Garra de Barro na Casa de Haohan ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Premia .‡Отнесите изящную серьгу Тине Грязный Коготь в дом Хаоханя или на рынок Полугорья в долине Четырех Ветров.‡Bringt den exquisiten Ohrring zu Tina Lehmkrall in Haohans Haus oder zum Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 언덕골 시장이나 하오한 머드클로의 집에 있는 티나 머드클로에게 우아한 귀걸이를 가져가야 합니다.‡Llévale el pendiente exquisito a Tina Zarpa Fangosa en casa de Haohan o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Apportez la Boucle d’oreille exquise à Tina Griffe de Tourbe à la Maison de Haohan ou au Marché de Micolline, dans la Vallée des Quatre vents.‡将精致耳环带给位于四风谷郝瀚房子里或者带给半山市集的迪娜·泥爪。‡',
  }
},
[31329] = {
  {
    'Um belo broche‡Великолепная брошь‡Eine wunderschöne Brosche‡아름다운 브로치‡Un broche hermoso‡‡Une broche ravissante‡一枚美丽的胸针‡',
    nil,
    'Leve o Belo Broche para Tina Garra de Barro na Casa de Haohan ou no Mercado de Meia Colina, que ficam no Vale dos Quatro Ventos. Uma‡Отнесите великолепную брошь Тине Грязный Коготь в дом Хаоханя или на рынок Полугорья в долине Четырех Ветров.‡Bringt die wunderschöne Brosche zu Tina Lehmkrall in Haohans Haus oder zum Halbhügelmarkt im Tal der Vier Winde.‡네 바람의 계곡의 언덕골 시장이나 하오한 머드클로의 집에 있는 티나 머드클로에게 아름다운 브로치를 가져가야 합니다.‡Llévale el broche hermoso a Tina Zarpa Fangosa en casa de Haohan o El Mercado del Alcor, en el Valle de los Cuatro Vientos.‡‡Apportez la Superbe broche à Tina Griffe de Tourbe à la Maison de Haohan ou au Marché de Micolline, dans la Vallée des Quatre vents. Donne  en récompense.‡将美丽的胸针带给位于四风谷郝瀚房子里或者带给半山市集的迪娜·泥爪。‡',
  }
},
[31331] = {
  {
    'Como cumprir missões‡Научиться проходить задания‡Anleitung zur Questerstellung‡퀘스트 만드는 법 배우기‡Figuring out how to make quests‡‡Comprendre comment créer des quêtes‡弄清楚如何制作任务‡',
    nil,
    'Cumpra uma missão de encaminhamento. Uma‡Выполнить задание о хлебных крошках.‡Erstellt eine Schnitzeljagdquest.‡조그마한‡Make a breadcrumb quest.‡‡Créer un début de quête.‡制作一个索引任务。‡',
  }
},
[31332] = {
  {
    'Lição 1: Pêssegos Fatiados‡Урок 1: разрезанные персики‡Lektion 1: Pfirsich in Scheiben‡1강: 저민 복숭아‡Lección 1: Melocotones en rodajas‡‡Leçon 1 : Pêches en tranches‡第1课：蜜桃片‡',
    nil,
    'Consiga 5 Pêssegos Pandarênicos para a aula de culinária de Nomi. Uma‡Достаньте 5 пандаренских персиков для занятий с Номи. это‡Besorgt Euch 5 Pandarenpfirsiche für Nomis Kochstunde.‡노미의 요리 강의에 쓸 판다렌 복숭아를 5개 구해야 합니다. 레벨 10‡Consigue 5 melocotones pandaren para la lección de cocina de Nomi.‡‡Procurez-vous 5 Pêches pandarènes pour la Leçon de cuisine de Nomi.‡为诺米的烹饪课准备5个熊猫人蜜桃。‡',
  }
},
[31333] = {
  {
    'Lição 2: Macarrão instantâneo‡Урок 2: растворимая лапша‡Lektion 2: Fertignudeln‡2강: 라면‡Lección 2: Tallarines instantáneos‡‡Leçon 2 : Nouilles instantanées‡第2课：速食面‡',
    nil,
    'Consiga 5 porções de Macarrão Instantâneo para a aula de Nomi. Uma‡Достаньте 5 порций лапши быстрого приготовления для занятий с Номи. это‡Besorgt 5 Portionen Fertignudeln für Nomis Kochlektion.‡노미의 강의에 쓸 라면을 5개 구해야 합니다. 레벨 10‡Consigue 5 tallarines instantáneos para la lección de Nomi.‡‡Procurez-vous 5 portions de Nouilles instantanées pour la Leçon de cuisine de Nomi.‡为诺米的烹饪课准备5块速食面。‡',
  }
},
[31334] = {
  {
    'Lição 3: Carne seca de peixe tostada‡Урок 3: подрумяненная соленая рыба‡Lektion 3: Gerösteter Trockenfisch‡3강: 불에 구운 어포‡Lección 3: Cecina de pescado tostada‡‡Leçon 3 : Poisson séché grillé‡第3课：烤鱼片‡',
    nil,
    'Conseguir 5 Carpas Douradas para a aula de Nomi. Uma‡Достаньте 5 золотистых карпов для занятий с Номи. это‡Besorgt 5 Goldkarpfen für Nomis Kochlektion.‡노미의 강의에 쓸 황금 잉어를 5마리 구해야 합니다. 레벨 10‡Consigue 5 carpas doradas para la lección de Nomi.‡‡Procurez-vous 5 Carpes dorées pour la Leçon de cuisine de Nomi.‡为诺米的烹饪课准备5条金色鲤鱼。‡',
  }
},
[31335] = {
  {
    'Lição 4: Cogumelo-agulha seco‡Урок 4: сушеный игольчатый гриб.‡Lektion 4: Getrocknete Nadelpilze‡4강: 말린 가시 버섯‡Lección 4: Senderuelas secas‡‡Leçon 4 : Aiguilles d’or séchées‡第4课：金针菇干‡',
    nil,
    'Consiga 5 Cogumelos-agulha para a aula de Nomi. Uma‡Достаньте 5 опят для занятий с Номи. это‡Besorgt 5 Nadelpilze für Nomis Kochlektion.‡노미의 강의에 쓸 가시 버섯을 5개 구해야 합니다. 레벨 10‡Consigue 5 senderuelas para la lección de Nomi.‡‡Procurez-vous 5 Aiguilles d’or pour la Leçon de cuisine de Nomi.‡为诺米的烹饪课准备5把金针菇。‡',
  }
},
[31336] = {
  {
    'Lição 5: Bolo de arroz socado‡Урок 5: торт из молотого риса‡Lektion 5: Stampfreiskuchen‡5강: 절편‡Lección 5: Pastel de arroz aplastado‡‡Leçon 5 : Gâteau de riz pétri‡第5课：打糕‡',
    nil,
    'Consiga 5 porções de Arroz para a aula de Nomi. Uma‡Достаньте 5 порций риса для занятий с Номи. это‡Besorgt Euch 5 Portionen Reis für Nomis Kochlektion.‡노미의 강의에 쓸 쌀을 5개 구해야 합니다. 레벨 10‡Consigue 5 de arroz para la lección de Nomi.‡‡Procurez-vous 5 portions de Riz pour la Leçon de cuisine de Nomi.‡为诺米的烹饪课准备5份大米。‡',
  }
},
[31337] = {
  {
    'Em Sinal de Agradecimento‡Знак признательности‡Ein Zeichen der Anerkennung‡감사의 표시‡Una muestra de aprecio‡‡Une preuve d’estime‡一点心意‡',
    nil,
    'Receba o presente de Nomi. Uma‡Получите подарок Номи. это‡Nehmt Nomis Geschenk an.‡노미의 선물을 받아야 합니다. 레벨 10‡Recibe el regalo de Nomi.‡‡Acceptez le cadeau de Nomi.‡接受诺米的礼物。‡',
  }
},
[31338] = {
  {
    'Nininho perdido‡Заблудший барашек‡Ein verlorenes Schäfchen‡잃어버린 양돌이‡Ovejita perdida‡‡Sauvez Moumoute‡失踪的咩咩羊‡',
    nil,
    'Encontre Nininho e devolva-o a Tchi Tchi. Uma‡Найдите Бяшу и верните его Чи-Чи.‡Findet Schäfchen und bringt es zu Chi-Chi zurück.‡양돌이를 찾아서 치 치에게 되돌려줘야 합니다. 레벨 15 네 바람의 계곡‡Encuentra a Ovejita y devuélvesela a Chee Chee.‡‡Retrouvez Moumoute et ramenez-le à Chii Chii.‡找到咩咩羊并将它带回吱吱身边。‡',
  }
},
[31339] = {
  {
    'Nininho perdido... de novo‡Заблудший барашек... Еще раз‡Schäfchen ist schon wieder weg‡양돌이가 또 도망쳤다고?‡Ovejita perdida… otra vez‡‡Sauvez Moumoute… le retour‡再次失踪的咩咩羊‡',
    nil,
    'Encontre Nininho e traga-o de volta à Tchi Tchi. Uma‡Найдите Бяшу и верните его Чи-Чи.‡Findet Schäfchen und bringt ihn zu Chi-Chi zurück.‡양돌이를 찾아서 치 치에게 데려가야 합니다. 레벨 15 네 바람의 계곡‡Encuentra a Ovejita y llévala con Chee Chee.‡‡Retrouvez Moumoute et ramenez-le à Chii Chii.‡找到咩咩羊并将它带回吱吱身边。‡',
  }
},
[31340] = {
  {
    'Ó, Nininho...‡Ох, Бяша...‡Ach, Schäfchen...‡양돌이가 또...‡Oh, Ovejita…‡‡Oh non, Moumoute…‡哦，咩咩羊……‡',
    nil,
    'Encontre Nininho. Uma‡Найдите Бяшу.‡Findet Schäfchen.‡양돌이를 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra a Ovejita.‡‡Retrouvez Moumoute.‡找到咩咩羊。‡',
  }
},
[31341] = {
  {
    'Lobo em pele de ovelha‡Волк в овечьей шкуре‡Ein Wolf im Schafspelz‡양의 탈을 쓴 늑대‡Un lobo con piel de cordero‡‡Un loup dans la bergerie‡披着羊皮的狼‡',
    nil,
    'Use a pele de ovelha velha em qualquer lugar da Serra do Céu ou da Vila Kunzen e mate Krunkgo. Uma‡Используйте старую овечью шкуру в Небогорье или в деревне Куньцзэнь, а потом убейте Крунко.‡Benutzt den alten Schafspelz irgendwo auf der Himmelsweite oder in Kunzen und tötet dann Krungko.‡하늘능선 또는 쿤젠 마을 아무 곳에서나 양가죽을 사용한 뒤에 크룽코를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Usa la piel de oveja antigua en cualquier lugar de Firmamento o del Poblado Kunzen y mata a Krungko.‡‡Utilisez la Vieille peau de mouton n’importe où dans la Chaîne des Cieux ou à Kunzen, puis tuez Krungko.‡在摩天山脊或昆森村的任意位置使用旧羊皮，然后击败库科。‡',
  }
},
[31342] = {
  {
    'O caminho para o respeito passa pela violência‡Путь к уважению лежит через насилие.‡Der Weg zum Respekt liegt in der Gewalt‡인정을 받는 비결은 폭력에‡El camino al respeto yace en la violencia‡‡Le respect s\'obtient par la violence‡尊严来自实力‡',
    nil,
    'Mate o Sha da Violência. Uma‡Убейте Ша Жестокости.‡Tötet das Sha der Gewalt.‡폭력의 샤를 처치해야 합니다. 레벨 20 음영파 수도원‡Mata al sha de la violencia.‡‡Tuez le Sha de la violence.‡杀死狂之煞。‡',
  }
},
[31343] = {
  {
    'Rastreamento de Kovok‡Kovok Tracking‡Die Suche nach Kovok‡코보크 추적‡El seguimiento de Kovok‡‡Kovok Tracking‡科沃克追踪‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31344] = {
  {
    'Tracking Event: Chee Chee Exalted‡Tracking Event: Chee Chee Exalted‡Tracking Event: Chee Chee Exalted‡이벤트 추적: 치 치 확고한 동맹‡Evento de seguimiento: Chee Chee exaltado‡‡Tracking Event: Chee Chee Exalted‡跟踪事件：兴奋的琪琪‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
