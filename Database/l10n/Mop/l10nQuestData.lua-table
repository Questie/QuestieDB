},
[1175] = {
  {
    'Tinha um calombo no meio do caminho‡Помехи на трассе‡Eine Straßenunebenheit‡경주 중의 충돌‡Un bache en la carretera‡Un bache en la carretera‡Les cahots de la piste‡安全隐患‡安全隱患',
    nil,
    'Mate 10 Basiliscos Sal-gema, 10 Cristaldermes Sal-gema e 6 Observadores Sal-gema para o Mestre de Pistas Zheran no Salar Cintilante.‡Убейте 10 просоленных василисков, 10 просоленных хрусталисков и 6 просоленных взорней, после чего вернитесь к начальнику трассы Зерину на Мерцающую равнину.‡Tötet 10 Salzsteinbasilisken, 10 Salzsteinkristallhäute und 6 Salzsteinstarrer für Rennstreckenleiter Zherin in der schimmernden Ebene.‡소금 평원에 있는 경주로관리인 제린을 위해 소금바위 바실리스크 10 마리, 소금바위 수정바실리스크 10 마리 및 소금바위 큰눈바실리스크 6 마리를 처치해야 합니다.‡El maestro rastreador Zherin quiere que mates a 10 basiliscos Piedra de sal, 10 vitropieles Piedra de sal y 6 observadores Piedra de sal en El Desierto de Sal.‡El maestro rastreador Zherin quiere que mates a 10 basiliscos Piedra de sal, 10 vitropieles Piedra de sal y 6 observadores Piedra de sal en El Desierto de Sal.‡Tuez 10 Basilics du sel gemme, 10 Peau-de-cristal du sel gemme et 6 Contemplateurs du sel gemme pour le maître pisteur Zherin des Salines.‡为闪光平原的赛道管理员泽尔林杀死10条盐石蜥蜴、10条盐石水晶蜥蜴和6条盐石凝视者。‡為閃光平原的賽道管理員澤爾林殺死10條鹽石蜥蜴、10條鹽石水晶蜥蜴和6條鹽石凝視者。',
  }
},
[1176] = {
  {
    'Peso pena‡Уменьшение веса‡Gewicht reduzieren‡하중 줄이기‡Menos peso‡Menos peso‡Allégement de la structure‡减轻负重‡減輕負重',
    nil,
    'Obtenha 10 Ossos Ocos de Abutre para Relé no Salar Cintilante.‡Добудьте 10 полых костей стервятника для Поззика с Мерцающей равнины.‡Beschafft 10 hohle Geierknochen für Pozzik in der Schimmernden Ebene.‡소금 평원에 있는 포직을 위해 가벼운 독수리 뼈 10개를 구해야 합니다.‡Consigue 10 huesos huecos de buitre para Pozzik en El Desierto de Sal.‡Consigue 10 huesos huecos de buitre para Pozzik en El Desierto de Sal.‡Se procurer 10 Os creux de vautour pour Pozzik dans les Salines.‡给闪光平原的普兹克找10根空心秃鹫骨。‡給閃光平原的普茲克找10根空心禿鷹骨。',
  }
},
[1177] = {
  {
    'Fome!‡Моя голодный!‡Hunger!‡배고픈 오우거‡¡Qué hambre!‡¡Qué hambre!‡Faim !‡饿！‡餓!',
    nil,
    'Esmagabarro Pé-sujo, na parte norte do Pântano Vadeoso, quer 8 Cabeças de Lamapina.‡Принесите дробильщику Грязноногу, живущему на севере Пылевых топей, 8 голов мурлоков из клана Болотного Плавника.‡Schlammpatsch Dreckfuß in den nördlichen Düstermarschen möchte 8 Schlammflossenköpfe.‡먼지진흙 습지대 북쪽에 있는 머드크러쉬 더트피트가 진흙아가미 멀록의 머리 8개를 가져다 달라고 했습니다.‡Fangolpe Piesucio del norte de Revolcafango quiere 8 cabezas de Ancalodo.‡Fangolpe Piesucio del norte de Revolcafango quiere 8 cabezas de Ancalodo.‡Pilebou Piessale, dans le nord d\'Âprefange, veut 8 Têtes d\'Aileron boueux.‡尘泥沼泽北部的马德克拉什要你去抓8条泥鳍小鱼。‡塵泥沼澤北部的碎泥·杜特非要你去抓8條沼鰭小魚。',
  }
},
[1178] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblinsponsoring‡고블린 후원‡Patrocinio goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡哥布林贊助商',
    nil,
    'Speak to Gazlowe at Ratchet in The Barrens.‡Поговорите с Газлоу в Кабестане, что в Степях.‡Sprecht mit Gazlowe in Ratschet im Brachland.‡불모의 땅의 톱니항에 있는 가즈로와 대화해야 합니다.‡Habla con Gazlowe en Trinquete, en Los Baldíos.‡Habla con Gazlowe en Trinquete, en Los Baldíos.‡Parler à Gazleu à Cabestan, dans les Tarides.‡和贫瘠之地棘齿城的加兹鲁维谈一谈。‡到貧瘠之地的棘齒城找加茲魯維談話。',
  }
},
[1179] = {
  {
    'Os irmãos Latafuso‡Братья Медноштиф‡Die Brüder Kupferbolz‡브라스볼츠 형제‡Los hermanos Pernolatón‡Los hermanos Pernolatón‡Les frères Zéboulon‡防撞头盔‡銅栓兄弟',
    nil,
    'Bring the crate of crash helmets to Wizzle Brassbolts at Mirage Raceway in Thousand Needles.‡Принесите ящик с защитными шлемами Виззлу Медноштифу на Мерцающую равнину, что в Тысяче Игл.‡Bringt die Kiste mit Schutzhelmen zu Wizzel Kupferbolz. Zu finden ist er an der Illusionenrennbahn in Tausend Nadeln.‡버섯구름 봉우리의 소금 평원에 있는 위즐 브라스볼츠에게 충격방지 보호모 상자를 가져가야 합니다.‡Llévale el cajón de cascos de choque a Wizzle Pernolatón, que está en el Circuito del Espejismo en Las Mil Agujas.‡Llévale el cajón de cascos de choque a Wizzle Pernolatón, que está en el Circuito del Espejismo en Las Mil Agujas.‡Apportez la Caisse de casques anti-accidents à Lachnouf Zéboulon, à la Piste des mirages, dans les Salines.‡给千针石林闪光平原上的维兹尔·铜栓捎去一箱防撞头盔。‡到千針石林的沙漠賽道，把防撞盔帽木箱帶交給維茲爾·銅栓。',
  }
},
[1180] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblinsponsoring‡고블린 후원‡Patrocinio goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡哥布林贊助商',
    nil,
    'Speak with Wharfmaster Lozgil in Booty Bay.‡Поговорите с управляющим пристанью Подгребаем в Пиратской Бухте.‡Sprecht mit Werftmeister Lozgil in Beutebucht.‡무법항에 있는 부두주임 로즈길과 대화해야 합니다.‡Habla con el jefe de embarcadero Lozgil en Bahía del Botín.‡Habla con el jefe de embarcadero Lozgil en Bahía del Botín.‡S\'adresser au Maître des quais Lozouïe à Baie-du-Butin.‡和藏宝海湾的码头管理员罗兹基尔谈一谈。‡和藏寶海灣的碼頭管理員羅茲基爾談話。',
  }
},
[1181] = {
  {
    '‡Гоблинская поддержка‡Goblinsponsoring‡고블린 후원‡Patrocinio goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡',
    nil,
    '‡Поговорите с бароном Ревилгазом в Пиратской Бухте.‡Sprecht mit Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈와 대화해야 합니다.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Parler au Baron Revilgaz à Baie-du-Butin.‡与藏宝海湾的大财主里维加兹谈一谈。‡',
  }
},
[1182] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblinsponsoring‡고블린 후원‡Patrocinio goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡哥布林贊助商',
    nil,
    'Leve os Esquemas do Regulador de Combustível para o Barão Rezingada na Angra do Butim.‡Принесите чертежи топливного регулятора барону Ревилгазу из Пиратской Бухты.‡Bringt die Treibstoffreglerblaupausen zu Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈에게 연료조절장치 설계도를 가져가야 합니다.‡Lleva los planos de regulador de combustible al Barón Revilgaz en la Bahía del Botín.‡Lleva los planos de regulador de combustible al Barón Revilgaz en la Bahía del Botín.‡Apportez les Plans du régulateur de carburant au baron Revilgaz à Baie-du-Butin.‡将燃料调节器的蓝图交给藏宝海湾的大财主里维加兹。‡將燃料調節器的藍圖交給藏寶海灣的大財主里維加茲。',
  }
},
[1183] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblinsponsoring‡고블린 후원‡Patrocinio goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡哥布林贊助商',
    nil,
    'Leve os Esquemas do Regulador de Combustível para Relé no Salar Cintilante.‡Отнесите чертежи топливного регулятора Поззику на Мерцающую равнину.‡Bringt die Treibstoffreglerblaupausen zu Pozzik in der schimmernden Ebene.‡소금 평원에 있는 포직에게 연료조절장치 설계도를 전해야 합니다.‡Entrega los planos de regulador de combustible a Pozzik en El Desierto de Sal.‡Entrega los planos de regulador de combustible a Pozzik en El Desierto de Sal.‡Apporter les Plans du Régulateur de carburant à Pozzik dans les Salines.‡把燃料调节器的蓝图带给闪光平原的普兹克。‡把燃料調節器的藍圖帶給閃光平原的普茲克。',
  }
},
[1184] = {
  {
    'Pedaços do enxame‡Части роя‡Teile des Schwarms‡실리시드 등껍질‡Pedazos del enjambre‡Pedazos del enjambre‡Des parties de l\'Essaim‡虫群的消息‡蟲群的樣本',
    nil,
    'Fale novamente com Belgrom Pedramalho em Orgrimmar.‡Вернитесь к Белгрому Каменной Булаве в Оргриммар.‡Kehrt zu Belgrom Felshammer in Orgrimmar zurück.‡오그리마에 있는 벨그롬 록마울에게 가야 합니다.‡Ve a ver de nuevo a Belgrom Destrozarroca a Orgrimmar.‡Ve a ver de nuevo a Belgrom Destrozarroca a Orgrimmar.‡Retour à Orgrimmar pour voir Belgrom Cogneroche.‡回到奥格瑞玛的贝尔戈洛姆·石槌那儿。‡回到奧格瑪的貝爾戈洛姆·石槌那兒。',
  }
},
[1185] = {
  {
    '‡А под хитином было...‡Unter dem Chitin war...‡‡Debajo de la quitina había...‡Debajo de la quitina había...‡Sous la chitine...‡壳中的东西…‡',
    nil,
    nil,
  }
},
[1186] = {
  {
    '‡Восемнадцатый пилот‡Der achtzehnte Rennfahrer‡‡El piloto nº18‡El piloto nº18‡Le dix-huitième pilote‡第十八个驾驶员‡',
    nil,
    '‡Поговорите с Раззериком на Мерцающей равнине, что в Тысяче Игл.‡Sprecht mit Razzeric in der Schimmernden Ebene in Tausend Nadeln.‡‡Habla con Razzeric en El Desierto de Sal, en Las Mil Agujas.‡Habla con Razzeric en El Desierto de Sal, en Las Mil Agujas.‡S\'adresser à Razzeric, dans les Salines, aux Mille pointes.‡和闪光平原的拉泽瑞克谈一谈。‡',
  }
},
[1187] = {
  {
    'Do jeitinho do Razzeric‡Доработка Раззерика‡Razzerics Basteln‡래저릭의 호기‡Los ajustes de Razzeric‡Los ajustes de Razzeric‡Les trucs de Razzeric‡拉泽瑞克的调整‡拉澤瑞克的調整',
    nil,
    'Recupere o Foguete de Cequatrum para Razzeric no Salar Cintilante.‡Найдите сефориевый ускоритель для Раззерика на Мерцающей равнине.‡Bergt den Zephyriumnachbrenner für Razzeric in der Schimmernden Ebene.‡소금 평원에 있는 래저릭을 위해 시포리움 부스터를 입수해야 합니다.‡Consigue el propulsor de seforio para Razzeric, en El Desierto de Sal.‡Consigue el propulsor de seforio para Razzeric, en El Desierto de Sal.‡Récupérer le Lance-hydroglycérine pour Razzeric dans les Salines.‡为闪光平原的拉泽瑞克取回爆盐增压器。‡為閃光平原的拉澤瑞克取回爆鹽推進器。',
  }
},
[1188] = {
  {
    'Segurança em primeiro lugar‡Безопасность превыше всего‡Sicherheit zuerst‡안전 제일‡La seguridad primero‡La seguridad primero‡La sécurité d\'abord‡安全第一‡安全第一',
    nil,
    'Bring the Seaforium Booster to Shreev at Gadgetzan in Tanaris.‡Отнесите сефориевый ускоритель Шриву в Прибамбасск, что в Танарисе.‡Bringt den Zephyriumnachbrenner zu Kainer nach Gadgetzan in Tanaris.‡타나리스의 가젯잔에 있는 쉬리브에게 시포리움 부스터를 가져가야 합니다.‡Llévale el propulsor de seforio a Shreev, que está en Gadgetzan en Tanaris.‡Llévale el propulsor de seforio a Shreev, que está en Gadgetzan en Tanaris.‡Apportez le Lance-hydroglycérine à Shreev à Gadgetzan, en Tanaris.‡把塔纳利斯爆盐增压器交给加基森的史瑞夫。‡到塔納利斯把爆鹽推進器交給加基森的史瑞夫。',
  }
},
[1189] = {
  {
    'Segurança em primeiro lugar‡Безопасность превыше всего‡Sicherheit zuerst‡안전 제일‡La seguridad primero‡La seguridad primero‡La sécurité d\'abord‡安全第一‡安全第一',
    nil,
    'Return the Modified Seaforium Booster to Razzeric on the Shimmering Flats in Thousand Needles.‡Верните модифицированный сефориевый ускоритель Раззерику на Мерцающую равнину, что в Тысяче Игл.‡Bringt den umgebauten Zephyriumnachbrenner zu Razzeric. Zu finden ist er in der Schimmernden Ebene in Tausend Nadeln.‡버섯구름 봉우리의 소금 평원에 있는 래저릭에게 개조된 시포리움 부스터를 다시 가져가야 합니다.‡Devuélvele el propulsor de seforio modificado a Razzeric, que está en El Desierto de Sal en Las Mil Agujas.‡Devuélvele el propulsor de seforio modificado a Razzeric, que está en El Desierto de Sal en Las Mil Agujas.‡Rapporter le Lance-hydroglycérine modifié à Razzeric, dans les Salines, aux Mille pointes.‡将改进型爆盐增压器还给千针石林闪光平原的拉泽瑞克。‡到千針石林把改進型爆鹽推進器還給閃光平原的拉澤瑞克。',
  }
},
[1190] = {
  {
    '‡Только вперед‡Tempo halten‡‡Mantener la velocidad‡Mantener la velocidad‡Rester dans la course‡跟上节奏‡',
    nil,
    '‡Дождитесь, пока Замек устроит диверсию, украдите чертежи Риззла и отнестие их Поззику на Мерцающую равнину, что в Тысяче Игл.‡Lasst Zamek ein Ablenkungsmanöver inszenieren und stehlt dann Rizzels Pläne für Pozzik in der Schimmernden Ebene in Tausend Nadeln.‡‡Consigue que Zamek haga una artimaña de distracción y roba los diseños de Rizzle para Pozzik en El Desierto de Sal, en Las Mil Agujas.‡Consigue que Zamek haga una artimaña de distracción y roba los diseños de Rizzle para Pozzik en El Desierto de Sal, en Las Mil Agujas.‡Utiliser Zamek pour faire diversion, dérober les plans de Tropp et les apporter à Pozzik dans les Salines, aux Mille pointes.‡让扎米克掩护你，然后为闪光平原的普兹克偷到瑞兹尔的计划。‡',
  }
},
[1191] = {
  {
    '‡Помеха Замека‡Zameks Ablenkungsmanöver‡‡La distracción de Zamek‡La distracción de Zamek‡La diversion de Zamek‡扎米克的困扰‡',
    nil,
    nil,
  }
},
[1192] = {
  {
    '‡Индарилиевая руда‡Induriumerz‡인듀리움 광석‡Mena de indurio‡Mena de indurio‡Minerai d\'indurium‡精铁矿石‡精鐵礦石',
    nil,
    nil,
  }
},
[1193] = {
  {
    '‡Сломанная западня‡Eine beschädigte Falle‡부서진 함정‡Una trampa rota‡Una trampa rota‡Un piège cassé‡破碎的陷阱‡',
    nil,
    nil,
  }
},
[1194] = {
  {
    '‡Чертежи Риззла‡Rizzels Baupläne‡‡Los esquemas de Rizzle‡Los esquemas de Rizzle‡Les schémas de Tropp‡瑞兹尔的图表‡',
    nil,
    '‡Отнесите образец индарилиевой руды Поззику на Мерцающую равнину, что в Тысяче Игл.‡Bringt die Induriumerzprobe zu Pozzik. Zu finden ist er in der Schimmernden Ebene in Tausend Nadeln.‡‡Llévale la muestra de mena de indurio a Pozzik, que está en El Desierto de Sal en Las Mil Agujas.‡Llévale la muestra de mena de indurio a Pozzik, que está en El Desierto de Sal en Las Mil Agujas.‡Apportez l\'Échantillon de minerai d\'indurium à Pozzik dans les Salines, aux Mille pointes.‡把精铁矿石样本交给闪光平原上的普兹克。‡',
  }
},
[1195] = {
  {
    'A Chama Sagrada‡Священное пламя‡Die heilige Flamme‡신성한 불꽃‡La llama sacra‡La llama sacra‡La flamme sacrée‡神圣之火‡神聖之火',
    nil,
    'Leve o Frasco Cinzelado Cheio para Zangan Casco de Pedra no Penhasco do Trovão.‡Принесите наполненный гравированный фиал Зангену Каменному Копыту в Громовой Утес.‡Bringt eine gefüllte geätzte Phiole zu Zangen Steinhuf in Donnerfels.‡썬더 블러프 상층에 있는 잔겐 스톤후프에게 가득 찬 청옥 약병을 가져가야 합니다.‡Llévale una ampolla con grabados llena a Zangen Pezuña Pétrea, que está en Cima del Trueno.‡Llévale una ampolla con grabados llena a Zangen Pezuña Pétrea, que está en Cima del Trueno.‡Rapporter une Fiole d\'Eau forte remplie à Zangen Sabot-de-Pierre aux Pitons-du-Tonnerre.‡把装满水的蚀刻瓶交给雷霆崖的赞金·石蹄。‡把裝滿的蝕刻之瓶交給雷霆崖的贊金·石蹄。',
  }
},
[1196] = {
  {
    'A Chama Sagrada‡Священное пламя‡Die heilige Flamme‡신성한 불꽃‡La llama sacra‡La llama sacra‡La flamme sacrée‡神圣之火‡神聖之火',
    nil,
    'Entregue o Frasco Cinzelado Cheio a Rau Corta Montes na Aldeia Vento Livre.‡Доставьте наполненный гравированный фиал Рау Скальному Бегуну на Заставу Вольного Ветра.‡Bringt die gefüllte geätzte Phiole zu Rau Klippenläufer im Freiwindposten.‡높새바람 봉우리에 있는 라우 클리프러너에게 가득 찬 청옥 약병을 전해야 합니다.‡Entrégale la ampolla con grabados llena a Rau Abiscorredor del Poblado Viento Libre.‡Entrégale la ampolla con grabados llena a Rau Abiscorredor del Poblado Viento Libre.‡Remettre la Flasque d\'eau forte remplie à Rau Cours-les-falaises au Poste de Librevent.‡把装满水的蚀刻瓶交给乱风岗的拉乌·峭壁信使。‡把裝滿的蝕刻之瓶交給亂風崗的勞恩·峭壁行者。',
  }
},
[1197] = {
  {
    'A Chama Sagrada‡Священное пламя‡Die heilige Flamme‡신성한 불꽃‡La llama sacra‡La llama sacra‡La flamme sacrée‡神圣之火‡神聖之火',
    nil,
    'Recupere o Casco Fendido para Rau Corta Montes na Aldeia Vento Livre.‡Принесите раздвоенное копыто Рау Скальному Бегуну на Заставу Вольного Ветра.‡Holt den gespaltenen Huf für Rau Klippenläufer im Freiwindposten.‡높새바람 봉우리에 있는 라우 클리프러너에게 갈래 발굽을 가져가야 합니다.‡Consigue la pezuña hendida para Rau Abiscorredor del Poblado Viento Libre.‡Consigue la pezuña hendida para Rau Abiscorredor del Poblado Viento Libre.‡Récupérer le Sabot fendu pour Rau Cours-les-falaises du Poste de Librevent.‡拿到裂开的蹄子，把它交给乱风岗的劳恩·峭壁行者。‡拿到裂開的蹄子，把它交給亂風崗的勞恩·峭壁行者。',
  }
},
[1198] = {
  {
    'Procurando Thaelrid‡В поисках Талрида‡Auf der Suche nach Thaelrid‡타엘리드 찾기‡Buscando a Thaelrid‡Buscando a Thaelrid‡À la recherche de Thaelrid‡寻找塞尔瑞德‡尋找塞爾瑞德',
    nil,
    'Seek out Scout Thaelrid inside Blackfathom Deeps.‡Найдите разведчика Талрида из ордена Серебряного Рассвета в Непроглядной Пучине.‡Sucht Späher Thaelrid in der Tiefschwarzen Grotte auf.‡검은심연 나락에서 정찰병 타엘리드를 찾아야 합니다.‡Busca al explorador Thaelrid en las Cavernas de Brazanegra.‡Busca al explorador Thaelrid en las Cavernas de Brazanegra.‡Partez à la recherche de l’Éclaireur Thaelrid, dans les Profondeurs de Brassenoire.‡到黑暗深渊去找到银月守卫塞尔瑞德。‡到黑澗深淵去找斥候塞爾瑞德。',
  }
},
[1199] = {
  {
    'A Hora do Crepúsculo‡Наступление сумерек‡Die Stunde der Finsternis‡황혼의 망치단의 몰락‡Cascada Crepuscular‡Cascada Crepuscular‡Le crépuscule descend‡暮光之锤的末日‡暮光之錘的末日',
    nil,
    'Bring 10 Twilight Pendants to Sentinel Aluwyn at the Blackfathom Camp.‡Принесите 10 подвесок Сумерек часовому Алувин в лагерь у Непроглядной Пучины.‡Bringt 10 Zwielichtanhänger zu Schildwache Aluwyn im Stützpunkt an der Grotte.‡검은심연 야영지에 있는 파수꾼 알루윈에게 황혼의 펜던트 10개를 가져가야 합니다.‡Lleva 10 colgantes Crepusculares a la centinela Aluwyn en el Campamento Brazanegra.‡Lleva 10 colgantes Crepusculares a la centinela Aluwyn en el Campamento Brazanegra.‡Apportez 10 Pendentifs du Crépuscule à la Sentinelle Aluwyn, au Camp de Brassenoire.‡收集10个暮光坠饰，把它们交给黑渊营地的哨兵阿露温。‡收集10個暮光墜飾，把它們交給黑澗營地的哨兵阿露溫。',
  }
},
[1200] = {
  {
    'Vilania das Profundezas‡Жестокость Черных Глубин‡Schurkerei in der Tiefschwarzen Grotte‡검은심연의 음모‡La vileza de Brazanegra‡La vileza de Brazanegra‡L\'infamie de Brassenoire‡黑暗深渊中的恶魔‡黑澗深淵中的惡魔',
    nil,
    'Bring the head of Twilight Lord Kelris to Ashelan Northwood at the Blackfathom Camp.‡Bring the head of Twilight Lord Kelris to Ashelan Northwood at the Blackfathom Camp.‡Bringt den Kopf von Zwielichtfürst Kelris zu Ashelan Nordwald im Stützpunkt an der Grotte.‡황혼의 군주 켈리스를 처치하고 그 증거로 머리카락을 검은심연 야영지에 있는 애쉬엘란 노스우드에게 가져가야 합니다.‡Llévale la cabeza del señor crepuscular Kelris a Ashelan Bosquenorte en el Campamento Brazanegra.‡Llévale la cabeza del señor crepuscular Kelris a Ashelan Bosquenorte en el Campamento Brazanegra.‡Apportez la Tête du Seigneur du Crépuscule Kelris à Ashelan Bois-du-nord, au Camp de Brassenoire.‡把暮光领主克尔里斯的徽记交给黑渊营地的阿舍兰·北林。‡將暮光領主克爾里斯的頭顱帶去黑澗營地給阿謝蘭‧北木。',
  }
},
[1201] = {
  {
    'Os espiões de Theramore‡Тераморские шпионы‡Theramores Spione‡테라모어 침투요원‡Los espías de Theramore‡Los espías de Theramore‡Les espions de Theramore‡塞拉摩间谍‡塞拉摩間諜',
    nil,
    'Mate 9 Infiltradores de Theramore e, em seguida, fale com Nazir Piquessangue, na Aldeia Muralha Verde.‡Убейте 9 тераморских шпионов, потом вернитесь к Назиру Кровавому Копью в деревню Гиблотопь.‡Tötet 9 Spitzel von Theramore und kehrt dann zu Nazeer Blutlanze in Brackenwall zurück.‡테라모어 침투요원 9명을 처치한 다음 담쟁이 마을에 있는 나지르 블러드파이크에게 가야 합니다.‡Mata a 9 infiltrados de Theramore y luego reúnete con Nazeer Picasangre en el Poblado Murohelecho.‡Mata a 9 infiltrados de Theramore y luego reúnete con Nazeer Picasangre en el Poblado Murohelecho.‡Tuer 9 Infiltrateurs de Theramore, puis rendre compte à Nazeer Pique-sanglante à Mur-de-Fougères.‡杀掉9个塞拉摩间谍，然后回到蕨墙村去见纳泽尔·血矛。‡殺掉9個塞拉摩間諜，然後回到蕨牆村去見納澤爾·血矛。',
  }
},
[1202] = {
  {
    'As docas de Theramore‡Доки Терамора‡Die Docks von Theramore‡테라모어 부두‡El puerto de Theramore‡El puerto de Theramore‡Les docks de Theramore‡塞拉摩码头‡塞拉摩碼頭',
    nil,
    'Leve os Documentos do Capitão a Nazir Piquessangue na Aldeia Muralha Verde.‡Принесите документы капитана Назиру Кровавому Копью в Деревню Гиблотопь.‡Bringt die Dokumente des Kapitäns zu Nazeer Blutlanze in Brackenwall.‡담쟁이 마을에 있는 나지르 블러드파이크에게 선장의 서류를 가져가야 합니다.‡Lleva los documentos del Capitán a Nazeer Picasangre al Poblado Murohelecho.‡Lleva los documentos del Capitán a Nazeer Picasangre al Poblado Murohelecho.‡Apportez les Documents du capitaine à Nazeer Pique-sanglante au village de Mur-de-Fougères.‡把指挥官的文件交给蕨墙村的纳泽尔·血矛。‡把指揮官的文件交給蕨牆村的納澤爾·血矛。',
  }
},
[1203] = {
  {
    'Zé precisa de uma lâmina‡Ярлу нужен клинок‡Jarl braucht eine Klinge‡자를의 검‡Jarl necesita una hoja‡Jarl necesita una hoja‡Jarl a besoin d\'une épée‡加尔的剑‡加爾需要一把劍',
    nil,
    'Leve a Espada de Cortaspinha para Zé "Olho de Lama", no Casarão do Pantanal Iluminado.‡Принесите меч Костяной Чешуи Ярлу "Болотному Глазу" в сторожку "Болотный огонек".‡Bringt Messerwirbels Schwert zu "Sumpfauge" Jarl im Irrlichtanwesen.‡먼지진흙 습지대에 있는 "늪지눈알" 자를에게 서슬돌기의 검을 가져가야 합니다.‡Lleva la espada de Espinafilada a "Ojolodo" Jarl, en la Mansión Cienaluz.‡Lleva la espada de Espinafilada a "Ojolodo" Jarl, en la Mansión Cienaluz.‡Apportez l’Épée de Tranchéchine à Jarl « Œil-des-marais », au Manoir des Flammeroles.‡将刺脊的剑交给尘泥沼泽的"沼泽之眼"加尔。‡將尖背之劍交給水光莊園的『沼澤之眼』加爾。',
  }
},
[1204] = {
  {
    'Sopa de pedralama com peixe‡Суп из глинистой черепахи с крабами‡Schlammpanzersuppe mit Käfern‡진흙바위거북 수프와 벌레‡Sopa de Fangorroca con tropezones‡Sopa de Fangorroca con tropezones‡Soupe de Rochefange aux insectes‡泥石龟蟹汤‡泥石龜蟹湯',
    nil,
    'Leve 8 Línguas Bifurcadas de Pedralama a Morgado Severo em Theramore.‡Принесите 8 раздвоенных языков глинистых черепах Моргану Штерну в Терамор.‡Bringt Morgan Stern in Theramore 8 gespaltene Schlammpanzerzungen.‡테라모어에 있는 모건 스턴에게 진흙바위거북 혓바닥 8개를 가져가야 합니다‡Lleva 8 lenguas Fangorroca bífidas a Morgan Stern a Theramore.‡Lleva 8 lenguas Fangorroca bífidas a Morgan Stern a Theramore.‡Apporter 8 Langues fourchues de Rochefange à Morgan Stern, à Theramore.‡给塞拉摩的摩根·斯特恩收集8个分叉的泥石龟舌。‡給塞拉摩的摩根·斯特恩收集8個分叉的泥石龜舌。',
  }
},
[1205] = {
  {
    'Mortocharco‡Волокун‡Schlammwühler‡붉은눈늪지악어‡Lodomuerto‡Lodomuerto‡Mortebourbe‡死沼巨鳄‡死沼巨鱷',
    nil,
    'Leve o Dente de Mortocharco a Melor no Penhasco do Trovão.‡Принесите зуб кроколиска Волокуна Мелору в Громовой Утес.‡Bringt Schlammwühlers Zahn zu Melor in Donnerfels.‡썬더 블러프에 있는 멜로르에게 붉은눈늪지악어 이빨을 가져가야 합니다.‡Lleva el Diente de Lodomuerto a Melor a Cima del Trueno.‡Lleva el Diente de Lodomuerto a Melor a Cima del Trueno.‡Apportez la Dent de Mortebourbe à Melor, aux Pitons-du-Tonnerre.‡把死沼巨鳄的牙齿带给雷霆崖的梅洛。‡把死沼巨鱷的牙齒交給雷霆崖的梅洛。',
  }
},
[1206] = {
  {
    'Zé "olho em falta"‡Ярлу нужны глаза‡Jarl braucht Augen‡자를의 부탁‡Jarl necesita ojos‡Jarl necesita ojos‡Jarl a besoin d\'yeux‡加尔和蜘蛛眼‡加爾需要蜘蛛眼',
    nil,
    'Leve 20 Olhos Névoa Negra Inteiros para Zé "Olho de Lama" no Casarão do Pantanal Iluminado.‡Принесите 20 целых глаз пауков Мглистой пещеры Ярлу "Болотному Глазу" в сторожку "Болотный Огонек".‡Bringt 20 unzerplatzte Graunebelaugen zu "Sumpfauge" Jarl im Irrlichtanwesen.‡늪지기 오두막에 있는 "늪지눈알" 자를에게 터지지 않은 암흑안개거미의 눈 20개를 가져가야 합니다.‡Lleva 20 ojos de Niebla Negra sin reventar a "Ojolodo" Jarl a la Mansión Cienaluz.‡Lleva 20 ojos de Niebla Negra sin reventar a "Ojolodo" Jarl a la Mansión Cienaluz.‡Apportez 20 Yeux de Sombrebrume à Jarl « Œil-des-marais », au Manoir des Flammeroles.‡收集20颗黑雾蜘蛛的眼球，把它们交给水光庄园的"沼泽之眼"加尔。‡將20顆完好的暗霧蜘蛛眼球交給水光莊園的『沼澤之眼』加爾。',
  }
},
[1218] = {
  {
    'Pernas de sapo do pântano‡Лягушачьи лапки‡Marschenfroschschenkel‡습지 개구리 다리‡Ancas de rana de marisma‡Ancas de rana de marisma‡Les cuisses de grenouille des marais‡沼泽蛙的腿‡沼澤青蛙腿',
    nil,
    'Leve 10 Pernas de Sapo do Pântano para o Zé "Olho de Lama" no Pântano Vadeoso.‡Принесите 10 лапок болотных лягушек Ярлу "Болотному Глазу" с Пылевых топей.‡Bringt 10 Marschenfroschschenkel zu "Sumpfauge" Jarl in den Düstermarschen.‡먼지진흙 습지대에 있는 "늪지눈알" 자를에게 거대한 개구리 다리 10개를 가져가야 합니다.‡Lleva 10 ancas de rana de marisma a "Ojolodo" Jarl al Marjal Revolcafango.‡Lleva 10 ancas de rana de marisma a "Ojolodo" Jarl al Marjal Revolcafango.‡Apportez 10 Cuisses de grenouilles des marais à Jarl « Œil-des-marais », dans le marécage d\'Âprefange.‡为尘泥沼泽的"沼泽之眼"加尔收集10条沼泽蛙的腿。‡帶10條沼澤青蛙腿給塵泥沼澤的『沼澤之眼』加爾。',
  }
},
[1219] = {
  {
    '[DEPRECATED]The Orc Report‡[DEPRECATED]The Orc Report‡Der Orcbericht‡오크 보고서‡[DEPRECATED]El informe orco‡‡[PÉRIMÉ]Le rapport orc‡[DEPRECATED] 兽人的报告‡',
    nil,
    'Leve o Relatório do Espião ao Tenente Aden, em Theramore.‡Доставьте донесение шпиона лейтенанту Адену в Терамор.‡Bringt den Bericht des Spions zu Leutnant Aden in Theramore.‡테라모어에 있는 부관 아덴에게 밀정의 보고서를 가져가야 합니다.‡Lleva el informe de espía al teniente Aden a Theramore.‡‡Apportez le Rapport de l\'Espion au Lieutenant Aden de Theramore.‡把间谍的报告交给塞拉摩的艾登中尉。‡',
  }
},
[1220] = {
  {
    '‡‡Hauptmann Mumm‡‡[DEPRECATED]Capitán Vimes‡‡[PÉRIMÉ]Le capitaine Vimaire‡‡',
    nil,
    '‡Принесите шпионское донесение капитану Гаррану Ваймсу.‡Bringt den Bericht des Spions zu Hauptmann Garran Mumm.‡사령관 개런 바임스에게 밀정의 보고서를 가져가야 합니다.‡Lleva el informe de espía al capitán Garran Vimes.‡Lleva el informe de espía al capitán Garran Vimes.‡Apportez le Rapport orc au capitaine Garran Vimaire.‡把间谍的报告交给盖兰·维米斯队长。‡',
  }
},
[1221] = {
  {
    'Tubérculos Folhazul‡Корни Синелиста‡Blaulaubknollen‡청엽수 줄기‡Los tubérculos hojazul‡Los tubérculos hojazul‡Racines de feuillebleue‡蓝叶薯‡藍葉薯',
    nil,
    'Pegue um Caixote com Furos.|nPegue um Bastão de Adestramento do Fungafuça.|nPegue e leia o Manual de Proprietário do Fungafuça.|n|nNo Urzal dos Tuscos, use o Caixote com Furos para evocar uma Marmota Fungafuça, e use o Bastão de Adestramento do Fungafuça para fazer ela farejar os tubérculos.|n|nLeve 6 Tubérculos Folhazul, o Bastão de Adestramento do Fungafuça e o Caixote com Furos para Cáliper Porcatraca na Vila Catraca.‡Возьмите ящик с дырками.|nВозьмите палочку-погонялочку для шмыгуносов.|nВозьмите справочник по шмыгуносам. |n|nВ Лабиринтах Иглошкурых выпустите шмыгуноса и воспользуйтесь стеком, чтобы он начал искать корни. |n|nПринесите 6 корней синелиста, стек и ящик с дырками Мебоку Миззриксу в Кабестан.‡Schnappt Euch eine Kiste mit Löchern.|nSchnappt Euch einen Schnüffelnasenleitstecken.|nSchnappt Euch das Handbuch für Schnüffelnasenbesitzer und lest es.|n|nBenutzt im Kral der Klingenhauer die Kiste mit Löchern, um ein Schnüffelnasenziesel zu beschwören, und benutzt den Leitstecken bei dem Ziesel, damit es nach Knollen sucht.|n|nBringt 6 Blaulaubknollen, den Schnüffelnasenleitstecken und die Kiste mit Löchern zu Mebok Mizzyrix in Ratschet.‡구멍 난 상자를 집어야 합니다.|n땅다람쥐 지휘봉도 챙겨야 합니다.|n땅다람쥐 설명서를 찾아서 읽어야 합니다.|n|n가시덩굴 우리에서 구멍 난 상자를 사용해 땅다람쥐를 소환하고 지휘봉을 사용해 땅다람쥐에게 청엽수 줄기를 찾아내도록 해야 합니다.|n|n톱니항에 있는 메보크 미지릭스에게 청엽수 줄기 6개와 사용한 땅다람쥐 지휘봉과 구멍 난 상자를 가져가야 합니다.‡Coge un cajón con agujeros.|nCoge una vara de mando de husmeador.|nLee el manual de propietario de husmeador. |n|nCuando llegues a Horado Rajacieno, usa el cajón con agujeros para invocar un husmeador taltuza; usa la vara para que busque tubérculos. |n|nLleva 6 tubérculos hojazul, la vara de mando de husmeador y el cajón con agujeros a Mebok Mizzyrix a Trinquete.‡Coge un cajón con agujeros.|nCoge una vara de mando de husmeador.|nLee el manual de propietario de husmeador. |n|nCuando llegues a Horado Rajacieno, usa el cajón con agujeros para invocar un husmeador taltuza; usa la vara para que busque tubérculos. |n|nLleva 6 tubérculos hojazul, la vara de mando de husmeador y el cajón con agujeros a Mebok Mizzyrix a Trinquete.‡Prenez une Caisse percée.|nPrenez un Bâton de commandement de Sniffetarin.|nLisez le Manuel d\'utilisateur de Sniffetarin.|n|nAu Kraal de Tranchebauge, utilisez la Caisse pour invoquer un Ecureuil Sniffetarin et le Bâton de commandement pour lui ordonner de chercher les racines.|n|nRapportez 6 Racines de feuillebleue, le Bâton de commandement de Sniffetarin et la Caisse percée à Mebok Mizzyrix, à Cabestan.‡找到一个开孔的箱子。|n找到一根地鼠指挥棒。|n找到并阅读《地鼠指挥手册》。|n|n在剃刀沼泽里用开孔的箱子召唤一只地鼠，然后用指挥棒驱使它去搜寻蓝叶薯。|n|n把地鼠指挥棒、开孔的箱子和6块蓝叶薯交给棘齿城的麦伯克·米希瑞克斯。‡找到一個開孔的木箱。|n找到一根地鼠指揮棒。|n找到並閱讀《地鼠指揮手冊》。|n|n在剃刀沼澤裡用開孔的木箱召喚一隻地鼠，然後用指揮棒驅使它去搜尋藍葉薯。|n|n把地鼠指揮棒、開孔的木箱和6塊藍葉薯交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[1222] = {
  {
    'A fuga do Cascão‡Побег Вонючки‡Stinkis Flucht‡말썽꾼의 탈출‡La fuga de Apestoso‡La fuga de Apestoso‡Sauvetage du Puant‡伊格纳兹的逃亡‡伊格納茲的逃亡',
    nil,
    'Escolte Inácio "Cascão" e, em seguida, fale com Morgado Severo em Theramore.‡Сопроводите "Вонючку" Игнаца, затем пообщайтесь с Морганом Штерном в Тераморе.‡Begleitet "Stinki" Ignatz und sprecht dann mit Morgan Stern in Theramore.‡"말썽꾼" 이그나츠를 호위한 다음 테라모어에 있는 모건 스턴과 대화해야 합니다.‡Escolta a "Apestoso" Ignatz y luego ve a Theramore a hablar con Morgan Stern.‡Escolta a "Apestoso" Ignatz y luego ve a Theramore a hablar con Morgan Stern.‡Escortez Ignatz « Puant » puis parlez à Morgan Stern à Theramore.‡护送伊格纳兹，然后和塞拉摩的摩根·斯特恩谈一谈。‡護送伊格納茲，然後和塞拉摩的摩根‧斯特恩談話。',
  }
},
[1238] = {
  {
    'O relatório perdido‡Потерянный рапорт‡Der verlorene Bericht‡사라진 보고서‡El informe perdido‡El informe perdido‡Le rapport perdu‡遗失的报告‡遺失的報告',
    nil,
    'Leve o Relatório do Espião para Nazir Piquessangue na Aldeia Muralha Verde.‡Отнесите донесение шпиона Назиру Кровавому Копью в Деревню Гиблотопь.‡Bringt den Bericht des Spions zu Nazeer Blutlanze in Brackenwall.‡담쟁이 마을에 있는 나지르 블러드파이크에게 밀정의 보고서를 가져가야 합니다.‡Lleva el informe de espía a Nazeer Picasangre al Poblado Murohelecho.‡Lleva el informe de espía a Nazeer Picasangre al Poblado Murohelecho.‡Apportez le Rapport de l\'espion à Nazeer Pique-sanglante à Mur-de-Fougères.‡把间谍的报告交给蕨墙村的纳泽尔·血矛。‡把間諜的報告交給蕨牆村的納澤爾·血矛。',
  }
},
[1239] = {
  {
    '‡Отрубленная Голова‡Der abgetrennte Kopf‡‡La cabeza cercenada‡La cabeza cercenada‡La tête coupée‡被取下的徽记‡',
    nil,
    '‡Принесите голову строптивого орка Назиру Кровавому Копью в Деревню Гиблотопь.‡Bringt den Kopf des aufsässigen Orcs zu Nazeer Blutlanze in Brackenwall.‡‡Lleva la cabeza de orco desafiante a Nazeer Picasangre al Poblado Murohelecho.‡Lleva la cabeza de orco desafiante a Nazeer Picasangre al Poblado Murohelecho.‡Apportez la Tête d\'orc défiant à Nazeer Pique-sanglante à Mur-de-Fougères.‡把兽人的徽记交给蕨墙村的纳泽尔·血矛。‡',
  }
},
[1240] = {
  {
    'O troll mandingueiro‡Тролль-знахарь‡Der Trollhexendoktor‡트롤 의술사‡El trol médico brujo‡El trol médico brujo‡Le féticheur troll‡巨魔巫医‡食人妖巫醫',
    nil,
    'Leve a Cabeça de Orc Desafiante para Kin\'weelay no Acampamento Grom\'gol da Selva do Espinhaço.‡Принесите голову строптивого орка Кин\'вилаю в лагерь Гром\'гол в Тернистой долине.‡Bringt den Kopf des aufsässigen Orcs zu Kin\'weelay im Schlingendorntal im Basislager von Grom\'gol.‡가시덤불 골짜기의 그롬골 주둔지에 있는 킨윌레이에게 혼이 깃든 오크의 가면을 가져가야 합니다.‡Lleva la cabeza de orco desafiante a Kin\'weelay al Campamento Grom\'Gol de Vega de Tuercespina.‡Lleva la cabeza de orco desafiante a Kin\'weelay al Campamento Grom\'Gol de Vega de Tuercespina.‡Apporter la Tête d\'orc défiant à Kin\'weelay au Campement Grom\'gol dans la vallée de Strangleronce.‡把兽人的徽记带到荆棘谷的格罗姆高营地里，交给肯维雷。‡把獸人的頭顱帶給荊棘谷的格羅姆高營地裡的肯維雷。',
  }
},
[1241] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Encontre Jorge em Ventobravo.‡Найдите Йоргена в Штормграде.‡Sucht Jorgen in der Stadt Sturmwind.‡스톰윈드에서 요르겐을 찾아야 합니다.‡Encuentra a Jorgen en Ventormenta.‡Encuentra a Jorgen en la Ciudad de Ventormenta.‡Trouver Jorgen dans la cité de Hurlevent.‡在暴风城的英雄谷找到乔贞。‡在暴風城的英雄谷找到喬貞。',
  }
},
[1242] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Entregue o Bilhete Lacrado para Elling Trias em Ventobravo.‡Доставьте запечатанную записку Йоргена Иллингу Триасу в Штормград.‡Bringt Jorgens versiegelte Notiz zu Elling Trias in der Stadt Sturmwind.‡스톰윈드 내에 있는 엘링 트리아스에게 엘링에게 보내는 봉인된 쪽지를 전해야 합니다.‡Entrega la nota lacrada de Jorgen a Elling Trias en Ventormenta.‡Entrega la nota lacrada de Jorgen a Elling Trias en la Ciudad de Ventormenta.‡Apporter la Note scellée de Jorgen à Elling Trias dans la cité de Hurlevent.‡将乔贞的密信带给暴风城贸易区的埃林·提亚斯。‡將喬貞的密函帶給暴風城貿易區的伊林·提亞斯。',
  }
},
[1243] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Entregue o Bilhete Lacrado para o Vigia Backor na Floresta do Crepúsculo.‡Отнесите запечатанное письмо дозорному Бакусу в Сумеречный лес.‡Gebt Behüter Backus im Dämmerwald die versiegelte Notiz.‡그늘숲에 있는 순찰대원 바커스에게 봉인된 쪽지를 가져가야 합니다.‡Entrega la nota lacrada al vigía Backus en el Bosque del Ocaso.‡Entrega la nota lacrada al vigía Backus en el Bosque del Ocaso.‡Donner la Note scellée au Gardien Backus, dans le bois de la Pénombre.‡将密信带给暮色森林的守夜人巴库斯。‡將密函帶給暮色森林的守夜人巴庫斯。',
  }
},
[1244] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Encontre a Súmula Défias e entregue-a ao Vigia Backor na Floresta do Crepúsculo.‡Найдите декларацию Братства Справедливости и верните ее дозорному Бакусу в Сумеречном лесу.‡Sucht die Liste der Defias und kehrt zu Behüter Backus im Dämmerwald zurück.‡데피아즈단의 일정표를 찾아 그늘숲에 있는 순찰대원 바커스에게 가져가야 합니다.‡Encuentra el certificado Defias y llévaselo al vigía Backus en el Bosque del Ocaso.‡Encuentra el certificado Defias y llévaselo al vigía Backus en el Bosque del Ocaso.‡Trouvez le Registre des Défias et rapportez-le au Gardien Backus, dans le Bois de la Pénombre.‡找到迪菲亚记事本，把它带回给暮色森林的守夜人巴库斯。‡找到迪菲亞記事本，把它帶回來給暮色森林的守夜人巴庫斯。',
  }
},
[1245] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Leve a Súmula Défias para Elling Trias em Ventobravo.‡Отнесите декларацию Братства Справедливости Иллингу Триасу в Штормград.‡Bringt die Liste der Defias zu Elling Trias in Sturmwind.‡스톰윈드에 있는 엘링 트리아스에게 데피아즈단의 일정표를 가져가야 합니다.‡Lleva el certificado Defias a Elling Trias en Ventormenta.‡Lleva el certificado Defias a Elling Trias en Ventormenta.‡Apportez le Registre des Défias à Elling Trias à Hurlevent.‡将迪菲亚记事本带给暴风城的埃林·提亚斯。‡將迪菲亞記事本帶給暴風城的伊林·提亞斯。',
  }
},
[1246] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Fale com Dashel Punhopétreo em Ventobravo.‡Поговорите с Дашелем Каменным Кулаком в Штормграде.‡Sprecht mit Dashel Steinfaust in Sturmwind.‡스톰윈드에 있는 다셸 스톤피스트와 대화해야 합니다.‡Habla con Dashel Puñopiedra en Ventormenta.‡Habla con Dashel Puñopiedra en Ventormenta.‡Parler à Dashel Poing-de-pierre à Hurlevent.‡与暴风城旧城区里的达舍尔·石拳谈一谈。‡與暴風城舊城區裡的達舍爾·石拳談話。',
  }
},
[1247] = {
