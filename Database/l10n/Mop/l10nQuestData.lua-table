[31887] = {
  {
    'Adestradores de Batalha: Kalimdor‡Наставники боевых питомцев: Калимдор‡Kampfhaustiertrainer: Kalimdor‡전투 애완동물 전문가: 칼림도어‡Instructores de mascotas de duelo: Kalimdor‡‡Maître des mascottes de combat : Kalimdor‡‡',
    nil,
    'Derrote Estêvão Lisbane numa batalha de mascotes. Uma‡Победите Стивена Лисбена в битве питомцев. это‡Besiegt Steven Lisbane in einem Haustierkampf.‡애완동물 대전에서 스티븐 리스베인을 꺾어야 합니다. 레벨 5‡Derrota a Steven Lisbane en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Steven Lisbane.‡‡',
  }
},
[31888] = {
  {
    'Adestradores de Batalha: Kalimdor‡Наставники боевых питомцев: Калимдор‡Kampfhaustiertrainer: Kalimdor‡‡Instructores de mascotas de duelo: Kalimdor‡‡Maître des mascottes de combat : Kalimdor‡‡',
    nil,
    'Derrote Estêvão Lisbane numa batalha de mascotes. Uma‡Победите Стивена Лисбена в битве питомцев. это‡Besiegt Steven Lisbane in einem Haustierkampf.‡‡Derrota a Steven Lisbane en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Steven Lisbane.‡‡',
