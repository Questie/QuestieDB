[78136] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de Guerreiro em Ventobravo.‡Встретьтесь с наставником воинов в Штормграде.‡Besucht einen Trainer in Sturmwind, der Euch als Krieger ausbilden kann.‡스톰윈드에서 전사 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase guerrero en Ventormenta.‡‡Trouvez un maître pour Guerrier à Hurlevent.‡在暴风城与一名圣骑士训练师会面。‡在暴風城內找到戰士訓練師。',
  }
},
[78137] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de Guerreiro em Orgrimmar.‡Встретьтесь с наставником воинов в Оргриммаре.‡Besucht einen Trainer in Orgrimmar, der Euch als Krieger ausbilden kann.‡오그리마에서 전사 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase guerrero en Orgrimmar.‡‡Allez voir un maître pour Guerrier à Orgrimmar.‡在奥格瑞玛与一名法师训练师会面。‡在奧格瑪內找到戰士訓練師。',
  }
},
[78138] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de Guerreiro no Penhasco do Trovão.‡Встретьтесь с наставником воинов в Громовом Утесе.‡Besucht einen Trainer in Donnerfels, der Euch als Krieger ausbilden kann.‡썬더 블러프에서 전사 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase guerrero en Cima del Trueno.‡‡Allez voir un maître pour Guerrier aux Pitons-du-Tonnerre.‡在雷霆崖与一名圣骑士训练师会面。‡在雷霆崖內找到戰士訓練師。',
  }
},
[78140] = {
  {
    'Ferramentas de sobrevivência‡Инструменты для выживания‡Das Zeug zum Überleben‡생존을 위한 도구‡Herramientas de supervivencia‡Herramientas para la supervivencia‡Les outils de la survie‡生存工具‡生存工具',
    nil,
    'Abra o kit de sobrevivência e equipe uma arma.‡Откройте набор для выживания и вооружитесь.‡Öffnet das Überlebenspaket und legt eine Waffe an.‡구호 물자를 열어 무기를 장착해야 합니다.‡Abre el material de supervivencia y equípate con un arma.‡Abre el equipo de supervivencia y equipa un arma.‡Ouvrez le kit de survie et équipez-vous d’une arme.‡打开生存包，装备一把武器。‡打開求生包，裝備其中的武器。',
  }
},
[78151] = {
  {
    'Ferramentas de sobrevivência‡Инструменты для выживания‡Das Zeug zum Überleben‡생존을 위한 도구‡Herramientas de supervivencia‡Herramientas para la supervivencia‡Les outils de la survie‡生存工具‡生存工具',
