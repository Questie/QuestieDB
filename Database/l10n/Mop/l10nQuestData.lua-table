},
[13034] = {
  {
    'A testemunha e o herói‡Наблюдатель и герой‡Der Zeuge und der Held‡목격자와 영웅‡El héroe y el testigo‡El héroe y el testigo‡Le témoin et le héros‡见证者与英雄‡英雄與他的見證',
    nil,
    'Xarantauro, na Aldeia Tunka\'lo, quer que você leia o Primeiro Pergaminho de História, o Segundo Pergaminho de História e o Terceiro Pergaminho de História.‡По просьбе Ксанатавра из лагеря Тунка\'ло прочитайте Первый, Второй и Третий свитки.‡Xarantaur im Camp Tunka\'lo möchte, dass Ihr Euch die erste, zweite und dritte historische Schriftrolle durchlest.‡툰카로 야영지의 자란타우르가 첫 번째 역사 두루마리, 두 번째 역사 두루마리, 세 번째 역사 두루마리를 읽어 달라고 했습니다.‡Xantaur en el Campamento Tunka\'lo quiere que leas el primer pergamino de Historia, el segundo pergamino de Historia y el tercer pergamino de Historia.‡Xantaur en el Campamento Tunka\'lo quiere que leas el primer pergamino de Historia, el segundo pergamino de Historia y el tercer pergamino de Historia.‡Xarantaur, au Camp Tunka\'lo, veut que vous lisiez le Premier parchemin de l\'histoire, le Second parchemin de l\'histoire et le Troisième parchemin de l\'histoire.‡唐卡洛营地的夏拉托尔希望你去阅读第一份历史卷轴、第二份历史卷轴和第三份历史卷轴。‡坦卡羅的札倫陶要你去閱讀第一部歷史卷軸、第二部歷史卷軸與第三部歷史卷軸。',
  }
},
[13035] = {
  {
    'Lacaios de Loken‡Прислужники Локена‡Lokens Lakaien‡로켄의 하수인들‡Los lacayos de Loken‡Los lacayos de Loken‡Les laquais de Loken‡洛肯的副官‡洛肯的走狗',
    nil,
    'Thorim quer que você mate Eisenfaust no Salão do Criador e Halefnir, o Filho do Vento, e Duronn, o Forjado em Runas, no Terraço dos Criadores.‡Убейте Айзенфауста в Зале Творца, а также Халефнира Дитя Ветра и Даррона Рунокова на Террасе Творцов по просьбе Торима.‡Thorim möchte, dass Ihr Eisenfaust in der Halle des Formers erschlagt. Außerdem sollt Ihr Halefnir den Zischenden und Duronn den Runenbesetzten auf der Terrasse der Schöpfer töten.‡토림이 구체자의 전당에 있는 아이젠파우스트, 창조주의 거처에 있는 바람의 할레프니르와 룬으로 벼려낸 듀론을 처치해 달라고 했습니다.‡Thorim quiere que mates a Eisenfaust, que está en la Sala del Creador, y a Halefnir el Natoviento y a Duronn el Runaforjado en el Bancal de los Creadores.‡Thorim quiere que mates a Eisenfaust, que está en la Sala del Creador, y a Halefnir el Natoviento y a Duronn el Runaforjado en el Bancal de los Creadores.‡Thorim vous demande de tuer Eisenfaust dans le Hall du Façonneur, et Halefnir l\'Enfant du vent et Duronn le Formerune à la Terrasse des Faiseurs.‡托里姆要你杀死塑造者之厅的伊森法斯、造物者圣台的风之哈勒弗尼尔和符文巨人杜洛恩。‡索林姆要你殺掉塑造者大廳裡的伊森弗士德、造物者殿堂裡的『風誕』哈雷孚尼爾、『符文工匠』杜隆恩。',
  }
},
[13036] = {
  {
    'Honra acima de tudo‡Великая миссия‡Ehre über alles‡가장 귀한 명예‡Honor por encima de todo‡Honor por encima de todo‡L\'honneur avant tout‡无上的荣耀‡榮譽至上',
    nil,
    'Apresente-se ao Comandante Cruzado Entari na Vanguarda Argêntea, que fica na Coroa de Gelo.‡Поговорите с командиром рыцарей Энтари в Оплоте Серебряного Авангарда в Ледяной Короне.‡Meldet Euch bei Kreuzzugskommandant Entari in der Argentumvorhut in Eiskrone.‡얼음왕관의 은빛십자군 선봉기지로 가서 십자군 사령관 엔타리에게 보고해야 합니다.‡Preséntate ante el Comandante de Cruzada Entari en La Vanguardia Argenta en Corona de Hielo.‡Preséntate ante el Comandante de Cruzada Entari en La Vanguardia Argenta en Corona de Hielo.‡Présentez-vous au Commandant de la croisade Entari à l\'Avant-garde d\'Argent, dans la Couronne de glace.‡向冰冠冰川银色前线基地的北伐军指挥官恩塔里报到。‡向銀白先鋒駐地的十字軍指揮官恩塔利報到。',
  }
},
[13037] = {
  {
    'As memórias de Casco Feroz‡Воспоминания о Штормовом Копыте‡Erinnerungen an Sturmhuf‡스톰후프의 기억‡Recuerdos de Pezuña Tempestuosa‡Recuerdos de Pezuña Tempestuosa‡Souvenirs de Sabot-tempête‡雷蹄的记忆‡風暴之蹄的回憶',
    nil,
    'Fale com o Chefe Lança Veloz na Caverna Flotagelo e fale novamente com Xarantauro na Aldeia Tunka\'lo.‡Поговорите с вождем Быстрое Копье в Ледяных Глубинах и возвращайтесь к Ксанатавру в лагерь Тунка\'ло.‡Sprecht mit Häuptling Schnellspeer in der Frostschollentiefe und kehrt dann zu Xarantaur ins Camp Tunka\'lo zurück.‡거대한 유빙에서 족장 스위프트스피어와 대화한 뒤 툰카로 야영지에 있는 자란타우르에게 가야 합니다.‡Habla con el cabecilla Lanza Presta en la Hondonada Témpano Gélido y después regresa junto a Xarantaur en el Campamento Tunka\'lo.‡Habla con el cabecilla Lanza Presta en la Hondonada Témpano Gélido y después regresa junto a Xarantaur en el Campamento Tunka\'lo.‡Parlez au Chef Vivelance au Gouffre du Sérac, puis retournez voir Xarantaur au Camp Tunka\'lo.‡与浮冰深渊的迅矛酋长谈一谈，然后返回唐卡洛营地，向夏拉托尔复命。‡與浮冰霜淵的迅矛酋長交談，然後回去找坦卡羅營地的札倫陶。',
  }
},
[13038] = {
  {
    'Distorções no tempo‡Искажения времени‡Verzerrungen in der Zeit‡뒤틀린 시간‡Distorsiones temporales‡Distorsiones temporales‡Distortions temporelles‡时间的扰动‡扭曲時間',
    nil,
    'Use o Totem do Chefe para fechar 4 Fendas de Flotagelo e leve o totem a Xarantauro na Aldeia Tunka\'lo.‡Закройте 4 расселины в Ледяных глубинах с помощью тотема вождя, а затем отправляйтесь в лагерь Тунка\'ло и отдайте тотем Ксанатавру.‡Nutzt das Totem des Häuptlings, um 4 Frostschollenklüfte zu schließen, und bringt es danach zu Xarantaur ins Camp Tunka\'lo.‡족장의 토템을 사용하여 유빙의 균열 4개를 막은 다음, 그 토템을 툰카로 야영지의 자란타우르에게 가져가야 합니다.‡Usa el tótem del cabecilla para cerrar 4 fallas Témpano Gélido, después lleva el tótem a Xarantaur en el Campamento Tunka\'lo.‡Usa el tótem del cabecilla para cerrar 4 fallas Témpano Gélido, después lleva el tótem a Xarantaur en el Campamento Tunka\'lo.‡Utilisez le Totem du chef pour fermer 4 Failles du Sérac, puis rapportez le Totem à Xarantaur au Camp Tunka\'lo.‡使用酋长的图腾封闭4道浮冰裂隙，然后将图腾还给唐卡洛营地的夏拉托尔。‡以酋長的圖騰使四個浮冰裂隙合攏，然後，將圖騰帶給坦卡羅營地的札倫陶。',
  }
},
[13039] = {
  {
    'Defendendo a Vanguarda‡Оборона аванпоста‡Die Vorhut verteidigen‡십자군 방어‡Defender la Vanguardia‡Defender la Vanguardia‡Défendre l\'avant-garde‡保卫前线基地‡防守先鋒駐地',
    nil,
    'O Lorde Cruzado Dalfors, na Vanguarda Argêntea, que fica na Coroa de Gelo, quer que você mate 15 Nerubianos das Profundezas Abandonadas.‡Убейте 15 нерубов Забытых глубин по просьбе лорда Далфорса из Оплота Серебряного Авангарда в Ледяной Короне.‡Kreuzfahrerlord Dalfors von der Argentumvorhut in Eiskrone hat Euch gebeten, 15 Neruber der Vergessenen Tiefen zu töten.‡얼음왕관의 은빛십자군 선봉기지에 있는 십자군 군주 달포르스가 망각의 심연 네루비안 15명을 처치해 달라고 했습니다.‡El señor cruzado Dalfors en La Vanguardia Argenta en Corona de Hielo te ha pedido que mates a 15 nerubianos de Las Profundidades Olvidadas.‡El señor cruzado Dalfors en La Vanguardia Argenta en Corona de Hielo te ha pedido que mates a 15 nerubianos de Las Profundidades Olvidadas.‡Le Seigneur croisé Dalfors, à l\'Avant-garde d\'Argent dans la Couronne de glace, vous a demandé de tuer 15 Nérubiens des profondeurs oubliées.‡冰冠冰川银色前线基地的北伐军领主达尔弗斯要求你杀死15只遗忘深渊蛛魔。‡在寒冰皇冠之銀白先鋒駐地的十字軍領主達佛斯要求你殺掉15個遺忘深淵奈幽蟲族。',
  }
},
[13040] = {
  {
    'Curar o incurável‡Исцеление неисцелимого‡Heilmittel für das Unheilbare‡불치병 치료‡Curar lo incurable‡Curar lo incurable‡Soigner l\'insoignable‡致命的剧毒‡死馬當活馬醫',
    nil,
    'O Padre Gustav, da Vanguarda Argêntea, na Coroa de Gelo, quer que você colete 10 Vesículas de Peçonha das Profundezas Abandonadas.‡Принесите 10 ядовитых желез душителей Забытых глубин отцу Густаву в Оплот Серебряного Авангарда в Ледяной Короне.‡Vater Gustav aus der Argentumvorhut in Eiskrone bittet Euch, ihm 10 Giftdrüsen der Vergessenen Tiefen zu bringen.‡얼음왕관의 은빛십자군 선봉기지에 있는 신부 구스타프가 망각의 심연 독주머니 10개를 구해달라고 했습니다.‡El padre Gustav de La Vanguardia Argenta en Corona de Hielo te ha pedido que le lleves 10 glándulas de veneno de Las Profundidades Olvidadas.‡El padre Gustav de La Vanguardia Argenta en Corona de Hielo te ha pedido que le lleves 10 glándulas de veneno de Las Profundidades Olvidadas.‡Le Père Gustav, à l\'Avant-garde d\'Argent dans la Couronne de glace, vous a demandé de lui apporter 10 Glandes à venin des profondeurs oubliées.‡冰冠冰川银色前线基地的古斯塔夫神父要求你交给他10个遗忘深渊毒囊。‡寒冰皇冠中，銀白先鋒駐地的賈斯塔夫神父，要求你帶回10個遺忘深淵毒囊。',
  }
},
[13041] = {
  {
    'Toque final na encomenda‡Недостающий камень‡Die Lieferung abfertigen‡배달 완료‡Acabar el envío‡Acabar el envío‡Terminer la livraison‡完成订单‡使命必達',
    nil,
    'Entregue uma calcedônia para Falcão Joiado em Dalaran.‡Принесите кусок кальцедония Тимоти Джонсу в Даларан.‡Bringt einen Chalzedon zu Jonas Timotheus in Dalaran.‡달라란에 있는 티모시 존스에게 옥수를 가져가야 합니다.‡Llévale una calcedonia a Timothy Jones en Dalaran.‡Llévale una calcedonia a Timothy Jones en Dalaran.‡Apportez une Calcédoine à Timothy Jones à Dalaran.‡将一颗玉髓石交给达拉然的提莫斯·琼斯。‡把一個玉髓交給達拉然的提摩西·瓊斯。',
  }
},
[13042] = {
  {
    'Nas entranhas dos salões subterrâneos‡В недрах Глубинных чертогов‡Tief im Inneren des Kellergewölbes‡지하 전당 속 깊숙이‡En las profundidades de las Cámaras Subterráneas‡En las profundidades de las Cámaras Subterráneas‡Dans les profondeurs des Basses-salles‡地下大厅的深处‡深入地下大廳',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você arranque informações à força do Aprendiz Osterkilgr a respeito do que o Dr. Terrível está armando.|n|nEm seguida, mate o aprendiz.‡По поручению костяной ведьмы из деревни Ньорндар выбейте информацию из ученика Остеркилгра: узнайте, где находится доктор Ужас.|n|nПотом убейте ученика.‡Die Knochenhexe aus Njorndar bittet Euch, Informationen bezüglich der Pläne von Dr. Maböse aus Lehrling Osterkilgr herauszuprügeln.|n|nTötet den Lehrling anschließend.‡요른다르 마을에 있는 해골 마녀가 수습생 오스터킬그르에게서 미치광이 박사가 매달려 있는 일이 무엇인지 정보를 알아낸 다음, 처치해 달라고 했습니다.‡La Bruja Osaria en la cueva del poblado Njorndar te ha pedido que saques a golpes del aprendiz Osterkilgr información referente a los planes del Dr. Terrible.|n|nDespués debes matar al aprendiz.‡La Bruja Osaria en la cueva del poblado Njorndar te ha pedido que saques a golpes del aprendiz Osterkilgr información referente a los planes del Dr. Terrible.|n|nDespués debes matar al aprendiz.‡La Sorcière des ossements à Njorndar vous a demandé de battre l\'Apprenti Osterkilgr afin d\'obtenir des informations concernant ce que prépare le Dr Terrible.|n|nVous devez ensuite tuer l\'Apprenti.‡约尔达村的白骨女巫要你调查学徒奥斯特基格，弄清楚恐怖博士的计划。|n|n事成之后，击败学徒奥斯特基格，并回来向女巫汇报。‡尼約達村的骸骨女巫要你拷問學徒歐斯特基爾格，問出有關恐怖博士所從事工作的情報。|n|n然後殺人滅口。',
  }
},
[13043] = {
  {
    'A soma das partes altera o produto‡Когда сумма больше слагаемых‡Das Ganze ist größer als die Summe seiner Teile‡뭉치면 세진다‡La suma es mayor que las partes‡La suma es mayor que las partes‡Le tout est plus grand que la somme des parties‡一加一大于二‡聚沙成塔',
    nil,
    'Monte em Nergeld, assumindo o controle sobre ele. Defenda-o dos habitantes do Salão dos Horrores até que o Dr. Terrível apareça.|n|nUse Nergeld para matar o doutor e, em seguida, fale novamente com a Bruxa dos Ossos, na Vila Njorndar.‡Заберитесь в Нергельда и возьмите над ним контроль. Защищайте его от обитателей Зала Ужасов, пока не покажется доктор Ужас.|n|nИспользуйте Нергельда, чтобы убить доктора, а потом возвращайтесь в деревню Ньорндар, в пещеру к костяной ведьме.‡Besteigt Nergeld und übernehmt die Kontrolle. Verteidigt ihn vor den Bewohnern der Hallen des Grauens, bis sich Dr. Maböse zeigt.|n|nNutzt Nergeld, um den Doktor zu vernichten, und kehrt dann zur Knochenhexe nach Njorndar zurück.‡미치광이 박사가 모습을 드러낼 때까지 네르겔드에 올라 조종하면서 공포의 전당 시민의 공격을 방어해야 합니다.|n|n네르겔드를 사용하여 박사를 처치하고 요른다르 마을에 있는 해골 마녀에게 돌아 오십시오.‡Monta y controla a Nergeld. Defiéndelo de los moradores de la Cámara de los Horrores hasta que el Dr. Terrible aparezca.|n|nUsa a Nergeld para matar al doctor y después habla con la Bruja Osaria en el poblado Njorndar.‡Monta y controla a Nergeld. Defiéndelo de los moradores de la Cámara de los Horrores hasta que el Dr. Terrible aparezca.|n|nUsa a Nergeld para matar al doctor y después habla con la Bruja Osaria en el poblado Njorndar.‡Montez Nergeld et prenez-en le contrôle. Défendez-le contre les habitants de la Salle des Horreurs jusqu\'à ce que le Dr Terrible se montre.|n|nUtilisez Nergeld pour tuer le docteur, puis retournez voir la Sorcière des ossements à Njorndar.‡登上尼尔盖德并控制它。抵御来自恐惧大厅的居民的攻击，直到恐怖博士现身。|n|n操纵尼尔盖德杀死恐怖博士，然后返回约尔达村，向白骨女巫复命。‡乘上奈傑德並控制它。擊退地下大廳的居民，直到恐怖博士現身。|n|n用奈傑德殺死博士，然後回去找尼約達村的骸骨女巫。',
  }
},
[13044] = {
  {
    'Se houver sobreviventes...‡Пропавшие без вести‡Falls es Überlebende gibt...‡생존자가 있다면...‡Si hay supervivientes...‡Si hay supervivientes...‡S\'il reste des survivants...‡如果还有幸存者……‡如果有生還者...',
    nil,
    'Fale com Penumbrius na Vanguarda Argêntea, que fica na Coroa de Gelo.‡Поговорите с Пенумбриусом в Оплоте Серебряного Авангарда в Ледяной Короне.‡Sprecht mit Penumbrius in der Argentumvorhut in Eiskrone.‡얼음왕관의 은빛십자군 선봉기지에서 페넘브리우스와 대화해야 합니다.‡Habla con Penumbrius en La Vanguardia Argenta de Corona de Hielo.‡Habla con Penumbrius en La Vanguardia Argenta de Corona de Hielo.‡Parlez à Penumbrius à l\'Avant-garde d\'Argent dans la Couronne de glace.‡与冰冠冰川银色前线基地的本诺比奥斯谈一谈。‡和潘農布理斯對話，他在寒冰皇冠的銀白先鋒駐地。',
  }
},
[13045] = {
  {
    'Em direção à devastação verdejante‡В чащобу‡Ins wilde Grün‡푸르른 창공 저편으로‡Dentro del gran verdor‡Dentro del gran verdor‡Ça va tanguer dans la verdure !‡空中救兵‡駭速快手',
    nil,
    'Resgate 3 Cruzados Argênteos Capturados no Forte do Flagelo e leve-os para a Enfermaria da Vanguarda, no meio da Vanguarda Argêntea. Apresente-se ao Grão-lorde Tirion Fordring após cumprir a missão.‡Вытащите из Плетхольма 3 плененных рыцарей Серебряного Авангарда и доставьте их в лазарет в центре Оплота Серебряного Авангарда. После этого поговорите с верховным лордом Тирионом Фордрингом.‡Rettet 3 gefangene Argentumkreuzfahrer aus Geißelholme und bringt sie ins Feldlazarett im Zentrum des Argentumvorpostens. Berichtet Hochlord Tirion Fordring danach von Eurem Erfolg.‡스컬지홀름에서 은빛십자군 포로 3명을 구해내어 은빛십자군 선봉기지 중앙에 있는 선봉기지 치료소로 수송해야 합니다. 임무를 성공적으로 마친 다음, 대영주 티리온 폴드링에게 보고하십시오.‡Rescata a 3 Cruzados Argenta capturados de la Ciudad de la Plaga y llévalos a la Enfermería de la Vanguardia en el centro de La Vanguardia Argenta. Si tienes éxito informa al alto señor Tirion Vadín.‡Rescata a 3 Cruzados Argenta capturados de la Ciudad de la Plaga y llévalos a la Enfermería de la Vanguardia en el centro de La Vanguardia Argenta. Si tienes éxito informa al alto señor Tirion Vadín.‡Sauvez 3 Croisés d\'argent capturés à Fléaulme et amenez-les à l\'Infirmerie de l\'avant-garde au centre de l\'Avant-garde d\'Argent. Allez voir le Généralissime Tirion Fordring si vous réussissez.‡从天灾城营救3名被俘虏的银色北伐军士兵，把他们送往银色前线基地中心的医护所。完成任务之后，向大领主提里奥·弗丁复命。‡在天譴岸地救出3個被俘虜的銀白十字軍，將他們安置在先鋒駐地中心的先鋒醫護站。並向大領主提里奧·弗丁呈報你的捷報。',
  }
},
[13046] = {
  {
    'Alimentando Arngrim‡Муки Арнгрима‡Arngrim füttern‡아른그림 먹이기‡Alimentar a Arngrim‡Alimentar a Arngrim‡Caler la dent creuse d\'Arngrim‡喂饱安格里姆‡餵食安格林',
    nil,
    'Alimente Arngrim com 5 Yormungares Desencarnados e volte à imagem congelada de Arngrim em Dun Niffelem.|n|nVá ao Vale dos Antigos Invernos e use o Dente de Arngrim nos Yormungares Errantes. Uma vez que eles tenham se tornado desencarnados, você deverá lutar com eles até que estejam enfraquecidos.‡Вы должны накормить Арнгрима пятью бесплотными йормунгарами и вернуться к замерзшему изображению Арнгрима в Дун Ниффелем.|n|nИдите в долину Древних Зим и воспользуйтесь зубом Арнгрима, чтобы воздействовать на блуждающих йормунгаров. Когда они развоплотятся, сражайтесь с ними, пока они не ослабнут.‡Ihr sollt 5 körperlose Jormungar an Arngrim verfüttern und dann zu Arngrims gefrorenem Abbild in Dun Niffelem zurückkehren.|n|nIhr müsst ins Uralte Wintertal gehen und Arngrims Zahn auf die dort herumstreunenden Jormungar anwenden. Sobald sie eine körperlose Form angenommen haben, müsst Ihr sie bekämpfen, bis sie geschwächt sind.‡실체 없는 요르문가르 5마리를 아른그림에게 먹인 후, 던 니펠렘에 있는 아른그림의 얼어붙은 환영에 가야 합니다.|n|n고대의 겨울 계곡으로 가서 아른그림의 이빨을 그곳에 있는 떠도는 요르문가르에게 사용하십시오. 요르문가르의 육체가 분리되면, 그들이 약해질 때까지 싸워야 합니다.‡Debes alimentar a Arngrim con 5 jormungar incorpóreos. Después, vuelve con la imagen congelada de Arngrim en Dun Niffelem.|n|nDebes ir al Valle de los Viejos Inviernos y usar el diente de Arngrim con los jormungar vagabundos que hay allí. Una vez que sean incorpóreos, deberás luchar contra ellos hasta que queden debilitados.‡Debes alimentar a Arngrim con 5 jormungar incorpóreos. Después, vuelve con la imagen congelada de Arngrim en Dun Niffelem.|n|nDebes ir al Valle de los Viejos Inviernos y usar el diente de Arngrim con los jormungar vagabundos que hay allí. Una vez que sean incorpóreos, deberás luchar contra ellos hasta que queden debilitados.‡Vous devez donner à manger à Arngrim 5 Jormungars désincarnés puis retourner auprès de l\'image gelée d\'Arngrim à Dun Niffelem.|n|nRendez-vous dans la Vallée des Anciens hivers et utilisez la Dent d\'Arngrim sur les Jormungars mobiles qui s\'y trouvent. Une fois qu\'ils sont désincarnés, vous devez les combattre jusqu\'à ce qu\'ils soient affaiblis.‡让安格里姆吞食5条灵体冰虫，然后返回丹尼芬雷，向安格里姆的冰冻躯体复命。|n|n你必须前往上古寒冬山谷，对游荡的冰虫使用安格里姆之牙。一旦它们脱离肉体，就与灵体形态的冰虫进行战斗，直到它们变得虚弱。‡你要拿5隻虛實的蟄猛巨蟲餵食安格林，然後回到丹尼弗蘭的安格林的冰凍之影前。|n|n你必須前往遠古寒冬山谷，並以安格林之牙對付遊蕩的蟄猛巨蟲。一旦牠們變得虛實不定，你得和牠們戰鬥，直到牠們被削弱為止。',
  }
},
[13047] = {
  {
    'O Juízo‡Расплата‡Die Abrechnung‡응보의 현장‡La venganza‡La venganza‡La rétribution‡清算之战‡清算',
    nil,
    'Encontre Thorim perto do Templo da Sabedoria. Informe o resultado da luta ao Rei Iokkum em Dun Niffelem.‡Встретьтесь с Торимом у храма Мудрости. Потом отправляйтесь к Йоккуму в Дун Ниффелем и расскажите ему об исходе сражения.‡Trefft Euch mit Thorim in der Nähe des Tempels der Weisheit. Berichtet König Jokkum in Dun Niffelem, wie der Kampf ausgegangen ist.‡지혜의 신전 근처에서 토림을 만나십시오. 전투가 끝난 후 그 결과를 던 니펠렘에 있는 제왕 요쿰에게 보고해야 합니다.‡Reúnete con Thorim cerca del Templo de Sabiduría. Informa del resultado del combate al rey Jokkum en Dun Niffelem.‡Reúnete con Thorim cerca del Templo de Sabiduría. Informa del resultado del combate al rey Jokkum en Dun Niffelem.‡Rencontrez Thorim près du Temple de la Sagesse. Racontez l\'issue du combat au Roi Jokkum à Dun Niffelem.‡前往智慧神殿附近与托里姆碰面。然后向丹尼芬雷的约库姆国王汇报战斗的结果。‡在智慧神殿附近和索林姆碰面。向丹尼弗蘭的裘庫姆報告戰鬥的結果。',
  }
},
[13048] = {
  {
    'Onde o tempo se extraviou‡Откуда время пошло не туда‡Wo die Zeit aus dem Ruder lief‡뒤틀린 시간의 근원지‡Cuando el tiempo se volvió loco‡Cuando el tiempo se volvió loco‡Lorsque le temps tourne court‡错误的时间流‡時間錯置',
    nil,
    'Use o Martelo da História nos Artefatos Taunka para sintonizá-lo para o tempo do Casco Feroz. Depois de sintonizá-lo com 6 relíquias do tempo do Casco Feroz, fale novamente com Xarantauro na Aldeia Tunka\'lo.‡Разыщите реликвии таунка и настройте Молот Знаний на истинное время Штормового Копыта. Когда он настроится на 6 реликвий из времени Штормового Копыта, возвращайтесь к Ксанатавру в лагерь Тунка\'ло.‡Setzt den Lehrenhammer bei den Taunka-Relikten ein, um ihn an Sturmhufs Zeit anzupassen. Kehrt zu Xarantaur nach Camp Tunka\'lo zurück, wenn er auf 6 Relikte aus Sturmhufs Zeit eingestimmt wurde.‡가르침의 망치를 타운카 유물에 사용하여 스톰후프의 시대에 맞추어야 합니다. 가르침의 망치가 스톰후프 시대의 유물 6개와 조율을 끝마치면 툰카로 야영지에 있는 자란타우르에게 가야 합니다.‡Usa el Martillo del Conocimiento con las reliquias Taunka para armonizarlo con la época de Pezuña Tormentosa. Una vez haya sido armonizado con 6 reliquias de la época de Pezuña Tormentosa, habla con Xarantaur en el Campamento Tunka\'lo.‡Usa el Martillo del Conocimiento con las reliquias Taunka para armonizarlo con la época de Pezuña Tormentosa. Una vez haya sido armonizado con 6 reliquias de la época de Pezuña Tormentosa, habla con Xarantaur en el Campamento Tunka\'lo.‡Utilisez le Marteau de la connaissance sur les Reliques taunkas pour le mettre en phase avec l\'époque de Sabot-tempête. Une fois que vous l\'aurez mis en phase avec 6 Reliques de l\'époque de Sabot-tempête, retournez voir Xarantaur au Camp Tunka\'lo.‡对牦牛人的圣物使用知识之锤，让它与雷蹄生活的时间流实现同调。等它与6件雷蹄时代的圣物完成同调之后，回去向唐卡洛营地的夏拉托尔复命。‡利用坦卡遺蹟上的博識之錘，將時間調和至風暴之蹄的時代。當博識之錘與6個當時的遺蹟有所共鳴，便將它還給坦卡羅營地的札倫陶。',
  }
},
[13049] = {
  {
    'As armas do herói‡Доспехи героя‡Die Waffen des Helden‡영웅의 무기‡Las armas del héroe‡Las armas del héroe‡Les armes du héros‡英雄的装备‡英雄的武器',
    nil,
    'Reaveja a Lança e a Cota de Malha de Casco Feroz e devolva-os a Xarantauro na Aldeia Tunka\'lo.‡Добудьте копье и кольчугу Штормового Копыта и верните их Ксанатавру в лагерь Тунка\'ло.‡Findet Sturmhufs Rüstung und Speer und bringt die Gegenstände zu Xarantaur in Camp Tunka\'lo zurück.‡스톰후프의 창과 스톰후프의 갑옷을 되찾아 툰카로 야영지의 자란타우르에게 가져가야 합니다.‡Recupera la lanza de Pezuña Tempestuosa y la malla de Pezuña Tempestuosa y vuelve con ellas ante Xarantaur, en el Campamento Tunka\'lo.‡Recupera la lanza de Pezuña Tempestuosa y la malla de Pezuña Tempestuosa y vuelve con ellas ante Xarantaur, en el Campamento Tunka\'lo.‡Retrouvez la Lance de Sabot-tempête et la Cotte de maille de Sabot-tempête, et rapportez-les à Xarantaur au Camp Tunka\'lo.‡将雷蹄的长矛和雷蹄的锁甲交给唐卡洛营地的夏拉托尔。‡將風暴之蹄的長矛及鎖甲恢復原狀，並將它們帶回給坦卡羅營地的札倫陶。',
  }
},
[13050] = {
  {
    'Veranes‡Веранус‡Veranus‡베라누스‡Veranus‡Veranus‡Veranus‡维拉努斯‡維拉努斯',
    nil,
    'Thorim, no Templo das Tempestades, quer que você consiga 5 Ovos Pequenos de Protodracos dos picos perto da Aldeia Brunnhildar.‡Раздобудьте 5 маленьких яиц протодракона в горах рядом с деревней Бруннхильдар и принесите их Ториму в Храм Штормов.‡Thorim aus dem Tempel der Stürme möchte, dass Ihr ihm 5 kleine Eier von den Protodrachen bringt, die auf den Gipfeln in der Umgebung von Brunnhildar hausen.‡폭풍의 신전에 있는 토림이 브룬힐다르 마을 근처에 있는 봉우리에서 작은 원시비룡 알 5개를 가져다 달라고 했습니다.‡Thorim, en el Altar de la Tempestad, quiere que consigas 5 huevos de protodraco pequeños de los picos cerca del Poblado Brunnhildar.‡Thorim, en el Altar de la Tempestad, quiere que consigas 5 huevos de protodraco pequeños de los picos cerca del Poblado Brunnhildar.‡Thorim, au Temple des tempêtes, veut que vous obteniez 5 Petits œufs de proto-drake sur les pics proches de Brunnhildar.‡风暴神殿的托里姆要你从布伦希尔达村附近的峭壁上取回5枚小型始祖龙卵。‡風暴神殿的索林姆要你從布倫希爾達村附近的山巔帶回5顆小元龍蛋。',
  }
},
[13051] = {
  {
    'Invasão de território‡Нарушение границ‡Territoriale Vergehen‡영역 침범‡Violación territorial‡Violación territorial‡Violation de territoire‡侵犯领土‡非法入境',
    nil,
    'Ponha os Ovos Roubados de Protodraco no Ninho da Prolemadre e fale novamente com Thorim no Templo das Tempestades.‡Отнесите похищенные яйца протодракона в гнездо праматери и возвращайтесь к Ториму в Храм Штормов.‡Legt die gestohlenen Protodracheneier in das Nest der Brutmutter und kehrt dann zu Thorim in den Tempel der Stürme zurück.‡여왕 둥지 꼭대기에 가서 훔친 원시용 알을 놓은 후, 폭풍의 신전에 있는 토림에게 가야 합니다.‡Coloca los huevos de protodraco robados en lo alto del nido de la madre de linaje y vuelve al Templo de las Tormentas para hablar con Thorim.‡Coloca los huevos de protodraco robados en lo alto del nido de la madre de linaje y vuelve al Templo de las Tormentas para hablar con Thorim.‡Placez les Œufs de proto-dragon volés au sommet du Nid de la mère des couvées, puis retournez voir Thorim au Temple des tempêtes.‡将偷来的始祖龙卵放置在母龙之巢的顶部，然后返回风暴神殿向托里姆复命。‡將偷來的元龍蛋放在育母之巢的頂部，然後返回風暴神殿，與索林姆會面。',
  }
},
[13052] = {
  {
    '‡Воздушная разведка‡Luftüberwachung‡공중 정찰‡Reconocimiento aéreo‡Reconocimiento aéreo‡Surveillance aérienne‡空中侦察‡',
    nil,
    '‡Отправляйтесь в Лагерь у озера по просьбе профессора Кальверт и поговорите там с пилотом Виком.‡Professorin Kalvert möchte, dass Ihr den Flug zum Landeplatz am See nehmt und dort mit Pilot Vic sprecht.‡학자 칼버트가 호반의 착륙장으로 가서 조종사 빅과 대화하라고 했습니다.‡La profesora Calvert quiere que cojas el vuelo a la Pista del Lago y que hables con el piloto Vic.‡La profesora Calvert quiere que cojas el vuelo a la Pista del Lago y que hables con el piloto Vic.‡Le Professeur Calvert veut que vous preniez le vol pour le Terrain d\'atterrissage de Rive-du-lac et que vous parliez au Pilote Vic, une fois rendu là-bas.‡卡尔维特教授要你飞往湖边着陆场，与飞行员维克谈一谈。‡',
  }
},
[13053] = {
  {
    '‡В поисках уцелевших‡Suche nach Überlebenden‡생존자 수색‡Buscando supervivientes‡Buscando supervivientes‡À la recherche de survivants‡寻找幸存者‡',
    nil,
    '‡Помогите Заку Шестеркруту совершить испытательный полет.‡Helft Zak Wackelspross, den Testflug zu beenden.‡자크 워블렌치를 도와 시험 비행을 마쳐야 합니다.‡Ayuda a Zac Piñónflojo a completar el vuelo de prueba.‡Ayuda a Zac Piñónflojo a completar el vuelo de prueba.‡Aidez Zak Tremblerouage à réussir le Vol d\'essai.‡帮助扎克·沃布维奇完成试飞。‡',
  }
},
[13054] = {
  {
    'O rastreador desaparecido‡Пропавший следопыт‡Der vermisste Fährtenleser‡사라진 추적자‡El rastreador perdido‡El rastreador perdido‡Le pisteur disparu‡失踪的猎人‡失蹤的追蹤者',
    nil,
    'Procure o Rastreador Val\'zij no Covil de Gimorak, a sudeste do Local da Queda de Grom\'arsh.‡Разыщите следопыта Вал\'зижа в логове Гиморака, на юго-востоке от места крушения Гром\'арша.‡Sucht in Gimoraks Bau östlich der Absturzstelle Grom\'ash nach Fährtenleser Val\'zij.‡그롬아쉬 추락 지점의 남동쪽에 위치한 기모라크의 동굴 안에 있는 추적자 발지즈를 찾아야 합니다.‡Busca al rastreador Val\'zij dentro de la Guarida de Gimorak, al sureste del Lugar del Accidente de Grom\'arsh.‡Busca al rastreador Val\'zij dentro de la Guarida de Gimorak, al sureste del Lugar del Accidente de Grom\'arsh.‡Cherchez le Traqueur Val\'zij dans la tanière de Gimorak, au sud-est du Point d\'impact de Grom\'arsh.‡前往格罗玛什坠毁点东南边的基莫拉克之巢，寻找猎户瓦尔兹。‡在吉摩拉克獸穴內尋找追蹤者瓦爾吉，獸穴的位置，在葛羅姆亞什失事地的東南方。',
  }
},
[13055] = {
  {
    'Remédios da caverna‡Лекарство из пещер‡Höhlenmedizin‡동굴 약제‡Medicina de cueva‡Medicina de cueva‡Remède de caverne‡洞穴中的药品‡洞穴中的解藥',
    nil,
    'O Rastreador Val\'zij, no Covil de Gimorak, quer que você consiga 1 Glândula de Toxina de Yormungar e 8 Cogumelos da Caverna.‡Добудьте 1 ядовитую железу йормунгара и 8 пещерных грибов и доставьте следопыту Вал\'зижу в Логово Гиморака.‡Fährtenleser Val\'zij hält sich in Gimoraks Bau auf und möchte, dass Ihr ihm 1 Giftdrüse der Jormungar und 8 Höhlenpilze bringt.‡기모라크의 동굴에 있는 추적자 발지즈가 요르문가르의 독 분비선 1개와 동굴 버섯 8개를 가져다 달라고 했습니다.‡El rastreador Val\'zij, en la Guarida de Gimorak quiere que obtengas 1 glándula de toxinas de jormungar y 8 hongos de cueva.‡El rastreador Val\'zij, en la Guarida de Gimorak quiere que obtengas 1 glándula de toxinas de jormungar y 8 hongos de cueva.‡Le Traqueur Val\'zij, à la tanière de Gimorak, vous a demandé de récupérer 1 Glande à toxine jormungar et 8 Champignons de la caverne.‡基莫拉克之巢的猎户瓦尔兹希望你去收集1个冰虫毒腺和8只洞穴蘑菇。‡在吉摩拉克獸穴裡的追蹤者瓦爾吉，要求你替他採得1個蟄猛巨蟲的毒素腺體和8個洞穴磨菇。',
  }
},
[13056] = {
  {
    'A vingança é um prato que se come frio‡Всегда найдется время для мести‡Für Rache ist immer Zeit‡복수의 시간‡Siempre hay tiempo para la venganza‡Siempre hay tiempo para la venganza‡La vengeance est un plat qui se mange à toute heure‡有仇必报‡君子復仇，十年不晚',
    nil,
    'O Rastreador Val\'zij quer que você mate Gimorak no Covil de Gimorak.‡Убейте Гиморака в пещере Ледяного Воя по просьбе следопыта Вал\'зижа.‡Fährtenleser Val\'zij möchte, dass Ihr Gimorak in Gimoraks Bau tötet.‡추적자 발지즈가 기모라크의 동굴 안에 있는 기모라크를 처치해 달라고 했습니다.‡El rastreador Val\'zij quiere que mates a Gimorak, que está dentro de la Guarida de Gimorak.‡El rastreador Val\'zij quiere que mates a Gimorak, que está dentro de la Guarida de Gimorak.‡Le Traqueur Val\'zij vous demande de tuer Gimorak dans la Tanière de Gimorak.‡猎户瓦尔兹要求你去杀死基莫拉克之巢里的基莫拉克。‡追蹤者瓦爾吉要你殺死吉摩拉克獸穴裡的吉摩拉克。',
  }
},
[13057] = {
  {
    'O Terraço dos Criadores‡Терраса Творцов‡Die Terrasse der Schöpfer‡창조주의 거처‡El Bancal de los Creadores‡El Bancal de los Creadores‡La terrasse des Faiseurs‡造物者圣台‡造物者殿堂',
    nil,
    'Encontre Thorim no extremo sudeste do Terraço dos Criadores, a noroeste de Dun Niffelem.‡Разыщите Торима на юго-восточном конце Террасы Творцов, к северо-западу от Дун Ниффелема.‡Findet Thorim an der südöstlichen Kante der Terrasse der Schöpfer gleich nordwestlich von Dun Niffelem.‡던 니펠렘의 북서쪽, 창조주의 거처 남동쪽 가장자리에서 토림을 찾아야 합니다.‡Busca a Thorim en el límite sureste del Bancal de los Creadores, al noroeste de Dun Niffelem.‡Busca a Thorim en el límite sureste del Bancal de los Creadores, al noroeste de Dun Niffelem.‡Trouvez Thorim à la limite sud-est de la Terrasse des Faiseurs, au nord-ouest de Dun Niffelem.‡前往丹尼芬雷西北方的造物者圣台，在该区域的东南部边缘寻找托里姆。‡到造物者殿堂的東南邊緣找索林姆，造物者殿堂就在丹尼弗蘭的西北方。',
  }
},
[13058] = {
  {
    'Mudando a direção do vento‡Чтобы ветер переменился‡Die Windrichtung ändern‡바람의 방향을 바꾸다‡Cambiar el curso del viento‡Cambiar el curso del viento‡Changer le sens du vent‡改变风向‡改變風的吹向',
    nil,
    'Use o Martelo da História para voltar no tempo e enfrentar o Vento Norte como Casco Feroz. Quando Casco Feroz tombar e soltar a Trompa da Fúria Elemental, use-a para dar cabo do Vento Norte e fale novamente com Xarantauro na Aldeia Tunka\'lo.‡Используйте Молот Знаний, чтобы вернуться в прошлое и сразиться с Северным Ветром под личиной Штормового Копыта. Когда Штормовое Копыто падет, возьмите рог неистовства стихий и прикончите Северного Ветра, а затем возвращайтесь к Ксанатавру в лагерь Тунка\'ло.‡Reist mithilfe des Lehrenhammers in der Zeit zurück, schlüpft in Sturmhufs Rolle und stellt Euch dem Nordwind. Beschafft Euch das Horn des Elementarfurors, sobald Sturmhuf gestorben ist und es fallen gelassen hat, und benutzt es, um den Nordwind zu erledigen. Kehrt danach zu Xarantaur ins Camp Tunka\'lo zurück.‡가르침의 망치로 시간을 거슬러 올라간 뒤 스톰후프가 되어 북풍과 맞서야 합니다. 스톰후프가 북풍과의 치열한 전투 끝에 힘을 잃고 자연 격노의 뿔피리를 놓치면 그것을 사용하여 북풍을 물리치고, 툰카로 야영지에 있는 자란타우르에게 가야 합니다.‡Usa el Martillo del Conocimiento para viajar atrás en el tiempo y enfréntate al Viento del Norte como si fueras Pezuña Tempestuosa. Cuando Pezuña Tempestuosa caiga y deje caer el Cuerno de Furia Elemental, úsalo para acabar con el Viento del Norte. Después habla con Xarantaur en el Campamento Tunka\'lo.‡Usa el Martillo del Conocimiento para viajar atrás en el tiempo y enfréntate al Viento del Norte como si fueras Pezuña Tempestuosa. Cuando Pezuña Tempestuosa caiga y deje caer el Cuerno de Furia Elemental, úsalo para acabar con el Viento del Norte. Después habla con Xarantaur en el Campamento Tunka\'lo.‡Utilisez le Marteau de la connaissance pour remonter le temps et affronter le Vent du nord sous les traits de Sabot-tempête. Quand Sabot-tempête perd, récupérez le Cor de fureur élémentaire et achevez le Vent du nord, puis retournez voir Xarantaur au Camp Tunka\'lo.‡使用知识之锤回到过去，以雷蹄的身份挑战北风。雷蹄倒下之后会掉落元素愤怒号角，届时你必须使用元素愤怒号角击败北风，然后返回唐卡洛营地，向夏拉托尔复命。‡運用博識之錘回到過去，並以風暴之蹄的身分面對北風精靈。當風暴之蹄落敗時，拾起落下的元素烈怒號角，殺掉北風精靈。然後將其歸還給坦卡羅營地的札倫陶。',
  }
},
[13059] = {
  {
    'Vingança para os Vargul‡Месть за варгулов‡Rache für die Vargul‡바르굴 대신 복수를!‡Venganza para los vargul‡Venganza para los vargul‡Vengeance pour les varguls‡瓦古的复仇‡為瓦苟復仇',
    nil,
    'Bethod Feigr, nos Salões Subterrâneos, quer que você use sua espada para desafiar e matar o Thane Illska, no Círculo dos Sofrimentos.‡Бросьте меч в Круге Страдания, вызовите на бой и убейте тана Иллскара по просьбе Бетода Фейгра из Глубинных чертогов.‡Bethod Feigr im Kellergewölbe wünscht, dass Ihr sein Schwert zu Boden werft, um Than Illskar im Kreis des Leidens herauszufordern und zu töten.‡지하 전당에 있는 베소드 페이그르가 자신의 검을 내던져 영주 일스카르에게 도전한 다음 고통의 투기장에서 그를 처치해 달라고 했습니다.‡En Las Cámaras Subterráneas, Bethod Feigr quiere que tires su espada para desafiar al señor feudal Maleskara y que después lo mates en El Círculo de Sufrimiento.‡En Las Cámaras Subterráneas, Bethod Feigr quiere que tires su espada para desafiar al señor feudal Maleskara y que después lo mates en El Círculo de Sufrimiento.‡Bethod Feigr, aux Basses-salles, vous demande de défier le Thane Illskar en jetant son épée, puis de le tuer au Cercle de Souffrance.‡地下大厅的贝索德·菲格要你扔出他的剑，在受难之环中挑战并杀死伊尔斯卡领主。‡地下大廳的貝索德·費格要你在苦難之環丟下他的劍，挑戰伊爾斯卡族長並且殺死他。',
  }
},
[13060] = {
  {
    'Quando tudo mais falha‡Когда остается единственный выход...‡Wenn alles andere versagt‡모두 포기할 때‡Cuando todo lo demás falla‡Cuando todo lo demás falla‡Quand tout le reste a échoué…‡终极运输方案‡最後一招',
    nil,
    'Fale com Ricket para usar seu Dispositivo Propelido de Entrega D16 e adentrar os Picos Tempestuosos.‡Воспользуйтесь принадлежащим Рикет пропеллерным доставочным аппаратом Д16, чтобы продвинуться вглубь Грозовой Гряды.‡Sprecht mit Ricket, um mithilfe von Rickets D16-angetriebenem Lieferungsgerät tiefer in das Gebiet der Sturmgipfel vorzudringen.‡리켓과 이야기하면, D16 추진 발사 장치를 사용해 폭풍우 봉우리 깊숙이 들어갈 수 있습니다.‡Habla con Ricket para usar el Artefacto de entrega propulsado D16 para profundizar en Las Cumbres Tormentosas.‡Habla con Ricket para usar el Artefacto de entrega propulsado D16 para profundizar en Las Cumbres Tormentosas.‡Parlez à Ricket pour utiliser l\'Engin de livraison à propulsion D16 de Ricket afin de pénétrer au cœur des Pics Foudroyés.‡与莉吉特谈一谈，使用她的D16推进运载器进入风暴峭壁的深处。‡和瑞基特對話，並利用瑞基特的D16傳送推進裝置深入風暴群山。',
  }
},
[13061] = {
  {
    'Prepare-se para a glória‡Победа или смерть‡Bereit für den Ruhm‡영광의 서곡‡Prepárate para la gloria‡Prepárate para la gloria‡Préparation pour la gloire‡为荣耀而战‡為榮耀準備',
    nil,
    'Fale com Lok\'lira, a Velha, na Aldeia Brunnhildar.‡Поговорите с Лок\'лирой Каргой в деревне Бруннхильдар.‡Sprecht mit Lok\'lira der Greisin in Brunnhildar.‡브룬힐다르 마을에 있는 마녀 로크리라와 대화해야 합니다.‡Habla con Lok\'lira la Vieja Bruja en el Poblado Brunnhildar.‡Habla con Lok\'lira la Vieja Bruja en el Poblado Brunnhildar.‡Parlez à Lok\'lira la Mégère à Brunnhildar.‡与布伦希尔达村的女巫洛莉拉谈一谈。‡與布倫希爾達村的『巫婆』洛莉拉交談。',
  }
},
[13062] = {
  {
    'O presente de despedida de Lok\'lira‡Прощальный подарок Лок\'лиры‡Lok\'liras Abschiedsgeschenk‡로크리라의 이별 선물‡El regalo de despedida de Lok\'lira‡El regalo de despedida de Lok\'lira‡Cadeau d\'adieu de Lok\'lira‡洛莉拉的离别赠礼‡洛莉拉的臨別禮物',
    nil,
    'Fale com Gretta, a Árbitra, na Aldeia Brunnhildar.‡Поговорите с Греттой Судьей в деревне Бруннхильдар.‡Sprecht mit Gretta der Schiedsfrau in Brunnhildar.‡브룬힐다르 마을에 있는 중재자 그레타와 대화해야 합니다.‡Habla con Gretta la Mediadora en el Poblado Brunnhildar.‡Habla con Gretta la Mediadora en el Poblado Brunnhildar.‡Parlez à Gretta la Médiatrice à Brunnhildar.‡与布伦希尔达村的仲裁者格蕾塔谈一谈。‡與布倫希爾達村的『仲裁者』格瑞塔交談。',
  }
},
[13063] = {
  {
    'Considerada digna‡Посмотрим, чего ты стоишь‡Für würdig befunden‡가치 증명‡Demostrar el valor‡Demostrar el valor‡Digne de valeur‡证明价值‡野人獻曝',
    nil,
    'Brijana quer que você vá à Aldeia Brunnhildar e fale com Astrid Bjornrittar.‡По просьбе Бриджаны отправляйтесь в деревню Бруннхильдар и поговорите с Астрид Бьорнриттар.‡Brijana möchte, dass Ihr nach Brunnhildar geht und mit Astrid Bjornrittar sprecht.‡브리야나가 브룬힐다르 마을로 돌아가서 아스트리드 비요른리타와 대화하라고 했습니다.‡Brijana quiere que vayas al Poblado Brunnhildar y hables con Astrid Bjornrittar.‡Brijana quiere que vayas al Poblado Brunnhildar y hables con Astrid Bjornrittar.‡Brijana veut que vous alliez à Brunnhildar pour parler avec Astrid Bjornrittar.‡布莉亚娜希望你前往布伦希尔达村，与艾丝崔·约利塔尔谈一谈。‡布瑞嘉娜要你前往布倫希爾達村，並與艾絲翠德·畢優利塔對話。',
  }
},
[13064] = {
  {
    'Rivalidade fraterna‡Соперничество братьев‡Rivalität unter Geschwistern‡형제의 경쟁‡Rivalidad fraternal‡Rivalidad fraternal‡Rivalité fraternelle‡骨肉相残‡兄弟反目',
    nil,
    'Thorim quer que você ouça sua história.‡Выслушайте историю Торима.‡Thorim möchte, dass Ihr Euch seine Geschichte anhört.‡토림이 그의 이야기를 들어달라고 했습니다.‡Thorim quiere que escuches su historia.‡Thorim quiere que escuches su historia.‡Thorim veut que vous écoutiez son histoire.‡托里姆希望你能倾听他的故事。‡索林姆要你聆聽他的故事。',
  }
},
[13065] = {
  {
    'Ohanzi, o ancião‡Предок Оханзи‡Urahne Ohanzee‡장로 오한지‡Ohanzee el Ancestro‡Ohanzee el Ancestro‡L\'ancien Ohanzee‡长者奥哈齐‡歐漢茲長者',
    nil,
    nil,
  }
},
[13066] = {
  {
    'Yurauk, o ancião‡Предок Яруак‡Urahne Yurauk‡장로 유라우크‡Yurauk el Ancestro‡Yurauk el Ancestro‡L\'ancien Yurauk‡长者尤拉克‡由羅克長者',
    nil,
    nil,
  }
},
[13067] = {
  {
    'Chogan\'gada, o ancião‡Предок Чоган\'гада‡Urahne Chogan\'gada‡장로 초간가다‡Chogan\'gada el Ancestro‡Chogan\'gada el Ancestro‡L\'ancien Chogan\'gada‡长者库甘达加‡修干加達長者',
    nil,
    nil,
  }
},
[13068] = {
  {
    'Uma história de coragem‡Отважный герой‡Eine Erzählung von Heldenmut‡어떤 용사 이야기‡Un relato de valor‡Un relato de valor‡Une histoire de bravoure‡勇气的传说‡英勇的故事',
    nil,
    'O Grão-lorde Tirion Fordring, no Pináculo dos Cruzados, quer que você localize o Cruzado Brindeiro na Vigia Silente, no nordeste da Coroa de Gelo. A melhor forma de encontrá-lo é sobrevoar a área procurando pela fogueira dele.‡Отправляйтесь в северо-восточную часть Ледяной Короны, разыщите героя, рыцаря Бриденбрада, в Молчаливом Бдении и приведите его к верховному лорду Тириону Фордрингу на Вершину Рыцарей. Возле его стоянки обычно горит костер, заметный с воздуха.‡Hochlord Tirion Fordring auf dem Kreuzfahrerturm wünscht, dass Ihr den Helden Kreuzfahrer Bridenbrad in der Stillen Nachtwache im Nordosten der Eiskrone aufspürt. Seine Feuergrube wird aus der Luft gesehen wahrscheinlich der deutlichste Hinweis auf seinen Aufenthaltsort sein.‡십자군 봉우리에 있는 대영주 티리온 폴드링이 얼음왕관 북동쪽에 있는 침묵의 망루에서 영웅인 성전사 브라이든브래드를 찾아달라고 했습니다. 그가 불을 피운 흔적이 공중에서 위치를 파악하는 데 중요한 단서가 될 것 같습니다.‡El alto señor Tirion Vadín en el Pináculo de Cruzados te ha pedido que encuentres al héroe cruzado Bridenbrad en Vigía Silencioso, al noreste de Corona de Hielo. Desde el aire, lo más probable es que su hoguera sea la señal más visible de su posición.‡El alto señor Tirion Vadín en el Pináculo de Cruzados te ha pedido que encuentres al héroe cruzado Bridenbrad en Vigía Silencioso, al noreste de Corona de Hielo. Desde el aire, lo más probable es que su hoguera sea la señal más visible de su posición.‡Le Généralissime Tirion Fordring, à la Cime des Croisés, vous a demandé de trouver un héros, le Croisé Bridenbrad, à la Veille silencieuse, au nord-est de la Couronne de glace. Son feu de camp devrait être le signe le plus évident de sa position depuis les cieux.‡北伐军之峰的大领主提里奥·弗丁要你前往冰冠冰川东北部的沉默墓地，寻找战斗英雄布雷登布莱德的下落。从空中向下看去，他的篝火堆应该是最显眼的指示物。‡十字軍之巔的大領主提里奧·弗丁請你找回他們的英雄，十字軍布理登布萊特，就在寒冰皇冠東北方的靜默警戒。從空中看去，他的火堆應該會是最明顯的目標。',
  }
},
[13069] = {
  {
    'Derrube-os!‡Пристрели их‡Schießt sie ab!‡거침없이 쏴라‡Dispárales‡Dispárales‡Descendez-les tous !‡把它们打下来！‡把他們射成刺蝟',
    nil,
    'O Saltador, na Abóbada das Sombras, quer que você use um Arpão de Fogo Rápido de Jotunheim para derrubar 15 Protodracos de Jotunheim e seus cavaleiros.‡По заданию Прыгуна из Мрачного Свода сбейте с помощью йотунхеймского скорострельного гарпуна 15 йотунхеймских протодраконов и их наездников.‡Der Springer beim Schattengewölbe möchte, dass Ihr eine Schnellfeuerharpune von Jotunheim dazu verwendet, 15 Protodrachen von Jotunheim mitsamt ihren Reitern abzuschießen.‡어둠의 무기고에 있는 껑충이가 요툰하임 속사 불작살을 이용하여 요툰하임 원시비룡에 탄 요툰하임 원시비룡 기수 15명을 쏘아 떨어트려 달라고 했습니다.‡El Saltador en La Cámara de las Sombras quiere que uses un arpón de fuego rápido de Jotunheim para derribar a 15 protodracos de Jotunheim y a sus jinetes.‡El Saltador en La Cámara de las Sombras quiere que uses un arpón de fuego rápido de Jotunheim para derribar a 15 protodracos de Jotunheim y a sus jinetes.‡Le Bondisseur, au Caveau des Ombres, veut que vous utilisiez un Harpon à tir rapide jotunheim pour abattre 15 Proto-Drakes de Jotunheim et leurs Chevaucheurs.‡暗影拱顶的跳跃者要你使用尤顿海姆速射鱼叉炮，击落15头尤顿海姆始祖龙以及它们的骑手。‡暗影穹殿的跳躍者要求你，使用卓頓海姆速射魚叉，射下15頭卓頓海姆元龍和騎乘其上的騎兵。',
  }
},
[13070] = {
  {
    'Uma frente fria se aproxima‡Приближение холодного фронта‡Eine Kaltfront nähert sich‡다가오는 한랭 전선‡Se aproxima un frente frío‡Se aproxima un frente frío‡Un front froid se rapproche‡冷锋逼近‡冷鋒逼近',
    nil,
    'Apresente-se ao Mestre de Ataque Fezzik na Vanguarda Argêntea, que fica na Coroa de Gelo.‡Поговорите с осадным мастером Феззиком в Оплоте Серебряного Авангарда в Ледяной Короне.‡Meldet Euch bei Belagerungsmeister Fezzik bei der Argentumvorhut in Eiskrone.‡얼음왕관의 은빛십자군 선봉기지에 있는 공성전문가 페지크에게 보고해야 합니다.‡Preséntate ante el Maestro de asedio Fezzik en La Vanguardia Argenta en Corona de Hielo.‡Preséntate ante el Maestro de asedio Fezzik en La Vanguardia Argenta en Corona de Hielo.‡Présentez-vous au Maître de siège Fezzik à l\'Avant-garde d\'Argent, dans la Couronne de glace.‡前往冰冠冰川的银色前线基地，向攻城大师菲斯克报到。‡在寒冰皇冠的先鋒駐地，向攻城大師費茲克報到。',
  }
},
[13071] = {
  {
    'Torpe brincar com fogo!‡Злоб любит огонь!‡Ekel mag Feuer!‡썩은내 불 좋아!‡¡A Vil gustar fuego!‡¡A Vil gustar fuego!‡Vil aime feu !‡维尔喜欢火焰！‡暗邪愛看煙火秀!',
    nil,
    'O Torpe, na Abóbada das Sombras, quer que você roube um Protodraco de Njorndar e use-o para incendiar 8 prédios dos vraikalen na região de Jotunheim.|n|nA Fortaleza Balargarde, devido à sua natureza, não pode ser incendiada.‡По просьбе Злоба из Мрачного Свода украдите ньорндарского протодракона и заставьте его поджечь 8 построек врайкулов в Йотунхейме.|n|nЦитадель Балагарда, в силу своей природы, гореть не может.‡Ekel im Schattengewölbe möchte, dass Ihr einen Protodrachen von Njorndar stehlt und ihn benutzt, um 8 Vrykulgebäude in der weiteren Jotunheimregion in Brand zu setzen.|n|nDie Festung Balargarde kann aufgrund ihrer Beschaffenheit nicht in Flammen gesetzt werden.‡어둠의 무기고에 있는 썩은내가 요른다르 원시비룡 한 마리를 훔쳐 광범위 요툰하임 지역에 있는 브리쿨 건물 8채에 불을 지르라고 했습니다.|n|n특성상, 발라르가드 요새에는 불을 지를 수 없습니다.‡Vil en La Cámara de las Sombras quiere que robes un protodraco Njorndar y lo uses para incendiar 8 edificios vrykul en la región de Jotunheim.|n|nNo se puede prender fuego a la Fortaleza de Balargarde.‡Vil en La Cámara de las Sombras quiere que robes un protodraco Njorndar y lo uses para incendiar 8 edificios vrykul en la región de Jotunheim.|n|nNo se puede prender fuego a la Fortaleza de Balargarde.‡Vil, au Caveau des Ombres, vous a demandé de voler un Proto-drake njorndar et de l\'utiliser pour mettre le feu à 8 Bâtiments vrykuls dans la région de Jotunheim.|n|nLa forteresse de Balargarde, en raison de sa nature, ne peut pas être enflammée.‡暗影拱顶的劣尸维尔要你偷得一头约尔达始祖龙，用它焚毁尤顿海姆的8幢维库人建筑物。|n|n不过，你无法焚毁坚固的巴拉加德堡垒。‡暗影穹殿的暗邪要求你，偷走一頭尼約達元龍，並利用牠在卓頓海姆區域內焚燬8棟維酷建築。|n|n不過，巴拉加德堡壘因為材質的緣故無法焚燬。',
  }
},
[13072] = {
  {
    'Os resquícios de um herói‡Горькая участь героя‡Ein Held verbleibt‡영웅은 남고...‡Aún queda un héroe‡Aún queda un héroe‡Un héros reste‡弥留的英雄‡英雄尚存',
    nil,
    'Leve as notícias sobre o destino do Cruzado Brindeiro para o Grão-lorde Tirion Fordring, no Pináculo dos Cruzados.‡Расскажите о том, что случилось с рыцарем Бриденбрадом, верховному лорду Тириону Фордрингу на Вершине Рыцарей.‡Bringt die Neuigkeiten von Kreuzfahrer Bridenbrads Schicksal zu Hochlord Tirion Fordring in den Kreuzfahrerturm.‡성전사 브라이든브래드의 소식을 십자군 봉우리에 있는 대영주 티리온 폴드링에게 전달해야 합니다.‡Llévale las noticias del destino del cruzado Bridenbrad al alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Llévale las noticias del destino del cruzado Bridenbrad al alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Apportez des nouvelles du destin du Croisé Bridenbrad au Généralissime Tirion Fordring à la Cime des Croisés.‡返回北伐军之峰，将北伐军战士布雷登布莱德的情况告诉大领主提里奥·弗丁。‡將十字軍布理登布萊特的遭遇，回報給十字軍之巔的大領主提里奧·弗丁。',
  }
},
[13073] = {
  {
    'A ajuda do Guardião‡Благосклонность хранителя‡Eine Bitte an den Bewahrer‡수호자의 친절‡El favor del guardián‡El favor del guardián‡La faveur du gardien‡守护者的帮助‡守護者的援助',
    nil,
    'O Grão-lorde Tirion Fordring, na Pináculo dos Cruzados, quer que você peça passagem para a Clareira da Lua à Arquidruida Lilliandra e, chegando lá, fale com o Guardião Remulos.‡По просьбе верховного лорда Тириона Фордринга с Вершины Рыцарей поговорите с верховным друидом Лилиандрой и доберитесь до хранителя Ремула на Лунной поляне.‡Hochlord Tirion Fordring im Kreuzfahrerturm hat Euch gebeten, dass Ihr bei der Erzdruidin Lilliandra Zugang erbittet und mit Bewahrer Remulos redet.‡십자군 봉우리에 있는 대영주 티리온 폴드링이 대드루이드 릴리안드라의 도움으로 달숲으로 가 수호자 레물로스와 대화하라고 했습니다.‡El alto señor Tirion Vadín en el Pináculo de los Cruzados te ha pedido que obtengas un pasaje de la archidruida Lilliandra y que hables con el guardián Remulos en Claro de la Luna.‡El alto señor Tirion Vadín en el Pináculo de los Cruzados te ha pedido que obtengas un pasaje de la archidruida Lilliandra y que hables con el guardián Remulos en Claro de la Luna.‡Le Généralissime Tirion Fordring, à la Cime des Croisés, vous a demandé d\'obtenir de l\'Archidruide Lilliandra un passage vers Reflet-de-Lune afin de parler au Gardien Remulos.‡北伐军之峰的大领主提里奥·弗丁要你去和大德鲁伊莉琳德拉谈一谈，请她送你去月光林地。抵达月光林地后，与守护者雷姆洛斯谈一谈。‡十字軍之巔的大領主提里奧·弗丁，要你從大德魯伊莉莉安卓處獲取通行許可，並前往月光林地和守護者雷姆洛斯談談。',
  }
},
[13074] = {
  {
    'Esperança no Pesadelo Esmeralda‡Изумрудный кошмар‡Hoffnung im Smaragdgrünen Alptraum‡에메랄드의 악몽 속에서 찾은 희망‡Esperanza dentro de la pesadilla esmeralda‡Esperanza dentro de la pesadilla esmeralda‡Un espoir dans le cauchemar d\'émeraude‡翡翠噩梦中的希望‡翡翠夢魘中的一絲希望',
    nil,
    'O Guardião Remulos, na Clareira da Lua, instruiu você a entrar no Sonho Esmeralda e coletar 3 Bolotas Esmeralda.|n|nPara retornar a Azeroth, basta se afastar do Santuário de Remulos.‡По заданию хранителя Ремула с Лунной поляны погрузитесь в Изумрудный Сон и добудьте 3 изумрудных желудя.|n|nЧтобы пробудиться, покиньте святилище Ремула или ущипните себя.‡Bewahrer Remulos auf der Mondlichtung hat Euch aufgetragen, den Smaragdgrünen Traum zu betreten und 3 Smaragdgrüne Eicheln zu besorgen.|n|nVerlasst die nähere Umgebung des Schreins von Remulos, um nach Azeroth zurückzukehren.‡달숲에 있는 수호자 레물로스가 방법을 일러주며 에메랄드의 꿈으로 들어가 에메랄드 도토리 3개를 모아 달라고 했습니다.|n|n아제로스로 돌아오려면 레물로스의 제단 주위에서 벗어나야 합니다.‡El guardián Remulos en Claro de la Luna te ha mostrado cómo entrar en el Sueño Esmeralda y recuperar 3 bellotas esmeralda.|n|nSal de los límites del Santuario de Remulos para volver a Azeroth.‡El guardián Remulos en Claro de la Luna te ha mostrado cómo entrar en el Sueño Esmeralda y recuperar 3 bellotas esmeralda.|n|nSal de los límites del Santuario de Remulos para volver a Azeroth.‡Le Gardien Remulos, à Reflet-de-lune, vous a demandé de pénétrer dans le Rêve d\'émeraude et de récupérer 3 Glands d\'émeraude.|n|nPassez les limites extérieures du Sanctuaire de Remulos pour retourner en Azeroth.‡月光林地的守护者雷姆洛斯要你进入翡翠梦境，获取3枚翡翠橡果。|n|n跨出雷姆洛斯神殿的范围就可以回到艾泽拉斯世界。‡月光林地的守護者雷姆洛斯指示你，進入翡翠夢境並找到3枚翡翠橡實。|n|n然後離開雷姆洛斯神殿一帶，以回到艾澤拉斯。',
  }
},
[13075] = {
  {
    'A dádiva de Remulos‡Дар Ремула‡Remulos\' Segen‡레물로스가 베푼 은혜‡El favor de Remulos‡El favor de Remulos‡La faveur de Remulos‡雷姆洛斯的恩赐‡雷姆洛斯之恩',
    nil,
    'Retorne ao Cruzado Brindeiro com a Bolota Esmeralda. Você o encontrará na Vigia Silente, que fica na Coroa de Gelo.‡Отнесите изумрудный желудь рыцарю Бриденбраду в Молчаливое Бдение, что в Ледяной Короне.‡Kehrt mit der Smaragdeichel zu Kreuzfahrer Bridenbrad in die Stille Nachtwache in Eiskrone zurück.‡얼음왕관 침묵의 망루에 있는 성전사 브라이든브래드에게 에메랄드 도토리를 가져가야 합니다.‡Vuelve con la bellota esmeralda al cruzado Bridenbrad en el Vigía Silencioso, en Corona de Hielo.‡Vuelve con la bellota esmeralda al cruzado Bridenbrad en el Vigía Silencioso, en Corona de Hielo.‡Retournez voir le Croisé Bridenbrad à la Veille Silencieuse, dans la Couronne de glace, avec le Gland d\'émeraude.‡将翡翠橡果交给冰冠冰川沉默墓地的北伐军战士布雷登布莱德。‡攜帶翡翠橡實，回寒冰皇冠的靜默警戒找十字軍布理登布萊特。',
  }
},
[13076] = {
  {
    'Ainda há tempo‡Время еще есть‡Es bleibt noch Zeit‡아직 시간은 있다‡Aún queda tiempo‡Aún queda tiempo‡Encore un peu de temps‡仍有时间‡尚有時間',
    nil,
    'Retorne ao Grão-lorde Tirion Fordring, no Pináculo dos Cruzados, com as notícias sobre o efeito da Bolota Esmeralda.‡Возвращайтесь к верховному лорду Тириону Фордрингу на Вершину Рыцарей и сообщите ему о том, каким действием обладают изумрудные желуди.‡Kehrt zu Hochlord Tirion Fordring in den Kreuzfahrerturm zurück und berichtet ihm von den Effekten der Smaragdeichel.‡십자군 봉우리에 있는 대영주 티리온 폴드링에게 에메랄드 도토리가 어떤 효과를 나타냈는지 보고해야 합니다.‡Vuelve con el alto señor Tirion Vadín en el Pináculo de los Cruzados y cuéntale los efectos de la bellota esmeralda.‡Vuelve con el alto señor Tirion Vadín en el Pináculo de los Cruzados y cuéntale los efectos de la bellota esmeralda.‡Retournez voir le Généralissime Tirion Fordring à la Cime des Croisés et rapportez-lui les effets du Gland d\'émeraude.‡向北伐军之峰的大领主提里奥·弗丁汇报翡翠橡果的效果。‡回到十字軍之巔的大領主提里奧·弗丁身邊，告訴他翡翠橡實的功效。',
  }
},
[13077] = {
  {
    'O toque de um aspecto‡Прикосновение аспекта‡Die Berührung eines Aspekts‡위상의 손길‡El toque de un Aspecto‡El toque de un Aspecto‡Le toucher d\'un Aspect‡龙神的触摸‡守護巨龍之觸',
    nil,
    'Solicite a ajuda de Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes.‡Попросите о помощи Алекстразу Хранительницу Жизни из храма Драконьего Покоя.‡Erbittet die Hilfe von Alexstrasza der Lebensbinderin im Wyrmruhtempel.‡고룡쉼터 사원에 있는 생명의 어머니 알렉스트라자에게 가서 도움을 요청해야 합니다.‡Pide la ayuda de Alexstrasza la Protectora en el Templo del Reposo del Dragón.‡Pide la ayuda de Alexstrasza la Protectora en el Templo del Reposo del Dragón.‡Demandez l\'aide d\'Alexstrasza la Lieuse-de-vie au Temple du Repos du ver.‡向龙眠神殿的阿莱克丝塔萨，生命的缚誓者请求帮助。‡在龍眠神殿，向生命守縛者雅立史卓莎請求協助。',
  }
},
[13078] = {
  {
    'Lágrimas de Dália‡Слезы Далии‡Dahlias Tränen‡달리아의 눈물‡Las lágrimas de Dahlia‡Las lágrimas de Dahlia‡Les larmes de Dahlia‡达莉亚之泪‡妲莉雅之淚',
    nil,
    'Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes, pediu que você colhesse Lágrimas de Dália nas áreas recentemente renovadas pelas chamas dos Protetores Rubis.‡Сорвите слезы Далии с земли, очищенной пламенем Рубиновых хранителей, и принесите их Алекстразе Хранительнице Жизни в храм Драконьего Покоя.‡Alexstrasza die Lebensbinderin im Wyrmruhtempel verlangt von Euch, dass Ihr Dahlias Tränen aus dem Boden bergt, der von den Flammen der Rubinbehüter frisch geläutert ist.‡고룡쉼터 사원에 있는 생명의 어머니 알렉스트라자가 루비 수호자들의 불꽃으로 막 정화된 땅에서 달리아의 눈물을 가져오라고 했습니다.‡Alexstrasza la Protectora en el Templo del Reposo del Dragón te ha pedido que recuperes las lágrimas de Dahlia del suelo recién purificado por las llamas de los vigilantes rubí.‡Alexstrasza la Protectora en el Templo del Reposo del Dragón te ha pedido que recuperes las lágrimas de Dahlia del suelo recién purificado por las llamas de los vigilantes rubí.‡Alexstrasza la Lieuse-de-vie, au Temple du Repos du ver, vous a demandé de récupérer les Larmes de Dahlia sur une terre récemment purifiée par les flammes d\'un Gardien rubis.‡龙眠神殿的阿莱克丝塔萨要你从被红玉看守者的烈焰净化过的土壤里取得达莉亚之泪。‡龍眠神殿裡的生命守縛者雅立史卓莎要求你，在晶紅管理者施放烈焰、淨化生命後，從地上收集妲莉雅之淚。',
  }
},
[13079] = {
  {
    'A dádiva de Alexstrasza‡Дар Алекстразы‡Alexstraszas Segen‡알렉스트라자가 베푼 은혜‡El favor de Alexstrasza‡El favor de Alexstrasza‡La faveur d\'Alexstrasza‡阿莱克丝塔萨的恩赐‡雅立史卓莎之恩',
    nil,
    'Leve o Sopro de Alexstrasza para o Cruzado Brindeiro na Vigia Silente, que fica na Coroa de Gelo.‡Отнесите Дыхание Алекстразы рыцарю Бриденбраду в Молчаливое Бдение, что в Ледяной Короне.‡Bringt den Atem von Alexstrasza zu Kreuzfahrer Bridenbrad in die Stille Nachtwache in Eiskrone.‡얼음왕관 침묵의 망루에 있는 성전사 브라이든브래드에게 알렉스트라자의 숨결을 가져가야 합니다.‡Lleva el aliento de Alexstrasza al cruzado Bridenbrad al Vigía Silencioso, en Corona de Hielo.‡Lleva el aliento de Alexstrasza al cruzado Bridenbrad al Vigía Silencioso, en Corona de Hielo.‡Apportez le Souffle d\'Alexstrasza au Croisé Bridenbrad à la Veille Silencieuse, dans la Couronne de glace.‡将阿莱克丝塔萨之息交给冰冠冰川沉默墓地的北伐军战士布雷登布莱德。‡寒冰皇冠的靜默警戒，將雅立史卓莎之息交給十字軍布理登布萊特。',
  }
},
[13080] = {
  {
    'Ainda há esperanças‡Надежда жива‡Die Hoffnung stirbt zuletzt‡아직도 희망은 있다‡Aún queda esperanza‡Aún queda esperanza‡L\'espoir fait vivre‡仍有希望‡希望尚存',
    nil,
    'Retorne ao Grão-lorde Tirion Fordring, no Pináculo dos Cruzados, com as notícias sobre o efeito do Sopro de Alexstrasza.‡Вернитесь к верховному лорду Тириону Фордрингу на Вершину Рыцарей. Расскажите ему о действии Дыхания Алекстразы.‡Kehrt zu Hochlord Tirion Fordring in den Kreuzfahrerturm zurück und berichtet ihm von den Effekten des Atems von Alexstrasza.‡십자군 봉우리에 있는 대영주 티리온 폴드링에게 알렉스트라자의 숨결이 어떤 효과를 나타냈는지 보고해야 합니다.‡Vuelve con el alto señor Tirion Vadín en el Pináculo de los Cruzados y cuéntale los efectos del aliento de Alexstrasza.‡Vuelve con el alto señor Tirion Vadín en el Pináculo de los Cruzados y cuéntale los efectos del aliento de Alexstrasza.‡Retournez voir le Généralissime Tirion Fordring à la Cime des Croisés et rapportez-lui les effets du Souffle d\'Alexstrasza.‡向北伐军之峰的大领主提里奥·弗丁汇报阿莱克丝塔萨之息的效果。‡回到十字軍之巔的大領主提里奧·弗丁身邊，告訴他雅立史卓莎之息的功效。',
  }
},
[13081] = {
  {
    'A vontade dos Naarus‡Завещание наару‡Der Wille der Naaru‡나루의 의지‡La voluntad de los naaru‡La voluntad de los naaru‡La volonté des naaru‡纳鲁的意志‡那魯的意志',
    nil,
    'Solicite a ajuda de A\'dal em Shattrath, que fica na Mata Terokkar.‡Попросите о помощи А\'дала из Шаттрата, который находится в лесу Тероккар.‡Erbittet die Hilfe von A\'dal in Shattrath in den Wäldern von Terokkar.‡테로카르 숲의 샤트라스에 있는 아달에게 도움을 청해야 합니다.‡Pídele ayuda a A\'dal en la Ciudad de Shattrath, en el Bosque de Terokkar.‡Pídele ayuda a A\'dal en la Ciudad de Shattrath, en el Bosque de Terokkar.‡Demandez l\'aide d\'A\'dal à Shattrath, dans la Forêt de Terokkar.‡向沙塔斯城的阿达尔求助。‡到泰洛卡森林向撒塔斯城的阿達歐尋求幫助。',
  }
},
[13082] = {
  {
    'A dádiva de A\'dal‡Дар А\'дала‡A\'dals Segen‡아달이 베푼 은혜‡El favor de A\'dal‡El favor de A\'dal‡La faveur d\'A\'dal‡阿达尔的恩赐‡阿達歐之恩',
    nil,
    'Retorne ao Cruzado Brindeiro na Vigia Silente, que fica na Coroa de Gelo.‡Вернитесь к рыцарю Бриденбраду в Молчаливое Бдение, что в Ледяной Короне.‡Kehrt zu Kreuzfahrer Bridenbrad in die Stille Nachtwache in Eiskrone zurück.‡얼음왕관 침묵의 망루에 있는 성전사 브라이든브래드에게 가야 합니다.‡Vuelve con el cruzado Bridenbrad en el Vigía Silencioso, en Corona de Hielo.‡Vuelve con el cruzado Bridenbrad en el Vigía Silencioso, en Corona de Hielo.‡Retournez auprès du Croisé Bridenbrad à la Veille Silencieuse, dans la Couronne de glace.‡返回冰冠冰川，在沉默墓地找到北伐军战士布雷登布莱德。‡到寒冰皇冠的靜默警戒找十字軍布理登布萊特。',
  }
},
[13083] = {
  {
    'Há luz na escuridão‡Свет во тьме‡Licht im Dunkeln‡어둠 속의 빛‡Luz en las tinieblas‡Luz en las tinieblas‡La Lumière dans les ténèbres‡黑暗中的光明‡黑暗中的一絲微光',
    nil,
    'Entregue o Tabardo do Cruzado Brindeiro para o Grão-lorde Tirion Fordring no Pináculo dos Cruzados.‡Отнесите плащ рыцаря Бриденбрада верховному лорду Тириону Фордрингу на Вершину Рыцарей.‡Bringt Kreuzfahrer Bridenbrads Wappenrock zu Hochlord Tirion Fordring in den Kreuzfahrerturm.‡십자군 봉우리에 있는 대영주 티리온 폴드링에게 성전사 브라이든브래드의 휘장을 가져가야 합니다.‡Llévale el tabardo del cruzado Bridenbrad al alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Llévale el tabardo del cruzado Bridenbrad al alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Apportez le Tabard du Croisé Bridenbrad au Généralissime Tirion Fordring à la Cime des Croisés.‡将布雷登布莱德的战袍交给北伐军之峰的大领主提里奥·弗丁。‡將十字軍布理登布萊特的外袍帶給十字軍之巔的大領主提里奧·弗丁。',
  }
},
[13084] = {
  {
    'Jotunheim destruída‡Психологическая атака‡Demoliert Jotunheim‡요툰하임 더럽히기‡Saqueando Jotunheim‡Saqueando Jotunheim‡Jouer les vandales à Jotunheim‡破坏尤顿海姆‡燃燒吧，卓頓海姆!',
    nil,
    'O Duque Lankral, na Abóbada das Sombras, quer que você queime 10 Estandartes Vraikalen.‡Сожгите 10 знамен врайкулов по поручению герцога Ланкрала из Мрачного Свода.‡Herzog Lankral beim Schattengewölbe möchte, dass Ihr 10 Banner der Vrykul verbrennt.‡어둠의 무기고에 있는 공작 란크랄이 브리쿨 깃발 10개를 불태워달라고 했습니다.‡El duque Lankral de La Cámara de las Sombras quiere que quemes 10 estandartes vrykul.‡El duque Lankral de La Cámara de las Sombras quiere que quemes 10 estandartes vrykul.‡Le Duc Lankral, au Caveau des Ombres, vous demande de brûler 10 Bannières vrykules.‡暗影拱顶的兰克拉尔公爵要你烧毁10面维库人旗帜。‡暗影穹殿的蘭克洛公爵要你焚燬10支維酷旌旗。',
  }
},
[13085] = {
  {
    'O retorno de Vaelen‡Возвращение Вэлена‡Vaelen ist zurückgekehrt‡밸렌의 귀환‡Vaelen ha vuelto‡Vaelen ha vuelto‡Vaelen est de retour‡维林回来了‡維倫回來了',
    nil,
    'Fale novamente com Vaelen, o Esfolado, na Abóbada das Sombras, que fica na Coroa de Gelo.‡Поговорите с Вэленом Разоблаченным в Мрачном Своде.‡Redet mit Vaelen dem Geschundenen im Schattengewölbe.‡어둠의 무기고에서 고문당한 밸렌과 대화해야 합니다.‡Habla con Vaelen el Despellejado en La Cámara de las Sombras.‡Habla con Vaelen el Despellejado en La Cámara de las Sombras.‡Parlez à Vaelen l\'Écorché au Caveau des Ombres.‡与暗影拱顶内被折磨的维林谈一谈。‡在暗影穹殿裡和被搶劫的維倫對話。',
  }
},
[13086] = {
  {
    'A última linha de defesa‡Последний рубеж‡Die letzte Verteidigungslinie‡최후의 방어‡La última línea de defensa‡La última línea de defensa‡La dernière ligne de défense‡最后一道防线‡最後防線',
    nil,
    'Use um Canhão Argênteo para destruir 100 membros do Flagelo. Além disso, mate 3 Devastadores Ninhálgida.|n|nApós cumprir sua missão, fale com o Mestre de Ataque Fezzik.‡Уничтожьте 100 солдат Плети с помощью пушки Серебряного Авангарда. Также уничтожьте 3 ледяных драконов-разрушителей.|n|nВ случае успеха вернитесь к осадному мастеру Феззику.‡Benutzt eine Argentumkanone, um 100 Angreifer der Geißel zu vernichten. Außerdem müsst Ihr 3 Frostbrutzerstörer töten.|n|nSolltet Ihr erfolgreich sein, kehrt zu Belagerungsmeister Fezzik zurück.‡은빛십자군 대포를 사용하여 스컬지 공격자 100마리와 서리고룡족 파괴자 3마리를 물리쳐야 합니다.|n|n임무를 성공적으로 수행하고 나서 공성전문가 페지크에게 가야 합니다.‡Usa un cañón Argenta para destruir a 100 atacantes de la Plaga. Debes matar también a 3 destructores Razaescarcha.|n|nSi lo logras, habla con el Maestro de asedio Fezzik.‡Usa un cañón Argenta para destruir a 100 atacantes de la Plaga. Debes matar también a 3 destructores Razaescarcha.|n|nSi lo logras, habla con el Maestro de asedio Fezzik.‡Utilisez un Canon d\'Argent pour détruire 100 Attaquants du Fléau. Vous devez également tuer 3 Destructeurs couvegivres.|n|nRetournez voir le Maître de siège Fezzik si vous deviez réussir.‡使用银色火炮消灭100名天灾军团攻击者和3条霜巢毁灭者。|n|n完成任务后向攻城大师菲斯克复命。‡以銀白火砲殺死100個天譴進攻者。同時殺死3隻霜育摧毀者。|n|n成功之後，向攻城大師費茲克回報。',
  }
},
[13087] = {
  {
    'Culinária do norte‡Кулинария севера‡Kochkunst des Nordens‡북극 요리‡Cocina norteña‡Cocina norteña‡La cuisine du Grand Nord‡诺森德的厨师‡北方廚藝',
    nil,
    'Leve quatro pedaços de Carne Gelada para Brom Cervejarte em Valgarde. Você consegue retirar Carne Gelada de qualquer fera de Nortúndria.‡Принесите четыре куска охлажденного мяса зверей Нордскола Брому Выпивастеру в Валгард.‡Bringt 4 Stück kühles Fleisch zu Brom Bräugießer in Valgarde. Jede Bestie in Nordend verfügt über dieses Fleisch.‡발가드에 있는 브롬 브루바스터에게 얼어붙은 고기 4개를 가져가야 합니다. 얼어붙은 고기는 노스렌드에 사는 야수들에게서 얻을 수 있습니다.‡Llévale 4 carnes frías a Brom Aliño en Valgarde. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Llévale 4 carnes frías a Brom Aliño en Valgarde. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Apportez 4 morceaux de Viande glacée à Brom Mouillebière à Valgarde. La viande glacée se trouve sur n’importe quelle bête du Norfendre.‡将4块冰冷的肉交给瓦加德的布罗姆。你可以在诺森德的任意野兽身上找到冰冷的肉。‡把四塊冷肉塊交給瓦爾加德的布隆·塗酒。北裂境的任何野獸身上都能找到冷肉塊。',
  }
},
[13088] = {
  {
    'Culinária do norte‡Кулинария севера‡Kochkunst des Nordens‡북극 요리‡Cocina norteña‡Cocina norteña‡La cuisine du Grand Nord‡诺森德的厨师‡北方廚藝',
    nil,
    'Traga quatro Carnes Geladas para Roliço MacKreel na Bastilha Valentia. Você consegue retirar Carne Gelada de qualquer fera de Nortúndria.‡Принесите четыре куска охлажденного мяса зверей Нордскола Роллику Маккрилу в Крепость Отваги.‡Bringt Rollick MacKreel in der Valianzfeste 4 Stück kühles Fleisch. Alle Bestien in Nordend verfügen über dieses Fleisch.‡용맹의 성채에 있는 롤릭 맥크릴이 얼어붙은 고기 4개를 가져다 달라고 했습니다. 얼어붙은 고기는 노스렌드에 있는 야수에게서 얻을 수 있습니다.‡Llévale 4 carnes frías a Rollick Mackreel en la Fortaleza Denuedo. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Llévale 4 carnes frías a Rollick MacKreel en la Fortaleza Denuedo. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Apportez 4 Viandes glacées à Rollick Mackreel au Donjon de la Bravoure. Vous pouvez récupérer de la Viande glacée sur n\'importe quelle bête du Norfendre.‡将4块冰冷的肉交给无畏要塞的罗里克·玛克雷尔。你可以在诺森德的任意野兽身上找到冰冷的肉。‡把四塊冷肉塊交給驍勇要塞的羅利克·麥克里爾。北裂境的任何野獸身上都能取得冷肉塊。',
  }
},
[13089] = {
  {
    'Culinária do norte‡Кулинария севера‡Kochkunst des Nordens‡북극 요리‡Cocina norteña‡Cocina norteña‡La cuisine du Grand Nord‡诺森德的厨师‡北方廚藝',
    nil,
    'Leve quatro pedaços de Carne Gelada para Tomás Colíquio em Porto Vendeta. Você consegue retirar Carne Gelada de qualquer fera de Nortúndria.‡Принесите четыре куска охлажденного мяса зверей Нордскола Томасу Количио в Лагерь Возмездия.‡Bringt 4 Stück kühles Fleisch zu Thomas Kolichio im Hafen der Vergeltung. Alle Bestien in Nordend verfügen über dieses Fleisch.‡복수의 상륙지에 있는 토마스 콜리치오가 얼어붙은 고기를 가져다 달라고 했습니다. 얼어붙은 고기는 노스렌드에 있는 야수들에게서 얻을 수 있습니다.‡Llévale 4 carnes frías a Thomas Kolichio en Campo Venganza. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Llévale 4 carnes frías a Thomas Kolichio en Campo Venganza. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Apportez 4 morceaux de Viande glacée à Thomas Kolichio, à l\'Accostage de la Vengeance. La viande glacée se trouve sur n’importe quelle bête du Norfendre.‡将4块冰冷的肉交给复仇港的托马斯·克里奇。你可以在诺森德的任意野兽身上找到冰冷的肉。‡把四塊冷肉塊交給復仇臺地的湯瑪士·寇里奇歐。北裂境的任何野獸身上都能找到冷肉塊。',
  }
},
[13090] = {
  {
    'Culinária do norte‡Кулинария севера‡Kochkunst des Nordens‡북극 요리‡Cocina norteña‡Cocina norteña‡La cuisine du Grand Nord‡诺森德的厨师‡北方廚藝',
    nil,
    'Traga quatro Carnes Geladas para Orn Casco Tenro na Fortaleza Brado Guerreiro. Você consegue retirar Carne Gelada de qualquer fera de Nortúndria.‡Принесите четыре куска охлажденного мяса зверей Нордскола Орну Хрупкое Копыто в Крепость Песни Войны. Охлажденное мясо можно достать только убивая зверей, обитающих на континенте Нордскол.‡Bringt Orn Zarthuf in der Kriegshymnenfeste 4 Stück kühles Fleisch. Alle Bestien in Nordend verfügen über dieses Fleisch.‡전쟁노래 요새에 있는 오른 텐더후프에게 얼어붙은 고기 4개를 가져가야 합니다. 얼어붙은 고기는 노스렌드에 있는 야수들에게서 얻을 수 있습니다.‡Llévale 4 carnes frías a Orn Pezuña Tierna en Bastión Grito de Guerra. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Llévale 4 carnes frías a Orn Pezuña Tierna en Bastión Grito de Guerra. La carne fría se puede encontrar en cualquier bestia de Rasganorte.‡Apportez 4 Viandes glacées à Orn Tendre-sabot au Bastion Chanteguerre. Vous pouvez récupérer de la Viande glacée sur n\'importe quelle bête du Norfendre.‡将4块冰冷的肉交给战歌要塞的奥恩·嫩蹄。你可以在诺森德的任意野兽身上找到冰冷的肉。‡把四塊冷肉塊交給戰歌堡的翁恩·柔蹄。北裂境的任何野獸身上都能取得冷肉塊。',
  }
},
[13091] = {
  {
    'A arte de ser um terror d\'água‡Нелегко быть водным ужасом‡Die Kunst, ein Wasserschrecken zu sein‡공포의 물 정령 다루기‡El arte de ser un terror de agua‡El arte de ser un terror de agua‡L\'art d\'être une terreur d\'eau‡恐怖之水‡身為水駭體的藝術',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você controle um Terror d\'Água e use-o para matar 10 vraikalen na região de Jotunheim.|n|nVocê pode matar Guarda-sonos de Jotunheim, Guerreiros de Jotunheim, Aquemagos Mjordin, Irmãs de Armas Njordar e Vargulen de Valhalas.‡По заданию костяной ведьмы из деревни Ньорндар завладейте водяным ужасом и уничтожьте с его помощью 10 врайкулов в окрестностях Йотунхейма.|n|nВаша кара может коснуться йотунхеймских хранителей снов, йотунхеймских воинов, мьординских волхвов воды, ньорндарских копьеносиц и валхальских варгулов.‡Die Knochenhexe in Njorndar möchte, dass Ihr Besitz von einem Wasserschrecken ergreift und ihn dazu benutzt, 10 Vrykul in der Umgebung von Jotunheim zu töten.|n|nIn Frage kommende Vrykul sind Schlafwächter, Krieger von Jotunheim, Wassermagier der Mjordin, Speerschwestern von Njorndar und Varguls von Valhalas.‡요른다르 마을에 있는 해골 마녀가 공포의 물 정령을 지배하여 광범위 요툰하임 지역에 있는 브리쿨을 10마리 처치해 달라고 했습니다.|n|n해당하는 브리쿨은 요툰하임 수면의 감시자, 요툰하임 전사, 미요르딘 물의 마법사, 요른다르 여작살병, 발할라스 바르굴입니다.‡La Bruja Osaria en el poblado Njorndar quiere que poseas a un terror de agua y lo uses para matar a 10 vrykuls en la región de Jotunheim.|n|nLos vrykuls adecuados son los vigías del sueño de Jotunheim, los guerreros de Jotunheim, los magi de agua Mjordin, las hermanas de armas Njorndar y los vargul de Valhalas.‡La Bruja Osaria en el poblado Njorndar quiere que poseas a un terror de agua y lo uses para matar a 10 vrykuls en la región de Jotunheim.|n|nLos vrykuls adecuados son los vigías del sueño de Jotunheim, los guerreros de Jotunheim, los magi de agua Mjordin, las hermanas de armas Njorndar y los vargul de Valhalas.‡La Sorcière des ossements, à Njorndar, vous demande de posséder une Terreur d\'eau et de l\'utiliser pour tuer 10 Vrykuls dans la région de Jotunheim.|n|nSont considérés comme des Vrykuls les Gardiens du sommeil jotunheim, les Guerriers jotunheim, les Magi d\'eau mjordin, les Njorndars sœur-de-lance et les Varguls du Valhalas.‡约尔达村的白骨女巫要你控制一个恐怖之水，利用它杀死尤顿海姆地区的10名维库人。|n|n尤顿海姆休眠看守者、尤顿海姆战士、尤尔丁控水师、约尔达女矛手和瓦哈拉斯行尸都符合要求。‡尼約達村的骸骨女巫要你操控一隻水駭體，在卓頓海姆一帶，以其殺害10個維酷人。|n|n定義上合格的維酷人指卓頓海姆沉睡看守者、卓頓海姆戰士、默約丁水魔導師、尼約達女矛侍、和英靈殿瓦苟。',
  }
},
[13092] = {
  {
    'Lendo os ossos‡Гадание по костям‡In den Knochen lesen‡뼈로 점치기‡Leyendo los huesos‡Leyendo los huesos‡Lecture des ossements‡占命卜运‡解讀骸骨',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você colete 15 Ossos de Vraikal.‡Принесите 15 костей врайкулов костяной ведьме в деревню Ньорндар.‡Die Knochenhexe in Njorndar hat Euch aufgetragen, 15 Vrykulknochen zu besorgen.‡요른다르 마을에 있는 해골 마녀가 브리쿨 뼈 15개를 모아오라고 했습니다.‡La Bruja Osaria en el poblado Njorndar te ha pedido que consigas 15 huesos de vrykul.‡La Bruja Osaria en el poblado Njorndar te ha pedido que consigas 15 huesos de vrykul.‡La Sorcière des ossements, à Njorndar, vous a demandé de récupérer 15 Os vrykuls.‡约尔达村的女巫要你去收集15个维库人的徽记。‡尼約達村的骸骨女巫指示你，收集15份維酷骸骨。',
  }
},
[13093] = {
  {
    'Lendo os ossos‡Гадание по костям‡In den Knochen lesen‡뼈로 점치기‡Leyendo los huesos‡Leyendo los huesos‡Lecture des ossements‡占命卜运‡解讀骸骨',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[13094] = {
  {
    'Não se envergonham?‡Ни стыда, ни совести‡Schämen sie sich denn nicht?‡부끄러운 줄도 모르나 봐요?‡¿No tienen vergüenza?‡¿No tienen vergüenza?‡Ils n\'ont vraiment honte de rien, alors ?‡他们丝毫不感到羞愧吗？‡他們不知羞恥嗎?',
    nil,
    'A Imagem da Maga-de-guerra Kaitlyn quer que você recupere a Pesquisa de Berinand.‡Проекция боевого мага Кейтлин просит вас найти книгу с исследованиями Беринарда.‡Abbild von Kriegsmagierin Kaitlyn möchte, dass Ihr Berinands Forschungsergebnisse beschafft.‡전쟁마법사 케이틀린의 환영이 베리난드의 연구 일지를 되찾아 달라고 했습니다.‡La imagen de la maga de guerra Kaitlyn quiere que recuperes la Investigación de Berinand.‡La imagen de la maga de guerra Kaitlyn quiere que recuperes la Investigación de Berinand.‡L’Image du mage de guerre Kaitlyn veut que vous récupériez les Recherches de Bérinand.‡战斗法师凯特琳的影像要你找回伯林纳德的研究笔记。‡戰爭法師凱特林的影像要你取回貝瑞那德的研究。',
  }
},
[13095] = {
  {
    'Não se envergonham?‡Ни стыда, ни совести‡Schämen sie sich denn nicht?‡부끄러운 줄도 모르나 봐요?‡¿No tienen vergüenza?‡¿No tienen vergüenza?‡Ils n\'ont vraiment honte de rien, alors ?‡他们丝毫不感到羞愧吗？‡他們不知羞恥嗎?',
    nil,
    'A Imagem da Maga-de-guerra Kaitlyn quer que você recupere a Pesquisa de Berinand.‡Проекция боевого мага Кейтлин просит вас найти книгу с исследованиями Беринарда.‡Abbild von Kriegsmagierin Kaitlyn möchte, dass Ihr Berinands Forschungsergebnisse beschafft.‡전쟁마법사 케이틀린의 환영이 베리난드의 연구 일지를 되찾아 달라고 했습니다.‡La imagen de la maga de guerra Kaitlyn quiere que recuperes la Investigación de Berinand.‡La imagen de la maga de guerra Kaitlyn quiere que recuperes la Investigación de Berinand.‡L’Image du mage de guerre Kaitlyn veut que vous récupériez les Recherches de Bérinand.‡战斗法师凯特琳的影像要你找回伯林纳德的研究笔记。‡戰爭法師凱特林的影像要你取回貝瑞那德的研究。',
  }
},
[13096] = {
  {
    'Gal\'darah tem que pagar‡Гал\'дара заплатит за все‡Gal\'darah muss bezahlen‡대가를 치러라, 갈다라!‡Gal\'darah debe pagar‡Gal\'darah debe pagar‡Gal\'darah doit payer‡迦尔达拉之死‡蓋爾達拉必須付出代價',
    nil,
    'Tol\'mar, em Dubra\'Jin, quer que você assassine Gal\'darah em Gundrak.‡Отправляйтесь в Гундрак и убейте Гал\'дара по поручению Тол\'мара из Дубра\'джина.‡Tol\'mar in Dubra\'Jin möchte, dass Ihr Gal\'darah in Gundrak erschlagt.‡두브라진에 있는 톨마르가 군드락에서 갈다라를 처치해 달라고 했습니다.‡Tol\'mar en Dubra\'Jin quiere que mates a Gal\'darah en Gundrak.‡Tol\'mar en Dubra\'Jin quiere que mates a Gal\'darah en Gundrak.‡Tol\'mar à Dubra\'Jin veut que vous assassiniez Gal\'darah à Gundrak.‡杜布拉金的托玛尔要你杀死古达克的迦尔达拉。‡杜布拉金的托爾瑪要你到剛德拉克殺死蓋爾達拉。',
  }
},
[13097] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡아직 끝나지 않은 일‡Negocios inconclusos‡Negocios inconclusos‡Terminer le travail‡未完的事情‡未完成的任務',
    nil,
    'Har\'koa quer que você fale com Tol\'mar em Dubra\'Jin.‡Поговорите с Тол\'маром в Дубра\'джине по просьбе Хар\'коа.‡Har\'koa möchte, dass Ihr mit Tol\'mar in Dubra\'jin sprecht.‡하르코아가 두브라진에서 톨마르와 대화해 달라고 했습니다.‡Har\'koa quiere que hables con Tol\'mar en Dubra\'jin.‡Har\'koa quiere que hables con Tol\'mar en Dubra\'jin.‡Har\'koa vous demande de parler à Tol\'mar à Dubra\'jin.‡哈克娅要你去跟杜布拉金的托玛尔谈一谈。‡哈寇亞要你與杜布拉金的托爾瑪交談。',
  }
},
[13098] = {
  {
    'Para a posteridade‡Для наших потомков‡Für die Nachwelt‡후손을 위하여‡Para la posteridad‡Para la posteridad‡Pour la postérité‡前车之鉴‡為了後代子孫',
    nil,
    'A Cronista Bah\'Kini, em Dubra\'Jin, quer que você entre em Gundrak e colete 6 Tabuletas Históricas dos Drakkari.‡Отправляйтесь в Гундрак и заберите оттуда 6 табличек с летописью Драккари по поручению летописца Ба\'Кини из Дубра\'джина.‡Chronistin Bah\'Kini in Dubra\'Jin möchte, dass Ihr nach Gundrak geht und 6 Geschichtstafeln der Drakkari sammelt.‡두브라진에 있는 기록가 바키니가 군드락으로 들어가 드라카리 역사 서판을 6개 모아와 달라고 했습니다.‡La cronista Bah\'Kini en Dubra\'Jin quiere que entres en Gundrak y recuperes 6 tablillas de historia Drakkari.‡La cronista Bah\'Kini en Dubra\'Jin quiere que entres en Gundrak y recuperes 6 tablillas de historia Drakkari.‡La chroniqueuse Bah\'Kini à Dubra\'Jin vous demande d\'aller à Gundrak et de récupérer 6 Tablettes de l\'histoire drakkari.‡杜布拉金的记载者拜基妮要你进入古达克，收集6份达卡莱历史石板。‡杜布拉金的撰史者巴琪妮要你進入剛德拉克收集6個德拉克瑞歷史石板。',
  }
},
[13099] = {
  {
    'Só dando uma olhada‡Просто проверка‡Nur ma\' nachsehen‡잠깐 확인을‡Probando, probando‡Probando, probando‡Petite vérification‡核实情况‡探班',
    nil,
    'To\'kini quer que você fale com Bah\'kini em Dubra\'Jin.‡Поговорите с Ба\'Кини в Дубра\'джине по просьбе То\'кини.‡To\'kini möchte, dass Ihr mit Bah\'kini in Dubra\'Jin sprecht.‡토키니가 두브라진에 있는 기록가 바키니와 대화해 달라고 했습니다.‡To\'kini quiere que hables con Bah\'kini en Dubra\'Jin.‡To\'kini quiere que hables con Bah\'kini en Dubra\'Jin.‡To\'kini vous a demandé de parler à Bah\'kini à Dubra\'Jin.‡记载者图基尼要你去和杜布拉金的拜基妮谈一谈。‡托基尼要你與杜布拉金的撰史者巴琪妮談談。',
  }
},
[13100] = {
  {
    'Bolo de Carne de Cogumelo Infuso‡Мясной рулет в странногрибном соусе‡Energieerfüllter Pilzhackbraten‡버섯 풍미 고기구이‡Pastel de carne de champiñones imbuidos‡Pastel de carne de champiñones imbuidos‡Pain de viande aux champignons infusés‡魔法蘑菇肉片‡灌能蘑菇肉糕',
    nil,
    'Use a Fôrma de Bolo de Carne para cozinhar 4 Cogumelos Infusos e 2 porções de Carne Gelada. Em seguida, entregue o Bolo de Carne para Otávio Adeleiro na Casa dos Bricabraques, que fica na Praça Fiarruna, em Dalaran.‡Запеките 4 странных гриба из Стоков Даларана и 2 куска охлажденного мяса в форме для мясного рулета и отнесите готовое блюдо Ортону Беннету в лавку "Диковины и редкости" на площадь Руноплета в Даларане.‡Benutzt Eure Bratenform, um aus 4 energieerfüllten Pilzen aus der Kanalisation von Dalaran und 2 Stück kühlem Fleisch einen Pilzhackbraten herzustellen und bringt das Resultat zu Orton Bennet bei Kuriositäten & Meer auf dem Runenweberplatz in Dalaran.‡고기구이 냄비로 마력 깃든 버섯 4개와 얼어붙은 고기 2덩이를 함께 요리한 다음, 만들어진 버섯 풍미 고기구이를 무어의 골동품점에 있는 오르톤 베네트에게 가져가야 합니다. 무어의 골동품점은 달라란의 룬위버 광장에 있습니다.‡Usa tu molde de pastel de carne para cocinar 4 champiñones imbuidos con 2 carnes frías. Cuando esté hecho el pastel, llévaselo a Orton Bennet de Curiosidades y Más, en la Plaza Tejerruna de Dalaran.‡Usa tu molde de pastel de carne para cocinar 4 champiñones imbuidos con 2 carnes frías. Cuando esté hecho el pastel, llévaselo a Orton Bennet de Curiosidades y Más, en la Plaza Tejerruna de Dalaran.‡Cuisinez 4 Champignons infusés des égouts de Dalaran avec 2 Viandes glacées dans votre Plat à pain de viande et apportez le Pain de viande à Orton Bennet aux Objets de la Moore, situé sur la Place Tisserune à Dalaran.‡将2块冰冷的肉和采自达拉然下水道的4枚魔法蘑菇放在你的煎肉锅中，烹制成一份魔法蘑菇肉片，然后将其带到达拉然的鲁因广场，交给摩尔珍品店中的奥尔顿·本内特。‡使用你的肉糕鍋，用4朵長在達拉然下水道的灌能蘑菇和2份冷肉塊煮出灌能蘑菇肉糕，然後送去給『不只是配件』的歐爾頓·班尼特，就在達拉然的織符者廣場。',
  }
},
[13101] = {
  {
    'Convenção no Saguão da Destreza‡Сбор в Приюте фокусника‡Versammlung im Zauberkasten‡요술쟁이 휴게실 모임‡Convención en el Juego de Manos‡Convención en el Juego de Manos‡Convention à l\'Abracadabar‡魔术旅馆的集会‡戲法旅舍的會議',
    nil,
    'Entregue 4 Ensopados do Norte preparados por você, com sua perícia em culinária, e uma Jarra de Vinho da queijaria de Dalaran para Arila Verlazúli no Saguão da Destreza, que fica na Praça Fiarruna, em Dalaran.‡Приготовьте 4 порции северной похлебки, возьмите кувшин с вином из сырной лавки в Даларане и отнесите все Ариллю Лазурному Взгляду в "Приют фокусника" на площади Руноплета.‡Bringt 4 nordische Eintöpfe, die Ihr selbst gekocht habt, und einen Krug Wein aus dem Käseladen in Dalaran zu Arille Azurblick im Zauberkasten auf dem Runenweberplatz in Dalaran.‡요리 기술로 만든 북극 스튜 4 그릇과 달라란에 있는 한 잔 더 상점에서 구한 포도주 단지를 요술쟁이 휴게실에 있는 아릴 아주어게이즈에게 가져가야 합니다. 요술쟁이 휴게실은 달라란에 있는 룬위버 광장에서 찾을 수 있습니다.‡Llévale 4 estofados del Norte que hayas cocinado gracias a tus habilidades culinarias y una jarra de vino de la quesería de Dalaran a Arrille Mirada Azur, del Salón Juego de Manos, que está en la Plaza Tejerruna de Dalaran.‡Llévale 4 estofados del Norte que hayas cocinado gracias a tus habilidades culinarias y una jarra de vino de la quesería de Dalaran a Arrille Mirada Azur, del Salón Juego de Manos, que está en la Plaza Tejerruna de Dalaran.‡Apportez 4 Ragoûts nordiques préparés avec votre compétence en cuisine et une Cruche de vin de la Fromagerie de Dalaran à Arille Mirazur, à l\'Abracadabar qui se trouve sur la Place Tisserune de Dalaran.‡将4份诺森德炖肉和从一壶达拉然的奶酪店中取来的葡萄酒带到达拉然的鲁因广场，交给魔术旅馆中的埃里雷。‡以你的烹飪技能作出4份北地燉肉，並從達拉然的起司店取走一壺葡萄酒，將其帶給戲法旅舍的艾立爾·蒼凝，就在達拉然的織符者廣場。',
  }
},
[13102] = {
  {
    'Ensopado esgotado‡Рагу для завсегдатаев Стоков‡Kanaleintopf‡하수도 전골‡Estofado de cloaca‡Estofado de cloaca‡Le ragoût des égouts‡下水道炖肉‡下水道燉菜',
    nil,
    'Cozinhe 4 Cenouras da Floresta do Canto Cristalino e 4 porções de Carne Gelada na Panela de Ensopado.|n|nQuando o Cozido Vegetariano ficar pronto, entregue-o para o estalajadeiro dos Esgotos de Dalaran, Hilton Pestana.‡Потушите 4 морковки из леса Хрустальной Песни с 4 кусками охлажденного мяса в кухонном горшке.|n|nКогда овощное рагу будет готово, отнесите его хозяину таверны Аджаю Грину в Стоки Даларана.‡Gebt 4 Kristallsangkarotten aus dem Kristallsangwald gemeinsam mit 4 Stück kühlem Fleisch in einen Kochtopf und lasst die Zutaten kochen.|n|nBringt den fertigen Gemüseeintopf anschließend zu Gastwirt Ajay Grün in die Kanalisation von Dalaran.‡수정노래 숲에서 수정노래 당근 4개를 구해 얼어붙은 고기 4덩이와 함께 요리 냄비로 요리하십시오.|n|n채소 전골이 준비되면 달라란 하수도에 있는 여관주인 아제이 그린에게 가져가야 합니다.‡Cocina 4 zanahorias Canto de Cristal del Bosque Canto de Cristal con 4 carnes frías en la olla.|n|nDespués llévale el estofado de verduras a Ajay Verde, el tabernero de las cloacas de Dalaran‡Cocina 4 zanahorias Canto de Cristal del Bosque Canto de Cristal con 4 carnes frías en la olla.|n|nDespués llévale el estofado de verduras a Ajay Verde, el tabernero de las cloacas de Dalaran.‡Cuisinez 4 Carottes du Chant de cristal de la Forêt du Chant de cristal avec 4 Viandes glacées dans la Marmite.|n|nUne fois qu\'il est prêt, apportez le Ragoût de légumes à Ajay Green, l\'Aubergiste des égouts de Dalaran.‡将4根采自晶歌森林的晶歌胡萝卜与4块冰冷的肉放在炖肉锅里进行烹饪。|n|n炖好之后，将萝卜炖肉交给达拉然下水道的旅店老板埃因·格林。‡在烹調鍋中，將產自水晶之歌森林的4支水晶之歌胡蘿蔔，與4份冷肉塊一起烹調。|n|n燉菜備齊以後，送去給達拉然下水道的旅店老闆，雅杰‧格林。',
  }
},
[13103] = {
  {
    'Queijo para Furiouro‡Сыр для Златоплава‡Käse für Leuchtegold‡글로우어골드에게 가져다 줄 치즈‡Queso para Frunceoro‡Queso para Frunceoro‡Du fromage pour Froncelor‡兰尼德的奶酪‡給怒金的起司',
    nil,
    'Sirva um Roquefort de Dalaran Curado da queijaria Desce a Saideira e 6 Taças de Vinho de Dalaran Meio Cheias tiradas das mesas da cidade na Bandeja de Queijo Vazia.|n|nEntregue a Bandeja de Queijo e Vinho para Rânido Furiouro, na Loja dos Coureiros, na Área Comercial Magus.‡Купите в сырной лавке "Еще по сто" зрелый даларанский камамбер, потом пройдитесь по Даларану и слейте в бутылку остатки вина из 6 полупустых бокалов, стоящих на столах. Поставьте то и другое на пустую сырную тарелку.|n|nОтнесите вино и сыр Раниду Златоплаву в кожевенную лавку в Торговой палате волшебников.‡Kombiniert die leere Käseplatte mit reifem Dalaranlimburger aus dem Käseladen "Noch ein Gläschen" und mit 6 halbvollen Dalaranweingläsern, die auf den Tischen in Dalaran gefunden werden können.|n|nBringt die Wein- und Käseplatte anschließend zu Ranid Leuchtegold im Lederladen auf dem Handelsmarkt der Magier.‡한 잔 더 상점에서 빈 치즈 접시에 숙성된 달라란 연치즈를 담고 달라란을 다니면서 탁자 위에서 반쯤 찬 달라란 포도주 잔 6개를 모으십시오.|n|n포도주와 치즈가 담긴 접시는 마법사 교역소의 가죽용품점에 있는 라니드 글로우어골드에게 가져가야 합니다.‡Combina la bandeja de queso vacía con el queso Limburger de Dalaran viejo de la quesería "Una Copa Más" con 6 copas de vino de Dalaran medio llenas de las mesas de Dalaran.|n|nLleva la bandeja de queso y vino a Ranid Frunceoro donde los curtidores en el Mercado de Magos.‡Combina la bandeja de queso vacía con el queso Limburger de Dalaran viejo de la quesería "Una Copa Más" con 6 copas de vino de Dalaran medio llenas de las mesas de Dalaran.|n|nLleva la bandeja de queso y vino a Ranid Frunceoro donde los curtidores en el Mercado de Magos.‡Combinez le Plateau à fromages avec un Vieux limbourg de Dalaran provenant de la fromagerie « Un dernier pour la route » et avec 6 Verres de vin à moitié pleins trouvés sur des tables à Dalaran.|n|nApportez le Plateau de vin et de fromages à Ranid Froncelor chez les Tanneurs de peaux à la Halle des mages.‡把空的奶酪盘、“再来一杯”奶酪店的陈年达拉然干酪、以及在达拉然的桌子上找到的6只半满的达拉然酒杯放在一起。|n|n将美酒和奶酪盘交给魔法商业区制皮店中的兰尼德·怒金。‡在空的起司盤上，放上『勸君更進一杯酒』取來的陳年達拉然濃起司，並從達拉然市中各處的桌上，收集6杯半滿的達拉然葡萄酒杯。|n|n將起司和葡萄酒帶給達拉然獸皮工店的拉尼德·怒金，店的位置在魔導師貿易區。',
  }
},
[13104] = {
  {
    'Mais uma vez, para a Brecha!‡И снова в Пролом‡Noch einmal in die Bresche, Held‡영웅이여, 다시 거대한 틈으로‡Una vez más en la brecha, héroe‡Una vez más en la brecha, héroe‡Encore une fois sur la Brèche, héros‡再次前往突破口吧，英雄‡重登止境吧，英雄',
    nil,
    'Apresente-se ao Vigia de Ébano no Vale dos Ecos, em frente à Brecha.‡Отправляйтесь в распоряжение черного хранителя в Долине Эха, рядом с Проломом.‡Meldet Euch beim Schwarzen Wächter im Tal der Echos gleich außerhalb der Bresche.‡거대한 틈 외곽에 있는 메아리 골짜기로 가서 칠흑의 감시자에게 보고해야 합니다.‡Preséntate ante el Vigía de Ébano en el Valle de los Ecos fuera de la Brecha.‡Preséntate ante el Vigía de Ébano en el Valle de los Ecos fuera de la Brecha.‡Présentez-vous au Gardien d\'ébène dans la Vallée des Échos, à l\'extérieur de la Brèche.‡前往回音谷，向突破口外面的黑锋观察者报到。‡向回聲山谷裡的黯黑看守者報到，就在止境之外。',
  }
},
[13105] = {
  {
    'Mais uma vez, para a Brecha!‡И снова в Пролом‡Noch einmal in die Bresche, Held‡영웅이여, 다시 거대한 틈으로‡Una vez más en la brecha, héroe‡Una vez más en la brecha, héroe‡Encore une fois sur la Brèche, héros‡再次前往突破口吧，英雄‡重登止境吧，英雄',
    nil,
    'Apresente-se ao Vigia de Ébano no Vale dos Ecos, em frente à Brecha.‡Поговорите с черным хранителем в Долине Эха у входа в Пролом.‡Meldet Euch beim Schwarzen Wächter im Tal der Echos gleich außerhalb der Bresche.‡거대한 틈 외곽에 있는 메아리 골짜기로 가서 칠흑의 감시자에게 보고해야 합니다.‡Preséntate ante el Vigía de Ébano en el Valle de los Ecos fuera de la Brecha.‡Preséntate ante el Vigía de Ébano en el Valle de los Ecos fuera de la Brecha.‡Présentez-vous au Gardien d\'ébène dans la Vallée des Échos, à l\'extérieur de la Brèche.‡前往回音谷，向突破口外面的黑锋观察者报到。‡向回聲山谷裡的黯黑看守者報到，就在止境之外。',
  }
},
[13106] = {
  {
    'Guarda Negra‡Черный дозор‡Die Schwarzwacht‡어둠의 감시초소‡La Guardia Negra‡La Guardia Negra‡Le Guet noir‡黑色观察站‡黑色守望',
    nil,
    'Fale com a Cavaleira das Trevas Arly na Guarda Negra, que fica na Coroa de Gelo.‡Поговорите с темной всадницей Арли в Черном дозоре, что в Ледяной Короне.‡Sprecht mit Dunkelreiterin Arly in der Schwarzwacht in Eiskrone.‡얼음왕관 어둠의 감시초소에서 어둠기수 알리와 대화해야 합니다.‡Habla con la jinete oscura Arly en La Guardia Negra, en Corona de Hielo.‡Habla con la jinete oscura Arly en La Guardia Negra, en Corona de Hielo.‡Parlez à la Cavalière noire Arly au Guet noir, dans la Couronne de glace.‡前往黑色观察站，与黑暗骑士阿尔蕾谈一谈。‡到寒冰皇冠的黑色守望和黑騎兵亞爾利談話。',
  }
},
[13107] = {
  {
    'Mostardos-quentes!‡Сосиски с горчицей!‡Senfwürstchen!‡겨자 듬뿍 핫도그!‡¡Perritos con mostaza!‡¡Perritos con mostaza!‡Hot-dogs à la moutarde !‡荠菜热狗！‡芥末熱狗!',
    nil,
    'Abasteça a Cesta de Piquenique Vazia com 4 Rinocerontes-quentes, preparados por você com sua perícia em culinária, e 4 Mostardas Selvagens colhidas dos gramados de Dalaran.|n|nEntregue a Cesta de Piquenique ao Arquimago Pentarus na Plataforma de Krasus, em Dalaran.‡Заполните пустую корзинку для пикника. Положите туда 4 сосиски из мяса люторога, которые вы приготовите сами, и 4 побега полевой горчицы, которая растет на зеленых участках в черте Даларана.|n|nОтнесите корзинку для пикника верховному магу Пентарусу на площадку Краса в Даларане.‡Füllt den leeren Picknickkorb mit 4 Rhinowürstchen, die Ihr selbst gekocht habt, und 4 Zweigen wilden Senfs, der in den grasbewachsenen Bereichen der Stadt zu finden ist.|n|nBringt den Picknickkorb anschließend zu Erzmagier Pentarus bei Krasus\' Landeplatz in Dalaran.‡요리 기술로 만든 코뿔소 핫도그 4개와 달라란 잔디밭에서 찾은 야생 겨자 4뿌리를 빈 소풍 바구니에 담아 달라란의 크라서스 착륙장에 있는 대마법사 펜타루스에게 가져가야 합니다.‡Llena la cesta de picnic con 4 perritos de rinoceronte que cocines con tu habilidad de cocina y con 4 mostaza silvestre que encontrarás en las zonas verdes de Dalaran.|n|nLlévale la cesta de picnic al archimago Pentarus en el Alto de Krasus, en Dalaran.‡Llena la cesta de picnic con 4 perritos de rinoceronte que cocines con tu habilidad de cocina y con 4 mostaza silvestre que encontrarás en las zonas verdes de Dalaran.|n|nLlévale la cesta de picnic al archimago Pentarus en el Alto de Krasus, en Dalaran.‡Remplissez le Panier à pique-nique vide avec 4 Saucisses de rhinocéros que vous aurez cuisinées avec votre compétence en cuisine et 4 Moutardes sauvages que vous trouverez dans les zones herbeuses de Dalaran.|n|nApportez le Panier à pique-nique à l\'Archimage Pentarus à l\'Aire de Krasus à Dalaran.‡在空午餐篮里装入你烹制的4份犀牛热狗，外加你在达拉然草地上找到的4片野芥菜。|n|n将芥菜热狗篮交给达拉然城克拉苏斯平台的大法师伯塔鲁斯。‡以烹飪技能調理4份犀牛熱狗，並自達拉然市內的綠地採來4份野生芥末，都放進空的野餐籃。|n|n然後將野餐籃送去給達拉然市內，卡薩斯平臺的大法師潘塔魯斯。',
  }
},
[13108] = {
  {
    'Custe o que custar!‡Любой ценой!‡Koste es, was es wolle!‡무슨 일이 있어도!‡¡Lo que haga falta!‡¡Lo que haga falta!‡Quoi qu\'il en coûte !‡不惜代价！‡不擇手段!',
    nil,
    'O Rei Iokkum, em Dun Niffelem, quer que você adentre os Salões Relampejantes e derrote Loken. Depois, de posse da Língua de Loken, fale com o Rei Iokkum.‡Отправляйтесь в Чертоги Молний и убейте Локена. Потом возвращайтесь к королю Йоккуму в Дун Ниффелем и отдайте ему язык Локена.‡König Jokkum in Dun Niffelem wünscht, dass Ihr die Hallen der Blitze betretet und Loken besiegt. Danach sollt Ihr mit Lokens Zunge zu König Jokkum zurückkehren.‡던 니펠렘에 있는 제왕 요쿰이 번개의 전당으로 가서 로켄을 처치한 다음 로켄의 파편을 가지고 돌아오라고 했습니다.‡El rey Jokkum en Dun Niffelem quiere que entres en las Cámaras de Relámpagos y derrotes a Loken. Después llévale al rey Jokkum la lengua de Loken.‡El rey Jokkum en Dun Niffelem quiere que entres en las Cámaras de Relámpagos y derrotes a Loken. Después llévale al rey Jokkum la lengua de Loken.‡Le Roi Jokkum à Dun Niffelem vous demande de pénétrer dans les Salles de Foudre et de battre Loken. Vous devez ensuite retournez voir le Roi Jokkum avec la Langue de Loken.‡丹尼芬雷的约库姆国王要你进入闪电大厅并击败洛肯，然后将洛肯的信物带回去给他。‡丹尼弗蘭的裘庫姆王要求你，進入雷光大廳並擊敗洛肯。帶回洛肯之舌給裘庫姆。',
  }
},
[13109] = {
  {
    'Diametralmente opostos‡Диаметральные противоположности‡Diametral entgegengesetzt‡완전히 정반대‡Diametralmente opuesto‡Diametralmente opuesto‡Diamétralement opposé‡势不两立‡一山容不得二虎',
    nil,
    'O Rei Iokkum, em Dun Niffelem, quer que você penetre nos Salões Relampejantes e derrote Volkhan.‡Отправляйтесь в Чертоги Молний и убейте Волхана по поручению короля Йоккума из Дун Ниффелема.‡König Jokkum in Dun Niffelem wünscht, dass Ihr die Hallen der Blitze betretet und Volkhan besiegt.‡던 니펠렘에 있는 제왕 요쿰이 번개의 전당에 가서 볼칸을 처치하라고 했습니다.‡El rey Jokkum en Dun Niffelem quiere que entres en las Cámaras de Relámpagos y derrotes a Volkhan.‡El rey Jokkum en Dun Niffelem quiere que entres en las Cámaras de Relámpagos y derrotes a Volkhan.‡Le Roi Jokkum à Dun Niffelem vous demande de pénétrer dans les Salles de Foudre et de battre Volkhan.‡丹尼芬雷的约库姆国王要你进入闪电大厅，击败沃尔坎。‡丹尼弗蘭的裘庫姆王要求你，前往雷光大廳，並擊敗渥克瀚。',
  }
},
[13110] = {
  {
    'Os mortos inquietos‡Неупокоенные‡Die rastlosen Toten‡안식 없는 죽음‡Los muertos sin descanso‡Los muertos sin descanso‡Les morts sans repos‡永不安息的亡者‡死不瞑目',
    nil,
    'O Padre Gustav, no Vale dos Ecos, que fica na Coroa de Gelo, quer que você use Água Benta nos cadáveres dos Cruzados Reanimados para libertar 10 Almas Inquietas.‡По поручению отца Густава из Долины Эха в Ледяной Короне окропите кости 10 оживленных рыцарей святой водой, чтобы освободить наконец их неупокоенные души.‡Vater Gustav im Tal der Echos in Eiskrone möchte, dass Ihr die Überreste von wiedererweckten Kreuzfahrern mit Weihwasser benetzt, um 10 ruhelose Seelen zu befreien.‡얼음왕관의 메아리 골짜기에 있는 신부 구스타프가 되살아난 성전사 시체에 성수를 뿌리고 10명의 잠 못 드는 영혼을 자유롭게 해달라고 했습니다.‡El padre Gustav del Valle de los Ecos en Corona de Hielo quiere que uses agua bendita sobre los cadáveres de Cruzados reanimados para liberar 10 espíritus inquietos.‡El padre Gustav del Valle de los Ecos en Corona de Hielo quiere que uses agua bendita sobre los cadáveres de Cruzados reanimados para liberar 10 espíritus inquietos.‡Le Père Gustav, de la Vallée des Échos dans la Couronne de glace, vous demande d\'utiliser de l\'Eau bénite sur les cadavres des Croisés réanimés afin de libérer 10 Âmes sans repos.‡冰冠冰川回音谷的古斯塔夫神父要你对复活的北伐军战士的尸体使用圣水，解放10个永不安息的灵魂。‡在回聲山谷的賈斯塔夫神父要求你，在再活化的十字軍屍體上使用聖水，以解救10個不能安息的靈魂。',
  }
},
[13111] = {
  {
    'Um tipo único‡Единственный в своем роде‡Einzigartig‡단 하나뿐인 것‡Único‡Único‡Unique en son genre‡独一无二‡獨一無二',
    nil,
    'A Cronista Bah\'Kini, em Dubra\'Jin, quer que você entre em Gundrak para obter uma parte do Colosso Drakkari.‡Отправляйтесь в Гундрак, добудьте обломок колосса Драккари и отнесите его летописцу Ба\'Кини в Дубра\'джин.‡Chronistin Bah\'Kini in Dubra\'Jin möchte, dass Ihr nach Gundrak geht und ein Fragment des Kolosses der Drakkari beschafft.‡두브라진에 있는 기록가 바키니가 군드락으로 들어가 드라카리 거대골렘 조각을 가져오라고 했습니다.‡La cronista Bah\'Kini en Dubra\'Jin quiere que entres en Gundrak y recuperes un trozo del coloso Drakkari.‡La cronista Bah\'Kini en Dubra\'Jin quiere que entres en Gundrak y recuperes un trozo del coloso Drakkari.‡La Chroniqueuse Bah\'Kini à Dubra\'Jin vous demande d\'entrer à Gundrak et de récupérer un morceau de Colosse drakkari.‡杜布拉金的记载者拜基妮要你进入古达克，获取一块达卡莱巨像的碎片。‡杜布拉金的撰史者巴琪妮要求你，進入剛德拉克，並撿回一塊德拉克瑞巨像的碎片。',
  }
},
[13112] = {
  {
    'Bolo de Carne de Cogumelo Infuso‡Мясной рулет в странногрибном соусе‡Energieerfüllter Pilzhackbraten‡버섯 풍미 고기구이‡Pastel de carne de champiñones imbuidos‡Pastel de carne de champiñones imbuidos‡Pain de viande aux champignons infusés‡魔法蘑菇肉片‡灌能蘑菇肉糕',
    nil,
    'Use a Fôrma de Bolo de Carne para cozinhar 4 Cogumelos Infusos e 2 porções de Carne Gelada. Em seguida, entregue o Bolo de Carne para Otávio Adeleiro, na Casa dos Bricabraques, que fica na Praça Fiarruna, em Dalaran.‡Сварите 4 странных гриба из Стоков Даларана и 2 куска охлажденного мяса, чтобы получить мясной рулет, и отнесите готовое блюдо Ортону Беннету в лавку "Диковины и редкости" на площадь Руноплета в Даларане.‡Benutzt Eure Bratenform, um aus 4 energieerfüllten Pilzen aus der Kanalisation von Dalaran und 2 Stück kühlem Fleisch einen Pilzhackbraten herzustellen und bringt das Resultat zu Orton Bennet bei Kuriositäten & Meer auf dem Runenweberplatz in Dalaran.‡고기구이 냄비로 마력 깃든 버섯 4개와 얼어붙은 고기 2덩이를 함께 요리한 다음, 만들어진 버섯 풍미 고기구이를 무어의 골동품점에 있는 오르톤 베네트에게 가져가야 합니다. 무어의 골동품점은 달라란의 룬위버 광장에 있습니다.‡Usa tu molde de pastel de carne para cocinar 4 champiñones imbuidos con 2 carnes frías. Cuando esté hecho el pastel, llévaselo a Orton Bennet de Curiosidades y Más, en la Plaza Tejerruna de Dalaran.‡Usa tu molde de pastel de carne para cocinar 4 champiñones imbuidos con 2 carnes frías. Cuando esté hecho el pastel, llévaselo a Orton Bennet de Curiosidades y Más, en la Plaza Tejerruna de Dalaran.‡Cuisinez 4 Champignons infusés des égouts de Dalaran avec 2 Viandes glacées dans votre Plat à pain de viande et apportez le Pain de viande aux champignons à Orton Bennet, aux Objets de la Moore situé sur la Place Tisserune à Dalaran.‡将2块冰冷的肉和采自达拉然下水道的4枚魔法蘑菇放在你的煎肉锅中，烹制成一份魔法蘑菇肉片，然后将其带到达拉然的鲁因广场，交给摩尔珍品店中的奥尔顿·本内特。‡使用你的肉糕鍋，用4朵長在達拉然下水道的灌能蘑菇和2份冷肉塊煮出灌能蘑菇肉糕，然後送去給『不只是配件』的歐爾頓·班尼特，就在達拉然的織符者廣場。',
  }
},
[13113] = {
  {
    'Convenção no Saguão da Destreza‡Сбор в Приюте фокусника‡Versammlung im Zauberkasten‡요술쟁이 휴게실 모임‡Convención en el Juego de Manos‡Convención en el Juego de Manos‡Convention à l\'Abracadabar‡魔术旅馆的集会‡戲法旅舍的會議',
    nil,
    'Entregue 4 Ensopados do Norte e uma Jarra de Vinho da queijaria de Dalaran para Arila Verlazúli no Saguão da Destreza, que fica na Praça Fiarruna, em Dalaran.‡Приготовьте 4 порции северной похлебки, возьмите кувшин с вином из сырной лавки в Даларане и отнесите все Ариллю Лазурному Взгляду в "Приют фокусника" на площади Руноплета.‡Bringt 4 nordische Eintöpfe und einen Krug Wein aus dem Käseladen in Dalaran zu Arille Azurblick im Zauberkasten auf dem Runenweberplatz in Dalaran.‡북극 스튜 4 그릇과 달라란에 있는 한 잔 더 상점에서 구한 포도주 단지를 요술쟁이 휴게실에 있는 아릴 아주어게이즈에게 가져가야 합니다. 요술쟁이 휴게실은 달라란에 있는 룬위버 광장에서 찾을 수 있습니다.‡Llévale 4 estofados del Norte y una jarra de vino de la quesería de Dalaran a Arille Mirada Azur, del Salón Juego de Manos, que está en la Plaza Tejerruna de Dalaran.‡Llévale 4 estofados del Norte y una jarra de vino de la quesería de Dalaran a Arille Mirada Azur, del Salón Juego de Manos, que está en la Plaza Tejerruna de Dalaran.‡Apportez 4 Ragoûts nordiques et une Cruche de vin de la Fromagerie de Dalaran à Arille Mirazur à l\'Abracadabar sur la Place Tisserune à Dalaran.‡将4份诺森德炖肉和从一壶达拉然的奶酪店中取来的葡萄酒带到达拉然的鲁因广场，交给魔术旅馆中的埃里雷。‡將4份北地燉肉與從達拉然的起司店取走的一壺葡萄酒，帶給戲法旅舍的艾立爾·蒼凝，就在達拉然的織符者廣場。',
  }
},
[13114] = {
  {
    'Ensopado esgotado‡Рагу для завсегдатаев Стоков‡Kanaleintopf‡하수도 전골‡Estofado de cloaca‡Estofado de cloaca‡Le ragoût des égouts‡下水道炖肉‡下水道燉菜',
    nil,
    'Cozinhe 4 Cenouras do Canto Cristalino da Floresta do Canto Cristalino com 4 porções de Carne Gelada na Panela de Ensopado.|n|nQuando o Cozido Vegetariano ficar pronto, entregue-o para o estalajadeiro dos Esgotos de Dalaran, Hilton Pestana.‡Потушите 4 морковки из леса Хрустальной Песни с 4 кусками охлажденного мяса в кухонном горшке.|n|nПотом отнесите овощное рагу хозяину таверны Аджаю Грину в Стоки Даларана.‡Gebt 4 Kristallsangkarotten aus dem Kristallsangwald gemeinsam mit 4 Stück kühlem Fleisch in einen Kochtopf und lasst die Zutaten kochen.|n|nBringt den Gemüseeintopf anschließend zu Gastwirt Ajay Grün in die Kanalisation von Dalaran.‡수정노래 숲에서 수정노래 당근 4개를 구해 얼어붙은 고기 4덩이와 함께 요리 단지로 요리하십시오.|n|n채소 전골이 준비되면 달라란 하수도에 있는 여관 주인 아제이 그린에게 가져가야 합니다.‡Cocina 4 zanahorias Canto de Cristal del Bosque Canto de Cristal con 4 carnes frías en la olla.|n|nDespués llévale el estofado de verduras a Ajay Verde, el tabernero de las cloacas de Dalaran‡Cocina 4 zanahorias Canto de Cristal del Bosque Canto de Cristal con 4 carnes frías en la olla.|n|nDespués llévale el estofado de verduras a Ajay Verde, el tabernero de las cloacas de Dalaran.‡Cuisinez 4 Carottes du Chant de cristal de la Forêt du Chant de cristal avec 4 Viandes glacées dans la Marmite.|n|nPuis apportez le Ragoût de légumes à Ajay Green, l\'Aubergiste des égouts de Dalaran.‡将4根采自晶歌森林的晶歌胡萝卜与4块冰冷的肉放在炖肉锅里进行烹饪。|n|n炖好之后，将萝卜炖肉交给达拉然下水道的旅店老板埃因·格林。‡在烹調鍋中，將產自水晶之歌森林的4根水晶之歌胡蘿蔔，與4份冷肉塊一起烹調。|n|n燉菜煮好以後，送去給達拉然下水道的旅店老闆，雅杰‧格林。',
  }
},
[13115] = {
  {
    'Queijo para Furiouro‡Сыр для Златоплава‡Käse für Leuchtegold‡글로우어골드에게 가져다 줄 치즈‡Queso para Frunceoro‡Queso para Frunceoro‡Du fromage pour Froncelor‡兰尼德的奶酪‡給怒金的起司',
    nil,
    'Sirva um Roquefort de Dalaran Curado da queijaria Desce a Saideira e 6 Taças de Vinho de Dalaran Meio Cheias tiradas das mesas da cidade na Bandeja de Queijo Vazia.|n|nEntregue a Bandeja de Queijo e Vinho para Rânido Furiouro, na Loja dos Coureiros, na Área Comercial Magus.‡Купите в сырной лавке "Еще по сто" зрелый даларанский камамбер, потом пройдитесь по Даларану и слейте в бутылку остатки вина из 6 полупустых бокалов, стоящих на столах. Поставьте то и другое на пустую сырную тарелку.|n|nОтнесите вино и сыр Раниду Златоплаву в кожевенную лавку в Торговой палате волшебников.‡Kombiniert die leere Käseplatte mit reifem Dalaranlimburger aus dem Käseladen "Noch ein Gläschen" und mit 6 halbvollen Dalaranweingläsern, die auf den Tischen in Dalaran gefunden werden können.|n|nBringt die Wein- und Käseplatte anschließend zu Ranid Leuchtegold im Lederladen auf dem Handelsmarkt der Magier.‡한 잔 더 상점에서 빈 치즈 접시에 숙성된 달라란 연치즈를 담고 달라란을 다니면서 탁자 위에서 반쯤 찬 달라란 포도주 잔 6개를 모으십시오.|n|n포도주와 치즈가 담긴 접시는 마법사 교역소의 가죽용품점에 있는 라니드 글로우어골드에게 가져가야 합니다.‡Combina la bandeja de queso vacía con el queso Limburger de Dalaran viejo de la quesería "Una Copa Más" y con 6 copas de vino medio llenas de las mesas de Dalaran.|n|nLleva la bandeja de queso y vino a Ranid Frunceoro donde los curtidores en el Mercado de Magos.‡Combina la bandeja de queso vacía con el queso Limburger de Dalaran viejo de la quesería "Una Copa Más" con 6 copas de vino de Dalaran medio llenas de las mesas de Dalaran.|n|nLleva la bandeja de queso y vino a Ranid Frunceoro donde los curtidores en el Mercado de Magos.‡Combinez le Plateau à fromages avec un Vieux limbourg de Dalaran provenant de la fromagerie « Un dernier pour la route » et avec 6 Verres de vin à moitié pleins trouvés sur des tables à Dalaran.|n|nApportez le Plateau de vin et de fromages à Ranid Froncelor chez les Tanneurs de peaux à la Halle des mages.‡把空的奶酪盘、“再来一杯”奶酪店的陈年达拉然干酪、以及在达拉然的桌子上找到的6只半满的达拉然酒杯放在一起。|n|n将美酒和奶酪盘交给魔法商业区制皮店中的兰尼德·怒金。‡在空的起司盤上，放上『勸君更進一杯酒』取來的陳年達拉然濃起司，並從達拉然市中各處的桌上，收集6杯半滿的達拉然葡萄酒杯。|n|n將起司和葡萄酒帶給達拉然獸皮工店的拉尼德·怒金，店的位置在魔導師貿易區。',
  }
},
[13116] = {
  {
    'Mostardos-quentes!‡Сосиски с горчицей!‡Senfwürstchen!‡겨자 듬뿍 핫도그!‡¡Perritos con mostaza!‡¡Perritos con mostaza!‡Hot-dogs à la moutarde !‡荠菜热狗！‡芥末熱狗!',
    nil,
    'Abasteça a Cesta de Piquenique Vazia com 4 Rinocerontes-quentes, preparados por você com sua perícia em culinária, e 4 Mostardas Selvagens colhidas dos gramados de Dalaran.|n|nEntregue a Cesta de Piquenique para o Arquimago Pentarus na Plataforma de Krasus, em Dalaran.‡Заполните пустую корзинку для пикника. Положите туда 4 сосиски из мяса люторога, которые вы приготовите сами, и 4 побега полевой горчицы, которая растет на зеленых участках в черте Даларана.|n|nОтнесите корзинку для пикника верховному магу Пентарусу на площадку Краса в Даларане.‡Füllt den leeren Picknickkorb mit 4 selbstgekochten Rhinowürstchen und 4 Zweigen wilden Senfs, der in den grasbewachsenen Bereichen der Stadt zu finden ist.|n|nBringt den Picknickkorb anschließend zu Erzmagier Pentarus bei Krasus\' Landeplatz in Dalaran.‡요리 기술로 만든 코뿔소 핫도그 4개와 달라란 잔디밭에서 찾은 야생 겨자 4뿌리를 빈 소풍 바구니에 담아 달라란의 크라서스 착륙장에 있는 대마법사 펜타루스에게 가져가야 합니다.‡Llena la cesta de picnic con 4 perritos de rinoceronte que cocines con tu habilidad de cocina y con 4 mostaza silvestre que encuentres en las zonas verdes de Dalaran.|n|nLlévale la cesta de picnic al archimago Pentarus en el Alto de Krasus, en Dalaran.‡Llena la cesta de picnic con 4 perritos de rinoceronte que cocines con tu habilidad de cocina y con 4 mostaza silvestre que encuentres en las zonas verdes de Dalaran.|n|nLlévale la cesta de picnic al archimago Pentarus en el Alto de Krasus, en Dalaran.‡Remplissez le Panier à pique-nique vide avec 4 Saucisses de rhinocéros que vous avez cuisinées avec votre compétence et 4 Moutardes sauvages que vous trouverez dans les zones herbeuses de Dalaran.|n|nApportez le Panier à pique-nique à l\'Archimage Pentarus à l\'Aire de Krasus à Dalaran.‡在空午餐篮里装入你烹制的4份犀牛热狗，外加你在达拉然草地上找到的4片野芥菜。|n|n将芥菜热狗篮交给达拉然城克拉苏斯平台的大法师伯塔鲁斯。‡以烹飪技能調理4份犀牛熱狗，並自達拉然市內的綠地採來4份野生芥末，都放進空的野餐籃。|n|n然後將野餐籃送去給達拉然市內，卡薩斯平臺的大法師潘塔魯斯。',
  }
},
[13117] = {
  {
    'De onde vêm eles?‡Откуда они берутся?‡Wo kommen sie her?‡도대체 어디서 왔을까?‡¿De dónde vienen?‡¿De dónde vienen?‡D\'où viennent-ils ?‡它们从哪儿来的？‡他們打哪來的?',
    nil,
    'Investigue um Altar de Evocação na parte leste da Usina de Carne e, em seguida, apresente-se novamente à Cavaleira das Trevas Arly, na Guarda Negra.‡Проведите разведку у алтаря призыва в восточной части Мясопилки и возвращайтесь с докладом к темной всаднице Арли, которая ждет вас в Черном дозоре.‡Untersucht einen Beschwörungsaltar im östlichen Teil der Fleischwerke und berichtet dann Dunkelreiterin Arly bei der Schwarzwacht davon.‡살덩이작업장의 동쪽에 있는 소환의 제단을 조사한 후, 어둠의 감시초소로 돌아가 어둠기수 알리에게 보고해야 합니다.‡Investiga un altar de invocación en la parte oriental de La Factoría de Carne, después vuelve e informa a la jinete oscura Arly en La Guardia Negra.‡Investiga un altar de invocación en la parte oriental de La Factoría de Carne, después vuelve e informa a la jinete oscura Arly en La Guardia Negra.‡Enquêtez sur un Autel d\'invocation dans la zone est de la Charognerie, puis retournez faire votre rapport à la Cavalière noire Arly au Guet noir.‡调查缝合场东部的召唤祭坛，然后返回黑色观察站，向黑暗骑士阿尔蕾汇报情况。‡調查血肉作坊東南方的召喚祭壇，然後向黑色守望的黑騎兵亞爾利回報。',
  }
},
[13118] = {
  {
    'A purgação do Forte do Flagelo‡Очищение Плетхольма‡Die Reinigung von Geißelholme‡스컬지홀름 정화‡La purga de la Ciudad de la Plaga‡La purga de la Ciudad de la Plaga‡La purification de Fléaulme‡净化天灾城‡對天譴岸地的淨化',
    nil,
    'O Vigia de Ébano, no Vale dos Ecos, que fica na Coroa de Gelo, quer que você mate 3 Sumos Sacerdotes das Profundezas Abandonadas, 3 Hipomonarcas das Profundezas Abandonadas e 8 Cruzados Reanimados.‡По заданию черного хранителя из Долины Эха в Ледяной Короне уничтожьте 3 верховных жрецов Забытых глубин, 3 королей Забытых глубин и 8 оживленных рыцарей.‡Der Schwarze Wächter im Tal der Echos möchte, dass Ihr 3 Hohepriester der Vergessenen Tiefen, 3 Unterkönige der Vergessenen Tiefen und 8 wiedererweckte Kreuzfahrer tötet.‡얼음왕관의 메아리 골짜기에 있는 칠흑의 감시자가 망각의 심연 대사제 3명과 망각의 심연 악마왕 3명과 되살아난 성전사 8명을 처치해 달라고 했습니다.‡El Vigía de Ébano en el Valle de los Ecos en Corona de Hielo quiere que mates a 3 sumos sacerdotes de Las Profundidades Olvidadas, 3 infrarreyes de Las Profundidades Olvidadas y a 8 Cruzados reanimados.‡El Vigía de Ébano en el Valle de los Ecos en Corona de Hielo quiere que mates a 3 sumos sacerdotes de Las Profundidades Olvidadas, 3 infrarreyes de Las Profundidades Olvidadas y a 8 Cruzados reanimados.‡Le Gardien d\'ébène, de la Vallée des Échos dans la Couronne de glace, vous demande de tuer 3 Grands prêtres des profondeurs oubliées, 3 Sous-rois des profondeurs oubliées et 8 Croisés réanimés.‡冰冠冰川回音谷的黑锋观察者要你去杀死3名遗忘深渊高阶祭司、3只遗忘深渊虫王和8名复活的北伐军战士。‡在寒冰皇冠，回聲山谷的黯黑看守者要求你，殺掉3名遺忘深淵高階祭師、3名遺忘深淵地底王、還有8名再活化的十字軍。',
  }
},
[13119] = {
  {
    'A destruição dos altares‡Разрушение алтарей‡Zerstört die Altäre‡제단 파괴‡Destruir los altares‡Destruir los altares‡Détruire les autels‡摧毁祭坛‡摧毀祭壇',
    nil,
    'Mate o Mestre-evocador Zarod e use o Cajado do Evocador Mestre para destruir o Primeiro, o Segundo, o Terceiro e o Quarto Altares de Evocação. Quando terminar a tarefa, apresente-se à Cavaleira das Trevas Arly, na Guarda Negra.‡Убейте главного призывателя Зарода и используйте его посох призыва, чтобы уничтожить первый, второй, третий и четвертый алтари призыва. Когда все будет сделано, возвращайтесь к темной всаднице Арли в Черный дозор.‡Tötet Meisterbeschwörer Zarod und benutzt seinen Beschwörerstab, um den ersten, zweiten, dritten und vierten Beschwörungsaltar zu zerstören. Habt Ihr diese Aufgabe erledigt, kehrt zu Dunkelreiterin Arly bei der Scharzwacht zurück.‡대소환사 자로드를 처치하고 대소환사 지팡이를 이용하여 첫 번째, 두 번째, 세 번째, 네 번째 소환의 제단을 파괴한 후 어둠의 감시초소에 있는 어둠기수 알리에게 보고해야 합니다.‡Mata al maestro invocador Zarod y usa su bastón de invocación para destruir el primer, segundo, tercer y cuarto altar de invocación. Cuando hayas completado esta tarea, preséntate ante la jinete oscura Arly en La Guardia Negra.‡Mata al maestro invocador Zarod y usa su bastón de invocación para destruir el primer, segundo, tercer y cuarto altar de invocación. Cuando hayas completado esta tarea, preséntate ante la jinete oscura Arly en La Guardia Negra.‡Tuez le Maître invocateur Zarod et utilisez son Bâton d\'invocation pour détruire le Premier autel d\'invocation, le Deuxième autel d\'invocation, le Troisième autel d\'invocation et le Quatrième autel d\'invocation. Une fois la tâche terminée, retournez voir la Cavalière noire Arly au Guet noir.‡杀死召唤大师扎洛德，用他的法杖摧毁第一座、第二座、第三座和第四座召唤祭坛。完成任务后返回黑色观察站，向黑暗骑士阿尔蕾复命。‡殺掉召喚大師札洛德，並使用他的召喚法杖摧毀四座召喚祭壇。完成之後，回到黑色守望，向黑騎兵亞爾利回報。',
  }
},
[13120] = {
  {
    'O olhar da morte‡Взгляд смерти‡Todesblick‡사신의 응시‡La mirada de la Muerte‡La mirada de la Muerte‡Le regard de la mort‡死亡的凝视‡死亡凝視',
    nil,
    'Use o Orbe Olhar da Morte para colocar orbes no Apoio de Orbe do Laboratório de Abominação, no Apoio de Orbe do Laboratório de Gigante de Carne e no Apoio de Orbe da Área do Caldeirão. Em seguida, fale novamente com a Cavaleira das Trevas Arly, na Guarda Negra.‡Разместите сферу взгляда смерти на стойке у лаборатории поганищ, стойке у лаборатории мясистых великанов и стойке в окрестностях котла. Когда все будет готово, возвращайтесь к темной всаднице Арли в Черный дозор.‡Benutzt die Kugel des Todesblicks, um Kugeln in die Kugelhalterung des Monstrositätenlabors, des Fleischriesenlabors und des Kesselbereichs zu legen. Kehrt anschließend zu Dunkelreiterin Arly in die Schwarzwacht zurück.‡사신의 응시 수정구를 누더기골렘 실험실 수정구 받침대, 살덩이거인 실험실 수정구 받침대, 가마솥 지역 수정구 받침대에 놓은 다음 어둠의 감시초소에 있는 어둠기수 알리에게 가야 합니다.‡Usa el orbe de mirada de la Muerte para colocar orbes sobre el portaorbe de laboratorio de abominaciones, el portaorbe del laboratorio de gigantes de carne y en el portaorbe de la zona de la caldera y después vuelve con la jinete oscura Arly en La Guardia Negra.‡Usa el orbe de mirada de la Muerte para colocar orbes sobre el portaorbe de laboratorio de abominaciones, el portaorbe del laboratorio de gigantes de carne y en el portaorbe de la zona de la caldera y después vuelve con la jinete oscura Arly en La Guardia Negra.‡Utilisez l\'Orbe du regard de la mort pour placer des orbes sur le Socle de l\'orbe du laboratoire des abominations, sur le Socle de l\'orbe du laboratoire des géants de chair et sur le Socle de l\'orbe de la zone du chaudron, puis retournez voir la Cavalière noire Arly au Guet noir.‡使用死亡凝视宝珠，将宝珠放置在憎恶装配台宝珠支架、血肉巨人装配台宝珠支架和天灾之锅区域宝珠支架上，然后返回黑色观察站，向黑暗骑士阿尔蕾复命。‡將死亡凝視寶珠安置於憎惡體實驗室寶珠座、血肉巨人實驗室寶珠座和熔爐區寶珠座，然後回黑色守望向黑騎兵亞爾利回報。',
  }
},
[13121] = {
  {
    'Através do olho‡Чужими глазами‡Durch das Innere Auge‡리치 왕의 눈으로‡A través del ojo‡A través del ojo‡À travers l\'Œil‡巫妖王之眼‡透過另一隻眼',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você use o Olho do Lich Rei para obter informações.‡По просьбе костяной ведьмы из деревни Ньорндар добудьте информацию о противнике с помощью Ока Короля-лича.‡Die Knochenhexe in Njorndar hat Euch beauftragt, das Auge des Lichkönigs zu benutzen, um an Informationen zu gelangen.‡요른다르 마을에 있는 해골 마녀가 리치 왕의 눈을 사용하여 정보를 알아내 달라고 했습니다.‡La Bruja Osaria en el poblado Njorndar te ha encargado que uses el Ojo del Rey Exánime para conseguir información.‡La Bruja Osaria en el poblado Njorndar te ha encargado que uses el Ojo del Rey Exánime para conseguir información.‡La Sorcière des ossements, à Njorndar, vous a demandé d\'utiliser l\'Œil du roi-liche pour obtenir des informations.‡约尔达村的白骨女巫要你使用巫妖王之眼获取情报。‡尼約達村的骸骨女巫賦予你新的任務，要利用巫妖王之眼收集情報。',
  }
},
[13122] = {
  {
    'A Pedra do Flagelo‡Камень Плети‡Der Geißelstein‡스컬지석‡La piedra de la Plaga‡La piedra de la Plaga‡La pierre du Fléau‡天灾石‡天譴石',
    nil,
    'O Vigia de Ébano, no Vale dos Ecos, que fica na Coroa de Gelo, quer que você lhe traga 15 Pedras do Flagelo.‡Принесите черному хранителю из Долины Эха в Ледяной Короне 15 камней Плети.‡Der Schwarze Wächter im Tal der Echos möchte, dass Ihr ihm 15 Geißelsteine bringt.‡얼음왕관의 메아리 골짜기에 있는 칠흑의 감시자에게 스컬지석 15개를 가져가야 합니다.‡El Vigía de Ébano en el Valle de los Ecos en Corona de Hielo quiere que le lleves 15 piedras de la Plaga.‡El Vigía de Ébano en el Valle de los Ecos en Corona de Hielo quiere que le lleves 15 piedras de la Plaga.‡Le Gardien d\'ébène, de la Vallée des Échos dans la Couronne de glace, vous a demandé de lui apporter 15 Pierres du Fléau.‡将15块天灾石交给冰冠冰川回音谷的黑锋观察者。‡在寒冰皇冠，回聲山谷裡的黯黑看守者要你帶回15個天譴石給他。',
  }
},
[13123] = {
  {
    '‡‡‡소장판‡‡‡‡‡',
    nil,
    nil,
  }
},
[13124] = {
  {
    'O esforço perdura‡И вновь продолжается бой‡Der Kampf geht weiter‡계속되는 싸움‡La batalla continúa‡La batalla continúa‡La lutte continue‡战斗仍在继续‡負隅頑抗',
    nil,
    'Raelorasz quer que você entre no Óculus e resgate Belgaristrasz e seus companheiros.‡Релораз просит вас войти в Окулус и спасти Белгаристраза с его командой.‡Raelorasz möchte, dass Ihr Belgaristrasz und seine Gefährten aus dem Oculus befreit.‡라엘로라즈가 마력의 눈에 있는 벨가리스트라즈와 그 동료를 구해 달라고 했습니다.‡Raelorasz quiere que entres en El Oculus y que rescates a Belgaristrasz y a sus compañeros.‡Raelorasz quiere que entres en El Oculus y que rescates a Belgaristrasz y a sus compañeros.‡Raelorasz veut que vous sauviez Belgaristrasz et ses compagnons dans l’Oculus.‡莱洛拉斯希望你进入魔环，营救贝加里斯塔兹与他的同伴。‡瑞洛拉茲要你去奧核之眼並解救貝加瑞斯塔茲與他的同伴。',
  }
},
[13125] = {
  {
    'Silêncio no forte‡Чистое небо‡Die Luft steht still‡오늘만큼은 평화‡El aire permanece quieto‡El aire permanece quieto‡L\'air est immobile‡凝固的空气‡空氣也為之凍結',
    nil,
    'O Vigia de Ébano, no Vale dos Ecos, que fica na Coroa de Gelo, quer que você mate Salranax, o Lacerador de Carnes, o Hipomonarca Talonox e o Sumo Sacerdote Yath\'amon.‡По заданию черного хранителя из Долины Эха в Ледяной Короне убейте Салнаракса Резчика, короля подземелий Талонокса и верховного жреца Ят\'амона.‡Der Schwarze Wächter beim Tal der Echos in Eiskrone will, dass Ihr Salranax den Zerfleischer, Unterkönig Talonox und Hohepriester Yath\'amon tötet.‡얼음왕관의 메아리 골짜기에 있는 칠흑의 감시자가 살덩이 분쇄자 살라낙스, 악마왕 탈로녹스, 그리고 대사제 야스아몬을 처치해 달라고 했습니다.‡El Vigía de Ébano en el Valle de los Ecos de Corona de Hielo quiere que mates a Salranx el Sacrificador, al infrarrey Talonox y al sumo sacerdote Yath\'amon.‡El Vigía de Ébano en el Valle de los Ecos de Corona de Hielo quiere que mates a Salranx el Sacrificador, al infrarrey Talonox y al sumo sacerdote Yath\'amon.‡Le Gardien d\'ébène, de la Vallée des Échos dans la Couronne de glace, vous a demandé de tuer Salranax le Tranche-chair, le Sous-roi Talonox et le Grand prêtre Yath\'amon.‡冰冠冰川回音谷的黑锋观察者要你去杀死撕裂者萨兰纳克斯、虫王塔洛诺克斯和高阶祭司亚萨尔蒙。‡在寒冰皇冠，回聲山谷的黯黑看守者要求你，殺掉『血肉撕裂者』索拉納斯、高階祭師亞薩蒙、和地底王塔婁諾斯。',
  }
},
[13126] = {
  {
    'Uma frente unificada‡Единым фронтом‡Vereinte Front‡연합 전선‡Un frente unido‡Un frente unido‡Un front uni‡协同作战‡共同戰線',
    nil,
    'Belgaristrasz quer que você destrua 10 Constructos Centrífugos e derrube o escudo de Varos. Então, derrote Varos Galganuvens.‡Белгаристраз просит вас уничтожить 10 центрифужных созданий, разрушить щит Вароса и одолеть самого Заоблачного Странника.‡Belgaristrasz möchte, dass Ihr 10 Zentrifugenkonstrukte zerstört, um Varos\' Schild zu beseitigen. Danach müsst Ihr Varos Wolkenwanderer besiegen.‡벨가리스트라즈가 원심력 피조물 10개를 처치하고 방어막을 붕괴시킨 다음 바로스 클라우드스트라이더를 처치해 달라고 했습니다.‡Belgaristrasz quiere que acabes con 10 ensamblajes de centrifugadoras para derribar el escudo de Varos. Entonces deberás derrotar a Varos Zancanubes.‡Belgaristrasz quiere que acabes con 10 ensamblajes de centrifugadoras para derribar el escudo de Varos. Entonces deberás derrotar a Varos Zancanubes.‡Belgaristrasz veut que vous tuiez 10 Assemblages centrifuges pour détruire le Bouclier de Varos. Vous devez ensuite détruire Varos Arpentenuée.‡贝加里斯塔兹要求你摧毁10台离心构造体，以此关闭瓦尔洛斯的护盾。然后击败瓦尔洛斯·云击。‡貝加瑞斯塔茲要你摧毀10具離心傀儡，除去瓦羅斯的護盾。然後你必須擊敗瓦羅斯·雲行者。',
  }
},
[13127] = {
  {
    'Lorde-mago Urom‡Маг-лорд Уром‡Magierlord Urom‡마법사 군주 우롬‡Señor de la magia Urom‡Señor de la magia Urom‡Le seigneur-mage Urom‡法师领主伊洛姆‡法師領主厄隆',
    nil,
    'Belgaristrasz quer que você derrote o Lorde-mago Urom dentro de Óculus.‡Белгаристраз просит вас победить Мага-лорда Урома в Окулусе.‡Belgaristrasz möchte, dass Ihr Magierlord Urom im Oculus besiegt.‡벨가리스트라즈가 마력의 눈에 있는 마법사 군주 우롬을 처치하라고 했습니다.‡Belgaristrasz quiere que derrotes al Señor de la magia Urom en El Oculus.‡Belgaristrasz quiere que derrotes al Señor de la magia Urom en El Oculus.‡Belgaristrasz veut que vous triomphiez du Seigneur-mage Urom dans l’Oculus.‡贝加里斯塔兹要求你击败魔环的法师领主伊洛姆。‡貝加瑞斯塔茲要你擊敗奧核之眼中的法師領主厄隆。',
  }
},
[13128] = {
  {
    'Asas e preces‡Высокие ставки‡Schlacht in den Wolken‡기도는 날개를 타고‡Un ala y una oración‡Un ala y una oración‡Une petite chance de réussir‡龙翼之力‡飛翼與祈禱',
    nil,
    'Belgaristrasz quer que você mate Éregos dentro do Óculus.‡Белгаристраз просит вас убить Эрегоса в Окулусе.‡Belgaristrasz möchte, dass Ihr Eregos im Oculus tötet.‡벨가리스트라즈가 마력의 눈에 있는 에레고스를 처치해 달라고 했습니다.‡Belgaristrasz quiere que mates a Eregos en El Oculus.‡Belgaristrasz quiere que mates a Eregos en El Oculus.‡Belgaristrasz veut que vous tuiez Eregos dans l\'Oculus.‡贝加里斯塔兹要求你击败魔环的埃雷苟斯。‡貝加瑞斯塔茲要你殺死奧核之眼的伊瑞苟斯。',
  }
},
[13129] = {
  {
    'Brincando de morto‡Игры разума‡Psychospielchen‡두뇌 싸움‡Juegos mentales‡Juegos mentales‡Manipulation‡智力游戏‡鬥智遊戲',
    nil,
    'Kurzel quer que você use o Trapo da Blusa de Kurzel no cadáver de Novos, o Evocador, e traga o Pano Manchado de Icor de volta para ela na Bastilha Drak\'Tharon.‡Курцель просит вас приложить клочок ее рубахи к трупу Новоса Призывателя, после чего принести ей запятнанную лимфой ткань в Крепость Драк\'Тарон.‡Kurzel möchte, dass Ihr den Fetzen von Kurzels Bluse auf die Reste von Novos dem Beschwörer anwendet und anschließend den sekretbefleckten Stoff zu ihr in die Feste Drak\'Tharon bringt.‡드락타론 성채 안에 있는 쿠르젤이 쿠르젤의 블라우스 조각을 소환사 노보스의 시체에 사용한 다음, 영액 묻은 옷감을 가져와 달라고 했습니다.‡Kurzel quiere que uses los restos de blusa de Kurzel con el cadáver de Novos el Invocador. Después tienes que llevarle la tela manchada de icor a la Fortaleza de Drak\'Tharon.‡Kurzel quiere que uses los restos de blusa de Kurzel con el cadáver de Novos el Invocador. Después tienes que llevarle la tela manchada de icor a la Fortaleza de Drak\'Tharon.‡Kurzel veut que vous utilisiez le Morceau de chemise de Kurzel sur le cadavre de Novos l’Invocateur, puis que vous lui remettiez le Tissu souillé d’ichor à l’intérieur du donjon de Drak’Tharon.‡达克萨隆要塞的库塞尔希望你对召唤者诺沃斯的尸体使用库塞尔的布片。然后把沾满腐液的布片交给她。‡庫賽爾要你對『召喚者』諾沃司的屍體使用庫賽爾的短衫碎片，然後將腐液玷污的布料帶回去德拉克薩隆要塞給她。',
  }
},
[13130] = {
  {
    'A rocha que iniciou uma revolução‡Первый камень‡Der Stein, der eine Revolution auslöste‡혁명도 돌 하나에서 시작‡La piedra que comenzó una revolución‡La piedra que comenzó una revolución‡La pierre qui lança une révolution‡公正堡的基石‡革命的基石',
    nil,
    'O Cruzado-arquiteto Silas, no Vale dos Ecos, que fica na Coroa de Gelo, quer que você recupere 10 troncos de Cerne Cristalino e 10 peças de Maçonaria Élfica Antiga.‡По заданию архитектора ордена Силаса из Долины Эха добудьте 10 бревен хрустальной древесины и 10 обломков древней эльфийской кладки.‡Kreuzzugsarchitekt Silas im Tal der Echos in Eiskrone möchte, dass Ihr 10 Stämme kristallines Kernholz und 10 Stücke altes elfisches Mauerwerk sammelt.‡얼음왕관의 메아리 골짜기에 있는 은빛십자군 건축가 실라스가 수정 심재 10개와 고대 엘프 석조 10개를 가져다 달라고 했습니다.‡El arquitecto de Cruzada Silas en el Valle de los Ecos en Corona de Hielo quiere que recuperes 10 troncos de duramen cristalino y 10 trozos de mampostería élfica antigua.‡El arquitecto de Cruzada Silas en el Valle de los Ecos en Corona de Hielo quiere que recuperes 10 troncos de duramen cristalino y 10 trozos de mampostería élfica antigua.‡L\'Architecte de la croisade Silas, de la Vallée des Échos dans la Couronne de glace, vous demande de récupérer 10 Troncs de Cœur-du-bois cristallins et 10 morceaux de Pierres de construction elfique.‡冰冠冰川回音谷的北伐军建筑师西拉斯要你去收集10根水晶心木和10块古代精灵石砖。‡回聲山谷的十字軍建築師席拉斯要求你，採集10株結晶心材的樹幹，以及10份上古精靈石藝。',
  }
},
[13131] = {
  {
    'Sucata no meu baú‡Пустой сундук‡Schrott in der Truhe‡내 상자 속의 고물‡Basura en mi baúl‡Basura en mi baúl‡Des rebuts dans ma malle‡宝箱中的垃圾‡我箱子裡的垃圾',
    nil,
    'Brigg, no Pináculo Utgarde, quer que você encontre 5 Barras de Prata Imaculadas, 3 Miçangas Brilhosas, 2 Cálices Dourados e uma Estátua de Jade.‡Принесите Бриггу на вершину Утгард 5 непотускневших серебряных слитков, 3 сверкающих кристалла, 2 золотых кубка и нефритовую статуэтку.‡Brigg im Turm Utgarde möchte, dass Ihr 5 blitzblanke Silberbarren, 3 glänzende Schmuckstücke, 2 goldene Kelche und eine Jadestatue beschafft.‡우트가드 첨탑에 있는 브릭이 청명한 은괴 5개, 반짝이는 미끼 3개, 황금 술잔 2개, 비취 조각상 1개를 찾아오라고 했습니다.‡Brigg en el Pináculo de Utgarde quiere que encuentres 5 barras de plata manchadas, 3 adornos lustrosos, 2 cáliz dorados y una figurilla de jade.‡Brigg en el Pináculo de Utgarde quiere que encuentres 5 barras de plata manchadas, 3 adornos lustrosos, 2 cáliz dorados y una figurilla de jade.‡Brigg, à la Cime d\'Utgarde, vous a demandé de lui apporter 5 Barres d\'argent immaculées, 3 Verroteries rutilantes, 2 Coupes dorées et une Statue en jade.‡乌特加德之巅的布雷格要你帮他收集5块失去光泽的银锭、3枚闪亮的饰物、2只黄金酒杯和1座碧玉雕像。‡俄特加德之巔的布瑞格要求你，找到5個黯淡的銀錠、3顆閃光的小珠、2只黃金高腳杯以及1尊碧玉雕像。',
  }
},
[13132] = {
  {
    'Que a vingança seja minha!‡Отмщение‡Die Rache ist mein!‡복수는 나의 것!‡¡La venganza será mía!‡¡La venganza será mía!‡La vengeance sera mienne !‡我要复仇！‡我將復仇!',
    nil,
    'Brigg, no Pináculo Utgarde, quer que você mate o Rei Ymiron.‡Убейте короля Имирона по просьбе Бригга из вершины Утгард.‡Brigg im Turm Utgarde möchte, dass Ihr König Ymiron tötet.‡우트가드 첨탑에 있는 브릭이 왕 이미론을 처치해 달라고 했습니다.‡Brigg en el Pináculo de Utgarde quiere que mates al rey Ymiron.‡Brigg en el Pináculo de Utgarde quiere que mates al rey Ymiron.‡Brigg, à la Cime d\'Utgarde, vous a demandé de tuer le Roi Ymiron.‡乌特加德之巅的布雷格要你去杀死伊米隆国王。‡俄特加德之巔的布瑞格要求你，殺掉依米倫王。',
  }
},
[13133] = {
  {
    'Encontre o herói ancestral‡Поиски древнего героя‡Findet den Held aus alter Zeit‡고대 영웅 발견‡Encuentra al antiguo héroe‡Encuentra al antiguo héroe‡Trouver l\'ancien héros‡找到古代英雄‡尋找遠古英雄',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você traga Iskalder até ela.‡Приведите Искальдера к костяной ведьме в деревню Ньорндар.‡Die Knochenhexe aus Njorndar möchte, dass Ihr mit Iskalder zurückkehrt.‡요른다르 마을에 있는 해골 마녀가 이스칼더를 데려오라고 했습니다.‡La Bruja Osaria en el poblado Njorndar quiere que vuelvas con Iskalder.‡La Bruja Osaria en el poblado Njorndar quiere que vuelvas con Iskalder.‡La Sorcière des ossements, à Njorndar, veut que vous lui rameniez Iskalder.‡约尔达村的白骨女巫要你将伊斯卡德尔带回来。‡尼約達村的骸骨女巫要求你，帶回伊斯卡德。',
  }
},
[13134] = {
  {
    'Derramando o sangue inimigo‡Пролитая кровь‡Lasst ihr Blut fließen‡그들의 계획을 뒤엎어라‡Vierte su sangre‡Vierte su sangre‡Répandre leur sang‡抛洒它们的血‡讓他們血濺五步',
    nil,
    'A Cavaleira das Trevas Arly, na Guarda Negra, quer que você destrua 5 tanques de Fluido Embalsamador e 5 Orbes de Sangue.‡Уничтожьте 5 чанов с бальзамировочным составом и 5 кровавых сфер по просьбе темной всадницы Арли из Черного дозора.‡Dunkelreiterin Arly aus der Schwarzwacht möchte, dass Ihr 5 Bottiche mit Balsamierungsflüssigkeit und 5 Blutkugeln zerstört.‡어둠의 감시초소에 있는 어둠기수 알리가 불변의 액체가 담긴 수조 5개와 피의 보주 5개를 파괴해달라고 했습니다.‡La jinete oscura Arly en La Guardia Negra quiere que destruyas 5 tanques de líquido de embalsamar y 5 orbes de sangre.‡La jinete oscura Arly en La Guardia Negra quiere que destruyas 5 tanques de líquido de embalsamar y 5 orbes de sangre.‡La Cavalière noire Arly, au Guet noir, vous demande de détruire 5 cuves de Fluide d\'embaumement et 5 Orbes de sang.‡黑色观察站的黑暗骑士阿尔蕾要你去摧毁5桶防腐液和5枚鲜血宝珠。‡黑色守望的黑騎兵亞爾利要求你，摧毀5個盛裝防腐液的缸子，以及5個血魄寶珠。',
  }
},
[13135] = {
  {
    'Perigo iminente‡Кристаллы энергии‡Es könnte uns alle umbringen‡꿩 먹고 알 먹기‡Podría matarnos a todos‡Podría matarnos a todos‡Elle pourrait nous tuer tous‡危险的能量‡它會殺了我們',
    nil,
    'O Cruzado-engenheiro Patricuspe, no Vale dos Ecos, que fica na Coroa de Gelo, quer que você recupere 8 Energias Cristalizadas.‡Принесите 8 источников кристаллизованной энергии инженеру ордена Шпицпатрику в Долину Эха в Ледяной Короне.‡Kreuzzugsingenieur Spitzpatrick aus dem Tal der Echos in Eiskrone möchte, dass Ihr 8 Stücke kristallisierte Energie besorgt.‡얼음왕관의 메아리 골짜기에 있는 십자군 기술자 스피츠패트릭이 결정화된 기운 8조각을 모아 달라고 했습니다.‡El Ingeniero de Cruzada Spitzpatrick en el Valle de los Ecos en Corona de Hielo quiere que recuperes 8 trozos de energía cristalizada.‡El Ingeniero de Cruzada Spitzpatrick en el Valle de los Ecos en Corona de Hielo quiere que recuperes 8 trozos de energía cristalizada.‡L\'Ingénieur de la croisade Spitzpatrick, de la Vallée des Échos dans la Couronne de glace, vous a demandé de récupérer 8 morceaux d\'Énergie cristallisée.‡冰冠冰川回音谷的北伐军技师斯比帕提克要你去收集8块结晶能量。‡在寒冰皇冠，回聲山谷的十字軍工程師史匹派崔要求你，收集並帶回8份晶化能量。',
  }
},
[13136] = {
  {
    'Fragmentos serrilhados‡Зазубренные осколки‡Gezackte Splitter‡톱니 조각‡Fragmentos dentados‡Fragmentos dentados‡Éclats dentelés‡粗糙的碎片‡鋸齒裂片',
    nil,
    'Entregue 10 Fragmentos Serrilhados para o Cruzado Olakin Sainrith, na Guarda Negra.‡Принесите 10 зазубренных осколков рыцарю Олакину Сайнриту в Черный дозор.‡Bringt Kreuzfahrer Olakin Sainrith in der Schwarzwacht 10 gezackte Splitter.‡어둠의 감시초소에 있는 성전사 올라킨 세인리스에게 톱니 조각 10개를 가져가야 합니다.‡Llévale 10 fragmentos dentados al cruzado Olakin Sainrith en La Guardia Negra.‡Llévale 10 fragmentos dentados al cruzado Olakin Sainrith en La Guardia Negra.‡Apportez 10 Éclats dentelés au Croisé Olakin Sainrith au Guet noir.‡将10块粗糙的碎片交给黑色观察站的北伐军战士欧尔拉金·萨利斯。‡將10片鋸齒裂片，帶給黑色守望的十字軍歐拉金·山瑞斯。',
  }
},
[13137] = {
  {
    'Combate não muito justo‡Не совсем честный бой‡Nicht so ehrenhafter Kampf‡그리 명예롭지 않은 전투‡Combate no tan honorable‡Combate no tan honorable‡Combat pas-si-honorable-que-ça‡不那么光彩的战斗‡不名譽戰鬥',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você derrote Iskalder no Pináculo Chaga de Guerra.‡Одержите победу над Искальдером на вершине Боевого Шрама по поручению костяной ведьмы из деревни Ньорндар.‡Die Knochenhexe aus Njorndar möchte, dass Ihr Iskalder auf der Kriegsnarbenwarte besiegt.‡요른다르 마을에 있는 해골 마녀가 전투의 흉터 첨탑 위에서 이스칼더를 처치해 달라고 했습니다.‡La Bruja Osaria en el poblado Njorndar quiere que derrotes a Iskalder en la Cumbre Marca de Guerra.‡La Bruja Osaria en el poblado Njorndar quiere que derrotes a Iskalder en la Cumbre Marca de Guerra.‡La Sorcière des ossements, à Njorndar, vous demande de vaincre Iskalder sur la Flèche de la Balafre.‡约尔达村的白骨女巫要你在战痕尖塔击败伊斯卡德尔。‡尼約達村的骸骨女巫要求你，在戰傷尖塔上擊敗伊斯卡德。',
  }
},
[13138] = {
  {
    'Estou trabalhando... trabalhando!‡Непонятный металл‡Ich schmelze... schmelze!‡녹는다... 녹아!‡¡Estoy fundiendo... fundiendo!‡¡Estoy fundiendo... fundiendo!‡Je fonds… Je fonds !‡熔炼碎片‡我熔…熔化了!',
    nil,
    'Use o Saco de Fragmentos Serrilhados em uma das fornalhas do nível inferior de Malykriss. Em seguida, entregue a Barra de Metal Fundido resultante para o Cruzado Olakin Sainrith, na Guarda Negra.‡Переплавьте мешок зазубренных осколков в одной из кузней Маликрисса. Потом возвращайтесь в Черный дозор и отдайте выплавленный слиток металла рыцарю Олакину Сайнриту.‡Benutzt die Tasche mit gezackten Splittern in der Nähe eines der Hochöfen auf der untersten Ebene von Malykriss. Kehrt mit dem verhütteten Metallbarren zum Kreuzfahrer Olakin Sainrith bei der Schwarzwacht zurück.‡말리크리스의 아래 층 중 한 곳 근처에서 톱니 조각 자루를 사용한 다음, 제련된 금속 주괴를 가지고 어둠의 감시초소에 있는 성전사 올라킨 세인리스에게 가야 합니다.‡Usa la bolsa de fragmentos dentados cerca de uno de los hornos del nivel más profundo de Malykriss. Llévale la barra de metal fundido al cruzado Olakin Sainrith en La Guardia Negra.‡Usa la bolsa de fragmentos dentados cerca de uno de los hornos del nivel más profundo de Malykriss. Llévale la barra de metal fundido al cruzado Olakin Sainrith en La Guardia Negra.‡Utilisez le Sac d\'éclats dentelés près de l\'une des Fournaises de Malykriss du niveau inférieur. Retournez voir le Croisé Olakin Sainrith au Guet noir avec la Barre de métal fondue.‡在玛雷卡里斯底层的熔炉附近使用一包粗糙的碎片。将熔炼过的金属锭交给黑色观察站的北伐军战士欧尔拉金·萨利斯。‡使用瑪里庫立斯熔爐下層附近的鋸齒裂片袋。將熔化的金屬錠帶回給黑色守望的十字軍歐拉金·山瑞斯。',
  }
},
[13139] = {
  {
    'No coração congelado de Nortúndria‡Ледяное сердце Нордскола‡Im gefrorenen Herzen Nordends‡노스렌드의 얼어붙은 심장으로‡Dentro del helado corazón de Rasganorte‡Dentro del helado corazón de Rasganorte‡Dans le cœur gelé du Norfendre‡进入诺森德的冰冷腹地‡深入北裂境的冰凍心臟',
    nil,
    'Entregue o Relatório do Padre Gustav ao Grão-lorde Tirion Fordring na Vanguarda Argêntea, que fica na Coroa de Gelo.‡Доставьте донесение отца Густава верховному лорду Тириону Фордрингу в Оплот Серебряного Авангарда в Ледяной Короне.‡Liefert Vater Gustavs Bericht bei Hochlord Tirion Fordring in der Argentumvorhut in Eiskrone ab.‡신부 구스타프의 보고서를 얼음왕관의 은빛십자군 선봉기지에 있는 대영주 티리온 폴드링에게 전달해야 합니다.‡Llévale el informe del padre Gustav al alto señor Tirion Vadín en La Vanguardia Argenta en Corona de Hielo.|n‡Llévale el informe del padre Gustav al alto señor Tirion Vadín en La Vanguardia Argenta en Corona de Hielo.|n‡Apportez le rapport du Père Gustav au Généralissime Tirion Fordring à l\'Avant-garde d\'Argent, dans la Couronne de glace.‡将古斯塔夫神父的报告交给冰冠冰川银色前线基地的大领主提里奥·弗丁。‡將賈斯塔夫神父的報告呈給大領主提里奧·弗丁，他在寒冰皇冠的銀白先鋒駐地。',
  }
},
[13140] = {
  {
    'Os ferreiros rúnicos de Malykriss‡Руноковы Маликрисса‡Die Runenschmiede von Malykriss‡말리크리스의 룬대장장이‡Los forjadores de runas de Malykriss‡Los forjadores de runas de Malykriss‡Les forgerunes de Malykriss‡玛雷卡里斯的符文锻造师‡瑪里庫立斯的符文鐵匠',
    nil,
    'Entregue 5 Placas Rúnicas de Saronita para o Cruzado Olakin Sainrith, na Guarda Negra.‡Принесите рыцарю Олакину из Черного дозора 5 рунических саронитовых пластин.‡Bringt Kreuzfahrer Olakin in der Schwarzwacht 5 runenverzierte Saronitplattenrüstungen.‡룬새김 사로나이트 판금 5개를 어둠의 감시초소에 있는 성전사 올라킨 세인리스에게 가져가야 합니다.‡Llévale 5 placas de saronita rúnicas al cruzado Olakin Sainrith en La Guardia Negra.‡Llévale 5 placas de saronita rúnicas al cruzado Olakin Sainrith en La Guardia Negra.‡Apportez 5 Plaques runiques en saronite au Croisé Olakin Sainrith au Guet noir.‡将5块符文萨隆邪铁板交给黑色观察站的北伐军战士欧尔拉金·萨利斯。‡帶回5塊符文薩鋼板給黑色守望的十字軍歐拉金·山瑞斯。',
  }
},
[13141] = {
  {
    'A batalha pelo Pináculo dos Cruzados‡Битва за Вершину Рыцарей‡Die Schlacht um den Kreuzfahrerturm‡십자군 봉우리를 위한 전투‡La batalla por el Pináculo de los Cruzados‡La batalla por el Pináculo de los Cruzados‡La bataille pour la cime des Croisés‡北伐军之峰的战斗‡十字軍之巔保衛戰',
    nil,
    'Vá para o Pináculo dos Cruzados e finque o Estandarte Abençoado da Cruzada em cima da Pilha de Crânios de Cruzados. Defenda o estandarte contra os ataques do Flagelo até que a terra no pináculo tenha sido santificada. Em seguida, fale com o Padre Gustav no Vale dos Ecos, que fica na Coroa de Gelo.‡Отправляйтесь на Вершину Рыцарей и установите благословенное знамя Авангарда на груде рыцарских черепов. Защищайте знамя от солдат Плети, пока земля на Вершине Рыцарей не очистится от порчи. Затем возвращайтесь к отцу Густаву в Долину Эха в Ледяной Короне.‡Begebt Euch zum Kreuzfahrerturm und platziert das gesegnete Banner des Kreuzzugs auf dem Haufen Kreuzfahrerschädel. Verteidigt das Banner gegen den Angriff der Geißel, bis das Land auf dem Turm gereinigt ist. Kehrt dann zu Vater Gustav ins Tal der Echos in Eiskrone zurück.‡십자군 봉우리로 가서 축복받은 십자군 깃발을 십자군 유골 더미 위에 꽂은 다음, 공격해오는 스컬지에 대항하여 봉우리 위의 땅이 정화될 때까지 깃발을 지켜야 합니다. 그런 다음 얼음왕관의 메아리 골짜기에 있는 신부 구스타프에게 돌아와야 합니다.‡Aventúrate en el Pináculo de los Cruzados y usa el estandarte de la Cruzada bendecido sobre la pila de calaveras de cruzado. Defiende el estandarte del ataque de la Plaga hasta que la tierra sobre el Pináculo haya quedado santificada, entonces habla con el padre Gustav en el Valle de los Ecos, en Corona de Hielo.‡Aventúrate en el Pináculo de los Cruzados y usa el estandarte de la Cruzada bendecido sobre la pila de calaveras de cruzado. Defiende el estandarte del ataque de la Plaga hasta que la tierra sobre el Pináculo haya quedado santificada, entonces habla con el padre Gustav en el Valle de los Ecos, en Corona de Hielo.‡Rendez-vous à la Cime des Croisés et utilisez la Bannière bénie de la Croisade au sommet de la Pile de crânes de croisés. Défendez la bannière contre toute attaque du Fléau jusqu\'à ce que la terre au sommet de la Cime soit sanctifiée, puis retournez voir le Père Gustav dans la Vallée des Échos, dans la Couronne de glace.‡前往北伐军之峰，在北伐军祭坛上使用北伐军的神圣军旗。保护旗帜，直到北伐军之峰得到净化，然后向冰冠冰川回音谷的古斯塔夫神父复命。‡前往十字軍之巔，在十字軍顱骨堆上使用十字軍祝福旌旗。防禦天譴軍團發動的攻擊，直到十字軍之巔頂端一帶的土地被聖滌。最後回到寒冰皇冠的回聲山谷，找到賈斯塔夫神父。',
  }
},
[13142] = {
  {
    'A vingança da banshee‡Месть банши‡Rache der Banshee‡밴시의 복수‡La revancha del alma en pena‡La revancha del alma en pena‡La revanche de la banshee‡女妖的复仇‡女妖的復仇',
    nil,
    'A Bruxa dos Ossos, na Vila Njorndar, quer que você a vingue desafiando e derrotando o Sumo Thane Balargarde.‡Отомстите за костяную ведьму из деревни Ньорндар, бросив вызов верховному тану Балагарду и победив его.‡Die Knochenhexe aus Njorndar möchte, dass Ihr für sie Rache nehmt, indem Ihr Oberthan Balargarde herausfordert und besiegt.‡요른다르 마을에 있는 해골 마녀가 대영주 발라르가드에게 도전하여 그를 처치함으로써 그녀의 복수를 해 달라고 했습니다.‡La Bruja Osaria en el poblado Njorndar te ha pedido que te vengues desafiando y derrotando al señor feudal Supremo Balargarde.‡La Bruja Osaria en el poblado Njorndar te ha pedido que te vengues desafiando y derrotando al señor feudal Supremo Balargarde.‡La Sorcière des ossements, à Njorndar, vous a demandé d\'exercer sa revanche en défiant et en battant le Thane suprême Balargarde.‡约尔达村的白骨女巫要你挑战并击败大领主巴拉加德，为她复仇。‡尼約達村的骸骨女巫要求你，挑戰並擊敗共主巴拉加德，以作為她的復仇。',
  }
},
[13143] = {
  {
    'Novo recruta‡Новобранец‡Neuer Rekrut‡신병 교육‡Nuevos reclutas‡Nuevos reclutas‡Nouvelle recrue‡新兵‡生力軍',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você leve um Espreitador Ágil Subjugado ao topo das rochas a nordeste da Beira do Sofrimento.‡Приведите укрощенного гибкого ловца на вершину скалы к северо-востоку от Высоты Страдания по указанию Верета Хитрого с Высоты Страдания.‡Vereth der Gewiefte auf der Anhöhe des Leidens wünscht, dass Ihr einen unterworfenen geschmeidigen Pirscher zur Spitze der Felsen nordöstlich der Anhöhe des Leidens bringt.‡고통의 언덕에 있는 교활한 베레스가 제압 당한 흐물거리는 추적자를 고통의 언덕 북동쪽에 위치한 바위 언덕 위로 데려가 달라고 했습니다.‡Vereth el Maquiavélico, del Alto del Sufrimiento, te ha pedido que lleves a un acechador ágil subyugado a lo alto de las rocas que se encuentran al noreste del Alto del Sufrimiento.‡Vereth el Maquiavélico, del Alto del Sufrimiento, te ha pedido que lleves a un acechador ágil subyugado a lo alto de las rocas que se encuentran al noreste del Alto del Sufrimiento.‡Vereth le Fourbe, à la Cime de Souffrance, vous a demandé de lui amener un Traqueur agile soumis au sommet des rochers au nord-est de la Cime de Souffrance.‡苦难高地的狡诈者维雷斯要你驯服一只轻盈追迹者，然后把它带到苦难高地东北方的岩石上。‡苦難高崗上奸詐的維瑞希要求你，將一個已收服的輕盈潛獵者，帶回至苦難高崗東北方的岩石堆頂端。',
  }
},
[13144] = {
  {
    'Matar dois membros de flagelo com um esqueleto só‡Одним скелетом – двух воинов Плети!‡Zwei Geißeln mit einem Skelett schlagen‡스컬지 둘에 해골 하나씩 처치‡Matar dos plagas con un esqueleto‡Matar dos plagas con un esqueleto‡D\'un squelette, deux membres du Fléau‡一举两得‡一石二鳥',
    nil,
    'A Cavaleira das Trevas Arly, na Guarda Negra, quer que você destrua 3 Abominações Acorrentadas usando os Esqueletos Incandescentes.‡Уничтожьте 3 прикованных поганищ с помощью горящих скелетов по поручению темной всадницы Арли из Черного дозора.‡Dunkelreiterin Arly an der Schwarzwacht möchte, dass Ihr 3 angekettete Monstrositäten mit brennenden Skeletten zerstört.‡어둠의 감시초소에 있는 어둠기수 알리가 구속된 누더기골렘 3마리와 불타는 해골들을 처치해 달라고 했습니다.‡La jinete oscura Arly quiere que acabes con 3 abominaciones encadenadas con los esqueletos ardientes.‡La jinete oscura Arly quiere que acabes con 3 abominaciones encadenadas con los esqueletos ardientes.‡La Cavalière noire Arly, au Guet noir, vous a demandé de détruire 3 Abominations enchaînées avec des Squelettes ardents.‡黑色观察站的黑暗骑士阿尔蕾要你借助燃烧的骷髅消灭3只被锁住的憎恶。‡黑色守望的黑騎兵阿爾利要求你，以燃燒的骷髏摧毀3個被禁錮的憎惡體。',
  }
},
[13145] = {
  {
    'O forte torpe‡Зловещая крепость‡Die Unheilvolle Festung‡타락의 요새‡El Bastión Inmundo‡El Bastión Inmundo‡Le Fort infâme‡邪恶城堡‡邪鄙堡',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você use um Espreitador Ágil para inspecionar Malykriss.‡Используйте гибкого ловца для разведки в Маликриссе по поручению Верета Хитрого с Высоты Страдания.‡Vereth der Gewiefte auf der Anhöhe des Leidens wünscht, dass Ihr mithilfe eines geschmeidigen Pirschers Malykriss erkundet.‡고통의 언덕에 있는 교활한 베레스가 흐물거리는 추적자를 이용하여 말리크리스를 정찰해 달라고 했습니다.‡Vereth el Maquiavélico en el Alto del Sufrimiento te ha pedido que utilices el acechador ágil para rastrear Malykriss.‡Vereth el Maquiavélico en el Alto del Sufrimiento te ha pedido que utilices el acechador ágil para rastrear Malykriss.‡Vereth le Fourbe, à la Cime de Souffrance, vous a demandé d\'utiliser un Traqueur agile pour reconnaître Malykriss.‡苦难高地的狡诈者维雷斯要你使用轻盈追迹者的能力，侦察玛雷卡里斯。‡苦難高崗上奸詐的維瑞希要你利用一隻輕盈潛獵者來偵查瑪里庫利斯。',
  }
},
[13146] = {
  {
    'Quanta generosidade‡Предсказуемые и тупые‡Jede Menge Großzügigkeit‡푸짐한 선물‡Abundante generosidad‡Abundante generosidad‡Une abondance de générosité‡深信不疑‡慷慨大放送',
    nil,
    'Vereth, o Astuto, quer que você use a Corrente de Ferro do Espreitador Ágil para arrastar Bombas do Flagelo para perto de 4 Cruentos Machadeiros em Malykriss.‡Используйте железную цепь гибкого ловца, чтобы подтащить бомбы Плети к 4 неповоротливым страшилищам внутри Маликрисса.‡Vereth der Gewiefte möchte, dass Ihr nach Malykriss geht und mithilfe der Eisenkette des geschmeidigen Pirschers eine Geißelbombe zu einer schwerfälligen Schreckensgestalt zieht. Tötet auf diese Weise 4 schwerfällige Schreckensgestalten.‡교활한 베레스가 흐물거리는 추적자의 무쇠 사슬을 이용하여 스컬지 폭탄을 말리크리스 내의 4마리의 거대한 포악자에게 끌어다 놓아 달라고 했습니다.‡Vereth el Maquiavélico quiere que uses la cadena de hierro de acechador ágil para arrastrar bombas de la Plaga hasta 4 atrocidades torpes dentro de Malykriss.‡Vereth el Maquiavélico quiere que uses la cadena de hierro de acechador ágil para arrastrar bombas de la Plaga hasta 4 atrocidades torpes dentro de Malykriss.‡Vereth le Fourbe veut que vous utilisiez la Chaîne de fer du Traqueur agile pour tirer des Bombes du Fléau vers 4 Atrocités chancelantes dans Malykriss.‡狡诈者维雷斯要你使用轻盈追迹者的铁链，将天灾炸弹拖到玛雷卡里斯的4个笨拙的凶尸身边。‡苦難高崗上奸詐的維瑞希要求你，利用輕盈潛獵者的鐵鍊，拖曳天譴炸彈到4個瑪里庫利斯的笨拙殘暴者身邊。',
  }
},
[13147] = {
  {
    'O mediador‡Сваха‡Kuppler‡이간질의 제왕‡Emparejamientos‡Emparejamientos‡Affrontements en vue‡煽风点火‡速配達人',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você use um Espreitador Ágil para arremessar pedras em Bárbaros Umbralinos quando eles estiverem perto de mortos-vivos inferiores em Malykriss. Fale novamente com Vereth depois de provocar 5 brigas.‡По поручению Верета Хитрого с Высоты Страдания с помощью гибкого ловца бросайте камни в громил из тени, когда они оказываются рядом с другой нежитью Маликрисса. Возвращайтесь, когда вам удастся развязать 5 драк.‡Vereth der Gewiefte auf der Anhöhe des Leidens möchte, dass Ihr einen geschmeidigen Pirscher benutzt, um in Malykriss Steine auf Umbralschläger zu werfen, sobald sie sich niederen Untoten nähern. Kehrt zurück, sobald Ihr 5 Kämpfe provoziert habt.‡고통의 언덕에 있는 교활한 베레스가 흐물거리는 추적자를 이용하여 말리크리스에서 암영 투사가 하급 언데드에게 접근할 때 투사에게 돌을 던져 달라고 했습니다. 다섯 번의 싸움이 시작된 후에 베레스에게 가야 합니다.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que uses a un acechador ágil para tirar rocas a los toscos umbríos cuando estén cerca de no-muertos inferiores en Malykriss. Vuelve cuando hayas provocado 5 peleas.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que uses a un acechador ágil para tirar rocas a los toscos umbríos cuando estén cerca de no-muertos inferiores en Malykriss. Vuelve cuando hayas provocado 5 peleas.‡Vereth le Fourbe, à la Cime de Souffrance, vous demande d\'utiliser un Traqueur agile pour lancer des rochers sur des Brutes umbrales quand celles-ci s\'approchent de morts-vivants inférieurs à Malykriss. Revenez quand vous aurez déclenché 5 bagarres.‡苦难高地的狡诈者维雷斯要你趁阴暗蛮徒靠近低级亡灵时，利用轻盈追迹者向阴暗蛮徒投掷石块。挑起5起争端之后回去复命。‡苦難高崗上奸詐的維瑞希要求你，在瑪里庫立斯利用輕盈潛獵者，當陰影蠻卒接近較低等的不死生物時，對其丟擲石頭。引起5場打鬥後返回。',
  }
},
[13148] = {
  {
    'Conserto de colar‡Починка ожерелья‡Halskettenreparatur‡목걸이 수리‡Reparar el collar‡Reparar el collar‡Réparation du collier‡修理项链‡修理項鍊',
    nil,
    'Conserte o colar com uma Calcedônia e devolva-o para Falcão Joiado na Loja dos Joalheiros, na Área Comercial Magus, em Dalaran.‡Почините ожерелье с помощью одного камешка кальцедония и верните его Тимоти Джонсу в его ювелирную мастерскую в Торговую палату волшебников Даларана.‡Repariert die Halskette mit einem einzigen Chalzedon und bringt sie zu Jonas Timotheus im Juwelierladen auf dem Handelsmarkt der Magier in Dalaran.‡옥수 한 개로 목걸이를 수리하여 달라란에 있는 마법사 교역소의 까르티엘 보석공예품에 있는 티모시 존스에게 가져가야 합니다.‡Repara el collar con una calcedonia y devuélveselo a Timothy Jones en la tienda de joyeros del Mercado de Magos de Dalaran.‡Repara el collar con una calcedonia y devuélveselo a Timothy Jones en la tienda de joyeros del Mercado de Magos de Dalaran.‡Réparez le Collier avec une simple Calcédoine et rapportez-le à Timothy Jones à la joaillerie à la Halle des mages à Dalaran.‡用一颗玉髓石对项链进行修补，然后把它还给达拉然魔法商业区珠宝店的提莫斯·琼斯。‡以一枚玉髓修復這條項鍊，並送至提摩西·瓊斯的珠寶工藝店，店在達拉然的魔導師交易區。',
  }
},
[13149] = {
  {
    'Dissipando ilusões‡Развеянные иллюзии‡Illusionen bannen‡환영 퇴치‡Disipando ilusiones‡Disipando ilusiones‡Dissiper les illusions‡驱除幻象‡驅散幻影',
    nil,
    'Crona quer que você use o Interruptor Arcano nos caixotes suspeitos em Stratholme do passado e, então, fale com ela perto da entrada de Stratholme.‡Хроми попросила вас снять маскировку с подозрительных ящиков с зерном с помощью Разбивателя Чар, после чего найти ее у входа в Стратхольм.‡Chromie möchte, dass Ihr den arkanen Disruptor auf die verdächtigen Kisten im Stratholme der Vergangenheit anwendet und sie anschließend am Eingang von Stratholme trefft.‡마력 분열기를 과거의 스트라솔름에 있는 수상한 상자에 사용한 다음, 스트라솔름 입구 근처에 있는 크로미와 대화해야 합니다.‡Cromi quiere que uses el disruptor arcano sobre las cajas sospechosas en el Pasado de Stratholme y después hables con ella cerca de la entrada de Stratholme.‡Cromi quiere que uses el disruptor arcano sobre las cajas sospechosas en el Pasado de Stratholme y después hables con ella cerca de la entrada de Stratholme.‡Chromie veut que vous utilisiez le Disrupteur arcanique sur les Caisses de céréales suspectes dans le Stratholme d\'antan, puis parlez-lui près de l\'entrée de Stratholme.‡克罗米要你对往日的斯坦索姆内的可疑箱子使用奥术干扰器，然后到斯坦索姆的入口附近去见她。‡克羅米要求你，在斯坦索姆的往日，對可疑的箱子使用秘法干擾器，然後在其入口附近和她交談。',
  }
},
[13151] = {
  {
    'Uma escolta real‡Королевский эскорт‡Die Eskorte des Königs‡왕 호위‡Una escolta real‡Una escolta real‡Une escorte royale‡皇家护卫‡忠誠護衛',
    nil,
    'Crona pediu a você que acompanhe Arthas no Expurgo de Stratholme. Você deve falar com ela novamente quando Mal\'Ganis for derrotado.‡Хроми попросила вас сопровождать Артаса во время очищения Стратхольма. Вернитесь к ней, когда Мал\'Ганис будет убит.‡Chromie möchte, dass Ihr Arthas bei seiner Ausmerzaktion in Stratholme begleitet. Ihr sollt wieder mit ihr sprechen, nachdem Mal\'Ganis besiegt ist.‡크로미가 아서스의 옛 스트라솔름으로 가서 정화에 동참해 달라고 했습니다. 말가니스를 쓰러뜨린 후 그녀와 다시 대화해야 합니다.‡Cromi te ha pedido que acompañes a Arthas en La Matanza de Stratholme. Vuelve a hablar con ella después de haber derrotado a Mal\'Ganis.‡Cromi te ha pedido que acompañes a Arthas en La Matanza de Stratholme. Vuelve a hablar con ella después de haber derrotado a Mal\'Ganis.‡Chromie vous a demandé d\'accompagner Arthas au cours de l\'Épuration de Stratholme. Retournez lui parler une fois Mal\'Ganis vaincu.‡克罗米要你陪伴阿尔萨斯完成清洗斯坦索姆的任务。击败玛尔加尼斯后再去见她。‡克羅米要求你，在斯坦索姆的抉擇中，隨侍於阿薩斯身側。瑪爾加尼斯被擊敗以後，回頭找她交談。',
  }
},
[13152] = {
  {
    'Criatura versus criador‡Визит к доктору‡Ein Besuch beim Doktor‡의술사 방문‡Una visita al doctor‡Una visita al doctor‡Une visite chez le docteur‡看医生‡探訪博士',
    nil,
    'A Cavaleira das Trevas Arly, na Guarda Negra, quer que você destrua a Estaca de Metal que prende o Remendeiro, no Sacrário da Reanimação, e, em seguida, ajude-o a se vingar do Doutor Sabnok.‡По указанию темной всадницы Арли из Черного дозора отправляйтесь в Святилище воскрешения, разрушьте металлическую стойку, к которой прикован Заплатень, и помогите ему отомстить доктору Сабноку.‡Dunkelreiterin Arly von der Schwarzwacht möchte, dass Ihr den Metallpflock, an den \'Flicken\' im Sanktum der Reanimation gekettet ist, zerstört und diesem helft, sich an Doktor Sabnok zu rächen.‡어둠의 감시초소에 있는 어둠기수 알리가 부활의 성소에서 누더기를 구속하는 쇠막대를 파괴하고 누더기가 의술사 사브녹에게 복수하도록 도와주라고 했습니다.‡La jinete oscura Arly en La Guardia Negra quiere que destruyas la estaca metálica que aprisiona a Parches en el Sagrario de Reanimación y que lo ayudes a vengarse del doctor Sabnok.‡La jinete oscura Arly en La Guardia Negra quiere que destruyas la estaca metálica que aprisiona a Parches en el Sagrario de Reanimación y que lo ayudes a vengarse del doctor Sabnok.‡La Cavalière noire Arly, au Guet noir, vous demande de détruire le Pieu en métal qui retient Sutures dans le Sanctum de réanimation, puis de l\'aider à prendre sa revanche sur le Docteur Sabnok.‡黑色观察站的黑暗骑士阿尔蕾要你进入复生密室，摧毁囚禁“补丁”的金属桩，并且帮助它击败萨布诺克博士。‡黑色守望的黑騎兵阿爾利，要你在再活化聖所中，摧毀束縛補釘的金屬樁，並協助他完成對賽伯諾克博士的復仇。',
  }
},
[13153] = {
  {
    'Proteção para os guerreiros‡Охрана для воинов‡Die Krieger schützen‡전사들에게 갑옷을‡Proteger a los guerreros‡Proteger a los guerreros‡Protéger les guerriers‡保护士兵‡保衛勇士',
    nil,
    'A Feiticeira Kaylana na Fortaleza Invérnia quer que você tome 10 Armaduras da Horda Imbuídas de jogadores da Horda na Cachoeira Glacial.‡Принесите 10 комплектов прочных доспехов Орды из Ледопадов по приказу колдуньи Кайланы из крепости Ледяных Оков.‡Zauberin Kaylana in der Tausendwinterfestung möchte, dass Ihr zu den Eiswasserfällen geht und den Hordlern dort 10 magieerfüllte Rüstungen abnehmt.‡겨울손아귀 요새에 있는 여마법사 케일라나가 빙하 폭포에 있는 호드 전투원들에게서 10개의 마력 깃든 호드 갑옷을 회수해 달라고 했습니다.‡La hechicera Kaylana en la Fortaleza de Conquista del Invierno quiere que arrebates 10 conjuntos de armadura de la Horda imbuida a los jugadores de la Horda en las Cascadas Glaciales.‡La hechicera Kaylana en la Fortaleza de Conquista del Invierno quiere que arrebates 10 conjuntos de armadura de la Horda imbuida a los jugadores de la Horda en las Cascadas Glaciales.‡La Sorcière Kaylana, à la Forteresse de Joug-d\'hiver, veut que vous récupériez 10 Armures imprégnées de la Horde, aux Chutes glaciales.‡冬拥堡垒的女巫凯兰娜要你前往冰川瀑布，从部落玩家身上收集10套灌魔的部落护甲。‡冬握堡壘的巫女凱拉娜要你前往冰川瀑布，從部落玩家身上收集10件灌魔部落護甲。',
  }
},
[13154] = {
  {
    'Ossos e flechas‡Кости и стрелы‡Pfeil und Knochen‡뼈와 화살‡Huesos y flechas‡Huesos y flechas‡Des os et des flèches‡骨头和箭矢‡龍骨與箭頭',
    nil,
    'O Arqueiro Ranulfo na Fortaleza Invérnia quer que você tome 10 Aljavas de Flechas de Osso de Dragão de jogadores da Horda na Floresta das Sombras.‡По просьбе лучника Рендольфа из крепости Ледяных Оков отнимите 10 колчанов со стрелами из драконьих костей у игроков Орды в лесу Теней.‡Bogenmacher Randolph in der Tausendwinterfestung möchte, dass Ihr in den Schattenwald geht und den Hordlern dort 10 Köcher mit Drachenknochenpfeilen abnehmt.‡겨울손아귀 요새에 있는 보우이어 란돌프가 그늘진 수풀에 있는 호드 전투원에게서 용뼈 화살통 10개를 회수해 와 달라고 했습니다.‡El arquero Randolph en la Fortaleza de Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Horda de El Bosque de las Sombras.‡El arquero Randolph en la Fortaleza de Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Horda de El Bosque de las Sombras.‡Le Fabricant d\'arcs Randolph, à la Forteresse de Joug-d\'hiver, vous a demandé de récupérer 10 Carquois de flèches en os de dragon à la Forêt des Ombres.‡冬拥堡垒的制弓师兰多尔弗要你前往阴影森林，从部落玩家那里抢夺10支龙骨箭。‡冬握堡壘的弓箭商藍道夫要你前往暗影森林，從部落玩家身上取得10個龍骨箭袋。',
  }
},
[13155] = {
  {
    'Vereth, o Astuto‡Верет Хитрый‡Vereth der Gewiefte‡교활한 베레스‡Vereth el Maquiavélico‡Vereth el Maquiavélico‡Vereth le Fourbe‡狡诈者维雷斯‡奸詐的維瑞希',
    nil,
    'Apresente-se a Vereth, o Astuto, na Beira do Sofrimento, que fica na Coroa de Gelo.‡Разыщите Верета Хитрого на Высоте Страдания в Ледяной Короне.‡Meldet Euch bei Vereth dem Gewieften auf der Anhöhe des Leidens in Eiskrone.‡얼음왕관 고통의 언덕에 있는 교활한 베레스에게 보고해야 합니다.‡Preséntate ante Vereth el Maquiavélico en el Alto del Sufrimiento, en Corona de Hielo.‡Preséntate ante Vereth el Maquiavélico en el Alto del Sufrimiento, en Corona de Hielo.‡Présentez-vous à Vereth le Fourbe à la Cime de Souffrance, dans la Couronne de glace.‡向苦难高地的狡诈者维雷斯报到。‡到寒冰皇冠的苦難高崗上找奸詐的維瑞希報到。',
  }
},
[13156] = {
  {
    'Uma erva extraordinária‡Редкое растение‡Ein seltenes Kraut‡희귀한 약초‡Una hierba única‡Una hierba única‡Une herbe rare‡稀有的草药‡罕見的草藥',
    nil,
    'A Anacoreta Tessa na Fortaleza Invérnia quer que você tome 10 Bolsas de Herborismo da Horda de jogadores da Horda na Estepe da Vida.‡Отберите по просьбе анахорета Тессы из крепости Ледяных Оков 10 сумок Орды с травами у ордынских игроков в степях Жизни.‡Anachoret Tessa in der Tausendwinterfestung möchte, dass Ihr in die Lebendige Steppe geht und den Hordlern dort 10 Kräuterbeutel der Horde abnehmt.‡겨울손아귀 요새에 있는 수도사 테사가 생명의 평원에 있는 호드 전투원에게서 호드 약초 주머니 10개를 회수해 달라고 했습니다.‡La anacoreta Tessa, en la Fortaleza de Conquista del Invierno, quiere que arrebates 10 faltriqueras de hierbas de la Horda a los jugadores de la Horda en Las Estepas de la Vida.‡La anacoreta Tessa, en la Fortaleza de Conquista del Invierno, quiere que arrebates 10 faltriqueras de hierbas de la Horda a los jugadores de la Horda en Las Estepas de la Vida.‡L\'Anachorète Tessa, à la Forteresse de Joug-d\'hiver, vous a demandé de récupérer 10 Bourses d\'herbes de la Horde sur des personnages-joueurs de la Horde, dans les steppes de la Vie.‡冬拥堡垒的学者特尔萨要你前往生命草原，收集10只部落草药包。‡冬握堡壘的隱士泰莎要你前往生命冷原，從部落玩家身上取得10個部落草藥袋。',
  }
},
[13157] = {
  {
    'O Pináculo dos Cruzados‡Вершина Рыцарей‡Der Kreuzfahrerturm‡십자군 봉우리‡El Pináculo de los Cruzados‡El Pináculo de los Cruzados‡La cime des Croisés‡北伐军之峰‡十字軍之巔',
    nil,
    'Procure o Grão-lorde Tirion Fordring no Pináculo dos Cruzados, que fica na Coroa de Gelo.‡Разыщите верховного лорда Тириона Фордринга на Вершине Рыцарей в Ледяной Короне.‡Sucht den Hochlord Tirion Fordring beim Kreuzfahrerturm in Eiskrone auf.‡얼음왕관의 십자군 봉우리에서 대영주 티리온 폴드링을 찾아야 합니다.‡Busca al alto señor Tirion Vadín en el Pináculo de los Cruzados en Corona de Hielo.‡Busca al alto señor Tirion Vadín en el Pináculo de los Cruzados en Corona de Hielo.‡Allez trouver le Généralissime Tirion Fordring à la Cime des Croisés dans la Couronne de glace.‡前往冰冠冰川的北伐军之峰，寻找大领主提里奥·弗丁。‡在寒冰皇冠的十字軍之巔上，找到大領主提里奧·弗丁。',
  }
},
[13158] = {
  {
    'Discrição é tudo‡Главное – скрытность‡Diskretion ist der Schlüssel‡신중함이 관건이다‡La discreción es la clave‡La discreción es la clave‡La discrétion avant tout‡谨慎行事‡謹慎是關鍵',
    nil,
    'Rhonin quer que você vá ao Castelo Violeta em Dalaran e fale com o Carcereiro Alturas.‡Отправляйтесь в Аметистовую крепость в Даларане и поговорите с тюремщиком Альтурасом по поручению Ронина.‡Rhonin möchte, dass Ihr zur Violetten Festung in Dalaran geht und mit Aufseher Alturas sprecht.‡로닌이 달라란에 있는 보랏빛 요새로 가서 교도관 알투라스와 대화해 달라고 했습니다.‡Rhonin quiere que vayas al Bastión Violeta en Dalaran y que hables con el celador Alturas.‡Rhonin quiere que vayas al Bastión Violeta en Dalaran y que hables con el celador Alturas.‡Rhonin vous demande d\'aller au Fort Pourpre à Dalaran et de parler au Gardien Alturas.‡罗宁希望你前往达拉然的紫罗兰监狱，与典狱官奥图拉斯谈一谈。‡羅甯要你前往達拉然的紫羅蘭堡，並與守望者艾圖拉斯交談。',
  }
},
[13159] = {
  {
    'Contenção‡Сдерживание‡Eindämmung‡봉쇄‡Contención‡Contención‡Confinement‡堵截‡牽制',
    nil,
    'O carcereiro Alturas quer que você entre no Castelo Violeta e dê cabo da força de invasão dos dragões azuis. Você deve se apresentar a ele novamente uma vez que Cyanigosa esteja morta.‡Проникните по заданию тюремщика Альтураса в Аметистовую крепость и покончите с атакующими силами синих драконов. Вернитесь к нему с докладом, когда Синигоса будет повержена.‡Aufseher Alturas möchte, dass Ihr die Violette Festung betretet und den Invasionsstreitkräften des blauen Drachenschwarms ein Ende bereitet. Ihr sollt Euch wieder bei ihm melden, sobald Cyanigosa getötet wurde.‡보랏빛 요새로 들어가서 푸른용군단 침입자인 시아니고사를 처치한 다음 교도관 알투라스에게 돌아가서 보고해야 합니다.‡El celador Alturas quiere que entres en El Bastión Violeta y acabes con las fuerzas invasoras de los dragones azules. Preséntate ante él cuando hayas matado a Cianigosa.‡El celador Alturas quiere que entres en El Bastión Violeta y acabes con las fuerzas invasoras de los dragones azules. Preséntate ante él cuando hayas matado a Cianigosa.‡Le Gardien Alturas vous demande de pénétrer dans le Fort Pourpre et d\'éliminer la force d\'invasion des Dragons bleus. Retournez le voir une fois Cyanigosa tuée.‡典狱官奥图拉斯希望你进入紫罗兰监狱，消灭入侵的蓝龙军团。杀死塞安妮苟萨之后向他复命。‡守望者艾圖拉斯要你進入紫羅蘭堡，並擊退藍龍的攻勢。一旦霞妮苟莎被殺害，向艾圖拉斯回報。',
  }
},
[13160] = {
  {
    'Vista estonteante‡Сногсшибательное зрелище‡Eine überwältigende Aussicht‡숨막히는 광경‡Vista impresionante‡Vista impresionante‡Une vision étonnante‡壮观的景象‡慘不忍睹',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você use a habilidade Arremessar de um Espreitador Ágil para destruir 12 Sentinelas Criodermas adormecidas.‡По поручению Верета Хитрого с Высоты Страдания с помощью гибкого ловца поднимитесь к караульным ледошкурам и убейте 12 из них.‡Vereth der Gewiefte möchte, dass Ihr die Hebefähigkeiten des geschmeidigen Pirschers benutzt, um 12 schlafende Eishautwachposten zu zerstören.‡고통의 언덕에 있는 교활한 베레스가 흐물거리는 추적자의 도약 능력을 이용하여 잠들어 있는 얼음가죽 파수꾼 12마리를 처치해 달라고 했습니다.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que uses la capacidad de empuje del acechador ágil para acabar con 12 avizores Piel de Hielo dormidos.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que uses la capacidad de empuje del acechador ágil para acabar con 12 avizores Piel de Hielo dormidos.‡Vereth le Fourbe, à la Cime de Souffrance, vous demande d\'utiliser la compétence en saut d\'un Traqueur agile pour détruire 12 Factionnaires peau-de-glace endormis.‡苦难高地的狡诈者维雷斯要你使用轻盈追迹者的跳跃能力，杀死12只熟睡的冰肤斥候。‡苦難高崗上奸詐的維瑞希要你使用輕盈潛獵者的投擲技能，摧毀12個睡眠中的冰膚哨兵。',
  }
},
[13161] = {
  {
    'O cavaleiro do profano‡Всадник Нечестивости‡Der Reiter des Unheiligen‡부정의 기수‡El jinete de lo profano‡El jinete de lo profano‡Le cavalier de l\'impie‡邪恶骑士‡穢邪騎士',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você mate Rokir, o Cavaleiro do Profano.‡Убейте Рокира, всадника Нечестивости, по поручению Верета Хитрого с Высоты Страдания.‡Vereth der Gewiefte auf der Anhöhe des Leidens wünscht, dass Ihr Rokir, den Reiter des Unheiligen, tötet.‡고통의 언덕에 있는 교활한 베레스가 부정의 기수 로키르를 처치해 달라고 했습니다.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que mates a Rokir, el jinete de lo profano.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que mates a Rokir, el jinete de lo profano.‡Vereth le Fourbe, à la Cime de Souffrance, vous demande de tuer Rokir, le Cavalier de l\'Impie.‡苦难高地的狡诈者维雷斯要你杀死洛基尔，邪恶骑士。‡苦難高崗上奸詐的維瑞希要你殺死穢邪騎士洛基爾。',
  }
},
[13162] = {
  {
    'A cavaleira do gelo‡Всадник Льда‡Die Reiterin des Frostes‡냉기의 기수‡La jinete de escarcha‡La jinete de escarcha‡La cavalière du Givre‡冰霜骑士‡冰霜騎士',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você mate Sapph, a Cavaleira do Gelo.‡Убейте Сапф, всадника Льда, по поручению Верета Хитрого с Высоты Страдания.‡Vereth der Gewiefte auf der Anhöhe des Leidens wünscht, dass Ihr Saph, die Reiterin des Frostes tötet.‡고통의 언덕에 있는 교활한 베레스가 냉기의 기수 사프를 처치해 달라고 했습니다.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que mates a Sapph, la jinete de lo profano.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que mates a Sapph, la jinete de lo profano.‡Vereth le Fourbe, à la Cime de Souffrance, vous demande de tuer Saph, la Cavalière du Givre.‡苦难高地的狡诈者维雷斯要你杀死萨芙，冰霜骑士。‡苦難高崗上奸詐的維瑞希要你殺死冰霜騎士莎菲。',
  }
},
[13163] = {
  {
    'O cavaleiro de sangue‡Всадник Крови‡Der Reiter des Blutes‡혈기의 기수‡El jinete de sangre‡El jinete de sangre‡Le cavalier du Sang‡鲜血骑士‡血魄騎士',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, quer que você mate Baelok, o Cavaleiro de Sangue.‡Убейте Бэлока, всадника Крови, по поручению Верета Хитрого с Высоты Страдания.‡Vereth der Gewiefte auf der Anhöhe des Leidens möchte, dass Ihr Baelok, den Reiter des Blutes, tötet.‡고통의 언덕에 있는 교활한 베레스가 혈기의 기수 밸로크를 처치해 달라고 했습니다.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que mates a Baelok, el jinete de sangre.‡Vereth el Maquiavélico en el Alto del Sufrimiento quiere que mates a Baelok, el jinete de sangre.‡Vereth le Fourbe, à la Cime de Souffrance, vous demande de tuer Baelok, le Cavalier du Sang.‡苦难高地的狡诈者维雷斯要你杀死贝洛克，鲜血骑士。‡苦難高崗上奸詐的維瑞希要你殺死血魄騎士貝洛克。',
  }
},
[13164] = {
  {
    'O destino de Ruinassangue‡Судьба Кровопорча‡Blutbanns Schicksal‡블러드베인의 최후‡El destino de Malasangre‡El destino de Malasangre‡Le destin de Sangreplaie‡血毒的命运‡血禍的命運',
    nil,
    'Vereth, o Astuto, na Beira do Sofrimento, enviou você para matar Orbaz Ruinassangue.‡Убейте Орбаза Кровопорча по поручению Верета с Высоты Страдания.‡Vereth auf der Anhöhe des Leidens hat Euch ausgesandt, um Orbaz Blutbann zu töten.‡고통의 언덕에 있는 베레스가 오르바즈 블러드베인을 처치해 달라고 했습니다.‡Vereth en el Alto del Sufrimiento te ha enviado a matar a Orbaz Malasangre.‡Vereth en el Alto del Sufrimiento te ha enviado a matar a Orbaz Malasangre.‡Vereth, à la Cime de Souffrance, vous a envoyé tuer Orbaz Sangreplaie.‡苦难高地的狡诈者维雷斯要你杀死奥尔巴兹·血毒。‡苦難高崗上奸詐的維瑞希派遣你去殺死歐貝茲·血禍。',
  }
},
[13165] = {
  {
    'A retomada de Áquerus‡Возвращение в Акерус‡Acherus zurückerobern‡아케루스 되찾기‡Recuperar Acherus‡Recuperar Acherus‡Reprendre Achérus‡夺回阿彻鲁斯‡奪回亞榭洛',
    nil,
    'Use seu feitiço Portão da Morte para retornar a Áquerus: a Fortaleza de Ébano. Apresente-se ao Grão-lorde Dárion Mograine quando chegar.‡Воспользуйтесь заклинанием Врат смерти, чтобы вернуться в Акерус: Черный оплот, и найдите там верховного лорда Дариона Могрейна.‡Benutzt Euren Zauber \'Schwarzes Tor\' und kehrt nach Acherus, der Schwarzen Festung, zurück. Meldet Euch bei Hochlord Darion Mograine, sobald Ihr dort seid.‡죽음의 관문 주문을 사용하여 아케루스: 칠흑의 요새로 돌아가 대영주 다리온 모그레인에게 보고해야 합니다.‡Usa el hechizo Portón de la muerte para volver a Acherus: El Bastión de Ébano. Informa al alto señor Darion Mograine cuando llegues.‡Usa el hechizo Portón de la muerte para volver a Acherus: El Bastión de Ébano. Informa al alto señor Darion Mograine cuando llegues.‡Servez-vous du sort Porte de la mort pour retourner à Achérus : le fort d’Ébène. À votre arrivée, présentez-vous au Généralissime Darion Mograine.‡使用你的黑锋之门法术返回阿彻鲁斯：黑锋要塞。抵达阿彻鲁斯之后，向大领主达里安·莫格莱尼报到。‡使用死亡之門回到亞榭洛:黯黑堡。抵達後立刻向大領主達瑞安·莫格萊尼報到。',
  }
},
[13166] = {
  {
    'A batalha pela Fortaleza de Ébano‡Битва за Черный оплот‡Die Schlacht um die Schwarze Festung‡칠흑의 요새를 위한 전투‡La batalla por El Bastión de Ébano‡La batalla por El Bastión de Ébano‡La bataille pour le fort d\'Ébène‡黑锋要塞之战‡黯黑堡爭奪戰',
    nil,
    'Mate 10 membros do Flagelo e ajude a matar o Retalhoso. Fale novamente com o Grão-lorde Dárion Mograine, se tiver sucesso.‡Убейте 10 солдат Плети и помогите одолеть Лоскутика, после чего вернитесь к верховному лорду Дариону Могрейну.‡Vernichtet 10 Diener der Geißel und helft, Flickwerk zu vernichten. Kehrt zu Hochlord Darion Mograine zurück, solltet Ihr erfolgreich sein.‡스컬지 10마리를 처치하고 죽음의 기사들과 함께 패치워크를 쓰러뜨린 다음 대영주 다리온 모그레인에게 가야 합니다.‡Mata a 10 miembros de la Plaga y ayuda a matar a Remendejo. Vuelve con el alto señor Darion Mograine si lo consigues.‡Mata a 10 miembros de la Plaga y ayuda a matar a Remendejo. Vuelve con el alto señor Darion Mograine si lo consigues.‡Tuez 10 créatures du Fléau et aidez à tuer Recousu. Si vous y parvenez, retournez auprès du Généralissime Darion Mograine.‡杀死10个天灾亡灵，并参与消灭帕奇维克的战斗。成功之后，回去向大领主达里安·莫格莱尼复命。‡殺掉10個天譴軍團，並協助殺掉縫補者。事成之後，向大領主達瑞安·莫格萊尼回報。',
  }
},
[13167] = {
  {
    'Morte ao rei traidor‡Смерть королю-предателю!‡Tod dem Verräterkönig‡배신자 왕에게 죽음을‡Muerte al rey traidor‡Muerte al rey traidor‡Mort au roi traître‡叛徒国王之死‡狙殺逆王',
    nil,
    'Kilix, o Desfiador, no Fosso de Narjun, deu a você a missão de vencer Anub\'arak em Azjol-Nerub. Você deve falar novamente com Kilix tendo a Carapaça Quebrada de Anub\'arak em mãos.‡Одержите победу над Ануб\'араком из Азжол-Неруба и принесите Киликсу Разрушителю в Провал Наржуна разбитый панцирь Ануб\'арака.‡Kilix der Entwirrer in der Grube von Narjun hat Euch damit beauftragt, Anub\'arak in Azjol-Nerub zu besiegen. Danach sollt Ihr Kilix Anub\'araks zerbrochenen Panzer zurückbringen.‡나르준의 구덩이에 있는 해결자 킬릭스가 아졸네룹에 있는 아눕아락을 처치해 달라고 했습니다. 아눕아락의 부서진 허물을 가지고 킬릭스에게 돌아와야 합니다.‡Kilix el Desenmarañador en El Foso de Narjun te ha encargado que derrotes a Anub\'arak en Azjol-Nerub. Debes regresar junto a Kilix con el caparazón de Anub\'arak roto.‡Kilix el Desenmarañador en El Foso de Narjun te ha encargado que derrotes a Anub\'arak en Azjol-Nerub. Debes regresar junto a Kilix con el caparazón de Anub\'arak roto.‡Kilix le Démêleur, à la Fosse de Narjun, veut que vous triomphiez d’Anub’arak à Azjol-Nérub. Vous devez lui rapporter la Carcasse brisée d’Anub’arak.‡纳尔苏深渊的拆解者基里克斯要你去击败艾卓-尼鲁布的阿努巴拉克，并将阿努巴拉克的破损甲壳交给基里克斯。‡那金之淵裡的『排除者』齊力克斯交付給你一個任務，要你擊敗阿茲歐-奈幽的阿努巴拉克。然後將阿努巴拉克的裂殼帶回給齊力克斯。',
  }
},
[13168] = {
  {
    'Presentes de despedida‡Простой урок‡Abschiedsgeschenke‡작별의 선물‡Regalos de despedida‡Regalos de despedida‡Cadeaux de départ‡离别礼物‡臨別禮物',
    nil,
    'Keritos Laminassangre, na Abóbada das Sombras, quer que você use um Olho de Domínio para controlar um Vigia Eidolon capturado.‡По заданию Керитоза Кровавого Клинка из Мрачного Свода возьмите под свой контроль пойманного эйдолонского наблюдателя, используя глаз власти.‡Keritose Blutklinge im Schattengewölbe möchte, dass Ihr eins der Augen der Herrschaft benutzt, um die Kontrolle über einen gefangenen Eidolonwächter zu übernehmen.‡어둠의 무기고에 있는 케리토스 블러드블레이드가 지배의 눈을 사용하여 사로잡힌 허깨비 감시자를 조종해 달라고 했습니다.‡Keritose Sangrehoja en La Cámara de las Sombras quiere que uses un ojo de dominio para controlar a un vigía de Eidolon capturado.‡Keritose Sangrehoja en La Cámara de las Sombras quiere que uses un ojo de dominio para controlar a un vigía de Eidolon capturado.‡Keritose Lame-sanglante, du Caveau des Ombres, vous a demandé d\'utiliser un Œil d\'assujettissement pour prendre le contrôle d\'un Gardien de l\'Eidolon capturé.‡暗影拱顶的克里托斯·血刃要你使用统御之眼控制一只被捕获的幻象观察者。‡暗影穹殿的凱力多斯·血刃要求你，使用支配之眼以控制一個被俘虜的幻象看守者。',
  }
},
[13169] = {
  {
    'O melhor amigo de um morto-vivo‡Лучший друг нежити‡Der beste Freund des Untoten‡언데드의 둘도 없는 친구‡El mejor amigo de un no-muerto‡El mejor amigo de un no-muerto‡Le meilleur ami du mort-vivant‡亡灵的好朋友‡不死生物的忠實朋友',
    nil,
    'Keritos Laminassangre, na Abóbada das Sombras, quer que você use o Vigia Eidolon para alimentar 18 Cães Pestilentos Famintos.‡По просьбе Керитоза Кровавого Клинка из Мрачного Свода накормите с помощью эйдолонского наблюдателя 18 проголодавшихся чумных псов.‡Keritose Blutklinge im Schattengewölbe wünscht, dass Ihr mithilfe des Eidolonwächters 18 hungernde Seuchenhunde füttert.‡어둠의 무기고에 있는 케리토스 블러드블레이드가 허깨비 감시자를 조종하여 굶주린 역병사냥개 18마리에게 먹이를 주라고 했습니다.‡Keritose Sangrehoja en La Cámara de las Sombras quiere que uses al vigía de Eidolon para alimentar a 18 canes de peste hambrientos.‡Keritose Sangrehoja en La Cámara de las Sombras quiere que uses al vigía de Eidolon para alimentar a 18 canes de peste hambrientos.‡Keritose Lame-sanglante, du Caveau des Ombres, vous demande d\'utiliser le Gardien de l\'Eidolon pour nourrir 18 Chiens pestiférés efflanqués.‡暗影拱顶的克里托斯·血刃要你使用幻象观察者给18条饥饿的瘟疫恶犬喂食。‡暗影穹殿的凱力多斯·血刃要求你，利用幻像看守者餵飽18隻飢餓的瘟疫獵犬。',
  }
},
[13170] = {
  {
    'Honra é para os fracos‡Честь – удел слабых‡Ehre ist was für Schwächlinge‡존경은 약한 자의 것‡El honor es para los blandengues‡El honor es para los blandengues‡L\'honneur, c\'est pour les faibles‡不择手段‡弱者才需要榮耀',
    nil,
    'Keritos Laminassangre, na Abóbada das Sombras, quer que você mate 20 Vigias Inquietos.‡Убейте 20 неутомимых дозорных по поручению Керитоза Кровавого Клинка из Мрачного Свода.‡Keritose Blutklinge im Schattengewölbe hätte gerne, dass Ihr 20 ruhelose Aufklärer tötet.‡어둠의 무기고에 있는 케리토스 블러드블레이드가 잠 못 드는 망꾼 20마리를 암살해 달라고 했습니다.‡A Keritose Sangrehoja en La Cámara de las Sombras le gustaría que asesinaras a 20 oteadores inquietos.‡A Keritose Sangrehoja en La Cámara de las Sombras le gustaría que asesinaras a 20 oteadores inquietos.‡Keritose Lame-sanglante, du Caveau des Ombres, voudrait que vous assassiniez 20 Guetteurs sans repos.‡暗影拱顶的克里托斯·血刃要你去刺杀20名永不休息的斥候。‡暗影穹殿的凱力多斯·血刃希望你去暗殺20個不安的監視者。',
  }
},
[13171] = {
  {
    'De onde eles vieram‡Откуда придет удар‡Schickt sie zurück‡어디서 나온 물건인가?‡Por donde vinieron‡Por donde vinieron‡D\'où ils sont venus‡来去无踪‡從何而來',
    nil,
    'Keritos Laminassangre, na Abóbada das Sombras, mandou você destruir 10 Cristais de Contenção do Flagelo.‡По заданию Керитоза Кровавого Клинка из Мрачного Свода уничтожьте 10 сдерживающих кристаллов Плети.‡Keritose Blutklinge im Schattengewölbe hat Euch ausgesandt, um 10 Eindämmungskristalle der Geißel zu bannen.‡어둠의 무기고에 있는 케리토스 블러드블레이드가 스컬지 속박의 수정 10개를 파괴해 달라고 했습니다.‡Keritose Sangrehoja en La Cámara de las Sombras te ha enviado para que destierres 10 cristales de contención de la Plaga.‡Keritose Sangrehoja en La Cámara de las Sombras te ha enviado para que destierres 10 cristales de contención de la Plaga.‡Keritose Lame-sanglante, du Caveau des Ombres, vous demande de détruire 10 Cristaux de confinement du Fléau.‡暗影拱顶的克里托斯·血刃要你去摧毁10枚天灾污染水晶。‡暗影穹殿的凱力多斯·血刃，派遣你去排除10個天譴牽制水晶。',
  }
},
[13172] = {
  {
    'Sementes do Caos‡Семена Хаоса‡Chaos säen‡혼돈의 씨앗‡Semillas de caos‡Semillas de caos‡Les graines du chaos‡混乱之种‡混亂之源',
    nil,
    'Keritos Laminassangre, na Abóbada das Sombras, enviou você para matar 80 mortos-vivos na Pedreira dos Lamentos. Fale com ele para obter um grifo descarnado para o ataque.‡По указанию Керитоза Кровавого Клинка из Мрачного Свода уничтожьте 80 солдат нежити в Саронитовом карьере. Попросите у него грифона-скелета.‡Keritose Blutklinge im Schattengewölbe hat Euch ausgesandt, um 80 Untote im Tränenbruch abzuschlachten. Sprecht mit ihm, um Euch einen Skelettgreifen für den Angriff zu sichern.‡어둠의 무기고에 있는 케리토스 블러드블레이드가 진흙탕 채석장에서 80마리의 언데드를 처치해 달라고 했습니다. 해골 그리핀을 타고 공격을 시작하려면 그와 대화해야 합니다.‡Keritose Sangrehoja en La Cámara de las Sombras te ha enviado para que masacres a 80 no-muertos en la Cantera Llorosa. Habla con él para procurarte un grifo esquelético para el asalto.‡Keritose Sangrehoja en La Cámara de las Sombras te ha enviado para que masacres a 80 no-muertos en la Cantera Llorosa. Habla con él para procurarte un grifo esquelético para el asalto.‡Keritose Lame-sanglante, du Caveau des Ombres, vous a demandé de tuer 80 morts-vivants dans la Carrière des Larmes. Parlez-lui pour obtenir un Griffon squelette pour le combat.‡暗影拱顶的克里托斯·血刃要你前往哭泣采掘场，杀死80个亡灵。与他对话就可以获得进攻用的骷髅狮鹫。‡暗影穹殿的凱力多斯·血刃，派遣你去哀泣礦場並屠殺80個不死生物。和他對話，以取得一頭骷髏獅鷲獸協助你進行突襲。',
  }
},
[13173] = {
  {
    '‡Под шумок‡Das Durcheinander nutzen‡혼란의 틈‡En medio de la confusión‡En medio de la confusión‡Profiter de la confusion‡Amidst the Confusion‡',
    nil,
    nil,
  }
},
[13174] = {
  {
    'Em meio à confusão‡Под шумок‡Das Durcheinander nutzen‡혼란의 틈‡En medio de la confusión‡En medio de la confusión‡Dans la confusion‡一片狼藉‡騷動之中',
    nil,
    'Keritos Laminassangre, na Abóbada das Sombras, solicitou que você obtivesse o Documento da Pedreira dos Lamentos, o Livro-caixa da Pedreira dos Lamentos, o Mapa da Pedreira dos Lamentos e a Escala da Pedreira dos Lamentos.‡Принесите документ из Саронитового карьера, гроссбух Саронитового карьера, карту Саронитового карьера и расписание работ в Саронитовом карьере Керитозу Кровавому Клинку в Мрачный Свод.‡Keritose Blutklinge im Schattengewölbe verlangt ein Dokument des Tränenbruchs, ein Geschäftsbuch des Tränenbruchs, eine Karte des Tränenbruchs und einen Zeitplan des Tränenbruchs.‡어둠의 무기고에 있는 케리토스 블러드블레이드가 진흙탕 채석장 장부, 진흙탕 채석장 지도, 진흙탕 채석장 일정표, 진흙탕 채석장 문서를 구해다 달라고 했습니다.‡Keritose Sangrehoja en La Cámara de las Sombras te ha pedido que consigas un documento de Cantera Llorosa, un libro de Cantera Llorosa, un mapa de Cantera Llorosa y un horario de Cantera Llorosa.‡Keritose Sangrehoja en La Cámara de las Sombras te ha pedido que consigas un documento de Cantera Llorosa, un libro de Cantera Llorosa, un mapa de Cantera Llorosa y un horario de Cantera Llorosa.‡Keritose Lame-sanglante, du Caveau des Ombres, vous a demandé un Document de la carrière des Larmes, un Plan de la carrière des Larmes, une Carte de la carrière des Larmes et un Emploi du temps de la carrière des Larmes.‡将哭泣采掘场文档、哭泣采掘场账目、哭泣采掘场地图和哭泣采掘场进度表交给暗影拱顶的克里托斯·血刃。‡暗影穹殿的凱力多斯·血刃要你取回一份哀泣礦場文件、一份哀泣礦場帳本、一份哀泣礦場地圖和一份哀泣礦場日程表。',
  }
},
[13175] = {
  {
    '‡Восстановление контроля‡Die Kontrolle zurückgewinnen‡통제권 회복‡Volver a tomar las riendas‡Volver a tomar las riendas‡Reprendre le contrôle‡Regaining Control‡',
    nil,
    nil,
  }
},
[13176] = {
  {
    '‡Подготовка к доставке‡Die Lieferung vorbereiten‡배달 준비‡Preparar la entrega‡Preparar la entrega‡Préparation de la livraison‡Preparing the Delivery‡',
    nil,
    nil,
  }
},
[13177] = {
  {
    'Sem piedade para com os impiedosos‡Беспощадным пощады не будет‡Keine Gnade für die Gnadenlosen‡무자비한 자들에겐 자비도 없다‡Sin piedad para los despiadados‡Sin piedad para los despiadados‡Pas de pitié pour les sans pitié‡绝不留情‡以其人之道，還治其人之身',
    nil,
    'O Comandante Zanneth na Fortaleza Invérnia quer que você mate 10 membros da Horda.‡Убейте 10 игроков Орды по приказу командира Заннета из крепости Ледяных Оков.‡Hauptmann Zanneth in der Tausendwinterfestung möchte, dass Ihr 10 Mitglieder der Horde tötet.‡겨울손아귀 요새에 있는 사령관 자네스가 호드의 일원 10명을 처치해 달라고 했습니다.‡El comandante Zanneth en la Fortaleza de Conquista del Invierno quiere que mates a 10 miembros de la Horda.‡El comandante Zanneth en la Fortaleza de Conquista del Invierno quiere que mates a 10 miembros de la Horda.‡Le Commandant Zanneth, à la Forteresse de Joug-d\'hiver, vous a demandé de tuer 10 membres de la Horde.‡冬拥堡垒的指挥官萨纳斯要你去杀死10个部落玩家。‡冬握堡壘的指揮官桑奈希要求你殺掉10個部落成員。',
  }
},
[13178] = {
  {
    'Mate todos eles!‡Всех убить!‡Tötet sie alle!‡모두 없애라!‡¡Mátalos a todos!‡¡Mátalos a todos!‡Tuez-les tous !‡全都干掉！‡趕盡殺絕!',
    nil,
    'O Comandante Dardosh na Fortaleza Invérnia quer que você mate 10 membros da Aliança.‡Убейте 10 игроков Альянса по приказу командира Дардоша с Озера Ледяных Оков.‡Kommandant Dardosh in der Tausendwinterfestung möchte, dass Ihr 10 Mitglieder der Allianz tötet.‡겨울손아귀 요새에 있는 지휘관 다르도쉬가 얼라이언스의 일원 10명을 처치해 달라고 했습니다.‡El comandante Dardosh en la Fortaleza de Conquista del Invierno quiere que mates a 10 miembros de la Alianza.‡El comandante Dardosh en la Fortaleza de Conquista del Invierno quiere que mates a 10 miembros de la Alianza.‡Le Commandant Dardosh, à la Forteresse de Joug-d\'hiver, vous a demandé de tuer 10 membres de l\'Alliance.‡冬拥堡垒的指挥官达尔多什要你去杀死10个联盟玩家。‡冬握堡壘的指揮官達多許要求你殺掉10個聯盟成員。',
  }
},
[13179] = {
  {
    'Sem piedade para com os impiedosos‡Беспощадным пощады не будет‡Keine Gnade für die Gnadenlosen‡무자비한 자들에겐 자비도 없다‡Sin piedad para los despiadados‡Sin piedad para los despiadados‡Pas de pitié pour les sans pitié‡绝不留情‡以其人之道，還治其人之身',
    nil,
    'O Comandante Zanneth em Invérnia quer que você mate 10 membros da Horda.‡Убейте 10 игроков Орды по приказу командира Заннета с Озера Ледяных Оков.‡Hauptmann Zanneth in Tausendwinter möchte, dass Ihr 10 Mitglieder der Horde tötet.‡겨울손아귀에 있는 사령관 자네스가 호드의 일원 10명을 처치해 달라고 했습니다.‡El comandante Zanneth en Conquista del Invierno quiere que mates a 10 miembros de la Horda.‡El comandante Zanneth en Conquista del Invierno quiere que mates a 10 miembros de la Horda.‡Le Commandant Zanneth, à Joug-d\'hiver, vous a demandé de tuer 10 membres de la Horde.‡冬拥湖的指挥官萨纳斯要你去杀死10个部落士兵。‡冬握湖的指揮官桑奈希要求你殺掉10個部落成員。',
  }
},
[13180] = {
  {
    'Mate todos eles!‡Всех убить!‡Tötet sie alle!‡모두 없애라!‡¡Mátalos a todos!‡¡Mátalos a todos!‡Tuez-les tous !‡全都干掉！‡趕盡殺絕!',
    nil,
    'O Comandante Dardosh em Invérnia quer que você mate 10 membros da Aliança.‡Убейте 10 игроков Альянса по приказу командира Дардоша с Озера Ледяных Оков.‡Kommandant Dardosh in Tausendwinter möchte, dass Ihr 10 Mitglieder der Allianz tötet.‡겨울손아귀에 있는 지휘관 다르도쉬가 얼라이언스의 일원 10명을 처치해 달라고 했습니다.‡El comandante Dardosh en Conquista del Invierno quiere que mates a 10 miembros de la Alianza.‡El comandante Dardosh en Conquista del Invierno quiere que mates a 10 miembros de la Alianza.‡Le Commandant Dardosh, à Joug-d\'hiver, vous a demandé de tuer 10 membres de l\'Alliance.‡冬拥湖的指挥官达尔多什要你去杀死10个联盟玩家。‡冬握堡壘的指揮官達多許要求你殺掉10個聯盟成員。',
  }
},
[13181] = {
  {
    'Vitória em Invérnia‡Победа на Озере Ледяных Оков‡Sieg in Tausendwinter‡겨울손아귀에서의 승리‡Victoria en Conquista del Invierno‡Victoria en Conquista del Invierno‡Victoire à Joug-d\'hiver‡冬拥湖的胜利‡冬握之捷',
    nil,
    'Vença uma partida no campo de batalha de Invérnia e fale novamente com o Oficial Tático Ahbramis em Invérnia. Você precisa ter participado da batalha para receber crédito pela vitória.‡Выиграйте битву на Озере Ледяных Оков и вернитесь к офицеру-стратегу Абрамису. Необходимо принять участие в битве, чтобы выиграть ее.‡Gewinnt einen Kampf auf dem Schlachtfeld in Tausendwinter und kehrt dann zu Taktikoffizier Ahbramis zurück. Ihr müsst an der Schlacht teilgenommen haben, um für den Sieg belohnt zu werden.‡겨울손아귀 전장 전투에서 승리한 후 겨울손아귀에 있는 전술장교 아브라미스에게 가야 합니다. 승리를 보장할 수 있도록 전투에 참여해야 합니다.‡Gana un encuentro en el campo de batalla de Conquista del Invierno y vuelve a ver al oficial de táctica Abrahmis en Conquista del Invierno. Tienes que haber participado en la batalla para que se te recompense por la victoria.‡Gana un encuentro en el campo de batalla de Conquista del Invierno y vuelve a ver al oficial de táctica Abrahmis en Conquista del Invierno. Tienes que haber participado en la batalla para que se te recompense por la victoria.‡Gagnez une bataille sur le champ de bataille de Joug-d\'hiver, et retournez voir l\'Officier tactique Ahbramis, à Joug-d\'hiver.‡取得一场冬拥湖战斗的胜利，然后向冬拥湖的参谋官安布拉米斯复命。你必须亲自参与战斗，才能获得胜利后的奖励。‡在冬握戰場中獲勝，並向冬握湖的戰術軍官阿布拉米斯回報。你必須參與戰鬥才能擁有勝利的榮耀。',
  }
},
[13182] = {
  {
    'Não esqueça os ovos!‡И не забудь про яйца!‡Vergesst die Eier nicht!‡알을 지나치지 말 것!‡¡No olvides de los huevos!‡¡No olvides de los huevos!‡N\'oubliez pas les œufs !‡别忘了蛛卵！‡別忘了那些蛋!',
    nil,
    'Kilix, o Desfiador, no Fosso de Narjun, quer que você entre em Azjol-Nerub e destrua 6 Ovos Nerubianos do Flagelo.‡Проникните в Азжол-Неруб по просьбе Киликса Разрушителя из Провала Наржуна и уничтожьте 6 нерубских яиц Плети.‡Kilix der Entwirrer in der Grube von Narjun möchte, dass Ihr Azjol-Nerub betretet und 6 Eier der Geißelneruber zerstört.‡나르준의 구덩이에 있는 해결자 킬릭스가 아졸네룹으로 들어가 네루비안 스컬지 알 6개를 파괴해 달라고 했습니다.‡Kilix el Desenmarañador en El Foso de Narjun quiere que entres en Azjol-Nerub y destruyas 6 huevos de la Plaga nerubianos.‡Kilix el Desenmarañador en El Foso de Narjun quiere que entres en Azjol-Nerub y destruyas 6 huevos de la Plaga nerubianos.‡Kilix le Démêleur, à la Fosse de Narjun, veut que vous pénétriez dans Azjol-Nérub pour y détruire 6 Œufs de nérubiens du Fléau.‡纳尔苏深渊的拆解者基里克斯希望你前往艾卓-尼鲁布，摧毁6枚天灾蛛魔之卵。‡那金之淵裡的『排除者』齊力克斯，要你進入阿茲歐-奈幽並摧毀6個奈幽天譴蛋。',
  }
},
[13183] = {
  {
    'Vitória em Invérnia‡Победа на Озере Ледяных Оков‡Sieg in Tausendwinter‡겨울손아귀에서의 승리‡Victoria en Conquista del Invierno‡Victoria en Conquista del Invierno‡Victoire à Joug-d\'hiver‡冬拥湖的胜利‡冬握之捷',
    nil,
    'Vença uma partida no campo de batalha de Invérnia e fale novamente com o Oficial Tático Kilrath em Invérnia. Você precisa ter participado da batalha para obter crédito pela vitória.‡Выиграйте битву на поле боя Озера Ледяных Оков и вернитесь к офицеру-стратегу Килрату в крепость Ледяных Оков. Необходимо принять участие в битве, чтобы выиграть ее.‡Gewinnt einen Kampf in einem Schlachtfeld von Tausendwinter und kehrt anschließend zu Taktikoffizier Kilrath in Tausendwinter zurück. Ihr müsst an der Schlacht teilgenommen haben, um für den Sieg belohnt zu werden.‡겨울손아귀 전장 전투에서 승리한 후 겨울손아귀에 있는 전술장교 킬라스에게 가야 합니다. 승리를 보장할 수 있도록 전투에 참여해야 합니다.‡Gana un encuentro en el campo de batalla de Conquista del Invierno y vuelve a ver al oficial de táctica Kilrath en Conquista del Invierno. Tienes que haber participado en la batalla para que se te recompense por la victoria.‡Gana un encuentro en el campo de batalla de Conquista del Invierno y vuelve a ver al oficial de táctica Kilrath en Conquista del Invierno. Tienes que haber participado en la batalla para que se te recompense por la victoria.‡Gagnez une bataille sur le champ de bataille de Joug-d\'hiver, et retournez voir l\'Officier tactique Kilrath, à Joug-d\'hiver.‡赢得一场冬拥湖战斗的胜利，然后向冬拥湖的参谋官基尔拉斯复命。你必须亲自参与战斗，才能获得胜利后的奖励。‡在冬握戰場中獲勝，並向冬握湖的戰術軍官科伊瑞斯回報。你必須要參與戰鬥來獲得勝利的證明。',
  }
},
[13184] = {
  {
    '‡Больше нет нужды‡Die Nützlichkeit überdauern‡지속적으로 유용한 존재‡Sobrevivir a la utilidad‡Sobrevivir a la utilidad‡Survivre à l\'utilité‡Outliving Usefulness‡',
    nil,
    nil,
  }
},
[13185] = {
  {
    'Impeça o cerco‡Остановка осады‡Setzt der Belagerung ein Ende‡공성 공격을 막아라‡Parar el asedio‡Parar el asedio‡L\'arrêt du siège‡阻止攻城‡突破重圍',
    nil,
    'O Tenente Murp na Fortaleza Invérnia quer que você destrua 3 máquinas de cerco da Aliança.‡Уничтожьте 3 осадных машины Альянса по приказу лейтенанта Мурпа из крепости Ледяных Оков.‡Leutnant Murp in der Tausendwinterfestung möchte, dass Ihr 3 Belagerungsmaschinen der Allianz zerstört.‡겨울손아귀 요새에 있는 부관 머프가 얼라이언스 공성 전차 3대를 파괴해 달라고 했습니다.‡El teniente Murp en la Fortaleza de Conquista del Invierno quiere que acabes con 3 máquinas de asedio de la Alianza.‡El teniente Murp en la Fortaleza de Conquista del Invierno quiere que acabes con 3 máquinas de asedio de la Alianza.‡Le Lieutenant Murp, à la Forteresse de Joug-d\'hiver, vous a demandé de détruire 3 Engins de siège de l\'Alliance.‡冬拥堡垒的莫普中尉要你摧毁3辆联盟攻城器械。‡冬握堡壘的莫普中尉要你摧毀3台聯盟攻城器械。',
  }
},
[13186] = {
  {
    'Impeça o cerco‡Остановка осады‡Setzt der Belagerung ein Ende‡공성 공격을 막아라!‡Parar el asedio‡Parar el asedio‡L\'arrêt du siège‡阻止攻城‡突破重圍',
    nil,
    'O Demolidor Sênior Ledos na Fortaleza Invérnia quer que você destrua 3 máquinas de cerco da Horda.‡Уничтожьте по приказу главного подрывника Легосо из крепости Ледяных Оков 3 осадных машины Орды.‡Chefdemolierer Legoso in der Tausendwinterfestung möchte, dass Ihr 3 Belagerungsmaschinen der Horde zerstört.‡겨울손아귀 요새에 있는 고위 폭파병 레고소가 호드 공성 전차 3대를 파괴해 달라고 했습니다.‡El demoledor jefe Legoso en la Fortaleza de Conquista del Invierno quiere que destruyas 3 máquinas de asedio de la Horda.‡El demoledor jefe Legoso en la Fortaleza de Conquista del Invierno quiere que destruyas 3 máquinas de asedio de la Horda.‡Le Démolisseur en chef Legoso, à la Forteresse de Joug-d\'hiver, vous a demandé de détruire 3 Engins de siège de la Horde.‡冬拥堡垒的资深攻城技师雷格索要你摧毁3辆部落攻城器械。‡冬握堡壘的資深爆破兵勒茍索要你摧毀3台部落攻城器械。',
  }
},
[13187] = {
  {
    'Os Sem-rosto‡Безликие‡Die Gesichtslosen‡얼굴 없는 자‡Los ignotos‡Los ignotos‡Les Sans-visages‡无面者‡無面者',
    nil,
    'O Vidente Ixit, em Ahn\'Kahet, quer que você mate o Arauto Volazj e os três Olvidados que o acompanham.‡Провидец Изит из Ан\'кахета хочет, чтобы вы убили глашатая Волажа и сопровождающих его трех позабытых.‡Seher Ixit möchte, dass Ihr Herold Volazj und die drei Vergessenen an seiner Seite tötet.‡안카헤트에 있는 예언자 익시트가 사자 볼라즈와, 함께 있는 잊혀진 자 셋을 처치해 달라고 했습니다.‡El vidente Ixit de Ahn\'kahet te ha encomendado el asesinato del heraldo Volazj y de los tres olvidados que lo acompañan.‡El vidente Ixit de Ahn\'kahet te ha encomendado el asesinato del heraldo Volazj y de los tres olvidados que lo acompañan.‡Le Voyant Ixit, dans Ahn’Kahet, veut que vous tuiez le Héraut Volazj et les trois Oubliés qui l’accompagnent.‡安卡赫特的先知伊克塞特要你去杀死传令官沃拉兹和他身边的3个被遗忘的无面者。‡先知伊須特要你殺死信使沃菈齊及其身邊的三個忘卻者。',
  }
},
[13188] = {
  {
    'Onde reis caminham‡Шаги короля‡Auf den Spuren der Könige‡왕이 걷는 길‡El camino de los reyes‡El camino de los reyes‡Là où marche le roi‡王者之城‡諸王之道',
    nil,
    'Entregue a carta para o Rei Varian Wrynn da Aliança, na Bastilha Ventobravo, em Ventobravo.‡Отнесите письмо в Штормград и отдайте королю Вариану Ринну.‡Bringt den Brief zu König Varian Wrynn, Anhänger der Allianz in Burg Sturmwind in Sturmwind.‡스톰윈드 왕궁에 있는 얼라이언스의 국왕 바리안 린에게 편지를 전달해야 합니다.‡Entrega la carta al rey Varian Wrynn de la Alianza en la Fortaleza de Ventormenta en la Ciudad de Ventormenta.‡Entrega la carta al rey Varian Wrynn de la Alianza en la Fortaleza de Ventormenta en la Ciudad de Ventormenta.‡Remettez la lettre au roi Varian Wrynn de l’Alliance, au Donjon de Hurlevent, dans la ville de Hurlevent.‡前往暴风城的暴风要塞，将信交给联盟的瓦里安·乌瑞恩国王。‡把信件送到聯盟的國王，暴風城的暴風要塞中的瓦里安·烏瑞恩。',
  }
},
[13189] = {
  {
    'A bênção do Chefe Guerreiro‡Благословение вождя‡Der Segen des Kriegshäuptlings‡대족장의 축복‡La bendición del Jefe de Guerra‡La bendición del Jefe de Guerra‡La bénédiction du chef de guerre‡酋长的祝福‡大酋長的祝福',
    nil,
    'Entregue a carta para o Chefe Guerreiro da Horda, em Orgrimmar.‡Отнесите письмо в Оргриммар и отдайте вождю Орды.‡Bringt den Brief zum Kriegshäuptling der Horde in Orgrimmar.‡오그리마에 있는 호드의 대족장에게 편지를 전달해야 합니다.‡Entrega la carta al Jefe de Guerra de la Horda en Orgrimmar.‡Entrega la carta al Jefe de Guerra de la Horda en Orgrimmar.‡Remettez la lettre au chef de guerre de la Horde, à Orgrimmar.‡前往奥格瑞玛，将信交给部落的部落酋长。‡把信件送到奧格瑪交給部落的大酋長。',
  }
},
[13190] = {
  {
    'Tudo a seu tempo‡Все хорошо в свое время‡Alles zu seiner Zeit‡때가 되면‡Todo a su tiempo‡Todo a su tiempo‡Tout vient à point…‡黄金时代‡好時光的一切',
    nil,
    'Kilix, o Desfiador, no Fosso de Narjun, quer que você obtenha um Cadáver de Vigia Ahn\'kahar e o coloque em cima do Braseiro Ahn\'kahet, que fica em Ahn\'kahet.|n|nEsta missão só pode ser completada no modo Heroico.‡Заполучите труп наблюдателя Ан\'кахара по поручению Киликса Разрушителя из Провала Наржуна и поместите его на ан\'кахетскую жаровню в Ан\'кахете.|n|nЭто задание может быть выполнено только в героическом режиме.‡Kilix der Entwirrer in der Grube von Narjun möchte, dass Ihr die Leiche eines Wächters der Ahn\'kahar beschafft und sie auf das Kohlenbecken von Ahn\'kahet in Ahn\'kahet legt.|n|nDiese Quest kann nur auf dem Schwierigkeitsgrad \'Heroisch\' beendet werden.‡나르준의 구덩이에 있는 해결자 킬릭스가 안카하르 감시자의 시체를 안카헤트에 있는 안카헤트 화로 위에 놓아 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡Kilix el Desenmarañador en El Foso de Narjun quiere que consigas un cadáver de vigía Ahn’kahar y que lo pongas dentro del blandón de Ahn’kahet en Ahn’kahet.|n|nSolo se puede completar esta misión como dificultad heroica.‡Kilix el Desenmarañador en El Foso de Narjun quiere que consigas un cadáver de vigía Ahn’kahar y que lo pongas dentro del blandón de Ahn’kahet en Ahn’kahet.|n|nSolo se puede completar esta misión como dificultad heroica.‡Kilix le Démêleur, à la Fosse de Narjun, vous a demandé d\'obtenir un Cadavre de guetteur d\'Ahn\'kahar et de le placer sur le brasero d\'Ahn\'kahet à Ahn\'kahet.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡纳尔苏深渊的拆解者基里克斯希望你弄到一具安卡哈看守者的尸体，将其放在安卡赫特的安卡赫特火盆上焚烧。|n|n这个任务只能在英雄难度下完成。‡那金之淵裡的『排除者』齊力克斯要求你，帶回一具安卡哈看守者的屍體，安放在安卡罕特的安卡罕特火盆上。|n|n此任務只能於英雄難度下完成。',
  }
},
[13191] = {
  {
    'Abastecimento dos demolidores‡Горючее для разрушителей‡Verwüster auftanken‡파괴전차 연료 공급‡Combustible para los demoledores‡Combustible para los demoledores‡Alimenter les démolisseurs‡战车的燃料‡為石毀車補給燃料',
    nil,
    'O Ferreiro de Batalha Casco Forte na Fortaleza Invérnia quer que você tome 10 Brasas Eternas de jogadores da Aliança no Caldeirão das Chamas.‡Соберите 10 неугасимых угольков с тел воинов Альянса в Огненной котловине по приказу осадного кузнеца Могучее Копыто из крепости Ледяных Оков.‡Belagerungsschmied Starkhuf in der Tausendwinterfestung möchte, dass Ihr zum Flammenkessel geht und den Allianzlern dort 10 Stück Immerglut abnehmt.‡겨울손아귀 요새에 있는 공성대장장이 스트롱후프가 불길의 가마솥에 있는 얼라이언스 전투원에게서 영원의 불씨 10개를 회수해 달라고 했습니다.‡El herrero de asedio Pezuña Fuerte en la Fortaleza de Conquista del Invierno quiere que arrebates 10 ascuas eternas a los jugadores de la Alianza en El Caldero de Llamas.‡El herrero de asedio Pezuña Fuerte en la Fortaleza de Conquista del Invierno quiere que arrebates 10 ascuas eternas a los jugadores de la Alianza en El Caldero de Llamas.‡Le Poliorcète Sabot-puissant, à la Forteresse de Joug-d\'hiver, vous a demandé de récupérer 10 Braises éternelles sur des personnages-joueurs de l\'Alliance, au Chaudron des flammes.‡冬拥堡垒的攻城技师斯托霍夫要你前往烈焰之坑，收集10份永恒灰烬。‡冬握堡壘的攻城鐵匠重蹄要你前往火焰熔爐，從聯盟玩家身上取得10個永恆餘燼。',
  }
},
[13192] = {
  {
    'Proteção para os muros‡Охрана стен‡Die Wälle schützen‡성벽 보호‡Proteger los muros‡Proteger los muros‡Surveiller les murs‡防卫城墙‡護衛城牆',
    nil,
    'O Mestre do Azar Fu\'jin na Fortaleza Invérnia quer que você tome 10 Peitorais Encantados da Aliança na Cachoeira Glacial.‡Отправляйтесь к Ледопадам и заполучи 10 зачарованных доспехов Альянса по просьбе мастера худу Фу\'джина из крепости Ледяных Оков.‡Hoodoomeister Fu\'jin in der Tausendwinterfestung möchte, dass Ihr 10 verzauberte Brustplatten der Allianz aus dem Gebiet der Eiswasserfälle beschafft.‡겨울손아귀 요새에 있는 전문 부두술사 푸진이 빙하 폭포에서 마력 깃든 얼라이언스 가슴보호갑 10개를 회수해 달라고 했습니다.‡El maestro de hudú Fu\'jin, en la Fortaleza de Conquista del Invierno, quiere que arrebates 10 corazas de la Alianza encantadas en las Cascadas Glaciales.‡El maestro de hudú Fu\'jin, en la Fortaleza de Conquista del Invierno, quiere que arrebates 10 corazas de la Alianza encantadas en las Cascadas Glaciales.‡Le Maître vodoun Fu\'jin, à la Forteresse de Joug-d\'hiver, vous a demandé de récupérer 10 Cuirasses enchantées de l\'Alliance aux Chutes glaciales.‡冬拥堡垒的邪咒师弗尔金要你前往冰川瀑布，收集10套灌魔的联盟护甲。‡冬握堡壘的咒毒大師符金要求你，從冰川瀑布取回10套灌能的護甲。',
  }
},
[13193] = {
  {
    'Ossos e flechas‡Кости и стрелы‡Pfeil und Knochen‡뼈와 화살‡Huesos y flechas‡Huesos y flechas‡Des os et des flèches‡骨头和箭矢‡龍骨與箭頭',
    nil,
    'O Tenente Vieron Penachama na Fortaleza Invérnia quer que você tome 10 Aljavas de Flechas de Osso de Dragão de jogadores da Aliança na Floresta das Sombras.‡Раздобудьте 10 колчанов со стрелами из драконьих костей у игроков Альянса в лесу Теней по просьбе лейтенанта Виерона Огненного Пера из крепости Ледяных Оков.‡Leutnant Vieron Flammenfeder in der Tausendwinterfestung möchte, dass Ihr in den Schattenwald geht und den Allianzlern dort 10 Köcher mit Drachenknochenpfeilen abnehmt.‡겨울손아귀 요새에 있는 비에론 블레이즈페더가 그늘진 수풀에 있는 얼라이언스에게서 용뼈 화살통 10개를 회수해 달라고 했습니다.‡El teniente Vieron Plumallama en la Fortaleza de Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Alianza en El Bosque de las Sombras.‡El teniente Vieron Plumallama en la Fortaleza de Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Alianza en El Bosque de las Sombras.‡Le Lieutenant Vieron Plumembrase, à la Forteresse de Joug-d\'hiver, vous a demandé de récupérer 10 Carquois de flèches en os de dragon, dans la Forêt des Ombres.‡冬拥堡垒的维尔隆·火羽要你前往阴影森林，从联盟玩家那里抢夺10支龙骨箭。‡冬握堡壘的維耶隆·炎羽中尉要你前往暗影森林，從聯盟玩家身上取得10個龍骨箭袋。',
  }
},
[13194] = {
  {
    'A cura pelas rosas‡Целительные розы‡Mit Rosen heilen‡치료용 장미‡Rosas que curan‡Rosas que curan‡La guérison par les plantes‡治疗用的玫瑰‡以玫瑰治療',
    nil,
    'O Primevista Mulfort quer que você tome 10 Bolsas de Herborismo da Aliança de jogadores da Aliança na Estepe da Vida.‡Отнимите 10 сумок с травами у игроков Альянса в степи Жизни по просьбе идолопоклонника Мулфорта.‡Primalist Mulfort möchte, dass Ihr in die Lebendige Steppe geht und den Allianzlern dort 10 Kräuterbeutel der Allianz abnehmt.‡원시술사 멀포르트가 생명의 평원에 있는 얼라이언스 전투원에게서 얼라이언스 약초 주머니 10개를 가져다 달라고 했습니다.‡El primalista Mulfort quiere que arrebates 10 faltriqueras de hierbas de la Alianza a los jugadores de la Alianza en Las Estepas de la Vida.‡El primalista Mulfort quiere que arrebates 10 faltriqueras de hierbas de la Alianza a los jugadores de la Alianza en Las Estepas de la Vida.‡Le Primaliste Mulfort vous a demandé de récupérer 10 Bourses d\'herbes de l\'Alliance sur des personnages-joueurs de l\'Alliance, dans les Steppes de la Vie.‡指挥官莫弗尔特要你前往生命草原，收集10只联盟草药包。‡原獵者穆法特要你前往生命冷原，從聯盟玩家身上取得10個聯盟草藥袋。',
  }
},
[13195] = {
  {
    'Uma erva extraordinária‡Редкое растение‡Ein seltenes Kraut‡희귀한 약초‡Una hierba única‡Una hierba única‡Une herbe rare‡稀有的草药‡罕見的草藥',
    nil,
    'A Anacoreta Tessa em Invérnia quer que você tome 10 Bolsas de Herborismo da Horda de jogadores da Horda na Estepe da Vida.‡Принесите анахорету Тессе 10 сумок Орды с травами из степей Жизни.‡Anachoret Tessa in Tausendwinter möchte, dass Ihr in die Lebendige Steppe geht und den Hordlern dort 10 Kräuterbeutel abnehmt.‡겨울손아귀에 있는 수도사 테사가 생명의 평원에 있는 호드 전투원에게서 호드 약초 주머니 10개를 회수해 달라고 했습니다.‡La anacoreta Tessa, en Conquista del Invierno, quiere que arrebates 10 faltriqueras de hierbas de la Horda a los jugadores de la Horda en Las Estepas de la Vida.‡La anacoreta Tessa, en Conquista del Invierno, quiere que arrebates 10 faltriqueras de hierbas de la Horda a los jugadores de la Horda en Las Estepas de la Vida.‡L\'Anachorète Tessa, à Joug-d\'hiver, vous a demandé de récupérer 10 Bourses d\'herbes de la Horde sur des personnages-joueurs de la Horde, dans les Steppes de la Vie.‡冬拥湖的学者特尔萨要你前往生命草原，收集10只部落草药包。‡冬握湖的隱士泰莎要你前往生命冷原，從部落玩家身上取得10個部落草藥袋。',
  }
},
[13196] = {
  {
    'Ossos e flechas‡Кости и стрелы‡Pfeil und Knochen‡뼈와 화살‡Huesos y flechas‡Huesos y flechas‡Des os et des flèches‡骨头和箭矢‡龍骨與箭頭',
    nil,
    'O Arqueiro Ranulfo em Invérnia quer que você tome 10 Aljavas de Flechas de Osso de Dragão de jogadores da Horda na Floresta das Sombras.‡По просьбе лучника Рендольфа из крепости Ледяных Оков отыщите 10 колчанов со стрелами из драконьих костей у игроков Орды в лесу Теней.‡Bogenmacher Randolph in Tausendwinter möchte, dass Ihr in den Schattenwald geht und den Hordlern dort 10 Köcher mit Drachenknochenpfeilen abnehmt.‡겨울손아귀에 있는 보우이어 란돌프가 그늘진 수풀에 있는 호드 전투원에게서 용뼈 화살통 10개를 회수해 와 달라고 했습니다.‡El arquero Randolph en Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Horda de El Bosque de las Sombras.‡El arquero Randolph en Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Horda de El Bosque de las Sombras.‡Le Fabricant d\'arcs Randolph, à Joug-d\'hiver, vous a demandé de récupérer 10 Carquois de flèches en os de dragon dans la Forêt des Ombres.‡冬拥湖的制弓师兰多尔弗要你前往阴影森林，从部落玩家那里抢夺10支龙骨箭。‡冬握湖的弓箭商藍道夫要你前往暗影森林，從部落玩家身上取得10個龍骨箭袋。',
  }
},
[13197] = {
  {
    'Abastecimento dos demolidores‡Горючее для разрушителей‡Verwüster auftanken‡파괴전차 연료 공급‡Combustible para los demoledores‡Combustible para los demoledores‡Alimenter les démolisseurs‡战车的燃料‡為石毀車補給燃料',
    nil,
    'O Ferreiro de Batalha Cabofirme em Invérnia quer que você tome 10 Brasas Eternas de jogadores da Horda no Caldeirão das Chamas.‡Осадный кузнец Крепкохват из Крепости Ледяных Оков попросил вас собрать 10 неугасимых угольков с тел воинов Орды в Огненной котловине.‡Belagerungsschmied Starkhand in Tausendwinter möchte, dass Ihr zum Flammenkessel geht und den Hordlern dort 10 Stück Immerglut abnehmt.‡겨울손아귀에 있는 공성 전문가 스타우트핸들이 불길의 가마솥에 있는 호드 전투원에게서 영원의 불씨 10개를 회수해 달라고 했습니다.‡El maestro de asedio Durasa en Conquista del Invierno quiere que arrebates 10 ascuas eternas a los jugadores de la Horda en El Caldero de Llamas.‡El maestro de asedio Durasa en Conquista del Invierno quiere que arrebates 10 ascuas eternas a los jugadores de la Horda en El Caldero de Llamas.‡Le Maître de siège Rudemanche, à Joug-d\'hiver, vous a demandé de récupérer 10 Braises éternelles sur des personnages-joueurs de la Horde au Chaudron des flammes.‡冬拥湖的攻城大师斯托汉德要你前往烈焰之坑，收集10份永恒灰烬。‡冬握湖的攻城大師斯托哈德要你前往火焰熔爐，從部落玩家身上取得10個永恆餘燼。',
  }
},
[13198] = {
  {
    'Proteção para os guerreiros‡Охрана для воинов‡Die Krieger schützen‡전사들에게 갑옷을‡Proteger a los guerreros‡Proteger a los guerreros‡Protéger les guerriers‡保护士兵‡保衛勇士',
    nil,
    'A Feiticeira Kaylana em Invérnia quer que você consiga 10 Armaduras da Horda Imbuídas na Cachoeira Glacial.‡Колдунья Кайлана из Ледяных Оков просит вас принести 10 комплектов прочных доспехов Орды из Ледопадов.‡Zauberin Kaylana in Tausendwinter möchte, dass Ihr zu den Eiswasserfällen geht und den Hordlern dort 10 magieerfüllte Rüstungen der Horde abnehmt.‡겨울손아귀에 있는 여마법사 케일라나가 빙하 폭포에 있는 호드 전투원에게서 마력 깃든 호드 갑옷 10개를 회수해 달라고 했습니다.‡La hechicera Kaylana en Conquista del Invierno quiere que arrebates 10 conjuntos de armadura de la Horda imbuida en las Cascadas Glaciales.‡La hechicera Kaylana en Conquista del Invierno quiere que arrebates 10 conjuntos de armadura de la Horda imbuida en las Cascadas Glaciales.‡La Sorcière Kaylana, à Joug-d\'hiver, vous a demandé de récupérer 10 Armures imprégnées de la Horde, aux Chutes Glaciales.‡冬拥湖的女巫凯兰娜要你要你前往冰川瀑布，收集10套灌魔的部落护甲。‡冬握湖的巫女凱拉娜要你前往冰川瀑布，從部落玩家身上取得10件灌魔部落護甲。',
  }
},
[13199] = {
  {
    'Ossos e flechas‡Кости и стрелы‡Pfeil und Knochen‡뼈와 화살‡Huesos y flechas‡Huesos y flechas‡Des os et des flèches‡骨头和箭矢‡龍骨與箭頭',
    nil,
    'O Tenente Vieron Penachama em Invérnia quer que você tome 10 Aljavas de Flechas de Osso de Dragão de jogadores da Aliança na Floresta das Sombras.‡Раздобудьте 10 колчанов со стрелами из драконьих костей у игроков Альянса в лесу Теней по просьбе лейтенанта Виерона Огненного Пера из крепости Ледяных Оков.‡Leutnant Vieron Flammenfeder in Tausendwinter möchte, dass Ihr in den Schattenwald geht und den Allianzlern dort 10 Köcher mit Drachenknochenpfeilen abnehmt.‡겨울손아귀에 있는 비에론 블레이즈페더가 그늘진 수풀에 있는 얼라이언스 전투원에게서 용뼈 화살통 10개를 회수해 달라고 했습니다.‡El teniente Vieron Plumallama en Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Alianza en El Bosque de las Sombras.‡El teniente Vieron Plumallama en Conquista del Invierno quiere que arrebates 10 carcajes de flechas de hueso de dragón a los jugadores de la Alianza en El Bosque de las Sombras.‡Le Lieutenant Vieron Plumembrase, à Joug-d\'hiver, vous a demandé de récupérer 10 Carquois de flèches en os de dragon sur les personnages-joueurs de l\'Alliance, à la Forêt des Ombres.‡冬拥湖的维尔隆·火羽要你前往阴影森林，从联盟玩家那里抢夺10支龙骨箭。‡冬握湖的維耶隆·炎羽中尉要你前往暗影森林，從聯盟玩家身上取得10個龍骨箭袋。',
  }
},
[13200] = {
  {
    'Abastecimento dos demolidores‡Горючее для разрушителей‡Verwüster auftanken‡파괴전차 연료 공급‡Combustible para los demoledores‡Combustible para los demoledores‡Alimenter les démolisseurs‡战车的燃料‡為石毀車補給燃料',
    nil,
    'O Ferreiro de Batalha Casco Forte em Invérnia quer que você tome 10 Brasas Eternas de jogadores da Aliança no Caldeirão das Chamas.‡Соберите 10 неугасимых угольков с тел воинов Альянса в Огненной котловине по приказу осадного кузнеца Могучее Копыто из крепости Ледяных Оков.‡Belagerungsschmied Starkhuf in Tausendwinter möchte, dass Ihr zum Flammenkessel geht und den Allianzlern dort 10 Stück Immerglut abnehmt.‡겨울손아귀에 있는 공성대장장이 스트롱후프가 불길의 가마솥에 있는 얼라이언스 전투원에게서 영원의 불씨 10개를 회수해 달라고 했습니다.‡El herrero de asedio Pezuña Fuerte de Conquista del Invierno quiere que arrebates 10 ascuas eternas a los jugadores de la Alianza en El Caldero de Llamas.‡El herrero de asedio Pezuña Fuerte de Conquista del Invierno quiere que arrebates 10 ascuas eternas a los jugadores de la Alianza en El Caldero de Llamas.‡Le Poliorcète Sabot-puissant, à Joug-d\'hiver, vous a demandé de récupérer 10 Braises éternelles sur des personnages-joueurs de l\'Alliance, au Chaudron des flammes.‡冬拥湖的攻城技师斯托霍夫要你前往烈焰之坑，收集10份永恒灰烬。‡冬握湖的攻城鐵匠重蹄要你前往火焰熔爐，從聯盟玩家身上取得10個永恆餘燼。',
  }
},
[13201] = {
  {
    'A cura pelas rosas‡Целительные розы‡Mit Rosen heilen‡치료용 장미‡Rosas que curan‡Rosas que curan‡La guérison par les plantes‡治疗用的玫瑰‡以玫瑰治療',
    nil,
    'O Primevista Mulfort em Invérnia quer que você tome 10 Bolsas de Herborismo da Aliança de jogadores da Aliança na Estepe da Vida.‡Отыщите 10 сумок Альянса с травами в степи Жизни по просьбе идолопоклонника Мулфорта.‡Primalist Mulfort in Tausendwinter möchte, dass Ihr in die Lebendige Steppe geht und den Allianzlern dort 10 Kräuterbeutel der Allianz abnehmt.‡겨울손아귀에 있는 원시술사 멀포르트가 생명의 평원에 있는 얼라이언스 전투원에게서 얼라이언스 약초 주머니 10개를 가져다 달라고 했습니다.‡El primalista Mulfort en Conquista del Invierno quiere que arrebates 10 faltriqueras de hierbas de la Alianza a los jugadores de la Alianza en Las Estepas de la Vida.‡El primalista Mulfort en Conquista del Invierno quiere que arrebates 10 faltriqueras de hierbas de la Alianza a los jugadores de la Alianza en Las Estepas de la Vida.‡Le Primaliste Mulfort, à Joug-d\'hiver, vous a demandé de récupérer 10 Bourses d\'herbes de l\'Alliance sur des personnages-joueurs de l\'Alliance dans les Steppes de la Vie.‡冬拥湖的指挥官莫弗尔特要你前往生命草原，收集10只联盟草药包。‡冬握湖的原獵者穆法特要你前往生命冷原，從聯盟玩家身上取得10個聯盟藥草袋。',
  }
},
[13202] = {
  {
    'Urucubaca nos muros‡Заколдованные стены‡Die Mauern verhexen‡성벽에 저주 불어넣기‡Echar una maldición a los muros‡Echar una maldición a los muros‡Ensorceler les murs‡攻打城墙‡大禍臨頭',
    nil,
    'O Mestre do Azar Fu\'jin em Invérnia quer que você tome 10 Peitorais Encantados da Aliança de jogadores da Aliança na Cachoeira Glacial.‡Принесите 10 комплектов зачарованных доспехов Альянса из Ледопадов по просьбе мастера худу Фу\'джина из крепости Ледяных Оков‡Hoodoomeister Fu\'jin in Tausendwinter möchte, dass Ihr zu den Eiswasserfällen geht und Allianzspielern dort 10 verzauberte Brustplatten der Allianz abnehmt.‡겨울손아귀에 있는 전문 부두술사 푸진이 빙하 폭포에 있는 얼라이언스 전투원에게서 마력 깃든 얼라이언스 가슴보호갑 10개를 회수해와 달라고 했습니다.‡El maestro de hudú Fu\'jin en Conquista del Invierno quiere que arrebates 10 corazas de la Alianza encantadas a los jugadores de la Alianza en las Cascadas Glaciales.‡El maestro de hudú Fu\'jin en Conquista del Invierno quiere que arrebates 10 corazas de la Alianza encantadas a los jugadores de la Alianza en las Cascadas Glaciales.‡Le Maître vodoun Fu\'jin, à Joug-d\'hiver, vous a demandé de récupérer 10 Cuirasses enchantées de l\'Alliance sur des personnages-joueurs de l\'Alliance, aux Chutes Glaciales.‡冬拥湖的邪咒师弗尔金要你前往冰川瀑布，从联盟玩家那里收集10套灌魔的联盟护甲。‡冬握湖的咒毒大師符金要你前往冰川瀑布，從聯盟玩家身上取得10件灌能聯盟護甲。',
  }
},
[13203] = {
  {
    'Um presente de Véu de Inverno‡Подарок к Зимнему Покрову‡Ein Winterhauchgeschenk‡겨울맞이 선물‡Un obsequio del Festival de Invierno‡Un obsequio del Festival de Invierno‡Un cadeau pour Voile d\'hiver‡冬幕节的礼物‡冬幕節禮物',
    nil,
    nil,
  }
},
[13204] = {
  {
    'O futum do fungo‡Странные грибочки‡Abgefahrene Pilze‡고약한 버섯‡El hongo de moda‡El hongo de moda‡Des champignons fétides‡奇怪的蘑菇‡惡臭磨菇',
    nil,
    'Você deve coletar 6 Fungos Grotescos das Feras da Caverna em Ahn\'kahet e entregá-las a Kilix, o Desfiador, no Fosso de Narjun.‡Соберите 6 кусков диковинной плесени с диких пещерных зверей в Ан\'кахете и принесите их Киликсу Разрушителю в Провал Наржуна.‡Ihr sollt 6 groteske Pilze von den wilden Höhlenbestien in Ahn\'kahet sammeln und sie bei Kilix dem Entwirrer in der Grube von Narjun abliefern.‡안카헤트에 있는 야만의 동굴 야수로부터 괴기한 버섯 6개를 모아 나르준의 구덩이에 있는 해결자 킬릭스에게 가져가야 합니다.‡Recoge 6 hongos grotescos de bestias salvajes de cueva en Ahn\'kahet y llévaselos a Kilix el Desenmarañador en El Foso de Narjun.‡Recoge 6 hongos grotescos de bestias salvajes de cueva en Ahn\'kahet y llévaselos a Kilix el Desenmarañador en El Foso de Narjun.‡Vous devez récupérer 6 Champignons ignobles sur des Bêtes sauvages de la caverne, à Ahn\'kahet, et les apporter à Kilix le Démêleur à la Fosse de Narjun.‡从安卡赫特的野蛮洞穴兽那里收集6只奇异的蘑菇，然后把它们交给纳尔苏深渊的拆解者基里克斯。‡你必須在安卡罕特的蠻穴野獸身上，採集6朵怪誕菌菇，並送去給那金之淵裡的『排除者』齊力克斯。',
  }
},
[13205] = {
  {
    'Desarmamento‡Разоружение‡Abrüstung‡무장 해제‡Desarme‡Desarme‡Désarmement‡削减军备‡撤除武裝',
    nil,
    'O Defensor Mordun quer que você entre na Bastilha Utgarde e furte 5 Armas Vraikal.‡Защитник Мордун поручил вам проникнуть в Крепость Утгард и украсть 5 образцов врайкульского оружия.‡Verteidiger Mordun möchte, dass Ihr Burg Utgarde betretet und 5 Waffen der Vrykul stehlt.‡수호병 모르둔이 우트가드 성채로 가서 브리쿨 무기 5개를 훔쳐와 달라고 했습니다.‡El defensor Mordun quiere que entres en la Fortaleza de Utgarde y que robes 5 armas vrykul.‡El defensor Mordun quiere que entres en la Fortaleza de Utgarde y que robes 5 armas vrykul.‡Le Défenseur Mordun veut que vous entriez dans le Donjon d’Utgarde pour y voler 5 Armes vrykules.‡防御者墨尔顿要你进入乌特加德城堡，偷取5把维库武器。‡防衛者摩丹要你進入俄特加德要塞，並偷走5件維酷武器。',
  }
},
[13206] = {
  {
    'Desarmamento‡Разоружение‡Abrüstung‡무장 해제‡Desarme‡Desarme‡Désarmement‡削减军备‡撤除武裝',
    nil,
    'A Patrulheira Sombria Marrah quer que você roube 5 Armas Vraikalen e as entregue a ela na Bastilha Utgarde.‡Темный следопыт Марра просит вас украсть в крепости Утгард 5 образцов врайкульского оружия и принести их ей в Крепость Утгард.‡Dunkelläuferin Marrah möchte, dass Ihr 5 Waffen der Vrykul aus Burg Utgarde stehlt und sie ihr in Burg Utgarde bringt.‡어둠 순찰자 마라가 우트가드 성채에서 브리쿨 무기 5개를 훔친 후, 성채 안에 있는 자신에게 가져와 달라고 했습니다.‡La forestal oscura Marrah quiere que robes 5 armas vrykul de la Fortaleza de Utgarde y que se las lleves dentro de la Fortaleza.‡La forestal oscura Marrah quiere que robes 5 armas vrykul de la Fortaleza de Utgarde y que se las lleves dentro de la Fortaleza.‡Le Forestier-sombre Marrah vous a demandé de voler 5 Armes vrykules au Donjon d\'Utgarde et de les lui apporter à l’intérieur du Donjon d\'Utgarde.‡黑暗游侠玛尔拉要你从乌特加德城堡中偷出5把维库武器，并把它们带回去给她。‡黑暗遊俠瑪拉要求你，從俄特加德要塞偷走5件維酷武器，然後送回她手中，她會在俄特加德要塞中等候。',
  }
},
[13207] = {
  {
    'Salões Rochosos‡Чертоги Камня‡Die Hallen des Steins‡돌의 전당‡Las Cámaras de Piedra‡Las Cámaras de Piedra‡Les salles de Pierre‡岩石大厅‡石之大廳',
    nil,
    'Brann Barbabronze quer que você o acompanhe enquanto ele descobre os segredos ocultos nos Salões Rochosos.‡Примите предложение Бранна Бронзоборода и сопровождайте его, пока он раскрывает тайны, хранящиеся в Чертогах Камня.‡Brann Bronzebart möchte, dass Ihr ihn bei der Suche nach den Geheimnissen, die in den Hallen des Steins verborgen liegen, begleitet.‡브란 브론즈비어드가 돌의 전당에 있는 비밀을 알아내러 가는 길에 동료가 되어 달라고 했습니다.‡Brann Barbabronce quiere que le acompañes mientras descubre los secretos que yacen en las Cámaras de Piedra.‡Brann Barbabronce quiere que le acompañes mientras descubre los secretos que yacen en las Cámaras de Piedra.‡Brann Barbe-de-bronze veut que vous l\'accompagniez à la découverte des secrets des Salles de Pierre.‡布莱恩·铜须希望你能与他结伴而行，揭开岩石大厅的秘密。‡布萊恩·銅鬚要求你和他一道尋找石之大廳裡的秘密。',
  }
},
[13210] = {
  {
    '‡‡‡‡‡‡Compte Blizzard : - DEM - E - FLAG‡‡',
    nil,
    nil,
  }
},
[13211] = {
  {
    'Purificados pelo fogo‡Сила очищающего огня‡Das Feuer wird Euch läutern‡불로 정화하기‡Purgar con fuego‡Purgar con fuego‡Purifions-les par le feu‡净化的火焰‡以火淨化',
    nil,
    'O Cruzado Olakin Sainrith, na Guarda Negra, quer que você queime 7 Cadáveres Pustulentos usando a Tocha do Olakin.‡Рыцарь Олакин Сайнрит из Черного дозора просит сжечь 7 гноящихся трупов с помощью факела Олакина.‡Kreuzfahrer Olakin Sainrith bei der Schwarzwacht möchte, dass Ihr mithilfe Olakins Fackel 7 eitrige Leichen verbrennt.‡어둠의 감시초소에 있는 성전사 올라킨 세인리스가 올라킨의 횃불을 사용해 부패한 시체 7구를 불태워달라고 했습니다.‡El cruzado Olakin Sainrith de La Guardia Negra quiere que quemes 7 cadáveres purulentos usando la antorcha de Olakin.‡El cruzado Olakin Sainrith de La Guardia Negra quiere que quemes 7 cadáveres purulentos usando la antorcha de Olakin.‡Le Croisé Olakin Sainrith, au Guet noir, vous a demandé de brûler 7 Cadavres purulents en utilisant la Torche d\'Olakin.‡黑色观察站的北伐军战士欧尔拉金·萨利斯要你使用欧尔拉金的火炬烧毁7具腐烂的尸体。‡黑色守望的十字軍歐拉金·山瑞斯要求你，以歐拉金的火炬焚毀7具膿瘡屍體。',
  }
},
[13212] = {
  {
    'Ele está em pedaços‡Части тела‡In die Brüche gegangen‡분해된 유해‡Hecho trozos‡Hecho trozos‡Il est tombé en pièces‡支离破碎‡他被大卸八塊了',
    nil,
    'Recupere o Torso do Olakin, as Pernas do Olakin, o Braço Esquerdo do Olakin e o Braço Direito do Olakin. Em seguida, entregue-os para a Cavaleira das Trevas Arly, na Guarda Negra.‡Принесите туловище Олакина, ноги Олакина, левую руку Олакина и правую руку Олакина темной всаднице Арли в Черный дозор.‡Bergt Olakins Oberkörper, Olakins Beine, Olakins linken Arm und Olakins rechten Arm und bringt sie der Dunkelreiterin Arly in der Schwarzwacht.‡올라킨의 몸통, 올라킨의 다리, 올라킨의 왼팔, 올라킨의 오른팔을 찾아 어둠의 감시초소에 있는 어둠기수 알리에게 가져가야 합니다.‡Consigue el torso, las piernas, el brazo derecho y el brazo izquierdo de Olakin y llévalos a la jinete oscura Arly en La Guardia Negra.‡Consigue el torso, las piernas, el brazo derecho y el brazo izquierdo de Olakin y llévalos a la jinete oscura Arly en La Guardia Negra.‡Récupérez le Torse d\'Olakin, les Jambes d\'Olakin, le Bras gauche d\'Olakin et le Bras droit d\'Olakin, puis apportez-les à la Cavalière noire Arly au Guet noir.‡夺回欧尔拉金的躯干、欧尔拉金的腿、欧尔拉金的左臂和欧尔拉金的右臂，将它们交给黑色观察站的黑暗骑士阿尔蕾。‡找回歐拉金的軀幹、歐拉金的雙腳、歐拉金的左手、和歐拉金的右手，帶回給黑色守望的黑騎兵阿爾利。',
  }
},
[13213] = {
  {
    'Batalha em Valhalas‡Битва при Валхаласе‡Kampf bei Valhalas‡발할라스에서의 전투‡Batalla en Valhalas‡Batalla en Valhalas‡Du rififi au Valhalas‡瓦哈拉斯之战‡英靈殿之戰',
    nil,
    'Fale com Geirrvif em Valhalas.‡Поговорите с Джейрвиф из Валхаласа.‡Sprecht mit Geirrvif in Valhalas.‡발할라스에서 가이르비프와 대화해야 합니다.‡Habla con Geirrvif en Valhalas.‡Habla con Geirrvif en Valhalas.‡Parlez à Geirrvif au Valhalas.‡与瓦哈拉斯的基尔莉芙谈一谈。‡與英靈殿裡的蓋爾維孚對話。',
  }
},
[13214] = {
  {
    'Batalha em Valhalas: heróis caídos‡Битва при Валхаласе: павшие герои‡Kampf bei Valhalas: Gefallene Helden‡발할라스에서의 전투: 전사한 영웅들‡Batalla en Valhalas: héroes caídos‡Batalla en Valhalas: héroes caídos‡Du rififi au Valhalas : héros défunts‡瓦哈拉斯之战：堕落的英雄‡英靈殿之戰:已逝的英雄',
    nil,
    'Geirrvif, em Valhalas, desafiou você a derrotar todos os seis heróis caídos em um único combate. Os heróis são: Eldreth, Geness Meia-alma, Jhadras, Masud, Rith e Talla.|n|nCaso você vença, fale com Gjonner, o Impiedoso, na borda sul de Valhalas.‡Джейрвиф из Валхаласа передала вам вызов на битву, в которой вам предстоит за один раз одолеть всех шестерых павших героев: Элдрета, Генесса Полдуши, Джадраса, Масуда, Рита и Таллу.|n|nЕсли вам удастся победить, поговорите с Гьоннером Безжалостным, контролирующим южную часть Валхаласа.‡Geirrvif in Valhalas hat Euch dazu herausgefordert, im Einzelkampf alle sechs gefallenen Helden zu besiegen: Eldreth, Geness Halbseele, Jhadras, Masud, Rith und Talla.|n|nSprecht mit Gjonner dem Erbarmungslosen am südlichen Rand von Valhalas, solltet Ihr erfolgreich sein.‡발할라스에 있는 가이르비프가 한 번의 전투로 전사한 6명의 영웅: 엘드레스, 정신 나간 게네스, 자드라스, 마수드, 리스, 탈라와 싸워 이기라는 도전 과제를 주었습니다.|n|n전투에서 이기면, 발할라스의 남쪽 부분이 내려다보이는 곳에 있는 무자비한 요너와 대화해야 합니다.‡Geirrvif en Valhalas os ha desafiado a derrotar en un solo combate a los seis héroes caídos: Eldreth, Geness Media Alma, Jhadras, Masud, Rith y Tala.|n|nSi lo lográis, hablad con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif en Valhalas los ha desafiado a derrotar en un solo combate a los seis héroes caídos: Eldreth, Geness Media Alma, Jhadras, Masud, Rith y Tala.|n|nSi lo logran, hablen con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif, au Valhalas, vous a mis au défi de vaincre, au cours d\'un même combat 6 Héros défunts : Eldreth, Geness Demi-Âme, Jhadras, Masud, Rith et Talla.|n|nSi vous réussissez, parlez à Gjonner le Sans-merci surveillant le rebord sud du Valhalas.‡瓦哈拉斯的基尔莉芙要你在一场战斗中击败6名堕落英雄：埃德里斯、基纳斯·半魂、哈达斯、玛苏德、雷希和塔尔拉。|n|n获胜之后到瓦哈拉斯南部场外去，与残忍的亚纳尔谈一谈。‡英靈殿的蓋爾維孚向你挑戰，在一場戰鬥中擊敗六名死去的英雄:艾德雷斯、『半魂』蓋內斯、賈卓斯、瑪蘇德、里希和塔拉。|n|n若你成功，跟在英靈殿南緣俯瞰的『殘酷』吉雍納交談。',
  }
},
[13215] = {
  {
    'Batalha em Valhalas: Khit\'rix, o Mestre Tenebroso‡Битва при Валхаласе: Кит\'рикс Темный Повелитель‡Kampf bei Valhalas: Khit\'rix der Dunkle Meister‡발할라스에서의 전투: 어둠의 지배자 키트릭스‡Batalla en Valhalas: Khit\'rix el Maestro Lóbrego‡Batalla en Valhalas: Khit\'rix el Maestro Lóbrego‡Du rififi au Valhalas : Khit\'rix le Maître ténébreux‡瓦哈拉斯之战：黑暗主宰西塔利克斯‡英靈殿之戰:『黑暗大師』齊特瑞司',
    nil,
    'Geirrvif, em Valhalas, desafiou você a derrotar Khit\'rix, o Mestre Tenebroso.|n|nCaso você vença, fale com Gjonner, o Impiedoso, na borda sul de Valhalas.‡Джейрвиф из Валхаласа передала вам вызов от Кит\'рикса Темного Повелителя.|n|nЕсли вам удастся победить, поговорите с Гьоннером Безжалостным, контролирующим южную часть Валхаласа.‡Geirrvif in Valhalas hat Euch dazu herausgefordert, Khit\'rix den Dunklen Meister zu vernichten.|n|nSprecht mit Gjonner dem Erbarmungslosen am südlichen Rand von Valhalas, solltet Ihr erfolgreich sein.‡발할라스에 있는 가이르비프가 어둠의 지배자 키트릭스와 싸워 이기라는 도전 과제를 주었습니다.|n|n전투에서 이기면, 발할라스의 남쪽 부분이 내려다보이는 곳에 있는 무자비한 요너와 대화해야 합니다.‡Geirrvif en Valhalas te ha retado a que derrotes a Khit\'rix el Maestro Lóbrego.|n|nSi lo consigues, habla con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif en Valhalas te ha retado a que derrotes a Khit\'rix el Maestro Lóbrego.|n|nSi lo consigues, habla con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif, au Valhalas, vous a mis au défi de vaincre Khit\'rix le Maître ténébreux.|n|nSi vous réussissez, parlez à Gjonner le Sans-merci surveillant le rebord sud du Valhalas.‡瓦哈拉斯的基尔莉芙要你击败黑暗主宰西塔利克斯。|n|n获胜之后到瓦哈拉斯南部场外去，与残忍的亚纳尔谈一谈。‡英靈殿的蓋爾維孚向你挑戰，要你擊敗『黑暗大師』齊特瑞司。|n|n若你成功，跟在英靈殿南緣俯瞰的『殘酷』吉雍納交談。',
  }
},
[13216] = {
  {
    'Batalha em Valhalas: o retorno de Sigrid Gelonata‡Битва при Валхаласе: возвращение Сигрид Дитя Льда‡Kampf bei Valhalas: Die Rückkehr von Sigrid Eiskind‡발할라스에서의 전투: 시그리드 아이스본의 귀환‡Batalla en Valhalas: el retorno de Sigrid Hielonato‡Batalla en Valhalas: el retorno de Sigrid Hielonato‡Du rififi au Valhalas : le retour de Sigrid Née-de-glace‡瓦哈拉斯之战：齐格莉德归来‡英靈殿之戰:席格芮·冰誕回來了',
    nil,
    'Geirrvif, em Valhalas, desafiou você a derrotar Sigrid Gelonata.|n|nCaso você vença, fale com Gjonner, o Impiedoso, na borda sul de Valhalas.‡Джейрвиф из Валхаласа передала вам вызов от Сигрид Дитя Льда.|n|nЕсли вам удастся победить, поговорите с Гьоннером Безжалостным, контролирующим южную часть Валхаласа.‡Geirrvif in Valhalas hat Euch dazu herausgefordert, Sigrid Eiskind zu vernichten.|n|nSprecht mit Gjonner dem Erbarmungslosen am südlichen Rand von Valhalas, solltet Ihr erfolgreich sein.‡발할라스에 있는 가이르비프가 시그리드 아이스본과 싸워 이기라는 도전 과제를 주었습니다.|n|n전투에서 이기면, 발할라스의 남쪽 부분이 내려다보이는 곳에 있는 무자비한 요너와 대화해야 합니다.‡Geirrvif en Valhalas te ha retado a que derrotes a Sigrid Hielonato.|n|nSi lo consigues, habla con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif en Valhalas te ha retado a que derrotes a Sigrid Hielonato.|n|nSi lo consigues, habla con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif, au Valhalas, vous a mis au défi de vaincre Sigrid Née-de-glace.|n|nSi vous réussissez, parlez à Gjonner le Sans-merci surveillant le rebord sud du Valhalas.‡瓦哈拉斯的基尔莉芙要你击败齐格莉德·冰魂。|n|n获胜之后到瓦哈拉斯南部场外去，与残忍的亚纳尔谈一谈。‡英靈殿的蓋爾維孚向你挑戰，要你擊敗席格芮·冰誕。|n|n若你成功，跟在英靈殿南緣俯瞰的『殘酷』吉雍納交談。',
  }
},
[13217] = {
  {
    'Batalha em Valhalas: Chacina!‡Битва при Валхаласе: Резчик-по-живому!‡Kampf bei Valhalas: Massaker!‡발할라스에서의 전투: 살육자‡Batalla en Valhalas: ¡Carnicería!‡Batalla en Valhalas: ¡Carnicería!‡Du rififi au Valhalas : Carnage !‡瓦哈拉斯之战：血肉巨人卡纳基！‡英靈殿之戰:卡納基!',
    nil,
    'Geirrvif, em Valhalas, desafiou você a derrotar Chacina.|n|nCaso você vença, fale com Gjonner, o Impiedoso, na borda sul de Valhalas.‡Джейрвиф из Валхаласа передала вам вызов от Резчика-по-живому.|n|nЕсли вам удастся победить, поговорите с Гьоннером Безжалостным, контролирующим южную часть Валхаласа.‡Geirrvif in Valhalas hat Euch dazu herausgefordert, Massaker zu vernichten.|n|nSprecht mit Gjonner dem Erbarmungslosen am südlichen Rand von Valhalas, solltet Ihr erfolgreich sein.‡발할라스에 있는 가이르비프가 살육자와 싸워 이기라는 도전 과제를 주었습니다.|n|n전투에서 이기면, 발할라스의 남쪽 부분이 내려다보이는 곳에 있는 무자비한 요너와 대화해야 합니다.‡Geirrvif en Valhalas te ha retado a que derrotes a Carnicería.|n|nSi lo consigues, habla con Gjonner el Despiadado en la parte sur de Valhalas.‡Geirrvif en Valhalas te ha retado a que derrotes a Carnicería.|n|nSi lo consigues, habla con Gjonner el Despiadado en la parte sur de Valhalas.‡Geirrvif, au Valhalas, vous a mis au défi de vaincre Carnage.|n|nSi vous réussissez, parlez à Gjonner le Sans-merci surveillant le rebord sud du Valhalas.‡瓦哈拉斯的基尔莉芙要你击败卡纳基。|n|n获胜之后到瓦哈拉斯南部场外去，与残忍的亚纳尔谈一谈。‡英靈殿的蓋爾維孚向你挑戰，要你擊敗卡納基。|n|n若你成功，跟在英靈殿南緣俯瞰的『殘酷』吉雍納交談。',
  }
},
[13218] = {
  {
    'Batalha em Valhalas: Thane Golpe Mortal‡Битва при Валхаласе: тан Смертельный Удар‡Kampf bei Valhalas: Than Todesstoß‡발할라스에서의 전투: 죽음의 손‡Batalla en Valhalas: señor feudal "Arremetida mortal"‡Batalla en Valhalas: señor feudal "Arremetida mortal"‡Du rififi au Valhalas : Thane « le Coup de grâce »‡瓦哈拉斯之战：“死亡一击”领主‡英靈殿之戰:死擊族長',
    nil,
    'Geirrvif, em Valhalas, desafiou você a derrotar o Thane Banahogg, conhecido como Golpe Mortal.|n|nCaso você vença, fale com Gjonner, o Impiedoso, na borda sul de Valhalas.‡Джейрвиф из Валхаласа передала вам вызов от тана Банахогга Смертельного Удара.|n|nЕсли вам удастся победить, поговорите с Гьоннером Безжалостным, контролирующим южную часть Валхаласа.‡Geirrvif in Valhalas hat Euch dazu herausgefordert, Than Banahogg den "Todesstoß" zu besiegen.|n|nSprecht mit Gjonner dem Erbarmungslosen am südlichen Rand von Valhalas, solltet Ihr erfolgreich sein.‡발할라스에 있는 가이르비프가 영주 바나호그와 싸워 이기라는 도전 과제를 주었습니다.|n|n전투에서 이기면, 발할라스의 남쪽 부분이 내려다보이는 곳에 있는 무자비한 요너와 대화해야 합니다.‡Geirrvif en Valhalas te ha retado a que derrotes al señor feudal Banahogg, la "Arremetida mortal".|n|nSi lo consigues, habla con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif en Valhalas te ha retado a que derrotes al señor feudal Banahogg, la "Arremetida mortal".|n|nSi lo consigues, habla con Gjonner el Desalmado en la parte sur de Valhalas.‡Geirrvif, au Valhalas, vous a mis au défi de vaincre le Thane Banahogg, le Coup de grâce.|n|nSi vous réussissez, parlez à Gjonner le Sans-merci, surveillant le rebord sud du Valhalas.‡瓦哈拉斯的基尔莉芙要你击败“死亡一击”巴纳霍格领主。|n|n获胜之后到瓦哈拉斯南部场外去，与残忍的亚纳尔谈一谈。‡英靈殿的蓋爾維孚向你挑戰，要你擊敗『死擊』巴納霍格族長。|n|n若你成功，跟在英靈殿南緣俯瞰的『殘酷』吉雍納交談。',
  }
},
[13219] = {
  {
    'Batalha em Valhalas: o desafio final‡Битва при Валхаласе: последний бой‡Kampf bei Valhalas: Letzte Herausforderung‡발할라스에서의 전투: 최후의 도전‡Batalla en Valhalas: desafío final‡Batalla en Valhalas: desafío final‡Du rififi au Valhalas : l\'ultime défi‡瓦哈拉斯之战：终极挑战‡英靈殿之戰:最後的挑戰',
    nil,
    'Geirrvif, em Valhalas, desafiou você a derrotar o Príncipe Sandoval.|n|nCaso você vença, fale com Gjonner, o Impiedoso, na borda sul de Valhalas.‡Джейрвиф из Валхаласа передала вам вызов от принца Сандовала.|n|nЕсли вам удастся победить его, поговорите с Гьоннером Безжалостным, контролирующим южную часть Валхаласа.‡Geirrvif in Valhalas hat Euch dazu herausgefordert, Prinz Sandoval zu besiegen.|n|nSprecht mit Gjonner dem Erbarmungslosen am südlichen Rand von Valhalas, solltet Ihr erfolgreich sein.‡발할라스에 있는 가이르비프가 공작 산도발과 싸워 이기라는 도전 과제를 주었습니다.|n|n전투에서 이기면, 발할라스의 남쪽 부분이 내려다보이는 곳에 있는 무자비한 요너와 대화해야 합니다.‡Geirrvif en Valhalas te ha retado a que derrotes al príncipe Sandoval.|n|nSi lo consigues, habla con Gjonner el Despiadado en la parte sur de Valhalas.‡Geirrvif en Valhalas te ha retado a que derrotes al príncipe Sandoval.|n|nSi lo consigues, habla con Gjonner el Despiadado en la parte sur de Valhalas.‡Geirrvif, au Valhalas, vous a mis au défi de vaincre le Prince Sandoval.|n|nSi vous réussissez, parlez à Gjonner le Sans-merci, qui surveille le rebord sud du Valhalas.‡瓦哈拉斯的基尔莉芙要你击败萨杜瓦尔王子。|n|n获胜之后到瓦哈拉斯南部场外去，与残忍的亚纳尔谈一谈。‡英靈殿的蓋爾維孚向你挑戰，要你擊敗薩杜瓦爾親王。|n|n若你成功，跟在英靈殿南緣俯瞰的『殘酷』吉雍納交談。',
  }
},
[13220] = {
  {
    'Reconstruindo Olakin‡Воскрешение Олакина‡Olakin wieder zusammensetzen‡올라킨 되살리기‡Volver a unir a Olakin‡Volver a unir a Olakin‡Remettre Olakin sur pied‡重新组合欧尔拉金‡將歐拉金拼湊回來',
    nil,
    'Pegue um Carretel de Linha e o Cutelo do Médico e, em seguida, leve-os até a Laje do Sacrário da Reanimação. Chegando lá, use os restos de Olakin para tentar reanimar o cruzado. Quando completar a missão, fale novamente com a Cavaleira das Trevas Arly, na Guarda Negra.‡Найдите катушку ниток и хирургический скальпель, отнесите их в Святилище воскрешения к останкам Олакина и попытайтесь воскресить рыцаря. Затем вернитесь к темной всаднице Арли в Черный дозор.‡Beschafft Euch eine Garnspule und den Spalter des Doktors. Geht dann zur Steinplatte des Sanktums der Reanimation und versucht, Kreuzfahrer Olakins sterbliche Überreste wiederzubeleben. Kehrt zu Dunkelreiterin Arly in die Schwarzwacht zurück, sobald die Aufgabe vollbracht ist.‡실타래 한 묶음과 수술용 칼을 부활의 성소 석판으로 가져가 성전사 올라킨의 유해에 사용하여 성전사를 되살린 다음, 어둠의 감시초소에 있는 어둠기수 알리에게 가야 합니다.‡Consigue una bobina de hilo y la cuchilla del doctor, después llévalas a la losa del Sagrario de Reanimación, y usa los restos de Olakin para intentar reanimar al cruzado. Regresa junto a la jinete oscura Arly, en La Guardia Negra, cuando hayas completado este encargo.‡Consigue una bobina de hilo y la cuchilla del doctor, después llévalas a la losa del Sagrario de Reanimación, y usa los restos de Olakin para intentar reanimar al cruzado. Regresa junto a la jinete oscura Arly, en La Guardia Negra, cuando hayas completado este encargo.‡Obtenez une Bobine de fil et le Fendoir du docteur, puis apportez-les au Bloc du Sanctum de réanimation et utilisez les Restes du croisé Olakin pour essayer de le réanimer. Retournez voir la Cavalière noire Arly au Guet noir une fois la tâche terminée.‡找到一卷缝合线和博士的屠刀，带上它们进入复生密室，将欧尔拉金的残骸缝合起来，看看能不能让他复活。完成任务后返回黑色观察站，向黑暗骑士阿尔蕾复命。‡取得一個絲線捲、以及醫生的切割刀，帶往再活化肉塊聖所，試著利用歐拉金的殘骸將其再活化。一旦工作完成，向黑色守望的黑騎兵阿爾利回報。',
  }
},
[13221] = {
  {
    'Ainda não estou morto!‡Я еще жив!‡Noch bin ich nicht tot!‡아직 죽지 않았습니다!‡¡No estoy muerto aún!‡¡No estoy muerto aún!‡Je ne suis pas encore mort !‡我还没死！‡我還沒死!',
    nil,
    'Escolte o Padre Kamaros até um lugar seguro e, em seguida, apresente-se a Absalan, o Pio, a bordo do Rompe-céus.‡Проводите отца Камароса в безопасное место, а затем доложите обо всем Абсалану Благочестивому на борту "Усмирителя небес".‡Bringt Vater Kamaros in Sicherheit und erstattet dann Absalan dem Frommen an Bord der Himmelsbrecher Bericht.‡신부 카마로스를 안전하게 호위한 다음 하늘파괴자호에 있는 신앙심 깊은 압살란에게 보고해야 합니다.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante Absalan el Piadoso a bordo de El Rompecielos.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante Absalan el Piadoso a bordo de El Rompecielos.‡Escortez le Père Kamaros jusqu\'à ce qu\'il soit en sécurité et présentez-vous à Absalan le Pieux, à bord du Brise-ciel.‡护送卡玛洛斯神父逃离险境，然后向破天号上的虔诚的阿布萨兰报告。‡護送卡瑪洛斯神父至安全之處，並向破天者號上的虔誠的亞柏薩倫回報。',
  }
},
[13222] = {
  {
    'Defenda o cerco‡Защита осадных машин‡Belagerungsmaschinen verteidigen‡공성 전차를 지켜라‡Defender el asedio‡Defender el asedio‡La défense du siège‡保卫攻城车‡護衛攻城行動',
    nil,
    'O Demolidor Sênior Ledos em Invérnia quer que você pilote ou proteja um dispositivo de cerco enquanto ele destrói três estruturas.|n|nJogadores com patente de soldado podem construir dispositivos de cerco em Oficinas Goblin.‡По приказу главного подрывника Легосо из крепости Ледяных Оков защитите осадную машину или управляйте ею, пока она не уничтожит три строения.|n|nОсадные машины могут изготавливать игроки в звании "рядовой" и выше в гоблинских мастерских.‡Chefdemolierer Legoso in Tausendwinter möchte, dass Ihr eine Belagerungsmaschine steuert oder beschützt. Die Maschine muss drei Gebäude zerstören.|n|nSpieler, die den Rang "Gefreiter" oder höher besitzen, können Belagerungsmaschinen in Goblinwerkstätten bauen.‡겨울손아귀에 있는 고위 폭파병 레고소가 호드 건물 세 군데를 파괴하는 동안 공성 차량을 조종하거나 보호해 달라고 했습니다.|n|n공성 차량은 고블린 작업장에 있는 호드 진영 전투원이 다시 만들 수 있습니다.‡El demoledor jefe Legoso en Conquista del Invierno quiere que pilotes o que protejas un aparato de asedio mientras destruye tres estructuras.|n|nLos jugadores con rango de soldado o superior pueden construir sus aparatos de asedio en los talleres goblin.‡El demoledor jefe Legoso en Conquista del Invierno quiere que pilotes o que protejas un aparato de asedio mientras destruye tres estructuras.|n|nLos jugadores con rango de soldado o superior pueden construir sus aparatos de asedio en los talleres goblin.‡Le Démolisseur en chef Legoso, à la Forteresse de Joug-d\'hiver, vous demande de piloter ou de protéger un engin de siège pendant qu\'il détruit trois structures.|n|nLes joueurs ayant un grade de soldat ou supérieur peuvent construire des engins de siège dans les Ateliers gobelins.‡冬拥湖的资深攻城技师雷格索要你驾驶或保护一辆攻城器械，摧毁3座部落建筑物。|n|n列兵军衔及更高军衔的玩家可以在地精车间中建造攻城器械。‡冬握湖的資深爆破兵勒茍索要你駕駛或保護一個攻城器，讓其順利摧毀三個建築物。|n|n士兵階級以上的玩家可於哥布林工坊建造攻城器。',
  }
},
[13223] = {
  {
    'Defenda o cerco‡Защита осадных машин‡Belagerungsmaschinen verteidigen‡공성 전차를 지켜라‡Defender el asedio‡Defender el asedio‡La défense du siège‡保卫攻城车‡護衛攻城行動',
    nil,
    'O Tenente Murp em Invérnia quer que você defenda ou pilote um veículo de cerco enquanto eles destroem três estruturas da Aliança.|n|nDispositivos de cerco podem ser construídos por jogadores ranqueados da Horda nas Oficinas Goblínicas.‡Защитите осадную машину или управляйте ею, пока она не уничтожит три строения Альянса по приказу лейтенанта Мурпа из крепости Ледяных Оков.|n|nОсадные машины могут изготавливать лишь имеющие воинские звания игроки Орды в гоблинских мастерских.‡Leutnant Murp in Tausendwinter möchte, dass Ihr eine Belagerungsmaschine steuert oder verteidigt. Die Maschinen müssen 3 Gebäude der Allianz zerstören.|n|nBelagerungsmaschinen können von Spielern der Horde, die einen Rang haben, in Goblinwerkstätten gebaut werden.‡겨울손아귀에 있는 부관 머프가 얼라이언스 건물 세 군데를 파괴하는 동안 공성 차량을 조종하거나 보호해 달라고 했습니다.|n|n공성 차량은 고블린 작업장에 있는 호드 진영 전투원이 다시 만들 수 있습니다.‡El teniente Murp en Conquista del Invierno quiere que defiendas o que dirijas un vehículo de asedio mientras destrozan tres estructuras de la Alianza.|n|nLos jugadores de la Horda con rango pueden fabricar los dispositivos de asedio en los talleres de los goblins.‡El teniente Murp en Conquista del Invierno quiere que defiendas o que dirijas un vehículo de asedio mientras destrozan tres estructuras de la Alianza.|n|nLos jugadores de la Horda con rango pueden fabricar los dispositivos de asedio en los talleres de los goblins.‡Le Lieutenant Murp, à Joug-d\'hiver, vous demande de défendre ou de piloter un véhicule de siège tandis que ce dernier détruit trois structures de l\'Alliance.|n|nLes machines de siège peuvent être construites par des personnages-joueurs de la Horde gradés, dans les Ateliers gobelins.‡冬拥湖的莫普中尉要你驾驶或保护一辆攻城器械，摧毁3座联盟建筑物。|n|n拥有军衔的部落玩家可以在地精车间中建造攻城器械。‡冬握湖的莫普中尉要你保衛或駕駛一台攻城載具，讓其順利摧毀三座聯盟建築物。|n|n有階級的部落玩家可於哥布林工坊建造攻城器。',
  }
},
[13224] = {
  {
    'Martelo de Orgrim‡Молот Оргрима‡Orgrims Hammer‡오그림의 망치호‡El Martillo de Orgrim‡El Martillo de Orgrim‡Le Marteau d\'Orgrim‡奥格瑞姆之锤‡奧格林之錘',
    nil,
    'Procure o Exterminador dos Céus Korm Escaranegra a bordo do Martelo de Orgrim, que sobrevoa a Coroa de Gelo.‡Найдите покорителя небес Корма Черного Шрама. Он находится на борту "Молота Оргрима", летающего над Ледяной Короной.‡Sucht Himmelshäscher Korm Schwarznarbe an Bord der Orgrims Hammer über dem Eiskronengletscher auf.‡얼음왕관 위를 나는 오그림의 망치호에 탄 하늘약탈자 코름 블랙스카를 찾아야 합니다.‡Busca al atracador del cielo Korm Marcanegra a bordo del Martillo de Orgrim que vuela por encima de Corona de Hielo.‡Busca al atracador del cielo Korm Marcanegra a bordo del Martillo de Orgrim que vuela por encima de Corona de Hielo.‡Retrouvez le Saccageur-des-cieux Korm Noire-balafre à bord du Marteau d\'Orgrim, qui survole la Couronne de glace.‡前往冰冠冰川上空的奥格瑞姆之锤，找到掠天者考尔姆·黑痕。‡找出搭乘著奧格林之錘，在寒冰皇冠上空盤旋的空奪者寇姆·黑疤。',
  }
},
[13225] = {
  {
    'O Rompe-céus‡Усмиритель небес‡Die Himmelsbrecher‡하늘파괴자호‡El Rompecielos‡El Rompecielos‡Le Brise-ciel‡破天号‡破天者號',
    nil,
    'Procure o Alto-capitão Justino Bartolotto a bordo do Rompe-céus, que sobrevoa a Coroa de Gelo.‡Найдите старшего капитана Джастина Бартлетта. Он находится на борту "Усмирителя небес", патрулирующего Ледяную Корону.‡Sprecht mit Stabshauptmann Justin Bartlett an Bord der Himmelsbrecher, die über der Eiskrone fliegt.‡얼음왕관 상공을 날고 있는 하늘파괴자호에 탄 수석 선장 저스틴 바틀릿을 찾아야 합니다.‡Busca al gran capitán Justin Bartlett a bordo de El Rompecielos que vuela sobre Corona de Hielo.‡Busca al gran capitán Justin Bartlett a bordo de El Rompecielos que vuela sobre Corona de Hielo.‡Retrouvez le Grand capitaine Justin Bartlett à bord du Brise-ciel survolant la Couronne de glace.‡在冰冠冰川上空的破天号上找到高级指挥官加斯汀·巴雷特。‡找出搭乘著破天者號，在寒冰皇冠上空盤旋的提督賈斯汀·巴特勒。',
  }
},
[13226] = {
  {
    'O dia do julgamento chegou!‡И пришел Судный День!‡Der Tag der Abrechnung kommt!‡심판의 날!‡¡Se acerca el día del Juicio Final!‡¡Se acerca el día del Juicio Final!‡Le jour du jugement approche !‡审判日降临！‡審判日將臨!',
    nil,
    'Apresente-se ao Grão-lorde Tirion Fordring na Vanguarda Argêntea, que fica na Coroa de Gelo.‡Отправляйтесь к верховному лорду Тириону Фордрингу в Оплот Серебряного Авангарда в Ледяной Короне.‡Meldet Euch bei Hochlord Tirion Fordring an der Argentumvorhut in Eiskrone.‡얼음왕관의 은빛십자군 선봉기지에 있는 대영주 티리온 폴드링에게 보고해야 합니다.‡Preséntate ante el alto señor Tirion Vadín en La Vanguardia Argenta en Corona de Hielo.‡Preséntate ante el alto señor Tirion Vadín en La Vanguardia Argenta en Corona de Hielo.‡Faites votre rapport au Généralissime Tirion Fordring, à l\'Avant-garde d\'Argent, dans la Couronne de glace.‡前往冰冠冰川的银色前线基地，向大领主提里奥·弗丁报到。‡在寒冰皇冠的銀白先鋒駐地，向大領主提里奧·弗丁報到。',
  }
},
[13227] = {
  {
    'O dia do julgamento chegou!‡И пришел Судный День!‡Der Tag der Abrechnung kommt!‡심판의 날!‡¡Se acerca el día del Juicio Final!‡¡Se acerca el día del Juicio Final!‡Le jour du jugement approche !‡审判日降临！‡審判日將臨!',
    nil,
    'Apresente-se ao Grão-lorde Tirion Fordring na Vanguarda Argêntea, que fica na Coroa de Gelo.‡Отправляйтесь к верховному лорду Тириону Фордрингу в Оплот Серебряного Авангарда в Ледяной Короне.‡Meldet Euch bei Hochlord Tirion Fordring an der Argentumvorhut in Eiskrone.‡얼음왕관에 있는 은빛십자군 선봉기지에 있는 대영주 티리온 폴드링에게 보고해야 합니다.‡Preséntate ante el alto señor Tirion Vadín en La Vanguardia Argenta en Corona de Hielo.‡Preséntate ante el alto señor Tirion Vadín en La Vanguardia Argenta en Corona de Hielo.‡Présentez-vous au Généralissime Tirion Fordring, à l\'Avant-garde d\'Argent, dans la Couronne de glace.‡前往冰冠冰川的银色前线基地，向大领主提里奥·弗丁报到。‡到寒冰皇冠的銀白先鋒駐地向大領主提里奧·弗丁報到。',
  }
},
[13228] = {
  {
    'O Front Partido‡Прорванный фронт‡Die Zerbrochene Front‡파괴된 싸움터‡El Frente Roto‡El Frente Roto‡Le Front brisé‡破碎前线‡破碎前線',
    nil,
    'Korm Escaranegra, no Martelo de Orgrim, quer que você vá para o Front Partido e interrogue um Berserker Moribundo para descobrir o que aconteceu.‡По заданию Корма Черного Шрама с "Молота Оргрима" отправляйтесь к Прорванному фронту и, поговорив с умирающим берсерком, узнайте, что там произошло.‡Korm Schwarznarbe an Bord der Orgrims Hammer möchte, dass Ihr Euch an die Zerbrochene Front begebt und einen sterbenden Berserker dazu befragt, was geschehen ist.‡오그림의 망치호에 있는 코름 블랙스카가 파괴된 싸움터로 가서 죽어가는 광전사에게 무슨 일이 있었는지 물어봐 달라고 했습니다.‡Korm Marcanegra en el Martillo de Orgrim quiere que vayas a El Frente Roto e interrogues a un rabioso moribundo para descubrir qué ha pasado allí.‡Korm Marcanegra en el Martillo de Orgrim quiere que vayas a El Frente Roto e interrogues a un rabioso moribundo para descubrir qué ha pasado allí.‡Korm Noire-balafre, sur le Marteau d\'Orgrim, vous demande d\'aller au Front brisé et de questionner un Berserker mourant pour apprendre ce qui s\'est passé là-bas.‡奥格瑞姆之锤的考尔姆·黑痕要你前往破碎前线，询问一名濒死的狂战士，然后向他汇报你收集到的情报。‡搭乘著奧格林之錘的寇姆·黑疤要求你，前往破碎前線並詢問垂死的狂戰士，以了解發生的事。',
  }
},
[13229] = {
  {
    'Ainda não estou morto!‡Я еще жив!‡Noch bin ich nicht tot!‡아직 죽지 않았습니다!‡¡No estoy muerto aún!‡¡No estoy muerto aún!‡Je ne suis pas encore mort !‡我还没死！‡我還沒死!',
    nil,
    'Escolte o Padre Kamaros até um lugar seguro e, em seguida, apresente-se ao Irmão Keltan a bordo do Martelo de Orgrim.‡Проводите отца Камароса в безопасное место, а затем доложите обо всем брату Кельтану на борту "Молота Оргрима".‡Bringt Vater Kamaros in Sicherheit und erstattet dann Bruder Keltan an Bord der Orgrims Hammer Bericht.‡신부 카마로스를 안전하게 호위한 다음 오그림의 망치호에 있는 수사 켈탄에게 보고해야 합니다.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante el hermano Keltan a bordo del Martillo de Orgrim.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante el hermano Keltan a bordo del Martillo de Orgrim.‡Escortez le Père Kamaros jusqu\'à ce qu\'il soit en sécurité et présentez-vous au Frère Keltan, à bord du Marteau d\'Orgrim.‡护送卡玛洛斯神父逃离险境，然后向奥格瑞姆之锤的凯尔坦修士报告。‡護送卡瑪洛斯神父至安全之處，並向奧格林之錘上的凱爾坦修士回報。',
  }
},
[13230] = {
  {
    'Vingue-me!‡Отомсти за меня!‡Rächt mich!‡복수해 주시오!‡¡Véngame!‡¡Véngame!‡Vengez-moi !‡为我复仇！‡替我復仇!',
    nil,
    'Um Berserker Moribundo pediu que você mate 5 Soldados Moribundos no Front Partido. Fale novamente com o Exterminador dos Céus Korm Escaranegra no Martelo de Orgrim quando terminar.‡Добейте 5 умирающих солдат у Прорванного фронта по просьбе умирающего берсерка. Об исполнении доложите покорителю небес Корму Черному Шраму на борту "Молота Оргрима".‡Ein sterbender Berserker hat Euch darum gebeten, 5 sterbende Soldaten an der Zerbrochenen Front zu töten. Erstattet Himmelshäscher Korm Schwarznarbe auf der Orgrims Hammer Bericht, sobald dies erledigt ist.‡죽어가는 광전사가 파괴된 싸움터에서 5명의 죽어가는 병사를 처치해 달라고 했습니다. 일을 마치면 오그림의 망치호에 있는 하늘약탈자 코름 블랙스카에게 보고해야 합니다.‡Un rabioso moribundo te ha pedido que mates a 5 soldados moribundos en El Frente Roto. Informa a atracador del cielo Korm Marcanegra en el Martillo de Orgrim cuando lo hayas hecho.‡Un rabioso moribundo te ha pedido que mates a 5 soldados moribundos en El Frente Roto. Informa a atracador del cielo Korm Marcanegra en el Martillo de Orgrim cuando lo hayas hecho.‡Un Berserker mourant vous a demandé de tuer 5 Soldats mourants au Front brisé. Présentez-vous au Saccageur-des-cieux Korm Noire-balafre à bord du Marteau d\'Orgrim une fois que c\'est fait.‡破碎前线上的一名濒死的狂战士要你杀死5名濒死的士兵。完成任务后返回奥格瑞姆之锤，向掠天者考尔姆·黑痕报到。‡垂死的狂戰士要求你在破碎前線上殺死5個垂死的士兵。完成後，向奧格林之錘上的空奪者寇姆·黑疤回報。',
  }
},
[13231] = {
  {
    'O Front Partido‡Прорванный фронт‡Die Zerbrochene Front‡파괴된 싸움터‡El Frente Roto‡El Frente Roto‡Le front brisé‡破碎前线‡破碎前線',
    nil,
    'O Alto-capitão Justino Bartolotto, a bordo do Rompe-céus, quer que você vá para o Front Partido e interrogue um Soldado Moribundo. Em seguida, retorne ao Alto-capitão.‡Отправляйтесь на Прорванный фронт и расспросите умирающего солдата, после чего возвращайтесь к старшему капитану Джастину Бартлетту на борт "Усмирителя небес".‡Stabshauptmann Justin Bartlett an Bord der Himmelsbrecher möchte, dass Ihr Euch an die Zerbrochene Front begebt, den sterbenden Soldaten befragt und ihm dann erneut Bericht erstattet.‡하늘파괴자호에 탄 수석 선장 저스틴 바틀릿이 파괴된 싸움터로 가서 죽어가는 병사에게 상황을 물은 후 다시 돌아와 보고해 달라고 했습니다.‡El gran capitán Justin Barlett en El Rompecielos quiere que vayas a El Frente Roto, interrogues a un soldado moribundo y que luego vuelvas a informarle.‡El gran capitán Justin Barlett en El Rompecielos quiere que vayas a El Frente Roto, interrogues a un soldado moribundo y que luego vuelvas a informarle.‡Le Grand capitaine Justin Bartlett, à bord du Brise-ciel, vous demande d\'aller au Front brisé et de questionner un Soldat mourant, puis de retourner lui faire votre rapport.‡破天号的高级指挥官加斯汀·巴雷特要你前往破碎前线，询问一名濒死的士兵，然后向他汇报你收集到的情报。‡破天者號上的提督賈斯汀·巴特勒要求你，去破碎前線訊問一個垂死的士兵，並回報給他。',
  }
},
[13232] = {
  {
    'Mate-me!‡Прикончи меня!‡Tötet mich!‡날 끝내줘!‡¡Acaba conmigo!‡¡Acaba conmigo!‡Achevez-moi !‡让我解脱吧！‡給我個痛快!',
    nil,
    'Um Soldado Moribundo, no Front Partido, quer que você mate 5 Soldados Moribundos e se apresente ao Alto-capitão Justino Bartolotto, no Rompe-céus.‡По просьбе умирающего солдата добейте 5 умирающих солдат у Прорванного фронта и доложите об исполнении старшему капитану Джастину Бартлетту на борту "Усмирителя небес".‡Der sterbende Soldat an der Zerbrochenen Front möchte, dass Ihr 5 sterbende Soldaten erlöst und dann Stabshauptmann Justin Bartlett auf der Himmelsbrecher Bericht erstattet.‡파괴된 싸움터에 있는 죽어가는 병사가 5명의 죽어가는 병사를 처치한 후 하늘파괴자호에 있는 수석 선장 저스틴 바틀릿에게 보고해 달라고 했습니다.‡Un soldado moribundo en El Frente Roto quiere que mates a 5 soldados moribundos y que informes al gran capitán Justin Barlett en El Rompecielos.‡Un soldado moribundo en El Frente Roto quiere que mates a 5 soldados moribundos y que informes al gran capitán Justin Barlett en El Rompecielos.‡Un Soldat mourant, au Front brisé, vous demande de tuer 5 Soldats mourants, puis de faire votre rapport au Grand capitaine Justin Bartlett, à bord du Brise-ciel.‡破碎前线上的一名濒死的士兵要你杀死其他5名濒死的士兵。完成任务后返回破天号，向高级指挥官加斯汀·巴雷特报到。‡破碎前線上一個垂死的士兵要求你，殺死5個垂死的士兵，並向提督賈斯汀·巴特勒回報。',
  }
},
[13233] = {
  {
    'Sem misericórdia!‡Пощады не будет!‡Keine Gnade!‡자비란 없다!‡¡Sin piedad!‡¡Sin piedad!‡Pas de pitié !‡决不留情！‡絕不留情!',
    nil,
    'O Alto-capitão Justino Bartolotto, a bordo do Rompe-céus, quer que você mate 15 Jogadores da Horda na Coroa de Gelo.‡По заданию старшего капитана Джастина Бартлетта с борта "Усмирителя Небес" убейте 15 игроков, сражающихся на стороне Орды в Ледяной Короне.‡Stabshauptmann Justin Bartlett an Bord der Himmelsbrecher möchte, dass Ihr in Eiskrone 15 Spieler der Horde tötet.‡하늘파괴자호에 있는 수석 선장 저스틴 바틀릿이 얼음왕관에 있는 15명의 호드 전투원을 처치해 달라고 했습니다.‡El gran capitán Justin Bartlett a bordo de El Rompecielos quiere que mates a 15 jugadores de la Horda en Corona de Hielo.‡El gran capitán Justin Bartlett a bordo de El Rompecielos quiere que mates a 15 jugadores de la Horda en Corona de Hielo.‡Le Grand capitaine Justin Bartlett, à bord du Brise-ciel, vous demande de tuer 15 personnages-joueurs de la Horde dans la Couronne de glace.‡破天号的高级指挥官加斯汀·巴雷特要你在冰冠冰川地区杀死15名部落玩家。‡破天者號上的提督賈斯汀·巴特勒要你在寒冰皇冠殺掉15個部落玩家。',
  }
},
[13234] = {
  {
    'Faça com que paguem caro!‡Они заплатят!‡Sie müssen zahlen!‡응징하라!‡¡Que lo paguen!‡¡Que lo paguen!‡Faites-les payer !‡血的代价！‡叫他們付出代價!',
    nil,
    'O Exterminador dos Céus Korm Escaranegra quer que você mate 15 Jogadores da Aliança na Coroa de Gelo.‡Убейте 15 игроков Альянса в Ледяной Короне по поручению покорителя небес Корма Черного Шрама.‡Himmelshäscher Korm Schwarznarbe möchte, dass Ihr 15 Spieler der Allianz in Eiskrone tötet.‡하늘약탈자 코름 블랙스카가 얼음왕관에서 얼라이언스 전투원 15명을 처치해 달라고 했습니다.‡El atracador del cielo Korm Marcanegra quiere que mates a 15 jugadores de la Alianza en Corona de Hielo.‡El atracador del cielo Korm Marcanegra quiere que mates a 15 jugadores de la Alianza en Corona de Hielo.‡Le Saccageur-des-cieux Korm Noire-balafre vous demande de tuer 15 personnages-joueurs de l\'Alliance dans la Couronne de glace.‡掠天者考尔姆·黑痕要你在冰冠冰川地区杀死15名联盟玩家。‡空奪者寇姆·黑疤要你在寒冰皇冠殺掉15個聯盟玩家。',
  }
},
[13235] = {
  {
    'O gigante de carne campeão‡Победитель мясистого великана‡Der gigantische Fleischgigant‡살덩이 거인 용사‡El gigante de carne campeón‡El gigante de carne campeón‡Le champion des géants de chair‡最强大的血肉巨人‡血肉巨人鬥士',
    nil,
    'Fale com Margrave Dhakar no limite oeste da Usina de Carne para começar o ataque contra Morbidus. Depois de derrotar Morbidus, apresente-se à Cavaleira das Trevas Arly, na Guarda Negra.‡Поговорите с Маргрейвом Дакаром на западной оконечности Мясопилки, чтобы напасть на Тлетворца. Когда Тлетворец будет уничтожен, доложите об этом темной всаднице Арли из Черного дозора.‡Sprecht mit Markgraf Dhakar am westlichen Ende der Fleischwerke, um die Aufmerksamkeit von Morbidus zu erregen. Erstattet der Dunkelreiterin Arly an der Schwarzwacht Bericht, nachdem Ihr Morbidus getötet habt.‡살덩이작업장의 서쪽 끝에 있는 마르그레이브 다카르와 대화하여 모르비두스와 싸워야 합니다. 모르비두스를 쓰러뜨린 다음 어둠의 감시초소에 있는 어둠기수 알리에게 보고해야 합니다.‡Habla con Margrave Dhakar en el extremo oeste de La Factoría de Carne para cazar a Morbidus. Cuando hayas derrotado a Morbidus, informa a la jinete oscura Arly en La Guardia Negra.‡Habla con Margrave Dhakar en el extremo oeste de La Factoría de Carne para cazar a Morbidus. Cuando hayas derrotado a Morbidus, informa a la jinete oscura Arly en La Guardia Negra.‡Parlez à Margrave Dhakar, à l\'extrémité ouest de la Charognerie, pour vous battre avec Morbidus. Une fois Morbidus vaincu, faites votre rapport à la Cavalière noire Arly au Guet noir.‡与缝合场西端的玛格拉弗·塔卡尔交谈，然后参加对摩比乌斯的战斗。击败摩比乌斯之后，返回黑色观察站，向黑暗骑士阿尔蕾复命。‡在血肉作坊的西端，與瑪葛瑞弗·達卡交談與莫比達斯接戰的事宜。擊敗莫比達斯以後，向黑色守望的黑騎兵阿爾利回報。',
  }
},
[13236] = {
  {
    'O exército dos malditos‡Войско проклятых‡Armee der Verdammten‡저주받은 자들의 군대‡El ejército de los malditos‡El ejército de los malditos‡L\'armée des damnés‡召唤大军‡詛咒軍團',
    nil,
    'Matthias Lehner, no Acampamento Avançado da Primeira Legião, quer que você erga um exército de 100 Lacaios Carniçálicos.‡По заданию Матиаса Нетлера из Лагеря сопротивления первого легиона создайте армию из 100 вурдалаков-прислужников.‡Matthias Lehner im Vorhutslager der Ersten Legion möchte, dass Ihr eine Armee von 100 ghulischen Dienern auferstehen lasst.‡1군단 전진기지에 있는 마시어스 레넷이 100마리의 구울 하수인 부대를 되살려 달라고 했습니다.‡Matthias Lehner en el Puesto de Avanzada de la Primera Legión quiere que alces un ejército de 100 esbirros necrófagos.‡Matthias Lehner en el Puesto de Avanzada de la Primera Legión quiere que alces un ejército de 100 esbirros necrófagos.‡Matthias Lehner, au Camp avancé de la Première légion, vous a demandé de lever une armée de 100 Séides macabres.‡第一军团前线营地的米斯希尔萨·阿奈尔要在幻境中向你演示巫妖王如何召唤一支由100个食尸鬼奴仆组成的部队。‡第一軍團前進營地的米希阿斯·薩爾奈要求你，喚起100名食屍爪牙，以讓它們加入軍隊。',
  }
},
[13237] = {
  {
    'Sondando as defesas‡Тычки и тумаки‡Stechen und Stoßen‡적을 알아내는 법‡Codazo y pinchazo‡Codazo y pinchazo‡Titiller l\'ennemi‡知己知彼‡刺探',
    nil,
    'Koltirus Tecemorte, a bordo do Martelo de Orgrim, quer que você mate 5 Abominações Abrutalhadas, 5 Necromantes Maléficos e 5 Adeptos das Sombras no Front Partido.‡По поручению Кольтиры Ткача Смерти, находящегося на борту "Молота Оргрима", вы должны отправиться на Прорванный фронт и уничтожить 5 неповоротливых поганищ, 5 злокозненных некромантов и 5 адептов Тьмы.‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr Euch an die Zerbrochene Front begebt und 5 bullige Monstrositäten, 5 bösartige Totenbeschwörer und 5 Schattenadepten besiegt.‡오그림의 망치호에 있는 콜티라 데스위버가 파괴된 싸움터로 가서 덩치 큰 누더기골렘 5마리, 재앙의 강령술사 5마리, 어둠의 숙련사제 5명을 처치해 달라고 했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que vayas a El Frente Roto y derrotes a 5 abominaciones descomunales, 5 nigromantes maléficos y 5 adeptos de sombra.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que vayas a El Frente Roto y derrotes a 5 abominaciones descomunales, 5 nigromantes maléficos y 5 adeptos de sombra.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande de vous rendre au Front brisé et de vaincre 5 Abominations massives, 5 Nécromanciens maléfiques et 5 Adeptes des ombres.‡奥格瑞姆之锤的库尔迪拉·织亡者要你前往破碎前线，杀死5名笨重的憎恶、5名邪恶通灵师和5名暗影专家。‡奧格林之錘上的寇爾提拉·亡織者要你前往破碎前線並擊敗5隻笨重的憎惡體，5位毒惡的死靈法師，與5位暗影菁英。',
  }
},
[13238] = {
  {
    'Vamos ver se dá pro gasto!‡Какая-то полезная штука‡Zu etwas zu gebrauchen?‡어딘가에 유용한?‡¿Para algo bueno?‡¿Para algo bueno?‡Bon à quelque chose ?‡有价值的帮手？‡有什麼好料的?',
    nil,
    'O Exterminador dos Céus Korm Escaranegra quer que você fale com o Engenheiro-chefe Cobregarra a bordo do Martelo de Orgrim.‡Поговорите с главным инженером Меднопалом на борту "Молота Оргрима" по поручению покорителя небес Корма Черного Шрама.‡Himmelshäscher Korm Schwarznarbe möchte, dass Ihr mit dem Chefingenieur Kupferklammer an Bord der Orgrims Hammer sprecht.‡하늘약탈자 코름 블랙스카가 오그림의 망치호에 있는 선임기술자 코퍼클로와 대화해 달라고 했습니다.‡El atracador del cielo Korm Marcanegra quiere que hables con el ingeniero jefe Garrabronce a bordo del Martillo de Orgrim.‡El atracador del cielo Korm Marcanegra quiere que hables con el ingeniero jefe Garrabronce a bordo del Martillo de Orgrim.‡Le Saccageur-des-cieux Korm Noire-balafre vous demande de parler à l\'Ingénieur en chef Cuivregrif à bord du Marteau d\'Orgrim.‡掠天者考尔姆·黑痕要你与奥格瑞姆之锤的首席技师考伯克拉谈一谈。‡奧格林之錘上的空奪者寇姆·黑疤要求你，與首席工程師銅爪交談。',
  }
},
[13239] = {
  {
    'Volatilidade‡Непостоянство‡Verflüchtigung‡휘발성‡Volatilidad‡Volatilidad‡Volatilité‡爆炸油‡烈不烈',
    nil,
    'O Engenheiro-chefe Cobregarra quer que você use o Óleo Volátil do Cobregarra no Front Partido para atrair 3 Garraéreas Ninhálgida.|n|nPara usar o óleo, você precisa coletar uma Pilha de Ossos, um Elmo Abandonado e uma Armadura Abandonada no campo de batalha de lá.‡Отправляйтесь к Прорванному фронту и воспользуйтесь летучим маслом Меднопала, чтобы привлечь 3 ледяных небесных когтей.|n|nДля того чтобы использовать масло, соберите на поле сражения груду костей, брошенный шлем и брошенный доспех.‡Chefingenieur Kupferklammer möchte, dass Ihr Kupferklammers flüchtiges Öl an der Zerbrochenen Front benutzt um 3 Frostbrutvollstrecker anzulocken.|n|nUm das Öl benutzen zu können, müsst Ihr auf dem Schlachtfeld einen Knochenhaufen, einen zurückgelassenen Helm und zurückgelassene Rüstung einsammeln.‡선임기술자 코퍼클로가 파괴된 싸움터에서 코퍼클로의 휘발성 기름을 사용하여 서리고룡족 하늘발톱 3마리를 유인해 달라고 했습니다.|n|n휘발유를 사용하려면 해골 더미와 버려진 투구, 버려진 갑옷을 모아야 합니다.‡El ingeniero jefe Garrabronce quiere que utilices el aceite volátil de Garrabronce en El Frente Roto para atraer a 3 garfacielo Razaescarcha.|n|nPara utilizar el aceite, tienes que agrupar una pila de huesos, un casco abandonado y una armadura abandonada del campo de batalla allí.‡El ingeniero jefe Garrabronce quiere que utilices el aceite volátil de Garrabronce en El Frente Roto para atraer a 3 garfacielo Razaescarcha.|n|nPara utilizar el aceite, tienes que agrupar una pila de huesos, un casco abandonado y una armadura abandonada del campo de batalla allí.‡L\'Ingénieur en chef Cuivregrif vous demande d\'utiliser l\'Huile volatile de Cuivregrif au Front brisé pour attirer 3 Serre-du-ciel couvegivres.|n|nPour utiliser l\'huile, vous devez récupérer une Pile d\'ossements, un Heaume abandonné et une Armure abandonnée sur le champ de bataille où vous vous trouvez.‡首席技师考伯克拉要你在破碎前线使用考伯克拉的爆炸油吸引3只霜巢天爪龙。|n|n你需要收集被丢弃的头盔、被丢弃的护甲和一堆白骨才能使用爆炸油，这些材料都可以在破碎前线找到。‡首席工程師銅爪要求你，在破碎前線上使用銅爪的烈性油，以吸引3頭霜育天爪。|n|n為了使用烈性油，你必須在戰場上收集一個白骨堆、一頂被遺棄的頭盔、和一副被遺棄的盔甲。',
  }
},
[13240] = {
  {
    'Tempor vê Constructos Centrífugos em seu futuro!‡Времиар превидит встречу с центрифужными созданиями!‡Timear prophezeit Zentrifugenkonstrukte in Eurer Zukunft!‡티미어의 예언: 원심력 피조물!‡¡Tiemporeja ve ensamblajes de centrifugadora en tu futuro!‡¡Tiemporeja ve ensamblajes de centrifugadora en tu futuro!‡Timear prédit des assemblages centrifuges dans votre avenir !‡提迈尔的预言：离心构造体！‡泰彌亞在你的未來預見了離心傀儡!',
    nil,
    'O Arquimago Tempor, em Dalaran, previu que você precisa destruir 10 Constructos Centrífugos.‡Исполните волю верховного мага Времиара, обитающего в Даларане, которого посетило видение, где вы уничтожаете 10 центрифужных созданий.‡Erzmagier Timear in Dalaran hat vorausgesehen, dass Ihr 10 Zentrifugenkonstrukte zerstören müsst.‡달라란의 대마법사 티미어의 예언에 따라 원심력 피조물 10개를 파괴해야 합니다.‡El archimago Tiemporeja de Dalaran ha vaticinado que debes destruir 10 ensamblajes de centrifugadora.‡El archimago Tiemporeja de Dalaran ha vaticinado que debes destruir 10 ensamblajes de centrifugadora.‡L\'Archimage Timear à Dalaran a prédit que vous détruirez 10 Assemblages centrifuges.‡根据达拉然的大法师提迈尔的预言，你必须去消灭10台离心构造体。‡達拉然的大法師泰彌亞預見你必須摧毀10個離心傀儡。',
  }
},
[13241] = {
  {
    'Tempor vê Berserkers Ymarjar em seu futuro!‡Времиар превидит встречу имирьярскими берсерками!‡Timear prophezeit Berserker der Ymirjar in Eurer Zukunft!‡티미어의 예언: 이미야르 광전사!‡¡Tiemporeja ve rabiosos Ymirjar en tu futuro!‡¡Tiemporeja ve rabiosos Ymirjar en tu futuro!‡Timear voit des berserkers ymirjar dans votre avenir !‡提迈尔的预言：伊米亚狂战士！‡泰彌亞在你的未來預見了依米亞狂戰士!',
    nil,
    'O Arquimago Tempor, em Dalaran, quer que você mate 7 Berserkers Ymarjar.‡Уничтожьте по заданию верховного мага Времиара, обитающего в Даларане, 7 имирьярских берсерков.‡Erzmagier Timear in Dalaran möchte, dass Ihr 7 Berserker der Ymirjar tötet.‡달라란의 대마법사 티미어가 이미야르 광전사 7명을 처치해 달라고 했습니다.‡El archimago Tiemporeja de Dalaran quiere que mates a 7 rabiosos Ymirjar.‡El archimago Tiemporeja de Dalaran quiere que mates a 7 rabiosos Ymirjar.‡L\'Archimage Timear, à Dalaran, vous demande de tuer 7 Berserkers ymirjars.‡达拉然的大法师提迈尔要你去杀死7个伊米亚狂战士。‡達拉然的大法師泰彌亞要求你，殺掉7個依米亞狂戰士。',
  }
},
[13242] = {
  {
    'Darkness Stirs‡Шевеление Тьмы‡Die Dunkelheit regt sich‡어둠의 물결‡La oscuridad se revuelve‡La oscuridad se revuelve‡Les ténèbres s\'agitent‡黑暗的骚动‡當黑暗降臨',
    nil,
    'Gather Saurfang\'s Battle Armor from the field of battle and return it to High Overlord Saurfang at Warsong Hold in Borean Tundra.‡Соберите на поле боя боевые доспехи Саурфанга и верните их верховному правителю Саурфангу в крепость Песни Войны, что в Борейской тундре.‡Geht aufs Schlachtfeld hinaus, sucht nach Saurfangs Schlachtrüstung und bringt sie zu Hochfürst Saurfang in der Kriegshymnenfestung in der Boreanischen Tundra.‡전장에서 사울팽의 전투 갑옷을 회수해 북풍의 땅 전쟁노래 요새에 있는 대군주 사울팽에게 돌려줘야 합니다.‡Recoge la armadura de batalla de Colmillosauro del campo de batalla y devuélvesela al alto señor supremo Colmillosauro en el Bastión Grito de Guerra, en la Tundra Boreal.‡Recoge la armadura de batalla de Colmillosauro del campo de batalla y devuélvesela al alto señor supremo Colmillosauro en el Bastión Grito de Guerra, en la Tundra Boreal.‡Récupérez l\'Armure de bataille de Saurcroc sur le champ de bataille et rapportez-la au Haut seigneur Saurcroc au Bastion Chanteguerre dans la Toundra Boréenne.‡在战场上收集萨鲁法尔的战甲，然后前往北风苔原的战歌要塞，将它交给萨鲁法尔大王。‡由戰場上蒐集薩魯法爾的戰甲帶回給薩魯法爾霸王，他就在北風凍原的戰歌堡。',
  }
},
[13243] = {
  {
    'Tempor vê Agentes Infinitos em seu futuro!‡Времиар превидит встречу с посланницами из рода Бесконечности!‡Timear prophezeit Ewige Agenten in Eurer Zukunft!‡티미어의 예언: 무한의 용군단!‡¡Tiemporeja ve agentes Infinitos en tu futuro!‡¡Tiemporeja ve agentes Infinitos en tu futuro!‡Timear prédit des agents infinis dans votre avenir !‡提迈尔的预言：永恒密探！‡泰彌亞在你的未來預見了恆龍密探!',
    nil,
    'O Arquimago Tempor, em Dalaran, previu que você precisa matar 4 Agentes Infinitos.‡Верховный маг Времиар из Даларана предчувствует, что вам необходимо убить 4 посланниц из рода Бесконечности.‡Erzmagier Timear in Dalaran hat prophezeit, dass Ihr 4 ewige Agenten töten müsst.‡달라란의 대마법사 티미어의 예언에 따라 무한의 용군단 4마리를 처치해야 합니다.‡El archimago Tiemporeja de Dalaran ha vaticinado que debes matar a 4 agentes Infinitos.‡El archimago Tiemporeja de Dalaran ha vaticinado que debes matar a 4 agentes Infinitos.‡L\'Archimage Timear à Dalaran a prédit que vous tuerez 4 Agents infinis.‡根据达拉然的大法师提迈尔的预言，你必须去杀死4个永恒密探。‡達拉然的大法師泰彌亞預見你必須殺死4頭恆龍密探。',
  }
},
[13244] = {
  {
    'Tempor vê Vanguardas Titânicas em seu futuro!‡Времиар превидит встречу с титановыми воинами!‡Timear prophezeit Titanvorposten in Eurer Zukunft!‡티미어의 예언: 티타늄 선봉대원!‡¡Tiemporeja ve vanguardias de titanio en tu futuro!‡¡Tiemporeja ve vanguardias de titanio en tu futuro!‡Timear prédit des avant-gardes en titane dans votre avenir !‡提迈尔的预言：泰坦神铁先锋！‡泰彌亞在你的未來預見了泰坦鋼先鋒!',
    nil,
    'O Arquimago Tempor, em Dalaran, previu que você precisa matar 7 Vanguardas Titânicas.‡Убейте 7 титановых воинов, дабы предсказанное верховным магом Времиаром из Даларана сбылось.‡Erzmagier Timear in Dalaran hat prophezeit, dass Ihr 7 Titanvorposten töten müsst.‡달라란의 대마법사 티미어의 예언에 따라 티타늄 선봉대원 7명을 처치해야 합니다.‡El archimago Tiemporeja de Dalaran ha vaticinado que debes matar a 7 vanguardias de titanio.‡El archimago Tiemporeja de Dalaran ha vaticinado que debes matar a 7 vanguardias de titanio.‡L\'Archimage Timear à Dalaran a prédit que vous tuerez 7 Avant-gardes en titane.‡根据达拉然的大法师提迈尔的预言，你必须去杀死7个泰坦神铁先锋。‡達拉然的大法師泰彌亞預見你必須殺死7個泰坦鋼先鋒。',
  }
},
[13245] = {
  {
    'Prova da Morte: Ingvar, o Ladravaz‡Победный трофей: Ингвар Расхититель‡Todesbeweis: Ingvar der Brandschatzer‡죽음의 증거: 약탈자 잉그바르‡Prueba de defunción: Ingvar el Desvalijador‡Prueba de defunción: Ingvar el Desvalijador‡Preuve de la mort d\'Ingvar le Pilleur‡死亡证明：劫掠者因格瓦尔‡死亡證明:『盜掠者』因格瓦',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe entregue o Machado do Ladravaz.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите секиру Расхитителя верховному магу Лан\'далоку, обитающему в Даларане.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit der Axt des Brandschatzers zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 거대한 약탈자의 도끼를 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que regreses con el hacha del Desvalijador.|n|nEsta misión solo se puede completar en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que regreses con el hacha del Desvalijador.|n|nEsta misión solo se puede completar en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran veut que vous lui rapportiez la Hache du Pilleur.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将掠夺者的战斧交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回盜掠者的斧頭。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13246] = {
  {
    'Prova da Morte: Keristrasza‡Победный трофей: Керистраза‡Todesbeweis: Keristrasza‡죽음의 증거: 케리스트라자‡Prueba de defunción: Keristrasza‡Prueba de defunción: Keristrasza‡Preuve de la mort de Keristrasza‡死亡证明：克莉斯塔萨‡死亡證明:凱瑞史卓莎',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga o Coração Partido de Keristrasza.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите в Даларан по заданию кровавого верховного мага Лан\'далока разбитое сердце Керистразы.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit Keristraszas gebrochenem Herzen zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 케리스트라자의 상처받은 심장을 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que regreses con el corazón roto de Keristrasza.|n|nEsta misión solo se puede completar en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que regreses con el corazón roto de Keristrasza.|n|nEsta misión solo se puede completar en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous demande de lui rapporter le Cœur brisé de Keristrasza.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将克莉斯塔萨的破碎之心交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回凱瑞史卓莎的碎心。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13247] = {
  {
    'Prova da Morte: Guardião de Meridianos Éregos‡Победный трофей: хранитель энергии Эрегос‡Todesbeweis: Leywächter Eregos‡죽음의 증거: 지맥 수호자 에레고스‡Prueba de defunción: Guardián-Ley Eregos‡Prueba de defunción: Guardián-Ley Eregos‡Preuve de la mort du gardien-tellurique Eregos‡死亡证明：魔网守护者埃雷苟斯‡死亡證明:地脈守護者伊瑞茍斯',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga um Sintonizador Meridional.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите устройство для настройки силовых линий верховному магу Лан\'далоку в Даларан.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit einem Leylinienempfänger zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 지맥 동조기를 하나 가져다 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que regreses con un sintonizador de línea Ley.|n|nEsta misión solo se puede completar en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que regreses con un sintonizador de línea Ley.|n|nEsta misión solo se puede completar en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous demande de lui rapporter un Harmonisateur de ligne tellurique.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将魔网调谐器交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回一個地脈調諧器。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13248] = {
  {
    'Prova da Morte: Rei Ymiron‡Победный трофей: король Имирон‡Todesbeweis: König Ymiron‡죽음의 증거: 왕 이미론‡Prueba de defunción: Rey Ymiron‡Prueba de defunción: Rey Ymiron‡Preuve de la mort du roi Ymiron‡死亡证明：伊米隆国王‡死亡證明:依米倫王',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga o Camafeu da Rainha Falecida.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите медальон Усопшей королевы верховному магу Лан\'далоку в Даларан.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalok in Dalaran möchte, dass Ihr mit dem Medaillon der verstorbenen Königin zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 서거한 여왕의 펜던트를 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el Guardapelo de la reina fallecida.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el Guardapelo de la reina fallecida.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous demande de lui rapporter le Médaillon de la reine défunte.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将已故女王的饰物交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回一個逝去王后的墜盒。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13249] = {
  {
    '‡Доказательство смерти: пророк Тарон\'джа‡Todesbeweis: Der Prophet Tharon\'ja‡죽음의 증거: 예언자 타론자‡Prueba de defunción: El profeta Tharon\'ja‡Prueba de defunción: El profeta Tharon\'ja‡Preuve de la mort du prophète Tharon\'ja‡死亡证明：先知萨隆亚‡死亡證明:預言者薩隆杰',
    nil,
    '‡Принесите верховному магу Лан\'далоку в Даларан заколдованный амулет пророка.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalok in Dalaran möchte, dass Ihr mit dem verzauberten Tiki des Propheten zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 예언자의 마력 깃든 티키를 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el Tiki encantado del profeta.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el Tiki encantado del profeta.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran veut que vous lui rapportiez le Tiki enchanté du prophète.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将先知的魔化蒂基面具交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回一個預言者的附魔提基像。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13250] = {
  {
    'Prova da Morte: Gal\'darah‡Победный трофей: Гал\'дара‡Todesbeweis: Gal\'darah‡죽음의 증거: 갈다라‡Prueba de defunción: Gal\'darah‡Prueba de defunción: Gal\'darah‡Preuve de la mort de Gal\'darah‡死亡证明：迦尔达拉‡死亡證明:蓋爾達拉',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga os Restos do Mojo de Akali.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите верховному магу Лан\'далоку в Даларан остатки колдунства Акали.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit den Überresten von Akalis Mojo zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 아칼리의 모조 잔여물을 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves los restos de mojo de Akali.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves los restos de mojo de Akali.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous a demandé de lui rapporter le Reste de mojo d\'Akali.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将阿卡里的魔精残渣交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回阿卡利的魔精殘餘。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13251] = {
  {
    'Prova da Morte: Mal\'Ganis‡Победный трофей: Мал\'Ганис‡Todesbeweis: Mal\'Ganis‡죽음의 증거: 말가니스‡Prueba de defunción: Mal\'Ganis‡Prueba de defunción: Mal\'Ganis‡Preuve de la mort de Mal\'Ganis‡死亡证明：玛尔加尼斯‡死亡證明:瑪爾加尼斯',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga o Artefato do Mundo dos Nathrezim.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите артефакт из родного мира натрезимов верховному магу Лан\'далоку в Даларан.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit dem Artefakt aus der Heimatwelt der Nathrezim zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 나스레짐의 고향 유물을 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el artefacto del mundo de los Nathrezim.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el artefacto del mundo de los Nathrezim.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous a demandé de lui rapporter l\'Artéfact du monde natal des nathrezims.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将纳斯雷兹姆家园的圣物交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回納斯雷茲姆家鄉的神器。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13252] = {
  {
    'Prova da Morte: Sionnir, o Molda-ferro‡Победный трофей: Сьоннир Литейщик‡Todesbeweis: Sjonnir der Eisenformer‡죽음의 증거: 무쇠구체자 쇼니르‡Prueba de defunción: Sjonnir el Afilador‡Prueba de defunción: Sjonnir el Afilador‡Preuve de la mort de Sjonnir le Sculptefer‡死亡证明：塑铁者斯约尼尔‡死亡證明:『塑鐵者』斯雍尼爾',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga o Disco da Maldição da Carne.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите верховному магу Лан\'далоку в Даларан диск о Проклятии Плоти.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit der \'Datenscheibe: Fluch des Fleisches\' zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 저주받은 육체 원반을 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el disco de la maldición de la carne.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el disco de la maldición de la carne.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock, à Dalaran, vous demande de lui apporter le Disque de la malédiction de la chair.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将血肉诅咒圆盘交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回血肉詛咒圓盤。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13253] = {
  {
    'Prova da Morte: Loken‡Победный трофей: Локен‡Todesbeweis: Loken‡죽음의 증거: 로켄‡Prueba de defunción: Loken‡Prueba de defunción: Loken‡Preuve de la mort de Loken‡死亡证明：洛肯‡死亡證明:洛肯',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga o Anel de Rubi Celestial.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите верховному магу Лан\'далоку в Даларан божественное рубиновое кольцо.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit dem himmlischen Rubinring zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 천상의 루비 반지를 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el anillo de rubí celestial.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el anillo de rubí celestial.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous demande de lui rapporter l\'Anneau de rubis céleste.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将天界红宝石戒指交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回天界紅寶石戒指。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13254] = {
  {
    '‡Доказательство смерти: Ануб\'арак‡Todesbeweis: Anub\'arak‡죽음의 증거: 아눕아락‡Prueba de defunción: Anub\'arak‡Prueba de defunción: Anub\'arak‡Preuve de la mort d\'Anub\'arak‡死亡证明：阿努巴拉克‡死亡證明:阿努巴拉克',
    nil,
    '‡Принесите бесполезную корону Ануб\'арака верховному магу Лан\'далоку из Даларана.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit der unnützen Krone Anub\'araks zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 아눕아락의 옛 왕관을 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves la vana corona de Anub\'arak.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves la vana corona de Anub\'arak.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous demande de lui rapporter la Couronne oisive d\'Anub\'arak.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将阿努巴拉克的王冠交给他。|n|n该任务必须在英雄难度下完成。‡',
  }
},
[13255] = {
  {
    'Prova da Morte: Arauto Volazj‡Победный трофей: глашатай Волаж‡Todesbeweis: Herold Volazj‡죽음의 증거: 사자 볼라즈‡Prueba de defunción: Heraldo Volazj‡Prueba de defunción: Heraldo Volazj‡Preuve de la mort du héraut Volazj‡死亡证明：传令官沃拉兹‡死亡證明:信使沃菈齊',
    nil,
    'O Arquimago Lan\'dalock, em Dalaran, quer que você lhe traga o Cérebro Definhado do Sem-rosto.|n|nEsta missão só pode ser cumprida em modo Heroico.‡Принесите верховному магу Лан\'далоку в Даларан усохший мозг безликого.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit dem siechenden Gehirn des Gesichtslosen zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 얼굴 없는 자의 말라버린 신체를 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el cerebro marchito del ignoto.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves el cerebro marchito del ignoto.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous demande de lui rapporter le Cerveau desséché de sans-visage.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将无面者的萎缩大脑交给他。|n|n该任务必须在英雄难度下完成。‡達拉然的大法師朗達拉克要求你，帶回無面者的萎縮腦部。|n|n這個任務只能在英雄難度中完成。',
  }
},
[13256] = {
  {
    '‡Доказательство смерти: Синигоса‡Todesbeweis: Cyanigosa‡죽음의 증거: 시아니고사‡Prueba de defunción: Cianigosa‡Prueba de defunción: Cianigosa‡Preuve de la mort de Cyanigosa‡死亡证明：塞安妮苟萨‡死亡證明:霞妮苟莎',
    nil,
    '‡Принесите верховному магу Лан\'далоку в Даларан голову Синигосы.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr mit Cyanigosas Kopf zurückkehrt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡달라란의 대마법사 랜달록이 시아니고사의 머리를 가지고 돌아와 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock de Dalaran quiere que le lleves la cabeza de Cianigosa.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock de Dalaran quiere que le lleves la cabeza de Cianigosa.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock à Dalaran vous a demandé de lui rapporter la Tête de Cyanigosa.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡达拉然的大法师兰达洛克要你将塞安妮苟萨的徽记交给他。|n|n该任务必须在英雄难度下完成。‡',
  }
},
[13257] = {
  {
    'Herald of War‡Глашатай войны‡Vorbote des Krieges‡전쟁의 사자‡Heraldo de guerra‡Heraldo de guerra‡Héraut de guerre‡战争的使者‡戰爭的氣息',
    nil,
    'Report to Thrall at Grommash Hold in Orgrimmar.‡Доложите о своем прибытии Траллу, который находится в крепости Громмаш в Оргриммаре.‡Meldet Euch bei Thrall in der Feste Grommash in Orgrimmar.‡오그리마의 그롬마쉬 요새에 있는 스랄에게 보고해야 합니다.‡Preséntate ante Thrall en el Fuerte Grommash en Orgrimmar.‡Preséntate ante Thrall en el Fuerte Grommash en Orgrimmar.‡Présentez-vous à Thrall à Fort Grommash à Orgrimmar.‡前往奥格瑞玛的格罗玛什堡垒，向萨尔报到。‡向奧格瑪的葛羅瑪許堡的索爾報到。',
  }
},
[13258] = {
  {
    'Oportunidade‡Замечательная возможность‡Gelegenheit‡기회‡Oportunidad‡Oportunidad‡Une occasion‡机会‡大好機會',
    nil,
    'Fale com a Sargento Kregga abaixo da Cidadela da Coroa de Gelo.‡Поговорите с сержантом Креггой под стенами Цитадели Ледяной Короны.‡Sprecht mit Unteroffizier Kregga unterhalb der Eiskronenzitadelle.‡얼음왕관 성채 아래의 하사관 크레가와 대화해야 합니다.‡Habla con la sargento Kregga debajo de la Ciudadela de la Corona de Hielo.‡Habla con la sargento Kregga debajo de la Ciudadela de la Corona de Hielo.‡Parlez au Sergent Kregga sous la Citadelle de la Couronne de glace.‡与冰冠堡垒下面的克蕾迦中士谈一谈。‡在冰冠城塞下，和克瑞佳中士交談。',
  }
},
[13259] = {
  {
    'O estabelecimento da superioridade‡Закрепить преимущество‡Für Überlegenheit sorgen‡우월성 입증‡Establecer la superioridad‡Establecer la superioridad‡Établir la supériorité‡确立优势‡先聲奪人',
    nil,
    'A Sargento Kregga, na Cidadela da Coroa de Gelo, quer que você mate 10 Terrores Brutos.‡Убейте 10 неповоротливых громад по поручению сержанта Крегги, находящегося у Цитадели Ледяной Короны.‡Unteroffizier Kregga an der Eiskronenzitadelle möchte, dass Ihr 10 bullige Schrecken tötet.‡얼음왕관 성채의 하사관 크레가가 덩치 큰 역병괴물 10마리를 처치해 달라고 했습니다.‡El sargento Kregga en la Ciudadela de la Corona de Hielo quiere que mates a 10 horrores descomunales.‡El sargento Kregga en la Ciudadela de la Corona de Hielo quiere que mates a 10 horrores descomunales.‡Le Sergent Kregga, à la Citadelle de la Couronne de glace, vous demande de tuer 10 Horreurs massives.‡冰冠堡垒的克蕾迦中士要你去杀死10只笨重的恐尸。‡冰冠城塞裡的克瑞佳中士要求你，殺死10頭笨重的恐獸。',
  }
},
[13260] = {
  {
    'Os iguais se reconhecem‡Уж кто бы говорил!‡Der Insider‡사돈 남 말‡Coge uno para conocer a uno‡Coge uno para conocer a uno‡Les ennemis de mes ennemis…‡知根知底‡引薦',
    nil,
    'O Exterminador dos Céus Korm quer que você se apresente a Koltirus Tecemorte no Martelo de Orgrim.‡По заданию покорителя небес Корма поговорите с Кольтирой Ткачом Смерти на борту "Молота Оргрима".‡Himmelshäscher Korm wünscht, dass Ihr mit Koltira Todesweber auf der Orgrims Hammer sprecht.‡하늘약탈자 코름이 오그림의 망치호에서 콜티라 데스위버를 만나보라고 했습니다.‡El atracador del cielo Korm quiere que hables con Koltira Tejemuerte en el Martillo de Orgrim.‡El atracador del cielo Korm quiere que hables con Koltira Tejemuerte en el Martillo de Orgrim.‡Le Saccageur-des-cieux Korm Noire-balafre vous demande de parler à Koltira Tissemort, à bord du Marteau d\'Orgrim.‡掠天者考尔姆要你与奥格瑞姆之锤的库尔迪拉·织亡者谈一谈。‡空奪者寇姆·黑疤要求你，和奧格林之錘上的寇爾提拉·亡織者對話。',
  }
},
[13261] = {
  {
    'Volatilidade‡Непостоянство‡Verflüchtigung‡휘발성‡Volatilidad‡Volatilidad‡Volatilité‡爆炸油‡烈不烈',
    nil,
    'O Engenheiro-chefe Cobregarra quer que você use o Óleo Volátil do Cobregarra no Front Partido para atrair 3 Garraéreas Ninhálgida.|n|nPara usar o óleo, você precisa coletar uma Pilha de Ossos, um Elmo Abandonado e uma Armadura Abandonada no campo de batalha de lá.‡Отправляйтесь к Прорванному фронту и воспользуйтесь летучим маслом Меднопала, чтобы привлечь 3 ледяных небесных когтей.|n|nДля того чтобы использовать масло, соберите на поле сражения груду костей, брошенный шлем и брошенную броню.‡Chefingenieur Kupferklammer möchte, dass Ihr Kupferklammers flüchtiges Öl an der Zerbrochenen Front benutzt, um 3 Frostbrutvollstrecker anzulocken.|n|nUm das Öl benutzen zu können, müsst Ihr auf dem dortigen Schlachtfeld einen Knochenhaufen, einen zurückgelassenen Helm und eine zurückgelassene Rüstung einsammeln.‡선임기술자 코퍼클로가 파괴된 싸움터에서 코퍼클로의 휘발성 기름을 사용하여 서리고룡족 하늘발톱 3마리를 유인해 달라고 했습니다.|n|n기름을 사용하려면 해골 더미와 버려진 투구, 버려진 갑옷을 모아야 합니다.‡El ingeniero jefe Garrabronce quiere que utilices el aceite volátil de Garrabronce en El Frente Roto para atraer a 3 garfacielo Razaescarcha.|n|nPara utilizar el aceite, tienes que agrupar una pila de huesos, un casco abandonado y una armadura abandonada del campo de batalla allí.‡El ingeniero jefe Garrabronce quiere que utilices el aceite volátil de Garrabronce en El Frente Roto para atraer a 3 garfacielo Razaescarcha.|n|nPara utilizar el aceite, tienes que agrupar una pila de huesos, un casco abandonado y una armadura abandonada del campo de batalla allí.‡L\'Ingénieur en chef Cuivregrif vous a demandé d\'utiliser l\'Huile volatile de Cuivregrif au Front brisé pour attirer 3 Serre-du-ciel couvegivres.|n|nPour pouvoir utiliser l\'huile, vous devez ramasser une Pile d\'ossements, un Heaume abandonné et une Armure abandonnée sur le champ de bataille sur place.‡首席技师考伯克拉要你在破碎前线使用考伯克拉的爆炸油吸引3只霜巢天爪龙。|n|n你需要收集被丢弃的头盔、被丢弃的护甲和一堆白骨才能使用爆炸油，这些材料都可以在破碎前线找到。‡首席工程師銅爪，要你在破碎前線使用銅爪的烈性油，以吸引3隻霜育天爪。|n|n為了使用烈性油，你必須先從戰場上取得被遺棄的頭盔、被遺棄的盔甲與骨堆。',
  }
},
[13262] = {
  {
    'Mande pelos ares!‡Мощный взрыв‡Jagt es hoch!‡폭발!‡¡Enciéndelo!‡¡Enciéndelo!‡Explosez tout !‡引爆！‡炸翻它!',
    nil,
    'Vá à Pilha de Bombas de Saronita mais próxima e acenda o pavio.‡Идите к ближайшему штабелю саронитовых бомб и подожгите фитиль.‡Geht zu dem nahen Saronitbombenstapel und zündet die Lunte an.‡근처의 사로나이트 폭탄 더미로 가서 도화선에 불을 붙여야 합니다.‡Acércate al montón de bombas de saronita para encender la mecha.‡Acércate al montón de bombas de saronita para encender la mecha.‡Approchez-vous de la Pile de bombes en saronite pour allumer la mèche.‡前往附近的萨隆邪铁炸弹堆旁边，点燃引线。‡點燃附近薩鋼炸彈堆的引信。',
  }
},
[13263] = {
  {
    'Pavio curto‡Фитиль короток!‡Eine kurze Lunte‡짧은 도화선‡Una mecha corta‡Una mecha corta‡Une mèche courte‡引线太短‡一觸即發',
    nil,
    'Quando chegar ao fundo, investigue o lugar.‡Ищите следы и подсказки, независимо от того, куда вас занесет взрывной волной.‡Haltet nach Hinweisen Ausschau, wo auch immer der Sturz Euch hinführt.‡추락한 곳에서 단서를 찾아야 합니다.‡Busca pistas allá donde caigas.‡Busca pistas allá donde caigas.‡Cherchez des indices à l\'endroit où la chute vous projette.‡在你被杂物砸中的地方寻找线索。‡注意不要被落下的殘骸擊中。',
  }
},
[13264] = {
  {
    'Abominável!‡Как все погано!‡Das ist monströs!‡혐오스러운 친구‡¡Eso es abominable!‡¡Eso es abominable!‡C\'est abominable !‡你的憎恶伙伴‡有夠討厭!',
    nil,
    'Koltirus Tecemorte, no Martelo de Orgrim, quer que você use o Kit de Reanimação de Abominações para criar uma Abominação Reanimada, que você deve usar para matar 15 Carniçais do Gelo, 15 Geists Malévolos e 15 Soldados da Aliança Revividos.‡По заданию Кольтиры Ткача Смерти с "Молота Оргрима", используя набор для оживления, воскресите поганище и с его помощью уничтожьте 15 ледяных вурдалаков, 15 агрессивных упырей и 15 восставших солдат Альянса.‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr das Wiederbelebungsset für Monstrositäten benutzt, um eine wiedererweckte Monstrosität zu erschaffen, mit der Ihr 15 Eisghule, 15 heimtückische Spuke und 15 auferstandene Soldaten der Allianz töten sollt.‡오그림의 망치호에 있는 콜티라 데스위버가 누더기골렘 부활 도구를 사용해 되살아난 누더기골렘을 만들어 얼음 구울 15마리, 흉포한 외눈깨비 15마리, 되살아난 얼라이언스 병사 15명을 처치해 달라고 했습니다.‡Koltira Tejemuerte en el Martillo de Orgrim quiere que utilices el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Koltira Tejemuerte en el Martillo de Orgrim quiere que utilices el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande d\'utiliser la Trousse de réanimation d\'abomination pour créer une Abomination réanimée, que vous devez utiliser pour tuer 15 Goules glacées, 15 Geists vicieux et 15 Soldats de l\'Alliance ressuscités.‡奥格瑞姆之锤的库尔迪拉·织亡者要你使用憎恶复活工具包制造一名复活的憎恶，然后利用它杀死15只冰寒食尸鬼、15只残忍的恶鬼和15名复活的联盟士兵。‡奧格林之錘上的寇爾提拉·亡織者要你使用憎惡體再活化工具包創造再活化的憎惡體，並用來殺掉15隻冰結食屍鬼、15隻邪惡的魂屍、15個復活的聯盟士兵。',
  }
},
[13265] = {
  {
    'Buscar panos‡Сбор ткани‡Das Plündern von Stoffen‡옷감 수거법‡Rebuscar tela‡Rebuscar tela‡Récupération de tissu‡布匹搜寻‡布料搜掠',
    nil,
    nil,
  }
},
[13266] = {
  {
    'A Life Without Regret‡Жизнь без сожалений‡Ein Leben ohne Reue‡후회 없는 삶‡Una vida sin arrepentimientos‡Una vida sin arrepentimientos‡Une vie sans regrets‡毫无遗憾的一生‡此生無悔',
    nil,
    'Take the portal to Undercity located in Grommash Hold and report to Vol\'jin.‡Воспользуйтесь порталом в Подгород, расположенном в крепости Громмаш, и доложите о своем прибытии Вол\'джину.‡Nehmt das Portal nach Unterstadt, das sich in der Feste Grommash befindet, und meldet Euch bei Vol\'jin.‡그롬마쉬 요새에 있는 차원문을 타고 언더시티로 가 볼진에게 보고해야 합니다.‡Atraviesa el portal a Entrañas que se encuentra en el Fuerte Grommash para presentarte ante Vol\'jin.‡Atraviesa el portal a Entrañas que se encuentra en el Fuerte Grommash para presentarte ante Vol\'jin.‡Prenez le Portail vers Fossoyeuse situé à Fort Grommash et faites votre rapport à Vol\'jin.‡穿过格罗玛什堡垒内的传送门，前往幽暗城，向沃金报到。‡從葛羅瑪許堡的傳送門前往幽暗城，並向沃金報到。',
  }
},
[13267] = {
  {
    'The Battle For The Undercity‡Битва за Подгород‡Die Schlacht um Unterstadt‡언더시티 수복 작전‡La batalla por Entrañas‡La batalla por Entrañas‡La bataille pour Fossoyeuse‡幽暗城之战‡幽暗城之戰',
    nil,
    'Assist Thrall and Sylvanas in retaking the Undercity for the Horde.|n|nReport to Thrall should you succeed.‡Помогите Траллу и Сильване вернуть Орде контроль над Подгородом.|n|nВ случае успеха отрапортуйте об этом Траллу.‡Unterstützt Thrall und Sylvanas, Unterstadt für die Horde zurückzuerobern.|n|nMeldet Euch bei Thrall, solltet Ihr erfolgreich sein.‡스랄과 실바나스를 도와 호드의 언더시티를 되찾아야 합니다.|n|n작전에 성공하면 스랄에게 보고해야 합니다.‡Ayuda a Thrall y a Sylvanas a recuperar Entrañas para la Horda.|n|nInforma a Thrall si tienes éxito.‡Ayuda a Thrall y a Sylvanas a recuperar Entrañas para la Horda.|n|nInforma a Thrall si tienes éxito.‡Aidez Thrall et Sylvanas à reprendre Fossoyeuse pour la Horde.|n|nSi vous réussissez, allez voir Thrall.‡帮助萨尔和希尔瓦娜斯为部落夺回幽暗城。|n|n完成任务后向萨尔复命。‡協助索爾與希瓦娜斯奪回部落的幽暗城。成功以後向索爾回報。',
  }
},
