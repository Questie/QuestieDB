[27119] = {
  {
    'Roupa de Gordok‡Броня огров Гордока‡Der Ogeranzug der Gordok‡고르독 오우거 위장복‡El disfraz de ogro Gordok‡El disfraz de ogro Gordok‡La tenue d\'ogre gordok‡戈多克食人魔装‡戈多克巨魔裝',
    nil,
    'Leve um Tanino Ôgrico para Fiapo Agulhacerta.‡Принесите огрскую дубильную кислоту Уззлу Наперстяку.‡Bringt etwas Ogergerbemittel zu Knot Zwingschraub.‡노트 팀블잭에게 오우거 타닌을 가져가야 합니다.‡Lleva tanino de ogro a Knot Llavededo.‡Lleva tanino de ogro a Knot Llavededo.‡Apportez un Tanin ogre à Noué Dédodevie.‡把一份食人魔鞣酸交给诺特·希姆加克。‡帶一份巨魔鞣酸給諾特·希姆加克。',
  }
},
[27120] = {
  {
    'Roupa de Gordok‡Броня огров Гордока‡Der Ogeranzug der Gordok‡고르독 오우거 위장복‡El disfraz de ogro Gordok‡El disfraz de ogro Gordok‡La tenue d\'ogre gordok‡戈多克食人魔装‡戈多克巨魔裝',
