[27006] = {
  {
    'Sobrevoo‡Воздушная разведка‡Überflieger‡탐험 비행‡Vuela hasta allí‡Vuela hasta allí‡Survoler la terrasse‡飞越‡飛越',
    nil,
    'Investigue a área central da parte de trás do Portão do Mestre.‡Узнайте, что происходит за Вратами Мастеров.‡Untersucht den mittleren Bereich im hinteren Teil des Tors der Meister.‡지배자의 관문 뒤쪽의 중앙 지역을 조사해야 합니다.‡Investiga la zona central tras la Puerta de los Maestros.‡Investiga la zona central tras la Puerta de los Maestros.‡Examinez la zone centrale à l’arrière de la Porte des Maîtres.‡调查真主之门的中央地带。‡調查主宰之門後面的中央區域。',
  }
},
[27007] = {
  {
    'Encontro no Pântano de Prata‡Встреча в Серебристой топи‡Stelldichein in den Silbermarschen‡은빛늪지에서의 만남‡Encuentro en el Marjal Argenta‡Encuentro en el Marjal Argenta‡Rendez-vous au marécage Argenté‡银沼汇合‡銀之沼澤集會',
    nil,
    'Vá até o Alto Pântano de Prata, no Geodomo.‡Отправляйтесь в Верховье Серебристой топи в Подземье.‡Geht zu den Oberen Silbermarschen in Tiefenheim.‡심원의 영지의 은빛늪지 상류로 가야 합니다.‡Dirígete al Marjal Argenta Superior en Infralar.‡Dirígete al Marjal Argenta Superior en Infralar.‡Rendez-vous au Marécage Argenté Supérieur, dans le Tréfonds.‡前往深岩之洲的上层银沼。‡前往地深之源的銀之沼澤上層。',
  }
},
[27008] = {
  {
    'Sobrevoo‡Воздушная разведка‡Überflieger‡탐험 비행‡Vuela hasta allí‡Vuela hasta allí‡Survoler la terrasse‡飞越‡飛越',
    nil,
    'Investigue a área central da parte de trás do Portão do Mestre.‡Узнайте, что происходит за Вратами Мастеров.‡Untersucht den mittleren Bereich im hinteren Teil des Tors der Meister.‡지배자의 관문 뒤쪽의 중앙 지역을 조사해야 합니다.‡Investiga la zona central tras la Puerta de los Maestros.‡Investiga la zona central tras la Puerta de los Maestros.‡Examinez la zone centrale à l’arrière de la Porte des Maîtres.‡在真主之门后方调查中央地带。‡調查主宰之門背後的中央區域。',
  }
},
[27009] = {
  {
    'O Frigífero‡Хладовей‡Der Kältebringer‡혹한‡El Gélido‡El Gélido‡Le Porte-froid‡寒冰之王‡寒冰使者',
    nil,
    'Mate Amnennar, o Frigífero.‡Убейте Амненнара Хладовея.‡Tötet Amnennar den Kältebringer.‡혹한의 암네나르를 처치해야 합니다.‡Mata a Amnennar el Gélido.‡Mata a Amnennar el Gélido.‡Tuez Amnennar le Porte-froid.‡杀掉寒冰之王亚门纳尔。‡殺死『寒冰使者』亞門納爾。',
  }
},
[27010] = {
  {
    'Banho de mercúrio‡Ртутное погружение‡Untertauchen im Quecksilber‡수은 속으로‡Inmersión mercúrica‡Inmersión mercúrica‡Dans le vif du sujet‡瞬间潜行‡水銀氾濫',
    nil,
    'Pegue um Caixote de Trogg e use-o para mergulhar no pântano e espiar a base do Martelo do Crepúsculo a leste.‡Добудьте ящик трогга и воспользуйтесь им, чтобы незаметно подплыть к лагерю Сумеречного Молота на востоке и подслушать.‡Verschafft Euch eine Troggkiste und versteckt Euch darunter. Dann belauscht das Lager des Schattenhammers im Osten.‡트로그 상자를 입수하여 늪 속에 몸을 숨긴 다음, 동쪽에 있는 황혼의 망치단 야영지로 가 정보를 엿들어야 합니다.‡Consigue un cajón trogg y úsalo para sumergirte y para escuchar a escondidas en el campamento del Martillo Crepuscular.‡Consigue un cajón trogg y úsalo para sumergirte y para escuchar a escondidas en el campamento del Martillo Crepuscular.‡Récupérez une Caisse trogg puis utilisez-la pour vous immerger et espionner le Camp du Marteau du crépuscule, à l’est.‡获得一个穴居人板条箱，用它潜伏起来，监听东边的暮光之锤营地。‡取得一個穴居怪箱子並用它來隱藏自己，然後偷聽東邊暮光之錘營地的動靜。',
  }
},
[27011] = {
  {
    'Ladroagem dos Pinhorrubro‡Вороватая Красная Сосна‡Rotkieferdiebstahl‡붉은소나무 절도범‡Robo Pinorrojo‡Robo Pinorrojo‡Le larcin des Rougepins‡赤松失窃案‡紅松竊賊',
    nil,
    'Recupere 10 pilhas de Lenha de Beiranorte do acampamento Pinhorrubro, que fica nas Terras Pestilentas Ocidentais.‡Соберите 10 штабелей древесины лесопилки Северного Кряжа в лагере Красной Сосны в Западных Чумных землях.‡Holt aus dem Rotkieferlager in den Westlichen Pestländern 10 Stapel Nordkammholz zurück.‡서부 역병지대의 붉은소나무일족 야영지에서 북마루 목재 더미 10개를 회수해야 합니다.‡Recupera 10 pilas de madera de Crestanorte del Campamento Pinorrojo en las Tierras de la Peste del Oeste.‡Recupera 10 pilas de madera de Crestanorte del Campamento Pinorrojo en las Tierras de la Peste del Oeste.‡Récupérez 10 tas de Bois de la Crête du nord à la Cluse des Rougepins, dans les Maleterres de l’Ouest.‡从西瘟疫之地的赤松营地拿回10捆北山木材。‡到西瘟疫之地的紅松營地去取回10堆北山木材。',
  }
},
[27012] = {
  {
    'A determinação dos gnolls‡Угроза гноллов‡Lösung des Gnollproblems‡놀의 결의‡Una resolución frente a los gnolls‡Una resolución frente a los gnolls‡Procès d’intention‡解决豺狼人之道‡一個豺狼人的決心',
    nil,
    'Colete 6 Báculos de Pinhorrubro e 6 Malhos de Pinhorrubro dos gnolls Pinhorrubro.‡Соберите 6 посохов и 6 дубин гноллов из стаи Красной Сосны.‡Beschafft 6 Rotkieferstäbe und 6 Rotkieferkeulen von den Gnollen der Rotkiefer.‡붉은소나무 놀에게서 붉은소나무 곤봉과 붉은소나무 지팡이를 각각 6개씩 획득해야 합니다.‡Consigue 6 báculos Pinorrojo y 6 garrotes Pinorrojo de los gnolls Pinorrojo.‡Consigue 6 báculos Pinorrojo y 6 garrotes Pinorrojo de los gnolls Pinorrojo.‡Obtenez 6 Bâtons rougepins et 6 Massues rougepins en tuant des Gnolls rougepins.‡从赤松豺狼人那里缴获6把赤松之杖和6把赤松之锤。‡從紅松豺狼人身上取得6隻紅松護杖與6隻紅松棍棒。',
  }
},
[27013] = {
  {
    'Perto demais para me sentir confortável‡Переживания на грани‡Zu knapp für meinen Geschmack‡절박한 상황‡Por los pelos‡Por los pelos‡Une proximité dérangeante‡保持距离‡千鈞一髮',
    nil,
    'Mate 12 Raposas Raivosas perto da Serraria de Beiranorte, que fica nas Terras Pestilentas Ocidentais.‡Убейте 12 бешеных лисиц у лесопилки Северного Кряжа в Западных Чумных землях.‡Tötet in den Westlichen Pestländern nahe dem Sägewerk des Nordkamms 12 tollwütige Füchse.‡서부 역병지대의 북마루 벌목지 주변에 있는 광포한 여우 12마리를 처치해야 합니다.‡Mata a 12 zorros rabiosos cerca del Aserradero Crestanorte en las Tierras de la Peste del Oeste.‡Mata a 12 zorros rabiosos cerca del Aserradero Crestanorte en las Tierras de la Peste del Oeste.‡Tuez 12 Renards enragés près de la Scierie de la Crête du nord, dans les Maleterres de l’Ouest.‡在西瘟疫之地的北山伐木场附近杀死12只疯狂的狐狸。‡到西瘟疫之地的北山伐木場附近殺死12隻瘋狂的狐狸。',
  }
},
[27014] = {
  {
    'Bilhete santificado‡Благословенное послание‡Geheiligte Notiz‡신성한 쪽지‡Nota sacralizada‡Nota sacralizada‡La lettre sanctifiée‡圣洁的信件‡神聖筆記',
    nil,
    'Fale com a Vidente Pena do Corvo na Aldeia Narache.‡Поговорите с провидицей Воронье Перо в Лагере Нараче.‡Sprecht im Camp Narache mit Seherin Rabenfeder.‡나라체 야영지에 있는 예언자 레이븐페더와 대화해야 합니다.‡Hablan con la vidente Pluma de Cuervo y el campamente Narache.‡Hablan con la vidente Pluma de Cuervo y el campamente Narache.‡Allez parler à la Prophétesse Plume-de-corbeau, au Camp Narache.‡与纳拉其营地中的鸦羽先知交谈。‡在納拉其營地和先知鴉羽說話。',
  }
},
[27015] = {
  {
    'Bilhete consagrado‡Освященная записка‡Geweihte Notiz‡축성의 쪽지‡Nota consagrada‡Nota consagrada‡La lettre consacrée‡神圣的信件‡聖化筆記',
    nil,
    'Fale com o Andarilho do Sol Helakar, na Aldeia Narache.‡Поговорите со служителем солнца Хелаку в Лагере Нараче.‡Sprecht im Camp Narache mit Sonnenwandler Helaku.‡나라체 야영지에 있는 태양길잡이 헬라쿠와 대화해야 합니다.‡Habla con Helaku Caminasol en el campamento Narache.‡Habla con Helaku Caminasol en el campamento Narache.‡Allez parler au Marche-soleil Helaku, au Camp Narache.‡与纳拉其营地中的烈日行者赫拉库交谈。‡和納拉其營地的日行者希拉庫談談。',
  }
},
[27016] = {
  {
    'Nada como caçar javalis!‡Удовольствие от охоты на вепрей‡Die Freuden der Eberjagd‡재미있는 멧돼지 사냥‡La alegría de la caza del jabalí‡La alegría de la caza del jabalí‡Les joies saines de la chasse au sanglier‡猎野猪的乐趣‡獵豬之樂',
    nil,
    'Mate 10 Javalis Lodacentos.‡Убейте 10 грязнобрюхих вепрей.‡Tötet 10 Schlammbaucheber.‡진흙배멧돼지 10마리를 처치해야 합니다.‡Mata a 10 jabalíes Panzabarro.‡Mata a 10 jabalíes Panzabarro.‡Tuez 10 Sangliers ventreboueux.‡杀死10头泥腹野猪。‡殺死10隻泥腹野豬。',
  }
},
[27017] = {
  {
    'Memórias de um passado perdido‡Воспоминания о далеком прошлом‡Erinnerungen an längst vergangene Zeiten‡잃어버린 과거의 추억‡Recuerdos de un pasado perdido‡Recuerdos de un pasado perdido‡Les vestiges d’un passé oublié‡遥远的回忆‡來自失落過去的回憶',
    nil,
    'Viaje para a casa da fazenda na Aridez de Garrão e colete todas as lembranças que puder encontrar.‡Отправляйтесь к фермерскому дому на пустошь Гаррона и соберите памятные предметы, какие сумеете найти.‡Begebt Euch zum Hof in Gahrrons Trauerfeld und sammelt alle Erinnerungsstücke, die Ihr finden könnt.‡가론의 흉가에 있는 농가로 가서 추억을 떠올릴 수 있는 물건을 어떤 것이라도 찾아야 합니다.‡Viaja hasta la granja de la Gangrena de Gahrron y reúne todos los recuerdos que encuentres.‡Viaja hasta la granja de la Gangrena de Gahrron y reúne todos los recuerdos que encuentres.‡Allez jusqu’à la ferme, à la Flétrissure de Gahrron, et rassemblez tous les souvenirs que vous trouverez.‡前往盖罗恩农场的农舍，收集你能找到的纪念物。‡到蓋羅恩農場的農莊去，並拿取你找到的任何紀念品。',
  }
},
[27018] = {
  {
    'The Herald <NYI>‡Вестник‡Der Herold <NYI>‡사자‡El heraldo <NYI>‡El heraldo <NYI>‡Le héraut <NYI>‡The Herald <NYI>‡傳令官<NYI>',
    nil,
    nil,
  }
},
[27019] = {
  {
    'Flagelo do Urzal‡Плеть и Курганы‡Geißel der Hügel‡가시덩굴 구릉의 스컬지‡La plaga de la Zahúrda‡La plaga de la Zahúrda‡Le Fléau des Souilles‡高地的天灾‡剃刀高地的天譴軍團',
    nil,
    'Caso aceite ajudar Belnistrasz, fale com ele de novo e devolva a Pedra do Juramento.‡Если вы решите помочь Белнистразу, поговорите с ним еще раз и верните ему Камень клятвы.‡Wenn Ihr Belnistrasz helfen wollt, sprecht noch einmal mit ihm und übergebt ihm den Schwurstein, den er Euch gab.‡그가 당신에게 서약의 돌을 줄 것입니다. 벨리스트라즈의 계획을 돕는 것에 동의하면 다시 그와 대화하여 그에게 서약의 돌을 돌려줘야 합니다‡Si decides ayudar a Belnistrasz, habla con él otra vez y devuélvele la piedra de juramento.‡Si decides ayudar a Belnistrasz, habla con él otra vez y devuélvele la piedra de juramento.‡Pour aider Belnistrasz, lui parler de nouveau et lui rendre la Pierre de voeu qu’il vous avait donnée.‡如果你同意协助奔尼斯特拉兹，就再跟他谈谈，把他给你的誓言石还给他。‡要是你願意幫助貝尼斯塔茲，再次跟他交談，並將他所交給你的誓言石還給他。',
  }
},
[27020] = {
  {
    'A primeira lição‡Первый урок‡Die erste Lektion‡첫 번째 훈련‡La primera lección‡La primera lección‡La première leçon‡第一课‡第一堂課',
    nil,
    'Aprenda a técnica Investida com Harutt Chifre Troante. Encontre um Boneco de Treinamento na Aldeia Narache e treine o uso da Investida.‡Научитесь "Рывку" у Харутта Громового Рога. Найдите тренировочный манекен в Лагере Нараче и потренируйтесь в "Рывке".‡Lernt von Harutt Donnerhorn \'Sturmangriff\'. Findet eine Trainingsattrappe in Camp Narache und übt \'Sturmangriff\'.‡하루트 썬더혼에게 돌진을 배워야 합니다. 그 후 나라체 야영지에 있는 훈련용 허수아비를 찾아 돌진을 사용해야 합니다.‡Aprende Cargar de Harutt Tronacuerno. Busca un muñeco de entrenamiento en el campamento Narache y practica Cargar.‡Aprende Cargar de Harutt Tronacuerno. Busca un muñeco de entrenamiento en el campamento Narache y practica Cargar.‡Apprenez la Charge auprès de Harutt Corne-tonnerre. Ensuite, trouvez un Mannequin d\'entraînement dans le Camp Narache et exercez-vous à la Charge.‡向哈鲁特·雷角学习冲锋。然后在纳拉其营地里找一个训练假人，对它使用冲锋。‡向哈魯特‧雷角學習衝鋒。在納拉其營地中找一具訓練假人練習衝鋒。',
  }
},
[27021] = {
  {
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡L’assurance de bien tirer‡猎人之路‡獵人之道',
    nil,
    'Aprenda o Tiro Firme com Lanka Tiro Distante. Encontre um Boneco de Treinamento na Aldeia Narache e treine o Tiro Firme 5 vezes.‡Обучитесь "Верному выстрелу" у Ланко Дальнего Выстрела. Найдите тренировочный манекен в Лагере Нараче и 5 раз испытайте на нем "Верный выстрел".‡Lernt von Lanka Weitschuss \'Zuverlässiger Schuss\'. Findet eine Trainingsattrappe in Camp Narache und übt \'Zuverlässiger Schuss\' 5 Mal.‡랑카 파샷에게 고정 사격을 배워야 합니다. 그 후 나라체 야영지에 있는 훈련용 허수아비를 찾아 고정 사격을 5회 사용해야 합니다.‡Aprende Disparo firme de Lanka Tirolejano. Busca un muñeco de entrenamiento en el Campamento Narache y practica Disparo firme 5 veces.‡Aprende Disparo firme de Lanka Tirolejano. Busca un muñeco de entrenamiento en el Campamento Narache y practica Disparo firme 5 veces.‡Apprenez le Tir assuré auprès de Lanka Vise-loin. Ensuite, trouvez un Mannequin d\'entraînement dans le Camp Narache et exercez-vous 5 fois au Tir assuré.‡向兰卡·远箭学习稳固射击。然后在纳拉其营地里找一个训练假人，练习5次稳固射击。‡向蘭卡‧遠箭學習穩固射擊。在納拉其營地中找一具訓練假人，用它來練習穩固射擊5次。',
  }
},
[27022] = {
  {
    'O ídolo nefando‡Уничтожить идол‡Ausschalten des Götzen‡우상 진화‡Extinguir el ídolo‡Extinguir el ídolo‡L\'extinction de l\'idole‡熄灭神像‡封印塑像',
    nil,
    'Proteja Belnistrasz.‡Защитите Белнистраза.‡Beschützt Belnistrasz.‡벨리스트라즈를 보호해야 합니다.‡Protege a Belnistrasz.‡Protege a Belnistrasz.‡Protégez Belnistrasz.‡保护奔尼斯特拉兹。‡保護貝尼斯塔茲。',
  }
},
[27023] = {
  {
    'Os caminhos dos andarilhos do sol‡Путь служителей солнца‡Der Weg des Sonnenwandlers‡태양길잡이의 길‡El camino de los caminasol‡El camino de los caminasol‡L’art des marche-soleil‡烈日行者之路‡日行者之道',
    nil,
    'Aprenda o Selo da Retidão e o Julgamento com o Andarilho do Sol Helakar. Encontre um Boneco de Treinamento na Aldeia Narache e treine o uso do Julgamento.‡Обучитесь заклинаниям "Печать праведности" и "Правосудие" у служителя солнца Хелаку. Найдите тренировочный манекен в Лагере Нараче и потренируйте на нем "Правосудие".‡Lernt Siegel der Rechtschaffenheit und Richturteil von Sonnenwandler Helaku. Findet eine Trainingsattrappe in Camp Narache und übt die Anwendung von \'Richturteil\'.‡태양길잡이 헬라쿠에게 정의의 문장과 심판 능력을 배워야 합니다. 그 후 나라체 야영지에 있는 훈련용 허수아비를 찾아 심판을 사용해야 합니다.‡Aprende Sello de Rectitud y Sentencia de Helaku Caminasol. Busca un muñeco de entrenamiento en el Campamento Narache y practica Sentencia.‡Aprende Sello de Rectitud y Sentencia de Helaku Caminasol. Busca un muñeco de entrenamiento en el Campamento Narache y practica Sentencia.‡Apprenez le Sceau de piété et Jugement auprès du Marche-soleil Helaku. Ensuite, trouvez un Mannequin d\'entraînement dans le Camp Narache et exercez-vous à lancer Jugement.‡向烈日行者赫拉库学习审判和正义圣印。然后在纳拉其营地里找一个训练假人，对它使用审判。‡向日行者希拉庫學習正義聖印與審判。在納拉其營地中找一具訓練假人練習審判。',
  }
},
[27024] = {
  {
    'Suspeitos de um crime perfeito‡Соучастники‡Komplizen‡범죄의 동반자‡Cómplices‡Cómplices‡Association de malfaiteurs‡罪恶搭档‡共犯',
    nil,
    'Mate Glutão, Mordresh Olho-de-Fogo e Tutan\'kash.‡Убейте Обжору, Мордреша Огненного Глаза и Тутен\'каша.‡Tötet, Nimmersatt, Mordresh Feuerauge und Tuten\'kash.‡게걸먹보, 불꽃눈 모드레쉬, 투텐카쉬를 처치해야 합니다.‡Mata a Glotón, Mordresh Ojo de Fuego y Tuten\'kash.‡Mata a Glotón, Mordresh Ojo de Fuego y Tuten\'kash.‡Tuez Glouton, Mordresh Œil-de-feu et Tuten\'kash.‡杀掉暴食者、火眼莫德雷斯，以及图特卡什。‡殺死暴食者、火眼莫德雷斯以及圖特卡什。',
  }
},
[27025] = {
  {
    'Perigo na mata‡Колючая работа‡Disteln im Dickicht‡걸을 때 따끔!‡Un cardo, dos cardos, tres cardos...‡Un cardo, dos cardos, tres cardos...‡Siffler en échardonnant‡处理刺蓟‡工作的時候刺兩下',
    nil,
    'Pegue 6 Sementes de Espetocardo.‡Соберите 6 семян колкополоха.‡Sammelt 6 Dolchdistelsamen.‡따끔엉겅퀴 씨앗 6개를 수집해야 합니다.‡Reúne 6 semillas de cardopuñal.‡Reúne 6 semillas de cardopuñal.‡Récoltez 6 Graines de pique-chardon.‡采摘6颗刺蓟之种。‡收集6顆刺薊種子。',
  }
},
[27026] = {
  {
    'Alerta vermelho: lince‡Повышенная боевая готовность: рыси‡Alarmstufe: Rotluchs‡경계 태세: 붉은스라소니‡Alerta: Gato montés‡Alerta: Gato montés‡Niveau d\'alerte : code lynx‡戒备：山猫‡防務戒備:山貓',
    nil,
    'Mate 8 Linces.‡Убейте 8 рысей.‡Tötet 8 Rotluchse.‡붉은스라소니 8마리를 처치해야 합니다.‡Mata a 8 gatos monteses.‡Mata a 8 gatos monteses.‡Tuez 8 Lynx roux.‡杀死8头山猫。‡殺死8隻山貓。',
  }
},
[27027] = {
  {
    'Golpe primevo‡Стихийный удар‡Urtümlicher Schlag‡원시의 일격‡Golpe primigenio‡Golpe primigenio‡La frappe primordiale‡根源打击‡原始之擊',
    nil,
    'Aprenda o Golpe Primevo com Meela Anda com a Aurora. Encontre um Boneco de Treinamento na Aldeia Narache e execute o Golpe Primevo 3 vezes.‡Обучитесь "Стихийному удару" у Милы Рассветной Странницы. Найдите тренировочный манекен в Лагере Нараче и отработайте "Стихийный удар" 3 раза.‡Lernt von Meela Morgenwandler \'Urtümlicher Schlag\'. Findet eine Trainingsattrappe in Camp Narache und übt \'Urtümlicher Schlag\' 3 Mal.‡밀라 돈스트라이더에게 원시의 일격을 배워야 합니다. 그 후 나라체 야영지에 있는 훈련용 허수아비를 찾아 원시의 일격을 3회 사용해야 합니다.‡Aprende Golpe primigenio de Meela Caminalba. Busca un muñeco de entrenamiento en el campamento Narache y practica Golpe primigenio 3 veces.‡Aprende Golpe primigenio de Meela Caminalba. Busca un muñeco de entrenamiento en el campamento Narache y practica Golpe primigenio 3 veces.‡Apprenez la Frappe primordiale auprès de Meela Aube-glorieuse. Ensuite, trouvez un Mannequin d\'entraînement dans le Camp Narache et exercez-vous 3 fois à la Frappe primordiale.‡向米拉·晨行者学习根源打击。然后在纳拉其营地里找一个训练假人，对它使用3次根源打击。‡向米拉‧晨行者學習原始之擊。在納拉其營地中找一具訓練假人，用它來練習原始之擊3次。',
  }
},
[27028] = {
  {
    'Caça às vespas‡Охота на ос‡Hornissenjagd‡말벌 사냥‡La caza del avispón‡La caza del avispón‡Chasse au frelon des marais‡捕猎黄蜂‡狩獵黃蜂',
    nil,
    'Pegue 6 Asas Vítreas de Vespa.‡Добудьте 6 прозрачных крыльев болотной осы.‡Erbeutet 6 glasige Hornissenflügel.‡반지르르한 말벌 날개 6개를 수집해야 합니다.‡Reúne 6 alas de avispón vidriosas.‡Reúne 6 alas de avispón vidriosas.‡Obtenez 6 Ailes vitreuses de frelon.‡收集6扇透明的蜂翅。‡收集6對透明的黃蜂翅膀。',
  }
},
[27029] = {
  {
    'Cura para o Flagelo‡Лекарство от Плети‡Die Geißel heilen‡스컬지 치료‡Curar la Plaga‡Curar la Plaga‡Un remède au Fléau‡治疗天灾‡阻止天譴軍團的轉化',
    nil,
    'Consiga 20 Presas Definhadas.‡Соберите 20 тусклых клыков.‡Besorgt 20 verwitterte Hauer.‡말라붙은 엄니 20개를 모아야 합니다.‡Reúne 20 colmillos secos.‡Reúne 20 colmillos secos.‡Collectez 20 Défenses flétries.‡收集20根枯缩的獠牙。‡收集20個枯槁的獸牙。',
  }
},
[27030] = {
  {
    'Rabos de raposa aos montes!‡Связка лисьих хвостов‡Eine Handvoll Fuchsschwänze‡여우 꼬리 수집‡Puñados de colas de zorro‡Puñados de colas de zorro‡Des queues de renard par brassées‡毛茸茸的狐狸尾巴‡一把狐狸尾',
    nil,
    'Pegue 7 Rabos de Raposa Fofos.‡Добудьте 7 пушистых лисьих хвостов.‡Erbeutet 7 flauschige Fuchsschwänze.‡복슬복슬한 여우 꼬리 7개를 수집해야 합니다.‡Reúne 7 colas de zorro fofas.‡Reúne 7 colas de zorro fofas.‡Obtenez 7 Queues de renard duveteuses.‡采集7条毛茸茸的狐狸尾巴。‡收集7條蓬鬆的狐狸尾巴。',
  }
},
[27031] = {
  {
    'O aerolouco‡Основа крыла‡Verrückt nach Flügeln‡날개 달린 도토리‡Loco por las alas‡Loco por las alas‡Le fou du ciel‡飞行呆子‡翅膀狂',
    nil,
    'Pegue 3 Penas Voadoras Impolutas de Águias Douradas.‡Соберите 3 безупречных маховых пера золотистого орла.‡Besorgt 3 makellose Flugfedern von Goldadlern.‡황금독수리로부터 온전한 비행 깃털 3개를 수집해야 합니다.‡Reúne 3 plumas de vuelo prístinas de águilas doradas.‡Reúne 3 plumas de vuelo prístinas de águilas doradas.‡Prélevez 3 Plumes de vol en parfait état sur des Aigles dorés.‡从金色雄鹰身上收集3根原始翼羽。‡從金色雄鷹身上收集3根原始飛羽。',
  }
},
[27032] = {
  {
    'Ave, aves!‡Птичий переполох‡Ein schräger Vogel‡하늘을 나는 기계타조‡La clave está en el pájaro‡La clave está en el pájaro‡L\'enfant et l\'oiseau‡重要的鸟‡鳥就對了',
    nil,
    'Encontre o Navestruz Enferrujado na Caverna Asaférrea.‡Найдите ржавого небесного долгонога в пещере Стального Крыла.‡Findet den verrosteten Himmelsschreiter in der Eisenschwingenhöhle.‡무쇠날개 동굴 안에서 녹슨 하늘타조를 찾아야 합니다.‡Encuentra el zancudo volador herrumbroso en el interior de la Caverna de Alahierro.‡Encuentra el zancudo volador herrumbroso en el interior de la Caverna de Alahierro.‡Trouvez le Trotte-ciel rouillé dans la Grotte Aile-de-fer.‡在铁翼洞穴里找到生锈的天行者。‡在鐵翼洞穴找出生鏽的機械空行鳥。',
  }
},
[27033] = {
  {
    'Coração de navestruz‡Сердце небесного долгонога‡Herz der Himmelsstreiter‡하늘타조의 마음‡El corazón del zancudo volador‡El corazón del zancudo volador‡Le cœur du trotte-ciel‡天行者之心‡機械空行鳥之心',
    nil,
    'Devolva o Mecanismo Robótico Supermecânico para Gomez Plosivo no Pavilhão dos Andarilhos.‡Отнесите супермеханический управляющий модуль Бинглзу Подрывайстеру в Приют Странников.‡Bringt Bingles Blastenheimer in der Jagdhütte der Weltenwanderer das supermechanische Robodings.‡고기능 로봇 부품을 원정순찰대 오두막에 있는 빙글스 블라스텐하이머에게 가져가야 합니다.‡Devuelve el robotrasto supermecánico a Bingles Pimpampum en la Cabaña del Errante.‡Devuelve el robotrasto supermecánico a Bingles Pimpampum en la Cabaña de los Errantes.‡Rapportez le Robo-rouage supermécanique à Bingles Explonheimer, au Pavillon des Pérégrins.‡把超级机械传送装置还给旅行者营地的宾格斯·雷管。‡把超級機械零件帶回遠行者小屋給賓格斯·布萊頓海默。',
  }
},
[27034] = {
  {
    'Aborrescência‡Переходный возраст‡Er ist in dem Alter‡아들의 사춘기‡Está en esa edad‡Está en esa edad‡L’âge ingrat‡他那个年纪‡他正值這年紀',
    nil,
    'Fale com Teles Plosivo na margem leste do Loch.‡Поговорите с Андо Подрывайстером на восточном берегу озера Лок.‡Sprecht mit Ando Blastenheimer auf der Ostseite des Loch.‡모단 호수 동쪽 지역에 있는 안도 블라스텐하이머와 대화해야 합니다.‡Habla con Ando Pimpampum en la zona este de Loch Modan.‡Habla con Ando Pimpampum en la zona este de Loch Modan.‡Parlez à Ando Explonheimer sur la rive est du Loch.‡跟洛克湖东侧的安多·雷管谈一谈。‡到洛克湖的東岸與安多·布萊頓海默談話。',
  }
},
[27035] = {
  {
    'O revoltado‡Выстоять‡Stellung beziehen‡황혼의 망치단의 유물‡Resistir‡Resistir‡Monter au créneau‡站出来‡起身對抗',
    nil,
    'Destrua o Moldaterra Crepuscular no meio do acampamento do Martelo do Crepúsculo.‡Уничтожьте сумеречный ваятель земли в центре лагеря Сумеречного Молота.‡Zerstört den Zwielichtumweltgestalter in der Mitte des Schattenhammerlagers.‡황혼의 망치단 야영지에 있는 황혼의 대지조작기를 파괴해야 합니다.‡Destruye el Moldeatierra Crepuscular en el centro del campamento del Martillo Crepuscular.‡Destruye el Moldeatierra Crepuscular en el centro del campamento del Martillo Crepuscular.‡Détruisez le Forme-terre du Crépuscule, au milieu du Camp du Marteau du crépuscule.‡摧毁暮光之锤营地中央的暮光塑地者。‡消滅暮光之錘的營地中心的暮光塑土者。',
  }
},
[27036] = {
  {
    'A vingança de Vyrin‡Месть Вайрины‡Vyrins Rache‡바이린의 복수‡La venganza de Vyrin‡La venganza de Vyrin‡La vengeance de Vyrin‡维林的报复‡維林的報復',
    nil,
    'Mate o Velho Fumaça e traga a cabeça dele.‡Убейте старого Черношкура и добудьте его голову.‡Tötet alte Rußtatze und bringt seinen Kopf an Euch.‡큰곰 숯검댕이를 처치하고 머리를 획득해야 합니다.‡Mata al viejo Tiznado y consigue su cabeza.‡Mata al viejo Tiznado y consigue su cabeza.‡Tuez le Vieux Noiraud et récupérez sa tête.‡杀死老黑炭，拿到它的熊头。‡殺掉奧爾蘇迪並取得牠的頭。',
  }
},
[27037] = {
  {
    'A vingança de Vyrin‡Месть Вайрины‡Vyrins Rache‡바이린의 복수‡La venganza de Vyrin‡La venganza de Vyrin‡La vengeance de Vyrin‡维林的报复‡維林的報復',
    nil,
    'Entregue a Cabeça do Velho Fumaça para Vyrin Velozvento no Pavilhão dos Andarilhos.‡Принесите голову Старины Черношкура Вайрине Быстрый Ветер в Приют Охотников.‡Bringt den Kopf der alten Rußtatzes zu Vyrin Flinkwind in die Jagdhütte der Weltenwanderer.‡큰곰 숯검댕이의 머리를 원정순찰대 오두막에 있는 바이린 스위프트윈드에게 가져가야 합니다.‡Lleva la cabeza del viejo Tiznado a Vyrin Vientoveloz en la Cabaña del Errante.‡Lleva la cabeza del viejo Tiznado a Vyrin Vientoveloz en la Cabaña de los Errantes.‡Apportez la Tête du Vieux Noiraud à Vyrin Vent-vif au Pavillon des Pérégrins.‡将老黑炭的头带给旅行者营地的维林·疾风。‡把奧爾蘇迪的頭帶去遠行者小屋給維林·疾風。',
  }
},
[27038] = {
  {
    'Peças perdidas‡Недостающие детали‡Fehlende Teile‡잃어버린 부품‡Piezas que faltan‡Piezas que faltan‡Les pièces manquantes‡遗失的零件‡散失的零件',
    nil,
    'Recolha 5 Peças Perdidas nas redondezas do Porto de Ventobravo.‡Найдите 5 недостающих деталей в окрестностях порта Штормграда.‡Hebt 5 fehlende Teile im Hafen von Sturmwind auf.‡스톰윈드 항구에서 잃어버린 부품 5개를 모아야 합니다.‡Reúne 5 piezas que faltan, busca alrededor del Puerto de Ventormenta.‡Reúne 5 piezas que faltan, busca alrededor del Puerto de Ventormenta.‡Récupérez 5 Pièces manquantes dans le Port de Hurlevent.‡从暴风城港口收集5个遗失的零件。‡在暴風港附近收集5件散失的零件。',
  }
},
[27039] = {
  {
    'Intenções perigosas‡Опасные намерения‡Unter Feinden‡위험한 계획‡Intenciones peligrosas‡Intenciones peligrosas‡Il faut sauver le soldat Yorick‡危险的意图‡危險的意圖',
    nil,
    'Encontre a Sicária Rane Yorick na Plantação do Ivar, que fica na Floresta de Pinhaprata.‡Разыщите стража смерти Йорик в Делянке Ивара в Серебряном бору.‡Findet Todespirscherin Yorick auf dem Ivarfeld im Silberwald.‡은빛소나무 숲의 이바르 호박밭에서 죽음추적자 요릭을 찾아야 합니다.‡Encuentra a la mortacechadora Yorick en Los Dominios de Ivar en el Bosque de Argénteos.‡Encuentra a la Mortacechadora Yorick en Los Dominios de Ivar, en el Bosque de Argénteos. ‡Trouvez la Nécrotraqueuse Yorick au Lopin d’Ivar, dans la Forêt des Pins-Argentés.‡去找银松森林伊瓦南瓜田的死亡猎手尤瑞克。‡到銀松森林的伊瓦農場去找亡靈哨兵尤瑞克。',
  }
},
[27040] = {
  {
    'Decodificação para idiotas‡Простая дешифровка‡Entschlüsselung leichtgemacht‡참 쉬운 해독‡El desencriptado nunca fue tan fácil‡El desencriptado nunca fue tan fácil‡Le décryptage pour les nuls‡轻松解密‡簡單解譯法',
    nil,
    'Decodifique 6 planos.‡Расшифруйте 6 планов.‡Entschlüsselt 6 Pläne.‡계획서 6장을 해독해야 합니다.‡Descifra 6 planes.‡Descifra 6 planes.‡Décryptez 6 plans.‡解密6份计划书。‡解譯6份計畫。',
  }
},
[27041] = {
  {
    'Decodificação para idiotas‡Простая дешифровка‡Entschlüsselung leichtgemacht‡참 쉬운 해독‡El desencriptado nunca fue tan fácil‡El desencriptado nunca fue tan fácil‡Le décryptage pour les nuls‡轻松解密‡簡單解譯法',
    nil,
    'Decifre 6 planos.‡Расшифруйте 6 планов.‡Entschlüsselt 6 Pläne.‡계획서 6장을 해독해야 합니다.‡Descifra 6 planes.‡Descifra 6 planes.‡Décryptez 6 plans.‡解密6份计划书。‡解譯6份計畫。',
  }
},
[27042] = {
  {
    'Combata fogo, água e ar com...‡Победить огонь, воду и воздух при помощи…‡Mächte des Feuers, des Wassers und der Luft‡불과 물과 바람을 피하는 법‡Enfréntate al fuego, al agua y al aire con...‡Enfréntate al fuego, al agua y al aire con...‡Combattre le feu, l’eau et l’air par…‡要对付火和水和空气的话……‡制火水風以...',
    nil,
    'Obtenha as Proteções do Fogo, da Água e do Ar. Em seguida, mate Haethen Kaul.‡Получите обереги огня, воды и воздуха, а затем убейте Хазена Каула.‡Erhaltet den Feuerzauberschutz, Wasserzauberschutz und Windzauberschutz und tötet dann Haethen Kaul.‡불, 물, 바람의 수호물을 획득한 다음, 해든 카울을 처치해야 합니다.‡Consigue los Resguardos contra el Fuego, Agua y Aire; y después mata a Haethen Kaul.‡Consigue los Resguardos contra el Fuego, Agua y Aire; y después mata a Haethen Kaul.‡Récupérez les Gardiens de feu, d’eau et d’air, puis tuez Haethen Kaul.‡获得火、水及空气结界，然后杀死哈辛·考尔。‡取得火、水、風元素的防護結界，然後殺死海森‧考爾。',
  }
},
[27043] = {
  {
    'Combata fogo, água e ar com...‡Победить огонь, воду и воздух при помощи…‡Mächte des Feuers, des Wassers und der Luft‡불과 물과 바람을 피하는 법‡Enfréntate al fuego, al agua y al aire con...‡Enfréntate al fuego, al agua y al aire con...‡Combattre le feu, l’eau et l’air par…‡要对付火和水和空气的话……‡制火水風以...',
    nil,
    'Obtenha as Proteções do Fogo, da Água e do Ar. Em seguida, mate Haethen Kaul.‡Получите обереги огня, воды и воздуха, а затем убейте Хазена Каула.‡Erhaltet den Feuerzauberschutz, Wasserzauberschutz und Windzauberschutz und tötet dann Haethen Kaul.‡불, 물, 바람의 수호물을 획득한 다음, 해든 카울을 처치해야 합니다.‡Consigue los Resguardos contra el Fuego, Agua y Aire; y después mata a Haethen Kaul.‡Consigue los Resguardos contra el Fuego, Agua y Aire; y después mata a Haethen Kaul.‡Récupérez les Gardiens de feu, d’eau et d’air, puis tuez Haethen Kaul.‡获得火、水及空气结界，然后杀死哈辛·考尔。‡取得火、水、風元素的防護結界，然後殺死海森‧考爾。',
  }
},
[27044] = {
  {
    'A questão dos camponeses‡Крестьянские заботы‡Die Sorgen der Bauern‡농부의 문제‡Problemas de los campesinos‡Problemas de los campesinos‡Problèmes paysans‡农民问题‡農夫問題',
    nil,
    'Escolte o Príncipe Anduin até o Fazendeiro Wollerton no Sítio dos Wollerton, que fica em Ventobravo. Se ele não estiver mais com você, poderá encontrá-lo na Bastilha Ventobravo.‡Проводите принца Андуина к фермеру Уоллертону, который находится в Штормграде, на ферме Уоллертона. Если вы потеряете принца, то сможете найти его в крепости Штормграда.‡Begleitet Prinz Anduin zu Bauer Wollerton auf Wollertons Bauernhof in Sturmwind. Wenn er nicht mehr an Eurer Seite ist, findet Ihr ihn in Burg Sturmwind.‡안두인 린 왕자를 호위해 스톰윈드의 월러튼 농장에 있는 농부 월러튼에게 가야 합니다. 왕자와 떨어지면 스톰윈드 왕궁에서 그를 다시 만날 수 있습니다.‡Escolta al príncipe Anduin a ver al granjero Wollerton en La Finca de Wollerton dentro de la Ciudad de Ventormenta. Si ya no está contigo, podrás encontrarlo en el Castillo de Ventormenta.‡Escolta al príncipe Anduin a ver al granjero Wollerton en La Finca de Wollerton dentro de la Ciudad de Ventormenta. Si ya no está contigo, podrás encontrarlo en el Castillo de Ventormenta.‡Escortez le Prince Anduin jusqu\'au Fermier Wollerton, à la Ferme des Wollerton, dans la Cité de Hurlevent. S\'il n\'est plus avec vous, vous pourrez le retrouver au Donjon de Hurlevent.‡护送安度因王子去找暴风城沃勒顿农场的沃勒顿。假如你同他走散了，可以在暴风城王座找到他。‡護送安杜因王子到暴風城裡的沃勒頓農場找到農夫沃勒頓。如果他不在你身邊，你可以在暴風要塞找到他。',
  }
},
[27045] = {
  {
    'Sangria desatada‡В ожидании кровопускания‡Lauschangriff‡흩뿌려진 암살자의 피‡Esperando para desangrar‡Esperando para desangrar‡En attendant d’être exsangue‡等着下手‡等待除血',
    nil,
    'Entre no Chalé dos Ivar e encontre um esconderijo adequado no segundo andar. Escute a conversa do lorde Darius Crowley.‡Проникните в дом Ивара и найдите подходящее местечко наверху, чтобы спрятаться. Затем подслушайте, что будет говорить лорд Дарий Краули.‡Betretet das Landhaus auf dem Ivarfeld und sucht oben nach einem geeigneten Versteck. Belauscht dann Lord Darius Crowley.‡이바르의 오두막 2층에서 적당한 은신처를 찾고, 다리우스 크롤리 경의 말을 엿들어야 합니다.‡Entra a la Cabaña de Ivar y encuentra un escondite apropiado en el piso de arriba. Después, escucha a escondidas a Lord Darius Crowley.‡Entra a la Cabaña de Ivar y encuentra un escondite apropiado en el piso de arriba. Después, escucha a escondidas a Lord Darius Crowley.‡Pénétrez dans le Cottage d’Ivar et trouvez-vous une bonne cachette à l’étage ; ensuite, écoutez la conversation du Seigneur Darius Crowley.‡进入伊瓦小屋，在楼上找一个合适的藏身处。监听达利乌斯·克罗雷领主。‡進入伊瓦農場的農舍並在樓梯上找一個合適的躲藏點，竊聽達瑞亞斯·克羅雷領主的談話。',
  }
},
[27046] = {
  {
    'Medo de broca‡Червинтовая угроза‡Bohrende Angst‡벌레가 무서워요‡El temor a la perforación‡El temor a la perforación‡La peur de l’érosion‡找事来做‡對鑽孔的恐懼',
    nil,
    'Mate 10 Litovermes.‡Убейте 10 червинтов.‡Tötet 10 Schleifwürmer.‡소용돌이벌레 10마리를 처치해야 합니다.‡Mata a 10 gusaespirales.‡Mata a 10 gusaespirales.‡Tuez 10 Girevers.‡杀死10条旋岩虫。‡殺死10隻渦旋蟲。',
  }
},
[27047] = {
  {
    'Grânulos‡Пейнит‡Partikel‡티끌‡Motas‡Motas‡Les granules‡尘‡微粒',
    nil,
    'Colete 10 Grânulos de Dolorita.‡Соберите 10 кусочков пейнита.‡Holt 10 Painitpartikel.‡페이나이트 티끌 10개를 회수해야 합니다.‡Recoge 10 motas de painita.‡Recoge 10 motas de painita.‡Récupérez 10 Granules de dolorite.‡收集10份钙铝石微尘。‡取得10個鋁硼鋯鈣石微粒。',
  }
},
[27048] = {
  {
    'Economia subterrânea‡Подземная экономика‡Untergrundwirtschaft‡지하 경제‡Economía subterránea‡Economía subterránea‡Une économie souterraine‡地下经济‡地底經濟',
    nil,
    'Use as Bombas da Ricket para coletar 3 Alabastros das Profundezas, 3 Celestitas das Profundezas, 3 Ametistas das Profundezas e 3 Granadas das Profundezas.‡Воспользуйтесь бомбами Рикет, чтобы собрать 3 кристалла насыщенного алебастра, 3 кристалла насыщенного аметиста, 3 кристалла насыщенного целестина и 3 кристалла насыщенного граната.‡Benutzt Rickets Ticker, um 3 Tiefenalabasterkristalle, 3 Tiefencoelestinkristalle, 3 Tiefenamethystkristalle und 3 Tiefengranatkristalle zu sammeln.‡리켓의 똑딱탄을 사용하여 심층 설화석 수정 3개, 심층 천청석 수정 3개, 심층 자수정 수정 3개, 심층 석류석 수정 3개를 수집해야 합니다.‡Usa tictacs de Ricket para reunir 3 cristales de alabastro profundo, 3 cristales de celestina profunda, 3 cristales de amatista profunda y 3 cristales de granate profundo.‡Usa tictacs de Ricket para reunir 3 cristales de alabastro profundo, 3 cristales de celestina profunda, 3 cristales de amatista profunda y 3 cristales de granate profundo.‡Utilisez les Toquantes de Ricket pour récupérer 3 Cristaux d’albâtre, 3 Cristaux de célestite, 3 Cristaux d’améthyste, et 3 Cristaux de grenat.‡使用莉吉特的炸弹安放器收集3块深岩雪花石晶簇、3块深岩天青石晶簇和3块深岩血榴石晶簇。‡使用瑞基特的炸藥取得3片地深之源條紋大理石晶簇、3片地深之源天青石晶簇、3片地深之源紫水晶晶簇、3片地深之源石榴石晶簇。',
  }
},
[27049] = {
  {
    'Rocha mole‡Рыхлая порода‡Weicher Fels‡곰팡이 퇴치‡Roca suave‡Roca suave‡Tendre roche‡软岩‡軟岩石',
    nil,
    'Mate 8 Beemotes Fúngicos.‡Убейте 8 грибных чудищ.‡Tötet 8 Fungusungetüme.‡곰팡이 괴수 8마리를 처치해야 합니다.‡Mata a 8 behemoths fúngicos.‡Mata a 8 behemoths fúngicos.‡Tuez 8 Béhémoths fongiques.‡杀死8头真菌巨兽。‡殺死8隻真菌巨獸。',
  }
},
[27050] = {
  {
    'Fungos em fúria‡Грибная ярость‡Der Zorn der Pilze‡분노의 곰팡이‡Furia fúngica‡Furia fúngica‡Furie fongique‡真菌之怒‡真菌狂怒',
    nil,
    'Destrua 10 brotos de cogumelo na Vastidão Carmesim.‡Уничтожьте 10 выросших грибов в Багровом зале.‡Zerstört 10 der neu gesprossenen Pilze in der Rubinspanne.‡진홍 벌판에서 새로 싹튼 버섯 10개를 파괴해야 합니다.‡Destruye 10 nuevos brotes de champiñones en la Extensión Carmesí.‡Destruye 10 nuevos brotes de champiñones en la Extensión Carmesí.‡Détruisez 10 Champignons cramoisis naissants dans les Étendues Cramoisies.‡消灭10个萌芽的赤红蘑菇。‡摧毀10朵正在赤紅瀚洋生長的蕈菇。',
  }
},
[27051] = {
  {
    'Não vamos desistir!‡Настойчивость‡Beharrlichkeit zahlt sich aus‡인내심을 갖고‡Con perseverancia‡Con perseverancia‡Persistance‡坚持不懈‡堅毅不屈',
    nil,
    'Tome um Saco de Crescimento Miraculoso dos Verlok das mãos dos Verlok da Vastidão Carmesim.‡Отберите мешочек чудоросли у обитателей Верлока у Багрового зала.‡Nehmt einen Beutel mit Wunderwachstumsmittel von Verlok von den Verloks auf der Rubinspanne an Euch.‡진홍 벌판에 있는 베를로크로부터 베를로크 기적의 생장물 가방을 회수해야 합니다.‡Recupera una bolsa de brote milagroso de Verlok de los Verlok sobre la Extensión Carmesí.‡Recupera una bolsa de brote milagroso de Verlok de los Verlok sobre la Extensión Carmesí.‡Récupérez un Sac de croissance-miracle verlok sur les verloks dans les Étendues Cramoisies.‡去赤红岩床获取一包维罗克的神奇增长素。‡從赤紅瀚洋上的維洛克族那裡取得一袋維洛克神奇成長激素。',
  }
},
[27052] = {
  {
    '‡Последние из Сумеречного Молота‡Anhaltendes Zwielicht‡‡Crepúsculo persistente‡‡Les survivants du Crépuscule‡‡',
    nil,
    '‡Выследите сумеречного наездника на хрустальнокрылом каменном драконе.‡Bringt einen Zwielichtdrachenreiter zur Strecke während Ihr auf einem Steindrachen der Kristallschwingen reitet.‡‡Derriba a un jinete de dracos Crepuscular de su draco de piedra Alacristal.‡‡Traquez un Chevaucheur de drakes du Crépuscule sur un Drake de pierre de l\'aile cristalline.‡‡',
  }
},
[27053] = {
  {
    'Caldeirão da Aridez de Garrão‡Котел в пустоши Гаррона‡Der Kessel von Gahrrons Trauerfeld‡가론의 흉가 역병 가마솥‡La caldera de la Gangrena de Gahrron‡La caldera de la Gangrena de Gahrron‡Le chaudron de la Flétrissure de Gahrron‡盖罗恩农场之锅‡蓋羅恩農場的瘟疫之鍋',
    nil,
    'Vá para a Aridez de Garrão nas Terras Pestilentas Ocidentais para encontrar e derrotar o Mestre da Caldeira no local. Depois, use a chave dele para acessar o caldeirão.‡Отправляйтесь на пустошь Гаррона в Западных Чумных землях, сразитесь там с хранителем котла, отберите у него ключ и отоприте котел.‡Geht zu Gahrrons Trauerfeld in den Westlichen Pestländern. Findet und besiegt den dort anwesenden Kessellord und benutzt seinen Schlüssel, um Zugang zu dem Kessel zu erlangen.‡서부 역병지대의 가론의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 처치하고, 그가 가진 열쇠를 사용해 역병 가마솥에 접근해야 합니다.‡Ve a la Gangrena de Gahrron, en las Tierras de la Peste del Oeste, para localizar y derrotar al señor de la caldera que se encuentra allí y para usar su llave para acceder a la caldera.‡Ve a la Gangrena de Gahrron, en las Tierras de la Peste del Oeste, para localizar y derrotar al señor de la caldera que se encuentra allí y para usar su llave para acceder a la caldera.‡Allez à la Flétrissure de Gahrron dans les Maleterres de l’Ouest pour trouver et tuer le Seigneur du chaudron. Ensuite, utilisez sa clé pour accéder au chaudron.‡前往西瘟疫之地的盖罗恩农场，找到并击败护锅者，用它的钥匙打开大锅。‡到西瘟疫之地的蓋羅恩農場去，找出那邊的護鍋領主並擊敗他，並使用他的鑰匙打開瘟疫之鍋。',
  }
},
[27054] = {
  {
    'Ações desesperadas‡Акт отчаяния‡Verzweifelte Taten‡무모한 행위‡Medidas desesperadas‡Medidas desesperadas‡Des actes désespérés‡铤而走险‡絕望的行動',
    nil,
    'Mate a Instrutora Malícia e pegue as Ordens da Seita dela.‡Убейте инструктора Коварнессу и добудьте приказы Культа.‡Tötet Instrukteurin Malicia und nehmt ihre Befehle für den Kult an Euch.‡조교 말리시아를 처치하고 그녀가 가진 이교도 명령서를 획득해야 합니다.‡Mata a la instructora Malicia y consigue sus órdenes del culto.‡Mata a la instructora Malicia y consigue sus órdenes del culto.‡Tuez l’Instructrice Malicia et obtenez ses Ordres du Culte.‡杀死讲师玛丽希亚，缴获她的教派命令书。‡殺死講師瑪麗希亞並取得她的教團指令。',
  }
},
[27055] = {
  {
    'Alunos de Krastinov‡Студенты Крастинова‡Krastinovs Schüler‡테올렌 크라스티노브의 수련생들‡Alumnos de Krastinov‡Alumnos de Krastinov‡Les étudiants de Krastinov‡卡斯迪诺夫的学生们‡卡斯迪諾夫的學生',
    nil,
    'Mate 2 Discípulos Krastinovianos, 2 Brutos de Carne Retalhada, 2 Estripadores de Carne Retalhada e 4 Corpúsculos Profanos dentro da Caverna das Lágrimas, que fica nas Terras Pestilentas Ocidentais.‡Убейте 2 учеников Крастинова, 2 грубо сварганенных громил, 2 грубо сварганенных потрошителей и 4 нечестени в Гроте Слез в Западных Чумных землях.‡Tötet in der Weinenden Höhle, die in den Westlichen Pestländern liegt, 2 Schüler Krastinovs, 2 Schläger aus Formfleisch, 2 Reißer aus Formfleisch und 4 unheilige Körperchen.‡서부 역병지대의 진흙탕 동굴에서 크라스티노브 신봉자 2명, 누비살점 투사 2명, 그리고 누비살점 학살자 2명과 부정한 혈구 4명을 처치해야 합니다.‡Mata a 2 discípulos de krastinoviano, a 2 toscos Carneadoquín, a 2 desgarradores Carneadoquín y a 4 corpúsculos profanos en el interior de La Cueva del Llanto en las Tierras de la Peste del Oeste.‡Mata a 2 discípulos de krastinoviano, a 2 toscos Carneadoquín, a 2 desgarradores Carneadoquín y a 4 corpúsculos profanos en el interior de La Cueva del Llanto en las Tierras de la Peste del Oeste.‡Tuez 2 Disciples krastinoviens, 2 Brutes et 2 Éventreurs bidouille-chair et 4 Corpuscules impies dans la Grotte des Pleurs, dans les Maleterres de l’Ouest.‡在西瘟疫之地的哭泣之洞里消灭2名卡斯迪诺夫的学徒，2名血钉蛮兵，2名血钉撕裂者，以及4个邪恶凝血球。‡到西瘟疫之地的哭泣之洞去，殺死2個克拉斯汀諾維安信徒、2個屍傀蠻卒、2個屍傀撕裂者、以及4個邪惡微血球。',
  }
},
[27056] = {
  {
    'O relatório de Belmonte‡Доклад Бельмонта‡Belmonts Bericht‡벨몬트의 보고서‡El informe de Belmont‡El informe de Belmont‡Le rapport de Belmont‡贝尔蒙特的报告‡貝爾蒙特的報告',
    nil,
    'Entregue o Relatório de Belmonte para a Grande Dama Sylvana Correventos no Alto Comando dos Renegados, que fica na Floresta de Pinhaprata.‡Передайте доклад Бельмонта Сильване Ветрокрылой в Ставке Отрекшихся в Серебряном бору.‡Bringt Belmonts Bericht zu Fürstin Sylvanas Windläufer in der Kommandozentrale der Verlassenen im Silberwald.‡은빛소나무 숲의 포세이큰 고위 사령부에 있는 여군주 실바나스 윈드러너에게 벨몬트의 보고서를 전달해야 합니다.‡Lleva el informe de Belmont a Lady Sylvanas Brisaveloz en el Alto Mando Renegado en el Bosque de Argénteos.‡Lleva el informe de Belmont a Lady Sylvanas Brisaveloz en el Alto Mando Renegado en el Bosque de Argénteos.‡Remettez le rapport de Belmont à Dame Sylvanas Coursevent au Haut-commandement des Réprouvés, dans la Forêt des Pins-Argentés.‡把贝尔蒙特的报告交给银松森林被遗忘者统帅部的希尔瓦娜斯·风行者。‡到銀松森林的被遺忘者高階指揮所，將貝爾蒙特的報告交給希瓦娜斯·風行者女士。',
  }
},
[27057] = {
  {
    'Volte para o Acampamento‡Возвращение на площадку‡Rückkehr zum heimischen Hof‡치유사의 처소로 귀환‡Vuelve a la finca‡Vuelve a la finca‡Retour au bivouac‡返回农场‡返回崗哨',
    nil,
    'Leve a Garrafa Cheia da Aridez de Garrão para o Agente de Campo Kaartish no Acampamento dos Restauradores, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с пустоши Гаррона агенту ШРУ Каартишу на Участок Целителей Земли в Западных Чумных землях.‡Bringt die Gefüllte Flasche: Gahrrons Trauerfeld zu Außenagent Kaartish in der Stätte der Heiler in den Westlichen Pestländern.‡서부 역병지대의 치유사의 처소에 있는 현장 요원 카티쉬에게 가득 찬 가론의 흉가 혼합물을 가져가야 합니다.‡Lleva la botella llena de la Gangrena de Gahrron al agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Lleva la botella llena de la Gangrena de Gahrron al agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Apportez la Bouteille de la Flétrissure de Gahrron remplie à l’Agent de terrain Kaartish au Bivouac des Soigneurs, dans les Maleterres de l’Ouest.‡将盖罗恩农场的样本瓶带回给到西瘟疫之地治愈者营地的战地特工卡尔缇舍。‡把蓋羅恩農場的樣本瓶帶去西瘟疫之地的治癒者崗哨，交給戰場密探卡爾堤須。',
  }
},
[27058] = {
  {
    'Sequência errada‡Неверная последовательность‡Die falsche Folge‡다부숴 코드‡La secuencia errónea‡La secuencia errónea‡La mauvaise séquence‡错误的序列‡錯誤的程序',
    nil,
    'Use o Controle do Pórtico para inserir a sequência de ativação errada e destruir o Pórtico.‡Воспользуйтесь контроллером связующей спирали и введите неверную активирующую последовательность, которая разрушит связующую спираль.‡Benutzt den Torwächter, um die falsche Aktivierungsfolge einzugeben und so das Tor zu zerstören.‡차원문 제어기로 잘못된 활성화 코드를 입력하여, 차원문을 파괴해야 합니다.‡Usa el controlador de puerta para introducir una secuencia de activación errónea para, de esta forma, destruir la puerta.‡Usa el controlador de puerta para introducir una secuencia de activación errónea para, de esta forma, destruir la puerta.‡Utilisez le Contrôleur du portail d’accès pour composer la mauvaise séquence d’activation, ce qui détruira le portail d’accès.‡使用界门控制器输入错误的启动序列，从而摧毁界门。‡使用甬道控制器來輸入錯誤的啟動程序，藉此摧毀甬道之門。',
  }
},
[27059] = {
  {
    'Sequência errada‡Неверная последовательность‡Die falsche Folge‡다부숴 코드‡La secuencia errónea‡La secuencia errónea‡La mauvaise séquence‡错误的序列‡錯誤的程序',
    nil,
    'Use o Controle do Pórtico para inserir a sequência de ativação errada e destruir o Pórtico.‡Воспользуйтесь контроллером связующей спирали и введите неверную активирующую последовательность, которая разрушит связующую спираль.‡Benutzt den Torwächter, um die falsche Aktivierungsfolge einzugeben und so das Tor zu zerstören.‡차원문 제어기로 잘못된 활성화 코드를 입력하여, 차원문을 파괴해야 합니다.‡Usa el controlador de puerta para introducir una secuencia de activación errónea para, de esta forma, destruir la puerta.‡Usa el controlador de puerta para introducir una secuencia de activación errónea para, de esta forma, destruir la puerta.‡Utilisez le Contrôleur du portail d’accès pour composer la mauvaise séquence d’activation, ce qui détruira le portail d’accès.‡使用界门控制器输入错误的启动序列，从而摧毁界门。‡使用甬道控制器來輸入錯誤的啟動程序，藉此摧毀甬道之門。',
  }
},
[27060] = {
  {
    'Vaca profana‡Адская корова‡Unheilige Kuh‡부정한 소‡¡La madre del ternero!‡¡La madre del ternero!‡La vache !‡不洁之牛‡不潔之牛',
    nil,
    'Enquanto escolta Anduin Wrynn, siga o rastro de sangue que vai da Propriedade do Fazendeiro Wollerton até o local do crime. Proteja Anduin. Caso o perca de vista, ele estará esperando por você na Bastilha Ventobravo.‡Вместе с Андуином Ринном идите по жуткому следу, который тянется от фермы Уоллертона. Защищайте принца. Если вы потеряете принца, то сможете найти его в крепости Штормграда.‡Begleitet Anduin Wrynn und folgt der Blutspur von Wollertons Bauernhof zum Tatort. Haltet Anduin am Leben. Wenn er nicht mehr an Eurer Seite ist, findet Ihr ihn in Burg Sturmwind.‡안두인 린을 호위해 월러튼 농장에서부터 난 피범벅 흔적을 쫓아 범행 현장까지 가야 합니다. 안두인의 목숨을 보호하십시오. 왕자와 떨어지면 스톰윈드 왕궁에서 그를 다시 만날 수 있습니다.‡Mientras escoltas a Anduin Wrynn, sigue el rastro de sangre desde la finca del granjero Wollerton hasta la escena del crimen. Mantén a Anduin con vida. Si no está contigo, estará esperando en el Castillo de Ventormenta.‡Mientras escoltas a Anduin Wrynn, sigue el rastro de sangre desde la finca del granjero Wollerton hasta la escena del crimen. Mantén a Anduin con vida. Si no está contigo, estará esperando en el Castillo de Ventormenta.‡Sans cesser d\'escorter Anduin Wrynn, suivez la traînée de sang allant de la propriété du fermier Wollerton au lieu du crime. Gardez Anduin en vie. S\'il n\'est pas avec vous, vous le trouverez au Donjon de Hurlevent.‡护送安度因·乌瑞恩沿着血迹从沃勒顿的农场前往犯罪现场。确保安度因的安全。假如你同他走散了，可以在暴风城王座找到他。‡護送安杜因‧烏瑞恩，從農夫沃勒頓的農場開始順著血的痕跡追查到犯罪現場。保護安杜因的性命。如果他不和你在一起，就會在暴風要塞等你。',
  }
},
[27061] = {
  {
    'O Mirante do Crepúsculo‡Дозорный холм Сумеречного Молота‡Die Zwielichtwarte‡황혼 전망대‡El Mirador Crepuscular‡El Mirador Crepuscular‡Le surplomb du Crépuscule‡暮光瞭望台‡暮光瞰臺',
    nil,
    'Fale com a Tempestária Mylra no Mirante do Crepúsculo, que fica no Geodomo.‡Поговорите с буревестницей Милрой у дозорного холма Сумеречного Молота в Подземье.‡Sprecht mit Sturmruferin Mylra an der Zwielichtwarte in Tiefenheim.‡심원의 영지의 황혼 전망대에 있는 폭풍소환사 마일라와 대화해야 합니다.‡Habla con la clamatormentas Mylra en el Mirador Crepuscular en Infralar.‡Habla con la clamatormentas Mylra en el Mirador Crepuscular en Infralar.‡Allez voir l’Imploratrice Mylra au Surplomb du Crépuscule, dans le Tréfonds.‡跟深岩之洲暮光瞭望台的风暴召唤者米尔拉谈一谈。‡到地深之源的暮光瞰臺和風暴召喚者米爾拉談話。',
  }
},
[27062] = {
  {
    'Ameaça crescente‡Смутная угроза‡Lauernde Gefahr‡다가오는 위협‡Amenaza en ciernes‡Amenaza en ciernes‡L’imminente menace‡潜伏的威胁‡威脅的蜃景',
    nil,
    'Encontre ajuda no Urzal dos Mortos.‡Найдите помощь в курганах Иглошкурых.‡Findet Hilfe bei den Hügeln der Klingenhauer.‡가시덩굴 구릉에서 도움을 구해야 합니다.‡Busca ayuda en Zahúrda Rajacieno.‡Busca ayuda en Zahúrda Rajacieno.‡Trouvez de l’aide dans les Souilles de Tranchebauge.‡到剃刀高地去找帮手。‡在剃刀高地找到援助。',
  }
},
[27063] = {
  {
    'Ameaça crescente‡Смутная угроза‡Lauernde Gefahr‡다가오는 위협‡Amenaza en ciernes‡Amenaza en ciernes‡Une menace latente‡潜伏的威胁‡威脅的蜃景',
    nil,
    'Encontre ajuda no Urzal dos Mortos.‡Получите помощь в курганах Иглошкурых.‡Sucht im Hügel der Klingenhauer nach Hilfe.‡가시덩굴 구릉에서 도움을 구해야 합니다.‡Busca ayuda en Zahúrda Rajacieno.‡Busca ayuda en Zahúrda Rajacieno.‡Trouvez de l’aide dans les Souilles de Tranchebauge.‡到剃刀高地去找帮手。‡在剃刀高地找到援助。',
  }
},
[27064] = {
  {
    'Algo de podre no reino‡Он что-то скрывает‡Er hält uns hin‡그는 뭔가 숨기고 있다‡Nos está ocultando algo‡Nos está ocultando algo‡Il ne nous a pas tout dit‡他瞒着我们‡他對我們有所隱瞞',
    nil,
    'Escolte Anduin Wrynn até o terceiro andar do quartel-general da AVIN, no distrito Cidade Velha, em Ventobravo. Se você perder ele de vista, encontre-o na Bastilha Ventobravo.‡Вместе с Андуином Ринном отправляйтесь на третий этаж штаб-квартиры ШРУ, которая находится в Штормграде в Старом городе. Если вы потеряете принца, то сможете найти его в крепости Штормграда.‡Begleitet Anduin Wrynn in den dritten Stock des SI:7 Hauptquartiers in der Altstadt von Sturmwind. Wenn er nicht mehr an Eurer Seite ist, findet Ihr ihn in Burg Sturmwind.‡안두인 린을 호위해 스톰윈드 구 시가지에 있는 SI:7 본부 3층으로 가야 합니다. 왕자와 떨어지면 스톰윈드 왕궁에서 그를 다시 만날 수 있습니다.‡Escolta a Anduin Wrynn al tercer piso del puesto de mando del IV:7 en distrito del Casco Antiguo de Ventormenta. Si ya no está contigo, podrás encontrar a Anduin en el Castillo de Ventormenta.‡Escolta a Anduin Wrynn al tercer piso del puesto de mando del IV:7 en distrito del Casco Antiguo de Ventormenta. Si ya no está contigo, podrás encontrar a Anduin en el Castillo de Ventormenta.‡Escortez Anduin Wrynn jusqu\'au deuxième étage du QG du SI:7, dans la Vieille ville de Hurlevent. S\'il n\'est plus avec vous, vous le trouverez au Donjon de Hurlevent.‡护送安度因·乌瑞恩前往暴风城旧城区军情七处总部三楼。假如你同他走散了，可以在暴风城王座找到他。‡保護安杜因王子到暴風城舊城區的軍情七處總部三樓。如果他不在你身邊，可以在暴風要塞找到安杜因。',
  }
},
[27065] = {
  {
    'A esquadra do Chefe Guerreiro‡Флот вождя‡Die Flotte des Kriegshäuptlings‡대족장의 함대‡La flota del Jefe de Guerra‡La flota del Jefe de Guerra‡Toute une flotte dans une bouteille‡酋长的舰队‡大酋長的艦隊',
    nil,
    'Apresente-se à Almirante Machadinha na Retaguarda dos Renegados, que fica na Floresta de Pinhaprata.‡Поговорите с адмиралом Хетчетом в Арьергарде Отрекшихся в Серебряном бору.‡Meldet Euch bei Admiral Hatchet bei der Rückendeckung der Verlassenen im Silberwald.‡은빛소나무 숲의 포세이큰 후방 경비소에 있는 제독 해칫에게 보고해야 합니다.‡Preséntate ante el almirante Hatchet en el Puesto de Retaguardia Renegado en el Bosque de Argénteos.‡Preséntate ante el almirante Hatchet en el Puesto de Retaguardia Renegado en el Bosque de Argénteos.‡Présentez-vous à l’Amiral Laserpe à l’Arrière-garde des Réprouvés, dans la Forêt des Pins-Argentés.‡去找银松森林被遗忘者后卫军的战斧上将。‡到銀松森林的被遺忘者後衛部隊向戰斧上將回報。',
  }
},
[27066] = {
  {
    'Cura rápida‡Мгновенное исцеление‡Blitzartig heilen‡치유의 섬광‡Curación a la velocidad del rayo‡Curación a la velocidad del rayo‡Soigner rapidement‡快速治疗‡快速治療',
    nil,
    'Aprenda a Cura Célere com a Vidente Pena do Corvo. Pratique usando a Cura Célere 5 vezes nos Valentes Feridos na Aldeia Narache.‡Изучите заклинание "Быстрое исцеление" у провидицы Воронье Перо. С помощью "Быстрого исцеления" вылечите 5 раненых храбрецов в Лагере Нараче.‡Lernt von Seherin Rabenfeder \'Blitzheilung\'. Erprobt Eure neue Heilungstechnik 5 Mal an den verwundeten Kriegerhelden im Camp Narache.‡예언자 레이븐페더에게 순간 치유를 배워야 합니다. 그 후 나라체 야영지에 있는 부상당한 용사들에게 순간 치유 주문을 5회 사용해야 합니다.‡Aprende Sanación relámpago de la vidente Pluma de Cuervo. Practica Sanación relámpago 5 veces en el campo Narache con los valientes heridos.‡Aprende Sanación relámpago de la vidente Pluma de Cuervo. Practica Sanación relámpago 5 veces en el campo Narache con los valientes heridos.‡Apprenez les Soins rapides auprès de la Prophétesse Plume-de-corbeau. Ensuite, utilisez les Soins rapides 5 fois pour soigner des Braves blessés au Camp Narache.‡向鸦羽先知学习快速治疗。然后在纳拉其营地里对受伤的卫兵施放5次快速治疗。‡向先知鴉羽學習快速治療。對位於納拉其營地內受傷的勇士使用快速治療5次。',
  }
},
[27067] = {
  {
    'Rejuvenescer‡Омоложение‡Verjüngende Berührung‡회복의 손길‡Toque de rejuvenecimiento‡Toque de rejuvenecimiento‡Récupération‡回春之触‡回春之觸',
    nil,
    'Aprenda o feitiço Rejuvenescer com Gart Corre com a Névoa. Pratique lançando Rejuvenescer em um Valente Ferido na Aldeia Narache.‡Обучитесь "Омоложению" у Гарта Вестника Туманов и с помощью этого заклинания помогите раненому храбрецу в Лагере Нараче.‡Lernt von Gart Nebelläufer \'Verjüngung\'. Übt \'Verjüngung\' an einem verwundeten Kriegerhelden im Camp Narache.‡가트 미스트러너에게 회복을 배워야 합니다. 그 후 나라체 야영지에 있는 부상당한 용사들에게 회복을 사용하는 방법을 연습해야 합니다.‡Aprende Rejuvenecimiento de Gart Correbruma. Practica Rejuvenecimiento con un valiente herido en el Campamento Narache.‡Aprende Rejuvenecimiento de Gart Correbruma. Practica Rejuvenecimiento con un valiente herido en el Campamento Narache.‡Apprenez Récupération auprès de Gart Court-la-brume. Ensuite, utilisez Récupération pour soigner un Brave blessé au Camp Narache.‡向加尔特·迷雾行者学习回春术。然后在纳拉其营地中对受伤的卫兵施放5次治疗之触。‡向加爾特‧迷霧行者學習回春術。對納拉其營地內受傷的勇士使用回春術。',
  }
},
[27068] = {
  {
    'Chefe Ukorz Escalpareia‡Вождь Укорз Песчаный Череп‡Häuptling Ukurz Sandskalp‡족장 우코르즈 샌드스칼프‡Jefe Ukorz Cabellarena‡Jefe Ukorz Cabellarena‡Le chef Ukorz Scalpessable‡乌克兹·沙顶‡烏克茲‧沙頂',
    nil,
    'Mate o Chefe Ukorz Escalpareia.‡Убейте вождя Укорза Песчаного Черепа.‡Tötet Häuptling Ukorz Sandskalp.‡족장 우코르즈 샌드스칼프를 처치해야 합니다.‡Mata al jefe Ukorz Cabellarena.‡Mata al jefe Ukorz Cabellarena.‡Tuez le chef Ukorz Scalpessable.‡杀死乌克兹·沙顶。‡殺死烏克茲‧沙頂。',
  }
},
[27069] = {
  {
    'Trovão de aço‡Стальной гром‡Der stählerne Donner‡강철 천둥‡Truenos de acero‡Truenos de acero‡Le tonnerre d’acier‡钢雷‡鋼鐵雷霆',
    nil,
    'Recupere 5 Caixotes dos Lobos do Mar.|n|nPeça um outro lobinho do mar à Almirante Machadinha se você perder o seu.‡Соберите 5 ящиков морских волков.|n|nЕсли неожиданно потеряете своего орка-юнгу, поговорите с адмиралом Хетчетом, чтобы получить еще одного.‡Bergt 5 Seebärenkisten.|n|nFalls Ihr unerwartet Euren orcischen Süßwassermatrosen verlieren solltet, dann sprecht mit Admiral Hatchet, um einen neuen zu bekommen.‡선원 상자 5개를 회수해야 합니다.|n|n신참 오크 선원을 잃어버리면 제독 해칫과 대화하여 다른 선원을 데려가야 합니다.‡Recupera 5 cajones de lobo de mar.|n|nHabla con el almirante Hatchet para obtener otro cachorro de mar orco si por casualidad pierdes el tuyo.‡Recupera 5 cajones de lobo de mar.|n|nHabla con el almirante Hatchet para obtener otro cachorro de mar orco si por casualidad pierdes el tuyo.‡Récupérez 5 Caisses de loup de mer.|n|nAllez réclamer un autre Louveteau de mer orc à l’Amiral Laserpe si vous perdez le vôtre inopinément.‡收集5个水手的箱子。|n|n如果你跟兽人海军新兵失散了，可以跟战斧上将谈谈，他会再指派一个给你。‡取回5件水手木箱。|n|n如果你不小心失去了你的獸人海上新手，和戰斧上將交談以獲得另一個。',
  }
},
[27070] = {
  {
    'Bonita, linda e joiada‡Безнадежное дело‡Vergebliche Mühe‡허황된 꿈‡El recado del tonto‡El recado del tonto‡Mission impossible ?‡徒劳无益‡傻瓜任務',
    nil,
    'Obtenha a Tiara das Profundezas e a Escama Eletrificada de Gahz\'rilla.‡Добудьте Тиару Глубин и искрящую чешую Газ\'риллы.‡Beschafft Euch die Tiara der Tiefen und Gahz\'rillas elektrisierte Schuppe.‡심연의 티아라와 가즈릴라의 전기 비늘을 모아야 합니다.‡Consigue la tiara de las profundidades y la escama electrificada de Gahz\'rilla.‡Consigue la tiara de las profundidades y la escama electrificada de Gahz\'rilla.‡Récupérez la Tiare des abysses et une Écaille électrique de Gahz\'rilla.‡获得深渊皇冠和加兹瑞拉充电的鳞片。‡取得深淵冠冕和加茲瑞拉的鱗片。',
  }
},
[27071] = {
  {
    'A fúria dos Zangareia‡Гнев племени Песчаной Бури‡Zorn der Sandwüter‡성난모래 부족의 분노‡La ira de los Furiarena‡La ira de los Furiarena‡Le courroux des Furie-des-sables‡沙怒之怒‡沙怒的怒火',
    nil,
    'Mate o Mandingueiro Zum\'rah, Antu\'sul, Ruuzlu e Theka, o Mártir.‡Убейте Теку Мученика, знахаря Зум\'раха, Анту\'сула и Руузлу.‡Tötet Theka den Märtyrer, Hexendoktor Zum\'rah, Antu\'sul und Ruuzlu.‡순교자 데카, 의술사 줌라, 안투술, 루즐루를 처치해야 합니다.‡Mata a Theka el Mártir, al médico brujo Zum\'rah, a Antu\'sul y a Ruuzlu.‡Mata a Theka el Mártir, al médico brujo Zum\'rah, a Antu\'sul y a Ruuzlu.‡Tuez Theka le Martyr, le Féticheur Zum\'rah, Antu\'sul et Ruuzlu.‡杀死殉教者塞卡、巫医祖穆拉恩、安图苏尔，以及卢兹鲁。‡殺死『殉教者』塞卡、巫醫祖穆拉恩、安圖蘇爾和盧茲魯。',
  }
},
[27072] = {
  {
    'A antiga guarnição‡Старые казармы‡Die Alte Kaserne‡옛 병영‡El antiguo cuartel‡El antiguo cuartel‡La vieille caserne‡旧兵营‡舊兵營',
    nil,
    'Vá para a Antiga Guarnição e mate 6 Sectários Enlouquecidos. Depois, localize Jack Bauden.‡Отправляйтесь в Старые казармы и убейте 6 безумных сектантов, а затем найдите Джека Бодена.‡Geht zur Alten Kaserne und tötet 6 wahnsinnige Kultisten, dann findet Jack Bauden.‡옛 병영으로 가서 광기 어린 이교도 6명을 처치하고 잭 보든을 찾아내야 합니다.‡Ve al antiguo cuartel y mata a 6 cultores enloquecidos, luego encuentra a Jack Bauden.‡Ve al antiguo cuartel y mata a 6 cultores enloquecidos, luego encuentra a Jack Bauden.‡Allez à la Vieille caserne, tuez 6 Sectateurs fous furieux et localisez Jack Bauden.‡前往旧兵营杀死6名发疯的异教徒，找到杰克·伯登。‡到舊兵營殺死6個發狂的教徒，並找到傑克‧鮑頓。',
  }
},
[27073] = {
  {
    'Mande-os para o Inferno!‡Задай им жару!‡Macht ihnen die Hölle heiß!‡지옥을 맛봐라!‡¡Aniquílalos!‡¡Aniquílalos!‡L’honneur et l’abstinence‡让他们尝尝苦头‡送他們下地獄吧!',
    nil,
    'Mate 10 Catadores Dentessangue.‡Убейте 10 падальщиков из стаи Кровавых Клыков.‡Tötet 10 Blutfangplünderer.‡붉은송곳니 청소부 10명을 처치해야 합니다.‡Mata a 10 carroñeros Colmillo de Sangre.‡Mata a 10 carroñeros Colmillo de Sangre.‡Tuez 10 Charognards crocs-de-sang.‡杀掉10个血牙清除者。‡殺死10名血牙拾荒者。',
  }
},
[27074] = {
  {
    'Ataque ao Martelo‡Битва с Молотом‡Bekämpft den Hammer‡황혼의 망치단과 싸워라‡Lucha contra el Martillo‡Lucha contra el Martillo‡Combattre le Marteau‡对抗暮光之锤‡與暮光之錘戰鬥',
    nil,
    'Fale com Ashlan Risadura ao lado da Fortaleza Mo\'grosh, em Loch Modan.‡Поговорите с Ашланом Камнехмылом у Оплота Мо\'гроша, что в Лок Модане.‡Sprecht in Loch Modan in der Nähe der Festung Mo\'grosh mit Ashlan Schmunzelstein.‡모단 호수의 모그로쉬 소굴 주변에 있는 애실런 스톤스머크와 대화해야 합니다.‡Habla con Ashlan Risapétrea cerca de la Fortaleza de Mo\'grosh en Loch Modan.‡Habla con Ashlan Risapétrea cerca de la Fortaleza de Mo\'grosh en Loch Modan.‡Parlez à Ashlan Rictus-de-pierre près du Bastion des Mo’grosh, au Loch Modan.‡去跟洛克莫丹莫格罗什要塞附近的阿什兰·暗石谈一谈。‡到洛克莫丹的莫格羅什要塞附近和阿胥蘭·暗石談話。',
  }
},
[27075] = {
  {
    'Servos de Cho\'gall‡Служители Чо\'Галла‡Diener von Cho\'gall‡초갈의 종복들‡Siervos de Cho\'gall‡Siervos de Cho\'gall‡Les serviteurs de Cho’gall‡古加尔的奴仆‡丘加利的僕人',
    nil,
    'Mate 7 ogros Mo\'grosh na Fortaleza Mo\'grosh.‡Убейте 7 огров из клана Мо\'грош в Оплоте Мо\'гроша.‡Tötet 7 Oger der Mo\'grosh in der Festung Mo\'grosh.‡모그로쉬 소굴에서 모그로쉬 오우거 7마리를 처치해야 합니다.‡Mata a 7 ogros Mo\'grosh en la Fortaleza de Mo\'grosh.‡Mata a 7 ogros Mo\'grosh en la Fortaleza de Mo\'grosh.‡Tuez 7 Ogres mo’grosh au Bastion des Mo’grosh.‡在莫格罗什要塞杀掉7只莫格罗什食人魔。‡在莫格羅什要塞消滅7個莫格羅什巨魔。',
  }
},
[27076] = {
  {
    'Arrombamento e invasão‡Взломай и входи‡Einbruch mit schwerem Werkzeug‡무단 침입‡Irrumpir y arrasar‡Irrumpir y arrasar‡Par effraction‡破门而入‡破門而入',
    nil,
    'Liberte Weegli Pavio Quente e mate Nekrum Cometripas e o Sacerdote Sombrio Diz\'ieh.‡Освободите Вигиля Фитиля и убейте Некрума Кишкожуя и темного жреца Шез\'зиза.‡Befreit Weegli Lunte und tötet Nekrum den Ausweider und Schattenpriester Sezz\'ziz.‡위글리 블라스트퓨즈를 풀어주고 네크룸 거트츄어와 암흑사제 세즈지즈를 처치해야 합니다.‡Libera a Weegli Plomofundido y mata a Nekrum Cometripas y al sacerdote oscuro Sezz\'ziz.‡Libera a Weegli Plomofundido y mata a Nekrum Cometripas y al sacerdote oscuro Sezz\'ziz.‡Libérez Gigoto Explomèche et tuez Nekrum Mâchentrailles et le Prêtre des ombres Sezz\'ziz.‡解救维格利，杀掉耐克鲁姆和暗影祭司塞瑟斯。‡釋放維格利並殺死耐克倫·嚼腸者和暗影祭司塞瑟斯。',
  }
},
[27077] = {
  {
    'Presos ao caos‡Остановить хаос‡Ans Chaos klammern‡혼돈을 움켜쥐며‡Aferrarse al caos‡Aferrarse al caos‡Prendre le chaos à la gorge‡攫住混沌‡趁亂而入',
    nil,
    'Arranque do chão 10 Aguilhões Nascentes de Elemêntio na Fortaleza Mo\'grosh.‡Выдерните 10 формирующихся элементиевых зубцов из земли Оплота Мо\'гроша.‡Reißt 10 entstehende Elementiumstacheln aus dem Boden der Festung Mo\'grosh.‡모그로쉬 소굴 지역의 땅에서 솟아오르는 초기 엘레멘티움 쐐기 10개를 뜯어내야 합니다.‡Arranca 10 pinchos de elementium naciente del suelo en la Fortaleza de Mo\'grosh.‡Arranca 10 pinchos de elementium naciente del suelo en la Fortaleza de Mo\'grosh.‡Arrachez du sol 10 Piques d’élémentium naissantes au Bastion des Mo’grosh.‡从莫格罗什要塞的地上拔起10根初生源质之刺。‡從莫格羅什要塞的地面拔出10根初生源質矛刺。',
  }
},
[27078] = {
  {
    'Gor\'kresh‡Гор\'креш‡Gor\'kresh‡고르크레시‡Gor\'kresh‡Gor\'kresh‡Gor’kresh‡戈克雷什‡戈克雷什',
    nil,
    'Derrote Gor\'kresh.‡Победите Гор\'креша.‡Besiegt Gor\'kresh.‡고르크레시를 처치해야 합니다.‡Derrota a Gor\'kresh.‡Derrota a Gor\'kresh.‡Terrassez Gor’kresh.‡击败戈克雷什。‡擊敗戈克雷什。',
  }
},
[27079] = {
  {
    '‡Поиски Сумеречных врат‡Das Zwielichttor aufspüren‡황혼 관문 추적‡Rastreo en La Puerta Crepuscular‡‡Suivi du porte du Crépuscule‡‡',
    nil,
    nil,
  }
},
[27080] = {
  {
    '‡Поиски Сумеречных врат‡Das Zwielichttor aufspüren‡황혼 관문 추적‡Rastreo en La Puerta Crepuscular‡‡Suivi du porte du Crépuscule‡‡',
    nil,
    nil,
  }
},
[27082] = {
  {
    'Jogando sujo‡Грязная игра‡Unfaire Methoden‡더러운 임무‡Jugando sucio‡Jugando sucio‡La tripaille de l’apothicaire‡肮脏的游戏‡骯髒的手段',
    nil,
    'Colete 8 Órgãos Adoecidos de Ursos Raivosos Gigantes e de Worgs Raivosos.‡Добудьте 8 зараженных органов гигантских бешеных медведей и бешеных воргов.‡Beschafft 8 verseuchte Organe von ergrauten Riesenbären und tollwütigen Worgs.‡거대하고 광포한 곰과 광포한 검은늑대에게서 병에 걸린 기관 8개를 모아야 합니다.‡Consigue 8 órganos infectados de oso grisáceo gigante y de huargo rabioso.‡Consigue 8 órganos infectados de oso grisáceo gigante y de huargo rabioso.‡Récupérez 8 Organes malades sur des Ours géants enragés et des Worgs enragés.‡从疯狂的巨熊和疯狂的座狼身上获取8份染病的脏器。‡從巨型狂熊和瘋狂的座狼身上收集8份染病的器官。',
  }
},
[27083] = {
  {
    'A batalha continua‡Борьба возобновляется!‡Die Schlacht geht weiter!‡전투 재개!‡¡Se reanuda la batalla!‡¡Se reanuda la batalla!‡La bataille reprend !‡战斗又打响了！‡戰火重新點燃',
    nil,
    'Apresente-se a Koltirus Tecemorte em Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с Кольтирой Ткачом Смерти в Андорале в Западных Чумных землях.‡Meldet Euch in den Westlichen Pestländern in Andorhal bei Koltira Todesweber.‡서부 역병지대의 안돌할에 있는 콜티라 데스위버에게 보고해야 합니다.‡Preséntate ante Koltira Tejemuerte en Andorhal, en las Tierras de la Peste del Oeste.‡Preséntate ante Koltira Tejemuerte en Andorhal, en las Tierras de la Peste del Oeste.‡Faites votre rapport à Koltira Tissemort à Andorhal, dans les Maleterres de l’Ouest.‡向西瘟疫之地安多哈尔城的库尔迪拉·织亡者报告。‡到西瘟疫之地的安多哈爾向寇爾提拉·亡織者回報。',
  }
},
[27084] = {
  {
    'A milícia dos fazendeiros‡Крестьянское ополчение‡Die Bauernmiliz‡농부들의 민병대‡La milicia de granjeros‡La milicia de granjeros‡Soldats et paysans‡农夫义勇军‡農夫民兵',
    nil,
    'Use a Coleira da Gárgula de Ébano em 6 Milicianos Provincianos em Andorhal.‡С помощью ошейника вороной горгульи затравите 6 местных ополченцев в Андорале.‡Benutzt das ebenhölzerne Gargoylehalsband auf 6 Provinzmilizen in Andorhal.‡칠흑의 가고일 목줄을 안돌할에 있는 지역 민병대원 6명에게 사용해야 합니다.‡Usa la collera de gárgola de ébano con 6 milicianos provinciales en el interior de Andorhal.‡Usa la collera de gárgola de ébano con 6 milicianos provinciales en el interior de Andorhal.‡Utilisez le Collier de gargouille d’ébène sur 6 Soudards provinciaux dans Andorhal.‡对安多哈尔城中6名义勇民兵使用黑锋石像鬼颈圈。‡到安多哈爾裡去，在6個地方民兵身上使用黑檀石像鬼項圈。',
  }
},
[27085] = {
  {
    'Ajuda às tropas‡Поддержка войск‡Die Truppen unterstützen‡아군 지원‡Apoyar a las tropas‡Apoyar a las tropas‡À la rescousse des nécrogardes‡支援部队‡支援部隊',
    nil,
    'Mate 15 Defensores de Andorhal.‡Убейте 15 защитников Андорала.‡Tötet 15 Verteidiger von Andorhal.‡안돌할 파수병 15명을 처치해야 합니다.‡Asesina a 15 defensores de Andorhal.‡Asesina a 15 defensores de Andorhal.‡Tuez 15 Défenseurs d’Andorhal.‡消灭15名安多哈尔防御者。‡殺死15名安多哈爾防衛者。',
  }
},
[27086] = {
  {
    'Do pó ao pó‡Прах к праху‡Asche zu Asche‡재에서 재로‡Cenizas a las cenizas‡Cenizas a las cenizas‡Éliminer le haut commandement‡尘归尘‡塵歸塵',
    nil,
    'Mate 3 Chefes Militares de Andorhal.‡Убейте 3 военачальников Андорала.‡Tötet 3 Streitkräftekommandanten von Andorhal.‡안돌할 전투사령관 3명을 처치해야 합니다.‡Asesina a 3 comandantes en Jefe de Andorhal.‡Asesina a 3 comandantes en Jefe de Andorhal.‡Tuez 3 Commandants de corps d’Andorhal.‡杀死3名安多哈尔战地指挥官。‡殺死3名安多哈爾軍隊指揮官。',
  }
},
[27087] = {
  {
    'Lívida Corvossol, revelada‡Разоблачение Линдси Черное Солнце‡Die Entlarvung der Lindsay Rabensonn‡린제이 레이븐선의 정체‡Lindsay Negrosol se sincera‡Lindsay Negrosol se sincera‡Lindsay Astrejais démasquée‡琳塞·鸦日，现身‡林塞·掠日，暴露行蹤',
    nil,
    'Fale com Lívida Corvossol em Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с Линдси Черное Солнце в Андорале в Западных Чумных землях.‡Meldet Euch in den Westlichen Pestländern in Andorhal bei Lindsay Rabensonn.‡서부 역병지대의 안돌할에 있는 린제이 레이븐선에게 보고해야 합니다.‡Preséntate ante Lindsay Negrosol en Andorhal, en las Tierras de la Peste del Oeste.‡Preséntate ante Lindsay Negrosol en Andorhal, en las Tierras de la Peste del Oeste.‡Présentez-vous à Lindsay Astrejais à Andorhal, dans les Maleterres de l’Ouest.‡去西瘟疫之地的安多哈尔找琳塞·鸦日。‡到西瘟疫之地的安多哈爾去向林塞·掠日回報。',
  }
},
[27088] = {
  {
    'Só é venenoso se você ingerir‡В пищу не употреблять!‡Es ist nur giftig, wenn man es einnimmt‡삼키면 독약‡Solo es venenoso si te lo comes‡Solo es venenoso si te lo comes‡Le poulet indigeste‡你摄取的不过是毒素‡只有吞下才有毒',
    nil,
    'Use o Frango do Mato Mutante para matar o Gorjala da Floresta.‡Уничтожьте лесного эттина с помощью мутировавших цыплят-бройлеров.‡Benutzt das mutierte Buschhuhn, um den Waldettin zu töten.‡돌연변이 덤불닭을 사용하여 숲거인을 처치해야 합니다.‡Usa al pollo de matorral mutante para matar el ettin del bosque.‡Usa al pollo de matorral mutante para matar el ettin del bosque.‡Utilisez le Poulet mutant des fourrés pour tuer l’Ettin forestier.‡用变异的灌木小鸡杀掉森林双头魔。‡使用突變灌木雞殺死森林雙頭巨人。',
  }
},
[27089] = {
  {
    'Um ás na manga‡Козырь в рукаве‡Versteckter Trumpf‡비장의 카드‡Un as en la manga‡Un as en la manga‡Un as dans la manche‡王牌降临‡秘密王牌',
    nil,
    'Com a Val\'kyr Enfeitiçada ao seu lado, mate 5 Milicianos Provincianos Assustados e use a habilidade Chamado às Armas para transformá-los em Soldados Renegados. Depois, encontre Thassarian na parte oeste de Andorhal.‡Вместе с порабощенной валь\'кирой убейте 5 запуганных деревенских ополченцев. Затем при помощи своих магических способностей зачаруйте их в солдат Отрекшихся. После этого отыщите Тассариана в западном Андорале.‡Tötet 5 verängstigte Provinzmilizangehörige mit der bezauberten Val\'kyr an Eurer Seite. Dann benutzt Eure Fähigkeit \'Ruf zu den Waffen\' und macht aus ihnen Gardisten der Verlassenen. Dann findet Thassarian im Westteil von Andorhal.‡속박된 발키르를 데리고 겁에 질린 지역 민병대원 5명을 처치한 뒤, 발키르의 전장으로 능력을 이용해 처치한 지역 민병대원을 포세이큰 돌격병으로 만들어야 합니다. 그 후 안돌할 서쪽에서 타사리안을 찾아야 합니다.‡Con la Val\'kyr sometida a tu lado, mata a 5 lidiadores provinciales aterrorizados y después emplea tu facultad Llamamiento a la armas para convertirlos en soldados de caballería Renegados. Después reúnete con Thassarian en Andorhal occidental.‡Con la Val\'kyr sometida a tu lado, mata a 5 lidiadores provinciales aterrorizados y después emplea tu facultad Llamamiento a la armas para convertirlos en soldados de caballería Renegados. Después reúnete con Thassarian en Andorhal occidental.‡Tuez 5 Soudards provinciaux effrayés alors que la val’kyr se trouve à vos côtés, puis utilisez votre compétence d’Appel aux armes pour les transformer en Troupiers réprouvés. Trouvez ensuite Thassarian dans l\'ouest d\'Andorhal.‡在归降的瓦格里的陪同下杀死5名惊恐的义勇民兵，用你的战斗的召唤能力将他们变为被遗忘者步兵。然后去安多哈尔西边找萨萨里安。‡將被控制的華爾琪帶在身邊，殺死5個害怕的地方民兵，然後使用你的戰鬥號召能力將他們轉變為被遺忘者裝甲兵。接著到西安多哈爾去找薩沙理安。',
  }
},
[27090] = {
  {
    'Andorhal, de uma vez por todas‡Андорал – раз и навсегда‡Andorhal, für Immer und Ewig‡안돌할이여, 영원히‡Andorhal, de una vez por todas‡Andorhal, de una vez por todas‡Andorhal, une fois pour toutes‡安多哈尔，彻底了结‡安多哈爾，一勞永逸',
    nil,
    'Fale com a Grande Dama Sylvana Correventos em Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Доберитесь до Леди Сильваны Ветрокрылой в Андорале в Западных Чумных землях.‡Meldet Euch in den Westlichen Pestländern in Andorhal bei Fürstin Sylvanas Windläufer.‡서부 역병지대의 안돌할에 있는 여군주 실바나스 윈드러너에게 보고해야 합니다.‡Preséntate ante Lady Sylvanas Brisaveloz en Andorhal, en las Tierras de la Peste del Oeste.‡Preséntate ante Lady Sylvanas Brisaveloz en Andorhal, en las Tierras de la Peste del Oeste.‡Faites votre rapport à dame Sylvanas Coursevent à Andorhal, dans les Maleterres de l’Ouest.‡向西瘟疫之地安多哈尔城的希尔瓦娜斯·风行者复命。‡到西瘟疫之地的安多哈爾去向希瓦娜斯·風行者女士回報。',
  }
},
[27091] = {
  {
    'Investida!‡Рывок‡Sturmangriff!‡돌진!‡¡Cargar!‡¡Cargar!‡À la charge !‡冲锋！‡衝鋒!',
    nil,
    'Aprenda Investida com Delios. Encontre um Boneco de Treinamento no exterior da Torre do Sol e pratique Investida.‡Обучитесь умению рывка у Делиоса. Найдите тренировочный манекен рядом с Солнечным Шпилем и отработайте только что изученный прием.‡Lernt von Delios \'Sturmangriff\'. Findet eine Trainingsattrappe außerhalb des Sonnenturms und übt \'Sturmangriff\'.‡델리오스에게 돌진을 배우고, 태양 첨탑 밖에 있는 훈련용 허수아비를 찾아 돌진을 사용하여 연습해야 합니다.‡Aprende Cargar de Delios. Busca un muñeco de entrenamiento junto a la Aguja del Sol y practica Cargar.‡Aprende Cargar de Delios. Busca un muñeco de entrenamiento junto a la Aguja del Sol y practica Cargar.‡Apprenez la Charge auprès de Delios. Trouvez un Mannequin d\'entraînement devant la Flèche Solaire et entraînez-vous à utiliser la Charge.‡向德利奥斯学习冲锋。然后在太阳之塔外面找一个训练假人，对它使用冲锋。‡向戴利歐斯學習衝鋒。在日尖塔外找一個訓練假人，用它來練習衝鋒。',
  }
},
[27092] = {
  {
    'Cataclismo nas catacumbas‡Катаклизм в катакомбах‡Kataklysmus in den Katakomben‡지하묘지의 대격변‡Cataclismo en las catacumbas‡Cataclismo en las catacumbas‡Cataclysme dans les catacombes‡陵墓惊变‡墓窖浩劫',
    nil,
    'Entre na Catedral da Luz e siga para as catacumbas subterrâneas. Mate o Bispo Negro e desarme a Pilha de Explosivos que está próxima.‡Войдите в Собор Света и спуститесь в катакомбы под ним. Убейте темного епископа и обезвредьте гору взрывчатки, которая находится рядом.‡Betretet die Kathedrale des Lichts und steigt hinab in die Katakomben darunter. Tötet den Schwarzen Bischof und entschärft den Sprengstoffhaufen in der Nähe.‡빛의 대성당에 들어가 성당 아래의 지하묘지로 내려가십시오. 암흑 주교를 처치하고, 근처에 있는 폭탄 더미를 해제해야 합니다.‡Entra en la Catedral de la Luz y baja a las catacumbas. Mata al Obispo Negro y desarma la pila de explosivos.‡Entra en la Catedral de la Luz y baja a las catacumbas. Mata al Obispo Negro y desarma la pila de explosivos.‡Entrez dans la Cathédrale de la Lumière et descendez dans les catacombes qui s\'étendent en dessous. Tuez le Fou noir et désarmez la pile d\'explosifs à proximité.‡进入光明大教堂地下陵墓。杀掉黑主教，熄灭附近的炸药堆。‡進入聖光大教堂下方的地下墓穴。殺死黑主教，並拆除附近的一堆炸藥。',
  }
},
[27093] = {
  {
    'Perdido na escuridão‡Затерянные во тьме‡In der Dunkelheit verlaufen‡어둠 속에 길을 잃다‡Perdidos en la oscuridad‡Perdidos en la oscuridad‡Embrouilles au Grouillement‡迷失在黑暗中‡迷失在黑暗中',
    nil,
    'Resgate 6 Lobos do Mar Orcs da Penumbra Furtiva.‡Спасите 6 орков-морских волков в Оплетающей Тьме.‡Rettet 6 orcische Seebären aus dem Huschdunkel.‡암흑 땅거미굴에서 노련한 오크 선원 6명을 구출해야 합니다.‡Rescata a 6 lobos de mar orcos de Penumbra de las Celerácnidas.‡Rescata a 6 lobos de mar orcos de Penumbra de las Celerácnidas.‡Portez secours à 6 Loups de mer orcs au Grouillement.‡从粘丝洞里救出6名兽人水兵。‡從粘絲洞裡救出6名獸人老水手。',
  }
},
[27094] = {
  {
    'Mais fundo nas trevas‡Во тьму‡Tiefer in die Dunkelheit‡어둠 속으로 더 깊이‡Adentrándose en la oscuridad‡Adentrándose en la oscuridad‡Au fin fond de la toile‡黑暗的更深处‡深入黑暗',
    nil,
    'Mate a Matriarca Tremeteia.‡Убейте матриарха мшистых пауков.‡Tötet die Netzhuschermatriarchin.‡우두머리 땅거미를 처치해야 합니다.‡Mata a la matriarca Corretela.‡Mata a la matriarca Corretela.‡Tuez la Matriarche toile-grouillante.‡杀死掠网蛛后。‡殺死蛛網族母。',
  }
},
[27095] = {
  {
    'A ameaça das tremeteias‡Паучья угроза‡Die Netzhuscherbedrohung‡땅거미의 위협‡Amenaza Corretela‡Amenaza Corretela‡Dans la toile des Toiles-grouillantes‡粘丝的威胁‡蛛網的威脅',
    nil,
    'Mate 12 Aranhas Tremeteia.‡Убейте 12 мшистых пауков.‡Tötet 12 Netzhuscherspinnen.‡땅거미 12마리를 처치해야 합니다.‡Mata a 12 arañas Corretela.‡Mata a 12 arañas Corretela.‡Tuez 12 Araignées toiles-grouillantes.‡杀死12只掠网蜘蛛。‡殺死12隻蛛網蜘蛛。',
  }
},
[27096] = {
  {
    'Orcs a postos‡У орков все прекрасно‡Alles klar bei den Orcs‡오크, 준비 완료!‡Los orcos están listos‡Los orcos están listos‡Les orcs sont en « orc de marche »‡兽人准备就绪‡待命的獸人',
    nil,
    'Entregue a Carta de Comenda da Almirante para a Grande Dama Sylvana Correventos no Alto Comando dos Renegados, que fica na Floresta de Pinhaprata.‡Передайте рекомендательное письмо адмирала Сильване Ветрокрылой в Ставку Отрекшихся в Серебряном бору.‡Liefert das Empfehlungsschreiben des Admirals bei Fürstin Sylvanas Windläufer bei der Kommandozentrale der Verlassenen im Silberwald ab.‡은빛소나무 숲의 포세이큰 고위 사령부에 있는 여군주 실바나스 윈드러너에게 제독의 추천서를 가져가야 합니다.‡Entrega la carta de mención del almirante a Lady Sylvanas Brisaveloz en el Alto Mando Renegado, en el Bosque de Argénteos.‡Entrega la carta de mención del almirante a Lady Sylvanas Brisaveloz en el Alto Mando Renegado, en el Bosque de Argénteos.‡Portez la Lettre de recommandation de l’amiral à Dame Sylvanas Coursevent au Haut commandement des Réprouvés, dans la Forêt des Pins-Argentés.‡把将军的推荐信交给银松森林被遗忘者统帅部的希尔瓦娜斯·风行者。‡到銀松森林的被遺忘者高階指揮所，將上將的表揚信函交給希瓦娜斯·風行者女士。',
  }
},
[27097] = {
  {
    'Erga-se, Renegado‡Восстань, Отрекшийся‡Erhebt Euch, Verlassene‡일어나라, 포세이큰‡Alzaos, Renegados‡Alzaos, Renegados‡Mortel recrutement‡崛起吧，被遗忘者‡醒來吧，被遺忘者',
    nil,
    'Ressuscite 15 Renegados matando humanos na Ilha de Fenris.‡Убейте людей на острове и поднимите 15 Отрекшихся.‡Erweckt 15 Verlassene, indem Ihr Menschen auf der Insel Fenris tötet.‡펜리스 섬에서 인간 15명을 처치한 후, 그 시체를 포세이큰으로 되살려야 합니다.‡Haz surgir a 15 Renegados matando humanos en la Isla de Fenris.‡Haz surgir a 15 Renegados matando humanos en la Isla de Fenris.‡Réanimez 15 Réprouvés en tuant des humains sur l’Île de Fenris.‡在芬里斯岛击败15名人类，并使他们效忠黑暗女王。‡在芬里斯島上殺死人類以喚醒15名被遺忘者。',
  }
},
[27098] = {
  {
    'Lordaeron‡Лордерон‡Lordaeron‡로데론‡Lordaeron‡Lordaeron‡Lordaeron‡洛丹伦‡羅德隆',
    nil,
    'Acompanhe a Grande Dama Sylvana Correventos até o Sepulcro, que fica na Floresta de Pinhaprata.‡Отправляйтесь с госпожой Сильваной Ветрокрылой в Гробницу в Серебряном бору.‡Begleitet Fürstin Sylvanas Windläufer zum Grabmal im Silberwald.‡은빛소나무 숲의 공동묘지까지 여군주 실바나스 윈드러너를 호위해야 합니다.‡Acompaña a Lady Sylvanas Brisaveloz a El Sepulcro en el Bosque de Argénteos.‡Acompaña a Lady Sylvanas Brisaveloz a El Sepulcro en el Bosque de Argénteos.‡Accompagnez Dame Sylvanas Coursevent au Sépulcre, dans la Forêt des Pins-Argentés.‡陪伴希尔瓦娜斯·风行者前往银松森林的瑟伯切尔。‡陪伴希瓦娜斯·風行者女士前往銀松森林裡的瑟伯切爾。',
  }
},
[27099] = {
  {
    'Sem saída‡Спасенья нет‡Kein Entkommen‡피난민 소탕‡Sin escapatoria‡Sin escapatoria‡Pas de quartier !‡无处可逃‡無路可逃',
    nil,
    'Encontre a Liderança dos Refugiados dentro do Castelo Fenris.‡Отыщите лидеров беженцев в Крепости Фенриса.‡Findet die Anführer der Flüchtlinge in Burg Fenris.‡펜리스 요새에서 피난민 지도부를 찾아야 합니다.‡Encuentra a los líderes refugiados en el castillo de Fenris.‡Encuentra a los líderes refugiados en el castillo de Fenris.‡Trouvez les chefs des réfugiés à l\'intérieur du Donjon de Fenris.‡在芬里斯岛找到难民领袖。‡在芬里斯城堡內部找出難民的首領。',
  }
},
[27100] = {
  {
    'Pesquisa do Crepúsculo‡Исследование Сумеречного Молота‡Zwielichtige Forschungen‡황혼의 연구‡Investigación Crepuscular‡Investigación Crepuscular‡Les recherches du Crépuscule‡暮光调查‡暮光研究',
    nil,
    'Obtenha 4 Anotações de Pesquisa do Crepúsculo de Gosmas Mercuriais no Alto Pântano de Prata.‡Добудьте 4 страницы исследовательских записей Сумеречного Молота у переливчатых слизнюков в Верховье Серебристой топи.‡Findet in den Oberen Silbermarschen 4 Zwielichtforschungsnotizen über Quecksilberschlamm.‡은빛늪지 상류에서 수은 수액괴물로부터 황혼의 연구 쪽지 4장을 입수해야 합니다.‡Consigue 4 notas de investigación Crepusculares de los mocos mercúricos en el Marjal Argenta Superior.‡Consigue 4 notas de investigación Crepusculares de los mocos mercúricos en el Marjal Argenta Superior.‡Récupérez 4 Notes de recherche du Crépuscule sur les Limons mercuriens dans le Marécage Argenté Supérieur.‡从上层银沼的水银软泥怪身上获得4份暮光调查笔记。‡在銀之沼澤上層從水銀軟泥怪那裡取得4份暮光研究筆記。',
  }
},
[27101] = {
  {
    'A revelação de Maziel‡Откровение Мазиела‡Maziels Enthüllung‡마지엘의 발견‡El descubrimiento de Maziel‡El descubrimiento de Maziel‡La révélation de Maziel‡玛兹尔的发现‡瑪茲艾爾的啟示',
    nil,
    'Encontre o Diário de Maziel no Baixo Pântano de Prata, que fica no Geodomo.‡Найдите дневник Мазиела в Низине Серебристой топи в Подземье.‡Geht zu den Unteren Silbermarschen in Tiefenheim und findet Maziels Tagebuch.‡심원의 영지의 은빛늪지 하류에서 마지엘의 일지를 찾아야 합니다.‡Encuentra el diario de Maziel en el Marjal Argenta Inferior en Infralar.‡Encuentra el diario de Maziel en el Marjal Argenta Inferior en Infralar.‡Trouvez le Journal de Maziel dans le Marécage Argenté Inférieur, dans le Tréfonds.‡在深岩之洲下层银沼找到玛兹尔的日志。‡在地深之源的銀之沼澤下層找到瑪茲艾爾的日誌。',
  }
},
[27102] = {
  {
    'A ascensão de Maziel‡Сила Мазиела‡Maziels Aufstieg‡마지엘의 변신‡La ascendencia de Maziel‡La ascendencia de Maziel‡L’ascendance de Maziel‡玛兹尔的支配‡瑪茲艾爾的轉化',
    nil,
    'Mate Maziel dentro da Caverna da Luz Prateada, no Geodomo.‡Убейте Мазиела в Пещере Серебряного Света в Подземье.‡Tötet Maziel in der Silberlichthöhle in Tiefenheim.‡심원의 영지의 은빛 동굴 안에 있는 마지엘을 처치해야 합니다.‡Asesina a Maziel en el interior de la Caverna Luz de Plata en Infralar.‡Asesina a Maziel en el interior de la Caverna Luz de Plata en Infralar.‡Tuez Maziel à l’intérieur de la Caverne de Brillargent dans le Tréfonds.‡击败深岩之洲银光洞穴里的玛兹尔。‡在地深之源裡的銀光洞窟殺死瑪茲艾爾。',
  }
},
[27103] = {
  {
    'Pedaços de Vinhavil‡Осколки сквернита‡Die Splitter der Teufelsranke‡악령덩굴 조각‡Fragmentos de gangrevid‡Fragmentos de gangrevid‡Fragment de la Gangrevigne‡魔藤碎片‡魔藤裂片',
    nil,
    'Use o Relicário da Pureza para recolher uma Lasca de Vinhavil.‡Воспользуйтесь реликварием Чистоты, чтобы захватить осколок сквернита.‡Benutzt das Reliquiar der Reinheit, um einen Teufelsrankensplitter einzufangen.‡정화의 성물함을 사용해 악령덩굴 조각을 채취해야 합니다.‡Utiliza el relicario de Pureza para capturar un fragmento de gangrevid.‡Utiliza el relicario de Pureza para capturar un fragmento de gangrevid.‡Utilisez le Reliquaire de pureté pour obtenir un Fragment de gangrevigne.‡使用净化之匣封印一块魔藤碎片。‡使用淨化之匣捕捉魔藤裂片。',
  }
},
[27104] = {
  {
    'Azzin, o Selvamorfo‡Алззин Перевертень‡Alzzin der Wildformer‡칼날바람 알진‡Alzzin el Formaferal‡Alzzin el Formaferal‡Alzzin le Modeleur‡荒野变形者奥兹恩‡『狂野變形者』奧茲恩',
    nil,
    'Mate Zevrim Cascardo e Azzin, o Selvamorfo.‡Убейте Зеврима Терновое Копыто и Алззина Перевертеня.‡Tötet Zevrim Dornhuf und Alzzin den Wildformer.‡제브림 쏜후프와 칼날바람 알진을 처치해야 합니다.‡Mata a Zevrim Pezuñahendida y a Alzzin el Formaferal.‡Mata a Zevrim Pezuñahendida y a Alzzin el Formaferal.‡Tuez Zevrim Sabot-de-ronce et Alzzin le Modeleur.‡杀死瑟雷姆·刺蹄和荒野变形者奥兹恩。‡殺死瑟雷姆‧刺蹄和『狂野變形者』奧茲恩。',
  }
},
[27105] = {
  {
    'O penetra‡Незваный гость‡Ein ungebetener Gast‡불청객‡Una visita poco grata‡Una visita poco grata‡Un invité indésirable‡不速之客‡一位不速之客',
    nil,
    'Colete a Essência de Rebentágua.‡Добудьте сущность Гидротвари.‡Findet die Hydrobrutessenz.‡히드로스폰의 정수를 모아야 합니다.‡Recoge la esencia de Hidromilecio.‡Recoge la esencia de Hidromilecio.‡Récupérez l\'Essence d\'Hydrogénos.‡获得海多斯博恩精华。‡收集海多斯博恩精華。',
  }
},
[27106] = {
  {
    'Um vilão desmascarado‡Разоблачение злодея‡Entlarvung eines Schurken‡정체를 드러낸 악당‡Un villano desenmascarado‡Un villano desenmascarado‡Le malfaisant démasqué‡揭露黑手‡惡棍的真面目',
    nil,
    'Desmascare e mate o Major Samuelson na Sala do Trono da Bastilha Ventobravo.‡Разоблачите и убейте майора Самуэльсона в тронном зале крепости Штормграда.‡Enttarnt und tötet Major Samuelson im Thronraum von Burg Sturmwind.‡스톰윈드 왕궁에서 상사 사무엘슨의 정체를 밝히고 처치해야 합니다.‡Desenmascara y mata al mayor Samuelson en la Sala del Trono del Castillo de Ventormenta.‡Desenmascara y mata al mayor Samuelson en la Sala del Trono del Castillo de Ventormenta‡Démasquez et tuez le Major Samuelson dans la salle du trône du Donjon de Hurlevent.‡在暴风城堡王座揭露萨缪尔森上校的真面目并将他就地处决。‡在暴風要塞王座廳裡揭露山繆森少校的真面目並殺死他。',
  }
},
[27107] = {
  {
    'Pusillin, o ladrão‡Воришка Пузиллин‡Pusillin der Dieb‡도둑 푸실린‡Pusillín el ladrón‡Pusillín el ladrón‡Pusillin, ce petit voleur‡窃贼普希林‡小賊普希林',
    nil,
    'Convença Pusillin a devolver o Livro de Encantamentos.‡Убедите Пузиллина отдать книгу магических формул.‡Überredet Pusillin, das Buch der Zauberformeln herauszugeben.‡푸실린이 마법서를 포기하도록 설득해야 합니다.‡Convence a Pusillín para que te dé el Libro de Conjuros.‡Convence a Pusillín para que te dé el Libro de Conjuros.‡Vous devez convaincre Pusillin de vous donner le Livre des Incantations.‡说服普希林把咒术之书交给你。‡說服普希林放棄咒術之書。',
  }
},
[27108] = {
  {
    'A teia de Letendris‡Сеть Лефтендрис‡Lethtendris\' Netz‡레스텐드리스의 그물‡La membrana de Lethtendris‡La membrana de Lethtendris‡Le filet de Lethtendris‡蕾瑟塔蒂丝的网‡蕾瑟塔蒂絲之網',
    nil,
    'Pegue a teia de Letendris.‡Добудьте сеть Лефтендрис.‡Beschafft Lethtendris\' Netz.‡레스텐드리스의 그물을 획득해야 합니다.‡Consigue la membrana de Lethtendris.‡Consigue la membrana de Lethtendris.‡Obtenez le filet de Lethtendris.‡获得蕾瑟塔蒂丝的网。‡取得蕾瑟塔蒂絲之網',
  }
},
[27109] = {
  {
    'O defensor tortuoso‡Криводрев-защитник‡Windschiefe Verteidiger‡뒤틀린 수호정령‡El defensor alabeado‡El defensor alabeado‡Le défenseur redimensionné‡扭曲的防御者‡被扭曲的守護者',
    nil,
    'Mate Gavíneo Lenhatorta.‡Убейте Тендриса Криводрева.‡Tötet Tendris Wucherborke.‡굽이나무 텐드리스를 처치해야 합니다.‡Mata a Tendris Alabeo.‡Mata a Tendris Alabeo.‡Tuez Tendris Crochebois.‡杀死特迪斯·扭木。‡殺死特迪斯·扭木。',
  }
},
[27110] = {
  {
    'A loucura intrínseca‡Древнее безумие‡Der innere Wahnsinn‡내면의 광기‡Locura interior‡Locura interior‡Folie intérieure‡伊莫塔尔的疯狂‡伊莫塔爾的瘋狂',
    nil,
    'Mate os guardiões que cercam os cinco pilares de força da Prisão de Immol\'thar. Quando os pilares se desligarem, o campo de força que cerca Immol\'thar se dissipará.|n|nDestrua o terrível demônio que fica no coração da Prisão de Immol\'thar. Por fim, enfrente o Príncipe Tortheldrin, no Ateneu.|n|nFale novamente com a Anciã Shen\'dralar, no pátio, após completar a missão.‡Уничтожьте стражей, охраняющих пять пилонов, которые снабжают энергией тюрьму Бессмер\'тера. Это позволит рассеять силовое поле.|n|nВойдите в тюрьму Бессмер\'тера и уничтожьте заключенного в ней демона. После этого убейте принца Тортелдрина в читальне.|n|nВыполнив задание, вернитесь во внутренний двор и поговорите с прародительницей Шен\'дралар.‡Zerstört alle Wächter, die um die 5 Pylonen herumstehen, welche Immol\'thars Gefängnis mit Energie versorgen Sobald die Pylone deaktiviert wurden, wird sich das Kraftfeld, das Immol\'thar umgibt, auflösen.|n|nBetretet Immol\'thars Gefängnis und vernichtet den verdorbenen Dämonen. Zum Schluss müsst Ihr Prinz Tortheldrin im Athenaeum entgegentreten.|n|nKehrt nach Abschluss der Aufgabe zur uralten Shen\'dralar im Hof zurück.‡이몰타르의 감옥에 힘을 공급하는 다섯 개의 수정탑을 둘러싼 수호자들을 처치해야 합니다. 수정탑의 마력이 약해지면 이몰타르를 둘러싼 마법진도 분산될 것입니다.|n|n이몰타르의 감옥에 들어가 그 심장부에 서 있는 사악한 이몰타르를 처치하고, 마지막으로 도서관에 있는 토르텔드린 왕자와 맞서 싸우십시오.|n|n이 임무를 완수하면 명가의 궁정에 있는 셴드랄라 고대인에게 가야 합니다.‡Debes destruir a los guardianes que rodean las 5 torres que dan energía a la prisión de Immol\'thar. Cuando las torres se hayan desactivado, el campo de fuerza que rodea a Immol\'thar se disipará.|n|nEntra en la prisión de Immol\'thar y extermina al vil demonio que se encuentra en su interior. Por último, enfréntate al príncipe Tortheldrin en el Athenaeum.|n|nVuelve con el ancestro Shen\'dralar en el patio si completas esta misión.‡Debes destruir a los guardianes que rodean las 5 torres que dan energía a la prisión de Immol\'thar. Cuando las torres se hayan desactivado, el campo de fuerza que rodea a Immol\'thar se disipará.|n|nEntra en la prisión de Immol\'thar y extermina al vil demonio que se encuentra en su interior. Por último, enfréntate al príncipe Tortheldrin en el Athenaeum.|n|nVuelve con el ancestro Shen\'dralar en el patio si completas esta misión.‡Vous devez détruire les gardiens qui protègent les 5 Pylônes qui alimentent la Prison d’Immol’thar. Une fois que les Pylônes seront coupés, le champ de force qui entoure Immol’thar se dissipera.|n|nEntrez dans la Prison d’Immol’thar et éradiquez l’infâme démon qui se trouve en son cœur. Enfin, affrontez le prince Tortheldrin à l’Athenaeum.|n|nLorsque vous aurez terminé, retournez voir l’Ancienne des Shen’dralar dans la cour.‡你必须消灭5座水晶塔周围的守卫，那5座水晶塔维持着关押伊莫塔尔的监狱。一旦水晶塔的能量被削弱，伊莫塔尔周围的能量力场就会消散。|n|n进入伊莫塔尔的监狱，干掉站在中间的那个恶魔。最后，在图书馆挑战托塞德林王子。|n|n当任务完成之后，到庭院中去找辛德拉古灵。‡你必須解決五座水晶塔周圍的守護者們，這些水晶塔為伊莫塔爾的牢籠供給了能量。一旦水晶塔的能量中斷，環繞伊莫塔爾的力場也將消散。|n|n進入伊莫塔爾的牢籠並消滅在中心處的殘忍惡魔，再回到圖書館與托塞德林王子交手。|n|n完成任務之後，回去庭院裡找辛德拉古靈。',
  }
},
[27111] = {
  {
    'O tesouro de Shen\'dralar‡Сокровище Шен\'дралар‡Der Schatz der Shen\'dralar‡셴드랄라의 보물‡El tesoro de los Shen\'dralar‡El tesoro de los Shen\'dralar‡Le trésor des Shen\'dralar‡辛德拉的宝藏‡辛德拉的寶藏',
    nil,
    'Volte ao Ateneu e encontre o Tesouro de Shen\'dralar. Reclame sua recompensa!‡Вернитесь в читальню и найдите сокровище Шен\'дралар, а затем потребуйте свою награду.‡Kehrt in das Athenaeum zurück und sucht den Schatz der Shen\'dralar. Nehmt Euch Eure Belohnung!‡도서관으로 되돌아가 셴드랄라의 보물을 찾아야 합니다. 임무 완수에 대한 보상을 받으십시오!‡Vuelve a El Athenaeum y encuentra el tesoro de los Shen\'dralar. ¡Reclama tu recompensa!‡Vuelve a El Athenaeum y encuentra el tesoro de los Shen\'dralar. ¡Reclama tu recompensa!‡Retournez à l’Athenaeum et trouvez le Trésor des Shen’dralar. Prenez votre récompense !‡返回图书馆去找到辛德拉的宝藏。拿取你的奖励吧！‡回到圖書館並找到辛德拉的寶藏。取得你的獎賞!',
  }
},
[27112] = {
  {
    'Maldito restolho‡Проклятые призраки‡Verfluchte Überreste‡남겨진 저주받은 자들‡Los restos malditos‡Los restos malditos‡Les restes maudits‡被诅咒的灵魂‡殘留的受詛咒者',
    nil,
    'Mate o Magíster Kalendris e Illyanna Corvalho.‡Убейте магистра Календриса и Иллиану Вороний Дуб.‡Tötet Magister Kalendris und Illyanna Rabeneiche.‡마법학자 칼렌드리스와 일리아나 레이븐오크를 처치해야 합니다.‡Mata al magister Kalendris y a Illyanna Roblecuervo.‡Mata al magister Kalendris y a Illyanna Roblecuervo.‡Tuez le Magistère Kalendris et Illyanna Corvichêne.‡杀死卡雷迪斯镇长和伊琳娜·暗木。‡殺死博學者卡雷迪斯和伊琳娜·鴉橡。',
  }
},
[27113] = {
  {
    'A anciã Shen\'dralar‡Прародительница Шен\'дралар‡Der Uralte Shen\'dralar‡셴드랄라 고대인‡El ancestro Shen\'dralar‡El ancestro Shen\'dralar‡L\'ancienne des Shen’dralar‡辛德拉古灵‡辛德拉古靈',
    nil,
    'Fale com a anciã Shen\'dralar.‡Поговорите с прародительницей Шен\'дралар.‡Sprecht mit dem Uralten Shen\'dralar.‡셴드랄라 고대인과 대화해야 합니다.‡Habla con el ancestro Shen\'dralar.‡Habla con el ancestro Shen\'dralar.‡Parlez à l\'Ancienne des Shen’dralar.‡与辛德拉古灵交谈。‡和辛德拉古靈說話。',
  }
},
[27114] = {
  {
    'O teste de sabor dos Gordok‡Лучшее пойло Гордока‡Der Gordokgeschmackstest‡고르독 술 맛보기‡La cata de los Gordok‡La cata de los Gordok‡La dégustation gordok‡戈多克好酒‡戈多克好酒',
