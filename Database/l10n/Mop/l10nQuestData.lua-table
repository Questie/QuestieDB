},
[7494] = {
  {
    'Domínio de Plumaluna‡Крепость Оперенной Луны‡Die Mondfederfeste‡페더문 요새‡Bastión Plumaluna‡Bastión Plumaluna‡Le bastion de Pennelune‡羽月要塞‡羽月要塞',
    nil,
    'Fale com Latrônicus Lunalança no Domínio de Plumaluna, em Feralas.‡Поговорите с Латроникусом Лунным Копьем в Крепости Оперенной Луны в Фераласе.‡Sprecht mit Latronicus Mondspeer in der Mondfederfeste in Feralas.‡페랄라스의 페더문 요새에 있는 라트로니쿠스 문스피어와 대화해야 합니다.‡Habla con Latronicus Lanzaluna. Lo encontrarás en el Bastión Plumaluna de Feralas.‡Habla con Latronicus Lanzaluna. Lo encontrarás en el Bastión Plumaluna de Feralas.‡Parlez à Latronicus Lancelune au bastion de Pennelune en Féralas.‡和菲拉斯羽月要塞的拉托尼库斯·月矛谈一谈。‡和菲拉斯羽月要塞的拉托尼庫斯·月矛談話。',
  }
},
[7495] = {
  {
    'Vitória pela Aliança‡Славная победа Альянса‡Sieg für die Allianz‡얼라이언스의 승리‡Victoria para la Alianza‡Victoria para la Alianza‡Victoire pour l\'Alliance !‡联盟的胜利‡聯盟的勝利',
    nil,
    'Entregue a Cabeça da Onyxia para o Rei Varian Wrynn em Ventobravo.‡Отнесите голову Ониксии королю Вариану Ринну в Штормград.‡Bringt Onyxias Kopf zu König Varian Wrynn in Sturmwind.‡오닉시아의 머리를 스톰윈드로 갖고 가서 국왕 바리안 린에게 보여줘야 합니다.‡Lleva la cabeza de Onyxia al rey Varian Wrynn en Ventormenta.‡Lleva la cabeza de Onyxia al rey Varian Wrynn en Ventormenta.‡Apportez la Tête d’Onyxia au roi Varian Wrynn à Hurlevent.‡将奥妮克希亚的徽记交给暴风城的瓦里安·乌瑞恩国王。‡將奧妮克希亞的頭顱交給暴風城的瓦里安·烏瑞恩國王。',
  }
},
[7496] = {
  {
    'Celebrar os bons tempos‡Праздник добрых времен‡Gute Zeiten feiern‡대축제‡Celebrar los buenos momentos‡Celebrar los buenos momentos‡Célébrer le triomphe‡英雄庆典‡英雄慶典',
    nil,
    'Procure o Major Valadão no Vale dos Heróis.‡Найдите майора Маттингли на Аллее Героев.‡Sucht Major Mattingly im Tal der Helden auf.‡영웅의 계곡에서 상사 매팅리를 찾아야 합니다.‡Busca al mayor Mattingly en el Valle de los Héroes.‡Busca al mayor Mattingly en el Valle de los Héroes.‡Allez voir le major Mattingly dans la vallée des Héros.‡在英雄谷找到玛丁雷少校。‡在英雄谷找到瑪丁雷少校。',
  }
},
