[24730] = {
  {
    'Osso duro de roer‡Игра в кости‡Knochenklappern‡뼈 수집‡Choca esos huesos‡Choca esos huesos‡Faites rouler les os‡挖骨头‡挖骨頭',
    nil,
    'Consiga 8 Ossos de Dinossauro.‡Добудьте 8 костей динозавров.‡Besorgt 8 Dinosaurierknochen.‡공룡 뼈 8개를 모아야 합니다.‡Consigue 8 huesos de dinosaurio.‡Consigue 8 huesos de dinosaurio.‡Obtenez 8 Os de dinosaure.‡收集8根恐龙骨头。‡收集8塊恐龍骨頭。',
  }
},
[24731] = {
  {
    'A dieta de Lar\'korwi‡Добыча Лар\'корви‡Lar\'korwis Mahl‡라르코르위의 먹이‡La comida de Lar\'korwi‡La comida de Lar\'korwi‡La nourriture de Lar\'korwi‡拉克维的食物‡拉克維的食物',
    nil,
    'Encontre a carcaça mais recente de uma presa morta por Lar\'korwi e roube um Pedaço de Carcaça de Manguadonte.‡Найдите последнюю добычу Лар\'корви и украдите часть трупа жесткозуба.‡Sucht das Gerippe von Lar\'korwis letzter Jagdbeute und stehlt einen Teil eines Dreschadongerippes.‡라르코르위가 막 잡은 사냥감을 찾아 트레샤돈 시체 덩이를 훔쳐야 합니다.‡Encuentra los restos de una presa fresca de Lar\'korwi y roba un trozo de trillanodonte muerto.‡Encuentra los restos de una presa fresca de Lar\'korwi y roba un trozo de trillanodonte muerto.‡Trouvez la carcasse de la dernière proie tuée par Lar’korwi et volez un Morceau de carcasse d’un battrodon.‡找到拉克维刚刚猎杀的动物的尸体，从尸体上偷取一块蛇颈龙肉块。‡尋找拉克維最新的捕獲物並從裡面偷拿一塊蛇頸龍的肉。',
  }
},
[24732] = {
  {
    'O olfato de Lar\'korwi‡Запах Лар\'корви‡Lar\'korwis Fährte‡라르코르위의 냄새‡Un aroma irresistible para Lar\'korwi‡Un aroma irresistible para Lar\'korwi‡Un parfum pour Lar\'korwi‡拉克维的气味‡拉克維的氣味',
    nil,
    'Consiga 2 Glândulas de Feromônio de Ravassauro.‡Добудьте 2 феромонные железы равазавра.‡Besorgt 2 Pheromondrüsen eines Ravasaurus.‡라바사우루스 페로몬샘 2개를 모아야 합니다.‡Consigue 2 glándulas de feromonas de ravasaurio.‡Consigue 2 glándulas de feromonas de ravasaurio.‡Obtenez 2 Glandes de phéromone de ravasaure.‡收集2份暴掠龙信息素。‡收集2條暴掠龍的費洛蒙腺。',
  }
},
[24733] = {
  {
    'A isca para Lar\'korwi‡Приманка для Лар\'корви‡Ein Köder für Lar\'korwi‡라르코르위를 위한 미끼‡El cebo para Lar\'korwi‡El cebo para Lar\'korwi‡Un appât pour Lar\'korwi‡拉克维的诱饵‡拉克維的誘餌',
    nil,
    'Use o conteúdo do Bornal do Torwa para evocar Lar\'korwi e derrotá-lo. Então, leve a Cabeça do Lar\'korwi para Torwa Mateiro, que está perto da entrada da Cratera Un\'Goro.‡С помощью предметов из мешочка Торвы выманите Лар\'корви и сразите его. Принесите голову Лар\'корви землепроходцу Торве ко входу в Кратер Ун\'Горо.‡Beschwört Lar\'korwi mit dem Inhalt von Torwas Beutel und besiegt ihn. Bringt dann Lar\'korwis Kopf zu Torwa Pfadfinder in der Nähe des Eingangs zum Krater von Un\'Goro.‡토르와의 주머니에 든 물건들로 라르코르위를 불러내 물리친 후 라르코르위의 머리를 운고로 분화구 입구에 있는 토르와 패스파인더에게 가져가야 합니다.‡Utiliza el contenido de la faltriquera de Torwa para atraer la presencia de Lar\'korwi y derrótalo. Después llévale la cabeza de Lar\'korwi a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Utiliza el contenido de la faltriquera de Torwa para atraer la presencia de Lar\'korwi y derrótalo. Después llévale la cabeza de Lar\'korwi a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Faites se manifester Lar’korwi grâce au contenu de la Sacoche de Torwa et tuez-le. Ensuite, apportez la Tête de Lar’korwi à Torwa le Guide, près de l’entrée du Cratère d’Un’Goro.‡使用托尔瓦的麻袋中的东西召唤拉克维并打败它。将拉克维的头颅交给安戈洛环形山入口处的托尔瓦·寻路者。‡使用托爾瓦的麻袋中的東西召喚拉克維並打敗牠。將拉克維的頭顱交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[24734] = {
  {
    'Perdido!‡Потерялся!‡Verloren!‡실종 사건!‡¡Perdido!‡¡Perdido!‡Perdu !‡走丢了！‡走丟了!',
    nil,
    'Encontre algum sinal do Ringo no Pico Penacho de Fogo.‡Найдите следы Ринго у Вулкана Огненного Венца.‡Sucht nach Hinweisen auf Ringo am Feuersäulengrat.‡불기둥 마루에서 링고의 흔적을 찾아야 합니다.‡Encuentra las señales de Ringo en la Cresta del Penacho en Llamas.‡Encuentra las señales de Ringo en la Cresta del Penacho en Llamas.‡Trouvez la trace de Ringo à la Crête de la fournaise.‡在火羽山寻找林格的下落。‡在火羽山找到關於林格的線索。',
  }
},
[24735] = {
  {
    'O calor tá de matar‡Дружеская помощь‡Etwas Hilfe von guten Freunden‡내 친구의 작은 도움‡Un poco de ayuda de mis amigos‡Un poco de ayuda de mis amigos‡Un peu d\'aide de mes amis‡朋友的帮助‡朋友的幫助',
    nil,
    'Conduza o Ringo até Espraga Froque, no Posto Avançado do Marshal.|n|nSe o Ringo se sentir fraco, dê um tapa nele. Se ele desmaiar, use o Cantil da Espraga para reanimá-lo.‡Отведите Ринго к Муче Кусора на заставу Маршалла. |n|nЕсли ему станет нехорошо, похлопайте его по щекам. Если Ринго потеряет сознание, плесните на него воды из фляги Мучи, чтобы привести его в чувство.‡Führt Ringo zu Spraggel Frock in Marschalls Wehr.|n|nFalls Ringo schwach werden sollte, gebt ihm eine Ohrfeige. Falls er ohnmächtig werden sollte, verwendet Spraggels Feldflasche, um ihn zu beleben.‡마샬의 격전지에 있는 스프래글 프록에게 링고를 데려가야 합니다.|n|n링고가 약해지면 뺨을 때리고, 기절하면 스프래글의 수통을 사용해 깨워야 합니다.‡Lleva a Ringo con Spraggle Frock en el Alto de Marshal.|n|nSi Ringo se siente débil, abofetéalo. Si se desmaya, utiliza la cantimplora de Spraggle para revivirlo.‡Lleva a Ringo con Spraggle Frock en el Alto de Marshal.|n|nSi Ringo se siente débil, abofetéalo. Si se desmaya, utiliza la cantimplora de Spraggle para revivirlo.‡Amenez Ringo jusqu’à Spraggle Frock, au Camp retranché des Marshal.|n|nSi Ringo faiblit, giflez-le. S’il tourne de l’œil, utilisez la Gourde de Spraggle pour lui faire reprendre connaissance.‡把林格带回马绍尔哨站的斯普拉格·弗劳克身边。|n|n如果林格变得虚弱，就抽他耳光，如果林格晕倒了，就用斯普拉格的水壶让他恢复。‡把林格帶回馬紹爾營地的斯普拉格·弗勞克身邊。|n|n果林格感到虛弱，就打他一巴掌。如果林格暈倒了，就用斯普拉格的水壺讓他恢復。',
  }
},
[24736] = {
  {
    'O Chislo quer voar!‡Крылолет Шиззла‡Sappalots Flieger‡쉬즐의 비행선‡El aparato volador de Shizzle‡El aparato volador de Shizzle‡La machine volante de Shizzle‡希兹尔的飞行器‡希茲爾的飛行器',
    nil,
    'Consiga 35 Escamas de Pterrordax Palmado.‡Соберите 35 чешуй перепончатого терродактиля.‡Sammelt 35 Membranschuppen eines Pterrordax\'.‡갈퀴 달린 테러닥스 비늘 35개를 모아야 합니다.‡Recoge 35 escamas de pterrordáctilo palmeadas.‡Recoge 35 escamas de pterrordáctilo palmeadas.‡Collectez 35 Ecailles étoilées de pterreurdactyle.‡收集35块精细的翼手龙鳞片。‡收集35個精細的翼手龍鱗片。',
  }
},
[24737] = {
  {
    'Supergrudento‡Суперлипучка‡Superkleber‡초강력 접착제‡Superpegajoso‡Superpegajoso‡Ultra collant‡极度粘稠‡超級粘瀝青',
    nil,
    'Consiga 8 amostras de Piche Supergrudento.‡Соберите 8 образцов сверхлипкой смолы.‡Sammelt 8 Proben superklebrigen Teers.‡매우 끈적거리는 타르 견본을 8개 모아야 합니다.‡Reúne 8 muestras de alquitrán muy pegajoso.‡Reúne 8 muestras de alquitrán muy pegajoso.‡Collectez 8 échantillons de Goudron ultra collant.‡收集8份极度粘稠的沥青。‡收集8塊極度粘稠的瀝青。',
  }
},
[24738] = {
  {
    '‡Дневник Вилидена‡Willidens Tagebuch‡윌리덴의 일지‡Diario de Williden‡Diario de Williden‡Le journal de Williden‡威利德的日记‡',
    nil,
    '‡Верните дневник Виллидену Маршаллу, который находится где-то в Кратере Ун\'Горо.‡Bringt das Tagebuch zu Williden Marschall zurück. Er befindet sich irgendwo im Krater von Un\'Goro.‡운고로 분화구 어딘가에 있는 윌리덴 마샬에게 일지를 전해야 합니다.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Rapporter le Journal à Williden Marshal quelque part dans le Cratère d\'Un\'Goro.‡将日记还给安戈洛环形山中的威利德·马绍尔。‡',
  }
},
[24739] = {
  {
    '‡Спасение экспедиции‡Rettungsexpedition‡원정대 구조‡Salvar a la expedición‡Salvar a la expedición‡Le sauvetage de l\'expédition‡抢救物资‡',
    nil,
    '‡Принесите ящик с провизией и исследовательское оборудование Виллидену Маршаллу в Кратер Ун\'Горо.‡Bringt eine Kiste mit Nahrungsmitteln und Forscherausrüstung zu Williden Marschall im Krater von Un\'Goro.‡식량 상자와 탐사장비를 운고로 분화구에 있는 윌리덴 마샬에게 가져가야 합니다.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Apporter une Caisse de nourriture et de l\'Équipement de recherche à Williden Marshal dans le Cratère d\'Un\'Goro.‡将食物箱和研究设备交给安戈洛环形山的威利德·马绍尔。‡',
  }
},
[24740] = {
  {
    'Atividade vulcânica‡Вулканическая активность‡Vulkanische Aktivität‡화산 활동‡Actividad volcánica‡Actividad volcánica‡Activité volcanique‡火山活动‡火山的活動',
    nil,
    'Consiga 9 amostras das Cinzas de Un\'Goro dos elementais de fogo ao redor do vulcão da Cratera Un\'Goro.‡Добудьте 9 образцов пепла Ун\'Горо из элементалей огня, что водятся вокруг вулкана в Кратере Ун\'Горо.‡Sammelt 9 Proben der Asche von Un\'Goro von den Feuerelementaren am Vulkan im Krater von Un\'Goro.‡운고로 분화구의 화산 근처에 있는 정령에게서 운고로 재 견본 9개를 모아야 합니다.‡Recoge 9 muestras de cenizas de Un\'Goro de los elementales de fuego que están alrededor del volcán en el Cráter de Un\'Goro.‡Recoge 9 muestras de cenizas de Un\'Goro de los elementales de fuego que están alrededor del volcán en el Cráter de Un\'Goro.‡Collectez 9 échantillons de Cendres d\'Un\'Goro sur les Élémentaires de feu autour du volcan du Cratère d\'Un\'Goro.‡从安戈洛环形山火山口附近的火焰元素身上收集9份安戈洛灰烬样本。‡到安戈洛環形山的火山附近，從火元素身上取得9個安戈洛灰燼樣本。',
  }
},
[24741] = {
  {
    'Ovos novos‡Обмен с довеском‡Ein guter Tausch‡물물교환‡Dar el cambiazo‡Dar el cambiazo‡Un échange en notre faveur‡以小换大‡交易',
    nil,
    'Colete 5 Ovos de Raptor Espinhoso.‡Добудьте 5 яиц костлявых ящеров.‡Sammelt 5 Eier eines stacheligen Raptors.‡가시 랩터 알 5개를 모아야 합니다.‡Reúne 5 huevos de raptor espinoso.‡Reúne 5 huevos de raptor espinoso.‡Rassemblez 5 Œufs de raptor épineux.‡收集5枚骨刺迅猛龙蛋。‡收集5顆多刺迅猛龍蛋。',
  }
},
[24742] = {
  {
    'Morno... morno... quente...‡Найти источник‡Die Quelle finden‡앗! 뜨거!‡Busca la fuente‡Busca la fuente‡À la recherche de la source‡究根问底‡究根問底',
    nil,
    'Gualter, na Cratera Un\'Goro, quer que você encontre a área mais quente do Pico Penacho de Fogo.|n|nSempre que você encontrar um ponto quente, use o termômetro para medir a temperatura. Procure até encontrar o mais quente de todos.‡Выясните, где находится точка с самой высокой температурой на Вулкане Огненного Венца, по просьбе Кракла из Кратера Ун\'Горо.|n|nКогда найдете жаркую точку, воспользуйтесь термометром, чтобы узнать ее температуру. Проверяйте все горячие точки, пока не будет обнаружена точка с самой высокой температурой.‡Krakle im Krater von Un\'Goro möchte, dass Ihr den heißesten Bereich des Feuersäulengrats findet.|n|nImmer, wenn Ihr eine heiße Stelle findet, benutzt das Thermometer, um die Temperatur zu überprüfen. Sucht, bis Ihr die heißeste Stelle gefunden habt.‡운고로 분화구에 있는 크래클이 불기둥 마루에서 가장 뜨거운 지점을 찾도록 부탁했습니다.|n|n뜨거운 열점을 찾을 때마다 온도계측장치를 오른쪽 클릭해 온도를 재십시오. 가장 뜨거운 열점을 찾을 때까지 계속 재야 합니다.‡Krakle del Cráter de Un\'Goro quiere que encuentres los puntos más calientes de la Cresta del Penacho en Llamas. |n|nCuando encuentres un punto caliente, utiliza el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el más caliente.‡Krakle del Cráter de Un\'Goro quiere que encuentres los puntos más calientes de la Cresta del Penacho en Llamas. |n|nCuando encuentres un punto caliente, utiliza el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el más caliente.‡Krakle, au Cratère d’Un’Goro, veut que vous trouviez la zone la plus chaude de la Crête de la Fournaise.|n|nQuand vous trouvez un point chaud, utilisez le thermomètre pour en mesurer la température. Continuez vos relevés jusqu’à trouver le point le plus chaud.‡安戈洛尔环形山的克拉兰克要你去找到火羽山中温度最高的地方。|n|n当你找到一个看上去很热的地方时，就使用温度计来测量当地的温度。不断尝试，直到你找到温度最高的地方。‡安戈洛環形山的克拉蘭克要你找出火羽山最熱的地點。|n|n發現一個熱點後，使用溫度計來檢查溫度。持續尋找，直到你發現最熱的地點為止。',
  }
},
[24743] = {
  {
    'O Limiar das Sombras‡Грань Тьмы‡Schattenschneide‡어둠의 칼날도끼‡El Filo de las Sombras‡El Filo de las Sombras‡Tranchant de l\'ombre‡影锋‡暗影之鋒',
    nil,
    nil,
  }
},
[24744] = {
  {
    'O maior ovo de todos os tempos‡Мегаяйцо‡Das größte Ei aller Zeiten‡세상에서 제일 큰 알‡El huevo más grande del mundo‡El huevo más grande del mundo‡Le plus gros œuf du monde‡史上第一巨蛋‡世上最大的蛋',
    nil,
    'Recupere o Maior Ovo de Todos os Tempos.‡Добудьте мегаяйцо.‡Besorgt Euch das größte Ei aller Zeiten.‡세상에서 제일 큰 알을 구해야 합니다.‡Recupera el huevo más grande del mundo.‡Recupera el huevo más grande del mundo.‡Ramasser le Plus gros œuf du monde.‡取回史上第一巨蛋。‡取得世上最大的蛋。',
  }
},
[24745] = {
  {
    'Algo está no ar (e não é o amor)‡Не любовь витает в воздухе (а что-то иное!)‡Irgendwas liegt in der Luft (und Liebe ist es nicht)‡사랑은 아니지만, 무언가 특별한 분위기에 휩싸여‡Hay algo en el aire (y no es amor)‡Hay algo en el aire (y no es amor)‡Il y a quelque chose dans l\'air (et ce n\'est pas de l\'amour)‡微妙的气氛（肯定不是爱）‡微妙的氣氛(肯定不是愛)',
    nil,
    'Entregue o Adorável Cartão Esmaecido para o Inspetor Estrilo Garrafuso em Ventobravo.‡Принесите выцветшую открытку ко дню всех влюбленных инспектору Кромсу Гвоздезубу в Штормград.‡Bringt die vergilbte schöne Grußkarte zu Inspektor Snip Schnappbolz in Sturmwind.‡빛 바랜 아름다운 카드를 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가져가야 합니다.‡Llévale la tarjeta preciosa descolorida al inspector Snap Tuerceganzúas en Ventormenta.‡Llévale la tarjeta preciosa descolorida al inspector Snap Tuerceganzúas en Ventormenta.‡Rapportez la Ravissante carte de vœux décolorée à l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡将褪色的情人节卡片交给暴风城的探员斯尼普·滑栓。‡把褪色的可愛邀請卡拿給暴風城的巡官史尼卜·凸栓。',
  }
},
[24746] = {
  {
    'REUSE‡REUSE‡REUSE‡재사용‡REUSE‡REUSE‡RÉUTILISER‡REUSE‡重複利用',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[24747] = {
  {
    'Sabotagem!‡Диверсия!‡Sabotage!‡대폭발!‡¡Sabotaje!‡¡Sabotaje!‡Sabotage !‡搞破坏！‡惡意破壞!',
    nil,
    'Sabote uma Ogiva de Artilharia Enânica e saia de Bael\'Dun antes que ela exploda.‡Подготовьте все для взрыва дворфийского артиллерийского снаряда и бегите подальше от Бейл\'дана, пока снаряд не взорвался.‡Sabotiert eine zwergische Artilleriegranate und flüchtet dann aus Bael\'dun bevor es explodiert.‡드워프 포탄을 조작한 다음 폭발하기 전에 바엘던에서 탈출해야 합니다.‡Sabotea una carcasa de artillería enana y huye de Bael\'Dun antes de que explote.‡Sabotea una carcasa de artillería enana y huye de Bael\'Dun antes de que explote.‡Sabotez un Obus d’artillerie nain et échappez-vous de Bael’Dun avant que tout n’explose.‡破坏一枚矮人炮弹，在它爆炸前逃离巴尔丹。‡引發1枚矮人砲彈，然後在它爆炸前從巴爾丹逃跑。',
  }
},
[24748] = {
  {
    'O último recurso do Lich Rei‡Последняя битва Короля-лича‡Das letzte Gefecht des Lichkönigs‡리치 왕, 그 최후의 저항‡La última batalla del Rey Exánime‡La última batalla del Rey Exánime‡Le dernier rempart du roi-liche‡巫妖王最后的阵地‡巫妖王的末日',
    nil,
    'O Grão-lorde Dárion Mograine, na Cidadela da Coroa de Gelo, quer que você mate o Lich Rei.‡Верховный лорд Дарион Могрейн приказал вам убить Короля-лича.‡Hochlord Darion Mograine in der Eiskronenzitadelle will, dass Ihr den Lichkönig tötet.‡얼음왕관 성채에 있는 대영주 다리온 모그레인이 리치 왕을 처치하라고 했습니다.‡El Alto señor Darion Mograine, en la Ciudadela de la Corona de Hielo, quiere que mates al Rey Exánime.‡El Alto señor Darion Mograine, en la Ciudadela de la Corona de Hielo, quiere que mates al Rey Exánime.‡Le Généralissime Darion Mograine, à la Citadelle de la Couronne de glace, vous a demandé de tuer le Roi-liche.‡冰冠堡垒中的大领主达里安·莫格莱尼希望你去消灭巫妖王。‡大領主莫格萊尼要你去冰冠城塞殺掉巫妖王。',
  }
},
[24749] = {
  {
    'Infusão profana‡Сила нечестивости‡Erfüllt mit unheiliger Macht‡부정 주입‡Infusión profana‡Infusión profana‡Infusion d\'impie‡注入邪恶‡穢邪之能',
    nil,
    'O Grão-lorde Dárion Mograine quer que você infunda o Limiar das Sombras no Poder Profano e, em seguida, mate o Professor Putricida.|n|nEsta missão só pode ser concluída no modo de 25 pessoas da Cidadela da Coroa de Gelo.‡Верховный лорд Дарион Могрейн приказал вам наполнить Грань Тьмы силой нечестивости и убить профессора Мерзоцида.|n|nЭто задание можно выполнить только в рейде для 25 игроков в Цитадели Ледяной Короны.‡Hochlord Darion Mograine möchte, dass Ihr Schattenschneide mit unheiliger Macht erfüllt und Professor Seuchenmord tötet.|n|nDiese Quest kann nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle abgeschlossen werden.‡대영주 다리온 모그레인이 어둠의 칼날도끼에 부정의 힘을 주입하고 교수 퓨트리사이드를 처치하라고 했습니다.|n|n이 퀘스트는 얼음왕관 성채 25인 난이도에서만 완료할 수 있습니다.‡El Alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con poder profano y mates al profesor Putricidio.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores en la Ciudadela de la Corona de Hielo.‡El Alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con poder profano y mates al profesor Putricidio.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores en la Ciudadela de la Corona de Hielo.‡Le Généralissime Darion Mograine veut que vous infusiez Tranchant de l\'ombre avec de la puissance Impie et que vous abattiez le Professeur Putricide.|n|nCette quête peut uniquement être effectuée en mode 25 joueurs de la Citadelle de la Couronne de glace.‡大领主达里安·莫格莱尼要你用邪恶能量灌注影锋，并杀死普崔塞德教授。|n|n该任务只能在冰冠堡垒25人模式下完成。‡大領主莫格萊尼要你為暗影之鋒注入穢邪威能，並且殺掉普崔希德教授。|n|n此任務只能夠在25人模式的冰冠城塞中完成。',
  }
},
[24750] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡El levantamiento de los Lanza Negra‡L\'ascension des Sombrelances‡暗矛的崛起‡暗矛中興',
    nil,
    'Fale com Soratha no Campo de Treinamento Lançanegra.‡Найдите Сорату на тренировочной площадке Черного Копья.‡Trefft Soratha auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 소라타를 만나야 합니다.‡Reúnete con Soratha en el Campo de Entrenamiento Lanza Negra.‡Reúnete con Soratha en el Campo de Entrenamiento Lanza Negra.‡Allez voir Soratha sur le Terrain d’entraînement des Sombrelances.‡与暗矛训练场中的索拉萨谈谈。‡在暗矛訓練場和索拉薩碰面。',
  }
},
[24751] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Ziele treffen‡기본기: 연타‡A golpe de entrenamiento‡A golpe de entrenamiento‡La base : savoir frapper des trucs‡基础教程：攻击目标‡基本原則:攻擊',
    nil,
    'Destrua 6 Alvos Carrancas.‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다.‡Destruye 6 dianas Tiki.‡Destruye 6 dianas Tiki.‡Détruire 6 Cibles Tiki.‡摧毁6个蒂基面具假人。‡摧毀6個訓練假人。',
  }
},
[24752] = {
  {
    'A arte do mago‡Искусство мага‡Die Künste eines Magiers‡마법사의 기술‡Las artes del mago‡Las artes del mago‡Les arts du mage‡法师的技艺‡法師之藝',
    nil,
    'Fale com Soratha para treinar os Mísseis Arcanos. Pratique os Mísseis Arcanos 2 vezes em um Alvo Carranca.‡Поговорите с Соратой и потренируйтесь в освоении заклинания "Чародейские стрелы". Затем 2 раза испытайте это заклинание на манекенах-тики.‡Redet mit Soratha, um \'Arkane Geschosse\' zu erlernen. Wendet den Zauber zweimal bei einem Tikiziel an.‡소라타와 대화하여 신비한 화살을 배운 다음, 티키 표적에 신비한 화살을 2번 사용하여 연습해야 합니다.‡Habla con Soratha para aprender Misiles Arcanos. Usa Misiles Arcanos 2 veces contra una diana Tiki.‡Habla con Soratha para aprender Misiles Arcanos. Usa Misiles Arcanos 2 veces contra una diana Tiki.‡Parlez à Soratha pour apprendre Projectiles des Arcanes. Entraînez-vous en lançant Projectile des arcanes à 2 reprises sur une Cible Tiki.‡与索拉萨交谈，进行奥术飞弹的训练。然后对一个蒂基面具假人施放2次奥术飞弹。‡與索拉薩談話來訓練秘法飛彈。在訓練假人身上使用2次秘法飛彈。',
  }
},
[24753] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡Un duro comienzo‡Un début difficile‡粗暴的开始‡艱難的開始',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste.‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 회수해야 합니다.‡Consigue 6 pelajes de gato Ferocrín.‡Consigue 6 pelajes de gato Ferocrín.‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡取得6份蠻鬃山貓皮。',
  }
},
[24754] = {
  {
    'Fosso da prova‡Яма испытаний‡Grube der Bewährung‡시험의 구덩이‡Foso de pruebas‡Foso de pruebas‡La fosse de l\'épreuve‡试炼场‡試煉場',
    nil,
    'Fale com o Carcereiro Lançanegra, depois entre no fosso da prova e mate um Batedor Escamas Odiosas Cativo.‡Поговорите с тюремщиком Черного Копья, а затем спуститесь в яму испытаний и убейте пленного разведчика из клана Злобной Чешуи.‡Redet mit einem Gefängnisaufseher der Dunkelspeere, betretet dann die Grube der Bewährung und besiegt einen gefangenen Späher der Gallschuppen.‡검은창 교도관과 대화한 다음, 시험의 구덩이로 들어가 사로잡힌 원한비늘 정찰병을 처치해야 합니다.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Parlez à un Geôlier sombrelance, puis descendez dans la fosse de l\'épreuve et tuez un Éclaireur Vexécaille captif.‡同暗矛狱卒交谈，然后进入试炼场，杀死一名恶鳞斥候俘虏。‡和一名暗矛獄卒談話，然後進入試煉場殺死一名被俘虜的惡鱗斥候。',
  }
},
[24755] = {
  {
    'Melhor do que o esperado‡Превосходя ожидания‡Mehr als erwartet‡기대 이상‡Mejor de lo esperado‡Mejor de lo esperado‡Mieux que prévu‡喜出望外‡超乎預期',
    nil,
    'Apresente-se a Vol\'jin na Cidadela dos Lançanegra.‡Поговорите с Вол\'джином в крепости Черного Копья.‡Meldet Euch bei Vol\'jin in der Dunkelspeerfeste.‡검은창 요새에 있는 볼진에게 보고해야 합니다.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Présentez-vous à Vol\'jin au Bastion des Sombrelances.‡向暗矛要塞中的沃金报到。‡到暗矛要塞向沃金回報。',
  }
},
[24756] = {
  {
    'Infusão sanguinária‡Сила крови‡Erfüllt mit der Macht des Blutes‡혈기 주입‡Infusión de sangre‡Infusión de sangre‡Infusion de sang‡鲜血灌注‡血魄之能',
    nil,
    'O Grão-lorde Dárion Mograine quer que você infunda o Limiar das Sombras em sangue e derrote a Rainha Lana\'thel.|n|nEsta missão só pode ser concluída no modo de 25 pessoas da Cidadela da Coroa de Gelo.‡Верховный лорд Дарион Могрейн приказал вам наполнить Грань Тьмы силой крови и убить королеву Лана\'тель.|n|nЭто задание можно выполнить только в рейде для 25 игроков в Цитадели Ледяной Короны.‡Hochlord Darion Mograine möchte, dass Ihr Schattenschneide mit der Macht des Blutes erfüllt und Blutkönigin Lana\'thel besiegt.|n|nDiese Quest kann nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle abgeschlossen werden.‡대영주 다리온 모그레인이 어둠의 칼날도끼에 혈기를 주입하고 여왕 라나텔을 처치하라고 했습니다.|n|n이 퀘스트는 얼음왕관 성채 25인 난이도에서만 완료할 수 있습니다.‡El alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con sangre y que acabes con la reina Lana\'thel.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡El alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con sangre y que acabes con la reina Lana\'thel.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡Le Généralissime Darion Mograine veut que vous infusiez Tranchant de l\'ombre avec du sang et que vous battiez la Reine Lana\'thel.|n|nCette quête peut uniquement être effectuée en mode 25 joueurs de la Citadelle de la Couronne de glace.‡大领主达里安·莫格莱尼要你使用鲜血灌注影锋，并击败鲜血女王兰娜瑟尔。|n|n该任务只能在25人难度的冰冠堡垒中完成。‡大領主莫格萊尼要你為暗影之鋒注入血魄的力量，並且擊敗菈娜薩爾女王。|n|n此任務只能夠在25人模式的冰冠城塞中完成。',
  }
},
[24757] = {
  {
    'Infusão gélida‡Сила льда‡Erfüllt mit der Macht des Frostes‡냉기 주입‡Infusión de Escarcha‡Infusión de Escarcha‡Infusion de givre‡冰霜灌注‡冰霜之能',
    nil,
    'O Grão-lorde Dárion Mograine quer que você mate Sindragosa depois de receber 4 baforadas, sem morrer, enquanto empunha o Limiar das Sombras.|n|nEsta missão só pode ser concluída no modo de 25 pessoas da Cidadela da Coroa de Gelo.‡Верховный лорд Дарион Могрейн приказал вам четыре раза попасть под действие ледяного дыхания Синдрагосы, держа при себе Грань Тьмы, после чего убить дракона.|n|nЭто задание можно выполнить только в рейде для 25 игроков в Цитадели Ледяной Короны.‡Hochlord Darion Mograine hat Euch den Auftrag erteilt, Sindragosa zu töten, nachdem Ihr 4-mal ihren Atemattacken ausgesetzt wart, während Ihr Schattenschneide führt.|n|nDiese Quest kann nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle abgeschlossen werden.‡대영주 다리온 모그레인이 어둠의 칼날도끼를 사용하면서 신드라고사의 숨결 공격을 4번 견딘 다음 처치하라고 했습니다.|n|n이 퀘스트는 얼음왕관 성채 25인 난이도에서만 완료할 수 있습니다.‡El Alto señor Darion Mograine te ha ordenado que mates a Sindragosa tras sobrevivir a 4 de sus ataques de aliento mientras blandes el Filo de las Sombras.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡El Alto señor Darion Mograine te ha ordenado que mates a Sindragosa tras sobrevivir a 4 de sus ataques de aliento mientras blandes el Filo de las Sombras.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡Le Généralissime Darion Mograine vous a donné l\'ordre de tuer Sindragosa après avoir subi vous-même 4 de ses attaques de souffle tout en utilisant Tranchant de l\'ombre.|n|nCette quête peut uniquement être effectuée en mode 25 joueurs de la Citadelle de la Couronne de glace.‡大领主达里安·莫格莱尼对你做出了指示，他要你在使用影锋与辛达苟萨战斗时，经受住辛达苟萨的四次气息攻击，然后再杀死她。|n|n该任务只能在25人难度的冰冠堡垒中完成。‡大領主莫格萊尼命令你去殺掉辛德拉苟莎，並且在佩帶暗影之鋒的期間，承受4次冰霜吐息攻擊。|n|n此任務只能夠在25人模式的冰冠城塞中完成。',
  }
},
[24758] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡El levantamiento de los Lanza Negra‡L\'ascension des Sombrelances‡暗矛的崛起‡暗矛中興',
    nil,
    'Fale com Nekali no Campo de Treinamento Lançanegra.‡Повстречайтесь с Некали на тренировочной площадке Черного Копья.‡Trefft Nekali auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 네칼리를 만나야 합니다.‡Reúnete con Nekali en el Campo de Entrenamiento Lanza Negra.‡Reúnete con Nekali en el Campo de Entrenamiento Lanza Negra.‡Allez voir Nekali sur le Terrain d’entraînement des Sombrelances.‡与暗矛训练场中的奈卡利谈谈。‡在暗矛訓練場和內卡利碰面。',
  }
},
[24759] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Dinge schlagen‡기본기: 연타‡A golpe de entrenamiento‡A golpe de entrenamiento‡La base : savoir frapper des trucs‡基础教程：攻击目标‡基本原則:攻擊',
    nil,
    'Destrua 6 Alvos Carrancas.‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다.‡Destruye 6 dianas Tiki.‡Destruye 6 dianas Tiki.‡Détruire 6 Cibles Tiki.‡摧毁6个蒂基面具假人。‡摧毀6個訓練假人。',
  }
},
[24760] = {
  {
    'A arte do xamã‡Искусство шамана‡Die Kunst des Schamanen‡주술사의 기술‡Las artes del chamán‡Las artes del chamán‡Les arts du chaman‡萨满祭司的技艺‡薩滿之藝',
    nil,
    'Fale com Nekali para treinar Golpe Primevo. Use Golpe Primevo 3 vezes em um Alvo Carranca.‡Поговорите с Некали и потренируйтесь в освоении "Стихийного удара". Затем 3 раза испытайте "Стихийный удар" на манекенах-тики.‡Redet mich Nekali, um \'urtümlicher Schlag\' zu lernen. Wendet den Zauber dreimal bei einem Tikiziel an.‡네칼리와 대화하여 원시의 일격을 배운 다음, 티키 표적에 원시의 일격을 3번 사용하여 연습해야 합니다.‡Habla con Nekali para aprender Golpe primigenio. Usa Golpe primigenio 3 veces contra una diana Tiki.‡Habla con Nekali para aprender Golpe primigenio. Usa Golpe primigenio 3 veces contra una diana Tiki.‡Parlez à Nekali pour apprendre Frappe primordiale. Utilisez Frappe primordiale 3 fois sur une cible tiki.‡与奈卡利交谈，进行根源打击的训练。然后对一个蒂基面具假人使用3次根源打击。‡與內卡利談話來訓練原始之擊。在訓練假人身上使用3次原始之擊。',
  }
},
[24761] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡Un duro comienzo‡Un début difficile‡粗暴的开始‡艱難的開始',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste.‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 회수해야 합니다.‡Consigue 6 pelajes de gato Ferocrín.‡Consigue 6 pelajes de gato Ferocrín.‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡取得6份蠻鬃山貓皮。',
  }
},
[24762] = {
  {
    'Fosso da prova‡Яма испытаний‡Grube der Bewährung‡시험의 구덩이‡Foso de pruebas‡Foso de pruebas‡La fosse de l\'épreuve‡试炼场‡試煉場',
    nil,
    'Fale com o Carcereiro Lançanegra, depois entre no fosso da prova e mate um Batedor Escamas Odiosas Cativo.‡Поговорите с тюремщиком Черного Копья, а затем спуститесь в яму испытаний и убейте пленного разведчика из клана Злобной Чешуи.‡Redet mit einem Gefängnisaufseher der Dunkelspeere, betretet dann die Grube der Bewährung und besiegt einen gefangenen Späher der Gallschuppen.‡검은창 교도관과 대화한 다음, 시험의 구덩이로 들어가 사로잡힌 원한비늘 정찰병을 처치해야 합니다.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Parlez à un Geôlier sombrelance, puis descendez dans la fosse de l\'épreuve et tuez un Éclaireur Vexécaille captif.‡同暗矛狱卒交谈，然后进入试炼场，杀死一名恶鳞斥候俘虏。‡和一名暗矛獄卒談話，然後進入試煉場殺死一名被俘虜的惡鱗斥候。',
  }
},
[24763] = {
  {
    'Melhor do que o esperado‡Превосходя ожидания‡Mehr als erwartet‡기대 이상‡Mejor de lo esperado‡Mejor de lo esperado‡Mieux que prévu‡喜出望外‡超乎預期',
    nil,
    'Apresente-se a Vol\'jin na Cidadela dos Lançanegra.‡Поговорите с Вол\'джином в крепости Черного Копья.‡Meldet Euch bei Vol\'jin in der Dunkelspeerfeste.‡검은창 요새에 있는 볼진에게 보고해야 합니다.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Présentez-vous à Vol\'jin au Bastion des Sombrelances.‡向暗矛要塞中的沃金报到。‡到暗矛要塞向沃金回報。',
  }
},
[24764] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡El levantamiento de los Lanza Negra‡L\'ascension des Sombrelances‡暗矛的崛起‡暗矛中興',
    nil,
    'Fale com Zen\'tabra no Campo de Treinamento Lançanegra.‡Найдите Зен\'табру на тренировочной площадке Черного Копья.‡Trefft Zen\'Tabra auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 젠타브라를 만나야 합니다.‡Reúnete con Zen\'tabra en el Campo de Entrenamiento Lanza Negra.‡Reúnete con Zen\'tabra en el Campo de Entrenamiento Lanza Negra.‡Allez voir Zen\'Tabra sur le Terrain d’entraînement des Sombrelances.‡与暗矛训练场中的岑塔布拉谈谈。‡在暗矛訓練場和贊塔布拉碰面。',
  }
},
[24765] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Dinge schlagen‡기본기: 연타‡A golpe de entrenamiento‡A golpe de entrenamiento‡La base : savoir frapper des trucs‡基础教程：攻击目标‡基本原則:攻擊',
    nil,
    'Destrua 6 Alvos Carrancas.‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다.‡Destruye 6 dianas Tiki.‡Destruye 6 dianas Tiki.‡Détruire 6 Cibles Tiki.‡摧毁6个蒂基面具假人。‡摧毀6個訓練假人。',
  }
},
[24766] = {
  {
    'A arte do druida‡Искусство друида‡Die Kunst des Druiden‡드루이드의 기술‡Las artes del druida‡Las artes del druida‡Les arts du druide‡德鲁伊的技艺‡德魯伊之藝',
    nil,
    'Fale com Zen\'tabra para treinar Rejuvenescer. Pratique Rejuvenescer em 1 Vigia Lançanegra Ferido no Campo de Treinamento Lançanegra.‡Поговорите с Зен\'таброй и потренируйтесь в применении "Омоложения", а затем воспользуйтесь этим заклинанием, чтобы помочь раненому дозорному Черного Копья на тренировочной площадке Черного Копья.‡Redet mit Zen\'tabra, um \'Verjüngung\' zu erlernen. Übt den Zauber an einer verwundeten Wache der Dunkelspeere beim Übungsgelände der Dunkelspeere.‡젠타브라와 대화하여 회복을 배운 다음, 검은창 훈련장 주위에 있는 부상당한 검은창 감시병에게 회복을 사용하여 연습해야 합니다.‡Habla con Zen\'Tabra para aprender Rejuvenecimiento. Practica Rejuvenecimiento con un vigilante Lanza Negra herido en el Campo de Entrenamiento Lanza Negra.‡Habla con Zen\'Tabra para aprender Rejuvenecimiento. Practica Rejuvenecimiento con un vigilante Lanza Negra herido en el Campo de Entrenamiento Lanza Negra.‡Parlez à Zen\'Tabra pour apprendre Récupération. Entraînez-vous à utiliser Récupération sur un Guetteur sombrelance blessé au Terrain d\'entraînement des Sombrelances.‡与岑塔布拉交谈，进行回春术的训练。然后对暗矛训练场一带受伤的暗矛卫士施放回春术。‡向贊塔布拉學習回春術。對暗矛訓練場附近的受傷的暗矛看守者身上使用回春術。',
  }
},
[24767] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡Un duro comienzo‡Un début difficile‡粗暴的开始‡艱難的開始',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste.‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 회수해야 합니다.‡Consigue 6 pelajes de gato Ferocrín.‡Consigue 6 pelajes de gato Ferocrín.‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡取得6份蠻鬃山貓皮。',
  }
},
[24768] = {
