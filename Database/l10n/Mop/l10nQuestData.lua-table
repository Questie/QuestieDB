[32669] = {
  {
    'Aprender a montar‡Уроки верховой езды‡Lernt Reiten‡타는 법 배우기‡A montar se ha dicho‡‡Un cavalier débutant‡学习骑乘‡',
    nil,
    'Encontre Kildar. Uma‡Найдите Кильдара. это‡Findet Kildar.‡킬다르를 찾아야 합니다. 레벨 10‡Encuentra a Kildar.‡‡Trouvez Kildar.‡找到基尔达。‡',
  }
},
[32670] = {
  {
    'Aprender a montar‡Уроки верховой езды‡Lernt Reiten‡타는 법 배우기‡A montar se ha dicho‡‡Un cavalier débutant‡学习骑乘‡',
