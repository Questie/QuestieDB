},
[1884] = {
  {
    'Pilhas de ju-ju‡Груды джуджу‡Jujuhaufen‡주주 해골‡Montones de Ju-Ju‡Montones de Ju-Ju‡Les Tas de Ju-Ju‡魂能骨堆‡魂能骨堆',
    nil,
    'Destrua 4 Pilhas de Ju-Ju, depois fale novamente com Un\'Thuwa na Aldeia Sen\'jin.‡Уничтожьте 4 груды джуджу и вернитесь к Ун\'Туве из деревни Сен\'джин.‡Zerstört 4 Jujuhaufen und kehrt dann zu Un\'thuwa in Sen\'jin zurück.‡주주 해골 4개를 파괴하고 센진 마을에 있는 운투와에게 가야 합니다.‡Destruye 4 montones de Ju-Ju y vuelve con Un\'thuwa en Poblado Sen\'jin.‡Destruye 4 montones de Juju y vuelve con Un\'thuwa en Poblado Sen\'jin.‡Détruire 4 Tas de Ju-Ju, puis retourner voir Un\'thuwa au village de Sen\'jin.‡摧毁4个魂能骨堆，然后向森金村的安苏瓦汇报。‡摧毀4個魂能骨堆，然後向森金村的安蘇瓦彙報。',
  }
},
[1885] = {
  {
    'Júnio Aquino‡Меннит Каркад‡Mennet Carkad‡메넷 칼카드‡Mennet Carkad‡Mennet Carkad‡Mennet Carkad‡米奈特·卡加德‡米奈特·卡加德',
    nil,
    'Fale com Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Поговорите с Меннитом Каркадом в Квартале Разбойников Подгорода.‡Sprecht mit Mennet Carkad im Schurkenviertel von Unterstadt.‡언더시티의 도적 지구에 있는 메넷 칼카드와 대화해야 합니다.‡Habla con Mennet Carkad en el Barrio de los Pícaros de Entrañas.‡Habla con Mennet Carkad en el Barrio de los Pícaros de Entrañas.‡Aller voir Mennet Carkad dans le Quartier des Voleurs de Fossoyeuse.‡与幽暗城潜行者区的米奈特·卡加德谈一谈。‡與幽暗城盜賊區的米奈特·卡加德談話。',
  }
},
[1886] = {
  {
    '‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡亡灵哨兵‡亡靈哨兵',
    nil,
    '‡Принесите рекомендательное письмо Астора Менниту Каркаду в Квартал Разбойников Подгорода.‡Beschafft Astors Vorstellungsschreiben und bringt es zu Mennet Carkad im Schurkenviertel.‡‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, en el Barrio de los Pícaros.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, en el Barrio de los Pícaros.‡Trouver la Lettre de recommandation d\'Astor et l\'apporter à Mennet Carkad dans le Quartier des Voleurs.‡得到阿斯托的介绍信，并将其交给潜行者区的米奈特·卡加德。‡',
  }
},
[1898] = {
  {
    '‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡死亡杀手‡亡靈哨兵',
    nil,
    '‡Поговорите с Андроном Гантом в Подгороде.‡Sprecht mit Andron Gant in Unterstadt.‡‡Habla con Andron Gant en Entrañas.‡Habla con Andron Gant en Entrañas.‡Aller voir Andron Gant à Fossoyeuse.‡与幽暗城的安德隆·甘特交谈。‡',
  }
},
[1899] = {
  {
    '‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡死亡杀手‡亡靈哨兵',
    nil,
    '‡Отнесите гроссбух Андрона Менниту Каркаду в Квартал Разбойников Подгорода.‡Bringt Androns Geschäftsbuch zu Mennet Carkad im Schurkenviertel von Unterstadt.‡‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Apporter le Grand Livre d\'Andron à Mennet Carkad dans le Quartier des Voleurs de Fossoyeuse.‡将阿斯托的的账本交给幽暗城盗贼区的米奈特·卡加德。‡',
  }
},
[1918] = {
  {
    'O elemento conspurcado‡Оскверненная стихия‡Das beschmutzte Element‡타락한 정령‡El elemento contaminado‡El elemento contaminado‡Les éléments souillés‡被污染的水元素‡被污染的水元素',
    nil,
    'Entregue o Globo d\'Água Conspurcado a Mastok Wrilehiss no Posto Machadada, no Vale Gris.‡Отнесите оскверненную водяную сферу Мастоку Райльшипу на заставу Расщепленного Дерева в Ясеневый лес.‡Bringt die beschmutzte Wasserkugel zu Mastok Wutfauch im Splitterholzposten im Eschental.‡잿빛 골짜기 토막나무 주둔지에 있는 마스토크 윌리히스에게 더럽혀진 물구슬을 가져가야 합니다.‡Llévale el globo de agua contaminada a Mastok Bufido en el Puesto del Hachazo, Vallefresno.‡Llévale el globo de agua contaminada a Mastok Bufido en el Puesto del Hachazo, Vallefresno.‡Apportez le Globe d\'eau souillée à Mastok Torvesiffle, au Poste de Bois-Brisé, en Orneval.‡将被污染的水球交给灰谷碎木哨岗的马斯托克·维尔西斯。‡將被污染的水球帶去梣谷的碎木崗哨交給馬斯托克·維爾西斯。',
  }
},
[1919] = {
  {
    'Jana tem uma missão‡Задание Джиннии‡Meldung bei Jennea‡제니아에게 보고‡Preséntate ante Jennea‡Preséntate ante Jennea‡Rendre compte à Jennea‡向詹妮亚报告‡向詹妮亞報告',
    nil,
    'Fale com Jana Catão em Ventobravo.‡Поговорите с Джиннией Пушкой в Штормграде.‡Sprecht in Sturmwind mit Jennea Haubitz.‡스톰윈드에 있는 제니아 캐논과 대화해야 합니다.‡Habla con Jennea Cañón en Ventormenta.‡Habla con Jennea Cañón en Ventormenta.‡Parler à Jennea Cannon à Hurlevent.‡和暴风城的詹妮亚·坎农谈一谈。‡和暴風城的詹妮亞·坎農談談。',
  }
},
[1920] = {
  {
    'Investigue o Recôndito Azulego‡Печальный отшельник‡Untersuchungen im Blauen Eremiten‡고독한 은둔자 선술집 조사‡Investiga lo que pasa en El Ermitaño Taciturno‡Investiga lo que pasa en El Ermitaño Taciturno‡Trouver le Solitaire bleu‡调查蓝色隐士‡調查藍色隱士',
    nil,
    'Obtenha um Cantochão da Manifestação e um Baú de Cofres de Contenção atrás de Jana Catão. Leve 3 Cofres de Contenção Cheios para Jana no Sacrário dos Teurgos.‡Возьмите свиток заклятия Проявления и ящик с шкатулками-духоловками за спиной у Джиннии Пушки. Принесите 3 заполненных шкатулки-духоловки Джиннии в Башню магов.‡Nehmt Euch die Inkantation der Manifestation und die Truhe mit Verwahrungskästen vom Tisch, hinter Jennea Haubitz. Bringt 3 gefüllte Verwahrungskästen zu Jennea im Magiersanktum.‡제니아 캐논의 뒤에 있는 현신의 주문서와 속박의 상자를 획득하십시오. 마법사의 성소에 있는 제니아에게 채워진 속박의 상자 3개를 가져가야 합니다.‡Detrás de Jennea Cañón encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas a Jennea, en el Sagrario del Mago.‡Detrás de Jennea Cañón encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas a Jennea, en el Sagrario del Mago.‡Obtenir un Chant de manifestation et une Caisse de coffres de retenue placée derrière Jennea Cannon. Apporter 3 Coffres de retenue remplis à Jennea Cannon au Sanctuaire du sorcier.‡从詹妮亚·坎农身后拿取一根显形卷轴以及一盒封灵箱。将3个装满的封灵箱交给巫师圣殿里的詹妮亚·坎农。‡從詹妮亞·坎農身後拿取一根顯形卷軸以及一盒封靈箱。將3個裝滿的封靈箱交給巫師聖所裡的詹妮亞·坎農。',
  }
},
[1921] = {
  {
    'Em busca de materiais‡Сбор материалов‡Materialsammlung‡재료 수집‡Recolección de materiales‡Recolección de materiales‡Rassembler les matériaux‡收集原料‡收集原料',
    nil,
    'Leve 10 peças de Linho e as 6 Gemas Energizadas da Fenda para Manoela Galante em Ventobravo.‡Отнесите 10 кусков льна и 6 заряженных самоцветов Расселины Уинн Ларсон в Штормград.‡Bringt 10 Leinenstoff und 6 aufgeladene Rissedelsteine zu Wynne Larson in Sturmwind.‡스톰윈드에 있는 위니 라슨에게 리넨 옷감 10장과 충만한 균열석 6개를 가져가야 합니다.‡Consigue 10 paños de lino y 6 gemas cargadas de la falla para Wynne Larson en Ventormenta.‡Consigue 10 paños de lino y 6 gemas cargadas de la falla para Wynne Larson en Ventormenta.‡Apporter 10 morceaux d\'Etoffe de lin et 6 Gemmes chargées de la faille à Wynne Larson à Hurlevent.‡把10匹亚麻布和6颗充能裂隙宝石交给暴风城的维恩·拉尔森。‡把10匹亞麻布和6顆充能裂隙寶石交給暴風城的威恩·拉爾森。',
  }
},
[1938] = {
  {
    'Tratado de Ur sobre Umbromancia‡Трактат Ура по темной магии‡Urs Abhandlung über Schattenmagie‡우르의 흑마법 논문‡Tratado de Ur sobre la Magia de las Sombras‡Tratado de Ur sobre la Magia de las Sombras‡Traité d\'Ur sur la Magie des Ombres‡乌尔的暗影魔法研究论文‡烏爾的暗影魔法研究論文',
    nil,
    'Entregue o Tratado de Ur sobre Umbromancia ao Grão-feiticeiro Andromath em Ventobravo.‡Принесите Трактат Ура по темной магии верховному колдуну Андромату из Штормграда.‡Bringt \'Urs Abhandlung über Schattenmagie\' zu Zaubermeister Andromath in Sturmwind.‡스톰윈드에 있는 고위마술사 안드로매스에게 우르의 흑마법 논문을 가져가야 합니다.‡Lleva el Tratado de Ur sobre la Magia de las Sombras al sumo hechicero Andromath en Ventormenta.‡Lleva el Tratado de Ur sobre la Magia de las Sombras al sumo hechicero Andromath en Ventormenta.‡Apporter le « Traité d\'Ur sur la magie des Ombres » au Grand Sorcier Andromath à Hurlevent.‡将《乌尔的暗影魔法研究论文》交给暴风城的高阶巫师安多玛斯。‡將《烏爾的暗影魔法研究論文》交給暴風城的高階巫士安多瑪斯。',
  }
},
[1939] = {
  {
    'Grão-feiticeiro Andromath‡Верховный колдун Андромат‡Zaubermeister Andromath‡고위마술사 안드로매스‡Sumo Hechicero Andromath‡Sumo Hechicero Andromath‡Grand sorcier Andromath‡高阶巫师安多玛斯‡高階巫士安多瑪斯',
    nil,
    'Fale com o Grão-Feiticeiro Andromath.‡Поговорите с верховным колдуном Андроматом.‡Sprecht mit Zaubermeister Andromath.‡고위마술사 안드로매스와 대화해야 합니다.‡Habla con el sumo hechicero Andromath.‡Habla con el sumo hechicero Andromath.‡Aller voir le Grand Sorcier Andromath.‡和高阶巫师安多玛斯谈一谈。‡和高階巫士安多瑪斯談話。',
  }
},
[1940] = {
  {
    'Seda pura de aranha‡Безупречная паутина‡Makellose Spinnenseide‡온전한 거미줄‡Seda prístina de araña‡Seda prístina de araña‡Soie d\'araignée en parfait état‡新鲜的蜘蛛丝‡新鮮的蜘蛛絲',
    nil,
    'Leve 8 Sedas Puras de Aranha para Manoela Galante em Ventobravo.‡Принесите 8 кусков безупречной паутины Уинн Ларсон в Штормград.‡Bringt 8 Rollen makelloser Spinnenseide zu Wynne Larson in Sturmwind.‡스톰윈드에 있는 위니 라슨에게 온전한 거미줄 8개를 가져가야 합니다.‡Lleva 8 sedas prístinas de araña a Wynne Larson en Ventormenta.‡Lleva 8 sedas prístinas de araña a Wynne Larson en Ventormenta.‡Apporter 8 Soies d\'araignée en parfait état à Wynne Larson à Hurlevent.‡找到8束新鲜的蜘蛛丝，把它们交给暴风城的维恩·拉尔森。‡找到8束新鮮的蜘蛛絲，把它們交給暴風城的威恩·拉爾森。',
  }
},
