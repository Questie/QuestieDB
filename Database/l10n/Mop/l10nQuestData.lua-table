[6721] = {
  {
    '‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡',
    nil,
    '‡Поговорите с Дазаларом в Доланааре, что в Тельдрассиле.‡Sprecht mit Dazalar in Dolanaar in Teldrassil.‡‡Habla con Dazalar en Dolanaar, en Teldrassil.‡Habla con Dazalar en Dolanaar, en Teldrassil.‡Parler à Dazalar, à Dolanaar, en Teldrassil.‡与泰达希尔的多兰纳尔的达扎拉谈一谈。‡',
  }
},
[6722] = {
  {
    '‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡',
    nil,
    '‡Поговорите с Дазаларом в Доланааре, что в Тельдрассиле.‡Sprecht mit Dazalar in Dolanaar in Teldrassil.‡‡Habla con Dazalar en Dolanaar, en Teldrassil.‡Habla con Dazalar en Dolanaar, en Teldrassil.‡Parler à Dazalar, à Dolanaar, en Teldrassil.‡与多兰纳尔的达扎拉谈一谈。‡',
