[26895] = {
  {
    'A Cúpula do Trovão!‡Громодром!‡Die Donnerkuppel!‡천둥경기장으로!‡¡El Truenódromo!‡¡El Truenódromo!‡Le dôme du Tonnerre !‡雷霆斗技场！‡雷霆競技場!',
    nil,
    'Fale com o Doutor Asnamanga em Geringontzan.‡Поговорите с доктором Верняком в Прибамбасске.‡Sprecht in Gadgetzan mit Doktor Haudenlukas.‡가젯잔에 있는 박사 딜웰과 대화해야 합니다.‡Habla con el doctor Tratabién en Gadgetzan.‡Habla con el doctor Tratabién en Gadgetzan.‡Allez voir le Docteur La Négoce à Gadgetzan.‡跟加基森的狄奥维奥博士谈一谈。‡到加基森找幹得好博士說話。',
  }
},
[26896] = {
  {
    'A Cúpula do Trovão!‡Громодром!‡Die Donnerkuppel!‡천둥경기장으로!‡¡El Truenódromo!‡¡El Truenódromo!‡Le dôme du Tonnerre !‡雷霆斗技场！‡雷霆競技場',
    nil,
    'Fale com o Doutor Asnamanga em Geringontzan.‡Поговорите с доктором Верняком в Прибамбасске.‡Sprecht in Gadgetzan mit Doktor Haudenlukas.‡가젯잔에 있는 박사 딜웰과 대화해야 합니다.‡Habla con el doctor Tratabién en Gadgetzan.‡Habla con el doctor Tratabién en Gadgetzan.‡Allez voir le Docteur La Négoce à Gadgetzan.‡跟加基森的狄奥维奥博士谈一谈。‡到加基森找幹得好博士說話。',
