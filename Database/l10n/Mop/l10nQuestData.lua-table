[28775] = {
  {
    'Estatueta de serpente quebrada‡Разбитая статуэтка змеи‡Zerbrochene Schlangenfigur‡부서진 뱀 조각상‡Figurilla de serpiente rota‡Figurilla de serpiente rota‡La figurine de serpent cassée‡破损的毒蛇雕像‡破損的毒蛇刻像',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários.‡Почините разбитую статуэтку, применив необходимые умения и материалы.‡Repariert die zerbrochene Figur mithilfe Eurer Fertigkeit und den richtigen Materialien.‡보석세공 기술과 적절한 재료로 부서진 조각상을 수리해야 합니다.‡Repara la figurilla rota con tu habilidad y materiales.‡Repara la figurilla rota con tu habilidad y materiales.‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡用你的技巧與材料來修復破損的刻像。',
  }
},
[28776] = {
  {
    'Estatueta terrena quebrada‡Разбитая статуэтка земельника‡Zerbrochene Figur eines Irdenen‡부서진 대지 수호자 조각상‡Figurilla terránea rota‡Figurilla terránea rota‡La figurine de terrestre cassée‡破损的土灵雕像‡破損的土靈刻像',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários.‡Почините разбитую статуэтку, применив необходимые умения и материалы.‡Repariert die zerbrochene Figur mithilfe Eurer Fertigkeit und den richtigen Materialien.‡보석세공 기술과 적절한 재료로 부서진 조각상을 수리해야 합니다.‡Repara la figurilla rota con tu habilidad y materiales.‡Repara la figurilla rota con tu habilidad y materiales.‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡用你的技巧與材料來修復破損的刻像。',
  }
},
[28777] = {
  {
    'Estatueta de coruja quebrada‡Разбитая статуэтка совы‡Beschädigte Figur einer Eule‡부서진 올빼미 조각상‡Figurilla de búho rota‡Figurilla de búho rota‡La figurine de chouette cassée‡破损的猫头鹰雕像‡破損的貓頭鷹刻像',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários.‡Почините разбитую статуэтку, применив необходимые умения и материалы.‡Repariert die zerbrochene Figur mithilfe Eurer Fertigkeit und den richtigen Materialien.‡보석세공 기술과 적절한 재료로 부서진 조각상을 수리해야 합니다.‡Repara la figurilla rota con tu habilidad y materiales.‡Repara la figurilla rota con tu habilidad y materiales.‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡用你的技巧與材料來修復破損的刻像。',
