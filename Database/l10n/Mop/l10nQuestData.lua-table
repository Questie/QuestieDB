  }
},
[28905] = {
  {
    'Heroica Aleatória Diária (1a.) (Cataclismo)‡Daily Heroic Random (1st) (Cataclysm)‡Täglicher zufälliger, heroischer Dungeon (Erster) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡随机英雄日常 （第一次）（大地的裂变）‡Daily Heroic Random (1st) (Cataclysm)',
    nil,
