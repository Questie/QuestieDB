[30225] = {
  {
    'A Matriarca Teiacinza‡Матриарх пепельных пауков‡Tod der Glutnetzmatriarchin‡잿빛그물 여왕거미‡La matriarca Telaceniza‡‡La matriarche cendretoile‡‡',
    nil,
    'Mate Aguilhão Sangrento, a Matriarca Teiacinza. Uma‡Убейте Кроволапку, матриарха пепельных пауков.‡Tötet Blutspitz, die Glutnetzmatriarchin.‡잿빛그물 여왕거미, 피돌기를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a Picasangre, la matriarca Telaceniza.‡‡Tuez Pointe-sanglante, la Matriarche cendretoile.‡‡',
  }
},
[30226] = {
  {
    'Sangue no Elevado‡Кровь на руинах‡Das Blut erhebt sich‡‡Sangre en lo alto‡‡Du sang sur la cime‡高地之血‡',
    nil,
    'Mate 8 mogus Shao-Tien perto do Elevado da Ruína. Uma‡Убейте 8 могу Шао-Тень на Возвышающихся руинах.‡Tötet 8 Shao-Tien-Mogu auf der Ruinenerhebung.‡‡Mata a 8 mogu Shao-Tien en el Alto de la Ruina.‡‡Tuez 8 Mogu shao-tien sur la Cime des Ruines.‡在遗迹高地击败8个韶天魔古族人。‡',
  }
},
[30227] = {
  {
    'Wulon, a Sentinela de Granito‡Гранитный страж Улунь‡Wulon der Granitwächter‡화강암 파수꾼, 우론‡Wulon, el Centinela de Granito‡‡Wulon, la sentinelle de granit‡‡',
    nil,
    'Mate Wulon, a Sentinela de Granito. Uma‡Убейте гранитного стража Улуня.‡Tötet Wulon den Granitwächter.‡화강암 파수꾼, 우론을 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a Wulon, Centinela de Granito.‡‡Tuez Wulon, la sentinelle de granit.‡‡',
  }
},
[30228] = {
  {
    'Problemas pra quem os causa‡Как смутить смутьянов‡Unruhe unter den Unruhestiftern stiften‡말썽꾼과 말썽 빚기‡Alborotar a los alborotadores‡‡Lutter contre les lutins‡以暴制暴‡',
    nil,
    'Mate 8 Trasgos Litocasca. Uma‡Убейте 8 духов Каменной Коры.‡Tötet 8 Steinborkentrickster.‡돌나무껍질 요마 8마리를 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a 8 duendes Cortezapiedra.‡‡Tuez 8 Lutins écorcepierre.‡击败8个石树林精。‡',
  }
},
[30229] = {
  {
    'O perigo maior‡Великая опасность‡Die große Gefahr‡더 큰 위험‡El mayor peligro‡‡Le plus grand des dangers‡更大的危险‡',
    nil,
    'Mate 8 Recuperadores de Korja. Uma‡Убейте 8 искателей из Корцзя.‡Tötet 8 Korjanieroberer.‡코르잔 수복병 8명을 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 8 reivindicadores Korjani.‡‡Tuez 8 Récupérateurs korjani.‡击败8个科夏复国者。‡',
  }
},
[30230] = {
  {
    'Re-recuperação‡Кто-то теряет, кто-то находит‡Erneute Zurückeroberung‡재수복‡Re-reivindicación‡‡Re-réclamation‡重夺神器‡',
    nil,
    'Recupere 10 Artefatos Mogus. Uma‡Соберите 10 артефактов могу.‡Beschafft 10 Moguartefakte.‡모구 유물을 10개 찾아야 합니다. 레벨 15 크라사랑 밀림‡Recupera 10 artefactos mogu.‡‡Récupérez 10 Artéfacts mogu.‡找回10件魔古神器。‡',
  }
},
[30231] = {
  {
    'Colheita de romãs‡Сбор тыблок‡Pomfruchtlieferung‡석류사과 줍기‡Recogida de pomas‡‡Récolte de pommettes‡捡梨果‡',
    nil,
    'Junte 12 Romãs. Uma‡Соберите 12 тыблок.‡Erntet 12 Pomfrüchte.‡석류사과 12개를 모아야 합니다. 레벨 30 영원꽃 골짜기‡Recoge 12 pomas.‡‡Ramassez 12 Pommettes.‡收集12个梨果。‡',
  }
},
[30232] = {
  {
    'Uma harpia incomoda muita gente‡Взъерошить перышки‡Spitze Federn‡나풀나풀 깃털‡Entre plumas‡‡Traite de plumes‡收集鹰羽‡',
    nil,
    'Colete 80 Penas Sedosas. Uma‡Соберите 80 шелковых перьев.‡Sammelt 80 seidige Federn.‡비단 깃털 80개를 모아야 합니다. 레벨 30 영원꽃 골짜기‡Hazte con 80 plumas sedosas.‡‡Récupérez 80 Plumes soyeuses.‡收集80根丝滑羽毛。‡',
  }
},
[30233] = {
  {
    'Estaladonte‡Хрустозуб‡Knackzahn‡‡Crujecolmillos‡‡Crachecroc‡裂齿‡',
    nil,
    'Mate Estaladonte. Uma‡Убейте Хрустозуба.‡Tötet Knackzahn.‡‡Mata a Crujecolmillos.‡‡Tuez Crachecroc.‡击败裂齿。‡',
  }
},
[30234] = {
  {
    'Boca-de-alicate‡Злобнохап‡Zangenkiefer‡무쇠턱‡Quijasaña‡‡Mâchevice‡钳颚‡',
    nil,
    'Mate Boca-de-alicate e devolva o Cajado Longo de Ren. Uma‡Убейте Злобнохапа и добудьте посох Рена.‡Tötet Zangenkiefer und bringt Rens Langstab zurück.‡무쇠턱을 처치하고 런의 긴지팡이를 되찾아야 합니다. 레벨 1 영원꽃 골짜기‡Acaba con Quijasaña y devuelve a Ren su bastón.‡‡Tuez Mâchevice et rendez son Bâton long à Ren.‡击败钳颚并取回任的长棍。‡',
  }
},
[30235] = {
  {
    'Quid pro quo‡Склизкий тип‡Krakwall‡주고받기‡Cadozo, compórtate‡‡Quid pro quo‡‡',
    nil,
    'Derrote Quid, o Espírito da Cachoeira das Brumas. Uma‡Победите Склизня, духа Туманного водопада.‡Besiegt Kwall, den Geist der Nebelfälle.‡안개 낀 폭포의 정령, 퀴드를 물리쳐야 합니다. 레벨 1 영원꽃 골짜기‡Derrota a Cadozo, el espíritu de las Cataratas de Niebla.‡‡Battez Quid, l’esprit de Tombe-Brume.‡‡',
  }
},
[30236] = {
  {
    'Aetha‡Айта‡Aetha‡애타‡Aetha‡‡Aetha‡‡',
    nil,
    'Derrote Aetha, o Espírito dos Ventos Dourados. Uma‡Победите Айту, духа Золотых ветров.‡Besiegt Aetha, den Geist der Goldenen Winde.‡금빛 바람의 정령, 애타를 꺾어야 합니다. 레벨 1 영원꽃 골짜기‡Derrota a Aetha, el Espíritu de los Vientos Dorados.‡‡Battez Aetha, l’esprit des vents dorés.‡‡',
  }
},
[30237] = {
  {
    'Revivendo o Levante dos Pandarens‡Восставшие духи пандаренов‡Der ewige Aufstand der Pandaren‡판다렌 봉기를 상기하라‡Revuelta pandaren 2.0‡‡Souvenir du soulèvement pandaren‡重现：熊猫人起义‡',
    nil,
    'Mate 8 Espíritos Mogus Ancestrais. Uma‡Убейте 8 древних духов могу.‡Tötet 8 uralte Mogugeister.‡고대 모구 영혼 8명을 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 8 espíritus mogu antiguos.‡‡Tuez 8 Anciens esprits mogu.‡击败8只远古魔古之魂。‡',
  }
},
[30238] = {
  {
    'Merecido descanso‡Упокоение‡Ehre, wem Ehre gebührt‡편안히 쉬소서‡Volver a descansar‡‡Repose en paix‡重归安宁‡',
    nil,
    'Honre 6 Lápides de Pandarens. Uma‡Почтите 6 могил пандаренов.‡Erweist 6 Pandarengrabsteinen die Ehre.‡판다렌 묘비 6개 앞에서 묵념해야 합니다. 레벨 30 영원꽃 골짜기‡Honra 6 lápidas pandaren.‡‡Recueillez-vous sur 6 Pierres tombales pandarènes.‡祭拜6个熊猫人墓碑。‡',
  }
},
[30239] = {
  {
    'Lao-Fe, o Amarra-escravos‡Лао-Фэ Поработитель‡Lao-Fe der Sklavenbinder‡노예감독 라오페‡Lao-Fe, el Vinculador de Esclavos‡‡Lao Fe le Lieur d’esclaves‡缚奴者牢非‡',
    nil,
    'Destrua o Espírito de Lao-Fe, o Amarra-escravos. Uma‡Убейте дух Лао-Фэ Поработителя.‡Tötet den Geist von Lao-Fe dem Sklavenbinder.‡노예감독 라오페의 영혼을 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata al espíritu de Lao-Fe, el Vinculador de Esclavos.‡‡Tuez l’Esprit de Lao Fe le Lieur d’esclaves.‡击败缚奴者牢非的灵魂。‡',
  }
},
[30240] = {
  {
    'Ringue da Sobrevivência: Chamas‡Круг выживания: огонь‡Überlebensring: Flammen‡생존의 장 - 불꽃‡Ring de supervivencia: llamas‡‡L’arène de survie : les flammes‡生存之环：火焰‡',
    nil,
    'Entre no Ringue da Sobrevivência e sobreviva por 60 segundos sem sair dele. Uma‡Войдите в круг выживания и продержитесь внутри 60 секунд.‡Betretet den Überlebensring und überlebt 60 Sekunden lang, ohne hinausgestoßen zu werden.‡생존의 장에 들어가서 60초 동안 생존해야 합니다. 레벨 30 영원꽃 골짜기‡Entra al ring de supervivencia y aguanta en él 60 segundos.‡‡Entrez dans l’Arène de survie et tenez pendant 60 secondes sans en sortir.‡进入生存之环，并在不出圈的情况下坚持60秒。‡',
  }
},
[30241] = {
  {
    'Avise Arado de Pedra‡Предупредить Каменный Плуг‡Warnung an Steinpflug‡돌밭에 알리기‡Avisa a Villarroca‡‡Avertir Chasse-Pierre‡示警石犁村‡',
    nil,
    'Vá até a vila de Arado de Pedra, no Vale dos Quatro Ventos. Uma‡Отправляйтесь в деревню Каменный Плуг в долине Четырех Ветров.‡Reist nach Steinpflug im Tal der Vier Winde.‡네 바람의 계곡에 있는 돌밭 마을로 가야 합니다. 레벨 15 네 바람의 계곡‡Viaja a la aldea de Villarroca en el Valle de los Cuatro Vientos.‡‡Voyagez jusqu’à Chasse-Pierre dans la Vallée des quatre Vents.‡到四风谷的石犁村去。‡',
  }
},
[30242] = {
  {
    'Ringue da Sobrevivência: Lâminas‡Круг выживания: клинки‡Überlebensring: Klingen‡생존의 장 - 칼날‡Ring de supervivencia: espadas‡‡L’arène de survie : les lames‡生存之环：刀刃‡',
    nil,
    'Entre no Ringue da Sobrevivência e sobreviva por 60 segundos sem sair dele. Uma‡Войдите в круг выживания и продержитесь внутри 60 секунд.‡Betretet den Überlebensring und überlebt 60 Sekunden lang, ohne hinausgestoßen zu werden.‡생존의 장에 들어가서 60초 동안 생존해야 합니다. 레벨 30 영원꽃 골짜기‡Entra al ring de supervivencia y aguanta en él 60 segundos.‡‡Entrez dans l’Arène de survie et tenez pendant 60 secondes sans en sortir.‡进入生存之环，并在不出圈的情况下坚持60秒。‡',
  }
},
[30243] = {
  {
    'Mantídeo frito‡Отпор богомолам‡Frittierte Mantis‡불타는 사마귀‡Mántides al rojo vivo‡‡Huile de coude‡火烧螳螂‡',
    nil,
    'Use um Caldeirão de Óleo Quente para matar 80 mantídeos nas proximidades do Portal do Sol Poente. Uma‡С помощью котла с кипящим маслом убейте 80 богомолов, атакующих Врата Заходящего Солнца.‡Verwendet einen Kessel mit heißem Öl, um 80 Mantis am Tor der Untergehenden Sonne zu töten.‡뜨거운 기름 가마솥을 이용하여 석양문 부근의 사마귀 80마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Utiliza una caldera de aceite caliente para matar a 80 mántides cerca de la Puerta del Sol Poniente.‡‡Utilisez un Chaudron d’huile brûlante pour tuer 80 Mantides près de la Porte du Soleil couchant.‡使用热油大锅击败残阳关附近的80个螳螂妖。‡',
  }
},
[30244] = {
  {
    'Pelo Espinhaço da Serpente‡Вдоль Змеиного Хребта‡Schlangenbändigung‡용의 척추를 따라서‡Por el Espinazo del Dragón‡‡Le long de l’Échine du Serpent‡横扫蟠龙脊‡',
    nil,
    'Mate 10 mantídeos Krik\'thik em cima do Portal do Sol Poente. Uma‡Убейте 10 богомолов крик\'тик у Врат Заходящего Солнца.‡Tötet 10 Krik\'thik-Mantis am Tor der Untergehenden Sonne.‡석양문에서 크릭티크 사마귀 10마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 10 mántides krik\'thik en la Puerta del Sol Poniente.‡‡Tuez 10 Mantides krik’thik à la Porte du Soleil couchant.‡在残阳关，击败10只科里克提克螳螂妖。‡',
  }
},
[30245] = {
  {
    'Batedores perdidos‡Пропавшие разведчики‡Verlorene Späher‡실종된 정찰병‡Exploradores perdidos‡‡Éclaireurs perdus‡‡',
    nil,
    'Recupere 3 relatórios de Batedores Shado-Pan. Uma‡Восстановить 3 доклада разведчиков Шадо-Пан.‡Sichert die Berichte von 3 Shado-Pan-Spähern.‡음영파 정찰병의 보고를 3건 입수해야 합니다. 레벨 30 영원꽃 골짜기‡Recupera 3 informes de exploración del Shadopan.‡‡Récupérez 3 Rapports de reconnaissance des Pandashan.‡‡',
  }
},
[30246] = {
  {
    'Nas muralhas‡Враг на стене‡Mantis auf der Brustwehr‡성곽 위에서‡Sobre la muralla‡‡Sur les remparts‡‡',
    nil,
    'Mate 10 mantídeos Krik\'thik em cima do Portal do Sol Poente. Uma‡Убейте 10 богомолов крик\'тик над Вратами Заходящего Солнца.‡Tötet 10 Krik\'thik-Mantis auf der obersten Ebene des Tors der Untergehenden Sonne.‡석양문 꼭대기에서 크릭티크 사마귀 10마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 10 mántides krik\'thik en la parte superior de la Puerta del Sol Poniente.‡‡Tuez 10 Mantides krik’thik au sommet de la Porte du Soleil couchant.‡‡',
  }
},
[30247] = {
  {
    'Clube do Rolamento: Vale das Flores Eternas‡Курсы по катанию: Вечноцветущий дол‡Rollclub: Tal der Ewigen Blüten‡데굴데굴 동호회 - 영원꽃 골짜기‡El club del giro: Valle de la Flor Eterna‡‡Club des roulades : val de l’Éternel printemps‡翻滚俱乐部：锦绣谷‡',
    nil,
    'Complete a pista de rolamento do Vale das Flores Eternas. Uma‡Закончите курсы по катанию в Вечноцветущем доле.‡Schließt den Rollkurs des Tals der Ewigen Blüten ab.‡영원꽃 골짜기 데굴길을 완주해야 합니다. 레벨 1 영원꽃 골짜기‡Completa la pista rodante del Valle de la Flor Eterna.‡‡Terminez la Course de roulades du val de l’Éternel printemps.‡完成锦绣谷的翻滚路线。‡',
  }
},
[30248] = {
  {
    'O Carniceiro‡Мясник‡Schlachtzeit‡도살자‡El Carnicero‡‡Le Boucher‡‡',
    nil,
    'Mate Bai-Jin, o Carniceiro. Uma‡Убейте Бай-Цзиня Мясника.‡Tötet Bai-Jin den Schlächter.‡도살자 바이진을 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a Bai-Jin el Carnicero.‡‡Tuez Bai Jin le Boucher.‡‡',
  }
},
[30249] = {
  {
    'Sob o sol poente‡Во время заката‡Unter der Untergehenden Sonne‡석양 아래‡Bajo el sol poniente‡‡Sous le soleil couchant‡夕阳之下‡',
    nil,
    'Mate Kri\'chon, o Aniquilador de Cadáveres. Uma‡Уничтожьте Кри\'чона Трупогрыза.‡Tötet Kri\'chon den Leichenhäscher.‡시체약탈자 크리촌을 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a Kri\'chon, el Atracador de Cadáveres.‡‡Éliminez Kri’chon, le Saccage-corps.‡击败掠尸者科里充。‡',
  }
},
[30250] = {
  {
    'Ringue da Sobrevivência: Trovão‡Круг выживания: гром‡Überlebensring: Donner‡생존의 장 - 우레‡Ring de supervivencia: trueno‡‡L\'arène de survie : le tonnerre‡‡',
    nil,
    'Entre no Ringue da Sobrevivência e sobreviva por 90 segundos sem sair dele. Uma‡Войдите в круг выживания и продержитесь внутри 90 секунд.‡Betretet den Überlebensring und überlebt 90 Sekunden lang, ohne hinausgestoßen zu werden.‡생존의 장에 들어가서 90초 동안 생존해야 합니다. 레벨 1 영원꽃 골짜기‡Entra al Ring de Supervivencia y aguanta 90 segundos sin marcharte.‡‡Entrez dans l’Arène de survie et tenez pendant 90 secondes sans en sortir.‡‡',
  }
},
[30251] = {
  {
    'Vyraxxis, o Lorde do Enxame Krik\'thik‡Вираксис, повелитель роя крик\'тиков‡Vyraxxis, der Schwarmfürst der Krik\'thik‡크릭티크 무리군주 바이락시스‡Vyraxxis, el señor del enjambre Krik\'thik‡‡Vyraxxis, seigneur de l’essaim krik’thik‡‡',
    nil,
    'Mate Vyraxxis, o Lorde do Enxame Krik\'thik. Uma‡Убейте Вираксиса, повелителя роя крик\'тиков.‡Tötet Vyraxxis, den Schwarm-Herrscher der Krik\'thik.‡크릭티크 무리군주 바이락시스를 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a Vyraxxis, señor del enjambre Krik\'thik.‡‡Tuez Vyraxxis, le Seigneur de l’essaim krik’thik.‡‡',
  }
},
[30252] = {
  {
    'Uma mão amiga‡Рука помощи‡Eine helfende Hand‡도움의 손길‡Arrimar el hombro‡‡Une main secourable‡帮把手‡',
    nil,
    'Destrua 8 Rochas Inamovíveis. Uma‡Уберите 8 неподвижных валунов.‡Zerstört 8 unnachgiebige Felsen.‡꿈쩍도 않는 바위 8개를 파괴해야 합니다. 레벨 15 네 바람의 계곡‡Destruye 8 rocas firmes.‡‡Détruisez 8 Rochers inamovibles.‡摧毁8块顽石。‡',
  }
},
[30253] = {
  {
    'A fazenda da família‡Фамильная ферма‡Der Familienhof‡‡La granja familiar‡‡La ferme de famille‡‡',
    nil,
    'Junte-se ao Fazendeiro Yoon. Uma‡Помогите фермеру Юну.‡Schließt Euch Bauer Yoon an.‡‡Únete al granjero Yoon.‡‡Associez-vous au Fermier Yoon.‡‡',
  }
},
[30254] = {
  {
    'Caminhando e plantando II: lavra e semeadura‡Растениеводство II: грядки и семена‡Agrikultur II: Pflügen und Pflanzen‡농사일 배우기 II: 갈묻이와 씨앗 심기‡Aprender y cultivar II: Labrar y plantar‡‡Potasser son potager - Leçon 2 : labourer et planter‡学习农事（二）：耕种‡',
    nil,
    'Are 2 canteiros de Terra Dura para criar Terra Arada. Em seguida, use as Sementes de Repolho Verde Extra-rápido em 2 canteiros de Terra Arada.‡Вскопайте 2 участка невозделанной земли, таким образом превратив ее в возделанную. Затем посадите там семена органической белокочанной капусты.‡Pflügt 2 Flächen ungepflügtes Erdreich um, damit daraus gepflügtes Erdreich wird. Pflanzt dann auf 2 Flächen die Simp-L-WAX-Grünkohlsamen ein.‡갈지 않은 흙 2곳을 갈묻이해서 갈아엎은 흙을 만드십시오. 그 후 갈아엎은 흙 2곳에 쑥쑥커 녹색 양배추 씨앗을 사용하십시오.‡Labra 2 parcelas de tierra sin labrar para crear tierra labrada. A continuación, utiliza las semillas de repollo verde orgánico en 2 parcelas de tierra labrada.‡‡Labourez 2 lopins de Terre non labourée pour créer de la Terre labourée. Ensuite, utilisez les Graines de chou vert Do-P sur 2 lopins de Terre labourée.‡开垦两片未开垦的土壤。然后，在这两片开垦过的土壤上播下易种型绿色卷心菜种子。‡',
  }
},
[30255] = {
  {
    'Caminhando e plantando III: cuidados‡Растениеводство III: уход за овощами‡Agrikultur III: Hegen und Pflegen‡농사일 배우기 III: 물 주기‡Aprender y cultivar III: Ocuparse de la cosecha‡‡Potasser son potager - Leçon 3 : arroser les plantations‡学习农事（三）：照料‡',
    nil,
    'Use o Regador Enferrujado para regar 2 Repolhos Verdes Extra-rápidos Ressequidos na Fazenda Sol Cantante. Uma‡Возьмите ржавую лейку и полейте 2 кочана высохшей органической белокочанной капусты на ферме Солнечной Песни.‡Verwendet die rostige Gießkanne, um 2 ausgetrocknete Simp-L-WAX-Grünkohlköpfe auf dem Gehöft Sonnensang zu wässern.‡녹슨 물뿌리개를 이용해 태양노래 농장에 있는 바짝 마른 쑥쑥커 녹색 양배추 2개에 물을 줘야 합니다.‡Utiliza la regadera oxidada para regar 2 repollos verdes orgánicos mustios en el Rancho Cantosol.‡‡Utilisez l’Arrosoir rouillé pour arroser 2 Choux verts Do-P desséchés à la Ferme Chant du Soleil.‡在日歌农场使用生锈的洒水壶为两片干枯的易种型绿色卷心菜浇水。‡',
  }
},
[30256] = {
  {
    'Caminhando e plantando IV: colheita‡Растениеводство IV: сбор урожая‡Agrikultur IV: Ernten‡농사일 배우기 IV: 수확‡Aprender y cultivar IV: Cosechar‡‡Potasser son potager - Leçon 4 : la récolte‡学习农事（四）：收割‡',
    nil,
    'Colha 2 Repolhos Verdes Extra-rápidos da sua plantação e entregue-os para o Fazendeiro Yoon, na Fazenda Sol Cantante. Uma‡Найдите на своем поле 2 кочана органической белокочанной капусты, принесите их на ферму Солнечной Песни и отдайте фермеру Юну.‡Erntet 2 Simp-L-WAX-Grünkohlköpfe von Eurem Feld und bringt sie zu Bauer Yoon auf dem Gehöft Sonnensang.‡자신의 농장에서 쑥쑥커 녹색 양배추 2개를 수확한 다음 태양노래 농장에 있는 농부 윤에게 가져가야 합니다.‡Recoge 2 repollos verdes orgánicos de tu campo y llévaselas al granjero Yoon en el Rancho Cantosol.‡‡Récoltez 2 Choux verts Do-P dans votre champ puis apportez-les au Fermier Yoon à la Ferme Chant du Soleil.‡从你的农田中收割两株易种型绿色卷心菜，并带给日歌农场的农夫老愚。‡',
  }
},
[30257] = {
  {
    'Caminhando e plantando V: Mercado de Meia Colina‡Растениеводство V: рынок Полугорья‡Lernen und Wachsen V: Halbhügelmarkt‡농사일 배우기 V: 언덕골 시장‡Aprender y cultivar V: El Mercado del Alcor‡‡Potasser son potager - Leçon 5 : Le marché de Micolline‡学习务农（五）：半山市集‡',
    nil,
    'Examine o Solo Negro debaixo da casa do Fazendeiro Yoon, depois leve um presente para Gina Garra de Barro no Mercado de Meia Colina. Premia .‡Внимательно осмотрите темную землю под домом фермера Юна, а затем подарите подарок Джине Грязный Коготь на рынке Полугорья.‡Untersucht die dunkle Erde unter dem Haus des Bauern Yoon und bringt dann ein Geschenk zu Gina Lehmkrall auf dem Halbhügelmarkt.‡농부 윤의 집 아래에 있는 검은 토양을 조사한 뒤, 언덕골 시장에 있는 지나 머드클로에게 선물을 줘야 합니다.‡Busca en la tierra oscura que hay bajo la casa del granjero Yoon y llévale un regalo a Gina Zarpa Fangosa en el Mercado del Alcor. Otorga  como recompensa.‡‡Examinez la Terre sombre sous la maison du Fermier Yoon, puis offrez un cadeau à Gina Griffe de Tourbe, au Marché de Micolline.‡调查一下农夫老愚房子下面的黑色泥土，然后给半山市集的吉娜·泥爪送去一份礼物。‡',
  }
},
[30258] = {
  {
    'O voto de Mung-Mung I: um problema de hozen‡Голос Мун-Муна I: проблема с хозенами‡Mung-Mungs Stimme I: Das Problem eines Ho-zen‡뭉뭉의 한 표 I: 호젠의 문제‡El voto de Mung-Mung I: Un problema hozen‡‡Le vote de Mung-Mung (1) : un problème de hozen‡蒙蒙的选票（一）：猢狲的烦恼‡',
    nil,
    'Fale com Mung-Mung na Casa de Haohan Garra de Barro, que fica no Vale dos Quatro Ventos. Uma‡Поговорите с Мун-Муном, который находится в доме Хаоханя Грязного Когтя в долине Четырех Ветров.‡Sprecht mit Mung-Mung bei Haohan Lehmkralls Haus im Tal der Vier Winde.‡네 바람의 계곡의 하오한 머드클로의 집에 있는 뭉뭉과 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Mung-Mung en el Hogar de Haohan Zarpa Fangosa, en el Valle de los Cuatro Vientos.‡‡Parlez à Mung-Mung à la ferme de Haohan Griffe de Tourbe dans la Vallée des Quatre vents.‡去四风谷的郝瀚·泥爪屋外和蒙蒙谈一谈。‡',
  }
},
[30259] = {
  {
    'O voto de Mung-Mung II: podre até o caroço‡Голос Мун-Муна II: огородные вредители‡Mung-Mungs Stimme II: Bis ins Mark verdorben‡뭉뭉의 한 표 II: 속속들이 썩은‡El voto de Mung-Mung II: Podrido hasta la médula‡‡Le vote de Mung-Mung (2) : pourries jusqu’au trognon‡蒙蒙的选票（二）：兔妖坏透了‡',
    nil,
    'Colete 10 Cenouras Parcialmente Mastigadas. Uma‡Соберите 10 частично пережеванных морковок.‡Sammelt 10 angenagte Karotten auf.‡부분부분 갉아먹은 당근 10개를 수집해야 합니다. 레벨 15 네 바람의 계곡‡Recoge 10 zanahorias mordisqueadas.‡‡Ramassez 10 Carottes partiellement rongées.‡收集10根被咬过的胡萝卜。‡',
  }
},
[30260] = {
  {
    'Expandindo a fazenda I: as ervas daninhas‡Фермерство I: сорняки‡Den Hof pflegen I: Das Unkraut‡농장 확장 1단계: 잡초‡Ampliar la granja I: Las malas hierbas‡‡Agrandir la ferme - Leçon 1 : les mauvaises herbes‡农场物语（一）：杂草‡',
    nil,
    'Fale com Gai Lan no Coração da Terra, que fica no Vale dos Quatro Ventos. Uma‡Поговорите с Гай Ланем, который находится в Плодородных землях в долине Четырех Ветров.‡Redet mit Gai Lan im Kernland im Tal der Vier Winde.‡네 바람의 계곡의 심장지에 있는 가이 란과 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Gai Lan en Los Cultivos Florecientes, en el Valle de los Cuatro Vientos.‡‡Parlez à Gai Lan au Giron, dans la Vallée des Quatre vents.‡去四风谷的汇风岭和蓝盖谈一谈。‡',
  }
},
[30261] = {
  {
    'Clube do Rolamento: Espinhaço da Serpente‡Курсы по катанию: Змеиный Хребет‡Rollclub: Schlangenrücken‡데굴데굴 동호회 - 용의 척추‡El club del giro: Espinazo del Dragón‡‡Club des roulades : Échine du serpent‡翻滚俱乐部：蟠龙脊‡',
    nil,
    'Complete o circuito de rolamento da Espinha de Serpente. Uma‡Закончите курсы по катанию на Змеином Хребте.‡Schließt die Rollstrecke des Schlangenrückens ab.‡용의 척추 데굴길을 완주해야 합니다. 레벨 30 영원꽃 골짜기‡Completa la pista rodante del Espinazo del Dragón.‡‡Terminez la Course de roulades d’Échine du Serpent.‡完成蟠龙脊的翻滚路线。‡',
  }
},
[30262] = {
  {
    'NOT USED‡NOT USED‡NOT USED‡미사용‡NOT USED‡‡INUTILISÉ‡NOT USED‡',
    nil,
    'Uma‡‡‡레벨 1 영원꽃 골짜기‡‡‡‡‡',
  }
},
[30263] = {
  {
    'Limpeza na floresta‡Зачистка леса‡Den Wald säubern‡숲 대청소‡Un claro en el bosque‡‡La clairière dans les bois‡‡',
    nil,
    'Mate 10 Mogus Shao-Tien na Clareira Galho Invernal. Uma‡Убейте 6 могу Шао-Тень на Опушке Зимней Ветви.‡Tötet 6 Mogu der Shao-Tien in der Winterastlichtung.‡겨울가지 숲에서 샤오티엔 모구 6명을 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 6 mogu Shao-Tien en el Claro Brote Invernal.‡‡Tuez 6 Mogu shao-tien à la Clairière de Rameau-de-l’Hiver.‡‡',
  }
},
[30264] = {
  {
    'Inimigos nos portões‡Враг у ворот‡Der Feind vor den Toren‡문 앞의 적‡Enemigo a las puertas‡‡L’ennemi aux portes‡兵临城下‡',
    nil,
    'Use uma Serpente dos Céus Shado-Pan para matar 60 atacantes Krik\'thik, 3 Carroças de Guerra Krik\'thik e 3 Catapultas Krik\'thik. Uma‡Используйте небесного змея Шадо-Пан, чтобы убить 60 крик\'тиков, а также уничтожить 3 боевые колесницы крик\'тиков и 3 катапульты крик\'тиков.‡Vernichtet mithilfe einer Shado-Pan-Himmelsschlange 60 Angreifer der Krik\'thik, 3 Kriegswagen der Krik\'thik und 3 Katapulte der Krik\'thik.‡음영파 전투 운룡을 타고 크릭티크 공격자 60마리, 크릭티크 전차 3기, 크릭티크 투석기 3기를 처치해야 합니다.‡Utiliza un dragón celestial del Shadopan para acabar con 60 atacantes Krik\'thik, 3 carros de guerra Krik\'thik y 3 catapultas Krik\'thik. Un(a) misión.‡‡Chevauchez un Serpent céleste pandashan pour tuer 60 attaquants krik’thik, 3 Chariots de guerre krik’thik et 3 Catapultes krik’thik.‡使用影踪派空中翔龙击败60个科里克提克攻击者，并摧毁3辆科里克提克战车和3架科里克提克弩炮。‡',
  }
},
[30265] = {
  {
    'Olho grande – e cintilante‡Искры в глазах‡Das Funkeln im Auge‡눈동자에 비친 빛‡Destellos acuáticos‡‡Une étincelle dans le regard‡眼中光华‡',
    nil,
    'Colete 8 Rubis Rutilantes. Uma‡Достаньте из воды 8 сверкающих рубинов.‡Bergt 8 Glitzerrubine.‡루비 눈 8개를 찾아야 합니다. 레벨 5 영원꽃 골짜기‡Recupera 8 rubíes brillantes.‡‡Récupérez 8 Rubis étincelants.‡找回8颗闪光红宝石。‡',
  }
},
[30266] = {
  {
    'Céus de sangue‡Кровавые небеса‡Himmel voller Blut‡피로 물든 하늘‡Cielo ensangrentado‡‡Ciel de sang‡浸血的苍穹‡',
    nil,
    'Mate 30 Enxameadores Krik\'thik usando a Torreta do Sol Poente. Uma‡Убейте 30 крик\'тиков-роевиков, используя турель Заходящего Солнца.‡Tötet 30 Drohnen der Krik\'thik mit einer Kanone am Tor der Untergehenden Sonne.‡석양 포탑을 사용해서 크릭티크 무리전사 30마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 30 enjambristas Krik\'thik utilizando una torreta de Sol Poniente.‡‡Tuez 30 Grouillants krik’thik à l’aide d’une Tourelle du Soleil couchant.‡用残阳炮塔击败30只科里克提克螳螂妖。‡',
  }
},
[30267] = {
  {
    'Infortúnios aquáticos‡Беда рыбака‡Anglerträume‡낚시꾼의 걱정‡Lamentaciones acuosas‡‡Problèmes aquatiques‡水上悲情‡',
    nil,
    'Consiga 18 Reluzídeos da Clareira e 5 Plumassangues Longas. Uma‡Наберите 18 луговых светлячков и 5 тонких алых перьев.‡Besorgt 18 Lichtungsglühwürmer und 5 spindeldürre Blutfedern.‡숲 빛말벌 18마리와 가냘픈 붉은깃털 5개를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 18 fulgentes del claro y 5 sangreplumas larguiruchas.‡‡Obtenez 18 Luisants de la clairière et 5 Appâts plumesangs.‡获得18只林地萤火虫和5根细长的血羽。‡',
  }
},
[30268] = {
  {
    'O suor sombrio‡Чернопотница‡Das Düsterfieber‡거먹비늘병‡Los sudores sombríos‡‡Les sueurs de la bourbe‡污鳞盗汗症‡',
    nil,
    'Consiga 6 Cabeças de Escama-da-sombra dos Escama-da-sombra Agressivos no Rio Krasarang. Uma‡Соберите 6 голов темночешуйчатых жаленей, которые водятся в реке Красаранг. задание.‡Sammelt 6 Düsterschuppenköpfe von Angreifern der Düsterschuppen im Krasarang.‡크라사랑 강에서 사나운 거먹비늘뱀을 처치하고 거먹비늘뱀 머리를 6개 모아야 합니다. 레벨 15 크라사랑 밀림‡Reúne 6 cabezas Escama Sombría de asediadores Escama Sombría en el río Krasarang.‡‡Collectez 6 Têtes de bourbécailles sur les Frappeurs bourbécailles dans la Rivière de Krasarang.‡从卡桑琅河的污鳞打击者身上收集6颗污鳞蛇头。‡',
  }
},
[30269] = {
  {
    'Passagem insegura‡Опасный проход‡Unsichere Passage‡안전하지 않은 길‡Pasaje peligroso‡‡Un chemin dangereux‡危险的小径‡',
    nil,
    'Ajude Koro Andarilho da Névoa a escoltar um grupo de refugiados do Templo da Garça Vermelha até o Refúgio Asa da Garça. Fale com Koro para começar.‡Помогите Коро Страннику Туманов довести группу беженцев из храма Красного Журавля в укрытие Журавлиного Крыла. Чтобы начать путь, поговорите с Коро.‡Helft Koro Nebelgänger, eine Gruppe Flüchtlinge vom Tempel des Roten Kranichs zum Refugium der Kranichschwingen zu eskortieren. Sprecht vor Beginn zuerst mit Koro.‡코로 미스트워커를 도와 주학사에서 학날개 은거지로 가는 난민들을 호위해야 합니다. 시작하려면 코로와 대화해야 합니다.‡Ayuda a Koro Caminante Misterioso a escoltar a un grupo de refugiados del Templo de la Grulla Roja hasta el Refugio Ala de Grulla. Habla primero con Koro para empezar.‡‡Aidez Koro Marche la Brume à escorter un groupe de réfugiés du Temple de la Grue rouge jusqu’au Refuge des Aile-de-Grue. Parlez d’abord à Koro pour commencer la quête d’escorte.‡帮助科洛·迷雾行者护送一队难民从朱鹤寺前往鹤翼庇护所。和科洛交谈以开启任务。‡',
  }
},
[30270] = {
  {
    'Cegando os Fluviaço‡Ослепление Речных Клинков‡Blenden der Flussklingen‡갈퀴칼날의 눈 없애기‡Cegar a los Hojarrío‡‡Aveugler les rivelames‡斩断耳目‡',
    nil,
    'Mate 8 Tocaiantes Fluviaço nos arredores do Refúgio Asa da Garça. Uma‡Убейте 8 налетчиков Речного Клинка в окрестностях укрытия Журавлиного Крыла.‡Tötet 8 Wegelagerer der Flussklingen in der Umgebung des Refugiums der Kranichschwingen.‡학날개 은거지 주변 지역에 있는 갈퀴칼날 길추적자 8명을 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 8 acechacaminos Hojarrío en los alrededores del Refugio Ala de Grulla.‡‡Tuez 8 Eclaireurs rivelame dans la région qui entoure le Refuge des Aile-de-Grue.‡在鹤翼庇护所周边地区杀死8个河刃密径猎手。‡',
  }
},
[30271] = {
  {
    'Sha: que terror!‡Шок и трепет ша‡Shapokalypse‡놀라운 샤‡Los sha pueden impresionar‡‡L’espoir en peau de shagrin‡不惧强敌‡',
    nil,
    'Mate shas perto de 10 Monges Desesperançados ou Acólitos Desesperançados para inspirá-los. Uma‡Убейте ша рядом с десятью отчаявшимися монахами или послушниками, чтобы их вдохновить.‡Tötet Sha in der Nähe von 10 hoffnungslosen Mönchen oder Akolythen, um sie zu inspirieren.‡절망하는 수도사 또는 수행사제 10명의 곁에 있는 샤를 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata sha cerca de 10 monjes o acólitos desesperados para inspirarles.‡‡Tuez des sha près de 10 Moines désespérés ou Acolytes désespérés pour leur redonner courage.‡在10名绝望的武僧或助祭旁边杀死煞魔，以鼓舞他们的士气。‡',
  }
},
[30272] = {
  {
    'Atacando a chuva‡Удары по дождю‡Regen schlagen‡빗물 쳐 내기‡Golpear la lluvia‡‡Frapper la pluie‡拨云见日‡',
    nil,
    'Mate 18 Assombrações do Desespero no Templo da Garça Vermelha. Uma‡Убейте 18 мук отчаяния в храме Красного Журавля.‡Tötet 18 Spuke der Verzweiflung beim Tempel des Roten Kranichs.‡주학사에서 절망의 귀신 18마리를 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 18 tormentos de desesperación en el Templo de la Grulla Roja.‡‡Tuez 18 Revenants du Désespoir au Temple de la Grue rouge.‡在朱鹤寺杀死18只惘之影。‡',
  }
},
[30273] = {
  {
    'Na Casa da Garça Vermelha‡Дом Красного Журавля‡Im Haus des Roten Kranichs‡주학의 보금자리에서‡En el hogar de la Grulla Roja‡‡Dans le nid de la Grue rouge‡朱鹤之室‡',
    nil,
    'Entre no porão do Templo da Garça Vermelha e derrote o Sha do Desespero. Uma‡Войдите в подвал храма Красного Журавля и убейте Ша Отчаяния.‡Begebt Euch in den Keller des Tempels des Roten Kranichs und besiegt das Sha der Verzweiflung.‡주학사의 지하로 이동해 절망의 샤를 처치해야 합니다. 레벨 15 크라사랑 밀림‡Entra en el sótano del Templo de la Grulla Roja y acaba con el sha de la desesperación.‡‡Pénétrez dans le sous-sol du Temple de la Grue rouge et triomphez du Sha du désespoir.‡进入朱鹤寺的地下室，击败惘之煞。‡',
  }
},
[30274] = {
  {
    'A prisão arcana‡Волшебная темница‡Die arkane Oubliette‡비전의 비밀감옥‡El calabozo Arcano‡‡L’oubliette arcanique‡奥法地牢‡',
    nil,
    'Encontre e desative 3 Grilhões da Prisão. Uma‡Найдите и откройте 3 засова темницы.‡Sucht und deaktiviert 3 Fesseln der Oubliette.‡비밀감옥 족쇄를 3개 찾아서 파괴해야 합니다. 레벨 15 크라사랑 밀림‡Encuentra y abre los 3 grilletes del calabozo.‡‡Trouvez et détruisez 3 Chaînes de l’oubliette.‡找出并毁掉3个地牢镣铐。‡',
  }
},
[30275] = {
  {
    'História de crocolisco‡История с кроколиском‡Gigantismus‡악어 꼬리‡Una historia de crocoliscos‡‡Histoire sans queue ni tête‡鳄鱼传说‡',
    nil,
    'Leve o Rabo de Crocolisco Enorme para Yan em Nova Cifera, no Vale dos Quatro Ventos. Uma‡Отнесите хвост огромного кроколиска Яню, который находится в Новой Цифере в долине Четырех Ветров.‡Bringt den riesigen Krokiliskenschwanz zu Yan in Neu-Cifera im Tal der Vier Winde.‡거대한 악어 꼬리를 네 바람의 계곡의 신 사이페라에 있는 옌에게 가져가야 합니다. 레벨 15 네 바람의 계곡‡Lleva la enorme cola de crocolisco a Yan en Nueva Cifera, en el Valle de los Cuatro Vientos.‡‡Apportez l’Énorme queue de crocilisque à Yan à la Nouvelle-Cifera, dans la Vallée des Quatre vents.‡去四风谷的新希菲拉。将巨型鳄鱼尾交给颜。‡',
  }
},
[30277] = {
  {
    'O salão desmoronante‡Опасный чертог‡Die bröckelnde Halle‡부서진 전당‡La cámara en ruinas‡‡La salle croulante‡破败的大厅‡',
    nil,
    'Recupere o Artefato Guo-Lai Antigo. Uma‡Заберите древнюю реликвию Го-Лай.‡Bergt das uralte Guo-Lai-Artefakt.‡고대 구오라이 유물을 찾아야 합니다. 레벨 30 영원꽃 골짜기‡Recupera el artefacto de Guo-Lai antiguo.‡‡Récupérez l’Artéfact ancien de Guo-Lai.‡夺回远古郭莱神器。‡',
  }
},
[30278] = {
  {
    'REUTILIZAR PARA PROGRESSÃO‡REUSE FOR PROGRESSION‡REUSE FOR PROGRESSION‡진행 시 재사용‡REUSE FOR PROGRESSION‡‡REUSE FOR PROGRESSION‡REUSE FOR PROGRESSION‡',
    nil,
    'Uma‡‡‡레벨 1 영원꽃 골짜기‡‡‡‡‡',
