[32942] = {
  {
    'Ordem de Serviço: Investida Fendessol I‡Заказ: Войска Похитителей Солнца I‡Arbeitsauftrag: Sonnenhäscheransturm I‡주문서: 선리버 돌격대 I‡Pedido del Embate de los Atracasol I‡‡Commande : l’assaut des Saccage-Soleil I‡产品订单：夺日者先锋军I‡',
    nil,
    'Plante 8 Sementes de Cebolinha na Fazenda Sol Cantante. Uma‡Посадите 8 семян лука-шалота на ферме Солнечной Песни.‡Pflanzt 8 Frühlingszwiebelsamen auf dem Gehöft Sonnensang.‡태양노래 농장에 파 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de cebolleta en el Rancho Cantosol.‡‡Plantez 8 Graines d’échalote à la Ferme Chant du Soleil.‡在日歌农场播种8颗小葱种子。‡',
  }
},
[32943] = {
  {
    'Ordem de Serviço: Investida Fendessol II‡Заказ: Войска Похитителей Солнца II‡Arbeitsauftrag: Sonnenhäscheransturm II‡주문서: 선리버 돌격대 II‡Pedido del Embate de los Atracasol II‡‡Commande : l’assaut des Saccage-Soleil II‡产品订单：夺日者先锋军II‡',
    nil,
    'Colha 8 pés de Cebolinha Madura e forneça 40 Cebolinhas para a Investida Fendessol. Uma‡Соберите урожай с 8 растений лука-шалота и упакуйте 40 единиц лука-шалота для Войск Похитителей Солнца.‡Erntet 8 reife Frühlingszwiebelpflanzen und liefert 40 Frühlingszwiebeln an den Sonnenhäscheransturm.‡잘 익은 파를 8개 수확한 후 선리버 돌격대에 파를 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de cebolleta maduras y consigue 40 cebolletas para el Embate de los Atracasol.‡‡Récoltez 8 plants d’Échalotes mûres et fournissez 40 Échalotes pour l’Assaut des Saccage-Soleil.‡收获8个成熟的葱，并向夺日者先锋军提供40份葱。‡',
  }
},
[32944] = {
  {
    'Ordem de Serviço: Ofensiva do Kirin Tor I‡Заказ: Армия Кирин-Тора I‡Arbeitsauftrag: Offensive der Kirin Tor I‡주문서: 키린 토 선봉대 I‡Pedido de la Ofensiva del Kirin Tor I‡‡Commande : offensive du Kirin Tor I‡产品订单：肯瑞托远征军I‡',
    nil,
    'Plante 8 Sementes de Cenoura Mordelícia na Fazenda Sol Cantante. Uma‡Посадите 8 семян хрустящей моркови на ферме Солнечной Песни.‡Pflanzt 8 saftigleckere Karottensamen auf dem Gehöft Sonnensang.‡태양노래 농장에 츄릅아삭 당근 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de zanahoria Jugoasaz en el Rancho Cantosol.‡‡Plantez 8 Graines de carotte croquejuteuse à la Ferme Chant du Soleil.‡在日歌农场播种8颗爽脆胡萝卜种子。‡',
  }
},
[32945] = {
  {
    'Ordem de Serviço: Ofensiva do Kirin Tor II‡Заказ: Армия Кирин-Тора II‡Arbeitsauftrag: Offensive der Kirin Tor II‡주문서: 키린 토 선봉대 II‡Pedido de la Ofensiva del Kirin Tor II‡‡Commande : offensive du Kirin Tor II‡产品订单：肯瑞托远征军II‡',
    nil,
    'Colha 8 pés de Cenoura Mordelícia e forneça 40 Cenouras Mordelícia para a Ofensiva do Kirin Tor. Uma‡Соберите урожай с 8 растений хрустящей моркови и упакуйте 40 единиц хрустящей моркови для Армии Кирин-Тора.‡Erntet 8 reife saftigleckere Karottenpflanzen und liefert 40 saftigleckere Karotten an die Offensive der Kirin Tor.‡잘 익은 츄릅아삭 당근을 8개 수확한 후 키린 토 선봉대에 츄릅아삭 당근을 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de zanahoria Jugoasaz maduras y consigue 40 zanahorias Jugoasaz para la Ofensiva del Kirin Tor.‡‡Récoltez 8 plants de Carottes croquejuteuses mûres et fournissez 40 Carottes croquejuteuses pour l’Offensive du Kirin Tor.‡收获8个成熟的爽脆胡萝卜，并向肯瑞托远征军提供40份爽脆胡萝卜。‡',
  }
},
