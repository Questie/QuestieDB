[10467] = {
  {
    'Voto do defensor‡Обет защитника‡Das Gelöbnis des Verteidigers‡수호자의 맹세‡La promesa del defensor‡La promesa del defensor‡Le vœu du défenseur‡防御者的誓约‡防衛者的誓約',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se Honrada pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить уважительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen wohlwollenden Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenue Honorée auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到尊敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達尊敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10468] = {
  {
    'Juramento do sábio‡Клятва мудреца‡Der Schwur des Weisen‡현자의 서약‡La palabra del sabio‡La palabra del sabio‡La promesse du sage‡先知的誓言‡法師的誓願',
    nil,
    'Leve o Elo da Eternidade para Soridormi nas Cavernas do Tempo depois de tornar-se Reverenciado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить почтительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen respektvollen Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자로부터 매우 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Révéré par la Balance des sables.‡当你在流沙之鳞中的声望达到崇敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達崇敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10469] = {
  {
    'Juramento do restaurador‡Клятва целителя‡Der Schwur des Bewahrers‡구원자의 서약‡La palabra del restaurador‡La palabra del restaurador‡La promesse du guérisseur‡治愈者的誓言‡治療者的誓願',
    nil,
    'Leve o Elo da Eternidade para Soridormi nas Cavernas do Tempo depois de tornar-se Reverenciado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить почтительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen respektvollen Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자로부터 매우 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Révéré par la Balance des sables.‡当你在流沙之鳞中的声望达到崇敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達崇敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10470] = {
  {
    'Juramento do campeão‡Клятва защитника‡Der Schwur des Helden‡용사의 서약‡La palabra del campeón‡La palabra del campeón‡La promesse du champion‡勇士的誓言‡勇士的誓願',
    nil,
    'Leve o Elo da Eternidade para Soridormi nas Cavernas do Tempo depois de tornar-se Reverenciado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить почтительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen respektvollen Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자로부터 매우 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Révéré par la Balance des sables.‡当你在流沙之鳞中的声望达到崇敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達崇敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10471] = {
  {
    'Juramento do defensor‡Клятва защитника‡Der Schwur des Verteidigers‡수호자의 서약‡La palabra del defensor‡La palabra del defensor‡La promesse du défenseur‡防御者的誓言‡防衛者的誓願',
    nil,
    'Leve o Elo da Eternidade para Soridormi nas Cavernas do Tempo depois de tornar-se Reverenciada pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить почтительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen respektvollen Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자로부터 매우 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de venerado ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenue Révérée par la Balance des sables.‡当你在流沙之鳞中的声望达到崇敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達崇敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10472] = {
  {
    'Pacto do sábio‡Договор мудреца‡Das Bündnis des Weisen‡현자의 맹약‡El pacto del sabio‡El pacto del sabio‡L\'engagement du sage‡先知的盟约‡法師的盟約',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se Exaltado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени, когда сумеете заслужить полное доверие драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen ehrfürchtigen Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에게 확고한 동맹 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de exaltado ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de exaltado ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Exalté auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到崇拜后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達崇拜之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10473] = {
  {
    'Pacto do restaurador‡Договор целителя‡Das Bündnis des Bewahrers‡구원자의 맹약‡El pacto del restaurador‡El pacto del restaurador‡L\'engagement du guérisseur‡治愈者的盟约‡治療者的盟約',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se Exaltado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени, когда сумеете заслужить полное доверие драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen ehrfürchtigen Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에게 확고한 동맹 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de exaltado ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de exaltado ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Exalté auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到崇拜后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達崇拜之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
