[11582] = {
  {
    'Monitoramento da fissura: Abismo Partido‡Наблюдения за расселиной: Расколотая бездна‡Die Klamm beobachten: Die Kluft‡균열 조사: 갈라진 협곡‡Observar la falla: Sima Quebrada‡Observar la falla: Sima Quebrada‡Surveiller la faille : l\'anomalie du gouffre scindé‡监视裂谷：峭壁断层‡監控裂口:破碎裂隙',
    nil,
    'Garren, no Promontório Âmbar, quer que você use o Arcanômetro na anomalia do Abismo Partido e fale com ele após fazer a leitura.‡По поручению Гаррена с Янтарной гряды воспользуйтесь тайнометром у Расколотой бездны и возвращайтесь к нему с полученными данными.‡Garren vom Bernsteinflöz möchte, dass Ihr den Arkanometer bei der Kluftanomalie benutzt und mit den Messungen zu ihm zurückkehrt.‡호박석 절벽에 있는 가렌이 갈라진 협곡에서 비전력 측정기를 사용하여 수치를 얻어 달라고 했습니다.‡Garren en El Saliente Ámbar quiere que uses el arcanómetro en la anomalía de la Sima Quebrada y que vuelvas con las lecturas.‡Garren en El Saliente Ámbar quiere que uses el arcanómetro en la anomalía de la Sima Quebrada y que vuelvas con las lecturas.‡Garren, de l\'Escarpement d\'Ambre, vous demande d\'utiliser l\'Arcanomètre à l\'Anomalie du Gouffre scindé et de retourner le voir avec les relevés.‡琥珀崖的盖伦要你在峭壁断层处使用奥术测量器，并将读数带回去交给他。‡琥珀岩臺的加倫要你在破碎裂隙異常處使用奧能檢測儀然後把讀數交給他。',
  }
},
[11583] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡Honrar la llama‡Honorer la flamme‡祭拜这团火焰‡榮耀火焰',
    nil,
    nil,
  }
},
[11584] = {
  {
    '‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡Honrar la llama‡Honorer la flamme‡祭拜这团火焰‡榮耀火焰',
    nil,
    nil,
  }
},
[11585] = {
  {
    'A vigília de Grito Infernal‡Бдение Адского Крика‡Höllschreis Wacht‡헬스크림의 경계‡La vigilia de Grito Infernal‡La vigilia de Grito Infernal‡La veillée de Hurlenfer‡地狱咆哮的堡垒‡地獄吼的警覺',
    nil,
    'Fale com Garrosh Grito Infernal na Fortaleza Brado Guerreiro.‡Поговорите с Гаррошем Адским Криком в крепости Песни Войны.‡Sprecht mit Garrosh Höllschrei in der Kriegshymnenfeste.‡전쟁노래 요새에 있는 가로쉬 헬스크림과 대화해야 합니다.‡Habla con Garrosh Grito Infernal en Bastión Grito de Guerra.‡Habla con Garrosh Grito Infernal en Bastión Grito de Guerra.‡Parlez à Garrosh Hurlenfer au Bastion Chanteguerre.‡与战歌要塞的加尔鲁什·地狱咆哮谈一谈。‡向戰歌堡的卡爾洛斯·地獄吼交談。',
  }
},
[11586] = {
  {
    '‡Бдение Адского Крика‡Höllschreis Wacht‡헬스크림의 경계‡La vigilia de Grito Infernal‡La vigilia de Grito Infernal‡La veillée de Hurlenfer‡地狱咆哮的堡垒‡地獄吼的警覺',
    nil,
    '‡Поговорите с Гаррошем Адским Криком в крепости Песни Войны.‡Sprecht mit Garrosh Höllschrei in der Kriegshymnenfeste.‡전쟁노래 요새에 있는 가로쉬 헬스크림과 대화해야 합니다.‡Habla con Garrosh Grito Infernal en Bastión Grito de Guerra.‡Habla con Garrosh Grito Infernal en Bastión Grito de Guerra.‡Parlez à Garrosh Hurlenfer au Bastion Chanteguerre.‡与战歌要塞的加尔鲁什·地狱咆哮谈一谈。‡向戰歌堡的卡爾洛斯·地獄吼交談。',
  }
},
[11587] = {
  {
    'Fuga da prisão‡Побег из тюрьмы‡Gefängnisausbruch‡감옥 탈출‡Rescata como puedas‡Rescata como puedas‡Faire le mur‡越狱‡劫獄',
    nil,
    'O Bibliotecário Donathan, no Promontório Âmbar, quer que você consiga algumas Chaves da Prisão de Berília de um dos Caça-magos de Berília no Penhasco de Berília e use-as para libertar magos detidos em prisões arcanas.‡По просьбе библиотекаря Донатана с Янтарной гряды добудьте берилловый магический ключ у охотника на магов в Берилловом лагере и используйте его, чтобы освободить пленного мага из магической клетки.‡Bibliothekar Donathan vom Bernsteinflöz möchte, dass Ihr den Beryllmagierjägern auf der Beryllspitze den Beryllkerkerschlüssel abnehmt und ihn dazu verwendet, die eingesperrten Magier aus ihren arkanen Gefängnissen zu befreien.‡호박석 절벽의 사서 도나단이 녹주석 거점에 있는 녹주석 마법사 사냥꾼을 처치하고 녹주석 감옥 열쇠를 얻어, 비전 감옥에 갇힌 마법사를 풀어달라고 했습니다.‡El bibliotecario Donathan en El Saliente Ámbar quiere que consigas la llave de la prisión de Berilo de alguno de los cazadores de magos de Berilo y la uses para liberar de su prisión arcana a un mago atrapado.‡El bibliotecario Donathan en El Saliente Ámbar quiere que consigas la llave de la prisión de Berilo de alguno de los cazadores de magos de Berilo y la uses para liberar de su prisión arcana a un mago atrapado.‡Le Bibliothécaire Donathan de l\'Escarpement d\'Ambre vous demande de récupérer la Clé de la prison de Béryl sur un Chasseur de mages de Béryl, à la Halte de Béryl, et de vous en servir pour libérer un mage retenu dans une Prison arcanique.‡琥珀崖的图书馆员多纳森要你前往蓝玉营地，从蓝玉法师猎手那里夺得蓝玉监狱钥匙，利用它从奥术牢笼中解救一名被囚禁的法师。‡琥珀岩臺的圖書管理員唐納森要你前往碧晶哨點，從碧晶狩法獵人身上取得碧晶監牢鑰匙，並使用鑰匙從秘法監牢釋放一位被抓住的法師。',
  }
},
[11588] = {
  {
    '‡‡‡재사용‡‡‡RÉUTILISER‡‡',
    nil,
    '‡Уничтожьте элементаля Ахуна в Непроглядной Пучине.‡Zerstört den Elementar Ahune in der Tiefschwarzen Grotte.‡검은심연 나락 안에서 정령 아훈을 처치해야 합니다.‡Destruye al elemental Ahune dentro de las Cavernas de Brazanegra.‡Destruye al elemental Ahune dentro de las Cavernas de Brazanegra.‡Détruisez l\'élémentaire Ahune dans les profondeurs de Brassenoire.‡‡',
  }
},
[11589] = {
  {
    '‡‡‡재사용‡‡‡RÉUTILISER‡‡',
    nil,
    '‡Уничтожьте элементаля Ахуна в Непроглядной Пучине.‡Zerstört den Elementar Ahune in der Tiefschwarzen Grotte.‡검은심연 나락 안에서 정령 아훈을 처치해야 합니다.‡Destruye al elemental Ahune dentro de las Cavernas de Brazanegra.‡Destruye al elemental Ahune dentro de las Cavernas de Brazanegra.‡Détruisez l\'élémentaire Ahune dans les profondeurs de Brassenoire.‡‡',
  }
},
[11590] = {
  {
    'Abdução‡Похищение‡Entführung‡포획‡Abducción‡Abducción‡Enlèvement‡调查‡綁架',
    nil,
    'Donathan quer que você use o Atador Arcano em um Feiticeiro de Berília ferido, no Penhasco de Berília, e leve-o para o Promontório Âmbar.‡Заключите в магические оковы раненого бериллового колдуна в Берилловом лагере и возвращайтесь вместе с ним к Донатану.‡Donathan möchte, dass Ihr den arkanen Binder auf einen verwundeten Beryllzauberer auf der Beryllspitze anwendet und ihn anschließend auf das Bernsteinflöz bringt.‡도나단이 녹주석 거점에서 상처입은 녹주석 마술사에게 비전 구속기를 사용하여 호박석 절벽으로 데려오라고 했습니다.‡Donathan quiere que utilices la mordaza Arcana sobre un hechicero de Berilo en Alto de Berilo y lo lleves hasta él en El Saliente Ámbar.‡Donathan quiere que utilices la mordaza Arcana sobre un hechicero de Berilo en Alto de Berilo y lo lleves hasta él en El Saliente Ámbar.‡Donathan veut que vous utilisiez le Lieur d’arcanes sur un Ensorceleur de Béryl blessé, à la Halte de Béryl, et que vous le rameniez à l’Escarpement d’Ambre.‡多纳森要你前往蓝玉营地，对一名受伤的蓝玉巫师使用奥术镣铐，并将他带回琥珀崖。‡唐納森要你在碧晶哨點對一個受傷的碧晶巫士使用秘法捆縛器。然後回到琥珀岩臺向他回報。',
  }
},
[11591] = {
  {
    'Apresente-se à Caravana do Queixoduro‡Явиться в караван Стальной Челюсти‡Meldet Euch bei Stahlkiefers Karawane‡스틸조의 짐마차로 보고하러 가기‡Preséntate en la Caravana de Quijacero‡Preséntate en la Caravana de Quijacero‡Se présenter à la caravane de Mâchoire-d\'acier‡钢腭的车队‡向鋼顎商隊回報',
    nil,
    'Fale com a Bruta Iracarpos na Caravana do Queixoduro.‡Поговорите с рубакой Десницей Гнева в караване Стальной Челюсти.‡Findet Grunzer Zornfaust. Er befindet sich bei Stahlkiefers Karawane.‡스틸조의 짐마차에서 그런트 레이지피스트와 대화해야 합니다.‡Habla con la bruta Puñofuria en la Caravana de Quijacero.‡Habla con la bruta Puñofuria en la Caravana de Quijacero.‡Parlez au Grunt Ragepoing à la Caravane de Mâchoire-d\'acier.‡前往钢腭的车队，找到步兵沃塔·怒拳。‡和鋼顎商隊的蠻兵怒拳談談。',
  }
},
[11592] = {
  {
    'Atacamos!‡Мы ударим!‡Wir schlagen zu!‡공격 개시!‡¡Atacamos!‡¡Atacamos!‡Frapper‡攻击！‡我們進攻!',
    nil,
    'Ajude o Pisaléguas Casco Honrado e seus saqueadores do Brado Guerreiro a sobreviver ao ataque contra a Caravana do Queixoduro e exterminar o espírito do Comandante-chefe Queixoduro.|n|nCaso seja bem-sucedido, apresente-se ao Lorde Supremo Bor\'gorok no Posto Avançado Bor\'gorok.‡Помогите выносливому гонцу Гордому Копыту и его налетчикам Песни Войны выжить во время нападения на караван Стальной Челюсти и прикончить дух командира соединения Стальной Челюсти.|n|nВ случае успеха доложитесь властителю Бор\'гороку на заставе Бор\'горока.‡Helft Fernläufer Stolzhuf und seinen Räubern des Kriegshymnenklans dabei, den Angriff auf Stahlkiefers Karawane zu überleben, und besiegt den Geist des Truppenkommandanten Stahlkiefer.|n|nMeldet Euch wieder bei Oberanführer Bor\'gorok, falls Ihr erfolgreich sein solltet. Er befindet sich im Außenposten Bor\'gorok.‡수색꾼 프라우드후프와 전쟁노래 공격대원을 도와 스틸조의 짐마차를 공격하는 적을 막고 전투사령관 스틸조의 영혼을 처치해야 합니다.|n|n임무를 성공적으로 수행한 다음에, 보르고로크 전초기지에 있는 대군주 보르고로크에게 보고해야 합니다.‡Ayuda al enviado Pezuña Orgullosa y a sus asaltantes Grito de Guerra a sobrevivir al ataque en la Caravana de Quijacero y a acabar con el espíritu del comandante en jefe Quijacero.|n|nSi lo consigues, informa al señor supremo Bor\'gorok en la Avanzada Bor\'gorok.‡Ayuda al enviado Pezuña Orgullosa y a sus asaltantes Grito de Guerra a sobrevivir al ataque en la Caravana de Quijacero y a acabar con el espíritu del comandante en jefe Quijacero.|n|nSi lo consigues, informa al señor supremo Bor\'gorok en la Avanzada Bor\'gorok.‡Aidez le Long-coureur Sabot-fier et ses écumeurs chanteguerre à survivre à l\'assaut contre la Caravane de Mâchoire-d\'acier et à en finir avec l\'esprit du commandant de corps Mâchoire-d\'acier.|n|nSi vous réussissez, allez faire votre rapport au Suzerain Bor\'gorok à l\'Avant-poste de Bor\'gorok.‡帮助远行者达玛·傲蹄和他的士兵突袭钢腭的车队，并杀死指挥官斯尔加·钢腭的幽灵。|n|n完成任务后，前往北风苔原的博古洛克前哨站，向博古洛克大王复命。‡幫助遠偵斥候傲蹄以及他的戰歌狼騎兵在對鋼顎商隊的攻擊中存活下來，並解決掉軍隊指揮官鋼顎的靈魂。|n|n如果成功了，就回報給博格洛克前哨的霸主博格洛克。',
  }
},
[11593] = {
  {
    'Os mortos honrados‡Последние почести‡Die geehrten Toten‡명예로운 죽음‡Homenaje a los difuntos‡Homenaje a los difuntos‡Les morts honorés‡亡者的尊严‡可敬的死者',
    nil,
    'A Bruta Iracarpos, na Caravana do Queixoduro, pediu-lhe que use a Tocha de Iracarpos para queimar qualquer combinação de 10 Guardas e Trabalhadores da Caravana Mortos.‡По просьбе рубаки Десницы Гнева близ каравана Стальной Челюсти используйте факел Десницы Гнева для сожжения мертвых стражей каравана и рабочих каравана (10 тел в любой комбинации).‡Grunzer Zornfaust bei Stahlkiefers Karawane möchte, dass Ihr mit Zornfausts Fackel insgesamt 10 tote Karawanenwachen oder -arbeiter in beliebiger Kombination einäschert.‡스틸조의 짐마차에 있는 그런트 레이지피스트가 레이지피스트의 횃불을 사용해 죽은 짐마차 경비병이나 죽은 짐마차 일꾼의 시체 10구를 불태워 달라고 했습니다.‡La bruta Puñofuria en la Caravana de Quijacero te ha pedido que uses la antorcha de Puñofuria para quemar cualquier combinación de 10 guardias y trabajadores de la caravana muertos.‡La bruta Puñofuria en la Caravana de Quijacero te ha pedido que uses la antorcha de Puñofuria para quemar cualquier combinación de 10 guardias y trabajadores de la caravana muertos.‡Le Grunt Ragepoing, à la Caravane de Mâchoire-d\'acier, vous demande d\'utiliser sa torche pour brûler un total de 10 Gardes ou Ouvriers morts de la caravane.‡钢腭的车队处的步兵沃塔·怒拳要你用火把烧掉10具车队卫兵和车队工人的遗体。‡鋼顎商隊的蠻兵怒拳要你使用她的火炬燒掉10具死亡的商隊守衛或死亡的商隊工人的屍體。',
  }
},
[11594] = {
  {
    'Descanse em paz‡Пусть обретут покой!‡Lasst sie zur Ruhe kommen‡영혼에 안식을‡Ayúdalos a encontrar la paz‡Ayúdalos a encontrar la paz‡Donnez-leur le repos‡让他们安息‡讓他們安息',
    nil,
    'Dê o descanso final a 20 espíritos taunkas dentre Sábios Fantasmagóricos e Pisaléguas Revividos. Depois, fale com a Bruta Iracarpos na Caravana do Queixoduro.‡Упокойте 20 духов таунка, фантомных ведунов либо восставших выносливых гонцов, и сообщите об этом рубаке Деснице Гнева, который ожидает в Караване Стальной Челюсти.‡Zerstört 20 Taunkageister, also entweder geisterhafte Weise oder wiederauferstandene Fernläufer, und geht anschließend zu Stahlkiefers Karawane und meldet Euch dort bei Grunzer Zornfaust.‡유령 현자나 되살아난 수색꾼 중에서 타운카 영혼 20명에게 안식을 찾아준 다음 스틸조의 짐마차에 있는 그런트 레이지피스트에게 보고해야 합니다.‡Devuelve la paz a 20 espíritus taunka, ya sean sabios fantasmales o enviados resucitados y después vuelve a informar a la bruta Puñofuria en la Caravana de Quijacero.‡Devuelve la paz a 20 espíritus taunka, ya sean sabios fantasmales o enviados resucitados y después vuelve a informar a la bruta Puñofuria en la Caravana de Quijacero.‡Détruisez 20 esprits taunkas, qui peuvent être des Sages fantomatiques ou des Long-coureurs ressuscités, puis retournez voir le Grunt Ragepoing à la Caravane de Mâchoire-d\'acier.‡让20个牦牛人的灵魂安息，幽灵先知或者复苏的远行者都可以。完成任务之后回到钢腭的车队，向步兵沃塔·怒拳复命。‡讓20個坦卡靈魂安息，不論是鬼魅賢者或者復活的遠偵斥候都行，完成後回報鋼顎商隊的蠻兵怒拳。',
  }
},
[11595] = {
  {
    '‡Оборона крепости Песни Войны‡Die Verteidigung der Kriegshymnenfeste‡전쟁노래 요새 방어‡La defensa del Bastión Grito de Guerra‡La defensa del Bastión Grito de Guerra‡La défense du bastion Chanteguerre‡战歌要塞的防御‡戰歌堡的防禦',
    nil,
    '‡Явитесь к властителю Разгору в хижине у южной стены крепости Песни Войны.‡Meldet Euch bei Oberanführer Razgor in der Hütte auf der Südseite der Kriegshymnenfeste.‡전쟁노래 요새 남쪽의 구호막사에 있는 대군주 라즈고르에게 보고해야 합니다.‡Preséntate ante el señor supremo Razgor en la barraca del flanco sur del Bastión Grito de Guerra.‡Preséntate ante el señor supremo Razgor en la barraca del flanco sur del Bastión Grito de Guerra.‡Présentez-vous au suzerain Razgor, à la hutte du côté sud du Bastion Chanteguerre.‡向战歌要塞南方小屋里的拉兹格尔大王报到。‡向霸王瑞茲葛回報，他就在戰歌堡南邊的臨時營房。',
  }
},
[11596] = {
  {
    'A defesa da Fortaleza Brado Guerreiro‡Оборона крепости Песни Войны‡Die Verteidigung der Kriegshymnenfeste‡전쟁노래 요새 방어‡La defensa del Bastión Grito de Guerra‡La defensa del Bastión Grito de Guerra‡La défense du bastion Chanteguerre‡战歌要塞的防御‡戰歌堡的防禦',
    nil,
    'Apresente-se ao Lorde Supremo Razgor, na cabana no lado sul da Fortaleza Brado Guerreiro.‡Доложитесь властителю Разгору, находящемуся в хижине на южной стороне крепости Песни Войны.‡Meldet Euch bei Oberanführer Razgor in der Hütte auf der Südseite der Kriegshymnenfeste.‡전쟁노래 요새 남쪽의 막사에 있는 대군주 라즈고르에게 보고해야 합니다.‡Preséntate ante el señor supremo Razgor en la barraca del flanco sur del Bastión Grito de Guerra.‡Preséntate ante el señor supremo Razgor en la barraca del flanco sur del Bastión Grito de Guerra.‡Présentez-vous au suzerain Razgor, à la hutte du côté sud du Bastion Chanteguerre.‡向战歌要塞南方小屋里的拉兹格尔大王报到。‡向霸王瑞茲葛回報，他就在戰歌堡南邊的臨時營房。',
  }
},
[11597] = {
  {
    '‡Оборона крепости Песни Войны‡Die Verteidigung der Kriegshymnenfeste‡전쟁노래 요새 방어‡La defensa del Bastión Grito de Guerra‡La defensa del Bastión Grito de Guerra‡La défense du bastion Chanteguerre‡战歌要塞的防御‡戰歌堡的防禦',
    nil,
    '‡Явитесь к властителю Разгору в хижине у южной стены крепости Песни Войны.‡Meldet Euch bei Oberanführer Razgor in der Hütte auf der Südseite der Kriegshymnenfeste.‡전쟁노래 요새 남쪽의 막사에 있는 대군주 라즈고르에게 보고해야 합니다.‡Preséntate ante el señor supremo Razgor en la barraca del flanco sur del Bastión Grito de Guerra.‡Preséntate ante el señor supremo Razgor en la barraca del flanco sur del Bastión Grito de Guerra.‡Présentez-vous au suzerain Razgor, à la hutte du côté sud du Bastion Chanteguerre.‡向战歌要塞南方小屋里的拉兹格尔大王报到。‡向霸王瑞茲葛回報，他就在戰歌堡南邊的臨時營房。',
  }
},
[11598] = {
  {
    'Retomada da Pedreira do Megalito‡Отвоевывание карьера Камня Силы‡Den Großfelsbruch zurückerobern‡퇴마석 채석장 탈환‡La reconquista de la Cantera de Piedra de Poderío‡La reconquista de la Cantera de Piedra de Poderío‡Reprendre la carrière de pierres de pouvoir‡夺回巨石采掘场‡奪回力石礦場',
    nil,
    'O Lorde Supremo Razgor, na Fortaleza Brado Guerreiro, quer que você mate 15 Nerubianos Nerub\'ar.‡По заданию властителя Разгора из крепости Песни Войны убейте 15 неруб\'арцев.‡Oberanführer Razgor in der Kriegshymnenfeste möchte, dass Ihr 15 Neruber der Nerub\'ar tötet.‡전쟁노래 요새의 대군주 라즈고르가 네룹아르 네루비안 15마리를 처치해 달라고 했습니다.‡El señor supremo Razgor en el Bastión Grito de Guerra quiere que mates a 15 nerubianos Nerub\'ar.‡El señor supremo Razgor en el Bastión Grito de Guerra quiere que mates a 15 nerubianos Nerub\'ar.‡Le suzerain Razgor du Bastion Chanteguerre vous demande de tuer 15 Nérubiens nérub\'ar.‡战歌要塞的拉兹格尔大王要你杀死15只尼鲁巴尔蛛魔。‡戰歌堡的霸王瑞茲葛要你殺死15隻奈幽巴奈幽蟲族。',
  }
},
[11599] = {
  {
    'Thassarian, meu irmão‡Тассариан, мой брат‡Mein Bruder Thassarian‡나의 오빠, 타사리안‡Thassarian, hermano mío‡Thassarian, hermano mío‡Thassarian, mon frère‡萨萨里安，我的哥哥‡薩沙理安，我的兄長',
    nil,
    'Procure por Guilherme Benford dentro da mina de Algures.‡Найти Вильяма Аллертона в шахте Далечья.‡Sucht nach William Allerton im Inneren der Mine von Fernhain.‡아득골에 있는 광산 안에서 윌리엄 알러턴을 찾아야 합니다.‡Busca a William Allerton en la Mina de Lindeallá.‡Busca a William Allerton en la Mina de Lindeallá.‡Partez à la recherche de William Allerton à l\'intérieur de la Mine de Comté-lointaine.‡前往致远郡矿洞，寻找威廉·奥雷顿。‡去找遠郡礦坑的威廉·愛勒頓。',
  }
},
[11600] = {
  {
    'O falecido Guilherme Benford‡Последние новости о Вильяме Аллертоне‡Der verstorbene William Allerton‡윌리엄 알러턴의 최후‡El difunto William Allerton‡El difunto William Allerton‡Feu William Allerton‡威廉·奥雷顿之死‡已故的威廉·愛勒頓',
    nil,
    'Leve a Ficha de Alistamento para Leryssa na Bastilha Valentia, na Tundra Boreana.‡Отнесите воинское удостоверение Лериссе в Крепость Отваги в Борейской тундре.‡Bringt den Einberufungsbescheid zu Leryssa in die Valianzfeste in der Boreanischen Tundra.‡북풍의 땅의 용맹의 성채에 있는 레리사에게 군인증을 가져가야 합니다.‡Llévale la tarjeta de alistamiento a Leryssa a la Fortaleza Denuedo, en la Tundra Boreal.‡Llévale la tarjeta de alistamiento a Leryssa a la Fortaleza Denuedo, en la Tundra Boreal.‡Apportez la Carte d\'enrôlement à Leryssa au Donjon de la Bravoure, dans la Toundra Boréenne.‡将征兵通知书交给北风苔原无畏要塞中的莉蕾萨。‡到北風凍原的驍勇要塞，把招募卡帶給蕾瑞莎。',
  }
},
[11601] = {
  {
    'Achado e perdido‡Потерянный и обретенный‡Verloren und wiedergefunden‡잃은 것과 얻은 것‡Perdido y hallado‡Perdido y hallado‡Objets trouvés‡柳暗花明‡尋人',
    nil,
    'Fale com Tiago Decano, na estalagem da Bastilha Valentia.‡Поговорите с Джеймсом Диконом в таверне в Крепости Отваги.‡Sprecht mit James Diakon im Gasthaus der Valianzfeste.‡용맹의 성채의 여관에 있는 제임스 디콘과 대화해야 합니다.‡Habla con James Diácono en la posada de la Fortaleza Denuedo.‡Habla con James Diácono en la posada de la Fortaleza Denuedo.‡Parlez à James Lediacre à l’auberge du Donjon de la Bravoure.‡与无畏要塞旅店里的詹姆斯·迪肯谈一谈。‡到驍勇要塞的旅館找詹姆士·戴肯談談。',
  }
},
[11602] = {
  {
    'Cortando pela raiz‡Прервать на корню‡Von der Quelle abschneiden‡원천봉쇄‡Elimina el problema de raíz‡Elimina el problema de raíz‡Assécher la source‡切断虫源‡切斷來源',
    nil,
    'O Lorde Supremo Razgor, na Fortaleza Brado Guerreiro, quer que você destrua 10 Bolsas de Ovos de Nerub\'ar.‡По поручению властителя Разгора, находящегося в крепости Песни Войны, уничтожьте 10 неруб\'арских яиц.‡Oberanführer Razgor in der Kriegshymnenfeste möchte, dass Ihr 10 Eiersäcke der Nerub\'ar zerstört.‡전쟁노래 요새의 대군주 라즈고르가 네룹아르 알 주머니 10개를 없애 달라고 했습니다.‡El señor supremo Razgor, en el Bastión Grito de Guerra, quiere que destruyas 10 sacos de huevos Nerub\'ar.‡El señor supremo Razgor, en el Bastión Grito de Guerra, quiere que destruyas 10 sacos de huevos Nerub\'ar.‡Le suzerain Razgor du Bastion Chanteguerre vous demande de détruire 10 Cocons d\'œufs nérub\'ar.‡战歌要塞的拉兹格尔大王要你摧毁10个尼鲁巴尔蛛卵簇。‡戰歌堡的霸王瑞茲葛要你摧毀10個奈幽巴卵囊。',
  }
},
[11603] = {
  {
    'In vino veritas‡Истина в вине‡In vino veritas‡포도주에 담긴 진실‡In vino veritas‡In vino veritas‡In vino veritas‡酒中的真相‡酒後吐真言',
    nil,
    'Consiga uma garrafa de Vinho de Kul Tiraz dos destroços do navio afundado, a nordeste da Bastilha Valentia, e leve-o para o Velho Calpúrnio, na Bastilha Valentia.‡Раздобудьте бутылку кул-тирасского вина на месте кораблекрушения к северо-востоку от Крепости Отваги и принесите старику Колберну в таверну в Крепости Отваги.‡Bergt eine Flasche Wein der Kul Tiras aus dem gesunkenen Schiffswrack nordöstlich der Valianzfeste und bringt sie zum alten Paßbrand im Gasthaus der Valianzfeste.‡용맹의 성채 북동쪽 물속에 있는 난파선에서 쿨 티라스 포도주 한 병을 구해 용맹의 성채 여관에 있는 노인 콜번에게 가져가야 합니다.‡Recupera una botella de vino de Kul Tiras del barco hundido al noreste de la Fortaleza Denuedo y llévasela al viejo Colburn en la posada de la Fortaleza Denuedo.‡Recupera una botella de vino de Kul Tiras del barco hundido al noreste de la Fortaleza Denuedo y llévasela al viejo Colburn en la posada de la Fortaleza Denuedo.‡Repêchez une bouteille de Vin de Kul Tiras dans l’épave, au nord-est du Donjon de la Bravoure, et apportez-la au Vieux Colburn à l\'auberge du Donjon de la Bravoure.‡从无畏要塞东北方的船只残骸附近打捞一瓶库尔提拉斯葡萄酒，把它交给无畏要塞旅店里的老人科布恩。‡去驍勇要塞東北邊的船難殘骸打撈一瓶庫爾提拉斯葡萄酒，然後將它帶給驍勇要塞旅店裡的老人寇爾本。',
  }
},
[11604] = {
  {
    'Um desertor‡Дезертир‡Ein Deserteur‡탈영병‡Un desertor‡Un desertor‡Un déserteur‡逃兵‡逃兵',
    nil,
    'Ache a prisão dentro da Fortaleza Interior, na Bastilha Valentia, e fale com o desertor.‡Найдите тюрьму во Внутренней крепости Отваги и поговорите с дезертиром.‡Findet das Gefängnis in der inneren Festung der Valianzfeste und sprecht mit dem Deserteur.‡용맹의 성채의 내부 성채에 있는 탈영병과 대화해야 합니다.‡Encuentra la cárcel dentro del cuartel en la Fortaleza Denuedo y habla con el desertor.‡Encuentra la cárcel dentro del cuartel en la Fortaleza Denuedo y habla con el desertor.‡Trouvez la prison dans le Bastion intérieur du Donjon de la Bravoure et parlez au déserteur.‡进入无畏要塞兵营内的监狱，与关在那里的逃兵谈一谈。‡到驍勇要塞的內堡尋找囚犯，並與這位逃兵談談。',
  }
},
[11605] = {
  {
    'Os honrados ancestrais‡Досточтимые предки‡Die geehrten Ahnen‡영예로운 선조‡Homenaje a los ancestros‡Homenaje a los ancestros‡Les ancêtres honorés‡海象人的先祖‡尊榮的先祖',
    nil,
    'Ancião Atkanok, que se encontra fora da Pedreira da Rocha Fria, quer que você identifique as estátuas do Ancião Kesuk, do Ancião Sagani e do Ancião Takret.‡По просьбе старейшины Атканока, находящегося у карьера Ледяного Булыжника, отыщите статуи, предназначенные для старейшины Кесука, старейшины Сагани и старейшины Такрета.‡Ältester Atkanok außerhalb des Froststeinbruchs möchte, dass Ihr die Statuen des Ältesten Kesuk, Ältesten Sagani und Ältesten Takret identifiziert.‡얼음바위 채석장 변두리에 있는 장로 아트카노크가 장로 케수크, 장로 사가니, 장로 타크릿의 조각상을 판독해 달라고 했습니다.‡El ancestro Atkanok a las afueras de la Cantera Frioescollo quiere que identifiques las estatuas del ancestro Kesuk, el ancestro Sagani y del ancestro Takret.‡El ancestro Atkanok a las afueras de la Cantera Frioescollo quiere que identifiques las estatuas del ancestro Kesuk, el ancestro Sagani y del ancestro Takret.‡L\'Ancien Atkanok, à l\'extérieur de la Carrière de Rochefroide, vous demande d\'identifier les statues de l\'Ancien Kesuk, l\'Ancien Sagani et l\'Ancien Takret.‡冷石采掘场外的长者阿特卡诺克要你找到长者克苏克、长者萨加尼和长者塔克勒特的石像。‡冷岩礦場外的阿特那克長老需要你分辨出長者凱蘇克、長者撒加尼、還有長者塔克瑞特的石雕在何處。',
  }
},
[11606] = {
  {
    'Paciência é uma virtude que dispensamos‡Терпение – добродетель, которая не требуется‡Geduld ist eine Tugend, die wir nicht brauchen‡인내심은 불필요한 미덕‡La paciencia es una virtud que no necesitamos‡La paciencia es una virtud que no necesitamos‡La patience, une vertu dont nous nous passerons bien‡耐心是我们不需要的美德‡耐心正是我們不需要的美德',
    nil,
    'O Intendente Holgoth, na Fortaleza Brado Guerreiro, quer que você recupere 15 caixas de Munições do Brado Guerreiro.‡По поручению интенданта Холгота раздобудьте 15 ящиков с боеприпасами Песни Войны.‡Rüstmeister Holgoth in der Kriegshymnenfeste möchte, dass Ihr 15 Kisten mit Munition des Kriegshymnenklans besorgt.‡전쟁노래 요새의 병참장교 홀고스가 전쟁노래 군수품 15개를 되찾아 달라고 했습니다.‡El intendente Holgoth en el Bastión Grito de Guerra quiere que recuperes 15 cajones de municiones Grito de Guerra.‡El intendente Holgoth en el Bastión Grito de Guerra quiere que recuperes 15 cajones de municiones Grito de Guerra.‡L\'intendant Holgoth, au Bastion Chanteguerre, vous demande de récupérer 15 caisses de Munitions chanteguerres.‡战歌要塞的军需官霍尔古斯要你找回15箱战歌军需品。‡戰歌堡的軍需官侯加斯要你去取回15箱戰歌軍火。',
  }
},
[11607] = {
  {
    'Os espíritos perdidos‡Заблудшие духи‡Verlorene Geister‡구속된 영혼들‡Los espíritus perdidos‡Los espíritus perdidos‡Les esprits égarés‡失落的灵魂‡迷失的靈魂',
    nil,
    'Ancião Atkanok, que se encontra fora da Pedreira da Rocha Fria, quer que você liberte os espíritos de 3 Artesãos de Kaskala e 3 Xamãs de Kaskala.‡Освободите дух 3 ремесленников клана Каскала и 3 шаманов клана Каскала по просьбе старейшины Атканока в окрестностях карьера Ледяного Булыжника.‡Ältester Atkanok am äußeren Rand des Froststeinbruchs möchte, dass ihr die Geister von 3 Handwerkern von Kaskala und 3 Schamanen von Kaskala befreit.‡얼음바위 채석장 변두리에 있는 장로 아트카노크가 카스칼라 장인 3명과 카스칼라 주술사 3명의 영혼을 해방해 달라고 했습니다.‡El ancestro Atkanok a las afueras de la Cantera Frioescollo quiere que liberes a los espíritus de 3 artesanos de Kashala y de 3 chamanes de Kashala.‡El ancestro Atkanok a las afueras de la Cantera Frioescollo quiere que liberes a los espíritus de 3 artesanos de Kashala y de 3 chamanes de Kashala.‡L\'Ancien Atkanok, à la lisière de la Carrière de Rochefroide, vous demande de libérer les esprits de 3 Artisans de Kaskala et 3 Chamans de Kaskala.‡冷石采掘场外的长者阿特卡诺克要你释放3名卡斯卡拉工匠和3名卡斯卡拉萨满祭司的灵魂。‡冷岩礦場外區的阿特那克長老要你去釋放3個卡斯卡拉工匠和3個卡斯卡拉薩滿的靈魂。',
  }
},
[11608] = {
  {
    'Soterre as baratas!‡Засыпать тараканьи норы!‡Begrabt diese Kakerlaken!‡해충 박멸!‡¡Entierra a esas cucarachas!‡¡Entierra a esas cucarachas!‡Enterrez-moi ces cafards !‡活埋了那些蟑螂！‡把那些蟑螂埋起來!',
    nil,
    'O Intendente Holgoth, na Fortaleza Brado Guerreiro, quer que você use as Cargas de Profundidade de Cequatrum para destruir as fossas Nerub\'ar ao sul, leste, oeste e norte da Fortaleza Brado Guerreiro.‡По поручению интенданта Холгота используйте сверток с глубинными сефориевыми зарядами для уничтожения неруб\'арских воронок к югу, востоку, западу и северу от крепости Песни Войны.‡Rüstmeister Holgoth in der Kriegshymnenfeste möchte, dass Ihr mithilfe des Bündels mit Zephyriumsprengsätzen die Schlundlöcher der Nerub\'ar zerstört. Diese befinden sich südlich, östlich, westlich und nördlich der Kriegshymnenfeste.‡전쟁노래 요새의 병참장교 홀고스가 시포리움 지하 폭탄 묶음을 사용해 전쟁노래 요새의 동, 서, 남, 북쪽에 있는 네룹아르 구덩이를 파괴해 달라고 했습니다.‡El intendente Holgoth en el Bastión Grito de Guerra quiere que uses el fajo de cargas de profundidad de seforio para destruir los sumideros Nerub\'ar al sur, este, oeste y norte del Bastión Grito de Guerra.‡El intendente Holgoth en el Bastión Grito de Guerra quiere que uses el fajo de cargas de profundidad de seforio para destruir los sumideros Nerub\'ar al sur, este, oeste y norte del Bastión Grito de Guerra.‡L\'intendant Holgoth, au Bastion chanteguerre, vous demande d\'utiliser le Paquet de charges de profondeur à l\'hydroglycérine pour détruire les puisards nérub\'ar au sud, à l\'est, à l\'ouest et au nord du Bastion Chanteguerre.‡战歌要塞的军需官霍尔古斯要你利用高能爆盐炸药包摧毁要塞东西南北四个方向的尼鲁巴尔虫孔。‡戰歌堡的軍需官侯加斯要你使用爆鹽深水炸藥包裹來摧毀南方、東方、西方和北方的奈幽巴坑道口。',
  }
},
[11609] = {
  {
    'Juntando as peças‡Сбор ритуальных предметов‡Die Reste beseitigen‡유물 회수‡Recoger los pedazos‡Recoger los pedazos‡Ramasser les morceaux‡寻找古器‡撿起碎片',
    nil,
    'Traga 6 Objetos Rituais Morsanos para o Ancião Atkanok, que se encontra fora da Pedreira da Rocha Fria.‡Принесите 6 клыкаррских ритуальных предметов старейшине Атканоку, который стоит у карьера Ледяного Булыжника.‡Bringt Ältester Atkanok 6 Ritualobjekte der Tuskarr. Er befindet sich außerhalb des Froststeinbruchs.‡얼음바위 채석장 변두리에 있는 장로 아트카노크에게 투스카르 의식용 화로 6개를 가져가야 합니다.‡Llévale 6 objetos rituales colmillarr al ancestro Atkanok, que se encuentra fuera de la Cantera Frioescollo.‡Llévale 6 objetos rituales colmillarr al ancestro Atkanok, que se encuentra fuera de la Cantera Frioescollo.‡Apportez 6 Objets rituels roharts à l\'Ancien Atkanok, qui se trouve à l\'extérieur de la Carrière de Rochefroide.‡将6个海象人仪式道具交给冷石采掘场外的长者阿特卡诺克。‡帶6個巨牙海民儀式物品交給阿特那克長老，他就站在冷岩礦場的外面。',
  }
},
[11610] = {
  {
    'A volta para casa‡Возвращение предков‡Die Ahnen nach Hause führen‡선조에게 안식을‡Llevar a los ancestros a casa‡Llevar a los ancestros a casa‡Conduire les ancêtres chez eux‡先祖的回归‡引領先祖返家',
    nil,
    'O Ancião Atkanok quer que você guie o espírito do Ancião Kesuk, do Ancião Sagani e do Ancião Takret para seus monumentos de pedra.‡По просьбе старейшины Атканока проведите духов старейшины Кесука, старейшины Сагани и старейшины Такрета в их каменные изваяния.‡Ältester Atkanok möchte, dass Ihr die Geister des Ältesten Kesuk, Ältesten Sagani und Ältesten Takret zu ihren Steinmonumenten geleitet.‡장로 아트카노크가 장로 케수크, 장로 사가니, 장로 타크릿의 영혼을 각자의 바위 기념비로 인도해 달라고 했습니다.‡El ancestro Atkanok quiere que guíes a los espíritus del ancestro Kesuk, del ancestro Sagani y del ancestro Takret hasta sus monumentos de piedra.‡El ancestro Atkanok quiere que guíes a los espíritus del ancestro Kesuk, del ancestro Sagani y del ancestro Takret hasta sus monumentos de piedra.‡L\'Ancien Atkanok vous demande de guider les esprits des Anciens Kesuk, Sagani et Takret jusqu\'à leurs monuments de pierre respectifs.‡长者阿特卡诺克要你指引长者克苏克、长者萨加尼和长者塔克勒特的灵魂回到各自的石像中。‡阿特那克長老要你引領長者凱蘇克、長者撒加尼、還有長者塔克瑞特的靈魂到他們的石雕紀念像中。',
  }
},
[11611] = {
  {
    'Levados pelo Flagelo‡Захваченные Плетью‡Von der Geißel eingenommen‡스컬지의 거미줄에서‡Retenidos por la Plaga‡Retenidos por la Plaga‡Pris par le Fléau‡被掠走的苦工‡被天譴軍抓走',
    nil,
    'O Encarregado Mortuus, na Fortaleza Brado Guerreiro, quer que você liberte 5 Peões do Brado Guerreiro.‡По заданию штейгера Мортия из Крепости Песни Войны освободите 5 батраков клана Песни Войны.‡Großknecht Mortuus in der Kriegshymnenfeste möchte, dass Ihr 5 Peons des Kriegshymnenklans befreit.‡전쟁노래 요새의 현장감독 모르투스가 전쟁노래 일꾼 5명을 풀어달라고 했습니다.‡El supervisor Mortuus del Bastión Grito de Guerra quiere que liberes 5 peones Grito de Guerra.‡El supervisor Mortuus del Bastión Grito de Guerra quiere que liberes 5 peones Grito de Guerra.‡Le Contremaître Mortuus au Bastion Chanteguerre veut que vous libériez 5 Péons chanteguerre.‡战歌要塞的工头摩尔图斯要你释放5个战歌苦工。‡戰歌堡的工頭莫吐斯要你將5名戰歌苦工救出來。',
  }
},
[11612] = {
  {
    'Retomada da pedreira‡Бой за карьер‡Den Steinbruch zurückerobern‡채석장 탈환‡Recuperar la cantera‡Recuperar la cantera‡Reprendre la carrière‡夺回采掘场‡收復礦場',
    nil,
    'Etaruk, acampado perto da entrada da Pedreira da Rocha Fria, quer que você mate 12 Caçadores de Tesouro de Berília.‡По просьбе Этарука, находящегося у входа в карьер Ледяного Булыжника, убейте 12 берилловых охотников за сокровищами.‡Etaruk möchte, dass Ihr 12 Beryllschatzjäger tötet. Er befindet sich in der Nähe des Eingangs zum Froststeinbruch.‡얼음바위 채석장의 입구 근처에서 야영 중인 에타루크가 녹주석 보물 사냥꾼 12명을 제거해 달라고 했습니다.‡Etaruk, que está acampado cerca de la entrada a la Cantera Frioescollo, quiere que mates a 12 cazatesoros de Berilo.‡Etaruk, que está acampado cerca de la entrada a la Cantera Frioescollo, quiere que mates a 12 cazatesoros de Berilo.‡Etaruk, qui campe près de l\'entrée de la Carrière de Rochefroide, vous demande de tuer 12 Chasseurs de trésor de Béryl.‡冷石采掘场入口附近的伊塔鲁克要你杀死12名蓝玉财宝猎人。‡冷岩礦場入口附近的依塔魯克要你殺死12個碧晶寶藏獵人。',
  }
},
[11613] = {
  {
    'O juramento de Karuk‡Клятва Карука‡Karuks Schwur‡카루크의 맹세‡El juramento de Karuk‡El juramento de Karuk‡Le serment de Karuk‡卡鲁克的誓言‡卡魯克的誓約',
    nil,
    'Karuk quer que você mate 6 Saqueadores Skadir e 5 Barqueiros Skadir.‡По просьбе Карука убейте 6 скадирских налетчиков и 5 скадирских лодочников.‡Karuk möchte, dass Ihr 6 Räuber der Skadir und 5 Langbootsmänner der Skadir tötet.‡카루크가 스카디르 침략자 6명과 스카디르 구명요원 5명을 처치해 달라고 했습니다.‡Karuk quiere que mates a 6 asaltantes Skadir y a 5 barqueros Skadir.‡Karuk quiere que mates a 6 asaltantes Skadir y a 5 barqueros Skadir.‡Karuk vous demande de tuer 6 Ecumeurs skadir et 5 Skadirs d\'équipage.‡卡鲁克希望你杀死6个斯卡迪尔袭击者和5个斯卡迪尔船工。‡卡魯克要你殺死6個斯卡迪爾劫掠者和5個斯卡迪爾長船水手。',
  }
},
[11614] = {
  {
    'Verdades não ditas‡Невысказанные истины‡Schweigen ist Gold‡숨겨진 진실‡Verdades jamás contadas‡Verdades jamás contadas‡Vérités tues‡隐藏的真相‡沒說出口的事實',
    nil,
    'Encontre o Assombrante Luther na Pedreira do Megalito.‡Отыщите тенелова Лютера в карьере Камня Силы.‡Findet Schattenpirscher Luther im Großfelsbruch.‡퇴마석 채석장에서 그림자추적자 루터를 찾아야 합니다.‡Encuentra al acechasombras Luther en la Cantera Piedra de Poderío.‡Encuentra al acechasombras Luther en la Cantera Piedra de Poderío.‡Trouvez le Traqueur des ombres Luther dans la Carrière de pierres de pouvoir.‡前往巨石采掘场寻找暗影密探卢瑟尔。‡找到力石礦場的巡影者盧瑟。',
  }
},
[11615] = {
  {
    'Segredos de Nerub\'ar‡Неруб\'арские тайны‡Geheimnisse der Nerub\'ar‡네룹아르의 비밀‡Secretos Nerub\'ar‡Secretos Nerub\'ar‡Les secrets nérub\'ar‡尼鲁巴尔的秘密‡奈幽巴秘密',
    nil,
    'Leve o Diário do Luther para o Assombrante Barthus, na Fortaleza Brado Guerreiro.‡Доставьте дневник Лютера тенелову Бартусу в Крепость Песни Войны.‡Bringt Luthers Tagebuch zu Schattenpirscher Barthus in der Kriegshymnenfeste.‡루터의 일지를 전쟁노래 요새에 있는 그림자추적자 바르투스에게 가져가야 합니다.‡Llévale el diario de Luther al acechasombras Barthus al Bastión Grito de Guerra.‡Llévale el diario de Luther al acechasombras Barthus al Bastión Grito de Guerra.‡Apportez le Journal de Luther au Traqueur des ombres Barthus au Bastion Chanteguerre.‡把卢瑟尔的日记交给战歌要塞的暗影密探巴尔苏斯。‡帶著盧瑟的日記給戰歌堡的巡影者巴素司。',
  }
},
[11616] = {
  {
    'Mensagem para Grito Infernal‡Послание Адскому Крику‡Nachricht an Höllschrei‡헬스크림에게 전해야 할 소식‡Mensaje para Grito Infernal‡Mensaje para Grito Infernal‡Un message pour Hurlenfer‡通知地狱咆哮‡傳信給地獄吼',
    nil,
    'Leve o Bilhete do Barthus para Garrosh Grito Infernal, na Fortaleza Brado Guerreiro.‡Отнесите записку Бартуса Гаррошу Адскому Крику в крепости Песни Войны.‡Bringt Barthus\' Notiz zu Höllschrei in der Kriegshymnenfeste.‡바르투스의 쪽지를 전쟁노래 요새에 있는 가로쉬 헬스크림에게 전해야 합니다.‡Llévale la nota de Barthus a Garrosh Grito Infernal al Bastión Grito de Guerra.‡Llévale la nota de Barthus a Garrosh Grito Infernal al Bastión Grito de Guerra.‡Apportez la Note de Barthus à Garrosh Hurlenfer au Bastion Chanteguerre.‡把巴尔苏斯的便笺交给战歌要塞的加尔鲁什·地狱咆哮。‡帶著巴素司的便箋給戰歌堡的卡爾洛斯·地獄吼。',
  }
},
[11617] = {
  {
    'Dificultando a fuga‡Никто не должен уйти‡Ihre Flucht vereiteln‡퇴로 차단‡Impedir que escapen‡Impedir que escapen‡Gênez leur départ‡别让他们逃了！‡阻礙他們的逃脫',
    nil,
    'Etaruk, fora da Pedreira da Rocha Fria, quer que você destrua a Plataforma Norte, a Plataforma Leste e a Plataforma Oeste.‡По поручению Этарука из карьера Ледяного Булыжника уничтожьте Северную, Восточную и Западную платформы.‡Etaruk möchte, dass ihr die nördliche Plattform, die östliche Plattform und die westliche Plattform zerstört. Er befindet sich außerhalb des Froststeinbruchs.‡얼음바위 채석장 밖에 있는 에타루크가 북쪽 단, 동쪽 단, 서쪽 단을 파괴해 달라고 했습니다.‡Etaruk, fuera de la Cantera Frioescollo, quiere que destruyas la plataforma norte, la plataforma este y la plataforma oeste.‡Etaruk, fuera de la Cantera Frioescollo, quiere que destruyas la plataforma norte, la plataforma este y la plataforma oeste.‡Etaruk, à l\'extérieur de la Carrière de Rochefroide, vous demande de détruire la Plateforme nord, la Plateforme est et la Plateforme ouest.‡冷石采掘场外的伊塔鲁克要你摧毁北部平台、东部平台和西部平台。‡冷岩礦場外的伊塔魯克要你摧毀北部平臺、東部平臺和西部平臺。',
  }
},
[11618] = {
  {
    'Reforços vindouros...‡Подкрепление на подходе…‡Verstärkung trifft ein...‡증원군 접근 중...‡Llegan los refuerzos...‡Llegan los refuerzos...‡Et voilà les renforts...‡增援来了……‡援軍到來……',
    nil,
    'Procure o Assombrante Ickoris, no Acampamento das Fazendas Brado Guerreiro a oeste da Fortaleza Brado Guerreiro.‡Отыщите тенелова Икориса на заставе у ферм Песни Войны к западу от крепости Песни Войны.‡Macht Schattenpirscher Ickoris ausfindig. Er befindet sich bei den Höfen des Kriegshymnenklans westlich der Kriegshymnenfeste.‡전쟁노래 요새의 서쪽에 있는 전쟁노래 농장 전진기지에서 그림자추적자 이코리스를 찾아야 합니다.‡Busca al acechasombras Ickoris en las Granjas Grito de Guerra al oeste del Bastión Grito de Guerra.‡Busca al acechasombras Ickoris en las Granjas Grito de Guerra al oeste del Bastión Grito de Guerra.‡Allez trouver le Traqueur des ombres Ickoris à l\'Avant-poste des fermes chanteguerres, à l\'ouest du Bastion Chanteguerre.‡前往战歌要塞西边的战歌农场哨站，向暗影密探伊克里斯报到。‡找到巡影者艾寇里斯，他就在戰歌堡西邊的戰歌農場前哨。',
  }
},
[11619] = {
  {
    'Gamel, o Cruel‡Геймел Жестокий‡Gamel der Grausame‡잔혹한 가멜‡Gamel el Cruel‡Gamel el Cruel‡Gamel le Cruel‡残忍的贾梅尔‡『殘酷』加邁爾',
    nil,
    'Karuk quer que você derrote Gamel, o Cruel, no Areal Quebramar.‡Убейте Геймела Жестокого с Берега Терзающего Бича по просьбе Карука.‡Karuk möchte, dass Ihr Gamel den Grausamen tötet. Er befindet sich am Strand der Peitschennarbe.‡카루크가 채찍파도 해안에 있는 잔혹한 가멜을 처치해 달라고 했습니다.‡Karuk quiere que derrotes a Gamel el Cruel en el Litoral Tralladón.‡Karuk quiere que derrotes a Gamel el Cruel en el Litoral Tralladón.‡Karuk vous demande de triompher de Gamel le Cruel sur la Grève des Courcinglants.‡卡鲁克希望你前往裂鞭海岸，击败残忍的贾梅尔。‡卡魯克要你擊敗裂鞭水岸的『殘酷』加邁爾。',
  }
},
[11620] = {
  {
    'As palavras de um pai‡Отцовские слова‡Eines Vaters Wort‡아버지의 유언‡Las palabras de un padre‡Las palabras de un padre‡Les paroles d\'un père‡父亲的话‡父親的話',
    nil,
    'Procure por Veehja no Altar das Escamas, no Areal Quebramar.‡Поищите Вихью у святилища Чешуи на берегу Терзающего Бича.‡Geht zum Schrein der Schuppen auf dem Strand der Peitschennarbe und haltet dort nach Veehja Ausschau.‡채찍파도 해안의 비늘 제단에 있는 비야를 찾아야 합니다.‡Busca a Veehja en el Santuario de Escamas en el Litoral Tralladón.‡Busca a Veehja en el Santuario de Escamas en el Litoral Tralladón.‡Partez à la recherche de Veehja dans le Sanctuaire des Écailles de la Grève des Courcinglants.‡前往裂鞭海岸的蛇鳞神殿寻找维赫亚。‡在裂鞭水岸的群鱗聖壇找到薇迦。',
  }
},
[11621] = {
  {
    'A tabuleta de Leviroth‡Табличка Левирота‡Leviroths Tafel‡레비로스의 서판‡La tablilla de Leviroth‡La tablilla de Leviroth‡La tablette de Leviroth‡利维洛斯石板‡萊維羅希的石板',
    nil,
    'Fale com Karuk sobre a informação que você encontrou na tabuleta.‡Возвращайтесь к Каруку с информацией, обнаруженной вами на табличке.‡Kehrt zu Karuk zurück und überbringt ihm die Information, die Ihr auf der Tafel gefunden habt.‡카루크에게 돌아가 서판에서 알아낸 정보를 알려줘야 합니다.‡Vuelve a ver a Karuk con la información que has encontrado en la tablilla.‡Vuelve a ver a Karuk con la información que has encontrado en la tablilla.‡Retournez voir Karuk avec les informations que vous avez trouvées sur la tablette.‡将你在石板上发现的信息告诉卡鲁克。‡把你在石板上找到的訊息告訴卡魯克。',
  }
},
[11622] = {
  {
    '‡Тайны Терзающего Бича‡Geheimnisse der Peitschennarbe‡채찍파도의 비밀‡Secretos de Tralladón‡Secretos de Tralladón‡Les secrets des Courcinglants‡裂鞭海岸的秘密‡',
    nil,
    '‡Найдите Вихью на развалинах Терзающего Бича в Борейской тундре.‡Sucht in den Ruinen der Peitschennarbe in der Boreanischen Tundra nach Veehja und sprecht mit ihr.‡북풍의 땅에 있는 채찍파도 해안의 폐허에서 비야를 찾아야 합니다.‡Encuentra a Veehja en las ruinas de Tralladón en la Tundra Boreal.‡Encuentra a Veehja en las ruinas de Tralladón en la Tundra Boreal.‡Trouvez Veehja dans les Ruines des Courcinglants de la toundra Boréenne.‡在北风苔原的裂鞭废墟寻找维赫亚。‡',
  }
},
[11623] = {
  {
    'Uma visita ao curador‡Визит к смотрителю‡Ein Besuch beim Kurator‡관리인 처치‡Una visita al comisario‡Una visita al comisario‡En visite chez le conservateur‡拜访馆长‡拜訪監管者',
    nil,
    'Etaruk, nos limites da Pedreira da Rocha Fria, quer que você mate o Curador Insivius.‡По заданию Этарука с края карьера Ледяного Булыжника убейте смотрителя Инзивиуса.‡Etaruk am äußeren Rand des Frostfelssteinbruchs möchte, dass Ihr Kurator Insivius tötet.‡얼음바위 채석장의 밖에 있는 에타루크가 관리인 인시비우스를 처치해 달라고 했습니다.‡Etaruk, en las afueras de la Cantera Frioescollo, quiere que mates al comisario Insivius.‡Etaruk, en las afueras de la Cantera Frioescollo, quiere que mates al comisario Insivius.‡Etaruk, à la lisière de la Carrière de Rochefroide, vous demande de tuer le Conservateur Insivius.‡冷石采掘场入口附近的伊塔鲁克要你杀死馆长因萨维斯。‡冷岩礦場郊區的伊塔魯克要你殺死監管者殷希維俄。',
  }
},
[11624] = {
  {
    'Os céus saberão‡Небо знает‡Der Himmel wird es wissen‡하늘이 안다‡El cielo lo sabrá‡El cielo lo sabrá‡Le ciel saura‡睿智的气元素‡天空知道',
    nil,
    'Fale com Imperean nas Ruínas de Eldra\'nath.‡Поговорите с Империан в руинах Элдра\'ната.‡Sprecht mit Imperean in den Ruinen von Eldra\'nath.‡엘드라나스 폐허에서 임페리안과 대화해야 합니다.‡Habla con Imperean en las Ruinas de Eldra\'nath.‡Habla con Imperean en las Ruinas de Eldra\'nath.‡Allez voir Impéréen dans les Ruines d\'Eldra\'nath.‡与埃德拉纳斯废墟的因波莉安谈一谈。‡前往艾卓納斯遺跡與英波里安交談。',
  }
},
[11625] = {
  {
    'O tridente de Naz\'jan‡Трезубец Наз\'жана‡Der Dreizack von Naz\'jan‡나즈잔의 삼지창‡El tridente de Naz\'jan‡El tridente de Naz\'jan‡Le trident de Naz\'jan‡纳兹亚的三叉戟‡納茲贊恩的三叉戟',
    nil,
    'Veehja, no Quebramar, quer que você vá até a extremidade nordeste das Ruínas Quebramar. Uma vez lá, mate Ragnar Drakkarlund e tome o Tridente de Naz\'jan dele.‡Отправляйтесь к дальнему северо-восточному краю Руин Терзающего Бича. Убейте Рагнара Драккарлунда, завладейте трезубцем Наз\'жана, а затем отнесите его Вихье на берег Терзающего Бича.‡Veehja möchte, dass Ihr zur nordöstlichsten Ecke der Ruinen der Peitschennarbe geht und nach Ragnar Drakkarlund sucht. Tötet ihn und nehmt ihm den Dreizack von Naz\'jan ab.‡채찍파도에 있는 비야가 채찍파도 폐허 북동쪽 끝에서 라그나 드라카룬트를 처치하고 나즈잔의 삼지창을 가져다 달라고 했습니다.‡Veehja en Tralladón quiere que vayas al extremo noreste de las Ruinas Tralladón. Una vez allí, mata a Ragnar Drakkarlund y consigue el tridente de Naz\'jan que está en su poder.‡Veehja en Tralladón quiere que vayas al extremo noreste de las Ruinas Tralladón. Una vez allí, mata a Ragnar Drakkarlund y consigue el tridente de Naz\'jan que está en su poder.‡Veehja, aux Courcinglants, vous demande d\'aller à l\'extrémité nord-est des ruines des Courcinglants. Une fois là-bas, tuez Ragnar Drakkarlund et prenez-lui le Trident de Naz\'jan.‡裂鞭海岸的维赫亚要你前往裂鞭废墟的东北角，杀死拉格纳·德拉卡伦并取回纳兹亚的三叉戟。‡裂鞭的薇迦要你前往裂鞭遺跡的東北部。殺死拉格納·德拉卡路德之後，把納茲贊恩的三叉戟交給她。',
  }
},
[11626] = {
  {
    'O emissário‡Посланник‡Der Abgesandte‡사절‡El emisario‡El emisario‡L\'émissaire‡使者‡特使',
    nil,
    'Encontre Leviroth nas águas abaixo do iceberg que flutua na extremidade norte das Ruínas Quebramar. Use o Tridente de Naz\'jan para matá-lo e, depois, fale com Karuk no norte do Areal Quebramar.‡Найдите Левирота в водах под айсбергом, плавающим у северной окраины Руин Терзающего Бича. Воспользуйтесь трезубцем Наз\'жана, чтобы убить Левирота, и возвращайтесь к Каруку, ожидающему вас на севере берега Терзающего Бича.‡Sucht nach Leviroth unter einem Eisberg, der gleich nördlich der Ruinen der Peitschennarbe im Wasser treibt. Erschlagt ihn mit dem Dreizack von Naz\'jan und kehrt zu Karuk in die Gegend nördlich des Strands der Peitschennarbe zurück.‡채찍파도 폐허 북쪽 가장자리에 떠 있는 빙산 아래 물속에서 레비로스를 찾을 수 있습니다. 나즈잔의 삼지창으로 레비로스를 처치하고, 채찍파도 해안 북쪽에 있는 카루크에게 가야 합니다.‡Encuentra a Leviroth en las aguas bajo el iceberg que flota en el límite norte de las Ruinas Tralladón. Utiliza el tridente de Naz\'jan para matarlo y vuelve hasta Karuk al norte del Litoral Tralladón.‡Encuentra a Leviroth en las aguas bajo el iceberg que flota en el límite norte de las Ruinas Tralladón. Utiliza el tridente de Naz\'jan para matarlo y vuelve hasta Karuk al norte del Litoral Tralladón.‡Trouvez Leviroth sous l\'iceberg flottant, le long de l\'extrémité nord des Ruines des Courcinglants. Utilisez le Trident de Naz\'jan pour le tuer, puis retournez voir Karuk au nord de la Grève des Courcinglants.‡潜入裂鞭废墟北部的海面下，在一座冰山下面找到利维洛斯，使用纳兹亚的三叉戟杀死它，然后返回裂鞭海岸的北边，向卡鲁克复命。‡在裂鞭遺跡北方邊緣的水底，到漂浮冰山之下尋找萊維羅希。使用納茲贊恩的三叉戟殺死他。然後回到裂鞭水岸的北邊找卡魯克。',
  }
},
[11627] = {
  {
    'Ponto de ebulição‡Точка кипения‡Siedepunkt‡물과 불의 격돌‡Punto de ebullición‡Punto de ebullición‡Le point d\'ébullition‡沸点‡沸點',
    nil,
    'Imperean quer que você lute contra Fervus e Umius até se renderem. Depois, fale com ela nas Ruínas de Eldra\'nath.‡По просьбе Империан нанесите поражение Шкварчуну и Вспеннеру, а затем вернитесь к ней в руины Элдра\'ната.‡Imperean möchte, dass Ihr Brodler und Neer unterwerft. Kehrt zu ihm zurück, sobald sie sich Euch ergeben haben. Er befindet sich in den Ruinen von Eldra\'nath.‡잿불바람과 물보라를 항복시킨 다음 엘드라나스 폐허에 있는 임페리안에게 가야 합니다.‡Imperean quiere que sometas a Cocer y a Xurn. Cuando lo hayas logrado, vuelve a verla a las Ruinas de Eldra\'nath.‡Imperean quiere que sometas a Cocer y a Xurn. Cuando lo hayas logrado, vuelve a verla a las Ruinas de Eldra\'nath.‡Impéréen vous demande de faire entendre raison à Frémiss et Bouillonn. Retournez la voir aux Ruines d\'Eldra\'nath quand ils auront plié.‡因波莉安要你用武力让西米尔和卓恩握手言和，完成任务后返回埃德拉纳斯废墟向她复命。‡英波里安要你把『沸滾』和『翻湧』打倒屈服。等他們屈服之後再回到艾卓納斯遺跡找她。',
  }
},
[11628] = {
  {
    'Mortalhas do Flagelo‡Нечистое должно послужить чистому‡Der Mantel der Geißel‡잠입 작전‡Embozos de la Plaga‡Embozos de la Plaga‡Le voile du Fléau‡天灾的外衣‡天譴裹布',
    nil,
    'O Chefe Vento de Inverno, na Aldeia Taunka\'le, quer que você lhe traga 5 Pelagens de Mamute Flagelado.‡Принесите вождю Зимней Стуже в деревню Таунка\'ле 5 оскверненных шкур мамонта.‡Häuptling Orkan in Taunka\'le möchte, dass Ihr ihm 5 verseuchte Mammutpelze bringt.‡타운카르 마을의 족장 윈터게일이 스컬지 매머드 모피 5개를 가져다 달라고 했습니다.‡El cabecilla Vendaval de Invierno del Poblado Taunka\'le quiere que le lleves 5 pelambres de mamut plagado.‡El cabecilla Vendaval de Invierno del Poblado Taunka\'le quiere que le lleves 5 pelambres de mamut plagado.‡Le Chef Trombe-de-l\'hiver à Taunka\'le veut que vous lui apportiez 5 Fourrures de mammouths flaellés.‡将5张天灾猛犸的毛皮交给牦牛村的冬风酋长。‡坦卡雷村的冬風酋長要你帶回5個天譴長毛象皮。',
  }
},
[11629] = {
  {
    'O retorno à porta-voz espiritual‡Назад, к говорящей с духами‡Kehrt zur Geisterflüsterin zurück‡영매에게 돌아가기‡Regresa junto a la médium‡Regresa junto a la médium‡Retourner voir la spirite‡返回灵语者身边‡回去找靈語者',
    nil,
    'Entregue o Primevo de Imperean para a Porta-voz Espiritual Rosnapresas, no Posto Avançado Bor\'gorok.‡Доставьте изначальную сущность Империан говорящей с духами Рычеклык на заставу Бор\'горока.‡Liefert Impereans Urluft bei der Geisterflüsterin Fletschfang im Außenposten Bor\'gorok ab.‡보르고로크 전초기지에 있는 영매 스날팡에게 임페리안의 근원을 가져가야 합니다.‡Lleva el primordial de Imperean a la médium Colmillo Gruñente a la Avanzada Bor\'gorok.‡Lleva el primordial de Imperean a la médium Colmillo Gruñente a la Avanzada Bor\'gorok.‡Apportez la Prime-essence d\'Impéréen à la Spirite Grognecroc, à l\'Avant-poste de Bor\'gorok.‡将因波莉安的原始精华交给博古洛克前哨站的灵语者斯纳尔芬。‡將英波里安的元神帶給博格洛克前哨的靈語者嗥牙。',
  }
},
[11630] = {
  {
    'A terra maculada‡Оскверненная Плетью земля‡Schlechte Erde‡오염된 흙‡La tierra mala‡La tierra mala‡La mauvaise terre‡腐化的土地‡惡土',
    nil,
    'Leve 8 torrões de Terra Flagelada para o Chefe Vento de Inverno na Aldeia Taunka\'le.‡Принесите 8 комков оскверненной Плетью земли вождю Зимней Стуже в деревню Таунка\'ле.‡Bringt 8 Klumpen verseuchte Erde zu Häuptling Orkan in Taunka\'le.‡타운카르 마을의 족장 윈터게일에게 스컬지 흙 8개를 가져가야 합니다.‡Lleva 8 montones de tierra plagada al cabecilla Vendaval de Invierno al Poblado Taunka\'le.‡Lleva 8 montones de tierra plagada al cabecilla Vendaval de Invierno al Poblado Taunka\'le.‡Rapportez 8 mottes de Terre flaellée au Chef Trombe-de-l\'hiver à Taunka\'le.‡将8块疫病土壤交给牦牛村的冬风酋长。‡將8塊天譴污染土壤帶給坦卡雷村的冬風酋長。',
  }
},
[11631] = {
  {
    'Visão do ar‡Воздушные видения‡Vision der Luft‡바람이 전해 주는 환영‡Una visión de aire‡Una visión de aire‡Vision de l\'Air‡空气的幻象‡風之幻象',
    nil,
    'Use o Primevo de Imperean para realizar o ritual com o Totem de Rosnapresas no Posto Avançado Bor\'gorok e, assim, obter a informação sobre o Clarividente Passo Duro.|n|nDepois, fale com a Porta-voz Espiritual Rosnapresas.‡Воспользуйтесь изначальной сущностью Империан для проведения ритуала возле тотема говорящей с духами Рычеклык на заставе Бор\'горока, чтобы получить информацию о предсказателе Печальном Путнике.|n|nПосле этого поговорите с говорящей с духами Рычеклык.‡Vollzieht mithilfe von Impereans Urluft ein Ritual bei Fletschfangs Totem im Außenposten Bor\'gorok, um Informationen über Scharfseher Grimmläufer zu beschaffen.|n|nSprecht anschließend mit Geistredner Fletschfang.‡보르고로크 전초기지에 있는 스날팡의 토템 앞에서 임페리안의 근원을 사용하여 의식을 거행하고 선견자 그림워커에 관한 정보를 입수한 다음 영매 스날팡과 대화해야 합니다.‡Usa el primordial de Imperean para realizar un ritual en el tótem de Colmillo Gruñente en la Avanzada Bor\'gorok y consigue información sobre el clarividente Caminante Siniestro.|n|nDespués, habla con la médium Colmillo Gruñente.‡Usa el primordial de Imperean para realizar un ritual en el tótem de Colmillo Gruñente en la Avanzada Bor\'gorok y consigue información sobre el clarividente Caminante Siniestro.|n|nDespués, habla con la médium Colmillo Gruñente.‡Utilisez la Prime-essence d\'Impéréen pour accomplir un rituel devant le Totem de Grognecroc, à l\'Avant-poste de Bor\'gorok, afin de découvrir des informations sur le Long-voyant Marche-sinistre.|n|nEnsuite, allez parler à la Spirite Grognecroc.‡对斯纳尔芬的图腾使用因波莉安的原始精华来执行仪式，获取先知格雷姆沃克的消息。|n|n完成仪式后，与博古洛克前哨站的灵语者斯纳尔芬谈一谈。‡在博格洛克前哨中嗥牙的圖騰，使用英波里安的元神施展儀式，以獲得有關於先知厲行者的消息。|n|n結束以後，再向靈語者嗥牙交談。',
  }
},
[11632] = {
  {
    'O que os ventos frios trazem...‡Что несет холодный ветер?..‡Was der kalte Wind mit sich bringt...‡차가운 바람에 실려...‡Lo que nos trae el frío...‡Lo que nos trae el frío...‡Ce qu\'apporte le vent froid…‡寒风中的怪兽……‡冷風帶來的…',
    nil,
    'Leve a Carapaça Endurecida de Ith\'rix para o Lorde Supremo Saurfang na Fortaleza Brado Guerreiro.‡Отнесите отвердевший панцирь Ит\'рикса верховному правителю Саурфангу в Крепость Песни Войны.‡Bringt Ith\'rix\' gehärteten Knochenpanzer zu Hochfürst Saurfang in der Kriegshymnenfeste.‡이시릭스의 단단한 등껍질을 전쟁노래 요새에 있는 대군주 사울팽에게 가져가야 합니다.‡Lleva el caparazón endurecido de Ith\'rix al alto señor supremo Colmillosauro al Bastión Grito de Guerra.‡Lleva el caparazón endurecido de Ith\'rix al alto señor supremo Colmillosauro al Bastión Grito de Guerra.‡Apportez la Carapace durcie d\'Ith\'rix au Haut seigneur Saurcroc au Bastion Chanteguerre.‡带着伊斯里克斯的甲壳去见战歌要塞的萨鲁法尔大王。‡將依司瑞克斯的硬化殼交給戰歌堡的霸王薩魯法爾。',
  }
},
[11633] = {
  {
    'Infiltrando-se‡Вписаться в ландшафт‡Dabei sein ist alles‡적진 침투‡Pasar desapercibido‡Pasar desapercibido‡Se fondre dans le paysage‡乔装潜入‡混入其中',
    nil,
    'O Chefe Vento de Inverno, na Aldeia Taunka\'le, quer que você vista a Mortalha do Flagelo Imbuída dentro da Cidade-Templo de En\'kilah e examine: a Torre Sangrenta, a Torre da Dor e a Torre da Decomposição.‡По поручению вождя Зимней Стужи отправляйтесь в храмовый город Эн\'кила, наденьте прочную накидку Плети и исследуйте Шпиль Крови, Шпиль Боли и Шпиль Порчи.‡Häuptling Orkan in Taunka\'le möchte, dass Ihr das magieerfüllte Tuch der Geißel in der Tempelstadt En\'kilah überwerft und die Säule des Blutes, die Säule der Pein und die Säule der Fäulnis auskundschaftet.‡타운카르 마을의 족장 윈터게일이 엔킬라 사원에서 마력 깃든 스컬지 망토를 착용하고 피의 첨탑, 고통의 첨탑, 부패의 첨탑을 정찰해 달라고 했습니다.‡El cabecilla Vendaval de Invierno, del Poblado Taunka\'le, quiere que te pongas el embozo de la Plaga imbuido en la Ciudad Templo de En\'kilah y que investigues la Aguja de Sangre, la Aguja de Dolor y la Aguja de Putrefacción.‡El cabecilla Vendaval de Invierno, del Poblado Taunka\'le, quiere que te pongas el embozo de la Plaga imbuido en la Ciudad Templo de En\'kilah y que investigues la Aguja de Sangre, la Aguja de Dolor y la Aguja de Putrefacción.‡Le Chef Trombe-de-l\'hiver à Taunka\'le veut que vous portiez le Voile du Fléau imprégné dans la Ville-temple d’En’kilah, et que vous alliez explorer la Flèche du Sang, la Flèche de la Douleur et la Flèche de la Décomposition.‡牦牛村的冬风酋长要你穿上魔法天灾外衣进入圣城恩其拉，侦察鲜血尖塔、苦痛尖塔和凋零尖塔。‡坦卡雷村的冬風酋長要你到恩吉拉聖城裡穿上灌魔天譴裹布，然後偵察鮮血尖塔、苦痛尖塔、以及凋零尖塔。',
  }
},
[11634] = {
  {
    'Mestre do Vento To\'bor‡Повелитель ветра То\'бор‡Windreitermeister To\'bor‡바람의 기수 토보르‡Maestro del viento To\'bor‡Maestro del viento To\'bor‡Le maître du vent To\'bor‡驭风大师图波尔‡御風者托波爾',
    nil,
    'Apresente-se ao Mestre do Vento To\'bor na Fortaleza Brado Guerreiro.‡Явитесь к повелителю ветра То\'бору в крепости Песни Войны.‡Meldet Euch bei Windmeister To\'bor in der Kriegshymnenfeste.‡전쟁노래 요새에 있는 바람의 기수 토보르에게 보고해야 합니다.‡Preséntate ante el maestro del viento To\'bor en el Bastión Grito de Guerra.‡Preséntate ante el maestro del viento To\'bor en el Bastión Grito de Guerra.‡Présentez-vous au Maître du vent To\'bor au Bastion Chanteguerre.‡向战歌要塞的驭风大师图波尔报到。‡向戰歌堡的御風者托波爾回報。',
  }
},
[11635] = {
  {
    'O Espírito do Clarividente Passo Duro‡Дух предсказателя Печального Путника‡Scharfseher Grimmläufers Geist‡선견자 그림워커의 영혼‡El espíritu del clarividente Caminante Siniestro‡El espíritu del clarividente Caminante Siniestro‡L\'esprit du long-voyant Marche-sinistre‡先知格雷姆沃克之魂‡先知厲行者之靈',
    nil,
    'Fale com o Clarividente Passo Duro dentro de Magmute.‡Поговорите с духом предсказателя Печального Путника в глубинах Магмота.‡Sprecht mit dem Geist von Scharfseher Grimmläufer im Inneren von Magmut.‡마그모스 안에 있는 선견자 그림워커의 영혼과 대화해야 합니다.‡Habla con el espíritu del clarividente Caminante Siniestro dentro de Magmoth.‡Habla con el espíritu del clarividente Caminante Siniestro dentro de Magmoth.‡Parlez à l’Esprit du long-voyant Marche-sinistre, à l’intérieur de Magmoth.‡进入犸格莫斯，与先知格雷姆沃克的灵魂谈一谈。‡和瑪格默斯中的先知厲行者之靈交談。',
  }
},
[11636] = {
  {
    'Passeio de tapete mágico‡Полет на ковре-самолете‡Ritt auf dem magischen Teppich‡마법 융단을 타고‡Viaje en alfombra mágica‡Viaje en alfombra mágica‡Un tour en tapis volant‡魔法飞毯‡魔法飛毯之旅',
    nil,
    'Converse com Yanni, na Fortaleza Brado Guerreiro, para conseguir uma viagem segura para a costa. Fale com o Aniquilador Grek\'lor quando chegar no Ancoradouro de Garrosh.‡Поговорите с Янни в крепости Песни Войны, чтобы организовать вам безопасную доставку на побережье. Когда прибудете в лагерь Гарроша, поговорите с крушителем Грек\'лором.‡Sprecht mit Yanni in der Kriegshymnenfeste, um die sichere Reise zur Küste zu arrangieren. Sprecht mit Vernichter Grek\'lor, sobald Ihr bei Garroshs Landeplatz angekommen seid.‡전쟁노래 요새에 있는 야니와 대화한 다음 해안으로 안전하게 이동할 방법을 찾아야 합니다. 가로쉬의 상륙지에 도착한 다음에는 파멸자 그렉로르와 대화해야 합니다.‡Habla con Yanni en el Bastión Grito de Guerra para organizar un viaje seguro hasta la costa. Cuando llegues al Desembarco de Garroh, habla con el aniquilador Grek\'lor.‡Habla con Yanni en Bastión Grito de Guerra para organizar un viaje seguro hasta la costa. Cuando llegues al Desembarco de Garrosh habla con Aniquilador Grek\'lor.‡Parlez à Yanni au Bastion Chanteguerre pour organiser votre voyage jusqu’à la côte. Une fois au Point d’accostage de Garrosh, trouvez l’annihilateur Grek’lor.‡与战歌要塞的亚尼谈一谈，让他把你安全地送往海滩边。到达加尔鲁什码头后去找歼灭者格雷克罗。‡和戰歌堡的亞尼談談，安排一趟前往海岸邊的旅行。等你抵達卡爾洛斯臺地之後，和殲滅者葛雷克洛談談。',
  }
},
[11637] = {
  {
    'Kaganishu‡Каганишу‡Kaganishu‡카가니슈‡Kajanishu‡Kajanishu‡Kaganishu‡卡加尼舒‡卡甘尼蘇',
    nil,
    'Recupere o Fetiche de Kaganishu e use-o nos Restos Mortais do Clarividente Passo Duro.|n|nVocê precisará entregar o fetiche ao Espírito do Clarividente Passo Duro dentro de Magmute.‡Добудьте амулет Каганишу и задействуйте его над останками предсказателя Печального Путника.|n|nВам нужно будет передать амулет предсказателю Печальному Путнику в Магмоте.‡Findet Kaganishus Fetisch und wendet ihn auf die Überreste von Scharfseher Grimmläufer an.|n|nIhr werdet nach Magmut gehen und den Fetisch Scharfseher Grimmläufers Geist geben müssen.‡카가니슈의 우상을 되찾아 선견자 그림워커의 유골에 사용하고 나서 마그모스 안에 있는 선견자 그림워커의 영혼에 전달해야 합니다.‡Recupera el fetiche de Kajanishu y úsalo sobre los restos del clarividente Caminante Siniestro.|n|nTendrás que darle el fetiche al espíritu del clarividente Caminante Siniestro, dentro de Magmoth.‡Recupera el fetiche de Kajanishu y úsalo sobre los restos del clarividente Caminante Siniestro.|n|nTendrás que darle el fetiche al espíritu del clarividente Caminante Siniestro, dentro de Magmoth.‡Retrouvez le Fétiche de Kaganishu et utilisez-le près des Restes du long-voyant Marche-sinistre.|n|nVous devrez donner le fétiche à l’Esprit du long-voyant Marche-sinistre dans Magmoth.‡夺得卡加尼舒的神像，对先知格雷姆沃克的残骸使用它。|n|n然后将物像还给滞留在犸格莫斯内的先知格雷姆沃克的灵魂。‡找回卡甘尼蘇的神像並且在先知厲行者的殘骸上使用。|n|n你必須將神像交給瑪格默斯中的先知厲行者之靈。',
  }
},
[11638] = {
  {
    'Devolva meus restos mortais‡Вернуть мои останки‡Bringt meine Überreste zurück‡유골 돌려주기‡Devuelve mis restos‡Devuelve mis restos‡Rapatrier mes restes‡落叶归根‡交回我的殘骸',
    nil,
    'Entregue os Restos Mortais do Clarividente Passo Duro que se encontram abaixo de seu espírito para a Porta-voz Espiritual Rosnapresas no Posto Avançado Bor\'gorok.‡Доставьте останки предсказателя Печального Путника, которые покоятся под его духом, говорящей с духами Рычеклык на заставу Бор\'горока.‡Bringt Scharfseher Grimmläufers Überreste, die zu Füßen seines Geistes liegen, zur Geisterflüsterin Fletschfang im Außenposten Bor\'gorok.‡영혼 아래에 있는 선견자 그림워커의 유골을 보르고로크 전초기지에 있는 영매 스날팡에게 전달해야 합니다.‡Entrega los restos del clarividente Caminante Siniestro, que descansan debajo de su espíritu, a la médium Colmillo Gruñente en la Avanzada Bor\'gorok.‡Entrega los restos del clarividente Caminante Siniestro, que descansan debajo de su espíritu, a la médium Colmillo Gruñente en la Avanzada Bor\'gorok.‡Remettez les Restes du long-voyant Marche-sinistre, qui reposent en dessous de son esprit, à la Spirite Grognecroc, à l’Avant-poste de Bor’gorok.‡将先知格雷姆沃克的遗骸交给北风苔原博古洛克前哨站的灵语者斯纳尔芬。‡將安息在先知厲行者之靈底下的先知厲行者的殘骸遞交給博格洛克前哨的靈語者嗥牙。',
  }
},
[11639] = {
  {
    'Vingança contra Magmute‡Месть в Магмоте‡Rache an Magmut‡마그모스에 복수를‡Venganza en Magmoth‡Venganza en Magmoth‡La vengeance s\'abat sur Magmoth‡向犸格莫斯复仇‡向瑪格默斯報仇',
    nil,
    'Mate 10 Xamãs de Magmute, 5 Colhedores de Magmute, 3 Esmagadores de Magmute e 3 Fêmeas de Magmutregar. Depois, fale com Ortrosh, no Posto Avançado Bor\'gorok.‡Убейте магмотов: 10 шаманов, 5 добытчиков, 3 сокрушителя и 3 жен Магмотрегара. Затем возвращайтесь к Орторошу на заставу Бор\'горока.‡Tötet 10 Schamanen der Magmut, 5 Futterwühler der Magmut, 3 Zermalmer der Magmut und 3 Gefährtinnen von Magmutregar. Kehrt anschließend zu Ortrosh im Außenposten Bor\'gorok zurück.‡마그모스 주술사 10명, 마그모스 채집꾼 5명, 마그모스 분쇄자 3명, 마그모스레가르의 짝 3명을 처치한 다음 보르고로크 전초기지에 있는 오르트로쉬에게 가야 합니다.‡Mata a 10 chamanes de Magmoth, 5 batidores de Magmoth, 3 trituradores de Magmoth y 3 compañeras de Magmothregar. Después, vuelve a ver a Ortrosh en la Avanzada Bor\'gorok.‡Mata a 10 chamanes de Magmoth, 5 batidores de Magmoth, 3 trituradores de Magmoth y 3 compañeras de Magmothregar. Después, vuelve a ver a Ortrosh en la Avanzada Bor\'gorok.‡Tuez 10 Chamans de Magmoth, 5 Fourrageurs de Magmoth, 3 Écraseurs de Magmoth et 3 Compagnes de Magmothregar. Lorsque ce sera fait, retournez voir Ortrosh à l’Avant-poste de Bor’gorok.‡杀死10个犸格莫斯萨满祭司、5个犸格莫斯劫掠者、3个犸格莫斯碾压者和3个犸格莫斯雷加的配偶。然后博古洛克前哨站，向奥尔托什复命。‡殺了10個瑪格默斯薩滿，5個瑪格默斯強奪者，3個瑪格默斯粉碎者，以及3個瑪格默斯瑞卡的配偶。完成後，回到博格洛克前哨找甌爾卓希。',
  }
},
[11640] = {
  {
    'Palavras de poder‡Слова могущества‡Worte der Macht‡힘이 깃든 말‡Palabras de poder‡Palabras de poder‡Les mots de puissance‡力量之语‡真言',
    nil,
    'Leve o Pergaminho do Sumo Sacerdote Naferset, o Pergaminho do Sumo Sacerdote Talet-Kha e o Pergaminho do Sumo Sacerdote Andorath para o Chefe Vento de Inverno, na Aldeia Taunka\'le.‡Принесите свиток верховного жреца Наферсета, свиток верховного жреца Талет-Ха и свиток верховного жреца Андората вождю Зимней Стуже в деревне Таунка\'ле.‡Bringt die Rolle von Hohepriester Naferset, die Rolle von Hohepriester Talet-Kha und die Rolle von Hohepriester Andorath zu Häuptling Orkan in Taunka\'le.‡대사제 내페세트의 두루마리, 대사제 탈레트카의 두루마리, 대사제 안도라스의 두루마리를 타운카르 마을에 있는 족장 윈터게일에게 가져가야 합니다.‡Lleva el pergamino del sumo sacerdote Naferset, el pergamino del sumo sacerdote Talet-Kha y el pergamino del sumo sacerdote Andorath al cabecilla Vendaval de Invierno del Poblado Taunka\'le.‡Lleva el pergamino del sumo sacerdote Naferset, el pergamino del sumo sacerdote Talet-Kha y el pergamino del sumo sacerdote Andorath al cabecilla Vendaval de Invierno del Poblado Taunka\'le.‡Apportez le Parchemin du grand prêtre Naferset, le Parchemin du grand prêtre Talet-Kha et le Parchemin du grand prêtre Andorath au Chef Trombe-de-l\'hiver à Taunka\'le.‡将高阶祭司纳菲塞特的卷轴、高阶祭司塔雷坎的卷轴和高阶祭司安多拉斯的卷轴交给牦牛村的冬风酋长。‡帶著高階祭司納菲賽特的卷軸，高階祭司塔烈卡的卷軸，和高階祭司安杜拉斯的卷軸給坦卡雷村的冬風酋長。',
  }
},
[11641] = {
  {
    'Um ataque corajoso‡Смелость города берет!‡Ein mutiger Schlag‡용맹한 공격‡Un ataque valeroso‡Un ataque valeroso‡Une frappe courageuse‡勇猛的进攻‡英勇一擊',
    nil,
    'Mate 15 Carniçais En\'kilah e 5 Necromantes En\'kilah e fale novamente com Durm Pelálgido na Aldeia Taunka\'le.‡Убейте 15 вурдалаков и 5 некромантов из Эн\'кила и доложите об этом Дурму Ледяной Шкуре, который живет в деревне Таунка\'ле.‡Erschlagt 15 Ghule der En\'kilah und 5 Nekromanten der En\'kilah und meldet Euch dann wieder bei Durm Eisbalg. Er befindet sich in Taunka\'le.‡엔킬라 구울 15마리와 엔킬라 강령술사 5명을 제거한 다음 타운카르 마을에 있는 두름 아이스하이드에게 보고해야 합니다.‡Mata a 15 necrófagos de En\'kilah y a 5 nigromantes de En\'kilah y vuelve a informar a Durm Pellejo de Hielo, en el Poblado Taunka\'le.‡Mata a 15 necrófagos de En\'kilah y a 5 nigromantes de En\'kilah y vuelve a informar a Durm Pellejo de Hielo, en el Poblado Taunka\'le.‡Tuez 15 Goules d’En’kilah et 5 Nécromanciens d’En’kilah, puis allez faire votre rapport à Durm Cuir-de-glace à Taunka’le.‡杀死15名恩其拉食尸鬼和5名恩其拉通灵师，然后返回牦牛村向杜尔姆·冰皮复命。‡殺死15個恩吉拉食屍鬼和5個恩吉拉死靈法師，然後向坦卡雷村的德姆·冰隱回報。',
  }
},
[11642] = {
  {
    'Tanques ainda não se consertam sozinhos‡Танк сам собой не починится!‡Panzer reparieren sich nicht von selbst‡전차는 저절로 고쳐지는 게 아니야‡El tanque no se va a reparar solo‡El tanque no se va a reparar solo‡Un char, ça s\'répare pas tout seul‡坦克可不会自己修好！‡坦克可不會自我修復',
    nil,
    'Fale com Mobu no Ancoradouro de Garrosh.‡Поговорите с Мобу в лагере Гарроша.‡Sprecht mit Mobu auf Garroshs Landeplatz.‡가로쉬의 상륙지에 있는 모부와 대화해야 합니다.‡Habla con Mobu en el Desembarco de Garrosh.‡Habla con Mobu en el Desembarco de Garrosh.‡Parlez à Mobu au Point d\'accostage de Garrosh.‡与加尔鲁什码头的莫布谈一谈。‡跟卡爾洛斯臺地的莫布談談。',
  }
},
[11643] = {
  {
    'O guéri-guéri hidráulico de Mobu‡Танковая пневматическая трансзажиматрица Мобу‡Mobus pneumatisches Panzertransjigamarick‡모부의 전공기압축식 자동조절 동력제어기‡El transijigamárigo neumático para tanques de Mobu‡El transijigamárigo neumático para tanques de Mobu‡Le transbidulotron pneumatique pour char de Mobu‡莫布的坦克零件气动装配器‡莫布的氣動式坦克外鑽模夾具',
    nil,
    'Mobu, na Costa do Eco da Tundra Boreana, quer que você recupere o Guéri-guéri Hidráulico.‡Принесите Мобу на берег Эха в Борейской тундре его танковую пневматическую трансзажиматрицу.‡Mobu an der Echoküste in der Boreanischen Tundra möchte, dass Ihr sein pneumatisches Panzertransjigamarick beschafft.‡북풍의 땅의 메아리 해안에 있는 모부가 전공기압축식 자동조절 동력제어기를 되찾아 달라고 했습니다.‡Mobu en la Costa de los Ecos de la Tundra Boreal quiere que recuperes su transijigamárigo neumático para tanques.|n‡Mobu en la Costa de los Ecos de la Tundra Boreal quiere que recuperes su transijigamárigo neumático para tanques.|n‡Mobu, sur la Côte des Échos dans la Toundra Boréenne veut que vous récupériez son Transbidulotron pneumatique pour char.‡回音海岸的莫布要求你为他取回坦克零件气动装配器。‡莫布要你找回他的氣動式坦克外鑽模夾具，他就在北風凍原的回聲海岸。',
  }
},
[11644] = {
  {
    'Placas de metal superfortes!‡Сверхпрочные металлические пластины!‡Superstarke Metallplatten!‡고강도 금속판!‡¡Placas de metal superfuertes!‡¡Placas de metal superfuertes!‡Des plaques de métal ultra-résistantes !‡超强度金属板！‡超強力金屬板!',
    nil,
    'Mobu, na Costa do Eco da Tundra Boreana, quer que você consiga 10 Placas de Metal Superfortes.‡По заданию Мобу соберите 10 сверхпрочных металлических пластин и принесите ему на берег Эха в Борейской тундре.‡Mobu an der Echoküste in der Boreanischen Tundra möchte, dass Ihr 10 superstarke Metallplatten sammelt.‡북풍의 땅의 메아리 해안에 있는 모부가 고강도 금속판 10개를 모아달라고 했습니다.‡Mobu en la Costa de los Ecos de la Tundra Boreal quiere que consigas 10 placas de metal superfuertes.‡Mobu en la Costa de los Ecos de la Tundra Boreal quiere que consigas 10 placas de metal superfuertes.‡Mobu, sur la Côte des Échos dans la Toundra Boréenne veut que vous récupériez 10 Plaques de métal ultra-résistantes.‡回音海岸的莫布要求你收集10块超强度金属板。‡莫布要你收集10個超強力金屬板，他就在北風凍原的回聲海岸。',
  }
},
[11645] = {
  {
    'Nevolds sujos e fedorentos!‡Грязные, вонючие снобольды!‡Dreckige, stinkende Schneebolde!‡더럽고 역겨운 스노볼트!‡¡Sucios y apestosos snóbolds!‡¡Sucios y apestosos snóbolds!‡Stupides frigbolds joufflus !‡恶心的雪地狗头人！‡骯髒、發臭的極地狗頭人!',
    nil,
    'Recupere 10 caixas de Coisas da Abília e devolva-as para Abília Rodafrouxa, na Pista de Pouso do Biela.‡Добудьте 10 ящиков с вещами Умейки и верните их Умейке Шестеркрут на взлетной полосе Выкрутеня.‡Bringt 10 von Pfiffis Werkzeugen zu Pfiffi Wackelspross. Sie befindet sich bei der Landebahn Kurbelzisch.‡크래프티의 보급품 상자 10개를 회수한 다음 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 가져가야 합니다.‡Recupera 10 cajas de cosas de Ingeniosa y devuélveselas a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Recupera 10 cajas de cosas de Ingeniosa y devuélveselas a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Récupérez 10 boîtes de Matériel de Fufute et rapportez-les à Fufute Tremblerouage sur la Piste d\'atterrissage de Spumelevier.‡将10箱机灵鬼的货物交给菲兹兰克机场的机灵鬼沃比斯波基。‡收集10個卡芙緹的貨物，帶回去給嘶軸簡易機場的卡芙緹·顛鏈。',
  }
},
[11646] = {
  {
    'A inquisição boreana‡Борейские дознаватели‡Die boreanische Inquisition‡심문할 시간‡La inquisición boreal‡La inquisición boreal‡L\'inquisition boréenne‡苔原上的审讯‡北風審訊',
    nil,
    'Donathan ordenou que você ofereça ajuda ao Bibliotecário Normantis na torre dos magos, no Promontório Âmbar.‡По приказу Донатана пойдите к библиотекарю Нормантису в башню магов на Янтарной гряде и предложите ему свою помощь.‡Donathan hat Euch befohlen, Bibliothekar Normantis Eure Hilfe anzubieten. Er befindet sich im Magierturm auf dem Bernsteinflöz.‡도나단이 호박석 절벽의 마법사 탑에 있는 사서 노르만티스를 도와주라고 했습니다.‡Donathan te ha ordenado que ofrezcas tu ayuda al bibliotecario Normantis en la Torre de los Magos en El Saliente Ámbar.‡Donathan te ha ordenado que ofrezcas tu ayuda al bibliotecario Normantis en la Torre de los Magos en El Saliente Ámbar.‡Donathan vous a ordonné de proposer votre aide au Bibliothécaire Normantis dans la tour des mages de l\'Escarpement d\'Ambre.‡多纳森要你帮助琥珀崖法师塔中的图书馆员诺曼提斯。‡唐納森要你向諾曼提司提供協助，他就在琥珀岩臺的法師塔中。',
  }
},
[11647] = {
  {
    'Neutralizando os caldeirões‡Обезвредить чумные котлы‡Die Kessel neutralisieren‡가마솥 무력화‡Neutralizar las calderas‡Neutralizar las calderas‡Neutraliser les chaudrons‡中和天灾之锅‡中和大鍋',
    nil,
    'Sábia Aeire, na Aldeia Taunka\'le, quer que você use o totem para neutralizar o Caldeirão Leste, o Caldeirão Central e o Caldeirão Oeste na Cidade-templo de En\'kilah.‡Используйте тотем ведуньи Эйри из деревни Таунка\'ле, чтобы нейтрализовать восточный котел, центральный котел и западный котел в Храмовом городе Эн\'кила.‡Die Weise Aeire in Taunka\'le möchte, dass Ihr mithilfe ihres Totems den Kessel im Osten, den Kessel in der Mitte und den Kessel im Westen der Tempelstadt En\'kilah neutralisiert.‡타운카르 마을에 있는 현자 아이레가 그녀의 토템을 사용해 엔킬라 사원의 동쪽 가마솥, 중앙 가마솥, 서쪽 가마솥을 중화시켜 달라고 했습니다.‡La sabia Aeire, del Poblado Taunka\'le, quiere que uses su tótem para neutralizar la caldera este, la caldera central y la caldera oeste en la Ciudad Templo de En\'kilah.‡La sabia Aeire, del Poblado Taunka\'le, quiere que uses su tótem para neutralizar la caldera este, la caldera central y la caldera oeste en la Ciudad Templo de En\'kilah.‡La Sage Aeire de Taunka\'le vous demande d\'utiliser son totem pour neutraliser le Chaudron de l\'est, le Chaudron central et le Chaudron de l\'ouest dans la Ville-temple d\'En\'kilah.‡牦牛村的先知埃恩雷要你利用她的图腾来中和圣城恩其拉中的东部天灾之锅、中部天灾之锅和西部天灾之锅。‡坦卡雷村的賢者艾睿要你使用她的圖騰去中和恩吉拉聖城中的東部大鍋，中央大鍋和西部大鍋。',
  }
},
[11648] = {
  {
    'A arte da persuasão‡Искусство убеждения‡Überredungskunst‡설득의 기술‡El arte de la persuasión‡El arte de la persuasión‡L\'art de la persuasion‡说服的艺术‡說服的藝術',
    nil,
    'O Bibliotecário Normantis, no Promontório Âmbar, quer que você use o Aguilhão Neural no Feiticeiro de Berília Aprisionado até que ele revele o paradeiro da Lady Evanor.‡Используйте генератор боли против закованного бериллового колдуна, пока тот не выдаст местонахождение леди Эванор, по просьбе библиотекаря Нормантиса с Янтарной гряды.‡Bibliothekar Normantis vom Bernsteinflöz möchte, dass Ihr den Neuralinjektor so lange auf den eingesperrten Beryllzauberer anwendet, bis er den Aufenthaltsort von Lady Evanor verrät.‡호박석 절벽의 사서 노르만티스가 구속된 녹주석 마술사에게 신경 자극기를 사용해 대마법사 에바노르의 위치를 자백받아 달라고 했습니다.‡El bibliotecario Normantis de El Saliente Ámbar quiere que uses el taladro neural con el hechicero de Berilo encarcelado hasta que revele la ubicación de Lady Evanor.‡El bibliotecario Normantis de El Saliente Ámbar quiere que uses el taladro neural con el hechicero de Berilo encarcelado hasta que revele la ubicación de Lady Evanor.‡Le Bibliothécaire Normantis de l\'Escarpement d\'Ambre vous demande d\'utiliser l\'Aiguillonneur neural sur l\'Ensorceleur de Béryl emprisonné jusqu\'à ce qu\'il révèle où se trouve dame Evanor.‡琥珀崖的图书馆员诺曼提斯要你对被囚禁的蓝玉巫师使用催眠魔杖，查出艾瓦诺尔女士的下落。‡琥珀岩臺的圖書管理員諾曼提司需要你對被囚禁的碧晶巫士使用神經刺針，直到他吐露伊娃諾女士的所在地。',
  }
},
[11649] = {
  {
    'Partículas dos enfurecidos‡Частицы разгневанных бурь‡Partikel der Wutentbrannten‡광포한 폭풍 파편‡Motas de los iracundos‡Motas de los iracundos‡Granules des enragés‡风暴微粒‡狂怒微粒',
    nil,
    'Obtenha 5 Partículas da Tempestade e entregue-as a Imperean nas Ruínas de Eldra\'nath.‡Добудьте 5 частиц бури и принесите Империан в руины Элдра\'ната.‡Beschafft 5 Sturmpartikel und bringt sie zu Imperean in den Ruinen von Eldra\'nath.‡돌개바람 파편 5개를 구해 엘드라나스 폐허에 있는 임페리안에게 전달해야 합니다.‡Consigue 5 motas de tempestad y entrégaselas a Imperean en las Ruinas de Eldra\'nath.‡Consigue 5 motas de tempestad y entrégaselas a Imperean en las Ruinas de Eldra\'nath.‡Rassemblez 5 Granules de tempête et rapportez-les à Impéréen aux Ruines d\'Eldra\'nath.‡将5颗风暴微粒交给埃德拉纳斯废墟的因波莉安。‡收集5個暴風雨微粒，然後把它們交給艾卓納斯遺跡的英波里安。',
  }
},
[11650] = {
  {
    'Só mais umas coisinhas...‡Еще кое-что…‡Nur noch ein paar Kleinigkeiten...‡몇 개만 더...‡Un par de cositas más...‡Un par de cositas más...‡Encore quelques bricoles…‡还要一些东西……‡只要再幾樣東西……',
    nil,
    'Pegue as Ferramentas de Abília, um Capacitor Sobrecarregado e um Punhado de Grãos do Rocanar. Entregue-os para Abília Rodafrouxa, na Pista de Pouso do Biela.‡Найдите инструменты Умейки, перегруженный конденсатор и горсть песка Рокнара. Доставьте все это Умейке Шестеркрут на взлетную полосу Выкрутеня.‡Findet Pfiffis Werkzeuge, einen überladenen Kondensatoren und eine Handvoll von Felsnars Kies. Bringt dies alles zu Pfiffi Wackelspross, die sich auf Kurbelzischs Landebahn aufhält.‡크래프티의 도구, 과충전된 축전기, 로크나르의 모래 한 줌을 모아 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 전달해야 합니다.‡Consigue las herramientas de Ingeniosa, un condensador sobrecargado y un puñado de polvo de Rocanar. Llévaselos a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Consigue las herramientas de Ingeniosa, un condensador sobrecargado y un puñado de polvo de Rocanar. Llévaselos a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Récupérez les Outils de Fufute, un Condensateur surchargé et une Poignée de sable de Rocnar. Apportez-les à Fufute Tremblerouage à la Piste d\'atterrissage de Spumelevier.‡收集机灵鬼的工具、一个超载电容器和一捧洛克纳尔的沙砾，把它们交给菲兹兰克机场的机灵鬼沃比斯波基。‡收集卡芙緹的工具，一個過載電容器，以及一把洛克那爾的砂粒。將這些東西送去給嘶軸簡易機場的卡芙緹·顛鏈。',
  }
},
[11651] = {
  {
    'Com a barriga no tanque‡Броня крепка, и танки наши…‡Danke vielmals...‡준비 끝!‡Muchas gracias...‡Muchas gracias...‡Le char l\'attend‡坦克准备就绪！‡非常感謝……',
    nil,
    'Fale com o Aniquilador Grek\'lor na Costa do Eco.‡Поговорите с крушителем Грек\'лором на берегу Эха.‡Sprecht mit Vernichter Grek\'lor an der Echoküste.‡메아리 해안에 있는 파멸자 그렉로르와 대화해야 합니다.‡Habla con el aniquilador Grek\'lor en la Costa de los Ecos.‡Habla con Aniquilador Grek\'lor en la Costa de los Ecos.‡Parlez à l’Annihilateur Grek’lor sur la Côte des Échos.‡与回音海岸的歼灭者格雷克罗谈一谈。‡與回聲海岸的殲滅者葛雷克洛談談。',
  }
},
[11652] = {
  {
    'As Planícies de Nasam‡Равнины Назама‡Die Ebene von Nasam‡나삼의 평원‡Las Llanuras de Nasam‡Las Llanuras de Nasam‡Les plaines de Nasam‡纳萨姆平原‡納森平原',
    nil,
    'Use o Tanque de Cerco da Horda para destruir 100 Soldados do Flagelo e resgatar 3 Soldados do Brado Guerreiro Feridos nas Planícies de Nasam. Descubra também a identidade do líder do ataque do Flagelo.|n|nApresente-se a Garrosh Grito Infernal na Fortaleza Brado Grerreiro, caso tenha sucesso.‡Используйте ордынский осадный танк, чтобы уничтожить 100 солдат Плети и спасти 3 раненых солдата Песни Войны на равнинах Назама. Кроме того, выясните, кто возглавляет наступление Плети.|n|nВыполнив все это, отправляйтесь к Гаррошу Адскому Крику в крепость Песни Войны.‡Tötet mithilfe des Belagerungspanzers der Horde 100 Soldaten der Geißel und rettet 3 verletze Soldaten des Kriegshymnenklans auf der Ebene von Nasam. Außerdem müsst Ihr herausfinden, wer der Anführer des Angriffs der Geißel ist.|n|nMeldet Euch bei Garrosh Höllschrei in der Kriegshymnenfeste, solltet Ihr Erfolg haben.‡나삼의 평원에서 호드 공성 전차를 사용해 스컬지 병사 100마리를 처치하고 부상당한 전쟁노래 전사 3명을 구해야 합니다. 또한 스컬지 공격을 지휘하는 자의 정체를 알아내야 합니다.|n|n임무를 완료하면 전쟁노래 요새에 있는 가로쉬 헬스크림에게 보고해야 합니다.‡Usa el tanque de asedio de la Horda para matar a 100 soldados de la Plaga y rescatar a 3 soldados Grito de Guerra heridos en las Llanuras de Nasam. También tienes que revelar la identidad del líder del asalto de la Plaga.|n|nInforma a Garrosh Grito Infernal en el Bastión Grito de Guerra si tienes éxito.‡Usa el tanque de asedio de la Horda para matar a 100 soldados de la Plaga y rescatar a 3 soldados Grito de Guerra heridos en las Llanuras de Nasam. También tienes que revelar la identidad del líder del asalto de la Plaga.|n|nInforma a Garrosh Grito Infernal en el Bastión Grito de Guerra si tienes éxito.‡Utilisez le Char de siège de la Horde pour détruire 100 Soldats du Fléau et secourir 3 Soldats chanteguerre blessés, sur les Plaines de Nasam. Vous devez aussi découvrir l’identité du chef de l’attaque du Fléau.|n|nAllez ensuite faire votre rapport à Garrosh Hurlenfer au Bastion Chanteguerre si vous réussissez.‡在纳萨姆平原使用部落攻城坦克消灭100名天灾士兵，并营救出3名受伤的战歌士兵。同时你也必须鉴别出领导这次突袭行动的天灾军团指挥官。|n|n完成任务之后向战歌要塞的加尔鲁什·地狱咆哮复命。‡駕駛部落攻城坦克到納森平原摧毀100個天譴士兵，並救援3個受傷的戰歌士兵。你同時必須查出天譴軍團攻擊領導人的身分。|n|n成功之後，向戰歌堡的卡爾洛斯·地獄吼報告。',
  }
},
[11653] = {
  {
    'Ahh... Quem é o grandalhão agora?‡Ха! Не такой уж ты и большой теперь!‡Ha! ... Jetzt seid Ihr nicht mehr so groß!‡허... 이젠 별로 크지도 않잖아!‡¡Ja!... ¡Ya no eres tan grande!‡¡Ja!... ¡Ya no eres tan grande!‡Ha ! Z\'êtes plus si grands que ça maintenant !‡大块头‡哈...你現在可沒那麼大囉!',
    nil,
    'Teste o Canhão Redutor Proto-Típico Ultra-Avançado da Abília em 5 Esmagadores Magmute ou Fêmeas de Magmutregar. Após terminado, fale com ela na Pista de Pouso do Biela.‡Испробуйте прототип ультрасовременного укорачивающего излучателя Умейки на 5 магмотах-сокрушителях или женах Магмотрегара. Когда все будет сделано, вернитесь к Умейке на взлетную полосу Выкрутеня.‡Testet Pfiffis ultrafortschrittlichen prototypischen Verkürzungsblaster an 5 Zermalmern der Magmut oder Gefährtinnen von Magmutregar aus. Kehrt wieder zu Ihr zurück, sobald Ihr das erledigt habt. Sie befindet sich auf der Landebahn Kurbelzisch.‡마그모스 분쇄자 또는 마그모스레가르의 짝 5마리에게 잘못될 리 없는 크래프티의 초고급 축소 광선총을 시험하고, 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 가야 합니다.‡Pon a prueba el rayo reductor prototípico ultraavanzado de Ingeniosa sobre 5 trituradores de Magmoth o sobre 5 compañeras de Magmothregar. Cuando lo hayas hecho, vuelve a hablar con ella a la Pista de Aterrizaje de Palanqueta.‡Pon a prueba el rayo reductor prototípico ultraavanzado de Ingeniosa sobre 5 trituradores de Magmoth o compañeras de Magmothregar. Cuando lo hayas hecho, vuelve a hablar con ella a la Pista de Aterrizaje de Palanqueta.‡Testez la Pétoire Raccourcissante Proto-Typique Ultra-Avancée de Fufute sur 5 Écraseurs de Magmoth ou Compagnes de Magmothregar. Quand ce sera fait, retournez voir cette dernière à la Piste d\'atterrissage de Spumelevier.‡对5名犸格莫斯碾压者或犸格莫斯雷加的配偶使用超级缩小射线枪原型机进行测试。完成任务后返回菲兹兰克机场，向机灵鬼沃比斯波基汇报测试结果。‡在5隻瑪格默斯粉碎者或瑪格默斯瑞卡的配偶身上檢測卡芙緹的超進階初體版微縮光束槍。在完成後，回到嘶軸簡易機場找她。',
  }
},
[11654] = {
  {
    'A torre sangrenta‡Шпиль Крови‡Die Säule des Blutes‡피의 첨탑‡La Aguja de Sangre‡La Aguja de Sangre‡La flèche du Sang‡鲜血尖塔‡鮮血尖塔',
    nil,
    'Procure na Torre Sangrenta por mais informações sobre a Ampola de Sangue Fresco.‡Поищите на Шпиле Крови информацию касательно склянки со свежей кровью.‡Sucht in der Säule des Blutes nach weiteren Informationen über die Phiole mit frischem Blut.‡피의 첨탑에서 신선한 피가 든 유리병에 관한 정보를 찾아야 합니다.‡Busca más información sobre el vial de sangre fresca en la Aguja de Sangre.‡Busca más información sobre el vial de sangre fresca en la Aguja de Sangre.‡Fouillez la Flèche du Sang à la recherche d\'informations sur la Fiole de sang frais.‡搜寻鲜血尖塔，找到这瓶新鲜血液的更多线索。‡調查鮮血尖塔尋找更多關於新鮮的血瓶的情報。',
  }
},
[11655] = {
  {
    'Bruma adentro‡В туман‡In den Nebel hinein‡안갯속으로‡En la niebla‡En la niebla‡Dans la brume‡深入迷雾‡進入迷霧',
    nil,
    'Waltor de Pal\'ea na Costa do Eco, na Tundra Boreana, quer que você mate os Kvaldir e recupere 8 Relíquias Morsanas.‡Убейте квалдиров, найдите 8 реликвий клыкарров и принесите их Вальтору из Пал\'ии на Берег Эха в Борейской тундре.‡Waltor von Pal\'ea an der Echoküste in der Boreanischen Tundra möchte, dass Ihr Kvaldir tötet und 8 Relikte der Tuskarr beschafft.‡북풍의 땅의 메아리 해안에 있는 팔에아의 왈토르가 크발디르를 제거하고 투스카르 유물 8개를 되찾아 달라고 했습니다.‡Waltor de Pal\'ea en la Costa de los Ecos, en la Tundra Boreal, quiere que mates Kvaldir y recuperes 8 reliquias colmillarr.‡Waltor de Pal\'ea en la Costa de los Ecos, en la Tundra Boreal, quiere que mates Kvaldir y recuperes 8 reliquias colmillarr.‡Waltor, de Pal\'ea sur la Côte des Échos dans la Toundra Boréenne, vous demande de tuer des kvaldirs pour récupérer 8 Reliques roharts.‡北风苔原回音海岸的瓦托尔要你杀死克瓦迪尔成员，并取回8件海象人的圣物。‡帕雷亞的華特要你殺死科瓦迪爾人，收集8個巨牙海民遺物。他就在北風凍原的回聲海岸。',
  }
},
[11656] = {
  {
    'Queime os barcos!‡Показательное сожжение‡Setzt ein Zeichen und verbrennt sie‡저항의 불꽃을 지펴라!‡Quema en efigie‡Quema en efigie‡Brûler en effigie‡烧毁船只‡焚火示眾',
    nil,
    'Waltor de Pal\'ea na Costa do Eco da Tundra Boreana, quer que você use a Tocha Morsana para queimar os barcos kvaldir em Pal\'ea e no Ancoradouro de Garrosh. Destrua os seguintes barcos: o Boca da Serpente, o Kur Drakkar, o Martelo de Bor e o Bigorna de Bor.‡По заданию Вальтора из Пал\'ии с Берега Эха сожгите квалдирские корабли у Пал\'ии и у лагеря Гарроша с помощью клыкаррского факела. Нужно уничтожить следующие суда: "Змеиная Пасть", "Кур Драккар", "Молот Бора" и "Наковальня Бора".‡Waltor von Pal\'ea an der Echoküste in der Boreanischen Tundra möchte, dass Ihr die Tuskarrfackel benutzt und die Schiffe der Kvaldir bei Pal\'ea und Garroshs Landeplatz verbrennt. Ihr müsst die folgenden Schiffe verbrennen: Die Schlangenschlund, die Kur Drakkar, die Bors Hammer und die Bors Amboss.‡북풍의 땅, 메아리 해안에 있는 팔에아의 왈토르가 투스카르 횃불을 사용해 팔에아와 가로쉬의 상륙지에서 크발디르 선박인 독사의 아귀호, 쿠르 드라카르호, 보르의 망치호, 보르의 모루호를 불태워달라고 했습니다.‡Waltor de Pal\'ea en la Costa de los Ecos en la Tundra Boreal quiere que utilices la antorcha colmillarr para quemar los barcos Kvaldir en Pal\'ea y en el Desembarco de Garrosh. Debes destruir los siguientes barcos: Las Fauces de la Sierpe, El Kur Drakkar, Martillo de Bor y Yunque de Bor.|n‡Waltor de Pal\'ea en la Costa de los Ecos en la Tundra Boreal quiere que utilices la antorcha colmillarr para quemar los barcos Kvaldir en Pal\'ea y en el Desembarco de Garrosh. Debes destruir los siguientes barcos: Las Fauces de la Sierpe, El Kur Drakkar, Martillo de Bor y Yunque de Bor.|n‡Waltor de Pal’ea, sur la Côte des Échos de la Toundra Boréenne, veut que vous utilisiez la Torche rohart pour brûler les vaisseaux kvaldirs à Pal’ea et au Point d\'accostage de Garrosh. Vous devez détruire les vaisseaux suivants : La Gueule du serpent, Le Drakkar de Kur, Le Marteau de Bor et L’Enclume de Bor.‡北风苔原回音海岸的瓦托尔要你利用海象人火炬烧毁停泊在帕尔依和加尔鲁什码头的4艘克瓦迪尔船只——毒蛇之喉、库尔达卡、伯尔之锤和伯尔之砧。‡回聲海岸的帕雷亞的華特要你使用巨牙海民火炬燒毀在帕雷亞與卡爾洛斯臺地的科瓦迪爾船艦。你得摧毀以下的船隻:巨蛇之喉、科·德拉卡、伯爾之錘和伯爾之砧。',
  }
},
[11657] = {
  {
    'Piromalabarismo‡Поймай факел!‡Fackeln fangen‡횃불을 잡아라!‡Caza de antorchas‡Caza de antorchas‡Attraper des torches‡接火炬‡接住火炬',
    nil,
    'Pegue 4 tochas em sequência. Em seguida, fale com o Mestre Engolidor de Fogo.‡Поймайте подряд 4 факела, затем поговорите с мастером-огнеглотателем.‡Fangt nacheinander 4 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 4개를 연달아 던졌다 잡고 나서, 불꽃마술의 대가와 대화해야 합니다.‡Atrapa 4 antorchas seguidas y después ve a hablar con el maestro tragafuegos.‡Atrapa 4 antorchas seguidas y después ve a hablar con el maestro tragafuegos.‡Attrapez 4 torches de suite, puis parlez au Maître mangeur de feu.‡连续接住火炬4次，然后与吞火大师谈一谈。‡連續接住4根火炬，然後跟吞火者大師談話。',
  }
},
[11658] = {
  {
    'Plano B‡План Б‡Plan B‡차선책‡Plan B‡Plan B‡Plan B‡B计划‡B計畫',
    nil,
    'Pegue 10 Trajes de Brado Guerreiro e um Estandarte do Brado Guerreiro. Leve-os de volta para Abília Rodafrouxa, na Pista de Pouso do Biela.‡По просьбе Умейки Шестеркрут со взлетной полосы Выкрутеня соберите 10 комплектов одежды и знамя клана Песни Войны.‡Sammelt 10 Kriegshymnenausrüstungen und ein Kriegshymnenbanner. Bringt sie zurück zu Pfiffi Wackelspross an der Landebahn Kurbelzisch.‡전쟁노래 의복 10개와 전쟁노래 깃발 1개를 모아 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 가져가야 합니다.‡Reúne 10 conjuntos Grito de Guerra y un estandarte Grito de Guerra. Llévaselos a Ingeniosa Piñonflojo a la Pista de Aterrizaje de Palanqueta.‡Reúne 10 conjuntos Grito de Guerra y un estandarte Grito de Guerra. Llévaselos a Ingeniosa Piñonflojo a la Pista de Aterrizaje de Palanqueta.‡Rapportez 10 Tenues chanteguerres et une Bannière chanteguerre à Fufute Tremblerouage à la Piste d\'atterrissage de Spumelevier.‡收集10套战歌衣物和一面战歌旗帜，将它们交给菲兹兰克机场的机灵鬼沃比斯波基。‡收集10件戰歌外裝和1根戰歌旌旗。將它們帶回去給嘶軸簡易機場的卡芙緹·顛鏈。',
  }
},
[11659] = {
  {
    'Estilhace as orbes!‡Уничтожьте шары!‡Zerschmettert die Kugeln!‡수정구를 파괴하라!‡¡Destruye los globos!‡¡Destruye los globos!‡Brisez les orbes !‡击碎宝珠！‡粉碎寶珠!',
    nil,
    'Destrua 5 Globos de Sangue e fale com Rastreador da Neve Junek, na Aldeia Taunka\'le.‡Уничтожьте 5 кровавых сфер и сообщите о случившемся снежному следопыту Джунеку в деревне Таунка\'ле.‡Zerstört 5 Blutkugeln und meldet Euch anschließend bei Schneefährtenleser Junek in Taunka\'le.‡피의 수정구 5개를 파괴한 다음 타운카르 마을의 눈 추적자 주네크에게 보고해야 합니다.‡Destruye 5 globos de sangre e informa al rastreador de nieve Junek en el Poblado Taunka\'le.‡Destruye 5 globos de sangre e informa al rastreador de nieve Junek en el Poblado Taunka\'le.‡Détruisez 5 Globes de sang et allez avertir le Pisteur des neiges Junek à Taunka\'le.‡摧毁5颗鲜血宝珠，然后向牦牛村的踏雪者尤内克汇报情况。‡摧毀5個集血之球並回報坦卡雷村的雪地追蹤者朱奈克。',
  }
},
[11660] = {
  {
    'Trompa do Velho Marinheiro‡Рог старого морехода‡Horn des uralten Seemanns‡고대 뱃사람의 뿔피리‡El cuerno del viejo marinero‡El cuerno del viejo marinero‡Le cor du vieux marinier‡古代水手的号角‡上古海員號角',
    nil,
    'Waltor de Pal\'ea, na Costa do Eco da Tundra Boreana, quer que você traga a Trompa do Velho Marinheiro.‡Принесите рог старого морехода Вальтору из Пал\'ии на берег Эха в Борейской тундре.‡Waltor von Pal\'ea an der Echoküste in der Boreanischen Tundra möchte, dass Ihr ihm das Horn des uralten Seemanns bringt.‡북풍의 땅의 메아리 해안에 있는 팔에아의 왈토르가 고대 뱃사람의 뿔피리를 구해달라고 했습니다.‡Waltor de Pal\'ea en la Costa de los Ecos, en la Tundra Boreal, quiere que le lleves el cuerno del viejo marinero.‡Waltor de Pal\'ea en la Costa de los Ecos, en la Tundra Boreal, quiere que le lleves el cuerno del viejo marinero.‡Waltor, de Pal\'ea sur la Côte des Échos dans la Toundra Boréenne, vous demande de lui apporter le Cor du vieux marinier.‡北风苔原回音海岸的瓦托尔要你夺得古代水手的号角。‡帕雷亞的華特要你將上古海員號角帶給他。他就在北風凍原的回聲海岸。',
  }
},
[11661] = {
  {
    'Orabus, o Timoneiro‡Орабус Кормчий‡Orabus der Steuermann‡키잡이 오라부스‡Orabus el Timonel‡Orabus el Timonel‡Orabus le Timonier‡舵手奥拉布斯‡『舵手』歐拉布斯',
    nil,
    'Waltor de Pal\'ea, na Costa do Eco da Tundra Boreana, quer que você use a Trompa do Velho Marinheiro para evocar Orabus, o Timoneiro. Quando Orabus, o Timoneiro, aparecer, mate-o.‡По заданию Вальтора из Пал\'ии с берега Эха в Борейской тундре протрубите в рог древнего моряка, чтобы призвать Орабуса Кормчего. Когда Орабус появится, убейте его.‡Waltor von Pal\'ea an der Echoküste in der Boreanischen Tundra möchte, dass Ihr mithilfe des Horns des uralten Seemanns Orabus den Steuermann beschwört. Erschlagt Orabus den Steuermann, sobald er beschworen ist.‡북풍의 땅, 메아리 해안에 있는 팔에아의 왈토르가 고대 뱃사람의 뿔피리를 사용해 키잡이 오라부스를 소환해 낸 다음 처치해 달라고 했습니다.‡Waltor de Pal\'ea en la Costa de los Ecos en la Tundra Boreal quiere que uses el cuerno del viejo marinero para invocar a Orabus el Timonel. Cuando lo hayas invocado, mata a Orabus el Timonel.‡Waltor de Pal\'ea en la Costa de los Ecos en la Tundra Boreal quiere que uses el cuerno del viejo marinero para invocar a Orabus el Timonel. Cuando lo hayas invocado, mata a Orabus el Timonel.‡Waltor de Pal’ea, sur la Côte des échos, dans la Toundra Boréenne, veut que vous utilisiez le Cor du vieux marinier, pour appeler Orabus le Timonier. Quand vous l’aurez appelé, tuez-le.‡北风苔原回音海岸的瓦托尔要你利用古代水手的号角召唤舵手奥拉布斯并杀死他。‡回聲海岸的帕雷亞的華特要你使用上古海員號角召喚『舵手』歐拉布斯，並且殺死歐拉布斯。',
  }
},
[11662] = {
  {
    'Procure Karuk!‡Найти Карука‡Sucht nach Karuk!‡카루크를 찾아라!‡¡Encuentra a Karuk!‡¡Encuentra a Karuk!‡Allez trouver Karuk !‡找到卡鲁克！‡找出卡魯克!',
    nil,
    'Procure Karuk no Areal Quebramar.‡Найдите Карука на берегу Терзающего Бича.‡Sucht Karuk am Strand der Peitschennarbe auf.‡채찍파도 해안에서 카루크를 찾아야 합니다.‡Busca a Karuk en el Litoral Tralladón.‡Busca a Karuk en el Litoral Tralladón.‡Allez trouver Karuk sur la Grève des Courcinglants.‡前往裂鞭海岸寻找卡鲁克。‡在裂鞭水岸找出卡魯克。',
  }
},
[11663] = {
  {
    'Compartilhando informações‡Передача сведений‡Geheime Nachrichten teilen‡소식 전달‡Informando de las noticias‡Informando de las noticias‡Rapporter les informations‡分享情报‡分享情報',
    nil,
    'Normantis pediu para que você se apresente para o Bibliotecário Donathan no Promontório Âmbar.‡По просьбе Нормантиса отчитайтесь библиотекарю Донатану на Янтарной гряде.‡Normantis möchte, dass Ihr Euch bei Bibliothekar Donathan auf dem Bernsteinflöz meldet.‡노르만티스가 호박석 절벽에 있는 사서 도나단에게 보고해 달라고 했습니다.‡Normantis te ha pedido que te presentes ante el bibliotecario Donathan en El Saliente Ámbar.‡Normantis te ha pedido que te presentes ante el bibliotecario Donathan en El Saliente Ámbar.‡Normantis vous a demandé de vous présenter au Bibliothécaire Donathan à l\'Escarpement d\'Ambre.‡诺曼提斯要你去向琥珀崖的图书馆员多纳森汇报情况。‡諾曼提司要你向琥珀岩臺的圖書管理員唐納森報告。',
  }
},
[11664] = {
  {
    'Fuga das brumas‡Спастись из тумана‡Flucht aus dem Nebel‡안개를 헤치고‡Escapar de la niebla‡Escapar de la niebla‡S\'échapper de la brume‡逃离迷雾‡逃出迷霧',
    nil,
    'Siga Mutu, a Jovem, para fora das brumas. Fale com o Ancião Mutu após salvar Mutu, a Jovem.‡Выведите Муту Младшую из тумана. Если вам удастся спасти Муту Младшую, поговорите со старейшиной Муту.‡Begleitet Muhtoo die Jüngere und helft ihr, aus dem Nebel herauszukommen. Sprecht mit dem Ältesten Muhtoo, solltet Ihr Muhtoo die Jüngere in Sicherheit gebracht haben.‡무투의 딸을 데리고 안전하게 안개에서 빠져나간 다음 장로 무투와 대화해야 합니다.‡Sigue a Mootoo la Joven para salir de la niebla. Habla con el anciano Mootoo si consigues salvar a Mootoo la Joven.‡Sigue a Mootoo la Joven para salir de la niebla. Habla con el anciano Mootoo si consigues salvar a Mootoo la Joven.‡Suivez Meuhtou la Jeune hors de la brume. Parlez à l\'Ancien Meuhtou si vous parvenez à sauver Meuhtou la Jeune.‡护送小穆图逃离迷雾地带，然后与长者穆图谈一谈。‡跟隨著小穆圖走出迷霧。成功拯救小穆圖後，與穆圖長者談談。',
  }
},
[11665] = {
  {
    'Crocoliscos na cidade‡Кроколиски в городе‡Krokilisken in der Stadt‡도시에 나타난 악어‡Crocoliscos en la ciudad‡Crocoliscos en la ciudad‡Les crocilisques sont lâchés‡城中的鳄鱼‡城裡的鱷魚',
    nil,
    'Traga um Crocolisco Bebê para o Velho Barlo. Você encontrará o Velho Barlo pescando a nordeste de Shattrath, no Lago Silmyr.‡Принесите старине Барло детеныша кроколиска. Он рыбачит на озере Силмир на северо-востоке от Шаттрата.‡Bringt dem alten Barlo ein Krokiliskenbaby. Ihr könnt ihn beim Angeln am Silmyrsee nordöstlich von Shattrath finden.‡샤트라스 북동쪽 실미르 호수에서 낚시를 하는 노인 발로에게 아기 악어 한 마리를 가져가야 합니다.‡Llévale una cría de crocolisco al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Llévale una cría de crocolisco al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Apportez un Bébé crocilisque au vieux Barlo. Vous le trouverez en train de pêcher au nord-est de Shattrath, au bord du lac Silmyr.‡为老渔夫巴尔洛带回一只鳄鱼宝宝。你可以在沙塔斯城东北面的希尔米耶湖旁找到他。‡把一隻鱷魚寶寶帶給老人巴洛。你可以在撒塔斯城東北邊的泥濘湖畔找到他在那釣魚。',
  }
},
[11666] = {
  {
    'Ladrões de Isca‡Поймай бандюгу‡Köderbanditen‡미끼 도둑‡Pilluelos de cebo‡Pilluelos de cebo‡Succomber à vos appâts‡黑鳞镖鲈‡魚餌強盜',
    nil,
    'Traga um Plati-pontanegra para o Velho Barlo. Você encontrará o Velho Barlo pescando a nordeste de Shattrath, no Lago Silmyr.‡Поймайте черноперого ерша и принесите его старине Барло. Он рыбачит к северо-востоку от Шаттрата на озере Силмир.‡Bringt dem alten Barlo einen schwarzen Stachelflosser. Ihr könnt ihn beim Angeln am Silmyrsee nordöstlich von Shattrath finden.‡샤트라스 북동쪽 실미르 호수에서 낚시를 하는 노인 발로에게 검은지느러미 화살고기 한 마리를 가져가야 합니다.‡Llévale un dardo aleta negra al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Llévale un dardo aleta negra al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Apportez un Dard aileron-noir au vieux Barlo. Vous le trouverez en train de pêcher au nord-est de Shattrath, au bord du lac Silmyr.‡为老渔夫巴尔洛带回一只黑鳞镖鲈。你可以在沙塔斯城东北面的希尔米耶湖旁找到他。‡帶一尾黑鰭小魚給老人巴洛。你可以在撒塔斯城東北邊的泥濘湖畔找到他在那釣魚。',
  }
},
[11667] = {
  {
    'O peixe fugitivo‡Та самая рыбка‡Der Eine, der entkam‡놓친 물고기‡Aquel que se escapó‡Aquel que se escapó‡Celui qui s\'échappa‡世界上最大的泥鱼‡逃脫的傢伙',
    nil,
    'Pesque o Maior Muçum do Mundo e traga-o para o Velho Barlo. Você encontrará o Velho Barlo pescando a nordeste de Shattrath, no Lago Silmyr.‡Поймайте величайшую ильную рыбу в мире и принесите ее старине Барло. Он рыбачит к северо-востоку от Шаттрата на озере Силмир.‡Fangt den größten Matschflosser der Welt und bringt ihn zum alten Barlo. Ihr könnt ihn beim Angeln am Silmyrsee nordöstlich von Shattrath finden.‡샤트라스 북동쪽 실미르 호수에서 낚시를 하는 노인 발로에게 세상에서 제일 큰 미꾸라지를 가져가야 합니다.‡Pesca el pezfango más grande del mundo y llévaselo al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Pesca el pezfango más grande del mundo y llévaselo al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Attrapez le Plus grand éperlan du monde et apportez-le au Vieux Barlo. Vous le trouverez en train de pêcher au nord-est de Shattrath au bord du lac Silmyr.‡为老渔夫巴尔洛捕捉到世界上最大的泥鱼。你可以在沙塔斯城东北面的希尔米耶湖旁找到他。‡抓到世界最大的泥鰍，然後帶給老人巴洛。你可以在撒塔斯城東北邊的泥濘湖畔找到他在那釣魚。',
  }
},
[11668] = {
  {
    'Camarão é a mãe!‡Ловить креветок – это не жук чихнул‡Garnelenfangen ist nicht einfach‡새우잡이‡No es fácil pescar gambas‡No es fácil pescar gambas‡Les crevettes, c\'est pas pour les mauviettes‡巨型淡水虾‡抓蝦子一點都不簡單',
    nil,
    'Traga 10 Camarões Gigantes de Água Doce para o Velho Barlo. Você encontrará o Velho Barlo pescando a nordeste de Shattrath, no Lago Silmyr.‡Принесите 10 гигантских пресноводных креветок старине Барло. Он рыбачит на озере Силмир на северо-востоке от Шаттрата.‡Bringt dem alten Barlo 10 riesige Süßwassergarnelen. Ihr könnt ihn beim Angeln am Silmyrsee nordöstlich von Shattrath finden.‡샤트라스 북동쪽 실미르 호수에서 낚시를 하는 노인 발로에게 큰 민물새우 10마리를 가져가야 합니다.‡Llévale 10 gambas de agua dulce gigantes al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Llévale 10 gambas de agua dulce gigantes al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Le Vieux Barlo veut 10 Crevettes géantes d\'eau douce. Vous pouvez le trouver au nord-est de Shattrath, près du lac Silmyr.‡为老渔夫巴尔洛带回10只巨型淡水虾。你可以在沙塔斯城东北面的希尔米耶湖旁找到他。‡帶10隻巨型清水蝦給老人巴洛。你可以在撒塔斯城東北方找到他在泥濘湖畔垂釣。',
  }
},
[11669] = {
  {
    'Filé de sangrevil‡Филе сквернокровного луциана‡Teufelsblutfilet‡지옥피퉁돔 분비선‡Filete de sangrevil‡Filete de sangrevil‡Filet de gangresang‡魔血鲷鱼‡魔化之血肉片',
    nil,
    'Traga um Pargo Sangrevil Monstruoso para o Velho Barlo. Você encontrará o Velho Barlo pescando a nordeste de Shattrath, no Lago Silmyr.‡Принесите старине Барло чудовищного сквернокровного луциана. Старик удит рыбу к северо-востоку от Шаттрата в озере Силмир.‡Bringt dem alten Barlo einen monströsen Teufelsblutschnapper. Ihr könnt Barlo beim Angeln am Silmyrsee nordöstlich von Shattrath finden.‡샤트라스 북동쪽 실미르 호수에서 낚시를 하는 노인 발로에게 기괴한 지옥피퉁돔 한 마리를 가져가야 합니다.‡Llévale un pargo sangrevil enorme al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Llévale un pargo sangrevil enorme al viejo Barlo, que está pescando en el Lago Silmyr, al noreste de la Ciudad de Shattrath.‡Apportez un Lutjan gangresang monstrueux au Vieux Barlo. Vous le trouverez en train de pêcher au nord-est de Shattrath, au bord du lac Silmyr.‡为老渔夫巴尔洛带回一只巨型魔血鲷鱼。你可以在沙塔斯城东北面的希尔米耶湖旁找到他。‡帶一尾可怕的魔化之血鯛魚給老人巴洛。你可以在撒塔斯城東北邊的泥濘湖畔找到他在那釣魚。',
  }
},
[11670] = {
  {
    'Foram os orcs, eu juro!‡Это были орки, честно!‡Es waren die Orcs, ganz ehrlich!‡오크라니까요, 정말이에요!‡¡Han sido los orcos! ¡Lo juro!‡¡Han sido los orcos! ¡Lo juro!‡C\'était les orcs, j\'vous jure !‡是兽人干的！真的！‡真的是獸人做的!',
    nil,
    'Enquanto disfarçado de orc do Brado Guerreiro, finque o Estandarte do Brado Guerreiro no cadáver de Magmutregar. Depois, fale novamente com Abília Rodafrouxa, na Pista de Pouso do Biela.‡Переоденьтесь орком Песни Войны и водрузите знамя клана Песни Войны над трупом Магмотрегара. Затем вернитесь вместе с личиной к Умейке Шестеркрут на взлетную полосу Выкрутеня.‡Spießt Magmutregars Leiche mit dem Kriegshymnenbanner auf, während Ihr als Orc des Kriegshymnenklans verkleidet seid. Kehrt anschließend zu Pfiffi Wackelspross zurück und bringt die Verkleidung mit. Sie befindet sich auf der Landebahn Kurbelzisch.‡전쟁노래 오크로 변장한 상태에서 전쟁노래 깃발을 마그모스레가르의 시체에 꽂은 다음, 위장복을 가지고 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 가야 합니다.‡Ponte el disfraz de orco Grito de Guerra y a continuación clava el estandarte Grito de Guerra sobre el cadáver de Magmothregar. Después, devuelve el disfraz a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Ponte el disfraz de orco Grito de Guerra y a continuación clava el estandarte Grito de Guerra sobre el cadáver de Magmothregar. Después, devuelve el disfraz a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Plantez la Bannière chanteguerre dans le cadavre de Magmothregar en portant le Déguisement d\'orc chanteguerre. Puis rapportez le déguisement à Fufute Tremblerouage à la Piste d\'atterrissage de Spumelevier.‡伪装成战歌兽人，将战歌旗帜插在犸格莫斯雷加的尸体上。完成任务后返回菲兹兰克机场，将伪装还给机灵鬼沃比斯波基。‡偽裝成戰歌獸人，將戰歌旌旗插在瑪格默斯瑞卡的屍體上。然後把偽裝還給嘶軸簡易機場的卡芙緹·顛鏈。',
  }
},
[11671] = {
  {
    'Corrida contra o tempo‡Наперегонки со временем‡Wettlauf gegen die Zeit‡시간과의 싸움‡Carrera a contrarreloj‡Carrera a contrarreloj‡Une course contre la montre‡与时间赛跑‡和時間賽跑',
    nil,
    'Donathan, no Promontório Âmbar, lhe pediu para usar o Detonador de Escudos de Berília para destruir o escudo no Penhasco de Berília. Logo em seguida, derrote Salrand e pegue a chave que ela guarda.‡По поручению Донатана с Янтарной гряды уничтожьте щит в Берилловом лагере, воспользовавшись разрушителем Бериллового щита. Затем сразите Салранд и заберите найденный у нее ключ.‡Donathan vom Bernsteinflöz hat Euch damit beauftragt, mithilfe des Beryllschilddetonators den Schild auf der Beryllspitze zu zerstören. Danach sollt Ihr Salrand besiegen und ihr den Schlüssel abnehmen, den sie bei sich trägt.‡호박석 절벽의 도나단이 녹주석 보호막 폭파기로 녹주석 거점의 방어막을 해제한 후, 살란드를 처치하고 열쇠를 입수해 달라고 했습니다.‡Donathan en El Saliente Ámbar te ha encargado que uses el detonador de escudo de Berilo para destruir el escudo en Alto de Berilo. Entonces, tendrás que derrotar a Salrand para conseguir la llave que guarda.‡Donathan en El Saliente Ámbar te ha encargado que uses el detonador de escudo de Berilo para destruir el escudo en Alto de Berilo. Entonces, tendrás que derrotar a Salrand para conseguir la llave que guarda.‡Donathan de l\'Escarpement d\'Ambre vous a chargé d\'utiliser le Détonateur contre le bouclier de Béryl afin d\'abattre le bouclier à la Halte de Béryl. Vous devez ensuite vaincre Salrand et prendre la clé qu\'elle détient.‡琥珀崖的多纳森要你使用蓝玉护盾炸药摧毁蓝玉营地的魔法护盾，然后击败莎尔兰德，夺取她的钥匙。‡琥珀岩臺的唐納森派你使用碧晶護盾炸彈關閉碧晶哨點的護盾。接著打敗沙爾倫並取得她持有的鑰匙。',
  }
},
[11672] = {
  {
    'Dia do alistamento‡День зачисления‡Eingezogen‡입대하는 날‡Día de alistamiento‡Día de alistamiento‡Le jour de l\'incorporation‡应征入伍‡徵募日',
    nil,
    'Encontre-se com o General Arlos, dentro do quartel da Bastilha Valentia.‡Поговорите с генералом Арлосом в казармах Крепости Отваги.‡Trefft Euch mit General Arlos im Inneren der Kaserne in der Valianzfeste.‡용맹의 성채 병영 안에 있는 장군 알로스를 만나야 합니다.‡Reúnete con el general Arlos en el cuartel de la Fortaleza Denuedo.‡Reúnete con el general Arlos en el cuartel de la Fortaleza Denuedo.‡Rencontrez le Général Arlos à l\'intérieur de la caserne du donjon de la Bravoure.‡到无畏要塞的兵营里去找阿洛斯将军。‡和阿爾洛斯將軍見面，他就在驍勇要塞的兵營裡。',
  }
},
[11673] = {
  {
    'Tirem-me daquiii!‡Вытащите меня отсюда!‡Holt mich hier raus!‡날 구해줘요!‡¡Sácame de aquí!‡¡Sácame de aquí!‡Sortez-moi de là !‡带我出去！‡快把我弄出去!',
    nil,
    'Escolte Quim Mudavolt e apresente-se a Biela Velotroll, na Pista de Pouso do Biela.‡Проводите Бонкера Тумблевольта в безопасное место и сообщите об этом Выкрутеню Разгоняйло со взлетной полосы Выкрутеня.‡Bringt Bonker Wechselvolt in Sicherheit und meldet Euch bei Kurbelzisch Vollgas auf der Landebahn Kurbelzisch.‡본커 토글볼트를 안전하게 호위한 다음 피즈크랭크 비행장에 있는 피즈크랭크 풀스로틀에게 보고해야 합니다.‡Escolta a Chalati Voltiflop hasta un lugar seguro y después informa a Palanqueta Todogás en la Pista de Aterrizaje de Palanqueta.‡Escolta a Chalati Voltiflop hasta un lugar seguro y después informa a Palanqueta Todogás en la Pista de Aterrizaje de Palanqueta.‡Escortez Bonker Virevolt jusqu\'en lieu sûr puis présentez-vous à Spumelevier Pleingaz à la Piste d\'atterrissage de Spumelevier.‡护送托格沃特逃离犸格莫斯，然后返回菲兹兰克机场，向菲兹兰克·铁阀汇报情况。‡將邦克·電環護送到安全地點，並且向嘶軸簡易機場的嘶軸·滿閥回報。',
  }
},
[11674] = {
  {
    'A Sábia Chapadalta está desaparecida‡Ведунья Высокий Холм пропала!‡Die Weise Hochmesa wird vermisst‡실종된 현자 하이메사‡La sabia Altamesa ha desaparecido‡La sabia Altamesa ha desaparecido‡La sage Haute-mesa a disparu‡先知赫米萨‡賢者高臺不見了',
    nil,
    'Encontre a Sábia Chapadalta perto das Tocas da Morte.‡Найдите ведунью Высокий Холм близ Келий Смерти.‡Findet die Weise Hochmesa in der Nähe der Höhlen des Todes.‡사자의 동굴 근처에서 현자 하이메사를 찾아야 합니다.‡Encuentra a la sabia Altamesa cerca de Los Cubiles de los Moribundos.‡Encuentra a la sabia Altamesa cerca de Los Cubiles de los Moribundos.‡Trouver la Sage Haute-mesa près des Tanières du Trépas.‡前往亡者之穴附近寻找先知赫米萨。‡到北風凍原的死亡獸穴附近尋找賢者高臺。',
  }
},
[11675] = {
  {
    'Uma morte adequada‡Достойная смерть‡Ein würdiges Ende‡합당한 안식‡Una muerte digna‡Una muerte digna‡Une mort décente‡死亡的解脱‡合宜的死',
    nil,
    'Destrua 10 Magnatauros Pestilentos e fale novamente com a Sábia Chapadalta, ao sul das Tocas da Morte.‡Уничтожьте 10 чумных магнатавров и возвращайтесь к ведунье Высокий Холм, которая ждет вас к югу от Келий Смерти.‡Erschlagt 10 verseuchte Magnatauren und kehrt anschließend zur Weisen Hochmesa gleich südlich der Höhlen des Todes zurück.‡역병 걸린 마그나타우르 10마리를 처치한 다음 사자의 동굴 남쪽에 있는 현자 하이메사에게 가야 합니다.‡Mata a 10 magnatauros apestados y después vuelve a ver a la sabia Altamesa al sur de Los Cubiles de los Moribundos.‡Mata a 10 magnatauros apestados y después vuelve a ver a la sabia Altamesa al sur de Los Cubiles de los Moribundos.‡Détruisez 10 Magnataures pestiférés puis retournez voir la Sage Haute-mesa au sud des Tanières du Trépas.‡杀死10名天灾猛犸人，然后向亡者之穴以南的先知赫米萨复命。‡消滅10隻染疫猛瑪象人，然後向垂死獸穴的賢者高臺回報。',
  }
},
[11676] = {
  {
    'Liberdade misericordiosa‡Наконец-то свобода!‡Gnadenvolle Freiheit‡자비로운 마음으로‡Clemente libertad‡Clemente libertad‡Le cadeau de la liberté‡慈悲为怀‡慈悲的自由',
    nil,
    'Assombrante Canarius no Acampamento das Fazendas Brado Guerreiro quer que você liberte 5 Prisioneiros do Flagelo.‡Освободить 5 узников Плети по просьбе тенелова Канариуса с заставы у ферм Песни Войны.‡Schattenpirscher Canarius auf den Höfen des Kriegshymnenklans möchte, dass Ihr 5 Gefangene der Geißel befreit.‡전쟁노래 농장 전진기지에 있는 그림자추적자 카나리우스가 스컬지 포로 5명을 풀어달라고 했습니다.‡El acechasombras Canarius en la Avanzada de las Granjas Grito de Guerra quiere que liberes a 5 prisioneros de la Plaga.‡El acechasombras Canarius en la Avanzada de las Granjas Grito de Guerra quiere que liberes a 5 prisioneros de la Plaga.‡Le traqueur des ombres Canarius, à l\'Avant-poste des fermes chanteguerres, vous demande de libérer 5 Prisonniers du Fléau.‡战歌农场哨站的暗影密探卡纳留斯要你去释放5名天灾囚犯。‡戰歌農場前哨的巡影者卡納利亞斯要你去釋放5個天譴囚犯。',
  }
},
[11677] = {
  {
    'Acabe com a peste‡Остановить чуму!‡Haltet die Seuche auf‡역병을 막아라‡Detén a la Plaga‡Detén a la Plaga‡Mettre fin à la peste‡阻止瘟疫‡阻止瘟疫',
    nil,
    'A Sábia Chapadalta, ao sul das Tocas da Morte, pediu para que você use as Sementes Purificadoras de Chapadalta em um Caldeirão Pestilento das Tocas da Morte para neutralizá-lo.‡Используйте очистительные семена ведуньи Высокий Холм у чумного котла в Кельях Смерти, чтобы нейтрализовать его, по просьбе ведуньи Высокий Холм, стоящей к югу от Келий Смерти.‡Die Weise Hochmesa gleich südlich der Höhlen des Todes möchte, dass Ihr Hochmesas reinigende Samen auf den Seuchenkessel in den Höhlen des Todes anwendet, um ihn zu neutralisieren.‡사자의 동굴 정남 쪽에 서 있는 현자 하이메사가 하이메사의 정화 씨앗으로 사자의 동굴 역병 가마솥을 중화해달라고 했습니다.‡La sabia Altamesa, al sur de Los Cubiles de los Moribundos, te ha pedido que uses las semillas de purificación de Altamesa en la caldera de peste de Los Cubiles de los Moribundos para neutralizarla.‡La sabia Altamesa, al sur de Los Cubiles de los Moribundos, te ha pedido que uses las semillas de purificación de Altamesa en la caldera de peste de Los Cubiles de los Moribundos para neutralizarla.‡La Sage Haute-mesa, qui se trouve juste au sud des tanières du Trépas, vous a demandé d\'utiliser les Graines purificatrices de Haute-mesa à un Chaudron de peste des tanières du Trépas, afin de le neutraliser.‡亡者之穴以南的先知赫米萨要你进入亡者之穴，对一口天灾之锅使用赫米萨的净化之种。‡賢者高臺就站在垂死獸穴的南方，要求你使用高臺的淨化種子將垂死獸穴的瘟疫大鍋中和。',
  }
},
[11678] = {
  {
    'Encontre Chifre Peludo‡Поиски Торчащего Рога‡Findet Borstenhorn‡브리슬혼 찾기‡Encuentra a Cornopúa‡Encuentra a Cuernopúa‡Trouvez Corne-dressée‡找到萨安·钢角‡尋找鬃角',
    nil,
    'Encontre o Pisaléguas Chifre Peludo, em Talramas.‡Найти выносливого гонца Торчащего Рога в Талрамасе.‡Sucht in Talramas nach Fernläufer Borstenhorn.‡탈라마스에서 수색꾼 브리슬혼을 찾아야 합니다.‡Encuentra al enviado Cornopúa en Talramas.‡Encuentra al enviado Cuernopúa en Talramas.‡Trouvez le Long-coureur Corne-dressée à Talramas.‡进入塔尔拉玛斯寻找远行者萨安·钢角。‡在塔爾拉瑪斯找到遠偵斥候鬃角。',
  }
},
[11679] = {
  {
    'Reforja da chave‡Воссоздание ключа‡Den Schlüssel neu schmieden‡열쇠 수리‡Volver a forjar la llave‡Volver a forjar la llave‡Reforger la clé‡重铸钥匙‡重鑄鑰匙',
    nil,
    'Donathan quer que você fale com Surristrasz, no Promontório Âmbar.‡По поручению Донатана поговорите с Сурристразом на Янтарной гряде.‡Donathan möchte, dass Ihr mit Surristrasz auf dem Bernsteinflöz sprecht.‡도나단이 호박석 절벽에 있는 술리스트라즈와 대화해 달라고 했습니다.‡Donathan te ha enviado a hablar con Surristrasz en El Saliente Ámbar.‡Donathan te ha enviado a hablar con Surristrasz en El Saliente Ámbar.‡Donathan veut que vous parliez à Surristrasz sur l\'Escarpement d\'Ambre.‡多纳森要你与琥珀崖的苏雷斯塔兹谈一谈。‡唐納森希望你去和琥珀岩臺的瑟利斯塔茲談談。',
  }
},
[11680] = {
  {
    'Asas emprestadas‡Полетаем?‡Jemanden unter seine Fittiche nehmen‡비상‡¡Volando!‡¡Volando!‡L\'envol‡准备飞翔‡起飛',
    nil,
    'Dê a Chave de Salrand para o Mago-de-guerra Anzim quando estiver pronto para libertar Evanor.‡Отдайте ключ Салранд боевому магу Анзиму, когда будете готовы освободить Эванор.‡Gebt Kriegsmagier Anzim Salrands Schlüssel, wenn Ihr bereit seid, Evanor zu befreien.‡에바노르를 풀어줄 준비가 되면 전쟁마법사 안짐에게 살란드의 열쇠를 전달해야 합니다.‡Cuando estés listo para liberar a Evanor, entrégale la llave de Salrand al mago de guerra Anzim.‡Cuando estés listo para liberar a Evanor, entrégale la llave de Salrand al mago de guerra Anzim.‡Lorsque vous serez prêt à libérer Evanor, donnez la Clé de Salrand au Mage de guerre Anzim.‡当你准备好营救艾瓦诺尔时，将莎尔兰德的钥匙交给战斗法师安斯姆。‡等你準備好釋放伊娃諾時，將沙爾倫的鑰匙交給戰爭法師安辛。',
  }
},
[11681] = {
  {
    'O resgate de Evanor‡Спасение Эванор‡Evanor retten‡에바노르 구출‡Rescatar a Evanor‡Rescatar a Evanor‡Au secours d\'Evanor‡营救艾瓦诺尔‡解救伊娃諾',
    nil,
    'Anzim, no Promontório Âmbar, quer que você voe com os magos-de-guerra para libertar Lady Evanor no Penhasco de Berília. Depois, apresente-se a ela na torre dos magos, no Promontório Âmbar.‡Отправляйтесь с боевыми магами и освободите леди Эванор из Бериллового лагеря по просьбе Анзима с Янтарной гряды. Затем явитесь к ней в башню магов на Янтарной гряде.‡Anzim vom Bernsteinflöz möchte, dass Ihr gemeinsam mit seinen Kriegsmagiern losfliegt, um Lady Evanor auf der Beryllspitze zu befreien. Danach sollt Ihr Euch bei Ihr im Magierturm auf dem Bernsteinflöz melden.‡호박석 절벽의 안짐이 전투마법사들과 함께 날아가 녹주석 거점에 있는 대마법사 에바노르를 풀어달라고 했습니다. 그런 다음 호박석 절벽의 마법사 탑에서 에바노르에게 보고해야 합니다.‡Anzim en El Saliente Ámbar quiere que vueles con sus magos de guerra para liberar a Lady Evanor en Alto de Berilo. Después tendrás que ir a informarle en la Torre de los Magos.‡Anzim en El Saliente Ámbar quiere que vueles con sus magos de guerra para liberar a Lady Evanor en Alto de Berilo. Después tendrás que ir a informarle en la Torre de los Magos.‡Anzim, de l\'Escarpement d\'Ambre, vous demande de vous envoler avec ses mages de guerre pour libérer dame Evanor à la Halte de Béryl. Vous devrez ensuite lui faire votre rapport dans la tour des mages de l\'Escarpement d\'Ambre.‡琥珀崖的安斯姆要你和他手下的战斗法师飞往蓝玉营地，搭救艾瓦诺尔女士，然后返回琥珀崖的法师塔中，向艾瓦诺尔女士复命。‡琥珀岩臺的安辛要你和他的戰鬥法師一同飛往碧晶哨點釋放伊娃諾女士。完成後回到琥珀岩臺的法師塔回報安辛。',
  }
},
[11682] = {
  {
    'Fala dragônica‡Беседа с драконом‡Drachengespräche‡용의 전언‡Una charla con el dragón‡Una charla con el dragón‡Jargon & dragons‡苏雷斯塔兹‡與龍交談',
    nil,
    'Lady Evanor pediu para que você fale com Surristrasz, no Promontório Âmbar.‡Поговорите с Сурристразом по приказу леди Эванор с Янтарной гряды.‡Lady Evanor hat Euch ausgesandt, um mit Surristrasz vom Bernsteinflöz zu sprechen.‡대마법사 에바노르가 호박석 절벽의 술리스트라즈와 대화해 달라고 했습니다.‡Lady Evanor te ha enviado a hablar con Surristrasz en El Saliente Ámbar.‡Lady Evanor te ha enviado a hablar con Surristrasz en El Saliente Ámbar.‡Dame Evanor vous demande de parler à Surristrasz sur l\'Escarpement d\'Ambre.‡艾瓦诺尔女士要你与琥珀崖的苏雷斯塔兹谈一谈。‡伊娃諾女士派你前往琥珀岩臺，與瑟利斯塔茲交談。',
  }
},
[11683] = {
  {
    'Necrópole caída‡Упавший некрополь‡Gefallene Nekropole‡추락한 죽음의 요새‡La necrópolis caída‡La necrópolis caída‡La nécropole écrasée‡坠落的浮空城‡墜毀的亡域',
    nil,
    'Destrua 20 Flagelos de qualquer tipo em Talramas e nos Poços Purulentos. Depois, fale novamente com Sábia Chapadalta, ao sul das Tocas da Morte.‡Уничтожьте 20 созданий Плети любого вида в Талрамасе и Гнойных прудах. Затем возвращайтесь к ведунье Высокий Холм, находящейся к югу от Келий Смерти.‡Vernichtet bei den Eiterteichen und in Talramas 20 Diener der Geißel jeglicher Art. Kehrt dann zur Weisen Hochmesa zurück, welche sich gleich südlich der Höhlen des Todes befindet.‡탈라마스와 썩은 웅덩이에서 종류에 상관없이 스컬지 20마리를 처치하고 사자의 동굴 바로 남쪽에 있는 현자 하이메사에게 가야 합니다.‡Mata a 20 miembros de la Plaga de cualquier tipo en Talramas y las Pozas Purulentas. Después vuelve junto a la sabia Altamesa que se encuentra justo al sur de Los Cubiles de los Moribundos.‡Mata a 20 miembros de la Plaga de cualquier tipo en Talramas y las Pozas Purulentas. Después vuelve junto a la sabia Altamesa que se encuentra justo al sur de Los Cubiles de los Moribundos.‡Détruisez 20 créatures du Fléau de n’importe quel type à Talramas et dans les Bassins Purulents. Lorsque ce sera fait, retournez voir la Sage Haute-mesa, juste au sud des Tanières du Trépas.‡在塔尔拉玛斯和溃烂之池杀死任意20名天灾军团成员，然后向亡者之穴以南的先知赫米萨复命。‡到塔爾拉瑪斯和膿瘡之池去摧毀任意20個天譴軍，然後，向垂死獸穴南方的賢者高臺回報。',
  }
},
[11684] = {
  {
    'Patrulhando as fossas‡Исследование воронок‡Aufspüren der Schlundlöcher‡구덩이 정찰‡Marcando los sumideros‡Marcando los sumideros‡Reconnaissance des puisards‡侦查虫孔‡偵察坑道口',
    nil,
    'O Grande Pai Mahan, na Aldeia Taunka\'le, quer que você use o Mapa dos Campos de Gêiser para marcar a localidade da Fossa Sul, da Fossa Noroeste e da Fossa Nordeste.‡По просьбе Великого Отца Махана, находящегося в деревне Таунка\'ле, отметьте на карте Поля Гейзеров Южную воронку, Северо-западную воронку и Северо-восточную воронку.‡Großvater Mahan in Taunka\'le möchte, dass Ihr die Karte der Geysirfelder nehmt und die Positionen des südlichen, des nordwestlichen und des nordöstlichen Schlundlochs eintragt.‡타운카르 마을에 있는 대부 마한이 간헐천 지대 지도를 사용해 남쪽 구덩이, 북서쪽 구덩이, 북동쪽 구덩이의 위치를 표시해 달라고 했습니다.‡El Abuelo Mahan en el Poblado Taunka\'le quiere que uses el mapa de Los Campos de Géiseres para marcar la ubicación del sumidero sur, el sumidero noroeste y el sumidero noreste.‡El Abuelo Mahan en el Poblado Taunka\'le quiere que uses el mapa de Los Campos de Géiseres para marcar la ubicación del sumidero sur, el sumidero noroeste y el sumidero noreste.‡Grandpère Mahan, à Taunka\'le, vous demande d\'utiliser la Carte des champs de Geysers afin d\'y écrire l\'emplacement du Puisard sud, du Puisard nord-ouest et du Puisard nord-est.‡牦牛村的玛罕宗父要求你使用喷泉平原地图标记出南部虫孔、西北部虫孔和东北部虫孔的位置。‡坦卡雷村的主父瑪哈要你使用水泉原野地圖去紀錄南部坑道口，西北部坑道口，以及東北部坑道口的位置。',
  }
},
[11685] = {
  {
    'O coração dos elementos‡Сердце стихий‡Das Herz der Elemente‡정령의 심장‡El corazón de los elementos‡El corazón de los elementos‡Le cœur des éléments‡元素之心‡元素之心',
    nil,
    'Traga 5 Corações de Elemental para a Doma-ventos Barah, na Aldeia Taunka\'le.‡Принесите 5 сердец элементалей укротителю ветра Баре в деревне Таунка\'ле.‡Bringt 5 Elementarherzen zu Windzähmerin Barah in Taunka\'le.‡정령의 심장 5개를 타운카르 마을에 있는 바람의 조련사 바라에게 가져가야 합니다.‡Llévale 5 corazones elementales a la domadora del viento Barah en el Poblado Taunka\'le.‡Llévale 5 corazones elementales a la domadora del viento Barah en el Poblado Taunka\'le.‡Apportez 5 Cœurs élémentaires à la Dompteuse des vents Barah à Taunka\'le.‡将5份元素之心交给牦牛村的驯风者巴兰。‡帶5個元素之心給坦卡雷村的馴風者巴拉。',
  }
},
[11686] = {
  {
    'As fazendas Brado Guerreiro‡Фермы Песни Войны‡Die Höfe des Kriegshymnenklans‡전쟁노래 농장‡Las Granjas Grito de Guerra‡Las Granjas Grito de Guerra‡Les fermes chanteguerre‡战歌农场‡戰歌農場',
    nil,
    'O Assombrante Ickoris, no Acampamento das Fazendas Brado Guerreiro, quer que você investigue o Celeiro Brado Guerreiro, a Fazenda dos Torp e o Matadouro Brado Guerreiro.‡Разведать положение дел в Амбаре Песни Войны, на ферме Торпа и на скотобойне Песни Войны по просьбе тенелова Икориса с заставы у ферм Песни Войны.‡Schattenpirscher Ickoris bei den Höfen des Kriegshymnenklans möchte, dass Ihr die Kornkammer des Kriegshymnenklans, Torps Bauernhof und den Schlachthof des Kriegshymnenklans ausspäht.‡전쟁노래 농장 전진기지의 그림자추적자 이코리스가 전쟁노래 곡물창고, 토르프의 농장, 그리고 전쟁노래 도살장을 정찰해 달라고 했습니다.‡El acechasombras Ickoris en la Avanzada de las Granjas Grito de Guerra quiere que explores el Granero Grito de Guerra, la Granja de Torp y el Matadero Grito de Guerra.‡El acechasombras Ickoris en la Avanzada de las Granjas Grito de Guerra quiere que explores el Granero Grito de Guerra, la Granja de Torp y el Matadero Grito de Guerra.‡Le traqueur des ombres Ickoris, à l\'Avant-poste des fermes chanteguerres, vous demande d\'explorer le Grenier chanteguerre, la Ferme de Torp et l\'Abattoir chanteguerre.‡战歌农场哨站的暗影密探伊克里斯要你去侦察战歌粮仓、托普的农场和战歌屠宰场的情况。‡戰歌農場前哨的巡影者艾寇里斯要你去偵察戰歌穀倉，托普的農場，及戰歌屠宰場。',
  }
},
[11687] = {
  {
    'O doutor e o lorde lich‡Доктор и Лич-Лорд‡Der Doktor und der Lichfürst‡의술사와 리치군주‡El doctor y el señor exánime‡El doctor y el señor exánime‡Le docteur et le seigneur-liche‡博士和巫妖领主‡博士與巫妖領主',
    nil,
    'Destrua o Doutor Bocafiada e o Lorde Lich Hibernus. Depois, fale novamente com a Sábia Chapadalta ao sul das Tocas da Morte.‡Убейте доктора Щербохмыла и Лич-Лорда Хладолюта. Затем вернитесь к ведунье Высокий Холм, которая ждет вас к югу от Келий Смерти.‡Vernichtet Doktor Klingengrinser und Lichfürst Frostwinter und kehrt anschließend zur Weisen Hochmesa zurück. Sie befindet sich gleich südlich der Höhlen des Todes.‡의술사 레이저그린과 리치군주 칠윈터를 처치한 다음, 사자의 동굴 바로 남쪽에 있는 현자 하이메사에게 가야 합니다.‡Acaba con el doctor Muecafilada y con el señor exánime Invierno Helado. Después vuelve junto a la sabia Altamesa al sur de Los Cubiles de los Moribundos.‡Acaba con el doctor Muecafilada y con el señor exánime Invierno Helado. Después vuelve junto a la sabia Altamesa al sur de Los Cubiles de los Moribundos.‡Détruisez le Docteur Trancherictus et le Seigneur-liche Frisshiver. Puis retournez voir la Sage Haute-mesa juste au sud des Tanières du Trépas.‡杀死拉佐格林博士和巫妖领主基尔温特，然后向北风苔原亡者之穴以南的先知赫米萨复命。‡殺死剃刀獰笑博士和巫妖領主冽冬。接著回到北風凍原的死亡獸穴南邊找高臺賢者。',
  }
},
[11688] = {
  {
    'Malditos suínos imundos‡Проклятые грязные свиньи‡Verdammte, dreckige Schweine‡추잡한 돼지‡Malditos puercos apestosos‡Malditos puercos apestosos‡Saleté de cochonnerie de pourceaux‡该死的猪‡該死的不潔豬隻',
    nil,
    'O Fazendeiro Torp, no Acampamento das Fazendas Brado Guerreiro, quer que você mate 10 Suínos Vivos-mortos.‡По просьбе фермера Торпа с заставы у ферм Песни Войны убейте 10 неживых кабанов.‡Bauer Torp bei den Höfen des Kriegshymnenklans möchte, dass Ihr 10 untote Schweine tötet.‡전쟁노래 농장 전진기지에 있는 농부 토르프가 죽지 못하는 돼지 10마리를 처치해 달라고 했습니다.‡El granjero Torp en las Granjas Grito de Guerra quiere que mates a 10 puercos sin vida.‡El granjero Torp en las Granjas Grito de Guerra quiere que mates a 10 puercos sin vida.‡Le fermier Torp, à l’Avant-poste des fermes chanteguerres, veut que vous tuiez 10 Pourceaux non-vivants.‡战歌农场哨站的农夫托普要你杀死10只亡灵猪。‡戰歌農場前哨的農夫托普要你去殺了10隻骸豬。',
  }
},
[11689] = {
  {
    'Volte com as más notícias‡Вестник печали‡Schlechte Nachrichten überbringen‡안타까운 소식‡Regresa con las malas noticias‡Regresa con las malas noticias‡Transmettre les mauvaises nouvelles‡报告坏消息‡帶著噩耗回來',
    nil,
    'Fale com a Grande Mãe Taiga, na Aldeia Taunka\'le.‡Поговорите с Великой Матерью Тайгой в деревне Таунка\'ле.‡Sprecht mit Großmutter Taiga in Taunka\'le.‡타운카르 마을에 있는 대모 타이가와 대화해야 합니다.‡Habla con la abuela Taiga en el Poblado Taunka\'le.‡Habla con la abuela Taiga en el Poblado Taunka\'le.‡Parlez à la Grande-mère Taiga à Taunka\'le.‡与牦牛村的塔迦祖母谈一谈。‡和坦卡雷村的主母泰嘉交談。',
  }
},
[11690] = {
  {
    'Traga-os de volta vivos‡Верни их живыми!‡Bringt sie lebend zurück‡살려서 데려오기‡Tráelos de vuelta con vida‡Tráelos de vuelta con vida‡Ram\'nez-les vivants‡把它们活着带回去‡帶牠們活著回來',
    nil,
    'O Fazendeiro Torp, no Acampamento das Fazendas Brado Guerreiro, quer que você resgate 8 Feras Kodo Infectadas.‡Спасите 8 зараженных кодо по просьбе фермера Торпа с Заставы у ферм Песни Войны.‡Bauer Torp bei den Höfen des Kriegshymnenklans möchte, dass Ihr 8 infizierte Kodobestien rettet.‡전쟁노래 농장 전진기지에 있는 농부 토르프가 병든 야생 코도 8마리를 구해달라고 했습니다.‡El granjero Torp en las Granjas Grito de Guerra quiere que rescates a 8 bestias kodo infectadas.‡El granjero Torp en las Granjas Grito de Guerra quiere que rescates a 8 bestias kodo infectadas.‡Le fermier Torp, à l’Avant-poste des fermes chanteguerres, veut que vous sauviez 8 Kodos infectés.‡战歌农场哨站的农夫托普要你帮忙解救8只被感染的科多兽。‡戰歌農場前哨的農夫托普要你去營救8隻受感染的科多獸。',
  }
},
[11691] = {
  {
    'Evocar Ahune‡Призовите Ахуна‡Beschwört Ahune‡아훈 소환‡Invocar a Ahune‡Invocar a Ahune‡L\'invocation d\'Ahune‡召唤埃霍恩‡召喚艾胡恩',
    nil,
    'Leve o Totem de Magma da Harmonia Telúrica até a Pedra de Gelo.‡Принесите тотем магмы Служителей Земли к Камню Льда.‡Bringt dieses Magmatotem des Irdenen Rings zum Eisbrocken.‡대지 고리회 용암 토템을 얼음 기둥으로 가져가야 합니다.‡Lleva el tótem de magma del Anillo de la Tierra a la piedra de hielo.‡Lleva el tótem de magma del Anillo de la Tierra a la piedra de hielo.‡Apportez le Totem de magma du Cercle terrestre à la Pierre de glace.‡将大地之环熔岩图腾带到寒冰之石旁边去。‡將陶土議會熔岩圖騰帶到冰石旁邊。',
  }
},
[11692] = {
  {
    'Apresente-se à Tita‡В поисках Бикси‡Bei Bixie einchecken‡빅시를 찾아라‡Preséntate ante Bixie‡Preséntate ante Bixie‡Allez voir Bixie‡寻找比希‡找出碧西',
    nil,
    'Otto Rodagiros pediu para que você encontre Tita Espetorque, ao sul das Tocas da Morte.‡Как и просил вас Мордл Шестеренок, отправляйтесь на поиски Бикси Винтодер к югу от Келий Смерти.‡Mordle Zahnrad möchte, dass Ihr Bixie Zangkeuler aufsucht, die sich südlich der Höhlen des Todes befindet.‡모르들 코그스피너가 사자의 동굴 남쪽에서 빅시 렌치섕커를 찾아 달라고 했습니다.‡Mordle Volopiñón te ha pedido que encuentres a Bixie Patituerca al sur de Los Cubiles de los Moribundos.‡Mordle Volopiñón te ha pedido que encuentres a Bixie Patituerca al sur de Los Cubiles de los Moribundos.‡Mordle Tournepignon vous a demandé de trouver Bixie Tournechancre au sud des Tanières du Trépas.‡墨尔杜·旋轮要你前往亡者之穴以南寻找比希·钳柄。‡莫爾斗·榫紡請你到垂死獸穴的南方找碧西·扭柄。',
  }
},
[11693] = {
  {
    'Que maravilha... Magnatauros pestilentos!‡Только не чумной магнатавр!‡Oh, großartig... verseuchte Magnatauren!‡역병 걸린 마그나타우르라니!‡Oh genial... ¡magnatauros apestados!‡Oh genial... ¡magnatauros apestados!‡Super… des magnataures pestiférés !‡好极了……天灾猛犸人！‡喔太好了…染疫猛瑪象人!',
    nil,
    'Mate 10 Magnatauros Pestilentos e fale novamente com Tita Espetorque ao sul das Tocas da Morte.‡Убейте 10 чумных магнатавров и возвращайтесь к Бикси Винтодер к югу от Келий Смерти.‡Tötet 10 verseuchte Magnatauren. Kehrt anschließend zu Bixie Zangkeuler südlich der Höhlen des Todes.‡역병 걸린 마그나타우르 10마리를 처치하고 사자의 동굴 남쪽에 있는 빅시 렌치섕커에게 가야 합니다.‡Mata 10 magnatauros apestados y después vuelve a ver a Bixie Patituerca que está al sur de Los Cubiles de los Moribundos.‡Mata 10 magnatauros apestados y después vuelve a ver a Bixie Patituerca que está al sur de Los Cubiles de los Moribundos.‡Tuez 10 Magnataures pestiférés puis retournez voir Bixie Tournechancre au sud des Tanières du Trépas.‡杀死10名天灾猛犸人，然后向亡者之穴以南的比希·钳柄复命。‡殺死10個染疫猛瑪象人，接著回到垂死獸穴的南方找碧西·扭柄。',
  }
},
[11694] = {
  {
    'Algo se passa naquelas cavernas‡В пещерах что-то происходит...‡Irgendetwas geht in diesen Höhlen vor‡동굴 안에서 벌어지는 일‡En esas cuevas pasa algo raro‡En esas cuevas pasa algo raro‡Il se passe quelque chose dans ces grottes‡山洞中的瘟疫‡洞穴裡的古怪',
    nil,
    'Tita Espetorque, escondida ao sul das Tocas da Morte, pediu para que você use Pó de Inibição da Tita em um Caldeirão Pestilento das Tocas da Morte para neutralizá-lo.‡По просьбе Бикси Винтодер, что прячется к югу от Келий Смерти, всыпьте лечебный порошок Бикси в чумной котел в Кельях Смерти, чтобы нейтрализовать отвар в нем.‡Bixie Zangkeuler möchte, dass Ihr Bixies Desinfektionspuder in den Seuchenkessel in den Höhlen des Todes schüttet, um ihn zu neutralisieren. Bixie schleicht gleich südlich der Höhlen des Todes herum.‡사자의 동굴 남쪽에 있는 빅시 렌치섕커가, 사자의 동굴 역병 가마솥에 빅시의 중화제를 사용해 그 내용물을 중화해 달라고 했습니다.‡Bixie Patituerca, que merodea al sur de Los Cubiles de los Moribundos, te ha pedido que uses el polvo de inhibición de Bixie en la caldera de peste del Cubil de los Moribundos para neutralizarlo.‡Bixie Patituerca, que merodea al sur de Los Cubiles de los Moribundos, te ha pedido que uses el polvo de inhibición de Bixie en la caldera de peste del Cubil de los Moribundos para neutralizarlo.‡Bixie Tournechancre, qui se planque au sud des Tanières du Trépas, veut que vous utilisiez la Poudre inhibitrice de Bixie sur un Chaudron de peste des Tanières du Trépas, afin de le neutraliser.‡亡者之穴以南的比希·钳柄要你进入亡者之穴，对一口天灾之锅使用比希的中和药粉。‡潛伏在垂死獸穴南方的碧西·扭柄要你對垂死獸穴瘟疫大鍋使用碧西的抑制粉末來中和它。',
  }
},
[11695] = {
  {
    'A Trompa da Fúria Elemental‡Рог неистовства стихий‡Das Horn des Elementarfurors‡자연 격노의 뿔피리‡El Cuerno de Furia Elemental‡El Cuerno de Furia Elemental‡Le cor de fureur élémentaire‡元素愤怒号角‡元素之怒號角',
    nil,
    'Recupere a Metade Inferior da Trompa e a Metade Superior da Trompa do Chefe Gafamafo e do Chefe Mafagafo e leve-as para a Doma-ventos Barah, na Aldeia Taunka\'le.‡Добудьте нижнюю половину рога и верхнюю половину рога у вождя Бурблгубля и вождя Гурглбугля и принесите их укротителю ветра Баре в деревне Таунка\'ле.‡Tötet Häuptling Burbelgobbel und Häuptling Gurgelboggel, nehmt ihnen die untere und obere Hornhälfte ab und bringt sie zu Windzähmerin Barah in Taunka\'le.‡아래쪽 뿔피리 조각과 위쪽 뿔피리 조각을 타운카르 마을에 있는 바람의 조련사 바라에게 가져가야 합니다.‡Reclama la mitad inferior del cuerno y la mitad superior del cuerno al cabecilla Gorgogluglú y al cabecilla Borbogluglú y llévaselas a la domadora del viento Barah en el Poblado Taunka\'le.‡Reclama la mitad inferior del cuerno y la mitad superior del cuerno al cabecilla Gorgogluglú y al cabecilla Borbogluglú y llévaselas a la domadora del viento Barah en el Poblado Taunka\'le.‡Reprenez la Moitié inférieure du cor et la Moitié supérieure du cor au Chef Brouillegargouille et au Chef Grouillebarbouille et apportez-les à la Dompteuse des vents Barah à Taunka\'le.‡从布戈布咕酋长和咕戈布咕酋长手中夺得号角的上半截和号角的下半截，将它们交给牦牛村的驯风者巴兰。‡從波嚥酋長和汨驚酋長身上取回號角的下半部和號角的上半部，並將這兩樣東西帶給坦卡雷村的馴風者巴拉。',
  }
},
[11696] = {
  {
    'Ahune está aqui!‡Ахун явился!‡Ahune ist hier!‡여기에 아훈이!‡¡Ahune está aquí!‡¡Ahune está aquí!‡Ahune est là !‡埃霍恩就在这里！‡艾胡恩就在這裡!',
    nil,
    'Encontre a Luma Mãe dos Céus no Pátio dos Escravos.‡Найдите Луму Матерь Небес в Узилище.‡Findet Luma Himmelsmutter in den Sklavenunterkünften.‡강제 노역소에서 루마 스카이마더를 찾아야 합니다.‡Encuentra a Luma Cielomater en el Recinto de los Esclavos.‡Encuentra a Luma Cielomater en el Recinto de los Esclavos.‡Trouvez Luma Mère-des-cieux dans les Enclos aux esclaves.‡前往奴隶围栏，寻找鲁玛·天母的下落。‡在奴隸監獄中找到魯瑪·天空之母。',
  }
},
[11697] = {
  {
    'Raios! Tinqui foi pra necrópole!‡Тинки в некрополе!‡Mist, Tinky ist in die Nekropole gelaufen!‡혼자서 어딜 간 거야, 팅키!‡¡Demontre, Mañosa se ha metido en la necrópolis!‡¡Demontre, Mañosa se ha metido en la necrópolis!‡Zut, Bricole est entrée dans la nécropole !‡丁奇跑进浮空城了！‡糟糕，汀基跑進了亡域!',
    nil,
    'Encontre Tinqui Apitocurto dentro de Talramas.‡Отыщите Тинки Свистопляс внутри Талрамаса.‡Sucht Tinky Dochtpfiff im Inneren von Talramas.‡탈라마스 안에서 팅키 윅휘슬을 찾아야 합니다.‡Encuentra a Mañosa Silbatín dentro de Talramas.‡Encuentra a Mañosa Silbatín dentro de Talramas.‡Trouvez Bricole Sifflemèche à Talramas.‡进入塔尔拉玛斯寻找丁奇·火哨。‡到塔爾拉瑪斯尋找汀基·芯哨。',
  }
},
[11698] = {
  {
    'Aproveita e elimina o Flagelo‡Может, проще уничтожить Плеть?‡Man kann auch gleich die Geißel auslöschen‡스컬지 소탕‡También se podría hacer limpieza de la Plaga‡También se podría hacer limpieza de la Plaga‡On pourrait aussi bien éradiquer le Fléau‡顺便清理天灾士兵‡不如徹底消滅天譴軍團',
    nil,
    'Destrua 20 Flagelos de qualquer tipo em Talramas e nos Poços Purulentos. Depois, fale novamente com Tita Espetorque ao sul das Tocas da Morte.‡Уничтожьте 20 воинов Плети любого рода в Талрамасе и Гнойных прудах. Потом вернитесь к Бикси Винтодер к югу от Келий Смерти.‡Vernichtet bei den Eiterteichen und in Talramas 20 Diener der Geißel jeglicher Art. Kehrt dann zu Bixie Zangkeuler zurück, welche sich gleich südlich der Höhlen des Todes befindet.‡탈라마스와 썩은 웅덩이에서 스컬지 20마리를 처치한 다음, 사자의 동굴 바로 남쪽에 있는 빅시 렌치섕커에게 가야 합니다.‡Mata a 20 miembros de la Plaga de cualquier tipo en Talramas y las Pozas Purulentas. Después vuelve junto a Bixie Patituerca, que se encuentra justo al sur de Los Cubiles de los Moribundos.‡Mata a 20 miembros de la Plaga de cualquier tipo en Talramas y las Pozas Purulentas. Después vuelve junto a Bixie Patituerca, que se encuentra justo al sur de Los Cubiles de los Moribundos.‡Détruisez 20 créatures du Fléau de n\'importe quel type à Talramas et aux Bassins Purulents. Puis retournez voir Bixie Tournechancre juste au sud des Tanières du Trépas.‡在塔尔拉玛斯和溃烂之池杀死任意20名天灾军团成员，然后向亡者之穴以南的比希·钳柄复命。‡摧毀20個位於塔爾拉瑪斯和膿瘡之池的天譴軍，不限種類。接著，回到北風凍原的垂死獸穴正南方找碧西·扭柄。',
  }
},
[11699] = {
  {
    'Tô presa nessa maldita jaula... mas não por muito tempo!‡Я застряла в проклятой клетке… но ненадолго!‡Bin in diesem verdammten Käfig gefangen... aber nicht mehr lange!‡갇히긴 했지만... 금방 나갈 수 있다고요!‡Estoy encerrada en esta maldita jaula... ¡Pero no por mucho tiempo!‡Estoy encerrada en esta maldita jaula... ¡Pero no por mucho tiempo!‡Je suis coincée dans cette maudite cage… mais pas pour longtemps !‡我被困在笼子里了……‡我被困在這個該死的籠子…不過關不了太久了!',
    nil,
    'Consiga um Cristal de Núcleo-Motor, um Giroscópio Mágico e uma Pedra do Flagelo Timoneira. Entregue-os a Tinqui Apitocurto em Talramas.‡Найдите кристалл энергетического ядра, магический гироскоп и направляющий камень Плети и отдайте их Тинки Свистопляс в Талрамасе.‡Findet einen Motorkernkristall, ein magisches Gyroskop und einen Geißelsteuerungsstein. Liefert die Gegenstände anschließend bei Tinky Dochtpfiff in Talramas ab.‡엔진 동력 수정, 마법 회전의, 조종의 스컬지석을 모아 탈라마스에 있는 팅키 윅휘슬에게 전달해야 합니다.‡Consigue un cristal del núcleo de motor, un giroscopio mágico y una piedra de la Plaga de pilotaje. Entrégaselas a Mañosa Silbatín en Talramas.‡Consigue un cristal del núcleo de motor, un giroscopio mágico y una piedra de la Plaga de pilotaje. Entrégaselas a Mañosa Silbatín en Talramas.‡Récupérez un Cristal du bloc-moteur, un Gyroscope magique et une Pierre du Fléau de pilotage, et remettez-les à Bricole Sifflemèche, à Talramas.‡将引擎核心水晶、魔法陀螺仪和导航天灾石交给塔尔拉玛斯的丁奇·火哨。‡收集一個引擎核心水晶，一個魔法迴轉儀，以及一個導引天譴石。將這些帶到塔爾拉瑪斯交給汀基·芯哨。',
  }
},
[11700] = {
  {
    'Conte a Tita‡Сообщение для Бикси‡Lasst es Bixie wissen‡빅시에게 알리기‡Avisa a Bixie‡Avisa a Bixie‡Prévenez Bixie‡通知比希‡通知碧西',
    nil,
    'Fale com Tita Espetorque ao sul das Tocas da Morte.‡Поговорите с Бикси Винтодер, находящейся рядом с Кельями Смерти, к югу от них.‡Sprecht mit Bixie Zangkeuler gleich südlich der Höhlen des Todes.‡사자의 동굴 바로 남쪽에 있는 빅시 렌치섕커와 대화해야 합니다.‡Habla con Bixie Patituerca, justo al sur de Los Cubiles de los Moribundos.‡Habla con Bixie Patituerca, justo al sur de Los Cubiles de los Moribundos.‡Parlez à Bixie Tournechancre juste au sud des Tanières du Trépas.‡与亡者之穴以南的比希·钳柄谈一谈。‡與垂死獸穴南方的碧西·扭柄談談。',
  }
},
[11701] = {
  {
    'De volta à pista de pouso‡Возвращение к взлетной полосе‡Zurück zum Landeplatz‡다시 비행장으로‡De vuelta a la Pista de Aterrizaje‡De vuelta a la Pista de Aterrizaje‡Retour à la piste d\'atterrissage‡返回机场‡回到簡易機場',
    nil,
    'Fale com Biela Velotroll na Pista de Pouso do Biela, que fica na Tundra Boreana.‡Поговорите с Выкрутенем Разгоняйло на взлетной полосе Выкрутеня в Борейской тундре.‡Sprecht mit Kurbelzisch Vollgas auf der Landebahn Kurbelzisch in der Boreanischen Tundra.‡북풍의 땅의 피즈크랭크 비행장에 있는 피즈크랭크 풀스로틀과 대화해야 합니다.‡Habla con Palanqueta Todogás en la Pista de Aterrizaje de Palanqueta, en la Tundra Boreal.‡Habla con Palanqueta Todogás en la Pista de Aterrizaje de Palanqueta, en la Tundra Boreal.‡Parlez à Spumelevier Pleingaz sur la Piste d\'atterrissage de Spumelevier, dans la Toundra Boréenne.‡与北风苔原菲兹兰克机场的菲兹兰克·铁阀谈一谈。‡到北方凍原的嘶軸簡易機場找嘶軸·滿閥談談。',
  }
},
[11702] = {
  {
    'O rei Mrgl-Mrgl‡Король Мргл-Мргл‡König Mrgl-Mrgl‡멀록왕 아옳아옳‡El rey Mrgl-Mrgl‡El rey Mrgl-Mrgl‡Le roi Mrgl-Mrgl‡国王姆嘎姆嘎‡莫戈莫戈大王',
    nil,
    'Fale com Rei Mrgl-Mrgl no Retiro da Falésia Invernal.‡Поговорите с королем Мрглом-Мрглом в Приюте Зимних Плавников.‡Sprecht mit König Mrgl-Mrgl. Dieser befindet sich in der Zuflucht der Winterflossen.‡겨울지느러미 은신처에 있는 멀록왕 아옳아옳과 대화해야 합니다.‡Habla con el rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Habla con el rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Allez voir le Roi Mrgl-Mrgl à la Retraite des Ailerons-d\'hiver.‡与冬鳍避难所的国王姆嘎姆嘎谈一谈。‡前往北風凍原的冬鰭避居地找莫戈莫戈大王談談。',
  }
},
[11703] = {
  {
    'Fale com Getry‡Добраться до Гетри‡Gelangt zu Getry‡게트리 찾아가기‡Llega hasta Getry‡Llega hasta Getry‡Rallier Getry‡暗影密探盖特莱‡去找蓋特利',
    nil,
    'Encontre o Assombrante Getry nas Fazendas Brado Guerreiro.‡Найдите тенелова Гетри у ферм Песни Войны.‡Geht zu den Höfen des Kriegshymnenklans und findet Schattenpirscher Getry.‡전쟁노래 농장에 있는 그림자추적자 게트리와 대화해야 합니다.‡Encuentra al acechasombras Getry en las Granjas Grito de Guerra.‡Encuentra al acechasombras Getry en las Granjas Grito de Guerra.‡Allez voir le Traqueur des ombres Getry aux Fermes chanteguerre.‡在战歌农场中寻找暗影密探盖特莱。‡找到戰歌農場的巡影者蓋特利。',
  }
},
[11704] = {
  {
    'O rei Mrgl-Mrgl‡Король Мргл-Мргл‡König Mrgl-Mrgl‡멀록왕 아옳아옳‡El rey Mrgl-Mrgl‡El rey Mrgl-Mrgl‡Le roi Mrgl-Mrgl‡国王姆嘎姆嘎‡莫戈莫戈大王',
    nil,
    'Fale com Rei Mrgl-Mrgl no Retiro da Falésia Invernal.‡Поговорите с королем Мрглом-Мрглом у Приюта Зимних Плавников.‡Sprecht mit König Mrgl-Mrgl. Dieser befindet sich in der Zuflucht der Winterflossen.‡겨울지느러미 은신처에 있는 멀록왕 아옳아옳과 대화해야 합니다.‡Habla con el rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Habla con el rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Parlez au Roi Mrgl-Mrgl à la Retraite des Ailerons-d\'hiver.‡与冬鳍避难所的国王姆嘎姆嘎谈一谈。‡前往冬鰭避居地找莫戈莫戈大王談談。',
  }
},
[11705] = {
  {
    'Esforços em vão‡Бесполезные старания‡Törichtes Unterfangen‡무모한 시도‡Una empresa insensata‡Una empresa insensata‡Opération absurde‡愚蠢的努力‡愚蠢的努力',
    nil,
    'Ajude Getry a derrotar Varidus, o Esfolador, nas Fazendas Brado Guerreiro.|n|nApresente-se a Garrosh Grito Infernal caso seja bem-sucedido.‡Помогите Гетри одолеть Варидуса Свежевателя у ферм Песни Войны.|n|nЕсли вам это удастся, явитесь к Гаррошу Адскому Крику.‡Helft Getry dabei, Varidus den Flenser bei den Höfen des Kriegshymnenklans zu besiegen.|n|nFalls Ihr erfolgreich sein solltet, erstattet Garrosh Höllschrei Bericht.‡전쟁노래 농장에서 게트리를 도와 무두장이 바리두스를 처치하고 가로쉬 헬스크림에게 보고해야 합니다.‡Ayuda a Getry a derrotar a Varidus el Desollador en las Granjas Grito de Guerra.|n|nInforma a Garrosh Grito Infernal si tienes éxito.|n‡Ayuda a Getry a derrotar a Varidus el Desollador en las Granjas Grito de Guerra.|n|nInforma a Garrosh Grito Infernal si tienes éxito.|n‡Aidez Getry à vaincre Varidus le Dépiauteur aux Fermes chanteguerre.|n|nFaites votre rapport à Garrosh Hurlenfer si vous deviez réussir.‡帮助盖特莱击败战歌农场的残忍的瓦雷杜斯。|n|n完成任务后向加尔鲁什·地狱咆哮复命。‡協助蓋特利擊敗戰歌農場的『剝皮者』瓦瑞達斯。|n|n完成後回報給卡爾洛斯·地獄吼。',
  }
},
[11706] = {
  {
    'O desmoronamento‡Обрушение‡Der Kollaps‡붕괴‡El derrumbamiento‡El derrumbamiento‡L\'effondrement‡天崩地裂‡崩壞',
    nil,
    'A Doma-ventos Barah, na Aldeia Taunka\'le, quer que você faça com que as fossas nerubianas desmoronem usando a Trompa da Fúria Elemental e derrote o Lorde Kryxix.‡Обрушьте нерубские воронки с помощью рога неистовства стихий и уничтожьте лорда Криксиса по просьбе укротителя ветра Бары из деревни Таунка\'ле.‡Windzähmerin Barah in Taunka\'le möchte, dass Ihr die nerubischen Schlundlöcher mithilfe des Horns des Elementarfurors zum Einsturz bringt und Fürst Kryxix besiegt.‡타운카르 마을에 있는 바람의 조련사 바라가 자연 격노의 뿔피리를 사용해 네루비안 구덩이를 무너트리고 군주 크릭식스를 처치해 달라고 했습니다.‡La domadora del viento Barah en el Poblado Taunka\'le quiere que derrumbes los sumideros nerubianos usando el Cuerno de Furia Elemental y que derrotes a Lord Kryxix.‡La domadora del viento Barah en el Poblado Taunka\'le quiere que derrumbes los sumideros nerubianos usando el Cuerno de Furia Elemental y que derrotes a Lord Kryxix.‡La Dompteuse des vents Barah, de Taunka\'le, vous demande de faire s\'effondrer les puisards nérubiens à l\'aide du Cor de fureur élémentaire et de vaincre le seigneur Kryxix.‡牦牛村的驯风者巴兰要求你使用元素愤怒号角将蛛魔的虫孔弄塌，并击败克里卡希斯。‡坦卡雷村的馴風者巴拉要你使用元素之怒號角崩潰奈幽巴坑道口，並擊敗克萊克希斯克領主。',
  }
},
[11707] = {
  {
    'Chamada de emergência‡Просьба о помощи‡Notruf‡구원 요청‡Llamada de socorro‡Llamada de socorro‡Appel de détresse‡迫在眉睫‡苦惱的請求',
    nil,
    'Fale com Biela Velotroll na Pista de Pouso do Biela.‡Поговорите с Выкрутенем Разгоняйло на взлетной полосе Выкрутеня.‡Sprecht mit Kurbelzisch Vollgas auf der Landebahn Kurbelzisch.‡피즈크랭크 비행장에 있는 피즈크랭크 풀스로틀과 대화해야 합니다.‡Habla con Palanqueta Todogás en la Pista de Aterrizaje de Palanqueta.‡Habla con Palanqueta Todogás en la Pista de Aterrizaje de Palanqueta.‡Allez voir Spumelevier Pleingaz à la Piste d\'atterrissage de Spumelevier.‡与菲兹兰克机场的菲兹兰克·铁阀谈一谈。‡前往嘶軸簡易機場找嘶軸·滿閥談談。',
  }
},
[11708] = {
  {
    'Os gnomecânicos‡Механогномы‡Die Mechagnome‡기계노움‡Los mecagnomos‡Los mecagnomos‡Les mécagnomes‡机械侏儒‡機械地精',
    nil,
    'Ouça a história de Biela Velotroll e depois encontre Jinqui Porcassolta, na Pista de Pouso do Biela.‡Выслушайте рассказ Выкрутеня Разгоняйло и найдите на взлетной полосе Выкрутеня Джинки Гайковорот.‡Hört Euch Kurbelzisch Vollgas\' Bericht an und sucht anschließend Jinky Flügelirre auf der Landebahn Kurbelzisch auf.‡피즈크랭크 풀스로틀의 이야기를 듣고 피즈크랭크 비행장에서 징키 윙넛을 찾아야 합니다.‡Escucha la historia de Palanqueta Todogás y después busca a Jinky Alatuerca en la Pista de Aterrizaje de Palanqueta.‡Escucha la historia de Palanqueta Todogás y después busca a Jinky Alatuerca en la Pista de Aterrizaje de Palanqueta.‡Écoutez l\'histoire de Spumelevier Pleingaz puis allez voir Voltij Lazimuté à la Piste d\'atterrissage de Spumelevier.‡听菲兹兰克·铁阀讲诉目前的情况，然后与菲兹兰克机场的金吉·温纳特谈一谈。‡聽取嘶軸·滿閥的故事，然後去嘶軸簡易機場找金基·翼果。',
  }
},
[11709] = {
  {
    'Trabalho de Nork Frenessangue‡Поручение Нока Кровавое Бешенство‡Nork Blutwahns Aufgabe‡노르크 블러드프렌지의 임무‡La carga de Nork Ansiasangre‡La carga de Nork Ansiasangre‡La charge de Nork Frénésie-sanglante‡诺克·血怒‡諾克·血狂的攻擊',
    nil,
    'Fale com o Carcereiro Nork Frenessangue na Fortaleza Brado Guerreiro, que fica na Tundra Boreana.‡Поговорите со стражем-смотрителем Ноком Кровавое Бешенство из Крепости Песни Войны в Борейской тундре.‡Sprecht mit Aufseher Nork Blutwahn in der Kriegshymnenfeste in der Boreanischen Tundra.‡북풍의 땅의 전쟁노래 요새에 있는 감시자 노르크 블러드프렌지와 대화해야 합니다.‡Habla con el celador Nork Ansiasangre en el Bastión Grito de Guerra en la Tundra Boreal.‡Habla con el celador Nork Ansiasangre en el Bastión Grito de Guerra en la Tundra Boreal.‡Parlez au Gardien Nork Frénésie-sanglante au Bastion Chanteguerre, dans la Toundra Boréenne.‡与北风苔原中战歌要塞的典狱官诺克·血怒谈一谈。‡到北風凍原的戰歌堡與看守者諾克·血狂談談。',
  }
},
[11710] = {
  {
    'Qual o problema com o transubstanciador?‡Что такое с передачником?‡Was ist nur los mit der Transmaterie?‡고장 난 전송 장치‡No es seria esta transmateria...‡No es seria esta transmateria...‡Transmatière à rire‡转换器怎么了？‡這個運輸是怎麼回事?',
    nil,
    'Consiga 15 Peças Sobressalentes do Biela e entregue-as para Otto Rodagiros, na Pista de Pouso do Biela.‡Соберите 15 запасных деталей Выкрутеня и доставьте их Мордлу Шестеренку на взлетную полосу Выкрутеня.‡Sammelt 15 Ersatzteile von Kurbelzisch und liefert sie an Mordle Zahnrad auf der Landebahn Kurbelzisch.‡피즈크랭크 예비 부품 15개를 모아 피즈크랭크 비행장에 있는 모르들 코그스피너에게 가져가야 합니다.‡Reúne 15 piezas de repuesto de Palanqueta y llévaselas a Mordle Volopiñón en la Pista de Aterrizaje de Palanqueta.‡Reúne 15 piezas de repuesto de Palanqueta y llévaselas a Mordle Volopiñón en la Pista de Aterrizaje de Palanqueta.‡Ramassez 15 Pièces détachées de Spumelevier et rapportez-les à Mordle Tournepignon à la Piste d\'atterrissage de Spumelevier.‡将15个菲兹兰克备用零件交给菲兹兰克机场的墨尔杜·旋轮。‡收集15個嘶軸的備用零件，然後送交給嘶軸簡易機場的莫爾斗·榫紡。',
  }
},
[11711] = {
  {
    'Covarde em domicílio... Entrega em 30 minutos ou seu dinheiro de volta‡Доставка дезертиров: от получаса ожидания – бесплатно!‡Angsthasenlieferung... unter 30 Minuten - ansonsten gratis‡겁쟁이 배달합니다... 30분 이상 걸리면 공짜!‡Entrega de cobardes... en menos de 30 minutos, o será gratis‡Entrega de cobardes... en menos de 30 minutos, o será gratis‡Livraison de lâche… En moins de 30 minutes, ou c\'est gratuit‡逃兵快递，30分钟送到否则免费‡膽小鬼貨運…30分鐘內送達否則免費',
    nil,
    'Leve o Desertor da Aliança para a encruzilhada leste da Fortaleza Brado Guerreiro e dispare a Pistola Sinalizadora do Brado Guerreiro para sinalizar à Aliança.|n|nApresente-se ao Batedor Tungok assim que tiver entregado o Desertor da Aliança ao seu destino.‡Отведите дезертира Альянса к перекрестку восточнее крепости Песни Войны и выстрелите из сигнального ружья Песни Войны, чтобы дать сигнал представителям Альянса.|n|nДоложитесь разведчику Тунгоку, когда успешно доставите дезертира Альянса по месту назначения.‡Bringt den Deserteur der Allianz zur Kreuzung östlich der Kriegshymnenfeste und feuert die Leuchtpistole des Kriegshymnenklans ab, um der Allianz ein Zeichen zu geben.|n|nMeldet Euch bei Späher Tungok, nachdem die Übergabe des Deserteurs der Allianz erfolgreich abgeschlossen wurde.‡얼라이언스 탈영병을 전쟁노래 요새 동쪽의 교차로로 데려간 다음 전쟁노래 신호용 권총을 사용해 얼라이언스에 신호를 보내야 합니다.|n|n임무를 무사히 완수하면 정찰병 툰고크에게 보고하십시오.‡Lleva al desertor de la Alianza hasta el cruce al este del Bastión Grito de Guerra y dispara tu pistola de bengalas Grito de Guerra para mandar una señal a la Alianza.|n|nInforma al explorador Tungok cuando hayas llevado al desertor de la Alianza a su destino con éxito.‡Lleva al desertor de la Alianza hasta el cruce al este del Bastión Grito de Guerra y dispara tu pistola de bengalas Grito de Guerra para mandar una señal a la Alianza.|n|nInforma al explorador Tungok cuando hayas llevado al desertor de la Alianza a su destino con éxito.‡Emmenez le Déserteur de l\'Alliance à la croisée des chemins à l\'est du Bastion Chanteguerre puis utilisez le Lance-fusée chanteguerre pour envoyer un signal à l\'Alliance.|n|nAllez rendre compte à l\'Éclaireur Tungok une fois que le Déserteur de l\'Alliance sera bien arrivé.‡将联盟逃兵押送到战歌要塞东边的十字路口，鸣响战歌信号枪通知联盟。|n|n顺利完成押送任务后向斥候图古克报到。‡護送聯盟叛逃者到戰歌堡東邊的十字路口，然後發射你的戰歌信號槍通知聯盟。|n|n等你將聯盟叛逃者送到目的地之後，向斥候敦苟克回報。',
  }
},
[11712] = {
  {
    'Retransformar‡Перепроклятие‡Verflucht nochmal!‡저주를 푸는 저주‡Remaldeciente‡Remaldeciente‡Le re-maudisseur‡物质转换注射器‡再詛咒',
    nil,
    'Jinqui Porcassolta na Pista de Pouso do Biela pediu para que você use a Injeção de Maldição da Transformação em 6 Gnomecânicos do Biela.‡Используйте перепроклинальную передачниковую инъекцию на 6 механогномах со станции Выкрутеня по просьбе Джинки Гайковорот со взлетной полосы Выкрутеня.‡Jinky Flügelirre bei der Landebahn Kurbelzisch möchte, dass Ihr die fluchrekursive Transmaterieinjektion auf 6 der Mechagnome von Kurbelzisch anwendet.‡피즈크랭크 비행장에 있는 징키 윙넛이 저주유발 순간전송 주사기를 피즈크랭크 기계노움 6마리에 사용해 달라고 했습니다.‡Jinky Alatuerca en la Pista de Aterrizaje de Palanqueta te ha pedido que uses la inyección de transmateria remaldeciente en 6 mecagnomos de Palanqueta.‡Jinky Alatuerca en la Pista de Aterrizaje de Palanqueta te ha pedido que uses la inyección de transmateria remaldeciente en 6 mecagnomos de Palanqueta.‡Voltij Lazimuté, à la Piste d\'atterrissage de Spumelevier, vous a demandé d\'utiliser l\'Injecteur transmatière re-maudisseur sur 6 Mécagnomes de Spumelevier.‡菲兹兰克机场的金吉·温纳特要你对6名菲兹兰克机械侏儒使用物质转换注射器。‡嘶軸簡易機場的金基·翼果要你對6個嘶軸機械地精使用再詛咒物質轉變注射劑。',
  }
},
[11713] = {
  {
    'Patrulhando as fossas‡Исследование воронок‡Aufspüren der Schlundlöcher‡구덩이 정찰‡Marcando los sumideros‡Marcando los sumideros‡Reconnaissance des puisards‡侦查虫孔‡偵察坑道口',
    nil,
    'Abner Torqueimado, na Pista de Pouso do Biela, quer que você use o Mapa dos Campos de Gêiser para marcar os locais da Fossa Sul, da Fossa Nordeste e da Fossa Noroeste.‡Отметьте на карте Поля Гейзеров расположение Южной воронки, Северо-западной воронки и Северо-восточной воронки по просьбе Абнера Шипокрута со взлетной полосы Выкрутеня.‡Abner Zischeldrill auf der Landebahn Kurbelzisch möchte, dass Ihr die Karte der Geysirfelder nehmt und die Positionen des südlichen, des nordwestlichen und des nordöstlichen Schlundlochs eintragt.‡피즈크랭크 비행장의 아브너 피즐톨크가 간헐천 지대 지도를 사용해 남쪽 구덩이, 북서쪽 구덩이, 북동쪽 구덩이의 위치를 기록해 달라고 했습니다.‡Abner Dinamométrica en la Pista de Aterrizaje de Palanqueta quiere que uses el mapa de Los Campos de Géiseres para marcar la ubicación del sumidero sur, el sumidero noroeste y el sumidero noreste.‡Abner Dinamométrica en la Pista de Aterrizaje de Palanqueta quiere que uses el mapa de Los Campos de Géiseres para marcar la ubicación del sumidero sur, el sumidero noroeste y el sumidero noreste.‡Abner Patranivelle, à la Piste d’atterrissage de Spumelevier, vous demande d\'utiliser la Carte des champs de Geysers afin d\'y marquer l\'emplacement du Puisard sud, du Puisard nord-ouest et du Puisard nord-est.‡菲兹兰克机场的阿布尼·扭矩要求你使用喷泉平原地图标记出南部虫孔、西北部虫孔和东北部虫孔的位置。‡嘶軸簡易機場的艾伯奈·嘶鍊要你使用水泉原野地圖去紀錄南部坑道口，西北部坑道口，以及東北部坑道口的位置。',
  }
},
[11714] = {
  {
    'Exterminação perniciosa‡Дератизация‡Ungeziefer vertilgen‡쥐 완전 소탕‡Exterminación de alimañas‡Exterminación de alimañas‡Extermination de la vermine‡清除北地狗头人‡殲滅害蟲',
    nil,
    'O Batedor Tungok, nas Planícies Sanguesporo da Tundra Boreana, quer que você mate 8 Ceifadores Sanguesporo, 5 Incendiários Sanguesporo e 2 Assadores Sanguesporo.‡По просьбе разведчика Тунгока на равнинах Кровавых Спор в Борейской тундре убейте 8 жнецов, 5 поджигателей и 2 обжарщика из стаи Кровавых Спор.‡Späher Tungok in der Blutsporenprärie in der Boreanischen Tundra möchte, dass Ihr 8 Blutsporenernter, 5 Blutsporenfeuerteufel und 2 Blutsporenröster tötet.‡북풍의 땅의 핏빛포자 평원에 있는 정찰병 툰고크가 핏빛포자 정원사 8마리, 핏빛포자 화염술사 5마리, 그리고 핏빛포자 요리사 2마리를 제거해 달라고 했습니다.‡El explorador Tungok en las Llanuras Sanguiespora en la Tundra Boreal quiere que mates a 8 cosechadores Sanguiespora, a 5 ignitores Sanguiespora y a 2 asadores Sanguiespora.‡El explorador Tungok en las Llanuras Sanguiespora en la Tundra Boreal quiere que mates a 8 cosechadores Sanguiespora, a 5 ignitores Sanguiespora y a 2 asadores Sanguiespora.‡L\'éclaireur Tungok, aux Plaines de Spore-sang dans la Toundra Boréenne, vous a demandé de tuer 8 Moissonneurs spore-sang, 5 Boute-flammes spore-sang et 2 Rôtisseurs spore-sang.‡血孢平原的斥候图古克要你杀死8个血孢收割者、5个血孢点火者和2个血孢烘烤者。‡北風凍原，血孢平原的斥候敦苟克要你去殺死8個血孢收割者，5個血孢起火者和2個血孢炙烤者。',
  }
},
[11715] = {
  {
    'Abastecimento do projeto‡В поисках топлива‡Öl für das Projekt‡연료 공급 작전‡¡Dale más gasolina!‡¡Dale más gasolina!‡Faire carburer le projet‡石油资源‡供給工程的燃料',
    nil,
    'Abner Torqueimado na Pista de Pouso do Biela quer que você consiga 8 Barris de Óleo usando a Coletora Portátil de Petróleo.‡Соберите 8 баррелей нефти в портативный нефтесборник по просьбе Абнера Шипокрута со взлетной полосы Выкрутеня.‡Abner Zischeldrill auf der Landebahn Kurbelzisch möchte, dass Ihr mit dem tragbaren Ölsammler 8 Fässer Öl sammelt.‡피즈크랭크 비행장의 아브너 피즐톨크가 휴대용 기름 채집기를 사용해 기름 8통을 모아달라고 했습니다.‡Abner Dinamométrica en la Pista de Aterrizaje de Palanqueta quiere que recojas 8 barriles de aceite gracias al recolector de aceite portátil.‡Abner Dinamométrica en la Pista de Aterrizaje de Palanqueta quiere que recojas 8 barriles de aceite gracias al recolector de aceite portátil.‡Abner Patranivelle, à la Piste d’atterrissage de Spumelevier, vous demande de récupérer 8 tonneaux de Naphte à l\'aide du Collecteur de naphte portable.‡菲兹兰克机场的阿布尼·扭矩要求你利用移动采油器收集8桶油。‡嘶軸簡易機場的艾伯奈·嘶鍊要你使用可攜式原油收集器收集8個油桶。',
  }
},
[11716] = {
  {
    'O magnífico sanguesporo‡Удивительный кровоспор‡Die wundersamen Blutsporen‡신비로운 핏빛포자‡Las maravillosas sanguiesporas‡Las maravillosas sanguiesporas‡Spore-sang merveilleuse !‡奇妙的血孢‡不可思議的血孢',
    nil,
    'A Maga Sangrenta Laurith, nas Planícies Sanguesporo da Tundra Boreana, quer que você consiga 10 Carpelos de Sanguesporo.‡Добудьте 10 кровоспоровых плодолистиков по просьбе волшебницы крови Лаурит с равнин Кровавых Спор в Борейской тундре.‡Blutmagierin Laurith in der Blutsporenprärie in der Boreanischen Tundra möchte, dass Ihr 10 Blutsporenkarpelle beschafft.‡북풍의 땅, 핏빛포자 평원에 있는 혈법사 라우리스가 핏빛포자 암술잎 10개를 모아달라고 했습니다.‡La maga sangrienta Laurith en las Llanuras Sanguiespora de la Tundra Boreal quiere que recuperes 10 carpelos de sanguiespora.‡La maga sangrienta Laurith en las Llanuras Sanguiespora de la Tundra Boreal quiere que recuperes 10 carpelos de sanguiespora.‡La Mage de sang Laurith, des Plaines de Spore-sang dans la Toundra Boréenne, vous a demandé de récupérer 10 Carpelles spore-sang.‡血孢平原的血法师劳莉丝要你收集10片血孢心皮。‡北風凍原，血孢平原的血法師羅瑞斯要你去取回10個血孢心皮。',
  }
},
[11717] = {
  {
    'Pólen da fonte‡Быстродействующая пыльца‡Pollen von den Motten besorgen‡나방 꽃가루 수집‡La fuente del polen‡La fuente del polen‡Le pollen à sa source‡授粉的巨蛾‡花粉來源',
    nil,
    'A Maga Sangrenta Laurith, nas Planícies Sanguesporo da Tundra Boreana, quer que você consiga 5 amostras de Pólen de Mariposa Sanguesporo.‡Принесите волшебнице крови Лаурит на равнины Кровавых Спор 5 щепоток пыльцы кровоспоровых мотыльков.‡Blutmagierin Laurith in der Blutsporenprärie in der Boreanischen Tundra möchte, dass Ihr 5 Pollen von Blutsporenmotten besorgt.‡북풍의 땅, 핏빛포자 평원에 있는 혈법사 라우리스가 핏빛포자 나방 꽃가루 5개를 모아달라고 했습니다.‡La maga sangrienta Laurith, en las Llanuras Sanguiespora de la Tundra Boreal, quiere que recuperes 5 muestras de polen de polilla Sanguiespora.|n‡La maga sangrienta Laurith, en las Llanuras Sanguiespora de la Tundra Boreal, quiere que recuperes 5 muestras de polen de polilla Sanguiespora.|n‡La Mage de sang Laurith, des Plaines de Spore-sang dans la Toundra Boréenne, vous a demandé de récupérer 5 échantillons de Pollen de phalène spore-sang.‡血孢平原的血法师劳莉丝要你收集5份血孢巨蛾花粉。‡北風凍原，血孢平原的血法師羅瑞斯要你去取回5個血孢蛾花粉。',
  }
},
[11718] = {
  {
    'Robô na pele de um mamute‡Автомат в мамонтовой шкуре‡Ein Bot im Mammutpelz‡매머드의 탈을 쓴 로봇‡Un robot bajo pieles de mamut‡Un robot bajo pieles de mamut‡L\'habit fera le mammouth‡猛犸的毛皮‡長毛象外皮機器人',
    nil,
    'Abner Torqueimado, na Pista de Pouso do Biela, quer que você traga 6 Pelegos Grossos de Mamute.‡Принесите Абнеру Шипокруту на взлетную полосу Выкрутеня 6 толстых шкур мамонта.‡Abner Zischeldrill auf Landebahn Kurbelzisch möchte, dass Ihr ihm 6 dicke Mammutbälge bringt.‡피즈크랭크 비행장의 아브너 피즐톨크가 두꺼운 매머드 가죽 6장을 가져다 달라고 했습니다.‡Abner Dinamométrica en la Pista de Aterrizaje de Palanqueta quiere que le lleves 6 pellejos de mamut gruesos.‡Abner Dinamométrica en la Pista de Aterrizaje de Palanqueta quiere que le lleves 6 pellejos de mamut gruesos.‡Abner Patranivelle, à la Piste d’atterrissage de Spumelevier, veut que vous lui rapportiez 6 Peaux de mammouth épaisses.‡菲兹兰克机场的阿布尼·扭矩要求你为他带回6张厚猛犸皮。‡嘶軸簡易機場的艾伯奈·嘶鍊要你帶給他6張厚長毛象皮。',
  }
},
[11719] = {
  {
    'Uma cobaia adequada‡Подопытное животное‡Ein geeignetes Versuchsobjekt‡적절한 실험 대상‡Un sujeto de prueba adecuado‡Un sujeto de prueba adecuado‡Un cobaye adéquat‡完美的测试对象‡一個適合測試的對象',
    nil,
    'A Maga Sangrenta Laurith, nas Planícies Sanguesporo da Tundra Boreana, pediu-lhe para usar a Flor de Sanguesporo Polinizada e deixá-la observar os resultados.‡По просьбе волшебницы крови Лаурит, находящейся на Равнинах Кровавых Спор в Борейской тундре, используйте опыленный цветок кровоспора и позвольте ей изучить полученные результаты.‡Blutmagierin Laurith auf der Blutsporenprärie in der Boreanischen Tundra möchte, dass Ihr die bestäubte Blutsporenblume verwendet und sie dabei zusehen lasst, was passieren wird.‡북풍의 땅, 핏빛포자 평원에 있는 혈법사 라우리스가 가루받이를 한 핏빛포자 꽃을 사용하고 그 결과를 관찰하게 해 달라고 했습니다.‡La maga sangrienta Laurith, en las Llanuras Sanguiespora de la Tundra Boreal, te ha pedido que uses la flor sanguiespora polinizada y le permitas ver los resultados.‡La maga sangrienta Laurith, en las Llanuras Sanguiespora de la Tundra Boreal, te ha pedido que uses la flor sanguiespora polinizada y le permitas ver los resultados.‡La Mage de sang Laurith, des Plaines de Spore-sang dans la Toundra Boréenne, vous a demandé d’utiliser la Fleur de spore-sang pollinisée et de la laisser examiner le résultat.‡血孢平原的血法师劳莉丝要你使用授过粉的血孢花，并让她观察效果。‡北風凍原，血孢平原的血法師羅瑞斯要你使用受粉的血孢花並讓她觀察結果。',
  }
},
[11720] = {
  {
    'A invasão de Gamute‡Вторжение в Гаммот‡Die Invasion von Gammut‡감모스 습격‡La invasión de Gammoth‡La invasión de Gammoth‡L\'invasion de Gammoth‡攻打迦莫斯‡侵略甘默斯',
    nil,
    'Fale com o Primevo Chifre Poderoso nas Planícies Sanguesporo da Tundra Boreana.‡Поговорите со старейшиной Крутым Рогом на равнинах Кровавых Спор в Борейской тундре.‡Sprecht mit Ur Machthorn in der Blutsporenprärie in der Boreanischen Tundra.‡북풍의 땅, 핏빛포자 평원에 있는 주술사 마이트혼과 대화해야 합니다.‡Habla con Primigenio Cuerno Poderoso en las Llanuras Sanguiespora en la Tundra Boreal.|n‡Habla con Primigenio Cuerno Poderoso en las Llanuras Sanguiespora en la Tundra Boreal.|n‡Parlez à l\'Aîné Corne-de-pouvoir dans les Plaines de Spore-sang, dans la Toundra Boréenne‡前往北风苔原的血孢平原，与普雷玛·巨角谈一谈。‡與北風凍原，血孢平原的力角始祖談談。',
  }
},
[11721] = {
  {
    'Gamutra, o Atormentador‡Гаммотра Мучитель‡Gammutra der Peiniger‡심문관 감모스라‡Gammothra el Torturador‡Gammothra el Torturador‡Gammothra le Tourmenteur‡折磨者迦莫斯拉‡『折磨者』甘默斯拉',
    nil,
    'Mate Gamutra e traga a Cabeça de Gamutra para o Primevo Chifre Poderoso nas Planícies Sanguesporo da Tundra Boreana.‡Убейте Гаммотру и вернитесь с головой Гаммотры к старейшине Крутому Рогу на равнинах Кровавых Спор в Борейской тундре.‡Erschlagt Gammutra und bringt den Kopf von Gammutra zu Ur Machthorn in der Blutsporenprärie in der Boreanischen Tundra.‡감모스라를 처치한 다음, 북풍의 땅에 있는 핏빛포자 평원으로 가서 주술사 마이트혼에게 감모스라의 머리카락을 가져가야 합니다.‡Mata a Gammothra y devuelve la cabeza de Gammothra a Primigenio Cuerno Poderoso en las Llanuras Sanguiespora en la Tundra Boreal.‡Mata a Gammothra y devuelve la cabeza de Gammothra a Primigenio Cuerno Poderoso en las Llanuras Sanguiespora en la Tundra Boreal.‡Tuez Gammothra et rapportez la Tête de Gammothra à l\'Aîné Corne-de-pouvoir dans les Plaines de Spore-sang, dans la Toundra Boréenne.‡杀死迦莫斯拉，将他的像章交给北风苔原血孢平原的普雷玛·巨角。‡殺了甘默斯拉，將甘默斯拉的頭顱帶回北風凍原的血孢平原交給力角始祖。',
  }
},
[11722] = {
  {
    'Troféus de Gamute‡Трофеи из Гаммота‡Trophäen von Gammut‡감모스에서 얻은 전리품‡Trofeos de Gammoth‡Trofeos de Gammoth‡Les trophées de Gammoth‡迦莫斯的战利品‡甘默斯戰利品',
    nil,
    'Leve a Cabeça de Gamutra para Garrosh Grito Infernal na Fortaleza Brado Guerreiro.‡Отнесите голову Гаммотры Гаррошу Адскому Крику в крепость Песни Войны.‡Bringt den Kopf von Gammutra zu Garrosh Höllschrei in der Kriegshymnenfeste.‡감모스라의 머리카락을 전쟁노래 요새에 있는 가로쉬 헬스크림에게 가져가야 합니다.‡Llévale la cabeza de Gammothra a Garrosh Grito Infernal al Bastión Grito de Guerra.‡Llévale la cabeza de Gammothra a Garrosh Grito Infernal al Bastión Grito de Guerra.‡Apportez la Tête de Gammothra à Garrosh Hurlenfer au Bastion Chanteguerre.‡将迦莫斯拉的徽记交给战歌要塞的加尔鲁什·地狱咆哮。‡將甘默斯拉的頭顱交給戰歌堡的卡爾洛斯·地獄吼。',
  }
},
[11723] = {
  {
    'Acione a Treme-treme!‡Запустить Страх-и-ужас‡Setzt den Schüttlo-Rüttlo ein!‡흔들흔들 5000!‡¡Utiliza el Vibro-Motor 5000!‡¡Utiliza el Vibro-Motor 5000!‡Déployez le Sismo-trembleur !‡天摇地动！‡部署搖震器',
    nil,
    'Abner Torqueimado, na Pista de Pouso do Biela, quer que você use a Treme-treme 5000 para desmoronar os túneis nerubianos e derrotar o Lorde Kryxix.‡Используйте Страх-и-ужас 5000, чтобы обрушить нерубские туннели и уничтожить лорда Криксикса по просьбе Абнера Шипокрута со взлетной полосы Выкрутеня.‡Abner Zischeldrill auf der Landebahn Kurbelzisch möchte, dass Ihr mithilfe des Schüttlo-Rüttlo 5000 die Tunnel der Neruber zum Einsturz bringt und Fürst Kryxix besiegt.‡피즈크랭크 비행장에 있는 아브너 피즐톨크가 흔들흔들 5000을 사용해 네루비안 굴을 무너트리고 군주 크릭식스를 제거해 달라고 했습니다.‡Abner Dinamométrica de la Pista de Aterrizaje de Palanqueta quiere que uses el Vibro-Motor 5000 para derrumbar los túneles nerubianos y que venzas a Lord Kryxix.‡Abner Dinamométrica de la Pista de Aterrizaje de Palanqueta quiere que uses el Vibro-Motor 5000 para derrumbar los túneles nerubianos y que venzas a Lord Kryxix.‡Abner Patranivelle, à la Piste d’atterrissage de Spumelevier, vous demande d\'utiliser le Sismo-trembleur 5000 pour faire s\'effondrer les tunnels nérubiens et de vaincre le Seigneur Kryxix.‡菲兹兰克机场的阿布尼·扭矩要求你使用地震器5000型将蛛魔的隧道网弄坍塌，并杀死克里卡希斯。‡嘶軸簡易機場的艾伯奈·嘶鍊要你使用搖震器5000型去破壞奈幽蟲族的通道並擊敗克萊克希斯克領主。',
  }
},
[11724] = {
  {
    'Omelete de mariposa tamanho família?‡Для гигантского омлета?‡Mächtiges Mottenomelett?‡거대 나방 오믈렛?‡¿Tortilla gigante de polilla?‡¿Tortilla gigante de polilla?‡Une gigantesque omelette de phalènes ?‡巨大的蛾卵‡巨大蛾蛋捲?',
    nil,
    'Leve o Ovo Reluzente Gigante para a Maga Sangrenta Laurith nas Planícies Sanguesporo da Tundra Boreana.‡Отнесите массивное светящееся яйцо волшебнице крови Лаурит на равнины Кровавых Спор в Борейской тундре.‡Bringt das schwere leuchtende Ei zu Blutmagierin Laurith in der Blutsporenprärie in der Boreanischen Tundra.‡빛나는 대형 알을 북풍의 땅에 있는 핏빛포자 평원으로 가지고 가서 혈법사 라우리스에게 전달해야 합니다.‡Llévale el huevo gigante resplandeciente a la maga sangrienta Laurith que está en las Llanuras Sanguiespora en la Tundra Boreal.‡Llévale el huevo gigante resplandeciente a la maga sangrienta Laurith que está en las Llanuras Sanguiespora en la Tundra Boreal.‡Apportez l’Œuf massif luminescent à la Mage de sang Laurith dans les Plaines de Spore-sang, dans la Toundra Boréenne.‡将发光的巨蛋交给血孢平原的血法师劳莉丝。‡帶著這顆發光的巨蛋到北風凍原的血孢平原交給血法師羅瑞斯。',
  }
},
[11725] = {
  {
    'Ache o piloto Fuzuê‡Поиски пилота "Штопора"‡Auf der Suche nach Trudelflug‡조종사 "곡예사" 찾기‡Buscando al piloto Barrena‡Buscando al piloto Barrena‡Trouver le pilote la Vrille‡寻找“尾旋”‡尋找駕駛員尾旋',
    nil,
    'Encontre Renê Fuzuê nos Campos de Gêiser.‡Отыщите Игги "Штопора" Шестероверта на Поле Гейзеров‡Macht Iggy "Trudelflug" Zinkenwechsel auf den Geysirfeldern ausfindig.‡간헐천 지대에서 "곡예사" 이기 코그토글을 찾아야 합니다.‡Encuentra a Iggy "Barrena" Conmutador en Los Campos de Géiseres.‡Encuentra a Iggy "Barrena" Conmutador en Los Campos de Géiseres.‡Trouvez Iggy « la Vrille » Virouage dans les Champs de Geysers.‡在喷泉平原内找到“尾旋”伊吉·齿钉。‡在水泉原野上尋找『尾旋』艾基·榫栓。',
  }
},
[11726] = {
  {
    'Um pouquinho de tempero‡Добавить специй по вкусу...‡Ein klein wenig Würze‡톡 쏘는 양념‡Un poquito de picante‡Un poquito de picante‡Un peu de piquant‡一点辣椒‡有點辣',
    nil,
    'Nos Lagos Escaldantes, Renê Fuzuê quer que você consiga 4 Bolsas de Temperos de Gorloc.‡По просьбе Игги "Штопора" Шестероверта, что стоит возле Жгучих прудов, соберите 4 мешочка с горлокскими специями.‡Iggy "Trudelflug" Zinkenwechsel bei den Siedenden Teichen möchte, dass Ihr 4 Gewürzbeutel der Gorloc sammelt.‡끓어오르는 웅덩이에 있는 "곡예사" 이기 코그토글이 골록 양념 주머니 4개를 모아달라고 했습니다.‡Iggy "Barrena" Conmutador, de Las Pozas Escaldantes, quiere que consigas 4 bolsas de especias de górloc.‡Iggy "Barrena" Conmutador, de Las Pozas Escaldantes, quiere que consigas 4 bolsas de especias de górloc.‡Iggy « la Vrille » Virouage, dans les Bassins Brûlants, vous demande de ramasser 4 Bourses d\'épices gorlocs.‡滚烫熔池的“尾旋”伊吉·齿钉要你去收集4个鳄鱼人的辣椒袋。‡沸水之池的『尾旋』艾基·榫栓要你收集4個戈洛克香料包。',
  }
},
[11727] = {
  {
    'Tempos de heróis‡Время героев‡Eine Zeit für Helden‡영웅의 시간‡La hora de los héroes‡La hora de los héroes‡L\'époque est aux héros‡英雄的时代‡英雄上場',
    nil,
    'Apresente-se ao Sargento Martelmonte, na Bastilha Valentia.‡Доложитесь сержанту Молотогору в Крепости Отваги.‡Meldet Euch bei Unteroffizier Hammerberg in der Valianzfeste.‡용맹의 성채에 있는 하사관 해머힐에게 보고해야 합니다.‡Preséntate ante el Sargento Colinamartillo en la Fortaleza Denuedo.‡Preséntate ante el Sargento Colinamartillo en la Fortaleza Denuedo.‡Présentez-vous au Sergent Martèlemont au Donjon de la Bravoure.‡去向无畏要塞的哈默希尔中士报到。‡回報給驍勇要塞的錘丘中士。',
  }
},
[11728] = {
  {
    'Cocodolobo‡Собаки-каки‡Lupus pupus‡늑대 응가‡Lupus Pupus‡Lupus Pupus‡Lupus Pupus‡狼的排泄物‡狼便便',
    nil,
    'Renê Fuzuê nos Lagos Escaldantes quer que você lhe traga 8 pedaços do Microfilme.‡Принесите 8 кусков микропленки Игги "Штопору" Шестероверту у Жгучих прудов.‡Iggy "Trudelflug" Zinkenwechsel bei den Siedenden Teichen möchte, dass Ihr ihm 8 Mikrofilmteile bringt.‡끓어오르는 웅덩이에 있는 "곡예사" 이기 코그토글이 마이크로필름 8개를 가져다 달라고 했습니다.‡Iggy "Barrena" Conmutador de Las Pozas Escaldantes quiere le lleves 8 trozos de microfilm.‡Iggy "Barrena" Conmutador de Las Pozas Escaldantes quiere le lleves 8 trozos de microfilm.‡Iggy « la Vrille » Virouage, dans les Bassins Brûlants, vous demande de lui apporter 8 morceaux de Microfilm.‡滚烫熔池的“尾旋”伊吉·齿钉要你带回8张微缩胶片。‡沸水之池的『尾旋』艾基·榫栓要你收集8個微縮膠捲。',
  }
},
[11729] = {
  {
    'A chave de fenda ultrassônica‡Ультразвуковая отвертка‡Der Ultraüberschallschrauber‡초음파 나사돌리개‡El destornillador ultrasónico‡El destornillador ultrasónico‡Le Tournevis Ultrasonique‡超声波螺丝刀‡超音波式螺絲起子',
    nil,
    'Entregue a Chave de Fenda Ultrassônica para Abília Rodafrouxa, na Pista de Pouso do Biela.‡Принесите ультразвуковую отвертку Умейке Шестеркрут на взлетную полосу Выкрутеня.‡Liefert den Ultraüberschallschrauber bei Pfiffi Wackelspross ab. Sie befindet sich auf der Landebahn Kurbelzisch.‡초음파 나사돌리개를 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 전달해야 합니다.‡Entrégale el destornillador ultrasónico a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Entrégale el destornillador ultrasónico a Ingeniosa Piñonflojo en la Pista de Aterrizaje de Palanqueta.‡Apportez le Tournevis Ultrasonique à Fufute Tremblerouage à la Piste d\'atterrissage de Spumelevier.‡将超声波螺丝刀带回菲兹兰克机场，交给机灵鬼沃比斯波基。‡將超音波螺絲起子交給嘶軸簡易機場的卡芙緹·顛鏈。',
  }
},
[11730] = {
  {
    'Patrão e empregado‡Хозяин и слуга‡Meister und Diener‡주인과 하인‡Maestro y servidor‡Maestro y servidor‡Maître et serviteur‡主与仆‡主人與僕從',
    nil,
    'Use a Chave de Fenda Ultrassônica para reprogramar 15 robôs e então fale novamente com Abília Rodafrouxa na Pista de Pouso do Biela.|n|nNão esqueça de saquear os robôs mortos antes de reprogramá-los.‡Используйте ультразвуковую отвертку, чтобы перепрограммировать 15 роботов, затем вернитесь к Умейке Шестеркрут на взлетной полосе Выкрутеня.|n|nНе забудьте обыскать убитых роботов прежде, чем перепрограммировать их.‡Programmiert mithilfe des Ultraüberschallschrauber 15 Roboter um und kehrt anschließend wieder zu Pfiffi Wackelspross bei der Landebahn Kurbelzisch zurück.|n|nAchtet darauf, die kaputten Roboter zu plündern, bevor Ihr sie umprogrammiert.‡초음파 나사돌리개를 사용해 로봇 15대를 개조한 다음 피즈크랭크 비행장에 있는 크래프티 워블스프로킷에게 가야 합니다.|n|n로봇을 개조하기 전에 전리품을 획득해야 합니다.‡Usa el destornillador ultrasónico para reprogramar 15 robots y después vuelve a ver a Ingeniosa Piñonflojo a la Pista de Aterrizaje de Palanqueta.|n|nAsegúrate de despojar al robot muerto antes de reprogramarlo.‡Usa el destornillador ultrasónico para reprogramar 15 robots y después vuelve a ver a Ingeniosa Piñonflojo a la Pista de Aterrizaje de Palanqueta.|n|nAsegúrate de despojar al robot muerto antes de reprogramarlo.‡Utilisez le Tournevis ultrasonique pour reprogrammer 15 robots, puis retournez voir Fufute Tremblerouage à la Piste d\'atterrissage de Spumelevier.|n|nN\'oubliez pas de prendre votre butin sur le robot avant de le reprogrammer.‡使用超声波螺丝刀为15个机器人重新编程，然后将超声波螺丝刀带回菲兹兰克机场，还给机灵鬼沃比斯波基。|n|n在改编程序之前，记得从机器人的尸体上顺手捞点什么。‡使用超音波式螺絲起子重新設定15個機器人，接著回去嘶軸簡易機場找卡芙緹·顛鏈。|n|n記得要先拾取再進行重設。',
  }
},
[11731] = {
  {
    'Arremesso de tochas‡Жонглирование факелами‡Fackelwurf‡횃불을 던져라!‡Lanzamiento de antorchas‡Lanzamiento de antorchas‡Lancer des torches‡扔火炬‡投擲火炬',
    nil,
    'Vença o jogo de arremessar tochas. Depois, fale com o Mestre Engolidor de Fogo.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 던지기 시험을 통과하고 불꽃마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragafuegos.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragafuegos.‡Gagnez le jeu de lancer de torches, puis parlez au Maître mangeur de feu.‡赢得一场扔火炬游戏，然后与吞火大师谈一谈。‡在火炬投擲遊戲中獲勝，然後與吞火者大師談話。',
  }
},
[11732] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡¡Profana este fuego!‡Désacralisez ce feu !‡亵渎这团火焰！‡褻瀆這些火焰!',
    nil,
    nil,
  }
},
[11733] = {
  {
    'Travessia da fissura‡Переход через расселину‡Reise zum Riss‡균열 탐험‡Atravesando la falla‡Atravesando la falla‡Traverser la faille‡飞越裂谷‡橫越裂隙',
    nil,
    'Surristrasz quer que você viaje para Gelarra. Uma vez lá, fale com o Arquimago Berinand.‡Отправляйтесь в Хладарру по распоряжению Сурристраза. Оказавшись там, поговорите с верховным магом Беринардом.‡Surristrasz möchte, dass Ihr die Reise nach Kaltarra antretet. Sobald Ihr dort angelangt seid, sollt Ihr mit Erzmagier Berinand sprechen.‡술리스트라즈가 콜다라로 날아가 대마법사 베리난드와 대화해 달라고 했습니다.‡Surristrasz quiere que viajes hasta Gelidar. Cuando estés allí, habla con el archimago Berinand.‡Surristrasz quiere que viajes hasta Gelidar. Cuando estés allí, habla con el archimago Berinand.‡Surristrasz vous demande de partir pour Frimarra. Une fois là-bas, parlez à l\'Archimage Bérinand.‡苏雷斯塔兹要你前往考达拉，与大法师伯林纳德谈一谈。‡瑟利斯塔茲要你前往凜懼島。到達後，立刻找大法師貝瑞那德談談。',
  }
},
