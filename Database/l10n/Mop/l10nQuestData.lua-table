  }
},
[31354] = {
  {
    'Tesouro de Mazu‡Дар Мацзу‡Mazus Freigiebigkeit‡마쭈의 보상‡La recompensa de Mazu‡‡Le trésor de Mazu‡玛祖的奖赏‡',
    nil,
    'Fale com o Mestre Pescador Ju Lien em Gambito do Encharco. Uma‡Поговорите с мастером-рыболовом Цзюй Лэнем в Приюте капитана.‡Sprecht mit Meisterangler Ju Lien in Tropfs Wagnis.‡흠뻑이의 요행수에 있는 달인 강태공 주 리엔과 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con el maestro pescador Ju Lien en el Lance de Aguado.‡‡Parlez au Maître pêcheur Ju Lien au Pari de Trempette.‡去闷水壶的冒险码头和钓鱼大师句连谈一谈。‡',
  }
},
[31355] = {
  {
    'Restaurando a pureza do jade‡Восстановление чистоты нефрита‡Wiederherstellung der Reinheit‡비취의 순수함을 지켜라‡Recuperando la pureza del jade‡‡La pureté du jade‡回复玉之纯净‡',
    nil,
    'Ajude o Sábio Mari, Liu Coração Flamejante e o Andarilho das Lendas Pisapedra com os problemas com o sha. Uma‡Помогите Мудрому Марису, Лю Пламенное Сердце и хранителю истории Каменная поступь справиться с ша.‡Helft dem weisen Mari, Liu Flammenherz und Lehrensucher Steinschritt mit ihren Sha-Problemen.‡샤와 싸우는 현명한 마리, 리우 플레임하트, 전승지기 스톤스텝을 도와야 합니다. 레벨 10 옥룡사‡Ayuda a Maro el Sabio, Liu Corazón Llameante y eremita Senda Pétrea con sus problemas con el sha.‡‡Aidez le Sage Mari, Liu Cœur de Flamme et le Chroniqueur Pas de Pierre à s\'occuper des sha.‡帮助贤者马里、刘·焰心和游学者石步解决煞魔的问题。‡',
  }
},
[31356] = {
  {
    'Profundas dúvidas, profunda sabedoria‡Глубина сомнений порождает глубину мысли‡Tiefe Zweifel, tiefe Weisheit‡깊은 의심과 깊은 지혜‡Grandes dudas, gran sabiduría‡‡Profond doute, profonde sagesse‡深虑与睿智‡',
    nil,
    'Mate o Sha da Dúvida. Uma‡Убейте Ша Сомнения.‡Tötet das Sha des Zweifels.‡의심의 샤를 처치해야 합니다. 레벨 10 옥룡사‡Mata al sha de la duda.‡‡Tuez le Sha du doute.‡杀死疑之煞。‡',
  }
},
[31357] = {
  {
    'Relíquias dos quatro reis‡Реликвии Четырех Королей‡Relikte der Vier Könige‡사대왕의 유물‡Reliquias de los Cuatro Reyes‡‡Les reliques des quatre rois‡四王的遗物‡',
    nil,
    'Consiga a Lanterna do Rei Feiticeiro, a Balança do Rei Louco, "A Ciência da Guerra" de Qiang e o Arco dos Velozes de Subetai. Uma‡Найдите светильник короля-чародея, весы безумного короля Мына, свиток "Наука войны" Цяна и стремительный лук Субетая.‡Beschafft die Laterne des Zaubererkönigs, die Waage von König Meng dem Irren, Qiangs "Die Wissenschaft des Krieges" und den Bogen von Subetai dem Schnellen.‡마술사 왕의 등불, 실성한 멩의 저울, 치앙의 "전쟁의 과학", 쑤베타이의 날렵한 활을 찾아야 합니다.‡Consigue el farol del rey hechicero, la balanza del rey loco Meng, "La ciencia de la guerra" de Qiang y el arco del raudo de Subetai. Un(a) misión.‡‡Collectez la Lanterne du roi-sorcier, la Balance de Meng le roi fou, « La Science de la guerre » de Qiang, et l\'Arc du Rapide de Subetaï.‡收集巫王提安的提灯、疯王蒙恩的天平、战王齐昂的《战争之道》和匪王速不台的迅捷之弓。‡',
  }
},
[31359] = {
  {
    'O encantador de kunchonks‡Говорящий с куньчунами‡Der Kunchong-Flüsterer‡쿤총이 속삭인다‡El hombre que susurraba a los kunchong‡‡L’aventurier qui murmurait à l’oreille des kunchong‡恐虫密语者‡',
    nil,
    'Mate o Oráculo Hiss\'ir e 10 membros da tribo dos Escamamuco. Uma‡Убейте оракула Хисс\'ира и 10 членов племени Грязной Чешуи.‡Tötet das Orakel Zisch\'et und 10 Angehörige des Stammes der Schlickschuppen.‡점쟁이 히스이르와 진흙비늘 종족 10마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata al oráculo Hiss\'ir y a 10 miembros de la tribu mugrescama.‡‡Tuez l’Oracle Siffl’augure et 10 membres de la tribu Fangécaille.‡杀死神谕者希斯尔和10名泥鳞部落成员。‡',
  }
},
[31360] = {
  {
    'Uma nova lição para o mestre‡Новый урок для мастера‡Eine neue Lektion für den Meister‡달인에게 한 수 가르치기‡Una nueva lección para el maestro‡‡Une petite leçon pour le Maître‡给大师上一课‡',
    nil,
    'Mate Xin, o Mestre de Armas. Uma‡Убейте Синя Мастера Боя.‡Tötet Xin den Waffenmeister.‡무기달인 신을 처치해야 합니다. 레벨 20 모구샨 궁전‡Mata a Xin, el Maestro de armas.‡‡Tuez Xin le Maître d\'armes.‡杀死武器大师席恩。‡',
  }
},
[31362] = {
  {
    'A última peça do quebra-cabeça‡Последний фрагмент головоломки‡Das letzte Puzzleteil‡퍼즐의 마지막 조각‡La última pieza del puzle‡‡La dernière pièce du puzzle‡最后一块拼图‡',
    nil,
    'Use o Legado de Cho no Templo da Família Cho, que fica no Mirante da Serpente.Fale com Mishi para obter transporte. Uma‡Используйте фамильную ценность Чо у фамильного святилища Чо на площадке с видом на Нефритовую Змею Чо.Попросите Миши доставить вас туда.‡Benutzt Chos Erbstück bei Chos Familienschrein beim Schlangenblick.Um dorthin zu kommen, sprecht mit Mishi.‡용의 전망대, 초 가의 제단에서 초 가문의 가보를 사용해야 합니다.미스와 대화하면 이동할 수 있습니다.‡Usa la reliquia de Cho en el santuario de la familia Cho en el Mirador del Dragón.Habla con Mishi para transportarte. Un/una misión de World of Warcraft: Mists of Pandaria.‡‡Utilisez l’Héritage de la famille de Cho à l’Autel des ancêtres de Cho, sur le Surplomb du Serpent.Parlez avec Mishi pour le transport.‡在青龙瞭望台上的周家神龛使用周氏传家宝。和米师谈一谈，她会负责把你送到那里去。‡',
  }
},
[31363] = {
  {
    'Iluminando o caminho‡Освещая путь‡Gebt das Signal‡불을 밝혀라‡Iluminando el camino‡‡Rallumer la flamme‡照亮前路‡',
    nil,
    'Acenda a Chama do Sinalizador. Uma‡Зажгите сигнальный огонь.‡Entfacht die Signalflamme.‡봉화를 켜야 합니다. 레벨 25 석양문‡Enciende la señal de llamas.‡‡Allumez la Flamme de signal.‡点燃长城烽火。‡',
  }
},
[31364] = {
  {
    'Isso sim é um insetão!‡Тараканище!‡Was für ein Brocken!‡정말 큰 벌레네!‡¡Eso sí que es un bicho grande!‡‡Blatte à part‡巨虫来袭！‡',
    nil,
    'Mate Raigonn. Uma‡Убейте Райгонна.‡Tötet Raigonn.‡라이곤을 처치해야 합니다. 레벨 25 석양문‡Mata a Raigonn.‡‡Tuez Raigonn.‡杀死莱公。‡',
  }
},
[31365] = {
  {
    'Em algum lugar lá dentro‡Где-то внутри‡Irgendwo da drinnen‡안쪽 어딘가에‡En algún lugar del interior‡‡Quelque part‡营救俘虏‡',
    nil,
    'Resgate 12 Prisioneiros Shado-Pans. Uma‡Спасите 12 шадопанских пленников.‡Rettet 12 gefangene Shado-Pan.‡음영파 포로 12명을 구해야 합니다. 레벨 25 니우짜오 사원 공성전투‡Rescata a 12 prisioneros del Shadopan.‡‡Sauvez 12 Prisonniers pandashan.‡营救12名影踪派囚徒。‡',
  }
},
[31366] = {
  {
    'Abata o líder aéreo‡Убейте командующего флангом‡Schaltet den Schwadronsführer aus‡편대사령관을 처치하라‡Acabar con el líder de escuadrón‡‡À bas le chef d\'escadre‡消灭翼虫首领‡',
    nil,
    'Mate o Líder Aéreo Ner\'onok. Uma‡Убейте командующего флангом Нер\'онока.‡Tötet Schwadronsführer Ner\'onok.‡편대사령관 네르오노크를 처치해야 합니다. 레벨 25 니우짜오 사원 공성전투‡Mata al líder de escuadrón Ner\'onok.‡‡Tuez le Chef d\'escadre Ner\'onok.‡杀死翼虫首领尼诺洛克。‡',
  }
},
[31367] = {
  {
    'Os andarilhos das lendas‡Хранители истории‡Die Lehrensucher‡전승지기‡Los eremitas‡‡Les Chroniqueurs‡游学者‡',
    nil,
    'Fale com o Andarilho das Lendas Cho no Trono do Conhecimento, no Vale das Flores Eternas. Uma‡Поговорите с хранителем истории Чо из Обители Мудрости в Вечноцветущем доле.‡Sprecht mit Lehrensucher Cho im Heim des Wissens im Tal der Ewigen Blüten.‡영원꽃 골짜기의 지식의 연단에 있는 전승지기 초와 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con el eremita Cho en el Trono del Saber, en el Valle de la Flor Eterna.‡‡Parlez au Chroniqueur Cho au Siège de la Connaissance dans le Val de l’Éternel printemps.‡去锦绣谷的闻道之座和游学者周卓谈一谈。‡',
  }
},
[31368] = {
  {
    'Os andarilhos das lendas‡Хранители истории‡Die Lehrensucher‡전승지기‡Los eremitas‡‡Les Chroniqueurs‡游学者‡',
    nil,
    'Fale com o Andarilho das Lendas Cho no Trono do Conhecimento, no Vale das Flores Eternas. Uma‡Поговорите с хранителем истории Чо из Обители Мудрости в Вечноцветущем доле.‡Sprecht mit Lehrensucher Cho im Heim des Wissens im Tal der Ewigen Blüten.‡영원꽃 골짜기의 지식의 연단에 있는 전승지기 초와 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con el eremita Cho en el Trono del Saber, en el Valle de la Flor Eterna.‡‡Parlez au Chroniqueur Cho au Siège de la Connaissance dans le Val de l’Éternel printemps.‡去锦绣谷的闻道之座和游学者周卓谈一谈。‡',
  }
},
[31369] = {
  {
    'Os Pescadores‡Рыболовы‡Die Angler‡강태공 연합‡Los pescadores‡‡Les Hameçonneurs‡垂钓翁‡',
    nil,
    'Fale com o Pescador Haito no Cais dos Pescadores, que fica na Selva de Krasarang. Uma‡Поговорите с рыбаком Хайто в Деревне рыболовов в Красарангских джунглях. Награда: .‡Sprecht mit dem Angler Haito an der Anlegestelle der Angler in der Krasarangwildnis.‡크라사랑 밀림의 강태공 부두에 있는 낚시꾼 하이토와 대화해야 합니다. 레벨 15 크라사랑 밀림‡Habla con el pescador Haito en el Muelle de los Pescadores, en la Espesura Krasarang.‡‡Parlez au Pêcheur Haito au Quai des Hameçonneurs, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的渔人码头和渔夫海涛谈一谈。‡',
  }
},
[31370] = {
  {
    'Os Pescadores‡Рыболовы‡Die Angler‡강태공 연합‡Los pescadores‡‡Les Hameçonneurs‡垂钓翁‡',
    nil,
    'Fale com o Pescador Haito no Cais dos Pescadores, que fica na Selva de Krasarang. Uma‡Поговорите с рыбаком Хайто в Деревне рыболовов в Красарангских джунглях. Награда: .‡Sprecht mit dem Angler Haito an der Anlegestelle der Angler in der Krasarangwildnis.‡크라사랑 밀림의 강태공 부두에 있는 낚시꾼 하이토와 대화해야 합니다. 레벨 15 크라사랑 밀림‡Habla con el pescador Haito en el Muelle de los Pescadores, en la Espesura Krasarang.‡‡Parlez au Pêcheur Haito au Quai des Hameçonneurs, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的渔人码头和渔夫海涛谈一谈。‡',
  }
},
[31371] = {
  {
    'Tracking Event: Player Has Completed One Anglers Daily‡Tracking Event: Player Has Completed One Anglers Daily‡Trackingereignis: Spieler hat eine tägliche Angelquest abgeschlossen‡이벤트 추적: 플레이어가 강태공 일퀘 한 개 완료‡Evento de seguimiento: El jugador ha completado una misión diaria de pescador‡‡Tracking Event: Player Has Completed One Anglers Daily‡追踪事件：玩家已经每天完成一项钓鱼任务‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31372] = {
  {
    'Os lavradores‡Земледельцы‡Die Ackerbauern‡농사꾼 연합‡Los labradores‡‡Les Laboureurs‡阡陌客‡',
    nil,
    'Fale com o Fazendeiro Yoon na Fazenda Sol Cantante, no Vale dos Quatro Ventos. Uma‡Поговорите с фермером Юном на ферме Солнечной Песни, которая находится в долине Четырех Ветров.‡Sprecht mit Bauer Yoon auf dem Gehöft Sonnensang im Tal der Vier Winde.‡네 바람의 계곡의 태양노래 농장에 있는 농부 윤과 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con el granjero Yoon en el Rancho Cantosol, en el Valle de los Cuatro Vientos.‡‡Parlez au Fermier Yoon à la Ferme Chant du Soleil dans la Vallée des Quatre vents.‡去四风谷的日歌农场和农夫老愚谈一谈。‡',
  }
},
[31373] = {
  {
    'A Ordem da Serpente das Nuvens‡Орден Облачного Змея‡Der Orden der Wolkenschlange‡운룡단‡La Orden del Dragón Nimbo‡‡L’ordre du Serpent-nuage‡云端翔龙骑士团‡',
    nil,
    'Fale com o Instrutor Espinho Celeste no Arboreto, que fica na Floresta de Jade. Uma‡Поговорите с инструктором Небесным Шипом в Дендрарии, расположенном в Нефритовом лесу.‡Sprecht mit Ausbilder Himmelsdorn im Arboretum im Jadewald.‡비취 숲의 도원에 있는 교관 스카이쏜과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el instructor Punta Celeste en El Arboretum, en El Bosque de Jade.‡‡Parlez à l’Instructeur Ronce du Ciel à l’Arboretum, dans la Forêt de Jade.‡去翡翠林的百木园和天荆教头谈一谈。‡',
  }
},
[31374] = {
  {
    'Os lavradores‡Земледельцы‡Die Ackerbauern‡농사꾼 연합‡Los labradores‡‡Les Laboureurs‡阡陌客‡',
    nil,
    'Fale com o Fazendeiro Yoon na Fazenda Sol Cantante, no Vale dos Quatro Ventos. Uma‡Поговорите с фермером Юном на ферме Солнечной Песни, которая находится в долине Четырех Ветров.‡Sprecht mit Bauer Yoon auf dem Gehöft Sonnensang im Tal der Vier Winde.‡네 바람의 계곡의 태양노래 농장에 있는 농부 윤과 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con el granjero Yoon en el Rancho Cantosol, en el Valle de los Cuatro Vientos.‡‡Parlez au Fermier Yoon à la Ferme Chant du Soleil dans la Vallée des Quatre vents.‡去四风谷的日歌农场和农夫老愚谈一谈。‡',
  }
},
[31375] = {
  {
    'A Ordem da Serpente das Nuvens‡Орден Облачного Змея‡Der Orden der Wolkenschlange‡운룡단‡La Orden del Dragón nimbo‡‡L’ordre du Serpent-nuage‡云端翔龙骑士团‡',
    nil,
    'Fale com o Instrutor Espinho Celeste no Arboreto, que fica na Floresta de Jade. Uma‡Поговорите с инструктором Небесным Шипом в Дендрарии, расположенном в Нефритовом лесу.‡Sprecht mit Ausbilder Himmelsdorn im Arboretum im Jadewald.‡비취 숲의 도원에 있는 교관 스카이쏜과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el instructor Punta Celeste en El Arboretum, en El Bosque de Jade.‡‡Parlez à l’Instructeur Ronce du Ciel à l’Arboretum, dans la Forêt de Jade.‡去翡翠林的百木园和天荆教头谈一谈。‡',
  }
},
[31376] = {
  {
    'Ataque no Templo da Serpente de Jade‡Битва у храма Нефритовой Змеи‡Angriff auf den Tempel der Jadeschlange‡옥룡사, 공격을 받다‡Ataque al Templo del Dragón de Jade‡‡Attaque au temple du Serpent de jade‡围攻青龙寺‡',
    nil,
    'Fale com o Mestre Ancião Tai-Feng no Pátio do Templo de Jade, na Floresta de Jade. Uma‡Поговорите с верховным жрецом Тай-Фэном в землях Нефритового храма в Нефритовом лесу.‡Sprecht mit dem Ältestenweisen Tai-Feng auf dem Tempelgelände der Jadeschlange im Jadewald.‡비취 숲의 옥룡사 정원에 있는 원로 현자 타이펑과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el Ancestro sabio Tai-Feng en las Tierras del Templo de Jade, en El Bosque de Jade.‡‡Parlez au Vénérable ancien Tai Feng aux Jardins du Temple de jade dans la Forêt de Jade.‡去翡翠林的青龙寺庭院和大贤者泰峰谈一谈。‡',
  }
},
[31377] = {
  {
    'Ataque no Templo da Serpente de Jade‡Битва у храма Нефритовой Змеи‡Angriff auf den Tempel der Jadeschlange‡옥룡사, 공격을 받다‡Ataque al Templo del Dragón de Jade‡‡Attaque au temple du Serpent de jade‡围攻青龙寺‡',
    nil,
    'Fale com o Mestre Ancião Tai-Feng no Pátio do Templo de Jade, na Floresta de Jade. Uma‡Поговорите с верховным жрецом Тай-Фэном в землях Нефритового храма в Нефритовом лесу.‡Sprecht mit dem Ältestenweisen Tai-Feng auf dem Tempelgelände der Jadeschlange im Jadewald.‡비취 숲의 옥룡사 정원에 있는 원로 현자 타이펑과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el Ancestro sabio Tai-Feng en las Tierras del Templo de Jade, en El Bosque de Jade.‡‡Parlez au Vénérable ancien Tai Feng aux Jardins du Temple de jade dans la Forêt de Jade.‡去翡翠林的青龙寺庭院和大贤者泰峰谈一谈。‡',
  }
},
[31378] = {
  {
    'Desafio no Templo da Garça Vermelha‡Испытание в храме Красного Журавля‡Herausforderung am Tempel des Roten Kranichs‡주학사, 난관에 봉착하다‡Desafío en el Templo de la Grulla Roja‡‡Défi au temple de la Grue rouge‡朱鹤寺的挑战‡',
    nil,
    'Fale com Thelonius no Berço de Chi-Ji, que fica na Selva de Krasarang. Uma‡Поговорите с Телонием в Колыбели Чи-Цзи в Красарангских джунглях.‡Sprecht mit Thelonius an Chi-Jis Wiege in der Krasarangwildnis.‡크라사랑 밀림의 츠지의 요람에 있는 델로니우스와 대화해야 합니다. 레벨 15 크라사랑 밀림‡Habla con Thelonius en la Cuna de Chi-Ji, en la Espesura Krasarang.‡‡Parlez à Thélonius au Berceau de Chi Ji dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的赤精栖木和塞隆尼斯谈一谈。‡',
  }
},
[31379] = {
  {
    'Desafio no Templo da Garça Vermelha‡Испытание в храме Красного Журавля‡Herausforderung am Tempel des Roten Kranichs‡주학사, 난관에 봉착하다‡Desafío en el Templo de la Grulla Roja‡‡Défi au temple de la Grue rouge‡朱鹤寺的挑战‡',
    nil,
    'Fale com Thelonius no Berço de Chi-Ji, que fica na Selva de Krasarang. Uma‡Поговорите с Телонием в Колыбели Чи-Цзи в Красарангских джунглях.‡Sprecht mit Thelonius an Chi-Jis Wiege in der Krasarangwildnis.‡크라사랑 밀림의 츠지의 요람에 있는 델로니우스와 대화해야 합니다. 레벨 15 크라사랑 밀림‡Habla con Thelonius en la Cuna de Chi-Ji, en la Espesura Krasarang.‡‡Parlez à Thélonius au Berceau de Chi Ji dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的赤精栖木和塞隆尼斯谈一谈。‡',
  }
},
[31380] = {
  {
    'Provação no Templo do Tigre Branco‡Испытание в храме Белого Тигра‡Herausforderung am Tempel des Weißen Tigers‡백호사, 대회를 열다‡Prueba en el Templo del Tigre Blanco‡‡Épreuve au temple du Tigre blanc‡白虎寺的试炼‡',
    nil,
    'Fale com Xuen no Templo do Tigre Branco, no Monte Kun-Lai. Uma‡Поговорите с Сюэнем в храме Белого Тигра на вершине Кунь-Лай.‡Sprecht mit Xuen am Tempel des Weißen Tigers am Kun-Lai-Gipfel.‡쿤라이 봉우리의 백호사에 있는 쉬엔과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con Xuen en el Templo del Tigre Blanco, en la Cima Kun-Lai.‡‡Parlez à Xuen au Temple du Tigre blanc au Sommet de Kun-Lai.‡去昆莱山的白虎寺和雪怒谈一谈。‡',
  }
},
[31381] = {
  {
    'Provação no Templo do Tigre Branco‡Испытание в храме Белого Тигра‡Herausforderung am Tempel des Weißen Tigers‡백호사, 대회를 열다‡Prueba en el Templo del Tigre Blanco‡‡Épreuve au temple du Tigre blanc‡白虎寺的试炼‡',
    nil,
    'Fale com Xuen no Templo do Tigre Branco, no Monte Kun-Lai. Uma‡Поговорите с Сюэнем в храме Белого Тигра на вершине Кунь-Лай.‡Sprecht mit Xuen am Tempel des Weißen Tigers am Kun-Lai-Gipfel.‡쿤라이 봉우리의 백호사에 있는 쉬엔과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con Xuen en el Templo del Tigre Blanco, en la Cima Kun-Lai.‡‡Parlez à Xuen au Temple du Tigre blanc au Sommet de Kun-Lai.‡去昆莱山的白虎寺和雪怒谈一谈。‡',
  }
},
[31382] = {
  {
    'Defesa no Templo Niuzao‡Оборона храма Нюцзао‡Die Verteidigung des Niuzaotempels‡니우짜오 사원, 위기에 처하다‡Defensa del Templo de Niuzao‡‡La défense du temple de Niuzao‡砮皂寺的防御‡',
    nil,
    'Fale com Ogo, o Ancião, no Templo Niuzao, nas Estepes de Taolong. Uma‡Поговорите со старейшиной Ого в храме Нюцзао в Танлунских степях.‡Sprecht mit Ogo dem Ältesten im Niuzaotempel in der Tonlongsteppe.‡탕랑 평원의 니우짜오 사원에 있는 아버지 오고와 대화해야 합니다. 레벨 25 탕랑 평원‡Habla con Ogo el Viejo en el Templo de Niuzao, en las Estepas de Tong Long.‡‡Parlez à Ogo l’Ancien au Temple de Niuzao dans les Steppes de Tanglong.‡去螳螂高原的砮皂寺和老傲古谈一谈。‡',
  }
},
[31383] = {
  {
    'Defesa no Templo Niuzao‡Оборона храма Нюцзао‡Die Verteidigung des Niuzaotempels‡니우짜오 사원, 위기에 처하다‡Defensa del Templo de Niuzao‡‡La défense du temple de Niuzao‡砮皂寺的防御‡',
    nil,
    'Fale com Ogo, o Ancião, no Templo Niuzao, nas Estepes de Taolong. Uma‡Поговорите со старейшиной Ого в храме Нюцзао в Танлунских степях.‡Sprecht mit Ogo dem Ältesten im Niuzaotempel in der Tonlongsteppe.‡탕랑 평원의 니우짜오 사원에 있는 아버지 오고와 대화해야 합니다. 레벨 25 탕랑 평원‡Habla con Ogo el Viejo en el Templo de Niuzao, en las Estepas de Tong Long.‡‡Parlez à Ogo l’Ancien au Temple de Niuzao dans les Steppes de Tanglong.‡去螳螂高原的砮皂寺和老傲古谈一谈。‡',
  }
},
[31384] = {
  {
    'O Lótus Dourado‡Золотой Лотос‡Der Goldene Lotus‡황금 연꽃‡El Loto Dorado‡‡Le Lotus doré‡金莲教‡',
    nil,
    'Fale com Anji Luz Outonal na Guarnição do Sol Poente, no Vale das Flores Eternas. Uma‡Поговорите с Аньцзи Осенний Свет в гарнизоне Заходящего Солнца, что в Вечноцветущем доле.‡Sprecht mit Anji Herbstlicht in der Garnison der Untergehenden Sonne im Tal der Ewigen Blüten.‡영원꽃 골짜기의 석양 주둔지에 있는 안지 오톰라이트와 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con Anji Fulgor Otoñal en el Baluarte del Sol Poniente, en el Valle de la Flor Eterna.‡‡Parlez à Anji Clair d’Automne à la Garnison du Soleil couchant, dans le Val de L’Éternel printemps.‡去锦绣谷的残阳关卫戍营和安济·秋光谈一谈。‡',
  }
},
[31385] = {
  {
    'O Lótus Dourado‡Золотой Лотос‡Der Goldene Lotus‡황금 연꽃‡El Loto Dorado‡‡Le Lotus doré‡金莲教‡',
    nil,
    'Fale com Anji Luz Outonal na Guarnição do Sol Poente, no Vale das Flores Eternas. Uma‡Поговорите с Аньцзи Осенний Свет в гарнизоне Заходящего Солнца, что в Вечноцветущем доле.‡Sprecht mit Anji Herbstlicht in der Garnison der Untergehenden Sonne im Tal der Ewigen Blüten.‡영원꽃 골짜기의 석양 주둔지에 있는 안지 오톰라이트와 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con Anji Fulgor Otoñal en el Baluarte del Sol Poniente, en el Valle de la Flor Eterna.‡‡Parlez à Anji Clair d’Automne à la Garnison du Soleil couchant, dans le Val de L’Éternel printemps.‡去锦绣谷的残阳关卫戍营和安济·秋光谈一谈。‡',
  }
},
[31386] = {
  {
    'A ofensiva dos shado-pans‡Армия Шадо-Пан‡Die Shado-Pan-Offensive‡음영파의 공격‡La ofensiva del Shadopan‡‡L’offensive pandashan‡影踪派的攻势‡',
    nil,
    'Fale com Taran Zhu no Entreposto Longying, que fica nas Estepes de Taolong. Uma‡Поговорите с Тажанем Чжу на укреплениях Лун-Ин, которые находятся в Танлунских степях.‡Sprecht mit Taran Zhu am Außenposten Longying in der Tonlongsteppe.‡탕랑 평원의 롱잉 전초기지에 있는 타란 주와 대화해야 합니다. 레벨 25 탕랑 평원‡Habla con Taran Zhu en la Avanzada Longying, en las Estepas de Tong Long.‡‡Parlez à Taran Zhu à l’Avant-poste de Longying dans les Steppes de Tanglong.‡去螳螂高原的龙影岗哨和祝踏岚谈一谈。‡',
  }
},
[31387] = {
  {
    'Entendendo os Shado-Pans‡Понимание Шадо-Пан‡Die Shado-Pan verstehen‡음영파 알기‡Comprender el Shadopan‡‡Comprendre les Pandashan‡初识影踪派‡',
    nil,
    'Obtenha a reputação Reverenciado com o Lótus Dourado. Uma‡Добейтесь того, чтобы вас почитали в Золотом Лотосе.‡Erlangt beim Goldenen Lotus einen respektvollen Ruf.‡황금 연꽃과 매우 우호적 평판을 달성해야 합니다. 레벨 25 탕랑 평원‡Alcanza el estado de Venerado con el Loto Dorado.‡‡Devenez &lt;Révéré/Révérée&gt; auprès du Lotus doré.‡在金莲教阵营达到崇敬声望。‡',
  }
},
[31388] = {
  {
    'A ofensiva dos shado-pans‡Армия Шадо-Пан‡Die Shado-Pan-Offensive‡음영파의 공격‡La ofensiva del Shadopan‡‡L’offensive pandashan‡影踪派的攻势‡',
    nil,
    'Fale com Taran Zhu no Entreposto Longying, que fica nas Estepes de Taolong. Uma‡Поговорите с Тажанем Чжу на укреплениях Лун-Ин, которые находятся в Танлунских степях.‡Sprecht mit Taran Zhu am Außenposten Longying in der Tonlongsteppe.‡탕랑 평원의 롱잉 전초기지에 있는 타란 주와 대화해야 합니다. 레벨 25 탕랑 평원‡Habla con Taran Zhu en la Avanzada Longying, en las Estepas de Tong Long.‡‡Parlez à Taran Zhu à l’Avant-poste de Longying dans les Steppes de Tanglong.‡去螳螂高原的龙影岗哨和祝踏岚谈一谈。‡',
  }
},
[31389] = {
  {
    'Entendendo os Shado-Pans‡Понимание Шадо-Пан‡Die Shado-Pan verstehen‡음영파 알기‡Comprender el Shadopan‡‡Comprendre les Pandashan‡初识影踪派‡',
    nil,
    'Obtenha a reputação Reverenciado com o Lótus Dourado. Uma‡Добейтесь того, чтобы вас почитали в Золотом Лотосе.‡Erlangt beim Goldenen Lotus einen respektvollen Ruf.‡황금 연꽃과 매우 우호적 평판을 달성해야 합니다. 레벨 25 탕랑 평원‡Alcanza el estado de Venerado con el Loto Dorado.‡‡Devenez &lt;Révéré/Révérée&gt; auprès du Lotus doré.‡在金莲教阵营达到崇敬声望。‡',
  }
},
[31390] = {
  {
    'Os Klaxxi‡Клакси‡Die Klaxxi‡클락시‡Los Klaxxi‡‡Les Klaxxi‡卡拉克西‡',
    nil,
    'Fale com a Arqueira Li no Portal do Sol Poente, entre o Vale das Flores Eternas e o Ermo do Medo. Uma‡Поговорите с лучницей Ли Ц-Вай у Врат Заходящего Солнца между Вечноцветущим долом и Жуткими пустошами.‡Sprecht mit Bogenmeisterin Li am Tor der Untergehenden Sonne zwischen dem Tal der Ewigen Blüten und der Schreckensöde.‡영원꽃 골짜기와 공포의 황무지 사이, 석양문에 있는 명궁 리와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con la maestra arquera Li en la Puerta del Sol Poniente, entre el Valle de la Flor Eterna y el Desierto del Pavor.‡‡Parlez au Maître-archer Li à la Porte du Soleil couchant, située entre le Val de l’Éternel printemps et les Terres de l’Angoisse. Un(e) quête.‡去锦绣谷与恐惧废土之间的残阳关与女射手李琪薇谈一谈。‡',
  }
},
[31391] = {
  {
    'Os Klaxxi‡Клакси‡Die Klaxxi‡클락시‡Los Klaxxi‡‡Les Klaxxi‡卡拉克西‡',
    nil,
    'Fale com a Arqueira Li no Portal do Sol Poente, entre o Vale das Flores Eternas e o Ermo do Medo. Uma‡Поговорите с лучницей Ли у Врат Заходящего Солнца между Вечноцветущим долом и Жуткими пустошами.‡Sprecht mit Bogenmeisterin Li am Tor der Untergehenden Sonne zwischen dem Tal der Ewigen Blüten und der Schreckensöde.‡영원꽃 골짜기와 공포의 황무지 사이, 석양문에 있는 명궁 리와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con la maestra arquera Li en la Puerta del Sol Poniente, entre el Valle de la Flor Eterna y el Desierto del Pavor.‡‡Parlez au Maître-archer Li à la Porte du Soleil couchant, située entre le Val de l’Éternel printemps et les Terres de l’Angoisse. Donne  en récompense.‡去锦绣谷和恐惧废土之间的残阳关和女射手李琪薇谈一谈。‡',
  }
},
[31392] = {
  {
    'Templo do Tigre Branco‡Храм Белого Тигра‡Tempel des Weißen Tigers‡백호사‡Templo del Tigre Blanco‡‡Temple du Tigre blanc‡白虎寺‡',
    nil,
    'Fale com Anduin Wrynn no Templo do Tigre Branco, que fica no Monte Kun-Lai. Uma‡Поговорите с Андуином Ринном в храме Белого Тигра около вершины Кунь-Лай. задание.‡Sprecht mit Anduin Wrynn im Tempel des Weißen Tigers am Kun-Lai-Gipfel.‡쿤라이 봉우리의 백호사에 있는 안두인 린과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con Anduin Wrynn en el Templo del Tigre Blanco en Cima Kun-Lai.‡‡Parlez à Anduin Wrynn au Temple du Tigre blanc, au Sommet de Kun-Lai.‡去昆莱山的白虎寺和安度因·乌瑞恩谈一谈。‡',
  }
},
[31393] = {
  {
    'Templo do Tigre Branco‡Храм Белого Тигра‡Tempel des Weißen Tigers‡백호사‡Templo del Tigre Blanco‡‡Temple du Tigre blanc‡白虎寺‡',
    nil,
    'Fale com Dezco no Templo do Tigre Branco, que fica no Monte Kun-Lai. Uma‡Поговорите с Дезко в храме Белого Тигра на вершине Кунь-Лай.‡Sprecht mit Dezco im Tempel des Weißen Tigers am Kun-Lai-Gipfel.‡쿤라이 봉우리의 백호사에 있는 데즈코와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con Dezco en el Templo del Tigre Blanco en Cima Kun-Lai.‡‡Parlez à Dezco au Temple du Tigre blanc, au Sommet de Kun-Lai.‡去昆莱山的白虎寺找德兹科谈一谈。‡',
  }
},
[31394] = {
  {
    'Uma experiência celestial‡Испытания Небожителей‡Eine himmlische Erfahrung‡천신회‡Una experiencia celestial‡‡L\'épreuve des astres‡神圣体验‡',
    nil,
    'Fale com Xuen e complete os testes dele. Uma‡Поговорите с Сюэнем и пройдите его испытания.‡Sprecht mit Xuen und schließt seine Prüfungen ab.‡쉬엔과 대화하고 그가 주는 과제를 모두 완수해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con Xuen y completa sus pruebas.‡‡Parlez à Xuen et passez ses épreuves.‡和雪怒谈一谈，完成他的试炼。‡',
  }
},
[31395] = {
  {
    'Uma experiência celestial‡Испытания Небожителей‡Eine himmlische Erfahrung‡천신회‡Una experiencia celestial‡‡L\'épreuve des astres‡神圣体验‡',
    nil,
    'Fale com Xuen e passe nos testes dele. Uma‡Поговорите с Сюэнем и пройдите его испытания.‡Sprecht mit Xuen und besteht seine Prüfungen.‡쉬엔과 대화하고 그가 주는 과제를 모두 완수해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con Xuen y completa sus pruebas.‡‡Parlez à Xuen et passez ses épreuves.‡和雪怒谈一谈，完成他的试炼。‡',
  }
},
