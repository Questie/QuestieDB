},
[9291] = {
  {
    '‡Обучение жреца‡Ausbildung zum Priester‡사제 훈련‡Instrucción de sacerdote‡Instrucción de sacerdote‡La formation du prêtre‡牧师训练‡牧師訓練',
    nil,
    nil,
  }
},
[9292] = {
  {
    'Cristal necrótico rachado‡Треснувший некротический кристалл‡Gesprungener nekrotischer Kristall‡부서진 죽음의 수정‡Cristal necrótico rajado‡Cristal necrótico rajado‡Cristal nécrotique fêlé‡破碎的死灵水晶‡破碎的亡域水晶',
    nil,
    'Leve o Cristal Necrótico Rachado para o Tenente Orrin em frente aos portões de Ventobravo.‡Отнесите треснувший некротический кристалл лейтенанту Оррину, находящемуся за воротами Штормграда.‡Bringt den gesprungenen nekrotischen Kristall zu Leutnant Orrin außerhalb der Tore von Sturmwind.‡스톰윈드 성문 외곽에 있는 부관 오린에게 부서진 죽음의 수정을 가져가야 합니다.‡LLeva el cristal necrótico al general Orrin, que está fuera de las puertas de Ventormenta.‡Lleva el cristal necrótico rajado al teniente Orrin, que está fuera de las puertas de Ventormenta.‡Apportez le Cristal nécrotique fêlé au lieutenant Orrin à l\'extérieur des portes de Hurlevent.‡将破碎的死灵水晶交给暴风城门外的奥林中尉。‡將破碎的亡域水晶帶給暴風城城門外的歐令中尉。',
  }
},
[9293] = {
  {
    'A resposta adequada...‡То, что должно быть сделано...‡Was getan werden muss...‡반드시 행해져야 할 것...‡Hacer lo correcto...‡Hacer lo correcto...‡Ce qui doit être fait...‡必需的措施......‡必要手段...',
    nil,
    'Colete 10 Amostras de Açoitadeira e leve-as à Botânica Taerix no Ponto de Impacto, que fica no Vale Ammen.‡Соберите 10 образцов корней корнехлестов и отнесите их ботанику Таэрикс на место крушения в долине Аммен.‡Sammelt 10 Peitscherproben ein und bringt sie zu Botanikerin Taerix bei der Absturzstelle im Am\'mental.‡덩굴손 견본 10개를 수집한 다음 암멘 골짜기의 추락 지점에 있는 식물학자 태릭스에게 가져가야 합니다.‡Recolecta 10 muestras de azotador y llévaselas a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Recolecta 10 muestras de azotador y llévaselas a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Rassemblez 10 Échantillons de fouette-racines et rapportez-les à la botaniste Taerix, au point d\'impact du val d\'Ammen.‡收集10份鞭笞者样本，把它们交给埃门谷坠毁点的植物学家塔蕾克丝。‡收集10個鞭笞者樣本再回到安曼谷的失事地點找植物學家泰瑞茲。',
  }
},
[9294] = {
  {
    'A descontaminação do lago‡Исцеление озера‡Die Heilung des Sees‡호수 정화‡Sanar el lago‡Sanar el lago‡Guérir le lac‡净化湖水‡拯救湖泊',
    nil,
    'Disperse o Agente Neutralizador no Cristal de Poder Irradiado. Em seguida, fale com a Botânica Taerix no Ponto de Impacto, que fica no Vale Ammen.‡Вылейте нейтрализующее вещество в воду рядом с радиоактивным кристаллом силы на месте крушения в долине Аммен, затем вернитесь к ботанику Таэрикс.‡Verwendet den Neutralisierungswirkstoff bei dem strahlenden Energiekristall und kehrt anschließend zu Botanikerin Taerix bei der Absturzstelle im Am\'mental zurück.‡방사능에 오염된 마력의 수정에 중화제를 뿌린 다음 암멘 골짜기의 추락 지점에 있는 식물학자 태릭스에게 가야 합니다.‡Dispersa el agente neutralizador sobre el cristal de energía irradiada y después vuelve junto a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Dispersa el agente neutralizador sobre el cristal de energía irradiada y después vuelve junto a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Répandez le Produit neutralisant près du Cristal de puissance irradié. Ensuite, retournez voir la botaniste Taerix au point d\'impact du val d\'Ammen.‡将中和媒介散布在辐射能量水晶旁，然后向埃门谷坠毁点的植物学家塔蕾克丝复命。‡對放射性能量水晶散播中和劑。然後，再回到安曼谷的失事地點找植物學家泰瑞茲。',
  }
},
[9295] = {
  {
    'Carta do front‡Письмо с фронта‡Brief von der Front‡전방에서 온 편지‡Una carta del frente‡Una carta del frente‡Une lettre du front‡被撕碎的信‡來自前線的信件',
    nil,
    'Leve a Carta Rasgada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите порванное письмо хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den zerfledderten Brief zum Bewahrer der Schriften bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 찢어진 편지를 가져가야 합니다.‡Lleva la carta rota al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la carta rota al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Lettre déchirée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将被撕碎的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將老舊的信件帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9296] = {
  {
    'reuse‡reuse‡reuse‡reuse‡reuse‡reuse‡reuse‡reuse‡reuse',
    nil,
    'Deliver the Dim Necrotic Stone to SOMEONE.‡Отнесите тусклый некротический камень персонажу "КТО-ТО".‡Bringt den dunklen nekrotischen Stein zu einer bestimmten Person.‡희미하게 빛나는 죽음의 돌을 누군가에게 전달해야 합니다.‡Entrega la piedra necrótica oscura a ALGUIEN.‡Entrega la piedra necrótica oscura a ALGUIEN.‡Remettez la pierre nécrotique pâle à QUELQU’UN.‡将暗淡的死灵石交给某个人。‡把黯淡的墓地之石交給其他人。',
  }
},
[9297] = {
  {
    'reuse‡reuse‡reuse‡reuse‡reuse‡reuse‡reuse‡reuse‡reuse',
    nil,
    'Deliver the Dim Necrotic Stone to SOMEONE.‡Отнесите тусклый некротический камень персонажу "КТО-ТО".‡Bringt den dunklen nekrotischen Stein zu einer bestimmten Person.‡희미하게 빛나는 죽음의 돌을 누군가에게 전달해야 합니다.‡Entrega la piedra necrótica oscura a ALGUIEN.‡Entrega la piedra necrótica oscura a ALGUIEN.‡Remettez la pierre nécrotique pâle à QUELQU’UN.‡将暗淡的死灵石交给某个人。‡把黯淡的墓地之石交給其他人。',
  }
},
[9298] = {
  {
    '‡‡‡재사용‡‡‡RÉUTILISER‡‡',
    nil,
    '‡Отдайте тусклый некротический камень КОМУ-НИБУДЬ.‡Bringt den dunklen nekrotischen Stein zu einer bestimmten Person.‡‡Entrega la piedra necrótica a ALGUIEN.‡Entrega la piedra necrótica a ALGUIEN.‡Apportez la Pierre nécrotique pâle à QUELQU\'UN.‡‡',
  }
},
[9299] = {
  {
    'Bilhete do front‡Записка с фронта‡Notiz von der Front‡전방에서 온 쪽지‡Una nota del frente‡Una nota del frente‡Une note du front‡潦草的便笺‡前線的便箋',
    nil,
    'Leve o Bilhete Aflito para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите потертую записку хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die verblichene Notiz zum Bewahrer der Schriften bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 근심 가득한 쪽지를 가져가야 합니다.‡Lleva la nota desgastada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la nota desgastada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Note détériorée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将潦草的便笺交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將乾淨的便條帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9300] = {
  {
    'Página do front‡Страничка с фронта‡Nachricht von der Front‡전방에서 온 찢어진 페이지‡Una página del frente‡Una página del frente‡Une page du front‡破旧的信‡前線的書頁',
    nil,
    'Leve a Página Desalinhada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите разорванную страницу хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die zerfranste Seite zum Bewahrer der Schriften bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 찢어진 페이지를 가져가야 합니다.‡Lleva la página desgarrada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la página desgarrada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Page abîmée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将破旧的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將破爛的書頁帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9301] = {
  {
    'Envelope do front‡Конверт с фронта‡Umschlag von der Front‡전방에서 온 봉투‡Un sobre del frente‡Un sobre del frente‡Une enveloppe du front‡浸血的信封‡前線的信封',
    nil,
    'Leve o Envelope Manchado de Sangue para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите конверт, запятнанный кровью, хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den blutbefleckten Umschlag zum Bewahrer der Schriften bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 피로 물든 봉투를 가져가야 합니다.‡Lleva el sobre ensangrentado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva el sobre ensangrentado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez l\'Enveloppe tachée de sang au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将浸血的信封交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將染血的信封帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9302] = {
  {
    'Missiva do front‡Послание с фронта‡Schreiben von der Front‡전방에서 온 서한‡Una misiva del frente‡Una misiva del frente‡Une missive du front‡被弄皱的信‡前線的公文',
    nil,
    'Leve a Missiva Amassada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите смятое послание хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt das zerknitterte Schreiben zum Bewahrer der Schriften bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 구겨진 서한을 가져가야 합니다.‡Lleva la misiva arrugada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la misiva arrugada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Missive froissée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将被弄皱的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將弄皺的公文帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9303] = {
  {
    'Inoculação‡Прививка‡Immunisierung‡예방 접종‡Inoculación‡Inoculación‡Inoculation‡疫苗‡注射疫苗',
    nil,
    'Use o Cristal de Inoculação em 6 Corujantes do Ninhal. Em seguida, fale com o Vindicante Aldar, no Ponto de Impacto, que fica no Vale Ammen.‡Сделайте прививку шести совунам с Совиных холмов при помощи особого кристалла. Затем вернитесь к воздаятелю Алдару на место крушения в долине Аммен.‡Wendet den Immunisierungskristall auf 6 Nisteleulkin an. Kehrt anschließend zu Verteidiger Aldar bei der Absturzstelle im Am\'mental zurück.‡다닥나무 올빼미야수 6마리에게 예방의 수정을 사용한 후 암멘 골짜기의 추락 지점에 있는 구원자 알다르에게 가야 합니다.‡Usa el cristal inoculador sobre los 6 buhícos Cubrebosque. Regresa entonces junto al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Usa el cristal inoculador sobre los 6 buhícos Cubrebosque. Regresa entonces junto al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Utilisez le Cristal d\'inoculation sur 6 Chouettides nidebois. Retournez ensuite auprès du redresseur de torts Aldar au Point d\'impact du val d\'Ammen.‡对6只木巢枭兽使用疫苗水晶，然后向埃门谷坠毁点的守备官奥达尔复命。‡在6個奈斯特灌木林梟獸身上使用注射用水晶。再回到安曼谷的失事地點找復仇者艾德。',
  }
},
[9304] = {
  {
    'Documento do front‡Документ с фронта‡Dokument von der Front‡전방에서 온 문서‡Un documento del frente‡Un documento del frente‡Un document du front‡肮脏的信‡前線的文件',
    nil,
    'Leve o Documento Borrado para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите испачканный документ хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt das verschmierte Dokument zum Bewahrer der Schriften bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 흐릿해진 문서를 가져가야 합니다.‡Lleva el documento manchado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva el documento manchado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le Document taché au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将肮脏的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將弄髒的文件帶到東瘟疫之地的聖光禮拜堂交給名冊保管者。',
  }
},
[9305] = {
  {
    'Peças sobressalentes‡Запасные части‡Ersatzteile‡도난당한 장비‡Piezas de repuesto‡Piezas de repuesto‡Pièces de rechange‡备用零件‡備用零件',
    nil,
    'Colete 4 Peças Sobressalentes do Emissor e, em seguida, fale com a Técnica Zhanaa no Ponto de Impacto, que fica no Vale Ammen.‡Соберите 4 запчасти для передатчика и отнесите их технику Жанае на место крушения в долине Аммен.‡Beschafft 4 Emitterersatzteile und kehrt anschließend zu Technikerin Zhanaa bei der Absturzstelle im Am\'mental zurück.‡예비 영사기 부품 4개를 모은 후, 암멘 골짜기의 추락 지점에 있는 기술자 자나에게 가야 합니다.‡Recolecta 4 piezas del emisor y llévaselas a la técnica Zhanaa en el Lugar del Accidente, en el Valle Ammen.‡Recolecta 4 piezas del emisor y llévaselas a la técnica Zhanaa en el Lugar del Accidente, en el Valle Ammen.‡Récupérez 4 Pièces de rechange pour l\'émetteur puis rapportez-les à la technicienne Zhanaa au Point d\'impact du val d\'Ammen.‡收集4份发射器备用零件，然后向埃门谷坠毁点的技师沙娜安复命。‡收集4個發射器的備用零件。然後再回到安曼谷的失事地點找技師·薩那。',
  }
},
[9309] = {
  {
    'O batedor desaparecido‡Пропавший разведчик‡Der vermisste Späher‡실종된 정찰병‡El explorador desaparecido‡El explorador desaparecido‡L\'éclaireur disparu‡失踪的斥候‡調查暗影山脊',
    nil,
    'Encontre e fale com Tolaan, na Serra das Sombras, que fica no Vale Ammen.‡Найдите Толаана у хребта Теней в долине Аммен и поговорите с ним.‡Sprecht mit Tolaan im Schattenkamm im Am\'mental.‡암멘 골짜기의 어둠 마루에서 톨란을 찾아서 대화해야 합니다.‡Encuentra a Tolaan en la Cresta de las Sombras, en el Valle Ammen, y habla con él.‡Encuentra a Tolaan en la Cresta de las Sombras, en el Valle Ammen, y habla con él.‡Trouvez Tolaan sur l\'Ombrecrête du val d\'Ammen et parlez-lui.‡在埃门谷中的暗影山找到图兰，并与之交谈。‡到安曼谷的暗影山脊找到托蘭並和他談談。',
  }
},
[9310] = {
  {
    'Cristal necrótico fugaz‡Тусклый некротический кристалл‡Schwacher nekrotischer Kristall‡희미한 죽음의 수정‡Cristal necrótico tenue‡Cristal necrótico tenue‡Cristal nécrotique voilé‡暗淡的死灵水晶‡黯淡的亡域水晶',
    nil,
    'Entregue o Cristal Necrótico Fugaz para o Tenente Rukag na pátio da Cidade Baixa.‡Отнесите тусклый некротический кристалл лейтенанту Рукагу во внутренний двор Подгорода.‡Bringt den schwachen nekrotischen Kristall zu Leutnant Rukag im Hof von Unterstadt.‡언더시티의 안마당에 있는 부관 루카그에게 희미한 죽음의 수정을 가져가야 합니다.‡LLeva el cristal necrótico al general Rukag, que está fuera de las puertas de Entrañas.‡Lleva el cristal necrótico al teniente Rukag, que está fuera de las puertas de Entrañas.‡Apportez le Cristal nécrotique voilé au lieutenant Rukag dans la cour de Fossoyeuse.‡将暗淡的死灵水晶交给幽暗城庭院处的卢卡中尉。‡將黯淡的亡域水晶帶給幽暗城庭院的盧卡中尉。',
  }
},
[9311] = {
  {
    'Espiã elfa sangrenta‡Шпион эльфов крови‡Blutelfenspionage‡블러드 엘프 첩자‡Espía elfo de sangre‡Espía elfo de sangre‡L\'espionne elfe de sang‡血精灵间谍‡血精靈間諜',
    nil,
    'Mate a Monteira Candressa e, em seguida, informe o Vindicante Aldar no Ponto de Impacto, que fica no Vale Ammen.‡Убейте геодезиста Кандресс и расскажите о случившемся воздаятелю Алдару на месте крушения в долине Аммен.‡Tötet Gutachterin Kandress und informiert anschließend Verteidiger Aldar bei der Absturzstelle im Am\'mental über die Ereignisse.‡감시관 캔드레스를 처치하고 암멘 골짜기의 추락 지점에 있는 구원자 알다르에게 그곳에서 벌어진 일에 대한 소식을 전해야 합니다.‡Mata a la perita Candress y ve a informar al vindicador Aldar al Lugar del Accidente en el Valle Ammen.‡Mata a la perita Candress y ve a informar al vindicador Aldar al Lugar del Accidente en el Valle Ammen.‡Tuez la Géomètre Candress, puis allez rendre compte au redresseur de torts Aldar, au Point d\'impact du val d\'Ammen.‡杀死测量员卡蒂瑞丝，并把这个消息通知给埃门谷坠毁点的守备官奥达尔。‡殺死勘測員坎翠斯，然後把這裡發生的事告訴安曼谷失事地點的復仇者艾德。',
  }
},
[9312] = {
  {
    'O emissor‡Излучатель‡Der Emitter‡홀로그램 영사기‡El emisor‡El emisor‡L\'émetteur‡图像发射器‡發射器',
    nil,
    'Fale com a Técnica Zhanaa no Ponto de Impacto, que fica no Vale Ammen.‡Поговорите с техником Жанаей на месте крушения в долине Аммен.‡Sprecht mit Technikerin Zhanaa bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 기술자 자나와 대화해야 합니다.‡Habla con la técnica Zhanaa en el Lugar del Accidente en el Valle Ammen.‡Habla con la técnica Zhanaa en el Lugar del Accidente en el Valle Ammen.‡Allez voir la technicienne Zhanaa, au Point d\'impact du val d’Ammen.‡与埃门谷坠毁点的技师沙娜安谈一谈。‡和安曼谷失事地點的技師·薩那談談。',
  }
},
[9313] = {
  {
    'A viagem para o Entreposto Lazúli‡На Лазурную заставу‡Reise zur Azurwacht‡하늘 감시초소로 이동‡Viaje a la Avanzada Azur‡Viaje a la Avanzada Azur‡En route pour le Guet d\'azur‡前往碧蓝岗哨‡前往藍色守望',
    nil,
    'Fale com o Técnico Dyvuun no Entreposto Lazúli, que fica na Ilha Névoa Lazúli.‡Поговорите с техником Дивууном на Лазурной заставе на острове Лазурной Дымки.‡Sprecht mit Techniker Dyvuun bei der Azurwacht auf der Azurmythosinsel.‡하늘안개 섬의 하늘 감시초소에 있는 기술자 디부운과 대화해야 합니다.‡Habla con el técnico Dyvuun en la Avanzada Azur, en la Isla Bruma Azur.‡Habla con el técnico Dyvuun en la Avanzada Azur, en la Isla Bruma Azur.‡Allez voir le technicien Dyvuun au Guet d\'azur, sur l’Île de Brume-azur.‡与秘蓝岛的碧蓝岗哨中的技师戴维恩谈一谈。‡到藍謎島和藍色守望的技師戴伏恩談談。',
  }
},
[9314] = {
  {
    'Notícias do Entreposto Lazúli‡Вести с Лазурной заставы‡Nachricht von der Azurwacht‡하늘 감시초소의 요청‡Un mensaje de la Avanzada Azur‡Un mensaje de la Avanzada Azur‡Une demande du Guet d\'azur‡碧蓝岗哨的消息‡藍色守望的字條',
    nil,
    'Fale com a Hospedeira Chellan no Entreposto Lazúli, que fica na Ilha Névoa Lazúli.‡Поговорите с корчмарем Челланой на Лазурной заставе на острове Лазурной Дымки.‡Sprecht mit Versorgerin Chellan bei der Azurwacht auf der Azurmythosinsel.‡하늘안개 섬의 하늘 감시초소에 있는 간병인 첼란과 대화해야 합니다.‡Habla con la cuidadora Chellan en la Avanzada Azur, en la Isla Bruma Azur.‡Habla con la cuidadora Chellan en la Avanzada Azur, en la Isla Bruma Azur.‡Parlez à l\'hôtesse Chellan au Guet d\'azur sur l\'île de Brume-azur.‡与秘蓝岛上的碧蓝岗哨中的看护员谢尔兰谈一谈。‡去藍謎島和藍色守望的照顧者查倫談談。',
  }
},
[9315] = {
  {
    'Anok\'suten‡Анок\'сутен‡Anok\'suten‡아녹수텐‡Anok\'suten‡Anok\'suten‡Anok\'suten‡阿诺克苏塔‡安羅科舒頓',
    nil,
    'Mate Anok\'suten e apresente-se ao Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Убейте Анок\'сутен и возвращайтесь к чародею Вандрилу в Транквиллион, что в Призрачных землях.‡Tötet Anok\'suten und kehrt anschließend zu Arkanist Vandril in Tristessa in den Geisterlanden zurück.‡아녹수텐을 해치운 다음 유령의 땅, 트랜퀼리엔에 있는 비전술사 반드릴에게 가야 합니다.‡Mata a Anok\'suten y ve a ver al arcanista Vandril a Tranquillien en las Tierras Fantasma.‡Mata a Anok\'suten y ve a ver al arcanista Vandril a Tranquillien en las Tierras Fantasma.‡Tuez Anok\'suten et retournez voir l\'arcaniste Vandril, à Tranquillien dans les Terres fantômes.‡杀死阿诺克苏塔，然后向幽魂之地塔奎林的奥术师范迪瑞尔复命。‡殺死安羅科舒頓再回到鬼魂之地的安寧地找秘法師范德隆。',
  }
},
[9316] = {
  {
    '[TXT] Goblins selvagens‡[TXT] Гоблины-варвары‡Wilde Goblins‡[미사용] Goblin Savages‡[TXT] Goblin Savages‡[TXT] Goblin Savages‡[TXT] Sauvages gobelins‡[TXT] Goblin Savages‡[TXT]哥布林掠奪者',
    nil,
    'Brianna Schneider na Ilha dos Designers quer 10 Dentes de Goblin.‡Брианна Шнайдер с острова Дизайнера хочет 10 гоблинских зубов.‡Brianna Schneider auf der Designerinsel möchte, dass Ihr ihr 10 Goblinzähne bringt.‡Brianna Schneider on Designer Island wants 10 Goblin Teeth.‡Brianna Schneider de Isla del Diseñador quiere 10 dientes de goblin.‡Brianna Schneider de Isla del Diseñador quiere 10 dientes de goblin.‡Brianna Schneider sur l\'île des concepteurs veut 10 Dents de gobelins.‡Brianna Schneider on Designer Island wants 10 Goblin Teeth.‡設計者之島的布理安娜·施耐德要10顆哥布林牙齒。',
  }
},
