[31598] = {
  {
    'O núcleo de Kypa\'rak‡Ядро Кипа\'рака‡Kypa\'raks Kern‡키파라크의 핵‡El núcleo de Kypa\'rak‡‡Le noyau de Kypa’rak‡凯帕拉克之核‡',
    nil,
    'Leve o Núcleo Maciço de Kyparita para o Molda-âmbar Zikk em Klaxxi\'vess. Uma‡Принесите большое кипаритовое ядро кователю янтаря Зикку в Клакси\'весс. задание.‡Bringt den massiven Kyparitkern zu Bernschmied Zikk in Klaxxi\'vess.‡클락시베스에 있는 호박대장장이 지크에게 거대한 키파라이트 핵을 가져가야 합니다. 레벨 30 공포의 황무지‡Lleva el núcleo de kyparita macizo al herrero de ámbar Zikk en Klaxxi\'vess.‡‡Apportez le Noyau de kyparite massif à l’Ambre-forgeron Zikk à Klaxxi’vess.‡把巨型凯帕琥珀核心交给卡拉克西维斯的琥珀匠师齐克。‡',
  }
},
[31599] = {
  {
    'A bocarra da matriarca‡Мощные жвала матриарха‡Der Schlund der Matriarchin‡쿤총 여왕의 턱‡Las fauces de la matriarca‡‡La mâchoire de la matriarche‡女王之喉‡',
    nil,
    'Leve as Mandíbulas de Kunchong Enormes para o Molda-âmbar Zikk em Klaxxi\'vess. Uma‡Принесите огромные жвала куньчун кователю янтаря Зикку в Клакси\'весс.‡Bringt die enormen Kunchongmandibeln zu Bernschmied Zikk in Klaxxi\'vess.‡클락시베스에 있는 호박대장장이 지크에게 엄청나게 큰 쿤총 턱을 가져가야 합니다. 레벨 30 공포의 황무지‡Lleva las mandíbulas de kunchong enormes al herrero de ámbar Zikk en Klaxxi\'vess.‡‡Apportez les Énormes mandibules de kunchong à l’Ambre-forgeron Zikk à Klaxxi’vess.‡把巨型恐虫颚骨交给卡拉克西维斯的琥珀匠师齐克。‡',
  }
},
[31600] = {
  {
    'Ativar Cenários‡Enable Scenarios‡Szenarien ermöglichen‡시나리오 활성화‡Enable Scenarios‡‡Activer les scénarios‡启动场景战役‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31603] = {
  {
    'Sementes do medo‡Семена Страха‡Saat der Angst‡공포의 씨앗‡Semillas de miedo‡‡Les graines de la peur‡恐惧之种‡',
    nil,
    'Algumas das kyparis corrompidas foram destroçadas durante a horrenda marcha do enxame, espalhando farpas de âmbar infestado pelo sha por toda a terra.Traga-me as que você encontrar em suas viagens para que possamos destruí-las adequadamente.‡За время движения роя некоторые из оскверненных кипари рассеяли капли янтаря, зараженного ша, по всему краю.Если в странствии ты встретишь эти капли, принеси их мне. Я смогу избавиться от них как положено.‡Einige der verderbten Kypari wurden während des schrecklichen Marsches des Schwarms verstreut. Dabei verteilten sie Splitter des Sha-infizierten Berns übers Land.Bringt mir alles, was Ihr davon auf Euren Reisen finden könnt, damit es entsorgt werden kann.‡레벨 30 공포의 황무지‡Algunos de los kypari corruptos fueron destrozados durante la horrible marcha del enjambre y llenaron la tierra de fragmentos de ámbar infestado de sha.Tráeme todos los que encuentres en tus viajes para que podamos deshacernos de ellos como es debido.‡‡Certains des kypari corrompus ont été brisés pendant l’horrible marche de l’essaim, et ont laissé des éclats d’ambre souillé par les sha partout dans les terres.Apportez-moi tous ceux que vous trouverez, que nous puissions les détruire comme il se doit.‡‡',
  }
},
[31604] = {
  {
    'Ataque a Zan\'vess‡Атака на Зан\'весс‡Angriff auf Zan\'vess‡‡Asalto a Zan\'vess‡‡L’assaut de Zan’vess‡‡',
    nil,
    'Complete o cenário Ataque a Zan\'vess. Fale com Klaxxi\'va Vor ou use a ferramenta Procurando Masmorra para começar. Uma‡Возглавьте нападение на Зан\'весс. Чтобы начать, поговорите с Клакси\'ва Вор или воспользуйтесь системой поиска подземелий.‡Beendet das Szenario Angriff auf Zan\'vess. Sprecht mit Klaxxi\'va Vor oder nutzt den Dungeonbrowser, um zu beginnen.‡‡Completa la gesta del Asalto a Zan\'vess. Habla con Vor Klaxxi\'va o usa el buscador de mazmorras para empezar.‡‡Terminez le scénario L\'assaut de Zan\'vess. Parlez au Klaxxi\'va Vor ou utilisez l\'outil de recherche de donjon pour commencer.‡‡',
  }
},
[31605] = {
  {
    'A escavação dos Zan\'thik‡Раскопки Зан\'тиков‡Die Zan\'thikausgrabung‡잔티크에서의 발굴‡La excavación Zan\'thik‡‡L\'excavation des zan\'thik‡扎尼提克的发现‡',
    nil,
    'Encontre o paragão desencavado na Mina de Âmbar, que fica em Zan\'vess. Uma‡Найдите Идеала в Янтарных копях на Зан\'вессе.‡Sucht den ausgegrabenen Getreuen im Berntagebau auf Zan\'vess.‡잔베스의 호박석 채석장에서 발굴된 용장을 찾아야 합니다. 레벨 30 공포의 황무지‡Encuentra al dechado desenterrado en la Cantera de Ámbar en Zan\'vess.‡‡Localisez le Parangon déterré dans la Carrière d’ambre, à Zan\'vess.‡在扎尼维斯的琥珀采掘场找到被挖出的英杰。‡',
  }
},
[31606] = {
  {
    'O Dissecador acorda‡Пробуждение Рик\'кала‡Der Sezierer erwacht‡해부자, 깨어나다‡El Disector despierta‡‡Le Disséqueur s\'éveille‡切割者觉醒‡',
    nil,
    'Rechace os Zan\'thik enquanto Rik\'kal desperta. Uma‡Сдерживайте зан\'тиков, пока Рик\'кал не придет в себя.‡Wehrt die Zan\'thik ab, während Rik\'kal erwacht.‡리크칼이 정신을 차리는 동안 잔티크 사마귀 무리를 막아야 합니다. 레벨 30 공포의 황무지‡Rechaza a los Zan\'thik mientras Rik\'kal se despierta.‡‡Repoussez les Zan\'thik pendant que Rik\'kal s\'éveille.‡在里卡尔苏醒时阻挡扎尼提克的攻击。‡',
  }
},
[31607] = {
  {
    'Rastreamento de Evento: Completou Espíritos desprezíveis e nós Nós nos tornamos o ódio‡Выслеживание: задания "Недобрые духи" и "Мы во власти ненависти"‡Verfolgungsereignis: Boshafte Geister und der Hass steht uns gut abgeschlossen‡추적 이벤트: 원한의 영혼과 증오가 우릴 덮치다 완료‡Tracking Event: Finished Spiteful Spirits & Hatred Becomes Us‡‡Tracking Event: Finished Spiteful Spirits & Hatred Becomes Us‡追踪事件：完成怨恨的灵魂和恨之入骨‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31609] = {
  {
    'A ira de Shek\'zeer‡Гнев Шек\'зир‡Der Zorn von Shek\'zeer‡셰크지르의 격노‡La cólera de Shek\'zeer‡‡La colère de Shek’zeer‡夏柯希尔之怒‡',
    nil,
    'Expulse o Enxame Mantídeo matando Akkolon, Shox\'tik, a Manifestação do Terror e mais 25 subjugados mantídeos. Uma‡Разбейте рой богомолов, уничтожив Акколона, Шокс\'тика, Проявление ужаса и 25 богомолов-прислужников.‡Fügt dem Mantisschwarm eine vernichtende Niederlage zu, indem Ihr Akkolon, Shox\'tik, die Manifestation des Terrors und 25 unterworfene Mantis tötet.‡아콜론, 쇽스티크, 두려움의 집중물과 사마귀 예속자 25마리를 처치해 사마귀 군단을 궤멸시켜야 합니다.‡Para expulsar al enjambre mántide, mata a Akkolon, a Shox\'tik, a la manifestación del terror y a 25 subyugados mántides.‡‡Faites fuir l’Essaim mantide en tuant Akkolon, Shox’tik, la Manifestation de la terreur ainsi que 25 Subjugués mantides.‡击败阿卡隆、夏克提克、惊怖具象和25只螳螂妖征服者以击溃螳螂妖虫群。‡',
  }
},
[31611] = {
  {
    'A Touro Vermelho de Kun-Lai‡Куньлайский сногсшибатель‡Der Kun-Lai-Hammer‡쿤라이 뻥뻥주‡La pateadora de Kun-Lai‡‡La Ravigote de Kun-Lai‡昆莱劲酒‡',
    nil,
    'Proteja o Festival da Cerveja da Lua. Uma‡Защитите фестиваль Хмельнолуния.‡Beschützt das Braumondfest.‡맥주달 축제를 지켜야 합니다. 레벨 20 맥주달 축제‡Protege el Festival de la Cerveza Lunar.‡‡Protégez le festival de Brasselune.‡保护酿月祭。‡',
  }
},
[31612] = {
  {
    'Sombra do Império‡Тень империи‡Schatten des Kaiserreichs‡제국의 그림자‡La sombra del imperio‡‡L\'ombre de l\'empire‡帝国的阴影‡',
    nil,
    'Acompanhe Kil\'ruk, o Aniquilador dos Ventos, à câmara debaixo de Klaxxi\'vess. Uma‡Сопроводите Кил\'рука Рассекающего Ветер в зал под Клакси\'вессом.‡Begleitet Kil\'ruk den Windschnitter in die Kammer unterhalb von Klaxxi\'vess.‡칼날바람 킬루크와 함께 클락시베스 아래의 방으로 들어가야 합니다. 레벨 30 공포의 황무지‡Acompaña a Kil\'ruk el Atracavientos hasta la cámara que hay bajo Klaxxi\'vess.‡‡Accompagnez Kil\'ruk le Saccageur des vents dans la salle située sous Klaxxi\'vess.‡陪同掠风者克尔鲁克进入卡拉克西维斯下面的密室。‡',
  }
},
[31613] = {
  {
    'Cerveja Rocha Verde Volátil‡Отвар Зеленой Скалы‡Brisantes Grünsteinbräu‡독한 녹옥 맥주‡Brebaje de Verdemar volátil‡‡Bière explosive de Pierre-Verte‡烈性绿石佳酿‡',
    nil,
    'Ajude na defesa da Vila Rocha Verde. Uma‡Помогите защитить деревню Зеленой Скалы. это‡Helft bei der Verteidigung von Grünstein.‡녹옥 마을 방어를 도와야 합니다. 레벨 10‡Ayuda en la defensa de la Aldea Verdemar.‡‡Aidez à défendre Pierre-Verte.‡帮助防守绿石村。‡',
  }
},
[31652] = {
  {
    'Clube do Rolamento: Missão de Rastreio do Espinhaço da Serpente‡Roll Club: Serpent\'s Spine Tracking Quest‡Rollclub: Schlangenrücken‡데굴데굴 동호회: 용의 척추 추적 퀘스트‡Roll Club: Serpent\'s Spine Tracking Quest‡‡Roll Club: Serpent’s Spine Tracking Quest‡翻滚俱乐部：蟠龙脊追踪任务‡',
    nil,
    'Uma‡это‡‡레벨 1‡‡‡‡‡',
  }
},
[31654] = {
  {
    'Portas para Vale ABERTAS‡Проход в Дол открыт‡Tore zum Tal GEÖFFNET‡골짜기 문 열림‡Puertas del valle abiertas‡‡Portes du val ouvertes‡通往锦绣谷的大门打开‡',
