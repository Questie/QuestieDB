},
[32673] = {
  {
    'Aprender a montar‡Уроки верховой езды‡Lernt Reiten‡타는 법 배우기‡A montar se ha dicho‡‡Un cavalier débutant‡学习骑乘‡',
    nil,
    'Encontre Revi Carnerodo. Uma‡Найдите Реви Подпруженя. это‡Findet Levi Ladestock.‡레비 램로드를 찾아야 합니다. 레벨 10‡Encuentra a Revi Varacarnero.‡‡Trouvez Revi Ramrod.‡找到蕾薇·推杆。‡',
  }
},
[32674] = {
  {
    'Espero que você saiba voar‡Я верю, что ты можешь летать‡Nur Fliegen ist leichter‡당신은 날아오를 수 있습니다‡Creo que puedes volar‡‡Prendre son envol‡我相信你能飞‡',
    nil,
    'Encontre Maztha. Uma‡Найдите Мазту. это‡Findet Maztha.‡마즈타를 찾아야 합니다. 레벨 30‡Encuentra a Maztha.‡‡Trouvez Maztha.‡找到玛奇萨。‡',
  }
},
[32675] = {
  {
    'Espero que você saiba voar‡Я верю, что ты можешь летать‡Nur Fliegen ist leichter‡당신은 날아오를 수 있습니다‡Creo que puedes volar‡‡Prendre son envol‡我相信你能飞‡',
    nil,
    'Encontre Bralla Volanuvem. Uma‡Найдите Браллу Дымокрыл. это‡Findet Bralla Wolkenflug.‡브랄라 클라우드윙을 찾아야 합니다. 레벨 30‡Encuentra a Bralla Alanube.‡‡Trouvez Bralla Nuelle.‡找到布娜拉·云翼。‡',
  }
},
[32676] = {
  {
    'Licença prolongada‡Увольнение на берег... надолго‡Ausgedehnter Landgang‡‡Permiso para bajar a tierra extendido‡‡Permission à terre prolongée‡延长登岸假‡',
    nil,
    'Roube o Relatório da Oficina e mate o novo capitão do navio de guerra Zandalari. Uma‡Украдите ремонтные инструкции и убейте нового капитана боевого корабля зандаларов.‡Stehlt die Werkstattsaufträge und tötet den neuen Kapitän des Kriegsschiffes der Zandalari.‡‡Roba los pedidos de taller y mata al nuevo capitán del buque de guerra Zandalari.‡‡Volez les Ordres de réparation et tuez le nouveau capitaine du navire de guerre des Zandalari.‡偷取工坊报告，并消灭赞达拉战船的新船长。‡',
  }
},
[32677] = {
  {
    'Saqueando o Salão‡Набег на хранилище‡Die Kammer plündern‡금고 침투‡Saquear la cámara‡‡Piller le caveau‡突袭宝库‡',
    nil,
    'Roube a Gargantilha das Tormentas no Salão Abaulado. Uma‡Отправляйтесь в Древнее хранилище и раздобудьте амулет "Колье Грома".‡Stehlt das Halsband der Stürme aus der Prall Gefüllten Kammer.‡축축한 금고에서 폭풍의 목장식을 훔쳐야 합니다. 레벨 32 천둥의 섬‡Roba la gargantilla de tormentas de La Cripta Solemne.‡‡Récupérez le Sautoir des tempêtes au Caveau démesuré.‡从浮华宝库里偷取风暴项圈。‡',
  }
},
[32678] = {
  {
    'O Chamado do Trovão‡Гром и молния‡Der Donner ruft‡천둥이 부른다‡La llamada del trueno‡‡Le tonnerre nous appelle‡雷霆召唤‡',
    nil,
    'Apresente-se À Capitã dos Batedores Elsia na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Явитесь к капитану разведчиков Эльсии в гарнизон Шадо-Пан, что в Танлунских степях.‡Meldet Euch bei Späherhauptmann Elsia in der Shado-Pan-Garnison in der Tonlongsteppe.‡탕랑 평원의 음영파 주둔지에 있는 정찰대장 엘시아에게 보고해야 합니다. 레벨 32 천둥의 섬‡Preséntate ante la capitana de exploradores Elsia en el cuartel del Shadopan, en las Estepas de Tong Long.‡‡Présentez-vous au capitaine des éclaireurs Elsia à la Garnison des Pandashan, dans les steppes de Tanglong.‡去螳螂高原的影踪卫戍营向斥候队长艾尔希娅报告。‡',
  }
},
[32679] = {
  {
    'O Chamado do Trovão‡Гром и молния‡Der Donner ruft‡천둥이 부른다‡La llamada del trueno‡‡Le tonnerre nous appelle‡雷霆召唤‡',
    nil,
    'Apresente-se a Vereesa Correventos na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Явитесь к Верисе Ветрокрылой в гарнизон Шадо-Пан, что в Танлунских степях. задание.‡Meldet Euch bei Vereesa Windläufer in der Shado-Pan-Garnison in der Tonlongsteppe.‡탕랑 평원의 음영파 주둔지에 있는 베리사 윈드러너에게 보고해야 합니다. 레벨 32 천둥의 섬‡Preséntate ante Vereesa Brisaveloz en el cuartel del Shadopan, en las Estepas de Tong Long.‡‡Présentez-vous à Vereesa Coursevent à la Garnison des Pandashan, dans les steppes de Tanglong.‡去螳螂高原的影踪卫戍营向温蕾萨·风行者报告。‡',
  }
},
[32680] = {
  {
    'A tempestade se aproxima‡Надвигается буря‡Der Sturm braut sich zusammen‡몰려오는 폭풍‡La tormenta acecha‡‡La tempête se prépare‡风雨欲来‡',
    nil,
    'Viaje com a Capitã dos Batedores Elsia até a Ilha do Trovão. Uma‡Отправляйтесь с капитаном разведчиков Эльсией на остров Грома.‡Reist mit Späherhauptmann Elsia zur Insel des Donners.‡정찰대장 엘시아와 함께 천둥의 섬으로 가야 합니다. 레벨 32 천둥의 섬‡Viaja con la capitana de exploradores Elsia a la Isla del Trueno.‡‡Rendez-vous avec le Capitaine des éclaireurs Elsia sur l’Île du Tonnerre.‡与斥候队长艾尔希娅一同前往雷神岛。‡',
  }
},
[32681] = {
  {
    'A tempestade se aproxima‡Надвигается буря‡Der Sturm braut sich zusammen‡몰려오는 폭풍‡La tormenta acecha‡‡La tempête se prépare‡风雨欲来‡',
    nil,
    'Viaje com Vereesa Correventos até a Ilha do Trovão. Uma‡Отправляйтесь с Верисой Ветрокрылой на остров Грома.‡Reist mit Vereesa Windläufer zur Insel des Donners.‡베리사 윈드러너와 함께 천둥의 섬으로 가야 합니다. 레벨 32 천둥의 섬‡Viaja con Vereesa Brisaveloz a la Isla del Trueno.‡‡Rendez-vous avec Vereesa Coursevent sur l’Île du Tonnerre.‡与温蕾萨·风行者一同前往雷神岛。‡',
  }
},
[32682] = {
  {
    'Herde a terra‡Наследники земли‡Die gute Erde‡대지의 계승‡Heredar la tierra‡‡La bonne terre‡继承土地‡',
    nil,
    'Fale com o Fazendeiro Yoon. Uma‡Поговорите с фермером Юном.‡Sprecht mit Bauer Yoon.‡농부 윤과 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con el granjero Yoon.‡‡Parlez au Fermier Yoon.‡和农夫老愚谈一谈。‡',
  }
},
[32683] = {
  {
    'Quer dizer que você quer ser ferreiro...‡Так ты хочешь быть кузнецом...‡Ihr wollt also Schmied werden…‡대장장이가 되고 싶다면...‡En casa del herrero...‡‡Alors vous voulez apprendre à forger…‡这么说，你想当铁匠……‡',
    nil,
    'Crie uma Chave-mestra Fantasma. Para isso, obtenha pelo menos 500 pontos de habilidade em ferraria. Se você quiser treinar com matéria-prima pandariana, um projeto de treinamento apropriado ao seu nível de habilidade pode ser aprendido com Cullen Martelatesta.‡Создайте призрачную отмычку, достигнув уровня навыка кузнечного дела, равного 500, и принесите эту вещь своему учителю. Если вы хотите совершенствоваться, используя пандаренские материалы, изучите соответствующие вашему уровню учебные чертежи у Куллена Хмуроброва.‡Erschafft einen geisterhaften Dietrich, indem Ihr 500 Fertigkeitspunkte in Schmiedekunst erlangt. Falls Ihr Euch mithilfe von Pandarenmaterialien in der Schmiedekunst üben wollt, könnt Ihr von Cullen Hammerstirn ein Eurer Fertigkeitsstufe angemessenes Ausbildungsprojekt erhalten.‡대장기술 숙련도를 최소 500 달성하여 유령 들린 해골 열쇠를 제작해야 합니다. 판다리아 재료를 써서 훈련하고 싶다면 쿨렌 해머브라우에게서 자기 수준에 맞는 훈련용 과제를 배울 수 있습니다.‡Crea una llave esqueleto fantasmal al llegar al menos al nivel 500 de habilidad en herrería. Si quieres entrenarte con material pandaren, puedes obtener un proyecto de instrucción adecuado a tu nivel de habilidad de Cullen Frentemartillo.‡‡Créez un Passe-partout fantomatique après avoir atteint une compétence de 500 en forge. Si vous souhaitez vous entraîner en utilisant des matériaux pandarens, vous pouvez apprendre un Ouvrage approprié à votre niveau de compétence auprès de Cullen Martel-Front.‡锻造技能达到500点后制作出一把幽冥万能钥匙。如果你想通过熊猫人材料进行训练，可以去找科伦·锤眉学习与你当前技能等级相适应的训练项目。‡',
  }
},
[32684] = {
  {
    'Você quer peixe?‡Хочешь рыбки?‡Ihr wollt Fisch?‡생선 필요하세요?‡¿Quieres pescar?‡‡Vous voulez du poisson ?‡你想钓鱼吗？‡',
    nil,
    'Fale com Ben da Voz Estrondosa. Uma‡Поговорите с Беном Трубноголосым. это‡Sprecht mit Ben mit der dröhnenden Stimme.‡우렁찬 음성의 벤과 대화해야 합니다. 레벨 35‡Habla con Ben Voz Retumbante.‡‡Parlez à Ben de la Voix tonitruante.‡与“大嗓门”班宏交谈。‡',
  }
},
[32685] = {
  {
    'Vara pra quê?!‡Удочка больше не нужна!‡Keine Angelrute erforderlich!‡낚싯대는 필요 없습니다!‡¡No hace falta caña de pescar!‡‡Cannes à pêche inutiles !‡无需钓竿！‡',
    nil,
    'Pesque 5 Carpas Douradas. Tente sem a vara de pescar!Para pescar, apenas clique no ícone de Pesca do painel de Profissões. Preste atenção no flutuador, clique nele quando sacudir e você vai pegar um peixe!‡Поймайте 5 золотистых карпов. Чтобы закинуть удочку, щелкните по значку рыбалки на вкладке профессий. Внимательно наблюдайте за поплавком: щелкните по нему, когда он задергается, и вытащите улов из воды.‡Fangt fünf Goldkarpfen. Versucht es ohne Angelrute!Klickt zum Angeln einfach im Berufefenster auf das Angelsymbol. Achtet auf den Schwimmer, klickt darauf, wenn er zuckt, und schon habt Ihr Euren Fisch!‡황금 잉어를 5마리 잡아야 합니다. 낚싯대 없이 해 보십시오! 낚시를 하려면 전문 기술 창에 있는 낚시 아이콘을 클릭하십시오. 낚시찌를 잘 보다가 찌가 까닥거릴 때 클릭하면 물고기를 잡을 수 있습니다.‡Pesca 5 carpas doradas. ¡Inténtalo sin caña! Para pescar, haz clic en el icono de Pescar del panel de profesiones. Presta atención al corcho, haz clic en él cuando se mueva... ¡y atraparás el pez!‡‡Prenez 5 Carpes dorées. Pas besoin de s’équiper d’une canne à pêche !Pour pêcher, faites glisser l’icône Pêche de la fenêtre Métiers vers votre barre d’actions. Surveillez le bouchon et cliquez dessus quand il s’agite pour sortir votre prise.‡捕捉5条金色鲤鱼。不用装备钓竿，试试看吧！要想钓鱼，只要在专业技能面板上点击钓鱼图标即可。注意浮标，当它跳动时用鼠标点击它，就能收获你钓到的鱼了！‡',
  }
},
[32686] = {
  {
    'Estandarte Impecável do Império Mantídeo‡Безупречное знамя империи богомолов‡Makelloses Banner des Mantisreiches‡온전한 사마귀 제국의 깃발‡Estandarte prístino del Imperio mántide‡‡Bannière de l’empire mantide en parfait état‡完好如初的螳螂妖帝国旗帜‡',
    nil,
    'Colocar o artefato em exibição. Uma‡Выставите артефакт на обозрение.‡Stellt das Artefakt zur Schau.‡유물을 전시해야 합니다. 레벨 10 영원꽃 골짜기‡Expón el artefacto.‡‡Exposez l’artéfact.‡将神器进行展览。‡',
  }
},
[32687] = {
  {
    'Alimentador Impecável de Seiva Antigo‡Безупречный древний сборник сока‡Makelloser uralter Harzspender‡온전한 고대 수액 먹이통‡Alimentador de savia antiguo prístino‡‡Antique nourrisseur de sève en parfait état‡完好如初的古代树脂采集器‡',
