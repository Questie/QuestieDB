[1665] = {
  {
    '‡Кружка Бартлби‡Bartlebys Becher‡바틀비의 술잔‡Jarra de Bartleby‡Jarra de Bartleby‡Tasse de Bartleby‡巴特莱比的酒杯‡巴托比的酒杯',
    nil,
    '‡Отнесите кружку Бартлби Баргарду.‡Bringt Bartlebys Becher zu Burlwacht.‡‡Lleva la jarra de Bartleby a Burlguard.‡Lleva la jarra de Bartleby a Burlguard.‡Apporter la Tasse de Bartleby à Burlguard.‡把巴特莱比的酒杯交给伯加德。‡',
  }
},
[1666] = {
  {
    'Delegado Fadigas‡Маршал Хаггард‡Marschall Haggard‡치안대장 해거드‡El mariscal Haggard‡El mariscal Haggard‡Le maréchal Haggard‡治安官哈迦德‡治安官哈迦德',
    nil,
    'Fale com o Delegado Fadigas.‡Поговорите с маршалом Хаггардом.‡Sprecht mit Marschall Haggard.‡치안대장 해거드와 대화해야 합니다.‡Habla con el mariscal Haggard.‡Habla con el mariscal Haggard.‡Parler au maréchal Haggard.‡和治安官哈迦德谈一谈。‡和治安官哈迦德談話。',
  }
},
[1667] = {
  {
    'Diogo Dente-podre‡Джек Мертвозуб‡Stumpfzahn Jack‡썩은니 잭‡Jack Dentomuerto‡Jack Dentomuerto‡Jack Dent-Morte‡蛀牙杰克‡蛀牙傑克',
    nil,
    'Recupere o Distintivo do Fadigas que está no acampamento de Diogo Dente-podre e fale novamente com o Delegado Fadigas.‡Добыть знак маршала Хаггарда из лагеря Джека Мертвозуба и вернуться к маршалу Хаггарду.‡Holt Marschall Haggards Abzeichen aus Stumpfzahn Jacks Lager und kehrt zu Marschall Haggard zurück.‡썩은니 잭의 야영지에서 치안대장 해거드의 휘장을 찾아가야 합니다.‡Recupera la insignia de Haggar del campamento de Jack Dentomuerto y regresa con el mariscal Haggard.‡Recupera la insignia de Haggar del campamento de Jack Dentomuerto y regresa con el mariscal Haggard.‡Retrouver la Plaque du maréchal Haggard au Camp de Jack Dent-Morte, et la rapporter au maréchal Haggard.‡从蛀牙杰克的营地里取回治安官哈迦德的徽章，把它交给治安官哈迦德。‡從蛀牙傑克的營地裡取回治安官哈迦德的徽章，把它交給治安官哈迦德。',
  }
},
[1678] = {
  {
    'Vejrek‡Веджрек‡Vejrek‡베즈렉‡Vejrek‡Vejrek‡Vejrek‡维吉雷克‡維吉雷克',
    nil,
    'Leve a Cabeça de Vejrek para Muren Lançatroz em Altaforja.‡Принесите голову Веджрека Марену Грозовой Вершине в Стальгорн.‡Bringt Vejreks Kopf zu Muren Sturmlanze in Eisenschmiede.‡베즈렉을 처치하고 그 증거로 그의 머리카락을 아이언포지에 있는 무렌 스톰파이크에게 가져가야 합니다.‡Lleva la Cabeza de Vejrek\'s a Muren Pico Tormenta en Forjaz.‡Lleva la Cabeza de Vejrek a Muren Pico Tormenta en Forjaz.‡Apportez la Tête de Vejrek à Muren Foudrepique à Forgefer.‡将维吉雷克的徽记交给铁炉堡的穆伦·雷矛。‡將維吉雷克的頭顱交給鐵爐堡的穆倫·雷矛。',
  }
},
[1679] = {
  {
    '‡Марен Грозовая Вершина‡Muren Sturmlanze‡무렌 스톰파이크‡Muren Pico Tormenta‡Muren Pico Tormenta‡Muren Foudrepique‡穆伦·雷矛‡穆倫·雷矛',
    nil,
    '‡Поговорите с Мареном Грозовой Вершиной.‡Sprecht mit Muren Sturmlanze.‡‡Habla con Muren Pico Tormenta.‡Habla con Muren Pico Tormenta.‡Parler à Muren Foudrepique.‡和穆伦·雷矛谈一谈。‡',
  }
},
[1680] = {
  {
    '‡Тормус Подземная Кузня‡Tormus Tiefenschmied‡토르무스 딥포지‡Tormus Forjahonda‡Tormus Forjahonda‡Tormus Forge-profonde‡托姆斯·深炉‡托姆斯·深爐',
    nil,
    '‡Поговорите с Тормусом Подземной Кузней.‡Sprecht mit Tormus Tiefenschmied.‡‡Habla con Tormus Forjahonda.‡Habla con Tormus Forjahonda.‡Parler à Tormus Forge-profonde.‡和托姆斯·深炉谈一谈。‡',
  }
},
[1681] = {
  {
    'Complexo do Bandaferro‡Мастерская Сталекрута‡Eisenbands Truppenlager‡아이언밴드 야영지‡Complejo Vetaferro‡Complejo Vetaferro‡Base de Baguefer‡铁环营地‡鐵環營地',
    nil,
    'Leve um pouco de Minério Umbrático para Tormus Baixaforja em Altaforja.‡Принесите мрачную руду Тормусу Подземной Кузне в Стальгорн.‡Bringt eine Ladung Umbralerz zu Tormus Tiefenschmied in Eisenschmiede.‡아이언포지에 있는 토르무스 딥포지에게 암영 광석을 가져가야 합니다.‡Lleva un cargamento de mena umbría a Tormus Forjahonda en Forjaz.‡Lleva una pieza de mena umbría a Tormus Forjahonda en Forjaz.‡Rapporter du Minerai umbral à Tormus Forge-profonde à Forgefer.‡把暗影矿石交给铁炉堡的托姆斯·深炉。‡把陰影礦石交給鐵爐堡的托姆斯·深爐。',
  }
},
[1682] = {
  {
    '‡Оружие из серой стали‡Waffen aus grauem Eisen‡‡Armas de hierro gris‡Armas de hierro gris‡Armes en fer gris‡灰铁武器‡',
