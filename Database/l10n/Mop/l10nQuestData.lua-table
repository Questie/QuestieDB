[4120] = {
  {
    'A força da corrupção‡Сила порчи‡Die Kraft der Verderbnis‡타락의 힘‡La fuerza de la corrupción‡La fuerza de la corrupción‡La force de la corruption‡堕落的力量‡腐化的力量',
    nil,
    'Talo Casco de Espinhos da Aldeia Mojache em Feralas quer que você mate 12 Ursos-cinzentos Garraivoso e 12 Assoladores Patavil em Selva Maleva.‡Убейте 12 гризли злобных когтей и 12 опустошителей-сквернолапов в Оскверненном лесу по просьбе Тало Тернового Копыта из лагеря Мохаче.‡Talo Dornhuf im Camp Mojache in Feralas möchte, dass Ihr 12 Wutklauengrizzlys und 12 Teufelspfotenverheerer im Teufelswald erledigt.‡페랄라스의 모자케 야영지에 있는 탈로 쏜후프가 악령숲에 있는 성난발톱불곰 12마리와 갈퀴발톱 악령발늑대 12마리를 처치해 달라고 했습니다.‡Talo Pezuñahendida, del Campamento Mojache de Feralas, quiere que mates a 12 pardos Zarpira y 12 devastadores Zarpayel de Frondavil.‡Talo Pezuñahendida, del Campamento Mojache de Feralas, quiere que mates a 12 pardos Zarpira y 12 devastadores Zarpayel de Frondavil.‡Talo Sabot-de-ronce, du Camp Mojache en Féralas, voudrait que vous tuiez 12 Grizzlys de la griffe colérique et 12 Ravageurs Gangrepatte, à Gangrebois.‡菲拉斯莫沙彻营地的塔罗·刺蹄要你去费伍德森林杀掉12头怒爪灰熊和12头魔爪掠夺者。‡菲拉斯莫沙徹營地的塔羅·刺蹄要你去費伍德森林殺掉12頭怒爪灰熊和12頭魔爪劫毀者。',
  }
},
[4121] = {
  {
    '‡Опасное положение‡Gefährliche Zwickmühle‡‡¡Estás en un aprieto!‡¡Estás en un aprieto!‡Situation précaire‡押送囚徒‡',
    nil,
    '‡Отконвоируйте пленника, Грарка Лорктуба, через Пылающие степи и Черную гору к Тлеющему ущелью.|n|nЛекслорт что-то говорил насчет того, что по другую сторону будут ждать его ребята, которые уведут Грарка в тюрьму.|n|nТакже отдайте Лекслорту ториевые оковы.‡Eskortiert Euren Gefangenen, Grark Lorkrub, durch die Brennende Steppe und durch den Schwarzfels in die Sengende Schlucht.|n|nEuch fällt ein, dass Lexlort gesagt hat, seine Männer würden auf der anderen Seite warten, um Grark in Gewahrsam zu nehmen.|n|nIhr werdet außerdem Eure Thoriumfesseln an Lexlort übergeben müssen.‡‡Escolta al prisionero, Grark Lorkrub, a través de Las Estepas Ardientes y la Montaña Roca Negra hasta La Garganta de Fuego.|n|nRecuerdas que Lexlort mencionó que tendría a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.|n|nTambién tendrás que entregarle a Lexlort los grilletes de torio.‡Escolta al prisionero, Grark Lorkrub, a través de Las Estepas Ardientes y la Montaña Roca Negra hasta La Garganta de Fuego.|n|nRecuerdas que Lexlort mencionó que tendría a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.|n|nTambién tendrás que entregarle a Lexlort los grilletes de torio.‡Escortez votre prisonnier, Grark Lorkrub, au-delà des Steppes ardentes et du mont Rochenoire, jusqu\'à la gorge des Vents brûlants.|n|nRappelez-vous que Lexlort a précisé que ses hommes attendraient de l\'autre côté pour arrêter Grark.|n|nOn vous demandera également de remettre vos chaînes en thorium à Lexlort.‡押送你的囚犯格拉克·洛克鲁布。穿过燃烧平原和黑石山脉，一直走到灼热峡谷。|n|n雷克斯洛特曾经告诉过你，他会让他的人等在黑石山脉的另外一边准备接收格拉克。|n|n另外，你还要把瑟银镣铐一并还给雷克斯洛特。‡',
  }
},
[4122] = {
  {
    '‡‡Grark Lorkrub‡‡‡‡Grark Lorkrub‡格拉克·洛克鲁布‡格拉克·洛克魯布',
    nil,
    '‡Отправьтесь в Пылающие степи и найдите Грарка Лоркруба. Лекслорт упоминал, что в последний раз предателя видели в крепости Черной горы. |n|nПо обнаружении Грарка Лоркруба закуйте его в ториевые оковы и затем доставьте его от Черной горы к Тлеющему ущелью, Лекслорт и его подчиненные займутся допросом преступника.‡Begebt Euch in die Brennende Steppe und sucht Grark Lorkrub. Ihr erinnert Euch, dass Lexlort gesagt hat, er sei zuletzt in einer großen Festung des Schwarzfelsklans gesehen worden.|n|nWenn Ihr Grark Lorkrub gefunden habt, verwendet die Thoriumfesseln, um ihn zu binden, und bringt ihn dann über den Schwarzfels in die Sengende Schlucht zurück. Lexlorts Männer werden auf der anderen Seite warten, um Grark in Gewahrsam zu nehmen.‡‡Ve a Las Estepas Ardientes y encuentra a Grark Lorkrub. Recuerdas que Lexlort mencionó que lo habían visto por última vez en una colosal fortaleza Roca Negra.|n|nCuando encuentres a Grark Lorkrub, usa los grilletes de torio para atarlo y condúcelo de vuelta por la Montaña Roca Negra hasta La Garganta de Fuego. Lexlort tendrá a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.|n‡Ve a Las Estepas Ardientes y encuentra a Grark Lorkrub. Recuerdas que Lexlort mencionó que lo habían visto por última vez en una colosal fortaleza Roca Negra.|n|nCuando encuentres a Grark Lorkrub, usa los grilletes de torio para atarlo y condúcelo de vuelta por la Montaña Roca Negra hasta La Garganta de Fuego. Lexlort tendrá a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.|n‡Partez pour les Steppes Ardentes et trouvez Grark Lorkrub. Lexlort vous a dit qu\'il a été vu pour la dernière fois dans une imposante forteresse des Rochenoires.|n|nUne fois que vous aurez trouvé Grark Lorkrub, enchaînez-le avec les Chaînes en thorium, puis ramenez-le par le mont Rochenoire jusque dans la gorge des Vents brûlants. Des hommes de Lexlort attendront de l\'autre côté et le mettront sous bonne garde.‡到燃烧平原去找到格拉克·洛克鲁布。你回忆起雷克斯洛特曾经提起过，格拉克应该是在一座大型的黑石要塞中。|n|n当你找到格拉克·洛克鲁布之后，用瑟银镣铐把他铐起来，然后将其带回灼热峡谷。雷克斯洛特会让他的部下等在那里接应你。‡到燃燒平原去找到格拉克·洛克魯布。你回憶起雷克斯洛特曾經提起過，格拉克應該是在一座大型的黑石要塞中。|n|n當你找到格拉克·洛克魯布之後，用瑟銀鐐銬把他銬起來，然後將其帶回灼熱峽谷。雷克斯洛特會讓他的部下等在那裡接應你。',
  }
},
[4123] = {
  {
    'O Coração da Montanha‡Сердце горы‡Das Herz des Berges‡산의 정수‡El corazón de la montaña‡El corazón de la montaña‡Le Cœur de la montagne‡山脉之心‡山脈之心',
    nil,
    'Leve o Coração da Montanha para Maxwort Uberraio nas Estepes Ardentes.‡Принесите сердце горы Максворту Суперблеску в Пылающие степи.‡Bringt das \'Herz des Berges\' zu Maxwort Funkelglanz in der Brennenden Steppe.‡불타는 평원에 있는 맥스워트 우버글린트에게 산의 정수를 가져가야 합니다.‡Llévale el corazón de la montaña a Maxwort Suprandor en Las Estepas Ardientes.‡Llévale el corazón de la montaña a Maxwort Suprandor en Las Estepas Ardientes.‡Apportez le Cœur de la montagne à Maxwort Uberbrille dans les Steppes Ardentes.‡把山脉之心交给燃烧平原的麦克斯沃特·尤博格林。‡把山脈之心交給燃燒平原的麥克斯沃特·尤柏格林。',
  }
},
[4124] = {
  {
    '‡Пропавший курьер‡Der vermisste Kurier‡실종된 안내원‡El mensajero desaparecido‡El mensajero desaparecido‡Le messager disparu‡失踪的信使‡',
    nil,
    '‡Поговорите с Гинро Пылающим Очагом в Крепости Оперенной Луны.‡Sprecht mit Ginro Herdfeuer in der Mondfederfeste.‡페더문 요새에 있는 긴로 하트킨들과 대화해야 합니다.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Parler à Ginro Attisâtre dans le bastion de Pennelune.‡和羽月要塞的基恩诺·火花谈一谈。‡',
  }
},
[4125] = {
  {
    'Perdido no fluxo postal‡Пропавший курьер‡Der vermisste Kurier‡실종된 안내원‡El mensajero desaparecido‡El mensajero desaparecido‡Le messager disparu‡失踪的信使‡失蹤的信差',
    nil,
    'Encontre o barco do mensageiro em algum lugar da costa de Feralas.‡Отыщите лодку курьера, которая должна находиться где-то на побережье Фераласа.‡Sucht das Boot des Kuriers irgendwo entlang der Küste von Feralas.‡페랄라스 해안에서 안내원의 배를 찾아야 합니다.‡Localiza el bote del mensajero por la costa de Feralas.‡Localiza el bote del mensajero por la costa de Feralas.‡Localiser le bateau du messager quelque part le long de la côte de Féralas.‡找到信使的小船，你应该在菲拉斯的南部海岸线上展开搜索。‡找到信差的小船，你應該在菲拉斯的南部海岸線上展開搜索。',
  }
},
[4126] = {
  {
    'Hurley Bafonegro‡Харли Чернопых‡Hurley Pestatem‡헐레이 블랙브레스‡Hurley Negrálito‡Hurley Negrálito‡Hurley Soufflenoir‡霍尔雷·黑须‡霍爾雷·黑鬚',
    nil,
    'Leve a Receita Perdida de Cervaforte para Ragnar Cervaforte em Kharanos.‡Найдите украденный рецепт громоварского и верните его Рагнару Громовару в Каранос.‡Bringt Ragnar Donnerbräu in Kharanos das verlorene Donnerbräurezept.‡카라노스에 있는 라그나르 썬더브루에게 잃어버린 썬더브루 제조법을 가져가야 합니다.‡Llévale la receta de Cebatruenos perdida a Ragnar Cebatruenos en Kharanos.‡Llévale la receta de Cebatruenos perdida a Ragnar Cebatruenos en Kharanos.‡Apportez la Recette perdue de la Tonnebière à Ragnar Tonnebière, à Kharanos.‡把遗失的雷酒秘方带给卡拉诺斯的拉格纳·雷酒。‡把遺失的雷酒秘方帶給卡拉諾斯的拉格納·雷酒。',
  }
},
[4127] = {
  {
    '‡Разбитая лодка‡Havarie‡‡Los restos del bote‡Los restos del bote‡Débris de bateau‡船只的残骸‡',
    nil,
    '‡Вернитесь в Крепость Оперенной Луны и покажите Гинро Пылающему Очагу выброшенный нож, который вы нашли.‡Kehrt zur Mondfederfeste zurück und zeigt Ginro Herdfeuer das gefundene Messer.‡‡Vuelve al Bastión Plumaluna y enseña a Ginro Mechogar el cuchillo perdido que encontraste.‡Vuelve al Bastión Plumaluna y enseña a Ginro Mechogar el cuchillo perdido que encontraste.‡Retourner au bastion de Pennelune et montrer à Ginro Attisâtre le Couteau perdu que vous avez découvert.‡回到羽月要塞，给基恩诺·火花看看你找到的这把被丢弃的小刀。‡',
  }
},
[4128] = {
  {
    'Ragnar Cervaforte‡Рагнар Громовар‡Ragnar Donnerbräu‡라그나르 썬더브루‡Ragnar Cebatruenos‡Ragnar Cebatruenos‡Ragnar Tonnebière‡拉格纳·雷酒‡拉格納·雷酒',
    nil,
    'Fale com Ragnar Cervaforte.‡Переговорите с Рагнаром Громоваром.‡Sprecht mit Ragnar Donnerbräu.‡라그나르 썬더브루와 대화해야 합니다.‡Habla con Ragnar Cebatruenos.‡Habla con Ragnar Cebatruenos.‡Parler à Ragnar Tonnebière.‡和拉格纳·雷酒谈一谈。‡和拉格納·雷酒談談。',
  }
},
[4129] = {
  {
    '‡Тайна ножа‡Das wieder aufgetauchte Messer‡‡La revelación del cuchillo‡La revelación del cuchillo‡Le couteau révélé‡奎恩提斯的技艺‡',
    nil,
    '‡Отнесите выброшенный нож к друиду по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Bringt Quintis Lebenshand in der Mondfederfeste das gefundene Messer.‡‡Lleva el cuchillo perdido a Quintis Jonguja al Bastión Plumaluna.‡Lleva el cuchillo perdido a Quintis Jonguja al Bastión Plumaluna.‡Apporter le Couteau perdu à Quintis Gentecime au bastion de Pennelune.‡把被丢弃的小刀交给羽月要塞的奎恩提斯。‡',
  }
},
[4130] = {
  {
    '‡Сверхзнание‡Psychometrie-Sitzung‡‡Lectura psicométrica‡Lectura psicométrica‡La lecture psychométrique‡心灵占卜术‡',
    nil,
    '‡Поговорите с Гинро Пылающим Очагом в Крепости Оперенной Луны.‡Sprecht mit Ginro Herdfeuer in der Mondfederfeste.‡페더문 요새에 있는 긴로 하트킨들과 대화해야 합니다.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Parler à Ginro Attisâtre dans le bastion de Pennelune.‡和羽月要塞的基恩诺·火花谈一谈。‡',
  }
},
[4131] = {
  {
    'Gnolls Patábua‡Гноллы из стаи Древолапов‡Die Waldpfotengnolle‡덩굴발 놀‡Los gnolls Zarpaleña‡Los gnolls Zarpaleña‡Les gnolls griffebois‡木爪豺狼人‡木爪豺狼人',
    nil,
    'Procure os acampamentos dos Gnolls Patábua ao sul de Feralas para obter pistas dos pertences do mensageiro ou dele próprio.‡Обыщите лагеря Древолапов в южном Фераласе в поисках вещей курьера либо самого курьера.‡Durchsucht die Lager der Waldpfotengnolle im Süden von Feralas nach Hinweisen auf den Verbleib des Kuriers oder seiner Habseligkeiten.‡페랄라스 남부에 있는 덩굴발 놀 야영지를 수색해 안내원이나 그의 소지품에 대한 증거를 찾아야 합니다.‡Busca el rastro del mensajero o sus pertenencias en los campamentos de los gnoll Zarpaleña del sur de Feralas.‡Busca el rastro del mensajero o sus pertenencias en los campamentos de los gnoll Zarpaleña del sur de Feralas.‡Fouillez les Camps des gnolls griffebois dans la partie sud de Féralas pour trouver des indices sur les possessions du messager ou sur le messager lui-même.‡在菲拉斯南部地区的木爪豺狼人营地里寻找信使的下落或者信使的物品。‡在菲拉斯南部地區的木爪豺狼人營地裡尋找信差的下落或者信差的物品。',
  }
},
[4132] = {
  {
    '‡Операция:смерть Кузне Гнева‡Operation: Tod dem Zornesschmied‡‡Operación: muerte a Forjainquina‡Operación: muerte a Forjainquina‡Opération : Mort à Forgehargne‡行动：杀死安格弗将军‡',
    nil,
    '‡Отправляйтесь в Глубины Черной горы и убейте генерала Кузню Гнева. Вернитесь к полководцу Клинозубу по выполнении задания.‡Begebt Euch zu den Schwarzfelstiefen und eliminiert General Zornesschmied! Kehrt zum Kriegsherrn Bluthauer zurück, sobald Ihr diese Aufgabe erledigt habt.‡‡Viaja hasta las Profundidades de Roca Negra ¡y mata al general Forjainquina! Vuelve junto al señor de la guerra Dientegore cuando hayas acabado la tarea.‡Viaja hasta las Profundidades de Roca Negra ¡y mata al general Forjainquina! Vuelve junto al señor de la guerra Dientegore cuando hayas acabado la tarea.‡Voyagez jusqu\'aux Profondeurs de Rochenoire et tuez le général Forgehargne ! Une fois votre mission accomplie, retournez voir le seigneur de guerre Sangredent.‡到黑石深渊去杀掉安格弗将军！当任务完成之后向军官高图斯复命。‡',
  }
},
[4133] = {
  {
    'Vivian Latumba‡Вивиана Лягроб‡Vivian Lagrave‡비비안 라그레이브‡Vivian Lagrave‡Vivian Lagrave‡Vivian Lagrave‡薇薇安·拉格雷‡薇薇安·拉格雷',
    nil,
    'Fale com a Mestra Sombria Vivian Latumba em Karrath.‡Переговорите с тенемагом Вивиан Лаграв в Каргате.‡Sprecht mit Schattenmeisterin Vivian Lagrave in Kargath.‡카르가스에 있는 비비안 라그레이브와 대화해야 합니다.‡Habla con la taumaturgo oscuro Vivian Lagrave en Kargath.‡Habla con la taumaturgo oscuro Vivian Lagrave en Kargath.‡Parler à la maîtresse des ombres Vivian Lagrave à Kargath.‡与卡加斯的暗法师薇薇安·拉格雷谈一谈。‡與卡加斯的暗影大師薇薇安·拉格雷談話。',
  }
},
[4134] = {
  {
    'Receita Perdida de Cervaforte‡Украденный рецепт громоварского‡Verlorenes Donnerbräurezept‡잃어버린 썬더브루 제조법‡La receta de Cebatruenos perdida‡La receta de Cebatruenos perdida‡La recette perdue de la Tonnebière‡遗失的雷酒秘方‡遺失的雷酒秘方',
    nil,
    'Leve a Receita Perdida de Cervaforte para Vivian Latumba em Karrath.‡Принесите рецепт громоварского светлого Вивиан Лягроб в Каргат.‡Bringt Vivian Lagrave in Kargath das verlorene Donnerbräurezept.‡카르가스에 있는 비비안 라그레이브에게 잃어버린 썬더브루 제조법을 가져가야 합니다.‡Llévale la receta de Cebatruenos perdida a Vivian Lagrave en Kargath.‡Llévale la receta de Cebatruenos perdida a Vivian Lagrave en Kargath.‡Apportez la Recette perdue de la Tonnebière à Vivian Lagrave à Kargath.‡把遗失的雷酒秘方交给卡加斯的薇薇安·拉格雷。‡把遺失的雷酒秘方交給卡加斯的薇薇安·拉格雷。',
  }
},
[4135] = {
  {
    '‡Гудящая Бездна‡Die Gewundene Tiefe‡고통의 구덩이‡Las Galerías Retorcidas‡Las Galerías Retorcidas‡Le gouffre Grouillant‡痛苦深渊‡痛苦深淵',
    nil,
    '‡Продолжайте поиски Раскала (или его останков) в Гудящей Бездне. Согласно записке, Гудящая Бездна находится к югу от лагерей стаи Древолапов.‡Da Ihr jetzt Raschals letzten bekannten Aufenthaltsort in Erfahrung gebracht habt, setzt Ihr die Suche nach ihm oder seinen sterblichen Überresten in der Gewundenen Tiefe fort. Laut Notiz soll dieser Ort südlich der Lager der Waldpfotengnolle liegen.‡‡Ahora que has descubierto el rastro de Raschal, adéntrate en Las Galerías Retorcidas y encuéntrale... o encuentra lo que quede de él. Según la nota, debes dirigirte al sur de los campamentos de los Zarpaleña.‡Ahora que has descubierto el rastro de Raschal, adéntrate en Las Galerías Retorcidas y encuéntrale... o encuentra lo que quede de él. Según la nota, debes dirigirte al sur de los campamentos de los Zarpaleña.‡À présent que la dernière destination connue de Raschal est découverte, continuez à le rechercher, lui ou ses restes, dans le gouffre Grouillant. D\'après le message, il se trouve au sud des camps des gnolls griffebois.‡现在你已经知道了拉斯卡尔的去向，那么你最好到痛苦深渊去寻找他，或者至少是他的尸体。根据便笺上的信息，那个地方应该在木爪豺狼人营地的南边。‡',
  }
},
[4136] = {
  {
    'Ribas Parafuseta‡Риббли Крутипроб‡Ribbly Schraubstutz‡리블리 스크류스피곳‡Ribbly Llavenrosca‡Ribbly Llavenrosca‡Ribbly Fermevanne‡雷布里·斯库比格特‡雷布里·斯庫比格特',
    nil,
    'Leve a Cabeça do Ribas para Yuka Parafuseta nas Estepes Ardentes.‡Принесите голову Риббли Юке Крутипроб в Пылающие степи.‡Bringt Yuka Schraubstutz in der Brennenden Steppe Ribblys Kopf.‡리블리를 처치하고 그 증거로 그의 머리카락을 불타는 평원에 있는 유카 스크류스피곳에게 가져가야 합니다.‡Llévale la cabeza de Ribbly a Yuka Llavenrosca en Las Estepas Ardientes.‡Llévale la cabeza de Ribbly a Yuka Llavenrosca en Las Estepas Ardientes.‡Apportez la Tête de Ribbly à Yuka Fermevanne, dans les Steppes Ardentes.‡把雷布里的徽记交给燃烧平原的尤卡·斯库比格特。‡把雷布里的頭顱交給燃燒平原的尤卡·斯庫比格特。',
  }
},
[4141] = {
  {
    'Melco e Lário‡Муиджин и Ларион‡Muigin und Larion‡무이긴과 라리온‡Muigin y Larion‡Muigin y Larion‡Muigin et Larion‡穆尔金和拉瑞安‡莫爾金和拉里安',
    nil,
    'Colha 15 Pétalas Sangrentas e fale novamente com Melco.‡Соберите 15 кровоцветов и принесите их Муиджину.‡Sammelt 15 Blutblüten und kehrt zu Muigin zurück.‡붉은꽃잎 15개를 모아 무이긴에게 가야 합니다.‡Recoge 15 pétalos de sangre y ve a ver a Muigin.‡Recoge 15 Sangrepétalos y ve a ver a Muigin.‡Récolter 15 Pétales-de-sang et retourner voir Muigin.‡从安戈洛尔环形山的血瓣花猛击者和血瓣花掠夺者身上收集15个血瓣花，然后向穆尔金回复。‡收集15朵血瓣花，然後回覆給莫爾金。',
  }
},
[4142] = {
  {
    'Uma visita a Gregan‡Визит к Грегану‡Ein Besuch bei Gregan‡그레간 방문‡Visita a Gregan‡Visita a Gregan‡Visite à Gregan‡造访格雷甘‡造訪格雷甘',
    nil,
    'Leve uma Pétala Sangrenta para Gregan Cospechope em Feralas.‡Отнесите кровоцвет Грегану Пивоплюю в Фералас.‡Bringt Gregan Hopfenspei in Feralas eine Blutblüte.‡페랄라스에 있는 그레간 브루스퓨워에게 붉은꽃잎을 가져가야 합니다.‡Llévale un Sangrepétalo a Gregan Tirabirras de Feralas.‡Llévale un Sangrepétalo a Gregan Tirabirras de Feralas.‡Apporter un Pétale-de-sang à Gregan Gerbebière en Féralas.‡把血瓣花交给菲拉斯的格雷甘·山酒。‡把血瓣花交給菲拉斯的格雷甘·山酒。',
  }
},
[4143] = {
  {
    'Brumas do mal‡Туман зла‡Der Dunst des Bösen‡악의 아지랑이‡Bruma del mal‡Bruma del mal‡Brouillard maléfique‡邪恶之雾‡邪惡之霧',
    nil,
    'Colha 5 amostras de Bruma de Atal\'ai, depois fale novamente com Melco na Cratera Un\'Goro.‡Соберите 5 образцов тумана Аталаи и принесите их Муиджину в Кратер Ун\'Горо.‡Sammelt 5 Proben Dunst der Atal\'ai und bringt sie Muigin im Krater von Un\'Goro.‡아탈라이 아지랑이 5개를 모은 후 운고로 분화구에 있는 무이긴에게 가야 합니다.‡Reúne 5 muestras de calima Atal\'ai y después ve a ver de nuevo a Muigin al Cráter de Un\'Goro.‡Reúne 5 muestras de calima Atal\'ai y después ve a ver de nuevo a Muigin al Cráter de Un\'Goro.‡Récupérez 5 Échantillons de brume atal\'ai puis retournez voir Muigin dans le cratère d\'Un\'Goro.‡收集5份阿塔莱之雾的样本，然后向安戈洛环形山的穆尔金复命。‡收集5份阿塔萊之霧的樣本，然後向安戈洛環形山的莫爾金覆命。',
  }
},
[4144] = {
  {
    '‡Побеги кровоцвета‡Blutblütensprösslinge‡‡Brotes Sangrepétalo‡Brotes Sangrepétalo‡Les pousses de Pétales-de-sang‡血瓣花苗‡',
    nil,
    nil,
  }
},
[4145] = {
  {
    'Lário e Melco‡Ларион и Муиджин‡Larion und Muigin‡라리온과 무이긴‡Larion y Muigin‡Larion y Muigin‡Larion et Muigin‡拉瑞安和穆尔金‡拉里安和莫爾金',
    nil,
    'Cace 5 Açoitadeiras Pétala Sangrenta, 5 Látegas Pétala Sangrenta, 5 Esfoladoras Pétala Sangrenta e 5 Laçadoras Pétala Sangrenta para Lário, do Refúgio do Marshal.‡Уничтожьте 5 кровоцветов-хлестунов, 5 кровоцветов-крепкозубов, 5 кровоцветов-живодеров и 5 кровоцветов-звероловов по просьбе Лариона из Укрытия Маршалла.‡Jagt 5 Blutblütenpeitscher, 5 Blutblütendrescher, 5 Blutblütenschinder und 5 Blutblütenfallen für Larion in Marschalls Zuflucht.‡마샬의 야영지에 있는 라리온이 채찍줄기 붉은꽃잎덩굴손 5마리, 덩이줄기 붉은꽃잎덩굴손 5마리, 칼날가시 붉은꽃잎덩굴손 5마리, 질긴뿌리 붉은꽃잎덩굴손 5마리를 처치해 달라고 했습니다.‡Caza 5 azotadores Sangrepétalo, 5 trilladores Sangrepétalo, 5 desolladores Sangrepétalo y 5 tramperos Sangrepétalo para Larion en el Refugio de Marshal.‡Caza 5 azotadores Sangrepétalo, 5 trilladores Sangrepétalo, 5 desolladores Sangrepétalo y 5 tramperos Sangrepétalo para Larion en el Refugio de Marshal.‡Chasser 5 Flagellants Pétale-de-sang, 5 Batteurs Pétale-de-sang, 5 Ecorcheurs Pétale-de-sang et 5 Trappeurs Pétale-de-sang pour Larion au refuge des Marshal.‡为马绍尔营地里的拉瑞安杀掉5个血瓣花鞭笞者、5个血瓣花捕兽者、5个血瓣花掠夺者和5个血瓣花猛击者。‡為馬紹爾營地裡的拉里安殺掉5個血瓣花鞭笞者、5個血瓣花痛擊者、5個血瓣花撕掠者和5個血瓣花陷捕者。',
  }
},
[4146] = {
  {
    'Combustível de fulminadora‡Питание для шокера‡Treibstoff für die Unkrautvernichtung‡구제장치 연료‡Combustible de irradior‡Combustible de irradior‡Carburant de baguette‡除草器的燃料‡除草器的燃料',
    nil,
    'Entregue a Fulminadora Descarregada e 5 amostras de Bruma de Atal\'ai a Lário, no Refúgio do Marshal.‡Доставьте незаряженный шокер и 5 образцов тумана Аталаи Лариону в Укрытие Маршалла.‡Bringt Larion in Marschalls Zuflucht den ungeladenen Unkrautvernichter und 5 Proben Dunst der Atal\'ai.‡마샬의 야영지에 있는 라리온에게 충전 안된 구제장치와 아탈라이 아지랑이 5개를 가져가야 합니다.‡Entrega el Controlador descargado y 5 muestras de calima Atal\'ai a Larion, en el Refugio de Marshal.‡Entrega el Controlador descargado y 5 muestras de calima Atal\'ai a Larion, en el Refugio de Marshal.‡Remettre la Baguette déchargée et 5 Échantillons de brume atal\'ai à Larion au refuge des Marshal.‡收集5份阿塔莱之雾的样本，然后将它们送到马绍尔营地的拉瑞安那里。‡收集5份阿塔萊之霧的樣本，然後將它們送到馬紹爾營地的拉里安那裡。',
  }
},
[4147] = {
  {
    'Oficina do Marlon‡Мастерская Марвона‡Marvons Werkstatt‡마본의 작업장‡El taller de Marvon‡El taller de Marvon‡Atelier de Marvon‡玛尔冯的车间‡瑪爾馮的工坊',
    nil,
    'Vá até a oficina de Marlon Catarrebite na Vila Catraca.‡Отправьтесь к Марвону Клепальщику в его мастерскую в Кабестане.‡Reist zu Marvon Nietensuchers Werkstatt in Ratschet.‡톱니항에 있는 마본 리벳시커의 작업장으로 가야 합니다.‡Viaja hasta el taller de Marvon Buscarroblones en Trinquete.‡Viaja hasta el taller de Marvon Buscarroblones en Trinquete.‡Se rendre à l\'Atelier de Marvon Chercherivet à Cabestan.‡到棘齿城去，在玛尔冯·瑞文斯克的车间里找到他。‡到棘齒城去，在瑪爾馮·瑞文斯克的工坊裡找到他。',
  }
},
[4148] = {
  {
    '‡Антикровоцветный шокер‡Blutblütenvernichter‡붉은꽃잎덩굴손 구제장치‡Liquidador de sangrepétalos‡Liquidador de sangrepétalos‡Baguette Pétale-de-sang‡血瓣花除草器‡血瓣花除草器',
    nil,
    nil,
  }
},
[4161] = {
  {
    'Receita dos Kaldorei‡Калдорайский рецепт‡Rezept der Kaldorei‡칼도레이 조리법‡La receta de los kaldorei‡La receta de los kaldorei‡Une recette kaldorei‡卡多雷的菜谱‡卡多雷的食譜',
    nil,
    'Collect 7 Small Spider Legs.‡Принесите 7 маленьких паучьих лапок.‡Sammelt 7 kleine Spinnenbeine.‡작은 거미 다리 7개를 모아야 합니다.‡Collect 7 Small Spider Legs.‡Collect 7 Small Spider Legs.‡Collectez 7 Petites pattes d\'araignée.‡为多兰纳尔的扎瑞恩收集7条小蜘蛛腿。‡收集7條小蜘蛛腿。',
  }
},
[4181] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr mehr über die Gobliningenieurskunst wissen wollt, dann bringt das Handbuch der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Apporter le Manuel d\'ingénierie à Nixx Elastirouage à Gadgetzan si vous souhaitez en apprendre davantage sur l\'ingénierie gobeline.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想要對哥布林工程學有更多瞭解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
[4182] = {
  {
    '‡Драконья угроза‡Drachkin-Bedrohung‡‡La amenaza de los dragonantes‡La amenaza de los dragonantes‡La menace des draconiens‡黑龙的威胁‡',
    nil,
    '‡Убейте 15 детенышей черного дракона, 10 черных драконидов, 4 черных драконид и 1 черного дракона.‡Erschlagt 15 schwarze Brutlinge, 10 Exemplare der schwarzen Großdrachenbrut, 4 schwarze Wyrmkin und 1 Schwarzdrachen.‡‡Mata 15 estirpes negras, 10 dragauros negros, 4 vermintes negros y 1 draco negro.‡Mata 15 estirpes negras, 10 dragauros negros, 4 vermintes negros y 1 draco negro.‡Tuer 15 Rejetons noirs, 10 Draconides noirs, 4 Wyrmides noirs et 1 Drake noir.‡杀掉15条黑色小龙、10条黑色龙人、4条黑色龙族和1条黑色幼龙。‡',
  }
},
[4183] = {
  {
    '‡Подлинные хозяева‡Die wahren Meister‡‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡',
    nil,
    '‡Отправьтесь в Приозерье, что в Красногорье, и доставьте письмо Хелендиса Речного Мыса мировому судье Соломону.‡Reist nach Seenhain im Rotkammgebirge und händigt Magistrat Solomon Helendis Flusshorns Brief aus.‡‡Viaja a Villa del Lago, en las Montañas Crestagrana, y entrégale la carta de Helendis Rivacuerno al magistrado Solomon.‡Viaja a Villa del Lago, en las Montañas Crestagrana, y entrégale la carta de Helendis Rivacuerno al magistrado Solomon.‡Voyager jusqu\'à Comté-du-Lac, dans les Carmines et remettre la Lettre d\'Helendis Ruissecorne au Magistrat Salomon.‡把赫林迪斯·河角的信交给湖畔镇的所罗门镇长。‡',
  }
},
[4184] = {
  {
    '‡Подлинные хозяева‡Die wahren Meister‡‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡',
    nil,
    '‡Передайте обращение Соломона королю Вариану Ринну.|n|nКороль Ринн пребывает в Крепости Штормграда.‡Reist nach Sturmwind und tragt Solomons Hilfegesuch dem König Varian Wrynn vor.|n|nDer König residiert in Burg Sturmwind.‡‡Ve a Ventormenta para entregar la petición de ayuda de Solomon al rey Varian Wrynn. |n|nVive en el Castillo de Ventormenta.‡Ve a Ventormenta para entregar la petición de ayuda de Solomon al rey Varian Wrynn. |n|nVive en el Castillo de Ventormenta.‡Voyager jusqu\'à Hurlevent et remettre la Demande d\'aide de Salomon au roi Varian Wrynn.|n|nLe roi demeure au Donjon de Hurlevent.‡到暴风城去把所罗门的求援信交给伯瓦尔·弗塔根公爵。|n|n伯瓦尔在暴风要塞里。‡',
  }
},
[4185] = {
  {
    '‡Подлинные хозяева‡Die wahren Meister‡‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡',
    nil,
    '‡Поговорите с Верховным лордом Болваром Фордрагоном после беседы с леди Катраной Престор.‡Sprecht zuerst mit Lady Katrana Prestor, dann mit Hochlord Bolvar Fordragon.‡‡Habla con el alto señor Bolvar Fordragón después de hablar con Lady Katrana Prestor.‡Habla con el alto señor Bolvar Fordragón después de hablar con Lady Katrana Prestor.‡Parler au généralissime Bolvar Fordragon après avoir parlé à dame Katrana Prestor.‡与女伯爵卡特拉娜·普瑞斯托谈话，然后再与伯瓦尔·弗塔根公爵谈话。‡',
  }
},
[4186] = {
  {
    '‡Подлинные хозяева‡Die wahren Meister‡‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡',
    nil,
    '‡Отнесите указ Ринна мировому судье Соломону в Приозерье.‡Händigt Wrynns Erlass an Magistrat Solomon in Seenhain aus.‡‡Lleva el decreto de Wrynn al magistrado Solomon en la Villa del Lago.|n‡Lleva el decreto de Wrynn al magistrado Solomon en la Villa del Lago.|n‡Apporter le Décret de Wrynn au Magistrat Salomon à Comté-du-Lac.‡把伯瓦尔的命令交给湖畔镇的所罗门镇长。‡',
  }
},
[4201] = {
  {
    'A poção do amor‡Приворотное зелье‡Der Liebestrank‡사랑의 묘약‡La poción de enamoramiento‡La poción de enamoramiento‡Le philtre d\'amour‡爱情药水‡愛情藥水',
    nil,
    'Leve 4 Sangues-de-grom, 10 Veios de Prata Gigantes e a Ampola da Nagmara Cheia para a Lady Nagmara no Abismo Rocha Negra.‡Принесите 4 листа крови Грома, 10 огромных серебряных слитков и наполненный сосуд Нагмары госпоже Нагмаре в Глубины Черной горы.‡Bringt 4 Gromsblut-Kräuter, 10 Riesensilbervenen und Nagmaras gefüllte Phiole zu Herrin Nagmara in den Schwarzfelstiefen.‡검은바위 나락에 있는 지배인 나그마라에게 그롬의 피 4개, 거대한 은 광석 10개, 가득 찬 나그마라의 약병을 가져가야 합니다.‡Llévale 4 gromsanguinas, 10 venas de plata gigantescas y el vial lleno de Nagmara a la coima Nagmara en las Profundidades de Roca Negra.‡Llévale 4 gromsanguinas, 10 venas de plata gigantescas y el vial lleno de Nagmara a la coima Nagmara en las Profundidades de Roca Negra.‡Apporter 4 Gromsang, 10 Veines d\'argent de géant et la Fiole de Nagmara remplie à la gouvernante Nagmara dans les Profondeurs de Rochenoire.‡将4份格罗姆之血、10块巨型银矿和装满水的娜玛拉之瓶交给黑石深渊的娜玛拉小姐。‡將4份格羅姆之血、10塊巨型銀礦和裝滿水的娜瑪拉之瓶交給黑石深淵的娜瑪拉小姐。',
  }
},
[4221] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[4222] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[4223] = {
  {
    '‡Подлинные хозяева‡Die wahren Meister‡‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡',
    nil,
    '‡Поговорите с маршалом Максвеллом в Пылающих степях.‡Sprecht mit Marschall Maxwell in der Brennenden Steppe.‡‡Habla con el mariscal Maxwell en Las Estepas Ardientes.‡Habla con el mariscal Maxwell en Las Estepas Ardientes.‡Parlez au maréchal Maxwell dans les Steppes Ardentes.‡和燃烧平原的麦克斯韦尔元帅谈一谈。‡',
  }
},
[4224] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Speak with Ragged John.‡Поговорите с Джоном-Оборванцем.‡Sprecht mit dem struppigen John.‡털보 존과 대화해야 합니다.‡Habla con John Andrajoso.‡Habla con John Andrajoso.‡Allez voir John le Loqueteux.‡和狼狈不堪的约翰。‡和狼狽不堪的約翰談談。',
  }
},
[4241] = {
  {
    'Marechal Vilasboas‡Маршал Винздор‡Marschall Windsor‡치안대장 윈저‡Mariscal Windsor‡Mariscal Windsor‡Maréchal Windsor‡温德索尔元帅‡溫德索爾元帥',
    nil,
    'Viaje para a Montanha Rocha Negra, a noroeste, e entre no Abismo Rocha Negra. Descubra o que aconteceu com o Marechal Vilasboas.|n|nVocê se lembra de João Roto falando sobre Vilasboas ter sido arrastado para uma prisão.‡Отправляйтесь на Черную гору на северо-западе и войдите в Глубины Черной горы. Узнайте, что сталось с маршалом Виндзором.|n|nКажется, Джон-Оборванец говорил о том, что Виндзора утащили в темницу.‡Reist zum Schwarzfels im Nordwesten und dann weiter zu den Schwarzfelstiefen. Findet heraus, was aus Marschall Windsor geworden ist.|n|nIhr erinnert Euch daran, dass der struppige John sagte, man hätte Windsor in ein Gefängnis verschleppt.‡북서쪽에 있는 검은바위 산으로 가서 검은바위 나락으로 들어가십시오. 치안대장 윈저에게 무슨 일이 있었는지 알아내야 합니다.|n|n털보 존은 윈저가 감옥으로 끌려갔다고 했습니다.‡Viaja a la Montaña Roca Negra al noroeste y adéntrate en las Profundidades de Roca Negra. Averigua qué le ha ocurrido al mariscal Windsor.|n|nRecuerdas que John Andrajoso había comentado que se habían llevado a una cárcel a Windsor.‡Viaja a la Montaña Roca Negra al noroeste y adéntrate en las Profundidades de Roca Negra. Averigua qué le ha ocurrido al mariscal Windsor.|n|nRecuerdas que John Andrajoso había comentado que se habían llevado a una cárcel a Windsor.‡Partir pour le mont Rochenoire au nord-ouest et pénétrer dans les Profondeurs de Rochenoire. Découvrir ce qu\'il est advenu du Maréchal Windsor.|n|nVous vous souvenez que John le Loqueteux a dit que Windsor avait été traîné en prison.‡到西北部的黑石山脉去，在黑石深渊中找到温德索尔元帅的下落。|n|n狼狈不堪的约翰曾告诉你说温德索尔被关进了一个监狱。‡到西北部的黑石山脈去，在黑石深淵中找到溫德索爾元帥的下落。|n|n狼狽不堪的約翰曾告訴你說溫德索爾被關進了一個監獄。',
  }
},
[4242] = {
  {
    '‡Утраченная надежда‡Verlorene Hoffnung‡‡Esperanza perdida‡Esperanza perdida‡Espoir abandonné‡被遗弃的希望‡',
    nil,
    '‡Сообщите маршалу Максвеллу плохие новости. Его можно найти на Дозоре Моргана, что в Пылающих степях.‡Überbringt Marschall Maxwell bei Morgans Wacht in der Brennenden Steppe die schlechten Neuigkeiten.‡‡Dale las malas noticias al mariscal Maxwell en la Vigilia de Morgan, en las Estepas Ardientes.‡Dale las malas noticias al mariscal Maxwell en la Vigilia de Morgan, en las Estepas Ardientes.‡Apportez les mauvaises nouvelles au Maréchal Maxwell à la Veille de Morgan, dans les Steppes Ardentes.‡把这个坏消息传达给麦克斯韦尔元帅。‡',
  }
},
[4243] = {
  {
    'Procura-se A-Me 01‡В поисках Чи-Та 3‡Chasing A-Me 01‡에이미 01 추적‡Buscando a Memo 01‡Buscando a Memo 01‡À la poursuite d\'A-Mi 01‡找回A-Me 01‡找回艾米 01',
    nil,
    'Encontre A-Me 01 na Cratera Un\'Goro.‡Найдите Чи-Та 3 в Кратере Ун\'Горо.‡Sucht im Krater von Un\'Goro nach A-Me 01.‡운고로 분화구에서 에이미 01을 찾아야 합니다.‡Encuentra a Memo 01 en el Cráter de Un\'Goro.‡Encuentra a Memo 01 en el Cráter de Un\'Goro.‡Trouvez A-Mi 01 dans le Cratère d\'Un\'Goro.‡在安戈洛环形山找到A-Me 01。‡在安戈洛環形山找到艾米 01。',
  }
},
[4244] = {
  {
    'Procura-se A-Me 01‡В поисках Чи-Та 3‡Chasing A-Me 01‡에이미 01 추적‡Buscando a Memo 01‡Buscando a Memo 01‡À la poursuite d\'A-Mi 01‡找回A-Me 01‡找回艾米 01',
    nil,
    'Encontre uma Carcaça de Mithril e leve A-Me 01 de volta para a Cratera Un\'Goro.‡Найдите мифриловую обшивку и вернитесь к Чи-Та 3 в Кратер Ун\'Горо.‡Sucht ein Mithrilgehäuse und bringt es zu A-Me 01 im Krater von Un\'Goro.‡미스릴 형틀을 찾아 운고로 분화구에 있는 에이미 01에게 가야 합니다.‡Encuentra una envoltura de mitril y reúnete de nuevo con Memo 01 en el Cráter de Un\'Goro.‡Encuentra una envoltura de mitril y reúnete de nuevo con Memo 01 en el Cráter de Un\'Goro.‡Trouvez une Armature en mithril, et retournez voir A-Mi 01 dans le Cratère d\'Un\'Goro.‡找到一个秘银外壳，然后回到安戈洛环形山的A-Me 01身边。‡找到一個秘銀外殼，然後回到安戈洛環形山的艾米 01身邊。',
  }
},
[4245] = {
  {
    '‡В поисках Чи-Та 3‡‡에이미 01 추적‡Buscando a Memo 01‡Buscando a Memo 01‡À la poursuite d\'A-Mi 01‡找回A-Me 01‡',
    nil,
    '‡Доставьте Чи-Та 3 назад Карне Сомнамбулер в Кратер Ун\'Горо.‡Begleitet A-Me 01 zu Karna Wirrbart im Krater von Un\'Goro.‡‡Lleva a Memo 01 de vuelta con Karna Tripirrem al Cráter de Un\'Goro.‡Lleva a Memo 01 de vuelta con Karna Tripirrem al Cráter de Un\'Goro.‡Escortez A-Mi 01 sur le chemin du retour jusqu\'à Karna Songerrance, dans le Cratère d\'Un\'Goro.‡将A-Me 01交给安戈洛环形山的卡尔纳·雷塔维。‡',
  }
},
[4261] = {
  {
    '[DEPRECATED]Ancient Spirit‡Древний дух‡Alter Geist‡고대의 정령‡[DEPRECATED]El espíritu de un Ancestro‡[DEPRECATED]El espíritu de un Ancestro‡[PÉRIMÉ]L\'esprit d\'un ancien‡远古之灵‡[DEPRECATED]Ancient Spirit',
    nil,
    'Escolte Arei para um lugar seguro, depois fale com Kainet Brisacalma em Cantilenda, que fica no lado leste do Vale Gris.‡Сопроводите Арая в безопасное место, затем поговорите с Кайнетом Штилем в Лесной Песне на востоке Ясеневого леса.‡Bringt Arei in Sicherheit und sprecht dann mit Kayneth Stillwind in Waldeslied, im Osten des Eschentals.‡아레이를 안전하게 호위해야 합니다. 그리고 잿빛 골짜기 동쪽에 위치한 숲의 노래에 살고 있는 케이네스 스틸윈드와 대화해야 합니다.‡Escolta a Arei y luego habla con Kayneth Ventoleve que está en Canción del Bosque, en la parte este de Vallefresno.‡Escolta a Arei y luego habla con Kayneth Ventoleve que está en Canción del Bosque, en la parte este de Vallefresno.‡Escorter Arei jusqu\'à un lieu sûr, puis parler à Kayneth Mortebrise au Chant des forêts, dans l\'est d\'Orneval.‡护送艾雷脱离危险，然后和灰谷东部的林歌神殿中的凯尼斯·静风谈一谈。‡護送艾雷到安全處，然後和梣谷東部林歌神殿的凱尼斯·靜風談話。',
  }
},
[4262] = {
  {
    'Mestre Supremo Piro‡Подчинитель Пирон‡Übermeister Pyron‡멸망의 파이론‡Maestro supremo Pyron‡Maestro supremo Pyron‡Grand seigneur Pyron‡征服者派隆‡征服者派隆',
    nil,
    'Slay Overmaster Pyron.|n|nYou recall Jalinda talking about Pyron guarding the quarry. Perhaps you should search there?‡Убейте подчинителя Пирона.|n|nКажется, Джалинда говорила, что Пирон охраняет каменоломню. Может, поискать его там?‡Erschlagt Übermeister Pyron.|n|nIhr erinnert Euch an Jalindas Worte, dass Pyron den Steinbruch bewachen würde. Vielleicht solltet Ihr dort nachsehen?‡멸망의 파이론을 처치해야 합니다.|n|n잘린다가 말하기를 파이론은 채석장을 지키고 있다고 하니 그곳을 수색해야 할 것 같습니다.‡Mata al Maestro Supremo Pyron.|n|nRecuerdas que Jalinda dijo que Pyron guardaba la cantera. Quizás deberías empezar a buscar allí.‡Mata al Maestro Supremo Pyron.|n|nRecuerdas que Jalinda dijo que Pyron guardaba la cantera. Quizás deberías empezar a buscar allí.‡Tuer le Grand seigneur Pyron.|n|nJalinda vous a dit qu\'il gardait la carrière. Peut-être devriez-vous chercher à cet endroit ?‡杀掉征服者派隆。|n|n加琳达告诉过你，派隆守在采矿场中，也许你应该去那里找找。‡殺掉征服者派隆。|n|n加琳達告訴過你，派隆守在採礦場中，也許你應該去那裡找找。',
  }
},
[4263] = {
  {
    'Incendius!‡Опалитель!‡Incendius!‡인센디우스!‡¡Incendius!‡¡Incendius!‡Incendius !‡伊森迪奥斯！‡伊森迪奧斯!',
    nil,
    'Encontre Lorde Incendius no Abismo Rocha Negra e destrua-o!‡Отыщите и уничтожьте лорда Опалителя в глубинах Черной горы!‡Sucht Lord Incendius in den Schwarzfelstiefen und vernichtet ihn!‡검은바위 나락에서 불의 군주 인센디우스를 찾아 처치해야 합니다.‡Encuentra a Lord Incendius en las Profundidades de Roca Negra ¡y acaba con él!‡Encuentra a Lord Incendius en las Profundidades de Roca Negra ¡y acaba con él!‡Trouver le Seigneur Incendius dans les Profondeurs de Rochenoire et le détruire !‡在黑石深渊里找到伊森迪奥斯，然后把他干掉！‡在黑石深淵裡找到伊森迪奧斯領主，然後把他幹掉!',
  }
},
[4264] = {
  {
    'Bilhete amassado‡Измятая записка‡Eine zusammengeknüllte Notiz‡꼬깃꼬깃한 쪽지‡Una nota arrugada‡Una nota arrugada‡Une note chiffonnée‡弄皱的便笺‡弄皺的便箋',
    nil,
    'Você pode ter acabado de descobrir algo que o Marechal Vilasboas estaria interessado em ver. Pode haver esperança, afinal.‡Не исключено, что ваша находка заинтересует маршала Виндзора. Может быть, все не так плохо, и надежда еще жива.‡Soeben seid Ihr auf etwas gestoßen, das Marschall Windsor mit Sicherheit sehr interessiert. Vielleicht besteht ja doch noch Hoffnung.‡방금 우연히 치안대장 윈저가 보고 싶어할 듯한 물건을 찾은 것 같습니다. 어쩌면 희망이 있을지도 모릅니다.‡Puede que acabes de toparte con algo que le interesaría ver al mariscal Windsor. Puede que haya esperanza, después de todo.‡Puede que acabes de toparte con algo que le interesaría ver al mariscal Windsor. Puede que haya esperanza, después de todo.‡Il se peut que vous ayez simplement buté sur quelque chose qui pourrait intéresser le maréchal Windsor au plus haut point. Il reste peut-être encore un peu d\'espoir, après tout...‡温德索尔元帅也许会对你手中的东西感兴趣。毕竟，希望还没有被完全扼杀。‡溫德索爾元帥也許會對你手中的東西感興趣。畢竟，希望還沒有被完全扼殺。',
  }
},
[4265] = {
  {
    '‡Освобожденный из улья‡Flucht aus dem Schwarmbau‡고치 탈출‡Liberado de la colmena‡Liberado de la colmena‡L\'évasion de la ruche‡逃离虫巢‡',
    nil,
    '‡Освободите Раскала из улья Зукк\'аш.|n|nВернитесь к Гинро Пылающему Очагу в Крепости Оперенной Луны и сообщите ему, что Раскал жив и здоров.‡Begleitet Raschal sicher aus dem Schwarmbau der Zukk\'ash hinaus.|n|nKehrt zu Ginro Herdfeuer in der Mondfederfeste zurück und lasst ihn wissen, dass Raschal am Leben ist und dass es ihm gut geht.‡주크애쉬 소굴에서 라스칼을 풀어줘야 합니다.|n|n페더문 요새에 있는 긴로 하트킨들에게 돌아가 라스칼이 무사히 살아 있다는 소식을 전해 주십시오.‡Libera a Raschal de la vaina de los Zukk\'ash.|n|nVuelve al Bastión Plumaluna con Ginro Mechogar e infórmale de que Raschal está bien.‡Libera a Raschal de la vaina de los Zukk\'ash.|n|nVuelve al Bastión Plumaluna con Ginro Mechogar e infórmale de que Raschal está bien.‡Libérer Raschal de la ruche de Zukk\'ash.|n|nRevenir voir Ginro Attisâtre au bastion de Pennelune et lui dire que Raschal est sain et sauf.‡将拉斯卡尔安全护送到祖卡什虫巢外。|n|n回到羽月要塞的基恩诺·火花那儿，告诉他拉斯卡尔还活着，且状况良好。‡',
  }
},
[4266] = {
  {
    '‡Благодарность за отвагу‡Der Empfang eines Helden‡영웅의 쉼터 여관‡La bienvenida de un héroe‡La bienvenida de un héroe‡Accueil d\'un héros‡英雄之家‡英雄光臨',
    nil,
    '‡Поговорите с Шандрисой Оперенной Луной в Крепости Оперенной Луны.‡Sprecht mit Shandris Mondfeder in der Mondfederfeste.‡‡Habla con Shandris Plumaluna del Bastión Plumaluna.‡Habla con Shandris Plumaluna del Bastión Plumaluna.‡Parler à Shandris Pennelune dans le bastion de Pennelune.‡与羽月要塞的珊蒂斯·羽月谈一谈。‡',
  }
},
[4267] = {
  {
    '‡Возвышение силитидов‡Aufstieg der Silithiden‡실리시드의 출현‡La sublevación de los silítidos‡La sublevación de los silítidos‡L\'ascension des silithides‡异种蝎的威胁‡',
    nil,
    '‡Отнесите донесение Раскала Грацине Силе Духа в Дарнасе.‡Bringt Raschals Bericht zu Gracina Glaubensmacht in Darnassus.‡‡Lleva el informe de Raschal a Gracina Poderespíritu a Darnassus.‡Lleva el informe de Raschal a Gracina Poderespíritu a Darnassus.‡Apporter le Rapport de Raschal à Gracina Forcesprit à Darnassus.‡把拉斯卡尔的报告交给达纳苏斯的格拉希娜·灵风。‡',
  }
},
[4281] = {
  {
    'Entrega em Thalanaar‡Посылка в Таланаар‡Thalanaar-Lieferung‡탈라나르 배달‡Una entrega en Thalanaar‡Una entrega en Thalanaar‡La livraison à Thalanaar‡萨兰纳尔的货物‡',
    nil,
    'Leve o Pacote Extraviado para Falfindel Trilhemas em Thalanaar.‡Отнесите недоставленную посылку Хранителю дорог Фалфиндеру в Таланаар.‡Bringt das nicht ausgelieferte Paket zu Falfindel Wegeshut in Thalanaar.‡탈라나르에 있는 팔핀델 웨이워더에게 배달되지 않은 꾸러미를 가져가야 합니다.‡Lleva el paquete sin entregar a Díscolo Falfindel a Thalanaar.‡Lleva el paquete sin entregar a Díscolo Falfindel a Thalanaar.‡Apportez le Vieux colis à Falfindel Gardevoie, à Thalanaar.‡将未递送的包裹交给萨兰纳尔驿站的法芬德尔。‡',
  }
},
[4282] = {
  {
    'Um fiapo de esperança‡Проблеск надежды‡Ein Funken Hoffnung‡‡Una brizna de esperanza‡Una brizna de esperanza‡Un espoir en lambeaux‡一丝希望‡一絲希望',
    nil,
    'Recupere as Informações Perdidas do Marechal Vilasboas.|n|nO Marechal Vilasboas acredita que as informações estão sendo mantidas pelo Lorde Golem Argelmach e pelo General Forjaversa.‡Верните маршалу Виндзору утерянную информацию.|n|nМаршал уверен, что информацией завладели повелитель големов Аргелмах и генерал Кузня Гнева.‡Holt Marschall Windsors verlorene Informationen zurück.|n|nMarschall Windsor glaubt, dass sich die Informationen in den Händen des Golemlords Argelmach und des Generals Zornesschmied befinden.‡‡Devuélvele al mariscal Windsor la información perdida.|n|nEl mariscal Windsor cree que la información está siendo retenida en manos del Señor Gólem Argelmach y del general Forjainquina.‡Devuélvele al mariscal Windsor la información perdida.|n|nEl mariscal Windsor cree que la información está siendo retenida en manos del Señor Gólem Argelmach y del general Forjainquina.‡Rapporter les Informations égarées du maréchal Windsor.|n|nLe maréchal Windsor pense qu\'ils sont détenus par le seigneur golem Argelmach et par le général Forgehargne.‡找回温德索尔元帅遗失的情报。|n|n温德索尔元帅确信那些情报在安格弗将军和傀儡统帅阿格曼奇的手里。‡找回溫德索爾元帥遺失的情報。|n|n溫德索爾元帥確信那些情報在安格弗將軍和魔像領主阿格曼奇的手裡。',
  }
},
[4283] = {
  {
    'CINQUENTA! ISSO!‡ПЯТЬДЕСЯТ! АГА!‡FÜNFZIG! Jawoll!‡50개! 좋아!‡¡CINCUENTA! ¡SÍ!‡¡CINCUENTA! ¡SÍ!‡CINQUANTE ! OUI !‡五十个！‡五十個!',
    nil,
    'Collect 50 Blackrock Medallions.‡Найдите 50 медальонов Черной горы.‡Beschafft Euch 50 Medaillons des Schwarzfelsklans.‡검은바위 메달 50개를 모아야 합니다.‡Reúne 50 medallones Roca Negra.‡Reúne 50 medallones Roca Negra.‡Récupérez 50 Médaillons rochenoire.‡收集50枚黑石徽章。‡收集50枚黑石勳章。',
  }
},
[4284] = {
  {
    'Cristais de poder‡Кристаллы силы‡Machtkristalle‡마력의 수정‡Cristales de poder‡Cristales de poder‡Cristaux de puissance‡能量水晶‡能量水晶',
    nil,
    'Colete 7 Cristais de Poder de cada uma das seguintes cores: vermelho, azul, amarelo e verde. Leve-os para J.D. Neri no Refúgio do Marshal.‡Соберите по 7 кристаллов силы каждого цвета: красных, синих, желтых и зеленых. Принесите их Джей Ди Колли в Укрытие Маршалла.‡Sammelt 7 Machtkristalle von jeder Farbe: rot, blau, gelb und grün. Bringt sie zu J. D. Collie in Marschalls Zuflucht.‡붉은 마력의 수정, 푸른 마력의 수정, 노란 마력의 수정, 녹색 마력의 수정을 각각 7개씩 모아 마샬의 야영지에 있는 J.D. 콜리에게 가져가야 합니다.‡Recoge 7 cristales de poder de cada color: rojo, azul, amarillo y verde. Llévaselos a J.D. Collie en el Refugio de Marshal.‡Recoge 7 cristales de poder de cada color: rojo, azul, amarillo y verde. Llévaselos a J.D. Collie en el Refugio de Marshal.‡Récupérer 7 Cristaux de puissance de chaque couleur (rouge, bleu, jaune et vert). Les apporter à J.D. Collie au refuge des Marshal.‡收集红色能量水晶、蓝色能量水晶、黄色能量水晶和绿色能量水晶各7块，把它们交给马绍尔营地里的科琳。‡收集紅色能量水晶、藍色能量水晶、黃色能量水晶和綠色能量水晶各7塊，把它們交給馬紹爾營地裡的科琳。',
  }
},
[4285] = {
  {
    'A torre norte‡Северный пилон‡Der Nordpylon‡북쪽 수정탑‡La Torre de cristal del Norte‡La Torre de cristal del Norte‡Le Pylône nord‡北部水晶塔‡北部水晶塔',
    nil,
    'Descubra a localização da Torre de Cristal Norte, que fica na Cratera Un\'Goro.‡Отыщите Северный хрустальный пилон в Кратере Ун\'Горо.‡Findet den Standort des nördlichen Kristallpylonen im Krater von Un\'Goro.‡운고로 분화구에 있는 북쪽 수정탑의 위치를 알아내야 합니다.‡Descubre la localización de la Torre de Cristal del Norte en el Cráter de Un\'Goro.‡Descubre la localización de la Torre de Cristal del Norte en el Cráter de Un\'Goro.‡Découvrir l\'emplacement du Pylône de cristal nord dans le Cratère d\'Un\'Goro.‡在安戈洛尔环形山找到北部水晶塔。‡在安戈洛環形山找到北部水晶塔。',
  }
},
[4286] = {
  {
    'Produto de primeira‡За сокровищем – с кулаками‡Das gute Zeug‡좋은 물건‡Buena mercancía‡Buena mercancía‡Du beau matériel‡好东西‡好東西',
    nil,
    'Collect 20 Dark Iron Fanny Packs.‡Добудьте 20 поясных сумок дворфов Черного Железа.‡Beschafft Euch 20 Dunkeleisengürteltaschen.‡검은무쇠 벨트주머니 20개를 모아야 합니다.‡Recupera 20 riñoneras Hierro Negro.‡Recupera 20 riñoneras Hierro Negro.‡Trouvez 20 Sacoches Sombrefer.‡收集20个黑铁挎包。‡收集20個黑鐵挎包。',
  }
},
[4287] = {
  {
    'A torre leste‡Восточный пилон‡Der Ostpylon‡동쪽 수정탑‡La Torre de cristal del Este‡La Torre de cristal del Este‡Le Pylône est‡东部水晶塔‡東部水晶塔',
    nil,
    'Descubra a localização da Torre de Cristal Leste, que fica na Cratera Un\'Goro.‡Отыщите Восточный хрустальный пилон в Кратере Ун\'Горо.‡Findet den Standort des östlichen Kristallpylonen im Krater von Un\'Goro.‡운고로 분화구에 있는 동쪽 수정탑의 위치를 알아내야 합니다.‡Descubre la localización de la Torre de Cristal del Este en el Cráter de Un\'Goro.‡Descubre la localización de la Torre de Cristal del Este en el Cráter de Un\'Goro.‡Trouver l\'emplacement du Pylône de cristal est dans le Cratère d\'Un\'Goro.‡在安戈洛尔环形山找到东部水晶塔。‡在安戈洛環形山找到東部水晶塔。',
  }
},
[4288] = {
  {
    'A torre oeste‡Западный пилон‡Der Westpylon‡서쪽 수정탑‡La Torre de cristal del Oeste‡La Torre de cristal del Oeste‡Le Pylône ouest‡西部水晶塔‡西部水晶塔',
    nil,
    'Descubra a localização da Torre de Cristal Oeste, que fica na Cratera Un\'Goro.‡Отыщите Западный хрустальный пилон.‡Findet den Standort des westlichen Kristallpylonen.‡운고로 분화구에 있는 서쪽 수정탑의 위치를 알아내야 합니다.‡Descubre la localización de la Torre de Cristal del Oeste.‡Descubre la localización de la Torre de Cristal del Oeste.‡Découvrir l\'emplacement du Pylône de cristal ouest.‡在安戈洛尔环形山找到西部水晶塔。‡在安戈洛環形山找到西部水晶塔。',
  }
},
[4289] = {
  {
    'Os macacos de Un\'Goro‡Обезьяны Ун\'Горо‡Die Affen von Un\'Goro‡운고로의 유인원‡Los simios de Un\'Goro‡Los simios de Un\'Goro‡Les gorilles d\'Un\'Goro‡安戈洛的猩猩‡安戈洛的猩猩',
    nil,
    'Leve 2 Pelagens de Gorila de Un\'Goro, 2 Pelagens de Pisoteador de Un\'Goro, 2 Pelagens de Trovejador de Un\'Goro para Torwa Mateiro na entrada da Cratera Un\'Goro.‡Принесите 2 шкуры Ун\'Горской гориллы, 2 шкуры Ун\'Горского топтуна и 2 шкуры Ун\'Горского рокотуна землепроходцу Торве к входу в Кратер Ун\'Горо.‡Bringt Torwa Pfadfinder am Eingang zum Krater von Un\'Goro 2 Gorillapelze von Un\'Goro, 2 Stampferpelze von Un\'Goro und 2 Donnererpelze von Un\'Goro.‡운고로 분화구 입구에 있는 토르와 패스파인더에게 운고로 고릴라 모피 2개, 운고로 우레고릴라 모피 2개, 운고로 천둥고릴라 모피 2개를 가져가야 합니다.‡Llévale 2 pelambres de gorila de Un\'Goro, 2 pelambres de vapuleador de Un\'Goro y 2 pelambres de tronador de Un\'Goro a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Llévale 2 pelambres de gorila de Un\'Goro, 2 pelambres de vapuleador de Un\'Goro y 2 pelambres de tronador de Un\'Goro a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Apporter 2 Peaux de gorille d\'Un\'Goro, 2 Peaux de marteleur d\'Un\'Goro et 2 Peaux de foudroyeur d\'Un\'Goro à Torwa le Guide à l\'entrée du cratère d\'Un\'Goro.‡将2块安戈洛猩猩的皮、2块安戈洛大猩猩的皮和2块安戈洛巨猩猩的皮交给安戈洛环形山入口处的托尔瓦·寻路者。‡將2塊安戈洛猩猩的皮、2塊安戈洛大猩猩的皮和2塊安戈洛巨猩猩的皮交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[4290] = {
  {
    'A dieta de Lar\'korwi‡Добыча Лар\'корви‡Lar\'korwis Mahl‡라르코르위의 먹이‡La comida de Lar\'korwi‡La comida de Lar\'korwi‡La nourriture de Lar\'korwi‡拉克维的食物‡拉克維的食物',
    nil,
    'Encontre a carcaça mais recente de uma presa morta por Lar\'korwi e roube um Pedaço de Carcaça de Manguadonte. Depois disso, fale novamente com Torwa Mateiro na Cratera Un\'Goro.‡Найдите последнюю добычу Лар\'корви, украдите кусок трупа жесткозуба и вернитесь к землепроходцу Торве в Кратер Ун\'Горо.‡Sucht das Gerippe von Lar\'korwis letzter Jagdbeute und stehlt einen Teil eines Dreschadongerippes; kehrt dann zu Torwa Pfadfinder im Krater von Un\'Goro zurück.‡라르코르위가 막 잡은 사냥감을 찾아 트레샤돈 시체 덩이를 훔친 후 운고로 분화구에 있는 토르와 패스파인더에게 가야 합니다.‡Encuentra la última presa muerta de Lar\'korwi y roba un trozo de trillanodonte muerto, y después ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro.‡Encuentra la última presa muerta de Lar\'korwi y roba un trozo de trillanodonte muerto, y después ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro.‡Trouver la dernière victime de Lar\'korwi et voler un Morceau de carcasse d\'un battrodon, puis retourner voir Torwa le Guide au Cratère d\'Un\'Goro.‡找到拉克维刚刚猎杀的动物的尸体，从尸体上偷取一块蛇颈龙肉块，然后回到安戈洛环形山的托尔瓦·寻路者那里。‡找到拉克維剛剛獵殺的動物的屍體，從屍體上偷取一塊蛇頸龍肉塊，然後回到安戈洛環形山的托爾瓦·尋路者那裡。',
  }
},
[4291] = {
  {
    'O olfato de Lar\'korwi‡Запах Лар\'корви‡Lar\'korwis Fährte‡라르코르위의 냄새‡Un aroma irresistible para Lar\'korwi‡Un aroma irresistible para Lar\'korwi‡Un parfum pour Lar\'korwi‡拉克维的气味‡拉克維的氣味',
    nil,
    'Leve 2 Glândulas de Feromônio de Ravassauro para Torwa Mateiro, que está perto da entrada da Cratera Un\'Goro.‡Принесите 2 феромонные железы равазавра землепроходцу Торве в преддверие Кратера Ун\'Горо.‡Bringt Torwa Pfadfinder in der Nähe des Eingangs zum Krater von Un\'Goro 2 Pheromondrüsen eines Ravasaurus.‡운고로 분화구 입구에 있는 토르와 패스파인더에게 라바사우루스 페로몬샘 2개를 가져가야 합니다.‡Llévale 2 glándulas de feromonas de ravasaurio a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Llévale 2 glándulas de feromonas de ravasaurio a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Apporter 2 Glandes de phéromone de ravasaure à Torwa le Guide près de l\'entrée du Cratère d\'Un\'Goro.‡将2份暴掠龙信息素交给安戈洛尔环形山入口附近的托尔瓦·寻路者。‡將2份暴掠龍資訊素交給安戈洛環形山入口附近的托爾瓦·尋路者。',
  }
},
[4292] = {
  {
    'A isca para Lar\'korwi‡Приманка для Лар\'корви‡Ein Köder für Lar\'korwi‡라르코르위를 위한 미끼‡El cebo para Lar\'korwi‡El cebo para Lar\'korwi‡Un appât pour Lar\'korwi‡拉克维的诱饵‡拉克維的誘餌',
    nil,
    'Use o conteúdo do Bornal do Torwa para evocar Lar\'korwi e derrotá-lo. Então, leve a Cabeça do Lar\'korwi para Torwa Mateiro, que está perto da entrada da Cratera Un\'Goro.‡С помощью предметов из мешочка Торвы выманите Лар\'корви и сразите его. Принесите голову Лар\'корви землепроходцу Торве ко входу в Кратер Ун\'Горо.‡Beschwört Lar\'korwi mit dem Inhalt von Torwas Beutel und besiegt ihn. Bringt dann Lar\'korwis Kopf zu Torwa Pfadfinder in der Nähe des Eingangs zum Krater von Un\'Goro.‡토르와의 주머니에 든 물건들로 라르코르위를 불러내 물리친 후 라르코르위의 머리를 운고로 분화구 입구에 있는 토르와 패스파인더에게 가져가야 합니다.‡Utiliza el contenido de la faltriquera de Torwa para atraer la presencia de Lar\'korwi y derrótalo. Después llévale la cabeza de Lar\'korwi a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Utiliza el contenido de la faltriquera de Torwa para atraer la presencia de Lar\'korwi y derrótalo. Después llévale la cabeza de Lar\'korwi a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡En utilisant le contenu de la Sacoche de Torwa, appeler Lar\'korwi et le vaincre. Puis apporter la Tête de Lar\'korwi à Torwa le Guide près de l\'entrée du Cratère d\'Un\'Goro.‡使用托尔瓦的麻袋中的东西召唤拉克维并打败它。将拉克维的徽记交给安戈洛环形山入口处的托尔瓦·寻路者。‡使用托爾瓦的麻袋中的東西召喚拉克維並打敗它。將拉克維的頭顱交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[4293] = {
  {
    'Uma amostra de visgo...‡Проба слизи...‡Eine Schleimprobe...‡진흙괴물 견본...‡Muestras de babosa...‡Muestras de babosa...‡Un échantillon de gelée...‡软泥怪的样本...‡泥漿怪的樣本…',
    nil,
    'Colha Amostras de Visgo da Selva Maleva de qualquer visgo em Selva Maleva. Depois, usando o Equipamento de Teste ao lado do Químico Sérgio, na Cidade Baixa, veja quais das suas amostras são as mais corrompidas. Leve 5 das Amostras Corrompidas da Selva Maleva que você encontrar para o Químico Sérgio.‡Возьмите на пробу образцы слизи из Оскверненного леса. Воспользуйтесь тестовым оборудованием химика Барабоса в Подгороде, чтобы отобрать 5 наиболее чистых образцов и отдайте их ему.‡Sammelt im Teufelswald Proben von verschiedenen Schleimen. Verwendet dann die Testausrüstung neben Chemiker Brenner in Unterstadt, um zu sehen, welche Eurer Proben am verderbtesten sind. Bringt 5 der verderbten Proben aus dem Teufelswald, die Ihr findet, zu Chemiker Brenner.‡악령숲에 있는 진흙괴물에게서 악령숲 진흙괴물 견본을 모은 후 언더시티의 연금술사 퓰리 옆에 있는 실험 기구를 사용해 어느 견본이 가장 부패한 것들인지 알아내야 합니다. 부패한 악령숲 견본 5개를 찾으면 연금술사 퓰리에게 가져가야 합니다.‡Recoge muestras de babosa de Frondavil de cualquiera de las babosas que encuentres en Frondavil. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras están más corruptas. Llévale 5 de las muestras de Frondavil corruptas que encuentres al químico Fuely.‡Recoge muestras de babosa de Frondavil de cualquiera de las babosas que encuentres en Frondavil. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras están más corruptas. Llévale 5 de las muestras de Frondavil corruptas que encuentres al químico Fuely.‡Ramassez des Échantillons de gelée de Gangrebois sur n\'importe quel type de gelée de Gangrebois. Puis, en utilisant le Matériel d\'expérience qui se trouve à côté du chimiste Fuely à Fossoyeuse, décelez les échantillons le plus corrompus. Apportez 5 Échantillons corrompus de Gangrebois que vous aurez obtenus au Chimiste Fuely.‡从费伍德的软泥怪身上收集费伍德软泥怪样本，然后使用幽暗城的化学家弗雷身旁的测试设备来检测你所收集的样本中哪一份被腐化的程度最深。给化学家弗雷带去5个被腐化的费伍德样本。‡從費伍德的泥漿怪身上收集費伍德泥漿怪樣本，然後使用幽暗城的化學家弗雷身旁的測試設備來檢測你所收集的樣本中哪一份被腐化的程度最深。給化學家弗雷帶去5個被腐化的費伍德樣本。',
  }
},
[4294] = {
  {
    '... E um lote de gosma‡...и образцы слизнюков‡...und eine Menge Schlamm‡... 그리고 한 무리의 수액괴물‡... y unos mocos‡... y unos mocos‡... et une fournée de limon‡一大堆软泥怪‡...一大堆軟泥怪',
    nil,
    'Colha Amostras de Visgo de Un\'Goro de qualquer visgo na Cratera Un\'Goro. Depois, usando o Equipamento de Teste ao lado do Químico Sérgio, na Cidade Baixa, veja quais das suas amostras são as mais puras. Leve 5 das Amostras Puras de Un\'Goro que você encontrar para o Químico Sérgio.‡Возьмите на пробу образцы слизи из Кратера Ун\'Горо. Воспользуйтесь тестовым оборудованием химика Барабоса в Катакомбах, чтобы отобрать 5 наиболее чистых образцов и отдайте их ему.‡Sammelt im Un\'Goro Proben von verschiedenen Schleimen. Verwendet dann die Testausrüstung neben Chemiker Brenner in Unterstadt, um zu sehen, welche Eurer Proben am reinsten sind. Bringt 5 der reinen Proben aus dem Un\'Goro, die Ihr findet, zu Chemiker Brenner.‡운고로 분화구에 있는 진흙괴물과 수액괴물에게서 운고로 진흙괴물 견본을 모은 후 언더시티의 연금술사 퓰리 옆에 있는 실험 기구를 사용해 어느 견본이 가장 순수한 것인지 알아내야 합니다. 순수한 운고로 견본 5개를 찾으면 연금술사 퓰리에게 가져가야 합니다.‡Recoge muestras de babosa de Un\'Goro de cualquiera de las babosas que encuentres en el Cráter de Un\'Goro. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras son más puras. Llévale 5 de las muestras de Un\'Goro puras que encuentres al químico Fuely.‡Recoge muestras de babosa de Un\'Goro de cualquiera de las babosas que encuentres en el Cráter de Un\'Goro. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras son más puras. Llévale 5 de las muestras de Un\'Goro puras que encuentres al químico Fuely.‡Ramassez des Échantillons de gelée d\'Un\'Goro sur n\'importe quel type de gelée du Cratère d\'Un\'Goro. Puis, en utilisant le Matériel d\'expérience qui se trouve à côté du chimiste Fuely à Fossoyeuse, décelez les échantillons les plus purs. Apporter 5 Échantillons purs d\'Un\'Goro que vous aurez obtenus au Chimiste Fuely.‡从安戈洛尔环形山那里任何泥浆怪身上收集安戈洛泥浆怪样本。使用幽暗城的化学家弗雷身旁的测试仪器来检验你所采集到的样本的纯度。把5份纯净的安戈洛样本送到化学家弗雷那里去。‡從安戈洛環形山那裡任何泥漿怪身上收集安戈洛泥漿怪樣本。使用幽暗城的化學家弗雷身旁的測試儀器來檢驗你所採集到的樣本的純度。把5份純淨的安戈洛樣本送到化學家弗雷那裡去。',
  }
},
[4295] = {
  {
    'Cerveja Pedrosa‡Эль для Каменного Узла‡Rocknots Bier‡락노트의 에일 맥주‡La cerveza de Sinroca‡La cerveza de Sinroca‡La bière de Rochenoeud‡罗克诺特的麦酒‡羅克諾特的麥芽酒',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[4296] = {
  {
    'Tabuletas dos Sete‡Табличка Семерых‡Schrifttafel der Sieben‡일곱 현자의 서판‡La tablilla de los Siete‡La tablilla de los Siete‡La tablette des Sept‡七贤石板‡七賢石板',
    nil,
    'Collect the Tablet Transcript.‡Перепишите текст с таблички Семерых.‡Beschafft Euch die Abschrift der Schrifttafel.‡서판 사본을 입수해야 합니다.‡Obtén la transcripción de tablilla.‡Obtén la transcripción de tablilla.‡Trouvez la Transcription de la tablette.‡取得石板拓文。‡取得石板拓文。',
  }
},
[4297] = {
  {
    'Papá pro piá‡Покормить малыша‡Essen für das Baby‡‡Comida para el bebé‡Comida para el bebé‡Nourriture pour bébé‡小精龙的食物‡小精龍的食物',
    nil,
    'Leve 5 Lombos de Espreitador Jubaprata para Agnar Domaferas nas Terras Agrestes.‡Принесите 5 окороков среброгривого бродяги Агнару Зверопасу во Внутренних землях.‡Bringt Agnar Tiermeister im Hinterland 5 Silbermähnenpirscherflanken.‡‡Lleva 5 costillas de acechador melenargenta a Agnar Domabestias a las Tierras del Interior.‡Lleva 5 costillas de acechador melenargenta a Agnar Domabestias a las Tierras del Interior.‡Apporter 5 Flanchets de traqueur crins-d\'argent à Angar Domptebêtes dans les Hinterlands.‡将5块银鬃捕猎者的肉交给辛特兰的阿格纳。‡將5塊銀鬃潛獵者的肉交給辛特蘭的阿格納。',
  }
},
[4298] = {
  {
    '‡У вас появился малыш!‡Elternfreuden‡‡El amor parental‡El amor parental‡L\'amour d\'un parent‡为人父母‡',
    nil,
    '‡Поговорите с Агнаром Зверопасом во Внутренних землях.‡Sprecht mit Agnar Tiermeister im Hinterland.‡‡Habla con Agnar Domabestias en las Tierras del Interior.‡Habla con Agnar Domabestias en las Tierras del Interior.‡Parler à Agnar Domptebêtes dans les Hinterlands.‡与辛特兰的阿格纳谈一谈。‡',
  }
},
[4299] = {
  {
    '‡<NYI> <TXT>Гробница Семерых‡‡‡<NYI> <TXT>La Tumba de los Siete‡<NYI> <TXT>La Tumba de los Siete‡‡暂无内容‡',
    nil,
    '‡Поместите Энигматрон-ПХ83 в Гробницу Семерых и вернитесь к Максворту Суперблеску.‡Platziert das PX83-Enigmatron im Grabmal der Sieben und kehrt dann zu Maxwort Funkelglanz zurück.‡‡Coloca el PX83-Enigmatrón en la Tumba de los Siete y vuelve junto a Maxwort Suprandor.‡Coloca el PX83-Enigmatrón en la Tumba de los Siete y vuelve junto a Maxwort Suprandor.‡Placer l\'Enigmatron-PX83 dans le Tombeau des Sept puis retourner voir Maxwort Uberbrille.‡把PX83型密码机放在七英雄之墓里，然后向麦克斯沃特·尤博格林复命。‡',
  }
},
[4300] = {
  {
    'Armas de gume de osso‡Костяные клинки‡Knochenklingenwaffen‡발톱으로 만든 무기‡Armas con filo de hueso‡Armas con filo de hueso‡Les armes aux lames d\'os‡骨刃武器‡骨刃武器',
    nil,
    'Leve 8 Garras Brancas de Ravassauro para Sona\'rima em Orgrimmar.‡Принесите 8 белых когтей равазавра Джес\'римону в Оргриммаре.‡Bringt Jes\'rimon in Orgrimmar 8 weiße Ravasaurusklauen.‡오그리마에 있는 제스리몬에게 라바사우루스의 흰색 발톱 8개를 가져가야 합니다.‡Lleva 8 garras blancas de ravasaurio a Jes\'rimon a Orgrimmar.‡Lleva 8 garras blancas de ravasaurio a Jes\'rimon a Orgrimmar.‡Apporter 8 Griffes blanches de ravasaure à Jes\'rimon à Orgrimmar.‡将8只白色暴掠龙爪交给奥格瑞玛的杰斯雷蒙。‡將8隻白色暴掠龍爪交給奧格瑪的傑斯雷蒙。',
  }
},
[4301] = {
  {
    'O poderoso U\'cha‡Могучая У\'ча‡Der mächtige U\'cha‡강대한 우차‡El poderoso U\'cha‡El poderoso U\'cha‡Le puissant U\'cha‡强大的尤尔查‡強大的尤爾查',
    nil,
    'Leve Pelagem de U\'cha para Torwa Mateiro na entrada da Cratera Un\'Goro.‡Принесите шкуру У\'чи землепроходцу Торве ко входу в Кратер Ун\'Горо.‡Bringt U\'chas Pelz zu Torwa Pfadfinder am Eingang des Kraters von Un\'Goro.‡운고로 분화구 입구에 있는 토르와 패스파인더에게 우차의 모피를 가져가야 합니다.‡Llévale la pelambre de U\'cha a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Llévale la pelambre de U\'cha a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Apportez la Peau d\'U\'cha à Torwa le Guide à l\'entrée du Cratère d\'Un\'Goro.‡把尤尔查的毛皮交给安戈洛环形山入口处的托尔瓦·寻路者。‡把尤爾查的毛皮交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[4321] = {
  {
    'Entendendo tudo‡Давай-ка разберемся‡Die Sache verstehen‡수정탑 정보 수집‡Entender el significado‡Entender el significado‡Ceci explique cela‡分析水晶塔‡分析水晶塔',
    nil,
    'Fale com J.D. Neri em um instante.‡Поговорите с Джей Ди Колли через пару минут.‡Sprecht demnächst mit J. D. Collie.‡잠시 기다린 후, J.D. 콜리와 대화해야 합니다.‡Habla en un momento con J.D. Collie.‡Habla en un momento con J.D. Collie.‡Parler à J.D. Collie dans un moment.‡过一会再和科琳说话。‡過一會再和科琳說話。',
  }
},
[4322] = {
  {
    '‡Побег!‡Gefängnisausbruch!‡‡La fuga de la prisión‡La fuga de la prisión‡Évasion !‡冲破牢笼！‡',
    nil,
    '‡Помогите маршалу Виндзору забрать вещи и освободить его друзей, после чего вернитесь к маршалу Максвеллу и получите дальнейшие инструкции.‡Helft Marschall Windsor, seine Ausrüstung zurückzuholen und seine Freunde zu befreien. Kehrt zu Marschall Maxwell zurück, wenn Ihr Erfolg hattet.‡‡Ayuda al mariscal Windsor a recuperar su equipo y a liberar a sus amigos. Vuelve junto al mariscal Maxwell si lo consigues.‡Ayuda al mariscal Windsor a recuperar su equipo y a liberar a sus amigos. Vuelve junto al mariscal Maxwell si lo consigues.‡Aider le maréchal Windsor à récupérer son équipement et à libérer ses amis. Ensuite, retourner voir le maréchal Maxwell.‡帮助温德索尔元帅拿回他的装备并救出他的朋友。当你成功之后就回去向麦克斯韦尔元帅复命。‡',
  }
},
[4323] = {
  {
    '‡*NYI* *TXT* Убить этих гиен!!!‡‡하이에나 처치!!!‡<NYI> <TXT> ¡¡¡Coged esas hienas!!!‡<NYI> <TXT> ¡¡¡Coged esas hienas!!!‡‡暂无内容‡',
    nil,
    '‡Принесите 7 шкур пятнистой гиены TESTTAUREN на Заставу Вольного Ветра.‡Bringt dem TESTTAUREN am Freiwindposten 7 gefleckte Hyänenpelze.‡‡Llévale 7 pieles de hiena moteadas a TESTTAUREN, que está en el Poblado Viento Libre.‡Llévale 7 pieles de hiena moteadas a TESTTAUREN, que está en el Poblado Viento Libre.‡Apporter 7 Peaux de hyène tachetée à TAURENDETEST au Poste de Librevent.‡把7条Spotted hyena Pelts带给Freewind Post的TESTTAUREN。‡',
  }
},
[4324] = {
  {
    'Yuka Parafuseta‡Юка Крутипроб‡Yuka Schraubstutz‡유카 스크류스피곳‡Yuka Llavenrosca‡Yuka Llavenrosca‡Yuka Fermevanne‡尤卡·斯库比格特‡尤卡·斯庫比格特',
    nil,
    'Fale com Yuka Parafuseta nas Estepes Ardentes.‡Переговорите с Юкой Крутипроб в Пылающих степях.‡Sprecht mit Yuka Schraubstutz in der Brennenden Steppe.‡불타는 평원에 있는 유카 스크류스피곳과 대화해야 합니다.‡Habla con Yuka Llavenrosca en Las Estepas Ardientes.‡Habla con Yuka Llavenrosca en Las Estepas Ardientes.‡Parlez à Yuka Fermevanne, dans les Steppes Ardentes.‡与燃烧平原的尤卡·斯库比格特谈一谈。‡與燃燒平原的尤卡·斯庫比格特談話。',
  }
},
[4341] = {
  {
    'Kharan Feromalho‡Каран Могучий Молот‡Kharan Hammermacht‡카란 마이트해머‡Kharan Martillo Poderoso‡Kharan Martillo Poderoso‡Kharan Force-martel‡卡兰·巨锤‡卡蘭·巨錘',
    nil,
    'Viaje para Abismo Rocha Negra e encontre Kharan Feromalho.|n|nO Rei mencionou que Kharan estava preso lá — talvez seja bom procurar uma prisão.‡Пойдите в Глубины Черной горы и найдите Карана Могучего Молота.|n|nКороль упомянул, что Каран сидит там в плену – может, стоит поискать темницу.‡Begebt Euch in die Schwarzfelstiefen und findet Kharan Hammermacht.|n|nDer König erwähnte, dass Kharan dort gefangen sei - vielleicht solltet Ihr nach einem Gefängnis Ausschau halten.‡검은바위 나락으로 가서 카란 마이트해머를 찾아야 합니다.|n|n국왕은 카란이 그곳에 포로로 잡혀 있을 것이라고 말했습니다. 그곳 감옥을 찾아보는 것이 좋겠습니다.‡Ve a las Profundidades de Roca Negra y encuentra a Kharan Martillo Poderoso.|n|nEl rey dijo que estaba prisionero allí; busca una cárcel.‡Ve a las Profundidades de Roca Negra y encuentra a Kharan Martillo Poderoso.|n|nEl rey dijo que estaba prisionero allí; busca una cárcel.‡Allez dans les Profondeurs de Rochenoire et trouvez Kharan Force-martel.|n|nLe roi a mentionné que Kharan était retenu prisonnier là-bas ; cherchez une prison.‡去黑石深渊找到卡兰-巨锤。|n|n国王提到卡兰在那里负责看守囚犯——也许你应该在监狱附近寻找他。‡去黑石深淵找到卡蘭·巨錘。|n|n國王提到卡蘭在那裡負責看守囚犯─也許你應該在監獄附近尋找他。',
  }
},
[4342] = {
  {
    '‡Рассказ Карана‡Kharans Geschichte‡‡El relato de Kharan‡El relato de Kharan‡Légende de Kharan‡卡兰的故事‡',
    nil,
    '‡Выслушайте рассказ Карана Могучего Молота.‡Lasst Kharan Hammermacht seine Geschichte erzählen.‡‡Escucha la historia de Kharan Martillo Poderoso.‡Escucha la historia de Kharan Martillo Poderoso.‡Écouter Kharan Force-martel raconter son histoire.‡听卡兰·巨锤说他的故事。‡',
  }
},
