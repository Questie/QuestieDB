[997] = {
  {
    'A terra de Denalan‡Земля Деналана‡Denalans Erde‡데날란의 흙‡Las tierras de Denalan‡Las tierras de Denalan‡La terre de Denalan‡德纳兰的泥土‡德納蘭的泥土',
    nil,
    'Leve o pacote de Terra Rara para Denalan no Lago Al\'Ameth.‡Отнесите горсть редкой земли Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee das Päckchen seltener Erden.‡알아메스 호수에 있는 데날란에게 귀한 흙 꾸러미를 가져가야 합니다.‡Llévale el paquete con tierras raras a Denalan, que está en el Lago Al\'Ameth.‡Llévale el paquete con tierras raras a Denalan, que está en el Lago Al\'Ameth.‡Apportez le paquet de Terre rare à Denalan au lac Al\'Ameth.‡把稀土交给奥拉密斯湖畔的德纳兰。‡把稀土交給奧拉密斯湖畔的德納蘭。',
  }
},
