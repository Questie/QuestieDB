},
[31819] = {
  {
    'Dagra, a Bruta‡Дагра Яростная‡Dagra die Grimmige‡맹렬한 다그라‡Dagra la Fiera‡‡Dagra la Féroce‡凶狠的达戈‡',
    nil,
    'Derrote Dagra, a Bruta, numa batalha de mascotes. Uma‡Победите Дагру Яростную в битве питомцев. это‡Besiegt Dagra die Grimmige in einem Haustierkampf.‡애완동물 대전에서 맹렬한 다그라를 꺾어야 합니다. 레벨 1‡Derrota a Dagra la Fiera en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Dagra la Féroce.‡在宠物战斗中击败凶狠的达戈。‡',
  }
},
[31820] = {
  {
    'Um presente inesperado‡Подарок для учителя‡Ein Geschenk für den Lehrer‡선생님을 위한 선물‡Un regalo para el profe‡‡Un cadeau pour le professeur‡谢师礼‡',
    nil,
    'Receba o presente de Nomi. Uma‡Получите подарок от Номи. это‡Nehmt Nomis Geschenk an.‡노미의 선물을 받아야 합니다. 레벨 10‡Recibe el regalo de Nomi.‡‡Acceptez le cadeau de Nomi.‡接受诺米的礼物。‡',
  }
},
[31821] = {
  {
    'Passe de Nível!‡Новый уровень!‡Stufenaufstieg‡레벨 상승!‡¡Siguiente nivel!‡‡On passe au niveau supérieur !‡升级！‡',
    nil,
    'Elevar uma mascote ao nível 3. Uma‡Повысьте уровень питомца до 3-го. это‡Lasst ein Haustier auf Stufe 3 aufsteigen.‡애완동물을 3 레벨까지 올려야 합니다. 레벨 1‡Sube a una mascota al nivel 3.‡‡Faites atteindre le niveau 3 à une mascotte.‡将一个宠物提升至3级。‡',
  }
},
[31822] = {
  {
    'Passe de Nível!‡Новый уровень!‡Stufenaufstieg‡레벨 상승!‡¡Siguiente nivel!‡‡On passe au niveau supérieur !‡升级！‡',
    nil,
    'Elevar uma mascote ao nível 3. Uma‡Повысьте уровень питомца до 3-го. это‡Lasst ein Haustier auf Stufe 3 aufsteigen.‡애완동물을 3 레벨까지 올려야 합니다. 레벨 1‡Sube a una mascota al nivel 3.‡‡Faites atteindre le niveau 3 à une mascotte.‡将一个宠物提升至3级。‡',
  }
},
[31823] = {
  {
    'Passe de Nível!‡Новый уровень!‡Stufenaufstieg‡레벨 상승!‡¡Siguiente nivel!‡‡On passe au niveau supérieur !‡升级！‡',
    nil,
    'Elevar uma mascote ao nível 3. Uma‡Повысьте уровень питомца до 3-го. это‡Lasst ein Haustier auf Stufe 3 aufsteigen.‡애완동물을 3 레벨까지 올려야 합니다. 레벨 1‡Sube a una mascota al nivel 3.‡‡Faites atteindre le niveau 3 à une mascotte.‡将一个宠物提升至3级。‡',
  }
},
