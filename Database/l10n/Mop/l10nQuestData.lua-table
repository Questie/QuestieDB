[1462] = {
  {
    '‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Sapta de terre‡大地灵契‡大地靈契',
    nil,
    '‡Попросите у провидицы Воронье Перо еще одну сапту земли.‡Sprecht mit Seherin Rabenfeder wegen eines weiteren Erdsaptas.‡‡Pide otra sapta de tierra a la vidente Pluma de Cuervo.‡Pide otra sapta de tierra a la vidente Pluma de Cuervo.‡Parler à la Prophétesse Plume-de-corbeau pour obtenir un autre Sapta de terre.‡向鸦羽先知要另一瓶大地灵契。‡',
  }
},
[1463] = {
  {
    '‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Sapta de terre‡大地灵契‡大地靈契',
    nil,
    '‡Поговорите с Канагой заклинателем земли, чтобы получить еще один сапту земли.‡Sprecht mit Canaga Erdenrufer wegen eines weiteren Erdsaptas.‡‡Pide a Canaga Clamatierras otra sapta de tierra.‡Pide a Canaga Clamatierras otra sapta de tierra.‡Parler à Canaga Hucheterre pour obtenir un autre Sapta de terre.‡向坎纳甘·地鸣要另一个大地灵契。‡',
  }
},
[1464] = {
  {
    '‡Сапта огня‡Feuersapta‡불의 정기‡Sapta de fuego‡Sapta de fuego‡Sapta de feu‡火焰灵契‡火焰靈契',
    nil,
    '‡Поговорите с Телфом Джоламом, чтобы получить еще одну сапту огня.‡Sprecht mit Telf Joolam wegen eines weiteren Feuersaptas.‡‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Parlez à Telf Joolam pour obtenir un autre Sapta de feu.‡向泰尔夫·祖拉姆再要一个 火焰灵契。‡',
  }
},
[1465] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Return the Malem Pendant to Vahlarriel Demonslayer in Desolace.‡Принесите подвеску Малемов в Пустоши Валарриелю Истребителю Демонов.‡Kehrt mit Malems Anhänger zu Vahlarriel Dämonenjäger in Desolace zurück.‡잊혀진 땅에 있는 발라리엘 데몬슬레이어에게 말렘 펜던트를 가져가야 합니다.‡Lleva el colgante Malem a Vahlarriel Destripademonios a Desolace.‡Lleva el colgante Malem a Vahlarriel Destripademonios a Desolace.‡Rapporter le Pendentif de Malem à Vahlarriel Tueur-de-démons en Désolace.‡向凄凉之地的瓦拉里尔·屠魔者回复。‡將瑪雷姆墜子帶回去給淒涼之地的瓦拉里爾·屠魔者。',
  }
},
[1466] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реагенты для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Recuperadores S.A.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 10 Cérebros de Canisvil, 10 Asas Etéreas e 10 ampolas de Sangue do Guardião da Ruína para Kreldig Ungor na Desolação.‡Принесите 10 мозгов гончих Скверны, 10 крыльев пустоты и 10 фиалов крови тюремщика судеб в Пустоши Крелдигу Унгору.‡Bringt 10 Teufelshundgehirne, 10 Netherflügel und 10 Phiolen Verdammniswächterblut zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 지옥사냥개 뇌 10개, 황천의 날개 10개, 파멸의경비대 혈액 10병을 가져가야 합니다.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de Guardiavil a Kreldig Ungor a Desolace.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de guardiavil a Kreldig Ungor a Desolace.‡Apporter 10 Cervelles de gangrechiens, 10 Ailes du Néant et 10 Fioles de Sang de garde funeste à Kreldig Ungor, en Désolace.‡收集10个地狱犬的脑子、10对魔女之翼和10瓶末日看守之血，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10個虛空犬的腦子、10對魔女之翼和10瓶末日守衛之血，把它們交給淒涼之地的克雷迪格‧安戈爾。',
  }
},
[1467] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реагенты для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Recuperadores S.A.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve a Encomenda de Sinismago para Putren Rochamalho em Altaforja.‡Доставьте коробку Скрытного Кудесника в Стальгорн Ройттену Камнемолоту.‡Bringt Linkstatschs Päckchen zu Roetten Steinhammer in Eisenschmiede zurück.‡아이언포지에 있는 로이튼 스톤해머에게 레프트위치의 소포를 가져가야 합니다.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Rapporter la Caisse de Leftwitch à Roetten Martel-de-pierre à Forgefer.‡把莱弗维奇的包裹交给铁炉堡的罗顿·石锤。‡把萊弗維奇的包裹交給鐵爐堡的羅頓·石錘。',
  }
},
[1468] = {
  {
    'A Semana das Crianças‡Детская неделя‡Die Kinderwoche‡어린이 주간‡Semana de los Niños‡Semana de los Niños‡La Semaine des enfants‡儿童周‡兒童週',
    nil,
    'Use o Apito de Órfão Humano para conversar com a criança de quem você vai cuidar durante a Semana da Criança.‡Воспользуйтесь детской свистулькой. Присматривайте за сиротой в течение всей Детской недели.‡Benutzt die Pfeife des Menschenwaisenkindes um während der Kinderwoche mit Eurem Schützling zu sprechen.‡인간 고아 호루라기를 사용해 어린이 주간 동안 돌보게 될 아이와 대화해야 합니다.‡Usa el silbato de huérfano humano para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Usa el silbato de huérfano humano para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Utilisez le Sifflet d\'orphelin humain pour parler à l\'enfant que vous protégerez pendant la Semaine des enfants.‡使用人类孤儿哨与你即将在儿童周期间照顾的孩子进行对话。‡使用人類孤兒哨來和你在兒童週期間要照顧的孩子進行對話。',
  }
},
[1469] = {
  {
    'O caso do Rapsódico‡Рапсодия о болоте‡Rhapsodies Geschichte‡랩소디의 이야기‡El relato de Rapsodio‡El relato de Rapsodio‡L\'histoire de Rhapsody‡拉普索迪的故事‡拉普索迪的故事',
    nil,
    'Leve o Fragmento de Tabuleta Atal\'ai para Brohann Barrilga em Ventobravo.‡Отнесите фрагмент таблички Атал\'ай Брохану Бочкопузу в Штормград.‡Bringt das Schrifttafelfragment der Atal\'ai zu Brohann Fassbauch in Sturmwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 조각을 가져가야 합니다.‡Lleva el trozo de tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Lleva el fragmento de la tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Apportez le Fragment de tablette atal\'ai à Brohann Ventrabière à Hurlevent.‡将阿塔莱石板碎片交给暴风城的布罗哈恩·铁桶。‡將阿塔萊石板碎片交給暴風城的布羅哈恩·鐵桶。',
  }
},
[1470] = {
  {
    '‡Приоткрывая завесу‡Der zerrissene Schleier‡저 너머의 세계‡Descubrir el misterio‡Descubrir el misterio‡Lever le voile‡控制小鬼‡',
    nil,
    '‡Принесите Вении Мартанд 3 черепа гремучих скелетов.‡Bringt Venya Marthand 3 Schädel eines klappernden Skeletts.‡벤야 말선드에게 덜그럭거리는 해골 3개를 가져가야 합니다.‡Lleva 3 calaveras de armadóseos a Venya Marthand.‡Lleva 3 calaveras de armadóseos a Venya Marthand.‡Apportez 3 Crânes de Cliquethorax à Venya Marthand.‡收集3个断骨骷髅的颅骨，把它们交给温雅·玛山德。‡',
  }
},
[1471] = {
  {
    '‡Оковы‡Die Bindung‡균열 봉합‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    '‡При помощи Рун Призыва вызовите и подчините себе демона Бездны, а потом верните Руны Призыва Карендину Халгару в Квартале Магов Подгорода.‡Beschwört mithilfe der Runen der Beschwörung einen Leerwandler, unterwerft ihn und bringt die Runen der Beschwörung dann zu Carendin Halger im Magieviertel von Unterstadt zurück.‡‡Utilizando las Runas de invocación, invoca y domina a un abisario, y después devuélvele las Runas de invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando las Runas de invocación, invoca y domina a un abisario, y después devuélvele las Runas de invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Runes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Runes d\'invocation à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只虚空行者，然后将召唤符文还给诅咒神庙中的凯伦丁·哈加尔。‡',
  }
},
[1472] = {
  {
    '‡Пожиратель Душ‡Verschlinger der Seelen‡영혼의 포식자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡眾魂吞噬者',
    nil,
    '‡Поговорите с Годриком Фарсаном в Храме Проклятых.‡Sprecht mit Godrick Farsan im Tempel der Verdammten.‡‡Habla con Godrick Farsan en el Templo de los Condenados.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Parler à Godrick Farsan au Temple des damnés.‡与诅咒神殿中的高德瑞克·法杉谈一谈。‡',
  }
},
[1473] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 피조물‡Criatura Abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛無中的生物',
    nil,
    'Recupere o Grimório de Egalin e leve-o para Silvério Hidalgo no Templo dos Malditos.‡Найдите гримуар Эгалина и отнесите его Карендину Халгару в Храм Проклятых.‡Beschafft Egalins Zauberfolianten und bringt ihn zu Carendin Halgar in den Tempel der Verdammten.‡에갈린의 흑마법서를 되찾아 저주의 사원에 있는 카렌딘 할가르에게 가져가야 합니다.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Retrouver le Grimoire d\'Egalin et l\'apporter à Carendin Halgar au Temple des damnés.‡夺回埃加林的魔典，把它交给诅咒神庙中的凯伦丁·哈加尔。‡奪回埃加林的魔典，把它交給詛咒神廟中的凱倫丁·哈加爾。',
  }
},
[1474] = {
  {
    '‡Оковы‡Die Bindung‡균열 봉합‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    '‡При помощи Чистых Сердец призовите и подчините себе суккуба, а потом верните Чистые Сердца Карендину Халгару в Квартале Магов Подгорода.‡Beschwört mithilfe der reinen Herzen einen Sukkubus, unterwerft ihn und bringt die reinen Herzen dann zu Carendin Halger im Magieviertel von Unterstadt zurück.‡‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Cœurs purs pour invoquer et soumettre une succube, puis rapporter les Cœurs purs à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只魅魔，然后将纯洁的心还给诅咒神庙里的凯伦丁·哈加尔。‡',
  }
},
[1475] = {
  {
    'No templo de Atal\'Hakkar‡В храм Атал\'Хаккар‡Im Tempel von Atal\'Hakkar‡아탈학카르 신전으로‡En El Templo de Atal\'Hakkar‡En El Templo de Atal\'Hakkar‡Dans le temple d\'Atal\'Hakkar‡进入阿塔哈卡神庙‡進入阿塔哈卡神廟',
    nil,
    'Leve 10 Tabuletas Atal\'ai para Brohann Barrilga em Ventobravo.‡Соберите 10 табличек Атал\'ай для Брохана Бочкопуза из Штормграда.‡Sammelt 10 Schrifttafeln der Atal\'ai für Brohann Fassbauch in Sturmwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 10개를 가져가야 합니다.‡Consigue 10 tablillas Atal\'ai para Brohann Barriliga, en Ventormenta.‡Consigue 10 tablillas de Atal\'ai para Brohann Barriliga, en Ventormenta.‡Rassembler 10 Tablettes atal\'ai pour Brohann Ventrabière à Hurlevent.‡为暴风城的布罗哈恩·铁桶收集10块阿塔莱石板。‡為暴風城的布羅哈恩·鐵桶收集10塊阿塔萊石板。',
  }
},
[1476] = {
  {
    'Corações dos Puros‡Чистые сердца‡Herzen der Reinen‡선한 자의 유품‡Corazones puros‡Corazones puros‡Des cœurs purs‡纯洁者精华‡純潔者之心',
    nil,
    'Leve os corações de Dalin Forjífice e Corma Vilardo para Silvério Hidalgo no Templo dos Malditos.‡Принесите сердца Далина Искусника и Кормы Виллард Карендину Халгару в Храм Проклятых.‡Bringt die Herzen von Dalin Schmiedevater und Corma Villard zu Carendin Halgar im Tempel der Verdammten.‡저주의 사원에 있는 카렌딘 할가르에게 달린의 유품과 코마의 유품을 가져가야 합니다.‡Llévale los corazones de Dalin Forjador y Corma Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Llévale los corazones de Dalin Forjador y Corma Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Apportez les Cœurs de Dalin Forgebusier et de Corma Villard à Carendin Halgar dans le Temple des Damnés.‡将达林和科玛的徽记交给诅咒神殿里的凯伦丁·哈加尔。‡將達林·弗治維特和珂瑪·韋拉德的心臟交給詛咒神殿裡的凱倫丁·哈加爾。',
  }
},
[1477] = {
  {
    'Suprimentos Vitais‡Важные поставки‡Überaus wichtige Vorräte‡중요한 보급품‡Suministros de vital importancia‡Suministros de vital importancia‡Fournitures vitales‡重要的补给‡重要的補給',
    nil,
    'Speak with Watchmaster Sorigal at Darkshire in Duskwood.‡Поговорите с начальником стражи Соригелом в Темнолесье, что в Сумеречном лесу.‡Sprecht mit Wachhauptmann Sorigal in Dunkelhain im Dämmerwald.‡그늘숲의 어둠골에 있는 순찰대장 소리갈과 대화해야 합니다.‡Habla con el maestro de vigilantes Sorigal en Villa Oscura, en el Bosque del Ocaso.‡Habla con el maestro de vigilantes Sorigal en Villa Oscura, en el Bosque del Ocaso.‡Parler au Maître de guet Sorigal à Sombre-Comté, dans le Bois de la Pénombre.‡和暮色森林中夜色镇的守卫队长索里加尔谈一谈。‡到暮色森林的夜色鎮，和守衛隊長索里加爾談話。',
  }
},
[1478] = {
  {
    'Convocação de Hidalgo‡Призыв Халгара‡Halgars Beschwörung‡할가르의 부름‡Las invocaciones de Halgar‡Las invocaciones de Halgar‡Les invocations de Halgar‡哈加尔的召唤‡哈加爾的召喚',
    nil,
    'Fale com Silvério Hidalgo na Cidade Baixa.‡Поговорите с Карендином Халгаром в Подгороде.‡Sprecht mit Carendin Halgar in Unterstadt.‡언더시티에 있는 카렌딘 할가르와 대화해야 합니다.‡Habla con Carendin Halgar en Entrañas.‡Habla con Carendin Halgar en Entrañas.‡Parler à Carendin Halgar à Fossoyeuse.‡与幽暗城的凯伦丁·哈加尔谈一谈。‡與幽暗城的凱倫丁·哈加爾談話。',
  }
},
[1479] = {
  {
    'O Ramo dos Eternos‡Ветвь Вечности‡Der Baum der Ewigen‡영원의 줄기‡La Rama de los Eternos‡La Rama de los Eternos‡Le Rameau des Éternels‡永恒之树‡永恆之樹',
    nil,
    'Leve o órfão ao banco de Darnassus. O banco foi esculpido dentro de uma árvore, conhecida como o Ramo dos Eternos.‡Отведите сироту к банку Дарнаса. Банк находится в дупле дерева, которое называется Ветвь Вечности.‡Begleitet Euren Schützling zur Bank in Darnassus. Die dortige Bank ist in einen Baum gebaut, welcher als der Baum der Ewigen bekannt ist.‡랜디스를 다르나서스 은행에 데려가야 합니다. 은행 자체는 영원의 줄기라고 알려진 나무 안에 있습니다.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Conduire l\'orphelin à la banque de Darnassus. La banque est creusée dans le tronc d\'un arbre connu sous le nom du Rameau des Éternels.‡带着你看护的孤儿去达纳苏斯的银行。银行就坐落在一棵中空的树里，它被称为永恒之树。‡帶著你看護的孤兒去達納蘇斯的銀行。銀行就坐落在一棵中空的樹裡，它被稱為永恆之樹。',
  }
},
[1480] = {
  {
    '‡Осквернитель душ‡Der Verderber‡‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡',
    nil,
    '‡Отнесите рваную демонскую кожу Маурину Костолому в Пустоши.‡Bringt die geschundene Dämonenhaut nach Desolace zu Maurin Knochenspalter.‡‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Apportez une Peau de démon écorché à Maurin Craquossement en Désolace.‡把恶魔之皮拿给凄凉之地的玛乌林·碎骨看看。‡',
  }
},
[1481] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Escalpo de Assombrante para Maurin Rachaosso na Desolação.‡Принесите скальп тенелова Морину Костолому в Пустошах.‡Bringt Maurin Knochenspalter in Desolace einen Schattenpirscherskalp.‡잊혀진 땅에 있는 마우린 본스플리터에게 그림자추적자 머릿가죽을 가져가야 합니다.‡Lleva 1 cabellera Acechasombras a Maurin Partehuesos a Desolace.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Apporter un Scalp de traqueur des ombres à Maurin Craquossement en Désolace.‡给凄凉之地的玛乌林·碎骨带回一张巡影者的头皮。‡帶一張巡影者的頭皮回來給淒涼之地的莫林‧碎骨者。',
  }
},
[1482] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Cristal de Oráculo para Maurin Rachaosso em Desolação.‡Принесите кристалл оракула Морину Костолому в Пустоши.‡Bringt Maurin Knochenspalter in Desolace einen Orakelkristall.‡잊혀진 땅에 있는 마우린 본스플리터에게 예언의 수정구를 가져가야 합니다.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Apporter un Cristal d\'oracle à Maurin Craquossement, en Désolace.‡给凄凉之地的玛乌林·碎骨带回一块神谕水晶。‡帶一塊神諭水晶回來給淒涼之地的莫林‧碎骨者。',
  }
},
[1483] = {
  {
    '[DEPRECATED] Ziz Fizziks‡[DEPRECATED] Зиз Физзикс‡Ziz Fizziks‡[미사용]지즈 피직스‡[DEPRECATED] Ziz Fizziks‡[DEPRECATED] Ziz Fizziks‡[PÉRIMÉ]Ziz Fizzik‡[DEPRECATED] 菲兹克斯‡[DEPRECATED]菲茲克斯',
    nil,
    'Speak with Ziz Fizziks in Windshear Crag.‡Поговорите с Зизом Физзиксом на Утесе Ветрорезов.‡Sprecht mit Ziz Fizziks bei der Scherwindklippe.‡돌발톱 산맥의 칼바람 바위산에 있는 지즈 피직스와 대화해야 합니다.‡Habla con Ziz Fizziks en Risco Cortaviento.‡Habla con Ziz Fizziks en Risco Cortaviento.‡Parler à Ziz Fizzik dans la Combe des Cisailles.‡和狂风峭壁的菲兹克斯谈一谈。‡和狂風峭壁的菲茲克斯談話。',
  }
},
[1484] = {
  {
    '‡Осквернитель душ‡Der Verderber‡‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡',
    nil,
    '‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Stahlklinge in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화해야 합니다.‡Habla con Takata Hoja de Acero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parlez à Takata Lamacier en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡',
  }
},
[1485] = {
  {
    '‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡',
    nil,
    '‡Принесите Рузану 6 голов злобных фамильяров.‡Bringt 6 Köpfe schändlicher Familiare zu Ruzan.‡‡Lleva 6 cabezas de familiar vil a Ruzan.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Apporter 6 Têtes de vils quasits à Ruzan.‡给鲁赞带回6颗邪灵劣魔的头颅。‡',
  }
},
[1486] = {
  {
    'Pelegos anormais‡Шкуры загадочных существ‡Deviatbälge‡돌연변이 통가죽‡Pellejos descarriados‡Pellejos descarriados‡Les peaux de déviants‡变异皮革‡變異皮革',
    nil,
    'Nalpak na Caverna Ululante quer 20 Pelegos Anormais.‡Принесите 20 искаженных шкур Налпаку в Пещерах Стенаний.‡Nalpak in den Höhlen des Wehklagens möchte 20 Deviatbälge.‡통곡의 동굴에 있는 날팍이 돌연변이 통가죽 20개를 가져다 달라고 했습니다.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos de los descarriados.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos descarriados.‡Nalpak, dans les Cavernes des Lamentations, veut 20 Peaux de déviants.‡哀嚎洞穴的纳尔帕克想要20张变异皮革。‡哀嚎洞穴的納爾派克想要20張變異皮革。',
  }
},
[1487] = {
  {
    'Erradicação de Anormais‡Искоренение Скверны‡Ausrottung der Deviat‡돌연변이 짐승 섬멸‡Erradicación de descarriados‡Erradicación de descarriados‡L\'éradication des déviants‡清除变异者‡根絕變異者',
    nil,
    'Ebru, na Caverna Ululante, quer que você mate 7 Assoladores Anormais, 7 Víboras Anormais, 7 Trôpegos Anormais e 7 Presáteras Anormais.‡Убейте для Эбру 7 загадочных опустошителей, 7 загадочных гадюк, 7 загадочных шаркунов и 7 загадочных страхозубов.‡Ebru in den Höhlen des Wehklagens möchte, dass Ihr 7 Deviatverheerer, 7 Deviatvipern, 7 Deviatschlurfer und 7 Deviatschreckensfange tötet.‡통곡의 동굴에 있는 에브루가 돌연변이 약탈자랩터 7마리, 돌연변이 독사 7마리, 돌연변이 늪괴물 7마리, 돌연변이 송곳니천둥매 7마리를 처치해 달라고 했습니다.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrapiés descarriados y 7 colminfernos descarriados.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrapiés descarriados y 7 colminfernos descarriados.‡Ebru, dans les Cavernes des Lamentations, veut que vous tuiez 7 Ravageurs déviants, 7 Vipères déviantes, 7 Traînards déviants et 7 Crocs-d\'effroi déviants.‡哀嚎洞穴的厄布鲁要求你杀掉7只变异破坏者、7只剧毒飞蛇、7只变异蹒跚者和7只变异尖牙风蛇。‡哀嚎洞穴的厄布魯要求你殺掉7隻變異劫毀者、7隻劇毒飛蛇、7隻變異跛行者和7只變異尖牙風蛇。',
  }
},
[1488] = {
  {
    'O corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Mate Lorde Azrethoc e Jugkar Grim\'rod e fale novamente com Takta Laminaço em Desolação.‡Убейте лорда Азретока и Джуккара Грим\'рода и вернитесь к Такате Стальному Клинку в Пустоши.‡Besiegt Lord Azrethoc und Jugkar Grimm\'rod. Kehrt dann zu Takata Stahlklinge in Desolace zurück.‡제왕 아즈레토크와 죽카르 그림로드를 처치하고 잊혀진 땅에 있는 타카타 스틸블레이드에게 가야 합니다.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hoja de Acero a Desolace.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hoja de Acero a Desolace.‡Tuer le seigneur Azrethoc et Jugkar Grim\'rod puis retourner voir Takata Lamacier en Désolace.‡杀掉魔王阿兹雷索克和祖格卡，然后向凄凉之地的塔卡塔·钢刃复命。‡殺掉阿茲雷索克領主和祖格卡，然後向淒涼之地的塔卡塔‧鋼刃覆命。',
  }
},
[1489] = {
  {
    'Hamuul Runa Totem‡Хамуул Рунический Тотем‡Hamuul Runentotem‡하뮬 룬토템‡Hamuul Tótem de Runa‡Hamuul Tótem de Runa‡Hamuul Totem-runique‡哈缪尔·符文图腾‡哈繆爾·符文圖騰',
    nil,
    'Fale com Hamuul Runa Totem.‡Поговорите с Хамуулом Руническим Тотемом.‡Sprecht mit Hamuul Runentotem.‡하뮬 룬토템과 대화해야 합니다.‡Habla con Hamuul Tótem de Runa.‡Habla con Hamuul Tótem de Runa.‡Parler à Hamuul Totem-runique.‡和哈缪尔·符文图腾谈一谈。‡和哈繆爾·符文圖騰談話。',
  }
},
[1490] = {
  {
    'Nara Juba Agreste‡Нара Буйногривая‡Nara Wildmähne‡나라 와일드메인‡Nara Ferocrín‡Nara Ferocrín‡Nara Crin-sauvage‡纳拉·蛮鬃‡納拉·蠻鬃',
    nil,
    'Fale com Nara Juba Agreste.‡Поговорите с Нарой Буйногривой.‡Sprecht mit Nara Wildmähne.‡나라 와일드메인과 대화해야 합니다.‡Habla con Nara Ferocrín.‡Habla con Nara Ferocrín.‡Parler à Nara Crin-sauvage.‡和纳拉·蛮鬃谈一谈。‡和納拉·蠻鬃談話。',
  }
},
[1491] = {
  {
    'Bebidas inteligentes‡Умный напиток‡Klugheitstränke‡영리해지는 음료‡Bebidas de inteligencia‡Bebidas de inteligencia‡Les potions d\'intelligence‡智慧饮料‡智慧飲料',
    nil,
    'Collect 6 portions of Wailing Essence.‡Добудьте 6 порций воющей субстанции.‡Sammelt 6 Portionen Klageessenz.‡통곡의 정수 6병을 수집해야 합니다.‡Reúne 6 unidades de esencia de lamentos.‡Reúne 6 unidades de esencia de lamentos.‡Récupérez 6 doses d\'Essence de lamentation.‡收集6份哀嚎香精，把它们交给棘齿城的麦伯克·米希瑞克斯。‡收集6份哀嚎香精。',
  }
},
[1492] = {
  {
    '[DEPRICATED] Wharfmaster Dizzywig‡[DEPRECATED]Управляющий пристанью Головокружилкинс‡Werftmeister Flunkerblick‡[미사용]부두주임 디지위그‡[DEPRICATED] Maestro de muelles Vertipeluca‡[DEPRICATED] Maestro de muelles Vertipeluca‡[PÉRIMÉ]Maître des quais Tournoupette‡[DEPRECATED] 码头管理员迪兹维格‡[DEPRICATED] 碼頭管理員迪茲維格',
    nil,
    'Leve o Caixote Fechado para o Mestre Portuário Caruncho na Vila Catraca.‡Отнесите надежный ящик управляющему пристанью Головокружилкинcу в Кабестан.‡Bringt die gesicherte Kiste zu Werftmeister Flunkerblick in Ratschet.‡톱니항에 있는 부두주임 디지위그에게 단단히 잠긴 상자를 가져가야 합니다.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Apportez la Caisse sûre au Maître des quais Tournoupette à Cabestan.‡把保险箱交给棘齿城的码头管理员迪兹维格。‡把保險箱交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[1498] = {
  {
    'Caminho da defesa‡Путь защиты‡Weg der Verteidigung‡수호자의 길‡Camino de defensa‡Camino de defensa‡La voie de la défense‡防御之道‡防禦之道',
    nil,
    'Leve 5 Escamas Chamuscadas para Uzzek no Posto Remoto, nos Sertões.‡Принесите 5 оплавленных чешуек Уззеку на Дальнюю заставу в Степях.‡Bringt 5 versengte Schuppen zu Uzzek bei der Fernwacht im Brachland.‡불모의 땅의 천리길 경비초소에 있는 우제크에게 그슬린 비늘 5개를 가져가야 합니다.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Apporter 5 Ecailles roussies à Uzzek au Poste de Guet-Lointain dans les Tarides.‡给贫瘠之地前沿哨所的犹塞克带回5块烧焦的鳞片。‡帶5塊燒焦的鱗片回來給貧瘠之地前沿哨所的猶塞克。',
  }
},
[1499] = {
  {
    '‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡',
    nil,
    '‡Поговорите с Зуритой Востроглазой.‡Sprecht mit Zureetha Fernblick.‡‡Habla con Zureetha Vistalonga.‡Habla con Zureetha Vistalonga.‡Parler à Zureetha Mireloin.‡与祖雷萨谈一谈。‡',
  }
},
[1500] = {
  {
    '‡Пробуждение Наралекса‡Die Erweckung von Naralex‡깨어나는 나랄렉스‡Naralex ambulante‡Naralex ambulante‡Le réveil de Naralex‡唤醒纳拉雷克斯‡',
    nil,
    nil,
  }
},
[1501] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 존재‡Criatura Abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛無中的生物',
    nil,
    'Recupere a Tabuleta de Verga para Gan\'rul Olho de Sangue em Orgrimmar.‡Добудьте табличку Верги для Ган\'рула Кровавого Глаза в Оргриммаре.‡Holt die Schrifttafel der Verga für Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이가 베르가의 서판을 되찾아 오라고 했습니다.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Récupérer la Tablette de Verga pour Gan\'rul Oeil-sanglant à Orgrimmar.‡为奥格瑞玛的甘鲁尔·血眼找回维尔加石板。‡為奧格瑪的甘盧爾·血眼找回維爾加石板。',
  }
},
[1502] = {
  {
    'Thun\'grim Olhafogo‡Тун\'грим Огневзор‡Thun\'grim Brandblick‡툰그림 파이어게이즈‡Thun\'grim Vistafuego‡Thun\'grim Vistafuego‡Thun\'grim Mirefeu‡索恩格瑞姆·火眼‡索恩格瑞姆·火眼',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화해야 합니다.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Mirefeu dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡與貧瘠之地的索恩格瑞姆·火眼談話。',
  }
},
[1503] = {
  {
    'Aço forjado‡Стальные слитки‡Geschmiedeter Stahl‡단조된 강철‡Acero fundido‡Acero fundido‡Acier forgé‡锻造好的钢锭‡鍛造好的鋼錠',
    nil,
    'Leve as Barras de Aço Forjado para Thun\'grim Olhafogo nos Sertões.‡Принесите стальные слитки Тун\'гриму Огневзору из Степей.‡Bringt die Schmiedestahlbarren zu Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈에게 단조된 강철 주괴를 가져가야 합니다.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Apportez les Barres d\'Acier forgé à Thun\'grim Mirefeu dans les Tarides.‡把锻造好的钢锭带给贫瘠之地的索恩格瑞姆·火眼。‡把鍛造好的鋼錠帶給貧瘠之地的索恩格瑞姆·火眼。',
  }
},
[1504] = {
  {
    'A vinculação‡Оковы‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Glifos de Evocação, evoque e subjugue um Emissário do Caos; depois, devolva os Glifos de Evocação para Gan\'rul Olho de Sangue em Orgrimmar.‡Используя знаки призыва, призовите и подчините своей воле демона Бездны. Верните знаки призыва Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mithilfe der Glyphen der Beschwörung einen Leerwandler, unterwerft ihn und bringt dann die Glyphen der Beschwörung zu Gan\'rul Blutauge in Orgrimmar zurück.‡소환의 문양을 사용해 보이드워커를 소환하여 굴복시킨 다음 오그리마에 있는 간룰 블러드아이에게 사용한 소환의 문양을 가져가야 합니다.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser les Glyphes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Glyphes d\'invocation à Gan\'rul Oeil-sanglant, à Orgrimmar.‡召唤并征服一只虚空行者，然后带着召唤铭文向奥格瑞玛的甘鲁尔·血眼回报。‡召喚並征服一隻虛無行者，然後帶著召喚雕紋向奧格瑪的甘盧爾·血眼回報。',
  }
},
[1505] = {
  {
    'Veterano Uzzek‡Ветеран Уззек‡Veteran Uzzek‡노련한 우제크‡Uzzek, el veterano‡Uzzek, el veterano‡Le vétéran Uzzek‡老兵犹塞克‡老兵猶塞克',
    nil,
    'Speak with Uzzek at Far Watch Post.‡Поговорите с Уззеком в Форпосте.‡Sprecht mit Uzzek bei der Fernwacht.‡천리길 경비초소에 있는 우제크과 대화해야 합니다.‡Habla con Uzzek en Avanzada del Puente.‡Habla con Uzzek en Avanzada del Puente.‡Parlez à Uzzek au Poste de Guet-Lointain.‡和前沿哨所的犹塞克谈一谈。‡和前沿哨所的猶塞克談話。',
  }
},
[1506] = {
  {
    'Convocação de Gan\'rul‡Призыв от Ган\'рула‡Gan\'ruls Beschwörung‡간룰의 소환‡Las invocaciones de Gan\'rul‡Las invocaciones de Gan\'rul‡Les invocations de Gan\'rul‡甘鲁尔的召唤‡甘盧爾的召喚',
    nil,
    'Fale com Gan\'rul Olho de Sangue em Orgrimmar.‡Найдите Ган\'рула Кровавого Глаза в Оргриммаре и поговорите с ним.‡Sprecht mit Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이와 대화해야 합니다.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Parler à Gan\'rul Oeil-sanglant à Orgrimmar.‡去奥格瑞玛和甘鲁尔·血眼谈一谈。‡去奧格瑪和甘盧爾·血眼談話。',
  }
},
[1507] = {
  {
    '‡Пожиратель Душ‡Verschlinger der Seelen‡영혼의 포식자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡眾魂吞噬者',
    nil,
    '‡Поговорите с Казулом в расселине Теней.‡Sprecht mit Cazul in der Kluft der Schatten.‡‡Habla con Cazul en el Circo de las Sombras.‡Habla con Cazul en el Circo de las Sombras.‡Parlez à Cazul à la Faille de l\'Ombre.‡和暗影裂口的卡祖尔谈一谈。‡',
  }
},
[1508] = {
  {
    'Cazul cego‡Слепой Казул‡Der blinde Cazul‡눈먼 카줄‡Cazul, el ciego‡Cazul, el ciego‡Cazul l\'aveugle‡盲眼卡祖尔‡盲眼卡祖爾',
    nil,
    'Fale com Zankaja em Orgrimmar.‡Поговорите с Занкайей в Оргриммаре.‡Sprecht mit Zankaja in Orgrimmar.‡오그리마에 있는 잔카자와 대화해야 합니다.‡Habla con Zankaja en Orgrimmar.‡Habla con Zankaja en Orgrimmar.‡Parler à Zankaja à Orgrimmar.‡和奥格瑞玛的赞卡沙谈一谈。‡和奧格瑪的贊卡沙談話。',
  }
},
[1509] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Gazrog na Encruzilhada.‡Поговорите с Газрогом в Перекрестке.‡Sprecht mit Gazrog beim Wegekreuz.‡십자로에 있는 가즈록과 대화해야 합니다.‡Habla con Gazrog en El Cruce.‡Habla con Gazrog en El Cruce.‡Parler à Gazrog à la Croisée.‡找到十字路口的加兹罗格并和他谈一谈。‡找到十字路口的加茲羅格並和他談話。',
  }
},
[1510] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Ken\'zigla em Malaka\'jin.‡Поговорите с Кен\'зиглой в Малака\'джине.‡Sprecht mit Ken\'zigla am Malaka\'jin.‡말라카진에 있는 켄지글라와 대화해야 합니다.‡Habla con Ken\'zigla en Malaka\'jin.‡Habla con Ken\'zigla en Malaka\'jin.‡Parler à Ken\'zigla, au village de Malaka\'jin.‡找到玛拉卡金的肯兹格拉并和他谈一谈。‡找到瑪拉卡金的肯茲格拉並和他談話。',
  }
},
[1511] = {
  {
    'Trago do Ken\'zigla‡Зелье Кен\'зиглы‡Ken\'ziglas Trunk‡켄지글라의 술‡Jarabe de Ken\'zigla‡Jarabe de Ken\'zigla‡Breuvage de Ken\'zigla‡肯兹格拉的伤药‡肯茲格拉的傷藥',
    nil,
    'Leve o Trago do Ken\'zigla para o Bruto Logmar no Acampamento Taurajo.‡Отнесите зелье Кен\'зиглы рубаке Логмару в Лагерь Таурахо.‡Bringt Ken\'ziglas Trunk zu Grunzer Logmar im Camp Taurajo.‡타우라조 야영지에 있는 그런트 로그마르에게 켄지글라의 술을 가져가야 합니다.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Apporter le Breuvage de Ken\'zigla au grunt Logmar, au Camp Taurajo.‡将肯兹格拉的伤药交给陶拉祖营地的步兵劳格玛。‡將肯茲格拉的傷藥交給陶拉祖營地的蠻兵勞格瑪。',
  }
},
[1512] = {
  {
    '‡Дар любви‡Die Liebesgabe‡‡Un regalo de amor‡Un regalo de amor‡Le cadeau de l\'amour‡爱的礼物‡',
    nil,
    '‡Отнесите подвеску, испачканную грязью, Ган\'рулу Кровавому Глазу в Оргриммар.‡Bringt den schmutzverkrusteten Anhänger zu Gan\'rul Blutauge in Orgrimmar.‡‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Apportez le Pendentif de poussière à Gan\'rul Oeil-sanglant à Orgrimmar.‡把沾满泥土的坠饰带给奥格瑞玛的甘鲁尔·血眼。‡',
  }
},
[1513] = {
  {
    '‡Оковы‡Die Bindung‡균열 봉합‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    '‡Призовите и подчините суккуба с помощью подвески Дограна. Вернуть подвеску Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mithilfe von Dograns Anhänger einen Sukkubus, unterwerft ihn und bringt dann Dograns Anhänger zu Gan\'rul Blutauge in Orgrimmar zurück.‡‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser le Pendentif de Dogran pour invoquer et soumettre une succube, puis rapporter le Pendentif de Dogran à Gan\'rul Oeil-sanglant, à Orgrimmar.‡召唤并征服一只魅魔，然后将多格兰的坠饰还给奥格瑞玛的甘鲁尔·血眼。‡',
  }
},
[1514] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[1515] = {
  {
    'O cativeiro de Dogran‡Догран в плену‡Dograns Gefangenschaft‡포로가 된 도그란‡El cautiverio de Dogran‡El cautiverio de Dogran‡La captivité de Dogran‡多格兰之囚‡多格蘭之囚',
    nil,
    'Leve o Trago do Ken\'zigla para Dogran nos Sertões.‡Отнесите зелье Кен\'зиглы Дограну в Степях.‡Bringt Ken\'ziglas Trunk zu Dogran im Brachland.‡불모의 땅에 있는 도그란에게 켄지글라의 술을 가져가야 합니다.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Apporter le Breuvage de Ken\'zigla à Dogran dans les Tarides.‡把肯兹格拉的伤药带给贫瘠之地的多格兰。‡把肯茲格拉的傷藥帶給貧瘠之地的多格蘭。',
  }
},
[1516] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Leve 2 Cascos de Espreitador Vil para Ranago Arauto da Terra no Vale das Provações.‡Принесите Канаге заклинателю земли 2 копыта ловцов Скверны.‡Bringt 2 Teufelspirscherhufe zu Canaga Erdenrufer im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 하급 지옥사냥개 발굽 2개를 가져가야 합니다.‡Lleva 2 pezuñas de acechador vil a Canaga Clamatierras en el Valle de los Retos.‡Lleva 2 pezuñas de acechador vil a Canaga Clamatierras en el Valle de los Retos.‡Apporter 2 Sabots de traqueur gangrené à Canaga Hucheterre dans la Vallée des Épreuves.‡给试炼谷的坎纳甘·地鸣带去2只地狱捕猎者的蹄子。‡帶2隻惡魔潛獵者的蹄子給試煉谷的坎納甘·地鳴。',
  }
},
[1517] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Encontre a Rocha dos Espíritos e beba o Sapta da Terra.‡Найдите Священный Камень и выпейте рядом с ним сапту Земли.‡Sucht den Geisterfelsen und trinkt das Erdsapta.‡정기 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Trouver le Rocher des esprits et boire le Sapta de terre.‡找到灵魂石地，在那里喝下大地灵契。‡找到靈魂石地，在那裡喝下大地靈契。',
  }
},
[1518] = {
  {
    '‡Зов Земли‡Ruf der Erde‡대지의 부름‡La llamada de la tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡',
    nil,
    '‡Отнесите необработанный кварц Канаге заклинателю земли в Долину Испытаний.‡Bringt den Rohquarz zu Canaga Erdenrufer im Tal der Prüfungen.‡‡Lleva el cuarzo en bruto a Canaga Clamatierras en el Valle de los Retos.‡Lleva el cuarzo en bruto a Canaga Clamatierras en el Valle de los Retos.‡Apportez le Quartz brut à Canaga Hucheterre dans la Vallée des Épreuves.‡把粗石英交给试炼谷的坎纳甘·地鸣。‡',
  }
},
[1519] = {
  {
    '‡Зов Земли‡Ruf der Erde‡대지의 부름‡La llamada de la tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡',
    nil,
    '‡Принесите 2 порции ритуальной мази провидице Воронье Перо в Лагерь Нараче.‡Bringt 2 Dosen Ritualsalbe zu Seherin Rabenfeder im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 의식의 물약 2개를 가져가야 합니다.‡Lleva 2 dosis de bálsamo ritual a la vidente Pluma de Cuervo al Campamento Narache.‡Lleva 2 dosis de bálsamo ritual a la vidente Pluma de Cuervo al Campamento Narache.‡Apporter 2 Applications de Baume rituel au Prophète Plume-de-corbeau au Camp Narache.‡给纳拉其营地的鸦羽先知带回2份仪式药膏。‡',
  }
},
[1520] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Encontre a Rocha dos Kodos e beba o Sapta da Terra.‡Найдите Дольмен Кодо и выпейте сапту земли.‡Sucht den Kodofels und trinkt das Erdsapta.‡코도 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Trouver le Rocher des kodos et boire le Sapta de terre.‡找到科多石并喝下大地灵契。‡找到科多石並喝下大地靈契。',
  }
},
[1521] = {
  {
    '‡Зов Земли‡Ruf der Erde‡대지의 부름‡La llamada de la tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡',
    nil,
    '‡Отнесите грубый кварц провидице Воронье Перо в Лагерь Нараче.‡Bringt den Rohquarz zu Seherin Rabenfeder im Camp Narache.‡‡Lleva el cuarzo en bruto a la vidente Pluma de Cuervo al Campamento Narache.‡Lleva el cuarzo en bruto a la vidente Pluma de Cuervo al Campamento Narache.‡Apportez le Quartz brut à la prophétesse Plume-de-corbeau au Camp Narache.‡将粗石英带给纳拉其营地的鸦羽先知。‡',
  }
},
[1522] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1523] = {
  {
    '‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡',
    nil,
    '‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡',
  }
},
[1524] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Leve a Tocha da Chama Latente para Telf Joolam em Durotar.‡Отнесите факел Дремлющего Пламени Телфу Джуламу в Дуротаре.‡Bringt die Fackel der schlafenden Flamme zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 희미한 불씨의 횃불을 가져가야 합니다.‡Lleva la antorcha de la Llama durmiente a Telf Joolam a Durotar.‡Lleva la antorcha de la Llama Latente a Telf Joolam a Durotar.‡Apportez la Torche de la flamme dormante à Telf Joolam en Durotar.‡把眠炎火炬带给杜隆塔尔的泰尔夫·祖拉姆。‡把眠焰火炬帶給杜洛塔的泰爾夫·祖拉姆。',
  }
},
[1525] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Traga 1 Piche Ígneo e 1 Bornal de Reagentes para Telf Joolam em Durotar.‡Принесите 1 порцию огненной смолы и 1 мешочек с реагентами Телфу Джуламу в Дуротаре.‡Bringt 1 Feuerteerstück und 1 Reagenzienbeutel zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 불붙인 타르 1개와 시약 주머니 1개를 가져가야 합니다.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Apporter 1 Goudron de feu et 1 Bourse de réactifs à Telf Joolam en Durotar.‡找到1个火焰焦油和1个试剂袋，把它们交给杜隆塔尔的泰尔夫·祖拉姆。‡找到1個火焰焦油和1個試劑袋，把它們交給杜洛塔的泰爾夫·祖拉姆。',
  }
},
[1526] = {
  {
    '‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡',
    nil,
    '‡Сразитесь с низшим воплощением огня и поместите светящийся уголек в жаровню в святилище Неугасимого Пламени.‡Besiegt die geringe Feuermanifestation und legt Glut in die Kohlenpfanne auf dem Schrein der ewigen Flamme.‡‡Derrota a la Manifestación de fuego menor y coloca las ascuas ardientes sobre el altar de la llama eterna.‡Derrota a la Manifestación de fuego menor y coloca las ascuas ardientes sobre el altar de la llama eterna.‡Vaincre la Manifestation de feu mineure, et placer sa Braise rougeoyante dans le brasero, en haut de l\'Autel de la flamme éternelle.‡击败火焰之魂，将余烬放在恒焰圣殿屋顶的火盆里。‡',
  }
},
[1527] = {
  {
    '‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡',
    nil,
    '‡Принесите факел Неугасимого Пламени Краналу Фиссу в Степи.‡Bringt die Fackel der ewigen Flamme zu Kranal Fiss im Brachland.‡‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Apportez la Torche de la flamme éternelle à Kranal Fiss dans les Tarides.‡将恒焰火炬交给贫瘠之地的卡纳尔·菲斯。‡',
  }
},
[1528] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислену Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1529] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислену Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1530] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Find Brine at Blackthorn Ridge in Southern Barrens.‡Отыщите Брин на Хребте Черных Шипов в Южных Степях.‡Sucht Brine beim Schwarzdorngrat im Südlichen Brachland.‡불모의 땅 남부, 검은가시 마루에 있는 브린을 찾아야 합니다.‡Encuentra a Salmuera en la Loma Espina Negra, en Los Baldíos del Sur.‡Encuentra a Salmuera en la Loma Espina Negra, en Los Baldíos del Sur.‡Trouver Brine à la Crête de Noirépine, dans les Tarides du Sud.‡到南贫瘠之地的黑棘山去找到布瑞恩。‡到南貧瘠之地的黑棘山去找布瑞恩。',
  }
},
[1531] = {
  {
    'Clamor do ar‡Зов Воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Wolkendeuter in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Oeil-des-nuages aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·雲眼。',
  }
},
[1532] = {
  {
    '‡Зов Воздуха‡Ruf der Luft‡‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡',
    nil,
    '‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Wolkendeuter in Tausend Nadeln.‡‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Oeil-des-nuages aux Mille pointes.‡到千针石林去找普拉特·白云。‡',
  }
},
[1533] = {
  {
    '‡*NYI* Зов воздуха‡<NYI> Ruf der Luft‡‡<NYI> La llamada del aire‡<NYI> La llamada del aire‡<NYI>L\'appel de l\'air‡‡',
    nil,
    nil,
  }
},
[1534] = {
  {
    '‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡',
    nil,
    '‡Наполните пустой синий бурдюк для воды в руинах Звездной Пыли и отнесите воду Брин из Степей.‡Füllt den leeren blauen Wasserschlauch bei den Sternenstaubruinen im Eschental und kehrt zu Brine im Brachland zurück.‡‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre bleue vide aux Ruines de Chimétoile en Orneval et la rapporter à Brine dans les Tarides.‡到灰谷的星尘废墟去，将空的蓝色水囊盛满泉水，然后把它交给贫瘠之地的布瑞恩。‡',
  }
},
[1535] = {
  {
    '‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡',
    nil,
    '‡Наполните пустой коричневый бурдюк для воды в источнике ниже хижины Брин и отнесите ей воду.‡Füllt den leeren braunen Wasserschlauch im Wasserloch unterhalb von Brines Hütte und kehrt damit zu Brine im Brachland zurück.‡‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Remplir l\'Outre marron vide au trou d\'eau, derrière la hutte de Brine, puis rapportez-lui la, dans les Tarides.‡到野猪人的水池去，用井中的水装满空的棕色水囊，然后把水囊交给贫瘠之地的布瑞恩。‡',
  }
},
[1536] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Vermelho Vazio no poço da Serraria Tarren e entregue-o para Salma nos Sertões.‡Наполните пустой красный бурдюк для воды в Мельнице Таррен и отнесите воду Брин в Степи.‡Füllt den leeren roten Wasserschlauch am Brunnen in Tarrens Mühle und kehrt zu Brine im Brachland zurück.‡타렌 제분소에 있는 우물에서 빈 빨간색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre rouge vide au puits de Moulin-de-Tarren et retourner voir Brine dans les Tarides.‡用塔伦米尔的井水装满空的红色水囊，然后把它交给贫瘠之地的布瑞恩。‡用塔倫米爾的井水裝滿空的紅色水囊，然後把它交給貧瘠之地的布瑞恩。',
  }
},
[1537] = {
  {
    '‡*NYI* Зов воздуха‡<NYI> Ruf der Luft‡‡<NYI> La llamada del aire‡<NYI> La llamada del aire‡<NYI>L\'appel de l\'air‡‡',
    nil,
    nil,
  }
},
[1538] = {
  {
    '‡*NYI* Зов воздуха‡<NYI> Ruf der Luft‡‡<NYI> La llamada del aire‡<NYI> La llamada del aire‡<NYI>L\'appel de l\'air‡‡',
