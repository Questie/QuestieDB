},
[6068] = {
  {
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Speak with Thotar at Razor Hill in Durotar.‡Поговорите с Тотаром в Колючем Холме, что в Дуротаре.‡Sprecht mit Thotar in Klingenhügel in Durotar.‡듀로타의 칼바위 언덕에 있는 소타르와 대화해야 합니다.‡Habla con Thotar en Cerrotajo, en Durotar.‡Habla con Thotar en Cerrotajo, en Durotar.‡Parler à Thotar, à Tranchecolline, en Durotar.‡与杜隆塔尔剃刀岭的索塔尔谈一谈。‡到杜洛塔的剃刀嶺找索塔爾談話。',
  }
},
[6069] = {
  {
    '‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡',
