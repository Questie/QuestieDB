[31463] = {
  {
    'Espírito da Ira derrotado‡Spirit of Anger Defeated‡Geist des Zorns besiegt‡분노의 영혼 꺾음‡Espíritu de la ira derrotado‡‡Esprit de colère vaincu‡击败愤怒之灵‡',
