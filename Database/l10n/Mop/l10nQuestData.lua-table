[31829] = {
  {
    'Evento de rastreio: Belonave da Aliança parte‡Выслеживание: отход боевого корабля Альянса‡Verfolgungsereignis: Kanonenboot der Allianz bricht auf‡이벤트 추적: 얼라이언스 비행포격선 출발‡Tracking Event: Alliance Gunship Leaves‡‡Tracking Event: Alliance Gunship Leaves‡追踪事件：联盟炮艇的离开‡',
