[999] = {
  {
    '‡Когда сны превращаются в кошмары‡Wenn Träume zu Alpträumen werden‡꿈이 악몽으로 바뀌면‡Cuando los sueños se vuelven pesadillas‡Cuando los sueños se vuelven pesadillas‡Quand les rêves tournent au cauchemar‡噩梦成真‡',
