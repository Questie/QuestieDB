},
[1683] = {
  {
    '‡Ворлус Подлое Копыто‡Vorlus Elendshuf‡볼루스 바일후프‡Vorlus Pezuñavil‡Vorlus Pezuñavil‡Vorlus Vilsabot‡沃鲁斯·邪蹄‡沃魯斯·邪蹄',
    nil,
    '‡Принесите рог Ворлуса Эланарии из Дарнаса.‡Bringt das Horn von Vorlus zu Elanaria in Darnassus.‡‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Apportez la Corne de Vorlus Vilsabot à Elanaria, à Darnassus.‡将沃鲁斯的角交给达纳苏斯的艾兰娜瑞。‡',
  }
},
[1684] = {
  {
    nil,
    nil,
    '‡Поговорите с Эланарией.‡Sprecht mit Elanaria.‡‡Habla con Elanaria.‡Habla con Elanaria.‡Parler à Elanaria.‡和艾兰娜瑞谈一谈。‡',
  }
},
[1685] = {
  {
    'Convocação de Gakin‡Приглашение Гакина‡Gakins Beschwörung‡게이킨의 부름‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡加科因的召喚',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고해야 합니다.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le Quartier des Mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向『黑暗縛靈師』加金報到。',
  }
},
[1686] = {
  {
    '‡Тень Элуры‡Eluras Schemen‡‡La sombra de Elura‡La sombra de Elura‡L\'Ombre d\'Elura‡艾鲁拉的阴影‡',
    nil,
    '‡Принесите 8 партий элунитовой руды и медальон Элуры Эланарии из Дарнаса.‡Bringt 8 Ladungen Eluniterz und das Medaillon von Elura zu Elanaria in Darnassus.‡‡Lleva 8 piezas de mineral de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Lleva 8 piezas de mineral de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Apporter 8 Caisses de minerai d\'élunite et le Médaillon d\'Elura à Elanaria à Darnassus.‡将艾鲁拉的徽章和8块月神矿石交给达纳苏斯的艾兰娜瑞。‡',
  }
},
[1687] = {
  {
    'Farol assombrado‡Маяк с привидениями‡Der gruselige Leuchtturm‡무서운 등대‡El faro fantasma‡El faro fantasma‡Le phare hanté‡幽灵灯塔‡幽靈燈塔',
    nil,
    'Leve o órfão ao Farol, na costa de Cerro Oeste.‡Отведите сироту к маяку на побережье Западного Края.‡Besucht mit Eurem Schützling den Leuchtturm an der Küste von Westfall.‡랜디스를 서부 몰락지대 해안에 있는 등대로 데려가야 합니다.‡Lleva al huérfano a ver el faro de la cosa de los Páramos de Poniente.|n‡Lleva al huérfano a ver el faro de la cosa de los Páramos de Poniente.|n‡Emmenez l\'orphelin voir le phare sur la côte de la marche de l\'Ouest.‡带着你看护的孤儿去西部荒野海岸边的灯塔。‡帶著你看護的孤兒去西部荒野海岸邊的燈塔。',
  }
},
[1688] = {
  {
    'Surena Caledon‡Сурена Каледон‡Surena Caledon‡슈레나 캘리돈‡Surena Caledon‡Surena Caledon‡Surena Caledon‡苏伦娜·凯尔东‡蘇倫娜·凱爾東',
    nil,
    'Recupere a Gargantilha de Surena e entregue-a a Gakin, o Neromante, em Ventobravo.‡Верните колье Кровавого камня Гакину Темной Вязи в Штормград.‡Beschafft Surenas Halsreif für Gakin den Dunkelbinder in Sturmwind.‡슈레나의 목장식을 찾아 스톰윈드에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Retrouver le Foulard de Surena pour Gakin le Tisse-noir à Hurlevent.‡为暴风城的黑暗缚灵者加科因夺回苏伦娜的项圈。‡為暴風城的『黑暗縛靈師』加金奪回蘇倫娜的頸飾。',
  }
},
[1689] = {
  {
    '‡Оковы‡Die Bindung‡균열 봉합‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    '‡С помощью колье Кровавого камня призовите и подчините демона Бездны, затем верните колье Кровавого камня Гакину Темнопряду.‡Beschwört mithilfe des Blutsteinhalsreifs einen Leerwandler, unterwerft ihn und bringt dann den Blutsteinhalsreif zu Gakin dem Dunkelbinder in Sturmwind zurück.‡‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Utilisez l\'Écharpe de pierre de sang pour invoquer et soumettre un marcheur du Vide, puis rapportez-la à Gakin le Tisse-noir, à Hurlevent.‡召唤并制服一个虚空行者，然后将血石颈环还给暴风城的黑暗缚灵者加科因。‡',
  }
},
[1690] = {
  {
    'O erro dos Errantes‡Расправа над Скитальцами Пустыни‡Wüstenläufergerechtigkeit‡사막유랑단 처단‡Justicia para los Vagayermos‡Justicia para los Vagayermos‡Châtier les Bat-le-désert‡废土的公正‡制裁廢土遊民',
    nil,
    'Elimine 10 Bandidos e Ladrões Errantes a leste de Geringontzan, depois fale novamente com o Engenheiro-chefe Silvadágua.‡Убейте 10 бандитов и 10 воров из шайки Скитальцев Пустыни на востоке от Прибамбасска и возвращайтесь к главному инженеру Чепухастеру.‡Erledigt 10 Banditen und Diebe der Wüstenläufer östlich von Gadgetzan und meldet Euch dann wieder bei Chefingenieur Bilgenritzel.‡가젯잔의 동쪽에서 10명의 사막유랑단 약탈자와 좀도둑을 처치한 후, 선임기술자 빌지위즐에게 돌아와 보고해야 합니다.‡Acaba con 10 bandidos y ladrones Vagayermos al este de Gadgetzan y después vuelve a ver al ingeniero jefe Pasaquillas.‡Acaba con 10 bandidos y ladrones Vagayermos al este de Gadgetzan y después vuelve a ver al ingeniero jefe Pasaquillas.‡Abattez 10 Bandits et 10 Larrons Bat-le-désert à l\'est de Gadgetzan, puis revenez faire votre rapport à l\'ingénieur en chef Vizisanie.‡去加基森的东面杀掉10个废土窃贼和10个废土强盗，然后向总工程师比格维兹复命。‡去加基森的東面殺掉10個廢土竊賊和10個廢土強盜，然後向首席工程師膨嘯覆命。',
  }
},
[1691] = {
  {
    'O enterro dos Errantes‡Еще одна расправа над Скитальцами Пустыни‡Noch mehr Wüstenläufergerechtigkeit‡사막유랑단 추가 처단‡Más justicia para los Vagayermos‡Más justicia para los Vagayermos‡Continuer à châtier les Bat-le-désert‡废土的公正‡制裁更多廢土遊民',
    nil,
    'Elimine 10 Magos das Sombras Errantes, 8 Ladinos Errantes e 6 Assassinos Errantes para o Engenheiro-chefe Silvadágua em Geringontzan.|n‡Убейте 10 темных магов, 8 разбойников и 6 убийц из шайки Скитальцев Пустыни по поручению главного инженера Чепухастера из Прибамбасска.‡Erledigt 10 Schattenmagier der Wüstenläufer, 8 Schurken der Wüstenläufer und 6 Auftragsmörder der Wüstenläufer für Chefingenieur Bilgenritzel in Gadgetzan.‡가젯잔에 있는 선임기술자 빌지위즐을 위해 사막유랑단 도적 8명, 사막유랑단 암살자 6명, 사막유랑단 어둠마법사 10명을 처치해야 합니다.‡Acaba con 10 magos oscuros Vagayermos, 8 pícaros Vagayermos y 6 asesinos Vagayermos para el ingeniero jefe Pasaquillas de Gadgetzan.|n‡Acaba con 10 magos oscuros Vagayermos, 8 pícaros Vagayermos y 6 asesinos Vagayermos para el ingeniero jefe Pasaquillas de Gadgetzan.|n‡Tuez 10 Mages de l\'ombre Bat-le-désert, 8 Voleurs Bat-le-désert et 6 Assassins Bat-le-désert pour l\'ingénieur en chef Vizisanie à Gadgetzan.‡杀死10个废土暗法师、8个废土游荡者和6个废土刺客，然后向加基森的总工程师比格维兹报告。‡殺死10個廢土暗法師、8個廢土遊蕩者和6個廢土刺客，然後向加基森的首席工程師膨嘯報告。',
  }
},
[1692] = {
  {
    'Mathiel, o ferreiro‡Кузнец Матиль‡Schmied Mathiel‡대장장이 메시엘‡Mathiel, el herrero‡Mathiel, el herrero‡Forgeron Mathiel‡铁匠玛希尔‡',
    nil,
    'Leve o Caixote de Elunita para Mathiel, o Ferreiro. ‡Отнесите сундук элунита кузнецу Матилю.‡Bringt die Kiste mit Elunit zu Schmied Mathiel.‡엘루니트 상자를 대장장이 메시엘에게 가져가야 합니다.‡Lleva la caja de elunita al herrero Mathiel.‡Lleva el estuche de elunita al herrero Mathiel.‡Apportez la Caisse d\'élunite au Forgeron Mathiel.‡把这箱月神矿石交给铁匠玛希尔。‡',
  }
},
[1693] = {
  {
    '‡Оружие из элунита‡Waffen aus Elunit‡‡Armas de Elunita‡Armas de Elunita‡Armes en élunite‡月神武器‡',
    nil,
    nil,
  }
},
[1698] = {
  {
    'Yorus Cervevada‡Йорус Ячменовар‡Yorus Gerstenbräu‡요루스 발리브루‡Yorus Cebadiz‡Yorus Cebadiz‡Yorus Brasselorge‡犹鲁斯·麦酒‡猶魯斯·麥酒',
    nil,
    'Fale com Yorus Cervevada.‡Поговорите с Йорусом Ячменоваром.‡Sprecht mit Yorus Gerstenbräu.‡요루스 발리브루와 대화해야 합니다.‡Habla con Yorus Cebadiz.‡Habla con Yorus Cebadiz.‡Parler à Yorus Brasselorge.‡与犹鲁斯·麦酒谈一谈。‡與猶魯斯·麥酒談話。',
  }
},
[1699] = {
  {
    'Desafio da Retibana‡Ретбанский вызов‡Der Rethbanspießrutenlauf‡레스밴 도전‡El guantelete de Rethban‡El guantelete de Rethban‡Le défi de Rethban‡往返瑞斯班洞穴‡往返瑞斯班洞穴',
    nil,
    'Entre nas Cavernas Retibanas, chegue à primeira bifurcação e volte até Yorus Cervevada no tempo estipulado.|n|nMorrer e libertar o espírito não é permitido.‡Войдите в пещеры Ретбана, доберитесь до первой развилки и вернитесь к Йорусу Ячменовару за отведенное время.|n|nВы не должны умирать и освобождать свой дух.‡Betretet die Rethbanhöhlen, geht bis zur ersten Gabelung und kehrt innerhalb der zulässigen Zeit zu Yorus Gerstenbräu zurück.|n|nIhr dürft nicht sterben und Euren Geist befreien.‡주어진 시간 내에 레스밴 동굴의 첫번째 분기점까지 들어갔다가 요루스 발리브루에게 가야 합니다.|n|n죽어서 영혼이 빠져나가서는 안 됩니다.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|n|nNo debes morir y liberar tu espíritu.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|n|nNo debes morir y liberar tu espíritu.‡Entrer dans les Cavernes de Rethban jusqu\'à la première fourche, et revenir voir Brasselorge dans le temps imparti.|n|nVous ne devez pas mourir et libérer votre esprit.‡进入瑞斯班洞穴，然后在规定的时间内回到犹鲁斯·麦酒那里。|n|n在整个过程中你都不能死掉或者释放灵魂，否则任务就宣告失败。‡進入瑞斯班洞穴，然後在規定的時間內回到猶魯斯·麥酒那裡。|n|n在整個過程中你都不能死掉或者釋放靈魂，否則任務就宣告失敗。',
  }
},
[1700] = {
  {
    nil,
    nil,
    '‡Отнесите записки Фьюрена Гриманду Элмору.‡Bringt Furens Notizen zu Grimand Elmore.‡‡Lleva las notas de Furen a Grimand Elmore.‡Lleva las notas de Furen a Grimand Elmore.‡Porter les Notes de Furen à Grimand Elmore.‡把弗伦的笔记交给格瑞曼德·艾尔默。‡',
  }
},
[1701] = {
  {
    'Malha endurecida a fogo‡Закаленный доспех‡Feuergehärteter Panzer‡불에 달궈 만든 갑옷‡Armadura de malla endurecida con fuego‡Armadura de malla endurecida con fuego‡Une cotte de mailles en acier trempé‡弗伦的铠甲‡淬火鎖甲',
    nil,
    'Colete as matérias-primas pedidas por Furen Barbalonga e leve-as para ele em Ventobravo.‡Соберите все необходимые материалы для Фьюрена Длинноборода и отнесите их в Штормград.‡Sammelt die Materialien, die Furen Langbart benötigt, und bringt sie zu ihm nach Sturmwind.‡스톰윈드에 있는 푸렌 롱비어드에게 그가 필요로 하는 재료들을 모아서 가져가야 합니다.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Réunir les matériaux dont Furen Barbe-longue a besoin et lui apporter à Hurlevent.‡收集必需的材料，将它们交给暴风城的弗伦·长须。‡收集必需的材料，將它們交給暴風城的弗倫·長鬚。',
  }
},
[1702] = {
  {
    'O fabricante de escudos‡Щитник‡Der Schildschmied‡방패 상인‡El forjador de escudos‡El forjador de escudos‡Fabricant de bouclier‡铸盾师‡鑄盾師',
    nil,
    'Leve o Barril de Grogue para Furen Barbalonga.‡Отнесите бочонок жгучего пива Фьюрену Длиннобороду.‡Bringt das Fässlein mit Gerstenbräu zu Furen Langbart.‡푸렌 롱비어드에게 스칼더 술통을 가져가야 합니다.‡Lleva el barril de brebaje a Furen Barbalarga.‡Lleva el barril de brebaje a Furen Barbalarga.‡Apporter la Barrique de Scalder à Furen Barbe-longue.‡将这桶热酒交给弗伦·长须。‡將這桶熱酒交給弗倫·長鬚。',
  }
},
[1703] = {
  {
    nil,
    nil,
    '‡Отнесите Матилю записки Фьюрена.‡Bringt Furens Notizen zu Mathiel.‡‡Lleva las notas de Furen a Mathiel.‡Lleva las notas de Furen a Mathiel.‡Apporter les Notes de Furen à Mathiel.‡把弗伦的笔记交给玛希尔。‡',
  }
},
[1704] = {
  {
    '‡Клацморт Гайкокрут‡Klockmort Spannersplint‡클락몰트 스패너스판‡Klockmort Palmalicate‡Klockmort Palmalicate‡Pléthorloge Cléventail‡科罗莫特·钢尺‡科羅莫特·鋼尺',
    nil,
    '‡Отнесите записки Фьюрена Клацморту Гайкокруту.‡Bringt Furens Notizen zu Klockmort Spannsplint.‡‡Lleva las notas de Furen a Klockmort Palmalicate.‡Lleva las notas de Furen a Klockmort Palmalicate.‡Apporter les Notes de Furen à Pléthorloge Cléventail.‡把弗伦的笔记交给科罗莫特·钢尺。‡',
  }
},
[1705] = {
  {
    'Sangue Ardente‡Пылающая кровь‡Brennendes Blut‡불타는 혈액‡Sangre ardiente‡Sangre ardiente‡Le sang ardent‡燃烧之血‡燃燒之血',
    nil,
    'Leve 20 ampolas de Sangue Ardente e 1 Pedra Ardente para Grimand Elmore em Ventobravo.‡Принесите 20 сосудов горящей крови и 1 горящий камень Гриманду Элмору из Штормграда.‡Bringt 20 Phiolen brennendes Blut und 1 brennenden Fels zu Grimand Elmore in Sturmwind.‡스톰윈드에 있는 그리만트 엘모어에게 불타는 혈액 20개와 불타는 돌 1개를 가져가야 합니다.‡Lleva 20 viales de sangre ardiente y 1 roca ardiente a Grimand Elmore en Ventormenta.‡Lleva 20 viales de sangre ardiente y 1 roca ardiente a Grimand Elmore en Ventormenta.‡Rapporter 20 Fioles de sang ardent et 1 Roc ardent à Grimand Elmore à Hurlevent.‡把20瓶燃烧之血和1块燃烧之石交给暴风城的格瑞曼德·艾尔默。‡把20瓶燃燒之血和1塊燃燒之石交給暴風城的格瑞曼德·艾爾默。',
  }
},
[1706] = {
  {
    '‡Доспехи Гриманда‡Grimands Rüstung‡‡La armadura de Grimand‡La armadura de Grimand‡L\'armure de Grimand‡格瑞曼德的铠甲‡',
    nil,
    nil,
  }
},
[1707] = {
  {
    'Bolsas de água pra refrescar‡Награда за воду‡Wasserbeutelkopfgeld‡물주머니 현상금‡Cazador de faltriqueras de agua‡Cazador de faltriqueras de agua‡Une prime pour les outres‡收集水袋‡收集水袋',
    nil,
    'Leve 5 Bolsas de Água do Errante para o Operador de Torneira Rastamala em Geringontzan.‡Принесите 5 бурдюков Скитальцев Пустыни оператору крана Тормозиллеру в Прибамбасск.‡Bringt Leitungshahnmaschinist Lochbeutel in Gadgetzan 5 Wasserbeutel eines Wüstenläufers.‡가젯잔에 있는 양수기기사 루글룬켓에게 사막유랑단 물주머니 5개를 가져가야 합니다.‡Llévale 5 faltriqueras de agua de Vagayermos al grifoperador Llantalunket, que está en Gadgetzan.‡Llévale 5 faltriqueras de agua de Vagayermos al grifoperador Llantalunket, que está en Gadgetzan.‡Apporter 5 Outres de Bat-le-désert à l\'Opérateur du robinet Trimballot à Gadgetzan.‡收集5只废土水袋，把它们交给加基森的鲁格伦克。‡收集5個廢土水袋，把它們交給加基森的魯葛蘭克。',
  }
},
[1708] = {
  {
    'Coral de Ferro‡Железный коралл‡Eisenkoralle‡철산호‡Coral férreo‡Coral férreo‡Le corail de fer‡铁珊瑚‡鐵珊瑚',
    nil,
    'Leve 20 peças de Coral Causticante para Cronomorfus Espanafuso em Altaforja.‡Принесите 20 партий выжженного коралла Клацморту Гайкокруту в Стальгорн.‡Bringt 20 Ladungen Sengkoralle zu Klockmort Spannersplint in Eisenschmiede.‡아이언포지에 있는 클락몰트 스패너스판에게 철산호 20개를 가져가야 합니다.‡Lleva 20 piezas de coral abrasador a Klockmort Palmalicate en Forjaz.‡Lleva 20 piezas de coral férreo a Klockmort Palmalicate en Forjaz.‡Apportez 20 Coraux torrides à Pléthorloge Cléventail, à Forgefer.‡收集20块灼热珊瑚，把它们交给铁炉堡的科罗莫特·钢尺。‡收集20塊灼熱珊瑚，把它們交給鐵爐堡的科羅莫特·鋼尺。',
  }
},
[1709] = {
  {
    '‡Творение Клацморта‡Klockmorts Kreation‡‡La creación de Klockmort‡La creación de Klockmort‡La création de Pléthorloge‡科罗莫特的成果‡',
    nil,
    nil,
  }
},
[1710] = {
  {
    '‡Высохшая скорлупа‡Sonnenverbrannte Schalen‡‡Cáscaras asoladas‡Cáscaras asoladas‡Coquilles desséchées au soleil‡晒焦的蛋壳‡',
    nil,
    '‡Принесите 20 кусков высохшей на солнце скорлупы Матилю из Дарнаса.‡Bringt 20 sonnenverbrannte Schalen zu Mathiel in Darnassus.‡‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Apportez 20 Coquilles desséchées au soleil à Mathiel, à Darnassus.‡把20个晒焦的蛋壳交给达纳苏斯的玛希尔。‡',
  }
},
[1711] = {
  {
    '‡Доспехи Матиля‡Mathiels Rüstung‡‡La armadura de Mathiel‡La armadura de Mathiel‡L\'armure de Mathiel‡玛希尔的铠甲‡',
    nil,
    nil,
  }
},
[1712] = {
  {
    'Ciclonium‡Циклониан‡Cyclonian‡사이클로니안‡Ciclonio‡Ciclonio‡Cyclonien‡塞克隆尼亚‡塞克隆尼亞',
    nil,
    'Leve os itens listados no Pergaminho de Bath\'rah para Bath\'rah, o Vigia dos Ventos, em Alterac.‡Принесите Бат\'ра Стражу Ветра все предметы из его списка.‡Bringt die Gegenstände auf Bath\'rahs Pergament zu Bath\'rah dem Windbehüter in Alterac.‡알터랙에 있는 바람의감시자 바스라에게 바스라의 양피지에 적혀 있는 물건들을 가져가야 합니다.‡Lleva los objetos sobre el papiro de Bath\'rah a Bath\'rah el Vigía del viento en Alterac.‡Lleva los objetos sobre el papiro de Bath\'rah a Bath\'rah el Vigía del viento en Alterac.‡Apportez les objets du Parchemin de Bath\'rah à Bath\'rah la Vigie des vents à Alterac.‡把巴斯拉的羊皮纸上列出的东西交给奥特兰克的捕风者巴斯拉。‡把巴斯拉的羊皮紙上列出的東西交給奧特蘭克的『觀風者』巴斯拉。',
  }
},
[1713] = {
  {
    '‡Призыв‡Die Beschwörung‡‡La invocación‡La invocación‡L\'invocation‡召唤‡',
    nil,
    '‡Принесите сердце Вихря Бат\'ра Стражу Ветра.‡Bringt das Wirbelherz zu Bath\'rah dem Windbehüter.‡‡Lleva el corazón de espirálico a Bath\'rah el Vigía del viento.‡Lleva el corazón de espirálico a Bath\'rah el Vigía del viento.‡Apportez le Cœur de tourbillon à Bath\'rah la Vigie des vents.‡将旋风之心带给捕风者巴斯拉。‡',
  }
},
[1714] = {
  {
    '‡Субстанция Изгнанников‡Essenz der Verbannung‡떠도는 정령의 정수‡Esencia del exilio‡Esencia del exilio‡Essence d\'exil‡流放精华‡流放精華',
    nil,
    nil,
  }
},
[1715] = {
  {
    'O Cordeiro Imolado‡Таверна "Забитый ягненок"‡Zum Geschlachteten Lamm‡어둠의 희생양‡El Cordero Degollado‡El Cordero Degollado‡L\'Agneau assassiné‡已宰的羔羊‡已宰的羔羊',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду из Квартала Магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고해야 합니다.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le Quartier des Mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向『黑暗縛靈師』加金報到。',
  }
},
[1716] = {
  {
    'Devoradora de almas‡Пожиратель Душ‡Verschlinger der Seelen‡영혼을 삼키는 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Takar, o Vidente, nos Sertões.‡Поговорите с Такаром Провидцем в Степях.‡Sprecht mit Takar dem Seher im Brachland.‡불모의 땅에 있는 현자 타카르와 대화해야 합니다.‡Habla con Takar el Vidente en Los Baldíos.‡Habla con Takar el Vidente en Los Baldíos.‡Parler à Takar le Prophète dans les Tarides.‡与贫瘠之地的先知塔卡尔交谈。‡與貧瘠之地的『先知』塔卡爾交談。',
  }
},
[1717] = {
  {
    '‡Приглашение Гакина‡Gakins Beschwörung‡‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡',
    nil,
    '‡Встретьтесь с Гакином Темнопрядом в квартале магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le Quartier des Mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡',
  }
},
[1718] = {
  {
    'O ilhéu‡Островитянин‡Der Inselbewohner‡섬 사람‡El isleño‡El isleño‡L\'île mortelle‡岛民‡島民',
    nil,
    'Fale com Klannoc Macleod.‡Поговорите с Кланноком Маклеодом.‡Sprecht mit Klannoc Macleod.‡클라녹 맥클라우드와 대화해야 합니다.‡Habla con Klannoc Macleod.‡Habla con Klannoc Macleod.‡Parler à Klannoc Macleod.‡和克兰诺克·马克雷德谈一谈。‡和克蘭諾克·馬克雷德談話。',
  }
},
[1719] = {
  {
    '‡Побоище‡Der Ringkampf‡‡La Reyerta‡La Reyerta‡La Dispute‡格斗考验‡',
    nil,
    '‡Убейте Большого Вилла и поговорите с Кланноком Маклеодом на Острове Битв.‡Tötet Big Will und sprecht mit Klannoc Macleod auf dem Prügeleiland.‡‡Mata a Will el Grande y habla con Klannoc Macleod en Isla de Batalla.‡Mata a Will el Grande y habla con Klannoc Macleod en Isla de Batalla.‡Tuer le Grand Will et parler à Klannoc Macleod sur l\'île de la Dispute.‡杀掉比格维尔，然后向勇士岛的克兰诺克·马克雷德回复。‡',
  }
},
[1738] = {
  {
    'Palocórdio‡Сердцедрево‡Herzholz‡사랑나무‡Duramen‡Duramen‡Le cœur du bois‡同心树‡同心樹',
    nil,
    'Obtenha o Palocórdio no Vale Gris e leve-o a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Раздобудьте в Ясеневом лесу сердцедрево и принесите его Гакину Темнопряду в Квартал магов Штормграда.‡Holt das Herzholz aus dem Eschental und bringt es zu Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡잿빛 골짜기에서 사랑나무를 찾아 스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Recupera el duramen de Vallefresno y llévaselo a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Recupera el duramen de Vallefresno y llévaselo a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Trouver le Cœur du bois en Orneval et le porter à Gakin le Tisse-noir dans le Quartier des Mages de Hurlevent.‡从灰谷取回同心树，把它交给暴风城法师区里的黑暗缚灵者加科因。‡從梣谷取回同心樹，把它交給暴風城法師區裡的『黑暗縛靈師』加金。',
  }
},
[1739] = {
  {
    '‡Оковы‡Die Bindung‡균열 봉합‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    '‡Призовите и подчините суккуба, используя сердцевину сердцедрева, затем верните сердцевину сердцедрева Гакину Темнопряду. Он будет ждать вас в "Забитом ягненке".‡Beschwört mithilfe des Herzholzkerns einen Sukkubus, unterwerft ihn und bringt dann den Herzholzkern zu Gakin dem Dunkelbinder im Geschlachteten Lamm zurück.‡‡Utilizando el corazón del duramen, invoca y somete a un súcubo. Después devuelve el corazón del duramen a Gakin el Presotenebra en El Cordero Degollado.‡Utilizando el corazón del duramen, invoca y somete a un súcubo. Después devuelve el corazón del duramen a Gakin el Presotenebra en El Cordero Degollado.‡Utiliser le Noyau du cœur du bois pour invoquer et soumettre une succube, puis rapporter le Noyau de cœur du bois à Gakin le Tisse-noir, à l\'Agneau assassiné.‡召唤并制服一个魅魔，然后将同心树之核还给已宰的羔羊旅店的黑暗缚灵者加科因。‡',
  }
},
[1740] = {
  {
    'O orbe de Soran\'ruk‡Шар Соран\'рука‡Die Kugel von Soran\'ruk‡소랜루크 수정구‡El orbe de Soran\'ruk‡El orbe de Soran\'ruk‡L\'Orbe de Soran\'ruk‡索兰鲁克宝珠‡索蘭魯克寶珠',
    nil,
    'Encontre 3 Fragmentos de Soran\'ruk e 1 Fragmento Grande de Soran\'ruk e entregue-os a Doan Karhan nos Sertões.‡Соберите 3 фрагмента Соран\'рука и 1 большой фрагмент Соран\'рука и принесите их Доану Кархану в Степи.‡Sucht 3 Fragmente von Soran\'ruk und 1 großes Fragment von Soran\'ruk und bringt sie zu Doan Karhan im Brachland.‡소랜루크 조각 3개와 큰 소랜루크 조각 1개를 찾아 불모의 땅에 있는 도안 카르한에게 가져가야 합니다.‡Encuentra 3 trozos de Soran\'ruk y 1 trozo de Soran\'ruk grande y llévaselos a Doan Karhan en Los Baldíos.‡Encuentra 3 fragmentos de Soran\'ruk y 1 fragmento grande de Soran\'ruk y llévaselos a Doan Karhan en Los Baldíos.‡Trouvez 3 Fragments de Soran\'ruk et 1 Grand fragment de Soran\'ruk et rapportez-les à Doan Karhan, dans les Tarides.‡找到3块索兰鲁克宝珠的碎片和1块索兰鲁克宝珠的大碎片，把它们交给贫瘠之地的杜安·卡汉。‡找到3塊索蘭魯克寶珠的碎片和1塊索蘭魯克寶珠的大碎片，把它們交給貧瘠之地的杜安·卡漢。',
  }
},
[1758] = {
  {
    '‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    '‡Поговорите с Кромом Крепкоруком в Стальгорне.‡Sprecht mit Krom Starkarm in Eisenschmiede.‡‡Habla con Krom Brazorrecio en Forjaz.‡Habla con Krom Brazorrecio en Forjaz.‡Parler à Krom Rudebras à Forgefer.‡与铁炉堡的克罗姆·粗臂谈一谈。‡',
  }
},
[1778] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Поговорите с Тизой Боевой Горн в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡与铁炉堡的蒂萨·热炉谈话。‡',
  }
},
[1779] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Возьмите знак Жизни и поговорите с Майридоном Боевым Горном в Стальгорне.‡Nehmt das Symbol des Lebens und sprecht mit Muiredon Kriegshammer in Eisenschmiede.‡‡Coge el Símbolo de la Vida y habla con Muiredon Forjabatalla. Está en Forjaz.‡Coge el Símbolo de la Vida y habla con Muiredon Forjabatalla. Está en Forjaz.‡Prendre le Symbole de vie et parler à Muiredon Forgeguerre à Forgefer.‡带上生命符记，和铁炉堡的穆里顿·热炉谈一谈。‡',
  }
},
[1780] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Sturmwind.‡‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1781] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida para Gazin Tenorm em Ventobravo.‡Отнесите знак Жизни Газину Тенорму в Штормград.‡Bringt das Symbol des Lebens zu Gazin Tenorm in Sturmwind.‡스톰윈드에 있는 가쟁 테놈에게 생명의 징표를 가져가야 합니다.‡Lleva el Símbolo de la Vida a Gazin Tenorm a Ventormenta.‡Lleva el Símbolo de la Vida a Gazin Tenorm a Ventormenta.‡Porter le Symbole de vie à Gazin Tenorm à Hurlevent.‡把生命符记带给暴风城的贾森·坦诺姆。‡把生命符記帶給暴風城的傑生·坦諾姆。',
  }
},
[1782] = {
  {
    '‡Доспехи Фьюрена‡Furens Rüstung‡‡La armadura de Furen‡La armadura de Furen‡L\'armure de Furen‡弗伦的铠甲‡',
    nil,
    nil,
  }
},
[1783] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida e ressuscite Narm Faulk em Dun Morogh.‡Возьмите знак Жизни и воскресите Нарма Фолка в Дун Мороге.‡Nehmt das Symbol des Lebens und erweckt Narm Faulk in Dun Morogh wieder zum Leben.‡생명의 징표를 가져가서 던 모로에 있는 나름 폴크를 되살려야 합니다.‡Coge el Símbolo de la Vida y resucita a Narm Faulk en Dun Morogh.‡Llévate el Símbolo de la Vida y resucita a Narm Faulk en Dun Morogh.‡Prendre le Symbole de vie et ressusciter Narm Faulk dans Dun Morogh.‡使用生命符记复活丹莫罗的纳姆·法奥克。‡使用生命符記復活丹莫洛的納姆·法奧克。',
  }
},
[1784] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Добудьте послание дворфов Черного Железа возле Хельмова Ложа и вернитесь к Майридону Боевому Горну в Стальгорн.‡Beschafft ein Dunkeleisenmanuskript von den Dunkeleisenzwergen beim Helmsbettsee und kehrt zu Muiredon Kriegshammer in Eisenschmiede zurück.‡‡Consigue una misiva Hierro Negro de los enanos Hierro Negro que están cerca de Helm y luego vuelve a Forjaz y busca a Muiredon Forjabatalla.‡Consigue una misiva Hierro Negro de los enanos Hierro Negro que están cerca de Helm y luego vuelve a Forjaz y busca a Muiredon Forjabatalla.‡Récupérez un Document sombrefer près du lac du Lit d\'Helm, et rapportez-le à Muiredon Forgeguerre, à Forgefer.‡从盔枕湖附近的黑铁矮人那里取回一份黑铁手稿，把它交给铁炉堡的穆里顿·热炉。‡',
  }
},
[1785] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Поговорите с Тизой Боевой Горн в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡与铁炉堡的蒂萨·热炉谈话。‡',
  }
},
[1786] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida e ressuscite Henze Faulk em Elwynn.‡Возьмите знак Жизни, пойдите в Элвиннский лес и воскресите Хенза Фолка.‡Nehmt das Symbol des Lebens und erweckt Henze Faulk in Elwynn wieder zum Leben.‡생명의 징표를 가져가서 엘윈에 있는 헨즈 폴크를 되살려야 합니다.‡Coge el Símbolo de la Vida y resucita a Henze Faulk en Elwynn.‡Llévate el Símbolo de la Vida y resucita a Henze Faulk en Elwynn.‡Apporter le Symbole de vie et ressusciter Henze Faulk à Elwynn.‡把生命符记带到艾尔文森林的英烈碑去，复活亨兹·法奥克。‡把生命符記帶到艾爾文森林的英烈碑去，復活亨茲·法奧克。',
  }
},
[1787] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Найдите волшебников из Братства Справедливости в Элвиннском лесу, заберите у них бумаги и отнести Газину Тенорму в Штормград.‡Beschafft eine Schrift der Defias von den abtrünnigen Hexern der Defias in Elwynn und kehrt zu Gazin Tenorm in Sturmwind zurück.‡‡Recupera 1 misiva Defias de los zahoríes bribones Defias de Elwynn y vuelve con Gazin Tenorm a Ventormenta.‡Recupera 1 misiva Defias de los zahoríes bribones Defias de Elwynn y vuelve con Gazin Tenorm a Ventormenta.‡Retrouver un Script Défias sur les Sorciers-voleurs défias d\'Elwynn et le rapporter à Gazin Tenorm à Hurlevent.‡从石碑湖小岛上的迪菲亚巫师手中拿到迪菲亚手稿，把它交给暴风城的贾森·坦诺姆。‡',
  }
},
[1788] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
