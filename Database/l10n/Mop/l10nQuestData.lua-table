[24913] = {
  {
    'Lembra-te da Luz‡Помни о Свете‡Gedenkt des Lichtes‡빛을 기억하라‡Recuerda la Luz‡Recuerda la Luz‡N\'oubliez pas la Lumière‡记住圣光‡記住聖光',
    nil,
    'Ajude o anacoreta Avuun a despedir-se de Magtoor.‡Поддержите анахорета Авууна в последние минуты жизни Магтура.‡Helft Anchorit Avuun, sich von Magtoor zu verabschieden.‡수도사 아분이 막투르에게 마지막 작별인사를 고할 수 있게 도와야 합니다.‡Ayuda al anacoreta Avuun a despedirse de Magtoor.‡Ayuda al anacoreta Avuun a despedirse de Magtoor.‡Assistez l\'Anachorète Avuun pendant ses derniers adieux à Magtoor.‡帮助学者阿弗恩同玛格图尔告别。‡幫隱士艾弗恩向瑪格圖爾道別。',
  }
},
[24914] = {
  {
    'Propriedade particular‡Личное имущество‡Persönliches Eigentum‡개인적인 물건‡Bienes personales‡Bienes personales‡Propriété privée‡个人财产‡私人財產',
    nil,
    'Leve o Baú Lacrado para o Grão-lorde Dárion Mograine, na Cidadela da Coroa de Gelo.‡Отнесите запечатанный сундук верховному лорду Дариону Могрейну в Цитадель Ледяной Короны.‡Bringt die versiegelte Truhe zu Hochlord Darion Mograine in die Eiskronenzitadelle.‡봉인된 궤짝을 얼음왕관 성채에 있는 대영주 다리온 모그레인에게 가져가야 합니다.‡Llévale el cofre sellado al Alto señor Darion Mograine en la Ciudadela de la Corona de Hielo.‡Llévale el cofre sellado al Alto señor Darion Mograine en la Ciudadela de la Corona de Hielo.‡Apportez le Coffre scellé au Généralissime Darion Mograine dans la Citadelle de la Couronne de glace.‡将密封的金属箱交给冰冠堡垒的大领主莫格莱尼。‡把密封的箱子帶給在冰冠城塞的大領主達瑞安·莫格萊尼。',
  }
},
