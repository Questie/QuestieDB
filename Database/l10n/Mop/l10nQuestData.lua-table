[13478] = {
  {
    '‡‡Gemeinsames Bestreben‡‡‡Esfuerzos concertados‡Des efforts concertés‡‡',
    nil,
    '‡‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Brigadegeneral der Allianz in einer der Hauptstädte, Shattrath, Dalaran oder Tausendwinter.‡‡‡Entrega 1 marca de Honor de cada campo de batalla a un general de brigada de la Alianza en cualquiera de las capitales de la Alianza, Shattrath, Dalaran o Conquista del Invierno.‡Apportez 1 Marque d’honneur de chaque champ de bataille à un général de brigade de l\'Alliance, dans n\'importe quelle capitale de l\'Alliance, à Shattrath, à Dalaran ou Joug-d\'hiver.‡‡',
  }
},
[13479] = {
  {
    'A grande caçada aos ovos‡Большая охота за яйцами‡Die große Eiersuche‡알 찾기의 달인‡La gran búsqueda de huevos‡La gran búsqueda de huevos‡La grande chasse aux œufs‡寻蛋‡彩蛋大狩獵',
    nil,
    'O Coletador da Primavera quer que você colete 20 Fragmentos de Casca Alegremente Colorida.‡Принесите весеннему сборщику 20 осколков раскрашенной яичной скорлупы.‡Der Frühlingsernter möchte, dass Ihr 20 Eierschalenstücke besorgt.‡봄 축제 채집가가 껍질 조각 20개를 모아 달라고 했습니다.‡El recolector primaveral quiere que consigas 20 trozos de cáscara.‡El recolector primaveral quiere que consigas 20 trozos de cáscara.‡Le Récolteur du printemps vous a demandé de lui ramener 20 Fragments de coquilles.‡春季收集者要你去收集20块蛋壳碎片。‡春日蒐集者要你帶給他20個蛋殼碎片。',
  }
},
[13480] = {
  {
    'A grande caçada de ovos‡Большая охота за яйцами‡Die große Eiersuche‡알 찾기의 달인‡La gran búsqueda de huevos‡La gran búsqueda de huevos‡La grande chasse aux œufs‡寻蛋‡彩蛋大狩獵',
    nil,
    'O Colecionador da Primavera quer que você colete 20 Fragmentos de Casca Alegremente Colorida.‡Принесите весеннему собирателю 20 осколков раскрашенной яичной скорлупы.‡Der Frühlingssammler möchte, dass Ihr 20 Eierschalenstücke besorgt.‡봄 축제 수집가에게 껍질 조각 20개를 가져가야 합니다.‡El colector primaveral quiere que consigas 20 trozos de cáscara.‡El colector primaveral quiere que consigas 20 trozos de cáscara.‡Le Collecteur du printemps vous a demandé de lui ramener 20 Fragments de coquilles.‡春季收藏者要你去收集20块蛋壳碎片。‡春日收集者要你帶給他20個蛋殼碎片。',
  }
},
[13481] = {
  {
    'Vamos dar o fora daqui!‡Валим отсюда!‡Lasst uns von hier verschwinden!‡악몽에서 탈출을!‡¡Salgamos de aquí!‡¡Salgamos de aquí!‡Sortons de là !‡我们离开这里吧‡讓我們離開這裡!',
    nil,
    'Escolte o Padre Kamaros durante a fuga e, a seguir, apresente-se ao Irmão Keltan a bordo do Martelo de Orgrim.‡Проводите отца Камароса в безопасное место и доложите об этом брату Кельтану на борту "Молота Оргрима".‡Bringt Vater Kamaros in Sicherheit und erstattet dann Bruder Keltan an Bord der Orgrims Hammer Bericht.‡신부 카마로스를 안전한 곳으로 호위한 다음 오그림의 망치호에 있는 수사 켈탄에게 보고해야 합니다.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante el hermano Keltan a bordo del Martillo de Orgrim.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante el hermano Keltan a bordo del Martillo de Orgrim.‡Escortez le Père Kamaros jusqu\'à ce qu\'il soit en sécurité et présentez-vous au Frère Keltan, à bord du Marteau d\'Orgrim.‡护送卡玛洛斯神父逃离险境，然后向奥格瑞姆之锤的凯尔坦修士报告。‡護送卡瑪洛斯神父至安全之處，並向奧格林之錘上的凱爾坦修士回報。',
  }
},
[13482] = {
  {
    'Vamos dar o fora daqui!‡Валим отсюда!‡Lasst uns von hier verschwinden‡악몽에서 탈출을!‡¡Salgamos de aquí!‡¡Salgamos de aquí!‡Sortons de là‡我们离开这里吧‡讓我們離開這裡',
    nil,
    'Escolte o Padre Kamaros durante a fuga e, a seguir, apresente-se a Absalan, o Pio, a bordo do Rompe-céus.‡Проводите отца Камароса в безопасное место, а затем сообщите об этом Абсалану Благочестивому на борту "Усмирителя небес".‡Bringt Vater Kamaros in Sicherheit und erstattet dann Absalan dem Frommen an Bord der Himmelsbrecher Bericht.‡신부 카마로스를 안전한 곳으로 호위한 다음 하늘파괴자호에 있는 신앙심 깊은 압살란에게 보고해야 합니다.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante Absalan el Piadoso a bordo de El Rompecielos.‡Escolta al padre Kamaros hasta un lugar seguro y después preséntate ante Absalan el Piadoso a bordo de El Rompecielos.‡Escortez le Père Kamaros jusqu\'à ce qu\'il soit en sécurité et présentez-vous à Absalan le Pieux, à bord du Brise-ciel.‡护送卡玛洛斯神父逃离险境，然后向破天号上的虔诚的阿布萨兰报告。‡護送卡瑪洛斯神父至安全之處，並向破天者號上的虔誠的亞柏薩倫回報。',
  }
},
[13483] = {
  {
    'Coletores da Primavera‡Весенние сборщики‡Frühlingsernter‡봄 축제 채집가‡Recolectores primaverales‡Recolectores primaverales‡Récolteurs du printemps‡春季收集者‡春日蒐集者',
    nil,
    'Fale com um Coletor da Primavera em Monte Navalha, Montalvo, Aldeia Casco Sangrento ou Praça Asa do Falcão.‡Поговорите с весенним сборщиком в Колючем Холме, Брилле, деревне Кровавого Копыта или Площади Соколиных Крыльев.‡Sprecht mit einem Frühlingsernter in Klingenhügel, in Brill, im Dorf der Bluthufe oder auf dem Falkenplatz.‡칼바위 언덕, 브릴, 블러드후프 마을, 매날개 광장에 있는 봄 축제 채집가 한 명과 대화해야 합니다.‡Habla con un recolector primaveral en Cerrotajo, Rémol, Poblado Pezuña de Sangre o Plaza Alalcón.‡Habla con un recolector primaveral en Cerrotajo, Rémol, Poblado Pezuña de Sangre o Plaza Alalcón.‡Parlez à un Récolteur du printemps à Tranchecolline, à Brill, à Sabot-de-Sang ou à la Place de l\'Épervier.‡与剃刀岭、布瑞尔、血蹄村或鹰翼广场的春季收集者谈一谈。‡跟剃刀嶺、布瑞爾、血蹄村或獵鷹之翼廣場的一位春日蒐集者交談。',
  }
},
[13484] = {
  {
    'Colecionadores da Primavera‡Весенние собиратели‡Frühlingssammler‡봄 축제 수집가‡Colectores primaverales‡Colectores primaverales‡Collecteurs du printemps‡春季收藏者‡春日收集者',
    nil,
    'Fale com um Colecionador da Primavera em Vila d\'Ouro, Kharanos, Dolanaar ou no Entreposto Lazúli.‡Поговорите с весенним собирателем в Златоземье, Караносе, Доланааре или на Лазурной заставе.‡Sprecht mit einem Frühlingssammler in Goldhain, Kharanos, Dolanaar oder Azurwacht .‡황금골, 카라노스, 돌라나르, 하늘 감시초소에 있는 봄 축제 수집가 한 명과 대화해야 합니다.‡Habla con un colector primaveral en Villadorada, Kharanos, Dolanaar o Avanzada Azur.‡Habla con un colector primaveral en Villadorada, Kharanos, Dolanaar o Avanzada Azur.‡Parlez à un Collecteur du printemps à Comté-de-l\'Or, Kharanos, Dolanaar ou Guet d\'Azur.‡与闪金镇、卡拉诺斯、多兰纳尔或碧蓝岗哨的春季收藏者谈一谈。‡跟閃金鎮、卡拉諾斯、多蘭納爾或藍色守望的一位春日收集者交談。',
  }
},
