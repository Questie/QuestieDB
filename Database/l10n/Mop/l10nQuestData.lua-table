},
[25573] = {
  {
    '‡‡Euer Unterwasserreittier (vorläufig)‡‡Tu montura submarina (Temp)‡‡Votre monture sous-marine (tempo)‡‡',
    nil,
    '‡‡Lockt einen Abyssalmanta an und überwältigt ihn.|n|n[Achtung: Für diese Quest ist noch einiges in Planung - das Endergebnis wird viel schneller und sauberer sein]‡‡Atrae y somete a una manta abismal.|n|n[Note: There is a lot pending for this quest - the end result will be much quicker and much cleaner]‡‡Appâtez et domptez une Raie manta abyssale.‡‡',
  }
},
[25574] = {
  {
    'Chuva de fogo‡Пламя свыше‡Flammen von oben‡화염비‡Llamas desde las alturas‡Llamas desde las alturas‡Les flammes venues du ciel‡天降之火‡天降大火',
    nil,
    'Encontre o Acampamento do Crepúsculo a norte de Nordrassil e use a Trompa do Dholo.‡Найдите лагерь Сумеречного Молота к северу от Нордрассила и используйте рог Толо.‡Sucht das Lager des Schattenhammers nördlich von Nordrassil und benutzt Tholos Horn.‡놀드랏실 북쪽에 있는 황혼의 야영지를 찾아 톨로의 뿔피리를 사용해야 합니다.‡Busca el Campamento Crepuscular al norte de Nordrassil y usa el cuerno de Tholo.‡Busca el Campamento Crepuscular al norte de Nordrassil y usa el cuerno de Tholo.‡Trouvez le Campement du crépuscule au nord de Nordrassil et utilisez-y la Corne de Tholo.‡到诺达希尔北边寻找暮光营地，在那里使用索罗之角。‡到諾達希爾北方尋找暮光營地，然後在營地使用索羅的號角。',
  }
},
[25575] = {
  {
    'Forjado com fogo e treva‡Выковано из тьмы и пламени‡Geschmiedet aus Schatten und Flammen‡어둠과 불로 벼려낸‡Forjados con sombra y fuego‡Forjados con sombra y fuego‡Des lames d\'ombre et de flamme‡铸于暗影与烈焰‡由影與焰鍛造',
    nil,
    'Destrua 10 caixotes de Armas do Crepúsculo.‡Уничтожьте 10 ящиков с оружием Сумеречного Молота‡Zerstört 10 Waffenkisten des Schattenhammers.‡황혼의 무기 상자 10개를 파괴해야 합니다.‡Destruye 10 cajones de armas Crepusculares.‡Destruye 10 cajones de armas Crepusculares.‡Détruisez 10 Caisses d\'armes du Crépuscule.‡摧毁10只暮光武器箱。‡摧毀12個暮光武器箱。',
  }
},
[25576] = {
  {
    'A fúria do lobo ancião‡Ярость древнего духа волка‡Der Zorn des Wolfsahnen‡늑대 고대정령의 분노‡La furia del ancestro lobo‡La furia del ancestro lobo‡La rage du loup ancestral‡狼神之怒‡狼靈先祖之怒',
    nil,
    'Mate 12 Operários Ferro Negro.‡Убейте 12 работников из клана Черного Железа.‡Tötet 12 Arbeiter der Dunkeleisenzwerge.‡검은무쇠 인부 12명을 처치해야 합니다.‡Mata a 12 obreros Hierro Negro.‡Mata a 12 obreros Hierro Negro.‡Tuez 12 Travailleurs sombrefers.‡消灭12个黑铁苦工。‡消滅12個黑鐵苦力。',
  }
},
[25577] = {
  {
    'Núcleo base‡Сокрушение основ‡Zerschmettert die Kerne‡핵폭발‡Destrozar los núcleos‡Destrozar los núcleos‡Briser les cœurs‡砸碎核心‡擊碎核心',
    nil,
    'Mate Guardiões Calcinantes até conseguir coletar 8 Núcleos Fumegantes. Em seguida, quebre os núcleos em uma Bigorna do Crepúsculo.‡Добудьте 8 тлеющих ядер, убивая обжигающих стражей, а затем разбейте их на наковальне Сумеречного Молота.‡Besorgt 8 schwelende Kerne von sengenden Wächtern und zerschmettert sie dann auf den Ambossen des Schattenhammers.‡이글거리는 수호자들을 처치하고 이글거리는 핵 8개를 수집하여, 황혼의 모루에 내리쳐야 합니다.‡Consigue 8 núcleos humeantes matando a guardianes abrasadores y después destrózalos contra un yunque Crepuscular.‡Consigue 8 núcleos humeantes matando a guardianes abrasadores y después destrózalos contra un yunque Crepuscular.‡Récupérez 8 Noyaux fumants en tuant des Gardiens incendiaires, puis broyez-les sur une Enclume du Crépuscule.‡消灭炽热守护者，夺取8个闷烧之核，然后用暮光铁砧砸碎这些闷烧之核。‡消滅8個灼熱守護者以取得悶熾之核，然後將它們在暮光鐵砧上擊碎。',
  }
},
[25578] = {
  {
    'De volta a Nordrassil‡Возвращение к Нордрассилу‡Rückkehr nach Nordrassil‡다시 놀드랏실로‡Vuelve a Nordrassil‡Vuelve a Nordrassil‡Retourner à Nordrassil‡回到诺达希尔‡返回諾達希爾',
    nil,
    'Fale com Ysera em Nordrassil, que fica em Hyjal.‡Поговорите с Изерой у Нордрассила на Хиджале.‡Sprecht mit Ysera in Nordrassil auf dem Hyjal.‡하이잘의 놀드랏실에 있는 이세라와 대화해야 합니다.‡Habla con Ysera en Nordrassil, Hyjal.‡Habla con Ysera en Nordrassil, Hyjal.‡Parlez à Ysera à Nordrassil, au Mont Hyjal.‡跟海加尔山诺达希尔的伊瑟拉谈一谈。‡到海加爾的諾達希爾找伊瑟拉說話。',
  }
},
[25579] = {
  {
    'Pego de surpresa‡Внезапный удар‡Überraschungsangriff‡경계 태세‡Con la guardia bajada‡Con la guardia bajada‡Sécurisation du périmètre‡毫无防备‡趁虛而入',
    nil,
    'Mate 10 Patrulheiros Azsh\'ir.‡Уничтожьте 10 патрульных Азш\'ира.‡Tötet 10 Patrouillen der Azsh\'ir.‡아즈쉬르 순찰병을 10마리 처치해야 합니다.‡Mata a 10 patrullas de Azsh\'ir.‡Mata a 10 patrullas de Azsh\'ir.‡Tuez 10 Patrouilleurs azsh’ir.‡杀死10名艾萨尔巡逻兵。‡消滅10個艾薩伊爾巡邏者。',
  }
},
[25580] = {
  {
    'Ataque preventivo‡Быстрый подход‡Schnelles Handeln‡신속한 접근‡Aproximación rápida‡Aproximación rápida‡Approche furtive‡蹑手蹑脚‡迅速接近',
    nil,
    'Destrua 8 Monitores Azsh\'ir.‡Уничтожьте 8 наблюдателей Азш\'ира.‡Zerstört 8 Überwacher der Azsh\'ir.‡아즈쉬르 감시기 8대를 파괴해야 합니다.‡Destruye 8 supervisores de Azsh\'ir.‡Destruye 8 supervisores de Azsh\'ir.‡Détruisez 8 Appareils de surveillance azsh’ir.‡摧毁8个艾萨尔监控器。‡摧毀8個艾薩伊爾監控裝置。',
  }
},
[25581] = {
  {
    'Investigação aquática‡Чтобы занять время‡Suche nach der Vergangenheit‡시간 작업‡Para matar el rato‡Para matar el rato‡Passe-temps innocent‡时光的记录‡佔據的時間',
    nil,
    'Investigue 4 estátuas intactas nos Jardins de Vashj\'ir.‡Осмотрите 4 неразрушенные статуи в садах Вайш\'ира.‡Untersucht die 4 unversehrten Statuen in den Gärten von Vashj\'ir.‡바쉬르 정원에 있는 온전한 석상을 4개 조사해야 합니다.‡Investiga las 4 estatuas intactas de los jardines de Vashj\'ir.‡Investiga las 4 estatuas intactas de los jardines de Vashj\'ir.‡Examinez les 4 Statues intactes dans les Jardins de Vashj’ir.‡调查瓦丝琪尔花园4处完好的雕像。‡在瓦許伊爾花園搜尋4個完好無缺的雕像。',
  }
},
[25582] = {
  {
    'Estabelecendo uma posição favorável‡Новая база‡Ein besserer Standort‡유리한 고지‡Ganar ventaja‡Ganar ventaja‡Une meilleure position‡奇袭点‡更優勢地位',
    nil,
    'No nível mais baixo das ruínas, vasculhe: a extremidade norte dos Jardins de Quel\'Durmar, a passagem que leva para baixo das ruínas a oeste dos jardins, e as estruturas no canto sudeste das ruínas sob as pontes.‡Спуститесь на нижний уровень руин и исследуйте северную часть садов Кель\'Дормир, туннель, проходящий под руинами на западе от садов, и постройки в юго-восточном углу руин, под мостами.‡Späht den nördlichen Teil der Gärten von Quel\'Dormir, den Tunnel unter den Ruinen im Westen der Gärten und die Gebäude im Süden der Gärten aus. Bleibt auf der untersten Ebene der Ruinen.‡폐허의 가장 낮은 지역에서, 쿠엘도르미르 정원의 북쪽 끝, 정원 서쪽의 폐허 아래로 통하는 통로, 그리고 폐허의 남동쪽 구석 다리 밑에 있는 일련의 구조물들을 정찰해야 합니다.‡En el nivel inferior de las ruinas, explora el extremo norte de los Jardines de Quel\'Dormir, el pasaje que va por debajo de las ruinas al oeste de los jardines y las estructuras en la esquina sureste de las ruinas, debajo de los puentes.‡En el nivel inferior de las ruinas, explora el extremo norte de los Jardines de Quel\'Dormir, el pasaje que va por debajo de las ruinas al oeste de los jardines y las estructuras en la esquina sureste de las ruinas, debajo de los puentes.‡Au niveau le plus bas des ruines, explorez l’extrémité nord des Jardins de Quel’Dormir, le passage qui mène sous les ruines à l’ouest des jardins, et les structures du coin sud-est des ruines, sous les ponts.‡去废墟最下层，调查奎尔多米尔花园北边的尽头，在花园以西的废墟下面有条小路可以通往那里，还有废墟东南角落的建筑群，就在桥下。‡在廢墟的低層，偵查奎多米爾花園的北端、花園西邊通往遺跡底下的通道，以及廢墟東南邊橋底下的建築。',
  }
},
[25583] = {
  {
    'Na cena de batalha‡На поле брани‡Auf dem Schlachtfeld‡전투 현장에서‡En la escena de la batalla‡En la escena de la batalla‡Sur le théâtre d’opérations‡在战斗现场‡戰爭遺址',
    nil,
    'Leve o estilhaço partido de volta para a Praia Tranquila.‡Отнесите обломок в Тихий залив.‡Bringt das Bruchstück zurück zum Stillen Strand.‡부러진 조각을 평온의 침식지로 가져가야 합니다.‡Lleva el fragmento roto de vuelta a la Estela Tranquila.‡Lleva el fragmento roto de vuelta a la Estela Tranquila.‡Rapportez le Fragment brisé au Reflux Tranquille.‡将破损的碎片带回静谧海滩。‡將破損的碎片帶回寧靜港灣。',
  }
},
[25584] = {
  {
    'O retorno dos anciãos‡Возвращение Древних‡Die Rückkehr der Ahnen‡돌아온 고대정령‡El regreso de los ancestros‡El regreso de los ancestros‡Le second avènement des anciens‡远古半神的回归‡祖靈的歸來',
    nil,
    'Fale com Muubla Chifre Branco na Trilha do Lobo, em Hyjal.‡Поговорите с Умлой Белый Рог на Волчьей тропе на Хиджале.‡Sprecht mit Oomla Weißhorn in der Wolfsschlucht auf dem Hyjal.‡하이잘의 늑대의 터에 있는 움라 화이트혼과 대화해야 합니다.‡Habla con Oomla Cuernoblanco en Senda del Lobo en Hyjal.‡Habla con Oomla Cuernoblanco en Senda del Lobo en Hyjal.‡Parlez à Oomla Corne-blanche à la Piste du Loup, à Hyjal.‡跟海加尔山狼神小径的欧穆拉·白角谈一谈。‡到海加爾的狼之小徑找烏姆拉·白角說話。',
  }
},
[25585] = {
  {
    'Silencie os canhões‡Заставь пушки замолчать‡Die Kanonen erstummen lassen‡포문을 막아라‡Silencia los cañones‡Silencia los cañones‡Le silence des canons‡沉默大炮‡平息砲火',
    nil,
    'Destrua 8 Canhões das Raízes dos Mares do Sul.‡Уничтожьте 8 пушек укрепления.‡Zerstört 8 Stützpunktkanonen.‡철통절벽 대포 8개를 파괴해야 합니다.‡Destruye 8 cañones de Sargazo.‡Destruye 8 cañones de Sargazo.‡Détruisez 8 Canons de la redoute.‡摧毁8挺据点大炮。‡摧毀8座碉堡火砲。',
  }
},
[25586] = {
  {
    'Silencie os canhões‡Заставь пушки замолчать‡Die Kanonen erstummen lassen‡포문을 막아라‡Silencia los cañones‡Silencia los cañones‡Le silence des canons‡沉默大炮‡平息砲火',
    nil,
    'Destrua 8 Canhões das Raízes dos Mares do Sul.‡Уничтожьте 8 пушек укрепления.‡Zerstört 8 Stützpunktkanonen.‡철통절벽 대포 8개를 파괴해야 합니다.‡Destruye 8 cañones de Sargazo.‡Destruye 8 cañones de Sargazo.‡Détruisez 8 Canons de la redoute.‡摧毁8挺据点大炮。‡摧毀8座碉堡火砲。',
  }
},
[25587] = {
  {
    'Dê-me abrigo!‡Найдите мне убежище!‡Atempause‡피난처로!‡¡Necesito refugio!‡¡Necesito refugio!‡Je demande asile !‡保护我！‡請求庇護!',
    nil,
    'Investigue a Fenda do Contrabandista, que fica na Floresta Kelp\'thar, e, então, avise Adarrah que é seguro entrar.‡Исследуйте Пещеру Контрабандистов в лесу Келп’тар и сообщите Адарре, что там безопасно.‡Untersucht den Schmugglerschmiss im Tang\'tharwald und signalisiert Adarrah dann, dass sie sicher hineingehen kann.‡켈프타르 숲에 있는 밀수업자의 흉터를 조사한 다음, 아다라에게 그곳에 들어가도 안전하다는 신호를 보내야 합니다.‡Investiga la Cicatriz del Contrabandista, en el Bosque Kelp\'thar, y haz una señal a Adarrah para que sepa que es seguro entrar.‡Investiga la Cicatriz del Contrabandista, en el Bosque Kelp\'thar, y haz una señal a Adarrah para que sepa que es seguro entrar.‡Explorez la Balafre du contrebandier dans la Forêt de Varech’thar, puis informez Adarrah qu’elle peut y entrer sans risque.‡调查柯尔普萨之森的走私者洞穴，确保可以安全进入洞穴后向埃达尔拉发出信号。‡調查凱波薩爾森林裡的走私者之痕，然後通知阿達拉那裡可以安全進入。',
  }
},
[25588] = {
  {
    'Revidando de leve‡Частичная расплата‡Ein wenig Vergeltung‡작은 복수‡Corta venganza‡Corta venganza‡La vengeance du noyé récalcitrant‡有仇必报‡還以顏色',
    nil,
    'Mate 15 piratas dos Mares do Sul nas Raízes dos Mares do Sul.‡Зарубите 15 пиратов в Укреплении Южных морей.‡Tötet 15 Piraten der Südmeerfreibeuter in Südemeerstützpunkt.‡남쪽바다 철통절벽에 있는 남쪽바다 해적 15명을 처치해야 합니다.‡Mata a 15 piratas de los Mares del Sur en el Sargazo de los Mares del Sur.‡Mata a 15 piratas de los Mares del Sur en el Sargazo de los Mares del Sur.‡Tuez 15 Pirates des mers du Sud à la Redoute des mers du Sud.‡在南海据点消灭15名南海海盗。‡在南海營地殺死15名南海海賊。',
  }
},
[25589] = {
  {
    'Revidando de leve‡Частичная расплата‡Ein wenig Vergeltung‡작은 복수‡Corta venganza‡Corta venganza‡La vengeance du noyé récalcitrant‡有仇必报‡還以顏色',
    nil,
    'Mate 15 piratas dos Mares do Sul nas Raízes dos Mares do Sul.‡Зарубите 15 пиратов в Укреплении Южных морей.‡Tötet 15 Piraten der Südmeerfreibeuter in Südemeerstützpunkt.‡남쪽바다 철통절벽에 있는 남쪽바다 해적 15명을 처치해야 합니다.‡Mata a 15 piratas de los Mares del Sur en el Sargazo de los Mares del Sur.‡Mata a 15 piratas de los Mares del Sur en el Sargazo de los Mares del Sur.‡Tuez 15 Pirates des mers du Sud à la Redoute des mers du Sud.‡在南海据点消灭15名南海海盗。‡在南海營地殺死15名南海海賊。',
  }
},
[25590] = {
  {
    'Onde está o Capu?‡Куда подевался Виззл?‡Wo ist Wizzel?‡위즐은 어디에?‡¿Dónde está Wizzle?‡¿Dónde está Wizzle?‡Où est planqué Lachnouf ?‡维兹尔去哪儿了？‡維茲爾在哪裡?',
    nil,
    'Encontre Capu Latafuso nas Raízes dos Mares do Sul, que ficam em Mil Agulhas.‡Разыщите Виззла Медноштифа в Укреплении Южных морей в Тысяче Игл.‡Findet Wizzel Kupferbolz in Südmeerstützpunkt in Tausend Nadeln.‡버섯구름 봉우리의 남쪽바다 철통절벽에 있는 위즐 브라스볼츠를 찾아야 합니다.‡Encuentra a Wizzle Pernolatón en el Sargazo de los Mares del Sur, en Las Mil Agujas.‡Encuentra a Wizzle Pernolatón en el Sargazo de los Mares del Sur, en Las Mil Agujas.‡Trouvez Lachnouf Zéboulon à la Redoute des mers du Sud, dans les Mille pointes.‡在千针石林的南海据点找到维兹尔·铜栓。‡在千針石林的南海營地找到維茲爾·銅栓。',
  }
},
[25591] = {
  {
    'Cúpula do Trovão: Briguinha de Ego!‡Громодром: решающая битва!‡Donnerkuppel: Erbitterter Zweikampf‡천둥경기장: 복수혈전!‡Truenódromo: ¡Pelea!‡Truenódromo: ¡Pelea!‡Le dôme du Tonnerre : le règlement de comptes !‡雷霆斗技场：宿敌战！‡雷霆競技場：怨仇對決!',
    nil,
    'Derrote Kelsey Fagulhaço.‡Одержите победу над Келси Стализвон.‡Besiegt Kelsey Stahlfunken.‡켈시 스틸스파크를 처치해야 합니다.‡Derrota a Kelsey Chispacero.‡Derrota a Kelsey Chispacero.‡Tuez Kelsey Étinçacier.‡击败凯尔希·钢烁。‡擊敗凱爾希·鋼火。',
  }
},
[25592] = {
  {
    'Profunda atração‡Глубокая привязанность‡Angriff aus der Tiefe‡심해의 명물‡Atracción profunda‡Atracción profunda‡Attraction abyssale‡深度吸引‡深層吸引',
    nil,
    'Mate 10 Catadores Vermelhões.‡Убейте 10 краснобородок-падальщиков.‡Tötet 10 Strauchdiebe der Rotkiemen.‡붉은아가미 청소부 10마리를 처치해야 합니다.‡Mata a 10 carroñeros Branquirrojo.‡Mata a 10 carroñeros Branquirrojo.‡Tuez 10 Charognards branchies-rouges.‡消灭10名红腮拾荒者。‡殺死10個紅鰓拾荒者。',
  }
},
[25593] = {
  {
    'Salvação pulmoespiral‡Спасение в ракушке‡Gepanzerte Rettung‡소라 탈출‡Conchas de salvación‡Conchas de salvación‡Le salut est dans la coquille‡救命螺‡殼中的救贖',
    nil,
    'Colete 8 Conchas Pulmoespirais e entregue-as para os Sobreviventes de Nespirah presos nas aberturas da montanha.‡Соберите 8 спиралангов и отдайте их спасенным из Неспиры.‡Sammelt 8 Spiralungpanzer und gebt sie gestrandeten Überlebenden von Nespirah.‡나선고둥 8개를 모아 네스피라 생존자들에게 가져가야 합니다.‡Recoge 8 conchas pulmoespiral y dáselas a los supervivientes de Nespirah parados.‡Recoge 8 conchas pulmoespiral y dáselas a los supervivientes de Nespirah parados.‡Ramassez 8 Respirales et distribuez-les aux Survivants de Nespirah coincés.‡收集8枚呼吸螺，把它们交给被困住的奈瑟匹拉幸存者。‡收集8個螺肺並交給被困的奈斯畢拉生還者。',
  }
},
[25594] = {
  {
    'Caranguejo safado‡Хитрые крабы‡Garstige Krebse‡교활한 게‡Cangrejos astutos‡Cangrejos astutos‡Crabes facétieux‡狡猾的螃蟹‡狡猾的螃蟹',
    nil,
    'Colete 12 Peças Espalhadas do Fiasco.‡Соберите 12 потерянных вещей Облина.‡Sammelt 12 von Fiascos fehlenden Teilen.‡피아스코의 부품 12개를 모아야 합니다.‡Recoge las 12 piezas extraviadas de Fiasco.‡Recoge las 12 piezas extraviadas de Fiasco.‡Retrouvez 12 Pièces égarées de Fiasco.‡收集12个菲亚斯科的散落零件。‡收集12件菲亞斯戈的雜散零件。',
  }
},
[25595] = {
  {
    'Algo comestível‡Что-нибудь съестное‡Was zum Essen‡안전한 먹을거리‡Algo comestible‡Algo comestible‡Quelque chose à se mettre sous la dent‡可以食用‡能吃的東西',
    nil,
    'Junte 8 pedaços de Carne de Garoupa Barracuda.‡Принесите 8 кусков мяса окуня-хрустогрыза.‡Sammelt 8 Stück Fleisch eines Schnappkieferbarschs.‡무쇠턱농어살 8개를 모아야 합니다.‡Reúne 8 carnes de mero Quijaforte.‡Reúne 8 carnes de mero Quijaforte.‡Obtenez 8 morceaux de Chair de mérou gueule-d’acier.‡收集8块钳嘴石斑鱼的肉。‡收集8塊鉗嘴石斑魚肉。',
  }
},
[25596] = {
  {
    'Cadê o Synge?‡Куда подевался Синг?‡Wo ist Flämmer?‡싱은 어디에?‡¿Dónde está Synge?‡¿Dónde está Synge?‡Synge en cage ?‡赛恩格去哪儿了？‡賽恩格在哪?',
    nil,
    'Encontre Synge nas Raízes dos Mares do Sul, que ficam em Mil Agulhas.‡Разыщите Синга в Укреплении Южных морей в Тысяче Игл.‡Findet Flämmer in Südmeerstützpunkt in Tausend Nadeln.‡버섯구름 봉우리의 남쪽바다 철통절벽에 있는 싱을 찾아야 합니다.‡Encuentra a Synge en el Sargazo de los Mares del Sur, en Las Mil Agujas.‡Encuentra a Synge en el Sargazo de los Mares del Sur, en Las Mil Agujas.‡Trouvez Synge à la Redoute des mers du Sud, dans les Mille pointes.‡在千针石林的南海据点找到赛恩格。‡在千針石林的南海營地找到賽恩格。',
  }
},
[25597] = {
  {
    'Comandante Jared Cantonegro‡Командир Джерод Песнь Теней‡Kommandant Jarod Schattensang‡사령관 제로드 섀도송‡Comandante Jarod Cantosombrío‡Comandante Jarod Cantosombrío‡Le commandant Jarod Chantelombre‡指挥官加洛德·影歌‡指揮官亞羅德‧影歌',
    nil,
    'Fale com o Elementalista Ortell no Desfiladeiro do Sussurro Sombrio.‡Поговорите с повелителем стихий Ортеллом на тропе Зловещего Шепота.‡Sprecht mit Elementarist Ortell am Flüsternden Pass.‡검은속삭임 고개에 있는 정령사 오르텔과 대화해야 합니다.‡Habla con el elementalista Ortell en Paso Negro Rumor.‡Habla con el elementalista Ortell en Paso Negro Rumor.‡Parlez à l’Élémentaliste Ortell, au Passage du sombre murmure.‡跟暗语小径的元素师奥泰尔谈一谈。‡去暗語小徑找元素師奧泰爾說話。',
  }
},
[25598] = {
  {
    'Nem tão orgulhosa para implorar‡Вопреки гордости‡Einer geht noch‡하나 더 부탁해요‡Suficientemente humilde como para rogar‡Suficientemente humilde como para rogar‡Ça ne coûte rien de demander‡屈尊乞求‡低聲下氣',
    nil,
    'Encontre Samir e Mack.‡Найдите Самира и Мака.‡Findet Samir und Mack.‡사미르와 맥을 찾아야 합니다.‡Encuentra a Samir y a Mack.‡Encuentra a Samir y a Mack.‡Trouvez Samir et Mack.‡找到萨米尔和马克。‡找出山米爾與麥客。',
  }
},
[25599] = {
  {
    'Malho de Cinzas, o Mestre do Portal‡Мастер порталов Пепельный Молот‡Aschenmaul, der Portalmeister‡차원문의 주인 잿불투사‡Machacaceniza, el Maestro del Portal‡Machacaceniza, el Maestro del Portal‡Cognecendre, le maître des portails‡灰槌，传送门之主‡傳送門管理員灰燼巨槌',
    nil,
    'Mate o Malho de Cinzas e encontre o Tomo de Aberturas.‡Убейте Пепельного Молота и добудьте фолиант отворения.‡Tötet Aschenmaul und findet den Foliant der Öffnungen.‡잿불투사를 처치하고 개방의 고서를 찾아야 합니다.‡Asesina a Machacaceniza y localiza el Escrito sobre Aperturas.‡Asesina a Machacaceniza y localiza el Escrito sobre Aperturas.‡Tuez Cognecendre et trouvez le Tome d\'ouverture.‡杀死灰槌，找到天启之书。‡消滅灰燼巨槌並找出開展之書。',
  }
},
[25600] = {
  {
    'Mestre Forjador Pirêndius‡Начальник кузни Пламий‡Schmiedemeister Pyrendius‡제련장인 피렌디우스‡Maestro de forja Pyrendius‡Maestro de forja Pyrendius‡Le maître-forge Pyrendius‡铸炉之主派伦迪乌斯‡鍛造大師裴迪爾斯',
    nil,
    'Mate o Mestre Forjador Pirêndius. Atraia-o até as Runas do Portal e use-as para enfraquecê-lo.‡Убейте начальника кузни Пламия. Заманите его на руны порталов и используйте их, чтобы ослабить его.‡Tötet Schmiedemeister Pyrendius. Lockt ihn auf die Portalrunen und benutzt sie, um ihn zu schwächen.‡제련장인 피렌디우스를 처치해야 합니다. 차원문 룬으로 유인한 다음, 차원문 룬을 사용하여 그를 약화시켜야 합니다.‡Asesina al maestro de forja Pyrendius. Atráelo hasta las runas de Portal y úsalas para debilitarlo.‡Asesina al maestro de forja Pyrendius. Atráelo hasta las runas de Portal y úsalas para debilitarlo.‡Tuez le Maître-forge Pyrendius. Attirez-le sur les runes de portail et utilisez-les pour l’affaiblir.‡杀死铸炉之主派伦迪乌斯。将他引诱到传送符文旁边，然后使用符文来削弱他。‡消滅鍛造大師裴迪爾斯。將他誘騙上傳送門符石再用它們削弱他的力量。',
  }
},
[25601] = {
  {
    'Representante de classe‡Гордость класса‡Klassenprimus‡반에서 일등‡El mejor de la clase‡El mejor de la clase‡Premier de la classe‡尖子生‡班長',
    nil,
    'Fale com a Instrutora Milva na Forja da Súplica, em Hyjal.‡Поговорите с наставницей Милвой в Кузне Мольбы на горе Хиджал.‡Sprecht mit Instrukteurin Mylva an der Schmiede der Unterwerfung auf dem Hyjal.‡하이잘의 탄원의 용광로에 있는 훈련교관 마일바와 대화해야 합니다.‡Habla con la instructora Mylva en La Forja de las Súplicas en Hyjal.‡Habla con la instructora Mylva en La Forja de las Súplicas en Hyjal.‡Parlez à l’Instructrice Mylva à la Forge de la Supplique, à Hyjal.‡跟海加尔山哀求熔炉的导师密尔瓦谈一谈。‡去海加爾的哀求熔爐找講師密爾瓦說話。',
  }
},
[25602] = {
  {
    'Lenha molhada não queima‡Без бума нет огня‡Der zündende Funke‡불꽃이 없으면 불도 없다‡No hay fuego sin chispa‡No hay fuego sin chispa‡Pas de feu sans étincelle‡没有火花，生不了火‡沒有火花就無法點燃',
    nil,
    'Pegue o Barril de Pólvora do Sítio de Escavação do Bino.‡Раздобудьте бочонок с порохом на Раскопках Бадда.‡Besorgt Euch das Pulverfass von Budds Ausgrabung.‡버드의 발굴지에서 화약통을 획득해야 합니다.‡Consigue el barril de pólvora de la Excavación de Budd.‡Consigue el barril de pólvora de la Excavación de Budd.‡Procurez-vous le Baril de poudre à canon au Site de fouilles de Budd.‡在巴德的挖掘场找到一桶火药。‡從霸德挖掘場取得一桶火藥。',
  }
},
[25603] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    nil,
  }
},
[25604] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    '‡Отнесите загадочное устройство в Штормград, Стальгорн, Экзодар или Дарнас и покажите его представителю Служителей Земли.‡Bringt das mysteriöse Gerät nach Sturmwind, Eisenschmiede, Exodar oder Darnassus und zeigt es einem Botschafter des Irdenen Rings.‡‡Lleva el dispositivo misterioso a Ventormenta, a Forjaz, a El Exodar o a Darnassus y muéstraselo a un representante del Anillo de la Tierra.‡‡Apportez le Mystérieux appareil à Hurlevent, Forgefer, Exodar ou Darnassus et montrez-le à un Représentant du Cercle terrestre.‡‡',
  }
},
[25605] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    nil,
  }
},
[25606] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    nil,
  }
},
[25607] = {
  {
    'A Gnomofone‡ГНМ-передатчик‡Där Gnomcordär‡노움특제전송기‡La gnomograbadora‡La gnomograbadora‡Le gnomotophone‡侏儒通讯器‡地精自動紀錄器',
    nil,
    'Recupere 8 pedaços de Tecnologia Goblin Suja.‡Добудьте 8 образцов грязной гоблинской технологии.‡Holt 8 Stücke dreckige Goblintechnologie.‡더러운 고블린 기술 8개를 모아야 합니다.‡Recupera 8 piezas de tecnología goblin inmunda.‡Recupera 8 piezas de tecnología goblin inmunda.‡Récupérez 8 éléments de Sale technologie gobeline.‡收集8份低劣的地精科技。‡取回8個下流的哥布林科技裝置。',
  }
},
[25608] = {
  {
    'Limpar o terreno a fogo‡Жги-руби!‡Brandrodung‡닥치는 대로‡Rajar y quemar‡Rajar y quemar‡À feu et à sang‡刀劈火燎‡燒殺擄掠',
    nil,
    'Monte em um Draco Esmeralda e mate 40 Integrantes do Martelo do Crepúsculo e 5 Dracos do Crepúsculo.‡Верхом на изумрудном драконе истребите 40 прислужников Сумеречного Молота и 5 сумеречных драконов.‡Schwingt Euch auf einen Smaragddrachen und tötet 40 Einheiten des Schattenhammers und 5 Zwielichtdrachen.‡에메랄드 비룡을 타고 황혼의 망치단 병사 40명과 황혼의 비룡 5마리를 처치해야 합니다.‡Monta en un draco esmeralda y asesina a 40 unidades del Martillo Crepuscular y a 5 dracos Crepusculares.‡Monta en un draco esmeralda y asesina a 40 unidades del Martillo Crepuscular y a 5 dracos Crepusculares.‡Montez sur un Drake émeraude et tuez 40 Unités du Crépuscule et 5 Lève-tempêtes du Crépuscule.‡骑上一头翡翠幼龙，消灭40个暮光之锤单位和5头暮光幼龙。‡騎乘翡翠龍殺死40個暮光之錘教徒和5隻暮光飛龍。',
  }
},
[25609] = {
  {
    'Tesouro afundado‡Затонувшее сокровище‡Versunkene Schätze‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡La tasse au trésor‡湖底沉宝‡水下寶藏',
    nil,
    'Consiga 8 Baús de Tesouro Afundados.‡Соберите 8 затонувших сундуков с сокровищами.‡Sammelt 8 versunkene Schatzkisten.‡가라앉은 보물 상자 8개를 모아야 합니다.‡Recoge 8 cofres del tesoro hundido.‡Recoge 8 cofres del tesoro hundido.‡Repêchez 8 Coffres au trésor engloutis.‡收集8个沉没的宝箱。‡收集8個沉沒的寶箱。',
  }
},
[25610] = {
  {
    'Tesouro afundado‡Затонувшее сокровище‡Versunkene Schätze‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡La tasse au trésor‡湖底沉宝‡水下寶藏',
    nil,
    'Consiga 8 Baús do Tesouro Afundados.‡Соберите 8 затонувших сундуков с сокровищами.‡Sammelt 8 versunkene Schatzkisten.‡가라앉은 보물 상자 8개를 모아야 합니다.‡Recoge 8 cofres del tesoro hundido.‡Recoge 8 cofres del tesoro hundido.‡Repêchez 8 Coffres au trésor engloutis.‡收集8个沉没的宝箱。‡收集8個沉沒的寶箱。',
  }
},
[25611] = {
  {
    'De volta das Terras do Fogo‡Возвращение с Огненных просторов‡Rückkehr aus den Feuerlanden‡불의 땅을 떠나며‡Regresa de las Tierras de Fuego‡Regresa de las Tierras de Fuego‡Retour des terres de Feu‡从火焰之地凯旋而归‡從火源之界歸來',
    nil,
    'Fale novamente com Ian Duran no Santuário de Goldrinn, em Hyjal.‡Вернитесь к Яну Дюрану в Святилище Голдринна на горе Хиджал.‡Kehrt zu Ian Duran am Schrein von Goldrinn auf dem Hyjal zurück.‡하이잘의 골드린의 제단에 있는 이언 듀란에게 가야 합니다.‡Vuelve con Ian Duran en el Santuario de Goldrinn en Hyjal.‡Vuelve con Ian Duran en el Santuario de Goldrinn en Hyjal.‡Retournez voir Ian Duran au Sanctuaire de Goldrinn, à Hyjal.‡返回海加尔山的戈德林圣殿，向伊安·杜兰复命。‡回去海加爾的戈德林聖壇找伊安·杜蘭。',
  }
},
[25612] = {
  {
    'De volta das Terras do Fogo‡Возвращение с Огненных Просторов‡Rückkehr aus den Feuerlanden‡불의 땅을 떠나며‡Regresa de las Tierras de Fuego‡Regresa de las Tierras de Fuego‡Retour des terres de Feu‡从火焰之地凯旋而归‡從火源之界歸來',
    nil,
    'Fale novamente com Takrik Furiuivo no Santuário de Goldrinn, em Hyjal.‡Вернитесь к Такрику Гневному Вою в Святилище Голдринна на горе Хиджал.‡Kehrt zu Takrik Wutheuler am Schrein von Goldrinn auf dem Hyjal zurück.‡하이잘의 골드린의 제단에 있는 타크리크 레이지하울에게 가야 합니다.‡Vuelve con Takrik Iraullido en el Santuario de Goldrinn en Hyjal.‡Vuelve con Takrik Iraullido en el Santuario de Goldrinn en Hyjal.‡Retournez voir Takrik Gronderage au Sanctuaire de Goldrinn, à Hyjal.‡去找海加尔山戈德林圣殿的塔科里克·怒哮。‡回去海加爾的戈德林聖壇找塔克利克·怒嚎。',
  }
},
[25613] = {
  {
    'Faça um favor a si mesmo‡Сделай себе одолжение‡Tut Euch selbst einen Gefallen‡자신을 위한 부탁‡Hazte un favor‡Hazte un favor‡Rendez-vous service‡为你自己好‡幫你自己個忙',
    nil,
    'Fale com Kalen Tirocerto na Ponta da Precisão, que fica na Cordilheira das Torres de Pedra.‡Поговорите с Каленом Метким Выстрелом в его лагере в Когтистых горах.‡Sprecht mit Kalen Freipfeil am Volltrefferposten im Steinkrallengebirge.‡돌발톱 산맥의 정조준 초소에 있는 칼렌 트루샷과 대화해야 합니다.‡Habla con Kalen Alblanco en Punta Alblanco, en Sierra Espolón.‡Habla con Kalen Alblanco en Punta Alblanco, en Sierra Espolón.‡Parlez à Kalen Tir-précis à la Pointe de Tir-précis, dans les Serres-Rocheuses.‡跟石爪山脉强击哨站的卡伦·强击谈一谈。‡到石爪山脈的強擊崗哨找卡連‧強擊說話。',
  }
},
[25614] = {
  {
    'Paraquedas não param balas‡Вниз – только мертвыми‡Der einzige Weg nach unten ist im Leichensack‡유일한 착륙 수단‡Solo se puede bajar muerto‡Solo se puede bajar muerto‡Qu\'ils atterrissent les pieds devant‡下来的唯一办法就是进裹尸袋‡送他們回老家',
    nil,
    'Mate 8 Comandantes de Ala do Brado Guerreiro.‡Убейте 8 командиров звена Песни Войны.‡Tötet 8 Schwadronskommandanten des Kriegshymnenklans.‡전쟁노래 편대사령관 8명을 처치해야 합니다.‡Mata a 8 comandantes del viento Grito de Guerra.‡Mata a 8 comandantes del viento Grito de Guerra.‡Tuez 8 Chefs d\'escadrille chanteguerres.‡杀死8名战歌飞将。‡殺死8個戰歌空軍指揮官。',
  }
},
[25615] = {
  {
    'De volta à Poeira Estelar‡Обратно в замок Звездной Пыли‡Kehrt zur Sternenstaubspitze zurück‡별가루 첨탑으로‡En polvo te convertirás‡En polvo te convertirás‡Retour à Chimétoile‡回到星尘塔‡返回星塵',
    nil,
    'Fale com a Caçadora Jalin na Torre Poeira Estelar, que fica no Vale Gris.‡Вернитесь к охотнице Джалин в Башню Звездной Пыли в Ясеневом лесу.‡Kehrt zu Jägerin Jalin an der Sternenstaubspitze im Eschental zurück.‡잿빛 골짜기의 별가루 첨탑에 있는 여사냥꾼 잘린에게 가야 합니다.‡Vuelve con la cazadora Jalin a Aguja del Polvo en Vallefresno.‡Vuelve con la cazadora Jalin a Aguja del Polvo en Vallefresno.‡Retournez auprès de la Chasseresse Jalin à la Flèche de Chimétoile, en Orneval.‡去找灰谷星尘塔的女猎手嘉琳。‡到梣谷的星塵尖塔找女獵手加琳。',
  }
},
[25616] = {
  {
    'O legado de Grito Infernal‡Наследие Адского Крика‡Höllschreis Vermächtnis‡헬스크림의 유산‡El legado de Grito Infernal‡El legado de Grito Infernal‡Les légions de Hurlenfer‡地狱咆哮的遗产‡地獄吼的遺產',
    nil,
    'Mate 10 Incineradores de Krom\'gar.‡Убейте 10 кром\'гарских поджигателей.‡Tötet 10 Verbrenner von Krom\'gar.‡크롬가르 소각병 10명을 처치해야 합니다.‡Mata a 10 incineradores Krom\'gar.‡Mata a 10 incineradores Krom\'gar.‡Tuez 10 Incinérateurs de Krom’gar.‡杀死10名克罗姆加焚化者。‡殺死10個克羅姆加焚化者。',
  }
},
[25617] = {
  {
    'Gorja adentro‡Из огня да в полымя!‡In den Schlund!‡불구덩이 속으로!‡¡Directo a las fauces!‡¡Directo a las fauces!‡Dans la gueule du loup !‡深入火口！‡深入險地!',
    nil,
    'Atravesse o portal de chamas no topo do Salto Relâmpago, em Monte Hyjal. Em seguida fale com Jardel Olafson.‡Пройдите через огненные врата на вершине Уступа Молний на горе Хиджал, а затем поговорите с Йорданом Олафсоном.‡Durchschreitet das Flammentor oben am Gewittersims auf dem Hyjal und sprecht mit Jordan Olafson auf der anderen Seite.‡하이잘 산의 번개치는 절벽 위에 있는 화염관문으로 들어간 다음, 그 안의 조던 올라프손과 대화해야 합니다.‡Atraviesa la puerta de llamas en lo alto del Saliente de Relámpagos en Monte Hyjal, y habla con Jordan Olafson en el interior.‡Atraviesa la puerta de llamas en lo alto del Saliente de Relámpagos en Monte Hyjal, y habla con Jordan Olafson en el interior.‡Traversez le portail de flammes au sommet de l’Escarpement de Foudre, sur le Mont Hyjal, puis parlez à Jordan Olafson.‡穿过海加尔山闪电崖上的火焰之门，跟里面的乔丹·奥拉夫森谈一谈。‡到海加爾山的閃電高地上，穿過烈焰之門，和裡頭的喬丹‧歐拉夫森說話。',
  }
},
[25618] = {
  {
    'Gorja adentro‡Из огня да в полымя!‡In den Schlund!‡불구덩이 속으로!‡¡Directo a las fauces!‡¡Directo a las fauces!‡Dans la gueule du loup !‡进入传送门！‡深入險地!',
    nil,
    'Atravesse o portal de chamas no topo do Salto Relâmpago, em Monte Hyjal. Em seguida fale com Jardel Olafson.‡Пройдите через огненные врата на вершине Уступа Молний на горе Хиджал, а затем поговорите с Йорданом Олафсоном.‡Durchschreitet das Flammentor oben am Gewittersims auf dem Hyjal und sprecht mit Jordan Olafson auf der anderen Seite.‡하이잘 산의 번개치는 절벽 위에 있는 화염관문으로 들어간 다음, 그 안의 조던 올라프손과 대화해야 합니다.‡Atraviesa la puerta de llamas en lo alto del Saliente de Relámpagos en Monte Hyjal, y habla con Jordan Olafson en el interior.‡Atraviesa la puerta de llamas en lo alto del Saliente de Relámpagos en Monte Hyjal, y habla con Jordan Olafson en el interior.‡Franchissez le portail de flammes au sommet de l’Escarpement de Foudre, sur le Mont Hyjal, et parlez à Jordan Olafson, qui se trouve de l’autre côté.‡跨过海加尔山闪电崖顶端的火焰之门，跟乔丹·奥拉夫森谈一谈。‡穿過在海加爾山的閃電高地上的烈焰之門，和裡面的喬丹‧歐拉夫森談話。',
  }
},
[25619] = {
  {
    'Reocupação‡Повторный захват‡Wiederbesetzung‡재취업‡Reocupación‡Reocupación‡Réoccupation‡收复失地‡收復',
    nil,
    'Mate 10 defensores Kvaldir nas Ruínas de Vashj\'ir.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Убейте 10 квалдирских защитников в Руинах Вайш\'ира.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, воспользуйтесь в нужном месте клинком воительницы Леди Наз\'жар.‡Tötet 10 Verteidiger der Kvaldir in den Ruinen von Vashj\'ir.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡바쉬르 폐허에 있는 크발디르들을 10명 처치하십시오.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 가야 합니다.‡Mata a 10 defensores Kvaldir en las Ruinas de Vashj\'ir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Mata a 10 defensores Kvaldir en las Ruinas de Vashj\'ir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Tuez 10 Défenseurs kvaldirs dans les Ruines de Vashj\'ir.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡在瓦丝琪尔废墟里击败任意10名防御城市的克瓦迪尔人。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回到影像中。‡在瓦許伊爾廢墟消滅10名科瓦迪爾防衛者。|n|n這項任務是納茲賈爾戰鬥仕女幻象的一部分。如果有必要，在某個時間點使用納茲賈爾戰鬥仕女之刃，好回到幻象之中。',
  }
},
[25620] = {
  {
    'A Dama Venerada‡Моя прекрасная леди‡Die ehrwürdige Lady‡경애하는 여군주님‡La Dama Venerada‡La Dama Venerada‡La Dame révérée‡尊敬的女士‡受尊敬的女士',
    nil,
    'Fale com a Lady Naz\'jar na extremidade norte dos Jardins de Quel\'Durmar.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Поговорите с Леди Наз\'жар в северной части садов Кель\'Дормир.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Sprecht mit Lady Naz\'jar am nördlichen Ende der Gärten von Quel\'Dormir.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡쿠엘도르미르 정원 북쪽 끝에 있는 여군주 나즈자르와 대화해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Habla con Lady Naz\'jar en el extremo norte de los Jardines de Quel\'Dormir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Habla con Lady Naz\'jar en el extremo norte de los Jardines de Quel\'Dormir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Parlez à dame Naz\'jar à l’extrémité nord des Jardins de Quel’Dormir.|n|nCette mission fait partie de la vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡跟奎尔多米尔花园北端的纳兹夏尔女士谈一谈。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回到影像中。‡到奎多米爾花園的北方盡頭和納茲賈爾女士談談。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25621] = {
  {
    'Teste de campo: Gnomofone‡Полевые испытания: ГНМ-передатчик‡Feldversuch: Gnomcorder‡현장 실험: 노움특제전송기‡Prueba de campo: la gnomograbadora‡Prueba de campo: la gnomograbadora‡Test gnomotophone : un, deux, micro…‡实地试验：侏儒通讯器‡實地測試:地精自動紀錄器',
    nil,
    'Entre na Cordilheira das Torres de Pedra e viaje para o sul, ao longo da Trilha Garracava, até alcançar uma Máquina Perfuradora Goblin.‡Ступайте в Когтистые горы и идите по Тропе Когтя, пока не наткнетесь на гоблинскую сверлильную машину.‡Begebt Euch ins Steinkrallengebirge und geht den Steinkrallenpass Richtung Süden entlang, bis Ihr die große Goblinbohrmaschine findet.‡돌발톱 산맥으로 가서 갈퀴자국 고개를 따라 남쪽으로 내려가 고블린 굴착기를 찾아야 합니다.‡Adéntrate en Sierra Espolón y viaja hacia el sur por el Desfiladero del Espolón hasta que encuentres la taladradora goblin.‡Adéntrate en Sierra Espolón y viaja hacia el sur por el Desfiladero del Espolón hasta que encuentres la taladradora goblin.‡Entrez dans les Serres-Rocheuses et dirigez-vous vers le sud, dans la Passe des Serres, jusqu’à arriver près d’un engin de chantier gobelin.‡进入石爪山脉，沿着石抓小径南部来到地精钻机处。‡進入石爪山脈，沿深爪小徑往南方走到一台哥布林鑽孔機處。',
  }
},
[25622] = {
  {
    'Queima de estoque‡Гори-гори ясно!‡Burn, Baby, Burn!‡타올라라, 활활, 타올라라!‡¡Arde, nena, arde!‡¡Arde, nena, arde!‡Flammes à gogo‡烧起来吧，宝贝儿，烧起来！‡燃燒吧，寶貝！',
    nil,
    'Obtenha um Lança-chamas do Brado Guerreiro de um Incinerador do Brado Guerreiro e use-o para destruir 8 Estoques do Brado Guerreiro.‡Добудьте огнемет Песни Войны у кром\'гарских поджигателей и с его помощью сожгите 8 схронов Песни Войны.‡Bringt einen Flammenwerfer des Kriegshymnenklans von einem Verbrenner von Krom\'gar an Euch und benutzt ihn, um 8 Vorräte des Kriegshymnenklans zu zerstören.‡크롬가르 소각병으로부터 전쟁노래 화염방사기를 획득해 전쟁노래 비품 8개를 불태워야 합니다.‡Consigue un lanzallamas Grito de Guerra de un incinerador Krom\'gar y utilízalo para destruir 8 reservas Grito de Guerra.‡Consigue un lanzallamas Grito de Guerra de un incinerador Krom\'gar y utilízalo para destruir 8 reservas Grito de Guerra.‡Procurez-vous un Lance-flammes chanteguerre en tuant un Incinérateur de Krom\'gar et utilisez-le pour détruire 8 Réserves chanteguerres.‡从克罗姆加焚化者手里获得战歌火焰喷射器，用战歌火焰喷射器摧毁8堆战歌物资。‡從戰歌焚化者身上取得戰歌火焰噴射器，並使用戰歌火焰噴射器燒毀8個戰歌儲物箱。',
  }
},
[25623] = {
  {
    'Gorja adentro‡Из огня да в полымя!‡In den Schlund!‡불구덩이 속으로!‡¡Directo a las fauces!‡‡Dans la gueule du loup !‡进入传送门！‡深入險地!',
    nil,
    'Atravesse o portal de chamas no topo do Salto Relâmpago, em Monte Hyjal. Em seguida fale com Jardel Olafson.‡Пройдите через огненные врата на вершине Уступа Молний на горе Хиджал, а затем поговорите с Йорданом Олафсоном.‡Durchschreitet das Flammentor oben am Gewittersims auf dem Hyjal und sprecht mit Jordan Olafson auf der anderen Seite.‡하이잘 산의 번개치는 절벽 위에 있는 화염관문으로 들어간 다음, 그 안의 조던 올라프손과 대화해야 합니다.‡Atraviesa la puerta de llamas en lo alto del Saliente de Relámpagos en Monte Hyjal, y habla con Jordan Olafson en el interior.‡‡Traversez le portail de flammes au sommet de l’Escarpement de Foudre, sur le Mont Hyjal, puis parlez à Jordan Olafson.‡跨过海加尔山闪电崖顶端的火焰之门，跟乔丹·奥拉夫森谈一谈。‡穿過在海加爾山的閃電高地上的烈焰之門，和裡面的喬丹‧歐拉夫森談話。',
  }
},
[25624] = {
  {
    '‡Из огня да в полымя!‡In den Schlund!‡불구덩이 속으로!‡¡Directo a las fauces!‡‡Dans la gueule du loup !‡深入火口！‡',
    nil,
    '‡Пройдите через огненные врата на вершине Уступа Молний на горе Хиджал, а затем поговорите с Йорданом Олафсоном.‡Durchschreitet das Flammentor oben am Gewittersims auf dem Hyjal und sprecht mit Jordan Olafson auf der anderen Seite.‡하이잘 산의 번개치는 절벽 위에 있는 화염관문으로 들어간 다음, 그 안의 조던 올라프손과 대화해야 합니다.‡Atraviesa la puerta de llamas en lo alto del Saliente de Relámpagos en Monte Hyjal, y habla con Jordan Olafson en el interior.‡‡Traversez le portail de flammes au sommet de l\'Escarpement de Foudre, sur le Mont Hyjal, puis parlez à Jordan Olafson.‡穿过海加尔山闪电崖上的火焰之门，跟里面的乔丹·奥拉夫森谈一谈。‡',
  }
},
[25625] = {
  {
    '‡‡Zu den Ruinen durchdringen‡폐허를 뚫고서‡Perforando las ruinas‡‡Le percement des ruines‡‡',
    nil,
    nil,
  }
},
[25626] = {
  {
    'Visões do passado: ascensão das profundezas‡Видения прошлого: подъем из глубин‡Visionen der Vergangenheit: Aufstieg aus der Tiefe‡과거의 환영: 드러나는 심연‡Visiones del pasado: Desde las profundidades‡Visiones del pasado: Desde las profundidades‡Visions du passé : le soulèvement des abysses‡过去的影像：自深渊崛起‡過去的幻景:從深淵崛起',
    nil,
    'Observe a história da Dama Guerreira usando a lâmina quebrada no Templo de Quel\'Durmar.‡Воспользуйтесь сломанным клинком Воительницы в храме Кель\'Дормир и посмотрите заключительную часть истории.‡Werdet Zeuge der letzten Geschichte der Kriegsmaid, indem Ihr ihre gebrochene Klinge im Tempel von Quel\'Dormir benutzt.‡쿠엘도르미르 사원 어딘가에서 부러진 창을 사용하여 나가 여전사의 마지막 이야기를 지켜보아야 합니다.‡Contempla el desenlace de la historia de la doncella de batalla utilizando su hoja rota en algún lugar del Templo de Quel\'Dormir.‡Contempla el desenlace de la historia de la doncella de batalla utilizando su hoja rota en algún lugar del Templo de Quel\'Dormir.‡Apprenez l’épilogue de l’histoire de la vierge combattante en utilisant sa lame brisée quelque part dans le temple de Quel’Dormir.‡在奎尔多米尔神殿某处使用女武士的断剑来目睹她最后的经历。‡在奎多米爾神殿的某處使用戰鬥仕女的斷劍，來見證她故事的結局。',
  }
},
[25627] = {
  {
    'A queda de Tony Duas-presas‡Убрать Тони Два Клыка‡Abreibung für Zweihauer‡쌍엄니 소탕 작전‡Derrota a Dos Colmillos‡Derrota a Dos Colmillos‡Prise de clé‡扳倒双牙‡放倒雙牙',
    nil,
    'Consiga a Chave Enferrujada da Jaula.‡Раздобудьте ржавый ключ от клетки.‡Erhaltet den rostigen Käfigschlüssel.‡녹슨 우리 열쇠를 획득해야 합니다.‡Consigue la llave de jaula oxidada.‡Consigue la llave de jaula oxidada.‡Obtenez la Clé de cage rouillée.‡夺取生锈的牢笼钥匙。‡取得生鏽的牢籠鑰匙。',
  }
},
[25628] = {
  {
    'A queda de Tony Duas-presas‡Убрать Тони Два Клыка‡Abreibung für Zweihauer‡쌍엄니 소탕 작전‡Derrota a Dos Colmillos‡Derrota a Dos Colmillos‡Prise de clé‡扳倒双牙‡放倒雙牙',
    nil,
    'Consiga a Chave Enferrujada da Jaula.‡Раздобудьте ржавый ключ от клетки.‡Erhaltet den rostigen Käfigschlüssel.‡녹슨 우리 열쇠를 획득해야 합니다.‡Consigue la llave de jaula oxidada.‡Consigue la llave de jaula oxidada.‡Obtenez la Clé de cage rouillée.‡夺取生锈的牢笼钥匙。‡取得生鏽的牢籠鑰匙。',
  }
},
[25629] = {
  {
    'A guarda da Dama‡Указание госпожи‡Die Hand der Lady‡여군주의 손길‡La mano de su Dama‡La mano de su Dama‡La Dame ordonne‡尊敬女士的帮手‡女士之手',
    nil,
    'Derrote os oponentes de 8 Guardas de Honra Naz\'jar no campo de batalha e passe as novas ordens para eles.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Найдите на поле боя 8 отважных стражей Леди Наз\'жар, победите их противников и передайте им новые приказы.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Besiegt die Gegner von 8 Mitgliedern der Ehrenwache der Naz\'jar und übergebt ihnen ihre neuen Befehle.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡전장에서 나즈자르 근위병 8명의 적을 쓰러뜨리고 새로 내려진 명령을 전달해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Derrota a los adversarios de 8 guardias de honor Naz\'jar en las Ruinas de Vashj\'ir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Derrota a los adversarios de 8 guardias de honor Naz\'jar en las Ruinas de Vashj\'ir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Tuez les adversaires de 8 Gardes d’honneur naz’jar sur le champ de bataille et remettez-leur les nouveaux ordres.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡在战场上打败8名纳兹夏尔荣誉守卫的对手，给他们下达新的命令。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡在戰場上擊敗8名納茲賈爾榮譽守衛的敵人，並將新的命令傳遞給他們。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25630] = {
  {
    'O incêndio do Monte Hyjal‡Хиджал в огне‡Die Feuer des Hyjal‡불타는 하이잘 산‡Los incendios de Monte Hyjal‡Los incendios de Monte Hyjal‡Les feux du mont Hyjal‡海加尔山之火‡海加爾山之火',
    nil,
    'Fale com Laina Nocticelo perto do Bosque de Aessina, em Hyjal.‡Поговорите с Лайной Ночное Небо возле Рощи Эссины на горе Хиджал.‡Sprecht mit Laina Nachthimmel in der Nähe des Hains von Aessina auf dem Hyjal.‡하이잘의 아에시나의 숲 근처에 있는 라이나 나이트스카이와 대화해야 합니다.‡Habla con Laina Cielo Nocturno cerca de la Arboleda de Aessina en Hyjal.‡Habla con Laina Cielo Nocturno cerca de la Arboleda de Aessina en Hyjal.‡Parlez à Laina Nocteciel près du Bosquet d’Aessina, à Hyjal.‡跟海加尔山艾森娜林地的莱恩娜·夜空谈一谈。‡前往海加爾的艾森娜之林附近和萊娜‧夜空談談。',
  }
},
[25631] = {
  {
    '‡Внезапный удар‡Überraschungsangriff‡경계 태세‡Con la guardia bajada‡‡Sécurisation du périmètre‡毫无防备‡',
    nil,
    '‡Уничтожьте 10 патрульных Азш\'ира.‡Tötet 10 Patrouillen der Azsh\'ir.‡아즈쉬르 순찰병 10마리를 처치해야 합니다.‡Mata a 10 patrullas de Azsh\'ir.‡‡Tuez 10 Patrouilleurs azsh\'ir.‡杀死10名艾萨尔巡逻兵。‡',
  }
},
[25632] = {
  {
    '‡Быстрый подход‡Schnelles Handeln‡신속한 접근‡Aproximación rápida‡‡Approche furtive‡蹑手蹑脚‡',
    nil,
    '‡Уничтожьте 10 часовых Азш\'ира.‡Zerstört 10 Wächterzauberschutze der Azsh\'ir.‡아즈쉬르 감시기 10개를 파괴해야 합니다.‡Destruye 10 avizores de Azsh\'ir.‡‡Détruisez 10 Factionnaires azsh\'ir.‡‡',
  }
},
[25633] = {
  {
    '‡Чтобы занять время‡Suche nach der Vergangenheit‡시간 작업‡Para matar el rato‡‡Passe-temps innocent‡时光的记录‡',
    nil,
    '‡‡Untersucht die 6 unversehrten Statuen in den Gärten von Vashj\'ir.‡바쉬르 정원에 있는 온전한 석상을 6개 조사해야 합니다.‡Investiga las 6 estatuas intactas de los jardines de Vashj\'ir.‡‡Examinez les 6 Statues intactes dans les Jardins de Vashj\'ir.‡‡',
  }
},
[25634] = {
  {
    '‡Новая база‡Ein besserer Standort‡유리한 고지‡Una mejor ventaja‡‡Une meilleure position‡奇袭点‡',
    nil,
    '‡‡Späht den Gartenplatz, die Hauptstraße und den Tempelbezirk aus.‡바쉬르 정원, 주요 도로, 신전 구역을 정찰해야 합니다.‡Explora la plaza del jardín, el camino principal y el distrito del templo.‡‡Explorez les Jardins, la Route principale et le Quartier du temple.‡‡',
  }
},
[25635] = {
  {
    '‡На поле брани‡Auf dem Schlachtfeld‡전투 현장에서‡En la escena de la batalla‡‡Sur le théâtre d\'opérations‡在战斗现场‡',
    nil,
    '‡‡Bringt das Bruchstück zurück zur Höhle.‡부러진 조각을 동굴로 가져가야 합니다.‡Lleva el fragmento roto de vuelta a LA CUEVA.‡‡Rapportez le Fragment brisé à LA CAVERNE.‡‡',
  }
},
[25636] = {
  {
    '‡Холоду суп, а жару – в зуб‡Schildkrötensuppe für die Seele‡‡Ayuna con fiebre y come resfriado‡‡Rester au chaud et transpirer‡‡',
    nil,
    '‡Добудьте 4 куска мяса пятнистой морской черепахи.‡Sammelt 4 Stück Schildkrötenfleisch von gesprenkelten Meeresschildkröten.‡‡Reúne 4 carnes de tortuga de tortugas marinas moteadas.‡‡Prélevez 4 morceaux de Viande de tortue sur des Tortues de mer mouchetées.‡‡',
  }
},
[25637] = {
  {
    'O chamado do Senhor das Profundezas‡Зов Повелителя глубин‡Auf den Ruf des Tiefenlords‡심해군주의 부름‡La llamada del señor de las profundidades‡La llamada del señor de las profundidades‡À l’appel du seigneur des fonds‡响应深水领主的号召‡深淵領主的召喚',
    nil,
    'Mate 16 Kvaldir no Terraço de Nar\'shola, que fica no nível intermediário das ruínas.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Убейте 16 квалдиров на террасе Нар\'шолы.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужный момент воспользуйтесь клинком воительницы Леди Наз\'жар.‡Tötet 16 Kvaldir auf der Terrasse von Nar\'shola, der mittleren Ebene der Ruinen.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡폐허의 중간층 나르숄라 계단지에서 크발디르 16마리를 처치해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Mata a 16 Kvaldir en el Bancal de Nar\'shola, en el nivel medio de las ruinas.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Mata a 16 Kvaldir en el Bancal de Nar\'shola, en el nivel medio de las ruinas.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Tuez 16 Kvaldirs sur la Terrasse de Nar’shola, le niveau intermédiaire des ruines.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡消灭纳舒拉平台上的16名克瓦迪尔人。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回到影像中。‡在納爾朔拉殿堂殺死16名科瓦迪爾人。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25638] = {
  {
    'Um pedido desesperado‡Мольба о помощи‡Eine verzweifelte Bitte‡절박한 부탁‡Un ruego desesperado‡Un ruego desesperado‡Une supplique désespérée‡绝望的请求‡絕望的請求',
    nil,
    'Leve o Bilhete Encharcado para Erunak em Beira Fundo.‡Отнесите промокшую записку Эрунаку на Конец отмели.‡Bringt die durchnässte Notiz zu Erunak am Tiefgang.‡여울의 끝자락에 있는 에루낙에게 젖은 쪽지를 가져가야 합니다.‡Lleva la nota empapada a Erunak, en el Confín del Bajío.‡Lleva la nota empapada a Erunak, en el Confín del Bajío.‡Apportez la Note trempée à Erunak, sur les Hauts-Fonds.‡将浸水的笔记交给海蕈石的埃鲁纳克。‡拿溼透的便箋到淺灘之末給伊魯納克',
  }
},
[25639] = {
  {
    '[DND] Test Rifts‡[DND] Test Rifts‡[DND] Testrisse‡[DND] Test Rifts‡[DND] Test Rifts‡[DND] Test Rifts‡[DND] Test Rifts‡[DND] Test Rifts‡[DND] Test Rifts',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[25640] = {
  {
    'Lançar bombas: Mina Cortavento!‡Сбрасывай бомбу: рудник Ветрорезов!‡Feuer frei: Scherwindmine!‡폭격 주의보: 칼바람 광산!‡¡Bombas fuera: Mina Cortaviento!‡¡Bombas fuera: Mina Cortaviento!‡Bombes aisées de la mine des Cisailles !‡炸弹投放：狂风矿洞！‡盡情轟炸:狂風礦坑!',
    nil,
    'Apresente-se a Boog, o "Encantador de Engrenagens", na Mina Cortavento, que fica na Cordilheira das Torres de Pedra.‡Разыщите Буга "Моднявого" в руднике Ветрорезов в Когтистых горах.‡Sprecht mit Boog dem "Zahnradflüsterer" an der Scherwindmine im Steinkrallengebirge.‡돌발톱 산맥의 칼바람 광산에서 "기계와 대화하는 자" 부그에게 보고해야 합니다.‡Informa a Boog "El hombre que susurraba a los engranajes" en la Mina Cortaviento, en Sierra Espolón.‡Informa a Boog "El hombre que susurraba a los engranajes" en la Mina Cortaviento, en Sierra Espolón.‡Parlez à Boug « le gnome qui murmurait à l’oreille des rouages » à la Mine des Cisailles, dans les Serres-Rocheuses.‡去找石爪山脉狂风矿洞的“齿轮语者”布格。‡到石爪山脈的狂風礦坑向『齒輪耳語者』布格和敏克絲回報。',
  }
},
[25641] = {
  {
    'Qual é o muisec?‡Поток уменьшения‡Muiseknachschub‡뮤세크의 흐름‡El flujo del muisek‡El flujo del muisek‡En avant le muisek‡灵魂精华的流动‡流動的靈魂精華',
    nil,
    'Entregue o Recipiente de Muisec ao Mandingueiro Uzer\'i na Aldeia Mojache, em Feralas.‡Принесите сосуд уменьшения знахарю Узер\'и в лагерь Мохаче в Фераласе.‡Bringt das Gefäß für Hippogryphenmuisek zu Hexendoktor Uzer\'i in Camp Mojache in Feralas.‡페랄라스의 모자케 야영지에 있는 의술사 우제리에게 뮤세크 단지를 가져가야 합니다.‡Entrega la vasija de muisek al Médico brujo Uzer\'i en Campamento Mojache en Feralas.‡Entrega la vasija de muisek al Médico brujo Uzer\'i en Campamento Mojache en Feralas.‡Apportez le Récipient à muisek au Féticheur Uzer’i au Camp Mojache, en Féralas.‡将灵魂精华容器交给菲拉斯莫沙彻营地的巫医尤克里。‡把靈魂精華容器帶去菲拉斯的莫沙徹營地，遞交給巫醫尤克里。',
  }
},
[25642] = {
  {
    'Não os encare‡Не смотри им в глаза‡Schaut ihnen nicht in die Augen‡눈뜬 장님들‡No les mires a los ojos‡No les mires a los ojos‡Ne les regardez pas dans les yeux‡别瞧他们的眼睛‡別直視他們',
    nil,
    'Consiga 10 amostras de Minério de Ferro Lazúli.‡Соберите 10 образцов лазурной железной руды.‡Sammelt 10 Proben azurblaues Eisenerz ein.‡하늘빛 철 광석 표본 10개를 모아야 합니다.‡Recoge 10 menas de hierro azul.‡Recoge 10 menas de hierro azul.‡Obtenez 10 échantillons de Minerai de fer azur.‡收集10份天青铁矿石样本。‡收集10份蒼藍鐵礦石樣本。',
  }
},
[25643] = {
  {
    'As Ruínas Névoa Negra‡Руины Мглистой пещеры‡Die Graunebelruinen‡암흑안개 폐허‡Ruinas Niebla Negra‡Ruinas Niebla Negra‡Les ruines de Sombrebrume‡黑雾废墟‡黑霧廢墟',
    nil,
    'Vasculhe as Ruínas Névoa Negra atrás do amuleto que o Sábio Corre Claro descreveu.‡Отыщите в руинах Мглистой пещеры амулет, о котором говорил ведун Легкая Побежка.‡Sucht in den Graunebelruinen nach dem Amulett, das der Weise Bleichlauf beschrieben hat.‡암흑안개 폐허에서 현자 페일러너가 말한 아뮬렛을 찾아야 합니다.‡Registra las Ruinas Niebla Negra en busca del amuleto que el Sabio Correpálido te describió.‡Registra las Ruinas Niebla Negra en busca del amuleto que el Sabio Correpálido te describió.‡Fouillez les Ruines de Sombrebrume pour retrouver l’Amulette que le Sage Coureur-pâle vous a décrite.‡在黑雾废墟寻找圣者帕尔伦纳描述的护符。‡到黑霧廢墟去找出賢者帕爾倫納描述的護符。',
  }
},
[25644] = {
  {
    'O ovo do Crepúsculo‡Яйцо чистого сумрака‡Das Zwielichtei‡황혼의 알‡El huevo Crepuscular‡El huevo Crepuscular‡L\'œuf du Crépuscule‡暮光龙卵‡暮光龍蛋',
    nil,
    'Entregue o Ovo Puro do Crepúsculo para Aronus nos Portões de Sothann, em Hyjal.‡Отнесите яйцо чистого сумрака Аронию к Вратам Созанна на Хиджале.‡Bringt das reine Zwielichtei zu Aronus an den Toren von Sothann auf dem Hyjal.‡하이잘의 소단 관문에 있는 아로누스에게 순전한 황혼의 알을 가져가야 합니다.‡Lleva el huevo Crepuscular puro a Aronus en las Puertas de Sothann en Hyjal.‡Lleva el huevo Crepuscular puro a Aronus en las Puertas de Sothann en Hyjal.‡Apportez l’Œuf pur du Crépuscule à Aronus aux Portes de Sothann, à Hyjal.‡把纯净的暮光龙卵带给海加尔山索萨恩之门的阿隆努斯。‡將純潔暮光龍蛋帶去海加爾的索桑恩之門給艾羅努斯。',
  }
},
[25645] = {
  {
    'Fale novamente com o Sábio Corre Claro‡Вернуться к ведуну Легкая Побежка‡Kehrt zum Weisen Bleichlauf zurück‡현자 페일러너에게로‡Vuelve con el Sabio Correpálido‡Vuelve con el Sabio Correpálido‡Retournez voir le sage Coureur-pâle‡去找圣者帕尔伦纳‡回訪賢者帕爾倫納',
    nil,
    'Leve o Amuleto Névoa Negra para o Sábio Corre Claro.‡Отнесите амулет Мглистой пещеры ведуну Легкая Побежка.‡Bringt das Graunebelamulett zum Weisen Bleichlauf.‡현자 페일러너에게 암흑안개 아뮬렛을 가져가야 합니다.‡Lleva el amuleto Niebla Negra al Sabio Correpálido.‡Lleva el amuleto Niebla Negra al Sabio Correpálido.‡Apportez l’Amulette de Sombrebrume au Sage Coureur-pâle.‡将黑雾护符交给圣者帕尔伦纳。‡帶暗霧護符去給賢者帕爾倫納。',
  }
},
[25646] = {
  {
    'Limpeza da Mina Cortavento‡Зачистка рудника Ветрорезов‡Säuberung der Scherwindmine‡칼바람 광산 청소‡Despejar la Mina Cortaviento‡Despejar la Mina Cortaviento‡La purge de la mine des Cisailles‡狂风矿洞大扫除‡清理狂風礦坑',
    nil,
    'Mate 6 Feitores de Cortavento.‡Убейте 6 надзирателей долины Ветрорезов.‡Tötet 6 Vorarbeiter der Scherwindmine.‡칼바람 감시자 6명을 처치해야 합니다.‡Mata a 6 sobrestantes Cortaviento.‡Mata a 6 sobrestantes Cortaviento.‡Tuez 6 Surveillants des Cisailles.‡杀死6名风剪监工。‡殺死6個狂風監督者。',
  }
},
[25647] = {
  {
    'Carta orc ilegível‡Не поддающееся чтению письмо орков‡Unleserlicher Orcbrief‡읽을 수 없는 오크 편지‡Una carta de orco ilegible‡Una carta de orco ilegible‡La lettre en orc illisible‡字迹模糊的兽人信件‡無法判讀的獸人信件',
    nil,
    'Leve a Carta Orc Ilegível a Boog, o "Encantador de Engrenagens", na Mina Cortavento, que fica na Cordilheira das Torres de Pedra.‡Отнесите не поддающееся чтению письмо орков Бугу "Моднявому" в рудник Ветрорезов в Когтистых горах.‡Bringt den unleserlichen Orcbrief zu Boog dem "Zahnradflüsterer" an der Scherwindmine im Steinkrallengebirge.‡돌발톱 산맥의 칼바람 광산에 있는 "기계와 대화하는 자" 부그에게 읽을 수 없는 오크 편지를 가져가야 합니다.‡Lleva la carta de orco ilegible a Boog "El hombre que susurraba a los engranajes" a la Mina Cortaviento, en Sierra Espolón.‡Lleva la carta de orco ilegible a Boog "El hombre que susurraba a los engranajes" a la Mina Cortaviento, en Sierra Espolón.‡Apportez la Lettre en orc illisible à Boug « le gnome qui murmurait à l’oreille des rouages » à la Mine des Cisailles, dans les Serres-Rocheuses.‡把字迹模糊的兽人信件交给石爪山脉狂风矿洞的“齿轮语者”布格。‡將無法判讀的獸人信件帶去石爪山脈的狂風礦坑交給『齒輪耳語者』布格。',
  }
},
[25648] = {
  {
    'Além de Durotar‡За пределами Дуротара‡Jenseits von Durotar‡듀로타를 떠나서‡Más allá de Durotar‡Más allá de Durotar‡Au-delà de Durotar‡杜隆塔尔之外‡杜洛塔之外',
    nil,
    'Apresente-se a Ag\'tor Punho de Sangue no Portão Traseiro de Orgrimmar, que fica em Azshara.‡Свяжитесь с Аг\'тором Кровопалом у задних врат Оргриммара в Азшаре.‡Meldet Euch bei Ag\'tor Blutfaust am Hinteren Tor von Orgrimmar in Azshara.‡아즈샤라의 오그리마 뒷문에 있는 아그토르 블러드피스트에게 보고해야 합니다.‡Preséntate ante Ag\'tor Puñosangre en la Puerta Trasera de Orgrimmar, Azshara.‡Preséntate ante Ag\'tor Puñosangre en la Puerta Trasera de Orgrimmar, Azshara.‡Présentez-vous à Ag’tor Poing-de-sang, à la Porte d’Azshara, en Azshara.‡前往艾萨拉的奥格瑞玛后门，向阿格图·血拳报到。‡前往艾薩拉的奧格瑪後門向阿格圖·血拳回報。',
  }
},
[25649] = {
  {
    'Dada resolve a parada‡Минкс нам все скажет‡Minx wird\'s schon richten‡밍스가 해줄 거야‡Minx lo arreglará‡Minx lo arreglará‡Coquine va arranger ça‡明克斯能破译‡敏克絲會搞定它',
    nil,
    'Leve a Carta Orc Ilegível a Dada na Mina Cortavento, que fica na Cordilheira das Torres de Pedra.‡Отнесите не поддающееся чтению письмо орков Минкс в рудник Ветрорезов в Когтистых горах.‡Bringt den unleserlichen Orcbrief zu Minx in der Scherwindmine im Steinkrallengebirge.‡돌발톱 산맥의 칼바람 광산에 있는 밍스에게 읽을 수 없는 오크 편지를 가져가야 합니다.‡Lleva la carta de orco ilegible a Minx dentro de la Mina Cortaviento, en Sierra Espolón.‡Lleva la carta de orco ilegible a Minx dentro de la Mina Cortaviento, en Sierra Espolón.‡Apportez la Lettre en orc illisible à Coquine à l’intérieur de la mine des Cisailles, dans les Serres-Rocheuses.‡把字迹模糊的兽人信件交给石爪山脉狂风矿洞的明克斯‡將無法判讀的獸人信件帶去石爪山脈的狂風礦坑交給敏克絲。',
  }
},
[25650] = {
  {
    'Ordens do Alto Comando‡Приказы верховного командования‡Befehle des Oberkommandos‡총사령관의 명령‡Órdenes de arriba‡Órdenes de arriba‡Des ordres du haut commandement‡高级指挥官的命令‡來自高階指揮所的命令',
    nil,
    'Leve a Carta Orc Traduzida a Boog, o "Encantador de Engrenagens", na Mina Cortavento, que fica na Cordilheira das Torres de Pedra.‡Отнесите переведенное письмо орков Бугу "Моднявому" в рудник Ветрорезов в Когтистых горах.‡Bringt den übersetzten Orcbrief zu Boog dem "Zahnradflüsterer" an der Scherwindmine im Steinkrallengebirge.‡돌발톱 산맥의 칼바람 광산에 있는 "기계와 대화하는 자" 부그에게 번역한 오크 편지를 가져가야 합니다.‡Lleva la carta orca traducida a Boog "El hombre que susurraba a los engranajes" a la Mina Cortaviento, en Sierra Espolón.‡Lleva la carta orca traducida a Boog "El hombre que susurraba a los engranajes" a la Mina Cortaviento, en Sierra Espolón.‡Apportez la Lettre en orc traduite à Boug le « gnome qui murmurait à l’oreille des rouages » à la Mine des Cisailles, dans les Serres-Rocheuses.‡把翻译好的兽人信件交给石爪山脉狂风矿洞的“齿轮语者”布格。‡將翻譯好的獸人信件帶去石爪山脈的狂風礦坑交給『齒輪耳語者』布格。',
  }
},
[25651] = {
  {
    'Ah, que maluquice!‡Легкая поступь безумия‡Oh süßer Wahnsinn!‡정신 실종 사건‡¡Oh, la locura!‡¡Oh, la locura!‡Ali-Baba et les cinquante boulets‡噢，可怕的疯癫！‡噢，錯亂!',
    nil,
    'Colete 50 Balas de Canhão Roubadas do Salto de Gurboggle e de Acumuladores Guelblin. Use as Balas de Canhão para criar um Barril de Pólvora.‡Соберите на шельфе Гурбоггла 50 ворованных пушечных ядер или отберите их у жаблинов-скопидомов. Насыпьте из ядер полный бочонок пороха.‡Sammelt 50 gestohlene Kanonenkugeln auf Gurboggels Fels und von Hamsterern der Gilblin. Benutzt die Kanonenkugeln, um ein Fass mit Schießpulver herzustellen.‡거보글 절벽이나 길블린 저축가에게서 도둑맞은 포탄을 50개 수집하십시오. 수집한 포탄을 사용하여 화약 나무통을 만들어야 합니다.‡Consigue 50 bolas de cañón trincadas en el Saliente de Guraturdido y de acaparadores Gilblin. Usa las bolas de cañón para crear un barril de pólvora.‡Consigue 50 bolas de cañón trincadas en el Saliente de Guraturdido y de acaparadores Gilblin. Usa las bolas de cañón para crear un barril de pólvora.‡Récupérez 50 Boulets de canon chapardés à l’Escarpement de Globulle et sur des Amasseurs gloubelins. Ensuite, utilisez-les pour créer un Tonneau de poudre à canon.‡在戈博格海崖收集50枚被窃的炮弹，海地精贮藏者也携带着这种炮弹。将收集到的炮弹制成一桶火药。‡從葛爾巴果的岩礁和吉爾布林聚藏者身上收集50個失竊的砲彈。用砲彈合成火藥桶。',
  }
},
[25652] = {
  {
    'Confisque aquele balão!‡Порули воздушным шаром!‡Beschlagnahmt den Ballon!‡열기구 탈취‡¡Requisar el dirigible!‡¡Requisar el dirigible!‡Détournez ce ballon !‡操纵气球！‡搶下那顆氣球!',
    nil,
    'Voe no Balão de Ar Quente de Krom\'gar e tente impedi-lo de destruir a Vila de Cortavento.‡Заберитесь в кром\'гарский воздушный шар и попытайтесь остановить его, чтобы он не разрушил крепость Ветрорезов.‡Fahrt mit dem Heißluftballon von Krom\'gar und versucht zu verhindern, dass er die Scherwindfeste zerstört.‡크롬가르 열기구에 올라타 칼바람 요새를 파괴하지 못하게 막아야 합니다.‡Súbete al dirigible de Krom\'gar e intenta impedir que destruya el Bastión Cortaviento.‡Súbete al globo aerostático Krom\'gar e intenta impedir que destruya el Bastión Cortaviento.‡Grimpez à bord de la Montgolfière de Krom’gar et essayez de l’empêcher de détruire le Bastion des Cisailles.‡爬到克罗姆加热气球里去，阻止它摧毁风剪要塞。‡乘坐克羅姆加熱氣球，阻止它摧毀狂風堡。',
  }
},
[25653] = {
  {
    'Os anciãos estão entre nós‡Древние с нами‡Die Ahnen sind mit uns‡고대정령이 우리와 함께하시니‡Los ancestros están con nosotros‡Los ancestros están con nosotros‡Les anciens sont avec nous‡古神们与我们同在‡祖靈們與我們同在',
    nil,
    'Fale novamente com Ysera em Nordrassil, que fica no Monte Hyjal.‡Вернитесь к Изере, находящейся у Нордрассила на горе Хиджал.‡Kehrt zu Ysera in Nordrassil auf dem Hyjal zurück.‡하이잘 산의 놀드랏실에 있는 이세라에게 가야 합니다.‡Vuelve con Ysera en Nordrassil en Monte Hyjal.‡Vuelve con Ysera en Nordrassil en Monte Hyjal.‡Retournez voir Ysera à Nordrassil, au Mont Hyjal.‡去找海加尔山诺达希尔的伊瑟拉。‡回去海加爾山的諾達希爾找伊瑟拉。',
  }
},
[25654] = {
  {
    'Coração sombrio‡Темное сердце‡Dunkles Herz‡검은 심장‡Corazón oscuro‡Corazón oscuro‡Cœur noir‡黑暗坠饰‡黑心',
    nil,
    'Mate Edana Iragarra e consiga o Coração Sombrio de Edana.‡Убейте Эдану Коготь Ненависти и добудьте Темное сердце Эданы.‡Tötet Edana Hasskralle und erhaltet Edanas dunkles Herz.‡에다나 헤이트탈론을 처치하고 에다나의 검은 심장을 획득해야 합니다.‡Mata a Edana Garfaodio y obtén el corazón oscuro de Edana.‡Mata a Edana Garfaodio y obtén el corazón oscuro de Edana.‡Tuez Edana Serrehaine et prélevez-lui son Cœur noir.‡击败艾丹娜·邪爪，获得艾丹娜的黑色坠饰。‡殺死艾丹娜並取得艾丹娜的黑心。',
  }
},
[25655] = {
  {
    'A questão Alaverme‡Трения с Червивым Крылом‡Das Wurmschwingenproblem‡골치 아픈 벌레날개 일족‡El problema con las Alagusano‡El problema con las Alagusano‡Le facteur aile-de-ver‡虫翅问题‡蠕翼問題',
    nil,
    'Mate 10 Harpias Alaverme de qualquer tipo, Guinchadoras ou Garravelozes.‡Убейте 10 гарпий из стаи Червивого Крыла (крикуний либо стремительных когтей).‡Tötet 10 Harpyien der Wurmschwingen (Kreischerinnen oder Schnellklauen).‡벌레날개 비명하피나 갈퀴하피를 종류에 상관없이 총 10마리 처치해야 합니다.‡Asesina cualquier combinación de 10 arpías Alagusano (tanto estridadoras como garraveloces).‡Asesina cualquier combinación de 10 arpías Alagusano (tanto estridadoras como garraveloces).‡Tuez 10 Harpies ailes-de-ver (Hurleuses ou Viveserres).‡消灭任意种类的10名虫翅鹰身人（尖啸者或者迅爪刺客。）‡消滅10個蠕翼鷹身人(尖嘯者或迅爪皆可)。',
  }
},
[25656] = {
  {
    'Cuidado: frágil‡Борьба за яйца‡Augen auf beim Eierklau‡알 구출 작전‡Huevos revueltos‡Huevos revueltos‡Des œufs embrouillés‡夺回巨蛋‡炒蛋',
    nil,
    'Recolha 8 Ovos de Hyjal.‡Соберите 8 хиджальских яиц.‡Sammelt 8 Hyjaleier.‡하이잘 알 8개를 수집해야 합니다.‡Reúne 8 huevos de Hyjal.‡Reúne 8 huevos de Hyjal.‡Récupérez 8 Œufs d\'Hyjal.‡收集8枚海加尔巨蛋。‡收集8顆海加爾山鳥蛋。',
  }
},
[25657] = {
  {
    'Um lanche pro peixinho‡Сундук Костеглода‡Da dap… Da dap...‡빠...밤, 빠...밤‡Na, nam... Na, nam...‡Na, nam... Na, nam...‡Taa-da… Taa-da… Taa-da…‡大白鲨逼近‡那個...那個...',
    nil,
    'O Bino quer que você use a Isca-bomba no Lança-arpão Enferrujado, que fica no Arrecife Amaldiçoado.‡Бадд хочет, чтобы вы выстрелили минированной приманкой из ржавого гарпунного ружья на Проклятом рифе.‡Budd möchte, dass Ihr den präparierten Köder bei der rostigen Harpunenkanone im Skelettriff benutzt.‡버드가 해골 암초에 있는 녹슨 작살총에 위장 폭탄용 미끼를 사용해 달라고 했습니다.‡Budd quiere que utilices el cebo bomba con el rifle de arpón oxidado en el Arrecife de Huesos.‡Budd quiere que utilices el cebo bomba con el rifle de arpón oxidado en el Arrecife de Huesos.‡Budd veut que vous utilisiez l’Appât piégé près du Lance-harpon rouillé, au Récif Squelettique.‡巴德要你对放置在骸骨珊瑚礁的生锈的猎鱼枪使用诱杀虫饵。‡霸德要你到骸骨沙洲，並在生鏽的魚叉獵槍使用詭雷誘餌。',
  }
},
[25658] = {
  {
    'Feito para durar‡На века‡Für die Ewigkeit gebaut‡설비 유지‡Construidos para durar‡Construidos para durar‡Construit pour durer‡耐久的设施‡永垂不朽',
    nil,
    'Reative 6 Defesas de Nar\'shola no Terraço de Nar\'shola, que fica no nível intermediário das ruínas.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Приведите в действие 6 щитов Нар\'шолы.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Reaktiviert 6 Barrieren von Nar\'shola.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡폐허의 중간층 나르숄라 계단지에 있는 나르숄라 수호물 6개를 다시 작동시켜야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Reactiva 6 resguardos de Nar\'shola en el nivel medio de las ruinas: el Bancal de Nar\'shola.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Reactiva 6 resguardos de Nar\'shola en el nivel medio de las ruinas: el Bancal de Nar\'shola.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Réactivez 6 Gardiens de Nar’shola sur la Terrasse de Nar’shola, le niveau intermédiaire des ruines.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡重启6处纳舒拉防御屏障。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回到影像中。‡啟動8個納爾朔拉防護裝置。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25659] = {
  {
    'Difícil de esquecer‡Такое не забывается‡Unvergesslich‡쉽게 잊지 못하리라‡Tardará en ser olvidado‡Tardará en ser olvidado‡Pas oublié de sitôt‡难以遗忘的往事‡不被遺忘',
    nil,
    'Mate Varkul, o Implacável.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Убейте Варкула Безжалостного.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жары". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Tötet Varkul den Unerbittlichen.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡무자비한 바르쿨을 처치해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Mata a Varkul el Inflexible.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Mata a Varkul el Inflexible.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Tuez Varkul le Tenace.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡杀死冷酷的瓦尔库。|n|n这项任务是纳兹夏尔女武士幻象的一部分。如有必要，可使用纳兹夏尔女武士之刃返回幻象。‡殺死『鐵面』瓦爾庫。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25660] = {
  {
    'Encosto‡Неупокоенный‡Verfolgt‡원혼‡Caza de brujas‡Caza de brujas‡C’est la « hante », mec !‡鬼上身‡鬧鬼',
    nil,
    'Fale com Azmina Tirencosto nas Raízes dos Mares do Sul, que ficam em Mil Agulhas.‡Обратитесь к Аджамон Призывательнице Духов в Укрепление Южных морей в Тысяче Игл.‡Sprecht mit Ajamon Geistrufer in Südmeerstützpunkt in Tausend Nadeln.‡버섯구름 봉우리의 남쪽바다 철통절벽에 있는 아야몬 고스트콜러와 대화해야 합니다.‡Habla con Ajamon Clamafantasmas en el Sargazo de los Mares del Sur, en Las Mil Agujas.‡Habla con Ajamon Clamafantasmas en el Sargazo de los Mares del Sur, en Las Mil Agujas.‡Allez parler à Ajamon Mande-fantôme, à la Redoute des mers du Sud, dans les Mille pointes.‡同千针石林南海据点的阿加蒙·招魂者交谈。‡在千針石林的南海營地與阿迦蒙·喚魂者交談。',
  }
},
[25661] = {
  {
    'Oferendas‡С миру по нитке...‡Mit ein bisschen Hilfe...‡작은 도움이면...‡Con un poco de ayuda...‡Con un poco de ayuda...‡Le fruit de leurs entrailles…‡帮点小忙……‡幫個小忙...',
    nil,
    'Consiga o Coração da Boneca dos Mares, o Pulmão do Lobo do Mar Fajardo e o Fígado da Lilly Água-doce.‡Раздобудьте сердце злой Долли, легкие морского волка Файярго и печень Лилли Сухопутной Крысы.‡Erhaltet Gruseldollys Herz, Seebär Fajardos Lungen und Lilly Landrattes Leber.‡사악한 돌리의 마음, 뱃사람 파하르도의 시커먼 속마음, 릴리 랜드러버의 인색한 마음을 모아야 합니다.‡Consigue el corazón de muñeca malvada, los pulmones de perro maligno Fajardo y el hígado de Lilly Marinero de agua dulce.‡Consigue el corazón de muñeca malvada, los pulmones de perro maligno Fajardo y el hígado de Lilly Marinero de agua dulce.‡Obtenez le Cœur de la Méchante Dolly, les Poumons du Loup de mer Fajardo et le Foie de Lilly D’eau-douce.‡找齐邪恶人偶、老海盗法哈多和“旱鸭子”莉莉的徽记。‡收集邪惡桃莉的心臟、老練水手法迦多的肺、以及旱鴨子莉莉的肝。',
  }
},
[25662] = {
  {
    'Liberte nossas irmãs‡Освободить наших сестер‡Befreit unsere Schwestern‡자매에게 자유를‡Liberar a las hermanas‡Liberar a las hermanas‡Libérez nos sœurs‡解救我们的姐妹‡解救姐妹',
    nil,
    'Obtenha 6 Chaves das Jaulas da Horda para libertar 6 Caçadoras Capturadas.‡Добудьте 5 ключей от клетки Орды и освободите 5 пленных охотниц.‡Bringt 5 Käfigschlüssel der Horde an Euch, um 5 gefangene Jägerinnen freizulassen.‡호드 철창 열쇠 5개를 입수하여 사로잡힌 여사냥꾼 5명을 구출해야 합니다.‡Consigue 5 llaves de jaula de la Horda para liberar a 5 cazadoras capturadas.‡Consigue 5 llaves de jaula de la Horda para liberar a 5 cazadoras capturadas.‡Obtenez 5 Clés de cage de la Horde pour libérer 5 Chasseresses capturées.‡获得5把部落牢笼钥匙，解救5名被俘的女猎手。‡取得5個部落牢籠鑰匙救出5個被俘虜的女獵手。',
  }
},
[25663] = {
  {
    'Oferenda para Aviana‡Подношение для Авианы‡Eine Gabe für Aviana‡아비아나에게 바치는 공물‡Una ofrenda para Aviana‡Una ofrenda para Aviana‡Une offrande pour Aviana‡献给艾维娜的祭品‡艾維娜的祭品',
    nil,
    'Entregue o Néctar Sagrado no Círculo Funeral de Aviana.‡Используйте священный нектар на Погребальном круге Авианы.‡Benutzt den heiligen Nektar an Avianas Grabkreis.‡아비아나의 원형 무덤에 신성한 감로수를 사용해야 합니다.‡Usa el néctar sacro en el Círculo de entierro de Aviana.‡Usa el néctar sacro en el Círculo de entierro de Aviana.‡Placez le Nectar sacré dans le Cercle funéraire d\'Aviana.‡在艾维娜的墓葬法阵里使用圣水。‡在艾維娜的墓地之環使用神聖甘露。',
  }
},
[25664] = {
  {
    'Uma prece e uma asa‡На честном слове и на одном крыле‡Ein Gebet und ein Flügel‡기도와 날개‡Una oración y un ala‡Una oración y un ala‡Une plume dans la main‡翅膀与祈祷‡祈禱者與單翼',
    nil,
    'Use o Pio Enorme em um dos Ninhos de Blaithe no alto do Perímetro do Mundo. Mate Blaithe e tire dele uma Pena Antiga.‡Используйте манок огромной птицы у одного из гнезд Блейта на Краю света. Убейте Блейта и заберите одно из древних перьев.‡Benutzt den riesigen Vogellockruf an einem von Blaithes Nestern oben am Rand der Welt. Tötet Blaithe und sammelt eine seiner uralten Federn.‡세상의 테두리 꼭대기의 블라이드의 둥지에서 거대한 새 호각을 사용하십시오. 블라이드를 처치하고 그의 고대의 깃털을 가져가야 합니다.‡Usa el trino de pájaro enorme en uno de los nidos de Blaithe que se encuentran en lo alto del Límite del Mundo. Mata a Blaithe y recoge una de sus plumas antiguas.‡Usa el trino de pájaro enorme en uno de los nidos de Blaithe que se encuentran en lo alto del Límite del Mundo. Mata a Blaithe y recoge una de sus plumas antiguas.‡Utilisez l\'Énorme appeau à oiseau près d\'un des nids de Blaithe perchés sur le Bord-du-monde. Tuez Blaithe et arrachez-lui une Plume ancienne.‡在世界之脊上找到任意一处布雷瑟的巢穴并使用巨鸟召唤哨，然后击败布雷瑟，获取他的一根远古之羽。‡在棲息在世界之邊緣的布雷斯巢上使用巨鳥呼哨。消滅布雷斯並收集牠古老的羽毛。',
  }
},
[25665] = {
  {
    'Um apelo do além‡Потусторонний зов‡Ein Gesuch aus dem Jenseits‡저 너머에서 들리는 절박한 부름‡Una petición del más allá‡Una petición del más allá‡Une supplique de l\'au-delà‡莫名的请求‡天外飛來求救信',
    nil,
    'Fale novamente com Choluna no Santuário de Aviana, no Monte Hyjal.‡Вернитесь к Чолуне в святилище Авианы на горе Хиджал.‡Kehrt zu Choluna im Schrein von Aviana auf dem Hyjal zurück.‡하이잘 산의 아비아나의 제단에 있는 초루나에게 가야 합니다.‡Vuelve con Choluna en el interior del Santuario de Aviana en Monte Hyjal.‡Vuelve con Choluna en el interior del Santuario de Aviana en Monte Hyjal.‡Retournez voir Choluna dans le Sanctuaire d\'Aviana, au Mont Hyjal.‡去找海加尔山艾维娜圣殿的楚伦娜。‡回去找海加爾山的艾維娜聖壇裡的克魯娜。',
  }
},
[25666] = {
  {
    'Botando a mão na massa‡Грязная работенка‡Macht Euch die Hände schmutzig‡한번 발을 들였으니‡A ensuciarse las manos‡A ensuciarse las manos‡Mettre les mains dans le cambouis‡脏活‡弄髒雙手',
    nil,
    'Colete 5 Entranhas Nojentas de Larva das Larvas do Mar Gigantes perto da Escavação de Harrison.‡Раздобудьте 5 грязных внутренностей морских червей, охотясь на гигантских морских червей возле Раскопок Харрисона.‡Sammelt 5 schmierige Madeneingeweide von gigantischen Meeresraupen in der Nähe von Harrisons Ausgrabung.‡해리슨의 발굴지 근처에 있는 거대 바다 굼벵이에게서 더러운 굼벵이 내장을 5개 모아야 합니다.‡Reúne 5 tripas de larva mugrientas de las larvas de mar gigantes que hay cerca de la Excavación de Harrison.‡Reúne 5 tripas de larva mugrientas de las larvas de mar gigantes que hay cerca de la Excavación de Harrison.‡Prélevez 5 Tripes de larve poisseuses sur des Larves de mer géantes près du Site de fouilles de Harrison.‡从哈里森挖掘场附近的巨海虫身上收集5份肮脏的虫子内脏。‡到哈里遜的挖掘場附近，從巨型海獸幼蟲身上收集5個髒兮兮的幼蟲內臟。',
  }
},
[25667] = {
  {
    'Controle populacional‡Истребление вендиго‡Die Wendigos erlegen‡웬디고 처치‡La matanza del wendigo‡La matanza del wendigo‡Sélection artificielle de wendigos‡宰杀雪怪‡滅除雪怪',
    nil,
    'Mate 10 Wendigos no Covil Cinzento. Você pode matar Wendigos ou Jovens Wendigos.‡Убейте 10 вендиго в Серой берлоге. Молодые вендиго тоже считаются.‡Tötet 10 Wendigos im Graufelsbau. Ihr könnt Wendigos oder junge Wendigos töten.‡은빛 동굴에 있는 웬디고 또는 새끼 웬디고 10마리를 처치해야 합니다.‡Mata a 10 wendigos en El Cubil Pardo. Puedes matar a wendigos o a wendigos jóvenes.‡Mata a 10 wendigos en El Cubil Pardo. Puedes matar a wendigos o a wendigos jóvenes.‡Tuez 10 Wendigos à l’antre Gris. Vous pouvez tuer des Wendigos ou de Jeunes wendigos.‡在灰色洞穴杀掉10只雪怪。你可以杀死雪怪或者雪怪幼崽。‡在灰色洞穴裡殺死10隻雪怪。你可以殺死雪怪或者小雪怪。',
  }
},
[25668] = {
  {
    'Suprimentos furtados‡Украденные припасы‡Gestohlene Vorräte‡도둑맞은 보급품‡Suministros trincados‡Suministros trincados‡Les fournitures chapardées‡被窃的补给品‡盜取補給',
    nil,
    'Recupere 6 caixotes de Suprimentos Roubados no Covil Cinzento.‡Найдите 6 украденных ящиков с припасами в Серой берлоге.‡Bergt 6 gestohlene Versorgungsgüter aus dem Graufelsbau.‡은빛 동굴에서 도둑맞은 보급품 6개를 회수해야 합니다.‡Consigue 6 suministros trincados de El Cubil Pardo.‡Consigue 6 suministros trincados de El Cubil Pardo.‡Récupérez 6 caisses de Fournitures chapardées dans l’Antre Gris.‡从灰色洞穴夺回6份被窃的补给品。‡從灰色洞穴取回6個失竊的補給物資。',
  }
},
[25669] = {
  {
    'A ameaça vem pelo ar‡Неспокойная лесопилка‡Es rappelt im Säge... Werk‡제재하라... 제재소‡¡Esta llave es la bomba!‡¡Esta llave es la bomba!‡Panique à la scierie‡大闹伐木场‡伐木場轟隆隆',
    nil,
    'Mate o Senhor da Guerra Roktrog e liberte a Caçadora Illiona usando a Chave da Jaula da Caçadora Illiona.‡Убейте полководца Роктрога, возьмите ключ от клетки охотницы Иллионы и освободите ее.‡Tötet Kriegsfürst Roktrog und befreit Jägerin Illiona, indem Ihr Jägerin Illionas Käfigschlüssel benutzt.‡장군 록트로그를 처치하고 여사냥꾼 일리오나의 철창 열쇠를 찾아 여사냥꾼 일리오나를 구해야 합니다.‡Mata al Señor de la Guerra Roktrog y libera a la cazadora Illiona utilizando la llave de jaula de la cazadora Illiona.‡Mata al Señor de la Guerra Roktrog y libera a la cazadora Illiona utilizando la llave de jaula de la cazadora Illiona.‡Tuez le Seigneur de guerre Roktrog et libérez la Chasseresse Illiona en utilisant la Clé de sa cage.‡杀死督军罗克托克，获得女猎手伊莉奥娜的牢笼钥匙，解救女猎手伊莉奥娜。‡殺死督軍羅克托格，並使用女獵手伊爾莉歐娜的牢籠鑰匙救出女獵手伊爾莉歐娜。',
  }
},
[25670] = {
  {
    'TUM-tum-TUM-tum-TUM-tum‡Гм-гм‡DA-dap-DA-dap-DA-dap‡빠밤 빠밤 빠밤 빠밤‡DUN-dun-DUN-dun-DUN-dun‡DUN-dun-DUN-dun-DUN-dun‡Ta-DA-Ta-DA-Ta-DA…‡猎鲨进行曲‡嘟─嘟─嘟─嘟─嘟─嘟',
    nil,
    'Use a Corrente do Bino no Lança-arpão Enferrujado, que fica no Arrecife Amaldiçoado. Dispare o Lança-arpão quando o Mordisco estiver posicionado em cima da arma.‡Прикрепите цепь Бадда к ржавому гарпунному ружью на Проклятом рифе. Выстрелите, когда Костеглод окажется в зоне поражения.‡Benutzt Budds Kette bei der rostigen Harpunenkanone im Skelettriff. Feuert die Harpune ab, wenn Nager sich über der Kanone befindet.‡해골 암초에 있는 녹슨 작살총에 버드의 사슬을 사용하십시오. 질겅이가 사정거리 안에 들어오면 작살을 발사해야 합니다.‡Usa la cadena de Budd con el rifle de arpón oxidado en el Arrecife de Huesos. Dispara el arpón cuando Bocados esté en posición sobre el rifle.‡Usa la cadena de Budd con el rifle de arpón oxidado en el Arrecife de Huesos. Dispara el arpón cuando Bocados esté en posición sobre el rifle.‡Utilisez la Chaîne de Budd sur le Lance-harpon rouillé, au Récif Squelettique. Lancez le harpon quand Ronge-la-mort se trouve à l’aplomb du lance-harpon.‡对放置在骸骨珊瑚礁的生锈的猎鱼枪使用巴德的链条。当利颚进入射程后，发射鱼叉。‡到骸骨沙洲，並在生鏽的魚叉獵槍上使用霸德的鎖鏈。當囓咬游至獵槍前，就發射魚叉。',
  }
},
[25671] = {
  {
    'Dizimando a Horda‡Проредить Орду‡Die Horde ausdünnen‡호드 수 줄이기‡Diezmar la Horda‡Diezmar la Horda‡Décimer la Horde‡削弱部落‡削弱部落',
    nil,
    'Mate quaisquer 20 soldados da Horda na Cordilheira das Torres de Pedra.‡Убейте 20 любых ордынских солдат в Когтистых горах.‡Tötet 20 beliebige Soldaten der Horde im Steinkrallengebirge.‡돌발톱 산맥에서 종류에 상관없이 호드 병사 20명을 처치해야 합니다.‡Mata a 20 soldados de la Horda cualesquiera en Sierra Espolón.‡Mata a 20 soldados de la Horda cualesquiera en Sierra Espolón.‡Tuez 20 soldats de la Horde de n’importe quel type dans les Serres-Rocheuses.‡在石爪山脉杀死部落的任意20名士兵。‡到石爪山脈殺死任20個部落的士兵。',
  }
},
[25672] = {
  {
    'Mais preparativos‡Анатомический театр‡Kadaversammlung‡시체 수집‡Colección de huesos‡Colección de huesos‡Tant va l’os à l’eau…‡整理遗骸‡收集屍體',
    nil,
    'Consiga 10 Carcaças de Criaturas.‡Соберите 10 трупов животных.‡Sammelt 10 Kreaturenkadaver.‡생물 시체 10개를 모아야 합니다.‡Recoge 10 cadáveres de criaturas.‡Recoge 10 cadáveres de criaturas.‡Récoltez 10 Carcasses de créature.‡收集10份动物遗骸。‡收集10具生物的屍體。',
  }
},
[25673] = {
  {
    'Pergunte à Alice‡Просто попроси Алису‡Einfach Alice fragen‡앨리스의 부탁‡Alice lo sabe‡Alice lo sabe‡Y\'a qu\'à d\'mander à Alice‡问问爱丽斯‡問愛麗絲',
    nil,
    'Recupere o Aparato de Guerra BD-816, o Fogo Mecanizado, o Gelo Mecanizado e o Ar Mecanizado.‡Найдите машину войны БА-64, Механизированный огонь, Механизированный лед и Механизированный воздух.‡Findet die BD-816 Kriegsmaschine, mechanisiertes Feuer, mechanisiertes Eis und mechanisierte Luft.‡BD-816 전쟁 장비, 기계화 불, 기계화 얼음, 기계화 공기를 입수해야 합니다.‡Recupera el aparato de guerra BD-816, el fuego mecanizado, el hielo mecanizado y el aire mecanizado.‡Recupera el aparato de guerra BD-816, el fuego mecanizado, el hielo mecanizado y el aire mecanizado.‡Retrouvez l’Appareil de guerre BD-816, le Feu, la Glace et l’Air mécanisés.‡找到BD-816战斗仪器、机械火焰、机械之冰和机械空气。‡找回BD-816戰鬥控制裝置、火焰機械裝置、冰凍機械裝置以及風力機械裝置。',
  }
},
[25674] = {
  {
    'Orgulho vão‡Безосновательная гордость‡Vergebener Stolz‡쓸데없는 자존심‡Orgullo inútil‡Orgullo inútil‡Vain orgueil‡无用的自尊‡無益的自尊',
    nil,
    'Mate um Emboscador Malhorrendo no Domínio de Malhorrendo.‡Убейте душителя из клана Молота Ужаса в Форте Молота Ужаса.‡Tötet einen Wegelagerer der Schreckensfelsoger in der Feste Schreckensfels.‡우레망치 요새에 있는 우레망치 복병 하나를 처치해야 합니다.‡Mata a un emboscador Machacamiedo en Bastión Machacamiedo.‡Mata a un emboscador Machacamiedo en Bastión Machacamiedo.‡Tuez un Embusqué cognepeur au Bastion Cognepeur.‡杀死巨槌要塞的一个巨槌伏击者。‡在巨槌要塞殺死一名巨槌伏擊者。',
  }
},
[25675] = {
  {
    'Combate com ogro‡Бой с ограми‡Ogergefechte‡오우거 전투‡Combate ogro‡Combate ogro‡La curée des ogres‡食人魔战斗‡鏖戰巨魔',
    nil,
    'Mate 6 Espancadores de Malhorrendo e 5 Bruxos de Malhorrendo.‡Убейте 6 извергов и 5 чернокнижников из клана Молота Ужаса.‡Tötet 6 Raufer der Schreckensfelsoger und 5 Hexenmeister der Schreckensfelsoger.‡우레망치 싸움꾼 6마리와 우레망치 흑마법사 5마리를 처치해야 합니다.‡Asesina a 6 aplastadores Machacamiedo y a 5 brujos Machacamiedo.‡Asesina a 6 aplastadores Machacamiedo y a 5 brujos Machacamiedo.‡Tuez 6 Marteleurs cognepeur et 5 Démonistes cognepeur.‡杀死6名巨槌战士和5名巨槌术士。‡殺死6名巨槌戰士和5名巨槌術士。',
  }
},
[25676] = {
  {
    'Furapeito‡Удар по карману‡Mitten ins Herz‡핵심 공격‡Golpe certero‡Golpe certero‡Une frappe au cœur‡心脏打击‡核心攻擊',
    nil,
    'Apresente-se a Rofilian Dane nas Minas de Etergarde, que ficam na Barreira do Inferno.‡Поговорите с Рофилием Дейном на Рудниках Гарнизона в Выжженных землях.‡Meldet Euch bei Rofilian Dane in der Mine von Nethergarde in den Verwüsteten Landen.‡저주받은 땅의 네더가드 광산에 있는 로필리언 데인에게 보고해야 합니다.‡Preséntate ante Rofilian Dane en las Minas de Nethergarde en Las Tierras Devastadas.‡Preséntate ante Rofilian Dane en las Minas de Nethergarde en Las Tierras Devastadas.‡Présentez-vous à Rofilian Dane dans les Mines de Rempart-du-Néant, dans les Terres Foudroyées.‡去找诅咒之地守望堡矿井的罗菲利安·达恩。‡到詛咒之地裡的守望礦坑向羅菲里安•丹恩回報。',
  }
},
[25677] = {
  {
    'A mina é minha‡Не нашим – не вашим!‡Alles meins!‡너는 내 광산‡Mío o de nadie‡Mío o de nadie‡Ne pas confondre gisement épuisé et mine de rien.‡都是我的‡全是我的礦',
    nil,
    'Use o Solvente Concentrado em 6 Destroços de Minério nas Minas de Etergarde.‡Полейте концентрированным растворителем 6 груд руды на Рудниках Гарнизона.‡Benutzt das konzentrierte Lösemittel auf 6 Erzhaufen in der Mine von Nethergarde.‡네더가드 광산에서 광석 더미 6개에 응축된 용해제를 사용해야 합니다.‡Usa el disolvente concentrado en 6 montones de mena en las Minas de Nethergarde.‡Usa el disolvente concentrado en 6 montones de mena en las Minas de Nethergarde.‡Utilisez le Solvant concentré sur 6 Tas de minerai dans les Mines de Rempart-du-Néant.‡在守望堡矿井的6处矿石堆上使用超浓溶剂。‡在守望礦坑裡將濃縮溶劑使用在6個礦石堆上。',
  }
},
[25678] = {
  {
    'Escolha o seu destino‡Выбери свою судьбу‡Wählt Euer Schicksal‡운명 선택‡Excavando en el destino‡Excavando en el destino‡Il y a du tirage dans le destin‡选择你的命运‡決定你的命運',
    nil,
    'Mate 8 Mineradores de Etergarde, 3 Engenheiros de Etergarde e 3 Encarregados de Etergarde.‡Убейте 8 рудокопов, 8 инженеров и 3 штейгеров из Крепости Стражей Пустоты.‡Tötet 8 Minenarbeiter von Nethergarde, 3 Ingenieure von Nethergarde und 3 Großknechte von Nethergarde.‡네더가드 광부 8명, 네더가드 기술자 3명, 네더가드 현장감독 3명을 처치해야 합니다.‡Asesina a 8 mineros de Nethergarde, a 3 ingenieros de Nethergarde y a 3 supervisores de Nethergarde.‡Asesina a 8 mineros de Nethergarde, a 3 ingenieros de Nethergarde y a 3 supervisores de Nethergarde.‡Tuez 8 Mineurs de Rempart-du-Néant, 3 Ingénieurs de Rempart-du-Néant et 3 Contremaîtres de Rempart-du-Néant.‡杀掉8名守望堡矿工3名守望堡技师和3名守望堡工头。‡殺死8名守望堡礦工、3名守望堡工程師和3名守望堡工頭。',
  }
},
[25679] = {
  {
    'Montanha adentro‡В гору!‡In den Berg hinein‡광산 속으로‡Dentro de la montaña‡Dentro de la montaña‡Sous la montagne‡进入山脉‡深入山中',
    nil,
    'Apresente-se a Tak\'arili mais ao fundo das Minas de Etergarde, que ficam na Barreira do Inferno.‡Поговорите с Так\'арили в глубине Рудников Гарнизона в Выжженных землях.‡Meldet Euch bei Tak\'arili tiefer in der Mine von Nethergarde in den Verwüsteten Landen.‡저주받은 땅의 네더가드 광산 안 깊숙한 곳에 있는 타크아릴리에게 보고해야 합니다.‡Preséntate ante Tak\'arili en las profundidades de las Minas de Nethergarde en Las Tierras Devastadas.‡Preséntate ante Tak\'arili en las profundidades de las Minas de Nethergarde en Las Tierras Devastadas.‡Présentez-vous à Tak\'arili plus loin dans les profondeurs des Mines de Rempart-du-Néant, dans les Terres Foudroyées.‡去找诅咒之地守望堡矿井更深处的塔卡利里。‡到詛咒之地裡的守望礦坑深處向塔克亞瑞利回報。',
  }
},
[25680] = {
  {
    'Não fomos nós‡Это не мы!‡So sind wir nicht‡우리는 아니야‡No somos nosotros‡No somos nosotros‡Il y a démon sous roche‡那不是我们‡不是我們搞的',
    nil,
    'Encontre e mate o que quer que esteja assustando os mineradores nas Minas de Etergarde.‡Найдите и убейте то, что напугало рабочих на Рудниках Гарнизона.‡Findet und tötet das, was die Minenarbeiter in der Mine von Nethergarde so erschreckt hat.‡네더가드 광산 안에 있는 광부를 겁에 질리게 한 존재를 찾아내 처치해야 합니다.‡Encuentra y asesina a lo que sea que está asustando a los mineros en las Minas de Nethergarde.‡Encuentra y asesina a lo que sea que está asustando a los mineros en las Minas de Nethergarde.‡Trouvez et tuez ce qui effraye les mineurs dans les Mines de Rempart-du-Néant.‡查清楚是什么让守望堡矿井里的矿工如此害怕，把它杀掉。‡找出並殺死任何在守望礦坑裡驚嚇礦工的東西。',
  }
},
[25681] = {
  {
    'Tem gente que precisa morrer‡Кое-кого просто нельзя не убить‡Einige Leute muss man einfach töten‡그러니까 없어져야겠어‡A algunas personas sencillamente hay que matarlas‡A algunas personas sencillamente hay que matarlas‡Prospectives funestes pour un prospecteur‡有些人就是得杀‡有些人就是該殺',
    nil,
    'Mate o Prospector-chefe Hondo. Use a Caixa Inconspícua para se disfarçar ao longo do caminho.‡Убейте главного геолога Хондо. Чтобы пробраться к нему, используйте неприметную коробку.‡Tötet Chefausgrabungsleiter Hondo. Benutzt die unverdächtige Kiste, um Euch unterwegs zu tarnen.‡수석 발굴조사단장 혼도를 처치해야 합니다. 눈에 띄지 않는 상자를 사용하여 가는 동안 위장하십시오.‡Asesina al prospector jefe Hondo. Usa la caja inadvertida para disfrazarte en el camino.‡Asesina al prospector jefe Hondo. Usa la caja inadvertida para disfrazarte en el camino.‡Tuez le Chef prospecteur Hondo. Utilisez la Boîte anodine pour vous déguiser le long du chemin.‡杀死首席勘察员宏多。一路用不起眼的盒子伪装自己。‡殺死首席勘察員漢兜。使用不起眼的箱子好在前去的路上偽裝你自己。',
  }
},
[25682] = {
  {
    'Missão Cumprida‡Задание выполнено‡Mission abgeschlossen‡임무 완성‡Misión completada‡Misión completada‡Mission accomplie‡任务完成‡任務完成',
    nil,
    'Entregue o Relatório da Mina de Etergarde para Okrilla no Domínio de Malhorrendo, que fica na Barreira do Inferno.‡Отнесите отчет из Рудников Гарнизона Окрилле в Форт Молота Ужаса, что в Выжженных землях.‡Liefert den Minenbericht von Nethergarde bei Okrilla in der Feste Schreckensfels in den Verwüsteten Landen ab.‡네더가드 광산 보고서를 저주받은 땅의 우레망치 요새에 있는 오크릴라에게 전달해야 합니다.‡Entrega el informe de Minas de Nethergarde a Okrilla en Bastión Machacamiedo en Las Tierras Devastadas.‡Entrega el informe de Minas de Nethergarde a Okrilla en Bastión Machacamiedo en Las Tierras Devastadas.‡Apportez le Rapport sur les mines de Rempart-du-Néant, à Okrila au Bastion Cognepeur dans les Terres Foudroyées.‡把守望堡矿井报告交给诅咒之地巨槌要塞的奥莉里拉 。‡將守望礦坑報告帶去詛咒之地的巨槌要塞給歐克里拉。',
  }
},
[25683] = {
  {
    'A fornalha Malhorrendo‡Горн Молота Ужаса‡Die Schreckensfelssenke‡우레망치 용광로‡El Horno Machacamiedo‡El Horno Machacamiedo‡La fournaise Cognepeur‡巨槌熔炉‡巨槌熔爐',
    nil,
    'Apresente-se à Maga Sangrenta Lynnore na parte de trás da Fornalha Malhorrendo, que fica na Barreira do Inferno.‡Поговорите с волшебницей крови Линорой в Горне Молота Ужаса в Выжженных землях.‡Meldet Euch bei Blutmagierin Lynnore hinten in der Schreckensfelssenke in den Verwüsteten Landen.‡저주받은 땅의 우레망치 용광로 뒤편에 있는 혈법사 린노어에게 보고해야 합니다.‡Preséntate ante la maga sangrienta Lynnore en la parte trasera del Horno Machacamiedo en Las Tierras Devastadas.‡Preséntate ante la maga sangrienta Lynnore en la parte trasera del Horno Machacamiedo en Las Tierras Devastadas.‡Présentez-vous au Mage de sang Lynnore au fond de la Fournaise Cognepeur, dans les Terres Foudroyées.‡向诅咒之地巨槌熔炉深处的血法师莱诺雷报到。‡到詛咒之地裡的巨槌熔爐向血法師萊諾雷回報。',
  }
},
[25684] = {
  {
    'Em harmonia com a pedra-sangrenta‡Настроиться на кровавый камень‡Stimmt den Blutstein ab‡혈석 조정‡Armonización de la sangrita‡Armonización de la sangrita‡Harmonisation d’une pierre de sang‡血石同调‡與血石同調',
    nil,
    'Harmonize-se com as Pedras-sangrentas Teleportadoras na Fornalha Malhorrendo.‡Научитесь использовать телепортирующие кровавые камни в Горне Молота Ужаса.‡Verbindet Euch mit den Blutsteinteleportern in der Schreckensfelssenke.‡우레망치 용광로에 있는 혈석 순간이동기에 맞춰 자신을 조율해야 합니다.‡Ponte en armonía con los teletransportadores de sangrita en el Horno Machacamiedo.‡Ponte en armonía con los teletransportadores de sangrita en el Horno Machacamiedo.‡Harmonisez-vous avec les Téléporteurs de la pierre de sang, dans la Fournaise Cognepeur.‡与巨槌熔炉的血石传送器进行同调。‡讓自己和巨槌熔爐中的血石傳送器同調。',
  }
},
[25685] = {
  {
    'A primeira etapa‡Первый шаг‡Der erste Schritt‡첫 단계‡El primer paso‡El primer paso‡La chasse sanglante‡第一步‡第一步',
    nil,
    'Obtenha 9 frascos de Sangue de Hiena Rasgarrindo e 9 frascos de Sangue de Basilisco Itarrubra.‡Добудьте 9 флаконов крови хохочущей гиены и 9 флаконов крови краснокаменного василиска.‡Besorgt 9 Phiolen mit Blut einer Kicherfanghyäne und 9 Phiolen mit Blut eines Rotsteinbasilisken.‡칼송곳니하이에나 피 9병과 붉은바위 바실리스크 피 9병을 획득해야 합니다.‡Consigue 9 viales de sangre de hiena risitas y 9 viales de sangre de basilisco Rocarroja.‡Consigue 9 viales de sangre de hiena risitas y 9 viales de sangre de basilisco Rocarroja.‡Recueillez 9 fioles de Sang de hyène raillecroc et 9 fioles de Sang de basilic rougepierre.‡收集9瓶弯牙土狼的血液和9瓶红石蜥蜴的血。‡取得9瓶彎牙土狼的血和9瓶紅石蜥蜴的血。',
  }
},
[25686] = {
  {
    'Ritual de sangue‡Ритуал крови‡Blutritual‡피의 의식‡Ritual de sangre‡Ritual de sangre‡Le rituel de sang‡鲜血仪祭‡血之祭儀',
    nil,
    'Fale com a Maga Sangrenta Lynnore para começar o ritual de sangue.‡Поговорите с волшебницей крови Линорой, чтобы она начала ритуал.‡Sprecht mit Blutmagierin Lynnore, um das Blutritual zu beginnen.‡혈법사 린노어와 대화하고 피의 의식을 시작해야 합니다.‡Habla con la maga sangrienta Lynnore para comenzar el ritual de sangre.‡Habla con la maga sangrienta Lynnore para comenzar el ritual de sangre.‡Parlez au Mage de sang Lynnore pour commencer le rituel de sang.‡与血法师莱诺雷交谈，开始鲜血仪祭。‡和血法師萊諾雷談話來開始血之祭儀。',
  }
},
[25687] = {
  {
    'Não apenas um corpo‡По кусочкам‡Nicht irgendeine Leiche‡아무거나 구해서는 안 된다‡No es cualquier cuerpo‡No es cualquier cuerpo‡Morceaux de bravoure‡特别的尸体‡不是誰的屍體都行',
    nil,
    'Encontre a Cabeça de Loramus, o Torso de Loramus e as Pernas de Loramus.‡Найдите голову, туловище и ноги Лорама.‡Findet Loramus\' Kopf, Loramus\' Torso und Loramus\' Beine.‡로라무스의 가면, 로라무스의 옷, 로라무스의 바지를 찾아와야 합니다.‡Encuentra la cabeza de Loramus, el torso de Loramus y las piernas de Loramus.‡Encuentra la cabeza de Loramus, el torso de Loramus y las piernas de Loramus.‡Trouvez la Tête de Loramus, le Torse de Loramus et les Jambes de Loramus.‡找到洛拉姆斯的头颅、洛拉姆斯的躯干和洛拉姆斯的腿。‡找到洛拉姆斯的頭、洛拉姆斯的軀幹和洛拉姆斯的雙腿。',
  }
},
[25688] = {
  {
    'O altar das tempestades‡Алтарь Бурь‡Der Altar der Stürme‡폭풍의 제단‡El Altar de la Tempestad‡El Altar de la Tempestad‡L’autel des Tempêtes‡风暴祭坛‡暴風祭壇',
    nil,
    'Leve o Cadáver de Loramus ao Altar das Tempestades e proteja-o enquanto o ritual é realizado.‡Отнесите тело Лорама на Алтарь Бурь и защищайте тело, пока не завершится ритуал.‡Bringt Loramus\' Leichnam zum Altar der Stürme, dann beschützt ihn während des Rituals.‡로라무스의 시신을 폭풍의 제단으로 가져간 다음, 의식이 끝날 때까지 보호해야 합니다.‡Lleva el cuerpo de Loramus al Altar de la Tempestad y después protégelo hasta que se complete el ritual.‡Lleva el cuerpo de Loramus al Altar de la Tempestad y después protégelo hasta que se complete el ritual.‡Portez le corps de Loramus à l’Autel des Tempêtes et là, protégez-le pendant la durée du rituel.‡将洛拉姆斯的躯体带到风暴祭坛去，然后在仪式进行期间保护它。‡將洛拉姆斯的身體帶到暴風祭壇，然後保護它直到祭儀結束。',
  }
},
[25689] = {
  {
    'O tempo é curto‡Времени нет‡Die Zeit ist knapp‡시간이 없다‡Hay poco tiempo‡Hay poco tiempo‡Le temps est compté‡时间紧迫‡時間無多',
    nil,
    'Entregue a Runa Dissonante ao Vigia Wazzik no Portal Negro, que fica na Barreira do Inferno.‡Отнесите диссонирующую руну дозорному Ваззику к Темному порталу в Выжженных землях.‡Bringt die disharmonische Rune zu Behüter Wazzik am Dunklen Portal in den Verwüsteten Landen.‡저주받은 땅의 어둠의 문에 있는 파수병 와직에게 불협의 룬을 전달해야 합니다.‡Entrega la runa discordante al Vigía Wazzik en El Portal Oscuro en Las Tierras Devastadas.‡Entrega la runa discordante al Vigía Wazzik en El Portal Oscuro en Las Tierras Devastadas.‡Apportez la Rune discordante au Gardien Wazzik à la Porte des ténèbres, dans les Terres Foudroyées.‡将不谐符文交给诅咒之地黑暗之门的观察者瓦兹克。‡將絮亂符文送去詛咒之地裡的黑暗之門給看守者瓦茲克。',
  }
},
[25690] = {
  {
    'Um mago sangrento também precisa comer‡Волшебнику крови тоже хочется кушать‡Auch Blutmagier müssen essen‡혈법사도 먹어야 산다‡Los magos sangrientos también comen‡Los magos sangrientos también comen‡Même les mages de sang ont de petites faims‡血法师也要吃饭啊‡血法師也得吃飯',
    nil,
    'Obtenha 5 Bifes de Jubacinza de Javalis Jubacinza na Barreira do Inferno.‡Отправляйтесь в Выжженные земли и раздобудьте 5 кусков мяса пеплогривых кабанов.‡Besorgt 5 Aschmähnensteaks von Aschmähnenebern in den Verwüsteten Landen.‡저주받은 땅의 잿빛갈기멧돼지에서 잿빛갈기멧돼지 스테이크 5개를 획득해야 합니다.‡Consigue 5 filetes de Cenicrín de jabalíes Cenicrín en Las Tierras Devastadas.‡Consigue 5 filetes de Cenicrín de jabalíes Cenicrín en Las Tierras Devastadas.‡Prenez 5 Steaks de cendre-crin sur des Sangliers cendre-crins, dans les Terres Foudroyées.‡从诅咒之地的灰鬃野猪身上收集5块灰鬃肉排。‡從詛咒之地的灰鬃野豬那裡取得5份灰鬃肉排。',
  }
},
[25691] = {
  {
    'O granito carbonizado do Portal Negro‡Обугленный гранит у Темного портала‡Der verkohlte Granit des Dunklen Portals‡어둠의 문 주변의 까맣게 탄 화강암‡El granito carbonizado de El Portal Oscuro‡El granito carbonizado de El Portal Oscuro‡Le granite carbonisé de la Porte des ténèbres‡黑暗之门的焦黑花岗岩‡黑暗之門的燒焦花崗岩石片',
    nil,
    'Obtenha 24 Lascas de Granito Carbonizado.‡Соберите 24 обугленные гранитные крошки.‡Besorgt 24 verkohlte Granitsplitter.‡까맣게 탄 화강암 조각 24개를 획득해야 합니다.‡Consigue 24 astillas de granito carbonizado.‡Consigue 24 astillas de granito carbonizado.‡Trouvez 24 Fragments de granite carbonisés.‡收集24块焦黑的花岗岩片。‡取得24個燒焦的花崗岩石片。',
  }
},
[25692] = {
  {
    'O sangue vil dos demônios‡Поганая кровь демонов‡Das abscheuliche Blut der Dämonen‡악마의 사악한 피‡La sangre vil de los demonios‡La sangre vil de los demonios‡Le sang infâme des démons‡邪能魔化之血‡惡魔的髒血',
    nil,
    'Obtenha 7 garrafas de Sangue Demoníaco Torpe.‡Добудьте 7 бутылок жуткой крови демонов.‡Besorgt 7 Flaschen mit abscheulichem Dämonenblut.‡사악한 악마의 피 7병을 획득해야 합니다.‡Consigue 7 botellas de sangre demoníaca vil.‡Consigue 7 botellas de sangre demoníaca vil.‡Obtenez 7 bouteilles de Sang démoniaque infâme.‡收集7瓶邪能魔化之血。‡取得7瓶邪惡的惡魔之血。',
  }
},
[25693] = {
  {
    'Potencializando a pedra‡Дальнейшая подготовка‡Verbesserung des Steins‡돌 강화‡Realzar la piedra‡Realzar la piedra‡La pierre contre-attaque‡强化石头‡石之附魔',
    nil,
    'Leve o Pacote de Wazzik para Loramus Talípedes na Fornalha Malhorrendo, que fica na Barreira do Inferno.‡Отнесите посылку Ваззика Лораму Многоногу в Горн Молота Ужаса в Выжженных землях.‡Bringt Wazziks Paket zu Loramus Thalipedes in der Schreckensfelssenke in den Verwüsteten Landen.‡저주받은 땅의 우레망치 용광로에 있는 로라무스 탈리페데스에게 와직의 꾸러미를 전달해야 합니다.‡Lleva el paquete de Wazzik a Loramus Thalimedes en el Horno Machacamiedo en Las Tierras Devastadas.‡Lleva el paquete de Wazzik a Loramus Thalimedes en el Horno Machacamiedo en Las Tierras Devastadas.‡Apportez le Paquet de Wazzik à Loramus Thalipedes à la Fournaise cognepeur, dans les Terres Foudroyées.‡将瓦兹克的包裹交给诅咒之地巨槌熔炉的洛拉姆斯·萨里比迪斯。‡將瓦茲克的包裹送去詛咒之地的巨槌熔爐給洛拉姆斯·薩里比迪斯。',
  }
},
[25694] = {
  {
    'Protegendo a retaguarda‡Защита тылов‡Rückendeckung‡후방 방어‡Proteger la retaguardia‡Proteger la retaguardia‡Arrière-garde‡保护后方‡保衛後方',
    nil,
    'Mate Jarroc Asa-dilacerada, Shahandana e Gomegaz.‡Убейте Джаррока Рваное Крыло, Шахандану и Гумгаза.‡Tötet Jarroc Flügelriss, Shahandana und Gomegaz.‡찢긴 날개 자록, 샤한다나, 고메가즈를 처치해야 합니다.‡Mata a Jarroc Alarrota, a Shahandana y a Gomegaz.‡Mata a Jarroc Alarrota, a Shahandana y a Gomegaz.‡Tuez Jarroc Aile-déchirée, Shahandana et Gomegaz.‡杀死伽罗克·裂翼、莎罕达娜和格姆加兹。‡殺死詹洛克·裂翼、夏寒達納和戈姆加茲。',
  }
},
[25695] = {
  {
    'O seguro morreu de velho‡Осторожность не помешает‡Nachhut‡후방 감시‡Cubrirse las espaldas‡Cubrirse las espaldas‡Au service – secret – de la Horde‡留个心眼‡注意後方',
    nil,
    'Examine os Planos da Aliança no Portal Negro sem ser pego.‡Изучите планы Альянса у Темного портала и постарайтесь, чтобы вас не поймали за этим занятием.‡Untersucht die Pläne der Allianz am Dunklen Portal, ohne erwischt zu werden.‡어둠의 문에 있는 얼라이언스 계획서를 들키지 않고 살펴봐야 합니다.‡Examina los planes de la Alianza en El Portal Oscuro sin que te cacen.‡Examina los planes de la Alianza en El Portal Oscuro sin que te cacen.‡Étudiez les Plans de l’Alliance sans vous faire prendre, à la Porte des ténèbres dans les Terres Foudroyées.‡在不被发现的情况下，查阅黑暗之门的联盟计划书。‡在不被人抓到的情況下檢驗黑暗之門那裡的聯盟計畫。',
  }
},
[25696] = {
  {
    'O acampamento Clarovéu‡Экспедиция Солнечного Паруса‡Sonnenschleiers Exkursionstrupp‡해가림 탐험지‡La Excursión Velosolar‡La Excursión Velosolar‡L’expédition de Solevoile‡日纱考察营地‡蔽日旅團',
    nil,
    'Apresente-se a Rohan Clarovéu no Acampamento Clarovéu, que fica na Barreira do Inferno.‡Поговорите с Роханом Солнечным Парусом в экспедиции Солнечного Паруса в Выжженных землях.‡Meldet Euch bei Rohan Sonnenschleier bei Sonnenschleiers Exkursionstrupp in den Verwüsteten Landen.‡저주받은 땅의 해가림 탐험지에 있는 로한 선베일에게 보고해야 합니다.‡Preséntate ante Rohan Velosolar en la Excursión Velosolar en Las Tierras Devastadas.‡Preséntate ante Rohan Velosolar en la Excursión Velosolar en Las Tierras Devastadas.‡Présentez-vous à Rohan Solevoile à l’Expédition de Solevoile, dans les Terres Foudroyées.‡去找诅咒之地日纱考察营地的洛翰·日纱。‡到詛咒之地的蔽日旅團向洛漢·蔽日回報。',
  }
},
[25697] = {
  {
    'O amuleto de Allistarj‡Амулет Аллистария‡Das Amulett von Allistarj‡알리스타즈의 아뮬렛‡El amuleto de Allistarj‡El amuleto de Allistarj‡L’amulette d\'Allistarj‡奥利斯塔的护符‡奧利斯塔的護符',
    nil,
    'Obtenha o Amuleto de Allistarj das Cavernas Serpeantes, que ficam na Barreira do Inferno.‡Найдите амулет Аллистария в Змеиных Кольцах в Выжженных землях.‡Besorgt das Amulett von Allistarj aus der Schlangenschlinge in den Verwüsteten Landen.‡저주받은 땅의 뱀의 보금자리에서 알리스타즈의 아뮬렛을 획득해야 합니다.‡Consigue el amuleto de Allistarj en la Serpiente Enroscada en Las Tierras Devastadas.‡Consigue el amuleto de Allistarj en la Serpiente Enroscada en Las Tierras Devastadas.‡Retrouvez l’Amulette d’Allistarj dans les Anneaux du serpent, dans les Terres Foudroyées.‡在诅咒之地的盘蛇谷获得奥利斯塔的护符。‡在詛咒之地的盤蛇谷取得奧利斯塔的護符。',
  }
},
[25698] = {
  {
    'O amuleto de Sevine‡Амулет Севины‡Das Amulett von Sevine‡세바인의 아뮬렛‡El amuleto de Sevine‡El amuleto de Sevine‡L’amulette de Sevine‡瑟温妮的护符‡瑟溫妮的護符',
    nil,
    'Obtenha o Amuleto de Sevine de Fiasco-sal perto da Costa Partida, que fica na Barreira do Inferno.‡Отнимите амулет Севины у Солюна, который живет близ Берега Обломков в Выжженных землях.‡Besorgt das Amulett von Sevine von Salzflopper in den Verwüsteten Landen.‡저주받은 땅의 산산조각 바닷가 근처에 있는 짠발이에게서 세바인의 아뮬렛을 획득해야 합니다.‡Consigue el amuleto de Sevine de Voltesal cerca de Costa Quebrada en Las Tierras Devastadas.‡Consigue el amuleto de Sevine de Voltesal cerca de Costa Quebrada en Las Tierras Devastadas.‡Obtenez l’Amulette de Sevine des mains de Rate’Sel, près du Rivage Ravagé dans les Terres Foudroyées.‡从诅咒之地破碎海滩附近的盐腮手中夺取瑟温妮的护符。‡在詛咒之地的破碎海岸附近取得瑟溫妮的護符。',
  }
},
[25699] = {
  {
    'O amuleto de Grol‡Амулет Грола‡Das Amulett von Grol‡그롤의 아뮬렛‡El amuleto de Grol‡El amuleto de Grol‡L’amulette de Grol‡戈洛尔的护符‡戈洛爾的護符',
    nil,
    'Obtenha o Amuleto de Grol na Costa Partida, que fica na Barreira do Inferno.‡Найдите амулет Грола на Берегу Обломков в Выжженных землях.‡Besorgt das Amulett von Grol von der Havarieküste in den Verwüsteten Landen.‡저주받은 땅의 산산조각 바닷가에서 그롤의 아뮬렛을 획득해야 합니다.‡Consigue el amuleto de Grol en Costa Quebrada, en Las Tierras Devastadas.‡Consigue el amuleto de Grol en Costa Quebrada, en Las Tierras Devastadas.‡Trouvez l’amulette de Grol sur le Rivage Ravagé, dans les Terres Foudroyées.‡在诅咒之地的破碎海滩获得戈洛尔的护符。‡在詛咒之地的破碎海岸取得戈洛爾的護符。',
  }
},
[25700] = {
  {
    'Loramus Talípedes aguarda‡Лорам Многоног ждет‡Loramus Thalipedes wartet‡로라무스 탈리페데스가 기다린다‡Loramus Thalimedes espera‡Loramus Thalimedes espera‡L’attente de Loramus Thalipedes‡洛拉姆斯在等待‡洛拉姆斯‧薩里比迪斯等待著',
    nil,
    'Fale com a Maga Sangrenta Lynnore e participe do ritual dela.‡Поговорите с волшебницей крови Линорой, когда будете готовы принять участие в ее ритуале.‡Sprecht mit Blutmagierin Lynnore, um an ihrem Ritual teilzunehmen.‡혈법사 린노어와 대화하고 의식을 준비해야 합니다.‡Habla con la maga sangrienta Lynnore y participa en su ritual.‡Habla con la maga sangrienta Lynnore y participa en su ritual.‡Parlez à la Mage de sang Lynnore et participez à son rituel.‡与血法师莱诺雷交谈，参与他的仪式。‡和血法師萊諾雷說話並加入他的祭儀。',
  }
},
[25701] = {
  {
    'Você é Rakh\'likh, demônio‡Демон, имя тебе Рах\'лих‡Ihr seid Rakh\'likh, Dämon‡악마, 네 이름은 라크리크‡Eres Rakh\'likh, demonio‡Eres Rakh\'likh, demonio‡Son nom est Rakh’likh‡恶魔拉瑟莱克‡惡魔，汝真名為拉瑟萊克',
    nil,
    'Fale com o Psicopompus ao norte do Cerro do Profanador. Uma vez no topo do Cerro, destrua o corpo de Razelikh e então use a Faca Pétrea do Aprisionamento para encarcerar a alma do demônio.‡Поговорите с привратником смерти к северу от Утеса Осквернителя. Когда вы окажетесь на утесе, уничтожьте тело Разелиха, а потом захватите его душу при помощи каменного ножа опечатывания.‡Sprecht mit dem tödlichen Pförtner nördlich der Anhöhe des Entweihers. Wenn Ihr oben auf der Anhöhe angelangt seid, zerstört Razelikhs Körper und benutzt dann das Steinmesser des Versiegelns, um seine Seele gefangen zu nehmen.‡파멸자의 봉우리 북쪽에 있는 죽음의 안내인과 대화하십시오. 봉우리 꼭대기에서 라젤리크를 처치하고 봉인의 돌칼로 그의 영혼을 가둬야 합니다.‡Habla con el Ujier sepulcral al norte de Alto de los Rapiñadores. Una vez en lo alto, destruye el cuerpo de Razelikh y usa el cuchillo de piedra de estampa para atrapar su alma.‡Habla con el Ujier sepulcral al norte de Alto de los Rapiñadores. Una vez en lo alto, destruye el cuerpo de Razelikh y usa el cuchillo de piedra de estampa para atrapar su alma.‡Parlez à la Mort silencieuse au nord du pic du Souilleur. Une fois au sommet, détruisez le corps de Razelikh puis utilisez le Couteau d’enfermement en pierre pour emprisonner son âme.‡与污染者高地北面的乌舍尔交谈。抵达高地顶端之后，摧毁拉瑟莱克的躯体，然后用封印石匕禁锢他的灵魂。‡在污染者高地的北方和烏舍爾說話。登上高地之後，摧毀拉瑟萊克的肉身，然後用封印之石製小刀來禁錮他的靈魂。',
  }
},
[25702] = {
  {
    'Lar... Destruído... Nagas...‡Наги пришли… деревню сожгли…‡Zuhause... Weg... Naga...‡집... 사라졌어... 나가...‡Hogar... perdido... naga...‡Hogar... perdido... naga...‡Maison... cassée... Naga‡家…没了…纳迦…‡我們的家園...消失了...納迦...',
    nil,
    'Fiasco-sal pediu para você falar com o Chefe Neptul, líder dos murlocs Poçapétrea.‡По поручению Солюна поговорите с Нептусем, вождем мурлоков из стаи Каменистого Озера.‡Salzflopper hat Euch gebeten, mit Neptool, Häuptling der Steinteichmurlocs, zu sprechen.‡짠발이가 바위웅덩이 멀록 사이에 있는 족장 넵툴과 대화하라고 했습니다.‡Voltesal te ha pedido que hables con el jefe Neptul de los múrlocs Pozarroca.‡Voltesal te ha pedido que hables con el jefe Neptul de los múrlocs Pozarroca.‡Rate’Sel vous a demandé de parler à Neptulouche, le chef des murlocs rochecaves.‡盐腮要你去跟石坑鱼人的酋长耐普托谈谈。‡鹽砰要求你去跟石塘魚人中的奈普吐爾酋長交談。',
  }
},
[25703] = {
  {
    'Atrocidades‡Их надо остановить‡Gräueltaten‡잔혹한 일‡Atrocidades‡Atrocidades‡Atrocités‡暴行‡兇殘暴行',
    nil,
    'Mate 10 Bárbaros da Maré Sangrenta e 10 Encantadoras da Maré Sangrenta.‡Убейте 10 варваров и 10 чародеек из клана Кровавого Прибоя.‡Tötet 10 Barbaren der Blutbrandung und 10 Verzauberinnen der Blutbrandung.‡핏빛여울 야만전사 10마리와 핏빛여울 요술사 10마리를 처치해야 합니다.‡Mata a 10 bárbaros de La Playa de Sangre y a 10 encantadoras de La Playa de Sangre.‡Mata a 10 bárbaros de La Playa de Sangre y a 10 encantadoras de La Playa de Sangre.‡Tuez 10 Barbares du Reflux sanglant et 10 Enchanteresses du Reflux sanglant.‡杀死10个血浪蛮兵和10个血浪女巫。‡殺死10名血浴野蠻人和10名血浴女巫師。',
  }
},
[25704] = {
  {
    'O mago louco‡Безумный волхв‡Der verrückte Magus‡미치광이 학자‡Mago loco Tirth‡Mago loco Tirth‡Le magus fou‡疯狂法师‡瘋子魔導師',
    nil,
    'Extraia a alma do Mago Louco Tirth.‡Извлеките душу из тела безумного волхва Тирта.‡Extrahiert die Seele von Tirth, dem verrückten Magus.‡미치광이 학자 틸스의 영혼을 추출해야 합니다.‡Extrae el alma del mago loco Tirth.‡Extrae el alma del mago loco Tirth.‡Arrachez son âme au Magus fou Tirth.‡抽取疯狂法师提尔希的魔精。‡提取『瘋子』魔導師提爾斯的靈魂。',
  }
},
[25705] = {
  {
    'Falsos ídolos‡Ложные идолы‡Falsche Götzen‡그릇된 우상‡Falsos ídolos‡Falsos ídolos‡Les fausses idoles‡虚假的偶像‡錯誤的偶像',
    nil,
    'Destrua 8 Ídolos Azsh\'ir no Recôndito Vermelho.‡Разбейте 8 идолов Азш\'ира на Красных берегах.‡Zerstört 8 Götzen der Azsh\'ir auf den Roten Weiten.‡붉은 굽이에서 아즈쉬르 우상 8개를 파괴해야 합니다.‡Destruye 8 ídolos de Azsh\'ir en Las Costas Rojas.‡Destruye 8 ídolos de Azsh\'ir en Las Costas Rojas.‡Détruisez 8 Idoles azsh’ir dans les Confins Rouges.‡摧毁赤色海岸的8尊艾萨尔神像。‡在紅色海岸上摧毀8個艾薩伊爾雕像。',
  }
},
[25706] = {
  {
    'A vingança de Neptul‡Месть Нептуся‡Neptools Rache‡넵툴의 복수‡La venganza de Neptul‡La venganza de Neptul‡La vengeance de Neptulouche‡耐普托的复仇‡奈普吐爾的復仇',
    nil,
    'Mate 8 Acólitos da Maré Sangrenta, 8 Zelotes da Maré Sangrenta, 4 Jogadores da Maré Sangrenta e 4 Idólatras da Maré Sangrenta.‡Убейте 8 послушников, 8 ревнителей, 4 прохвостов и 4 идолопоклонников из клана Кровавого Прибоя.‡Tötet 8 Akolythen der Blutbrandung, 8 Zeloten der Blutbrandung, 4 Glücksspieler der Blutbrandung und 4 Götzendiener der Blutbrandung.‡핏빛여울 수행사제 8마리, 핏빛여울 광신도 8마리, 핏빛여울 승부사 4마리, 핏빛여울 우상숭배자 4마리를 처치해야 합니다.‡Asesina a 8 acólitos de La Playa de Sangre, a 8 zelotes de La Playa de Sangre, a 4 jugadores de La Playa de Sangre y a 4 idólatras de La Playa de Sangre.‡Asesina a 8 acólitos de La Playa de Sangre, a 8 zelotes de La Playa de Sangre, a 4 jugadores de La Playa de Sangre y a 4 idólatras de La Playa de Sangre.‡Tuez 8 Acolytes du Reflux sanglant, 8 Zélotes du Reflux sanglant, 4 Joueurs du Reflux sanglant et 4 Idolâtres du Reflux sanglant.‡杀死8名血浪追随者、8名血浪狂热者、4名血浪赌徒，以及4名血浪崇拜者。‡殺死8個血浴侍僧、8個血浴狂熱者、4個血浴賭徒和4個血浴崇拜者。',
  }
},
[25707] = {
  {
    'O futuro dos Poçapétrea‡Будущее Каменистого Озера‡Die Zukunft des Steinteichs‡바위웅덩이의 미래‡El futuro de los Pozarroca‡El futuro de los Pozarroca‡Un avenir pour les Rochecaves.‡岩池的未来‡石塘的未來',
    nil,
    'Arraste o Caixote Abandonado da Maré Sangrenta para o Mar Proibido, além da costa do Recôndito Vermelho.‡Оттащите брошенный груз Кровавого Прибоя к Зловещему морю, подальше от Красных берегов, и выпустите головастиков в воду.‡Zieht die Verlassene Kiste der Blutbrandung zum Verbotenen Meer vor der Küste der Roten Weiten.‡버려진 핏빛여울 상자를 붉은 굽이 해안 너머 성난 바다로 끌고 가야 합니다.‡Arrastra el cajón de La Playa de Sangre abandonado hasta el Mar Adusto en la playa de Las Costas Rojas.‡Arrastra el cajón de La Playa de Sangre abandonado hasta el Mar Adusto en la playa de Las Costas Rojas.‡Emportez la Caisse des Reflux sanglants dans la mer Interdite au large de la côte des Confins Rouges.‡把被遗弃的血浪石箱拖到赤色海岸外的禁忌之海里。‡將被遺棄的血浴木箱拖到遠離紅色海岸之外的禁忌之海中。',
  }
},
[25708] = {
  {
    'Nossos aliados abatidos‡Души погибших товарищей‡Gefallene Freunde‡쓰러진 친구들‡Nuestros amigos caídos‡Nuestros amigos caídos‡Nos défunts amis‡我们逝去的朋友们‡我們陣亡的朋友',
    nil,
    'Mate 13 Guilneanos Afogados na Costa Partida para libertar suas almas.‡Убейте 13 утонувших жителей Гилнеаса на Берегу Обломков, чтобы их души упокоились в мире.‡Tötet 13 ertrunkene Gilneer an der Havarieküste, um ihre Geister zu befreien.‡산산조각 바닷가에서 익사한 길니아스 주민 13명을 처치하고 그들의 영혼을 풀어줘야 합니다.‡Mata a 13 gilneanos ahogados en Costa Quebrada para liberar sus espíritus.‡Mata a 13 gilneanos ahogados en Costa Quebrada para liberar sus espíritus.‡Tuez 13 Gilnéens noyés sur le Rivage Ravagé pour libérer leurs esprits.‡在破碎海滩杀死13个溺死的吉尔尼斯人，释放他们的灵魂。‡在破碎海岸殺死13名溺斃的吉爾尼斯人來解放他們的魂靈。',
  }
},
[25709] = {
  {
    'Chega de abutres‡Отстрел темнохвостых‡Ein paar Schwanzfedern ausreißen‡검은꼬리 싹둑‡Reducir a los Colaoscura‡Reducir a los Colaoscura‡Une raclée aux racleurs‡消减黑尾‡削減黑尾',
    nil,
    'Use as Flechas Explosivas de Elomara para matar 20 Limpa-ossos Caudanegra na Costa Partida.‡Используя взрывные стрелы Енохи, убейте 20 темнохвостых любителей костей на Берегу Обломков.‡Benutzt Enohars explosive Pfeile, um 20 Schwanzfederknochenpflücker an der Havarieküste zu töten.‡에노하르의 폭발 화살로 산산조각 바닷가에 있는 검은꼬리 뼈다귀청소부 20마리를 처치해야 합니다.‡Usa las flechas explosivas de Enohar para matar a 20 escarbadores Colaoscura en Costa Quebrada.‡Usa las flechas explosivas de Enohar para matar a 20 escarbadores Colaoscura en Costa Quebrada.‡Utilisez les Flèches explosives d’Enohar pour tuer 20 Racleurs d’os à queue noire sur le rivage ravagé.‡用恩诺哈尔的爆破箭矢在破碎海岸消灭20个黑尾拾骨者。‡用恩諾哈爾的爆炸箭在破碎海岸殺死20名黑尾拾骨者。',
  }
},
[25710] = {
  {
    'Pequenas distrações‡Мелкие распри‡Unwichtige Ablenkungen‡사소한 골칫거리‡Distracciones menores‡Distracciones menores‡Un petit échauffement‡小事一桩‡小干擾',
    nil,
    'Mate um Batedor Okril\'lon do lado de fora da Bastilha de Etergarde, que fica na Barreira do Inferno.‡Убейте разведчика Окрил\'лона на подступах к Крепости Стражей Пустоты в Выжженных землях.‡Tötet einen Späher der Okril\'lon außerhalb von Burg Nethergarde in den Verwüsteten Landen.‡저주받은 땅의 네더가드 요새 외부에 있는 오크릴론 정찰병 한 명을 처치해야 합니다.‡Mata a un explorador de Okril\'lon en el exterior del Castillo de Nethergarde en Las Tierras Devastadas.‡Mata a un explorador de Okril\'lon en el exterior del Castillo de Nethergarde en Las Tierras Devastadas.‡Tuez un Éclaireur okril\'lon à l’extérieur de Rempart-du-Néant dans les terres foudroyées.‡杀死诅咒之地守望堡外的一名欧卡里隆斥候。‡在詛咒之地的守望堡外面殺死一名歐克里隆斥候。',
  }
},
[25711] = {
  {
    'Elimine os Okril\'lon‡Уничтожить Окрил\'лон‡Schaltet die Okril\'lon aus.‡오크릴론 소탕‡Elimina a los Okril\'lon‡Elimina a los Okril\'lon‡Okril’lonicide‡消灭欧卡里隆‡做掉歐克里隆',
    nil,
    'Mate 9 Soldados de Infantaria Okril\'lon na Base de Suprimentos de Etergarde.‡Убейте 9 пехотинцев Окрил\'лона в лагере поддержки Гарнизона.‡Tötet 9 Infanteristen der Okril\'lon beim Versorgungslager von Nethergarde.‡네더가드 보급 기지에 있는 오크릴론 보병 9명을 처치해야 합니다.‡Mata a 9 unidades de infantería Okril\'lon en el Campamento de Suministros de Nethergarde.‡Mata a 9 unidades de infantería Okril\'lon en el Campamento de Suministros de Nethergarde.‡Tuez 9 Soldat d\'infanterie okril\'lon dans le Camp de ravitaillement de Rempart-du-Néant.‡杀掉守望堡补给营的9名欧卡里隆步兵。‡在守望堡補給營地殺死9個歐克里隆步兵。',
  }
},
[25712] = {
  {
    'Etergarde reina‡Крепость Стражей Пустоты‡Die Herrscher von Nethergarde‡네더가드 통치‡El reinado de Nethergarde‡El reinado de Nethergarde‡Une frappe très ciblée‡守望堡的统治‡守望堡控制權',
    nil,
    'Mate o Capitão Metlek na Base de Suprimentos de Etergarde.‡Убейте капитана Метлека в лагере поддержки Гарнизона.‡Tötet Hauptmann Metlek am Versorgungslager von Nethergarde.‡네더가드 보급 기지에 있는 대장 메틀렉을 처치해야 합니다.‡Asesina al capitán Metlek en el Campamento de Suministros de Nethergarde.‡Asesina al capitán Metlek en el Campamento de Suministros de Nethergarde.‡Tuez le Capitaine Metlek dans le Camp de ravitaillement de Rempart-du-Néant.‡杀掉守望堡补给营的梅特勒克上尉。‡在守望堡補給營地殺死梅特雷克隊長。',
  }
},
[25713] = {
  {
    'Não se atira sem braços‡Кто же не любит хорошего взрыва?‡Macht ihre Waffen zunichte‡무기 탈취‡Elimina sus armas‡Elimina sus armas‡Des gnomeries pétaradantes‡解除他们的武装‡卸除他們的武裝',
    nil,
    'Lance a Granada de Mão de Botãozinho em 8 Caixotes de Armas dos Okril\'lon na Base de Suprimentos de Etergarde.|n|nLembre-se de lançar a granada de longe, ou você será atingido.‡С помощью ручной гранаты Ракитни взорвите 8 ящиков с оружием Окрил\'лона в лагере поддержки Гарнизона.|n|nБросайте гранаты издалека, чтобы не подорваться самому.‡Benutzt Butterblumes Handgranate gegen 8 Waffenkisten der Okril\'lon im Versorgungslager von Nethergarde.|n|nHaltet einen Sicherheitsabstand, wenn Ihr die Granaten verwendet, damit Ihr Euch nicht selbst in die Luft sprengt.‡네더가드 보급 기지에 있는 오크릴론 무기 상자 8개에 버튼윌로의 수류탄을 사용해야 합니다.|n|n당신이 폭발할 수도 있으니 수류탄은 반드시 먼 거리에서 사용하십시오.‡Usa la granada de mano de Saucebotón en 8 cajones de armas Okril\'lon en el Campamento de Suministros de Nethergarde.|n|nAsegúrate de usar las granadas desde lejos, o saldrás volando por los aires.‡Usa la granada de mano de Saucebotón en 8 cajones de armas Okril\'lon en el Campamento de Suministros de Nethergarde.|n|nAsegúrate de usar las granadas desde lejos, o saldrás volando por los aires.‡Utilisez la Grenade de Bois-bouton McKittrick sur 8 Caisses d’armes okril’lonnes au Camp de ravitaillement de Rempart-du-Néant.|n|nAssurez-vous d\'utilisez les grenades de loin, sinon vous vous ferez exploser vous-même.‡对守望堡补给营的8个欧卡里隆的武器箱使用巴顿威洛的手榴弹。|n|n一定要在与目标有一定距离的地方使用手榴弹，否则你也要挨炸。‡將巴登威洛的手榴彈使用在守望堡補給營地裡的8個歐克里隆武器箱上。|n|n使用手榴彈時切記保持安全距離，否則你將會被爆炸波及。',
  }
},
[25714] = {
  {
    'Vigia Mahar Ba‡Дозорный Махар Ба‡Behüter Mahar Ba‡감시자 마할 바‡Vigía Mahar Ba‡Vigía Mahar Ba‡Le Gardien Mahar Ba‡看守者马哈尔巴‡看守者馬哈爾巴',
    nil,
    'Apresente-se ao vigia Mahar Ba na torre dos magos, que fica na Bastilha de Etergarde.‡Отправляйтесь к дозорному Махару Ба в Башню Магов в Крепости Стражей Пустоты.‡Meldet Euch bei Behüter Mahar Ba im Magierturm von Burg Nethergarde.‡네더가드 요새에 있는 마법사 탑에서 감시자 마할 바에게 보고해야 합니다.‡Preséntate ante el vigía Mahar Ba en la Torre de los Magos en el Castillo de Nethergarde.‡Preséntate ante el vigía Mahar Ba en la Torre de los Magos en el Castillo de Nethergarde.‡Présentez-vous au Gardien Mahar Ba à la tour des mages de Rempart-du-Néant.‡去找守望堡法师塔里的看守者马哈尔巴。‡到守望堡的法師之塔向看守者馬哈爾巴回報。',
  }
},
[25715] = {
  {
    'Uma olhada mais de perto‡Обломки кораблекрушения‡Ein genauerer Blick‡자세히 보기‡Una mirada más de cerca‡Una mirada más de cerca‡Une petite vérification‡近距离观察‡深入研究',
    nil,
    'Investigue os navios acidentados na Costa Partida, que fica na Barreira do Inferno.‡Осмотрите обломки кораблекрушения на Берегу Обломков в Выжженных землях.‡Späht die gestrandeten Schiffe an der Havarieküste in den Verwüsteten Landen aus.‡저주받은 땅의 산산조각 바닷가에 있는 부서진 배를 조사해야 합니다.‡Explora los barcos naufragados en Costa Quebrada en Las Tierras Devastadas.‡Explora los barcos naufragados en Costa Quebrada en Las Tierras Devastadas.‡Allez inspecter les navires échoués sur le Rivage Ravagé, dans les Terres Foudroyées.‡侦查诅咒之地破碎海岸的失事船只。‡到詛咒之地的破碎海岸偵查撞毀擱淺的船。',
  }
},
[25716] = {
  {
    'Os sectários batem à porta‡Сектанты у нас на пороге‡Kultisten an der Schwelle‡코 앞의 이교도‡Cultores a las puertas‡Cultores a las puertas‡Des sectateurs sur le pas de notre porte‡门口的邪教徒‡我家門前有教徒',
    nil,
    'Obtenha 6 Focos de Feitiços de Devotos da Sombra Intactos matando Magilâminas e Ocultistas Devotos da Sombra na Barreira do Inferno.‡Раздобудьте 6 средоточий чар Приверженцев Тени у воинственных чародеев и оккультистов из культа Приверженцев Тени в Выжженных землях.‡Besorgt 6 intakte Zauberfokusse eines Schattenanbeters von Zauberklingen der Schattenanbeter und Okkultisten der Schattenanbeter in den Verwüsteten Landen.‡저주받은 땅에 있는 어둠혈맹 주문검술사와 어둠혈맹 사술사에게서 온전한 어둠혈맹 주문 집중점 6개를 획득해야 합니다.‡Consigue 6 focos de encantamiento Sombra Jurada intactos de hojas de hechizo Sombra Jurada y de ocultistas Sombra Jurada en Las Tierras Devastadas.‡Consigue 6 focos de hechizo jurasombras intactos de hojas de hechizo jurasombras y de ocultistas jurasombras en Las Tierras Devastadas.‡Procurez-vous 6 Focalisateurs de sorts lige d’ombre intacts sur des Sorcelames lige d’ombre et des Occultistes lige d’ombre dans les Terres Foudroyées.‡从诅咒之地的魔誓魔剑士和魔誓神秘学者身上获得6颗完好的魔誓法术核心。‡從詛咒之地的影誓法刃和影誓神秘學者那裡取得6個影誓法術集核。',
  }
},
[25717] = {
  {
    'Os demônios e o druida‡Демоны и друид‡Die Dämonen und der Druide‡악마와 드루이드‡Los demonios y el druida‡Los demonios y el druida‡Les démons et le druide‡恶魔和德鲁伊‡惡魔與德魯伊',
    nil,
    'Mate 5 Destruidores Demonarcas, 5 Senhores do Medo Profanadores, 5 Arvorosos Lenhanegra Corrompidos e 3 Senhores do Brejo Esporovil na Floresta Maculada.‡Убейте 5 стражников ужаса – разрушителей, 5 повелителей ужаса – осквернителей, 5 оскверненных темностволых древней и 3 скверноспорых болотников в Проклятом лесу.‡Tötet 5 Verdammniswachenzerstörer, 5 Schreckenslordschänder, 5 verderbte Dunkelwaldtreants und 3 Teufelssporensumpflords im Besudelten Wald.‡오염된 숲에서 파멸의 수호병 파괴자 5마리, 공포의 군주 파멸자 5마리, 타락한 흑단 나무정령 5마리, 지옥포자 수렁군주 3마리를 처치해야 합니다.‡Mata a 5 destructores guardias apocalípticos, a 5 señores del terror rapiñadores, a 5 antárboles Leñosocuro corruptos y a 3 señores de la marisma Vilespora en El Bosque Corrupto.‡Mata a 5 destructores guardias apocalípticos, a 5 señores del terror rapiñadores, a 5 antárboles Leñosocuro corruptos y a 3 señores de la marisma Vilespora en El Bosque Corrupto.‡Tuez 5 Destructeurs de la Garde funeste, 5 Seigneurs de l’effroi profanateurs, 5 Tréants sombrebois corrompus et 3 Seigneurs-tourbe gangrespores dans la Forêt Impure.‡在腐烂森林里杀死5个厄运守卫毁灭者、5个恐惧领主污染者、5个堕落的黑木树人和3个邪孢沼泽领主。‡在腐化之森裡殺死5隻末日守衛毀滅者、5隻驚懼領主污染者、5隻被腐化的暗木樹人和3隻魔孢泥沼領主。',
  }
},
[25718] = {
  {
    'A melhor forma de prosseguir‡Что делать дальше‡Wie man am besten weitermacht‡가장 좋은 진행 방법‡Cuál es el mejor proceder‡Cuál es el mejor proceder‡La meilleure façon de procéder‡最佳方案‡最佳方針',
    nil,
    'Apresente-se a Elias Voaurora no Acampamento Clarovéu, que fica na Barreira do Inferno.‡Поговорите с Элайджей Рассветным Полетом в экспедиции Солнечного Паруса в Выжженных землях.‡Meldet Euch bei Elijah Dämmerflug bei Sonnenschleiers Exkursionstrupp in den Verwüsteten Landen.‡저주받은 땅의 해가림 탐험지에 있는 엘리야 돈플라이트에게 보고해야 합니다.‡Preséntate ante Elijah Vueloalba en la Excursión Velosolar en Las Tierras Devastadas.‡Preséntate ante Elijah Vueloalba en la Excursión Velosolar en Las Tierras Devastadas.‡Présentez-vous à Elijah Aubevol à l’Expédition de Solevoile dans les Terres Foudroyées.‡向诅咒之地日纱考察营地的埃莉雅·暮翔报到。‡到詛咒之地的蔽日旅團向埃利賈·曦翔回報。',
  }
},
[25719] = {
  {
    'Recipiente demoníaco‡Демонический резервуар‡Dämonisches Gefäß‡악마의 용기‡Vasija demoníaca‡Vasija demoníaca‡Le réceptacle démoniaque‡魔能容器‡惡魔之軀',
    nil,
    'Mate os Ursos Pretos Maculados, Espreitadoras Noturnas Maculadas e Guinchadores Maculados na Floresta Maculada e tente reunir os pedaços deles em um Recipiente Demoníaco.‡Убейте нечистых черных медведей, нечистых ночных ловцов и нечистых крикунов в Проклятом лесу, а потом составьте из их органов демонический резервуар.‡Tötet besudelte Schwarzbären, besudelte Nachtpirscher und besudelte Kreischer im Besudelten Wald und versucht, ihre Kadaverteile zu einem dämonischen Gefäß zusammenzusetzen.‡오염된 숲에서 오염된 검은곰, 오염된 흑거미, 오염된 비명박쥐를 처치한 다음, 신체 기관을 합쳐 악마의 용기를 만들어야 합니다.‡Mata a los osos negros corruptos, a los acechadores nocturnos corruptos y a los estridadores corruptos en El Bosque Corrupto, y trata de reunir sus trozos en una vasija demoníaca.‡Mata a los osos negros corruptos, a los acechadores nocturnos corruptos y a los estridadores corruptos en El Bosque Corrupto, y trata de reunir sus trozos en una vasija demoníaca.‡Tuez les Ours noirs impurs, les Traquenuits impurs et les Hurleurs impurs dans la Forêt Impure, et essayez d’assembler leurs fragments pour former un Réceptacle démoniaque.‡在腐烂森林里杀死腐烂的黑熊、腐烂的夜行蜘蛛和腐烂的尖啸蝙蝠，并将它们的肢体组合成魔能容器。‡在腐化之森殺死被感染的黑熊、被感染的夜間潛獵者和被感染的尖嘯者，然後試著將他們的屍體部位組合成惡魔之軀。',
  }
},
[25720] = {
  {
    'A ruína de Marl Wormthorn‡Падение Марла Червоточного‡Der Fall des Marl Wurmdorn‡마를 웜쏜의 몰락‡La caída de Marl Gusaespina‡La caída de Marl Gusaespina‡La chute de Marl Roncever‡玛尔·虫棘之死‡瑪爾·蠕棘之末日',
    nil,
    'Mate Marl Wormthorn em Maldraz, que fica na Barreira do Inferno. Você pode usar o Recipiente Demoníaco para despertá-lo do transe.‡Убейте Марла Червоточного у дерева Малдраз в Выжженных землях. Для того чтобы вывести Марла из транса, используйте демонический резервуар.‡Tötet Marl Wurmdorn bei Maldraz in den Verwüsteten Landen. Ihr könnt das dämonische Gefäß benutzen, um ihn aus seiner Trance zu holen.‡저주받은 땅의 말드라즈에 있는 마를 웜쏜을 처치해야 합니다. 마를 웜쏜을 무아지경 상태에서 깨어나게 하려면 악마의 용기를 사용하십시오.‡Mata a Marl Gusaespina en Maldraz en Las Tierras Devastadas. Puedes usar la vasija demoníaca para sacarlo de su trance.‡Mata a Marl Gusaespina en Maldraz en Las Tierras Devastadas. Puedes usar la vasija demoníaca para sacarlo de su trance.‡Tuez Marl Roncever à Maldraz, dans les Terres Foudroyées. Utilisez le Réceptacle démoniaque pour le sortir de sa transe.‡在诅咒之地的玛尔卓斯杀死玛尔·虫棘。你可以使用魔能容器打断他的沉睡。‡在詛咒之地裡的瑪爾德拉茲殺死瑪爾·蠕棘。你可以利用惡魔之軀將他從沈睡狀態中拉出。',
  }
},
[25721] = {
  {
    'Combate à inundação‡Борьба с наводнением‡Kämpft gegen die Flut‡홍수와의 싸움‡Combate las inundaciones‡Combate las inundaciones‡Combattre l\'inondation‡抗击洪水‡對抗洪水',
    nil,
    'Mate 10 Elementais da Inundação.‡Убейте 10 элементалей потока.‡Tötet 10 Flutelementare.‡홍수의 정령 10마리를 처치해야 합니다.‡Mata a 10 elementales de inundación.‡Mata a 10 elementales de inundación.‡Tuez 10 Élémentaires d\'inondation.‡摧毁10名洪水元素。‡殺死10個洪水元素。',
  }
},
[25722] = {
  {
    'Sedimentar, meu caro‡Сухой остаток‡Ablagerungen, mein Lieber‡침전물 조사‡Queridos sedimentos‡Queridos sedimentos‡Sédimentaire, mon cher…‡沉淀，我亲爱的。‡親愛的沉積物',
    nil,
    'Colete 8 Amostras de Sedimento da Inundação.‡Соберите 8 образцов принесенных наводнением наносов.‡Sammelt 8 Flutsedimentproben ein.‡홍수 침전물 견본 8개를 수집해야 합니다.‡Recoge 8 muestras de sedimentos inundados.‡Recoge 8 muestras de sedimentos inundados.‡Récoltez 8 Échantillons de sédiments alluviaux.‡收集8份洪水沉淀物样本。‡收集8個洪水沉積物樣本。',
  }
},
[25723] = {
  {
    'Azar deles, sorte nossa‡Не повезло жесткозубам‡Dreschen bringt Glück‡트레샤돈 고기 수집‡Trillar la suerte‡Trillar la suerte‡Faute de grives…‡碰运气‡倒楣的蛇頸龍',
    nil,
    'Colete 8 pedaços de Carne de Manguadonte dos Manguadontes Deslocados.‡Добудьте 8 кусков мяса жесткозуба, убивая вытесненных жесткозубов.‡Besorgt 8 Dreschadonbrocken von verirrten Dreschadons.‡떠밀려 온 트레샤돈을 사냥해 트레샤돈 고기 8덩이를 수집해야 합니다.‡Recoge 8 trozos de trillanodonte de trillanodontes desplazados.‡Recoge 8 trozos de trillanodonte de trillanodontes desplazados.‡Récupérez 8 Quartiers de battrodons sur des Battrodons déplacés.‡从被迫迁徙的蛇颈龙身上割下8块蛇颈龙肉块。‡從遷徙的蛇頸龍身上收集8個大塊蛇頸龍肉。',
  }
},
[25724] = {
  {
    'Agressão dos Jubafria‡Агрессия Мерзлогривов‡Frostmähnenaggression‡서리갈기 부족 침략‡La agresión de los Peloescarcha‡La agresión de los Peloescarcha‡L\'attaque des Crins-de-givre‡霜鬃的挑衅‡霜鬃入侵',
    nil,
    'Mate 5 Videntes Jubafria e 7 Marchaneves Jubafria na Cordilheira Cintilante.‡Убейте 5 ясновидцев из племени Мерзлогривов и 7 снегобродов из племени Мерзлогривов на Мерцающем хребте.‡Tötet 5 Seher der Frostmähnen und 7 Schneeschreiter der Frostmähnen auf Schimmergrat.‡아지랑이 마루에 있는 서리갈기 예언자 5명과 서리갈기 길잡이 7명을 처치해야 합니다.‡Mata a 5 videntes Peloescarcha y a 7 zancanieves Peloescarcha en Monte Luz.‡Mata a 5 videntes Peloescarcha y a 7 zancanieves Peloescarcha en Monte Luz.‡Tuez 5 Prophètes crins-de-givre et 7 Marche-neige crins-de-givre sur la Crête Scintillante.‡在闪光岭杀死5名霜鬃先知和7名霜鬃雪行者。‡在閃光嶺殺死5名霜鬃先知和7名霜鬃雪行者。',
  }
},
[25725] = {
  {
    'Brejamoras‡Целебная клюква‡Moosbuschbeeren‡넌출월귤‡Endrinas‡Endrinas‡La cueillette des airelles‡越橘‡沼澤莓',
    nil,
    'Colete 15 Punhados de Brejamoras.‡Соберите 15 пригоршней клюквы.‡Sammelt 15 Handvoll Moosbeeren.‡넌출월귤 한 줌을 수집해야 합니다.‡Recoge 15 manojos de endrinas.‡Recoge 15 manojos de endrinas.‡Cueillez 15 Poignées d’airelles.‡采集15捧越橘。‡收集15把沼澤莓。',
  }
},
[25726] = {
  {
    'Trabalho de nível‡Нивелирная работа‡Nivellierarbeiten‡망원경달린 수준기‡Un trabajo sucio‡Un trabajo sucio‡Perdu théodolite. Bonne récompense‡水准活儿‡矮子的工作',
    nil,
    'Obtenha um Nível Topográfico de uma Gosmícula Lodosa.‡Добудьте глухой нивелир из илистого слизнюка.‡Findet ein Nivelliergerät bei einem schmierigen Schlammling.‡토사 수액덩어리를 처치해 망원경달린 수준기를 획득해야 합니다.‡Consigue el nivel regordete de un moco de cieno.‡Consigue el nivel regordete de un moco de cieno.‡Récupérez le Théodolite sur un Suinteux vaseux.‡从一只滑腻淤泥怪的身上拿到水准仪。‡從淤泥小軟泥怪身上取得定靜水準儀。',
  }
},
[25727] = {
  {
    'Drungeld Carrancoso‡Друнгельд Исподлоб‡Drungeld Finsterblick‡드룬겔트 글로워글레어‡Drungeld Fruncibrillo‡Drungeld Fruncibrillo‡Drungeld Fronce-l\'Œil‡杜隆格·怒视‡莊格爾德‧怒瞪',
    nil,
    'Mate Drungeld Carrancoso e pegue a barba dele.‡Убейте Друнгельда Исподлоба и заберите его бороду.‡Tötet Dungeld Finsterblick und nehmt seinen Bart an Euch.‡드룬겔트 글로워글레어를 처치하고 그의 수염을 얻어야 합니다.‡Mata a Drungeld Fruncibrillo y consigue su barba.‡Mata a Drungeld Fruncibrillo y consigue su barba.‡Tuez Drungeld Fronce-l’Œil et scalpez-lui la barbe.‡杀死杜隆格·怒视，割下他的胡子。‡殺死莊格爾德‧怒瞪並取下他的鬍鬚。',
  }
},
[25728] = {
  {
    'O passeio radical do Sr. Pp‡Дикая охота Господина П.‡Baunzers wilder Ritt‡달려라, 아빠씨‡El alucinante viaje del Sr. P‡El alucinante viaje del Sr. P‡La chevauchée fantastique de monsieur B.‡水泡先生的狂野之旅‡老爹大暴走',
    nil,
    'Mate 20 Técnicos Goblins e 5 Ceifadores Goblins.‡Убейте 20 гоблинов-техников и 5 гоблинских жнецов.‡Tötet 20 Goblintechniker und 5 Goblinernter.‡고블린 기술병 20명을 처치하고 고블린 채취로봇 5대를 파괴해야 합니다.‡Mata a 20 técnicos goblin y a 5 cosechadores goblin.‡Mata a 20 técnicos goblin y a 5 cosechadores goblin.‡Tuez 20 Techniciens et 5 Moissonneurs gobelins.‡击败20名地精技师和5名地精收割者。‡消滅20名哥布林技師以及5名哥布林收割機。',
  }
},
[25729] = {
  {
    'Hanfritz, o Traidor‡Предатель Геренцо‡Gerenzo der Verräter‡배신자 게렌조‡Gerenzo el Traidor‡Gerenzo el Traidor‡Gerenzo le Traître‡叛徒格雷苏‡叛徒格雷蘇',
    nil,
    'Mate Hanfritz Schaventorck.‡Убейте Геренцо Терминатрикса.‡Tötet Gerenzo Pfeifzang.‡게렌조 렌치휘슬을 처치해야 합니다.‡Mata a Gerenzo Silbillave.‡Mata a Gerenzo Silbillave.‡Tuez Gerenzo Siffleclef.‡杀死格雷苏。‡殺死格雷蘇。',
  }
},
[25730] = {
  {
    'CUIDADO COM QUEIXADA!‡БЕРЕГИСЬ РИФОГРЫЗА!‡HÜTET EUCH VOR FELSKIEFER!‡칼바위턱 조심!‡¡CUIDADO CON PEÑAMANDÍBULA!‡¡CUIDADO CON PEÑAMANDÍBULA!‡ATTENTION À ROCHEGUEULE !‡当心峭颚！‡小心壁顎!',
    nil,
    'Mate Queixada e pegue o Dente Enorme do Queixada.‡Убейте Рифогрыза и возьмите в качестве доказательства огромный зуб Рифогрыза.‡Tötet Felskiefer und bringt Felskiefers riesigen Zahn an Euch.‡칼바위턱을 처치하고 칼바위턱의 거대한 이빨을 획득해야 합니다.‡Mata a Peñamandíbula y consigue el diente enorme de Peñamandíbula.‡Mata a Peñamandíbula y consigue el diente enorme de Peñamandíbula.‡Tuez Rochegueule et arrachez-lui son Énorme dent.‡杀死峭颚，拿到峭颚的巨齿。‡殺死壁顎並取得壁顎的巨齒。',
  }
},
[25731] = {
  {
    'Um pássaro na mão‡Птица в руке‡Ein Spatz in der Hand‡손안에 들어온 새‡Pájaro en mano‡Pájaro en mano‡Piégeage de harpie‡一鸟在手‡搞定鳥事',
    nil,
    'Apague um Sinal de Fogo das Harpias para chamar a atenção de Marion Alaverme. Lute com ela até Tessália conseguir prendê-la. Em seguida, interrogue a matriarca das harpias.‡Погасите сигнальный огонь гарпий, чтобы привлечь внимание Марион Червивое Крыло. Сражайтесь с ней, пока Тизали не схватит ее, а затем допросите предводительницу гарпий.‡Löscht ein Harpyiensignalfeuer, um die Aufmerksamkeit Marion Wurmschwinges zu erregen. Kämpft mit ihr, bis Thisalee sie einfängt, und befragt die Harpyienmatrone dann.‡하피 봉화를 꺼뜨리고 벌레날개 매리언의 주의를 끄십시오. 티살리가 매리언을 무력화시킬 때까지 매리언과 상대한 다음, 그녀를 심문해야 합니다.‡Apaga una señal de fuego de arpía para llamar la atención de Marion Alagusano. Enfréntate a ella hasta que Thisalee la tenga sometida y después interroga a la matrona arpía.‡Apaga una señal de fuego de arpía para llamar la atención de Marion Alagusano. Enfréntate a ella hasta que Thisalee la tenga sometida y después interroga a la matrona arpía.‡Éteignez un Feu d’alerte des harpies pour attirer Marion Aile-de-ver. Battez-vous avec elle jusqu’à ce que Thisalee la maîtrise, ensuite interrogez la matriarche des harpies.‡熄灭一处鹰身人烽火吸引玛瑞恩·虫翅前来。同她交战直到希萨莉制服她，然后讯问这个鹰身人主母。‡弄熄鷹身人火源信號以吸引瑪莉恩·蠕翼的注意。和她戰鬥直到黎沙莉制服她，然後質詢這名鷹身人首領。',
  }
},
[25732] = {
  {
    'Rico e muito, muito magro‡Игра в кости‡Ein Hühnchen rupfen‡좋은 소식, 나쁜 소식‡Un asunto pendiente‡Un asunto pendiente‡Un point à débattre‡解除诅咒‡撿骨頭',
    nil,
    'O Bino quer que você colete o Quebrador de Peltre do Rei Gurboggle no Salto de Gurboggle.‡Бадд просит вас забрать крушитель олова у короля Гурбоггла на шельфе Гурбоггла.‡Budd möchte, dass Ihr den Zinnplätter von König Gurboggel auf Gurboggels Fels besorgt.‡버드가 거보글 절벽에 있는 왕 거보글로부터 땜납 달구를 구해와 달라고 했습니다.‡Budd quiere que obtengas el aporreador de peltre del rey Guraturdido en el Saliente de Guraturdido.‡Budd quiere que obtengas el aporreador de peltre del rey Guraturdido en el Saliente de Guraturdido. ‡Budd veut que vous preniez le Marteau d’étain au roi Globulle, à l’escarpement de Globulle.‡巴德要你从戈博格海崖的戈博格大王那里获得锡镴古锤。‡霸德要你到葛爾巴果的岩礁，從葛爾巴果國王那裡取得白鑞杵。',
  }
},
[25733] = {
  {
    'Espreitadoras, chegou a hora‡Вон из моей пещеры!‡Pirscht von dannen‡동굴거미 처치‡Fuera de aquí, acechadores‡Fuera de aquí, acechadores‡Du balai, les traqueuses !‡滚出去，捕猎者‡滾出這裡，潛獵者',
    nil,
    'Mate 7 Espreitadoras da Caverna e 7 Espreitadoras Sanguessugas.‡Убейте 7 пещерных ловцов и 7 ловцов-кровопийц.‡Tötet 7 Höhlenpirscher und 7 Egelpirscher.‡긴다리동굴거미와 긴다리흡혈거미를 각각 7마리씩 처치해야 합니다.‡Mata a 7 acechadores de cuevas y a 7 acechadores sanguijuela.‡Mata a 7 acechadores de cuevas y a 7 acechadores sanguijuela.‡Tuez 7 Traqueuses des grottes et 7 Traqueuses sanguines.‡杀死7只洞穴捕猎者和7只吸血捕猎者。‡殺死7個洞穴潛獵者和7個吸血潛獵者。',
  }
},
[25734] = {
  {
    'Explorando a Rocha de Thelgen‡Дно пещеры Тельгена‡Unten im Thelgenfelsen‡텔겐 바위굴‡En el fondo de Roca Thelgen‡En el fondo de Roca Thelgen‡On touche le fond du rocher‡深入瑟根石‡進入瑟根石',
    nil,
    'Recupere o Relatório Sísmico de Thelgen da Rocha de Thelgen.‡Заберите сейсмические записи Тельгена из пещеры Тельгена.‡Holt den seismischen Bericht von Thelgen aus Thelgenfelsen.‡텔겐 바위굴에서 텔겐 지진 기록을 되찾아와야 합니다.‡Consigue la lectura sísmica de Thelgen en Roca Thelgen.‡Consigue la lectura sísmica de Thelgen en Roca Thelgen.‡Récupérez les Données sismiques de Thelgen au fond du Rocher de Thelgen.‡从瑟根石回收瑟根地震记录。‡從瑟根石取回瑟根地震紀錄。',
  }
},
[25735] = {
  {
    'Minério de Incendicita‡Огневитовая руда‡Pyrophorerz‡발연 광석‡Mena de incendicita‡Mena de incendicita‡Minerai d\'incendicite‡火岩矿石‡火岩礦石',
    nil,
    'Colete 8 unidades de Minério de Incendicita.‡Добудьте 8 кусков огневитовой руды.‡Findet 8 Stücke Pyrophorerz.‡발연 광석 8개를 수집해야 합니다.‡Recoge 8 piezas de mena de incendicita.‡Recoge 8 piezas de mena de incendicita.‡Extrayez 8 pépites de Minerai d’incendicite.‡采集8块火岩矿石。‡收集8個火岩礦石。',
  }
},
[25736] = {
  {
    'Núcleo Surtoflúvio‡Центр приливной волны‡Der Flutwellenkern‡홍수쇄도 핵‡El núcleo de oleada de inundación‡El núcleo de oleada de inundación‡Le cœur de déferlante‡涌浪之核‡湧流之核',
    nil,
    'Entregue o Núcleo Surtoflúvio a Forba Cinzelaje.‡Отнесите центр приливной волны Форбе Крепкой Стамеске.‡Bringt den Flutwellenkern zu Forba Fliesmeißel.‡홍수쇄도 핵을 포르바 슬랩치즐에게 가져가야 합니다.‡Entrega el núcleo de oleada de inundación a Forba Tallalosas.‡Entrega el núcleo de oleada de inundación a Forba Tallalosas.‡Donnez le Cœur de déferlante à Forba Cisepierre.‡把涌浪之核交给弗巴·硬凿看。‡將湧流之核送去給佛巴·斯拉奇索。',
  }
},
[25737] = {
  {
    'Negociações tênues‡Радушный прием‡Vorsichtige Verhandlungen‡보잘것없는 협상‡Negociaciones delicadas‡Negociaciones delicadas‡Négociations ardues‡空洞的谈判‡脆弱的協商',
    nil,
    'Fale com o Rei Gurboggle.‡Обратитесь к королю Гурбогглу.‡Sprecht mit König Gurboggel.‡왕 거보글과 대화해야 합니다.‡Habla con el rey Guraturdido.‡Habla con el rey Guraturdido.‡Parlez au Roi Globulle.‡跟戈博格大王谈一谈。‡與葛爾巴果國王交談。',
  }
},
[25738] = {
  {
    '‡Кое на ком природа отдыхает‡Das seichte Ende des Genpools‡‡La parte poco profunda de la piscina genética‡‡L\'idiot de la famille‡‡',
    nil,
    '‡Король Гурбоггл поручил вам убить Жабрингла на шельфе Гурбоггла.‡König Gurboggel möchte, dass Ihr Gilblingel auf Gurboggels Fels tötet.‡‡El rey Guraturdido quiere que mates a Gilblingle en el Saliente de Guraturdido.‡‡Le roi Globulle veut que vous tuiez Branchouille à l\'escarpement de Globulle.‡‡',
  }
},
[25739] = {
  {
    'Se a Horda não pegar você...‡Не Орда, так…‡Wenn die Horde Euch nicht erwischt...‡호드가 아닐지라도...‡Si la Horda no te atrapa...‡Si la Horda no te atrapa...‡Quand c\'est pas la Horde, c\'est autre chose‡要是部落没把你干掉……‡如果部落沒有逮住你...',
    nil,
    'Mate a Rainha Silith.‡Убейте королеву Силит.‡Tötet Königin Silith.‡여왕 실리스를 처치해야 합니다.‡Mata a la reina Silith.‡Mata a la reina Silith.‡Tuez la Reine Silith.‡杀死蛛后西莉丝。‡殺死希莉絲皇后。',
  }
},
[25740] = {
  {
    'Olho vivo e faro fino‡Разведка боем‡Auf der Suche nach Fakten‡사실 확인 임무‡Misión de búsqueda de información‡Misión de búsqueda de información‡Mission d\'investigation‡实地调查任务‡打探虛實',
    nil,
    'Apresente-se a Tessália na entrada do Mirante de Sethria, que fica no Monte Hyjal.‡Отыщите Тизали у входа в Гнездо Сетрии на горе Хиджал.‡Meldet Euch bei Thisalee am Eingang zu Sethrias Nest auf dem Hyjal.‡하이잘 산의 세스리아의 보금자리 입구에 있는 티살리에게 보고해야 합니다.‡Preséntate ante Thisalee en la entrada del Nidal de Sethria en el Monte Hyjal.‡Preséntate ante Thisalee en la entrada del Nidal de Sethria, en el Monte Hyjal. ‡Faites votre rapport à Thisalee à l\'entrée du Perchoir de Sethria, sur le Mont Hyjal.‡去找海加尔山塞西莉亚的栖地入口的希萨莉。‡到海加爾山的賽瑟莉亞棲息處入口向黎沙莉報到。',
  }
},
[25741] = {
  {
    'Preparação para o futuro‡Подготовка на будущее‡Auf die Zukunft vorbereiten‡미래를 위한 준비‡Preparativos para el futuro‡Preparativos para el futuro‡Préparatifs pour l\'avenir‡未雨绸缪‡防患未然',
    nil,
    'Colete 10 Vesículas de Peçonha de Aranha de Fundolimo.‡Соберите 10 ядовитых желез моховых пауков.‡Besorgt 10 Kluftmoosgiftbeutel.‡동굴이끼 독주머니 10개를 모아야 합니다.‡Consigue 10 glándulas de veneno de Musgondo.‡Consigue 10 glándulas de veneno de Musgondo.‡Récoltez 10 Sacs à venin de mousses-profondes.‡收集10个深苔蜘蛛的毒囊。‡收集10個深苔蜘蛛毒囊。',
  }
},
[25742] = {
  {
    '‡Опять двадцать пять!‡Was? Dieses alte Ding?‡‡¿Qué? ¿Esta antigualla?‡‡Quoi ? Ce vieux brimborion ?‡‡',
    nil,
    '‡Доставьте крушитель олова Харрисону на Проклятый риф.‡‡‡‡‡‡‡',
  }
},
[25743] = {
  {
    'Tantas decisões‡Вот ведь незадача‡Entscheidungen, Entscheidungen‡선택의 순간‡Decisiones, decisiones‡Decisiones, decisiones‡Un dilemme cornélien‡左右为难‡決定，決定',
    nil,
    'Você deve usar o Quebrador de Peltre para destruir o Profeta de Peltre.‡Воспользуйтесь крушителем олова, чтобы разбить оловянного пророка.‡Benutzt den Zinnplätter, um den Zinnpropheten zu zerstören.‡땜납 달구를 사용하여 땜납 예언자를 파괴해야 합니다.‡Debes utilizar el aporreador de peltre para destruir el profeta de peltre.‡Debes utilizar el aporreador de peltre para destruir el profeta de peltre.‡Vous devez utiliser le Marteau d’étain pour détruire le Prophète d’étain.‡你必须使用锡镴古锤摧毁锡镴先知。‡你必須使用白鑞杵摧毀白鑞預言書。',
  }
},
[25744] = {
  {
    'Negociações‡Переговоры‡Verhandlungen‡협상‡Negociaciones‡Negociaciones‡Les pétroleurs‡谈判‡交涉',
    nil,
    'Fale com Crazzle Molavivaz na Serra do Casco Fendido, que fica em Mil Agulhas.‡Поговорите с Краззлом Шустрецом на Утесе Треснувшего Копыта в Тысяче Игл.‡Sprecht mit Crazzle Flinkspross in Spalthufanhöhen in Tausend Nadeln.‡버섯구름 봉우리의 갈래발굽 언덕에 있는 크래즐 스프리스프로켓과 대화해야 합니다.‡Habla con Crazzle Engranágil en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Habla con Crazzle Engranágil en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Parlez à Pignouf Fulgurouage dans les Hauteurs du Sabot fendu, dans les Mille pointes.‡同千针石林裂蹄高地的克拉兹·滑链交谈。‡在千針石林的裂蹄陵地與克拉索·滑鏈交談。',
  }
},
[25745] = {
  {
    'Negociações‡Переговоры‡Verhandlungen‡협상‡Negociaciones‡Negociaciones‡Les pétroleurs‡谈判‡交涉',
    nil,
    'Fale com Riznek na Serra do Casco Fendido, que fica em Mil Agulhas.‡Поговорите с Ризнеком на Утесе Треснувшего Копыта в Тысяче Игл.‡Sprecht mit Riznek in Spalthufanhöhen in Tausend Nadeln.‡버섯구름 봉우리의 갈래발굽 언덕에 있는 리즈넥과 대화해야 합니다.‡Habla con Riznek en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Habla con Riznek en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Parlez à Riznek dans les Hauteurs du Sabot fendu, dans les Mille pointes.‡同千针石林裂蹄高地的瑞兹尼克交谈。‡在千針石林的裂蹄陵地與瑞茲尼克交談。',
  }
},
[25746] = {
  {
    'A prole de Sethria‡Род Сетрии‡Sethrias Brut‡세스리아의 하수인‡El linaje de Sethria‡El linaje de Sethria‡La colonie de Sethria‡塞西莉亚的血脉‡賽瑟莉亞的子嗣',
    nil,
    'Mate 12 Lacaios de Sethria, tanto Draconianos do Crepúsculo quanto Armoreiros Draconianos do Crepúsculo.‡Убейте 12 приспешников Сетрии: сумеречных драконидов и/или сумеречных драконидов-бронников.‡Tötet 12 von Sethrias Dienern: Eine beliebige Kombination aus Zwielichtdrachkin oder Rüstungsschmieden der Zwielichtdrachkin.‡세스리아의 하수인인 황혼의 용혈족이나 용혈족 대장장이를 종류에 상관없이 총 12마리 처치해야 합니다.‡Asesina a 12 de los secuaces de Sethria: cualquier combinación de dragonantes Crepusculares o de armeros dragonantes Crepusculares.‡Asesina a 12 de los secuaces de Sethria: cualquier combinación de dragonantes Crepusculares o de armeros dragonantes Crepusculares.‡Tuez 12 sujets de Sethria. N’importe quelle combinaison de Draconiens du Crépuscule ou d’Armuriers draconiens du Crépuscule fera l’affaire.‡消灭12名塞西莉亚的仆从：只要是暮光龙人或暮光龙人护甲师就行。‡消滅任意12個賽瑟莉亞的爪牙:暮光龍人或暮光龍人護甲匠。',
  }
},
[25747] = {
  {
    'Prevenindo o pior‡Взгляд в будущее‡Ein Blick nach vorne‡제독 찾아가기‡Mirando hacia delante‡Mirando hacia delante‡L’amiral a de l’avancement‡朝前看‡向前看',
    nil,
    'Encontre e fale com o Almirante Dvorek sob o terraço sul nas Ruínas de Vashj\'ir.|n|nUse o cavalo-marinho da Falaondas Valoren para chegar rapidamente ao posto avançado.‡Найдите адмирала Дворека под южной террасой в Руинах Вайш\'ира и поговорите с ним.|n|nВоспользуйтесь морским коньком Валорен Говорящей с волнами, чтобы быстро добраться до форпоста.‡Sprecht mit Admiral Dvorek unter der südlichen Terrasse in den Ruinen von Vashj\'ir.|n|nBenutzt Wellensprecherin Valorens Seepferd, um den Vorposten schnell zu erreichen.‡바쉬르 폐허 남쪽 계단지 밑에서 제독 드보렉을 찾아 대화해야 합니다.|n|n파도예언자 발로렌의 해마를 사용하여 신속하게 전진 기지로 이동하십시오.‡Encuentra al almirante Dvorek y habla con él bajo el bancal sur de las Ruinas de Vashj\'ir.|n|nUtiliza el caballito de mar de la hablaolas Valoren para llegar rápidamente al puesto avanzado.‡Encuentra al almirante Dvorek y habla con él bajo el bancal sur de las Ruinas de Vashj\'ir.|n|nUtiliza el caballito de mar de la hablaolas Valoren para llegar rápidamente al puesto avanzado.‡Parlez à l’Amiral Dvorek après l’avoir trouvé sous la terrasse sud, dans les Ruines de Vashj’ir.|n|nEmpruntez l\'hippocampe de la Parle-vague Valoren pour arriver plus rapidement à destination.‡去瓦丝琪尔废墟南部平台下找德沃雷克将军谈一谈。|n|n骑上波涛语者瓦罗伦的海马可以快速抵达前哨站。‡前往瓦許伊爾廢墟，找到南殿堂之下的德弗瑞克上將並與他談話。|n|n使用語濤者維勒連的海馬來快速前往前哨站。',
  }
},
[25748] = {
  {
    'Objetivos claros‡Ясные цели‡Deutliche Ziele‡명확한 목표‡Objetivos evidentes‡Objetivos evidentes‡Des objectifs clairs‡清晰的目标‡清楚的目標',
    nil,
    'Mate 10 soldados nagas que se reúnem sob o terraço a sudoeste, no térreo do local.‡Убейте 10 наг на нижнем уровне под юго-западной террасой.‡Tötet 10 Naga der Streitmächte, die sich unter der südlichen Terrasse auf der Grundebene zusammenziehen.‡남서쪽 계단지 아래 바닥층에 집합한 나가 군대 중 10마리를 처치해야 합니다.‡Mata a 10 miembros de las fuerzas naga que se están concentrando en la planta baja, bajo el bancal suroeste.‡Mata a 10 miembros de las fuerzas naga que se están concentrando en la planta baja, bajo el bancal suroeste.‡Tuez 10 éléments des troupes nagas s’amassant au niveau du sol, sous la terrasse sud.‡消灭10名在西南部平台下聚集的纳迦。‡殺死10名位於西南邊臺地下層的納迦部隊。',
  }
},
[25749] = {
  {
    'Não completamente despreparado‡Не так уж безоружны‡Nicht ganz unvorbereitet‡아주 무방비한 건 아니야‡No del todo desprevenidos‡No del todo desprevenidos‡C’est le vitrier !‡并非毫无准备‡並非全無準備',
    nil,
    'Leve 8 Pacotes de Setas de Besta para os Vigias da Aliança posicionados nas saliências sob o terraço ao sul.‡Принесите 8 связок арбалетных болтов дозорным Альянса, расставленным на уступах под южной террасой.‡Bringt 8 Schachteln mit Armbrustbolzen zu den Aufklärern der Allianz, die sich auf den Vorsprüngen unter der südlichen Terrasse befinden.‡남쪽 계단지 아래의 벼랑에 있는 얼라이언스 보초병에게 석궁 화살 상자 8개를 가져가야 합니다.‡Entrega 8 puñados de pernos de ballesta a los oteadores de la Alianza en los salientes que hay bajo el bancal sur.‡Entrega 8 puñados de pernos de ballesta a los oteadores de la Alianza en los salientes que hay bajo el bancal sur.‡Allez livrer 8 Boîtes de carreaux d’arbalète aux Guetteurs de l’Alliance postés sur les rebords, sous la terrasse sud.‡给南部平台下的联盟警戒哨兵送去8捆十字弓弩箭矢。‡將8捆弩箭帶去給部署在南邊臺地下層的聯盟偵查員。',
  }
},
[25750] = {
  {
    '‡Необычное поручение‡Spannende Ablenkung‡‡Curiosa distracción‡‡Un bien curieux passe-temps‡‡',
    nil,
    '‡Скопируйте надписи с 4 скрижалей высокорожденных.‡Schreibt die 4 Tafeln der Hochgeborenen ab.‡‡Copia las cuatro tablillas Altonato.‡‡Retranscrivez les 4 Tablettes de Bien-né.‡‡',
  }
},
[25751] = {
  {
    'Hora de improvisar‡Внезапное озарение‡Ausreichende Inspiration‡딱 맞는 영감‡La inspiración adecuada‡La inspiración adecuada‡Question d’inspiration‡备受启发‡適當地啟發',
    nil,
    'Colete 8 Bulbos Inchados de Alga que ficam pendurados sob o terraço a sudoeste.‡Соберите 8 раздувшихся шишек водорослей, висящих под юго-западной террасой.‡Sammelt 8 aufgedunsene Tangblasen, die unterhalb der südlichen Terrasse hängen.‡남서쪽 계단지 밑에 매달려 있는 불어오른 해초 알뿌리 8개를 모아야 합니다.‡Reúne 8 bulbos de alga hinchados que cuelgan bajo el bancal suroeste.‡Reúne 8 bulbos de alga hinchados que cuelgan bajo el bancal suroeste.‡Récoltez 8 Bulbes de varech boursouflé qui pendent sous la terrasse sud-ouest.‡在西南部平台下收集8颗胀大的海藻球。‡在西南部臺地底下收集8個腫脹的海藻球莖。',
  }
},
[25752] = {
  {
    'Ação rápida‡Медлить нельзя‡Blitzangriff‡신속한 행동‡Acción rápida‡Acción rápida‡Une action enlevée‡动如脱兔‡快速行動',
    nil,
    'Fale com o Engenheiro Hexasfrega do lado de fora do prédio, para tomar parte no ataque, e então use os explosivos improvisados para matar 100 Soldados Azsh\'ir, 20 Gritaondas Azsh\'ir e 12 Arkaens Azsh\'ir.‡Поговорите с инженером Мегагексом, стоящим у здания, чтобы присоединиться к атаке, а затем убейте 100 солдат Азш\'ира, 20 водных визгуний Азш\'ира и 12 археев Азш\'ира с помощью импровизированной взрывчатки.‡Sprecht mit Ingenieur Hexasept außerhalb des Gebäudes, um Euch dem Überfall anzuschließen. Benutzt dann Euren improvisierten Sprengstoff, um 100 Soldaten der Azsh\'ir, 20 Wellenkreischer der Azsh\'ir und 12 Archaeen der Azsh\'ir zu töten.‡공격에 참여하려면 건물 바로 밖에 있는 기술자 헥사스크럽과 이야기한 다음, 즉석 폭탄을 사용하여 계단지 위쪽에 있는 아즈쉬르 병사 100마리, 아즈쉬르 파도 비명술사 20마리, 아즈쉬르 고대나가 12마리를 처치해야 합니다.‡Habla con el ingeniero Friegahexágonos en el exterior del edificio para unirte al asalto y utiliza tus explosivos improvisados para matar a 100 soldados de Azsh\'ir, 20 vociferadoras de las olas de Azsh\'ir y 12 arqueanos Azsh\'ir.‡Habla con el ingeniero Friegahexágonos en el exterior del edificio para unirte al asalto y utiliza tus explosivos improvisados para matar a 100 soldados de Azsh\'ir, 20 vociferadoras de las olas de Azsh\'ir y 12 arqueanos Azsh\'ir.‡Parlez à l’Ingénieur Hexabrosse juste à l’extérieur du bâtiment pour participer à l’attaque, puis utilisez vos explosifs improvisés pour tuer 100 Soldats azsh’ir, 20 Hurle-vagues azsh’ir et 12 Archéens azsh’ir.‡跟房子外面的工程师“洗衣桶”交谈并加入总攻，使用你的速成炸药杀死平台上的100个艾萨尔士兵、20个艾萨尔波涛尖啸者和12个艾萨尔上古卫士。‡和建築外面的工程師赫克薩克拉談話來加入突擊行動，然後使用你臨時做出來的爆裂物在臺地上殺死100個艾薩伊爾士兵、20個艾薩伊爾嘯浪者和12個艾薩伊爾執政官。',
  }
},
[25753] = {
  {
    'Caídos, mas não esquecidos‡Повержены, но не забыты‡Gefallen, aber nicht vergessen‡스러졌으나 잊지 않으리라‡Caídos, pero no olvidados‡Caídos, pero no olvidados‡Tombés mais pas oubliés‡任何人都不能落下‡失落但不被遺忘',
    nil,
    'Resgate 6 Voluntários do Ataque Feridos‡Спасите 6 раненых добровольцев.‡Rettet 6 verletzte freiwillige Angreifer.‡부상당한 돌격 지원병 6명을 구출해야 합니다.‡Rescata a 6 voluntarios de asalto heridos.‡Rescata a 6 voluntarios de asalto heridos.‡Secourez 6 Volontaires pour l’assaut blessés.‡营救6名受伤的突击志愿兵。‡解救6名受傷的志願突襲兵。',
  }
},
[25754] = {
  {
    'Avaliando o sucesso‡Подсчет‡Einschätzung des Erfolgs‡성공 가늠하기‡Estimación de éxito‡Estimación de éxito‡Post mortem‡估测胜算‡成功標準',
    nil,
    'Examine a área noroeste do terraço circular e o túnel sob as escadas principais ao norte. Ambos os locais se encontram no Terraço de Nar\'shola, o nível intermediário das ruínas.‡Отправляйтесь на разведку в северо-западную часть круглой террасы и в туннель на севере. Они расположены на террасе Нар\'шолы на среднем уровне руин.‡Späht den nordwestlichen Teil der runden Terrasse und den Tunnel unter der Haupttreppe im Norden aus. Beide Orte befinden sich auf der Terrasse von Nar\'shola, der mittleren Ebene der Ruinen.‡계단지의 북서쪽 지역과 주 계단으로 이어지는 북쪽 터널을 정찰해야 합니다. 양 지역 모두 폐허의 중간층 나르숄라 계단지에 있습니다.‡Explora la sección noroeste del bancal circular y el túnel que hay bajo las escaleras principales del norte. Ambos lugares se encuentran en el Bancal de Nar\'shola, el nivel medio de las ruinas.‡Explora la sección noroeste del bancal circular y el túnel que hay bajo las escaleras principales del norte. Ambos lugares se encuentran en el Bancal de Nar\'shola, el nivel medio de las ruinas.‡Explorez la partie nord-ouest de la terrasse circulaire, ainsi que le tunnel sous le grand escalier nord. Ces deux endroits se situent sur la terrasse de Nar’shola, le niveau intermédiaire des ruines.‡侦查圆形平台的西北边缘，以及北部主台阶下的隧道。这两个地点都在废墟的中层。‡偵查西北邊的圓形殿堂邊緣以及北邊的殿堂隧道。',
  }
},
[25755] = {
  {
    'Visões do passado: o massacre da Crista Biel\'aran‡Видения прошлого: битва на гряде Бейл\'аран‡Visionen der Vergangenheit: Das Massaker von Biel\'aran‡과거의 환영: 비엘아란 마루의 학살자‡Visiones del pasado: La matanza de la Cresta de Biel\'aran‡Visiones del pasado: La matanza de la Cresta de Biel\'aran‡Visions du passé : le massacre de la crête de Biel\'aran‡过去的影像：贝耶拉兰山惨案‡過去的幻景:畢耶拉蘭山脊的屠殺',
    nil,
    'Assista à história da Dama Guerreira usando a lâmina quebrada no local da morte do general kvaldir.‡Отправляйтесь на место гибели квалдирского генерала и с помощью сломанного клинка Воительницы призовите видение из прошлого, чтобы узнать продолжение истории о Воительнице.‡Werdet Zeuge des weiteren Verlaufs der Geschichte der Kriegsmaid, indem Ihr ihre gebrochene Klinge am Sterbeort des Generals der Kvaldir benutzt.‡크발디르 장군이 죽은 곳으로 간 다음, 부러진 창을 사용하여 나가 여전사의 다음 이야기를 확인해야 합니다.‡Contempla la continuación de la historia de la doncella de batalla utilizando su hoja rota en el lugar de la muerte del general Kvaldir.‡Contempla la continuación de la historia de la doncella de batalla utilizando su hoja rota en el lugar de la muerte del general Kvaldir.‡Apprenez la suite de l’histoire de la vierge combattante en utilisant sa lame brisée à l’endroit où est tombé le général kvaldir.‡在克瓦迪尔将军的阵亡之地使用女武士的断剑，目睹她随后的经历。‡使用戰鬥仕女的斷劍來見證她在科瓦迪爾將軍陣亡之地的後續故事。',
  }
},
[25756] = {
  {
    'Peguem o Zheran!‡Хватай Зерина!‡Zehrt an Zherin!‡제린을 잡아라!‡¡Ve tras Zherin!‡¡Ve tras Zherin!‡Une concurrence musclée‡搞定泽尔林！‡抓住澤爾林!',
    nil,
    'Consiga a Proposta da Horda.‡Раздобудьте предложение Орды.‡Erhaltet das Angebot der Horde.‡호드의 제안서를 획득해야 합니다.‡Consigue la propuesta de la Horda.‡Consigue la propuesta de la Horda.‡Obtenez les termes de la Proposition de la Horde.‡获得部落投标书。‡取得部落的提案。',
  }
},
[25757] = {
  {
    'Peguem o Barbakarvão‡Хватай Углеборода!‡Etwas hart zu Kohlebart!‡콜비어드를 잡아라!‡¡Ve tras Karbarbán!‡¡Ve tras Karbarbán!‡Une concurrence musclée‡搞定浓须！‡拿下濃鬚!',
    nil,
    'Consiga a Proposta da Aliança.‡Раздобудьте предложение Альянса.‡Erhaltet das Angebot der Allianz.‡얼라이언스의 제안서를 획득해야 합니다.‡Consigue la propuesta de la Alianza.‡Consigue la propuesta de la Alianza.‡Obtenez les termes de la Proposition de l’Alliance.‡获得联盟投标书。‡拿到聯盟的提案。',
  }
},
[25758] = {
  {
    'Armadura infalível‡Изъян в броне‡Eine Lücke in ihrer Rüstung‡갑옷의 약점‡Un hueco en su armadura‡Un hueco en su armadura‡Le défaut de la cuirasse‡护甲上的破绽‡百密一疏',
    nil,
    'Recolha 8 Placas de Armadura Crepuscular.‡Соберите 8 сумеречных пластин для доспехов.‡Sammelt 8 Panzerplatten des Schattenhammers.‡황혼의 갑옷 도금판 8개를 수집해야 합니다.‡Reúne 8 placas de armadura Crepuscular.‡Reúne 8 placas de armadura Crepuscular.‡Rassemblez 8 Plaques d\'armure du Crépuscule‡收集8件暮光护甲。‡收集8個暮光護甲板。',
  }
},
[25759] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    '‡Отнесите загадочное устройство в Оргриммар, Подгород, Луносвет или Громовой Утес и покажите его представителю Служителей Земли.‡Bringt das mysteriöse Gerät nach Orgrimmar, Unterstadt, Silbermond oder Donnerfels und zeigt es einem Botschafter des Irdenen Rings.‡‡Lleva el dispositivo misterioso a Orgrimmar, a Entrañas, a Ciudad de Lunargenta o a Cima del Trueno y muéstraselo a un representante del Anillo de la Tierra.‡‡Apportez le Mystérieux appareil à Orgrimmar, Fossoyeuse, Lune-d\'Argent ou aux Pitons-du-Tonnerre et montrez-le à un Représentant du Cercle terrestre.‡‡',
  }
},
[25760] = {
  {
    'Visões do passado: a invasão de Vashj\'ir‡Видения прошлого: вторжение в Вайш\'ир‡Visionen der Vergangenheit: Die Invasion von Vashj\'ir‡과거의 환영: 바쉬르 침략‡Visiones del pasado: La invasión de Vashj\'ir‡Visiones del pasado: La invasión de Vashj\'ir‡Visions du passé : l’invasion de Vashj’ir‡过去的影像：瓦丝琪尔的入侵‡過去的幻景:瓦許伊爾的入侵',
    nil,
    'Use a Lâmina da Dama Guerreira Naz\'jar no campo de batalha na extremidade sudeste das ruínas.‡Воспользуйтесь клинком воительницы Леди Наз\'жар на поле битвы возле юго-восточной окраины руин.‡Benutzt die Klinge der Kriegsmaid der Naz\'jar auf dem Schlachtfeld am südöstlichen Ende der Ruinen.‡폐허 남동쪽 끝에 있는 격전지로 가서 나즈자르 여전사의 외날창을 사용해야 합니다.‡Usa la hoja de la doncella de batalla Naz\'jar en el lugar de la batalla, en el extremo sureste de las ruinas.‡Usa la hoja de la doncella de batalla Naz\'jar en el lugar de la batalla, en el extremo sureste de las ruinas.‡Utilisez la Lame de la vierge combattante naz’jar sur le champ de bataille à l’extrémité sud-est des ruines.‡在花园东南部尽头的战斗现场使用纳兹夏尔女武士之刃。‡在廢墟東南端的戰爭遺址使用納茲賈爾戰鬥仕女之刃。',
  }
},
[25761] = {
  {
    'Desmonte‡Сорвать доспехи‡Demontage‡해체 작업‡Desensamblaje‡Desensamblaje‡Détricotage‡解体‡解體',
    nil,
    'Use o Estoque de Tessália para despertar e matar 3 Jaganatas do Crepúsculo. O estoque pode ser usado várias vezes até destruir a armadura do Inexorável.‡Воспользуйтесь кинжалом Тизали, чтобы разбудить и убить 3 сумеречных берсерков. Кинжал можно применять многократно, чтобы полностью сорвать доспех с берсерка.‡Benutzt Thisalees Messer, um 3 Zwielichtmoloche zu wecken und zu töten. Das Messer kann mehrfach verwendet werden, um die Rüstung eines Molochs herunterzureißen.‡티살리의 비수를 사용하여 황혼의 돌격전사 3마리를 깨우고 처치해야 합니다. 이 비수는 몇 번이고 사용하여 돌격전사의 갑옷을 뜯어낼 수 있습니다.‡Usa el chafarote de Thisalee para despertar y matar a 3 gigantes Crepusculares. El chafarote puede usarse varias veces para arrancar la armadura de los gigantes.‡Usa el chafarote de Thisalee para despertar y matar a 3 Gigantes Crepusculares. El chafarote puede usarse varias veces para arrancar la armadura de los gigantes. ‡Utilisez le Coutelas de Thisalee pour réveiller 3 Mastodontes du Crépuscule et tuez-les. Le coutelas peut être utilisé plusieurs fois afin d’ôter l’armure des mastodontes.‡用希萨莉的尖刀唤醒并消灭3名暮光主宰。尖刀可以使用多次，割裂主宰的盔甲。‡使用黎沙莉的剃刃喚醒並消滅3個暮光毀滅龍人。剃刃可以重複使用來剝除毀滅龍人的盔甲。',
  }
},
[25762] = {
  {
    'O antigo braseiro‡Древняя жаровня‡Die uralte Kohlenpfanne‡고대 화톳불‡El blandón antiguo‡El blandón antiguo‡Le brasero antique‡远古火盆‡古代火盆',
    nil,
    'Reacenda o Antigo Braseiro e obtenha a Chama Sagrada.‡Разожгите древнюю жаровню и раздобудьте священное пламя.‡Entfacht die uralte Kohlenpfanne wieder und erhaltet die heilige Flamme.‡고대 화톳불에 다시 불을 붙여 신성한 불꽃을 획득해야 합니다.‡Reactiva el blandón antiguo y consigue la llama sacra.‡Reactiva el blandón antiguo y consigue la llama sacra.‡Rallumez le Brasero antique et obtenez la Flamme sacrée.‡重新点燃远古火盆，获得神圣烈焰。‡重新點燃古代火盆並且取得神聖之火。',
  }
},
[25763] = {
  {
    'O Códice das Trevas‡Кодекс теней‡Der Kodex der Schatten‡어둠의 고서‡El Códice de las Sombras‡El Códice de las Sombras‡Le codex des ombres‡暗影圣典‡影之聖典',
    nil,
    'Relate sua descoberta para Tessália Corvina no Mirante de Sethria, que fica no Monte Hyjal.‡Поведайте о своей находке Тизали Вороне в Гнезде Сетрии на горе Хиджал.‡Meldet Thisalee Krähe bei Sethrias Nest auf dem Hyjal Eure Entdeckungen.‡하이잘 산의 세스리아의 보금자리에 있는 티살리 크로우에게 당신이 발견한 것을 보고해야 합니다.‡Informa a Thisalee Cuervo de lo que has descubierto en el Nidal de Sethria en Monte Hyjal.‡Informa a Thisalee Cuervo de lo que has descubierto en el Nidal de Sethria en Monte Hyjal.‡Allez montrer votre découverte à Thisalee Corbeau au Perchoir de Sethria, sur le Mont Hyjal.‡海加尔山塞西莉亚的栖地的希萨莉·黑鸦报告你的发现。‡向黎沙莉·烏鴉報告你在海加爾山的賽瑟莉亞的棲息處發現了什麼。',
  }
},
[25764] = {
  {
    'Ovo tipo extra‡Охота за яйцами‡Eierjagd‡알의 행방을 찾아‡¡A cazar huevos!‡¡A cazar huevos!‡La chasse aux œufs‡寻找艾维娜的卵‡獵蛋行動',
    nil,
    'Desligue os Geradores de Manto Sombrio até encontrar o Ovo de Aviana. Em seguida, proteja o ovo até que os Druidas do Gadanho o levem para um lugar seguro.‡Отключайте генераторы покрова теней до тех пор, пока не обнаружите яйцо Авианы. Затем охраняйте его до того момента, как друиды-вороны заберут яйцо в безопасное место.‡Deaktiviert die Schattentarnungsgeneratoren, bis Ihr Avianas Ei gefunden habt. Sobald das Ei enttarnt wurde, verteidigt es, bis die Druiden der Klaue es in Sicherheit bringen können.‡아비아나의 알을 찾을 때까지 어둠 장막 생성기를 끄십시오. 알을 찾으면 갈퀴발톱의 드루이드들이 알을 안전한 곳으로 옮길 때까지 보호해야 합니다.‡Desactiva los generadores de manto de las Sombras hasta que descubras el huevo de Aviana. Una vez descubierto el huevo, defiéndelo hasta que los druidas de la Garfa puedan llevarlo a lugar seguro.‡Desactiva los generadores de manto de las Sombras hasta que descubras el huevo de Aviana. Una vez descubierto el huevo, defiéndelo hasta que los druidas de la Garfa puedan llevarlo a lugar seguro.‡Désactivez les Générateurs d\'écran d’ombre jusqu’à ce que vous dévoiliez l’Œuf d’Aviana. Une fois que ce sera fait, défendez l’œuf le temps que les druides de la Serre le mettent en sûreté.‡关闭暗影遮罩发生器直到你找到艾维娜的卵。一旦找到，全力守护它直到猛禽德鲁伊们能把它安全带走为止。‡解除暗影遮罩產生器，直到你發現艾維娜之卵為止。一旦發現了卵，保護它直到猛禽德魯伊安全地把它帶走。',
  }
},
[25765] = {
  {
    'Diga a eles que Koko enviou você‡Скажешь, что ты от Коко‡Sagt ihnen, Koko schickt Euch‡코코가 보낸 이‡Diles que te envía Koko‡Diles que te envía Koko‡Dites-leur que Koko vous envoie‡跟他们说科科派你去的‡說科仔派你來的',
    nil,
    'Apresente-se ao Comandante de Força Valen na Base da Expedição Guardanorte, que fica na Cordilheira das Torres de Pedra.‡Доложитесь командиру армии Валену в лагере экспедиции Северной Стражи, что в Когтистых горах.‡Meldet Euch bei Truppenkommandant Valen am Basislager der Nordwachtexpedition im Steinkrallengebirge.‡돌발톱 산맥의 북부감시 원정대 기지에 있는 전투사령관 발렌에게 보고해야 합니다.‡Preséntate ante el Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Preséntate ante el Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Allez vous placer sous les ordres du Commandant de corps Valen au Camp de base de l’expédition de Guet-du-Nord, dans les Serres-Rocheuses.‡去找石爪山脉北卫远征军营地的部队指挥官范伦。‡到石爪山脈的北方遠征隊營地向軍隊指揮官瓦倫回報。',
  }
},
[25766] = {
  {
    'Legado arcano‡Тайное наследие‡Arkanes Vermächtnis‡비전 마력의 유산‡El legado arcano‡El legado arcano‡Le legs des arcanes‡奥术遗产‡秘法遺產',
    nil,
    'Use a Prisão dos Altaneiros para prender 5 Espíritos Altaneiros.‡Используйте тюрьму высокорожденных, чтобы упокоить 5 духов высокорожденных.‡Benutzt das Gefängnis der Hochgeborenen, um 5 Geister der Hochgeborenen zu binden.‡명가의 감옥을 사용하여 명가의 원혼 5마리를 속박해야 합니다.‡Utiliza la prisión de Altonato para vincular a 5 espíritus Altonato.|n‡Utiliza la prisión de Altonato para vincular a 5 espíritus Altonato.|n‡Utilisez la Prison de Bien-né pour capturer 5 Esprits de Bien-né.‡使用上层精灵的禁锢束缚5只上层精灵之魂。‡使用精靈貴族牢籠禁錮5個精靈貴族靈魂。',
  }
},
[25767] = {
  {
    'Capturando memórias‡В поисках воспоминаний‡Erinnerungen einfangen‡기억 되찾기‡El baúl de los recuerdos‡El baúl de los recuerdos‡Souvenirs, souvenirs…‡捕获记忆‡奪取回憶',
    nil,
    'Colete 8 Relíquias Eldre\'thar.‡Соберите 8 реликвий Эльдре\'тара.‡Besorgt 8 Relikte von Eldre\'thar.‡엘드레타르 유물 8개를 모아야 합니다.‡Recoge 8 reliquias Eldre\'thar.‡Recoge 8 reliquias Eldre\'thar.‡Trouvez 8 Reliques d’Eldre’thar.‡收集8个埃德雷萨圣物。‡收集8個艾爾德雷薩聖物。',
  }
},
[25768] = {
  {
    'Lá vai bomba: Posto Mirkfallon!‡Сбрасывай бомбу: пост на Мутном озере!‡Feuer frei: Mirkfallonposten!‡폭격 주의보: 땅거미 주둔지!‡¡Bombas fuera: Puesto Mirkfallon!‡¡Bombas fuera: Puesto Mirkfallon!‡Bombes aisées du lac de Mirkfallon‡炸弹投放：暗色哨站！‡盡情轟炸:暗色崗哨!',
    nil,
    'Apresente-se ao Comandante dos Batedores Barus no Posto Mirkfallon, que fica na Cordilheira das Torres de Pedra.‡Доложитесь командиру разведчиков Барусу на посту на Туманном озере в Когтистых горах.‡Meldet Euch bei Späherkommandant Barus am Mirkfallonposten im Steinkrallengebirge.‡돌발톱 산맥의 땅거미 주둔지에 있는 정찰대장 바루스에게 보고해야 합니다.‡Preséntate ante el capitán de exploradores Barus en el Puesto Mirkfallon, en Sierra Espolón.‡Preséntate ante el capitán de exploradores Barus en el Puesto Mirkfallon, en Sierra Espolón.‡Rendez-vous auprès du Commandant des éclaireurs Barus au Poste de Mirkfallon, dans les Serres-Rocheuses.‡去找石爪山脉暗色哨站的斥候指挥官巴努斯。‡到石爪山脈的暗色崗哨向斥候指揮官巴魯斯回報。',
  }
},
[25769] = {
  {
    'Marárida chama‡Вызов к лорду Болотной Пахоте‡Brachweiher ruft‡팰로우미어의 부름‡El reclamo de Merobarbecho‡El reclamo de Merobarbecho‡Aiguebrune vous appelle‡法罗米尔召唤‡法洛梅爾的召喚',
    nil,
    'Fale com Dôminus Marárida na Vila de Cortavento, na Cordilheira das Torres de Pedra.‡Поговорите с лордом Болотной Пахотой в крепости Ветрорезов в Когтистых горах.‡Sprecht mit Lord Brachweiher an der Scherwindfeste im Steinkrallengebirge.‡돌발톱 산맥의 칼바람 요새에 있는 팰로우미어 경과 대화해야 합니다.‡Habla con Lord Merobarbecho en el Bastión Cortaviento, en Sierra Espolón.‡Habla con Lord Merobarbecho en el Bastión Cortaviento, en Sierra Espolón.‡Parlez au Seigneur Aiguebrune au Bastion des Cisailles, dans les Serres-Rocheuses.‡跟石爪山脉风剪要塞的指挥官法罗米尔谈一谈。‡到石爪山脈的狂風堡找法洛梅爾領主說話。',
  }
},
[25770] = {
  {
    'Entregador de cerva‡Кати бочку!‡Fasslieferung‡에일 맥주통 전달‡La carrera del barril‡La carrera del barril‡Course de tonneaux‡送酒‡送酒',
    nil,
    'Entregue a Cerveja do Montanhista a Forba Cinzelaje na Guarda de Cinzelaje.‡Доставьте эль горного пехотинца Форбе Крепкой Стамеске на привал Крепкой Стамески.‡Bringt das Gebirgsjägerbier zu Forba Fliesmeißel an Fliesmeißels Messstation.‡산악경비대 맥주를 슬랩치즐의 측량지에 있는 포르바 슬랩치즐에게 가져가야 합니다.‡Entrega la cerveza de montaraz a Forba Tallalosas en el Peritaje de Tallalosas.‡Entrega la cerveza de montaraz a Forba Tallalosas en el Peritaje de Tallalosas.‡Livrez la Bière de montagnard à Forba Cisepierre, à la Mission de Cisepierre.‡将巡山人的麦酒送给硬凿勘测队的弗巴·硬凿。‡將巡山人的麥芽酒送到斯拉奇索勘察地給佛巴·斯拉奇索。',
  }
},
[25771] = {
  {
    'O lixo de um draenei...‡Дренейский хлам‡Des einen Draeneis Plunder...‡어느 드레나이의 잡동사니...‡Un trasto de Draenei...‡Un trasto de Draenei...‡Au rebut pour les draeneï…‡一件德莱尼垃圾‡一件德萊尼垃圾...',
    nil,
    'Leve o Fragmento Imperfeito de Draenetista para Kum\'isha, o Colecionador, na Barreira do Inferno.‡Отнесите несовершенный фрагмент дренетиста Кум\'ише Коллекционеру в Выжженных землях.‡Bringt das unvollständige Draenethystfragment zu Kum\'isha dem Sammler in den Verwüsteten Landen.‡저주받은 땅에 있는 수집가 굼이샤에게 불완전한 드레니시스트 조각을 가져가야 합니다.‡Lleva el trozo draenetista imperfecto a Kum\'isha el Coleccionista en Las Tierras Devastadas.‡Lleva el trozo draenetista imperfecto a Kum\'isha el Coleccionista en Las Tierras Devastadas.‡Apportez le Fragment imparfait de draenéthyste à Kum\'isha le Collecteur dans les Terres Foudroyées.‡将不完美的德莱尼水晶碎片交给诅咒之地的收藏家库米沙。‡將殘缺的德萊尼水晶碎片帶回去詛咒之地給『收藏家』庫米沙。',
  }
},
[25772] = {
  {
    'Empreitadas do Kum\'isha‡Для коллекции Кум\'иши‡Kum\'ishas Bemühungen‡굼이샤의 노력‡Los esfuerzos de Kum\'isha‡Los esfuerzos de Kum\'isha‡Les efforts de Kum\'isha‡库米沙的努力‡庫米沙的努力',
    nil,
    'Leve a Esfera de Draenetista Impecável para Kum\'isha, o Colecionador, na Barreira do Inferno.‡Отнесите безупречную сферу из дренетиста Кум\'ише Коллекционеру в Выжженных землях.‡Bringt die fehlerlose Draenethystsphäre zu Kum\'isha dem Sammler in den Verwüsteten Landen.‡저주받은 땅에 있는 수집가 굼이샤에게 완전무결한 드레니시스트 구슬을 가져가야 합니다.‡Lleva la esfera draenetista perfecta a Kum\'isha el Coleccionista en Las Tierras Devastadas.‡Lleva la esfera draenetista perfecta a Kum\'isha el Coleccionista en Las Tierras Devastadas.‡Apportez la Sphère de draenéthyste sans défaut à Kum\'isha le Collecteur dans les Terres Foudroyées.‡将无瑕的德莱尼水晶球交给诅咒之地的收藏家库米沙。‡將無瑕的德萊尼水晶球帶去詛咒之地給『收藏家』庫米沙。',
  }
},
[25773] = {
  {
    'Um acontecimento natural‡Природное явление‡Ein natürlicher Vorfall‡자연적 현상‡Un incidente elemental‡Un incidente elemental‡Un évènement naturel‡自然异象‡自然產生',
    nil,
    'Leve o Estilhaço Elemental para um Emissário da Harmonia Telúrica em Altaforja, Ventobravo, Exodar ou Darnassus.‡Отнесите осколок элементаля посланнику Служителей Земли в Стальгорн, Штормград, Экзодар или Дарнас.‡Bringt den Elementarsplitter zu einem Botschafter des Irdenen Rings in Eisenschmiede, Sturmwind, Exodar oder Darnassus.‡아이언포지, 스톰윈드, 엑소다르, 또는 다르나서스에 있는 대지 고리회 사절에게 정기의 조각을 가져가야 합니다.‡Lleva el fragmento elemental a un emisario del Anillo de la Tierra en Forjaz, Ventormenta, El Exodar o Darnassus.‡Lleva el fragmento elemental a un emisario del Anillo de la Tierra en Forjaz, Ventormenta, El Exodar o Darnassus.‡Apportez l’Éclat élémentaire à un Émissaire du Cercle terrestre à Forgefer, à Hurlevent, dans l\'Exodar ou à Darnassus.‡将元素碎片交给铁炉堡、暴风城、埃索达或达纳苏斯的大地之环使者。‡將元素裂片帶給在鐵爐堡、暴風城、艾克索達或是達納蘇斯的陶土議會特使。',
  }
},
[25774] = {
  {
    'Ouro de tolo‡Золото дураков‡Katzengold‡빛 좋은 개살구‡No es oro todo lo que reluce‡Oro de tontos‡De l’or de pacotille‡愚人的金子‡愚人的黃金',
    nil,
    'Consiga 8 Minérios de Pirita de Agulhas.‡Соберите 8 глыб колчедановой руды с Тысячи Игл.‡Sammelt 8 Pyriterzbrocken.‡버섯구름 봉우리 황철석 광석 덩어리를 8개 모아야 합니다.‡Consigue 8 trozos de mena de pirita de Las Mil Agujas.‡Consigue 8 trozos de mena de pirita de Las Mil Agujas.‡Trouvez 8 Morceaux de minerai de pyrite des Mille pointes.‡收集8份大块千针石林燃铁矿石。‡收集8枚千針石林黃鐵礦簇。',
  }
},
[25775] = {
  {
    'Ouro de tolo‡Золото дураков‡Katzengold‡빛 좋은 개살구‡No es oro todo lo que reluce‡Oro de tontos‡De l’or de pacotille‡愚人的金子‡愚人的黃金',
    nil,
    'Consiga 8 Minérios de Pirita de Agulhas.‡Соберите 8 глыб колчедановой руды с Тысячи Игл.‡Sammelt 8 Pyriterzbrocken.‡버섯구름 봉우리 황철석 광석 덩어리를 8개 모아야 합니다.‡Consigue 8 trozos de mena de pirita de Las Mil Agujas.‡Consigue 8 trozos de mena de pirita de Las Mil Agujas.‡Trouvez 8 Morceaux de minerai de pyrite des Mille pointes.‡收集8份大块千针石林燃铁矿石。‡收集8枚千針石林黃鐵礦簇。',
  }
},
[25776] = {
  {
    'O fim de Sethria‡Гибель Сетрии‡Sethrias Untergang‡세스리아의 최후‡La muerte de Sethria‡La muerte de Sethria‡La chute de Sethria‡塞西莉亚的末日‡賽瑟莉亞的末日',
    nil,
    'Mate a dragonesa Sethria. Quando ela revelar a verdadeira forma, use o rojão sinalizador para chamar reforços.‡Уничтожьте Сетрию. Когда она примет драконье обличье, запустите сигнальную ракету, чтобы позвать подкрепление.‡Tötet den Drachen Sethria. Sobald sie ihre wahre Form offenbart, benutzt die Signalrakete, um Verstärkung zu rufen.‡세스리아를 처치해야 합니다. 세스리아가 본래의 모습을 드러내면, 신호 로켓을 발사하여 지원군을 요청하십시오!‡Asesina a la dragona Sethria. Cuando revele su verdadera forma, ¡tendrás que usar la bengala de señalización para pedir refuerzos!‡Asesina a la dragona Sethria. Cuando revele su verdadera forma, ¡tendrás que usar la bengala de señalización para pedir refuerzos!‡Tuez le dragon Sethria. Lorsqu’elle revêtira sa véritable forme, utilisez la fusée de détresse pour appeler des renforts !‡消灭巨龙塞西莉亚。当她显露原形时，你需要使用信号火箭来呼叫支援！‡消滅巨龍賽瑟莉亞。當她現出原形，你會需要使用信號火箭呼叫援軍!',
  }
},
[25777] = {
  {
    '‡Путь в Гавань Менетилов‡Vorwärts nach Menethil‡메네실로‡Hacia Menethil‡‡En route pour Menethil‡前往米奈希尔‡前進米奈希爾',
    nil,
    '‡Отнесите отчет Крепкой Стамески капитану Крепкому Кулаку в Гавань Менетилов.‡Liefert Fliesmeißels Bericht bei Hauptmann Starkfaust im Hafen von Menethil ab.‡슬랩치즐 보고서를 메네실 항구에 있는 경비대장 스타우트피스트에게 전달해야 합니다.‡Entrega el informe de Tallalosas al capitán Puñorrecio en el Puerto de Menethil.‡‡Donnez le Rapport de Cisepierre au Capitaine Rudepoing, dans le Port de Menethil.‡将硬凿的报告送交米奈希尔港的斯托菲队长。‡將斯拉奇索報告帶去米奈希爾港給斯托菲隊長。',
  }
},
[25778] = {
  {
    'Ouro falso por ouro negro‡Меняем фальшивое на черное‡Falsches Gold für schwarzes Gold‡검은 금 대신 가짜 금‡Oro falso por oro negro‡Oro falso por oro negro‡Or factice contre or noir‡假金子和黑金子‡假黃金換真黑金',
    nil,
    'Entregue o Palete de "Ouro" para o Khan Ablinh na Serra do Casco Fendido, que fica em Mil Agulhas.‡Отнесите блюдо "золота" хану Аблину на Утес Треснувшего Копыта в Тысяче Игл.‡Bringt die Palette voller "Gold" zu Khan Ablinh in den Spalthufanhöhen in Tausend Nadeln.‡"금" 더미를 버섯구름 봉우리의 갈래발굽 언덕에 있는 칸 애블린에게 가져가야 합니다.‡Entrega el palé de "oro" a Khan Ablinh en las Cumbres Pezuña Quebrada, en Las Mil Agujas.‡Entrega el palé de "oro" a Khan Ablinh en las Cumbres Pezuña Quebrada, en Las Mil Agujas.‡Livrez la Palette « d’or » au Khan Ablinh, dans les Hauteurs du Sabot fendu, dans les Mille pointes.‡将那盘“金子”送给千针石林裂蹄高地的阿布力可汗。‡到千針石林的裂蹄陵地將一整盤的「黃金」交給亞畢林可汗。',
  }
},
[25779] = {
  {
    'Ouro falso por ouro negro‡Меняем фальшивое на черное‡Falsches Gold für schwarzes Gold‡검은 금 대신 가짜 금‡Oro falso por oro negro‡Oro falso por oro negro‡Or factice contre or noir‡假金子和黑金子‡假黃金換真黑金',
    nil,
    'Entregue o Palete de "Ouro" ao Khan Blizh na Serra do Casco Fendido, que fica em Mil Agulhas.‡Отнесите блюдо "золота" хану Ближу на Утес Треснувшего Копыта в Тысяче Игл.‡Bringt die Palette voller "Gold" zu Khan Blizh in den Spalthufanhöhen in Tausend Nadeln.‡"금"더미를 버섯구름 봉우리의 갈래발굽 언덕에 있는 칸 블리즈에게 가져가야 합니다.‡Entrega el palé de "oro" a Khan Blizh en las Cumbres Pezuña Quebrada, en Las Mil Agujas.‡Entrega el palé de "oro" a Khan Blizh en las Cumbres Pezuña Quebrada, en Las Mil Agujas.‡Livrez la Palette « d’or » au Khan Blizh, dans les Hauteurs du Sabot fendu, dans les Mille pointes.‡将那盘“金子”送给千针石林裂蹄高地的阿布力可汗。‡到千針石林的裂蹄陵地將一整盤的「黃金」交給畢利茲可汗。',
  }
},
[25780] = {
  {
    'Ataque à Bastilha Menethil‡Штурм крепости Менетилов‡Angriff auf Burg Menethil‡메네실 요새 공격‡Asalto al Castillo de Menethil‡Asalto al Castillo de Menethil‡L\'assaut du donjon de Menethil‡米奈希尔城堡攻掠战‡襲擊米奈希爾城堡',
    nil,
    'Mate Horghast Piradélico.‡Убейте Хоргаста Вспышку Безумия.‡Tötet Horghast Loderwahn.‡호르가스트 플레어크레이즈드를 처치해야 합니다.‡Mata a Horghast Centellaloca.‡Mata a Horghast Centellaloca.‡Tuez Horghast Folembrase.‡杀死荷加斯特·狂焰。‡殺死荷加斯特‧爍狂。',
  }
},
[25781] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    nil,
  }
},
[25782] = {
  {
