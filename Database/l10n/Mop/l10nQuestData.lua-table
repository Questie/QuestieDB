},
[31054] = {
  {
    'Yalia Sábio Sussurro Destravada‡Unlocked Yalia Sagewhisper‡Yalia Weisenwisper freigeschaltet‡야리아 세이지위스퍼 해방‡Yalia Murmullo Sabio desbloqueada‡‡Déblocage de Yalia Sage Murmure‡解锁雅丽亚·圣言者‡',
