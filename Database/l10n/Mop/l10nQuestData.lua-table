},
[28741] = {
  {
    'Lorde Ascendente Obsidius‡Повелитель Перерожденных Обсидий‡Aszendentenfürst Obsidius‡승천 군주 옵시디우스‡Señor ascendiente Obsidius‡Señor ascendiente Obsidius‡Le seigneur ascendant Obsidius‡升腾者领主奥西迪斯‡卓越者統領奧希迪厄斯',
    nil,
    'Mate o Lorde Ascendente Obsidius.‡Расправьтесь с Повелителем Перерожденных Обсидием.‡Tötet Aszendentenfürst Obsidius.‡승천 군주 옵시디우스를 처치해야 합니다.‡Mata al señor ascendiente Obsidius.‡Mata al señor ascendiente Obsidius.‡Tuez le Seigneur ascendant Obsidius.‡杀死升腾者领主奥西迪斯。‡殺死卓越者統領奧希迪厄斯。',
  }
},
[28742] = {
  {
    'Shy-Rotam‡Ши-Ротам‡Shy-Rotam‡샤이로탐‡Shi-Rotam‡Shi-Rotam‡Shy-Rotam‡希洛塔姆‡希洛塔姆',
    nil,
    'Mate Shy-Rotam.‡Убейте Ши-Ротам.‡Tötet Shy-Rotam.‡샤이로탐을 처치해야 합니다.‡Mata a Shi-Rotam.‡Mata a Shi-Rotam.‡Tuez Shy-Rotam.‡杀死希洛塔姆。‡殺死希洛塔姆。',
  }
},
[28743] = {
  {
    'Artilheiro de cauda!‡Стрелок хвостовой пушки‡Heckschütze!‡후미포 발사!‡¡Armacola!‡¡Armacola!‡Mitrailleur de queue !‡机尾炮手！‡機尾槍手!',
    nil,
    'Derrube 15 Reco-recos de Schnottz.‡Сбейте 15 асов Шнотца.‡Schießt 15 Fliegerasse von Schnottz ab.‡슈노츠 조종사 15명을 격추해야 합니다.‡Derriba a 15 ases de Schnottz.‡Derriba a 15 ases de Schnottz.‡Abattez 15 As de Schnottz.‡击落15个司克诺兹王牌飞行员。‡射下15個舒諾茲王牌飛行員。',
  }
},
[28744] = {
  {
    'Cadê a sementinha que estava aqui?‡Вурдалакам не нравятся мои семена‡Ghule hassen meine Saat‡구울은 내 곡물을 싫어해‡Los necrófagos me tienen hasta las semillas‡Los necrófagos me tienen hasta las semillas‡Les goules haïssent mes graines‡谷物战僵尸‡殭屍討厭我的植物',
    nil,
    'Sobreviva a 2 Ondas Imensas de Zumbis.‡Выдержите 2 внушительных волны наступления зомби.‡Überlebt 2 riesige Zombiewellen.‡2번의 좀비 총공격에서 살아남아야 합니다.‡Sobrevive a 2 gigantescas oleadas de zombis.‡Sobrevive a 2 gigantescas oleadas de zombis.‡Survivez à 2 vagues massives de zombies.‡抵御2大波僵尸攻击。‡撐過2波猛烈攻勢的殭屍攻擊。',
  }
},
[28745] = {
  {
    'A fim das guinchadoras‡Крикуны в собственном соку‡Schmackhafte Kreischer‡날카로운 비명‡Deliciosos estridadores‡Deliciosos estridadores‡Passion hurlante‡鸣枭的挽歌‡尖銳的哭嚎',
    nil,
    'Mate 15 Guinchadoras de Hibérnia.‡Убейте 15 крикунов Зимних Ключей.‡Tötet 15 Winterquellkreischer.‡여명의 설원 비명올빼미 15마리를 처치해야 합니다.‡Mata 15 estridadores de Cuna del Invierno.‡Mata 15 estridadores de Cuna del Invierno.‡Tuez 15 Hurleuses de Berceau-de-l\'Hiver.‡杀死15只冬泉鸣枭。‡殺死15隻冬泉鳴梟。',
  }
},
[28746] = {
  {
    'Incursão às defesas inimigas‡Взломанная защита‡Ihre Verteidigung durchbrechen‡방어선 침투‡Penetrar en sus defensas‡Penetrar en sus defensas‡Infiltrer leur défense‡突破防御‡滲透防禦',
    nil,
    'Consiga acesso à Sala de Controle Titânica.‡Проникните в зал управления титанов.‡Verschafft Euch Zutritt zum Kontrollraum der Titanen.‡티탄 제어실로 들어가야 합니다.‡Consigue acceder a la sala de control titánica.‡Consigue acceder a la sala de control titánica.‡Accédez à la Salle de contrôle des titans.‡进入泰坦控制室。‡進入泰坦控制室。',
  }
},
[28747] = {
  {
    'Alguém armou a bombóbora‡Тыквомбы‡Kürbisbomben‡누군가 설치한 호박 폭탄‡Que alguien active la bomba de calabaza‡Que alguien active la bomba de calabaza‡La bombe citrouille, ça dérouille‡南瓜炸弹‡誰來放個南瓜炸彈',
    nil,
    'Sobreviva a 2 Ondas Imensas de Zumbis.‡Выдержите 2 внушительных волны наступления зомби.‡Überlebt 2 riesige Zombiewellen.‡2번의 좀비 총공격에서 살아남아야 합니다.‡Sobrevive a 2 gigantescas oleadas de zombis.‡Sobrevive a 2 gigantescas oleadas de zombis.‡Survivez à 2 vagues massives de zombies.‡抵御2大波僵尸攻击。‡撐過2波猛烈攻勢的殭屍攻擊。',
  }
},
[28748] = {
  {
    'O jardim dos esquecidos‡Посев мертвецов‡Rasen der lebenden Toten‡앞마당의 저주‡El jardín de los muertos‡El jardín de los muertos‡Gazon maudit‡亡者的草坪‡亡者草地',
    nil,
    'Derrote o Carcereiro Calmágua.‡Победите надзирателя Штиллеца‡Besiegt Aufseher Stillwasser.‡감독관 스틸워터를 쓰러뜨려야 합니다.‡Derrota al celador Aguaserena.‡Derrota al celador Aguaserena.‡Tuez le Gardien Eau-Plate.‡击败看守者斯蒂沃特。‡擊敗管理員斯蒂沃特。',
  }
},
[28749] = {
  {
    'A batalha por Andorhal‡Битва за Андорал‡Die Schlacht um Andorhal‡안돌할 전투‡La batalla por Andorhal‡La batalla por Andorhal‡La bataille pour Andorhal‡安多哈尔之战‡安多哈爾之戰',
    nil,
    'Fale com o Mago de Guerra Erallier para ser teleportado para Andorhal, que fica nas Terras Pestilentas Ocidentais. Ao chegar lá, apresente-se a Thassarian, em Andorhal.‡Обратитесь к боевому магу Эраллиеру, чтобы тот телепортировал вас в Андорал, что находится в Западных Чумных землях. Затем поговорите с Тассарианом в Андорале.‡Sprecht mit Kriegsmagier Erallier, um nach Andorhal in den Westlichen Pestländern teleportiert zu werden. Dann meldet Euch bei Thassarian in Andorhal.‡전쟁마법사 에랄리어와 대화하여 그가 만든 차원문을 통해 서부 역병지대의 안돌할로 이동하고 나서, 안돌할에 있는 타사리안에게 보고해야 합니다.‡Habla con el mago de guerra Erallier para que te teletransporte a Andorhal, en las Tierras de la Peste del Oeste. Luego preséntate ante Thassarian en el interior de Andorhal.‡Habla con el mago de guerra Erallier para que te teletransporte a Andorhal, en las Tierras de la Peste del Oeste. Luego preséntate ante Thassarian en el interior de Andorhal.‡Parlez au Mage de guerre Erallier pour être téléporté à Andorhal, dans les Maleterres de l’Ouest, puis présentez-vous à Thassarian une fois arrivé à destination.‡与战斗法师伊拉利尔交谈，传送到西瘟疫之地的安多哈尔。然后向安多哈尔城内的萨萨里安报到。‡和戰爭法師埃拉葉談話來傳送到西瘟疫之地的安多哈爾。然後在安多哈爾中向薩沙理安回報。',
  }
},
[28750] = {
  {
    'A batalha por Andorhal‡Битва за Андорал‡Die Schlacht um Andorhal‡안돌할 전투‡La batalla por Andorhal‡La batalla por Andorhal‡La bataille pour Andorhal‡安多哈尔之战‡安多哈爾之戰',
    nil,
    'Fale com o Arcanista Arman para ser teleportado para Andorhal, que fica nas Terras Pestilentas Ocidentais. Ao chegar lá, apresente-se a Koltirus Tecemorte em Andorhal.‡Обратитесь к чародею Арману, чтобы тот телепортировал вас в Андорал, что находится в Западных Чумных землях. Затем поговорите с Кольтирой Ткачом Смерти в Андорале.‡Sprecht mit Arkanist Arman, um nach Andorhal in den Westlichen Pestländern teleportiert zu werden. Dann meldet Euch bei Koltira Todesweber in Andorhal.‡신비술사 아르만과 대화하여 그가 만든 차원문을 통해 서부 역병지대의 안돌할로 이동하고 나서, 안돌할에 있는 콜티라 데스위버에게 보고해야 합니다.‡Habla con el arcanista Arman para que te teletransporte a Andorhal, en las Tierras de la Peste del Oeste. Luego preséntate ante Thassarian en el interior de Andorhal.‡Habla con el arcanista Arman para que te teletransporte a Andorhal, en las Tierras de la Peste del Oeste. Luego preséntate ante Thassarian en el interior de Andorhal.‡Parlez à l’Arcaniste Arman pour être téléporté à Andorhal, dans les Maleterres de l’Ouest, puis présentez-vous à Koltira Tissemort une fois arrivé à destination.‡与奥法师艾尔曼交谈，传送到西瘟疫之地的安多哈尔。然后向安多哈尔城内的库尔迪拉·织亡者报到。‡和秘法師阿爾曼談話來傳送到西瘟疫之地的安多哈爾。然後在安多哈爾中向寇爾提拉·亡織者回報。',
  }
},
[28751] = {
  {
    '‡Уход за садом‡Unkraut jäten‡정원 가꾸기‡Cuidar el jardín‡‡Jardinage intensif‡照料花园‡',
    nil,
    '‡Выдержите 2 внушительных волны наступления зомби.‡Überlebt 2 riesige Zombiewellen.‡2번의 좀비 총공격에서 살아남아야 합니다.‡Sobrevive a 2 gigantescas oleadas de zombis.‡‡Survivez à 2 vagues massives de zombies.‡抵御2大波僵尸攻击。‡',
  }
},
[28752] = {
  {
    '‡Непреодолимый натиск‡Unaufhaltsamer Ansturm‡‡Asalto imparable‡‡Assaut inexorable‡‡',
    nil,
    nil,
  }
},
[28753] = {
  {
    'Fazendo do jeito mais difícil‡Испорченная система‡Auf die harte Tour‡사서 하는 고생‡A lo bestia‡A lo bestia‡Méthode à la dure‡来硬的‡硬著頭皮來',
    nil,
    'Brann Barbabronze quer que você mate Isiset, Ammunae, Setesh e Rajh.‡По просьбе Бранна Бронзоборода убейте Изисет, Аммунаэ, Сетеша и Раджа.‡Brann Bronzebart will, dass Ihr Isiset, Ammunae, Setesh und Rajh tötet.‡브란 브론즈비어드가 이시세트, 아뮤내, 세테쉬, 라지를 처치해 달라고 했습니다.‡Brann Barbabronce quiere que mates a Isiset, Ammunae, Setesh y Rajh.‡Brann Barbabronce quiere que mates a Isiset, Ammunae, Setesh y Rajh.‡Brann Barbe-de-bronze veut que vous tuiez Isiset, Ammunae, Setesh et Rajh.‡布莱恩·铜须要你消灭伊希斯特、阿穆纳伊、塞特斯，以及拉夏。‡布萊恩·銅鬚要你殺死伊希賽特、安姆內、賽特胥和拉頡。',
  }
},
[28754] = {
  {
    '‡Битва жизни и смерти‡Der Kampf um Leben und Tod‡생명과 죽음의 전투‡Una batalla a vida o muerte‡‡Une bataille cruciale‡生命与死亡之战‡',
    nil,
    '‡Помогите Алекстразе в ее попытке одолеть Смертокрыла. Защитите пять колдовских камней жизни в Круге Жизни!‡Helft Alexstrasza bei dem Versuch, Todesschwinge zu töten. Beschützt die fünf Steine der Lebensbinderin, die den Kreis umgeben!‡‡Ayuda a Alexstrasza a intentar matar a Alamuerte. ¡Protege las piedras de la Protectora que rodean el círculo!‡‡Aidez Alexstrasza à tuer Aile de mort. Protégez les cinq Pierres lieuses-de-vie disposées le long du cercle !‡‡',
  }
},
[28755] = {
  {
    'Anais do Punho de Prata‡Летописи ордена Серебряной Длани‡Annalen der Silbernen Hand‡은빛 성기사단 연대기‡Crónicas de la Mano de Plata‡Crónicas de la Mano de plata‡Les annales de la Main d\'argent‡白银之手编年史‡白銀之手年鑑',
    nil,
    'Vá para Stratholme e recupere um dos volumes perdidos dos Anais do Punho de Prata.‡Разыщите утраченные тома летописей ордена Серебряной Длани в Стратхольме.‡Treibt einen verschollenen Band der Annalen der Silbernen Hand in Stratholme auf.‡스트라솔름에 있는 은빛 성기사단 연대기의 잃어버린 책을 회수해야 합니다.‡Recupera un volumen perdido de las Crónicas de la Mano de Plata en Stratholme.‡Recupera un volumen perdido de las Crónicas de la Mano de plata en Stratholme.‡Récupérez un tome perdu des Annales de la Main d\'argent.‡从斯坦索姆取回一卷遗失的白银之手编年史。‡從斯坦索姆取回一本失落的白銀之手年鑑。',
  }
},
[28756] = {
  {
    'Aberrações ósseas‡Костяные кадавры‡Entartung des Knochens‡뼈 돌연변이‡Aberraciones de hueso‡Aberraciones de hueso‡Les aberrations osseuses‡扭曲的骨骸‡畸形枯骨',
    nil,
    'Mate Ossorrange no Ossuário de Scolomântia.‡Прикончите Громоклина в склепе Некроситета.‡Tötet Blutrippe im Ossuarium von Scholomance.‡스칼로맨스의 납골당에 있는 들창엄니를 처치해야 합니다.‡Mata a Traquesangre en el Osario de Scholomance.‡Mata a Traquesangre en el Osario de Scholomance.‡Tuez Cliquettripes dans l\'Ossuaire de la Scholomance.‡在通灵学院的尸骨储藏所中杀死血骨傀儡。‡消滅通靈學院的儲藏所的血骨傀儡。',
  }
},
[28757] = {
  {
    'É hora de reagir‡Дать отпор!‡Schlagt sie zurück!‡격퇴!‡¡Rechazar el ataque!‡¡Rechazar el ataque!‡Repoussez-les !‡击退敌人！‡打退他們!',
    nil,
    'Mate 6 Worgs de Batalha Rocha Negra.‡Убейте 6 боевых воргов клана Черной горы.‡Tötet 6 Kampfworgs des Schwarzfels.‡검은바위 전투늑대 6마리를 처치해야 합니다.‡Mata a 6 huargos de batalla Roca Negra.‡Mata a 6 huargos de batalla Roca Negra.‡Tuez 6 Worgs de guerre rochenoires.‡杀死6只黑石战狼。‡殺死6隻黑石作戰座狼。',
  }
},
[28758] = {
  {
    'À sombra do destino‡Битва жизни и смерти‡Der Kampf um Leben und Tod‡생명과 죽음의 전투‡Una batalla a vida o muerte‡Una batalla a vida o muerte‡Une bataille cruciale‡生命与死亡之战‡生命與死亡之戰',
    nil,
    'Monte em um Vandragão Rubro e mate 8 Dracovultos do Crepúsculo.‡Оседлайте гранатового бойца. Уничтожьте 8 сумеречных темных драконов.‡Steigt auf einen Zinnoberroten Vorposten. Tötet 8 Zwielichtschattendrachen.‡주홍빛 선봉비룡에 올라탄 후, 황혼의 암흑비룡 8마리를 처치해야 합니다.‡Monta en un vanguardia Bermellón. Mata a 8 dracos de las Sombras Crepusculares.‡Monta en un vanguardia Bermellón. Mata a 8 dracos de las Sombras Crepusculares.‡Grimpez sur un Avant-garde de Vermillon. Tuez 8 Drakes de l\'ombre du Crépuscule.‡骑上朱红先锋。杀死8条暮光暗影幼龙。‡騎上一隻朱紅先鋒。殺死8隻暮光暗影飛龍。',
  }
},
[28759] = {
  {
    'Leões e cordeiros‡Волки и овцы‡Worgs im Schafspelz‡영리한 오크 첩자들‡Leones por corderos‡Leones por corderos‡Le lion et l\'agneau‡狮入羊口‡獅兵羊將',
    nil,
    'Mate 8 Espiões Rocha Negra.‡Расправьтесь с 8 шпионами клана Черной горы.‡Tötet 8 Spione des Schwarzfels.‡검은바위 첩보원 8명을 처치해야 합니다.‡Mata a 8 espías Roca Negra.‡Mata a 8 espías Roca Negra.‡Tuez 8 Espions rochenoires.‡消灭8名黑石间谍。‡殺死8名黑石間諜。',
  }
},
[28760] = {
  {
    'Vingança para Orsis‡Возмездие за Орсис‡Rache für Orsis‡오르시스를 위한 복수‡Venganza para Orsis‡Venganza para Orsis‡Vengez Orsis !‡为奥西斯复仇‡奧爾希斯的復仇',
    nil,
    'Mate Asaad.‡Прикончите Асаада.‡Tötet Asaad.‡아사드를 처치해야 합니다.‡Mata a Asaad.‡Mata a Asaad.‡Tuez Asaad.‡杀死阿萨德。‡殺死亞沙德。',
  }
},
[28761] = {
  {
    '‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡Honrar la llama‡Honorer la flamme‡祭拜这团火焰‡',
