[8686] = {
  {
    'Monte Alto, o Ancião‡Предок Высокогор‡Urahne Hohenberg‡장로 하이마운틴‡Altomonte el Ancestro‡Altomonte el Ancestro‡L\'Ancien Haute-montagne‡高山长者‡高山長者',
