},
[29712] = {
  {
    'Justiça da Horda‡По законам Орды‡Hordenjustiz‡‡Justicia de la Horda‡‡Justice de la Horde‡‡',
    nil,
    'Mate 15 Hozens na Queda do Cação Celeste. Uma‡Убейте 15 хозенов у обломков "Небесной акулы".‡Tötet 15 Ho-zen am Wrack der Himmelshai.‡‡Mata a 15 hozen en los Restos de El Tiburón Celeste.‡‡Tuez 15 Hozen à l\'Épave du Requin des Cieux.‡‡',
  }
},
[29713] = {
  {
    'Protocolo-padrão‡Стандартный протокол‡Standardverfahren‡‡Protocolo estándar‡‡La procédure standard‡‡',
    nil,
    'Junte 8 Solenoides Instáveis. Uma‡Соберите 8 нестабильных соленоидов.‡Tragt 8 instabile Solenoiden zusammen.‡‡Reúne 8 solenoides inestables.‡‡Rassemblez 8 Solénoïdes instables.‡‡',
  }
},
[29714] = {
  {
    'Serviço sujo!‡Мокрое дело!‡Nasse Sache!‡‡¡Trabajo húmedo!‡‡Liquidation !‡‡',
    nil,
    'Pegue 5 Glóbulos de Água do Lago da Canção Espiritual e combine-os com o Barril da Horda. Uma‡Соберите в Озере Поющих Духов 5 водяных гранул и поместите их в бочку Орды. Награда: .‡Sammelt 5 Wasserkugeln aus dem Geisterliedsee und kombiniert sie mit dem Hordefass.‡‡Consigue 5 glóbulos de agua del Lago Canto Espiritual y combínalos con el barril de la Horda.‡‡Récupérez 5 Globules d’eau au Lac Chantesprit, puis combinez-les avec le Tonneau de la Horde.‡‡',
  }
},
[29715] = {
  {
    'A bruxa da floresta‡Ведьма в лесу‡Die Hexe im Wald‡숲 속의 마녀‡La bruja del bosque‡‡La sorcière des bois‡林子里的巫婆‡',
    nil,
    'Encontre An Pelo ao Vento na estrada a norte da Cabana da Bruxa de Jade. Uma‡Найдите Ань Воздушный Мех на дороге, к северу от хижины Нефритовой ведьмы. Награда: .‡Findet An Windpelz an der Straße nördlich der Hütte der Jadehexe.‡옥의 마녀 오두막 북쪽 길에서 안 윈드퍼를 찾아야 합니다. 레벨 10 비취 숲‡Encuentra a An Pelaje Recio en el camino al norte de la Cabaña de la Bruja de Jade.‡‡Trouvez An Fourrure de Vent sur la route au nord de la Hutte de la Sorcière de jade.‡去青玉巫婆的小屋北边，找到路上的安·风裘。‡',
  }
},
[29716] = {
  {
    'A Dupla Aposta Hozen‡Снова к хозенам‡Die doppelte Ho-zen-Mutprobe‡왕겁쟁이‡Doble reto hozen‡‡Cap’ ou pas cap’ !‡胆比猢狲大‡',
    nil,
    'Resgate 6 Filhotes de Pandaren Assustados. Uma‡Спасите 6 испуганных юных пандаренов.‡Rettet 6 verängstigte Pandarenkinder.‡겁먹은 아기 판다렌 6명을 구출해야 합니다. 레벨 10 비취 숲‡Rescata a 6 cachorros pandaren asustados.‡‡Sauvez 6 Jeunes pandarens apeurés.‡营救6个受惊吓的熊猫人儿童。‡',
  }
},
[29717] = {
  {
    'Desce, gatinho!‡Лежать, киса!‡Braves Kätzchen!‡고양이 따위 죽어버려!‡¡Muere, minino!‡‡Couché, minou !‡教训小猫！‡',
    nil,
    'Destrua 8 Guardiões de Jade. Uma‡Уничтожьте 8 нефритовых стражей.‡Vernichtet 8 Jadewächter.‡비취 수호자 8마리를 처치해야 합니다. 레벨 10 비취 숲‡Destruye 8 guardianes de jade.‡‡Détruisez 8 Gardiens de jade.‡消灭8个青玉守护者。‡',
  }
},
[29718] = {
  {
    'Uma gota de vacina é melhor que um litro de remédio‡Шестнадцать унций профилактики‡Ein halber Liter Schutz‡‡Un barril de líquido preventivo‡‡Mieux vaut ne pas les prévenir que guérir‡‡',
    nil,
    'Use o Barril de Água Espiritualizada para apagar os quatro focos de incêndio perto dos Destroços do Zepelim. Uma‡Возьмите бочку осененной духами воды и потушите четыре очага возгорания рядом с обломками дирижабля.‡Nutzt das Geist-berührte Wasserfass, um die vier Feuer in der Nähe des Zeppelinwracks zu löschen.‡‡Utiliza el barril de agua tocada por los espíritus para extinguir los cuatro fuegos cerca de los restos del zepelín.‡‡Utilisez le Tonneau d’eau touchée par les esprits pour éteindre les quatre incendies près des Débris de zeppelin.‡‡',
  }
},
[29719] = {
  {
    'Duvideodó, bruxa velha é sua avó‡На спор‡Die doppelte Ho-zen-Mutprobe‡‡Doble reto hozen‡‡Même pas cap’ !‡‡',
    nil,
    'Examine 7 Estátuas de Jade Realísticas a sul da Cabana da Bruxa de Jade. Uma‡Осмотрите 7 правдоподобных нефритовых статуй к югу от дома Нефритовой ведьмы.‡Untersucht 7 lebensechte Jadestatuen südlich der Hütte der Jadehexe.‡‡Examina 7 estatuas de jade realistas al sur de la Cabaña de la Bruja de Jade.‡‡Examinez 7 Statues de jade plus vraies que nature au sud de la Hutte de la Sorcière de jade.‡‡',
  }
},
[29720] = {
  {
    'A Bruxa de Jade‡Нефритовая ведьма‡Die Jadehexe‡‡La Bruja de Jade‡‡La sorcière de jade‡‡',
    nil,
    'Fale com a Viúva Pataverde na Cabana da Bruxa de Jade. Uma‡Поговорите с вдовой Зеленой Лапой в хижине Нефритовой ведьмы.‡Sprecht mit Witwe Grünpfote bei der Hütte der Jadehexe.‡‡Habla con la viuda Zarpa Verde en la Cabaña de la Bruja de Jade.‡‡Parlez avec la Veuve Patte Verte à la Hutte de la Sorcière de jade.‡‡',
  }
},
[29721] = {
  {
    'Uma oferenda‡Приношение‡Gefallen gegen Gefallen‡‡Una ofrenda‡‡Une offrande‡‡',
    nil,
    'A Viúva Pataverde pediu que você lhe traga um peixe do tanque que fica atrás da Cabana da Bruxa de Jade, na Floresta de Jade. Uma‡Вдова Зеленая Лапа попросила вас поймать для нее рыбу в пруде, который находится за домом Нефритовой ведьмы в Нефритовом лесу.‡Witwe Grünpfote hat Euch gebeten, ihr einen Fisch aus dem Teich hinter der Hütte der Jadehexe im Jadewald zu bringen.‡‡La viuda Zarpa Verde te ha pedido que le lleves un pez del lago que hay detrás de la Cabaña de la Bruja de Jade, en el Bosque de Jade. Otorga  como recompensa.‡‡La Veuve Patte Verte vous a demandé de lui rapporter un poisson de l’étang derrière la Hutte de la Sorcière de jade, dans la Forêt de jade.‡‡',
  }
},
[29722] = {
  {
    'Uma lição de coragem‡Урок мужества‡Eine Lektion in Sachen Mut‡용기가 남긴 교훈‡Una lección de valentía‡‡Une leçon de bravoure‡‡',
    nil,
    'Derrote 8 Trapaceiros Folhosos a sul da Cabana da Bruxa de Jade. Uma‡Победите 8 лиственных плутов к югу от дома Нефритовой ведьмы.‡Besiegt 8 blättrige Trickster südlich der Hütte der Jadehexe.‡옥의 마녀 오두막 남쪽에 있는 Leafy Trickster 8마리를 처치해야 합니다. 레벨 10 비취 숲‡Acaba con 8 tramposos selváticos al sur de la Cabaña de la Bruja de Jade.‡‡Tuez 8 Entourloupeurs feuillus au sud de la Hutte de la Sorcière de jade.‡‡',
  }
},
[29723] = {
  {
    'A Bruxa de Jade‡Нефритовая ведьма‡Die Jadehexe‡옥의 마녀‡La Bruja de Jade‡‡La sorcière de jade‡青玉巫婆‡',
    nil,
    'Derrote a Bruxa de Jade. Uma‡Победите Нефритовую ведьму.‡Besiegt die Jadehexe.‡옥의 마녀를 처치해야 합니다. 레벨 10 비취 숲‡Derrota a la Bruja de Jade.‡‡Triomphez de la Sorcière de jade.‡击败青玉巫婆。‡',
  }
},
[29724] = {
  {
    'Funeral no mar‡Похороны в открытом море‡Seebestattung‡‡Entierro en el mar‡‡Funérailles en mer‡‡',
    nil,
    'Leve 3 Cadáveres da Vanguarda do Grito Infernal à Catapulta Imóvel nos Destroços do Cação Celeste. Uma‡Отнесите тела 3 передовых бойцов к неподвижной катапульте у обломков "Небесной акулы".‡Bringt die 3 Leichen der Vorhut zum stationären Katapult am Wrack der Himmelshai.‡‡Lleva 3 cadáveres de vanguardias a la catapulta inmóvil, en los Restos de El Tiburón Celeste.‡‡Apportez 3 Cadavres de l’avant-garde jusqu’à la Catapulte immobile à l’Épave du Requin des cieux.‡‡',
  }
},
[29725] = {
  {
    'Relatório da AVIN: Fogo do céu‡Отчет ШРУ: небесный огонь‡SI:7 Bericht: Feuer vom Himmel‡SI:7 보고: 하늘에서 떨어진 불벼락‡Informe del IV:7: fuego en el cielo‡‡Rapport du SI:7 - Le feu vient du ciel‡军情七处报告：居高临下‡',
    nil,
    'Ouça o relatório de Sully. Uma‡Выслушайте доклад Салли.‡Hört Euch Sullys Bericht an.‡설리의 보고를 들어야 합니다. 레벨 10 비취 숲‡Escucha el informe de Sully.‡‡Écoutez le rapport de Sully.‡听苏利报告。‡',
  }
},
[29726] = {
  {
    'Relatório da AVIN: Nativos hostis‡Отчет ШРУ: враждебные аборигены‡SI:7 Bericht: Feindliche Eingeborene‡SI:7 보고: 적대적 원주민‡Informe del IV:7: nativos hostiles‡‡Rapport du SI:7 - Indigènes hostiles‡军情七处报告：敌对土著‡',
    nil,
    'Ouça o relatório do Pequeno Lu. Uma‡Выслушайте отчет Малыша Лу.‡Hört Euch Klein-Lus Bericht an.‡꼬마 루의 보고를 들어야 합니다. 레벨 10 비취 숲‡Escucha el informe del pequeño Lu.‡‡Écoutez le rapport de Petit Lu.‡听小卢报告。‡',
  }
},
[29727] = {
  {
    'Relatório da AVIN: Não faça prisioneiros‡Отчет ШРУ: пленных не брать‡SI:7 Bericht: Keine Gefangenen‡SI:7 보고: 몰살‡Informe del IV:7: no hagáis prisioneros‡‡Rapport du SI:7 - Pas de prisonniers‡军情七处报告：不留俘虏‡',
    nil,
    'Ouça o relatório de Amber Kearnen. Uma‡Выслушайте доклад Эмбер Кирнен.‡Hört Euch Amber Kearnens Bericht an.‡앰버 켈넌의 보고를 들어야 합니다. 레벨 10 비취 숲‡Escucha el informe de Amber Kearnen.‡‡Écoutez le rapport d’Amber Kearnen.‡听取安玻·吉尔妮的报告。‡',
  }
},
[29728] = {
  {
    'Evidências bombásticas‡Взрывные работы‡Beweismittelvernichtung‡폭발적인 증거‡Prueba explosiva‡‡Une preuve explosive‡‡',
    nil,
    'Coloque 4 Dinamites Improvisadas perto do navio naufragado na Desventura do Safira. As Dinamites Improvisadas devem ficar a pelo menos 10 metros de distância umas das outras.‡Разместите 4 заряда самодельного динамита рядом с затонувшим кораблем на Сапфировом берегу. Расстояние между зарядами должно составлять не менее 10 метров.‡Platziert 4 improvisierte Sprengladungen in der Nähe des Wracks der Herold. Die improvisierten Sprengladungen müssen mindestens 10 Meter voneinander entfernt liegen.‡사파이어의 끝자락에 있는 가라앉은 배 근처에 급조한 다이너마이트 4개를 설치해야 합니다. 다이너마이트 사이의 거리는 최소 10미터 이상 떨어져야 합니다.‡Coloca 4 paquetes de dinamita improvisada cerca del barco hundido en el Cabo del Zafiro. Debes colocarlos con una distancia entre ellos de al menos 10 metros.‡‡Placez 4 Dynamites de fortune près de l’épave du navire au Déclin du Saphir. Les Dynamites de fortune doivent être placées à au moins 10 mètres l’une de l’autre.‡‡',
  }
},
[29729] = {
  {
    'Sem rastros‡Без следа‡Spurlos verschwunden‡‡Ni rastro‡‡Plus une trace‡‡',
    nil,
    'Aperte o detonador para apagar todos os indícios restantes. Uma‡Активируйте детонатор, чтобы уничтожить все улики.‡Drückt den Auslöser, um die verbleibenden Beweismittel zu vernichten.‡‡Acciona el detonador para eliminar cualquier prueba que quede.‡‡Enclenchez le Détonateur pour effacer les preuves restantes.‡‡',
  }
},
[29730] = {
  {
    'Relatório dos batedores: Nativos hostis‡Отчет разведки: враждебные аборигены‡Späherbericht: Feindliche Eingeborene‡정찰 보고: 적대적 원주민‡Informe de exploración: nativos hostiles‡‡Rapport des éclaireurs : des indigènes hostiles‡斥候报告：敌对土著‡',
    nil,
    'Ouça o relatório de Riko. Uma‡Выслушайте доклад Рико.‡Hört Euch Rikos Bericht an.‡리코의 보고를 들어야 합니다. 레벨 10 비취 숲‡Escucha el informe de Riko.‡‡Écoutez le rapport de Riko.‡听里克报告。‡',
  }
},
[29731] = {
  {
    'Relatório dos batedores: No caminho certo‡Отчет разведки: на правильном пути‡Späherbericht: Auf der richtigen Fährte‡정찰 보고: 옳은 길‡Informe de exploración: tras la pista correcta‡‡Rapport des éclaireurs : sur la bonne piste‡斥候报告：步入正轨‡',
    nil,
    'Ouça o relatório de Kiryn. Uma‡Выслушайте доклад Кирин.‡Hört Euch Kiryns Bericht an.‡키린의 보고를 들어야 합니다. 레벨 10 비취 숲‡Escucha el informe de Kiryn.‡‡Écoutez le rapport de Kiryn.‡听琪麟报告。‡',
  }
},
[29732] = {
  {
    'Tudo que desce tem que subir!‡Что упало, то не пропало‡Was runtergeht, muss wieder rauf!‡추락하는 것은 꼬리가 있다‡¡Todo lo que baja, sube!‡‡Ce qui descend doit remonter !‡‡',
    nil,
    'Use o Distribuidor Goblínico de Módulos Teleguiados perto da Raiz Exposta para recuperar os suprimentos.ATENÇÃO: Cada uso requer um Cabo de Planador.‡Добудьте припасы с помощью гоблинского автотранспортера рядом с Обнажившимся корнем.Примечание: для каждого использования необходим один закрученный хвост горного летуна.‡Benutzt den Goblindrohnenspender an der Freigelegten Wurzel, um Vorräte zu bergen.HINWEIS: Für jede Benutzung ist ein Klippengleiterschwanz erforderlich.‡드러난 뿌리 근처에 있는 고블린 운반로봇 분사기를 사용하여 보급품을 회수해야 합니다.주의: 사용할 때마다 절벽천둥매 꼬리 하나가 사용됩니다.‡Utiliza el dispensador de zánganos goblin que hay al lado de la raíz expuesta para recuperar los suministros.ATENCIÓN: por cada uso será necesaria una cola de deslizador del risco.‡‡Utilisez le Distributeur de drones gobelins près de la Racine visible pour récupérer des fournitures.REMARQUE : chaque utilisation nécessite une Queue de glisseur des falaises.‡‡',
  }
},
[29733] = {
  {
    'Relatório da AVIN: Perdidos nas matas‡Отчет ШРУ: заблудившиеся в лесу‡SI:7 Bericht: Verloren im Wald‡SI:7 보고: 숲 속에서 길을 잃다‡Informe del IV:7: perdidos en el bosque‡‡Rapport du SI:7 - Perdu dans les bois‡军情七处报告：丛林迷失‡',
    nil,
    'Ouça o relatório de Rell. Uma‡Выслушайте доклад Релла.‡Hört Euch Rells Bericht an.‡렐의 보고를 들어야 합니다. 레벨 10 비취 숲‡Escucha el informe de Rell.‡‡Écoutez le rapport de Rell.‡听利尔报告。‡',
  }
},
