},
[30304] = {
  {
    'Duro feito pedra‡Крепкие, как камень‡Hart wie ein Stein‡돌처럼 단단한‡Duro como una roca‡‡Dur comme la pierre‡坚硬如石‡',
    nil,
    'Destrua 10 Estátuas Mogus. Uma‡Разрушьте 10 статуй могу.‡Zerstört 10 Mogustatuen.‡모구 석상 10개를 파괴해야 합니다. 레벨 1 영원꽃 골짜기‡Destruye 10 estatuas mogu.‡‡Détruisez 10 Statues mogu.‡摧毁10座魔古石雕。‡',
  }
},
[30305] = {
  {
    'Ele saiba o que está fazendo‡Он знает, что делает‡Er weiß, was er tut‡허는 다 보고 있다‡Sabe lo que se hace‡‡He sait ce qu’il fait‡‡',
    nil,
    'Atraia 8 inimigos para as Armadilhas Envenenadas de He. Uma‡Заманите 8 противников в отравленные ловушки Хэ.‡Lockt 8 Feinde in Hees Giftfallen.‡적 8명을 허의 독 덫으로 유인해야 합니다. 레벨 1 영원꽃 골짜기‡Atrae a 8 enemigos hasta las trampas de veneno de Zheng.‡‡Attirez 8 ennemis dans les Pièges empoisonnés de He.‡‡',
  }
},
[30306] = {
  {
    'O ringue de combate‡Ринг‡Der Kampfring‡전투장‡El ring de batalla‡‡L’arène‡大竞技场‡',
    nil,
    'Derrote 20 Aprendizes Shado-Pan no Ringue de Batalha. Uma‡Победите на ринге 20 учеников Шадо-Пан.‡Besiegt 20 Shado-Pan-Auszubildende im Kampfring.‡전투장에서 음영파 수련생 20명을 꺾어야 합니다. 레벨 30 영원꽃 골짜기‡Derrota a 20 alumnos del Shadopan en el ring de batalla.‡‡Triomphez de 20 Recrues pandashan dans l’Arène.‡在大竞技场中击败20名影踪派受训者。‡',
  }
},
[30307] = {
  {
    'A vigia eterna‡Вечный дозор‡Die Ewige Wacht‡끊임없는 경계‡La vigilia eterna‡‡La garde éternelle‡永不休眠‡',
    nil,
    'Mate 8 mogus Shao-Tien no Terraço Dourado. Uma‡Убейте 8 могу Шао-Тень на Золотой террасе.‡Tötet 8 Mogu der Shao-Tien auf der Goldenen Terrasse.‡황금 정원에서 샤오티엔 모구 8명을 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 8 mogu Shao-Tien en La Terraza Áurea.‡‡Tuez 8 Mogu shao-tien sur la Terrasse d’Or.‡在金色平台击败8个韶天魔古族人。‡',
  }
},
[30308] = {
  {
    'Quilen Duro de Pedra‡Каменный цийлинь‡Steinharte Qilen‡돌처럼 단단한 기렌‡Quilen duros como piedras‡‡Quilen dur comme la pierre‡岗岩魁麟‡',
    nil,
    'Mate 6 Quílens de Granito. Uma‡Убейте 6 гранитных цийлиней.‡Tötet 6 Granitqilen.‡화강암 기렌 6마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 6 quilen de granito.‡‡Tuez 6 Quilen de granite.‡击败6个岗岩魁麟。‡',
  }
},
[30309] = {
  {
    'A pedra da vez‡Твердость камня‡In Stein gemeißelt‡단단한 돌‡Grabado en piedra‡‡Chute de pierres‡嵌入石中‡',
    nil,
    'Destrua 6 Efígies Mogus. Uma‡Уничтожьте 6 изваяний могу.‡Zerstört 6 Mogueffigien.‡모구 입상 6개를 파괴해야 합니다. 레벨 30 영원꽃 골짜기‡Destruye 6 tallas mogu.‡‡Détruisez 6 Effigies mogu.‡摧毁6座魔古石雕。‡',
  }
},
[30310] = {
  {
    'Céus de trovão‡Гром в небесах‡Giganten der Lüfte‡우레와 같이 울리는 하늘‡Cielo atronador‡‡Des serpents dans l’azur‡漫天雷火‡',
    nil,
    'Mate 3 Serpentes Subjugadas. Uma‡Убейте 3-х покоренных змеев.‡Tötet 3 bezwungene Schlangen.‡예속된 운룡 3마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a tres dragones subyugados.‡‡Tuez 3 Serpents subjugués.‡击败3只被制服的翔龙。‡',
  }
},
[30311] = {
  {
    'Padrões elevados‡Выше знамена!‡Gehobene Standarte‡전투 깃발을 드높이‡Confalones y a lo loco‡‡Lotus adoré‡高标准‡',
    nil,
    'Erga 6 Estandartes do Lótus Dourado. Uma‡Поднимите 6 знамен Золотого Лотоса.‡Richtet 6 Standarten des Goldenen Lotus wieder auf.‡Golden Lotus Standard 6개를 일으켜 세워야 합니다. 레벨 1 영원꽃 골짜기‡Levanta 6 confalones del Loto Dorado.‡‡Plantez 6 Étendards du Lotus doré.‡竖起6面金莲军旗。‡',
  }
},
[30312] = {
  {
    'Uma chance de lutar outra vez‡Второй шанс‡Eine zweite Chance‡또 한 번의 기회‡Segunda oportunidad‡‡Second départ‡第二次生命‡',
    nil,
    'Cure 6 Defensores Feridos. Uma‡Исцелите 6 раненых защитников.‡Heilt 6 verwundete Verteidiger.‡부상당한 방어병 6명을 치유해야 합니다. 레벨 30 영원꽃 골짜기‡Sana a 6 defensores heridos.‡‡Soignez 6 Défenseurs blessés.‡治疗6个受伤的防御者。‡',
  }
},
[30313] = {
