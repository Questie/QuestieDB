},
[1947] = {
  {
    'Jornada ao pântano‡Путь в болото‡Reise in die Marschen‡습지대로의 여행‡Viaje al pantano‡Viaje al pantano‡Voyager vers le Marais‡沼泽之旅‡沼澤之旅',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화해야 합니다.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談話。',
  }
},
[1948] = {
  {
    'Itens do poder‡Волшебные предметы‡Gegenstände der Macht‡강력한 물건‡Objetos de poder‡Objetos de poder‡Les Objets de Puissance‡强大的物品‡強大的物品',
    nil,
    'Traga 1 Jade e a Morácea Carregada por Raio para Tabetha no Pântano Vadeoso.‡Принесите 1 нефрит и шипастый жезл Молний Табете в Пылевые топи.‡Bringt 1 Stück Jade und den vom Blitz aufgeladenen Dornbusch zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 비취 1개와 벼락 맞은 나뭇가지를 가져가야 합니다.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Apporter 1 Jade et le Roncier de foudre à Tabetha, dans le marécage d\'Âprefange.‡将电能草莓和1颗翡翠交给尘泥沼泽的塔贝萨。‡將電能草莓和1顆碧玉交給塵泥沼澤的塔貝薩。',
  }
},
[1949] = {
  {
    'Segredos ocultos‡Великие тайны‡Verborgene Geheimnisse‡숨겨진 비밀‡Secretos escondidos‡Secretos escondidos‡Des secrets cachés‡隐藏的秘密‡隱藏的秘密',
    nil,
    'Fale com Tirth, o Mago, no Salar Cintilante.‡Поговорите с волхвом Тиртом на Мерцающей равнине.‡Sprecht mit Magus Tirth in der Schimmernden Ebene.‡소금 평원에 있는 학자 틸스와 대화해야 합니다.‡Habla con Magus Tirth en El Desierto de Sal.‡Habla con Magus Tirth en El Desierto de Sal.‡Parler au magus Tirth dans les Salines.‡和闪光平原的大法师提尔斯谈一谈。‡和閃光平原的魔導師提爾斯談話。',
  }
},
[1950] = {
  {
    'Tente a sorte‡Волшебное слово‡Der Knüller schlechthin‡주문 알아오기‡Santo y seña‡Santo y seña‡Trouver le Scoop‡解封咒语‡解封咒語',
    nil,
    'Encontre a frase que abre o cofre de Tirth e fale novamente com ele.‡Узнайте волшебные слова, отпирающие сейф Тирта и вернитесь к Тирту.‡Bringt den Satz für Tirths Geldkassette in Erfahrung und kehrt zu Tirth zurück.‡틸스의 금고를 여는 주문을 알아서 틸스에게 가야 합니다.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Trouvez l\'Incantation pour ouvrir le coffre-fort de Tirth, puis retournez voir Tirth.‡找到提尔斯保险箱的解封咒语，然后向提尔斯复命。‡找到提爾斯保險箱的解封咒語，然後向提爾斯覆命。',
  }
},
[1951] = {
  {
    '‡Обряды власти‡Rituale der Macht‡마력의 의식‡Rituales de Poder‡Rituales de Poder‡Rituels du Pouvoir‡能量仪祭‡能量儀式',
    nil,
    '‡Принесите книгу "Обряды власти" Табете в Пылевых топях.‡Bringt das Buch \'Rituale der Macht\' zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 마력의 의식을 가져가야 합니다.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Apportez le livre des « Rituels du pouvoir » à Tabetha dans le marécage d\'Âprefange.‡将《能量仪祭》交给尘泥沼泽的塔贝萨。‡',
  }
},
[1952] = {
  {
    '‡Магический жезл‡Der Zauberstab des Magiers‡‡Varitas de mago‡Varitas de mago‡La baguette du mage‡法师的魔杖‡',
    nil,
    '‡Поговорите с Табетой по завершении ритуала.‡Sprecht nach ihrem Ritual mit Tabetha.‡‡Habla con Tabetha cuando termine su ritual.‡Habla con Tabetha cuando termine su ritual.‡Parler à Tabetha après son rituel.‡等塔贝萨的仪式完成后，和她谈一谈。‡',
  }
},
[1953] = {
  {
    'Retorno ao pântano‡Возвращение на болота‡Rückkehr in die Marschen‡다시 습지대로‡Regresa a la Marisma‡Regresa a la Marisma‡Retourner dans le Marais‡返回沼泽‡回到沼澤',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화해야 합니다.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談話。',
  }
},
[1954] = {
  {
    'O Orbe Infernal‡Сфера подземного огня‡Die Höllenkugel‡지옥의 보주‡El orbe infernal‡El orbe infernal‡L\'orbe infernal‡地狱火宝珠‡煉獄火寶珠',
    nil,
    'Leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Принесите сферу Подземного огня Табете из Пылевых топей.‡Bringt eine Höllenkugel zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 지옥의 보주를 가져가야 합니다.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Apporter un Orbe infernal à Tabetha dans le marécage d\'Âprefange.‡将一颗地狱火宝珠交给尘泥沼泽的塔贝萨。‡將一顆煉獄火寶珠交給塵泥沼澤的塔貝薩。',
  }
},
[1955] = {
  {
    '‡Поединок с демоном‡Die Austreibung‡‡El exorcismo‡El exorcismo‡L\'Exorcisme‡驱除魔鬼‡',
    nil,
    '‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡‡Mata al demonio del orbe y luego habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuez le démon de l\'Orbe, puis parlez à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡',
  }
},
[1956] = {
  {
    'Poder em Uldaman‡Сила Ульдамана‡Macht in Uldaman‡울다만의 마력원천‡Poder en Uldaman‡Poder en Uldaman‡L\'énergie d\'Uldaman‡奥达曼的能量源‡奧達曼的能量源',
    nil,
    'Recupere uma Fonte de Energia de Obsidiana e leve-a para Tabetha no Pântano Vadeoso.‡Добудьте обсидиановый источник силы и принесите его Табете в Пылевые топи.‡Beschafft Euch eine Obsidiankraftquelle und bringt sie in die Düstermarschen zu Tabetha.‡흑요석 마력원천을 구해서 먼지진흙 습지대에 있는 타베사에게 가져가야 합니다.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Récupérer une Source d\'énergie en obsidienne et la rapporter à Tabetha dans le marécage d\'Âprefange.‡找到一个黑曜石能量源，将其交给尘泥沼泽的塔贝萨。‡找到一個黑曜石能量源，將其交給塵泥沼澤的塔貝薩。',
  }
},
[1957] = {
  {
    '‡Волнолов маны‡Manawogen‡‡Oleadas de maná‡Oleadas de maná‡Les éruptions de mana‡法力怒灵‡',
    nil,
    '‡Убейте 12 волноловов маны за отведенное время.‡Vernichtet 12 Manawogen innerhalb des Zeitlimits.‡‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Tuer 12 Eruptions de mana dans la limite de temps imposée.‡在限定时间内杀死12只法力怒灵。‡',
  }
},
[1958] = {
  {
    '‡Небесная сила‡Himmlische Macht‡‡Poder celestial‡Poder celestial‡L\'énergie céleste‡苍穹之力‡',
    nil,
    nil,
  }
},
[1959] = {
  {
    'Apresente-se a Anastácia‡Задание Анастасии‡Meldung bei Anastasia‡아나스타샤에게 보고‡Preséntate ante Anastasia‡Preséntate ante Anastasia‡Rendre compte à Anastasia‡向安娜斯塔西娅报告‡向安娜斯塔西婭報告',
    nil,
    'Fale com Anastácia Cordato.‡Поговорите с Анастасией Хартвелл.‡Sprecht mit Anastasia Hirschbrunn.‡아나스타샤 하트웰과 대화해야 합니다.‡Habla con Anastasia Hartwell.‡Habla con Anastasia Hartwell.‡Allez voir Anastasia Hartwell.‡和安娜斯塔西娅·哈特威尔谈一谈。‡和安娜斯塔西婭·哈特威爾談話。',
  }
},
[1960] = {
  {
    'Investigue a Loja de Alquimia‡Лавка алхимика‡Untersuchungen im Alchemistenladen‡연금술 상점 조사‡Investiga la tienda de alquimia‡Investiga la tienda de alquimia‡Enquêter dans le magasin de l\'Alchimiste‡调查炼金店‡調查鍊金店',
    nil,
    'Obtenha um Cantochão da Manifestação e um Baú de Cofres de Contenção atrás de Anastácia Cordato. Traga 3 Cofres de Contenção Cheios, o Baú de Cofres de Contenção e o Cantochão da Manifestação para Anastácia na Cidade Baixa.‡Возьмите свиток заклятия Проявления и ящик с шкатулками-духоловками за спиной у Анастасии Хартвелл. Принесите 3 заполненных шкатулки-духоловки, ящик со шкатулками духоловками и заклинание Проявления Анастасии в Подгород.‡Besorgt eine Inkantation der Manifestation und eine Truhe mit Verwahrungskästen von Anastasia Hirschbrunn. Bringt 3 gefüllte Verwahrungskästen, die Truhe mit Verwahrungskästen sowie die Inkantation der Manifestation zu Anastasia in Unterstadt.‡아나스타샤 하트웰의 뒤에 있는 현신의 주문서와 속박의 상자를 획득하십시오. 언더시티에 있는 아나스타샤 하트웰에게 채워진 속박의 상자 3개와, 속박의 상자, 현신의 주문서를 가져가야 합니다.‡Detrás de Anastasia Hartwell encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas, el cofre de arcas de contención y el canto de manifestación a Anastasia en Entrañas.‡Detrás de Anastasia Hartwell encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas, el cofre de arcas de contención y el canto de manifestación a Anastasia en Entrañas.‡Obtenir un Chant de Manifestation et une Caisse de Coffres de retenue placée derrière Anastasia Hartwell. Apporter 3 Coffres de retenue remplis, la Caisse de Coffres de retenue et l\'Incantation de Manifestation à Anastasia Hartwell à Fossoyeuse.‡从安娜斯塔西娅·哈特威尔身后拿取一根显形卷轴以及一盒封灵箱。将3个装满的封灵箱交给幽暗城的安娜斯塔西娅·哈特威尔。‡從安娜斯塔西婭·哈特威爾身後拿取一根顯形卷軸以及一盒封靈箱。將3個裝滿的封靈箱交給幽暗城的安娜斯塔西婭·哈特威爾。',
  }
},
[1961] = {
  {
    'Em busca de materiais‡Сбор материалов‡Materialsammlung‡재료 수집‡Recolección de materiales‡Recolección de materiales‡Rassembler les matériaux‡收集原料‡收集原料',
    nil,
    'Leve 10 peças de Linho e 6 Gemas de Mana de Dalaran para Josefo Gregório.‡Принесите 10 кусков льна и 6 даларанских самоцветов маны Джозефу Грегориану.‡Bringt 10 Leinenstoff und 6 Manaedelsteine aus Dalaran zu Josef Gregorian.‡조셉 그레고리안에게 리넨 옷감 10장과 달라란 마나석 6개를 가져가야 합니다.‡Consigue 10 trozos de paño de lino y 6 gemas de maná de Dalaran para Josef Gregorian.‡Consigue 10 trozos de paño de lino y 6 gemas de maná de Dalaran para Josef Gregorian.‡Apporter 10 morceaux d\'Etoffe de lin et 6 Gemmes de mana de Dalaran à Josef Gregorian.‡把10块亚麻布和6块达拉然法力宝石带给乔瑟夫·格里高利。‡把10塊亞麻布和6塊達拉然法力寶石帶給喬瑟夫·格里高利。',
  }
},
[1962] = {
  {
    '‡Одеяние из огненной чароткани‡Roben des Zauberfeuers‡‡Toga de fuego de hechizo‡Toga de fuego de hechizo‡Robe du feu-sorcier‡魔焰长袍‡',
    nil,
    nil,
  }
},
[1963] = {
  {
    'A Mão Despedaçada‡Изувеченная Длань‡Die Zerschmetterte Hand‡으스러진 손‡Mano Destrozada‡Mano Destrozada‡La Main brisée‡碎手氏族‡破碎之手氏族',
    nil,
    'Mate Tazan e leve a Algibeira dele para Therzok no Antro das Sombras, que fica em Orgrimmar.‡Убейте Тазана и принесите его сумку Терзоку в Расселину Теней в Оргриммаре.‡Tötet Tazan und bringt seinen Ranzen zu Therzok in der Kluft der Schatten in Orgrimmar.‡타잔을 죽이고 그의 가방을 오그리마의 어둠의 틈에 있는 테르조크에게 가져가야 합니다.‡Mata a Tazan y llévale su cartera a Therzok al Circo de las Sombras, en Orgrimmar.‡Mata a Tazan y llévale su cartera a Therzok al Circo de las Sombras, en Orgrimmar.‡Tuer Tazan et apporter sa Sacoche à Therzok, à la Faille de l\'Ombre à Orgrimmar.‡杀死塔赞，把他的背包带给奥格瑞玛暗影裂口的瑟祖克。‡殺死塔贊，把他的背袋帶給奧格瑪暗影裂口的瑟祖克。',
  }
},
[1978] = {
  {
    '‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡死亡杀手‡亡靈哨兵',
    nil,
    '‡Отнесите гроссбух Андрона Вариматасу в Зал Темной Госпожи в Подгороде.‡Bringt Androns Geschäftsbuch zu Varimathras in der Halle der Dunklen Fürstin in Unterstadt.‡‡Entrégale el libro de contabilidad de Andron a Varimathras, que está en la Cámara de la Dama Oscura en Entrañas.‡Entrégale el libro de contabilidad de Andron a Varimathras, que está en la Cámara de la Dama Oscura en Entrañas.‡Livrer le Grand Livre d\'Andron à Varimathras au Hall de la Dame noire à Fossoyeuse.‡将安德隆的账本交给幽暗城黑暗女王大厅里的瓦里玛萨斯。‡',
  }
},
[1998] = {
  {
    'Fernão Thatros‡Фенвик Татрос‡Fenwick Thatros‡펜윅 타트로스‡Fenwick Thatros‡Fenwick Thatros‡Fenwick Thatros‡芬维克·萨托斯‡芬維克·薩托斯',
    nil,
    'Mate Fernão Thatros e leve a cabeça dele para Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Убейте Фенвика Татроса и принесите его голову Менниту Каркаду в Квартал Разбойников Подгорода.‡Tötet Fenwick Thatros und bringt seinen Kopf zu Mennet Carkad im Schurkenviertel von Unterstadt.‡펜윅 타트로스를 처치하고 그 증거로 그의 머리카락을 언더시티의 도적 지구에 있는 메넷 칼카드에게 가져가야 합니다.‡Mata a Fenwick Thatros y llévale su cabeza a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Mata a Fenwick Thatros y llévale su cabeza a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Tuer Fenwick Thatros et rapporter sa Tête à Mennet Carkad dans le Quartier des Voleurs de Fossoyeuse.‡杀掉芬维克·萨托斯，把他的头颅交给幽暗城潜行者区的米奈特·卡加德。‡殺掉芬維克·薩托斯，把他的頭顱交給幽暗城盜賊區的米奈特·卡加德。',
  }
},
[1999] = {
  {
    'Ferramentas do ofício‡Профессиональные инструменты‡Werkzeuge des Handwerks‡거래의 도구‡Herramientas de comercio‡Herramientas de comercio‡Les outils du métier‡交易工具‡交易工具',
    nil,
    'Encontre o Relatório Situacional de Dalaran e devolva-o a Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Отыщите отчет о состоянии Даларана и отдайте его Менниту Каркаду в Квартале Разбойников Подгорода.‡Sucht den Statusbericht von Dalaran und bringt ihn zu Mennet Carkad im Schurkenviertel von Unterstadt.‡달라란 상황 보고서를 찾아 언더시티의 도적 지구에 있는 메넷 칼카드에게 가져가야 합니다.‡Encuentra el informe de estado de Dalaran y devuélveselo a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Encuentra el informe de estado de Dalaran y devuélveselo a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Trouver le Rapport de situation de Dalaran et le remettre à Mennet Carkad dans le Quartier des Voleurs de Fossoyeuse.‡找到达拉然形势报告，把它交给幽暗城潜行者区的米奈特·卡加德。‡找到達拉然形勢報告，把它交給幽暗城盜賊區的米奈特·卡加德。',
  }
},
[2000] = {
  {
    '‡Рокар Тень Клинка‡Rokar Klingenschatten‡로카르 블레이드섀도‡Rokar Filosombra‡Rokar Filosombra‡Rokar Ombrelame‡洛卡·刃影‡洛卡·刃影',
    nil,
    '‡Поговорите с Рокаром Тенью Клинка в Дуротаре.‡Sprecht mit Rokar Klingenschatten in Durotar.‡‡Habla con Rokar Filosombra en Durotar.‡Habla con Rokar Filosombra en Durotar.‡Aller voir Rokar Ombrelame en Durotar.‡‡',
  }
},
[2018] = {
  {
    '‡Испытание Рокара‡Rokars Test‡‡La prueba de Rokar‡La prueba de Rokar‡L\'épreuve de Rokar‡‡',
    nil,
    '‡Убейте надзирателя Глибби и отдайте его свисток Рокару Тени Клинка в Дуротаре.‡Tötet Vorarbeiter Glibby und bringt seine Pfeife zu Rokar Klingenschatten in Durotar.‡‡Mata al vigía Glibby y llévale su silbato a Rokar Filosombra a Durotar.‡Mata al vigía Glibby y llévale su silbato a Rokar Filosombra a Durotar.‡Tuer le Surveillant Glibby et apporter son Sifflet à Rokar Ombrelame en Durotar.‡‡',
  }
},
[2019] = {
  {
    '‡Предметы торговли‡Werkzeuge des Handwerks‡거래의 도구‡Herramientas de comercio‡Herramientas de comercio‡Les outils du métier‡业务工具‡商用工具',
    nil,
    '‡Вернитесь к Терзоку в расселину Теней в Оргриммаре.‡Kehrt zu Therzok in der Kluft der Schatten in Orgrimmar zurück.‡‡Habla con Therzok en el Circo de las Sombras de Orgrimmar.‡Habla con Therzok en el Circo de las Sombras de Orgrimmar.‡Retourner voir Therzok à la Faille de l\'Ombre à Orgrimmar.‡‡',
  }
},
[2038] = {
  {
    'Os suprimentos desaparecidos do Gomez‡Пропавшее снаряжение Бинглза‡Bingles\' verschwundene Werkzeuge‡사라진 빙글스의 물건들‡Suministros de Bingles‡Suministros de Bingles‡Les fournitures perdues de Bingles‡宾格斯的补给品‡賓格斯的補給品',
    nil,
    'Encontre e devolva os suprimentos do Gomez:|n|nChave de Boca do Gomez, Chave de Fenda do Gomez, Martelo do Gomez e Detona-cuca do Gomez.‡Найдите и верните Бинглзу гаечный ключ Бинглза, отвертку Бинглза, молот Бинглза и сорвиголовку Бинглза.‡Sucht Bingles\' Werkzeuge und bringt sie ihm zurück. Es sind:|n|nBingles\' Schraubenschlüssel, Bingles\' Schraubendreher, Bingles\' Hammer und Bingles\' Superspreng.‡빙글스의 물건들을 찾아서 돌아와야 합니다.|n|n빙글스의 스패너, 빙글스의 드라이버, 빙글스의 망치, 빙글스의 깡그리싸그리 폭탄을 찾아야 합니다.‡Localiza las herramientas de Bingles y devuélveselas:|n|nllave inglesa, destornillador, martillo y cartucho.‡Localiza las herramientas de Bingles y devuélveselas:|n|nllave inglesa, destornillador, martillo y cartucho de explosivos.‡Trouver et rapporter à Bingles son matériel :|n|nLa Clé de Bingles, le Tournevis de Bingles, le Marteau de Bingles et le Capsuleur soufflant de Bingles.‡找回宾格斯的装备：|n$宾格斯的气压炸弹、宾格斯的扳手、宾格斯的榔头和宾格斯的螺丝起子。‡找回賓格斯的裝備:|n$賓格斯的氣壓炸彈、賓格斯的扳手、賓格斯的榔頭和賓格斯的螺絲起子。',
  }
},
[2039] = {
  {
    'Cadê o Bingles?‡Найти Бинглза‡Sucht Bingles‡빙글스 찾기‡Encuentra a Bingles‡Encuentra a Bingles‡Trouvez Bingles‡寻找宾格斯‡尋找賓格斯',
    nil,
    'Encontre Gomez Plosivo em Loch Modan.‡Найдите Бинглза Подрывайстера в Лок Модане.‡Sucht Bingles Blastenheimer am Loch Modan.‡모단 호수에서 빙글스 블라스텐하이머를 찾아야 합니다.‡Encuentra a Bingles Pimpampum en Loch Modan.‡Encuentra a Bingles Pimpampum en Loch Modan.‡Trouver Bingles Explonheimer, au Loch Modan.‡去洛克莫丹寻找宾格斯。‡去洛克莫丹尋找賓格斯·布萊頓海默。',
  }
},
[2040] = {
  {
    'Ataque subterrâneo‡Битва под землей‡Unterirdischer Angriff‡지하 공격‡Asalto subterráneo‡Asalto subterráneo‡Assaut souterrain‡地底突袭‡地底突襲',
    nil,
    'Recupere o Engrenotreco Gnomo das Minas Mortas e devolva a Shoni, a Shilenchiosa, em Ventobravo.‡Принесите Шони Молшунье в Штормград зубчатый спрек-механизм гномов из Мертвых копей.‡Holt das Gnoamsprenkelspross aus den Todesminen und bringt es Shoni der Schtillen in Sturmwind.‡죽음의 폐광에서 노암 톱니구동장치를 입수해 스톰윈드에 있는 쇼니에게 가져가야 합니다.‡Recupera la dentrituradora goblin de Las Minas de la Muerte y devuélvesela a Shoni la Shilenshiosha en Ventormenta.‡Recupera la Dentrituradora goblin de Las Minas de la Muerte y devuélveselo a Shoni la Shilenshiosha, en Ventormenta.‡Récupérez l\'Indicateur Gnoam dans les mortemines et rapportez-le à Shoni la Silencieuse, à Hurlevent.‡从死亡矿井中带回小型高能发动机，将其带给暴风城矮人区中的沉默的舒尼。‡從死亡礦坑中帶回小型高能發動機，將其帶給暴風城矮人區中的沉默的舒尼。',
  }
},
[2041] = {
  {
    'Fale com Shoni‡Разговор с Шони‡Sprecht mit Shoni‡쇼니와의 대화‡Habla con Shoni‡Habla con Shoni‡Allez voir Shoni‡沉默的舒尼‡沉默的舒尼',
    nil,
    'Speak with Shoni the Shilent at the Dwarven District in Stormwind.‡Поговорите с Шони Молшуньей в Квартале Дворфов в Штормграде.‡Sprecht mit Shoni der Schtillen im Zwergendistrikt von Sturmwind.‡스톰윈드의 드워프 지구에 있는 쇼니와 대화해야 합니다.‡Habla con Shoni la Shilenshiosha en el Distrito de los Enanos en Ventormenta.‡Habla con Shoni la Shilenshiosha en el Distrito de los Enanos en Ventormenta.‡Aller voir Shoni la Shilencieuse au Quartier des Nains, à Hurlevent.‡去暴风城的矮人区去，和那里的沉默的舒尼谈一谈。‡在暴風城的矮人區和沉默的舒尼談話。',
  }
},
[2058] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
