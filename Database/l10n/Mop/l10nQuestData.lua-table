},
[1791] = {
  {
    'O vigia dos ventos‡Страж Ветра‡Der Windbehüter‡바람의감시자‡El Vigía del viento‡El Vigía del viento‡La Vigie des vents‡捕风者‡捕風者',
    nil,
    'Fale com Bath\'rah, o Vigia dos Ventos.‡Поговорите с Бат\'ра Стражем Ветра.‡Sprecht mit Bath\'rah dem Windbehüter.‡바람의감시자 바스라와 대화해야 합니다.‡Habla con Bath\'rah el Vigía del viento.‡Habla con Bath\'rah el Vigía del viento.‡Parler à Bath\'rah la Vigie des vents.‡和捕风者巴斯拉谈一谈。‡和『觀風者』巴斯拉談話。',
  }
},
[1792] = {
