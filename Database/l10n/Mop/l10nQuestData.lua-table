    nil,
  }
},
[27122] = {
  {
    '‡С огоньком‡Fix und fertig und doch nicht bereit‡위험한 열기‡Emocionados pero no del todo preparados‡‡Tout feu tout flamme‡小心火灾，谨慎前进‡',
    nil,
    '‡Убейте великого посла Огнехлыста и поставьте об этом в известность командира Грузного Кулака в Стальгорне.‡Tötet den höchsten Botschafter Flammenschlag und informiert Kommandant Klippenfaust in Eisenschmiede.‡대사자 화염채찍을 처치하고 아이언포지에 있는 사령관 크래그피스트에게 알려야 합니다.‡Mata al gran embajador Latifuego e informa al comandante Puñopeñasco en Forjaz.‡‡Massacrez le Grand ambassadeur Cinglefouet et informez-en le Commandant Combepoing à Forgefer.‡杀死弗莱拉斯总大使，并将胜利消息告知铁炉堡的指挥官峭拳。‡',
  }
},
[27123] = {
  {
    'Geodomo, o reino da terra‡Подземье, мир земли‡Tiefenheim, Reich der Erde‡대지의 영역, 심원의 영지‡Infralar, reino de la tierra‡Infralar, reino de la tierra‡Le Tréfonds, royaume de la Terre‡深岩之洲，土地的国度‡地深之源，地之國度',
    nil,
    'Monte na Mantícora de Aggra e atravesse a brecha na Voragem. Ao chegar ao outro lado, fale com Maruut Atapedras.‡Садитесь на виверну Аггры и летите к разлому в Водовороте. Когда окажетесь на другой стороне, поговорите с Маруутом Камневязом.‡Springt auf Aggras Wyvern und fliegt in die Bresche am Mahlstrom. Wenn Ihr auf der anderen Seite ankommt, sprecht mit Maruut Steinbinder.‡아그라의 와이번에 올라타고 혼돈의 소용돌이에 있는 균열 안으로 들어가십시오. 다른 편에 도착하면 마루트 스톤바인더와 대화해야 합니다.‡Monta en el dracoleón de Aggra y vuela hasta la brecha en La Vorágine. Una vez que estés al otro lado, habla con Maruut Amarrapiedra.‡Monta en el dracoleón de Aggra y vuela hasta la brecha en La Vorágine. Una vez que estés al otro lado, habla con Maruut Amarrapiedra.‡Grimpez sur la wyverne d\'Aggra et survolez la brèche dans le Maelström. Quand vous serez de l’autre côté, allez voir Maruut Lieur-de-Pierre.‡跳上阿格娜的双足飞龙，飞进大漩涡的缺口。到达另一侧后跟玛鲁特·缚石谈一谈。‡乘上阿格拉的雙足翼龍，飛進位於大漩渦的破口。一旦你抵達另外一側，去和瑪魯特‧縛石者說話。',
  }
},
[27124] = {
  {
    'Negócios pendentes‡Неоконченное дело Гордоков‡Die offene Rechnung der Gordok‡고르독 일 마무리‡Asunto Gordok sin finiquitar‡Asunto Gordok sin finiquitar‡Affaires inachevées chez les Gordok‡未完的戈多克事务‡戈多克巨魔的事務',
    nil,
    'Fale com o Guarda Mol\'dar no Gládio Cruel.‡Поговорите со стражником Мол\'даром в Забытом Городе.‡Sprecht mit Wache Mol\'dar in Düsterbruch.‡혈투의 전장에 있는 경비병 몰다르와 대화해야 합니다.‡Habla con el guardia Mol\'dar en La Masacre.‡Habla con el guardia Mol\'dar en La Masacre.‡Parlez au Garde Mol\'dar dans Hache-Tripes.‡与厄运之槌的卫兵摩尔达交谈。‡在厄運之槌和守魏摩爾達談話。',
  }
},
[27125] = {
  {
    'Rei dos Gordok‡Король Гордока‡König der Gordok‡고르독의 왕‡Rey de los Gordok‡Rey de los Gordok‡Le roi des Gordok‡戈多克的国王‡戈多克之王',
    nil,
    'Mate o Rei Gordok.‡Убейте короля Гордока.‡Tötet König Gordok.‡왕 고르독을 처치해야 합니다.‡Mata al rey Gordok.‡Mata al rey Gordok.‡Tuez le Roi gordok.‡杀死戈多克大王。‡殺死戈多克大王。',
  }
},
[27126] = {
  {
    'Entrega urgente‡Срочная доставка‡Eilige Lieferung‡특급 배송‡Entrega urgente‡Entrega urgente‡Livraison d’urgence‡火急快递‡急件快遞',
    nil,
    'Entregue as Peças de Catapulta para Cimo Petráspera no Front Partido, que fica no Geodomo.‡Доставьте детали катапульты Пику Камнемолу на Разбитую передовую, что в Подземье.‡Liefert die Katapultteile bei Spitz Schleifstein an der Zerrissenen Front in Tiefenheim ab.‡심원의 영지의 무너진 전초지에 있는 피크 그라인드스톤에게 투석기 부품을 전달해야 합니다.‡Entrega las piezas de catapulta a Pico Muelepiedra en el Frente Fracturado en Infralar.‡Entrega las piezas de catapulta a Pico Muelepiedra en el Frente Fracturado en Infralar.‡Apportez des Pièces de catapulte à Pic Lemeuleur sur le Front Ravagé, dans le Tréfonds.‡给深岩之洲碎裂前线的皮克·磨石送去投石车零件。‡將投石車零件送到地深之源裡的崩裂的前線給聘克‧磨石。',
  }
},
[27127] = {
  {
    '‡С огоньком‡Fix und fertig und doch nicht bereit‡위험한 열기‡Emocionados pero no del todo preparados‡‡Tout feu tout flamme‡小心火灾，谨慎前进‡',
    nil,
    '‡Убейте великого посла Огнехлыста и поставьте об этом в известность кровавого стража Канга в Оргриммаре.‡Tötet den höchsten Botschafter Flammenschlag und meldet Euch bei Blutwache Kang in Orgrimmar.‡대사자 화염채찍을 처치하고 오그리마에 있는 혈투사 캉에게 알려야 합니다.‡Mata al gran embajador Latifuego e informa al guardia de sangre Kang en Orgrimmar.‡‡Massacrez le Grand ambassadeur Cinglefouet et informez-en le Garde de sang Kang à Orgrimmar.‡‡',
  }
},
[27128] = {
  {
    'Rei dos Gordok‡Король Гордока‡König der Gordok‡고르독의 왕‡Rey de los Gordok‡Rey de los Gordok‡Le roi des Gordok‡戈多克的国王‡戈多克之王',
    nil,
    'Mate o Rei Gordok.‡Убейте короля Гордока.‡Tötet König Gordok.‡왕 고르독을 처치해야 합니다.‡Mata al rey Gordok.‡Mata al rey Gordok.‡Tuez le Roi gordok.‡杀死戈多克大王。‡殺死戈多克大王。',
  }
},
[27129] = {
  {
    'Fungus Lenhatorta‡Спасение Криводрева‡Wucherborke retten‡굽이나무 구하기‡Salvar a Alabeo‡Salvar a Alabeo‡Sauver Crochebois‡拯救扭木‡拯救扭木',
    nil,
    'Fale com Fungus Lenhatorta.‡Поговорите с Фургусом Криводревом.‡Sprecht mit Furgus Wucherborke.‡굽이나무 퍼거스와 대화해야 합니다.‡Habla con Furgus Alabeo.‡Habla con Furgus Alabeo.‡Parlez à Furgus Crochebois.‡与费尔古斯·扭木交谈。‡和佛格斯·扭木交談。',
