[10355] = {
  {
    'Carne definhada‡Иссохшее тело‡Siechendes Fleisch‡말라버린 생물들‡Carne marchita‡Carne marchita‡Chair flétrie‡枯萎的血肉‡枯萎的肉體',
    nil,
    'Colete 5 Amostras de Hidra Fenecida e 5 Amostras Definhadas de Senhor do Brejo e leve-as para Ruam, em Telredor.‡Соберите 5 образцов опаленной гидры и 5 образцов ткани высохшего болотника и принесите их Руаму в Телредор.‡Sammelt 5 Proben einer verdurstenden Hydra und 5 Proben eines siechenden Sumpflords und bringt sie zu Ruam in Telredor.‡바짝 마른 히드라 견본 5개와 말라 비틀어진 수렁군주 견본 5개를 수집한 후 텔레도르에 있는 루암에게 가져가야 합니다.‡Recolecta 5 muestras de hidra sedienta y 5 muestras de señor de la marisma marchito y llévaselas a Ruam a Telredor.‡Recolecta 5 muestras de hidra sedienta y 5 muestras de señor de la marisma marchito y llévaselas a Ruam a Telredor.‡Réunissez 5 Échantillons d\'hydre desséchée et 5 Échantillons de seigneur-tourbe flétri et apportez-les à Ruam à Telredor.‡将5份干燥的多头蛇样本和5份枯萎的沼泽领主样本交给泰雷多尔的鲁埃姆。‡收集5個乾乾枯的多頭蛇樣本和5個枯萎的泥沼領主樣本，並且將它們帶回泰倫多爾交給洛安瑪。',
  }
},
