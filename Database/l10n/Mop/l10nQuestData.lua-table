},
[28778] = {
  {
    'Estatueta de javali quebrada‡Разбитая статуэтка медведя‡Zerbrochene Figur eines Keilers‡부서진 멧돼지 조각상‡Figurilla de jabalí rota‡Figurilla de jabalí rota‡La figurine de sanglier cassée‡破损的野猪雕像‡破損的野豬刻像',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários.‡Почините разбитую статуэтку, применив необходимые умения и материалы.‡Repariert die zerbrochene Figur mithilfe Eurer Fertigkeit und den richtigen Materialien.‡보석세공 기술과 적절한 재료로 부서진 조각상을 수리해야 합니다.‡Repara la figurilla rota con tu habilidad y materiales.‡Repara la figurilla rota con tu habilidad y materiales.‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡用你的技巧與材料來修復破損的刻像。',
  }
},
[28779] = {
  {
    'Bem longe de casa‡До дома далече‡Weit von zuhause entfernt‡집에서 저 멀리‡Lejos de casa‡Lejos de casa‡Bien loin de chez soi‡长途跋涉的回家路‡遠離家園',
    nil,
    'Obtenha o Coração da Grã-Vizir Ertan.‡Раздобудьте сердце великого визиря Эртан.‡Beschafft das Herz von Großwesir Ertan.‡대장로 에르탄의 심장을 획득해야 합니다.‡Consigue el corazón del gran visir Ertan.‡Consigue el corazón del gran visir Ertan.‡Procurez-vous le Cœur du grand vizir Erthan‡获得大宰相埃尔坦之核。‡取得首相伊爾丹的心臟。',
  }
},
[28780] = {
  {
    'Vila Norte precisa de você‡В бой!‡Stürzt Euch in die Schlacht!‡전투에 참전하라!‡¡Únete a la batalla!‡¡Únete a la batalla!‡Rejoignez la bataille !‡加入战斗！‡加入戰局!',
    nil,
    'Fale novamente com o Sargento Vilém atrás da Abadia de Vila Norte, que fica na Floresta de Elwynn.‡Явитесь к сержанту Виллему, находящемуся за Аббатством Североземья.‡Meldet Euch bei Stellvertreter Willem hinter der Abtei von Nordhain im Wald von Elwynn.‡엘윈 숲의 북녘골 수도원 뒤편에 있는 하사관 윌렘에게 보고해야 합니다.‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡Présentez-vous au Sergent Willem derrière l\'Abbaye de Comté-du-Nord, dans la Forêt d\'Elwynn.‡向艾尔文森林北郡修道院后的维里副队长报到。‡到艾爾文森林後面的北郡修道院找維里中士。',
  }
},
[28781] = {
  {
    'Alvos de oportunidade‡Неплановые цели‡Gelegenheitsziele‡기회의 대상‡Objetivos a tiro‡Objetivos a tiro‡Des objectifs fortuits‡抓住机会‡可能的目標',
    nil,
    'Mate o General Husam e 2 Capitães Jurados.‡Ликвидируйте генерала Хусама и 2 присягнувших капитанов.‡Tötet General Husam und 2 eingeschworene Hauptmänner.‡굳은서약 대장 2마리와 장군 후삼을 처치해야 합니다.‡Mata al general Husam y a 2 capitanes Prestajuramentos.‡Mata al general Husam y a 2 capitanes Prestajuramentos.‡Tuez le général Husam et 2 Capitaines liés par le serment.‡杀死胡辛姆将军和2个神誓副官。‡消滅胡薩姆將軍和2個誓語隊長。',
  }
},
[28782] = {
  {
    'A lenda do pássaro lendário‡Легендарная птица‡Ein legendärer Vogel‡전설의 새‡Un pájaro legendario‡Un pájaro legendario‡Un oiseau de légende‡传说之鸟‡傳說中的鳥',
    nil,
    'Mate a Uh-ripilante.‡Убейте Смертоуха.‡Tötet Höllenschuhu.‡지옥부엉이를 처치해야 합니다.‡Mata a Ululaverno.‡Mata a Ululaverno.‡Éliminez Belzhibou.‡杀死地狱尖啸。‡殺死地獄貓頭鷹。',
  }
},
[28783] = {
  {
    'A fonte do poder deles‡Источник их силы‡Die Quelle ihrer Macht‡그들의 힘의 근원‡La fuente de su poder‡La fuente de su poder‡La source de leur puissance‡他们的力量之源‡它們的力量源頭',
    nil,
    'Mate Siamat.‡Сразите Сиамата.‡Tötet Siamat.‡시아마트를 처치해야 합니다.‡Mata a Siamat.‡Mata a Siamat.‡Tuez Siamat.‡杀死希亚玛特。‡消滅希亞梅特。',
  }
},
[28784] = {
  {
    'Vila Norte precisa de você‡В бой!‡Stürzt Euch in die Schlacht!‡전투에 참전하라!‡¡Únete a la batalla!‡¡Únete a la batalla!‡Rejoignez la bataille !‡加入战斗！‡加入戰局!',
    nil,
    'Fale novamente com o Sargento Vilém atrás da Abadia de Vila Norte, que fica na Floresta de Elwynn.‡Явитесь к сержанту Виллему, находящемуся за Аббатством Североземья.‡Meldet Euch bei Stellvertreter Willem hinter der Abtei von Nordhain im Wald von Elwynn.‡엘윈 숲의 북녘골 수도원 뒤편에 있는 하사관 윌렘에게 보고해야 합니다.‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡Présentez-vous au Sergent Willem derrière l\'Abbaye de Comté-du-Nord, dans la Forêt d\'Elwynn.‡向艾尔文森林北郡修道院后的维里副队长报到。‡到艾爾文森林後面的北郡修道院找維里中士。',
