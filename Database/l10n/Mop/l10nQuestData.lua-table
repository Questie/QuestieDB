},
[32004] = {
  {
    'Um desafio digno: líder aéreo Ner\'onok‡Серьезное испытание: командующий флангом Нер\'онок‡Eine würdige Herausforderung: Schwadronsführer Ner\'onok‡보람찬 도전: 편대사령관 네르오노크‡Un desafío digno: líder de escuadrón Ner\'onok‡‡Un défi de taille : le chef d’escadre Ner’onok‡艰难的挑战：翼虫首领尼诺洛克‡',
    nil,
    'Completar o Modo Desafio do Cerco ao Templo Niuzao. Uma‡Пройдите Осаду храма Нюцзао в режиме испытания.‡Schließt den Niuzaotempel im Herausforderungsmodus ab.‡니우짜오 사원 공성전투 도전 모드를 완료해야 합니다. 레벨 35 니우짜오 사원 공성전투‡Completa el Asedio del Templo de Niuzao en modo desafío.‡‡Terminez le Siège du temple de Niuzao en mode Défi.‡完成围攻砮皂寺挑战。‡',
  }
},
[32005] = {
  {
    'Um desafio digno: Durand‡Серьезное испытание: Дюранд‡Eine würdige Herausforderung: Durand‡보람찬 도전: 듀란드‡Un desafío digno: Durand‡‡Un défi de taille : Durand‡艰难的挑战：杜兰德‡',
    nil,
    'Completar o Modo Desafio do Monastério Escarlate. Uma‡Пройдите Монастырь Алого ордена в режиме испытания.‡Schließt das Scharlachrote Kloster im Herausforderungsmodus ab.‡붉은십자군 수도원 도전 모드를 완료해야 합니다. 레벨 35 붉은십자군 수도원‡Completa el Monasterio Escarlata en modo desafío.‡‡Terminez le Monastère Écarlate en mode Défi.‡完成血色修道院挑战。‡',
  }
},
[32006] = {
  {
    'Um desafio digno: Tecechamas Koegler‡Серьезное испытание: ткач пламени Кеглер‡Eine würdige Herausforderung: Flammenwirker Koegler‡보람찬 도전: 화염술사 쾨글러‡Un desafío digno: tejedor de fuego Koegler‡‡Un défi de taille : le tisseur de flammes Koegler‡艰难的挑战：织焰者孔格勒‡',
    nil,
    'Completar o Modo Desafio dos Salões Escarlates. Uma‡Пройдите Залы Алого ордена в режиме испытания.‡Schließt die Scharlachroten Hallen im Herausforderungsmodus ab.‡붉은십자군 전당 도전 모드를 완료해야 합니다. 레벨 35 붉은십자군 전당‡Completa las Cámaras Escarlata en modo desafío.‡‡Terminez les Salles Écarlates en mode Défi.‡完成血色大厅挑战。‡',
  }
},
[32007] = {
  {
    'Um desafio digno: Umbromestre Gandling‡Серьезное испытание: темный магистр Гандлинг‡Eine würdige Herausforderung: Dunkelmeister Gandling‡‡Un desafío digno: Maestro oscuro Gandling‡‡Un défi de taille : le sombre maître Gandling‡艰难的挑战：黑暗院长加丁‡',
    nil,
    'Completar o Modo Desafio de Scolomântia. Uma‡Пройдите Некроситет в режиме испытания.‡Schließt Scholomance im Herausforderungsmodus ab.‡‡Completa Scholomance en modo desafío.‡‡Terminez la Scholomance en mode Défi.‡完成通灵学院挑战。‡',
  }
},
[32008] = {
  {
    'Audreia Répibãrne‡Одри Бернхеп‡Marlene Trichdie‡오드리 번헵‡Audrey Burnhep‡‡Audrey Burnhep‡奥黛丽·伯恩赫普‡',
    nil,
    'Apresente-se a Audreia Répibãrne em Ventobravo. Uma‡Обратитесь к Одри Бернхеп в Штормграде. это‡Meldet Euch bei Marlene Trichdie in Sturmwind.‡스톰윈드에 있는 오드리 번헵에게 보고해야 합니다. 레벨 1‡Ve a ver a Audrey Burnhep en Ventormenta.‡‡Allez vous présenter à Audrey Burnhep à Hurlevent.‡去暴风城向奥黛丽·伯恩赫普报到。‡',
  }
},
[32009] = {
  {
    'Varzok‡Варзок‡Varzok‡바르조크‡Varzok‡‡Varzok‡瓦佐克‡',
    nil,
    'Apresente-se a Varzok em Orgrimmar. Uma‡Поговорите с Варзоком в Оргриммаре. это‡Meldet Euch bei Varzok in Orgrimmar.‡오그리마에 있는 바르조크에게 보고해야 합니다. 레벨 1‡Ve a ver a Varzok en Orgrimmar.‡‡Présentez-vous à Varzok à Orgrimmar.‡去奥格瑞玛向瓦佐克报到。‡',
