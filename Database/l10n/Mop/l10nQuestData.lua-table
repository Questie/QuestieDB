},
[31655] = {
  {
    'Rastreamento de Mishi 1‡Mishi Tracking 1‡Mishi Tracking 1‡미스 추적 1‡Mishi Tracking 1‡‡Suivi de Mishi 1‡追踪米师 1‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31656] = {
  {
    'A ameaça no sul‡Угроза на юге‡Die Bedrohung im Süden‡남쪽의 위협‡Amenaza en el sur‡‡Menace au sud‡南方的威胁‡',
    nil,
    'Fale com a Arqueira Li Tsz-Wai no Espinhaço da Serpente. Uma‡Поговорите с лучницей Ли на Змеином Хребте.‡Sprecht mit Bogenmeisterin Li auf dem Schlangenrücken.‡용의 척추에 있는 명궁 리와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con la maestra arquera Li en el Espinazo del Dragón.‡‡Parlez au Maître-archer Li sur l’Échine du Serpent.‡去蟠龙脊和女射手李琪薇谈一谈。‡',
  }
},
[31660] = {
  {
    'Seleção não natural‡Обуза для роя‡Dem Schwarm nicht angemessen‡무리에는 어울리지 않아‡No aptos para el enjambre‡‡Indignes de l’essaim‡虫群不宜‡',
    nil,
    'Mate 30 Enxameadores de Shek\'zeer no Ninho de Shek\'zeer. Uma‡Убейте 30 роерожденных во Владениях Шек\'зир.‡Tötet 30 Schwarmgeborene der Shek\'zeer in den Gelegen von Shek\'zeer.‡셰크지르의 손아귀에서 셰크지르 무리살이 30마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 30 enjambrenatos Shek\'zeer en La Nidada de Shek\'zeer.‡‡Tuez 30 Néssaims shek’zeer aux Nids de Shek’zeer.‡在夏柯希尔之巢杀死30只夏柯希尔聚生虫。‡',
  }
},
[31661] = {
  {
    'Uma fonte de poder aterrorizante‡Источник чудовищной силы‡Eine Quelle furchtbarer Macht‡공포스러운 힘의 근원‡Una aterradora fuente de poder‡‡Une source de puissance terrifiante‡恐惧力量之源‡',
    nil,
    'Leve o Cristal Assombrado pelo Sha para o Molda-âmbar Zikk em Klaxxi\'vess. Uma‡Покажите тронутый ша кристалл кователю янтаря Зикку в Клакси\'весс.‡Bringt den Sha-besessenen Kristall zu Bernschmied Zikk in Klaxxi\'vess.‡클락시베스에 있는 호박대장장이 지크에게 샤에 물든 수정을 가져가야 합니다. 레벨 30 공포의 황무지‡Lleva el cristal embrujado por el sha al herrero de ámbar Zikk, en Klaxxi\'vess.‡‡Apportez le Cristal hanté par les sha à l\'Ambre-forgeron Zikk à Klaxxi’vess.‡把染煞水晶带给卡拉克西维斯的琥珀匠师齐克。‡',
  }
},
[31665] = {
  {
    'BANDEIRA - Vegetron 4000 Convertido‡FLAG - Vegetron 4000 Converted‡FLAG - Gemüsomat 4000 umgewandelt‡플래그 - 채소변환기 4000 변환 완료‡FLAG - Vegetron 4000 Converted‡‡FLAG - Vegetron 4000 Converted‡FLAG - Vegetron 4000 Converted‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[31666] = {
  {
    'FLAG - Wind-Reaver\'s Dagger‡FLAG - Wind-Reaver\'s Dagger‡FLAG - Wind-Reaver\'s Dagger‡플래그 - 칼날바람 단검‡FLAG - Daga del Atracavientos‡‡FLAG - Wind-Reaver\'s Dagger‡FLAG - Wind-Reaver\'s Dagger‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[31668] = {
  {
    'Rastreio de Evento de Emboscada‡Ambush Event Tracking‡Überfallereignis‡매복 이벤트 추적‡Ambush Event Tracking‡‡Suivi de l’évènement d’embuscade‡Ambush Event Tracking‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31669] = {
  {
    'O teste do repolho‡Капустное испытание‡Die Kohlprüfung‡양배추 시험‡La prueba del repollo‡‡Le test du chou‡小试牛刀‡',
    nil,
    'Plante um Repolho Verde na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите белокочанную капусту на ферме Солнечной Песни. Семена капусты можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt einen Grünkohl auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 녹색 양배추를 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta un repollo verde en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez un chou vert à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵绿色卷心菜。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31670] = {
  {
    'Cenoura pendente‡Эта притягательная морковь‡Verlockende Karotten‡애물단지 당근‡Antojo de zanahorias‡‡Le bâton et la carotte‡美味的胡萝卜‡',
    nil,
    'Plante uma Cenoura Mordelícia na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Um(a) missão.‡Посадите хрустящую морковь на ферме Солнечной Песни. Семена продаются у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt eine saftigleckere Karotte auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 츄릅아삭 당근을 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta una zanahoria Jugoasaz en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez une Carotte croquejuteuse à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline.‡在日歌农场种植一棵爽脆胡萝卜。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31671] = {
  {
    'Cebolinha? É pla já!‡Почему бы и не лук-шалот?‡Frühlingszwiebeln? Warum nicht?‡파를 심자‡¿Por qué no cebolletas?‡‡Pourquoi pas des échalotes ?‡为什么是葱？‡',
    nil,
    'Plante Cebolinha na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите лук-шалот на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt eine Frühlingszwiebel auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 파를 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta una cebolleta en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez une Échalote à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵葱。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31672] = {
  {
    'Abôbôrrá Nº 5‡Тыквенный аромат‡Der Duft des Kürbisses‡호박꽃 향기‡Perfume de calabaza‡‡Un parfum citrouille‡南瓜香水‡',
    nil,
    'Plante uma Abóbora Mogu na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите тыкву могу на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt einen Mogukürbis auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 모구 호박을 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta una calabaza mogu en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez une Citrouille mogu à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵魔古南瓜。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31673] = {
  {
    'Não é comprovado cientificamente mas não custa tentar‡Красный лук-порей – лучшее средство против кроколисков‡Ja, ja, so rot - rot - rot blüht der Blütenlauch...‡붉은꽃 부추가 악어 잡네‡Hasta luego, crocolisco‡‡Mon poireau à moi, c’est toi‡一物降一物‡',
    nil,
    'Plante Alho-poró de Florada Vermelha na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Um(a) missão.‡Посадите красный лук-порей на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt eine Stange Rotblütenlauch auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 붉은꽃 부추를 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta un puerro Rojaflor en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez un Poireau à fleur rouge à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline.‡在日歌农场种植一棵红韭花。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31674] = {
  {
    'O desafio do nabo rosa‡Розовая репа: вызов брошен‡Wer hat die schönsten rosa Rüben im ganzen Land?‡도전! 분홍색 순무!‡El desafío de la naba rosa‡‡Le défi du navet rose‡迎难而上‡',
    nil,
    'Plante uma Nabo Rosa na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите розовую репу на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt eine rosa Rübe auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 분홍색 순무를 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta una naba rosa en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez un Navet rose à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchant Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵粉色芜菁。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31675] = {
  {
    'O tratamento do nabo branco‡Лечение белой репой‡Die Heilkraft weißer Rüben‡하얀색 순무 심기‡El tratamiento de la naba blanca‡‡Le navet plus blanc que blanc‡白色芜菁的妙用‡',
    nil,
    'Plante uma Nabo Branco na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите белую репу на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt eine weiße Rübe auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에 하얀색 순무를 심어야 합니다. 언덕골 시장에 있는 상인 그린필드에게서 씨앗을 구입할 수 있습니다.‡Planta una naba blanca en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez un Navet blanc à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵白色芜菁。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31676] = {
  {
    'Vingança Antiga‡Месть древних‡Uralte Rache‡고대의 복수‡Venganza ancestral‡‡Une vengeance ancienne‡远古复仇‡',
    nil,
    'Mate 6 Espíritos Vingativos Gurthani no Terraço de Gurthan. Uma‡Убейте 6 мстительных гуртанских духов на Террасе Гуртан.‡Tötet 6 rachsüchtige Gurthanigeister auf der Terrasse von Gurthan.‡구르단 정원에서 복수심에 찬 구르다니 영혼 6마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Asesina a 6 espíritus Gurthani vengativos en el Bancal Gurthan.‡‡Tuez 6 Esprits gurthani vengeurs à la Terrasse de Gurthan.‡在格尔桑平台杀死6个格萨尼复仇之灵。‡',
  }
},
[31677] = {
  {
    'As cinzas do Senhor da Guerra‡Прах вождя‡Die Asche des Kriegsmeisters‡장군의 유골 가루‡Las cenizas del señor de la guerra‡‡Les cendres du seigneur de guerre‡军阀的骨灰‡',
    nil,
    'Leve as Cinzas do Senhor da Guerra Gurthan para Kil\'ruk, o Aniquilador dos Ventos, em Klaxxi\'vess. Uma‡Принесите прах вождя клана Гуртан Кил\'руку Рассекающему Ветер в Клакси\'весс.‡Bringt die Asche von Kriegsherr Gurthan zu Kil\'ruk dem Windschnitter in Klaxxi\'vess.‡클락시베스에 있는 칼날바람 킬루크에게 장군 구르단의 유골 가루를 가져가야 합니다. 레벨 30 공포의 황무지‡Lleva las cenizas del señor de la guerra Gurthan a Kil\'ruk el Atracavientos, en Klaxxi\'vess.‡‡Apportez les Cendres du seigneur de guerre Gurthan à Kil’ruk le Saccageur des vents, à Klaxxi’vess.‡将格尔桑军阀骨灰带给卡拉克西维斯的掠风者克尔鲁克。‡',
  }
},
[31679] = {
  {
    'Expandindo nossa cobertura‡Усиление сигнала‡Unsere Reichweite ausbauen‡봉화를 올려라‡Extender la cobertura‡‡Renforcer le signal‡扩大范围‡',
    nil,
    'Ative o Transmissor Ressoante na Ravina Brilhâmbar. Uma‡Активировать резонирующий маячок в Янтарной впадине.‡Aktiviert das resonierende Signal in der Bernscheinkuhle.‡호박빛 동굴에 있는 공명의 봉화를 밝혀야 합니다. 레벨 30 공포의 황무지‡Activa la baliza resonadora en la Cuenca del Resplandor Ámbar.‡‡Activez la Balise de résonance dans le Creux de Luisambre.‡激活珀光裂窟的共鸣信标。‡',
  }
},
[31680] = {
  {
    'Crime e Castigo‡Преступление и наказание‡Schuld und Sühne‡죄와 벌‡Crimen y castigo‡‡Crime et châtiment‡罪与罚‡',
    nil,
    'Mate 8 Colhedores de Âmbar na Trilha Cortante. Uma‡Убейте 8 ик\'тиков-жнецов на Жгучей тропе.‡Tötet 8 Bernernter der Ik\'thik auf dem Stechenden Pfad.‡바늘길에서 이크티크 채집꾼 8마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 8 cosechadores Ik\'thik en La Senda del Aguijón.‡‡Tuez 8 Moissonneurs d’ambre à la Piste Brûlante.‡在刺芒小径杀死8个琥珀收割者。‡',
  }
},
[31681] = {
  {
    'Melhorando com a idade‡Чем старше, тем лучше‡Je älter, desto besser‡오래 묵을수록 진국‡Mejora con el tiempo‡‡Affiné par les ans‡越陈越香‡',
    nil,
    'Colete 7 Jarros Cheios de Âmbar dos Coletores de Âmbar na Trilha Cortante. Uma‡Соберите 7 кувшинов с янтарем с накопителей янтаря на Жгучей тропе.‡Sammelt 7 mit Bern gefüllte Gläser von den Bernsammlern auf dem Stechenden Pfad.‡바늘길의 호박 수집기에서 호박이 든 병 7개를 모아야 합니다. 레벨 30 공포의 황무지‡Recoge 7 tarros llenos de ámbar de los recolectores de ámbar de La Senda del Aguijón.‡‡Récoltez 7 Jarres remplies d’ambre sur les Collecteurs d’ambre impériaux de la Piste Brûlante.‡在刺芒小径从琥珀采集器上收集7个装满琥珀的罐子。‡',
  }
},
[31682] = {
  {
    'No mar, nunca mais‡Уже не у моря‡Niemals wieder am Meer‡바다 옆에서, 두 번 다시는‡Junto al mar, nunca más‡‡Le retrait de la mer‡‡',
    nil,
    'Use o Diapasão Klaxxi nas Rochas Gastas pelo Oceano para acordar o paragão. Uma‡Поднесите камертон клакси к океаническим камням и пробудите Идеал.‡Benutzt die Stimmgabel der Klaxxi bei den meergepeitschten Felsen, um den Getreuen zu erwecken.‡파도에 닳은 바위에 클락시 조율용 굽쇠를 사용해서 용장을 깨워야 합니다. 레벨 30 공포의 황무지‡Utiliza el diapasón Klaxxi en las rocas desgastadas por el océano para despertar al dechado.‡‡Utilisez le Diapason klaxxi sur les Rochers usés par l’océan pour réveiller le Parangon.‡‡',
  }
},
[31685] = {
  {
    'Vale dos Quatro Ventos‡Долина Четырех Ветров‡Das Tal der Vier Winde‡네 바람의 계곡‡Valle de los Cuatro Vientos‡‡La vallée des Quatre vents‡四风谷‡',
    nil,
    'Fale com o Recruta Tem P. Orário no Vale dos Quatro Ventos. Uma‡Телепортируйтесь в долину Четырех Ветров и поговорите с рядовым В. Ременным.‡Teleportiert Euch ins Tal der Vier Winde und sprecht mit dem Gefreiten Tim P. Orär.‡네 바람의 계곡으로 순간이동하여 병사 팀 P. 오래리와 대화해야 합니다. 레벨 15 스톰윈드‡Teletranspórtate al Valle de los Cuatro Vientos y habla con el soldado Tim P. O\'Rary.‡‡Téléportez-vous dans la Vallée des Quatre vents et parlez au Soldat Tim P. O’raire.‡传送至四风谷并和列兵蒂姆·P·拉瑞谈一谈。‡',
  }
},
[31687] = {
  {
    'Reduzindo os Sik\'thik‡Проредить сик\'тиков‡Die Sik\'thik ausdünnen‡시크티크 인구 제한‡Mermar a los Sik\'thik‡‡Décimer les sik’thik‡削弱希克提克‡',
    nil,
    'Mate 12 mantídeos Sik\'thik. Uma‡Убейте 12 богомолов cик\'тиков.‡Tötet 12 Mantis der Sik\'thik.‡시크티크 사마귀 12마리를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 12 mántides Sik\'thik.‡‡Tuez 12 Mantides sik’thik.‡杀死12个希克提克螳螂妖。‡',
  }
},
[31688] = {
  {
    'À procura de Leng, o Incansável‡Поиски Беспокойного Лэна‡Die Suche nach dem Rastlosen Leng‡산만한 렁을 찾아라‡En busca de Leng el Inquieto‡‡À la recherche de Leng le Sans repos‡寻找冷恒‡',
    nil,
    'Vasculhe as Jaulas dos Sik\'thik à procura de Leng, o Incansável. Uma‡Обыщите клетки сик\'тиков и попытайтесь найти Беспокойного Лэна.‡Durchsucht die Käfige der Sik\'thik nach dem rastlosen Leng.‡시크티크 우리에서 산만한 렁을 찾아야 합니다. 레벨 25 탕랑 평원‡Busca a Leng el Inquieto en las jaulas Sik\'thik.‡‡Fouillez les Cages sik’thik à la recherche de Leng le Sans repos.‡搜寻希克提克囚笼，找到焦躁的冷恒。‡',
  }
},
[31689] = {
  {
    'O Filho do Medo‡Воины ужаса‡Die Furchtverschworenen‡공포서약병‡Los juraterrores‡‡Les ligeffrois‡惧誓者‡',
    nil,
    'Mate 6 Filhos do Medo Vor\'thik em Kypari Vor. Uma‡Убейте 6 вор\'тиков – воинов ужаса в Кипари Вор.‡Tötet 6 Furchtverschworene der Vor\'thik bei Kypari Vor.‡키파리 보르에서 보르티크 공포서약병 6마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 6 juraterrores Vor\'thik en Kypari Vor.‡‡Tuez 6 Ligeffrois vor’thik à Kypari Vor.‡在凯帕圣树·沃尔杀死6个沃提克惧誓者。‡',
  }
},
[31690] = {
  {
    'Cajado do Tigre Inscrito‡Покрытый письменами тигриный посох‡Beschrifteter Tigerstab‡문자가 새겨진 호랑이의 지팡이‡Bastón de tigre con inscripciones‡‡Le bâton gravé d’un tigre‡铭文白虎杖‡',
    nil,
    'Leve seu Cajado do Tigre Inscrito ao Mestre Escriba Glenzu no Arboreto. Uma‡Принесите ваш покрытый письменами тигриный посох мастеру каллиграфии Глень-цзу в Дендрарий.‡Bringt Euren beschrifteten Tigerstab zu Tintenmeister Glenzu im Arboretum.‡도원에 있는 잉크장인 글렌주에게 문자가 새겨진 호랑이의 지팡이를 가져가야 합니다. 레벨 10‡Lleva tu bastón de tigre con inscripciones al maestro calígrafo Glenzu, en El Arboretum.‡‡Apportez votre Bâton gravé d’un tigre au Maître des encres Glenzu, à l’Arboretum.‡把你的铭文白虎杖带给百木园里的墨水大师格伦苏。‡',
  }
},
[31691] = {
  {
    'Cajado da Garça Inscrito‡Покрытый письменами журавлиный посох‡Beschrifteter Kranichstab‡문자가 새겨진 학의 지팡이‡Bastón de grulla con inscripciones‡‡Le bâton gravé d’une grue‡铭文朱鹤杖‡',
    nil,
    'Leve seu Cajado da Garça Inscrito ao Mestre Escriba Jo Po no Arboreto. Uma‡Принесите ваш покрытый письменами журавлиный посох мастеру каллиграфии Цзо По в Дендрарий.‡Bringt Euren beschrifteten Kranichstab zu Tintenmeister Jo Po im Arboretum.‡도원에 있는 잉크장인 조 포에게 문자가 새겨진 학의 지팡이를 가져가야 합니다. 레벨 10‡Lleva tu bastón de grulla con inscripciones al maestro calígrafo Jo Po, en El Arboretum.‡‡Apportez votre Bâton gravé d’une grue au Maître des encres Jo Po, à l’Arboretum.‡把你的铭文朱鹤杖带给百木园里的墨水大师乔波。‡',
  }
},
[31692] = {
  {
    'Cajado da Serpente Inscrito‡Покрытый письменами змеиный посох‡Beschrifteter Schlangenstab‡문자가 새겨진 용의 지팡이‡Bastón de dragón con inscripciones‡‡Le bâton gravé d’un serpent‡铭文青龙杖‡',
    nil,
    'Leve seu Cajado da Serpente Inscrito ao Mestre Escriba Wei no Arboreto. Uma‡Принесите ваш покрытый письменами змеиный посох мастеру каллиграфии Вэю в Дендрарий.‡Bringt Euren beschrifteten Schlangenstab zu Tintenmeister Wei im Arboretum.‡도원에 있는 잉크장인 웨이에게 문자가 새겨진 용의 지팡이를 가져가야 합니다. 레벨 10‡Lleva tu bastón de dragón con inscripciones al maestro calígrafo Wei, en El Arboretum.‡‡Apportez votre Bâton gravé d’un serpent au Maître des encres Wei, à l’Arboretum.‡把你的铭文青龙杖带给百木园里的墨水大师魏。‡',
  }
},
[31693] = {
  {
    'Júlia Esteves‡Джулия Стивенс‡Julia Stevens‡줄리아 스티븐스‡Julia Stevens‡‡Julia Stevens‡茱莉亚·史蒂文斯‡',
    nil,
    'Vença Júlia Esteves numa batalha de mascotes. Uma‡Победите Джулию Стивенс в битве питомцев. это‡Besiegt Julia Stevens in einem Haustierkampf.‡애완동물 대전에서 줄리아 스티븐스를 꺾어야 합니다. 레벨 1‡Derrota a Julia en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Julia Stevens.‡在宠物战斗中击败茱莉亚·史蒂文斯。‡',
  }
},
[31695] = {
  {
    'Além da muralha‡По ту сторону стены‡Hinter der Mauer‡장벽 너머‡Más allá de la muralla‡‡Au-delà de la muraille‡城墙之外‡',
    nil,
    'Fale com Taran Zhu no Entreposto Longying, nas Estepes de Taolong. Uma‡Поговорите с Тажанем Чжу на укреплениях Лун-Ин, что в Танлунских степях. задание.‡Sprecht mit Taran Zhu am Außenposten Longying in der Tonlongsteppe.‡탕랑 평원의 롱잉 전초기지에 있는 타란 주와 대화해야 합니다. 레벨 25 탕랑 평원‡Habla con Taran Zhu en la Avanzada Longying, en las Estepas de Tong Long.‡‡Parlez à Taran Zhu à l’Avant-poste de Longying, dans les Steppes de Tanglong.‡去螳螂高原的龙影岗哨和祝踏岚谈一谈。‡',
  }
},
[31697] = {
  {
    'Jeremy\'s Test Quest‡ACCIDENTAL COPY‡Jeremy\'s Test Quest‡제레미의 시험용 퀘스트‡ACCIDENTAL COPY‡‡Tuer des mouches au bazooka‡‡',
    nil,
    'Use a Dragon Launcher to kill 50 swarming mantid. Uma‡Убейте 50 нападающих богомолов с помощью орудия "дракон".‡‡레벨 1 탕랑 평원‡‡‡‡‡',
  }
},
[31698] = {
  {
    'Controle populacional‡Сокращение популяции‡Den Bestand ausdünnen‡호랑이 줄이기‡¡De caza!‡‡Décimer la meute‡养虎为患‡',
    nil,
    'Mate 8 Tigres Ventaneiros ou Alfas Ventaneiros. Uma‡Убейте 8 тигров или матерых тигров Наветренного острова.‡Tötet 8 Windwärtstiger oder Windwärtsalphatiere.‡바람맞이 호랑이 또는 바람맞이 우두머리 8마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 8 tigres de Barlovento o alfas de Barlovento.‡‡Tuez 8 Tigres de Front-du-vent ou Alphas de Front-du-vent.‡杀死8只临风幼虎或临风猛虎。‡',
  }
},
[31699] = {
  {
    'Duendefobia‡Боязнь духов‡Waldgeistphobie‡요마 공포증‡¡Atrápame esos duendes!‡‡La phobie des lutins‡林精恐惧症‡',
    nil,
    'Mate 7 Trapaceiros Umbrafae. Uma‡Убейте 7 темных духов – плутов.‡Tötet 7 Schattenfeetrickster.‡어둠요정 요술쟁이 7마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 7 tramposos Hadasombra.‡‡Tuez 7 Lutins de l’ombre entourloupeurs.‡击败7个影妖骗子。‡',
  }
},
[31700] = {
  {
    'Troca de papéis‡Сапог не на ту ногу‡So wird ein Schuh draus...‡장화가 대체 어디 있는 거야!‡Se han vuelto las tornas‡‡Trouver chaussure à son pied‡穿错鞋‡',
    nil,
    'Roube de volta 14 Botas Roubadas. Uma‡Украдите 14 пар украденных сапог.‡Stehlt 14 gestohlene Stiefel zurück.‡도난당한 장화 14켤레를 다시 훔쳐야 합니다. 레벨 10 비취 숲‡Vuelve a robar 14 botas robadas.‡‡Volez à votre tour 14 Bottes volées.‡重新夺回14只失窃的靴子。‡',
  }
},
[31701] = {
  {
    'Caçadora Sombria‡Охотница Наветренного острова‡Dunkle Jägerin‡암흑의 암호랑이‡La cazadora oscura‡‡La chasseresse de l’ombre‡残暴的女猎手‡',
    nil,
    'Mate a Caçadora Ventaneira. Uma‡Убейте охотницу Наветренного острова.‡Tötet die Windwärtsjägerin.‡바람맞이 암호랑이를 처치해야 합니다. 레벨 10 비취 숲‡Mata a la cazadora de Barlovento.‡‡Tuez la Chasseresse de Front-du-Vent.‡击败临风女猎手。‡',
  }
},
[31702] = {
  {
    'À espreita‡Крадучись‡Jagdbefehl‡배회하는 야수‡Al acecho‡‡La bête rôde‡心头大患‡',
    nil,
    'Mate o Sabre Ventaneiro. Uma‡Убейте саблезуба Наветренного острова.‡Tötet den Windwärtssäbler.‡바람맞이 큰호랑이를 처치해야 합니다. 레벨 10 비취 숲‡Mata al dientes de sable de Barlovento.‡‡Tuez le Sabre de Front-du-Vent.‡击败临风刃豹。‡',
  }
},
[31703] = {
  {
    'Eclipse lunático‡Беспредел Сумасброда‡Ab mit dem Tollkopf‡천방지축 대소동‡Locura de tarambanas‡‡Toc-Toc ! Qui est là ?‡狂徒的末日‡',
    nil,
    'Mate o Lunático Umbrafae. Uma‡Убейте Злонравного Сумасброда.‡Tötet den Schattenfeetollkopf.‡어둠요정 천방지축을 처치해야 합니다. 레벨 10 비취 숲‡Mata al tarambana Hadasombra.‡‡Tuez le Lutin de l’ombre Toc-Toc.‡杀死影妖狂徒。‡',
  }
},
[31704] = {
  {
    'Caquinha‡Большая уборка‡Ein Häufchen gemacht‡응가가 떡!‡Todos hacemos caca‡‡On est pas dans le caca !‡清理粪便‡',
    nil,
    'Colete 5 Pequenas Bolsas de Cocô. Uma‡Соберите 5 мешочков экскрементов.‡Sammelt 5 kleine Beutel mit Häufchen.‡작은 응가 주머니 6개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 5 bolsas de caca pequeñas.‡‡Récupérez 5 Petits sacs de caca.‡收集5小袋粪便。‡',
  }
},
[31705] = {
  {
    'Pau no agulheiro‡Не ужаль меня‡Angst vor der Nadel‡나를 쏘지 말아요‡Avispados‡‡Piquer sa curiosité‡引蜂出洞‡',
    nil,
    'Use o mel na clareira norte do Arboreto e mate o Agulheiro do Pomar. Uma‡Воспользуйтесь медом на поляне в северной части Дендрария, а затем убейте садового острожала.‡Benutzt den Honig auf der nördlichen Lichtung im Arboretum und tötet dann den Obstgartennadler.‡도원의 북쪽 공터에서 꿀을 사용하여 과수원 침벌레를 유인한 후 처치해야 합니다. 레벨 10 비취 숲‡Utiliza la miel en el claro norte de El Arboretum y luego mata al aguijoneador de huerto.‡‡Utilisez le Miel dans la clairière nord de l’Arboretum, puis tuez le Piqueur du verger.‡在百木园北面的空地上使用蜂蜜，然后杀死果园钉刺者。‡',
  }
},
[31706] = {
  {
    'Viúvas Chorosas‡Рыдающие вдовы‡Weinende Witwen‡흐느끼는 과부거미‡Las viudas sollozantes‡‡Les veuves éplorées‡悲泣寡妇蛛‡',
    nil,
    'Mate 7 Viúvas Chorosas. Uma‡Убейте 7 рыдающих вдов.‡Tötet 7 weinende Witwen.‡흐느끼는 과부거미 7마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 7 viudas sollozantes.‡‡Tuez 7 Veuves éplorées.‡杀死7只悲泣寡妇蛛。‡',
  }
},
[31707] = {
  {
    'Uma teia emaranhada‡Спутанная паутина‡Verheddert‡뒤엉킨 거미줄‡Una red enmarañada‡‡Une toile enchevêtrée‡致命蛛网‡',
    nil,
    'Destrua as Teias de Viúva para libertar 5 Aldeões Sri-La. Uma‡Разорвите паутину вдовы и освободите 5 жителей деревни Шри-Ла.‡Zerstört die Witwennetze, um 5 Dorfbewohner von Sri-La zu befreien.‡과부거미의 거미줄을 찢고 스리라 주민 5명을 구출해야 합니다. 레벨 10 비취 숲‡Destruye telarañas de viuda para liberar a 5 aldeanos de Sri-La.‡‡Détruisez les Toiles de la veuve pour libérer 5 Villageois de Sri-La.‡摧毁寡妇蛛网，救出5个香里拉村民。‡',
  }
},
[31708] = {
  {
    'A Escama da Serpente‡Змеиные чешуйки‡Schlangenschuppe‡운룡의 비늘‡Escama de dragón‡‡L’écaille du serpent‡龙鳞菇‡',
    nil,
    'Colete 25 Escamas da Serpente. Uma‡Соберите 25 "змеиных чешуек".‡Sammelt 25 Schlangenschuppen.‡운룡의 비늘 25개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 25 escamas de dragón.‡‡Récupérez 25 Écailles du serpent.‡收集25个龙鳞菇。‡',
  }
},
[31709] = {
  {
    'Dúvida Persistente‡Мучительные сомнения‡Nagender Zweifel‡잔존하는 의심‡Dudas persistentes‡‡Un doute obsédant‡疑云密布‡',
    nil,
    'Use o Dispositivo de Sintonia do Sha nos Distúrbios do Sha que estão ocorrendo no Lamento da Viúva. A entrada do Lamento da Viúva fica a norte, ao longo da costa, e a sul da Aldeia Sri-La.‡Воспользуйтесь устройством измерения силы ша в местах волнений ша в Плаче Вдовы. Вход в Плач Вдовы находится в северной части берега, южнее деревни Шри-Ла.‡Benutzt das Sha-Abstimmungsgerät an Orten mit Sha-Befall im Klagen der Witwe. Der Eingang zum Klagen der Witwe kann an der Küste im Norden gefunden werden, südlich von Sri-La.‡과부의 통곡에 있는 샤 기운에서 샤 감지 장치를 사용해야 합니다. 해안을 따라 북쪽으로 올라가다 보면, 스리라 마을 남쪽에 과부의 통곡 입구가 있습니다.‡Utiliza el dispositivo de armonización de sha en las perturbaciones de sha de El Lamento de la Viuda. La entrada a El Lamento de la Viuda se encuentra al norte, en la costa al sur de la Aldea Sri-La.‡‡Utilisez le Détecteur de sha aux Perturbations sha, aux Sanglots de la veuve. L’entrée de la grotte se trouve au nord, le long de la côte, au sud de Sri-La.‡在蛛泣洞穴对煞能干扰使用煞能协调器。沿着海岸线向北可以找到蛛泣洞穴的入口，就在香里拉村的南面。‡',
  }
},
[31710] = {
  {
    'Agradinhos‡Маленькие лакомства‡Leckerlis‡작은 별미‡Chucherías‡‡De minuscules friandises‡风味美食‡',
    nil,
    'Colete 100 Olhinhos de Aranha. Uma‡Соберите 100 маленьких паучьих глаз.‡Sammelt 100 winzige Spinnenaugen.‡작은 거미 눈알 100개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 100 ojos de araña diminutos.‡‡Récoltez 100 Minuscules yeux d’araignée.‡收集100只小蜘蛛眼。‡',
  }
},
[31711] = {
  {
    'A semente da dúvida‡Зерно сомнения‡Die Saat des Zweifels‡의심의 씨앗‡La semilla de la duda‡‡La graine du doute‡疑虑之种‡',
    nil,
    'Mate a Semente da Dúvida. Uma‡Уничтожьте зерно сомнения.‡Tötet die Saat des Zweifels.‡의심의 씨앗을 처치해야 합니다. 레벨 10 비취 숲‡Erradica la semilla de la duda.‡‡Tuez la Graine du doute.‡消灭疑虑之种。‡',
  }
},
[31712] = {
  {
    'Macaquices‡Обезьяньи проказы‡Affenärger‡장난꾸러기 원숭이들‡Travesuras de monos‡‡Des singes pas sages‡顽劣的猴子‡',
    nil,
    'Mate 13 Hozens de Uná. Uma‡Убейте 13 хозенов Уна.‡Tötet 13 Uuna-Ho-zen.‡우나 호젠 13마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 13 hozen de Oona.‡‡Tuez 13 Hozen d’Ouna.‡杀死13只乌拿猢狲。‡',
  }
},
[31713] = {
  {
    'Confusão cervejal‡Спасение портера‡Uuna-hört‡열렬한 맥주 사랑‡Cervecero al rescate‡‡Bière-à-brac‡无酒不欢‡',
    nil,
    'Colete 100 Cervejas de Sri-La. Uma‡Соберите 100 порций украденного портера Шри-Ла.‡Sammelt 100 Sri-La-Starkbier.‡스리라 스타우트 100개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 100 cervezas negras de Sri-La.‡‡Récupérez 100 Brunes de Sri-La.‡收集100桶香里拉烈酒。‡',
  }
},
[31714] = {
  {
    'Salvando as serpentes‡Спасение змеев‡Die Schlangen retten‡운룡을 구해라‡Salvar a los dragones‡‡Sauver les serpents‡拯救翔龙‡',
    nil,
    'Colete 10 Serpentes Resgatadas. Uma‡Соберите 10 спасенных змеев.‡Sammelt 10 gerettete Schlangen.‡운룡을 구출하고 구출한 운룡 10마리를 모아야 합니다. 레벨 10 비취 숲‡Reúne 10 dragones rescatados.‡‡Réunissez 10 Serpents secourus.‡收集10条得救的翔龙。‡',
  }
},
[31715] = {
  {
    'O grande chefão Uná‡Лорд Уна‡Uuna-bittlich‡무시무시한 우나‡Muerte al capitán‡‡Ouna qu’à le tuer‡海上魔王‡',
    nil,
    'Mate o Lorde Uná. Uma‡Убейте Лорда Уна.‡Tötet Fürst Uuna.‡군주 우나를 처치해야 합니다. 레벨 10 비취 숲‡Mata al señor de Oona.‡‡Tuez le Seigneur Ouna.‡杀死乌拿头领。‡',
  }
},
[31716] = {
  {
    'Caquinha‡Большая уборка‡Ein Häufchen gemacht‡응가가 떡!‡Todos hacemos caca‡‡On est dans le caca !‡清理粪便‡',
    nil,
    'Colete 5 Grandes Sacos de Cocô. Uma‡Соберите 5 больших мешков экскрементов.‡Sammelt 5 große Beutel mit Häufchen.‡큰 응가 주머니 5개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 5 bolsas de caca grandes.‡‡Récupérez 5 Grands sacs de caca.‡收集5大袋粪便。‡',
  }
},
[31717] = {
  {
    'O desafio do instrutor: Ás Pata Longa‡Поединок укротителей: Айс Длинная Лапа‡Herausforderung des Trainers: Flitze Langpranke‡기수의 도전: 에이스 롱포우‡El reto del instructor: As Zarpa Larga‡‡Le défi du dresseur : Crack Patte Longue‡训练师的试炼：王牌飞行员长爪‡',
    nil,
    'Fale com Ás Pata Longa, e então derrote-o. Uma‡Поговорите с Айсом Длинной Лапой, а затем победите его.‡Sprecht mit Flitze Langpranke und besiegt ihn.‡에이스 롱포우와 대화하고, 대련에서 승리해야 합니다. 레벨 10 비취 숲‡Habla con As Zarpa Larga y, después, derrótalo.‡‡Parlez à Crack Patte Longue, puis battez-le.‡和王牌飞行员长爪谈一谈，然后击败他。‡',
  }
},
[31718] = {
  {
    'O desafio do instrutor: Baozão‡Поединок укротителей: Большой Бао‡Herausforderung des Trainers: Bao der Große‡기수의 도전: 싸움꾼 바오‡El reto del instructor: Gran Bao‡‡Le défi du dresseur : Gros Bao‡训练师的试炼：大宝‡',
    nil,
    'Fale com Baozão, e então derrote-o. Uma‡Поговорите с Большим Бао, а затем победите его.‡Sprecht mit Bao dem Großen und besiegt ihn.‡싸움꾼 바오와 대화하고, 대련에서 승리해야 합니다. 레벨 10 비취 숲‡Habla con Gran Bao y, después, derrótalo.‡‡Parlez à Gros Bao, puis battez-le.‡和大宝谈一谈，然后击败他。‡',
  }
},
[31719] = {
  {
    'O desafio do instrutor: Ningna Disco Negro‡Поединок укротителей: Нинья Темное Колесо‡Herausforderung des Trainers: Ningna Dunkelrad‡기수의 도전: 닝나 다크휠‡El reto del instructor: Ningna Timón Sombrío‡‡Le défi du dresseur : Ningna Roue de l’Ombre‡训练师的试炼：宁纳·黑轮‡',
    nil,
    'Fale com Ningna Disco Negro, e então derrote-a. Uma‡Поговорите с Ниньей Темное Колесо, а затем победите ее.‡Sprecht mit Ningna Dunkelrad und besiegt sie.‡닝나 다크휠과 대화하고, 대련에서 승리해야 합니다. 레벨 10 비취 숲‡Habla con Ningna Timón Sombrío y, después, derrótala.‡‡Parlez à Ningna Roue de l’Ombre, puis battez-la.‡和宁纳·黑轮谈一谈，然后击败她。‡',
  }
},
[31720] = {
  {
    'O desafio do instrutor: Suchi, a Fofa‡Поединок укротителей: Сладкая Су-Чи‡Herausforderung des Trainers: Suchi die Süße‡기수의 도전: 다정한 쑤츠‡El reto del instructor: Suchi la Dulce‡‡Le défi du dresseur : Suchi la Tendre‡训练师的试炼：蜜糖苏琪‡',
    nil,
    'Fale com Suchi, a Fofa, então derrote-a. Uma‡Поговорите со Сладкой Су-Чи, а затем победите ее.‡Sprecht mit Suchi der Süßen und besiegt sie.‡다정한 쑤츠와 대화하고, 대련에서 승리해야 합니다. 레벨 10 비취 숲‡Habla con Suchi la Dulce y, después, derrótala.‡‡Parlez à Suchi la Tendre, puis battez-la.‡和蜜糖苏琪谈一谈，然后击败她。‡',
  }
},
[31721] = {
  {
    'O desafio do instrutor: Qua-Ro Testa Branca‡Поединок укротителей: Цюа-Жо Белая Бровь‡Herausforderung des Trainers: Qua-Ro Weißstirn‡기수의 도전: 쿠아로 화이트브라우‡El reto del instructor: Qua-Ro Ceja Lívida‡‡Le défi du dresseur : Qua Ro Front de Neige‡训练师的试炼：奎陆·白眉‡',
    nil,
    'Fale com Qua-Ro Testa Branca, e então derrote-o. Uma‡Поговорите с Цюа-Жо Белой Бровью, а затем победите его в бою.‡Sprecht mit Qua-Ro Weißstirn und besiegt ihn.‡쿠아로 화이트브라우와 대화하고, 대련에서 승리해야 합니다. 레벨 10 비취 숲‡Habla con Qua-Ro Ceja Lívida y, después, derrótalo.‡‡Parlez à Qua Ro Front de Neige, puis battez-le.‡和奎陆·白眉谈一谈，然后击败他。‡',
  }
},
[31723] = {
  {
    'Vale dos Quatro Ventos‡Долина Четырех Ветров‡Das Tal der Vier Winde‡네 바람의 계곡‡Valle de los Cuatro Vientos‡‡La vallée des Quatre vents‡四风谷‡',
    nil,
    'Fale com o Recruta Tem P. Orário no Vale dos Quatro Ventos. Uma‡Поговорите с рядовым В. Ременным в долине Четырех Ветров.‡Sprecht mit dem Gefreiten Tim P. Orär im Tal der Vier Winde.‡네 바람의 계곡으로 순간이동하여 병사 팀 P. 오래리와 대화해야 합니다. 레벨 15 스톰윈드‡Habla con el soldado Tim P. O\'Rary en el Valle de los Cuatro Vientos.‡‡Parlez au Soldat Tim P. O’raire dans la Vallée des Quatre vents.‡和四风谷的列兵蒂姆·P·拉瑞谈一谈。‡',
  }
},
[31724] = {
  {
    'Zé Urtigueiro‡Старик Макдональд‡Mac Donald‡노인 맥도날드‡Viejo MacDonald‡‡Le vieux MacDonald‡老马当劳‡',
    nil,
    'Vença Zé Urtigueiro numa batalha de mascotes. Uma‡Победите старика Макдональда в битве питомцев. это‡Besiegt Mac Donald in einem Haustierkampf.‡애완동물 대전에서 노인 맥도날드를 꺾어야 합니다. 레벨 1‡Derrota al viejo MacDonald en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre le Vieux MacDonald.‡在宠物战斗中击败老马当劳。‡',
  }
},
[31725] = {
  {
    'Rosinha‡Линдси‡Lindsay‡린제이‡Lindsay‡‡Lindsay‡林塞‡',
    nil,
    'Vença Rosinha numa batalha de mascotes. Uma‡Победите Линдси в битве питомцев. это‡Besiegt Lindsay in einem Haustierkampf.‡애완동물 대전에서 린제이를 꺾어야 합니다. 레벨 1‡Derrota a Lindsay en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Lindsay.‡在宠物战斗中击败林塞。‡',
  }
},
[31726] = {
  {
    'Eric Davidson‡Эрик Дэвидсон‡Eric Davidson‡에릭 데이비슨‡Eric Davidson‡‡Eric Davidson‡埃里克·戴维森‡',
    nil,
    'Vença Eric Davidson numa batalha de mascotes. Uma‡Победите Эрика Дэвидсона в битве питомцев. это‡Besiegt Eric Davidson in einem Haustierkampf.‡애완동물 대전에서 에릭 데이비슨을 꺾어야 합니다. 레벨 1‡Derrota a Eric Davidson en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Eric Davidson.‡在宠物战斗中击败埃里克·戴维森。‡',
  }
},
[31727] = {
  {
    'Vício em jogo‡Поиск припасов‡Riskantes Spiel‡요행수 문제‡Ludopatía‡‡Un pari risqué‡放手一搏‡',
    nil,
    'Fale com o Chefe de Convés Arie no Gambito do Encharco, que fica no Ermo do Medo. Uma‡Поговорите с боцманом Ари в Приюте капитана, что в Жутких пустошах.‡Sprecht in der Schreckensöde mit Deckoffizierin Arie bei Tropfs Wagnis.‡공포의 황무지의 흠뻑이의 요행수에 있는 갑판장 아리에와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con la jefa de muelle Arie en el Lance de Aguado, en el Desierto del Pavor.‡‡Parlez au Boss du pont Arie, au Pari de Trempette, dans les Terres de l’Angoisse.‡去恐惧废土的闷水壶的冒险码头和甲板长官阿林谈一谈。‡',
  }
},
[31728] = {
  {
    'Bill Buckler‡Билл Баклер‡Bill Schildbuckel‡빌 버클러‡Bill Buckler‡‡Bill Pavois‡比尔·巴克勒‡',
    nil,
    'Vença Bill, o Pirata, numa batalha de mascotes. Uma‡Победите Билла Баклера в битве питомцев. это‡Besiegt Bill den Piraten in einem Haustierkampf.‡애완동물 대전에서 빌 버클러를 꺾어야 합니다. 레벨 1‡Derrota a Bill el Pirata en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Bill le pirate.‡在宠物战斗中击败海盗比尔。‡',
  }
},
[31729] = {
  {
    'Estêvão Lisbane‡Стивен Лисбен‡Steven Lisbane‡스티븐 리스베인‡Steven Lisbane‡‡Steven Lisbane‡史蒂文·里斯班‡',
    nil,
    'Derrote Estêvão Lisbane numa batalha de mascotes. Uma‡Победите Стивена Лисбена в битве питомцев. это‡Besiegt Steven Lisbane in einem Haustierkampf.‡애완동물 대전에서 스티븐 리스베인을 꺾어야 합니다. 레벨 1‡Derrota a Steven Lisbane en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Steven Lisbane.‡在宠物战斗中击败史蒂文·里斯班。‡',
  }
},
[31730] = {
  {
    'Um pedido não tão amigável‡Недружественная просьба‡Ein wenig freundlicher Auftrag‡그다지 우호적이지 않은 부탁‡Una petición no muy amistosa‡‡Une demande pas si amicale‡不那么友好的请求‡',
    nil,
    'Fale com o Mestre da Seiva Vu no Parque Cervejeiro, no Ermo do Medo. Uma‡Поговорите с соковаром Ву в хмелеваренном дворике в Жутких пустошах.‡Sprecht im Braugarten in der Schreckensöde mit Saftmeister Vu.‡공포의 황무지의 양조정원에 있는 수액전문가 부와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con el maestro de savia Vu en El Jardín de la Cebada, en el Desierto del Pavor.‡‡Parlez au Maître-résinier Vu au Chai du couchant, dans les Terres de l’Angoisse.‡去恐惧废土的落日酒坊和树脂大师吴暮谈一谈。‡',
  }
},
[31732] = {
  {
    'Inferno à solta‡Да разверзнется ад‡Die Hölle entfesseln‡지옥의 문을 열고‡Desencadena el infierno‡‡Déchaîner les enfers‡天火降临‡',
    nil,
    'Use um Girocóptero do Celesfogo para matar 60 membros das tropas de Garrosh e destrua 8 Retalhadores Garrosh\'ar, e depois afunde o Ceifador Carpunhal e o Chaga Estígia.‡Летите на гирокоптере "Небесного огня", чтобы уничтожить 60 солдат лагеря Гаррош\'ар и 8 крошшеров лагеря Гаррош\'ар, а затем потопите "Жнец Кровавого Кулака" и "Адский Шрам".‡Benutzt einen Himmelsfeuer-Gyrokopter, um 60 Soldaten der Garrosh\'ar zu töten, 8 Schredder der Garrosh\'ar zu zerstören und anschließend die Klingenfaustschneide und die Höllennarbe zu versenken.‡하늘불꽃호 자이로콥터를 타고 가로쉬아르 병사들 60명을 처치하고, 가로쉬아르 벌목기 8대를 파괴한 후, 칼날주먹 절단기와 저승의 자비호를 침몰시켜야 합니다.‡Usa un girocóptero de El Abrasacielos para matar a 60 miembros de las tropas de Garrosh\'ar y destruye 8 machacadores de Garrosh\'ar, y luego hunde el Segador de Garrafilada y la Cicatriz Estigia.‡‡Utilisez un Gyrocoptère du Brûleciel pour tuer 60 Soldats garrosh’ar et détruire 8 Déchiqueteurs garrosh’ar. Ensuite, coulez le Faucheur de Lamepoing et la Balafre stygienne.‡驾驶天火号旋翼机击败60个加尔鲁什尔士兵并摧毁8台加尔鲁什尔粉碎者，然后击沉刃拳掠夺者号和冥河疤痕号。‡',
  }
},
[31733] = {
  {
    'Para o chão‡Коснуться земли‡Sichere Landung‡강하‡Tocar tierra‡‡Prise de terrain‡天降神兵‡',
    nil,
    'Use a Paraquedas do Celesfogo para chegar ao chão no Posto Garrosh\'ar, depois fale com Sully McLeary, o Picles. Uma‡Используйте парашют "Небесного огня", чтобы приземлиться в лагере Гаррош\'ар, после чего поговорите с Салли "Рассольным" Маклири.‡Springt mit einem Fallschirm der Himmelsfeuer über Garrosh\'ar ab und sprecht mit Sully "der Gurke" McLeary.‡하늘불꽃호 낙하산을 사용하여 가로쉬아르 거점으로 침투한 후, "작은 고추" 설리 맥리어리와 대화해야 합니다.‡Usa un paracaídas de El Abrasacielos para aterrizar en el Puesto Garrosh\'ar, luego habla con Sully "Liante" McLeary.‡‡Utilisez un Parachute du Brûleciel pour toucher terre au Point Garrosh’ar, puis parlez à Sully « la Saumure » McLeary.‡使用天火号降落伞降落至加尔鲁什尔前哨站，然后和“腌菜”苏利·麦克莱利谈一谈。‡',
  }
},
[31734] = {
  {
    'Carroças de boas-vindas‡Яркая встреча‡Böllerwagen‡전차 환영식‡Carros de fuego‡‡Des wagons de bienvenue‡摧毁战车‡',
    nil,
    'Use o Sinalizador de Sully para destruir 5 Carroças de Guerra da Horda. Uma‡Используйте сигнальный пистолет Салли, чтобы уничтожить 5 боевых повозок Орды.‡Zerstört mit Sullys Leuchtpistole 5 Kriegswagen der Horde.‡설리의 신호탄을 사용하여 호드 전차 5개를 파괴해야 합니다. 레벨 10 비취 숲‡Utiliza la pistola de bengalas de Sully para destruir 5 carros de guerra de la Horda.‡‡Utilisez le Lance-fusées de Sully pour détruire 5 Chariots de guerre de la Horde.‡用苏利的信号枪摧毁5辆部落战车。‡',
  }
},
[31735] = {
  {
    'A ferramenta certa‡Подходящий инструмент‡Das richtige Werkzeug zur Hand‡일에 적합한 도구‡La herramienta correcta‡‡Le bon outil‡物尽其用‡',
    nil,
    'Use o Sinalizador de Sully para explodir as barricadas e enfrentar Ga\'trul nas docas. Uma‡Используйте сигнальный пистолет Салли, чтобы уничтожить баррикады, и сразитесь с Га\'трулом на другом конце дока.‡Räumt mit Sullys Leuchtpistole die Barrikaden und konfrontiert Ga\'trul am Ende des Docks.‡설리의 신호탄을 사용하여 방벽을 없애고, 부두 끝에 있는 가트룰과 맞서야 합니다. 레벨 10 비취 숲‡Utiliza la pistola de bengalas de Sully para destruir las barricadas y enfrentarte a Ga\'trul al final del muelle.‡‡Utilisez le Lance-fusées de Sully pour déblayer les barricades et arrêter Ga’trul au bout du quai.‡用苏利的信号枪清除路障，然后在码头的尽头直面加图尔。‡',
  }
},
[31736] = {
  {
    'Enviado da Aliança‡Посланник Альянса‡Gesandter der Allianz‡얼라이언스 특사‡Representante de la Alianza‡‡Émissaire de l’Alliance‡联盟使节‡',
    nil,
    'Encontre e fale com o líder da Aldeia Pata\'don. Uma‡Найдите мэра деревни Лап\'дон и поговорите с ним.‡Spürt den Anführer von Pel\'zin auf und trefft Euch mit ihm.‡포우돈 마을의 지도자를 찾아서 대화해야 합니다. 레벨 10 비취 숲‡Encuentra al líder de la Aldea Zarpa\'don y reúnete con él.‡‡Trouvez le chef de Pao’don et présentez-vous à lui.‡找到并会见坡东村的首领。‡',
  }
},
[31737] = {
  {
    'O custo da guerra‡Цена войны‡Der Preis des Krieges‡전쟁의 대가‡El precio de la guerra‡‡Le prix de la guerre‡战争的代价‡',
    nil,
    'Mate 10 Fantasmas do Sha e 5 Emissários do Sha no Posto Garrosh\'ar. Uma‡Убейте 10 |4наваждение:наваждения:наваждений; ша и 5 ша – вестников ужаса в лагере Гаррош\'ар.‡Tötet 10 Sha-Heimsuchungen und 5 Sha-Herolde bei Garrosh\'ar.‡가로쉬아르 거점에서 샤 귀신 10마리와 샤 전령 5마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 10 tormentos de sha y 5 presagistas de sha en Puesto Garrosh\'ar.‡‡Tuez 10 Hantises sha et 5 Messagers sha au Point Garrosh’ar.‡杀死加尔鲁什尔前哨站里的10个徘徊煞魔和5个煞魔先驱。‡',
  }
},
[31738] = {
  {
    'Peões larápios‡Батраки-мародеры‡Plündernde Peons‡일꾼 학살‡Peones saqueadores‡‡Les péons pilleurs‡表明诚意‡',
    nil,
    'Mate 12 Capatazes das Agulhas Gêmeas ou Peões das Agulhas Gêmeas. Uma‡Убейте 12 надсмотрщиков или батраков из Двух Башен.‡Tötet 12 Vorarbeiter oder Peons von Zwillingsfels.‡쌍둥이 첨탑 작업반장 또는 쌍둥이 첨탑 일꾼 12명을 처치해야 합니다. 레벨 10 비취 숲‡Mata a 12 maestros de tareas de Agujas Gemelas o peones de Agujas Gemelas.‡‡Tuez 12 Sous-chefs ou Péons des Flèches jumelles.‡击败12个双塔工头或双塔劳工。‡',
  }
},
[31739] = {
  {
    'Prioridades!‡Приоритеты!‡Prioritäten!‡우선순위!‡¡Prioridades!‡‡Établir ses priorités‡最优先事项！‡',
    nil,
    'Colete 6 barris de Sidra Flor de Maçã. Uma‡Соберите 6 бочек сидра Яблоневого Цвета.‡Sammelt 6 Fässer Apfelblütenwein.‡애플블룸 탄산주 6개를 모아야 합니다. 레벨 10 비취 숲‡Reúne 6 barriles de sidra Manzana Jugosa.‡‡Récupérez 6 Cidres de fleur de pommier.‡收集6桶苹花甜酒。‡',
  }
},
[31740] = {
  {
    'O Alvoroço de Koukou‡Буйство Куку‡Kaukaus Randale‡코우코우의 광란‡El desenfreno de Koukou‡‡Koukou sort de saccage‡丧失理智的扣扣‡',
    nil,
    'Mate Koukou. Uma‡Убейте Куку.‡Tötet Kaukau.‡코우코우를 처치해야 합니다. 레벨 10 비취 숲‡Mata a Koukou.‡‡Tuez Koukou.‡击败扣扣。‡',
  }
},
[31741] = {
  {
    'Bastilha das Agulhas Gêmeas‡Крепость Двух Башен‡Burg Zwillingsfels‡쌍둥이 첨탑 요새‡La Fortaleza de las Agujas Gemelas‡‡Le donjon des Flèches jumelles‡双塔堡垒‡',
    nil,
    'Mate 15 membros da Horda na Bastilha das Agulhas Gêmeas. Uma‡Убейте 15 солдат Орды в Крепости Двух Башен.‡Tötet 15 Gefolgsleute der Horde in der Burg Zwillingsfels.‡쌍둥이 첨탑 요새에서 호드 병사 15명을 처치해야 합니다. 레벨 10 비취 숲‡Mata a 15 soldados de la Horda en la Fortaleza de las Agujas Gemelas.‡‡Tuez 15 Soldats de la Horde au Donjon des Flèches jumelles.‡在双塔堡垒杀死15个部落士兵。‡',
  }
},
[31742] = {
  {
    'Tropas fraturadas‡Разрозненные силы‡Fragmentierte Fraktion‡쪼개진 연합‡Fuerzas divididas‡‡Des troupes divisées‡内讧‡',
    nil,
    'Mate Dalgan e Bellandra Vilprocella. Uma‡Убить Далгана и Белландру Бурю Скверны.‡Tötet Dalgan und Bellandra Teufelssturm.‡달간과 벨란드라 펠스톰을 처치해야 합니다. 레벨 10 비취 숲‡Mata a Dalgan y a Bellandra Tormenta Vil.‡‡Tuez Dalgan et Bellandra Gangrorage.‡杀死达尔甘和贝兰德拉·邪风。‡',
  }
},
[31743] = {
  {
    'Fumaça antes do fogo‡Дым над Ордой‡Vor Feuer kommt Rauch‡연기 뒤에는 불꽃이‡Donde hay humo...‡‡De la fumée sans feu‡空中打击‡',
    nil,
    'Use o Sinalizador da Aliança para ordenar um ataque aéreo na Pilha de Munições, nos Demolidores Agulhas Gêmeas, nos Diabretes Selvagens e em Xhu\'daggab.‡Используйте сигнальный огонь Альянса, чтобы вызвать воздушный удар по груде боеприпасов, разрушителям Двух Башен, диким бесам и Ксу\'даггабе.‡Fordert mit dem Rauchsignal der Allianz einen Luftangriff auf den Munitionshaufen, die Demolierer von Zwillingsfels, die Wildwichtel und Xhu\'daggab an.‡얼라이언스 신호탄을 사용하여 탄약 더미, 쌍둥이 첨탑 파괴전차, 날뛰는 임프, 츄다가브에 대한 공중 포격을 요청해야 합니다.‡Usa la bengala de la Alianza para lanzar un ataque aéreo contra las reservas de munición, las demoledoras de Agujas Gemelas, los diablillos salvajes y Xhu\'daggab.‡‡Utilisez la Fusée de l’Alliance pour guider une frappe aérienne sur la Pile d’explosifs, les Démolisseurs des Flèches jumelles, les Diablotins sauvages et Xhu’daggab.‡使用联盟信号弹，对成堆的军火、双塔投石车、野鬼还有克胡达葛布召唤一次空中打击。‡',
  }
},
[31744] = {
  {
    'Negócio injusto‡Нечестная торговля‡Unfairer Handel‡불공정한 거래‡Intercambio injusto‡‡Commerce pas équitable‡不公平的交易‡',
    nil,
    'Liberte 8 Filhotes de Pandaren Cativos da Bastilha das Agulhas Gêmeas, matando os olhos demoníacos que os vigiam. Uma‡Освободите 8 захваченных юных пандаренов из Крепости Двух Башен, уничтожив демонические очи, которые их сторожат.‡Befreit 8 gefangene Pandarenkinder aus der Burg Zwillingsfels, indem Ihr die dämonischen Augen tötet, von denen sie bewacht werden.‡쌍둥이 첨탑 요새에서 포로를 감시하는 악마의 눈을 처치하고, 사로잡힌 아기 판다렌 8명을 구출해야 합니다.‡Libera a 8 cachorros pandaren cautivos de la Fortaleza de las Agujas Gemelas acabando con los globos oculares demoníacos que los vigilan. Un(a) misión.‡‡Libérez 8 Jeunes pandarens captifs au Donjon des Flèches jumelles en tuant les globes oculaires démoniaques qui les surveillent. Un(e) quête.‡杀死双塔堡垒处负责看守的恶魔之眼，释放8个被俘的熊猫人幼崽。‡',
  }
},
[31745] = {
  {
    'Mais idas e vindas‡Все дальше и дальше‡Vorwärts ins Landesinnere‡앞으로, 그리고 안으로‡Adelante, hacia el interior‡‡Plus loin et plus profond‡继往开来‡',
    nil,
    'Apresente-se ao Almirante Rogers na Aldeia Pata\'don, que fica na Floresta de Jade. Uma‡Явитесь к адмиралу Роджерс в деревне Лап\'дон в Нефритовом лесу.‡Erstattet Himmelsadmiralin Rogers in Pel\'zin im Jadewald Bericht.‡비취 숲의 포우돈 마을에 있는 제독 로저스에게 보고해야 합니다. 레벨 10 비취 숲‡Preséntate ante la almirante Rogers en la Aldea Zarpa\'don, en El Bosque de Jade.‡‡Faites votre rapport à l’Amiral Rogers à Pao’don, dans la Forêt de Jade.‡去翡翠林的坡东村向罗杰斯上将报到。‡',
  }
},
[31752] = {
  {
    'Blingtron 4000‡"Блескотрон-4000"‡Blingtron 4000‡블링트론 4000‡Joyatrón 4000‡‡Bling-o-tron 4000‡布林顿4000‡',
    nil,
    'Fico feliz de ofertar este presente a você, &lt;race&gt; &lt;class&gt;. Eu o calibrei para gerar sentimentos de felicidade e gratidão.Tenha um bom dia.‡Мне приятно подарить тебе эту вещь, |3-6(Паладин) – |3-6(человек). По моим расчетам она заставит тебя почувствовать радость и признательность.Удачи!‡Es freut mich sehr, Euch dieses Geschenk überreichen zu dürfen, &lt;Volk&gt;. Laut meinen Berechnungen sollte es Gefühle der Freude und Dankbarkeit hervorrufen.Einen schönen Tag noch.‡이 선물을 줄 수 있어서 기쁩니다, &lt;race&gt; &lt;class&gt;|1이여;여;. 제 계산에 따르면, 이 선물은 기쁨과 감사의 감정을 유발할 것입니다.좋은 하루 보내십시오.‡Me satisface entregarte esto, &lt;raza&gt; &lt;clase&gt;. Según mis calibraciones, invocará sensaciones de alegría y gratitud.Que tengas un buen día.‡‡Quelle joie de vous offrir ce cadeau, &lt;classe&gt; &lt;race&gt;. D’après mes réglages, il provoquera des sentiments de joie et de gratitude.Bonne journée.‡‡',
  }
},
[31754] = {
  {
    'Disparos de canhão‡Огневая поддержка‡Kanonenfeuer‡대포 발사‡Fuego de cañón‡‡Leçon du canon‡炮火连天‡',
    nil,
    'Destrua 7 Canhões Shao-Tien. Uma‡Уничтожьте 7 пушек Шао-Тень.‡Zerstört 7 Kanonen der Shao-Tien.‡샤오티엔 대포 7개를 파괴해야 합니다. 레벨 30 영원꽃 골짜기‡Destruye 7 cañones Shao-Tien.‡‡Détruisez 7 Canons shao-tien.‡摧毁7门韶天火炮。‡',
  }
},
[31755] = {
  {
    'Atos de Crueldade‡Жестокий поступок‡Grausamkeiten‡잔인한 행위‡Actos de crueldad‡‡Actes de cruauté‡残暴行径‡',
    nil,
    'Resgate 5 Guardas do Lótus Dourado ou Aldeões do Cair da Bruma. Uma‡Спасите 5 стражей Золотого Лотоса или жителей деревни Туманного Водопада. задание.‡Rettet 5 Wachposten des Goldenen Lotus oder Dorfbewohner von Nebelhauch.‡황금 연꽃 경비병 또는 안개내림 주민 5명을 구출해야 합니다. 레벨 30 영원꽃 골짜기‡Rescata a 5 guardias del Loto Dorado o habitantes de Bruma Otoñal.‡‡Sauvez 5 Gardes du Lotus doré ou Villageois de Tombe-Brume.‡营救5名金莲卫士或雾临村民。‡',
  }
},
[31756] = {
  {
    'Boas chances de chuva‡Кажется, дождь собирается‡Hohe Regenwahrscheinlichkeit‡비 올 확률 99.9%‡Gran probabilidad de lluvia‡‡Fortes chances de pluie‡阻止风暴‡',
    nil,
    'Destruir os cajados Tempestários. Uma‡Уничтожьте призывающие бурю посохи.‡Zerstört die Sturmruferstäbe.‡폭풍소환기를 파괴해야 합니다. 레벨 30 영원꽃 골짜기‡Destruye los bastones de clamatormentas.‡‡Détruisez les Bâtons des Mande-foudre.‡摧毁引风杖。‡',
  }
},
[31757] = {
  {
    'Espíritos Liberados‡Освобожденные духи‡Entfesselte Geister‡방출된 영혼‡Espíritus desatados‡‡Esprits déchaînés‡获释的灵魂‡',
    nil,
    'Mate 12 Espíritos Liberados. Uma‡Убейте 12 освобожденных духов.‡Tötet 12 entfesselte Geister.‡방출된 영혼 12명을 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 12 espíritus desatados.‡‡Tuez 12 Esprits déchaînés.‡击败12个获释的灵魂。‡',
  }
},
[31758] = {
  {
    'Levaram o Pés Leves‡Разведка‡Laosige Arbeit‡라오다운 정찰‡Pícaro sin picardía‡‡L’a eu pas de bol‡又被抓了‡',
    nil,
    'Resgate Lao Pés Leves. Uma‡Спасите Лао Легкую Ногу.‡Rettet Lao Samtfuß.‡라오 소프트풋을 구출해야 합니다. 레벨 30 영원꽃 골짜기‡Rescata a Lao Paso Cauto.‡‡Sauvez Lao Pas de Loup.‡营救劳·软足。‡',
  }
},
[31760] = {
  {
    'Primeiro golpe‡Превентивный удар‡Erstschlag‡선수 치기‡Golpear primero‡‡Frapper les premiers‡先发制人‡',
    nil,
    'Impeça o Beemote Shao-Tien de ser energizado. Uma‡Остановите ритуал усиления колосса Шао-Тень.‡Verhindert, dass das Ungetüm der Shao-Tien an Macht gewinnt.‡모구가 샤오티엔 거수에 힘을 불어넣지 못하도록 막아야 합니다. 레벨 30 영원꽃 골짜기‡Impide que potencien al behemoth Shao-Tien.‡‡Empêchez l’activation du Béhémoth shao-tien.‡阻止魔古族启动韶天巨兽。‡',
  }
},
[31761] = {
  {
    'Quebre a força de vontade deles (Não implementado)‡Breaking Their Spirits (Not Yet Implemented)‡Demoralisierung‡‡Golpe al espíritu (Not Yet Implemented)‡‡Ils perdent l\'esprit‡‡',
    nil,
    'Detenha o Ritual dos Espíritos Shao-Tien. Uma‡Остановите ритуал насылания духов Шао-Тень.‡Beendet das Geisterritual der Shao-Tien.‡‡Detén el ritual espiritual Shao-Tien.‡‡Arrêtez le Rituel des esprits shao-tien.‡‡',
  }
},
[31762] = {
  {
    'Beemote Esfacelado‡Рассыпающийся колосс‡Bröckelndes Ungetüm‡거수와 한 판‡Derribar al behemoth‡‡Réduire en miettes le béhémoth‡崩裂的巨兽‡',
    nil,
    'Destrua o Beemote Shao-Tien. Uma‡Уничтожьте колосса Шао-Тень.‡Zerstört das Ungetüm der Shao-Tien.‡샤오티엔 거수를 파괴해야 합니다. 레벨 30 영원꽃 골짜기‡Acaba con el behemoth Shao-Tien.‡‡Détruisez le Béhémoth shao-tien.‡摧毁韶天巨兽。‡',
  }
},
[31764] = {
  {
    '‡‡‡화재 진압‡‡‡‡‡',
    nil,
    '‡‡‡레벨 5 비취 숲‡‡‡‡‡',
  }
},
[31765] = {
  {
    'Pintando de vermelho‡Раскрась мир красным!‡Rot und tot!‡붉게 물들여!‡¡Tíñelos de rojo!‡‡Peignons les roses en rouge !‡血染滩头！‡',
    nil,
    'Use uma Torreta da Belonave para matar 80 tropas do Forte do Trovão e destruir 9 canhões do Forte do Trovão. Uma‡Используйте башню боевого корабля, чтобы уничтожить 80 солдат и 9 пушек Громовой крепости.‡Benutzt ein Kanonenbootgeschütz, um 80 Gefolgsleute von Donnerwehr zu töten und 9 Kanonen von Donnerwehr zu zerstören.‡비행포격선 포탑을 사용하여 천둥 요새 병사 80명을 처치하고 천둥 요새 대포 9문을 파괴해야 합니다.‡Usa una torreta de nave de guerra para mata a 80 tropas del Bastión del Trueno y para destruir 9 cañones del Bastión del Trueno. Un(a) misión.‡‡Utilisez une Tourelle de la canonnière pour tuer 80 soldats du bastion du Tonnerre et détruire 9 Canons du bastion du Tonnerre.‡利用炮舰炮台杀死80个雷霆要塞士兵，并摧毁9座雷霆要塞加农炮。‡',
  }
},
[31766] = {
  {
    'Para o chão‡Коснуться земли‡Sichere Landung‡강하‡Tocar tierra‡‡Descente en rappel‡天降神兵‡',
    nil,
    'Use uma Corda de Rapel para chegar ao solo. Uma‡Используйте канат для спуска, чтобы добраться до земли.‡Benutzt einen Abseilstrick, um nach unten zu gelangen.‡하강용 밧줄을 사용하여 지상으로 내려가야 합니다. 레벨 10 비취 숲‡Usa una soga de rápel para llegar al suelo.‡‡Utilisez une Corde de rappel pour descendre à terre.‡使用垂降绳索降落至地面。‡',
  }
},
[31767] = {
  {
    'Acabe com eles!‡Прикончить их!‡Macht sie kalt!‡놈들을 끝장내자!‡¡Acaba con ellos!‡‡Achevez-les !‡干掉他们！‡',
    nil,
    'Mate 15 inimigos no Forte do Trovão. Uma‡Уничтожьте 15 солдат Громовой крепости.‡Tötet 15 Truppen von Donnerwehr.‡천둥 요새 병사 15명을 처치해야 합니다. 레벨 10 비취 숲‡Mata a 15 soldados del Bastión del Trueno.‡‡Tuez 15 soldats du bastion du Tonnerre.‡击败15个雷霆要塞士兵。‡',
  }
},
[31768] = {
  {
    'O fogo é sempre a resposta‡Огонь – лучший ответ‡Feuer ist immer die richtige Antwort‡정답은 언제나 불‡El fuego siempre es la respuesta‡‡Le feu a réponse à tout‡火总是那么管用‡',
    nil,
    'Destrua 10 Pilhas de Munição do Forte do Trovão. Uma‡Уничтожьте 10 штабелей боеприпасов Громовой крепости.‡Zerstört 10 Stapel Munition von Donnerwehr.‡천둥 요새 탄약 더미 10개를 파괴해야 합니다. 레벨 10 비취 숲‡Destruye 10 municiones del Bastión del Trueno.‡‡Détruisez 10 piles de Munitions du bastion du Tonnerre.‡烧毁10堆雷霆要塞军火。‡',
  }
},
[31769] = {
  {
    'O golpe final!‡Завершающий удар!‡Der letzte Schlag!‡최후의 일격!‡¡El golpe de gracia!‡‡Le coup final !‡致命一击！‡',
    nil,
    'Mate o Capitão Doren no Forte do Trovão. Uma‡Уничтожьте капитана Дорена в Громовой крепости.‡Tötet Hauptmann Doren in Donnerwehr.‡천둥 요새에서 대장 도렌을 처치해야 합니다. 레벨 10 비취 숲‡Mata al capitán Doren en el Bastión del Trueno.‡‡Tuez le Capitaine Doren au Bastion du Tonnerre.‡杀死雷霆要塞里的多伦上尉。‡',
  }
},
[31770] = {
  {
    'Ou você está conosco ou...‡Или с нами, или...‡Ihr seid entweder auf unserer Seite oder...‡우리와 한편이 아니라면...‡O estás con nosotros o...‡‡Soit vous êtes avec nous, soit…‡要么服从要么……‡',
    nil,
    'Tente conquistar a cooperação do Prefeito Orvalho de Mel na Aldeia do Mel. Uma‡Попытайтесь заручиться поддержкой мэра Медовая Роса в Деревне Медовой Росы.‡Versucht, die Hilfe von Bürgermeister Honigtau in Honigtau zu gewinnen.‡꿀이슬 마을에 있는 시장 허니듀의 도움을 받아내야 합니다. 레벨 10 비취 숲‡Intenta obtener la ayuda del alcalde Almíbar en el Poblado Almíbar.‡‡Essayez d’obtenir l’aide du Maire de Rosée-de-Miel, à Rosée-de-Miel.‡尝试取得蜜露村村长的帮助。‡',
  }
},
[31771] = {
  {
    'Encarando as consequências‡Лицом к лицу с последствиями‡Im Angesicht der Konsequenzen‡결과를 직시하라‡Afrontar las consecuencias‡‡Faire face aux conséquences‡自食恶果‡',
    nil,
    'Abata 20 Fantasmas do Sha e 7 Emissários do Sha. Uma‡Убейте 20 наваждений ша и 7 ша – вестников ужаса.‡Tötet 20 Shaheimsuchungen und 7 Sha-Herolde.‡샤 귀신 20마리와 샤 전령 7마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 20 tormentos de sha y 7 presagistas de sha.‡‡Tuez 20 Hantises sha et 7 Messagers sha.‡杀死20个徘徊煞魔和7个煞魔先驱。‡',
  }
},
[31772] = {
  {
    'Prioridades!‡Приоритеты!‡Prioritäten!‡우선순위!‡¡Prioridades!‡‡C’est une priorité !‡酒最珍贵！‡',
    nil,
    'Encontre 6 Barris de Cerveja de Mel na Clareira do Mel. Uma‡Найдите 6 бочек медового хмеля на поляне Медовой Росы.‡Findet 6 Fässer mit Honigbräu auf der Honigtaulichtung.‡꿀이슬 숲에서 꿀술 통 6개를 찾아야 합니다. 레벨 10 비취 숲‡Encuentra 6 barricas de birramiel en el Claro Almíbar.‡‡Trouvez 6 Tonneaux de Brassemiel dans la Clairière de Rosée-de-Miel.‡在蜜露林地里找回6桶蜜酒。‡',
  }
},
[31773] = {
  {
    'Problemas predatórios‡Докучливые хищники‡Pirscherschwierigkeiten‡골칫덩이 호랑이들‡Problemas con los merodeadores‡‡Problèmes de rôdeurs‡徘徊者危机‡',
    nil,
    'Destrua 10 Predadores Infestados pelo Sha na Clareira do Mel. Uma‡Уничтожьте 10 зараженных ша хищников на Поляне Медовой Росы.‡Tötet 10 Sha-verseuchte Pirscher auf der Honigtaulichtung.‡꿀이슬 숲에서 샤에 물든 호랑이 10마리를 처치해야 합니다. 레벨 10 비취 숲‡Destruye a 10 merodeadores infestados de sha en el Claro Almíbar.‡‡Tuez 10 Rôdeurs contaminés par les sha dans la Clairière de Rosée-de-Miel.‡在蜜露林地消灭10只染煞徘徊者。‡',
  }
},
[31774] = {
  {
    'À procura de Zin\'Jun‡В поисках Зин\'Джуна‡Die Suche nach Zin\'Jun‡진준을 찾아서‡Buscar a Zin\'jun‡‡À la recherche de Zin’jun‡寻找金祖恩‡',
    nil,
    'Localize Zin\'jun em algum ponto na Ascensão dos Ventos Revoltos. Uma‡Найдите Зин\'Джуна где-то на Возвышенности Кружащихся Ветров.‡Findet Zin\'jun irgendwo im Aufstieg der Wirbelnden Winde.‡소용돌이치는 바람의 오르막길 어딘가에 있는 진준을 찾아야 합니다. 레벨 10 비취 숲‡Encuentra a Zin\'jun en alguna parte del Ascenso de la Espiral de Viento.‡‡Retrouvez Zin’jun à l’Ascension des Vents tourbillonnants.‡在旋风高地的某个地方找到金祖恩。‡',
  }
},
[31775] = {
  {
    'Ataque à pista de pouso‡Нападение на взлетную полосу‡Angriff auf den Flugplatz‡비행장 급습‡Asalto a la pista de aterrizaje‡‡L\'attaque de la piste‡突袭机坪‡',
    nil,
    'Mate 15 inimigos na Pista de Pouso Pulso Firme. Uma‡Убейте 15 бойцов Сильной Руки на Взлетной полосе Сильной Руки.‡Tötet 15 Starkarmsoldaten auf dem Starkarmflugplatz.‡우격다짐 비행장에서 우격다짐 병사 15명을 처치해야 합니다. 레벨 10 비취 숲‡Mata a 15 soldados de Armafuerte en la Pista de Aterrizaje Armafuerte.‡‡Tuez 15 Soldats de Gros-Bras à la Piste d\'atterrissage de Gros-Bras.‡在铁腕机坪击败15个铁腕士兵。‡',
  }
},
[31776] = {
  {
    'Táticas de Pulso Firme‡Слабости Сильной Руки‡Starkarmtaktiken‡우격다짐의 전술적 핵심‡Tácticas de Armafuerte‡‡Jouons les gros bras‡铁腕战术‡',
    nil,
    'Mate o Cabo Jackson Silva, Morgus Grã-Machete, o Mestre Mecânico Gira-tranca e o Giro-Engenheiro Lavenderp. Uma‡Убейте капрала Джексона Сильвера, Моргуса Вредоруба, а также старшего инженера Гайкокрутса и гиро-механика Клейкомяша.‡Tötet Korporal Jackson Silver, Morgus Grimmbeil, Meisteringenieur Ritzelschwung und Gyromechanikerin Lavendelol.‡하사관 잭슨 실버, 모거스 그림햇쳇, 수석기술자 코그스윙, 자이로 기술자 라벤더프를 처치해야 합니다.‡Mata al cabo Jackson Silver, a Morgus Hachasevera, al maestro ingeniero Alapiñón y a la giromecánica Lavenderp.‡‡Tuez le Caporal Jackson Silver, Morgus Hache-Funeste, le Maître ingénieur Tourneboulon et le Gyro-mécano Lavenderp.‡杀死杰克逊·希尔瓦下士、莫格斯·凶斧、首席技师克格斯温还有陀螺技师拉文德普。‡',
  }
},
[31777] = {
  {
    'Destrua os girocópteros!‡"Фейерверк"‡Runter kommen sie alle‡사격 연습‡Helicoportunidad‡‡Artifice anti-aérien‡土制火箭筒‡',
    nil,
    'Coletar Lançadores de Fogos de Artifício Requisitados na Pista de Pouso Pulso Firme e usá-los em 12 Girocópteros de Pulso Firme. Um(a) missão.‡Соберите конфискованные установки для фейерверков на Взлетной полосе Сильной Руки, а затем примените их против 12 гирокоптеров Сильной Руки.‡Beschafft Euch auf dem Starkarmflugplatz Zugriff auf requirierte Feuerwerkszünder und setzt diese gegen 12 Starkarmgyrokopter ein.‡우격다짐 비행장에서 징발된 폭죽 발사기를 획득한 후 사용하여 우격다짐 자이로콥터 12대를 격추시켜야 합니다.‡Recoge lanzadores de fuegos artificiales requisados en la Pista de Aterrizaje Armafuerte y utilízalos contra 12 girocópteros de Armafuerte.‡‡Ramassez des Lanceurs de feux d\'artifices réquisitionnés à la Piste d\'atterrissage de Gros-Bras et utilisez-les pour tirer sur 12 Gyrocoptères de Gros-Bras.‡拾取铁腕机坪里被征用的烟花发射器，然后用它们来击落12架铁腕旋翼机。‡',
  }
},
[31778] = {
  {
    'Aliados inconstantes‡Ненадежные союзники‡Unverlässliche Verbündete‡불안정한 동맹‡Aliados poco fiables‡‡Des alliés peu fiables‡是敌非友‡',
    nil,
    'Encoraje 12 Voluntários Pandarens a deixar Pista de Pouso Pulso Firme. Uma‡Убедите 12 пандаренов-добровольцев уйти со Взлетной полосы Сильной Руки. задание.‡Bringt 12 Pandarenfreiwillige dazu, den Starkarmflugplatz zu verlassen.‡판다렌 지원자 12명을 설득하여 우격다짐 비행장을 탈출하게 해야 합니다. 레벨 10 비취 숲‡Anima a 12 voluntarios pandaren a que abandonen la Pista de Aterrizaje Armafuerte.‡‡Encouragez 12 Volontaires pandarens à quitter la Piste d’atterrissage de Gros-Bras.‡鼓励12个熊猫人志愿者离开铁腕机坪。‡',
  }
},
[31779] = {
  {
    'Trevas interiores‡Тьма внутри‡Das dunkle Innere‡내면의 어둠‡La oscuridad interior‡‡Noirceur intérieure‡掘地三尺‡',
    nil,
    'Mate o Capitão Doren. Uma‡Убейте капитана Дорена.‡Tötet Hauptmann Doren.‡대장 도렌을 처치해야 합니다. 레벨 10 비취 숲‡Mata al capitán Doren.‡‡Tuez le Capitaine Doren.‡击败多伦上尉。‡',
  }
},
[31780] = {
  {
    'Zé Urtigueiro‡Старик Макдональд‡Mac Donald‡노인 맥도날드‡Viejo MacDonald‡‡Le vieux MacDonald‡老马当劳‡',
    nil,
    'Vença Zé Urtigueiro numa batalha de mascotes. Uma‡Победите старика Макдональда в битве питомцев. это‡Besiegt Mac Donald in einem Haustierkampf.‡애완동물 대전에서 노인 맥도날드를 꺾어야 합니다. 레벨 1‡Derrota al viejo MacDonald en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre le Vieux MacDonald.‡在宠物战斗中击败老马当劳。‡',
  }
},
[31781] = {
  {
    'Rosinha‡Линдси‡Lindsay‡린제이‡Lindsay‡‡Lindsay‡林塞‡',
    nil,
    'Vença Rosinha numa batalha de mascotes. Uma‡Победите Линдси в битве питомцев. это‡Besiegt Lindsay in einem Haustierkampf.‡애완동물 대전에서 린제이를 꺾어야 합니다. 레벨 1‡Derrota a Lindsay en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Lindsay.‡在宠物战斗中击败林塞。‡',
  }
},
[31782] = {
  {
    'O golpe‡Свержение‡Umsturz‡왕좌에 도전하라‡El derrocamiento‡‡Détrônée‡颠覆‡',
    nil,
    'Fale com Klaxxi\'va Vor em Klaxxi\'vess. Uma‡Поговорите с клакси\'ва Вор в Клакси\'вессе.‡Sprecht mit Klaxxi\'va Ik in Klaxxi\'vess.‡클락시베스에 있는 클락시바 보르와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con el Klaxxi\'va Vor en Klaxxi\'vess.‡‡Parlez à Klaxxi’va Vor à Klaxxi’vess.‡与卡拉克西维斯的卡拉克西瓦·沃尔交谈。‡',
  }
},
[31784] = {
  {
    'Ovo de novo‡Полезный оникс‡Onyxquisit‡소중한 알은 안전한 곳에‡Ónice del bueno‡‡En onyx véritable‡纯真玛瑙‡',
    nil,
    'O que você tem aí, &lt;name&gt;? Uma‡Что это там у тебя, Скарпиа?‡Was habt Ihr da, &lt;Name&gt;?‡거기 뭘 가져온 건가, &lt;name&gt;? 레벨 10 비취 숲‡¿Qué tienes ahí, &lt;nombre&gt;?‡‡Qu’est-ce que vous avez là, &lt;nom&gt; ?‡‡',
  }
},
[31785] = {
  {
    'Passe de Nível!‡Новый уровень!‡Stufenaufstieg‡레벨 상승!‡¡Siguiente nivel!‡‡On passe au niveau supérieur !‡升级！‡',
    nil,
    'Elevar uma mascote ao nível 3. Uma‡Повысьте уровень питомца до 3-го. это‡Lasst ein Haustier auf Stufe 3 aufsteigen.‡애완동물을 3 레벨까지 올려야 합니다. 레벨 1‡Sube a una mascota al nivel 3.‡‡Faites atteindre le niveau 3 à une mascotte.‡将一个宠物提升至3级。‡',
  }
},
[31786] = {
  {
    'Grilhões Impecáveis da Rebelião‡Безупречные оковы мятежника‡Makellose Fesseln der Rebellion‡온전한 반란의 수갑‡Esposas de rebelión prístinas‡‡Menottes de rébellion en parfait état‡完好如初的叛军的镣铐‡',
    nil,
    'Colocar o artefato em exibição. Uma‡Выставите артефакт на обозрение. это‡Stellt das Artefakt zur Schau.‡유물을 전시해야 합니다. 레벨 10‡Expón el artefacto.‡‡Exposez l’artéfact.‡将神器进行展览。‡',
  }
},
[31787] = {
  {
    'Pedra Rúnica Mogu Impecável‡Безупречный рунический камень могу‡Makelloser Runenstein der Mogu‡온전한 모구 마법석‡Piedra rúnica mogu prístina‡‡Pierre runique mogu en parfait état‡完好如初的魔古符文石‡',
    nil,
    'Colocar o artefato em exibição. Uma‡Выставите артефакт на обозрение. это‡Stellt das Artefakt zur Schau.‡유물을 전시해야 합니다. 레벨 10‡Expón el artefacto.‡‡Exposez l’artéfact.‡将神器进行展览。‡',
  }
},
[31788] = {
  {
    'Braço de Terracota Impecável‡Безупречная терракотовая рука‡Makelloser Arm aus Terrakotta‡온전한 토우 팔‡Brazo de terracota prístino‡‡Bras en terre cuite en parfait état‡完好如初的陶俑手臂‡',
    nil,
    'Colocar o artefato em exibição. Uma‡Выставите артефакт на обозрение. это‡Stellt das Artefakt zur Schau.‡유물을 전시해야 합니다. 레벨 10‡Expón el artefacto.‡‡Exposez l’artéfact.‡将神器进行展览。‡',
  }
},
[31789] = {
  {
    'Chicote de Osso Petrificado Impecável‡Безупречный окаменевший костяной хлыст‡Makellose versteinerte Peitsche aus Knochen‡온전한 석화된 뼈 채찍‡Látigo de huesos petrificado prístino‡‡Fouet en os pétrifié en parfait état‡完好如初的石化的骨鞭‡',
    nil,
    'Colocar o artefato em exibição. Uma‡Выставите артефакт на обозрение. это‡Stellt das Artefakt zur Schau.‡유물을 전시해야 합니다. 레벨 10‡Expón el artefacto.‡‡Exposez l’artéfact.‡将神器进行展览。‡',
  }
},
[31790] = {
  {
