[33332] = {
  {
    'Pistas do passado‡Подсказки из прошлого‡Hinweise aus der Vergangenheit‡과거의 교훈‡Pistas del pasado‡‡Les secrets du passé‡往昔的暗示‡',
    nil,
    'Compre um Diário Envelhecido da Tecelã da Névoa Ai. Uma‡Купите потрепанный дневник у ткача туманов Ай.‡Erwerbt ein von der Zeit gezeichnetes Tagebuch von Nebelwirkerin Ai.‡운무사 아이에게서 세월에 낡은 일지를 구입해야 합니다. 레벨 30 영원의 섬‡Cómprale un diario vetusto a la Tejedora de niebla Ai.‡‡Achetez un Journal usé par le temps à la Tisse-brume Ai.‡从织雾者艾莉处购买一本陈旧的日志。‡',
  }
},
[33333] = {
  {
    'Tesouros perenes‡Вневременные сокровища‡Zeitlose Schätze‡영원의 보물‡Tesoros intemporales‡‡Des trésors figés dans le temps‡永恒宝藏‡',
    nil,
    'Encontre um Tesouro Escondido na Ilha Perene. Uma‡Найдите спрятанное на Вневременном острове сокровище.‡Findet einen verborgenen Schatz auf der Zeitlosen Insel.‡영원의 섬에서 숨겨진 보물을 찾아야 합니다. 레벨 30 영원의 섬‡Encuentra un tesoro escondido en la Isla Intemporal.‡‡Trouvez un Trésor caché sur l’Île du Temps Figé.‡在永恒岛上找到秘密宝藏。‡',
  }
},
[33334] = {
  {
    'Forte o bastante para sobreviver‡Выживет сильнейший‡Stark genug, um zu überleben‡적자생존‡Con la fuerza para sobrevivir‡‡Assez fort pour survivre‡强者方能存活‡',
    nil,
    'Derrote cinco criaturas Raras ou Raras de Elite na Ilha Perene. Uma‡Убейте пять редких и редких элитных существ на Вневременном острове.‡Vernichtet fünf seltene Kreaturen oder seltene Elitekreaturen auf der Zeitlosen Insel.‡영원의 섬에서 희귀 또는 희귀 정예 몬스터를 다섯 마리 처치해야 합니다. 레벨 30 영원의 섬‡Derrota a cinco criaturas poco comunes o poco comunes de élite en la Isla Intemporal.‡‡Éliminez cinq Créatures rares ou Élites rares sur l’Île du Temps Figé.‡在永恒岛上击败五位稀有或稀有精英生物。‡',
  }
},
[33335] = {
  {
    'O último imperador‡Последний император‡Der letzte Kaiser‡마지막 황제‡El último emperador‡‡Le dernier empereur‡末代皇帝‡',
    nil,
    'Fale com o Imperador Shaohao. Uma‡Поговорите с императором Шаохао.‡Sprecht mit Kaiser Shaohao.‡황제 샤오하오와 대화해야 합니다. 레벨 30 영원의 섬‡Habla con el emperador Shaohao.‡‡Parlez à l’Empereur Shaohao.‡与皇帝少昊交谈。‡',
  }
},
[33336] = {
  {
    'A essência do tempo‡Сущность времени‡Die Essenz der Zeit‡시간의 정수‡La esencia del tiempo‡‡L’essence du temps‡时间精华‡',
    nil,
    'Obtenha uma Pedra das Épocas de uma das criaturas na Ilha Perene. Uma‡Получите камень Вечности, убив одно из существ на Вневременном острове. задание.‡Erhaltet einen Epochenstein von einer Kreatur der Zeitlosen Insel.‡영원의 섬 몬스터에게서 시대의 돌을 획득해야 합니다. 레벨 30 영원의 섬‡Consigue una piedra de época de una de las criaturas de la Isla Intemporal.‡‡Collectez une Pierre d’époque sur une des créatures de l’Île du Temps Figé.‡从永恒岛的某个生物身上收集一块纪元之石。‡',
  }
},
[33337] = {
  {
    'Uma visão no tempo‡Видение во времени‡Eine Vision in der Zeit‡시간 속의 환영‡Una visión en el tiempo‡‡Une vision du temps‡时光之景‡',
    nil,
    'Use a Visão do Tempo no Cerco a Orgrimmar. Uma‡Используйте видение времени во время осады Оргриммара.‡Verwendet die Vision der Zeit in der Schlacht um Orgrimmar.‡오그리마 공성전에서 시간의 환영을 사용해야 합니다. 레벨 30 영원의 섬‡Usa la visión en el tiempo en el Asedio de Orgrimmar.‡‡Utilisez la Vision du temps lors du Siège d’Orgrimmar.‡在决战奥格瑞玛中使用时光之眼。‡',
  }
},
[33338] = {
  {
    'Energizando a ampulheta‡Сила песочных часов‡Die Macht des Stundenglases‡모래시계에 힘 불어넣기‡Potenciando el reloj de arena‡‡Renforcer le sablier‡强化沙漏‡',
    nil,
    'Colete Pedras das Épocas das criaturas na Ilha Perene. Uma‡Собирайте камни Вечности, убивая существ на Вневременном острове.‡Sammelt Epochensteine von den Kreaturen der Zeitlosen Insel.‡영원의 섬 몬스터에게서 시대의 돌을 모아야 합니다. 레벨 30 영원의 섬‡Consigue piedras de época de las criaturas de la Isla Intemporal.‡‡Collectez des Pierres d’époque sur les créatures de l’Île du Temps Figé.‡从永恒岛的生物身上收集纪元之石。‡',
  }
},
[33340] = {
  {
    'Nutrimento perene‡Вневременное питание‡Zeitlose Nahrung‡영원의 별미‡Nutrición intemporal‡‡Les nutriments du Temps figé‡永恒精魄‡',
    nil,
    'Consuma Estalinho Maduro, Ovo Coberto de Areia, Cristal Carregado, Assado de Iaque Enorme, Semente Assada ou Papoula de Fogo na Ilha Perene.‡Съешьте зрелый хрустящий фрукт, покрытое песком яйцо, заряженный кристалл, огромного жареного яка, жареное семя или огненный мак на Вневременном острове.‡Verzehrt eine reife Knackfrucht, ein sandbedecktes Ei, einen aufgeladenen Kristall, einen riesigen Yakbraten, einen gerösteten Samen oder einen Feuermohn auf der Zeitlosen Insel.‡영원의 섬에서 잘 익은 아삭과일, 모래투성이 알, 충만한 수정, 거대 야크 숯불구이, 구운 씨앗, 불꽃 백일홍 중 하나를 섭취해야 합니다.‡Consume una fruta crujiente madura, un huevo cubierto de arena, un cristal cargado, un asado de yak enorme, una semilla tostada o una amapola de fuego en la Isla Intemporal.‡‡Consommez un Croquefruit mûr, un Œuf couvert de sable, un Cristal chargé, un Énorme rôti de yack, une Graine torréfiée ou un Pavot de feu sur l’Île du Temps figé.‡在永恒岛上吃下成熟的脆果、覆沙龟蛋、充能的水晶、巨型牦牛烤肉、烤熟的种子或火粟花。‡',
  }
},
[33341] = {
  {
    'Santuários do caminho dos Celestiais‡Путевые святилища Небожителей‡Die Wegesrandschreine der Erhabenen‡천신의 제단들‡Santuarios de los Celestiales‡‡Sanctuaires des Astres‡天神悟道圣坛‡',
    nil,
    'Encontre e ative um Santuário Perdido no Tempo e peça a bênção dos celestiais. Uma‡Найдите действующее Затерянное во времени святилище и попросите благословения у Небожителей.‡Findet einen aktiven zeitverlorenen Schrein und erbittet einen Segen von den Erhabenen.‡활성화된 잃어버린 시간의 제단을 찾아서 천신의 축복을 받아야 합니다. 레벨 30 영원의 섬‡Encuentra un santuario perdido en el tiempo aún activo y solicita la bendición de los celestiales.‡‡Trouvez un Sanctuaire perdu dans le temps et demandez une bénédiction aux Astres vénérables.‡找到激活的迷时圣坛并获得天神的祝福。‡',
  }
},
[33343] = {
  {
    'O Bispo das Chamas‡Архиерей пламени‡Der Archiereus der Flamme‡화염의 대제사장‡El sacerdote ilustre de las llamas‡‡L’archiprêtre de flammes‡烈焰祭司阿克鲁斯‡',
    nil,
    'Evoque e derrote o Bispo das Chamas. Uma‡Призовите и победите архиерея пламени.‡Beschwört und vernichtet den Archiereus der Flamme.‡화염의 대제사장을 소환하여 처치해야 합니다. 레벨 30 영원의 섬‡Invoca y derrota al sacerdote ilustre de las llamas.‡‡Invoquez l’Archiprêtre de flammes et tuez-le.‡召唤并击败烈焰祭司阿克鲁斯。‡',
  }
},
[33345] = {
  {
    'Tentativa semanal do Xamã Sombrio‡Темный шаман – еженедельная попытка‡Dunkelschamane wöchentlicher Versuch‡암흑주술사 주간 시도‡Dark Shaman Weekly Attempt‡‡Sombre chaman : tentative hebdomadaire‡Dark Shaman Weekly Attempt‡',
    nil,
    nil,
  }
},
[33346] = {
  {
    '5.4 Test - RRP - Top Level Tracking Quest‡5.4 Test - RRP - Top Level Tracking Quest‡5.4 Test - RRP - Top Level Tracking Quest‡5.4 테스트 - RRP - 최고 레벨 추적 퀘스트‡5.4 Test - RRP - Top Level Tracking Quest‡‡5.4 Test - RRP - Top Level Tracking Quest‡5.4 Test - RRP - Top Level Tracking Quest‡',
