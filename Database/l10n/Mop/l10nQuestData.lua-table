},
[32010] = {
  {
    'A Celestial Task‡A Celestial Task‡A Celestial Task‡A Celestial Task‡A Celestial Task‡‡A Celestial Task‡A Celestial Task‡',
    nil,
    'Earned Revered standing with the Golden Lotus. Vale das Flores Eternas de‡Earned Revered standing with the Golden Lotus.‡Earned Revered standing with the Golden Lotus.‡Earned Revered standing with the Golden Lotus. 영원꽃 골짜기‡Earned Revered standing with the Golden Lotus.‡‡Earned Revered standing with the Golden Lotus.‡Earned Revered standing with the Golden Lotus.‡',
