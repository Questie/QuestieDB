},
[78157] = {
  {
    'Treino de combate‡Боевые учения‡Kampftraining‡전투 훈련‡Entrenamiento de combate‡Entrenamiento de combate‡Entraînement au combat‡战斗训练‡戰鬥訓練',
    nil,
    'Treine um feitiço, falando com um treinador de Guerreiro.‡Поговорите с наставником воинов и изучите заклинание.‡Erlernt eine Fähigkeit, indem Ihr mit einem Trainer sprecht, der Euch als Krieger ausbilden kann.‡전사 상급자와 대화하여 주문을 훈련해야 합니다.‡Practica un hechizo hablando con un instructor de la clase guerrero.‡Practica un hechizo hablando con un instructor de Paladín.‡Parlez à un maître pour Guerrier pour vous entraîner à lancer un sort.‡和一名法师训练师谈一谈，通过训练掌握一个法术。‡與戰士訓練師交談學習法術。',
  }
},
[78158] = {
  {
    'Treino de combate‡Боевые учения‡Kampftraining‡전투 훈련‡Entrenamiento de combate‡Entrenamiento de combate‡Entraînement au combat‡战斗训练‡戰鬥訓練',
    nil,
    'Treine um feitiço, falando com um treinador de Guerreiro.‡Поговорите с наставником воинов и изучите заклинание.‡Erlernt eine Fähigkeit, indem Ihr mit einem Trainer sprecht, der Euch als Krieger ausbilden kann.‡전사 상급자와 대화하여 주문을 훈련해야 합니다.‡Practica un hechizo hablando con un instructor de la clase guerrero.‡Practica un hechizo hablando con un instructor de Paladín.‡Parlez à un maître pour Guerrier pour vous entraîner à lancer un sort.‡和一名法师训练师谈一谈，通过训练掌握一个法术。‡與戰士訓練師交談學習法術。',
  }
},
[78164] = {
  {
    'Talento é para quem tem‡Талантливый герой‡Talentiert‡특성‡Tienes talento‡Talentoso‡Quel talent !‡天赋异禀‡天賦異稟',
    nil,
    'Ative a interface de Talentos e atribua 5 Pontos de Talento.‡Откройте интерфейс талантов и распределите 5 очков талантов.‡Öffnet das Talentfenster und verteilt 5 Talentpunkte.‡특성 창을 열고 특성 포인트 5점을 분배해야 합니다.‡Activa la interfaz de talentos y asigna 5 puntos de talento.‡Activa la interfaz de talentos y asigna 5 puntos de talento.‡Activez l’interface des talents et dépensez 5 points de talent.‡打开天赋界面并分配五个天赋点数。‡打開天賦介面，分配5個天賦點數。',
  }
},
[78166] = {
  {
    'Para Nortúndria‡В Нордскол‡Nach Nordend‡노스렌드로‡A Rasganorte‡A Rasganorte‡En route pour le Norfendre‡前往诺森德‡前往北裂境',
    nil,
    'Use o pergaminho de teleporte do seu inventário para chegar a Nortúndria e falar com a Imagem da Arquimaga Modera.‡Воспользуйтесь свитком из вашей сумки, чтобы телепортироваться в Нордскол, и поговорите с проекцией верховного мага Модеры.‡Benutzt eine Schriftrolle der Teleportation aus Eurem Inventar, um Nordend zu erreichen, und sprecht dort mit dem Abbild der Erzmagierin Modera.‡가방에서 새로운 순간이동 두루마리를 꺼내 노스렌드로 가서 대마법사 모데라의 환영과 대화해야 합니다.‡Usa el pergamino de teletransporte de tu inventario para llegar a Rasganorte y habla con la imagen de la archimaga Modera.‡Usa el pergamino de teletransportación de tu inventario para llegar a Rasganorte y habla con la imagen de la archimaga Modera.‡Utilisez le parchemin de téléportation dans votre inventaire pour atteindre le Norfendre et parler à l’image de l’archimage Modera‡使用你的物品栏里的一个传送卷轴前往诺森德，然后与大法师茉德拉的影像交谈。‡使用物品欄裡的傳送卷軸前往北裂境與大法師莫德菈的影像交談。',
  }
},
[78167] = {
  {
    'Talento é para quem tem‡Талантливый герой‡Talentiert‡특성‡Tienes talento‡‡Quel talent !‡天赋异禀‡天賦異稟',
    nil,
    'Ative a interface de Talentos e atribua 5 Pontos de Talento.‡Откройте интерфейс талантов и распределите 5 очков талантов.‡Öffnet das Talentfenster und verteilt 5 Talentpunkte.‡특성 창을 열고 특성 포인트 5점을 분배해야 합니다.‡Activa la interfaz de talentos y asigna 5 puntos de talento.‡‡Activez l’interface des talents et dépensez 5 points de talent.‡打开天赋界面并分配五个天赋点数。‡打開天賦介面，分配5個天賦點數。',
  }
},
[78168] = {
  {
    'Para Nortúndria‡В Нордскол‡Nach Nordend‡노스렌드로‡A Rasganorte‡A Rasganorte‡En route pour le Norfendre‡前往诺森德‡前往北裂境',
    nil,
    'Use o pergaminho de teleporte do seu inventário para chegar a Nortúndria e falar com a Imagem do Arquimago Aethas Fendessol.‡Воспользуйтесь свитком из вашей сумки, чтобы телепортироваться в Нордскол, и поговорите с проекцией верховного мага Этаса Похитителя Солнца.‡Benutzt eine Schriftrolle der Teleportation aus Eurem Inventar, um Nordend zu erreichen, und sprecht dort mit dem Abbild des Erzmagiers Aethas Sonnenhäscher.‡가방에서 새로운 순간이동 두루마리를 꺼내 노스렌드로 가서 대마법사 에이타스 선리버의 환영과 대화해야 합니다.‡Usa el pergamino de teletransporte de tu inventario para llegar a Rasganorte y habla con la imagen del archimago Aethas Atracasol.‡Usa el pergamino de teletransportación de tu inventario para llegar a Rasganorte y habla con la imagen del archimago Aethas Atracasol.‡Utilisez le parchemin de téléportation dans votre inventaire pour atteindre le Norfendre et parler à l’image de l’archimage Aethas Saccage-Soleil‡使用你的物品栏里的一个传送卷轴前往诺森德，然后与大法师艾萨斯·夺日者的影像交谈。‡使用物品欄裡的傳送卷軸前往北裂境與大法師埃薩‧奪日者的影像交談。',
  }
},
[78219] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de Guerreiro em Áquerus: A Fortaleza de Ébano.‡Встретьтесь с наставником воинов в Акерусе, Черном оплоте.‡Besucht einen Trainer in Acherus, der Schwarzen Festung, der Euch als Krieger ausbilden kann.‡아케루스: 칠흑의 요새에서 전사 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase guerrero en Acherus: El Bastión de Ébano.‡‡Allez voir un maître pour Guerrier à Achérus : le fort d’Ébène.‡在阿彻鲁斯：黑锋要塞与一名战士训练师会面。‡在亞榭洛：黯黑堡內找到戰士訓練師。',
  }
},
