[9013] = {
  {
    'Deixando o melhor para o final‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    'Entregue seu Elmo do Valor e seu Peitoral do Valor a Mokvar.‡Отдайте Моквару шлем Доблести и кирасу Доблести.‡Gebt Mokvar Euren Helm der Ehre und Eure Brustplatte der Ehre.‡‡Dale a Mokvar tu yelmo y tu coraza de valor.‡Dale a Mokvar tu yelmo y tu coraza de valor.‡Donnez votre Heaume de vaillance et votre Cuirasse de vaillance à Mokvar.‡将你的勇气头盔与勇气胸甲交给莫克瓦尔。‡將你的勇氣頭盔和勇氣胸甲交給莫克瓦。',
  }
},
[9014] = {
  {
    '‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    '‡Отдайте Моквару корону Магистра и одеяние Магистра.‡Gebt Mokvar Eure Krone des Magisters und Eure Roben des Magisters.‡‡Dale a Mokvar tus togas y tu corona de magister.‡Dale a Mokvar tus togas y tu corona de magister.‡Donnez votre Collerette de magistère et votre Robe de magistère à Mokvar.‡将你的博学者头冠与博学者长袍交给莫克瓦尔。‡',
  }
},
[9015] = {
  {
    'O desafio‡Вызов‡Die Herausforderung‡도전‡El reto‡El reto‡Le défi‡挑战‡挑戰',
    nil,
    'Viaje até o Círculo da Lei no Abismo Rocha Negra e coloque o Estandarte da Provocação no centro enquanto ouve a sentença do Supremo Juiz Durólito. Mate Theldren e seus gladiadores e fale novamente com Anthion Harmon nas Terras Pestilentas Orientais em posse da primeira parte do amuleto de Lorde Valthalak.‡Войдите в Зал Правосудия в Глубинах Черной горы, выслушайте приговор верховного судьи Мрачнокамня и вонзите знамя Вызова в центр круга. Убейте Телдрена и его гладиаторов, после чего вернитесь к Антиону Хармону в Восточные Чумные земли с первой частью амулета Лорда Вальтхалака.‡Reist zum Ring des Gesetzes der Schwarzfelstiefen und errichtet das Banner der Provokation in dessen Mitte, während Ihr von Oberrichter Grimmstein verurteilt werdet. Tötet Theldren und seine Gladiatoren und kehrt dann mit dem ersten Stück von Lord Valthalaks Amulett zu Anthion Harmon in den Östlichen Pestländern zurück.‡검은바위 나락의 법의 심판장으로 가서 대법관 그림스톤에 의해 선고받은대로 한가운데에 도전의 깃발을 설치해야 합니다. 텔드렌과 그의 검투사들을 해치운 후 군주 발타라크의 첫 번째 아뮬렛 조각을 가지고 동부 역병지대에 있는 안시온 하몬에게 가야 합니다.‡Dirígete al Círculo de la Ley en las Profundidades de Roca Negra y coloca el estandarte de Provocación en el centro cuando el Alto justiciero Pedrasiniestra pronuncie tu veredicto. Mata a Theldren y a sus gladiadores y regresa junto a Anthion Harmon en las Tierras de la Peste del Este con la primera pieza del amuleto de Lord Valthalak.‡Dirígete al Círculo de la Ley en las Profundidades de Roca Negra y coloca el estandarte de Provocación en el centro cuando el Alto justiciero Pedrasiniestra pronuncie tu veredicto. Mata a Theldren y a sus gladiadores y regresa junto a Anthion Harmon en las Tierras de la Peste del Este con la primera pieza del amuleto de Lord Valthalak.‡Rendez-vous dans le Cercle de la loi, dans les profondeurs de Rochenoire, et placez la Bannière de provocation en son centre lorsque vous serez condamnée par le Juge supérieur Mornepierre. Tuez Theldren et ses gladiateurs, puis retournez voir Anthion Harmon dans les Maleterres de l\'est avec le premier morceau de l\'amulette du seigneur Valthalak.‡到黑石深渊的竞技场去，在你被裁决者格里斯通宣判之后将挑战之旗插在场地中央。杀死塞尔德林和他的角斗士，然后将瓦塔拉克饰品第一部分交给东瘟疫之地的安泰恩·哈尔蒙。‡前往黑石深淵競技場並在你被裁決者格里斯通宣判時將挑釁旌旗放在它的中央。殺死瑟爾倫和他的戰士們，再帶著第一塊瓦薩拉克領主護符回到東瘟疫之地的安希恩·哈莫那裡。',
  }
},
[9016] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Mokvar, em Orgrimmar, com um conjunto de Botas do Coração Selvagem, Kilt do Coração Selvagem e Dragonas do Coração Selvagem.|n‡Отдайте Моквару в Оргриммаре сапоги дикого Сердца, килт дикого сердца и наплеч буйного сердца.‡Kehrt mit einem Paar Stiefel des Wildherzens, einem Kilt des Wildherzens und einer Schiftung des Wildherzens zu Mokvar in Orgrimmar zurück.‡자연의정수 장화, 자연의정수 킬트, 자연의정수 어깨덮개를 하나씩 가지고 오그리마에 있는 모크바르에게 가야 합니다.‡Lleva 1 par de botas, 1 falda escocesa y 1 par de bufas Corazón Salvaje a Mokvar a Orgrimmar.|n‡Lleva 1 par de botas, 1 falda escocesa y 1 par de bufas Corazón Salvaje a Mokvar a Orgrimmar.|n‡Retournez voir Mokvar à Orgrimmar avec des bottes du Cœur-sauvage, un Kilt du Cœur-sauvage et des Spallières du Cœur-sauvage.‡带上一双野性之心长靴、一条野性之心褶裙和一副野性之心肩甲，回去向奥格瑞玛的莫克瓦尔复命。‡帶著野性之心長靴，野性之心褶裙和野性之心肩甲回到奧格瑪的莫克瓦那裡。',
  }
},
[9017] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Принесите Моквару в Оргриммаре сапоги загонщика, штаны загонщика и оплечье загонщика.‡Kehrt mit einem Paar Bestienjägerstiefeln, einer Bestienjägerhose und einem Bestienjägermantel zu Mokvar in Orgrimmar zurück.‡‡Lleva 1 par de botas, 1 pantalón y 1 manto de acechabestias a Mokvar a Orgrimmar.‡Lleva 1 par de botas, 1 pantalón y 1 manto de acechabestias a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Bottes de bestiaire, un Pantalon de bestiaire et un Mantelet de bestiaire.‡带上一双野兽追猎者长靴、一条野兽追猎者短裤和一副野兽追猎者衬肩，回去向奥格瑞玛的莫克瓦尔复命。‡',
  }
},
[9018] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Отдайте Моквару в Оргриммаре сапоги Магистра, поножи Магистра и оплечье Магистра.‡Kehrt mit einem Paar Stiefel des Magisters, Gamaschen des Magisters und einem Mantel des Magisters zu Mokvar in Orgrimmar zurück.‡‡Lleva 1 par de botas, 1 manto y 1 par de leotardos de magister a Mokvar a Orgrimmar.‡Lleva 1 par de botas, 1 manto y 1 par de leotardos de magister a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Bottes de magistère, des Jambières de magistère et un Mantelet de magistère.‡带上一双博学者长靴、一条博学者护腿和一副博学者衬肩，回去向奥格瑞玛的莫克瓦尔复命。‡',
  }
},
[9019] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Mokvar, em Orgrimmar, com um conjunto de Sandálias do Devoto, Saia do Devoto e Dragonas do Devoto.‡Отдайте Моквару в Оргриммаре сандалии Преданности, юбку Преданности и оплечье Преданности.‡Kehrt mit einem Paar Sandalen des Gläubigen, einem Rock des Gläubigen und einem Mantel des Gläubigen zu Mokvar in Orgrimmar zurück.‡기원의 덧신, 기원의 스커트, 기원의 어깨덧옷을 하나씩 가지고 오그리마에 있는 모크바르에게 가야 합니다.‡Lleva 1 par de zapatos, 1 saya y 1 manto de devoto a Mokvar a Orgrimmar.‡Lleva 1 par de zapatos, 1 saya y 1 manto de devoto a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Sandales de dévot, une Jupe de dévot et un Mantelet de dévot.‡带上一双虔诚软鞋、一条虔诚长裙和一副虔诚衬肩，回去向奥格瑞玛的莫克瓦尔复命。‡帶著虔誠便鞋，虔誠長裙和虔誠披肩回到奧格瑪的莫克瓦那裡。',
  }
},
[9020] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Принесите Моквару в Оргриммаре сапоги Незаметности, штаны Незаметности и наплеч Незаметности.‡Kehrt mit einem Paar Stiefel der Schattenkunst, einer Hose der Schattenkunst und einer Schiftung der Schattenkunst zu Mokvar in Orgrimmar zurück.‡‡Lleva 1 par de botas, 1 pantalón y 1 par de bufas arte sombrío a Mokvar a Orgrimmar.‡Lleva 1 par de botas, 1 pantalón y 1 par de bufas arte sombrío a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Bottes Sombreruse, un Pantalon Sombreruse et des Spallières Sombreruse.‡带上一双迅影长靴、一条迅影短裤和一副迅影肩甲，回去向奥格瑞玛的莫克瓦尔复命。‡',
  }
},
[9021] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Отдайте Моквару в Оргриммаре сандалии Багрового Тумана, поножи Багрового Тумана и оплечье Багрового Тумана.‡Kehrt mit einem Paar Sandalen der Furcht, Gamaschen der Furcht und einem Mantel der Furcht zu Mokvar in Orgrimmar zurück.‡‡Lleva 1 par de sandalias, 1 par de leotardos y 1 manto calígine a Mokvar a Orgrimmar.‡Lleva 1 par de sandalias, 1 par de leotardos y 1 manto calígine a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Sandales de Brume-funeste, des Jambières de Brume-funeste et un Mantelet de Brume-funeste.‡带上一双鬼雾便鞋、一条鬼雾护腿和一副鬼雾衬肩，回去向奥格瑞玛的莫克瓦尔复命。‡',
  }
},
[9022] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Mokvar em Orgrimmar com um conjunto de Botas do Valor, Coxotes do Valor e Espaldares do Valor.‡Отдайте Моквару в Оргриммаре сапоги Доблести, ножные латы Доблести и наплеч Доблести.‡Kehrt mit einem Paar Stiefel der Ehre, Beinplatten der Ehre und einer Schiftung der Ehre zu Mokvar in Orgrimmar zurück.‡용맹의 장화, 용맹의 다리갑옷, 용맹의 어깨덮개를 하나씩 가지고 오그리마에 있는 모크바르에게 가야 합니다.‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas de valor a Mokvar a Orgrimmar.‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas de valor a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Bottes de vaillance, des Cuissards de vaillance et des Spallières de vaillance.‡带上一双勇气战靴、一条勇气腿铠和一副勇气肩甲，回去向奥格瑞玛的莫克瓦尔复命。‡帶著勇氣之靴，勇氣腿鎧和勇氣肩甲回到奧格瑪的莫克瓦那裡。',
  }
},
[9023] = {
  {
    'O veneno perfeito‡Идеальный яд‡Das perfekte Gift‡완벽한 독‡El veneno perfecto‡El veneno perfecto‡Le poison parfait‡完美的毒药‡完美的毒藥',
    nil,
    'Dirk Fortelenho no Forte Cenariano quer que você leve para ele uma Vesícula de Peçonha de Venoxis e uma Vesícula de Peçonha de Kurinnaxx.‡Дирк Громодрев из крепости Кенария попросил принести ему ядовитую железу Веноксиса и ядовитую железу Куриннакса.‡Dirk Donnerholz in der Burg Cenarius will, dass Ihr ihm Venoxis\' Giftbeutel und Kurinnaxx\' Giftbeutel bringt.‡세나리온 요새에 있는 더크 썬더우드가 베녹시스의 독주머니와 쿠린낙스의 독주머니를 가져다 달라고 했습니다.‡Dirk Truenedera quiere que le lleves glándulas de veneno de Venoxis y Kurinnaxx al Fuerte Cenarion.‡Dirk Truenedera quiere que le lleves glándulas de veneno de Venoxis y Kurinnaxx al Fuerte Cenarion.‡Dirk Tonnebois, du Fort cénarien en Silithus, veut que vous lui rameniez la Glande à venin de Venoxis et la Glande à venin de Kurinnaxx.‡塞纳里奥要塞的德尔克·雷木让你把温诺希斯的毒囊和库林纳克斯的毒囊交给他。‡塞納里奧城堡的德爾克·雷木要你去幫他取回溫諾希斯的毒囊和庫林納克斯的毒囊。',
  }
},
[9024] = {
  {
    '‡Подозрения Аристана‡Aristans Verdacht‡아리스탄의 예감‡El presentimiento de Aristan‡El presentimiento de Aristan‡L\'intuition d\'Aristan‡阿瑞斯坦的预感‡',
    nil,
    '‡Отнесите 1 флакон одеколона и 1 флакон духов Моргану Песту в Торговый квартал Штормграда.‡Bringt 1 Duftwasserflakon und 1 Parfümflakon zu Morgan Pestle im Handelsdistrikt von Sturmwind.‡스톰윈드 상업 지구에 있는 모건 페슬에게 은은한 향수와 매혹적인 향수를 각 한 병씩 가져가야 합니다.‡Lleva 1 botella de colonia y 1 de perfume a Morgan Mortero, que está en el Distrito de Mercaderes de Ventormenta.‡Lleva 1 botella de colonia y 1 de perfume a Morgan Mortero, que está en el Distrito de Mercaderes de Ventormenta.‡Remettez 1 bouteille d\'Eau de Cologne et 1 Flacon de parfum à Morgan Pilon, dans le Quartier commerçant de Hurlevent.‡将1瓶古龙水和1瓶香水交给暴风城贸易区的摩根·匹斯特。‡',
  }
},
[9025] = {
  {
    '‡Открытие Моргана‡Morgans Entdeckung‡‡El descubrimiento de Morgan‡El descubrimiento de Morgan‡La découverte de Morgan‡摩根的发现‡',
    nil,
    '‡Вернитесь к Аристану Моттару, ожидающему около банка в Торговом квартале Штормграда.‡Kehrt zu Aristan Mottar zurück, er befindet sich vor der Bank im Handelsdistrikt von Sturmwind.‡‡Ve a ver a Aristan Mottar, que está junto al banco en el Distrito de Mercaderes de Ventormenta.‡Ve a ver a Aristan Mottar, que está junto al banco en el Distrito de Mercaderes de Ventormenta.‡Retourner voir Aristan Mottar, à côté de la banque, dans le Quartier commerçant de Hurlevent.‡回到暴风城银行附近的阿瑞斯坦·莫塔那里。‡',
  }
},
[9026] = {
  {
    '‡Поиск источника‡Verfolgung der Spur‡향기의 근원 추적‡Rastrear la fuente‡Rastrear la fuente‡Remonter à la source‡追查货源‡',
    nil,
    '‡Поговорите с хозяйкой таверны "Позолоченная роза" Аллисон в Торговом квартале Штормграда.‡Sprecht mit Gastwirtin Allison im Gasthaus \'Die güldene Rose\' im Handelsdistrikt von Sturmwind.‡‡Habla con la tabernera Allison en La Rosa Áurea, en el Distrito de Mercaderes de Ventormenta.‡Habla con la tabernera Allison en La Rosa Áurea, en el Distrito de Mercaderes de Ventormenta.‡Parler à l\'aubergiste Allison à la Rose dorée, dans le Quartier commerçant de Hurlevent.‡与暴风城贸易区中的镶金玫瑰旅店的老板奥里森谈一谈。‡',
  }
},
[9027] = {
  {
    'Em busca da fonte‡Поиск источника‡Verfolgung der Spur‡향기의 근원 추적‡Rastrear la fuente‡Rastrear la fuente‡Remonter à la source‡追查货源‡追溯來源',
    nil,
    'Fale com Everton Soniram no Empório das Linhas, que fica perto dos canais de Ventobravo.‡Поговорите с Эвертом Соризамом в "Тончайшей пряже" у каналов Штормграда.‡Sprecht mit Evert Sorisam bei \'Das feinste Band\' entlang der Kanäle Sturmwinds.‡스톰윈드 운하 지구 근처에 최고급 실타래 상점에 있는 에버트 소리삼과 대화해야 합니다.‡Habla con Evert Sorisam en El Paño Fino, junto a los canales de Ventormenta.‡Habla con Evert Sorisam en El Paño Fino, junto a los canales de Ventormenta.‡Parler à Evert Sorisam, au Fil le plus fin, au bord des canaux de Hurlevent.‡与暴风城运河旁的裁缝店"最好的线团"里面的埃文特·索里萨姆谈一谈。‡到暴風城運河邊和「最好的線團」那家店的艾佛特·索里山姆談談。',
  }
},
[9028] = {
  {
    '‡Источник обнаружен‡Lüftung des Geheimnisses‡밝혀진 향기의 근원‡El descubrimiento de la fuente‡El descubrimiento de la fuente‡La source est découverte !‡水落石出‡',
    nil,
    '‡Найдите аптекаря Стаффрона Лерента в предгорьях Хилсбрада за поместьем Черный Ворон.‡Findet Apotheker Staffron Lerent hinter dem Rabenholdtanwesen im Vorgebirge des Hügellands.‡라벤홀트 장원을 지나 언덕마루 구릉지에서 연금술사 스태프론 리런트를 찾아야 합니다.‡Encuentra al boticario Staffron Lerent en las Laderas de Trabalomas, detrás de la Mansión Ravenholdt.‡Encuentra al boticario Staffron Lerent en las Laderas de Trabalomas, detrás de la Mansión Ravenholdt.‡Trouver l\'apothicaire Staffron Lerent dans les contreforts de Hautebrande, derrière le manoir de Ravenholdt.‡到希尔斯布莱德丘陵去，在拉文霍德庄园后面找到药剂师斯塔弗隆·雷伦特。‡',
  }
},
[9029] = {
  {
    '‡Бурлящий котел‡Ein blubbernder Kessel‡‡Una caldera burbujeante‡Una caldera burbujeante‡Un chaudron bouillonnant‡薰炉‡',
    nil,
    nil,
  }
},
[9030] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Поговорите с Делианой из Стальгорна.‡Sprecht mit Deliana in Eisenschmiede.‡‡Habla con Deliana en Forjaz.‡Habla con Deliana en Forjaz.‡Allez voir Deliana à Forgefer.‡‡',
  }
},
[9031] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Поговорите с Мокваром из Оргриммара.‡Sprecht mit Mokvar in Orgrimmar.‡‡Habla con Mokvar en Orgrimmar.‡Habla con Mokvar en Orgrimmar.‡Allez voir Mokvar à Orgrimmar.‡‡',
  }
},
[9032] = {
  {
    '‡Злосчастная доля Бодли‡Bodleys trauriges Schicksal‡‡El triste destino de Bodley‡El triste destino de Bodley‡Le triste destin de Bodley‡伯德雷的不幸‡',
    nil,
    '‡Отыщите Бодли у Пика Черной горы с помощью спектрального сканера иных измерений.‡Reist zum Schwarzfels und benutzt den extradimensionalen Geisterdetektor, um Bodley nahe der Schwarzfelsspitze zu finden.‡‡Viaja hasta la Montaña Roca Negra y usa el detector de fantasmas extradimensionales para encontrar a Bodley cerca de la Cumbre de Roca Negra.‡Viaja hasta la Montaña Roca Negra y usa el detector de fantasmas extradimensionales para encontrar a Bodley cerca de la Cumbre de Roca Negra.‡Rendez-vous au mont Rochenoire, près du pic Rochenoire, et utilisez le Révélateur de fantômes extradimensionnel pour trouver Bodley.‡到黑石山去，使用超维度幽灵显形器找到伯德雷。‡',
  }
},
[9033] = {
  {
    'Ecos da Guerra‡Отголоски войны‡Echo des Krieges‡전쟁의 메아리‡Ecos de Guerra‡Ecos de Guerra‡Les échos de la guerre‡战争的回响‡戰爭的回響',
    nil,
    'O Comandante Eligor Alvorada, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer que você mate 5 Monstruosidades Vivas, 5 Gárgulas Litopele, 8 Capitães Cavaleiros da Morte e 3 Espreitadoras Peçonhentas.‡Командор Элигор Вестник Рассвета из часовни Последней Надежды, что в Восточных Чумных землях просит убить 5 ходячих ужасов, 5 каменных горгулий, 8 капитанов рыцарей смерти и 3 ядовитых пауков-скакунов.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte, dass Ihr 5 lebende Monstrositäten, 5 Steinhautgargoyles, 8 Hauptmänner der Todesritter und 3 Giftpirscher tötet.‡동부 역병지대의 희망의 빛 예배당에 있는 사령관 엘리고르 돈브링어가 살아 움직이는 괴물 5마리, 돌가죽 가고일 5마리, 죽음의 기사단 대장 8명, 맹독 늑대거미 3마리를 처치해 달라고 했습니다.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere que mates 5 monstruosidades vivientes, 5 gárgolas piel de piedra, 8 capitanes caballero de la Muerte y 3 acechadores venenosos.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere que mates 5 monstruosidades vivientes, 5 gárgolas piel de piedra, 8 capitanes caballero de la Muerte y 3 acechadores venenosos.‡Le commandant Eligor Portelaube, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut que vous tuiez 5 Monstruosités vivantes, 5 Gargouilles peau-de-pierre, 8 Capitaines des chevaliers de la mort et 3 Traque-venin.‡东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者要你杀死5个畸形妖、5只岩肤石像鬼、8个死亡骑士队长和3只毒性捕猎者。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者要你去殺死5名活巨怪，5名石膚石像鬼，8名死亡騎士隊長與3隻毒液潛獵者。',
  }
},
[9034] = {
  {
    'Peitoral Couraçado‡Кираса неустрашимости‡Brustplatte des Schreckenspanzers‡무쌍의 가슴보호갑‡La coraza acorator‡La coraza acorator‡Cuirasse de cuirassier‡无畏胸甲‡無畏胸甲',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você um Peitoral Couraçado caso você leve para ele os seguintes itens: 1 Peitoral Profanado, 25 Restos de Placas, 4 Barras de Arcanita e 2 Cristais do Nexus.|n‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать кирасу дредноута, если вы принесете ему 1 испоганенную кирасу, 25 обломков доспехов, 4 слитка арканита и 2 кристалла-источника.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Brustplatte des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Brustplatte, 25 kampfzerschlissene Plattenstücke, 4 Arkanitbarren und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 가슴보호갑 1개, 닳아해진 판금 조각 25개, 아케이나이트 주괴 4개, 마력의 결정체 2개를 가져가면 무쌍의 흉갑을 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una coraza acorator si le llevas lo siguiente: 1 coraza profanada, 25 restos de coraza, 4 barras de arcanita y 2 cristales nexo.|n‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una coraza acorator si le llevas lo siguiente: 1 coraza profanada, 25 restos de coraza, 4 barras de arcanita y 2 cristales nexo.|n‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une cuirasse de cuirassier si vous lui apportez les choses suivantes : 1 Cuirasse désacralisée, 25 Débris d\'armure en plaques, 4 Barres d\'arcanite et 2 Cristaux de nexus.‡如果你将1件被玷污的胸甲、25块板甲碎片、4块奥金锭和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一件无畏胸甲。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏胸甲，只要你將下列物品帶給他:1件被褻瀆的胸甲，25個受戰爭破壞的鎧甲碎塊，4個奧金錠和2個聯結水晶。',
  }
},
[9035] = {
  {
    'Emboscada de beira de estrada‡Засада на дороге‡Hinterhalt am Straßenrand‡노상 강도‡Asaltantes de caminos‡Asaltantes de caminos‡Une embuscade au bord de la route‡打探匪情‡路邊的伏擊',
    nil,
    'Fale com o Aprendiz Meledor na Floresta do Canto Eterno na estrada que parte de Luaprata em direção ao sul.‡Поговорите с учеником Меледором в лесах Вечной Песни на дороге, ведущей из Луносвета на юг.‡Sprecht mit Lehrling Meledor im Immersangwald entlang der Straße, die südlich von Silbermond wegführt.‡실버문에서 남쪽으로 이어진 길을 따라가서 영원노래 숲에 있는 수습생 멜레도르와 대화해야 합니다.‡Habla con el aprendiz Meledor en el Bosque Canción Eterna en el camino hacia el sur desde Ciudad de Lunargenta.‡Habla con el aprendiz Meledor en el Bosque Canción Eterna en el camino hacia el sur desde Ciudad de Lunargenta.‡Parlez à l\'apprenti Meledor dans le bois des Chants éternels, le long de la route qui part au sud depuis Lune-d\'argent.‡出了银月城向南走便是永歌森林，去那儿找学徒梅雷多尔谈谈。‡沿著銀月城的路往南走，和永歌森林的學徒美勒杜談話。',
  }
},
[9036] = {
  {
    'Coxotes Couraçados‡Ножные латы неустрашимости‡Beinplatten des Schreckenspanzers‡무쌍의 다리갑옷‡Los quijotes acorator‡Los quijotes acorator‡Cuissards de cuirassier‡无畏腿铠‡無畏腿鎧',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você Coxotes Couraçados caso você leve para ele os seguintes itens: 1 par de Coxotes Profanados, 20 Restos de Placas, 4 Barras de Arcanita e 3 Pelegos Rústicos Curados.‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать ножные латы дредноута, если вы принесете ему следующее: 1 испоганенные ножные латы, 20 обломков доспехов, 4 слитка арканита и 3 обработанных грубых шкуры.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinplatten des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinplatten, 20 kampfzerschlissene Plattenstücke, 4 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 다리갑옷 1개, 닳아해진 판금 조각 20개, 아케이나이트 주괴 4개, 거친 경화 가죽 3개를 가져가면 무쌍의 다리갑옷을 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos quijotes acorator si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de coraza, 4 barras de arcanita y 3 pellejos bastos curtidos.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos quijotes acorator si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de coraza, 4 barras de arcanita y 3 pellejos bastos curtidos.‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des cuissards de cuirassier si vous lui apportez les choses suivantes : 1 paire de Cuissards désacralisés, 20 Débris d\'armure en plaques, 4 Barres d\'arcanite et 3 Peaux robustes traitées.‡如果你将1副被玷污的腿铠、20块板甲碎片、4块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一副无畏腿铠。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏腿鎧，只要你將下列物品帶給他:1對被褻瀆的腿鎧，20個受戰爭破壞的鎧甲碎塊，4個奧金錠和3塊熟化毛皮。',
  }
},
[9037] = {
  {
    'Capacete Couraçado‡Полный шлем неустрашимости‡Helm des Schreckenspanzers‡무쌍의 보호모‡El casco acorator‡Casco acorator‡Casque de cuirassier‡无畏头盔‡無畏盔帽',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você um Capacete Couraçado caso você leve para ele os seguintes itens: 1 Capacete Profanado, 15 Restos de Placas, 5 Barras de Arcanita e 1 Cristal do Nexus.‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать шлем дредноута, если вы принесете ему 1 испоганенный шлем, 15 обломков доспехов, 5 слитков арканита и 1 кристалл-источник.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Helm des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihter Helm, 15 kampfzerschlissene Plattenstücke, 5 Arkanitbarren und 1 Nexuskristall.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 투구 1개, 닳아해진 판금 조각 15개, 아케이나이트 주괴 5개, 마력의 결정체 1개를 가져가면 무쌍의 보호모를 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un casco acorator si le llevas lo siguiente: 1 casco profanado, 15 restos de coraza, 5 barras de arcanita y 1 cristal nexo.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un casco acorator si le llevas lo siguiente: 1 casco profanado, 15 restos de coraza, 5 barras de arcanita y 1 cristal nexo.‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera un casque de cuirassier si vous lui apportez les choses suivantes : 1 Heaume désacralisé, 15 Débris d\'armure en plaques, 5 Barres d\'arcanite et 1 Cristal de nexus.‡如果你将1顶被玷污的头盔、15块板甲碎片、5块奥金锭和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一顶无畏头盔。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏盔帽，只要你將下列物品帶給他:1個被褻瀆的盔帽，15個受戰爭破壞的鎧甲碎塊，5個奧金錠和1個聯結水晶。',
  }
},
[9038] = {
  {
    'Brafoneiras couraçadas‡Наплечье неустрашимости‡Schulterstücke des Schreckenspanzers‡무쌍의 견갑‡Los espaldares acorator‡Espaldares acorator‡Espauliers de cuirassier‡无畏肩铠‡無畏肩鎧',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você Brafoneiras Couraçadas caso você leve para ele os seguintes itens: 1 par de Brafoneiras Profanadas, 12 Restos de Placas, 2 Barras de Arcanita e 3 Pelegos Rústicos Curados.‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать наплечье дредноута, если вы принесете ему следующее: 1 испоганенное наплечье, 12 обломков доспехов, 2 слитка арканита и 3 обработанных грубых шкуры.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Schulterstücke des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Schulterstücke, 12 kampfzerschlissene Plattenstücke, 2 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 견갑 1개, 닳아해진 판금 조각 12개, 아케이나이트 주괴 2개, 거친 경화 가죽 3개를 가져가면 무쌍의 견갑을 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos espaldares acorator si le llevas lo siguiente: 1 par de espaldares profanados, 12 restos de coraza, 2 barras de arcanita y 3 pellejos bastos curtidos.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos espaldares acorator si le llevas lo siguiente: 1 par de espaldares profanados, 12 restos de coraza, 2 barras de arcanita y 3 pellejos bastos curtidos.‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des espauliers de cuirassier si vous lui apportez les choses suivantes : 1 paire d\'Espauliers désacralisés, 12 Débris d\'armure en plaques, 2 Barres d\'arcanite et 3 Peaux robustes traitées.‡如果你将1副被玷污的肩铠、12块板甲碎片、2块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一副无畏肩铠。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏肩鎧，只要你將下列物品帶給他:1對被褻瀆的肩鎧，12個受戰爭破壞的鎧甲碎塊，2個奧金錠和3塊熟化毛皮。',
  }
},
[9039] = {
  {
    'Escarpes Couraçados‡Башмаки неустрашимости‡Sabatons des Schreckenspanzers‡무쌍의 발덮개‡Los escarpines Acorator‡Escarpes acorator‡Solerets de cuirassier‡无畏马靴‡無畏馬靴',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você Escarpes Couraçados caso você leve para ele os seguintes itens: 1 par de Escarpes Profanados, 12 Restos de Placas, 2 Barras de Arcanita e 3 Pelegos Rústicos Curados.|n‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать башмаки дредноута, если вы принесете ему следующее: 1 испоганенные башмаки, 12 обломков доспехов, 2 слитка арканита и 3 обработанных грубых шкуры.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Sabatons des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Sabatons, 12 kampfzerschlissene Plattenstücke, 2 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 발덮개 1개, 닳아해진 판금 조각 12개, 아케이나이트 주괴 2개, 거친 경화 가죽 3개를 가져가면 무쌍의 발덮개를 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos escarpines Acorator si le llevas lo siguiente: 1 par de escarpines profanados, 12 restos de coraza, 2 barras de arcanita y 3 pieles bastas curtidas.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos escarpes acorator si le llevas lo siguiente: 1 par de escarpes profanados, 12 restos de coraza, 2 barras de arcanita y 3 pellejos bastos curtidos.|n‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des solerets de cuirassier si vous lui apportez les choses suivantes : 1 paire de Solerets désacralisés, 12 Débris d\'armure en plaques, 2 Barres d\'arcanite et 3 Peaux robustes traitées.‡如果你将1双被玷污的马靴、12块板甲碎片、2块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一双无畏马靴。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏馬靴，只要你將下列物品帶給他：1雙被褻瀆的馬靴，12個受戰爭破壞的鎧甲碎片，2個奧金錠和3塊熟化毛皮。',
  }
},
[9040] = {
  {
    'Manoplas Couraçadas‡Рукавицы неустрашимости‡Stulpen des Schreckenspanzers‡무쌍의 건틀릿‡Los guanteletes acorator‡Los guanteletes acorator‡Gantelets de cuirassier‡无畏护手‡無畏護手',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você Manoplas Couraçadas caso você leve para ele os seguintes itens: 1 Manopla Profanada, 8 Restos de Placas, 1 Barra de Arcanita e 5 Pelegos Rústicos Curados.‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать рукавицы дредноута, если вы принесете ему следующее: 1 испоганенные рукавицы, 8 обломков доспехов, 1 слиток арканита и 5 обработанных грубых шкур.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Stulpen des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Stulpen, 8 kampfzerschlissene Plattenstücke, 1 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 건틀릿 1개, 닳아해진 판금 조각 8개, 아케이나이트 주괴 1개, 거친 경화 가죽 5개를 가져가면 무쌍의 건틀릿을 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guanteletes acorator si le llevas lo siguiente: 1 par de guanteletes profanados, 8 restos de coraza, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guanteletes acorator si le llevas lo siguiente: 1 par de guanteletes profanados, 8 restos de coraza, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des gantelets de cuirassier si vous lui apportez les choses suivantes : 1 paire de Gantelets désacralisés, 8 Débris d\'armure en plaques, 1 Barre d\'arcanite et 5 Peaux robustes traitées.‡如果你将1副被玷污的护手、8块板甲碎片、1块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一副无畏护手。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏護手，只要你將下列物品帶給他:1對被褻瀆的護手，8個受戰爭破壞的鎧甲碎塊，1個奧金錠和5塊熟化毛皮。',
  }
},
[9041] = {
  {
    'Cinta couraçada‡Воинский пояс неустрашимости‡Taillenschutz des Schreckenspanzers‡무쌍의 허리보호대‡Los guardarrenes acorator‡Guardarrenes acorator‡Sangle de cuirassier‡无畏腰带‡無畏護腰',
    nil,
    'Korfax, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você uma Cinta Couraçada caso você leve para ele os seguintes itens: 1 Cinta Profanada, 8 Restos de Placas, 1 Barra de Arcanita e 5 Pelegos Rústicos Curados.‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать боевой пояс дредноута, если вы принесете ему 1 испоганенный латный пояс, 8 обломков доспехов, 1 слиток арканита и 5 обработанных грубых шкур.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Taillenschutz des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Taillenschutz, 8 kampfzerschlissene Plattenstücke, 1 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 허리보호대 1개, 닳아해진 판금 조각 8개, 아케이나이트 주괴 1개, 거친 경화 가죽 5개를 가져가면 무쌍의 허리보호대를 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guardarrenes acorator si le llevas lo siguiente: 1 guardarrenes profanado, 8 restos de coraza, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guardarrenes acorator si le llevas lo siguiente: 1 guardarrenes profanado, 8 restos de coraza, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une sangle de cuirassier si vous lui apportez les choses suivantes : 1 Sangle désacralisée, 8 Débris d\'armure en plaques, 1 Barre d\'arcanite et 5 Peaux robustes traitées.‡如果你将1条被玷污的护腰、8块板甲碎片、1块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一条无畏护腰。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏護腰，只要你將下列物品帶給他:1個被褻瀆的護腰，8個受戰爭破壞的鎧甲碎塊，1個奧金錠和5塊熟化毛皮。',
  }
},
[9042] = {
  {
    'Braçadeiras couraçadas‡Наручи неустрашимости‡Armschienen des Schreckenspanzers‡무쌍의 팔보호구‡Los brazales acorator‡Los brazales acorator‡Brassards de cuirassier‡无畏护腕‡無畏護腕',
    nil,
    'Korfax, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Braçadeiras Couraçadas caso você leve para ele os seguintes itens: 1 Braçadeira Profanada, 6 Restos de Placas, 1 Barra de Arcanita e 1 Cristal do Nexus.‡Корфакс из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать наручи дредноута, если вы принесете ему 1 испоганенные наручи, 6 обломков доспехов, 1 слиток арканита и 1 кристалл-источник.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Armschienen des Schreckenspanzers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Armschienen, 6 kampfzerschlissene Plattenstücke, 1 Arkanitbarren und 1 Nexuskristall.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스에게 모독의 팔보호구 1개, 닳아해진 판금 조각 6개, 아케이나이트 주괴 1개, 마력의 결정체 1개를 가져가면 무쌍의 팔보호구를 만들어 줄 것입니다.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales acorator si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de coraza, 1 barra de arcanita y 1 cristal nexo.‡Korfax de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales acorator si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de coraza, 1 barra de arcanita y 1 cristal nexo.‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des brassards de cuirassier si vous lui apportez les choses suivantes : 1 paire de Brassards désacralisés, 6 Débris d\'armure en plaques, 1 Barre d\'arcanite et 1 Cristal de nexus.‡如果你将1副被玷污的护腕、6块板甲碎片、1块奥金锭和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的科尔法克斯，他会为你制作一副无畏护腕。‡東瘟疫之地聖光之願禮拜堂的柯菲斯將為你製作無畏護腕，只要你將下列物品帶給他:1對被褻瀆的護腕，6個受戰爭破壞的鎧甲碎塊，1個奧金錠和1個聯結水晶。',
  }
},
[9043] = {
  {
    'Túnica da redenção‡Мундир искупления‡Tunika der Erlösung‡구원의 튜닉‡Guerrera de redención‡Guerrera de redención‡Tunique de rédemption‡救赎外套‡救贖外套',
    nil,
    'O Comandante Eligor Alvorada, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você uma Túnica da Redenção caso você leve para ele o seguinte: 1 Túnica Profanada, 25 Restos de Placas, 4 Barras de Arcanita e 3 Pelegos Rústicos Curados.‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать мундир Искупления, если вы принесете ему следующее: 1 испоганенный мундир, 25 обломков доспехов, 4 слитка арканита и 3 обработанных грубых шкуры.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Tunika der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Tunika, 25 kampfzerschlissene Plattenstücke, 4 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera de redención si le llevas lo siguiente: 1 guerrera profanada, 25 restos de coraza, 4 barras de arcanita y 3 pellejos bastos curtidos.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera de redención si le llevas lo siguiente: 1 guerrera profanada, 25 restos de coraza, 4 barras de arcanita y 3 pellejos bastos curtidos.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera une Tunique de rédemption si vous lui rapportez 1 Tunique désacralisée, 25 Débris d\'armure en plaques, 4 Barres d\'arcanite et 3 Peaux robustes traitées.‡如果你将1件被玷污的外套，25块板甲碎片，4块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一件救赎外套。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖外套，只要你將下列物品帶給他:1件被褻瀆的外套，25個受戰爭破壞的鎧甲碎塊，4個奧金錠和3塊熟化毛皮。',
  }
},
[9044] = {
  {
    'Guarda-pernas da redenção‡Набедренники искупления‡Beinschützer der Erlösung‡구원의 다리보호대‡Musleras de redención‡Musleras de redención‡Garde-jambes de rédemption‡救赎腿甲‡救贖腿甲',
    nil,
    'O Comandante Eligor Alvorada, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um par de Guarda-pernas da Redenção caso você leve para ele o seguinte: 1 Guarda-pernas Profanado, 20 Restos de Placas, 4 Barras de Arcanita e 2 Cristais do Nexus.‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать набедренники Искупления, если вы принесете ему следующее: 1 испоганенные набедренники, 20 обломков доспехов, 4 слитка арканита и 2 кристалла-источника.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinschützer der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinschützer, 20 kampfzerschlissene Plattenstücke, 4 Arkanitbarren und 2 Nexuskristalle.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras de redención si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de coraza, 4 barras de arcanita y 2 cristales nexo.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras de redención si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de coraza, 4 barras de arcanita y 2 cristales nexo.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des Garde-jambes de rédemption si vous lui rapportez 1 paire de Garde-jambes désacralisés, 20 Débris d\'armure en plaques, 4 Barres d\'arcanite et 2 Cristaux de nexus.‡如果你将1副被玷污的腿甲，20块板甲碎片，4块奥金锭和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一副救赎腿甲。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖腿甲，只要你將下列物品帶給他:1對被褻瀆的腿甲，20個受戰爭破壞的鎧甲碎塊，4個奧金錠和2個聯結水晶。',
  }
},
[9045] = {
  {
    'Bacinete da redenção‡Головной убор искупления‡Kopfstück der Erlösung‡구원의 머리쓰개‡Celada de redención‡Celada de redención‡Le chapel de rédemption‡救赎头饰‡救贖首盔',
    nil,
    'O Comandante Eligor Alvorada, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você um Bacinete da Redenção caso você leve para ele o seguinte: 1 Bacinete Profanado, 15 Restos de Placas, 5 Barras de Arcanita e 2 Pelegos Rústicos Curados.‡Командор Элигор Вестник Рассвета из часовни Последней Надежды, что в Восточных Чумных землях, готов сделать головной убор искупления, если вы принесете ему следующее: 1 испоганенный головной убор, 15 обломков доспехов, 5 слитков арканита и 2 обработанных грубых шкуры.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Kopfstück der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihtes Kopfstück, 15 kampfzerschlissene Plattenstücke, 5 Arkanitbarren und 2 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 사령관 엘리고르 돈브링어에게 모독의 머리쓰개 1개, 닳아해진 판금 조각 15개, 아케이나이트 주괴 5개, 거친 경화 가죽 2개를 가져가면 구원의 머리쓰개를 만들어 줄 것입니다.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un celada de redención si le llevas lo siguiente: 1 celada profanada, 15 restos de coraza, 5 barras de arcanita y 2 pellejos bastos curtidos.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un celada de redención si le llevas lo siguiente: 1 celada profanada, 15 restos de coraza, 5 barras de arcanita y 2 pellejos bastos curtidos.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera un Couvre-chef de rédemption si vous lui rapportez 1 Couvre-chef désacralisé, 15 Débris d\'armure en plaques, 5 Barres d\'arcanite et 2 Peaux robustes traitées.‡如果你将1件被玷污的头饰，15块板甲碎片，5块奥金锭和2个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一件救赎头饰。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖首盔，只要你將下列物品帶給他:1個被褻瀆的首盔，15個受戰爭破壞的鎧甲碎塊，5個奧金錠和2塊熟化毛皮。',
  }
},
[9046] = {
  {
    '‡Наплеч искупления‡Schiftung der Erlösung‡구원의 어깨덮개‡Bufas de redención‡Bufas de redención‡Spallières de rédemption‡救赎肩铠‡救贖肩甲',
    nil,
    '‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать наплеч Искупления, если вы принесете ему следующее: 1 испоганенный наплеч, 12 обломков доспехов, 2 слитка арканита и 2 кристалла-источника.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Schiftung der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Schiftung, 12 kampfzerschlissene Plattenstücke, 2 Arkanitbarren und 2 Nexuskristalle.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas de redención si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de coraza, 2 barras de arcanita y 2 cristales nexo.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas de redención si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de coraza, 2 barras de arcanita y 2 cristales nexo.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des Spallières de rédemption si vous lui rapportez 1 paire de Spallières désacralisées, 12 Débris d\'armure en plaques, 2 Barres d\'arcanite et 2 Cristaux de nexus.‡如果你将1副被玷污的肩铠，12块板甲碎片，2块奥金锭和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一副救赎肩铠。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖肩甲，只要你將下列物品帶給他:1對被褻瀆的肩甲，12個受戰爭破壞的鎧甲碎塊，2個奧金錠和2個聯結水晶。',
  }
},
[9047] = {
  {
    'Botas da redenção‡Сапоги искупления‡Stiefel der Erlösung‡구원의 장화‡Botas de redención‡Botas de redención‡Bottes de rédemption‡救赎长靴‡救贖長靴',
    nil,
    'O Comandante Eligor Alvorada, que está na Capela Esperança da Luz, nas Terras Pestilentas Orientais, fará para você Botas da Redenção caso você leve para ele o seguinte: 1 Bota Profanada, 12 Restos de Placas, 2 Barras de Arcanita e 3 Pelegos Rústicos Curados.‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать сапоги Искупления, если вы принесете ему следующее: 1 испоганенные сапоги, 12 обломков доспехов, 2 слитка арканита и 3 обработанных грубых шкуры.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Stiefel der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Stiefel, 12 kampfzerschlissene Plattenstücke, 2 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas de redención si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de coraza, 2 barras de arcanita y 3 pellejos bastos curtidos.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas de redención si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de coraza, 2 barras de arcanita y 3 pellejos bastos curtidos.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des Bottes de rédemption si vous lui rapportez 1 paire de Bottes désacralisées, 12 Débris d\'armure en plaques, 2 Barres d\'arcanite et 3 Peaux robustes traitées.‡如果你将1双被玷污的长靴，12块板甲碎片，2块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一双救赎长靴。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖長靴，只要你將下列物品帶給他:1雙被褻瀆的長靴，12個受戰爭破壞的鎧甲碎塊，2個奧金錠和3塊熟化毛皮。',
  }
},
[9048] = {
  {
    'Protetores de mão da redenção‡Боевые рукавицы искупления‡Handschützer der Erlösung‡구원의 손보호대‡Manoplas de redención‡Manoplas de redención‡Garde-mains de rédemption‡救赎护手‡救贖手甲',
    nil,
    'O Comandante Eligor Alvorada, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Protetores de Mão da Redenção caso você leve para ele o seguinte: 1 Protetor de Mão Profanado, 8 Restos de Placas, 1 Barra de Arcanita e 5 Pelegos Rústicos Curados.‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать боевые рукавицы Искупления, если вы принесете ему следующее: 1 испоганенные боевые рукавицы, 8 обломков доспехов, 1 слиток арканита и 5 обработанных грубых шкур.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Handschützer der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Handschützer, 8 kampfzerschlissene Plattenstücke, 1 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas de redención si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de coraza, 1 barra de arcanita y 5 pellejos bastos curtidos.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas de redención si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de coraza, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des garde-mains de rédemption si vous lui rapportez 1 paire de Garde-mains désacralisés, 8 Débris d\'armure en plaques, 1 Barre d\'arcanite et 5 Peaux robustes traitées.‡如果你将1副被玷污的护手，8块板甲碎片，1块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一副救赎护手。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖手甲，只要你將下列物品帶給他:1對被褻瀆的手甲，8個受戰爭破壞的鎧甲碎塊，1個奧金錠和5塊熟化毛皮。',
  }
},
[9049] = {
  {
    'Cinturão da redenção‡Ремень искупления‡Gurt der Erlösung‡구원의 요대‡Faja de redención‡Faja de redención‡Ceinturon de rédemption‡救赎束带‡救贖束腰',
    nil,
    'Comandante Eligor Alvorada, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Cinturão da Redenção se você levar para ele: 1 Cinturão Profanado, 8 Restos de Placas, 1 Barra de Arcanita e 3 Cristais do Nexus.‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать ремень Искупления, если вы принесете ему следующее: 1 испоганенный ремень, 8 обломков доспехов, 1 слиток арканита и 3 кристалла-источника.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Gurt der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Gurt, 8 kampfzerschlissene Plattenstücke, 1 Arkanitbarren und 3 Nexuskristalle.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja de redención si le llevas lo siguiente: 1 faja profanada, 8 restos de coraza, 1 barra de arcanita y 3 cristales nexo.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja de redención si le llevas lo siguiente: 1 faja profanada, 8 restos de coraza, 1 barra de arcanita y 3 cristales nexo.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera un Ceinturon de rédemption si vous lui rapportez 1 Ceinturon désacralisé, 8 Débris d\'armure en plaques, 1 Barre d\'arcanite et 3 Cristaux de nexus.‡如果你将1条被玷污的束带，8块板甲碎片，1块奥金锭和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一条救赎束带。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖束腰，只要你將下列物品帶給他:1條被褻瀆的束腰，8個受戰爭破壞的鎧甲碎塊，1個奧金錠和3個聯結水晶。',
  }
},
[9050] = {
  {
    '‡Накулачники искупления‡Handgelenksschützer der Erlösung‡구원의 손목보호대‡Guardamuñecas de redención‡Guardamuñecas de redención‡Garde-poignets de rédemption‡救赎护腕‡救贖腕甲',
    nil,
    '‡Командир Элигор Вестник Рассвета из Часовни Последней Надежды, что в Восточных Чумных землях, готов сделать накулачники Искупления, если вы принесете ему следующее: 1 испоганенные накулачники, 6 обломков доспехов, 1 слиток арканита и 2 обработанных грубых шкуры.‡Kommandant Eligor Morgenbringer bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Paar Handgelenksschützer der Erlösung anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Handgelenksschützer, 6 kampfzerschlissene Plattenstücke, 1 Arkanitbarren und 2 geschmeidige unverwüstliche Bälge.‡‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas de redención si le traes lo siguiente: 1 guardamuñecas profanados, 6 restos de corazas, 1 barra de arcanita y 2 pellejos bastos curtidos.‡El comandante Eligor Albar de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas de redención si le traes lo siguiente: 1 guardamuñecas profanados, 6 restos de corazas, 1 barra de arcanita y 2 pellejos bastos curtidos.‡Le commandant Eligor Portelaube de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des Garde-poignets de rédemption si vous lui rapportez 1 paire de Garde-poignets désacralisés, 6 Débris d\'armure en plaques, 1 Barre d\'arcanite et 2 Peaux robustes traitées.‡如果你将1副被玷污的护腕，6块板甲碎片，1块奥金锭和2个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的指挥官埃里戈尔·黎明使者，他将为你制作一副救赎护腕。‡東瘟疫之地聖光之願禮拜堂的指揮官艾利格·黎明使者將為你製作救贖腕甲，只要你將下列物品帶給他:1對被褻瀆的束腕，6個受戰爭破壞的鎧甲碎塊，1個奧金錠和2塊熟化毛皮。',
  }
},
[9051] = {
  {
    '‡Испытание яда‡Giftexperiment‡‡Prueba de toxicidad‡Prueba de toxicidad‡Test de toxicité‡毒性测试‡',
    nil,
    '‡Уколите дьявозавра колючкой дьявозавра. По выполнении задания вернитесь к Землепроходцу Торве.‡Stecht einen Teufelssaurier mit dem Teufelssaurierhaken und kehrt danach zu Torwa Pfadfinder im Krater von Un\'Goro zurück.‡‡Clávale la púa de demosaurio a un demosaurio. Ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro cuando hayas completado tu tarea.‡Clávale la púa de demosaurio a un demosaurio. Ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro cuando hayas completado tu tarea.‡Piquez un Diablosaure avec l\'Aiguillon de diablosaure. Retournez voir Torwa le Guide au Cratère d\'Un\'goro lorsque vous aurez accompli cette tâche.‡将魔暴龙之刺扎入一只魔暴龙的体内。‡',
  }
},
[9052] = {
  {
    'Veneno de Pétala Sangrenta‡Яд кровоцвета‡Blutblütengift‡붉은꽃잎덩굴손 독‡Veneno de Sangrepétalo‡Veneno de Sangrepétalo‡Le poison Pétale-de-sang‡血瓣毒药‡血瓣花之毒',
    nil,
    'Colete 8 Cogumelos Vermelhos e 8 Ferrões de Gorishi e fale novamente com Torwa Mateiro na Cratera Un\'Goro.‡Соберите 8 кровошляпочников и 8 жал Гориши и вернитесь к Землепроходцу Торве в Кратер Ун\'Горо.‡Sammelt 8 Blutkappenpilze und 8 Gorishistachel und kehrt zu Torwa Pfadfinder im Krater von Un\'Goro zurück.‡붉은갓버섯 8개와 고리쉬 독침 8개를 모아서 운고로 분화구에 있는 토르와 패스파인더에게 가야 합니다.‡Reúne 8 champiñones de sangre y 8 aguijones Gorishi, y ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro.‡Reúne 8 champiñones de sangre y 8 aguijones Gorishi, y ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro.‡Récupérez 8 Chapeaux de sang et 8 Dards de Gorishi, puis retournez voir Torwa le Guide au cratère d\'Un\'goro.‡收集一些血帽和格里什钉刺，然后向托尔瓦·寻路者复命。‡收集8個血帽和8個格里什毒刺，交給安戈洛環形山的托爾瓦·尋路者。',
  }
},
[9053] = {
  {
    'Um ingrediente melhor‡Лучший ингредиент‡Eine bessere Zutat‡더욱 강력한 재료‡Un ingrediente mejor‡Un ingrediente mejor‡Un meilleur ingrédient‡更好的材料‡更好的材料',
    nil,
    'Consiga uma Trepadeira Pútrida do guardião no fundo do Templo Submerso e fale novamente com Torwa Mateiro.‡Возьмите гнилую лозу у стража на дне затонувшего храма и вернитесь к Землепроходцу Торве.‡Beschafft Euch eine Fäulnisranke von dem Wächter auf dem Grund des Versunkenen Tempels und kehrt zu Torwa Pfadfinder zurück.‡가라앉은 사원 하층부의 수호병으로부터 썩은 덩굴을 찾은 후 토르와 패스파인더에게 가야 합니다.‡Consigue una vid pútrida de las que custodia el guardián en las profundidades del Templo Sumergido y después ve a ver de nuevo a Torwa Abrecaminos.‡Consigue una vid pútrida de las que custodia el guardián en las profundidades del Templo Sumergido y después ve a ver de nuevo a Torwa Abrecaminos.‡Récupérez une Liane putride sur le Gardien au fond du Temple englouti et revenez voir Torwa le Guide.‡从沉没的神庙底部的守卫身上得到一些腐烂藤蔓，把它们交给托尔瓦·寻路者。‡前往沉沒的神廟底部，從守衛那取回腐爛的藤蔓並交給托爾瓦·尋路者。',
  }
},
[9054] = {
  {
    'Túnica criptalante‡Мундир расхитителя гробниц‡Tunika des Gruftpirschers‡지하추적자 튜닉‡La guerrera de acechacriptas‡La guerrera de acechacriptas‡La tunique de traqueur des cryptes‡地穴追猎者外套‡地穴巡者外套',
    nil,
    'O Guarda-caça Leopold, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Túnica Criptalante se você levar para ele: 1 Túnica Profanada, 25 Restos de Cota de Malha, 4 Barras de Arcanita e 3 Pelegos Rústicos Curados.‡Охотник Леопольд из часовни Последней Надежды в Восточных Чумных землях готов создать мундир расхитителя гробниц, если вы принесете ему 1 испоганенный мундир, 25 обрывков кольчуги, 4 слитка арканита и 3 обработанных грубых шкуры.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Tunika des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Tunika, 25 kampfzerschlissene Kettenstücke, 4 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 사냥꾼 레오폴드에게 모독의 튜닉 1개, 닳아해진 사슬 조각 25개, 아케이나이트 주괴 4개, 거친 경화 가죽 3개를 가져가면 지하추적자 튜닉을 만들어 줄 것입니다.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera de acechacriptas si le llevas lo siguiente: 1 guerrera profanada, 25 restos de malla, 4 barras de arcanita y 3 pellejos bastos curtidos.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera de acechacriptas si le llevas lo siguiente: 1 guerrera profanada, 25 restos de malla, 4 barras de arcanita y 3 pellejos bastos curtidos.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une tunique de traqueur des cryptes si vous lui apportez les choses suivantes : 1 Tunique désacralisée, 25 Débris d\'armure en mailles, 4 Barres d\'arcanite, et 3 Peaux robustes traitées.‡如果你将1件被玷污的外套、25块锁甲碎片、4块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一件地穴追猎者外套。‡東瘟疫之地聖光之願禮拜堂的獵人里歐波將為你製作地穴巡者外套，只要你將下列物品帶給他:1件被褻瀆的外套，25個受戰爭破壞的鍊甲碎塊，4個奧金錠和3塊熟化毛皮。',
  }
},
[9055] = {
  {
    '‡Набедренники расхитителя гробниц‡Beinschützer des Gruftpirschers‡지하추적자 다리보호대‡Musleras de acechacriptas‡Musleras de acechacriptas‡Garde-jambes de traqueur des cryptes‡地穴追猎者护腿‡地穴巡者腿甲',
    nil,
    '‡Охотник Леопольд из Часовни Последней Надежды в Восточных Чумных землях готов создать набедренники Расхитителя гробниц, если вы принесете ему следующее: 1 испоганенные набедренники, 20 обрывков кольчуги, 3 слитка арканита и 5 обработанных грубых шкур.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinschützer des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinschützer, 20 kampfzerschlissene Kettenstücke, 3 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras de acechacriptas si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de malla, 3 barras de arcanita y 5 pellejos bastos curtidos.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras de acechacriptas si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de malla, 3 barras de arcanita y 5 pellejos bastos curtidos.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des garde-jambes de traqueur des cryptes si vous lui apportez les choses suivantes : 1 paire de Garde-jambes désacralisés, 20 Débris d\'armure en mailles, 3 Barres d\'arcanite, et 5 Peaux robustes traitées.‡如果你将1条被玷污的腿甲、20块锁甲碎片、3块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一条地穴追猎者腿甲。‡',
  }
},
[9056] = {
  {
    '‡Головной убор расхитителя гробниц‡Kopfstück des Gruftpirschers‡지하추적자 머리쓰개‡Celada de acechacriptas‡Celada de acechacriptas‡Le couvre-chef de traqueur des cryptes‡地穴追猎者头饰‡地穴巡者首盔',
    nil,
    '‡Охотник Леопольд из Часовни Последней Надежды в Восточных Чумных землях готов создать головной убор Расхитителя гробниц, если вы принесете ему следующее: 1 испоганенный головной убор, 15 обрывков кольчуги, 4 слитка арканита и 2 кристалла-источника.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Kopfstück des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihtes Kopfstück, 15 kampfzerschlissene Kettenstücke, 4 Arkanitbarren und 2 Nexuskristalle.‡‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una celada de acechacriptas si le llevas lo siguiente: 1 celada profanada, 15 restos de malla, 4 barras de arcanita y 2 cristales nexo.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una celada de acechacriptas si le llevas lo siguiente: 1 celada profanada, 15 restos de malla, 4 barras de arcanita y 2 cristales nexo.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera un couvre-chef de traqueur des cryptes si vous lui apportez les choses suivantes : 1 Couvre-chef désacralisé, 15 Débris d\'armure en mailles, 4 Barres d\'arcanite et 2 Cristaux de nexus.‡如果你将1件被玷污的头饰、15块锁甲碎片、4块奥金锭和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一件地穴追猎者头饰。‡',
  }
},
[9057] = {
  {
    '‡Наплеч расхитителя гробниц‡Schiftung des Gruftpirschers‡지하추적자 어깨덮개‡Bufas de acechacriptas‡Bufas de acechacriptas‡Spallières de traqueur des cryptes‡地穴追猎者肩甲‡地穴巡者肩甲',
    nil,
    '‡Охотник Леопольд из Часовни Последней Надежды в Восточных Чумных землях готов создать наплеч Расхитителя гробниц, если вы принесете ему следующее: 1 испоганенный наплеч, 12 обрывков кольчуги, 2 слитка арканита и 3 обработанных грубых шкуры.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Schiftung des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Schiftung, 12 kampfzerschlissene Kettenstücke, 2 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas de acechacriptas si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de malla, 2 barras de arcanita y 3 pellejos bastos curtidos.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas de acechacriptas si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de malla, 2 barras de arcanita y 3 pellejos bastos curtidos.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des spallières de traqueur des cryptes si vous lui apportez les choses suivantes : 1 paire de Spallières désacralisées, 12 Débris d\'armure en mailles, 2 Barres d\'arcanite, et 3 Peaux robustes traitées.‡如果你将1副被玷污的肩饰、12块锁甲碎片、2块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一副地穴追猎者肩饰。‡',
  }
},
[9058] = {
  {
    'Botas criptalantes‡Сапоги расхитителя гробниц‡Stiefel des Gruftpirschers‡지하추적자 장화‡Las botas de acechacriptas‡Las botas de acechacriptas‡Les bottes de traqueur des cryptes‡地穴追猎者长靴‡地穴巡者長靴',
    nil,
    'O Guarda-caça Leopold, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um par de Botas Criptalantes se você levar para ele: 1 par de Botas Profanadas, 12 Restos de Cota de Malha, 1 Barra de Arcanita e 3 Cristais do Nexus.‡Охотник Леопольд из часовни Последней Надежды в Восточных Чумных землях готов создать сапоги расхитителя гробниц, если вы принесете ему 1 испоганенные сапоги, 12 обрывков кольчуги, 1 слиток арканита и 3 кристалла-источника.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Stiefel des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Stiefel, 12 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 3 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 사냥꾼 레오폴드에게 모독의 장화 1개, 닳아해진 사슬 조각 12개, 아케이나이트 주괴 1개, 마력의 결정체 3개를 가져가면 지하추적자 장화를 만들어 줄 것입니다.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas de acechacriptas si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de malla, 1 barra de arcanita y 3 cristales nexo.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas de acechacriptas si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de malla, 1 barra de arcanita y 3 cristales nexo.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des bottes de traqueur des cryptes si vous lui apportez les choses suivantes : 1 paire de Bottes désacralisées, 12 Débris d\'armure en mailles, 1 Barre d\'arcanite et 3 Cristaux de nexus.‡如果你将1双被玷污的长靴、12块锁甲碎片、1块奥金锭和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一双地穴追猎者长靴。‡東瘟疫之地聖光之願禮拜堂的獵人里歐波將為你製作地穴巡者長靴，只要你將下列物品帶給他:1雙被褻瀆的長靴，12個受戰爭破壞的鍊甲碎塊，1個奧金錠和3個聯結水晶。',
  }
},
[9059] = {
  {
    '‡Боевые рукавицы расхитителя гробниц‡Handschützer des Gruftpirschers‡지하추적자 손보호대‡Manoplas de acechacriptas‡Manoplas de acechacriptas‡Garde-mains de traqueur des cryptes‡地穴追猎者护手‡地穴巡者手甲',
    nil,
    '‡Охотник Леопольд из Часовни Последней Надежды в Восточных Чумных землях готов создать боевые рукавицы Расхитителя гробниц, если вы принесете ему следующее: 1 испоганенные боевые рукавицы, 8 обрывков кольчуги, 1 слиток арканита и 5 обработанных грубых шкур.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Handschützer des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Handschützer, 8 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas de acechacriptas si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de malla, 1 barra de arcanita y 5 pellejos bastos curtidos.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas de acechacriptas si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de malla, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des garde-mains de traqueur des cryptes si vous lui apportez les choses suivantes : 1 paire de Garde-mains désacralisés, 8 Débris d\'armure en mailles, 1 Barre d\'arcanite et 5 Peaux robustes traitées.‡如果你将1副被玷污的手甲、8块锁甲碎片、1块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一副地穴追猎者护手。‡',
  }
},
[9060] = {
  {
    'Cinturão Criptalante‡Ремень расхитителя гробниц‡Gurt des Gruftpirschers‡지하추적자 요대‡La faja de acechacriptas‡La faja de acechacriptas‡Le ceinturon de traqueur des cryptes‡地穴追猎者束带‡地穴巡者束腰',
    nil,
    'O Guarda-caça Leopold, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Cinturão Criptalante se você levar para ele: 1 Cinturão Profanado, 8 Restos de Cota de Malha, 1 Barra de Arcanita e 3 Cristais do Nexus.|n‡Охотник Леопольд из часовни Последней Надежды в Восточных Чумных землях готов сделать ремень расхитителя гробниц, если вы принесете ему 1 испоганенный ремень, 8 обрывков кольчуги, 1 слиток арканита и 3 кристалла-источника.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Gurt des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Gurt, 8 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 3 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 사냥꾼 레오폴드에게 모독의 요대 1개, 닳아해진 사슬 조각 8개, 아케이나이트 주괴 1개, 마력의 결정체 3개를 가져가면 지하추적자 요대를 만들어 줄 것입니다.‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja de acechacriptas si le llevas lo siguiente: 1 faja profanada, 8 restos de malla, 1 barra de arcanita y 3 cristales nexo.|n‡El montero Leopold de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja de acechacriptas si le llevas lo siguiente: 1 faja profanada, 8 restos de malla, 1 barra de arcanita y 3 cristales nexo.|n‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera un ceinturon de traqueur des cryptes si vous lui apportez les choses suivantes : 1 Ceinturon désacralisé, 8 Débris d\'armure en mailles, 1 Barre d\'arcanite et 3 Cristaux de nexus.‡如果你将1条被玷污的束带、8块锁甲碎片、1块奥金锭和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一条地穴追猎者束带。‡東瘟疫之地聖光之願禮拜堂的獵人里歐波將為你製作地穴巡者束腰，只要你將下列物品帶給他:1個被褻瀆的束腰，8個受戰爭破壞的鍊甲碎塊，1個奧金錠和3個聯結水晶。',
  }
},
[9061] = {
  {
    '‡Накулачники расхитителя гробниц‡Handgelenksschützer des Gruftpirschers‡지하추적자 손목보호대‡Guardamuñecas de acechacriptas‡Guardamuñecas de acechacriptas‡Garde-poignets de traqueur des cryptes‡地穴追猎者护腕‡地穴巡者腕甲',
    nil,
    '‡Охотник Леопольд из Часовни Последней Надежды в Восточных Чумных землях готов создать накулачники Расхитителя гробниц, если вы принесете ему следующее: 1 испоганенные накулачники, 6 обрывков кольчуги, 1 слиток арканита и 2 обработанных грубых шкуры.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Paar Handgelenksschützer des Gruftpirschers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Handgelenksschützer, 6 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 2 geschmeidige unverwüstliche Bälge.‡‡El montero Leopold de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas de acechacriptas si le llevas lo siguiente: 1 guardamuñecas profanado, 6 restos de malla, 1 barra de arcanita y 2 pellejos bastos curtidos.‡El montero Leopold de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas de acechacriptas si le llevas lo siguiente: 1 guardamuñecas profanado, 6 restos de malla, 1 barra de arcanita y 2 pellejos bastos curtidos.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des Garde-poignets de traqueur des cryptes si vous lui apportez les choses suivantes : 1 paire de Protège-poignets désacralisés, 6 Débris d\'armure en mailles, 1 Barre d\'arcanite et 2 Peaux robustes traitées.‡如果你将1副被玷污的腕甲、6块锁甲碎片、1块奥金锭和2个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德，他会为你制作一副地穴追猎者腕甲。‡',
  }
},
[9062] = {
  {
    'Pacotes encharcados‡Промокшие страницы‡Aufgeweichte Seiten‡물에 젖은 책‡Papel mojado‡Papel mojado‡Des pages trempées‡浸水的书页‡浸濕的書頁',
    nil,
    'O Aprendiz Meledor, na Floresta do Canto Eterno, quer que você procure o Grimório Elemental de Antheol na água embaixo da ponte ao lado.‡Отыщите в реке под мостом гримуар стихий Антеола по просьбе ученика Меледора.‡Lehrling Meledor im Immersangwald möchte, dass Ihr im Gewässer unterhalb der nahegelegenen Brücke sucht und ihm Antheols Foliant der Elementarmagie bringt.‡영원노래 숲의 수습생 멜레도르가 다리 아래 물속을 조사해서 안시올의 원소 마법서를 찾아달라고 했습니다.‡El aprendiz Meledor del Bosque Canción Eterna quiere que busques el grimorio elemental de Antheol en las aguas bajo el puente.‡El aprendiz Meledor del Bosque Canción Eterna quiere que busques el grimorio elemental de Antheol en las aguas bajo el puente.‡L\'apprenti Meledor, du bois des Chants éternels, veut que vous cherchiez dans l\'eau, sous le pont, et que vous lui apportiez le Grimoire élémentaire d\'Antheol.‡永歌森林的学徒梅雷多尔让你搜寻附近桥梁下的水域，帮他找到安瑟隆的元素魔典。‡永歌森林的學徒美勒杜要你去附近的橋邊搜尋水裡，把安西歐的元素魔典帶給他。',
  }
},
[9063] = {
  {
    'Torwa Mateiro‡Землепроходец Торва‡Torwa Pfadfinder‡토르와 패스파인더‡Torwa Abrecaminos‡Torwa Abrecaminos‡Torwa le Guide‡托尔瓦·寻路者‡托爾瓦·尋路者',
    nil,
    'Fale com Torwa Mateiro na Cratera Un\'Goro.‡Поговорите с Землепроходцем Торвой в Кратере Ун\'Горо.‡Sprecht im Krater von Un\'Goro mit Torwa Pfadfinder.‡운고로 분화구에 있는 토르와 패스파인더와 대화해야 합니다.‡Habla con Torwa Abrecaminos en el Cráter de Un\'Goro.‡Habla con Torwa Abrecaminos en el Cráter de Un\'Goro.‡Parler à Torwa le Guide au cratère d\'Un\'goro.‡与安戈洛环形山的托尔瓦·寻路者谈一谈。‡與安戈洛環形山的托爾瓦·尋路者談一談。',
  }
},
[9064] = {
  {
    'A casa caiu‡Взять вину на себя‡Die Sache ausbaden‡들통날 거짓말‡Asumiendo la responsabilidad‡Asumiendo la responsabilidad‡Amortir la colère‡学徒的欺瞒‡說謊',
    nil,
    'Entregue o Grimório Elemental de Antheol ao Instrutor Antheol na Lagoa do Eterno Sussurro, que fica na Floresta do Canto Eterno.‡Принесите гримуар стихий Антеола инструктору Антеолу у пруда Тихого Шелеста в лесах Вечной Песни.‡Bringt Antheols Foliant der Elementarmagie zu Instrukteur Antheol beim Stillwispertümpel im Immersangwald.‡영원노래 숲의 잔잔한 속삭임 연못에 있는 스승 안시올에게 안시올의 원소 마법서를 가져가야 합니다.‡Lleva el grimorio elemental de Antheol al instructor Antheol a la Charca Plácido Susurro en el Bosque Canción Eterna.‡Lleva el grimorio elemental de Antheol al instructor Antheol a la Charca Plácido Susurro en el Bosque Canción Eterna.‡Rendre le Grimoire élémentaire d\'Antheol à l\'instructeur Antheol, à l\'étang des Murmures-sereins du bois des Chants éternels.‡将安瑟隆的元素魔典交给永歌森林的萦语水池旁的指导者安瑟隆。‡把安西歐的元素魔典帶到永歌森林的靜語池給講師安西歐。',
  }
},
[9065] = {
  {
    'The Pattymac Special‡Задание Чоу (123)аа‡Pattymack-Spezial‡The Pattymac Special‡Otra especial de Patty‡Otra especial de Patty‡La tour a intérêt à prendre garde‡The Pattymac Special‡派迪麥克斯任務',
    nil,
    'Make sure you destroy that tower!‡Убедитесь, что вы уничтожили эту башню!‡Stell sicher, dass du den Turm zerstörst!‡Make sure you destroy that tower!‡¡Destruye esa torre!‡¡Destruye esa torre!‡Assurez-vous que vous avez bien détruit la tour !‡Make sure you destroy that tower!‡確定你摧毀了那座塔!',
  }
},
[9066] = {
  {
    'O castigo vem a cavalo‡Суровый урок‡Disziplin muss sein‡따끔한 교훈‡La letra con sangre entra‡La letra con sangre entra‡Une punition expéditive‡导师的训诫‡即時的懲罰',
    nil,
    'Use o Bastão Disciplinar de Antheol em seus dois alunos: Aprendiz Ralen e Aprendiz Meledor. Em seguida, devolva o bastão para Antheol na Lagoa do Eterno Sussurro, que fica na Floresta do Canto Eterno.‡Накажите карающим жезлом Антеола двух его студентов, ученика Ралена и ученика Меледора. Верните жезл Антеолу у пруда Тихого Шелеста в лесах Вечной Песни.‡Wendet Antheols Disziplinarsstab bei seinen zwei Schülern an: Lehrling Ralen und Lehrling Meledor. Kehrt anschließend mit dem Stab zu Antheol beim Stillwispertümpel im Immersangwald zurück.‡안시올의 두 수습생인 랄렌과 멜레도르에게 안시올의 지도봉을 사용하십시오. 일을 마치면 지도봉을 가지고 영원노래 숲의 잔잔한 속삭임 연못에 있는 안시올에게 가야 합니다.‡Usa la vara de castigo de Antheol en el aprendiz Ralen y el aprendiz Meledor. Devuélvele la vara a Antheol en Charca Plácido Susurro en Bosque Canción Eterna.‡Usa la vara de castigo de Antheol en el aprendiz Ralen y el aprendiz Meledor. Devuélvele la vara a Antheol en Charca Plácido Susurro en Bosque Canción Eterna.‡Utilisez la baguette que vous a confié l\'instructeur Antheol sur ses deux étudiants, les apprentis Ralen et Meledor. Rapportez ensuite le Bâtonnet disciplinaire d\'Antheol à l\'étang des Murmures-sereins dans le bois des Chants éternels‡对指导者安瑟隆的两名学生：学徒拉尔雷和学徒梅雷多尔使用他交给你的魔杖。然后将安瑟隆的训诫棒还给永歌森林萦语水池旁的安瑟隆。‡在安西歐的兩個學生身上使用安西歐的懲戒魔棒:學徒瑞倫和學徒美勒杜。再帶著魔棒回到永歌森林的靜語池找安西歐。',
  }
},
[9067] = {
  {
    'A noite nunca tem fim‡Бесконечный праздник‡Die Feier ist nie zu Ende‡파티는 끝나지 않는다‡Fiesta interminable‡Fiesta interminable‡La fête ne s\'arrête jamais‡无尽的宴会‡夜夜狂歡',
    nil,
    'Consiga uma garrafa de Reserva Especial Tocada pelo Sol, Aperitivos de Garrataque e um Pacote de Fogos de Artifício. Em seguida, entregue tudo para o Lorde Saltheril no Refúgio de Saltheril, que fica na Floresta do Canto Eterno.‡Добудьте бутылку "Благословения Солнца Гранд Резерв", закуску из прыголапа и связку фейерверков и принесите все это лорду Салтерилу на виллу Салтерила, что в лесах Вечной Песни.‡Besorgt eine Flasche Bester Sonnentropfen, Bachtatzenhäppchen und ein Feuerwerksbündel und bringt alles zu Lord Saltheril in Saltherils Hafen im Immersangwald.‡햇살 깃든 특등급 포도주 1병, 갈기발 요리, 폭죽 다발을 구해서, 영원노래 숲의 살데릴의 안식처에 있는 살데릴 경에게 가져가야 합니다.‡Compra 1 botella de Toquesol especial, aperitivos de garragil y 1 paquete de fuegos artificiales y llévaselo todo a Lord Saltheril al Refugio de Saltheril en el Bosque Canción Eterna.‡Compra 1 botella de Toquesol especial, aperitivos de garragil y 1 paquete de fuegos artificiales y llévaselo todo a Lord Saltheril al Refugio de Saltheril en el Bosque Canción Eterna.‡Procurez-vous une bouteille de la Cuvée spéciale de Solegrâce, des Hors-d\'œuvre preste-patte et un Fagot de feux d\'artifice, et livrez le tout au seigneur Saltheril, au havre de Saltheril, dans le bois des Chants éternels.‡购买一瓶日光陈酿、一些魔泉美味和一捆烟花，然后向永歌森林萨瑟利尔庄园的萨瑟利尔男爵复命。‡取得陽光下的特殊美酒，泉爪開胃菜和一卷煙火，再回到永歌森林的薩瑟里的避風港交給薩瑟里領主。',
  }
},
[9068] = {
  {
    '‡Мундир Землекрушителя‡Tunika des Erdspalters‡지축이동의 튜닉‡Guerrera Rompeterra‡Guerrera Rompeterra‡Tunique de Brise-terre‡碎地者外套‡碎地者外套',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать мундир Землекрушителя, если вы принесете ему следующее: 1 испоганенный мундир, 25 обрывков кольчуги, 4 слитка арканита и 3 обработанных грубых шкуры.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Tunika des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Tunika, 25 kampfzerschlissene Kettenstücke, 4 Arkanitbarren und 3 geschmeidige unverwüstliche Bälge.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera Rompeterra si le llevas lo siguiente: 1 guerrera profanada, 25 restos de malla, 4 barras de arcanita y 3 pellejos bastos curtidos.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera Rompeterra si le llevas lo siguiente: 1 guerrera profanada, 25 restos de malla, 4 barras de arcanita y 3 pellejos bastos curtidos.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera une tunique de Brise-terre si vous lui apportez les objets suivants : 1 Tunique désacralisée, 25 Débris d\'armure en mailles, 4 Barres d\'arcanite et 3 Peaux robustes traitées.‡如果你将1件被玷污的外套、25块锁甲碎片、4块奥金锭和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的雷布拉特·碎地者，他将为你制作一件碎地者外套。‡',
  }
},
[9069] = {
  {
    '‡Набедренники Землекрушителя‡Beinschützer des Erdspalters‡지축이동의 다리보호대‡Musleras Rompeterra‡Musleras Rompeterra‡Le kilt de Brise-terre‡碎地者腿甲‡碎地者腿甲',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать набедренники Землекрушителя, если вы принесете ему следующее: 1 испоганенные набедренники, 20 обрывков кольчуги, 3 слитка арканита и 5 обработанных грубых шкур.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinschützer des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinschützer, 20 kampfzerschlissene Kettenstücke, 3 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras Rompeterra si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de malla, 3 barras de arcanita y 5 pellejos bastos curtidos.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras Rompeterra si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de malla, 3 barras de arcanita y 5 pellejos bastos curtidos.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera un kilt de Brise-terre si vous lui apportez les objets suivants : 1 paire de Garde-jambes désacralisés, 20 Débris d\'armure en mailles, 3 Barres d\'arcanite et 5 Peaux robustes traitées.‡如果你将1副被玷污的腿甲、20块锁甲碎片、3块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的雷布拉特·碎地者，他将为你制作一副碎地者腿甲。‡東瘟疫之地聖光之願禮拜堂的林布拉特·碎地者將為你製作碎地者腿甲，只要你將下列物品帶給他:1對被褻瀆的腿甲，20個受戰爭破壞的鍊甲碎塊，3個奧金錠和5塊熟化毛皮。',
  }
},
[9070] = {
  {
    '‡Головной убор Землекрушителя‡Kopfstück des Erdspalters‡지축이동의 머리쓰개‡Celada Rompeterra‡Celada Rompeterra‡Chapel de Brise-terre‡碎地者头饰‡碎地者首盔',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать головной убор Землекрушителя, если вы принесете ему следующее: 1 испоганенный головной убор, 15 обрывков кольчуги, 4 слитка арканита и 2 кристалла-источника.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Kopfstück des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihtes Kopfstück, 15 kampfzerschlissene Kettenstücke, 4 Arkanitbarren und 2 Nexuskristalle.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un celada Rompeterra si le llevas lo siguiente: 1 celada profanada, 15 restos de malla, 4 barras de arcanita y 2 cristales nexo.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un celada Rompeterra si le llevas lo siguiente: 1 celada profanada, 15 restos de malla, 4 barras de arcanita y 2 cristales nexo.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera un chapel de Brise-terre si vous lui apportez les objets suivants : 1 Couvre-chef désacralisé, 15 Débris d\'armure en mailles, 4 Barres d\'arcanite et 2 Cristaux de nexus.‡东瘟疫之地圣光之愿礼拜堂的林布拉特·大地粉碎者将为你制作碎地者头盔，只要你将下列物品带给他：1个被亵渎的头甲，15个受战争破坏的链甲碎片，4个奥金锭和2个联结水晶。‡',
  }
},
[9071] = {
  {
    '‡Наплеч Землекрушителя‡Schiftung des Erdspalters‡지축이동의 어깨덮개‡Bufas Rompeterra‡Bufas Rompeterra‡Spallières de Brise-terre‡碎地者肩饰‡碎地者肩甲',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать наплеч Землекрушителя, если вы принесете ему следующее: 1 испоганенный наплеч, 12 обрывков кольчуги, 2 слитка арканита и 2 куска луноткани.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Schiftung des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Schiftung, 12 kampfzerschlissene Kettenstücke, 2 Arkanitbarren und 2 Einheiten Mondstoff.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas Rompeterra si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de malla, 2 barras de arcanita y 2 piezas de tela lunar.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas Rompeterra si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de malla, 2 barras de arcanita y 2 piezas de tela lunar.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera des spallières de Brise-terre si vous lui apportez les objets suivants : 1 paire de Spallières désacralisées, 12 Débris d\'armure en mailles, 2 Barres d\'arcanite et 2 Etoffes lunaires.‡东瘟疫之地圣光之愿礼拜堂的林布拉特·大地粉碎者将为你制作碎地者肩甲，只要你将下列物品带给他：1套被亵渎的护肩，12个受战争破坏的链甲碎片，2个奥金锭和2块月布。‡',
  }
},
[9072] = {
  {
    '‡Сапоги Землекрушителя‡Stiefel des Erdspalters‡지축이동의 장화‡Botas Rompeterra‡Botas Rompeterra‡Les bottes de Brise-terre‡碎地者长靴‡碎地者長靴',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать сапоги Землекрушителя, если вы принесете ему следующее: 1 испоганенные сапоги, 12 обрывков кольчуги, 1 слиток арканита и 3 кристалла-источника.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Stiefel des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Stiefel, 12 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 3 Nexuskristalle.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas Rompeterra si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de malla, 1 barra de arcanita y 3 cristales nexo.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas Rompeterra si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de malla, 1 barra de arcanita y 3 cristales nexo.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera des bottes de Brise-terre si vous lui apportez les objets suivants : 1 paire de Bottes désacralisées, 12 Débris d\'armure en mailles, 1 Barre d\'arcanite et 3 Cristaux de nexus.‡如果你将1双被玷污的长靴、12块锁甲碎片、1块奥金锭和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的雷布拉特·碎地者，他将为你制作一双碎地者长靴。‡',
  }
},
[9073] = {
  {
    '‡Боевые рукавицы Землекрушителя‡Handschützer des Erdspalters‡지축이동의 손보호대‡Manoplas Rompeterra‡Manoplas Rompeterra‡Garde-mains de Brise-terre‡碎地者护手‡碎地者手甲',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать боевые рукавицы Землекрушителя, если вы принесете ему следующее: 1 испоганенные боевые рукавицы, 8 обрывков кольчуги, 1 слиток арканита и 5 обработанных грубых шкур.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Handschützer des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Handschützer, 8 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas Rompeterra si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de malla, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas Rompeterra si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de malla, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera des garde-mains de Brise-terre si vous lui apportez les objets suivants : 1 paire de Garde-mains désacralisés, 8 Débris d\'armure en mailles, 1 Barre d\'arcanite et 5 Peaux robustes traitées.‡东瘟疫之地圣光之愿礼拜堂的林布拉特·大地粉碎者将为你制作碎地者护手，只要你将下列物品带给他：1套被亵渎的护手，8个受战争破坏的链甲碎片，1个奥金锭和5块熟化毛皮。‡',
  }
},
[9074] = {
  {
    '‡Ремень Землекрушителя‡Gurt des Erdspalters‡지축이동의 요대‡Faja Rompeterra‡Faja Rompeterra‡Ceinturon de Brise-terre‡碎地者束带‡碎地者束腰',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов сделать ремень Землекрушителя, если вы принесете ему следующее: 1 испоганенный ремень, 8 обрывков кольчуги, 1 слиток арканита и 3 кристалла-источника.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Gurt des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Gurt, 8 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 3 Nexuskristalle.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja Rompeterra si le llevas lo siguiente: 1 faja profanada, 8 restos de malla, 1 barra de arcanita y 3 cristales nexo.‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja Rompeterra si le llevas lo siguiente: 1 faja profanada, 8 restos de malla, 1 barra de arcanita y 3 cristales nexo.‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera un ceinturon de Brise-terre si vous lui apportez les objets suivants : 1 Ceinturon désacralisé, 8 Débris d\'armure en mailles, 1 Barre d\'arcanite et 3 Cristaux de nexus.‡东瘟疫之地圣光之愿礼拜堂的林布拉特·大地粉碎者将为你制作碎地者束腰，只要你将下列物品带给他：1个被亵渎的束腰，8个受战争破坏的链甲碎片，1个奥金锭和3个联结水晶。‡',
  }
},
[9075] = {
  {
    '‡Накулачники Землекрушителя‡Handgelenksschützer des Erdspalters‡지축이동의 손목보호대‡Guardamuñecas Rompeterra‡Guardamuñecas Rompeterra‡Garde-poignets de Brise-terre‡碎地者护腕‡碎地者腕甲',
    nil,
    '‡Римблат Землекрушитель из Часовни Последней Надежды в Восточных Чумных землях готов создать накулачники Землекрушителя, если вы принесете ему следующее: 1 испоганенные накулачники, 6 обрывков кольчуги, 1 слиток арканита и 2 обработанных грубых шкуры.‡Rimblat Erdspalter bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Paar Handgelenksschützer des Erdspalters anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Handgelenksschützer, 6 kampfzerschlissene Kettenstücke, 1 Arkanitbarren und 2 geschmeidige unverwüstliche Bälge.‡‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas Rompeterra si le llevas lo siguiente: 1 par de guardamuñecas profanados, 6 restos de malla, 1 barra de arcanita y 2 pellejos bastos curtidos.|n‡Rimblat Rompeterra de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas Rompeterra si le llevas lo siguiente: 1 par de guardamuñecas profanados, 6 restos de malla, 1 barra de arcanita y 2 pellejos bastos curtidos.|n‡Rimblat Brise-terre à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous fabriquera des Garde-poignets de Brise-terre si vous lui apportez les objets suivants : 1 paire de Protège-poignets désacralisés, 6 Débris d\'armure en mailles, 1 Barre d\'arcanite et 2 Peaux robustes traitées.‡东瘟疫之地圣光之愿礼拜堂的林布拉特·大地粉碎者将为你制作碎地者护腕，只要你将下列物品带给他：1对被亵渎的束腕，6个受战争破坏的链甲碎片，1个奥金锭和2块熟化毛皮。‡',
  }
},
[9076] = {
  {
    'O líder dos Ignóbeis‡Главарь Презренных‡Getriebener Rädelsführer‡버림받은 자들의 우두머리‡El jefe de los desdichados‡El jefe de los desdichados‡Le maître des Déshérités‡失心者的领袖‡鄙惡者頭目',
    nil,
    'Leve a Cabeça de Aldaron para Velendris Matinalba perto do Ancoradouro Velaclara, na Floresta do Canto Eterno.‡Принесите голову Альдарона Велендрису Белому Рассвету у причала Солнечного Паруса в лесах Вечной Песни.‡Bringt Aldarons Kopf zu Velendris Weißflor nahe des Ankerplatzes der Sonnensegel im Immersangwald.‡알다론을 처치하고 영원노래 숲의 해돋이 부두 근처에 있는 벨렌드리스 화이트몬에게 그 증거를 가져가야 합니다.‡Lleva la cabeza de Aldaron a Velendris Albodía cerca del Fondeadero Vela del Sol en Bosque Canción Eterna.‡Lleva la cabeza de Aldaron a Velendris Albodía cerca del Fondeadero Vela del Sol en Bosque Canción Eterna.‡Apportez la Tête d\'Aldaron à Velendris Blancmatin, à côté du mouillage des Voiles du soleil, dans le bois des Chants éternels.‡将奥尔达隆的徽记交给永歌森林阳帆港附近的维雷迪斯·雪晨。‡把阿德倫的頭顱帶給永歌森林日帆船廠附近的微蘭德絲·白晨。',
  }
},
[9077] = {
  {
    '‡Кираса костяной косы‡Brustplatte der Knochensense‡해골사신의 가슴보호갑‡Coraza Segahuesos‡Coraza Segahuesos‡Cuirasse de la faucheuse d\'os‡骨镰胸甲‡骨鐮胸甲',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать кирасу костяной косы, если вы принесете ему следующее: 1 испоганенную кирасу, 25 обрывков кожи, 2 слитка арканита и 6 обработанных грубых шкур.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Brustplatte der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Brustplatte, 25 kampfzerschlissene Lederstücke, 2 Arkanitbarren und 6 geschmeidige unverwüstliche Bälge.‡‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una coraza Segahuesos si le llevas lo siguiente: 1 coraza profanada, 25 restos de cuero, 2 barras de arcanita y 6 pellejos bastos curtidos.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una coraza Segahuesos si le llevas lo siguiente: 1 coraza profanada, 25 restos de cuero, 2 barras de arcanita y 6 pellejos bastos curtidos.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera une cuirasse de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 Cuirasse désacralisée, 25 Débris d\'armure en cuir, 2 Barres d\'arcanite et 6 Peaux robustes traitées.‡如果你将1件被玷污的胸甲、25块皮甲碎片、2块奥金锭和6个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一件骨镰胸甲。‡',
  }
},
[9078] = {
  {
    '‡Ножные латы костяной косы‡Beinplatten der Knochensense‡해골사신의 다리갑옷‡Quijotes Segahuesos‡Quijotes Segahuesos‡Cuissards de la faucheuse d\'os‡骨镰腿铠‡骨鐮腿鎧',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать ножные латы костяной косы, если вы принесете ему следующее: 1 испоганенные ножные латы, 20 обрывков кожи, 1 слиток арканита, 8 обработанных грубых шкур и 100 золотых.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinplatten der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinplatten, 20 kampfzerschlissene Lederstücke, 1 Arkanitbarren, 8 geschmeidige unverwüstliche Bälge und 100 Goldstücke.‡‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos quijotes Segahuesos si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de cuero, 1 barra de arcanita, 8 pellejos bastos curtidos y 100 piezas de oro.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos quijotes Segahuesos si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de cuero, 1 barra de arcanita, 8 pellejos bastos curtidos y 100 piezas de oro.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des cuissards de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 paire de Cuissards désacralisés, 20 Débris d\'armure en cuir, 1 Barre d\'arcanite, 8 Peaux robustes traitées et 100 pièces d\'or.‡如果你将1副被玷污的腿铠、20块皮甲碎片、1块奥金锭、8个熟化毛皮和100金币交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一副骨镰腿铠。‡',
  }
},
[9079] = {
  {
    '‡Полный шлем костяной косы‡Helm der Knochensense‡해골사신의 보호모‡Casco Segahuesos‡Casco Segahuesos‡Casque de la faucheuse d\'os‡骨镰头盔‡骨鐮盔帽',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать шлем костяной косы, если вы принесете ему следующее: 1 испоганенный шлем, 15 обрывков кожи, 8 обработанных грубых шкур, 1 кристалл-источник и 75 золотых.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Helm der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Helm, 15 kampfzerschlissene Lederstücke, 8 geschmeidige unverwüstliche Bälge. 1 Nexuskristall und 75 Goldstücke.‡‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un casco Segahuesos si le llevas lo siguiente: 1 casco profanado, 15 restos de cuero, 8 pellejos bastos curtidos, 1 cristal nexo y 75 piezas de oro.|n‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un casco Segahuesos si le llevas lo siguiente: 1 casco profanado, 15 restos de cuero, 8 pellejos bastos curtidos, 1 cristal nexo y 75 piezas de oro.|n‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera un casque de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 Heaume désacralisé, 15 Débris d\'armure en cuir, 8 Peaux robustes traitées, 1 Cristal de nexus et 75 pièces d\'or.‡如果你将1顶被玷污的头盔、15块皮甲碎片、8个熟化毛皮、1块连结水晶和75金币交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一顶骨镰头盔。‡',
  }
},
[9080] = {
  {
    '‡Наплечье костяной косы‡Schulterstücke der Knochensense‡해골사신의 견갑‡Espaldares Segahuesos‡Espaldares Segahuesos‡Espauliers de la faucheuse d\'os‡骨镰肩铠‡骨鐮肩鎧',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать наплечье костяной косы, если вы принесете ему следующее: 1 испоганенное наплечье, 12 обрывков кожи, 5 обработанных грубых шкур, 1 кристалл-источник и 50 золотых.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Schulterstücke der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Schulterstücke, 12 kampfzerschlissene Lederstücke, 5 geschmeidige unverwüstliche Bälge, 1 Nexuskristall und 50 Goldstücke.‡[Rohan the Assassin at Light\'s Hope Chapel in the Eastern Plaguelands will make Bonescythe Pauldrons if you bring him the following: 1 Desecrated Pauldrons, 12 Wartorn Leather Scraps, 5 Cured Rugged Hides, 1 Nexus Crystal and 50 gold pieces. ]‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos espaldares Segahuesos si le llevas lo siguiente: un par de espaldares profanados, 12 restos de cuero, 5 pellejos bastos curtidos, 1 cristal nexo y 50 piezas de oro.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos espaldares Segahuesos si le llevas lo siguiente: un par de espaldares profanados, 12 restos de cuero, 5 pellejos bastos curtidos, 1 cristal nexo y 50 piezas de oro.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des espauliers de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 paire d\'Espauliers désacralisés, 12 Débris d\'armure en cuir, 5 Peaux robustes traitées, 1 Cristal de nexus et 50 pièces d\'or.‡如果你将1副被玷污的肩铠、12块皮甲碎片、5个熟化毛皮、1块连结水晶和50金币交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一副骨镰肩铠。‡',
  }
},
[9081] = {
  {
    '‡Башмаки костяной косы‡Sabatons der Knochensense‡해골사신의 발덮개‡Escarpes Segahuesos‡Escarpes Segahuesos‡Solerets de la faucheuse d\'os‡骨镰马靴‡骨鐮脛甲',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать башмаки костяной косы, если вы принесете ему следующее: 1 испоганенные башмаки, 12 обрывков кожи, 3 обработанных грубых шкуры, 2 кристалла-источника и 25 золотых.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Sabatons der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Sabatons, 12 kampfzerschlissene Lederstücke, 3 geschmeidige unverwüstliche Bälge, 2 Nexuskristalle und 25 Goldstücke.‡[Rohan the Assassin at Light\'s Hope Chapel in the Eastern Plaguelands will make Bonescythe Sabatons if you bring him the following: 1 Desecrated Sabatons, 12 Wartorn Leather Scraps, 3 Cured Rugged Hides, 2 Nexus Crystals and 25 gold pieces. ]‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos escarpes Segahuesos si le llevas lo siguiente: 1 par de escarpines profanados, 12 restos de cuero, 3 pellejos bastos curtidos, 2 cristales nexo y 25 piezas de oro.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos escarpes Segahuesos si le llevas lo siguiente: 1 par de escarpines profanados, 12 restos de cuero, 3 pellejos bastos curtidos, 2 cristales nexo y 25 piezas de oro.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des solerets de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 paire de Solerets désacralisés, 12 Débris d\'armure en cuir, 3 Peaux robustes traitées, 2 Cristaux de nexus et 25 pièces d\'or.‡如果你将1双被玷污的马靴、12块皮甲碎片、3个熟化毛皮、2块连结水晶和25金币交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一双骨镰马靴。‡',
  }
},
[9082] = {
  {
    '‡Рукавицы костяной косы‡Stulpen der Knochensense‡해골사신의 건틀릿‡Guanteletes Segahuesos‡Guanteletes Segahuesos‡Gantelets de la faucheuse d\'os‡骨镰护手‡骨鐮護手',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать рукавицы костяной косы, если вы принесете ему следующее: 1 испоганенные рукавицы, 8 обрывков кожи, 1 слиток арканита и 5 обработанных грубых шкур.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Stulpen der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Stulpen, 8 kampfzerschlissene Lederstücke, 1 Arkanitbarren und 5 geschmeidige unverwüstliche Bälge.‡[Rohan the Assassin at Light\'s Hope Chapel in the Eastern Plaguelands will make Bonescythe Gauntlets if you bring him the following: 1 Desecrated Gauntlets, 8 Wartorn Leather Scraps, 1 Arcanite Bar and 5 Cured Rugged Hides. ]‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guanteletes Segahuesos si le llevas lo siguiente: 1 par de guanteletes profanados, 8 restos de cuero, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guanteletes Segahuesos si le llevas lo siguiente: 1 par de guanteletes profanados, 8 restos de cuero, 1 barra de arcanita y 5 pellejos bastos curtidos.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des gantelets de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 paire de Gantelets désacralisés, 8 Débris d\'armure en cuir, 1 Barre d\'arcanite et 5 Peaux robustes traitées.‡如果你将1双被玷污的护手、8块皮甲碎片、1块奥金锭和5个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一双骨镰护手。‡',
  }
},
[9083] = {
  {
    '‡Воинский пояс костяной косы‡Taillenschutz der Knochensense‡해골사신의 허리보호대‡Guardarrenes Segahuesos‡Guardarrenes Segahuesos‡Sangle de la faucheuse d\'os‡骨镰护腰‡骨鐮護腰',
    nil,
    '‡Роган Убийца из Часовни Последней Надежды в Восточных Чумных землях готов создать воинский пояс костяной косы, если вы принесете ему следующее: 1 испоганенный воинский пояс, 8 обрывков кожи, 5 обработанных грубых шкур, 1 кристалл-источник и 15 золотых.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Taillenschutz der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Taillenschutz, 8 kampfzerschlissene Lederstücke, 5 geschmeidige unverwüstliche Bälge, 1 Nexuskristall und 15 Goldstücke.‡‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guardarrenes Segahuesos si le llevas lo siguiente: 1 guardarrenes profanado, 8 restos de cuero, 5 pellejos bastos curtidos, 1 cristal nexo y 15 piezas de oro.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guardarrenes Segahuesos si le llevas lo siguiente: 1 guardarrenes profanado, 8 restos de cuero, 5 pellejos bastos curtidos, 1 cristal nexo y 15 piezas de oro.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera une sangle de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 Sangle désacralisée, 8 Débris d\'armure en cuir, 5 Peaux robustes traitées, 1 Cristal de nexus et 15 pièces d\'or.‡如果你将1条被玷污的护腰、8块皮甲碎片、5个熟化毛皮、1块连结水晶和15金币交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一条骨镰护腰。‡',
  }
},
[9084] = {
  {
    'Braçadeiras Ceifa-ossos‡Наручи костяной косы‡Armschienen der Knochensense‡해골사신의 팔보호구‡Los brazales Segahuesos‡Los brazales Segahuesos‡Les brassards de la faucheuse d\'os‡骨镰护腕‡骨鐮護腕',
    nil,
    'Rohan, o Assassino, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Braçadeiras Ceifa-ossos se você levar para ele: 1 par de Braçadeiras Profanadas, 6 Restos de Couro, 1 Barra de Arcanita, 2 Pelegos Rústicos Curados e 10 peças de ouro.‡Роган Убийца из часовни Последней Надежды в Восточных Чумных землях готов создать наручи костяной косы, если вы принесете ему 1 испоганенные наручи, 6 обрывков кожи, 1 слиток арканита, 2 обработанных грубых шкуры и 10 золотых.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Armschienen der Knochensense anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Armschienen, 6 kampfzerschlissene Lederstücke, 1 Arkanitbarren, 2 geschmeidige unverwüstliche Bälge und 10 Goldstücke.‡동부 역병지대의 희망의 빛 예배당에 있는 암살자 로한에게 모독의 팔보호구 1개, 닳아해진 가죽 조각 6개, 아케이나이트 주괴 1개, 거친 경화 가죽 2개, 10골드를 가져가면 해골사신의 팔보호구를 만들어 줄 것입니다.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales Segahuesos si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de cuero, 1 barra de arcanita, 2 pellejos bastos curtidos y 10 piezas de oro.‡Rohan el Asesino de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales Segahuesos si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de cuero, 1 barra de arcanita, 2 pellejos bastos curtidos y 10 piezas de oro.‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des brassards de la faucheuse d\'os si vous lui apportez les éléments suivants : 1 paire de Brassards désacralisés, 6 Débris d\'armure en cuir, 1 Barre d\'arcanite, 2 Peaux robustes traitées et 10 pièces d\'or.‡如果你将1副被玷污的护腕、6块皮甲碎片、1块奥金锭、2个熟化毛皮和10金币交给东瘟疫之地圣光之愿礼拜堂的杀手洛汗，他会为你制作一副骨镰护腕。‡東瘟疫之地聖光之願禮拜堂的『刺客』羅漢將為你製作骨鐮護腕，只要你將下列物品帶給他:1對被褻瀆的護腕，6個受戰爭破壞的皮甲碎塊，1個奧金錠，2塊熟化毛皮和10金。',
  }
},
[9085] = {
  {
    'Sombra da Perdição‡Тени Рока‡Schatten der Verdammnis‡파멸의 망령‡Sombras del Apocalipsis‡Sombras del Apocalipsis‡Les ombres du destin‡末日之影‡死亡暗影',
    nil,
    'Vá para um círculo de evocação e mate uma Sombra da Perdição. Em seguida, fale novamente com o Comandante Tomás Helleran na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Идите к кругу призыва и убейте Тень Рока, затем возвращайтесь к командиру Томасу Элерану в Часовню Последней Надежды в Восточные Чумные земли.‡Geht zu einem Beschwörungskreis und tötet einen Schatten der Verdammnis. Kehrt dann zu Kommandant Thomas Helleran bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern zurück.‡소환 마법진으로 가서 파멸의 망령을 처치한 다음 동부 역병지대의 희망의 빛 예배당에 있는 사령관 토마스 헬러랜에게 가야 합니다.‡Ve a un Círculo de Invocación, mata a una Sombra de fatalidad e informa al comandante Thomas Helleran en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Ve a un Círculo de Invocación, mata a una Sombra de fatalidad e informa al comandante Thomas Helleran en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Rendez-vous sur un cercle d\'invocation et tuez une Ombre funeste, puis retournez auprès du commandant Thomas Helleran, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡前往一处召唤法阵，杀死一名末日之影，然后向东瘟疫之地圣光之愿礼拜堂的指挥官托马斯·海勒拉复命。‡前往召喚法陣殺死一個末日之影，再回到東瘟疫之地的聖光之願禮拜堂找指揮官湯瑪士·海勒瑞。',
  }
},
[9086] = {
  {
    'Túnica Andassonho‡Мундир сновидца‡Tunika des Traumwandlers‡꿈나그네 튜닉‡La guerrera Caminasueños‡La guerrera Caminasueños‡La tunique de marcherêve‡梦游者外套‡夢行者外套',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você uma Túnica Andassonho se você levar para ela: 1 Túnica Profanada, 25 Restos de Couro, 6 Pelegos Rústicos Curados e 2 Cristais do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать мундир сновидца, если вы принесете ей следующее: 1 испоганенный мундир, 25 обрывков кожи, 6 обработанных грубых шкур и 2 кристалла-источника.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Tunika des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Tunika, 25 kampfzerschlissene Lederstücke, 6 geschmeidige unverwüstliche Bälge und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 레인에게 모독의 튜닉 1개, 닳아해진 가죽 조각 25개, 거친 경화 가죽 6개, 마력의 결정체 2개를 가져가면 꿈나그네 튜닉을 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera Caminasueños si le llevas lo siguiente: 1 guerrera profanada, 25 restos de cuero, 6 pellejos bastos curtidos y 2 cristales nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una guerrera Caminasueños si le llevas lo siguiente: 1 guerrera profanada, 25 restos de cuero, 6 pellejos bastos curtidos y 2 cristales nexo.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous confectionnera une tunique de marcherêve si vous lui apportez les choses suivantes : 1 Tunique désacralisée, 25 Débris d\'armure en cuir, 6 Peaux robustes traitées et 2 Cristaux de nexus.‡如果你将1件被玷污的外套、25块皮甲碎片、6个熟化毛皮和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一件梦游者外套。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者外套，只要你將下列物品帶給他:1件被褻瀆的外套，25個受戰爭破壞的皮甲碎塊，6塊熟化毛皮和2個聯結水晶。',
  }
},
[9087] = {
  {
    'Guarda-pernas Andassonho‡Набедренники сновидца‡Beinschützer des Traumwandlers‡꿈나그네 다리보호대‡Musleras Caminasueños‡Musleras Caminasueños‡Garde-jambes de marcherêve‡梦游者腿甲‡夢行者腿甲',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Guarda-pernas Andassonho se você levar para ela: 1 Guarda-pernas Profanados, 20 Restos de Couro, 8 Pelegos Rústicos Curados e 1 Cristal do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать набедренники сновидца, если вы принесете ей следующее: 1 испоганенные набедренники, 20 обрывков кожи, 8 обработанных грубых шкур и 1 кристалл-источник.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinschützer des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinschützer, 20 kampfzerschlissene Lederstücke, 8 geschmeidige unverwüstliche Bälge und 1 Nexuskristall.‡‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras Caminasueños si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de cuero, 8 pellejos bastos curtidos y 1 cristal nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras Caminasueños si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de cuero, 8 pellejos bastos curtidos y 1 cristal nexo.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous confectionnera des garde-jambes de marcherêve si vous lui apportez les choses suivantes : 1 paire de Garde-jambes désacralisés, 20 Débris d\'armure en cuir, 8 Peaux robustes traitées et 1 Cristal de nexus.‡如果你将1件被玷污的腿甲、20块皮甲碎片、8个熟化毛皮和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一件梦游者腿甲。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者腿甲，只要你將下列物品帶給他:1對被褻瀆的腿甲，20個受戰爭破壞的皮甲碎塊，8塊熟化毛皮和1個聯結水晶。',
  }
},
[9088] = {
  {
    'Bacinete Andassonho‡Головной убор сновидца‡Kopfstück des Traumwandlers‡꿈나그네 머리쓰개‡La celada Caminasueños‡La celada Caminasueños‡Le chapel de marcherêve‡梦游者头饰‡夢行者首盔',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Bacinete Andassonho se você levar para ela: 1 Bacinete Profanado, 15 Restos de Couro, 6 Pelegos Rústicos Curados e 2 Cristais do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать головной убор сновидца, если вы принесете ей следующее: 1 испоганенный головной убор, 15 обрывков кожи, 6 обработанных грубых шкур и 2 кристалла-источника.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Kopfstück des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihtes Kopfstück, 15 kampfzerschlissene Lederstücke, 6 geschmeidige unverwüstliche Bälge und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 레인에게 모독의 머리쓰개 1개, 닳아해진 가죽 조각 15개, 거친 경화 가죽 6개, 마력의 결정체 2개를 가져가면 꿈나그네 머리쓰개를 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una celada Caminasueños si le llevas lo siguiente: 1 celada profanada, 15 restos de cuero, 6 pellejos bastos curtidos y 2 cristales nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una celada Caminasueños si le llevas lo siguiente: 1 celada profanada, 15 restos de cuero, 6 pellejos bastos curtidos y 2 cristales nexo.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous confectionnera un couvre-chef de marcherêve si vous lui apportez les choses suivantes : 1 Couvre-chef désacralisé, 15 Débris d\'armure en cuir, 6 Peaux robustes traitées et 2 Cristaux de nexus.‡如果你将1件被玷污的头饰、15块皮甲碎片、6个熟化毛皮和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一件梦游者头饰。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者首盔，只要你將下列物品帶給他:1個被褻瀆的首盔，15個受戰爭破壞的皮甲碎塊，6塊熟化毛皮和2個聯結水晶。',
  }
},
[9089] = {
  {
    'Espaldares Andassonho‡Наплеч сновидца‡Schiftung des Traumwandlers‡꿈나그네 어깨덮개‡Bufas Caminasueños‡Bufas Caminasueños‡Spallières de marcherêve‡梦游者肩饰‡夢行者肩甲',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Espaldares Andassonho se você levar para ela: 1 par de Espaldares Profanados, 12 Restos de Couro, 5 Pelegos Rústicos Curados e 1 Cristal do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать наплеч сновидца, если вы принесете ей следующее: 1 испоганенный наплеч, 12 обрывков кожи, 5 обработанных грубых шкур и 1 кристалл-источник.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Schiftung des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Schiftung, 12 kampfzerschlissene Lederstücke, 5 geschmeidige unverwüstliche Bälge und 1 Nexuskristall.‡‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas Caminasueños si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de cuero, 5 pellejos bastos curtidos y 1 cristal nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas Caminasueños si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de cuero, 5 pellejos bastos curtidos y 1 cristal nexo.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous confectionnera des spallières de marcherêve si vous lui apportez les choses suivantes : 1 paire de Spallières désacralisées, 12 Débris d\'armure en cuir, 5 Peaux robustes traitées et 1 Cristal de nexus.‡如果你将1副被玷污的肩饰、12块皮甲碎片、5个熟化毛皮和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一副梦游者肩饰。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者肩甲，只要你將下列物品帶給他:1對被褻瀆的肩甲，12個受戰爭破壞的皮甲碎塊，5塊熟化毛皮和1個聯結水晶。',
  }
},
[9090] = {
  {
    'Botas Andassonho‡Сапоги сновидца‡Stiefel des Traumwandlers‡꿈나그네 장화‡Las botas Caminasueños‡Las botas Caminasueños‡Les bottes de marcherêve‡梦游者长靴‡夢行者長靴',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um par de Botas Andassonho se você levar para ela: 1 par de Botas Profanadas, 12 Restos de Couro, 3 pedaços de Lunatrama e 2 Pelegos Rústicos Curados.‡Райн из часовни Последней Надежды в Восточных Чумных землях готова создать сапоги сновидца, если вы принесете ей 1 испоганенные сапоги, 12 обрывков кожи, 2 обработанных грубых шкуры и 3 куска луноткани.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Stiefel des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Stiefel, 12 kampfzerschlissene Lederstücke, 3 Einheiten Mondstoff und 2 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 레인에게 모독의 장화 1개, 닳아해진 가죽 조각 12개, 달빛 옷감 3개, 거친 경화 가죽 2개를 가져가면 꿈나그네 장화를 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas Caminasueños si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de cuero, 3 piezas de tela lunar y 2 pellejos bastos curtidos.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas botas Caminasueños si le llevas lo siguiente: 1 par de botas profanadas, 12 restos de cuero, 3 piezas de tela lunar y 2 pellejos bastos curtidos.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous confectionnera des bottes de marcherêve si vous lui apportez les choses suivantes : 1 paire de Bottes désacralisées, 12 Débris d\'armure en cuir, 3 Etoffes lunaires et 2 Peaux robustes traitées.‡如果你将1双被玷污的长靴、12块皮甲碎片、3张月布和2个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一双梦游者长靴。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者長靴，只要你將下列物品帶給他:1雙被褻瀆的長靴，12個受戰爭破壞的皮甲碎塊，3塊月布和2塊熟化毛皮。',
  }
},
[9091] = {
  {
    'Protetores de Mão Andassonho‡Боевые рукавицы сновидца‡Handschützer des Traumwandlers‡꿈나그네 손보호대‡Las manoplas Caminasueños‡Las manoplas Caminasueños‡Les garde-mains de marcherêve‡梦游者护手‡夢行者手甲',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará Protetores de Mão Andassonho se você levar para ela: 1 par de Protetores de Mão Profanados, 8 Restos de Couro, 5 Pelegos Rústicos Curados e 1 Cristal do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать боевые рукавицы сновидца, если вы принесете ей следующее: 1 испоганенные боевые рукавицы, 8 обрывков кожи, 5 обработанных грубых шкур и 1 кристалл-источник.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Handschützer des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Handschützer, 8 kampfzerschlissene Lederstücke, 5 geschmeidige unverwüstliche Bälge und 1 Nexuskristall.‡동부 역병지대의 희망의 빛 예배당에 있는 레인에게 모독의 손보호대 1개, 닳아해진 가죽 조각 8개, 거친 경화 가죽 5개, 마력의 결정체 1개를 가져가면 꿈나그네 손보호대를 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas Caminasueños si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de cuero, 5 pellejos bastos curtidos y 1 cristal nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas manoplas Caminasueños si le llevas lo siguiente: 1 par de manoplas profanadas, 8 restos de cuero, 5 pellejos bastos curtidos y 1 cristal nexo.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous confectionnera des garde-mains de marcherêve si vous lui apportez les choses suivantes : 1 paire de Garde-mains désacralisés, 8 Débris d\'armure en cuir, 5 Peaux robustes traitées et 1 Cristal de nexus.‡如果你将1副被玷污的护手、8块皮甲碎片、5个熟化毛皮和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一副梦游者护手。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者手甲，只要你將下列物品帶給他:1套被褻瀆的手甲，8個受戰爭破壞的皮甲碎塊，5塊熟化毛皮和1個聯結水晶。',
  }
},
[9092] = {
  {
    'Cinturão Andassonho‡Ремень сновидца‡Gurt des Traumwandlers‡꿈나그네 요대‡Faja Caminasueños‡Faja Caminasueños‡Ceinturon de marcherêve‡梦游者束带‡夢行者束腰',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Cinturão Andassonho se você levar para ele: 1 Cinturão Profanado, 8 Restos de Couro, 3 pedaços de Lunatrama e 2 Pelegos Rústicos Curados.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова сделать ремень сновидца, если вы принесете ей следующее: 1 испоганенный ремень, 8 обрывков кожи, 2 обработанных грубых шкуры и 3 куска луноткани.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Gurt des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Gurt, 8 kampfzerschlissene Lederstücke, 3 Einheiten Mondstoff und 2 geschmeidige unverwüstliche Bälge.‡‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja Caminasueños si le llevas lo siguiente: 1 faja profanada, 8 restos de cuero, 3 piezas de tela lunar y 2 pellejos bastos curtidos.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una faja Caminasueños si le llevas lo siguiente: 1 faja profanada, 8 restos de cuero, 3 piezas de tela lunar y 2 pellejos bastos curtidos.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous confectionnera un ceinturon de marcherêve si vous lui apportez les choses suivantes : 1 Ceinturon désacralisé, 8 Débris d\'armure en cuir, 3 Etoffes lunaires et 2 Peaux robustes traitées.‡如果你将1条被玷污的束带、8块皮甲碎片、3张月布和2个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一条梦游者束带。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者束腰，只要你將下列物品帶給他:1個被褻瀆的束腰，8個受戰爭破壞的皮甲碎塊，3塊月布和2塊熟化毛皮。',
  }
},
[9093] = {
  {
    'Munhequeiras Andassonho‡Накулачники сновидца‡Handgelenksschützer des Traumwandlers‡꿈나그네 손목보호대‡Guardamuñecas Caminasueños‡Guardamuñecas Caminasueños‡Garde-poignets de marcherêve‡梦游者腕甲‡夢行者腕甲',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Munhequeiras Andassonho se você levar para ela: 1 par de Munhequeiras Profanadas, 6 Restos de Couro, 1 Cristal Arcano e 2 Pelegos Rústicos Curados.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать накулачники сновидца, если вы принесете ей следующее: 1 испоганенные накулачники, 6 обрывков кожи, 2 обработанных грубых шкуры и 1 чародейский кристалл.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Paar Handgelenksschützer des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Handgelenksschützer, 6 kampfzerschlissene Lederstücke, 1 Arkankristall und 2 geschmeidige unverwüstliche Bälge.‡‡Rayne de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas Caminasueños si le llevas lo siguiente: 1 par de guardamuñecas profanados, 6 restos de cuero, 1 cristal Arcano y 2 pellejos bastos curtidos.‡Rayne de la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este te hará unos guardamuñecas Caminasueños si le llevas lo siguiente: 1 par de guardamuñecas profanados, 6 restos de cuero, 1 cristal Arcano y 2 pellejos bastos curtidos.‡Rayne, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous confectionnera des Garde-poignets de marcherêve si vous lui apportez les choses suivantes : 1 paire de Protège-poignets désacralisés, 6 Débris d\'armure en cuir, 1 Cristal arcanique et 2 Peaux robustes traitées.‡如果你将1副被玷污的腕甲、6块皮甲碎片、1块奥术水晶和2个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一副梦游者腕甲。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者腕甲，只要你將下列物品帶給他:1對被褻瀆的束腕，6個受戰爭破壞的皮甲碎塊，1個秘法水晶和2塊熟化毛皮。',
  }
},
[9094] = {
  {
    '‡Перчатки Серебряного Рассвета‡Handschuhe der Argentumdämmerung‡‡Guantes de El Alba Argenta‡Guantes de El Alba Argenta‡Les gants de l\'Aube d\'argent‡银色黎明手套‡',
    nil,
    nil,
  }
},
[9095] = {
  {
    'Veste de Fogofrio‡Одеяние ледяного огня‡Frostfeuerrobe‡얼음불꽃 로브‡Toga de Fuego de Escarcha‡Toga de Fuego de Escarcha‡La robe de givrefeu‡霜火长袍‡霜火長袍',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você uma Veste de Fogofrio se você levar para ela: 1 Veste Profanada, 25 Restos de Tecido, 4 pedaços de Lunatrama e 2 Cristais do Nexus.‡Верховный маг Анджела Досантос из часовни Последней Надежды в Восточных Чумных землях готова создать одеяние ледяного пламени, если вы принесете ей 1 испоганенное одеяние, 25 обрывков ткани, 4 куска луноткани и 2 кристалла-источника.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Frostfeuerrobe anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 entweihte Robe, 25 kampfzerschlissene Stoffstücke, 4 Einheiten Mondstoff und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스에게 모독의 로브 1개, 닳아해진 천 조각 25개, 달빛 옷감 4개, 마력의 결정체 2개를 가져가면 냉기화염 로브를 만들어 줄 것입니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una túnica de Fuego de Escarcha si le llevas lo siguiente: 1 túnica profanada, 25 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una túnica de Fuego de Escarcha si le llevas lo siguiente: 1 túnica profanada, 25 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une robe de givrefeu si vous lui apportez les ingrédients suivants : 1 Robe désacralisée, 25 Débris d\'armure en tissu, 4 Etoffes lunaires et 2 Cristaux de nexus.‡如果你将1件被玷污的长袍、25块布衣碎片、4张月布和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一件霜火长袍。‡東瘟疫之地聖光之願禮拜堂的大法師安琪拉·多桑杜將為你製作霜火長袍，只要你將下列物品帶給他:1件被褻瀆的長袍 ，25個受戰爭破壞的布甲碎塊，4塊月布和2個聯結水晶。',
  }
},
[9096] = {
  {
    'Perneiras de Fogofrio‡Поножи ледяного огня‡Frostfeuergamaschen‡얼음불꽃 다리보호구‡Los leotardos de Fuego de Escarcha‡Los leotardos de Fuego de Escarcha‡Les jambières de givrefeu‡霜火护腿‡霜火護腿',
    nil,
    'A Arquimaga Ângela Santoro na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um par de Perneiras de Fogofrio se você levar para ela: 1 par de Perneiras Profanadas, 20 Restos de Tecido, 4 pedaços de Lunatrama e 2 Cristais do Nexus.‡Верховный маг Анджела Досантос из часовни Последней Надежды в Восточных Чумных землях готова создать поножи ледяного пламени, если вы принесете ей 1 испоганенные поножи, 20 обрывков ткани, 4 куска луноткани и 2 кристалла-источника.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Frostfeuergamaschen anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 Paar entweihte Gamaschen, 20 kampfzerschlissene Stoffstücke, 4 Einheiten Mondstoff und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스에게 모독의 다리보호구 1개, 닳아해진 천 조각 20개, 달빛 옷감 4개, 마력의 결정체 2개를 가져가면 얼음불꽃 다리보호구를 만들어 줄 것입니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos leotardos de Fuego de Escarcha si le llevas lo siguiente: 1 par de leotardos profanados, 20 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos leotardos de Fuego de Escarcha si le llevas lo siguiente: 1 par de leotardos profanados, 20 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des jambières de givrefeu si vous lui apportez les ingrédients suivants : 1 paire de Jambières désacralisées, 20 Débris d\'armure en tissu, 4 Etoffes lunaires et 2 Cristaux de nexus.‡如果你将1副被玷污的护腿、20块布衣碎片、4张月布和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一副霜火护腿。‡東瘟疫之地聖光之願禮拜堂的大法師安琪拉·多桑杜將為你製作霜火護腿，只要你將下列物品帶給他:1對被褻瀆的護腿 ，20個受戰爭破壞的布甲碎塊，4塊月布和2個聯結水晶。',
  }
},
[9097] = {
  {
    '‡Венец ледяного огня‡Frostfeuerreif‡얼음불꽃 관‡Aro de Fuego de Escarcha‡Aro de Fuego de Escarcha‡Diadème de givrefeu‡霜火头饰‡霜火頭環',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды в Восточных Чумных землях готова создать венец ледяного огня, если вы принесете ей следующее: 1 испоганенный венец, 15 обрывков ткани, 3 куска луноткани и 3 кристалла-источника.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Frostfeuerreif anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 entweihten Reif, 15 kampfzerschlissene Stoffstücke, 3 Einheiten Mondstoff und 3 Nexuskristalle.‡‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un aro de Fuego de Escarcha si le llevas lo siguiente: 1 aro profanado, 15 restos de ropa, 3 piezas de tela lunar y 3 cristales nexo.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un aro de Fuego de Escarcha si le llevas lo siguiente: 1 aro profanado, 15 restos de ropa, 3 piezas de tela lunar y 3 cristales nexo.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera un diadème de givrefeu si vous lui apportez les ingrédients suivants : 1 Diadème désacralisé, 15 Débris d\'armure en tissu, 3 Etoffes lunaires et 3 Cristaux de nexus.‡如果你将1个被玷污的头环、15块布衣碎片、3张月布和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一个霜火头饰。‡',
  }
},
[9098] = {
  {
    '‡Наплечные пластины ледяного огня‡Frostfeuerschulterpolster‡얼음불꽃 어깨덧대‡Hombreras de Fuego de Escarcha‡Hombreras de Fuego de Escarcha‡Protège-épaules de givrefeu‡霜火肩垫‡霜火肩墊',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды в Восточных Чумных землях готова создать наплечные пластины ледяного огня, если вы принесете ей следующее: одни испоганенные наплечные пластины, 12 обрывков ткани, 2 куска луноткани и 3 обработанных грубых шкуры.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Frostfeuerschulterpolster anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 Paar entweihte Schulterpolster, 12 kampfzerschlissene Stoffstücke, 2 Einheiten Mondstoff und 3 geschmeidige unverwüstliche Bälge.‡‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas hombreras de Fuego de Escarcha si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.|n‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas hombreras de Fuego de Escarcha si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.|n‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des protège-épaules de givrefeu si vous lui apportez les ingrédients suivants : 1 paire de Protège-épaules désacralisés, 12 Débris d\'armure en tissu, 2 Etoffes lunaires et 3 Peaux robustes traitées.‡如果你将1副被玷污的肩垫、12块布衣碎片、2张月布和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一副霜火肩垫。‡',
  }
},
[9099] = {
  {
    '‡Сандалии ледяного огня‡Frostfeuersandalen‡얼음불꽃 덧신‡Botines de Fuego de Escarcha‡Botines de Fuego de Escarcha‡Sandales de givrefeu‡霜火便鞋‡霜火便鞋',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды в Восточных Чумных землях готова создать сандалии ледяного огня, если вы принесете ей следующее: 1 испоганенные сандалии, 12 обрывков ткани, 2 куска луноткани и 3 обработанных грубых шкуры.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Frostfeuersandalen anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 Paar entweihte Sandalen, 12 kampfzerschlissene Stoffstücke, 2 Einheiten Mondstoff und 3 geschmeidige unverwüstliche Bälge.‡‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos botines de Fuego de Escarcha si le llevas lo siguiente: 1 par de botines profanados, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos botines de Fuego de Escarcha si le llevas lo siguiente: 1 par de botines profanados, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des sandales de givrefeu si vous lui apportez les ingrédients suivants : 1 paire de Sandales désacralisées, 12 Débris d\'armure en tissu, 2 Etoffes lunaires et 3 Peaux robustes traitées.‡如果你将1双被玷污的便鞋、12块布衣碎片、2张月布和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一双霜火便鞋。‡',
  }
},
[9100] = {
  {
    '‡Перчатки ледяного огня‡Frostfeuerhandschuhe‡얼음불꽃 장갑‡Guantes de Fuego de Escarcha‡Guantes de Fuego de Escarcha‡Gants de givrefeu‡霜火手套‡霜火手套',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды в Восточных Чумных землях готова создать перчатки ледяного огня, если вы принесете ей следующее: 1 испоганенные перчатки, 8 обрывков ткани и 4 куска луноткани.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Frostfeuerhandschuhe anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 Paar entweihte Handschuhe, 8 kampfzerschlissene Stoffstücke und 4 Einheiten Mondstoff.‡‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guantes de Fuego de Escarcha si le llevas lo siguiente: 1 par de guantes profanados, 8 restos de ropa y 4 piezas de tela lunar.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guantes de Fuego de Escarcha si le llevas lo siguiente: 1 par de guantes profanados, 8 restos de ropa y 4 piezas de tela lunar.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des gants de givrefeu si vous lui apportez les ingrédients suivants : 1 paire de Gants désacralisés, 8 Débris d\'armure en tissu et 4 Etoffes lunaires.‡如果你将1双被玷污的手套、8块布衣碎片和4张月布交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一双霜火手套。‡',
  }
},
[9101] = {
  {
    '‡Пояс ледяного огня‡Frostfeuergürtel‡얼음불꽃 벨트‡Cinturón de Fuego de Escarcha‡Cinturón de Fuego de Escarcha‡La ceinture de givrefeu‡霜火腰带‡霜火腰帶',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды в Восточных Чумных землях готова создать пояс ледяного огня, если вы принесете ей следующее: 1 испоганенный пояс, 8 обрывков ткани, 2 куска луноткани и 2 чародейских кристалла.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Frostfeuergürtel anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 entweihten Gürtel, 8 kampfzerschlissene Stoffstücke, 2 Arkankristalle und 2 Einheiten Mondstoff.‡‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un cinturón de Fuego de Escarcha si le llevas lo siguiente: 1 cinturón profanado, 8 restos de ropa, 2 piezas de tela lunar y 2 cristales Arcanos.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un cinturón de Fuego de Escarcha si le llevas lo siguiente: 1 cinturón profanado, 8 restos de ropa, 2 piezas de tela lunar y 2 cristales Arcanos.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une ceinture de givrefeu si vous lui apportez les ingrédients suivants : 1 Ceinture désacralisée, 8 Débris d\'armure en tissu, 2 Cristaux des arcanes et 2 Etoffes lunaires.‡如果你将1条被玷污的腰带、8块布衣碎片、2块奥术水晶和2张月布交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一条霜火腰带。‡',
  }
},
[9102] = {
  {
    '‡Наручники ледяного огня‡Frostfeuerbindungen‡얼음불꽃 손목띠‡Ataduras de Fuego de Escarcha‡Ataduras de Fuego de Escarcha‡Les manchettes de givrefeu‡霜火腕轮‡霜火束腕',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды в Восточных Чумных землях готова создать наплечные пластины ледяного огня, если вы принесете ей следующее: 1 испоганенные наручники, 6 обрывков ткани, 1 чародейский кристалл и 1 кристалл-источник.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Frostfeuerbindungen anfertigen, wenn Ihr ihr folgende Gegenstände bringt: 1 Paar entweihte Bindungen, 6 kampfzerschlissene Stoffstücke, 1 Arkankristall und 1 Nexuskristall.‡‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales de Fuego de Escarcha si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de ropa, 1 cristal nexo y 1 cristal Arcano.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales de Fuego de Escarcha si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de ropa, 1 cristal nexo y 1 cristal Arcano.‡L\'archimage Angela Dosantos, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des manchettes de givrefeu si vous lui apportez les ingrédients suivants : 1 paire de Manchettes désacralisées, 6 Débris d\'armure en tissu, 1 Cristal des arcanes et 1 Cristal de nexus.‡如果你将1副被玷污的腕轮、6块布衣碎片、1块奥术水晶和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯，她会为你制作一副霜火腕轮。‡',
  }
},
[9103] = {
  {
    'Veste do Coração Pestilento‡Одеяние Проклятого Сердца‡Robe des verseuchten Herzens‡역병심장 로브‡Toga corazón de peste‡La toga corazón de la peste‡La robe de pestecœur‡瘟疫之心长袍‡瘟疫之心長袍',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você uma Veste do Coração Pestilento se você levar para ele: 1 Veste Profanada, 25 Restos de Tecido, 4 pedaços de Lunatrama e 2 Cristais do Nexus.‡Матеус Заклинатель Гнева из часовни Последней Надежды готов создать одеяние проклятого сердца, если вы принесете ему 1 испоганенное одеяние, 25 обрывков ткани, 4 куска луноткани и 2 кристалла-источника.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Robe des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Robe, 25 kampfzerschlissene Stoffstücke, 4 Einheiten Mondstoff und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 분노의 마타우스에게 모독의 로브 1개, 닳아해진 천 조각 25개, 달빛 옷감 4개, 마력의 결정체 2개를 가져가면 역병심장 로브를 만들어 줄 것입니다.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una túnica corazón de la peste si le llevas lo siguiente: 1 túnica profanada, 25 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una túnica corazón de la peste si le llevas lo siguiente: 1 túnica profanada, 25 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une Robe de pestecoeur si vous lui ramenez 1 Robe désacralisée, 25 Débris d\'armure en tissu, 4 Etoffes lunaires et 2 Cristaux de nexus.‡如果你将1件被玷污的长袍、25块布衣碎片、4张月布和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一件瘟疫之心长袍。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯將為你製作瘟疫之心長袍，只要你將下列物品帶給他:1件被褻瀆的長袍，25個受戰爭破壞的布甲碎塊，4塊月布和2個聯結水晶。',
  }
},
[9104] = {
  {
    'Perneiras do Coração Pestilento‡Поножи Проклятого Сердца‡Gamaschen des verseuchten Herzens‡역병심장 다리보호구‡Leotardos corazón de peste‡Los leotardos corazón de la peste‡Les jambières de pestecœur‡瘟疫之心护腿‡瘟疫之心護腿',
    nil,
    'Mataus, o Arauto da Ira, que está na Capela Esperança da Luz (nas Terras Pestilentas Orientais), fará Perneiras do Coração Pestilento se você levar para ele: 1 unidade de Perneiras Profanadas, 20 Restos de Tecido, 4 Lunatramas e 2 Cristais do Nexus.‡Матеус Заклинатель Гнева из часовни Последней Надежды готов создать поножи проклятого сердца, если вы принесете ему 1 испоганенные поножи, 20 обрывков ткани, 4 куска луноткани и 2 кристалла-источника.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Gamaschen des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Gamaschen, 20 kampfzerschlissene Stoffstücke, 4 Einheiten Mondstoff und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 분노의 마타우스에게 모독의 다리보호구 1개, 닳아해진 천 조각 20개, 달빛 옷감 4개, 마력의 결정체 2개를 가져가면 역병심장 다리보호구를 만들어 줄 것입니다.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos leotardos corazón de la peste si le llevas lo siguiente: 1 par de leotardos profanados, 20 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos leotardos corazón de la peste si le llevas lo siguiente: 1 par de leotardos profanados, 20 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Jambières de pestecoeur si vous lui ramenez 1 paire de Jambières désacralisées, 20 Débris d\'armure en tissu, 4 Etoffes lunaires et 2 Cristaux de nexus.‡如果你将1副被玷污的护腿、20块布衣碎片、4张月布和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一副瘟疫之心护腿。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯將為你製作瘟疫之心護腿，只要你將下列物品帶給他:1對被褻瀆的護腿，20個受戰爭破壞的布甲碎塊，4塊月布和2個聯結水晶。',
  }
},
[9105] = {
  {
    'Diadema do Coração Pestilento‡Венец Проклятого Сердца‡Reif des verseuchten Herzens‡역병심장 관‡Aro corazón de peste‡El aro corazón de la peste‡Le diadème de pestecœur‡瘟疫之心头饰‡瘟疫之心頭環',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Diadema do Coração Pestilento se você levar para ele: 1 Diadema Profanado, 15 Restos de Tecido, 3 pedaços de Lunatrama e 3 Cristais do Nexus.‡Матеус Заклинатель Гнева из часовни Последней Надежды готов создать венец проклятого сердца, если вы принесете ему 1 испоганенный венец, 15 обрывков ткани, 3 куска луноткани и 3 кристалла-источника.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Reif des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Reif, 15 kampfzerschlissene Stoffstücke, 3 Einheiten Mondstoff und 3 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 분노의 마타우스에게 모독의 모자 1개, 닳아해진 천 조각 15개, 달빛 옷감 3개, 마력의 결정체 3개를 가져가면 역병심장 관을 만들어 줄 것입니다.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un aro corazón de la peste si le llevas lo siguiente: 1 aro profanado, 15 restos de ropa, 3 piezas de tela lunar y 3 cristales nexo.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un aro corazón de la peste si le llevas lo siguiente: 1 aro profanado, 15 restos de ropa, 3 piezas de tela lunar y 3 cristales nexo.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera un Diadème de pestecoeur si vous lui ramenez 1 Diadème désacralisé, 15 Débris d\'armure en tissu, 3 Etoffes lunaires et 3 Cristaux de nexus.‡如果你将1个被玷污的头环、15块布衣碎片、3张月布和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一个瘟疫之心头饰。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯將為你製作瘟疫之心頭環，只要你將下列物品帶給他:1個被褻瀆的頭環，15個受戰爭破壞的布甲碎塊，3塊月布和3個聯結水晶。',
  }
},
[9106] = {
  {
    'Ombreiras do Coração Pestilento‡Наплечные пластины Проклятого Сердца‡Schulterpolster des verseuchten Herzens‡역병심장 어깨덧대‡Hombreras corazón de peste‡Las hombreras corazón de la peste‡Les protège-épaules de pestecœur‡瘟疫之心肩垫‡瘟疫之心肩墊',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Ombreiras do Coração Pestilento se você levar para ele: 1 par de Ombreiras Profanadas, 12 Restos de Tecido, 2 pedaços de Lunatrama e 3 Pelegos Rústicos Curados.‡Матеус Заклинатель Гнева из часовни Последней Надежды готов создать наплечные щитки проклятого сердца, если вы принесете ему 1 испоганенные наплечные щитки, 12 обрывков ткани, 2 куска луноткани и 3 обработанных грубых шкуры.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Schulterpolster des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Schulterpolster, 12 kampfzerschlissene Stoffstücke, 2 Einheiten Mondstoff und 3 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 분노의 마타우스에게 모독의 어깨덧대 1개, 닳아해진 천 조각 12개, 달빛 옷감 2개, 거친 경화 가죽 3개를 가져가면 역병심장 어깨덧대를 만들어 줄 것입니다.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas hombreras corazón de la peste si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas hombreras corazón de la peste si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Protège-épaules de pestecoeur si vous lui ramenez 1 paire de Protège-épaules désacralisés, 12 Débris d\'armure en tissu, 2 Etoffes lunaires et 3 Peaux robustes traitées.‡如果你将1副被玷污的肩垫、12块布衣碎片、2张月布和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一副瘟疫之心肩垫。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯將為你製作瘟疫之心肩墊，只要你將下列物品帶給他:1副被褻瀆的肩墊，12個受戰爭破壞的布甲碎塊，2塊月布和3塊熟化毛皮。',
  }
},
[9107] = {
  {
    '‡Сандалии Проклятого Сердца‡Sandalen des verseuchten Herzens‡역병심장 덧신‡Botines corazón de peste‡Botines corazón de peste‡Sandales de pestecœur‡天灾之心便鞋‡瘟疫之心便鞋',
    nil,
    '‡Матеус Обрушивающий Гнев из Часовни Последней Надежды готов создать сандалии Проклятого Сердца, если вы принесете ему следующее: 1 испоганенные сандалии, 12 обрывков ткани, 2 куска луноткани и 3 обработанных грубых шкуры.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Sandalen des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Sandalen, 12 kampfzerschlissene Stoffstücke, 2 Einheiten Mondstoff und 3 geschmeidige unverwüstliche Bälge.‡‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos botines corazón de peste si le llevas lo siguiente: 1 par de botines profanados, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos botines corazón de peste si le llevas lo siguiente: 1 par de botines profanados, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est, vous fabriquera des Sandales de pestecœur si vous lui ramenez 1 paire de Sandales désacralisées, 12 Débris d\'armure en tissu, 2 Etoffes lunaires et 3 Peaux robustes traitées.‡东瘟疫之地圣光之愿礼拜堂的施怒者麦特斯将为你制作瘟疫之心便鞋，只要你将下列物品带给他：1双被亵渎的便鞋，12个受战争破坏的布甲碎片，2块月布和3块熟化毛皮。‡',
  }
},
[9108] = {
  {
    'Luvas do Coração Pestilento‡Перчатки Проклятого Сердца‡Handschuhe des verseuchten Herzens‡역병심장 장갑‡Los guantes corazón de la peste‡Los guantes corazón de la peste‡Les gants de pestecœur‡瘟疫之心手套‡瘟疫之心手套',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Luvas do Coração Pestilento se você levar para ele: 1 par de Luvas Profanadas, 8 Restos de Tecido e 4 pedaços de Lunatrama.‡Матеус Заклинатель Гнева из часовни Последней Надежды готов создать перчатки проклятого сердца, если вы принесете ему 1 испоганенные перчатки, 8 обрывков ткани и 4 куска луноткани.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Handschuhe des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Handschuhe, 8 kampfzerschlissene Stoffstücke und 4 Einheiten Mondstoff.‡동부 역병지대의 희망의 빛 예배당에 있는 분노의 마타우스에게 모독의 장갑 1개, 닳아해진 천 조각 8개, 달빛 옷감 4개를 가져가면 역병심장 장갑을 만들어 줄 것입니다.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guantes corazón de la peste si le llevas lo siguiente: 1 par de guantes profanados, 8 restos de ropa y 4 piezas de tela lunar.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guantes corazón de la peste si le llevas lo siguiente: 1 par de guantes profanados, 8 restos de ropa y 4 piezas de tela lunar.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Gants de pestecoeur si vous lui ramenez 1 paire de Gants désacralisés, 8 Débris d\'armure en tissu et 4 Etoffes lunaires.‡如果你将1双被玷污的手套、8块布衣碎片和4张月布交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一双瘟疫之心手套。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯將為你製作瘟疫之心手套，只要你將下列物品帶給他:1副被褻瀆的手套，8個受戰爭破壞的布甲碎塊和4塊月布。',
  }
},
[9109] = {
  {
    'Cinto do Coração Pestilento‡Пояс Проклятого Сердца‡Gürtel des verseuchten Herzens‡역병심장 허리띠‡El cinturón corazón de la peste‡El cinturón corazón de la peste‡La ceinture de pestecœur‡瘟疫之心腰带‡瘟疫之心腰帶',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Cinto do Coração Pestilento se você levar para ele: 1 Cinto Profanado, 8 Restos de Tecido, 2 Cristais Arcanos e 2 pedaços de Lunatrama.‡Матеус Заклинатель Гнева из часовни Последней Надежды готов создать пояс проклятого мердца, если вы принесете ему 1 испоганенный пояс, 8 обрывков ткани, 2 куска луноткани и 2 чародейских кристалла.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Gürtel des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Gürtel, 8 kampfzerschlissene Stoffstücke, 2 Arkankristalle und 2 Einheiten Mondstoff.‡동부 역병지대의 희망의 빛 예배당에 있는 분노의 마타우스에게 모독의 허리띠 1개, 닳아해진 천 조각 8개, 신비한 수정 2개, 달빛 옷감 2개를 가져가면 역병심장 허리띠를 만들어 줄 것입니다.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un cinturón corazón de la peste si le llevas lo siguiente: 1 cinturón profanado, 8 restos de ropa, 2 piezas de tela lunar y 2 cristales Arcanos.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un cinturón corazón de la peste si le llevas lo siguiente: 1 cinturón profanado, 8 restos de ropa, 2 piezas de tela lunar y 2 cristales Arcanos.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une Ceinture de pestecoeur si vous lui ramenez 1 Ceinture désacralisée, 8 Débris d\'armure en tissu, 2 Cristaux des arcanes et 2 Etoffes lunaires.‡如果你将1条被玷污的腰带、8块布衣碎片、2块奥术水晶和2张月布交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一条瘟疫之心腰带。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯將為你製作瘟疫之心腰帶，只要你將下列物品帶給他:1條被褻瀆的腰帶，8個受戰爭破壞的布甲碎塊，2個秘法水晶和2塊月布。',
  }
},
[9110] = {
  {
    '‡Наручники Проклятого Сердца‡Bindungen des verseuchten Herzens‡역병심장 손목띠‡Ataduras corazón de peste‡Ataduras corazón de peste‡Les manchettes de pestecœur‡天灾之心腕轮‡瘟疫之心束腕',
    nil,
    '‡Матеус Обрушивающий Гнев из Часовни Последней Надежды готов создать наручники Проклятого Сердца, если вы принесете ему следующее: 1 испоганенные наручники, 6 обрывков ткани, 1 кристалл-источник и 1 чародейский кристалл.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Bindungen des verseuchten Herzens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Bindungen, 6 kampfzerschlissene Stoffstücke, 1 Arkankristall und 1 Nexuskristall.‡‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales corazón de la peste si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de ropa, 1 cristal nexo y 1 cristal Arcano.‡Mataus el Colérico de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales corazón de la peste si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de ropa, 1 cristal nexo y 1 cristal Arcano.‡Mataus la Voix du courroux, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Manchettes de pestecoeur si vous lui ramenez 1 paire de Manchettes désacralisées, 6 Débris d\'armure en tissu, 1 Cristal des arcanes et 1 Cristal de nexus.‡如果你将1副被玷污的腕轮、6块布衣碎片、1块奥术水晶和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯，他会为你制作一副瘟疫之心腕轮。‡',
  }
},
[9111] = {
  {
    '‡Одеяние веры‡Robe des Glaubens‡신념의 로브‡La toga de fe‡Toga de fe‡La robe de foi‡信仰长袍‡信仰長袍',
    nil,
    '‡Отец Иниго Монтой из Часовни Последней Надежды готов создать одеяние Веры, если вы принесете ему следующее: 1 испоганенное одеяние, 25 обрывков ткани, поврежденных в бою, 4 куска луноткани и 2 кристалла-источника.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Robe des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Robe, 25 kampfzerschlissene Stoffstücke, 4 Einheiten Mondstoff und 2 Nexuskristalle.‡‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una túnica de fe si le llevas lo siguiente: 1 túnica profanada, 25 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una túnica de fe si le llevas lo siguiente: 1 túnica profanada, 25 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une Robe de foi si vous lui ramenez 1 Robe désacralisée, 25 Débris d\'armure en tissu, 4 Etoffes lunaires et 2 Cristaux de nexus.‡如果你将1件被玷污的长袍、25块布衣碎片、4张月布和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一件信仰长袍。‡',
  }
},
[9112] = {
  {
    'Perneiras da Fé‡Поножи веры‡Gamaschen des Glaubens‡신념의 다리보호구‡Los leotardos de fe‡Los leotardos de fe‡Les jambières de foi‡信仰护腿‡信仰護腿',
    nil,
    'O Padre Inigo Montoy, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Perneiras da Fé se você levar para ele: 1 par de Perneiras Profanadas, 20 Restos de Tecido, 4 pedaços de Lunatrama e 2 Cristais do Nexus.‡Отец Иниго Монтой из часовни Последней Надежды готов создать поножи веры, если вы принесете ему 1 испоганенные поножи, 20 обрывков ткани, 4 куска луноткани и 2 кристалла-источника.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Gamaschen des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Gamaschen, 20 kampfzerschlissene Stoffstücke, 4 Einheiten Mondstoff und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 신부 이니고 몬토이에게 모독의 다리보호구 1개, 닳아해진 천 조각 20개, 달빛 옷감 4개, 마력의 결정체 2개를 가져가면 신념의 다리보호구를 만들어 줄 것입니다.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos leotardos de fe si le llevas lo siguiente: 1 par de leotardos profanados, 20 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos leotardos de fe si le llevas lo siguiente: 1 par de leotardos profanados, 20 restos de ropa, 4 piezas de tela lunar y 2 cristales nexo.‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Jambières de foi si vous lui ramenez 1 paire de Jambières désacralisées, 20 Débris d\'armure en tissu, 4 Etoffes lunaires et 2 Cristaux de nexus.‡如果你将1件被玷污的护腿、20块布衣碎片、4张月布和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一件信仰护腿。‡東瘟疫之地聖光之願禮拜堂的神父伊尼哥·蒙托將為你製作信仰護腿，只要你幫他把下列的東西帶去:1對被褻瀆的護腿，20個受戰爭破壞的布甲碎塊，4塊月布和2個聯結水晶。',
  }
},
[9113] = {
  {
    '‡Венец веры‡Reif des Glaubens‡신념의 관‡El aro de fe‡Aro de fe‡Le diadème de foi‡信仰头环‡信仰頭環',
    nil,
    '‡Отец Иниго Монтой из Часовни Последней Надежды готов создать венец Веры, если вы принесете ему следующее: 1 испоганенный венец, 15 обрывков ткани, поврежденных в бою, 3 куска луноткани и 3 кристалла-источника.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Reif des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Reif, 15 kampfzerschlissene Stoffstücke, 3 Einheiten Mondstoff und 3 Nexuskristalle.‡‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un aro de fe si le llevas lo siguiente: 1 aro profanado, 15 restos de ropa, 3 piezas de tela lunar y 3 cristales nexo.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un aro de fe si le llevas lo siguiente: 1 aro profanado, 15 restos de ropa, 3 piezas de tela lunar y 3 cristales nexo.‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera un Diadème de foi si vous lui ramenez 1 Diadème désacralisé, 15 Débris d\'armure en tissu, 3 Etoffes lunaires et 3 Cristaux de nexus.‡如果你将1件被玷污的头环、15块布衣碎片、3张月布和3块连结水晶交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一件信仰头环。‡',
  }
},
[9114] = {
  {
    '‡Наплечные пластины веры‡Schulterpolster des Glaubens‡신념의 어깨덧대‡Las hombreras de fe‡Hombreras de fe‡Le protège-épaules de foi‡信仰肩垫‡信仰肩墊',
    nil,
    '‡Отец Иниго Монтой из Часовни Последней Надежды готов создать наплечные пластины Веры, если вы принесете ему следующее: 1 испоганенные наплечные пластины, 12 обрывков ткани, поврежденных в бою, 2 куска луноткани и 3 обработанных грубых шкуры.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Schulterpolster des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Schulterpolster, 12 kampfzerschlissene Stoffstücke, 2 Einheiten Mondstoff und 3 geschmeidige unverwüstliche Bälge.‡‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas hombreras de fe si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas hombreras de fe si le llevas lo siguiente: 1 par de hombreras profanadas, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Protège-épaules de foi si vous lui ramenez 1 paire de Protège-épaules désacralisés, 12 Débris d\'armure en tissu, 2 Etoffes lunaires et 3 Peaux robustes traitées.‡如果你将1副被玷污的肩垫、12块布衣碎片、2张月布和3块熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一对信仰肩垫。‡',
  }
},
[9115] = {
  {
    'Sandálias da Fé‡Сандалии веры‡Sandalen des Glaubens‡신념의 덧신‡Los botines de fe‡Los botines de fe‡Les sandales de foi‡信仰便鞋‡信仰便鞋',
    nil,
    'O Padre Inigo Montoy, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará Sandálias da Fé se você levar para ele: 1 par de Sandálias Profanadas, 12 Restos de Tecido, 2 Lunatramas e 3 Pelegos Rústicos Curados.|n‡Отец Иниго Монтой из часовни Последней Надежды готов создать сандалии веры, если вы принесете ему 1 испоганенные сандалии, 12 обрывков ткани, 2 куска луноткани и 3 обработанных грубых шкуры.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Sandalen des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Sandalen, 12 kampfzerschlissene Stoffstücke, 2 Einheiten Mondstoff und 3 geschmeidige unverwüstliche Bälge.‡동부 역병지대의 희망의 빛 예배당에 있는 신부 이니고 몬토이에게 모독의 덧신 1개, 닳아해진 천 조각 12개, 달빛 옷감 2개, 거친 경화 가죽 3개를 가져가면 신념의 덧신을 만들어 줄 것입니다.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos botines de fe si le llevas lo siguiente: 1 par de botines profanados, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.|n‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos botines de fe si le llevas lo siguiente: 1 par de botines profanados, 12 restos de ropa, 2 piezas de tela lunar y 3 pellejos bastos curtidos.|n‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Sandales de foi si vous lui ramenez 1 paire de Sandales désacralisées, 12 Débris d\'armure en étoffe, 2 Etoffes lunaires et 3 Peaux robustes traitées.‡如果你将1双被玷污的便鞋、12块布衣碎片、2张月布和3个熟化毛皮交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一双信仰便鞋。‡東瘟疫之地聖光之願禮拜堂的神父伊尼哥·蒙托將為你製作信仰便鞋，只要你幫他把下列的東西帶去:1雙被褻瀆的便鞋，12個受戰爭破壞的布甲碎塊，2塊月布和3塊熟化毛皮。',
  }
},
[9116] = {
  {
    '‡Перчатки веры‡Handschuhe des Glaubens‡신념의 장갑‡Los guantes de fe‡Guantes de fe‡Les gants de foi‡信仰手套‡信仰手套',
    nil,
    '‡Отец Иниго Монтой из Часовни Последней Надежды готов создать перчатки Веры, если вы принесете ему следующее: 1 испоганенные перчатки, 8 обрывков ткани, поврежденных в бою и 4 куска луноткани.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Handschuhe des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Handschuhe, 8 kampfzerschlissene Stoffstücke und 4 Einheiten Mondstoff.‡‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guantes de fe si le llevas lo siguiente: 1 par de guantes profanados, 8 restos de ropa y 4 piezas de tela lunar.|n‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos guantes de fe si le llevas lo siguiente: 1 par de guantes profanados, 8 restos de ropa y 4 piezas de tela lunar.|n‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Gants de foi si vous lui ramenez 1 paire de Gants désacralisés, 8 Débris d\'armure en tissu et 4 Etoffes lunaires.‡如果你将1双被玷污的手套、8块布衣碎片和4张月布交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一双信仰手套。‡',
  }
},
[9117] = {
  {
    '‡Пояс веры‡Gürtel des Glaubens‡신념의 허리띠‡El cinturón de fe‡Cinturón de fe‡La ceinture de foi‡信仰腰带‡信仰腰帶',
    nil,
    '‡Отец Иниго Монтой из Часовни Последней Надежды готов создать пояс Веры, если вы принесете ему следующее: 1 испоганенный пояс, 8 обрывков ткани, поврежденных в бою, 2 куска луноткани и 2 чародейских кристалла.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch einen Gürtel des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihten Gürtel, 8 kampfzerschlissene Stoffstücke, 2 Arkankristalle und 2 Einheiten Mondstoff.‡‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un cinturón de fe si le llevas lo siguiente: 1 cinturón profanado, 8 restos de ropa, 2 piezas de tela lunar y 2 cristales Arcanos.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará un cinturón de fe si le llevas lo siguiente: 1 cinturón profanado, 8 restos de ropa, 2 piezas de tela lunar y 2 cristales Arcanos.‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera une Ceinture de foi si vous lui ramenez 1 Ceinture désacralisée, 8 Débris d\'armure en tissu, 2 Cristaux des arcanes et 2 Etoffes lunaires.‡如果你将1条被玷污的腰带、8块布衣碎片、2块奥术水晶和2张月布交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一条信仰腰带。‡',
  }
},
[9118] = {
  {
    'Braceletes da fé‡Наручники веры‡Bindungen des Glaubens‡신념의 팔보호구‡Las ataduras de fe‡Las ataduras de fe‡Les manchettes de foi‡信仰腕轮‡信仰束腕',
    nil,
    'Padre Inigo Montoy, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Braceletes da Fé se você levar para ele: 1 par de Braceletes Profanados, 6 Restos de Tecido, 1 Cristal Arcano e 1 Cristal do Nexus.‡Отец Иниго Монтой из Часовни Последней Надежды готов создать наручники Веры, если вы принесете ему следующее: 1 испоганенные наручники, 6 обрывков ткани, поврежденных в бою, 1 кристалл-источник и 1 чародейский кристалл.‡Vater Inigo Montoy bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Bindungen des Glaubens anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Bindungen, 6 kampfzerschlissene Stoffstücke, 1 Arkankristall und 1 Nexuskristall.‡동부 역병지대의 희망의 빛 예배당에 있는 신부 이니고 몬토이에게 모독의 손목보호구 1개, 닳아해진 천 조각 6개, 신비한 수정 1개, 마력의 결정체 1개를 가져가면 신념의 팔보호구를 만들어 줄 것입니다.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales de fe si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de ropa, 1 cristal nexo y 1 cristal Arcano.‡El padre Íñigo Montoya de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unos brazales de fe si le llevas lo siguiente: 1 par de brazales profanados, 6 restos de ropa, 1 cristal nexo y 1 cristal Arcano.‡Le père Inigo Montoy, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, vous fabriquera des Manchettes de foi si vous lui ramenez 1 paire de Manchettes désacralisées, 6 Débris d\'armure en tissu, 1 Cristal des arcanes et 1 Cristal de nexus.‡如果你将1副被玷污的腕轮、6块布衣碎片、1块奥术水晶和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的英尼戈·蒙托尔神父，他会为你制作一副信仰腕轮。‡東瘟疫之地聖光之願禮拜堂的神父伊尼哥·蒙托將為你製作信仰束腕，只要你幫他把下列的東西帶去:1副被褻瀆的束腕，6個受戰爭破壞的布甲碎塊，1個秘法水晶和1個聯結水晶。',
  }
},
[9119] = {
  {
    'Defeito no Sacrário do Oeste‡Авария в Западном святилище‡Zwischenfall beim Sanktum des Westens‡고장난 서부 성소‡Disfunción en el Sagrario del Oeste‡Disfunción en el Sagrario del Oeste‡Panne au sanctum occidental‡西部圣殿的麻烦‡西部聖所的故障',
    nil,
    'Fale com a Protetora de Meridianos Velania no Sacrário do Oeste, que fica na Floresta do Canto Eterno.‡Поговорите с хранительницей энергии Веланией в Западном святилище в лесах Вечной Песни.‡Sprecht mit Leybewahrerin Velania beim Sanktum des Westens im Immersangwald.‡영원노래 숲의 서부 성소에 있는 맥지기 벨라니아와 대화해야 합니다.‡Habla con la vigilante-Ley Velania en el Sagrario del Oeste, en el Bosque Canción Eterna.‡Habla con la vigilante-Ley Velania en el Sagrario del Oeste, en el Bosque Canción Eterna.‡Parler à la telluriste Velania, au Sanctum occidental du bois des Chants éternels.‡与永歌森林的魔网监护者薇兰妮亚谈一谈。‡到永歌森林和西部聖所的地脈看守者維蘭妮雅談談。',
  }
},
[9120] = {
  {
    '‡Падение Кел\'Тузада‡Der Niedergang Kel\'Thuzads‡켈투자드의 죽음‡La caída de Kel\'Thuzad‡La caída de Kel\'Thuzad‡La chute de Kel\'Thuzad‡克尔苏加德的末日‡',
    nil,
    '‡Отнесите талисман Кел\'Тузада в Часовню Последней Надежды в Восточных Чумных землях.‡Bringt Kel\'Thuzads Phylakterium zu der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대에 있는 희망의 빛 예배당에 켈투자드의 성물함을 가져가야 합니다.‡Lleva la filacteria de Kel\'Thuzad a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la filacteria de Kel\'Thuzad a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le Phylactère de Kel\'Thuzad à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将克尔苏加德的护符匣带往东瘟疫之地圣光之愿礼拜堂。‡',
  }
},
[9121] = {
  {
    'A cidadela medonha: Naxxramas‡Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡La ciudadela del terror: Naxxramas‡La ciudadela del terror: Naxxramas‡Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡驚懼城塞 - 納克薩瑪斯',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 5 Cristais Arcanos, 2 Cristais do Nexus, 1 Orbe da Retidão e 60 peças de ouro. Você tem que ser Honrado pela Aurora Argêntea.|n‡Верховный маг Анжела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова наложить на вас заклинание чародейского покрова за 5 чародейских кристаллов, 2 кристалла-источника, 1 сферу Праведности и 60 золотых. Вы должны заслужить уважительное отношение Серебряного Рассвета.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 5 Arkankristalle, 2 Nexuskristalle, 1 rechtschaffene Kugel und 60 Goldstücke. Euer Ruf bei der Argentumdämmerung muss außerdem wohlwollend sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 신비한 수정 5개, 마력의 결정체 2개, 정의의 보주 1개, 60골드를 가져다 달라고 했습니다. 또한 은빛 여명회의 평판이 우호적이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 cristales Arcanos, 2 cristales nexo, 1 orbe recto y 60 piezas de oro. También tienes que ser Honorable con El Alba Argenta.|n‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 cristales Arcanos, 2 cristales nexo, 1 orbe recto y 60 piezas de oro. También tienes que ser Honorable con El Alba Argenta.|n‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est veut 5 Cristaux des arcanes, 2 Cristaux de nexus, 1 Orbe de piété et 60 pièces d\'or. Vous devez aussi être Honoré auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯需要5块奥术水晶、2块连结水晶、1个正义宝珠和60金币。你在银色黎明中的声望必须达到尊敬。‡東瘟疫之地聖光之願禮拜堂的大法師安琪拉·多桑杜需要5個秘法水晶，2個聯結水晶，1個正義寶珠和60金。你一定要在銀色黎明達到尊敬聲望。',
  }
},
[9122] = {
  {
    'A cidadela medonha: Naxxramas‡Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡La ciudadela del terror: Naxxramas‡La ciudadela del terror: Naxxramas‡Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡驚懼城塞 - 納克薩瑪斯',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 2 Cristais Arcanos, 1 Cristal do Nexus e 30 peças de ouro. Você tem que ser Reverenciado pela Aurora Argêntea.‡Верховный маг Анжела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова наложить на вас заклинание чародейского покрова за 2 чародейских кристалла, 1 кристалл-источник и 30 золотых. Вы должны заслужить почтительное отношение Серебряного Рассвета.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 2 Arkankristalle, 1 Nexuskristall und 30 Goldstücke. Euer Ruf bei der Argentumdämmerung muss außerdem respektvoll sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 신비한 수정 2개, 마력의 결정체 1개, 30골드를 가져다 달라고 했습니다. 또한 은빛 여명회의 평판이 매우 우호적이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 2 cristales Arcanos, 1 cristal nexo y 30 piezas de oro. También tienes que ser Venerado con El Alba Argenta.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 2 cristales Arcanos, 1 cristal nexo y 30 piezas de oro. También tienes que ser Venerado con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est veut 2 Cristaux des arcanes, 1 Cristal de nexus et 30 pièces d\'or. Vous devez aussi être Révéré auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯需要2块奥术水晶、1块连结水晶和30金币。你在银色黎明中的声望必须达到崇敬。‡東瘟疫之地聖光之願禮拜堂的大法師安琪拉·多桑杜需要2個秘法水晶，1個聯結水晶和30金。你一定要在銀色黎明達到崇敬聲望。',
  }
},
[9123] = {
  {
    '‡Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡La ciudadela del terror: Naxxramas‡La ciudadela del terror: Naxxramas‡Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова бесплатно наложить на вас заклинание чародейского покрова. Сначала добейтесь того, чтобы вас превозносили в Серебряном Рассвете.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird Euch die arkane Tarnung kostenfrei gewähren. Euer Ruf bei der Argentumdämmerung muss ehrfürchtig sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 비전 은신 마법으로 낙스라마스로 들어갈 수 있도록 해 줄 것입니다. 은빛 여명회의 평판이 확고한 동맹이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous accordera gratuitement l\'Occultation arcanique. Vous devez être Exaltée auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯会免费为你施放奥术遮罩的咒语。你在银色黎明中的声望必须达到崇拜。‡',
  }
},
[9124] = {
  {
    'A armadura do criptalante não se faz sozinha...‡Доспехи расхитителя гробниц на дороге не валяются...‡Was man für Gruftpirscherrüstung braucht...‡지하추적자 갑옷‡La armadura de acechacriptas no se hace sola...‡La armadura de acechacriptas no se hace sola...‡L\'armure de traqueur des cryptes ne se fabrique pas toute seule‡地穴追猎者护甲的材料......‡地穴巡者護甲的零件……',
    nil,
    'O Guarda-caça Leopold, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 30 Pedaços de Carnífice da Cripta.‡Принесите 30 конечностей и панцирей некрорахнидов Охотнику Леопольду в Часовню Последней Надежды в Восточные Чумные земли.‡Jäger Leopold bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 30 Teile einer Gruftbestie.‡동부 역병지대, 희망의 빛 예배당에 있는 사냥꾼 레오폴드가 지하마귀 발톱 30개를 가져다 달라고 했습니다.‡El montero Leopold, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de maligno de cripta.‡El montero Leopold, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de maligno de cripta.‡Le veneur Leopold, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut que vous lui apportiez 30 Morceaux de démon des cryptes.‡东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德要30份地穴魔的碎块。‡東瘟疫之地聖光之願禮拜堂的獵人里歐波要30個地穴惡魔部位。',
  }
},
[9125] = {
  {
    '‡Конечности и панцири некрорахнидов‡Teile einer Gruftbestie‡지하마귀 발톱‡Trozos de maligno de cripta‡Trozos de maligno de cripta‡Morceaux de démon des cryptes‡地穴魔的碎片‡地穴惡魔部位',
