[1284] = {
  {
    '‡‡Verdächtige Hufabdrücke‡‡[DEPRECATED]Huellas de pezuñas sospechosas‡‡[PÉRIMÉ]Des empreintes de sabots suspectes‡[DEPRECATED] 可疑的蹄印‡',
    nil,
    '‡Доложите о подозрительных следах возле таверны "Последний привал" капитану Гаррану Ваймсу из Терамора.‡Berichtet Hauptmann Garran Mumm in Theramore von den verdächtigen Abdrücken beim Gasthaus "Zur Süßen Ruh".‡테라모어에 있는 사령관 개런 바임스에게 그늘 쉼터 여관의 수상한 흔적에 대해 보고해야 합니다.‡Informa al capitán Garran Vimes, en Theramore, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informa al capitán Garran Vimes, en Theramore, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Rapporter la présence des empreintes suspectes à l\'auberge du Repos ombragé au capitaine Vimaire à Theramore.‡把树荫旅店的可疑蹄印报告给塞拉摩的盖兰·维米斯队长。‡',
  }
},
[1286] = {
  {
    '[DEPRECATED]The Deserters‡‡Die Deserteure‡‡‡‡‡[DEPRECATED] 背叛者‡[DEPRECATED]The Deserters',
    nil,
    'Obtenha informações sobre Reethe de Balos Xavier e dos desertores no Pântano Vadeoso.‡‡Sammelt Informationen über Reethe von Balos Jacken und den Deserteuren in den Düstermarschen.‡‡‡‡‡从巴鲁斯·加科因及尘泥沼泽的背叛者那里打探消息。‡從巴魯斯·加科因及塵泥沼澤的背叛者那裡打探消息。',
  }
},
[1287] = {
  {
    '[DEPRECATED]The Deserters‡[DEPRECATED]The Deserters‡Die Deserteure‡[재사용]탈영병‡[DEPRECATED]Los desertores‡[DEPRECATED]Los desertores‡[PÉRIMÉ]Les déserteurs‡[DEPRECATED] 背叛者‡[DEPRECATED]The Deserters',
    nil,
    'Fale sobre Reethe com o Capitão Garrido Valente em Theramore.‡Поговорите о Рите с капитаном Гарраном Ваймсом в Тераморе.‡Sprecht mit Hauptmann Garran Mumm in Theramore über Reethe.‡테라모어에 있는 사령관 개런 바임스와 리테에 대해 대화해야 합니다.‡Ve a Theramore y habla con el capitán Garran Vimes sobre Reethe.‡Ve a Theramore y habla con el capitán Garran Vimes sobre Reethe.‡Parler au Capitaine Garran Vimaire à Theramore à propos de Reethe.‡和塞拉摩的盖兰·维米斯队长谈一谈关于雷瑟的事。‡和塞拉摩的蓋蘭·維米斯上尉談談關於雷瑟的事。',
  }
},
[1288] = {
  {
    '‡Доклад Вимеса‡Mumms Bericht‡바임스의 보고서‡Informe de Vimes‡Informe de Vimes‡Rapport de Vimaire‡维米斯的报告‡維米斯的報告',
    nil,
    '‡Отнесите донесение Ваймса леди Джайне Праудмур в Терамор.‡Bringt Mumms Bericht zu Lady Jaina Prachtmeer in Theramore.‡‡Lleva el informe de Vimes a Lady Jaina Valiente a Theramore.‡Lleva el informe de Vimes a Lady Jaina Valiente a Theramore.‡Donnez le Rapport de Vimaire à Dame Jaina Portvaillant à Theramore.‡‡',
  }
},
[1289] = {
  {
    '‡<nyi> Доклад Ваймса‡<nyi> Mumms Bericht‡‡<nyi> El informe de Vimes‡<nyi> El informe de Vimes‡<nyi> Rapport de Vimaire‡‡',
    nil,
    '‡Вернитесь к капитану Ваймсу в Терамор.‡Kehrt zu Hauptmann Garran Mumm in Theramore zurück.‡‡Vuelve junto al capitán Garran Vimes a Theramore.‡Vuelve junto al capitán Garran Vimes a Theramore.‡Retourner voir le capitaine Garran Vimaire à Theramore.‡‡',
