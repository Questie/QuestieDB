[8977] = {
  {
    '‡Возвращение к Делиане‡Rückkehr zu Deliana‡‡Regresa junto a Deliana‡Regresa junto a Deliana‡Retourner voir Deliana‡向德莉亚娜回复‡',
    nil,
    '‡Принесите спектральный сканер иных измерений Делиане в Стальгорн.‡Bringt Deliana in Eisenschmiede den extradimensionalen Geisterdetektor.‡‡Lleva el detector de fantasmas extra dimensional a Deliana a Forjaz.‡Lleva el detector de fantasmas extra dimensional a Deliana a Forjaz.‡Apportez le Révélateur de fantômes extradimensionnel à Deliana à Forgefer.‡将超维度幽灵显形器交给铁炉堡的德莉亚娜。‡',
  }
},
[8978] = {
  {
    'Fale novamente com Mokvar‡Возвращение к Моквару‡Rückkehr zu Mokvar‡모크바르에게 돌아가기‡Regresa junto a Mokvar‡Regresa junto a Mokvar‡Retourner voir Mokvar‡向莫克瓦尔回复‡回到莫克瓦那裡',
    nil,
    'Reporte-se a Mokvar, em Orgrimmar, com o Revelador Extradimensional de Fantasmas.‡Принесите Моквару в Оргриммар спектральный сканер иных измерений.‡Kehrt mit dem extradimensionalen Geisterdetektor zu Mokvar in Orgrimmar zurück.‡4차원 유령 탐색기를 가지고 오그리마에 있는 모크바르에게 가야 합니다.‡Lleva el detector de fantasmas extradimensional a Mokvar a Orgrimmar.‡Lleva el detector de fantasmas extradimensional a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec le Révélateur de fantômes extradimensionnel.‡将超维度幽灵显形器交给奥格瑞玛的莫克瓦尔。‡帶著超空間鬼魂顯像機回到奧格瑪的莫克瓦那裡。',
  }
},
[8979] = {
  {
    '‡Подозрения Фенстада‡Fenstads Visionen‡펜스타드의 육감‡El presentimiento de Fenstad‡El presentimiento de Fenstad‡L\'intuition de Fenstad‡芬斯塔的预感‡',
    nil,
    '‡Отнесите 1 флакон одеколона и 1 флакон духов аптекарю Зинг в Район Фармацевтов в Подгороде.‡Bringt 1 Duftwasserflakon und 1 Parfümflakon zu Apothekerin Zinge im Apothekarium von Unterstadt.‡언더시티 연금술 실험실에 있는 연금술사 진게에게 은은한 향수와 매혹적인 향수를 한 병씩 가져가야 합니다.‡Lleva 1 frasco de colonia y 1 de perfume a la boticaria Zinge, que está en El Apothecarium de Entrañas.‡Lleva 1 frasco de colonia y 1 de perfume a la boticaria Zinge, que está en El Apothecarium de Entrañas.‡Remettez 1 bouteille d\'Eau de Cologne et 1 Flacon de parfum à l\'apothicaire Zinge, dans l\'Apothicarium de Fossoyeuse.‡将1瓶古龙水和1瓶香水交给幽暗城炼金房的药剂师金格。‡',
  }
},
[8980] = {
  {
    '‡Мнение Зинг‡Zinges Einschätzung‡‡La evaluación de Zinge‡La evaluación de Zinge‡L\'évaluation de Zinge‡金格的评估‡',
    nil,
    '‡Вернитесь к Фенстаду Аргайлу, ожидающему около банка в Подгороде.‡Kehrt zu Fenstad Argyle außerhalb der Bank von Unterstadt zurück.‡‡Ve a ver a Fenstad Argyle, que está fuera del banco en Entrañas.‡Ve a ver a Fenstad Argyle, que está fuera del banco en Entrañas.‡Retourner voir Fenstad Argyle, devant la banque de Fossoyeuse.‡回到幽暗城银行附近的芬斯塔·艾吉勒那里。‡',
  }
},
[8981] = {
  {
    'Entrega de presentes‡Подношение даров‡Geschenkübergabe‡선물 증정‡Ofrecer regalos‡Ofrecer regalos‡Faire des cadeaux‡赠送礼品‡送禮物',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[8982] = {
  {
    '‡Поиск источника‡Verfolgung der Spur‡향기의 근원 추적‡Rastrear la fuente‡Rastrear la fuente‡Remonter à la source‡追查货源‡',
    nil,
    '‡Поговорите с хозяином таверны Норманом в Подгороде.‡Sprecht mit Gastwirt Norman in Unterstadt.‡‡Habla con el tabernero Norman en Entrañas.‡Habla con el tabernero Norman en Entrañas.‡Parler à l\'aubergiste Norman de Fossoyeuse.‡与幽暗城中的旅店老板诺曼谈一谈。‡',
  }
},
[8983] = {
  {
    '‡Поиск источника‡Verfolgung der Spur‡향기의 근원 추적‡Rastrear la fuente‡Rastrear la fuente‡Remonter à la source‡追查货源‡',
    nil,
    '‡Поговорите с Марой Ренник в портновской лавке в Квартале Магов Подгорода.‡Sprecht mit Mara Rennick bei der Schneiderei im Magieviertel von Unterstadt.‡‡Habla con Mara Rennick en la sastrería del Barrio de la Magia de Entrañas.‡Habla con Mara Rennick en la sastrería del Barrio de la Magia de Entrañas.‡Parlez à Mara Rennick, à la boutique du tailleur du Quartier de la Magie de Fossoyeuse.‡与幽暗城法师区裁缝店里的玛拉·雷尼克谈一谈。‡',
  }
},
[8984] = {
  {
    '‡Источник обнаружен‡Lüftung des Geheimnisses‡밝혀진 향기의 근원‡El descubrimiento de la fuente‡El descubrimiento de la fuente‡La source est découverte !‡水落石出‡',
    nil,
    '‡Найдите аптекаря Стаффрона Лерента в предгорьях Хилсбрада за поместьем Черный Ворон.‡Findet Apotheker Staffron Lerent hinter dem Rabenholdtanwesen im Vorgebirge des Hügellands.‡라벤홀트 장원을 지나 언덕마루 구릉지에 있는 연금술사 스태프론 리런트를 찾아가야 합니다.‡Encuentra al boticario Staffron Lerent en las Laderas de Trabalomas, pasada la Mansión Ravenholdt.‡Encuentra al boticario Staffron Lerent en las Laderas de Trabalomas, pasada la Mansión Ravenholdt.‡Trouver l\'apothicaire Staffron Lerent dans les contreforts de Hautebrande, au-delà du manoir de Ravenholdt.‡到希尔斯布莱德丘陵去，在拉文霍德庄园后面找到药剂师斯塔弗隆·雷伦特。‡',
  }
},
[8985] = {
  {
    '‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡',
    nil,
    '‡Найдите реликвию Деревни Звездного Ветра и принести ее Бодли в Черную гору.‡Bringt Bodley in der Schwarzfelsspitze ein Relikt von Sternenhauch.‡‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Relique de Brise-Stellaire et rapportez-la à Bodley, à l\'intérieur du Mont Rochenoire.‡取得星风村圣物，再回到黑石山找布德利。‡',
  }
},
[8986] = {
  {
    '‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡',
    nil,
    '‡Найдите останки друидов и принести их Бодли в Черную гору.‡Bringt Bodley im Schwarzfels einige Druidenüberreste.‡‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous des Restes druidiques et rapportez-les à Bodley, à l\'intérieur du mont Rochenoire.‡取得德鲁伊的遗体，再回到黑石山找布德利。‡',
  }
},
[8987] = {
  {
    'Mais componentes importantes‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡또 다른 중요한 요소‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡更多重要的材料',
    nil,
    'Obtenha uma Espada Brilhante do Fanatismo e leve-a para Bodley na Montanha Rocha Negra.‡Добудьте сверкающий меч фанатизма и принесите его Бодли в Черную гору.‡Bringt Bodley im Schwarzfels ein gleißendes Schwert des Zeloten.‡번쩍이는 열광의 검을 구해 검은바위 산에 있는 보들리에게 가져가야 합니다.‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Epée brillante de fanatisme, puis rapportez-la à Bodley, à l\'intérieur du mont Rochenoire.‡找到一把狂热光芒之剑，把它交给黑石山的伯德雷。‡取得光亮的狂熱之劍，再回到黑石山找布德利。',
  }
},
[8988] = {
  {
    '‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡',
    nil,
    '‡Добыть пепел душ Изгнанников и принести его Бодли в Черную гору.‡Bringt Bodley im Schwarzfels etwas Seelenasche der Verbannten.‡‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Prélevez des Cendres d\'âme de banni, puis retournez voir Bodley à l\'intérieur du mont Rochenoire.‡拿到放逐者的灵魂灰烬，把它交给黑石山的伯德雷。‡',
  }
},
[8989] = {
  {
    '‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦萨拉克护符的右半块‡',
    nil,
    '‡Вызвать дух Мора Серого Копыта с помощью жаровни Призыва, прикончить его и забрать недостающую часть амулета Лорда Вальтхалака. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Mor Grauhuf zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Mor Pezuña Gris y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Mor Pezuña Gris y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit de Mor Sabot-gris, puis tuez-le. Ensuite, retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l\'Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤莫尔·灰蹄的灵魂并杀了他。带着重新组合的瓦萨拉克护符和召唤火盆回到黑石山的布德利那里。‡',
  }
},
[8990] = {
  {
    '‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的右瓣‡',
    nil,
    '‡С помощью жаровни Призыва вызвать дух Изалиен и убить ее. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Isalien zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit d\'Isalien, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l\'Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤出伊萨莉恩的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克公爵的饰品还给伯德雷。‡',
  }
},
[8991] = {
  {
    '‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦萨拉克护符的右半块‡',
    nil,
    '‡Вызвать духов Джариен и Сотоса с помощью жаровни Призыва и убить их обоих. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um die Geister von Jarien und Sothos zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer Jarien et Sothos, puis tuez-les. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l\'Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤出亚雷恩和索托斯的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克公爵的饰品还给黑石山的伯德雷。‡',
  }
},
[8992] = {
  {
    '‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦萨拉克护符的右半块‡',
    nil,
    '‡С помощью жаровни Призыва вызвать дух Кормока и убить его. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Kormok zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit de Kormok, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l\'Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤科尔莫克的灵魂并杀了他。带着重新组合的瓦萨拉克护符和召唤火盆回到黑石山的布德利那里。‡',
  }
},
[8993] = {
  {
    'Entrega de presentes‡Подношение даров‡Geschenkübergabe‡선물 증정‡Ofrecer regalos‡Ofrecer regalos‡Faire des cadeaux‡赠送礼品‡送禮物',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[8994] = {
  {
    'Preparativos finais‡Последние приготовления‡Letzte Vorbereitungen‡마지막 준비‡Últimos preparativos‡Últimos preparativos‡Derniers préparatifs‡最后的准备‡最後的準備',
    nil,
    'Colete 40 Braceletes de Rocha Negra e consiga um Frasco de Poder Supremo. Leve tudo para Bodley, dentro da Montanha Rocha Negra.‡Соберите 40 наручей Черной горы и добудьте настой великой силы. Отнесите все это Бодли в Черную гору.‡Bringt Bodley im Schwarzfels 40 Schwarzfelsarmschienen und ein Fläschchen der obersten Macht.‡검은바위 팔보호구 40개와 강력한 마력의 영약을 구한 후, 검은바위 산에 있는 보들리에게 가져가야 합니다.‡Reúne 40 brazales Roca Negra y consigue un frasco de poder supremo. Llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Reúne 40 brazales Roca Negra y consigue un frasco de poder supremo. Llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Collectez 40 Brassards rochenoire et un Flacon de pouvoir suprême. Ensuite, retournez voir Bodley au mont Rochenoire.‡从黑石塔的兽人那儿收集40副黑石护腕，把它们和一瓶超级能量合剂一起交给黑石山的伯德雷。‡收集40個黑石護腕和1份超級能量精鍊藥劑。把它們帶給黑石山上的布德利。',
  }
},
[8995] = {
  {
    'Mea culpa, Lorde Valthalak‡Mea Culpa, Лорд Вальтхалак‡Mea Culpa, Lord Valthalak‡군주 발타라크여, 내 탓이오.‡Mea Culpa, Lord Valthalak‡Mea Culpa, Lord Valthalak‡Mea culpa, seigneur Valthalak‡瓦塔拉克公爵‡認錯，瓦薩拉克領主',
    nil,
    'Use o Braseiro de Sinalização para evocar o Lorde Valthalak. Acabe com ele e use o Amuleto do Lorde Valthalak no cadáver. Em seguida, devolva o Amuleto do Lorde Valthalak ao Espírito de Lorde Valthalak.‡Вызвать Лорда Вальтхалака с помощью жаровни Призыва. Убить его и использовать амулет. Потом вернуть амулет духу Вальтхалака.‡Benutzt das Räuchergefäß der Beschwörung, um Lord Valthalak zu beschwören. Macht ihn unschädlich und benutzt dann Lord Valthalaks Amulett bei seiner Leiche. Danach werdet Ihr dem Geist von Lord Valthalak sein Amulett zurückgeben müssen.‡부름의 화로를 사용하여 군주 발타라크를 소환하십시오. 군주 발타라크를 처치하고 그의 시체에 군주 발타라크의 아뮬렛을 사용한 후, 군주 발타라크의 영혼에게 군주 발타라크의 아뮬렛을 돌려줘야 합니다.‡Usa el Blandón de Invocación para invocar a Lord Valthalak. Despáchalo y usa el amuleto de Lord Valthalak sobre el cadáver. Después devuélvele el amuleto de Lord Valthalak al espíritu de Lord Valthalak.‡Usa el Blandón de Invocación para invocar a Lord Valthalak. Despáchalo y usa el amuleto de Lord Valthalak sobre el cadáver. Después devuélvele el amuleto de Lord Valthalak al espíritu de Lord Valthalak.‡Utilisez le Brasero de signal pour invoquer le seigneur Valthalak. Tuez-le, puis utilisez l\'Amulette du seigneur Valthalak sur le corps. Ensuite, rendez l\'amulette à l\'Esprit du seigneur Valthalak.‡在比斯巨兽的房间里使用召唤火盆，召唤瓦塔拉克公爵。杀死他，对尸体使用瓦塔拉克的饰品。然后将瓦塔拉克的饰品还给瓦塔拉克公爵之魂。‡用召喚火盆召喚出瓦薩拉克領主。殺了他，在他的屍體上使用瓦薩拉克的護符。然後，將瓦薩拉克領主護符還給瓦薩拉克領主之靈。',
  }
},
[8996] = {
  {
    '‡Возвращение к Бодли‡Rückkehr zu Bodley‡‡Regresa junto a Bodley‡Regresa junto a Bodley‡Retourner voir Bodley‡回到布德利那里‡',
    nil,
    '‡Вернитесь к Бодли в Черную гору и отдайте ему жаровню Призыва.‡Bringt das Räuchergefäß der Beschwörung zurück zu Bodley im Schwarzfels.‡‡Vuelve junto a Bodley en el interior de la Montaña Roca Negra y dale el Blandón de Señalización.‡Vuelve junto a Bodley en el interior de la Montaña Roca Negra y dale el Blandón de Señalización.‡Retournez voir Bodley à l\'intérieur du mont Rochenoire et donnez-lui le Brasero de signal.‡回到黑石山的布德利那里并将召唤火盆交给他。‡',
  }
},
[8997] = {
  {
    '‡Круг замкнулся‡Zurück zum Anfang‡‡Regreso al principio‡Regreso al principio‡Retour au commencement‡回到起点‡',
    nil,
    '‡Поговорите с Делианой в Высоком троне в Стальгорне.‡Sprecht mit Deliana am Hohen Sitz von Eisenschmiede.‡‡Habla con Deliana en El Trono en Forjaz.‡Habla con Deliana en El Trono en Forjaz.‡Parlez à Deliana au Haut Siège de Forgefer.‡跟铁炉堡王座大厅内的德莉亚娜谈一谈。‡',
  }
},
[8998] = {
  {
    '‡Круг замкнулся‡Zurück zum Anfang‡‡Regreso al principio‡Regreso al principio‡Retour au commencement‡回到原点‡',
    nil,
    '‡Поговорите с Мокваром в крепости Громмаш в Аллее Мудрости в Оргриммаре.‡Sprecht mit Mokvar in der Feste Grommash im Tal der Weisheit von Orgrimmar.‡‡Habla con Mokvar en el Fuerte Grommash en el Valle de los Espíritus de Orgrimmar.‡Habla con Mokvar en el Fuerte Grommash en el Valle de los Espíritus de Orgrimmar.‡Parlez à Mokvar au Fort Grommash, dans la Vallée de la Sagesse d\'Orgrimmar.‡跟位于奥格瑞玛智慧谷里的莫克瓦尔谈一谈。‡',
  }
},
[8999] = {
  {
    '‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    '‡Отдайте Делиане клобук и жилет Буйного Сердца.‡Gebt Deliana Eure Gugel des Wildherzens und Eure Weste des Wildherzens.‡‡Dale a Deliana tu capucha y tu jubón Corazón Salvaje.‡Dale a Deliana tu capucha y tu jubón Corazón Salvaje.‡Donnez votre Coiffe du Cœur-sauvage et votre Gilet du Cœur-sauvage à Deliana.‡将你的野性之心兜帽与野性之心外衣交给德莉亚娜。‡',
  }
},
[9000] = {
  {
    '‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    '‡Отдайте Делиане шапку и мундир загонщика.‡Gebt Deliana Eure Bestienjägerkappe und Eure Bestienjägertunika.‡‡Dale a Deliana tu almete y tu guerrera de acechabestias.‡Dale a Deliana tu almete y tu guerrera de acechabestias.‡Donnez votre Coiffe de bestiaire et votre Tunique de bestiaire à Deliana.‡将你的驭兽者之帽和驭兽者外套交给德莉娜。‡',
  }
},
[9001] = {
  {
    'Deixando o melhor para o final‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡은혜의 보답‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    'Entregue sua Coroa do Magíster e suas Vestes do Magíster a Deliana.‡Отдайте Делиане корону магистра и одеяния магистра.‡Gebt Deliana Eure Krone des Magisters und Eure Roben des Magisters.‡델리아나에게 원소술사 관과 원소술사 로브를 줘야 합니다.‡Dale a Deliana tus togas y tu corona de magister.‡Dale a Deliana tus togas y tu corona de magister.‡Donnez votre Collerette de magistère et votre Robe de magistère à Deliana.‡将你的博学者头冠与博学者长袍交给德莉亚娜。‡將你的博學者之冠和博學者長袍交給德莉娜。',
  }
},
[9002] = {
  {
    '‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
