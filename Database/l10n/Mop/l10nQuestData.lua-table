[29877] = {
  {
    'Só tem gênio‡Пробелы в образовании‡Grundwissen mangelhaft‡뭘 알아야 농사를 짓지‡No han comprendido lo básico‡‡De graves lacunes‡缺乏常识‡',
    nil,
    'Desenterre 7 utensílios agrícolas. Uma‡Выкопайте 7 сельскохозяйственных инструментов.‡Grabt 7 Landwirtschaftswerkzeuge aus.‡농기구 7개를 파내야 합니다. 레벨 15 네 바람의 계곡‡Desentierra 7 materiales de la granja.‡‡Déterrez 7 Éléments de matériel agricole.‡挖出7件农具。‡',
  }
},
[29878] = {
  {
    'Arapuca de hozen‡Идеальная ловушка для хозенов‡Eine bessere Ho-zen-Falle bauen‡‡Construir una trampa hozen mejor‡‡Confectionner un meilleur piège à hozen‡‡',
    nil,
    'Junte 8 Muçuns e 8 Jarros de Cerâmica Intactos do Lago Kittitata. Uma‡Добудьте 8 грязней и 8 целых кувшинов из озера Киттитата.‡Sammelt 8 Glitschis und 8 heile Tonkrüge aus dem Kittitatasee.‡‡Recoge 8 mandukas y 8 tarros de cerámica intactos del Lago Kittitata.‡‡Allez chercher 8 Poisseux et 8 Pots en céramique intacts au Lac Kittitata.‡‡',
  }
},
[29879] = {
  {
    'Engolidos‡Проглоченные заживо‡Im Ganzen verschlungen‡꿀꺽 삼켰어요‡Tragaldabas‡‡Avalés tout crus !‡整个吞下‡',
    nil,
    'Liberte 5 hozens dos Crocoliscos Empanzinados e pegue 5 Trutas Pintadas do Lago Kittitata. Uma‡Освободите 5 хозенов от разжиревших кроколисков и поймайте в озере Киттитата 5 грязней.‡Befreit 5 Ho-zen aus dem Inneren vollgefressener Krokilisken und sammelt 5 Bachsaiblinge am Kittitatasee.‡키티타타 호수에 있는 게걸스러운 악어에게서 호젠 5마리를 구해주고, 얼룩 송어 5마리를 모아야 합니다.‡Libera a 5 hozen de los crocoliscos atiborrados y reúne 5 truchas moteadas del Lago Kittitata.‡‡Libérez 5 Hozen des entrailles des Crocilisques congestionnés et rassemblez 5 Truites mouchetées du Lac Kittitata.‡从肿胀的鳄鱼体内释放5个猢狲，并从玉盘湖收集5条斑点鳟。‡',
  }
},
[29880] = {
  {
    'Pega e solta!‡Поймал – отпусти!‡Fangen und freilassen!‡‡Atrapar y soltar‡‡Aussitôt attrapé, aussitôt rejeté !‡‡',
    nil,
    'Use as Armadilhas para Hozens na Aldeia Nuka Nuka, depois quebre-as para libertar 5 hozens presos. Uma‡Используйте ловушки для хозенов в лагере Нука-Нука, а затем сломайте их, чтобы освободить 5 хозенов.‡Verwendet Ho-zen-Fallen im Lager Nooka-Nooka und zerbrecht sie, um 5 gefangene Ho-zen zu befreien.‡‡Utiliza trampas hozen en el Campamento Nooka Nooka y después rómpelas para liberar a 5 hozen atrapados.‡‡Utilisez les Pièges à hozen au Camp Nouka Nouka, puis libérez 5 Hozen piégés.‡‡',
  }
},
[29881] = {
  {
    'A cor perfeita‡Идеальный цвет‡Die perfekte Farbe‡완벽한 색‡El color perfecto‡‡La couleur parfaite‡理想的颜色‡',
    nil,
    'Colha 8 Pétalas Recém-caídas. Uma‡Соберите 8 свежеопавших лепестков.‡Sammelt 8 frisch gefallene Blütenblätter.‡갓 떨어진 꽃잎 8개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 8 pétalos recién caídos.‡‡Ramassez 8 Pétales fraîchement tombés.‡收集8片刚凋落的花瓣。‡',
  }
},
[29882] = {
  {
    'Pena de ferrões‡Перья из жал‡Feder aus Stacheln‡독침 붓촉‡Pluma de aguijón‡‡Plumes d’aiguillon‡尾针翎笔‡',
    nil,
    'Consiga 6 Ferrões de Vespa das Vespas do Pomar. Uma‡Соберите 6 осиных жал, убивая садовых ос.‡Sammelt 6 Wespenstachel von Obstgartenwespen.‡도원 말벌에게서 말벌 독침을 6개 모아야 합니다. 레벨 10 비취 숲‡Consigue 6 aguijones de avispa de las avispas del huerto.‡‡Ramassez 6 Dards de guêpe sur des Guêpes du verger.‡从百木园黄蜂身上收集6根黄蜂尾针。‡',
  }
},
[29883] = {
  {
    'Paz aos Barbatana de Pérola‡Доверие Жемчужного Плавника‡Das Perlflossenproblem‡진주지느러미 마을의 상황‡La situación de Aleta de Nácar‡‡Le cas Nageperle‡审时度势‡',
    nil,
    'Fale com o Ancião Lusshan, o Guarda-pérolas Fujin, o Instrutor Pinafiada e Ot-Temmdo na Aldeia Barbatana de Pérola. Uma‡Поговорите со старейшиной Лушанем, хранителем жемчужин Фуцзинем, инструктором Острым Гребнем и От-Теммдо в деревне Жемчужного Плавника.‡Sprecht mit dem Ältesten Lusshan, Perlenhüter Fujin, Ausbilder Scharffinne und Ot-Temmdo im Dorf der Perlflossen.‡진주지느러미 마을에 있는 장로 루샨, 진주지기 푸진, 교관 샤프핀, 오트템도와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el ancestro Lusshan, el síndico de perlas Fujin, el instructor Escama Letal y Ot-Temmdo en el Poblado Aleta de Nácar.‡‡Parlez au Vénérable Lusshan, au Gardien des perles Fujin, à l’Instructeur Aileron de Sabre et à Ot Temmdo à Nageperle.‡和珠鳍村的长老卢山、珍珠守护者福锦、锐鳍教头和吽·提门度谈一谈。‡',
  }
},
[29884] = {
  {
    'Tracking Event: Espião Vai Embora‡Выслеживание: разведчики уходят‡Verfolgungsereignis: Abreise der Spione‡이벤트 추적: 정찰병 출발‡Evento de seguimiento: los espías se marchan‡‡Évènement de suivi : départ des espions‡追踪事件：特工出发‡',
    nil,
    'Acompanhe os batedores até a saída. Depois, fale com o Grande Lu. Floresta de Jade de‡Проводите разведчиков, затем поговорите с Большим Лу.‡Schickt die Späher los und sprecht dann mit dem Ältesten Lusshan.‡정찰병이 떠나는 모습을 지켜보고, 덩치 큰 루와 대화해야 합니다. 비취 숲‡Despídete de los exploradores y después habla con Gran Lu.‡‡Veillez au départ des éclaireurs, puis parlez à Gros Lu.‡目送斥候离开，然后与卢山大哥谈一谈。‡',
  }
},
[29885] = {
  {
    'Rações para viagem‡Провиант в дорогу‡Wegzehrung‡전투 식량 준비‡Raciones para el camino‡‡Les rations de voyage‡行军口粮‡',
    nil,
    'Junte 6 Flancos de Jabuti. Uma‡Достаньте 6 черепашьих боков.‡Besorgt 6 Schildkrötenflanken.‡거북 살코기 6개를 모아야 합니다. 레벨 10 비취 숲‡Reúne 6 costillares de tortuga.‡‡Récoltez 6 Flanchets de tortue.‡收集6块乌龟腰肉。‡',
  }
},
[29886] = {
  {
    'Cura zen‡Лечение по дзену‡Zenheilung‡참선의 치유력‡Sanación zen‡‡Médecine zen‡‡',
    nil,
    'Colha 6 Lótus Zen. Uma‡Соберите 6 дзен-лотосов.‡Sammelt 6 Zenlotus.‡참선의 연꽃 6송이를 모아야 합니다. 레벨 10 비취 숲‡Consigue 6 lotos zen.‡‡Récoltez 6 Lotus zen.‡‡',
  }
},
[29887] = {
  {
    'Os instrumentos do ancião‡Имущество старейшины‡Die Instrumente des Ältesten‡장로의 장비‡Los instrumentos del ancestro‡‡Les instruments de l’ancien‡长老的道具‡',
    nil,
    'Recupere o Cajado do Parlágua, a Veste Cerimonial, a Coroa de Jade e as Contas de Jacarandá dos Patas Grudentas Bodoqueiros. Uma‡Заберите у грабителей из племени Ловкого Хвоста церемониальное облачение, нефритовую корону, четки из розового дерева и посох говорящего с водой.‡Holt den Stab des Wassersprechers, die zeremoniellen Roben, die Jadekrone und die Rosenholzperlen von den Langfingern der Schlingschwänze zurück.‡줄꼬리 끈끈발에게서 물예언자의 지팡이, 의식용 로브, 비취 왕관, 장미목 묵주를 되찾아야 합니다.‡Recoge el bastón del orador del agua, las togas ceremoniales, la corona de jade y las cuentas de rosamadera de los patarroñas Colafusta. Un(a) misión.‡‡Récupérez le Bâton de l’eauracle, la Robe de cérémonie, la Couronne de jade et les Perles en bois de rose sur des Pattacolles queutapultes.‡从吊尾粘爪猴身上收集水语者法杖、典礼长袍、玉冠和檀木念珠。‡',
  }
},
[29888] = {
  {
    'Em busca do Andarilho das Lendas‡В поисках хранителя истории‡Den Lehrensucher aufsuchen‡전승지기를 찾아서‡Buscando al eremita‡‡À la recherche du chroniqueur‡找到游学者‡',
    nil,
    'Procure o Andarilho das Lendas Cho no Pavilhão do Sonhador, que fica na Floresta de Jade. Uma‡Разыщите хранителя истории Чо в Павильоне Мечтателя, что в Нефритовом лесу. задание.‡Findet Lehrensucher Cho im Pavillon des Träumers im Jadewald.‡비취 숲, 꿈꾸는 자의 정자에 있는 전승지기 초를 찾아야 합니다. 레벨 10 비취 숲‡Encuentra al eremita Cho en el Pabellón del Soñador, en El Bosque de Jade.‡‡Cherchez le Chroniqueur Cho au Pavillon du Rêveur, dans la Forêt de Jade.‡去翡翠林的黄粱阁寻找游学者周卓。‡',
  }
},
[29889] = {
  {
    'Cerveja emprestada‡Позаимствованный напиток‡Geborgtes Gebräu‡술은 공짜 술이 제맛‡Brebaje prestado‡‡Une petite bière‡借来的美酒‡',
    nil,
    'Prove a cerveja que dá água na boca. Uma‡Попробуйте соблазнительный напиток.‡Kostet das köstliche Gebräu.‡군침도는 맥주를 맛봅니다. 레벨 10 비취 숲‡Prueba ese brebaje apetitoso.‡‡Goûtez à la Bière alléchante.‡品尝极品美酒。‡',
  }
},
[29890] = {
  {
    'Encontrando seu centro‡Равновесие внутри себя‡Die innere Mitte finden‡중심을 찾아서‡Encuentra tu centro‡‡Trouver votre centre‡集中精神‡',
    nil,
    'Medite com o Andarilho das Lendas Cho no templo do Pavilhão do Sonhador, que fica na Floresta de Jade. Uma‡Медитируйте вместе с хранителем истории Чо в пагоде, которая находится в Павильоне Мечтателя, что в Нефритовом лесу.‡Meditiert mit Lehrensucher Cho im Pavillon des Träumers im Jadewald.‡비취 숲, 꿈꾸는 자의 정자에 있는 제단에서 전승지기 초와 함께 명상해야 합니다. 레벨 10 비취 숲‡Medita con el eremita Cho en la pagoda del Pabellón del Soñador, en El Bosque de Jade.‡‡Méditez avec le Chroniqueur Cho à la pagode du Pavillon du Rêveur, dans la Forêt de Jade.‡前往翡翠林的黄粱阁，与游学者周卓一同在亭子中冥想。‡',
  }
},
[29891] = {
  {
    'Potência‡Крепость‡Ein starkes Gebräu‡진한 맛‡Potencia‡‡Force‡效力‡',
    nil,
    'Mate Rastejantes da Bruma até que o Horror da Bruma apareça, então pegue o Coração do Horror da Bruma. Uma‡Убивайте туманных ползунов, пока не появится Туманный ужас, а затем добудьте его сердце.‡Tötet Nebelkrabbler, bis ein Nebelschrecken erscheint, und nehmt ein Nebelschreckenherz an Euch.‡공포의 안개도깨비가 나타날 때까지 소름끼치는 안개도깨비를 처치해야 합니다. 그 후에 공포의 안개도깨비를 처치하고 공포의 안개도깨비 심장을 획득해야 합니다.‡Mata a trepadores de la niebla hasta que aparezca un horror de la niebla, y a continuación hazte con un corazón de horror de la niebla. Un(a) misión.‡‡Tuez des Rampants de brume jusqu’à ce qu’une Horreur de brume apparaisse, puis récupérez un Cœur d’horreur de brume.‡击败迷雾爬行者，直到迷雾恐魔出现，然后收集一颗迷雾恐魔之心。‡',
  }
},
[29892] = {
  {
    'Corpo‡Тело‡Körper‡달콤한 향기‡Cuerpo‡‡Du corps‡醇度‡',
    nil,
    'Colete 5 Olhos Perfeitos de Crocolisco dos Crocoliscos do Brejo. Uma‡Добудьте 5 безупречных глаз кроколисков-трясинников.‡Sammelt 5 makellose Krokiliskenaugen von Sumpfkrokilisken.‡수렁악어에게서 온전한 악어 눈 5개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 5 ojos de crocolisco prístinos de crocoliscos de ciénaga.‡‡Récoltez 5 Yeux de crocilisques en parfait état sur des Crocilisques des tourbières.‡从泥沼鳄鱼身上收集5只生鲜鳄鱼眼。‡',
  }
},
[29893] = {
  {
    'Coloração‡Оттенок‡Färbung‡매혹적인 빛깔‡Matiz‡‡Couleur‡色泽‡',
    nil,
    'Colete 8 Asas de Moscâmbar. Uma‡Добудьте 8 крыльев янтарных мух.‡Sammelt 8 Bernfliegenflügel.‡호박말벌 날개 8장을 모아야 합니다. 레벨 10 비취 숲‡Consigue 8 alas de brasacielo.‡‡Récupérez 8 Ailes d’ambrailes.‡收集8个琥珀蝇翅膀。‡',
  }
},
[29894] = {
  {
    'Espíritos da água‡Духи воды‡Geister des Wassers‡물의 정령‡Espíritus del agua‡‡Les esprits de l’eau‡水流之灵‡',
    nil,
    'Fale com o Ancião Lusshan e assista à cerimônia da parlágua. Uma‡Поговорите со старейшиной Лушанем и поприсутствуйте на церемонии разговора с водой.‡Sprecht mit dem Ältesten Lusshan und werdet Zeuge der Wassersprechzeremonie.‡장로 루샨과 대화하고 물예언의 의식을 지켜봐야 합니다. 레벨 10 비취 숲‡Habla con el ancestro Lusshan y observa la ceremonia de la oración del agua.‡‡Parlez au Vénérable Lusshan et assistez à la Cérémonie de l\'eauracle.‡和长老卢山谈一谈，并见证水语仪式。‡',
  }
},
[29895] = {
  {
    'Na trilha do Peão Branco‡По следу Белой Пешки‡Die Spur des Weißen Bauern‡하얀 싹의 흔적‡Tras la pista del peón blanco‡‡Sur la piste du Pion blanc‡白卒的踪迹‡',
    nil,
    'Mostre o manto ao Almirante Taylor na Aldeia Barbatana de Pérola, que fica na Floresta de Jade. Uma‡Покажите плащ адмиралу Тейлору в Деревне Жемчужного Плавника в Нефритовом лесу.‡Zeigt Admiral Taylor im Dorf der Perlflossen im Jadewald den Mantel.‡비취 숲의 진주지느러미 마을에 있는 제독 테일러에게 망토를 보여줘야 합니다. 레벨 10 비취 숲‡Muestra la capa al almirante Taylor en el Poblado Aleta de Nácar, en El Bosque de Jade.‡‡Montrez la cape à l’Amiral Taylor à Nageperle, dans la Forêt de Jade.‡前往翡翠林的珠鳍村，将斗篷拿给海军上将泰勒看看。‡',
  }
},
[29896] = {
  {
    'Filé espinhoso‡Стейк из дикобраза‡Stachelschießen‡‡Una de filetes‡‡Les tire-épines s’étaient cachés !‡‡',
    nil,
    'Consiga 5 Bifes de Porco-espinho. Uma‡Добудьте 5 стейков из дикобраза.‡Besorgt 5 Stachelschweinsteaks.‡‡Reúne 5 filetes de puercoespín.‡‡Récupérez 5 Steaks de porc-épic.‡‡',
  }
},
[29897] = {
  {
    'Não existe almoço grátis‡Бесплатного сыра не бывает‡Das Mittagessen gibt\'s nicht umsonst‡‡Bajo mínimos‡‡On n’a rien sans rien‡‡',
    nil,
    'Fale com Sandra Emerella no Bosque Víride, que fica na Floresta de Jade. Uma‡Найдите Сандру Эмереллу в Зеленой роще, что в Нефритовом лесу.‡Findet Sandra Emerella im Viridianhain im Jadewald.‡‡Encuentra a Sandra Emerella en la Arboleda Veridiana, en El Bosque de Jade.‡‡Trouvez Sandra Emerella au Bosquet Viridien dans la Forêt de Jade.‡‡',
  }
},
[29898] = {
  {
    'Águas sagradas‡Священные воды‡Heiliges Wasser‡신성한 물‡Aguas sagradas‡‡Les eaux sacrées‡圣水‡',
    nil,
    'Recolha águas curativas das quatro Bacias Sagradas no Covil da Tristeza. Uma‡Наберите целебных вод из четырех священных чаш в Логове Печали.‡Holt heilendes Wasser aus den vier heiligen Schalen in der Höhle der Trauer.‡슬픔의 동굴에 있는 신성한 그릇 4개에서 치유의 물을 모아야 합니다. 레벨 10 비취 숲‡Obtén las aguas de sanación de los cuatro cuencos sagrados en la Guarida del Pesar.‡‡Récupérez des Eaux guérisseuses dans les quatre Bols sacrés, dans la Tanière de la Mélancolie.‡从悲伤之穴的四个圣水泉眼中收集治疗之水。‡',
  }
},
[29899] = {
  {
    'Descanse em paz‡Покойтесь с миром‡Ruhet in Frieden‡평화롭게 잠드시오‡Descansen en paz‡‡Repose en paix‡安息‡',
    nil,
    'Mate 6 Espíritos Torturados. Uma‡Убейте 6 мучимых духов.‡Tötet 6 gepeinigte Geister.‡고통받는 영혼 6마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 6 espíritus torturados.‡‡Tuez 6 Esprits torturés.‡击败6个受折磨的灵魂。‡',
  }
},
[29900] = {
  {
    'Uma antiga lenda‡Древняя легенда‡Eine alte Legende‡고대의 전설‡Una leyenda antigua‡‡Une légende ancienne‡古老的传说‡',
    nil,
    'Recupere a Canção do Vale no Covil da Tristeza. Uma‡Заберите "Песнь Долины" из Логова Печали.‡Holt den Gesang des Tals aus der Höhle der Trauer.‡슬픔의 동굴에서 골짜기의 노래를 회수해야 합니다. 레벨 10 비취 숲‡Consigue la Canción del Valle en la Guarida del Pesar.‡‡Récupérez le Chant de la vallée dans la Tanière de la Mélancolie.‡从悲伤之穴取回《溪山吟》。‡',
  }
},
[29901] = {
  {
    'A decisão de Anduin‡Решение Андуина‡Anduins Entscheidung‡안두인의 결정‡La decisión de Anduin‡‡La décision d’Anduin‡安度因的决择‡',
    nil,
    'Diga a Anduin que é hora de voltar para casa. Uma‡Передайте Андуину, что пора возвращаться домой.‡Sagt Anduin, dass es Zeit ist, nach Hause zurückzukehren.‡안두인에게 집에 갈 시간이라고 말해야 합니다. 레벨 10 비취 숲‡Dile a Anduin que es hora de volver a casa.‡‡Dites à Anduin qu’il est temps de rentrer.‡告诉安度因该回家了。‡',
  }
},
[29902] = {
  {
    'Lutando contra as chamas‡Битва с огнем‡Kampf gegen die Flammen‡화염과의 혈투‡Apagar fuegos‡‡Au feu !‡灭火‡',
    nil,
    'Apague 6 incêndios no Pontal do Naufrágio. Uma‡Потушите 6 очагов пламени в Лагере потерпевших крушение.‡Löscht 6 Feuer am Hastigen Landgang.‡무법천지 상륙지에서 6곳의 불을 꺼야 합니다. 레벨 5 비취 숲‡Extingue 6 incendios en el Desembarco Improvisado.‡‡Éteignez 6 feux à l\'Accostage des Téméraires.‡扑灭迷航港的6处火焰。‡',
  }
},
[29903] = {
  {
    'Uma combinação perfeita‡Идеальное сочетание‡Passt perfekt‡완벽한 짝‡La unión perfecta‡‡Chacun son truc‡绝配‡',
    nil,
    'Fale com os Aquólitos Barbatana de Pérola e arme-os com o equipamento adequado. Uma‡Поговорите с аквалитами Жемчужного Плавника и должным образом вооружите их.‡Sprecht mit den Aqualythen der Perlflossen und stattet sie mit der richtigen Ausrüstung aus.‡진주지느러미 수병과 대화하고 적절한 장비로 무장시켜야 합니다. 레벨 10 비취 숲‡Habla con los acuálitos Aleta de Nácar y proporciónales el equipo adecuado.‡‡Parlez aux Aqualytes nageperles et fournissez-leur l’équipement adéquat.‡和珠鳍侍水僧们谈一谈，用合适的装备武装他们。‡',
  }
},
[29904] = {
  {
    'Peixes maiores para fritar‡Закаленные битвой‡Größere Fische‡생선은 푹 익혀야 제맛‡Freír el pez más grande‡‡Passons aux gros poissons‡另有要事‡',
    nil,
    'Treine os Adeptos Barbatana de Pérola matando 24 animais nos Bambuzais Selvagens. Uma‡Обучите учеников Жемчужного Плавника, убив 24 диких зверя в Бамбуковой чаще. задание.‡Bildet die Adepten der Perlflossen aus, indem Ihr 24 Tiere in der Bambuswildnis erlegt.‡대나무 밀림에서 야생동물 24마리를 처치하며 진주지느러미 숙련병들을 훈련시켜야 합니다. 레벨 10 비취 숲‡Entrena a los adeptos Aleta de Nácar matando a 24 formas de vida salvaje en Las Tierras de Bambú.‡‡Entraînez les Recrues nageperles en tuant 24 animaux dans la Bambouseraie Sauvage.‡通过杀死24只翠竹旷野中的野生生物来训练珠鳍精兵。‡',
  }
},
[29905] = {
  {
    'Deixe-os queimar‡Пусть горят‡Lasst sie brennen‡활활 타올라라‡Deja que ardan‡‡Qu’ils brûlent !‡烧死他们‡',
    nil,
    'Mate 15 Reforços Bagarai ou Recrutas Bodoqueiros. Uma‡Убейте 15 резервистов Грукин или новобранцев Ловкого Хвоста.‡Vernichtet 15 Flotsch-Verstärkungstruppen oder Schlingschwanz-Rekruten.‡그루끼끼 지원병 또는 줄꼬리 신병 15마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 15 refuerzos de Makaku o reclutas Colafusta.‡‡Tuez 15 Renforts groukards ou Recrues queutapultes.‡击败15只古鲁金援兵或吊尾新兵。‡',
  }
},
[29906] = {
  {
    '“Carpa” Diem‡Лови момент‡Carpe Diem‡잉어의 잉여한 힘을 모아‡Carpa Diem‡‡Carpe diem‡群龙无首‡',
    nil,
    'Mate o Chefe Pançaguk. Uma‡Убейте вождя Гукгута.‡Vernichtet Häuptling Gukgut.‡족장 구크구트를 처치해야 합니다. 레벨 10 비취 숲‡Mata al jefe Gukgut.‡‡Tuez le Chef Kimchtrip.‡击败酋长咕克嘎克。‡',
  }
},
[29907] = {
  {
    'Chen and Li Li‡Чэнь и Ли Ли‡Chen und Li Li‡첸과 리 리‡Chen y Li Li‡‡Chen et Li Li‡陈和丽丽‡',
    nil,
    'Siga Chen Malte do Trovão até a Fazenda do Pang. Uma‡Следуйте за Чэнем Буйным Портером в усадьбу Пана.‡Folgt Chen Sturmbräu zu Pangs Hof.‡팡의 처소까지 첸 스톰스타우트를 따라가야 합니다. 레벨 15 네 바람의 계곡‡Sigue a Chen Cerveza de Trueno hasta la Finca de Pang.‡‡Suivez Chen Brune d’Orage jusqu’à la Ferme de Pang.‡跟随陈·风暴烈酒去庞家农场。‡',
  }
},
[29908] = {
  {
    'Uma chateação aparentemente infindável‡Бесконечные хлопоты‡Ein schier unendliches Ärgernis‡끝없는 골칫거리‡Una molestia aparentemente interminable‡‡Une nuisance perpétuelle‡剪不断理还乱‡',
    nil,
    'Mate 8 Localizadores, 8 Pega-ferramentas ou 8 Encrenqueiros Farpadente. Depois mate 18 Pestículas Farpadente. Uma‡Уничтожьте 8 косозубов-разведчиков, косозубов-трудяг или косозубов-смутьянов. Затем убейте 18 докучливых косозубов.‡Tötet 8 Raffzahn-Shed-Ling, Werkzeugdiebe oder Unruhestifter. Tötet dann 18 Raffzahnnervensägen.‡덧니 정찰꾼, 덧니 토깽 또는 덧니 도구도둑 8마리를 처치한 후, 덧니 전염꾼 18마리를 처치해야 합니다.‡Mata a 8 mures Pegadiente, portaherramientas o alborotadores. Después mata a 18 latosos Pegadiente.‡‡Tuez 8 Guetteurs, Manieurs d’outils ou Fauteurs de troubles dent-cassée. Puis tuez 18 Enquiquineurs dent-cassée.‡先击败8只暴牙侦察者、暴牙强盗或暴牙捣蛋鬼，然后击败18只暴牙流氓。‡',
  }
},
[29909] = {
  {
    'Nada de nabos nababescos‡Низкая урожайность репы‡Geringe Rübenausbeute‡줄어드는 농작물 생산량‡Escasez de nabas‡‡Des navets, en avez-vous ?‡低产的芜菁‡',
    nil,
    'Encontre Ang Pé de Trovão. Uma‡Найдите Ана Громовую Пяту.‡Findet Ang Donnerfuß.‡앙 썬더풋을 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra a Ang Pie Atronador.‡‡Trouvez Ang Pied de Foudre.‡找到昂·雷脚。‡',
  }
},
[29910] = {
  {
    'Roedores desordeiros‡Бесчинствующие сурки‡Miese Murmler‡날뛰는 쥐들‡Roedores devastadores‡‡Rongeurs enragés‡鼠辈泛滥‡',
    nil,
    'Remova 6 Marmotas Roliças da Fazenda Pé de Trovão e entupa 6 Buracos de Marmota. Uma‡Прогоните 6 толстых сурков с фермы Громовой Пяты и засыпьте 6 нор сурков. задание.‡Vertreibt 6 mollige Murmeltiere vom Donnerfußhof und verschließt 6 Murmeltierbaue.‡썬더풋 농장에서 통통한 마모트 6마리를 몰아내고 마모트 구멍 6곳을 막아야 합니다. 레벨 15 네 바람의 계곡‡Expulsa a 6 marmotas rollizas de la Villoría Pie Atronador y tapa 6 madrigueras de marmota.‡‡Évacuez 6 Marmottes dodues de la ferme Pied de Foudre et comblez 6 Trous de marmottes.‡把6只胀鼓鼓的土拨鼠赶出雷脚农田，并填满6个土拨鼠地洞。‡',
  }
},
[29911] = {
  {
    'Produtos praticamente perfeitos‡Практически идеальные продукты‡Praktisch perfekte Produkte‡완벽하기 그지없는 수확물‡Procedimiento prácticamente perfecto‡‡Produits presque pas abîmés‡近乎完美的作物‡',
    nil,
    'Entregue o Caixote de Hortaliças Frescas para Pang Pé de Trovão. Uma‡Отнесите ящик со свежими продуктами Пану Громовой Пяте.‡Bringt die Kiste mit frischem Obst und Gemüse zu Pang Donnerfuß.‡팡 썬더풋에게 신선한 청과물 상자를 가져가야 합니다. 레벨 15 네 바람의 계곡‡Lleva el cajón de cultivos frescos a Pang Pie Atronador.‡‡Apportez la Caisse de produits frais à Pang Pied de Foudre.‡将一筐新鲜的果蔬带给庞·雷脚。‡',
  }
},
[29912] = {
  {
    'A fabulosa senhorita Fanny‡Прекрасная Фанни‡Fantastisches Fräulein Fanny‡굉장한 패니 양‡La fabulosa señorita Fanny‡‡La fabuleuse mam’zelle Fanny‡热心的范妮小姐‡',
    nil,
    'Leve o Nabo Rosa Gigante do Ang, a Melancia de Verão do Ang e o Tofu Mega Picante de Pang para a Srta. Fanny e peça a ela que os entregue. A comida precisa aterrissar no Rancho Pé de Trovão.‡Отнесите огромную розовую репу Ана, сочный арбуз Ана и чрезвычайно пряный тофу Пана Мисс Фанни и попросите ее доставить все это на ранчо Громовой Пяты.‡Bringt Angs riesige rosa Rübe, Angs Sommerwassermelone und Pangs besonders scharfen Tofu zu Fräulein Fanny, und bittet sie darum, sie zu befördern. Das Essen muss zum Gehöft Donnerfuß gebracht werden.‡앙의 거대한 분홍색 순무와 앙의 여름 수박, 그리고 팡의 불두부를 패니 양에게 가져가서 배달을 부탁해야 합니다. 세 가지 모두 썬더풋 사육장에 안전하게 도착해야 합니다.‡Lleva la naba rosa gigante de Ang, la sandía estival de Ang y el tofu hiperpicante de Pang a la señorita Fanny, y pídele que los entregue. La comida debe aterrizar en el Rancho Pie Atronador.‡‡Apportez le Navet rose géant d’Ang, la Pastèque estivale d’Ang et le Tofu extra épicé de Pang à Mam’zelle Fanny, puis demandez-lui de les livrer. La nourriture doit atterrir à l’Élevage Pied de Foudre.‡将昂的粉色大芜菁、昂的夏日西瓜和庞家特辣豆腐带给范妮小姐，并让她把食物交给梁。食物必须送达雷脚牧场。‡',
  }
},
[29913] = {
  {
    'Só carne de primeira‡Мясо, которое им понравится‡Fleisch um jeden Preis‡돼지가 먹을 고기‡La carne que van a comer‡‡De la viande à leur goût‡爱吃的肉‡',
    nil,
    'Obtenha 4 Paletas de Mushan e 80 pedaços de Carne de Tartaruga. Uma‡Принесите 4 стейка из мяса мушана и 80 кусков черепашьего мяса.‡Besorgt 4 Mushanschulterstücke und 80 Fetzen Schildkrötenfleisch.‡무샨 어깨 스테이크 4개와 거북이 고기 조각 80개를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 4 filetes de paleta de mushan y 80 restos de carne de tortuga.‡‡Obtenez 4 Steaks d’épaule de mushan et 80 Morceaux de viande de tortue.‡获取4块穆山兽肩肉排和80块乌龟肉碎片。‡',
  }
},
[29914] = {
  {
    'De volta ao chiqueiro‡Назад, в хлев‡Zurück in den Stall‡돼지 찾기‡Regreso a la pocilga‡‡Retour vers la porcherie‡送回猪圈‡',
    nil,
    'Encontre Jian, Ling e Fu Tum. Uma‡Найдите Цзяня, Лин и Вонючку.‡Sucht Jian, Ling und Stinki.‡지엔, 링과 구린내를 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra a Jian, Ling y Apestoso.‡‡Trouvez Jian, Ling et Fétide.‡找到健健、灵灵和臭肥肥。‡',
  }
},
[29915] = {
  {
    'Vizinho é para essas coisas‡Соседский долг‡Nachbarschaftliche Pflichten‡이웃의 의무‡Deber de vecino‡‡Relation de bon voisinage‡邻居的义务‡',
    nil,
    'Leve o Carneirinho Desgarrado para Francis, o Pastorinho. Uma‡Отведите заблудившуюся овечку пастуху Франсису.‡Bringt das entlaufene Lamm zu Francis dem Hirtenjungen.‡양치기 소년 프란시스에게 헤매는 새끼 양을 데려가야 합니다. 레벨 15 네 바람의 계곡‡Lleva el cordero díscolo a Francis el Pastorcillo.‡‡Ramenez l’Agneau rétif à Francis le jeune berger.‡把游荡的羔羊带给放羊的弗二郎。‡',
  }
},
[29916] = {
  {
    'Gadanhos e presas‡Острые когти и оскаленные зубы‡Schneidende Krallen und geifernde Schnäbel‡예리한 발톱과 군침 흘리는 턱‡Garfas penetrantes y mandíbulas batientes‡‡Serres perçantes et crocs baveux‡利爪馋嘴‡',
    nil,
    'Mate 5 Falcões-da-planície Ladroeiros e 6 Lobos Ladroeiros. Uma‡Уничтожьте 5 равнинных ястребов – налетчиков и 6 волков-налетчиков.‡Tötet 5 diebische Ebenenfalken und 6 diebische Wölfe.‡도둑 초원매 5마리와 도둑 늑대 6마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 5 halcones de la llanura ladrones y 6 lobos ladrones.‡‡Tuez 5 Faucons des plaines voleurs et 6 Loups voleurs.‡击败5只行窃平原鹰和6只行窃恶狼。‡',
  }
},
[29917] = {
  {
    'Lupello‡Волчарро‡Lupello‡루펠로‡Lupello‡‡Lupello‡卢佩罗‡',
    nil,
    'Mate Lupello. Uma‡Убейте Волчарро.‡Tötet Lupello.‡루펠로를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a Lupello.‡‡Tuez Lupello.‡击败卢佩罗。‡',
  }
},
[29918] = {
  {
    'Uma lição de coragem‡Урок мужества‡Eine Lektion in Sachen Tapferkeit‡용기란 이런 것이다!‡Una lección de valentía‡‡Une leçon de courage‡英勇的一课‡',
    nil,
    'Use o Laço do Rancheiro para laçar e derrotar uma Grande Águia-das-planícies Branca. Uma‡Заарканьте и победите крупного белого равнинного ястреба с помощью аркана фермера.‡Verwendet das Viehhüterlasso, um einen großen weißen Ebenenfalken einzufangen und zu töten.‡목동의 올가미줄을 사용해 거대한 흰색 초원매를 잡아 처치해야 합니다. 레벨 15 네 바람의 계곡‡Utiliza la reata de ranchero para atrapar y derrotar a un gran halcón de la llanura blanco.‡‡Utilisez la Longe de rancher pour capturer et vaincre un Grand faucon des plaines blanc.‡使用牧民的套索套住巨型白色平原鹰并打败它。‡',
  }
},
[29919] = {
  {
    'Grandes mentes bebem parecido‡Все великие пьют одинаково‡Zwei Dumme, ein Getränk‡위대한 자는 위대한 만큼 마신다‡Las grandes mentes beben por igual‡‡Les grands esprits se rencontrent‡英雄所喝略同‡',
    nil,
    'Escolte Chen Malte do Trovão e Li Li até a cervejaria a sudoeste. Uma‡Проводите Чэня Буйного Портера и Ли Ли к хмелеварне на юго-западе.‡Begleitet Chen Sturmbräu und Li Li zur Brauerei im Südwesten.‡첸 스톰스타우트와 리 리를 남서쪽에 있는 양조장까지 호위해야 합니다. 레벨 15 네 바람의 계곡‡Escolta a Chen Cerveza de Trueno y a Li Li hasta la cervecería del suroeste.‡‡Escortez Chen Brune d’Orage et Li Li jusqu’à la brasserie, au sud-ouest.‡护送陈·风暴烈酒和丽丽去西南边的酿酒厂。‡',
  }
},
[29920] = {
  {
    'Pedir permissão‡Благословение‡Die Erlaubnis erhalten‡허락은 주먹을 타고‡Conseguir el beneplácito‡‡Demander la main‡长辈的许可‡',
    nil,
    'Desafie e derrote o Pandriarca Áurea Cevada, o Pandriarca Pelo ao Vento e o Pandriarca Cajado Espinhoso. Uma‡Вызовите на бой и победите пандриарха Золотистый Нектар, пандриарха Воздушный Мех и пандриарха Ежевичный Посох.‡Fordert Pandriarch Zapfgold, Pandriarch Windpelz und Pandriarch Dornstab heraus und besiegt sie.‡시조 골든드래프트, 시조 윈드퍼, 시조 브램블스태프에게 도전하여 승리해야 합니다. 레벨 10 비취 숲‡Desafía y derrota al pandriarca Brisa Dorada, al pandriarca Pelaje Recio y al pandriarca Vara Enzarzada.‡‡Défiez et triomphez du Pandriarche Pression d’Or, du Pandriarche Fourrure de Vent et du Pandriarche Bâton de Roncier.‡挑战并打败金酿族长、风裘族长和棘杖族长。‡',
  }
},
[29922] = {
  {
    'Na busca pela sabedoria‡В поисках мудрости‡Auf der Suche nach Weisheit‡지혜를 찾아서‡En busca de la sabiduría‡‡En quête de sagesse‡寻求智慧‡',
    nil,
    'Fale com o Mestre de Pipas Ut-Nam e pegue um transporte para Flor da Manhã. Uma‡Поговорите с мастером воздушных змеев От-Намом и отправьтесь в Цветущую Зарю.‡Sprecht mit Drachenmeister Ut-Nam, um nach Morgenblüte zu gelangen.‡연 장인 우트남과 대화하여 새벽의 꽃으로 가야 합니다. 레벨 10 비취 숲‡Habla con el maestro de cometas Ut-Nam y viaja hasta Floralba.‡‡Parlez au Maître des cerfs-volants Ut Nam et voyagez jusqu’à Fleur-de-l’Aurore.‡和风筝大师欧提南谈一谈，然后前往晨芳园。‡',
  }
},
[29923] = {
  {
    'A Cerveja dos Sonhos‡Хмель глубоких раздумий‡Das Traumgebräu‡‡El brebaje de ensueño‡‡La bière onirique‡‡',
    nil,
    'Beba a Cerveja dos Sonhos na Pedra do Vidente e ache o Peão Branco. Uma‡Выпейте хмель глубоких раздумий у Камня Провидца и найдите Белую Пешку. Награда: .‡Trinkt das Traumgebräu am Stein des Sehers und findet den Weißen Bauern.‡‡Ingiere el brebaje de ensueño en la piedra de vidente y encuentra al peón blanco.‡‡Buvez la Bière onirique à la Pierre de voyant et trouvez le Pion Blanc.‡‡',
  }
},
[29924] = {
  {
    'Mate Kher Shan‡Смерть Кер Шаню!‡Vernichtet Kher Shan‡케르 샨 사냥‡Matar a Kher Shan‡‡Tuer Kher Shan‡杀死柯山‡',
    nil,
    'Mate Kher Shan no Bosque dos Tigres. Uma‡Убейте Кер Шаня в Тигрином лесу.‡Tötet Kher Shan im Tigergehölz.‡호랑이의 숲에 있는 케르 샨을 처치해야 합니다. 레벨 10 비취 숲‡Mata a Kher Shan en el Bosque del Tigre.‡‡Tuer Kher Shan au Bois des Tigres.‡杀死猛虎林中的柯山。‡',
  }
},
[29925] = {
  {
    'Tudo que estiver ao nosso alcance‡Все, что у нас есть‡Was wir entbehren können‡이게 전부라고요‡Todo lo que hemos podido conseguir‡‡Impossible de faire plus‡竭尽所能‡',
    nil,
    'Entregue o Jade Recuperado ao Andarilho das Lendas Cho no Agouro do Imperador. Fale com Toya, em Flor da Manhã, para pegar um transporte para lá.‡Отдайте добытый нефрит хранителю истории Чо у Знамения Императора. Попросите Тою в Цветущей Заре отвезти вас туда.‡Bringt die geplünderte Jade zu Lehrensucher Cho beim Omen des Kaisers. Bittet Toya in Morgenblüte um ein Transportmittel.‡황제의 예언에 있는 전승지기 초에게 긁어 모은 비취를 가져가야 합니다. 새벽의 꽃에 있는 토야와 대화하면 이동할 수 있습니다.‡Lleva el jade extraviado al eremita Cho al Augurio del Emperador. Habla con Toya en Floralba para realizar el viaje.‡‡Livrez le Jade de récupération au Chroniqueur Cho, au Présage de l’empereur. Parlez à Toya à Fleur-de-l’Aurore pour faire le voyage.‡前往皇帝的预言地，将挑选过的玉石交给游学者周卓。和晨芳园的托亚谈一谈，让他送你一程。‡',
  }
},
[29926] = {
  {
    'Calami-jade‡Опасный нефрит‡Unglücksjade‡재앙의 비취‡El jade de la calamidad‡‡Calamity Jade‡玉石灾星‡',
    nil,
    'Mate 12 Mordiscadoras Rocha Verde e 6 Devoradoras Rocha Verde na Pedreira Rocha Verde. Uma‡Уничтожьте 12 жевунов Зеленой Скалы и 6 брюхоловов Зеленой Скалы в каменоломне Зеленой Скалы.‡Erschlagt 12 Grünsteinknabberer und 6 Grünsteinverschlinger im Grünsteinbruch.‡녹옥 채석장에서 작은입 녹옥거미 12마리와 먹보 녹옥거미 6마리를 처치해야 합니다. 레벨 10 비취 숲‡Acaba con 12 mordisqueadores de Verdemar y 6 engullidoras de Verdemar en la Cantera Verdemar.‡‡Tuez 12 Grignoteurs de Pierre-Verte et 6 Goinfres de Pierre-Verte à la Carrière de Pierre-Verte.‡前往绿石采掘场，杀死12只绿石利齿蛛和6只绿石钻孔蛛。‡',
  }
},
[29927] = {
  {
    'O marido de Mann‡Муж Манн‡Manns Mann‡만의 남자‡El hombre de Mann‡‡L’homme de Mann‡孟的丈夫‡',
    nil,
    'Encontre Hao Mann na Pedreira Rocha Verde. Uma‡Найдите Хао Манна в каменоломне Зеленой Скалы.‡Sucht Hao Mann im Grünsteinbruch.‡녹옥 채석장에서 하오 만을 찾아야 합니다. 레벨 10 비취 숲‡Localiza a Hao Mann en la Cantera Verdemar.‡‡Trouvez Hao Mann dans la Carrière de Pierre-Verte.‡在绿石采掘场找到孟豪。‡',
  }
},
[29928] = {
  {
    'Quem mexeu no meu jade?‡У меня нет нефрита, и я хочу кричать!‡Ich hab keine Jade und muss schreien‡비취는 없고, 비명은 질러야 한다‡Si pierdo una pizca de jade más, gritaré‡‡Je n’ai pas de jade et il faut que je crie‡疯狂的石头‡',
    nil,
    'Obtenha 15 Pedaços de Jade dos Duendes Malfazejos nos arredores do Distrito dos Pedreiros de Rocha Verde. Uma‡Отнимите 15 кусков нефрита у злобных духов в Поселке Каменщиков Зеленой Скалы.‡Holt 15 Jadebrocken von den schelmischen Waldgeistern im Steinmetzviertel von Grünstein.‡녹옥 석공의 집 주위에 있는 장난기 많은 요마에게서 비취 덩어리 15개를 회수해야 합니다. 레벨 10 비취 숲‡Recupera 15 trozos de jade de los duendes traviesos que hay en el Barrio de Canteros de Verdemar.‡‡Récupérez 15 Morceaux de jade sur les Lutins malicieux autour du Quartier des Maçons de Pierre-Verte.‡到绿石工匠区，从调皮的林精身上取回15块玉石。‡',
  }
},
[29929] = {
  {
    'Soterrados!‡В ловушке!‡In der Falle!‡깔렸어요!‡¡Atrapados!‡‡Piégés !‡被困住了！‡',
    nil,
    'Liberte 8 Mineradores Rocha Verde na Pedreira Rocha Verde. Uma‡Освободите 8 рудокопов Зеленой Скалы в каменоломне Зеленой Скалы.‡Befreit 8 Grünsteinbergarbeiter im Grünsteinbruch.‡녹옥 채석장에서 녹옥 광부 8명을 구출해야 합니다. 레벨 10 비취 숲‡Libera a 8 mineros de Verdemar en la Cantera Verdemar.‡‡Libérez 8 Mineurs de Pierre-Verte à la Carrière de Pierre-Verte.‡在绿石采掘场解救8名绿石矿工。‡',
  }
},
[29930] = {
  {
    'Mina mina, sua mina‡Что в шахте добыл, то твое‡Was mein ist, ist Euer‡비취를 그대 품 안에‡Si lo excavas, es tuyo‡‡Ça ne paye pas de mine‡全归你了‡',
    nil,
    'Entre no carrinho de jade e volte com Hao para o Agouro do Imperador. Uma‡Садитесь в вагонетку с нефритом и отправляйтесь вместе с Хао в Знамение Императора.‡Steigt in den Jadewagen und fahrt mit Hao zurück zum Omen des Kaisers.‡비취 수레를 타고 하오와 함께 황제의 예언에 가야 합니다. 레벨 10 비취 숲‡Monta en la vagoneta de jade y ve con Hao al Augurio del Emperador.‡‡Montez à bord du Chariot de jade et retournez au Présage de l’empereur avec Hao.‡登上玉石矿车，与孟豪一起返回皇帝的预言地。‡',
  }
},
[29931] = {
  {
    'O Coração da Serpente‡Змеиное Сердце‡Das Schlangenherz‡용의 심장‡El Corazón del Dragón‡‡Le Cœur du serpent‡神龙之心‡',
    nil,
    'Fale com o Encarregado Raike no Coração da Serpente na Floresta de Jade. Uma‡Поговорите с мастером Рейки, который находится в Змеином Сердце в Нефритовом лесу.‡Sprecht mit Vorarbeiter Raike am Schlangenherz im Jadewald.‡비취 숲의 용의 심장에 있는 현장감독 레이케와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el supervisor Raike en el Corazón del Dragón, en El Bosque de Jade.‡‡Parlez au Contremaître Raike au Cœur du serpent, dans la Forêt de Jade.‡去翡翠林的神龙之心和工头雷科谈一谈。‡',
  }
},
[29932] = {
  {
    'O Templo da Serpente de Jade‡Храм Нефритовой Змеи‡Der Tempel der Jadeschlange‡옥룡사‡El Templo del Dragón de Jade‡‡Le temple du Serpent de jade‡青龙寺‡',
    nil,
    'Fale com a Mestra Anciã Brisa-Yi diante da entrada do Templo da Serpente de Jade. Fale com o Mestre-de-pipas Shoku para pegar uma pipa até o templo.‡Поговорите с верховной жрицей ветра И у входа в храм Нефритовой Змеи. Попросите мастера воздушных змеев Шоку доставить вас в храм.‡Sprecht mit der Ältestenweisen Wind-Yi vor dem Eingang zum Tempel der Jadeschlange. Sprecht mit dem Drachenmeister Shoku für einen Ritt zum Tempel.‡옥룡사의 입구 바깥에 있는 원로 현자 윈드이와 대화해야 합니다. 연 장인 쇼쿠와 대화하면 연을 타고 옥룡사로 날아갈 수 있습니다.‡Habla con la ancestro sabia Viento-Yi a la entrada del Templo del Dragón de Jade. Habla con el maestro de cometas Shoku para ir al templo en cometa.‡‡Parlez à la Vénérable ancienne Yi du Vent devant l’entrée du Temple du Serpent de jade. Parlez au Maître des cerfs-volants Shoku pour atteindre le temple en cerf-volant.‡和青龙寺入口处的大贤者易风谈一谈。和风筝大师卓续谈一谈，乘坐风筝去青龙寺。‡',
  }
},
[29933] = {
  {
    'Na mosca‡Наживка из мух‡Meine Beine!‡말벌 다리‡Por si las moscas‡‡Pattes de mouches‡上等虫腿‡',
    nil,
    'Junte 30 Pernas de Inseto das Tigrélulas no Bosque dos Tigres. Uma‡Соберите 30 ножек мух, уничтожая тигровых мух в Тигрином лесу.‡Sammelt 30 Käferbeine von Tigerfliegen im Tigergehölz.‡호랑이의 숲에 있는 호랑말벌에게서 벌레 다리 30개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 30 patas de bichos de las moscas tigre, en el Bosque del Tigre.‡‡Récoltez 30 Pattes d’insectes sur des Mouches-tigres au Bois des Tigres.‡从猛虎林的虎萤身上收集30条虫子腿。‡',
  }
},
[29934] = {
  {
    '‡Цель: поместье Черного Ворона‡Nach Rabenholdt‡라벤홀트 장원으로‡A Ravenholdt‡‡Direction Ravenholdt‡前往拉文霍德‡',
    nil,
    '‡Поговорите с Мостразом в Гранатовом редуте и вместе с ним отправляйтесь в поместье Черного Ворона.‡Sprecht mit Mostrasz am Zinnoberrefugium und fliegt mit ihm zum Rabenholdtanwesen.‡주홍빛 보루에 있는 모스트라즈와 대화해 함께 라벤홀트 장원으로 날아가야 합니다.‡Habla con Mostrasz en el Reducto Bermellón y vuela con él hasta la Mansión Ravenholdt.‡‡Parlez à Mostrasz à la Redoute Vermillon et volez ensemble jusqu\'au Manoir de Ravenholdt.‡与朱红庇护所的莫奥斯塔兹谈一谈，然后与他一起飞往拉文霍德庄园。‡',
  }
},
[29935] = {
  {
    'Ordens são ordens‡Приказ есть приказ‡Befehl ist Befehl‡까라면 까야지‡Las órdenes son las órdenes‡‡Les ordres sont les ordres‡唯命是从‡',
    nil,
    'Leve as Ordens da Aliança para o Chefe Koh Koh no Forte Bagarai. Uma‡Отнесите приказы Альянса вождю Ках-Каху на холм Грукин.‡Bringt die Allianzbefehle zu Häuptling Kah Kah auf dem Flotschhügel.‡그루끼끼 언덕에 있는 족장 카 카에게 얼라이언스 명령서를 가져가야 합니다. 레벨 10 비취 숲‡Llévale las órdenes de la Alianza al jefe Kah Kah en Cerro Makaku.‡‡Apportez les Ordres de l’Alliance au Chef Koh Koh, au Tertre des Groukards.‡将联盟命令交给古鲁金的酋长卡哈卡哈。‡',
  }
},
[29936] = {
  {
    'Mensagens instantâneas‡Мгновенный обмен сообщениями‡Sofortmitteilung‡희망은 불꽃을 타고‡Mensaje instantáneo‡‡Messagerie instantanée‡即时通信‡',
    nil,
    'Use o Sinalizador do Punho de Grito Infernal perto do Chefe Koh Koh no Morro Bagarai. Uma‡Запустите сигнальную ракету с "Кулака Адского Крика" рядом с вождем Ках-Кахом на холме Грукин.‡Nutzt das Signalleuchtfeuer der Höllschreis Faust nahe Häuptling Kah Kah auf dem Flotschhügel.‡그루끼끼 언덕에 있는 족장 카 카 근처에서 헬스크림의 철권호 신호탄을 사용해야 합니다. 레벨 10 비취 숲‡Utiliza la bengala de señalización de Puño de Grito Infernal cerca del jefe Kah Kah en Cerro Makaku.‡‡Utilisez la Fusée de signalisation du Poing de Hurlenfer près du Chef Koh Koh au Tertre des Groukards.‡在古鲁金猴山的酋长卡哈卡哈附近使用地狱咆哮之拳信号弹。‡',
  }
},
[29937] = {
  {
    'Penosos furiosos‡Разъяренная дичь‡Zorniges Geflügel‡날짐승 내장‡Ave furiosa‡‡Tripes de volaille‡愤怒的飞禽‡',
    nil,
    'Pegue 6 Punhados de Tripas de Pássaro dos Garrassangre nos Baixios Toletudis. Uma‡Наберите 6 пригоршней птичьих кишок, убивая кровопалов на Дуковых полях. задание.‡Sammelt 6 Handvoll Vogeleingeweide von Blutkrallen in den Knatzelgründen.‡두끼끼의 땅에 있는 붉은발톱수리에게서 새 내장 한 줌 6개를 모아야 합니다. 레벨 10 비취 숲‡Hazte con 6 puñados de tripas de pájaro de los garrasangres del Campo del Miko.‡‡Allez chercher 6 Poignées de tripes d’oiseaux sur les Griffesangs aux Terres Dookin.‡从顽猴旷野中的血爪鹰身上收集6把鸟肠。‡',
  }
},
[29938] = {
  {
    'Aliados e adversários‡Друзья и враги‡Freunde und Feinde‡친구와 적‡Amigos y enemigos‡‡Amis et ennemis‡‡',
    nil,
    'Mate 7 Jinyus Passo n\'Água no Córrego dos Muçuns. Uma‡Уничтожьте 7 приречных цзинь-юй у реки Безмятежной.‡Tötet 7 Strandläufer der Jinyu am Glitschifluss.‡미끈고기 개울에서 진위 물가순찰병 7마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 7 jinyu Zancarrío en el Arroyo Manduka.‡‡Tuez 7 Batteurs de grève jinyu à La Poisseuse.‡‡',
  }
},
[29939] = {
  {
    'Iscabum‡Взрывная наживка‡Leichtes Ziel‡미끼 폭탄‡Cebo explosivo‡‡Pêche à la dynamite‡炸鱼‡',
    nil,
    'Use as Bombas de Tripa na Costa Obscura e pegue 5 Muçuns Explodidos. Uma‡Разбросайте бомбы из потрохов на Грязном берегу и соберите 5 взорвавшихся грязней.‡Benutzt die Filetierbomben an der Düsterbank und sammelt 5 explodierte Glitschis.‡진흙 둑에서 내장탄을 사용하고 폭발한 미끈고기 5개를 모아야 합니다. 레벨 10 비취 숲‡Utiliza las bombagallas en la Ribera Turbia y hazte con 5 mandukas explotadas.‡‡Utilisez les Bombes à tripes à la Rive Bourbeuse puis ramassez 5 Poisseux explosés.‡在浊水河岸使用鸟肠炸弹并收集5条炸上来的滑水鱼。‡',
  }
},
[29940] = {
  {
    'Salvação da lavoura‡Возвращение похищенного урожая‡Geklautes Gemüse‡농작물 되찾기‡Recuperar la cosecha‡‡La récolte prend le large‡夺回作物‡',
    nil,
    'Recupere 5 Nabos Roubados e 5 Melancias Roubadas. Uma‡Найдите 5 украденных реп и 5 украденных арбузов.‡Besorgt 5 gestohlene Rüben und 5 gestohlene Wassermelonen.‡도난당한 순무와 도난당한 수박을 각각 5개씩 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 5 nabas robadas y 5 sandías robadas.‡‡Récupérez 5 Navets volés et 5 Pastèques volées.‡夺回5个被偷的芜菁和5个被偷的西瓜。‡',
  }
},
[29941] = {
  {
    'Além do horizonte‡Там, за горизонтом‡Jenseits des Horizonts‡지평선 너머로‡Más allá del horizonte‡‡Par-delà l’horizon‡超越地平线‡',
    nil,
    'Fale com Shokia, Sargento Gorrok, Mestressombra Kiryn e Chefe Koh Koh. Uma‡Поговорите с Шокией, сержантом Горроком, темным мастером Кирин и вождем Ках-Кахом.‡Sprecht mit Shokia, Unteroffizier Gorrok, Schattenmeisterin Kiryn und Häuptling Kah Kah.‡쇼키아, 하사관 고로크, 그늘지배자 키린, 족장 카 카와 대화해야 합니다. 레벨 10 비취 숲‡Habla con Shokia, con el sargento Gorrok, con la maestra tétrica Kiryn y con el jefe Kah Kah.‡‡Parlez à Shokia, au Sergent Gorrok, à la Maîtresse de l’Ombre Kiryn et au Chef Koh Koh.‡和夏琪亚、格罗克中士、匿踪大师琪麟以及酋长卡哈卡哈谈一谈。‡',
  }
},
[29942] = {
  {
    'Galerito besta, muçum é pra hozen‡Глупый шнуропс, грязни – хозенам!‡Dummer Nappel, Glitschis sind für Ho-zen‡우낏 멍청이! 미끈고기는 호젠 거!‡Dingue makaku: la manduka es de los hozen‡‡Lokdu bête, poisseux être pour hozen‡鱼儿都是我们的！‡',
    nil,
    'Pegue 4 Filés de Tartalisca na Costa Obscura. Uma‡Соберите 4 стейка из навозных крепкохватов на Грязном берегу.‡Besorgt 4 Schnappersteaks an der Düsterbank.‡진흙 둑에서 무쇠턱거북 스테이크를 4개 모아야 합니다. 레벨 10 비취 숲‡Consigue 4 filetes de sacudidor en la Ribera Turbia.‡‡Allez chercher 4 Steaks de mordeuses à la Rive Bourbeuse.‡从浊水河岸收集4块钳嘴龟肉排。‡',
  }
},
[29943] = {
  {
    'Guerrilheiros entre nós‡Лазутчики в наших землях‡Guerillas in unserer Mitte‡적은 가까이에‡Guerrillas en la niebla‡‡Opération guérilla‡身边的游击队‡',
    nil,
    'Mate 8 Infiltradores da Aliança perto do Mirante Panorâmico. Uma‡Уничтожьте 8 секретных агентов Альянса возле Утеса дивного вида.‡Vernichtet 8 Allianzinfiltratoren in der Nähe des Idyllischen Aussichtspunktes.‡경치 좋은 전망대 근처에서 얼라이언스 침투요원 8명을 처치해야 합니다. 레벨 10 비취 숲‡Mata a 8 infiltrados de la Alianza cerca del Mirador Pintoresco.‡‡Tuez 8 Infiltrateurs de l’Alliance près du Surplomb panoramique.‡击败观景台附近的8个联盟渗透者。‡',
  }
},
[29944] = {
  {
    'Controle de natalidade‡Лучшие производители‡Alphatiere‡번식자들의 우두머리‡Los líderes de los reproductores‡‡Reproducteurs en chef‡擒兔先擒首‡',
    nil,
    'Mate Aiyu, o Chapa Quente, Jinanya, o Lamigarra, e Saltilouco. Uma‡Уничтожьте Айюя "Сковородку", Жинаню Вилколапа и Буйноскока.‡Tötet Aiyu die Bratpfanne, Jinanya die Klauenklinge und Hoppelkoller.‡프라이팬 지배자 아이위, 갈퀴잡이 진안야, 광포깡충이를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a Aiyu el Sartenes, Jinanya el Garrapincho y Brincos.‡‡Tuez Aiyu le Poêlon, Jinanya le Griffelame et Zébulon.‡击败“煎锅”艾尤、“刃爪”吉纳亚和疯跳。‡',
  }
},
[29945] = {
  {
    'Amarelo + vermelho = laranja‡Желтый и красный дают оранжевый‡Aus gelb und rot wird orange‡노란색 더하기 빨간색은 주황색‡Amarillo y rojo hace naranja‡‡Jaune et rouge donnent orange‡黄配红变橙色‡',
    nil,
    'Consiga 10 Margaridas-do-prado e 40 Ampolas de Sangue de Animal. Uma‡Соберите 10 луговых бархатцев и 40 пузырьков с кровью животных.‡Besorgt 10 Wiesenringelblumen und 40 mit Tierblut gefüllte Phiolen.‡초원 금잔화 10개와 동물 피의 약병 40개를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 10 caléndulas de prado y 40 viales de sangre animal.‡‡Obtenez 10 Soucis des prés et 40 Fioles de sang animal.‡收集10株草甸金盏花和40瓶动物血液。‡',
  }
},
[29946] = {
  {
    'A matriarca da toca‡Прародительница‡Die Baumutter‡굴어미‡La madre de gazapera‡‡La mère de la garenne‡密径主母‡',
    nil,
    'Derrote Chufa, a Matriarca da Toca Tremepata. Uma‡Победите Чуфу, прародительницу кривоскоков.‡Besiegt Chufa, die Zuckfußbaumutter.‡씰룩발 굴어미 추파를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Derrota a Chufa, la madre de gazapera Pataloca.‡‡Terrassez Chufa, la mère de la garenne tremble-patte.‡击败挛踵主母，地栗。‡',
  }
},
[29947] = {
  {
    'A cenoura e o nabo‡Крадущаяся морковь, затаившаяся репа‡Der mit der Rübe tanzt‡당근 속에 순무‡Zanahoria y naba‡‡Des carottes ? Y’en navet plus !‡真假胡萝卜‡',
    nil,
    'Jogue Nabos Pintados de Laranja na frente de 12 Acumuladores Tremepata. Uma‡Бросьте покрашенную в оранжевый репу перед 12 кривоскоками-барахольщиками. задание.‡Werft orange angemalte Rüben vor 12 Zuckfußhamsterer.‡씰룩발 저장꾼 12마리 앞에 주황색으로 색칠한 순무를 던져놔야 합니다. 레벨 15 네 바람의 계곡‡Lanza nabas pintadas de naranja delante de 12 acaparadores Pataloca.‡‡Lancez des Navets peints en orange devant 12 Amasseurs tremble-pattes.‡将刷成橙色的芜菁扔到12只挛踵囤积者面前。‡',
  }
},
[29948] = {
  {
    'Ladrão até o caroço‡Прирожденные воры‡Diebisch bis ins Mark‡날 때부터 도둑놈‡Ladrones hasta la médula‡‡Des voleurs invétérés‡贼性难改‡',
    nil,
    'Recupere 6 Sacos de Grãos Roubados na Toca Torta. Uma‡Найдите в Извилистой норе 6 украденных мешков хмеля.‡Holt 6 gestohlene Hopfensäcke aus dem Gewundenen Gewirr zurück.‡뒤틀린 소굴에서 도난당한 홉 열매 자루 6개를 회수해야 합니다. 레벨 15 네 바람의 계곡‡Recupera 6 sacos de lúpulos robados en La Gazapera Retuerta.‡‡Récupérez 6 Sacs de houblon volés à la Garenne Tordue.‡从扭曲密径找回6袋被偷的啤酒花。‡',
  }
},
[29949] = {
  {
    'Legado‡Наследие‡Erbe‡맛볼 시간‡Legado‡‡L’héritage‡遗产‡',
    nil,
    'Tome uma rodada com Chen, Li Li e Caneca de Barro. Uma‡Выпейте с Чэнем, Ли Ли и Грязной Кружкой.‡Trinkt gemeinsam mit Chen, Li Li und Trübtrunk.‡첸, 리 리, 그리고 머드머그와 함께 술을 마셔야 합니다. 레벨 15 네 바람의 계곡‡Toma un trago con Chen, Li Li y Caolín.‡‡Prenez un verre avec Chen, Li Li et Gueule de Boue.‡与陈、丽丽和泥盏喝一杯。‡',
  }
},
[29950] = {
  {
    'Curtindo Pandária adoidado‡Выходной Ли Ли‡Li Lis freier Tag‡리 리의 휴일‡El día libre de Li Li‡‡Les vacances de mademoiselle Li Li‡丽丽的假日‡',
    nil,
    'Leve Li Li aos Campos de Seda, a Nova Cifera e às Cataratas de Huangtze. Uma‡Сводите Ли Ли на Шелковые поля, в Новую Циферу и к водопадам Хуаньцзы.‡Nehmt Li Li mit zu den Seidenfeldern, Neu-Cifera und zur Huangtzekaskade.‡리 리를 비단촌, 신 사이페라, 황지 폭포에 데려가야 합니다. 레벨 15 네 바람의 계곡‡Lleva a Li Li a los Campos de Seda, Nueva Cifera y las Cataratas Huangtze.‡‡Conduisez Li Li aux Champs Soyeux, à la Nouvelle-Ciféra et aux Chutes de Huangtze.‡带丽丽拜访丝纱工坊、新希菲拉和黄泽瀑布。‡',
  }
},
[29951] = {
  {
    'Águas barrentas‡Мутная вода‡Schlammiges Wasser‡흙탕물‡Agua fangosa‡‡En eaux boueuses‡泥水‡',
    nil,
    'Use o Frasco do Caneca de Barro para pegar água barrenta. Uma‡Наберите мутную воду в сосуд Грязной Кружки.‡Füllt schlammiges Wasser in Trübtrunks Phiole.‡머드머그의 약병을 이용해 흙탕물을 모아야 합니다. 레벨 15 네 바람의 계곡‡Utiliza el vial de Caolín para recoger agua fangosa.‡‡Utilisez la Fiole de Gueule de Boue pour récolter de l’eau boueuse.‡使用泥盏的瓶子收集泥水。‡',
  }
},
[29952] = {
  {
    'Sonhos despedaçados‡Разбитые мечты‡Zerstörte Träume‡무너진 꿈‡Sueños rotos‡‡Les rêves brisés‡破碎的梦想‡',
    nil,
    'Fale com Chen Malte do Trovão e ouça a história dele. Uma‡Выслушайте Чэня Буйного Портера.‡Sprecht mit Chen Sturmbräu und hört Euch seine Geschichte an.‡첸 스톰스타우트와 대화해 그의 이야기를 들어야 합니다. 레벨 15 네 바람의 계곡‡Habla con Chen Cerveza de Trueno y escucha su historia.‡‡Parlez à Chen Brune d’Orage et écoutez son histoire.‡和陈·风暴烈酒谈一谈并倾听他的故事。‡',
  }
},
[29966] = {
  {
    'Um dia a casa cai‡Дотла!‡Alles niederbrennen‡초가삼간 불태우기‡Prender fuego a la casa‡‡Mettez le feu !‡烧毁那座房子‡',
    nil,
    'Use o Grogue de Nazgrim para destruir o Acampamento da Aliança no topo do Mirante Panorâmico. Uma‡С помощью грога Назгрима уничтожьте лагерь Альянса на вершине Утеса дивного вида.‡Nutzt Nazgrims Grog, um das Lager der Allianz am Idyllischen Aussichtspunkt zu zerstören.‡나즈그림의 그로그주를 사용하여 경치 좋은 전망대 꼭대기에 있는 얼라이언스 야영지를 불태워야 합니다.‡Utiliza el grog de Nazgrim para destruir el campamento de la Alianza situado en el Mirador Pintoresco.‡‡Utilisez le Grog de Nazgrim pour détruire le Camp de l’Alliance, au sommet du Surplomb panoramique.‡使用纳兹戈林的烈酒摧毁观景台上的联盟营地。‡',
  }
},
[29967] = {
  {
    'A primeira faz bam! A segunda faz bum!‡И как бабахнет!‡Und das Dungamit macht Bumm!‡파멸의 폭탄이 콰광!‡¡Explosión de dunamita!‡‡Comme un poisson dans… la forêt !?‡炸弹才是王道！‡',
    nil,
    'Fale com Pinno no lado leste do Morro Bagarai. Use as Granadas de Metano para repelir o ataque dos jinyus. Uma‡Поговорите с Риветтом, который стоит к востоку от холма Грукин. Воспользуйтесь его метановыми гранатами, чтобы отразить атаку цзинь-юй.‡Sprecht mit Nieti Kuppelplopp östlich des Flotschhügels. Wehrt den Angriff der Jinyu mit seinen Methangranaten ab.‡그루끼끼 언덕 동쪽에 있는 리벳과 대화하고, 메탄 수류탄을 사용하여 진위의 공격을 막아내야 합니다.‡Habla con Perno al este de Cerro Makaku. Utiliza sus granadas de metano para hacer frente al ataque jinyu.‡‡Parlez à Rivett, à l’est du Tertre des Groukards. Utilisez ses Bombes au méthane pour repousser l’assaut des jinyu.‡和古鲁金猴山东边的利维特谈一谈。用他的沼气弹来抵御锦鱼人的进攻。‡',
  }
},
[29968] = {
  {
    'Energia verdosa‡Экологически чистая энергия‡Grünliche Energie‡녹색 성장의 구린내‡Energía verduzca‡‡De l’énergie presque verte‡绿色能源‡',
    nil,
    'Junte 7 Galhos Verdes nos Baixios Toletudis. Uma‡Соберите 7 зеленых ветвей в Дуковых полях.‡Sammelt 7 grüne Zweige in den Knatzelgründen.‡두끼끼의 땅에 있는 푸른 나뭇가지 7개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 7 ramas verdes en el Campo del Miko.‡‡Rassemblez 7 Branches vertes sur les Terres Dookin.‡在顽猴旷野收集7个鲜绿树枝。‡',
  }
},
[29969] = {
  {
    'Estatueta terrena quebrada‡Разбитая статуэтка земельника‡Zerbrochene Figur eines Irdenen‡‡Figurilla terránea rota‡‡La figurine de terrestre cassée‡破损的土灵雕像‡',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários. Uma‡Почините разбитую статуэтку, применив необходимые умения и материалы. это‡Repariert die zerbrochene Figur mithilfe Eurer Fertigkeit und den richtigen Materialien.‡‡Repara la figurilla rota con tu habilidad y materiales.‡‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡',
  }
},
[29970] = {
  {
    'Estatueta terrena quebrada‡Разбитая статуэтка земельника‡Zerbrochene Figur eines Irdenen‡‡Figurilla terránea rota‡‡La figurine de terrestre cassée‡破损的土灵雕像‡',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários. Uma‡Почините разбитую статуэтку, применив необходимые умения и материалы. это‡Repariert die zerbrochene Figur mithilfe Eurer Fertigkeit und den richtigen Materialien.‡‡Repara la figurilla rota con tu habilidad y materiales.‡‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡',
  }
},
[29971] = {
  {
    'Os batedores retornam‡Возвращение разведчиков‡Die Rückkehr des Spähers‡정찰대의 귀환‡El regreso de los exploradores‡‡Le retour des éclaireurs‡斥候归来‡',
    nil,
    'Fale com Shokia no Morro Bagarai. Uma‡Поговорите с Шокией на холме Грукин.‡Sprecht mit Shokia auf dem Flotschhügel.‡그루끼끼 언덕에 있는 쇼키아와 대화해야 합니다. 레벨 10 비취 숲‡Habla con Shokia en Cerro Makaku.‡‡Parlez à Shokia au Tertre des Groukards.‡去古鲁金猴山和夏琪亚谈一谈。‡',
  }
},
[29981] = {
  {
    'Enfrentando o enxame‡Остановить стаю‡Geflügelte Plagegeister‡벌레 떼 소탕‡Frenar al enjambre‡‡Juguler l’essaim‡堵住虫群‡',
    nil,
    'Mate 14 mantídeos Ik\'thik em Arado de Pedra. Uma‡Убейте 14 богомолов-ик\'тиков в Каменном Плуге.‡Tötet 14 Mantis der Ik\'thik in Steinpflug.‡돌밭에서 이크티크 사마귀 14마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 14 mántides Ik\'thik en Villarroca.‡‡Tuez 14 Mantides ik’thik à Chasse-Pierre.‡在石犁村击败14只伊克提克螳螂妖。‡',
  }
},
[29982] = {
  {
    'Ordens de evacuação‡Приказ об эвакуации‡Evakuierungsbefehl‡대피 명령‡Órdenes de evacuación‡‡L’ordre d’évacuer‡疏散命令‡',
    nil,
    'Evacue a Família Solo Negro, a Família Pata de Pá, a Família Campo Verde e a Família Pelo de Marga. Uma‡Эвакуируйте семьи Черной Земли, Острой Лапы, Зеленого Пахаря и Грязной Шкуры.‡Evakuiert die Familien Schwarzgrund, Schaufelprank, Grünacker und Mergelpelz.‡블랙소일 가족, 스페이드포우 가족, 그린틸 가족, 말퍼 가족을 대피시켜야 합니다. 레벨 15 네 바람의 계곡‡Evacúa a la familia Tierra Bruna, a la familia Zarpa Agreste, a la familia Brote Glauco y a la familia Pelaje Feraz.‡‡Évacuez la Famille Terre d’Encre, la Famille Poêle aux Pattes, la Famille Labour de Jouvence et la Famille Poil de Craie.‡疏散黑土一家、铲掌一家、绿耕一家和泥皮一家。‡',
  }
},
[29983] = {
  {
    'O mestre oculto‡Тайный мастер‡Der verborgene Meister‡은둔 고수‡El maestro oculto‡‡Le maître caché‡隐秘大师‡',
    nil,
    'Encontre o Mestre Pata Ferida no Vale dos Quatro Ventos. Uma‡Найдите мастера Побитую Лапу в долине Четырех Ветров.‡Sucht Meister Schrammtatz im Tal der Vier Winde.‡네 바람의 계곡에서 사부 멍든손을 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra al maestro Zarpa Herida en el Valle de los Cuatro Vientos.‡‡Trouvez Maître Patte Meurtrie dans la Vallée des Quatre vents.‡去四风谷找断掌大师。‡',
  }
},
[29984] = {
  {
    'Punhos obstinados: o teste do bambu‡Кулаки храбреца: испытание бамбуком‡Mit eiserner Faust: Herausforderung des Bambus‡불굴의 주먹: 대나무 깨기‡Puños implacables: Prueba del bambú‡‡Poings inflexibles - L’épreuve du bambou‡不屈之拳：竹之试炼‡',
    nil,
    'Fale com o Mestre Pata Ferida e, então, acerte 3 vezes a Pilha de Bambus. Uma‡Поговорите с мастером Побитой Лапой, а затем 3 раза нанесите удар по связке бамбуковых палок.‡Sprecht mit Meister Schrammtatz und versucht dann, den Stapel Bambusstangen dreimal zu treffen.‡사부 멍든손과 대화한 뒤 대나무 더미 3개를 성공적으로 명중시켜야 합니다. 레벨 15 네 바람의 계곡‡Habla con el maestro Zarpa Herida y luego golpea el montón de juncos de bambú 3 veces.‡‡Parlez à Maître Patte Meurtrie, puis tentez de frapper le Tas de roseaux 3 fois.‡和断掌大师谈一谈，然后成功击打一捆芦竹3次。‡',
  }
},
[29985] = {
  {
    'Sob o véu das brumas‡Там, за туманами‡Inkarnationen im Nebel‡안개의 화신 처치‡En niebla se convertirán‡‡Et la brume fut‡迷雾重重‡',
    nil,
    'Mate 12 Encarnações das Brumas. Uma‡Уничтожьте 12 порождений тумана.‡Tötet 12 Nebelinkarnationen.‡안개의 화신 12마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 12 encarnaciones de la niebla.‡‡Tuez 12 Incarnations de brume.‡击败12只迷雾化身。‡',
  }
},
[29986] = {
  {
    'Proteções contra a névoa‡Стражи тумана‡Die Nebelwarten‡안개 수호물‡Resguardos de niebla‡‡Protections anti-brouillard‡驱雾火盆‡',
    nil,
    'Acenda a Proteção Norte contra a Névoa, a Proteção Oeste contra a Névoa e a Proteção Sul contra a Névoa. Uma‡Зажгите северный, западный и южный стражи тумана.‡Entzündet die nördliche Nebelwarte, die westliche Nebelwarte und die südliche Nebelwarte.‡북쪽 안개 수호물과 서쪽 안개 수호물, 그리고 남쪽 안개 수호물에 불을 붙여야 합니다. 레벨 15 네 바람의 계곡‡Ilumina el resguardo de niebla del norte, el resguardo de niebla del oeste y el resguardo de niebla del sur.‡‡Allumez la Protection anti-brouillard du nord, la Protection anti-brouillard de l’ouest et la Protection anti-brouillard du sud. Un(e) quête.‡点燃北部驱雾火盆、西部驱雾火盆和南部驱雾火盆。‡',
  }
},
[29987] = {
  {
    'Punhos obstinados: o teste da madeira‡Кулаки храбреца: испытание деревом‡Mit eiserner Faust: Herausforderung des Holzes‡불굴의 주먹: 송판 깨기‡Puños implacables: Prueba de la madera‡‡Poings inflexibles - L’épreuve du bois‡不屈之拳：木之试炼‡',
    nil,
    'Fale com o Mestre Pata Ferida e, em seguida, acerte 4 vezes a Pilha de Madeira. Uma‡Поговорите с мастером Побитой Лапой, затем 4 раза нанесите удар по штабелю досок.‡Sprecht mit Meister Schrammtatz und versucht dann, den Stapel Holzbretter viermal zu treffen.‡사부 멍든손과 대화한 뒤 송판 더미 4개를 성공적으로 명중시켜야 합니다. 레벨 15 네 바람의 계곡‡Habla con el maestro Zarpa Herida y luego golpea el montón de tablas de madera 4 veces.‡‡Parlez à Maître Patte Meurtrie, puis tentez de frapper le Tas de planches de bois 4 fois.‡和断掌大师谈一谈，然后成功击打一堆木板4次。‡',
  }
},
[29988] = {
  {
    'Para quem gosta de ovos...‡Любовь к яйцам‡Eine Vorliebe für Eier‡맛 좋은 알‡Caza de huevos‡‡De bons œufs frais‡鸟蛋的味道‡',
    nil,
    'Consiga 10 Ovos de Andorinha-do-imperador, 4 Ovos de Garça-pescadora Branca e 1 Ovo de Moa Bicórnea. Uma‡Принесите 10 яиц императорской крачки, 4 яйца журавля-рыболова и 1 яйцо рогоклювого долгонога.‡Sammelt 10 Eier von Kaiserschwalben, 4 Eier von Weißkopfkranichen und 1 Ei eines Hornschnabelschreiters.‡황제 제비갈매기 알 10개, 흰물고기잡이 학 알 4개, 코뿔새 타조 알 1개를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue 10 huevos de pagaza emperatriz, 4 huevos de grulla Pezblanco y 1 huevo de zancudo Picocuerno.‡‡Ramassez 10 Œufs de sterne empereur, 4 Œufs de grue blanche-pêche et 1 Œuf de trotteur calao.‡获得10个帝燕鸥蛋、4个渔翁白鹤蛋和1个犀角陆行鸟蛋。‡',
  }
},
[29989] = {
  {
    'Punhos obstinados: o teste da pedra‡Кулаки храбреца: испытание камнем‡Mit eiserner Faust: Herausforderung des Steins‡불굴의 주먹: 석판 깨기‡Puños implacables: Prueba de la piedra‡‡Poings inflexibles - L’épreuve de la pierre‡不屈之拳：石之试炼‡',
    nil,
    'Fale com o Mestre Pata Ferida e, então, acerte 5 vezes a Pilha de Pedras. Uma‡Поговорите с мастером Побитой Лапой, затем 5 раз нанесите удар по стопке каменных плит.‡Sprecht mit Meister Schrammtatz und versucht dann, den Stapel Steinblöcke fünfmal zu treffen.‡사부 멍든손과 대화한 뒤 석판 더미 5개를 성공적으로 명중시켜야 합니다. 레벨 15 네 바람의 계곡‡Habla con el maestro Zarpa Herida y luego golpea el montón de bloques de piedra 5 veces.‡‡Parlez à Maître Patte Meurtrie, puis tentez de frapper le Tas de blocs de pierre 5 fois.‡和断掌大师谈一谈，然后成功击打一堆石砖5次。‡',
  }
},
[29990] = {
  {
    'Treinamento e disciplina‡Обучение и дисциплина‡Übung und Disziplin‡훈련과 규율‡Entrenamiento y disciplina‡‡Entraînement et discipline‡训练和戒律‡',
    nil,
    'Apresente-se a Lun Mai em Arado de Pedra, que fica no Vale dos Quatro Ventos. Uma‡Поговорите с командиром стражи Лун Маем, который находится в Каменном Плуге, что в долине Четырех Ветров.‡Meldet Euch bei Wachkommandant Lun Mai bei Steinpflug im Tal der Vier Winde.‡네 바람의 계곡의 돌밭에 있는 룬 마이에게 보고해야 합니다. 레벨 15 네 바람의 계곡‡Preséntate ante Loon Mai en Villarroca, en el Valle de los Cuatro Vientos.‡‡Présentez-vous à Loon Mai à Chasse-Pierre, dans la Vallée des Quatre vents.‡去四风谷的石犁村向麦龙报告。‡',
  }
},
[29992] = {
  {
    'Pata Tenra Por Nome, Pata Tenra Por Reputação‡Мягкая Лапа – во всех смыслах этого слова‡Nomen est omen‡물주먹 린 텐더포우‡Zarpa Blanda de nombre y de hecho‡‡Un patronyme adéquat‡以柔掌之名，以柔掌之誉‡',
    nil,
    'Colha 18 Folhas de Lunajade. Uma‡Соберите 18 листьев нефритовой луны.‡Sammelt 18 Jademondblätter.‡달비취 잎 18개를 모아야 합니다. 레벨 15 네 바람의 계곡‡Reúne 18 hojas de luna de jade.‡‡Récoltez 18 Feuilles de jadelune.‡收集18片玉月叶。‡',
  }
},
[29993] = {
  {
    'Encontre o rapaz‡В поисках юноши‡Findet den Jungen‡소년을 찾아라‡Encontrar al muchacho‡‡Chercher le garçon‡找到男孩‡',
    nil,
    'Fale com o Mestre Escriba Wei. Uma‡Поговорите с мастером каллиграфии Вэем.‡Sprecht mit Tintenmeister Wei.‡잉크장인 웨이와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el maestro calígrafo Wei.‡‡Parlez avec le Maître des encres Wei.‡和墨水大师魏谈一谈。‡',
  }
},
[29995] = {
  {
    'Templo da Aurora‡Святилище Рассвета‡Schrein der Morgensonne‡새벽의 제단‡Santuario del Alba‡‡Le sanctuaire de l’Aube‡黎明神龛‡',
    nil,
    'Vasculhe o Templo da Aurora em busca de Syra Áurea Cevada. Uma‡Найдите Сиру Золотистый Нектар в Святилище Рассвета.‡Sucht am Schrein der Morgensonne nach Syra Zapfgold.‡새벽의 제단에서 시라 골든드래프트를 찾아야 합니다. 레벨 10 비취 숲‡Busca a Syra Brisa Dorada en el Santuario del Alba.‡‡Fouillez le Sanctuaire de l’Aube à la recherche de Syra Pression d’Or.‡去黎明神龛寻找塞拉·金酿。‡',
  }
},
[29997] = {
  {
    'O dilema do áugure‡Дилемма провидца‡Das Dilemma des Sehers‡점술가의 딜레마‡El dilema del arúspice‡‡Un clairvoyant en eaux troubles‡占卜师的困境‡',
    nil,
    'Mate os Trasgos d\'Água para reaver o Cajado do Sábio Mari. Uma‡Убейте водяных демонов, чтобы добыть посох Мудрого Мариса.‡Vernichtet Wasserteufel, um den Stab des weisen Mari zurückzubekommen.‡물 마귀를 처치하고 현명한 마리의 지팡이를 되찾아야 합니다. 레벨 10 비취 숲‡Mata a los malignos de agua para recuperar el bastón de Maro el Sabio.‡‡Récupérez le bâtonnet du Sage Mari en tuant des Démons d’eau.‡击败流水魔，找回贤者马里的法杖。‡',
  }
},
[29998] = {
  {
    'A angústia do bibliotecário‡Заботы библиотекаря‡Das Dilemma des Bibliothekars‡사서의 곤경‡Las penurias de un bibliotecario‡‡Les soucis du bibliothécaire‡藏书人的困境‡',
    nil,
    'Fale com o Andarilho das Lendas Pisapedra na biblioteca do templo. Uma‡Поговорите с хранителем истории Каменной Поступью в библиотеке храма.‡Sprecht mit Lehrensucher Steinschritt in der Bibliothek des Tempels.‡사원 도서관에서 전승지기 스톤스텝과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el eremita Senda Pétrea en la biblioteca del templo.‡‡Parlez au Chroniqueur Pas de Pierre à la Bibliothèque du temple.‡和寺庙藏书阁的游学者石步谈一谈。‡',
  }
},
[29999] = {
  {
    'Laços de cavalgante‡Узы наездника‡Des Reiters Bindung‡기수의 교감‡El lazo del jinete‡‡Des serpents espiègles‡骑士的羁绊‡',
    nil,
    'Encontre 4 Serpentes Brincalhonas. Uma‡Найдите 4 игривых змеев.‡Findet 4 verspielte Schlangen.‡활발한 운룡 4마리를 찾아야 합니다. 레벨 10 비취 숲‡Encuentra a 4 dragones juguetones.‡‡Retrouvez 4 Serpents espiègles.‡找到4条顽皮的翔龙。‡',
  }
},
[30000] = {
  {
    'A Serpente de Jade‡Нефритовая Змея‡Die Jadeschlange‡옥룡‡El Dragón de Jade‡‡Le Serpent de jade‡青龙‡',
    nil,
    'Ouça a Serpente de Jade. Uma‡Выслушайте Нефритовую Змею.‡Hört der Jadeschlange zu.‡옥룡의 말을 들어야 합니다. 레벨 10 비취 숲‡Escucha al Dragón de Jade.‡‡Écoutez le Serpent de jade.‡倾听青龙的讲述。‡',
  }
},
[30001] = {
  {
    'Obsessão por mariposas‡Нашествие моли‡Mottenplage‡나방은 책의 적‡Apolillado‡‡Infestation de phalènes‡飞蛾满屋‡',
    nil,
    'Mate 8 Mariposas Sarapintadas. Uma‡Уничтожьте 8 пятнистых мотыльков.‡Vernichtet 8 gefleckte Motten.‡얼룩 나방 8마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 8 polillas veteadas.‡‡Tuez 8 Phalènes tachetés.‡杀死8只斑点飞蛾。‡',
  }
},
[30002] = {
  {
    'Páginas da história‡Страницы истории‡Historische Seiten‡역사의 한 장‡Páginas de historia‡‡Les pages de l’Histoire‡历史书页‡',
    nil,
    'Vasculhe os livros da biblioteca procurando infestações, depois esmague 12 Traças. Uma‡Найдите в библиотеке источники заражения и раздавите 12 книжных червей. задание.‡Sucht in der Bibliothek nach befallenen Büchern und zerquetscht 12 Bücherwürmer.‡도서관에서 벌레 먹은 책들을 살펴보고, 책벌레 12마리를 처치해야 합니다. 레벨 10 비취 숲‡Busca en la biblioteca libros infestados y aplasta a 12 gusanos de biblioteca.‡‡Arpentez la bibliothèque pour trouver des livres infestés, puis écrasez 12 Vers biblivores.‡搜遍整个藏书阁，找到被虫蛀的书，然后碾碎12只书虫。‡',
  }
},
[30003] = {
  {
    'Um livro pela capa‡Не суди о книге по обложке‡Der Schein trügt‡수박 겉 핥기‡Juzgar un libro por la portada‡‡Un livre à sa couverture‡事情的表象‡',
    nil,
    'Uma‡‡‡레벨 10 비취 숲‡‡‡‡‡',
  }
},
[30004] = {
  {
    'Tudo no seu lugar‡Все на своем месте‡Alles an Ort und Stelle‡모든 일이 해결되고‡Cada cosa en su lugar‡‡Tout est rentré dans l’ordre‡完好如初‡',
    nil,
    'Fale com o Mestre Ancião Chuva-Zhu no Templo da Serpente de Jade, que fica na Floresta de Jade. Uma‡Поговорите с верховным жрецом дождя Чжу в храме Нефритовой Змеи, что в Нефритовом лесу.‡Sprecht mit dem Ältestenweisen Ren-Zhu am Tempel der Jadeschlange im Jadewald.‡비취 숲의 옥룡사에 있는 원로 현자 레인주와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el ancestro sabio Lluvia-Zhu en el Templo del Dragón de Jade, en el Bosque de Jade.‡‡Parlez au Vénérable ancien Zhu de la Pluie au Temple du Serpent de jade, dans la Forêt de Jade.‡去翡翠林的青龙寺和大贤者朱雨谈一谈。‡',
  }
},
[30005] = {
  {
    'Iluminando o céu‡Огни в небе‡Den Himmel erleuchten‡하늘을 밝히다‡Iluminar el cielo‡‡Allumer les cieux‡点亮天空‡',
    nil,
    'Solte 8 Fogos de Artifício. Uma‡Запустите 8 фейерверков.‡Schießt 8 Feuerwerkskörper ab.‡폭죽 8개를 발사해야 합니다. 레벨 10 비취 숲‡Lanza 8 fuegos artificiales.‡‡Tirez 8 Feux d’artifice.‡点燃8个烟花。‡',
  }
},
[30006] = {
  {
    'A escuridão ao nosso redor‡Тьма вокруг нас‡Die Dunkelheit um uns herum‡주위를 채운 어둠‡La oscuridad que nos rodea‡‡Les ténèbres qui nous entourent‡黑暗缠身‡',
    nil,
    'Mate 15 invasores shas. Uma‡Уничтожьте 15 ша-захватчиков.‡Vernichtet 15 Sha-Eindringlinge.‡샤 침략자 15마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 15 invasores sha.‡‡Tuez 15 Envahisseurs sha.‡杀死15个煞魔侵略者。‡',
  }
},
[30007] = {
  {
    'Tracking Event: Completed Arrival Phase‡Tracking Event: Completed Arrival Phase‡Tracking Event: Completed Arrival Phase‡이벤트 추적: 도착 단계 완료‡Siguiendo evento: Fase de llegada completa‡‡Tracking Event: Completed Arrival Phase‡追踪事件：完成到达阶段‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[30009] = {
  {
    'Alistamento em Forte Bagarai‡Сбор войск в форте Грукин‡Sammeln in Fort Flotsch‡‡Asamblea del Fuerte Makaku‡‡Mobilisation à Fort-Groukard‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[30011] = {
  {
    'Uma nova visão‡Новое видение‡Eine neue Vision‡새로운 예언‡Una nueva visión‡‡Une nouvelle vision‡新的视界‡',
    nil,
    'Fale com o Mestre Ancião Chuva-Zhu perto do pátio do Templo da Serpente de Jade, que fica na Floresta de Jade. Uma‡Поговорите с верховным жрецом дождя Чжу. Его можно найти неподалеку от двора храма Нефритовой Змеи в Нефритовом лесу.‡Sprecht mit dem Ältestenweisen Ren-Zhu in der Nähe des Hofs des Tempels der Jadeschlange im Jadewald.‡비취 숲의 옥룡사 안마당에서 원로 현자 레인주와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el ancestro sabio Lluvia-Zhu cerca del patio del Templo del Dragón de Jade en El Bosque de Jade.‡‡Parlez au Vénérable ancien Zhu de la Pluie près de la cour du Temple du Serpent de jade, dans la Forêt de Jade.‡去翡翠林的青龙寺，和庭院附近的大贤者朱雨谈一谈。‡',
  }
},
[30015] = {
  {
    'Flor da Manhã‡Цветущая Заря‡Morgenblüte‡새벽의 꽃‡Floralba‡‡Fleur-de-l’Aurore‡晨芳园‡',
    nil,
    'Fale com o Andarilho das Lendas Cho em Flor da Manhã.Fale com o mestre de voo no Morro Bagarai para ir até lá. Uma‡Поговорите с хранителем истории Чо в Цветущей Заре.Чтобы добраться туда, поговорите с распорядителем полетов на холме Грукин.‡Sprecht mit Lehrensucher Cho in Morgenblüte.Sprecht mit dem Flugmeister des Flotschhügels, um mitgenommen zu werden.‡새벽의 꽃에서 전승지기 초와 대화해야 합니다.그루끼끼 언덕에 있는 비행 조련사와 대화하면 날아갈 수 있습니다.‡Habla con el eremita Cho en Floralba.Habla con el maestro de vuelo de Cerro Makaku para llegar allí.‡‡Parlez au Chroniqueur Cho à Fleur-de-l’Aurore.Parlez au Maître de vol au Tertre des Groukards pour vous y rendre.‡和晨芳园里的游学者周卓谈一谈。和古鲁金猴山的飞行管理员谈一谈出发的事。‡',
  }
},
[30019] = {
  {
    'A Breach in the Wall‡A Breach in the Wall‡Ein Bruch in der Mauer‡만리장벽 침입‡Una grieta en la muralla‡‡Une brèche dans la muraille‡长城缺口‡',
    nil,
    'Uma‡‡‡레벨 1 네 바람의 계곡‡‡‡‡‡',
