[3821] = {
  {
    'Rochedo Malhorrendo‡Скала Молота Ужаса‡Schreckensfels‡우레망치 바위굴‡Roca Machacamiedo‡Roca Machacamiedo‡Le Rocher des Cognepeurs‡巨槌石‡巨槌石',
    nil,
    'Explore as Estepes Ardentes e descubra o que aconteceu com Sha\'ni Altapresa.‡Отправляйтесь в Пылающие степи и выясните, что сталось с Ша\'ни Гордый Клык.‡Begebt Euch in die Brennende Steppe und findet heraus, was aus Sha\'ni Ehrenhauer geworden ist.‡불타는 평원으로 가서 샤니 프라우드터스크에게 무슨 일이 있었는지 확인해야 합니다.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colmillo Orgulloso.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colmillo Orgulloso.‡Aventurez-vous dans les Steppes Ardentes et découvrez ce qu\'il est advenu de Sha\'ni Fière-défense.‡到燃烧平原去找到沙妮·长齿。‡到燃燒平原去找到沙妮·長齒。',
  }
},
[3822] = {
  {
    'Krom\'Grul‡Кром\'Грул‡Krom\'Grul‡크롬그룰‡Krom\'Grul‡Krom\'Grul‡Krom\'Grul‡克罗格鲁尔‡克羅格盧爾',
    nil,
    'Recupere a Argola Nasal de Sha\'ni de Krom\'Grul e leve-a para Thal\'trak em Karrath. Procure nas várias cavernas e minas do Rochedo Malhorrendo.|n‡Заберите ноздревое кольцо Ша\'ни у Кром\'Грула и верните его Тал\'траку из Каргата. Обыщите различные пещеры и рудники скалы Молота Ужаса.‡Holt Sha\'nis Nasenring von Krom\'Grul zurück und bringt ihn zu Thal\'trak in Kargath. Durchsucht die verschiedenen Höhlen und Minen im Schreckensfels.‡크롬그룰에게서 샤니의 코걸이를 되찾아 카르가스에 있는 탈트라크에게 가져가야 합니다. 우레망치 바위굴에 있는 여러 광산과 동굴을 찾아봐야 합니다.‡Recupera el aro de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.|n‡Recupera el aro de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.|n‡Récupérer l\'Anneau de nez de Sha\'ni sur Krom\'Grul, et le rapporter à Thal\'trak, à Kargath. Fouiller les différentes grottes et mines du Rocher des Cognepeurs.‡从克罗格鲁尔手中拿回沙妮的鼻环，把它还给卡加斯的萨特拉克。搜寻巨槌石的每一处山洞和矿井。‡從克羅格盧爾手中拿回沙妮的鼻環，把它還給卡加斯的薩特拉克。搜尋巨槌石的每一處山洞和礦坑。',
  }
},
[3823] = {
  {
    'Extinção dos Pirobuchos‡Угасание Огненного Чрева‡Die Feuermagenoger auslöschen‡불자루 진화‡El exterminio de los Pirontraña‡El exterminio de los Pirontraña‡Exterminer les Brûlentrailles‡消灭火腹食人魔‡消滅火腹巨魔',
    nil,
    'Slay 15 Firegut Ogre-Mages, 7 Firegut Ogres, and 7 Firegut Ogre Brutes.‡Убейте 15 огров-магов, 7 огров и 7 громил из клана Огненного Чрева.‡Tötet 15 Ogermagier der Feuermägen, 7 Oger der Feuermägen sowie 7 Schläger der Feuermägen.‡불자루 오우거마법사 15마리, 불자루 오우거 7마리, 불자루 투사 7마리를 처치해야 합니다.‡Mata a 15 magos ogros Pirontraña, 7 ogros Pirontraña y 7 ogros toscos Pirontraña.‡Mata a 15 magos ogros Pirontraña, 7 ogros Pirontraña y 7 ogros toscos Pirontraña.‡Tuer 15 Ogres-mages brûlentrailles, 7 Ogres brûlentrailles et 7 Brutes brûlentrailles.‡杀掉15个火腹食人魔法师、7个火腹食人魔和7个火腹蛮兵。‡殺掉15個火腹巨魔法師、7個火腹巨魔和7個火腹蠻卒。',
  }
},
[3824] = {
  {
    'Gor\'tesh, o lorde dos brutamontes‡Гор\'теш Жестокий‡Gor\'tesh der Schläger-Lord‡포악한 군주 고르테쉬‡Gor\'tesh, el Señor de los toscos‡Gor\'tesh, el Señor de los toscos‡Le seigneur-brute Gor\'tesh‡蛮王戈泰什‡蠻王戈泰什',
    nil,
    'Collect Gor\'tesh\'s Lopped Off Head.‡Завладейте головой Гор\'теша.‡Beschafft Euch Gor\'teshs abgehackten Kopf.‡고르테쉬의 가면을 얻어야 합니다.‡Recoge la cabeza cortada de Gor\'tesh.‡Recoge la cabeza cortada de Gor\'tesh.‡Trouver la Tête coupée de Gor\'tesh.‡取得戈泰什的标记。‡取得戈泰什的頭顱。',
  }
},
[3825] = {
  {
    '‡Голова огра на палочке = вечеринка‡Ogerkopf auf einem Pfahl = Party‡‡Una cabeza ogro empalada = FIESTA‡Una cabeza ogro empalada = FIESTA‡Une tête d\'ogre au bout d\'une pique = une fête‡枭首示众‡',
    nil,
    '‡Отнесите голову Гор\'теша на вершину скалы Молота Ужаса. Поищите кучу рыхлой земли и воткните в нее пику.‡Nehmt Gor\'teshs abgehackten Kopf und platziert ihn auf dem Gipfel des Schreckensfelsens. Sucht nach einem weichen Erdhügel, um den Pfahl aufzustellen.‡‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Prendre la Tête coupée de Gor\'tesh et la placer au sommet du Rocher des Cognepeurs. Chercher un monticule de terre meuble pour planter la pique.‡把戈泰什的头颅放在巨槌石的山顶上。找一块软土堆把串着头颅的长矛插上去就可以了。‡',
  }
},
[3841] = {
  {
    '‡Бездомный сиротка‡Waise sucht Zuhause‡‡Un huérfano que busca un hogar‡Un huérfano que busca un hogar‡Un orphelin à la recherche d\'un foyer‡领养孤儿‡',
    nil,
    '‡Поговорите с Квентином в Тысяче Игл.‡Sprecht mit Quentin in Tausend Nadeln.‡‡Ve a Las Mil Agujas y habla con Quentin.‡Ve a Las Mil Agujas y habla con Quentin.‡Parler à Quentin aux Mille pointes.‡与千针石林的奎恩丁谈一谈。‡',
  }
},
[3842] = {
  {
    '‡Инкубатор‡Kurz vor dem Schlüpfen‡‡Una corta incubación‡Una corta incubación‡Une courte incubation‡即将孵化‡',
    nil,
    '‡Принесите 2 эликсира стойкости Квентину в Тысячу Игл.‡Bringt 2 Elixiere der Seelenstärke zu Quentin in Tausend Nadeln.‡‡Lleva 2 elixires de entereza a Quentin a Las Mil Agujas.‡Lleva 2 elixires de entereza a Quentin a Las Mil Agujas.‡Apporter 2 Elixirs de Robustesse à Quentin, aux Mille pointes.‡将2份坚韧药剂交给千针石林的奎恩丁。‡',
  }
},
[3843] = {
  {
    '‡Новый член семьи‡Das neueste Mitglied der Familie‡‡Un nuevo miembro en la familia‡Un nuevo miembro en la familia‡Un tout nouveau membre dans la famille‡新的生命‡',
    nil,
    '‡Отнесите хрупкое яйцо летучего хамелеона во Внутренние земли и поговорите с Агнаром Зверопасом. У вас есть на это всего 1 час. В противном случае детеныш в яйце умрет.‡Bringt Euer empfindliches Grimmlingflitzerei ins Hinterland und sprecht mit Agnar Tiermeister, aber beeilt Euch. Ihr habt nur eine Stunde Zeit, ihn zu finden. Dann stirbt das Jungtier in dem Ei.‡‡Lleva tu huevo de duende dardo frágil a las Tierras del Interior y habla con Agnar Domabestias, pero date prisa: si tardas más de 1 hora en encontrarlo, la cría que hay en el huevo morirá.‡Lleva tu huevo de duende dardo frágil a las Tierras del Interior y habla con Agnar Domabestias, pero date prisa: si tardas más de 1 hora en encontrarlo, la cría que hay en el huevo morirá.‡Emmenez votre Œuf fragile de Fée fléchetteuse dans les Hinterlands et parlez à Agnar Domptebêtes. Dépêchez-vous, vous n\'avez qu\'une heure pour le trouver avant que le petit ne meure dans l\'œuf.‡带着这枚脆弱的小精龙卵去辛特兰，与阿格纳谈一谈，但是你一定要在它还有生命力的时候赶到，在蛋里的小生命夭折之前，你只有1小时的时间。‡',
  }
},
[3844] = {
  {
    '‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un secret pour tout le monde‡无人知晓的秘密‡',
    nil,
    '‡Осмотритесь и попытайтесь выяснить, кому мог бы принадлежать разбитый плот.‡Sucht in dem Tümpel nach einem Hinweis darauf, wem dieses havarierte Floß gehören könnte.‡연못을 둘러보고 이 난파된 나룻배의 주인에 대한 단서를 찾아야 합니다.‡Busca alrededor del estanque alguna pista sobre a quién perteneció la balsa destrozada.‡Busca alrededor del estanque alguna pista sobre a quién perteneció la balsa destrozada.‡Rechercher dans l\'étang un indice sur l\'identité du propriétaire du radeau brisé.‡在池塘附近查找与搁浅的小艇有关的线索。‡',
  }
},
[3845] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Examine os itens dentro da bolsa e leve até o dono.‡Изучите найденное в сумке и верните владельцу.‡Untersucht die Gegenstände in dem Bündel und bringt sie zu ihrem Besitzer.‡가방 안에 든 물건을 조사해 그 주인에게 돌려줘야 합니다.‡Examina los objetos de la talega y devuélveselos a su propietario.‡Examina los objetos de la talega y devuélveselos a su propietario.‡Examiner les objets du paquet et les apporter à leur propriétaire.‡查看袋子里的东西，然后将它们交给物主。‡查看袋子裡的東西，然後將它們交給物主。',
  }
},
[3861] = {
  {
    'COCORICÓ!‡Куд-кудаааа!‡GLUCK!‡꼬꼬댁!!!‡¡CLOQUEA!‡¡CLOQUEA!‡COT-COT-CODEC !‡咕咕嘎！‡咕咕嘎!',
    nil,
    'Procure a Ração Especial de Galinha e volte até sua nova amiga galinácea. Em seguida, use a expressão /incentivar diante dela e lhe dê a Ração Especial de Galinha.‡Найдите немного цыплячьего корма и вернитесь к вашей курочке-подружке. Когда найдете курицу, покажите, как вы рады ее видеть (эмоция "/рад"), а потом накормите специальным цыплячьим кормом.‡Beschafft Euch etwas Spezialhühnerfutter und kehrt zu dem Huhn zurück, das sich mit Euch angefreundet hat. Wenn Ihr es gefunden habt, dann benutzt erst /jubeln, ehe Ihr dem Huhn das Spezialhühnerfutter gebt.‡특별 닭모이를 찾아 친구가 된 닭에게 가야 합니다. 특별 닭모이를 주기 전에 닭을 찾으면 /환호해야 합니다.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Trouver de la Nourriture spéciale pour poulet et l\'apporter à la poule que vous voulez aider. Lorsque vous l\'aurez trouvée, encouragez-la (/acclame) avant d\'essayer de lui donner la Nourriture spéciale pour poulet.‡找一些特殊的鸡饲料，把它交给友好的小鸡。当你找到小鸡的时候，在喂食它之前对它做出高兴的表情。（使用/cheer命令）‡找一些特殊的雞飼料，把它交給友好的小雞。當你找到小雞的時候，在餵食它特殊的雞飼料之前對它做出拍動翅膀的表情。(使用/cheer 命令)',
  }
},
[3881] = {
  {
    'A salvação da expedição‡Спасение экспедиции‡Rettungsexpedition‡원정대 구조‡Salvar a la expedición‡Salvar a la expedición‡Le sauvetage de l\'expédition‡抢救物资‡搶救物資',
    nil,
    'Leve um Caixote de Comestíveis e o Equipamento de Pesquisa para Williden Marshal in Cratera Un\'Goro.‡Принесите ящик с провизией и исследовательское оборудование Виллидену Маршаллу в Кратер Ун\'Горо.‡Bringt eine Kiste mit Nahrungsmitteln und Forscherausrüstung zu Williden Marschall im Krater von Un\'Goro.‡운고로 분화구에 있는 윌리덴 마샬에게 식량 상자와 탐사 장비를 가져가야 합니다.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Apporter une Caisse de nourriture et de l’Équipement de recherche à Williden Marshal dans le Cratère d\'Un\'Goro.‡将食物箱和研究设备交给安戈洛环形山的威利德·马绍尔。‡將食物木箱和研究設備交給安戈洛環形山的威利德·馬紹爾。',
  }
},
[3882] = {
  {
    'Osso duro de roer‡Игра в кости‡Knochenklappern‡뼈 수집‡Choca esos huesos‡Choca esos huesos‡Faites rouler les os‡挖骨头‡挖骨頭',
    nil,
    'Leve 8 Ossos de Dinossauro para Chispa Minanilo na Cratera Un\'Goro.‡Принесите 8 костей динозавра Искру Пустокопу в Кратер Ун\'Горо.‡Bringt 8 Dinosaurierknochen zu Funks Nilminer im Krater von Un\'Goro.‡운고로 분화구에 있는 스파크 닐마이너에게 공룡 뼈 8개를 가져가야 합니다.‡Lleva 8 huesos de dinosaurio a Chispik Minamal en el Cráter de Un\'Goro.‡Lleva 8 huesos de dinosaurio a Chispik Minamal en el Cráter de Un\'Goro.‡Apporter 8 Os de dinosaure à Étincelle Minerien, au cratère d\'Un\'Goro.‡将8根恐龙骨头交给安戈洛环形山的斯巴克·尼米尔。‡將8根恐龍骨頭交給安戈洛環形山的斯巴克·尼米爾。',
  }
},
[3883] = {
  {
    'Ecologia forânea‡Экология чужих‡Eine fremdartige Ökologie‡외래 생태계‡Ecología alienígena‡Ecología alienígena‡Écologie étrangère‡异型的生态‡異型的生態',
    nil,
    'Use a Ampola de Amostra para coletar uma Amostra de Parede de Colmeia de uma das incubadoras Gorishi na Cratera Un\'Goro. Procure as câmaras com larvas.|n|nLeve a Amostra de Parede de Colmeia para Hol\'anyee Marshal na Cratera Un\'Goro.‡Воспользуйтесь фиалом для образцов, чтобы взять образец материала со стены улья из одного из инкубаторов Гориши в Кратере Ун\'Горо. Ищите в ульях комнаты со свисающими гроздьями личинок. |n|nПринесите образец материала стены улья Холании Маршалл в Кратер Ун\'Горо.‡Verwendet die Kratzphiole, um damit eine Schwarmbauwandprobe von einer der Schwarmbrutstätten der Gorishi im Krater von Un\'Goro zu holen. Sucht nach den Kammern mit der hängenden Larvenbrut.|n|nBringt die Schwarmbauwandprobe zu Hol\'anyee Marschall im Krater von Un\'Goro.‡운고로 분화구에 있는 고리쉬 부화장에서 채집 약병을 사용해 고리쉬집 벽면 견본을 채취하십시오. 유충알이 매달려 있는 방을 찾아야 합니다.|n|n운고로 분화구에 있는 홀라니에 마샬에게 고리쉬집 벽면 견본을 가져가야 합니다.‡Utiliza el vial de raspadura para recoger una Muestra de pared de colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|n|nLleva la Muestra de pared de colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliza el vial de raspadura para recoger una Muestra de pared de colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|n|nLleva la Muestra de pared de colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliser la Fiole de raclement pour récolter un Échantillon de paroi de la ruche dans une des nurseries de la ruche Gorishi, à l\'intérieur du cratère d\'Un\'Goro. Chercher les chambres qui contiennent des larves suspendues.|n|nApporter l\'Échantillon de paroi de la ruche à Hol\'anyee Marshal dans le cratère d\'Un\'Goro.‡使用采集瓶从安戈洛环形山的某个格里什虫巢的孵化室中收集一份巢穴侧壁的样本，在有悬挂着的虫卵的房间里收集样本。|n|n将虫穴内壁样本交给安戈洛环形山的霍莱伊·马绍尔。‡使用採集瓶從安戈洛環形山的某個格里什蟲巢的孵化室中收集一份巢穴側壁的樣本，在有懸掛著的蟲卵的房間裡收集樣本。|n|n將蟲穴內壁樣本交給安戈洛環形山的霍萊伊·馬紹爾。',
  }
},
[3884] = {
  {
    'Diário de Williden‡Дневник Вилидена‡Willidens Tagebuch‡윌리덴의 일지‡Diario de Williden‡Diario de Williden‡Le journal de Williden‡威利德的日记‡威利德的日記',
    nil,
    'Devolva o diário a Williden Marshal na Cratera Un\'Goro.‡Верните дневник Виллидену Маршаллу, который находится где-то в Кратере Ун\'Горо.‡Bringt das Tagebuch zu Williden Marschall zurück. Er befindet sich irgendwo im Krater von Un\'Goro.‡운고로 분화구 어딘가에 있는 윌리덴 마샬에게 일지를 돌려줘야 합니다.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Rapporter le Journal à Williden Marshal quelque part dans le Cratère d\'Un\'Goro.‡将日记还给安戈洛环形山中的威利德·马绍尔。‡將日記還給安戈洛環形山中的威利德·馬紹爾。',
  }
},
[3885] = {
  {
    '‡<NYI> <TXT> Путешествие в Прибамбасск‡‡‡<NYI> <TXT> El paso Gadgetzan‡<NYI> <TXT> El paso Gadgetzan‡‡暂无内容‡',
    nil,
    '‡Сопроводите Петру и Дадангу.‡Begleitet Petra und Dadanga!‡‡¡Escolta a Petra y a Dadanga!‡¡Escolta a Petra y a Dadanga!‡Escorter Petra et Dadanga !‡‡',
  }
},
[3901] = {
  {
    'Desossando alguns Range-ossos‡Игрушки-погремушки‡Klappernde Skelette‡덜그럭거리는 해골 처치‡Sacudir esqueletos‡Sacudir esqueletos‡Faites cliqueter les thorax !‡断骨骷髅‡斷骨骷髏',
    nil,
    'Kill 8 Rattlecage Skeletons.‡Kill 8 Rattlecage Skeletons.‡Tötet 8 klappernde Skelette.‡덜그럭거리는 해골 8명을 처치해야 합니다.‡Mata a 8 esqueletos armadóseos.‡Mata a 8 esqueletos armadóseos.‡Tuez 8 Squelettes cliquethorax.‡消灭8个断骨骷髅。‡殺死8個斷骨骷髏。',
  }
},
[3902] = {
  {
    'Vasculhando Plangemortis‡Поиски старой одежды‡Beutesuche in Todesend‡죽음의 종소리 마을에서의 폐품 수집‡Hurgar en Camposanto‡Hurgar en Camposanto‡La chasse aux trésors‡捡破烂‡撿破爛',
    nil,
    'Procure 6 peças de Material Reaproveitado nas redondezas de Plangemortis e fale novamente com o Necroguarda Saulo.‡Обыщите Могильник и его окрестности и найдите 6 ящиков с добычей и передайте их стражу смерти Салтену.‡Durchsucht Todesend und Umgebung nach 6 Stücken aufgestöberter Ware und bringt sie zu Todeswache Saltain zurück.‡죽음의 종소리 마을과 그 주변에서 쓸만한 물건 6개를 찾아 죽음경비병 살테인에게 가져가야 합니다.‡Busca 6 piezas de mercancías extraviadas por Camposanto y los alrededores y llévaselas al Guardia de la Muerte Saltain.‡Busca 6 piezas de mercancías extraviadas por Camposanto y los alrededores y llévaselas al Guardia de la Muerte Saltain.‡Fouiller Le Glas et ses alentours pour trouver 6 caisses de Fournitures de récupération, et les ramener au Nécrogarde Saltain.‡在丧钟镇及临近地区搜寻6件破烂装备，把它们交给亡灵卫兵萨尔坦。‡在喪鐘鎮及臨近地區搜尋6件破爛裝備，把它們交給亡靈衛兵薩爾坦。',
  }
},
[3903] = {
  {
    'Madel Quintana‡Милли Осворт‡Milly Geltmark‡밀리 오스워스‡Milly Osworth‡Milly Osworth‡Milly Osworth‡米莉·奥斯沃斯‡米莉·奧斯沃斯',
    nil,
    'Fale com Madel Quintana.‡Поговорите с Милли Осворт.‡Sprecht mit Milly Geltmark.‡밀리 오스워스와 대화해야 합니다.‡Habla con Milly Osworth.‡Habla con Milly Osworth.‡Parler à Milly Osworth.‡与米莉·奥斯沃斯谈一谈。‡與米莉·奧斯沃斯談話。',
  }
},
[3904] = {
  {
    'Colheita da Madel‡Урожай Милли‡Millys Ernte‡밀리의 수확물‡La cosecha de Milly‡La cosecha de Milly‡La récolte de Milly‡米莉的葡萄‡米莉的葡萄',
    nil,
    'Leve 8 caixotes da Colheita da Madel para Madel Quintana na Abadia de Vila Norte.‡Принесите 8 корзин с виноградом Милли Осворт в Аббатство Североземья.‡Bringt 8 Kisten mit Millys Ernte zu Milly Geltmark in der Nähe der Abtei von Nordhain.‡북녘골 수도원에 있는 밀리 오스워스에게 밀리의 수확물 8 상자를 가져가야 합니다.‡Lleva 8 cajas de cosecha a Milly Osworth a la Abadía de Villanorte.‡Lleva 8 cajas de cosecha a Milly Osworth a la Abadía de Villanorte.‡Apportez 8 seaux de la récolte de Milly à Milly Osworth, à l\'Abbaye de Comté-du-Nord.‡收集8箱米莉的葡萄，把它们交给北郡修道院的米莉·奥斯沃斯。‡收集8箱米莉的葡萄，把它們交給北郡修道院的米莉·奧斯沃斯。',
  }
},
[3905] = {
  {
    'Manifesto da Uva‡Извещение о получении партии винограда‡Traubenliste‡포도 수확 목록‡Informe de la vendimia‡Informe de la vendimia‡Le manifeste des vendanges‡葡萄出货单‡葡萄出貨單',
    nil,
    'Leve o Manifesto da Uva para o Irmão Neals na Abadia de Vila Norte.‡Отнесите извещение о получении партии винограда брату Нилзу в Аббатство Североземья.‡Bringt die Traubenliste zu Bruder Neals in der Abtei von Nordhain.‡북녘골 수도원에 있는 수사 닐스에게 포도 수확 목록을 가져가야 합니다.‡Lleva el Informe de la vendimia al hermano Neals a la Abadía de Villanorte.‡Lleva el Informe de la vendimia al hermano Neals a la Abadía de Villanorte.‡Apportez le Manifeste des vendanges à Frère Neals dans l\'Abbaye de Comté-du-Nord.‡将葡萄出货单交给北郡修道院的尼尔斯修士。‡將葡萄出貨單交給北郡修道院的尼爾斯修士。',
  }
},
[3906] = {
  {
    'Desarmonia das chamas‡Дисгармония пламени‡Disharmonie der Flamme‡화염의 부조화‡La discordia de las llamas‡La discordia de las llamas‡Discordance des flammes‡不和谐的烈焰‡不和諧的烈焰',
    nil,
    'Vá até a pedreira da Montanha Rocha Negra e mate o Mestre Supremo Piro. Fale novamente com Coração Trovejante quando tiver cumprido essa tarefa.|n‡Отправьтесь в карьер у Черной горы и уничтожьте Подчинителя Пирона. По выполнению вернитесь к Громосерду.‡Reist zum Steinbruch im Schwarzfels und tötet Übermeister Pyron. Kehrt zu Donnerherz zurück, sobald Ihr den Auftrag erledigt habt.‡검은바위 산에 있는 채석장으로 가서 멸망의 파이론을 처치해야 합니다. 이 임무를 완수한 후 썬더하트에게 돌아가십시오.‡Ve a la cantera de la Montaña Roca Negra y ejecuta al Maestro Supremo Pyron. Vuelve junto a Corazón Atronador cuando hayas completado este encargo.|n‡Ve a la cantera de la Montaña Roca Negra y ejecuta al Maestro Supremo Pyron. Vuelve junto a Corazón Atronador cuando hayas completado este encargo.|n‡Partir pour la carrière dans le mont Rochenoire et tuer le Grand seigneur Pyron. Retourner voir Cœur-de-tonnerre une fois votre mission accomplie.‡到黑石山脉的采石场去干掉征服者派隆，然后向桑德哈特回报。‡到黑石山脈的採石場去幹掉征服者派隆，然後向桑德哈特回報。',
  }
},
[3907] = {
  {
    'Desarmonia do fogo‡Дисгармония пламени‡Disharmonie des Feuers‡불의 부조화‡La discordia del fuego‡La discordia del fuego‡Discordance des flammes‡不和谐的火焰‡不和諧的火焰',
    nil,
    'Entre no Abismo Rocha Negra e encontre o Lorde Incendius. Mate-o e leve todas as informações que puder para o Coração Trovejante.|n‡Ступайте в глубины Черной горы и выследите лорда Опалителя. Убейте его и принесите Громосерду все, что может дать какую-то информацию.‡Betretet die Schwarzfelstiefen und spürt Lord Incendius auf. Tötet ihn und bringt jegliche Informationsquelle, die Ihr finden könnt, zu Donnerherz.‡검은바위 나락에 들어가 불의 군주 인센디우스를 찾아, 그를 처치한 후 얻게 되는 모든 정보를 썬더하트에게 가져가야 합니다.‡Adéntrate en las Profundidades de Roca Negra y localiza a Lord Incendius. Mátalo y llévale toda la información que encuentres a Corazón Atronador.|n‡Adéntrate en las Profundidades de Roca Negra y localiza a Lord Incendius. Mátalo y llévale toda la información que encuentres a Corazón Atronador.|n‡Pénétrez dans les Profondeurs de Rochenoire et traquez le Seigneur Incendius. Tuez-le puis donner tous les renseignements que vous pourrez trouver à Cœur-de-tonnerre.‡进入黑石深渊并找到伊森迪奥斯。杀掉它，然后把你找到的信息汇报给桑德哈特。‡進入黑石深淵並找到伊森迪奧斯領主。殺掉它，然後把你找到的資訊彙報給桑德哈特。',
  }
},
[3908] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Leve a Espada de Linken para Bruna Covaneve em Hibérnia.‡Отнесите меч Линкена Донове Снегоноре.‡Bringt Linkens Schwert zu Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 링쿠의 훈련용 검을 가져가야 합니다.‡Lleva la Espada de Linken a Donova Cubilnevado en Cuna del Invierno.‡Lleva la Espada de Linken a Donova Cubilnevado en Cuna del Invierno.‡Apporter l\'Epée de Linken à Donova Antreneige au Berceau-de-l\'Hiver.‡把林克的剑交给冬泉谷的多诺瓦·雪山。‡把林克的劍交給冬泉谷的多諾瓦·雪山。',
  }
},
[3909] = {
  {
    'O elixir Videre‡Эликсир Видере‡Das Videre-Elixier‡앞날의 비약‡El Elixir de Videre‡El Elixir de Videre‡L\'élixir de Videre‡视灵药剂‡視靈藥劑',
    nil,
    'Procure Gregan Cospechope ao norte de Feralas. Descubra com ele como obter o elixir Videre, depois fale novamente com Bruna Covaneve em Hibérnia.‡Найдите Грегана Пивоплюя на севере Фераласа. Выясните у него, как получить эликсир Видере, и вернитесь к Донове Снегоноре.‡Sucht nach Gregan Hopfenspei im nördlichen Feralas. Lasst Euch von ihm erklären, wie Ihr Euch das Videre-Elixier beschaffen könnt, und kehrt dann zu Donova Schneeweh nach Winterquell zurück.‡페랄라스 북쪽에서 그레간 브루스퓨워를 찾아야 합니다. 그에게서 앞날의 비약을 얻는 방법을 배워 여명의 설원에 있는 도노바 스노우덴에게 가야 합니다.‡Busca a Gregan Tirabirras en el norte de Feralas. Con él, aprende cómo puedes obtener el Elixir de Videre. Cuando lo sepas, vuelve con Donova Cubilnevado en Cuna del Invierno.‡Busca a Gregan Tirabirras en el norte de Feralas. Con él, aprende cómo puedes obtener el Elixir de Videre. Cuando lo sepas, vuelve con Donova Cubilnevado en Cuna del Invierno.‡Rechercher Gregan Gerbebière au nord de Féralas. Apprendre de lui comment vous pouvez acquérir l\'élixir de Videre, puis retourner voir Donova Antreneige, au Berceau-de-l\'Hiver.‡去菲拉斯找格雷甘·山酒。从他那里问到获取视灵药剂的方法，然后向冬泉谷的多诺瓦·雪山复命。‡去菲拉斯找格雷甘·山酒。從他那裡問到獲取視靈藥劑的方法，然後向冬泉谷的多諾瓦·雪山覆命。',
  }
},
[3910] = {
  {
    '‡<NYI> <TXT> Вылазка в Ун\'Горо‡‡‡<NYI> <TXT> El paso Un\'Goro‡<NYI> <TXT> El paso Un\'Goro‡‡‡',
    nil,
    '‡Сопроводите Петру и Дадангу в Ун\'Горо.‡Begleitet Petra und Dadanga zurück nach Un\'Goro.‡‡Escolta a Petra y a Dadanga de vuelta a Un\'Goro.‡Escolta a Petra y a Dadanga de vuelta a Un\'Goro.‡Escorter Petra et Dadanga jusqu\'à Un\'Goro.‡‡',
  }
},
[3911] = {
  {
    '‡Последний элемент‡Das letzte Element‡‡El último elemento‡El último elemento‡Le dernier élément‡最后的元素‡',
    nil,
    '‡Отправляйтесь в Глубины Черной горы и добудьте 10 мер сущности Стихий. Стоит начать поиски с големов и их создателей. Вивиан Лягроб также бормотала что-то про элементалей.‡Begebt Euch in die Schwarzfelstiefen und beschafft 10 Essenzen der Elemente. Euer erster Gedanke ist, die Golems und die Schöpfer der Golems zu suchen. Doch Ihr erinnert Euch, dass Vivian Lagrave auch etwas von Elementaren vor sich hingemurmelt hat.‡‡Viaja a las Profundidades de Roca Negra y recupera 10 esencias de los elementos. Tu primer impulso es buscar los gólems y a los creadores de gólems. Recuerdas que Vivian Lagrave también murmuró entre dientes algo sobre los elementales.|n‡Viaja a las Profundidades de Roca Negra y recupera 10 esencias de los elementos. Tu primer impulso es buscar los gólems y a los creadores de gólems. Recuerdas que Vivian Lagrave también murmuró entre dientes algo sobre los elementales.|n‡Partir pour les Profondeurs de Rochenoire et trouver 10 Essences des éléments. Commencer vos recherches par les golems et par les créateurs de golems. Vivian Lagrave a aussi marmonné quelque chose à propos d\'élémentaires.‡到黑石深渊去取得10份元素精华。你应该在那些作战傀儡和傀儡制造者身上找找，另外，薇薇安·拉格雷也提到了一些有关元素生物的话题……‡',
  }
},
[3912] = {
  {
    'Encontro na sepultura‡Встречаемся на кладбище‡Treffen am Grab‡무덤에서의 만남‡Encuentro en la tumba‡Encuentro en la tumba‡Rendez-vous à la tombe‡墓地相见‡墓地相見',
    nil,
    'Vá até o cemitério perto de Geringontzan e use o Elixir Videre. Siga as outras instruções de Bruna para achar Gaeriyan.‡Отправляйтесь на кладбище на окраине Прибамбасска и выпейте там эликсир Видере. Далее, следуя инструкциям Доновы, найдите Гаэриана.‡Geht zum Friedhof außerhalb von Gadgetzan und benutzt dort das Videre-Elixier. Befolgt Donovas übrige Anweisungen, um Gaeriyan zu finden.‡가젯잔 밖에 있는 무덤으로 가서 앞날의 비약을 사용하십시오. 도노바의 지시에 따라 개리얀을 찾아야 합니다.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Se rendre au cimetière au-dehors de Gadgetzan et boire l\'élixir de Videre. Suivre le reste des instructions de Donova pour trouver Gaeriyan.‡在加基森镇外的墓地中使用视灵药剂，然后按照多诺瓦的指示找到加里杨。‡在加基森鎮外的墓地中使用視靈藥劑，然後按照多諾瓦的指示找到加里楊。',
  }
},
[3913] = {
  {
    '‡Замогильная история‡Grabesstille‡‡Una situación mortal‡Una situación mortal‡Une situation grave‡寻找墓碑‡',
    nil,
    '‡Воскресните, найдите могильный камень, о котором говорил Гаэриан.‡Wenn Ihr auferstanden seid, sucht nach dem Grabstein, von dem Gaeriyan Euch erzählt hat.‡‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Ressusciter, puis rechercher la pierre tombale que Gaeriyan vous a demandé de trouver.‡复活，然后寻找加里杨让你去找的那块墓碑。‡',
  }
},
[3914] = {
  {
    '‡Меч Линкена‡Linkens Schwert‡‡La Espada de Linken‡La Espada de Linken‡L\'épée de Linken‡林克的剑‡',
    nil,
    '‡Доставьте превосходный меч Линкена Линкену в Кратер Ун\'Горо.‡Liefert Linkens überragendes Schwert bei Linken im Krater von Un\'Goro ab.‡‡Entrega la Espada superior a Linken en el Cráter de Un\'Goro.‡Entrega la Espada superior a Linken en el Cráter de Un\'Goro.‡Remettre l’Épée excellente de Linken à Linken dans le cratère d\'Un\'Goro.‡把林克的强化之剑交给安戈洛尔环形山的林克。‡',
  }
},
[3921] = {
  {
    'Juntatudy Jogafora‡Венаки Бенике‡Wenikee Kübelbolz‡웨니키 볼트버킷‡Wenikee Tuercasmil‡Wenikee Tuercasmil‡Wenikee Bakaboulon‡维妮·布特巴克‡維妮·布特巴克',
    nil,
    'Leve a Rebimboca Quebrada e Surrada para Juntatudy Jogafora. Fale com Brak para se teleportar diretamente para perto de Juntatudy.‡Отнесите разбитый самофланж Венаки Бенике. Обратитесь к Браку, чтобы он телепортировал вас прямо к ней.‡Bringt das zerbrochene und ramponierte Samophlang zu Wenikee Kübelbolz. Sprecht mit Brak, um direkt zu ihr teleportiert zu werden.‡부서지고 찌그러진 사모플랜지를 웨니키 볼트버킷에게 가져가야 합니다. 웨니키 볼드버킷에게 순간이동하려면 브락과 대화하십시오.‡Llévale el churumbele roto y maltrecho a Wenikee Tuercasmil. Habla con Brak para teletransportarte directamente hasta ella.‡Llévale el churumbele roto y maltrecho a Wenikee Tuercasmil. Habla con Brak para teletransportarte directamente hasta ella.‡Apportez le Samophlange cassé à Wenikee Bakaboulon. Adressez-vous à Brak pour être directement téléporté auprès d\'elle.‡将损坏的主动式负载平衡器交给维妮·布特巴克。与布拉克交谈可以直接传送到她身边。‡將破碎的主動式負載平衡器交給維妮·布特巴克。和布拉克說話來直接傳送到她身邊。',
  }
},
[3922] = {
  {
    'Chumbalheiras‡Металлические заготовки‡Schraubnieten‡용접용 철괴‡Engranajes‡Engranajes‡Les petites pièces‡高强度齿轮‡高強度齒輪',
    nil,
    'Colete 10 Chumbalheiras nos baldes em volta do Charco de Lodo.‡Соберите 10 металлических заготовок для деталей вокруг Нефтяного болота.‡Sammelt 10 Schraubnieten aus den Werkzeugkisten rund ums Schlickmoor.‡진흙 늪 근처에 있는 용접용 철괴 10개를 모아야 합니다.‡Reúne 10 engranajes de los cubos que encuentres por la zona de El Fangal.‡Reúne 10 engranajes de los cubos que encuentres por la zona de El Fangal.‡Trouvez 10 Rondelles de métal dans des seaux autour de la Videfange.‡在淤泥沼泽的小桶中收集10个高强度齿轮。‡從淤泥沼澤周圍的桶子裡取得10個高強度齒輪。',
  }
},
[3923] = {
  {
    '[DEPRECATED] Rilli Greasygob‡[DEPRECATED] Рилли Грязегоб‡Rilli Schmierklump‡[미사용] 릴리 그리지가브‡[DEPRECATED] Rilli Gapegajoso‡[DEPRECATED] Rilli Gapegajoso‡[PÉRIMÉ]Rilli Grassougob‡[DEPRECATED] 雷里·格里斯高布‡[DEPRECATED]雷里·格里斯高布',
    nil,
    'Leve a Rebimboca Quebrada e Surrada para o Rilli Passomal em Orgrimmar.‡Отнесите разбитый и сломанный самофланж Рилли Грязегобу в Оргриммар.‡Bringt das zerbrochene und ramponierte Samophlang nach Orgrimmar zu Rilli Schmierklump.‡오그리마에 있는 릴리 그리지가브에게 부서지고 찌그러진 사모플랜지를 가져가야 합니다.‡Llévale el churumbele roto y maltrecho a Rilli Gapegajoso en Orgrimmar.‡Llévale el churumbele roto y maltrecho a Rilli Gapegajoso en Orgrimmar.‡Apportez le Samophlange cassé à Rilli Grassougob à Orgrimmar.‡把破碎的主动式负载平衡器交给奥格瑞玛的雷里·格里斯高布。‡把破碎的主動式負載平衡器交給奧格瑪的雷里·格里斯高布。',
  }
},
[3924] = {
  {
    '[DEPRICATED] Samophlange Manual‡[DEPRECATED]Руководство по самофланжу‡Samophlanghandbuch‡[미사용] 사모플랜지 설명서‡[DEPRICATED] El manual del churumbele‡[DEPRICATED] El manual del churumbele‡[PÉRIMÉ]Manuel du Samophlange‡[DEPRECATED] 主动式负载平衡器说明书‡[DEPRICATED] 主動式負載平衡器說明書',
    nil,
    'Leve o Manual da Rebimboca para Rilli Passomal em Orgrimmar.‡Отнесите руководство по самофланжу Рилли Грязегобу в Оргриммар.‡Bringt das Samophlanghandbuch nach Orgrimmar zu Rilli Schmierklump.‡오그리마에 있는 릴리 그리지가브에게 사모플랜지 설명서를 가져가야 합니다.‡Llévale el manual del churumbele a Rilli Gapegajoso en Orgrimmar.‡Llévale el manual del churumbele a Rilli Gapegajoso en Orgrimmar.‡Apportez le Manuel du samophlange à Rilli Grassougob à Orgrimmar.‡把主动式负载平衡器说明书交给奥格瑞玛的雷里·格里斯高布。‡把主動式負載平衡器說明書交給奧格瑪的雷里·格里斯高布。',
  }
},
[3941] = {
  {
    '‡Помощь гномов‡Die Hilfe des Gnoms‡‡La ayuda de una gnoma‡La ayuda de una gnoma‡Un gnome dans le besoin‡侏儒的援助‡',
    nil,
    '‡Найдите Джей Ди Колли в Укрытии Маршалла.‡Sucht J.D. Collie in der Höhle in Marschalls Zuflucht auf.‡‡Encuentra a J.D. Collie en la cueva del Refugio de Marshal.‡Encuentra a J.D. Collie en la cueva del Refugio de Marshal.‡Trouver J.D. Collie dans la caverne du refuge des Marshal.‡到马绍尔营地那里的山洞中去找科琳。‡',
  }
},
[3942] = {
  {
    '‡Память Линкена‡Linkens Andenken‡‡Recuerdos de Linken‡Recuerdos de Linken‡Les souvenirs de Linken‡林克的记忆‡',
    nil,
    '‡Найдите Эридану Грусть Ветра на юге Оскверненного леса.‡Sucht Eridan Blauwind im südlichen Teil des Teufelswalds.‡‡Encuentra a Eridan Vientoazul en el sur de Frondavil.‡Encuentra a Eridan Vientoazul en el sur de Frondavil.‡Trouver Eridan Ventebleu dans le sud de Gangrebois.‡到费伍德森林去找艾瑞丹·蓝风。‡',
  }
},
[3961] = {
  {
    '‡Приключения Линкена‡Linkens Abenteuer‡‡La aventura de Linken‡La aventura de Linken‡L\'aventure de Linken‡林克的冒险‡',
    nil,
    '‡Отнесите серебряный тотем Аквамонтоса Линкену в Укрытие Маршалла.‡Bringt das Silbertotem von Aquementas zu Linken in Marschalls Zuflucht.‡‡Lleva el Tótem plateado de Aquamentas a Linken, en el Refugio de Marshal.‡Lleva el Tótem plateado de Aquamentas a Linken, en el Refugio de Marshal.‡Apporter le Totem d\'argent d\'Aquementas à Linken au refuge des Marshal.‡把亚奎门塔斯的银图腾交给马绍尔营地里的林克。‡',
  }
},
[3962] = {
  {
    'É perigoso ir sozinho‡Один в поле не воин‡Allein ist es gefährlich‡혼자서 가기 무서운 곳‡Ir solo es peligroso‡Ir solo es peligroso‡C\'est dangereux d\'y aller seul‡结伴而行‡結伴而行',
    nil,
    'Vá para o Pico Penacho de Fogo, ao sul do Refúgio do Marshal.|n|nEncontre Agni e use o totem para remover sua aura de proteção. Uma vez que for derrotado, pegue a Chama Dourada na caverna.‡Отправляйтесь к Вулкану Огненного Венца, к югу от Укрытия Маршалла. |n|nНайдите Яропламеня и разрушьте его защитную ауру с помощью тотема. Когда дух будет сражен, заберите из пещеры Золотое пламя.‡Begebt Euch zum Feuersäulengrat südlich von Marschalls Zuflucht.|n|nSucht Sturmflamme und verwendet das Totem, um die schützende Aura, die ihn umgibt, zu entfernen. Sobald er besiegt ist, holt die Goldene Flamme aus der Höhle.‡마샬의 야영지 남쪽에 있는 불기둥 마루로 가야 합니다.|n|n불바람을 찾아 토템을 이용해 오라를 제거하십시오. 정령을 물리친 후, 동굴에서 황금 불길을 획득해야 합니다.‡Viaja a Cresta del Penacho en Llamas, al sur del Refugio de Marshal.|n|nBusca a Correfuego y utiliza el Tótem para eliminar su aura protectora. Cuando le hayas derrotado, coge la Llama Dorada de la cueva.‡Viaja a Cresta del Penacho en Llamas, al sur del Refugio de Marshal.|n|nBusca a Correfuego y utiliza el Tótem para eliminar su aura protectora. Cuando le hayas derrotado, coge la Llama Dorada de la cueva.‡Partir pour la crête de la Fournaise, au sud du refuge des Marshal.|n|nTrouver Coursembrase et utiliser le Totem pour dissiper son aura protectrice. Une fois Coursembrase vaincu, se procurer la Flamme dorée.‡到马绍尔营地南边的火羽山去。|n|n找到火焰使者，并使用图腾除掉它的防护光环。在击败它之后从洞中取得金色火焰。‡到馬紹爾營地南邊的火羽山去。|n|n找到火焰使者，並使用圖騰除掉它的防護光環。在擊敗它之後從洞中取得金色火焰。',
  }
},
[3981] = {
  {
    '‡Командир Гор\'шак‡Kommandant Gor\'shak‡사령관 고르샤크‡Comandante Gor\'shak‡Comandante Gor\'shak‡Le commandant Gor\'shak‡指挥官哥沙克‡指揮官哥沙克',
    nil,
    '‡Найдите командира Гор\'шака в Глубинах Черной горы. |n|nСудя по рисунку в записке, искать следует в темнице где-то вроде того.‡Sucht Kommandant Gor\'shak in den Schwarzfelstiefen.|n|nIhr erinnert Euch, dass auf dem primitiv gezeichneten Bild des Orcs auch Gitter vor dem Gesicht zu sehen waren. Vielleicht solltet Ihr nach einer Art Gefängnis suchen.‡‡Encuentra al comandante Gor\'shak en las Profundidades de Roca Negra.|n|nRecuerdas que en el dibujo burdo había rejas sobre el rostro del orco. Quizás deberías buscar una cárcel o algo similar.‡Encuentra al comandante Gor\'shak en las Profundidades de Roca Negra.|n|nRecuerdas que en el dibujo burdo había rejas sobre el rostro del orco. Quizás deberías buscar una cárcel o algo similar.‡Trouver le commandant Gor\'shak dans les Profondeurs de Rochenoire.|n|nVous vous souvenez que le dessin maladroit représentait également des barreaux au-dessus du portrait. Peut-être devriez-vous rechercher un genre de prison.‡在黑石深渊里找到指挥官哥沙克。|n|n在那幅草图上画着的是一个铁栏后面的兽人，也许你应该到某个类似监狱的地方去找找看。‡',
  }
},
[3982] = {
  {
    '‡Что происходит?‡Was ist los?‡이게 대체 무슨 일이죠?‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡發生了什麼事情?',
    nil,
    '‡Защитите Гор\'шака.‡Verteidigt Gor\'shak.‡‡Defiende a Gor\'shak.‡Defiende a Gor\'shak.‡Défendre Gor\'shak.‡保护哥沙克。‡',
  }
},
[4001] = {
  {
    '‡Что происходит?‡Was ist los?‡이게 대체 무슨 일이죠?‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡發生了什麼事情?',
    nil,
    '‡Поговорите с дворфом по имени Каран Могучий Молот и соберите информацию о похищении принцессы Мойры Бронзобород. Передайте информацию Траллу в Оргриммар.|n|nВы вспоминаете слова Гор\'шака о том, что Карана держат в темнице напротив.‡Sprecht mit Kharan Hammermacht und sammelt Informationen über die Entführung von Prinzessin Moira Bronzebart. Bringt diese Informationen dann zu Thrall nach Orgrimmar.|n|nIhr erinnert Euch, dass Gor\'shak gesagt hat, Kharan werde in einer Zelle in seiner Nähe festgehalten.‡‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar.|n|nRecuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.|n‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar.|n|nRecuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.|n‡Parler à Kharan Force-martel et obtenir autant de renseignements que possible sur l\'enlèvement de la princesse Moira Barbe-de-bronze. Apporter ces renseignements à Thrall à Orgrimmar.|n|nGor\'shak a dit que Kharan était détenu dans une cellule proche.‡与卡兰·巨锤谈一谈，收集关于绑架公主铁炉堡公主茉艾拉·铜须这一事件的情报。将情报反馈给奥格瑞玛城里的萨尔。|n|n哥沙克提到过卡兰被关在附近的某个牢房中。‡',
  }
},
[4002] = {
  {
    '‡Восточные королевства‡Die Östlichen Königreiche‡‡Los Reinos del Este‡Los Reinos del Este‡Les royaumes de l\'Est‡‡',
    nil,
    '‡Поговорите с Траллом.‡Sprecht mit Thrall, wenn Ihr bereit seid, die von ihm geplante Mission zu übernehmen.‡‡Si aceptas la misión, habla con Thrall.‡Si aceptas la misión, habla con Thrall.‡Parler à Thrall si vous êtes $Gprêt:prête; à vous charger de la mission qu\'il a prévue.‡如果你准备好要接受萨尔所安排的任务，就去找他谈一谈。‡',
  }
},
[4003] = {
  {
    'O resgate real‡Спасение принцессы‡Die königliche Rettung‡공주 구출‡El rescate real‡El rescate real‡Un sauvetage royal‡拯救公主‡拯救公主',
    nil,
    'Mate o Imperador Dagran Thaurissan e liberte a Princesa Moira Barbabronze do feitiço maligno. |n‡Убейте императора Даграна Тауриссана и освободите принцессу Мойру Бронзобород от его черного заклятия.‡Tötet Imperator Dagran Thaurissan und befreit Prinzessin Moira Bronzebart von seinem bösen Zauber.‡제왕 다그란 타우릿산을 처치하고 그의 사악한 마법에서 공주 모이라 브론즈비어드를 해방시켜야 합니다.‡Mata al emperador Dagran Thaurissan para liberar a la princesa Moira Barbabronce del hechizo.|n‡Mata al emperador Dagran Thaurissan para liberar a la princesa Moira Barbabronce del hechizo.|n‡Tuer l\'Empereur Thaurissan et libérer la Princesse Moira Barbe-de-bronze de son sort maléfique.‡杀掉达格兰·索瑞森大帝，然后将铁炉堡公主茉艾拉·铜须从他的邪恶诅咒中拯救出来。‡殺掉達格蘭·索瑞森大帝，然後將鐵爐堡公主茉艾拉·銅鬚從他的邪惡詛咒中拯救出來。',
  }
},
[4004] = {
  {
    '‡Спасенная принцесса‡Ist die Prinzessin gerettet?‡‡¿Princesa salvada?‡¿Princesa salvada?‡La Princesse sauvée ?‡拯救公主？‡',
    nil,
    '‡Вернитесь к Траллу в крепость Громмаш, что в Оргриммаре.‡Kehrt zu Thrall in der Feste Grommash in Orgrimmar zurück.‡‡Vuelve junto a Thrall en el Fuerte Grommash en Orgrimmar.|n‡Vuelve junto a Thrall en el Fuerte Grommash en Orgrimmar.|n‡Retourner voir Thrall à Fort Grommash, à Orgrimmar.‡向萨尔报告！‡',
  }
},
[4005] = {
  {
    '‡‡‡‡Aquamentas‡‡Aquementas‡亚奎门塔斯‡',
    nil,
    '‡Отнесите книгу Аквора, серебристые когти и сердце Железнолесья в Танарис. |n|nВоспользуйтесь книгой для призыва Аквамонтоса. |n|nПо получении тотема, отнести его Джей Ди Колли в Укрытие Маршалла.‡Bringt das Buch von Aquor, die silbrigen Klauen und das Eisenstammherz nach Tanaris.|n|nBenutzt das Buch von Aquor, um Aquementas zu beschwören.|n|nWenn Ihr das vollständige Totem habt, bringt es zu J.D. Collie in Marschalls Zuflucht zurück.‡‡Lleva el Libro de Aquor, las zarpas plateadas y el corazón de Troncoferro a Tanaris.|n|nUtiliza el Libro de Aquor para invocar Aquamentas.|n|nCuando tengas el tótem completo llévaselo a J.D. Collie en el Refugio de Marshal.‡Lleva el Libro de Aquor, las zarpas plateadas y el corazón de Troncoferro a Tanaris.|n|nUtiliza el Libro de Aquor para invocar Aquamentas.|n|nCuando tengas el tótem completo llévaselo a J.D. Collie en el Refugio de Marshal.‡Apporter le Livre d\'Aquor, les Griffes argentées et le Coeur d\'Arbrefer à Tanaris.|n|nUtiliser le Livre d\'Aquor pour invoquer Aquementas.|n|nAprès avoir terminé le totem, l\'apporter à J.D. Collie au refuge des Marshal.‡把阿奎尔之书、银爪和铁树之心带到塔纳利斯去。|n|n使用这本书召唤亚奎门塔斯。|n|n在图腾完成之后，把它交给马绍尔营地的科琳。‡',
  }
},
[4021] = {
  {
    'Contra-ataque!‡Контратака!‡Gegenangriff!‡반격!‡¡Contraataca!‡¡Contraataca!‡La contre-attaque !‡人马无双！‡人馬無雙!',
    nil,
    'Mate os centauros Kolkar até Krom\'zar aparecer, e, em seguida, mate-o e pegue um Pedaço do Estandarte de Krom\'zar.‡Убивайте кентвров из племени Колкар, пока не появится Кром\'зар. Одержите над ним верх и добудьте кусок знамени Кром\'зара.‡Tötet Kolkarzentauren bis Krom\'zar auftaucht, dann tötet ihn und nehmt einen Teil von Krom\'zars Flagge an Euch.‡콜카르 켄타우로스와 싸우다 장군 크롬자르가 나타나면 그를 처치한 뒤 크롬자르의 깃발 조각을 얻어야 합니다.‡Mata centauros Kolkar hasta que aparezca Krom\'zar, después asesínalo y coge una pieza del estandarte de Krom\'zar.‡Mata centauros Kolkar hasta que aparezca Krom\'zar, después asesínalo y coge una pieza del estandarte de Krom\'zar.‡Tuez des centaures kolkars jusqu’à ce que Krom’zar apparaisse, puis tuez-le et arrachez un Morceau de sa bannière.‡杀死科卡尔半人马，直到克罗姆扎出现。然后杀死他，获得克罗姆扎军旗的碎片。‡將克羅姆札旌旗的碎片交給十字路口西邊的雷戈薩·死門。',
  }
},
[4022] = {
  {
    '‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡',
    nil,
    '‡Покажите Цирусу Раскаивателю сброшенную кожу черного дракона, полученную от Каларана Ветрореза.‡Zeigt Cyrus Therepentous die abgestreifte Haut des schwarzen Drachenschwarms, die Ihr von Kalaran Windklinge erhalten habt.‡‡Enséñale a Cyrus Therepentio la escama de Vuelo Negro que recibiste de Kalaran Espada del Viento.|n‡Enséñale a Cyrus Therepentio la escama de Vuelo Negro que recibiste de Kalaran Espada del Viento.|n‡Montrer à Cyrus Lerepenti l\'Ecaille des dragons noirs que vous avez reçue de Kalaran Lamevent.‡向塞勒斯·萨雷芬图斯展示你从卡拉然·温布雷那里得到的黑龙皮。‡',
  }
},
[4023] = {
  {
    '‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡',
    nil,
    '‡Покажите Цирусу Раскаивателю доказательство своих деяний.|n|nВозникает чувство, что Цирус заранее сомневается в ваших качествах.‡Zeigt Cyrus Therepentous einen Beweis für Eure Nützlichkeit.|n|nIhr habt so ein Gefühl, dass Cyrus bereits weiß, dass Ihr unwürdig seid.‡키루스 테레펜터스에게 자신의 가치를 증명해 보여야 합니다.|n|n키루스가 이미 당신이 가치가 없다는 사실을 알고 있는 것 같은 느낌이 듭니다.‡Demuéstrale a Cyrus Therepentio lo que vales.|n|nTe da la impresión de que Cyrus ya sabe que no eres digno.‡Demuéstrale a Cyrus Therepentio lo que vales.|n|nTe da la impresión de que Cyrus ya sabe que no eres digno.‡Montrer à Cyrus Lerepenti une preuve de votre valeur.|n|nVous avez le sentiment que Cyrus sait déjà que vous êtes indigne.‡向塞勒斯·萨雷芬图斯证明你的价值。|n|n你感觉到塞勒斯似乎对你不屑一顾。‡',
  }
},
[4024] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Vá para o Abismo Rocha Negra e mate Bael\'gar.|n|nA única coisa que você sabe é que o gigante mora no Abismo Rocha Negra. Lembre-se de usar a Muda de Pele Alterada da Revoada Negra nos restos mortais de Bael\'gar para capturar a Essência Abrasadora.|n|nLeve a Essência Abrasadora Aprisionada para Ciro Terepento.|n‡Отправьтесь в глубины Черной горы и убейте Бейл\'Гара.|n|nИзвестно лишь то, что великан живет в глубинах. Воспользуйтесь измененной сброшенной шкурой черного дракона и возьмите из останков Бейл\'Гара его огненную сущность.|n|nОтнесите сущность Цирусу Раскаивателю.‡Begebt Euch in die Schwarzfelstiefen und tötet Bael\'Gar.|n|nIhr wisst lediglich, dass der Riese irgendwo in den Schwarzfelstiefen haust. Vergesst nicht, die veränderte Haut des schwarzen Drachenschwarms mit Bael\'Gars Überresten zu benutzen und damit die feurige Essenz einzufangen.|n|nBringt die eingeschlossene feurige Essenz zu Cyrus Therepentous zurück.‡검은바위 나락으로 가서 밸가르를 처치하십시오.|n|n이 거인이 검은바위 나락 내에 살고 있다는 것만 알고 있으며 밸가르의 시체에 변형된 검은용군단 허물을 사용해 불의 정수를 추출해야만 합니다.|n|n키루스 테레펜터스에게 담겨진 불의 정수를 가져가야 합니다.‡Viaja hasta las Profundidades de Roca Negra y mata a Bael\'Gar.|n|nSolo sabes que el gigante vive en las Profundidades de Roca Negra. Acuérdate de usar la escama alterada de Vuelo Negro sobre los restos de Bael\'Gar para capturar la esencia ígnea.|n|nLlévale la esencia ígnea encerrada a Cyrus Therepentio.|n‡Viaja hasta las Profundidades de Roca Negra y mata a Bael\'Gar.|n|nSolo sabes que el gigante vive en las Profundidades de Roca Negra. Acuérdate de usar la escama alterada de Vuelo Negro sobre los restos de Bael\'Gar para capturar la esencia ígnea.|n|nLlévale la esencia ígnea encerrada a Cyrus Therepentio.|n‡Partez pour les Profondeurs de Rochenoire et tuez Bael\'Gar.|n|nVous savez seulement que le géant demeure à l\'intérieur des Profondeurs de Rochenoire. N\'oublier pas d\'utiliser l\'Ecaille des dragons noirs altérée pour capturer l\'Essence flamboyante.|n|nApporter l\'Essence flamboyante enchâssée à Cyrus Lerepenti.‡到黑石深渊去杀掉贝尔加。|n|n你只知道这个巨型怪物住在黑石深渊的最深处。记住你要使用特殊的黑龙皮从贝尔加的尸体上采集烈焰精华。|n|n将你采集到的烈焰精华交给塞勒斯·萨雷芬图斯。‡到黑石深淵去殺掉貝爾加。|n|n你只知道這個巨型怪物住在黑石深淵的最深處。記住你要使用變化後的黑龍軍團之皮從貝爾加的屍體上採集烈焰精華。|n|n將你採集到的烈焰精華交給塞勒斯·薩雷芬圖斯。',
  }
},
[4041] = {
  {
    '‡Эликсир Видере‡Das Videre-Elixier‡‡El Elixir de Videre‡El Elixir de Videre‡L\'élixir de Videre‡视灵药剂‡',
    nil,
    nil,
  }
},
[4061] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Vá para as Estepes Ardentes e recupere 10 Estilhaços Elementais Fraturados para a Hierofante Theodora Malvadania.|n|nVocê se lembra que Theodora mencionou que os golens e elementais dessa região são uma fonte desses estilhaços.‡Отправляйтесь в Пылающие степи и соберите 10 осколков элементалей для верховной жрицы Теодоры Мальвадании. |n|nТеодора упоминала, что осколки можно найти у элементалей и големов.‡Begebt Euch in die Brennende Steppe und beschafft für Theodora Mulvadania 10 gerissene Elementarsplitter.|n|nEuch fällt ein, dass Theodora gesagt hat, die Golems und Elementare in der Gegend seien eine gute Quelle für solche Splitter.‡불타는 평원으로 가서 제사장 테오도라 뮬바다니아에게 가져갈 부서진 원소 파편 10개를 모아야 합니다.|n|n그 지역의 골렘과 정령들에게서 이 파편을 구할 수 있을 거라고 테오도라가 말했던 것이 기억납니다.‡Adéntrate en Las Estepas Ardientes y recupera 10 fragmentos elementales fracturados para Hierofante Theodora Mulvadania.|n|nRecuerdas que Theodora mencionó que los gólems y elementales de esa región eran la fuente de estos fragmentos.‡Adéntrate en Las Estepas Ardientes y recupera 10 fragmentos elementales fracturados para Hierofante Theodora Mulvadania.|n|nRecuerdas que Theodora mencionó que los gólems y elementales de esa región eran la fuente de estos fragmentos.‡Aventurez-vous dans les Steppes Ardentes et récupérez 10 Fragments d\'élémentaires cassés pour la Hiérophante Theodora Mulvadania.|n|nTheodora vous a indiqué que les golems et les élémentaires étaient la source de ces fragments.‡到燃烧平原去为塞朵拉·穆瓦丹尼收集10块断裂的元素碎片。|n|n塞朵拉曾经说过，那里的机械傀儡和元素生物是这种碎片的主要来源。‡到燃燒平原去為塞朵拉·穆瓦丹尼收集10塊斷裂的元素裂片。|n|n塞朵拉曾經說過，那裡的機械魔像和元素生物是這種裂片的主要來源。',
  }
},
[4062] = {
  {
    '‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡',
    nil,
    '‡Отнесите образец осколка элементаля Лотвилю Вериатусу. |n|nТеодора упоминала, что его лагерь находится на востоке.‡Bringt die Elementarsplitterprobe zu Lotwil Veriatus.|n|nIhr erinnert Euch, dass Theodora sagte, Lotwil sei in einem Lager im Osten stationiert.‡‡Lleva el ejemplar de fragmento elemental a Lotwil Veriatus.|n|nRecuerdas que Theodora dijo que Lotwil se encontraba en un campamento hacia el este.|n‡Lleva el ejemplar de fragmento elemental a Lotwil Veriatus.|n|nRecuerdas que Theodora dijo que Lotwil se encontraba en un campamento hacia el este.|n‡Apporter l\'Échantillon de fragment d\'élémentaire à Lotwil Veriatus.|n|nTheodora vous a dit qu\'il se trouvait dans un camp à l\'est.‡将元素碎片样本交给鲁特维尔·沃拉图斯。|n|n塞朵拉说鲁特维尔就在东边的一处营地里。‡',
  }
},
[4063] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Encontre e mate Lorde Golem Argelmach. Leve a cabeça dele para Lotwil. Você também precisará coletar 10 Núcleos de Elemental Intactos dos Golens Rasgafúria e Constructos Armipotentes que protegem Argelmach. Você sabe disso porque é paranormal. ‡Найдите и убейте повелителя големов Аргелмаха. Принесите его голову Лотвилю. Также соберите 10 невредимых ядер стихий с беспощадных големов и созданий-завоевателей, охраняющих Аргелмаха. Информация передана посредством телепатии.‡Sucht und tötet Golemlord Argelmach. Bringt Lotwil seinen Kopf. Außerdem müsst Ihr 10 intakte Elementarkerne von den Wuthäschergolems und Kriegshetzerkonstrukten, die Argelmach beschützen, beschaffen. Das wisst Ihr, weil Ihr übernatürliche Fähigkeiten habt.‡골렘 군주 아젤마크를 찾아 처치하고 그 증거로 그의 머리카락을 로트윌에게 가져가야 합니다. 그리고 아젤마크를 호위하는 전쟁인도자 피조물과 맹위의 전투골렘들에게서 온전한 원소핵 10개도 모아야 합니다.‡Encuentra al Señor Gólem Argelmach y mátalo. Llévale su cabeza a Lotwil. Asimismo tendrás que reunir 10 núcleos de elemental intactos de los gólems Furiatracadores y de los ensamblajes belisario que protegen a Argelmach. Lo sabes porque eres una adivina.‡Encuentra al Señor Gólem Argelmach y mátalo. Llévale su cabeza a Lotwil. Asimismo tendrás que reunir 10 núcleos de elemental intactos de los gólems Furiatracadores y de los ensamblajes belisario que protegen a Argelmach. Lo sabes porque eres $Gun adivino:una adivina;.‡Trouver et tuer le Seigneur des golems Argelmach. Rapporter sa tête à Lotwil. Collecter également 10 Noyaux d\'élémentaire intacts sur les Golems ravarage et les Assemblages porteguerre qui protègent Argelmach. Vous savez cela car vous êtes médium.‡找到并杀掉傀儡统帅阿格曼奇，将他的徽记交给鲁特维尔。你还需要从守卫着阿格曼奇的狂怒傀儡和战斗傀儡身上收集10块完整的元素核心。‡找到並殺掉魔像領主阿格曼奇，將他的頭交給魯特維爾。你還需要從守衛著阿格曼奇的狂怒魔像和戰鬥魔像身上收集10塊完整的元素核心。',
  }
},
[4081] = {
  {
    'SE VIR, MATE: Anões Ferro Negro‡УНИЧТОЖИТЬ НА МЕСТЕ: Дворфы Черного Железа‡SOFORT TÖTEN: Dunkeleisenzwerge‡죽음의 본보기: 검은무쇠 드워프‡MATAR INMEDIATAMENTE: enanos Hierro Negro‡MATAR INMEDIATAMENTE: enanos Hierro Negro‡TUER À VUE : nains sombrefers‡格杀勿论：黑铁矮人‡格殺勿論:黑鐵矮人',
    nil,
    'Desbrave o Abismo Rocha Negra e destrua aqueles invasores degenerados!|n|nO Senhor da Guerra Trincador quer que você mate 15 Guardas Furiadastra, 10 Carcereiros Furiadastra e 5 Soldados Rasos Furiadastra. Fale novamente com ele quando o trabalho estiver terminado.|n‡Отправляйтесь в глубины Черной горы и уничтожьте подлых агрессоров! |n|nПо приказу полководца Клинозуба уничтожьте 15 охранников, 10 надсмотрщиков и 5 пехотинцев из клана Ярости Горна. Вернитесь сразу по выполнении задания.‡Begebt Euch in die Schwarzfelstiefen und vernichtet die üblen Aggressoren!|n|nKriegsherr Bluthauer möchte, dass Ihr 15 Gardisten der Zorneshämmer, 10 Aufseher der Zorneshämmer und 5 Fußsoldaten der Zorneshämmer tötet. Kehrt zu ihm zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 나락으로 가서 사악한 침략자들을 쳐부수십시오!|n|n장군 고어투스가 성난모루 보초 15명, 성난모루 교도관 10명, 성난모루 보병 5명을 처치해 달라고 했습니다. 임무를 완수하면 장군 고어투스에게 가야 합니다.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|n|nEl señor de la guerra Dientegore quiere que mates a 15 custodios de Yunque Colérico, 10 alcaides de Yunque Colérico y 5 lacayos de Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|n|nEl señor de la guerra Dientegore quiere que mates a 15 celadores Yunque Colérico, 10 alcaides Yunque Colérico y 5 lacayos Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.|n‡Pénétrez dans les Profondeurs de Rochenoire et tuez les vils agresseurs !|n|nLe chef de guerre Sangredent veut que vous tuiez 15 Gardes ragenclumes, 10 Gardiens ragenclumes et 5 Fantassins ragenclumes. Retourner le voir une fois votre mission accomplie.‡到黑石深渊去消灭那些邪恶的侵略者！|n|n军官高图斯要你去杀死15个铁怒卫士、10个铁怒狱卒和5个铁怒步兵。完成任务之后回去向他复命。‡到黑石深淵去消滅那些邪惡的侵略者!|n|n督軍高圖斯要你去殺死15個鐵怒衛士、10個鐵怒獄卒和5個鐵怒步兵。完成任務之後回去找他。',
  }
},
[4082] = {
  {
    'SE VIR, MATE: Oficiais Ferro Negro de Alta Patente‡УНИЧТОЖИТЬ НА МЕСТЕ: Высокопоставленные чины Черного Железа‡SOFORT TÖTEN: Hochrangige Führungskräfte der Dunkeleisenzwerge‡죽음의 본보기: 검은무쇠 부족 고위 관리‡MATAR INMEDIATAMENTE: oficiales Hierro Negro de alto rango‡MATAR INMEDIATAMENTE: oficiales Hierro Negro de alto rango‡TUER À VUE : Officiers de haut rang sombrefers‡格杀勿论：高阶黑铁军官‡格殺勿論:高階黑鐵軍官',
    nil,
    'Vá até o Abismo Rocha Negra e destrua aqueles invasores degenerados!|n|nO Senhor da Guerra Trincador quer que você mate 10 Socorristas Furiadastra, 10 Soldados Furiadastra e 10 Oficiais Furiadastra. Fale novamente com ele quando o trabalho for concluído.‡Отправляйтесь в глубины Черной горы и уничтожьте подлых агрессоров! |n|nПо приказу полководца Клинозуба уничтожьте 10 медиков, 10 солдат и 10 офицеров из клана Ярости Горна. Вернитесь сразу по выполнении задания.‡Begebt Euch in die Schwarzfelstiefen und vernichtet die üblen Aggressoren!|n|nKriegsherr Bluthauer möchte, dass Ihr 10 Sanitäter der Zorneshämmer, 10 Soldaten der Zorneshämmer und 10 Offiziere der Zorneshämmer tötet. Kehrt zu ihm zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 나락으로 가서 사악한 침략자들을 쳐부수십시오!|n|n장군 고어투스가 성난모루 간호병 10명, 성난모루 병사 10명, 성난모루 장교 10명을 처치해 달라고 했습니다. 임무를 완수하고 고어투스에게 가야 합니다.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|n|nEl señor de la guerra Dientegore quiere que mates a 10 médicos de Yunque Colérico, 10 soldados de Yunque Colérico y 10 oficiales de Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|n|nEl señor de la guerra Dientegore quiere que mates a 10 médicos Yunque Colérico, 10 soldados Yunque Colérico y 10 oficiales Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Pénétrez dans les Profondeurs de Rochenoire et tuez les vils agresseurs !|n|nLe Chef de guerre Sangredent veut que vous tuiez 10 Médecins ragenclumes, 10 Soldats ragenclumes et 10 Officiers ragenclumes. Retourner le voir une fois votre mission accomplie.‡到黑石深渊去消灭那些邪恶的侵略者！|n|n高图斯军阀要你杀死10个铁怒医师,、10个铁怒士兵和10个铁怒军官。完成任务之后回去向他复命。‡到黑石深淵去消滅那些邪惡的侵略者!|n|n督軍高圖斯要你殺死10個鐵怒醫師,、10個鐵怒士兵和10個鐵怒軍官。完成任務之後回去向他覆命。',
  }
},
[4083] = {
  {
    'Cálice Espectral‡Призрачный кубок‡Der spektrale Kelch‡유령의 성배‡El cáliz espectral‡El cáliz espectral‡Le Calice spectral‡鬼魂之杯‡鬼靈之杯',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[4084] = {
  {
    'Coração de prata‡Серебряное сердце‡Silberherz‡은색 심장‡Corazón de plata‡Corazón de plata‡Cœur d\'argent‡银爪铁心‡銀爪鐵心',
    nil,
    'Colete 11 Garras Prateadas e 1 Coração de Ferrárbol para Eridan Brisazul na Selva Maleva.‡Добудьте 11 серебристых когтей и 1 сердце Железнолесья для Эриданы Грусти Ветра из Оскверненного леса.‡Beschafft 11 silbrige Klauen und 1 Eisenstammherz für Eridan Blauwind im Teufelswald.‡은백색 발톱 11개와 강철나무 심장 1개를 모아 악령숲에 있는 에리단 블루윈드에게 가져가야 합니다.‡Recoge 11 zarpas plateadas y 1 corazón de Troncoferro para Eridan Vientoazul de Frondavil.‡Recoge 11 zarpas plateadas y 1 corazón de Troncoferro para Eridan Vientoazul de Frondavil.‡Trouver 11 Griffes d\'argent et 1 Cœur d\'Arbrefer pour Eridan Ventebleu à Gangrebois.‡为费伍德森林的艾瑞丹·蓝风收集11只银爪和1颗铁树之心。‡為費伍德森林的艾瑞丹·藍風收集11隻銀爪和1顆鐵樹之心。',
  }
},
[4101] = {
  {
    '[DEPRECATED]Cleansing Felwood‡Очищение Оскверненного леса‡Den Teufelswald säubern‡악령숲 정화‡[DEPRECATED]Limpiar Frondavil‡[DEPRECATED]Limpiar Frondavil‡[PÉRIMÉ]Purifiez Gangrebois‡净化费伍德‡[DEPRECATED]Cleansing Felwood',
    nil,
    'Leve 15 Âmbares de Sangue para Arathandris Argencélio na Selva Maleva.‡Принесите 15 кровавых янтарей Аратандис Серебряному Небу в Оскверненный лес.‡Bringt 15 Einheiten Blutharz zu Arathandris Silberwolke im Teufelswald.‡악령숲에 있는 아라탄드리스 실버스카이에게 핏빛 호박석 15개를 가져가야 합니다.‡Lleva 15 unidades de ámbar de sangre a Arathandris Cielargento a Frondavil.‡Lleva 15 unidades de ámbar de sangre a Arathandris Cielargento a Frondavil.‡Apportez 15 Ambres de sang à Arathandris Argeciel, à Gangrebois.‡收集15颗血琥珀，把它们交给费伍德森林的阿拉珊蒂丝·银空。‡收集15顆血琥珀，把它們交給費伍德森林的阿拉珊蒂絲·銀空。',
  }
},
[4102] = {
  {
    '[DEPRECATED]Cleansing Felwood‡Очищение Оскверненного леса‡Den Teufelswald säubern‡악령숲 정화‡[DEPRECATED]Limpiar Frondavil‡[DEPRECATED]Limpiar Frondavil‡[PÉRIMÉ]Purifiez Gangrebois‡净化费伍德‡[DEPRECATED]Cleansing Felwood',
    nil,
    'Leve 15 Âmbares de Sangue para Maibess Brisa do Rio em Selva Maleva.‡Принесите 15 кровавых янтарей Майбессе Речному Ветру в Оскверненный лес.‡Bringt 15 Einheiten Blutharz zu Maybess Flussbrise im Teufelswald.‡악령숲에 있는 메이베스 리버브리즈에게 핏빛 호박석 15개를 가져가야 합니다.‡Lleva 15 unidades de ámbar de sangre a Maybess Brisa de Río a Frondavil.‡Lleva 15 unidades de ámbar de sangre a Maybess Brisa de Río a Frondavil.‡Apportez 15 Ambres de sang à Maybess Brise-des-rivières, à Gangrebois.‡收集15颗血琥珀，把它们交给费伍德森林的梅贝丝·河风。‡收集15顆血琥珀，把它們交給費伍德森林的梅貝絲·河風。',
  }
},
