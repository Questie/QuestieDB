},
[30027] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Pegue e equipe um Cajado do Discípulo. Uma‡Найдите посох ученика и возьмите его в руки.‡Nehmt Euch einen Schülerstab und legt ihn an.‡수련생의 지팡이를 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa un bastón de aprendiz.‡‡Procurez-vous un Bâton de recrue et équipez-vous-en.‡拾取并装备一把徒弟的木杖。‡',
  }
},
[30028] = {
  {
    'O resgate dos grãos‡Грабь награбленное‡Getreiderettung‡곡물 되찾기‡La recuperación del grano‡‡Récupérer les céréales‡找回谷物‡',
    nil,
    'Leve 8 Sacos de Grãos para o Senhor dos Grãos Kai. Uma‡Принесите 8 мешков с зерном хранителю зерна Каю.‡Bringt Getreidefürst Kai 8 Säcke Getreide zurück.‡곡물군주 카이에게 곡물 자루 8개를 가져다주어야 합니다. 레벨 15 네 바람의 계곡‡Lleva 8 sacos de grano al señor del grano Kai.‡‡Rapportez 8 Sacs de céréales au Seigneur des grains Kai.‡将8袋谷物带给种粮状元老凯。‡',
  }
},
[30029] = {
  {
    'Traquininhas minúsculos‡Злые проделки‡Kleine miese Diebe‡아주 작은 사기꾼들‡Pequeños chanchulleros‡‡Sales petits fumistes‡玩个小把戏‡',
    nil,
    'Mate 8 Milheiros Travessos. Uma‡Уничтожьте 8 зерновых ловкачей.‡Tötet 8 gerissene Korndiebe.‡교활한 옥수수 요마 8마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 8 recolectores de maíz peliagudos.‡‡Tuez 8 Maïs farceurs.‡杀死8只狡猾的玉蜀黍窃贼。‡',
  }
},
[30030] = {
  {
    'Querida, estiquei o duende‡Духоборство‡Geistlos‡요마 처치‡Agárrame esos duendes‡‡Chéri, j’ai agrandi le lutin‡斩草除根‡',
    nil,
    'Derrote Milhonan, o Bárbaro Cevante. Uma‡Победите Зерноеда Истребителя Ячменя.‡Besiegt Kornan den Bierbaren.‡보리의 야만전사 코르난을 처치해야 합니다. 레벨 15 네 바람의 계곡‡Derrota a Cornan el Bárbaro de la Cebada.‡‡Tuez Cornan l’Orge de Barbarie.‡打败大麦蛮人科尔南。‡',
  }
},
[30031] = {
  {
    'A degustação‡Дегустация‡Geschmacksprobe‡곡물 시식‡Cata de granos‡‡Chevalier du Tastegrain‡尝味‡',
    nil,
    'Prove o Grão Envelhecido, o Grão Leve, o Grão Fresco e o Grão Maltado. Uma‡Попробуйте лежалое зерно, легкое зерно, свежее зерно и солодовое зерно. задание.‡Kostet vom reifen Getreide, hellen Getreide, frischen Getreide und vermälzten Getreide.‡오래된 곡물, 가벼운 곡물, 신선한 곡물, 맥아를 첨가한 곡물을 맛봐야 합니다. 레벨 15 네 바람의 계곡‡Prueba el grano añejo, el grano ligero, el grano fresco y el grano malteado.‡‡Goûtez les Céréales vieillies, les Céréales légères, les Céréales fraîches et les Céréales maltées.‡品尝陈年谷物、轻质谷物、新鲜谷物和发芽的谷物。‡',
  }
},
[30032] = {
  {
    'Em busca da cevada perfeita‡В поисках идеального ячменя‡Die Suche nach dem süßen Getreide‡더 좋은 맥아를 찾아서‡En busca de una cebada mejor‡‡À la recherche de la nouvelle orge‡寻找更好的大麦‡',
    nil,
    'Encontre a Cevada Maltada das Cavernas na base da Beirada do Vento. Uma‡Найдите солодовый ячмень в Крае ветров.‡Findet die vermälzte Höhlengerste am Fuße der Windschneide.‡바람의 절벽 지하에서 맥아를 첨가한 동굴 보리를 찾아야 합니다. 레벨 15 네 바람의 계곡‡Encuentra la cebada cavernaria malteada al pie del Acantilado del Céfiro.‡‡Trouvez l’Orge maltée des cavernes au pied de l’Arête des Vents.‡去风之崖的崖底找到发芽的岩洞大麦。‡',
  }
},
[30033] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Recupere uma Lâmina Enfeitiçada do Discípulo e um Leque de Aprendiz e equipe-se com eles. Uma‡Получите чародейский клинок ученика и веер ученика.‡Nehmt Euch eine Schülerzauberklinge und einen Schülerfächer und legt sie an.‡수련생의 마법검과 수련생의 부채를 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa hoja de hechizo de alumno y un abanico de mano de alumno.‡‡Procurez-vous une Sorcelame de recrue et équipez-vous-en.‡拾取并装备徒弟的法刃和徒弟的扇子。‡',
  }
},
[30034] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Pegue uma Besta do Discípulo e equipe-se com ela. Uma‡Получите арбалет ученика и возьмите его в руки.‡Nehmt Euch eine Schülerarmbrust und legt sie an.‡수련생의 석궁을 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa una ballesta de alumno.‡‡Procurez-vous une Arbalète de recrue et équipez-vous-en.‡拾取并装备一把徒弟的弩。‡',
  }
},
[30035] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Pegue uma Maça do Discípulo e um Livro de Orações do Discípulo e equipe-se com eles. Uma‡Получите палицу ученика и книгу молитв для учеников и возьмите их.‡Nehmt Euch einen Schülerstreitkolben und ein Schülergebetsbuch und legt sie an.‡수련생의 철퇴와 수련생의 기도문을 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa una maza de alumno y un breviario de alumno.‡‡Procurez-vous une Masse de recrue et un Livre de prières de recrue, puis équipez-vous-en.‡拾取并装备一把徒弟的钉头锤和一本徒弟的祈祷书。‡',
  }
},
[30036] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Pegue duas Adagas do Discípulo e equipe-se com elas. Uma‡Получите пару кинжалов ученика и возьмите их.‡Nehmt Euch ein Paar Schülerdolche und legt sie an.‡수련생의 단검을 두 개 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa un par de dagas de alumno.‡‡Procurez-vous une paire de Dagues de recrue et équipez-vous-en.‡拾取并装备一对徒弟的匕首。‡',
  }
},
[30037] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Pegue um Machado do Discípulo e um Escudo do Discípulo e equipe-se com eles. Uma‡Получите топор ученика и щит ученика и возьмите их.‡Nehmt Euch eine Schüleraxt und einen Schülerschild und legt sie an.‡수련생의 도끼와 수련생의 방패를 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa un hacha de alumno y un escudo de alumno.‡‡Procurez-vous une Hache de recrue et un Bouclier de recrue, puis équipez-vous-en.‡拾取并装备一把徒弟的斧子和一面徒弟的盾牌。‡',
  }
},
[30038] = {
  {
    'A lição do galho de ferro‡Урок железной ветви‡Die Lektion des Eisenasts‡무쇠 가지의 가르침‡La lección de la rama de acero‡‡La leçon du rameau de fer‡武装训练‡',
    nil,
    'Pegue um Machado do Discípulo e um Escudo do Discípulo e equipe-se com eles. Uma‡Найдите топор и щит ученика и возьмите их в руки.‡Nehmt Euch eine Schüleraxt und einen Schülerschild und legt sie an.‡수련생의 도끼와 수련생의 방패를 획득한 후 장착해야 합니다. 레벨 1 유랑도‡Coge y equipa un hacha de aprendiz y un escudo de aprendiz.‡‡Procurez-vous une Hache de recrue et un Bouclier de recrue, puis équipez-vous-en.‡拾取并装备一把徒弟的斧子和一面徒弟的盾牌。‡',
  }
},
[30039] = {
  {
    'Muito a aprender‡Начало пути‡Viel zu lernen‡머나먼 배움의 길‡Mucho por aprender‡‡Beaucoup à apprendre‡‡',
    nil,
    'Fale com o Mestre Shang Xi. Uma‡Поговорите с мастером Шан Си.‡Sprecht mit Meister Shang Xi.‡사부 샹 시와 대화해야 합니다. 레벨 1 유랑도‡Habla con el maestro Shang Xi.‡‡Parlez à Maître Shang Xi.‡‡',
