[24812] = {
  {
    'Chega de não fazer nada!‡Пощады не будет‡Keine Gnade mehr‡더는 자비란 없다‡Sin piedad‡Sin piedad‡Plus de pitié‡不再怜悯‡不再留情',
    nil,
    'Mate 12 Nagas Escamas Odiosas.‡Убейте 12 наг Злобной Чешуи.‡Tötet 12 Gallschuppennaga.‡원한비늘 나가 12마리를 처치해야 합니다.‡Mata a 12 nagas Escama Maliciosa.‡Mata a 12 nagas Escama Maliciosa.‡Tuer 12 Nagas Vexécailles‡杀死12个恶鳞纳迦。‡殺死12個惡鱗納迦。',
  }
},
[24813] = {
  {
    'Fetiche territorial‡Территориальный амулет‡Territorialer Fetisch‡영토의 우상‡Fetiche territorial‡Fetiche territorial‡Les fétiches territoriaux‡领土神像‡土地神像',
    nil,
    'Coloque 8 Fetiches Territoriais nas bandeiras das Escamas Odiosas.‡Разместите 8 территориальных амулетов на флагах Злобной Чешуи.‡Platziert 8 Territorialfetische auf Gallschuppenflaggen.‡원한비늘 깃발에 영토의 우상 8개를 꽂아야 합니다.‡Coloca 8 fetiches territoriales en las banderas Escama Maliciosa.‡Coloca 8 fetiches territoriales en las banderas Escama Maliciosa.‡Placez 8 Fétiches territoriaux sur les Drapeaux Vexécailles.‡在恶鳞纳迦的旗帜上放置8个领土神像。‡將8個土地神像放置在惡鱗旗幟上。',
  }
},
[24814] = {
  {
    'Uma antiga inimiga‡Древний враг‡Ein uralter Feind‡고대의 적‡Viejos enemigos‡Viejos enemigos‡Une ancienne ennemie‡古老的宿敌‡古老的敵人',
    nil,
    'Fale com Vol\'jin no Covil dos Escamas Odiosas e ajude-o a matar Zar\'jira, a Bruxa do Mar.‡Поговорите с Вол\'джином в гроте Злобной Чешуи и помогите ему убить морскую ведьму Зар\'джиру.‡Sprecht mit Vol\'Jin in der Bucht der Gallschuppen und helft ihm, Zar\'jira die Seehexe zu töten.‡원한비늘 만에 있는 볼진과 대화하고 자르지라를 처치하는 일을 도와야 합니다.‡Habla con Vol\'jin en la Cala Escama Maliciosa y ayúdale a matar a la Bruja del Mar Zar\'jira.‡Habla con Vol\'jin en la Cala Escama Maliciosa y ayúdale a matar a la Bruja del Mar Zar\'jira.‡Parlez à Vol\'jin à la Crique des Vexécaille et aidez-le à tuer Zar’jira, la Sorcière des mers.‡与恶鳞海湾内的沃金交谈，协助他杀死海巫扎尔吉拉。‡到惡鱗灣找沃金說話，並協助他殺死海巫札爾基拉。',
  }
},
[24815] = {
  {
    'Escolha o seu caminho‡Выбери свой путь‡Wählt Euren Weg‡선택의 기로‡Elige tu camino‡Elige tu camino‡Choisissez votre voie‡道路的选择‡擇你所向',
    nil,
    nil,
