[32583] = {
  {
    'Zandalari em ascensão‡Зандалары на подъеме‡Der Aufstieg der Zandalari‡잔달라의 봉기‡Los Zandalari renacen‡‡Un Zandalari au sommet‡赞达拉的崛起‡',
