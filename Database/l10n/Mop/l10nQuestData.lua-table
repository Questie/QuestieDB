[28789] = {
  {
    'Vila Norte precisa de você‡В бой!‡Stürzt Euch in die Schlacht!‡전투에 참전하라!‡¡Únete a la batalla!‡¡Únete a la batalla!‡Rejoignez la bataille !‡加入战斗！‡加入戰局!',
