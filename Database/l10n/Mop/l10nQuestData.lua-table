    nil,
  }
},
[8687] = {
  {
    'Alvo: escavadores da Colme\'Zora‡Цель: копатели из Улья Зора‡Ziel: Tunnelgräber des Zoraschwarms‡목표: 땅꾼 하이브조라‡Objetivo: los tuneladores de Colmen\'Zora‡Objetivo: los tuneladores de Colmen\'Zora‡Objectif : les tunnelières de la Ruche\'Zora‡目标：佐拉坑道蝎‡目標:佐拉坑道蠍',
    nil,
    'Mate 30 Escavadores da Colme\'Zora e fale novamente com o Comandante Mar\'alith no Forte Cenariano, que fica em Silithus. Você também precisa entregar as Instruções de Combate VII para concluir a missão.‡Убейте 30 копателей из улья Зора и доложите о выполнении задания командору Мар\'алиту в крепости Кенария в Силитусе. Для завершения задания принесите боевую задачу VII.‡Tötet 30 Tunnelgräber des Zoraschwarms und erstattet anschließend Bericht bei Kommandant Mar\'alith auf Burg Cenarius in Silithus. Ihr benötigt auch Kampfeinsatz VII, um diese Aufgabe abschließen zu können.‡땅꾼 하이브조라 30마리를 해치운 다음 실리더스 세나리온 요새에 있는 지휘관 마랄리스에게 보고해야 합니다. 또한, 이 퀘스트를 완료하려면 전투 임무 지령 VII도 함께 가져가야 합니다.‡Mata 30 tuneladores de Colmen\'Zora y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate VII para poder completar la misión.|n‡Mata 30 tuneladores de Colmen\'Zora y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate VII para poder completar la misión.|n‡Tuez 30 Tunnelières de la Ruche\'Zora puis présentez-vous au rapport devant le commandant Mar\'alith au Fort cénarien en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing de combat VII.‡击杀30只佐拉坑道蝎，然后向塞纳里奥要塞的指挥官玛尔利斯复命。你还必须带着作战任务简报 VII才能完成这个任务。‡殺死30隻佐拉坑道蠍並回希利蘇斯向塞納里奧城堡的指揮官瑪爾利斯回報。你還必須將作戰任務簡報 VII帶去才能完成這個任務。',
  }
},
[8688] = {
  {
    'Andavento, o Ancião‡Предок Вестник Ветров‡Urahne Windflucht‡장로 윈드런‡Fuerteviento el Ancestro‡Fuerteviento el Ancestro‡L\'Ancien Tracevent‡风路长者‡風行長者',
    nil,
    nil,
  }
},
[8689] = {
  {
    'Mortalha da Sabedoria Infinita‡Накидка бесконечной мудрости‡Schleier der unendlichen Weisheit‡무한한 지혜의 외투‡El embozo de sabiduría infinita‡El embozo de sabiduría infinita‡Le voile de sagesse infinie‡无尽智慧披风‡無盡智慧罩氅',
    nil,
    'Leve 1 Clâmide Marcial Qiraji, 2 Ídolos de Jaspe, 5 Escaravelhos de Ouro e 5 Escaravelhos de Barro para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую воинскую пелерину, 2 яшмовых идола, 5 золотых и 5 глиняных скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Kampftuch der Qiraji, 2 Jaspisgötzen, 5 Goldskarabäen und 5 Tonskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 전쟁의 퀴라지 망토 1개, 벽옥 우상 2개, 황금 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón marcial qiraji, 2 ídolos de jaspe, 5 escarabajos de oro y 5 escarabajos de terracota a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón marcial qiraji, 2 ídolos de jaspe, 5 escarabajos de oro y 5 escarabajos de terracota a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé martial qiraji, 2 Idoles de jaspe, 5 Scarabées d\'or et 5 Scarabées d\'argile à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉军用披风、2个翠玉雕像、5个黄金甲虫和5个陶土甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉軍用披氅、2個翠玉塑像、5隻金色甲蟲和5隻泥土甲蟲給希利蘇斯的凱伊·迅爪。你還需要在塞納里奧議會達到崇敬聲望值才能完成此項任務。',
  }
},
[8690] = {
  {
    'Manto da Tempestade Iminente‡Плащ надвигающейся бури‡Umhang der aufziehenden Stürme‡휘몰아치는 폭풍의 망토‡La capa de la tormenta inminente‡La capa de la tormenta inminente‡La cape de la tempête imminente‡聚集风暴披风‡聚集風暴披風',
    nil,
    'Leve 1 Clâmide Régia Qiraji, 2 Ídolos Obsidianos, 5 Escaravelhos de Barro e 5 Escaravelhos de Ouro para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую царскую пелерину, 2 обсидиановых идола, 5 глиняных и 5 золотых скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Hoheitstuch der Qiraji, 2 Obsidiangötzen, 5 Tonskarabäen und 5 Goldskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 제왕의 퀴라지 망토 1개, 흑요석 우상 2개, 찰흙 스카라베 5개, 황금 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón qiraji regio, 2 ídolos de obsidiana, 5 escarabajos de terracota y 5 escarabajos de oro a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón qiraji regio, 2 ídolos de obsidiana, 5 escarabajos de terracota y 5 escarabajos de oro a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé royal qiraji, 2 Idoles d\'obsidienne, 5 Scarabées d\'argile et 5 Scarabées d\'or à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉帝王披风、2个黑曜石雕像、5个陶土甲虫和5个黄金甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉帝王披氅、2個黑曜石塑像、5隻泥土甲蟲和5隻金色甲蟲給希利蘇斯的凱伊·迅爪。同時你必須在塞納里奧議會達到崇敬聲望值才能完成這項任務。',
  }
},
[8691] = {
  {
    'Clâmide dos Segredos Obscuros‡Пелерина погребенных тайн‡Tuch der behüteten Geheimnisse‡밝혀진 비밀의 망토‡El mantón de secretos oscuros‡El mantón de secretos oscuros‡Le drapé des secrets scellés‡魔法秘密披风‡魔法秘密披氅',
    nil,
    'Leve 1 Clâmide Marcial Qiraji, 2 Ídolos de Alabastro, 5 Escaravelhos de Pedra e 5 Escaravelhos de Cristal para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую воинскую пелерину, 2 алебастровых идола, 5 каменных и 5 хрустальных скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Kampftuch der Qiraji, 2 Alabastergötzen, 5 Steinskarabäen und 5 Kristallskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 전쟁의 퀴라지 망토 1개, 설화석 우상 2개, 돌 스카라베 5개, 수정 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón marcial qiraji, 2 ídolos de alabastro, 5 escarabajos de piedra y 5 escarabajos de cristal a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón marcial qiraji, 2 ídolos de alabastro, 5 escarabajos de piedra y 5 escarabajos de cristal a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé martial qiraji, 2 Idoles d\'albâtre, 5 Scarabées de pierre et 5 Scarabées de cristal à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉军用披风、2个雪白雕像、5个岩石甲虫和5个水晶甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉軍用披氅、2個雪白塑像、5隻石甲蟲和5隻水晶甲蟲給希利蘇斯的凱伊·迅爪。你還需要在塞納里奧議會達到崇敬聲望才能完成這個任務。',
  }
},
[8692] = {
  {
    'Manto da Vida Interminável‡Плащ бесконечной жизни‡Umhang des endlosen Lebens‡영원한 삶의 망토‡Capa de vida inagotable‡Capa de vida inagotable‡La cape de vie interminable‡不灭生命披风‡不滅生命披風',
    nil,
    'Leve 1 Clâmide Régia Qiraji, 2 Ídolos Vermelhos, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую царскую пелерину, 2 гранатовых идола, 5 серебряных и 5 костяных скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Hoheitstuch der Qiraji, 2 Zinnobergötzen, 5 Silberskarabäen und 5 Knochenskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 제왕의 퀴라지 망토 1개, 단사 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón qiraji regio, 2 ídolos bermellones, 5 escarabajos de plata y 5 escarabajos de hueso a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón qiraji regio, 2 ídolos bermellones, 5 escarabajos de plata y 5 escarabajos de hueso a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé royal qiraji, 2 Idoles vermillon, 5 Scarabées d\'argent et 5 Scarabées d\'os à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉帝王披风、2个朱红雕像、5个银质甲虫和5个白骨甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉帝王披氅、2個朱紅塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的凱伊·迅爪。同時你必須在塞納里奧議會達到崇敬聲望值才能完成這項任務。',
  }
},
[8693] = {
  {
    'Manto das Sombras Veladas‡Плащ сокрытых теней‡Umhang der Schattenschleier‡어두운 그림자의 망토‡La capa de las sombras ocultas‡La capa de las sombras ocultas‡La cape des ombres voilées‡笼罩阴影披风‡朦朧之影披風',
    nil,
    'Leve 1 Clâmide Marcial Qiraji, 2 Ídolos Lazúli, 5 Escaravelhos de Bronze e 5 Escaravelhos de Marfim para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую воинскую пелерину, 2 лазурных идола, 5 бронзовых скарабеев и 5 скарабеев из бивневой кости Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Kampftuch der Qiraji, 2 Azurgötzen, 5 Bronzeskarabäen und 5 Elfenbeinskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 전쟁의 퀴라지 망토 1개, 청금석 우상 2개, 청동 스카라베 5개, 상아 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón marcial qiraji, 2 ídolos azures, 5 escarabajos de bronce y 5 escarabajos de marfil a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón marcial qiraji, 2 ídolos azures, 5 escarabajos de bronce y 5 escarabajos de marfil a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé martial qiraji, 2 Idoles azur, 5 Scarabées en bronze et 5 Scarabées d\'ivoire à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉军用披风、2个碧蓝雕像、5个青铜甲虫和5个象牙甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉軍用披氅、2個蒼藍塑像、5隻青銅甲蟲和5隻象牙甲蟲給希利蘇斯的凱伊·迅爪。你還需要在塞納里奧議會達到崇敬聲望才能完成這個任務。',
  }
},
[8694] = {
  {
    'Mortalha dos Nomes Proibidos‡Накидка неназванных имен‡Schleier der ungesagten Namen‡절대자의 망토‡El embozo de los nombres prohibidos‡El embozo de los nombres prohibidos‡Le voile des noms inexprimés‡禁断邪语披风‡禁斷邪語罩氅',
    nil,
    'Leve 1 Clâmide Régia Qiraji, 2 Ídolos Âmbar, 5 Escaravelhos de Marfim e 5 Escaravelhos de Bronze para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую царскую пелерину, 2 янтарных идола, 5 скарабеев из бивневой кости и 5 бронзовых скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Hoheitstuch der Qiraji, 2 Bernsteingötzen, 5 Elfenbeinskarabäen und 5 Bronzeskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 제왕의 퀴라지 망토 1개, 호박석 우상 2개, 상아 스카라베 5개, 청동 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón qiraji regio, 2 ídolos de ámbar, 5 escarabajos de marfil y 5 escarabajos de bronce a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón qiraji regio, 2 ídolos de ámbar, 5 escarabajos de marfil y 5 escarabajos de bronce a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé royal qiraji, 2 Idoles d\'ambre, 5 Scarabées d\'ivoire et 5 Scarabées en bronze à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête‡将1件其拉帝王披风、2个琥珀雕像、5个象牙甲虫和5个青铜甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉帝王披氅、2個琥珀塑像、5隻象牙甲蟲和5隻青銅甲蟲給希利蘇斯的凱伊·迅爪。同時你必須在塞納里奧議會達到崇敬聲望值才能完成這項任務。',
  }
},
[8695] = {
  {
    'Capa da Justiça Eterna‡Накидка вечной справедливости‡Cape der ewigen Gerechtigkeit‡영원한 정의의 망토‡El manteo de Justicia eterna‡El manteo de Justicia eterna‡La cape de justice éternelle‡永恒公正斗篷‡永恆公正斗篷',
    nil,
    'Leve 1 Clâmide Régia Qiraji, 2 Ídolos Obsidianos, 5 Escaravelhos de Ouro e 5 Escaravelhos de Barro para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую царскую пелерину, 2 обсидиановых идола, 5 золотых и 5 глиняных скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Hoheitstuch der Qiraji, 2 Obsidiangötzen, 5 Goldskarabäen und 5 Tonskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 제왕의 퀴라지 망토 1개, 흑요석 우상 2개, 황금 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón qiraji regio, 2 ídolos de obsidiana, 5 escarabajos de oro y 5 escarabajos de terracota a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón qiraji regio, 2 ídolos de obsidiana, 5 escarabajos de oro y 5 escarabajos de terracota a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apportez 1 Drapé royal qiraji, 2 Idoles d\'obsidienne, 5 Scarabées d\'or et 5 Scarabées d\'argile à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉帝王披风、2个黑曜石雕像、5个黄金甲虫和5个陶土甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉帝王披氅、2個黑曜石塑像、5隻金色甲蟲和5隻泥土甲蟲給希利蘇斯的凱伊·迅爪。同時你必須在塞納里奧議會達到崇敬聲望值才能完成這項任務。',
  }
},
[8696] = {
  {
    'Manto do Caminho Oculto‡Плащ незримого пути‡Umhang des unsichtbaren Pfads‡선도자의 망토‡La capa de la senda oculta‡La capa de la senda oculta‡La cape du sentier invisible‡隐秘通途披风‡隱秘通途披風',
    nil,
    'Leve 1 Clâmide Régia Qiraji, 2 Ídolos Bruxuleantes, 5 Escaravelhos de Pedra e 5 Escaravelhos de Cristal para Keyl Garralesta em Silithus. Também é necessário ser Reverenciado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую царскую пелерину, 2 лучистых идола, 5 каменных и 5 хрустальных скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Hoheitstuch der Qiraji, 2 züngelnde Götzen, 5 Steinskarabäen und 5 Kristallskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 제왕의 퀴라지 망토 1개, 미명석 우상 2개, 돌 스카라베 5개, 수정 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 평판도 얻어야 합니다.‡Llévale 1 mantón qiraji regio, 2 ídolos luminiscentes, 5 escarabajos de piedra y 5 escarabajos de cristal a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón qiraji regio, 2 ídolos luminiscentes, 5 escarabajos de piedra y 5 escarabajos de cristal a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé royal qiraji, 2 Idoles diaprées, 5 Scarabées de pierre et 5 Scarabées de cristal à Keyl Vivegriffe, en Silithus. Vous devrez aussi être Révéré par le Cercle cénarien pour terminer cette quête.‡将1件其拉帝王披风、2个柔光雕像、5个岩石甲虫和5个水晶甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉帝王披氅、2個柔光塑像、5隻石甲蟲和5隻水晶甲蟲給希利蘇斯的凱伊·迅爪。同時你必須在塞納里奧議會達到崇敬聲望值才能完成任務。',
  }
},
[8697] = {
  {
    'Anel da Sabedoria Infinita‡Кольцо бесконечной мудрости‡Ring der unendlichen Weisheit‡무한한 지혜의 반지‡El anillo de sabiduría infinita‡El anillo de sabiduría infinita‡L\' anneau de sagesse infinie‡无尽智慧之戒‡無盡智慧之戒',
    nil,
    'Leve 1 Anel Cerimonial Qiraji, 2 Ídolos Obsidianos, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское церемониальное кольцо, 2 обсидиановых идола, 5 серебряных и 5 костяных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Zeremonienring der Qiraji, 2 Obsidiangötzen, 5 Silberskarabäen und 5 Knochenskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 의식의 퀴라지 반지 1개, 흑요석 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 평판을 얻어야 합니다.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de obsidiana, 5 escarabajos de plata y 5 escarabajos de hueso a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de obsidiana, 5 escarabajos de plata y 5 escarabajos de hueso a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de cérémonie qiraji, 2 Idoles d\'obsidienne, 5 Scarabées d\'argent et 5 Scarabées d\'os à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉典礼戒指、2个黑曜石雕像、5个银质甲虫和5个白骨甲虫交给唤风者耶萨德拉。你必须在塞纳里奥议会中达到尊敬声望才能完成这个任务。‡帶1枚其拉典禮戒指、2個黑曜石塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8698] = {
  {
    'Anel da Tempestade Iminente‡Кольцо надвигающейся бури‡Ring der aufziehenden Stürme‡휘몰아치는 폭풍의 반지‡El anillo de la tormenta inminente‡El anillo de la tormenta inminente‡L\'anneau de la tempête imminente‡聚集风暴之戒‡聚集風暴之戒',
    nil,
    'Leve 1 Anel Magistral Qiraji, 2 Ídolos Vermelhos, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское кольцо власти, 2 гранатовых идола, 5 серебряных и 5 костяных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Gebieterring der Qiraji, 2 Zinnobergötzen, 5 Silberskarabäen und 5 Knochenskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 권위의 퀴라지 반지 1개, 단사 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 평판을 얻어야 합니다.‡Llévale 1 anillo qiraji magistral, 2 ídolos bermellones, 5 escarabajos de plata y 5 escarabajos de hueso a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo qiraji magistral, 2 ídolos bermellones, 5 escarabajos de plata y 5 escarabajos de hueso a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de magistrat qiraji, 2 Idoles vermillon, 5 Scarabées d\'argent et 5 Scarabées d\'os à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉将领戒指、2个朱红雕像、5个银质甲虫和5个白骨甲虫交给唤风者耶萨德拉。‡帶1枚其拉將領戒指、2個朱紅塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8699] = {
  {
    'Anel dos Segredos Obscuros‡Кольцо погребенных тайн‡Band der behüteten Geheimnisse‡밝혀진 비밀의 고리‡La sortija de secretos oscuros‡La sortija de secretos oscuros‡La bague des secrets scellés‡魔法秘密之戒‡魔法秘密指環',
    nil,
    'Leve 1 Anel Magistral Qiraji, 2 Ídolos Lazúli, 5 Escaravelhos de Ouro e 5 Escaravelhos de Barro para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское кольцо власти, 2 лазурных идола, 5 золотых и 5 глиняных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Gebieterring der Qiraji, 2 Azurgötzen, 5 Goldskarabäen und 5 Tonskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 권위의 퀴라지 반지 1개, 청금석 우상 2개, 황금 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 평판을 얻어야 합니다.‡Llévale 1 anillo qiraji magistral, 2 ídolos azures, 5 escarabajos de oro y 5 escarabajos de terracota a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo qiraji magistral, 2 ídolos azures, 5 escarabajos de oro y 5 escarabajos de terracota a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de magistrat qiraji, 2 Idoles azur, 5 Scarabées d\'or et 5 Scarabées d\'argile à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉将领戒指、2个碧蓝雕像、5个黄金甲虫和5个陶土甲虫交给唤风者耶萨德拉。‡帶1枚其拉將領戒指、2個蒼藍塑像、5隻金色甲蟲和5隻泥土甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8700] = {
  {
    'Anel da Vida Interminável‡Кольцо бесконечной жизни‡Band des endlosen Lebens‡영원한 삶의 고리‡La sortija de vida inagotable‡La sortija de vida inagotable‡La bague de vie interminable‡不灭生命之戒‡不滅生命指環',
    nil,
    'Leve 1 Anel Magistral Qiraji, 2 Ídolos de Alabastro, 5 Escaravelhos de Bronze e 5 Escaravelhos de Marfim para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское кольцо власти, 2 алебастровых идола, 5 бронзовых скарабеев и 5 скарабеев из бивневой кости Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Gebieterring der Qiraji, 2 Alabastergötzen, 5 Bronzeskarabäen und 5 Elfenbeinskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 권위의 퀴라지 반지 1개, 설화석 우상 2개, 청동 스카라베 5개, 상아 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회로부터 우호적 이상의 평판을 얻어야 합니다.‡Llévale 1 anillo qiraji magistral, 2 ídolos de alabastro, 5 escarabajos de bronce y 5 escarabajos de marfil a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo qiraji magistral, 2 ídolos de alabastro, 5 escarabajos de bronce y 5 escarabajos de marfil a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de magistrat qiraji, 2 Idoles d\'albâtre, 5 Scarabées en bronze et 5 Scarabées d\'ivoire à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉将领戒指、2个雪白雕像、5个青铜甲虫和5个象牙甲虫交给唤风者耶萨德拉。你必须在塞纳里奥议会中达到尊敬声望才能完成这个任务。‡帶1枚其拉將領戒指、2個雪白塑像、5隻青銅甲蟲和5隻象牙甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8701] = {
  {
    'Anel das Sombras Veladas‡Кольцо сокрытых теней‡Band der Schattenschleier‡어두운 그림자의 고리‡La sortija de las sombras ocultas‡La sortija de las sombras ocultas‡La bague des ombres voilées‡笼罩阴影之戒‡朦朧之影指環',
    nil,
    'Leve 1 Anel Cerimonial Qiraji, 2 Ídolos Ônix, 5 Escaravelhos de Pedra e 5 Escaravelhos de Cristal para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское церемониальное кольцо, 2 ониксовых идола, 5 каменных и 5 хрустальных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Zeremonienring der Qiraji, 2 Onyxgötzen, 5 Steinskarabäen und 5 Kristallskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 의식의 퀴라지 반지 1개, 마노 우상 2개, 돌 스카라베 5개, 수정 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 평판을 얻어야 합니다.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de ónice, 5 escarabajos de piedra y 5 escarabajos de cristal a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de ónice, 5 escarabajos de piedra y 5 escarabajos de cristal a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de cérémonie qiraji, 2 Idoles d\'onyx, 5 Scarabées de pierre et 5 Scarabées de cristal à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉葬礼戒指、2个玛瑙雕像、5个岩石甲虫和5个水晶甲虫交给唤风者耶萨德拉。‡帶1枚其拉典禮戒指、2個黑瑪瑙塑像、5隻石甲蟲和5隻水晶甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8702] = {
  {
    'Anel dos Nomes Proibidos‡Кольцо неназванных имен‡Ring der ungesagten Namen‡절대자의 반지‡El anillo de los nombres prohibidos‡El anillo de los nombres prohibidos‡L\'anneau des noms inexprimés‡禁断邪语之戒‡禁斷邪語之戒',
    nil,
    'Leve 1 Anel Cerimonial Qiraji, 2 Ídolos de Jaspe, 5 Escaravelhos de Pedra e 5 Escaravelhos de Cristal para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское церемониальное кольцо, 2 яшмовых идола, 5 каменных и 5 хрустальных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Zeremonienring der Qiraji, 2 Jaspisgötzen, 5 Steinskarabäen und 5 Kristallskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 의식의 퀴라지 반지 1개, 벽옥 우상 2개, 돌 스카라베 5개, 수정 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 평판을 얻어야 합니다.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de jaspe, 5 escarabajos de piedra y 5 escarabajos de cristal a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de jaspe, 5 escarabajos de piedra y 5 escarabajos de cristal a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de cérémonie qiraji, 2 Idoles de jaspe, 5 Scarabées de pierre et 5 Scarabées de cristal à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉葬礼戒指、2个翠玉雕像、5个岩石甲虫和5个水晶甲虫交给唤风者耶萨德拉。‡帶1枚其拉典禮戒指、2個翠玉塑像、5隻石甲蟲和5隻水晶甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8703] = {
  {
    'Anel da Justiça Eterna‡Кольцо вечной справедливости‡Ring der ewigen Gerechtigkeit‡영원한 정의의 반지‡El anillo de justicia eterna‡El anillo de justicia eterna‡L\'anneau de justice éternelle‡永恒公正之戒‡永恆公正之戒',
    nil,
    'Leve 1 Anel Magistral Qiraji, 2 Ídolos Vermelhos, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское кольцо власти, 2 гранатовых идола, 5 серебряных и 5 костяных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Gebieterring der Qiraji, 2 Zinnobergötzen, 5 Silberskarabäen und 5 Knochenskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 권위의 퀴라지 반지 1개, 단사 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회로부터 우호적 이상의 평판을 얻어야 합니다.‡Llévale 1 anillo qiraji magistral, 2 ídolos bermellones, 5 escarabajos de plata y 5 escarabajos de hueso a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo qiraji magistral, 2 ídolos bermellones, 5 escarabajos de plata y 5 escarabajos de hueso a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de magistrat qiraji, 2 Idoles vermillon, 5 Scarabées d\'argent et 5 Scarabées d\'os à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉将领戒指、2个朱红雕像、5个银质甲虫和5个白骨甲虫交给唤风者耶萨德拉。你必须在塞纳里奥议会中达到尊敬声望才能完成这个任务。‡帶1枚其拉將領戒指、2個朱紅塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8704] = {
  {
    'Sinete do Caminho Oculto‡Перстень незримого пути‡Siegel des unsichtbaren Pfads‡보이지 않는 길의 인장‡El sello de la senda oculta‡El sello de la senda oculta‡La chevalière du sentier invisible‡隐秘通途之戒‡隱秘通途之戒',
    nil,
    'Leve 1 Anel Cerimonial Qiraji, 2 Ídolos Âmbar, 5 Escaravelhos de Ouro e 5 Escaravelhos de Barro para a Arauto do Vento Yessendra em Silithus. Também é necessário ser Honrado pelo Círculo Cenariano para concluir a missão.‡Принесите киражское церемониальное кольцо, 2 янтарных идола, 5 золотых и 5 глиняных скарабеев Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Gebieterring der Qiraji, 2 Bernsteingötzen, 5 Goldskarabäen und 5 Tonskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 의식의 퀴라지 반지 1개, 호박석 우상 2개, 황금 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 이상의 평판을 얻어야 합니다.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de ámbar, 5 escarabajos de oro y 5 escarabajos de terracota a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo ceremonial qiraji, 2 ídolos de ámbar, 5 escarabajos de oro y 5 escarabajos de terracota a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de cérémonie qiraji, 2 Idoles d\'ambre, 5 Scarabées d\'or et 5 Scarabées d\'argile à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être Honoré par le Cercle cénarien pour terminer cette quête.‡将1枚其拉典礼戒指、2个琥珀雕像、5个黄金甲虫和5个陶土甲虫交给唤风者耶萨德拉。你必须在塞纳里奥议会中达到尊敬声望才能完成这个任务。‡帶1枚其拉典禮戒指、2個琥珀塑像、5隻金色甲蟲和5隻泥土甲蟲給希利蘇斯的喚風者耶薩德拉。同時你必須在塞納里奧議會達到尊敬聲望值才能完成這項任務。',
  }
},
[8705] = {
  {
    'Martelete da Sabedoria Infinita‡Чекан беспредельной мудрости‡Hammer der unendlichen Weisheit‡무한한 지혜의 망치‡El mazo de sabiduría infinita‡El mazo de sabiduría infinita‡Le martelet de sagesse infinie‡无尽智慧之锤‡無盡智慧裁決槌',
    nil,
    'Leve 1 Punho Ornamentado Qiraji, 2 Ídolos Bruxuleantes, 5 Escaravelhos de Bronze e 5 Escaravelhos de Marfim para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую изысканную рукоять, 2 лучистых идола, 5 бронзовых скарабеев и 5 скарабеев из бивневой кости Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 verschnörkelten Griff der Qiraji, 2 züngelnde Götzen, 5 Bronzeskarabäen und 5 Elfenbeinskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 화려한 퀴라지 자루 1개, 미명석 우상 2개, 청동 스카라베 5개, 상아 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회로부터 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos luminiscentes, 5 escarabajos de bronce y 5 escarabajos de marfil al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos luminiscentes, 5 escarabajos de bronce y 5 escarabajos de marfil al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche orné qiraji, 2 Idoles diaprées, 5 Scarabées en bronze et 5 Scarabées d\'ivoire au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉装饰刀柄、2个柔光雕像、5个青铜甲虫和5个象牙甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉華麗刀柄、2個柔光塑像、5隻青銅甲蟲和5隻象牙甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8706] = {
  {
    'Martelo da Tempestade Iminente‡Молот надвигающейся бури‡Hammer der aufziehenden Stürme‡휘몰아치는 폭풍의 망치‡El martillo de la tormenta inminente‡El martillo de la tormenta inminente‡Le marteau de la tempête imminente‡聚集风暴之锤‡聚集風暴之錘',
    nil,
    'Leve 1 Punho de Pontas Qiraji, 2 Ídolos Âmbar, 5 Escaravelhos de Marfim e 5 Escaravelhos de Bronze para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую шипастую рукоять, 2 янтарных идола, 5 скарабеев из бивневой кости и 5 бронзовых скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 Stachelgriff der Qiraji, 2 Bernsteingötzen, 5 Elfenbeinskarabäen und 5 Bronzeskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 못 박힌 퀴라지 자루 1개, 호박석 우상 2개, 상아 스카라베 5개, 청동 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 puño con pinchos qiraji, 2 ídolos de ámbar, 5 escarabajos de marfil y 5 escarabajos de bronce al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 puño con pinchos qiraji, 2 ídolos de ámbar, 5 escarabajos de marfil y 5 escarabajos de bronce al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche à pointes qiraji, 2 Idoles d\'ambre, 5 Scarabées d\'ivoire et 5 Scarabées en bronze au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉尖刺刀柄、2个琥珀雕像、5个象牙甲虫和5个青铜甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉尖刺刀柄、2個琥珀塑像、5隻象牙甲蟲和5隻青銅甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8707] = {
  {
    'Lâmina dos Segredos Obscuros‡Клинок погребенных тайн‡Klinge der behüteten Geheimnisse‡밝혀진 비밀의 칼날‡La hoja de secretos oscuros‡La hoja de secretos oscuros‡La lame des secrets scellés‡魔法秘密之刃‡魔法秘密之刃',
    nil,
    'Leve 1 Punho Ornamentado Qiraji, 2 Ídolos Obsidianos, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую изысканную рукоять, 2 обсидиановых идола, 5 серебряных и 5 костяных скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 verschnörkelten Griff der Qiraji, 2 Obsidiangötzen, 5 Silberskarabäen und 5 Knochenskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 화려한 퀴라지 자루 1개, 흑요석 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos de obsidiana, 5 escarabajos de plata y 5 escarabajos de hueso al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos de obsidiana, 5 escarabajos de plata y 5 escarabajos de hueso al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche orné qiraji, 2 Idoles d\'obsidienne, 5 Scarabées d\'argent et 5 Scarabées d\'os au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉装饰刀柄、2个黑曜石雕像、5个银质甲虫和5个白骨甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉華麗刀柄、2個黑曜石塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8708] = {
  {
    'Maça da Vida Interminável‡Палица бесконечной жизни‡Streitkolben des endlosen Lebens‡영원한 삶의 철퇴‡La maza de vida inagotable‡La maza de vida inagotable‡La masse de vie interminable‡不灭生命之锤‡不滅生命之錘',
    nil,
    'Leve 1 Punho Ornamentado Qiraji, 2 Ídolos de Jaspe, 5 Escaravelhos de Cristal e 5 Escaravelhos de Pedra para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую изысканную рукоять, 2 яшмовых идола, 5 хрустальных и 5 каменных скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 verschnörkelten Griff der Qiraji, 2 Jaspisgötzen, 5 Kristallskarabäen und 5 Steinskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 화려한 퀴라지 자루 1개, 벽옥 우상 2개, 수정 스카라베 5개, 돌 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos de jaspe, 5 escarabajos de cristal y 5 escarabajos de piedra al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos de jaspe, 5 escarabajos de cristal y 5 escarabajos de piedra al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche orné qiraji, 2 Idoles de jaspe, 5 Scarabées de cristal et 5 Scarabées de pierre au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉装饰刀柄、2个翠玉雕像、5个水晶甲虫和5个岩石甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉華麗刀柄、2個翠玉塑像、5隻水晶甲蟲和5隻石甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8709] = {
  {
    'Adaga das Sombras Veladas‡Кинжал сокрытых теней‡Dolch der Schattenschleier‡어두운 그림자의 단검‡La daga de las sombras ocultas‡La daga de las sombras ocultas‡La dague des ombres voilées‡笼罩阴影匕首‡朦朧之影匕首',
    nil,
    'Leve 1 Punho de Pontas Qiraji, 2 Ídolos Rubros, 5 Escaravelhos de Ouro e 5 Escaravelhos de Barro para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую шипастую рукоять, 2 гранатовых идола, 5 золотых и 5 глиняных скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 Stachelgriff der Qiraji, 2 Zinnobergötzen, 5 Goldskarabäen und 5 Tonskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 못 박힌 퀴라지 자루 1개, 단사 우상 2개, 황금 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 puño con pinchos qiraji, 2 ídolos bermellones, 5 escarabajos de oro y 5 escarabajos de terracota al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 puño con pinchos qiraji, 2 ídolos bermellones, 5 escarabajos de oro y 5 escarabajos de terracota al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche à pointes qiraji, 2 Idoles vermillon, 5 Scarabées d\'or et 5 Scarabées d\'argile au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉尖刺刀柄、2个朱红雕像、5个黄金甲虫和5个陶土甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉尖刺刀柄、2個朱紅塑像、5隻金色甲蟲和5隻泥土甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8710] = {
  {
    'Cris dos Nomes Proibidos‡Крис неназванных имен‡Kris der ungesagten Namen‡절대자의 크리스‡Kris de los nombres prohibidos‡Kris de los nombres prohibidos‡Le kriss des noms inexprimés‡禁断邪语短剑‡禁斷邪語短劍',
    nil,
    'Leve 1 Punho Ornamentado Qiraji, 2 Ídolos Ônix, 5 Escaravelhos de Ouro e 5 Escaravelhos de Barro para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую изысканную рукоять, 2 ониксовых идола, 5 золотых и 5 глиняных скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 verschnörkelten Griff der Qiraji, 2 Onyxgötzen, 5 Goldskarabäen und 5 Tonskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 화려한 퀴라지 자루 1개, 마노 우상 2개, 황금 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos de ónice, 5 escarabajos de oro y 5 escarabajos de terracota al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 empuñadura ornamentada qiraji, 2 ídolos de ónice, 5 escarabajos de oro y 5 escarabajos de terracota al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche orné qiraji, 2 Idoles d\'onyx, 5 Scarabées d\'or et 5 Scarabées d\'argile au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉装饰刀柄、2个玛瑙雕像、5个黄金甲虫和5个陶土甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉華麗刀柄、2個黑瑪瑙塑像、5隻金色甲蟲和5隻泥土甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8711] = {
  {
    'Lâmina da Justiça Eterna‡Клинок вечной справедливости‡Klinge der ewigen Gerechtigkeit‡영원한 정의의 칼날‡La hoja de Justicia eterna‡La hoja de Justicia eterna‡La lame de justice éternelle‡永恒公正长剑‡永恆公正之刃',
    nil,
    'Leve 1 Punho de Pontas Qiraji, 2 Ídolos Âmbar, 5 Escaravelhos de Bronze e 5 Escaravelhos de Marfim para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую шипастую рукоять, 2 янтарных идола, 5 бронзовых скарабеев и 5 скарабеев из бивневой кости Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 Stachelgriff der Qiraji, 2 Bernsteingötzen, 5 Bronzeskarabäen und 5 Elfenbeinskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 못 박힌 퀴라지 자루 1개, 호박석 우상 2개, 청동 스카라베 5개, 상아 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹 평판도 얻어야 합니다.‡Llévale 1 puño con pinchos qiraji, 2 ídolos de ámbar, 5 escarabajos de bronce y 5 escarabajos de marfil al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 puño con pinchos qiraji, 2 ídolos de ámbar, 5 escarabajos de bronce y 5 escarabajos de marfil al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche à pointes qiraji, 2 Idoles d\'ambre, 5 Scarabées en bronze et 5 Scarabées d\'ivoire au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉尖刺刀柄、2个琥珀雕像、5个青铜甲虫和5个象牙甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉尖刺刀柄、2個琥珀塑像、5隻青銅甲蟲和5隻象牙甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
[8712] = {
  {
    'Foice do Caminho Oculto‡Коса незримого пути‡Sense des unsichtbaren Pfads‡선도자의 낫‡La guadaña de la senda oculta‡La guadaña de la senda oculta‡La faux du sentier invisible‡隐秘通途之镰‡隱秘通途之鐮',
    nil,
    'Leve 1 Punho de Pontas Qiraji, 2 Ídolos Lazúli, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para o Guardião Haro em Silithus. Também é necessário ser Exaltado pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую шипастую рукоять, 2 лазурных идола, 5 серебряных и 5 каменных скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 Stachelgriff der Qiraji, 2 Azurgötzen, 5 Silberskarabäen und 5 Knochenskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 못 박힌 퀴라지 자루 1개, 청금석 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판을 얻어야 합니다.‡Llévale 1 puño con pinchos qiraji, 2 ídolos azures, 5 escarabajos de plata y 5 escarabajos de hueso al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 puño con pinchos qiraji, 2 ídolos azures, 5 escarabajos de plata y 5 escarabajos de hueso al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche à pointes qiraji, 2 Idoles azur, 5 Scarabées d\'argent et 5 Scarabées d\'os au Gardien Haro, en Silithus. Vous devrez aussi être Exalté par le Cercle cénarien pour terminer cette quête.‡将1件其拉尖刺刀柄、2个碧蓝雕像、5个银质甲虫和5个白骨甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉尖刺刀柄、2個蒼藍塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的守望者哈爾洛。同時你必須在塞納里奧議會達到崇拜聲望值才能完成這項任務。',
  }
},
