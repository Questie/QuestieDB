},
[2972] = {
  {
    '‡Небольшое возмездие‡Gerechtigkeit üben‡‡La justicia del castigo‡La justicia del castigo‡Justice de châtiment‡菲拉斯的正义‡',
    nil,
    '‡Отнесите перстень-печатку Джер\'Кай верховной жрице Тиранде Шелест Ветра в Дарнасе.‡Bringt Jer\'kais Siegelring zu Hohepriesterin Tyrande Wisperwind nach Darnassus.‡‡Lleva el sello de Jer\'kai a la suma sacerdotisa Tyrande Susurravientos a Darnassus.‡Lleva el sello de Jer\'kai a la suma sacerdotisa Tyrande Susurravientos a Darnassus.‡Apporter la Chevalière de Jer\'kai à la Grande prêtresse Tyrande Murmevent, à Darnassus.‡将耶尔卡的徽记之戒交给达纳苏斯的高阶女祭司泰兰德·语风。‡',
  }
},
[2973] = {
  {
    'Dando um trato na capa‡Новый сверкающий плащ‡Schimmer für einen neuen Umhang‡화려한 새 망토‡El lustre de una nueva capa‡El lustre de una nueva capa‡Une nouvelle cape‡新斗篷的光辉‡新披風的光輝',
    nil,
    'Traga 10 Asas Iridescentes de Dardejantes para Krueg Rachacrânio na Aldeia Mojache.‡Принесите 10 радужных крыльев летучих хамелеонов Кригу Головорубу в Лагерь Мохаче.‡Bringt 10 regenbogenfarbene Grimmlingflitzerflügel zu Krueg Schädelspalter nach Camp Mojache.‡모자케 야영지에 있는 크루엑 스컬스플리터에게 오색 화살요정용 날개 10개를 가져가야 합니다.‡Lleva 10 alas de duende dardo iridiscente a Krueg Machacacráneos al Campamento Mojache.‡Lleva 10 alas de duende dardo iridiscente a Krueg Machacacráneos al Campamento Mojache.‡Rapporter 10 Ailes iridescentes de Fées fléchetteuses à Krueg Casse-crâne au Camp Mojache.‡给莫沙彻营地的克鲁伊格·碎颅带去10个闪光的小精灵翅膀。‡給莫沙徹營地的克魯伊格·劈顱帶去10個閃光的小精靈翅膀。',
  }
},
[2974] = {
  {
    'Uma temível descoberta‡Зловещее открытие‡Eine grausige Entdeckung‡불길한 발견‡Un descubrimiento siniestro‡Un descubrimiento siniestro‡Une découverte sinistre‡可怕的发现‡可怕的發現',
    nil,
    'Traga 20 Chifres de Temível Totem para Krueg Rachacrânio na Aldeia Mojache.‡Принесите 20 рогов тауренов из племени Зловещего Тотема Кригу Головорубу в лагерь Мохаче.‡Bringt 20 Grimmtotemhörner zu Krueg Schädelspalter in Camp Mojache.‡모자케 야영지에 있는 크루엑 스컬스플리터에게 그림토템 뿔 20개를 가져가야 합니다.‡Lleva 20 cuernos de Tótem Siniestro a Krueg Machacacráneos en el Campamento Mojache.‡Lleva 20 cuernos de Tótem Siniestro a Krueg Machacacráneos en el Campamento Mojache.‡Apporter 20 Cornes de Totem-sinistre à Krueg Casse-crâne au Camp Mojache.‡收集20支恐怖图腾之角，把它们交给莫沙彻营地的克鲁伊格·碎颅。‡收集20支恐怖圖騰之角，把它們交給莫沙徹營地的克魯伊格·劈顱。',
  }
},
[2975] = {
  {
    'Os ogros de Feralas‡Огры Фераласа‡Die Oger von Feralas‡페랄라스의 오우거‡Los ogros de Feralas‡Los ogros de Feralas‡Les ogres de Féralas‡菲拉斯的食人魔‡菲拉斯的巨魔',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você mate 10 Ogros Gordunni, 10 Ogros-magos e 5 Brutamontes Gordunni.‡Убейте 10 огров из клана Гордунни, 10 огров-магов из клана Гордунни и 5 громил из клана Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr 10 Oger der Gordunni, 10 Magier der Gordunni und 5 Schläger der Gordunni tötet.‡모자케 야영지에 있는 로크 올한이 골두니 오우거 10명, 골두니 오우거 마법사 10명, 골두니 투사 5명을 처치해 달라고 했습니다.‡Rok Orhan del Campamento Mojache quiere que mates a 10 ogros Gordunni, 10 magi ogro Gordunni y 5 toscos Gordunni.‡Rok Orhan del Campamento Mojache quiere que mates a 10 ogros Gordunni, 10 magi ogro Gordunni y 5 toscos Gordunni.‡Tuer 10 Ogres gordunni, 10 Ogre-magi gordunni et 5 Brutes gordunni pour Rok Orhan, du Camp Mojache.‡莫沙彻营地的洛卡-奥赫要你杀掉10个戈杜尼食人魔、10个戈杜尼食人魔法师和5个戈杜尼蛮兵。‡莫沙徹營地的洛卡·奧赫要你殺掉10個戈杜尼巨魔、10個戈杜尼巨魔法師和5個戈杜尼蠻卒。',
  }
},
[2976] = {
  {
    'Uma temível descoberta‡Зловещее открытие‡Eine grausige Entdeckung‡불길한 발견‡Un descubrimiento siniestro‡Un descubrimiento siniestro‡Une découverte sinistre‡可怕的发现‡可怕的發現',
    nil,
    'Leve a Caixa de Chifres Temível Totem para Belgrom Pedramalho em Orgrimmar.‡Отнесите ящик с рогами тауренов из племени Зловещего Тотема Белгрому Каменной Булаве в Оргриммар.‡Bringt die Kiste mit Grimmtotemhörnern zu Belgrom Felshammer nach Orgrimmar.‡오그리마에 있는 벨그롬 록마울에게 그림토템 뿔 상자를 가져가야 합니다.‡Lleva el cajón de cuernos de Tótem Siniestro a Belgrom Destrozarroca a Orgrimmar.‡Lleva el cajón de cuernos de Tótem Siniestro a Belgrom Destrozarroca a Orgrimmar.‡Apportez la Caisse de Cornes de Totem-sinistre à Belgrom Cogneroche, Orgrimmar.‡将一箱恐怖图腾之角交给奥格瑞玛的贝尔戈洛姆·石槌。‡將恐怖圖騰之角木箱交給奧格瑪的貝爾戈洛姆·石槌。',
  }
},
[2977] = {
  {
    'Retorno a Altaforja‡Возвращение в Стальгорн‡Rückkehr nach Eisenschmiede‡아이언포지로의 귀환‡Regresa a Forjaz‡Regresa a Forjaz‡Retour à Forgefer‡返回铁炉堡‡返回鐵爐堡',
    nil,
    'Fale com o Historiador Karnik em Altaforja.‡Поговорите с историком Карником из Стальгорна.‡Sprecht mit Historiker Karnik in Eisenschmiede.‡아이언포지에 있는 역사학자 카르닉과 대화해야 합니다.‡Habla con Karnik el Historiador de Forjaz.‡Habla con Karnik el Historiador de Forjaz.‡Parler à l\'Historien Karnik, à Forgefer.‡与铁炉堡的史学家卡尼克谈一谈。‡與鐵爐堡的史學家卡尼克談話。',
  }
},
[2978] = {
  {
    '‡Свиток Гордунни‡Die Gordunnischriftrolle‡골두니 두루마리‡El pergamino Gordunni‡El pergamino Gordunni‡Le parchemin gordunni‡戈杜尼卷轴‡',
    nil,
    '‡Отнести свиток Гордунни Роке Орхан в Лагерь Мохаче.‡Bringt die Gordunnischriftrolle zu Rok Orhan ins Camp Mojache.‡모자케 야영지에 있는 로크 올한에게 골두니 두루마리를 가져가야 합니다.‡Lleva el pergamino Gordunni a Rok Orhan al Campamento Mojache.‡Lleva el pergamino Gordunni a Rok Orhan al Campamento Mojache.‡Apportez le Parchemin gordunni à Rok Orhan, au Camp Mojache.‡将戈杜尼卷轴交给莫沙彻营地的洛克·奥汉。‡',
  }
},
[2979] = {
  {
    'Cerimônia sombria‡Темный обряд‡Dunkle Zeremonie‡암흑의 의식‡Una ceremonia oscura‡Una ceremonia oscura‡Sombre cérémonie‡黑暗仪式‡黑暗儀式',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você encontre um Orbe Gordunni.‡Добудьте сферу Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr eine Gordunnikugel findet.‡모자케 야영지에 있는 로크 올한이 골두니 수정구를 찾아 와 달라고 했습니다.‡Rok Orhan del Campamento Mojache quiere que encuentres 1 orbe Gordunni.‡Rok Orhan del Campamento Mojache quiere que encuentres 1 orbe Gordunni.‡Rok Orhan, du Camp Mojache, veut que vous trouviez un Orbe gordunni.‡莫沙彻营地的洛卡·奥赫希望你找到一颗戈杜尼之宝珠。‡莫沙徹營地的洛卡·奧赫希望你找到一顆戈杜尼之寶珠。',
  }
},
[2980] = {
  {
    'Os ogros de Feralas‡Огры Фераласа‡Die Oger von Feralas‡페랄라스의 오우거‡Los ogros de Feralas‡Los ogros de Feralas‡Les ogres de Féralas‡菲拉斯的食人魔‡菲拉斯的巨魔',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você mate 10 Xamãs Gordunni, 10 Bruxos Gordunni e 5 Espancadores Gordunni.‡Убейте 10 шаманов из клана Гордунни, 10 чернокнижников из клана Гордунни и 5 извергов из клана Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr 10 Schamanen der Gordunni, 10 Hexenmeister der Gordunni und 5 Raufer der Gordunni tötet.‡모자케 야영지에 있는 로크 올한이 골두니 주술사 10명, 골두니 흑마법사 10명, 그리고 골두니 싸움꾼 5명을 처치해 달라고 했습니다.‡Rok Orhan del Campamento Mojache quiere que mates a 10 chamanes Gordunni, 10 brujos Gordunni y 5 aplastadores Gordunni.‡Rok Orhan del Campamento Mojache quiere que mates a 10 chamanes Gordunni, 10 brujos Gordunni y 5 aplastadores Gordunni.‡Tuez 10 Chamans gordunni, 10 Démonistes gordunni et 5 Marteleurs gordunni pour Rok Orhan, du Camp Mojache.‡莫沙彻营地的洛卡·奥赫要你去杀掉十个戈杜尼萨满祭司、10个戈杜尼术士和5个戈杜尼虐待者。‡莫沙徹營地的洛卡·奧赫要你去殺掉10個戈杜尼薩滿、10個戈杜尼術士和5個戈杜尼虐待者。',
  }
},
[2981] = {
  {
    'Uma ameaça em Feralas‡Опасность в Фераласе‡Eine Bedrohung in Feralas‡페랄라스의 위협‡Una amenaza en Feralas‡Una amenaza en Feralas‡Menace sur Féralas‡菲拉斯的危机‡菲拉斯的危機',
    nil,
    'Belgrom Pedramalho quer que você fale com Rok Orhan, da Aldeia Mojache.‡Поговорите с Рокой Орхан в Лагере Мохаче.‡Belgrom Felshammer will, dass Ihr mit Rok Orhan im Camp Mojache sprecht.‡벨그롬 록마울이 모자케 야영지에 있는 로크 올한과 대화해 달라고 했습니다.‡Belgrom Destrozarroca quiere que hables con Rok Orhan, del Campamento Mojache.‡Belgrom Destrozarroca quiere que hables con Rok Orhan, del Campamento Mojache.‡Comme le veut Belgrom Cogneroche, aller parler à Rok Orhan, au Camp Mojache.‡贝尔戈洛姆·石槌想让你去和莫沙彻营地的洛卡·奥赫谈一谈。‡貝爾戈洛姆·石槌想讓你去和莫沙徹營地的洛卡·奧赫談話。',
  }
},
[2982] = {
  {
    'A Selva Alta‡Высокогорные дебри‡Die Obere Wildnis‡높은벌‡Las Altas Tierras Salvajes‡Las Altas Tierras Salvajes‡Les plateaux Sauvages‡高原荒野‡高原荒野',
    nil,
    'Ângela Brisaluna quer que você mate 8 Bruxos Gordunni, 8 Xamãs Gordunni e 8 Brutamontes Gordunni.‡Убейте 8 чернокнижников из клана Гордунни, 8 шаманов из клана Гордунни и 8 громил из клана Гордунни по просьбе Ангелас Лунный Бриз.‡Angelas Mondhauch will, dass Ihr 8 Hexenmeister der Gordunni, 8 Schamanen der Gordunni und 8 Schläger der Gordunni tötet.‡안젤라스 문브리즈가 골두니 흑마법사 8명, 골두니 주술사 8명, 골두니 투사 8명을 퇴치해 달라고 했습니다.‡Angelas Brisaluna quiere que mates a 8 brujos Gordunni, 8 chamanes Gordunni y 8 toscos Gordunni.‡Angelas Brisaluna quiere que mates a 8 brujos Gordunni, 8 chamanes Gordunni y 8 toscos Gordunni.‡Tuer 8 Démonistes Gordunni, 8 Chamans Gordunni et 8 Brutes Gordunni pour Angelas Lunebise.‡安吉拉斯·月风要求你杀死8个戈杜尼术士、8个戈杜尼萨满祭司和8个戈杜尼蛮兵。‡安吉拉斯·月風要求你殺死8個戈杜尼術士、8個戈杜尼薩滿和8個戈杜尼蠻卒。',
  }
},
[2983] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[2984] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[2985] = {
  {
    '‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡',
    nil,
    '‡Отыщите в Степях Ислену Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡',
  }
},
[2986] = {
  {
    'Clamor da Água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислену Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[2987] = {
  {
    'Cobalto Gordunni‡Кобальт Гордунни‡Gordunnikobalt‡골두니 코발트‡El cobalto Gordunni‡El cobalto Gordunni‡Cobalt Gordunni‡戈杜尼钴矿石‡戈杜尼鈷礦石',
    nil,
    'Orwin Sheiduztruc, na Aldeia Mojache, quer 12 amostras de Cobalto Gordunni.‡Добудьте 12 образцов кобальта Гордунни для Орвина Гиззмика из Лагеря Мохаче.‡Orwin Gizzmick im Camp Mojache will 12 Proben Gordunnikobalt.‡모자케 야영지에 있는 올윈 기즈믹이 골두니 코발트 12개를 가져다 달라고 했습니다.‡Orwin Cacharrejos, del Campamento Mojache, quiere 12 muestras de cobalto Gordunni.‡Orwin Cacharrejos, del Campamento Mojache, quiere 12 muestras de cobalto Gordunni.‡Collecter 12 échantillons de Cobalt Gordunni pour Orwin Azztuche, du Camp Mojache.‡莫沙彻营地的奥尔文·吉兹米克需要12块戈杜尼钴矿石的样本。‡莫沙徹營地的奧爾文·吉茲米克需要12塊戈杜尼鈷礦石的樣本。',
  }
},
[2988] = {
  {
    'Jaulas Cascasseca‡Тролльи клетки‡Käfige der Bleichborken‡마른나무껍질 우리‡Las jaulas de Secacorteza‡Las jaulas de Secacorteza‡Les cages des Fanécorces‡枯木巨魔的牢笼‡枯木食人妖的牢籠',
    nil,
    'Verifique as jaulas nas duas aldeias Cascasseca, depois fale novamente com o Mestre de Grifos Garra-de-acha.‡Проверьте клетки в двух деревнях Сухокожих и возвращайтесь к дрессировщику грифонов Разящему Когтю.‡Durchsucht die Käfige in den beiden Dörfern der Bleichborken und kehrt dann zu Greifenmeister Krallenaxt zurück.‡마른나무껍질 마을 두 곳에 있는 우리를 확인한 후, 그리핀 조련사 탈론액스에게 가야 합니다.‡Mira en las jaulas de los poblados Secacorteza y vuelve a ver al maestro de grifos Garracha.‡Mira en las jaulas de los poblados Secacorteza y vuelve a ver al maestro de grifos Garracha.‡Inspectez les cages dans les deux villages des Fanécorces, puis retournez auprès du Maître des griffons Hachegriffe.‡检查两个枯木巨魔村落里的笼子，然后向狮鹫管理员沙拉克·鹰斧回复。‡檢查兩個枯木食人妖村落裡的籠子，然後向獅鷲獸管理員沙拉克·鷹斧回覆。',
  }
},
[2989] = {
  {
    'Altar de Zul‡Алтарь Зула‡Der Altar von Zul‡줄의 제단‡El Altar de Zul‡El Altar de Zul‡L\'autel de Zul‡祖尔祭坛‡祖爾祭壇',
    nil,
    'Verifique o topo do Altar de Zul, depois fale novamente com o Mestre de Grifos Garra-de-acha.‡Осмотрите вершину Алтаря Зула и возвращайтесь к укротителю грифонов Разящему Когтю.‡Überprüft die Oberfläche des Altars von Zul und kehrt dann zu Greifenmeister Krallenaxt zurück.‡줄의 제단 위를 확인한 후, 그리핀 조련사 탈론액스에게 가야 합니다.‡Mira en el Altar de Zul y vuelve a ver al maestro de grifos Garracha.‡Mira en el Altar de Zul y vuelve a ver al maestro de grifos Garracha.‡Regarder sur le dessus de l\'autel de Zul, puis retourner auprès du Maître des griffons Hachegriffe.‡检查祖尔祭坛的顶部，然后向狮鹫管理员沙拉克·鹰斧报告。‡檢查祖爾祭壇的頂部，然後向獅鷲獸管理員沙拉克·鷹斧報告。',
  }
},
[2990] = {
  {
    'Tádius Sombraustera‡Тадиус Мрачная Тень‡Thadius Grimmschatten‡샤디우스 그림셰이드‡Thadius Sombramacabra‡Thadius Sombramacabra‡Thadius Sinissombre‡萨迪斯·格希德‡薩迪斯·格希德',
    nil,
    'Leve a Pena de Bicoafiado para Tádius Sombraustera na Barreira do Inferno.‡Принесите перо Остроклюва Тадиусу Мрачной Тени в Выжженные земли.‡Bringt Scharfschnabels Feder zu Thadius Grimmschatten in die Verwüsteten Lande.‡뾰족부리의 깃털을 저주받은 땅에 있는 샤디우스 그림셰이드에게 가져가야 합니다.‡Lleva la pluma de Picoafilado a Thadius Sombramacabra a Las Tierras Devastadas.‡Lleva la pluma de Picoafilado a Thadius Sombramacabra a Las Tierras Devastadas.‡Apportez la Plume de Bec-tranchant à Thadius Sinissombre, dans les Terres Foudroyées.‡将沙普比克的羽毛交给诅咒之地的萨迪斯·格希德。‡將沙普比克的羽毛交給詛咒之地的薩迪斯·格希德。',
  }
},
[2991] = {
  {
    'Medalhão de Nekrum‡Медальон Некрума‡Nekrums Medaillon‡네크룸의 메달‡Medallón de Nekrum‡Medallón de Nekrum‡Le médaillon de Nekrum‡耐克鲁姆的徽章‡耐克魯姆的勳章',
    nil,
    'Leve o Medalhão de Nekrum para Tádius Sombraustera na Barreira do Inferno.‡Принесите медальон Некрума Тадиусу Мрачной Тени в Выжженные земли.‡Bringt Thadius Grimmschatten in den Verwüsteten Landen Nekrums Medaillon.‡네크룸의 메달을 저주받은 땅에 있는 샤디우스 그림셰이드에게 가져가야 합니다.‡Lleva el medallón de Nekrum a Thadius Sombramacabra a Las Tierras Devastadas.‡Lleva el medallón de Nekrum a Thadius Sombramacabra a Las Tierras Devastadas.‡Apportez le Médaillon de Nekrum à Thadius Sinissombre, dans les Terres Foudroyées.‡将耐克鲁姆的徽章交给诅咒之地的萨迪斯·格希德。‡將耐克魯姆的勳章交給詛咒之地的薩迪斯·格希德。',
  }
},
[2992] = {
  {
    '‡Прорицание‡Die Weissagung‡‡El ritual de adivinación‡El ritual de adivinación‡La Divination‡占卜‡',
    nil,
    '‡Дождитесь, пока Мрачная Тень не закончит ритуал прорицания.‡Wartet, bis Grimmschatten das Rutengangritual durchgeführt hat.‡‡Espera a que Sombramacabra realice el ritual de adivinación.‡Espera a que Sombramacabra realice el ritual de adivinación.‡Attendre que Sinissombre ait fini de pratiquer son rituel de divination.‡等待萨迪斯完成占卜仪式。‡',
  }
},
[2993] = {
  {
    '‡Назад во Внутренние земли‡Rückkehr ins Hinterland‡동부 내륙지로 돌아가기‡Regresa a las Tierras del Interior‡Regresa a las Tierras del Interior‡Retour dans les Hinterlands‡返回辛特兰‡',
    nil,
    '‡Поговорите с укротителем грифонов Разящим Когтем.‡Sprecht mit Greifenmeister Krallenaxt.‡그리핀 조련사 탈론액스와 대화해야 합니다.‡Habla con el maestro de grifos Garracha.‡Habla con el maestro de grifos Garracha.‡Parler au Maître des griffons Hachegriffe.‡与辛特兰的狮鹫管理员沙拉克·鹰斧谈一谈。‡',
  }
},
[2994] = {
  {
    'Salvando Bicoafiado‡Спасение Остроклюва‡Scharfschnabels Rettung‡뾰족부리 구출‡Salvar a Picoafilado‡Salvar a Picoafilado‡Sauver Bec-tranchant‡拯救沙普比克‡拯救沙普比克',
    nil,
    'Lute até o topo de Jintha\'Alor, mate a Sacerdotisa Torpe Bagata para pegar a chave da jaula de Bicoafiado e salvá-lo.‡Пробейтесь в верхнюю часть Джинта\'Алора, убейте коварную жрицу Ведьмису, возьмите у нее ключ от клетки и освободите Остроклюва.‡Kämpft Euch bis zum Gipfel von Jintha\'Alor durch, tötet die üble Priesterin Hexx, um an den Schlüssel zu Scharfschnabels Käfig zu kommen, und rettet Scharfschnabel.‡진타알로의 꼭대기까지 올라가 타락한 여사제 헥스를 처치하고 뾰족부리가 갇혀 있는 우리의 열쇠를 빼앗은 다음 뾰족부리를 구출해야 합니다.‡Llega hasta la cima de Jintha\'Alor, mata a la sacerdotisa vil Hexx, consigue la llave de la jaula y rescata a Picoafilado.‡Llega hasta la cima de Jintha\'Alor, mata a la sacerdotisa vil Hexx, consigue la llave de la jaula y rescata a Picoafilado.‡Combattre jusqu\'au sommet de Jintha\'Alor, tuer la vile prêtresse Maléficia pour obtenir la clé de la cage de Bec-tranchant, et sauver Bec-tranchant.‡到辛萨罗山顶去，杀掉邪恶祭司海克斯，找到沙普比克笼子的钥匙，然后救出沙普比克。‡到辛薩羅山頂去，殺掉邪惡祭司海克斯，找到沙普比克籠子的鑰匙，然後救出沙普比克。',
  }
},
[2995] = {
  {
    'Linhas de comunicação‡Линии связи‡Nachrichtenwege‡연락망‡Líneas de comunicación‡Líneas de comunicación‡Lignes de communication‡联络中心‡溝通管道',
    nil,
    'Burn the Highvale Records, Highvale Report, and Highvale Notes.‡Сожгите отчет Высокодолья, заметки Высокодолья и записи Высокодолья.‡Verbrennt die Hochtalaufzeichnungen, Hochtalberichte und Hochtalnotizen.‡깊은골짜기 기록문, 깊은골짜기 보고서, 깊은골짜기 일지를 태워야 합니다.‡Quema los registros de Vallealto, el informe de Vallealto y las notas de Vallealto.‡Quema los registros de Vallealto, el informe de Vallealto y las notas de Vallealto.‡Brûlez les Archives du Haut-val, le Rapport du Haut-val et les Notes du Haut-val.‡幽暗城的奥兰·斯内克威瑟让你到辛特兰去烧毁高原精灵记录、高原精灵报告和高原精灵信件。‡燒毀高原精靈記錄、高原精靈報告和高原精靈信件。',
  }
},
[2996] = {
  {
    'Procurando Strahad‡В поисках Страхада‡Die Suche nach Strahad‡스트라드를 찾아서‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parlez à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[2997] = {
  {
    '‡Фолиант божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    '‡Поговорите с Тизой Боевой Горн в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡与铁炉堡的蒂萨·热炉谈话。‡',
  }
},
[2998] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[2999] = {
  {
    '‡Фолиант божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    '‡Поговорите с Тизой Боевой Горн в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡和铁炉堡的蒂萨·热炉谈一谈。‡',
  }
},
[3000] = {
  {
    '‡Фолиант божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    '‡Поговорите с Тизой Боевой Горн в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡',
