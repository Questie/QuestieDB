[24924] = {
  {
    'A Vila Trema-trema‡Деревня Умлот‡Oomlot‡움로트 마을‡El poblado Oomlot‡El poblado Oomlot‡Oomlot‡乌姆洛特村‡烏姆拉村',
    nil,
    'Fale com Azeitona, na Vila Trema-trema, nas Ilhas Perdidas.‡Поговорите с Иззи в деревне Умлот на Затерянных островах.‡Sprecht mit Izzy bei Oomlot auf den Verlorenen Inseln.‡잃어버린 섬의 움로트 마을에 있는 이지와 대화해야 합니다.‡Habla con Izzy en el poblado Oomlot, en Las Islas Perdidas.‡Habla con Izzy en el poblado Oomlot, en Las Islas Perdidas.‡Parlez à Izzy à Oomlot, sur les Îles Perdues.‡跟失落群岛乌姆洛特村的小静谈一谈。‡在失落群島上的烏姆拉村和伊茲談話。',
  }
},
[24925] = {
  {
    'Liberte os prisioneiros‡Свободу пленникам‡Befreit die Gefangenen‡포로 구출‡Liberar a los cautivos‡Liberar a los cautivos‡Libérez les prisonniers‡营救俘虏‡解放俘虜',
    nil,
    'Liberte 5 Prisioneiros Goblins.‡Освободите 5 пленных гоблинов.‡Befreit 5 gefangene Goblins.‡고블린 포로 5명을 구출해야 합니다.‡Libera a 5 goblins cautivos.‡Libera a 5 goblins cautivos.‡Libérez 5 Captifs gobelins.‡营救5名地精俘虏。‡解放5名哥布林俘虜。',
  }
},
[24926] = {
  {
    'Servindo A-Me 01‡Помочь Чи-Та 3‡Dienst für A-Me 01‡에이미 01 요청‡Servir a Memo 01‡Servir a Memo 01‡Servir A-Mi 01‡为A-Me 01服务‡服務艾米01',
    nil,
    'Leve o Pen-drive da A-Me para Karna Trilheiro na Viga Musgosa, que fica na Cratera Un\'Goro.‡Отнесите флэш-накопитель Чи-Та 3 назад к Карне Сомнамбулер на Мшистую горку в Кратере Ун\'Горо.‡Bringt A-Me 01s Fingerfestplatte zurück zu Karna Wirrbart am Mooshügel im Krater von Un\'Goro.‡운고로 분화구의 이끼 더미에 있는 카르나 렘트래블에게 에이미의 소형 저장 장치를 가져가야 합니다.‡Entrega la unidad portátil de Memo 01 a Karna Tripirrem en el Pilote Musgoso en el Cráter de Un\'Goro.‡Entrega la unidad portátil de Memo 01 a Karna Tripirrem en el Pilote Musgoso en el Cráter de Un\'Goro.‡Apportez la Clé de stockage d’A-Mi 01 à Karna Songerrance au Tertre Moussu, dans le Cratère d’Un’Goro.‡将A-Me的随身存储器交给安戈洛环形山覆苔营地卡尔纳·雷塔维。‡把艾米的隨身碟帶去安戈洛環形山的苔蘚堆，交給卡爾納·雷姆塔維爾。',
  }
},
[24927] = {
  {
    'Tre... Quinze piratas sobre o caixão‡Сундук мертвеца‡Die Truhe des toten Mannes‡죽은 자의 상자‡Cofre de un hombre muerto‡Cofre de un hombre muerto‡Le coffre du mort‡加基森海盗：亡灵宝藏‡死人的箱子',
    nil,
    'Mate 15 Flibusteiros dos Mares do Sul de qualquer tipo.‡Убейте 15 любых флибустьеров Южных морей.‡Tötet 15 Seeräuber der Südmeerfreibeuter jeglicher Art.‡남쪽바다 해적단 15명을 처치해야 합니다.‡Mata a 15 filibusteros de los Mares del Sur de cualquier tipo.‡Mata a 15 filibusteros de los Mares del Sur de cualquier tipo.‡Tuez 15 Flibustiers des mers du Sud.‡杀死任意15名南海海盗。‡殺死任何15位南海掠劫者。',
  }
},
[24928] = {
  {
    'Rumolotov!‡Дотла!‡Niederbrennen!‡부동산 진출!‡¡Hasta los cimientos!‡¡Hasta los cimientos!‡Des cendres aux cendres‡夷为平地！‡燒成灰!',
    nil,
    'Ateie fogo na Cabana Noroeste, na Cabana Nordeste e na Cabana Sudoeste.‡Подожгите лачуги на северо-западе, северо-восторе и юго-западе.‡Brennt die nordwestliche Hütte, die südöstliche Hütte und die nordöstliche Hütte nieder.‡북서쪽 판잣집, 남동쪽 판잣집과 북동쪽 판잣집에 불을 질러야 합니다.‡Prende fuego a la cabaña noroeste, a la cabaña sureste y a la cabaña noreste.‡Prende fuego a la cabaña noroeste, a la cabaña sureste y a la cabaña noreste.‡Mettez le feu à la Cabane du nord-ouest, à la Cabane du sud-est et à la Cabane du nord-est.‡给西北小屋、东北小屋，以及西南小屋点火。‡將西北方、東南方、和東北方的草屋點燃起火。',
  }
},
[24929] = {
  {
    'Mandando um recado‡Расставить точки над Ингви‡Hinterlasst eine Botschaft‡본때 보여주기‡Envía un mensaje‡Envía un mensaje‡Envoyez un message‡传递信息‡殺雞儆猴',
    nil,
    'Mate Sërguëi.‡Убейте Ингви.‡Tötet Yngwie.‡잉위를 처치해야 합니다.‡Mata a Yngwie.‡Mata a Yngwie.‡Tuez Yngwie.‡杀死英格维。‡殺死英格威。',
  }
},
[24930] = {
  {
    'Aproveitando o ensejo...‡Попутное дело‡Wenn Ihr schon dabei seid‡다른 부탁‡Ya que estás en ello‡Ya que estás en ello‡Pendant que vous y êtes…‡顺路除害‡順路為之',
    nil,
    'Mate 5 Worgens Dentessangue.‡Убейте 5 воргенов из стаи Кровавых Клыков.‡Tötet 5 Blutfangworgen.‡붉은송곳니 늑대인간 5명을 처치해야 합니다.‡Mata a 5 huargen Colmillo de Sangre.‡Mata a 5 huargen Colmillo de Sangre.‡Tuez 5 Worgens croc-de-sang.‡杀死5名血牙狼人。‡殺死5隻血牙狼人。',
  }
},
[24931] = {
  {
    'Só tenho olhos para você‡Довесок – взорени‡Starrermarke‡주시자의 꼬리표‡Añadido de observador‡Añadido de observador‡Mon œil !‡凝视者的标记‡凝視者標示',
    nil,
    'Consiga 5 Cristais Oculares dos Observadores Silicouro.‡Соберите со стеклошкурых взореней 5 глазных кристаллов.‡Sammelt 5 Okularkristalle von Glashautstarrern.‡유리비늘 큰눈바실리스크를 사냥해 안구 수정 5개를 수집해야 합니다.‡Reúne 5 cristales oculares de observadores Cristaldermo.‡Reúne 5 cristales oculares de observadores Cristaldermo.‡Récupérez 5 Cristaux oculaires sur des Contemplateurs peau-de-verre.‡从晶鳞凝视者身上获得5颗水晶之眼。‡從晶鱗凝視者身上取得5個水晶之眼。',
  }
},
[24932] = {
  {
    'Tempo perdido‡Снижение потерь‡Verlust verhindern‡사업 실패‡Reducir pérdidas‡Reducir pérdidas‡Coup de cafard‡斩仓‡降低損失',
    nil,
    'Mate 15 Silitídeos Hazzali de qualquer tipo na Fenda Hazzali.‡Убейте 15 силитидов из улья Хаззали в Зияющей бездне.‡Tötet 15 Silithiden der Hazzali jeglicher Art in der Klaffenden Schlucht.‡모래지옥 협곡에 있는 하잘리 실리시드 15마리를 처치해야 합니다.‡Mata a 15 silítidos Hazzali de cualquier tipo en la Sima Abierta.‡Mata a 15 silítidos Hazzali de cualquier tipo en la Sima Abierta.‡Tuez 15 Silithides Hazzali de n\'importe quelle sorte dans le gouffre Béant.‡在大裂口消灭任意15只哈扎里异种。‡到大裂口殺死任15隻哈札里異種蠍。',
  }
},
[24933] = {
  {
    'Isca do deserto‡Цыпленок в пустыне‡Hühnchen der Wüste‡사막의 겁보‡Pollo del desierto‡Pollo del desierto‡Le poulet du désert‡沙漠之鸡‡沙漠之雞',
    nil,
    'Consiga 6 Nacos de Hiena.‡Соберите 6 кусков мяса гиены.‡Sammelt 6 Stücke Hyänenfleisch.‡하이에나 고기 6개를 수집해야 합니다.‡Reúne 6 piezas de carne de hiena.‡Reúne 6 piezas de carne de hiena.‡Récupérez 6 morceaux de Viande d’hyène.‡收集6块土狼肉块。‡收集6塊土狼肉。',
  }
},
[24934] = {
  {
    'Lobos-do-mar!‡Дать отпор идущим на абордаж!‡Werft Enternde von Bord!‡올라타는 자를 격퇴하라!‡¡Al abordaje!‡¡Al abordaje!‡Repoussez l\'abordage !‡击退不速之客！‡擊退登船者!',
    nil,
    'Fale com o Almirante Cochrane para pegar um voo até a nau Lagonero. Chegando lá, mate 6 Lobos-do-mar Rugifúria.‡Поговорите с адмиралом Обри, затем отправляйтесь на Блэкпул и убейте 6 морских волков Грознорева.‡Sprecht mit Admiral Aubrey, um zur Schwarzborn zu fliegen. Tötet dort 6 Seebären von Donnerschrei.‡제독 오브리와 대화하여 검은호수호로 날아간 다음 성난울음 해적단원 6명을 처치해야 합니다.‡Habla con el almirante Aubrey para volar al Pozo Negro y mata a 6 lobos de mar Gruñefuria.‡Habla con el almirante Aubrey para volar al Pozo Negro y mata a 6 lobos de mar Gruñefuria.‡Parlez à l’Amiral Aubrey pour être aéroporté sur la Marée noire et tuez 6 Loups de mer hurlerage.‡跟海军司令奥布里谈一谈，飞往黑弹珠号杀死6名怒吼水兵。‡和奧布里上將說話以飛上布萊克波爾消滅6個暴吼老水手。',
  }
},
[24935] = {
  {
    '‡‡Körper und Seele‡‡En cuerpo y alma‡‡Corps et âme‡‡',
    nil,
    '‡‡Vernichtet Yngwies Seele.|n|nFalls Ihr Yngwies Leiche verlegt, fragt Izzy, ob sie sie gefunden hat.‡‡Destruye el alma de Yngwie.|n|nSi, por casualidad, no encuentras el cuerpo de Yngwie, pregúntale a Izzy si lo ha encontrado.‡‡Détruisez l\'Âme d\'Yngwie.|n|nSi vous perdez malencontreusement le Corps d\'Yngwie, demandez à Izzy si elle l\'a retrouvé.‡‡',
  }
},
[24936] = {
  {
    '‡‡Körper und Seele‡‡En cuerpo y alma‡‡Corps et âme‡‡',
    nil,
    '‡‡Vernichtet Yngwies Seele.|n|nFalls Ihr Yngwies Leiche verlegt, fragt Izzy, ob sie sie gefunden hat.‡‡Destruye el alma de Yngwie.|n|nSi, por casualidad, no encuentras el cuerpo de Yngwie, pregúntale a Izzy si lo ha encontrado.‡‡Détruisez l\'Âme d\'Yngwie.|n|nSi vous perdez malencontreusement le Corps d\'Yngwie, demandez à Izzy si elle l\'a retrouvé.‡‡',
  }
},
[24937] = {
  {
    'Aldeões Trema-trema sobrepujados‡С Умлотом покончено‡Oomlot ist erledigt‡움로트 처리‡Problema de los Oomlot resuelto‡Problema de los Oomlot resuelto‡Gobelins 1 - 0 Oomlot‡危机解除‡解決烏姆拉',
    nil,
    'Fale com Espoleta Chaveforte na Cidade Portátil, que fica nas Ilhas Perdidas.‡Поговорите с Хамми Кофельнагель в Городке-из-табакерки на Затерянных островах.‡Sprecht mit Sassy Hartzang in Instastadt auf den Verlorenen Inseln.‡잃어버린 섬의 상자 마을에 있는 새시 하드렌치와 대화해야 합니다.‡Habla con Sassy Malallave en la Ciudad de Bolsillo, en Las Islas Perdidas.‡Habla con Sassy Malallave en la Ciudad de Bolsillo, en Las Islas Perdidas.‡Parlez à Chipie Serrelavis à Ville-en-Boîte, sur les Îles Perdues.‡跟失落群岛胶囊镇的莎希·硬钳谈一谈。‡到失落群島上的盒中鎮和賽希·硬心談話。',
  }
},
[24938] = {
  {
    'Os canhões da Guardanorte‡Пушки крепости Северной Стражи‡Die Kanonen von Nordwacht‡북부감시의 포병‡Las armas del Fuerte del Norte‡Las armas del Fuerte del Norte‡Les canons de Guet-du-Nord‡北方城堡的枪炮‡北方城堡之砲',
    nil,
    'Fale com o Canhoneiro Smythe.‡Поговорите с канониром Смайтом.‡Sprecht mit Kanonier Hecksler.‡포병 스마이드와 대화해야 합니다.‡Habla con el cañonero Smythe.‡Habla con el cañonero Smythe.‡Parlez au Cannonier Smythe.‡跟炮兵斯密瑟谈一谈。‡和砲手斯密瑟說話。',
  }
},
[24939] = {
  {
    'Siga bem, canhoneiro‡До последнего патрона‡Bringt die Kanonen zum Einsatz‡포병 부족‡Apunta y dispara‡Apunta y dispara‡Servir les canons‡用尽炮弹‡耗盡槍枝',
    nil,
    'Use a Bateria da Costa de Guardanorte para destruir 10 Barcos a Remo dos Rugifúria.‡Воспользуйтесь береговым патрулем крепости Северной Стражи, чтобы уничтожить 10 гребных шлюпок.‡Benutzt ein Küstengeschütz der Nordwacht um 10 Ruderboote von Donnerschrei zu zerstören.‡북부감시 해안포를 사용하여 성난울음 나룻배 10척을 파괴해야 합니다.‡Usa una batería de costa de Fuerte del Norte para destruir 10 botes de remos Gruñefuria.‡Usa una batería de costa de Fuerte del Norte para destruir 10 botes de remos Gruñefuria.‡Utilisez une Batterie côtière de Guet-du-Nord pour détruire 10 Chaloupes hurlerage.‡使用北卫军海岸排炮摧毁10艘怒吼划艇。‡使用北方海岸砲台消滅10艘暴吼小艇。',
  }
},
[24940] = {
  {
    'Subindo o vulcão‡На вулкан!‡Auf den Vulkan‡화산을 향해‡El volcán‡El volcán‡En haut du volcan‡前往火山口‡火山之上',
    nil,
    'Fale com o Técnico Fagallo no Pico Perdido, que fica nas Ilhas Perdidas.‡Поговорите с тренером Проверяком на Затерянном пике на Затерянных островах.‡Sprecht mit Trainer Blutgrätsch auf dem Verlorenen Gipfel auf den Verlorenen Inseln.‡잃어버린 섬의 잃어버린 봉우리에 있는 감독 크로스첵과 대화해야 합니다.‡Habla con Entrenador Paselargo en Pico Perdido, en Las Islas Perdidas.‡Habla con Entrenador Paselargo en Pico Perdido, en Las Islas Perdidas.‡Parlez à l’Entraîneur Sainturrébreutel au Pic-Perdu, sur les Îles Perdues.‡跟失落群岛失落峰的克罗斯彻克教练谈一谈。‡到失落群島上的失落山峰和交叉檢驗教練談話。',
  }
},
[24941] = {
  {
    'Tiro de metralha‡Наброска картечи‡Langridges Munition‡고철 탄‡Tiro de Crestalarga‡Tiro de Crestalarga‡Volée de mitraille‡开花弹‡蘭格里奇的子彈',
    nil,
    'Colete 15 cargas de Munição de Metralha.‡Соберите 15 предметов для наброски картечи.‡Sammelt 15 Stücke Langridges Munition.‡고철 탄 15개를 모아야 합니다.‡Reúne 15 trozos de tiro de Crestalarga.‡Reúne 15 trozos de tiro de Crestalarga.‡Ramassez 15 morceaux de Boîte de mitraille.‡收集15枚开花弹。‡收集15顆蘭格里奇的子彈。',
  }
},
[24942] = {
  {
    'Zumbis versus Botas-foguete Superpropulsoras‡Зомби против реактивных сапог с суперускорителем‡Zombies gegen Superträgerraketenstiefel‡좀비와 강력 추진기 로켓 장화의 대결‡Zombis contra botas con súper cohetes propulsores‡Zombis contra botas con súper cohetes propulsores‡Zombies contre Super-bottes à fusée d\'appoint‡僵尸大战超级火箭靴‡超級增壓火箭靴大戰殭屍',
    nil,
    'Use as Botas-foguete Superpropulsoras para matar 50 Zumbis Goblins.‡С помощью реактивных сапог с суперускорителем уничтожьте 50 гоблинов-зомби.‡Benutzt die Superträgerraketenstiefel, um 50 Goblinzombies zu töten.‡강력 추진기 로켓 장화를 사용하여 고블린 좀비 50마리를 처치해야 합니다.‡Usa las botas con súper cohetes propulsores para matar a 50 goblins zombis.‡Usa las botas con súper cohetes propulsores para matar a 50 goblins zombis.‡Utilisez les Super-bottes à fusée d\'appoint pour massacrer 50 Zombies gobelins.‡使用超级助推火箭之靴杀死50个地精僵尸。‡用超級增壓火箭靴殺死50名哥布林殭屍。',
  }
},
[24943] = {
  {
    'Reconquiste o Pátio‡Вернуть внутренний двор‡Den Hof zurückerobern‡안마당 탈환‡Defender el patio‡Defender el patio‡Reprendre la cour‡夺回庭院‡收復庭院',
    nil,
    'Mate 10 Brutos Rugifúria.‡Убейте 10 рубак Грознорева.‡Tötet 10 Grunzer von Donnerschrei.‡성난울음 그런트 10명을 처치해야 합니다.‡Mata a 10 brutos Gruñefuria.‡Mata a 10 brutos Gruñefuria.‡Tuez 10 Grunts hurlerage.‡消灭10名怒吼步兵。‡殺死10個暴吼蠻兵。',
  }
},
[24944] = {
  {
    'De volta à luta‡После битвы‡Zurück in den Kampf‡다시 싸움터로‡Retomar la batalla‡Retomar la batalla‡Retour au combat‡重返战场‡重回戰場',
    nil,
    'Use as Bandagens Encharcadas com Ervas em 6 Defensores Feridos.‡Используйте пропитанные травяным настоем повязки для перевязки 6 искалеченных защитников.‡Benutzt die kräutergetränkten Bandagen bei 6 verwundeten Verteidigern.‡부상당한 파수병 6명에게 약초로 적신 붕대를 사용해야 합니다.‡Utiliza las vendas impregnadas de hierbas en 6 defensores heridos.‡Utiliza las vendas impregnadas de hierbas en 6 defensores heridos.‡Utilisez les Bandages imprégnés d’herbes sur 6 Défenseurs blessés.‡对6名受伤的防御者使用药草绷带。‡在6名受傷的防衛者身上使用草藥浸泡過的繃帶。',
  }
},
[24945] = {
  {
    'Os três terrores‡Три пигмея‡Drei kleine Pygmäen‡세 꼬마 소인족‡Los tres pigmeos‡Los tres pigmeos‡Les trois petits pygmées‡三个小俾格米人‡三隻小俾格米',
    nil,
    'Mate Fläcido, Cavëras e Pavaröte.‡Убейте Гаала, Мальмо и Телоха.‡Tötet Gaahl, Malmo und Teloch.‡가알, 말모, 텔로크를 처치해야 합니다.‡Mata a Gaahl, a Malmo y a Teloch.‡Mata a Gaahl, a Malmo y a Teloch.‡Tuez Gaahl, Malmo et Teloch.‡杀死加奥、马奥默和塔卢可。‡殺死嘎爾、瑪爾摩、泰洛須。',
  }
},
[24946] = {
  {
    'Qual é o pó?‡Зажигательная смесь‡Abrockpulver‡끝내주는 가루‡Polvo del Rock‡Polvo del Rock‡La poudre Kislapet\'‡摇滚粉末‡搖滾粉末',
    nil,
    'Colete 5 colheradas de Pó Irado.‡Соберите 5 пригоршней зажигательной смеси.‡Sammelt 5 Handvoll Abrockpulver.‡끝내주는 가루 5움큼을 모아야 합니다.‡Recoge 5 muestras de polvo del Rock.‡Recoge 5 muestras de polvo del Rock.‡Rapportez 5 pelletées de Poudre Kislapet\'.‡收集5份摇滚粉末。‡收集5勺搖滾粉末。',
  }
},
[24947] = {
  {
    'Próxima parada: Enseada do Armador Perdido‡Время идет!‡Momentum‡여세를 몰아서‡Momento‡Momento‡Continuer sur sa lancée‡推进力‡氣勢',
    nil,
    'Encontre Carlota Tomanota na Enseada do Armador Perdido.‡Встретьтесь с Мегз Жестекрошшер в Бухте Сорванных Парусов.‡Trefft Megs Schredderschreck in der Mast- und Schotbucht.‡해적단 소굴에 있는 멕스 드레드슈레더를 만나야 합니다.‡Encuéntrate con Megs Trituramatic en Cala del Aparejo Perdido.‡Encuéntrate con Megs Trituramatic en Cala del Aparejo Perdido.‡Rejoignez Megs Déchiqueffroi à la Crique des Gréements.‡去找落帆海湾的梅格斯·碎纸机。‡到落帆海灣與梅格斯·驚懼伐木機碰面。',
  }
},
[24948] = {
  {
    'Rompendo o cerco‡Снятие блокады‡Die Belagerung aufheben‡공성 무기 파괴 작전‡Levantar el asedio‡Levantar el asedio‡Lever le siège‡解除困境‡解除封鎖',
    nil,
    'Use a Tocha de Patrício para queimar 3 Catapultas dos Rugifúria e 1 Arremessadora de Lâminas dos Rugifúria.‡Используйте факел Пакстона, чтобы поджечь 3 катапульты и 1 метатель клинков Грознорева.‡Benutzt Paxtons Fackel um 3 Katapulte von Donnerschrei und 1 Klingenwerfer von Donnerschrei zu verbrennen.‡팩스턴의 횃불을 사용하여 성난울음 투석기 3대와 성난울음 톱날 투척기 1대를 불태워야 합니다.‡Utiliza la antorcha de Paxton para quemar 3 catapultas Gruñefuria y 1 lanzacuchillas Gruñefuria.‡Utiliza la antorcha de Paxton para quemar 3 catapultas Gruñefuria y 1 lanzacuchillas Gruñefuria.‡Utilisez la Torche de Paxton pour brûler 3 Catapultes hurlerage et 1 Lance-lames hurlerage.‡使用帕克斯顿的火炬烧毁3台怒吼投石车和1台投刃车。‡使用帕克斯頓的火炬燒毀3台暴吼投石車和1台暴吼刀刃發射器。',
  }
},
[24949] = {
  {
    'Trabalho sujo‡Трофеи зовут‡Beutepflicht‡전리품 활용‡La llamada del botín‡La llamada del botín‡L’appât du gain‡收赃物‡寶藏任務',
    nil,
    'Consiga 10 Butins Piratas.‡Соберите 10 ящиков с пиратской добычей.‡Sammelt 10 Stück Piratenbeute.‡해적 노획물 10개를 모아야 합니다.‡Reúne 10 piezas de botín pirata.‡Reúne 10 piezas de botín pirata.‡Récupérez 10 Butins de pirate.‡获得10份海盗赃物。‡收集10件海賊寶藏。',
  }
},
[24950] = {
  {
    'Capitão Barborrendo‡Капитан "Борода ужаса"‡Kapitän Schreckensbart‡선장 드레드비어드‡Capitán Barbatroz‡Capitán Barbatroz‡Le capitaine Barbeffroi‡恐须船长‡恐鬍上尉',
    nil,
    'Mate o Capitão Barborrendo.‡Убейте капитана "Борода Ужаса"‡Tötet Kapitän Schreckensbart.‡선장 드레드비어드를 처치해야 합니다.‡Mata al capitán Barbatroz.‡Mata al capitán Barbatroz.‡Tuez le Capitaine Barbeffroi.‡杀死恐须船长。‡殺死恐鬍上尉。',
  }
},
[24951] = {
  {
    'Uma grande ideia‡Отличная идея‡Eine großartige Idee‡기발한 아이디어‡Una idea genial‡Una idea genial‡Une idée géniale‡好主意‡絕妙點子',
    nil,
    'Use a Isca de Inseto do Falsário para capturar um Enxameador Hazzali.‡Поймайте членистонога из улья Хаззали с помощью приманки для жуков.‡Benutzt den Käferköder der Schmuggler, um einen Schwärmer der Hazzali zu ködern.‡밀조장이 벌레 미끼를 이용해 우두머리 하잘리를 생포해야 합니다.‡Usa el cebo de insecto de Contrabandista para capturar a un enjambrista Hazzali.‡Usa el cebo de insecto de Contrabandista para capturar a un enjambrista Hazzali.‡Utilisez l’Appât à insecte improvisé pour capturer un Grouillant hazzali.‡用走私贩的虫饵抓到一只哈扎里群居蝎。‡使用私酒商蟲餌捕捉一隻哈札里群居蠍。',
  }
},
[24952] = {
  {
    'Botas-fogueeeeeeeete!‡Реактивные сапоги‡Raketenstiefelkick‡로켓 장화 추진기‡El impulso de botas cohetes‡El impulso de botas cohetes‡Les bottes-fusées fusent‡火箭靴的威力‡火箭靴之旅',
    nil,
    'Use as Botas-foguete Carregadas de Pó Irado e entregue-as para Roberto Agarramalho.‡Доберитесь до Хобарта Дрека с помощью заряженных зажигательной смесью реактивных сапог.‡Benutzt die abrockpulververstärkten Raketenstiefel und bringt sie zu Hobart Wurfhammer.‡끝내주는 가루가 주입된 로켓 장화를 사용한 다음 호바트 그래플해머에게 전달해야 합니다.‡Usa las botas cohetes imbuidas con polvo del Rock y entrégaselas a Hobart Martillazos.‡Usa las botas cohetes imbuidas con polvo del Rock y entrégaselas a Hobart Martillazos.‡Utilisez les Bottes-fusées imprégnées de poudre Kislapet\' et rapportez-les à Hobart Martelutte.‡使用沾满摇滚粉末的火箭靴，并将其交给霍巴特·钩锤。‡使用添加了搖滾粉末的火箭靴前往荷巴爾特·繫錘那裡。',
  }
},
[24953] = {
  {
    'Nada que uma explosão não resolva‡Просто хочу избавиться от насекомых‡Ungeziefer ausmerzen‡벌레를 죽이려고 할 뿐‡Intentando matar a un puñado de bichos‡Intentando matar a un puñado de bichos‡La petite bête qui descend, qui descend…‡只想杀点虫‡只是清除害蟲',
    nil,
    'Fale com Narain Suavestilo para pilotar o Enxameador Controlado Mentalmente para dentro da colmeia na Fenda Hazzali.‡Поговорите с Нарайном Причуденем, чтобы отправить управляемого членистонога в улей Зияющей бездны.‡Sprecht mit Narain Pfauentraum, um den gedankenkontrollierten Schwärmer in den Bau der Klaffenden Schlucht zu befehligen.‡나라인 수스팬시와 대화해 정신 지배당한 딱정벌레를 모래지옥 협곡 곤충집으로 몰고 가야 합니다.‡Habla con Narain Sabelotodo para pilotar el enjambrista bajo control mental hasta el interior de la colmena de Sima Abierta.‡Habla con Narain Sabelotodo para pilotar el enjambrista bajo control mental hasta el interior de la colmena de Sima Abierta.‡Allez voir Narain Divinambolesque pour diriger le Grouillant contrôlé mentalement à l’intérieur de la Ruche du gouffre Béant.‡跟纳瑞安交谈，指挥被控制意识的爬虫进入大裂口虫巢。‡找納里安·柔想說話，並引導受到心靈控制的蟲群進入大裂口蟲巢。',
  }
},
[24954] = {
  {
    'Santa tartaruga!‡Дети бога-черепахи‡Des Schildkrötengottes Kinder‡거북이 신의 새끼‡Los hijos del dios tortuga‡Los hijos del dios tortuga‡Les enfants d\'un dieu tortue‡龟神的子嗣‡烏龜神之子',
    nil,
    'Colete 5 Glândulas de Fogo.‡Добудьте 5 огневых желез.‡Sammelt 5 Feuerdrüsen.‡불꽃 분비선 5개를 수집해야 합니다.‡Recoge 5 glándulas de fuego.‡Recoge 5 glándulas de fuego.‡Récupérez 5 Glandes de feu.‡收集5个火囊。‡收集5個火焰腺體。',
  }
},
[24955] = {
  {
    'Burrocracia‡Без права подписи‡Un-satzung‡노예 계약‡Sin privilegios‡Sin privilegios‡Valoir son pesant d’ogres‡未经许可‡未經許可',
    nil,
    'Consiga 10 Assinaturas Contratuais dos Ogros Dunamalho.‡Соберите 10 подписей огров из клана Песчаного молота.‡Erhaltet 10 Unterschriften der Satzung von Ogern der Dünenbrecher.‡모래망치 오우거 10명에게 서명을 받아야 합니다.‡Obtén 10 firmas de personajes de ogros de Machacaduna.‡Obtén 10 firmas de personajes de ogros de Machacaduna.‡Obtenir 10 Signatures de charte des Ogres cognedune.‡让10个砂槌食人魔在表格上签名。‡收集10個砂槌巨魔的權狀簽名。',
  }
},
[24956] = {
  {
    'Silenciando Rugifúria‡Уничтожение Грознорева‡Donnerschrei zum Schweigen bringen‡레이지로어의 최후‡Silenciar a los Gruñefuria‡Silenciar a los Gruñefuria‡Réduire Hurlerage au silence‡除掉卡迦·怒吼‡消滅暴吼',
    nil,
    'Mate 4 Tenentes de Rugifúria e obtenha o Elmo de Rugifúria matando Harga Rugifúria.‡Убейте 4 лейтенантов Грознорева и добудьте шлем Грознорева, убив Кэргу Грознорева.‡Tötet 4 Leutnants von Donnerschrei und nehmt Donnerschreis Helm an Euch, nachdem Ihr Karga Donnerschrei getötet habt.‡성난울음 부관 4명과 카르가 레이지로어를 처치하고 레이지로어의 투구를 획득해야 합니다.‡Mata a 4 tenientes Gruñefuria y consigue el yelmo Gruñefuria matando a Karga Gruñefuria.‡Mata a 4 tenientes Gruñefuria y consigue el yelmo Gruñefuria matando a Karga Gruñefuria.‡Tuez 4 Lieutenants Hurlerage et tuez Karga Hurlerage pour obtenir son Heaume.‡击败4名怒吼上尉和卡迦·怒吼，并从卡迦身上取回怒吼之盔。‡殺死4名暴吼中尉以及卡加‧暴吼，並取回卡加的頭盔。',
  }
},
[24957] = {
  {
    'Boas-vindas aos babões‡Найди себе сентипаару‡Auf zur Centipaarty‡센티파르 잔치‡Centipaartes a raudales‡Centipaartes a raudales‡Les mille et une pièces‡森提帕尔派对开始‡森提帕爾派對',
    nil,
    'Consiga 20 Centipartes de qualquer Silitídeo Centiparte.‡Соберите 20 сентипаар с силитидов-сентипааров.‡Sammelt 20 Centipaartikel von Silithiden der Centipaar.‡센티파르 기관 20개를 모아야 합니다.‡Reúne 20 centipaartes de silítidos Centipaar.‡Reúne 20 centipaartes de silítidos Centipaar.‡Récupérez 20 Mille-pièces sur des Silithides centipaar.‡从森提帕尔异种蝎身上获得20块森提帕尔蝎肉。‡從森提帕爾異種蠍身上取得20個森提帕爾蟲塊。',
  }
},
[24958] = {
  {
    'Volcanoth!‡Вулканот!‡Volcanoth!‡볼카노스!‡¡Volcanoth!‡¡Volcanoth!‡Volcanoth !‡沃卡洛斯！‡火岩諾斯!',
    nil,
    'Use a Botazuca para matar Volcanoth.‡Убейте Вулканота с помощью ботзуки.‡Benutzt die Schuhzooka, um Volcanoth zu töten.‡장화포를 사용하여 볼카노스를 처치해야 합니다.‡Usa la Botazuca para matar a Volcanoth.‡Usa la Botazuca para matar a Volcanoth.‡Utilisez le Bottzooka pour tuer Volcanoth.‡使用地精火箭筒杀死沃卡洛斯。‡用靴箭筒殺死火岩諾斯。',
  }
},
[24959] = {
  {
    'Recém-saído da tumba‡Только что из могилы‡Frisch aus dem Grab‡무덤에서 살아난 자‡Recién salido de la tumba‡Recién salido de la tumba‡Fraîchement sorti de la tombe‡从墓穴中醒来‡新出墳土',
    nil,
    'Apresente-se ao Coveiro Mordo nas Tumbas de Plangemortis, que fica nas Clareiras de Tirisfal.‡Поговорите с гробовщиком Мордо в Похоронном Звоне, что в Тирисфальских лесах.‡Meldet Euch bei Totengräber Mordo an den Gräbern von Todesend in Tirisfal.‡티리스팔 숲의 죽음의 종소리 무덤에 있는 장의사 모르도에게 보고해야 합니다.‡Preséntate ante el enterrador Mordo en las Tumbas del Camposanto, en los Claros de Tirisfal.‡Preséntate ante el enterrador Mordo en las Tumbas del Camposanto, en los Claros de Tirisfal.‡Présentez-vous au fossoyeur Mordo aux Tombeaux du glas, dans les Clairières de Tirisfal.‡向提瑞斯法林地的丧钟镇墓地中的送葬者摩尔多报到。‡到提里斯法林地的喪鐘鎮墓地向管理員摩爾多回報。',
  }
},
[24960] = {
  {
    'O despertar‡Пробуждение‡Das Erwachen‡각성‡El despertar‡El despertar‡Le réveil‡苏醒‡甦醒',
    nil,
    'Fale com o Delegado Trilharrubra, Lilian Voss e Valfrido Moray.‡Поговорите с маршалом Редпатом, Лилиан Восс и Валдредом Мораем.‡Sprecht mit Marschall Rotpfad, Lilian Voss und Valdred Moray.‡치안대장 레드패스, 릴리안 보스, 발드레드 모레이와 대화해야 합니다.‡Habla con el alguacil Rutagrana, Lilian Voss y Valdred Moray.‡Habla con el alguacil Rutagrana, Lilian Voss y Valdred Moray.‡Allez parler au Maréchal Senterouge, à Lilian Voss et à Valdred Moray.‡同治安官雷德帕斯，莉莉安·沃斯和瓦德雷·莫莱交谈。‡和治安官雷德帕斯、莉莉安·佛斯、瓦德雷·莫萊談話。',
  }
},
[24961] = {
  {
    'A verdade da tumba‡Замогильная правда‡Die Wahrheit des Grabes‡무덤의 진실‡La verdad de la tumba‡La verdad de la tumba‡La vérité de la tombe‡墓中的真相‡墳墓的真相',
    nil,
    'Encontre Lilian Voss dentro da grande estalagem de Plangemortis. Depois, fale com ela e mostre-lhe o Espelho de Mão da Elvira.‡Дайте карманное зеркальце Элрет Лилиан Восс в Похоронном Звоне.‡Macht Lilian Voss im großen Gasthaus von Todesend ausfindig und zeigt ihr Elreths Handspiegel.‡죽음의 종소리 마을에 있는 큰 여관에서 릴리안 보스를 찾아야 합니다. 그 후 릴리안과 대화해 엘레스의 손거울을 보도록 해야 합니다.‡Encuentra a Lilian Voss dentro de la posada grande de Camposanto y habla con ella para enseñarle el espejo de mano de Elreth.‡Encuentra a Lilian Voss dentro de la posada grande de Camposanto y habla con ella para enseñarle el espejo de mano de Elreth.‡Trouvez Lilian Voss dans la grande auberge, au Glas. Ensuite, parlez-lui pour lui montrer le Miroir face à main d’Elreth.‡在丧钟镇的大旅店中找到莉莉安·沃斯。同她交谈，让她看看艾尔雷斯的小手镜。‡到喪鐘鎮的大旅店裡找到莉莉安‧佛斯。然後和她談話，給她看艾爾雷斯的手鏡。',
  }
},
[24962] = {
  {
    'Pergaminho desgastado com o uso‡Истрепавшийся свиток‡Die mitgenommene Schriftrolle‡떠돌면서 낡은 두루마리‡Pergamino desgastado por el viaje‡Pergamino desgastado por el viaje‡Un parchemin abîmé‡字迹模糊的卷轴‡字跡模糊的卷軸',
    nil,
    'Leia o Pergaminho Desgastado com o Uso e fale com o Xavier, o Guarda-caça, em Plangemortis.‡Прочитайте истрепавшийся свиток и поговорите с ловчим Ксавьером в Похоронном Звоне.‡Lest die mitgenommene Schriftrolle und sprecht mit Xavier dem Jäger in Todesend.‡떠돌면서 낡은 두루마리를 읽고 죽음의 종소리 마을에 있는 사냥꾼 사비에르와 대화해야 합니다.‡Lee el pergamino desgastado por el viaje y habla con Xavier, el Montero en Camposanto.‡Lee el pergamino desgastado por el viaje y habla con Xavier, el Montero en Camposanto.‡Lire le Parchemin abîmé et parler à Xavier le veneur au Glas.‡阅读字迹模糊的卷轴，然后与丧钟镇的猎手哈维尔交谈。‡閱讀字跡模糊的卷軸，然後和喪鐘鎮的齊維爾談話。',
  }
},
[24963] = {
  {
    'Bate, depois assopra‡Убей их нежно‡Zermalmt sie sanft‡친절한 폭력‡Atácalos con cariño‡Atácalos con cariño‡Le sucre d’ogre‡好心加大棒‡好心地槌下去',
    nil,
    'Use os Bocados de Guloseimas Promocionais do Cartel Borraquilha em 8 Ogros Dunamalho após enfraquecê-los.‡Скормите кусочки лакомства на пробу от картеля Трюмных Вод 8 избитым до полусмерти ограм.‡Schwächt 8 Oger der Dünenbrecher und gebt ihnen dann die Werbedelikatesshäppchen des Bilgewasserkartells.‡모래망치 오우거 8명을 약화시키고 난 후 빌지워터 무역회사의 홍보용 맛보기 조각을 줘야 합니다.‡Usa los manjares promocionales del Cártel de Pantoque con 8 ogros de Machacaduna después de debilitarlos.‡Usa los manjares promocionales del Cártel de Pantoque con 8 ogros de Machacaduna después de debilitarlos.‡Utilisez les Bouchées délicates du cartel Baille-Fonds en promotion sur 8 Ogres cognedune après les avoir affaiblis.‡削弱8名砂槌食人魔，然后把锈水财阀精致餐点给他们。‡在削弱8個砂槌巨魔後，把小份污水企業聯合促銷美食交給他們。',
  }
},
[24964] = {
  {
    'O calor da caçada‡Охотничий азарт‡Das Jagdfieber‡사냥의 희열‡La emoción de la caza‡La emoción de la caza‡La chasse : des sensations fortes‡狩猎的兴奋‡狩獵的興奮',
    nil,
    'Aprenda Tiro Firme com Xavier, o Guarda-caça, em Plangemortis. Depois, pratique a habilidade do Tiro Firme 5 vezes em um Boneco de Treinamento.‡Обучитесь приему "Верный выстрел" у ловчего Ксавьера в Похоронном Звоне, затем сделайте 5 "Верных выстрелов" по тренировочному манекену.‡Erlernt \'Zuverlässiger Schuss\' von Xavier dem Jäger in Todesend und übt die Fähigkeit \'Zuverlässiger Schuss\' 5-mal an einer Trainingsattrappe.‡죽음의 종소리 마을에 있는 사냥꾼 사비에르에게 고정 사격을 배운 뒤 훈련용 허수아비에 5회 연습해야 합니다.‡Aprende Disparo firme de Xavier el Montero en Camposanto y practica Disparo firme 5 veces con un muñeco de entrenamiento.‡Aprende Disparo firme de Xavier el Montero en Camposanto y practica Disparo firme 5 veces con un muñeco de entrenamiento.‡Parlez à Xavier le veneur, au Glas, qui vous enseignera le Tir assuré, puis entraînez-vous à utiliser cette technique 5 fois sur un Mannequin d’entraînement.‡向丧钟镇的猎手哈维尔学习稳固射击，然后对一个训练假人使用5次稳固射击。‡到喪鐘鎮向獵人齊維爾學習穩固射擊，然後在訓練假人身上練習使用穩固射擊5次。',
  }
},
[24965] = {
  {
    'Treinamento de magia‡Колдовская тренировка‡Magielehren‡마법 훈련‡Entrenamiento de magia‡Entrenamiento de magia‡Enseignement magique‡魔法训练‡魔法訓練',
    nil,
    'Aprenda Mísseis Arcanos com a Isabella em Plangemortis. Em seguida, pratique Mísseis Arcanos 2 vezes em um Boneco de Treinamento.‡Обучитесь заклинанию "Чародейские стрелы" у Изабеллы в Похоронном Звоне, затем 2 раза испытайте его на тренировочном манекене.‡Erlernt \'Arkane Geschosse\' von Isabella in Todesend und übt die Fähigkeit \'Arkane Geschosse\' 2-mal an einer Trainingsattrappe.‡죽음의 종소리 마을에 있는 이자벨라에게 신비한 화살을 배운 뒤 훈련용 허수아비를 상대로 2회 사용해야 합니다.‡Aprende Misiles Arcanos de Isabella en Camposanto, luego practica Misiles Arcanos 2 veces contra un muñeco de entrenamiento.‡Aprende Misiles Arcanos de Isabella en Camposanto, luego practica Misiles Arcanos 2 veces contra un muñeco de entrenamiento.‡Parlez à Isabella, au Glas, qui vous enseignera les Projectiles des Arcanes, puis entraînez-vous à lancer ce sort 2 fois sur un Mannequin d’entraînement.‡向丧钟镇的伊莎贝拉学习奥术飞弹，然后对一个训练假人施放2次奥术飞弹。‡到喪鐘鎮向伊莎貝拉學習秘法飛彈，然後在練習假人身上練習使用秘法飛彈2次。',
  }
},
[24966] = {
  {
    'Luz e sombras‡О свете и тенях‡Von Licht und Schatten‡빛과 어둠‡De luces y sombras‡De luces y sombras‡La lumière et l\'ombre‡光与影‡光與影之間',
    nil,
    'Treine Cura Célere com o Clérigo das Trevas Duesten em Plangemortis. Depois, pratique o lançamento da Cura Célere 5 vezes nos Necroguardas Feridos.‡Обучитесь заклинанию "Быстрое исцеление" у темного священника Дьюстена в Похоронном Звоне. Затем 5 раз испытайте это заклинание на раненых стражах смерти.‡Erlernt \'Blitzheilung\' vom dunklen Kleriker Duesten in Todesend und übt die Fähigkeit \'Blitzheilung\' 5-mal an verwundeten Todeswachen.‡죽음의 종소리 마을에 있는 어둠의 사제 듀스텐에게 순간 치유를 배운 뒤 부상당한 죽음경비병 5명에게 연습해야 합니다.‡Aprende Sanación relámpago del clérigo oscuro Duesten en Camposanto. Luego, practica Sanación relámpago 5 veces con guardias de la Muerte heridos.‡Aprende Sanación relámpago del clérigo oscuro Duesten en Camposanto. Luego, practica Sanación relámpago 5 veces con guardias de la Muerte heridos.‡Parlez au Sombre clerc Duesten, au Glas, qui vous enseignera les Soins rapides, puis entraînez-vous à lancer ce sort 5 fois sur des Nécrogardes blessés.‡向丧钟镇的黑暗牧师杜斯滕学习快速治疗，然后对受伤的亡灵卫兵施放5次快速治疗。‡從喪鐘鎮的黑暗教士杜斯騰那裏習得快速治療。然後在受傷的亡靈守衛身上練習快速治療5次。',
  }
},
[24967] = {
  {
    'Punhalada!‡Удар кинжалом!‡Stich!‡절개!‡¡Apuñalar!‡¡Apuñalar!‡Étripage‡刺杀！‡戳刺!',
    nil,
    'Aprenda Eviscerar com o Davi Tristão em Plangemortis. Depois, pratique Eviscerar 3 vezes em um Boneco de Treinamento.‡Обучитесь приему "Потрошение" у Давида Триаса в Похоронном Звоне, затем 3 раза испытайте этот прием на тренировочном манекене.‡Erlernt \'Ausweiden\' von David Trias in Todesend und übt die Fähigkeit \'Ausweiden\' 3-mal an einer Trainingsattrappe.‡죽음의 종소리 마을에 있는 데이비드 트리아스에게 절개를 배운 뒤 훈련용 허수아비를 상대로 절개를 3회 연습해야 합니다.‡Aprende Eviscerar de David Trias en Camposanto, luego practica Eviscerar 3 veces contra un muñeco de entrenamiento.‡Aprende Eviscerar de David Trias en Camposanto, luego practica Eviscerar 3 veces contra un muñeco de entrenamiento.‡Parlez à David Trias, au Glas, qui vous enseignera Éviscération, puis entraînez-vous à utiliser cette technique 3 fois sur un Mannequin d’entraînement.‡向丧钟镇的大卫·提亚斯学习刺骨，然后对一个训练假人使用3次刺骨。‡到喪鐘鎮向大衛‧提亞斯學習剔骨，然後在訓練假人身上練習使用剔骨3次。',
  }
},
[24968] = {
  {
    'Proeza sombria‡Темные деяния‡Dunkle Taten‡어둠의 행위‡Acciones oscuras‡Acciones oscuras‡De sombres tâches‡黑暗的魔法‡黑暗之事',
    nil,
    'Aprenda Imolação com o Maximillion em Plangemortis. Depois pratique Imolação 5 vezes em um Boneco de Treinamento.‡Обучитесь заклинанию "Жертвенный огонь" у Максимиллиона в Похоронном Звоне, затем 5 раз испытайте это заклинание на тренировочном манекене.‡Erlernt \'Feuerbrand\' von Maximillion in Todesend und übt die Fähigkeit \'Feuerbrand\' 5-mal an einer Trainingsattrappe.‡죽음의 종소리 마을에 있는 맥시밀리언에게 제물을 배운 뒤 훈련용 허수아비를 상대로 제물을 5회 연습해야 합니다.‡Aprende Inmolar de Maximillion en Camposanto, luego practica lanzando Inmolar 5 veces contra un muñeco de entrenamiento.‡Aprende Inmolar de Maximillion en Camposanto, luego practica lanzando Inmolar 5 veces contra un muñeco de entrenamiento.‡Parlez à Maximillion, au Glas, qui vous enseignera l\'Immolation, puis entraînez-vous à lancer ce sort 5 fois sur un Mannequin d’entraînement.‡向丧钟镇的马克希米林学习献祭，然后对一个训练假人使用5次献祭。‡到喪鐘鎮向馬克希米林學習獻祭，然後在練習假人身上練習施展獻祭5次。',
  }
},
[24969] = {
  {
    'Investindo na batalha‡Устремляясь в бой‡In den Kampf stürmen‡전장으로 돌진!‡Cargando hacia la batalla‡Cargando hacia la batalla‡S’engager au combat‡冲锋陷阵‡衝上戰場',
    nil,
    'Aprenda Investida com o Dannal Stern em Plangemortis. Depois, pratique Investida em um Boneco de Treinamento.‡Обучитесь приему "Рывок" у Даннала Штерна в Похоронном Звоне, затем испытайте этот прием на тренировочном манекене.‡Erlernt \'Sturmangriff\' von Dannal Stern in Todesend und übt die Fähigkeit \'Sturmangriff\' an einer Trainingsattrappe.‡죽음의 종소리 마을에 있는 다날 스턴에게 돌진을 배운 뒤 훈련용 허수아비를 상대로 돌진을 5회 연습해야 합니다.‡Aprende Cargar de Dannal Stern en Camposanto, luego practica Cargar con un muñeco de entrenamiento.‡Aprende Cargar de Dannal Stern en Camposanto, luego practica Cargar con un muñeco de entrenamiento.‡Parlez à Dannal Stern, au Glas, qui vous enseignera la Charge, puis entraînez-vous à utiliser cette technique sur un Mannequin d’entraînement.‡向丧钟镇的丹纳尔·斯特恩学习冲锋，然后对一个训练假人使用冲锋。‡從喪鐘鎮裡的丹納爾‧斯特恩那裡學習衝鋒，然後在訓練假人身上練習使用衝鋒。',
  }
},
[24970] = {
  {
    'Pior que os zumbis‡Не лучше зомби‡Auch nicht besser als die Zombies‡좀비나 다름없는 존재‡No son mejores que los zombis‡No son mejores que los zombis‡Pas mieux que les zombies‡跟僵尸一样烂‡和殭屍沒兩樣',
    nil,
    'Apresente-se ao Darnell em Plangemortis, que fica nas Clareiras de Tirisfal.‡Отчитайтесь Дарнеллу в Похоронном Звоне в Тирисфальских лесах.‡Meldet Euch bei Darnell in Todesend in Tirisfal.‡티리스팔 숲의 죽음의 종소리 마을에 있는 다넬에게 보고해야 합니다.‡Preséntate ante Darnell en Camposanto, en los Claros de Tirisfal.‡Preséntate ante Darnell en Camposanto, en los Claros de Tirisfal.‡Présentez-vous à Darnell au Glas, dans les Clairières de Tirisfal.‡去找提瑞斯法林地丧钟镇的达内尔。‡到提里斯法林地的喪鐘鎮找達納爾報告。',
  }
},
[24971] = {
  {
    'Ataque o Acampamento Miolo Podre‡Нападение на лагерь гнилодумов‡Angriff auf das Lager der Moderhirne‡썩은뇌수 야영지 습격‡Asalto al Campamento Pudrecerebro‡Asalto al Campamento Pudrecerebro‡À l’assaut du camp de Putresprit‡袭击腐脑营地‡突襲腐腦營地',
    nil,
    'Mate o Delegado Trilharrubra e 8 mortos-vivos Miolo Podre.‡Убейте маршала Редпата и 8 гнилодумов-нежитей.‡Tötet Marschall Rotpfad und 8 untote Moderhirne.‡치안대장 레드패스와 썩은뇌수 언데드 8명을 처치해야 합니다.‡Mata al alguacil Rutagrana y a 8 no-muertos Pudrecerebro.‡Mata al alguacil Rutagrana y a 8 no-muertos Pudrecerebro.‡Tuez le Maréchal Senterouge et 8 Morts-vivants de Putresprit.‡杀死治安官雷德帕斯和8个腐脑亡灵。‡殺死治安官雷德帕斯和8名腐腦不死族。',
  }
},
[24972] = {
  {
    'Informações cruciais‡Важные разведданные‡Entscheidende Informationen‡중요한 정보‡Información decisiva‡Información decisiva‡Des renseignements primordiaux‡重要情报‡重要情報',
    nil,
    'Entregue os Documentos da Cruzada Escarlate ao Necroguarda Simério na Propriedade Calston, que fica nas Clareiras de Tirisfal.‡Отнесите бумаги Алого ордена стражу смерти Симмеру в поместье Калстона, что в Тирисфальских лесах.‡Bringt die Dokumente des Scharlachroten Kreuzzugs zu Todeswache Simmer auf dem Calstonanwesen in Tirisfal.‡티리스팔 숲의 칼스턴 영지에 있는 죽음경비병 시머에게 붉은십자군 문서를 전달해야 합니다.‡Entrega los documentos de la Cruzada Escarlata al guardia de la Muerte Simmer en los Dominios de Calston, en los Claros de Tirisfal.‡Entrega los documentos de la Cruzada Escarlata al guardia de la Muerte Simmer en los Dominios de Calston, en los Claros de Tirisfal.‡Apportez les Documents de la Croisade écarlate au Nécrogarde Simmer, qui se trouve au Domaine Calston, dans les Clairières de Tirisfal.‡将血色十字军文件交给提瑞斯法林地的卡尔斯通庄园里的亡灵卫兵希米尔。‡將血色十字軍文件送去提里斯法林地的考斯頓莊園給亡靈守衛希米爾。',
  }
},
[24973] = {
  {
    'Vale Teia da Noite‡Паучья низина‡Nachtweber‡검은그물 거미굴‡Hoya Nocturácnidas‡Hoya Nocturácnidas‡Les grottes des Tisse-nuit‡夜行蜘蛛洞穴‡夜行蜘蛛洞穴',
    nil,
    'Mate 8 Trevateias Jovens e 5 Trevateias.‡Убейте 8 молодых ночных кругопрядов и 5 ночных кругопрядов.‡Tötet 8 junge Nachtweber und 5 Nachtweber.‡새끼 검은그물거미 8마리와 검은그물거미 5마리를 처치해야 합니다.‡Mata a 8 nocturácnidas jóvenes y a 5 nocturácnidas.‡Mata a 8 nocturácnidas jóvenes y a 5 nocturácnidas.‡Tuez 8 Jeunes tisse-nuit et 5 Araignées tisse-nuit.‡杀死8只小夜行蜘蛛和5只夜行蜘蛛。‡殺掉8隻小夜行蜘蛛和5隻夜行蜘蛛。',
  }
},
[24974] = {
  {
    'Tão sozinho‡Невыносимое одиночество‡So schrecklich allein‡평생의 외로움‡100 años de soledad‡100 años de soledad‡Seul, tellement seul‡从未如此孤单‡無盡的寂寞',
    nil,
    'Use a Correia de Murloc em um Murloc Pinavil na Praia Sibilante, e então leve-o para Sedrick Calston, na Propriedade Calston.‡Накиньте поводок на мурлока из племени Злобного Плавника, а затем приведите его Седрику Калстону в поместье Калстона.‡Benutzt die Murlocleine an einem Finsterflossenmurloc an der Flüsternden Küste, dann kehrt mit ihm zu Sedrick Calston am Calstonanwesen zurück.‡속삭임의 해안에 있는 썩은지느러미 멀록에게 멀록 목줄을 사용하고 칼스턴 영지에 있는 세드릭 칼스턴에게 데려가야 합니다.‡Utiliza la correa de múrloc en un múrloc Anca Vil en la Costa Murmurante y, después, entrégaselo a Sedrick Calston en los Dominios de Calston.‡Utiliza la correa de múrloc en un múrloc Anca Vil en la Costa Murmurante y, después, entrégaselo a Sedrick Calston en los Dominios de Calston.‡Servez-vous de la Laisse de murloc sur un murloc Aileron noir du Rivage des Murmures, puis remettez-le à Sedrick Calston, au Domaine Calston.‡在耳语海岸上对一名邪鳍鱼人使用鱼人拴绳，然后带着它去找卡尔斯通庄园的塞德里克·卡尔斯通。‡在耳語海岸將魚人鍊繩使用在一隻邪鰭魚人身上，然後將它帶回考斯頓莊園交給塞德瑞克‧考斯頓。',
  }
},
[24975] = {
  {
    'Campos de mágoa‡Поля Горя‡Felder des Kummers‡오염된 농장‡Campos de pena‡Campos de pena‡Les champs du Chagrin‡悲伤之地‡悲傷之地',
    nil,
    'Roube 10 abóboras da Fazenda dos Solliden, nas Clareiras de Tirisfal.‡Украдите 10 тыкв с усадьбы Соллиден в Тирисфальских лесах.‡Stehlt 10 Kürbisse von Sollidens Bauernhof in Tirisfal.‡티리스팔 숲의 솔리덴 농장에서 티리스팔 호박 10개를 훔쳐야 합니다.‡Roba 10 calabazas de la Hacienda Solliden en Claros de Tirisfal.‡Roba 10 calabazas de la Hacienda Solliden en Claros de Tirisfal.‡Volez 10 Potirons dans la Ferme des Solliden, dans les Clairières de Tirisfal.‡从提瑞斯法林地的索利丹农场中偷10颗南瓜来。‡從提里斯法林地的索利丹農莊偷回10顆南瓜。',
  }
},
[24976] = {
  {
    'A variedade é o tempero da morte‡Разнообразие – вот что придает вкус смерти‡Abwechslung ist die Würze des Todes‡다채로움은 죽음의 양념‡La variedad es la sal de la muerte‡La variedad es la sal de la muerte‡La variété est le piment de la mort‡药剂也要多姿多彩‡變化是死亡的香料',
    nil,
    'Obtenha 4 Métalas, 4 Espinhos-de-xavren e 8 Pepinos-do-mar Salgados.‡Найдите 4 кабачковых цвета, 4 побега ксавренова терна и 8 соленых морских огурцов.‡Besorgt 4 Markblätter, 4 Xavrens Dorn und 8 salzige Seegurken.‡골수화 4개, 자브렌의 가시 4개, 바다 해삼 8개를 모아야 합니다.‡Consigue 4 medupétalos, 4 espinas de Xavren y 8 pepinos de mar curados.‡Consigue 4 medupétalos, 4 espinas de Xavren y 8 pepinos de mar curados.‡Récupérez 4 Myéloflées, 4 Épines de Xavren et 8 Bêches-de-mer saumâtres.‡获得4朵骨髓之花、4根萨维伦之棘，以及8条咸海参。‡收集4株髓瓣，4株薩維倫之棘，以及8個鹹水海參。',
  }
},
[24977] = {
  {
    'A experiência de Joaquino‡Эксперимент Юхана‡Johaans Experiment‡요한의 실험‡El experimento de Johaan‡El experimento de Johaan‡L\'expérience de Johaan‡乔汉的实验‡喬漢的實驗',
    nil,
    'Leve a Abóbora Inoculada para o Zelote Escarlate Capturado no mirante da Propriedade Calston.‡Отнесите отравленную тыкву пленному ревнителю Алого ордена в поместье Калстона.‡Bringt den getränkten Kürbis zu dem gefangenen scharlachroten Zeloten beim Pavillon auf dem Calstonanwesen.‡칼스턴 영지의 전망대에 있는 사로잡힌 붉은십자군 광신도에게 줄무늬 호박을 가져가야 합니다.‡Lleva la calabaza envenenada al zelote Escarlata capturado que se encuentra en la glorieta de los Dominios de Calston.‡Lleva la calabaza envenenada al zelote Escarlata capturado que se encuentra en la glorieta de los Dominios de Calston.‡Donnez le Potiron corsé au Zélote écarlate capturé qui est retenu prisonnier près du belvédère du Domaine Calston.‡将斑纹南瓜交给卡尔斯通庄园瞭望台的被俘虏的血色狂热者。‡將斑紋南瓜帶去給被囚禁在考斯頓莊園涼亭的血色狂熱者。',
  }
},
[24978] = {
  {
    'Ceifando os ceifadores‡Урожай фермеров‡Schnitter der Ernter‡농부 수확하기‡Segar los segadores‡Segar los segadores‡Faucher les faucheurs‡收割收割者‡收割那些農夫',
    nil,
    'Mate 10 Fazendeiros de Tirisfal ou Lavradores de Tirisfal.‡Убейте 10 тирисфальских фермеров или батраков.‡Tötet 10 Bauern von Tirisfal oder Landarbeiter von Tirisfal.‡티리스팔 농부나 티리스팔 농장 일꾼 10명을 처치해야 합니다.‡Mata a 10 granjeros de Tirisfal o mozos de labranza de Tirisfal.‡Mata a 10 granjeros de Tirisfal o mozos de labranza de Tirisfal.‡Tuez 10 Fermiers de Tirisfal ou Journaliers de Tirisfal.‡杀掉10个提瑞斯法农夫或提瑞斯法雇农。‡殺死10名提里斯法農夫或是提里斯法雇農。',
  }
},
[24979] = {
  {
    'Uma carta escarlate‡Письмо Алого ордена‡Ein Scharlachroter Brief‡단홍빛 편지‡La carta Escarlata‡La carta Escarlata‡Une lettre écarlate‡血色信件‡血色書信',
    nil,
    'Encontre a prisioneira na Paliçada Escarlate.‡Разыщите пленницу в Палисаде Алого ордена.‡Findet die Gefangene in der Scharlachroten Palisade.‡단홍빛 울타리에서 죄수를 찾아야 합니다.‡Encuentra a la prisionera en el Acantilado Escarlata.‡Encuentra a la prisionera en el Acantilado Escarlata.‡Trouver la prisonnière à la Palissade Écarlate.‡在血色关哨找到囚犯。‡找到血色護欄裡的俘虜。',
  }
},
[24980] = {
  {
    'A Paliçada Escarlate‡Палисад Алого ордена‡Die Scharlachrote Palisade‡단홍빛 울타리‡El Acantilado Escarlata‡El Acantilado Escarlata‡La palissade Écarlate‡血色关哨‡血色護欄',
    nil,
    'Mate 10 Guerreiros Escarlates.‡Убейте 10 воинов Алого ордена.‡Tötet 10 scharlachrote Krieger.‡붉은십자군 전사 10명을 처치해야 합니다.‡Mata a 10 guerreros Escarlata.‡Mata a 10 guerreros Escarlata.‡Tuez 10 Guerriers écarlates.‡杀死10名血色战士。‡殺死10名血色戰士。',
  }
},
[24981] = {
  {
    'Um espinho em nosso flanco‡Источник неприятностей‡Ein Dorn in unserem Auge‡우리 편의 가시‡Una espina clavada‡Una espina clavada‡Une épine dans notre flanc‡如芒在背‡我們的眼中釘',
    nil,
    'Mate 3 Zelotes Escarlates e 3 Missionários Escarlates e obtenha o Memorando Escarlate Urgente.‡Убейте 3 ревнителей и 3 миссионеров Алого ордена и найдите послание.‡Tötet 3 scharlachrote Zeloten und 3 scharlachrote Missionare und beschafft das dringende scharlachrote Memorandum.‡붉은십자군 광신도 3명, 붉은십자군 선교사 3명을 처치하고 붉은십자군 서한을 획득해야 합니다.‡Mata a 3 zelotes Escarlata y a 3 misioneros Escarlata, y consigue la epístola Escarlata.‡Mata a 3 zelotes Escarlata y a 3 misioneros Escarlata, y consigue la epístola Escarlata.‡Tuez 3 Zélotes écarlates et 3 Missionnaires écarlates, et récupérez l’Épître écarlate.‡杀掉3名血色狂热者和3名血色传教士，拿到血色信函。‡殺死3名血色狂熱者和3名血色傳教士，並且取得血色信函。',
  }
},
[24982] = {
  {
    'Os novos Renegados‡Новые Отрекшиеся‡Die neuen Verlassenen‡새로운 포세이큰‡Los nuevos Renegados‡Los nuevos Renegados‡Les nouveaux Réprouvés‡被遗忘者的新生‡新的被遺忘者',
    nil,
    'Apresente-se ao Magistrado Sevren em Montalvo, que fica nas Clareiras de Tirisfal.‡Поговорите с мировым судьей Севреном в Брилле, что в Тирисфальских лесах.‡Meldet Euch bei Magistrat Sevren in Brill in Tirisfal.‡티리스팔 숲의 브릴에 있는 집정관 세브렌에게 보고해야 합니다.‡Preséntate ante el magistrado Sevren en Rémol en Claros de Tirisfal.‡Preséntate ante el magistrado Sevren en Rémol en Claros de Tirisfal.‡Faites votre rapport au Magistrat Sevren à Brill, dans les Clairières de Tirisfal.‡去找提瑞斯法林地布瑞尔的执政官塞弗伦。‡到提里斯法林地的布瑞爾向執政官塞弗倫回報。',
  }
},
[24983] = {
  {
    'Deveres renegados‡Обязанности Отрекшихся‡Verlassenen-Pflichten‡포세이큰의 의무‡Las obligaciones de los Renegados‡Las obligaciones de los Renegados‡En mission pour les Réprouvés‡亡灵卫兵的职责‡被遺忘者的責任',
    nil,
    'Fale com a Necroguarda Lina na Estação Vigia da Morte, que fica nas Clareiras de Tirisfal.‡Поговорите с Линнеей в Лагере стражей смерти в Тирисфальских лесах.‡Sprecht mit Todeswache Linnea bei der Wegstation Todeswacht in Tirisfal.‡티리스팔 숲의 죽음의 감시자 중계지에 있는 죽음경비병 리니아와 대화해야 합니다.‡Habla con la Guardia de la Muerte Linnea en el Apeadero del ocelo de la Muerte en Claros de Tirisfal.‡Habla con la Guardia de la Muerte Linnea en el Apeadero del ocelo de la Muerte en Claros de Tirisfal.‡Parlez au Nécrogarde Linnea au Relais du Guet de mort, dans les Clairières de Tirisfal.‡与提瑞斯法林地死亡观察站的亡灵卫兵林奈谈一谈。‡與提里斯法林地的死亡看守小站的亡靈守衛林奈交談。',
  }
},
[24984] = {
  {
    '‡Блудный лич‡Der abtrünnige Lich‡회개한 마술사‡El exánime pródigo‡El exánime pródigo‡La liche prodigue‡流浪的巫妖‡',
    nil,
    '‡Поговорите с Гюнтером Чародеем в Приюте Гюнтера, что в Тирисфальских лесах.‡Meldet Euch bei Gunther Arkanus bei Gunthers Zufluchtsort in Tirisfal.‡‡Preséntate ante Gunther Arcanus en el Refugio de Gunther en Claros de Tirisfal.‡‡Faites votre rapport à Gunther Arcanus à la Retraite de Gunther, dans les Clairières de Tirisfal.‡‡',
  }
},
[24985] = {
  {
    '‡Доказательство преданности‡Treuebeweis‡‡Prueba de lealtad‡Prueba de lealtad‡Prouver l\'allégeance‡证明忠诚‡',
    nil,
    '‡Найдите манящую свечу.|n|nпризовите Лилит Нефару и убейте ее.‡Beschafft Euch eine Kerze des Heranlockens.|n|nBeschwört Lillith Nefara und tötet sie.‡‡Consigue una vela de señalización.|n|nInvoca a Lillith Nefara y mátala.‡‡Obtenez une Bougie de signal.|n|nInvoquez Lillith Nefara et tuez-la.‡‡',
  }
},
[24986] = {
  {
    '‡Возвращение блудного лича‡Die Rückkehr des abtrünnigen Lichs‡‡El regreso del exánime pródigo‡El regreso del exánime pródigo‡Le retour de la liche prodigue‡巫妖归顺‡',
    nil,
    '‡Отнесите самоцвет Пустоты Бетору Ледострелу в Подгород.‡Bringt den Netheredelstein zu Bethor Eismacht nach Unterstadt.‡‡Llévale la gema abisal a Bethor Duroyelo en Entrañas.‡Llévale la gema abisal a Bethor Duroyelo en Entrañas.‡Apportez la Gemme du Néant à Bethor Glacéclat à Fossoyeuse.‡将虚空宝石交给幽暗城的比索·埃斯沙德。‡',
  }
},
[24987] = {
  {
    '‡Благоволение Темной Госпожи‡Dunkle Fürstin, behüte uns‡‡La Dama Oscura nos protege‡‡Dame Noire, veille sur nous‡‡',
    nil,
    '‡Поговорите с Леди Сильваной Ветрокрылой в Подгороде.‡Sprecht mit Fürstin Sylvanas Windläufer in Unterstadt.‡‡Habla con Lady Sylvanas Brisaveloz en Entrañas.‡‡Parlez à Dame Sylvanas Coursevent à Fossoyeuse.‡‡',
  }
},
[24988] = {
  {
    'O frio da morte‡Смертельный холод‡Die Kälte des Todes‡죽음의 한기‡El frío de la muerte‡El frío de la muerte‡Le frisson de la mort‡死亡之寒‡死亡之寒',
    nil,
    'Obtenha 5 Pelagens de Quiropúsculo.‡Добудьте 5 шкурок сумеречницы.‡Sammelt fünf Nachtsaugerpelze.‡그늘박쥐 모피 5개를 획득해야 합니다.‡Consigue 5 pelambres de Murciumbrío.‡Consigue 5 pelambres de Murciumbrío.‡Récupérez 5 Peaux de chauve-souris de la pénombre.‡带回5张夜行蝙蝠的毛皮.‡取得5張夜行蝙蝠的毛皮。',
  }
},
[24989] = {
  {
    'De volta ao Magistrado‡Возвращение к мировому судье‡Rückkehr zum Magistrat‡집정관에게 돌아가기‡Regresa junto al magistrado‡Regresa junto al magistrado‡Retourner voir le magistrat‡向塞弗伦回报‡向執政官回報',
    nil,
    'Fale novamente com o Magistrado Sevren em Montalvo.‡Вернитесь к мировому судье Севрену в Брилл.‡Kehrt zu Magistrat Sevren nach Brill zurück.‡브릴에 있는 집정관 세브렌에게 가야 합니다.‡Ve a ver de nuevo al magistrado Sevren de Rémol.‡Ve a ver de nuevo al magistrado Sevren de Rémol.‡Retournez voir le Magistrat Sevren à Brill.‡向布瑞尔的执政官塞弗伦报告。‡回去布瑞爾找執政官塞弗倫。',
  }
},
[24990] = {
  {
    'Praga do cão‡Смерть от псов Тьмы‡Herzschlag der Schattenhunde‡암흑사냥개 사냥‡Análisis de sangre‡Análisis de sangre‡La pâtée des sombredogues‡采血‡黑暗犬的猛襲',
    nil,
    'Colete 5 ampolas de Sangue de Cão das Trevas.‡Наполните 5 сосудов кровью псов Тьмы.‡Sammelt 5 Phiolen Schattenhundblut.‡암흑사냥개 피 5병을 모아야 합니다.‡Recoge 5 viales de sangre de can oscuro.‡Recoge 5 viales de sangre de can oscuro.‡Collectez 5 fioles de Sang de sombredogue.‡收集5瓶黑暗犬的血液。‡收集5瓶黑暗犬的血液。',
  }
},
[24991] = {
  {
    'Sítio dos Garren‡Ферма Гаррена‡Garrens Schlupfwinkel‡가렌의 흉가‡La Granja de Garren‡La Granja de Garren‡L\'antre de Garren‡加伦鬼屋‡加倫鬼屋',
    nil,
    'Apresente-se ao Boticário Jarbas no Sítio dos Garren, que fica nas Clareiras de Tirisfal.‡Поговорите с аптекарем Джерродом на ферме Гаррена в Тирисфальских лесах.‡Meldet Euch bei Apotheker Jerrod bei Garrens Schlupfwinkel in Tirisfal.‡티리스팔 숲의 가렌의 흉가에 있는 연금술사 제로드에게 보고해야 합니다.‡Preséntate ante el boticario Jerrod en la Granja de Garren en Claros de Tirisfal.‡Preséntate ante el boticario Jerrod en la Granja de Garren en Claros de Tirisfal.‡Faites votre rapport à l\'Apothicaire Jerrod dans l\'Antre de Garren, dans les Clairières de Tirisfal.‡去找提瑞斯法林地加伦鬼屋的药剂师杰罗德。‡向位於提里斯法林地內加倫鬼屋的藥劑師傑洛德報告。',
  }
},
[24992] = {
  {
    'Fuga de Guilnéas‡Сбежавшие из Гилнеаса‡Aus Gilneas entflohen‡길니아스에서 탈출한 자들‡La huida de Gilneas‡La huida de Gilneas‡Échappé de Gilnéas‡逃离吉尔尼斯‡逃出吉爾尼斯',
    nil,
    'Informe o Executor Zigano, em Montalvo, nas Clareiras de Tirisfal, sobre a presença do worgen.‡Отправляйтесь в Брилл и доложите палачу Зуганду о присутствии воргенов в Тирисфальских лесах.‡Berichtet Exekutor Zygand in Brill in Tirisfal von der Anwesenheit des Worgen.‡티리스팔 숲의 브릴에 있는 집행관 자이건드에게 늑대인간의 존재를 보고해야 합니다.‡Informa de la presencia del huargen al ejecutor Zygand en Rémol en Claros de Tirisfal.‡Informa de la presencia del huargen al ejecutor Zygand en Rémol en Claros de Tirisfal.‡Signalez la présence des worgens à l\'Exécuteur Zygand à Brill, dans les Clairières de Tirisfal.‡将狼人的存在报告给提瑞斯法林地布瑞尔的执行官塞加德。‡將狼人的出現回報給提里斯法林地的執行官塞加德。',
  }
},
[24993] = {
  {
    '‡Уничтожить воргенов‡Vernichtet die Worgen‡늑대인간을 처단하라‡Aniquilar a los huargen‡‡Annihiler les worgens‡‡',
    nil,
    '‡Найдите и убейте 5 воргенов-разведчиков на территории Брилла.‡Findet und tötet 5 Spitzel der Worgen in Brill.‡브릴에 있는 늑대인간 침투요원 5명을 찾아 처치해야 합니다.‡Encuentra y mata a 5 infiltrados huargen en Rémol.‡‡Trouvez et tuez 5 Infiltrateurs worgens à Brill.‡‡',
  }
},
[24994] = {
  {
    'Erva-do-demo‡Погибельник‡Verdammniskraut‡죽음풀‡Apocalíseas‡Apocalíseas‡Herbe maléfique‡末日草‡末日草',
    nil,
    'Colha 10 Ervas-do-demo.‡Соберите 10 веток погибельника.‡Sammelt 10 Verdammniskraut.‡죽음풀 10개를 모아야 합니다.‡Recoge 10 apocalíseas.‡Recoge 10 apocalíseas.‡Récoltez 10 Herbes maléfiques.‡收集10株末日草。‡收集10份末日草。',
  }
},
[24995] = {
  {
    'O esquema da escama‡Чешуя – залог успеха‡Wie Schuppen von den Augen‡비늘 찾아 삼만리‡Escamas fuera‡Escamas fuera‡Besoin d\'écailles‡刮鳞‡剝除鱗片',
    nil,
    'Obtenha 5 Escamas de Pinavil.‡Добудьте 5 чешуек мурлоков из племени Злобного Плавника.‡Beschafft 5 Finsterflossenschuppen.‡썩은지느러미 비늘 5개를 모아야 합니다.‡Consigue 5 escamas de Anca Vil.‡Consigue 5 escamas de Anca Vil.‡Obtenir 5 Écailles d\'Aileron noir.‡获得5枚邪鳍鱼人的鳞片。‡收集5個邪鰭魚人的鱗片。',
  }
},
[24996] = {
  {
    'O experimento de Hollanda‡Эксперимент Холланда‡Hollands Experiment‡홀랜드의 실험‡El experimento de Holland‡El experimento de Holland‡L\'expérience de Holland‡霍兰德的实验‡霍蘭德的實驗',
    nil,
    'Dê a Bebida Especial de Hollanda para o Montanhista Capturado.‡Отнесите особый напиток Холланда пленному горному пехотинцу.‡Bringt Hollands Spezialgetränk zu dem gefangenen Gebirgsjäger.‡산악경비대 포로에게 홀랜드의 특별조제약을 가져가야 합니다.‡Lleva la bebida especial de Holland al montaraz capturado.‡Lleva la bebida especial de Holland al montaraz capturado.‡Apportez la Boisson spéciale de Holland au Montagnard capturé.‡将霍兰德的神奇饮料带给被俘虏的巡山人。‡帶著霍蘭德的特製飲料去找被俘虜的巡山人。',
  }
},
[24997] = {
  {
    'Roubacovas‡Грабители могил‡Grabräuber‡묘지 도굴꾼‡Profanadores‡Profanadores‡Les profanateurs‡盗墓贼‡盜墓賊',
    nil,
    'Mate Roubacovas Putricouro e Mestiços Putricouro e obtenha deles 6 frascos de Linfa Embalsamadora.‡Убивайте грабителей могил и полукровок из стаи Гнилошкуров и добудьте 6 образцов бальзамирующей лимфы.‡Tötet Grabräuber der Moderfelle und Bastarde der Moderfelle und sammelt 6 Fläschchen voll Einbalsamierungssekreten.‡썩은가죽 도굴꾼 8마리와 썩은가죽 싸움꾼 5마리를 처치하고 이들에게서 불변의 영액 8개를 모아야 합니다.‡Mata profanadores y bastardos Putrepellejo y consigue 6 frascos de icor embalsamante.‡Mata profanadores y bastardos Putrepellejo y consigue 6 frascos de icor embalsamante.‡Tuez des Profanateurs poil-putride et des Bâtards poil-putride pour obtenir 6 fioles d\'Ichor d\'embaumement.‡杀死腐皮盗墓贼和混血腐皮豺狼人。|n|n弄到6瓶防腐剂。‡殺死腐皮盜墓賊和混血腐皮豺狼人，並且取得6瓶防腐劑。',
  }
},
[24998] = {
  {
    'Olho de Verme‡Червеглаз‡Madenauge‡구더기눈‡Ojo de cresa‡Ojo de cresa‡Œil-de-ver‡蛆眼‡蛆眼',
    nil,
    'Mate Olho de Verme e obtenha sua pata.‡Убейте Червеглаза и отрежьте у него лапу.‡Tötet Madenauge und erbeutet seine Tatze.‡구더기눈을 처치하고 구더기눈의 앞발을 획득해야 합니다.‡Mata a Ojo de cresa y consigue su zarpa.‡Mata a Ojo de cresa y consigue su zarpa.‡Tuez Œil-de-ver et récupérez sa patte.‡杀死蛆眼，拿到他的爪子。‡殺死蛆眼並取得他的爪子。',
  }
},
[24999] = {
  {
    'Plantando a semente do medo‡Посеять страх‡Die Saat der Furcht pflanzen‡공포의 씨앗을 심어라‡La semilla del miedo‡La semilla del miedo‡Planter les graines de la peur‡播下恐惧的种子‡種下恐懼的種子',
    nil,
    'Persiga 12 Girinos Pinavil até que eles desmaiem de medo.‡Преследуйте 12 головастиков племени Злобного Плавника, пока они не потеряют сознание от страха.‡Jagt 12 Kaulquappen der Finsterflossen, bis sie vor Angst ohnmächtig werden.‡어린 썩은지느러미 멀록 12마리가 두려움에 기절할 때까지 쫓아가야 합니다.‡Persigue a 12 renacuajos Anca Vil hasta que se desmayen de miedo.‡Persigue a 12 renacuajos Anca Vil hasta que se desmayen de miedo.‡Pourchassez 12 Têtards ailerons noirs jusqu’à ce qu’ils s’évanouissent de frayeur.‡追逐12条邪鳍鱼人蝌蚪，直到它们因恐惧而虚脱。‡追趕12隻邪鰭蝌蚪直到牠們嚇昏。',
  }
},
[25000] = {
  {
    'O pessoal de Timeu‡Люди Тигана‡Teegans Leute‡티간의 동료들‡El pueblo de Teegan‡El pueblo de Teegan‡Les gars de Teegan‡缇甘的部下‡提根的同胞',
    nil,
    'Mate Deimodontes Velossauro e Deimodontes Garrafoice para coletar 8 Pelegos de Deimodonte.‡Добудьте 8 шкур страхокусов, убивая луговых страхокусов и зубастых страхокусов.‡Tötet Schreckenszahnläufer und Schreckenszahnsensenklauen, um 8 Schreckenszahnbälge zu erhalten.‡빠른발 큰이빨랩터와 갈퀴발톱 큰이빨랩터를 처치하여 큰이빨랩터 가죽 8장을 모아야 합니다.‡Mata a corredores y segadores Dienterror y reúne 8 pellejos de Dienterror.‡Mata a corredores y segadores Dienterror y reúne 8 pellejos de Dienterror.‡Tuez des Coureurs et des Faucheurs Dents-d’effroi pour récolter 8 Peaux de dent-d’effroi.‡杀死恐齿疾步龙和恐齿镰爪龙，从它们身上收集8张恐齿迅猛龙的皮。‡殺死懼齒奔跑者和懼齒鐮爪龍以收集8個懼齒皮革。',
  }
},
[25001] = {
  {
    'Ranhareias‡Пескоскреб‡Sandscharrer‡모래싸움꾼‡Rascadunas‡Rascadunas‡Gratte-sable‡碎沙者‡鏟沙者',
    nil,
    'Mate Ranhareias.‡Убить Пескоскреба.‡Tötet Sandscharrer.‡모래싸움꾼을 처치해야 합니다.‡Mata a Rascadunas.‡Mata a Rascadunas.‡Tuez Gratte-sable.‡杀掉碎沙者。‡殺死鏟沙者。',
  }
},
[25002] = {
  {
    '"Raptor" é outro jeito de dizer "Ladrão"‡Припасы‡Beute‡시체 수색‡Hurgando‡Hurgando‡Dévorés vivants‡抢救物资‡撿寶',
    nil,
    'Recupere 10 Caixotes de Suprimentos da Guardanorte do Covil dos Raptores.‡Верните 10 ящиков с припасами Северной Стражи из логовищ ящеров.‡Holt 10 Vorratskisten der Nordwacht aus dem Raptorennest heraus.‡랩터 소굴을 뒤져 북부감시 보급품 상자 10개를 되찾아야 합니다.‡Consigue 10 cajones de suministros de Fuerte del Norte en la guarida de los raptores.‡Consigue 10 cajones de suministros de Fuerte del Norte en la guarida de los raptores.‡Retrouvez 10 Caisses de fournitures de Guet-du-Nord dans les nids des raptors.‡从迅猛龙巢穴中取回10只北卫军补给箱。‡從迅猛龍巢穴取回10個北方補給箱。',
  }
},
[25003] = {
  {
    'A cripta da família‡Семейный склеп‡Die Familiengruft‡아가만드가 납골당‡La Cripta de la Familia‡La Cripta de la Familia‡La crypte familiale‡家族墓穴‡家族墓穴',
    nil,
    'Mate 5 Ancestrais Ululantes e 5 Ancestrais Apodrecidos.‡Убейте 5 стенающих прародительниц и 5 гниющих предков.‡Tötet 5 klagende Vorfahrinnen und faulende Vorfahren.‡울부짖는 아가만드 망령 5마리와 썩어가는 아가만드 시체 5마리를 처치해야 합니다.‡Mata a 5 ancestros gemebundos y a 5 ancestros en podredumbre.‡Mata a 5 ancestros gemebundos y a 5 ancestros en podredumbre.‡Tuez 5 Ancêtres gémissantes et 5 Ancêtres pourrissants.‡杀死5只哀嚎的鬼魂和5只腐烂的古尸。‡殺死5名哀嚎的鬼魂和5名腐爛的古屍。',
  }
},
[25004] = {
  {
    'Os moinhos invadidos‡Нападение на мельницы‡Die überrannte Mühle‡제분소 습격‡La invasión de los molinos‡La invasión de los molinos‡La chute des moulins‡磨坊告急‡磨坊告急',
    nil,
    'Colete 5 Costelas Carcomidas e 3 Crânios Enegrecidos.‡Соберите 5 зазубренных ребер и 3 почерневших черепа.‡Sammelt 5 schartige Rippen und 3 geschwärzte Schädel.‡톱니모양 늑골 5개와 저주받은 해골 3개를 모아야 합니다.‡Reúne 5 costillas con cortes y 3 calaveras ennegrecidas.‡Reúne 5 costillas con cortes y 3 calaveras ennegrecidas.‡Rapportez 5 Côtes ébréchées et 3 Crânes noircis.‡收集5根锯齿肋骨和3个焦黑的徽记。‡收集5個凹槽肋骨和3個焦黑的顱骨。',
  }
},
[25005] = {
  {
    'Fale com Sevren‡Разговор с Севреном‡Sprecht mit Sevren‡세브렌과의 대화‡Habla con Sevren‡Habla con Sevren‡Parler à Sevren‡与塞弗伦交谈‡與塞弗倫交談',
    nil,
    'Fale com o Magistrado Sevren em Montalvo, nas Clareiras de Tirisfal.‡Поговорите с мировым судьей Севреном в Брилле, что в Тирисфальских лесах.‡Sprecht mit Magistrat Sevren in Brill in Tirisfal.‡티리스팔 숲의 브릴에 있는 집정관 세브렌과 대화해야 합니다.‡Habla con el magistrado Sevren en Rémol en Claros de Tirisfal.‡Habla con el magistrado Sevren en Rémol en Claros de Tirisfal.‡Parlez au Magistrat Sevren à Brill dans les Clairières de Tirisfal.‡跟提瑞斯法林地布瑞尔的执政官塞弗伦谈一谈。‡在提里斯法林地的布瑞爾與執政官塞弗倫交談。',
  }
},
[25006] = {
  {
    'O jugo enfraquece‡Слабеющая хватка‡Der Griff lockert sich‡약해진 지배력‡El yugo debilitado‡El yugo debilitado‡L\'étreinte se desserre‡虚弱的掌握‡虛弱的控制',
    nil,
    'Fale com a Sacerdotisa Sombria Malia em Montalvo e participe da extração de informações de Delmiro Agamand.‡Поговорите с темной жрицей Малией в Брилле и поучаствуйте в освобождении Девлина Агамонда.‡Sprecht mit Schattenpriesterin Malia in Brill und nehmt an der Extrahierung von Devlin Agamand teil.‡브릴에 있는 어둠의여사제 말리아와 대화하고 데블린 아가만드의 지식 추출 작업에 참여해야 합니다.‡Habla con la sacerdotisa de las Sombras Malia en Rémol y participa en la extracción de Devil Agamand.‡Habla con la sacerdotisa de las Sombras Malia en Rémol y participa en la extracción de Devil Agamand.‡Parlez à la Prêtresse des ombres Malia à Brill et participez à l\'extraction de Devlin Agamand.‡跟布瑞尔的暗影牧师玛利亚谈一谈，然后参与代弗林·阿加曼德的意志唤醒。‡與布瑞爾的暗影牧師馬里雅交談，並且加入抽離戴弗林·阿加曼德的儀式。',
  }
},
[25007] = {
  {
    'Leste... Sempre para o leste‡На восток, и только на восток!‡Osten... Stets nach Osten‡동쪽으로... 늘 그랬듯이 동쪽으로‡Este... siempre al este‡Este... siempre al este‡À l\'est... Toujours plus à l\'est‡东边……又是东边‡東方...永遠朝向東方',
    nil,
    'Apresente-se ao Alto-executor Arcabuz no Baluarte, que fica nas Clareiras de Tirisfal.‡Поговорите с верховным палачом Деррингтоном в Бастионе, что в Тирисфальских лесах.‡Meldet Euch bei Hochexekutor Derrington am Bollwerk in Tirisfal.‡티리스팔 숲의 보루에 있는 고위집행관 데링턴에게 보고해야 합니다.‡Preséntate ante el sumo ejecutor Derrington en El Baluarte en Claros de Tirisfal.‡Preséntate ante el sumo ejecutor Derrington en El Baluarte en Claros de Tirisfal.‡Faites votre rapport au Grand exécuteur Derrington à la Barricade, dans les Clairières de Tirisfal.‡去找提瑞斯法林地亡灵壁垒的高级执行官德灵顿。‡到提里斯法林地的亡靈壁壘向高階執行官德靈頓回報。',
  }
},
[25008] = {
  {
    'Animais imundos‡Грязные животные‡Schmutzige Tiere‡추악한 짐승들‡Animales mugrientos‡Animales mugrientos‡Sales bêtes‡肮脏的动物‡骯髒的動物',
    nil,
    'Mate 6 Carniceiros Presavaia.‡Убейте 6 зубастых падальщиков.‡Tötet 6 Fleischreißerstrauchdiebe.‡청소부 빗송곳니하이에나 6마리를 처치해야 합니다.‡Mata a 6 carroñeros Dentecenado.‡Mata a 6 carroñeros Dentecenado.‡Tuez 6 Charognards Jappecroc.‡杀死6只乱齿清道夫。‡殺死6隻亂齒食腐狼。',
  }
},
[25009] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Im Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'Mate 3 Zelotes Escarlates e 4 Frades Escarlates.‡Убейте 3 ревнителей и 4 келейников Алого ордена.‡Tötet 3 Scharlachrote Zeloten und 4 Scharlachrote Ordensmitglieder.‡붉은십자군 광신도 3명과 붉은십자군 수사 4명을 처치해야 합니다.‡Mata a 3 zelotes Escarlata y a 4 frailes Escarlata.‡Mata a 3 zelotes Escarlata y a 4 frailes Escarlata.‡Tuez 3 Zélotes écarlates et 4 Frères écarlates.‡杀死3名血色狂热者和4名血色苦行修士。‡殺死3名血色狂熱者和4名血色苦行修士。',
  }
},
[25010] = {
  {
    'Uma nova aliada mortal‡Смертельный союзник‡Ein tödlicher neuer Verbündeter‡죽음을 부르는 새로운 아군‡Un nuevo aliado mortal‡Un nuevo aliado mortal‡Une redoutable nouvelle alliée‡致命的新盟友‡致命的新盟友',
    nil,
    'Encontre sua nova aliada no Acampamento Escarlate, nas Clareiras de Tirisfal.‡Разыщите новую союзницу на Заставе Алого ордена в Тирисфальских лесах.‡Findet Euren neuen Verbündeten in der Scharlachroten Lagerstatt in TIrisfal.‡티리스팔 숲의 진홍빛 야영지에서 새로운 아군을 찾아야 합니다.‡Busca a tu nueva aliada en el Campamento Escarlata en Claros de Tirisfal.‡Busca a tu nueva aliada en el Campamento Escarlata en Claros de Tirisfal.‡Cherchez votre nouvelle alliée dans le Campement Écarlate, dans les Clairières de Tirisfal.‡在提瑞斯法林地血色营地寻找你的新盟友。‡到提里斯法林地的血色駐營尋找你的新盟友。',
  }
},
[25011] = {
  {
    'Maiores e melhores aventuras‡К большому и светлому будущему‡Auf zu besseren und größeren Taten‡더 크고 나은 일들‡Mejor y más grande‡Mejor y más grande‡Dans la cour des grands‡又大又好的东西‡更大更好的東西',
    nil,
    'Fale com Timóteo Canorus no Baluarte, que fica nas Clareiras de Tirisfal.‡Поговорите с Тимоти Каннингхемом в Бастионе, что в Тирисфальских лесах.‡Sprecht mit Timothy Cunningham am Bollwerk in Tirisfal.‡티리스팔 숲의 보루에 있는 티모시 커닝험과 대화해야 합니다.‡Habla con Timothy Cunningham en El Baluarte, en Claros de Tirisfal.‡Habla con Timothy Cunningham en El Baluarte, en Claros de Tirisfal.‡Parlez à Timothy Cunningham à la Barricade, dans les Clairières de Tirisfal.‡跟提瑞斯法林地亡灵壁垒的提摩西·卡宁汉谈一谈。‡與提里斯法林地的提摩西·卡汀漢交談。',
  }
},
[25012] = {
  {
    'Subindo aos céus‡Послание на тот свет‡Schwingt Euch in die Lüfte‡저 하늘을 날아서‡Hasta el infinito y más allá‡Hasta el infinito y más allá‡Un tour dans les airs‡飞向天空‡飛向天空',
    nil,
    'Fale com o Executor Zigano em Montalvo, que fica nas Clareiras de Tirisfal.‡Поговорите с палачом Зугандом в Брилле, что в Тирисфальских лесах.‡Sprecht mit Exekutor Zygand in Brill in Tirisfal.‡티리스팔 숲의 브릴에 있는 집행관 자이건드와 대화해야 합니다.‡Habla con el ejecutor Zygand en Rémol, en Claros de Tirisfal.‡Habla con el ejecutor Zygand en Rémol, en Claros de Tirisfal.‡Allez voir l\'Exécuteur Zygand à Brill, dans les Clairières de Tirisfal.‡跟提瑞斯法林地布瑞尔的执行官塞加德谈一谈。‡在提里斯法林地的布瑞爾與執行官塞加德交談。',
