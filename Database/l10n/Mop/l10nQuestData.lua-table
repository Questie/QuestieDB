},
[29074] = {
  {
    'Tempo de celebrar‡Время праздника‡Eine Zeit zum Feiern‡축제의 계절‡Temporada de celebración‡Temporada de celebración‡La saison des fêtes‡庆祝的季节‡慶祝的季節',
    nil,
    'Fale com Celestine da Colheita em frente aos portões de Ventobravo.‡Поговорите с Целестиной Урожайной за воротами Штормграда.‡Sprecht mit Celestine Erntedank vor den Toren Sturmwinds.‡스톰윈드 성문 바로 밖에 있는 풍요의 셀레스틴과 대화해야 합니다.‡Habla con Celestina de la Cosecha, al exterior de las puertas de Ventormenta.‡Habla con Celestina de la Cosecha, al exterior de las puertas de Ventormenta.‡Allez voir Célestine de la Moisson devant les portes de Hurlevent.‡与暴风城大门外的丰收女巫塞莱斯廷交谈。‡到暴風城門外與『豐收』瑟萊斯丁說話。',
  }
},
[29075] = {
  {
    'Época de ganhar‡Время обретать‡Eine Zeit des Gewinnens‡평화를 얻을 시간‡Un momento para ganar‡Un momento para ganar‡Un temps pour gagner‡收获的时刻‡增長的時刻',
    nil,
    'Use a fogueira em frente ao Homem de Palha.‡Воспользуйтесь большим костром, разоженным перед Плетеным человеком.‡Benutzt das Freudenfeuer vor dem Weidenmann.‡밀짚인형 앞에 있는 화톳불을 사용해야 합니다.‡Utiliza la hoguera que hay frente al Hombre de Mimbre.‡Utiliza la hoguera que hay frente al Hombre de Mimbre.‡Utilisez le Feu de joie devant l\'homme d\'osier.‡使用稻草人前面的篝火。‡在稻草人的前面使用營火。',
  }
},
[29076] = {
  {
    'Missão de teste do Kevin‡Kevin\'s Test Quest‡Kevin\'s Test Quest‡케빈의 테스트 퀘스트‡Kevin\'s Test Quest‡Kevin\'s Test Quest‡Quête de test de Kevin‡凯文的测试任务‡凱文的測試任務',
    nil,
    'Basta completar a missão.‡Just complete it.‡Einfach abschließen.‡그냥 완료해.‡Just complete it.‡Just complete it.‡Terminez-la.‡完成它。‡請完成它。',
  }
},
[29077] = {
  {
    '‡Курорт, который построил Ботт‡Was hat Dodd gewirkt‡‡¿Qué ha hecho Dodd?‡‡Mais qu\'a donc fait Dodd ?‡‡',
    nil,
    '‡Убейте 50 кипящих водных элементалей и 20 сумеречных призывателей.‡Tötet 50 wutentbrannte Wasserelementare und 20 Beschwörer des Schattenhammers.‡‡Mata a 50 elementales de agua hirviente y a 20 invocadores Crepusculares.‡‡Tuez 50 Elémentaires d\'eau bouillonnants et 20 Invocateur du Crépuscule.‡‡',
  }
},
[29078] = {
  {
    'É hora de reagir‡Дать отпор!‡Schlagt sie zurück!‡격퇴!‡¡Rechazar el ataque!‡¡Rechazar el ataque!‡Repoussez-les !‡击退敌人！‡打退他們!',
    nil,
    'Mate 6 Worgs de Batalha Rocha Negra.‡Убейте 6 боевых воргов клана Черной горы.‡Tötet 6 Kampfworgs des Schwarzfels.‡검은바위 전투늑대 6마리를 처치해야 합니다.‡Mata a 6 huargos de batalla Roca Negra.‡Mata a 6 huargos de batalla Roca Negra.‡Tuez 6 Worgs de guerre rochenoires.‡杀死6只黑石战狼。‡殺死6名黑石作戰座狼。',
  }
},
[29079] = {
  {
    'Leões e cordeiros‡Волки и овцы‡Worgs im Schafspelz‡영리한 오크 첩자들‡Leones por corderos‡Leones por corderos‡Le lion et l\'agneau‡狮入羊口‡獅兵羊將',
    nil,
    'Mate 8 Espiões Rocha Negra.‡Убейте 8 шпионов клана Черной горы.‡Tötet 8 Spione des Schwarzfels.‡검은바위 첩보원 8명을 처치해야 합니다.‡Mata a 8 espías Roca Negra.‡Mata a 8 espías Roca Negra.‡Tuez 8 Espions rochenoires.‡消灭8名黑石间谍。‡殺死8名黑石間諜。',
  }
},
[29080] = {
  {
    'Vila Norte precisa de você‡В бой!‡Stürzt Euch in die Schlacht!‡전투에 참전하라!‡¡Únete a la batalla!‡¡Únete a la batalla!‡Rejoignez la bataille !‡加入战斗！‡加入戰局!',
    nil,
    'Fale novamente com o Sargento Willem atrás da Abadia de Vila Norte, que fica na Floresta de Elwynn.‡Явитесь к сержанту Виллему, находящемуся за Аббатством Североземья.‡Meldet Euch bei Unteroffizier Willem hinter der Abtei von Nordhain im Wald von Elwynn‡엘윈 숲의 북녘골 수도원 뒤편에 있는 하사관 윌렘에게 보고해야 합니다.‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡Présentez-vous au Sergent Willem derrière l’Abbaye de Comté-du-Nord, dans la Forêt d’Elwynn.‡向艾尔文森林北郡修道院后的维里副队长报到。‡到艾爾文森林後面的北郡修道院找維里中士。',
  }
},
[29081] = {
  {
    'Assassinos de aluguel‡Они подослали убийц‡Sie haben Auftragsmörder losgeschickt‡저들이 보낸 암살자들‡Enviaron asesinos‡Enviaron asesinos‡Ils ont envoyé des assassins‡他们派来了刺客‡他們派來的刺客',
    nil,
    'Mate 8 Goblins Assassinos.‡Убейте 8 гоблинов-убийц.‡Tötet 8 goblinische Auftragsmörder.‡고블린 암살자 8명을 처치해야 합니다.‡Mata a 8 asesinos goblins.‡Mata a 8 asesinos goblins.‡Tuez 8 Assassins gobelins.‡杀死8名地精刺客。‡殺死8名哥布林暗殺者。',
  }
},
[29082] = {
  {
    'Livra-nos do mal‡Не убойся зла‡Fürchtet nicht das Böse‡악을 두려워하지 마라‡No temerás peligro alguno‡No temerás peligro alguno‡Même pas peur‡别畏惧邪恶‡無懼邪惡',
    nil,
    'Reanime 4 Soldados de Ventobravo Feridos.‡Исцелите 4 раненых пехотинцев Штормграда.‡Belebt 4 verletzte Soldaten von Sturmwind wieder.‡부상당한 스톰윈드 보병 4명을 되살려야 합니다.‡Revive a 4 soldados de Ventormenta heridos.‡Revive a 4 soldados de Ventormenta heridos.‡Ranimez 4 Soldats blessés de Hurlevent.‡营救4名受伤的暴风城士兵。‡治療四名受傷的暴風城士兵。',
  }
},
[29083] = {
  {
    'A retaguarda está livre‡В тылу все спокойно‡Gefahr gebannt‡후방 정리 완료‡Retaguardia despejada‡Retaguardia despejada‡La zone est dégagée‡后方已经安全‡後顧無憂',
    nil,
    'Apresente-se ao Major Belmonte na Abadia de Vila Norte, que fica na Floresta de Elwynn.‡Отправляйтесь с докладом к маршалу Макбрайду. Его можно найти перед Аббатством Североземья, что в Элвиннском лесу.‡Meldet Euch bei Marschall McBride vor der Abtei von Nordhain im Wald von Elwynn.‡엘윈 숲의 북녘골 수도원에 있는 치안대장 맥브라이드에게 보고해야 합니다.‡Preséntate ante el alguacil McBride frente a la Abadía de Villanorte, en el Bosque de Elwynn.‡Preséntate ante el alguacil McBride frente a la Abadía de Villanorte, en el Bosque de Elwynn.‡Présentez-vous au Maréchal McBride devant l’Abbaye de Comté-du-Nord, dans la Forêt d’Elwynn.‡向艾尔文森林北郡修道院前的治安官玛克布莱德报到。‡到艾爾文森林的北郡修道院前面找治安官瑪克布萊德回報。',
  }
},
[29084] = {
  {
    'Aleatória Clássica 35-39 (1ª)‡Classic Random 35-39 (1st)‡Zufälliger, klassischer Dungeon 35-39 (Erster)‡Classic Random 35-39 (1st)‡Classic Random 35-39 (1st)‡Classic Random 35-39 (1st)‡Classique aléatoire 35-39 (1e)‡经典旧世随机 35-39级 （第一次）‡隨機職業35-39 (第一次)',
