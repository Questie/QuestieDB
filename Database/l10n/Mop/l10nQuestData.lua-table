    nil,
  }
},
[27115] = {
  {
    'O chamado de Teles‡Зов Андо‡Andos Ruf‡안도에게로‡La llamada de Ando‡La llamada de Ando‡L’appel d’Ando‡安多的召唤‡安多的召喚',
    nil,
    'Fale com Teles Plosivo.‡Поговорите с Андо Подрывайстером.‡Sprecht mit Ando Blastenheimer.‡안도 블라스텐하이머와 대화해야 합니다.‡Habla con Ando Pimpampum.‡Habla con Ando Pimpampum.‡Parlez à Ando Explonheimer.‡跟安多·雷管谈一谈。‡和安多‧布萊頓海默說話。',
  }
},
[27116] = {
  {
    'Os ventos de Loch Modan‡Ветра Лок Модана‡Die Winde von Loch Modan‡모단 호수의 바람‡Las alas de Loch Modan‡Las alas de Loch Modan‡Les vents du loch Modan‡洛克莫丹的风‡洛克莫丹之風',
    nil,
    'Vá até a Estação Algaz a bordo do Navestruz e fale com o Montanhista Lançatroz.‡Отправляйтесь на небесном долгоноге не станцию Альгаз и поговорите там с горным пехотинцем Грозовой Вершиной.‡Fliegt mit dem Himmelsschreiter zur Station Algaz und sprecht dann mit Gebirgsjäger Sturmlanze.‡알가즈 주둔지까지 하늘타조를 타고 간 후 그곳에 있는 산악경비대 스톰파이크와 대화해야 합니다.‡Conduce el zancudo volador hasta la Estación de Algaz y después habla con el montaraz Pico Tormenta.‡Conduce el zancudo volador hasta la Estación de Algaz y después habla con el montaraz Pico Tormenta.‡Prenez le Trotte-ciel jusqu’au Poste d’Algaz, puis parlez au Montagnard Foudrepique.‡乘天行者前往奥加兹岗哨，然后跟巡山人雷矛谈一谈。‡騎乘機械空行鳥前往奧加茲崗哨，然後和巡山人雷矛說話。',
  }
},
[27117] = {
  {
    'Força bruta‡Грубая сила‡Rohe Gewalt‡강대한 라베니안‡Fuerza bruta‡Fuerza bruta‡Force brute‡蛮力‡蠻力',
    nil,
    'Mate o Corvino em Andorhal.‡Убейте Равениана в Андорале.‡Tötet den Ravenier in Andorhal.‡안돌할 안에 있는 라베니안을 처치해야 합니다.‡Mata a El Devorador en Andorhal.‡Mata a El Devorador en Andorhal.‡Tuez le Voracien à Andorhal.‡杀死安多哈尔城内的拉文尼亚。‡殺死安多哈爾裡的拉文尼亞。',
  }
},
[27118] = {
