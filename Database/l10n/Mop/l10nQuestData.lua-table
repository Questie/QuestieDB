[32175] = {
  {
    'Batalha de Mascotes de Negraluna!‡Битва питомцев на ярмарке Новолуния!‡Haustierkampf des Dunkelmonds!‡다크문 애완동물 대전!‡¡Duelo de mascotas de la Luna Negra!‡‡Combat de mascotte de Sombrelune‡暗月宠物对战！‡',
    nil,
    'Vença Jeremy Feasel numa batalha de mascotes. Uma‡Победите Джереми Физеля в битве питомцев. это‡Besiegt Jeremy Feasel in einem Haustierkampf.‡애완동물 대전에서 제레미 피셀을 꺾어야 합니다. 레벨 1‡Derrota a Jeremy Feasel en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Jeremy Feasel.‡在宠物战斗中击败杰里米·费舍尔。‡',
  }
},
[32181] = {
  {
    'Desafio do Senhor das Feras: a Garça‡Добыча повелителя зверей: журавль‡Beute des Bestienmeisters: Der Kranich‡야수조련사의 사냥감: 고대 피의 왕관 학‡La cantera del maestro de bestias: la grulla‡‡Proie du belluaire : la grue‡兽王的猎物：仙鹤‡',
    nil,
    'Leve a Garça Coroa Rubra Anciã para Jorn Vidente do Céu. Uma‡Отнесите древнего багряноголового журавля Джорну Небесному Провидцу. это‡Bringt den uralten Blutkronenkranich zu Jorn Himmelsdeuter.‡조른 스카이시어에게 고대 피의 왕관 학을 가져가야 합니다. 레벨 15‡Llévale la grulla Tiarasangre anciana a Jorn Vidente del Cielo.‡‡Rapportez l’Ancienne grue couronne de sang à Jorn Oeil-des-Cieux.‡将远古血冠鹤交给乔恩·星眼。‡',
  }
},
[32182] = {
  {
    'Desafio do Senhor das Feras: o Tigre‡Добыча повелителя зверей: тигр‡Beute des Bestienmeisters: Der Tiger‡야수조련사의 사냥감: 덩치 큰 크라사리 호랑이‡La cantera del maestro de bestias: el tigre‡‡Proie du belluaire : le tigre‡‡',
    nil,
    'Leve o Krasari Ancião para Jorn Vidente do Céu. Uma‡Отнесите красарангского предка Джорну Небесному Провидцу. это‡Bringt den Krasariältesten zu Jorn Himmelsdeuter.‡덩치 큰 크라사리 호랑이를 조른 스카이시어에게 가져가야 합니다. 레벨 15‡Llévale el ancestro Krasari a Jorn Vidente del Cielo.‡‡Rapportez l’Ancien krasari à Jorn Oeil-des-Cieux.‡‡',
  }
},
[32183] = {
  {
    'Desafio do Senhor das Feras: o Caranguejo‡Добыча повелителя зверей: краб‡Beute des Bestienmeisters: Die Krabbe‡야수조련사의 사냥감: 거대 야물집게발‡La cantera del maestro de bestias: el cangrejo‡‡Proie du belluaire : le crabe‡兽王的猎物：螃蟹‡',
    nil,
    'Leve o Torniquete Colossal para Jorn Vidente do Céu. Uma‡Отнесите громадного шустрого краба Джорну Небесному Провидцу. это‡Bringt die kolossale Zwingzange zu Jorn Himmelsdeuter.‡조른 스카이시어에게 거대 야물집게발을 가져가야 합니다. 레벨 15‡Llévale el pinzatuerca colosal a Jorn Vidente del Cielo.‡‡Rapportez le Pincétau colossal à Jorn Oeil-des-Cieux.‡将巨型钳爪蟹交给乔恩·星眼。‡',
  }
},
[32184] = {
  {
    'Desafio do Senhor das Feras: a Garça‡Добыча повелителя зверей: журавль‡Beute des Bestienmeisters: Der Kranich‡야수조련사의 사냥감: 고대 피의 왕관 학‡La cantera del maestro de bestias: la grulla‡‡Proie du belluaire : la grue‡兽王的猎物：仙鹤‡',
    nil,
    'Leve a Garça Coroa Rubra Anciã para o Guarda-caça Blake. Uma‡Отнесите древнего багряноголового журавля ловчему Блейку. это‡Bringt den uralten Blutkronenkranich zu Jäger Blake.‡사냥꾼 블레이크에게 고대 피의 왕관 학을 가져가야 합니다. 레벨 15‡Llévale la grulla Tiarasangre anciana al montero Blake.‡‡Rapportez l’Ancienne grue couronne de sang au Veneur Blake.‡将远古血冠鹤交给猎手布雷克。‡',
  }
},
[32185] = {
  {
    'Desafio do Senhor das Feras: o Tigre‡Добыча повелителя зверей: тигр‡Beute des Bestienmeisters: Der Tiger‡야수조련사의 사냥감: 덩치 큰 크라사리 호랑이‡La cantera del maestro de bestias: el tigre‡‡Proie du belluaire : le tigre‡兽王的猎物：老虎‡',
    nil,
    'Leve o Krasari Ancião para o Guarda-caça Blake. Uma‡Отнесите красарангского предка ловчему Блейку. это‡Bringt den Krasariältesten zu Jäger Blake.‡사냥꾼 블레이크에게 덩치 큰 크라사리 호랑이를 가져가야 합니다. 레벨 15‡Llévale el ancestro Krasari al montero Blake.‡‡Rapportez l’Ancien krasari au Veneur Blake.‡将卡桑利老年虎交给猎手布雷克。‡',
  }
},
[32186] = {
  {
    'Desafio do Senhor das Feras: o Caranguejo‡Добыча повелителя зверей: краб‡Beute des Bestienmeisters: Die Krabbe‡야수조련사의 사냥감: 거대 야물집게발‡La cantera del maestro de bestias: el cangrejo‡‡Proie du belluaire : le crabe‡兽王的猎物：螃蟹‡',
    nil,
    'Leve o Torniquete Colossal para o Guarda-caça Blake. Uma‡Отнесите громадного шустрого краба ловчему Блейку. это‡Bringt die kolossale Zwingzange zu Jäger Blake.‡사냥꾼 블레이크에게 거대 야물집게발을 가져가야 합니다. 레벨 15‡Llévale el pinzatuerca colosal al montero Blake.‡‡Rapportez le Pincétau colossal au Veneur Blake.‡将巨型钳爪蟹交给猎手布雷克。‡',
  }
},
[32189] = {
  {
    'Uma nova cara de farrapo‡Странный новичок‡Ein schäbiger Neuer‡추레한 새 얼굴‡Una cara nueva y descuidada‡‡Un nouveau venu miteux‡寒碜的陌生人‡',
    nil,
    'Fale com Barnabé Flecheiro no Mercado de Meia Colina. Uma‡Поговорите с Барнаби Флетчером на рынке Полугорья.‡Sprecht mit Barnabas Pfeilmacher auf dem Halbhügelmarkt.‡언덕골 시장에 있는 반아비 플레처와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Barnaby Fletcher en el Mercado del Alcor.‡‡Parlez à Barnaby Fletcher au Marché de Micolline.‡与半山市集的巴纳比·弗莱彻谈一谈。‡',
  }
},
[32190] = {
  {
    'Para Mogujia‡В Могуцзя‡Nach Mogujia‡모구지아로‡A Mogujia‡‡En route pour Mogujia‡前往魔古岬‡',
    nil,
    'Encontre o Lorde-regente Lor\'themar Theron em Mogujia. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите лорда-регента Лор\'темара Терона в Могуцзя. Поговорите с Так-Таком в Крепости Покорителей, чтобы отправиться туда.‡Findet Lordregent Lor\'themar Theron bei Mogujia. Sprecht mit Tak-Tak bei der Herrschaftsfeste bezüglich einer Transportmöglichkeit.‡모구지아에 있는 로르테마르 테론을 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra al señor regente Lor\'themar Theron en Mogujia. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte.‡‡Trouvez le Seigneur régent Lor’themar Theron à Mogujia. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去魔古岬找摄政王洛瑟玛·塞隆。你可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32191] = {
  {
    'Guardiões antigos‡Древние стражи‡Uralte Wächter‡고대의 수호자‡Guardianes antiguos‡‡D’antiques gardiens‡远古守卫‡',
    nil,
    'Mate 5 Guardiões Korune. Uma‡Убейте 5 стражей клана Корун. это‡Tötet 5 Wächter der Korun.‡코룬 수호자 5마리를 처치해야 합니다. 레벨 15‡Mata a 5 guardianes Korune.‡‡Tuez 5 Gardes korune.‡击败5名寇茹守卫者。‡',
  }
},
[32192] = {
  {
    'Linhagens sangrentas‡Кровные братья‡Blutlinie‡피의 동료들‡Líneas de sangre‡‡Descendance‡血脉相连‡',
    nil,
    'Liberte 6 Magos da Dominação matando Vigias Korune. Uma‡Освободите 6 магов из Крепости Покорителей, убивая хранителей клана Корун. задание.‡Befreit 6 Magier der Herrschaftsoffensive indem Ihr Hüter der Korun tötet.‡코룬 감시자를 처치해 지배령 마법사를 6명 풀어줘야 합니다. 레벨 15‡Libera a 6 magos del Dominio matando a celadores Korune.‡‡Libérez 6 Mages de domination en tuant des Gardiens korune.‡消灭寇茹守望者，释放6名统御法师。‡',
  }
},
[32193] = {
  {
    'Para Mogujia‡В Могуцзя‡Nach Mogujia‡모구지아로‡A Mogujia‡‡En route pour Mogujia‡前往魔古岬‡',
    nil,
    'Encontre Brann Barbabronze em Mogujia. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Найдите Бранна Бронзоборода в Могуцзя. Поговорите с Фенни Хорнсвоггл в Львином лагере.‡Sprecht mit Brann Bronzebart in Mogujia am Kun-Lai-Gipfel. Sprecht mit Fennie Hornsturz in der Löwenlandung für einen Transport.‡모구지아에 있는 브란 브론즈비어드를 찾아야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Encuentra a Brann Barbabronce en Mogujia. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Trouvez Brann Barbe-de-Bronze à Mogujia. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport.‡去魔古岬找布莱恩·铜须。你可以与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32194] = {
  {
    'Haverá sangue‡Дурная кровь‡Böses Blut‡나쁜 피‡Mala sangre‡‡Du mauvais sang‡血仇‡',
    nil,
    'Colete 5 Artefatos Korune de Coletores de Runas de Luaprata, Magos ou Cavaleiros da Dominância. Uma‡Отберите 5 артефактов клана Корун у руноискателей Луносвета, волшебников или рыцарей из Крепости Покорителей.‡Erlangt 5 Artefakte der Korun von Runensuchern von Silbermond oder von Magiern oder Rittern der Herrschaftsoffensive.‡실버문 룬추적자, 지배령 마법사, 지배령 기사에게서 코룬 유물 5개를 모아야 합니다. 레벨 15‡Consigue 5 artefactos Korune de buscadores de runas de Lunargenta, magos de la dominancia o caballeros de la dominancia.‡‡Récupérez 5 Artéfacts korunes sur des Chercheurs de runes de Lune-d’Argent, Mages de domination ou Chevaliers de domination.‡从银月觅符者、统御法师或统御骑士身上搜集5件寇茹神器。‡',
  }
},
[32195] = {
  {
    'Resta a raiva‡Остаточная ярость‡Aufgestauter Zorn‡‡Restos de ira‡‡Colère contenue‡‡',
    nil,
    'Mate 27 Raivículas. Uma‡Убейте 27 злоблингов. это‡Tötet 27 Zornlinge.‡‡Mata 27 proles de ira.‡‡Tuez 27 Jeunes irascibles.‡‡',
  }
},
[32196] = {
  {
    'Um tipo de magia - DEPRECATED‡Как бы магия‡A Kind of Magic - DEPRECATED‡‡Un tipo de magia - DEPRECATED‡‡Un tour de magie - PÉRIMÉ‡‡',
    nil,
    'Encontre os 3 Batedoromáticos no Ponto de Dominação. Uma‡Найдите 3 Осад-о-матика в Крепости Покорителей. это‡Find the 3 Scout-o-Matics in Domination Point.‡‡Encuentra las 3 Exploramáticas en el Punto de Dominio.‡‡Trouvez 3 Explore-matics à la Halte de la Domination.‡‡',
  }
},
[32197] = {
  {
    'Bolo de carne misteriosa‡Загадочный мясной рулет‡Eigenartiger Braten‡정체불명의 고기구이‡Pastel de carne misterioso‡‡Pain de viande mystère‡神秘肉卷‡',
    nil,
    'Obtenha 7 Pedaços de Carne Misteriosa da fauna local. Uma‡Соберите 7 кусков загадочного мяса, убивая местную живность. это‡Besorgt 7 Stücke eigenartiges Fleisch von den wilden Tieren aus der Gegend.‡야생동물들에게서 정체불명의 고깃덩이 7개를 모아야 합니다. 레벨 15‡Consigue 7 trozos de carne misteriosa de la fauna local.‡‡Récupérez 7 morceaux de Viande mystère sur la faune locale.‡从当地的野生动物身上收集7份神秘肉块。‡',
  }
},
[32198] = {
  {
    'Direto do Reino Voador, e repleto de mágica... lixo‡Волшебный летающий мусор‡Abfall ist nicht gleich Abfall‡달라란엔 쓰레기에도 마법이...‡La basura de un reino mágico flotante...‡‡Les ordures d’un royaume magique volant…‡来自浮空魔法城的垃圾……‡',
    nil,
    'Fale com Barnabé Flecheiro para saber mais sobre Fragmentos de Portal. Uma‡Поговорите с Барнаби Флетчером и узнайте больше о кристаллах порталов. задание.‡Sprecht mit Barnabas Pfeilmacher, um mehr über Portalsplitter herauszufinden.‡반아비 플레처와 대화해 차원문 조각에 대해 더 많이 알아내야 합니다. 레벨 15 네 바람의 계곡‡Habla con Barnaby Fletcher para averiguar más cosas sobre los fragmentos de portales.‡‡Parlez à Barnaby Fletcher pour en apprendre davantage sur les Fragments de portail.‡与巴纳比·弗莱彻交谈，进一步了解传送门碎片。‡',
  }
},
[32199] = {
  {
    'Vaporeira Krasarang‡Красарангское лакомство‡Krasarang-Dampfgericht‡크라사랑 게찜‡Mariscada Krasarang‡‡Cuit-vapeur de Krasarang‡‡',
    nil,
    'Obtenha 5 nacos de Carne de Torniquete Poluído dos caranguejos Torniquete na Praia Borraquilha. Uma‡Соберите 5 кусков загрязненного крабового мяса из крабов, обитающих на пляже Трюмных Вод.‡Besorgt 5 Brocken verunreinigtes Zwingzangenfleisch von Zwingzangen am Bilgewasserstrand.‡빌지워터 해변에 있는 야물집게발에게서 오염된 야물집게발 살코기 5개를 모아야 합니다. 레벨 15‡Consigue 5 trozos de carne de pinzatuerca contaminada de los cangrejos pinzatuerca de la Playa Pantoque.‡‡Obtenez 5 morceaux de Viande de pincétau polluée sur des Pincétaux, sur la Plage Baille-Fonds.‡‡',
  }
},
[32200] = {
  {
    'Perigos de Za\'Tual‡Угроза За\'Туала‡Gefahren von Za\'Tual‡자투알에 도사리는 위험‡Los peligros de Za\'Tual‡‡Les dangers de Za’Tual‡赞图尔的危机‡',
    nil,
    'Mate 12 Trolls em Za\'Tual. Uma‡Убейте 12 троллей в За\'Туале.‡Tötet 12 Trolle in Za\'Tual.‡자투알에서 트롤 12명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 12 trols en Za\'Tual.‡‡Tuez 12 Trolls dans Za’Tual.‡在赞图尔消灭12名巨魔。‡',
  }
},
[32201] = {
  {
    'Circunstâncias mortais‡Мертвое дело‡Gravierende Umstände‡심각한 상황‡Una situación delicada‡‡De fâcheuses circonstances‡严峻局势‡',
    nil,
    'Mate 10 Guarda-tumbas Shan\'ze, Rasgalmas Shan\'ze ou Arautos do Trovão Shan\'ze. Uma‡Убейте 10 хранителей могил Шань\'цзэ, кромсателей душ Шань\'цзэ или призывателей грома Шань\'цзэ.‡Tötet 10 Grabhüter der Shan\'ze, Seelenreißer der Shan\'ze oder Donnerrufer der Shan\'ze.‡샨쩌 무덤지기, 샨쩌 영혼해체자, 또는 샨쩌 천둥술사 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 guardianes de las tumbas Shan\'ze, desgarradores de almas Shan\'ze o clamatruenos Shan\'ze.‡‡Tuez 10 Garde-tombes de Shan’ze, Faucheurs d’âme de Shan’ze ou Mande-tonnerres de Shan’ze.‡击败10名山泽守陵者、山泽夺魂者或山泽唤雷者。‡',
  }
},
[32202] = {
  {
    'Matar trolls‡Убить троллей‡Tötet Trolle‡트롤 처치‡Kill Trolls‡‡Tuer des trolls‡消灭巨魔‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32203] = {
  {
    'Matar espíritos mogus‡Убить духов могу‡Tötet Mogugeister‡모구 영혼 처치‡Kill Mogu Spirits‡‡Tuer les esprits mogu‡消灭魔古之魂‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32204] = {
  {
    'A ameaça Gumeskuma‡Угроза Гнилого Клинка‡Die Skumklingen-Bedrohung‡부랑칼날의 위협‡La amenaza Hojaescoria‡‡La menace crasselame‡邪刃的威胁‡',
    nil,
    'Mate 10 sauroks Gumeskuma. Uma‡Убейте 10 сауроков Гнилого Клинка.‡Tötet 10 Saurok der Skumklingen.‡부랑칼날 사우록을 10마리 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 saurok Hojaescoria.‡‡Tuez 10 Sauroks crasselames.‡击败10个邪刃蜥蜴人。‡',
  }
},
[32205] = {
  {
    'Reúna Relatórios de Batedores‡Сбор донесений разведчиков‡Sammelt Späherberichte‡‡Gather Scout Reports‡‡Récupérer les rapports des éclaireurs‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32206] = {
  {
    'Assim não dá‡Дополнительный удар по врагу‡Es reicht einfach nicht‡이대로 놔둘 순 없어‡Esto no puede acabar bien‡‡Ceci n\'est pas acceptable‡这不管用‡',
    nil,
    'Mate 8 trolls Zandalari de qualquer tipo no Terraço do Conquistador. Uma‡Убейте 8 зандаларских троллей на Террасе Завоевателя.‡Tötet 8 Zandalaritrolle jeglicher Art auf der Terrasse des Eroberers.‡정복자의 정원에 있는 잔달라 트롤 8마리를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 8 trols Zandalari cualesquiera en la Platea del Conquistador.‡‡Tuez 8 Trolls zandalari sur la Terrasse des Conquérants.‡在征服者平台击败任意8个赞达拉巨魔。‡',
  }
},
[32207] = {
  {
    'Sáurio perdedor‡Расправа‡Verechst und zugenäht‡공룡이 너무해‡Un mal "necesaurio"‡‡Vilaines bestioles‡纵龙者‡',
    nil,
    'Derrote 10 trolls Zandalari no Cercado das Feras. Uma‡Убейте 10 зандаларских троллей в загонах для зверей.‡Bezwingt 10 Trolle der Zandalari in den Bestienpferchen.‡야수 조련소에서 잔달라 트롤 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Derrota a 10 trols Zandalari en El Cerco de las Bestias.‡‡Tuez 10 Trolls zandalari dans les Enclos à bêtes.‡在兽栏中击败10名赞达拉巨魔。‡',
  }
},
[32208] = {
  {
    'Capacitor máximo‡Максимальная нагрузка‡Der Maximalkondensator‡천공기 과부하‡Condensando energías‡‡Condensateur au max‡电容上限‡',
    nil,
    'Interaja com as três Brocas de Raios nas Minas de Ferro Fantasma para destruí-las e mate o Senhor do Metal Mono-Han. Uma‡Воспользуйтесь полностью заряженным чародейским конденсатором, чтобы уничтожить 3 молниевых бура в Шахте молний, и убейте повелителя металла Моно-Ханя.‡Macht Euch an den drei Blitzbohrern in den Blitzaderminen zu schaffen, um sie zu zerstören, und tötet Metallfürst Mono-Han.‡유령무쇠 광산에서 번개 천공기 3개를 작동시켜 파괴하고, 무쇠군주 모노한을 처치해야 합니다. 레벨 32 천둥의 섬‡Interactúa con los tres taladros en las minas de hierro fantasma para destruirlas y mata al señor del metal Mono-Han.‡‡Détruisez les 3 Foreuses de foudre à la Veine de Foudremine et tuez le Seigneur du métal Mono Han.‡在闪电矿脉中与3个闪电钻头相互作用以摧毁它们，并击败金铁领主莫诺汗。‡',
  }
},
[32209] = {
  {
    'Resgate nossos batedores!‡Спаси наших разведчиков!‡Rettet unsere Späher!‡정찰병을 구하라!‡¡Exploradores en peligro!‡‡Sauvez nos éclaireurs !‡救救斥候！‡',
    nil,
    'Resgate os três agentes Fendessol capturados dentro das Minas de Ferro Fantasma e mate o Senhor do Metal Mono-Han. Uma‡Спасите 3 захваченных посланников Похитителей Солнца в Шахте молний и убейте повелителя металла Моно-Ханя.‡Rettet die drei gefangenen Agenten der Sonnenhäscher aus der Blitzadermine und tötet Metallfürst Mono-Han.‡유령무쇠 광산에서 사로잡힌 선리버 요원 3명을 구출하고, 무쇠군주 모노한을 처치해야 합니다. 레벨 32 천둥의 섬‡Rescata a los tres agentes Atracasol secuestrados en las minas de hierro fantasma y mata al señor del metal Mono-Han.‡‡Portez secours aux 3 Agents saccage-soleil capturés à la Veine de Foudremine et tuez le Seigneur du métal Mono Han.‡在闪电矿脉中解救3名被捕的夺日者密探，并击败金铁领主莫诺汗。‡',
  }
},
[32210] = {
  {
    'Mate o chefe mogu para conseguir a chave, use o objeto pulando o enigma‡Kill mogu boss for key, use object behind jumping puzzle‡Moguboss für Schlüssel töten, Objekt hinter Sprungpuzzle benutzen‡모구 우두머리 처치 후 열쇠 획득 Jumping Puzzle 뒤에 있는 물체 사용‡Kill mogu boss for key, use object behind jumping puzzle‡‡Tuez le boss mogu pour sa clé, utilisez-la derrière le puzzle‡Kill mogu boss for key, use object behind jumping puzzle‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32211] = {
  {
    'Nalak, o Senhor da Tempestade‡Повелитель Гроз Налак‡Nalak der Sturmfürst‡폭풍 군주 나락크‡Nalak, el Señor de la Tormenta‡‡Nalak le seigneur des tempêtes‡暴风领主纳拉克‡',
    nil,
    '‡‡Tötet Nalak.‡‡‡‡‡‡',
  }
},
[32212] = {
  {
    'O ataque a Zeb\'tula‡Атака на Зеб\'тул‡Der Angriff auf Zeb\'tula‡제브툴라 강습‡El Asalto a Zeb\'tula‡‡L’assaut de Zeb’tula‡突袭赞布图拉‡',
    nil,
    'Complete o Ataque a Zeb\'tula. Fale com Lor\'themar Theron para iniciar o ataque. Uma‡Завершите сценарий "Атака на Зеб\'тул". Для начала атаки поговорите с Лор\'темаром Тероном.‡Schließt den Angriff auf Zeb\'tula ab. Sprecht mit Lor\'themar Theron, um den Angriff zu beginnen.‡제브툴라 강습 작전을 완수해야 합니다. 로르테마르 테론과 대화하여 작전을 시작할 수 있습니다.‡Completa el Asalto a Zeb\'tula. Habla con Lor\'themar Theron para iniciar el ataque.‡‡Terminez l’Assaut de Zeb’tula. Parlez à Lor’themar Theron pour commencer l’attaque.‡完成突袭赞布图拉。与洛瑟玛·塞隆交谈以开始攻击。‡',
  }
},
[32213] = {
  {
    'Velhos Inimigos‡Старые враги‡Alte Feinde‡숙적‡Viejos enemigos‡‡De vieux ennemis‡宿敌‡',
    nil,
    'Mate 10 unidades do Kirin Tor na Ilha do Trovão. Uma‡Убейте 10 воинов Кирин-Тора или игроков на острове Грома.‡Tötet auf der Insel des Donners 10 Einheiten oder Spielercharaktere, die für die Kirin Tor arbeiten.‡천둥의 섬에서 키린 토 요원 또는 플레이어 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 unidades o jugadores del Kirin Tor en la Isla del Trueno.‡‡Tuez 10 unités du Kirin Tor ou personnages-joueurs sur l’Île du Tonnerre.‡在雷神岛上击败10名肯瑞托单位或玩家。‡',
  }
},
[32214] = {
  {
    'Infiltradores Borraquilha‡Шпионы на территории Трюмных Вод‡Bilgewässer Spitzel‡빌지워터 침입자들‡Infiltrados en Pantoque‡‡Infiltrateurs de Baille-Fonds‡‡',
    nil,
    'Mate 10 Sabotadores da AVIN perto do Ponto de Dominação e da Praia Borraquilha. Uma‡Убейте 10 саботажников ШРУ в районе Крепости Покорителей и пляжа Трюмных Вод.‡Tötet 10 Saboteure des SI:7 an der Herrschaftsfeste und am Bilgewasserstrand.‡지배령 거점이나 빌지워터 해변 근처에 있는 SI: 7 파괴공작원 10명을 처치해야 합니다. 레벨 15‡Mata a 10 saboteadores del IV:7 alrededor del Punto de Dominio y la Playa Pantoque.‡‡Tuez 10 Saboteurs du SI:7 près de la Halte de la Domination et sur la Plage Baille-Fonds.‡‡',
  }
},
[32215] = {
  {
    'Sacrifício hediondo‡Отвратительные жертвоприношения‡Abscheuliche Opfer‡극악무도한 희생‡Sacrificios bárbaros‡‡Odieux sacrifices‡可憎的献祭‡',
    nil,
    'Destrua os Altares de Sacrifícios Zandalari. Uma‡Уничтожьте жертвенные алтари зандаларов.‡Zerstört die Opferaltäre der Zandalari.‡잔달라 희생의 제단을 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye los altares de sacrificios Zandalari.‡‡Détruisez les Autels sacrificiels zandalari.‡摧毁赞达拉祭坛。‡',
  }
},
[32216] = {
  {
    'Pterrível Ptormento‡Измученный птеродактиль‡Kreischen vor Qualen‡끔찍한 고문‡Un ptormento pterrible‡‡Pterrible ptourment‡苦痛折磨‡',
    nil,
    'Liberte o Gritacéu Atormentado. Uma‡Освободите измученного небесного крикуна.‡Befreit den gepeinigten Himmelskreischer.‡고문당한 비명익룡을 풀어줘야 합니다. 레벨 32 천둥의 섬‡Libera al vociferador de cielos atormentado.‡‡Libérez le Hurleciel tourmenté.‡解救痛苦的啸天龙。‡',
  }
},
[32217] = {
  {
    'Oferendas Negras‡Темные подношения‡Finstere Opfergaben‡어둠의 공물‡Ofrendas oscuras‡‡Sombres offrandes‡邪恶供品‡',
    nil,
    'Destrua 6 Oferendas Zandalari. Uma‡Уничтожьте 6 зандаларских подношений.‡Zerstört 6 Zandalariopfergaben.‡잔달라 공물 6개를 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 6 ofrendas Zandalari.‡‡Détruisez 6 Offrandes zandalari.‡摧毁6份赞达拉供品。‡',
  }
},
[32218] = {
  {
    'Cinzas do inimigo‡Прах врагов‡Asche des Feindes‡적의 유골‡Las cenizas del enemigo‡‡Les cendres de l’ennemi‡敌人的骨灰‡',
    nil,
    'Queime 8 Restos Mumificados. Uma‡Сожгите 8 мумифицированных останков.‡Verbrennt 8 mumifizierte Überreste.‡미라가 된 유해를 8구 불태워야 합니다. 레벨 32 천둥의 섬‡Quema 8 restos momificados.‡‡Brûlez 8 Restes momifiés.‡超度8具干尸残骸。‡',
  }
},
[32219] = {
  {
    'Coração de pedra (e rins, e fígado, e...)‡Каменный холод‡Marmor, Stein und Qilen bricht‡돌처럼 차가운‡Petrificado de miedo‡‡Froid comme la pierre‡冷血石像‡',
    nil,
    'Destrua 8 Guardiões das Tumbas. Uma‡Уничтожьте 8 могильных стражей.‡Zerstört 8 Grabwächter.‡무덤 수호자를 8마리 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye a 8 guardalápidas.‡‡Détruisez 8 Garde-tombes.‡摧毁8个陵寝守卫者。‡',
  }
},
[32220] = {
  {
    'Rendição da alma‡Освобождение душ‡Seelenrettung‡영혼의 굴복‡Entrégame tu alma‡‡Abandon d\'âme‡失魂者‡',
    nil,
    'Resgate 6 Batedores Fendessol ou Batedores do Pacto de Prata. Uma‡Спасите 6 разведчиков Похитителей Солнца или Серебряного Союза.‡Rettet 6 Späher der Sonnenhäscher oder des Silberbunds.‡선리버 정찰병 또는 은빛 서약단 정찰병을 6명 구출해야 합니다. 레벨 32 천둥의 섬‡Salva a 6 exploradores Atracasol o de El Pacto de Plata.‡‡Sauvez 6 Éclaireurs saccage-soleil ou du Concordat argenté.‡解救6名夺日者斥候或银色盟约斥候。‡',
  }
},
[32221] = {
  {
    'Interditado para banhistas‡Нападение на пляж‡Erstürmung des Strandes‡해변을 휩쓸어라‡Irrumpiendo en la playa‡‡Une journée à la plage‡海滩大反攻‡',
    nil,
    'Mate 10 unidades de defesa da Muralha de Escudos, incluindo Sabotadores da AVIN, na região da Praia Borraquilha. Uma‡Убейте 10 любых воинов операции "Заслон", включая саботажников ШРУ, на пляже Трюмных Вод или в его окрестностях.‡Tötet 10 beliebige Angreifer der 7. Legion.‡빌지워터 해변과 그 주변에서 철벽방패 병사나 SI:7 파괴공작원 10명을 처치해야 합니다. 레벨 15‡Mata a 10 miembros cualesquiera del Muro de escudos, incluyendo a algunos saboteadores del IV:7, en la Playa Pantoque y sus alrededores. Un(a) misión.‡‡Tuez 10 Soldats de l’opération Bouclier ou Saboteurs du SI:7 sur et près de la Plage Baille-Fonds.‡在锈水海滩附近击败任意10名神盾军士兵，包括军情七处破坏者。‡',
  }
},
[32222] = {
  {
    'PROCURA-SE: Engenheiro-chefe Torceporca‡Разыскивается: главный инженер Винтоверт‡GESUCHT: Chefingenieur Getriebeschlüssel‡현상 수배: 선임기술자 코그렌치‡SE BUSCA: ingeniero jefe Llavepiñón‡‡ON RECHERCHE : l’ingénieur en chef Clérouage‡‡',
    nil,
    'Destrua o Engenheiro-chefe Torceporca na Praia Borraquilha. Uma‡Расправьтесь с главным инженером Винтовертом на краю пляжа Трюмных Вод. задание.‡Vernichtet Chefingenieur Getriebeschlüssel am Rand des Bilgewasserstrandes.‡빌지워터 해변 외곽에 있는 선임기술자 코그렌치를 처치해야 합니다. 레벨 15‡Acaba con el ingeniero jefe Llavepiñón en la orilla de la Playa Pantoque.‡‡Détruisez l’Ingénieur en chef Clérouage à la lisière de la Plage Baille-Fonds.‡‡',
  }
},
[32223] = {
  {
    'PROCURA-SE: Tenente Ethan Jacobson‡РАЗЫСКИВАЕТСЯ: лейтенант Этан Джейкобсон‡GESUCHT: Leutnant Ethan Jacobson‡현상 수배: 부관 에단 제이콥슨‡SE BUSCA: teniente Ethan Jacobson‡‡ON RECHERCHE : le lieutenant Ethan Jacobson‡通缉：伊桑·雅各布森中尉‡',
    nil,
    'Destrua o Tenente Ethan Jacobson nas Ilhas do Sul, ao sul da Fazenda da Serraria de Zino Picadinho. Uma‡Расправьтесь с лейтенантом Этаном Джейкобсоном на Южных островах, расположенных к югу от Лесопилки Скоротяпеля.‡Tötet Leutnant Ethan Jacobson auf den Südlichen Inseln im Süden von Blitzbeils Holzhof.‡퀵촙의 목재소 아래쪽의 남쪽 섬에 있는 부관 에단 제이콥슨을 처치해야 합니다. 레벨 15‡Acaba con el teniente Ethan Jacobson en las Islas del Sur, al sur del Aserradero de Hachaveloz.‡‡Détruisez le Lieutenant Ethan Jacobson dans les Îles du Sud, au sud de la Ferme d’abattage de Hachémenu.‡去快锯伐木场南端的南部岛屿消灭伊桑·雅各布森中尉。‡',
  }
},
[32224] = {
  {
    'Não se levantem mais!‡Покончить с восставшими‡Erhebt Euch nie wieder!‡이제 일어나지 말지어다!‡Almas en pena‡‡Morts pour de bon !‡别再回来了！‡',
    nil,
    'Mate 15 Ancestrais Reanimados. Uma‡Убейте 15 восставших предков.‡Tötet 15 auferstandene Urahnen.‡되살아난 선조 15명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 15 ancestros resucitados.‡‡Tuez 15 Ancêtres ressuscités.‡击败15个复生的先祖。‡',
  }
},
[32225] = {
  {
    'O chamado do trovão‡Ритуал вызова грома‡Der Ruf des Donners‡천둥의 부름‡El clamor del trueno‡‡L’appel du tonnerre‡雷电的召唤‡',
    nil,
    'Interrompa o ritual dos Arautos do Trovão Shan\'ze. Uma‡Прервите ритуал призывателей грома Шань\'цзэ.‡Unterbrecht das Ritual der Donnerrufer der Shan\'ze.‡샨쩌 천둥술사의 의식을 저지해야 합니다. 레벨 32 천둥의 섬‡Detén el ritual de los clamatruenos Shan\'ze.‡‡Mettez un terme au Rituel des Mande-tonnerre de Shan’ze.‡阻止山泽唤雷者的仪式。‡',
  }
},
[32226] = {
  {
    'Cripta adentro‡В склепы‡In die Krypta‡납골당 안으로‡Hacia las criptas‡‡Dans les cryptes‡进入墓穴‡',
    nil,
    'Use o Encantamento de Gura no Salão dos Exaltados. Depois, derrote Gura, o Recuperado. Uma‡Воспользуйтесь чарами Гуры в Залах Превознесения, а затем победите Гуру Освобожденного.‡Benutzt die Zauberformel von Gura in der Halle der Ehrwürdigen und besiegt dann Gura den Zurückgeforderten.‡고귀한 자의 전당에서 구라의 주문을 사용한 후, 되찾은 자 구라를 꺾어야 합니다. 레벨 32 천둥의 섬‡Usa el conjuro de Gura en la Cámara de los Eminentes y derrota a Gura el Reclamado.‡‡Utilisez l’Incantation de Gura dans la Salles des Exaltés, puis tuez Gura le Repris.‡在至尊殿使用古拉的咒语，然后击败重生的古拉。‡',
  }
},
[32227] = {
  {
    'Evitando uma ameaça futura‡Предотвращение будущей угрозы‡Einer zukünftigen Bedrohung vorbeugen‡미래의 위험은 미리 위협해야‡Más vale prevenir que curar‡‡Prévention d\'une menace future‡防患未然‡',
    nil,
    'Assuste 12 Filhotes de Gritacéu correndo para perto deles. Uma‡Напугайте 12 детенышей небесного крикуна, бегая мимо них.‡Erschreckt 12 Himmelskreischerjungtiere, indem Ihr in ihre Nähe lauft.‡아기 비명익룡 12마리 주위를 뛰어다녀 겁을 줘야 합니다. 레벨 32 천둥의 섬‡Asusta a 12 proles de vociferador de cielos corriendo cerca de ellas.‡‡Effrayez 12 Bébés hurleciel en courant près d’eux.‡在12只啸天雏龙身边奔跑以惊吓它们。‡',
  }
},
[32228] = {
  {
    'Tremor no charco‡Содрогающаяся трясина‡Das Schaudernde Moor‡흔들리는 습지‡Un páramo estremecedor‡‡La lande frissonnante‡战栗的沼泽‡',
    nil,
    'Mate o Demossauro Poderoso. Uma‡Убейте могучего дьявозавра.‡Tötet den mächtigen Teufelssaurier.‡무적의 데빌사우루스를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata al demosaurio poderoso.‡‡Tuez le Diablosaure puissant.‡消灭强大的魔暴龙。‡',
  }
},
[32229] = {
  {
    'Mate o Destacamento Trólico Vagante‡Уничтожение военного отряда троллей‡Marodierenden Trollkampftrupp töten‡방황하는 트롤 처치 전쟁 파티‡Kill Roaming Troll War Party‡‡Tuer la troupe de guerriers trolls vagabonde‡消灭游荡的巨魔战斗小队‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32230] = {
  {
    'O Colosso Zandalari‡Зандаларский колосс‡Koloss der Zandalari‡잔달라 거상‡El coloso Zandalari‡‡Le colosse zandalari‡赞达拉巨神像‡',
    nil,
    'Destruir o Colosso Zandalari. Uma‡Уничтожьте зандаларского колосса.‡Zerstört den Koloss der Zandalari.‡잔달라 거상을 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye al coloso Zandalari.‡‡Détruisez le Colosse zandalari.‡消灭赞达拉巨神像。‡',
  }
},
[32231] = {
  {
    'Um rastro de luz na escuridão‡Освещенный путь во тьме‡Lichtspur im Dunkel‡어두운 길에 깔린 빛‡La oscuridad se cierne sobre ti‡‡La lumière dans les ténèbres‡在黑暗中寻找光明‡',
    nil,
    'Reacenda 8 tochas na Charneca Turva. Uma‡Зажгите 8 погасших факелов в Мрачных топях.‡Entzündet 8 Fackeln im Düstermoor.‡불길한 습지 안의 횃불 8개에 다시 불을 붙여야 합니다. 레벨 1 천둥의 섬‡Vuelve a encender 8 antorchas en Malandanza.‡‡Rallumez 8 Torches à la Morne Lande.‡重新点亮阴惨泥沼中的8支火炬。‡',
  }
},
[32232] = {
  {
    'O que vale é o interior‡Важно то, что внутри‡Die Größe zählt doch‡지나칠 수 없는 적‡Hay que fijarse en el interior‡‡C’est ce qu’il y a à l’intérieur qui compte‡值得注意‡',
    nil,
    'Destrua o Guardião Tak\'u no Terraço do Conquistador. Uma‡Уничтожьте стража Та\'ку на Террасе Завоевателя.‡Zerstört Wächter Tak\'u auf der Terrasse des Eroberers.‡정복자의 정원에 있는 수호자 탁쿠를 처치해야 합니다. 레벨 32 천둥의 섬‡Destruye al guardián Tak\'u en la Platea del Conquistador.‡‡Détruisez le Gardien Tak’u sur la Terrasse des Conquérants.‡摧毁征服者平台的守护者塔克乌。‡',
  }
},
[32233] = {
  {
    'Muito desarmante‡Операция по разоружению‡Entwaffnender Charme‡완전한 무장해제‡Arma letal‡‡Carrément désarmant‡缴除武装‡',
    nil,
    'Roube 7 Lâminas Imbuídas em Loa do Terraço do Conquistador. Uma‡Выкрадите 7 усиленных лоа клинков с Террасы Завоевателя.‡Stehlt 7 loabeseelte Klingen von der Terrasse des Eroberers.‡정복자의 정원에서 로아가 주입된 검 7개를 훔쳐야 합니다. 레벨 32 천둥의 섬‡Roba 7 hojas imbuidas de los loa en la Platea del Conquistador.‡‡Volez 7 Lames imprégnées par les Loas sur la Terrasse des Conquérants.‡从征服者平台偷取7把灌注神力的利刃。‡',
  }
},
[32234] = {
  {
    'Conhecimento é poder‡Знание – сила‡Wissen ist Macht‡지식은 힘이다‡El conocimiento es poder‡‡La connaissance est le pouvoir‡知识就是力量‡',
    nil,
    'Colete 6 Artefatos Ritualísticos do Terraço do Conquistador. Uma‡Добудьте 6 ритуальных артефактов на Террасе Завоевателя.‡Sammelt in der Gegend um die Terrasse des Eroberers 6 Ritualartefakte ein.‡정복자의 정원 근처에서 의식용 유물 6개를 획득해야 합니다. 레벨 32 천둥의 섬‡Recupera 6 artefactos de ritual en la Platea del Conquistador.‡‡Récupérez 6 Artéfacts de rituel aux alentours de la Terrasse des Conquérants.‡在征服者平台附近夺取6件仪式神器。‡',
  }
},
[32235] = {
  {
    'Clarão! Aaaaaaahhhh!‡Воздушные цели‡Explosiver Cocktail!‡번쩍! 으아아아!‡Tirar a matar‡‡Molotov boum boum‡点火！哇啊啊！‡',
    nil,
    'Use os Molotovs Borraquilha para destruir 6 Girocópteros X2 do Celesfogo. Uma‡Уничтожьте 6 гирокоптеров X2 "Небесного огня" с помощью бутылок с зажигательной смесью.‡Verwendet den Bilgewässer Molotowcocktail, um 6 Gyrokopter X2 der Himmelsfeuer zu zerstören.‡빌지워터 화염병으로 하늘불꽃호 자이로콥터 X2 6대를 파괴해야 합니다. 레벨 15‡Usa los molotovs de Pantoque para destruir 6 girocópteros X2 de El Abrasacielos.‡‡Utilisez des Cocktails Molotov de Baille-Fonds pour détruire 6 Gyrocoptères du Brûleciel X2.‡使用锈水燃烧瓶摧毁6架天火号旋翼机X2型。‡',
  }
},
[32236] = {
  {
    'Bicho-xô!‡Жукам – нет!‡Kratz-Ab!‡벌레 퇴치!‡¡Contigo no, bicho!‡‡Sortez le désinsecteur !‡除虫喷剂‡',
    nil,
    'Borrife 5 Aranhas Xistosas Agitadas com o Borrifador de Bicho-xô e erradique 12 Fragmentos de Xisto. Uma‡Опрыскайте 5 сланцевых пауков Жуконетом и уничтожьте 12 сланцевиков. это‡Sprüht 5 Aufgebrachte Schieferspinnen mit dem "Kratz-Ab"-Spray ein und beseitigt 12 Schiefersplitter.‡벌레 퇴치 분무기를 흥분한 혈암거미 5마리에게 사용하고, 혈암파편거미 12마리를 없애야 합니다. 레벨 15‡Rocía 5 arañas de esquisto perturbadas con el pulverizador de insectos y erradica 12 fragmentos de esquisto.‡‡Répandez du Désinsecteur sur 5 Araignées de schiste agitées et éradiquez 12 Éclats de schiste.‡对5名兴奋的页岩蛛使用驱虫剂，消灭15只页岩小蜘蛛。‡',
  }
},
[32237] = {
  {
    'Recurso precioso‡Ценный ресурс‡Kostbare Ressource‡귀중한 자원‡Un preciado recurso‡‡Une ressource précieuse‡‡',
    nil,
    'Aperte 8 Válvulas Defeituosas no Jorrador do Engrenário e arredores. Uma‡Перекройте 8 неисправных вентилей в нефтяном фонтане Скрипетельки. это‡Dichtet 8 defekte Ventile in und um Radflutschs Ölspritzer ab.‡빌지워터 해변의 연료 공급 장치에서 망가진 밸브 8개를 잠궈야 합니다. 레벨 15‡Ajusta 8 válvulas defectuosas en el Surtidor de Tuercafloja y alrededores.‡‡Resserrez 8 Valves défectueuses dans et près du Puits de Glissécrou.‡‡',
  }
},
[32238] = {
  {
    'Controle Remoto Universal-Explosão‡Универсальный взрывопульт‡Universalfernsteuerungsexplosion‡만능 원격조종기로 해결!‡Mando universal explosivo‡‡Télécommande universelle détonante‡通用型遥控引爆器‡',
    nil,
    'Destrua 9 Mecaesmurradores da Muralha de Escudo na Fazenda da Serraria de Zino Picadinho e arredores. Uma‡Уничтожьте 9 дроботов операции "Заслон" возле Лесопилки Скоротяпеля. это‡Zerstört 9 Mecha-Stampfer des Schildwalls in und um Blitzbeils Holzhof.‡퀵촙의 목재소와 그 주변에 있는 철벽방패 난타로봇 9개를 파괴해야 합니다. 레벨 15‡Destruye 9 mecaporreadores del Muro de escudos en el Aserradero de Hachaveloz y alrededores.‡‡Détruisez 9 Mécadameurs de l’opération Bouclier dans et autour de la Ferme d’abattage de Hachémenu.‡去快锯伐木场摧毁9个神盾机械碾压者。‡',
  }
},
[32242] = {
  {
    'Segredos enterrados‡Позабытые секреты‡Vergrabene Geheimnisse‡땅속에 잠든 비밀‡Secretos enterrados‡‡Des secrets enterrés‡埋藏的秘密‡',
    nil,
    'Fale com Fanlyr Espinho de Prata na Colina Ancestral, que fica no Vale das Flores Eternas. Uma‡Поговорите с Фанлиром Серебряным Шипом на плато Предков в Вечноцветущем доле.‡Sprecht mit Fanlyr Silberdorn bei der Ahnenhöhe im Tal der Ewigen Blüten.‡영원꽃 골짜기, 선조의 봉우리에 있는 판릴 실버쏜과 대화해야 합니다. 레벨 15‡Habla con Fanlyr Espinaplata en el Alto Ancestral, en el Valle de la Flor Eterna.‡‡Parlez à Fanlyr Argépine à la Cime Ancestrale, dans le Val de l’Éternel printemps.‡去锦绣谷的祖宗高地和法利尔·银棘谈一谈。‡',
  }
},
[32243] = {
  {
    'A fonte do poder dos Korune‡Источник силы клана Корун‡Die Machtquelle der Korun‡코룬의 힘의 근원‡La fuente del poder Korune‡‡La source de la puissance des Korunes‡寇茹力量之源‡',
    nil,
    'Colete Garra Tocada pelo Sha do Tecencantos Korune. Uma‡Убейте чаровяза из клана Корун и заберите у него пораженный ша коготь. это‡Nehmt dem Spruchwirker der Korun eine Sha-berührte Klaue ab.‡코룬 주문술사에게서 샤에 물든 발톱을 획득해야 합니다. 레벨 15‡Consigue una garra influenciada por el sha del tejehechizos Korune.‡‡Récupérez une Griffe touchée par les sha sur un Tisse-sort korune.‡从寇茹织法者身上获取一个染煞之爪。‡',
  }
},
[32244] = {
  {
    'Os korunes‡Корун‡Die Korun‡코룬‡Los Korune‡‡Les Korunes‡寇茹魔古‡',
    nil,
    'Colete um Códice de Korune do Tecencantos Korune. Uma‡Убейте чаровяза из клана Корун и заберите у него кодекс клана Корун. это‡Nehmt dem Spruchwirker der Korun einen Korunkodex ab.‡코룬 주문술사에게서 코룬 고서를 획득해야 합니다. 레벨 15‡Recoge un códice Korune del tejehechizos Korune.‡‡Récupérez un Codex des Korunes sur un Tisse-sort korune.‡从寇茹织法者身上获取一份寇茹抄本。‡',
  }
},
[32246] = {
  {
    'Conheça a batedora‡Встреча с разведчицей‡Treffen mit der Späherin‡정찰병 만나기‡Reúnete con la exploradora‡‡À la rencontre de l’éclaireuse‡会见斥候‡',
    nil,
    'Fale com a Batedora Lynna na Angra de Krasarang, que fica na Selva de Krasarang. Uma‡Поговорите с разведчицей Линной в Красарангской бухте, что в Красарангских джунглях.‡Sprecht mit Späherin Lynna in der Krasarangbucht in der Krasarangwildnis.‡크라사랑 밀림의 크라사랑 만에 있는 정찰병 린나와 대화해야 합니다. 레벨 15‡Habla con la exploradora Lynna en la Cala Krasarang, en la Espesura Krasarang.‡‡Parlez à l’Éclaireuse Lynna à la Crique de Krasarang, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的卡桑琅海湾与斥候琳娜谈一谈。‡',
  }
},
[32247] = {
  {
    'Rei entre os homens‡Истинный король‡Ein König unter den Menschen‡사나이 중의 사나이‡Un rey entre hombres‡‡Un roi parmi les hommes‡人民的国王‡',
    nil,
    'Acompanhe o Rei Varian Wrynn e encontre o Marechal Troteman e Hilda Traquitana. Além disso, mate 25 membros da Horda. Uma‡Сопроводите короля Вариана Ринна к маршалу Тротману и Хильде Хорнсвоггл. Убейте 25 солдат Орды.‡Tötet 25 Mitglieder der Horde und begleitet König Varian Wrynn, um Marschall Trottmann und Hilda Hornsturz zu finden.‡국왕 바리안 린과 함께 작전사령관 트로트먼, 힐다 혼스웨글을 찾고, 호드 25명을 처치해야 합니다. 레벨 15‡Acompaña al rey Varian Wrynn a buscar al mariscal Troteman, Hilda Brindacuerno y mata a 25 miembros de la Horda.‡‡Accompagnez le Roi Varian Wrynn et retrouvez le Maréchal Troteman, Hilda Cornegidouille, puis tuez 25 membres de la Horde.‡陪伴瓦里安·乌瑞恩国王找到托德曼元帅和希尔达·盘角并击败25名部落成员。‡',
  }
},
[32248] = {
  {
    'Um pouco de paciência‡Немного терпения‡Ein wenig Geduld‡약간의 참을성‡Templanza‡‡Un peu de patience‡王者的耐心‡',
    nil,
    'Entre no cenário "Um pouco de paciência" e apresente-se ao rei Varian Wrynn. Uma‡Начните сценарий "Немного терпения" и обратитесь к королю Вариану Ринну. задание.‡Betretet das Szenario Ein wenig Geduld und meldet Euch bei König Varian Wrynn.‡"약간의 참을성" 시나리오에 참가해 국왕 바리안 린을 만나야 합니다. 레벨 15‡Entra en la gesta "Templanza" y preséntate ante el rey Varian Wrynn.‡‡Lancez le scénario « Un peu de patience » et parlez au Roi Varian Wrynn.‡进入场景战役“王者的耐心”并向瓦里安·乌瑞恩国王报到。‡',
  }
},
[32249] = {
  {
    'Conheça a batedora‡Встреча с разведчицей‡Treffen mit der Späherin‡정찰병 만나기‡Reúnete con la exploradora‡‡À la rencontre de l’éclaireuse‡寻找斥候‡',
    nil,
    'Fale com a Batedora Rokla no Local de Pouso da Horda, que fica na Selva de Krasarang. Uma‡Поговорите с разведчицей Роклой в Точке высадки Орды, что в Красарангских джунглях.‡Sprecht mit Späherin Rokla bei der Landezone der Horde in der Krasarangwildnis.‡크라사랑 밀림의 호드 상륙지에 있는 정찰병 로클라와 대화해야 합니다. 레벨 15‡Habla con la exploradora Rokla en el Lugar del Desembarco de la Horda, en la Espesura Krasarang.‡‡Parlez à l’Éclaireuse Rokla au Site de débarquement de la Horde, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的部落登陆点和斥候罗克拉谈一谈。‡',
  }
},
[32250] = {
  {
    'O poder do Chefe Guerreiro‡Могущество вождя‡Die Macht des Kriegshäuptlings‡대족장의 힘‡El poderío del Jefe de Guerra‡‡La puissance du chef de guerre‡酋长的力量‡',
    nil,
    'Acompanhe Garrosh Grito Infernal na busca por Guarda-de-sangue Gro’tash e Grislo Engrenário, e mate 25 membros da Aliança. Uma‡Сопроводите Гарроша Адского Крика к кровавому стражу Гро\'ташу и Гриззлу Скрипетолу, а также уничтожьте 25 бойцов Альянса.‡Begleitet Garrosh Höllschrei, sucht Blutwache Gro\'tash und Grizzle Radflutsch und tötet 25 Mitglieder der Allianz.‡가로쉬 헬스크림과 함께 혈투사 그로타쉬, 그리즐 기어슬립을 찾고, 얼라이언스 25명을 처치해야 합니다. 레벨 15‡Acompaña a Garrosh Grito Infernal a buscar al guardia de sangre Gro\'tash y a Llorica Tuercafloja, y mata a 25 miembros de la Alianza.‡‡Accompagnez Garrosh Hurlenfer pour retrouver le Garde de sang Gro’tash, Geignard Glissécrou et tuez 25 membres de l’Alliance.‡陪伴加尔鲁什找到血卫士高塔什和格里兹尔·轮滑并击败25名联盟成员。‡',
  }
},
[32251] = {
  {
    'Adaga no escuro‡Кинжал во тьме‡Ein Dolch im Dunkel‡어둠 속의 비수‡Una Daga en la Oscuridad‡‡Une dague dans la nuit‡黑暗中的匕首‡',
    nil,
    'Entre no cenário "Adaga no escuro" e apresente-se a Vol\'jin. Uma‡Начните сценарий "Кинжал во тьме" и обратитесь к Вол\'джину. это‡Betretet das Szenario Ein Dolch im Dunkel und meldet Euch bei Vol\'jin.‡"어둠 속의 비수" 시나리오에 참가해 볼진에게 보고해야 합니다. 레벨 15‡Entra en la gesta "Una Daga en la Oscuridad" y preséntate ante Vol\'jin.‡‡Lancez le scénario « Une dague dans la nuit » et parlez à Vol’jin.‡进入场景战役“黑暗中的匕首”并向沃金报到。‡',
  }
},
[32252] = {
  {
    'Arautos dos Loa‡Вестники лоа‡Vorboten der Loa‡로아의 선구자들‡Presagistas de los loa‡‡Les présages des Loas‡神灵先驱‡',
    nil,
    'Mate 2 Arautos dos Loa. Uma‡Победите 2 вестников лоа.‡Tötet 2 Vorboten der Loa.‡로아의 선구자 2명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 2 presagistas de los loa.‡‡Tuez 2 Messagers des Loas.‡消灭2位神灵先驱。‡',
  }
},
[32253] = {
  {
    'REMOVE (No Longer Used)‡REMOVE (No Longer Used)‡ENTFERNEN (Nicht mehr benutzt)‡제거됨 (사용하지 않음)‡REMOVE (No Longer Used)‡‡REMOVE (No Longer Used)‡REMOVE (No Longer Used)‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32254] = {
  {
    'Manipulando os sauroks‡Манипулирование сауроками‡Die Saurok manipulieren‡사우록 조종하기‡Cómo manipular a un saurok‡‡La manipulation des sauroks‡掌控蜥蜴人‡',
    nil,
    'Fale com Magíster Arlan, Magíster Sarien e Magistra Vergara. Uma‡Поговорите с магистрами Арланом, Сариеном и Весарой.‡Meldet Euch bei Magister Arlan, Magister Sarien und Magistrix Vesara.‡마법학자 알란, 마법학자 사리엔, 마법학자 베사라를 찾아가야 합니다. 레벨 32 천둥의 섬‡Preséntate ante los magistri Arlan, Sarien y Vesara.‡‡Présentez-vous au Magistère Arlan, au Magistère Sarien et à la Magistrice Vesara.‡向魔导师奥尔兰、魔导师萨雷恩和魔导师维莎拉报到。‡',
  }
},
[32255] = {
  {
    'Esses constructos têm dono‡Возвращение големов‡Dekonstruktion‡사라진 피조물‡Nuestra maquinaria‡‡Dé-construction‡解体‡',
    nil,
    'Recupere os quatro Constructos Fendessol roubados. Uma‡Верните 4 украденных големов Похитителей Солнца.‡Beschafft die vier gestohlenen Konstrukte der Sonnenhäscher wieder.‡도둑맞은 선리버 피조물을 4개 되찾아야 합니다. 레벨 32 천둥의 섬‡Recupera los cuatro ensamblajes Atracasol robados.‡‡Récupérez les 4 Assemblages saccage-soleil volés.‡夺回4个被偷走的夺日者构造体。‡',
  }
},
[32256] = {
  {
    'Ascensão de um império‡Расцвет империи‡Der Aufstieg eines Reichs‡제국의 수립‡El alzamiento de un imperio‡‡L’essor d’un empire‡帝国的崛起‡',
    nil,
    'Encontre o Chefe Guerreiro Grito Infernal no Santuário das Duas Luas. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите вождя Гарроша в святилище Двух Лун. Поговорите с Так-Таком в крепости Покорителей.‡Findet Kriegshäuptling Höllschrei beim Schrein der Zwei Monde. Sprecht mit Tak-Tak bei der Herrschaftsfeste bezüglich einer Transportmöglichkeit.‡두 달의 제단에 있는 대족장 가로쉬 헬스크림을 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra al jefe de guerra Grito Infernal en el Santuario de las Dos Lunas. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte.‡‡Trouvez le chef de guerre Hurlenfer au Sanctuaire des Deux-Lunes. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去双月殿找加尔鲁什·地狱咆哮。可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32257] = {
  {
    'Voz dos deuses‡Глас богов‡Stimme der Götter‡신의 목소리‡La voz de los dioses‡‡La voix des dieux‡众神之声‡',
    nil,
    'Investigue o Guardião Mercurial e obtenha a Tabuleta Korune Antiga. Uma‡Осмотрите ртутного стража и найдите древнюю табличку клана Корун. это‡Untersucht den Quecksilberwächter und besorgt die uralte Tafel der Korun.‡수은 수호자를 조사하고 고대 코룬 서판을 획득해야 합니다. 레벨 15‡Investiga al guardián mercúrico y consigue la tablilla Korune antigua.‡‡Enquêtez sur le Gardien mercurien, puis obtenez l’Ancienne tablette korune.‡调查水银守护者，获得古代寇茹石板。‡',
  }
},
[32258] = {
  {
    'Horde Quest Choice: PvP‡Horde Quest Choice: PvP‡Hordenquestwahl: PvP‡호드 퀘스트 선택: PvP‡Horde Quest Choice: PvP‡‡Horde Quest Choice: PvP‡Horde Quest Choice: PvP‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32259] = {
  {
    'Horde Quest Choice: PvE‡Horde Quest Choice: PvE‡Hordenquestwahl: PvE‡호드 퀘스트 선택: PvE‡Horde Quest Choice: PvE‡‡Horde Quest Choice: PvE‡Horde Quest Choice: PvE‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32260] = {
  {
    'Alliance Quest Choice: PvE‡Alliance Quest Choice: PvE‡Allianzquestwahl: PvE‡얼라이언스 퀘스트 선택: PvE‡Alliance Quest Choice: PvE‡‡Alliance Quest Choice: PvE‡Alliance Quest Choice: PvE‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32261] = {
  {
    'Escolha de Missão da Aliança: JxJ‡Alliance Quest Choice: PvP‡Allianzquestwahl: PvP‡얼라이언스 퀘스트 선택: PvP‡Alliance Quest Choice: PvP‡‡Alliance Quest Choice: PvP‡Alliance Quest Choice: PvP‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32262] = {
  {
    'Audiência cativa‡Возвращение пленников‡Gefesseltes Publikum‡포로 접견‡Público entregado‡‡Entretien forcé‡不情愿的观众‡',
    nil,
    'Liberte 5 Prisioneiros Fendessol no Pico Violeta. Uma‡Освободите 5 пленников из Похитителей Солнца, удерживаемых в окрестностях Аметистового утеса.‡Befreit 5 gefangene Sonnenhäscher auf der Violetten Erhebung.‡보랏빛 마루에서 선리버 포로를 5명 구출해야 합니다. 레벨 32 천둥의 섬‡Libera a 5 miembros Atracasol cautivos cerca de El Alto Violeta.‡‡Libérez 5 Captifs saccage-soleil à la Cime Pourpre.‡在紫罗兰高地附近解救5名夺日者俘虏。‡',
  }
},
[32263] = {
  {
    'Achar batedor perto do acampamento inimigo(ferido,teleportar de volta)‡Find scout near enemy camp (injured, port him back)‡Späher in der Nähe des feindlichen Lagers finden (verletzt, zurückteleportieren)‡‡Find scout near enemy camp (injured, port him back)‡‡Trouver l’éclaireur près du camp ennemi‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32264] = {
  {
    'Enfeitiçado‡Зачарованная книга‡Bezaubernd‡마법으로 장정된 책‡Encantado‡‡Sous le charme‡魔法束缚‡',
    nil,
    'Obtenha o Grimório Surrado de Jaina do Pico Violeta. Uma‡Заберите потрепанную книгу заклинаний Джайны, ее можно найти на Аметистовом утесе.‡Beschafft Euch Jainas verwittertes Zauberbuch von der Violetten Erhebung.‡보랏빛 마루에서 제이나의 낡은 마법책을 손에 넣어야 합니다. 레벨 32 천둥의 섬‡Recupera el libro de hechizos deteriorado de Jaina de El Alto Violeta.‡‡Récupérez le Livre de sorts abîmé de Jaina à la Cime Pourpre.‡从紫罗兰高地取回吉安娜的褪色法术书。‡',
  }
},
[32265] = {
  {
    'Moganita Carregada‡Заряженный моганит‡Aufgeladenes Moganit‡충전된 모가나이트‡Moganita cargada‡‡La moganite chargée‡充能绿柱石‡',
    nil,
    'Recupere uma Moganita Carregada e leve-a ao Grão-arcanista Savor. Uma‡Найдите заряженный моганит и принесите его верховному чародею Савору.‡Beschafft ein Stück aufgeladenes Moganit und bringt es zu Hocharkanist Savor.‡충전된 모가나이트를 되찾아 대신비술사 세이버에게 가져가야 합니다. 레벨 32 천둥의 섬‡Recupera una moganita cargada y llévasela al alto arcanista Savor.‡‡Récupérez de la Moganite chargée et rapportez-la au Grand arcaniste Savor.‡找到一块充能绿柱石，并将它带给高阶奥术师西瓦。‡',
  }
},
[32266] = {
  {
    'Manifestações de Mana‡Олицетворение маны‡Manamanifestationen‡마나의 현신‡Manifestaciones de maná‡‡Manifestations de mana‡法力展现‡',
    nil,
    'Mate 9 Manamaníacos do Kirin Tor. Uma‡Убейте 9 манадемонов Кирин-Тора.‡Tötet 9 Manageister der Kirin Tor.‡키린 토 마나마귀를 9마리 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 9 malignos de maná del Kirin Tor.‡‡Tuez 9 Manafiels du Kirin Tor.‡击败9名肯瑞托嗜魔者。‡',
  }
},
[32267] = {
  {
    'Destruir o portal inimigo perto do acampamento (transmissão de atacantes, defendido, inimigo pode usar)‡Destroy enemy portal near camp (streaming attackers, defended, enemy can use)‡Feindliches Portal beim Lager zerstören (einströmende Angreifer, verteidigt, kann vom Feind benutzt werden)‡‡Destroy enemy portal near camp (streaming attackers, defended, enemy can use)‡‡Détruire le portail ennemi près du camp‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32268] = {
  {
    'Bombas Táticas de Mana‡Тактические мана-бомбы‡Taktische Manabomben‡전술 마나 폭탄‡Explota, explota, me expló...‡‡Bombes de mana tactiques‡战术魔法炸弹‡',
    nil,
    'Plante uma Bomba Tática de Mana em um Navio da Aliança, em um Carregamento de Suprimentos da Aliança e no Ritual do Constructo. Um(a) missão.‡Установите тактическую мана-бомбу на корабле Альянса, партии припасов Альянса и в месте проведения ритуала возведения.‡Bringt jeweils eine taktische Manabombe an einem Schiff der Allianz, bei den Versorgungsgütern der Allianz und beim Konstruktritual an.‡전술 마나 폭탄을 얼라이언스 함선, 얼라이언스 보급품 화물, 피조물 생성소에 설치해야 합니다. 레벨 32 천둥의 섬‡Coloca una bomba de maná táctica en un barco de la Alianza, en un cargamento de suministros de la Alianza y en el ritual de ensamblaje. Un(a) misión.‡‡Placez une Bombe de mana tactique sur un Vaisseau de l’Alliance, sur le Ravitaillement de l’Alliance et sur le Rituel d’assemblage. Un(e) quête.‡在联盟舰船、联盟补给品和构造体仪式上放置战术魔法炸弹。‡',
  }
},
[32269] = {
  {
    'Derrubando as defesas‡Вывести защиту из строя‡Die Verteidigung zerstören‡방어 무너뜨리기‡Rompiendo las defensas‡‡Briser les défenses‡‡',
    nil,
    'Destrua 6 Proteções de Perímetro Kirin Tor. Uma‡Уничтожьте 6 защитных кристаллов Кирин-Тора.‡Zerstört 6 Schutzzauber der Kirin Tor.‡키린 토 구역 수호물을 6개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 6 resguardos de perímetro del Kirin Tor.‡‡Détruisez 6 Garde-périmètre du Kirin Tor.‡‡',
  }
},
[32270] = {
  {
    'Desarmar minas perto do acampamento inimigo (cutucar elas com um graveto)‡Disarm mines near enemy camp (poke them with a stick =P)‡Minen in der Nähe des feindlichen Lasgers zerstören (stupst sie mit \'nem Stock :P)‡‡Disarm mines near enemy camp (poke them with a stick =P)‡‡Désarmer les mines près du camp ennemi‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32271] = {
  {
    'Armar minas mágicas perto do acampamento (usando relâmpagos de modern warfare)‡Set magical mines around camp (using modern warfare lightning)‡Legt Minen um das Lager (mit modernster Blitzkriegstechnik)‡‡Set magical mines around camp (using modern warfare lightning)‡‡Placer des mines magiques autour du camp‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32272] = {
  {
    'Iniciar e defender o ritual de evocação perto do acampamento inimigo‡Start and defend summoning ritual near enemy camp‡Das Beschwörungsritual beim feindlichen Lager beginnen und verteidigen‡‡Start and defend summoning ritual near enemy camp‡‡Lancer puis défendre le rituel d’invocation près du camp ennemi‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32273] = {
  {
    'Destruir os círculos de evocação perto do acampamento inimigo (BloodElf_PowerOrb_Red)‡Destroy summoning circles in enemy camp (BloodElf_PowerOrb_Red)‡Beschwörungskreise im feindlichen Lager zerstören‡‡Destroy summoning circles in enemy camp (BloodElf_PowerOrb_Red)‡‡Détruire les cercles d’invocation dans le camp ennemi‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32274] = {
  {
    'Os moradores de Ihgaluk‡Обитатели утесов Ихгалук‡Die Bewohner von Ihgaluk‡이갈룩의 주민‡Los habitantes de Ihgaluk‡‡Les résidents d\'Ihgaluk‡伊瓜鲁克的住民‡',
    nil,
    'Mate um Bruto Gumeskuma, um Sacerdote-sáurio Gumeskuma e um Dragão-marinho Gumeskuma. Uma‡Убейте громилу Гнилого Клинка, сауро-жреца Гнилого Клинка и рассекателя волн Гнилого Клинка.‡Tötet einen Schläger der Skumklingen, einen Saurierpriester der Skumklingen und einen Meerdrachen der Skumklingen.‡부랑칼날 투사, 부랑칼날 공룡사제, 부랑칼날 바다도마뱀을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a un tosco Hojaescoria, a un sacerdote saurio Hojaescoria y a un dragón marino Hojaescoria.‡‡Tuez une Brute crasselame, un Prêtre-saure crasselame et un Dragon de mer crasselame.‡击败1个邪刃蛮兵、1个邪刃蜥首牧师和1个邪刃海龙战士。‡',
  }
},
[32275] = {
  {
    'Morte cirúrgica‡Оперативная смерть‡Tod mit chirurgischer Präzision‡해결사가 왔노라‡Una muerte precisa‡‡Mort chirurgicale‡手术式死亡‡',
    nil,
    'Mate 3 Amarra-espíritos Zandalari, 3 Chama-feras Zandalari e 3 Guerreiros Jaguar Zandalari. Uma‡Убейте 3 зандаларских душеловов, 3 зандаларских заклинателей зверей и 3 зандаларских воинов-ягуаров.‡Tötet 3 Geisterbinder der Zandalari, 3 Bestienrufer der Zandalari und 3 Jaguarkrieger der Zandalari.‡잔달라 영혼결속자 3명, 잔달라 야수소환사 3명, 그리고 잔달라 재규어 전사 3명을 처치해야 합니다.‡Mata a 3 vinculadores de espíritus Zandalari, a 3 clamabestias Zandalari y a 3 guerreros jaguar Zandalari.‡‡Tuez 3 Lieurs d’esprit zandalari, 3 Mande-bêtes zandalari et 3 Guerriers jaguar zandalari.‡击败3名赞达拉缚灵者、3名赞达拉驭兽师和3名赞达拉丛林豹战士。‡',
  }
},
[32276] = {
  {
    'Derrubem a Muralha!‡Разрушить эту стену!‡Die Mauer muss weg!‡성벽을 무너뜨려라!‡¡Abajo la Muralla!‡‡Démolissez ce mur !‡摧毁城墙！‡',
    nil,
    'Fale com Lor\'themar Theron, então infiltre-se no bairro inferior e reivindique-o para a Horda. Uma‡Поговорите с Лор\'темаром Тероном, а затем займите нижний город и обеспечьте там безопасность для войск Орды.‡Sprecht mit Lor\'themar Theron und dringt dann in die untere Stadt vor, um sie für die Horde zu erobern.‡로르테마르 테론과 대화하고 호드를 위해 성벽을 확보해야 합니다. 레벨 32 천둥의 섬‡Habla con Lor\'themar Theron, entra en el Bajo Arrabal y asegúralo para la Horda.‡‡Parlez à Lor’themar Theron, puis introduisez-vous dans la Ville basse et sécurisez-la pour la Horde.‡与洛瑟玛·塞隆交谈，然后攻入城市下层，为部落夺取它。‡',
  }
},
[32277] = {
  {
    'Para os Céus!‡В небо!‡In die Lüfte!‡하늘 높이!‡¡Hacia los Cielos!‡‡En route vers les cieux !‡直冲云霄！‡',
    nil,
    'Obtenha acesso à Mina do Veio Relâmpago. Uma‡Проникните в Шахту Молний.‡Verschafft Euch Zugang zu den Blitzaderminen.‡번개 광맥 광산을 확보해야 합니다. 레벨 32 천둥의 섬‡Consigue acceder a la Mina del Relámpago.‡‡Frayez-vous un chemin jusqu’à la Veine de Foudremine.‡进入闪电矿脉。‡',
  }
},
[32278] = {
  {
    'Ação decisiva‡Решительные меры‡Entschlossenes Handeln‡단호한 행동‡Acción decisiva‡‡Action décisive‡果断行动‡',
    nil,
    'Infiltre-se no Ancoradouro do Mar Revolto e abra o portão do paço por dentro. Fale com Taoshi para começar a missão. Uma‡Проникните на Пристань Бушующих Волн и откройте ворота изнутри. Поговорите с Таоши, чтобы начать задание.‡Infiltriert den Sturmgepeitschten Hafen und öffnet das Tor zum Hof von innen. Sprecht mit Taoshi, um die Mission zu beginnen.‡폭풍바다 선착장에 침투하여 안의 안마당 관문을 열어야 합니다. 타오스에게 말을 걸어 임무를 시작하십시오.‡Infíltrate en el Muelle Aguaturbia y abre la puerta del patio desde dentro. Habla con Taoshi para comenzar la misión.‡‡Infiltrez le Débarcadère de la mer des Tempêtes et ouvrez la porte de la cour de l’intérieur. Parlez à Taoshi pour commencer la mission.‡渗透进风暴之海码头并从里面打开庭院大门。与陶矢交谈来开始任务。‡',
  }
},
[32279] = {
  {
    'A Queda de Shan Bu‡Падение Шань-Бу‡Der Sturz von Shan\'Bu‡샨 부의 몰락‡La Caída de Shan Bu‡‡La chute de Shan Bu‡山怖之死‡',
    nil,
    'Derrote Shan Bu. Uma‡Победите Шань-Бу.‡Besiegt Shan\'Bu.‡샨 부를 처치해야 합니다. 레벨 32 천둥의 섬‡Derrota a Shan Bu.‡‡Vainquez Shan Bu.‡击败山怖。‡',
  }
},
[32280] = {
  {
    'Metalpocalipse‡Мателлокалипсис‡Metallokalypse‡‡El metal se va a acabar‡‡Métalocalypse‡金铁末世录‡',
    nil,
    'Mate o Senhor do Metal Mono-Han do lado de fora das Minas de Metal Fantasma, que fica na Ilha do Rei Trovão. Uma‡Убейте повелителя металла Моно-Ханя у Шахты молний на Острове Грома.‡Tötet Metallfürst Mono-Han außerhalb der Blitzadermine auf der Insel des Donnerkönigs.‡‡Mata al señor del metal Mono-Han en el exterior de las minas de hierro fantasma, en la Isla del Rey del Trueno.‡‡Tuez le Seigneur du métal Mono Han à l’extérieur de la Veine de Foudremine, sur l’Île du Tonnerre.‡去雷神岛的闪电矿脉击败金铁领主莫诺汗。‡',
  }
},
[32281] = {
  {
    'O fim do moldacarne‡Кончина плотореза‡Das Ende des Fleischschmieds‡살덩이창조자의 종말‡El fin del modelador de carne‡‡La fin du Façonneur de chair‡塑肌者的末日‡',
    nil,
    'Mate o Moldacarne Goju do lado de fora das Minas de Ferro Fantasma, que fica na Ilha do Rei Trovão. Uma‡Убейте плотореза Гоцзю у Шахты молний на Острове Грома.‡Tötet Fleischschmied Goju außerhalb der Blitzadermine auf der Insel des Donnerkönigs.‡천둥의 섬, 유령무쇠 광산에서 살덩이창조자 고주를 처치해야 합니다. 레벨 1 천둥의 섬‡Mata al modelador de carne Goju en el exterior de las minas de hierro fantasma, en la Isla del Rey del Trueno.‡‡Tuez le Façonneur de chair Goju à l’extérieur de la Veine de Foudremine, sur l’Île du Tonnerre.‡去雷神岛的闪电矿脉外击败塑肌者霍古。‡',
  }
},
[32282] = {
  {
    'Pisada de dino‡Компот из компсогната‡Compyknüppler‡야수 처치‡Matanza jurásica‡‡Compicide‡践踏掠食龙‡',
    nil,
    'Mate 5 Raptores e 10 Dinos Treinados no Cercado das Feras. Uma‡Убейте 5 ящеров и 10 дрессированных компсогнатов в загонах для зверей.‡Tötet 5 Raptoren und 10 abgerichtete Compys in den Bestienpferchen.‡야수 조련소에서 랩터 5마리와 훈련된 콤피 10마리를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 5 raptores y a 10 minirraptores adiestrados en El Cerco de las Bestias.‡‡Tuez 5 Raptors et 10 Compies apprivoisés dans les Enclos à bêtes.‡在兽栏杀死5只迅猛龙和10只训练有素的掠食龙。‡',
  }
},
[32283] = {
  {
    'Loassauro‡Лоа-завр‡Loasaurus‡로아가 깃든 야수‡Hechizos muy poco loa-bles‡‡Loa-saure‡神龙‡',
    nil,
    'Derrote um Voz-dos-loas. Uma‡Победите говорящего с лоа.‡Bezwingt einen Loasprecher.‡로아 전령을 처치해야 합니다. 레벨 32 천둥의 섬‡Derrota a un portavoz loa.‡‡Battez un Parle-loa.‡击败一名神谕者。‡',
  }
},
[32284] = {
  {
    'Alguém que você deveria ver‡Нужная встреча‡Jemand, den Ihr treffen solltet‡당신이 봐야 할 사람‡Alguien te espera‡‡Quelqu’un à voir‡必须见的人‡',
    nil,
    'Encontre Chen Malte do Trovão na Vila Binan. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите Чэня Буйного Портера в деревне Бинан. Поговорите с Так-Таком в Крепости Покорителей, чтобы добраться туда.‡Findet Chen Sturmbräu in Binan. Sprecht mit Tak-Tak bei der Herrschaftsfeste bezüglich einer Transportmöglichkeit.‡빈안 마을에 있는 첸 스톰스타우트를 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra a Chen Cerveza de Trueno en la Aldea Binan. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte.‡‡Trouvez Chen Brune d’Orage à Binan. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去滨岸村找陈·风暴烈酒。可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32285] = {
  {
    'A legião que nunca dorme‡Недремлющий легион‡Die schlaflose Legion‡잠들지 않는 군단‡La legión insomne‡‡La légion sans sommeil‡无眠军团‡',
    nil,
    'Mate 6 Guerreiros Animados. Uma‡Убейте 6 оживших воинов.‡Tötet 6 animierte Krieger.‡살아 움직이는 전사 6명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 6 guerreros animados.‡‡Tuez 6 Guerriers animés.‡消灭6个复活的战士。‡',
  }
},
[32286] = {
  {
    'Matar Sanguinários Mogus (Rondando em pares, lutando ativamente contra batedores e realizando rituais em cadáveres)‡Kill Mogu Blood-seekers (Roaming pairs, actively fighting scouts, and performing rituals on corpses)‡Blutsucher der Mogu töten (wandernde Zweirgruppen, die Späher aktiv bekämpfen und Rituale an Leichen durchführen)‡모구 피추적자 처치‡Kill Mogu Blood-seekers (Roaming pairs, actively fighting scouts, and performing rituals on corpses)‡‡Tuer des cherche-sangs mogu‡Kill Mogu Blood-seekers (Roaming pairs, actively fighting scouts, and performing rituals on corpses)‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32287] = {
  {
    'Inimigos na torre‡Враги под башней‡Feinde unter dem Turm‡탑 밑의 적‡Enemigos bajo la torre‡‡Les ennemis sous la tour‡高塔下的强敌‡',
    nil,
    'Mate 7 Mogus Shan\'ze na Charneca Turva. Uma‡Убейте 7 могу Шань\'цзэ в Мрачных топях.‡Tötet 7 Mogu der Shan\'ze im Düstermoor.‡불길한 습지에 있는 샨쩌 모구 7명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 7 mogu Shan\'ze en Malandanza.‡‡Tuez 7 Mogu Shan’ze dans la Morne Lande.‡在阴惨泥沼消灭7个山泽魔古。‡',
  }
},
[32288] = {
  {
    'Reforçando as defesas‡Укрепим оборону‡Die Verteidigung stärken‡방어 강화하기‡Fortalece las defensas‡‡Renforcer les défenses‡加强防御‡',
    nil,
    'Energize 6 Proteções do Perímetro Fendessol. Uma‡Усильте 6 защитных кристаллов Похитителей Солнца.‡Ladet 6 Schutzzauber der Sonnenhäscher auf.‡선리버 구역 수호물을 6개 강화해야 합니다. 레벨 32 천둥의 섬‡Potencia 6 resguardos de perímetro Atracasol.‡‡Renforcez 6 Garde-périmètre saccage-soleil.‡强化6个夺日者监视结界。‡',
  }
},
[32289] = {
  {
    'Planos de saque, mate o capitão do barco‡Loot plans, kill boat captain‡Pläne erbeuten, Kapitän töten‡계획서 탈취, 보스 처치‡Loot plans, kill boat captain‡‡Plans de pillage, tuer le capitaine du navire‡Loot plans, kill boat captain‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32290] = {
  {
    'Unused‡Unused‡Ungenutzt‡미사용‡Unused‡‡UNUSED‡Unused‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32291] = {
  {
    '‡‡Der Sturz von Shan\'Bu‡‡‡‡‡山怖之死‡',
    nil,
    '‡‡Tötet Shan\'Bu.‡‡‡‡‡‡',
  }
},
[32292] = {
  {
    'Forja adiante!‡Впереди кузня!‡Schmiede voraus!‡제련소로!‡¡Hacia la forja!‡‡Forge droit devant !‡近在眼前！‡',
    nil,
    'Mate o Mestre da Forja e pegue um Fragmento de Códice do Moldacarne Hoku na Ilha do Trovão. Uma‡Убейте главного кузнеца и получите фрагмент кодекса от стража врат могу на острове Грома.‡Tötet den Meister der Schmiede und sammelt ein Kodexfragment von Fleischschmied Hoku auf der Insel des Donners ein.‡천둥의 섬에 있는 제련소 대장을 처치하고 살덩이창조자 호쿠에게서 모구 전서 조각을 수집해야 합니다.‡Mata al maestro de la forja y recoge un fragmento de códice del modelador de carne Hoku en la Isla del Trueno.‡‡Tuez le Maître de la forge et récupérez un Fragment de codex sur le Façonneur de chair Hoku, sur l’Île du Tonnerre.‡击败锻造大师，并从雷神岛的塑肌者霍古身上取得一块法典碎片。‡',
  }
},
[32293] = {
  {
    'Entre os ossos‡Среди костей‡In den Knochen‡뼈들 사이에‡El coleccionista de huesos‡‡Parmi les os…‡白骨之间‡',
    nil,
    'Mate Zur\'chaka, o Cria-ossos. Uma‡Убейте Зур\'чаку Ваятеля Костей.‡Tötet Zur\'chaka den Knochenformer.‡뼈세공사 주르차카를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a Zur\'chaka el Artesano de huesos.‡‡Tuez Zur’chaka le Sculpteur d’os.‡消灭锻骨者祖尔查卡。‡',
  }
},
[32294] = {
  {
    'Chuva de ossos‡Дождь из костей‡Knochenregen‡‡Huesos para dar y vender‡‡Il pleut des os‡‡',
    nil,
    'Mate Zur\'chaka, o Cria-ossos. Uma‡Убейте Зур\'чаку Ваятеля Костей.‡Tötet Zur\'chaka den Knochenformer.‡‡Mata a Zur\'chaka el Artesano de huesos.‡‡Tuez Zur’chaka le Sculpteur d’os.‡‡',
  }
},
[32295] = {
  {
    'Um tomo incomum‡Необычная книга‡Ein ungewöhnlicher Foliant‡기이한 책‡Un escrito inusual‡‡Un tome insolite‡与众不同的书‡',
    nil,
    'Fale com seu lacaio demoníaco para determinar a origem do tomo. Uma‡Поговорите с вашим демоническим прислужником, чтобы определить происхождение книги.‡Sprecht mit Euren dämonischen Dienern, um mehr über die Ursprünge des Folianten zu erfahren.‡자신의 악마 소환수와 대화하고 이 책의 기원을 알아내야 합니다. 레벨 35‡Habla con tus esbirros demoníacos para determinar el origen del escrito.‡‡Parlez à votre Serviteur démoniaque pour déterminer les origines de ce tome.‡与你的恶魔仆从对话，找出这本书的来源。‡',
  }
},
[32296] = {
  {
    'Tesouros do Rei Trovão‡Сокровища Властелина Грома‡Schätze des Donnerkönigs‡천둥왕의 보물‡Tesoros del Rey del Trueno‡‡Les trésors du roi-tonnerre‡雷电之王的宝藏‡',
    nil,
    'Fale com Taoshi para penetrar na Cidadela do Rei Trovão. Lá dentro, entregue-lhe a chave do Palácio de Lei Shen para começar o ataque coordenado ao comboio que leva o tesouro.‡Поговорите с Таоши, чтобы войти в цитадель Властелина Грома. Там отдайте ей ключи от дворца Лэй Шэня, чтобы начать набег на охрану сокровищницы.‡Sprecht mit Taoshi, um die Zitadelle des Donnerkönigs zu betreten. Beschafft ihr dort einen Schlüssel zu Lei Shens Palast, um den zeitbegrenzten Beutezug auf seine Schatzlieferung zu beginnen.‡타오스와 대화해 천둥왕의 성채에 들어가야 합니다. 성채에 들어가면 레이 션 궁전으로 통하는 문의 열쇠를 타오스에게 주고 보물 상자를 열어 제한된 시간 동안 보물을 최대한 많이 획득해야 합니다.‡Habla con Taoshi para entrar en la Ciudadela del Rey del Trueno. Una vez dentro, consigue la llave del palacio de Lei Shen para comenzar el evento de banda contrarreloj de su valioso convoy.‡‡Parlez à Taoshi pour entrer dans la Citadelle du Roi-tonnerre. Une fois à l’intérieur, procurez-lui une Clé du palais de Lei Shen pour commencer l’attaque chronométrée contre le convoi transportant le trésor de Lei Shen.‡与陶矢交谈来进入雷电堡。在里面，把雷神宫殿钥匙交给她，来开始对雷神宝藏护卫的计时突袭。‡',
  }
},
[32297] = {
  {
    'Demossauro ou Escornante‡Дикорог или дьявозавр‡Terrorhorn oder Teufelssaurier‡공포뿔이냐 데빌사우루스냐‡Cuernoatroz o demosaurio‡‡Navrecorne ou diablosaure‡恐角龙或魔暴龙‡',
    nil,
    'Interrompa um ritual de vinculação matando todos os PNJs ao redor de um Escornante Teimoso ou de um Demossauro Teimoso. Uma‡Прервите подчиняющий ритуал, убив всех неигровых персонажей вокруг непокорного дикорога или непокорного дьявозавра.‡Unterbrecht ein Bindungsritual, indem Ihr alle Trolle tötet, die ein starrsinniges Terrorhorn oder einen widerspenstigen Teufelssaurier umringen.‡반항적인 공포뿔이나 반항적인 데빌사우루스 주변에 있는 잔달라 트롤들을 모두 처치해 결속 의식을 방해해야 합니다.‡Interrumpe un ritual de vinculación matando a todos los PNJ que estén alrededor de un cuernoatroz desafiante o de un demosaurio desafiante.‡‡Interrompez un Rituel de lien en tuant tous les participants au rituel autour d’un Navrecorne défiant ou d’un Diablosaure défiant. Un(e) quête.‡击败傲慢的恐角龙或傲慢的魔暴龙身边的所有NPC以扰乱束缚仪式。‡',
  }
},
[32298] = {
  {
    'Poder dino‡Мощь динозавра‡Saurierstark‡강력한 공룡‡Fuerza jurásica‡‡Dino mythe‡史前巨兽‡',
    nil,
    'Encontre e use Fetiches Sáurios em 5 raptores, dinos, gritacéus ou escornantes no Cercado das Feras. Uma‡Найдите и используйте заврофетиши на 5 ящерах, компсогнатах, небесных крикунах или дикорогах в загонах для зверей.‡Findet Saurierfetische und wendet sie auf 5 Raptoren, Compys, Himmelskreischer oder Terrorhörner in den Bestienpferchen an.‡사우루스 우상을 찾아 야수 조련소에 있는 랩터나 콤피, 비명익룡 또는 공포뿔 5마리에게 사용해야 합니다.‡Encuentra y utiliza fetiches saurios en 5 raptores, minirraptores, vociferadores de cielos o cuernoatroces en El Cerco de las Bestias. Un(a) misión.‡‡Trouvez et utilisez des Fétiches de saurien sur 5 Raptors, Compies, Hurleciel ou Navrecornes dans les Enclos à bêtes.‡找到并对兽栏中的5只迅猛龙、掠食龙、啸天龙或恐角龙使用恐龙神像。‡',
  }
},
[32299] = {
  {
    'Só um trabalho leve de limpeza‡Небольшая чистка‡Nur leichte Aufräumarbeiten‡단순 청소 작업‡Hay que ensuciarse las manos de vez en cuando‡‡Un peu de nettoyage‡清洁工作‡',
    nil,
    'Espalhe 75 pedaços de sujeira matando a Imundície Trêmula no Penhasco Ihgaluk. Uma‡Уничтожьте 75 частиц дрожащей гнили на утесах Ихгалук.‡Zerstreut 75 Dreckstücke, indem Ihr den wabernden Dreck in der Ihgalukklamm tötet.‡이갈룩 바위산에서 벌벌떠는 구린액을 처치해 구린액 방울을 75개 흩뜨려야 합니다. 레벨 32 천둥의 섬‡Dispersa 75 montones de basura matando a inmundicias temblorosas en el Risco Ihgaluk.‡‡Dispersez 75 tas d’ordures en tuant des Crasses tremblantes dans la Combe d’Ihgaluk.‡击败伊瓜鲁克峭壁的颤栗污泥怪以分解75块污物。‡',
  }
},
[32300] = {
  {
    'Ironia que desarma‡Взрывоопасная ирония‡Entwaffnende Ironie‡얄궂은 해제‡Una ironía de la muerte‡‡Ironie désarmante‡枉费心机‡',
    nil,
    'Desarme as Bombas Táticas de Mana nos Navios da Horda, nos Cristais de Vidência e na Ponte do Promontório Buscalva. Uma‡Обезвредьте тактические мана-бомбы на мысе Искателя Рассвета. Они находятся у кораблей Орды, у кристаллов ясновидения и на мосту.‡Entschärft die taktischen Manabomben an den Schiffen der Horde, den Seherkristallen und der Brücke am Morgensucherkap.‡돈시커 곶 안의 호드 함선, 수정구슬, 교각에 설치된 전술 마나 폭탄을 해제해야 합니다. 레벨 32 천둥의 섬‡Desarma las bombas de maná tácticas en los barcos de la Horda, en los cristales de visión y en el puente del Promontorio Buscalba. Un(a) misión.‡‡Désamorcez les Bombes de mana tactiques sur les Vaisseaux de la Horde, les Cristaux de divination et sur le Pont au Promontoire de Cherchelaube.‡卸除部落舰船、占卜水晶和寻晨者海角桥梁处的战术魔法炸弹。‡',
  }
},
[32301] = {
  {
    'Velhos Inimigos‡Старые враги‡Alte Feinde‡숙적‡Viejos enemigos‡‡De vieux ennemis‡宿敌‡',
    nil,
    'Mate 10 agentes ou jogadores Fendessol na Ilha do Trovão. Uma‡Убейте 10 посланников Похитителей Солнца или игроков на острове Грома.‡Tötet auf der Insel des Donners 10 Agenten oder Spielercharaktere, die für die Sonnenhäscher arbeiten.‡천둥의 섬에서 선리버 요원 또는 플레이어 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 agentes o jugadores Atracasol en la Isla del Trueno.‡‡Tuez 10 agents des Saccage-Soleil ou personnages-joueurs sur l’Île du Tonnerre.‡在雷神岛上击败10名夺日者密探或玩家。‡',
  }
},
[32302] = {
  {
    'Desconstrução‡Уничтожение големов‡De-Konstruktion‡해체 작업‡Demolición‡‡Déconstruction‡解体‡',
    nil,
    'Destrua 3 Constructos do Kirin Tor ao redor do Pico Violeta. Uma‡Уничтожьте 3 голема Кирин-Тора на Аметистовом утесе.‡Zerstört 3 Konstrukte der Kirin Tor in der Nähe der Violetten Erhebung.‡보랏빛 마루 주변에 있는 키린 토 피조물을 3개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 3 ensamblajes del Kirin Tor cerca de El Alto Violeta.‡‡Détruisez 3 Assemblages du Kirin Tor autour de la Cime Pourpre.‡在紫罗兰高地附近摧毁3个肯瑞托构造体。‡',
  }
},
[32303] = {
  {
    'Feito para a guerra‡Создан для войны‡Für den Krieg geschaffen‡전쟁을 위해 만들어진‡Hecho para la guerra‡‡Conçu pour la guerre‡为战斗而生‡',
    nil,
    'Mate o Destruidor Arcano. Uma‡Ликвидируйте чародейского разрушителя.‡Tötet den arkanen Zerstörer.‡비전 파괴자를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata al Destructor Arcano.‡‡Tuez le Destructeur arcanique.‡击败奥术毁灭者。‡',
  }
},
[32304] = {
  {
    'Alto Reconhecimento‡Признание и почет‡Große Anerkennung‡표창‡Alta estima‡‡Grande reconnaissance‡高度评价‡',
    nil,
    'Uma‡Твои успехи на поле боя нельзя оставить без внимания. Мне хотелось бы наградить тебя за старания, |3-6(Монах).‡Eure Präsenz auf dem Schlachtfeld ist nicht zu leugnen. Ich möchte Euch dies als zusätzliche Anerkennung für Eure Leistungen überreichen, &lt;Klasse&gt;.‡레벨 32 천둥의 섬‡No se puede pasar por alto tu presencia en el campo de batalla. Quiero darte algo extra por tus esfuerzos, &lt;clase&gt;.‡‡Il est impossible de ne pas remarquer votre présence sur le champ de bataille. J’aimerais vous donner un petit supplément pour vos efforts, &lt;classe&gt;.‡‡',
  }
},
[32305] = {
  {
    'Subjugados‡Перегрузка‡Viel zu stark‡과부하‡Subyugado‡‡Surpuissance‡超强能量‡',
    nil,
    'Destrua 7 Focos de Mana perto do Pico Violeta. Uma‡Уничтожьте 7 мана-сфер на Аметистовом утесе.‡Zerstört 7 Manafokusse auf der Violetten Erhebung.‡보랏빛 마루 주변에 있는 마나 집중 장치를 7개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 7 focos de maná alrededor de El Alto Violeta.‡‡Détruisez 7 Focalisateurs de mana près de la Cime Pourpre.‡在紫罗兰高地附近摧毁7个法力焦镜。‡',
  }
},
[32306] = {
  {
    'Rastreamento de Coleta de Madeira‡Лесозаготовка‡Aufspüren der Holzsammlung‡목재 모으기 추적‡Lumber Collection Tracking‡‡Suivi de la collecte de bois‡木材收集追踪‡',
    nil,
    nil,
  }
},
[32307] = {
  {
    'Leitor da língua morta‡Чтец мертвого языка‡Leser der toten Sprache‡죽은 언어를 읽는 자‡Lector de una lengua muerta‡‡Apprentissage des langues mortes‡死物开口‡',
    nil,
    'Leve o códice a um instrutor de Bruxos em sua capital. Uma‡Отнесите кодекс наставнику чернокнижников в вашей столице. это‡Bringt den Kodex zu einem Hexenmeisterlehrer in Eurer Hauptstadt.‡대도시에 있는 상급 흑마법사에게 고서를 가져가야 합니다. 레벨 35‡Lleva el códice a un instructor de brujos de tu capital.‡‡Apportez le Codex à un Maître des démonistes de votre capitale.‡将抄本交给你的主城中的术士训练师。‡',
  }
},
[32309] = {
  {
    'Um conto de seis mestres‡История шести мастеров‡Die Geschichte der Sechs Meister‡여섯 사부들의 이야기‡Una historia de seis maestros‡‡Les six Maîtres‡大师传说‡',
    nil,
    'Leia o primeiro capítulo do Legado dos Mestres. Uma‡Прочтите первую главу "Наследия мастеров". это‡Lest das erste Kapitel des Erbes der Meister.‡사부들의 유산 제1부를 읽어야 합니다. 레벨 35‡Lee el primer capítulo del Legado de los Maestros.‡‡Lisez le premier chapitre de l’Héritage des Maîtres.‡阅读大师遗训第一章。‡',
  }
},
[32310] = {
  {
    'Um conto de seis mestres‡История шести мастеров‡Die Geschichte der Sechs Meister‡여섯 사부들의 이야기‡Una historia de seis maestros‡‡Les six Maîtres‡大师传说‡',
    nil,
    'Leia o primeiro capítulo do Legado dos Mestres. Uma‡Прочтите первую главу "Наследия мастеров". это‡Lest das erste Kapitel des Erbes der Meister.‡사부들의 유산 제1부를 읽어야 합니다. 레벨 35‡Lee el primer capítulo del Legado de los Maestros.‡‡Lisez le premier chapitre de l’Héritage des Maîtres.‡阅读大师遗训第一章。‡',
  }
},
[32311] = {
  {
    'Ordens de alistamento‡Приказы о зачислении на военную службу‡Musterung‡‡Órdenes de alistamiento‡‡Bons pour le service‡‡',
    nil,
    'Fale com o General Nazgrim no Ponto de Dominação, que fica na Selva de Krasarang. Uma‡Найдите генерала Назгрима в Крепости Покорителей, что в Красарангских джунглях.‡Findet General Nazgrim bei der Herrschaftsfeste in der Krasarangwildnis.‡‡Encuentra al general Nazgrim en el Punto de Dominio, en la Espesura Krasarang.‡‡Trouvez le Général Nazgrim à la Halte de la Domination, dans les Étendues sauvages de Krasarang.‡‡',
  }
},
[32312] = {
  {
    'Ordens de alistamento‡Приказы о зачислении на военную службу‡Musterung‡‡Órdenes de alistamiento‡‡Bons pour le service‡‡',
    nil,
    'Fale com o Almirante Taylor no Ancoradouro do Leão, que fica na Selva de Krasarang. Uma‡Найдите адмирала Тейлора в Львином лагере, что в Красарангских джунглях. Награда: .‡Findet Admiral Taylor in der Löwenlandung in der Krasarangwildnis.‡‡Encuentra al almirante Taylor en el Desembarco del León, en la Espesura Krasarang.‡‡Trouvez l’Amiral Taylor au Territoire du Lion, dans les Étendues sauvages de Krasarang.‡‡',
  }
},
[32313] = {
  {
    'Cace Helheim‡Выследить Хельхейма‡Jagt Helheim‡‡A la caza de Helheim‡‡Traquer Helheim‡‡',
    nil,
    'Obtenha a segunda parte do Legado dos Mestres de Harim Helheim. Uma‡Убейте Харима Хельхейма и заберите вторую часть "Наследия мастеров". это‡Besorgt den zweiten Teil des Erbes der Meister von Harim Helheim.‡‡Obtén la segunda parte del Legado de los Maestros de manos de Hareem Helheim.‡‡Récupérez la deuxième partie de l’Héritage des Maîtres sur Hareem Helheim.‡‡',
  }
},
[32314] = {
  {
    'Elimine Selenora‡Убить Селенору‡Tötet Selenora‡‡A por Selenora‡‡Massacrer Sélénora‡‡',
    nil,
    'Obtenha o segundo capítulo do Legado dos Mestres da Sombramante Selenora no Ponto de Dominação. Uma‡Убейте тенеманта Селенору в Крепости Покорителей и заберите вторую часть "Наследия мастеров".‡Besorgt das zweite Kapitel des Erbes der Meister von Schattenbeschwörerin Selenora in der Herrschaftsfeste.‡‡Obtén la segunda parte del Legado de los Maestros de manos de la sombramántica Selenora, en el Punto de Dominio.‡‡Récupérez le second chapitre de l’Héritage des Maîtres sur la Ténébromancienne Sélénora à la Halte de la Domination.‡‡',
  }
},
[32315] = {
  {
    'A súplica de Anduin‡Призыв о помощи от Андуина‡Anduins Bitte‡안두인의 간청‡La súplica de Anduin‡‡Le plaidoyer d’Anduin‡安度因的求援‡',
    nil,
    'Encontre Anduin no Santuário das Sete Estrelas. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Найдите Андуина в святилище Семи Звезд. Поговорите с Фенни Хорнсвоггл, чтобы добраться туда.‡Findet Anduin beim Schrein der Sieben Sterne. Sprecht mit Fennie Hornsturz in der Löwenlandung bezüglich einer Transportmöglichkeit.‡일곱 별의 제단에 있는 안두인을 찾아야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Encuentra a Anduin en el Santuario de las Siete Estrellas. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Parlez à Anduin au Sanctuaire des Sept-Étoiles. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport. Un(e) quête.‡去七星殿找安度因。你可以与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32316] = {
  {
    'Coração da Aliança‡Сердце Альянса‡Herz der Allianz‡얼라이언스의 심장‡El corazón de la Alianza‡‡Au cœur de l’Alliance‡联盟之心‡',
    nil,
    'Enfrente 6 Soldados Tocados pelo Sha. Se você perder o Príncipe Anduin, fale com ele no Comércio Imperial. Uma‡Сразитесь с 6 пораженными ша пехотинцами. Если вы разминетесь с принцем Андуином, можете встретиться с ним на Императорской бирже.‡Nehmt es mit 6 Sha-berührten Fußsoldaten auf. Solltet Ihr Prinz Anduin verlieren, sprecht mit ihm beim Kaiserlichen Kontor.‡샤에 물든 보병 6명을 구출해야 합니다. 왕자 안두인과 헤어지면, 황실 교역소에서 다시 대화하십시오. 레벨 15‡Enfréntate a 6 lacayos influenciados por el sha. Si pierdes al príncipe Anduin, habla con él en El Intercambio Imperial.‡‡Affrontez 6 Fantassins touchés par les sha. Si vous perdez le Prince Anduin, retournez lui parler à la Bourse impériale.‡对抗6名染煞步兵。要是你和安度因王子走散了，可以去帝皇商站找他。‡',
  }
},
[32318] = {
  {
    'Regeneração leva tempo‡Время на исцеление‡Regeneration will Weile haben‡회복에는 시간이 필요한 법‡La regeneración lleva tiempo‡‡La régénération, ça prend du temps‡争分夺秒‡',
    nil,
    'Colete 10 Espinhos Resistentes. Uma‡Соберите 10 прочных игл. это‡Sammelt 10 starke Nadeln.‡억센 솔잎 10개를 수집해야 합니다. 레벨 15‡Recoge 10 agujas robustas.‡‡Récupérez 10 Aiguilles solides.‡收集10根坚韧松针。‡',
  }
},
[32319] = {
  {
    'Encontre Thrall!‡Найти Тралла!‡Sucht Thrall!‡스랄을 찾아라!‡¡Encuentra a Thrall!‡‡Trouvez Thrall !‡寻找萨尔！‡',
    nil,
    'Encontre Thrall usando a Pedra de Regresso de Vol\'jin. Uma‡Найдите Тралла, воспользовавшись камнем возвращения Вол\'джина. это‡Spürt Thrall mithilfe von Vol\'jins Ruhestein auf.‡볼진의 귀환석을 사용하여 스랄을 찾아야 합니다. 레벨 15‡Utiliza la piedra de hogar de Vol\'jin para encontrar a Thrall.‡‡Trouvez Thrall en utilisant la Pierre de foyer de Vol’jin.‡使用沃金的炉石找到萨尔。‡',
  }
},
[32320] = {
  {
    'A Horda é família‡Орда – одна семья‡Die Horde ist wie eine Familie‡호드는 한 가족이다‡La Horda es la familia‡‡La Horde est une grande famille‡部落即家庭‡',
    nil,
    'Escolte Thrall até as Ilhas do Eco. Uma‡Сопроводите Тралла на острова Эха. это‡Eskortiert Thrall zu den Echoinseln.‡스랄을 메아리 섬까지 안전하게 호위해야 합니다. 레벨 15‡Escolta a Thrall hasta las Islas del Eco.‡‡Escortez Thrall jusqu’aux Îles de l’Écho.‡护送萨尔前往回音群岛。‡',
  }
},
[32321] = {
  {
    'O Rei Macaco‡Король обезьян‡Der Affenkönig‡원숭이 왕‡El Rey Mono‡‡Le roi-singe‡美猴王‡',
    nil,
    'Ajude Anduin Wrynn a encontrar o Rei Macaco no vale dos Imperadores. Uma‡Помогите Андуину Ринну найти Короля обезьян в Долине императоров. это‡Helft Anduin Wrynn, den Affenkönig im Tal der Kaiser zu finden.‡황제의 골짜기에 있는 원숭이 왕을 찾을 수 있도록 안두인 린을 도와야 합니다. 레벨 15‡Ayuda a Anduin Wrynn a encontrar al Rey Mono en el Valle de los Emperadores.‡‡Aidez Anduin Wrynn à trouver le Roi-singe dans la Vallée des Empereurs.‡在皇帝谷帮助安度因·乌瑞恩找到美猴王。‡',
  }
},
[32324] = {
  {
    'Busque o sinal‡В поисках сигнала‡Sucht das Signal‡신호 탐색‡Busca la señal‡‡Chercher le signal‡寻找信息‡',
    nil,
    'Siga a pedra da alma até os portões do Templo Negro. Uma‡Следуйте за камнем души к вратам Черного храма. это‡Folgt dem Seelenstein zu den Toren des Schwarzen Tempels.‡영혼석을 따라 검은 사원의 입구로 가야 합니다. 레벨 35‡Sigue la piedra de alma hasta las puertas del Templo Oscuro.‡‡Suivez la Pierre d’âme jusqu’aux portes du Temple noir.‡跟随灵魂石的指引前往黑暗神殿。‡',
  }
},
[32325] = {
  {
    'Infiltrando-se no Templo Negro‡Проникновение в Черный храм‡Infiltration des Schwarzen Tempels‡검은 사원 침투‡Infiltrarse en el Templo Oscuro‡‡Infiltrer le Temple noir‡潜入黑暗神殿‡',
    nil,
    'Procure a marca de Jubeka na entrada principal do Templo Negro. Uma vez lá dentro, fale com Jubeka no Ápice do Templo. Uma‡Найдите метку Джубеки у главного входа Черного храма. Оказавшись внутри, поговорите с Джубекой на Храмовой вершине.‡Sucht Jubekas Mal am Haupteingang des Schwarzen Tempels. Sprecht bei der Tempelspitze mit Jubeka, nachdem Ihr eingetreten seid.‡검은 사원의 입구에서 주베카의 자취를 찾아 검은 사원으로 들어간 후, 사원 정상에 있는 주베카와 대화해야 합니다.‡Busca la marca de Jubeka en la entrada del Templo Oscuro. Una vez dentro, habla con Jubeka en la Cima del Templo.‡‡Cherchez la Marque de Jubeka à l’entrée principale du Temple noir. Une fois à l’intérieur, parlez à Jubeka au Sommet du temple. Donne  en récompense.‡在黑暗神殿的主入口处寻找裘碧卡的印记。进去之后，在神殿之巅与裘碧卡交谈。‡',
  }
},
[32326] = {
  {
    'Inserção‡Проникновение‡Eindringen‡투입!‡Inserción‡‡Infiltration‡潜伏‡',
    nil,
    'Use o Portal Fendessol no Ponto de Dominação para se teleportar até Darnassus. Uma‡Воспользуйтесь порталом Похитителей Солнца в Крепости Покорителей, чтобы добраться до Дарнаса.‡Benutzt das Sonnenhäscherportal in der Herrschaftsfeste, um einen Teleport nach Darnassus zu sichern.‡지배령 거점에 있는 선리버 차원문을 통해 다르나서스로 순간이동해야 합니다. 레벨 15‡Utiliza el portal de los Atracasol del Punto de Dominio para teletransportarte a Darnassus.‡‡Utilisez le Portail saccage-soleil à la Halte de la Domination pour vous faire téléporter jusqu’à Darnassus.‡使用统御岗哨的夺日者传送门潜入达纳苏斯。‡',
  }
},
[32327] = {
  {
    'A missão de Darnassus‡Миссия: Дарнас‡Mission in Darnassus‡다르나서스 침투 작전‡Misión: Darnassus‡‡Mission Darnassus‡达纳苏斯行动‡',
    nil,
    'Localize o Sino Divino.Você pode usar o Amuleto de Luaprata para ir até Fanlyr se houver problemas. Uma‡Найдите Божественный колокол.Если попадете в беду, воспользуйтесь амулетом Луносвета, чтобы вернуться к Фанлиру.‡Findet die Götterglocke.Ihr könnt mithilfe des Silbermondglücksbringers zu Fanlyr zurückkehren, wenn Ihr in Schwierigkeiten geratet.‡천상의 종을 찾으십시오.만약 위험하다면 실버문 부적을 사용하여 판릴에게 돌아오십시오. 레벨 15‡Encuentra la Campana Divina.Puedes utilizar el talismán de Lunargenta para volver con Fanlyr si te metes en líos.‡‡Retrouvez la Cloche divine.Vous pouvez utiliser le Charme de Lune-d’Argent pour retourner auprès de Fanlyr si vous rencontrez des problèmes.‡拿到圣钟。如果陷入困境，你可以使用银月护符返回法利尔身边。‡',
  }
},
[32328] = {
  {
    'Retorno vitorioso‡Возвращение с победой‡Siegreiche Rückkehr‡갔노라, 왔노라, 이겼노라.‡Un regreso victorioso‡‡Un retour victorieux‡凯旋而归‡',
    nil,
    'Relate o seu sucesso para Nazgrim no Ponto de Dominação, na Selva de Krasarang. Uma‡Доложите о своих успехах Назгриму в Крепости Покорителей в Красарангских джунглях.‡Erstattet Nazgrim bei der Herrschaftsfeste in der Krasarangwildnis Bericht von Eurem Erfolg.‡크라사랑 밀림의 지배령 거점에 있는 나즈그림에게 임무를 완수했음을 보고해야 합니다. 레벨 15‡Informa de tu éxito a Nazgrim en el Punto de Dominio, en la Espesura Krasarang.‡‡Faites part de votre succès à Nazgrim à la Halte de la Domination, dans les Étendues sauvages de Krasarang.‡前往卡桑琅丛林的统御岗哨，向纳兹戈林报告你的成功。‡',
  }
},
[32329] = {
  {
    'Obtenha resultados!‡Где результаты?‡Holt meine Ergebnisse!‡결과를 내놓아라!‡¡Quiero mis resultados!‡‡Je veux des résultats !‡我要成果！‡',
    nil,
    'Fale com Lor\'themar Theron em Luaprata. Uma‡Поговорите с Лор\'темаром Тероном в Луносвете. это‡Sprecht mit Lor\'themar Theron in Silbermond.‡실버문에 있는 로르테마르 테론과 대화해야 합니다. 레벨 15‡Habla con Lor\'themar Theron en la Ciudad de Lunargenta.‡‡Parlez à Lor’themar Theron à Lune-d’Argent.‡去银月城与洛瑟玛·塞隆谈一谈。‡',
  }
},
[32330] = {
  {
    'O que está na caixa?‡Что в коробке?‡Was ist in der Kiste?‡상자 안에 든 것은?‡¿Qué hay en la caja?‡‡Y a quoi dans la boîte ?‡里面有什么？‡',
    nil,
    'Ajude o experimento de Aethas e Rommath. Uma‡Помогите Этасу и Роммату провести эксперимент. это‡Helft Aethas und Rommath bei ihrem Experiment.‡에이타스와 롬매스의 실험을 도와야 합니다. 레벨 15‡Ayuda a Aethas y a Rommath con el experimento.‡‡Aidez Aethas et Rommath dans leurs expériences.‡帮助艾萨斯和罗曼斯做实验。‡',
  }
},
[32331] = {
  {
    'O Kirin Tor‡Кирин-Тор‡Die Kirin Tor‡키린 토‡El Kirin Tor‡‡Le Kirin Tor‡肯瑞托‡',
    nil,
    'Use o Portal até o Salão Púrpura no Ancoradouro do Leão e encontre-se com Anduin Wrynn. Uma‡Воспользуйтесь порталом из Львиного лагеря, ведущим в Аметистовую гостиную, и найдите принца Андуина.‡Tretet durch das Portal zum Purpursalon in der Löwenlandung und trefft Euch mit Anduin Wrynn.‡사자의 상륙지에서 화려한 응접실로 통하는 차원문을 통과해 안두인 린을 만나야 합니다. 레벨 15‡Utiliza el portal al Salón Púrpura del Desembarco del León y reúnete con Anduin Wrynn.‡‡Utilisez le Portail pour le Salon Violet au Territoire du Lion et parlez avec Anduin Wrynn.‡使用雄狮港通往紫色天台的传送门，与安度因王子见面。‡',
  }
},
[32332] = {
  {
    'A primeira charada: misericórdia‡Первая загадка: милосердие‡Das erste Rätsel: Gnade‡첫 번째 수수께끼: 자비‡El primer acertijo: compasión‡‡La première énigme : la pitié‡谜题一：仁慈‡',
    nil,
    'Encontre o objeto que o Rei Macaco descreveu nessa charada. Uma‡Найдите предмет, который загадал Король обезьян. это‡Sucht den Gegenstand, den der Affenkönig in seinem Rätsel beschrieben hat.‡원숭이 왕이 수수께끼에서 말한 물건을 가져와야 합니다. 레벨 15‡Encuentra el objeto descrito por el Rey Mono en su acertijo.‡‡Trouvez l’objet que le Roi-singe a décrit dans son énigme.‡找到美猴王的谜题所描述的东西。‡',
  }
},
[32333] = {
  {
    'A segunda charada: amizade‡Вторая загадка: дружба‡Das zweite Rätsel: Gefährten‡두 번째 수수께끼: 동지애‡El segundo acertijo: avenencia‡‡La deuxième énigme : la camaraderie‡谜题二：友谊‡',
    nil,
    'Obtenha a Cerveja do Metal. Uma‡Найдите металлический отвар. это‡Besorgt Metallbräu.‡강철의 양조주를 획득해야 합니다. 레벨 15‡Consigue brebaje del metal.‡‡Obtenez de la Bière métallique.‡获得金铁酒。‡',
  }
},
[32334] = {
  {
    'A terceira charada: força‡Третья загадка: сила‡Das dritte Rätsel: Stärke‡세 번재 수수께끼: 힘‡El tercer acertijo: fuerza‡‡La troisième énigme : la force‡谜题三：力量‡',
    nil,
    'Derrote o Desafiante no Templo do Tigre. Uma‡Победите соперника в Храме Белого Тигра. это‡Besiegt den Herausforderer am Tigertempel.‡백호사에서 도전자를 상대로 승리해야 합니다. 레벨 15‡Derrota al contendiente en el Templo del Tigre.‡‡Affrontez le compétiteur au Temple du Tigre.‡击败白虎寺的挑战者。‡',
  }
},
[32335] = {
  {
    'A maior pegadinha‡Величайшая проделка‡Der beste Streich‡이건 좀 심하잖아‡La broma más dingue‡‡Le tour le plus drôle‡最大的恶作剧‡',
    nil,
    'Escute a história do Rei Macaco. Uma‡Выслушайте историю Короля обезьян. это‡Hört Euch die Geschichte des Affenkönigs an.‡원숭이 왕의 이야기를 들어야 합니다. 레벨 15‡Escucha la historia del Rey Mono.‡‡Écoutez l’histoire du Roi-singe.‡倾听美猴王的故事。‡',
  }
},
[32336] = {
  {
    'O cabo‡Рукоятка‡Der Griff‡망치 손잡이‡El mango‡‡Le manche‡杵柄‡',
    nil,
    'Recupere o Cabo da Marreta. Uma‡Найдите рукоятку молота. это‡Besorgt den Schlaghammergriff.‡망치 손잡이를 되찾아야 합니다. 레벨 15‡Recupera el mango de marra.‡‡Récupérez le Manche de maillet.‡夺回杵柄。‡',
  }
},
[32337] = {
  {
    'A cabeça‡Боек молота‡Der Kopf‡망치 머리‡La cabeza‡‡La tête‡杵头‡',
    nil,
    'Recupere a Cabeça da Marreta. Uma‡Найдите боек молота. это‡Besorgt den Schlaghammerkopf.‡망치 머리를 되찾아야 합니다. 레벨 15‡Recupera la cabeza de marra.‡‡Récupérez la Tête de maillet.‡夺回杵头。‡',
  }
},
[32338] = {
  {
    'O unguento harmônico‡Гармоничная мазь‡Die harmonische Salbe‡조화의 연고‡El ungüento armónico‡‡La pommade harmonique‡祥和药膏‡',
    nil,
    'Recupere o Unguento Harmônico. Uma‡Найдите гармоничную мазь. это‡Besorgt die harmonische Salbe.‡조화의 연고를 되찾아야 합니다. 레벨 15‡Consigue el ungüento armónico.‡‡Récupérez la Pommade harmonique.‡夺回祥和药膏。‡',
  }
},
[32339] = {
  {
    'Reconstruindo a Marreta (Rastreador)‡Воссоздание молота‡Die Wiederherstellung des Hammers‡신성한 망치‡Reconstruyendo la marra‡‡Reconstruction du maillet (suivi)‡重铸钟杵‡',
    nil,
    'Obtenha a Marreta Harmônica. Uma‡Получите Молот гармонии. это‡Besorgt den Schlaghammer der Harmonie.‡조화의 망치를 획득해야 합니다. 레벨 1‡Consigue la marra armónica.‡‡Récupérez le Maillet harmonique.‡获得神圣之杵。‡',
  }
},
[32340] = {
  {
    'Saqueando o Templo Negro‡Разграбление Черного храма‡Plünderung des Schwarzen Tempels‡검은 사원 약탈‡Saquea el Templo Oscuro‡‡Piller le Temple noir‡劫掠黑暗神殿‡',
    nil,
    'Saqueie tudo que puder e chegue ao final do Covil dos Prazeres Mortais. Uma‡Соберите все, до чего дотянутся руки, и доберитесь до конца Приюта Земных Наслаждений.‡Plündert so viel Ihr nur könnt und gelangt zum Ende des Hofes der Irdischen Gelüste.‡손에 넣을 수 있는 것은 모두 차지하고 향락의 소굴 끝으로 가십시오. 레벨 35‡Saquea todo lo que puedas y llega al final de la Guarida de los Placeres Mortales.‡‡Ramassez autant de butin que possible et parcourez toute la Tanière des Délices mortelles.‡在到达欢愉之园的尽头之前尽量多拾取一些遗物。‡',
  }
},
[32341] = {
  {
    'Mostre seu poder‡Демонстрация силы‡Stellt Euer Können unter Beweis‡힘의 시연‡Demuestra tu poder‡‡Démontrer votre puissance‡‡',
    nil,
    'Mate os demônios que estão atacando os homens de Akama nos Salões da Angústia. Uma‡Убейте демонов, напавших на отряд Акамы в Залах Страданий. это‡Vernichtet die Dämonen, die Akamas Männer in den Hallen der Pein angreifen.‡고뇌의 전당에서 아카마의 부하들을 공격하는 악마를 처치해야 합니다. 레벨 35‡Mata a los demonios que están atacando a los hombres de Akama en las Salas de Angustia.‡‡Tuez les démons qui attaquent les hommes d’Akama dans les Salles de l’Angoisse.‡‡',
  }
},
[32342] = {
  {
    'A armadilha espiritual‡Ловушка для духов‡Die Geisterfalle‡영혼 덫‡La trampa para espíritus‡‡Le piège à esprit‡灵魂陷阱‡',
    nil,
    'Colete 3 Armadilhas Espirituais. Uma‡Соберите 3 ловушки для духов. это‡Sammelt 3 Geisterfallen.‡영혼 덫 3개를 수집해야 합니다. 레벨 15‡Recoge 3 trampas para espíritus.‡‡Récupérez 3 Pièges à esprit.‡收集3个灵魂陷阱。‡',
  }
},
[32343] = {
  {
    'Tenentes de Ogudei‡Защитники Огудея‡Ogudeis Leutnants‡오구데이의 부관들‡Los tenientes de Ogudei‡‡Les lieutenants d’Ogudei‡敖骨打的副官‡',
    nil,
    'Colete Essência de Meng-do e Essência de Gen-li nas Ruínas de Ogudei. Uma‡Соберите эссенцию Мэн-до и эссенцию Гэнь-ли на Руинах Огудея. это‡Sammelt Meng-dos Essenz und Gen-lis Essenz in den Ruinen von Ogudei.‡오구데이 폐허에서 멩도의 정수와 겐리의 정수를 모아야 합니다. 레벨 15‡Recoge la esencia de Meng-do y Gen-li en las Ruinas de Ogudei.‡‡Récupérez l’Essence de Meng Do et l’Essence de Gen Li dans les Ruines d’Ogudei.‡去敖骨打废墟收集孟都的精华和庚离的精华。‡',
  }
},
[32344] = {
  {
    'É um mistério‡Это загадка‡Mysteriös‡기이한 일‡Es un misterio‡‡C’est un mystère‡这是个谜‡',
    nil,
    'Use a Bugiganga Arcana para achar uma anomalia dentro das Ruínas de Ogudei. Uma‡Используйте чародейский кристалл, чтобы найти аномалию на Руинах Огудея. задание.‡Setzt das arkane Schmuckstück ein, um eine Anomalie in den Ruinen von Ogudei zu orten.‡비전 마법 구슬을 이용해 오구데이 폐허 안에 있는 이상 물체를 찾아내야 합니다. 레벨 15‡Utiliza el adorno Arcano para encontrar una anomalía en las Ruinas de Ogudei.‡‡Utilisez le Colifichet arcanique pour trouver l’Anomalie dans les Ruines d’Ogudei.‡使用奥术球体在敖骨打废墟中找出一个异形体。‡',
  }
},
[32345] = {
  {
    'Não somos monstros!‡Мы не чудовища!‡Wir sind keine Monster!‡우리는 악한이 아니야!‡¡No somos monstruos!‡‡On est pas des monstres !‡我们不是怪物！‡',
    nil,
    'Liberte 14 Espíritos de Escravo Atormentado. Uma‡Освободите 14 беспокойных духов рабов. это‡Befreit 14 aufgewühlte Sklavengeister.‡괴로워하는 노예 영혼 14명을 풀어줘야 합니다. 레벨 15‡Libera a 14 espíritus esclavos atribulados.‡‡Libérez 14 Esprits asservis troublés.‡解放14个不安的灵奴。‡',
  }
},
[32346] = {
  {
    'Eu não tenho medo de fantasma!‡Я не боюсь призраков!‡Ich hab\' keine Angst vor Gespenstern!‡유령 따윈 무섭지 않아!‡¡No me asuh\'tan los fantasmas!‡‡J’ai peur d’aucun fantôme !‡灾祸猛于鬼！‡',
    nil,
    'Mate 12 Mogus Almatadas. Uma‡Убейте 12 подвластных духам могу. это‡Tötet 12 geistgebundene Mogu.‡영혼결속 모구 12마리를 처치해야 합니다. 레벨 15‡Mata a 12 mogu vinculados al espíritu.‡‡Tuez 12 Mogu liés par les esprits.‡击败12个缚魂魔古。‡',
  }
},
[32347] = {
  {
    'Ordem de despejo‡Уведомление о выселении‡Räumungsklage‡퇴거 요구‡Orden de desahucio‡‡Avis d’expulsion‡驱逐令‡',
    nil,
    'Mate 10 membros do Relicário nas Ruínas de Ogudei. Uma‡Убейте 10 членов Реликвария на Руинах Огудея. это‡Tötet 10 beliebige Anhänger der Archäologischen Akademie in den Ruinen von Ogudei.‡오구데이 폐허에 있는 성물회 10명을 처치해야 합니다. 레벨 15‡Mata a 10 miembros cualesquiera de El Relicario en las Ruinas de Ogudei.‡‡Tuez 10 membres du Reliquaire dans les Ruines d’Ogudei.‡在敖骨打废墟击败10名神圣遗物学会成员。‡',
  }
},
[32348] = {
  {
    'Chutando cachorro morto‡Нападем, пока враг слаб!‡Tretet sie, wenn sie am Boden liegen‡허를 찌르는 공격‡Golpéalos mientras puedas‡‡Frappez-les tant qu’ils sont à terre‡踢飞他们‡',
    nil,
    'Mate 12 unidades militares do Ancoradouro do Leão. Uma‡Убейте 12 воинов Львиного лагеря. это‡Tötet 12 Militäreinheiten der Löwenlandung.‡사자의 상륙지 병사 12명을 처치해야 합니다. 레벨 15‡Mata a 12 unidades militares del Desembarco del León.‡‡Tuez 12 Unités militaires du territoire du Lion.‡击败12个雄狮港的军事单位。‡',
  }
},
[32351] = {
  {
    'Ecos do trovão‡Эхо грома‡Echo des Donners‡천둥의 메아리‡El eco del trueno‡‡L’écho du tonnerre‡雷霆的回响‡',
    nil,
    'Encontre o Grande Chefe Baine Casco Sangrento no Santuário das Duas Luas. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите Бейна Кровавое Копыто в святилище Двух Лун. Поговорите с Так-Таком в крепости Покорителей, чтобы добраться туда.‡Findet Oberhäuptling Baine Bluthuf beim Schrein der Zwei Monde. Sprecht mit Tak-Tak bei der Herrschaftsfeste bezüglich einer Transportmöglichkeit.‡두 달의 제단에 있는 대부족장 바인 블러드후프를 찾아가야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra al gran jefe Baine Pezuña de Sangre en el Santuario de las Dos Lunas. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte.‡‡Trouvez le Grand chef Baine Sabot-de-Sang au Sanctuaire des Deux-Lunes. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去双月殿找大酋长贝恩·血蹄。可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32352] = {
  {
    'Tempestade iminente‡Надвигается буря‡Ein Sturm zieht auf‡폭풍우의 전조‡Se avecina tormenta‡‡La tempête gronde‡山雨欲来‡',
    nil,
    'Enfrente 6 Brutos Tocados pelo Sha. Uma‡Бросьте вызов 6 пораженным ша рубакам. это‡Nehmt es mit 6 Sha-berührten Grunzern auf.‡샤에 물든 그런트 6명을 구출해야 합니다. 레벨 15‡Enfréntate a 6 brutos influenciados por el sha.‡‡Affrontez 6 Grunts touchés par les sha.‡对抗6名染煞蛮兵。‡',
  }
},
[32355] = {
  {
    'A marreta harmônica‡Молот гармонии‡Der Schlaghammer der Harmonie‡조화의 망치‡La marra armónica‡‡Le Maillet harmonique‡祥和钟杵‡',
    nil,
    'Encontre Anduin na Tumba dos Conquistadores. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Найдите Андуина в Гробнице Завоевателей. Поговорите с Фенни Хорнсвоггл в Львином лагере, чтобы она доставила вас на место.‡Findet Anduin Wrynn am Grab der Eroberer. Sprecht mit Fennie Hornsturz in der Löwenlandung für eine Transportmöglichkeit.‡정복자의 무덤에 있는 안두인을 찾아야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Encuentra a Anduin en la Tumba de los Conquistadores. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Trouvez Anduin à la Tombe des Conquérants. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport.‡去征服者陵墓找安度因。与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32356] = {
  {
    'Rastreamento de Evento: Embaixadores Evocados‡Выслеживание: сбор посланников‡Verfolgungsereignis: Berufung der Botschafter‡이벤트 추적: 대사 소환‡Tracking Event: Ambassadors Summoned‡‡Évènement de suivi : Invocation des ambassadeurs‡追踪事件：召唤大使‡',
    nil,
    'Acompanhe os batedores até a saída. Depois, fale com o Grande Lu.‡Проводите разведчиков, затем поговорите с Большим Лу.‡Schickt die Späher los und sprecht dann mit dem Ältesten Lusshan.‡정찰병이 떠나는 모습을 지켜보고, 덩치 큰 루와 대화해야 합니다.‡Despídete de los exploradores y después habla con Gran Lu. Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Veillez au départ des éclaireurs, puis parlez à Gros Lu.‡目送斥候离开，然后与卢山大哥谈一谈。‡',
  }
},
[32357] = {
  {
    'Tracking Event: Evento Completo‡Выслеживание: завершение события‡Verfolgungsereignis: Ereignis abgeschlossen‡이벤트 추적: 이벤트 완료‡Tracking Event: Event Complete‡‡Évènement de suivi : Évènement terminé‡追踪事件：事件完成‡',
    nil,
    'Acompanhe os batedores até a saída. Depois, fale com o Grande Lu.‡Проводите разведчиков, затем поговорите с Большим Лу.‡Schickt die Späher los und sprecht dann mit dem Ältesten Lusshan.‡정찰병이 떠나는 모습을 지켜보고, 덩치 큰 루와 대화해야 합니다.‡Despídete de los exploradores y después habla con Gran Lu. Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Veillez au départ des éclaireurs, puis parlez à Gros Lu.‡目送斥候离开，然后与卢山大哥谈一谈。‡',
  }
},
[32358] = {
  {
    'O Âmago das Almas‡Сущность души‡Der Seelenkern‡영혼핵‡El núcleo de alma‡‡Le noyau d’âme‡灵魂之核‡',
    nil,
    'Uma‡это‡‡레벨 35‡‡‡‡‡',
  }
},
[32359] = {
  {
    'O olho dos naarus‡Глаз наару‡Das Auge der Naaru‡‡El ojo de los naaru‡‡L’œil des Naaru‡‡',
    nil,
    'Traga o Olho da Tormenta para Wrathion, na Taberna nas Nuvens. Uma‡Принесите Око Бури Гневиону в таверну "В туманах". это‡Bringt das Auge des Sturms zu Furorion in der Taverne im Nebel.‡‡Lleva el Ojo de la Tormenta a Wrathion, en la Taberna en la Niebla.‡‡Apportez l’Œil du cylone à Irion, à la Taverne dans les brumes.‡‡',
  }
},
[32360] = {
  {
    'Esperando a Colheita Negra‡В ожидании Мрачной Жатвы‡Warten auf die Schwarze Ernte‡암흑의 수확을 기다리며‡Esperando la Cosecha Oscura‡‡Dans l’attente de la Sombre récolte‡黑暗将临‡',
    nil,
    'Espere Wrathion entrar em contato com você.‡Дождитесь, когда с вами свяжется Гневион.‡Wartet, bis Furorion mit Euch Kontakt aufnimmt.‡래시온의 연락을 기다려야 합니다.‡Espera que Wrathion se ponga en contacto contigo.‡‡Attendez qu’Irion vous contacte.‡等待拉希奥联络你。‡',
  }
},
[32361] = {
  {
    'Tracking Event: Evento Completo‡Выслеживание: завершение события‡Verfolgungsereignis: Ereignis abgeschlossen‡이벤트 추적: 이벤트 완료‡Evento de seguimiento: evento completo‡‡Évènement de suivi : Évènement terminé‡追踪事件：事件完成‡',
    nil,
    'Acompanhe os batedores até a saída. Depois, fale com o Grande Lu.‡Проводите разведчиков, затем поговорите с Большим Лу.‡Schickt die Späher los und sprecht dann mit dem Ältesten Lusshan.‡정찰병이 떠나는 모습을 지켜보고, 덩치 큰 루와 대화해야 합니다.‡Despídete de los exploradores y después habla con Gran Lu. Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Veillez au départ des éclaireurs, puis parlez à Gros Lu.‡目送斥候离开，然后与卢山大哥谈一谈。‡',
  }
},
[32362] = {
  {
    'O destino de Dalaran‡Судьба Даларана‡Dalarans Schicksal‡달라란의 운명‡El destino de Dalaran‡‡Le destin de Dalaran‡达拉然的命运‡',
    nil,
    'Fale com Jaina Proudmore e ouça sua história. Uma‡Поговорите с Джайной Праудмур и выслушайте ее рассказ. это‡Sprecht mit Jaina Prachtmeer und hört Euch ihre Geschichte an.‡제이나 프라우드무어와 대화하고, 그녀의 이야기를 들어야 합니다. 레벨 15‡Habla con Jaina Valiente y escucha su historia.‡‡Parlez à Jaina Portvaillant et écoutez son histoire.‡与吉安娜·普罗德摩尔交谈并倾听她的故事。‡',
  }
},
[32363] = {
  {
    'A expedição Kun-Lai‡Экспедиция к Кунь-Лай‡Die Kun-Lai-Expedition‡쿤라이 원정대‡La expedición de Kun-Lai‡‡L’expédition de Kun-Lai‡昆莱探险队‡',
    nil,
    'Encontre Baine Casco Sangrento no Avanço Garrosh\'ar. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите Бейна Кровавое Копыто на передовой Гаррош\'ар. Поговорите с Так-Таком в крепости Покорителей, чтобы добраться туда.‡Findet Baine Bluthuf beim Garrosh\'arvorstoß. Sprecht mit Tak-Tak bei der Herrschaftsfeste bezüglich einer Transportmöglichkeit.‡가로쉬아르 진군지에서 바인 블러드후프를 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra a Baine Pezuña de Sangre en el Avance Garrosh\'ar. Habla con Tak-Tak en el Punto de Dominio para que te ofrezca transporte.‡‡Trouvez Baine Sabot-de-Sang à l’Avant-poste Garrosh’ar. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去加尔鲁什尔先锋营找大酋长贝恩·血蹄。可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32364] = {
  {
    'Remédio pandarênico‡Лекарство пандаренов‡Pandarische Medizin‡판다렌식 처방‡Medicina pandaren‡‡Médecine pandarène‡‡',
    nil,
    'Encontre a receita do Vinho da Memória. Uma‡Найдите рецепт напитка Памяти. это‡Findet das Rezept für den Wein der Erinnerungen.‡기억주 제조법을 찾아야 합니다. 레벨 15‡Busca la receta del vino evocador.‡‡Trouvez la recette du Vin de souvenance.‡‡',
  }
},
[32365] = {
  {
    'Rastreamento do Evento: Epílogo Completado‡Tracking Event: Epilogue Complete‡Tracking Event: Epilogue Complete‡이벤트 추적: 에필로그 완료‡Tracking Event: Epilogue Complete‡‡Suivi d’évènement : épilogue terminé‡Tracking Event: Epilogue Complete‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[32366] = {
  {
    'Um tico de fogo‡Капельку огня‡Ein Schlückchen Feuer‡‡Un chorrito de fuego‡‡Une pointe de feu‡‡',
    nil,
    'Colete 6 garrafas de Vinho Ardente Runqin. Uma‡Соберите 6 порций огненного вина Жу-Цзинь. это‡Sammelt 6 Feuerwein von Ruqin.‡‡Reúne 6 ojenes Ruqin.‡‡Récupérez 6 Vins de feu ruqins.‡‡',
  }
},
[32367] = {
  {
    'Um naco de iaque‡Немного яка‡Ein bisschen Yakmilch‡‡Un toque de yak‡‡Une goutte de yack‡‡',
    nil,
    'Colete 3 garrafas de Leite Fresco de Iaque. Uma‡Соберите 3 порции свежего молока яка. это‡Sammelt 3 Portionen frische Yakmilch.‡‡Reúne 3 raciones de leche fresca de yak.‡‡Récupérez 3 Laits crus de yack.‡‡',
  }
},
[32368] = {
  {
    'Vinho da Memória‡Напиток Памяти‡Wein der Erinnerungen‡기억주‡El vino evocador‡‡Le vin de souvenance‡溯源酒‡',
    nil,
    'Beba o Vinho da Memória e testemunhe o Passado de Shan Kien. Uma‡Выпейте напиток Памяти и узнайте о прошлом Шена Киена. это‡Trinkt den Wein der Erinnerungen und werdet Zeuge von Shan Kiens Vergangenheit.‡기억주를 마시고 샨 키엔의 과거를 목격해야 합니다. 레벨 15‡Bébete el vino evocador y presencia el pasado de Shan Kien.‡‡Buvez le Vin de souvenance et soyez le témoin du passé de Shan Kien.‡喝下溯源酒，查看单简的过去。‡',
  }
},
[32369] = {
  {
    'Segredos do passado‡Тайны прошлого‡Geheimnisse der Vergangenheit‡과거의 비밀‡Secretos del pasado‡‡Les secrets du passé‡‡',
    nil,
    'Uma‡это‡‡레벨 1‡‡‡‡‡',
  }
},
[32370] = {
  {
    'A expedição Kun-Lai‡Экспедиция к Кунь-Лай‡Die Kun-Lai-Expedition‡쿤라이 원정대‡La expedición de Kun-Lai‡‡L’expédition de Kun-Lai‡昆莱探险队‡',
    nil,
    'Encontre Connelly no Bazar dos Grômulos. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Найдите агента Коннели на Базаре груммелей. Поговорите с Фенни Хорнсвоггл в Львином лагере, чтобы добраться туда.‡Findet Agent Connelly auf dem Grummelbasar. Sprecht mit Fennie Hornsturz in der Löwenlandung bezüglich einer Transportmöglichkeit.‡그루멀 시장에 있는 코넬리를 찾아야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Encuentra a Connelly en el Bazar Grúmel. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Trouvez Connelly au Bazar des grumelots. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport.‡去土地精集市找康奈利。你可以与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32371] = {
  {
    'Vinho da Memória‡Напиток Памяти‡Wein der Erinnerungen‡기억주‡El vino evocador‡‡Le vin de souvenance‡溯源酒‡',
    nil,
    'Use o Disfarce Kor\'kron para entrar no acampamento. Depois, beba o Vinho da Memória e testemunhe o passado de Shan Kien. Uma‡Воспользуйтесь кор\'кронской маскировкой, чтобы проникнуть в лагерь. Затем выпейте напиток Памяти и узнайте прошлое Шена Киена.‡Nutzt die Kor\'kron-Verkleidung, um das Lager zu betreten. Trinkt dann den Wein der Erinnerungen und werdet Zeuge von Shan Tiens Vergangenheit.‡코르크론 위장복을 사용해 야영지에 잠입한 후, 기억주를 마시고 샨 키엔의 과거를 목격해야 합니다. 레벨 15‡Utiliza el disfraz Kor\'kron para entrar en el campamento. Después, bébete el vino evocador y presencia el pasado de Shan Kien.‡‡Utilisez le Déguisement de Kor’kron pour pénétrer dans le camp. Puis buvez le Vin de souvenance et soyez le témoin du passé de Shan Kien.‡使用库卡隆伪装进入营地。然后喝下溯源酒，查看单简的过去。‡',
  }
},
[32372] = {
  {
    'Dessubjugar‡Освобождение‡Un-Unterwerfung‡정복자를 정복하기 위해‡Des-subyugación‡‡Dé-subjugation‡反制‡',
    nil,
    'Derrote 10 Feitores Kor\'kron, 5 Subjugantes Kor\'kron, e Gul’tar, o Subjugante. Uma‡Убейте 10 кор\'кронских надзирателей, 5 кор\'кронских поработителей и Гул\'тара Поработителя.‡Tötet 10 Aufseher der Kor\'kron, 5 Unterwerfer der Kor\'kron und Gul\'tar den Unterwerfer.‡코르크론 감시자 10명, 코르크론 정복자 5명, 그리고 정복자 굴타르를 처치해야 합니다. 레벨 15‡Derrota a 10 sobrestantes Kor\'kron, 5 subyugadores Kor\'kron y a Gul\'tar el Subyugador.‡‡Battez 10 Surveillants kor’krons, 5 Subjugateurs kor’krons et Gul’tar le Subjugateur.‡击败10名库卡隆监督者、5名库卡隆征服者和征服者古尔塔。‡',
  }
},
[32373] = {
  {
    'A medida de um líder‡Мерило для предводителя‡Was den Anführer ausmacht‡지도자의 역량‡La medida de un líder‡‡Les qualités d’un chef‡领袖的标准‡',
    nil,
    'Fale com Wrathion na Taberna nas Nuvens. Uma‡Поговорите с Гневионом в таверне "В туманах". это‡Sprecht mit Furorion in der Taverne im Nebel.‡안개 속의 주점에서 래시온과 대화해야 합니다. 레벨 35‡Habla con Wrathion en la Taberna en la Niebla.‡‡Parlez à Irion à la Taverne dans les Brumes.‡去迷雾酒肆与拉希奥谈一谈。‡',
  }
},
[32375] = {
  {
    'Um pouco disso‡Щепотку этого‡Und ein wenig davon‡저것 조금‡Un poco de aquello‡‡Une touche de cela‡‡',
    nil,
    'Colete 100 Cogumelos Gumbigo. Uma‡Соберите 100 пуговичных грибов. это‡Sammelt 100 Braunkappenpilze.‡꼽배 버섯 100개를 모아야 합니다. 레벨 15‡Reúne 100 champiñones botón.‡‡Récupérez 100 Champignombrils.‡‡',
  }
},
[32376] = {
  {
    'Para o Vale!‡В долину!‡Auf ins Tal!‡골짜기로!‡¡Al valle!‡‡Dans la vallée !‡前往皇帝谷！‡',
    nil,
    'Encontre seu "Amigo de Luaprata" no Vale dos Imperadores. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Встретьтесь с вашим "другом из Луносвета" в Долине императоров. Поговорите с Так-Таком в крепости Покорителей, чтобы добраться туда.‡Findet Euren "Freund aus Silbermond" im Tal der Kaiser. Sprecht mit Tak-Tak bei der Herrschaftsfeste bezüglich einer Transportmöglichkeit.‡황제의 골짜기에서 "실버문에서 온 친구"를 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra a tu "amigo de Lunargenta" en el Valle de los Emperadores. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte. Un(a) misión.‡‡Retrouvez votre « Ami de Lune-d’Argent » à la Vallée des Empereurs. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去皇帝谷找“来自银月城的朋友”。你可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32377] = {
  {
    'Um Kor\'kron entre nós‡Орки в наших рядах‡Ein Kor\'kron in unserer Mitte‡우리 중의 코르크론‡Un Kor\'kron entre nosotros‡‡Un kor’kron parmi nous‡混入库卡隆‡',
    nil,
    'Colete 1 Capacete Kor\'kron, 1 Armadura Kor\'kron e 1 Bota Kor\'kron, e então combine-as em um Disfarce Kor\'kron. Uma‡Найдите кор\'кронский шлем, кор\'кронские доспехи и кор\'кронские сапоги и сделайте из них кор\'кронскую маскировку.‡Erlangt einen Helm der Kor\'kron, eine Rüstung der Kor\'kron und ein Paar Stiefel der Kor\'kron und stellt dann aus ihnen eine Kor\'kron-Verkleidung her.‡코르크론 보호모 1개, 코르크론 갑옷 1개, 코르크론 장화 1개를 모은 다음 결합해 코르크론 위장복을 만들어야 합니다.‡Reúne un yelmo Kor\'kron, una armadura Kor\'kron y unas botas Kor\'kron, y combínalas para formar un disfraz Kor\'kron.‡‡Récupérez 1 Casque kor’kron, 1 Armure kor’kronne et 1 paire de Bottes kor’kronnes, puis combinez-les pour former un Déguisement de Kor’kron.‡收集1个库卡隆头盔、1件库卡隆护甲和1双库卡隆长靴，然后用它们合成库卡隆伪装。‡',
  }
},
[32378] = {
  {
    'Abrindo caminho‡Расчистить путь‡Den Weg bereiten‡길 내기‡Despejar el camino‡‡Dégager le chemin‡扫清道路‡',
    nil,
    'Mate 10 Mogus Korune. Uma‡Убейте 10 могу клана Корун. это‡Tötet 10 Korunmogu.‡코룬 모구 10마리를 처치해야 합니다. 레벨 15‡Mata a 10 mogu Korune.‡‡Tuez 10 Mogu korunes.‡击败10个寇茹魔古。‡',
  }
},
[32379] = {
  {
    'Legado dos Korune‡Наследие клана Корун‡Das Erbe der Korun‡코룬의 유산‡Legado de los Korune‡‡L’héritage des Korunes‡寇茹的遗产‡',
    nil,
    'Encontre o documento Legado dos Korune no Vale dos Imperadores e colete o Artefato Selado Korune e as Ordens Korune dos Mogus Korune. Uma‡Найдите документ "Наследие клана Корун" в Долине Императоров, а также "Приказы клана Корун" и запечатанный артефакт Корун у могу клана Корун.‡Findet das Dokument \'Das Vermächtnis der Korun\' im Tal der Kaiser und besorgt das versiegelte Artefakt der Korun und die Korunbefehle von den Mogu der Korun.‡황제의 골짜기에 있는 코룬의 유산을 찾고, 코룬 모구에게서 봉인된 코룬 유물과 코룬 명령서를 모아야 합니다.‡Encuentra el Legado de los Korune en el Valle de los Emperadores, y consigue el artefacto Korune sellado y las órdenes Korune de los mogu Korune.‡‡Trouvez l’Héritage des Korunes dans la Vallée des Empereurs, et récupérez l’Artéfact korune scellé et les Ordres des Korunes sur des Mogu korunes.‡在皇帝谷找到有关寇茹遗产的卷轴，并从寇茹魔古族身上收集封印的寇茹神器和寇茹指令。‡',
  }
},
[32380] = {
  {
    'O melhor da área‡Он лучший среди нас‡Der Beste hier‡최고의 요원‡El mejor‡‡Un maître du déguisement‡最佳人选‡',
    nil,
    'Apresente-se ao agente infiltrado Vilázio no Bar Brigalhada do Bizmo, no lado de Ventobravo do Metrô Correfundo. Uma‡Встретьтесь с агентом под прикрытием Таунсли в потасовочной "У Бизмо" в Подземном поезде в Штормграде.‡Meldet Euch bei Geheimagentin Townsley in Bizmos Boxbar auf der Sturmwindseite der Tiefenbahn.‡깊은굴 지하철의 스톰윈드 쪽 정류장에 있는 비즈모의 싸움굴로 가서 첩보원 타운슬리에게 보고해야 합니다.‡Informa a la agente infiltrada Townsley en el Club de Lucha de Bizmo, en el lado de Ventormenta del Tranvía Subterráneo.‡‡Présentez-vous à l’Agent sous couverture Townsley au Bar-Tabasse de Bizmo, dans la partie de Hurlevent située près du Tram des profondeurs.‡去暴风城的矿道地铁找比兹莫搏击俱乐部的卧底探员汤斯丽。‡',
  }
},
[32381] = {
  {
    'Pegando um espião‡Поймать шпиона‡Wie man einen Spion fängt‡첩보원을 잡으려면‡Cazar a un espía‡‡Comment démasquer un espion‡排查间谍‡',
    nil,
    'Entregue a Marmota Rosa, a Batida de Melão Mogu e a Adaga Enferrujada para o freguês correto. Uma‡Доставьте коктейли "Розовый суслик", "Дынный сюрприз могу" и "Ржавый кинжал" нужным посетителям.‡Bringt das rosarote Murmeltier, die Mogumelonenüberraschung und den rostigen Dolch zu den richtigen Gästen.‡분홍색 마모트, 반전 있는 모구 멜론주, 녹슨 단검을 정확한 수령인에게 전달해야 합니다. 레벨 15‡Entrega la marmota rosa, la mezcla de melón mogu y la daga oxidada al patrón correspondiente.‡‡Donnez la Marmotte rose, le Cocktail au melon mogu et la Dague rouillée au bon client.‡将粉色旱獭、魔古鲜榨甜瓜汁和锈色利刃送给正确的顾客。‡',
  }
},
[32382] = {
  {
    'Ele tá na fossa‡Он под прикрытием‡Perfekt getarnt‡적진 깊숙이‡Hasta el cuello‡‡Infiltration totale‡深入敌后‡',
    nil,
    'Encontre-se com Connelly no Monte Kun-Lai. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Встретьтесь с Коннелли на вершине Кунь-лай. Поговорите с Фенни Хорнсвоггл в Львином лагере, чтобы добраться туда.‡Trefft Connelly auf dem Kun-Lai-Gipfel. Sprecht mit Fennie Hornsturz in der Löwenlandung bezüglich einer Transportmöglichkeit.‡쿤라이 봉우리에 있는 코넬리와 만나야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Reúnete con Connelly en la Cima Kun-Lai. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Rencontrez Connelly au Sommet de Kun-Lai. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport.‡去昆莱山找康奈利。与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32383] = {
  {
    'Escuta essa‡Жучки повсюду‡Verwanzt‡네 귀에 도청장치‡Plantando micrófonos‡‡Qui va moucharder ?‡窃听风云‡',
    nil,
    'Plante as Escutas Disfarçadas na tenda grande, perto das tendas menores e nos suprimentos. Uma‡Поставьте тщательно замаскированные жучки в большом шатре, возле малых шатров и возле припасов.‡Verwanzt das große Zelt in der Nähe der kleinen Zelte sowie die Vorräte mit clever getarnten Wanzen.‡교묘하게 위장된 도청기를 큰 천막 안에, 작은 천막들 주위에, 그리고 보급품에 설치해야 합니다. 레벨 15‡Planta los micrófonos camuflados con ingenio en la tienda grande, cerca de las tiendas pequeñas y en los suministros.‡‡Placez les Mouchards savamment déguisés dans la Grande tente, près des Petites tentes et dans les Fournitures.‡将精心伪装的窃听器放在大帐篷里、小帐篷附近和补给中。‡',
  }
},
[32384] = {
  {
    'Prendendo o líder‡Захват предводителя‡Den Anführer gefangen nehmen‡지도자 포획‡Tendiendo una trampa al líder‡‡Piéger le chef‡擒贼擒王‡',
    nil,
    'Enfraqueça e capture Shan Kien na Tumba dos Conquistadores, que fica no Monte Kun-Lai. Uma‡Измотайте и возьмите в плен Шена Киена в Гробнице Теней на вершине Кунь-Лай. задание.‡Schwächt und ergreift Shan Kien am Grab der Schatten am Kun-Lai-Gipfel.‡쿤라이 봉우리에 있는 그림자의 무덤에서 샨 키엔을 약화시키고 사로잡아야 합니다. 레벨 15‡Debilita y captura a Shan Kien en la Tumba de las Sombras, en la Cima Kun-Lai.‡‡Affaiblissez puis capturez Shan Kien à la Tombe des Ombres, au Sommet de Kun-Lai.‡前往昆莱山的暗影古陵，削弱并俘获单简。‡',
  }
},
[32388] = {
  {
    'Mudança de comando‡Смена командования‡Führungswechsel‡지휘권 박탈‡Un cambio de mando‡‡Changement de commandement‡朝令夕改‡',
    nil,
    'Mate o Senhor da Guerra Punhossangue no Ponto de Dominação, que fica na Selva de Krasarang. Você precisará de um grupo. Uma‡Убейте полководца Кровавого Эфеса в Крепости Покорителей в Красарангских джунглях. Вам потребуется группа.‡Tötet Kriegsfürst Blutheft in der Herrschaftsfeste in der Krasarangwildnis. Ihr werdet eine Gruppe benötigen.‡크라사랑 밀림의 지배령 거점에 있는 장군 블러드힐트를 처치해야 합니다. 여럿이 함께 가야 할 것입니다.‡Mata al señor de la guerra Sangrastil en el Punto de Dominio, en la Espesura Krasarang. Te hará falta un grupo.‡‡Tuez le Seigneur de guerre Garde-Sanglante à la Halte de la Domination, dans les Étendues sauvages de Krasarang. Vous aurez besoin d’y aller en groupe.‡去卡桑琅丛林的统御岗哨击败血柄督军。建议你组队前往。‡',
  }
},
[32389] = {
  {
    'O leão ruge‡Львиный рык‡Der Löwe brüllt‡사자의 울부짖음‡El león ruge‡‡Le rugissement du lion‡雄狮怒吼‡',
    nil,
    'Vença batalhas no Templo de Kotmogu e nas Minas Estilhaço Prateado. Uma‡Выиграйте битвы за храм Котмогу и Сверкающие копи. это‡Gewinnt Kämpfe im Tempel von Katmogu und in der Silberbruchmine.‡코트모구의 사원과 은빛수정 광산 전장에서 승리해야 합니다. 레벨 35‡Gana batallas en el Templo de Kotmogu y las Minas Lonjaplata.‡‡Gagnez des batailles au Temple de Kotmogu et aux Mines d’Éclargent.‡赢得寇魔古寺和碎银矿脉的胜利。‡',
  }
},
[32390] = {
  {
    'O chamado do líder da matilha‡Зов предводителя‡Der Ruf des Rudelführers‡우두머리의 부름‡La llamada del maestro de la manada‡‡L’appel du chef de meute‡头狼的召唤‡',
    nil,
    'Fale com Wrathion. Uma‡Поговорите с Гневионом. это‡Sprecht mit Furorion.‡래시온과 대화해야 합니다. 레벨 35‡Habla con Wrathion.‡‡Parlez à Irion.‡与拉希奥谈一谈。‡',
  }
},
[32391] = {
  {
    'As ruínas de Korune‡Руины клана Корун‡Die Ruinen von Korun‡코룬의 폐허‡Las Ruinas de Korune‡‡Les ruines de Korune‡寇茹废墟‡',
    nil,
    'Encontre Ishi nas Ruínas de Korune. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите Иши на Руинах клана Корун. Поговорите с Так-Таком в Крепости Покорителей, чтобы добраться туда.‡Sprecht mit Ishi in den Ruinen von Korun am Kun-Lai-Gipfel. Sprecht mit Tak-Tak bei der Herrschaftsfeste für einen Transport dorthin.‡코룬의 페허에서 이시를 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 코룬의 폐허까지 갈 수 있습니다.‡Encuentra a Ishi en las Ruinas de Korune. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte.‡‡Trouvez Ishi aux Ruines de Korune. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去寇茹废墟找伊什。你可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32392] = {
  {
    'O Sino Divino‡Божественный колокол‡Die Götterglocke‡천상의 종‡La Campana Divina‡‡La Cloche divine‡圣钟‡',
    nil,
    'Mate Sarannha Glaive Celeste. Uma‡Убейте Саранью Небесную Глефу. это‡Tötet Sarannha Himmelsgleve.‡사란나 스카이글레이브를 처치해야 합니다. 레벨 15‡Mata a Sarannha Gujaceleste.‡‡Tuez Sarannha Glaive-Céleste.‡击败萨拉哈·天剑。‡',
  }
},
[32393] = {
  {
    'As ruínas de Korune‡Руины клана Корун‡Die Ruinen von Korun‡코룬의 폐허‡Las Ruinas de Korune‡‡Les ruines de Korune‡寇茹废墟‡',
    nil,
    'Encontre Sarannha Glaive Celeste nas Ruínas de Korune. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Найдите Саранью Небесную Глефу на Руинах клана Корун. Поговорите с Фенни Хорнсвоггл в Львином лагере, чтобы добраться туда.‡Sprecht mit Sarannha Himmelsgleve in den Ruinen von Korun am Kun-Lai-Gipfel. Sprecht mit Fennie Hornsturz in der Löwenlandung für einen Transport dorthin.‡코룬의 폐허에 있는 사란나 스카이글레이브를 찾아야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Encuentra a Sarannha Gujaceleste en las Ruinas de Korune. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Trouvez Sarannha Glaive-Céleste dans les Ruines de Korune. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport.‡去寇茹废墟找萨拉哈·天剑。你可以与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32394] = {
  {
    'O Sino Divino‡Божественный колокол‡Die Götterglocke‡천상의 종‡La Campana Divina‡‡La Cloche divine‡圣钟‡',
    nil,
    'Mate o Tecemedo Avartu e recupere o Sino Divino. Uma‡Убейте ткача ужаса Аварту и найдите Божественный колокол. это‡Tötet Schreckenswirker Avartu und bergt die Götterglocke.‡공포술사 아바르투를 처치하고 천상의 종을 회수해야 합니다. 레벨 15‡Mata al tejetinieblas Avartu y recupera la Campana Divina.‡‡Tuez le Tisseur d’effroi Avartu et récupérez la Cloche divine.‡击败织恐者阿瓦图并夺取圣钟。‡',
  }
},
[32395] = {
  {
    'Evento de Rastreamento: Viu Avartu‡Tracking Event: Saw Avartu‡Verfolgungsereignis: Avartu gesehen‡이벤트 추적: 아바르투 보기‡Tracking Event: Saw Avartu‡‡Suivi d’évènement : visite à Avartu‡追踪事件：见到阿瓦图‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[32396] = {
  {
    'Missão Vinculação Não completável‡Uncompletable Binding Quest‡Uncompletable Binding Quest‡완료할 수 없는 바인딩 퀘스트‡Uncompletable Binding Quest‡‡Uncompletable Binding Quest‡Uncompletable Binding Quest‡',
    nil,
    'Ilha Errante de‡‡‡유랑도‡‡‡‡‡',
  }
},
[32397] = {
  {
    'Ele nem vai dar pela falta‡Он даже не заметит‡Es wird ihm gar nicht auffallen‡슬쩍해도 모를거야‡Ni lo echará de menos‡‡Il ne lui manquera même pas‡他不会发现的‡',
    nil,
    'Crie uma distração no acampamento e roube o Diário Desgastado. Uma‡Создайте переполох в лагере и украдите потрепанный дневник. это‡Sorgt für eine Ablenkung im Lager und stehlt das verwitterte Tagebuch.‡야영지에서 소란을 유도한 후 낡은 일지를 훔쳐야 합니다. 레벨 15‡Crea una distracción en el campamento y roba el diario deteriorado.‡‡Créez un diversion dans le campement et volez le Journal abîmé.‡在营地制造混乱，趁机窃取褪色日志。‡',
  }
},
[32398] = {
  {
    'O Sino fala‡Глас колокола‡Die Glocke spricht‡종이 울리네‡La campana habla‡‡La cloche parle‡圣钟鸣响‡',
    nil,
    'Encontre Malkorok no Domínio do Imperador. Fale com Tak-Tak no Ponto de Dominação para obter transporte. Uma‡Найдите Малкорока в Крыле императора. Поговорите с Так-Таком в Крепости Покорителей, чтобы добраться туда.‡Findet Malkorok bei der Kaiserhöhe. Sprecht mit Tak-Tak bei der Herrschaftsfeste für eine Transportmöglichkeit.‡황제의 세력지에 있는 말코록을 찾아야 합니다. 지배령 거점에 있는 탁탁과 대화하면 이동할 수 있습니다.‡Encuentra a Malkorok en El Tramo del Emperador. Habla con Tak-Tak en el Punto de Dominio para conseguir un transporte.‡‡Trouvez Malkorok aux Confins de l’Empereur. Parlez à Tak-Tak à la Halte de la Domination pour obtenir un moyen de transport.‡去帝皇之域找马尔考罗克。你可以与统御岗哨的泰克泰克谈一谈，让他送你一程。‡',
  }
},
[32399] = {
  {
    'Sopro da sombra mais negra‡Дыхание непроглядной тьмы‡Atem der dunkelsten Schatten‡가장 어두운 그림자의 숨결‡El aliento de la sombra tenebrosa‡‡Le souffle de l’ombre la plus sombre‡深黯之息‡',
    nil,
    'Testemunhe o toque do Sino Divino. Uma‡Услышьте звон Божественного колокола. это‡Erlebt das Läuten der Götterglocke.‡천상의 종이 울리는 것을 목격해야 합니다. 레벨 15‡Presencia el repique de la Campana Divina.‡‡Regardez sonner la Cloche divine.‡见证圣钟的鸣响。‡',
  }
},
[32400] = {
  {
    'O Sino fala‡Глас колокола‡Die Glocke spricht‡종이 울리네‡La campana habla‡‡La cloche parle‡圣钟鸣响‡',
    nil,
    'Encontre Anduin no Domínio do Imperador. Fale com Fenny Traquitana no Ancoradouro do Leão para obter transporte. Uma‡Найдите Андуина в Крыле императора. Поговорите с Фенни Хорнсвоггл в Львином лагере, чтобы добраться туда.‡Findet Anduin bei der Kaiserhöhe. Sprecht mit Fennie Hornsturz in der Löwenlandung für eine Transportmöglichkeit.‡황제의 세력지에 있는 안두인과 만나야 합니다. 사자의 상륙지에 있는 페니 혼스웨글과 대화하면 이동할 수 있습니다.‡Encuentra a Anduin en El Tramo del Emperador. Habla con Fennie Brindacuerno en el Desembarco del León para conseguir un transporte.‡‡Trouvez Anduin aux Confins de l’Empereur. Parlez à Fennie Cornegidouille au Territoire du Lion pour obtenir un moyen de transport.‡去帝皇之域找安度因。与雄狮港的范妮·盘角谈一谈，让她送你一程。‡',
  }
},
[32401] = {
  {
    'Sopro da sombra mais negra‡Дыхание непроглядной тьмы‡Atem der dunkelsten Schatten‡가장 어두운 그림자의 숨결‡El aliento de la sombra tenebrosa‡‡Le souffle de l’ombre la plus sombre‡深黯之息‡',
    nil,
    'Derrote Ishi e destrua o Sino Divino. Uma‡Убейте Иши и уничтожьте Божественный колокол. это‡Besiegt Ishi und zerstört die Götterglocke.‡이시를 처치하고 천상의 종을 파괴해야 합니다. 레벨 15‡Derrota a Ishi y destruye la Campana Divina.‡‡Battez Ishi et détruisez la Cloche divine.‡击败伊什并摧毁圣钟。‡',
  }
},
[32402] = {
  {
    'A situação em Dalaran‡Ситуация в Даларане‡Die Lage in Dalaran‡달라란의 정세‡Problemas en Dalaran‡‡La situation à Dalaran‡达拉然的局势‡',
    nil,
    'Fale com Kromthar e pegue uma carona até Dalaran. Uma‡Поговорите с Кромтар и отправьтесь в Даларан. это‡Sprecht mit Kromthar, um Euch nach Dalaran transportieren zu lassen.‡크롬타르와 대화한 후 달라란으로 가는 탈것을 타야 합니다. 레벨 15‡Habla con Kromthar para que te lleve a Dalaran.‡‡Parlez à Kromthar pour vous rendre à Dalaran.‡与库姆萨尔谈一谈，让他送你去达拉然。‡',
  }
},
[32403] = {
  {
    'Começa nos esgotos‡Все начинается в стоках‡Erste Station: Kanalisation‡시작은 하수도부터‡Todo empieza en las cloacas‡‡Ça commence dans les égouts‡从下水道开始‡',
    nil,
    'Evacue 9 Cidadãos Fendessol. Uma‡Спасите 9 горожан – Похитителей Солнца. это‡Evakuiert 9 Bürger der Sonnenhäscher.‡선리버 시민 9명을 대피시켜야 합니다. 레벨 15‡Evacúa a 9 ciudadanos Atracasol.‡‡Évacuez 9 Citoyens saccage-soleil.‡疏散9名夺日者平民。‡',
  }
},
[32404] = {
  {
    'Violência na arena‡Жестокость на арене‡Gewalt in der Arena‡투기장 폭동‡Violencia en la arena‡‡Violence dans l’arène‡竞技场的暴行‡',
    nil,
    'Mate 6 Impositores do Pacto de Prata e 4 Feiticeiros Atiradores do Pacto de Prata. Uma‡Убейте 6 карателей Серебряного Союза и 4 магических стрелков Серебряного Союза.‡Tötet 6 Vollstrecker und 4 Zauberschützen des Silberbunds.‡은빛 서약단 집행자 6명과 은빛 서약단 마법궁수 4명을 처치해야 합니다. 레벨 15‡Mata a 6 déspotas de El Pacto de Plata y a 4 arcos de hechizo de El Pacto de Plata.‡‡Tuez 6 Massacreurs et 4 Sorcelarcs du Concordat argenté.‡击败6名银色盟约刽子手和4名银色盟约投法者。‡',
  }
},
[32405] = {
  {
    'A mão do Pacto de Prata‡Рука Серебряного Союза‡Die Hand des Silberbunds‡은빛 서약단의 오른팔‡La mano de El Pacto de Plata‡‡La main du Concordat argenté‡‡',
    nil,
    'Mate Sorin Mão de Mago. Uma‡Убейте Сорина Мага. это‡Tötet Sorin Magierhand.‡소린 메이지핸드를 처치해야 합니다. 레벨 15‡Mata a Sorin Domeñamagia.‡‡Tuez Sorin Maindemage.‡‡',
  }
},
[32406] = {
  {
    'Um ataque tático‡Элемент неожиданности‡Ein taktischer Angriff‡전술 공격‡Un asalto táctico‡‡Un assaut tactique‡‡',
    nil,
    'Siga o Grão-Magíster Rommath até o centro de Dalaran. Uma‡Проследуйте за верховным магистром Ромматом в центр Даларана. это‡Folgt Großmagister Rommath ins Zentrum von Dalaran.‡대마법학자 롬매스를 따라 룬위버 광장으로 가야 합니다. 레벨 15‡Sigue al gran magister Rommath al centro de Dalaran.‡‡Suivez le Grand magistère Rommath jusqu’au centre de Dalaran.‡‡',
  }
},
[32407] = {
  {
    '‡‡Handelsmarkt der Magier‡‡‡‡‡‡',
    nil,
    nil,
  }
},
[32408] = {
  {
    'O bastião do Pacto de Prata‡Крепость Серебряного Союза‡Die Festung des Silberbunds‡은빛 서약단의 요새‡El bastión de El Pacto de Plata‡‡Le bastion du Concordat argenté‡银色盟约的堡垒‡',
    nil,
    'Mate a Arcanista Rathaella. Uma‡Убейте чародея Ратаэллу. это‡Tötet Arkanistin Rathaella.‡신비술사 라타엘라를 처치해야 합니다. 레벨 15‡Mata a la arcanista Rathaella.‡‡Tuez l’Arcaniste Rathaëlla.‡击败奥术师兰塞拉。‡',
  }
},
[32409] = {
  {
    'O verdadeiro Kirin Tor‡Подлинный облик Кирин-Тора‡Das wahre Gesicht der Kirin Tor‡키린 토의 본모습‡La verdadera cara del Kirin Tor‡‡Le vrai visage du Kirin Tor‡肯瑞托的立场‡',
    nil,
    'Mate o Tenente Corwin e 10 dos seus soldados. Uma‡Убейте лейтенанта Корвина и 10 солдат из его отряда. это‡Tötet Leutnant Corwin und 10 seiner Soldaten.‡부관 코윈과 그의 병사 10명을 처치해야 합니다. 레벨 15‡Mata al teniente Corwin y a 10 miembros de su tropa.‡‡Tuez le Lieutenant Corwin et 10 de ses hommes.‡击败考文中尉和他手下的10名士兵。‡',
  }
},
[32410] = {
  {
    'Plataforma de Krasus‡Площадка Краса‡Krasus Landeplatz‡크라서스 착륙장‡Alto de Krasus‡‡L’aire de Krasus‡克拉苏斯平台‡',
    nil,
    'Liberte 6 Falcodragos de Fendessol. Uma‡Освободите 6 дракондоров Похитителей Солнца. это‡Befreit 6 Drachenfalken der Sonnenhäscher.‡선리버 용매 6마리를 풀어줘야 합니다. 레벨 15‡Libera 6 dracohalcones Atracasol.‡‡Libérez 6 Faucons-dragons saccage-soleil.‡救下6只夺日者龙鹰。‡',
  }
},
[32412] = {
  {
    'Última tentativa‡Последняя надежда‡Der letzte Ort‡마지막 기회‡El último intento‡‡Une dernière tentative‡最后一根稻草‡',
    nil,
    'Mate o Mago-comandante Zuros, depois escape de Dalaran. Uma‡Убейте командира магов Зуроса и осуществите побег из Даларана. это‡Tötet den Magierkommandanten Zuros und flieht dann aus Dalaran.‡마법사사령관 주로스를 처치한 뒤 달라란에서 대피해야 합니다. 레벨 15‡Mata al mago comandante Zuros y luego huye de Dalaran.‡‡Tuez le Commandant-mage Zuros, puis échappez-vous de Dalaran.‡击败法师指挥官左洛斯然后逃出达拉然。‡',
  }
},
[32413] = {
  {
    'Retorno a Krasarang‡Возвращение в Красаранг‡Rückkehr nach Krasarang‡크라사랑으로 귀환‡Regreso a Krasarang‡‡De retour à Krasarang‡返回卡桑琅‡',
    nil,
    'Apresente-se ao General Nazgrim no Ponto de Dominação, que fica na Selva de Krasarang. Uma‡Доложите генералу Назгриму в Крепости Покорителей в Красарангских джунглях.‡Meldet Euch bei General Nazgrim bei der Herrschaftsfeste in der Krasarangwildnis.‡크라사랑 밀림의 지배령 거점에 있는 장군 나즈그림에게 보고해야 합니다. 레벨 15‡Preséntate ante el general Nazgrim en el Punto de Dominio, en la Espesura Krasarang.‡‡Faites votre rapport au Général Nazgrim à la Halte de la Domination, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的统御岗哨找纳兹戈林将军。‡',
  }
},
[32414] = {
  {
    'Darnassus atacada?‡Дарнас в осаде?‡Angriff auf Darnassus?‡공격받는 다르나서스‡¿Ataque en Darnassus?‡‡Darnassus attaquée ?‡达纳苏斯遭袭？‡',
    nil,
    'Fale com Marmus Canhota de Ouro no Ancoradouro do Leão para ser transportad&lt;o/a&gt; até Darnassus e fale com Jaina quando chegar lá. Uma‡Обратитесь к Шеймусу Золотым Башмакам в Львином лагере, чтобы он помог вам попасть в Дарнас. По прибытии поговорите с Джайной.‡Sprecht mit Seamus Goldtreter in der Löwenlandung, um Euch nach Darnassus transportieren zu lassen. Sprecht dort mit Jaina, sobald Ihr eingetroffen seid.‡사자의 상륙지에 있는 셰이머스 골든킥스와 대화하면 다르나서스로 갈 수 있습니다. 다르나서스에 도착한 후, 제이나와 대화해야 합니다.‡Habla con Seamus Marchafulgente en el Desembarco del León para teletransportarte a Darnassus y luego habla con Jaina cuando llegues.‡‡Parlez à Seamus Bottelor pour organiser votre transfert du Territoire du Lion à Darnassus, puis parlez à Jaina à votre arrivée.‡去找雄狮港的谢默斯·金足，传送去达纳苏斯，到那以后与吉安娜谈一谈。‡',
  }
},
[32415] = {
  {
    'Os rastros deles‡Их следы‡Ihre Spuren‡‡El rastro‡‡Leurs traces‡‡',
    nil,
    'Uma‡это‡‡‡‡‡‡‡',
  }
},
[32416] = {
  {
    'A decisão de Jaina‡Решение Джайны‡Jainas Entschluss‡제이나의 결의‡La resolución de Jaina‡‡La résolution de Jaina‡吉安娜的决意‡',
    nil,
    'Use o portal para ir de Darnassus até Dalaran, então fale com Vereesa Correventos do outro lado. Uma‡Воспользуйтесь порталом из Дарнаса в Даларан и поговорите с Верисой Ветрокрылой.‡Benutzt das Portal von Darnassus nach Dalaran und sprecht anschließend mit Vereesa Windläufer auf der anderen Seite.‡다르나서스에서 차원문을 통해 달라란으로 간 후, 베리사 윈드러너와 대화해야 합니다. 레벨 15‡Utiliza el portal de Darnassus a Dalaran y habla con Vereesa Brisaveloz en el otro lado.‡‡Prenez le portail de Darnassus vers Dalaran, puis parlez à Vereesa Coursevent une fois sur place.‡使用传送门从达纳苏斯前往达拉然，然后与另一边的温蕾萨·风行者谈一谈。‡',
  }
},
[32417] = {
  {
    'Limpeza dos esgotos‡Зачистка стоков‡Reinigung der Kanalisation‡하수도 청소‡Limpiar las cloacas‡‡La purge des égouts‡清理下水道‡',
    nil,
    'Mate 12 Fendessol nos Esgotos de Dalaran. Uma‡Убейте 12 Похитителей Солнца в стоках Даларана. это‡Tötet 12 Sonnenhäscher in der Kanalisation von Dalaran.‡달라란 하수도에서 선리버 일당 12명을 처치해야 합니다. 레벨 15‡Mata a 12 Atracasol en las Cloacas de Dalaran.‡‡Tuez 12 Saccage-Soleil dans les Égouts de Dalaran.‡在达拉然下水道中击败12名夺日者。‡',
  }
},
[32418] = {
  {
    'Troca injusta‡Нечестная сделка‡Ungerechter Handel‡불공정한 거래‡Comercio injusto‡‡Commerce inéquitable‡不公平的交易‡',
    nil,
    'Mate o Mestre Escriba Aelon, Tolyria, o Engrenomago Astalon e Sintharia Tecebrasas. Uma‡Убейте мастера каллиграфии Айлона, Толирию, механомага Асталона и Синтарию Пепельную Паутину.‡Tötet Tintenmeister Aelon, Tolyria, Ausrüstungsmagier Astalon und Sintharia Funkenwirker.‡잉크장인 에일론, 톨리리아, 공학마법사 아스탈론, 신타리아 신더위브를 처치해야 합니다. 레벨 15‡Mata al maestro calígrafo Aelon, Tolyria, mago de equipo Astalon y Sintharia Tejecinérea.‡‡Tuz le Maître des encres Aelon, Tolyria, le Magifacteur Astalon et Sintharia Tissebraise.‡击败墨水大师艾伦、托莉雅、火轮法师艾斯泰伦和辛瑟莉亚·织烬。‡',
  }
},
[32419] = {
  {
    'Se ficar, o bicho come‡Негде спрятаться‡Kein Versteck‡숨을 곳은 없다‡Sin escapatoria‡‡Nulle part où aller‡无处可藏‡',
    nil,
    'Mate 16 Fendessol no Santuário Fendessol. Uma‡Убейте 16 Похитителей Солнца в Прибежище Похитителей Солнца. это‡Tötet 16 Sonnenhäscher in Sonnenhäschers Zuflucht.‡선리버 성소에서 선리버 일당 16명을 처치해야 합니다. 레벨 15‡Mata a 16 Atracasol en el Santuario Atracasol.‡‡Tuez 16 Saccage-Soleil dans le Sanctuaire de Saccage-Soleil.‡在夺日者圣殿击败16名夺日者。‡',
  }
},
[32420] = {
  {
    'Sacando a grana‡Деньги вперед‡Auszahlung‡현금화‡En efectivo‡‡C’est pour un retrait‡兑现‡',
    nil,
    'Mate o Magíster Brasael. Uma‡Убейте магистра Бразайла. это‡Tötet Magister Brasael.‡마법학자 브라샤엘을 처치해야 합니다. 레벨 15‡Mata al magister Brasael.‡‡Tuez le Magistère Brasael.‡击败魔导师布拉塞尔。‡',
  }
},
[32421] = {
  {
    'Se correr, o bicho pega‡Некуда бежать‡Kein Ausweg‡달아날 곳은 없다‡Sin salida‡‡Sans échappatoire‡无处可逃‡',
    nil,
    'Incapacite 5 Falcodrago de Fendessol para o voo. Uma‡Лишите 5 дракондоров Похитителей Солнца возможности летать. это‡Macht 5 Drachenfalken der Sonnenhäscher flugunfähig.‡선리버 용매 5마리를 날지 못하게 해야 합니다. 레벨 15‡Consigue que 5 dracohalcones Atracasol sean incapaces de volar.‡‡Rendez 5 Faucons-dragons saccage-soleil incapables de voler.‡令5头夺日者龙鹰失去飞行能力。‡',
  }
},
[32422] = {
  {
    '‡‡In die Violette Festung‡‡‡‡‡‡',
    nil,
    nil,
  }
},
[32423] = {
  {
    'O que tinha que ser feito‡Что должно быть сделано‡Was getan werden musste‡해야만 했던 일‡Lo que había que hacer‡‡Ce qui devait être fait‡有所必为‡',
    nil,
    'Fale com Vereesa Correventos para ir até o Ancoradouro do Leão e, depois, fale com o Rei Varian Wrynn. Uma‡Поговорите с Верисой Ветрокрылой, чтобы отправиться в Львиный лагерь, после чего поговорите с королем Варианом Ринном.‡Sprecht mit Vereesa Windläufer, um zur Löwenlandung zu reisen, und sprecht dann mit König Varian Wrynn.‡베리사 윈드러너와 대화하여 사자의 상륙지로 이동한 후, 국왕 바리안 린과 대화해야 합니다. 레벨 15‡Habla con Vereesa Brisaveloz para viajar al Desembarco del León. Una vez allí, habla con el rey Varian Wrynn.‡‡Parlez à Vereesa Coursevent pour vous rendre au territoire du Lion, puis parlez au Roi Varian Wrynn.‡去找温蕾萨·风行者交谈以前往雄狮港，到那以后与瓦里安·乌瑞恩国王谈一谈。‡',
  }
},
[32424] = {
  {
    '‡‡Was getan werden musste‡‡‡‡‡‡',
    nil,
    nil,
  }
},
[32425] = {
  {
    '‡‡Rückkehr zur Löwenlandung‡‡‡‡‡‡',
    nil,
    nil,
  }
},
[32426] = {
  {
    'Mexido, não batido‡Смешать, но не взбалтывать‡Gerührt, nicht geschüttelt‡흔들지 말고 저어서‡Agitado, no mezclado‡‡Agité, pas secoué‡烦而不乱‡',
    nil,
    'Encontre o Professor Kilt na Sala Cabum, no Bar Brigalhada do Bizmo. Uma‡Найдите профессора Килта в бумзале потасовочной "У Бизмо". это‡Findet Professor Kilt in der VIP-Lounge von Bizmos Boxbar.‡비즈모의 싸움굴, 대박장에서 교수 킬트를 만나야 합니다. 레벨 15‡Encuentra al profesor Kilt en el garito del Club de Lucha de Bizmo.‡‡Trouvez le Professeur Kilt dans le carré VIP du Bar-Tabasse de Bizmo.‡去搏击俱乐部的贵宾室找到基尔特教授。‡',
  }
},
[32427] = {
  {
    'A medida de um líder‡Мерило для предводителя‡Was den Anführer ausmacht‡지도자의 역량‡La medida de un líder‡‡Les qualités d’un chef‡领袖的标准‡',
    nil,
    'Fale com Wrathion na Taberna nas Nuvens. Uma‡Поговорите с Гневионом в таверне "В туманах". это‡Sprecht mit Furorion in der Taverne im Nebel.‡안개 속의 주점에서 래시온과 대화해야 합니다. 레벨 35‡Habla con Wrathion en la Taberna en la Niebla.‡‡Parlez à Irion à la Taverne dans les Brumes.‡与迷雾酒肆的拉希奥谈一谈。‡',
  }
},
[32428] = {
  {
    'Domador de Espíritos Pandarens‡Укротитель пандаренских духов‡Pandarischer Geisterzähmer‡판다렌 정령 조련사‡Domador de espíritus pandaren‡‡Dompteur d’esprits pandarens‡熊猫人驭灵师‡',
    nil,
    'Derrote todos os Espíritos Pandarens em uma batalha de mascotes. Uma‡Победите всех пандаренских духов в битве питомцев. это‡Besiegt sämtliche Pandarengeister in einem Haustierkampf.‡애완동물 대전에서 판다렌 정령들을 모두 꺾어야 합니다. 레벨 1‡Derrota a todos los espíritus pandaren en duelos de mascotas.‡‡Gagnez un combat de mascottes contre chaque Esprit pandaren.‡在宠物对战中击败所有的熊猫人古灵。‡',
  }
},
[32430] = {
  {
    'Mudança de comando‡Смена командования‡Führungswechsel‡지휘권 박탈‡Un cambio de mando‡‡Changement de commandement‡朝令夕改‡',
    nil,
    'Mate o Grão-marechal Duas-tranças no Ancoradouro do Leão, na Selva de Krasarang. Você precisará de um grupo. Uma‡Убейте верховного маршала Двукоссу в Львином лагере в Красарангских джунглях. Вам потребуется группа.‡Tötet Hochmarschall Doppelzopf in der Löwenlandung in der Krasarangwildnis. Ihr werdet dafür eine Gruppe brauchen.‡크라사랑 밀림, 사자의 상륙지에 있는 대장군 트윈브레이드를 처치해야 합니다. 여럿이 함께 가야 할 것입니다.‡Mata al alto mariscal Trenzado en el Desembarco del León, en la Espesura Krasarang. Te hará falta un grupo.‡‡Tuez le Haut maréchal Doublenattes au Territoire du Lion, dans les Étendues sauvages de Krasarang. Vous aurez besoin d’un groupe. Donne  en récompense.‡去卡桑琅丛林的雄狮港击败大元帅双辫。建议你组队前往。‡',
  }
},
[32431] = {
  {
    'Glória à Horda‡Слава Орде‡Ruhm der Horde‡호드에게 영광을‡Gloria a la Horda‡‡Gloire à la Horde‡荣耀属于部落‡',
    nil,
    'Vença batalhas no Templo de Kotmogu e nas Minas Estilhaço Prateado. Uma‡Выиграйте битвы за храм Котмогу и Сверкающие копи. это‡Gewinnt Kämpfe beim Tempel von Katmogu und in der Silberbruchmine.‡코트모구의 사원과 은빛수정 광산 전장에서 승리해야 합니다. 레벨 35‡Gana batallas en el Templo de Kotmogu y las Minas Lonjaplata.‡‡Gagnez des batailles au Temple de Kotmogu et aux Mines d’Éclargent.‡赢得寇魔古寺和碎银矿脉的胜利。‡',
  }
},
[32432] = {
  {
    'A alma da Horda‡Душа Орды‡Die Seele der Horde‡호드의 혼‡El alma de la Horda‡‡L’âme de la Horde‡部落之魂‡',
    nil,
    'Fale com Wrathion. Uma‡Поговорите с Гневионом. это‡Sprecht mit Furorion.‡래시온과 대화해야 합니다. 레벨 35‡Habla con Wrathion.‡‡Parlez à Irion.‡与拉希奥谈一谈。‡',
  }
},
[32433] = {
  {
    'A dor do minerador‡Яма для Подкопника‡In der Mine unten unterminieren‡지하 광부를 낮게 평가하지 말라‡Socavando al Socavador‡‡Miner le sous-mineur‡‡',
    nil,
    'Destrua Grezik Quebraferro na Escavação de Quebraferro. Uma‡Убейте Грезика Рудогрызя в карьере Рудогрызя. это‡Vernichtet Grezik Erzschleif bei Erzschleifs Grabung.‡오어그라인드의 채굴지에 있는 그레직 오어그라인드를 처치해야 합니다. 레벨 1‡Acaba con Grezik Picamena en la Excavación de Picamena.‡‡Supprimez Grézik Rochégrise sur son site de fouilles.‡‡',
  }
},
[32434] = {
  {
    'Espírito Pandaren Flamejante‡Пылающий пандаренский дух‡Brennender Pandarengeist‡불타는 판다렌 정령‡Espíritu pandaren ardiente‡‡Esprit pandaren ardent‡熊猫人烈焰之灵‡',
    nil,
    'Derrote o Espírito Pandaren Flamejante em uma batalha de mascotes. Uma‡Победите пылающего пандаренского духа в битве питомцев. это‡Besiegt den brennenden Pandarengeist in einem Haustierkampf.‡애완동물 대전에서 불타는 판다렌 정령을 꺾어야 합니다. 레벨 1‡Derrota al espíritu pandaren ardiente en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre l’Esprit pandaren ardent.‡在宠物对战中击败熊猫人烈焰之灵。‡',
  }
},
[32437] = {
  {
    'Evento de Rastreamento: Viu Sarannha 1‡Tracking Event: Saw Sarannha 1‡Verfolgungsereignis: Sarannha gesehen 2‡이벤트 추적: 사란나 봤음 1‡Tracking Event: Saw Sarannha 1‡‡Suivi d’évènement : Visite à Sarannha 1‡追踪事件：见到萨拉哈1‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[32438] = {
  {
    'Evento de Rastreamento: Viu Sarannha 2‡Tracking Event: Saw Sarannha 2‡Verfolgungsereignis: Sarannha gesehen 1‡이벤트 추적: 사란나 봤음 2‡Tracking Event: Saw Sarannha 2‡‡Suivi d’évènement : Visite à Sarannha 2‡追踪事件：见到萨拉哈2‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[32439] = {
  {
    'Espírito Pandaren Fluido‡Парящий пандаренский дух‡Fließender Pandarengeist‡흐르는 판다렌 정령‡Espíritu pandaren fluyente‡‡Esprit pandaren fluide‡熊猫人流水之灵‡',
    nil,
    'Derrote o Espírito Pandaren Fluido em uma batalha de mascotes. Uma‡Победите парящего пандаренского духа в битве питомцев. это‡Besiegt den fließenden Pandarengeist in einem Haustierkampf.‡애완동물 대전에서 흐르는 판다렌 정령을 꺾어야 합니다. 레벨 1‡Derrota al espíritu pandaren fluyente en un duelos de mascotas.‡‡Gagnez un combat de mascottes contre l’Esprit pandaren fluide.‡在宠物对战中击败熊猫人流水之灵。‡',
  }
},
[32440] = {
  {
    'Espírito Pandaren Sussurrante‡Шепчущий пандаренский дух‡Flüsternder Pandarengeist‡속삭이는 판다렌 정령‡Espíritu pandaren susurrante‡‡Esprit pandaren murmurant‡熊猫人微风之灵‡',
    nil,
    'Derrote o Espírito Pandaren Sussurrante em uma batalha de mascotes. Uma‡Победите шепчущего пандаренского духа в битве питомцев. это‡Besiegt den flüsternden Pandarengeist in einem Haustierkampf.‡애완동물 대전에서 속삭이는 판다렌 정령을 꺾어야 합니다. 레벨 1‡Derrota al espíritu pandaren susurrante en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre l’Esprit pandaren murmurant.‡在宠物对战中击败熊猫人微风之灵。‡',
  }
},
[32441] = {
  {
    'Espírito Pandaren Trovejante‡Рокочущий пандаренский дух‡Bebender Pandarengeist‡요동치는 판다렌 정령‡El espíritu pandaren tronador‡‡Esprit pandaren fulminant‡熊猫人雷霆之灵‡',
    nil,
    'Derrote o Espírito Pandaren Trovejante em uma batalha de mascotes. Uma‡Победите рокочущего пандаренского духа в битве питомцев. это‡Besiegt den bebenden Pandarengeist in einem Haustierkampf.‡애완동물 대전에서 요동치는 판다렌 정령을 꺾어야 합니다. 레벨 1‡Derrota al espíritu pandaren tronador en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre l’Esprit pandaren fulminant.‡在宠物对战中击败熊猫人雷霆之灵。‡',
  }
},
[32442] = {
  {
    'Perigo iminente‡Нависшая угроза‡Drohende Gefahr‡임박한 위험‡Peligro inminente‡‡Danger imminent‡迫在眉睫‡',
    nil,
    'Complete a missão, "Perigo iminente". Uma‡Выполните задание "Нависшая угроза". это‡Schließt die Mission "Drohende Gefahr" ab.‡"임박한 위험" 임무를 완료해야 합니다. 레벨 45‡Completa la misión "Peligro inminente".‡‡Accomplissez la mission « Danger imminent ».‡完成任务“迫在眉睫”。‡',
  }
},
[32444] = {
  {
    'FLAG - Ganhou título de Brigão (Semanal)‡FLAG - Earned Brawler Title (Weekly)‡FLAG - Earned Brawler Title (Weekly)‡플래그 - 싸움꾼 칭호 얻음 (주간)‡FLAG - Earned Brawler Title (Weekly)‡‡FLAG - Earned Brawler Title (Weekly)‡FLAG - Earned Brawler Title (Weekly)‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[32446] = {
  {
    'Desmontagem requerida‡Требуется разборка‡Bitte auseinandernehmen‡분해해 버려라‡Des-montaje‡‡Désassemblage nécessaire‡拆卸请求‡',
    nil,
    'Destrua os Retalhadores da Selva usando o Controle Remoto Reconfigurado e colete 6 pedaços de Sucata. Uma‡Уничтожьте джунглевые крошшеры с помощью перепрограммированного пульта дистанционного управления и соберите 6 кусков металлолома.‡Zerstört mit der rekonfigurierten Fernsteuerung die Dschungelschredder und sammelt dann 6 Stücke Metallschrott.‡조작된 원격조종기를 사용해 밀림 벌목기를 파괴하고, 금속 조각 6개를 모아야 합니다. 레벨 15‡Destruye los machacadores de la jungla con el mando reconfigurado y recoge 6 piezas de chatarra.‡‡Détruisez les Déchiqueteurs de la jungle en utilisant la Télécommande reprogrammée, puis récoltez 6 bouts de Ferraille.‡使用重置的遥控器摧毁丛林伐木机并收集6个废金属。‡',
  }
},
[32448] = {
  {
    'Laços com o passado‡Связь с прошлым‡Mit der Vergangenheit verbunden‡과거와의 연결점‡Lazos del pasado‡‡Les liens du passé‡旧日的羁绊‡',
    nil,
    'Recupere a Essência Espiritual de Varatus. Uma‡Найдите духовную сущность Варатуса. это‡Besorgt die Geistessenz von Varatus.‡바라투스의 영혼 정수를 회수해야 합니다. 레벨 15‡Consigue la esencia espiritual de Varatus.‡‡Récupérez l’Essence spirituelle de Varatus.‡获得瓦拉图的灵魂精华。‡',
  }
},
[32449] = {
  {
    'As Ruínas de Ogudei‡Руины Огудея‡Die Ruinen von Ogudei‡오구데이 폐허‡Las Ruinas de Ogudei‡‡Les ruines d’Ogudei‡敖骨打废墟‡',
    nil,
    'Apresente-se a Belloc Gumélion no Posto Avançado Foguetelouco. Uma‡Поговорите с Беллоком Сияющим Клинком на аванпосте Искрожига. это‡Meldet Euch bei Bellok Leuchtklinge im Außenposten Zündmine.‡스파크로켓 전초기지에 있는 벨록 브라이트블레이드에게 보고해야 합니다. 레벨 15‡Preséntate ante Belloc Hoja Brillante en la Avanzada de Chispamisil.‡‡Présentez-vous à Belloc Brillelame à l’Avant-poste de Grilletorpille.‡去火箭岗哨找贝洛克·辉刃。‡',
  }
},
[32450] = {
  {
    'A hora é agora!‡Время настало!‡Jetzt oder nie!‡때가 왔다!‡¡Llegó la hora!‡‡C’est le bon moment !‡就是现在！‡',
    nil,
    'Apresente-se à Mestressombra Kiryn no Posto Avançado Foguetelouco. Uma‡Поговорите с темным мастером Кирин на аванпосте Искрожига. это‡Meldet Euch bei Schattenmeisterin Kiryn im Außenposten Zündmine.‡스파크로켓 전초기지에 있는 그늘지배자 키린에게 보고해야 합니다. 레벨 15‡Preséntate ante la maestra tétrica Kiryn en la Avanzada de Chispamisil.‡‡Présentez-vous à la Maîtresse de l’Ombre Kiryn à l’Avant-poste de Grilletorpille.‡去火箭岗哨找匿踪大师琪麟。‡',
  }
},
[32451] = {
  {
    'Mandando um recado‡Послание‡Eine Nachricht senden‡전령의 발걸음‡Enviar un mensaje‡‡Envoyer un message‡明确的信息‡',
    nil,
    'Apresente-se à Almirante do Céu Rogers a bordo do Celesfogo, na Selva de Krasarang. Uma‡Поговорите с небесным адмиралом Роджерс на борту "Небесного огня" в Красарангских джунглях.‡Meldet Euch bei Himmelsadmiralin Rogers an Bord der Himmelsfeuer in der Krasarangwildnis.‡크라사랑 밀림의 하늘불꽃호에 있는 하늘 제독 로저스에게 보고해야 합니다. 레벨 15‡Preséntate ante la almirante del cielo Rogers a bordo de El Abrasacielos, en la Espesura Krasarang.‡‡Présentez-vous à l’Amiral du ciel Rogers à bord du Brûleciel, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的天火号找空军上将罗杰斯。‡',
  }
},
[32452] = {
  {
    'E então chegaram os goblins‡Теперь мы примемся за гоблинов‡Und dann gab\'s Goblins‡언제나 고블린이 말썽‡Goblins molestos‡‡Et les gobelins sont arrivés‡还有地精‡',
    nil,
    'Apresente-se à Almirante do Céu Rogers a bordo do Celesfogo, na Selva de Krasarang. Uma‡Поговорите с небесным адмиралом Роджерс на борту "Небесного огня" в Красарангских джунглях.‡Meldet Euch bei Himmelsadmiralin Rogers an Bord der Himmelsfeuer in der Krasarangwildnis.‡크라사랑 밀림의 하늘불꽃호에 있는 하늘 제독 로저스에게 보고해야 합니다. 레벨 15‡Preséntate ante la almirante del cielo Rogers a bordo de El Abrasacielos, en la Espesura Krasarang.‡‡Présentez-vous à l’Amiral du ciel Rogers à bord du Brûleciel, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的天火号找空军上将罗杰斯。‡',
  }
},
[32455] = {
  {
    'O silêncio‡Тишина‡Die Stille‡침묵‡El silencio‡‡Le silence‡寂静无声‡',
    nil,
    'Use a Pistola Sinalizadora da Aliança. Uma‡Запустите сигнальную ракету Альянса. это‡Benutzt die Leuchtpistole der Allianz.‡얼라이언스 신호용 권총을 사용해야 합니다. 레벨 15‡Usa la pistola de bengalas de la Alianza.‡‡Utilisez le Lance-fusée de l’Alliance.‡使用联盟信号枪。‡',
  }
},
[32457] = {
  {
    'O Rei Trovão‡Властелин Грома‡Der Donnerkönig‡천둥왕‡El Rey del Trueno‡‡Le roi-tonnerre‡雷电之王‡',
    nil,
    'Fale com Wrathion no segundo andar da Taberna nas Nuvens, que fica na Escadaria Oculta. Uma‡Поговорите с Гневионом на втором этаже таверны "В туманах", что на Сокрытой лестнице.‡Kontaktiert Furorion im zweiten Stock der Taverne im Nebel an der Verhüllten Treppe.‡장막의 계단, 안개 속의 주점 2층에 있는 래시온을 만나야 합니다. 레벨 35‡Contacta con Wrathion en la segunda planta de la Taberna en la Niebla, en La Escalera Velada.‡‡Contactez Irion à l’étage de la Taverne dans les brumes, à l’Escalier Dérobé.‡在雾纱栈道的迷雾酒肆二楼与拉希奥取得联系。‡',
  }
},
[32460] = {
  {
    'Rastreando os ladrões‡Выследить воров‡Den Dieben auf der Spur‡도둑 뒤밟기‡¿Dónde están los ladrones?‡‡Pister les voleurs‡追捕窃贼‡',
    nil,
    'Ajude Jaina a descobrir quem levou o Sino Divino e para onde o levaram. Fale com Marmus Canhota de Ouro no Ancoradouro do Leão para ser transportad&lt;o/a&gt; até Darnassus.‡Вместе с Джайной выясните, кто и каким образом выкрал Божественный колокол. Вы можете поговорить с Шеймусом Золотыми Башмаками в Львином лагере, чтобы отправиться в Дарнас.‡Helft Jaina dabei, herauszufinden, wer die Götterglocke gestohlen hat und wo sie hingebracht wurde. Ihr könnt Euch von Seamus Goldtreter in der Löwenlandung nach Darnassus teleportieren lassen.‡제이나를 도와 천상의 종을 누가, 어디로 가져갔는지 알아내야 합니다. 사자의 상륙지에 있는 셰이머스 골든킥스와 대화하면 다르나서스로 갈 수 있습니다.‡Ayuda a Jaina a descubrir quién cogió la Campana Divina y dónde. Para teletransportarte a Darnassus habla con Seamus Marchafulgente.‡‡Aidez Jaina à découvrir qui a volé la Cloche divine, et où on l’a emportée. Parlez à Seamus Bottelor au Territoire du Lion pour vous téléporter à Darnassus.‡帮助吉安娜找出是谁夺走了圣钟，并把它藏在哪里。你可以去找雄狮港的谢默斯·金足，传送去达纳苏斯。‡',
  }
},
[32461] = {
  {
    'A Ordem da Serpente das Nuvens‡Орден Облачного Змея‡Der Orden der Wolkenschlange‡운룡단‡La Orden del Dragón Nimbo‡‡L’ordre du Serpent-nuage‡云端翔龙骑士团‡',
    nil,
    'Fale com o Instrutor Espinho Celeste no Arboreto, que fica na Floresta de Jade. Uma‡Поговорите с инструктором Небесным Шипом в Дендрарии, расположенном в Нефритовом лесу.‡Sprecht mit Ausbilder Himmelsdorn im Arboretum im Jadewald.‡비취 숲의 도원에 있는 교관 스카이쏜과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el instructor Punta Celeste en El Arboretum, en El Bosque de Jade.‡‡Parlez à l’Instructeur Ronce du Ciel à l’Arboretum, dans la Forêt de Jade.‡去翡翠林的百木园和天荆教头谈一谈。‡',
  }
},
[32467] = {
  {
    'Sacrificial Prevention‡Sacrificial Prevention‡Opfer verhindern‡희생 저지‡Sacrificial Prevention‡‡‡阻止献祭‡',
    nil,
    'Mate 5 Sacerdotes Zandalari. Uma‡Убейте 5 зандаларских жрецов.‡Tötet 5 Priester der Zandalari.‡잔달라 사제 5명을 처치해야 합니다. 레벨 1 천둥의 섬‡Mata a 5 sacerdotes Zandalari.‡‡‡击败5个赞达拉牧师。‡',
  }
},
[32468] = {
  {
    'Transparência do cristal‡Кристально чистые кристаллы‡Kristallklar‡깨끗한 수정‡Claridad cristalina‡‡Clarté cristalline‡澄澈水晶‡',
    nil,
    'Colete 1 Estilhaço de Cristal Imaculado da Matriarca da Serra dos Cristais na Ilha Yojamba, que fica na Selva do Espinhaço. Uma‡Раздобудьте 1 безупречный осколок кристалла у хрустального матриарха на острове Йоджамба, что в Тернистой долине.‡Sammelt 1 makellosen Kristallsplitter von der Kristallrückenmatriarchin auf der Insel Yojamba im Schlingendorntal.‡가시덤불 골짜기의 요잠바 섬에 있는 수정가시 어미를 쓰러뜨리고 온전한 수정 조각 1개를 모아야 합니다.‡Consigue 1 fragmento de cristal prístino de la matriarca Espina de Cristal en Isla Yojamba, en la Vega de Tuercespina.‡‡Récupérez 1 Éclat de cristal en parfait état sur la Matriarche de cristal, sur l’Île de Yojamba, dans la Vallée de Strangleronce. Un(e) quête.‡从荆棘谷的尤亚姆巴岛的水晶之脊主母身上收集一个原生水晶碎片。‡',
  }
},
[32469] = {
  {
    'Transparência do cristal‡Кристально чистые кристаллы‡Kristallklar‡깨끗한 수정‡Claridad cristalina‡‡Clarté cristalline‡澄澈水晶‡',
    nil,
    'Colete 1 Estilhaço de Cristal Imaculado da Matriarca da Serra dos Cristais na Ilha Yojamba, que fica na Selva do Espinhaço. Uma‡Раздобудьте 1 безупречный осколок кристалла у хрустального матриарха на острове Йоджамба, что в Тернистой долине.‡Sammelt 1 makellosen Kristallsplitter von der Kristallrückenmatriarchin auf der Insel Yojamba im Schlingendorntal.‡가시덤불 골짜기의 요잠바 섬에 있는 수정가시 어미를 쓰러뜨리고 온전한 수정 조각 1개를 모아야 합니다.‡Consigue 1 fragmento de cristal prístino de la matriarca Espina de Cristal en Isla Yojamba, en la Vega de Tuercespina.‡‡Récupérez 1 Éclat de cristal en parfait état sur la Matriarche de cristal, sur l’Île de Yojamba, dans la Vallée de Strangleronce. Un(e) quête.‡从荆棘谷的尤亚姆巴岛的水晶之脊主母身上收集一个原生水晶碎片。‡',
  }
},
[32470] = {
  {
    'Luz, câmera, ação‡Свет, камера, мотор!‡Licht, Kamera uuund Action!‡조명, 카메라, 액션!‡Luces, cámara, acción‡‡Reportage photo‡灯光，镜头，开拍‡',
    nil,
    'Colete uma Caixa de Ferro e um Cinto de Burel dentro da capital, e consiga uma Mira Padrão com um engenheiro. Uma‡Раздобудьте в столице железную коробку и коричневатый пояс и попросите инженера сделать вам обычный прицел.‡Beschafft Euch eine eiserne Kiste und einen rotbraunen Gürtel in der Hauptstadt und ein Standardzielfernrohr von einem Ingenieur.‡대도시에서 강철 상자와 황갈색 허리띠를, 기계공학자에게서 일반 조준경을 구해야 합니다. 레벨 1‡Consigue una caja de hierro y un cinturón rojizo en distintas ubicaciones de la capital y una mira estándar de un ingeniero.‡‡Récupérez une boîte en fer et une ceinture brun-roux dans la capitale, ainsi qu’une lunette standard auprès d’un ingénieur.‡在主城内的某处收集一个铁盒子和一条赤色腰带，并从一名工程师处获得一个普通瞄准镜。‡',
  }
},
[32471] = {
  {
    'Luz, câmera, ação‡Свет, камера, мотор!‡Licht, Kamera uuund Action!‡조명, 카메라, 액션!‡Luces, cámara, acción‡‡Reportage photo‡灯光，镜头，开拍‡',
    nil,
    'Colete uma Caixa de Ferro e um Cinto de Burel dentro de Orgrimmar, e consiga uma Mira Padrão com um engenheiro. Uma‡Раздобудьте в Оргриммаре железную коробку и коричневатый пояс и попросите инженера сделать вам обычный прицел.‡Beschafft Euch eine eiserne Kiste und einen rotbraunen Gürtel in Orgrimmar und ein Standardzielfernrohr von einem Ingenieur.‡오그리마에서 강철 상자와 황갈색 허리띠를, 기계공학자에게서 일반 조준경을 구해야 합니다. 레벨 1 오그리마‡Consigue una caja de hierro y un cinturón rojizo de varias partes de Orgrimmar y una mira estándar de un ingeniero.‡‡Récupérez une Boîte en fer et une Ceinture brun-roux à Orgrimmar, ainsi qu’une Lunette standard auprès d’un ingénieur.‡在奥格瑞玛内的位置收集一个铁盒子和一条赤色腰带，并从一名工程师处获得一个普通瞄准镜。‡',
  }
},
[32472] = {
  {
    'Assustar Pterodáctilos‡Frighten Pterodactyls‡Pterodaktylen erschrecken‡도망쳐, 얘들아!‡Pterodáctilos asustados‡‡‡Frighten Pterodactyls‡',
    nil,
    'Assuste 12 Filhotes de Pterodáctilo. Uma‡Напугайте 12 птенцов птеродактиля.‡Erschreckt 12 Pterodaktylusjungtiere.‡새끼 야생 천둥 테러닥틀 12마리를 겁을 줘야 합니다. 레벨 1 천둥의 섬‡Asusta a 12 proles de pterodáctilo.‡‡‡吓跑12头翼手雏龙。‡',
  }
},
[32474] = {
  {
    'Um Teste de Bravura‡Испытание доблести‡Tapferkeitsbeweis‡용맹의 시험‡Prueba tu valía‡‡Test de vaillance‡勇气的试炼‡',
    nil,
    'Consiga a conquista "Um Teste de Bravura" obtendo 3000 Pontos de Bravura.‡Получите достижение "Испытание доблести", заработав 3000 очков доблести.‡Erlangt den Erfolg "Tapferkeitsbeweis", indem Ihr insgesamt 3000 Tapferkeitspunkte verdient.‡용맹 점수 3,000점을 얻어 "용맹의 시험" 업적을 달성해야 합니다.‡Gana 3000 puntos de valor para conseguir el logro "Prueba tu valía".‡‡Obtenez le haut fait « Un test de vaillance » en gagnant 3 000 points de vaillance.‡获取总共3000点勇气点数，达成“勇气的试炼”成就。‡',
  }
},
[32475] = {
  {
    'Centelha de vida‡Вспышка жизни‡Ein Lebensfunke‡생명의 불꽃‡Una chispa de vida‡‡Une étincelle de vie‡‡',
    nil,
    'Leve o Ovo Trovejante para Yalia Sábio Sussurro na Ilha do Trovão. Uma‡Отнесите пронизанное молниями яйцо Ялии Мудрый Шепот на остров Грома.‡Bringt das donnerversetzte Ei zu Yalia Weisenwisper auf der Insel des Donners.‡천둥의 섬에 있는 야리아 세이지위스퍼에게 벼락불에 휩싸인 알을 가져가야 합니다. 레벨 32 천둥의 섬‡Entrega el huevo con encaje de truenos a Yalia Murmullo Sabio en la Isla del Trueno.‡‡Apportez l’Œuf zébré par le tonnerre à Yalia Sage Murmure sur l’Île du Tonnerre.‡‡',
  }
},
[32476] = {
  {
    'A Test of Valor‡A Test of Valor‡A Test of Valor‡A Test of Valor‡A Test of Valor‡‡A Test of Valor‡A Test of Valor‡',
    nil,
    'Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡‡Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡Gain the "A Test of Valor" Achievement by earning a total of 3000 Valor Points.‡',
  }
},
[32477] = {
  {
    'Evento de Rastreamento: Jogador Volta no Tempo‡Tracking Event: Player is Back in Time‡Tracking Event: Player is Back in Time‡트래킹 이벤트: 플레이어가 시간 안에 돌아옴‡Tracking Event: Player is Back in Time‡‡Tracking Event: Player is Back in Time‡Tracking Event: Player is Back in Time‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[32482] = {
  {
    'Shwayder\'s Test Quest‡Проверьте своего хранителя-цыпленка‡Shwayder\'s Test Quest‡슈에이더의 시험용 퀘스트‡Test Your Chicken Guardian‡‡Testez votre gardien de poulets‡Shwayder\'s Test Quest‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32485] = {
  {
    'Reforçando as defesas‡Укрепим оборону‡Die Verteidigung stärken‡방어 강화하기‡Fortalece las defensas‡‡Renforcer les défenses‡加强防御‡',
    nil,
    'Energize 6 Proteções de Perímetro do Kirin Tor ao redor do Pico Violeta. Uma‡Усильте 6 защитных кристаллов Кирин-Тора вокруг Аметистового утеса.‡Ladet 6 Schutzzauber der Kirin Tor auf der Violetten Erhebung auf.‡보랏빛 마루 주위에 있는 키린 토 구역 수호물을 6개 강화해야 합니다. 레벨 32 천둥의 섬‡Fortalece 6 resguardos de perímetro del Kirin Tor alrededor de El Alto Violeta.‡‡Renforcez 6 Garde-périmètre du Kirin Tor près de la Cime Pourpre.‡在紫罗兰高地附近强化6个肯瑞托监视结界。‡',
  }
},
[32489] = {
  {
    'O carpete rastejante de Ihgaluk‡Кишащий насекомыми Ихгалук‡Die krabbelnde Decke auf Ihgaluk‡이갈룩의 스멀거리는 양탄자‡La cucaracha de Ihgaluk ya no puede caminar‡‡Le tapis rampant d\'Ihgaluk‡伊瓜鲁克的恐怖地毯‡',
    nil,
    'Esmague 75 Baratas Ihgaluk. Uma‡Раздавите 75 тараканов Ихгалук.‡Zerquetscht 75 Ihgaluk-Schaben.‡이갈룩 바퀴를 75마리 뭉개야 합니다. 레벨 32 천둥의 섬‡Aplasta a 75 cucarachas Ihgaluk.‡‡Écrasez 75 Cafards d’Ihgaluk.‡踩死75只伊瓜鲁克蟑螂。‡',
  }
},
[32490] = {
  {
    'UNUSED‡UNUSED‡UNBENUTZT‡‡UNUSED‡‡UNUSED‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32491] = {
  {
    'Apodrecendo‡Оставленное гнить‡Verrotten lassen‡썩도록 방치된‡No hay que desperdiciar la comida‡‡Laissé à pourrir‡任其腐烂‡',
    nil,
    'Destrua 3 Amontoados de Carne Fétida. Uma‡Уничтожьте 3 зловонные кучи мяса.‡Zerstört 3 faulige Fleischhaufen.‡악취나는 고기 더미를 3개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 3 montones de carne fétida.‡‡Détruisez 3 Piles de viande fétide.‡摧毁3堆恶臭肉堆。‡',
  }
},
[32492] = {
  {
    'Destruir caldeirões‡Уничтожить котлы‡Kessel zerstören‡가마솥 파괴‡Destroy Cauldrons‡‡Détruire les chaudrons‡摧毁大锅‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32493] = {
  {
    'Todos eles caem‡Все они падут‡Am Ende sterben alle‡모두 쓰러지리‡¡Que no escapen!‡‡Ils finissent tous par périr‡他们都倒下了‡',
    nil,
    'Mate 5 Sentinelas Almatadas e use o Cristal de Ressonância para capturar os espíritos Zandalari presos nelas. Uma‡Убейте 5 питаемых духом стражей и используйте резонирующий кристалл, чтобы поймать духов зандаларов, заключенных в них.‡Zerstört 5 geist-gebundene Wachposten und nutzt den Resonanzkristall, um die in ihnen gefangenen Zandalarigeister einzusammeln.‡영혼결속 보초병 5명을 처치하고 그 안에 갇힌 잔달라 영혼을 공명의 수정으로 포획해야 합니다. 레벨 32 천둥의 섬‡Mata a 5 avizores vinculados a espíritus y utiliza el cristal de resonancia para capturar a los espíritus Zandalari que hay atrapados en ellos.‡‡Tuez 5 Factionnaires liés par les esprits, puis utilisez le Cristal de résonance pour capturer les Esprits zandalari piégés à l’intérieur.‡消灭5名缚灵哨兵，并使用共振水晶捕捉被禁锢在哨兵中的赞达拉巨魔灵魂。‡',
  }
},
[32494] = {
  {
    'Jogo de poder‡Демонстрация силы‡Machtspiele‡강경 처리‡Enmascarados‡‡Jeux de pouvoirs‡以多打少‡',
    nil,
    'Recolha a Máscara do Místico Sombrio e a Máscara do Chama-espíritos do Amarra-espírito Tu\'chek e do Arcanital Ra\'kul no Terraço do Conquistador.‡Заберите маску темного мистика и маску призывателя духов у душелова Ту\'чека и ритуалиста Ра\'кула на Террасе Завоевателя.‡Entwendet Geisterbinder Tu\'chek und Arkanital Ra\'kul auf der Terrasse des Eroberers die Maske des dunklen Mystikers und die Maske des Geisterrufers.‡정복자의 정원에 있는 영혼결속자 투첵과 비전주술사 라쿨에게서 암흑 비술사의 가면과 영혼소환사의 가면을 획득해야 합니다.‡Recupera la máscara del místico oscuro y la máscara del clamaespíritus del vinculador de espíritus Tu\'chek y del arcanital Ra\'kul en la Platea del Conquistador.‡‡Récupérez le Masque du sombre mystique et le Masque du mande-esprits du Lieur d’esprit Tu’chek et du Rituarcaniste Ra’kul, sur la Terrasse des Conquérants.‡从征服者平台的缚灵者图切克和魔术士拉古尔处夺取黑暗秘法面具和唤魂者面具。‡',
  }
},
[32495] = {
  {
    'O Dessangrador‡Кровопускатель‡Der Blutvergießer‡피를 부르는 자‡El Sádico‡‡Le Saigneur‡放血者‡',
    nil,
    'Mate Kaida, o Dessangrador. Uma‡Убейте Кайду Кровопускателя.‡Tötet Kaida den Blutvergießer.‡피를 부르는 카이다를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a Kaida el Sádico.‡‡Tuez Keida le Saigneur.‡击败放血者喀岱。‡',
  }
},
[32496] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡‡Désacralisez ce feu !‡亵渎这团火焰！‡',
    nil,
    'Profane a fogueira da Horda no Vale das Flores Eternas! Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Оскверните большой костер Орды в Вечноцветущем доле! задание из категории Огненный солнцеворот.‡Entweiht das Freudenfeuer der Horde im Tal der Ewigen Blüten!‡영원꽃 골짜기에 있는 호드 화톳불을 모독해야 합니다! 한여름 불꽃축제‡¡Profana la hoguera de la Horda en el Valle de la Flor Eterna! Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Désacralisez le feu de joie de la Horde dans le val de l’Éternel printemps ! Une quête de Solstice d\'été. Donne Fleur ardente en récompense.‡‡',
  }
},
[32497] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a Fogueira de Solstício no Ermo do Medo. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь костру праздника Огненного солнцеворота в Жутких пустошах. задание.‡Ehrt das Sonnenwendfreudenfeuer in der Schreckensöde.‡공포의 황무지에 있는 한여름 축제 화톳불에 경의를 표해야 합니다. 한여름 불꽃축제‡Honra la fogata del Solsticio de Verano en el Desierto del Pavor. Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Honorez le Feu de joie du solstice d’été aux Terres de l’Angoisse. Une quête de Solstice d\'été. Donne Fleur ardente en récompense.‡祭拜恐惧废土的仲夏篝火。‡',
  }
},
[32498] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a Fogueira de Solstício na Floresta de Jade. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь костру праздника Огненного солнцеворота в Нефритовом лесу. задание.‡Ehrt das Sonnenwendfreudenfeuer im Jadewald.‡비취 숲에 있는 한여름 축제 화톳불에 경의를 표해야 합니다. 한여름 불꽃축제‡Honra la fogata del Solsticio de Verano en el Bosque de Jade. Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Honorez le Feu de joie du solstice d’été dans la Forêt de Jade. Une quête de Solstice d\'été. Donne Fleur ardente en récompense. Toujours à jour.‡祭拜翡翠林的仲夏篝火。‡',
  }
},
[32499] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a Fogueira de Solstício na Selva de Krasarang. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь костру праздника Огненного солнцеворота в Красарангских джунглях.‡Ehrt das Sonnenwendfreudenfeuer in der Krasarangwildnis.‡크라사랑 밀림에 있는 한여름 축제 화톳불에 경의를 표해야 합니다. 한여름 불꽃축제‡Honra la fogata del Solsticio de Verano en la Espesura Krasarang. Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Honorez le Feu de joie du solstice d’été dans les Étendues sauvages de Krasarang. Une quête de Solstice d\'été. Donne Fleur ardente en récompense.‡祭拜卡桑琅丛林的仲夏篝火。‡',
  }
},
[32500] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a Fogueira de Solstício no Monte Kun-Lai. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь костру праздника Огненного солнцеворота на вершине Кунь-Лай. задание.‡Ehrt das Sonnenwendfreudenfeuer am Kun-Lai-Gipfel.‡쿤라이 봉우리에 있는 한여름 축제 화톳불에 경의를 표해야 합니다. 한여름 불꽃축제‡Honra la fogata del Solsticio de Verano en la Cima Kun-Lai. Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Honorez le Feu de joie du solstice d’été au Sommet de Kun-Lai. Une quête de Solstice d\'été. Donne Fleur ardente en récompense. Toujours à jour.‡祭拜昆莱山的仲夏篝火。‡',
  }
},
[32501] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a Fogueira de Solstício nas Estepes de Taolong. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь костру праздника Огненного солнцеворота в Танлунских степях. задание.‡Ehrt das Sonnenwendfreudenfeuer in der Tonlongsteppe.‡탕랑 평원에 있는 한여름 축제 화톳불에 경의를 표해야 합니다. 한여름 불꽃축제‡Honra la fogata del Solsticio de Verano en las Estepas de Tong Long. Una misión de Verano. Otorga Flores ardientes como recompensa. Siempre actualizado.‡‡Honorez le Feu de joie du solstice d’été dans les Steppes de Tanglong. Une quête de Solstice d\'été. Donne Fleur ardente en récompense.‡祭拜螳螂高原的仲夏篝火。‡',
  }
},
[32502] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a Fogueira de Solstício no Vale dos Quatro Ventos. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь костру праздника Огненного солнцеворота в долине Четырех Ветров.‡Ehrt das Sonnenwendfreudenfeuer im Tal der Vier Winde.‡네 바람의 계곡에 있는 한여름 축제 화톳불에 경의를 표해야 합니다. 한여름 불꽃축제‡Honra la fogata del Solsticio de Verano en el Valle de los Cuatro Vientos. Una misión de Verano. Otorga Flores ardientes como recompensa. Siempre actualizado.‡‡Honorez le Feu de joie du solstice d’été dans la Vallée des Quatre vents. Une quête de Solstice d\'été. Donne Fleur ardente en récompense.‡祭拜四风谷的仲夏篝火。‡',
  }
},
[32503] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡‡Désacralisez ce feu !‡亵渎这团火焰！‡',
    nil,
    'Profane a fogueira da Aliança no Vale das Flores Eternas! Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Оскверните большой костер Альянса в Вечноцветущем доле! задание из категории Огненный солнцеворот.‡Entweiht das Freudenfeuer der Allianz im Tal der Ewigen Blüten!‡한여름 불꽃축제‡¡Profana la hoguera de la Alianza en el Valle de la Flor Eterna! Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Désacralisez le feu de joie de l’Alliance dans le val de l’Éternel printemps ! Une quête de Solstice d\'été. Donne Fleur ardente en récompense.‡‡',
  }
},
[32504] = {
  {
    'Missão: Os segredos de Ventobravo‡Миссия: тайны Штормграда‡Mission: Die Geheimnisse von Sturmwind‡임무: 스톰윈드의 비밀‡Misión: Los Secretos de Ventormenta‡‡Mission : Les secrets de Hurlevent‡任务：暴风城的秘密‡',
    nil,
    'Uma‡‡‡레벨 10 스톰윈드‡‡‡‡‡',
  }
},
[32506] = {
  {
    'Asas para voar‡Крылья для полета‡Pterrorschwingen verleihen Flügel‡자유롭게 날 수 있도록‡Más vale pterrorala en mano...‡‡Voler de ses propres ailes‡翱翔之翼‡',
    nil,
    'Recupere um Filhote de Pterrorasa Selvagem. Uma‡Поймайте птенца дикого террокрыла.‡Fangt ein wildes Pterrorschwingenjungtier.‡새끼 야생 테러윙을 포획해야 합니다. 레벨 32 천둥의 섬‡Recupera a una prole de pterrorala del trueno salvaje.‡‡Récupérez un Jeune pterreurdaile sauvage.‡找回一只野生飞翼幼龙。‡',
  }
},
[32507] = {
  {
    'Pele dos sauroks‡В шкуре саурока‡In der Haut eines Saurok‡사우록의 거죽‡En la piel de un saurok‡‡La peau des sauroks‡蜥蜴人的皮‡',
    nil,
    'Vá até o Penhasco Ihgaluk e mate um saurok Gumeskuma. Uma‡Отправляйтесь на утесы Ихгалук и убейте саурока Гнилого Клинка.‡Begebt Euch zur Ihgalukklamm und tötet einen Skumklingensaurok.‡이갈룩 바위산으로 가서 부랑칼날 사우록을 한 마리 처치해야 합니다. 레벨 32 천둥의 섬‡Ve al Risco Ihgaluk y mata a un saurok Hojaescoria.‡‡Allez à la Combe d’Ihgaluk et tuez un Saurok crasselame.‡前往伊瓜鲁克峭壁并消灭一名邪刃蜥蜴人。‡',
  }
},
[32508] = {
  {
    'Boas-vindas à Ilha!‡Добро пожаловать на остров‡Willkommen auf der Insel‡섬에 잘 오셨습니다‡Bienvenidos a la Isla‡‡Bienvenue sur l’île‡欢迎到岛上来‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32509] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a chama do Vale das Flores Eternas. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь огню в Вечноцветущем доле. задание из категории Огненный солнцеворот.‡Ehrt die Flamme des Tals der Ewigen Blüten.‡영원꽃 골짜기에 있는 불꽃에 경의를 표하시기 바랍니다. 한여름 불꽃축제‡Honra la llama del Valle de la Flor Eterna. Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Honorez la flamme du Val de l’Éternel printemps. Une quête de Solstice d\'été. Donne Fleur ardente en récompense. Ajouté dans World of Warcraft : Mists of Pandaria.‡‡',
  }
},
[32510] = {
  {
    'Reverencie a chama‡Поклонение огню‡Ehrt die Flamme‡불꽃에 경의를‡Honrar la llama‡‡Honorer la flamme‡祭拜这团火焰‡',
    nil,
    'Reverencie a chama do Vale das Flores Eternas. Solstício de missão. Premia Flor de Fogo. Adicionado em World of Warcraft: Mists of Pandaria.‡Поклонитесь огню в Вечноцветущем доле. задание из категории Огненный солнцеворот.‡Ehrt die Flamme des Tals der Ewigen Blüten.‡영원꽃 골짜기에 있는 불꽃에 경의를 표하시기 바랍니다. 한여름 불꽃축제‡Honra la llama del Valle de la Flor Eterna. Una misión de Verano. Otorga Flores ardientes como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Honorez la flamme du Val de l’Éternel printemps. Une quête de Solstice d\'été. Donne Fleur ardente en récompense. Ajouté dans World of Warcraft : Mists of Pandaria.‡‡',
  }
},
[32516] = {
  {
    'O Dessangrador‡Кровопускатель‡Der Blutvergießer‡‡El Sádico‡‡Le Saigneur‡‡',
    nil,
    'Mate Kaida, o Dessangrador. Uma‡Убейте Кайду Кровопускателя.‡Tötet Kaida den Blutvergießer.‡‡Mata a Kaida el Sádico.‡‡Tuez Keida le Saigneur.‡‡',
  }
},
[32517] = {
  {
    'A conquista de pedra‡Одолеть камень‡Die steinerne Eroberung‡바위 정복‡A la conquista de las piedras‡‡La conquête de pierre‡征服岩石‡',
    nil,
    'Pare o ritual do Antigo Conquistador de Pedra no templo principal do Paço dos Ossos. Uma‡Остановите ритуал по оживлению древнего каменного завоевателя в главном храме Двора Костей.‡Unterbrecht das Ritual des uralten Steineroberers im Haupttempel im Hof der Knochen.‡망자의 궁정에 있는 주 사원에서 고대 바위 정복자 의식을 중단시켜야 합니다. 레벨 32 천둥의 섬‡Detén el ritual de los conquistadores de piedra antiguos en el templo principal de El Patio de los Huesos.‡‡Arrêtez le rituel de l’Ancien conquérant de pierre dans le temple principal de la Cour des Ossements.‡阻止在白骨庭院主殿中举行的古代岩石征服者仪式。‡',
  }
},
[32518] = {
  {
    'Recompensa rara‡Награда за самоотверженность‡Short-Supply Reward‡공급 부족 보상‡Recompensa de escasez de suministros‡‡Récompense de rareté‡短缺奖励‡',
    nil,
    'Uma‡это‡‡레벨 1‡‡‡‡‡',
  }
},
[32519] = {
  {
    'Recompensa rara‡Награда за самоотверженность‡Short-Supply Reward‡공급 부족 보상‡Recompensa de escasez de suministros‡‡Récompense de rareté‡短缺奖励‡',
    nil,
    'Uma‡это‡‡레벨 1‡‡‡‡‡',
  }
},
[32520] = {
  {
    'Magia adversária‡Магия против магии‡Konkurrierende Magie‡위험한 마술사‡Magia conflictiva‡‡Compétition de magie‡魔法竞赛‡',
    nil,
    'Mate o Tece-arcos Jor\'guva. Uma‡Убейте чародея Джор\'гуву.‡Tötet Arkanwirker Jor\'guva.‡대마술사 조르구바를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata al tejearcos Jor\'guva.‡‡Tuez le Tisse-arc Jor’guva.‡消灭织奥者琼古瓦。‡',
  }
},
[32521] = {
  {
    'Força de invasão‡Вторжение‡Feindlicher Übergriff‡적군의 침략‡Fuerzas invasoras‡‡Une troupe envahissante‡渗透力量‡',
    nil,
    'Mate Nurkala, o Líder Guerreiro dos Zandalari. Uma‡Убейте Нуркала, военного вождя зандаларов.‡Tötet Nurkala, den Kriegsanführer der Zandalari.‡잔달라 전쟁 지도자인 누르카라를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a Nurkala, líder de guerra Zandalari.‡‡Tuez Nurkala, le chef de guerre zandalari.‡消灭赞达拉战争首领奴卡拉。‡',
  }
},
[32522] = {
  {
    'Ameaça iminente‡Серьезная угроза‡Imposante Bedrohung‡눈앞에 닥친 위기‡Una amenaza imponente‡‡Une menace impressionnante‡危机四伏‡',
    nil,
    'Mate Horgak, o Escravizador. Uma‡Убейте Хограка Поработителя.‡Tötet Horgak den Versklaver.‡노예사냥꾼 호르각을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a Horgak el Esclavista.‡‡Tuez Horgak l’Esclavagiste.‡消灭奴役者霍嘎克。‡',
  }
},
[32523] = {
  {
    'O cercado de feras‡Загоны для зверей‡Die Bestienpferche‡야수 조련소‡El Cerco de las Bestias‡‡Les enclos à bêtes‡兽栏‡',
    nil,
    'Encontre a Capitã dos Batedores Elsia no Cercado das Feras. Uma‡Разыщите капитана разведчиков Эльсию в загонах для зверей.‡Findet Späherhauptmann Elsia in den Bestienpferchen.‡야수 조련소에 있는 정찰대장 엘시아를 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra a la capitana de exploradores Elsia en El Cerco de las Bestias.‡‡Trouvez le Capitaine des éclaireurs Elsia dans les Enclos à bêtes.‡在兽栏找到斥候队长艾尔希娅。‡',
  }
},
[32524] = {
  {
    'O rufar dos tambores trólicos‡Бой барабанов троллей‡Im Takt der Trolltrommeln‡트롤의 북소리‡Redobles trols‡‡Les tambours des Trolls‡‡',
    nil,
    'Encontre a Capitã dos Batedores Elsia no Terraço do Conquistador. Uma‡Найдите капитана разведчиков Эльсию на Террасе Завоевателя.‡Sucht Späherhauptmann Elsia auf der Terrasse des Eroberers.‡정복자의 정원에 있는 정찰대장 엘시아에게 가야 합니다. 레벨 32 천둥의 섬‡Localiza a la capitana de exploradores Elsia en la Platea del Conquistador.‡‡Localisez le Capitaine des éclaireurs Elsia sur la Terrasse des Conquérants.‡‡',
  }
},
[32525] = {
  {
    'Cinzas do inimigo‡Прах врагов‡Asche des Feindes‡적의 유골‡Las cenizas del enemigo‡‡Les cendres de l’ennemi‡敌人的骨灰‡',
    nil,
    'Queime 8 Restos Mumificados. Uma‡Сожгите 8 мумифицированных останков.‡Verbrennt 8 mumifizierte Überreste.‡미라가 된 유해를 8구 불태워야 합니다. 레벨 32 천둥의 섬‡Quema 8 restos momificados.‡‡Brûlez 8 Restes momifiés.‡超度8具干尸残骸。‡',
  }
},
[32526] = {
  {
    'Rendição da alma‡Освобождение душ‡Seelenrettung‡영혼의 굴복‡Entrégame tu alma‡‡Abandon d\'âme‡失魂者‡',
    nil,
    'Resgate 6 Batedores do Pacto de Prata ou Batedores Fendessol. Uma‡Спасите 6 разведчиков Серебряного Союза или разведчиков Похитителей Солнца.‡Rettet 6 Späher des Silberbunds oder der Sonnenhäscher.‡은빛 서약단 정찰병 또는 선리버 정찰병을 6명 구출해야 합니다. 레벨 32 천둥의 섬‡Salva a 6 exploradores de El Pacto de Plata o Atracasol.‡‡Sauvez 6 Éclaireurs du Concordat argenté ou saccage-soleil.‡解救6名银色盟约斥候或夺日者斥候。‡',
  }
},
[32527] = {
  {
    'Circunstâncias mortais‡Мертвое дело‡Gravierende Umstände‡심각한 상황‡Una situación delicada‡‡À tombeau ouvert‡严峻局势‡',
    nil,
    'Mate 10 Guarda-tumbas Shan\'ze, Rasgalmas Shan\'ze ou Arautos do Trovão Shan\'ze. Uma‡Убейте 10 хранителей могил Шань\'цзэ, кромсателей душ Шань\'цзэ или призывателей грома Шань\'цзэ.‡Tötet 10 Grabhüter der Shan\'ze, Seelenreißer der Shan\'ze oder Donnerrufer der Shan\'ze.‡샨쩌 무덤지기, 샨쩌 영혼해체자, 또는 샨쩌 천둥술사 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 guardianes de las tumbas Shan\'ze, desgarradores de almas Shan\'ze o clamatruenos Shan\'ze.‡‡Tuez 10 Garde-tombes de Shan’ze, Faucheurs d’âme de Shan’ze ou Mande-tonnerres de Shan’ze.‡击败10名山泽守陵者、山泽夺魂者或山泽唤雷者。‡',
  }
},
[32528] = {
  {
    'Cripta adentro‡В склепы‡In die Krypta‡납골당 안으로‡Hacia las criptas‡‡Dans les cryptes‡进入墓穴‡',
    nil,
    'Use o Encantamento de Gura no Salão dos Exaltados. Depois, derrote Gura, o Recuperado. Uma‡Воспользуйтесь чарами Гуры в Залах Превознесения, а затем победите Гуру Освобожденного.‡Benutzt die Zauberformel von Gura in der Halle der Ehrwürdigen und besiegt dann Gura den Zurückgeforderten.‡고귀한 자의 전당에서 구라의 주문을 사용한 후, 되찾은 자 구라를 꺾어야 합니다. 레벨 32 천둥의 섬‡Usa el conjuro de Gura en la Cámara de los Eminentes y derrota a Gura el Reclamado.‡‡Utilisez l’Incantation de Gura dans la Salles des Exaltés, puis tuez Gura le Repris.‡在至尊殿使用古拉的咒语，然后击败重生的古拉。‡',
  }
},
[32529] = {
  {
    'O chamado do trovão‡Ритуал вызова грома‡Der Ruf des Donners‡천둥의 부름‡El clamor del trueno‡‡L’appel du tonnerre‡雷电的召唤‡',
    nil,
    'Interrompa o ritual dos Arautos do Trovão Shan\'ze. Uma‡Прервите ритуал призывателей грома Шань\'цзэ.‡Unterbrecht das Ritual der Donnerrufer der Shan\'ze.‡샨쩌 천둥술사의 의식을 저지해야 합니다. 레벨 32 천둥의 섬‡Detén el ritual de los clamatruenos Shan\'ze.‡‡Mettez un terme au Rituel des Mande-tonnerre de Shan’ze.‡阻止山泽唤雷者的仪式。‡',
  }
},
[32530] = {
  {
    'O Dessangrador‡Кровопускатель‡Der Blutvergießer‡피를 부르는 자‡El Sádico‡‡Le Saigneur‡放血者‡',
    nil,
    'Mate Kaida, o Dessangrador. Uma‡Убейте Кайду Кровопускателя.‡Tötet Kaida den Blutvergießer.‡피를 부르는 카이다를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a Kaida el Sádico.‡‡Tuez Keida le Saigneur.‡击败放血者喀岱。‡',
  }
},
[32531] = {
  {
    'A conquista de pedra‡Одолеть камень‡Die steinerne Eroberung‡바위 정복‡A la conquista de las piedras‡‡La conquête de pierre‡征服岩石‡',
    nil,
    'Interrompa o ritual do Antigo Conquistador de Pedra no templo principal do Paço dos Ossos. Uma‡Остановите ритуал по оживлению древнего каменного завоевателя в главном храме Двора Костей.‡Unterbrecht das Ritual des uralten Steineroberers im Haupttempel im Hof der Knochen.‡망자의 궁정에 있는 주 사원에서 고대 바위 정복자 의식을 중단시켜야 합니다. 레벨 32 천둥의 섬‡Interrumpe el ritual de los conquistadores de piedra antiguos en el templo principal de El Patio de los Huesos.‡‡Perturbez le rituel de l’Ancien conquérant de pierre dans le temple principal de la Cour des Ossements.‡打断在白骨庭院主殿中举行的古代岩石征服者仪式。‡',
  }
},
[32532] = {
  {
    'Não se levantem mais!‡Покончить с восставшими‡Erhebt Euch nie wieder!‡이제 일어나지 말지어다!‡Almas en pena‡‡Morts pour de bon !‡别再回来了！‡',
    nil,
    'Mate 15 Ancestrais Reanimados. Uma‡Убейте 15 восставших предков.‡Tötet 15 auferstandene Urahnen.‡되살아난 선조 15명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 15 ancestros resucitados.‡‡Tuez 15 Ancêtres ressuscités.‡击败15个复生的先祖。‡',
  }
},
[32533] = {
  {
    'Coração de pedra (e rins, e fígado, e...)‡Каменный холод‡Marmor, Stein und Qilen bricht‡돌처럼 차가운‡Petrificado de miedo‡‡Froid comme la pierre‡冷血石像‡',
    nil,
    'Destrua 8 Guardiões das Tumbas. Uma‡Уничтожьте 8 могильных стражей.‡Zerstört 8 Grabwächter.‡무덤 수호자를 8마리 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye a 8 guardalápidas.‡‡Détruisez 8 Garde-tombes.‡摧毁8个陵寝守卫者。‡',
  }
},
[32534] = {
  {
    'A ameaça Gumeskuma‡Угроза Гнилого Клинка‡Die Skumklingen-Bedrohung‡‡La amenaza Hojaescoria‡‡La menace crasselame‡‡',
    nil,
    'Mate 10 sauroks Gumeskuma. Uma‡Убейте 10 сауроков Гнилого Клинка.‡Tötet 10 Saurok der Skumklingen.‡‡Mata a 10 saurok Hojaescoria.‡‡Tuez 10 Sauroks crasselame.‡‡',
  }
},
[32535] = {
  {
    'A ameaça Gumeskuma‡Угроза Гнилого Клинка‡Die Skumklingen-Bedrohung‡부랑칼날의 위협‡La amenaza Hojaescoria‡‡La menace crasselame‡邪刃的威胁‡',
    nil,
    'Mate 10 sauroks Gumeskuma. Uma‡Убейте 10 сауроков Гнилого Клинка.‡Tötet 10 Saurok der Skumklingen.‡부랑칼날 사우록을 10마리 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 saurok Hojaescoria.‡‡Tuez 10 Sauroks crasselames.‡击败10个邪刃蜥蜴人。‡',
  }
},
[32536] = {
  {
    'Manipulando os sauroks‡Манипулирование сауроками‡Die Saurok manipulieren‡사우록 조종하기‡Cómo manipular a un saurok‡‡La manipulation des sauroks‡掌控蜥蜴人‡',
    nil,
    'Fale com Magíster Yalis, Magíster Lyanis e Magistra Sanal. Uma‡Поговорите с магистрами Ялисом, Лианисом и Саналией.‡Meldet Euch bei Magister Yalis, Magister Lyanis und Magistrix Sanal.‡마법학자 야리스, 마법학자 리아니스, 마법학자 사날을 찾아가야 합니다. 레벨 32 천둥의 섬‡Preséntate ante los magistri Yalis, Lyanis y Sanal.‡‡Présentez-vous au Magistère Yalis, au Magistère Lyanis, et à la Magistrice Sanal.‡向魔导师亚利斯、魔导师莱尼斯和魔导师莎纳尔报到。‡',
  }
},
[32537] = {
  {
    'Esses constructos têm dono‡Возвращение големов‡Dekonstruktion‡사라진 피조물‡Nuestra maquinaria‡‡Dé-construction‡解体‡',
    nil,
    'Recupere os quatro Constructos do Pacto de Prata roubados. Uma‡Верните 4 украденных големов Серебряного Союза.‡Beschafft die vier gestohlenen Konstrukte des Silberbunds wieder.‡도둑맞은 은빛 서약단 피조물을 4개 되찾아야 합니다. 레벨 32 천둥의 섬‡Recupera los cuatro ensamblajes de El Pacto de Plata robados.‡‡Récupérez les quatre Assemblages du Concordat argenté volés.‡夺回4个被偷走的银色盟约构造体。‡',
  }
},
[32538] = {
  {
    'Sacrifício hediondo‡Отвратительные жертвоприношения‡Abscheuliche Opfer‡극악무도한 희생‡Sacrificios bárbaros‡‡Odieux sacrifices‡可憎的献祭‡',
    nil,
    'Destrua os altares sacrificiais dos Zandalari. Uma‡Уничтожьте жертвенные алтари зандаларов.‡Zerstört die Opferaltäre der Zandalari.‡잔달라 희생의 제단을 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye los altares de sacrificios Zandalari.‡‡Détruisez les Autels sacrificiels zandalari.‡摧毁赞达拉祭坛。‡',
  }
},
[32539] = {
  {
    'Oferendas Negras‡Темные подношения‡Finstere Opfergaben‡어둠의 공물‡Ofrendas oscuras‡‡Sombres offrandes‡邪恶供品‡',
    nil,
    'Destrua 6 Oferendas Zandalari. Uma‡Уничтожьте 6 зандаларских подношений.‡Zerstört 6 Zandalariopfergaben.‡잔달라 공물 6개를 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 6 ofrendas Zandalari.‡‡Détruisez 6 Offrandes zandalari.‡摧毁6份赞达拉供品。‡',
  }
},
[32540] = {
  {
    'Arautos dos Loa‡Вестники лоа‡Vorboten der Loa‡로아의 선구자들‡Presagistas de los loa‡‡Messagers des Loas‡神灵先驱‡',
    nil,
    'Mate 2 Arautos dos Loa. Uma‡Победите 2 вестников лоа.‡Tötet 2 Vorboten der Loa.‡로아의 선구자 2명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 2 presagistas de los loa.‡‡Tuez 2 Messagers des Loas.‡消灭2个神灵先驱。‡',
  }
},
[32541] = {
  {
    'Evitando uma ameaça futura‡Предотвращение будущей угрозы‡Einer zukünftigen Bedrohung vorbeugen‡미래의 위험은 미리 위협해야‡Más vale prevenir que curar‡‡Éviter une future menace‡防患未然‡',
    nil,
    'Assuste 12 Filhotes de Gritacéu correndo para perto deles. Uma‡Напугайте 12 детенышей небесного крикуна, бегая мимо них.‡Erschreckt 12 Himmelskreischerjungtiere, indem Ihr in ihre Nähe lauft.‡아기 비명익룡 12마리 주위를 뛰어다녀 겁을 줘야 합니다. 레벨 32 천둥의 섬‡Asusta a 12 proles de vociferador de cielos corriendo cerca de ellas.‡‡Effrayez 12 Bébés hurleciel en courant près d’eux.‡在12只啸天雏龙身边奔跑以惊吓它们。‡',
  }
},
[32542] = {
  {
    'Ataque preciso‡Оперативный удар‡Angriff mit chirurgischer Präzision‡해결사가 왔노라‡Ataque letal‡‡Frappe chirurgicale‡手术式打击‡',
    nil,
    'Mate 3 Amarra-espíritos Zandalari, 3 Chama-feras Zandalari e 3 Guerreiros Jaguar Zandalari. Uma‡Убейте 3 зандаларских душеловов, 3 зандаларских заклинателей зверей и 3 зандаларских воинов-ягуаров.‡Tötet 3 Geisterbinder der Zandalari, 3 Bestienrufer der Zandalari und 3 Jaguarkrieger der Zandalari.‡잔달라 영혼결속자 3명, 잔달라 야수소환사 3명, 그리고 잔달라 재규어 전사 3명을 처치해야 합니다.‡Mata a 3 vinculadores de espíritus Zandalari, a 3 clamabestias Zandalari y a 3 guerreros jaguar Zandalari.‡‡Tuez 3 Lieurs d’esprit zandalari, 3 Mande-bêtes zandalari et 3 Guerriers jaguar zandalari.‡击败3名赞达拉缚灵者、3名赞达拉驭兽师和3名赞达拉丛林豹战士。‡',
  }
},
[32543] = {
  {
    'Perigos de Za\'Tual‡Опасности За\'Туала‡Gefahren von Za\'Tual‡자투알에 도사리는 위험‡Los peligros de Za\'Tual‡‡Les dangers de Za’Tual‡赞图尔的危机‡',
    nil,
    'Mate 12 Trolls em Za\'Tual. Uma‡Убейте 12 троллей в За\'Туале.‡Tötet 12 Trolle in Za\'Tual.‡자투알에서 트롤 12명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 12 trols en Za\'Tual.‡‡Tuez 12 Trolls dans Za’Tual.‡在赞图尔消灭12名巨魔。‡',
  }
},
[32544] = {
  {
    'Pterrível Ptormento‡Измученный птеродактиль‡Kreischen vor Qualen‡끔찍한 고문‡Un ptormento pterrible‡‡Pterrible ptourment‡苦痛折磨‡',
    nil,
    'Liberte o Gritacéu Atormentado. Uma‡Освободите измученного небесного крикуна.‡Befreit den gepeinigten Himmelskreischer.‡고문당한 비명익룡을 풀어줘야 합니다. 레벨 32 천둥의 섬‡Libera al vociferador de cielos atormentado.‡‡Libérez le Hurleciel tourmenté.‡解救痛苦的啸天龙。‡',
  }
},
[32545] = {
  {
    'Os moradores de Ihgaluk‡Обитатели утесов Ихгалук‡Die Bewohner von Ihgaluk‡이갈룩의 주민‡Los habitantes de Ihgaluk‡‡Les habitants d’Ihgaluk‡伊瓜鲁克的住民‡',
    nil,
    'Mate um Bruto Gumeskuma, um Sacerdote-sáurio Gumeskuma e um Dragão-marinho Gumeskuma. Uma‡Убейте громилу Гнилого Клинка, сауро-жреца Гнилого Клинка и рассекателя волн Гнилого Клинка.‡Tötet einen Schläger der Skumklingen, einen Saurierpriester der Skumklingen und einen Meerdrachen der Skumklingen.‡부랑칼날 투사, 부랑칼날 공룡사제, 부랑칼날 바다도마뱀을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a un tosco Hojaescoria, a un sacerdote saurio Hojaescoria y a un dragón marino Hojaescoria.‡‡Tuez une Brute crasselame, un Prêtre-saure crasselame et un Dragon de mer crasselame.‡击败1个邪刃蛮兵、1个邪刃蜥首牧师和1个邪刃海龙战士。‡',
  }
},
[32546] = {
  {
    'Só um trabalho leve de limpeza‡Небольшая чистка‡Nur leichte Aufräumarbeiten‡단순 청소 작업‡Hay que ensuciarse las manos de vez en cuando‡‡Un peu de nettoyage‡清洁工作‡',
    nil,
    'Espalhe 75 pedaços de sujeira matando a Imundície Trêmula no Penhasco Ihgaluk. Uma‡Уничтожьте 75 частиц дрожащей гнили на утесах Ихгалук.‡Zerstreut 75 Dreckstücke, indem Ihr den wabernden Dreck in der Ihgalukklamm tötet.‡이갈룩 바위산에서 벌벌떠는 구린액을 처치해 구린액 방울을 75개 흩뜨려야 합니다. 레벨 32 천둥의 섬‡Dispersa 75 montones de basura matando a inmundicias temblorosas en el Risco Ihgaluk.‡‡Dispersez 75 tas d’ordures en tuant des Crasses tremblantes dans la Combe d’Ihgaluk.‡击败伊瓜鲁克峭壁的颤栗污泥怪以分解75块污物。‡',
  }
},
[32547] = {
  {
    'O carpete rastejante de Ihgaluk‡Кишащий насекомыми Ихгалук‡Die krabbelnde Decke auf Ihgaluk‡이갈룩의 스멀거리는 양탄자‡La cucaracha de Ihgaluk ya no puede caminar‡‡Le tapis rampant d\'Ihgaluk‡伊瓜鲁克的恐怖地毯‡',
    nil,
    'Esmague 75 Baratas Ihgaluk. Uma‡Раздавите 75 тараканов Ихгалук.‡Zerquetscht 75 Ihgaluk-Schaben.‡이갈룩 바퀴를 75마리 뭉개야 합니다. 레벨 32 천둥의 섬‡Aplasta a 75 cucarachas Ihgaluk.‡‡Écrasez 75 Cafards d’Ihgaluk.‡踩死75只伊瓜鲁克蟑螂。‡',
  }
},
[32548] = {
  {
    'Apodrecendo‡Оставленное гнить‡Verrotten lassen‡썩도록 방치된‡No hay que desperdiciar la comida‡‡Laissé à pourrir‡任其腐烂‡',
    nil,
    'Destrua 3 Amontoados de Carne Fétida. Uma‡Уничтожьте 3 зловонные кучи мяса.‡Zerstört 3 faulige Fleischhaufen.‡악취나는 고기 더미를 3개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 3 montones de carne fétida.‡‡Détruisez 3 Piles de viande fétide.‡摧毁3堆恶臭肉堆。‡',
  }
},
[32549] = {
  {
    'Pele dos sauroks‡В шкуре саурока‡In der Haut eines Saurok‡사우록의 거죽‡En la piel de un saurok‡‡La peau des sauroks‡蜥蜴人的皮‡',
    nil,
    'Vá até o Penhasco Ihgaluk e mate um saurok Gumeskuma. Uma‡Отправляйтесь на утесы Ихгалук и убейте саурока Гнилого Клинка.‡Begebt Euch zur Ihgalukklamm und tötet einen Skumklingensaurok.‡이갈룩 바위산으로 가서 부랑칼날 사우록을 한 마리 처치해야 합니다. 레벨 32 천둥의 섬‡Ve al Risco Ihgaluk y mata a un saurok Hojaescoria.‡‡Allez à la Combe d’Ihgaluk et tuez un Saurok crasselame.‡前往伊瓜鲁克峭壁并消灭一名邪刃蜥蜴人。‡',
  }
},
[32550] = {
  {
    'Sáurio perdedor‡Расправа‡Verechst und zugenäht‡공룡이 너무해‡Un mal "necesaurio"‡‡Vilaines bestioles‡纵龙者‡',
    nil,
    'Derrote 10 trolls Zandalari no Cercado das Feras. Uma‡Убейте 10 зандаларских троллей в загонах для зверей.‡Bezwingt 10 Trolle der Zandalari in den Bestienpferchen.‡야수 조련소에서 잔달라 트롤 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Derrota a 10 trols Zandalari en El Cerco de las Bestias.‡‡Tuez 10 Trolls zandalari dans les Enclos à bêtes.‡在兽栏中击败的10名赞达拉巨魔。‡',
  }
},
[32551] = {
  {
    'Pisada de dino‡Компот из компсогната‡Compyknüppler‡야수 처치‡Matanza jurásica‡‡Compicide‡践踏掠食龙‡',
    nil,
    'Mate 5 Raptores e 10 Saurídeos Treinados no Cercado das Feras. Uma‡Убейте 5 ящеров и 10 дрессированных сауридов в загонах для ящеров.‡Tötet 5 Raptoren und 10 abgerichtete Sauriden in den Bestienpferchen.‡야수 조련소에 있는 랩터 5마리와 훈련된 사우리드 10마리를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 5 raptores y a 10 sáuridos adiestrados en El Cerco de las Bestias.‡‡Tuez 5 Raptors et 10 Saurides apprivoisés dans les Enclos à bêtes.‡在兽栏消灭5只迅猛龙和10只训练有素的掠食龙。‡',
  }
},
[32552] = {
  {
    'Loassauro‡Лоа-завр‡Loasaurus‡로아가 깃든 야수‡Hechizos muy poco loa-bles‡‡Loa-saure‡神龙‡',
    nil,
    'Derrote um Voz-dos-loas. Uma‡Победите говорящего с лоа.‡Bezwingt einen Loasprecher.‡로아 전령을 처치해야 합니다. 레벨 32 천둥의 섬‡Derrota a un portavoz loa.‡‡Battez un Parle-loa.‡击败一名神谕者。‡',
  }
},
[32553] = {
  {
    'Demossauro x Escornante‡Дикорог или дьявозавр‡Terrorhorn vs. Teufelssaurier‡공포뿔이냐 데빌사우루스냐‡Cuernoatroz contra demosaurio‡‡Navrecorne contre diablosaure‡恐角龙大战魔暴龙‡',
    nil,
    'Interrompa um ritual de vinculação matando todos os PNJs ao redor de um Escornante Teimoso ou de um Demossauro Teimoso. Uma‡Прервите подчиняющий ритуал, убив всех неигровых персонажей вокруг непокорного дикорога или непокорного дьявозавра.‡Unterbrecht ein Bindungsritual, indem Ihr alle Trolle tötet, die ein starrsinniges Terrorhorn oder einen widerspenstigen Teufelssaurier umringen.‡반항적인 공포뿔이나 반항적인 데빌사우루스 주변에 있는 잔달라 트롤들을 모두 처치해 결속 의식을 방해해야 합니다.‡Interrumpe un ritual de vinculación matando a todos los PNJ que estén alrededor de un cuernoatroz desafiante o de un demosaurio desafiante.‡‡Interrompez un Rituel de lien en tuant tous les participants au rituel autour d’un Navrecorne défiant ou d’un Diablosaure défiant. Un(e) quête.‡击败傲慢的恐角龙或傲慢的魔暴龙身边的所有NPC以扰乱束缚仪式。‡',
  }
},
[32554] = {
  {
    'Poder dino‡Мощь динозавра‡Saurierstark‡강력한 공룡‡Fuerza jurásica‡‡Dino mythe‡史前巨兽‡',
    nil,
    'Encontre e use Fetiches Sáurios em 5 raptores, dinos, gritacéus ou escornantes no Cercado das Feras. Uma‡Найдите и используйте заврофетиши на 5 ящерах, компсогнатах, небесных крикунах или дикорогах в загонах для зверей.‡Findet Saurierfetische und wendet sie auf 5 Raptoren, Compys, Himmelskreischer oder Terrorhörner in den Bestienpferchen an.‡사우루스 우상을 찾아서 야수 조련소에 있는 랩터나 콤피, 비명익룡 또는 공포뿔 5마리에게 사용해야 합니다.‡Encuentra y utiliza fetiches saurios en 5 raptores, minirraptores, vociferadores de cielos o cuernoatroces en El Cerco de las Bestias. Un(a) misión.‡‡Trouvez et utilisez des Fétiches de saurien sur 5 Raptors, Compies, Hurleciel ou Navrecornes dans les Enclos à bêtes.‡找到并对兽栏中的5只迅猛龙、掠食龙、啸天龙或恐角龙使用恐龙神像。‡',
  }
},
[32555] = {
  {
    'Séculos de sentinela‡Вековые стражи‡Jahrhundertwachen‡보초병 안에서 수백 년을‡¡Que no escapen!‡‡Sentinelles des siècles‡世代戍守‡',
    nil,
    'Mate 5 Sentinelas Almatadas e use o Cristal de Ressonância para capturar os espíritos Zandalari presos nelas. Uma‡Уничтожьте 5 питаемых духом стражей и воспользуйтесь резонирующим кристаллом, чтобы вытянуть из них духов зандаларов.‡Zerstört 5 geist-gebundene Wachposten und nutzt den Resonanzkristall, um die in ihnen gefangenen Zandalarigeister einzusammeln.‡영혼결속 보초병 5명을 처치하고 그 안에 갇힌 잔달라 영혼을 공명의 수정으로 포획해야 합니다. 레벨 32 천둥의 섬‡Mata a 5 avizores vinculados a espíritus y utiliza el cristal de resonancia para capturar a los espíritus Zandalari que hay atrapados en ellos.‡‡Tuez 5 Factionnaires liés par les esprits, puis utilisez le Cristal de résonance pour capturer les Esprits zandalari piégés à l’intérieur.‡消灭5名缚灵哨兵，并使用共振水晶捕捉被禁锢在哨兵中的赞达拉巨魔灵魂。‡',
  }
},
[32556] = {
  {
    'Quanto mais você sabe‡Чем больше ты знаешь…‡Wissenssammlung‡적을 알면 이긴다‡El saber no ocupa lugar‡‡Plus vous en savez‡知己知彼‡',
    nil,
    'Colete 6 Artefatos Ritualísticos do Terraço do Conquistador. Uma‡Принесите 6 ритуальных артефактов с Террасы Завоевателя.‡Sammelt in der Gegend um die Terrasse des Eroberers 6 Ritualartefakte ein.‡정복자의 정원 근처에서 의식용 유물 6개를 획득해야 합니다. 레벨 32 천둥의 섬‡Recupera 6 artefactos de ritual en la Platea del Conquistador.‡‡Récupérez 6 Artéfacts de rituel aux alentours de la Terrasse des Conquérants.‡在征服者平台附近找回6个仪式神器。‡',
  }
},
[32557] = {
  {
    'Longe das mãos inimigas‡Обезоружить врага‡Feindeshänden entrissen‡적의 손 밖으로‡Se va a armar una buena‡‡Hors des griffes de l’ennemi‡夺自敌手‡',
    nil,
    'Roube 7 Lâminas Imbuídas em Loa do Terraço do Conquistador. Uma‡Выкрадите 7 усиленных лоа клинков с Террасы Завоевателя.‡Stehlt 7 loabeseelte Klingen von der Terrasse des Eroberers.‡정복자의 정원에서 로아가 주입된 검 7개를 훔쳐야 합니다. 레벨 32 천둥의 섬‡Roba 7 hojas imbuidas de los loa en la Platea del Conquistador.‡‡Volez 7 Lames imprégnées par les Loas sur la Terrasse des Conquérants.‡从征服者平台偷取7把灌注神力的利刃。‡',
  }
},
[32558] = {
  {
    'A família inteira‡Все в семью‡Familienangelegenheit‡가문의 가면‡La familia‡‡Une famille formidable‡不得外传‡',
    nil,
    'Recupere a Máscara do Místico Sombrio e a Máscara do Chama-espíritos do Amarra-espírito Tu\'chek e do Arcanital Ra\'kul no Terraço do Conquistador.‡Отнимите маску темного мистика и маску призывателя духов у душелова Ту\'чека и ритуалиста Рак\'ула на Терассе Завоевателя.‡Entwendet Geisterbinder Tu\'chek und Arkanital Ra\'kul auf der Terrasse des Eroberers die Maske des dunklen Mystikers und die Maske des Geisterrufers.‡정복자의 정원에 있는 영혼결속자 투첵과 비전주술사 라쿨에게서 암흑 비술사의 가면과 영혼소환사의 가면을 획득해야 합니다.‡Recupera la máscara del místico oscuro y la máscara del clamaespíritus del vinculador de espíritus Tu\'chek y del arcanital Ra\'kul en la Platea del Conquistador.‡‡Récupérez le Masque du sombre mystique et le Masque du mande-esprits sur le Lieur d’esprit Tu’chek et sur le Rituarcaniste Ra’kul, sur la Terrasse des Conquérants.‡从征服者平台的缚灵者图切克和魔术士拉古尔处夺取黑暗秘法面具和唤魂者面具。‡',
  }
},
[32559] = {
  {
    'Maior o gigante, maior a queda‡Даже великанам приходит конец‡Gigantische Zerstörung‡거인도 쓰러진다‡Lucha de gigantes‡‡Même les géants tombent‡巨人的陨殁‡',
    nil,
    'Destrua o Guardião Tak\'u no Terraço do Conquistador. Uma‡Уничтожьте стража Та\'ку на Террасе Завоевателя.‡Zerstört Wächter Tak\'u auf der Terrasse des Eroberers.‡정복자의 정원에 있는 수호자 탁쿠를 쓰러뜨려야 합니다. 레벨 32 천둥의 섬‡Destruye al guardián Tak\'u en la Platea del Conquistador.‡‡Détruisez le Gardien Tak’u sur la Terrasse des Conquérants.‡在征服者平台消灭守护者塔克乌。‡',
  }
},
[32560] = {
  {
    'Só entre nós‡Хранить в тайне‡Wahrt das Geheimnis‡아무도 모르게‡No se lo digas a nadie‡‡Garder le secret‡保守秘密‡',
    nil,
    'Mate 8 trolls Zandalari de qualquer tipo no Terraço do Conquistador. Uma‡Убейте 8 зандаларских троллей на Террасе Завоевателя.‡Tötet 8 Trolle der Zandalari jeglicher Art auf der Terrasse des Eroberers.‡정복자의 정원에 있는 잔달라 트롤 8명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 8 trols Zandalari cualesquiera en la Platea del Conquistador.‡‡Tuez 8 Trolls zandalari sur la Terrasse des Conquérants.‡在征服者平台消灭任意8名赞达拉巨魔。‡',
  }
},
[32561] = {
