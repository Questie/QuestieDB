},
[29874] = {
  {
    'Kang Cajado Espinhoso‡Кан Ежевичный Посох‡Kang Dornstab‡캉 브램블스태프‡Kang Vara Enzarzada‡‡Kang Bâton de Roncier‡康·棘杖‡',
    nil,
    'Encontre Kang Cajado Espinhoso. Uma‡Разыщите Кана Ежевичного Посоха.‡Sucht Kang Dornstab.‡캉 브램블스태프를 찾아야 합니다. 레벨 15 크라사랑 밀림‡Encuentra a Kang Vara Enzarzada.‡‡Trouvez Kang Bâton de Roncier.‡找到康·棘杖。‡',
