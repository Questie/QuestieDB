},
[31275] = {
  {
    'LFGDungeons - Mists - Raid Finder - Nth‡LFGDungeons - Mists - Raid Finder - Nth‡LFGDungeons - Mists - Raid Finder - Nth‡LFGDungeons - Mists - Raid Finder - Nth‡Buscador de bandas (Nº)‡‡LFGDungeons - Mists - Raid Finder - Nth‡团队查找器（第N次）‡',
