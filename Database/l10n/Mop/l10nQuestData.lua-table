[5672] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Élune‡艾露恩的赐福‡伊露恩的賜福',
    nil,
    '‡Поговорите в Дарнасе со жрицей Алатеей.‡Sprecht mit der Priesterin Alathea in Darnassus.‡다르나서스에 있는 여사제 알라시아와 대화해야 합니다.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Parler à la prêtresse Alathea à Darnassus.‡与达纳苏斯的女祭司阿兰希雅谈一谈。‡',
  }
},
[5673] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Élune‡艾露恩的赐福‡伊露恩的賜福',
    nil,
    'Fale com a Sacerdotisa Alathea em Darnassus.‡Поговорите в Дарнасе со жрицей Алатеей.‡Sprecht mit der Priesterin Alathea in Darnassus.‡다르나서스에 있는 여사제 알라시아와 대화해야 합니다.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Parler à la prêtresse Alathea à Darnassus.‡与达纳苏斯的女祭司阿兰希雅谈一谈。‡與達納蘇斯的女祭司阿蘭希雅談話。',
  }
},
[5674] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Élune‡艾露恩的赐福‡伊露恩的賜福',
