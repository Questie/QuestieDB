[25531] = {
  {
    'A revolta do Crepúsculo‡Бунт Сумеречного Молота‡Zwielichtaufstand‡황혼의 폭동‡Motín Crepuscular‡Motín Crepuscular‡La révolte des sectateurs‡暮光暴动‡暮光暴動',
    nil,
    'Fale com Jared Cantonegro nos Portões de Sothann, em Hyjal.‡Поговорите с Джеродом Песнью Теней у Врат Созанна.‡Sprecht mit Jarod Schattensang an den Toren von Sothann auf dem Hyjal.‡하이잘의 소단 관문에 있는 제로드 섀도송과 대화해야 합니다.‡Habla con Jarod Cantosombrío en las Puertas de Sothann en Hyjal.‡Habla con Jarod Cantosombrío en las Puertas de Sothann en Hyjal.‡Parlez à Jarod Chantelombre aux Portes de Sothann, à Hyjal.‡跟海加尔山索萨恩之门的加洛德·影歌谈一谈。‡去海加爾的索桑恩之門找亞羅德‧影歌說話。',
  }
},
[25532] = {
  {
    'Piratas bons de mira‡Пираты пристрелялись‡Verbesserte Piratenpräzision‡해적의 조준 실력은 향상 중‡Precisión de pirata en aumento‡Precisión de pirata en aumento‡À boulets rouges‡海盗的精准度上升了‡海賊精準度提高',
    nil,
    'Peça uma barcaça a Mazzeu Aparafuzzo e apague 15 focos de incêndio usando o Canhão de Gelo.‡Возьмите гоночное судно у Маззера Винтодера и потушите при помощи морозной пушки 15 очагов возгорания.‡Holt von Mazzer Schrottschrauber ein Rennboot und benutzt die Frostkanone, um 15 Feuer zu löschen.‡마제르 스트립스크류에게서 거룻배를 얻은 후 서리 대포로 15개의 불을 꺼야 합니다.‡Coge un barco fluvial de Mazzer Quitaclavos y utiliza el Cañón de escarcha para apagar 15 fuegos.‡Coge un barco fluvial de Mazzer Quitaclavos y utiliza el Cañón de escarcha para apagar 15 fuegos.‡Obtenez un Bateau fluvial auprès de Mazzer Décapécrou et utilisez le Canon de givre pour éteindre 15 feux.‡从玛兹尔·螺钉那儿拿到赛艇，并用冰霜大炮扑灭15处大火。‡從瑪瑟爾·撕啼那兒取得一艘河艇，然後使用冰霜大砲撲滅15處火災。',
  }
},
[25533] = {
  {
    'Piratas bons de mira‡Пираты пристрелялись‡Verbesserte Piratenpräzision‡해적의 조준 실력은 향상 중‡Precisión de pirata en aumento‡Precisión de pirata en aumento‡À boulets rouges‡海盗的精准度上升了‡海賊精準度提高',
    nil,
    'Peça uma barcaça a Griznak e apague 15 focos de incêndio usando o Canhão de Gelo.‡Возьмите гоночное судно у Гризнака и потушите при помощи морозной пушки 15 очагов возгорания.‡Holt von Griznak ein Rennboot und benutzt die Frostkanone, um 15 Feuer zu löschen.‡그리즈낙에게서 거룻배를 얻은 후 서리 대포로 15개의 불을 꺼야 합니다.‡Coge un barco fluvial de Griznak y utiliza el Cañón de escarcha para apagar 15 fuegos.‡Coge un barco fluvial de Griznak y utiliza el Cañón de escarcha para apagar 15 fuegos.‡Obtenez un Bateau fluvial auprès de Griznak et utilisez le Canon de givre pour éteindre 15 feux.‡从格里兹纳克那儿拿到赛艇，并用冰霜大炮扑灭15处大火。‡從格里茲納克那兒取得一艘河艇，然後使用冰霜大砲撲滅15處火災。',
  }
},
[25534] = {
  {
    'Nada mais de capataz‡Побочная задача‡Genug gebrüllt‡작업반장 처치‡A por el capataz‡A por el capataz‡Danse avec les tirs‡不听管教‡無心工作',
    nil,
    'Mate o Capataz dos Mares do Sul.‡Убейте десятника Южных морей.‡Tötet den Zuchtmeister der Südmeerfreibeuter.‡남쪽바다 작업반장을 처치해야 합니다.‡Mata al capataz de los Mares del Sur.‡Mata al capataz de los Mares del Sur.‡Tuez le Sous-chef des mers du Sud.‡杀掉南海工头。‡殺死南海監工。',
  }
},
[25535] = {
  {
    'É comer ou morrer‡Накормить голодных‡Hunger‡먹어야 할 강한 필요성‡Una urgente necesidad alimenticia‡Una urgente necesidad alimenticia‡Un besoin impérieux de manger‡强烈的饥饿感‡強烈食慾',
    nil,
    'Fale com o Mestre de Mergulho Beltrame, no Abismo das Profundezas Cintilantes.‡Поговорите с инструктором ныряльщиков Бирмингемом в Теснине Мерцающих Глубин.‡Sprecht mit Tauchbegleiter Birmingham in der Glimmertiefenschlucht.‡흐린심연 골짜기에 있는 전문잠수부 버밍험과 대화해야 합니다.‡Habla con el maestro de buceo Birmingham en el Barranco Brillohondo.‡Habla con el maestro de buceo Birmingham en el Barranco Brillohondo.‡Parlez au Maître de plongée Birmingham dans la Gorge du Gouffre scintillant.‡跟光渊峡谷的潜水大师伯明翰谈一谈。‡到深光峽谷裡去和潛水高手伯明汗說話。',
  }
},
[25536] = {
  {
    'Gélidas boas-vindas‡Прохладный прием‡Ein feuchter Händedruck‡차가운 환대‡Una fría bienvenida‡Una fría bienvenida‡Un accueil glacial‡冷遇‡相迎如冰',
    nil,
    'Mate 10 Caçamarés das Profundezas Cintilantes.‡Убейте 10 волноловов Мерцающих Глубин.‡Tötet 10 Gezeitenjäger der Glimmertiefen.‡흐린심연 바다사냥꾼을 10마리 처치해야 합니다.‡Mata a 10 cazamareas Brillohondo.‡Mata a 10 cazamareas Brillohondo.‡Tuez 10 Chasse-marées du gouffre Scintillant.‡消灭10名光渊潮汐猎手。‡消滅10名深光獵潮魚人。',
  }
},
[25537] = {
  {
    'A arte da atração‡Искусство притяжения‡Die Kunst der Anlockung‡인력의 기술‡El arte de la atracción‡El arte de la atracción‡L’art de l’attraction‡吸引力的艺术‡誘惑的藝術',
    nil,
    'Use o Dispositivo de Extração de Químicos de Anêmona para coletar 8 Amostras Químicas de Anêmona das anêmonas vermelhas, encontradas das paredes do Abismo das Profundezas Cintilantes.‡C помощью пробоотборника для анемонов соберите 8 химических образцов с красных анемонов, растущих вдоль стен Теснины Мерцающих Глубин.‡Benutzt die Extraktionsapparatur für Anemonenchemikalien, um 8 chemische Anemonenproben von den roten Anemonen entlang der Wände der Glimmertiefenschlucht zu sammeln.‡말미잘 화학물질 추출 장치를 사용해 흐린심연 골짜기 벽을 따라 있는 붉은 말미잘로부터 말미잘 화학 물질 8개를 모아야 합니다.‡Utiliza el dispositivo de extracción de químicos de anémona para obtener 8 muestras de químicos de anémona de las anémonas rojas que crecen por las paredes del Barranco Brillohondo.‡Utiliza el dispositivo de extracción de químicos de anémona para obtener 8 muestras de químicos de anémona de las anémonas rojas que crecen por las paredes del Barranco Brillohondo.‡Utilisez l’Extracteur de substance chimique d’anémone pour récolter 8 Échantillons de substance chimique d’anémone sur les anémones poussant le long des murs de la Gorge du Gouffre scintillant.‡使用海葵化合萃取装置，在光渊峡谷围墙附近的红色海葵花上收集8份海葵化合物样本。‡使用海葵化學物質萃取裝置，從深光峽谷周邊的紅色海葵那裡收集8份海葵化學物質樣本。',
  }
},
[25538] = {
  {
    'Aromatização subaquática‡Распылитель‡Geruchsverschleierung‡냄새 뿌리기‡Cubreolores‡Cubreolores‡Aspersoir à fragrance‡涂味器‡香氣大衣',
    nil,
    'Use o Dispositivo de Aplicação de Químicos de Anêmona em 8 Mergulhadores de Marisco.‡Обработайте анемоновым распылителем 8 ныряльщиков.‡Benutzt die Applikationsapparatur für Anemonenchemikalien an 8 Muscheltauchern.‡말미잘 화학물질 적용 장치를 조개잡이 잠수부 8명에게 사용해야 합니다.‡Aplica el dispositivo de aplicación de químicos de anémona a 8 buceadores Brillohondo.‡Aplica el dispositivo de aplicación de químicos de anémona a 8 buceadores Brillohondo.‡Utilisez le Pulvérisateur à substance chimique d’anémone sur 8 Plongeurs.‡对8名采蚌人使用海葵化合应用装置。‡將海葵化學物質使用裝置使用在8名採蚌員身上。',
  }
},
[25539] = {
  {
    'Caça aos mariscos‡Сбор моллюсков‡Abgetaucht‡조개잡이‡A por almejas‡A por almejas‡La kermesse aux palourdes‡少说多捞‡採蚌',
    nil,
    'Colete 16 Mariscos Brilhofundos.‡Соберите 16 моллюсков Мерцающих Глубин.‡Sammelt 16 Glimmertiefenmuscheln.‡흐린심연 조개 16개를 모아야 합니다.‡Recoge 16 almejas Brillohondo.‡Recoge 16 almejas Brillohondo.‡Récoltez 16 Palourdes du gouffre Scintillant.‡收集16扇光渊蚌。‡收集16個深光蚌。',
  }
},
[25540] = {
  {
    'Estômagos me mordam‡Голодные рты ждут‡Hungrige Mäuler warten‡위장이 기다린다‡Los estómagos aguardan‡Los estómagos aguardan‡Ventre affamé n\'a point de patience‡肚子空着‡嗷嗷待哺',
    nil,
    'Leve o Saco Pesado de Mariscos de volta para a Praia Tranquila.‡Отнесите огромный мешок моллюсков в Тихий залив.‡Bringt den großen Sack Muscheln zum Stillen Strand.‡평온의 침식지로 무거운 조개 자루를 가져가야 합니다.‡Lleva el saco de almejas pesado a la Estela Tranquila.‡Lleva el saco de almejas pesado a la Estela Tranquila.‡Apportez l’Énorme sac de palourdes au Reflux Tranquille.‡将一大袋蛤蚌带回静谧海滩。‡將一袋沈重的蚌肉帶回寧靜港灣。',
  }
},
[25541] = {
  {
    'Enchendo os bolsos‡Требуются пломбы‡Wir füllen uns die Taschen‡주머니 채우기‡Se necesitan empastes‡Se necesitan empastes‡Une histoire de plombage‡填满我们的口袋‡裝滿我們的袋子',
    nil,
    'Consiga 20 Obturações de Ouro dos Mosqueteiros dos Mares do Sul ou dos Capangas dos Mares do Sul.‡Соберите 20 золотых коронок мушкетеров или силачей Южных морей.‡Sammelt 20 Goldfüllungen von den Musketieren der Südmeerfreibeuter oder den Schlägern der Südmeerfreibeuter.‡남쪽바다 총병 또는 남쪽바다 폭력배에게서 황금 충전재료 20개를 수집해야 합니다.‡Reúne 20 empastes de oro de mosqueteros de los Mares del Sur o de forzudos de los Mares del Sur.‡Reúne 20 empastes de oro de mosqueteros de los Mares del Sur o de forzudos de los Mares del Sur.‡Récupérez 20 « Plombages » en or sur des Mousquetaires des mers du Sud ou sur des Hommes de main des mers du Sud.‡从南海火枪手和南海勇夫身上获得20份金料。‡從南海火槍手與南海惡棍身上收集20個黃金填料。',
  }
},
[25542] = {
  {
    'Pula, pirata!‡На оборону дилижанса... то есть лодки!‡Die Wägen - äh, Boote - einkreisen‡마차를... 아니, 배를 돌려라‡Un círculo con las carretas... eh, los barcos‡Rodea las carretas... eh, las barcas‡Le cercle des chaloupes disparues‡严阵以待……呃，水阵‡包圍那些貨車...呃，船',
    nil,
    'Afunde 15 Barcos a Remo dos Mares do Sul.‡Потопите 15 шлюпок Южных морей.‡Versenkt 15 Ruderboote der Südmeerfreibeuter.‡나룻배 15척을 침몰시켜야 합니다.‡Hunde 15 botes de remos de los Mares del Sur.‡Hunde 15 botes de remos de los Mares del Sur.‡Coulez 15 Chaloupes des mers du Sud.‡击沉15艘南海划艇。‡擊沉15艘南海小艇。',
  }
},
[25543] = {
  {
    'Pula, pirata!‡На оборону дилижанса... то есть лодки!‡Die Wägen - äh, Boote - einkreisen‡마차를... 아니, 배를 돌려라‡Rodea las carretas... eh, las barcas‡Rodea las carretas... eh, las barcas‡Le cercle des chaloupes disparues‡严阵以待……呃，水阵‡包圍那些貨車...呃，船',
    nil,
    'Afunde 15 Barcos a Remo dos Mares do Sul.‡Потопите 15 шлюпок Южных морей.‡Versenkt 15 Ruderboote der Südmeerfreibeuter.‡나룻배 15척을 침몰시켜야 합니다.‡Hunde 15 botes de remos de los Mares del Sur.‡Hunde 15 botes de remos de los Mares del Sur.‡Coulez 15 Chaloupes des mers du Sud.‡击沉15艘南海划艇。‡弄沉15艘南海小艇。',
  }
},
[25544] = {
  {
    'Segunda leva‡По копьям!‡Die zweite Welle‡두 번째 실전 비행‡Segunda oleada‡Segunda oleada‡Deuxième vague‡第二波‡第二波',
    nil,
    'Equipe-se com uma Lança-de-fogo Crepuscular e voe no Guardião de Aviana. Mate 10 Lanceiros Crepúsculo voando para cima deles. Clique no botão de Bater Asas para que sua montaria bata as asas!‡Вооружитесь Огненным копьем Сумеречного Молота и взлетите на одном из защитников Авианы. Убейте 10 сумеречных копейщиков, налетев на них. Нажимайте кнопку "Взмах", чтобы лететь.‡Legt eine Zwielichtfeuerlanze an und fliegt Avianas Wächter. Tötet 10 Zwielichttjoster, indem Ihr in sie hineinfliegt. Drückt die Taste \'Flattern\', damit Euer Reittier mit den Flügeln schlägt!‡황혼의 화염창을 장착하고 아비아나의 수호자를 타십시오. 화염창을 들고 돌진하여 황혼의 창기병 10명을 처치해야 합니다. 날갯짓 버튼을 눌러 탈것의 날개를 퍼덕이십시오!‡Equipa una flamanza Crepuscular y vuela en un guardián de Aviana. Mata a 10 lanceros Crepusculares volando contra ellos. ¡Pulsa el botón Aletear para agitar las alas de tu montura!‡Equipa una flamanza Crepuscular y vuela en un guardián de Aviana. Mata a 10 lanceros Crepusculares volando contra ellos. ¡Pulsa el botón Aletear para agitar las alas de tu montura!‡Empoignez une Lance de feu du crépuscule et enfourchez un Gardien d’Aviana. Tuez 10 Lanciers du Crépuscule en les chargeant. Cliquez sur l’icône Battre des ailes pour que votre monture se mette à voler !‡装备一把暮光火焰长枪，乘坐艾维娜的守护者出击。向10个暮光枪兵进行冲撞以击落他们。按下“拍翼”按钮以控制你的坐骑扇动翅膀！‡裝配暮光火矛並乘上艾維娜的守護者飛行。衝進去消滅10個暮光持矛者。按「振翅」鈕讓你的坐騎拍翅膀!',
  }
},
[25545] = {
  {
    'Às armas!‡Во всеоружии‡Zu den Waffen!‡싸우자!‡¡A las armas!‡¡A las armas!‡Aux armes !‡备战！‡作戰!',
    nil,
    'Colete 4 Lanças de Ventobravo, 4 Peitorais de Ventobravo, 4 Escudos de Ventobravo e 4 Elmos de Ventobravo.|n|nO equipamento também pode ser coletado de Catadores Guelblins.‡Подберите со дна 4 копья Штормграда, 4 кирасы Штормграда, 4 щита Штормграда и 4 шлема Штормграда.|n|nСнаряжение также можно забрать у падальщиков жаблинов.‡Sammelt 4 Speere von Sturmwind, 4 Brustplatten von Sturmwind, 4 Schilde von Sturmwind und 4 Helme von Sturmwind.|n|nIhr könnt die Ausrüstung auch von Strauchdieben der Gilblin sammeln.‡스톰윈드 창 4자루, 스톰윈드 가슴보호갑 4벌, 스톰윈드 방패 4개, 스톰윈드 투구 4개를 모아야 합니다.|n|n길블린 청소부에게서도 장비를 구할 수 있습니다.‡Recoge 4 lanzas de Ventormenta, 4 corazas de Ventormenta, 4 escudos de Ventormenta y 4 yelmos de Ventormenta.|n|nTambién puedes obtener el equipo de los carroñeros Gilblin.‡Recoge 4 lanzas de Ventormenta, 4 corazas de Ventormenta, 4 escudos de Ventormenta y 4 yelmos de Ventormenta.|n|nTambién puedes obtener el equipo de los carroñeros Gilblin.‡Rassemblez 4 Lances, 4 Cuirasses, 4 Boucliers et 4 Heaumes de Hurlevent.|n|nCet équipement peut aussi être trouvé sur des Charognards gloubelins.‡收集4支暴风城长矛、4件暴风城胸甲、4块暴风城盾牌和4个暴风城头盔。|n|n海地精拾荒者也会掉落这些装备。‡收集4把暴風城長矛，4副暴風城胸甲，4個暴風城盾牌和4個暴風城頭盔。|n|n裝備也能從吉爾布林拾荒者身上收集。',
  }
},
[25546] = {
  {
    'Saco vazio não para em pé‡Голод не тетка‡Siege gehen durch den Magen‡위장과의 싸움‡Marchar con el estómago lleno‡Marchar con el estómago lleno‡Le ventre vide‡吃饱了好上路‡用胃行軍',
    nil,
    'Colete 8 pedaços de Carne de Caranguejo Suculenta de Pateantes Garrabífidas.‡Добудьте 8 кусков сочного мяса крабов c быстролапов с надтреснутой клешней.‡Sammelt 8 Stück saftiges Krebsfleisch von Spaltscherenhuschern.‡갈래발 번개집게를 잡아 육즙이 많은 게살 8개를 모아야 합니다.‡Reúne 8 carnes suculentas de cangrejo de arácnidos Doblegarra.‡Reúne 8 carnes suculentas de cangrejo de arácnidos Doblegarra.‡Récoltez 8 morceaux de Chair de crabe succulente sur des Glisseurs pince-fendue.‡从裂钳诱捕蟹那里收集6块多汁的蟹肉。‡從惡爪誘捕者那裡收集6個多汁蟹肉。',
  }
},
[25547] = {
  {
    'Nos nossos próprios termos‡По нашим правилам‡Zu unseren eigenen Bedingungen‡우리 방식대로‡A nuestra manera‡A nuestra manera‡Prendre le naga par les nageoires‡我行我素‡依我們所願',
    nil,
    'Fale com o Capitão Taylor no Cortassal.‡Поговорите с капитаном Тейлором на "Морском Кортике".‡Sprecht mit Kapitän Taylor im Salzkutter.‡갯바람호에 있는 부대장 테일러와 대화해야 합니다.‡Habla con el capitán Taylor en el Cúter Salobre.‡Habla con el capitán Taylor en el Cúter Salobre.‡Parlez au capitaine Taylor à bord du Fend-les-flots.‡与破浪号上的泰勒上尉交谈。‡到分水號和泰勒隊長談話。',
  }
},
[25548] = {
  {
    'O poder do Senhor do Fogo‡Мощь Повелителя Огня‡Die Macht des Feuerfürsten‡불의 군주의 힘‡El poder del Señor del Fuego‡El poder del Señor del Fuego‡La puissance du seigneur du Feu‡炎魔之王的力量‡火焰之王的威力',
    nil,
    'Mate 4 Ascendentes das Chamas e 5 Subjugadores do Crepúsculo no Promontório do Ascendente, em Hyjal.‡Убейте 4 перерожденных служителей огня и 5 сумеречных поработителей на Вершине Перерожденных на Хиджале.‡Tötet 4 Flammenaszendenten und 5 Zwielichtunterwerfer auf der Anhöhe des Aszendenten auf dem Hyjal.‡하이잘의 승천의 마루에서 화염 승천자 4명과 황혼의 통제자 5명을 처치해야 합니다.‡Asesina a 4 ascendientes de llamas y a 5 subyugadores Crepusculares en el Alto del Ascendiente en Hyjal.‡Asesina a 4 ascendientes de llamas y a 5 subyugadores Crepusculares en el Alto del Ascendiente en Hyjal.‡Tuez 4 Ascendants des flammes et 5 Subjugateurs du Crépuscule à la Cime de l’Ascendant, à Hyjal.‡在海加尔山升腾者高地消灭4名火焰升腾者和5名暮光征服者。‡到海加爾的卓越者高崗殺死4個火焰先祖和5個暮光征服者。',
  }
},
[25549] = {
  {
    'O Sacrário dos Profetas‡Святилище Прорицателей‡Das Sanktum der Propheten‡예언자의 성소‡El Sagrario de los Profetas‡El Sagrario de los Profetas‡Le sanctum des Prophètes‡先知圣殿‡預言者聖所',
    nil,
    'Mate 4 Áugures do Crepúsculo, 4 Pajens do Crepúsculo e 1 Emissário da Chama no Sacrário dos Profetas.‡Убейте 4 сумеречных предсказателей, 4 сумеречных охранителей и 1 посланника пламени в Святилище Прорицателей.‡Tötet 4 Zwielichtauguren, 4 Zwielichtanhänger und 1 Abgesandten der Flamme im Sanktum der Propheten.‡예언자의 성소에서 황혼의 전조 4명, 황혼의 수행원 4명, 화염의 사절 1마리를 처치해야 합니다.‡Asesina a 4 augures Crepusculares, a 4 criados Crepusculares y a 1 emisario de la Llama en el Sagrario de los Profetas.‡Asesina a 4 augures Crepusculares, a 4 criados Crepusculares y a 1 emisario de la Llama en el Sagrario de los Profetas.‡Tuez 4 Augures du Crépuscule, 4 Factotums du Crépuscule et 1 Émissaire des flammes au Sanctum des Prophètes, à Hyjal.‡在先知圣殿消灭4名暮光预言师，4名暮光侍从和1名烈焰使者。‡到預言者聖所殺死4個暮光占兆師、4個暮光侍從和1個火焰使者。',
  }
},
[25550] = {
  {
    'O monarca de magma‡Владыка магмы‡Magmamonarch‡용암 군주‡Monarca de magma‡Monarca de magma‡Le monarque magmatique‡熔岩之王‡熔岩統治者',
    nil,
    'Use os Tambores do Deus Tartaruga para pedir ajuda para derrotar o Rei Derretron.‡Используйте барабаны бога-черепахи, чтобы одолеть короля Молтрона.‡Benutzt die Trommeln des Schildkrötengottes, um für den Kampf gegen König Lavatron Unterstützung zu erhalten.‡거북이 신의 북을 사용하여 왕 몰트론을 처치해야 합니다.‡Usa los tambores del dios tortuga para ayudar a derrotar al rey Moltron.‡Usa los tambores del dios tortuga para ayudar a derrotar al rey Moltron.‡Utilisez les Tambours du dieu tortue pour vous aider à vaincre le Roi Moltron.‡借助龟神之鼓的力量打败曼格坦大帝。‡使用烏龜神祇聖鼓幫助你擊敗摩爾登國王。',
  }
},
[25551] = {
  {
    'O Senhor do Fogo‡Повелитель Огня‡Der Feuerfürst‡불의 군주‡El Señor del Fuego‡El Señor del Fuego‡Le seigneur du Feu‡炎魔之王‡炎魔',
    nil,
    'Atravesse o portal no Sacrário dos Profetas e ajude Cenarius a derrotar Ragnaros.‡Пройдите сквозь портал в Святилище Прорицателей и помогите Кенарию одолеть Рагнароса.‡Geht durch das Portal im Sanktum der Propheten und helft Cenarius dabei, Ragnaros zu besiegen.‡예언자의 성소에 있는 차원문으로 들어간 뒤, 세나리우스를 도와 라그나로스를 처치해야 합니다.‡Atraviesa el portal del Martillo Crepuscular en el Sagrario de los Profetas y ayuda a Cenarius a derrotar a Ragnaros.‡Atraviesa el portal del Martillo Crepuscular en el Sagrario de los Profetas y ayuda a Cenarius a derrotar a Ragnaros.‡Traversez le portail au Sanctum des Prophètes et aidez Cénarius à vaincre Ragnaros.‡穿过先知圣殿的传送门帮助塞纳留斯打败拉格纳罗斯。‡穿過預言者聖域的傳送門，協助塞納留斯擊敗拉格納羅斯。',
  }
},
[25552] = {
  {
    'A prole do mal‡Отродье зла‡Die Brut des Bösen‡악의 무리‡Linaje maligno‡Linaje maligno‡La couvée infernale‡邪恶之巢‡邪惡的子嗣',
    nil,
    'Pegue um Crânio de Jovem Draco do Crepúsculo no Promontório do Ascendente, em Hyjal.‡Добудьте череп молодого сумеречного дракона на Вершине Перерожденных на Хиджале.‡Besorgt Euch den Schädel eines jungen Zwielichtdrachen auf der Anhöhe des Aszendenten auf dem Hyjal.‡하이잘의 승천의 마루에서 어린 황혼의 비룡 해골을 입수해야 합니다.‡Consigue una calavera de draco Crepuscular joven en el Alto del Ascendiente en Hyjal.‡Consigue una calavera de draco Crepuscular joven en el Alto del Ascendiente en Hyjal.‡Obtenez un Crâne de jeune drake du Crépuscule à la Cime de l’Ascendant, à Hyjal.‡在海加尔山升腾者高地获得一颗暮光幼龙的头骨。‡到海加爾的卓越者高崗取得幼年暮光飛龍顱骨。',
  }
},
[25553] = {
  {
    'Morte à prolemadre‡Смерть праматери!‡Tod der Brutmutter‡여왕에게 죽음을‡Muerte a la madre de linaje‡Muerte a la madre de linaje‡Mort à la matriarche‡龙母之死‡育母之死',
    nil,
    'Bote o Crânio de Jovem Draco do Crepúsculo no local onde Desesperona come, a sul do Promontório do Ascendente, e mate-a.‡Положите череп сумеречного дракона на месте кормежки к югу от Вершины Перерожденных и убейте Деспериону.‡Legt den Zwielichtdrachenschädel an der Futterstelle südlich des Zirkels des Aszendenten ab und tötet Desperiona.‡승천의 마루 남쪽에 있는 먹이터에 황혼의 비룡의 해골을 내려놓고, 데스페리오나를 처치해야 합니다.‡Coloca la calavera de draco Crepuscular en la zona de alimentación al sur del Alto del Ascendiente y asesina a Desperiona.‡Coloca la calavera de draco Crepuscular en los Campos de Alimentación al sur del Alto del Ascendiente y asesina a Desperiona.‡Déposez le Crâne de drake du Crépuscule dans le terrain de chasse au sud de la Cime de l’Ascendant et tuez Despériona.‡将暮光幼龙的头骨放在升腾者高地南边的觅食地，并消灭迪斯珀蕾欧娜。‡將暮光飛龍顱骨放在卓越者高崗南方的獵食場並殺死戴斯伯瑞歐娜。',
  }
},
[25554] = {
  {
    'Segredos do fogo‡Тайны пламени‡Geheimnisse der Flamme‡화염의 비밀‡Secretos de la Llama‡Secretos de la Llama‡Les secrets de la flamme‡火焰的秘密‡火焰的秘密',
    nil,
    'Pegue o Códice do Ascendente, as Ladainhas Ardentes e o Tomo de Chamas no Promontório do Ascendente, em Hyjal.‡Добудьте Кодекс перерожденных, Горящие литании и фолиант Пламени на Вершине Перерожденных на Хиджале.‡Beschafft Euch den Kodex des Aszendenten, die brennenden Litaneien und den Folianten der Flamme auf der Anhöhe des Aszendenten auf dem Hyjal.‡하이잘의 승천의 마루에서 승천의 법전, 불타는 연도서, 화염의 고서를 입수해야 합니다.‡Obtén el Códice de ascendiente, las Letanías ardientes y el Libro de Llamas en el Alto del Ascendiente en Hyjal.‡Obtén el Códice de ascendiente, las Letanías ardientes y el Libro de Llamas en el Alto del Ascendiente en Hyjal.‡Obtenez le Codex d’ascendant, les Litanies de braise et le Tome des flammes à la Cime de l\'Ascendant, à Hyjal.‡在海加尔山升腾者高地找到升腾者教条、燃烧的祷文和烈焰秘典。‡到海加爾的卓越者高崗取得卓越者的聖典、燃燒的長篇禱文和火焰秘典。',
  }
},
[25555] = {
  {
    'O guarda-pórtico‡Страж врат‡Der Torwächter‡문지기‡El Guardián de la Puerta‡El Guardián de la Puerta‡Le gardien de la porte‡护门人‡守門者',
    nil,
    'Use o Chifre de Cenarius para pedir ajuda e matar Azralon, o Guarda-pórtico.‡Воспользуйтесь рогом Кенария, чтобы одолеть Азралона Привратника.‡Benutzt das Horn des Cenarius, um Hilfe dabei zu erhalten, Azralon den Torwächter zu töten.‡세나리우스의 뿔피리를 사용하여 문지기 아즈랄론을 처치해야 합니다.‡Usa el cuerno de Cenarius para que te ayuden a matar a Azralon el Guardián de la Puerta.‡Usa el cuerno de Cenarius para que te ayuden a matar a Azralon el Guardián de la Puerta.‡Utilisez le Cor de Cénarius pour vous aider à terrasser Azralon le Gardien de la porte.‡在塞纳留斯之角的帮助下消灭护门人阿泽莱隆。‡使用塞納留斯之角幫助你殺死守門者阿茲拉隆。',
  }
},
[25556] = {
  {
    'Para Zul\'Farrak‡Вглубь Зул\'Фаррака‡Nach Zul\'Farrak‡줄파락으로‡En el interior de Zul\'Farrak‡En el interior de Zul\'Farrak‡Dans Zul\'Farrak‡进入祖尔法拉克‡進入祖爾法拉克',
    nil,
    'Encontre Mazoga dentro de Zul\'Farrak.‡Найдите Мазогу в Зул\'Фарраке.‡Findet Mazoga in Zul\'Farrak.‡줄파락 안에서 마조가를 찾아야 합니다.‡Encuentra a Mazoga en el interior de Zul\'Farrak.‡Encuentra a Mazoga en el interior de Zul\'Farrak.‡Trouvez Mazoga dans Zul’Farrak.‡去找祖尔法拉克的玛佐加。‡到祖爾法拉克尋找瑪柔伽。',
  }
},
[25557] = {
  {
    '‡‡Häuptling Ukorz‡‡Jefe Ukorz‡‡Le chef Ukorz‡‡',
    nil,
    '‡Убейте вождя Укорза Песчаного Черепа.‡Tötet Häuptling Ukorz Sandskalp.‡족장 우코르즈 샌드스칼프를 처치해야 합니다.‡Mata al jefe Ukorz Cabellarena.‡‡Tuez le chef Ukorz Scalpessable.‡杀死乌克兹·沙顶。‡',
  }
},
[25558] = {
  {
    'Tudo ou nada‡Все или ничего‡Alles oder nichts‡도 아니면 모‡Todo o nada‡Todo o nada‡Tout ou rien‡生死之战‡孤注一擲',
    nil,
    'Ajude o Capitão Taylor na defesa do Cortassal.‡Помогите капитану Тейлору защитить "Морской Кортик".‡Helft Kapitän Taylor bei der Verteidigung des Salzkutters.‡부대장 테일러를 도와 갯바람호를 방어해야 합니다.‡Ayuda al capitán Taylor en la defensa de El Cúter Salobre.‡Ayuda al capitán Taylor en la defensa de El Cúter Salobre.‡Assistez le Capitaine Taylor dans la défense du Fend-les-flots.‡协助泰勒上尉保卫破浪号。‡幫助泰勒隊長保衛分水號。',
  }
},
[25559] = {
  {
    'Eu vi primeiro!‡Предъявить права‡Anspruch erheben‡소유권 주장‡Reivindicar la posesión‡Reivindicar la posesión‡Revendication !‡所有权‡佔取',
    nil,
    'Mate 10 Escavadores de Relicários.‡Убейте 10 эльфов крови – искателей.‡Tötet 10 Ruinenjäger der Blutelfen.‡블러드 엘프 성물회 채굴꾼 10명을 처치해야 합니다.‡Mata a 10 cazadores de las ruinas elfos de sangre.‡Mata a 10 cazadores de las ruinas elfos de sangre.‡Tuez 10 Elfes de sang pilleurs de ruines.‡杀死10名血精灵废墟猎人。‡殺死10個血精靈廢墟獵人。',
  }
},
[25560] = {
  {
    'Leva de ovos‡Всмятку!‡Eierwelle‡알까기‡Oleada de huevos‡Oleada de huevos‡Qui vole sur un œuf...‡砸蛋‡蛋之浪',
    nil,
    'Equipe-se com uma Lança-de-fogo Crepuscular e voe no Guardião de Aviana. Quebre 40 Ovos das Terras do Fogo voando para cima deles. Clique no botão de Bater Asas para que sua montaria bata as asas!‡Вооружитесь Огненным копьем Сумеречного Молота и взлетите на одном из защитников Авианы. Разбейте 40 яиц Огненных Просторов, бросившись на них. Нажимайте кнопку "Взмах", чтобы гиппогриф взмахивал крыльями.‡Legt eine Zwielichtfeuerlanze an und fliegt Avianas Wächter. Zerstört 40 Eier der Feuerlande, indem Ihr über sie rauscht. Drückt die Taste \'Flattern\', damit Euer Reittier mit den Flügeln schlägt!‡황혼의 화염창을 장착하고 아비아나의 수호자를 타십시오. 화염창을 들고 돌진하여 불의 땅 알 40개를 파괴해야 합니다. 날갯짓 버튼을 눌러 탈것의 날개를 퍼덕이십시오!‡Equipa una flamanza Crepuscular y vuela en un guardián de Aviana. Sobrevuela y destroza 40 huevos de las Tierras de Fuego. ¡Pulsa el botón Aletear para agitar las alas de tu montura!‡Equipa una flamanza Crepuscular y vuela en un guardián de Aviana. Sobrevuela y destroza 40 huevos de las Tierras de Fuego. ¡Pulsa el botón Aletear para agitar las alas de tu montura!‡Empoignez une Lance de feu du Crépuscule et enfourchez un Gardien d’Aviana. Cassez 40 Œufs des terres de Feu en les survolant. Cliquez sur l’icône Battre des ailes pour que votre monture se mette à voler !‡装备一把暮光火焰长枪，乘坐艾维娜的守护者出击。飞向40枚火焰之地龙卵以击碎它们。按下“拍翼”按钮以控制你的坐骑扇动翅膀！‡裝配暮光火矛並乘上艾維娜的守護者飛行。飛翔並踩碎40顆在火源之界的蛋。按「振翅」鈕讓你的坐騎拍翅膀!',
  }
},
[25561] = {
  {
    '‡На оборону дилижанса... то есть лодки!‡Die Wägen - äh, Boote - einkreisen‡마차를... 아니, 배를 돌려라‡Rodea las carretas... eh, las barcas‡‡Le cercle des chaloupes disparues‡严阵以待……呃，水阵‡',
    nil,
    '‡Потопите 15 шлюпок Южных морей.‡Versenkt 15 Ruderboote der Südmeerfreibeuter.‡나룻배 15척을 침몰시켜야 합니다.‡Hunde 15 botes de remos de los Mares del Sur.‡‡Coulez 15 Chaloupes des mers du Sud.‡击沉15艘南海划艇。‡',
  }
},
[25562] = {
  {
    'Pula, pirata!‡На оборону дилижанса... то есть лодки!‡Die Wägen - äh, Boote - einkreisen‡마차를... 아니, 배를 돌려라‡Rodea las carretas... eh, las barcas‡Rodea las carretas... eh, las barcas‡Le cercle des chaloupes disparues‡严阵以待……呃，水阵‡',
    nil,
    'Afunde 15 Barcos a Remo dos Mares do Sul.‡Потопите 15 шлюпок Южных морей.‡Versenkt 15 Ruderboote der Südmeerfreibeuter.‡나룻배 15척을 침몰시켜야 합니다.‡Hunde 15 botes de remos de los Mares del Sur.‡Hunde 15 botes de remos de los Mares del Sur.‡Coulez 15 Chaloupes des mers du Sud.‡击沉15艘南海划艇。‡',
  }
},
[25563] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    '‡Отнесите загадочное устройство в Штормград, Стальгорн, Экзодар или Дарнас и покажите его представителю Служителей Земли.‡Bringt das mysteriöse Gerät nach Sturmwind, Eisenschmiede, Exodar oder Darnassus und zeigt es einem Botschafter des Irdenen Rings.‡‡Lleva el dispositivo misterioso a Ventormenta, a Forjaz, a El Exodar o a Darnassus y muéstraselo a un representante del Anillo de la Tierra.‡‡Apportez le Mystérieux appareil à Hurlevent, Forgefer, Exodar ou Darnassus et montrez-le à un Représentant du Cercle terrestre.‡‡',
  }
},
[25564] = {
  {
    'Forças aquáticas e terrestres da elite de Ventobravo‡Сухопутные и Морские Элитные войска Штормграда‡Kampfschwimmer von Sturmwind‡스톰윈드 전천후 특전대‡Grupo de Operaciones Especiales de Ventormenta‡Grupo de Operaciones Especiales de Ventormenta‡Les commandos de Hurlevent‡暴风城海豹突击队‡暴風城兩棲作戰精英部隊',
    nil,
    'Encontre 6 Equipamentos da F.O.C.A. de Ventobravo.‡Найдите 6 единиц оборудования штормградского СМЭШ.‡Findet 6 Teile einer Kampfschwimmerausrüstung aus Sturmwind.‡스톰윈드 특전대 장비 6개를 찾아야 합니다.‡Encuentra 6 equipos G. O. E. V. de Ventormenta.‡Encuentra 6 equipos G. O. E. V. de Ventormenta.‡Retrouvez 6 pièces d’Équipement de commando de Hurlevent.‡找到6件暴风城海豹突击队员装备。‡找到6個暴風城海豹部隊裝備。',
  }
},
[25565] = {
  {
    'Fragmentos da linguagem‡Фрагменты языка‡Sprachfragmente‡언어의 조각‡Fragmentos de lenguaje‡Fragmentos de lenguaje‡Des fragments de langage‡语言的碎片‡斷簡殘片',
    nil,
    'Consiga 5 Hieroglifos Antigos.‡Соберите 5 древних иероглифов.‡Sammelt 5 uralte Hieroglyphen.‡고대의 성각문양 5개를 수집해야 합니다.‡Reúne 5 jeroglíficos antiguos.‡Reúne 5 jeroglíficos antiguos.‡Récupérez 5 Hiéroglyphes anciens.‡收集5份远古符文碑刻。‡收集5個古老的象形文字。',
  }
},
[25566] = {
  {
    'Os segredos de Uldum‡Тайны Ульдума‡Die Geheimnisse Uldums‡울둠의 비밀‡Los secretos de Uldum‡Los secretos de Uldum‡Les secrets d\'Uldum‡奥丹姆的秘密‡奧丹姆的秘密',
    nil,
    'Procure um artefato intacto na Antecâmara de Uldum.‡Осмотрите вестибюль Ульдума в поисках неповрежденных артефактов.‡Sucht in der Vorkammer von Uldum nach einem unzerstörten Artefakt.‡울둠의 대기실에서 온전한 유물을 찾아야 합니다.‡Registra la antecámara de Uldum en busca de un artefacto intacto.‡Registra la antecámara de Uldum en busca de un artefacto intacto.‡Fouillez l’antichambre d’Uldum à la recherche d’un Artéfact intact.‡搜索奥丹姆前厅，寻找一件完好的神器。‡到奧丹姆的前廳尋找完整的神器。',
  }
},
