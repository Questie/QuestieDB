[26219] = {
  {
    'Vai e volta‡Замыкая круг‡Der Kreis schließt sich‡한 바퀴‡Vuelta en redondo‡Vuelta en redondo‡La boucle est bouclée‡完成轮回‡周而復始',
    nil,
    'Embarque no Tenaz X2, no Castelo de Voldrin, e ajude na conquista do Covil do Abismo Sombrio.‡C "Крепости Волдрина" поднимитесь на борт "Хвата Х2" и окажите помощь в операции в Темной пещере.‡Geht von der Voldrins Mut aus an Bord der Zange X2 und helft dabei, Dämmerbucht zu sichern.‡볼드린의 장악호에서 쌍집게발호로 올라 타고 어둠돌파 동굴을 확보해야 합니다.‡Aborda el Tenazario X2 desde el Bastión de Voldrin y ayuda a asegurar la Cala Brechaoscura.‡Aborda el Tenazario X2 desde el Bastión de Voldrin y ayuda a asegurar la Cala Brechaoscura.‡Passez du Bastion de Voldrin au Pinceur X2 et participez à la prise de la Crique du Sombre brisant.‡从沃德林之拥号登上扳钳X2号，帮忙清剿驱暗海窟。‡從佛德林堡登上鉗手X2，加入防衛深淵止境的行列。',
  }
},
[26220] = {
  {
    'Tudo fica melhor com bacon‡С беконом все потянет‡Speck macht alles besser‡베이컨만 있으면 모든 게 좋아져‡Todo sabe mejor con bacón‡Todo sabe mejor con bacón‡Dans le cochon, tout est bon‡加培根，更美味‡有培根什麼都好吃',
    nil,
    'Mate Suínos Cevados ao sul de Orgrimmar e me traga 6 Toucinhos. Vou ficar esperando aqui no Bazar.‡Заруби взрослых кабанов к югу от Оргриммара и принеси мне 6 туш. Я буду ждать тебя тут, в Волоке.‡Schlachtet einige der ausgewachsenen Schweine südlich von Orgrimmar und bringt mir 6 Schweinebäuche. Ich werde hier in der Gasse auf Euch warten.‡오그리마 남쪽에 있는 다 자란 돼지를 잡아서 골목길에 있는 마로그에게 멧돼지 삼겹살 6장을 가져가야 합니다.‡Mata puercos maduros al sur de Orgrimmar y tráeme 6 de sus barrigas de puerco. Estará esperando por ti aquí en La Calle Mayor.‡Mata puercos maduros al sur de Orgrimmar y tráeme 6 de sus barrigas de puerco. Te esperaré aquí, en La Calle Mayor.‡Tuez des Pourceaux adultes au sud d’Orgrimmar et ramenez-moi 6 Panses de pourceaux. Je vous attendrai ici, à la Herse.‡到奥格瑞玛南边去杀几头成年野猪，给我带6份猪腹肉回来。我就在暗巷区里等你。‡殺死奧格瑪南部成年野豬並帶回6份豬腹。我會在暗巷區這裡等你。',
  }
},
[26221] = {
  {
    'Vai e volta‡Замыкая круг‡Der Kreis schließt sich‡한 바퀴‡Vuelta en redondo‡Vuelta en redondo‡La boucle est bouclée‡完成轮回‡周而復始',
    nil,
    'Suba a bordo do Verne na Recompensa Estígia e ajude no ataque à Caverna Tenebrosa.‡Со "Стигийской Награды" поднимитесь на борт "Верна" и окажите помощь в операции в Зловещем гроте.‡Geht von der Höllenjuwel aus an Bord der Verne und helft dabei, die Schattenhöhle zu sichern.‡저승의 자비호에서 베른호로 옮겨 타고 음침한 동굴을 확보해야 합니다.‡Aborda el Verne desde la Recompensa Estigia y ayuda a asegurar la Caverna Tenebrosa.‡Aborda el Verne desde la Recompensa Estigia y ayuda a asegurar la Caverna Tenebrosa.‡Passez du Bonnet stygien au Verni et participez à la prise de la Caverne Ténébreuse.‡从冥河恩赐号登上凡尔纳号，帮忙清剿阴暗洞穴。‡從冥河賞金號登上維恩號，加入防衛深淵止境的行列。',
  }
},
[26222] = {
  {
    'Catando sucata‡Добыча запчастей‡Verteilte Teile‡부품 수집‡Gorroneando piezas‡Gorroneando piezas‡Dégotter des pièces‡寻找零件‡搜集零件',
    nil,
    'Leve 7 Peças Sobressalentes para o Engenheiro Fagulhamola na Vila da Gambiarra.‡Принесите 7 запчастей инженеру Искролязгу в Новый Город Механиков.‡Bringt 7 Ersatzteile zu Ingenieur Schleiffunke in Neu-Tüftlerstadt.‡예비 부품 7개를 찾아 신 땜장이 마을에 있는 기술자 그라인드스파크에게 가져가야 합니다.‡Llévale 7 piezas de repuesto al ingeniero Machacachispa en Nueva Ciudad Manitas.‡Llévale 7 piezas de repuesto al ingeniero Machacachispa en Nueva Ciudad Manitas.‡Apportez 7 Pièces détachées à l’Ingénieur Pulvétincelle, à La Nouvelle-Brikabrok.‡将7个备用零件交给新工匠镇的工程师格林德斯巴克。‡將7個備用零件帶給新地精區的工程師磨炫。',
  }
},
[26223] = {
  {
    'Espreitando os espreitadores‡Охота на бродяг‡Die Pirsch auf die Pirscher‡은빛갈기늑대 추적‡Acechar a los acechadores‡Acechar a los acechadores‡Traquer les traqueurs‡捕猎捕猎者‡銀鬃潛獵者',
    nil,
    'Mate 8 Espreitadores Jubaprata.‡Убейте 8 среброгривых бродяг.‡Tötet 8 Silbermähnenpirscher.‡긴발톱 은빛갈기늑대 8마리를 처치해야 합니다.‡Mata a 8 acechadores melenargenta.‡Mata a 8 acechadores melenargenta.‡Tuez 8 Traqueurs crins-d\'argent.‡杀死8条银鬃捕猎者。‡殺死8頭銀鬃潛獵者。',
  }
},
[26224] = {
  {
    'Caça às bestas‡Охота на дикарей‡Jagt die Wilden‡포악한 올빼미야수 사냥‡Cazar a los salvajes‡Cazar a los salvajes‡Chasser les sauvages‡野蛮的枭兽‡野蠻的梟獸',
    nil,
    'Mate 10 Ferujas Selvagens.‡Убейте 10 диких совух.‡Tötet 10 Wilde Eulenbestien.‡포악한 올빼미야수 10마리를 처치해야 합니다.‡Mata 10 lechubestias salvajes.‡Mata 10 lechubestias salvajes.‡Tuez 10 Chouettards sauvages.‡杀掉10头野蛮的枭兽。‡殺死10隻野蠻的梟獸。',
  }
},
[26225] = {
  {
    'Xerez de Pupellyverbos‡Портвейн "Пупелливербос"‡Pupellyverbos\' Portwein‡푸펠리베르보스 포트‡Oporto Pupellyverbos‡Oporto Pupellyverbos‡Le porto Pupellyverbos‡紫葡萄酒‡紫葡萄酒',
    nil,
    'Recolha 12 garrafas de Xerez de Pupellyverbos.‡Соберите 12 бутылок портвейна "Пупелливербос".‡Sammelt 12 Flaschen Pupellyverbos\' Portwein.‡푸펠리베르보스 포트 포도주 12병을 모아야 합니다.‡Reúne 12 botellas de oporto Pupellyverbos.‡Reúne 12 botellas de oporto Pupellyverbos.‡Ramassez 12 bouteilles de Porto Pupellyverbos.‡收集12瓶紫葡萄酒。‡收集12瓶紫葡萄酒。',
  }
},
[26226] = {
  {
    'Bobó de lagostim‡Раки под креольским соусом‡Flusskrebs à la Creole‡크리올식 가재 요리‡Revuelto de centollo‡Revuelto de centollo‡Des écrevisses à la créole‡捕捉小龙虾‡螯蝦克利歐',
    nil,
    'Pegue 10 Lagostins Lamacentos em Orgrimmar. Entregue os crustáceos para Marogg quando completar a missão.‡Поймайте 10 ильных раков в Оргриммаре. Принесите добычу Мароггу.‡Fangt 10 schlammige Flusskrebse in Orgrimmar und bringt die Krustentiere zu Marogg, wenn Ihr fertig seid.‡오그리마에서 진흙투성이 가재 10마리를 잡아 마로그에게 가져가야 합니다.‡Atrapa 10 centollos fangosos en Orgrimmar. Llévale los crustáceos a Marogg cuando hayas acabado.‡Atrapa 10 centollos fangosos en Orgrimmar. Llévale los crustáceos a Marogg cuando hayas acabado.‡Attrapez 10 Écrevisses boueuses à Orgrimmar. Lorsque ce sera terminé, apportez les crustacés à Marogg.‡在奥格瑞玛城内捕捉10条沾泥龙虾，然后把它们交给玛洛格。‡在奧格瑪抓10隻泥濘螯蝦。完成後送回去給瑪羅格。',
  }
},
[26227] = {
  {
    'Cuidado que a fruta morde‡Осторожно: злые фрукты!‡Achtung, die Frucht beißt zurück!‡주의: 이 과일은 쏩니다‡Cuidado, esta fruta devuelve el mordisco‡Cuidado, esta fruta devuelve el mordisco‡Attention, ces fruits se défendent‡当心，果子有刺‡小心，水果會咬人',
    nil,
    'Colha 8 Peras Espinhosas. Entregue-as para Marogg em Orgrimmar.‡Сорвите 8 колючих груш. Доставьте их Мароггу в Оргриммар.‡Sammelt 8 Kaktusfeigenfrüchte und bringt sie zu Marogg in Orgrimmar.‡오그리마에 있는 마로그에게 가시투성이 배 8개를 가져가야 합니다.‡Recupera 8 piezas de fruto pera espinosa. Lleva la fruta a Marogg en Orgrimmar.‡Recupera 8 piezas de fruto pera espinosa. Lleva la fruta a Marogg en Orgrimmar.‡Cueillez 8 Figues de Barbarie et rapportez-les à Marogg, à Orgrimmar.‡收集8份仙人掌果，把它们交给奥格瑞玛的玛洛格。‡取得8個仙人掌果。將這些果實送去奧格瑪給瑪羅格。',
  }
},
[26228] = {
  {
    'Cada um no seu caixote‡Живи и радуйся‡Wie die Made im Speck‡모두가 꿈꾸는 삶‡Viviendo la vida‡Viviendo la vida‡Mener la belle vie‡体验生活‡享受生活',
    nil,
    'Use a Velha Casa do Lu "Dois Sapatos" na parte de trás da Mina Veiojango, em Cerro Oeste.‡Используйте старый дом Переобутого Лу у заднего входа в рудник Янго в Западном крае.‡Benutzt Lou Zweischuhs altes Haus am Ende des Jangoschachtes in Westfall.‡서부 몰락지대의 장고로드 광산에서 쌍신발 루의 낡은 집을 사용해야 합니다.‡Utiliza la casa vieja de Lou Dos Zapatos en la parte trasera de la Mina de Jango en Páramos de Poniente.‡Utiliza la casa vieja de Lou Dos Zapatos en la parte trasera de la Mina de Jango en Páramos de Poniente.‡Utilisez l\'Ancienne « maison » de Lou Deux-semelles au fond de la Mine Veine-de-Jango, dans la Marche de l\'Ouest.‡到西部荒野詹戈洛德矿洞的后面使用“老好人”洛伊的老房子。‡在西部荒野的詹戈洛德礦坑的最深處使用「雙蹄鐵」勞的舊組合屋。',
  }
},
[26229] = {
  {
    '"Pego vela SIM!"‡"Свечка МОЯ!"‡"Ich NEHMEN Kerze!"‡"나 양초 가져간다!"‡"¡Yo sí llevarme vela!"‡"¡Yo sí llevarme vela!"‡« Moi PRENDRE bougie ! »‡“我来抢蜡烛！”‡「我就是要拿蠟燭!」',
    nil,
    'Mate 12 Kobolds Escavadores.‡Убейте 12 кобольдов-землекопов.‡Tötet 12 Koboldbuddler.‡코볼트 채굴꾼 12마리를 처치해야 합니다.‡Mata 12 cavadores kóbolds.‡Mata 12 cavadores kóbolds.‡Tuez 12 Terrassiers kobolds.‡消灭12只狗头人掘地工。‡殺死12個狗頭人掘地工。',
  }
},
[26230] = {
  {
    'Banquete de rei‡Пир во время чумы‡Festmahl oder Hungersnot‡풍요로움이냐 궁핍이냐‡Banquete o hambruna‡Banquete o hambruna‡Un festin en temps de famine‡盛宴还是饥荒‡大吃或是餓肚子',
    nil,
    'Pegue 6 Rabos de Coiote e 5 punhados de Terra de Formigueiro.‡Добудьте 6 хвостов койотов и 5 горстей свежей грязи.‡Sammelt 6 Kojotenschwänze und 5 Handvoll frischen Matsch.‡코요테 꼬리 6개와 신선한 흙 5줌을 모아야 합니다.‡Recoge 6 colas de coyote y 5 puñados de suciedad fresca.‡Recoge 6 colas de coyote y 5 puñados de tierra fresca.‡Récupérez 6 Queues de coyote et 5 poignées de Gravillons du jour.‡收集6条山狗尾和5把新鲜的泥土。‡收集6條山狗尾和5把新鮮的土壤。',
  }
},
[26231] = {
  {
    '‡[Deprecated] Boarding Party‡Enterkommando‡‡Grupo de abordaje‡‡Groupe d\'abordage‡‡',
    nil,
    nil,
  }
},
[26232] = {
  {
    'As últimas palavras do Lu‡Прощальные мысли Лу‡Lous Abschiedsworte‡루의 깜박이는 기억‡Las palabras de despedida de Lou‡Las palabras de despedida de Lou‡Les bons tuyaux de Lou‡洛伊的临别赠言‡勞的離別感想',
    nil,
    'Espreite os Bandidos atrás da sede da Plantação de Abóboras do Taturana, em Cerro Oeste.‡Подслушайте лиходеев, спрятавшись за домом на тыквенной ферме Хмуроброва в Западном крае.‡Belauscht die Rohlinge hinter dem Bauernhaus auf Brauenwirbels Kürbishof in Westfall.‡서부 몰락지대의 펄브라우 호박밭 뒤에 있는 불량배들의 대화를 엿들어야 합니다.‡Espía a los matones detrás de la granja en la Plantación de Calabazas de Cejade, en Páramos de Poniente.‡Espía a los matones detrás de la granja en la Plantación de Calabazas de Cejade, en Páramos de Poniente.‡Espionnez les Nervis derrière le bâtiment principal de la Ferme de potirons des Froncebouille, dans la Marche de l\'Ouest.‡在西部荒野法布隆南瓜农场的农舍后窃听贼人交谈。‡偷聽在西部荒野的法布隆南瓜農場農舍後面的暴徒說話。',
  }
},
[26233] = {
  {
    'Roubando de nós mesmos‡Укради у своих‡Aus den eigenen Reihen stehlen‡우리 걸 훔치기‡Robando a los nuestros‡Robando a los nuestros‡Voler les siens‡家贼难防‡自守自盜',
    nil,
    'Recupere 6 Barris de Arroz Lançanegra. Entregue o arroz para Marogg em Orgrimmar.‡Раздобудьте 6 бочек риса Черного Копья. Принесите их Мароггу в Оргриммар.‡Bringt 6 Fässer mit Dunkelspeerreis in Euren Besitz und bringt sie zu Marogg in Orgrimmar.‡검은창 쌀통 6개를 회수하여 오그리마에 있는 마로그에게 쌀통을 전달해야 합니다.‡Recupera 6 barriles de arroz Lanza negra. Lleva el arroz a Marogg en Orgrimmar.‡Recupera 6 barriles de arroz Lanza negra. Lleva el arroz a Marogg en Orgrimmar.‡Récupérez 6 Tonneaux de riz des Sombrelances et livrez-les à Marogg à Orgrimmar.‡收集6桶暗矛香米，把它们交给奥格瑞玛的马洛格。‡取回6個暗矛米糧桶。把米送去給奧格瑪的瑪羅格。',
  }
},
[26234] = {
  {
    'Roubando de nós mesmos‡Укради у своих‡Aus den eigenen Reihen stehlen‡우리 걸 훔치기‡Robando a los nuestros‡Robando a los nuestros‡Voler les siens‡家贼难防‡自守自盜',
    nil,
    'Recupere 6 Barris de Arroz Kezan. Entregue o arroz para Marogg em Orgrimmar.‡Достаньте 6 бочек кезанского риса и принесите их Мароггу в Оргриммар.‡Bringt 6 Fässer mit Kezanreis in Euren Besitz und bringt sie zu Marogg in Orgrimmar.‡케잔 쌀통 6개를 회수하여 오그리마에 있는 마로그에게 쌀통을 전달해야 합니다.‡Recupera 6 barriles de arroz de Kezan. Lleva el arroz a Marogg en Orgrimmar.‡Recupera 6 barriles de arroz de Kezan. Lleva el arroz a Marogg en Orgrimmar.‡Récupérez 6 Tonneaux de riz de Kezan et livrez-les à Marogg à Orgrimmar.‡收集6桶科赞香米，把它们交给奥格瑞玛的玛洛格。‡取回6個凱贊米糧桶。把米送去給奧格瑪的瑪羅格。',
  }
},
[26235] = {
  {
    'Até ladrões têm fome‡Вор тоже хочет кушать‡Auch Diebe bekommen Hunger‡도둑들도 배가 고프다‡Hasta los ladrones tienen hambre‡Hasta los ladrones tienen hambre‡Même les voleurs ont faim‡饥饿的盗贼‡就算是小偷也會肚子餓',
    nil,
    'Recupere 3 Rações de Infantaria da Horda. Entregue-as para Marogg em Orgrimmar.‡Раздобудьте 3 пайка ордынских пехотинцев. Отнесите их Мароггу в Оргриммар.‡Findet 3 Infanterierationen der Horde und bringt sie zu Marogg in Orgrimmar.‡호드 보병 보급식량 3개를 회수하여 오그리마에 있는 마로그에게 가져가야 합니다.‡Recupera 3 raciones de infantería de la Horda. Llévaselas a Marogg en Orgrimmar.‡Recupera 3 raciones de infantería de la Horda. Llévaselas a Marogg en Orgrimmar.‡Récupérez 3 Rations d\'infanterie de la Horde et apportez-les à Marogg à Orgrimmar.‡收集3份部落步兵口粮，把它们交给奥格瑞玛的玛洛格。‡取回3份部落步兵口糧。送去給位於奧格瑪的瑪羅格。',
  }
},
[26236] = {
  {
    'Aperto nos Saldanha‡Обыск у Сальденов‡Die Vernehmung der Saldeans‡살딘 농장 수사‡Poniendo patas arriba la Granja de Saldean‡Poniendo patas arriba la Granja de Saldean‡Un interrogatoire chez les Saldean‡萨丁的提醒‡搜查薩丁',
    nil,
    'Fale com o Fazendeiro Saldanha na Fazenda dos Saldanha, em Cerro Oeste.‡Поговорите с фермером Сальденом на ферме Сальдена в Западном крае.‡Sprecht mit Bauer Saldean auf Saldeans Hof in Westfall.‡서부 몰락지대의 살딘 농장에 있는 농부 살딘과 대화해야 합니다.‡Habla con el granjero Saldean en la Granja de Saldean en Páramos de Poniente.‡Habla con el granjero Saldean en la Granja de Saldean en Páramos de Poniente.‡Parlez à Saldean le fermier à la Ferme des Saldean, dans la Marche de l\'Ouest.‡同西部荒野萨丁农场的农夫萨丁交谈。‡到西部荒野的薩丁農場與農夫薩丁交談。',
  }
},
[26237] = {
  {
    'Tempos difíceis‡Тяжелые времена‡Die Zeiten sind schwer‡고난의 시대‡Tiempos duros‡Tiempos duros‡Les temps sont durs‡日子不好过‡世道艱苦',
    nil,
    'Mate 10 Guarda-colheitas.‡Убейте 10 дозорных полей.‡Tötet 10 Erntebehüter.‡허수아비골렘 보초 10마리를 처치해야 합니다.‡Mata 10 vigías de la cosecha.‡Mata 10 vigías de la cosecha.‡Tuez 10 Gardiens des moissons.‡击败10个看守傀儡。‡殺死10名看守傀儡。',
  }
},
[26238] = {
  {
    'Anões ferozes‡Дикие дворфы‡Die wilden Zwerge‡야만 드워프‡Enanos salvajes‡Enanos salvajes‡Sauvages de nains‡野蛮的矮人‡野蠻的矮人',
    nil,
    'Mate 10 Guerreiros Martelo Feroz ou Xamãs de Martelo Feroz.‡Убейте 10 воинов или шаманов клана Громового Молота.‡Tötet 10 Krieger der Wildhämmer oder Schamanen der Wildhämmer.‡와일드해머 전사 혹은 와일드해머 주술사를 10명 처치해야 합니다.‡Mata a 10 guerreros Martillo Salvaje o chamanes Martillo Salvaje.‡Mata a 10 guerreros Martillo Salvaje o chamanes Martillo Salvaje.‡Tuez 10 Guerriers ou Chamans marteaux-hardis.‡杀死10名蛮锤战士或蛮锤萨满。‡殺死10個蠻錘戰士或蠻錘薩滿。',
  }
},
[26239] = {
  {
    '‡‡&lt;PH&gt;Totem der Wildhämmer‡&lt;PH&gt;와일드해머 토템‡&lt;PH&gt;Tótems de Martillo Salvaje‡‡&lt;PH&gt;Les totems marteaux-hardis‡‡',
    nil,
    nil,
  }
},
[26240] = {
  {
    'Segue o meu compasso‡Бей в барабаны‡Im Takt‡북소리에 맞춰‡Pisotear al ritmo‡Pisotear al ritmo‡Allez-y tambour battant‡跟着我的节拍‡跟著我的拍子',
    nil,
    'Use os Tambores de Guerra Revatusco em 6 Guerreiros Revatusco.‡Испробуйте действие боевых барабанов на 6 воинах племени Сломанного Клыка.‡Spielt die Kriegstrommeln der Bruchhauer für 6 Krieger der Bruchhauer.‡깨진엄니 전쟁 북을 깨진엄니 전사 6명에게 사용해야 합니다.‡Usa los tambores de guerra Sañadiente con 6 guerreros Sañadiente.‡Usa los tambores de guerra Sañadiente con 6 guerreros Sañadiente.‡Utilisez les Tambours de guerre vengebroches sur 6 Guerriers vengebroches.‡对6名恶齿战士使用恶齿战鼓。‡對6個惡齒戰士使用惡齒戰鼓。',
  }
},
[26241] = {
  {
    'Ensopado de Cerro Oeste‡Похлебка Западного края‡Westfalleintopf‡서부정통 스튜‡Estofado de los Páramos de Poniente‡Estofado de los Páramos de Poniente‡Le ragoût de la marche de l\'Ouest‡杂味炖肉‡西部荒野燉肉',
    nil,
    'Pegue 6 Quiabos, 6 quilos de Acém de Ripa-carne e 6 quilos de Chã-de-fora de Goretusco.‡Добудьте 6 плодов окры, 6 боков кровоклыка и 6 кусков жилистого мяса шкуродера.‡Sammelt 6 Okraschoten, 6 Stück sehniges Fleischreißerfleisch und 6 Geiferzahnflanken.‡오크라 6개, 뿔엄니멧돼지 살코기 6개, 질깃한 식인독수리 고기 6개를 모아야 합니다.‡Reúne 6 unidades de okra, 6 unidades de carne de desgarrador viscosa y 6 costillares de dentosangre.‡Reúne 6 unidades de okra, 6 unidades de carne de desgarrador viscosa y 6 costillares de dentosangre. ‡Récupérez 6 Okras, 6 morceaux de Viande filandreuse de déchireur et 6 Flanchets de broche-tripes.‡收集6束秋葵，6份秃鹫肉条和6块血牙野猪肋排。‡收集6件秋葵，6塊血牙野肋肉和6塊碎屍鳥肉條。',
  }
},
[26242] = {
  {
    '‡Подземье, мир земли‡Tiefenheim, Ebene der Erde‡심원의 영지, 대지의 세계‡Infralar, plano de la tierra‡‡Le Tréfonds, plan de la Terre‡深岩之洲，土元素位面‡',
    nil,
    nil,
  }
},
[26243] = {
  {
    'O Pilar do Mundo‡Столп мира‡Die Weltensäule‡세계 기둥‡El Pilar del Mundo‡El Pilar del Mundo‡Le pilier du monde‡世界之柱‡世界之柱',
    nil,
    'Pergunte a Maruut Atapedras sobre o Pilar do Mundo.‡Спросите Маруута Камневяза о столпе мира.‡Befragt Maruut Steinbinder zur Weltensäule.‡마루트 스톤바인더에게 세계 기둥에 대해 물어봐야 합니다.‡Pregunta a Maruut Amarrapiedra sobre el Pilar del Mundo.‡Pregunta a Maruut Amarrapiedra sobre el Pilar del Mundo.‡Demandez à Maruut Lieur-de-Pierre des informations sur le pilier du monde.‡向玛鲁特·缚石询问关于世界之柱的事情。‡詢問瑪魯特·縛石者關於世界之柱的事。',
  }
},
[26244] = {
  {
    'A terra reclama tudo para si‡Земля забирает все‡Die Erde nimmt sich alles‡모든 것은 흙으로‡La tierra lo reclama todo‡La tierra lo reclama todo‡Les revendications de la Terre‡一切归于土‡大地吞覆一切',
    nil,
    'Destrua 5 Elementais de Pedrafunda.‡Убейте 5 глубинных элементалей.‡Vernichtet 5 Tiefensteinelementare.‡깊은바위 정령 5마리를 처치해야 합니다.‡Acaba con 5 elementales Piedraprofunda.‡Acaba con 5 elementales Piedraprofunda.‡Détruisez 5 Élémentaires pierre-profonde.‡摧毁5只深石土元素。‡摧毀5個深岩元素。',
  }
},
[26245] = {
  {
    'Belonave em perigo‡Крушение воздушного судна‡Luftschiff am Boden‡추락한 비행포격선‡Nave de guerra abatida‡Nave de guerra abatida‡La canonnière échouée‡炮艇坠落‡砲艦墜毀',
    nil,
    'Procure pistas nos Destroços do Fúria da Tempestade, no Geodomo.‡Обыщите место крушения "Неистовства Бури" в Подземье.‡Sucht im Wrack der Sturmfuror in Tiefenheim nach Hinweisen.‡심원의 영지의 폭풍 강타호 잔해에서 단서를 찾아야 합니다.‡Busca pistas en Restos de la Furia de la Tormenta en Infralar.‡Busca pistas en Restos de la Furia de la Tormenta en Infralar.‡Cherchez des indices dans l’Épave de la Fureur de l’orage, dans le Tréfonds.‡在深岩之洲风暴之怒号残骸里寻找线索。‡在地深之源的風暴之怒殘骸尋找線索。',
  }
},
[26246] = {
  {
    'Diário de bordo‡Судовой журнал капитана‡Das Logbuch des Kapitäns‡선장의 일지‡El diario del capitán‡El diario del capitán‡Le journal du capitaine‡船长的日志‡艦長的日誌',
    nil,
    'Entregue o Diário de Bordo para Maruut Atapedras no Templo da Terra, que fica no Geodomo.‡Отнесите судовой журнал капитана Марууту Камневязу в Храм Земли, что в Подземье.‡Bringt das Logbuch des Kapitäns zu Maruut Steinbinder beim Tempel der Erde in Tiefenheim.‡심원의 영지의 대지의 사원에 있는 마루트 스톤바인더에게 선장의 일지를 가져가야 합니다.‡Lleva el diario del capitán a Maruut Amarrapiedra en el Templo de la Tierra en Infralar.‡Lleva el diario del capitán a Maruut Amarrapiedra en el Templo de la Tierra en Infralar.‡Apportez le Journal du capitaine à Maruut Lieur-de-Pierre au Temple de la Terre, dans le Tréfonds.‡将船长的日志交给深岩之洲大地神殿的玛鲁特·缚石。‡將艦長的日誌帶去地深之源的大地神殿給瑪魯特·縛石者。',
  }
},
[26247] = {
  {
    'Diplomacia em primeiro lugar‡Дипломатия прежде всего‡Diplomatie hat Vorrang‡대화로 해결합시다‡Primero, la diplomacia‡Primero, la diplomacia‡Avec diplomatie‡外交第一‡政策優先',
    nil,
    'Encontre a Tempestária Mylra a bordo da Belonave da Aliança.‡Поговорите с буревестницей Милрой на боевом корабле Альянса.‡Trefft Euch mit Sturmruferin Mylra auf dem Kanonenboot der Allianz.‡얼라이언스 비행포격선에 있는 폭풍소환사 마일라를 만나야 합니다.‡Encuéntrate con la clamatormentas Mylra a bordo de la nave de guerra de la Alianza.‡Encuéntrate con la clamatormentas Mylra a bordo de la nave de guerra de la Alianza.‡Rejoignez la Mande-foudre Mylra à bord de la canonnière de l’Alliance.‡去找联盟炮艇的风暴召唤者米尔拉。‡在聯盟砲艇甲板上與風暴召喚者米爾拉碰面。',
  }
},
[26248] = {
  {
    'Nossos amigos estão mortos‡Все наши друзья мертвы‡All unsere Freunde sind tot‡죽은 자도 말이 있다‡Todos nuestros amigos están muertos‡Todos nuestros amigos están muertos‡Tous nos amis sont morts‡我们的朋友都死了‡我們的朋友全死了',
    nil,
    'Use o Totem de Espírito nos corpos de 6 Tripulantes Assassinados.‡Воспользуйтесь тотемом духов у 6 тел убитых членов команды.‡Benutzt das Geistertotem in der Nähe von 6 Leichnamen erschlagener Besatzungsmitglieder.‡살해된 선원 6명의 시체에 정기의 토템을 사용해야 합니다.‡Usa el tótem de espíritu en los cadáveres de 6 miembros del equipo asesinados.‡Usa el tótem de espíritu en los cadáveres de 6 miembros del equipo asesinados.‡Utilisez le Totem des esprits sur les cadavres de 6 Membres d’équipage assassinés.‡在6名被杀死的船员的尸体上使用灵魂图腾。‡將靈魂圖騰用在6名被殺的船員的屍體上。',
  }
},
[26249] = {
  {
    'A cabine do almirante‡Каюта адмирала‡Die Kajüte des Admirals‡함장실‡El camarote del almirante‡El camarote del almirante‡La cabine de l’amiral‡司令室‡上將的艙房',
    nil,
    'Procure pistas na cabine do almirante da Belonave da Aliança.‡Поищите улики в кабине адмирала на боевом корабле Альянса.‡Haltet in der Kajüte des Admirals auf dem Kanonenboot der Allianz nach Hinweisen Ausschau.‡얼라이언스 비행포격선의 함장실에서 단서를 찾아야 합니다.‡Busca pistas en el camarote del almirante en la nave de guerra de la Alianza.‡Busca pistas en el camarote del almirante en la nave de guerra de la Alianza.‡Cherchez des indices dans la cabine de l’amiral de la Canonnière de l’Alliance.‡到联盟炮艇的司令室里去找找线索。‡在聯盟砲艇的上將艙房裡搜尋線索。',
  }
},
[26250] = {
  {
    'Pensando bem, faça um prisioneiro‡А впрочем... взять одного пленного‡Ach, einen Gefangenen sollten wir doch nehmen‡아, 한 놈은 남겨 놓고‡Pensándolo mejor: haz un prisionero‡Pensándolo mejor: haz un prisionero‡À bien y réfléchir, faites un prisonnier‡转念一想，还是抓个俘虏吧‡還是留個活口好了',
    nil,
    'Domine Mor\'norokk, o Odioso, na Belonave da Aliança, que está no Geodomo.‡Победите Мор\'норока Ненавистного на боевом корабле Альянса в Подземье.‡Unterwerft Mor\'norokk den Hasserfüllten auf dem Kanonenboot der Allianz in Tiefenheim.‡심원의 영지의 얼라이언스 비행포격선에 있는 혐오스러운 모르노록을 제압해야 합니다.‡Somete a Mor\'norokk el Odioso en la nave de guerra de la Alianza en Infralar.‡Somete a Mor\'norokk el Odioso en la nave de guerra de la Alianza en Infralar.‡Maîtrisez Mor’norokk le Haineux sur la Canonnière de l’Alliance, dans le Tréfonds.‡制伏深岩之洲联盟炮艇上的仇视者莫诺洛克。‡在地深之源的聯盟砲艇制服『憎恨者』莫爾洛克。',
  }
},
[26251] = {
  {
    'Não prenda ninguém‡Пленных не брать‡Macht keine Gefangenen‡한 놈도 남김 없이‡No hagas prisioneros‡No hagas prisioneros‡Ne faites pas de prisonnier‡不抓俘虏‡不留活口',
    nil,
    'Mate 6 Sabotadores do Crepúsculo.‡Убейте 6 сумеречных саботажников.‡Tötet 6 Zwielichtsaboteure.‡황혼의 파괴공작원 6명을 처치해야 합니다.‡Asesina a 6 saboteadores Crepusculares.‡Asesina a 6 saboteadores Crepusculares.‡Tuez 6 Saboteurs du Crépuscule.‡杀死6名暮光破坏者。‡殺死6名暮光破壞者。',
  }
},
[26252] = {
  {
    'O guarda tem coração‡Сердце дозорного‡Herz des Behüters‡보초의 심장‡El corazón del vigía‡El corazón del vigía‡Le cœur du gardien‡傀儡之心‡看守者之心',
    nil,
    'Devolva o Coração de Guarda-colheitas para o Fazendeiro Saldanha na Fazenda dos Saldanha, em Cerro Oeste.‡Принесите сердце дозорного полей фермеру Сальдену на ферму Сальдена.‡Bringt das Herz eines Erntebehüters zurück zu Bauer Saldean auf Saldeans Hof.‡살딘 농장에 있는 농부 살딘에게 허수아비골렘 보초 심장을 돌려줘야 합니다.‡Lleva el corazón de vigía de la cosecha al granjero Saldean en la Granja de Saldean.‡Lleva el corazón de vigía de la cosecha al granjero Saldean en la Granja de Saldean.‡Rapportez le Cœur de gardien des moissons à Saldean le fermier, à la Ferme des Saldean.‡将看守傀儡之心交给萨丁农场的农夫萨丁。‡將看守傀儡心臟帶去薩丁農場給農夫薩丁。',
  }
},
[26253] = {
  {
    '‡Сохранить доказательства‡Sichert die Spuren‡‡Conserva las pruebas‡‡Protéger la preuve‡‡',
    nil,
    nil,
  }
},
[26254] = {
  {
    'Aperto no ogro‡Растянуть связки‡Erklärt Euch!‡오우거 길들이기‡La cosa se tuerce‡La cosa se tuerce‡L’interrogatoire de Mor’norokk‡听听他有什么说法‡來點硬的',
    nil,
    'Monte no Bicovento e assista ao interrogatório de Mor\'norokk.‡Садитесь на Клюва Бури и проследите за допросом Мор\'норокка.‡Springt auf Sturmschnabel und beobachtet Mor\'norokks Befragung.‡폭풍부리에 올라타고 모르노록의 심문을 지켜봐야 합니다.‡Monta en Picotormenta y observa el interrogatorio de Mor\'norokk.‡Monta en Picotormenta y observa el interrogatorio de Mor\'norokk.‡Grimpez sur Foudrebec et observez le déroulement de l’interrogatoire de Mor’norokk.‡跳上风暴比克，旁观对莫诺洛克的审讯。‡跳上風喙並觀看莫爾洛克的審訊。',
  }
},
[26255] = {
  {
    'Retorno ao Templo da Terra‡Вернуться в Храм Земли‡Rückkehr zum Tempel der Erde‡다시 대지의 사원으로‡Vuelve al Templo de la Tierra‡Vuelve al Templo de la Tierra‡Retour au temple de la Terre‡回到大地神殿‡返回大地神殿',
    nil,
    'Fale com Maruut Atapedras no Templo da Terra, que fica no Geodomo.‡Поговорите с Маруутом Камневязом в Храме Земли в Подземье.‡Sprecht mit Maruut Steinbinder im Tempel der Erde in Tiefenheim.‡심원의 영지의 대지의 사원에 있는 마루트 스톤바인더와 대화해야 합니다.‡Habla con Maruut Amarrapiedra en el Templo de la Tierra en Infralar.‡Habla con Maruut Amarrapiedra en el Templo de la Tierra en Infralar.‡Allez voir Maruut Lieur-de-Pierre au Temple de la Terre, dans le Tréfonds.‡跟深岩之洲大地神殿的玛鲁特·缚石谈一谈。‡在地深之源的大地神殿和瑪魯特·縛石者談話。',
  }
},
[26256] = {
  {
    'Sangrar o Moldassangue‡Пустить кровь кроводелам‡Lasst die Blutformer bluten‡피는 이제 그만‡Desangrar al modelasangre‡Desangrar al modelasangre‡Saigner les sculpte-sang‡给塑血者放血‡塑血者之血',
    nil,
    'Obtenha as Ordens do Crepúsculo com um dos Moldassangue do Crepúsculo na Queda do Asa da Morte.‡Заберите приказы Сумеречного Молота у одного из Сумеречных кроводелов в Кратере Смертокрыла.‡Besorgt Euch die Schattenhammerbefehle von einem der Zwielichtblutformer in Todesschwinges Sturz.‡데스윙의 몰락지에 있는 황혼의 피마술사 중 하나로부터 황혼의 명령서를 획득해야 합니다.‡Consigue las órdenes Crepusculares de uno de los modelasangres Crepusculares en la Caída de Alamuerte.‡Consigue las órdenes Crepusculares de uno de los modelasangres Crepusculares en la Caída de Alamuerte.‡Récupérez les Ordres du Crépuscule sur l’un des Sculpte-sang du Crépuscule, à la Chute d’Aile de mort.‡从死亡之翼陨落地的一名暮光塑血者身上获得暮光的命令。‡從死翼之殞的一名暮光塑血者那裡取得暮光指令。',
  }
},
[26257] = {
  {
    'Está vivo!‡Он живой!‡Es lebt!‡골렘이 살아있다!‡¡Está vivo!‡¡Está vivo!‡C\'est vivant !‡它活了！‡它活了!',
    nil,
    'Use o Coração de Guarda-colheitas em um Golem Colheiteiro em Curto-circuito. Em seguida, use o mesmo Golem para matar 25 Colheitadeiras Energizadas.‡Примените сердце дозорного полей к перегруженному уборочному голему и затем используйте перегруженный уборочный голем для уничтожения 25 заряженных уборочных големов.‡Wendet das Herz eines Erntebehüters auf einen überladenen Erntegolem an und benutzt dann den überladenen Erntegolem, um 25 aufgeladene Ernteschnitter zu töten.‡허수아비골렘 보초 심장을 과부하된 허수아비골렘에 사용하고 과부하된 허수아비골렘을 사용해 충전된 허수아비골렘 수확기를 25마리 처치해야 합니다.‡Utiliza el corazón de vigía de la cosecha en un gólem de la cosecha sobrecargado, y luego utiliza el gólem de la cosecha sobrecargado para matar 25 segadores de la cosecha energizados.‡Utiliza el corazón de vigía de la cosecha en un gólem de la cosecha sobrecargado y luego utiliza el gólem de la cosecha sobrecargado para matar 25 segadores de la cosecha energizados. ‡Placez le Cœur de gardien des moissons dans un Golem des moissons surchargé et utilisez celui-ci pour tuer 25 Moissonneurs énergisés.‡对一台过载的麦田傀儡使用看守傀儡之心，然后用过载的麦田傀儡摧毁25台已充能的收割机。‡對超載的麥田魔像使用看守傀儡心臟，並用超載的麥田魔像殺死25個充滿能量的收割傀儡。',
  }
},
[26258] = {
  {
    'Queda do Asa da Morte‡Кратер Смертокрыла‡Todesschwinges Sturz‡데스윙의 몰락지‡La Caída de Alamuerte‡La Caída de Alamuerte‡La Chute d’Aile de mort‡死亡之翼陨落地‡死翼之殞',
    nil,
    'Vá para a Queda do Asa da Morte, no Geodomo.‡Отправляйтесь в Кратер Смертокрыла в Подземье.‡Geht zu Todesschwinges Sturz in Tiefenheim.‡심원의 영지에 있는 데스윙의 몰락지로 가야 합니다.‡Ve a la Caída de Alamuerte en Infralar.‡Ve a la Caída de Alamuerte en Infralar.‡Allez à la Chute d’Aile de mort, dans le Tréfonds.‡前往深岩之洲的死亡之翼陨落地。‡前往地深之源裡的死翼之殞。',
  }
},
[26259] = {
  {
    'Sangue do Guardião da Terra‡Кровь Хранителя Земли‡Blut des Erdenwächters‡대지의 수호자의 피‡La sangre del Guardián de la Tierra‡La sangre del Guardián de la Tierra‡Le sang du Gardeterre‡大地的守护者之血‡大地守護者之血',
    nil,
    'Colete 5 amostras de Sangue de Neltharion dos Sangues Vivos na Queda do Asa da Morte.‡Добудьте 5 образцов крови Нелтариона из живой крови в Кратере Смертокрыла.‡Sammelt 5 Proben des Blutes von Neltharion vom lebenden Blut in Todesschwinges Sturz.‡데스윙의 몰락지에 있는 살아있는 피로부터 넬타리온의 피 견본 5개를 수집해야 합니다.‡Reúne 5 muestras de sangre de Neltharion de las criaturas sangre viviente en la Caída de Alamuerte.‡Reúne 5 muestras de sangre de Neltharion de las criaturas sangre viviente en la Caída de Alamuerte.‡Rassemblez 5 échantillons du Sang de Neltharion sur du Sang vivant, à la Chute d’Aile de mort.‡从死亡之翼陨落地的活体血液身上获得5份奈萨里奥之血的样本。‡從死翼之殞的活血元素那裡取得5份奈薩里奧之血。',
  }
},
[26260] = {
  {
    'O diário do Mestre Forjador‡Записи начальника кузни‡Das Logbuch des Schmiedemeisters‡제련장인의 기록‡El cuaderno del maestro de forja‡El cuaderno del maestro de forja‡Le journal du maître-forge‡铸炉之主的日志‡鍛造大師的日誌',
    nil,
    'Encontre o Diário do Mestre Forjador na Queda do Asa da Morte, que fica no Geodomo.‡Найдите записи начальника кузни в Кратере Смертокрыла в Подземье.‡Findet das Logbuch des Schmiedemeisters in Todesschwinges Sturz in Tiefenheim.‡심원의 영지의 데스윙의 몰락지에 있는 제련장인의 기록을 찾아야 합니다.‡Encuentra el cuaderno del maestro de forja en la Caída de Alamuerte en Infralar.‡Encuentra el cuaderno del maestro de forja en la Caída de Alamuerte en Infralar.‡Trouvez le Journal du maître-forge à la Chute d’Aile de mort, dans le Tréfonds.‡在深岩之洲死亡之翼陨落地找到铸炉之主的日志。‡在地深之源裡的死翼之殞找到鍛造大師的日誌。',
  }
},
[26261] = {
  {
    'Pergunte aos escravos‡Допрос рабов‡Befragt die Sklaven‡노예에게 물어 보세요‡Interroga a los esclavos‡Interroga a los esclavos‡L’interrogatoire des esclaves‡质问奴隶‡詢問奴隸',
    nil,
    'Pegue a Chave do Escravizador do Crepúsculo e liberte 6 Mineradores Escravizados.‡Найдите ключ поработителя из Сумеречного Молота и освободите 6 порабощенных шахтеров.‡Besorgt Euch den Schlüssel des Zwielichtsklavenhändlers und befreit 6 versklavte Minenarbeiter.‡황혼의 노예사냥꾼 열쇠를 구하고, 사로잡힌 광부 6명을 풀어 줘야 합니다.‡Consigue la llave de esclavista Crepuscular y libera a 6 mineros esclavizados.‡Consigue la llave de esclavista Crepuscular y libera a 6 mineros esclavizados.‡Récupérez la Clé d’esclavagiste du Crépuscule et libérez 6 Mineurs asservis.‡获得暮光奴隶的钥匙，释放6名被奴役的矿工。‡取得暮光奴隸的鑰匙並解放6名被奴役的礦工。',
  }
},
[26262] = {
  {
    '‡Оружие Сумеречного Молота‡Zwielichtwaffen‡황혼의 무기‡Armamentos Crepusculares‡‡Les armes du Crépuscule‡暮光军备‡',
    nil,
    nil,
  }
},
[26263] = {
  {
    'Espinar Trovechoque‡Торнар Громовой Рокот‡Thornar Donnerknall‡토르나 썬더클래쉬‡Thornar Golperrayo‡Thornar Golperrayo‡Thornar Fracasse-tonnerre‡索纳尔·雷破‡索爾納爾‧雷鏘',
    nil,
    'Mate Espinar Trovechoque.‡Убейте Торнара Громового Рокота.‡Tötet Thornar Donnerknall.‡토르나 썬더클래쉬를 처치해야 합니다.‡Mata a Thornar Golperrayo.‡Mata a Thornar Golperrayo.‡Tuez Thornar Fracasse-Tonnerre.‡杀死索纳尔·雷破。‡殺死索爾納爾‧雷鏘。',
  }
},
[26264] = {
  {
    'O que deixamos para trás‡Что остается потом‡Die Zurückgelassenen‡남겨진 것들‡Lo que quedó atrás‡Lo que quedó atrás‡Ce que nous avons laissé derrière nous‡身后物‡剩下來的東西',
    nil,
    'Pegue 6 Pertences Recuperados das poças de Lodo Tóxico no Aeroporto Tóxico.‡Разыщите на зараженном аэродроме токсических слякочей и соберите 6 единиц спасенного имущества.‡Beschafft 6 zurückerlangte Besitztümer von toxischem Schlick auf dem Toxischen Flugplatz.‡맹독 비행장의 맹독 녹괴물에게서 되찾은 소유물 6개를 회수해야 합니다.‡Recoge 6 posesiones recuperadas de fangosos tóxicos en La Base Aérea Tóxica.‡Recoge 6 posesiones recuperadas de fangosos tóxicos en La Base Aérea Tóxica.‡Récupérez 6 tas d’Effets personnels de gnome sur les Vases toxiques, à l’Aérodrome Toxique.‡从剧毒机场的毒性淤泥身上获得6份收回的个人财物。‡到劇毒機場，從劇毒淤泥身上得到6件找回的私人物品。',
  }
},
[26265] = {
  {
    'Está na chuva radioativa é para se molhar‡Уборка грязи‡Stoppt die Verseuchung‡잔여물 처리‡Combatir la radiactividad‡Combatir la radiactividad‡Gérer les retombées‡处理辐射‡對付輻射塵',
    nil,
    'Destrua 6 Contaminações Viventes no Aeroporto Tóxico.‡Уничтожьте 6 оживших загрязнений на зараженном аэродроме.‡Zerstört 6 lebende Verseuchungen auf dem Toxischen Flugplatz.‡맹독 비행장에서 살아있는 오염체 6마리를 처치해야 합니다.‡Destruye 6 contaminaciones vivientes en La Base Aérea Tóxica.‡Destruye 6 contaminaciones vivientes en La Base Aérea Tóxica.‡Détruisez 6 Contaminations vivantes à l’Aérodrome Toxique.‡消灭剧毒机场的6只活体污染物。‡到劇毒機場，摧毀6個放射性污染生命體。',
  }
},
[26266] = {
  {
    'Esperança para o povo‡Надежда народа‡Hoffnung für das Volk‡사람들을 위한 희망‡Esperanza para el pueblo‡Esperanza para el pueblo‡Une nouvelle espérance‡人们的希望‡眾人的喜願',
    nil,
    'Leve o Ensopado de Cerro Oeste para Esperança Saldanha no Morro da Sentinela.‡Отнесите похлебку Западного края Надежде Сальден на Сторожевой холм.‡Bringt den Westfalleintopf zu Hope Saldean an der Späherkuppe.‡감시의 언덕에 있는 호프 살딘에게 서부정통 스튜를 가져가야 합니다.‡Llévale el estofado de los Páramos de Poniente a Esperanza Saldean, en la Colina del Centinela.‡Llévale el estofado de los Páramos de Poniente a Esperanza Saldean, en la Colina del Centinela.‡Apportez le Ragoût de la marche de l\'Ouest à Espérance Saldean, à la Colline des Sentinelles.‡把杂味炖肉带给哨兵岭的希望·萨丁。‡將西部荒野燉肉拿到哨兵嶺給喜願·薩丁。',
  }
},
[26267] = {
  {
    'Limpeza na Rocha Oculta‡Большая уборка на Осклизлой скале‡Den Lauerfels aufräumen‡굼벵이 바위굴 청소하기‡La limpieza de Roca Oculta‡La limpieza de Roca Oculta‡Nettoyer le rocher de l\'Affût‡隐匿石大扫除‡清理隱匿石',
    nil,
    'Mate 10 Gosmas Jade.‡Убейте 10 нефритовых слизнюков.‡Tötet 10 jadegrüne Schlamme.‡비취 수액괴물 10마리를 처치해야 합니다.‡Mata a 10 mocos de jade.‡Mata a 10 mocos de jade.‡Tuez 10 Limons de jade.‡杀掉10只玉石软泥怪。‡殺死10隻玉石軟泥怪。',
  }
},
[26268] = {
  {
    'Os suprimentos da Rocha Oculta‡Припасы с Осклизлой скалы‡Lauerfelsvorräte‡굼벵이 바위굴의 보급품‡Suministros de Roca Oculta‡Suministros de Roca Oculta‡Le reliquat du rocher de l\'Affût‡隐匿石补给‡隱匿石補給',
    nil,
    'Recolha 5 Caixas de Suprimentos Cobertas de Gosma.‡Соберите 5 покрытых слизью ящиков с припасами.‡Sammelt 5 schlammbedeckte Vorratskisten.‡수액으로 뒤덮인 보급품 상자 5개를 모아야 합니다.‡Reúne 5 cajones de suministros cubiertos de moco.‡Reúne 5 cajones de suministros cubiertos de moco.‡Récupérez 5 Caisses de ravitaillement couvertes de vase.‡收集5个污泥覆盖的补给箱。‡收集5個覆滿軟泥的補給箱。',
  }
},
[26269] = {
  {
    'Grande Espinhaço: Veredas‡Зеленые холмы Тернистой долины‡Die Grünen Hügel des Schlingendorntals‡가시덤불 골짜기의 푸른 언덕‡Las verdes colinas de Tuercespina‡Las verdes colinas de Tuercespina‡Les vertes collines de Strangleronce‡荊棘谷的青山‡荊棘谷的青山',
    nil,
    'Encontre a Página 14 do Grande Espinhaço: Veredas.‡Найдите страницу 14 "Зеленых холмов Тернистой долины".‡Findet Seite 14 von Die Grünen Hügel des Schlingendorntals.‡가시덤불 골짜기의 푸른 언덕 14쪽을 찾아야 합니다.‡Encuentra la página 14 de Las verdes colinas de Tuercespina.‡Encuentra la página 14 de Las verdes colinas de Tuercespina.‡Trouvez Les vertes collines de Strangleronce - Page 14.‡找到《荆棘谷的青山》第14页。‡找到荊棘谷的青山 - 第14頁。',
  }
},
[26270] = {
  {
    'Agradecemos a gentileza‡Прими нашу благодарность‡Unser Dank ist Euch gewiss‡감사의 뜻을 표합니다‡Tienes nuestro agradecimiento‡Tienes nuestro agradecimiento‡Avec tous nos remerciements…‡我们感激不尽‡我們感激你',
    nil,
    'Fale com Salma Saldanha na Fazenda dos Saldanha, em Cerro Oeste.‡Поговорите с Сальмой Сальден на ферме Сальдена в Западном крае.‡Sprecht mit Salma Saldean auf Saldeans Hof in Westfall.‡서부 몰락지대의 살딘 농장에 있는 살마 살딘과 대화해야 합니다.‡Habla con Salma Saldean en la Granja de Saldean en Páramos de Poniente.|n‡Habla con Salma Saldean en la Granja de Saldean en Páramos de Poniente.|n‡Parlez à Salma Saldean à la Ferme des Saldean, dans la Marche de l\'Ouest.‡同西部荒野萨丁农场的萨尔玛·萨丁交谈。‡到西部荒野的薩丁農場和薩爾瑪·薩丁說話。',
  }
},
[26271] = {
  {
    'Saco vazio não fica em pé‡Накормить голодных и отчаявшихся‡Die Hungrigen und die Hoffnungslosen speisen‡배고프고 절망적인 자들에게 희망을‡Alimenta al hambriento y al desesperado‡Alimenta al hambriento y al desesperado‡Nourrir les affamés et les infortunés‡养活饥饿与无助者‡施捨於飢餓和無望的人',
    nil,
    'Use o Ensopado de Cerro Oeste para alimentar 20 Desabrigados no entorno do Morro da Sentinela, em Cerro Oeste.‡Накормите похлебкой Западного края 20 бездомных в Сторожевом холме.‡Benutzt den Westfalleintopf, um 20 Obdachlose an der Späherkuppe in Westfall zu speisen.‡서부정통 스튜를 사용해 서부 몰락지대의 감시의 언덕에 있는 20명의 부랑자들에게 식사를 제공해야 합니다.‡Utiliza el estofado de Páramos de Poniente y alimenta a 20 personas sin hogar alrededor de la Colina del Centinela en Páramos de Poniente.‡Utiliza el estofado de Páramos de Poniente y alimenta a 20 personas sin hogar alrededor de la Colina del Centinela en Páramos de Poniente.‡Utilisez le Ragoût de la marche de l\'Ouest pour nourrir 20 Sans-abri autour de la Colline des Sentinelles, dans la Marche de l\'Ouest.‡把杂味炖肉分给西部荒野哨兵岭的20个无家可归者。‡將西部荒野燉肉分給在西部荒野哨兵嶺的20位流浪者。',
  }
},
[26272] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡El levantamiento de los Lanza Negra‡L\'ascension des Sombrelances‡暗矛的崛起‡暗矛中興',
    nil,
    'Fale com Voldreka no Campo de Treinamento Lançanegra.‡Найдите Волдреку на тренировочной площадке Черного Копья.‡Trefft Voldreka auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 볼드레카를 만나야 합니다.‡Reúnete con Voldreka en el Campo de Entrenamiento Lanza Negra.‡Reúnete con Voldreka en el Campo de Entrenamiento Lanza Negra.‡Allez voir Voldreka sur le Terrain d’entraînement des Sombrelances.‡与暗矛训练场中的沃德雷卡谈谈。‡在暗矛訓練場和沃德瑞卡碰面。',
  }
},
[26273] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Dinge schlagen‡기본기: 연타‡A golpe de entrenamiento‡A golpe de entrenamiento‡La base : savoir frapper des trucs‡基础教程：攻击目标‡基本原則:攻擊',
    nil,
    'Destrua 6 Alvos Carrancas.‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다.‡Destruye 6 dianas Tiki.‡Destruye 6 dianas Tiki.‡Détruire 6 Cibles Tiki.‡摧毁6个蒂基面具假人。‡摧毀6個訓練假人。',
  }
},
[26274] = {
  {
    'A arte do bruxo‡Искусство чернокнижника‡Die Künste eines Hexenmeisters‡흑마법사의 기술‡Las artes del brujo‡Las artes del brujo‡Les arts du démoniste‡术士的技艺‡術士之藝',
    nil,
    'Fale com Voldreka para treinar a Imolação. Pratique a Imolação 5 vezes em um Alvo Carranca.‡Поговорите с Волдрекой и потренируйтесь в освоении заклинания "Жертвенный огонь". Затем 5 раз испытайте "Жертвенный огонь" на манекенах-тики.‡Sprecht mit Voldreka, um "Feuerbrand" zu lernen. Übt Feuerbrand fünf Mal, indem Ihr es auf ein Tikiziel anwendet.‡볼드레카와 대화하여 제물을 배운 다음, 티키 표적에 제물을 5번 사용하여 연습해야 합니다.‡Habla con Voldreka para aprender Inmolar. Usa Inmolar 5 veces contra una diana Tiki.‡Habla con Voldreka para aprender Inmolar. Usa Inmolar 5 veces contra una diana Tiki.‡Parlez à Voldreka pour apprendre Immolation. Entraînez-vous en utilisant Immolation à 5 reprises contre une Cible Tiki.‡与沃德雷卡交谈，进行献祭的训练。然后对一个蒂基面具假人使用5次献祭。‡與沃德瑞卡談話來訓練獻祭。在訓練假人身上練習使用5次獻祭。',
  }
},
[26275] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡Un duro comienzo‡Un début difficile‡粗暴的开始‡艱難的開始',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste.‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 회수해야 합니다.‡Consigue 6 pelajes de gato Ferocrín.‡Consigue 6 pelajes de gato Ferocrín.‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡取得6份蠻鬃山貓皮。',
  }
},
[26276] = {
  {
    'Fosso da prova‡Яма испытаний‡Grube der Bewährung‡시험의 구덩이‡Foso de pruebas‡Foso de pruebas‡La fosse de l\'épreuve‡试炼场‡試煉場',
    nil,
    'Fale com o Carcereiro Lançanegra, depois entre no fosso da prova e mate um Batedor Escamas Odiosas Cativo.‡Поговорите с тюремщиком Черного Копья, а затем спуститесь в яму испытаний и убейте пленного разведчика из клана Злобной Чешуи.‡Sprecht mit einem Gefängniswärter der Dunkelspeere, dann betretet die Grube und tötet einen gefangenen Späher der Gallschuppen.‡검은창 교도관과 대화한 다음, 시험의 구덩이로 들어가 사로잡힌 원한비늘 정찰병을 처치해야 합니다.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡Parlez à un Geôlier sombrelance, puis descendez dans la fosse de l\'épreuve et tuez un Éclaireur Vexécaille captif.‡同暗矛狱卒交谈，然后进入试炼场，杀死一名恶鳞斥候俘虏。‡和一名暗矛獄卒談話，然後進入試煉場殺死一名被俘虜的惡鱗斥候。',
  }
},
[26277] = {
  {
    'Melhor do que o esperado‡Превосходя ожидания‡Mehr als nur erwartet‡기대 이상‡Mejor de lo esperado‡Mejor de lo esperado‡Mieux que prévu‡喜出望外‡超乎預期',
    nil,
    'Apresente-se a Vol\'jin na Cidadela dos Lançanegra.‡Поговорите с Вол\'джином в крепости Черного Копья.‡Meldet Euch bei Vol\'jin in der Dunkelspeerfeste.‡검은창 요새에 있는 볼진에게 보고해야 합니다.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡Présentez-vous à Vol\'jin au Bastion des Sombrelances.‡向暗矛要塞中的沃金报到。‡到暗矛要塞向沃金回報。',
  }
},
[26278] = {
  {
    'A defesa de Grom\'gol: o risco dos raptores‡Защита Гром\'гола: угроза ящеров‡Die Verteidigung von Grom\'gol: Raptorenrisiko‡그롬골 수비: 랩터의 위협‡La defensa de Grom\'gol: Exceso de raptores‡La defensa de Grom\'gol: Exceso de raptores‡La défense de Grom\'gol : le risque des raptors‡保卫格罗姆高：迅猛龙危机‡格羅姆高保衛戰:迅猛龍危機',
    nil,
    'Destrua 12 Ovos de Batecauda.‡Уничтожьте 12 яиц кнутохвоста.‡Zerstört 12 Schmetterschwanzeier.‡채찍꼬리랩터 알 12개를 파괴해야 합니다.‡Destruye 12 huevos de colazote.‡Destruye 12 huevos de colazote.‡Détruisez 12 Œufs de flagellant.‡破坏12枚鞭尾龙蛋。‡毀掉12顆鞭尾迅猛龍蛋。',
  }
},
[26279] = {
  {
    'A defesa de Grom\'gol: opressão dos ogros‡Защита Гром\'гола: нападение на огров‡Die Verteidigung von Grom\'gol: Ogerunterdrückung‡그룸골 수비: 오우거의 공격‡La defensa de Grom\'gol: Opresión de ogros‡La defensa de Grom\'gol: Opresión de ogros‡La défense de Grom\'gol : l\'oppression des ogres‡保卫格罗姆高：压制食人魔‡格羅姆高保衛戰:巨魔的逼迫',
    nil,
    'Mate 4 Brutamontes Mosh\'Ogg e 4 Mandingueiros Mosh\'Ogg.‡Уничтожьте 4 громил и 4 знахарей из клана Мош\'огг.‡Tötet 4 Schläger der Mosh\'Ogg und 4 Hexendoktoren der Mosh\'Ogg.‡모쉬오그 투사 4명과 모쉬오그 의술사 4명을 처치해야 합니다.‡Mata a 4 toscos Mosh\'Ogg y a 4 médicos brujo Mosh\'Ogg.‡Mata a 4 toscos Mosh\'Ogg y a 4 médicos brujo Mosh\'Ogg.‡Tuez 4 Brutes mosh\'Ogg et 4 Féticheurs mosh\'Ogg.‡杀死4名莫什奥格蛮兵和4名莫什奥格巫医。‡殺死4個莫什奧格蠻卒與4個莫什奧格巫醫。',
  }
},
[26280] = {
  {
    'A defesa de Grom\'gol: a ameaça dos murlocs‡Защита Гром\'гола: угроза мурлоков‡Die Verteidigung von Grom\'gol: Murlocbedrohung‡그롬골 수비: 멀록의 습격‡La defensa de Grom\'gol: Amenaza múrloc‡La defensa de Grom\'gol: Amenaza múrloc‡La défense de Grom\'gol : la menace des murlocs‡保卫格罗姆高：鱼人大屠杀‡格羅姆高保衛戰:魚人威脅',
    nil,
    'Mate 15 murlocs Umbrânquia.‡Убейте 15 черножабрых мурлоков.‡Tötet 15 Murlocs der Düsterkiemen.‡검은아가미 멀록 15마리를 처치해야 합니다.‡Mata a 15 múrlocs Ancaniebla.‡Mata a 15 múrlocs Ancaniebla.‡Tuez 15 Murlocs Branchie-bistre‡杀死15名黑腮鱼人。‡殺死15個黑鰓魚人。',
  }
},
[26281] = {
  {
    'A defesa de Grom\'gol: a ladroagem trólica‡Защита Гром\'гола: троллье воровство‡Die Verteidigung von Grom\'gol: Trolldiebstähle‡그롬골 수비: 트롤의 약탈‡La defensa de Grom\'gol: Ladrones trol‡La defensa de Grom\'gol: Ladrones trol‡La défense de Grom\'gol : le taxage des trolls‡保卫格罗姆高：巨魔盗窃案‡格羅姆高保衛戰:食人妖竊盜事件',
    nil,
    'Recupere as Rações de Grom\'gol das Ruínas de Bal\'lal.‡Добудьте ящики с пайками Гром\'гола на руинах Бал\'лал.‡Holt die Rationen aus Grom\'gol aus den Ruinen von Bal\'lal.‡발랄 폐허에 있는 그롬골 비상식량을 획득해야 합니다.‡Recupera las raciones Grom\'gol de las Ruinas de Bal\'lal.‡Recupera las raciones Grom\'gol de las Ruinas de Bal\'lal.‡Récupérez les Rations de Grom’gol dans les Ruines de Bal’lal.‡从巴拉尔废墟拿回格罗姆高口粮。‡從巴拉爾廢墟取得格羅姆高口糧箱。',
  }
},
[26282] = {
  {
    'O presente de Akil\'darah‡Милость Акил\'дара‡Die Gunst Akil\'darahs‡아킬다라의 부탁‡El favor de Akil\'darah‡El favor de Akil\'darah‡La faveur d\'Akil\'darah‡The Favor of Akil\'darah‡阿奇達拉的恩惠',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[26283] = {
  {
    'Visgo de primeira‡Жуть-муть‡Erstklassiger Schleim‡태고의 수액괴물‡Babosa primigenia‡Babosa primigenia‡Le limon-mère‡泥浆怪之母‡頭號軟泥怪',
    nil,
    'Recolha uma Amostra da Gosma Horrenda.‡Возьмите образец Вязкой Мути.‡Erhaltet eine Terrorklumpenprobe von Terrorklumpen.‡소름덩어리로부터 소름덩어리 견본을 채취해야 합니다.‡Recoge una muestra de Pegoterror.‡Recoge una muestra de Pegoterror.‡Prélevez un Échantillon du Vaseux sur le Vaseux.‡从一只恐泥怪身上获得恐泥怪样本。‡從厄滴身上取得厄滴樣本。',
  }
},
[26284] = {
  {
    'Desaparecidos em ação‡Пропавшие без вести‡Vermisst‡교전 중 실종‡Desaparecido en combate‡Desaparecido en combate‡Démolisseurs en cage‡失踪的士兵‡行動中失蹤',
    nil,
    'Liberte 6 Demolidores Capturados das jaulas ao redor da Fortaleza Jubafria.‡Освободите 6 захваченных подрывников из клеток вокруг форта Мерзлогривов.‡Befreit 6 gefangene Demolierer aus ihren Käfigen in der Nähe der Höhle der Frostmähnen.‡서리갈기 소굴 주변의 우리에 있는 사로잡힌 폭파병 6명을 풀어줘야 합니다.‡Libera de sus jaulas a 6 demoledores capturados en los alrededores del Poblado Peloescarcha.‡Libera de sus jaulas a 6 demoledores capturados en los alrededores del Poblado Peloescarcha.‡Libérez 6 Démolisseurs capturés de leurs cages autour du Repaire des Crins-de-givre.‡从霜鬃巨魔要塞的牢笼里释放6名被俘的爆破师。‡在霜鬃食人妖要塞各處釋放6個被俘虜的爆破兵。',
  }
},
[26285] = {
  {
    'Devolva minha pólvora agora!‡Верните мне мой порох!‡Bringt meinen Sprengstoff zurück!‡폭약을 되돌려달란 말이야!‡¡Trae los explosivos!‡¡Trae los explosivos!‡Jamais sans mes explosifs !‡把我的炸药还回来！‡把我的炸藥拿回來!',
    nil,
    'Recupere 7 Barris de Pólvora Roubados dos Limpa-ossos Pedraqueixo ou Espoliadores Pedraqueixo na Fortaleza Jubafria.‡Отправляйтесь в форт Мерзлогривов и отберите 7 украденных бочонков с порохом у костегрызов или мародеров из племени Каменной Челюсти.‡Beschafft 7 gestohlene Pulverfässer von Knochenpflückern der Felsenkiefertroggs oder von Marodeuren der Felsenkiefertroggs bei der Höhle der Frostmähnen.‡서리갈기 소굴에서 바위턱 뼈다귀청소부와 바위턱 약탈자를 처치해 도둑맞은 화약통 7개를 되찾아야 합니다.‡Recupera 7 toneles de pólvora robados de escarbadores Comepiedras o maleantes Comepiedras en el Poblado Peloescarcha.‡Recupera 7 toneles de pólvora robados de escarbadores Comepiedras o maleantes Comepiedras en el Poblado Peloescarcha.‡Récupérez 7 Barils de poudre volés sur des Racleurs-d’os ou des Maraudeurs mâcherocs, au Repaire des Crins-de-givre.‡从霜鬃巨魔要塞的石腭拾骨者或石腭袭击者身上夺回7只被偷走的火药桶。‡到霜鬃食人妖要塞，從石齶拾骨者或石齶掠奪者身上取回7個失竊的火藥桶。',
  }
},
[26286] = {
  {
    'Em defesa de Cerro Oeste‡На защите Западного края‡Die Verteidigung Westfalls‡서부 몰락지대 수비‡En defensa de los Páramos de Poniente‡En defensa de los Páramos de Poniente‡Pour la défense de la marche de l\'Ouest‡保卫西部荒野‡堅守西部荒野',
    nil,
    'Tome as Ordens de Ataque Gnoll.‡Добудьте гнолльские приказы атаковать.‡Erhaltet die Angriffsbefehle der Gnolle.‡놀 공격 명령서를 입수해야 합니다.‡Recupera las órdenes de ataque gnoll.‡Recupera las órdenes de ataque gnoll.‡Récupérez les Ordres d\'attaque des gnolls.‡缴获豺狼人攻击命令。‡取得豺狼人攻擊命令。',
  }
},
[26287] = {
  {
    'A Brigada de Cerro Oeste‡Дружина Западного края‡Die Westfallbrigade‡서부 몰락지대 여단‡La Brigada de los Páramos de Poniente‡La Brigada de los Páramos de Poniente‡La brigade de la marche de l\'Ouest‡月溪旅‡西荒兵團',
    nil,
    'Mate 12 Gnolls Pata Molhada que estejam atacando o Morro da Sentinela.‡Убейте 12 любых гноллов из стаи Речной лапы, напавших на Сторожевой холм.‡Tötet 12 beliebige Gnolle der Flusspfoten, die die Späherkuppe angreifen.‡감시의 언덕을 공격하는 갈퀴발 놀 12마리를 처치해야 합니다.‡Mata 12 gnolls Zarparrío que estén atacando la Colina del Centinela.‡Mata 12 gnolls Zarparrío que estén atacando la Colina del Centinela.‡Tuez 12 Gnolls rivepattes qui attaquent la Colline des Sentinelles.‡杀掉12只袭击哨兵岭的河爪豺狼人。‡殺死12個進犯哨兵嶺的河爪豺狼人。',
  }
},
[26288] = {
  {
    'Jango Pintalgas‡Джанго Крапчатый‡Jango Fleckfell‡장고 스팟하이드‡Jango Escondite‡Jango Escondite‡Jango Salecouenne‡詹格·斑皮‡詹戈·汙皮',
    nil,
    'Mate Jango Pintalgas, 5 Místicos Pata Molhada e 5 Capatazes Pata Molhada.‡Убейте 5 мистиков и 5 надсмотрщиков из стаи Речной Лапы и Джанго Крапчатого.‡Tötet 5 Mystiker der Flusspfoten, 5 Zuchtmeister der Flusspfoten und Jango Fleckfell.‡갈퀴발 비술사 5마리, 갈퀴발 전사 5마리와 장고 스팟하이드를 처치해야 합니다.‡Mata 5 místicos Zarparrío, 5 capataces Zarparrío y a Jango Escondite.‡Mata 5 místicos Zarparrío, 5 capataces Zarparrío y a Jango Escondite.‡Tuez 5 Mystiques rivepattes, 5 Sous-chefs rivepattes et Jango Salecouenne.‡杀掉5名河爪秘法师，5名河爪监工，以及詹格·斑皮。‡殺死5個河爪秘術使、5個河爪監工和詹戈·汙皮。',
  }
},
[26289] = {
  {
    'Encontre a agente Marta Hari‡Найти агента Кеарнен‡Findet Agentin Kearnen‡첩보원 켈넌을 찾아서‡Encuentra a la agente Kearnen‡Encuentra a la agente Kearnen‡Trouvez l\'agent Kearnen‡寻找密探吉尔妮‡找出密探吉爾妮',
    nil,
    'Encontre a Agente Marta Hari.‡Найдите агента Кеарнен.‡Findet Agentin Kearnen.‡첩보원 켈넌을 찾아야 합니다.‡Encuentra a la agente Kearnen.‡Encuentra a la agente Kearnen.‡Trouvez l\'Agent Kearnen.‡寻找密探吉尔妮。‡找出密探吉爾妮',
  }
},
[26290] = {
  {
    'Os segredos da torre‡Тайны башни‡Geheimnisse des Turms‡탑의 비밀‡Los secretos de la torre‡Los secretos de la torre‡Les secrets de la tour‡高塔的秘密‡塔中祕密',
    nil,
    'Entre na Torre do Pinel e encontre o Helix Quebracâmbio.‡Войдите в башню Мортвейка и найдите Хеликса Отломчикса.‡Betretet Jagdrufs Turm und macht Helix Ritzelbrecher ausfindig.‡몰트웨이크의 탑으로 들어가서 헬릭스 기어브레이커를 찾아야 합니다.‡Entra en la Torre Mortoalerta y encuentra a Helix Rompengranajes.‡Entra en la Torre Mortoalerta y encuentra a Helix Rompengranajes.‡Pénétrez dans la Tour de Morteveille et trouvez Hélix Engrecasse.‡进入摩特维克之塔找到赫利克斯·破甲。‡進入摩特維克之塔找出赫利克斯•碎輪者。',
  }
},
[26291] = {
  {
    'Problemas no Arroio da Lua‡Большой переполох в Луноречье.‡Viel Ärger in Mondbruch‡달빛시내 마을의 큰 문제‡Un problema gordo en Arroyo de la Luna‡Un problema gordo en Arroyo de la Luna‡Du rififi à Ruisselune‡月溪镇的大麻烦‡月溪鎮的大麻煩',
    nil,
    'Relate suas descobertas para o Marechal Miguel Mantoforte no Morro da Sentinela, em Cerro Oeste.‡Доложите о том, что вам удалось обнаружить, маршалу Гриану Камнегриву на Сторожевом холме в Западном крае.‡Berichtet Marschall Gryan Starkmantel an der Späherkuppe in Westfall, was Ihr herausgefunden habt.‡서부 몰락지대의 감시의 언덕에 있는 치안대장 그라이언 스타우트맨틀에게 보고해야 합니다.‡Informa de tus descubrimientos al alguacil Gryan Mantorrecio en la Colina del Centinela en Páramos de Poniente.‡Informa de tus descubrimientos al alguacil Gryan Mantorrecio en la Colina del Centinela en Páramos de Poniente.‡Rapportez vos découvertes au Maréchal Gryan Roidemantel à la Colline des Sentinelles, dans la Marche de l\'Ouest.‡把你的发现报告给西部荒野哨兵岭的治安官格里安·斯托曼。‡向西部荒野的哨兵嶺的格里安·斯托曼保安官回報你的發現。',
  }
},
[26292] = {
  {
    'Siga para o Arroio da Lua!‡В Луноречье!‡Auf nach Mondbruch!‡달빛시내 마을로!‡¡A Arroyo de la Luna!‡¡A Arroyo de la Luna!‡À Ruisselune !‡到月溪镇去！‡到月溪鎮去!',
    nil,
    'Apresente-se ao Capitão Alberto no Arroio da Lua, em Cerro Oeste.‡Доложитесь капитану Алперту в Луноречье в Западном крае.‡Meldet Euch bei Hauptmann Alpert in Mondbruch in Westfall.‡서부 몰락지대의 달빛시내 마을에 있는 대장 알퍼트에게 보고해야 합니다.‡Preséntate ante el capitán Alpert en Arroyo de la Luna en Páramos de Poniente.‡Preséntate ante el capitán Alpert en Arroyo de la Luna en Páramos de Poniente.‡Présentez-vous au Capitaine Alpert à Ruisselune, dans la Marche de l\'Ouest.‡向西部荒野月溪镇的阿尔佩上尉报告。‡向西部荒野的月溪鎮的艾爾波特上尉回報。',
  }
},
[26293] = {
  {
    'Máquinas de guerra‡Боевые машины‡Kriegsmaschinen‡전쟁 기계‡Máquinas de guerra‡Máquinas de guerra‡Les machines de guerre‡战争机器‡戰爭機器',
    nil,
    'Fale com o Encarregado Glibbs no Portão Traseiro de Orgrimmar, em Orgrimmar.‡Поговорите со штейгером Глиббсом у задних врат Оргриммара в Оргриммаре.‡Sprecht mit Großknecht Glibbs am Hinteren Tor von Orgrimmar in Orgrimmar.‡오그리마 뒷문 바로 안쪽에 있는 현장감독 글립스와 대화해야 합니다.‡Habla con el supervisor Glibbs en el interior de la Puerta Trasera de Orgrimmar en Orgrimmar.‡Habla con el supervisor Glibbs en el interior de la Puerta Trasera de Orgrimmar en Orgrimmar.‡Allez voir le Contremaître Glibbs, au niveau de la Porte d\'Azshara, à Orgrimmar.‡同奥格瑞玛后门里的工头格里布斯交谈。‡到奧格瑪的奧格瑪後門和工頭吉利布斯交談。',
  }
},
[26294] = {
  {
    'Armas de disfunção em massa‡Оружие массовой дисфункции‡Massenversagenswaffen‡파괴... 아니, 고장을 부르는 전차‡Armas de disfunción masiva‡Armas de disfunción masiva‡Des armes de dysfonctionnement massif‡大规模失常性武器‡大規模失效武器',
    nil,
    'Inspecione os Demolidores do Grito Infernal até encontrar um defeituoso, então, ensine uma lição ao Engenheiro-chefe.‡Осматривайте "Разрушители Адского Крика", пока не найдете машину с дефектом, а затем проучите главного инженера.‡Untersucht Höllschreis Verwüster, bis Ihr einen fehlerhaften Verwüster findet, und erteilt dem Chefingenieur dann eine Lektion.‡헬스크림 파괴전차를 계속 검사해 결함이 있는 파괴전차를 찾아내고, 선임기술자에게 따끔한 맛을 보여줘야 합니다.‡Inspecciona los demoledores Grito Infernal hasta que encuentres uno defectuoso y luego dale una lección al ingeniero jefe.‡Inspecciona los demoledores Grito Infernal hasta que encuentres uno defectuoso y luego dale una lección al ingeniero jefe.‡Inspectez les Démolisseurs de Hurlenfer jusqu\'à en trouver un qui soit défectueux, puis donnez une bonne leçon à l\'Ingénieur en chef.‡检查地狱咆哮攻城车，直到你发现一台不良品，然后给首席工程师上一课。‡檢驗地獄吼石毀車，直到你找到一台瑕疵品，然後好好教訓它的首席工程師一頓。',
  }
},
[26295] = {
  {
    'Propaganda‡Пропаганда‡Propaganda‡선전물‡Propaganda‡Propaganda‡De la propagande‡宣传‡宣傳計畫',
    nil,
    'Pegue um Panfleto Informativo, um Jornal Clandestino, uma Edição da Gazeta do Arroio da Lua e uma Propaganda Misteriosa.‡Добудьте информационный буклет, тайный дневник, выпуск луноречского вестника и таинственное воззвание.‡Erhaltet ein Informationsflugblatt, ein geheimes Tagebuch, eine Ausgabe des Mondbrucher Blatts und mysteriöse Propaganda.‡안내 전단지, 비밀 일지, 달빛시내 신문 한 부와 수수께끼의 선동 유인물을 회수해야 합니다.‡Recoge un panfleto informativo, el diario secreto, un ejemplar del Diario del Arroyo de la Luna y propaganda misteriosa.‡Recoge un panfleto informativo, el diario secreto, un ejemplar del Diario del Arroyo de la Luna y propaganda misteriosa.‡Récupérez un Fascicule d\'information, un Journal secret, un Exemplaire de la Voix de Ruisselune, et de la Propagande mystérieuse.‡收集一份情报手册，一份秘密日记，一期月溪镇时报和一本神秘的宣传书。‡找出資訊小冊子、秘密日誌、月溪時代雜誌出版品和神秘的宣傳計畫。',
  }
},
[26296] = {
  {
    'Coleta de provas‡Сбор доказательств‡Beweissammlung‡증거 수집‡Recolección de pruebas‡Recolección de pruebas‡Le ramassage de preuves‡搜证‡收集證據',
    nil,
    'Pegue 6 Bandanas Vermelhas.‡Добудьте 6 красных бандан.‡Sammelt 6 rote Kopftücher.‡붉은 복면 6개를 모아야 합니다.‡Consigue 6 pañuelos rojos.‡Consigue 6 pañuelos rojos.‡Récupérez 6 Foulards rouges.‡收集6根红头巾。‡收集6條紅色頭巾。',
  }
},
[26297] = {
  {
    'O alvorecer de um novo dia‡Заря нового дня‡Der Anbruch eines neuen Tages‡새 시대의 조짐‡El amanecer de un nuevo día‡El amanecer de un nuevo día‡L\'aube d\'un nouveau jour‡崭新的一天‡全新一天的黎明',
    nil,
    'Traga informações da Reunião do Arroio da Lua.‡Отправляйтесь на условленое место в Луноречье и добудьте необходимую информацию.‡Sammelt Informationen bei der Versammlung von Mondbruch.‡달빛시내 모임에서 정보를 수집해야 합니다.‡Obtén información en la concentración de Arroyo de la Luna.‡Obtén información en la concentración de Arroyo de la Luna.‡Rassemblez des informations au Rassemblement de Ruisselune.‡从月溪镇集会上收集情报。‡從月溪鎮的集會收集情報。',
  }
},
[26298] = {
  {
    'A caçada ao Yennikan‡Поиски Йеннику‡Die Suche nach Yenniku‡예니쿠 수색‡Caza para Yenniku‡Caza para Yenniku‡Les malheurs de Yenniku‡为耶尼库而杀‡耶尼庫的下落',
    nil,
    'Junte 6 Presas de Sanguescalpo dos trolls Sanguescalpo nas Ruínas de Bal\'lal.‡Добудьте 6 клыков троллей из племени Кровавого Скальпа в руинах Бал\'лал.‡Beschafft 6 Hauer der Blutskalpe von Blutskalptrollen in den Ruinen von Bal\'lal.‡발랄 폐허에 있는 붉은머리 부족으로부터 붉은머리의 엄니 6개를 모아야 합니다.‡Obtén 6 colmillos de Sangrapellejo de los trols Sangrapellejo que hay en las Ruinas de Bal\'lal.‡Obtén 6 colmillos de Sangrapellejo de los trols Sangrapellejo que hay en las Ruinas de Bal\'lal.‡Récupérez 6 Défenses de Scalp-rouge, dans les Ruines de Bal’lal.‡从巴拉尔废墟的血顶巨魔身上获得6颗血顶獠牙。‡在巴拉爾廢墟取得6個血頂食人妖的獠牙。',
  }
},
[26299] = {
  {
    'Caçando cabeças‡Охота за головами‡Kopfjägerei‡인간사냥꾼‡Caza cabezas‡Caza cabezas‡Les chasseurs de tête‡猎头‡獵頭行動',
    nil,
    'Colete 25 Cabeças Encolhidas dos trolls Sanguescalpo nas Ruínas Zuuldaia.‡Раздобудьте 25 сушеных голов, которые носят при себе тролли из племени Кровавого Скальпа, живущие в руинах Зуулдая.‡Beschafft 25 Schrumpfköpfe von Blutskalptrollen in den Ruinen von Zuuldaia.‡줄다이아 폐허에 있는 붉은머리 부족으로부터 쭈그러든 해골 25개를 모아야 합니다.‡Obtén 25 cabezas reducidas de los trols Sangrapellejo en las Ruinas Zuuldaia.‡Obtén 25 cabezas reducidas de los trols Sangrapellejo en las Ruinas Zuuldaia.‡Prenez 25 Têtes réduites aux Trolls scalps-rouges dans les Ruines de Zuuldaia.‡从祖丹亚废墟的血顶巨魔那里获得25个皱缩的徽记。‡在祖丹亞廢墟的血頂食人妖身上收集25個皺縮頭顱。',
  }
},
[26300] = {
  {
    'Nezzliok saberá‡Знания Неззилока‡Nezzliok wird es wissen‡네즐뤼크가 알아내리‡Nezzliok lo sabrá‡Nezzliok lo sabrá‡Nezzliok le sait‡奈兹里奥克知道‡奈茲里奧克會知道',
    nil,
    'Pegue a Cabeça de Nezzliok, o Ríspido, em Zul\'Kanda.‡Отрубите голову Неззилоку Зловещему в Зул\'Кунде.‡Erhaltet Nezzlioks Kopf von Nezzliok dem Düsteren in Zul\'Kunda.‡줄쿤다에 있는 공포의 네즐뤼크로부터 네즐뤼크의 머리카락을 얻어야 합니다.‡Obtén la cabeza de Nezzliok de Nezzliok el Temible en Zul\'Kunda.‡Obtén la cabeza de Nezzliok de Nezzliok el Temible en Zul\'Kunda.‡Coupez la tête de Nezzliok le Redoutable à Zul\'Kunda.‡从祖昆达可怕的奈兹里奥克那里获得奈兹里奥克的徽记。‡在祖昆達內從可怕的奈茲里奧克身上取得奈茲里奧克的頭顱。',
  }
},
[26301] = {
  {
    'Falando com Nezzliok‡Разговор с Неззилоком‡Mit Nezzliok sprechen‡네즐뤼크와의 대화‡Hablando con Nezzliok‡Hablando con Nezzliok‡Entretien avec un troll mort‡同奈兹里奥克交谈‡和奈茲里奧克談談',
    nil,
    'Consiga o Troféu de Balia\'mah e o Troféu de Ziata\'jai das ruínas dos Rachacrânio, que ficam na Selva do Espinhaço Setentrional.‡Добудьте трофей из Балиа\'ма и Зиата\'джай в руинах Дробителей Черепов в Северной Тернистой долине.‡Erhaltet eine Trophäe von Balia\'mah und eine Trophäe von Ziata\'jai aus den Ruinen der Schädelspalter.‡북부 가시덤불의 백골가루 폐허에 있는 발리아마 전리품 해골과 지아타자이 전리품 해골을 얻어야 합니다.‡Obtén un trofeo de Balia\'mah y un trofeo de Ziata\'jai de las ruinas de los Machacacráneos en el Norte de la Vega de Tuercespina.‡Obtén un trofeo de Balia\'mah y un trofeo de Ziata\'jai de las ruinas de los Machacacráneos en el Norte de la Vega de Tuercespina.‡Emparez-vous d’un Trophée de Balia\'mah et d’un Trophée de Ziata\'jai, dans les ruines des Casse-crânes en Strangleronce septentrionale.‡从北荆棘谷的劈颅废墟里获得巴里亚曼战利品和赞塔加战利品。‡在北荊棘谷的劈顱食人妖廢墟取得巴里亞曼戰利品和贊塔加戰利品。',
  }
},
[26302] = {
  {
    'Procurando o destino de Yennikan‡Судьба Йеннику‡Yennikus Schicksal hinterher‡예니쿠의 생사를 찾아서‡Tras el destino de Yenniku‡Tras el destino de Yenniku‡Le destin contrarié de Yenniku‡追逐耶尼库的命运‡追查耶尼庫的命運',
    nil,
    'Fale com Kin\'weelay em Bambala.‡Поговорите с Кин\'вилаем в Бамбале.‡Sprecht mit Kin\'weelay in Bambala.‡밤발라에 있는 킨윌레이와 대화해야 합니다.‡Habla con Kin\'weelay en Bambala.‡Habla con Kin\'weelay en Bambala.‡Parlez à Kin\'weelay, à Bambala‡跟邦巴拉的肯维雷谈一谈。‡到班姆巴拉和肯維雷談談。',
  }
},
[26303] = {
  {
    'O Olho da Mente‡Око разума‡Das Gedankenauge‡마음의 눈‡El Ojo de la mente‡El Ojo de la mente‡La vue de l\'esprit‡心灵之眼‡心靈之眼',
    nil,
    'Pegue o Olho da Mente de Mai\'Zoth.‡Отнимите Око разума у Май\'Зота.‡Erhaltet das Gedankenauge von Mai\'Zoth.‡마이조스로부터 마음의 눈을 획득해야 합니다.‡Obtén el Ojo de la mente de Mai\'Zoth.‡Obtén el Ojo de la mente de Mai\'Zoth.‡Emparez-vous de la Vue de l’esprit gardée par Mai’Zoth.‡从麦佐斯那里获得心灵之眼。‡從麥佐斯身上取得心靈之眼。',
  }
},
[26304] = {
  {
    'A noite na selva‡Ночь в джунглях‡Wenn es Nacht wird im Dschungel‡밀림의 밤‡Noche en la jungla‡Noche en la jungla‡La flamme du souvenir‡丛林之夜‡在叢林的夜晚',
    nil,
    'Apague 8 Braseiros de Zul\'Mamwe em Zul\'Mamwe, que fica na Selva do Espinhaço Setentrional.‡Потушите 8 жаровен в Зул\'Мамве, что в Северной Тернистой долине.‡Löscht 8 Kohlenpfannen von Zul\'Mamwe in Zul\'Mamwe im Nördlichen Schlingendorntal.‡북부 가시덤불의 줄맘웨에 있는 줄맘웨 화로 8개를 꺼야 합니다.‡Apaga 8 braseros de Zul\'Mamwe en Zul\'Mamwe, en el Norte de la Vega de Tuercespina.‡Apaga 8 blandones de Zul\'Mamwe en Zul\'Mamwe, en el Norte de la Vega de Tuercespina.‡Éteignez 8 Braseros de Zul\'Mamwe, en Strangleronce septentrionale.‡扑灭北荆棘谷祖玛维的8个祖玛维火盆。‡在北荊棘谷的祖瑪維撲滅8個祖瑪維火盆。',
  }
},
[26305] = {
  {
    'Salvando Yennikan‡Спасение Йеннику‡Yennikus Rettung‡예니쿠 구출‡Salvar a Yenniku‡Salvar a Yenniku‡Il faut sauver le troll Yenniku‡拯救耶尼库‡拯救耶尼庫',
    nil,
    'Leve a Joia de Alma Plena para Nimboya.‡Отнесите Нимбойе наполненный самоцвет Души.‡Bringt den gefüllten Seelenedelstein zu Nimboya.‡님보야에게 충만한 영혼의 보석을 가져가야 합니다.‡Lleva la gema de alma llena a Nimboya.‡Lleva la gema de alma llena a Nimboya.‡Apportez la Gemme d’âme capturée à Nimboya.‡将装满的灵魂宝石带给尼姆布亚。‡將充盈的靈魂寶石帶給尼姆布亞。',
  }
},
[26306] = {
  {
    'Início da retomada‡Начало расправы‡Anfang der Zurückeroberung‡복수의 서막‡Empieza la reconquista‡Empieza la reconquista‡La riposte commence‡讨回血债‡開始奪回',
    nil,
    'Mate 5 Mandingueiros Ramatorpe e 5 Caçadores de Cabeças Ramatorpe em Jintha\'Alor.‡Убейте 5 знахарей и 5 охотников за головами из племени Порочной Ветви в Джинта\'Алоре.‡Tötet 5 Hexendoktoren der Blutfratzen und 5 Kopfjäger der Blutfratzen in Jintha\'Alor.‡진타알로에 있는 썩은가지 의술사와 썩은가지 인간사냥꾼을 각각 5명 씩 처치해야 합니다.‡Mata a 5 médicos brujos Vilrama y a 5 rebanacabezas Vilrama en Jintha\'Alor.‡Mata a 5 médicos brujos Vilrama y a 5 rebanacabezas Vilrama en Jintha\'Alor.‡Tuez 5 Féticheurs et 5 Chasseurs de tête vilebranches à Jintha’Alor.‡在辛萨罗杀死5名邪枝巫医和5名邪枝猎头者。‡到辛薩羅殺死5個邪枝巫醫和5個邪枝獵頭者。',
  }
},
[26307] = {
  {
    'Morte aos Ramatorpe‡Смерть Порочной Ветви!‡Tod den Blutfratzen‡썩은가지 부족에 죽음을‡Muerte a los Vilrama‡Muerte a los Vilrama‡Mort aux Vilebranches‡邪枝之死‡邪枝之死',
    nil,
    'Mate 5 Berserkers Ramatorpe e 1 Lança-sombras Ramatorpe em Jintha\'Alor.‡Убейте 5 берсерков и 5 темных чародеев из племени Порочной Ветви в Джинта\'Алоре.‡Tötet 5 Berserker der Blutfratzen und 5 Schattenzauberer der Blutfratzen in Jintha\'Alor.‡진타알로에 있는 썩은가지 광전사 5명과 썩은가지 흑마술사 5명을 처치해야 합니다.‡Mata a 5 rabiosos Vilrama y a 5 taumaturgos Vilrama en Jintha\'Alor.‡Mata a 5 rabiosos Vilrama y a 5 taumaturgos Vilrama en Jintha\'Alor.‡Tuez 5 Berserkers et 5 exhalombres vilebranches à Jintha’Alor.‡在辛萨罗杀死5名邪枝狂战士和5名邪枝暗影法师。‡到辛薩羅殺死5個邪枝狂戰士和5個邪枝暗影施法者。',
  }
},
[26308] = {
  {
    'É nossa agora‡Победа наша!‡Das gehört jetzt uns‡이제 우리의 것‡Ahora es nuestra‡Ahora es nuestra‡À nous Jintha\'Alor !‡现在它是我们的了‡現在是我們的了',
    nil,
    'Mate 5 Bebe-sangue Ramatorpe e 5 Devoradores de Almas Ramatorpe em Jintha\'Alor.‡Убейте 5 кровопийц и 5 пожирателей душ из племени Порочной Ветви в Джинта\'Алоре.‡Tötet 5 Bluttrinker der Blutfratzen und 5 Seelenfresser der Blutfratzen in Jintha\'Alor.‡진타알로에 있는 썩은가지 혈투사와 썩은가지 영혼사냥꾼을 각각 5명씩 처치해야 합니다.‡Mata a 5 bebesangre Vilrama y a 5 comealmas Vilrama en Jintha\'Alor.‡Mata a 5 bebesangre Vilrama y a 5 comealmas Vilrama en Jintha\'Alor.‡Tuez 5 Mangeurs d’âme et 5 Sanguinaires vilebranches à Jintha’Alor.‡在辛萨罗杀死5名邪枝饮血者和5名邪枝噬魂者。‡到辛薩羅殺死5個邪枝飲血者和5個邪枝噬魂者。',
  }
},
[26309] = {
  {
    'Caldeirões negros‡Темные сосуды‡Dunkle Gefäße‡어둠의 용기‡Vasijas oscuras‡Vasijas oscuras‡Les calices ténébreux‡黑暗容器‡黑暗之瓶',
    nil,
    'Recolha 5 Recipientes com Sangue Maculado em Jintha\'alor.‡Соберите 5 Сосудов с порченой кровью в Джинта\'Алоре.‡Beschafft 5 Gefäße mit besudeltem Blut aus Jintha\'Alor.‡진타알로에서 얼룩진 피가 담긴 용기 5개를 모아야 합니다.‡Reúne 5 vasijas de sangre corrupta en Jintha\'alor.‡Reúne 5 vasijas de sangre corrupta en Jintha\'alor.‡Récupérez 5 Calices de sang corrompu à Jintha’Alor.‡在辛萨罗收集5份腐化之血。‡到辛薩羅收集5瓶腐化之血。',
  }
},
[26310] = {
  {
    'Tudo que rasteja‡Быстролапые паучата‡Alles, was krabbelt‡기어 다니는 것들‡Todo lo que se desliza‡Todo lo que se desliza‡Tout ce qui grouille‡那些小东西们‡蜘蜘蛛蛛',
    nil,
    'Recolha 8 Aranitos Espocantes em Jintha\'Alor.‡Соберите 8 быстролапых паучков в Джинта\'Алоре.‡Sammelt 8 huschende Spinnlinge in Jintha\'Alor.‡진타알로에 있는 새끼 땅거미 8마리를 모아야 합니다.‡Reúne 8 arañitas deslizantes en Jintha\'Alor.‡Reúne 8 arañitas deslizantes en Jintha\'Alor.‡Collectez 8 Jeunes araignées grouillantes à Jintha’Alor.‡在辛萨罗抓8只迅捷小蜘蛛。‡到辛薩羅收集8隻粘絲小蜘蛛。',
  }
},
[26311] = {
  {
    'Águas estranhas‡Неизведанные воды‡Unbekannte Gewässer‡익숙하지 않은 물길‡Aguas poco familiares‡Aguas poco familiares‡Dans des eaux peu familières‡未知水域‡不熟悉的水域',
    nil,
    'Localize Herezegor Presardente na Pousada Cauda da Manticora no Vale da Honra, que fica em Orgrimmar, e obtenha o Mapa Costeiro do Planalto do Crepúsculo.‡Найдите Эрезегора Огнеклыка в таверне "Хвост виверны", которая расположена на Аллее Чести в Оргриммаре. Возьмите у него карту побережья Сумеречного нагорья.‡Findet Herezegor Flammenhauer in der Kneipe "Zum Wyvernschweif" im Tal der Ehre in Orgrimmar und besorgt Euch eine Küstenkarte des Schattenhochlands.‡오그리마 안 명예의 골짜기에 있는 와이번 꼬리 여관에서 헤레즈고르 플레임터스크를 찾아, 황혼의 고원 해안 도표를 얻어야 합니다.‡Busca a Herezegor Colmifuego en la taberna Cola de dracoleón en el Valle del Honor, en Orgrimmar, y consigue un mapa costero de las Tierras Altas Crepusculares.‡Busca a Herezegor Colmifuego en la taberna Cola de dracoleón en el Valle del Honor, en Orgrimmar, y consigue un mapa costero de las Tierras Altas Crepusculares.‡Localisez Herezegor Brocheflamme à l\'Auberge de la Queue de Wyverne, dans la Vallée de l\'Honneur d\'Orgrimmar, et procurez-vous une Carte côtière des hautes-terres du Crépuscule.‡在奥格瑞玛荣誉谷的飞龙之尾旅店找到西雷泽戈·火牙，并拿到暮光高地海岸图。‡前往奧格瑪榮譽谷的雙足翼龍之尾酒館，找到希爾柴戈爾·焰牙，並取得一份暮光高地沿岸海圖。',
  }
},
[26312] = {
  {
    'Alívio imediato‡Неравный бой‡Bröckelnde Verteidigung‡허술한 방어‡Defensas desmoronadas‡Defensas desmoronadas‡Les défenses s’affaiblissent‡破碎的防御‡防線崩潰',
    nil,
    'Alivie a situação de Tawn Pedra Nevada, da Tempestária Mylra e de Hargoth Flamaturva, ajudando-os a derrotar os inimigos.‡Помогите Тону Зимнему Утесу, буревестнице Милре и Харготу Бледному Пламени победить их противников, чтобы они смогли перевести дух.‡Entlastet Tawn Winterfels, Sturmruferin Mylra und Hargoth Trübflamm, indem Ihr ihnen helft, ihre Gegner zu besiegen.‡톤 윈터블러프, 폭풍소환사 마일라, 하고스 딤블레이즈를 도와 적들을 처치해야 합니다.‡Releva a Tawn Cima del Invierno, a la clamatormentas Mylra y a Hargoth Llamatenue y ayúdales a derrotar a sus adversarios.‡Releva a Tawn Cima del Invierno, a la clamatormentas Mylra y a Hargoth Llamatenue y ayúdales a derrotar a sus adversarios.‡Aidez Tawn Pitons-d’hiver, la Mande-foudre Mylra et Hargoth Frêle-brasier à vaincre leurs adversaires.‡帮助陶恩·冬崖、风暴召唤者米尔拉和哈尔格斯·黯刃打败他们的敌人。‡幫助湯恩‧冬崖、風暴召喚者米爾拉、哈苟斯‧黯光擊敗敵人，讓他們獲得喘息的機會。',
  }
},
[26313] = {
  {
    'A raiz dos problemas‡Суть наших проблем‡Der Kern unserer Sorgen‡문제의 핵‡El núcleo de nuestros problemas‡El núcleo de nuestros problemas‡Un problème élémentaire‡麻烦的核心‡麻煩的根源',
    nil,
    'Consiga 6 Núcleos de Furionita.‡Соберите 6 сердец яростных грохотунов.‡Sammelt 6 Zornsteinkerne.‡분노석 핵 6개를 수집해야 합니다.‡Reúne 6 núcleos de Ira Pétrea.‡Reúne 6 núcleos de Ira Pétrea.‡Récupérez 6 Noyaux d’Irepierres.‡收集6颗奔岩土元素的核心‡收集6個憤石核心。',
  }
},
[26314] = {
  {
    'Maior a altura, maior a queda‡На ровной земле‡Fest auf dem Boden‡바닥으로의 초대‡Allanar el terreno‡Allanar el terreno‡Le croche-pied‡在平地上‡正面倒地',
    nil,
    'Use a Laçada de Elemêntio para derrubar 3 Serviçais de Therazane.‡Воспользуйтесь элементиевыми "кошками", чтобы сбить с ног 3 слуг Теразан.‡Benutzt die Elementiumwurfleine, um 3 Diener von Therazane von den Füßen zu holen.‡엘레멘티움 포박을 사용하여 테라제인의 하수인 3마리를 바닥에 쓰러뜨려야 합니다.‡Usa el rezón de elementium para tirar de los pies de 3 sirvientes de Therazane.‡Usa el rezón de elementium para tirar de los pies de 3 sirvientes de Therazane.‡Utilisez le Grappin en élémentium pour faire trébucher 3 Serviteurs de Therazane.‡使用源质绳钩绊倒3名塞拉赞恩的仆从。‡使用源質握繩拉倒3名瑟拉贊恩之僕。',
  }
},
[26315] = {
  {
    'Cachimbo da paz...‡Впечатляющая встреча‡Ein imposantes Aufeinandertreffen‡위풍당당한 대립‡Enfrentamiento imponente‡Enfrentamiento imponente‡Embobiner Boden‡堂堂面对‡進行對峙',
    nil,
    'Leia a Proclamação da Harmonia Telúrica para Boden, o Imponente.‡Прочитайте воззвание Служителей Земли Бодену Впечатляющему.‡Lest Boden dem Imposanten die Proklamation des Irdenen Rings vor.‡위풍당당한 보덴에게 대지 고리회 선언문을 읽어 줘야 합니다.‡Lee la proclamación del Anillo de la Tierra a Boden el Imponente.‡Lee la proclamación del Anillo de la Tierra a Boden el Imponente.‡Lisez la Proclamation du Cercle terrestre à Boden l’Imposant.‡将大地之环告文念给执行者博登听。‡宣讀陶土議會宣言給莊嚴的波登聽。',
  }
},
[26316] = {
  {
    'Cadê Jessé?‡Как дела у Джессупа?‡Worauf wartet Jessup?‡제섭 맥크리 찾기‡¿Qué hay de Jessup?‡¿Qué hay de Jessup?‡Qu\'est-ce qui retarde Jessup ?‡杰萨普怎么了？‡傑瑟普在拖啥?',
    nil,
    'Encontre Jessé Macredo no acampamento da Fortaleza Jubafria.‡Найдите Джессупа Маккри в его лагере возле форта Мерзлогривов.‡Findet Jessup McCree in seinem Lager nahe der Höhle der Frostmähnen.‡서리갈기 소굴에 있는 제섭 맥크리를 찾아야 합니다.‡Busca a Jessup McCree en su campamento en el Poblado Peloescarcha.‡Busca a Jessup McCree en su campamento en el Poblado Peloescarcha.‡Trouvez Jessup McCree à son camp, dans le Repaire des Crins-de-givre.‡去霜鬃巨魔要塞杰萨普·麦格雷的营地找他。‡到霜鬃食人妖要塞的營地找傑瑟普·麥克利。',
  }
},
[26317] = {
  {
    'Um filhote de batecauda‡Детеныш кнутохвоста‡Ein Schmetterschwanzjunges‡아기 채찍꼬리랩터‡Una prole de colazote‡Una prole de colazote‡Le touchant petit flagellant‡鞭尾幼龙‡小鞭尾迅猛龍',
    nil,
    'Leve o Filhote de Batecauda para o Clarividente Mok\'thardin no Acampamento Grom\'gol.‡Принесите детеныша кнутохвоста провозвестнику Мок\'тардину в лагерь Гром\'гол.‡Bringt das Schmetterschwanzjunge zu Scharfseher Mok\'thardin im Basislager Grom\'gol.‡그롬골 주둔지에 있는 예언자 모크타르딘에게 아기 채찍꼬리랩터를 데려가야 합니다.‡Lleva a la prole de colazote al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Lleva a la prole de colazote al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Apportez le Jeune flagellant au Long-voyant Mok\'thardin, au Campement Grom’gol.‡将鞭尾幼龙带给格罗姆高营地的先知摩克萨尔丁。‡將小鞭尾迅猛龍帶回格羅姆高營地給先知摩克薩爾丁。',
  }
},
[26318] = {
  {
    'Ponto final‡Окончание работы‡Eine unvollendete Aufgabe‡마무리 작업‡Concluyendo el trabajo‡Concluyendo el trabajo‡Faites sauter la grotte !‡致命一击‡完成工作',
    nil,
    'Vá até o fundo da caverna da Fortaleza Jubafria, mate o Chefe Brigor e ative o Detonador para explodir os túneis dos troggs.‡Проберитесь в нижнюю часть пещеры, расположенной в форте Мерзлогривов, убейте босса Бруггора и активируйте детонатор, чтобы взорвать туннели троггов.‡Dringt zum Ende der Höhle in der Höhle der Frostmähnen vor, tötet Boss Bruggor und aktiviert den Zünder, um die Troggtunnel zum Einsturz zu bringen.‡서리갈기 소굴 깊은 곳에 있는 우두머리 부르고르를 찾아 처치하고 기폭장치를 작동시켜 트로그 동굴을 폭파해야 합니다.‡Al fondo de la cueva del Poblado Peloescarcha, mata a Jefe Bruggor y activa el detonador para derrumbar los túneles de los troggs.‡Al fondo de la cueva del Poblado Peloescarcha, mata a Jefe Bruggor y activa el detonador para derrumbar los túneles de los troggs.‡Au fond de la caverne du Repaire des Crins-de-givre, tuez le Chef Bruggor et activez le Détonateur pour faire exploser les galeries des troggs.‡在霜鬃巨魔要塞洞窟的深处，杀死穴居人头目布鲁戈，启动引爆装置，炸毁穴居人通道。‡到霜鬃食人妖要塞的洞穴底部，殺掉大頭目布魯格爾，啟動引爆器，轟掉穴居怪的隧道。',
  }
},
[26319] = {
  {
    'Segredos revelados‡Тайна раскрыта‡Gelöste Geheimnisse‡밝혀진 비밀‡Secretos revelados‡Secretos revelados‡Des secrets révélés‡揭开秘密‡發掘秘密',
    nil,
    'Fale com Thorálius, o Sábio, no Arroio da Lua, em Cerro Oeste.‡Поговорите с Торелием Мудрым в Луноречье в Западном крае.‡Sprecht mit Thoralius dem Weisen in Mondbruch in Westfall.‡서부 몰락지대의 달빛시내 마을에 있는 현자 토랄리우스와 대화해야 합니다.‡Habla con Thoralius el Sabio en Arroyo de la Luna en Páramos de Poniente.‡Habla con Thoralius el Sabio en Arroyo de la Luna en Páramos de Poniente.‡Allez voir Thoralius le Sage à Ruisselune, dans la Marche de l\'Ouest.‡同西部荒野月溪镇的索拉留斯交谈。‡和西部荒野的月溪鎮的『智者』索拉利亞思談話。',
  }
},
[26320] = {
  {
    'Visão do Passado‡Видения прошлого‡Eine Vision aus der Vergangenheit‡과거의 환영‡Una visión del pasado‡Una visión del pasado‡Une vision du passé‡过去的影像‡過去的幻象',
    nil,
    'Entre no Esconderijo dos Défias e siga a trilha de desabrigados até a masmorra das Minas Mortas. Chegando lá, use o Incensório para ver o passado.‡Войдите в убежище Братства Справедливости идите по следу бездомных до Мертвых копей. Войдите в Мертвые копи и используйте курильницу, чтобы заглянуть в прошлое.‡Betretet das Versteck der Defias und folgt der Spur der Obdachlosen in die Todesminen. Betretet den Dungeon "Die Todesminen" und benutzt das Räuchergefäß, um in die Vergangenheit zu blicken.‡데피아즈단 은신처로 들어가서 부랑자들이 만든 길을 따라 죽음의 폐광 던전으로 들어가야 합니다. 죽음의 폐광 던전에서는 향로를 사용해 과거의 환영을 봐야 합니다.‡Entra en la Ladronera de los Defias y sigue a los vagabundos hasta la mazmorra de las Minas de la Muerte. Entra en la misma y utiliza el quemador de incienso para ver el pasado.‡Entra en la Ladronera de los Defias y sigue a los vagabundos hasta la mazmorra de las Minas de la Muerte. Entra en la misma y utiliza el quemador de incienso para ver el pasado.‡Entrez dans le Repaire des Défias et suivez la colonne de sans-abri jusqu\'au Donjon des Mortemines. Pénétrez dans le Donjon des Mortemines et utilisez le Brûle-encens pour voir le passé.‡前往迪菲亚盗贼巢穴，跟着无家可归者进入死亡矿井副本，在里面使用焚香炉来看见过去。‡進入迪菲亞盜賊巢穴，跟著遊民的蹤跡到死亡礦坑地牢。進入死亡礦坑地牢使用薰香爐窺視過去。',
  }
},
[26321] = {
  {
    'Eu acho que ela está com fome‡Не покормишь – не вырастишь‡Ich glaube, sie hat Hunger‡배가 고파요‡Creo que tiene hambre‡Creo que tiene hambre‡Le fin flagellant flageolant de faim‡我想她饿了‡我想她餓了',
    nil,
    'Mate murlocs Umbrânquia na Selva do Espinhaço Setentrional e deixe o seu Raptor Batecauda dar 40 mordidas na carne de murloc.‡Добывайте мурлоков из племени Черножабрых в Северной Тернистой долине и кормите своего ящера-кнутохвоста их мясом, пока он не съест 40 кусочков.‡Tötet Murlocs der Düsterkiemen im Nördlichen Schlingendorntal und gebt Eurem Schmetterschwanz 40 Bissen Murlocfleisch.‡북부 가시덤불에 있는 검은아가미 멀록을 처치하고 아기 채찍꼬리랩터가 고기를 40회 뜯어 먹게 해야 합니다.‡Mata múrlocs Ancaniebla en el Norte de la Vega de Tuercespina y dale de comer 40 bocados de su carne a tu raptor colazote.‡Mata múrlocs Ancaniebla en el Norte de la Vega de Tuercespina y dale de comer 40 bocados de su carne a tu raptor colazote.‡Tuez des Murlocs branchie-bistre, en Strangleronce septentrionale, et laissez votre Raptor flagellant manger 40 bouchées de leur viande.‡在北荆棘谷杀死黑腮鱼人，让你的鞭尾迅猛龙吃40口。‡殺死北荊棘谷的黑鰓魚人，然後讓你的鞭尾迅猛龍咬40口他們的肉。',
  }
},
[26322] = {
  {
    'A ascensão da Irmandade‡Восстание Братства‡Aufstieg der Bruderschaft‡결사단의 부활‡El alzamiento de la Hermandad‡El alzamiento de la Hermandad‡Le soulèvement de la Confrérie‡兄弟会的崛起‡兄弟會的崛起',
    nil,
    'Testemunhe a ascensão da Irmandade.‡Станьте свидетелем восстания Братства.‡Werdet Zeuge des Aufstiegs der Bruderschaft.‡결사단의 부활을 목격해야 합니다.‡Contempla el alzamiento de la Hermandad.‡Contempla el alzamiento de la Hermandad.‡Assistez au soulèvement de la Confrérie.‡见证兄弟会的崛起。‡目睹迪菲亞兄弟會的崛起。',
  }
},
[26323] = {
  {
    'O crânio favorito‡Особенный череп‡Lieblingsschädel‡선택받은 해골‡Su cráneo favorito‡Su cráneo favorito‡L’étrange gros nonos du petit raptor‡心爱的颅骨‡最珍愛的骷髏頭',
    nil,
    'Fale novamente com Nimboya no Acampamento Grom\'gol e mostre o novo crânio do seu Filhote de Batecauda.‡Вернитесь к Нимбойе в лагерь Гром\'гол и покажите ему свежий череп детеныша кнутохвоста.‡Kehrt zu Nimboya im Basislager Grom\'gol zurück und zeigt ihm den Lieblingsschädel von Eurem Schmetterschwanzjungen.‡그롬골 주둔지의 님보야에게 돌아가 아기 채찍꼬리랩터가 물고 있는 해골을 보여줘야 합니다.‡Vuelve con Nimboya en el Campamento Grom\'gol y enséñale el nuevo cráneo de tu prole de colazote.‡Vuelve con Nimboya en el Campamento Grom\'gol y enséñale el nuevo cráneo de tu prole de colazote.‡Retournez voir Nimboya au campement Grom’gol, et montrez-lui le nouveau crâne de votre Jeune flagellant‡去找格罗姆高营地的尼姆布亚，把鞭尾幼龙的新颅骨给他看。‡回格羅姆高營地找尼姆布亞，並讓他看看你的鞭尾迅猛龍找到的頭骨。',
  }
},
[26324] = {
  {
    'Alguém viu minha tropa?‡Где мой боевой флот?‡Wo ist meine Kriegsflotte?‡함대는 어디에‡¿Dónde está mi flota?‡¿Dónde está mi flota?‡La flotte tombe à l’eau‡我的舰队在哪儿？‡我的艦隊何在?',
    nil,
    'Fale com o Senhor da Guerra Krogg no Porto Borraquilha, que fica em Azshara.‡Поговорите с полководцем Кроггом в порту Трюмных Вод в Азшаре.‡Sprecht mit Kriegsfürst Krogg am Bilgepier in Azshara.‡아즈샤라의 빌지워터 항구에 있는 장군 크로그와 대화해야 합니다.‡Habla con el señor de la guerra Krogg en el Puerto Pantoque en Azshara.‡Habla con el señor de la guerra Krogg en el Puerto Pantoque en Azshara.‡Allez voir le Seigneur de guerre Krogg au Port Baille-Fonds, en Azshara.‡同艾萨拉锈水港的督军克罗格交谈。‡到艾薩拉的污水港與督軍克羅格交談。',
  }
},
[26325] = {
  {
    'Faro para esse tipo de coisa‡Хороший нюх‡Ein Gespür für solche Dinge‡개코가 필요한 일‡Olfato para este tipo de cosas‡Olfato para este tipo de cosas‡Le flagellant a du nez‡鼻子就是干这个的‡專門嗅這些東西的鼻子',
    nil,
    'Use o seu Filhote de Batecauda para farejar 8 Fetiches de Zuuldaia.‡C помощью детеныша кнутохвоста найдите 8 зуулдайских фетишей.‡Lasst Euer Schmetterschwanzjunges 8 Fetische von Zuuldaia aufspüren.‡아기 채찍꼬리랩터의 냄새맡는 능력을 이용해 8개의 줄다이아 우상을 찾아야 합니다.‡Utiliza tu prole de colazote para rastrear 8 fetiches de Zuuldaia.‡Utiliza tu prole de colazote para rastrear 8 fetiches de Zuuldaia.‡Utilisez le flair de votre Jeune flagellant pour déterrer 8 Fétiches zuuldaiens.‡让鞭尾幼龙嗅出8尊祖丹亚神像的所在。‡用你的鞭尾迅猛龍嗅出8個祖丹亞神像。',
  }
},
[26326] = {
  {
    'A terra onde pisamos‡Сама земля под нашими ногами‡Die Erde unter unseren Füßen‡우리가 딛고 서 있는 땅‡La tierra bajo nuestros pies‡La tierra bajo nuestros pies‡La terre sous nos pieds‡我们脚下的这片大地‡我們腳下的土地',
    nil,
    'Encontre o Arauto da Terra Torunscar, que está logo a noroeste do Templo da Terra, no Deserto Dentado.‡Найдите заклинателя земли Торунскара северо-западнее храма Земли, в Бугристых пустошах.‡Sucht nach Erdenrufer Torunskar direkt nordwestlich des Tempels der Erde in der Zackenwüste.‡톱니 황무지의 대지의 사원 바로 북서쪽에 있는 대지술사 토룬스카를 찾아야 합니다.‡Encuentra al clamatierras Torunscar justo al noroeste del Templo de la Tierra, en las Ruinas Dentadas.‡Encuentra al clamatierras Torunscar justo al noroeste del Templo de la Tierra, en las Ruinas Dentadas.‡Trouvez l’Implorateur de la terre Torunscar juste au nord-ouest du Temple de la Terre, dans le Désert Déchiqueté.‡去崎石废土大地神殿的西北角找到唤地者托伦斯卡。‡進入鋸齒荒地，在大地神殿的西北邊找到喚地者托倫斯卡。',
  }
},
[26327] = {
  {
    'Sidermar, o Herói‡Герой Старая Наковальня‡Ambossar der Held‡영웅 타르가스 앤빌마‡Yunquemar el Héroe‡Yunquemar el Héroe‡Courbenclume le Héros‡英雄安威玛尔‡大英雄安威瑪',
    nil,
    'Fale com Thargas Sidermar.‡Поговорите с Таргасом Старой Наковальней.‡Redet mit Thargas Ambossar.‡타르가스 앤빌마와 대화해야 합니다.‡Habla con Thargas Yunquemar.‡Habla con Thargas Yunquemar.‡Allez parler à Thargas Courbenclume.‡同萨尔加斯·安威玛尔交谈。‡找薩爾加斯·安威瑪說話。',
  }
},
[26328] = {
  {
    'Conversa de pedras‡Крепкие отношения‡Steinige Beziehungen‡바위와 함께 협상을‡Relaciones rocosas‡Relaciones rocosas‡La géomancie‡磐石关系‡岩石的關聯',
    nil,
    'Encontre Diamant, o Paciente, na fronteira nordeste do Deserto Dentado.‡Найдите Диаманта Терпеливого на северо-восточном краю Бугристых пустошей.‡Findet Diamant den Geduldigen am nordöstlichen Rand der Zackenwüste.‡톱니 황무지 북동쪽 경계에 있는 기다리는 디아만트를 찾아야 합니다.‡Encuentra a Diamant el Paciente al noreste de las Ruinas Dentadas.‡Encuentra a Diamant el Paciente al noreste de las Ruinas Dentadas.‡Trouvez Diamant le Patient à l’extrémité nord-est du Désert Déchiqueté.‡去找崎石废土的东南的耐心者岱亚曼塔。‡在鋸齒荒地的東北緣找到有耐心的戴門。',
  }
},
[26329] = {
  {
    'Só mais uma coisinha...‡Еще одно дело‡Und noch etwas‡또 다른 부탁‡Una cosa más‡Una cosa más‡Encore une chose‡还有一件事‡還有一件事',
    nil,
    'Entregue o Relatório de Jessé para o Grão-faz-tudo Mekkatorque na Vila da Gambiarra.‡Отнесите донесение Джессупа главному механику Меггакруту в Новый Город Механиков.‡Bringt Jessups Bericht zu Hochtüftler Mekkadrill in Neu-Tüftlerstadt.‡제섭의 보고서를 신 땜장이 마을에 있는 땜장이왕 멕카토크에게 가져가야 합니다.‡Entrega el informe de Jessup al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Entrega el informe de Jessup al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Remettez le Rapport de Jessup au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡把杰萨普的报告书交给新工匠镇的大工匠梅卡托克。‡到新地精區，把傑瑟普的報告交給大工匠梅卡托克。',
  }
},
[26330] = {
  {
    'Quem é o troll grande?‡Кто тут большой тролль?‡Wer ist ein großer Troll?‡덩치 큰 트롤은 누구?‡¿Quién es un trol grandote?‡¿Quién es un trol grandote?‡Qui est un grand troll ?‡谁是大个子巨魔？‡誰是食人妖老大?',
    nil,
    'Pegue o Corpo do Gan\'zulah em Zul\'Kanda.‡Добудьте тело Ган\'зулаха из Зул\'Кунды.‡Holt Gan\'zulahs Leiche aus Zul\'Kunda.‡줄쿤다에서 간줄라의 유해를 획득해야 합니다.‡Consigue el cuerpo de Gan\'zulah en Zul\'Kunda.‡Consigue el cuerpo de Gan\'zulah en Zul\'Kunda.‡Emparez-vous du Corps de Gan’zulah à Zul’kunda.‡到祖昆达获得甘祖拉恩的躯体。‡從祖昆達取得甘祖拉恩的屍體。',
  }
},
[26331] = {
  {
    'Os lacaios do Esmagrenagem‡Приспешники Шестерямстера‡Ritzelstoß\' Handlanger‡크러쉬코그의 추종자들‡Los esbirros de Prensadiente‡Los esbirros de Prensadiente‡Les sbires de Brisedent‡碎轮的爪牙‡碾輪的爪牙',
    nil,
    'Mate 8 Lacaios do Esmagrenagem no Arsenal do Esmagrenagem. Você pode matar Técnicos Irradiados ou Trajes de Batalha do Esmagrenagem.‡Убейте 8 приспешников Шестерямстера в арсенале Шестерямстера. Вы можете убивать облученных техников или боевых роботов Шестерямстера.‡Tötet 8 von Ritzelstoß\' Handlangern in Ritzelstoß\' Arsenal. Ihr könnt wahlweise bestrahlte Techniker oder Ritzelstoß\' Kampfanzüge töten.‡크러쉬코그의 무기고에 있는 방사능에 노출된 기술병이나 크러쉬코그 전투중장갑 8기를 처치해야 합니다.‡Mata a 8 esbirros de Prensadiente en el Arsenal de Prensadiente. Puedes matar a técnicos irradiados o a trajes de batalla Prensadiente.‡Mata a 8 esbirros de Prensadiente en el Arsenal de Prensadiente. Puedes matar a técnicos irradiados o a trajes de batalla Prensadiente.‡Tuez 8 sbires de Brisedent à l’Arsenal de Brisedent. Vous pouvez tuer des Techniciens irradiés ou des Armures de combat de Brisedent.‡在碎轮的军械库杀死8名碎轮的爪牙。你可以杀死被辐射的技师或碎轮机动战士。‡到碾輪兵工廠去殺掉8名碾輪的爪牙。你可以殺死輻射技師或碾輪戰鬥裝。',
  }
},
[26332] = {
  {
    'Mojo Rachacrânio‡Зелье Дробителей Черепов‡Mojo der Schädelspalter‡백골가루 모조‡Mojo Machacacráneos‡Mojo Machacacráneos‡Le mojo des Casse-crânes‡劈颅巨魔的魔精‡劈顱食人妖魔精',
    nil,
    'Pegue 6 Mojos de Lança Partida de trolls Lança Partida nas Ruínas Ziata\'jai e nas Ruínas de Balia\'mah.‡Добудьте 6 зелий Дробителей Черепов у троллей Дробителей Черепов в руинах Зиата\'джай и в руинах Балиа\'ма.‡Erhaltet 6 Mojos der Schädelspalter von Trollen der Schädelspalter in den Ruinen von Ziata\'jai und den Ruinen von Balia\'mah.‡지아타자이 폐허와 발리아마 폐허의 백골가루 트롤에게서 백골가루 모조 6개를 획득해야 합니다.‡Consigue 6 mojos Machacacráneos de los trols Machacacráneos de las Ruinas de Ziata\'jai y las Ruinas de Balia\'mah.‡Consigue 6 mojos Machacacráneos de los trols Machacacráneos de las Ruinas de Ziata\'jai y las Ruinas de Balia\'mah.‡Récupérez 6 Mojos de Casse-crâne sur les Trolls casse-crânes dans les Ruines de Ziata\'jai et les Ruines de Balia\'mah.‡从赞塔加废墟和巴里亚曼废墟里的劈颅巨魔那里获得6份劈颅巨魔的魔精。‡在贊塔加廢墟和巴里亞曼廢墟內的劈顱食人妖身上取得6個劈顱魔精。',
  }
},
[26333] = {
  {
    'Sem tanques, por favor‡Нет танкам!‡Keine Panzer!‡탱크는 안 돼!‡¡Tanques no, gracias!‡¡Tanques no, gracias!‡Tant qu\'il y aura des tanks‡没坦克！‡坦克，不了!',
    nil,
    'Use a Tecno-granada para destruir 5 Mecanotanques Consertados no Arsenal do Esmagrenagem.‡Воспользуйтесь техно-гранатой, чтобы разрушить 5 отремонтированных механотанков в арсенале Шестерямстера.‡Benutzt die Techno-Granate, um 5 reparierte Mechanopanzer in Ritzelstoß\' Arsenal zu vernichten.‡최첨단 수류탄을 사용해 크러쉬코그의 무기고에 있는 수리한 기계보행전차 5대를 파괴해야 합니다.‡Utiliza la tecnogranada para destruir 5 mecanotanques reparados en el Arsenal de Prensadiente.‡Utiliza la tecnogranada para destruir 5 mecanotanques reparados en el Arsenal de Prensadiente.‡Utilisez la Techno-grenade pour détruire 5 Mécano-tanks réparés, à l’Arsenal de Brisedent.‡用高新榴弹在碎轮的军械库摧毁5台修复的步行坦克。‡在碾輪兵工廠使用高科技榴彈摧毀5輛修復的步行坦克。',
  }
},
[26334] = {
  {
    'Sangrelorde Mandokir‡Мандокир Повелитель Крови‡Blutfürst Mandokir‡혈군주 만도키르‡Señor sangriento Mandokir‡Señor sangriento Mandokir‡Mandokir, le seigneur sanglant‡血领主曼多基尔‡血領主曼多基爾',
    nil,
    'Entregue o Fragmento de Ovo de Raptor Batecauda para o Sangrelorde Mandokir no Acampamento Grom\'gol.‡Принесите Осколок яйца ящера-кнутохвоста Мандокиру Повелителю Крови в Лагерь Повстанцев.‡Bringt das Eierfragment eines Schmetterschwanz\' zu Blutfürst Mandokir im Basislager Grom\'gol.‡그롬골 주둔지에 있는 혈군주 만도키르에게 채찍꼬리랩터 알 조각을 가져가야 합니다.‡Entrega el fragmento de huevo de raptor colazote al Señor sangriento Mandokir en el Campamento Grom\'gol.‡Entrega el fragmento de huevo de raptor colazote al Señor sangriento Mandokir en el Campamento Grom\'gol.‡Livrez le Fragment d\'œuf de raptor flagellant au Seigneur sanglant Mandokir, au Campement Grom\'gol.‡将破碎的鞭尾迅猛龙蛋交给格罗姆高营地的血领主曼多基尔。‡將鞭尾迅猛龍龍蛋碎塊送到格羅姆高營地給血領主曼多基爾。',
  }
},
[26335] = {
  {
    'Preparando a marinha‡Готовность военно-морских сил‡Macht die Marine startklar‡해군 준비시키기‡Preparar la fuerza naval‡Preparar la fuerza naval‡Attention chérie, ça va trancher !‡海军预备‡海軍就緒',
    nil,
    'Investigue o Casco do Devastador.‡Исследуйте остов "Крушителя Врагов".‡Untersucht den Rumpf der Feindbrecher.‡원수파괴자호 선체를 조사해야 합니다.‡Investiga el casco del Rasgadversarios.‡Investiga el casco del Rasgadversarios.‡Examinez la Coque du Tranche-menace.‡调查荡寇号的船壳。‡調查破敵者號的船體。',
  }
},
[26336] = {
  {
    'Juanka Nabrava‡Мураш О\'Брин‡Wank O\'Breen‡셰익스 오브린‡Temblores O\'Breen‡Temblores O\'Breen‡Shakes O\'Breen‡沙克斯·奥布里‡沙克斯•奧布里',
    nil,
    'Encontre Juanka Nabrava na Enseada de Faldir, que fica no Planalto Arathi.‡Найдите Мураша О\'Брина в бухте Фальдира на Нагорье Арати.‡Findet Wank O\'Breen in Faldirs Bucht im Arathihochland.‡아라시 고원의 팔디르의 만에 있는 셰익스 오브린을 찾아야 합니다.‡Busca a Temblores O\'Breen en la Cala de Faldir en las Tierras Altas de Arathi.‡Busca a Temblores O\'Breen en la Cala de Faldir en las Tierras Altas de Arathi.‡Trouvez Shakes O’Breen dans la Crique de Faldir, dans les Hautes-terres d’Arathi.‡去找阿拉希高地法迪尔海湾的沙克斯·奥布里。‡在阿拉希的法迪爾海灣找到沙克斯•奧布里。',
  }
},
[26337] = {
  {
    'Fique de olho‡Снижение издержек‡Schlagfertige Überredungskunst‡적극적인 투자‡Sacudir el mercado‡Sacudir el mercado‡De la crise à la reprise‡打压市场‡戰勝市場',
    nil,
    'Rastreie um Encarregado de Borraquilha no Ancoradouro Borraquilha e dê uma prensa nele.‡Найдите где-то в Гавани Трюмных Вод штейгера картеля Трюмных Вод и припугните его.‡Sucht einen Bilgewässer Großknecht im Bilgewasserhafen und mischt ihn ein wenig auf.‡빌지워터 항만에 있는 빌지워터 현장감독을 찾아 손봐 줘야 합니다.‡Sigue a un supervisor Pantoque en algún lugar del Muelle Pantoque y dale una pequeña paliza.‡Busca a un supervisor Pantoque en algún lugar del Muelle Pantoque y dale una pequeña paliza. ‡Trouvez un Contremaître de Baille-Fonds quelque part au Havre Baille-Fonds, et donnez-lui une petite correction.‡在锈水港抓住一个锈水工头，给他上一课。‡追查一名污水碼頭的污水工頭，稍微嚇唬他一下。',
  }
},
[26338] = {
  {
    'Con-troll-e de população‡"Кон-тролль" популяции‡Bevölkerungskon-Trolle‡트롤 인구 조절‡Con-trol de la población‡Con-trol de la población‡Con-troll démographique‡巨魔人口控制‡食人妖人口控管',
    nil,
    'Mate 7 Místicos Sanguescalpo, 7 Caçadores Sanguescalpo, 7 Batedores Sanguescalpo e 1 Senhor das Feras Sanguescalpo.‡Убейте 7 мистиков, 7 охотников, 7 разведчиков и 1 повелителя зверей из племени Кровавого Скальпа.‡Tötet 7 Mystiker der Blutskalpe, 7 Jäger der Blutskalpe, 7 Späher der Blutskalpe und 1 Bestienmeister der Blutskalpe.‡붉은머리 비술사 7명, 붉은머리 사냥꾼 7명, 붉은머리 정찰병 7명, 그리고 붉은머리 야수조련사 1명을 처치해야 합니다.‡Mata 7 místicos Sangrapellejo, 7 cazadores Sangrapellejo, 7 exploradores Sangrapellejo y 1 maestro de bestias Sangrapellejo.‡Mata 7 místicos Sangrapellejo, 7 cazadores Sangrapellejo, 7 exploradores Sangrapellejo y 1 maestro de bestias Sangrapellejo.‡Tuez 7 Mystiques scalps-rouges, 7 Chasseurs scalps-rouges, 7 Éclaireurs scalps-rouges et 1 Belluaire scalp-rouge.‡杀死7名血顶秘法师、7名血顶猎人、7名血顶斥候，以及1名血顶兽王。‡殺死7名血頂秘術使、7名血頂獵人、7名血頂斥候以及1名血頂獸王。',
  }
},
[26339] = {
  {
    'Preparativos na Aldeia da Cevada‡Сбор в Поселке Пивоваров‡Vorbereitungen in Bräuhall‡브루날 마을로‡Una parada en Las Birras‡Una parada en Las Birras‡Préparatifs à Brassetout‡烈酒村的准备‡烈酒村行動',
    nil,
    'Fale com Jarvi Pisassombra na Aldeia da Cevada.‡Поговорите с Ярви Шагом Сквозь Тень в Поселке Пивоваров.‡Sprecht mit Jarvi Schattenschritt in Bräuhall.‡브루날 마을에 있는 자비 섀도스텝과 대화해야 합니다.‡Habla con Jarvi Paso Sombrío en Las Birras.‡Habla con Jarvi Paso Sombrío en Las Birras.‡Parlez à Jarvi Pas-de-l’ombre au Village de Brassetout.‡跟烈酒村的加尔维·影踪谈一谈。‡找烈酒村的加維·影步交談。',
  }
},
[26340] = {
  {
    'A caçada‡Охота‡Die Jagd‡사냥‡La caza‡La caza‡La chasse‡狩猎‡獵殺',
    nil,
    'Fale com Eucunha de Clides na Expedição do Rosarães, que fica na Selva do Espinhaço Setentrional.‡Поговорите с Барнилом Каменным Горшком в лагере экспедиции Эрнестуэя, что в Северной Тернистой долине.‡Meldet Euch bei Barnil Steinkrug bei Nesingwarys Expedition im Nördlichen Schlingendorntal.‡북부 가시덤불의 네싱워리 원정대에 있는 바닐 스톤팟에게 보고해야 합니다.‡Preséntate ante Barnil Jarropetra en la Expedición de Nesingwary en el Norte de la Vega de Tuercespina.‡Preséntate ante Barnil Jarropetra en la Expedición de Nesingwary, en el Norte de la Vega de Tuercespina.‡Présentez-vous à Barnil Potepierre, au camp de l’Expédition de Nesingwary, en Strangleronce septentrionale.‡去找北荆棘谷奈辛瓦里远征队营地的巴尼尔·石罐。‡到北荊棘谷的奈辛瓦里遠征隊營地向巴尼爾·石罐回報。',
  }
},
[26341] = {
  {
    'Os estilhaços de pedra‡Осколки камня‡Die Steinsplitter‡바위 결정‡Los fragmentos de piedra‡Los fragmentos de piedra‡Les fragments de pierre‡石之碎片‡石頭裂片',
    nil,
    'Investigue os Estilhaços de Myzrael.‡Исследуйте кристаллы Мизраэль.‡Untersucht die Splitter von Myzrael.‡미즈라엘의 결정을 조사해야 합니다.‡Investiga los fragmentos de Myzrael.‡Investiga los fragmentos de Myzrael.‡Allez inspecter les Fragments de Myzrael.‡调查密斯莱尔碎片。‡調查密斯賴爾水晶裂片。',
  }
},
[26342] = {
  {
    'Teto preto‡Закрасить черным‡Schwarzmalerei‡검게 칠해라‡Píntalo de negro‡Píntalo de negro‡Bandez-leur les yeux‡涂成黑色‡烏漆嘛黑',
    nil,
    'Use o Lança-tinta para cegar 5 Alarmobôs do Esmagrenagem.‡Воспользуйтесь краскометом, чтобы ослепить 5 караульных роботов Шестерямстера.‡Benutzt den Farbinator, um 5 von Ritzelstoß\' Späh-o-Bots die Sicht zu nehmen.‡먹칠기를 사용해 크러쉬코그 경비로봇 5대의 광학 감지 장치를 교란시켜야 합니다.‡Utiliza el Pinturizador para cegar a 5 avizores-bot de Prensadiente.‡Utiliza el Pinturizador para cegar a 5 avizores-bot de Prensadiente.‡Utilisez le Barbouillateur pour aveugler 5 Robots-factionnaires de Brisedent.‡用喷漆枪弄瞎5个碎轮哨戒机器人。‡使用漆彈槍弄瞎5個碾輪的哨衛機器人。',
  }
},
[26343] = {
  {
    'Oferta e demanda‡Спрос и предложение‡Angebot und Nachfrage‡수요와 공급‡La oferta y la demanda‡La oferta y la demanda‡L\'offre et la demande‡供求关系‡供與求',
    nil,
    'Leve 2 Peles de Crocolisco Grande do Rio para o Drizzlik na Expedição do Rosarães.‡Принесите 2 больших шкуры речного кроколиска Дриззлику в лагерь экспедиции Эрнестуэя.‡Bringt 2 große Flusskrokiliskenhäute zu Drizzlik bei Nesingwarys Expedition.‡네싱워리 원정대에 있는 드리즐릭에게 큰 민물악어 껍질 2장을 가져가야 합니다.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Expedición de Nesingwary.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Expedición de Nesingwary.‡Apportez 2 Grandes peaux de crocilisque des rivières à Drizzlik, à l’expédition Nesingwary.‡将2张淡水鳄的皮交给奈辛瓦里远征队营地的崔斯里克。‡將2張淡水鱷的皮帶去奈辛瓦里遠征隊營地給崔斯里克。',
  }
},
[26344] = {
  {
    'Algumas partes faltando‡Немного разнообразия не помешает‡Etwas Zusammenbau benötigt‡무쇠턱악어 껍질‡Hay que ensamblar‡Hay que ensamblar‡La face cachée des bottes‡组合工艺‡收集鱷魚皮',
    nil,
    'Leve 5 Peles de Crocolisco Arapuca para o Drizzlik na Expedição do Rosarães.‡Принесите 5 шкур кроколисков-хрустогрызов Дриззлику в лагерь экспедиции Эрнестуэя.‡Bringt 5 Schnappkieferkrokiliskenhäute zu Drizzlik bei Nesingwarys Expedition.‡네싱워리 원정대에 있는 드리즐릭에게 무쇠턱악어 껍질 5장을 가져가야 합니다.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Expedición de Nesingwary.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Expedición de Nesingwary.‡Rapportez 5 Peaux de crocilisque gueule-d\'acier à Drizzlik, au camp de l’Expédition de Nesingwary.‡将5张钳嘴鳄鱼皮交给奈辛瓦里远征队营地的崔斯里克。‡將5張鉗嘴鱷魚的皮帶去奈辛瓦里遠征隊營地給崔斯里克。',
  }
},
[26345] = {
  {
    'Excelsior‡Эксельзиор‡Exzelsior‡엑셀시어‡Borceguí‡Borceguí‡Excelsior‡精制‡刨花皮靴',
    nil,
    'Leve uma Pele de Crocolisco Ancião para o Drizzlik na Expedição do Rosarães.‡Принесите Дриззлику шкуру старого кроколиска в лагерь экспедиции Эрнестуэя.‡Bringt die Haut eines alten Krokilisken zu Drizzlik bei Nesingwarys Expedition.‡네싱워리 원정대에 있는 드리즐릭에게 덩치 큰 악어 껍질을 가져가야 합니다.‡Lleva una piel de crocolisco mayor a Drizzlik en la Expedición de Nesingwary.‡Lleva una piel de crocolisco mayor a Drizzlik en la Expedición de Nesingwary.‡Rapportez une Peau d’ancien crocilisque à Drizzlik, au camp de l’Expédition de Nesingwary.‡将一张老鳄鱼的皮交给奈辛瓦里远征队营地的崔斯里克。‡帶1張老海鱷的皮給奈辛瓦里遠征隊營地給崔斯里克。',
  }
},
[26346] = {
  {
    'O conto de Myzrael‡История Мизраэль‡Myzraels Geschichte‡미즈라엘의 전설‡La historia de Myzrael‡La historia de Myzrael‡L\'histoire de Myzrael‡密斯莱尔的传说‡密斯賴爾的故事',
    nil,
    'Fale novamente com Rodapeh na Ponta do Refúgio, que fica no Planalto Arathi.‡Вернитесь к Скуэрто в Опорный пункт на Нагорье Арати.‡Kehrt zu Skuerto in der Zuflucht im Arathihochland zurück.‡아라시 고원의 임시 주둔지에 있는 스쿼토에게 가야 합니다.‡Vuelve con Skuerto al Refugio de la Zaga en las Tierras Altas de Arathi.‡Vuelve con Skuerto al Refugio de la Zaga en las Tierras Altas de Arathi.‡Retournez voir Skuerto au Refuge de l’Ornière dans les Hautes-terres d’Arathi.‡去找阿拉希高地避难谷地的斯奎尔图。‡回去阿拉希高地的避難谷地找斯奎爾圖。',
  }
},
[26347] = {
  {
    'A chama não pode apagar‡Хранитель огня‡Bewahrer der Flamme‡불꽃을 지키는 자‡Guardián de la Llama‡Guardián de la Llama‡Le gardien de la flamme‡掌灯人‡火炬的守護者',
    nil,
    'Entregue 5 Gosmas do Abismo para o Capitão Calvino no Farol de Cerro Oeste.‡Принесите 5 образцов слизи из Бушующей пропасти капитану Грейсону на маяк Западного края.‡Bringt 5 Schluchtenschlamme zu Kapitän Grausohn am Leuchtturm von Westfall.‡서부 몰락지대 등대의 선장 그레이슨에게 협곡 수액 5개를 가져가야 합니다.‡Lleva 5 mocos de sima al capitán Grisillo en el Faro de Poniente.‡Lleva 5 mocos de sima al capitán Grisillo en el Faro de Poniente.‡Apportez 5 Limons du gouffre au Capitaine Grayson, au Phare de l\'Ouest‡给西部荒野灯塔的葛瑞森船长带5份裂隙软泥。‡將5個裂谷軟泥帶去西部荒野燈塔給葛瑞森船長。',
  }
},
[26348] = {
  {
    'Limpando a área‡Борьба за чистоту берегов‡Ärger an der Küste‡남아 있는 위험‡Hay moros en la costa‡Hay moros en la costa‡La côte n\'est pas sûre‡海岸尚不安全‡海岸的威脅',
    nil,
    'Mate 7 Murlocs Caçamarés e 7 Oráculos Murloc.‡Убейте 7 мурлоков-волноловов и 7 мурлоков-оракулов.‡Tötet 7 Murlocgezeitenjäger und 7 Murlocorakel.‡멀록 바다사냥꾼 7마리와 멀록 점쟁이 7마리를 처치해야 합니다.‡Mata 7 cazamareas múrloc y 7 oráculos múrloc.‡Mata 7 cazamareas múrloc y 7 oráculos múrloc.‡Tuez 7 Chasse-marées et 7 Oracles murlocs.‡杀死7名潮行鱼人和7名鱼人智者。‡殺死7個獵潮魚人和7個魚人神諭者。',
  }
},
[26349] = {
  {
    'O mar não está para peixe‡Опасность на побережье‡Bedrohung an der Küste‡해안의 위협‡La amenaza costera‡La amenaza costera‡Menace sur la côte‡岸边的威胁‡海岸上的威脅',
    nil,
    'Leve uma escama do Velho Olho-turvo para o Capitão Calvino no Farol de Cerro Oeste.‡Принесите чешуйку Старого Мрачноглаза капитану Грейсону на маяк Западного края.‡Bringt Kapitän Grausohn am Leuchtturm von Westfall eine Schuppe von Trübauge dem Alten.‡서부 몰락지대 등대에 있는 선장 그레이슨에게 늙은 거먹눈 멀록의 비늘을 가져가야 합니다.‡Lleva una escama del Viejo Ojosombrío al capitán Grisillo en el Faro de Poniente.‡Lleva una escama del Viejo Ojosombrío al capitán Grisillo en el Faro de Poniente.‡Rapportez une Ecaille du Vieux Troubloeil au Capitaine Grayson, au Phare de l\'Ouest.‡给西部荒野灯塔的葛瑞森船长带一片老瞎眼的鳞片。‡將老瞎眼的鱗片交給西部荒野燈塔旁的葛瑞森船長。',
  }
},
[26350] = {
  {
    'Sacerdotisa Hu\'rala‡Жрица Ху\'рала‡Priesterin Hu\'rala‡여사제 후랄라‡Sacerdotisa Hu\'rala‡Sacerdotisa Hu\'rala‡La prêtresse Hu\'rala‡女祭司胡纳拉‡女祭師胡瑞拉',
    nil,
    'Fale com a Sacerdotisa Hu\'rala em Bambala, que fica na Selva do Espinhaço Setentrional.‡Найдите жрицу Ху\'ралу в Бамбале в Северной Тернистой долине и поговорите с ней.‡Sprecht mit Priesterin Hu\'rala in Bambala im Nördlichen Schlingendorntal.‡북부 가시덤불의 밤발라에 있는 여사제 후랄라와 대화해야 합니다.‡Habla con la sacerdotisa Hu\'rala en Bambala en el Norte de la Vega de Tuercespina.‡Habla con la sacerdotisa Hu\'rala en Bambala en el Norte de la Vega de Tuercespina.‡Parlez à la Prêtresse Hu’rala à Bambala, en Strangleronce septentrionale.‡跟北荆棘谷邦巴拉的女祭司胡纳拉谈一谈。‡到北荊棘谷的班姆巴拉和女祭師胡瑞拉談談。',
  }
},
[26351] = {
  {
    'Visão da mente‡Внутреннее зрение‡Gedankensicht‡마음의 눈‡Visión mental‡Visión mental‡Le truc en plumes‡心灵视界‡心靈幻象',
    nil,
    'Obtenha 5 Penas de Espreitador da Selva dos Espreitadores da Selva na Selva do Espinhaço Setentrional.‡Раздобудьте 5 перьев тропического ловца в Северной Тернистой долине.‡Erhaltet 5 Dschungelpirscherfedern von Dschungelpirschern im Nördlichen Schlingendorntal.‡북부 가시덤불에 있는 줄무늬정글랩터로부터 줄무늬정글랩터 깃털 5개를 획득해야 합니다.‡Obtén 5 plumas de acechador de la selva de acechadores de la selva en el Norte de la Vega de Tuercespina.‡Obtén 5 plumas de acechador de la selva de acechadores de la selva, en el Norte de la Vega de Tuercespina.‡Récupérez 5 Plumes de traqueur de la jungle en Strangleronce septentrionale.‡从北荆棘谷丛林捕猎者身上获得5根丛林捕猎者的羽毛。‡在北荊棘谷內的叢林潛獵者身上收集5根叢林潛獵者的羽毛。',
  }
},
[26352] = {
  {
    'Plano do Cosella‡План Коззла‡Cozzles Vorhaben‡코즐의 계획‡El plan de Cozzle‡El plan de Cozzle‡Le plan de Cozzle‡考兹尔的计划‡考茲爾的計畫',
    nil,
    'Pegue a Chave do Cosella do Encarregado Cosella. Depois, pegue os Esquemas do Regulador de Combustível.‡Возьмите ключ штейгера Коззла, а затем заберите чертежи топливного регулятора.‡Nehmt Cozzles Schlüssel dem Großknecht Cozzle ab und erhaltet die Treibstoffreglerblaupausen.‡현장감독 코즐로부터 코즐의 열쇠를 획득하고, 연료조절장치 설계도를 획득해야 합니다.‡Obtén la llave de Cozzle del supervisor Cozzle y, después, obtén los planos de regulador de combustible.‡Obtén la llave de Cozzle del supervisor Cozzle y, después, obtén los planos de regulador de combustible.‡Emparez-vous des clés du Contremaître Cozzle et volez les Plans du régulateur de carburant.‡从工头考兹尔那里获得考兹尔的钥匙，然后拿到燃料调节器的蓝图。‡從工頭考茲爾身上拿走考茲爾的鑰匙，然後取得燃料調節器的藍圖。',
  }
},
[26353] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders\' versteckter Schatz‡선장 샌더스의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的藏宝‡桑德斯船長的寶藏',
    nil,
    'Encontre o baú do Capitão Albernaz e procure a próxima pista dentro dele.‡Найдите сундучок капитана Сандерса и исследуйте его в поисках следующей подсказки.‡Findet Käpt\'n Sanders\' Schließkiste und sucht darin nach dem nächsten Hinweis.‡선장 샌더스의 사물함에서 다음 단서를 찾아야 합니다.‡Encuentra el baúl del capitán Sanders y busca la siguiente pista.‡Encuentra el baúl del capitán Sanders y busca la siguiente pista.‡Trouvez le Coffre du capitaine Sanders. Fouillez-le pour trouver l\'indice suivant.‡找到杉德尔船长的提箱，寻找下一条线索。‡找到桑德斯船長的置物箱，在箱子中尋找下一條線索。',
  }
},
[26354] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders\' versteckter Schatz‡샌더스 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的藏宝‡桑德斯船長的寶藏',
    nil,
    'Encontre o velho barril perto da chaminé em ruínas e procure a próxima pista dentro dele.‡Найдите старый бочонок рядом с разрушенной трубой и исследуйте его в поисках следующей подсказки.‡Findet das alte Fass in der Nähe des verfallenen Kamins und durchsucht es nach Eurem nächsten Hinweis.‡다음 단서를 얻기 위해 굴뚝 잔해 근처에서 낡은 통을 찾아야 합니다.‡Busca el viejo barril junto a la chimenea en ruinas y busca la siguiente pista.‡Busca el viejo barril junto a la chimenea en ruinas y busca la siguiente pista.‡Trouvez le Tonneau à côté des cheminées en ruine. Fouillez-le pour trouver l\'indice suivant.‡在破烟囱附近找到旧木桶，寻找下一条线索。‡找到廢棄煙囪旁的舊木桶，在桶裡尋找下一條線索。',
  }
},
[26355] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders\' versteckter Schatz‡샌더스 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的藏宝‡桑德斯船長的寶藏',
    nil,
    'Procure a próxima pista dentro do garrafão vazio perto do moinho de vento.‡Обыщите пустой кувшин рядом с мельницей в поисках следующей подсказки.‡Durchsucht den leeren Henkelkrug neben der Windmühle nach dem nächsten Hinweis.‡다음 단서를 찾기 위해 풍차 옆에 있는 빈 단지를 살펴봐야 합니다.‡Busca la jarra vacía junto al molino de viento para encontrar la siguiente pista.‡Busca la jarra vacía junto al molino de viento para encontrar la siguiente pista.‡Cherchez la Cruche vide à côté de l\'éolienne pour trouver le prochain indice.‡在风车旁的空酒壶里寻找下一条线索。‡在風車旁的一個空水罐裡尋找下一條線索。',
  }
},
[26356] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders\' versteckter Schatz‡샌더스 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的藏宝‡桑德斯船長的寶藏',
    nil,
    'Encontre o baú do Capitão Albernaz e abra-o para receber sua recompensa.‡Найдите сундук капитана Сандерса и откройте его, чтобы получить свою награду.‡Findet Käpt\'n Sanders\' Truhe und öffnet sie. Darin befindet sich Eure Belohnung.‡보물을 얻기 위해 샌더스 선장의 보물 상자를 찾아 열어야 합니다.‡Localiza la arqueta del capitán Sanders y ábrela para obtener tu recompensa.‡Localiza la arqueta del capitán Sanders y ábrela para obtener tu recompensa.‡Localisez le Coffre au trésor du capitaine Sanders et ouvrez-le pour prendre votre récompense.‡找到并打开杉德尔船长的宝箱。‡找到桑德斯船長的箱子並打開它，取得你的獎勵。',
  }
},
[26357] = {
  {
    'As faces do mal‡Лики зла‡Gesichter des Bösen‡악마의 얼굴‡Las caras del mal‡Las caras del mal‡Les masques du mal‡邪恶的面貌‡邪惡之臉',
    nil,
    'Use a Tocha Tiki para botar fogo em 8 Carrancas em Jintha\'Alor.‡Используйте факел тики, чтобы поджечь 8 ритуальных масок тики в Джинта\'Алоре.‡Zündet mit der Tikifackel 8 Tikimasken in Jintha\'Alor an.‡티키 횃불을 사용해 진타알로에 있는 티키 가면 8개에 불을 붙여야 합니다.‡Usa la antorcha Tiki para prender fuego a 8 máscaras Tiki en Jintha\'Alor.‡Usa la antorcha Tiki para prender fuego a 8 máscaras Tiki en Jintha\'Alor.‡Utilisez la Torche à tiki pour bouter le feu à 8 Masques tikis à Jintha’Alor.‡在辛萨罗用蒂基之炬点燃8张蒂基面具。‡使用提基火炬在辛薩羅焚燒8張提基面具。',
  }
},
[26358] = {
  {
    'Força aérea quase número um‡Готовность воздушных сил‡Macht die Luftwaffe startklar‡공군 준비시키기‡Preparar la fuerza aérea‡Preparar la fuerza aérea‡La Lance de Durotar a du retard‡空军预备‡空軍就緒',
    nil,
    'Procure Flica em seu ferro-velho no Ancoradouro Borraquilha, que fica em Azshara.‡Найдите Флип на ее свалке в Гавани Трюмных Вод в Азшаре.‡Sucht nach Fliep auf ihrem Schrottplatz im Bilgewasserhafen in Azshara.‡아즈샤라의 빌지워터 항만에 있는 플리프의 작업장에서 플리프를 찾아야 합니다.‡Busca a Flip en la chatarrería del Muelle Pantoque en Azshara.‡Busca a Flip en la chatarrería del Muelle Pantoque, en Azshara. ‡Cherchez Flip dans son dépotoir au Havre Baille-Fonds, en Azshara.‡在艾萨拉锈水港的垃圾场里寻找弗利普。‡前往艾薩拉的污水碼頭，在費莉普的垃圾場裡找到費莉普。',
  }
},
[26359] = {
  {
    'Ver raptor‡Увидеть ящера‡Seht Raptor‡랩터 보기‡Visión de raptor‡Visión de raptor‡L’œil du raptor‡看见迅猛龙‡看見迅猛龍',
    nil,
    'Fale com a Sacerdotisa Hu\'rala em Bambala, que fica na Selva do Espinhaço Setentrional.‡Поговорите со жрицей Ху\'ралой в Бамбале, что в Северной Тернистой долине, чтобы поучаствовать в ритуале внутреннего зрения.‡Sprecht mit Priesterin Hu\'rala in Bambala, um am Ritual der Gedankensicht teilzunehmen.‡밤발라에 있는 여사제 후랄라와 대화하여 마음의 눈 의식에 참여해야 합니다.‡Habla con la sacerdotisa Hu\'rala en Bambala para participar en el ritual de Visión mental.‡Habla con la sacerdotisa Hu\'rala en Bambala para participar en el ritual de Visión mental.‡Parlez à la Prêtresse Hu\'rala, à Bambala, pour participer au rituel de Vision télépathique.‡跟邦巴拉的女祭司胡纳拉谈一谈，举行心灵视界仪式。‡和班姆巴拉的女祭師胡瑞拉談話以加入心靈幻象儀式。',
  }
},
[26360] = {
  {
    'Controle mental‡Контроль над разумом‡Gedankenkontrolle‡정신 지배‡Control mental‡Control mental‡Le troll cérébral‡心灵控制‡精神控制',
    nil,
    'Pegue o Grande Cérebro de Braddok do Braddok em Zul\'Mamwe.‡Добудьте большой мозг Брэддока, убив последнего в Зул\'Мамве.‡Erhaltet Braddoks Riesengehirn von Braddok in Zul\'Mamwe.‡줄맘웨에 있는 브라독에게서 브라독의 비상한 비밀을 가져가야 합니다.‡Obtén el gran cerebro de Braddok de Braddok en Zul\'Mamwe.‡Obtén el gran cerebro de Braddok de Braddok en Zul\'Mamwe.‡Récupérez le Gros cerveau de Braddock, à Zul’Mamwe.‡从祖玛维的布拉多克那里获得他的魔精。‡從祖瑪維廢墟的布拉多克身上取得布拉多克的大腦。',
  }
},
[26361] = {
  {
    'A embriaguez do sucesso‡Самофланж Смута‡Smoots Samophlang‡스무트의 사모플랜지‡El churumbele de Smoot‡El churumbele de Smoot‡Le samophlange de Smoot‡斯姆特的主动式负载平衡器‡斯穆特的負載平衡器',
    nil,
    'Encontre Makaxêra em algum lugar do Ancoradouro Borraquilha, intercepte-o e consiga a Rebimboca de Indução.‡Найдите где-то в Гавани Трюмных Вод Смута. Поймайте его и заберите индукционный самофланж.‡Findet Smoot im Bilgewasserhafen. Stellt ihn und besorgt Euch das Induktionssamophlang.‡빌지워터 항만 어딘가에서 스무트를 찾아서 멈추게 한 뒤, 유도 사모플랜지를 획득해야 합니다.‡Encuentra a Smoot en algún lugar del Muelle Pantoque. Abórdalo y consigue el churumbele de inducción.‡Encuentra a Smoot en algún lugar del Muelle Pantoque. Abórdalo y consigue el churumbele de inducción.‡Trouvez Smoot au Havre Baille-Fonds. Attaquez-le et récupérez le Samophlange à induction.‡在锈水港里找到斯姆特。把他摁倒，拿到感应主动式负载平衡器。‡在污水碼頭的某處找到斯穆特。攔住他並取得感應式負載平衡器。',
  }
},
[26362] = {
  {
    'Ser raptor‡Стать ящером‡Seid Raptor‡랩터 되기‡Sé raptor‡Sé raptor‡Dans la peau d’un raptor‡成为迅猛龙‡成為迅猛龍',
    nil,
    'Fale com a Sacerdotisa Hu\'rala. Depois, ajude o Filhote Capturado de Batecauda a escapar de Zul\'Gurub.‡Поговорите со жрицей Ху\'ралой, а потом помогите пойманному детенышу кнутохвоста сбежать из Зул\'Гуруба.‡Sprecht mit Priesterin Hu\'rala und helft dem gefangenen Schmetterschwanzjungen bei der Flucht aus Zul\'Gurub.‡여사제 후랄라와 대화하고 사로잡힌 아기 채찍꼬리랩터가 줄구룹에서 도망칠 수 있게 도와야 합니다.‡Habla con la sacerdotisa Hu\'rala y ayuda a la prole de colazote capturada a escapar de Zul\'Gurub.‡Habla con la sacerdotisa Hu\'rala y ayuda a la prole de colazote capturada a escapar de Zul\'Gurub.‡Parlez à la Prêtresse Hu’rala, et aidez le Jeune flagellant capturé à s’échapper de Zul’Gurub.‡跟女祭司胡纳拉谈一谈，帮助被抓住的鞭尾幼龙逃出祖尔格拉布。‡和女祭師胡瑞拉談談，然後幫助被俘虜的小鞭尾迅猛龍逃離祖爾格拉布。',
  }
},
[26363] = {
  {
    'O cúmulo do destino‡Судьбоносная вершина‡Schicksalsgipfel‡운명의 꼭대기‡Cima del destino‡Cima del destino‡Le sommet du destin‡命运之巅‡命運之巔',
    nil,
    'Recolha 8 Ídolos da Aranha dos Ramatorpe no cume de Jintha\'Alor.‡Соберите 8 идолов-пауков, убивая троллей племени Порочной Ветви на вершине Джинта\'Алора.‡Sammelt 8 Spinnengötzen der Blutfratzen auf dem Gipfel von Jintha\'Alor.‡진타알로의 정상에 있는 썩은가지 부족에게서 거미 우상 8개를 모아야 합니다.‡Reúne 8 ídolos arácnidos de los Vilrama en la cima de Jintha\'Alor.‡Reúne 8 ídolos arácnidos de los Vilrama en la cima de Jintha\'Alor.‡Collectez 8 Idoles d’araignée sur les Vilebranches au sommet de Jintha’Alor.‡从辛萨罗山峰的邪枝手里取得8尊蜘蛛神像。‡到辛薩羅頂部，從邪枝身上收集8個蜘蛛塑像。',
  }
},
[26364] = {
  {
    'Abaixo o Esmagrenagem!‡Долой Шестерямстера!‡Nieder mit Ritzelstoß!‡크러쉬코그를 공격하라!‡¡Abajo con Prensadiente!‡¡Abajo con Prensadiente!‡Mort à Brisedent !‡碎轮的倒台！‡擊倒碾輪!',
    nil,
    'Derrote Razlo Esmagrenagem. Fale com o Grão-faz-tudo Mekkatorque no Lago Nevado quando você estiver pronto para a batalha.‡Победите Разло Шестерямстера. Когда будете готовы начать битву, поговорите с главным механиком Меггакрутом на Заледеневшем озере.‡Besiegt Razlo Ritzelstoß. Sprecht mit Hochtüftler Mekkadrill auf dem Eiswellensee, wenn Ihr bereit seid, den Kampf zu beginnen.‡라즐로 크러쉬코그를 처치해야 합니다. 전투 준비가 완료되면 얼음 호수에 있는 땜장이왕 멕카토크와 대화하십시오.‡Derrota a Razlo Prensadiente. Habla con el Manitas Mayor Mekkatorque en el Lago Glacial cuando estés listo para la batalla.‡Derrota a Razlo Prensadiente. Habla con el Manitas Mayor Mekkatorque en el Lago Glacial cuando estés listo para la batalla.‡Terrassez Razlo Brisedent. Parlez au Grand Bricoleur Mekkanivelle, au Lac Glacial, pour déclencher le combat.‡打败拉齐诺·碎轮。做好战斗准备后，就去跟涌冰湖的大工匠梅卡托克谈谈。‡擊敗拉茲羅·碾輪。當你準備好開始戰鬥，去找湧冰湖的工匠梅卡托克交談。',
  }
},
[26365] = {
  {
    'O chamado ao heroísmo: Montanhas Cristarrubra!‡Воззвание к героям: Красногорье!‡Heldenaufruf: Rotkammgebirge!‡영웅의 부름: 붉은마루 산맥!‡Se busca héroe: ¡Montañas Crestagrana!‡Se busca héroe: ¡Montañas Crestagrana!‡L’appel du héros : les Carmines !‡召唤英雄：赤脊山！‡英雄的召喚:赤脊山',
    nil,
    'Apresente-se ao Capitão da Guarda Florestan na Torre Vigilante, que fica nas Montanhas Cristarrubra.‡Найдите капитана стражи Паркера в Часовой башне в Красногорье.‡Meldet Euch bei Wachhauptmann Parker an der Turmwacht im Rotkammgebirge.‡붉은마루 산맥의 탑 감시초소에 있는 파수대장 파커에게 보고해야 합니다.‡Preséntate ante el capitán de la Avanzada Parker en la Avanzada de la Torre en Montañas Crestagrana.‡Preséntate ante el capitán de la Avanzada Parker en la Avanzada de la Torre en Montañas Crestagrana.‡Présentez-vous au Capitaine de la garde Parker à la Tour de guet, dans les Carmines.‡去找赤脊山瞭望塔的卫兵队长帕克。‡向赤脊山警戒塔的警衛隊長派克報告。',
  }
},
[26366] = {
  {
    'Fique alerta‡Все дело в голове‡Kopfprämie‡가면 만들기‡De cabeza‡De cabeza‡Têtes en l\'air‡抬头‡抬頭',
    nil,
    'Derrote Umboda Três-cabeças e recolha a cabeça dele.‡Убейте Умбоду "Три Башки" и заберите его голову.‡Besiegt Umboda Dreikopf und holt Euch seinen Kopf.‡세 얼굴의 움보다를 처치하고 그의 머리카락을 획득해야 합니다.‡Derrota a Umboda Tres Cabezas y consigue su cabeza.‡Derrota a Umboda Tres Cabezas y consigue su cabeza.‡Tuez Umboda Trois-têtes et prenez la sienne.‡打败“三头怪”昂波达，拿到他的头。‡擊敗食人妖昂波達·三首並取得他的頭顱。',
  }
},
[26367] = {
  {
    'A vingança de Ongo\'longo‡Месть Онго\'лонго‡Ongo\'longos Rache‡옹고롱고의 복수‡La venganza de Ongo\'longo‡La venganza de Ongo\'longo‡La revanche d\'Ongo\'longo‡昂格隆格的复仇‡翁戈隆戈的復仇',
    nil,
    'Lute com Ongo\'longo até que ele se liberte.‡Деритесь с Онго\'лонго, пока он не освободится.‡Bekämpft Ongo\'longo bis er seine Fesseln sprengt.‡옹고롱고가 속박을 풀 때까지 공격해야 합니다.‡Enfréntate a Ongo\'longo hasta que se libere.‡Enfréntate a Ongo\'longo hasta que se libere.‡Combattez Ongo’longo jusqu’à ce qu’il se libère de ses chaînes.‡和昂格隆格交手，直到他挣脱束缚。‡和翁戈隆戈打鬥直到他掙脫。',
  }
},
[26368] = {
  {
    'Segredos peçonhentos‡Ядовитые секреты‡Giftige Geheimnisse‡치명적인 비밀‡Secretos venenosos‡Secretos venenosos‡Secrets venimeux‡剧毒的秘密‡惡毒的秘密',
    nil,
    'Recolha 6 Amostras de Peçonha de Crias de Shadra em Jintha\'Alor.‡Соберите 6 образцов яда Шадры с паучат Шадры в Джинта\'Алоре.‡Erhaltet 6 Giftprobe der Shadrabrut von der Brut von Shadra in Jintha\'Alor.‡진타알로에 있는 샤드라혈족 거미에게서 샤드라혈족 독 표본 6개를 모아야 합니다.‡Reúne 6 muestras de veneno de engendro de Shadra del engendro de Shadra en Jintha\'Alor.‡Reúne 6 muestras de veneno de engendro de Shadra del engendro de Shadra en Jintha\'Alor.‡Collectez 6 Échantillons de venin de rejeton de Shadra sur des Rejetons de Shadra à Jintha’Alor.‡在辛萨罗的沙德拉幼蛛身上收集6份沙德拉毒液样本。‡到辛薩羅從幼生沙德拉身上收集6個幼生沙德拉毒液樣本。',
  }
},
[26369] = {
  {
    'Caça à guardiã‡Охота на хранительницу‡Jagt die Bewahrerin‡수호자 사냥‡Caza a la vigilante‡Caza a la vigilante‡Tuez la gardienne‡捕杀守护者‡獵殺守衛者',
    nil,
    'Mate Morta\'gya, a Guardiã, e pegue a Tabuleta de Shadra.‡Убейте Морта\'гью Хранительницу и заберите у нее табличку Шадры.‡Tötet Morta\'gya die Bewahrerin und erhaltet die Tafel von Shadra.‡수호자 몰타기아를 처치하고 샤드라의 서판을 획득해야 합니다.‡Mata a Morta\'gya la Vigilante y consigue la tablilla de Shadra.‡Mata a Morta\'gya la Vigilante y consigue la tablilla de Shadra.‡Tuez Morta’gya la Gardienne et obtenez la Tablette de Shadra.‡杀死守护者莫塔加亚，获得沙德拉石板。‡殺死「守衛者」莫塔加亞並取得沙德拉石板。',
  }
},
[26370] = {
  {
    'De volta ao Morro da Sentinela‡Возвращение на Сторожевой холм‡Rückkehr zur Späherkuppe‡감시의 언덕으로 돌아가기‡De vuelta a la Colina del Centinela‡De vuelta a la Colina del Centinela‡Retour à la colline des Sentinelles‡回到哨兵岭‡回到哨兵嶺',
    nil,
    'Apresente-se ao Marechal Miguel Mantoforte no Morro da Sentinela, em Cerro Oeste.‡Доложите об увиденном маршалу Гриану Камнегриву в Сторожевой холм в Западном крае.‡Erstattet Marschall Gryan Starkmantel an der Späherkuppe in Westfall Bericht.‡서부 몰락지대의 감시의 언덕에 있는 치안대장 그라이언 스타우트맨틀에게 보고해야 합니다.‡Preséntate ante el alguacil Gryan Mantorrecio en la Colina del Centinela, en los Páramos de Poniente.‡Preséntate ante el alguacil Gryan Mantorrecio en la Colina del Centinela, en los Páramos de Poniente.‡Retournez voir le Maréchal Gryan Roidemantel à la Colline des Sentinelles, dans la Marche de l\'Ouest.‡向西部荒野哨兵岭的治安官格里安·斯托曼报告。‡向西部荒野的哨兵嶺的格里安·斯托曼保安官談話。',
  }
},
[26371] = {
  {
    'A lenda do capitão Calvino‡Легенда о капитане Грейсоне‡Die Legende des Kapitän Grausohn‡선장 그레이슨의 전설‡La leyenda del capitán Grisillo‡La leyenda del capitán Grisillo‡La légende du capitaine Grayson‡葛瑞森船长的传说‡葛瑞森船長的傳說',
    nil,
    'Encontre o Capitão Calvino no Farol de Cerro Oeste.‡Найдите капитана Грейсона на маяке Западного края.‡Findet Kapitän Grausohn beim Leuchtturm von Westfall in Westfall.‡서부 몰락지대의 서부 몰락지대 등대에서 선장 그레이슨을 찾아야 합니다.‡Encuentra al capitán Grisillo en el Faro de Poniente, en los Páramos de Poniente.‡Encuentra al capitán Grisillo en el Faro de Poniente, en los Páramos de Poniente.‡Trouvez le Capitaine Grayson au Phare de l\'Ouest, dans la marche de l\'Ouest.‡在西部荒野灯塔找到葛瑞森船长。‡到西部荒野的西部荒野燈塔找出葛瑞森船長。',
  }
},
[26372] = {
  {
    'A super máquina‡Предполетная подготовка‡Letzte Tests vor dem Flug‡비행 전 확인‡Lista previa al vuelo‡Lista previa al vuelo‡Vérifications avant décollage‡预飞检查表‡行前檢查',
    nil,
    'Fale com o Capitão Krazz no Ancoradouro Borraquilha, que fica em Azshara.‡Поговорите с капитаном Психхо в Гавани Трюмных Вод в Азшаре.‡Sprecht mit Kapitän Krazz im Bilgewasserhafen in Azshara.‡아즈샤라의 빌지워터 항만에 있는 선장 크라즈와 대화해야 합니다.‡Habla con el capitán Krazz en Muelle Pantoque en Azshara.‡Habla con el capitán Krazz en Muelle Pantoque en Azshara.‡Allez voir le Capitaine Krazz au Havre Baille-Fonds, en Azshara.‡同艾萨拉锈水港的卡拉兹船长交谈。‡到艾薩拉的污水碼頭找克拉茲上尉說話。',
  }
},
[26373] = {
  {
    'Para Kharanos e avante!‡На Каранос‡Weiter nach Kharanos‡카라노스로‡Noticias de Kharanos‡Noticias de Kharanos‡Prochaine étape : Kharanos‡前往卡拉诺斯‡到卡拉諾斯',
    nil,
    'Fale com o Capitão Tharran em Kharanos.‡Поговорите с капитаном Тарраном в Караносе.‡Sprecht mit Hauptmann Tharran in Kharanos.‡카라노스에 있는 대장 타란과 대화해야 합니다.‡Habla con el capitán Tharran en Kharanos.‡Habla con el capitán Tharran en Kharanos.‡Adressez-vous au Capitaine Tharran, à Kharanos.‡跟卡拉诺斯的萨兰恩队长谈一谈。‡到卡拉諾斯找薩蘭上尉談話。',
  }
},
[26374] = {
  {
    'Preparando as tropas terrestres‡Готовность наземных сил‡Macht die Bodentruppen startklar‡육군 준비시키기‡Preparar las tropas de tierra‡Preparar las tropas de tierra‡Préparer les troupes terrestres‡地面部队预备‡陸軍就緒',
    nil,
    'Vasculhe o Ancoradouro Borraquilha e convença 12 Brutos Desertores a se apresentarem para o serviço.‡Обыщите Гавань Трюмных Вод и убедите 12 пехотинцев-дезертиров вернуться на службу.‡Durchsucht den Bilgewasserhafen und überzeugt 12 fahnenflüchtige Grunzer, sich zum Dienst zu melden.‡빌지워터 항만을 수색해 무단 이탈한 그런트 12명을 임무에 복귀시켜야 합니다.‡Busca en el Muelle Pantoque y convence a 12 brutos prófugos para que se presenten para el servicio.‡Busca en el Muelle Pantoque y convence a 12 brutos prófugos para que se presenten para el servicio.‡Fouillez le Havre Baille-Fonds et persuadez 12 Grunts déserteurs de reprendre le service.‡搜索锈水港，说服12名擅离职守的兽人步兵回去报到。‡搜尋污水碼頭，說服12名擅離職守的蠻兵回到崗位上。',
  }
},
[26375] = {
  {
    'Pedras soltas‡Освободить скальчат‡Entfesselte Steine‡돌멩이 탈출 작전‡Majano‡Majano‡La caillasse‡释放石头‡鬆動的岩石',
    nil,
    'Use o Destruidor Delicado de Correntes para libertar 6 Pedriscos de Quartzo.‡Воспользуйтесь крошечным сокрушителем цепей, чтобы освободить 6 кварцевых скальчат.‡Benutzt den filigranen Kettensprenger, um 6 Quarzsteinlinge zu befreien.‡정교한 사슬 파쇄기를 사용하여 석영 돌멩이 정령 6마리를 풀어 줘야 합니다.‡Usa el machacadenas delicado para liberar a 6 guijarros de cuarzo.‡Usa el machacadenas delicado para liberar a 6 guijarros de cuarzo.‡Utilisez l’Écraseur de chaînes précis pour libérer 6 Rochelins de quartz.‡用精密锁链粉碎器释放6名石英巨人。‡使用精密的鎖鏈破壞器解放6個石英小岩石怪。',
  }
},
[26376] = {
  {
    'Ódio profundo‡Глубоко проникающая ненависть‡Tiefsitzender Hass‡뿌리 깊은 증오‡El odio es profundo‡El odio es profundo‡Une haine profonde‡深仇大恨‡深切的憎恨',
    nil,
    'Mate Dragul, o Mata-gigantes, e 12 Sectários do Crepúsculo no Portão de Lorthuna.‡Убейте Драгула Громадоруба и 12 сектантов Сумеречного Молота у Врат Лортуны.‡Tötet Dragul Riesenschlächter und 12 Schattenhammerkultisten an Lorthunas Tor.‡로르투나의 문에서 드라굴 자이언트부처와 황혼의 이교도 12명을 처치해야 합니다.‡Mata a Dragul Comegigantes y a 12 cultores Crepusculares en la Puerta de Lorthuna.‡Mata a Dragul Comegigantes y a 12 cultores Crepusculares en la Puerta de Lorthuna.‡Tuez Dragul Grand-boucher et 12 Sectateurs du Crépuscule près de la Porte de Lorthuna.‡杀死洛苏娜之门的巨人屠夫德拉古尔以及12名暮光异教徒。‡在洛舒娜之門殺死德拉庫爾·巨人屠夫和12名暮光教徒。',
  }
},
[26377] = {
  {
    'Terreno instável‡Нетвердая земля‡Loser Grund‡대지의 분노‡Terreno frágil‡Terreno frágil‡En terrain instable‡不毛之地‡不穩固的地面',
    nil,
    'Recolha 6 Drusas de Cristal de Jade, junte-as e esmague-as no acampamento do Portão de Lorthuna.‡Соберите 6 друз нефритовых кристаллов, совместите их, а затем разбейте в лагере Врат Лортуны.‡Sammelt 6 Jadekristallformationen und kombiniert sie miteinander. Verteilt sie dann im Lager an Lorthunas Tor.‡비취 수정 덩어리 6개를 모아 합친 다음, 로르투나의 문 야영지 안에서 깨뜨려야 합니다.‡Reúne 6 racimos de cristal de jade, combínalos y destrózalos en el interior del campamento de la Puerta de Lorthuna.‡Reúne 6 racimos de cristal de jade, combínalos y destrózalos en el interior del campamento de la Puerta de Lorthuna.‡Récupérez 6 Grappes de cristaux de jade, assemblez-les, et brisez-les en mille morceaux au camp de la Porte de Lorthuna.‡收集6块碧玉水晶簇，组合在一起，在洛苏娜之门营地里砸碎。‡收集6個碧晶簇，組合起來，然後在洛舒娜之門的營地中砸碎它們。',
  }
},
[26378] = {
  {
    'O chamado ao heroísmo: Cerro Oeste!‡Воззвание к героям: Западный Край!‡Heldenaufruf: Westfall!‡영웅의 부름: 서부 몰락지대!‡Se busca héroe: ¡Páramos de Poniente!‡Se busca héroe: ¡Páramos de Poniente!‡L\'appel du héros : la marche de l\'Ouest !‡英雄的召唤：西部荒野！‡英雄的召喚:西部荒野!',
    nil,
    'Apresente-se ao Tenente Horatio Laine no Sítio dos Jansen, em Cerro Oeste.‡Поговорите с лейтенантом Горацио Лейном во Владении Янсена в Западном Крае.‡Meldet Euch bei Leutnant Horatio Laine auf Jansens Hof in Westfall.‡서부 몰락지대의 얀센 농장에 있는 반장 호레이쇼 레인에게 보고해야 합니다.‡Preséntate ante el teniente Horatio Laine en La Finca de Jansen en Páramos de Poniente.‡Preséntate ante el teniente Horatio Laine en La Finca de Jansen en los Páramos de Poniente.‡Présentez-vous au Lieutenant Horatio Laine à la Ferme des Jansen, dans la Marche de l’Ouest.‡向西部荒野贾森农场的霍拉提奥·莱因中尉报告。‡到西部荒野的傑生農場向何瑞修‧萊恩中尉報到。',
  }
},
[26379] = {
  {
    'Socorro aos refugiados‡На помощь беженцам‡Hilfe für die Flüchtlinge‡살아남은 이들을 위하여‡Ayudar a los refugiados‡Ayudar a los refugiados‡Secourir les réfugiés‡援助难民‡幫助難民',
    nil,
    'A Sentinela Leandra, em Lor\'danel, quer que você fale com a Sacerdotisa Alinya no Acampamento de Refugiados.‡Часовой Лендра из Лор\'данела просит вас поговорить с жрицей Алинией в Лагере беженцев.‡Schildwache Lendra in Lor\'danel möchte, dass Ihr mit Priesterin Alinya im Flüchtlingslager sprecht.‡로르다넬에 있는 파수꾼 렌드라가 피난민 야영지에 있는 여사제 알리냐와 대화해 달라고 했습니다.‡La centinela Lendra de Lor\'danel quiere que hables con la sacerdotisa Alinya en el Campo de Refugiados.‡La centinela Lendra de Lor\'danel quiere que hables con la sacerdotisa Alinya en el Campo de Refugiados.‡La Sentinelle Lendra, de Lor’danel, vous a demandé d’aller parler à la Prêtresse Alinya, au Camp des réfugiés.‡洛达内尔的哨兵兰德拉要你跟难民营的女祭司艾琳雅谈一谈。‡洛丹諾的哨兵蘭卓拉希望你去難民營和女牧師艾爾琳雅談話。',
  }
},
[26380] = {
  {
    'Um pulinho em Kharanos‡На пути в Каранос‡Lieferung für Kharanos‡에일 맥주 배달‡Compromiso con Kharanos‡Compromiso con Kharanos‡C\'est le brasseur !‡前往卡拉诺斯‡前往卡拉諾斯',
    nil,
    'Leve as Barricas de Amostra para o Estalajadeiro Belm na Destilaria Cervaforte, que fica em Kharanos.‡Отнесите бочонки с элем на пробу хозяину таверны "Громоварка" Белму.‡Bringt die Probefässer zu Gastwirt Belm in der Brauerei Donnerbräu in Kharanos.‡표본 통을 카라노스의 썬더브루 양조장에 있는 여관주인 벨름에게 가져가야 합니다.‡Lleva los barriles de muestra al tabernero Belm a la Destilería Cebatruenos en Kharanos.‡Lleva los barriles de muestra al tabernero Belm a la Destilería Cebatruenos en Kharanos.‡Apportez les Tonneaux d’échantillon de bière à l’Aubergiste Belm à la Distillerie Tonnebière, à Kharanos.‡将样本桶交给卡拉诺斯雷酒酿制厂的旅店老板贝尔姆。‡將樣本桶帶去卡拉諾斯的雷酒釀酒廠給旅店老闆貝爾姆。',
  }
},
[26381] = {
  {
    'O olho de Shadra‡Глаз Шадры‡Das Auge von Shadra‡샤드라 눈‡El ojo de Shadra‡El ojo de Shadra‡L’œil de Shadra‡沙德拉之眼‡沙德拉之眼',
    nil,
    'Recupere o Olho de Shadra em Agol\'watha.‡Принесите глаз Шадры из Агол\'ваты.‡Holt das Auge von Shadra aus Agol\'watha.‡아골와타에서 샤드라 눈을 회수해야 합니다.‡Coge el ojo de Shadra en Agol\'watha.‡Coge el ojo de Shadra en Agol\'watha.‡Retrouvez l’Œil de Shadra dans Agol’watha.‡在亚戈瓦萨找到沙德拉之眼。‡從亞戈瓦薩取回沙德拉之眼。',
  }
},
[26382] = {
  {
    'Não se faz uma omelete sem...‡Без яиц яичницу не сделаешь…‡Eiertanz‡쌀이 있어야 밥을 짓지...‡No se puede hacer una tortilla sin...‡No se puede hacer una tortilla sin...‡On ne fait pas d\'omelette…‡没材料怎么做煎蛋卷……‡煎蛋餅不能沒有...',
    nil,
    'Recolha 5 Ovos da Prole de Shadra em Agol\'watha.‡Соберите 5 яиц порождения Шадры в Агол\'вате.‡Sammelt 5 Eier der Shadrabrut aus Agol\'watha.‡아골와타에서 샤드라혈족 알 5개를 모아야 합니다.‡Reúne 5 huevos engendrados de Shadra en Agol\'watha.‡Reúne 5 huevos engendrados de Shadra en Agol\'watha.‡Collectez 5 Œufs de rejeton de Shadra à Agol’watha.‡在亚戈瓦萨采集5颗沙德拉之卵。‡從亞戈瓦薩收集5個幼生沙德拉卵。',
  }
},
[26383] = {
  {
    'Os ventos da mudança‡Ветра перемен‡Unaufhaltsame Veränderungen‡변화의 파도를 뚫고‡Rompen olas de cambio‡Rompen olas de cambio‡Auberdine au creux de la vague‡乘风破浪‡突破改變的浪濤',
    nil,
    'Use a árvore teleportadora na banda oeste de Darnassus para chegar à Vila de Rut\'theran. Em seguida, fale com Vesprystus e ele o enviará a Lor\'danel.‡Воспользуйтесь телепортационным деревом в западном Дарнасе, чтобы добраться до деревни Рут\'теран, после чего побеседуйте с Вестпристом, который отправит вас в Лор\'данел.‡Benutzt den Teleportbaum im westlichen Teil von Darnassus und reist nach Rut\'theran. Sprecht dort mit Vesprystus, um einen Flug nach Lor\'danel zu sichern.‡서부 다르나서스에 있는 순간이동 나무를 이용하여 루테란 마을로 간 다음, 베스프리스투스와 대화하여 로르다넬로 가는 탈것을 구해야 합니다.‡Utiliza el árbol de teletransporte del oeste de Darnassus para llegar a la Aldea Rut\'theran. Después, habla con Vesprystus para contratar un vuelo hasta Lor\'danel.‡Utiliza el árbol de teletransporte del oeste de Darnassus para llegar a la Aldea Rut\'theran. Después, habla con Vesprystus para contratar un vuelo hasta Lor\'danel. ‡Utilisez l’arbre de téléportation, dans l’ouest de Darnassus, pour vous rendre à Rut’theran, puis allez parler à Vesprystus pour qu’il vous envoie à Lor’danel.‡用西达纳苏斯的传送树前往鲁瑟兰村，然后跟维斯派塔斯交谈飞往洛达内尔。‡在達納蘇斯西部利用傳送樹前往魯瑟蘭村，然後和維斯派塔斯說話來飛往洛丹諾。',
  }
},
[26384] = {
  {
    'Trevoclérigo Marnal‡Темный священник Марнал‡Der dunkle Kleriker Marnal‡어둠성직자 마날‡Clérigo Oscuro Marnal‡Clérigo Oscuro Marnal‡Le sombre clerc Marnal‡黑暗牧师玛尔纳‡黑暗牧師馬爾諾',
    nil,
    'Leve a Tabuleta de Shadra para o Trevoclérigo Marnal.‡Принесите табличку Шадры темному священнику Марналу.‡Bringt die Tafel von Shadra zum dunklen Kleriker Marnal.‡어둠성직자 마날에게 샤드라의 서판을 가져가야 합니다.‡Lleva la tablilla de Shadra al Clérigo Oscuro Marnal.‡Lleva la tablilla de Shadra al Clérigo Oscuro Marnal.‡Apportez la Tablette de Shadra au Sombre clerc Marnal.‡把沙德拉石板交给黑暗牧师玛尔纳。‡將沙德拉石板帶給黑暗牧師馬爾諾。',
  }
},
[26385] = {
  {
    'Os ventos da mudança‡Ветра перемен‡Unaufhaltsame Veränderungen‡변화의 파도를 뚫고‡Rompen olas de cambio‡Rompen olas de cambio‡Auberdine au creux de la vague‡乘风破浪‡突破改變的浪濤',
    nil,
    'Fale com Vesprystus, na Vila de Rut\'theran, e voe para Lor\'danel.‡Поговорите с Веспристом в деревне Рут\'теран, чтобы обеспечить безопасный проезд в Лор\'данел.‡Sprecht mit Vesprystus in Rut\'theran, um nach Lor\'danel zu fliegen.‡루테란 마을에 있는 베스프리스투스와 대화하여 로르다넬로 가는 탈것을 구해야 합니다.‡Habla con Vesprystus en el Poblado Rut\'theran para contratar un vuelo hasta Lor\'danel.‡Habla con Vesprystus en el Poblado Rut\'theran para contratar un vuelo hasta Lor\'danel.‡Allez parler à Vesprystus, à Rut’theran, pour qu’il vous envoie à Lor’danel.‡跟鲁瑟兰村的维斯派塔斯交谈，然后飞往洛达内尔。‡在魯瑟蘭村和維斯派塔斯說話來飛往洛丹諾。',
  }
},
[26386] = {
  {
    'Surkhan‡Сурхан‡Surkhan‡수르칸‡Surkhan‡Surkhan‡Surkhan‡苏尔坎‡蘇爾可汗',
    nil,
    'Fale com Surkhan em Bambala, que fica na Selva do Espinhaço Setentrional.‡Поговорите с Сурханом в Бамбале, что в Северной Тернистой долине.‡Meldet Euch bei Surkhan in Bambala im Nördlichen Schlingendorntal.‡북부 가시덤불의 밤발라에 있는 수르칸에게 보고해야 합니다.‡Preséntate ante Surkhan en Bambala, en el Norte de la Vega de Tuercespina.‡Preséntate ante Surkhan en Bambala, en el Norte de la Vega de Tuercespina.‡Présentez-vous à Surkhan, à Bambala, en Strangleronce septentrionale.‡去找北荆棘谷邦巴拉的苏尔坎。‡回北荊棘谷的班姆巴拉向蘇爾可汗報告。',
  }
},
[26387] = {
  {
    'Dieta de fome‡На голодном пайке‡Hungerdiät‡절식 요법‡Dieta de inanición‡Dieta de inanición‡Régime forcé‡禁食‡飢餓食譜',
    nil,
    'Destrua 6 Vítimas Encasuladas nas Ruínas Assustadoras.‡Уничтожьте 6 оплетенных жертв в Ползучих руинах.‡Vernichtet 6 eingesponnene Opfer in den Gruselruinen.‡굼벵이 폐허에 있는 고치가 된 희생자 6명을 처리해야 합니다.‡Acaba con 6 víctimas encerradas en Las Ruinas Abyectas.‡Acaba con 6 víctimas encerradas en Las Ruinas Abyectas.‡Détruisez 6 Victimes enfermées dans un cocon dans les Ruines aux Rampants.‡在爬虫废墟消灭6名茧缚受害者。‡到爬蟲廢墟消滅6個繭縛的受害者。',
  }
},
[26388] = {
  {
    'Céu crepuscular‡Сумеречные небеса‡Zwielichthimmel‡황혼의 하늘‡Cielo crepuscular‡Cielo crepuscular‡Les cieux du Crépuscule‡暮光天空‡暮光天空',
    nil,
    'Acompanhe a frota aérea da Horda até o Planalto do Crepúsculo. Embarque no zepelim na torre que fica no Terminal Sul da Foguetovia em Azshara.‡Сопроводите воздушный флот Орды к Сумеречному нагорью. Воспользуйтесь дирижаблем, улетающим от южной конечной станции ракетной дороги в Азшаре.‡Begleitet die Luftflotte der Horde ins Schattenhochland. Nehmt den Zeppelin vom Turm an der Südlichen Endhaltestelle der Raketenbahn in Azshara.‡호드 비행 편대와 함께 황혼의 고원으로 가야 합니다. 아즈샤라의 남부 로켓길 종착지에 있는 비행선 탑승장에서 비행선을 타십시오.‡Acompaña a la flota aérea de la Horda a las Tierras Altas Crepusculares. Coge el zepelín en la torre del Intercambiador de la Cohetepista del Sur en Azshara.‡Acompaña a la flota aérea de la Horda a las Tierras Altas Crepusculares. Toma el zepelín en la torre del Intercambiador de la Cohetepista del Sur en Azshara.‡Accompagnez la flotte aérienne de la Horde jusqu\'aux Hautes-terres du Crépuscule. Prenez le zeppelin à la tour du Terminal Sud du fusorail, en Azshara.‡为部落航空舰队护航，前往暮光高地。你可以在艾萨拉的南部火箭车终点站高塔处登艇。‡與部落空軍艦隊一同抵達暮光高地。到艾薩拉南方火箭道終點的塔頂，搭上飛艇。',
  }
},
[26389] = {
  {
    'Invasão dos Rocha Negra‡Вторжение клана Черной горы‡Schwarzfelsinvasion‡검은바위 부족 침공‡Invasión Roca Negra‡Invasión Roca Negra‡L\'invasion rochenoire‡黑石兽人的入侵‡黑石的入侵',
    nil,
    'Pegue 8 Armas dos Orcs Rocha Negra.‡Раздобудьте 8 образцов оружия орков Черной горы.‡Bringt 8 Waffen der Orcs des Schwarzfelsklans an Euch.‡검은바위 오크 무기 8개를 모아야 합니다.‡Recupera 8 armas de orcos Roca Negra.‡Recupera 8 armas de orcos Roca Negra.‡Récupérez 8 Armes d\'orc rochenoire.‡收集8把黑石兽人的武器。‡收集8件黑石獸人武器。',
  }
},
[26390] = {
  {
    'Vamos acabar com a invasão!‡Оккупанты – вон!‡Setzt der Invasion ein Ende!‡습격의 종결!‡¡El final de la invasión!‡¡El final de la invasión!‡Mettez un terme à l\'invasion !‡终结入侵！‡終結入侵!',
    nil,
    'Elimine Kurtok, o Matador.‡Убейте Куртока Душегуба.‡Tötet Kurtok den Schlächter.‡학살자 쿠르톡을 처치해야 합니다.‡Mata a Kurtok el Destripador.‡Mata a Kurtok el Destripador.‡Abattez Kurtok le Tueur.‡杀死屠杀者库尔托克。‡消滅『殺戮者』庫爾托克。',
  }
},
[26391] = {
  {
    'A esperança é a última que queima‡Еще есть надежда‡Die Hoffnung ersticken‡꺼져가는 희망‡Apagando la esperanza‡Apagando la esperanza‡Un espoir d\'extinction‡灭火拯救希望‡撲滅希望',
    nil,
    'Use o Extintor de Incêndio da Madel para apagar 8 Incêndios no Vinhedo.‡Воспользуйтесь огнетушителем Милли, чтобы погасить 8 очагов возгорания на винограднике.‡Benutzt Millys Feuerlöscher, um 8 Brände im Weingut zu löschen.‡밀리의 소화기를 사용하여 포도밭 불 8개를 꺼야 합니다.‡Usa el extintor de Milly para apagar 8 fuegos en el viñedo.‡Usa el extintor de Milly para apagar 8 fuegos en el viñedo.‡Servez-vous de l’Extincteur de Milly pour éteindre 8 Feux de vigne.‡使用米莉的灭火器，扑灭8处葡萄园的火焰。‡使用米莉滅火器撲滅8團農場火焰。',
  }
},
[26392] = {
  {
    '‡Свидетельство о подвигах‡Tapferkeitsbelobigung‡용기의 증서‡Vale de valentía‡Vale de valentía‡Un témoignage de votre bravoure‡勇氣證明‡勇氣證明',
    nil,
    '‡Доставьте свидетельство о подвигах маршалу Макбрайду в долину Североземья в Элвиннском лесу.‡Bringt die Tapferkeitsbelobigung zu Marschall McBride im Nordhaintal im Wald von Elwynn.‡‡Entrega el vale de valentía al alguacil McBride en Villanorte, en el Bosque de Elwynn.‡‡Remettez le Témoignage de bravoure au Maréchal McBride, dans la Vallée de Comté-du-Nord, en forêt d\'Elwynn.‡‡',
  }
},
[26393] = {
  {
    'Um recado rápido‡Срочное сообщение‡Eine eilige Nachricht‡긴급 전갈‡Mensajero a toda prisa‡Mensajero a toda prisa‡Un message rapide‡快捷的消息‡快遞消息',
    nil,
    'Leve o Bilhete de Argus para Bartolotto, o Bravo, mestre de grifos.‡Отнесите записку Аргуса укротителю грифонов Бартлетту Храбрецу.‡Bringt Argus\' Notiz zu Bartlett dem Tapferen, dem Greifenmeister.‡그리핀 조련사인 용사 바틀릿에게 아르거스의 쪽지를 가져가야 합니다.‡Llévale la nota de Argus al maestro de grifos Bartlett el Valiente.‡Llévale la nota de Argus al maestro de grifos Bartlett el Valiente.‡Apportez la Note d’Argus à Bartlett le Brave, le Maître des griffons.‡将阿古斯的便笺交给狮鹫管理员勇敢的巴特利。‡將阿古斯的筆記交給獅鷲獸管理員勇敢的巴特勒。',
  }
},
[26394] = {
  {
    'Siga para Ventobravo‡Полет в Штормград‡Weiter nach Sturmwind‡스톰윈드로 이동‡Prosigue hasta Ventormenta‡Prosigue hasta Ventormenta‡Continuer vers Hurlevent‡前往暴风城‡趕赴暴風城',
    nil,
    'Compre uma passagem de grifo do mestre de grifos Bartolotto, o Bravo, e leve o Bilhete de Argus para Osric Strang na loja Imunidade Limitada, que fica na Cidade Velha, em Ventobravo.‡Заплатите за полет укротителю грифонов Бартлетту Храбрецу, затем доставьте записку Аргуса Озрику Штрангу в магазин "Ограниченная неуязвимость" в Старом городе Штормграда.‡Bucht einen Greifenritt bei Greifenmeister Bartlett dem Tapferen, dann bringt Argus\' Notiz zu Osric Strang, im Laden Begrenzte Immunität, in der Altstadt von Sturmwind.‡그리핀 조련사인 용사 바틀릿에게 요금을 내고 그리핀을 탄 다음 아르거스의 쪽지를 스톰윈드의 구 시가지, 품질보증 갑옷 상점에 있는 오스릭 스트랑에게 가져가야 합니다.‡Cómprale al maestro de grifos Bartlett el Valiente un vuelo en grifo y lleva la nota de Argus a Osric Strang, en la tienda Inmunidad Limitada, en el Casco Antiguo de Ventormenta.‡Cómprale al maestro de grifos Bartlett el Valiente un vuelo en grifo y lleva la nota de Argus a Osric Strang, en la tienda Inmunidad Limitada, en el Casco Antiguo de Ventormenta.‡Offrez-vous un vol auprès du Maître des griffons Bartlett le Brave. Ensuite, portez la Note d’Argus à Osric Strang, au magasin Immunité limitée, dans la Vieille ville de Hurlevent.‡从狮鹫管理员勇敢的巴特利那里租一只狮鹫，然后将阿古斯的便笺交给奥斯瑞克·斯图恩，他在暴风城旧城区的“有限防护”商店里。‡從獅鷲獸管理員，勇敢的巴特勒那裡租用一頭獅鷲獸，然後把阿古斯的筆記帶去暴風城舊城區的有限防護商店，交給奧斯瑞克·斯圖恩。',
  }
},
[26395] = {
  {
    'Dungar Tragolongo‡Дунгар Долгопив‡Dungar Trinkfest‡덩가 롱드링크‡Dungar Tragolargo‡Dungar Tragolargo‡Dungar Grangodet‡杜加尔·朗德瑞克‡杜加爾·朗德瑞克',
    nil,
    'Leve o Caixote de Osric para Dungar Tragolongo, o mestre de grifos.‡Отнесите ящик Озрика укротителю грифонов Дунгару Долгопиву.‡Bringt Osrics Kiste zu Dungar Trinkfest, dem Greifenmeister.‡그리핀 조련사 덩가 롱드링크에게 오스릭의 상자를 가져가야 합니다.‡Lleva el cajón de Osric a Dungar Tragolargo, el maestro de grifos.‡Lleva el cajón de Osric a Dungar Tragolargo, el maestro de grifos.‡Apportez la Caisse d’Osric à Dungar Grangodet, le Maître des griffons.‡将奥斯瑞克的箱子交给狮鹫管理员杜加尔·朗德瑞克。‡將奧斯瑞克的木箱交給獅鷲獸管理員杜加爾·朗德瑞克。',
  }
},
[26396] = {
  {
    'Fale novamente com Argus‡Возвращение к Аргусу‡Rückkehr zu Argus‡아르거스에게 돌아가기‡Vuelve con Argus‡Vuelve con Argus‡Retourner voir Argus‡返回阿古斯身边‡返回閃金鎮',
    nil,
    'Compre uma passagem para Vila d\'Ouro do mestre de grifos Dungar Tragolongo. Em seguida, leve o Caixote de Osric ao Ferreiro Argus,em Vila d\'Ouro.‡Заплатите за полет укротителю грифонов Дунгару Долгопиву, затем доставьте ящик Озрика кузнецу Аргусу в Златоземье.‡Bucht einen Greifenritt nach Goldhain bei Greifenmeister Dungar Trinkfest, dann bringt Osrics Kiste zu Schmied Argus in Goldhain.‡그리핀 조련사 덩가 롱드링크에게 요금을 지급하고 황금골로 그리핀을 탄 다음 오스릭의 상자를 황금골에 있는 대장장이 아르거스에게 가져가야 합니다.‡Compra un vuelo en grifo hasta Villadorada al maestro de grifos Dungar Tragolargo y lleva el cajón de Osric al herrero Argus en Villadorada.‡Compra un vuelo en grifo hasta Villadorada al maestro de grifos Dungar Tragolargo y lleva el cajón de Osric al herrero Argus en Villadorada.‡Offrez-vous un vol à destination de Comté-de-l’Or, auprès du Maître des griffons Dungar Grangodet. Ensuite, apportez la Caisse d’Osric à Argus le forgeron, à Comté-de-l’Or.‡从狮鹫管理员杜加尔·朗德瑞克那里租一只狮鹫，飞往闪金镇，然后将奥斯瑞克的箱子交给闪金镇的铁匠阿古斯。‡從獅鷲獸管理員杜加爾·朗德瑞克那裡租用一頭獅鷲獸飛到閃金鎮，然後將奧斯瑞克的木箱交給閃金鎮的鐵匠阿古斯。',
  }
},
[26397] = {
  {
    'Tenha a Mãe Terra ao seu lado‡Да хранит тебя Мать-Земля‡Geht mit der Erdenmutter‡대지모신과 함께‡Caminar con la Madre Tierra‡Caminar con la Madre Tierra‡Marcher avec la Terre-mère‡与大地母亲同行‡與大地之母同行',
    nil,
    'Leve a Marca do Casco Sangrento para Garrosh Grito Infernal no Castelo Grommash, que fica em Orgrimmar.|n|nFale com Tal, o Mestre de Mantícoras, para voar até lá, ou aguarde o zepelim.‡Отнесите знак Кровавого Копыта Гаррошу Адскому Крику в крепость Громмаш в Оргриммаре.|n|nЧтобы отправиться туда, вы можете либо поговорить с укротителем ветрокрылов Талом, либо дождаться дирижабля.‡Bringt das Mal von Bluthuf zu Garrosh Höllschrei in der Feste Grommash in Orgrimmar.|n|nSprecht mit Tal dem Windreitermeister oder wartet auf den Zeppelin, um Eure Reise anzutreten.‡오그리마의 그롬마쉬 요새에 있는 가로쉬 헬스크림에게 블러드후프의 징표를 가져가야 합니다.|n|n오그리마로 가려면 와이번 조련사 탈과 이야기하거나 비행선을 기다리십시오.‡Lleva la Marca de Pezuña de Sangre a Garrosh Grito Infernal, que se encuentra en Fuerte Grommash en Orgrimmar.|n|nPuedes hablar con Tal el maestro de jinetes del viento para viajar hasta allí, o esperar al zepelín.‡Lleva la Marca de Pezuña de Sangre a Garrosh Grito Infernal, que se encuentra en Fuerte Grommash en Orgrimmar.|n|nPuedes hablar con Tal el maestro de jinetes del viento para viajar hasta allí, o esperar al zepelín.‡Remettez la Marque de Sabot-de-sang a Garrosh Hurlenfer, qui se trouve à Fort Grommash, à Orgrimmar.|n|nPour vous y rendre, vous pouvez parler à Tal le maître des coursiers du vent, ou prendre le zeppelin.‡把血蹄的印记交给奥格瑞玛格罗玛什要塞里的加尔鲁什·地狱咆哮。|n|n你可以跟双足飞龙管理员塔尔交谈飞到那里，也可以等飞艇。‡將血蹄的印記帶到奧格瑪的葛羅瑪許堡，交給卡爾洛斯·地獄吼。|n|n你可以請雙足飛龍管理員塔爾帶你過去，或是等著搭乘飛艇。',
  }
},
[26398] = {
  {
    '‡Да хранит тебя Мать-Земля‡Geht mit der Erdenmutter‡대지모신과 함께‡Caminar con la Madre Tierra‡‡Marcher avec la Terre-Mère‡与大地母亲同行‡',
    nil,
    '‡Отнесите знак Кровавого Копыта Гаррошу Адскому Крику в крепость Громмаш в Оргриммаре.|n|nЧтобы отправиться туда, вы можете либо поговорить с укротителем ветрокрылов Талом, либо дождаться дирижабля.‡‡‡‡‡‡‡',
  }
},
[26399] = {
  {
    'O Tesouro Mosh\'Ogg‡Сокровища клана Мош\'Огг‡Die Schatzkiste der Mosh\'Ogg‡모쉬오그 노획물‡La recompensa Mosh\'Ogg‡La recompensa Mosh\'Ogg‡Le trésor des Mosh’Ogg‡莫什奥格的馈赠‡莫什奧格贈物',
    nil,
    'Pegue o Tesouro Mosh\'Ogg nas ruínas atrás da Gruta de Mosh\'Ogg.‡Добудьте сокровища клана Мош\'Огг в руинах за холмом Мош\'Огг.‡Holt die Belohnung der Mosh\'Ogg aus den Ruinen hinter dem Ogerhügel der Mosh\'Ogg.‡모쉬오그 오우거 소굴의 뒤에 있는 폐허에서 모쉬오그 노획물을 획득해야 합니다.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Emparez-vous du Trésor des Mosh’Ogg dans les ruines derrière le Tertre des Ogres mosh\'Ogg.‡从莫什奥格食人魔山后的废墟里获得莫什奥格的馈赠。‡到莫什奧格巨魔山後方的廢墟取得莫什奧格贈物。',
  }
},
[26400] = {
  {
    'A chave mestra‡Универсальный ключ‡Der Universalschlüssel‡만능 열쇠‡La llave maestra‡La llave maestra‡La clé universelle‡万能钥匙‡萬能鑰匙',
    nil,
    'Abra o Tesouro Mosh\'Ogg lutando com um Retalhador da Empreendimentos S.A. ou usando a Laminosserra da serraria da Empreendimentos S.A.‡Откройте сокровищае клана Мош\'Огг, сразившись с крошшером Торговой Компании или при помощи лезвия циркулярной пилы на лесопилке Торговой Компании.‡Öffnet die Belohnung der Mosh\'Ogg, indem Ihr gegen einen Schredder der Venture Co. kämpft, oder die Sägeklinge im Sägewerk der Venture Company benutzt.‡투자개발회사의 투자개발회사 벌목기와 싸우거나 제재소에 있는 톱날을 사용해 모쉬오그 노획물을 열어야 합니다.‡Abre la recompensa de Mosh\'Ogg luchando con un machacador de Ventura y Cía. o utilizando la sierra gigante del aserradero de Ventura y Cía.‡Abre la recompensa de Mosh\'Ogg luchando con un machacador de Ventura y Cía. o utilizando la sierra gigante del aserradero de Ventura y Cía.‡Ouvrez le Trésor des Mosh’Ogg en affrontant un Déchiqueteur de la KapitalRisk ou en utilisant la Lame de scie de la scierie de la KapitalRisk.‡跟风险投资公司伐木机战斗，或者使用风险投资公司伐木场的条锯，来打开莫什奥格的馈赠。‡和風險投資公司伐木機戰鬥以打開莫什奧格贈物，或是用風險投資公司伐木廠內的鋸刃。',
  }
},
[26401] = {
  {
    'Fale com Véstia‡Вернуться к Вестии‡Rückkehr zu Vestia‡베스티아에게로‡Vuelve con Vestia‡Vuelve con Vestia‡Retourner auprès de Vestia‡去找维斯提亚‡尋找維斯提亞',
    nil,
    'Leve o Amuleto Névoa Negra para Véstia Lançaluna na Torre de Estulan.‡Отнесите амулет Мглистой пещеры Вестии Лунное Копье в башню Эстулана.‡Bringt das Graunebelamulett zu Vestia Mondspeer im Turm von Estulan.‡에스툴란의 탑에 있는 베스티아 문스피어에게 암흑안개 아뮬렛을 가져가야 합니다.‡Lleva el amuleto Niebla Negra a Vestia Lanzaluna en la Torre de Estulan.‡Lleva el amuleto Niebla Negra a Vestia Lanzaluna en la Torre de Estulan.‡Apportez l’Amulette de Sombrebrume à Vestia Lancelune, à la Tour d’Estulan.‡将黑雾护符交给埃斯图兰之塔的维斯提亚·月矛。‡把暗霧護符帶去艾斯圖蘭之塔給維斯提亞·月矛。',
  }
},
[26402] = {
  {
    'General Shandris Plumaluna‡Генерал Шандриса Оперенная Луна‡General Shandris Mondfeder‡사령관 샨드리스 페더문‡General Shandris Plumaluna‡General Shandris Plumaluna‡Le général Shandris Pennelune‡珊蒂斯·羽月将军‡珊蒂斯·羽月將軍',
    nil,
    'Fale com Shandris Plumaluna no Domínio de Plumaluna, que fica em Feralas.‡Поговорите с Шандрисой Оперенной Луной в Крепости Оперенной луны в Фераласе.‡Sprecht mit Shandris Mondfeder in der Mondfederfeste in Feralas.‡페랄라스의 페더문 요새에 있는 샨드리스 페더문과 대화해야 합니다.‡Habla con Shandris Plumaluna en el Bastión Plumaluna en Feralas.‡Habla con Shandris Plumaluna en el Bastión Plumaluna en Feralas.‡Parlez à Shandris Pennelune au Bastion de Pennelune, en Féralas.‡跟菲拉斯羽月要塞的珊蒂斯·羽月谈一谈。‡到菲拉斯的羽月要塞與珊蒂斯·羽月交談。',
  }
},
[26403] = {
  {
    'Mineração da Empreendimentos S.A.‡Рудник Торговой Компании‡Venture Company-Bergbau‡투자개발회사 채광‡La minería de Ventura y Cía.‡La minería de Ventura y Cía.‡Les mines de la KapitalRisk‡风险投资公司矿业‡風險投資公司的採礦行為',
    nil,
    'Leve 5 Cristais Rolados para o Esquésito Relatrisca em Bambala, que fica na Selva do Espinhaço Setentrional.‡Принесите 5 упавших кристаллов Скизи Крюкоуху в Бамбалу, что в Северной Тернистой долине.‡Bringt 5 gerommelte Kristalle zu Skeezy Whillzap in Bambala im Nördlichen Schlingendorntal.‡북부 가시덤불의 밤발라에 있는 스키지 휠잽에게 연마된 수정 5개를 가져가야 합니다.‡Lleva 5 cristales caídos a Skeezy Whillzap a Bambala en el Norte de la Vega de Tuercespina.‡Lleva 5 cristales caídos a Skeezy Whillzap a Bambala en el Norte de la Vega de Tuercespina.‡Rapportez 5 Cristaux réduits à Krapouille Taphumeur, à Bambala, en Strangleronce septentrionale.‡把5块打磨过的水晶带给北荆棘谷邦巴拉的斯奇兹·维尔扎普。‡將5個打磨過的水晶帶回北荊棘谷的班姆巴拉給史基茲·威爾札普。',
  }
},
[26404] = {
  {
    'Acima do meu salário‡Работенка уровнем повыше‡Höhere Lohngruppe‡내 능력 밖의 물건‡Por encima de mis posibilidades‡Por encima de mis posibilidades‡Vingt dieux la belle planque !‡我没钱‡超出我的薪資',
    nil,
    'Fale com a Espoleta Chaveforte no Esconderijo da Chaveforte, que fica no Cabo do Espinhaço.‡Отрапортуйте Хамми Кофельнагель в Укрытии Кофельнагель на мысе Тернистой долины.‡Sucht Sassy Hartzang in Hartzangs Versteck am Schlingendornkap auf.‡가시덤불 곶의 하드렌치 은신처에 있는 새시 하드렌치에게 보고해야 합니다.‡Preséntate ante Sassy Malallave en Escondrijo Malallave en El Cabo de Tuercespina.‡Preséntate ante Sassy Malallave en Escondrijo Malallave en El Cabo de Tuercespina.‡Présentez-vous à Chipie Serrelavis, à la Planque de Serrelavis, au Cap Strangleronce.‡去找荆棘谷海角硬钳避世乐园的莎希·硬钳。‡到荊棘谷海角的硬心藏匿處，找賽希‧硬心報告。',
  }
},
[26405] = {
  {
    'Mambo Zul\'Mamwe‡Пляски Зул\'Мамве‡Mambo in Zul\'Mamwe‡줄맘웨 맘보‡El mambo de Zul\'Mamwe‡El mambo de Zul\'Mamwe‡Le mambo de Zul’Mamwe‡祖玛维曼波‡祖瑪維曼波',
    nil,
    'Mate 16 Trolls Rachacrânio em Zul\'Mamwe.‡Убейте 16 троллей из племени Дробителей Черепов в Зул\'Мамве.‡Tötet 16 Trolle der Schädelspalter in Zul\'Mamwe.‡줄맘웨에 있는 백골가루 트롤 16명을 처치해야 합니다.‡Mata a 16 trols Machacacráneos en Zul\'Mamwe.‡Mata a 16 trols Machacacráneos en Zul\'Mamwe.‡Tuez 16 Trolls casse-crânes dans Zul’mamwe.‡杀死祖玛维里的16名劈颅巨魔。‡在祖瑪維內殺死16名劈顱食人妖。',
  }
},
[26406] = {
  {
    'A presa de Shadra‡Зуб Шадры‡Der Fangzahn von Shadra‡샤드라 송곳니‡El colmillo de Shadra‡El colmillo de Shadra‡Le croc de Shadra‡沙德拉之牙‡沙德拉之牙',
    nil,
    'Pegue a Presa de Shadra na Ruína Assustadora.‡Найдите зуб Шадры в Ползучих руинах.‡Besorgt den Fangzahn von Shadra aus den Gruselruinen.‡굼벵이 폐허에서 샤드라 송곳니를 모아야 합니다.‡Coge el colmillo de Shadra de Las Ruinas Abyectas.‡Coge el colmillo de Shadra de Las Ruinas Abyectas.‡Obtenez le Croc de Shadra dans les Ruines aux Rampants.‡在爬虫废墟中获得沙德拉之牙。‡在爬蟲廢墟取得沙德拉之牙。',
  }
},
[26407] = {
  {
    'Manufatura de Mosh\'Ogg‡Ручная работа Мош\'Огга‡Die Handschrift von Mosh\'Ogg‡모쉬오그 수제품‡Artesanía Mosh\'Ogg‡Artesanía Mosh\'Ogg‡Un travail de Mosh\'Ogg‡莫什奥格的手笔‡莫什奧格手工藝品',
    nil,
    'Leve a Mão Desfigurada de Mosh´Ogg para o Clarividente Mok\'thardin no Acampamento Grom\'gol, que fica na Selva do Espinhaço Setentrional.‡Принесите искалеченную руку огра клана Мош\'Огг провозвестнику Мок\'тардину в лагерь Гром\'Гол, что в Северной Тернистой долине.‡Bringt die entstellte Hand der Mosh\'Ogg zu Scharfseher Mok\'thardin im Basislager Grom\'gol im Nördlichen Schlingendorntal.‡손상된 모쉬오그 손을 북부 가시덤불의 그롬골 주둔지에 있는 예언자 모크타르딘에게 가져가야 합니다.‡Lleva la mano Mosh\'Ogg desfigurada al clarividente Mok\'thardin al Campamento Grom\'Gol, en el Norte de la Vega de Tuercespina.‡Lleva la mano Mosh\'Ogg desfigurada al clarividente Mok\'thardin al Campamento Grom\'gol, en el Norte de la Vega de Tuercespina.‡Apportez la Main de Mosh\'Ogg difforme au Long-voyant Mok’thardin au campement de Grom\'Gol,en Strangleronce septentrionale.‡把扭曲的莫什奥格之手带给北荆棘谷格罗姆高营地的先知摩克萨尔丁。‡將嚴重受創的莫什奧格之手送到北荊棘谷的格羅姆高營地給先知摩克薩爾丁。',
  }
},
[26408] = {
  {
    'As cinzas do Vale Gris‡Пепел и ясень‡Asche im Eschental‡잿빛 골짜기의 잔재‡Cenizas en Vallefresno‡Cenizas en Vallefresno‡Rien ne vaut Orneval‡灰谷的灰‡梣谷之塵',
    nil,
    'Fale com a Sentinela Shyela no Retiro de Orendil, que fica no Vale Gris.‡Поговорите с часовым Шейлой в Укрытии Орендила, что в Ясеневом лесу.‡Sprecht mit Schildwache Shyela bei Orendils Zuflucht im Eschental.‡잿빛 골짜기에 있는 오렌딜 수행지에서 파수꾼 샤엘라와 대화해야 합니다.‡Habla con la centinela Shyela en el Refugio de Orendil.‡Habla con la centinela Shyela en el Refugio de Orendil.‡Allez parler à la Sentinelle Shyela à la Retraite d’Orendil, en Orneval.‡跟灰谷奥雷迪尔的居所的哨兵塞雅拉谈一谈。‡到梣谷的奧蘭迪爾居所和哨兵席雅拉談話。',
  }
},
[26409] = {
  {
    'Cadê o Almada?‡Где Клондацк?‡Wo ist Goldmine?‡골드마인은 어디에?‡¿Dónde está Minaoro?‡¿Dónde está Minaoro?‡Il est l’or de retrouver Minelor !‡金矿在哪儿？‡金礦何在?',
    nil,
    'Encontre o Iniciado Almada na Bacia de Quartzito, no Geodomo.‡Найдите посвященного Клондацка в Кварцитовой впадине, что в Подземье.‡Findet Initiand Goldmine am Quarzitbecken in Tiefenheim.‡심원의 영지의 규암 분지에 있는 수습생 골드마인을 찾아야 합니다.‡Encuentra al iniciado Minaoro en la Cuenca de Cuarcita en Infralar.‡Encuentra al iniciado Minaoro en la Cuenca de Cuarcita en Infralar.‡Trouvez l’Initié Minelor au Bassin de Quartzite, dans le Tréfonds.‡去找深岩之洲石英盆地的见习萨满“金矿”。‡到地深之源的石英盆地尋找學徒金礦。',
  }
},
[26410] = {
  {
    'Super cola explosiva‡Заживляющее взрывчатое вещество‡Explosive Verbundmasse‡폭발 접합 혼합물‡Compuesto de enlace explosivo‡Compuesto adherente explosivo‡Un mélange détonant‡爆炸接合混合物‡強力爆炸化合物',
    nil,
    'Colete 5 Resinas de Quartzito.‡Соберите 5 порций кварцитовой смолы.‡Sammelt 5 Einheiten Quarzitharz.‡규암 수지 5개를 수집해야 합니다.‡Reúne 5 resinas de cuarcita.‡Reúne 5 resinas de cuarcita.‡Récupérez 5 morceaux de Résine de quartzite.‡收集5块石英树脂。‡收集5個石英樹脂。',
  }
},
[26411] = {
  {
    'Maravilha cura-ativa‡Приложить и прижечь‡Blitztrocknung‡위험한 치료법‡Aplicar y secar‡Aplicar y secar‡Application à sec, séchage rapide‡立敷骤干‡一上即乾',
    nil,
    'Use o Emplastro Colante Explosivo em Sílex Rochamanto.‡Воспользуйтесь заживляющим взрывчатым веществом, чтобы вылечить Флинта Железную Мантию.‡Behandelt Flint Erzmantel mit der explosiven Verbundmasse.‡폭발 접합 혼합물을 플린트 오어맨틀에게 사용해야 합니다.‡Usa el compuesto de enlace explosivo con Sílex Mantomena.‡Usa el compuesto de enlace explosivo con Sílex Mantomena.‡Utilisez le Pansement explosif sur Silex Mantemine.‡在弗林特·岩幔身上使用爆炸接合混合物。‡在弗林特‧礦被身上使用強力爆炸化合物。',
  }
},
[26412] = {
  {
    'O Tesouro Mosh\'Ogg‡Сокровища клана Мош\'Огг‡Die Schatzkiste der Mosh\'Ogg‡모쉬오그 노획물‡La recompensa Mosh\'Ogg‡La recompensa Mosh\'Ogg‡Le trésor des Mosh’Ogg‡莫什奥格的馈赠‡莫什奧格贈物',
    nil,
    'Pegue o Tesouro Mosh\'Ogg nas ruínas atrás da Gruta de Mosh\'Ogg.‡Добудьте сокровище огров, хранящееся в руинах за холмом Мош\'Огг.‡Holt die Belohnung der Mosh\'Ogg aus den Ruinen hinter dem Ogerhügel der Mosh\'Ogg.‡모쉬오그 오우거 소굴의 뒤에 있는 폐허에서 모쉬오그 노획물을 획득해야 합니다.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Emparez-vous du Trésor des Mosh’Ogg dans les ruines derrière le Tertre des Ogres mosh\'Ogg.‡从莫什奥格食人魔山后的废墟里获得莫什奥格的馈赠。‡到莫什奧格巨魔山後方的廢墟取得莫什奧格贈物。',
  }
},
[26413] = {
  {
    'Tem coisas que só o Arauto da Terra faz por você‡Отведи его к заклинательнице земли‡Bringt ihn zur Erdenruferin‡대지술사와의 만남‡Llévalo con la clamatierras‡Llévalo con la clamatierras‡Conduisez-le à l’imploratrice de la terre‡带他去见唤地者‡帶去找喚地者',
    nil,
    'Apresente Sílex Rochamanto para o Arauto da Terra Yevaa no Templo da Terra.‡Представьте Флинта Железную Мантию заклинательнице земли Еве в Храме Земли.‡Bringt Flint Erzmantel zu Erdenruferin Yevaa im Tempel der Erde.‡대지의 사원에 있는 대지술사 예바에게 플린트 오어맨틀을 소개해야 합니다.‡Presenta a Sílex Mantomena a la clamatierras Yevaa en el Templo de la Tierra.‡Presenta a Sílex Mantomena a la clamatierras Yevaa en el Templo de la Tierra.‡Présentez Silex Mantemine à l’Imploratrice de la terre Yevaa, au Temple de la Terre.‡把弗林特·岩幔介绍给大地神殿的唤地者耶法。‡將弗林特‧礦被帶去大地神殿的喚地者伊瓦那裡。',
  }
},
[26414] = {
  {
    'Pega-te olhete‡Ловля светлоперого судака‡Einen Zander erwischen‡쏘가리를 내려쳐라‡El desafío del leucoma‡El desafío del leucoma‡Le doré jaune‡捕捉狮鲈鱼‡攻擊白斑魚',
    nil,
    'Catarina Gurjão, de Ventobravo, quer que você lhe traga 8 Olhetes do Lago.‡Катрин Лиланд в Штормграде просит вас принести ей 8 задеревенелых светлоперых судаков.‡Catherine Leland in Sturmwind möchte, dass Ihr ihr 8 verhärtete Zander bringt.‡스톰윈드에 있는 캐서린 리랜드가 단단한 쏘가리 8마리를 잡아 달라고 했습니다.‡Catherine Leland en Ventormenta quiere que le lleves 8 leucomas endurecidos.‡Catherine Leland en Ventormenta quiere que le lleves 8 leucomas endurecidos.‡Catherine Leland, à Hurlevent, veut que vous lui rapportiez 8 Dorés jaunes endurcis.‡暴风城的凯瑟琳·利兰要你给她带去8条硬化狮鲈鱼。‡暴風城的凱薩琳·利蘭要你帶8條硬化白斑魚回來給她。',
  }
},
[26415] = {
  {
    '‡‡Questflag für Logbuch des Kapitäns‡선장의 일지 퀘스트 플래그‡‡‡Questflag pour Le journal du capitaine‡‡',
    nil,
    nil,
  }
},
[26416] = {
  {
    'Conheça a lei da selva‡Вперед, в джунгли!‡Auf in den Dschungel‡밀림에 온 걸 환영합니다‡Bien, ven(ido) a la jungla‡Bien, ven(ido) a la jungla‡À la rescousse de la cambrousse !‡那么，来丛林吧‡歡迎來去叢林',
    nil,
    'Apresente-se a Bort em Orgrimmar.‡Разыщите Борта в Оргриммаре.‡Meldet Euch bei Bort in Orgrimmar.‡오그리마에 있는 보트에게 보고해야 합니다.‡Preséntate ante Bort en Orgrimmar.‡Preséntate ante Bort en Orgrimmar.‡Allez vous présenter à Bort à Orgrimmar.‡去找奥格瑞玛的博特。‡向奧格瑪的波爾特報到。',
  }
},
[26417] = {
  {
    'Selva do Espinhaço Setentrional: o Império Caído‡Северная Тернистая долина: павшая империя‡Das Nördliche Schlingendorntal: Das Gefallene Reich‡북부 가시덤불: 타락한 제국‡Norte de la Vega de Tuercespina: El imperio caído‡Norte de la Vega de Tuercespina: El imperio caído‡L’empire déchu‡北荆棘谷：覆灭的帝国‡北荊棘谷:殞落帝國',
    nil,
    'Apresente-se ao Comandante Aggro\'gosh no Acampamento Grom\'gol, que fica na Selva do Espinhaço Setentrional.‡Явитесь с докладом к командиру Аггро\'гошу в лагерь Гром\'гол в Северной Тернистой долине.‡Meldet Euch bei Kommandant Aggro\'gosh im Basislager Grom\'gol im Nördlichen Schlingendorntal.‡북부 가시덤불의 그롬골 주둔지에 있는 사령관 아그로고쉬에게 보고해야 합니다.‡Preséntate ante el comandante Aggro\'gosh en el Campamento Grom\'gol, en el Norte de la Vega de Tuercespina.‡Preséntate ante el comandante Aggro\'gosh en el Campamento Grom\'gol, en el Norte de la Vega de Tuercespina.‡Présentez-vous au Commandant Aggro’gosh au campement de Grom’gol, en Strangleronce septentrionale.‡前往北荆棘谷，向格罗姆高营地的指挥官阿格罗戈什报到。‡到北荊棘谷的格羅姆高營地向指揮官阿格羅戈西回報。',
  }
},
[26418] = {
  {
    'A carapaça de Shadra‡Панцирь Шадры‡Der Panzer von Shadra‡샤드라 껍질‡La concha de Shadra‡La concha de Shadra‡L\'exosquelette de Shadra‡沙德拉之壳‡沙德拉之殼',
    nil,
    'Mate Qiaga, a Tutora, e pegue a Carapaça de Shadra.‡Убейте Квиагу Хранительницу и заберите панцирь Шадры.‡Tötet Qiaga die Bewahrerin und besorgt den Panzer von Shadra.‡수호자 퀴아가를 처치하고 샤드라 껍질을 획득해야 합니다.‡Mata a Qiaga la Vigilante y consigue la concha de Shadra.‡Mata a Qiaga la Vigilante y consigue la concha de Shadra.‡Tuez Qiaga la Gardienne et récupérez l’Exosquelette de Shadra.‡杀死守护者奇尔加，获得沙德拉之壳。‡殺死『守衛者』奇爾嘉並收集沙德拉之殼。',
  }
},
[26419] = {
  {
    'Shadra, a Rainha Peçonhenta‡Шадра – королева пауков‡Shadra, Königin des Giftes‡맹독 여왕거미 샤드라‡Shadra, la Reina del Veneno‡Shadra, la Reina del Veneno‡Shadra la Reine venimeuse‡毒蜘蛛女王沙德拉‡劇毒之后沙德拉',
    nil,
    'Mate Shadra, a Rainha Peçonhenta.‡Убейте Шадру – королеву пауков.‡Tötet Shadra, die Königin des Giftes.‡맹독 여왕 샤드라를 처치해야 합니다.‡Mata a Shadra, la Reina del Veneno.‡Mata a Shadra, la Reina del Veneno.‡Tuez Shadra la Reine venimeuse.‡杀死毒蜘蛛女王沙德拉‡殺死劇毒之后沙德拉。',
  }
},
[26420] = {
  {
    'Minhocas por cristais‡Накопаем червей‡Nach Würmern graben‡지렁이 파내기‡Excavando en busca de lombrices‡Excavando en busca de lombrices‡Un ver, ça va. Trois vers…‡挖蚯蚓‡挖蟲出來',
    nil,
    'Encontre uma Minhoca Hipertrofiada nas margens do Lago de Olívia e use-a como isca para pescar uma Perca-cristal no mesmo lago, a norte de Ventobravo.‡Отыщите земляного червя-переростка возле Пруда Оливии и поймайте на эту наживку хрустального окуня. Хрустальный окунь водится в Пруду Оливии к северу от Штормграда.‡Findet einen übergroßen Regenwurm in der Nähe von Olivias Teich und benutzt ihn als Köder, um einen Kristallbarsch zu fangen. Kristallbarsche findet man in Olivias Teich, nördlich von Sturmwind.‡올리비아의 연못 근처에서 너무 큰 지렁이를 찾아 미끼로 사용하여 수정 농어를 낚아야 합니다. 수정 농어는 스톰윈드 북쪽에 있는 올리비아의 연못에서 찾을 수 있습니다.‡Encuentra lombrices desmesuradas cerca del Estanque de Olivia y úsalas como cebo para coger lubinas de cristal. Podrás encontrar lubinas de cristal en el Estanque de Olivia, al norte de Ventormenta.‡Encuentra lombrices desmesuradas cerca del Estanque de Olivia y úsalas como cebo para coger lubinas de cristal. Podrás encontrar lubinas de cristal en el Estanque de Olivia, al norte de Ventormenta.‡Trouvez un Ver de terre charnu près de l\'Étang d\'Olivia et utilisez-le comme appât pour attraper une Perche de cristal. Ces poissons se trouvent dans l\'Étang d\'Olivia, au nord de Hurlevent.‡在奥莉维亚的水池附近找到一条发育过剩的蚯蚓，用它当鱼饵，钓起一条水晶鲈鱼。你可以在暴风城北面的奥莉维亚的水池中找到水晶鲈鱼。‡在奧利維亞湖找出一隻成長過頭的蚯蚓，用它做餌來抓水晶鱸魚。水晶鱸魚可以在暴風城北邊的奧利維亞的池塘裡找到。',
  }
},
[26421] = {
  {
    'Conheça o Grão-faz-tudo‡Встретиться с главным механиком‡Der Hochtüftler‡땜장이왕 멕카토크와의 만남‡Conocer al Manitas Mayor‡Conocer al Manitas Mayor‡Rencontrez le Grand Bricoleur‡晋见大工匠‡會見大工匠',
    nil,
    'Apresente-se ao Grão-faz-tudo Mekkatorque na Vila da Gambiarra.‡Представьтесь главному механику Меггакруту в Новом Городе Механиков.‡Stellt Euch bei Hochtüftler Mekkadrill in Neu-Tüftlerstadt vor.‡신 땜장이 마을에 있는 땜장이왕 멕카토크를 만나야 합니다.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Présentez-vous au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡在新工匠镇里，向大工匠梅卡托克进行自我介绍。‡向新地精區的大工匠梅卡托克介紹你自己。',
  }
},
[26422] = {
  {
    'Conheça o Grão-faz-tudo‡Встретиться с главным механиком‡Der Hochtüftler‡땜장이왕 멕카토크와의 만남‡Conocer al Manitas Mayor‡Conocer al Manitas Mayor‡Rencontrez le Grand Bricoleur‡晋见大工匠‡會見大工匠',
    nil,
    'Apresente-se ao Grão-faz-tudo Mekkatorque na Vila da Gambiarra.‡Представьтесь главному механику Меггакруту в Новом Городе Механиков.‡Stellt Euch bei Hochtüftler Mekkadrill in Neu-Tüftlerstadt vor.‡신 땜장이 마을에 있는 땜장이왕 멕카토크를 만나야 합니다.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Présentez-vous au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡在新工匠镇里，向大工匠梅卡托克进行自我介绍。‡向新地精區的大工匠梅卡托克介紹你自己。',
  }
},
[26423] = {
  {
    'Conheça o Grão-faz-tudo‡Встретиться с главным механиком‡Der Hochtüftler‡땜장이왕 멕카토크와의 만남‡Conocer al Manitas Mayor‡Conocer al Manitas Mayor‡Rencontrez le Grand Bricoleur‡晋见大工匠‡會見大工匠',
    nil,
    'Apresente-se ao Grão-faz-tudo Mekkatorque na Vila da Gambiarra.‡Представьтесь главному механику Меггакруту в Новом Городе Механиков.‡Stellt Euch bei Hochtüftler Mekkadrill in Neu-Tüftlerstadt vor.‡신 땜장이 마을에 있는 땜장이왕 멕카토크를 만나야 합니다.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Présentez-vous au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡在新工匠镇里，向大工匠梅卡托克进行自我介绍。‡向新地精區的大工匠梅卡托克介紹你自己。',
  }
},
[26424] = {
  {
    'Conheça o Grão-faz-tudo‡Встретиться с главным механиком‡Der Hochtüftler‡땜장이왕 멕카토크와의 만남‡Conocer al Manitas Mayor‡Conocer al Manitas Mayor‡Rencontrez le Grand Bricoleur‡晋见大工匠‡會見大工匠',
    nil,
    'Apresente-se ao Grão-faz-tudo Mekkatorque na Vila da Gambiarra.‡Представьтесь главному механику Меггакруту в Новом Городе Механиков.‡Stellt Euch bei Hochtüftler Mekkadrill in Neu-Tüftlerstadt vor.‡신 땜장이 마을에 있는 땜장이왕 멕카토크를 만나야 합니다.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Présentez-vous au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡在新工匠镇里，向大工匠梅卡托克进行自我介绍。‡向新地精區的大工匠梅卡托克介紹你自己。',
  }
},
[26425] = {
  {
    'Conheça o Grão-faz-tudo‡Встретиться с главным механиком‡Der Hochtüftler‡땜장이왕 멕카토크와의 만남‡Conocer al Manitas Mayor‡Conocer al Manitas Mayor‡Rencontrez le Grand Bricoleur‡晋见大工匠‡會見大工匠',
    nil,
    'Apresente-se ao Grão-faz-tudo Mekkatorque na Vila da Gambiarra.‡Представьтесь главному механику Меггакруту в Новом Городе Механиков.‡Stellt Euch bei Hochtüftler Mekkadrill in Neu-Tüftlerstadt vor.‡신 땜장이 마을에 있는 땜장이왕 멕카토크를 만나야 합니다.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Preséntate al Manitas Mayor Mekkatorque en Nueva Ciudad Manitas.‡Présentez-vous au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡在新工匠镇里，向大工匠梅卡托克进行自我介绍。‡向新地精區的大工匠梅卡托克介紹你自己。',
  }
},
[26426] = {
  {
    'Tempestade violenta‡Жестокий ветер‡Ein grausamer Sturm‡세찬 바람‡Vendaval violento‡Vendaval violento‡Avis de tempête‡狂风怒啸‡裂風',
    nil,
    'Encontre Felsen, o Perene, e siga as instruções dele para chegar à entrada dos Abismos Esfacelados.‡Найдите Фелсена Выносливого и следуйте его указаниям, чтобы добраться до входа в Гремящие глубины.‡Findet Felsen den Ausdauernden und folgt seinen Anweisungen, um in die Bruchtiefen zu gelangen.‡인내하는 펠젠을 찾은 다음, 그의 지시에 따라 무너지는 심연으로 가는 입구를 찾아야 합니다.‡Encuentra a Felsen el Duradero y sigue sus instrucciones hasta la entrada de las Profundidades Desmoronadas.‡Encuentra a Felsen el Duradero y sigue sus instrucciones hasta la entrada de las Profundidades Desmoronadas.‡Trouvez Felsen l’Endurci et suivez ses instructions pour vous rendre à l’entrée des Profondeurs Désagrégées.‡去找亘久者翡尔森，让他指引你前往碎岩之渊。‡找到持久的費爾森，並順從他的指示前往破碎深淵的入口。',
  }
},
[26427] = {
  {
    'Sem capitão nem tripulação‡Ни команды, ни капитана‡Ohne Kapitän oder Besatzung‡선장이 없으면 항해사라도‡Sin capitán ni tripulación‡Sin capitán ni tripulación‡Sans capitaine, ni voile et ni gouvernail‡没有船长也没有船员‡也無船長也無員',
    nil,
    'Entregue uma Garrafa de Uísque e um Carretel de Corda para o Primeiro Oficial Taciturno.‡Принесите первому помощнику Мади бутылку виски и моток веревки.‡Bringt dem Ersten Maat Mürrisch eine Whiskeyflasche und eine Seilspule.‡일등항해사 무디에게 위스키 병과 밧줄 타래를 가져가야 합니다.‡Lleva una botella de whisky y una bobina de cuerda al contramaestre Temperamento.‡Lleva una botella de whisky y una bobina de cuerda al contramaestre Temperamento.‡Apportez une Bouteille de whisky et un Rouleau de corde au Second Moody.‡把一瓶威士忌酒和一捆绳子交给大副穆迪。‡帶一瓶威士忌和一綑繩子給大副穆迪。',
  }
},
[26428] = {
  {
    'Cortem as cabeças!‡Грабь награбленное‡Von Dieben stehlen‡도둑들에게서 훔쳐라‡Robar a un ladrón...‡Robar a un ladrón...‡Voler les voleurs‡以盗制盗‡以偷制偷',
    nil,
    'Pegue as cabeças de Kenata Dabyrie, Fardel Dabyrie e Marcel Dabyrie.‡Добудьте головы Кенаты Дабири, Фарбела Дабири и Марселя Дабири.‡Enthauptet Kenata Dabyrie, Fardel Dabyrie und Marcel Dabyrie.‡케나타 다비리, 파델 다비리, 마르셀 다비리를 처치하고 머리카락을 모아야 합니다.‡Consigue las cabezas de Kenata Dabyrie, Fardel Dabyrie y Marcel Dabyrie.‡Consigue las cabezas de Kenata Dabyrie, Fardel Dabyrie y Marcel Dabyrie.‡Prenez la Tête de Kenata Dabyrie, celle de Fardel Dabyrie et celle de Marcel Dabyrie.‡拿下科娜塔·达比雷、法迪尔·达比雷和马塞尔·达比雷的徽记。‡取下科娜塔、法迪爾和馬塞爾的頭顱。',
  }
},
[26429] = {
  {
    'Acabe com os Cascasseca‡Сокрушить Сухокожих‡Zerschmettert die Bleichborken‡마른나무껍질 부족을 처단하라‡Aplasta a los Secacorteza‡Aplasta a los Secacorteza‡Broyez les Fanécorces‡捣毁枯木‡擊潰枯木',
    nil,
    'Mate 10 Arremessadores Cascasseca, 10 Caçadores de Cabeças Cascasseca e 8 Mandingueiros Cascasseca.‡Убейте 10 метателей топоров из племени Сухокожих, 10 охотников за головами из племени Сухокожих и 8 знахарей из племени Сухокожих.‡Tötet 10 Axtwerfer der Bleichborken, 10 Kopfjäger und 8 Hexendoktoren.‡마른나무껍질 도끼투척병 10명과 인간사냥꾼 10명, 의술사 8명을 처치해야 합니다.‡Mata a 10 lanzahachas Secacorteza, a 10 rebanacabezas y a 8 médicos brujos.‡Mata a 10 lanzahachas Secacorteza, a 10 rebanacabezas y a 8 médicos brujos.‡Tuez 10 Lanceurs de haches fanécorces, 10 Chasseurs de têtes fanécorces et 8 Féticheurs fanécorces.‡杀死枯木的10名掷斧者、10名猎头者和8名巫医。‡殺死10名枯木擲斧者、10名枯木獵頭者和8名枯木巫醫。',
  }
},
[26430] = {
  {
    'Aldeia Revatusco‡Деревня Сломанного Клыка‡Das Dorf der Bruchhauer‡깨진엄니 마을‡El Poblado Sañadiente‡El Poblado Sañadiente‡Le village des Vengebroches‡恶齿村‡惡齒村',
    nil,
    'Viaje até a Aldeia Revatusco nas Terras Agrestes e fale com o Ancião Presa-arrancada.‡Отправляйтесь в деревню Сломанного Клыка во Внутренних Землях и поговорите со старейшиной Сломанным Клыком.‡Reist zum Dorf der Bruchhauer im Hinterland und sprecht mit dem Ältesten Stumpfhauer.‡동부 내륙지의 깨진엄니 마을로 간 다음 장로 톤터스크와 대화해야 합니다.‡Viaja al Poblado Sañadiente en las Tierras del Interior y habla con el Ancestro Colmillopartido.‡Viaja al Poblado Sañadiente en las Tierras del Interior y habla con el Ancestro Colmillopartido.‡Rendez-vous au Village des Vengebroches dans les Hinterlands et parlez à l’Ancien Brocherompue.‡跟辛特兰恶齿村的断齿长者谈一谈。‡前往辛特蘭裡的惡齒村，並和斷齒長者說話。',
  }
},
[26431] = {
  {
    'Arqueologia‡Археология‡Archäologie‡고고학‡Arqueología‡Arqueología‡Archéologie‡考古学‡考古學',
    nil,
    'Aceite esta missão para encontrar os sítios arqueológicos no seu mapa!‡Accept this quest to find archaeology points on your map!‡Nehmt diese Quest an, um Archäologiepunkte auf Eurer Landkarte zu finden!‡이 퀘스트를 수락하면 고고학 발굴현장이 지도에 표시됩니다!‡¡Acepta esta misión para que te aparezcan puntos arqueológicos en el mapa!‡¡Acepta esta misión para que te aparezcan puntos arqueológicos en el mapa!‡Acceptez cette quête pour découvrir des sites archéologiques sur votre carte !‡接受这个任务，在地图上找到考古点！‡接受這個任務，在你的地圖上找到考古學指標點!',
  }
},
[26432] = {
  {
    'A queda de Jintha\'Alor‡Падение Джинта\'Алора‡Der Fall von Jintha\'Alor‡진타알로의 몰락‡La caída de Jintha\'Alor‡La caída de Jintha\'Alor‡La chute de Jintha\'Alor‡辛萨罗失陷‡辛薩羅的隕落',
    nil,
    'Encontre a Primeva Presa-arrancada em Jintha\'Alor, que fica nas Terras Agrestes.‡Найдите старейшину племени Сломанного Клыка у Джинта\'Алора во Внутренних землях.‡Findet Ura Stumpfhauer bei Jintha\'Alor im Hinterland.‡동부 내륙지의 진타알로에 있는 주술사 톤터스크를 찾아야 합니다.‡Encuentra a Primigenia Colmillopartido en Jintha\'Alor en las Tierras del Interior.‡Encuentra a Primigenia Colmillopartido en Jintha\'Alor en las Tierras del Interior.‡Trouvez l’Aînée Brocherompue à Jintha’Alor dans les Hinterlands.‡去找辛特兰辛萨罗的断齿族长。‡到辛特蘭的辛薩羅找斷齒族長。',
  }
},
[26433] = {
  {
    'A água benta da limpidez‡Святая вода ясности‡Das heilige Wasser der Klarheit‡청명의 성수‡El agua bendita de la claridad‡El agua bendita de la claridad‡L\'eau bénite de clarté‡澄澈圣水‡明晰聖水',
    nil,
    'Consiga a Água Benta da Limpidez do Olho-d\'água Nek\'mani no Cabo do Espinhaço.‡Наберите святой воды ясности из родника Нек\'мани на мысе Тернистой долины.‡Beschafft das heilige Wasser der Klarheit aus dem Nek\'maniquellbrunnen am Schlingendornkap.‡가시덤불 곶의 네크마니 수원지에서 청명의 성수를 획득해야 합니다.‡Consigue el agua bendita de claridad en el Manantial Nek\'mani, en El Cabo de Tuercespina.‡Consigue el agua bendita de claridad en el Manantial Nek\'mani, en El Cabo de Tuercespina.‡Procurez-vous l’Eau bénite de clarté puisée dans la Fontaine des Nek\'mani, au Cap Strangleronce.‡从荆棘谷海角纳克迈尼圣泉里打上澄澈圣水。‡從荊棘谷海角的納克邁尼聖泉取得明晰聖水。',
  }
},
[26434] = {
  {
    'Reagentes primevos do poder‡Изначальные реагенты силы‡Ursprüngliche Reagenzien der Macht‡힘의 원시 재료‡Componentes primarios de poder‡Componentes primarios de poder‡Les composants primordiaux du pouvoir‡力量的源生材料‡原始力量觸媒',
    nil,
    'Obtenha 4 Peles Flexíveis de Tigresa e 4 Peles de Pantera Aveludadas.‡Добудьте 4 мягкие тигриные шкуры и 4 бархатистые шкуры пантеры.‡Beschafft 4 geschmeidige Tigerinnenfelle und 4 samtige Pantherfelle.‡부드러운 암호랑이 모피 4개와 보들보들한 표범 모피 4개를 모아야 합니다.‡Obtén 4 pelajes de tigre flexibles y 4 pelajes de pantera aterciopelados.‡Obtén 4 pelajes de tigre flexibles y 4 pelajes de pantera aterciopelados.‡Procurez-vous 4 Fourrures souples de tigresse et 4 Fourrures veloutées de panthère.‡剥来4张柔软的虎皮和4张光滑的猎豹皮。‡取得7張柔軟的雌虎毛皮和7張光滑的獵豹毛皮。',
  }
},
[26435] = {
  {
    'Eu sou um grande mentiroso e uma fraude‡Лжец и отпетый мошенник‡Ich bin ein gewaltiger Lügner und Betrüger‡나는야 엄청난 거짓말쟁이에 사기꾼‡Soy un mentiroso y un farsante‡Soy un mentiroso y un farsante‡Mensonges et impostures‡我是个大骗子‡我是個大騙子作弊鬼',
    nil,
    'Leve o Tesouro Mosh\'Ogg Aberto para Garley Montaluz na Angra do Butim, que fica no Cabo do Espinhaço.‡Отнесите открытый сундук сокровищ клана Мош\'Огг Гарли Легкой Наезднице в Пиратскую Бухту у мыса Тернистой долины.‡Bringt die geöffnete Schatzkiste der Mosh\'Ogg zu Garley Lichtreiter in Beutebucht am Schlingendornkap.‡가시덤불 곶의 무법항에 있는 갈리 라이트라이더에게 열린 모쉬오그 노획물을 가져가야 합니다.‡Lleva la recompensa Mosh\'Ogg abierta a Garley Montaluz en la Bahía del Botín, en El Cabo de Tuercespina.‡Lleva la recompensa Mosh\'Ogg abierta a Garley Montaluz en la Bahía del Botín, en El Cabo de Tuercespina.‡Apportez le Trésor des Mosh’Ogg ouvert à Garley Courlumière à Baie-du-Butin, au Cap Strangleronce.‡把打开的莫什奥格的馈赠带给荆棘谷海角藏宝海湾的格尔蕾·逐光。‡將開啟的莫什奧格贈物帶去荊棘谷海角的藏寶海灣給葛瑞利·馭光者。',
  }
},
[26436] = {
  {
    'O entrincheirado‡Вросший в землю‡Verwurzelt‡자리 잡기‡Afianzado‡Afianzado‡Retranché‡根深蒂固‡植入',
    nil,
    'Procure Kor, o Inamovível, em meio às Agulhas Tremulantes, no Geodomo.‡Разыщите Кора Невозмутимого в Дрожащих Вершинах.‡Findet Kor den Unbeweglichen bei den Berstenden Säulen.‡몸서리 첨탑에 있는 움직이지 않는 코르를 찾아야 합니다.‡Busca a Kor el Inamovible en Agujas Estremecedoras.‡Busca a Kor el Inamovible en Agujas Estremecedoras.‡Allez voir Kor l’Inébranlable aux Flèches Frissonnantes.‡去找颤石塔林的恒定者柯尔。‡在戰慄尖柱之間找到無法撼動的柯爾。',
  }
},
[26437] = {
  {
    'Deixando tudo claro como cristal‡Кристальная чистота‡Kristallklar‡보송보송 돌피부‡Limpieza cristalina‡Limpieza cristalina‡Clair comme du cristal de roche‡清澈如水晶‡清除水晶的障礙',
    nil,
    'Recolha 8 Formações de Cristal Calcário.‡Соберите 8 меловых кристалловидных образований.‡Sammelt 8 kalkhaltige Kristallformationen.‡석회질 수정 결정체 8개를 수집해야 합니다.‡Reúne 8 formaciones de cristal calcáreo.‡Reúne 8 formaciones de cristal calcáreo.‡Récupérez 8 Formations de cristal crayeux.‡收集8簇粉白水晶阵列。‡收集10份粉白水晶陣列。',
  }
},
[26438] = {
  {
    'Intervenção‡Угроза‡Intervention‡개입‡Intervención‡Intervención‡Intervention‡干涉介入‡介入',
    nil,
    'Mate 12 Esfola-pedras Pontajaspe.‡Убейте 12 яшмоголовых камнедеров.‡Tötet 12 Jaspisspitzenfelsklauen.‡벽옥석 바위갈퀴 12마리를 처치해야 합니다.‡Mata a 12 despellejadores de roca Puntajaspe.‡Mata a 12 despellejadores de roca Puntajaspe.‡Tuez 12 Écorche-rocs pointe-de-jaspe.‡消灭12名玉角掠石虫。‡殺死12隻玉尖岩石鐮奪怪。',
  }
},
[26439] = {
  {
    'Juntando os pedaços‡Сформировать заново‡Die Teile zusammenfügen‡조각 맞추기‡Reunir todas las piezas‡Reunir todas las piezas‡Une reconstitution pierreuse‡拼成一块儿‡石頭拼圖',
    nil,
    'Ajude a reabilitar 6 Elementais Rochosos Inativos.‡Помогите 6 спящим каменным элементалям заново сформироваться.‡Helft 6 schlafenden steingebundenen Elementaren dabei, sich neu zusammenzufügen.‡잠든 바위속박 정령 6마리가 형태를 갖춰 결합하도록 도와야 합니다.‡Ayuda a 6 elementales vinculados a la piedra en hibernación a reformarse.‡Ayuda a 6 elementales vinculados a la piedra en hibernación a reformarse.‡Aidez 6 Élémentaires dormants liés à la pierre à reprendre forme.‡帮助6名休眠的石缚元素重新塑形。‡協助6個沉睡的石縛元素重組。',
  }
},
[26440] = {
  {
    'Tu te tornas eternamente responsável...‡Приставучий‡Anhänglich‡돌이지만 괜찮아‡Pegajoso‡Pegajoso‡Le pot de colle‡粘着‡黏人精',
    nil,
    'Leve o Cascalho até a grande formação de cristais nas Agulhas Tremulantes.‡Отведите Камешка к большому скоплению кристаллов в Дрожащих Вершинах.‡Bringt Kieselchen zur großen Kristallformation in den Berstenden Säulen.‡돌돌이를 몸서리 첨탑에 있는 커다란 수정 결정체로 데려가야 합니다.‡Lleva a Guijarro hasta la gran formación cristalina en Agujas Estremecedoras.‡Lleva a Guijarro hasta la gran formación cristalina en Agujas Estremecedoras.‡Emmenez Gravillon jusqu’à la grande formation de cristaux, aux Flèches Frissonnantes.‡把佩波带到颤石塔林的大型水晶阵列那里去。‡將小石岩帶去戰慄尖柱裡的大型水晶叢。',
  }
},
[26441] = {
  {
    'Tão bonitinho...‡Такой большой, такой круглый…‡So groß, so rund…‡엄청나게 크고, 둥근...‡Tan grande, tan redondo...‡Tan grande, tan redondo...‡Si gros, si rond…‡好大，好圆……‡真大，真圓......',
    nil,
    'Fale com Kor para descobrir de que tipo de comida o Cascalho gosta.‡Поговорите с Кором, чтобы узнать, чем можно накормить Камешка.‡Sprecht mit Kor, um herauszufinden, was Kieselchen gerne isst.‡코르와 대화를 나누고 돌돌이가 좋아하는 음식을 알아내야 합니다.‡Habla con Kor para averiguar qué tipo de comida le gusta a Guijarro.‡Habla con Kor para averiguar qué tipo de comida le gusta a Guijarro.‡Allez voir Kor pour savoir quel genre de nourriture Gravillon aime manger.‡跟柯尔谈一谈，看看佩波可能喜欢怎样的食物。‡和柯爾說話，看看小石岩可能喜歡什麼食物。',
  }
},
[26442] = {
  {
    'Lagosta das Rochas‡Скальный омар‡Felshummer‡바위 바닷가재‡Langosta de roca‡Langosta de roca‡Les homards des rochers‡岩虾‡石岩龍蝦',
    nil,
    'Colete 6 Lagostas das Rochas das armadilhas embaixo do píer do Porto de Ventobravo. Cuidado com os tubarões!‡Соберите 6 скальных омаров из ловушек под пристанью в порту Штормграда. Остерегайтесь акул!‡Sammelt 6 Felshummer aus den Käfigen unter den Docks im Hafen von Sturmwind auf. Achtet auf Haie!‡스톰윈드 항구에 있는 부두 아래 덫에서 바위 바닷가재 6마리를 잡아야 합니다. 상어를 조심하세요!‡Recoge 6 langostas de roca de las jaulas que hay bajo los muelles en el Puerto de Ventormenta. ¡Cuidado con los tiburones!‡Recoge 6 langostas de roca de las jaulas que hay bajo los muelles en el Puerto de Ventormenta. ¡Cuidado con los tiburones!‡Récupérez 6 Homards des rochers dans les cages, sous les quais du Port de Hurlevent. Faites attention aux requins !‡从暴风城港口码头下的笼子里收集6只岩虾。小心鲨鱼！‡從暴風港碼頭下面的籠子裡收集6尾石岩龍蝦。小心鯊魚!',
  }
},
[26443] = {
  {
    'Planos diabólicos‡Демонические планы‡Teuflische Pläne‡악마의 계획서‡Planes diabólicos‡Planes diabólicos‡Les plans diaboliques‡恶魔的计划‡殘忍計畫',
    nil,
    'Entregue os Planos Diabólicos para o Vindicante Vedaar no Acampamento de Lenhadores Brado Guerreiro, que fica no Vale Gris.‡Доставьте демонические планы воздаятелю Ведаару на лесозаготовки Песни Войны в Ясеневый лес.‡Liefert die teuflischen Pläne bei Verteidiger Vedaar am Holzfällerlager des Kriegshymnenklans in Eschental ab.‡잿빛 골짜기의 전쟁노래 벌목기지에 있는 구원자 베다르에게 악마의 계획서를 가져가야 합니다.‡Entrega los planes diabólicos al vindicador Vedaar en el Aserradero Grito de Guerra, en Vallefresno.‡Entrega los planes diabólicos al vindicador Vedaar en el Aserradero Grito de Guerra, en Vallefresno.‡Apportez les Plans diaboliques au Redresseur de torts Vedaar au Camp de bûcherons Chanteguerre, en Orneval.‡将恶魔的计划交给灰谷战歌伐木营地的守备官维达尔。‡將殘忍計畫送去梣谷的戰歌伐木營地給復仇者維達。',
  }
},
[26444] = {
  {
    'Destrua a Legião‡Уничтожить Легион!‡Zerstört die Legion‡불타는 군단 섬멸‡Destruye a la Legión‡Destruye a la Legión‡Détruire la Légion‡消灭军团‡摧毀軍團',
    nil,
    'Mate 15 demônios de qualquer tipo no Monte Fogovil, no Cânion do Demônio Caído e na Serra do Demônio Caído.‡Убейте 15 демонов на холме Демонического Огня, в каньоне Гибели Демона и гряде Гибели Демона.‡Tötet 15 beliebige Dämonen am Dämonenhügel, am Dämonensturz und am Dämonenstieg.‡악령불 언덕, 악마벼락 협곡, 악마벼락 마루에서 악마 15명을 처치해야 합니다.‡Mata a 15 demonios en Cerro Lumbrevil, en Barranco del Demonio y en Cresta del Demonio.‡Mata a 15 demonios en Cerro Lumbrevil, en Barranco del Demonio y en Cresta del Demonio.‡Tuez 15 démons de n’importe quel type sur la Colline Gangrefeu, dans le Canyon de la Malechute et sur la Crête de la Malechute.‡消灭冥火岭、屠魔峡谷和屠魔山的任意15名恶魔。‡在冥火嶺、屠魔峽谷和屠魔山消滅15個惡魔。',
  }
},
[26445] = {
  {
    'Basta!‡Больше никогда!‡Nie wieder!‡두 번 다시 일어나서는 안 될 일!‡¡Nunca más!‡¡Nunca más!‡Plus jamais !‡绝不再会了！‡永遠沒有下一次!',
    nil,
    'Consiga a Espada Flamejante de Gorgannon e a Lança Maligna do Inquisidor.‡Добудьте пламенеющее лезвие Горганнона и желчное копье Ищейки.‡Besorgt Gorgannons flammende Klinge und den Teufelsspeer des Suchers.‡고르간논의 불타는 칼날과 수색자의 지옥창을 획득해야 합니다.‡Consigue la hoja llameante de Gorgannon y la lanza vil de buscador.‡Consigue la hoja llameante de Gorgannon y la lanza vil de buscador.‡Récupérez l’Épée de flammes de Gorgannon et la Gangrelance du Chercheur.‡获得戈加农的烈焰之锋和搜寻者的魔化长矛。‡取得戈甘諾恩的烈焰之刃和追尋者的魔化長矛。',
  }
},
[26446] = {
  {
    'A retomada do Monte Fogovil‡Возрождение Холма Демонического Огня‡Die Rückeroberung des Dämonenhügels‡악령불 언덕 탈환‡Recuperar el Cerro Lumbrevil‡Recuperar el Cerro Lumbrevil‡Reprendre la colline Gangrefeu‡收复冥火岭‡奪回冥火嶺',
    nil,
    'Plante 8 Mudas de Árvore em Monturos de Terra Fértil.‡Посадите 8 древесных саженцев в кучи плодородной земли.‡Pflanzt 8 Baumsetzlinge in die fruchtbaren Erdhaufen.‡기름진 흙더미에 나무 씨앗 8개를 심어야 합니다.‡Planta 8 semillas de árbol en los montículos de tierra fértil.‡Planta 8 semillas de árbol en los montículos de tierra fértil.‡Plantez 8 Boutures d\'arbre dans les Monticules de terre fertile.‡在肥沃的土壤里种植8棵小树苗。‡將8株樹苗種進肥沃的土堆裡。',
  }
},
[26447] = {
  {
    'Planos diabólicos‡Демонические планы‡Teuflische Pläne‡악마의 계획서‡Planes diabólicos‡Planes diabólicos‡Des plans diaboliques‡恶魔的计划‡殘忍計畫',
    nil,
    'Entregue os Planos Diabólicos a Valusha no Posto Machadada, que fica no Vale Gris.‡Доставьте демонические планы Валуше на Заставу Расщепленного Дерева, что в Ясеневом лесу.‡Bringt die teuflischen Pläne zu Valusha im Splitterholzposten im Eschental.‡잿빛 골짜기의 토막나무 주둔지에 있는 발루샤에게 악마의 계획서를 전달해야 합니다.‡Entrega los planes diabólicos a Valusha en el Puesto del Hachazo en Vallefresno.‡Entrega los planes diabólicos a Valusha en el Puesto del Hachazo en Vallefresno.‡Apportez les Plans diaboliques à Valusha au Poste de Bois-Brisé, en Orneval.‡将恶魔的计划交给灰谷碎木岗哨的瓦鲁莎。‡到梣谷的碎木崗哨去，將殘忍計畫遞送給瓦露薩。',
  }
},
[26448] = {
  {
    'Destrua a Legião‡Уничтожить Легион!‡Zerstört die Legion‡불타는 군단 섬멸‡Destruye a la Legión‡Destruye a la Legión‡Détruire la Légion‡消灭军团‡摧毀軍團',
    nil,
    'Mate 15 demônios de qualquer tipo no Monte Fogovil, no Cânion do Demônio Caído ou na Serra do Demônio Caído.‡Убейте 15 любых демонов на холме Демонического Огня, в каньоне Гибели Демона и гряде Гибели Демона.‡Tötet 15 beliebige Dämonen am Dämonenhügel, am Dämonensturz und am Dämonenstieg.‡악령불 언덕, 악마벼락 협곡, 악마벼락 마루에서 악마 15명을 처치해야 합니다.‡Mata a 15 demonios cualesquiera en Cerro Lumbrevil, Barranco del Demonio o Cresta del Demonio.‡Mata a 15 demonios cualesquiera en Cerro Lumbrevil, Barranco del Demonio o Cresta del Demonio.‡Tuez 15 démons de n’importe quel type sur la Colline Gangrefeu, dans le Canyon de la Malechute et sur la Crête de la Malechute.‡消灭冥火岭、屠魔峡谷和屠魔山的任意15名恶魔。‡在冥火嶺，屠魔峽谷和屠魔山消滅15個任何類型的惡魔。',
  }
},
[26449] = {
  {
    '‡Больше никогда!‡Nie wieder!‡두 번 다시 일어나서는 안 될 일!‡¡Nunca más!‡¡Nunca más!‡Plus jamais !‡绝不再会了！‡',
    nil,
    '‡Добудьте пламенеющее лезвие Горганнона и желчное копье Ищейки.‡Besorgt Gorgannons flammende Klinge und den Teufelsspeer des Suchers.‡고르간논의 불타는 칼날과 수색자의 지옥창을 획득해야 합니다.‡Consigue la hoja llameante de Gorgannon y la lanza vil de buscador.‡Consigue la hoja llameante de Gorgannon y la lanza vil de buscador.‡Récupérez l\'Épée de flammes de Gorgannon et la Gangrelance du Chercheur.‡获得戈加农的烈焰之锋和寻觅者的魔化长矛。‡',
  }
},
[26450] = {
  {
    'Se elas estão largadas por aí...‡Если они собираются просто оставить это на земле...‡Wenn sie sie einfach herumliegen lassen ...‡그냥 바닥에 버려둘 물건이라면...‡Si las van a dejar tiradas por ahí...‡Si las van a dejar tiradas por ahí...‡Ramasse ce qui traîne par terre et tiens ton roseau à deux mains...‡要是他们就把它们那么搁着的话……‡如果他們不想撿......',
    nil,
    'Obtenha 6 Ícones de Naga da Costa Selvagem Sul, que fica no Cabo do Espinhaço.‡Добудьте 6 нагских идолов с Южного Гибельного Берега на мысе Тернистой долины.‡Beschafft 6 Nagaikonen von der Südlichen Ungezähmten Küste am Schlingendornkap.‡가시덤불 곶의 폭풍 해안 남부에서 나가 상징 6개를 모아야 합니다.‡Obtén 6 iconos naga de la Costa Salvaje del Sur en El Cabo de Tuercespina.‡Obtén 6 iconos naga de la Costa Salvaje del Sur en El Cabo de Tuercespina.‡Emparez-vous de 6 Icônes nagas de la Côte Sauvage du Sud, au Cap Strangleronce‡从荆棘谷海角南野人海岸获得6尊纳迦雕像。‡從荊棘谷海角的南野人海岸取得6個納迦雕像。',
  }
},
[26451] = {
  {
    'Desafio de Gurubashi: combate de arena cada um por si‡Арена Гурубаши: все против всех!‡Gurubashiherausforderung: Jeder gegen jeden in der Arena‡구루바시 도전: 투기장 난투전‡Desafío Gurubashi: Combate en la arena todos contra todos‡Desafío Gurubashi: Combate en la arena todos contra todos‡L’arène de toutes les trolleries‡古拉巴什的挑战：竞技场混战‡古拉巴什挑戰:大亂鬥競技場',
    nil,
    'Coloque a Bandeira de Desafio de Gurubashi no chão, dentro do Ringue de Batalha. Depois, derrote o Desafiante da Arena Gurubashi.‡Установите на ринге Арены флаг вызова Гурубаши и победите соперника, вышедшего на бой.‡Stellt die Herausforderungsflagge der Gurubashi im Kampfring ab und besiegt dann den Herausforderer der Arena der Gurubashi.‡구루바시 도전 깃발을 전투장에 꽂고, 구루바시 투기장 도전자를 처치해야 합니다.‡Coloca la bandera de desafío Gurubashi dentro del Anillo de batalla y derrota al contendiente de la Arena Gurubashi.‡Coloca la bandera de desafío Gurubashi dentro del Anillo de batalla y derrota al contendiente de la Arena Gurubashi.‡Plantez le Drapeau de défi gurubashi à l’intérieur du Cercle de bataille de l\'arène des Gurubashi, puis défaites votre Adversaire de l\'arène des Gurubashi.‡将古拉巴什挑战之旗插在大竞技场里，然后打败古拉巴什竞技场挑战者。‡將古拉巴什挑戰旗幟放在戰鬥之環裡，然後擊敗古拉巴什競技場挑戰者。',
  }
},
[26452] = {
  {
    'Desafio de Gurubashi‡Вызов Гурубаши‡Gurubashiherausforderung‡구루바시 도전‡Desafío Gurubashi‡Desafío Gurubashi‡Le défi gurubashi‡古拉巴什的挑战‡古拉巴什挑戰',
    nil,
    'Coloque a Bandeira de Desafio de Gurubashi no chão, dentro do Ringue de Batalha. Depois, derrote o Desafiante da Arena Gurubashi.‡Установите на ринге Арены флаг вызова Гурубаши и победите соперника, вышедшего на бой.‡Stellt die Herausforderungsflagge der Gurubashi in dem Kampfring ab und besiegt dann den Herausforderer der Arena der Gurubashi.‡구루바시 도전 깃발을 전투장에 꽂고, 구루바시 투기장 도전자를 처치해야 합니다.‡Coloca la bandera de desafío Gurubashi dentro del Anillo de batalla y derrota al contendiente de la Arena Gurubashi.‡Coloca la bandera de desafío Gurubashi dentro del Anillo de batalla y derrota al contendiente de la Arena Gurubashi.‡Plantez le Drapeau de défi gurubashi à l’intérieur du Cercle de bataille de l\'arène des Gurubashi, puis défaites votre Adversaire de l\'arène des Gurubashi.‡将古拉巴什挑战之旗插在大竞技场里，然后打败古拉巴什竞技场挑战者。‡將古拉巴什挑戰旗幟放在戰鬥之環裡，然後擊敗古拉巴什競技場挑戰者。',
  }
},
[26453] = {
  {
    'Ajuda nunca é demais‡Рука помощи‡Eine helfende Hand‡도움의 손길‡Una mano amiga‡Una mano amiga‡La main tendue‡帮手‡伸出援手',
    nil,
    'Fale com o Arquiteto Nemos em Cantilenda, que fica no Vale Gris.|n|nA Vindicante Palannaar pode lhe dar um meio de transporte para que você chegue lá mais rapidamente.‡Отправляйтесь в Лесную Песнь и поговорите с архитектором Немосом.|n|nОбратитесь к воздаятельнице Паланааре, если вам требуется транспорт.‡Geht nach Waldeslied im Eschental und sprecht mit Architekt Nemos.|n|nVerteidigerin Palanaar kann Euch ein Reittier anbieten, um schneller dorthin zu gelangen.‡잿빛 골짜기의 숲의 노래에 있는 건축가 네모스와 대화해야 합니다.|n|n구원자 팔란나르와 대화하면 숲의 노래로 신속하게 이동할 수 있습니다.‡Habla con el arquitecto Nemos en Canción del Bosque, en Vallefresno.|n|nLa vindicadora Palanaar puede ofrecerte transporte para que llegues rápidamente.‡Habla con el arquitecto Nemos en Canción del Bosque, en Vallefresno.|n|nLa vindicadora Palanaar puede ofrecerte transporte para que llegues rápidamente.‡Allez parler à l’Architecte Nemos, au Chant des forêts, en Orneval.|n|nLe Redresseur de torts Palanaar vous permettra d\'y aller plus rapidement.‡跟灰谷林歌神殿的建筑师尼莫斯谈一谈。|n|n守备官帕兰纳尔可以为你提供坐骑，让你迅速抵达。‡和梣谷中林歌神殿的建築師尼莫斯說話。|n|n復仇者帕拉那爾能安排交通方式，讓你更快速地到達那裡。',
  }
},
[26454] = {
  {
    'Desperdício vergonhoso‡Напрасные усилия‡Eine schändliche Verschwendung‡숲의 파괴‡¡Sería una lástima desperdiciarlo!‡¡Sería una lástima desperdiciarlo!‡Un gaspillage honteux‡可耻的浪费‡可恥的浪費',
    nil,
    'Recolha 5 feixes de Madeira Vil de Satyrnaar.‡Добудьте 5 связок оскверненной древесины Сатирнаара.‡Sammelt 5 Stück verdorbenes Satyrnaarholz.‡사티르나르의 오염된 목재 5개를 수집해야 합니다.‡Reúne 5 trozos de madera vil de Satyrnaar.‡Reúne 5 trozos de madera vil de Satyrnaar.‡Rassemblez 5 fagots de Bois gangrené de Satyrnaar.‡收集15份萨提纳尔木材。‡收集5份薩提納爾魔化木材。',
  }
},
[26455] = {
  {
    'O cálice perdido‡Потерянная чаша‡Elunes Kelch‡엘룬의 성배‡El cáliz perdido‡El cáliz perdido‡Le calice perdu‡失落的圣杯‡遺失的酒杯',
    nil,
    'Consiga o Cálice de Eluna.‡Добудьте чашу Элуны.‡Bringt Elunes Kelch in Euren Besitz.‡엘룬의 성배를 획득해야 합니다.‡Consigue el Cáliz de Elune.‡Consigue el Cáliz de Elune.‡Récupérez le Calice d’Élune.‡获得艾露恩的圣杯。‡取得伊露恩酒杯。',
  }
},
[26456] = {
  {
    'Notícias do front setentrional‡Донесение с северного фронта‡Bericht von der Nordfront‡북쪽 전방에서 온 보고서‡Informe del frente norte‡Informe del frente norte‡Un rapport du front nord‡北方前线的报告‡北方前線的報告',
    nil,
    'Entregue o relatório da Sentinela Melyria para a Sentinela Cantálgures no Bosque Asa de Prata, que fica no Vale Gris.‡Доставьте донесение часового Мелирии часовому Дальней Песне в рощу Среброкрылых, что в Ясеневом лесу.‡Bringt Schildwache Melyrias Bericht zu Schildwache Weltensang im Hain der Silberschwingen im Eschental.‡잿빛 골짜기의 은빛날개 숲에 있는 파수꾼 파송에게 파수꾼 멜리리아의 보고서를 전달해야 합니다.‡Entrega el informe de la centinela Melyria a la centinela Cantolejano en el Claro Ala de Plata, en Vallefresno.‡Entrega el informe de la centinela Melyria a la centinela Cantolejano en el Claro Ala de Plata, en Vallefresno.‡Apportez le Rapport de la Sentinelle Melyria à la Sentinelle Chanteloin au Bosquet d’Aile-argent, en Orneval.‡将哨兵梅丽瑞亚的报告送给灰谷银翼树林的哨兵艾蒂亚·轻歌。‡將哨兵梅麗瑞亞的報告帶去梣谷中的銀翼樹林給哨兵遠歌。',
  }
},
[26457] = {
  {
    'Agentes da destruição‡Пособники разрушения‡Agenten der Zerstörung‡파괴에 대한 응징‡Agentes de destrucción‡Agentes de destrucción‡Les agents de la destruction‡毁灭的使者‡毀滅的媒介',
    nil,
    'Mate o Feitor Gorthak e mais 12 membros da Horda no Acampamento de Lenhadores Brado Guerreiro.‡Убейте надзирателя Гортака и 12 других сторонников Орды на лесозаготовках Песни Войны.‡Tötet Vorarbeiter Gorthak und 12 weitere, beliebige Mitglieder der Horde im Holzfällerlager des Kriegshymnenklans.‡전쟁노래 벌목기지에서 감독관 고르닥과 호드 병사 12명을 처치해야 합니다.‡Mata al sobrestante Gorthak y a otros 12 miembros de la Horda en el Aserradero Grito de Guerra.‡Mata al sobrestante Gorthak y a otros 12 miembros de la Horda en el Aserradero Grito de Guerra.‡Tuez le Surveillant Gorthak et 12 autres membres de la Horde du Camp de bûcherons Chanteguerre.‡杀死监工古尔萨克和战歌伐木营地的12名部落。‡在戰歌伐木營地殺死監督者高薩克和任何其他12名的部落成員。',
  }
},
[26458] = {
  {
    '‡Наступление сумерек‡Die Stunde der Finsternis‡황혼의 망치단의 몰락‡Cascada Crepuscular‡Cascada Crepuscular‡Le crépuscule descend‡暮光之锤的末日‡',
    nil,
    '‡Принесите 10 подвесок Сумерек часовому Алувин в лагерь у Непроглядной Пучины.‡Bringt 10 Zwielichtanhänger zu Schildwache Aluwyn am Stützpunkt an der Grotte.‡검은심연 야영지 있는 파수꾼 알루윈에게 황혼의 펜던트 10개를 가져가야 합니다.‡Lleva 10 colgantes Crepusculares a la centinela Aluwyn en el Campamento Brazanegra.‡Lleva 10 colgantes Crepusculares a la centinela Aluwyn en el Campamento Brazanegra.‡Apportez 10 Pendentifs du Crépuscule à la Sentinelle Aluwyn, au Camp de Brassenoire.‡收集10个暮光坠饰，把它们交给达纳苏斯的银月守卫玛纳杜斯。‡',
  }
},
[26459] = {
  {
    '‡Исследование порчи‡Erforschung der Verderbnis‡타락에 대한 연구‡Investigaciones acerca de la corrupción‡Investigaciones acerca de la corrupción‡Recherches sur la corruption‡研究堕落‡',
    nil,
    '‡Релвин Тень Звезды в лагере у Непроглядной Пучины хочет, чтобы вы принесли ему 8 оскверненных стволов мозга.‡Relwyn Schattenstern im Stützpunkt an der Grotte möchte 8 verderbte Hirnstämme.‡검은심연 야영지에 있는 렐윈 쉐이드스타가 변이된 뇌간 8개를 가져다 달라고 했습니다.‡Relwyn Sombrestrella en el Campamento Brazanegra quiere 8 bulbos raquídeos corruptos.‡Relwyn Sombrestrella en el Campamento Brazanegra quiere 8 bulbos raquídeos corruptos.‡Relwyn Sombrétoile, du Camp de Brassenoire, vous a demandé de récupérer 8 Troncs cérébraux corrompus.‡奥伯丁的戈沙拉·夜语需要8块堕落者的脑干。‡',
  }
},
[26460] = {
  {
    '‡В поисках Талрида‡Auf der Suche nach Thaelrid‡타엘리드 찾기‡Buscando a Thaelrid‡Buscando a Thaelrid‡À la recherche de Thaelrid‡寻找塞尔瑞德‡',
    nil,
    '‡Найдите разведчика Талрида из ордена Серебряного Рассвета в Непроглядной Пучине.‡Sucht Späher Thaelrid in der Tiefschwarzen Grotte auf.‡검은심연 나락에서 정찰병 타엘리드를 찾아야 합니다.‡Busca al explorador Thaelrid en las Cavernas de Brazanegra.‡Busca al explorador Thaelrid en las Cavernas de Brazanegra.‡Partez à la recherche de l\'Éclaireur Thaelrid, à l\'intérieur des Profondeurs de Brassenoire.‡到黑暗深渊去找到银月守卫塞尔瑞德。‡',
  }
},
[26461] = {
  {
    '‡Злодейство в Непроглядной Пучине‡Schurkerei in der Tiefschwarzen Grotte‡검은심연의 음모‡La vileza de Brazanegra‡La vileza de Brazanegra‡L\'infamie de Brassenoire‡黑暗深渊中的恶魔‡',
    nil,
    '‡‡Bringt den Kopf von Zwielichtfürst Kelris zu Ashelan Nordwald im Stützpunkt an der Grotte.‡‡Llévale la cabeza del señor crepuscular Kelris a Ashelan Bosquenorte en el Campamento Brazanegra.‡Llévale la cabeza del señor crepuscular Kelris a Ashelan Bosquenorte en el Campamento Brazanegra.‡Apportez la Tête du Seigneur du Crépuscule Kelris à Ashelan Bois-du-nord, au Camp de Brassenoire.‡把梦游者克尔里斯的头颅交给达纳苏斯的哨兵塞尔高姆。‡',
  }
},
[26462] = {
  {
    'O Revatusco perverso‡Мерзкий Сломанный Клык‡Die bösen Bruchhauer‡사악한 깨진엄니 트롤‡Los malvados Sañadiente‡Los malvados Sañadiente‡Ces satanés Vengebroches‡邪恶的恶齿‡無良惡齒',
    nil,
    'Mate 10 Espreitadores Revatusco ou Bagateiros Revatusco.‡Убейте 10 ловчих или мастеров проклятий из племени Сломанного Клыка.‡Tötet 10 Pirscher der Bruchhauer oder Verhexer der Bruchhauer.‡깨진엄니 추적자 또는 깨진엄니 사술사 10명을 처치해야 합니다.‡Mata a 10 acechadores Sañadiente o a aojadores Sañadiente.‡Mata a 10 acechadores Sañadiente o a aojadores Sañadiente.‡Tuez 10 Traqueurs ou Maléficieurs vengebroches.‡杀死10名恶齿猎手或恶齿妖术师。‡殺死10個惡齒潛獵者或惡齒妖術師。',
  }
},
[26463] = {
  {
    'Procurando Teronis‡В поисках Терониса‡Findet Teronis‡테로니스 찾기‡Encontrar a Teronis‡Encontrar a Teronis‡Recherche Teronis désespérément‡寻找泰洛尼斯‡尋找泰洛尼斯',
    nil,
    'Procure Teronis no Lago Falathim, que fica no Vale Gris.‡Найдите Терониса у озера Фалатим, что в Ясеневом лесу.‡Sucht am Falathimsee im Eschental nach Teronis.‡잿빛 골짜기의 팔라딤 호수에서 테로니스를 찾아야 합니다.‡Encuentra a Teronis en el Lago Falathim en Vallefresno.‡Encuentra a Teronis en el Lago Falathim en Vallefresno.‡Retrouvez Teronis au lac Falathim, en Orneval.‡在灰谷的法拉希姆湖找到泰洛尼斯。‡到梣谷的法拉希姆湖找泰洛尼斯。',
  }
},
[26464] = {
  {
    'A gema perdida‡Пропавший камень‡Der verlorene Stein‡잃어버린 보석‡La gema perdida‡La gema perdida‡L’aventurier de la gemme perdue‡莱恩的净化‡失落的寶石',
    nil,
    'Encontre a Gema Faiscante.‡Найдите светящийся самоцвет.‡Findet den leuchtenden Edelstein.‡빛나는 보석을 찾아야 합니다.‡Encuentra la gema resplandeciente.‡Encuentra la gema resplandeciente.‡Trouvez la Gemme luminescente.‡找到发光的宝石。‡找出發光的寶石。',
  }
},
[26465] = {
  {
    'As estatuetas ancestrais‡Древние статуэтки‡Die antiken Statuetten‡고대 조각상‡Las antiguas estatuillas‡Las antiguas estatuillas‡Les statuettes antiques‡古代雕像‡古代雕像',
    nil,
    'Recolha 10 Estatuetas Ancestrais.‡Добудьте 10 древних статуэток.‡Besorgt 10 antike Statuetten.‡고대 조각상 10개를 모아야 합니다.‡Consigue 10 estatuillas antiguas.‡Consigue 10 estatuillas antiguas.‡Récupérez 10 Statuettes antiques.‡收集10个古代雕像。‡收集10個古代雕像。',
  }
},
[26466] = {
  {
    'Ruuzel‡Руузель‡Ruuzel‡루젤‡Ruuzel‡Ruuzel‡Ruuzel‡卢泽尔‡盧澤爾',
    nil,
    'Obtenha o Anel de Zoram.‡Добудьте кольцо Зорама.‡Nehmt den Ring von Zoram an Euch.‡조람의 반지를 획득해야 합니다.‡Consigue el Anillo de Zoram.‡Consigue el Anillo de Zoram.‡Trouvez l’Anneau de Zoram.‡获得佐拉姆之戒。‡取得佐拉姆之戒。',
  }
},
[26467] = {
  {
    'Malditos sátiros! Dríades em perigo!‡Сатиры коварны! Дриады в опасности!‡Elende Satyrn! Die Dryaden sind in Gefahr!‡사악한 사티로스와 위기의 드리아드‡¡Vil sátiro! ¡Dríades en peligro!‡¡Vil sátiro! ¡Dríades en peligro!‡Vil satyre ! Dryades en danger !‡身陷危险的树妖！‡邪惡的薩特!身陷危險的林精!',
    nil,
    'Encontre Anilia em Xavian, que fica no Vale Gris.‡Найдите в Ксавиане Анилию.‡Sucht in Xavian im Eschental nach Anilia.‡잿빛 골짜기의 사비안에서 아닐리아를 찾아야 합니다.‡Encuentra a Anilia en Xavian, en Vallefresno.‡Encuentra a Anilia en Xavian, en Vallefresno.‡Trouvez Anialia à Xavian, en Orneval.‡去找灰谷萨维亚的安妮莉亚。‡到梣谷的薩維亞去找安妮莉亞。',
  }
},
[26468] = {
  {
    'O ramo de Cenarius‡Ветвь Кенария‡Der Zweig des Cenarius‡세나리우스의 가지‡La Rama de Cenarius‡La Rama de Cenarius‡La branche de Cénarius‡塞纳留斯的树枝‡塞納留斯的樹枝',
    nil,
    'Consiga o Ramo de Cenarius.‡Добудьте Ветвь Кенария.‡Erhaltet den Zweig des Cenarius.‡세나리우스의 가지를 획득해야 합니다.‡Consigue la Rama de Cenarius.‡Consigue la Rama de Cenarius.‡Récupérez la Branche de Cénarius.‡获得塞纳留斯的树枝。‡取得塞納留斯的樹枝。',
  }
},
[26469] = {
  {
    'Temporada de caça aos sátiros‡Убийство сатиров!‡Satyrn schlachten!‡사티로스 처치‡¡Muerte a los sátiros!‡¡Muerte a los sátiros!‡Mort aux satyres !‡杀掉萨特！‡獵殺薩特!',
    nil,
    'Consiga 16 Chifres de Sátiro.‡Добудьте 16 рогов сатиров.‡Erhaltet 16 Satyrhörner.‡사티로스의 뿔 16개를 획득해야 합니다.‡Consigue 16 cuernos de sátiro.‡Consigue 16 cuernos de sátiro.‡Rassembler 16 Cornes de satyre.‡获得16个萨特的角。‡取得16支薩特的角。',
  }
},
[26470] = {
  {
    'A retomada do Lago Mistral‡Отвоевать озеро‡Die Rückeroberung des Mystralsees‡미스트랄 호수 수복‡Retomar el Lago Mystral‡Retomar el Lago Mystral‡Mystral gagnant‡收复密斯特拉湖‡收復密斯特拉湖',
    nil,
    'Mate Mareante e 12 Elementais da Água Contaminados.‡Убейте 12 злобных элементалей воды и Приливницу.‡Tötet 12 beschmutzte Wasserelementare und Tideress.‡타락한 물의 정령 12마리와 타이더레스를 처치해야 합니다.‡Mata a 12 elementales de agua podrida y Marearess.‡Mata a 12 elementales de agua podrida y Marearess.‡Tuez 12 Élémentaires d’eau souillés et Maréen.‡消灭12个污浊的水元素以及泰德雷斯。‡殺死12個污濁的水元素與泰德雷斯。',
  }
},
[26471] = {
  {
    '‡Знание в пучине‡Wissen in der Tiefe‡심연의 지식‡Conocimiento en las Cavernas‡Conocimiento en las Cavernas‡La connaissance des profondeurs‡深渊中的知识‡',
    nil,
    '‡Принесите манускрипт Лоргалиса курсанту-часовому Иссаре в лагерь у Непроглядной Пучины.‡Bringt das \'Manuskript von Lorgalis\' zu Schildwachenschülerin Issara zum Stützpunkt an der Grotte.‡검은심연 야영지에 있는 파수꾼 훈련생 이사라에게 로르갈리스 초본을 가져가야 합니다.‡Lleva el manuscrito de Lorgalis a la centinela practicante Issara que está en el Campamento Brazanegra.‡Lleva el manuscrito de Lorgalis a la centinela practicante Issara que está en el Campamento Brazanegra.‡Apportez le Manuscrit de Lorgalis à l\'Apprentie sentinelle Issara, au Camp de Brassenoire.‡把洛迦里斯手稿带给铁炉堡的葛利·硬骨。‡',
  }
},
[26472] = {
  {
    'Druidas insanos‡Безумные друиды‡Irrsinnige Druiden‡미쳐버린 드루이드‡Druidas dementes‡Druidas dementes‡Les druides fous‡疯狂的德鲁伊‡瘋狂的德魯伊',
    nil,
    'Mate os druidas insanos: Taneel Lenhanegra, Uthil Chamaluna e Mavoris Rasganimbus.‡Убейте обезумевших друидов: Таниэля Темный Лес, Этиля Зов Луны и Мавориса Проблеск Солнца.‡Tötet die irrsinnigen Druiden: Taneel Finsterwald, Uthil Mondweise und Mavoris Wolkenbruch.‡드루이드 지도자인 타닐 다크우드, 우실 문콜, 마보리스 클라우즈브레이크를 처치해야 합니다.‡Mata a los druidas enloquecidos: Taneel Leñoscuro, Uthil Llamaluna y Mavoris Quiebranubes.‡Mata a los druidas enloquecidos: Taneel Leñoscuro, Uthil Llamaluna y Mavoris Quiebranubes.‡Tuez les druides devenus fous : Taneel Sombrebois, Uthil Huchelune et Mavoris Éclairciel.‡杀掉疯狂的德鲁伊：坦尼尔·黑木、尤希尔·唤月和玛沃里斯·裂云。‡殺死發瘋的德魯伊：坦尼爾·暗木、尤希爾·喚月，和瑪沃里斯·裂雲。',
  }
},
[26473] = {
  {
    'Cabelo-de-bathran‡Батранов волос‡Bathranshaar‡배스랜모초‡Cabello de Bathran‡Cabello de Bathran‡Les cheveux de Bathran‡巴斯兰的头发‡巴斯蘭之髮',
    nil,
    'Colha 8 ramos de Cabelo-de-bathran.‡Соберите 8 стеблей Батранова волоса.‡Sammelt 8 Büschel Bathranshaar.‡배스랜모초 8개를 수집해야 합니다.‡Consigue 8 cabellos de Bathran.‡Consigue 8 cabellos de Bathran.‡Cueillez 8 Cheveux de Bathran.‡收集8束巴斯兰的头发。‡收集8份巴斯蘭之髮。',
  }
},
[26474] = {
  {
    'A cura de Orendil‡Лекарство Орендила‡Orendils Heilmittel‡오렌딜의 치료제‡Cura de Orendil‡Cura de Orendil‡La jouvence d\'Orendil‡奥雷迪尔的药剂‡奧蘭迪爾的藥劑',
    nil,
    'Entregue a Cura de Orendil a Pelturas Lunalva em Astranaar, que fica no Vale Gris.‡Принесите лекарство Орендила Пельтуру Белой Луне в Астранаар, что в Ясеневом лесу.‡Bringt Orendils Heilung zu Pelturas Weißmond in Astranaar im Eschental.‡잿빛 골짜기의 아스트라나르에 있는 펠투러스 화이트문에게 오렌딜의 치료제를 가져가야 합니다.‡Llévale la cura de Orendil a Pelturas Lunablanca en Astranaar, en Vallefresno.‡Llévale la cura de Orendil a Pelturas Lunablanca en Astranaar, en Vallefresno.‡Apportez la Jouvence d’Orendil à Pelturas Blanchelune à Astranaar, en Orneval.‡将奥雷迪尔的药剂交给灰谷阿斯特拉纳的皮尔图拉斯·怀特姆恩。‡把奧蘭迪爾的藥劑帶去梣谷的阿斯特蘭納，交給皮爾圖拉斯·白月。',
  }
},
[26475] = {
  {
    'A lágrima de Eluna‡Слеза Элуны‡Elunes Träne‡엘룬의 눈물‡Lágrima de Elune‡Lágrima de Elune‡La larme d\'Élune‡月神之泪‡伊露恩之淚',
    nil,
    'Consiga uma Lágrima de Eluna.‡Найдите Слезу Элуны.‡Erhaltet eine Träne Elunes.‡엘룬의 눈물을 구해야 합니다‡Consigue la lágrima de Elune.‡Consigue la lágrima de Elune.‡Trouvez une Larme d’Élune.‡拿到月神之泪。‡收集伊露恩之淚。',
  }
},
[26476] = {
  {
    'Trabalho de dríade‡Посылка для дриад‡Dryadenlieferung‡드리아드 찾기‡La entrega a la dríade‡La entrega a la dríade‡La nymphe de ces bois‡给树妖的货物‡林精的遞送',
    nil,
    'Entregue a Gema Faiscante a Shael\'dryn na Torre do Bosque Real, que fica no Vale Gris.‡Отнесите светящийся самоцвет Шаэлдрин у башни в Ночных лесах, что в Ясеневом лесу.‡Liefert den leuchtenden Edelstein bei Shael\'dryn beim Rajenbaumturm im Eschental ab.‡잿빛 골짜기의 레인나무 탑에 있는 셸드린에게 빛나는 보석을 가져가야 합니다.‡Entrega la gema resplandeciente a Shael\'dryn en la Torre de la Algaba en Vallefresno.‡Entrega la gema resplandeciente a Shael\'dryn en la Torre de la Algaba en Vallefresno.‡Apportez la Gemme luminescente à Shael’dryn, à la Tour de Raynebois, en Orneval.‡将发光的宝石交给灰谷阿林中树塔的莎尔蒂恩。‡將發光的寶石送去梣谷的林中塔給夏爾德琳。',
  }
},
[26477] = {
  {
    'Madeira sem lei‡Поиски древка‡Sucht den Schaft‡나무 열쇠‡¿Dónde están las llaves?‡¿Dónde están las llaves?‡Ô, ma chère cassette !‡找树干‡搜尋樹幹',
    nil,
    'Encontre a Chave de Madeira e use-a para pegar a Haste de Ferro do Bastão de Dartol.‡Найдите деревянный ключ и с его помощью получите железное древко жезла Дартола.‡Sucht den hölzernen Schlüssel und benutzt ihn, um den Eisenschaft von Dartols Rute zu finden.‡나무 열쇠를 획득해, 다르톨의 마법봉의 한 부분인 철제 자루가 든 상자를 열어야 합니다.‡Encuentra la llave de madera y úsala para conseguir un trozo de asta de hierro de la vara de Dartol.‡Encuentra la llave de madera y úsala para conseguir un trozo de asta de hierro de la vara de Dartol.‡Trouvez la Clé en bois et utilisez-la pour obtenir la Hampe en fer du Bâtonnet de Dartol.‡找到木制钥匙，用它来获得达图尔魔棒的铁杆部分。‡找到木製鑰匙，並利用它取得達圖爾的魔棒的鐵杆部份。',
  }
},
[26478] = {
  {
    'Fingindo de morto‡Притвориться мертвым‡Sich tot stellen‡죽은 척하기‡Hacerse el muerto‡Hacerse el muerto‡Faire le mort‡装死‡裝死',
    nil,
    'Pegue a última peça do Bastão de Dartol, o Castão de Ferro.‡Найдите последний фрагмент жезла Дартола, Железное навершие.‡Erhaltet das letzte Teil von Dartols Rute, den Eisenschwertknauf.‡다르톨의 마법봉을 만들기 위한 마지막 조각인 철제 머리장식을 획득해야 합니다.‡Consigue el pomo de hierro, la última pieza de la vara de Dartol.‡Consigue el pomo de hierro, la última pieza de la vara de Dartol.‡Trouvez le dernier morceau du Bâtonnet de Dartol, le Pommeau en fer.‡获得达图尔魔棒的最后一部分，铁质柄头。‡取得達圖爾的魔棒的最後一段，鐵質柄頭。',
  }
},
[26479] = {
  {
    'Retorno a Raene‡Возвращение к Раэне‡Rückkehr zu Raene‡레이네에게로‡Regresa con Raene‡Regresa con Raene‡Retourner voir Raene‡去找莱恩‡去找萊恩',
    nil,
    'Entregue o Bastão de Dartol para Raene Correlobos em Astranaar, no Vale Gris.‡Вернитесь к Раэне Волкопас в Астранаар, что в Ясеневом лесу, и передайте ей жезл Дартола.‡Liefert Dartols Rute bei Raene Wolfsläufer in Astranaar im Eschental ab.‡잿빛 골짜기의 아스트라나르에 있는 레이네 울프러너에게 다르톨의 마법봉을 전달해야 합니다.‡Entrega la vara de Dartol a Raene Correlobo en Astranaar, en Vallefresno.‡Entrega la vara de Dartol a Raene Correlobo en Astranaar, en Vallefresno.‡Apportez le Bâtonnet de Dartol à Raene Mène-loup, à Astranaar.‡将达图尔魔棒交给灰谷阿斯特兰纳的莱恩·狼行者。‡到梣谷的阿斯特蘭納，將達圖爾的魔棒交給萊恩·狼行者。',
  }
},
[26480] = {
  {
    'Bastão de Dartol‡Жезл Дартола‡Dartols Rute‡다르톨의 마법봉‡La vara de Dartol‡La vara de Dartol‡Le bâtonnet de Dartol‡达图尔魔棒‡達圖爾的魔棒',
    nil,
    'Use o Bastão de Dartol para se comunicar com Krolg na Cabana do Krolg, que fica no Vale Gris.‡Найдите Кролга в его хижине в Ясеневом лесу и поговорите с ним при помощи жезла Дартола.‡Benutzt Dartols Rute, um mit Krolg bei Krolgs Hütte im Eschental kommunizieren zu können.‡다르톨의 마법봉의 힘을 사용해 잿빛 골짜기의 크롤그의 오두막에 있는 크롤그와 대화해야 합니다.‡Usa la vara de Dartol para comunicarte con Krolg en la Cabaña de Krolg, en Vallefresno.‡Usa la vara de Dartol para comunicarte con Krolg en la Cabaña de Krolg, en Vallefresno.‡Utilisez le Bâtonnet de Dartol pour pouvoir communiquer avec Krolg, à la Hutte de Krolg, en Orneval.‡使用达图尔魔棒同灰谷克罗尔格的小屋的克罗尔格沟通。‡使用達圖爾的魔棒，在梣谷的庫羅格小屋和庫羅格說話。',
  }
},
[26481] = {
  {
    'Enfeite novo‡Новое украшение‡Eine neue Verzierung‡새로운 장식품‡Un nuevo adorno‡Un nuevo adorno‡Un nouvel accessoire‡新装饰‡新的飾品',
    nil,
    'Consiga o Crânio de Ran Dente Sangrento e o Bastão de Dartol.‡Добудьте череп Рэна Кровавого Клыка и жезл Дартола.‡Erhaltet Ran Blutreißers Schädel und Dartols Rute.‡랜 블러드투스의 해골과 다르톨의 마법봉을 획득해야 합니다.‡Consigue la calavera de Ran Sangradientes y la vara de Dartol.‡Consigue la calavera de Ran Sangradientes y la vara de Dartol.‡Obtenir le Crâne de Ran Dent-rouge et le Bâtonnet de Dartol.‡获得兰恩·血牙的徽记和达图尔魔棒。‡取得蘭恩‧血牙的顱骨與達圖爾的魔棒。',
  }
},
[26482] = {
  {
    'O verdadeiro poder do bastão‡Истинная сила жезла‡Die wahre Macht der Rute‡마법봉의 진정한 힘‡El verdadero poder de la vara‡El verdadero poder de la vara‡Par le pouvoir du bâtonnet ancestral‡魔棒的真正力量‡魔棒的真實力量',
    nil,
    'Use o Bastão de Dartol e fale com Ota Wen. Convença-o a se insurgir contra os opressores da Horda. Em seguida, entregue o Bastão de Dartol para Raene Correlobos.‡Используя жезл Дартола, поговорите с Ота Веном и уговорите его поднять восстание против ордынских захватчиков. Затем отнесите жезл Раэне Волкопас.‡Benutzt Dartols Rute und sprecht mit Ota Wen. Überzeugt ihn, sich gegen die Unterdrücker der Horde aufzulehnen. Bringt dann Dartols Rute zu Raene Wolfsläufer.‡다르톨의 마법봉을 이용해 오타 원과 대화하고, 오타 원을 호드와 맞서 싸우도록 설득해야 합니다. 그 후 다르톨의 마법봉을 레이네 울프러너에게 가져가야 합니다.‡Usa la vara de Dartol, habla con Ota Wen y convéncele para que se levante contra sus opresores de la Horda. Después, entrega la vara de Dartol a Raene Correlobo.‡Usa la vara de Dartol, habla con Ota Wen y convéncele para que se levante contra sus opresores de la Horda. Después, entrega la vara de Dartol a Raene Correlobo.‡Utilisez le Bâtonnet pour parler à Ota Wen. Persuadez-le de se rebeller contre ses oppresseurs de la Horde. Ensuite, remettez le Bâtonnet de Dartol à Raene Mène-loup.‡使用达图尔魔棒跟奥塔·旺交谈。说服他起义对抗部落。然后将达图尔魔棒交给莱恩·狼行者。‡使用達圖爾的魔棒並和歐塔·文說話。說服他起身對抗壓迫奴役它的部落。然後，將達圖爾的魔棒交給萊恩·狼行者。',
  }
},
[26483] = {
  {
    'Gan\'dranda‡Ган\'дранда‡Gan\'dranda‡간드란다‡Gan\'dranda‡Gan\'dranda‡Gan\'dranda‡甘德朗达‡甘德蘭達',
    nil,
    'Mate Gan\'dranda.‡Убейте Ган\'дранду.‡Tötet Gan\'dranda.‡간드란다를 처치해야 합니다.‡Mata a Gan\'dranda.‡Mata a Gan\'dranda.‡Tuez Gan’dranda.‡杀死甘德朗达。‡殺死甘德蘭達。',
  }
},
[26484] = {
  {
    'Ajuda ao Larpétreo‡На помощь Каменному очагу‡Hilfe für Steinruh‡돌난로를 지켜라‡Ayuda para el Hogar Pétreo‡Ayuda para el Hogar Pétreo‡Au secours d’Âtrepierre‡增援巨石之炉‡援助石爐',
    nil,
    'Fale com Petros Esmagapedra no Larpétreo, que fica no Geodomo.‡Поговорите с Крегом Крушителем Скал в Каменном очаге в Подземье.‡Sprecht mit Spalt Steinbrecher in Steinruh in Tiefenheim.‡심원의 영지의 돌난로에 있는 크래그 록크러셔와 대화해야 합니다.‡Habla con Crag Aplastarrocas en el Hogar Pétreo en Infralar.‡Habla con Crag Aplastarrocas en el Hogar Pétreo en Infralar.‡Allez voir Crag Broie-la-roche à Âtrepierre, dans le Tréfonds.‡与深岩之洲巨石之炉的克拉格·摧石者谈一谈。‡在地深之源的石爐和峭壁碾石者說話。',
  }
},
[26485] = {
  {
    'Mordeliscas, jovem!‡Хрустогрызы, сэр!‡Schnappkiefer, Bursche!‡바닷물 무쇠턱거북!‡¡Quijafortes, colega!‡¡Quijafortes, colega!‡Les Gueules d\'acier, camarade !‡钳嘴，小子！‡鉗嘴龜，小子!',
    nil,
    'Colete 8 Moelas de Mordelisca de Mordeliscas de Água Salgada.‡Соберите 8 кучек потрохов морских хрустогрызов.‡Beschafft 8 Schnappkiefermuskelmägen von Salzwasserschnappkiefern‡바닷물 무쇠턱거북으로부터 무쇠턱 모래주머니를 8개 모아야 합니다.‡Reúne 8 mollejas de quijaforte de quijafortes marinos.‡Reúne 8 mollejas de quijaforte de quijafortes marinos.‡Collectez 8 Gésiers de gueule d’acier sur des Gueules d’acier des mers.‡从海水钳嘴龟身上取得8副钳嘴龟胃囊。‡從海水鉗嘴龜身上收集8份鉗嘴龜胃囊。',
  }
},
[26486] = {
  {
    '100 garrafas de bebida na praia‡Игра в бутылочку‡99 Flaschen Wein am Strand‡해변에 있는 99개의 술병‡Al que no le guste el vino es un animal‡Al que no le guste el vino es un animal‡99 bouteilles de gnôle sur la plage‡海滩上有99瓶酒‡海邊的九十九瓶酒',
    nil,
    'Recolha 12 garrafas de Xerez de Pupellyverbos.‡Соберите 12 бутылок портвейна "Пупелливербос".‡Sammelt 12 Flaschen mit Pupellyverbos\' Portwein.‡퍼플리버보스 포트 포도주 12병을 모아야 합니다.‡Reúne 12 botellas de oporto Pupellyverbos.‡Reúne 12 botellas de oporto Pupellyverbos.‡Ramassez 12 bouteilles de Porto Pupellyverbos.‡收集12瓶紫葡萄酒。‡收集12瓶紫葡萄酒。',
  }
},
[26487] = {
  {
    'Akiris aos montes‡Вязанка акириса‡Bündelweise Akiris‡아키리스 묶음‡Tallos de juncos akiris‡Tallos de juncos akiris‡De derrière les fagots‡海蛇草论捆卖‡一捆海蛇草',
    nil,
    'Obtenha 6 Juncos de Akiris das Exploradoras Nagas.‡Отберите 6 стеблей акириса у наг-исследователей.‡Beschafft 6 Bündel Akirisschilfrohr von den Forschern der Naga.‡나가 탐험가로부터 아키리스 갈대 6개를 획득해야 합니다.‡Obtén 6 juncos akiris de los expedicionarios naga.‡Obtén 6 juncos akiris de los expedicionarios naga.‡Prenez 6 Roseaux akiris aux Explorateurs nagas.‡从纳迦探险者身上获得6捆海蛇草。‡從納迦探險者那裡取得6份海蛇草。',
  }
},
[26488] = {
  {
    'Olho grande‡Большой глоток‡Ein großer Schluck‡꿀꺽‡Un mal trago‡Un mal trago‡Une grande goulée‡大胃口‡大口吞',
    nil,
    'Fisgue um Tamboril-real no fosso do distrito do Vale dos Heróis, em Ventobravo. Em seguida, abra o peixe e veja se ele engoliu o medalhão.‡Выловите царского морского ангела изо рва на Аллее Героев в Штормграде. Поймав рыбу, выпотрошите ее и поищите внутри медальон.‡Fischt einen königlichen Seeteufel aus dem Burggraben im Tal der Helden in Sturmwind. Wenn Ihr einen Seeteufel angelt, filetiert ihn und seht nach, ob er das Medaillon verschluckt hat.‡스톰윈드에 있는 영웅의 계곡에서 왕족 큰얼룩통구멍을 낚아야 합니다. 왕족 큰얼룩통구멍을 낚으면, 요리해서 소중한 펜던트를 삼켰는지 확인해봐야 합니다.‡Pesca rapes reales del foso en el distrito del Valle de los Héroes de Ventormenta. Cuando cojas un rape, ábrelo y mira si se ha tragado el guardapelo.‡Pesca rapes reales del foso en el distrito del Valle de los Héroes de Ventormenta. Cuando cojas un rape, ábrelo y mira si se ha tragado el guardapelo.‡Pêchez une Lotte royale dans les douves de la Vallée des Héros, à Hurlevent. Quand vous l\'aurez attrapée, videz-la et vérifiez si elle n\'aurait pas avalé le médaillon.‡从暴风城英雄谷的护城河里钓起一条皇家扁鲨。当你捉住扁鲨后，就剖开鱼腹看看盒坠在不在它的肚子里。‡從英雄谷的護城河釣起皇家扁鯊。釣到扁鯊之後，剖開看看有沒有墜盒。',
  }
},
[26489] = {
  {
    'É você!!‡Ты!‡Ihr hier?!‡당신이군요!‡¡Eres tú!‡¡Eres tú!‡Retrouvailles‡是你！！‡就是你!!',
    nil,
    'Obtenha 6 Juncos de Akiris das Exploradoras Nagas.‡Добудьте 6 стеблей акириса у наг-исследователей.‡Beschafft 6 Bündel Akirisschilfrohr von den Forschern der Naga.‡나가 탐험가로부터 아키리스 갈대 6개를 모아야 합니다.‡Obtén 6 juncos akiris de los expedicionarios naga.‡Obtén 6 juncos akiris de los expedicionarios naga.‡Prenez 6 Roseaux akiris aux Explorateurs nagas.‡从纳迦探险者身上获得6捆海蛇草。‡從納迦探險者那裡取得6份海蛇草。',
  }
},
[26490] = {
  {
    'Visgo de primeira‡Жуть-муть‡Erstklassiger Schleim‡태고의 수액괴물‡Babosa primigenia‡Babosa primigenia‡Le limon-mère‡泥浆怪之母‡頭號軟泥怪',
    nil,
    'Recolha uma Amostra de Gosma Horrenda.‡Заберите кусочек вязкой мути у Вязкой Мути.‡Beschafft eine Terrorklumpenprobe vom Terrorklumpen.‡소름덩어리로부터 소름덩어리 견본을 모아야 합니다.‡Recoge una muestra de Pegoterror.‡Recoge una muestra de Pegoterror.‡Prélevez un Échantillon du Vaseux sur le Vaseux.‡从一只恐泥怪身上获得恐泥怪样本。‡從厄滴身上取得厄滴樣本。',
  }
},
[26491] = {
  {
    'Limpeza na Rocha Oculta‡Большая уборка на Осклизлой скале‡Den Lauerfels aufräumen‡굼벵이 바위굴 청소‡La limpieza de Roca Oculta‡La limpieza de Roca Oculta‡Nettoyer le rocher de l\'Affût‡隐匿石大扫除‡清理隱匿石',
    nil,
    'Mate 10 Gosmas Jade.‡Убейте 10 нефритовых слизнюков.‡Tötet 10 jadegrüne Schlamme.‡비취 수액괴물 10마리를 처치해야 합니다.‡Mata a 10 mocos de jade.‡Mata a 10 mocos de jade.‡Tuez 10 Limons de jade.‡杀掉10只玉石软泥怪。‡殺死10隻玉石軟泥怪。',
  }
},
[26492] = {
  {
    'Os suprimentos da Rocha Oculta‡Припасы с Осклизлой скалы‡Lauerfelsvorräte‡굼벵이 바위굴의 보급품‡Suministros de Roca Oculta‡Suministros de Roca Oculta‡Le reliquat du rocher de l\'Affût‡隐匿石补给‡隱匿石補給',
    nil,
    'Recolha 5 Caixas de Suprimentos Cobertas de Gosma.‡Соберите 5 покрытых слизью ящиков с припасами.‡Sammelt 5 schlammbedeckte Vorratskisten ein.‡수액으로 뒤덮인 보급품 상자 5개를 모아야 합니다.‡Reúne 5 cajones de suministros cubiertos de moco.‡Reúne 5 cajones de suministros cubiertos de moco.‡Récupérez 5 Caisses de ravitaillement couvertes de vase.‡收集5个污泥覆盖的补给箱。‡收集5個覆滿軟泥的補給箱。',
  }
},
[26493] = {
  {
    'Alguém lá fora quer isso‡Есть желающие!‡Jemand dort draußen will es haben‡개똥도 약에 쓰인다‡Hay demanda en alguna parte‡Hay demanda en alguna parte‡La demande exige de l’offre‡外头有人要呢‡總有識貨人',
    nil,
    'Obtenha 7 porções do Ingrediente Secreto da Espoleta dos basiliscos Ferroqueixo e Batecauda que ficam na Mina Veia de Cristal.‡Добудьте 7 секретных ингредиентов Хамми у василисков-хвостохлестов и железозубых василисков в Хрустальной шахте.‡Beschafft 7 Einheiten von Sassys Geheimzutat von Donnerschwanz- und Eisenkieferbasilisken in der Kristalladermine.‡수정 광산에서 무쇠꼬리바실리스크와 무쇠턱바실리스크로부터 새시의 비밀 재료 7개를 모아야 합니다.‡Obtén 7 ingredientes secretos de Sassy de basiliscos Colastador y Quijahierro en la Mina de Cristal.‡Obtén 7 ingredientes secretos de Sassy de basiliscos Colastador y Quijahierro en la Mina de Cristal.‡Récupérez 7 Ingrédients secrets de Chipie sur des Basilics flagelleurs et gueule-de-fer, dans la Mine aux cristaux.‡从水晶矿洞的钢尾和铁腭蜥蜴身上获得7份莎希的秘密原料。‡從水晶礦坑裡的鋼尾蜥蜴和鐵顎蜥蜴那裡取得7份賽希的秘密材料。',
  }
},
[26494] = {
  {
    'M.C. Jasper‡Смешиватель Джаспер‡Mischmeister Jasper‡혼합대가 재스퍼‡Maestro mezclador Jasper‡Maestro mezclador Jasper‡Jasper le maître-mixeur‡混合大师加斯帕‡調合大師賈斯伯',
    nil,
    'Leve as Amostras da Espoleta para o M.C. Jasper no Esconderijo da Chaveforte.‡Отнесите образцы Хамми смешивателю Джасперу в Укрытие Кофельнагель.‡Bringt Sassys Proben zu Mischmeister Jasper in Hartzangs Versteck.‡하드렌치 은신처에 있는 혼합대가 재스퍼에게 새시의 견본품을 가져가야 합니다.‡Lleva las muestras de Sassy al maestro mezclador Jasper en el Escondrijo Malallave.‡Lleva las muestras de Sassy al maestro mezclador Jasper en el Escondrijo Malallave.‡Apportez les Échantillons de Chipie au Maître-mixeur Jasper, à la Planque de Serrelavis.‡把莎希的样本交给硬钳避世乐园的混合大师加斯帕。‡將賽希的樣本帶去硬心藏匿處給調合大師賈斯伯。',
  }
},
[26495] = {
  {
    'Chabal‡Шабал‡Chabal‡차발‡Chabal‡Chabal‡Mmmm, Chabal‡查巴尔‡查巴爾',
    nil,
    'Leve o Presente Generoso da Espoleta para o Chabal no Esconderijo da Chaveforte.‡Отнесите щедрый дар Хамми Шабалу в Укрытие Кофельнагель.‡Bringt Sassys großzügige Gabe zu Chabal in Hartzangs Versteck.‡하드렌치 은신처에 있는 차발에게 새시의 인사 선물을 전달해야 합니다.‡Lleva la generosidad de Sassy a Chabal en el Escondrijo Malallave.‡Lleva la generosidad de Sassy a Chabal en el Escondrijo Malallave.‡Apportez la Largesse de Chipie à Chabal, à la Planque de Serrelavis.‡将莎希的馈赠交给硬钳避世乐园的查巴尔。‡將賽希的慷慨贈物帶去硬心藏匿處給查巴爾。',
  }
},
[26496] = {
  {
    'Abaixo os Ramatorpe‡Сломай Порочную Ветвь‡Nieder mit den Blutfratzen‡썩은가지 부족 격퇴‡Abajo con los Vilrama‡Abajo con los Vilrama‡Faire du petit bois avec les Vilebranches‡邪枝的倒台‡擊倒邪枝',
    nil,
    'Encontre Doran Asadaço em Jintha\'Alor, que fica nas Terras Agrestes.‡Найдите Дорана Сталекрылого у Джинта\'Алора во Внутренних землях.‡Findet Doran Stahlschwing bei Jintha\'Alor im Hinterland.‡동부 내륙지의 진타알로에 있는 도란 스틸윙을 찾아야 합니다.‡Encuentra a Doran Alacerada en Jintha\'Alor en las Tierras del Interior.‡Encuentra a Doran Alacerada en Jintha\'Alor en las Tierras del Interior.‡Trouvez Doran Aile-d’acier à Jintha’Alor dans les Hinterlands.‡去找辛特兰辛萨罗的多兰·刚翼。‡到辛特蘭的辛薩羅尋找多蘭·鋼翼。',
  }
},
[26497] = {
  {
    'Escória Ramatorpe‡Гнилые плоды Порочной Ветви‡Blutfratzenabschaum‡썩은가지 부족 쓰레기들‡Basura Vilrama‡Basura Vilrama‡La racaille vilebranche‡邪枝渣滓‡邪枝敗類',
    nil,
    'Mate 5 Mandingueiros Ramatorpe e 5 Caçadores de Cabeças Ramatorpe em Jintha\'Alor.‡Убейте 5 знахарей и 5 охотников за головами из племени Порочной Ветви в Джинта\'Алоре.‡Tötet 5 Hexendoktoren der Blutfratzen und 5 Kopfjäger der Blutfratzen in Jintha\'Alor.‡진타알로에 있는 썩은가지 의술사 5명과 썩은가지 인간사냥꾼 5명을 처치해야 합니다.‡Mata a 5 médicos brujos Vilrama y a 5 rebanacabezas Vilrama en Jintha\'Alor.‡Mata a 5 médicos brujos Vilrama y a 5 rebanacabezas Vilrama en Jintha\'Alor.‡Tuez 5 Féticheurs et 5 Chasseurs de tête vilebranches à Jintha’Alor.‡在辛萨罗杀死5名邪枝巫医和5名邪枝猎头者。‡到辛薩羅殺死5個邪枝巫醫和5個邪枝獵頭者。',
  }
},
[26498] = {
  {
    'Morte aos Ramatorpe‡Смерть Порочной Ветви!‡Tod den Blutfratzen‡썩은가지 부족에게 죽음을‡Muerte a los Vilrama‡Muerte a los Vilrama‡Mort aux Vilebranches‡邪枝之死‡邪枝食人妖的死期',
    nil,
    'Mate 5 Berserkers Ramatorpe e 5 Lança-sombras Ramatorpe em Jintha\'Alor.‡Убейте 5 берсерков и 5 темных чародеев из племени Порочной Ветви в Джинта\'Алоре.‡Tötet 5 Berserker der Blutfratzen und 5 Schattenzauberer der Blutfratzen in Jintha\'Alor.‡진타알로에 있는 썩은가지 광전사 5명과 썩은가지 흑마술사 5명을 처치해야 합니다.‡Mata a 5 rabiosos Vilrama y a 5 taumaturgos Vilrama en Jintha\'Alor.‡Mata a 5 rabiosos Vilrama y a 5 taumaturgos Vilrama en Jintha\'Alor.‡Tuez 5 Berserkers et 5 Exhalombres vilebranches à Jintha’Alor.‡在辛萨罗杀死5名邪枝狂战士和5名邪枝暗影法师。‡在辛薩羅殺死5個邪枝狂戰士和5個邪枝暗影施法者。',
  }
},
[26499] = {
  {
    'Bênção do Petrarca‡Дар Отца-Скалы‡Der Segen des Steinvaters‡바위 아버지의 은혜‡El favor del Padre Pétreo‡El favor del Padre Pétreo‡La bénédiction du Père-Roc‡石父的旗帜‡國王的榮光',
    nil,
    'Conceda a Bênção do Petrarca a 12 Defensores do Larpétreo.‡Передайте слова Отца-Скалы 12 земельникам-защитникам.‡Gewährt 12 Irdenen Verteidigern den Segen des Steinvaters‡바위 아버지의 은혜를 토석인 수호병 12명에게 불어넣어야 합니다.‡Otorga el favor del Padre Pétreo a 12 defensores terráneos.‡Otorga el favor del Padre Pétreo a 12 defensores terráneos.‡Accordez la Bénédiction du Père-Roc à 12 Défenseurs terrestres.‡将石父的旗帜赐予12名土灵防御者。‡將土靈之王的恩惠傳達給12名土靈防衛者。',
  }
},
[26500] = {
  {
    'Do que é feito um trogg‡Мы окружены‡Wir sind umzingelt‡둘러싸이다‡Estamos rodeados‡Estamos rodeados‡Nous sommes cernés‡我们被包围了‡我們被包圍了',
    nil,
    'Mate 12 Troggs de Pedra Emboscadores.‡Убейте 12 каменных троггов – душителей.‡Tötet 12 Wegelagerer der Steintroggs.‡바위 트로그 복병 12마리를 처치해야 합니다.‡Asesina a 12 emboscadores troggs de piedra.‡Asesina a 12 emboscadores troggs de piedra.‡Tuez 12 Troggs de pierre embusqués.‡消灭12名石头穴居人伏击者。‡殺死12名岩石穴居怪伏擊者。',
  }
},
[26501] = {
  {
    'Passando o trinco‡Закрыть все выходы‡Versiegelung des Eingangs‡통로 봉인‡Sellando el camino‡Sellando el camino‡La chute des troggs de pierre‡封锁道路‡封鎖道路',
    nil,
    'Ajude os Geomantes Terranos a sair de combate e entregue-lhes os Reagentes de Avalanche para que eles possam lacrar o Arsenal, a Estalagem, a Guarnição Militar e o Templo.‡Помогите земельникам-геомантам прекратить битву и дайте им оползневые реагенты, чтобы они смогли заблокировать выходы из оружейной, таверны, казарм и святилища.‡Helft den Irdenen Geomanten, sich aus dem Kampfgeschehen auszuklinken und gebt ihnen dann die Felssturzreagenzien, damit sie das Rüstlager, das Gasthaus, die Baracken und den Schrein versiegeln können.‡토석인 풍수사가 전투에서 빠져나오도록 도운 다음, 낙석 시약을 주어 무기고, 여관, 병영, 사원을 봉인해야 합니다.‡Ayuda a los geománticos terráneos a abandonar el combate y después entrégales los componentes de desprendimiento para que puedan sellar la armería, la posada, el cuartel y el santuario.‡Ayuda a los geománticos terráneos a abandonar el combate y después entrégales los componentes de desprendimiento para que puedan sellar la armería, la posada, el cuartel y el santuario.‡Aidez les Géomanciens terrestres à sortir du combat, puis donnez-leur les Composants pour éboulement afin qu’ils puissent sceller l’entrée de l\'Armurerie, de l\'Auberge, de la Caserne et du Sanctuaire.‡帮助土灵地卜师摆脱战斗，将崩岩试剂交给他们以封锁军械库、旅店、兵营和神龛。‡幫助土靈地卜師脫離戰鬥，然後將崩岩試劑交給他們，讓他們得以封鎖軍械庫、旅店、兵營和神殿。',
  }
},
[26502] = {
  {
    'Pedras do trovão‡Громокамни‡Donnersteine‡천둥석‡Piedras de trueno‡Piedras de trueno‡Pierres de tonnerre‡雷霆之石‡霹靂石',
    nil,
    'Colete 12 Pedras do Trovão.‡Соберите 12 громокамней.‡Besorgt 12 Donnersteine.‡천둥석 12개를 수집해야 합니다.‡Reúne 12 piedras de trueno.‡Reúne 12 piedras de trueno.‡Récupérez 12 Pierres de tonnerre.‡收集12块雷霆之石。‡收集12顆霹靂石。',
  }
},
[26503] = {
  {
    'Ainda avaliando a ameaça‡Оценка угрозы‡Weitere Einschätzung der Gefahr‡위협에 대처하는 자세‡Evaluando la amenaza todavía‡Evaluando la amenaza todavía‡Une autre appréciation du danger‡继续评估威胁‡還在審時度勢',
    nil,
    'Roube o Plano de Batalha Gnoll, as Ordens Gnoll e o Guia Estratégico Gnoll.‡Украдите военные планы гноллов, приказы гноллов и стратегическое руководство гноллов.‡Stehlt die Schlachtpläne der Gnolle, die Befehle der Gnolle und den Strategieführer der Gnolle.‡놀 전투 계획서, 놀 명령서, 놀 전략 지침서를 훔쳐야 합니다.‡Roba los planes de batalla gnoll, las órdenes gnoll y la guía de estrategia gnoll.‡Roba los planes de batalla gnoll, las órdenes gnoll y la guía de estrategia gnoll.‡Volez les Plans de bataille gnolls, les Ordres gnolls et le Guide de stratégie gnolle.‡偷取豺狼人作战计划、豺狼人的命令以及豺狼人战略指南。‡偷取豺狼人作戰計畫、豺狼人命令以及豺狼人戰略指南。',
  }
},
[26504] = {
  {
    'Procuram-se: Gnolls de Cristarrubra‡Разыскиваются: гноллы Красногорья‡Gesucht: Rotkammgnolle‡현상 수배: 붉은마루 놀‡Se busca: Gnolls Crestagrana‡SE BUSCA: Gnolls Crestagrana‡On recherche : les gnolls des Carmines‡通缉：赤脊山豺狼人‡懸賞：赤脊山豺狼人',
    nil,
    'Mate 15 Gnolls de Cristarruba na região de Três Caminhos, que fica nas Montanhas Cristarrubra.‡Убейте 15 любых гноллов Красногорья на Трех Углах в Красногорье.‡Tötet 15 beliebige Rotkammgnolle in der Drei Ecken genannten Gegend des Rotkammgebirges.‡붉은마루 산맥의 붉은마루 삼거리에서 붉은마루 놀 15마리를 처치해야 합니다.‡Mata a 15 gnolls Crestagrana de cualquier tipo en la región de los Tres Caminos en Montañas Crestagrana.‡Mata a 15 gnolls Crestagrana de cualquier tipo en la región de los Tres Caminos en Montañas Crestagrana.‡Tuez 15 Gnolls des Carmines dans la région des Trois chemins, dans les Carmines.‡在赤脊山的三角路口地区杀掉15名赤脊山豺狼人。‡在赤脊山的三角路口區域裡殺死任意15個赤脊豺狼人。',
  }
},
[26505] = {
  {
    'O relatório de Florestan‡Донесение Паркера‡Parkers Bericht‡파커의 보고서‡El informe de Parker‡El informe de Parker‡Le rapport de Parker‡帕克的报告‡派克的報告',
    nil,
    'Entregue o Relatório de Florestan ao Magistrado Salomão em Vila Plácida, que fica em Cristarrubra.‡Отправляйтесь в Красногорье и отдайте донесение Паркера мировому судье Соломону в Приозерье.‡Bringt Parkers Bericht zu Magistrat Solomon nach Seenhain im Rotkammgebirge.‡붉은마루 산맥의 호숫골에 있는 집정관 솔로몬에게 파커의 보고서를 전달해야 합니다.‡Entrega el informe de Parker al magistrado Solomon en Villa del Lago en Crestagrana.‡Entrega el informe de Parker al magistrado Solomon en Villa del Lago en Crestagrana.‡Apportez le Rapport de Parker au Magistrat Salomon à Comté-du-Lac, dans les Carmines.‡将帕克的报告交给赤脊山湖畔镇的所罗门镇长。‡到赤脊山的湖畔鎮將派克的報告送給所羅門鎮長。',
  }
},
[26506] = {
  {
    'Salsichão com nozes‡Мясное рагу‡Würstchen mit Bohnen‡소시지와 콩 요리‡La fabada‡La fabada‡La recette du cassoulet‡茄汁黄豆‡法蘭克斯煨豆',
    nil,
    'Colete 4 Olhos de Tarântula, 4 Miúdos de Condor e 4 Rins de Goretusco.‡Соберите 4 глаза тарантула, потроха 4 кондоров и 4 почки кровоклыка.‡Besorgt 4 Tarantelaugen, 4 Kondorinnereien und 4 Greiferzahnnieren.‡타란툴라 눈 4개, 대머리수리 내장 4개, 뿔엄니멧돼지 콩팥 4개를 수집해야 합니다.‡Reúne 4 ojos de tarántula, 4 menudillos de cóndor y 4 riñones de dentosangre.‡Reúne 4 ojos de tarántula, 4 menudillos de cóndor y 4 riñones de dentosangre.‡Récupérez 4 Yeux de tarentule, 4 Entrailles de condor et 4 Foies de broche-tripes.‡收集4颗狼蛛眼球、4副秃鹰的内脏和4副血牙野猪的肾脏。‡收集4個狼蛛的眼睛、4個兀鷹的內臟以及4個野豬的腎臟。',
  }
},
[26507] = {
  {
    'Aceita um quebra-queixo?‡Окаменевшие лакомства‡Versteinerte Delikatessen‡돌로 만든 별미‡Manjares petrificados‡Manjares petrificados‡Des gourmandises pétrifiées‡僵硬的美餐‡石化美味',
    nil,
    'Pegue 12 Morcegos de Pedra Petrificados para o Cascalho.‡Соберите 12 окаменевших летучих мышей для Камешка.‡Besorgt 12 erstarrte Steinfledermäuse für Kieselchen.‡돌돌이를 위해 석화된 바위박쥐 12마리를 수집해야 합니다.‡Reúne 12 murciélagos de piedra petrificados para Guijarro.‡Reúne 12 murciélagos de piedra petrificados para Guijarro.‡Récupérez 12 Chauves-souris pétrifiées pour Gravillon.‡为佩波收集12只石化蝙蝠。‡為小石岩收集12隻石化的石蝙蝠。',
  }
},
[26508] = {
  {
    'Colar da Nida‡Ожерелье Ниды‡Nidas Halskette‡니다의 목걸이‡El collar de Nida‡El collar de Nida‡Le collier de Nida‡尼达的项链‡尼達的項鍊',
    nil,
    'Encontre o Colar da Nida.‡Найдите ожерелье Ниды.‡Findet Nidas Halskette.‡니다의 목걸이를 찾아야 합니다.‡Encuentra el collar de Nida.‡Encuentra el collar de Nida.‡Retrouvez le collier de Nida.‡找到尼达的项链。‡找到尼達的項鍊。',
  }
},
[26509] = {
  {
    'O penetra‡Незваный гость‡Ein ungebetener Gast‡불청객‡Una visita poco grata‡Una visita poco grata‡Un invité indésirable‡不速之客‡一位不速之客',
    nil,
    'Mate Ronquifuça e pegue a Presa de Ronquifuça.‡Убейте Грубобрюха и вырвите у него клык.‡Tötet Stopfwanst und nehmt Stopfwansts Hauer an Euch.‡서리먹보를 처치하고 서리먹보의 엄니를 입수해야 합니다.‡Mata a Panzallena y consigue el colmillo de Panzallena.‡Mata a Panzallena y consigue el colmillo de Panzallena.‡Tuez Fouailleventre et prenez la Défense de Fouailleventre.‡杀死贝利格拉布，并带回它的獠牙作为证明。‡殺死貝利格拉布並取得貝利格拉布的獠牙。',
  }
},
[26510] = {
  {
    'Devemos nos preparar!‡Нужно готовиться!‡Wir müssen uns vorbereiten!‡준비 완료!‡¡Tenemos que prepararnos!‡¡Tenemos que prepararnos!‡Nous devons être prêts !‡必须准备万全！‡做好萬全準備!',
    nil,
    'Recupere o Gnomofone.‡Отыщите ГНМ-передатчик.‡Findet den Gnomcorder.‡노움특제전송기를 되찾아야 합니다.‡Recupera la gnomograbadora.‡Recupera la gnomograbadora.‡Récupérez le Gnomotophone.‡找回侏儒通讯器。‡取回地精自動紀錄器。',
  }
},
[26511] = {
  {
    'Limpando o Lago Plácido‡Зачистка озера Безмолвия‡Säuberung des Immerruhsees‡영원고요 호수 청소‡Limpieza del Lago Sempiterno‡Limpieza del Lago Sempiterno‡Place nette au lac Placide‡打扫止水湖‡肅清止水湖',
    nil,
    'Mate 10 murlocs no Lago Plácido.‡Убейте 10 мурлоков на озере Безмолвия.‡Tötet 10 beliebige Murlocs im Immerruhsee.‡영원고요 호수에서 멀록 10마리를 처치해야 합니다.‡Mata 10 múrlocs de cualquier tipo en el Lago Sempiterno.‡Mata 10 múrlocs de cualquier tipo en el Lago Sempiterno.‡Tuez 10 Murlocs au Lac Placide.‡杀掉止水湖的任意10名鱼人。‡在止水湖殺死任意10隻魚人。',
  }
},
[26512] = {
  {
    'Sintonizando o gnomofone‡Настройка ГНМ-передатчика‡Einstellung des Gnomcorders‡노움특제전송기 조정‡Sintonizando la gnomograbadora‡Sintonizando la gnomograbadora‡Régler le gnomotophone‡调试侏儒通讯器‡調整地精自動紀錄器',
    nil,
    'Vá até o cemitério de Vila Plácida para sintonizar o Gnomofone.‡Отправляйтесь на Приозерское кладбище, чтобы начать настройку ГНМ-передатчика.‡Geht zum Friedhof von Seenhain, um die Frequenz des Gnomcorders einzustellen.‡호숫골 무덤으로 가서 노움특제전송기를 조정해야 합니다.‡Ve al Cementerio de Villa del Lago para sintonizar la gnomograbadora.‡Ve al Cementerio de Villa del Lago para sintonizar la gnomograbadora.‡Allez au Cimetière de Comté-du-Lac pour régler le Gnomotophone.‡前往湖畔镇墓地来调试侏儒通讯器的信号接收。‡前往湖畔鎮墓地調整地精自動紀錄器。',
  }
},
[26513] = {
  {
    'Feito pum no vento‡Как ветром сдуло‡Wie ein Furz im Wind‡바람 속 방귀처럼‡Como un pedo en el aire‡Como un pedo en el aire‡Ni vus, ni connus‡无影无踪‡風中一陣屁，來得快去得快',
    nil,
    'Recupere 8 Caixotes de Suprimentos de Cristarrubra.‡Верните 8 ящиков с припасами Красногорья.‡Bergt 8 Vorratskisten des Rotkammgebirges.‡붉은마루 보급품 상자 8개를 회수해야 합니다.‡Recupera 8 cajones de suministros Crestagrana.‡Recupera 8 cajones de suministros Crestagrana.‡Récupérez 8 Caisses de fournitures des Carmines.‡收集8个赤脊山补给箱。‡取回8個赤脊山補給箱。',
  }
},
[26514] = {
  {
    'Matador na garganta‡Зачистка каньона‡Schluchtenspringen‡협곡 탐색‡Diversión en los cañones‡Diversión en los cañones‡Le grand canyon‡峡谷嬉戏‡峽谷快樂行',
    nil,
    'Colete 10 Coleiras de Gnoll de Cristarrubra.‡Соберите 10 ошейников гноллов Красногорья.‡Sammelt 10 Halsbänder der Rotkammgnolle.‡붉은마루산맥 놀 목줄 10개를 수집해야 합니다.‡Reúne 10 collares de gnoll Crestagrana.‡Reúne 10 collares de gnoll Crestagrana.‡Récupérez 10 Colliers de gnoll des Carmines.‡收集10副赤脊山豺狼人项圈。‡收集10條赤脊山豺狼人項圈。',
  }
},
[26515] = {
  {
    'A vingança de Ongo\'longo‡Месть Онго\'лонго‡Ongo\'longos Rache‡옹고롱고의 복수‡La venganza de Ongo\'longo‡La venganza de Ongo\'longo‡La revanche d\'Ongo\'longo‡昂格隆格的复仇‡翁戈隆戈的復仇',
    nil,
    'Lute com Ongo\'longo até que ele se liberte.‡Деритесь с Онго\'лонго, пока он не освободится.‡Kämpft gegen Ongo\'longo, bis er seine Ketten sprengt.‡옹고롱고가 속박을 풀 때까지 공격해야 합니다.‡Enfréntate a Ongo\'longo hasta que se libere.‡Enfréntate a Ongo\'longo hasta que se libere.‡Combattez Ongo’longo jusqu’à ce qu’il se libère de ses chaînes.‡和昂格隆格交手，直到他挣脱束缚。‡和翁戈隆戈打鬥直到他掙脫。',
  }
},
[26516] = {
  {
    'É nossa agora‡Победа наша!‡Das gehört jetzt uns‡이제 우리의 것‡Ahora es nuestra‡Ahora es nuestra‡À nous Jintha\'Alor !‡现在它是我们的了‡現在是我們的了',
    nil,
    'Mate 5 Bebe-sangue Ramatorpe e 5 Devoradores de Almas Ramatorpe em Jintha\'Alor.‡Убейте 5 кровопийц и 5 пожирателей душ из племени Порочной Ветви в Джинта\'Алоре.‡Tötet 5 Bluttrinker der Blutfratzen und 5 Seelenfresser der Blutfratzen in Jintha\'Alor.‡진타알로에 있는 썩은가지 혈투사와 썩은가지 영혼사냥꾼을 각각 5명씩 처치해야 합니다.‡Mata a 5 bebesangre Vilrama y a 5 comealmas Vilrama en Jintha\'Alor.‡Mata a 5 bebesangre Vilrama y a 5 comealmas Vilrama en Jintha\'Alor.‡Tuez 5 Mangeurs d’âme et 5 Sanguinaires vilebranches à Jintha’Alor.‡在辛萨罗杀死5名邪枝饮血者和5名邪枝噬魂者。‡在辛薩羅殺死5個邪枝飲血者與5個邪枝噬魂者。',
  }
},
[26517] = {
  {
    'O cúmulo do destino‡Судьбоносная вершина‡Schicksalsgipfel‡운명의 꼭대기‡Cima del destino‡Cima del destino‡Le sommet du destin‡命运之巅‡命運之巔',
    nil,
    'Recolha 8 Ídolos da Aranha dos Ramatorpe no cume de Jintha\'Alor.‡Соберите 8 идолов-пауков, убивая троллей племени Порочной Ветви на вершине Джинта\'Алора.‡Sammelt 8 Spinnengötzen der Blutfratzen auf dem Gipfel von Jintha\'Alor.‡진타알로의 정상에 있는 썩은가지 부족에게서 거미 우상 8개를 모아야 합니다.‡Reúne 8 ídolos arácnidos de los Vilrama en la cima de Jintha\'Alor.‡Reúne 8 ídolos arácnidos de los Vilrama en la cima de Jintha\'Alor.‡Collectez 8 Idoles d’araignée sur les Vilebranches au sommet de Jintha’Alor.‡从辛萨罗山顶的邪枝手里取得8尊蜘蛛神像。‡從辛薩羅頂端的邪枝那裡收集8個蜘蛛塑像。',
  }
},
[26518] = {
  {
    'Fique alerta‡Все дело в голове‡Kopfprämie‡가면 만들기‡De cabeza‡De cabeza‡Têtes en l\'air‡枯竭的魔精‡抬頭',
    nil,
    'Derrote Umboda Três-cabeças e recolha a cabeça dele.‡Убейте Умбоду Три Башки и заберите его голову.‡Besiegt Umboda Dreikopf und holt Euch seinen Kopf.‡세 얼굴의 움보다를 처치하고 그의 머리카락을 획득해야 합니다.‡Derrota a Umboda Tres Cabezas y consigue su cabeza.‡Derrota a Umboda Tres Cabezas y consigue su cabeza.‡Tuez Umboda Trois-têtes et prenez la sienne.‡打败“三头怪”昂波达，拿到他的魔精。‡擊敗食人妖昂波達·三首並取得他的頭顱。',
  }
},
[26519] = {
  {
    'Quem controla os gorjalas‡Тот, кто командует эттинами‡Wer die Ettins beherrscht‡거인을 조종하는 자‡Aquel que controla a los ettins‡Aquel que controla a los ettins‡Celui qui contrôle les ettins‡只要控制了双头魔‡控制雙頭巨人的傢伙',
    nil,
    'Mate Ardo Patassuja.‡Убейте Ардо Грязнолапа.‡Tötet Ardo Schmutzpranke.‡진창발 아르도를 처치해야 합니다.‡Mata a Ardo Patasoez.‡Mata a Ardo Patasoez.‡Tuez Ardo Crassepatte.‡杀死阿尔多·泥爪。‡殺死阿爾多·泥爪。',
  }
},
[26520] = {
  {
    'Salvando o encarregado Oslow‡Спасение штейгера Ослоу‡Rettet Großknecht Oslow‡현장감독 오슬로 구하기‡Salvar al Supervisor Olento‡Salvar al Supervisor Olento‡Il faut sauver le contremaître Oslow‡拯救工头奥斯洛‡拯救工頭奧斯洛',
    nil,
    'Use o Orbe de Controle de Gorjala para controlar um Gorjala. Então, use o Orbe de Controle de Gorjala no seu Gorjala Subjugado do Desfiladeiro para levantar o Rochedo do Encarregado Oslow em Vila Plácida.‡Подчините себе каньонного эттина при помощи сферы контроля эттина, а потом заставьте его убрать огромный булыжник со штейгера Ослоу в Приозерье.‡Benutzt die Ettinsteuerungskugel, um einen Ettin zu unterwerfen. Setzt die Ettinsteuerungskugel dann bei Eurem gebändigten Schluchtettin ein und bringt ihn dazu, Großknecht Oslow in Seenhain von dem riesigen Felsbrocken zu befreien.‡거인 조종 구슬을 사용하여 거인을 조종해야 합니다. 그 후에 고분고분해진 협곡거인에게 거인 조종 구슬을 사용하여, 호숫골에서 현장감독 오슬로를 누르고 있는 거대한 호박돌을 치워야 합니다.‡Usa el orbe de control de ettin para controlar a un ettin y después usa el orbe de control de ettin con tu ettin de cañón subyugado para que levante el pedrusco gigante que aplasta al Supervisor Olento en Villa del Lago.‡Usa el orbe de control de ettin para controlar a un ettin y después usa el orbe de control de ettin con tu ettin de cañón subyugado para que levante el pedrusco gigante que aplasta al Supervisor Olento en Villa del Lago.‡Utilisez l’Orbe de contrôle d’ettin pour contrôler un Ettin, puis utilisez l’Orbe de contrôle d’ettin sur votre Ettin du canyon assujetti pour déplacer l’Énorme rocher qui écrase le Contremaître Oslow, à Comté-du-Lac.‡使用双头魔控制宝珠控制一名双头魔，用双头魔控制宝珠让被降服的峡谷双头魔举起湖畔镇困住工头奥斯洛的巨石。‡對雙頭巨人使用雙頭巨人控制寶珠，然後命令他到湖畔鎮，命令他舉起壓在工頭奧斯洛身上的巨礫。',
  }
},
[26521] = {
  {
    'As faces do mal‡Лики зла‡Gesichter des Bösen‡악마의 얼굴‡Las caras del mal‡Las caras del mal‡Les masques du mal‡邪恶的面貌‡邪惡之臉',
    nil,
    'Use a Tocha Tiki para botar fogo em 8 Carrancas em Jintha\'Alor.‡Используйте факел тики, чтобы поджечь 8 ритуальных масок тики в Джинта\'Алоре.‡Zündet mit der Tikifackel 8 Tikimasken in Jintha\'Alor an.‡티키 횃불을 사용해 진타알로에 있는 티키 가면 8개에 불을 붙여야 합니다.‡Usa la antorcha Tiki para prender fuego a 8 máscaras Tiki en Jintha\'Alor.‡Usa la antorcha Tiki para prender fuego a 8 máscaras Tiki en Jintha\'Alor.‡Utilisez la Torche à tiki pour bouter le feu à 8 Masques tiki à Jintha’Alor.‡在辛萨罗用蒂基之炬点燃8张蒂基面具。‡到辛薩羅使用提基火炬點燃8個提基面具。',
  }
},
[26522] = {
  {
    '‡Лики зла‡Gesichter des Bösen‡악마의 얼굴‡Las caras del mal‡‡Les masques du mal‡邪恶的面貌‡',
    nil,
    '‡Используйте факел тики, чтобы поджечь 8 ритуальных масок тики в Джинта\'Алоре.‡Zündet mit der Tikifackel 8 Tikimasken in Jintha\'Alor an.‡티키 횃불을 사용해 진타알로에 있는 티키 가면 8개에 불을 붙여야 합니다.‡Usa la antorcha Tiki para prender fuego a 8 máscaras Tiki en Jintha\'Alor.‡‡Utilisez la Torche à tiki pour bouter le feu à 8 Masques tiki à Jintha\'Alor.‡在辛萨罗用蒂基之炬点燃8张蒂基面具。‡',
  }
},
[26523] = {
  {
    'Tudo que rasteja‡Быстролапые паучата‡Alles, was krabbelt‡기어 다니는 것들‡Todo lo que se desliza‡Todo lo que se desliza‡Tout ce qui grouille‡那些小东西们‡蜘蜘蛛蛛',
    nil,
    'Recolha 8 Aranitos Espocantes em Jintha\'Alor.‡Соберите 8 быстролапых паучков в Джинта\'Алоре.‡Sammelt 8 huschende Spinnlinge in Jintha\'Alor.‡진타알로에 있는 새끼 땅거미 8마리를 모아야 합니다.‡Reúne 8 arañitas deslizantes en Jintha\'Alor.‡Reúne 8 arañitas deslizantes en Jintha\'Alor.‡Collectez 8 Jeunes araignées grouillantes à Jintha’Alor.‡在辛萨罗抓8只迅捷小蜘蛛。‡在辛薩羅裡收集8隻粘絲小蜘蛛。',
  }
},
[26524] = {
  {
    'Caldeirões negros‡Темные сосуды‡Dunkle Gefäße‡어둠의 용기‡Vasijas oscuras‡Vasijas oscuras‡Les calices ténébreux‡黑暗容器‡黑暗之瓶',
    nil,
    'Recolha 5 Recipientes com Sangue Maculado em Jintha\'alor.‡Соберите 5 Сосудов с порченой кровью в Джинта\'Алоре.‡Besorgt 5 Gefäße mit besudeltem Blut aus Jintha\'Alor.‡진타알로에서 얼룩진 피가 담긴 용기 5개를 모아야 합니다.‡Reúne 5 vasijas de sangre corrupta en Jintha\'alor.‡Reúne 5 vasijas de sangre corrupta en Jintha\'alor.‡Récupérez 5 Calices de sang corrompu à Jintha’Alor.‡在辛萨罗收集5份腐化之血。‡到辛薩羅收集5瓶腐化之血。',
  }
},
[26525] = {
  {
    'Segredos peçonhentos‡Ядовитые секреты‡Giftige Geheimnisse‡치명적인 비밀‡Secretos venenosos‡Secretos venenosos‡Secrets venimeux‡剧毒的秘密‡惡毒的秘密',
    nil,
    'Mate 8 Crias de Shadra.‡Убейте 8 паучат Шадры.‡Tötet 8 Bruten von Shadra.‡샤드라혈족 거미를 6마리 처치해야 합니다.‡Mata a 8 engendros de Shadra.‡Mata a 8 engendros de Shadra.‡Tuez 8 Rejetons de Shadra.‡杀死8只沙德拉幼蛛。‡殺死8個幼生沙德拉。',
  }
},
[26526] = {
  {
    'Caça à guardiã‡Охота на хранительницу‡Jagt die Bewahrerin‡수호자 사냥‡Caza a la vigilante‡Caza a la vigilante‡Tuez la gardienne‡捕杀守护者‡獵殺守衛者',
    nil,
    'Mate Morta\'gya, a Guardiã, e pegue a Tabuleta de Shadra.‡Убейте Морта\'гью Хранительницу и заберите Табличку Шадры.‡Tötet Morta\'gya die Bewahrerin und bringt die Tafel von Shadra an Euch.‡수호자 몰타기아를 처치하고 샤드라의 서판을 획득해야 합니다.‡Mata a Morta\'gya la Vigilante y consigue la tablilla de Shadra.‡Mata a Morta\'gya la Vigilante y consigue la tablilla de Shadra.‡Tuez Morta’gya la Gardienne et obtenez la Tablette de Shadra.‡杀死守护者莫塔加亚，获得沙德拉石板。‡殺死「守衛者」莫塔加亞並取得沙德拉石板。',
  }
},
[26527] = {
  {
    'Mestre de grifos Garra-de-acha‡Укротитель грифонов Разящий Коготь‡Greifenmeister Krallenaxt‡그리핀 조련사 탈론액스‡Maestro de grifos Garracha‡Maestro de grifos Garracha‡Le maître des griffons Hachegriffe‡狮鹫驭手塔隆艾克斯‡獅鷲獸管理員沙拉克·鷹斧',
    nil,
    'Entregue a Tabuleta de Shadra ao Mestre de Grifos Garra-de-acha.‡Отнесите табличку Шадры укротителю грифонов Разящему Когтю.‡Bringt die Tafel von Shadra zu Greifenmeister Krallenaxt.‡그리핀 조련사 탈론액스에게 샤드라의 서판을 전달해야 합니다.‡Entrega la tablilla de Shadra al maestro de grifos Garracha.‡Entrega la tablilla de Shadra al maestro de grifos Garracha.‡Remettez la Tablette de Shadra au Maître des griffons Hachegriffe.‡将沙德拉石板交给狮鹫管理员塔隆艾克斯。‡將沙德拉石板交給獅鷲獸管理員沙拉克·鷹斧。',
  }
},
[26528] = {
  {
    'O olho de Shadra‡Глаз Шадры‡Das Auge von Shadra‡샤드라 눈‡El ojo de Shadra‡El ojo de Shadra‡L’œil de Shadra‡沙德拉之眼‡沙德拉之眼',
    nil,
    'Recupere o Olho de Shadra em Agol\'watha.‡Найдите в Агол\'вате глаз Шадры.‡Besorgt das Auge von Shadra aus Agol\'watha.‡아골와타에서 샤드라 눈을 회수해야 합니다.‡Coge el ojo de Shadra en Agol\'watha.‡Coge el ojo de Shadra en Agol\'watha.‡Retrouvez l’Œil de Shadra dans Agol’watha.‡在亚戈瓦萨找到沙德拉之眼。‡從亞戈瓦薩取回沙德拉之眼。',
  }
},
[26529] = {
  {
    'A Presa de Shadra‡Зуб Шадры‡Der Fangzahn von Shadra‡샤드라 송곳니‡El colmillo de Shadra‡El colmillo de Shadra‡Le croc de Shadra‡沙德拉之牙‡沙德拉之牙',
    nil,
    'Pegue a Presa de Shadra nas Ruínas Assustadoras.‡Найдите зуб Шадры в Ползучих руинах.‡Besorgt den Fangzahn von Shadra aus den Gruselruinen.‡굼벵이 폐허에서 샤드라 송곳니를 모아야 합니다.‡Coge el colmillo de Shadra de Las Ruinas Abyectas.‡Coge el colmillo de Shadra de Las Ruinas Abyectas.‡Récupérez le Croc de Shadra dans les Ruines aux Rampants.‡在爬虫废墟找到沙德拉之牙。‡從爬蟲廢墟取得沙德拉之牙。',
  }
},
[26530] = {
  {
    'A Carapaça de Shadra‡Панцирь Шадры‡Der Panzer von Shadra‡샤드라 껍질‡La concha de Shadra‡La concha de Shadra‡L\'exosquelette de Shadra‡沙德拉之壳‡沙德拉之殼',
    nil,
    'Mate Qiaga, a Tutora, e pegue a Carapaça de Shadra.‡Убейте Квиагу Хранительницу и заберите у нее панцирь Шадры.‡Tötet Qiaga die Bewahrerin und bringt den Panzer von Shadra an Euch.‡수호자 퀴아가를 처치하고 샤드라 껍질을 획득해야 합니다.‡Mata a Qiaga la Vigilante y consigue la concha de Shadra.‡Mata a Qiaga la Vigilante y consigue la concha de Shadra.‡Tuez Qiaga la Gardienne et récupérez l’Exosquelette de Shadra.‡杀死守护者奇尔加，获得沙德拉之壳。‡殺死「守衛者」奇爾嘉並取得沙德拉之殼。',
  }
},
[26531] = {
  {
    'Evocando Shadra‡Призыв Шадры‡Die Beschwörung von Shadra‡샤드라 소환‡Invocar a Shadra‡Invocar a Shadra‡L\'invocation de Shadra‡召唤沙德拉‡召喚沙德拉',
    nil,
    'Use o Ídolo de Shadra nos Templos Noroeste, Sudoeste e Leste em Shadra\'Alor.‡Используйте идол Шадры в северо-западном, юго-западном и восточном храмах в Шадра\'Алоре.‡Benutzt das Idol von Shadra am nordwestlichen, südwestlichen und östlichen Tempel in Shadra\'Alor.‡샤드라알로에 있는 북서쪽, 남서쪽, 동쪽 사원에 샤드라의 우상을 사용해야 합니다.‡Usa el ídolo de Shadra en los Templos Noroccidental, Suroccidental y Oriental en Shadra\'Alor.‡Usa el ídolo de Shadra en los Templos Noroccidental, Suroccidental y Oriental en Shadra\'Alor.‡Utilisez l’Idole de Shadra aux Temples nord-ouest, sud-ouest et est de Shadra’Alor.‡在沙德拉洛西北、西南，以及东部神殿里使用沙德拉塑像。‡在沙德拉洛西北、西南、東方的神廟使用沙德拉塑像。',
  }
},
[26532] = {
  {
    'Shadra, a Rainha Peçonhenta‡Шадра – королева пауков‡Shadra, Königin des Giftes‡맹독 여왕거미 샤드라‡Shadra, la Reina del Veneno‡Shadra, la Reina del Veneno‡Shadra la Reine venimeuse‡毒蜘蛛女王沙德拉‡劇毒之后沙德拉',
    nil,
    'Mate Shadra, a Rainha Peçonhenta.‡Убейте Шадру – королеву пауков.‡Tötet Shadra die Königin des Giftes.‡맹독 여왕거미 샤드라를 처치해야 합니다.‡Mata a Shadra, la Reina del Veneno.‡Mata a Shadra, la Reina del Veneno.‡Tuez Shadra la Reine venimeuse.‡杀死毒蜘蛛女王沙德拉。‡殺死劇毒之后沙德拉。',
  }
},
[26533] = {
  {
    'O segredo de Zanzil‡Тайна Занзила‡Zanzils Geheimnis‡잔질의 비법‡El secreto de Zanzil‡El secreto de Zanzil‡Le secret de Zanzil‡赞吉尔的秘密‡贊吉爾的秘密',
    nil,
    'Obtenha 5 ampolas do Preparado de Zanzil.‡Добудьте 5 сосудов со смесью Занзила.‡Beschafft 5 Phiolen von Zanzils Mixtur.‡잔질의 혼합물을 5병 모아야 합니다.‡Consigue 5 viales de la mezcla de Zanzil.‡Consigue 5 viales de la mezcla de Zanzil.‡Récupérez 5 fioles de Mixture de Zanzil.‡获取5瓶赞吉尔的药剂。‡取得5份贊吉爾的混合試劑。',
  }
},
[26534] = {
  {
    'Vamos ver qual é a sua, Zanzil‡Убойный напиток‡Was hast du zu bieten, Zanzil?‡네 실력을 한번 보자고, 잔질‡Veamos qué tienes, Zanzil‡Veamos qué tienes, Zanzil‡De ce que Zanzil avait dans la fiole‡让我瞧瞧你的本事，赞吉尔‡看看你有何本領，贊吉爾',
    nil,
    'Ofereça o Refresco Selvagem do Jasper para o Gmurgl, para o Orgus e para o Capitão Bartolomeu Barbalisa.‡Угостите "Джангл-айсом" Джаспера Гмургла, Оргуса и капитана Бартоломью Мягкоборода.‡Bietet Jaspers Dschungelschorle Gmurgl, Orgus und Kapitän Bartholomäus Weichbart an.‡재스퍼의 밀림 청량음료를 무르글, 오르구스, 선장 바톨로뮤 소프트비어드에게 먹여야 합니다.‡Ofrece el refrigerador de jungla de Jasper a Gmurgl, Orgus y al capitán Bartholomew Barbablanda.‡Ofrece el refrigerador de jungla de Jasper a Gmurgl, Orgus y al capitán Bartholomew Barbablanda.‡Offrez le Rafraîchissement de la jungle de Jasper à Gmurgl, Orgus et au capitaine Bartholomew Doucebarbe.‡把加斯帕的丛林冷饮给咕姆尔格、奥古斯和巴索罗姆·软须船长喝。‡將賈斯伯的叢林降溫劑交給葛穆格、奧古斯和巴索洛姆·軟鬍船長。',
  }
},
[26535] = {
  {
    'Receita de desastre‡Рецепт катастрофы‡Zutaten für eine Katastrophe‡재앙의 조제식‡Receta para el desastre‡Receta para el desastre‡La recette du malheur‡灾难的配方‡災難的配方',
    nil,
    'Obtenha a Formulação de Zanzil de um dos seguidores de Zanzil nas Ruínas de Aboraz.‡Добудьте рецептуру Занзила у одного из прислужников Занзила в руинах Абораза.‡Besorgt Zanzils Rezeptur von einem von Zanzils Anhängern in den Ruinen von Aboraz.‡아보라즈의 폐허에 있는 잔질의 추종자에게서 잔질의 조제식을 획득해야 합니다.‡Consigue la formulación de Zanzil de uno de los seguidores de Zanzil en las Ruinas de Aboraz.‡Consigue la formulación de Zanzil de uno de los seguidores de Zanzil en las Ruinas de Aboraz.‡Trouvez la Formule de Zanzil sur l’un de ses suivants, dans les Ruines d’Aboraz‡从阿博拉兹废墟赞吉尔的追随者手里获得赞吉尔的配方。‡從阿博拉茲廢墟的一名贊吉爾追隨者那裡取得贊吉爾的配方。',
  }
},
[26536] = {
  {
    'Cachoeira do Trovão‡Ревущий водопад‡Donnerfälle‡천둥 폭포‡Cataratas del Trueno‡Cataratas del Trueno‡Les chutes du Tonnerre‡雷霆瀑布‡雷霆瀑布',
    nil,
    'Pesque 4 Percas-violeta na Cachoeira do Trovão, ao sul de Ventobravo. Em seguida, entregue os peixes para Catarina Gurjão.‡Поймайте 4 лиловых окуней в Ревущем водопаде к югу от Штормграда. Возвращайтесь с уловом к Катрин Лиланд.‡Fangt 4 violette Flussbarsche bei den Donnerfällen südlich von Sturmwind. Kehrt mit Eurem Fang zu Catherine Leland zurück.‡스톰윈드 남쪽에 있는 천둥 폭포에서 보랏빛 민물농어 4마리를 잡은 다음, 캐서린 리랜드에게 가야 합니다.‡Coge 4 percas violeta de las Cataratas del Trueno, al sur de Ventormenta. Vuelve con Catherine Leland con tu captura una vez que hayas terminado.‡Coge 4 percas violeta de las Cataratas del Trueno, al sur de Ventormenta. Vuelve con Catherine Leland con tu captura una vez que hayas terminado.‡Attrapez 4 Perches pourpres aux Chutes du Tonnerre, au sud de Hurlevent. Retournez voir Catherine Leland avec vos prises quand vous aurez terminé.‡在暴风城南面的雷霆瀑布捕捉4条紫色鲈鱼，然后把它们交给凯瑟琳·利兰。‡在暴風城南部的雷霆瀑布那裏捕捉4尾紫羅蘭鱸魚。成功後，將獲物帶回去給凱薩琳·利蘭。',
  }
},
[26537] = {
  {
    'Moedor de pedra‡Убей их!‡Zerschmettert sie!‡먼지가 될 때까지!‡¡Hazlos pedazos!‡¡Hazlos pedazos!‡Fracassez-les !‡轰至渣！‡打碎他們!',
    nil,
    'Mate 12 troggs de pedra de qualquer tipo no Front Partido.‡Убейте 12 любых каменных троггов на Разбитой передовой.‡Tötet 12 beliebige Steintroggs an der Zerrissenen Front.‡무너진 전초지에서 종류 상관없이 바위 트로그 12마리를 처치해야 합니다.‡Asesina a 12 troggs de piedra cualesquiera en el Frente Fracturado.‡Asesina a 12 troggs de piedra cualesquiera en el Frente Fracturado.‡Tuez 12 Troggs sur le Front Ravagé.‡在碎裂前线消灭12只任意种类的石头穴居人。‡在崩裂的前線殺死12個岩石穴居怪。',
  }
},
[26538] = {
  {
    'S.O.S. emergência‡Предметы первой помощи‡Soforthilfe‡응급 처치‡Ayuda de emergencia‡Ayuda de emergencia‡Aide d\'urgence‡紧急援助‡緊急救援',
    nil,
    'Procure um Curandeiro no Porto Presa do Dragão, próximo à orla.‡Найдите лекаря на побережье в порту Драконьей Пасти.‡Sucht einen Medizinmann im Hafen des Drachenmals, nahe des Ufers.‡용아귀 항구 안, 바다와 가까운 어딘가에서 약사를 찾아야 합니다.‡Busca a un auxiliador en el Puerto Faucedraco, en algún lugar cerca de la orilla.‡Busca a un auxiliador en el Puerto Faucedraco, en algún lugar cerca de la orilla.‡Cherchez un Homme-médecine au Port Gueule-de-dragon, quelque part près de la côte.‡从岸边的龙喉哨站找名医师。‡到海岸附近的龍喉港找到一名咒醫。',
  }
},
[26539] = {
  {
    'Negociações estagnadas‡Затянувшиеся переговоры‡Festgefahrene Verhandlungen‡협상 지연‡Negociaciones detenidas‡Negociaciones detenidas‡Des négociations interrompues‡停摆的谈判‡談判膠著',
    nil,
    'Fale com Ornak no Porto Presa do Dragão. Horzog providenciará transporte rápido para o litoral.‡Поговорите с Орнаком в порту Драконьей Пасти. Хорзог может быстро доставить вас на побережье.‡Sprecht mit Ornak im Hafen des Drachenmals. Horzog wird für einen raschen Transport zum Ufer sorgen.‡용아귀 항구에 있는 오르낙과 대화해야 합니다. 호조그가 해변으로 빠르게 가는 탈것을 제공해 줄 것입니다.‡Habla con Ornak en el Puerto Faucedraco. Horzog puede proporcionarte un transporte rápido a la orilla.‡Habla con Ornak en el Puerto Faucedraco. Horzog puede proporcionarte un transporte rápido a la orilla.‡Allez voir Ornak au Port Gueule-de-dragon. Horzog peut vous emmener rapidement jusqu\'à la côte.‡同龙喉哨站的欧纳克交谈。霍尔佐格可以为你提供通往岸边的快速交通。‡到龍喉港找奧納克說話。荷索格可以提供你直達海岸的交通工具。',
  }
},
[26540] = {
  {
    'Compaixão perigosa‡Опасное сострадание‡Gefährliches Mitleid‡위험한 동정심‡Compasión peligrosa‡Compasión peligrosa‡Une dangereuse compassion‡危险的同情‡危險的同情',
    nil,
    'Leve o Caixote de Bandagens dos Presa do Dragão de volta para o Senhor da Guerra Krogg no Porto Presa do Dragão.‡Отнесите ящик бинтов Драконьей Пасти полководцу Кроггу, который находится в море рядом с портом Драконьей Пасти.‡Bringt die Kiste mit Bandagen des Drachenmals zurück zu Kriegsfürst Krogg auf See vor dem Hafen des Drachenmals.‡용아귀 항구 근해에 있는 장군 크로그에게 용아귀 붕대 상자를 가져가야 합니다.‡Llévale el cajón de vendas Faucedraco al señor de la guerra Krogg en la costa del Puerto Faucedraco.‡Llévale el cajón de vendas Faucedraco al señor de la guerra Krogg en la costa del Puerto Faucedraco.‡Apportez la Caisse de bandages gueule-de-dragon au Seigneur de guerre Krogg, au large du Port Gueule-de-dragon.‡将一箱龙喉绷带交给龙喉哨站海岸边的督军克罗格。‡將龍喉繃帶交給龍喉港外海的督軍克羅格。',
  }
},
[26542] = {
  {
    'O chamado ao heroísmo: Terras Agrestes!‡Воззвание к героям: Внутренние земли!‡Heldenaufruf: Das Hinterland!‡영웅의 부름: 동부 내륙지!‡Se busca héroe: ¡Tierras del Interior!‡Se busca héroe: ¡Tierras del Interior!‡L\'appel du héros : les Hinterlands !‡英雄的召唤：辛特兰！‡英雄的召喚:辛特蘭!',
    nil,
    'Vá ao Ninho da Águia nas Terras Agrestes e fale com o Mestre de Grifos Garra-de-acha.‡Отправляйтесь в Заоблачный пик во Внутренних землях и поговорите с укротителем грифонов Разящим Когтем.‡Reist zum Nistgipfel im Hinterland und sprecht mit Greifenmeister Krallenaxt.‡동부 내륙지의 맹금의 봉우리로 가서 그리핀 조련사 탈론액스와 대화해야 합니다.‡Viaja hasta Pico Nidal en las Tierras del Interior y habla con el maestro de grifos Garracha.‡Viaja hasta Pico Nidal en las Tierras del Interior y habla con el maestro de grifos Garracha.‡Rendez-vous au Nid-de-l’Aigle dans les Hinterlands et parlez au Maître des griffons Hachegriffe.‡去找辛特兰鹰巢山的狮鹫管理员塔隆艾克斯。‡前往辛特蘭的鷹巢山，並和獅鷲獸管理員沙拉克‧鷹斧說話。',
  }
},
[26543] = {
  {
    'Mão melada‡Шустрые моллюски‡Muscheln meucheln‡친친한 손‡Manos húmedas‡Manos húmedas‡À la pêche aux palourdes, lourdes, lourdes…‡湿冷的双手‡黏黏的手',
    nil,
    'Colete 10 nacos de Carne de Marisco Monstruoso dos mariscos perto da costa leste, ao sul de Orgrimmar. Fale novamente com Razgar quando terminar.‡Добудьте 10 кусков мяса чудовищного моллюска на восточном побережье к югу от Оргриммара. Возвращайтесь к Разгару с добычей.‡Besorgt 10 Stücke Fleisch einer monströsen Muschel von den Muscheln an der Ostküste Durotars, südlich von Orgrimmar. Kehrt danach zu Razgar zurück.‡오그리마 바로 남쪽, 동부 해안가 근처에 있는 괴물 조개에서 괴물 조갯살 10개를 모아 라즈가르에게 가야 합니다.‡Reúne 10 carnes de almeja monstruosa de las almejas cercanas a la orilla este, justo al sur de Orgrimmar. Vuelve con Razgar cuando hayas acabado.‡Reúne 10 carnes de almeja monstruosa de las almejas cercanas a la orilla este, justo al sur de Orgrimmar. Vuelve con Razgar cuando hayas acabado.‡Récupérez 10 portions de Chair de palourde monstrueuse sur les palourdes de la côte est, juste au sud d’Orgrimmar. Lorsque ce sera fait, retournez voir Razgar.‡在奥格瑞玛城南的海岸线东部，收集10份巨大的蚌肉。完成任务之后，向纳兹加尔复命。‡從東部海岸線附近的蚌類身上取得10份巨大蚌肉。完成後，回去找拉茲嘎爾。',
  }
},
[26544] = {
  {
    'Caiu a ficha‡Они поумнели…‡Sie werden schlauer...‡오크의 침공 계획‡Se han vuelto más avispados...‡Se han vuelto más avispados...‡Ils sont dans le coup…‡他们变聪明了……‡他們變聰明了...',
    nil,
    'Recupere a Missiva Orc de Rocha Negra.‡Разыщите послание орков Черной горы.‡Besorgt das Sendschreiben der Orcs des Schwarzfelsklans.‡검은바위 오크 서신을 입수해야 합니다.‡Consigue la misiva de orco Roca Negra.‡Consigue la misiva de orco Roca Negra.‡Trouvez la Missive d’orc rochenoire.‡缴获黑石兽人信函。‡取得黑石獸人書信。',
  }
},
[26545] = {
  {
    'Berrante tem que morrer!‡Изувой должен умереть!‡Jauler muss sterben!‡요울러 처치‡¡Ululante debe morir!‡¡Ululante debe morir!‡Couineur doit mourir !‡犹勒必须死！‡猶勒一定得死!',
    nil,
    'Mate Berrante e recupere o Plano de Invasão dos Rocha Negra.‡Убейте Изувоя и найдите у него планы вторжения орков Черной горы.‡Tötet Jauler und bergt die Invasionspläne des Schwarzfelsklans.‡요울러를 처치하고 검은바위 침공 계획서를 입수해야 합니다.‡Mata a Ululante y consigue los planes de invasión Roca Negra.‡Mata a Ululante y consigue los planes de invasión Roca Negra.‡Tuez Couineur et récupérez les Plans d’invasion rochenoire.‡杀死犹勒，缴获黑石攻击计划书。‡殺死猶勒並取得黑石攻擊計畫。',
  }
},
[26546] = {
  {
    'Amigos dos bicavalha‡Друзья-остроклювы‡Klingenschnabelfreunde‡뾰족부리그리핀 친구들‡Amigos Picovaja‡Amigos Picovaja‡Nos amis les Bec-rasoirs‡锋喙之友‡鋒喙獅鷲獸朋友',
    nil,
    'Use a Comida de Grifo para alimentar 7 grifos Bicavalha Adestrados.‡Покормите 7 обученных остроклювов из мешка с пищей грифона.‡Füttert 7 ausgebildete Klingenschnabelgreifen mit dem Greifenfutter.‡길들인 뾰족부리그리핀 7마리에게 그리핀 먹이를 사용해야 합니다.‡Usa tripas de grifo para alimentar a 7 grifos Picovaja adiestrados.‡Usa tripas de grifo para alimentar a 7 grifos Picovaja adiestrados.‡Utilisez la Pitance de griffon pour nourrir 7 Griffons bec-rasoirs apprivoisés.‡用狮鹫大餐给7头训练有素的锋喙狮鹫喂食。‡使用獅鷲獸飼料餵食7隻訓練有素的鋒喙獅鷲獸。',
  }
},
[26547] = {
  {
    'Uma ameaça sarnenta‡Грифон волку не товарищ… и не еда!‡Räudige Bedrohung‡병든 위협 요인‡Una amenaza sarnosa‡Una amenaza sarnosa‡Une menace galeuse‡癞皮的威胁‡癩皮的威脅',
    nil,
    'Mate 8 Jubapratas Sarnentos.‡Убейте 8 облезлых среброгривов.‡Tötet 8 räudige Silbermähnen.‡병든 은빛갈기늑대 8마리를 처치해야 합니다.‡Mata a 8 melenargenta sarnosos.‡Mata a 8 melenargenta sarnosos.‡Tuez 8 Crins-d’argent galeux.‡杀死8条癞皮银鬃狼。‡殺死8隻癩皮銀鬃狼。',
  }
},
[26548] = {
  {
    'Rumo ao fronte‡На фронт‡Auf zur Front‡전선으로‡Al frente‡Al frente‡Monter au front‡前往前线‡戰爭前線',
    nil,
    'Fale com Kerr Aço-de-mira no Posto Avançado Penafúria.‡Поговорите с Керр Суровый Взгляд в Лагере Грозового Крыла.‡Sprecht mit Kerr Eisenblick im Sturmfederaußenposten.‡폭풍깃털 전초기지에 있는 케르 아이언사이트와 대화해야 합니다.‡Habla con Kerr Vistaferro en Avanzada Tempespluma.‡Habla con Kerr Vistaferro en Avanzada Tempespluma.‡Parlez à Kerr Matefer au Poste avancé de Plumorage.‡跟风暴之羽哨站的科尔·铁眼谈一谈。‡和風暴之羽崗哨的珂爾·鐵眼說話。',
  }
},
[26549] = {
  {
    'Loucura, loucura, loucuuuura!‡Безумие‡Wahnsinn‡광기‡Locura‡Locura‡Démence‡疯狂‡精神錯亂',
    nil,
    'Escolte o Negociador da Horda até o salão principal do Porto Presa do Dragão para encontrar o Chefe Guerreiro Mor\'ghor dos Presa do Dragão. Fale com Ornak na costa se você se perder do Negociador.‡Проводите посредника Орды до главного зала в порту Драконьей Пасти, чтобы он мог встретиться с Мор\'гором, вождем Драконьей Пасти. Если вы потеряете посредника, поговорите с Орнаком, который находится на побережье.‡Begleitet den Hordenunterhändler in den Hauptsaal im Hafen des Drachenmals und trefft Euch mit Kriegshäuptling Mor\'ghor vom Drachenmalklan. Sprecht mit Ornak an der Küste, sollte Euch der Unterhändler abhanden kommen.‡호드 협상가를 용아귀 항구 주전당까지 호위해 대족장 모르고르를 만나야 합니다. 협상가가 없어지면 해변에 있는 오르낙과 대화하십시오.‡Escolta al negociador de la Horda a la sala principal, en el Puerto Faucedraco, para que se reúna con el Jefe de Guerra Mor\'ghor de los Faucedraco. Habla con Ornak, en la costa, si pierdes a tu negociador.‡Escolta al negociador de la Horda a la sala principal, en el Puerto Faucedraco, para que se reúna con el Jefe de Guerra Mor\'ghor de los Faucedraco. Habla con Ornak, en la costa, si pierdes a tu negociador.‡Escortez le Négociateur de la Horde jusqu\'au bâtiment principal du Port Gueule-de-dragon pour qu\'il puisse s\'entretenir avec le Chef de guerre Mor\'ghor des Gueules-de-dragon. Allez voir Ornak le long de la côte si vous perdez de vue le Négociateur.‡把部落交涉者护送到龙喉哨站的主厅去同龙喉酋长莫格霍尔会面。要是你失去了你的交涉者，就去同海边的欧纳克交谈。‡護送部落協商者進入龍喉港主廳和龍喉大酋長莫格會面。要是你的協商者不見了，就和岸邊的奧納克說話。',
  }
},
[26550] = {
  {
    'Negócios obscuros‡Тайные сделки‡Durch die Hintertür‡뒷거래‡Tratos bajo mano‡Tratos bajo mano‡Les écoutes totémiques‡幕后交易‡後門的勾當',
    nil,
    'Coloque o Incenso de Gurubashi em frente ao Totem de Hir\'eek. Em seguida, escute o plano de Zanzil.‡Положите благовония Гурубаши напротив тотема Хир\'ика и выведайте планы Занзила.‡Stellt den Weihrauch der Gurubashi vor dem Totem von Hir\'eek ab und hört Euch Zanzils Plan an.‡히르이크의 토템 앞에 구루바시 향료를 놓고 잔질의 계획을 들어야 합니다.‡Coloca el incienso Gurubashi frente al tótem de Hir\'eek y escucha el plan de Zanzil.‡Coloca el incienso Gurubashi frente al tótem de Hir\'eek y escucha el plan de Zanzil.‡Placez l’Encens gurubashi devant le Totem d\'Hir\'eek, puis écoutez les plans de Zanzil.‡将古拉巴什熏香放在希里克图腾前，然后听取赞吉尔的阴谋。‡將古拉巴什薰香放在希爾雷克圖騰前，然後聆聽贊吉爾的計畫。',
  }
},
[26551] = {
  {
    'Eliminando o pária‡Убить Отверженного‡Beseitigt den Ausgestoßenen‡추방자 제거‡Elimina al Desterrado‡Elimina al Desterrado‡L\'élimination du Paria‡消灭流亡者‡殲滅流亡者',
    nil,
    'Vá para as Ruínas de Aboraz no Cabo do Espinhaço e mate Zanzil, o Pária.‡Отправляйтесь в руины Абораза, что на мысе Тернистой долины, и убейте Занзила Отверженного.‡Reist zu den Ruinen von Aboraz am Kap des Schlingendorntals und kümmert Euch um Zanzil den Ausgestoßenen.‡가시덤불 곶의 아보라즈의 폐허로 가서 추방자 잔질을 처리해야 합니다.‡Viaja a las Ruinas de Aboraz, en El Cabo de Tuercespina y encárgate de Zanzil el Desterrado.‡Viaja a las Ruinas de Aboraz, en El Cabo de Tuercespina y encárgate de Zanzil el Desterrado.‡Allez aux Ruines d’Aboraz, au Cap Strangleronce, et occupez-vous de Zanzil le Paria.‡前往荆棘谷海角阿博拉兹废墟对付流亡者赞吉尔。‡前往荊棘谷海角的阿博拉茲廢墟，料理掉『流亡者』贊吉爾。',
  }
},
[26552] = {
  {
    'Pelo buraco do troll‡Троллья дыра‡Durch das Trollloch‡트롤의 구멍을 지나‡A través del agujero trol‡A través del agujero trol‡Le troll qui se cachait dans un trou‡穿过巨魔洞‡穿越食人妖洞穴',
    nil,
    'Use o Portal de Zanzil para entrar em Zul\'Gurub.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Chabal no Esconderijo da Chaveforte.‡Воспользуйтесь порталом Занзила и отправляйтесь в Зул\'Гуруб.|n|nЕсли заблудитесь или вам потребуется вернуться в Зул\'Гуруб, поговорите с Шабалом в Укрытии Кофельнагель.‡Benutzt Zanzils Portal und betretet Zul\'Gurub.|n|nSolltet Ihr Euch verlaufen oder nach Zul\'Gurub zurückkehren müssen, sprecht mit Chabal in Hartzangs Versteck.‡잔질의 차원문을 통해 줄구룹에 들어가야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면 하드렌치 은신처의 차발과 대화해야 합니다.‡Usa el portal de Zanzil y entra en Zul\'Gurub.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Usa el portal de Zanzil y entra en Zul\'Gurub.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Utilisez le Portail de Zanzil pour entrer dans Zul’Gurub. |n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Chabal, à la Planque de Serrelavis.‡用赞吉尔的传送门进入祖尔格拉布。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡使用贊吉爾的傳送門進入祖爾格拉布。|n|n如果你迷路了或是需要回到祖爾格拉布，在硬心藏匿處和查巴爾說話。',
  }
},
[26553] = {
  {
    'Alta-sacerdotisa Jeklik‡Верховная жрица Джеклик‡Hohepriesterin Jeklik‡대여사제 제클릭‡Suma sacerdotisa Jeklik‡Suma sacerdotisa Jeklik‡La grande prêtresse Jeklik‡高阶祭司耶克里克‡高階祭司耶克里克',
    nil,
    'Destrua o corpo da Alta-sacerdotisa Jeklik antes que Zanzil consiga ressuscitá-la.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Chabal no Esconderijo da Chaveforte.‡Уничтожьте тело верховной жрицы Джеклик, прежде чем Занзил ее воскресит.|n|nЕсли вы заблудитесь или вам понадобится вернуться в Зул\'Гуруб, поговорите с Шабалом в Укрытии Кофельнагель.‡Vernichtet die Leiche der Hohepriesterin Jeklik, bevor Zanzil sie wiedererwecken kann.|n|nSolltet Ihr Euch verlaufen oder nach Zul\'Gurub zurückkehren müssen, sprecht mit Chabal in Hartzangs Versteck.‡잔질이 부활시키기 전에 대여사제 제클릭의 몸을 파괴해야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면, 하드렌치 은신처의 차발과 대화해야 합니다.‡Destruye el cuerpo de la suma sacerdotisa Jeklik antes de que Zanzil pueda resucitarla.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Destruye el cuerpo de la suma sacerdotisa Jeklik antes de que Zanzil pueda resucitarla.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Détruisez le corps de la Grande prêtresse Jeklik avant que Zanzil ne puisse la ressusciter.|n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Chabal, à la Planque de Serrelavis‡在赞吉尔复活他之前消灭高阶祭司耶克里克。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡在贊吉爾將她復活之前摧毀高階祭司耶克里克的屍體。|n|n如果你迷路或需要回去祖爾格拉布，去硬心藏匿處和查巴爾說話。',
  }
},
[26554] = {
  {
    'Cada vez mais fundo em Zul\'Gurub‡Путешествие в Зул\'Гуруб‡Hals über Kopf nach Zul\'Gurub‡줄구룹으로 뛰어들다‡Hacia lo más profundo de Zul\'Gurub‡Hacia lo más profundo de Zul\'Gurub‡Au cœur de Zul’Gurub‡身陷祖尔格拉布‡鎮壓祖爾格拉布',
    nil,
    'Atravesse o Portal de Zanzil.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Chabal no Esconderijo da Chaveforte.‡Пройдите через портал Занзила.|n|nЕсли потеряетесь или захотите вернуться в Зул\'Гуруб, поговорите с Шабалом в Укрытии Кофельнагель.‡Geht durch Zanzils Portal.|n|nSolltet Ihr Euch verlaufen oder nach Zul\'Gurub zurückkehren müssen, sprecht mit Chabal in Hartzangs Versteck.‡잔질의 차원문을 통과해야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면 하드렌치 은신처의 차발과 대화해야 합니다.‡Atraviesa el portal de Zanzil.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Atraviesa el portal de Zanzil.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Franchissez le Portail de Zanzil. |n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Chabal, à la Planque de Serrelavis.‡穿过赞吉尔的传送门。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡穿過贊吉爾的傳送門。|n|n如果你迷路了或是需要回到祖爾格拉布，在硬心藏匿處和查巴爾說話。',
  }
},
[26555] = {
  {
    'Sumo Sacerdote Venoxis‡Верховный жрец Веноксис‡Hohepriester Venoxis‡대사제 베녹시스‡Sumo sacerdote Venoxis‡Sumo sacerdote Venoxis‡Le grand prêtre Venoxis‡高阶祭司温诺希斯‡高階祭司溫諾希斯',
    nil,
    'Mate Zanzil, o Pária, e o Sumo Sacerdote Venoxis.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Chabal no Esconderijo da Chaveforte.‡Разберитесь с Занзилом Отверженным и верховным жрецом Веноксисом.|n|nЕсли заблудитесь или захотите вернуться в Зул\'Гуруб, поговорите с Шабалом в Укрытии Кофельнагель.‡Kümmert Euch um Zanzil den Ausgestoßenen und Hohepriester Venoxis.|n|nSolltet Ihr Euch verlaufen oder nach Zul\'Gurub zurückkehren müssen, sprecht mit Chabal in Hartzangs Versteck.‡추방자 잔질과 대사제 베녹시스를 처리해야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면, 하드렌치 은신처에 있는 차발과 대화해야 합니다.‡Encárgate de Zanzil el Desterrado y del sumo sacerdote Venoxis.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Encárgate de Zanzil el Desterrado y del sumo sacerdote Venoxis.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Chabal en el Escondrijo Malallave.‡Affrontez Zanzil le Paria et le Grand prêtre Venoxis.|n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Chabal, à la Planque de Serrelavis‡对付流亡者赞吉尔和高阶祭司温诺希斯。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡料理掉『流亡者』贊吉爾和高階祭司溫諾希斯。|n|n如果你迷路或需要回去祖爾格拉布，在硬心藏匿處和查巴爾說話。',
  }
},
[26556] = {
  {
    'Jogue o lixo no lixo‡Нет вредным отходам‡Müll abladen verboten‡쓰레기 투척은 그만‡Prohibido lanzar residuos‡Prohibido lanzar residuos‡Dépôt d\'ordures interdit‡不许倾倒垃圾‡禁止拋棄',
    nil,
    'Pesque 6 Brejeiros Tóxicos e entregue-os para Razgar no Vale da Honra ao completar a missão.‡Выловите 6 ядовитых луженниц и отнесите их Разгару на Аллею Чести.‡Angelt 6 giftige Pfützenfische und kehrt zu Razgar ins Tal der Ehre zurück, wenn Ihr fertig seid.‡맹독 흙탕어 6마리를 잡아 명예의 골짜기에 있는 라즈가르에게 가져가야 합니다.‡Encuentra 6 peces espátula tóxicos y llévaselos a Razgar en el Valle del Honor cuando hayas acabado.‡Encuentra 6 peces espátula tóxicos y llévaselos a Razgar en el Valle del Honor cuando hayas acabado.‡Pêchez 6 Flachards toxiques. Lorsque ce sera fait, retournez voir Razgar dans la Vallée de l’Honneur.‡钓起6条剧毒泥鱼。完成任务之后，向荣誉谷的纳兹加尔复命。‡釣起6條劇毒鱘魚，並在完成後將牠們帶回去榮譽谷給拉茲嘎爾。',
  }
},
[26557] = {
  {
    'Um esforço laborioso‡Невероятное усилие‡Augen auf beim Angeln‡무너지는 노력‡Un esfuerzo asombroso‡Un esfuerzo asombroso‡Des efforts stupéfiants‡鹿眼的诱惑‡驚人的成果',
    nil,
    'Mate um Cervo ao norte de Orgrimmar e use o olho como isca para pescar uma Carpa Arenosa no Vale da Sabedoria. Fale novamente com Razgar no Vale da Honra ao completar a missão.‡Убейте оленя к северу от Оргриммара и выловите на его глаз, как на наживку, песчаного карпа на Аллее Мудрости. Затем возвращайтесь к Разгару на Аллею Чести.‡Erlegt einen Hirsch nördlich von Orgrimmar und benutzt sein Auge als Köder, um einen Sandkarpfen im Tal der Weisheit zu fangen. Kehrt danach zu Razgar ins Tal der Ehre zurück.‡오그리마 북쪽에서 사슴을 잡아 사슴 눈을 사용하여 지혜의 골짜기에 있는 모래땅 잉어를 잡아서 명예의 골짜기에 있는 라즈가르에게 가야 합니다.‡Mata un venado al norte de Orgrimmar y utiliza su ojo como cebo para pescar una carpa arenosa en el Valle de la Sabiduría. Vuelve con Razgar en el Valle del Honor cuando hayas acabado.‡Mata un venado al norte de Orgrimmar y utiliza su ojo como cebo para pescar una carpa arenosa en el Valle de la Sabiduría. Vuelve con Razgar en el Valle del Honor cuando hayas acabado.‡Tuez un Cerf au nord d\'Orgrimmar et utilisez son œil comme appât pour attraper une Carpe des sables dans la Vallée de la Sagesse. Retournez voir Razgar dans la Vallée de l\'Honneur quand vous aurez terminé.‡在奥格瑞玛北面杀死一头鹿，用它的眼球当鱼饵，在智慧谷中捕捉一条沙地锦鲤。完成任务之后，向荣誉谷的纳兹加尔复命。‡在奧格瑪北方殺死一頭雄鹿，用牠的眼睛當餌，在智慧谷釣起一隻沙地鯉魚。完成後，回去榮譽谷找拉茲嘎爾。',
  }
},
[26558] = {
  {
    'Evocando Shadra‡Призыв Шадры‡Die Beschwörung von Shadra‡샤드라 소환‡Invocar a Shadra‡Invocar a Shadra‡L\'invocation de Shadra‡召唤沙德拉‡召喚沙德拉',
    nil,
    'Use o Ídolo de Shadra nos Templos Noroeste, Sudoeste e Leste em Shadra\'Alor.‡Используйте идол Шадры в северо-западном, юго-западном и восточном храмах в Шадра\'Алоре.‡Benutzt den Götzen von Shadra am nordwestlichen, südwestlichen und östlichen Tempel in Shadra\'Alor.‡샤드라알로의 북서쪽, 남서쪽, 동쪽 사원에 샤드라의 우상을 사용해야 합니다.‡Usa el ídolo de Shadra en los Templos Noroccidental, Suroccidental y Oriental en Shadra\'Alor.‡Usa el ídolo de Shadra en los Templos Noroccidental, Suroccidental y Oriental en Shadra\'Alor.‡Utilisez l’Idole de Shadra aux Temples nord-ouest, sud-ouest et est de Shadra’Alor.‡在沙德拉洛西北、西南，以及东部神殿里使用沙德拉塑像。‡在沙德拉洛西北、西南、東方的神廟使用沙德拉塑像。',
  }
},
[26559] = {
  {
    '[NYI] Breaking Out is Hard to Do‡[NYI] Побег – штука сложная‡[NYI] Der Schlüssel zum Erfolg‡[NYI] 탈옥은 어려워‡[NYI] Huir es difícil‡[NYI] Huir es difícil‡[NYI] Mission évasion‡[NYI] Breaking Out is Hard to Do‡[NYI]闖關沒那麼簡單',
    nil,
    nil,
  }
},
[26560] = {
  {
    'Jorgensen‡Йоргенсен‡Jorgensen‡요르겐센 구출‡Jorgensen‡Jorgensen‡Jorgensen‡约根森‡喬更森',
    nil,
    'Recupere a Chave da Jaula de Jorgensen.‡Добудьте ключ от клетки Йоргенсена.‡Besorgt Jorgensens Käfigschlüssel.‡요르겐센의 철창 열쇠를 회수해야 합니다.‡Consigue la llave de jaula de Jorgensen.‡Consigue la llave de jaula de Jorgensen.‡Récupérez la Clé de la cage de Jorgensen.‡获得约根森的牢笼钥匙。‡取回喬更森的牢籠鑰匙。',
  }
},
[26561] = {
  {
    'Krakauer‡Кракауер‡Krakauer‡크라카우어 구출‡Krakauer‡Krakauer‡Krakauer‡卡拉克尔‡克洛克考爾',
    nil,
    'Mate o Ritualista Tarak.‡Убейте ритуалиста Тарака.‡Tötet Ritualist Tarak.‡신도 타락을 처치해야 합니다.‡Mata al Ritualista Tarak.‡Mata al Ritualista Tarak.‡Tuez le Ritualiste Tarak.‡杀死仪祭师塔拉卡。‡殺死祭儀師塔拉克。',
  }
},
[26562] = {
  {
    'E, por último, mas não menos importante... Danforth‡Последний, но не менее важный: Данфорт‡Der Nachzügler... Danforth‡마지막으로... 댄포스 구출‡Y por último, aunque no menos importante... Danforth‡Y por último, aunque no menos importante... Danforth‡Et la cerise sur le gâteau… Danforth‡最后但同样重要的……丹弗斯‡最後但同樣重要的...丹佛斯',
    nil,
    'Mate o Suserano Barbarius e recupere a Chave da Alavanca de Rocha Negra. Use a Chave da Alavanca de Rocha Negra para libertar Danforth.‡Убейте властителя Барбария и возьмите у него тумблер Черной горы. Потом при помощи этого тумблера освободите Данфорта.‡Tötet Oberanführer Barbarius und bergt den Hebelschlüssel des Schwarzfelsklans. Befreit Danforth mit dem Hebelschlüssel des Schwarzfelsklans.‡대군주 바바리우스를 처치하고 검은바위 지렛대 열쇠를 회수해야 합니다. 검은바위 지렛대 열쇠를 사용하여 댄포스를 풀어줘야 합니다.‡Mata al Señor supremo Barbarius y consigue la llave de palanca Roca Negra. Usa la llave de palanca Roca Negra para liberar a Danforth.‡Mata al Señor supremo Barbarius y consigue la llave de palanca Roca Negra. Usa la llave de palanca Roca Negra para liberar a Danforth.‡Tuez le Suzerain Barbarius et récupérez la Clé du levier rochenoire. Utilisez la Clé du levier rochenoire pour libérer Danforth.‡杀掉巴尔贝留斯大王，拿到黑石控制杆钥匙，用它救出丹弗斯。‡殺死霸主巴爾巴里爾斯並取得黑石操縱桿鑰匙。用黑石操縱桿鑰匙釋放丹佛斯。',
  }
},
[26563] = {
  {
    'A volta da Companhia Bravo‡Возвращение компании "Браво"‡Rückkehr der Kompanie Bravo‡불곰 중대의 귀환‡El regreso de la Compañía Bravo‡El regreso de la Compañía Bravo‡Le retour de la compagnie Bravo‡B连归来‡第二連隊歸來',
    nil,
    'Fale novamente com o Coronel Troteman em Vila Plácida, que fica em Cristarrubra.‡Поговорите с полковником Тротманом в Приозерье, что в Красногорье.‡Meldet Euch bei Oberst Trottmann in Seenhain im Rotkammgebirge.‡붉은마루 산맥의 호숫골에 있는 대령 트로트먼에게 보고해야 합니다.‡Preséntate ante el Coronel Troteman en Villa del Lago en Crestagrana.‡Preséntate ante el Coronel Troteman en Villa del Lago en Crestagrana.‡Présentez-vous au Colonel Troteman à Comté-du-Lac, dans les Carmines.‡去找赤脊山湖畔镇的托德曼上校。‡回赤脊山的湖畔鎮向卓特曼上校報告。',
  }
},
[26564] = {
  {
    'Peças sobressalentes‡На все руки мастер‡Heimwerker‡수리 필요‡Necesita unos arreglos‡Necesita unos arreglos‡Les catapultes, c’est la cata !‡装修改建‡待整修',
    nil,
    'Recolha 6 Peças de Catapulta.‡Соберите 6 деталей катапульты.‡Besorgt 6 Katapultteile.‡투석기 부품 6개를 수집해야 합니다.‡Reúne 6 piezas de catapulta.‡Reúne 6 piezas de catapulta.‡Récupérez 6 Pièces de catapulte.‡收集6个投石车零件。‡收集6份投石車零件。',
  }
},
[26565] = {
  {
    'A Furious Catch (REMOVED)‡Строптивый улов (УДАЛЕН)‡Ein wütender Fang‡A Furious Catch (REMOVED)‡Una presa furiosa (REMOVED)‡Una presa furiosa (REMOVED)‡Une prise furieuse [RETIRÉE]‡A Furious Catch (REMOVED)‡狂暴的漁獲(移除)',
    nil,
    'Catch a Furious Pike in the Southfury River. The Southfury River can be found just outside Orgrimmar\'s western gate. Return to Razgar in the Valley of Honor once you are done.‡Поймайте разъяренную щуку в реке Строптивой. Выйти к реке можно через западные ворота Оргриммара. Возвращайтесь с уловом к Разгару на Аллею Чести.‡Fangt einen riesigen wütenden Hecht im Südstrom. Ihr findet den Südstrom vor dem westlichen Tor von Orgrimmar. Kehrt danach ins Tal der Ehre zu Razgar zurück.‡Catch a Furious Pike in the Southfury River.  The Southfury River can be found just outside Orgrimmar\'s western gate. Return to Razgar in the Valley of Honor once you are done.‡Atrapa un lucio furioso en el Río Furia del Sur. El Río Furia del Sur puede encontrarse al exterior de la puerta oeste de Orgrimmar. Vuelve con Razgar en el Valle del Honor cuando lo hayas hecho.‡Atrapa un lucio furioso en el Río Furia del Sur. El Río Furia del Sur puede encontrarse al exterior de la puerta oeste de Orgrimmar. Vuelve con Razgar en el Valle del Honor cuando lo hayas hecho.‡Pêchez un Brochet furieux dans la Furie-du-Sud. Ce fleuve coule juste devant la porte ouest d\'Orgrimmar. Revenez voir Razgar dans la Vallée de l\'Honneur quand vous aurez terminé.‡Catch a Furious Pike in the Southfury River.  The Southfury River can be found just outside Orgrimmar\'s western gate. Return to Razgar in the Valley of Honor once you are done.‡在怒水河中釣取一隻狂暴狗魚。怒水河就在奧格瑪西門的外面。一旦完成這項任務，回去榮譽谷找拉茲嘎爾。',
  }
},
[26566] = {
  {
    'O triunfo da inventividade gnômica‡Торжество гномьей хитрости‡Ein Triumph gnomischer Erfindungsgabe‡노움 발명의 승리‡El triunfo de la genialidad gnómica‡El triunfo de la genialidad gnómica‡Le triomphe de l\'ingéniosité gnome‡侏儒才智的胜利‡地精創造力的勝利',
    nil,
    'Fale com o Engenheiro Fagulhamola na Vila da Gambiarra.‡Поговорите с инженером Искролязгом в Новом Городе Механиков.‡Sprecht mit Ingenieur Schleiffunke in Neu-Tüftlerstadt.‡신 땜장이 마을에 있는 기술자 그라인드스파크와 대화해야 합니다.‡Habla con el ingeniero Machacachispa en Nueva Ciudad Manitas.‡Habla con el ingeniero Machacachispa en Nueva Ciudad Manitas.‡Parlez à l’Ingénieur Pulvétincelle, à La Nouvelle-Brikabrok.‡跟新工匠镇的工程师格林德斯巴克谈一谈。‡和新地精區的工程師磨炫交談。',
  }
},
[26567] = {
  {
    'John J. Keeshan‡Джон Джей Кишан‡John J. Keeshan‡존 J. 키샨‡John J. Keeshan‡John J. Keeshan‡John J. Keeshan‡约翰·J·基沙恩‡約翰·J·基沙恩',
    nil,
    'Consiga a ajuda de John J. Keeshan na Taberna de Vila Plácida, que fica em Vila Plácida.‡Найдите в Приозерской таверне Джона Джея Кишана и попросите его о помощи.‡Bemüht Euch um die Hilfe von John J. Keeshan im Gasthaus Seenhain in Seenhain.‡호숫골의 호숫골 여관에서 존 J. 키샨을 만나 도움을 요청해야 합니다.‡Consigue la ayuda de John J. Keeshan en la posada de Villa del Lago en Villa del Lago.‡Consigue la ayuda de John J. Keeshan en la posada de Villa del Lago en Villa del Lago.‡Obtenez l’aide de John J. Keeshan à l’Auberge de Comté-du-Lac, à Comté-du-Lac.‡在湖畔镇的湖畔镇旅店征募约翰·J·基沙恩。‡去湖畔鎮的湖畔鎮旅店爭取約翰·J·基沙恩的援助。',
  }
},
[26568] = {
  {
    'Essa guerra não é minha‡Не моя война‡Is\' nich\' mein Krieg‡당신들만의 전쟁‡Esta no es mi guerra‡Esta no es mi guerra‡C’est pas ma guerre‡和我无关‡非我之戰',
    nil,
    'Fale novamente com o Coronel Troteman.‡Вернитесь к полковнику Тротману.‡Kehrt zu Oberst Trottman zurück.‡대령 트로트먼에게 가야 합니다.‡Vuelve con el Coronel Troteman.‡Vuelve con el Coronel Troteman.‡Retournez voir le Colonel Troteman.‡去找托德曼上校。‡回去找卓特曼上校。',
  }
},
[26569] = {
  {
    'Aparelhagem de levantamento‡Геодезическое снаряжение‡Vermessungsausrüstung‡측량 장비‡Equipamiento de inspección‡Equipo de análisis‡Équipement topographique‡测量设备‡勘察設備',
    nil,
    'Recupere 5 Telescópios de Rocha Negra.‡Раздобудьте 5 подзорных труб Черной горы.‡Beschafft 5 Teleskope des Schwarzfelsklans.‡검은바위 망원경 5개를 입수해야 합니다.‡Consigue 5 catalejos Roca Negra.‡Consigue 5 catalejos Roca Negra.‡Récupérez 5 Longues-vues rochenoires.‡收集5个黑石望远镜。‡取得5個黑石望遠鏡。',
  }
},
[26570] = {
  {
    'O exército dos laceradores‡Армия Ренда‡Renders Armee‡약탈의 부대‡El ejército de Render‡El ejército de Render‡L’armée des vingt-cinq orcs‡撕裂者大军‡撕裂者大軍',
    nil,
    'Mate 25 orcs Rocha Negra na Serraria Alther ou no Acampamento dos Laceradores.‡Убейте 25 любых орков из клана Черной горы на лесопилке Альтера или в лагере Ренда.‡Tötet 25 beliebige Schwarzfelsorcs in Althers Mühle oder Renders Lager.‡앨더의 제재소나 약탈의 야영지에서 검은바위 오크 25마리를 처치해야 합니다.‡Mata a 25 orcos Roca Negra cualquiera en el Molino de Alther o en el Campamento de Render.‡Mata a 25 orcos Roca Negra cualquiera en el Molino de Alther o en el Campamento de Render.‡Tuez 25 Orcs rochenoires à la Scierie d’Alther ou au Camp des Étripeurs.‡在奥瑟尔伐木场或撕裂者营地击败25名黑石兽人。‡在奧瑟爾伐木場或撕裂者營地殺死任意25名黑石獸人。',
  }
},
[26571] = {
  {
    'Armas de guerra‡Орудия войны‡Kriegswaffen‡전쟁 무기‡Armas de guerra‡Armas de guerra‡Des armes de guerre‡战争的武器‡戰爭的武器',
    nil,
    'Recupere a Faca de Sobrevivência de Keeshan e o Arco de Keeshan.‡Верните лук Кишана и нож выживания Кишана.‡Bergt Keeshans Bogen und Keeshans Überlebensmesser.‡키샨의 활과 키샨의 야영용 손칼을 되찾아야 합니다.‡Recupera el arco de Keeshan y el cuchillo de supervivencia de Keeshan.‡Recupera el arco de Keeshan y el cuchillo de supervivencia de Keeshan.‡Récupérez l’Arc de Keeshan et le Couteau de survie de Keeshan.‡获得基沙恩的弓和基沙恩的生存刀。‡取回基沙恩之弓和基沙恩的求生小刀。',
  }
},
[26572] = {
  {
    'Oportunidade de ouro‡Золотой улов‡Elektrisierender Einfall‡절호의 기회‡Una oportunidad de oro‡Una oportunidad de oro‡Une occasion en or‡金色的机遇‡黃金良機',
    nil,
    'Use a Faca Filetadora de Razgar para cortar um Rabo de Lagarto Trovejante Afogado no Desfiladeiro do Trovão, ao sul de Orgrimmar. Use a cauda para matar um Peixe-pedra Dourado. Fale novamente com Razgar no Vale da Honra ao completar a missão.‡Возьмите разделочный нож Разгара, чтобы отрезать хвост рокочущей ящерицы на Громовом хребте к югу от Оргриммара. Когда раздобудете хвост, оглушите им золотую бородавчатку. Возвращайтесь с уловом к Разгару на Аллею Чести.‡Schneidet im Donnergrat, südlich von Orgrimmar, den Schwanz einer ertrunkenen Donnerechse mit Razgars Filetiermesser ab. Benutzt den Schwanz nahe eines goldenen Steinfischs, um ihn damit zu töten. Kehrt danach zu Razgar ins Tal der Ehre zurück.‡라즈가르의 회칼을 사용하여 오그리마 남쪽, 천둥 마루에 있는 익사한 천둥도마뱀 꼬리를 잘라내어, 근처에 있는 황금 퉁쏠치를 처치하는 데 사용해야 합니다. 임무를 마치면 명예의 골짜기에 있는 라즈가르에게 가야 합니다.‡Utiliza el cuchillo para filetear de Razgar para cortar una cola de truenagarto ahogado en Monte del Trueno, al sur de Orgrimmar. Una vez que tengas la cola, utilízala cerca de un pez piedra dorado para matarlo. Vuelve con Razgar en el Valle del Honor una vez hayas acabado.‡Utiliza el cuchillo para filetear de Razgar para cortar una cola de truenagarto ahogado en Monte del Trueno, al sur de Orgrimmar. Una vez que tengas la cola, utilízala cerca de un pez piedra dorado para matarlo. Vuelve con Razgar en el Valle del Honor una vez hayas acabado.‡Utilisez le Couteau à découper de Razgar pour découper la Queue d\'un lézard-tonnerre noyé aux Falaises du Tonnerre, au sud d\'Orgrimmar. Quand vous aurez la queue, utilisez-la près d\'un Poisson-pierre doré pour le tuer. Ensuite, retournez voir Razgar dans la Vallée de l\'Honneur.‡前往奥格瑞玛南边的雷霆山，使用纳兹加尔的鱼肉切片刀切下一条淹死的雷霆蜥蜴尾巴。然后在金鳞石鱼附近使用这条尾巴，将其杀死。完成任务之后，向荣誉谷的纳兹加尔复命。‡在奧格瑪南方的雷霆山，用拉茲嘎爾的魚刀切下裡溺斃雷霆蜥蜴的尾巴。取得尾巴後，在黃金石魚附近用尾巴將牠殺死。完成後回榮譽谷找拉茲嘎爾。',
  }
},
[26573] = {
  {
    'Motivos para lutar‡Всем сердцем с нами‡Er muss mit ganzem Herzen dabei sein‡키샨의 마음 끌어들이기‡Tiene que poner el alma en ello‡Tiene que poner el alma en ello‡Il doit y mettre tout son cœur !‡他的心必须在‡激勵人心',
    nil,
    'Recupere a Bandana Vermelha de Keeshan e o Amuleto de Jade de Keeshan.‡Отыщите красную головную повязку Кишана и нефритовый амулет Кишана.‡Findet Keeshans rotes Stirnband und Keeshans Jadeamulett.‡키샨의 붉은 머리띠와 키샨의 비취 아뮬렛을 회수해야 합니다.‡Recupera la cinta roja de Keeshan y el amuleto de jade de Keeshan.‡Recupera la cinta roja de Keeshan y el amuleto de jade de Keeshan.‡Récupérez le Bandeau rouge de Keeshan et l’Amulette de jade de Keeshan.‡获得基沙恩的红头带和基沙恩的翡翠坠饰。‡取回基沙恩的紅色頭帶和基沙恩的碧玉護符。',
  }
},
[26574] = {
  {
    'O acampamento secreto de Adella‡Убежище Аделлы‡Adellas geheimes Lager‡아델라의 비밀 야영지‡El campamento encubierto de Adella‡El campamento encubierto de Adella‡Le camp secret d\'Adella‡艾德娜的秘密营地‡愛德拉的祕密營地',
    nil,
    'Fale com Adella no Ramo Sombrio, que fica em Feralas.‡Доберитесь до Аделлы в Тень Ветвей в Фераласе.‡Meldet Euch bei Adella im Schattengeäst in Feralas.‡페랄라스의 그늘가지에 있는 아델라에게 보고해야 합니다.‡Preséntate ante Adella en Rama Sombría en Feralas.‡Preséntate ante Adella en Rama Sombría en Feralas.‡Rendez-vous auprès d’Adella aux Ramures ombragées, en Féralas.‡跟菲拉斯蔽日林的艾德娜谈一谈。‡到菲拉斯的蔭枝林向愛德拉回報。',
  }
},
[26575] = {
  {
    'Basilisco abusado‡Последняя капля‡Steinalt‡정말 마지막이다‡El fondo de la roca‡El fondo de la roca‡Ciseler le basilic‡石之底‡岩石底部',
    nil,
    'Mate o Gorgonita.‡Убейте Горгонита.‡Tötet Gorgonit.‡고르고나이트를 처치해야 합니다.‡Mata a Gorgonito.‡Mata a Gorgonito.‡Tuez Gorgonite.‡杀死戈尔贡尼特。‡殺死戈高耐特。',
  }
},
[26576] = {
  {
    'Mãos firmes‡Твердая рука‡Ruhige Hand‡한결같은 바위‡Mano firme‡Mano firme‡Une constance inébranlable‡坚定者的手腕‡穩定的手',
    nil,
    'Fale com Terrath, o Estável, no Alcândor Pálido.‡Поговорите с Терратом Непоколебимым у Белого гнездовья.‡Sprecht mit Terrath dem Beständigen vor dem Bleichen Hort.‡으스름 보금자리에서 한결같은 테라스와 대화해야 합니다.‡Habla con Terrath el Firme en El Nidal Pálido.‡Habla con Terrath el Firme en El Nidal Pálido.‡Allez voir Terrath le Stable au Perchoir Diaphane.‡跟苍白栖地的坚定者特尔拉斯谈一谈。‡在蒼白棲息地和穩定的特拉斯說話。',
  }
},
[26577] = {
  {
    'Rocha dura de roer‡Тернистый путь‡Felserhebung‡험난한 앞길‡Agitación rocosa‡Agitación rocosa‡Bouleversements rocheux‡岩间动乱‡石之動盪',
    nil,
    'Fale com Gorsik, o Turbulento, no alto da Vastidão Carmesim.‡Поговорите с Горсиком Беспокойным в Багровом зале.‡Sprecht mit Gorsik dem Tosenden auf der Rubinspanne.‡진홍 벌판에 있는 요동치는 고르직과 대화해야 합니다.‡Habla con Gorsik el Tumultuoso en la Extensión Carmesí.‡Habla con Gorsik el Tumultuoso en la Extensión Carmesí.‡Allez voir Gorsik le Tumultueux dans les Étendues Cramoisies.‡跟赤红岩床的动荡者格尔西克谈一谈。‡在赤紅瀚洋和激烈的哥西克說話。',
  }
},
[26578] = {
  {
    'Cogumalos‡Гиблогрибы‡Verdammnispilze‡파멸버섯‡Champidestinos‡Champidestinos‡Les champis funestes‡末日菇‡末日蘑菇',
    nil,
    'Destrua 10 Cogumalos.‡Уничтожьте 10 гиблогрибов.‡Zerstört 10 Verdammnispilze.‡파멸버섯 10개를 파괴해야 합니다.‡Acaba con 10 champidestinos.‡Acaba con 10 champidestinos.‡Détruisez 10 Champis funestes.‡摧毁10株末日菇。‡摧毀10朵末日蘑菇。',
  }
},
[26579] = {
  {
    'Eles não são mais os mesmos‡Проявить слабость‡Verweichlicht‡너무 물러서 탈이야‡Se han ablandado‡Se han ablandado‡Virus‡软化‡變軟',
    nil,
    'Mate 8 Beemotes Fúngicos.‡Убейте 8 грибных чудищ.‡Tötet 8 Fungusungetüme.‡곰팡이 괴수 8마리를 처치해야 합니다.‡Mata a 8 behemoths fúngicos.‡Mata a 8 behemoths fúngicos.‡Tuez 8 Béhémoths fongiques.‡杀死8头真菌巨兽。‡殺死8隻真菌巨獸。',
  }
},
[26580] = {
  {
    'Inimigos íntimos‡Знакомые незваные гости‡Vertraute Eindringlinge‡낯익은 침입자‡Intrusos familiares‡Intrusos familiares‡Des intrus familiers‡熟悉的入侵者‡同類入侵者',
    nil,
    'Fale com as "criaturas de carne" intrusas na Vastidão Carmesim.‡Поговорите с "незваными смертными" в Багровом зале.‡Sprecht mit den "Fleischlingeindringlingen" auf der Rubinspanne.‡진홍 벌판에 있는 "육체의 소유자" 침입자들과 대화해야 합니다.‡Habla con los intrusos "de carne" en la Extensión Carmesí.‡Habla con los intrusos "de carne" en la Extensión Carmesí.‡Allez voir les intrus « de chair » dans les Étendues Cramoisies.‡跟赤红岩床“血肉之躯”的入侵者们谈一谈。‡在赤紅瀚洋和「血肉之軀」的侵入者說話。',
  }
},
[26581] = {
  {
    'Cabeça de vento‡Ветер в голове‡Den Kopf in den Wolken‡안개 먹는 바람‡Con la cabeza en las nubes‡Con la cabeza en las nubes‡Un vent de tous les diables‡两耳清风‡風之頭',
    nil,
    'Monte no demonéolo de Lorvarius e colete uma amostra de bruma vermelha perto da água, na Vastidão Carmesim. Em seguida, fale novamente com Lorvarius.‡Возьмите ветробеса Лорвариуса, отправляйтесь к облакам красного тумана, которые находятся у воды в Багровом зале, и возвращайтесь с образцом.‡Bringt Lorvarius\' Windteufel zu den Wolken aus rotem Nebel in der Rubinspanne und bringt eine Probe davon mit.‡로바리우스의 악마바람을 진홍 벌판의 물가에 있는 붉은 안개 구름으로 데려간 다음, 견본을 갖고 돌아와야 합니다.‡Lleva el demoviento de Lorvarius hasta las nubes de niebla roja de la Extensión Carmesí, cerca del agua, y vuelve con una muestra.‡Lleva el demoviento de Lorvarius hasta las nubes de niebla roja de la Extensión Carmesí, cerca del agua, y vuelve con una muestra.‡Emmenez le Tourbillon de Lorvarius près des nuages de fumée rouge dans les Étendues Cramoisies, près de l\'eau, et revenez avec un échantillon.‡将洛瓦留斯的风灵怪带到赤红岩床的水域旁的红色雾状云去，并采一份样本回来。‡將洛瓦歷斯的風之惡魔帶到赤紅瀚洋水邊的紅霧，然後取樣本回去。',
  }
},
[26582] = {
  {
    'Causas não naturais‡Неестественные причины‡Unnatürliche Ursachen‡비정상적인 원인‡Causas no naturales‡Causas no naturales‡Des causes non naturelles‡非自然原因‡不自然的源頭',
    nil,
    'Fale com Gorsik, o Turbulento, na Vastidão Carmesim.‡Поговорите с Горсиком Беспокойным в Багровом зале.‡Sprecht mit Gorsik dem Tosenden in der Rubinspanne.‡진홍 벌판에 있는 요동치는 고르직과 대화해야 합니다.‡Habla con Gorsik el Tumultuoso en la Extensión Carmesí.‡Habla con Gorsik el Tumultuoso en la Extensión Carmesí.‡Allez voir à Gorsik le Tumultueux dans les Étendues Cramoisies.‡跟赤红岩床的动荡者格尔西克谈一谈。‡在赤紅瀚洋和激烈的哥西克說話。',
  }
},
[26583] = {
  {
    'A ira do fungimante‡Гнев грибоманта‡Der Zorn der Fungumanten‡곰팡이술사의 분노‡La furia del Fungimántico‡La furia del Fungimántico‡Le courroux du fongimancien‡真菌占卜者之怒‡真菌專家之怒',
    nil,
    'Fale com a Reparadora da Terra Norsala. Em seguida, mate o Fungimante Glop.‡Поговорите с целительницей земли Норсалой, а затем убейте грибоманта Глопа.‡Sprecht mit Erdheilerin Norsala, tötet dann Fungumant Glop.‡대지치유사 노르살라와 대화한 다음, 곰팡이술사 글롭을 처치해야 합니다.‡Habla con la ensalmadora de la tierra Norsala y después mata al Fungimántico Glop.‡Habla con la ensalmadora de la tierra Norsala y después mata al Fungimántico Glop.‡Allez voir la Soigneterre Norsala, puis tuez le Fongimancien Glop.‡跟大地治愈者诺莎拉谈一谈，然后杀掉真菌占卜者戈洛普。‡和癒地者諾爾莎拉說話，然後殺死真菌專家葛羅普。',
  }
},
[26584] = {
  {
    'Batido e mexido‡Встряхнуть и смешать‡Geschüttelt und gerührt‡베를로크도 벼랑에서 떨어질 때가 있다‡Mezclado y agitado‡Mezclado y agitado‡Secoués et remués‡摇一摇晃一晃‡搖咧晃咧',
    nil,
    'Mate 8 Verloks Demolidores do Pilar na parte inferior do Posto Verlok.‡Убейте 8 скалолазов из Верлока в нижней части Верлока.‡Tötet 8 Säulenbrecher von Verlok im unteren Teil der Wacht Verlok.‡베를로크 바윗부리의 아래쪽에서 베를로크 기둥돌이 8마리를 처치해야 합니다.‡Mata a 8 tumbapilares de Verlok en la sección inferior del Alto Verlok.‡Mata a 8 tumbapilares de Verlok en la sección inferior del Alto Verlok.‡Tuez 8 Tombe-piliers verloks dans la partie basse du Séjour des verloks.‡在维罗克岩台下层杀死8名维罗克石柱翻滚者。‡在維洛克看臺下層殺死8名維洛克翻樑者。',
  }
},
[26585] = {
  {
    'A semente do mal‡Борьба с порчей‡Zerstörung der Verderbnis‡타락의 근원‡Destrucción de corrupción‡Destrucción de corrupción‡La destruction de la corruption‡腐坏的覆灭‡感染毀滅',
    nil,
    'Pegue 8 sacos de Crescimento Miraculoso dos Verlok.‡Добудьте 8 мешочков верлокской чудоросли.‡Besorgt 8 Taschen des Wunderwachstumsmittels von Verlok.‡베를로크 기적의 생장물 가방 8개를 회수해야 합니다.‡Recoge 8 bolsas de brotes milagrosos de Verlok.‡Recoge 8 bolsas de brotes milagrosos de Verlok.‡Récupérez 8 Sacs de croissance-miracle verloks.‡收集8包维罗克的神奇增长素。‡取回8袋維洛克神奇成長激素。',
  }
},
[26586] = {
  {
    'À procura da Companhia Bravo‡Поиски компании "Браво"‡Die Suche nach der Kompanie Bravo‡불곰 중대를 찾아서‡En busca de la Compañía Bravo‡En busca de la Compañía Bravo‡À la recherche de la compagnie Bravo‡寻找B连‡尋找第二連隊',
    nil,
    'Procure pelos membros da Companhia Bravo na Serraria Alther.‡Поищите на лесопилке Альтера кого-нибудь из команды "Браво".‡Sucht in Althers Mühle nach einem Mitglied der Kompanie Bravo.‡불곰 중대원들을 찾기 위해 앨더의 제재소를 조사해야 합니다.‡Registra el Molino de Alther en busca de algún miembro de la Compañía Bravo.‡Registra el Molino de Alther en busca de algún miembro de la Compañía Bravo.‡Fouillez la Scierie d’Alther à la recherche d’un membre de la compagnie Bravo.‡到奥瑟尔伐木场去找一名B连成员。‡在奧瑟爾伐木場搜尋第二連隊成員。',
  }
},
[26587] = {
  {
    'Escapar não é fácil‡Побег – штука сложная‡Der Schlüssel zum Erfolg‡탈옥은 어려워‡Huir es difícil‡Huir es difícil‡Mission évasion‡越狱不容易‡闖關沒那麼簡單',
    nil,
    'Recupere a Chave da Jaula de Messner.‡Найдите ключ от клетки Месснера.‡Besorgt Messners Käfigschlüssel.‡메스너의 우리 열쇠를 구해야 합니다.‡Consigue la llave de jaula de Messner.‡Consigue la llave de jaula de Messner.‡Récupérez la Clé de la cage de Messner.‡获得梅森纳的牢笼钥匙。‡取回梅斯納的牢籠鑰匙。',
  }
},
[26588] = {
  {
    'Pesca furiosa‡Строптивый улов‡Ein wütender Fang‡왕성한 낚시‡Una presa furiosa‡Una presa furiosa‡Une prise furieuse‡狂怒的大鱼‡狂暴的漁獲',
    nil,
    'Pesque um Lúcio Gigante Furioso no Rio Furiaustral. O Rio Furiaustral fica perto do portão ocidental de Orgrimmar. Fale novamente com Razgar no Vale da Honra quando completar a missão.‡Поймайте гигантскую разъяренную щуку в реке Строптивой. Выйти к реке можно через западные ворота Оргриммара. Возвращайтесь с уловом к Разгару на Аллею Чести.‡Fangt einen riesigen wütenden Hecht im Südstrom. Ihr findet den Südstrom vor dem westlichen Tor von Orgrimmar. Kehrt danach zu Razgar ins Tal der Ehre zurück.‡오그리마 서쪽 관문 밖에 있는 성난남녘 강에서 사나운 거대 창꼬치를 잡은 다음, 명예의 골짜기에 있는 라즈가르에게 가야 합니다.‡Atrapa un lucio furioso gigante en el Río Furia del Sur. El Río Furia del Sur puede encontrarse al exterior de la puerta oeste de Orgrimmar. Vuelve con Razgar en el Valle del Honor cuando lo hayas hecho.‡Atrapa un lucio furioso gigante en el Río Furia del Sur. El Río Furia del Sur puede encontrarse al exterior de la puerta oeste de Orgrimmar. Vuelve con Razgar en el Valle del Honor cuando lo hayas hecho.‡Pêchez un Brochet géant furieux dans la Furie-du-Sud. Ce fleuve coule juste devant la porte ouest d\'Orgrimmar. Revenez voir Razgar dans la Vallée de l\'Honneur quand vous aurez terminé.‡在怒水河中捕捉一条巨型狂怒之刺，怒水河就在奥格瑞玛西边的大门外。完成任务之后，向荣誉谷的纳兹加尔复命。‡在怒水河中釣取一隻巨型狂暴狗魚。怒水河就在奧格瑪西門的外面。完成之後，回榮譽谷找拉茲嘎爾。',
  }
},
[26589] = {
  {
    'As selvas de Feralas‡В дебрях Фераласа‡Die Wildnis von Feralas‡페랄라스 자생지‡Las tierras salvajes de Feralas‡Las tierras salvajes de Feralas‡Les étendues sauvages de Féralas‡菲拉斯的荒野‡菲拉斯的荒野',
    nil,
    'Vá até Feralas e fale com Konu Runa Totem na Aldeia Ataya.‡Отправляйтесь в Фералас и поговорите с Кону Руническим Тотемом в лагере Атайа.‡Reist nach Feralas und sprecht mit Konu Runentotem in Camp Ataya.‡페랄라스로 가서 아타야 야영지에 있는 코누 룬토템과 대화해야 합니다.‡Viaja hasta Feralas y habla con Konu Tótem de Runa en el Campamento Ataya.‡Viaja hasta Feralas y habla con Konu Tótem de Runa en el Campamento Ataya.‡Allez en Féralas et parlez à Konu Totem-runique, au Camp Ataya.‡到菲拉斯去跟阿塔亚营地的努·符文图腾谈一谈。‡到菲拉斯的阿塔亞營地和寇奴•符文圖騰談話。',
  }
},
[26590] = {
  {
    'A água benta da limpidez‡Святая вода ясности‡Das heilige Wasser der Klarheit‡청명의 성수‡El agua bendita de la claridad‡El agua bendita de la claridad‡L\'eau bénite de clarté‡澄澈圣水‡明晰聖水',
    nil,
    'Consiga a Água Benta da Limpidez do Olho-d\'água Nek\'mani no Cabo do Espinhaço.‡Добудьте святую воду ясности из родника Нек\'Мани, расположенного на мысе Тернистой долины.‡Schöpft das heilige Wasser der Klarheit aus dem Nek\'maniquellbrunnen Wellspring am Kap des Schlingendorntals.‡가시덤불 곶의 네크마니 수원지에서 청명의 성수를 획득해야 합니다.‡Consigue el agua bendita de claridad en el Manantial Nek\'mani, en El Cabo de Tuercespina.‡Consigue el agua bendita de claridad en el Manantial Nek\'mani, en El Cabo de Tuercespina.‡Procurez-vous l’Eau bénite de clarté puisée dans la Fontaine des Nek\'mani, au Cap Strangleronce.‡从荆棘谷海角纳克迈尼圣泉里打上澄澈圣水。‡從荊棘谷海角的納克邁尼聖泉取得明晰聖水。',
  }
},
[26591] = {
  {
    'Triagem no front‡Медобслуживание на передовой‡Rettung an vorderster Front‡전장의 치유사‡Selección en el frente‡Selección en el frente‡Le triage sur le front‡战地治疗‡前線搶治',
    nil,
    'Faça curativos em 10 Terranos Feridos.‡Окажите первую помощь 10 раненым земельникам.‡Versorgt 10 verletzte Irdene.‡부상당한 토석인 10명을 치료해야 합니다.‡Cura a 10 terráneos heridos.‡Cura a 10 terráneos heridos.‡Soignez 10 Terrestres blessés.‡包扎10名受伤的土灵。‡包紮10個受傷的土靈。',
  }
},
[26592] = {
  {
    'Cromoscópio difratório‡Дифракционный хромоскоп‡Diffraktorisches Chromaskop‡회절 색채경‡Cromascopio difractario‡Cromascopio difractario‡Le chromatoscope à diffraction‡分示检色仪‡彩度繞射儀',
    nil,
    'Consiga um Rubi dos Vela Sangrenta e uma Safira dos Vela Sangrenta.‡Раздобудьте рубин Кровавого Паруса и сапфир Кровавого Паруса.‡Besorgt einen Blutsegelrubin und einen Blutsegelsaphir.‡붉은해적단 루비와 붉은해적단 사파이어를 획득해야 합니다.‡Obtén un rubí Velasangre y un zafiro Velasangre.‡Obtén un rubí Velasangre y un zafiro Velasangre.‡Obtenez un Rubis de la Voile sanglante et un Saphir de la Voile sanglante‡获得一颗血帆红宝石和一颗血帆蓝宝石。‡取得血帆紅寶石和血帆藍寶石各一顆。',
  }
},
[26593] = {
  {
    'Fazendo o Sacode tremer‡Напугать Трусишку‡Zitterhand Angst einjagen‡겁쟁이‡Asusta al Trémulo‡Asusta al Trémulo‡Il faut faire trembler le trembleur‡瑟瑟发抖的“病鬼”‡嚇唬病鬼',
    nil,
    'Obtenha 5 Miúdos de Gorila do Vale da Névoa dos Gorilas Anciãos do Vale da Névoa.‡Раздобудьте потроха 5 старых горилл Мглистой долины.‡Erhaltet 5 Nebeltalinnereien von alten Nebeltalgorillas.‡안개계곡고릴라 내장 5개를 모아야 합니다.‡Consigue 5 menudillos de Velo de Bruma de gorilas Velo de Bruma ancianos.‡Consigue 5 menudillos de Velo de Bruma de gorilas Velo de Bruma ancianos.‡Récupérez 5 Abats de Valbrume sur d’Anciens gorilles de Valbrume‡从老迈的薄雾谷猩猩身上获得5副薄雾谷猩猩的内脏。‡從老邁的迷霧谷猩猩身上取得5份迷霧谷猩猩的內臟。',
  }
},
[26594] = {
  {
    'Fale novamente com MacKinley‡Возвращение к Маккинли‡Rückkehr zu MacKinley‡맥킨리에게 돌아가기‡Regresa junto a MacKinley‡Regresa junto a MacKinley‡Il faut rendre à MacKinley ce qui est à MacKinley‡去找马克基雷‡向麥克基雷回報',
    nil,
    'Leve o Pagamento do Sacode para o MacKinley "Lobo do Mar".‡Отнесите плату Трусишки "Морскому волку" Маккинли.‡Bringt Zitterhands Bezahlung zu "Seewolf" MacKinley.‡"바다늑대" 맥킨리에게 겁쟁이 필립의 빚진 돈을 가져가야 합니다.‡Lleva el pago del Trémulo a "Lobo de Mar" MacKinley.‡Lleva el pago del Trémulo a "Lobo de Mar" MacKinley.‡Apportez le Paiement du Trembleur à MacKinley « Loup des Mers ».‡把菲利浦的还款带给“海狼”马克基雷。‡將病鬼的還款帶去給『海狼』麥克基雷。',
  }
},
[26595] = {
  {
    'Cobrança forçada‡Долг платежом красен‡Rien ne va plus - Nichts geht mehr‡빚 사냥꾼‡Matar y recaudar‡Matar y recaudar‡Recouvrement extrême‡催命债‡殺人討債',
    nil,
    'Pegue o Pé-de-clava do Maury, a Chave de Torque Ajustável do Fitzpingo e o Espelho Ornamentado de Ephram.‡Добудьте деревянную ногу Моури, гаечный ключ Фитцтютеля и драгоценное зеркало Эфрама.‡Besorgt Maurys Klumpfuß, Fitzpünktchens Drehmomentschlüssel mit Ratsche und Ephrams juwelenbesetzten Spiegel.‡마우리의 의족, 피츠티틀의 바퀴쐐기 토크렌치, 에프람의 보석 거울을 모아야 합니다.‡Obtén la pata de palo de Maury, la llave dinanométrica de aceleración de Fitztittle y el espejo con joyas de Ephram.‡Obtén la pata de palo de Maury, la llave dinanométrica de aceleración de Fitztittle y el espejo con joyas de Ephram.‡Emparez-vous du Pied bot de Maury, de la Clé dynamométrique à cliquet de Toupetiot et du Miroir orné de joyaux d’Ephram.‡拿到玛雷的畸形足、菲兹提特的棘轮扭矩扳手和艾芙兰的宝石镜。‡取得瑪雷的木腳、費茲提透的棘齒扭旋扳手和埃弗蘭的珠寶鑲飾鏡。',
  }
},
[26596] = {
  {
    'O chamado de Kalimdor‡Зов Калимдора‡Der Ruf von Kalimdor‡칼림도어의 부름‡La llamada de Kalimdor‡La llamada de Kalimdor‡L\'appel de Kalimdor‡卡利姆多的召唤‡卡林多的召喚',
    nil,
    'Entre no barco que vai da Angra do Butim à Vila Catraca. Chegando lá, fale com o Gasganete.‡Отправляйтесь на корабле из Пиратской Бухты в Кабестан, где вам следует поговорить с Газлоу.‡Nehmt das Schiff von Beutebucht nach Ratschet und sprecht dort mit Gazlowe.‡무법항에서 배를 타고 톱니항으로 간 다음, 가즈로와 대화해야 합니다.‡Viaja en barco desde Bahía del Botín hasta Trinquete y habla con Gazlowe.‡Viaja en barco desde Bahía del Botín hasta Trinquete y habla con Gazlowe.‡Prenez le navire à Baie-du-Butin pour rejoindre Cabestan, puis allez voir Gazleu.‡从藏宝海湾坐船去棘齿城，然后跟加兹鲁维谈一谈。‡從藏寶海灣搭船前往棘齒城，然後和加茲魯維談談。',
  }
},
[26597] = {
  {
    'Febre da Selva do Espinhaço‡Лихорадка Тернистой долины‡Schlingendornfieber‡가시덤불의 열병‡La fiebre de Tuercespina‡La fiebre de Tuercespina‡La fièvre de Strangleronce‡荆棘热‡荊棘谷熱疫',
    nil,
    'Procure o Mandingueiro Unbagwa e faça-o evocar Mokk, o Selvagem. Leve o Coração de Mokk para Fino Algazarro.‡Найдите знахаря Унбагву и попросите его вызвать Мокка Дикаря. Принесите сердце Мокка Фину Горемыку.‡Sucht Hexendoktor Unbagwa und lasst ihn Mokk den Wilden beschwören. Bringt das Herz von Mokk zu Fin Fizrackett.‡의술사 운바그와를 찾아 흉포한 모크를 불러내도록 해야 합니다. 핀 피즈라켓에게 모크의 심장을 가져가야 합니다.‡Busca al médico brujo Unbagwa y haz que invoque a Mokk el Salvaje. Lleva el corazón de Mokk a Fin Fizqueta.‡Busca al médico brujo Unbagwa y haz que invoque a Mokk el Salvaje. Lleva el corazón de Mokk a Fin Fizqueta.‡Cherchez le Féticheur Unbagwa pour qu\'il invoque Mokk le Sauvage. Apportez le Cœur de Mokk à Fin Bulboucan‡找到巫医安巴格瓦，让他召唤野蛮的莫克。把莫克的精华带给芬·菲兹拉克。‡找到巫醫安巴格瓦並要求他召喚出野人莫克，然後將野人莫克的心臟交給芬·菲茲拉克。',
  }
},
[26598] = {
  {
    'O Coração de Mokk‡Сердце Мокка‡Das Herz von Mokk‡모크의 심장‡El corazón de Mokk‡El corazón de Mokk‡Le cœur de Mokk‡莫克之心‡莫克的心臟',
    nil,
    'temp text 02 - log‡врем текст 02 – протокол‡temp text 02 - log‡임시 텍스트 02 - 요약‡temp text 02 - log‡temp text 02 - log‡temp text 02 - log‡temp text 02 - log‡暫時性文字02－記錄',
  }
},
[26599] = {
  {
    'O baú do capitão‡Сундук капитана‡Die Truhe des Kapitäns‡선장의 상자‡El cofre del Capitán‡El cofre del Capitán‡Le coffre du capitaine‡船长的箱子‡船長的箱子',
    nil,
    'Recupere o Baú do Smotts com Gorlash no Cabo do Espinhaço.‡Заберите сундук Смоттса у Горлаша на мысе Тернистой долины.‡Erhaltet Smotts\' Truhe von Gorlash am Schlingendornkap.‡가시덤불 곶에 있는 고를라쉬로부터 스모츠의 상자를 획득해야 합니다.‡Obtén el cofre de Smotts de Gorlash en El Cabo de Tuercespina.‡Obtén el cofre de Smotts de Gorlash en El Cabo de Tuercespina.‡Reprenez à Gorlash le Coffre de Smotts, au Cap Strangleronce.‡从荆棘谷海角的高拉什身上获得斯莫特的箱子。‡從荊棘谷海角的高拉什那裡取回斯莫特的箱子。',
  }
},
[26600] = {
  {
    'Um banquete de gigantes‡Великанское пиршество‡Ein riesiges Bankett‡거인의 만찬‡Un festín de gigante‡Un festín de gigante‡Les appâts gargantuesques‡巨人盛宴‡巨人的大餐',
    nil,
    'Compre uma Caixa de Carne de Quinta Categoria de Kelsey Yance e um Caixote de Xerez de Pupellyverbos de Aldo Isque.‡Купите ящик третьесортного мяса у Келси Янса и ящик портвейна "Пупелливербос" у Алкача Виски.‡Kauft eine Kiste mit Fleisch der Güteklasse E von Kelsey Yance und eine Kiste mit Pupellyverbos Portwein von Klein Whiskey.‡켈시 얀스와 위스키 슬림에게서 각각 5등급 고기 상자와 퍼플리버보스 포트 포도주 상자를 구입해야 합니다.‡Cómprale un cajón de carne de mala calidad a Kelsey Yance y un cajón de oporto Pupellyverbos a Whiskey el Delgado.‡Cómprale un cajón de carne de mala calidad a Kelsey Yance y un cajón de oporto Pupellyverbos a Whiskey el Delgado.‡Achetez une Caisse de viande de classe E à Kelsey Yance et une Caisse de porto Pupellyverbos à Whiskey Slim.‡从凯尔希·杨斯那儿买一箱E级肉品，从威士忌斯利姆那儿买一箱紫葡萄酒。‡從凱爾希·楊斯那裡購買一箱E級肉品，並從威士忌·狡黠那裡購買一箱紫葡萄酒。',
  }
},
[26601] = {
  {
    'Mok\'rash, o Cutelo‡Мок\'раш Колун‡Mok\'rash der Spalter‡큰망치 모크라쉬‡Mok\'rash el Acuchillador‡Mok\'rash el Acuchillador‡Mok\'rash le Fendeur‡切割者摩卡什‡『斬擊者』摩卡什',
    nil,
    'Mate Mok\'rash, o Cutelo, no Pontal de Janeiro.‡Убейте Мок\'раша на острове Жанейро.‡Tötet Mok\'rash den Spalter auf der Janeirospitze.‡자네이로 섬에서 큰망치 모크라쉬를 처치해야 합니다.‡Mata a Mok\'rash el Acuchillador en el Cayo de Janeiro.‡Mata a Mok\'rash el Acuchillador en el Cayo de Janeiro.‡Tuez Mok’rash le Fendeur au Cap Janeiro.‡杀掉尼罗哨站的切割者摩卡什。‡在加尼祿哨站殺死『斬擊者』摩卡什。',
  }
},
[26602] = {
  {
    'Um prato que se come muito‡Блюдо подается ящиками‡Riesenportionen erwünscht‡크면 클수록 맛있는 요리‡Un plato que se sirve a lo grande‡Un plato que se sirve a lo grande‡A servir énorme !‡君子报仇，量足就行‡巨大的一餐',
    nil,
    'Leve a Caixa Gigante de Comida de Gigante para o bote salva-vidas do Capitão Smotts. Depois, use-a para evocar e matar Negolash.‡Отнесите гигантский ящик еды для великанов в спасательную шлюпку капитана Смоттса, затем приманите с ее помощью Неголаша и убейте его.‡Legt die Riesenkiste Riesenessen in Captain Smotts\'Rettungsboot. Beschwört Negolash damit und tötet ihn.‡선장 스모츠의 구명정에 거인 식량이 담긴 거대 상자를 가져가 네골라쉬를 소환한 후에 처치해야 합니다.‡Lleva el cajón gigante de comida gigante al bote salvavidas del capitán Smotts y úsalo para invocar y matar a Negolash.‡Lleva el cajón gigante de comida gigante al bote salvavidas del capitán Smotts y úsalo para invocar y matar a Negolash.‡Apportez la Caisse géante de nourriture pour géant au Canot de sauvetage du capitaine Smotts, et utilisez-le pour attirer et tuer Negolash.‡将一巨箱巨人食品放到斯莫特船长的救生艇上，召来奈古拉什并把他杀掉。‡將裝著巨人食糧的巨大箱子帶去斯莫特船長的救生艇，然後用它召喚並殺死奈古拉什。',
  }
},
[26603] = {
  {
    'Mensagem na garrafa‡Послание в бутылке‡Flaschenpost‡병에 든 쪽지‡Mensaje en una botella‡Mensaje en una botella‡Le message dans la bouteille‡瓶中信‡瓶中信',
    nil,
    'Encontre a autora da mensagem na Ilha Jaguara, que fica no Cabo do Espinhaço.‡Найдите автора записки на острове Жагуаро в районе мыса Тернистой долины.‡Sucht den Schreiber der Nachricht auf der Insel Jaguero am Schlingendornkap.‡가시덤불 곶의 자구에로 섬에 있는 쪽지를 쓴 장본인을 찾아야 합니다.‡Encuentra al autor del mensaje en la Isla Jaguero en El Cabo de Tuercespina.‡Encuentra al autor del mensaje en la Isla Jaguero en El Cabo de Tuercespina.‡Trouvez l’auteur du message sur l\'Île aux Jagueros, au Cap Strangleronce.‡去荆棘谷海角加尼罗岛找到瓶中信的作者。‡在荊棘谷海角的哈圭羅島找出求救訊息的作者。',
  }
},
[26604] = {
  {
    'Protegendo vossa alteza real Manda-chuva‡Защита Ее Королевского величества Пубы‡Der Schutz ihrer königlichen Hoheit, Prinzessin Poobah‡공주 푸바를 보호하는 방법‡Protegiendo a su Alteza Real Poobah‡Protegiendo a su Alteza Real Poobah‡Au service de Son Altesse Royale, la princesse Poobah‡保护普巴尔公主殿下‡保衛王家公主普巴爾',
    nil,
    'Mate 5 Espreitadores Jaguara.‡Убейте 5 жагуаров.‡Tötet 5 Jagueropirscher.‡긴발톱 흑표범 5마리를 처치해야 합니다.‡Mata a 5 acechadores de Jaguero.‡Mata a 5 acechadores de Jaguero.‡Tuez 5 Traqueurs jagueros.‡杀死5只丛林猎豹。‡殺死5隻叢林獵豹。',
  }
},
[26605] = {
  {
    'Aquelas patas imundas‡Загребущие лапки‡Bahaarte Diebe‡내 소중한 아가들‡Sucias patitas‡Sucias patitas‡Les bagages de Son Altesse sont avancés‡脏兮兮的小爪子‡汙穢的小爪子',
    nil,
    'Recupere a Tiara da Manda-chuva, o Cetro da Manda-chuva, as Sapatilhas da Manda-chuva e o Diário da Manda-chuva que estão com os primatas da Ilha Jaguara.‡Заберите у обезьян острова Жагуаро тиару, скипетр, туфли и дневник Пубы.‡Sucht nach Poobahs Tiara, Poobahs Szepter, Poobahs Pantoffeln und Poobahs Tagebuch bei den Affen auf der Insel Jaguero.‡자구에로 섬의 원숭이들로부터 푸바의 티아라, 푸바의 홀, 푸바의 끌신, 푸바의 일기장을 획득해야 합니다.‡Obtén la tiara de Poobah, el cetro de Poobah, las zapatillas de Poobah y el diario de Poobah de los simios de la Isla Jaguero.‡Obtén la tiara de Poobah, el cetro de Poobah, las zapatillas de Poobah y el diario de Poobah de los simios de la Isla Jaguero.‡Reprenez la Tiare de Poobah, le Sceptre de Poobah, les Mules de Poobah et le Journal intime de Poobah aux singes de l\'Île aux Jagueros.‡从加尼罗岛的猿猴身上获得普巴尔的宝冠、普巴尔的节杖、普巴尔的便鞋和普巴尔的日记。‡從哈圭羅島上的猿猴手裡取回普巴爾的冠冕、普巴爾的權杖、普巴爾的軟靴和普巴爾的日記。',
  }
},
[26606] = {
  {
    'A morte de Mukla‡Гибель Муклы‡Muklas Ende‡무클라의 최후‡La muerte de Mukla‡La muerte de Mukla‡Dans la jungle, terrible jungle, le roi Mukla…‡穆克拉的倒下‡穆克拉的末日',
    nil,
    'Mate o Rei Mukla e pegue a Chave dos Grilhões.‡Убейте короля Муклу и заберите ключ от кандалов.‡Tötet König Mukla, findet den Fesselschlüssel.‡밀림의왕 무클라를 처치하고 족쇄 열쇠를 획득해야 합니다.‡Mata al rey Mukla y obtén la llave de los grilletes.‡Mata al rey Mukla y obtén la llave de los grilletes.‡Tuez le roi Mukla et prenez-lui la Clé des chaînes.‡杀死穆克拉王，获得镣铐钥匙。‡殺死穆克拉並取得鐐銬鑰匙。',
  }
},
[26607] = {
  {
    'Programado para matar‡Они первые пролили кровь‡Sie haben zuerst Blut vergossen‡누가 시작한 전쟁인가‡Ellos tiraron primero‡Ellos tiraron primero‡Ils ont fait couler le premier sang‡他们流下第一滴血‡第一滴血',
    nil,
    'Entregue os Pertences de Keeshan para John J. Keeshan na Taberna de Vila Plácida, que fica em Cristarrubra.‡Отнесите Джону Джею Кишану его имущество. Джон находится в таверне Приозерья, в Красногорье.‡Bringt Keeshans Habseligkeiten zu John J. Keeshan im Gasthaus von Seenhain im Rotkammgebirge.‡붉은마루 산맥의 호숫골 여관에 있는 존 J. 키샨에게 키샨의 소지품을 전달해야 합니다.‡Lleva las posesiones de Keeshan a John J. Keeshan en la posada de Villa del Lago en Crestagrana.‡Lleva las posesiones de Keeshan a John J. Keeshan en la posada de Villa del Lago en Crestagrana.‡Apportez les Possessions de Keeshan à John J. Keeshan, à l\'Auberge de Comté-du-Lac, dans les Carmines.‡将基沙恩的财物交给赤脊山湖畔镇旅店的约翰·J·基沙恩。‡將基沙恩的物品帶去赤脊山的湖畔鎮旅店給約翰·J·基沙恩。',
  }
},
[26608] = {
  {
    'Negociações terminadas‡Сорванные переговоры‡Abgebrochene Verhandlungen‡협상 결렬‡Negociaciones terminadas‡Negociaciones terminadas‡Des négociations rompues‡谈判中止‡談判終止',
    nil,
    'Fale com o Almirante Punhopétreo no Bastião Presa do Dragão, que fica no Planalto do Crepúsculo.‡Вернитесь к адмиралу Каменному Кулаку, который находится в море рядом с портом Драконьей Пасти на Сумеречном нагорье.‡Kehrt zu Admiral Steinfaust vor der Küste der Drachenmalfestung im Schattenhochland zurück.‡황혼의 고원의 용아귀 항구 근해에 있는 제독 스톤피스트에게 가야 합니다‡Vuelve con el almirante Puñopiedra, frente a la orilla del fuerte Faucedraco, en las Tierras Altas Crepusculares.‡Vuelve con el almirante Puñopiedra, frente a la orilla del fuerte Faucedraco, en las Tierras Altas Crepusculares.‡Retournez voir l\'Amiral Poing-de-pierre, au large du Port Gueule-de-dragon, dans les Hautes-terres du Crépuscule.‡回到暮光高地龙喉要塞岸边的石拳将军处。‡回到暮光高地的龍喉堡岸邊找石拳上將。',
  }
},
[26609] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡La Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Imediato Crazz quer que você cheque a enseada ao norte da Angra do Butim.‡Первый помощник Кразз попросил вас осмотреть залив на севере от Пиратской Бухты.‡Erster Maat Krazz will, dass Ihr die Bucht nördlich von Beutebucht überprüft.‡일등항해사 크래즈가 무법항 북쪽의 작은 만을 조사해 달라고 했습니다.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡Le Second Crazz veut que vous effectuiez une reconnaissance dans la crique située au nord de Baie-du-Butin.‡大副克拉兹要你侦查一下藏宝海湾北边的海滩。‡大副克拉茲要你去查看藏寶海灣北邊的小海灣。',
  }
},
[26610] = {
  {
    'Traição da Vela Sangrenta‡Вероломство пиратов Кровавого Паруса‡Blutsegelverrat‡붉은해적단의 음모‡Traición Velasangre‡Traición Velasangre‡La traîtrise de la Voile sanglante‡血帆的阴谋‡血帆叛亂',
    nil,
    'Relate suas descobertas para o Imediato Crazz na Angra do Butim.‡Доложите о своей находке первому помощнику Краззу в Пиратской Бухте.‡Meldet Eure Entdeckung dem Ersten Maat Krazz in Beutebucht.‡무법항에 있는 일등항해사 크래즈에게 당신이 발견한 것을 보고해야 합니다.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Retournez rendre compte de vos découvertes au Second Crazz à Baie-du-Butin.‡去向藏宝海湾的大副克拉兹报告你的发现。‡向藏寶海灣的大副克拉茲回報你的發現。',
  }
},
[26611] = {
  {
    'O barão precisa ser avisado‡Предупредить барона‡Der Baron muss davon erfahren‡남작이 알아야 할 사실‡Hay que avisar al Barón‡Hay que avisar al Barón‡Il faut en parler au baron‡必须警告大财主‡得讓大財主知道',
    nil,
    'Conte sobre o plano de ataque da Vela Sangrenta para o Barão Rezingada.‡Сообщите барону Ревилгазу о готовящемся нападении пиратов Кровавого Паруса.‡Berichtet Baron Revilgaz von den geplanten Blutsegelangriffen.‡붉은 해적단의 공격 계획을 남작 레빌가즈에게 보고해야 합니다.‡Informa al Barón Revilgaz del ataque planeado de los Velasangre.‡Informa al Barón Revilgaz del ataque planeado de los Velasangre.‡Informez le Baron Revilgaz des plans d’attaque de la Voile sanglante.‡向大财主里维加兹报告血帆的进攻计划。‡向大財主里維加茲報告血帆的攻擊計畫。',
  }
},
[26612] = {
  {
    'Detalhes do ataque‡На разведку‡Einzelheiten des Angriffs‡공격의 내막‡Detalles del ataque‡Detalles del ataque‡Les détails de l\'attaque‡进攻的细节‡攻擊行動細節',
    nil,
    'Mate 8 Lobos-do-mar da Vela Sangrenta e 8 Magos Anciãos da Vela Sangrenta. Pegue as Cartas de Navegação da Vela Sangrenta e as Ordens da Vela Sangrenta.‡Убейте 8 морских волков из шайки Кровавого Паруса и 8 старших волхвов из шайки Кровавого Паруса и раздобудьте секретные карты и приказы пиратов Кровавого Паруса.‡Tötet 8 Seebären der Blutsegelbukaniere und 8 Hochmagi der Blutsegelbukaniere und erbeutet die Blutsegelkarten und Blutsegelbefehle.‡붉은해적단원 8명과 붉은해적단 장로 8명을 처치하고 붉은해적단 해도와 붉은해적단 명령서를 획득해야 합니다.‡Mata a 8 lobos de mar Velasangre y a 8 magi viejos Velasangre. Recupera las cartas de navegación de los Velasangre y las órdenes de los Velasangre.‡Mata a 8 lobos de mar Velasangre y a 8 magi viejos Velasangre. Recupera las cartas de navegación de los Velasangre y las órdenes de los Velasangre.‡Tuez 8 Loups de mer de la Voile sanglante et 8 Anciens magi de la Voile sanglante puis emparez-vous des Cartes de la Voile sanglante et des Ordres de la Voile sanglante.‡消灭8名血帆水手和8名血帆大法师，把血帆海图和血帆的命令带回来。‡殺死8名血帆水手和8名血帆魔導師，然後帶回血帆海圖和血帆計畫書。',
  }
},
[26613] = {
  {
    'Levaram o rapé‡Понюшка табака‡Auf dem Schnupftabak‡코담배를 찾아서‡Tabaco rapé‡Tabaco rapé‡Le nez de l’affaire‡事关鼻烟‡鼻煙',
    nil,
    'O Dígui, na Angra do Butim, quer que você leve para ele 15 trouxinhas de Rapé.‡Диг из Пиратской Бухты хочет, чтобы вы принесли ему 15 понюшек табаку.‡Deeg in Beutebucht möchte, dass Ihr ihm 15 winzige Haufen Schnupftabak bringt.‡무법항에 있는 디그가 코담배 15개를 가져다 달라고 했습니다.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 montoncitos de tabaco.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 montoncitos de tabaco.‡Deeg, de Baie-du-Butin, veux que vous lui rapportiez 15 pincées de Tabac à priser.‡藏宝海湾的迪格要你给他带15撮鼻烟。‡藏寶海灣的迪格要求你帶給他15份鼻煙。',
  }
},
[26614] = {
  {
    'Fique de olho‡Смотри в оба‡Ein Auge offen halten‡잃어버린 눈‡¡Ojo!‡¡Ojo!‡Gardez l\'œil ouvert !‡找眼睛‡海盜的眼睛',
    nil,
    'Recupere o Olho do Dizzy dos Bucaneiros da Vela Sangrenta.‡Отнимите глаз Диззи у пиратов Кровавого Паруса.‡Besorgt Torkels Auge von den Blutsegelbukanieren.‡붉은해적단에게서 애꾸눈 디지의 눈을 되찾아야 합니다.‡Recupera el ojo de Dizzy de los Bucaneros Velasangre.‡Recupera el ojo de Dizzy de los Bucaneros Velasangre.‡Reprenez l’Œil de Dizzy aux Boucaniers de la Voile sanglante.‡从血帆海盗处夺回迪兹的眼睛。‡從血帆海盜那裡找回迪茲的眼睛。',
  }
},
[26616] = {
  {
    'Não acaba nunca‡Ни конца ни края‡Es ist nie vorbei‡끝나지 않는 전쟁‡No tiene fin‡No tiene fin‡Ça n’en finit pas‡战争不会结束‡沒完沒了',
    nil,
    'Leve a Barcaça do Keeshan para o Acampamento Lago Plácido, em Cristarrubra.‡Отправьтесь на лодке Кишана в Лагерь Безмолвия в Красногорье.‡Fahrt auf Keeshans Flussboot zum Immerruhlager im Rotkammgebirge.‡키샨의 배를 타고 붉은마루 산맥에 있는 영원고요 야영지로 가야 합니다.‡Coge el bote de río de Keeshan hasta el Campamento Sempiterno en Crestagrana.‡Coge el bote de río de Keeshan hasta el Campamento Sempiterno en Crestagrana.‡Prenez la Barque de Keeshan jusqu’au Camp Placide, dans les Carmines.‡乘坐基沙恩的小船前往赤脊山的止水湖营地。‡帶基沙恩的快艇到赤脊山的止水營地。',
  }
},
[26617] = {
  {
    'Um velho lobo do mar‡Старый пират‡Ein alter Seebär‡늙은 뱃사람‡Un viejo lobo de mar‡Un viejo lobo de mar‡Un vieux loup de mer‡一名老水手‡老海員',
    nil,
    'Leve a Moeda Gasta pelo Tempo para o Mestre de Frota Chifre do Mar na Angra do Butim.‡Покажите истертую монету командиру флота Морскому Рогу в Пиратской Бухте.‡Bringt die verwitterte Münze zu Flottenmeister Seehorn in Beutebucht.‡풍파에 낡은 동전을 무법항에 있는 함장 시혼에게 가져가야 합니다.‡Lleva la moneda deteriorada al maestro de flota Cuernomarino en la Bahía del botín.‡Lleva la moneda deteriorada por el tiempo al maestro de flota Cuernomarino en la Bahía del botín.‡Apportez la Pièce corrodée à l’Amiral Corne-de-Mer, à Baie-du-Butin.‡把饱经风霜的硬币带给藏宝海湾的舰队指挥官卡拉·海角。‡將經歷過風吹雨打的硬幣帶去藏寶海灣給艦隊指揮官海角。',
  }
},
[26618] = {
  {
    'Lobos nos nossos calcanhares‡Волки идут по пятам‡Wölfe sind uns auf den Fersen‡늑대의 위협‡Con los lobos en los talones‡Con los lobos en los talones‡Des loups aux trousses‡恶狼成群‡惡狼成群',
    nil,
    'Mate 12 Lobos Hediondos‡Убейте 12 лютых волков.‡Tötet 12 Terrorwölfe.‡광포한 늑대 12마리를 처치해야 합니다.‡Mata a 12 lobos temibles.‡Mata a 12 lobos temibles.‡Tuez 12 Loups redoutables‡杀死12头恐狼。‡殺死12隻恐狼。',
  }
},
[26619] = {
  {
    'Caminhando e lutando e seguindo a intuição‡Значит, ты за революцию?‡Ihr wollt also eine Revolution‡그대 혁명을 꿈꾸는가‡Dices que quieres una revolución‡Dices que quieres una revolución‡Révolution sur commande‡你说你想要一场革命‡你說想搞革命',
    nil,
    'Passe pelas linhas de frente no Porto Presa do Dragão e fale com Zaela.‡Проникните в порт Драконьей Пасти и поговорите с Зелой.‡Schleicht Euch hinter die Frontlinie am Hafen des Drachenmals und sprecht mit Zaela.‡용아귀 항구 최전선 너머로 들어가 잴라와 대화해야 합니다.‡Cuélate tras la primera línea en el puerto Faucedraco y habla con Zaela.‡Cuélate tras la primera línea en el puerto Faucedraco y habla con Zaela.‡Traversez la ligne de front au niveau du Port Gueule-de-dragon et entretenez-vous avec Zaela.‡溜过前线，去和龙喉哨站的扎伊拉谈谈。‡溜到龍喉港戰線後方找札伊拉說話。',
  }
},
[26620] = {
  {
    'Kebab Temperado de Lobo‡Пряные котлеты из волчатины‡Gewürzte Wolfkebabs‡양념 늑대 케밥‡Kebab de lobo sazonado‡Kebab de lobo sazonado‡Kébab de loup assaisonné‡干烤狼肉串‡烤狼肉串',
    nil,
    'Pegue 5 Picanhas de Lobo dos Lobos Hediondos.‡Добудьте 5 стейков из волчьей грудинки, убивая лютых волков.‡Sammelt 5 Wolfskronfleischsteaks von Terrorwölfen.‡그늘숲의 늑대를 사냥하여 늑대 치맛살 5점을 모아야 합니다.‡Reúne 5 filetes de falda de lobo de lobos temibles.‡Reúne 5 filetes de falda de lobo de lobos temibles.‡Récupérez 5 Steaks de hampe de loup sur des Loups redoutables.‡从恐狼身上获得5块狼肉硬肋排。‡從恐狼身上收集5份無骨狼肉條。',
  }
},
[26621] = {
  {
    'A revolta‡Восстание‡Aufstand‡봉기‡Insurrección‡Insurrección‡Insurrection‡起义‡起義',
    nil,
    'Dê armas para 3 Trabalhadores ou Mercadores Presa do Dragão, mate 10 Impositores Presa do Dragão e 4 Bruxos Presa do Dragão.‡Вооружите 3 рабочих или торговцев из клана Драконьей Пасти, а затем убейте 10 головорезов из клана Драконьей Пасти и 4 чернокнижника из клана Драконьей Пасти.‡Bewaffnet 3 Arbeiter oder Händler des Drachenmals und tötet 10 Vollstrecker des Drachenmals und 4 Hexenmeister des Drachenmals.‡용아귀 일꾼이나 상인 3명을 무장시키고, 용아귀 집행자 10명과 용아귀 흑마법사 4명을 처치해야 합니다.‡Arma a 3 trabajadores o mercaderes Faucedraco, luego mata a 10 déspotas Faucedraco y a 4 brujos Faucedraco.‡Arma a 3 trabajadores o mercaderes Faucedraco, luego mata a 10 agentes Faucedraco y a 4 brujos Faucedraco.‡Équipez 3 Ouvriers ou Marchands Gueules-de-dragon, puis tuez 10 Massacreurs gueules-de-dragon et 4 Démonistes gueules-de-dragon.‡武装3名龙喉工人或商人，然后消灭10名龙喉执行者和4名龙喉术士。‡武裝3個龍喉工人或龍喉商人，並殺死10個龍喉執行者和4個龍喉術士。',
  }
},
[26622] = {
  {
    'Morte a Mor\'ghor‡Смерть Мор\'гору!‡Tötet Mor\'ghor‡모르고르에게 죽음을‡Muerte a Mor\'ghor‡Muerte a Mor\'ghor‡Mort à Mor\'ghor‡莫格霍尔之死‡莫格之死',
    nil,
    'Mate o Chefe Guerreiro Mor\'ghor no Porto Presa do Dragão. Você ainda pode recrutar Mercadores e Trabalhadores Presa do Dragão para ajudarem você.‡Убейте вождя Мор\'гора в порту Драконьей Пасти. Вы можете попросить торговцев и рабочих Драконьей Пасти помочь вам в бою.‡Tötet Kriegshäuptling Mor\'ghor im Hafen des Drachenmals. Ihr könnt immer noch Händler und Arbeiter des Drachenmals rekrutieren. Sie werden Euch helfen.‡용아귀 항구에서 대족장 모르고르를 처치해야 합니다. 용아귀 상인이나 일꾼을 무장시켜 도움을 받을 수 있습니다.‡Mata al Jefe de Guerra Mor\'ghor en el Puerto Faucedraco. Todavía puedes reclutar a mercaderes y trabajadores Faucedraco para que te ayuden.‡Mata al Jefe de Guerra Mor\'ghor en el Puerto Faucedraco. Todavía puedes reclutar a mercaderes y trabajadores Faucedraco para que te ayuden.‡Tuez le Chef de guerre Mor\'ghor au Port Gueule-de-dragon. Vous pouvez encore recruter des Marchands et des Ouvriers gueules-de-dragon pour vous aider.‡杀死龙喉哨站的莫格霍尔酋长。你也可以征召龙喉商人和工人来帮助你。‡到龍喉港殺死大酋長莫格。你可以募集3個龍喉工人或龍喉商人幫助你。',
  }
},
[26623] = {
  {
    'Bolinhos de Caranguejo Crepuscular‡Темные пирожки с крабами‡Schwärzliche Krebsküchlein‡갈색 게살 케이크‡Los pasteles de cangrejo oscuro‡Los pasteles de cangrejo oscuro‡Les tourtes au crabe de la Pénombre‡黑蟹蛋糕‡黑蟹蛋糕',
    nil,
    'Pegue 6 Caroços Crepusculares de Venaracna.‡Добудьте 6 кусочков темного паучьего мяса ядовитых кругопрядов.‡Erbeutet 6 schwärzliche Klumpen von Giftweberspinnen.‡그물독거미에게서 거무스름한 덩어리 6개를 모아야 합니다.‡Reúne 6 trozos de carne oscura de telarácnidas venenosas.‡Reúne 6 trozos de carne oscura de telarácnidas venenosas.‡Récupérez 6 Chairs de crabe de la Pénombre sur des Araignées tisse-venin.‡从结网毒蜘蛛身上割下6块暗色肉块。‡從結網毒蜘蛛身上收集6份蜘蛛肉塊。',
  }
},
[26624] = {
  {
    'Entrando para os Vela Sangrenta‡Связи с Кровавым Парусом‡Auf Tuchfühlung mit den Blutsegeln‡붉은해적단에 들어가는 법‡Intimar con los Velasangre‡Intimar con los Velasangre‡Infiltration‡同血帆打交道‡血帆搏感情',
    nil,
    'Apresente-se ao Yancey Gradelha na cachoeira, ao norte da Angra do Butim.‡Поговорите с Йенси Гриллсеном у водопада к северу от Пиратской Бухты.‡Meldet Euch bei Yancey Grillsen am Wasserfall nördlich von Beutebucht.‡무법항 북쪽의 폭포에 있는 얀시 그릴슨에게 보고해야 합니다.‡Preséntate ante Yancey Grillsen en la cascada al norte de la Bahía del Botín.‡Preséntate ante Yancey Grillsen en la cascada al norte de la Bahía del Botín.‡Présentez-vous à Yancey Grillsen, à la chute d’eau au nord de Baie-du-Butin.‡去找藏宝海湾北部瀑布的扬希·格里尔森。‡到藏寶海灣北邊的瀑布向楊希•桂爾森報到。',
  }
},
[26625] = {
  {
    'Troggzor, o Aterrador‡Троггзор Терранатор‡Troggzor der Erdinator‡대지종결자 트로그조르‡Troggzor el Terrinator‡Troggzor el Terrinator‡Troggzor le Terreminator‡颤地者特罗格佐尔‡大地終結者特洛格佐爾',
    nil,
    'Pegue a Clava do Aterrador.‡Добудьте дубинку Терранатора.‡Erbeutet den Knüppel des Erdinators.‡대지종결자의 곤봉을 획득해야 합니다.‡Consigue la cayada del Terrinator.‡Consigue la cayada del Terrinator.‡Récupérez le Casse-tête de Terreminator.‡获得颤地者的木棍。‡取得大地終結者鬥棍。',
  }
},
[26626] = {
  {
    '‡У нас проблема‡Wir haben ein Problem‡‡Tenemos un problema‡‡Nous avons un problème‡‡',
    nil,
    '‡[Deprecated] Speak with Clay Mudaxle on the Fractured Front in Deepholm.‡Sprecht mit Klei Lehmachse an der Zerrissenen Front in Tiefenheim.‡‡Habla con Berilo Lodoeje en el Frente Fracturado en Infralar.‡‡Allez voir Argile Bourbessieu sur le Front Ravagé, dans le Tréfonds.‡‡',
  }
},
[26627] = {
  {
    'O eremita‡Отшельник‡Der Einsiedler‡은둔자‡El ermitaño‡El ermitaño‡L’ermite‡隐士‡隱士',
    nil,
    'Descubra quem está ocupando a torre no Refúgio dos Mendigos.‡Разыщите обитателей башни в Приюте Бродяги.‡Findet den Bewohner des Turms im Bettlerschlupfwinkel.‡부랑자 소굴의 탑에 머물고 있는 사람을 찾아야 합니다.‡Encuentra al morador de la torre en el Refugio del Mendigo.‡Encuentra al morador de la torre en el Refugio del Mendigo.‡Trouvez qui occupe la tour au Repaire des Mendiants‡找到乞丐鬼屋高塔里的居民。‡在乞丐鬼屋找到塔上的居民。',
  }
},
[26628] = {
  {
    'A morte vem das profundezas‡Смерть со дна морского‡Tod von unten‡나가의 공격‡Muerte desde abajo‡Muerte desde abajo‡La mort venue d\'en bas‡水下伏兵‡水下伏兵',
    nil,
    'Proteja o Juanka Nabrava durante o ataque.‡Защитите Мураша О\'Брина во время атаки.‡Beschützt Wank O\'Breen während des Angriffs.‡나가의 공격으로부터 셰익스 오브린을 보호해야 합니다.‡Protege a Temblores O\'Breen durante el ataque.‡Protege a Temblores O\'Breen durante el ataque.‡Protégez Shakes O’Breen pendant l’attaque.‡保卫沙克斯·奥布里的安全。‡在納迦攻擊期間保護沙克斯‧奧布里。',
  }
},
[26629] = {
  {
    'Teste de lealdade‡Вопрос лояльности‡Feststellung Eurer Loyalität‡충성의 증명‡¿A quién eres leal?‡¿A quién eres leal?‡Comment se payer la tête d’un amiral ?‡看你忠于谁了‡忠誠所在',
    nil,
    'Pegue a Cabeça do Mestre de Frota Chifre do Mar na Angra do Butim.‡Добудьте голову командира флота Морского Рога.‡Besorgt den Kopf von Flottenmeister Seehorn in Beutebucht.‡무법항에 있는 함장 시혼의 머리카락을 획득해야 합니다.‡Obtén la cabeza del maestro de flota Cuernomarino en la Bahía del Botín.‡Obtén la cabeza del maestro de flota Cuernomarino en la Bahía del Botín.‡Procurez-vous la Tête de l\'amiral Corne-de-Mer, à Baie-du-Butin.‡获得藏宝海湾舰队指挥官卡拉·海角的牛头。‡在藏寶海灣取得艦隊指揮官海角的頭。',
  }
},
[26630] = {
  {
    'Me parece um tauren pirata‡Вполне похоже на таурена-пирата‡Sieht doch wie ein Taurenpirat aus‡내 눈엔 타우렌 해적‡A mí me recuerda a un tauren pirata‡A mí me recuerda a un tauren pirata‡Le pirate est un peu vache‡我觉得挺像个牛头人海盗‡貌似個牛頭海盜',
    nil,
    'Consiga uma Cabeça de Vaca e um Chapéu de Pirata Enorme. Depois, leve-os de volta para o Mestre de Frota Chifre do Mar.‡Раздобудьте коровью голову и огромную пиратскую шляпу, а затем отнесите их командиру флота Морскому Рогу.‡Besorgt einen Kuhkopf und einen übergroßen Piratenhut. Bringt beides zu Flottenmeister Seehorn.‡소머리 털과 특대 해적 모자를 구해, 함장 시혼에게 가져가야 합니다.‡Obtén una cabeza de vaca y un sombrero pirata sobredimensionado. Vuelve a llevárselos al maestro de flota Cuernomarino.‡Obtén una cabeza de vaca y un sombrero pirata sobredimensionado. Vuelve a llevárselos al maestro de flota Cuernomarino.‡Procurez-vous une Tête de vache et un Chapeau de pirate surdimensionné puis rapportez-les à l’Amiral Corne-de-Mer.‡获得一只牛头和一顶特大号的海盗帽，然后把它们带给舰队指挥官卡拉·海角。‡取得牛頭和特大海賊帽，然後帶回去給艦隊指揮官海角。',
  }
},
[26631] = {
  {
    'O primeiro dia do pirata‡Пират-новичок‡Euer erster Tag als Pirat‡해적이 된 첫날‡Tu primer día como pirata‡Tu primer día como pirata‡Le bleu marin‡海盗生涯的第一天‡海盜生涯的第一天',
    nil,
    'Leve os Seus Papéis para o Capitão Querena.‡Покажите свои бумаги капитану Кильвателю.‡Bringt Käpt\'n Kielhol Eure Papiere.‡선장 킬홀에게 적절한 서류를 가져가야 합니다.‡Lleva tus papeles al capitán Sinquilla.‡Lleva tus papeles al capitán Sinquilla.‡Apportez Vos papiers au Capitaine Soulaquille.‡把你的文书交给尼哈鲁船长。‡將你的文件帶去給尼哈魯船長。',
  }
},
[26632] = {
  {
    'Acompanhando de perto‡Сопровождение‡Geleitschutz‡근접 호위‡Escolta intensiva‡Escolta intensiva‡Escorte rapprochée‡贴身保护‡親自護送',
    nil,
    'Escolte a Catapulta Terrana até a Vila Pedragulha.‡Доставьте катапульту земельников в целости и сохранности в Шлаковый зал.‡Geleitet das Katapult des Irdenen Rings sicher nach Nadelfelsbruch.‡대지 투석기를 가시바위 잔여지까지 안전하게 호위해야 합니다.‡Escolta y protege la catapulta terránea hasta la Fosa Rocaguja.‡Escolta y protege la catapulta terránea hasta la Fosa Rocaguja.‡Escortez et protégez la Catapulte terrestre jusqu’à Scories-de-Rochepointe.‡护送土灵投石车安全抵达针石熔渣场。‡將土靈投石車安全護送到針岩熔渣。',
  }
},
[26633] = {
  {
    'Entrei de gaiato no navio‡Обязанности уборщика‡Putzdienst‡갑판 닦기‡Turno de limpieza‡Turno de limpieza‡La corvée de pont‡水兵的职责‡刷甲板任務',
    nil,
    'Pegue o Esfregão do Grumete no convés do Rasgamar e mantenha o convés limpo por 2 minutos.‡Возьмите на палубе "Буруна" швабру юнги и мойте пол в течение 2 минут.‡Nehmt Euch einen Deckhelfermopp vom Deck der Springflut und haltet das Deck 2 Minuten lang sauber.‡격정의 파도호의 갑판에 있는 뱃사람 대걸레로 2분 동안 갑판을 깨끗하게 닦아야 합니다.‡Coge una mopa de Fregona en la cubierta de Las Mareas Vivas y mantén la cubierta limpia durante 2 minutos.‡Consigue una mopa de Fregona en la cubierta de Las Mareas Vivas y mantén la cubierta limpia durante 2 minutos.‡Prenez un lave-pont sur le pont du Courant, et briquez le pont durant 2 minutes.‡在斩浪号甲板上拿条水兵拖把，打扫2分钟。‡在驟潮號上撿起一個水兵的拖把，然後維持甲板的清潔2分鐘。',
  }
},
[26634] = {
  {
    'O fim de muitos piratas‡Бич пиратов‡Der Fluch vieler Piraten‡해적들의 고질병‡La perdición de más de un pirata‡La perdición de más de un pirata‡Le fléau des pirates‡海盗的病痛‡許多海盜的劫數',
    nil,
    'Obtenha 5 Punhados de Limas.‡Раздобудьте 5 бушелей лаймов.‡Besorgt 5 Scheffel Limonen.‡운향귤 5상자를 모아야 합니다.‡Obtén 5 celemines de limas.‡Obtén 5 celemines de limas.‡Récupérez 5 Boisseaux de citron vert.‡获得5捧酸橘。‡取得5斗的萊姆。',
  }
},
[26635] = {
  {
    'Afunda como bala de canhão‡Ныряние за ядрами‡Schwimmen mit Kanonenkugeln‡포탄 줍기‡A por bolas de cañón‡A por bolas de cañón‡Il nage comme un boulet‡炮弹泳‡砲彈游泳',
    nil,
    'Colete 6 Balas de Canhão da Vela Sangrenta dentro da água, na área abaixo do Rasgamar.‡Добудьте 6 пушечных ядер Кровавого Паруса из-под "Буруна".‡Bergt 6 Blutsegelkanonenkugeln aus dem Wasser unter der Springflut.‡격정의 파도호의 밑의 바닷속에서 붉은해적단 포탄 6개를 모아야 합니다.‡Obtén 6 bolas de cañón Velasangre del agua que hay bajo Las Mareas Vivas.‡Obtén 6 bolas de cañón Velasangre del agua que hay bajo Las Mareas Vivas.‡Récupérez 6 Boulets de canon de la Voile sanglante au fond de l’eau, sous le Courant.‡从斩浪号的水底收集6枚血帆炮弹。‡從斬浪號下方的水底取得6顆血帆砲彈。',
  }
},
[26636] = {
  {
    'Kit de campanha da Companhia Bravo: Camuflagem‡Полевой набор компании "Браво": Маскировка‡Marschgepäck der Kompanie Bravo: Tarnung‡불곰 중대 야전 장비: 위장 도구‡Paquete de campo de la Compañía Bravo: Camuflaje‡Paquete de campo de la Compañía Bravo: Camuflaje‡Le paquetage de la compagnie Bravo : le camouflage‡B连战斗工具：伪装‡第二連隊野戰包:軍事偽裝',
    nil,
    'Colete 5 Montes de Folhas e 5 pedaços de Fezes de Raposa.‡Соберите 5 охапок листьев и 5 кучек лисьих экскрементов.‡Sammelt 5 Blätterhaufen und 5 Portionen Fuchskot.‡나뭇잎 더미 5개와 여우 똥 5개를 수집해야 합니다.‡Reúne 5 montones de hojas y 5 muestras de caca de zorro.‡Reúne 5 montones de hojas y 5 muestras de caca de zorro.‡Récupérez 5 Piles de feuilles et 5 Crottes de renard.‡采集5堆树叶和5块狐狸粪便。‡收集5堆樹葉和5份狐狸排泄物。',
  }
},
[26637] = {
  {
    'Kit de campanha da Companhia Bravo: Clorofórmio‡Полевой набор компании "Браво": Хлороформ‡Marschgepäck der Kompanie Bravo: Chloroform‡불곰 중대 야전 장비: 마취제‡Paquete de campo de la Compañía Bravo: Cloroformo‡Paquete de campo de la Compañía Bravo: Cloroformo‡Le paquetage de la compagnie Bravo : du chloroforme‡B连战斗工具：麻醉剂‡第二連隊野戰包:麻醉藥',
    nil,
    'Colete 8 Glândulas de Moralodo.‡Соберите 8 гланд грязекопов.‡Sammelt 8 Matschwirblerdrüsen.‡오물치 분비선 8개를 수집해야 합니다.‡Reúne 8 glándulas de habitabosta.‡Reúne 8 glándulas de habitabosta.‡Récupérez 8 Glandes de marche-boue.‡收集8个泥浆鱼人的腺体。‡取得8份泥居魚腺體。',
  }
},
[26638] = {
  {
    'Caçando os caçadores‡Охота на охотников‡Jagd auf die Jäger‡사냥꾼 사냥‡Cazar a los cazadores‡Cazar a los cazadores‡La chasse aux chasseurs‡猎杀黑石猎人‡獵殺獵人',
    nil,
    'Mate 8 Caçadores Rocha Negra.‡Убейте 8 охотников из клана Черной горы.‡Tötet 8 Jäger des Schwarzfels.‡검은바위 사냥꾼 8마리를 처치해야 합니다.‡Mata a 8 cazadores Roca Negra.‡Mata a 8 cazadores Roca Negra.‡Tuez 8 Chasseurs rochenoires.‡干掉8名黑石猎人。‡殺死8名黑石獵人。',
  }
},
[26639] = {
  {
    'Ponto de Contato: Brubaker‡Информатор Сухопек‡Kontaktpunkt: Brubaker‡브루베이커 접촉‡Punto de contacto: Brubaker‡Punto de contacto: Brubaker‡Votre contact : Brubaker‡接头人：布鲁贝克‡聯繫目標:布魯貝克',
    nil,
    'Encontre Brubaker.‡Найдите Сухопека.‡Findet Brubaker.‡브루베이커를 찾아야 합니다.‡Encuentra a Brubaker.‡Encuentra a Brubaker.‡Trouvez Brubaker.‡找到布鲁贝克。‡找到布魯貝克。',
  }
},
[26640] = {
  {
    'Atrocidades indizíveis‡Немыслимые зверства‡Unaussprechliche Gräuel‡눈 뜨고 볼 수 없는 참상‡Atrocidades indescriptibles‡Atrocidades indescriptibles‡Des atrocités sans nom‡虐囚‡難以言喻的殘暴',
    nil,
    'Entregue o Relatório de Brubaker para John J. Keeshan no Acampamento Lago Plácido, que fica em Cristarrubra.‡Отнесите донесение Сухопека Джону Джею Кишану в Лагерь Безмолвия в Красногорье.‡Bringt Brubakers Report zu John J. Keeshan im Immerruhlager im Rotkammgebirge.‡브루베이커의 보고서를 붉은마루 산맥 영원고요 야영지에 있는 존 J. 키샨에게 전달해야 합니다.‡Entrega el informe de Brubaker a John J. Keeshan en el Campamento Sempiterno en Crestagrana.‡Entrega el informe de Brubaker a John J. Keeshan en el Campamento Sempiterno en Crestagrana.‡Apportez le Rapport de Brubaker à John J. Keeshan au Camp Placide, dans les Carmines.‡将布鲁贝克的报告带给赤脊山止水湖营地的约翰·J·基沙恩。‡將布魯貝克的報告帶去赤脊山的止水營地給約翰·J·基沙恩。',
  }
},
[26641] = {
  {
    'Não se faz uma omelete sem...‡Без яиц яичницу не сделаешь…‡Eiertanz‡쌀이 있어야 밥을 짓지...‡No se puede hacer una tortilla sin...‡No se puede hacer una tortilla sin...‡On ne fait pas d\'omelette…‡没材料怎么做煎蛋卷……‡煎蛋餅不能沒有...',
    nil,
    'Recolha 5 Ovos da Prole de Shadra em Agol\'watha.‡Соберите 5 яиц порождения Шадры в Агол\'вате.‡Besorgt 5 Eier der Shadrabrut aus Agol\'watha.‡아골와타에서 샤드라혈족 알 5개를 모아야 합니다.‡Reúne 5 huevos engendrados de Shadra en Agol\'watha.‡Reúne 5 huevos engendrados de Shadra en Agol\'watha.‡Collectez 5 Œufs de rejeton de Shadra à Agol’watha.‡在亚戈瓦萨采集5颗沙德拉之卵。‡從亞戈瓦薩收集5個幼生沙德拉卵。',
  }
},
[26642] = {
  {
    'A defesa dos Sertões‡Во спасение Степей.‡Erhaltung des Brachlands‡불모의 땅을 보호하라‡Preservar Los Baldíos‡Preservar Los Baldíos‡Protéger les Tarides‡保卫贫瘠之地‡保護貧瘠之地',
    nil,
    'Apresente-se a Kargal Chaga de Guerra no Posto Remoto, que fica nos Sertões Setentrionais.‡Отправьтесь с докладом к Каргалу Боевому Шраму на Дальнюю заставу, что в Северных Степях.‡Meldet Euch bei Kargal Schlachtnarbe in der Fernwacht im Nördlichen Brachland.‡북부 불모의 땅의 천리길 경비초소에 있는 카르갈 배틀스카에게 보고해야 합니다.‡Preséntate ante Kargal Marca de Guerra en la Avanzada del Puente en Los Baldíos del Norte.‡Preséntate ante Kargal Marca de Guerra en la Avanzada del Puente en Los Baldíos del Norte.‡Présentez-vous à Kargal Balafre-glorieuse au Poste de Guet-Lointain, dans les Tarides du Nord.‡去北贫瘠之地的前沿哨所，向那里的卡加尔·战痕报道。‡到北貧瘠之地的前沿哨所向卡加爾·戰痕回報。',
  }
},
[26643] = {
  {
    'Dieta de fome‡На голодном пайке‡Hungerdiät‡절식 요법‡Dieta de inanición‡Dieta de inanición‡Régime forcé‡禁食‡飢餓食譜',
    nil,
    'Destrua 6 Vítimas Encasuladas nas Ruínas Assustadoras.‡Уничтожьте 6 оплетенных жертв в Ползучих руинах.‡Zerstört 6 eingesponnene Opfer in den Gruselruinen.‡굼벵이 폐허에서 고치가 된 희생자 6명을 처리해야 합니다.‡Acaba con 6 víctimas encerradas en Las Ruinas Abyectas.‡Acaba con 6 víctimas encerradas en Las Ruinas Abyectas.‡Détruisez 6 Victimes enfermées dans un cocon dans les Ruines aux Rampants.‡在爬虫废墟消灭6名茧缚受害者。‡到爬蟲廢墟消滅6個繭縛的受害者。',
  }
},
[26644] = {
  {
    'Chamando atenção‡Новые горизонты‡Aufmerksamkeit erregen‡끌리는 제안‡Llamar la atención‡Llamar la atención‡Promotion éclair‡吸引注意力‡引起注意',
    nil,
    'Fale com o Mestre de Frota Firalião no Véu Carmesim, que está no Cabo do Espinhaço.‡Отправляйтесь к командиру флота Фираллону на "Кровавую завесу", швартующуюся у мыса Тернистой долины.‡Meldet Euch bei Flottenmeister Firallon im Inneren der Purpurschleier am Schlingendornkap.‡가시덤불 곶의 주홍빛 장막호에 있는 함장 피랠론에게 보고해야 합니다.‡Preséntate ante el maestro de flota Firallon en el Velo Carmesí, en El Cabo de Tuercespina.‡Preséntate ante el maestro de flota Firallon en el Velo Carmesí, en El Cabo de Tuercespina.‡Présentez-vous à l’Amiral Firallon à bord de la Voile cramoisie, au Cap Strangleronce.‡去找荆棘谷海角红雾号的舰队指挥官菲尔拉伦。‡到荊棘谷海角的赤紅之霧裡向艦隊指揮官菲爾拉倫回報。',
  }
},
[26645] = {
  {
    'A Vigília Noturna‡Ночной Дозор‡Die Nachtwache‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡La garde des Veilleurs‡守夜人‡守夜人',
    nil,
    'Abata 8 Horrores Putrefatos nos arredores do Antro da Maria Cega, a sudeste da Vila Sombria.‡Убейте 8 гниющих ужасов возле фермы Слепой Мэри, что к юго-востоку от Темнолесья.‡Tötet 8 verrottende Schrecken nahe dem Spukhaus der blinden Mary, südöstlich von Dunkelhain.‡어둠골 남동쪽에 있는 눈먼 메리의 흉가에서 썩어가는 좀비 8마리를 처치해야 합니다.‡Mata a 8 horrores en podredumbre cerca del Refugio de Mary la ciega, al sureste de Villa Oscura.‡Mata a 8 horrores en podredumbre cerca del Refugio de Mary la ciega, al sureste de Villa Oscura.‡Tuez 8 Horreurs pourrissantes près de la maison hantée de Marie l’Aveugle, au sud-est de Sombre-Comté.‡在夜色镇东南的盲眼玛丽的鬼屋外消灭8具恐怖骸骨。‡在夜色鎮東南方的盲眼瑪麗鬼屋附近殺死8名腐爛的恐怖殭屍。',
  }
},
[26646] = {
  {
    'Prisioneiros de guerra‡Военнопленные‡Kriegsgefangene‡전쟁 포로 구출‡Prisioneros de guerra‡Prisioneros de guerra‡Les prisonniers de guerre‡战俘‡戰俘',
    nil,
    'Liberte os Prisioneiros de Guerra trancados na prisão no Vale dos Laceradores.‡Освободите военнопленных, запертых в клетке в долине Ренда.‡Befreit die Kriegsgefangenen, die im Gefängnis von Renders Tal sitzen.‡약탈의 계곡에 갇혀 있는 전쟁 포로들을 구출해야 합니다.‡Libera a los prisioneros de guerra encerrados en la prisión del Valle de Render.‡Libera a los prisioneros de guerra encerrados en la prisión del Valle de Render.‡Libérez les Prisonniers de guerre enfermés dans la prison de la Vallée des Étripeurs.‡解救被关押在撕裂者山谷监狱里的战俘。‡釋放被鎖在撕裂者山谷監牢內的戰俘。',
  }
},
[26647] = {
  {
    'Velho Detona‡Пушка-старушка‡Dicke Emma‡낡아빠진 대포‡Viejo Explo‡Viejo Explo‡L’Vieux foudroyeur‡老滑膛‡老式火砲',
    nil,
    'Pratique tiro com o canhão. Acerte 5 tiros no Tico Graveto usando o Velho Detona.‡Научитесь стрелять из пушки и 5 раз попадите ядром в изображение Веселого Тимми.‡Übt die Benutzung der Kanone, indem Ihr Timmy Grinsezweig mit 5 Kanonenkugeln von der Dicken Emma trefft.‡낡아빠진 대포로 포탄을 발사해 허수아비 과녁을 5번 맞춰야 합니다.‡Practica con el cañón disparándole 5 veces a Timmy Palitos el Sonriente con bolas de cañón del Viejo Explo.‡Practica con el cañón disparándole 5 veces a Timmy Palitos el Sonriente con bolas de cañón del Viejo Explo.‡Entraînez-vous à tirer au canon en touchant les Poteaux de Timmy le Jovial 5 fois avec les boulets du Vieux foudroyeur.‡使用老滑膛对着微笑假人开5炮练练手。‡以老式火砲的砲彈，練習用大砲擊中微笑提米假人5次。',
  }
},
[26648] = {
  {
    'Nossos inimigos mortais‡Наши смертельные враги‡Unsere Todfeinde‡철천지 원수‡Nuestros enemigos mortales‡Nuestros enemigos mortales‡Nos ennemis mortels‡我们的死敌‡我們的死敵',
    nil,
    'Mate 15 Ninjas na Ilha Jaguara.‡Убейте 15 ниндзя на острове Жагуаро.‡Tötet 15 Ninjas auf der Insel Jaguero.‡자구에로 섬에 있는 자객을 15명 처치해야 합니다.‡Mata a 15 ninjas en la Isla Jaguero.‡Mata a 15 ninjas en la Isla Jaguero.‡Tuez 15 Ninjas sur l\'île aux Jagueros.‡消灭哈圭罗岛的15名忍者。‡在哈圭羅島上殺死15名忍者。',
  }
},
[26649] = {
  {
    'Pirataria de passagem‡Черное золото‡Schießbudenpiraterie‡돈에 이끌려‡Piratería móvil‡Piratería móvil‡Opération « Tempête de la jungle »‡船头海战‡掠奪的衝動',
    nil,
    'Fale com o Remador da Vela Sangrenta do lado de fora do Véu Carmesim. Depois, use o canhão para matar 75 Petroleiros da Empreendimentos S.A.‡Сойдите с "Кровавой завесы" на берег, поговорите с гребцом из шайки Кровавого Паруса, а потом из пушки уничтожьте 75 нефтяников Торговой Компании.‡Sprecht mit dem Ruderer der Blutsegelbukaniere außerhalb der Purpurschleier und tötet dann 75 Ölarbeiter der Venture Co. mit der Kanone.‡주홍빛 장막호 밖에 있는 붉은해적단 노꾼과 대화하고, 대포를 이용해 투자개발회사 잡역부 75명을 처치해야 합니다.‡Habla con el remero Velasangre fuera del Velo Carmesí y usa el cañón para matar a 75 trabajadores del petróleo de Ventura y Cía.‡Habla con el remero Velasangre fuera del Velo Carmesí y usa el cañón para matar a 75 trabajadores del petróleo de Ventura y Cía.‡Quittez la Voile cramoisie et parlez au Rameur de la Voile sanglante, puis tirez au canon pour tuer 75 Ouvriers pétroliers de la KapitalRisk.‡跟红雾号外的血帆浆手谈一谈，然后用大炮消灭75名风险投资公司油井工人。‡在赤紅之霧外面和血帆划槳手說話，然後用砲彈殺死75名風險投資公司石油工人。',
  }
},
[26650] = {
  {
    'O Sorte da Donzela‡Госпожа Удача‡Die "Maid im Glück"‡아가씨의 행운호‡La Damisela Afortunada‡La Damisela Afortunada‡La Chance de la demoiselle‡少女之运号‡少女的好運號',
    nil,
    'Vá para a sua cabine do capitão no Sorte da Donzela, que está no Cabo do Espinhaço.‡Отправляйтесь в капитанскую каюту "Госпожи Удачи", стоящей у мыса Тернистой долины.‡Meldet Euch in Eurer Kapitänskajüte im Inneren der Maid im Glück am Schlingendornkap.‡가시덤불 곶의 아가씨의 행운호에 있는 선장실로 가야 합니다.‡Ve a tu Camarote de Capitán en La Damisela Afortunada, en El Cabo de Tuercespina.‡Ve a tu Camarote de Capitán en La Damisela Afortunada, en El Cabo de Tuercespina.‡Rendez-vous à votre cabine de capitaine, à bord de La Chance de la demoiselle, au Cap Strangleronce.‡到荆棘谷海角少女之运号你的船长室报到。‡到荊棘谷海角少女的好運號裡面的船長室報到。',
  }
},
[26651] = {
  {
    'Para vencer a guerra, torne-se a guerra‡Чтобы выиграть войну, нужно ею стать‡Um einen Krieg zu gewinnen, müsst Ihr zum Krieg werden‡전쟁에서 승리하려면, 전쟁의 화신이 되어라‡Si quieres sobrevivir a una guerra, conviértete en guerra‡Si quieres sobrevivir a una guerra, conviértete en guerra‡Pour survivre à la guerre, il faut devenir la guerre‡要赢得战争，就要比战争还残酷‡為求勝戰，毫不留情',
    nil,
    'Use o Kit de Campanha da Companhia Bravo para plantar uma Carga de Cequatrum na Torre Rocha Negra e na Cabana de Munições Rocha Negra.‡Воспользуйтесь полевым набором команды "Браво", чтобы заложить сефориевый заряд в башню и в склад снаряжения Черной горы.‡Bringt mit dem Marschgepäck der Kompanie Bravo je eine Zephyriumladung am Turm des Schwarzfels und an der Munitionshütte des Schwarzfels an.‡불곰 중대 야전 장비를 사용하여 검은바위 탑과 검은바위 군수품 오두막에 시포리움 폭약을 설치해야 합니다.‡Usa el paquete de campo de la Compañía Bravo para colocar una carga de seforio en la Torre Roca Negra y en la cabaña del arsenal de Roca Negra.‡Usa el paquete de campo de la Compañía Bravo para colocar una carga de seforio en la Torre Roca Negra y en la cabaña del arsenal de Roca Negra.‡Utilisez le Paquetage de la compagnie Bravo pour placer une Charge d’hydroglycérine dans la Tour rochenoire et la Hutte à munitions rochenoire.‡使用B连战斗工具，在黑石塔楼和黑石军需营帐旁各安放一枚爆盐炸弹。‡使用第二連隊野戰包將爆鹽炸彈安裝在黑石哨塔和黑石軍火存放小屋上。',
  }
},
[26652] = {
  {
    'Linha de Cabelo de Fantasma‡Нить из призрачных волос‡Geisterhaarfaden‡유령의 머리 가닥‡Hilo de cabello de fantasma‡Hilo de cabello de fantasma‡La mèche de cheveux fantômes‡幽灵的发丝‡鬼魂的髮絲',
    nil,
    'Leve o Pente Espectral para a Maria Cega.‡Отнесите Слепой Мэри призрачный гребень.‡Bringt den spektralen Kamm zur blinden Mary.‡눈먼 메리에게 유령의 빗을 가져가야 합니다.‡Lleva el peine espectral a Mary la Ciega.‡Lleva el peine espectral a Mary la Ciega.‡Apportez le Peigne spectral à Marie l\'Aveugle.‡把鬼梳带给盲眼玛丽。‡把鬼靈之梳帶給盲眼瑪麗。',
  }
},
[26653] = {
  {
    'Fio de cabelo‡Припасы из Темнолесья‡Lieferung aus Dunkelhain‡어둠골에서 입수할 묘한 물건‡Suministros de Villa Oscura‡Suministros de Villa Oscura‡Les denrées de Sombre-Comté‡夜色镇的补给‡來自夜色鎮的補給',
    nil,
    'Fale com Madame Eva na Vila Sombria.‡Поговорите с мадам Евой в Темнолесье.‡Sprecht mit Madame Eva in Dunkelhain.‡어둠골에 있는 에바 부인과 대화해야 합니다.‡Habla con Lady Eva en Villa Oscura.‡Habla con Lady Eva en Villa Oscura.‡Parlez à Madame Eva à Sombre-Comté.‡跟夜色镇的伊瓦夫人谈一谈。‡和夜色鎮裡的伊娃夫人談話。',
  }
},
[26654] = {
  {
    'Devolva o pente‡Гребень для Евы‡Rückkehr mit dem Kamm‡유령의 빗 돌려주기‡Devuelve el peine‡Devuelve el peine‡Le retour du peigne‡归还梳子‡歸還梳子',
    nil,
    'Leve o Pente de Fantasma para Madame Eva na Vila Sombria.‡Верните гребень для призрачных волос мадам Еве в Темнолесье.‡Bringt den Geisterhaarkamm zu Madame Eva nach Dunkelhain.‡어둠골에 있는 에바 부인에게 유령의 머리빗을 다시 가져가야 합니다.‡Lleva el peine de fantasma a Lady Eva a Villa Oscura.‡Lleva el peine de fantasma a Lady Eva a Villa Oscura.‡Rapportez le Peigne fantôme à Madame Eva, à Sombre-Comté.‡把幽灵的梳子还给夜色镇的伊瓦夫人。‡把鬼魂的梳子拿回去給夜色鎮的伊娃夫人。',
  }
},
[26655] = {
  {
    'Entregue a linha‡Доставка ниток‡Abliefern des Fadens‡머리 가닥 전달‡Devolver el pelo‡Devolver el pelo‡Filer livrer la mèche‡送交发丝‡幽靈的髮絲',
    nil,
    'Leve a Linha de Cabelo de Fantasma para Abercrombie, na torre dele no Refúgio dos Mendigos.‡Принесите Аберкромби нить из призрачных волос. Его можно найти в башне в Приюте Бродяги.‡Bringt den Geisterhaarfaden zu Calvinius in seinem Turm im Bettlerschlupfwinkel.‡부랑자 소굴의 탑에 있는 애버크롬비에게 유령의 머리 가닥을 가져가야 합니다.‡Lleva el hilo de cabello de fantasma a Abercrombie, a su torre del Refugio de los Mendigos.‡Lleva el hilo de cabello de fantasma a Abercrombie, a su torre del Refugio de los Mendigos.‡Apportez la Mèche de cheveux fantômes à Abercrombie, dans sa tour au Repaire des Mendiants.‡将幽灵的发丝交给乞丐鬼屋高塔里的亚伯克隆比。‡把鬼魂的髮絲交給亞伯克隆比，他就住在自己位於乞丐鬼屋的塔上。',
  }
},
[26656] = {
  {
    'Sempre em frente‡Только. Не. Останавливайся.‡Immer. In. Bewegung. Bleiben.‡절대. 멈추지. 마시오.‡No os paréis‡No paren.‡Restez. En. Mouvement.‡别·停·下‡別，停，下，來',
    nil,
    'Corra com pelo menos 5 Guardiões Opalescentes para fora do Alcândor Pálido, em direção ao leste, até o círculo de pedra próximo ao Trono de Therazane.‡Доставьте как минимум 5 опаловых стражей из Белого гнездовья на восток, к каменному кругу возле Трона Теразан.‡Hetzt mindestens 5 opalschimmernde Wächter nach Osten aus dem Bleichen Hort hinaus, zum Steinkreis in der Nähe von Therazanes Thron.‡으스름 보금자리에서 5마리 이상의 오팔색 수호자를 지상으로 몰고 동쪽으로 출발하여, 테라제인의 옥좌 근처 원형 돌 무더기로 가야 합니다.‡Dirige rápidamente a al menos 5 guardianes opalescentes hacia el este, fuera de El Nidal Pálido, hacia el círculo de piedra cerca del Trono de Therazane.‡Dirige rápidamente a al menos 5 guardianes opalescentes hacia el este, fuera de El Nidal Pálido, hacia el círculo de piedra cerca del Trono de Therazane.‡Amenez d’urgence au moins 5 Gardiens opalescents à l’est par la voie terrestre, hors du Perchoir Diaphane, jusqu\'au cercle de pierres près du Trône de Therazane.‡将至少5名乳石守护者从苍白栖地带到塞拉赞恩的王座附近的石环中。‡率領至少5個乳白守護者從蒼白棲息地衝向東方，抵達瑟拉贊恩王座附近的石環。',
  }
},
[26657] = {
  {
    'Caindo no duro‡Жесткое приземление‡Ein harter Fall‡추락‡Dura caída‡Dura caída‡Mauvaises chutes‡飞得高，摔得重‡應聲落地',
    nil,
    'Mate 6 Dracos de Pedra.‡Убейте 6 каменных драконов.‡Tötet 6 Steindrachen.‡바위 비룡 6마리를 처치해야 합니다.‡Mata a 6 dracos de piedra.‡Mata a 6 dracos de piedra.‡Tuez 6 Drakes de pierre.‡杀死6只石龙。‡殺死6隻石龍。',
  }
},
[26658] = {
  {
    'Valores frágeis‡Хрупкие ценности‡Zerbrechliche Werte‡망치를 찾아라‡Valores frágiles‡Valores frágiles‡Mazette, la massette !‡脆弱的价值‡脆弱的價值',
    nil,
    'Pegue uma Marreta Esculpida em Pedra.‡Найдите каменную киянку.‡Beschafft einen Mauerhammer.‡돌세공 나무망치를 회수해야 합니다.‡Recupera una marra de trabajo en piedra.‡Recupera una marra de trabajo en piedra.‡Récupérez une Massette ouvragée en pierre.‡拿到砌石槌。‡取得一支石造棒錘。',
  }
},
[26659] = {
  {
    'Golpe ressoante‡Резонирующий удар‡Nachhallender Schlag‡공명의 일격‡Golpe resonante‡Golpe resonante‡Un coup qui résonne‡共鸣一击‡共鳴之擊',
    nil,
    'Derrote Aeosera.‡Победите Эозеру.‡Besiegt Aeosera.‡애오세라를 처치해야 합니다.‡Derrota a Aeosera.‡Derrota a Aeosera.‡Tuez Aeosera.‡打败埃奥瑟拉。‡擊敗艾瑟拉。',
  }
},
[26660] = {
  {
    'Suco de zumbi‡Сок зомби‡Zombiesaft‡좀비 독주‡Zumo de zombi‡Zumo de zombi‡Le suc de zombie‡僵尸酒‡殭屍汁',
    nil,
    'Fale com o Taberneiro Oseias‡Поговорите с хозяином таверны Смиттсом.‡Sprecht mit Schankwart Smitts.‡선술집주인 스미츠와 대화해야 합니다.‡Habla con el tabernero Smitts.‡Habla con el tabernero Smitts.‡Parlez à Smitts l\'aubergiste.‡跟旅店老板斯密茨谈一谈。‡和旅店老闆史密茲談話。',
  }
},
[26661] = {
  {
    'Flores do mal‡Сбор цветков гнили‡Das Sammeln von Faulblüten‡썩은 꽃 모으기‡Busca flores podridas‡Busca flores podridas‡La cueillette de la putresciale‡收集腐败之花‡收集腐敗之花',
    nil,
    'Colha 5 Flores do Mal no Cemitério Jardins da Paz.‡Соберите 5 цветков гнили на Безмятежном кладбище.‡Sammelt 5 Fäulnisblüten auf dem Friedhof "Stille Gärten".‡고요의 정원 묘지에서 썩은 꽃 5송이를 모아야 합니다.‡Recoge 5 flores podridas del Cementerio del Jardín Sereno.‡Recoge 5 flores podridas del Cementerio del Jardín Sereno.‡Récoltez 5 Putresciales dans le Cimetière des Jardins paisibles.‡在静谧花园墓场收集5朵腐败之花。‡在靜謐花園墓場裡收集5朵腐敗之花。',
  }
},
[26662] = {
  {
    'A tripulação do Mareforte‡Крушащая волна‡Die Mannschaft der Trümmerflut‡난폭파도 해적단‡La Tripulación Fuertemarea‡La Tripulación Fuertemarea‡L\'équipe des Fiers-à-flot‡急浪船帮‡驟潮號船員',
    nil,
    'Fale com Long John Copper no Sorte da Donzela, com Shawn Stooker, o Gigante no Véu Carmesim e com Mary Smitts, a Uivadora no Rasgamar.‡Поговорите с долговязым Джоном Медяком на "Госпоже Удаче", громилой Шоном Стукером на "Кровавой завесе" и Плаксой Мэри Смиттс на "Буруне".‡Sprecht mit Long John Copper auf der Maid im Glück, Shawn Stooker dem Koloss auf der Purpurschleier und der klagenden Mary Smitts auf der Springflut.‡아가씨의 행운호의 꺽다리 존 코퍼, 주홍빛 장막호의 대인배 숀 스투커, 격정의 파도호의 늑대울음 메리 스미츠와 대화해야 합니다.‡Habla con John Copper el Largo en La Damisela Afortunada, con Shawn Stooker el Enorme en El Velo Carmesí y con Mary Smitts la Quejumbrosa en Las Mareas Vivas.‡Habla con John Copper el Largo en La Damisela Afortunada, con Shawn Stooker el Enorme en El Velo Carmesí y con Mary Smitts la Quejumbrosa en Las Mareas Vivas.‡Allez parler à Long John le Cuivré à bord de la Chance de la demoiselle, à l’Énorme Shawn Stooker à bord de la Voile cramoisie, et à Mary Smitts la Gémissante à bord du Courant.‡跟少女之运号上的长牙约翰·库珀、红雾号上的大块头肖恩·斯托克和斩浪号的狼嚎玛丽·史密斯谈一谈。‡和少女的好運號上的長腳約翰·庫伯、赤紅之霧號上罪大惡極的肖恩·史圖可，以及斬浪號上哀嚎的瑪麗·史密茲談話。',
  }
},
[26663] = {
  {
    'Traíra de água salgada‡Саботаж‡Versenkung aus dem Inneren‡내부의 자원‡Hundido desde dentro‡Hundido desde dentro‡L’ennemi intérieur‡内部沉船‡由內下沉',
    nil,
    'Sabote o Barril de Grogue, o Barril de Pólvora e a Caixa de Balas de Canhão.‡Уничтожьте бочонок грога, бочонок пороха и ящик пушечных ядер.‡Sabotiert das Fass mit Grog, das Fass mit Schießpulver und die Kiste mit Kanonenkugeln.‡그로그주 통, 화약 나무통, 그리고 포탄 상자를 파괴해야 합니다.‡Sabotea el barril de grog, el barril de pólvora y la caja de bolas de cañón.‡Sabotea el barril de grog, el barril de pólvora y la caja de bolas de cañón.‡Sabotez le Tonneau de rhum, le Tonneau de poudre à canon et la Caisse de boulets de canon.‡破坏酒桶、火药桶，以及炮弹箱。‡破壞烈酒桶，火藥桶，和砲彈箱。',
  }
},
[26664] = {
  {
    'Causando um motim‡Обвинение в мятеже‡Meutereimacher‡조작된 반란‡Amotinamiento‡Amotinamiento‡Mutin un jour, mutin toujours‡叛舰喋血‡誣陷叛變',
    nil,
    'Acuse 9 Corsários da Vela Sangrenta de motim. Depois, mate-os.‡Обвините 9 корсаров из шайки Кровавого Паруса в мятеже и убейте их.‡Beschuldigt 9 Korsaren der Blutsegel der Meuterei und tötet sie dann.‡붉은해적단 바다사냥꾼 9명을 고발한 후에, 처치해야 합니다.‡Acusa de amotinamiento a 9 corsarios Velasangre y, después, mátalos.‡Acusa de amotinamiento a 9 corsarios Velasangre y, después, mátalos.‡Accusez 9 Corsaires de la Voile sanglante de mutinerie, puis tuez-les.‡指控9名血帆海盗叛变，然后处死他们。‡指控9名血帆海盜造反，然後殺了他們。',
  }
},
[26665] = {
  {
    'O chamado do Butim‡Зов пиратов‡Der Ruf der Beute‡무법항의 부름‡La llamada del botín‡La llamada del botín‡L’appel du butin‡宝藏的召唤‡財寶時刻',
    nil,
    'Fale com o Barão Rezingada na Angra do Butim, que fica no Cabo do Espinhaço.‡Расскажите обо всем барону Ревилгазу в Пиратской Бухте у мыса Тернистой долины.‡Meldet Euch bei Baron Revilgaz in Beutebucht am Schlingendornkap.‡가시덤불 곶의 무법항에 있는 남작 레빌가즈에게 보고해야 합니다.‡Preséntate ante el Barón Revilgaz en la Bahía del Botín, en El Cabo de Tuercespina.‡Preséntate ante el Barón Revilgaz en la Bahía del Botín, en El Cabo de Tuercespina.‡Présentez-vous au Baron Revilgaz à Baie-du-Butin, au Cap Strangleronce.‡去找荆棘谷海角藏宝海湾的大财主里维加兹。‡到荊棘谷海角的藏寶海灣向大財主里維加茲回報。',
  }
},
[26666] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Procure o Tabelião Azambuja na Prefeitura de Vila Sombria.‡Найдите клерка Далтри в ратуше Темнолесья.‡Sucht Amtmann Daltry im Rathaus von Dunkelhain auf.‡어둠골 마을회관의 서기관 달트리를 찾아야 합니다.‡Busca al secretario Daltry en el Concejo de Villa Oscura.‡Busca al secretario Daltry en el Concejo de Villa Oscura.‡Cherchez le Greffier Daltry à l’Hôtel de ville de Sombre-Comté.‡去找夜色镇大厅的书记员达尔塔。‡在夜色鎮大廳裡找到書記員達爾塔。',
  }
},
[26667] = {
  {
    'As cartas roubadas‡Украденные письма‡Die gestohlenen Briefe‡도둑맞은 편지‡Las cartas robadas‡Las cartas robadas‡Les lettres volées‡被偷的信件‡失竊的信',
    nil,
    'Recupere o Maço de Cartas Destruídas no Bosque Brilhante.‡Соберите пачку изрезанных писем в Светлой роще.‡Findet das Bündel zerrissener Briefe in Schattenhain.‡밝은나무 숲에서 옆을 튼 편지 꾸러미를 입수해야 합니다.‡Recoge el fardo de cartas desgarradas en la Arboleda del Destello.‡Recoge el fardo de cartas desgarradas en la Arboleda del Destello.‡Retrouvez le Paquet de lettres déchirées dans le Bosquet de Clairbois.‡到阳光树林找到一捆被切碎的信件。‡從亮木樹林裡收集一綑撕裂的書信。',
  }
},
[26668] = {
  {
    'Detonação‡Мгновенный взрыв‡Detonation‡폭파‡Detonación‡Detonación‡Détonation‡引爆山谷‡引爆',
    nil,
    'Exploda o Vale dos Laceradores.‡Взорвите долину Ренда.‡Sprengt Renders Tal in die Luft.‡약탈의 계곡을 폭파해야 합니다.‡Vuela por los aires el Valle de Render.‡Vuela por los aires el Valle de Render.‡Faites sauter la Vallée des Étripeurs.‡引爆撕裂者山谷。‡炸毀撕裂者山谷。',
  }
},
[26669] = {
  {
    'Em uma esquina sombria‡В темном углу‡In einer dunklen Ecke‡어둠 속에 숨겨진 문서‡En una oscura esquina‡En una oscura esquina‡Dans un coin sombre‡黑暗的角落‡在黑暗的角落裡',
    nil,
    'Procure a Página de Diário Rasgada no Horto Pútrido.‡Обыщите Гниющий сад и найдите вырванную страницу дневника.‡Durchsucht den Verrottenden Obstgarten nach der zerrissenen Tagebuchseite.‡오염된 과수원에서 찢어진 일지 페이지를 찾아야 합니다.‡Busca una página de diario rota en El Vergel Pútrido.‡Busca una página de diario rota en El Vergel Pútrido.‡Cherchez les Pages arrachées du journal dans le Verger Pourrissant.‡在烂果园寻找一张被撕破的日记书页。‡在爛果園搜尋一張被撕破的日記書頁。',
  }
},
[26670] = {
  {
    'O Descanso de Rolando‡Погибель Роланда‡Rolands Verdammnis‡롤랜드 광산‡La condena de Roland‡La condena de Roland‡Au Destin de Roland‡罗兰之墓‡羅蘭之墓',
    nil,
    'Procure as outras páginas do Diário do Galvão no Descanso de Rolando.‡Обыщите Погибель Роланда и найдите оставшиеся страницы дневника Сталвана.‡Sucht in Rolands Verdammnis nach den restlichen Seiten von Stalvans Tagebuch.‡롤랜드 광산에서 스탈반의 일지에서 없어진 쪽을 찾아야 합니다.‡Busca las últimas páginas del diario de Stalvan en la Condena de Roland.‡Busca las últimas páginas del diario de Stalvan en la Condena de Roland.‡Fouillez le Destin de Roland pour retrouver les dernières pages du Journal de Stalvan.‡罗兰之墓寻找斯塔文日记的其他几页。‡搜索羅蘭之墓，找到斯塔文日誌的剩下幾頁。',
  }
},
[26671] = {
  {
    'O destino de Galvão Brumanto‡Судьба Сталвана Мистмантла‡Das Schicksal von Stalvan Dunstmantel‡스탈반 미스트맨틀의 운명‡El sino de Stalvan Mantoniebla‡El sino de Stalvan Mantoniebla‡Le destin de Stalvan Mantebrume‡斯塔文·密斯特曼托的命运‡斯塔文·密斯特曼托的命運',
    nil,
    'Entregue a Lenda de Galvão para Tobias Brumanto.‡Отнесите легенду о Сталване Тобиасу Мистмантлу.‡Bringt die Legende von Stalvan zurück zu Tobias Dunstmantel.‡토비아스 미스트맨틀에게 스탈반의 전설을 가져가야 합니다.‡Lleva La Leyenda de Stalvan a Tobias Mantoniebla.‡Lleva La Leyenda de Stalvan a Tobias Mantoniebla.‡Rapportez la Légende de Stalvan à Tobias Mantebrume.‡将斯塔文的传说交给托比亚斯·密斯特曼托。‡將斯塔文的傳說帶回去給托比亞斯·密斯特曼托。',
  }
},
[26672] = {
  {
    'Agarrando-se à verdade‡Узнать правду‡Der Wahrheit auf den Grund gehen‡상처뿐인 진실‡Desvelando la verdad‡Desvelando la verdad‡Il n’y a que la vérité qui blesse‡挖掘真相‡挖掘真相',
    nil,
    'Entregue o Anel da Família Brumanto para a Madame Eva.‡Отнесите фамильное кольцо Мистмантла мадам Еве.‡Bringt Madame Eva den Familienring der Dunstmantels.‡에바 부인에게 미스트맨틀 가문의 반지를 가져가야 합니다.‡Lleva el anillo de la familia Mantoniebla a Lady Eva.‡Lleva el anillo de la familia Mantoniebla a Lady Eva.‡Apportez l’Anneau familial des Mantebrume à Madame Eva.‡将密斯特曼托家族戒指交给伊瓦夫人。‡將密斯特曼托家族戒指帶給伊娃夫人。',
  }
},
[26673] = {
  {
    '‡‡REUSE - BREADCRUMB#‡‡‡‡‡‡',
    nil,
    '‡Отнесите фамильное кольцо Мистмантла мадам Еве.‡Bringt Madama Eva den Familienring der Dunstmantels.‡에바 부인에게 미스트맨틀 가문의 반지를 가져가야 합니다.‡Lleva el anillo de la familia Mantoniebla a Lady Eva.‡‡Apportez l\'Anneau familial des Mantebrume à Madame Eva.‡将密斯特曼托家族戒指交给伊瓦夫人。‡',
  }
},
[26674] = {
  {
    'A vingança de Brumanto‡Месть Мистмантла‡Dunstmantels Rache‡미스트맨틀의 복수‡La venganza de Mantoniebla‡La venganza de Mantoniebla‡La revanche de Mantebrume‡密斯特曼托的复仇‡密斯特曼托的復仇',
    nil,
    'Use o Anel da Família Brumanto no Casarão dos Brumanto, a leste da vila.‡Воспользуйтесь фамильным кольцом Мистмантла в поместье Мистмантла, к востоку от города.‡Benutzt den Familienring der Dunstmantels im Anwesen der Dunstmantels östlich der Stadt.‡마을 동쪽의 미스트맨틀 장원에서 미스트맨틀 가문의 반지를 사용해야 합니다.‡Utiliza el anillo de la familia Mantoniebla en la Mansión Mantoniebla, al este de la villa.‡Utiliza el anillo de la familia Mantoniebla en la Mansión Mantoniebla, al este de la villa.‡Utilisez l’Anneau familial des Mantebrume au Manoir Mantebrume, à l’est de la ville.‡在镇子东边的密斯特曼托庄园使用密斯特曼托家族戒指。‡在城鎮東邊的密斯特曼托莊園使用密斯特曼托家族戒指。',
  }
},
[26675] = {
  {
    'O valor da confiança‡Цена доверия‡Der Wert des Vertrauens‡The Value of Trust‡El valor de la confianza‡El valor de la confianza‡La valeur de la confiance‡信任的代价‡信任的價值',
    nil,
    nil,
  }
},
[26676] = {
  {
    'Alguém pediu um suco?‡Доставка сока‡Saftlieferung‡좀비 독주 배달‡Entrega de zumo‡Entrega de zumo‡La livraison de suc‡送酒‡送交殭屍汁',
    nil,
    'Leve o Suco de Zumbi para o Abercrombie no Refúgio dos Mendigos.‡Отнесите сок зомби в хижину Аберкромби, что в Приюте Бродяги.‡Bringt Calvinius den Zombiesaft im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 애버크롬비에게 좀비 독주를 가져가야 합니다.‡Lleva el zumo de zombi a Abercrombie al Refugio de los Mendigos.‡Lleva el zumo de zombi a Abercrombie al Refugio de los Mendigos.‡Apportez le Suc de zombie à Abercrombie au Repaire des Mendiants.‡把僵尸酒带给乞丐鬼屋的亚伯克隆比。‡把殭屍汁交給乞丐鬼屋裡的亞伯克隆比。',
  }
},
[26677] = {
  {
    'Boneco de carniçal‡Чучело вурдалака‡Ein Ghulbildnis‡구울 허수아비‡Un espantapájaros para necrófagos‡Un espantapájaros para necrófagos‡Le gouleyant épouvantail‡食尸鬼雕像‡食屍鬼假人',
    nil,
    'Pegue 7 Costelas de Carniçal dos Cadáveres Fétidos que vagam perto do Casarão dos Brumanto.‡Достаньте 7 ребер вурдалаков у зловонных трупов в поместье Мистмантла.‡Sammelt 7 Ghulrippen von Stinkenden Leichnamen auf dem Anwesen der Dunstmantels.‡미스트맨틀 장원의 악취나는 시체들에게서 구울 갈비뼈 7개를 모아야 합니다.‡Reúne 7 costillas de necrófago de cadáveres fétidos de la Mansión Mantoniebla.‡Reúne 7 costillas de necrófago de cadáveres fétidos de la Mansión Mantoniebla.‡Obtenez 7 Côtes de goule au Manoir Mantebrume.‡从密斯特曼托庄园的恶臭的食尸鬼身上收集7块食尸鬼的肋骨。‡從密斯特曼托莊園裡的惡臭的食屍鬼身上取得7根食屍鬼的肋骨。',
  }
},
[26678] = {
  {
    'Rumdumal‡Крепленый ром‡Doppelrum‡두배주‡Ron doble‡Ron doble‡Le double-rhum‡极烈朗姆酒‡雙份蘭姆酒',
    nil,
    'Encontre o Barril de Rumdumal do Barão Rezingada na Angra do Butim.‡Разыщите бочонок крепленого рома барона Ревилгаза в Пиратской Бухте.‡Findet Baron Revilgaz\' Fass mit Doppelrum in Beutebucht.‡무법항에 있는 남작 레빌가즈의 두배주 통을 찾아야 합니다.‡Encuentra el barril de ron doble del Barón Revilgaz en la Bahía del Botín.‡Encuentra el barril de ron doble del Barón Revilgaz en la Bahía del Botín.‡Trouvez le tonneau de double-rhum du baron Revilgaz à Baie-du-Butin.‡去藏宝海湾找大财主里维加兹的极烈朗姆酒。‡在藏寶海灣裡找到大財主里維加茲的雙份蘭姆酒。',
  }
},
[26679] = {
  {
    'Fale novamente com Rezingada‡Возвращение к Ревилгазу‡Kehrt zu Revilgaz zurück‡레빌가즈에게 돌아가기‡Regresa junto a Revilgaz‡Regresa junto a Revilgaz‡Le service du double-rhum‡去找里维加兹‡回訪里維加茲',
    nil,
    'Leve o Rumdumal para o Barão Rezingada na Angra do Butim.‡Доставьте крепленый ром барону Ревилгазу в Пиратскую Бухту.‡Bringt Baron Revilgaz in Beutebucht den Doppelrum.‡무법항에 있는 남작 레빌가즈에게 두배주를 가져가야 합니다.‡Lleva el ron doble al Barón Revilgaz en la Bahía del Botín.‡Lleva el ron doble al Barón Revilgaz en la Bahía del Botín.‡Apportez le Double-rhum au Baron Revilgaz, à Baie-du-butin.‡把极烈朗姆酒给藏宝海湾的里维加兹送去。‡將雙份蘭姆酒帶去給藏寶海灣的大財主里維加茲。',
  }
},
[26680] = {
  {
    'Ogro ladrão‡Нападение огров‡Ogerdiebe‡오우거 도적 떼‡Ladrones ogros‡Ladrones ogros‡Les ogres sont de sales voleurs‡食人魔小偷‡巨魔盜賊',
    nil,
    'Devolva o Caixote do Abercrombie para o Abercrombie.‡Верните ящик Аберкромби владельцу.‡Bringt Calvinius\' Kiste zu Calvinius.‡애버크롬비에게 애버크롬비의 상자를 돌려줘야 합니다.‡Devuelve a Abercrombie el cajón de Abercrombie.‡Devuelve a Abercrombie el cajón de Abercrombie.‡Rendez sa caisse à Abercrombie.‡把亚伯克隆比的箱子还给亚伯克隆比。‡把亞伯克隆比的木箱拿回來給他。',
  }
},
[26681] = {
  {
    'Carta ao alcaide‡Письмо для мэра‡Ein Brief für den Bürgermeister‡시장에게 보내는 편지‡Nota para el alcalde‡Nota para el alcalde‡La lettre au maire‡给镇长的信‡給鎮長的字條',
    nil,
    'Entregue a Carta para Malaquias Ebanez, Prefeito de Vila Sombria, a pedido de Abercrombie.‡Отнесите письмо Аберкромби мэру Темнолесья, Элло Чернодреву.‡Bringt Calvinius\' Brief zu Ello Schwarzhaupt, dem Bürgermeister von Dunkelhain.‡어둠골의 시장 엘로 이본로크 경에게 애버크롬비의 편지를 전해야 합니다.‡Lleva la carta de Abercrombie a Ello Cerranegro, el alcalde de Villa Oscura.‡Lleva la carta de Abercrombie a Ello Cerranegro, el alcalde de Villa Oscura.‡Apportez la Lettre d\'Abercrombie à Ello Bouclenoire, le maire de Sombre-Comté.‡将亚伯克隆比的信交给夜色镇的镇长艾尔罗·埃伯洛克。‡把亞伯克隆比的信交給夜色鎮的艾羅·埃伯洛克鎮長。',
  }
},
[26682] = {
  {
    'A ameaça rastejante‡Неуклюжая угроза‡Eine torkelnde Bedrohung‡수렁 괴물의 위협‡La amenaza que se arrastra‡La amenaza que se arrastra‡Une menace titubante‡蹒跚的威胁‡蹣跚漫步的威脅',
    nil,
    'Mate 7 Rastejantes Murchavinhas ou Coléricos Murchavinhas no pântano ao norte da Aldeia Muralha Verde.‡Уничтожьте 7 сухолистых ползунов или сухолистых яростеней в топи к северу от деревни Гиблотопь.‡Tötet 7 Moderrankenkrabbler oder Moderrankenwüteriche im Sumpf nördlich von Brackenwall.‡담쟁이 마을의 북쪽 습지대에서 시든덩굴 이끼괴물 또는 분노한 시든덩굴 늪괴물 7마리를 처치해야 합니다.‡Mata a 7 trepadores o furibundos Parramustia en el marjal al norte del Poblado Murohelecho.‡Mata a 7 trepadores o furibundos Parramustia en el marjal al norte del Poblado Murohelecho.‡Tuez 7 Rampants Fane-lianes ou Rageurs Fane-lianes, dans le marécage au nord de Mur-de-Fougères.‡在蕨墙村北部沼泽里杀死7名枯藤爬行者或枯藤狂暴者。‡在蕨牆村北邊的沼澤殺死枯藤蠕行者或枯藤狂怒者。',
  }
},
[26683] = {
  {
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Seht zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Un œil dans les étoiles‡眺望群星‡觀星',
    nil,
    'Encontre a Maria e convença-a a dar um espelho para o projeto do Vitório.‡Найдите Мэри и уговорите ее пожертвовать зеркало для проекта Виктора.‡Findet Mary und überredet sie, eine reflektierende Oberfläche für Viktoris Projekt abzugeben.‡메리를 찾아 빅토리의 작업에 반사면으로 사용할 거울을 빌려야 합니다.‡Localiza a Mary y convéncela de que te dé una superficie reflectora para el proyecto de Viktori.‡Localiza a Mary y convéncela de que te dé una superficie reflectora para el proyecto de Viktori.‡Trouvez Marie et persuadez-la de vous confier une surface réfléchissante pour le projet de Viktori.‡找到玛丽，说服她把反射面拿出来完成维克托尔的项目。‡找到瑪麗，說服她借給你一個反光鏡，用於維克托的計畫。',
  }
},
[26684] = {
  {
    'O carniçal insano‡Невменяемый вурдалак‡Der irrsinnige Ghul‡광기 어린 구울‡El necrófago demente‡El necrófago demente‡Le reflet de la goule‡疯狂的食尸鬼‡瘋狂的食屍鬼',
    nil,
    'Tome o Espelho de Maria do Carniçal Insano.‡Заберите зеркало Слепой Мэри у невменяемого вурдалака.‡Erbeutet Marys Handspiegel von dem irrsinnigen Ghul.‡광기 어린 구울에게서 메리의 거울을 되찾아야 합니다.‡Consigue el espejo de Mary del necrófago demente.‡Consigue el espejo de Mary del necrófago demente.‡Reprenez le Miroir de Marie à la Goule folle.‡从疯狂的食尸鬼手中拿回盲眼玛丽的眼镜。‡從瘋狂的食屍鬼那裡拿回盲眼瑪麗的鏡子。',
  }
},
[26685] = {
  {
    'Lente de classe‡Отличное стекло‡Feines Glas‡오우거의 외눈안경‡Un espejo elegante‡Un espejo elegante‡De la verrerie de luxe‡高级玻璃‡上等玻璃',
    nil,
    'Mate Zzarc\'Vul no morro ôgrico a sul da Floresta do Crepúsculo, e pegue o Monóculo do Ogro.‡Убейте огра Ззарк\'Вула, живущего в самом южном кургане Сумеречного леса и возьмите его монокль.‡Tötet Zzarc\'Vul auf dem südlichen Ogerhügel in Dämmerwald und erbeutet sein Ogermonokel.‡그늘숲 남쪽의 벌골 오우거 소굴에서 짜르크불을 처치하고 오우거의 외눈안경을 입수해야 합니다.‡Mata a Zzarc\'Vul en el túmulo ogro del Bosque del Ocaso y consigue el monóculo de ogro.‡Mata a Zzarc\'Vul en el túmulo ogro del Bosque del Ocaso y consigue el monóculo de ogro.‡Tuez Zzarc’Vul, dans le Tertre des ogres au sud du Bois de la Pénombre, et emparez-vous de son Monocle.‡杀掉暮色森林南部食人魔山里的扎克乌尔，取得食人魔的单片眼镜。‡前往暮色森林南部的巨魔土丘，殺死札克烏爾並取得他的單眼鏡片。',
  }
},
[26686] = {
  {
    'Ossos ambulantes‡Ходячие кости‡Wandelnde Knochen‡걸어 다니는 해골‡Huesos andantes‡Huesos andantes‡Les os qui marchent‡说话的骨头‡行走的骨骸',
    nil,
    'A Comandante Aldora Ebanez, da Vila Sombria, quer que você mate 5 Guerreiros Descarnados e 5 Magos Descarnados.‡Убейте 5 воинов-скелетов и 5 магов-скелетов по просьбе командира Алтеи Чернодрев.‡Kommandantin Althea Schwarzhaupt aus Dunkelhain möchte, dass ihr 5 Skelettkrieger und 5 Skelettmagier vernichtet.‡어둠골의 사령관 알시아 이본로크가 해골 전사 5마리와 해골 마법사 5마리를 처치해 달라고 했습니다.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 5 guerreros y a 5 magos esqueléticos.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 5 guerreros y a 5 magos esqueléticos.‡Le Commandant Althea Bouclenoire vous demande de tuer 5 Squelettes combattants et 5 Squelettes mages.‡夜色镇的指挥官阿尔泰娅·埃伯洛克要你消灭5具骷髅战士和5具骷髅法师。‡夜色鎮的指揮官奧爾希雅‧埃伯洛克希望你去殺死5名骷髏戰士和5名骷髏法師。',
  }
},
[26687] = {
  {
    'Reforços de Theramore‡Подкрепления из Терамора‡Verstärkung aus Theramore‡테라모어에서 온 증원군‡Refuerzos de Theramore‡Refuerzos de Theramore‡Les renforts de Theramore‡塞拉摩的援军‡塞拉摩的援軍',
    nil,
    'Siga para a Ilha Theramore no Pântano Vadeoso e fale com o Capitão Garrido Valente no quartel principal.‡Отправляйтесь на остров Терамор в Пылевые топи и поговорите с капитаном Гарраном Ваймсом.‡Reist zur Insel Theramore in den Düstermarschen und sprecht mit Hauptmann Garran Vimes in der Hauptkaserne.‡먼지진흙 습지대에 있는 테라모어 섬으로 가서 주 병영에 있는 사령관 개런 바임스와 대화해야 합니다.‡Viaja hasta la Isla de Theramore en el Marjal Revolcafango y habla con el capitán Garran Vimes en el cuartel general.‡Viaja hasta la Isla Theramore en el Marjal Revolcafango y habla con el capitán Garran Vimes en el cuartel general.‡Rendez-vous sur l’Île de Theramore, dans le Marécage d’Âprefange, et parlez au Capitaine Garran Vimaire dans la caserne principale.‡前往尘泥沼泽的塞拉摩岛，跟兵营的盖兰·维米斯队长谈一谈。‡到塵泥沼澤的塞拉摩島主軍營裡和蓋蘭‧維米斯上尉談談。',
  }
},
[26688] = {
  {
    'Worgen na floresta‡Воргены в лесу‡Worgen in den Wäldern‡숲 속의 늑대인간‡Huargen en el bosque‡Huargen en el bosque‡Des worgens dans les bois‡林子里的狼人‡森林裡的狼人',
    nil,
    'Mate 7 Worgens Nocturnos no Bosque Brilhante.‡Убейте 7 воргенов из стаи Ночной Погибели в Светлой роще.‡Tötet 7 Worgen der Nachtheuler im Schattenhain.‡밝은나무 숲에 있는 파멸어둠 늑대인간 7마리를 처치해야 합니다.‡Mata a 7 huargen Penumbría en la Arboleda del Destello.‡Mata a 7 huargen Penumbría en la Arboleda del Destello.‡Tuez 7 Worgens plaie-de-nuit dans le Bosquet de Clairbois‡在阳光树林里杀死7名夜行狼人。‡在亮木森林裡殺死7個夜行狼人。',
  }
},
[26689] = {
  {
    'O Horto Pútrido‡Гниющий сад‡Der Verrottende Obstgarten‡오염된 과수원‡El Vergel Pútrido‡El Vergel Pútrido‡Le verger Pourrissant‡烂果园‡爛果園',
    nil,
    'Mate 10 Tece-sombras Nocturnos no Horto Pútrido.‡Убейте 10 тенеткачей Ночной Погибели в Гниющем саду.‡Tötet 10 Schattenwirker der Nachtheuler im Verrottenden Obstgarten.‡오염된 과수원에 있는 파멸어둠 흑마술사 10마리를 처치해야 합니다.‡Mata a 10 tejesombras Penumbría en El Vergel Pútrido.‡Mata a 10 tejesombras Penumbría en El Vergel Pútrido.‡Tuez 10 Tisseurs d\'ombre plaie-de-nuit dans le Verger Pourrissant.‡在烂果园里杀掉10头夜行织影狼人。‡在爛果園殺死10名夜行織影狼人。',
  }
},
[26690] = {
  {
    'Torpes e maculados‡Ярые и Нечистые‡Faulig und besudelt‡송곳니투사와 타락전사‡Viles y corruptos‡Viles y corruptos‡Infects crocs‡邪齿和堕落‡邪惡而汙穢',
    nil,
    'Mate 8 Presas Torpes Nocturnos e 8 Maculados Nocturnos no Descanso de Rolando.‡Убейте 8 Ярых Клыков и 8 Нечистых Воргенов из стаи Ночной Погибели в Погибели Роланда.‡Tötet 8 Faulreißer der Nachtheuler und 8 besudelte Nachtheuler in Rolands Verdammnis.‡롤랜드 광산에 있는 파멸어둠 송곳니투사 8마리와 파멸어둠 타락전사 8마리를 처치해야 합니다.‡Mata a 8 Colmilloviles y a 8 corruptos Penumbría en la Condena de Roland.‡Mata a 8 Colmilloviles y a 8 corruptos Penumbría en la Condena de Roland.‡Tuez 8 Crocs noirs plaie-de-nuit et 8 Contaminés plaie-de-nuit dans le Destin de Roland.‡在罗兰之墓杀掉8头夜行邪齿狼人和8头夜行堕落狼人。‡在爛果園殺死8名夜行邪齒狼人和8名夜行墮落狼人。',
  }
},
[26691] = {
  {
    'Worgen na floresta‡Воргены в лесу‡Worgen in den Wäldern‡숲 속의 늑대인간‡Huargen en el bosque‡Huargen en el bosque‡Des worgens dans les bois‡林子里的狼人‡森林裡的狼人',
    nil,
    'Entregue o bilhete do Petrônio para João Carevino.‡Отнесите письмо Калора Джонатану Карвину.‡Bringt Calors Notiz zu Jonathan Treuwein.‡조나단 카레빈에게 칼로의 쪽지를 가져가야 합니다.‡Lleva la nota de Calor a Jonathan Carevin.‡Lleva la nota de Calor a Jonathan Carevin.‡Apportez la Lettre de Calor à Jonathan Carevin.‡将卡洛尔的便笺交给乔纳森·卡尔文。‡把卡洛爾的便箋交給喬納森·卡爾文。',
  }
},
[26692] = {
  {
    'Extinção dos Umbrapele‡Истребление Темношкуров‡Ausrottung der Schattenfelle‡잿빛가죽 일족 멸종‡Extinción de los Pielsombra‡Extinción de los Pielsombra‡L’extinction des Sombrepoils‡暗皮大灭绝‡滅絕影皮',
    nil,
    'Mate um total de 20 Gnolls Umbrapele.‡Убейте 20 любых гноллов из стаи Темношкуров.‡Tötet 20 beliebige Gnolle der Schattenfelle.‡잿빛가죽 놀 20마리를 처치해야 합니다.‡Mata a 20 gnolls Pielsombra de cualquier tipo.‡Mata a 20 gnolls Pielsombra de cualquier tipo.‡Tuez 20 Gnolls sombrepoils.‡击败20只暗皮豺狼人。‡殺死任意20名影皮豺狼人。',
  }
},
[26693] = {
  {
    'A Torre Negra‡Темная башня‡Der dunkle Turm‡어둠의 탑‡La torre oscura‡La torre oscura‡La tour sombre‡黑暗之塔‡暗之塔',
    nil,
    'Recupere a Chave de Ilgalar.‡Раздобудьте ключ от башни Илгалара.‡Erbeutet den Schlüssel von Ilgalar.‡일갈라의 열쇠를 회수해야 합니다.‡Consigue la llave de Ilgalar.‡Consigue la llave de Ilgalar.‡Récupérez la Clé d’Ilgalar.‡获得伊尔加拉之匙。‡取得伊爾加拉之鑰。',
  }
},
[26694] = {
  {
    'O grão-mago Doane‡Великий волхв Доан‡Der Großmagus Doane‡대학자 도운‡El gran mago Doane‡El gran mago Doane‡Le grand magus Doane‡大魔导师杜内‡大魔導師度恩',
    nil,
    'Mate o Grão-mago Doane.‡Убейте великого волхва Доана.‡Tötet Großmagus Doane.‡대학자 도운을 처치해야 합니다.‡Mata al gran mago Doane.‡Mata al gran mago Doane.‡Tuez le Grand magus Doane.‡杀死大魔导师杜内。‡殺死大魔導師度恩。',
  }
},
[26695] = {
  {
    'Preparar para decolar‡Приготовиться к взлету!‡Startvorbereitungen‡출항 준비‡Prepárate para despegar‡Prepárate para despegar‡L’arsenal de Narkk‡准备起飞‡準備起飛',
    nil,
    'Pegue as Bombas de Mão de Narkk na Capitania do Velho Porto, na Angra do Butim.‡Добудьте ручные гранаты Наркка в здании портовой инспекции в Пиратской Бухте.‡Besorgt Narkks Handbomben aus der Alten Hafenbehörde in Beutebucht.‡무법항의 구 항만공사에 있는 나르크의 손폭탄을 획득해야 합니다.‡Obtén las bombas de mano de Narkk de las Autoridades del Puerto Viejo en la Bahía del Botín.‡Obtén las bombas de mano de Narkk de las Autoridades del Puerto Viejo en la Bahía del Botín.‡Emparez-vous des Grenades à main de Narkk à l\'Ancienne capitainerie, à Baie-du-butin‡获得藏宝海湾港务局的纳尔克的手雷。‡從藏寶海灣裡的舊港務局取得納爾克的掌中雷。',
  }
},
[26696] = {
  {
    'O chamado de Kalimdor‡Зов Калимдора‡Der Ruf von Kalimdor‡칼림도어의 부름‡La llamada de Kalimdor‡La llamada de Kalimdor‡L\'appel de Kalimdor‡卡利姆多的召唤‡卡林多的召喚',
    nil,
    'Entre no barco que vai da Angra do Butim à Vila Catraca. Chegando lá, fale com o Gasganete.‡Отправляйтесь на корабле из Пиратской Бухты в Кабестан, где вам следует поговорить с Газлоу.‡Nehmt das Schiff von Beutebucht nach Ratschet und sprecht dort mit Gazlowe.‡무법항에서 배를 타고 톱니항으로 간 다음, 가즈로와 대화해야 합니다.‡Viaja en barco desde Bahía del Botín hasta Trinquete y habla con Gazlowe.‡Viaja en barco desde Bahía del Botín hasta Trinquete y habla con Gazlowe.‡Prenez le navire à Baie-du-Butin pour rejoindre Cabestan, puis allez voir Gazleu.‡从藏宝海湾坐船去棘齿城，然后跟加兹鲁维谈一谈。‡從藏寶海灣搭船前往棘齒城，然後和加茲魯維談談。',
  }
},
[26697] = {
  {
    'A jornada final dos Mareforte‡Последнее путешествие Крушащей Волны‡Die letzte Reise der Trümmerflutpiraten‡난폭파도 해적단 최후의 항해‡El viaje final de los Fuertemarea‡El viaje final de los Fuertemarea‡Le dernier voyage des Fiers-à-flot‡急浪的终航‡驟潮號最後的航程',
    nil,
    'Fale com Kebok na Angra do Butim para montar em uma Mantícora Audaz. Depois, use as bombas de mão para matar 85 Tripulantes Mareforte e destruir 6 Barcos de Assalto da Mareforte.‡Поговорите с Кебоком в Пиратской Бухте и попросите его посадить вас на смелого ветрокрыла. Затем при помощи гранат прикончите 85 матросов Крушащей Волны и потопите 6 боевых лодок Крушащей Волны.‡Sprecht mit Kebok in Beutebucht und schwingt Euch auf einen tapferen Windreiter. Tötet dann mit den Handbomben 85 Crewmitglieder der Trümmerflutpiraten und zerstört 6 Landungsboote der Trümmerflutpiraten.‡무법항의 케복에게 말을 걸어 용맹한 와이번을 타야 합니다. 그리고 손폭탄을 사용해 난폭파도 선원 85명을 처치하고 난폭파도 돌격선 6척을 파괴해야 합니다.‡Habla con Kebok en Bahía del Botín para subir a un jinete del viento audaz. Después utiliza las bombas de mano para matar a 85 tripulantes Fuertemarea y destruir 6 barcos de ataque Fuertemarea.‡Habla con Kebok en Bahía del Botín para subir a un jinete del viento audaz. Después utiliza las bombas de mano para matar a 85 tripulantes Fuertemarea y destruir 6 barcos de ataque Fuertemarea.‡Parlez à Kebok, à Baie-du-butin, pour emprunter un Coursier du vent intrépide. Ensuite, utilisez les grenades à main pour tuer 85 Matelots des Fiers-à-flot et détruire 6 Bateaux d\'attaque des Fiers-à-flot.‡跟藏宝海湾的科博克交谈，乘坐大胆的驭风者。然后用手雷消灭85名急浪船员并摧毁6艘急浪攻击艇。‡和藏寶海灣的科博克說話來登上勇敢的雙足飛龍。然後用手榴彈摧毀85個驟潮號船員和6艘驟潮攻擊船。',
  }
},
[26698] = {
  {
    'Procurando o Chifre do Mar‡В поисках Морского Рога‡Auf der Suche nach Seehorn‡시혼 찾기‡Buscando a Cuernomarino‡Buscando a Cuernomarino‡À la recherche de Corne-de-Mer‡寻找海角‡尋找海角',
    nil,
    'Fale com o Mestre de Frota Chifre do Mar na Angra do Butim.‡Поговорите с командиром флота Морским Рогом в Пиратской Бухте.‡Meldet Euch bei Flottenmeister Seehorn in Beutebucht.‡무법항에 있는 함장 시혼에게 보고해야 합니다.‡Preséntate ante el maestro de flota Cuernomarino en la Bahía del Botín.‡Preséntate ante el maestro de flota Cuernomarino en la Bahía del Botín.‡Retrouvez l’Amiral Corne-de-Mer, à Baie-du-butin.‡去找藏宝海湾的舰队指挥官卡拉·海角。‡到藏寶海灣向艦隊指揮官海角回報。',
  }
},
[26699] = {
  {
    'A virada da Mareforte‡Борьба с Крушащей Волной‡Die Abwehr der Trümmerflutpiraten‡난폭파도 해적단 몰아내기‡Cambiando el sentido de la marea‡Cambiando el sentido de la marea‡Les Fiers-à-flot à l’hallali‡逆转急浪‡扭轉驟潮',
    nil,
    'Mate 10 Saqueadores Mareforte na Angra do Butim.‡Убейте 10 представителей Крушащей Волны в Пиратской Бухте.‡Tötet 10 Räuber der Trümmerflutpiraten in Beutebucht.‡무법항에 있는 난폭파도 약탈꾼 10명을 처치해야 합니다.‡Mata a 10 asaltantes Fuertemarea en la Bahía del Botín.‡Mata a 10 asaltantes Fuertemarea en la Bahía del Botín.‡Tuez 10 Écumeurs des Fiers-à-flot, à Baie-du-butin.‡消灭10名藏宝海湾的急浪强夺者。‡在藏寶海灣裡殺死10名驟潮號劫掠者。',
  }
},
[26700] = {
  {
    'A (má) Sorte da Donzela‡Госпожа не-Удача‡Die Maid im (Un)Glück‡아가씨의 (빛바랜) 행운‡La Damisela Desafortunada‡La Damisela Desafortunada‡La Chance de la demoiselle tourne‡少女之（恶）运‡少女的好（壞的）運',
    nil,
    'Mate 8 Corsários da Vela Sangrenta na Angra do Butim.‡Убейте 8 корсаров из шайки Кровавого Паруса в Пиратской Бухте.‡Tötet 8 Korsaren der Blutsegelbukaniere in Beutebucht.‡무법항에 있는 붉은해적단 바다사냥꾼 8명을 처치해야 합니다.‡Mata a 8 corsarios Velasangre en la Bahía del Botín.‡Mata a 8 corsarios Velasangre en la Bahía del Botín.‡Tuez 8 Corsaires de la Voile sanglante, à Baie-du-butin.‡消灭8名藏宝海湾的血帆海盗。‡在藏寶海灣殺死8名血帆海盜。',
  }
},
[26701] = {
  {
    'Voo para a Muralha Verde‡Полет в Гиблотопь‡Flug nach Brackenwall‡담쟁이 마을로의 비행‡Vuelo a Murohelecho‡Vuelo a Murohelecho‡Un vol pour Mur-de-Fougères‡飞往蕨墙‡飛往蕨牆村',
    nil,
    'Fale com o Bragok na Vila Catraca para voar até a Aldeia Muralha Verde. Depois, fale com Krog.‡Обратитесь к Брагоку в Кабестане, чтобы перелететь в Гиблотопь. Затем явитесь к Крогу.‡Sprecht mit Bragok in Ratschet, um nach Brackenwall zu fliegen. Meldet Euch dann bei Krog.‡톱니항에 있는 브라고크와 대화해 담쟁이 마을로 날아가고 나서, 크로그에게 보고해야 합니다.‡Habla con Bragok en Trinquete para volar al Poblado Murohelecho y habla con Krog.‡Habla con Bragok en Trinquete para volar al Poblado Murohelecho y habla con Krog.‡Parlez à Bragok, à Cabestan, pour voler jusqu\'à Mur-de-Fougères. Puis présentez-vous à Krog.‡跟棘齿城的布拉高克谈一谈，飞往蕨墙村。然后去找克罗格。‡和棘齒城的布萊格談話以飛行到蕨牆村。然後找卡莉雅·哈斯丁報告。',
  }
},
[26702] = {
  {
    'Voo para Theramore‡Полет в Терамор‡Flug nach Theramore‡테라모어로의 비행‡Vuelo a Theramore‡Vuelo a Theramore‡Un vol pour Theramore‡飞往塞拉摩‡飛往塞拉摩',
    nil,
    'Fale com o Bragok na Vila Catraca para voar até Theramore. Depois, fale com Calia Hastings.‡Обратитесь к Брагоку в Кабестане, чтобы перелететь в Терамор. Затем явитесь к Калии Гастингс.‡Sprecht mit Bragok in Ratchet, um nach Theramore zu fliegen. Meldet Euch dann bei Calia Hastings.‡톱니항에 있는 브라고크와 대화해 테라모어로 날아가고 나서, 칼리아 헤이스팅스에게 보고해야 합니다.‡Habla con Bragok en Trinquete para volar a Theramore y habla con Calia Castilla.‡Habla con Bragok en Trinquete para volar a Theramore y habla con Calia Castilla.‡Parlez à Bragok, à Cabestan, pour voler jusqu\'à Theramore. Puis présentez-vous à Calia Hastings.‡跟棘齿城的布拉高克谈一谈，飞往塞拉摩。然后去找加莉亚·哈斯汀。‡和棘齒城的布萊格談話以飛行到塞拉摩。然後向卡莉雅·哈斯丁回報。',
  }
},
[26703] = {
  {
    'A derrota da Vela Sangrenta‡Конец Кровавому Парусу!‡Streicht die Blutsegel‡붉은해적단의 최후‡El fin de los Velasangre‡El fin de los Velasangre‡La fin de la Voile sanglante‡血帆的末日‡血帆的末日',
    nil,
    'Fale com Kebok na Angra do Butim para pegar uma Mantícora. Depois, mate o Mestre de Frota Firalião.‡Поговорите с Кебоком в Пиратской Бухте, получите ветрокрыла, а потом уничтожьте командира флота Фираллона.‡Sprecht mit Kebok in Beutebucht, lasst Euch einen Windreiter geben und tötet Flottenmeister Firallon.‡무법항의 케복에게 말을 걸어 와이번을 탄 후에, 함장 피랠론을 처치해야 합니다.‡Habla con Kebok en la Bahía del Botín para conseguir un jinete del viento. Después, mata al maestro de flota Firallon.‡Habla con Kebok en la Bahía del Botín para conseguir un jinete del viento. Después, mata al maestro de flota Firallon.‡Parlez à Kebok, à Baie-du-Butin, pour obtenir un coursier du vent, puis tuer l\'Amiral Firallon.‡跟藏宝海湾的科博克谈一谈，乘双足飞龙去杀掉舰队指挥官菲尔拉伦。‡和藏寶海灣的科博克說話以搭乘雙足翼龍，然後去殺死艦隊指揮官菲爾拉倫。',
  }
},
[26704] = {
  {
    '‡REUSE‡REUSE‡재사용‡REUSE‡‡REUSE‡REUSE‡再利用',
    nil,
    nil,
  }
},
[26705] = {
  {
    '‡‡Ein Verfolgerereignis in Instastadt!‡상자 마을 이벤트 추적‡‡‡‡‡',
    nil,
    nil,
  }
},
[26706] = {
  {
    'Fim de jogo‡Эндшпиль‡Endspiel‡마지막 작전‡Fin del juego‡Fin del juego‡Les dernières cartes‡最后的较量‡遊戲終盤',
    nil,
    'Quando o Tobias der o sinal, monte em um hipogrifo e destrua a Belonave da Horda.‡По сигналу Тобиаса оседлайте гиппогрифа и уничтожьте боевой корабль Орды.‡Springt auf einen Hippogryphen, wenn Tobias Euch das Zeichen dazu gibt, und zerstört das Kanonenboot der Horde.‡히포그리프를 타고 토비아스가 신호를 보내면 호드 비행포격선을 파괴해야 합니다.‡Móntate a un hipogrifo cuando Tobias te dé la señal y destruye la nave de guerra de la Horda.‡Móntate a un hipogrifo cuando Tobias te dé la señal y destruye la nave de guerra de la Horda.‡Sautez sur un Hippogriffe au moment où Tobias vous donne le signal, puis détruisez la Canonnière de la Horde.‡听从托比亚斯的号令跃上角鹰兽，摧毁部落炮艇。‡在托比亞斯放出信號時，乘上角鷹獸並摧毀部落砲艇。',
  }
},
[26707] = {
  {
    'Uma trepadeira mortal‡Смертоносная лоза‡Eine tödliche Rebe‡죽음의 풀‡La viña mortal‡La viña mortal‡Une funeste vigne‡致命的植物‡致命之藤',
    nil,
    'Colete 5 pedaços de Cadavéreas.‡Соберите 5 растений трупоросли.‡Sammelt 5 Stück Leichengras.‡시체풀 5포기를 채집해야 합니다.‡Recoge 5 ramas de hierbacadáver.‡Recoge 5 ramas de hierbacadáver.‡Rapportez 5 morceaux de charognelle.‡采集5根乱坟草。‡收集5份腐屍草。',
  }
},
[26708] = {
  {
    'AHHHHHHHHHHHH! AHHHHHHHHH!!!‡А-А-А-А-А-А-А!!! А-А-А-А-А!!!‡AHHHHHHHHHHHH! AHHHHHHHHH!!!‡아아아아아! 아아아아아!‡¡AAAAAAAAAAAAH! ¡¡¡AAAAAAAAAAH!!!‡¡AAAAAAAAAAAAH! ¡¡¡AAAAAAAAAAH!!!‡AHHHHHHHHHHHH ! AHHHHHHHHH !!!‡啊啊啊啊啊啊啊啊啊啊啊！啊啊啊啊啊啊啊啊啊！！！‡啊啊啊啊啊!啊啊啊啊!!!',
    nil,
    'Use o Tanque de Cerco da Companhia Bravo para matar 200 soldados Rocha Negra.‡Убейте 200 солдат Черной горы при помощи осадного танка команды "Браво".‡Tötet 200 Schwarzfelsorcs mit dem Belagerungspanzer der Kompanie Bravo.‡불곰 중대 공성 전차를 타고 검은바위 병사 200마리를 처치해야 합니다.‡Usa el tanque de asedio de la Compañía Bravo para matar a 200 soldados Roca Negra.‡Usa el tanque de asedio de la Compañía Bravo para matar a 200 soldados Roca Negra.‡Utilisez le Char de siège de la compagnie Bravo pour tuer 200 Soldats rochenoires.‡用B连攻城坦克消灭200个黑石士兵。‡用第二連隊攻城坦克殺死200名黑石士兵。',
  }
},
[26709] = {
  {
    'O trono de pedra‡Каменный трон‡Der Steinthron‡바위 옥좌‡El trono de piedra‡El trono de piedra‡Le trône de pierre‡石之王座‡石之王座',
    nil,
    'Procure Therazane no Trono de Therazane.‡Поговорите с Теразан у Трона Теразан.‡Sucht nach Therazane bei Therazanes Thron.‡테라제인의 옥좌에 있는 테라제인을 찾아가야 합니다.‡Busca a Therazane en el Trono de Therazane.‡Busca a Therazane en el Trono de Therazane.‡Allez voir Therazane au Trône de Therazane.‡去找塞拉赞恩的王座的塞拉赞恩。‡到瑟拉贊恩王座找瑟拉贊恩。',
  }
},
[26710] = {
  {
    'Perdido no abismo‡Потерявшийся в глубинах‡In den Tiefen verloren‡나 홀로 심연에‡Perdido en las profundidades‡Perdido en las profundidades‡Perdu dans les profondeurs‡迷失在深渊中‡深淵迷途',
    nil,
    'Encontre o Cascalho dentro dos Abismos Esfacelados e conduza-o para fora em segurança.‡Найдите Камешка в Гремящих глубинах и выведите его из туннелей в целости и сохранности.‡Findet Kieselchen in den Bruchtiefen und geleitet ihn sicher aus den Tunneln.‡무너지는 심연 안에서 돌돌이를 찾아 동굴 밖으로 안전하게 데리고 나와야 합니다.‡Encuentra a Guijarro en las Profundidades Desmoronadas y sácalo de los túneles sano y salvo.‡Encuentra a Guijarro en las Profundidades Desmoronadas y sácalo de los túneles sano y salvo.‡Trouvez Gravillon dans les Profondeurs Désagrégées et conduisez-le en lieu sûr hors des tunnels.‡在碎岩之渊中找到佩波，并带着他安全地离开隧道。‡在破碎深淵內找到小石岩並帶它安全地離開隧道。',
  }
},
[26711] = {
  {
    'Indo pro banco‡Сначала – в банк‡Ab zur Bank‡은행에서 마카롱 찾기‡Al banco‡Al banco‡Retrait bancaire‡前往银行‡準備上銀行',
    nil,
    'Fale com o Caixa do BCK no Banco Central de Kezan, em Kezan.‡Поговорите с кассиром Первого банка Кезана.‡Sprecht mit dem Kassierer der EBvK in der Ersten Bank von Kezan auf Kezan.‡케잔의 케잔 일등 은행에서 은행원과 대화해야 합니다.‡Habla con el cajero de PBK en el Primer Banco de Kezan, en Kezan.‡Habla con el cajero de PBK en el Primer Banco de Kezan, en Kezan.‡Parlez au Caissier de la BCK à la Banque Centrale de Kezan, sur Kezan.‡跟科赞岛上科赞第一银行的第一银行柜台员谈一谈。‡在凱贊的凱贊第一銀行和凱贊第一銀行行員談話。',
  }
},
[26712] = {
  {
    'Indo pro banco‡Сначала – в банк‡Ab zur Bank‡은행에서 마카롱 찾기‡Al banco‡Al banco‡Retrait bancaire‡前往银行‡準備上銀行',
    nil,
    'Fale com o Caixa do BCK no Banco Central de Kezan, em Kezan.‡Поговорите с кассиром Первого банка Кезана.‡Sprecht mit dem Kassierer der EBvK in der Ersten Bank von Kezan auf Kezan.‡케잔의 케잔 일등 은행에서 은행원과 대화해야 합니다.‡Habla con el cajero de PBK en el Primer Banco de Kezan, en Kezan.‡Habla con el cajero de PBK en el Primer Banco de Kezan, en Kezan.‡Parlez au Caissier de la BCK à la Banque Centrale de Kezan, sur Kezan.‡跟科赞岛上科赞第一银行的第一银行柜台员谈一谈。‡在凱贊的凱贊第一銀行和凱贊第一銀行行員談話。',
  }
},
[26713] = {
  {
    'Confronto final no Mirante de Pedra‡Решающее сражение в крепости Каменной Стражи‡Endkampf in Steinwacht‡돌망루 요새의 결전‡El momento decisivo en Petravista‡El momento decisivo en Petravista‡Confrontation à Guet-de-pierre‡决战石堡要塞‡石望決戰',
    nil,
    'Mate Tharil\'zun e Gath\'Ilzogg.‡Убейте Тарил\'зуна и Гат\'Илзогга.‡Tötet Tharil\'zun und Gath\'Ilzogg.‡타릴준과 가스일조그를 처치해야 합니다.‡Mata a Tharil\'zun y a Gath\'Ilzogg.‡Mata a Tharil\'zun y a Gath\'Ilzogg.‡Tuez Tharil’zun et Gath’Ilzogg.‡干掉萨瑞尔祖恩和加塞尔佐格。‡殺死薩瑞爾祖恩和加塞爾佐格。',
  }
},
[26714] = {
  {
    'Fulgor Negro, prole do Quebra-mundos‡Темное Пламя, потомок разрушителя миров‡Dunkelflamme, Brut des Weltenbrechers‡검은불꽃, 세계파괴자의 후손‡Llamaoscura, linaje del Rompemundos‡Llamaoscura, linaje del Rompemundos‡Sombrembrase, la progéniture du Brise-monde‡黑暗烈焰，灭世者的子嗣‡暗炎，碎界者一族',
    nil,
    'Use o Chifre de Evocação para chamar Fulgor Negro. Derrote Fulgor Negro.‡Воспользуйтесь рогом призыва, чтобы вызвать Темное Пламя, и победите его.‡Ruft Dunkelflamme mit dem Horn der Beschwörung. Besiegt Dunkelflamme.‡소환의 뿔피리를 사용하여 검은불꽃을 소환한 후 처치해야 합니다.‡Usa el cuerno de invocación para llamar a Llamaoscura. Derrota a Llamaoscura.‡Usa el cuerno de invocación para llamar a Llamaoscura. Derrota a Llamaoscura.‡Utilisez le Cor d’invocation pour invoquer Sombrembrase. Tuez Sombrembrase.‡使用召唤号角来召唤黑暗烈焰，并击败它。‡使用召喚號角叫出暗炎，然後擊敗暗炎。',
  }
},
[26715] = {
  {
    'Malfurion Stormrage‡Малфурион Ярость Бури‡Malfurion Sturmgrimm‡말퓨리온 스톰레이지‡Malfurion Tempestira‡Malfurion Tempestira‡Malfurion Hurlorage‡玛法里奥·怒风‡瑪法里恩·怒風',
    nil,
    'Speak to Malfurion Stormrage in the Temple of the Moon in Darnassus.‡Поговорите с Малфурионом Яростью Бури в храме Луны в Дарнасе.‡Sprecht mit Malfurion Sturmgrimm im Tempel des Mondes in Darnassus.‡다르나서스, 달의 신전에 있는 말퓨리온 스톰레이지와 대화해야 합니다.‡Habla con Malfurion Tempestira en el Templo de la Luna en Darnassus.‡Habla con Malfurion Tempestira en el Templo de la Luna en Darnassus.‡Allez voir Malfurion Hurlorage au Temple de la Lune, à Darnassus.‡跟达纳苏斯月神殿的玛法里奥·怒风谈一谈。‡到達納蘇斯的月神殿和瑪法里恩·怒風談話。',
  }
},
[26716] = {
  {
    '‡Конфиденциальный разговор‡Ein wenig Privatsphäre‡‡Un poco de privacidad‡‡Un peu d\'intimité‡‡',
    nil,
    '‡Придите на встречу с Малфурионом Яростью Бури в Храмовые сады в Дарнасе.‡Trefft Malfurion Sturmgrimm im Tempelgarten von Darnassus.‡‡Reúnete con Malfurion Tempestira en los Jardines del Templo en Darnassus.‡‡Allez voir Malfurion Hurlorage dans les Jardins du Temple, à Darnassus.‡‡',
  }
},
[26717] = {
  {
    'Noel, o worgen‡Ворген Йоргена‡Worgen auf Yorgen‡요르겐 늑대인간‡El huargen Yorgen‡El huargen Yorgen‡Le worgen de Yorgen‡约根狼人‡猶根狼人',
    nil,
    'Examine o Monte de Terra na Fazenda dos Figueira.‡Изучите кучу рыхлой земли в усадьбе Йоргена.‡Untersucht den Haufen lockerer Erde auf Yorgens Bauernhof.‡요르겐 농장의 푸석푸석한 흙더미를 살펴봐야 합니다.‡Examina el montón de tierra en La Hacienda de Yorgen.‡Examina el montón de tierra en La Hacienda de Yorgen.‡Examinez le Monticule de terre meuble à la Ferme des Yorgen.‡检查约根农场的一堆松散的泥土。‡在猶根農場檢驗鬆軟的泥土堆。',
  }
},
[26718] = {
  {
    'Breadcrumb to Badlands‡К Бесплодным землям‡Brotkrumen zum Ödland‡황야의 땅으로 가는 길‡Migajas en las Tierras inhóspitas‡Migajas en las Tierras inhóspitas‡Breadcrumb to Badlands‡荒芜之地的面包屑‡前往荒蕪之地的線索',
    nil,
    nil,
  }
},
[26719] = {
  {
    'Entrega para o Mestre Espargosa‡Доставка мастеру Харрису‡Lieferung an Meister Harris‡해리스에게 배달‡Entrega a Harris‡Entrega a Harris‡Une livraison pour maître Harris‡给哈里斯大师的货物‡送件給哈里斯大師',
    nil,
    'Entregue o Pacote de Cadavérea para Olívio Espargosa no Monte Corvo.‡Отнесите сверток с трупорослью Оливеру Харрису на Вороний Холм.‡Bringt Oliver Harris in Rabenflucht das Bündel Leichengras.‡까마귀 언덕의 올리버 해리스에게 시체풀 다발을 전달해야 합니다.‡Entrega el mantón de hierbacadáver a Oliver Harris en el Cerro del Cuervo.‡Entrega el mantón de hierbacadáver a Oliver Harris en el Cerro del Cuervo.‡Livrez la Botte de charognelle à Oliver Harris, à Colline-aux-corbeaux.‡将一捆乱坟草交给乌鸦岭的奥莉芙·哈里斯。‡將一綑腐屍草帶去烏鴉嶺給哈里斯大師。',
  }
},
[26720] = {
  {
    'Praga que pega‡Проклятие, которое не снять‡Ein Fluch, den wir nicht brechen können‡치료할 수 없는 저주‡Una maldición imposible de romper‡Una maldición imposible de romper‡L’immuable malédiction‡我们无法解除的诅咒‡無法移除的詛咒',
    nil,
    'Procure o Worgen Espreitador na Quinta dos Aguiar e use a Ampola de Espargosa para entorpecê-lo.‡Обыщите усадьбу Эддла, найдите крадущегося воргена и впрысните ему содержимое ампулы Харриса, чтобы усмирить его.‡Durchsucht Addles Siedlung nach dem lauernden Worgen und betäubt ihn mit Harris\' Ampulle.‡애들 농장에서 매복한 늑대인간을 찾은 후, 해리스의 주사병을 이용하여 진정시켜야 합니다.‡Busca al huargen acechante en la Granja de Addle y utiliza la pipeta de Harris para tranquilizarlo.‡Busca al huargen acechante en la Granja de Addle y utiliza la pipeta de Harris para tranquilizarlo.‡Fouillez la Ferme des Addle pour trouver le Worgen qui s’y cache et utilisez l’Ampoule de Harris pour le calmer.‡在腐草农场寻找潜伏的狼人，用哈瑞斯的针剂让他镇静下来。‡搜尋腐草農場，找到潛伏的狼人並使用哈里斯的注射藥劑瓶來使他鎮定。',
  }
},
[26721] = {
  {
    'Aracnofobia‡Реагенты для Трясунчика‡Bibbers Spinnen‡지터스의 부탁‡Bailarinas de ocho patas‡Bailarinas de ocho patas‡Les bestioles de La Tremblote‡基特斯的虫子‡基特斯蟲',
    nil,
    'Retire 8 Glândulas de Peçonha da Viúva Negra das Viúvas Negras.‡Добудьте 8 ядовитых желез черной вдовы.‡Erbeutet 8 Witwengiftbeutel von schwarzen Witwen.‡검은과부거미의 과부거미 독주머니 8개를 수집해야 합니다.‡Recoge 8 glándulas de veneno de viuda de las viudas negras.‡Recoge 8 glándulas de veneno de viuda de las viudas negras.‡Récupérez 8 Glandes à venin de veuve sur des Veuves noires.‡从黑寡妇蜘蛛身上收集8份寡妇蛛毒囊。‡從黑寡婦那裡收集8個寡婦毒囊。',
  }
},
[26722] = {
  {
    'Enterrado fundo‡Сокрытый под землей‡Tief vergraben‡여기 묻히다‡Bajo tierra‡Bajo tierra‡Les profondeurs de la terre‡深埋‡埋藏',
    nil,
    'Procure a Cimeira Forjada a Luz dentro do túnel sob as Catacumbas do Bosque da Aurora.‡Обыщите туннель под катакомбами Утреннего леса, чтобы найти рыцарский щит из светостали.‡Sucht im Tunnel unter den Katakomben des Morgenrotwaldes nach dem lichtgeschmiedeten Wappen.‡새벽숲 지하묘지 밑의 터널에서 빛으로 벼려낸 문장을 찾아야 합니다.‡Busca el blasón forjado con luz en el túnel que hay bajo las Catacumbas del Bosque Aurora.‡Busca el blasón forjado con luz en el túnel que hay bajo las Catacumbas del Bosque Aurora.‡Fouillez les tunnels sous les catacombes du Bois-de-l’aube à la recherche de l’Écu de Sancteforge.‡在晨光之林墓穴的通道里寻找光铸冠。‡搜尋黎明墓穴底下的甬道，取得光鑄羽冠。',
  }
},
[26723] = {
  {
    'O destino de Morbídio Vil‡Судьба Морбента Скверна‡Das Schicksal von Morbent Teufel‡모벤트 펠의 운명‡El destino de Morbent Vil‡El destino de Morbent Vil‡Le destin de Morbent Lagangrène‡摩本特·费尔的命运‡摩本特·費爾的命運',
    nil,
    'Procure por vestígios do Morbídio Vil no Morro dos Esquecidos.‡Найдите в Покинутой усадьбе что-нибудь, имеющее отношение к Морбенту Скверну.‡Sucht auf dem Verlassenen Gut nach Hinweisen auf Morbent Teufel.‡버려진 흉가에서 모벤트 펠의 흔적을 찾아야 합니다.‡Busca señales de Morbent Vil en la Loma Inhóspita.‡Busca señales de Morbent Vil en la Loma Inhóspita.‡Fouillez la Masure lugubre à la recherche de traces de Morbent Lagangrène‡在荒弃鬼屋寻找摩本特·费尔的踪迹。‡在荒棄鬼屋搜尋摩本特•費爾的跡象。',
  }
},
[26724] = {
  {
    'O lich espreitador‡Скрывающийся лич‡Der lauernde Lich‡숨어 있는 리치‡El exánime acechante‡El exánime acechante‡Le jeu de cache-liche‡潜藏的巫妖‡潛伏的巫妖',
    nil,
    'Fale com a Irmã Elsington.‡Поговорите с сестрой Элсингтон.‡Sprecht mit Schwester Elsington.‡수녀 엘싱턴과 대화해야 합니다.‡Habla con la hermana Elsington.‡Habla con la hermana Elsington.‡Parlez à Sœur Elsington.‡跟艾丽辛顿修女谈一谈。‡和威辛頓修女談話。',
  }
},
[26725] = {
  {
    'Guiado pela Luz‡Ведомый Светом‡Vom Lichte geführt‡빛의 인도를 따라‡Déjate guiar por la Luz‡Déjate guiar por la Luz‡Le sentier lumineux‡在圣光的指引下‡聖光的指引',
    nil,
    'Encontre o Bastão Forjado a Luz no Cemitério de Monte Corvo.‡Найдите жезл из светостали на Кладбище Вороньего Холма.‡Findet die lichtgeschmiedete Rute auf dem Friedhof von Rabenflucht.‡까마귀 언덕 묘지에서 빛으로 벼려낸 막대기를 찾아야 합니다.‡Encuentra la vara forjada con luz en el Cementerio del Cerro del Cuervo.‡Encuentra la vara forjada con luz en el Cementerio del Cerro del Cuervo.‡Trouvez le Bâtonnet de Sancteforge dans le Cimetière de Colline-aux-corbeaux.‡去找乌鸦岭墓地的光铸棒。‡去烏鴉嶺墓園裡找光鑄節杖。',
  }
},
[26726] = {
  {
    'Retorno triunfante‡Триумфальное возвращение‡Triumphale Rückkehr‡자유의 대가‡Regreso triunfal‡Regreso triunfal‡Un retour triomphant‡凯旋而归‡凱旋',
    nil,
    'Apresente-se ao Magistrado Salomão na Vila Plácida, que fica nas Montanhas Cristarrubra.‡Отчитайтесь мировому судье Соломону в Приозерье.‡Meldet Euch bei Magistrat Solomon in Seenhain im Rotkammgebirge.‡붉은마루 산맥의 호숫골에 있는 집정관 솔로몬에게 보고해야 합니다.‡Preséntate ante el magistrado Solomon en Villa del Lago en Crestagrana.‡Preséntate ante el magistrado Solomon en Villa del Lago en Crestagrana.‡Présentez-vous au Magistrat Salomon à Comté-du-Lac, dans les Carmines.‡去找赤脊山湖畔镇的所罗门镇长。‡到赤脊山的湖畔鎮向所羅門鎮長回報。',
  }
},
[26727] = {
  {
    'A vingança do embalsamador‡Месть Бальзамировщика‡Die Rache des Einbalsamierers‡장의사의 복수‡La venganza del Embalsamador‡La venganza del Embalsamador‡La vengeance de l’embaumeur‡藏尸者的复仇‡藏屍者的復仇',
    nil,
    'Mate o Suturino na Vila Sombria.‡Убейте Стежка в Темнолесье.‡Tötet Kleiner in Dunkelhain.‡어둠골에서 누더기를 처치해야 합니다.‡Mata a Puntos en Villa Oscura.‡Mata a Puntos en Villa Oscura.‡Tuez Balafré à Sombre-Comté.‡杀死夜色镇的缝合怪。‡殺死夜色鎮的縫合怪。',
  }
},
[26728] = {
  {
    'O chamado ao heroísmo: Floresta do Crepúsculo!‡Воззвание к героям: Темнолесье!‡Heldenaufruf: Dämmerwald!‡영웅의 부름: 그늘숲!‡Se busca héroe: ¡Bosque del Ocaso!‡Se busca héroe: ¡Bosque del Ocaso!‡L\'appel du héros : le bois de la Pénombre !‡英雄的召唤：暮色森林！‡英雄的召喚:暮色森林',
    nil,
    'Apresente-se à Comandante Aldora Ebanez na Vila Sombria, que fica na Floresta do Crepúsculo.‡Поговорите с командиром Алтеей Чернодрев в Темнолесье, что в Сумеречном лесу.‡Reist nach Dämmerwald und meldet Euch bei Kommandantin Althea Schwarzhaupt in Dunkelhain.‡그늘숲의 어둠골에 있는 사령관 알시아 이본로크에게 보고해야 합니다.‡Preséntate ante la comandante Althea Cerranegro en Villa Oscura en el Bosque del Ocaso.‡Preséntate ante la comandante Althea Cerranegro en Villa Oscura en el Bosque del Ocaso.‡Présentez-vous à Althea Bouclenoire à Sombre-Comté, dans le Bois de la Pénombre.‡去找暮色森林夜色镇的指挥官阿尔泰娅·埃伯洛克。‡到暮色森林裡的夜色鎮向指揮官奧爾希雅‧埃伯洛克回報。',
  }
},
[26729] = {
  {
    'Elementais da água‡Элементали воды‡Wasserelementare‡물의 정령‡Elementales de agua‡Elementales de agua‡L’île des élémentaires d\'eau‡水元素‡水元素',
    nil,
    'Pegue 6 Braçadeiras dos Elementais da Água.‡Добудьте 6 браслетов элементалей воды.‡Holt 6 Armschienen eines Wasserelementars.‡물의 정령 팔보호구 6개를 획득해야 합니다.‡Consigue 6 brazales de elementales de agua.‡Consigue 6 brazales de elementales de agua.‡Récupérez 6 Bracelets d\'élémentaire d\'eau.‡获得6个水元素护腕。‡取得6個水元素護腕。',
  }
},
[26730] = {
  {
    'Você pode tirar o murloc do oceano...‡Можно вывести мурлока из воды...‡Man kann den Murloc aus dem Ozean holen...‡굳이 바다까지 가지 않아도...‡No se puede sacar al múrloc del océano‡No se puede sacar al múrloc del océano‡Chassez le murloc, il revient au galop…‡你可以让鱼人离开海洋……‡把魚人帶出海洋',
    nil,
    'Obtenha 6 vidros de Sal Marinho dos murlocs Umbrânquia na Selva do Espinhaço Setentrional.‡Добудьте 6 сосудов с морской солью у черножабрых мурлоков в Северной Тернистой долине.‡Holt 6 Phiolen mit Meersalz von den Murlocs der Düsterkiemen im Nördlichen Schlingendorntal.‡북부 가시덤불의 검은아가미 멀록으로부터 바다 소금을 6병 모아야 합니다.‡Obtén 6 viales de sal marina de múrlocs Ancaniebla en el Norte de la Vega de Tuercespina.‡Obtén 6 viales de sal marina de múrlocs Ancaniebla en el Norte de la Vega de Tuercespina.‡Récupérez 6 fioles de Sel marin sur les Murlocs branchie-bistre, en Strangleronce septentrionale.‡从北荆棘谷的黑腮鱼人那里获得6瓶海盐。‡從北荊棘谷內的黑鰓魚人身上收集6瓶海鹽。',
  }
},
[26731] = {
  {
    'O altar de Naias‡Алтарь Найаса‡Der Altar von Naias‡나이아스의 제단‡El Altar de Naias‡El Altar de Naias‡L’autel de Naïas‡奈亚斯祭坛‡奈亞斯祭壇',
    nil,
    'Use a Dádiva de Naias para evocar Naias. Depois, pegue o Coração de Naias.‡Используйте дар Найаса, чтобы призвать Найаса, затем добудьте сердце Найаса.‡Beschwört Naias mit Naias\' Gabe und holt das Herz von Naias.‡나이아스의 선물을 사용해 나이아스를 소환하고, 나이아스의 심장을 획득해야 합니다.‡Usa el don de Naias para invocar a Naias. Después, obtén el corazón de Naias.‡Usa el don de Naias para invocar a Naias. Después, obtén el corazón de Naias.‡Utilisez le Cadeau de Naïas pour invoquer Naïas, puis emparez-vous du Cœur de Naïas.‡用奈亚斯的礼物召唤奈亚斯，然后获得奈亚斯的精华。‡使用奈亞斯的禮物來召喚奈亞斯，然後取得奈亞斯的心。',
  }
},
[26732] = {
  {
    'Remédio do mal‡Дурное лекарство‡Schlechte Medizin‡나쁜 약‡Mala medicina‡Mala medicina‡Un remède contre l’insubordination‡劣质药品‡庫爾森的藥物',
    nil,
    'Obtenha 7 Remédios da Mata no Complexo do Kurzen.‡Отправляйтесь в Лагерь Курцена и раздобудьте 7 склянок зелья из джунглей.‡Besorgt 7 Dschungelarzneien aus Kurzens Truppenlager.‡쿠르젠 주둔지에서 밀림 치료제 7개를 획득해야 합니다.‡Obtén 7 pócimas de la selva en la Base de Kurzen.‡Obtén 7 pócimas de la selva en la Base de Kurzen.‡Récupérez 7 Remèdes tropicaux provenant de la Base de Kurzen‡从库尔森的营地获得7瓶密林药剂。‡從庫爾森的營地內取得7份密林藥劑。',
  }
},
[26733] = {
  {
    'Amostra de controle‡Контрольный образец‡Kontrollprobe‡표본 대조‡Muestra de control‡Muestra de control‡L’échantillon témoin‡比对样本‡控制樣本',
    nil,
    'Consiga 7 amostras de Sangue de Basilisco da Serra dos Cristais.‡Соберите 7 образцов крови хрустального василиска.‡Besorgt 7 Proben Kristallrückenbasiliskenblut.‡수정가시 바실리스크 피의 견본 7개를 획득해야 합니다.‡Obtén 7 muestras de sangre de basilisco Espina de cristal.‡Obtén 7 muestras de sangre de basilisco Espina de Cristal.‡Récupérez 7 échantillons de Sang de basilic de cristal.‡获得7份晶背蜥蜴的血样。‡取得7份晶背蜥蜴的血樣本。',
  }
},
[26734] = {
  {
    'A fonte da loucura‡Источник безумия‡Die Quelle des Wahnsinns‡광기의 원천‡El origen de la locura‡El origen de la locura‡L\'origine de la folie‡疯狂的源头‡瘋狂的來源',
    nil,
    'Obtenha uma Pedra Azul Sussurrante com as tropas que ficam no Arsenal.‡Добудьте шепчущий синий камень у войск Курцена в Схроне.‡Erbeutet einen flüsternden blauen Stein von Kurzens Truppen im Vorratslager.‡보급창의 쿠르젠 병사들에게서 속삭이는 푸른 돌을 획득해야 합니다.‡Obtén una piedra azul susurrante de las tropas Kurzen que hay en Las Reservas.‡Obtén una piedra azul susurrante de las tropas Kurzen que hay en Las Reservas.‡Récupérez une Pierre bleue murmurante dans la Réserve des troupes de Kurzen.‡从物资储藏点的库尔森成员身上获得一块低语蓝石。‡在庫爾森部隊的儲藏室中獲得耳語藍石。',
  }
},
[26735] = {
  {
    'O destino de Kurzen‡Участь Курцена‡Kurzens Schicksal‡쿠르젠의 운명‡El destino de Kurzen‡El destino de Kurzen‡Le destin de Kurzen‡库尔森的命运‡庫爾森的命運',
    nil,
    'Pegue os Registros de Prisão do Complexo de Kurzen e o Dossiê dos Oficiais do Complexo de Kurzen.‡Раздобудьте тюремные дела лагеря Курцена и досье офицеров лагеря Курцена.‡Findet das Gefängnisregister von Kurzens Truppenlager und die Offiziersakten von Kurzens Truppenlager.‡쿠르젠 주둔지 감옥 기록과 쿠르젠 주둔지 장교의 서류뭉치를 획득해야 합니다.‡Obtén los registros de prisión de la Base de Kurzen y el dosier de oficiales de los barracones de Kurzen.‡Obtén los registros de prisión de la Base de Kurzen y el dosier de oficiales de los barracones de Kurzen.‡Emparez-vous du Registre des prisonniers de la base de Kurzen et du Rôle des officiers de la base de Kurzen‡获得库尔森营地监狱记录和库尔森营地军官名册。‡取得庫爾森的營地囚犯檔案和庫爾森的營地軍官檔案。',
  }
},
[26736] = {
  {
    'Poupados da loucura‡Вменяемые заключенные‡Vom Wahnsinn verschont‡광기를 모면하다‡A salvo de la locura‡A salvo de la locura‡Ceux que la folie a épargnés‡逃离疯狂‡逃過瘋狂',
    nil,
    'Resgate Berrin Penaquente, Emerine Junis e Osborn Obnótico de dentro do Complexo do Kurzen.‡Спасите Беррина Горишпинделя, Эмерину Юнис и Осборна Пропеллерза, находящихся в лагере Курцена.‡Rettet Berrin Brennfeder, Emerine Junis und Osborn Grausikus aus Kurzens Truppenlager.‡쿠르젠 주둔지에 있는 베린 번퀼, 에머린 주니스, 오스본 옵노티쿠스를 구출해야 합니다.‡Rescata a Berrin Quemapluma, Emerine Junis y Osborn Obnoticus en el interior de la Base de Kurzen.‡Rescata a Berrin Quemapluma, Emerine Junis y Osborn Obnoticus en el interior de la Base de Kurzen.‡Secourez Berrin Embraseplume, Emerine Junis et Osborn Obnoticus, dans la base de Kurzen.‡营救贝尔林·燃翎、艾茉琳·朱里斯和奥斯伯恩·奥布诺提斯。‡在庫爾森的營地內拯救柏爾林·燃羽、艾玫琳·裘妮絲，以及奧斯伯·奧布諾提斯。',
  }
},
[26737] = {
  {
    'Acabando com o legado de Kurzen‡Положить конец наследию Курцена‡Beendet Kurzens Vermächtnis‡쿠르젠의 남은 부하 처리‡Detener el legado de Kurzen‡Detener el legado de Kurzen‡Échec à l’héritage de Kurzen‡消灭库尔森的后继者‡阻止庫爾森的殘黨',
    nil,
    'Mate o Chefe Anders, o Chefe Gaulus, a Chefe Miranda e o Chefe Esquivel dentro do Arsenal.‡Убейте следующих командиров в Схроне: Андерса, Гаула, Миранду и Эскивела.‡Tötet Oberstabschef Anders, Oberstabschef Gaulus, Oberstabschef Miranda und Oberstabschef Esquivel im Vorratslager.‡보급창에 있는 대장 앤더스, 대장 가울루스, 대장 미란다, 대장 에스퀴벨을 처치해야 합니다.‡Mata al jefe Anders, al jefe Gaulus, a la jefa Miranda y al jefe Esquivel en el interior de Las Reservas.‡Mata al jefe Anders, al jefe Gaulus, a la jefa Miranda y al jefe Esquivel en el interior de Las Reservas.‡Tuez le Chef Anders, le Chef Gaulus, le Chef Miranda et le Chef Esquivel, dans la Réserve.‡杀死物资储藏点里的士官长安德斯、士官长高鲁斯、士官长米兰达和士官长艾斯奎维尔。‡在儲藏室裡殺死安德斯隊長、高盧斯隊長、米蘭達隊長和埃斯奎維爾隊長。',
  }
},
[26738] = {
  {
    'Recém-chocado‡Новорожденный‡Frisch geschlüpft‡방금 태어났어요‡Recién nacida‡Recién nacida‡À peine sorti de l’œuf‡刚刚孵化‡正剛孵化',
    nil,
    'Leve o Filhote de Batecauda para o Cabo Malta no Acampamento dos Rebeldes, na Selva do Espinhaço Setentrional.‡Отнесите детеныша кнутохвоста капралу Сетману в Лагерь Повстанцев в Северной Тернистой долине.‡Bringt das Schmetterschwanzjunge zu Korporal Sethmann im Rebellenlager im Nördlichen Schlingendorntal.‡북부 가시덤불의 반란군 야영지에 있는 하사관 세스먼에게 아기 채찍꼬리랩터를 데려가야 합니다.‡Lleva la prole de colazote al cabo Sethman en el Asentamiento Rebelde, en el Norte de la Vega de Tuercespina.‡Lleva la prole de colazote al cabo Sethman en el Asentamiento Rebelde, en el Norte de la Vega de Tuercespina.‡Apportez le Jeune flagellant au caporal Sethman, au Camp rebelle, en Strangleronce septentrionale.‡将鞭尾幼龙带给反抗军营地的塞斯曼下士。‡將小鞭尾迅猛龍送去北荊棘谷的反抗軍營地，交給塞斯曼下士。',
  }
},
[26739] = {
  {
    'Eu acho que ela está com fome‡Не покормишь – не вырастишь‡Ich glaube, sie hat Hunger‡배가 고파요‡Creo que tiene hambre‡Creo que tiene hambre‡Le fin flagellant flageolant de faim‡我想她饿了‡我想她餓了',
    nil,
    'Mate Basiliscos da Serra dos Cristais na Selva do Espinhaço Setentrional e deixe o Raptor Batecauda dar 40 mordidas na carne de basilisco.‡Убивайте хрустальных василисков в Северной Тернистой долине и кормите своего ящера-кнутохвоста их мясом, пока он не съест 40 кусочков.‡Tötet Kristallrückenbasilisken im Nördlichen Schlingendorntal und lasst Euren Schmetterschwanz 40 Bissen ihres Fleisches fressen.‡북부 가시덤불에 있는 수정가시 바실리스크를 처치하고 아기 채찍꼬리랩터가 고기를 40회 뜯어 먹게 해야 합니다.‡Mata basiliscos Espina de Cristal en el Norte de la Vega de Tuercespina y dale de comer 40 bocados de su carne a tu raptor colazote.‡Mata basiliscos Espina de Cristal en el Norte de la Vega de Tuercespina y dale de comer 40 bocados de su carne a tu raptor colazote.‡Tuez des Basilics de cristal, en Strangleronce septentrionale, et laissez votre Raptor flagellant manger 40 bouchées de leur viande.‡在北荆棘谷杀死晶背蜥蜴，让你的鞭尾迅猛龙吃40口。‡殺死北荊棘谷的晶背蜥蜴，然後讓你的鞭尾迅猛龍咬40口牠們的肉。',
  }
},
[26740] = {
  {
    'A cozinha de Krazek‡Горшок Кразека‡Kochen mit Krazek‡크라젝의 요리 냄비‡La cocina de Krazek‡La cocina de Krazek‡La marmite mijoteuse automatique de Krazek‡克拉兹克烹饪术‡克拉茲克的烹調鍋',
    nil,
    'Leve a Caçarola Meia-boca do Krazek para o Krazek.‡Отнесите неисправный горшок Кразеку.‡Bringt Krazeks Spezialtopf zu Krazek.‡크라젝의 고물 냄비를 크라젝에게 가져가야 합니다.‡Lleva la olla mecánica de Krazek a Krazek.‡Lleva la olla mecánica de Krazek a Krazek.‡Apportez la Marmite mijoteuse automatique de Krazek à Krazek.‡把克拉兹克的烹调锅带给克拉兹克。‡將克拉茲克的烹調鍋帶去給克拉茲克。',
  }
},
[26741] = {
  {
    'REUSE‡REUSE‡REUSE‡재사용‡REUSE‡REUSE‡REUSE‡REUSE‡重複利用',
    nil,
    nil,
  }
},
[26742] = {
  {
    'Conhecimento dos Sanguescalpo‡Изучение Кровавого Скальпа‡Erkenntnisse über die Blutskalpe‡붉은머리 부족에게 한 수 배우기‡Técnicas Sangrapellejo‡Técnicas Sangrapellejo‡Pour une ethnologie trollistique‡血顶的见解‡洞悉血頂習性',
    nil,
    'Adquira um Totem Sanguescalpo de um Xamã Sanguescalpo.‡Добудьте тотем Кровавого Скальпа у шамана этого племени.‡Besorgt ein Totem der Blutskalpe von einem Schamanen der Blutskalpe.‡붉은머리 주술사에게서 붉은머리 토템을 획득해야 합니다.‡Obtén un tótem Sangrapellejo de un chamán Sangrapellejo.‡Obtén un tótem Sangrapellejo de un chamán Sangrapellejo.‡Emparez-vous d\'un Totem scalp-rouge d’un Chaman scalp-rouge.‡从一名血顶萨满祭司那里获得血顶图腾。‡從血頂薩滿手中獲得血頂圖騰。',
  }
},
[26743] = {
  {
    'Sagrado para os Sanguescalpo‡Реликвия Кровавых Скальпов‡Den Blutskalpen heilig‡붉은머리 부족에게 신성한 것‡Sagrados para los Sangrapellejo‡Sagrados para los Sangrapellejo‡La métaphysique des trolls‡血顶的圣物‡血頂族的神聖生物',
    nil,
    'Consiga um Ícone de Tsul\'Kalu, um Ícone de Mahamba e um Ícone de Pogeyan dos trolls Sanguescalpo nas Ruínas de Tkashi.‡Добудьте у Кровавых Скальпов в руинах Ткаши идола Цул\'калу, идола Махамбы и идола Погеана.‡Besorgt eine Ikone von Tsul\'kalu, eine Ikone von Mahamba und eine Ikone von Pogeyan aus dem Lager der Blutskalptrolle in den Ruinen von Tkashi.‡트카시 폐허에 있는 붉은머리 트롤에게서 출칼루의 상징, 마함바의 상징, 포게얀의 상징을 획득해야 합니다.‡Obtén un icono de Tsul\'kalu, un icono de Mahamba y un icono de Pogeyan de los trols Sangrapellejo de las Ruinas de Tkashi.‡Obtén un icono de Tsul\'kalu, un icono de Mahamba y un icono de Pogeyan de los trols Sangrapellejo de las Ruinas de Tkashi.‡Emparez-vous de l’Icône de Tsul’Kalu, de l’Icône de Mahamba et de l’Icône de Pogeyan des Trolls scalps-rouges, dans les Ruines de Tkashi.‡在伽什废墟的血顶巨魔那里获得一尊苏尔卡鲁的雕像、一尊穆哈姆巴的模型，以及一尊博格雅恩的雕像。‡從伽什廢墟裡的血頂食人妖處，取得促爾卡盧的塑像、瑪哈姆巴的塑像、以及波格雅恩的塑像。',
  }
},
[26744] = {
  {
    'Raízes profundas‡Глубокие корни‡Tiefe Wurzeln‡깊은 뿌리‡Raíces profundas‡Raíces profundas‡Les belles histoires de l’oncle troll‡深深扎根‡深入起源',
    nil,
    'Consiga a Tabuleta de História dos Sanguescalpo nas Ruínas de Bal\'lal, que ficam na Selva do Espinhaço Setentrional.‡Отыщите "Легенды и предания племени Кровавого Скальпа" в руинах Бал\'лал, что в Северной Тернистой долине.‡Holt die Schrifttafel der Blutskalpe aus den Ruinen von Bal\'lal im Nördlichen Schlingendorntal.‡북부 가시덤불의 발랄 폐허에서 붉은머리 전통지식 서판을 획득해야 합니다.‡Obtén la tablilla de conocimiento Sangrapellejo en las Ruinas de Bal\'lal en el Norte de la Vega de Tuercespina.‡Obtén la tablilla de conocimiento Sangrapellejo en las Ruinas de Bal\'lal en el Norte de la Vega de Tuercespina.‡Récupérez la Tablette de savoir scalp-rouge dans les Ruines de Bal’lal, en Strangleronce septentrionale.‡从北荆棘谷巴拉尔废墟获得血顶秘闻石板。‡從北荊棘谷的巴拉爾廢墟中取得血頂知識石板。',
  }
},
[26745] = {
  {
    'O crânio favorito‡Особенный череп‡Lieblingsschädel‡선택받은 해골‡Su cráneo favorito‡Su cráneo favorito‡L’étrange gros nonos du petit raptor‡心爱的颅骨‡最珍愛的骷髏頭',
    nil,
    'Fale com Osborn Obnótico no Acampamento dos Rebeldes e mostre o novo crânio do seu Filhote de Batecauda.‡Поговорите с Осборном Пропеллерзом в Лагере Повстанцев и покажите ему свежий череп детеныша кнутохвоста.‡Meldet Euch bei Osborn Grausikus im Rebellenlager und zeigt ihm den neuen Schädel Eures Schmetterschwanzjungen.‡반란군 야영지의 오스본 옵노티쿠스에게 돌아가 아기 채찍꼬리랩터가 물고 있는 해골을 보여줘야 합니다.‡Preséntate ante Osborn Obnoticus en el Asentamiento Rebelde y enséñale el nuevo cráneo de tu prole de colazote.‡Preséntate ante Osborn Obnoticus en el Asentamiento Rebelde y enséñale el nuevo cráneo de tu prole de colazote.‡Allez voir Osborn Obnoticus et montrez-lui le nouveau crâne de votre Jeune flagellant.‡去找反抗军营地的奥斯伯恩·奥布诺提斯，把鞭尾幼龙的新颅骨给他看。‡去反抗軍營地向奧斯伯‧奧布諾提斯回報，並拿小迅猛龍的新骷髏頭給他看。',
  }
},
[26746] = {
  {
    'Faro para esse tipo de coisa‡Хороший нюх‡Ein Gespür für solche Dinge‡개코가 필요한 일‡Olfato para este tipo de cosas‡Olfato para este tipo de cosas‡Le flagellant a du nez‡就是干这个的鼻子‡專門嗅這些東西的鼻子',
    nil,
    'Use o seu Filhote de Batecauda para farejar 8 Fetiches Tkashi.‡С помощью детеныша кнутохвоста разыщите 8 фетишей Ткаши.‡Lasst Euer Schmetterschwanzjunges 8 Tkashifetische erschnüffeln.‡아기 채찍꼬리랩터의 냄새맡는 능력을 이용해 8개의 트카시 우상을 찾아야 합니다.‡Utiliza tu prole de colazote para rastrear 8 fetiches Tkashi.‡Utiliza tu prole de colazote para rastrear 8 fetiches Tkashi.‡Utilisez le flair de votre Jeune flagellant pour déterrer 8 Fétiches de Tkashi.‡让鞭尾幼龙嗅出8尊迦什神像的所在。‡利用小鞭尾迅猛龍嗅出8個伽什神像。',
  }
},
[26747] = {
  {
    'Um espécime físico‡Отборный экземпляр‡Ein Exemplar aus Fleisch und Blut‡신체 표본‡Un espécimen físico‡Un espécimen físico‡Troll sana in corpore sano‡物理标本‡活體標本',
    nil,
    'Pegue o Corpo do Gan\'zulah em Zul\'Kanda.‡Добудьте тело Ган\'зулаха в Зул\'Кунде.‡Holt Gan\'zulahs Leiche aus Zul\'Kunda.‡줄쿤다에서 간줄라의 유해를 획득해야 합니다.‡Consigue el cuerpo de Gan\'zulah en Zul\'Kunda.‡Consigue el cuerpo de Gan\'zulah en Zul\'Kunda.‡Procurez-vous le Corps de Gan’zulah à Zul’Kunda.‡到祖昆达获得甘祖拉恩的躯体。‡到祖昆達去取得甘祖拉恩的身體。',
  }
},
[26748] = {
  {
    'Sangrelorde Mandokir‡Мандокир Повелитель Крови‡Blutfürst Mandokir‡혈군주 만도키르‡Señor sangriento Mandokir‡Señor sangriento Mandokir‡Mandokir, le seigneur sanglant‡血领主曼多基尔‡血領主曼多基爾',
    nil,
    'Entregue o Fragmento de Ovo de Raptor Batecauda para o Sangrelorde Mandokir no Acampamento dos Rebeldes.‡Принесите осколок яйца ящера-кнутохвоста Мандокиру Повелителю Крови в Лагерь Повстанцев.‡Bringt Blutfürst Mandokir im Rebellenlager das Schmetterschwanzeifragment.‡반란군 야영지에 있는 혈군주 만도키르에게 채찍꼬리랩터 알 조각을 가져가야 합니다.‡Entrega el fragmento de huevo de raptor colazote al Señor sangriento Mandokir en el Asentamiento Rebelde.‡Entrega el fragmento de huevo de raptor colazote al Señor sangriento Mandokir en el Asentamiento Rebelde.‡Livrez le Fragment d\'œuf de raptor flagellant au Seigneur sanglant Mandokir, au Camp rebelle.‡将破碎的鞭尾迅猛龙蛋交给反抗军营地的血领主曼多基尔。‡將鞭尾迅猛龍龍蛋碎塊送到反抗軍營地給血領主曼多基爾。',
  }
},
[26749] = {
  {
    'Sacerdotisa Thaalia‡Жрица Тхаалия‡Priesterin Thaalia‡여사제 타알리아‡Sacerdotisa Thaalia‡Sacerdotisa Thaalia‡La prêtresse Thaalia‡女祭司萨阿莉亚‡女牧師撒亞莉雅',
    nil,
    'Fale com a Sacerdotisa Thaalia no Forte Pedraviva, que fica na Selva do Espinhaço Setentrional.‡Найдите жрицу Тхаалию в форте Ливингстон в Северной Тернистой долине и поговорите с ней.‡Sprecht mit Priesterin Thaalia in Fort Livingston im Nördlichen Schlingendorntal.‡북부 가시덤불의 리빙스턴 요새에 있는 여사제 타알리아와 대화해야 합니다.‡Habla con la sacerdotisa Thaalia en Fuerte Livingston en el Norte de la Vega de Tuercespina.‡Habla con la sacerdotisa Thaalia en Fuerte Livingston en el Norte de la Vega de Tuercespina.‡Parlez à la Prêtresse Thaalia à Fort-Livingston, en Strangleronce septentrionale.‡跟北荆棘谷利文斯顿营地的女祭司萨阿莉亚谈一谈。‡到北荊棘谷的李文斯頓堡壘和女牧師撒亞莉雅談話。',
  }
},
[26750] = {
  {
    'O chamado da Petramáter‡Мать-Скала зовет‡Auf Geheiß der Steinmutter‡바위 어머니의 부름‡La llamada de la Madre Pétrea‡La llamada de la Madre Pétrea‡L’appel de la Pierre-Mère‡响应石母的召唤‡石母的呼喚',
    nil,
    'Fale com Therazane, a Petramáter.‡Поговорите с Теразан, Матерью-Скалой.‡Sprecht mit Therazane der Steinmutter.‡바위 어머니 테라제인과 대화해야 합니다.‡Habla con Therazane, la Madre Pétrea.‡Habla con Therazane, la Madre Pétrea.‡Allez voir Therazane, la Pierre-Mère.‡跟石母塞拉赞恩谈一谈。‡與石母瑟拉贊恩交談。',
  }
},
[26751] = {
  {
    'Con-troll-e de população‡"Кон-тролль" популяции‡Bevölkerungskon-Trolle‡트롤 인구 조절‡Con-trol de la población‡Con-trol de la población‡Con-troll démographique‡巨魔人口控制‡食人妖人口控管',
    nil,
    'Mate 7 Místicos Sanguescalpo, 7 Caçadores Sanguescalpo, 7 Batedores Sanguescalpo e 1 Senhor das Feras Sanguescalpo.‡Убейте 7 мистиков, 7 охотников, 7 разведчиков и 1 повелителя зверей из племени Кровавого Скальпа.‡Tötet 7 Mystiker der Blutskalpe, 7 Jäger der Blutskalpe, 7 Späher der Blutskalpe und 1 Bestienmeister der Blutskalpe.‡붉은머리 비술사 7명, 붉은머리 사냥꾼 7명, 붉은머리 정찰병 7명, 그리고 붉은머리 야수조련사 1명을 처치해야 합니다.‡Mata 7 místicos Sangrapellejo, 7 cazadores Sangrapellejo, 7 exploradores Sangrapellejo y 1 maestro de bestias Sangrapellejo.‡Mata 7 místicos Sangrapellejo, 7 cazadores Sangrapellejo, 7 exploradores Sangrapellejo y 1 maestro de bestias Sangrapellejo.‡Tuez 7 Mystiques scalps-rouges, 7 Chasseurs scalps-rouges, 7 Éclaireurs scalps-rouges et 1 Belluaire scalp-rouge.‡杀死7名血顶秘法师、7名血顶猎人、7名血顶斥候，以及1名血顶兽王。‡殺死7名血頂秘術使、7名血頂獵人、7名血頂斥候以及1名血頂獸王。',
  }
},
[26752] = {
  {
    'Audiência com a Petramáter‡Аудиенция у Матери-Скалы‡Audienz bei der Steinmutter‡바위 어머니 알현‡Audiencia con la Madre Pétrea‡Audiencia con la Madre Pétrea‡L’audience avec la Pierre-Mère‡觐见石母‡謁見石母',
    nil,
    'Compareça à audiência com a Petramáter.‡Выслушайте Мать-Скалу.‡Nehmt an der Audienz bei der Steinmutter teil.‡바위 어머니를 알현해야 합니다.‡Acude a la audiencia con la Madre Pétrea.‡Acude a la audiencia con la Madre Pétrea.‡Participez à l’audience avec la Pierre-Mère.‡上殿觐见石母。‡前去謁見石母。',
  }
},
[26753] = {
  {
    'Os salões dos mortos‡Чертоги мертвых‡Die Hallen der Toten‡망자의 전당‡Las cámaras de los muertos‡Las cámaras de los muertos‡Les salles des morts‡亡者的大厅‡亡者大廳',
    nil,
    'Encontre o Arco Forjado a Luz nas Catacumbas do Bosque da Aurora.‡Найдите дужку из светостали в катакомбах Утреннего леса.‡Findet den lichtgeschmiedeten Bogen in den Katakomben des Morgenrotwaldes.‡새벽숲 지하묘지에서 빛으로 벼려낸 굽쇠를 찾아야 합니다.‡Encuentra el arco forjado con luz en las Catacumbas del Bosque Aurora.‡Encuentra el arco forjado con luz en las Catacumbas del Bosque Aurora.‡Trouvez l’Arche de Sancteforge dans les Catacombes du Bois-de-l’aube.‡在晨光之林墓穴中找到光铸弓。‡在黎明墓穴裡找到光鑄牙弓。',
  }
},
[26754] = {
  {
    'A desgraça de Morbídio‡Погибель Морбента‡Morbents Bann‡모벤트 파멸의 불꽃‡La pesadilla de Morbent‡La pesadilla de Morbent‡Le fléau de Morbent‡摩本特的克星‡摩本特的剋星',
    nil,
    'Use a Desgraça de Morbídio para enfraquecer Morbídio Vil e derrotá-lo.‡Воспользуйтесь артефактом Погибель Морбента, чтобы победить его.‡Schwächt Morbent Teufel mit Morbents Bann und besiegt ihn.‡모벤트 파멸의 불꽃을 사용하여 모벤트 펠을 약하게 한 후 처치해야 합니다.‡Utiliza la pesadilla de Morbent para debilitar a Morbent Vil y derrotarlo.‡Utiliza la pesadilla de Morbent para debilitar a Morbent Vil y derrotarlo.‡Utilisez le Fléau de Morbent pour affaiblir et vaincre Morbent Lagangrène.‡用摩本特的克星削弱摩本特·费尔，然后打败他。‡使用摩本特的剋星來弱化摩本特·費爾並擊敗他。',
  }
},
[26755] = {
  {
    'Para longe do front‡Отражение атаки‡Weg von der Front‡전초지에서 몰아내기‡Apártalos del frente de batalla‡Apártalos del frente de batalla‡Ne les laissez pas envahir le front‡阻止他们挺进前线‡鎮守前線',
    nil,
    'Bombardeie 30 Horrores Fúngicos e/ou Reforços dos Troggs de Pedra.‡Уничтожьте 30 грибных ужасней или каменных троггов из подкрепления.‡Bombardiert 30 Fungusschrecken und/oder Mitglieder der Verstärkung der Steintroggs.‡곰팡이 괴물이나 바위 트로그 지원병을 종류에 상관없이 포격으로 30마리 처치해야 합니다.‡Bombardea a 30 terrores fúngicos o refuerzos de los troggs de piedra.‡Bombardea a 30 terrores fúngicos o refuerzos de los troggs de piedra.‡Bombardez 30 Terreurs fongiques et/ou Renforts troggs de pierre.‡轰翻30名真菌恐兽以及/或者石头穴居人增援。‡砸爛30隻真菌懼獸和／或岩石穴居怪援軍。',
  }
},
[26756] = {
  {
    '‡Несса Песня Теней‡Nessa Schattensang‡네사 섀도송‡Nessa Cantosombrío‡Nessa Cantosombrío‡Nessa Chantelombre‡尼莎·影歌‡奈莎·影歌',
    nil,
    '‡Поговорите с Нессой Песня Теней.‡Bringt die Rezeptsammlung von Dolanaar zu Fidelio in Dolanaar.‡‡Lleva el libro de recetas de Dolanaar a Fidelio en Dolanaar.‡Lleva el libro de recetas de Dolanaar a Fidelio en Dolanaar.‡Apportez le Livre de recettes de Dolanaar à Fidelio à Dolanaar.‡与尼莎·影歌谈一谈。‡',
  }
},
[26757] = {
  {
    '‡Изобилие Тельдрассила‡Auf nach Darnassus‡다르나서스로‡A Darnassus‡A Darnassus‡Dolanaar-Darnassus sans escale‡泰达希尔的渔业‡',
    nil,
    '‡Отнесите коллекцию Нессы к Веспристу.‡Sprecht mit Fidelio, um einen Flug nach Darnassus zu erstehen, und bringt dann die Rezeptsammlung von Dolanaar zu Schwester Aquinne in Darnassus.‡‡Habla con Fidelio para comprar un vuelo a Darnassus. Después, lleva el libro de recetas de Dolanaar a la hermana Aquinne en Darnassus.‡Habla con Fidelio para comprar un vuelo a Darnassus. Después, lleva el libro de recetas de Dolanaar a la hermana Aquinne en Darnassus.‡Parlez à Fidelio pour vous payer un vol pour Darnassus, puis apportez le Livre de recettes de Dolanaar à Sœur Aquinne, à Darnassus.‡将尼莎的货物交给维斯派塔斯。‡',
  }
},
[26758] = {
  {
    '‡Полет в Аубердин‡Ein unerwartetes Geschenk‡깜짝 선물‡Un regalo inesperado‡Un regalo inesperado‡Le présent inattendu‡飞往奥伯丁‡',
    nil,
    '‡Совершите полет в Аубердин на гиппогрифе укротителя Весприста и отнесите коллекцию Нессы Лайрду.‡Bringt Schwester Aquinnes Notiz zu Leora, der Hippogryphenmeisterin in Darnassus.‡‡Lleva la nota de la hermana Aquinne a Leora, la maestra de hipogrifos de Darnassus.‡Lleva la nota de la hermana Aquinne a Leora, la maestra de hipogrifos de Darnassus.‡Apportez la Réponse de Sœur Aquinne à Leora, la Maîtresse des hippogriffes de Darnassus.‡从角鹰兽管理员维斯派塔斯那里租用一只角鹰兽飞到奥伯丁，然后将尼莎的货物交给莱尔德。‡',
  }
},
[26759] = {
  {
    '‡Возвращение к Нессе‡Rückkehr zu Nyoma‡니오마에게 돌아가기‡Regresa junto con Nyoma‡Regresa junto con Nyoma‡Retourner voir Nyoma‡飞回泰达希尔‡',
    nil,
    '‡Принесите ответ Лайрда Нессе Песне Теней.‡Sprecht mit Leora, um einen Hippogryphen zu mieten, der Euch nach Dolanaar zurückbringt. Sobald Ihr in Dolanaar angekommen seid, bringt Schwester Aquinnes Nachricht zu Nyoma.‡‡Habla con Leora para alquilar un hipogrifo y regresar a Dolanaar. Cuando llegues, entrégale la nota de la hermana Aquinne a Nyoma.‡Habla con Leora para alquilar un hipogrifo y regresar a Dolanaar. Cuando llegues, entrégale la nota de la hermana Aquinne a Nyoma.‡Parlez à Leora pour louer un hippogriffe qui vous ramènera à Dolanaar. Une fois sur place, portez la Réponse de Sœur Aquinne à Nyoma.‡将莱尔德的回信交给尼莎·影歌。‡',
  }
},
[26760] = {
  {
    'Uivando para a lua‡Вой на луну‡Das Unmögliche möglich machen‡달을 향한 울부짖음‡Aullar a la luna‡Aullar a la luna‡Hurler à la lune‡异想天开‡嚎月',
    nil,
    'Observe Olívio Espargosa e Medrisco tentarem curar o Worgen Espreitador.‡Понаблюдайте за попыткой Оливера Харриса и Трясунчика вылечить крадущегося воргена.‡Seht zu, wie Oliver Harris und Bibbers versuchen, den lauernden Worgen zu heilen.‡올리버 해리스와 지터스가 매복한 늑대인간을 치료하는 모습을 지켜봐야 합니다.‡Observa cómo Oliver Harris y Alterio intentan curar al huargen acechante.‡Observa cómo Oliver Harris y Alterio intentan curar al huargen acechante.‡Regardez Oliver Harris et La Tremblote essayer de guérir le worgen caché.‡旁观奥莉芙·哈里斯和基特斯试图治疗潜伏的狼人。‡看著奧利弗·哈里斯和基特斯治療潛伏的狼人。',
  }
},
[26761] = {
  {
    'Ameaça ao reino‡Угроза королевству‡Eine Bedrohung für das Königreich‡왕국에 대한 위협‡Amenaza contra el reino‡Amenaza contra el reino‡Le royaume est menacé‡王国的威胁‡王國的威脅',
    nil,
    'Apresente-se ao Magistrado Salomão na Vila Plácida, que fica nas Montanhas Cristarrubra.‡Отчитайтесь мировому судье Соломону в Приозерье.‡Meldet Euch bei Magistrat Solomon in Seenhain im Rotkammgebirge.‡붉은마루 산맥의 호숫골에 있는 집정관 솔로몬에게 보고해야 합니다.‡Preséntate ante el magistrado Solomon en Villa del Lago en Crestagrana.‡Preséntate ante el magistrado Solomon en Villa del Lago en Crestagrana.‡Présentez-vous au Magistrat Salomon à Comté-du-Lac, dans les Carmines.‡向赤脊山湖畔镇的所罗门镇长报告。‡到赤脊山的湖畔鎮向所羅門鎮長回報。',
  }
},
[26762] = {
  {
    'Reativar constructos‡Реактивировать боевые создания‡Reaktiviert die Konstrukte‡피조물 재활성화‡Reactiva los ensamblajes‡Reactiva los ensamblajes‡Réactiver les assemblages‡重启魔像‡重啟戰爭傀儡',
    nil,
    'Reative 5 Constructos de Guerra Desativados.‡Реактивируйте 5 деактивированных боевых созданий.‡Reaktiviert 5 deaktivierte Kriegskonstrukte.‡활동을 멈춘 전쟁 피조물 5마리를 다시 작동시켜야 합니다.‡Reactiva 5 ensamblajes de guerra desactivados.‡Reactiva 5 ensamblajes de guerra desactivados.‡Réactivez 5 Assemblages de guerre désactivés.‡重启5具战争魔像。‡重新啟動5具停止的戰爭傀儡。',
  }
},
[26763] = {
  {
    'Mineração da Empreendimentos S.A.‡Рудник Торговой Компании‡Venture Company-Bergbau‡투자개발회사 채광‡La minería de Ventura y Cía.‡La minería de Ventura y Cía.‡Les mines de la KapitalRisk‡风险投资公司矿业‡風險投資公司的採礦行為',
    nil,
    'Obtenha 5 Cristais Rolados das forças da Empreendimentos S.A. próximas ao Lago Nazferiti.‡Добудьте 5 упавших кристаллов у сотрудников Торговой Компании близ озера Назферити.‡Besorgt 5 gerommelte Kristalle von Angehörigen der Venture Co. beim Nazferitisee.‡나즈페리티 호수 근처에 있는 투자개발회사의 병사에게서 연마된 수정 5개를 획득해야 합니다.‡Obtén 5 cristales caídos de las fuerzas de Ventura y Cía. cercanas al Lago Nazferiti.‡Obtén 5 cristales caídos de las fuerzas de Ventura y Cía. cercanas al Lago Nazferiti.‡Récupérez 5 Cristaux réduits pris aux forces de la KapitalRisk, près du Lac Nazferiti.‡从纳菲瑞提湖附近风险投资公司的雇员身上收集5颗打磨过的水晶。‡從納菲瑞提湖附近的風險投資公司部隊那裏取得5顆打磨過的水晶。',
  }
},
[26764] = {
  {
    'Sem escrúpulos é pouco...‡Новое унижение‡Moralischer Bankrott‡최저 임금‡No se puede caer más bajo‡No se puede caer más bajo‡L’exfiltration‡新低‡新的低潮',
    nil,
    'Liberte 3 Druidas Escravizados da Base da Empreendimentos S.A.‡Освободите 3 порабощенных друидов в главном лагере Торговой Компании.‡Befreit 3 versklavte Druiden aus dem Basislager der Venture Co.‡투자개발회사 탐사기지에 사로잡힌 드루이드 3명을 풀어줘야 합니다.‡Libera a 3 druidas esclavizados de la Base de Ventura y Cía.‡Libera a 3 druidas esclavizados de la Base de Ventura y Cía.‡Libérez 3 Druides asservis du Camp de base de la KapitalRisk.‡从风险投资公司营地释放3名被俘虏的德鲁伊。‡從風險投資公司營地裡救出3個被奴役的德魯伊。',
  }
},
[26765] = {
  {
    'Fale novamente com o Cabo Kaleb‡Возвращение к капралу Калебу‡Kehrt zu Korporal Kaleb zurück‡하사관 칼레브에게 돌아가기‡Regresa junto al cabo Kaleb‡Regresa junto al cabo Kaleb‡Il faut rendre à Kaleb ce qui est à Kaleb‡去找卡雷布下士‡向卡雷布下士回報',
    nil,
    'Leve a Caçarola Melhorada do Krazek para o Cabo Kaleb no Acampamento dos Rebeldes, que fica na Selva do Espinhaço Setentrional.‡Принесите исправный горшок Кразека капралу Калебу в Лагерь Повстанцев в Северной Тернистой долине.‡Bringt Krazeks reparierten Topf zu Korporal Kaleb im Rebellenlager im Nördlichen Schlingendorntal.‡북부 가시덤불의 반란군 야영지에 있는 하사관 칼레브에게 크라젝의 수리된 냄비를 가져가야 합니다.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde, en el Norte de la Vega de Tuercespina.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde, en el Norte de la Vega de Tuercespina.‡Rapportez la Marmite de Krazek réparée au Caporal Kaleb, au Camp rebelle, en Strangleronce septentrionale.‡把修理过的烹调锅带给北荆棘谷反抗军营地的卡雷布下士。‡帶著克拉茲克的烹調鍋去北荊棘谷的反抗軍營地給卡雷布下士。',
  }
},
[26766] = {
  {
    'Para grandes presas, grandes iscas‡Большой рыбке большая наживка‡Großes Ziel, großer Köder‡월척은 큰 미끼로‡Un gran cebo para una gran presa‡Un gran cebo para una gran presa‡Aux grosses proies, les gros appâts‡放长线，钓大鱼‡大獵物，用大餌',
    nil,
    'Use a Faca de Mylra para retirar 5 Lombos de Basilisco de Basiliscos Cristajade mortos.‡Воспользуйтесь ножом Милры, чтобы отрезать 5 кусков мяса мертвых нефритобоких василисков.‡Benutzt Mylras Messer, um 5 Basiliskenfleischstücke aus toten Kristallrückenbasilisken zu schneiden.‡마일라의 손칼을 사용하여 죽은 비취볏바실리스크로부터 바실리스크 고기 옆구리살 5덩이를 구해야 합니다.‡Usa el cuchillo de Mylra para obtener 5 costales de carne de basilisco de basiliscos Crestajade muertos.‡Usa el cuchillo de Mylra para obtener 5 costales de carne de basilisco de basiliscos Crestajade muertos.‡Utilisez le Couteau de Mylra pour découper 5 Steaks de basilic sur des Basilics jadecrêtes morts.‡用米尔拉的小刀在死去的玉首蜥蜴身上获得5块蜥蜴肉排。‡使用米爾拉的小刀從死掉的碧冠蜥蜴身上取得5份對半剖開的蜥蜴肉。',
  }
},
[26767] = {
  {
    'Como cumprir missões‡Научиться проходить задания‡Anleitung zur Questerstellung‡퀘스트 만드는 법 배우기‡Figuring out how to make quests‡Figuring out how to make quests‡Comprendre comment créer des quêtes‡弄清楚如何制作任务‡搞懂怎麼設計任務',
    nil,
    'Cumpra uma missão de encaminhamento.‡Выполнить задание о хлебных крошках.‡Erstellt eine Schnitzeljagdquest.‡조그마한 퀘스트를 만들어야 합니다.‡Make a breadcrumb quest.‡Make a breadcrumb quest.‡Créer un début de quête.‡制作一个索引任务。‡製作一個麵包屑任務。',
  }
},
[26768] = {
  {
    'Como domar um dragão‡Поймать дракона‡Drachenfangen leicht gemacht‡용을 잡으려면‡Cazar a un dragón‡Cazar a un dragón‡La capture d’un dragon‡捕龙‡擒龍',
    nil,
    'Obtenha uma Armadilha do Crepúsculo dos Espreita-dragão do Crepúsculo.‡Раздобудьте ловушку для драконов у сумеречных ловцов драконов.‡Besorgt Euch eine Drachenschlinge von den Zwielichtdrachenjägern.‡황혼의 용추적자들로부터 황혼의 올가미를 획득해야 합니다.‡Consigue un cepo de dragón de los acechadragones Crepusculares.‡Consigue un cepo de dragón de los acechadragones Crepusculares.‡Récupérez un Piège à dragon sur les Traqueurs de dragons du Crépuscule.‡从暮光巨龙猎手身上缴获巨龙圈捕器。‡從暮光龍巡者那裡取得暮光陷阱。',
  }
},
[26769] = {
  {
    'Rio em fúria‡Речная прогулка‡Wilde Flussfahrt‡대단한 뱃놀이‡Salvaje travesía fluvial‡Salvaje travesía fluvial‡La croisière s’amuse‡激流之旅‡怒河之旅',
    nil,
    'Embarque na Barcaça de Tito Tocatrompa, a nordeste da Vila Catraca, e vá ao Acampamento do Macambúzio.‡Поговорите с Хортоном Звучным Рогом на северо-востоке от Кабестана, чтобы он подвез вас на лодке к Лагерю Котельника.‡Geht an Bord von Horton Hornbläsers Flussschiff nordöstlich von Ratschet und macht eine Flussfahrt zu Düsentopfs Außenposten.‡톱니항 북동쪽에 있는 호튼 혼블로워의 거룻배를 타고 북부 불모의 땅의 노즐팟의 전초기지에 있는 노즐팟에게 가야 합니다.‡Embárcate en el bote de río de Horton Soplacuernos en el noreste de Trinquete hasta llegar a la Avanzada de Ollaboquilla.‡Embárcate en el bote de río de Horton Soplacuernos en el noreste de Trinquete hasta llegar a la Avanzada de Ollaboquilla.‡Embarquez sur le bateau de Horton Tabarlouche, au nord-est de Cabestan, et remontez la rivière pour aller voir Potuyère à son avant-poste, dans les Tarides du Nord.‡在棘齿城东北乘坐荷尔登·霍恩布洛尔的渡轮前往诺兹波特的哨站。‡到棘齒城的東北方登上荷頓·吹號者的河艇，並搭河艇到管壺前哨。',
  }
},
[26770] = {
  {
    'Mestres místicos‡Мистики-властители‡Mystische Meister‡비술의 달인‡Maestros místicos‡Maestros místicos‡Les maîtres mystiques‡秘法大师‡秘術大師',
    nil,
    'Mate 5 Místicos Pedragulha.‡Убейте 5 мистиков Каменных Игл.‡Tötet 5 Mystiker der Nadelfelsen.‡가시바위 비술사 5마리를 처치해야 합니다.‡Asesina a 5 místicos Rocaguja.‡Asesina a 5 místicos Rocaguja.‡Tuez 5 Mystiques de Rochepointe.‡消灭5名针石秘法师。‡殺死5名針岩秘法師。',
  }
},
[26771] = {
  {
    'O teste da armadilha‡Испытание ловушки‡Fallenprobe‡덫 시험하기‡Probando la trampa‡Probando la trampa‡Le test du piège‡测试陷阱‡測試陷阱',
    nil,
    'Monte a armadilha de carne na fronteira oeste do Planalto de Alabastro.‡Положите мясо в западной части Алебастрового шельфа.‡Legt die Falle mit dem Fleisch am westlichen Ende des Alabasterschelfs aus.‡무쇠 벼랑의 서쪽 끝에 덫이 숨겨진 고기를 올려놓아야 합니다.‡Coloca la carne entrampada en el extremo occidental del Saliente Alabastro.‡Coloca la carne entrampada en el extremo occidental del Saliente Alabastro.‡Déposez la Viande de basilic piégée à l’extrémité ouest de la Corniche d’Albâtre.‡将诱捕蜥蜴肉放在雪玉岩床的西侧尽头。‡將設下陷阱的蜥蜴肉放在雪白岩架的西端。',
  }
},
[26772] = {
  {
    'Visão da mente‡Внутреннее зрение‡Gedankensicht‡마음의 눈‡Visión mental‡Visión mental‡Le truc en plumes‡心灵视界‡心靈幻象',
    nil,
    'Obtenha 5 Penas de Espreitador da Selva dos Espreitadores da Selva na Selva do Espinhaço Setentrional.‡Раздобудьте 5 перьев тропического ловца, что в Северной Тернистой долине.‡Erbeutet 5 Dschungelpirscherfedern von Dschungelpirschern im Nördlichen Schlingendorntal.‡북부 가시덤불에 있는 줄무늬정글랩터로부터 줄무늬정글랩터 깃털 5개를 획득해야 합니다.‡Obtén 5 plumas de acechador de la selva de acechadores de la selva en el Norte de la Vega de Tuercespina.‡Obtén 5 plumas de acechador de la selva de acechadores de la selva, en el Norte de la Vega de Tuercespina.‡Récupérez 5 Plumes de traqueur de la jungle en Strangleronce septentrionale.‡从北荆棘谷丛林捕猎者身上获得5根丛林捕猎者的羽毛。‡在北荊棘谷內的叢林潛獵者身上收集5根叢林潛獵者的羽毛。',
  }
},
[26773] = {
  {
    'Ver raptor‡Увидеть ящера‡Seht Raptor‡랩터 보기‡Visión de raptor‡Visión de raptor‡L’œil du raptor‡看见迅猛龙‡看見迅猛龍',
    nil,
    'Fale com a Sacerdotisa Thaalia no Forte Pedraviva para participar do ritual da Visão da Mente.‡Поговорите со жрицей Тхаалией в форте Ливингстон, чтобы принять участие в ритуале внутреннего зрения.‡Sprecht mit Priesterin Thaalia in Fort Livingston, um am Ritual der Gedankensicht teilzunehmen.‡마음의 눈 의식에 참여하려면 리빙스턴 요새에 있는 여사제 타알리아와 대화해야 합니다.‡Habla con la sacerdotisa Thaalia en Fuerte Livingston para participar en el ritual de Visión mental.‡Habla con la sacerdotisa Thaalia en Fuerte Livingston para participar en el ritual de Visión mental.‡Parlez à la Prêtresse Thaalia, à Fort-Livingston, pour participer au rituel de Vision télépathique.‡跟利文斯顿营地的女祭司萨阿莉亚谈一谈，举行心灵视界仪式。‡和李文斯頓堡壘的女牧師撒亞莉雅談話以加入心靈幻象儀式。',
  }
},
[26774] = {
  {
    'Controle mental‡Контроль над разумом‡Gedankenkontrolle‡정신 지배‡Control mental‡Control mental‡Le troll cérébral‡心灵控制‡精神控制',
    nil,
    'Pegue o Grande Cérebro de Braddok do Braddok em Zul\'Mamwe.‡Добудьте большой мозг Брэддока, убив последнего в Зул\'Мамве.‡Erbeutet Braddoks Riesengehirn von Braddok in Zul\'Mamwe.‡줄맘웨에 있는 브라독에게서 브라독의 비상한 비밀을 캐내야 합니다.‡Obtén el gran cerebro de Braddok de Braddok en Zul\'Mamwe.‡Obtén el gran cerebro de Braddok de Braddok en Zul\'Mamwe.‡Récupérez le Gros cerveau de Braddock, à Zul’Mamwe.‡从祖玛维的布拉多克那里获得他的魔精。‡從祖瑪維廢墟內的布拉多克身上取得布拉多克的大腦。',
  }
},
[26775] = {
  {
    'Ser raptor‡Стать ящером‡Seid Raptor‡랩터 되기‡Sé raptor‡Sé raptor‡Dans la peau d’un raptor‡成为迅猛龙‡成為迅猛龍',
    nil,
    'Fale com a Sacerdotisa Thaalia. Depois, ajude o Filhote Capturado de Batecauda a escapar de Zul\'Gurub.‡Поговорите со жрицей Тхаалией, а затем помогите пойманному детенышу кнутохвоста сбежать из Зул\'Гуруба.‡Sprecht mit Priesterin Thaalia und helft dem gefangenen Schmetterschwanzjungen aus Zul\'Gurub zu fliehen.‡여사제 타알리아와 대화하고 사로잡힌 아기 채찍꼬리랩터가 줄구룹에서 도망칠 수 있게 도와야 합니다.‡Habla con la sacerdotisa Thaalia y ayuda a la prole de colazote capturada a escapar de Zul\'Gurub.‡Habla con la sacerdotisa Thaalia y ayuda a la prole de colazote capturada a escapar de Zul\'Gurub.‡Parlez à la Prêtresse Thaalia, et aidez le Jeune flagellant capturé à s’échapper de Zul’Gurub.‡跟女祭司萨阿莉亚谈一谈，帮助被抓住的鞭尾幼龙逃出祖尔格拉布。‡和女牧師撒亞莉雅談話，然後幫助被俘虜的小鞭尾迅猛龍逃離祖爾格拉布。',
  }
},
[26776] = {
  {
    'Ghaliri‡Галири‡Ghaliri‡갈리리‡Ghaliri‡Ghaliri‡Rencontre avec Ghaliri‡格哈利尼‡加利瑞',
    nil,
    'Fale com Ghaliri no Forte Pedraviva, que fica na Selva do Espinhaço Setentrional.‡Поговорите с Галири в форте Ливингстон в Северной Тернистой долине.‡Kehrt zu Ghaliri in Fort Livingston im Nördlichen Schlingendorntal zurück.‡북부 가시덤불의 리빙스턴 요새에 있는 갈리리에게 보고해야 합니다.‡Preséntate ante Ghaliri en Fuerte Livingston, en el Norte de la Vega de Tuercespina.‡Preséntate ante Ghaliri en Fuerte Livingston, en el Norte de la Vega de Tuercespina.‡Présentez-vous à Ghaliri, à Fort-Livingston, en Strangleronce septentrionale.‡去找北荆棘谷利文斯顿营地的格哈利尼。‡回北荊棘谷的李文斯頓堡壘找加利瑞報告。',
  }
},
[26777] = {
  {
    'Acalmar os espíritos‡Успокоение духов‡Beruhigt die Geister‡영혼 달래기‡Reconfortando a los espíritus‡Reconfortando a los espíritus‡Apaisons les esprits‡抚慰灵魂‡安撫魂靈',
    nil,
    'Use o Incensório Sagrado para acalmar 5 Espíritos Desamparados no Sítio dos Aguiar.‡Воспользуйтесь священной курильницей, чтобы успокоить 5 неприкаянных духов в усадьбе Эддла.‡Beruhigt 5 verlorene Geister in Addles Siedlung.‡애들 농장에서 신성한 향로를 사용하여 5명의 외로운 영혼을 달래야 합니다.‡Utiliza el incensario sagrado para reconfortar 5 espíritus melancólicos en la Granja de Addle.‡Utiliza el incensario sagrado para reconfortar 5 espíritus melancólicos en la Granja de Addle.‡Utilisez l’Encensoir sacré pour apaiser 5 Esprits chagrins à la Ferme des Addle.‡在腐草农场使用神圣香炉抚慰5名弃灵。‡使用神聖香爐在腐草農場安撫5個棄靈。',
  }
},
[26778] = {
  {
    'O lamento dos mortos‡Крики мертвых‡Die Schreie der Toten‡망자의 비명‡El lamento de los muertos‡El lamento de los muertos‡Les hurlements des morts‡亡者的哭泣‡死者的危機',
    nil,
    'Mate 20 carniçais de qualquer espécie no Cemitério de Monte Corvo.‡Убейте 20 любых вурдалаков на Кладбище Вороньего Холма.‡Tötet 20 beliebige Ghule auf dem Friedhof von Rabenflucht.‡까마귀 언덕 묘지에서 구울 20마리를 처치해야 합니다.‡Mata a 20 necrófagos cualesquiera en el Cementerio del Cerro del Cuervo.‡Mata a 20 necrófagos cualesquiera en el Cementerio del Cerro del Cuervo.‡Tuez 20 goules de n’importe quel type au Cimetière de Colline-aux-corbeaux.‡在乌鸦岭墓地杀死20只任意种类的食尸鬼。‡在烏鴉嶺墓園殺死20個任何種類的食屍鬼。',
  }
},
[26779] = {
  {
    'Mambo Zul\'Mamwe‡Пляски Зул\'Мамве‡Mambo in Zul\'Mamwe‡줄맘웨 맘보‡El mambo de Zul\'Mamwe‡El mambo de Zul\'Mamwe‡Le mambo de Zul’Mamwe‡祖玛维曼波‡祖瑪維曼波',
    nil,
    'Mate 16 Trolls Rachacrânio em Zul\'Mamwe.‡Убейте 16 троллей из племени Дробителей Черепов в Зул\'Мамве.‡Tötet 16 Schädelspaltertrolle im Inneren von Zul\'Mamwe.‡줄맘웨에 있는 백골가루 트롤 16명을 처치해야 합니다.‡Mata a 16 trols Machacacráneos en Zul\'Mamwe.‡Mata a 16 trols Machacacráneos en Zul\'Mamwe.‡Tuez 16 Trolls casse-crânes dans Zul’mamwe.‡杀死祖玛维里的16名劈颅巨魔。‡在祖瑪維殺死16名劈顱食人妖。',
  }
},
[26780] = {
  {
    'A noite na selva‡Ночь в джунглях‡Wenn es Nacht wird im Dschungel‡밀림의 밤‡Noche en la jungla‡Noche en la jungla‡Un mauvais éclairage‡丛林之夜‡在叢林的夜晚',
    nil,
    'Apague 8 Braseiros de Zul\'Mamwe em Zul\'Mamwe, que fica na Selva do Espinhaço Setentrional.‡Потушите 8 жаровен в Зул\'Мамве, что в Северной Тернистой долине.‡Löscht 8 Kohlenpfannen von Zul\'Mamwe in Zul\'Mamwe im Nördlichen Schlingendorntal.‡북부 가시덤불의 줄맘웨에 있는 줄맘웨 화로 8개를 꺼야 합니다.‡Apaga 8 braseros de Zul\'Mamwe en Zul\'Mamwe, en el Norte de la Vega de Tuercespina.‡Apaga 8 blandones de Zul\'Mamwe en Zul\'Mamwe, en el Norte de la Vega de Tuercespina.‡Éteignez 8 Braseros de Zul\'Mamwe, en Strangleronce septentrionale‡扑灭北荆棘谷祖玛维的8个祖玛维火盆。‡到北荊棘谷的祖瑪維熄掉8個祖瑪維火盆。',
  }
},
[26781] = {
  {
    'O Olho da Mente‡Око разума‡Das Gedankenauge‡마음의 눈‡El Ojo de la mente‡El Ojo de la mente‡La vue de l\'esprit‡心灵之眼‡心靈之眼',
    nil,
    'Pegue o Olho da Mente de Mai\'Zoth.‡Отберите у Май\'Зота Око разума.‡Nehmt Mai\'Zoth das Gedankenauge ab.‡마이조스로부터 마음의 눈을 획득해야 합니다.‡Obtén el Ojo de la mente de Mai\'Zoth.‡Obtén el Ojo de la mente de Mai\'Zoth.‡Emparez-vous de la Vue de l’esprit gardée par Mai’Zoth.‡从麦佐斯那里获得心灵之眼。‡從麥佐斯身上取得心靈之眼。',
  }
},
[26782] = {
  {
    'O tesouro Mosh\'Ogg‡Сокровища клана Мош\'Огг‡Die Schatzkiste der Mosh\'Ogg‡모쉬오그 노획물‡La recompensa Mosh\'Ogg‡La recompensa Mosh\'Ogg‡Le trésor des Mosh’Ogg‡莫什奥格的馈赠‡莫什奧格贈物',
    nil,
    'Pegue o Tesouro Mosh\'Ogg nas ruínas atrás da Gruta de Mosh\'Ogg.‡Добудьте сокровища клана Мош\'Огг из руин за курганом.‡Erbeutet die Schatzkiste der Mosh\'Ogg aus den Ruinen hinter dem Ogerhügel der Mosh\'Ogg.‡모쉬오그 오우거 소굴의 뒤에 있는 폐허에서 모쉬오그 노획물을 획득해야 합니다.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Récupérez le Trésor des Mosh’Oggs dans les ruines derrière le Tertre des ogres Mosh’Ogg.‡从莫什奥格食人魔山后的废墟里获得莫什奥格的馈赠。‡從莫什奧格巨魔山後方的廢墟取得莫什奧格贈物。',
  }
},
[26783] = {
  {
    'O tesouro Mosh\'Ogg‡Сокровища клана Мош\'Огг‡Die Schatzkiste der Mosh\'Ogg‡모쉬오그 노획물‡La recompensa Mosh\'Ogg‡La recompensa Mosh\'Ogg‡Le trésor des Mosh’Ogg‡莫什奥格的馈赠‡莫什奧格贈物',
    nil,
    'Pegue o Tesouro Mosh\'Ogg nas ruínas atrás da Gruta de Mosh\'Ogg.‡Добудьте сокровища клана Мош\'Огг из руин за курганом.‡Erbeutet die Schatzkiste der Mosh\'Ogg aus den Ruinen hinter dem Ogerhügel der Mosh\'Ogg.‡모쉬오그 오우거 소굴의 뒤에 있는 폐허에서 모쉬오그 노획물을 획득해야 합니다.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Obtén la recompensa Mosh\'Ogg de las ruinas bajo el Túmulo Ogro Mosh\'Ogg.‡Récupérez le Trésor des Mosh’Oggs dans les ruines derrière le Tertre des ogres Mosh’Ogg.‡从莫什奥格食人魔山后的废墟里获得莫什奥格的馈赠。‡從莫什奧格巨魔山後方的廢墟取得莫什奧格贈物。',
  }
},
[26784] = {
  {
    'Águas lamacentas‡Мутная вода‡Schlammiges Wasser‡진흙 묻은 물의 정령‡Aguas embarradas‡Aguas embarradas‡En eau trouble‡泥浆与水‡泥水',
    nil,
    'Mate Elementais de Água Turva para coletar 5 Núcleos do Redemoinho.‡Убивайте илистых элементалей воды, пока не соберете 5 сердцевин водоворота.‡Tötet schlammige Wasserelementare und sammelt 5 Strudelkerne.‡진흙 묻은 물의 정령을 처치하고 기포 핵 5개를 모아야 합니다.‡Mata a elementales de agua embarrados para coger 5 núcleos de tolvanera.‡Mata a elementales de agua embarrados para coger 5 núcleos de tolvanera.‡Tuez des Élémentaires d\'eau boueux pour récupérer 5 Cœurs du tourbillon.‡消灭泥浆水元素以收集5颗漩涡之核。‡殺死泥濘水元素並收集5個渦流核。',
  }
},
[26785] = {
  {
    'Membro da matilha‡Часть стаи‡Mitglied der Meute‡무리의 일원‡Miembro de la manada‡Miembro de la manada‡Un membre de la meute‡族群的一部分‡狼群之一',
    nil,
    'Fale com o Aprendiz Zembucha na encruzilhada a oeste da Vila Sombria, que fica na Floresta do Crepúsculo.‡Поговорите с учеником Фессом на перекрестке дорог к западу от Темнолесья, что в Сумеречном лесу.‡Sprecht mit Lehrling Fess an der Kreuzung westlich von Dunkelhain im Dämmerwald.‡그늘숲 어둠골의 서쪽 교차로에서 수습생 페스와 대화해야 합니다.‡Habla con el aprendiz Fess en el cruce del oeste de Villa Oscura en el Bosque del Ocaso.‡Habla con el aprendiz Fess en el cruce del oeste de Villa Oscura en el Bosque del Ocaso.‡Allez voir l’Apprenti Foss au Carrefour ouest de Sombre-Comté, dans le Bois de la Pénombre.‡跟暮色森林夜色镇西边十字路口的学徒菲斯谈一谈。‡在暮色森林西邊夜色鎮的十字路口和學徒費斯談話。',
  }
},
[26786] = {
  {
    'A vigília da cabeça da praia‡Захват плацдарма‡Den Landungspunkt sichern‡상륙 거점 확보‡Asegurar la cabeza de playa‡Asegurar la cabeza de playa‡La tête de pont‡确保滩头阵地‡確保灘頭安全',
    nil,
    'Fale com Artesh no Porto Presa do Dragão, que fica no Planalto do Crepúsculo.‡Поговорите с Артеш в порту Драконьей Пасти на Сумеречном нагорье.‡Sprecht mit Artesh im Hafen des Drachenmals im Schattenhochland.‡황혼의 고원의 용아귀 항구에 있는 아테시와 대화해야 합니다.‡Habla con Artesh en el Puerto Faucedraco, en las Tierras Altas Crepusculares.‡Habla con Artesh en el Puerto Faucedraco, en las Tierras Altas Crepusculares.‡Allez voir Artesh au port Gueule-de-dragon, dans les Hautes-terres du Crépuscule.‡同暮光高地龙喉哨站的阿泰什交谈。‡和位於暮光高地龍喉港的阿特須談談。',
  }
},
[26787] = {
  {
    'Lembrete‡Медвежьи мозги‡Bärendienst‡곰곰이 곰을 생각하라‡Cerebros de oso‡Cerebros de oso‡Il ne faut pas vendre la cervelle de l’ours…‡熊脑子‡熊的腦海裡',
    nil,
    'Pegue 8 Cérebros de Urso Preto.‡Добудьте 8 мозгов черного медведя.‡Sammelt 8 Gehirne von Schwarzbären‡검은곰 뇌 8개를 모아야 합니다.‡Recoge 8 cerebros de oso negro.‡Recoge 8 cerebros de oso negro.‡Prélevez 8 Cervelles d’ours noirs.‡获得8副黑熊脑。‡收集8個黑熊腦。',
  }
},
[26788] = {
  {
    'O tijolinho que faltava para nossa vitória‡Закрепление успехов‡Unseren Sieg untermauern‡승리 굳히기‡Preparando nuestra victoria‡Preparando nuestra victoria‡Une victoire à finaliser‡巩固胜果‡黏牢我們的勝利',
    nil,
    'Colete 10 porções de Lama do Rio Verrall.‡Соберите 10 порций ила из Вералла.‡Sammelt 10 Haufen Verrallschlamm.‡베랄 강 진흙 10덩이를 모아야 합니다.‡Recoge 10 montones de mugre del Río Verrall.‡Recoge 10 montones de mugre del Río Verrall.‡Récupérez 10 tas de Boue de la Verralle.‡收集10份瓦拉尔河淤泥。‡收集10堆維羅河的污泥。',
  }
},
[26789] = {
  {
    'You no take axe!‡You no take axe!‡Die Axt im Walde‡너 도끼 못 가져간다!‡You no take axe!‡You no take axe!‡Toi pas prendre hache !‡You no take axe!‡不准拿斧頭!',
    nil,
    'Kill 5 Test Kobolds.‡Kill 5 Test Kobolds.‡Tötet 5 Test-Kobolde‡시험용 코볼트 5마리를 처치해야 합니다.‡Kill 5 Test Kobolds.‡Kill 5 Test Kobolds.‡Tuez 5 Kobolds de test.‡Kill 5 Test Kobolds.‡殺死五隻狗頭人。',
  }
},
[26790] = {
  {
    '‡‡Magmadar muss sterben!‡‡‡‡Magmadar doit mourir !‡‡',
    nil,
    '‡‡Bringt Magmadars Kopf zu Thrall im Steinkrallengebirge.‡‡‡‡Ramenez la Tête de Magmadar à Thrall dans les Serres-rocheuses.‡‡',
  }
},
[26791] = {
  {
    'Brotos nunca mais‡Больше никакой растительности‡Wie Pilze aus dem Boden‡곰팡이는 이제 그만‡No más brotes‡No más brotes‡Silence, ça pousse !‡不准再种了‡停止滋生',
    nil,
    'Interaja com um Guardião de Guerra e conquiste-o. Em seguida, destrua 5 Cogumelos Gigantes.‡Получите боевого стража и уничтожьте с его помощью 5 гигантских грибов.‡Interagiert mit einem Kriegswächter und benutzt ihn, um 5 Riesenpilze zu vernichten.‡전쟁 수호자를 선택하여 획득한 다음, 거대 버섯 5개를 파괴해야 합니다.‡Hazte con un guardián de guerra y acaba con 5 champiñones gigantes.‡Hazte con un guardián de guerra y acaba con 5 champiñones gigantes.‡Interagissez avec un Gardien de guerre et prenez-en le contrôle, puis détruisez 5 Champignons géants.‡启动并获得一具战争守护者，然后摧毁5朵巨蘑菇。‡搭乘一具戰爭守護者，然後摧毀5株巨大蘑菇。',
  }
},
[26792] = {
  {
    'Monstros fúngicos‡Грибные чудовища‡Fungusmissgeburten‡곰팡이 흉물‡Monstruosidades fúngicas‡Monstruosidades fúngicas‡Les monstruosités fongiques‡真菌怪兽‡真菌巨怪',
    nil,
    'Mate 5 Monstros Fúngicos.‡Уничтожьте 5 грибных чудовищ.‡Tötet 5 Fungusmissgeburten.‡곰팡이 흉물 5마리를 처치해야 합니다.‡Asesina a 5 monstruosidades fúngicas.‡Asesina a 5 monstruosidades fúngicas.‡Tuez 5 Monstruosités fongiques.‡消灭5个真菌怪兽。‡殺死5個真菌巨怪。',
  }
},
[26793] = {
  {
    'A velha lápide‡Заброшенная могила‡Das verwitterte Grab‡오래된 무덤‡La lápida desgastada‡La lápida desgastada‡La tombe érodée‡破旧的坟墓‡飽經風霜的墓碑',
    nil,
    'Fale com Sirra Von\'Indi na Vila Sombria.‡Поговорите с Широй Фон-Инди в Темнолесье.‡Sprecht mit Sirra Von\'Indi in Dunkelhain.‡어둠골의 시라 본인디와 대화해야 합니다.‡Ve a Villa Oscura y habla con Sirra Von\'Indi.‡Ve a Villa Oscura y habla con Sirra Von\'Indi.‡Allez voir Sirra Von\'Indi à Sombre-Comté.‡跟夜色镇的希拉·沃宁迪谈一谈。‡和夜色鎮的希拉·沃甯迪談話。',
  }
},
[26794] = {
  {
    'Morgan Ladimore‡Морган Ладимор‡Morgan Ladimore‡모건 래디모어‡Morgan Ladimor‡Morgan Ladimor‡Morgan Ladimore‡摩根·拉迪莫尔‡摩根·拉迪莫爾',
    nil,
    'Fale com a Comandante Aldora Ebanez na Vila Sombria.‡Поговорите с командиром Алтеей Чернодрев в Темнолесье.‡Sprecht mit Kommandantin Althea Schwarzhaupt in Dunkelhain.‡어둠골의 사령관 알시아 이본로크와 대화해야 합니다.‡Ve a Villa Oscura y habla con la comandante Althea Cerranegro.‡Ve a Villa Oscura y habla con la comandante Althea Cerranegro.‡Parlez à Althea Bouclenoire à Sombre-Comté.‡跟夜色镇的指挥官阿尔泰娅·埃伯洛克谈一谈。‡到夜色鎮和指揮官奧爾希雅·埃伯洛克談話。',
  }
},
[26795] = {
  {
    'Mor\'Ladim‡Мор\'Ладим‡Mor\'Ladim‡모르라딤‡Mor\'Ladim‡Mor\'Ladim‡Mor\'Ladim‡摩拉迪姆‡摩拉迪姆',
    nil,
    'Mate Mor\'Ladim e entregue a caveira dele para a Comandante Aldora Ebanez na Vila Sombria.‡Убейте Мор\'Ладима и отнесите его череп командиру Альтее Чернодрев в Темнолесье.‡Tötet Mor\'Ladim und bringt seinen Schädel zu Kommandantin Althea Schwarzhaupt in Dunkelhain.‡모르라딤을 처치한 다음 그의 해골을 어둠골의 사령관 알시아 이본로크에게 가져가야 합니다.‡Mata a Mor\'Ladim y luego lleva su calavera a la comandante Althea Cerranegro a Villa Oscura.‡Mata a Mor\'Ladim y luego lleva su calavera a la comandante Althea Cerranegro a Villa Oscura.‡Tuez Mor\'Ladim, puis rapportez son crâne au Commandant Althea Bouclenoire, à Sombre-Comté.‡杀死摩拉迪姆，然后将他的徽记交给夜色镇的指挥官阿尔泰娅·埃伯洛克。‡殺掉摩拉迪姆，把他的頭骨交給夜色鎮的指揮官奧爾希雅‧埃伯洛克。',
  }
},
[26796] = {
  {
    'A filha sobrevivente‡Выжившая дочь‡Die überlebende Tochter‡살아남은 딸‡La hija superviviente‡La hija superviviente‡La fille qui avait survécu‡幸存的女儿‡倖存的女兒',
    nil,
    'Fale com a Vigia Sarah Ladimore na Vila Sombria.‡Поговорите с дозорным Сарой Ладимор в Темнолесье.‡Sprecht mit Behüterin Sarah Ladimore in Dunkelhain.‡어둠골의 순찰대원 사라 래디모어와 대화해야 합니다.‡Ve a Villa Oscura y habla con la vigilante Sarah Ladimor.‡Ve a Villa Oscura y habla con la vigilante Sarah Ladimor.‡Parlez à la Gardienne Sarah Ladimore à Sombre-Comté.‡跟夜色镇的守夜人莎拉·拉迪莫尔谈一谈。‡到夜色鎮與守夜人薩拉·拉迪莫爾交談。',
  }
},
[26797] = {
  {
    'Amor de filha‡Дочерняя любовь‡Die Liebe einer Tochter‡딸의 사랑‡El amor de una hija‡El amor de una hija‡L\'amour d\'une fille‡女儿的爱‡女兒的愛',
    nil,
    'Leve o anel de Sarah Ladimore até o túmulo de Morgan Ladimore.‡Отнесите кольцо Сары Ладимор на могилу Моргана Ладимора.‡Bringt Sarah Ladimores Ring zu Morgan Ladimores Grab.‡사라 래디모어의 반지를 모건 래디모어의 무덤으로 가져가야 합니다.‡Lleva el anillo de Sarah Ladimor a la tumba de Morgan Ladimor.‡Lleva el anillo de Sarah Ladimor a la tumba de Morgan Ladimor.‡Déposez la bague de Sarah Ladimore sur la tombe de Morgan Ladimore.‡把莎拉·拉迪莫尔的戒指拿到摩根·拉迪莫尔的坟墓上去。‡把薩拉·拉迪莫爾的戒指拿到摩根·拉迪莫爾的墳墓上去。',
  }
},
[26798] = {
  {
    'A satisfação do Chefe Guerreiro‡Вождь будет доволен‡Der Kriegshäuptling wird zufrieden sein‡대족장이 기뻐할 소식‡El Jefe de Guerra estará complacido‡El Jefe de Guerra estará complacido‡Pour faire plaisir au chef de guerre‡酋长会很高兴的‡大酋長會很高興的',
    nil,
    'Use o portal no Porto Presa do Dragão para ir até Orgrimmar e apresente-se a Garrosh Grito Infernal.‡Отправляйтесь через портал в порту Драконьей Пасти в Оргриммар и явитесь с докладом к Гаррошу Адскому Крику.‡Benutzt das Portal im Hafen des Drachenmals, um nach Orgrimmar zu gelangen. Meldet Euch dort bei Garrosh Höllschrei.‡용아귀 항구에 있는 차원문을 통해 오그리마로 가서, 가로쉬 헬스크림에게 보고해야 합니다.‡Usa el portal que hay en el Puerto Faucedraco para ir a Orgrimmar e informar a Garrosh Grito Infernal.‡Usa el portal que hay en el Puerto Faucedraco para ir a Orgrimmar e informar a Garrosh Grito Infernal.‡Utilisez le portail du port Gueule-de-dragon pour retourner à Orgrimmar et faire un rapport à Garrosh Hurlenfer.‡使用龙喉哨站的传送门前往奥格瑞玛，向加尔鲁什·地狱咆哮报告。‡使用龍喉港的傳送門前往奧格瑪並向卡爾洛斯·地獄吼回報。',
  }
},
[26799] = {
  {
    'Aqueles que não puderam ser salvos‡Те, кого уже не спасти‡Die nicht gerettet werden konnten‡구원받을 수 없는 존재들‡Aquellos que no pudieron salvarse‡Aquellos que no pudieron salvarse‡Ceux qui n’ont pas pu être sauvés‡不可拯救的死者‡無法被拯救的人',
    nil,
    'Mate 6 Zumbis Desmiolados.‡Убейте 6 безмозглых зомби.‡Tötet 6 hirnlose Zombies.‡넋 나간 좀비 6마리를 처치해야 합니다.‡Mata a 6 zombis descerebrados.‡Mata a 6 zombis descerebrados.‡Tuez 6 Zombies décérébrés.‡消灭6个无脑的僵尸。‡殺死6個無腦的殭屍。',
  }
},
[26800] = {
  {
    'Recrutamento‡Вербовка‡Rekrutierung‡신병 모집‡Reclutamiento‡Reclutamiento‡Une moisson de corps‡清扫战场‡徵募新兵',
    nil,
    'Procure em Plangemortis e redondezas por 6 Cadáveres Escarlates e, em seguida, aponte para eles para que Darnell possa pegá-los.‡Обыщите Похоронный Звон и его окрестности, найдите 6 тел рыцарей Алого ордена и укажите на них Дарнеллу, чтобы он мог их собрать.‡Durchsucht Todesend und die Umgebung nach 6 Leichnamen der Scharlachroten, dann zeigt auf sie, damit Darnell sie einsammelt.‡죽음의 종소리 마을과 그 주변에서 붉은십자군 시체 6구를 찾은 뒤 다넬이 운반할 수 있도록 지정해야 합니다.‡Registra Camposanto y alrededores en busca de 6 cadáveres Escarlata y señálalos para que Darnell pueda recogerlos.‡Registra Camposanto y alrededores en busca de 6 cadáveres Escarlata y señálalos para que Darnell pueda recogerlos.‡Fouillez le Glas et ses environs à la recherche de 6 Cadavres écarlates, puis montrez-les à Darnell pour qu’il puisse les ramasser.‡在丧钟镇及其周边地区找到6具血色十字军尸体，然后指指它们，让达内尔去搬运。‡搜尋喪鐘鎮和鄰近地區，找出6具血色十字軍的屍體。然後點出他們的位置，好讓達納爾撿拾。',
  }
},
[26801] = {
  {
    'Flagelo nas proximidades‡Плеть вокруг‡Geißel an unseren Grenzen‡경계선의 스컬지‡Plaga en nuestro perímetro‡Plaga en nuestro perímetro‡Le Fléau est dans nos murs‡境内的天灾‡周遭的天譴軍團',
    nil,
    'Mate 8 mortos-vivos fora de Plangemortis. Você pode matar tanto Carniçais Ignóbeis quanto Esqueletos Range-ossos.‡Убейте 8 скелетов-костетрясов или презренных вурдалаков в Похоронном Звоне.‡Tötet 8 Untote außerhalb von Todesend. Ihr könnt sowohl elende Ghule als auch klappernde Skelette töten.‡죽음의 종소리 마을 외부 지역에서 언데드 8명을 처치해야 합니다. 흉측한 구울이나 덜그럭거리는 해골을 처치하면 임무를 완수할 수 있습니다.‡Mata 8 no-muertos fuera de Camposanto. Puedes matar necrófagos desdichados o esqueletos armadóseos.‡Mata 8 no-muertos fuera de Camposanto. Puedes matar necrófagos desdichados o esqueletos armadóseos.‡Tuez 8 morts-vivants autour du Glas. Vous pouvez tuer des Goules déshéritées ou des Squelettes cliquethorax.‡在丧钟镇外消灭8个亡灵。无脑的食尸鬼和断骨骷髅都算数。‡在喪鐘鎮外面殺死8個不死族。你可以殺悲慘的食屍鬼或斷骨骷髏。',
  }
},
[26802] = {
  {
    'Os malditos‡Проклятые‡Die Verdammten‡저주받은 존재‡Los Malditos‡Los Malditos‡Les Maudits‡被诅咒者‡被詛咒者',
    nil,
    'Obtenha 4 Patas de Carniceiro e 4 Asas de Quiropúsculo.‡Раздобудьте 4 лапы падальщика и 4 крыла сумеречницы.‡Besorgt 4 Aasfressertatzen und 4 Nachtsaugerflügel.‡승냥이 앞발 4개와 그늘박쥐 날개 4개를 획득해야 합니다.‡Consigue 4 garras de carroñero y 4 alas de Murciumbrío.‡Consigue 4 garras de carroñero y 4 alas de Murciumbrío.‡Récupérez 4 Pattes de charognard et 4 Ailes de chauve-souris de la pénombre.‡收集4只食腐狼的爪子和4只夜行蝙蝠翼。‡取得4隻食腐狼的爪子和4隻夜行蝙蝠翼。',
  }
},
[26803] = {
  {
    'Relatórios perdidos‡Недостающие рапорты‡Fehlende Berichte‡행방불명된 보고‡¿Dónde están esos informes?‡¿Dónde están esos informes?‡Les rapports manquants‡迟到的报告‡遺失的報告',
    nil,
    'Fale com Doraso, o tratador de mantícoras de Orgrimmar.‡Поговорите с Дорасом, хозяином ветрокрылов в Оргриммаре.‡Sprecht mit Windreitermeister Doras in Orgrimmar.‡오그리마의 와이번 조련사인 도라스와 대화해야 합니다.‡Habla con Doras, el maestro de jinetes del viento de Orgrimmar.‡Habla con Doras, el maestro de jinetes del viento de Orgrimmar.‡Allez voir le maître des coursiers du vent d\'Orgrimmar, Doras.‡与奥格瑞玛的双足飞龙管理员多拉斯谈一谈。‡和奧格瑪的雙足飛龍管理員朵拉斯談談。',
  }
},
[26804] = {
  {
    'Voo até o Monte Navalha‡Перелет в Колючий Холм‡Flug nach Klingenhügel‡칼바위 언덕으로‡Vuelo a Cerrotajo‡Vuelo a Cerrotajo‡Un vol pour Tranchecolline‡飞往剃刀岭‡飛往剃刀嶺',
    nil,
    'Fale com Doraso para conseguir uma passagem de mantícora até o Monte Navalha. Ao chegar lá, fale com Gar\'Thok.‡Обратитесь к Дорасу, чтобы добраться на ветрокрыле до Колючего Холма. По прибытии разыщите Га\'тока.‡Sprecht mit Doras, um einen Windreiterflug nach Klingenhügel zu erwerben. Sobald Ihr angekommen seid, sprecht mit Gar\'Thok.‡도라스와 대화하여 칼바위 언덕으로 가는 와이번 사용료를 내야 합니다. 도착하면 가르톡과 대화하십시오.‡Habla con Doras para comprar un viaje en jinete del viento a Cerrotajo. Una vez allí, habla con Gar\'Thok.‡Habla con Doras para comprar un viaje en jinete del viento a Cerrotajo. Una vez allí, habla con Gar\'Thok.‡Allez voir Doras pour acheter un vol en coursier du vent vers Tranchecolline. Une fois arrivé, allez voir Gar\'Thok.‡与多拉斯交谈，租用一只双足飞龙前往剃刀岭。抵达之后，去找加索克。‡與朵拉斯交談以購買飛往剃刀嶺的雙足飛龍行程。當你抵達時，與加索克交談。',
  }
},
[26805] = {
  {
    'Para o Cabo!‡На мыс!‡Auf zum Kap!‡가시덤불 곶으로!‡¡Hacia el Cabo!‡¡Hacia el Cabo!‡Cap sur le cap !‡去海角！‡前往海角!',
    nil,
    'Fale com Robert Rhodes para conseguir um voo para a Escavação da Liga dos Exploradores, no Cabo do Espinhaço.‡Поговорите с Робертом Родсом о полете к Раскопкам Лиги исследователей на мысе Тернистой долины.‡Sprecht mit Robert Rhodes, um einen Flug zu der Grabungsstätte der Forscherliga am Schlingendornkap zu bekommen.‡로버트 로도스와 대화하여 가시덤불 곶의 탐험가 연맹 발굴현장으로 가야 합니다.‡Habla con Robert Rhodes para conseguir un vuelo a la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Habla con Robert Rhodes para conseguir un vuelo a la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Parlez à Robert Rhodes pour obtenir un vol à destination du Site de fouilles de la Ligue des explorateurs, au Cap Strangleronce.‡跟罗伯特·洛德斯谈一谈，飞往荆棘谷海角的探险者协会挖掘场。‡飛往荊棘谷海角的探險者協會挖掘場，並和羅伯特·洛迪斯談話。',
  }
},
[26806] = {
  {
    'Relatórios para Orgrimmar‡Рапорты в Оргриммар‡Berichte für Orgrimmar‡오그리마로 가서 보고하기‡Informes a Orgrimmar‡Informes a Orgrimmar‡Des rapports pour Orgrimmar‡送往奥格瑞玛的报告‡給奧格瑪的報告',
    nil,
    'Leve os Relatórios de Gar\'Thok para Burok, no Monte Navalha.‡Доставьте донесения Га\'тока Буроку на Колючий Холм.‡Bringt Gar\'Thoks Berichte zu Burok in Klingenhügel.‡칼바위 언덕에 있는 부로크에게 가르톡의 보고서를 가져가야 합니다.‡Lleva los informes de Gar\'Thol a Burok en Cerrotajo.‡Lleva los informes de Gar\'Thol a Burok en Cerrotajo.‡Apportez les Rapports de Gar\'Thok à Burok, à Tranchecolline‡将加索克的报告交给剃刀岭的波洛克。‡將加索克的報告拿去給剃刀嶺的布羅克。',
  }
},
[26807] = {
  {
    'De volta a Eitrigg‡Назад к Эйтриггу‡Rückkehr zu Etrigg‡아이트리그에게로‡Vuelve a Eitrigg‡Vuelve a Eitrigg‡Retourner voir Eitrigg‡向伊崔格复命‡回去找伊崔格',
    nil,
    'Fale com Burok e compre uma passagem de volta para Orgrimmar. Em Orgrimmar, leve os Relatórios de Gar\'Thok para Eitrigg no Vale da Força.‡Обратитесь к Буроку и наймите ветрокрыла, чтобы вернуться в Оргриммар. Приземлившись в Оргриммаре, передайте рапорт Га\'тока Эйтриггу на Аллее Силы.‡Sprecht mit Burok und erwerbt einen Flug zurück nach Orgrimmar. Sobald Ihr gelandet seid, bringt Gar\'thoks Berichte zu Etrigg im Tal der Stärke.‡오그리마로 돌아가는 비행편을 사려면 부로크와 대화해야 합니다. 오그리마에 도착하면 힘의 골짜기에 있는 아이트리그에게 가르톡의 보고서를 가져가야 합니다.‡Habla con Burok y compra un vuelo de vuelta a Orgrimmar. Una vez en Orgrimmar, lleva los informes de Gar\'Thok a Eitrigg en el Valle de la Fuerza.‡Habla con Burok y compra un vuelo de vuelta a Orgrimmar. Una vez en Orgrimmar, lleva los informes de Gar\'Thok a Eitrigg en el Valle de la Fuerza.‡Parlez à Burok et achetez un vol pour retourner à Orgrimmar. Une fois là-bas, apportez les Rapports de Gar\'Thok à Eitrigg, dans la Vallée de la Force.‡与波洛克交谈，租用双足飞龙回到奥格瑞玛。抵达奥格瑞玛之后，将加索克的报告交给力量谷中的伊崔格。‡和布羅克談談並使用飛行服務回到奧格瑪。到達後，將加索克的報告拿去給位於力量谷的伊崔格。',
  }
},
[26808] = {
  {
    'Maywiki‡Мейвики‡Maywiki‡메이위키‡Maywiki‡Maywiki‡Maywiki‡梅维克‡梅維基',
    nil,
    'Leve o Presente de Linzi para Maywiki de Zuldazar na Escavação da Liga dos Exploradores.‡Передайте подарок Линзи Мейвики Зулдазарской на Раскопках Лиги исследователей.‡Bringt Linzis Geschenk zu Maywiki von Zuldazar, die sich an der Grabungsstätte der Forscherliga befindet.‡탐험가 연맹 발굴현장에 있는 줄다자르의 메이위키에게 린지의 선물을 가져가야 합니다.‡Lleva el regalo de Linzi a Maywiki de Zuldazar en la Excavación de la Liga de Expedicionarios.‡Lleva el regalo de Linzi a Maywiki de Zuldazar en la Excavación de la Liga de Expedicionarios.‡Apportez le cadeau de Linzi à Maywiki de Zuldazar, au Site de fouilles de la Ligue des explorateurs.‡把琳兹的礼物给探险者协会挖掘场的祖达萨的梅维克带去。‡將林姬的贈禮帶去探險者協會挖掘場的祖達薩給梅維基。',
  }
},
[26809] = {
  {
    'Negócios obscuros‡Тайные сделки‡Durch die Hintertür‡뒷거래‡Tratos bajo mano‡Tratos bajo mano‡Les écoutes totémiques‡幕后交易‡後門的勾當',
    nil,
    'Coloque o Incenso de Gurubashi em frente ao Totem de Hir\'eek. Em seguida, escute o plano de Zanzil.‡Положите благовония Гурубаши напротив тотема Хир\'ика и выведайте планы Занзила.‡Legt den Weihrauch der Gurubashi vor das Totem von Hir\'eek und lauscht dann Zanzils Verschwörung.‡히르이크의 토템 앞에 구루바시 향료를 놓고 잔질의 계획을 들어야 합니다.‡Coloca el incienso Gurubashi frente al tótem de Hir\'eek y escucha el plan de Zanzil.‡Coloca el incienso Gurubashi frente al tótem de Hir\'eek y escucha el plan de Zanzil.‡Placez l’Encens gurubashi devant le Totem d\'Hir\'eek, puis écoutez les plans de Zanzil.‡将古拉巴什熏香放在希里克图腾前，然后听取赞吉尔的阴谋。‡將古拉巴什薰香放在希爾雷克圖騰前，然後聆聽贊吉爾的陰謀。',
  }
},
[26810] = {
  {
    'Eliminando o pária‡Убить Отверженного‡Beseitigt den Ausgestoßenen‡추방자 제거‡Elimina al Desterrado‡Elimina al Desterrado‡L\'élimination du Paria‡消灭流亡者‡殲滅流亡者',
    nil,
    'Vá para as Ruínas de Aboraz no Cabo do Espinhaço e mate Zanzil, o Pária.‡Отправляйтесь в руины Абораза, что на мысе Тернистой долины, и убейте Занзила Отверженного.‡Begebt Euch zu den Ruinen von Aboraz am Schlingendornkap und nehmt Euch Zanzil den Ausgestoßenen vor.‡가시덤불 곶의 아보라즈의 폐허로 가서 추방자 잔질을 처리해야 합니다.‡Viaja a las Ruinas de Aboraz, en El Cabo de Tuercespina y encárgate de Zanzil el Desterrado.‡Viaja a las Ruinas de Aboraz, en El Cabo de Tuercespina y encárgate de Zanzil el Desterrado.‡Allez aux Ruines d’Aboraz, au Cap Strangleronce, et occupez-vous de Zanzil le Paria.‡前往荆棘谷海角阿博拉兹废墟对付流亡者赞吉尔。‡前往荊棘谷海角的阿博拉茲廢墟，料理掉『流亡者』贊吉爾。',
  }
},
[26811] = {
  {
    'Pelo buraco do troll‡Троллья дыра‡Durch das Trollloch‡트롤의 구멍을 지나‡A través del agujero trol‡A través del agujero trol‡Le troll qui se cachait dans un trou‡穿过巨魔洞‡穿越食人妖洞穴',
    nil,
    'Use o Portal de Zanzil para entrar em Zul\'Gurub.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Maywiki na Escavação da Liga dos Exploradores.‡Воспользуйтесь порталом Занзила и отправляйтесь в Зул\'Гуруб.|n|nЕсли заблудитесь или вам потребуется вернуться в Зул\'Гуруб, поговорите с Мейвики на Раскопках Лиги исследователей.‡Benutzt Zanzils Portal und betretet Zul\'Gurub.|n|nWenn Ihr Euch verirrt oder nach Zul\'Gurub zurückkehren müsst, sprecht mit Maywiki an der Grabungsstätte der Forscherliga.‡잔질의 차원문을 통해 줄구룹에 들어가야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면 탐험가 연맹 발굴현장의 메이위키와 대화해야 합니다.‡Usa el portal de Zanzil y entra en Zul\'Gurub.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Usa el portal de Zanzil y entra en Zul\'Gurub.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Utilisez le Portail de Zanzil pour entrer dans Zul’Gurub. |n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Maywiki, au Site de fouilles de la Ligue des explorateurs.‡用赞吉尔的传送门进入祖尔格拉布。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡使用贊吉爾的傳送門進入祖爾格拉布。|n|n如果你迷路了或是需要回到祖爾格拉布，在探險者協會挖掘場和梅維基說話。',
  }
},
[26812] = {
  {
    'Alta-sacerdotisa Jeklik‡Верховная жрица Джеклик‡Hohepriesterin Jeklik‡대여사제 제클릭‡Suma sacerdotisa Jeklik‡Suma sacerdotisa Jeklik‡La grande prêtresse Jeklik‡高阶祭司耶克里克‡高階祭司耶克里克',
    nil,
    'Destrua o corpo da Alta-sacerdotisa Jeklik antes que Zanzil consiga ressuscitá-la.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Maywiki na Escavação da Liga dos Exploradores.‡Уничтожьте тело верховной жрицы Джеклик, прежде чем Занзил ее воскресит.|n|nЕсли вы заблудитесь или вам понадобится вернуться в Зул\'Гуруб, поговорите с Мейвики на Раскопках Лиги исследователей.‡Zerstört den Leib von Hohepriesterin Jeklik, bevor Zanzil sie wiederbeleben kann.|n|nWenn Ihr Euch verirrt oder nach Zul\'Gurub zurückkehren müsst, sprecht mit Maywiki an der Grabungsstätte der Forscherliga.‡잔질이 부활시키기 전에 대여사제 제클릭의 몸을 파괴해야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면, 탐험가 연맹 발굴현장의 메이위키와 대화해야 합니다.‡Destruye el cuerpo de la suma sacerdotisa Jeklik antes de que Zanzil pueda resucitarla.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Destruye el cuerpo de la suma sacerdotisa Jeklik antes de que Zanzil pueda resucitarla.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Détruisez le corps de la Grande prêtresse Jeklik avant que Zanzil ne puisse la ressusciter.|n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Maywiki, au Site de fouilles de la Ligue des explorateurs.‡在赞吉尔复活他之前消灭高阶祭司耶克里克。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡在贊吉爾將她復活之前摧毀高階祭司耶克里克的屍體。|n|n如果你迷路或需要回去祖爾格拉布，在探險者協會挖掘場和梅維基說話。',
  }
},
[26813] = {
  {
    'Cada vez mais fundo em Zul\'Gurub‡Путешествие в Зул\'Гуруб‡Hals über Kopf nach Zul\'Gurub‡줄구룹으로 뛰어들다‡Hacia lo más profundo de Zul\'Gurub‡Hacia lo más profundo de Zul\'Gurub‡Au cœur de Zul’Gurub‡身陷祖尔格拉布‡鎮壓祖爾格拉布',
    nil,
    'Atravesse o Portal de Zanzil.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Maywiki na Escavação da Liga dos Exploradores.‡Пройдите через портал Занзила.|n|nЕсли потеряетесь или захотите вернуться в Зул\'Гуруб, поговорите с Мейвики на Раскопках Лиги исследователей.‡Benutzt Zanzils Portal.|n|nWenn Ihr Euch verirrt oder nach Zul\'Gurub zurückkehren müsst, sprecht mit Maywiki an der Grabungsstätte der Forscherliga.‡잔질의 차원문을 통과해야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면 탐험가 연맹 발굴현장의 메이위키와 대화해야 합니다.‡Atraviesa el portal de Zanzil.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Atraviesa el portal de Zanzil.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Franchissez le Portail de Zanzil. |n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Maywiki au Site de fouilles de la Ligue des explorateurs.‡穿过赞吉尔的传送门。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡穿過贊吉爾的傳送門。|n|n如果你迷路了或是需要回到祖爾格拉布，在探險者協會挖掘場和梅維基說話。',
  }
},
[26814] = {
  {
    'Sumo sacerdote Venoxis‡Верховный жрец Веноксис‡Hohepriester Venoxis‡대사제 베녹시스‡Sumo sacerdote Venoxis‡Sumo sacerdote Venoxis‡Le grand prêtre Venoxis‡高阶祭司温诺希斯‡高階祭司溫諾希斯',
    nil,
    'Mate Zanzil, o Pária, e o Sumo Sacerdote Venoxis.|n|nSe você se perder ou precisar voltar para Zul\'Gurub, fale com Maywiki na Escavação da Liga dos Exploradores.‡Разберитесь с Занзилом Отверженным и верховным жрецом Веноксисом.|n|nЕсли заблудитесь или захотите вернуться в Зул\'Гуруб, поговорите с Мейвики на Раскопках Лиги исследователей.‡Kümmert Euch um Zanzil den Ausgestoßenen und Hohepriester Venoxis.|n|nWenn Ihr Euch verirrt oder nach Zul\'Gurub zurückkehren müsst, sprecht mit Maywiki an der Grabungsstätte der Forscherliga.‡추방자 잔질과 대사제 베녹시스를 처리해야 합니다.|n|n만약 길을 잃거나 줄구룹으로 돌아가야 한다면, 탐험가 연맹 발굴현장의 메이위키와 대화해야 합니다.‡Encárgate de Zanzil el Desterrado y del sumo sacerdote Venoxis.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Encárgate de Zanzil el Desterrado y del sumo sacerdote Venoxis.|n|nSi te pierdes o necesitas volver a Zul\'Gurub, habla con Maywiki en la Excavación de la Liga de Expedicionarios.‡Affrontez Zanzil le Paria et le Grand prêtre Venoxis.|n|nSi vous vous perdez ou si vous avez besoin de retourner à Zul’Gurub, parlez à Maywiki, au Site de fouilles de la Ligue des explorateurs.‡对付流亡者赞吉尔和高阶祭司温诺希斯。|n|n假如你迷路了或者需要回到祖尔格拉布，去跟探险者协会挖掘场的梅维克交谈。‡料理掉『流亡者』贊吉爾和高階祭司溫諾希斯。|n|n如果你迷路或需要回去祖爾格拉布，在探險者協會挖掘場和梅維基說話。',
  }
},
[26815] = {
  {
    'O segredo de Zanzil‡Тайна Занзила‡Zanzils Geheimnis‡잔질의 비법‡El secreto de Zanzil‡El secreto de Zanzil‡Le secret de Zanzil‡赞吉尔的秘密‡贊吉爾的秘密',
    nil,
    'Obtenha 5 ampolas do Preparado de Zanzil.‡Добудьте 5 сосудов со смесью Занзила.‡Beschafft 5 Phiolen mit Zanzils Mixtur.‡잔질의 혼합물을 5병 모아야 합니다.‡Consigue 5 viales de la mezcla de Zanzil.‡Consigue 5 viales de la mezcla de Zanzil.‡Récupérez 5 fioles de Mixture de Zanzil.‡获取5瓶赞吉尔的药剂。‡取得5份贊吉爾的混合試劑。',
  }
},
[26816] = {
  {
    'Receita de desastre‡Рецепт катастрофы‡Zutaten für eine Katastrophe‡재앙의 조제법‡Receta para el desastre‡Receta para el desastre‡La recette du malheur‡灾难的配方‡災難的配方',
    nil,
    'Obtenha a Formulação de Zanzil de um dos seguidores de Zanzil nas Ruínas de Aboraz.‡Раздобудьте рецептуру Занзила у одного из приспешников Занзила в руинах Абораза.‡Beschafft Zanzils Rezeptur von einem seiner Anhänger in den Ruinen von Aboraz.‡아보라즈의 폐허에 있는 잔질의 추종자에게서 잔질의 조제식을 획득해야 합니다.‡Consigue la formulación de Zanzil de uno de los seguidores de Zanzil en las Ruinas de Aboraz.‡Consigue la formulación de Zanzil de uno de los seguidores de Zanzil en las Ruinas de Aboraz.‡Trouvez la Formule de Zanzil sur l’un de ses suivants, dans les Ruines d’Aboraz‡从阿博拉兹废墟赞吉尔的追随者手里获得赞吉尔的配方。‡從阿博拉茲廢墟的一名贊吉爾追隨者那裡取得贊吉爾的配方。',
  }
},
[26817] = {
  {
    'Perfeitamente puro‡Идеальная чистота‡Das Reinheitsgebot‡순수함 그 자체‡Perfectamente pura‡Perfectamente pura‡Une pureté parfaite‡纯天然‡完美純淨',
    nil,
    'Consiga a Água Pura do Olho-d\'água Nek\'mani no Cabo do Espinhaço.‡Наберите святой воды ясности из родника Нек\'мани на мысе Тернистой долины.‡Beschafft das heilige Wasser der Klarheit aus dem Nek\'maniquellbrunnen am Schlingendornkap.‡가시덤불 곶의 네크마니 수원지에서 청명의 성수를 획득해야 합니다.‡Consigue el agua bendita de claridad en el Manantial Nek\'mani, en El Cabo de Tuercespina.‡Consigue el agua bendita de claridad en el Manantial Nek\'mani, en El Cabo de Tuercespina.‡Puisez de L’eau bénite de clarté dans la Fontaine des Nek\'mani, au Cap Strangleronce.‡从荆棘谷海角纳克迈尼圣泉里打上澄澈圣水。‡從荊棘谷海角的納克邁尼聖泉取得聖水。',
  }
},
[26818] = {
  {
    'Pelos macios‡Мягкие шкуры‡Plüschpelze‡호화로운 모피‡Pieles lujosas‡Pieles lujosas‡De douces fourrures‡绒皮‡長毛絨皮草',
    nil,
    'Obtenha 4 Peles Flexíveis de Tigresa e 4 Peles de Pantera Aveludadas.‡Добудьте 4 мягких тигриных шкуры и 4 бархатистых шкуры пантеры.‡Beschafft 4 geschmeidige Tigerinnenfelle und 4 samtige Pantherfelle.‡부드러운 암호랑이 모피 4개와 보들보들한 표범 모피 4개를 모아야 합니다.‡Obtén 4 pelajes de tigre flexibles y 4 pelajes de pantera aterciopelados.‡Obtén 4 pelajes de tigre flexibles y 4 pelajes de pantera aterciopelados.‡Procurez-vous 4 Fourrures souples de tigresse et 4 Fourrures veloutées de panthère.‡剥来4张柔软的虎皮和4张光滑的猎豹皮。‡取得4張柔軟的雌虎毛皮和4張光滑的獵豹毛皮。',
  }
},
[26819] = {
  {
    'Akiris aos montes‡Вязанка акириса‡Bündelweise Akiris‡아키리스 묶음‡Tallos de juncos akiris‡Tallos de juncos akiris‡De derrière les fagots‡海蛇草论捆卖‡一捆海蛇草',
    nil,
    'Obtenha 6 Juncos de Akiris das Exploradoras Nagas.‡Добыть 6 стеблей акириса у наг-исследователей.‡Beschafft 6 Bündel Akirisschilfrohr von den Forschern der Naga.‡나가 탐험가로부터 아키리스 갈대 6개를 모아야 합니다.‡Obtén 6 juncos akiris de los expedicionarios naga.‡Obtén 6 juncos akiris de los expedicionarios naga.‡Prenez 6 Roseaux akiris aux Explorateurs nagas.‡从纳迦探险者身上获得6捆海蛇草。‡從納迦探險者那裡取得6份海蛇草。',
  }
},
[26820] = {
  {
    'Se elas estão largadas por aí...‡Если они собираются просто оставить это на земле...‡Wenn sie sie einfach herumliegen lassen ...‡그냥 바닥에 버려둘 물건이라면...‡Si las van a dejar tiradas por ahí...‡Si las van a dejar tiradas por ahí...‡Ramasse ce qui traîne par terre et tiens ton roseau à deux mains...‡要是他们就把它们那么搁着的话……‡如果他們不想撿...',
    nil,
    'Obtenha 6 Ícones de Naga da Costa Selvagem Sul, que fica no Cabo do Espinhaço.‡Добудьте 6 нагских идолов с Южного Гибельного Берега на мысе Тернистой долины.‡Beschafft 6 Nagaikonen von der Südlichen Ungezähmten Küste am Schlingendornkap.‡가시덤불 곶의 폭풍 해안 남부에서 나가 상징 6개를 모아야 합니다.‡Obtén 6 iconos naga de la Costa Salvaje del Sur en El Cabo de Tuercespina.‡Obtén 6 iconos naga de la Costa Salvaje del Sur en El Cabo de Tuercespina.‡Emparez-vous de 6 Icônes nagas de la Côte Sauvage du Sud, au Cap Strangleronce‡从荆棘谷海角南野人海岸获得6尊纳迦雕像。‡從荊棘谷海角的南野人海岸那裡取得6個納迦雕像。',
  }
},
[26821] = {
  {
    'Airwyn Bantamflax‡Айрвин Куропуша‡Airwyn Bantamflax‡에어윈 밴텀플랙스‡Airwyn Bantamflax‡Airwyn Bantamflax‡Airwyn Coquaulin‡艾尔温·短麻‡艾爾溫·班塔弗拉斯',
    nil,
    'Leve o Tesouro Mosh\'Ogg Aberto à Airwyn Bantamflax na Angra do Butim, que fica no Cabo do Espinhaço.‡Отнесите открытый сундук сокровищ клана Мош\'Огг Айрвин Куропуше в Пиратскую Бухту, находящуюся на мысе Тернистой долины.‡Bringt die geöffnete Schatzkiste der Mosh\'Ogg zu Airwyn Bantamflax in Beutebucht am Schlingendornkap.‡가시덤불 곶의 무법항에 있는 에어윈 밴텀플랙스에게 열린 모쉬오그 노획물을 가져가야 합니다.‡Lleva la recompensa de Mosh\'ogg abierta a Airwyn Bantamflax en la Bahía del Botín en El Cabo Tuercespina.‡Lleva la recompensa de Mosh\'ogg abierta a Airwyn Bantamflax en la Bahía del Botín en El Cabo Tuercespina.‡Apporter le Trésor des Mosh’Ogg ouvert à Airwyn Coquaulin, à Baie-du-Butin, au Cap Strangleronce.‡把打开的莫什奥格的馈赠带给荆棘谷海角藏宝海湾的艾尔温·短麻。‡將開啟的莫什奧格贈物帶去荊棘谷海角的藏寶海灣給艾爾溫·班塔弗拉斯。',
  }
},
[26822] = {
  {
    'Cães-rastejantes inúteis‡Шавки паршивые‡Nichtsnutzige, züngelnde Kriecher‡아무짝에도 쓸모없는 놈들‡Inútiles perros reptantes‡Inútiles perros escurridizos‡D’sacrés bons à rien d’chiens galeux‡一无是处是虫蛇‡該死的滑石走狗',
    nil,
    'Mate 12 basiliscos Ferroqueixo ou Batecauda.‡Уничтожьте 12 василисков-хвостохлестов или железозубых василисков.‡Tötet 12 Donnerschwanz- oder Eisenkieferbasilisken.‡무쇠꼬리, 또는 무쇠턱바실리스크를 12마리 처치해야 합니다.‡Mata a 12 basiliscos Colastador o Quijahierro.‡Mata a 12 basiliscos Colastador o Quijahierro.‡Tuez 12 Basilics flagelleurs ou gueule-de-fer‡杀死12条钢尾蜥蜴或铁腭蜥蜴。‡殺死12隻鋼尾蜥蜴或鐵顎蜥蜴。',
  }
},
[26823] = {
  {
    'Ele acha que é "o cara"‡Слишком большой для своих штанов‡Den Mund zu voll genommen‡심한 거드름‡Más chulo que un ocho‡Más chulo que un ocho‡De bonnes humeurs‡自卖自夸‡放不進口袋的大小',
    nil,
    'Consiga um frasco de Humor Aquoso de Ferroqueixo de um Beemote Ferroqueixo na Mina Veia de Cristal.‡Наберите флакон телесной жидкости железнозуба у железнозубого чудища в Хрустальной шахте.‡Beschafft eine Phiole mit Eisenkieferkörperflüssigkeit vom Eisenkieferungetüm in der Kristalladermine.‡수정 광산에 있는 거대 무쇠턱바실리스크로부터 무쇠턱 체액을 획득해야 합니다.‡Consigue un vial de humor de Quijahierro del behemoth Quijahierro en la Mina de Cristal.‡Consigue un vial de humor de Quijahierro del behemoth Quijahierro en la Mina de Cristal.‡Récupérez une fiole d’Humeur de gueule-de-fer d’un Béhémoth gueule-de-fer dans la Mine aux Cristaux.‡从水晶矿洞的铁腭巨兽身上获得一瓶铁腭的体液。‡從水晶礦坑中的鐵顎巨蜥獸那裡取得一瓶鐵顎的玻璃體膠質。',
  }
},
[26824] = {
  {
    'Resultado: inconclusivo‡Неопределенные результаты‡Ergebnisse: Nicht eindeutig‡결론: 확인 불가‡Resultados no concluyentes‡Resultados no concluyentes‡Beaucoup de bruit pour rien‡结果：不可辨识‡結果:無可結論',
    nil,
    'Leve o Tesouro Mosh\'Ogg Aberto de volta para Bronwyn no Acampamento da Liga dos Exploradores, que fica no Cabo do Espinhaço.‡Верните открытый сундук сокровищ клана Мош\'Огг Бронвину в лагерь Лиги исследователей на мысе Тернистой долины.‡Bringt die geöffnete Schatzkiste der Mosh\'Ogg zu Bronwyn im Lager der Forscherliga am Schlingendornkap zurück.‡가시덤불 곶의 탐험가 연맹 야영지에 있는 브론윈에게 열린 모쉬오그 노획물을 가져가야 합니다.‡Devuelve la recompensa Mosh\'Ogg abierta a Bronwyn en la Excavación de la Liga de Expedicionarios, en El Cabo de Tuercespina.‡Devuelve la recompensa Mosh\'Ogg abierta a Bronwyn en la Excavación de la Liga de Expedicionarios, en El Cabo de Tuercespina.‡Apportez le Trésor des Mosh’ogg ouvert à Bronwyn, au Site de fouilles de la Ligue des explorateurs, au Cap Strangleronce.‡把打开的莫什奥格的馈赠还给荆棘谷海角探险者协会营地的布朗温。‡將開啟的莫什奧格贈物帶去荊棘谷海角的探險者協會挖掘場給布朗尼恩。',
  }
},
[26825] = {
  {
    'Dask Chiabisca, o "Frasco"‡Даск "Пузырь" Гоблопшик‡Dask "Der Kolben" Fusselmaul‡"영약쟁이" 다스크 곱피즐‡Dask "Matraz" Pegaboca‡Dask "Matraz" Pegaboca‡Dask « le Flacon » Tombegob‡达斯克·“空瓶”·哥布菲兹‡達斯克『水壺』唾嘶',
    nil,
    'Leve o Tesouro Mosh\'Ogg Aberto para o Dask Chiabisca, o "Frasco", na Escavação da Liga dos Exploradores, que fica no Cabo do Espinhaço.‡Отнесите открытый сундук сокровищ клана Мош\'Огг Даску "Пузырю" Гоблопшику на Раскопках Лиги исследователей, что на мысе Тернистой долины.‡Bringt die geöffnete Schatzkiste der Mosh\'Ogg zu Dask "Der Kolben" Fusselmaul in der Grabungsstätte der Forscherliga am Schlingendornkap.‡가시덤불 곶의 탐험가 연맹 발굴현장에 있는 "영약쟁이" 다스크 곱피즐에게 열린 모쉬오그 노획물을 가져가야 합니다.‡Lleva la recompensa Mosh\'Ogg abierta a Dask "Matraz" Pegaboca en la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Lleva la recompensa Mosh\'Ogg abierta a Dask "Matraz" Pegaboca en la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Apportez le Trésor des Mosh’ogg ouvert à Dask « le Flacon » Tombegob, au Site de fouilles de la Ligue des explorateurs, au Cap Strangleronce.‡把打开的莫什奥格的馈赠带给荆棘谷海角探险者协会挖掘场的达斯克·“空瓶”·哥布菲兹。‡將開啟的莫什奧格贈物帶去荊棘谷海角的探險者協會挖掘場給達斯克『水壺』唾嘶。',
  }
},
[26826] = {
  {
    'Dask Chiabisca, o "Frasco"‡Даск "Пузырь" Гоблопшик‡Dask "Der Kolben" Fusselmaul‡"영약쟁이" 다스크 곱피즐‡Dask "Matraz" Pegaboca‡Dask "Matraz" Pegaboca‡Dask « le Flacon » Tombegob‡达斯克·“空瓶”·哥布菲兹‡達斯克『水壺』唾嘶',
    nil,
    'Leve o Tesouro Mosh\'Ogg Aberto para o Dask Chiabisca, o "Frasco", na Escavação da Liga dos Exploradores, que fica no Cabo do Espinhaço.‡Отнесите открытый сундук сокровищ клана Мош\'Огг Даску "Пузырю" Гоблопшику на Раскопках Лиги исследователей, что на мысе Тернистой долины.‡Bringt die geöffnete Schatzkiste der Mosh\'Ogg zu Dask "Der Kolben" Fusselmaul in der Grabungsstätte der Forscherliga am Schlingendornkap.‡가시덤불 곶의 탐험가 연맹 발굴현장에 있는 "영약쟁이" 다스크 곱피즐에게 열린 모쉬오그 노획물을 가져가야 합니다.‡Lleva la recompensa Mosh\'Ogg abierta a Dask "Matraz" Pegaboca en la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Lleva la recompensa Mosh\'Ogg abierta a Dask "Matraz" Pegaboca en la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Apportez le Trésor des Mosh’ogg ouvert à Dask « le Flacon » Tombegob, au Site de fouilles de la Ligue des explorateurs, au Cap Strangleronce.‡把打开的莫什奥格的馈赠带给荆棘谷海角探险者协会挖掘场的达斯克·“空瓶”·哥布菲兹。‡將開啟的莫什奧格贈物帶去荊棘谷海角的探險者協會挖掘場給達斯克『水壺』唾嘶。',
  }
},
[26827] = {
  {
    'Incentivando a Harmonia Telúrica‡Сбор Служителей Земли‡Den Irdenen Ring zusammenrufen‡대지 고리회를 결집하라‡Reuniendo al Anillo de la Tierra‡Reuniendo al Anillo de la Tierra‡Le ralliement du Cercle terrestre‡召集大地之环‡集結陶土議會',
    nil,
    'Convoque 5 xamãs na parte de trás do Templo da Terra. Em seguida, fale com Maruut Atapedras.‡Соберите 5 шаманов в дальней части Храма Земли, а затем поговорите с Маруутом Камневязом.‡Versammelt 5 Schamanen im hinteren Teil des Tempels der Erde und sprecht dann mit Maruut Steinbinder.‡대지의 사원 뒤쪽에 있는 주술사 5명을 결집한 다음, 마루트 스톤바인더와 대화해야 합니다.‡Reúne a 5 chamanes en la parte trasera del Templo de la Tierra y después habla con Maruut Amarrapiedra.‡Reúne a 5 chamanes en la parte trasera del Templo de la Tierra y después habla con Maruut Amarrapiedra.‡Ralliez 5 Chamans qui se trouvent à l’arrière du Temple de la Terre, puis allez voir Maruut Lieur-de-Pierre.‡从大地神殿后面的房间中集结5名萨满，然后跟玛鲁特·缚石谈一谈。‡在大地神殿的後面集結5名薩滿，然後去和瑪魯特·縛石者談話。',
  }
},
[26828] = {
  {
    'Trato é trato‡Наша часть сделки‡Unser Teil der Vereinbarung‡우리가 약속한 것‡Nuestra parte del trato‡Nuestra parte del trato‡Notre part du marché‡我们那份协议‡我們該負的責任',
    nil,
    'Fale com Therazane no Egresso Halcion.‡Поговорите с Теразан в Пределе Безмятежности.‡Sprecht mit Therazane auf dem Halcyonaufstieg.‡평온의 출구에 있는 테라제인과 대화해야 합니다.‡Habla con Therazane en el Egreso Próspero.‡Habla con Therazane en el Egreso Próspero.‡Allez parler à Therazane à l’Émergence d’Halcyon.‡跟哈尔西恩法阵的塞拉赞恩谈一谈。‡在翠鳥出口上和瑟拉贊恩談話。',
  }
},
[26829] = {
  {
    'A marcha da pedra‡Каменный марш‡Der Steinmarsch‡바위의 행군‡La marcha pétrea‡La marcha pétrea‡La marche des pierres‡岩石进军‡石之進發',
    nil,
    'Mate 15 Sectários do Abismo do Crepúsculo.‡Убейте 15 сектантов Сумеречной пропасти.‡Tötet 15 Kultisten des Zwielichthangs.‡황혼의 낭떠러지에 있는 이교도 15명을 처치해야 합니다.‡Mata a 15 cultores del Precipicio Crepuscular.‡Mata a 15 cultores del Precipicio Crepuscular.‡Tuez 15 Sectateurs du Précipice du Crépuscule.‡消灭15名暮光绝壁邪教徒。‡殺死15名暮光絕壁教徒。',
  }
},
[26830] = {
  {
    'A isca do traidor‡Приманка для предателя‡Köder für den Verräter‡반역자 색출‡Cebo para traidores‡Cebo para traidores‡Un appât à traîtres‡引蛇出洞‡背叛者的誘餌',
    nil,
    'Interrogue os Peões da Ponte Aérea de Orgrimmar em volta das Torres de Zepelim. Procure por qualquer Peão Suspeito. Tente expulsar Sauranok, o Místico, e mate-o.‡Идите к башням для дирижаблей. Допросите работников Оргриммарских доков. Ищите тех, кто вызывает подозрения. Постарайтесь разоблачить Сауранока Мистика и убить его.‡Befragt Peons des Himmelpfads von Orgrimmar in der Nähe des Zeppelinturms. Haltet Ausschau nach verdächtigen Peons. Versucht, Sauranok den Mystiker aufzuscheuchen und tötet ihn.‡비행선 탑승장 근처의 오그리마 하늘길 일꾼을 심문해야 합니다. 수상한 일꾼이 없는지 잘 살피십시오. 신비주의자 사우라노크의 정체를 밝히고, 그를 처치해야 합니다.‡Interroga a los peones de ruta aérea de Orgrimmar alrededor de las torres de zepelines. Busca a cualquier peón sospechoso. Intenta descubrir a Sauranok el Místico y mátalo.‡Interroga a los peones de ruta aérea de Orgrimmar alrededor de las torres de zepelines. Busca a cualquier peón sospechoso. Intenta descubrir a Sauranok el Místico y mátalo.‡Interrogez des Péons du couloir aérien d\'Orgrimmar autour des tours des zeppelins. Cherchez ceux qui ont l\'air suspect. Essayez de débusquer Sauranok le Mystique et tuez-le.‡质问飞艇塔附近的奥格瑞玛空港苦工。寻找任何可疑的苦工。想办法把萨乌拉诺克揪出来杀掉。‡到飛艇塔去審問奧格瑪航路苦工。找出可疑的苦工。試著引出『秘法師』索拉諾克並且將他殺死。',
  }
},
[26831] = {
  {
    'A revoada do Crepúsculo‡Сумеречный полет‡Flug ins Zwielicht‡황혼의 비행‡El Vuelo Crepuscular‡El Vuelo Crepuscular‡Le Vol crépusculaire‡暮光飞行军‡暮光空軍',
    nil,
    'Derrote Zoltrik, o Mata-dragão.‡Победите Золтрика Драконьера.‡Besiegt Zoltrik Drachenbann.‡졸트릭 드레이크베인을 처치해야 합니다.‡Derrota a Zoltrik Aterradracos.‡Derrota a Zoltrik Aterradracos.‡Tuez Zoltrik Plaie-des-drakes.‡击败佐尔奇克·龙灾。‡擊敗佐特里克‧滅龍者。',
  }
},
[26832] = {
  {
    'A misericórdia de Therazane‡Милость Теразан‡Therazanes Gnade‡테라제인의 자비‡La compasión de Therazane‡La compasión de Therazane‡La clémence de Therazane‡塞拉赞恩的怜悯‡瑟拉贊恩的慈悲',
    nil,
    'Derrote Boldrich Racha-pedras e a Alta-sacerdotisa Lorthuna.‡Победите Болдрика Стоунрендера и верховную жрицу Лортуну.‡Besiegt Boldrich Steinreißer und Hohepriesterin Lorthuna.‡볼드리치 스톤렌더와 대여사제 로르투나를 처치해야 합니다.‡Derrota a Boldrich Creapiedras y a la Suma sacerdotisa Lorthuna.‡Derrota a Boldrich Creapiedras y a la Suma sacerdotisa Lorthuna.‡Tuez Boldrich Arrache-pierre et la grande prêtresse Lorthuna.‡击败碎石者博尔德里克和高阶女祭司洛苏娜。‡擊敗波德里克·碎石和高階女祭司洛舒娜。',
  }
},
[26833] = {
  {
    'Promessa lavrada em pedra‡Каменное слово‡In Stein gemeißelt‡바위에 새긴 약속‡Palabra grabada en la roca‡Palabra grabada en la roca‡Gravé dans la pierre‡石中的文字‡石之諾言',
    nil,
    'Fale com Maruut Atapedras no Templo da Terra.‡Поговорите с Маруутом Камневязом в Храме Земли.‡Sprecht mit Maruut Steinbinder am Tempel der Erde.‡대지의 사원에 있는 마루트 스톤바인더와 대화해야 합니다.‡Habla con Maruut Amarrapiedra en el Templo de la Tierra.‡Habla con Maruut Amarrapiedra en el Templo de la Tierra.‡Allez parler à Maruut Lieur-de-Pierre au Temple de la Terre.‡跟大地神殿的玛鲁特·缚石谈一谈。‡在大地神殿裡和瑪魯特·縛石者談話。',
  }
},
[26834] = {
  {
    'No fundo do abismo‡В расщелину‡Hinein in den Abgrund‡협곡 속으로‡En el interior de la sima‡En el interior de la sima‡Au fond du gouffre‡深入裂口‡深入裂谷',
    nil,
    'Fale com Ardósio Movediço na Fenda Pedragulha, que fica no Geodomo.‡Поговорите со Сланцем Плывуном у Провала Каменных Игл в Подземье.‡Sprecht mit Schiefer Treibsand in der Nadelfelsschlucht in Tiefenheim.‡심원의 영지의 가시바위 협곡에 있는 슬레이트 퀵샌드와 대화해야 합니다.‡Habla con Pizarra Arenamovediza en la Sima Rocaguja en Infralar.‡Habla con Pizarra Arenamovediza en la Sima Rocaguja en Infralar.‡Allez voir Ardoise Sable-mouvant au Gouffre de Rochepointe, dans le Tréfonds.‡跟深岩之洲针石熔渣场的斯雷特·流沙谈一谈。‡在地深之源裡的針岩裂谷和史雷特·流沙說話。',
  }
},
[26835] = {
  {
    'Um pequeno percalço...‡Небольшая проблема‡Ein kleines Problem‡사소한 문제‡Un pequeño problema‡Un pequeño problema‡Un petit problème‡小麻烦‡小麻煩',
    nil,
    'Fale novamente com Pírio Magneto na Vila Pedragulha, que fica no Geodomo.‡Вернитесь к Колчедану Магнетию в Шлаковый зал, что в Подземье.‡Kehrt zu Pyrium Leitstein im Nadelfelsbruch in Tiefenheim zurück.‡심원의 영지의 가시바위 잔여지에 있는 파이리움 로드스톤에게 가야 합니다.‡Vuelve con Pirium Magnetita a Fosa Rocaguja en Infralar.‡Vuelve con Pirium Magnetita a Fosa Rocaguja en Infralar.‡Retournez voir Pyrium Magnétite au Gouffre de Rochepointe, dans le Tréfonds.‡去找深岩之洲针石熔渣场的燃钢·磁石。‡到地深之源的針岩熔渣找黃鐵·磁石。',
  }
},
[26836] = {
  {
    'Resgate o Petrarca... e o Sílex‡Спасите Отца-Скалу… и Флинта‡Rettet den Steinvater... und Flint‡바위 아버지도 구하고, 플린트도 구하고‡Rescata al Padre Pétreo... y a Sílex‡Rescata al Padre Pétreo... y a Sílex‡Il faut sauver le Père-Roc… et Silex‡营救石父……还有弗林特‡解救石父...和弗林特',
    nil,
    'Liberte o Petrarca Rochamanto.‡Освободите Отца-Скалу Железную Мантию.‡Befreit Steinvater Erzmantel.‡바위 아버지 오어맨틀을 풀어줘야 합니다.‡Libera al Padre Pétreo Mantomena.‡Libera al Padre Pétreo Mantomena.‡Libérez le Père-Roc Mantemine.‡解救石父岩幔。‡解放石父礦被。',
  }
},
[26837] = {
  {
    'A escavação da Liga dos Exploradores‡Раскопки Лиги исследователей‡Die Grabungsstätte der Forscherliga‡탐험가 연맹 발굴현장‡La Excavación de la Liga de Expedicionarios‡La Excavación de la Liga de Expedicionarios‡Le site de fouilles de la Ligue des explorateurs‡探险者协会挖掘场‡探險者協會挖掘場',
    nil,
    'Apresente-se a Bronwyn Talho na Escavação da Liga dos Exploradores, que fica no Cabo do Espinhaço.‡Поговорите с Бронвином Зарубаем на Раскопках Лиги исследователей, что на мысу Тернистой долины.‡Sprecht mit Bronwyn Hackschlag an der Grabungsstätte der Forscherliga am Schlingendornkap.‡가시덤불 곶의 탐험가 연맹 발굴현장에 있는 브론윈 휴스트라이크에게 보고해야 합니다.‡Preséntate ante Bronwyn Labragolpe en la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Preséntate ante Bronwyn Labragolpe en la Excavación de la Liga de Expedicionarios en El Cabo de Tuercespina.‡Présentez-vous à Bronwyn Piquefrappe, au Site de fouilles de la Ligue des explorateurs, au Cap Strangleronce.‡去找荆棘谷海角探险者协会挖掘场的布朗温·斧击。‡到荊棘谷海角的探險者協會挖掘場向布朗尼恩·砍擊回報。',
  }
},
[26838] = {
  {
    'Rebeldes sem causa‡Безыдейные повстанцы‡Wenn man keine Ahnung hat ...‡대책없는 반란군‡Rebeldes sin pistas‡Rebeldes sin pistas‡Les rebelles de la forêt‡无果的反叛‡毫無線索的叛亂',
    nil,
    'Fale com o Tenente Doren no Acampamento dos Rebeldes, que fica na Selva do Espinhaço Setentrional.‡Отправляйтесь к лейтенанту Дорену в Лагерь Повстанцев в Северной Тернистой долине.‡Meldet Euch bei Leutnant Doren im Rebellenlager im Nördlichen Schlingendorntal.‡북부 가시덤불의 반란군 야영지에 있는 부관 도렌에게 보고해야 합니다.‡Preséntate ante el Teniente Doren en el Asentamiento Rebelde, en el Norte de la Vega de Tuercespina.‡Preséntate ante el teniente Doren en el Asentamiento Rebelde, en el Norte de la Vega de Tuercespina.‡Présentez-vous au Lieutenant Doren au Camp rebelle, en Strangleronce septentrionale.‡去找北荆棘谷反抗军营地的多伦上尉。‡到北荊棘谷的反抗軍營地向多倫中尉回報。',
  }
},
[26839] = {
  {
    'Se afaste disso tudo!‡Пусть весь мир подождет!‡Eine Auszeit nehmen!‡다 버리고 떠나자!‡¡Alejarse de todo!‡¡Alejarse de todo!‡Le bonheur… Si je veux‡统统赚走！‡拋開一切!',
    nil,
    'Visite a Espoleta Chaveforte no Esconderijo da Chaveforte, que fica no Cabo do Espinhaço.‡Навестите Хамми Кофельнагель в Укрытии Кофельнагель на мысу Тернистой долины.‡Sucht Sassy Hartzang in Hartzangs Versteck am Schlingendornkap auf.‡가시덤불 곶의 하드렌치 은신처에 있는 새시 하드렌치를 만나야 합니다.‡Visita a Sassy Malallave en el Escondrijo Malallave, en El Cabo de Tuercespina.‡Visita a Sassy Malallave en el Escondrijo Malallave, en El Cabo de Tuercespina.‡Rendez-visite à Chipie Serrelavis à la Planque de Serrelavis, au Cap Strangleronce.‡去找荆棘谷海角硬钳避世乐园的莎希·硬钳。‡到荊棘谷海角的硬心藏匿處拜訪賽希·硬心。',
  }
},
[26840] = {
  {
    'O retorno ao Planalto‡Возвращение на нагорье‡Rückkehr ins Hochland‡고원으로 돌아가기‡Regreso a las Tierras Altas‡Regreso a las Tierras Altas‡Retournez dans les hautes-terres‡重返高地‡回到高地',
    nil,
    'Use o Portal do Planalto do Crepúsculo em Orgrimmar para retornar para o Porto Presa do Dragão no Planalto do Crepúsculo e fale com Zaela.‡Вернитесь в порт Драконьей Пасти через портал на Сумеречное нагорье в Оргриммаре и поговорите с Зелой.‡Benutzt das Portal des Drachenmals in Orgrimmar, um in den Hafen des Drachenmals im Schattenhochland zurückzukehren und sprecht mit Zaela.‡오그리마에 있는 황혼의 고원 차원문을 이용해 황혼의 고원에 있는 용아귀 항구로 돌아가 잴라와 대화해야 합니다.‡Utiliza el Portal de las Tierras Altas Crepusculares, en Orgrimmar, para volver al Puerto Faucedraco, en las Tierras Altas Crepusculares, y habla con Zaela.‡Utiliza el Portal de las Tierras Altas Crepusculares, en Orgrimmar, para volver al Puerto Faucedraco, en las Tierras Altas Crepusculares, y habla con Zaela.‡Utilisez le Portail des Gueules-de-dragon d\'Orgrimmar pour retourner au Port Gueule-de-dragon, dans les Hautes-terres du Crépuscule, et adressez-vous à Zaela.‡用奥格瑞玛的暮光高地传送门回到暮光高地的龙喉哨站，同扎伊拉交谈。‡使用在奧格瑪的暮光高地傳送門回到暮光高地的龍喉港，並且和札伊拉交談。',
  }
},
[26841] = {
  {
    'O selo proibido‡Запретная печать‡Das verbotene Siegelzeichen‡금지된 도장‡El sigilo prohibido‡El sigilo prohibido‡Le cachet interdit‡禁戒魔符‡禁忌符印',
    nil,
    'Fale com Rhyanda no interior de Aldrassil, que fica em Umbravale.‡Поговорите с Риандой в Альдрассиле, что в Тенистой долине.‡Sprecht mit Rhyanda in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 리안다와 대화해야 합니다.‡Habla con Rhyanda dentro de Aldrassil, en Cañada Umbría.‡Habla con Rhyanda dentro de Aldrassil, en Cañada Umbría.‡Allez voir Rhyanda à l\'intérieur d\'Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的莱恩达交谈。‡在幽影谷中和莉安達談話。',
  }
},
[26842] = {
  {
    'Está chovendo gnoll‡Откуда ни возьмись – гноллы‡Hier ein Gnoll, dort ein Gnoll‡갑자기 나타난 놀‡Gnoll sé de dónde salen‡Gnoll sé de dónde salen‡Passe-moi la gnoll‡凭空出现‡哪來的豺狼人',
    nil,
    'Pegue 12 Orelhas de Gnoll de Batedores Pelemusgo ou Esmagadores Pelemusgo.‡Соберите 12 ушей гноллов, убив разведчиков из племени Мохошкуров или губителей из племени Мохошкуров.‡Sammelt 12 Gnollohren von Spähern und Schlägern der Moosfelle.‡이끼가죽 정찰병과 이끼가죽 전사를 처치하고 이끼가죽 일족 귀걸이 12개를 수집해야 합니다.‡Reúne 12 orejas de gnoll de exploradores Pellejomusgo o partecaras Pellejomusgo.‡Reúne 12 orejas de gnoll de exploradores Pellejomusgo o partecaras Pellejomusgo.‡Prélevez 12 Oreilles de Poil-moussu sur les cadavres d’Éclaireurs ou de Cogneurs poils-moussus.‡从藓皮斥候或藓皮猛击者身上收集12只豺狼人的耳朵。‡從蘚皮斥候或蘚皮猛擊者身上收集12個豺狼人耳朵。',
  }
},
[26843] = {
  {
    'Um comandante espertinho‡Маленький смышленый командир‡Ein winziger, cleverer Kommandant‡작지만 영리한 지도자‡Un comandante pequeño pero matón‡Un comandante pequeño pero matón‡Un commandant petit, mais malin‡小小聪明指挥官‡小而巧指揮官',
    nil,
    'Mate o Comandante Nazrim.‡Убейте командира Назрима.‡Tötet "Kommandant" Nazrim.‡"사령관" 나즈림을 처치해야 합니다.‡Mata al Comandante Nazrim.‡Mata al Comandante Nazrim.‡Tuez le Commandant Nazrim.‡杀死指挥官纳兹利姆。‡殺死指揮官納茲林姆。',
  }
},
[26844] = {
  {
    'Aqui não, violão!‡Кобольд… Еще кобольд‡Vom Regen in die Traufe‡동굴쥐 일족 처치‡Kóbold y más kóbold‡Kóbold y más kóbold‡À kobold, kobold et demi‡更多的狗头人‡狗頭人和幕後黑手',
    nil,
    'Mate 5 Ratatúneis Topógrafos e 5 Ratatúneis Colhedores.‡Убейте 5 геодезистов-туннельщиков и 5 добытчиков-туннельщиков.‡Tötet 5 Feldmesser der Tunnelratten und 5 Futterwühler der Tunnelratten.‡동굴쥐 땜장이와 동굴쥐 약탈꾼을 각각 5마리씩 처치해야 합니다.‡Mata a 5 peritos Ratatúnel y a 5 batidores Ratatúnel.‡Mata a 5 peritos Ratatúnel y a 5 batidores Ratatúnel.‡Tuez 5 Rats des tunnels géomètres et 5 Rats des tunnels fourrageurs.‡消灭5名坑道鼠勘探员和5名坑道鼠征粮官。‡消滅5隻坑道鼠勘測員和5隻坑道鼠強奪者。',
  }
},
[26845] = {
  {
    'O mandante‡Кто за всем этим стоит?‡Wer hat hier das Sagen?‡책임자 처치‡¿Quién está al mando aquí?‡¿Quién está al mando aquí?‡C’est qui qui commande, ici ?‡这儿谁做主？‡這裡誰負責?',
    nil,
    'Pegue a cabeça do Encarregado Zombeteiro.‡Добудьте голову штейгера Острослова.‡Bringt mir den Kopf von Vorarbeiter Scharfspott.‡현장감독 샤프스니어를 처치해 그의 머리카락을 수집해야 합니다.‡Recoge la cabeza del supervisor Ceñofruncido.‡Recoge la cabeza del supervisor Ceñofruncido.‡Tuez le Contremaître Cruelrictus et prenez sa tête.‡获得工头山普斯尼尔的徽记。‡取得工頭銳嘲的頭。',
  }
},
[26846] = {
  {
    'Abuso de troggs‡Грязная эксплуатация‡Ein fieser Plan‡고약한 수작‡Una sucia explotación‡Una sucia explotación‡Une vilaine exploitation‡肮脏的把戏‡討厭的剝削者',
    nil,
    'Mate 5 Geomantes Ratatúnel.‡Убейте 5 геомантов-туннельщиков.‡Tötet 5 Geomanten der Tunnelratten.‡동굴쥐 흙점쟁이 5마리를 처치해야 합니다.‡Mata a 5 geománticos Ratatúnel.‡Mata a 5 geománticos Ratatúnel.‡Tuez 5 Rats des tunnels géomanciens.‡杀掉5名坑道鼠地卜师。‡消滅5隻坑道鼠地卜師。',
  }
},
[26847] = {
  {
    '‡Грот Обвалов‡Die Bebenden Felder‡전율하는 들판‡Los Campos Convulsos‡Los Campos Convulsos‡Les fonds Tremblants‡地震旷野‡破碎曠野',
    nil,
    '‡[Deprecated] Speak with King Oremantle at the Quaking Fields in Deepholm.‡Sprecht mit König Erzmantel auf den Bebenden Feldern in Tiefenheim.‡‡Habla con el rey Mantomena en los Campos Convulsos en Infralar.‡‡Allez voir le Roi Mantemine aux Fonds Tremblants, dans le Tréfonds.‡‡',
  }
},
[26848] = {
  {
    '‡Место отмечено‡X kennzeichnet den Schatz‡‡La X marca el lugar‡‡Une X indique l\'endroit‡‡',
    nil,
    '‡Отправляйтесь туда, где король Железная Мантия закопал второй фрагмент столпа мира.‡Begebt Euch an den Ort, an dem König Erzmantel das zweite Weltensäulenfragment vergraben hat.‡‡Dirígete al lugar en el que el rey Mantomena enterró el segundo fragmento del Pilar del Mundo.‡‡Dirigez-vous vers l\'endroit où le Roi Mantemine a enterré le second fragment du pilier du monde.‡‡',
  }
},
[26849] = {
  {
    '‡Топор раскола земли‡Die Axt der irdischen Trennung‡대지 가름 도끼‡El hacha de hendimiento terrestre‡El hacha de hendimiento terrestre‡La hache de la fracture terrestre‡裂地之斧‡裂地之斧',
    nil,
    '‡Убейте 5 потрескавшихся изумрудных колоссов.‡Tötet 5 gespaltene Smaragdkolosse.‡작아진 에메랄드 거대괴수 5마리를 처치해야 합니다.‡Asesina a 5 colosos esmeralda hendidos.‡‡Tuez 5 Colosses d\'émeraude scindés.‡消灭5名碎裂的翡翠巨人。‡',
  }
},
[26850] = {
  {
    '‡Элементиевая руда‡Elementarerz‡원소 광석‡Mena elemental‡Mena elemental‡Élémentaire, mon cher minerai !‡元素矿砂‡源質礦石',
    nil,
    '‡Соберите 6 кусков элементиевой руды.‡Sammelt 6 Elementarerze.‡원소 광석 6개를 수집해야 합니다.‡Recoge 6 menas elementales.‡‡Récupérez 6 pépites de Minerai élémentaire.‡收集6份元素矿砂。‡',
  }
},
[26851] = {
  {
    '‡Единое целое с землей‡Eins mit der Erde‡대지와 하나 되기‡Uno con el suelo‡‡Le lien terrestre‡合二为一‡',
    nil,
    '‡При помощи ритуала единения с землей узнайте, где находится центральный фрагмент столпа мира.‡Entdeckt das zweite Weltensäulenfragment durch das Ritual \'Eins mit der Erde\'.‡‡Descubre el paradero del fragmento central del Pilar del Mundo mediante el ritual uno con el suelo.‡‡Localisez le Second fragment du pilier du monde grâce au Rituel de lien terrestre.‡‡',
  }
},
[26852] = {
  {
    '‡Фрагмент внутри‡Das Fragment im Inneren‡‡El fragmento está dentro‡‡Le fragment se trouve à l\'intérieur‡‡',
    nil,
    '‡Возьмите центральный фрагмент столпа мира.‡Bringt das zweite Fragment der Weltensäule in Euren Besitz.‡‡Recoge el fragmento central del Pilar del Mundo.‡‡Récupérez le Second fragment du pilier du monde.‡‡',
  }
},
[26853] = {
  {
    '‡Центральный фрагмент‡Das mittlere Fragment‡중간 파편‡El fragmento central‡‡Le second fragment‡中部碎片‡',
    nil,
    '‡Отнесите центральный фрагмент столпа мира заклинательнице земли Еве в Храм Земли, что в Подземье.‡Überbringt das zweite Fragment der Weltensäule Erdenrufer Yevaa im Tempel der Erde in Tiefenheim.‡‡Entrega el fragmento central del Pilar del Mundo a la clamatierras Yevaa en el Templo de la Tierra en Infralar.‡‡Apportez le Second fragment du pilier du monde à l\'Imploratrice de la terre Yevaa au Temple de la Terre, dans le Tréfonds.‡‡',
  }
},
[26854] = {
  {
    'O piloto perdido‡Пропавший пилот‡Der vermisste Pilot‡실종된 조종사‡El piloto perdido‡El piloto perdido‡Le pilote perdu‡失踪的驾驶员‡失蹤的駕駛員',
    nil,
    'Encontre o Piloto Hildeve no Lago Helm.‡Найдите пилота Хилдельва к северу от озера Хельмово Ложе.‡Findet Pilot Hanglug nördlich des Helmsbettsees.‡투구바닥 호수 북쪽에서 조종사 힐델브를 찾아야 합니다.‡Encuentra al piloto Hildelve al norte del Lago de Helm.‡Encuentra al piloto Hildelve al norte del Lago de Helm.‡Trouvez le pilote Hildelve au nord du Lac du Lit d\'Helm.‡在盔枕湖北面找到驾驶员铁钻。‡在盔枕湖北方找出駕駛員莫里·鐵鑽。',
  }
},
[26855] = {
  {
    'A vingança do piloto‡Месть пилота‡Pilotenrache‡조종사의 복수‡Vengar al piloto‡Vengar al piloto‡La revanche du pilote perdu‡驾驶员的复仇‡駕駛員的復仇',
    nil,
    'Mate o Ronhagarra.|n|nEntregue a Pata Sarnenta do urso e o Diário de Hildelve para o Piloto Pisafundo no Posto de Guarda do Portão Sul.‡Убейте Паршивого Когтя.|n|nПринесите его грязный коготь и записи Хилдельва пилоту Большеногу к заставе у Южных врат.‡Tötet Marterklaue.|n|nBringt Pilot Hammerfuß am Südtoraußenposten die räudige Klaue des Bären und Hangflugs Tagebuch.‡썩은발톱을 처치한 후 증거로 발톱과 힐델브의 일지를 남부 관문 전초기지에 있는 조종사 해머풋에게 가져가야 합니다.‡Mata a Sarnagarra.|n|nLleva su garra sarnosa y el diario de Hildelve al piloto Podomartillo en la Avanzada de la Puerta Sur.‡Mata a Sarnagarra.|n|nLleva su garra sarnosa y el diario de Hildelve al piloto Podomartillo en la Avanzada de la Puerta Sur.‡Tuez Griffe galeuse.|n|nRapportez la griffe à laquelle il doit son nom et le Journal de Hildelve au pilote Martèlepied, à l’Avant-poste de la Porte sud.‡杀死癞爪。|n|n把他肮脏的爪子和莫里·铁钻的日记交给南门哨岗的驾驶员塞克·锤足。‡消滅癩爪。|n|n將他骯髒的爪子和鐵鑽的日記帶去給在南門崗哨的駕駛員塞克‧錘足。',
  }
},
[26856] = {
  {
    'Rechace a invasão‡Отражение атаки‡Werft die Invasion zurück‡침략을 막아라‡Repele la invasión‡Repele la invasión‡Repousser l\'invasion‡反击入侵‡擊退入侵',
    nil,
    'Mate Pederneiro, Bazzalan e Jergosh, o Invocador.‡Устраните Огглфлинта, Баззалана и Жергоша Призывателя Духов.‡Tötet Flintauge, Bazzalan und Jergosh den Herbeirufer.‡오글플린트, 바잘란, 기원사 제로쉬를 처치해야 합니다.‡Mata a Ogglesílex, a Bazzalan y a Jergosh el Convocador.‡Mata a Ogglesílex, a Bazzalan y a Jergosh el Convocador.‡Tuez Lorgnesilex, Bazzalan et Jergosh l\'Invocateur.‡杀死奥格弗林特、巴扎兰，以及祈求者耶戈什。‡殺死奧格弗林特、巴札蘭以及『塑能師』耶戈什。',
  }
},
[26857] = {
  {
    'Lacaios de Abyssion‡Приспешники Абиссия‡Abyssions Diener‡어비시온의 부하‡Los esbirros de Abismion‡Los esbirros de Abismion‡Les sbires d\'Abyssion‡艾比希昂的爪牙‡艾碧希翁的爪牙',
    nil,
    'Derrote 8 unidades Draconianas ou do Crepúsculo no Covil de Abyssion.‡Победите 8 сумеречных доминаторов у Логова Абиссия.‡Besiegt 8 Zwielicht- oder Drachkineinheiten in Abyssions Hort.‡어비시온의 보금자리에서 황혼의 망치단 또는 용족 부하 8마리를 처치해야 합니다.‡Derrota a 8 unidades Crepusculares o de dragonantes en la Guarida de Abismion.‡Derrota a 8 unidades Crepusculares o de dragonantes en la Guarida de Abismion.‡Tuez 8 unités du Crépuscule ou Draconiennes au Repaire d\'Abyssion.‡在艾比希昂的巢穴里打败8名暮光或者龙人单位。‡在艾碧希翁的巢穴擊敗合計8名的暮光或龍人單位。',
  }
},
[26858] = {
  {
    'Taragaman, o Famélico‡Тарагаман Ненасытный‡Taragaman der Hungerleider‡욕망의 타라가만‡Taragaman el Hambriento‡Taragaman el Hambriento‡Taragaman l\'Affameur‡饥饿者塔拉加曼‡『飢餓者』塔拉加曼',
    nil,
    'Pegue o coração de Taragaman, o Famélico.‡Добудьте сердце Тарагамана Ненасытного.‡Holt das Herz von Taragaman dem Hungerleider.‡타라가만의 심장을 획득해야 합니다.‡Coge el corazón de Taragaman el Hambriento.‡Coge el corazón de Taragaman el Hambriento.‡Prenez le Cœur de Taragaman l\'Affameur.‡拿到塔拉加曼的精华。‡取出『飢餓者』塔拉加曼的心臟。',
  }
},
[26859] = {
  {
    '‡В поисках потерянного ранца‡Die Suche nach dem verloren gegangenen Ranzen‡잃어버린 가방 찾기‡Buscando la cartera perdida‡Buscando la cartera perdida‡À la recherche de la sacoche perdue‡寻找背包‡',
    nil,
    '‡Обыщите Огненную пропасть в поисках тела Маура Зловещего Тотема и найдите все необычные предметы.‡Sucht im Flammenschlund nach Maur Grimmtotems Leiche und durchsucht sie nach interessanten Gegenständen.‡성난불길 협곡에서 마우르 그림토템의 시체를 찾아 도움이 될 만한 것들을 찾아야 합니다.‡Inspecciona la Sima Ígnea en busca del cuerpo de Maur Tótem Siniestro y comprueba si porta algún objeto de interés.‡Inspecciona la Sima Ígnea en busca del cuerpo de Maur Tótem Siniestro y comprueba si porta algún objeto de interés.‡Fouiller le Gouffre de Ragefeu pour trouver le cadavre de Maur Totem-sinistre et tout élément intéressant.‡在怒焰裂谷搜寻玛尔·恐怖图腾的尸体以及他留下的东西。‡',
  }
},
[26860] = {
  {
    'Chouriço de Thelsamar‡Телсамарские кровяные колбаски‡Blutwurst aus Thelsamar‡텔사마 선지 소시지‡Morcillas de Thelsamar‡Morcillas de Thelsamar‡Les boudins de Thelsamar‡塞尔萨玛血肠‡塞爾薩瑪血腸',
    nil,
    'Pegue 8 Alcatras de Urso dos Ursos Pretos em Loch Modan.‡Добудьте 8 медвежьих огузков, охотясь на черных медведей в Лок Модане.‡Sammelt 8 Bärenrücken von Schwarzbären in Loch Modan.‡모단 호수에 있는 검은곰을 처치해 곰 엉덩잇살 8개를 수집해야 합니다.‡Reúne 8 cuadriles de oso de los osos negros de Loch Modan.‡Reúne 8 cuadriles de oso de los osos negros de Loch Modan.‡Prélevez 8 Rumstecks d\'ours sur des Ours noirs dans le Loch Modan.‡从洛克莫丹的黑熊身上割下8块熊臀肉。‡在洛克莫丹的黑熊身上收集8塊熊臀肉。',
  }
},
[26861] = {
  {
    'Bloqueie os portões‡Заблокировать врата‡Blockiert die Tore‡관문 봉쇄‡Bloquea las puertas‡Bloquea las puertas‡Bloquer les portes‡封锁大门‡封鎖大門',
    nil,
    'Use a Pedra da Tempestade no Portão do Crepúsculo e no Portão Elemental do Covil de Abyssion.‡Воспользуйтесь грозовым камнем у Сумеречных и Стихийных врат в Логово Абиссия.‡Benutzt den Sturmstein am Zwielichttor und Elementartor in Abyssions Hort.‡어비시온의 보금자리에 있는 황혼 관문과 정기 관문에 폭풍의 돌을 사용해야 합니다.‡Usa la piedratormenta en la Puerta Crepuscular y en la Puerta Elemental, en la Guarida de Abismion.‡Usa la piedratormenta en la Puerta Crepuscular y en la Puerta Elemental, en la Guarida de Abismion.‡Utilisez la Pierre d’orage à la Porte du Crépuscule et à la Porte élémentaire, dans le Repaire d’Abyssion.‡对艾比希昂的巢穴里的暮光之门和元素之门使用风暴石。‡在艾碧希翁巢穴的暮光之門與元素之門使用暴風石。',
  }
},
[26862] = {
  {
    'Interferindo com os elementais‡Освобождение элементалей‡Verpfuschte Elementare‡정령 조종‡Manipulación elemental‡Manipulación elemental‡Manipulations élémentaires‡收买元素‡元素擾動',
    nil,
    'Obtenha 6 Braceletes Causticantes.‡Раздобудьте 6 тлеющих оков.‡Beschafft 6 sengende Bindungen.‡이글거리는 굴레 6개를 획득해야 합니다.‡Consigue 6 vínculos abrasadores.‡Consigue 6 vínculos abrasadores.‡Récupérez 6 Liens incendiaires.‡获得6条灼热绑带。‡獲得6個灼熱束腕。',
  }
},
[26863] = {
  {
    'Patas nojentas‡Грязные лапы‡Schmutzige Pfoten‡더러운 앞발‡Zarpas asquerosas‡Zarpas asquerosas‡Bas les pattes !‡污秽的爪子‡骯髒的爪子',
    nil,
    'Pegue seis lotes de Equipamento de Mineração na Mina da Prata.‡Соберите 6 ящиков с инструментами шахтеров в Серебряных копях.‡Sucht in der Silberbachmine 6 Sätze Minenarbeiterausstattung zusammen.‡은여울 광산에서 광부의 도구 6개를 모아야 합니다.‡Reúne 6 cargas de equipamiento de minero de la Mina de Fuenteplata.‡Reúne 6 cargas de equipamiento de minero de la Mina de Fuenteplata.‡Allez récupérer 6 lots d\'Équipement de mineur à la Mine du Ru d\'argent.‡从银泉矿洞里收集6车矿工装备。‡從銀泉礦坑收集6套礦工裝備。',
  }
},
[26864] = {
  {
    'Notícias dos gnolls‡Доставка головы‡Kopflos‡산악경비대 카드렐에게로‡El portador del gnoll-cimiento‡El portador del gnoll-cimiento‡Transport d\'organes‡捎上豺狼人的消息‡豺狼人的前鋒',
    nil,
    'Entregue a Cabeça do Encarregado Zombeteiro para o Montanhista Kadrell.‡Отнесите голову штейгера Острослова горному пехотинцу Кэдреллу.‡Bringt den Kopf von Vorarbeiter Scharfspott zu Gebirgsjäger Kadrell.‡현장감독 샤프스니어의 머리카락을 산악경비대 카드렐에게 가져가야 합니다.‡Entrega la cabeza del supervisor Ceñofruncido al montaraz Kadrell.‡Entrega la cabeza del supervisor Ceñofruncido al montaraz Kadrell. ‡Remettez la Tête du Contremaître Cruelrictus au Montagnard Kadrell.‡将工头山普斯尼尔的徽记交给巡山人卡德雷尔。‡把工頭銳嘲的頭送去給巡山人卡德雷爾。',
  }
},
[26865] = {
  {
    'Inimigos subterrâneos‡Враг из глубин‡Der Feind tief unten‡깊숙한 곳의 적‡Enemigos debajo‡Enemigos debajo‡Les ennemis des profondeurs‡脚下之敌‡下方的敵人',
    nil,
    'Fale com o Guarda Pétreo Kurjack.‡Поговорите с каменным стражем Курджаком.‡Sprecht mit Steinwächter Kurjack.‡투사 쿠르잭과 대화해야 합니다.‡Habla con el guardia de piedra Kurjack.‡Habla con el guardia de piedra Kurjack.‡Parlez au Garde de pierre Kurjack.‡与石头守卫库尔加克交谈。‡與石衛士療舉談話。',
  }
},
[26866] = {
  {
    'Inimigos subterrâneos‡Враг из глубин‡Der Feind tief unten‡깊숙한 곳의 적‡Enemigos debajo‡Enemigos debajo‡Les ennemis des profondeurs‡下面的敌人‡下方的敵人',
    nil,
    'Fale com o Guarda Pétreo Kurjack.‡Поговорите с каменным стражем Курджаком.‡Sprecht mit Steinwächter Kurjack.‡투사 쿠르잭과 대화해야 합니다.‡Habla con el guardia de piedra Kurjack.‡Habla con el guardia de piedra Kurjack.‡Parlez au Garde de pierre Kurjack.‡跟石头守卫库尔加克谈一谈。‡與石衛士療舉談話。',
  }
},
[26867] = {
  {
    'Inimigos subterrâneos‡Враг из глубин‡Der Feind tief unten‡깊숙한 곳의 적‡Enemigos debajo‡Enemigos debajo‡Les ennemis des profondeurs‡下面的敌人‡下方的敵人',
    nil,
    'Fale com o Guarda Pétreo Kurjack.‡Поговорите с каменным стражем Курджаком.‡Sprecht mit Steinwächter Kurjack.‡투사 쿠르잭과 대화해야 합니다.‡Habla con el guardia de piedra Kurjack.‡Habla con el guardia de piedra Kurjack.‡Parlez au Garde de pierre Kurjack.‡跟石头守卫库尔加克谈一谈。‡與石衛士療舉談話。',
  }
},
[26868] = {
  {
    'Eixo do terror‡Ось ужаса‡Die Achse des Grässlichen‡경악의 축‡Eje de horror‡Eje de horror‡L\'axe de la puanteur‡恶心轴心‡可怕的莖',
    nil,
    'Vista o Kit de Disfarce Inteligente de Planta para se esgueirar até o Representante Pelemusgo e lance os Feromônios Potentes de Murloc nele.‡Воспользуйтесь набором для искусной маскировки под растение, чтобы подобраться к представителю Мохошкуров и применить к нему мощные феромоны мурлоков.‡Benutzt das clevere Pflanzenverkleidungsset, um Euch an den Repräsentanten der Moosfelle heranzuschleichen. Dann bestäubt ihn mit den starken Murlocpheromonen.‡기발한 식물 변장 도구를 이용해 이끼가죽 대표에게 몰래 다가가서 강력한 멀록 페로몬을 사용해야 합니다.‡Usa el astuto disfraz de planta para escabullirte hasta el representante Pellejomusgo y usa las feromonas de múrloc potentes en él.‡Usa el astuto disfraz de planta para escabullirte hasta el representante Pellejomusgo y usa las feromonas de múrloc potentes en él.‡Utilisez le Déguisement astucieux en plante pour vous approcher du Représentant poil-moussu et l’asperger de Phéromones de murloc puissantes.‡使用精巧的植物伪装包并溜藓皮使者身边，在他身上使用超浓鱼人信息素。‡使用精巧的植物偽裝包溜到蘚皮代表旁邊，然後對牠使用強烈的魚人費洛蒙。',
  }
},
[26869] = {
  {
    'No fundo do abismo‡Глубины глубин‡Tiefe der Tiefen‡심원의 바닥‡En lo más profundo de las profundidades‡En lo más profundo de las profundidades‡Les profondeurs des profondeurs‡深渊之渊‡淵中之淵',
    nil,
    'Encontre Dolorita nos Abismos Esfacelados.‡Найдите пейнит в Гремящих глубинах.‡Findet das Painit in den Bruchtiefen.‡무너지는 심연 안에서 페이나이트를 찾아야 합니다.‡Encuentra la painita en el interior de las Profundidades Desmoronadas.‡Encuentra la painita en el interior de las Profundidades Desmoronadas.‡Trouvez la Dolorite au cœur des Profondeurs Désagrégées.‡在碎岩之渊里找到钙铝石。‡在破碎深淵中找到鋁硼鋯鈣石。',
  }
},
[26870] = {
  {
    'Limpando a caverna‡Очищение пещер‡Säuberung der Höhlen‡동굴 정화‡Limpieza en las cavernas‡Limpieza en las cavernas‡Nettoyer les cavernes‡净化洞穴‡淨化洞穴',
    nil,
    'Ebru, na Caverna Ululante, quer que você mate os Lordes da Presa: Cobrahn, Sucurina, Pítias e Serpentis.‡По поручению Эбру, полученному в пещере Стенаний, убейте Повелителей змей: Кобрана, Анакондру, Питонаса и Серпентиса.‡Ebru in den Höhlen des Wehklagens möchte, dass Ihr die Giftzahnlords Cobrahn, Anacondra, Pythas und Serpentis vernichtet.‡통곡의 동굴에 있는 에브루가 송곳니 군주 코브란, 아나콘드라, 피타스, 서펜티스를 처치해 달라고 했습니다.‡Ebru de las Cuevas de los Lamentos quiere que mates a los Nobles del Colmillo Cobrahn, Anacondra, Pythas y Serpentis.‡Ebru de las Cuevas de los Lamentos quiere que mates a los Nobles del Colmillo Cobrahn, Anacondra, Pythas y Serpentis.‡Ebru, dans les Cavernes des Lamentations, veut que vous tuiez les Seigneurs-crocs Cobrahn, Anacondra, Pythas et Serpentis.‡哀嚎洞穴的厄布鲁要你去杀掉毒牙之王考布莱恩、安娜科德拉、皮萨斯，以及瑟芬迪斯。‡哀嚎洞穴的厄布魯要求你殺掉毒牙之王考布萊恩，安娜科德拉，皮薩斯，和瑟芬迪斯。',
  }
},
[26871] = {
  {
    'Uma rocha entre muitas‡Один камень из многих‡Ein Fels unter vielen‡돌이라고 다 같은 돌이랴‡Una roca entre muchas otras‡Una roca entre muchas otras‡Un rocher parmi tant d’autres‡石中之石‡石中之石',
    nil,
    'Fale novamente com Diamant no Portão de Lorthuna, levando o Pedaço de Dolorita.‡Вернитесь с куском пейнита к Диаманту к Вратам Лортуны.‡Kehrt mit dem Painitbrocken zu Diamant an Lorthunas Tor zurück.‡페이나이트 덩어리를 가지고 로르투나의 문에 있는 디아만트에게 가야 합니다.‡Vuelve con Diamant en la Puerta de Lorthuna con el trozo de painita.‡Vuelve con Diamant en la Puerta de Lorthuna con el trozo de painita.‡Retournez voir Diamant à la Porte de Lorthuna avec le Morceau de dolorite.‡带着一大块钙铝石去找洛苏娜之门的岱亚曼塔。‡將大塊的鋁硼鋯鈣石帶回去洛舒娜之門給戴門。',
  }
},
[26872] = {
  {
    'Pelego anormal‡Шкуры загадочных существ‡Deviatbälge‡돌연변이 통가죽‡Pellejos descarriados‡Pellejos descarriados‡Les peaux de déviant‡变异皮革‡變異皮革',
    nil,
    'Nalpak quer 10 Pelegos Anormais.‡Принесите Налпаку 10 искаженных шкур.‡Nalpak möchte 10 Deviatbälge.‡날팍에게 돌연변이 통가죽 10개를 가져다 줘야 합니다.‡Nalpak quiere 10 pellejos descarriados.‡Nalpak quiere 10 pellejos descarriados.‡Nalpak vous a demandé 10 Peaux de déviant.‡纳尔帕克需要10张变异皮革。‡納爾派克想要10張變異皮革。',
  }
},
[26873] = {
  {
    'Métodos preventivos‡Превентивные меры‡Vorbeugende Maßnahmen‡사전 처방‡Métodos preventivos‡Métodos preventivos‡Une frappe préventive‡先发制人‡先發制人論',
    nil,
    'Nalpak quer que você colete 5 Ofídeas.‡По поручению Налпака соберите 5 цветков змеецвета.‡Nalpak möchte, dass Ihr 5 Schlangenflaum sammelt.‡날팍을 위해 불뱀꽃 5송이를 모아야 합니다.‡Napalk quiere que recolectes 5 reptilias.‡Napalk quiere que recolectes 5 reptilias.‡Nalpak vous a demandé de cueillir 5 Fleurs de serpent.‡纳尔帕克要你收集5朵毒蛇花。‡納爾派克想要你收集5朵毒蛇花。',
  }
},
[26874] = {
  {
    'O despertar de Naralex‡Пробуждение Наралекса‡Die Auferstehung von Naralex‡나랄렉스 깨우기‡Despertando a Naralex‡Despertando a Naralex‡Réveiller Naralex‡唤醒纳拉雷克斯‡喚醒納拉雷克斯',
    nil,
    'Fale com Muyoh.‡Поговорите с Муйоном.‡Sprecht mit Muyoh.‡무요와 대화해야 합니다.‡Habla con Muyoh.‡Habla con Muyoh.‡Parlez à Muyoh.‡跟穆约谈一谈。‡和繆幽聊聊。',
  }
},
[26875] = {
  {
    'Crepúsculo infinito‡Неумирающие сумерки‡Unsterbliches Zwielicht‡끈질긴 황혼‡Crepúsculo eterno‡Crepúsculo eterno‡Le crépuscule immortel‡不死的暮光‡暮光不滅',
    nil,
    'Mate 12 Invasores do Crepúsculo e 1 Furitérreo Profanado.‡Убейте 12 захватчиков из Сумеречного Молота и 1 оскверненного землегнева.‡Tötet 12 Zwielichteindringlinge und 1 entweihten Erdwüter.‡황혼의 침략자 12명과 더럽혀진 대지전복자 1마리를 처치해야 합니다.‡Mata a 12 invasores Crepusculares y a 1 terracundo profanado.‡Mata a 12 invasores Crepusculares y a 1 terracundo profanado.‡Tuez 12 Envahisseurs du Crépuscule et 1 Enrageterre profané.‡杀死12名暮光入侵者和1名被污染的大地狂怒者。‡殺死12名暮光入侵者和1名被褻瀆的地怒者。',
  }
},
[26876] = {
  {
    'O fragmento do Pilar do Mundo‡Фрагмент столпа мира‡Das Weltensäulenfragment‡세계 기둥 파편‡El fragmento del Pilar del Mundo‡El fragmento del Pilar del Mundo‡Le fragment du pilier du monde‡世界之柱碎片‡世界之柱碎片',
    nil,
    'Coloque o Estandarte da Harmonia Telúrica no meio do Covil de Abyssion. Em seguida, mate-o e pegue o Fragmento Superior do Pilar do Mundo.‡Разместите знамя Служителей Земли в Логове Абиссия, убейте его и заберите верхний фрагмент столпа мира.‡Stellt das Banner des Irdenen Rings in der Mitte von Abyssions Hort auf, tötet ihn und nehmt das erste Weltensäulenfragment an Euch.‡어비시온의 보금자리 한가운데 대지 고리회 깃발을 꽂은 다음, 어비시온을 처치하고 세계 기둥 위쪽 파편을 획득해야 합니다.‡Coloca el estandarte del Anillo de la Tierra en el centro de la guarida de Abismion, mátalo y consigue el primer fragmento del Pilar del Mundo.‡Coloca el estandarte del Anillo de la Tierra en el centro de la guarida de Abismion, mátalo y consigue el primer fragmento del Pilar del Mundo.‡Placez la Bannière du Cercle terrestre au centre du Repaire d’Abyssion, tuez-le puis récupérez le Fragment supérieur du pilier du monde.‡将大地之环旗帜插在艾比希昂的巢穴中央，杀死他并获得世界之柱上部碎片。‡將陶土議會的旗幟放在艾碧希翁巢穴的中央，殺死牠並取得世界之柱的上段碎片。',
  }
},
[26877] = {
  {
    '‡Фрагмент внутри‡Das Fragment im Inneren‡‡El fragmento está dentro‡‡Le fragment se trouve à l\'intérieur‡‡',
    nil,
    '‡Возьмите центральный фрагмент столпа мира.‡Bringt das zweite Fragment der Weltensäule in Euren Besitz.‡‡Recoge el fragmento central del Pilar del Mundo.‡‡Récupérez le Second fragment du pilier du monde.‡‡',
  }
},
[26878] = {
  {
    'Discípulos de Naralex‡Послушники Наралекса‡Jünger von Naralex‡나랄렉스의 제자‡Discípulos de Naralex‡Discípulos de Naralex‡Les disciples de Naralex‡纳拉雷克斯的信徒‡納拉雷克斯侍徒',
    nil,
    'Fale com Nalpak na Caverna Ululante.‡Поговорите с Налпаком у входа в Пещеры Стенаний.‡Sprecht in den Höhlen des Wehklagens mit Nalpak.‡통곡의 동굴에 있는 날팍과 대화해야 합니다.‡Habla con Nalpak en las Cuevas de los Lamentos.‡Habla con Nalpak en las Cuevas de los Lamentos.‡Parlez à Nalpak dans les Cavernes des Lamentations.‡跟哀嚎洞穴里的纳尔帕克谈一谈。‡和哀嚎洞穴裡的納爾派克說話。',
  }
},
[26879] = {
  {
    '‡Послушники Наралекса‡Jünger von Naralex‡나랄렉스의 제자‡Discípulos de Naralex‡‡Les disciples de Naralex‡纳拉雷克斯的信徒‡',
    nil,
    '‡Поговорите с Налпаком у входа в Пещеры Стенаний.‡Sprecht in den Höhlen des Wehklagens mit Nalpak.‡통곡의 동굴에 있는 날팍과 대화해야 합니다.‡Habla con Nalpak en las Cuevas de los Lamentos.‡‡Parlez à Nalpak dans les Cavernes des Lamentations.‡跟哀嚎洞穴里的纳尔帕克谈一谈。‡',
  }
},
[26880] = {
  {
    '‡‡‡길니아스 시 Unphase Cheat‡‡‡Triche de la ville de Gilnéas non phasée‡‡',
    nil,
    nil,
  }
},
[26881] = {
  {
    'Procurando Thaelrid‡В поисках Талрида‡Auf der Suche nach Thaelrid‡타엘리드 찾기‡Buscando a Thaelrid‡Buscando a Thaelrid‡À la recherche de Thaeldrid‡搜寻塞尔瑞德‡尋找塞爾瑞德',
    nil,
    'Encontre o Batedor Thaelrid.‡Найдите разведчика Талрида.‡Sucht Späher Thaelrid auf.‡정찰병 타엘리드를 찾아야 합니다.‡Busca al explorador Thaelrid.‡Busca al explorador Thaelrid.‡Cherchez l\'Éclaireur Thaelrid.‡找到斥候塞尔瑞德。‡找出斥候塞爾瑞德。',
  }
},
[26882] = {
  {
    'Vilão das Profundezas‡Злодейство в Непроглядной Пучине‡Schurkerei in der Tiefschwarzen Grotte‡검은심연의 음모‡La vileza de Brazanegra‡La vileza de Brazanegra‡L\'infamie de Brassenoire‡黑暗深渊的罪恶‡黑澗深淵中的惡魔',
    nil,
    'Obtenha a cabeça do Senhor do Crepúsculo Kelris.‡Добудьте голову Повелителя Сумрака Келриса.‡Holt den Kopf von Zwielichtfürst Kelris.‡황혼의 군주 켈리스의 머리카락을 입수해야 합니다.‡Consigue la cabeza del señor crepuscular Kelris.‡Consigue la cabeza del señor crepuscular Kelris.‡Récupérez la tête du Seigneur du Crépuscule Kelris.‡获得暮光领主克尔里斯的徽记‡取得暮光領主克爾里斯的頭顱。',
  }
},
[26883] = {
  {
    'Cachoeira do Crepúsculo‡Наступление сумерек‡Die Stunde der Finsternis‡황혼의 망치단의 몰락‡Cascada Crepuscular‡Cascada Crepuscular‡Le crépuscule descend‡暮光之陨‡暮光之錘的末日',
    nil,
    'Pegue 10 Pingentes do Crepúsculo.‡Добудьте 10 подвесок Сумерек.‡Bringt 10 Zwielichtanhänger an Euch.‡황혼의 펜던트 10개를 획득해야 합니다.‡Consigue 10 colgantes Crepusculares.‡Consigue 10 colgantes Crepusculares.‡Obtenir 10 Pendentifs du Crépuscule.‡收集10枚暮光坠饰。‡取得10條暮光墜飾。',
  }
},
[26884] = {
  {
    'Pesquisando a corrupção‡Исследование порчи‡Erforschung der Verderbnis‡타락에 대한 연구‡Investigaciones acerca de la corrupción‡Investigaciones acerca de la corrupción‡Recherches sur la corruption‡研究腐蚀‡研究墮落',
    nil,
    'Reúna 8 Troncos Encefálicos Corrompidos.‡Соберите 8 оскверненных стволов мозга.‡Sammelt 8 verderbte Hirnstämme.‡변이된 뇌간 8개를 모아야 합니다.‡Consigue 8 bulbos raquídeos corruptos.‡Consigue 8 bulbos raquídeos corruptos.‡Récupérez 8 Troncs cérébraux corrompus.‡收集8份堕落者的脑干。‡收集8份墮落者的腦幹。',
  }
},
[26885] = {
  {
    'Conhecimento nas Profundezas‡Знание в пучине‡Wissen in der Tiefe‡심연의 지식‡Conocimiento en las Cavernas‡Conocimiento en las Cavernas‡Les profondeurs de la connaissance‡深渊的知识‡深淵中的知識',
    nil,
    'Encontre o Manuscrito de Lorgalis.‡Отыщите манускрипт Лоргалиса.‡Findet das Manuskript von Lorgalis.‡로르갈리스 초본을 찾아야 합니다.‡Encuentra el manuscrito de Lorgalis.‡Encuentra el manuscrito de Lorgalis.‡Trouvez le Manuscrit de Lorgalis.‡找到洛迦里斯手稿。‡找到洛迦里斯手稿。',
  }
},
[26886] = {
  {
    'Nada mais de capataz‡Побочная задача‡Genug gebrüllt‡해적단의 작업반장‡A por el capataz‡A por el capataz‡Danse avec les tirs‡不听管教‡無心工作',
    nil,
    'Mate o Capataz dos Mares do Sul.‡Убейте десятника Южных морей.‡Tötet den Zuchtmeister der Südmeerfreibeuter.‡남쪽바다 작업반장을 처치해야 합니다.‡Mata al capataz de los Mares del Sur.‡Mata al capataz de los Mares del Sur.‡Tuez le Sous-chef des mers du Sud.‡杀掉南海工头。‡殺死南海監工。',
  }
},
[26887] = {
  {
    'Enchendo os bolsos‡Требуются пломбы‡Wir füllen uns die Taschen‡주머니 채우기‡Se necesitan empastes‡Se necesitan empastes‡Une histoire de plombage‡填满我们的口袋‡裝滿我們的袋子',
    nil,
    'Consiga 20 Obturações de Ouro dos Mosqueteiros dos Mares do Sul ou dos Capangas dos Mares do Sul.‡Соберите 20 золотых пломб с мушкетеров или силачей Южных морей.‡Sammelt 20 Goldfüllungen von Musketieren oder Schlägern der Südmeerfreibeuter.‡남쪽바다 총병 또는 남쪽바다 폭력배에게서 황금 충전재료 20개를 수집해야 합니다.‡Reúne 20 empastes de oro de mosqueteros de los Mares del Sur o de forzudos de los Mares del Sur.‡Reúne 20 empastes de oro de mosqueteros de los Mares del Sur o de forzudos de los Mares del Sur.‡Récupérez 20 « Plombages » en or sur des Mousquetaires des mers du Sud ou sur des Hommes de main des mers du Sud.‡从南海火枪手和南海勇夫身上获得20份金料。‡從南海火槍手和南海惡棍身上收集20個金質填充物。',
  }
},
[26888] = {
  {
    'Pesadelo das Profundezas‡Ужас из глубин‡Alptraum in der Tiefe‡나락의 악몽‡Pesadilla en las Cavernas‡Pesadilla en las Cavernas‡Cauchemar dans les profondeurs‡深渊的噩梦‡深淵惡夢',
    nil,
    'Mate Aku\'mai.‡Убейте Аку\'май.‡Tötet Aku\'mai.‡아쿠마이를 처치해야 합니다.‡Mata a Aku\'mai.‡Mata a Aku\'mai.‡Tuez Aku\'mai.‡杀死阿库麦尔。‡殺死阿庫麥爾。',
  }
},
[26889] = {
  {
    'Chefe... tô cansada pra chuchu‡Вопли радости‡Genug der Fröhlichkeit‡밀조장이 전초기지로‡La alegría de la huerta‡La alegría de la huerta‡Un poste vacant‡都收拾好了‡振奮精神',
    nil,
    'Fale com Zeke Borrabotas no Vilarejo dos Falsários.‡Поговорите с Зеке Волочилкинсом на стоянке бутлегеров.‡Sprecht am Außenposten der Schmuggler mit Zeke Scheuerschuh.‡밀조장이 전초기지에 있는 제크 부트스커프와 대화해야 합니다.‡Habla con Zeke Atabotas en la Avanzada del Contrabandista.‡Habla con Zeke Atabotas en la Avanzada del Contrabandista.‡Allez voir Zeke Traînebottes à l\'Avant-poste des Contrebandiers.‡跟商旅哨站的泽克·磨靴谈一谈。‡到私酒商哨站找札克·靴磨說話。',
  }
},
[26890] = {
  {
    'A essência de Aku\'mai‡Сущность Аку\'май‡Die Essenz von Aku\'mai‡아쿠마이의 정수‡La esencia de Aku\'Mai‡La esencia de Aku\'Mai‡L\'essence d\'Aku\'Mai‡阿库麦尔的精华‡阿庫麥爾的精華',
    nil,
    'Recolha 20 Safiras de Aku\'Mai.‡Соберите 20 сапфиров Аку\'май.‡Sammelt 20 Saphire von Aku\'mai.‡아쿠마이의 사파이어 20개를 수집해야 합니다.‡Reúne 20 zafiros de Aku\'Mai.‡Reúne 20 zafiros de Aku\'Mai.‡Récupérez 20 Saphirs d\'Aku\'Mai.‡收集20颗阿库麦尔蓝宝石。‡收集20顆阿庫麥爾藍寶石。',
  }
},
[26891] = {
  {
    'Nas ruínas‡Среди руин‡Inmitten der Ruinen‡폐허 사이로‡Entre ruinas‡Entre ruinas‡Parmi les ruines‡在废墟中‡廢墟之間',
    nil,
    'Extraia o Núcleo das Profundezas.‡Извлеките глубинный сердечник.‡Findet den Tiefenkern.‡심연의 핵을 추출해야 합니다.‡Extrae el núcleo de las profundidades.‡Extrae el núcleo de las profundidades.‡Extrayez le Noyau de la Brasse.‡提炼深渊之核。‡取出深淵之核。',
  }
},
[26892] = {
  {
    'No fundo das Profundezas‡Во глубине глубин‡In den tiefsten Tiefen‡나락의 깊은 곳‡En las profundidades de las Cavernas‡En las profundidades de las Cavernas‡Au cœur des profondeurs‡深渊的深处‡深淵深處',
    nil,
    'Mate Ghamoo-Ra, Gelihast e a Lady Sarevess.‡Убейте Гхаму-ра, леди Саревесс и Гелихаста.‡Vernichtet Ghamoo-Ra, Lady Sarevess und Gelihast.‡가무라, 여왕 사레베스, 겔리하스트를 처치해야 합니다.‡Mata a Ghamoo-Ra, a Lady Sarevess, y a Gelihast.‡Mata a Ghamoo-Ra, a Lady Sarevess, y a Gelihast.‡Tuez Ghamoo-Ra, Dame Sarevess et Gelihast.‡杀死加摩拉、萨利维丝，以及格里哈斯特。‡殺死加摩拉、薩利維絲女士和格里哈斯特。',
  }
},
[26893] = {
  {
    'Profundezas Negras‡Непроглядная Пучина‡Die Tiefschwarze Grotte‡검은심연 나락‡Cavernas de Brazanegra‡Cavernas de Brazanegra‡Les profondeurs de Brassenoire‡黑暗深渊‡黑澗深淵',
    nil,
    'Fale com Je\'neu Sancrea.‡Поговорите с Дже\'неу Санкри.‡Sprecht mit Je\'neu Sancrea.‡제네우 생크리와 대화해야 합니다.‡Habla con Je\'neu Sancrea.‡Habla con Je\'neu Sancrea.‡Parlez à Je\'neu Sancrea.‡与耶努萨克雷交谈。‡和耶努薩克雷說話。',
