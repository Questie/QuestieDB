},
[31055] = {
  {
    'Entre um saurok e uma espada‡Между сауроками и наковальней‡Der Biss in den Saurokapfel‡사우록과 역경 사이‡Entre el saurok y la pared‡‡Dur comme un saurok‡《蜥蜴人与困境》‡',
    nil,
    'Leve "Entre um saurok e uma espada" ao Andarilho das Lendas Cho. Uma‡Принесите хранителю истории Чо книгу "Между сауроками и наковальней".‡Bringt "Der Biss in den Saurokapfel" zu Lehrensucher Cho.‡전승지기 초에게 사우록과 역경 사이를 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Entre el Saurok y la pared al eremita Cho.‡‡Apportez Dur comme un saurok au Chroniqueur Cho, au Siège de la Connaissance.‡将《蜥蜴人与困境》带给闻道之座的游学者周卓。‡',
  }
},
[31058] = {
  {
    'O goró do macaco louco‡Обезьянье пойло‡Affenbande‡톡 쏘는 원숭이 맥주‡El brebaje del mono marchoso‡‡La bière du singe espiègle‡丛林佳酿‡',
    nil,
    'Derrote o Capitão Fedô. Uma‡Одержите верх над капитаном Уком.‡Bezwingt Kapitän Uuk.‡선장 우끼를 물리쳐야 합니다. 레벨 15 웅가 잉구‡Derrota al capitán Ook.‡‡Battez le Capitaine Ouk.‡击败乌克头领。‡',
  }
},
[31060] = {
  {
    'Dawson test POI‡Dawson test POI‡Dawson test POI‡Dawson test POI‡Dawson test POI‡‡Test Dawson‡Dawson test POI‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31061] = {
  {
    'Nos ombros de andarilhas‡Оседлать грозу‡Sturmritt‡폭풍을 타고‡Cabalgar el temporal‡‡Chevaucher la tempête‡暴风骑士‡',
    nil,
    'Use as Garras de Bronze para montar em 8 Correnuvens Shan\'ze. Ataque-as para libertá-las da corrupção. Uma‡Оседлайте 8 облачных бегунов Шань\'Цзэ с помощью бронзовых когтей. Атакуйте их, чтобы очистить от скверны.‡Benutzt die Bronzeklauen, um 8 Wolkenreiter der Shan\'ze zu besteigen. Greift sie an, um sie von ihrer Verderbnis zu befreien.‡청동 발톱을 사용하여 샨쩌 구름길잡이 8마리에 올라간 다음, 그들을 공격해 타락에서 구해내야 합니다.‡Utiliza las garras de bronce para montar a 8 mensajeros del cielo de Shan\'ze. Atácalos para liberarlos de su corrupción.‡‡Utilisez les Griffes en bronze pour monter 8 Cours-les-nuages shan’ze. Attaquez-les pour les libérer de leur corruption.‡利用青铜爪骑在8只山泽穿云翔龙的身上。攻击它们使其恢复心智。‡',
  }
},
[31062] = {
  {
    'Quando os mortos falam‡Когда мертвецы говорят‡Wenn die Toten sprechen‡죽은 이가 말할 때‡Cuando los muertos hablan‡‡La voix des morts‡亡语者‡',
    nil,
    'Mate o Morta-voz Shan\'ze. Uma‡Убейте Шань\'цзэ — вестника смерти.‡Tötet den Todessprecher der Shan\'ze.‡샨쩌 죽음예언자를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata al portavoz de la muerte de Shan\'ze.‡‡Tuez le Nécrorateur shan’ze.‡击败山泽亡语者。‡',
  }
},
[31063] = {
  {
    'Lao-Chin e Serevex‡Лао-Чинь и Серевекс‡Lao-Chen und Serevex‡라오친과 세레벡스‡Lao-Chen y Serevex‡‡Lao Chin et Serevex‡老陈和塞勒沃克斯‡',
    nil,
    'Mate Serevex com o auxílio de Lao-Chin, o Barriga de Ferro. Uma‡Убейте Серевекса вместе с Лао-Чинем Стальным Брюхом.‡Tötet Serevex mit der Hilfe von Lao-Chen dem eisernen Bauch.‡무쇠뱃살 라오친과 함께 세레벡스를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a Serevex con la ayuda de Lao-Chen Panza Férrea.‡‡Tuez Serevex avec l’aide de Lao Chin la Panse de Fer.‡在铁腹老陈的协助下击败塞勒沃克斯。‡',
  }
},
[31064] = {
  {
    'Nurong e Rothek‡Нужун и Ротек‡Nurong und Rothek‡누롱과 로데크‡Nurong y Rothek‡‡Nurong et Rothek‡砮荣和罗塞克‡',
    nil,
    'Derrote Rothek com a ajuda do Mestre Falcoeiro Nurong. Uma‡Воспользуйтесь помощью повелителя ястребов Нужуна, чтобы убить Ротека. задание.‡Tötet Rothek mit Hilfe von Falkenmeister Nurong.‡매사냥꾼 누롱과 함께 로데크를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a Rothek con la ayuda del maestro de halcones Nurong.‡‡Tuez Rothek avec l’aide du Maître des faucons Nurong.‡在鹰眼大师砮荣的协助下击败罗塞克。‡',
  }
},
[31065] = {
  {
    'Enterrado lá embaixo‡Спрятано внутри‡Verschüttet‡아래 묻힌 건...‡Enterrados‡‡Enfoui dans les profondeurs‡洞悉‡',
    nil,
    'Olhe através da luneta no Posto de Guarda de Rensai. Uma‡Посмотрите в подзорную трубу на дозорном пункте Жэнь-сая.‡Schaut durch das Handfernrohr an Rensais Wachposten.‡런싸이의 감시초소에 있는 망원경으로 상황을 살펴야 합니다. 레벨 25 탕랑 평원‡Mira a través del catalejo en el Puesto de Vigilancia de Rensai.‡‡Utilisez la Longue-vue du Poste de garde de Rensai.‡通过任塞道口的望远镜进行观察。‡',
  }
},
[31066] = {
  {
    'Um grito das trevas‡Крик из тьмы‡Ein Ruf aus der Finsternis‡어둠 속에서 들려오는 외침‡Un grito en la oscuridad‡‡Un cri dans la nuit‡黑暗中的嘶吼‡',
    nil,
    'Mate o paragão corrompido em Kypari Vor. Uma‡Убейте оскверненный Идеал у Кипари Вор.‡Tötet den verderbten Getreuen in Kypari Vor.‡키파리 보르에서 부패한 용장을 처치해야 합니다. 레벨 30 공포의 황무지‡Mata al dechado corrupto en Kypari Vor.‡‡Tuez le Parangon corrompu à Kypari Vor.‡去凯帕圣树·沃尔杀死被侵蚀的英杰。‡',
  }
},
[31067] = {
  {
    'Nos céus, ecoa da guerra‡Война жужжит на небесах‡Wenn Krieg den Himmel ganz erfüllt‡하늘에 전운이 감돌 때‡Los cielos rezuman guerra‡‡Déclaration de guerre‡战云密布‡',
    nil,
    'Mate Azzix K\'tai. Uma‡Убейте Аззикса К\'тая.‡Tötet Azzix K\'tai.‡아직스 크타이를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a Azzix K\'tai.‡‡Tuez Azzix K’tai.‡击败艾兹克西·卡泰。‡',
  }
},
[31068] = {
  {
    'Receita sagrada‡Священный рецепт‡Heiliges Rezept‡신성한 비법‡Receta sagrada‡‡Une recette sacrée‡神圣配方‡',
    nil,
    'Leve o Pergaminho do Auspício para Lya das Dez Canções no Parque Cervejeiro do Poente. Uma‡Принесите свиток с предсказанием Ля Десять Песен в хмелеваренный дворик "На закате".‡Bringt die Rolle der Vorzeichen zu Lya von den Zehn Gesängen im Abendlichtbraugarten.‡점괘 두루마리를 일몰 양조정원에 있는 열 곡조의 리아에게 가져가야 합니다. 레벨 30 공포의 황무지‡Lleva el pergamino de auspicios a Lya de las Diez Canciones en el Jardín de la Cebada Crepuscular.‡‡Apportez le Parchemin d’auspice à Lya des Dix mélodies, au Chai du couchant.‡将预言之卷带给落日酒坊的丽亚·十歌。‡',
  }
},
[31069] = {
  {
    'Ligado por sombra‡Связанные тенью‡Mit Schatten gebunden‡그늘로 엮이리라‡Ligada con sombra‡‡Lié par l’ombre‡融入阴影‡',
    nil,
    'Recolha 100 gotas de Sombra matando criaturas do sha e a fauna nas redondezas do Parque Cervejeiro do Poente. Uma‡Соберите 100 капель тени, убив существ ша и оскверненных ша диких животных в окрестностях хмелеваренного дворика "На закате".‡Erntet 100 Schattentropfen, indem Ihr Sha und wilde Tiere in der Nähe des Abendlichtbraugartens tötet.‡일몰 양조정원 부근에서 샤 생명체와 야생동물을 처치하여 그늘 100개를 모아야 합니다. 레벨 30 공포의 황무지‡Consigue 100 gotas de sombra matando a criaturas de sha y animales salvajes cerca del Jardín de la Cebada Crepuscular.‡‡Procurez-vous 100 gouttes d’Ombre en tuant des créatures sha et des animaux près du Chai du couchant.‡杀死落日酒坊附近的煞魔生物和野生动物，采集100滴阴影。‡',
  }
},
[31070] = {
  {
    'Adagas dos grandes‡Кинжалы великих‡Dolche der Großen‡위대한 자들의 단검‡Las dagas de los Magnos‡‡Les dagues des Tout-puissants‡巨兽之匕‡',
    nil,
    'Obtenha 3 Dentes de Mushan Grandes. Uma‡Добудьте 3 больших зуба мушана.‡Besorgt 3 große Mushanzähne.‡거대한 무샨 이빨 3개를 모아야 합니다. 레벨 30 공포의 황무지‡Obtén 3 dientes grandes de mushan.‡‡Procurez-vous 3 Grandes dents de mushan.‡获取3颗巨型穆山兽牙。‡',
  }
},
[31071] = {
  {
    'Que vergonha‡Позор мне‡Schande über mich‡종족의 수치‡Soy una vergüenza para los míos‡‡Le poids de la honte‡我辜负了大家‡',
    nil,
    'Localize o Barril Perdido, as Canecas Perdidas e os Suprimentos de Piquenique Perdidos. Uma‡Найдите потерянный бочонок, потерянные кружки и потерянные припасы для пикника.‡Findet das verlorene Fässchen, die verlorenen Krüge und die verlorenen Picknickutensilien.‡잃어버린 맥주통, 잃어버린 맥주잔, 잃어버린 소풍 보급품을 찾아야 합니다. 레벨 30 공포의 황무지‡Encuentra el barril perdido, las jarras perdidas y los suministros de picnic perdidos.‡‡Trouvez le Tonneau perdu, les Chopes perdues et les Fournitures de pique-nique perdues.‡找回丢失的酒桶、丢失的酒杯和丢失的野餐食品。‡',
  }
},
[31072] = {
  {
    'Adagas partidas‡Добыть кинжалы‡Scharfe Dolche‡날카로운 단검들‡Las afiladas dagas‡‡Obtention de dagues‡撕裂之匕‡',
    nil,
    'Consiga a Lâmina de Kz\'Kzik e a Lâmina de Ilikkax. Uma‡Добудьте клинок Кз\'Кзика и клинок Иликкакса.‡Besorgt Kz\'Kziks und Ilikkax\' Klingen.‡크즈크지크의 검과 일릭칵스의 검을 획득해야 합니다. 레벨 30 공포의 황무지‡Obtén la hoja de Kz\'Kzik y la hoja de Ilikkax.‡‡Procurez-vous la Lame de Kz’Kzik et la Lame d’Ilikkax.‡获得克兹克兹克之刃和伊力卡克西之刃。‡',
  }
},
[31073] = {
  {
    'Atados por madeira‡Скованные древом‡Durch Holz gebunden‡숲으로 엮이리라‡Se ligarán con madera‡‡Lié par le bois‡融入木头‡',
    nil,
    'Recolha 8 pedaços de Durâmen Cheiroso. Uma‡Добудьте 8 кусков ароматной древесной сердцевины.‡Besorgt 8 Stücke duftendes Kernholz.‡향기로운 미성숙재 8조각을 입수해야 합니다. 레벨 30 공포의 황무지‡Obtén 8 piezas de corazón de madera fragante.‡‡Procurez-vous 8 Noyaux de bois odorant.‡收集8块芬芳的芯材。‡',
  }
},
[31074] = {
  {
    'Madeira e sombra‡Дерево и тень‡Holz und Schatten‡숲과 그늘‡Madera y sombras‡‡Bois et ombre‡木头和阴影‡',
    nil,
    'Encontre o Marco da Imperatriz e a Raiz Vital de Kypari Vor. Uma‡Найдите знак императрицы и главный корень дерева Кипари Кор.‡Findet das Mal der Kaiserin und die Herzwurzel von Kypari Kor.‡여제의 징표와 키파리 코르의 심장뿌리를 찾아야 합니다. 레벨 30 공포의 황무지‡Encuentra la marca de la Emperatriz y la raíz central de Kypari Kor.‡‡Trouvez la Marque de l’impératrice et le Cœuracine de Kypari Kor.‡找到女皇的印记和凯帕圣树·库尔的心源根。‡',
  }
},
[31075] = {
  {
    'Reis do poente‡Закатные короли‡Könige des Sonnenuntergangs‡일몰 왕‡Reyes del atardecer‡‡Les rois du Crépuscule‡日落之王‡',
    nil,
    'Encontre o Mestre da Seiva Vu na Vila de Rikkitun. Uma‡Встретьтесь с соковаром Ву в деревне Риккитун.‡Trefft Euch mit Saftmeister Vu in Rikkitun.‡리키툰 마을에서 수액전문가 부를 만나야 합니다. 레벨 30 공포의 황무지‡Reúnete con el maestro de savia Vu en la Aldea Rikkitun.‡‡Rejoignez le Maître résinier Vu à Rikkitun.‡去里基屯村找树脂大师吴暮。‡',
  }
},
[31076] = {
  {
    'O destino dos Maltes do Trovão‡Судьба семейства Буйный Портер‡Das Schicksal der Sturmbräus‡스톰스타우트 가의 운명‡El destino de los Cerveza de Trueno‡‡Le destin des Brune d’Orage‡风暴烈酒的命运‡',
    nil,
    'Pergunte aos moradores do Parque Cervejeiro do Poente se eles viram algum Malte do Trovão. Uma‡Спросить у обитателей хмелеваренного дворика "На закате", не видели ли они Буйных Портеров.‡Fragt die Bewohner des Abendlichtbraugartens, ob sie Sturmbräus gesehen haben.‡일몰 양조정원에 있는 이들에게 스톰스타우트 성을 가진 이를 본 적이 있는지 물어봐야 합니다. 레벨 30 공포의 황무지‡Pregunta a los habitantes del Jardín de la Cebada Crepuscular si han visto a algún Cerveza de Trueno.‡‡Demandez aux habitants du Chai du couchant s’ils ont vu des Brune d’Orage.‡向落日酒坊的居民询问风暴烈酒族人的下落。‡',
  }
},
[31077] = {
  {
    'Evie Malte do Trovão‡Эви Буйный Портер‡Evie Sturmbräu‡에비 스톰스타우트‡Evie Cerveza de Trueno‡‡Evie Brune d’Orage‡艾薇·风暴烈酒‡',
    nil,
    'Fale com Chen Malte do Trovão no Parque Cervejeiro do Poente e ouça o panegírico dele. Uma‡Подойдите к Чэню в хмелеваренном дворике "На закате" и прослушайте его скорбную песнь.‡Hört Euch Chens Trauerrede im Abendlichtbraugarten an.‡일몰 양조정원에 있는 첸 스톰스타우트를 만나 추도문 읽는 것을 들어야 합니다. 레벨 30 공포의 황무지‡Escucha el elogio de Chen Cerveza de Trueno en el Jardín de la Cebada Crepuscular.‡‡Retrouvez Chen Brune d’Orage au Chai du couchant, puis écoutez son éloge funèbre.‡去落日酒坊和陈·风暴烈酒汇合，并听他念诵悼词。‡',
  }
},
[31078] = {
  {
    'Han Malte do Trovão‡Хань Буйный Портер‡Han Sturmbräu‡한 스톰스타우트‡Han Cerveza de Trueno‡‡Han Brune d’Orage‡韩·风暴烈酒‡',
    nil,
    'Encontre Han Malte do Trovão na Câmara do Porvir, embaixo de Kor\'vess. Uma‡Найдите Ханя Буйного Портера в Зале Потоков под Кор\'вессом.‡Findet Han Sturmbräu in der Morgenkammer unter Kor\'vess.‡코르베스 아래 여명의 방에서 한 스톰스타우트를 찾아야 합니다. 레벨 30 공포의 황무지‡Encuentra a Han Cerveza de Trueno en la Cámara del Mañana, debajo de Kor\'vess.‡‡Trouvez Han Brune d’Orage dans la Chambre des Demains sous Kor’vess.‡去库尔维斯下面的破晓大厅找到韩·风暴烈酒。‡',
  }
},
[31079] = {
  {
    'O horror, o horror‡Страх из долин‡Der Schrecken nimmt zu‡공포가 닥치다‡Cuando surja el horror‡‡Au moment de l’horreur‡恐怖升腾‡',
    nil,
    'Mate 7 Tocaieiros Trôpegos e 2 Kyparitas. Uma‡Убейте 7 слоняющихся туманных скрытней и 2 кипаритов.‡Tötet 7 schlurfende Nebellauerer und 2 Kypariten.‡절룩 안개도깨비 7마리와 키파라이트 2마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 7 rondadores de bruma arrastrapiés y a 2 gusanos de kyparita.‡‡Tuez 7 Rôdeurs des brumes traînants et 2 Kyparites.‡杀死7只蹒跚的雾行鬼和2只凯帕琥珀虫。‡',
  }
},
[31080] = {
  {
    'Asas de fogo‡Ярость бурь королей закатных‡Feurige Flügel‡불타는 날개‡Alas ígneas‡‡Ailes de feu‡火焰之翼‡',
    nil,
    'Dê um tapa nos Purpurinos de Rikkilea, depois colete 88 unidades de Pó de Purpurino. Uma‡Потряси порхунов Риккили, а затем поймай 88 крупинок пыльцы порхунов.‡Stupst Rikkileaflatterlinge und fangt dann 88 Sprenkel Flatterlingsstaub.‡리키리아 나풀요정용을 때려서 나풀요정용 가루 88개를 모아야 합니다. 레벨 30 공포의 황무지‡Golpea a los dragonillas de Rikkilea y recoge 88 motas de polvo de dragonilla.‡‡Frappez des Papillonneurs rikkiléa, puis attrapez 88 flocons de Poussière de papillonneur.‡拍打里基利亚飞掠者，收集88份飞掠之尘。‡',
  }
},
[31081] = {
  {
    'Encantamentos formais e primevos‡Заклятья, что силу хранят в веках‡Urzeitliche Geisterzauber‡먼 옛날 태고의 주문‡Conjuros fantásticos y primitivos‡‡Des incantations de lutins primitifs‡咒法妖精‡',
    nil,
    'Mate Ahgunoss e Mygoness. Uma‡Уничтожьте Агуносса и Мигонесса.‡Tötet Ahgunoss und Mygoness.‡아구노스와 미고네스를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a Ahgunoss y a Mygoness.‡‡Tuez Ahgunoss et Mygoness.‡杀死阿古诺什和米古纳什。‡',
  }
},
[31082] = {
  {
    'O grande barco da salvação‡Вместилище нашего избавленья‡Das Gefäß des Heils‡거대한 구조선‡Gran vehículo para la salvación‡‡La grande coupe du salut‡救赎方舟‡',
    nil,
    'Leve 3 Sementes-mãe à alcova da colheita na Vila de Rikkitun com a ajuda dos Cantores Rikkitun.Você pode usar o Sino de Rikkitun para reconvocar seus cantores se você se separar deles.‡Принесите 3 семени матери древ в яму для семян в деревне Риккитун с помощью заклинателей Риккитун.Вы можете использовать колокол Риккитун, чтобы призвать заклинателей, если вы потеряете друг друга.‡Bringt mit der Hilfe der Rikkitunsänger 3 Muttersaatexemplare zur Sammelgrube in Rikkitun.Wenn Ihr von Euren Sängern getrennt werdet, könnt Ihr sie mit der Glocke von Rikkitun erneut herbeirufen.‡리키툰 아우성쟁이의 도움을 받아 리키툰 마을의 어머니씨앗 구덩이에 어머니씨앗 3개를 가져가야 합니다.아우성쟁이가 안 보이면 리키툰 종을 사용하여 아우성쟁이를 다시 소환할 수 있습니다.‡Lleva 3 semillas madre hasta el foso de recogida en la Aldea Rikkitun con la ayuda de los coristas de Rikkitun.Puedes utilizar la campana Rikkitun para reunir a tus coristas si os separáis.‡‡Apportez 3 Graines-mères à la fosse de collecte de Rikkitun avec l’aide des Psalmodieurs rikkitun.Vous pouvez utiliser la Cloche de Rikkitun pour invoquer à nouveau vos psalmodieurs si vous êtes séparés.‡在里基屯吟咏者的协助下将3颗母种带回里基屯村的集种坑。如果你们走散了，可以用里基屯摇铃重新召唤吟咏者。‡',
  }
},
[31083] = {
  {
    'Promessas douradas‡Обещание золота‡Goldversprechen‡금 같은 약속‡Promesas de oro‡‡Promesses d’or‡一诺千金‡',
    nil,
    'Apresente-se ao Chefe Rikkitun na Vila de Rikkitun, que fica no Ermo do Medo. Uma‡Доложите вождю Риккитун в деревне Риккитун, что в Жутких пустошах.‡Sprecht mit Häuptling Rikkitun in Rikkitun in der Schreckensöde.‡공포의 황무지의 리키툰 마을에 있는 족장 리키툰에게 보고해야 합니다. 레벨 30 공포의 황무지‡Preséntate ante el jefe Rikkitun en la Aldea Rikkitun, en el Desierto del Pavor.‡‡Faites votre rapport au Chef rikkitun à Rikkitun, dans les Terres de l’Angoisse.‡向恐惧废土的里基屯村的里基屯酋长报到。‡',
  }
},
[31084] = {
  {
    'Ritual de união‡Связать чары‡Die Bindung des Glanzes‡마법결속‡Ligan el encanto‡‡Lier le charme‡施法‡',
    nil,
    'Permita que o Chefe Rikkitun encante a Lâmina Bifurcada. Uma‡Позвольте вождю Риккитун зачаровать раздвоенный клинок.‡Erlaubt, dass Häuptling Rikkitun die Gegabelte Klinge verzaubert.‡족장 리키툰이 갈라진 칼날에 주문을 걸게 해 줘야 합니다. 레벨 30 공포의 황무지‡Deja que el jefe Rikkitun encante la hoja ahorquillada.‡‡Laissez le Chef rikkitun enchanter la Lame fourchue.‡让里基屯酋长为分叉之刃施法。‡',
  }
},
[31085] = {
  {
    'O medo e o fogo antigos‡Огонь и былого страх‡Feuer und Ängste‡고대의 불길과 두려움‡Fuegos y temores de antaño‡‡Les feux et les peurs d’antan‡远古的血与火‡',
    nil,
    'Use a Forquilha da Ruína em Iyyokuk, o Lúcido, depois proteja-o até que ele consiga escapar. Uma‡Используйте двузубец разрушения на Ийокуке Проницательном, а затем защитите его, пока он не сможет спастись.‡Benutzt die Gabel des Ruins bei Iyyokuk dem Wachen und beschützt ihn dann, bis er entkommen kann.‡또렷한 의식의 이요쿠크에게 파멸의 갈래날을 사용한 후, 그가 탈출할 수 있게 될 때까지 보호해야 합니다.‡Utiliza la horquilla de perdición con Iyyokuk el Lúcido y luego protégelo hasta que pueda escapar.‡‡Utilisez la Fourche de ruine sur Iyyokuk le Lucide, puis protégez-le jusqu’à ce qu’il puisse s’échapper.‡对明澈者伊约库克使用毁灭之叉，然后保护他逃脱。‡',
  }
},
[31086] = {
  {
    'Sangue dos antigos‡Кровь Древних‡Uraltes Blut‡고대의 피‡Sangre de los Ancestros‡‡Le sang des anciens‡远古之血‡',
    nil,
    'Consiga um Pedaço de Âmbar Solidificado. Uma‡Добудьте кусок затвердевшего янтаря.‡Besorgt einen Brocken erstarrten Berns.‡굳어진 호박석 덩어리를 구해야 합니다. 레벨 30 공포의 황무지‡Obtén una muestra de ámbar solidificado.‡‡Procurez-vous 1 Morceau d’ambre solidifié.‡获得一大块固化琥珀。‡',
  }
},
[31087] = {
  {
    'Expandindo nossa cobertura‡Усиление сигнала‡Unsere Reichweite ausbauen‡봉화를 올려라‡Extender la cobertura‡‡Renforcer le signal‡扩大范围‡',
    nil,
    'Ative o Transmissor Ressoante na Ravina Brilhâmbar. Uma‡Активируйте резонирующий маячок в Янтарном зале.‡Aktiviert das resonierende Signal in der Bernscheinkuhle.‡호박빛 동굴에 있는 공명의 봉화를 밝혀야 합니다. 레벨 30 공포의 황무지‡Activa la baliza resonadora en la Cuenca del Resplandor Ámbar.‡‡Activez la Balise de résonance dans le Creux de Luisambre.‡激活珀光裂窟的共鸣信标。‡',
  }
},
[31088] = {
  {
    'Crime e Castigo‡Преступление и наказание‡Schuld und Sühne‡죄와 벌‡Crimen y castigo‡‡Crime et châtiment‡罪与罚‡',
    nil,
    'Mate 8 Colhedores Ik\'thik na Trilha Cortante. Uma‡Убейте 8 ик\'тиков-жнецов на Жгучей тропе.‡Tötet 8 Bernernter der Ik\'thik auf dem Stechenden Pfad.‡바늘길에서 이크티크 채집꾼 8마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 8 cosechadores Ik\'thik en La Senda del Aguijón.‡‡Tuez 8 Moissonneurs ik’thik à la Piste Brûlante.‡在刺芒小径杀死8个伊克提克收割者。‡',
  }
},
[31089] = {
  {
    'No mar, nunca mais‡Уже не у моря‡Niemals wieder am Meer‡바다 옆에서, 두 번 다시는‡Junto al mar, nunca más‡‡Le retrait de la mer‡大海的庇佑，一去不返‡',
    nil,
    'Use o Diapasão Klaxxi nas Rochas Gastas pelo Oceano para acordar o paragão. Uma‡Поднесите камертон клакси к океаническим камням и пробудите Идеал.‡Benutzt die Stimmgabel der Klaxxi bei den meergepeitschten Felsen, um den Getreuen zu erwecken.‡파도에 닳은 바위에 클락시 조율용 굽쇠를 사용해 용장을 깨워야 합니다. 레벨 30 공포의 황무지‡Utiliza el diapasón Klaxxi en las rocas desgastadas por el océano para despertar al dechado.‡‡Utilisez le Diapason klaxxi sur les Rochers usés par l’océan pour réveiller le Parangon.‡对海水侵蚀的岩石使用卡拉克西音叉来唤醒英杰。‡',
  }
},
[31090] = {
  {
    'Melhorando com a idade‡Чем старше, тем лучше‡Je älter, desto besser‡오래 묵을수록 진국‡Mejora con el tiempo‡‡Affiné par les ans‡越陈越香‡',
    nil,
    'Colete 7 Jarros Cheios de Âmbar dos Coletores de Âmbar na Trilha Cortante. Uma‡Соберите 7 кувшинов с янтарем с накопителей янтаря на Жгучей тропе.‡Sammelt 7 mit Bern gefüllte Gläser von den Bernsammlern auf dem Stechenden Pfad.‡바늘길의 호박 수집기에서 호박이 든 병 7개를 모아야 합니다. 레벨 30 공포의 황무지‡Recoge 7 tarros llenos de ámbar de los recolectores de ámbar de La Senda del Aguijón.‡‡Récoltez 7 Jarres remplies d’ambre sur les Collecteurs d’ambre impériaux de la Piste Brûlante.‡在刺芒小径从琥珀采集器上收集7个装满琥珀的罐子。‡',
  }
},
[31091] = {
  {
    'Reencontro‡Воссоединение‡Wiedervereinigt!‡재회‡Reunidos‡‡Retrouvailles‡物归原主‡',
    nil,
    'Ajude Kaz\'tik, o Manipulador, enquanto ele desenterra sua maior arma. Uma‡Помогите Каз\'тику Манипулятору, пока он выкапывает свое величайшее оружие. задание.‡Helft Kaz\'tik dem Manipulator, seine größte Waffe zutage zu fördern.‡배후자 카즈티크가 자신의 최고의 무기를 찾아내는 동안 도와야 합니다. 레벨 30 공포의 황무지‡Ayuda a Kaz\'tik el Manipulador mientras desentierra su mejor arma.‡‡Protégez Kaz’tik le Manipulateur pendant qu’il déterre sa meilleure arme.‡在操纵者卡兹提克寻找他最强大的武器时，帮助他。‡',
  }
},
[31092] = {
  {
    'Coma ou seja comido‡Покормить или стать обедом‡Füttern oder gefressen werden‡먹느냐 먹히느냐‡Come o sé comido‡‡Nourrir ou servir de nourriture‡要么喂它，要么被吃掉‡',
    nil,
    'Comece o treinamento de Kovok alimentando-o com 6 Filés Suculentos de Tartaruga retirados das Tartaliscas Salconcha nos Alagados. Um(a) missão.‡Начните обучение Ковока, скормив ему 6 порций сочного черепашьего филе. Его можно добыть, убивая океанических крепкохватов на Соленой отмели.‡Beginnt mit Kovoks Erziehung, indem Ihr ihn mit 6 saftigen Schildkrötenfilets von Salzpanzerschnappern aus dem Salzigen Schlick füttert.‡코보크의 훈련을 시작하십시오. 소금물 갯벌에 있는 바닷물비늘 무쇠턱거북을 처치하면 얻을 수 있는 육즙이 많은 거북 살코기 6개를 코보크에게 먹여야 합니다.‡Empieza el entrenamiento de Kovok dándole de comer 6 filetes de tortuga suculentos que encontrarás en los sacudidores Conchasalada de La Mugre Salobre.‡‡Commencez le dressage de Kovok en lui offrant 6 Filets de tortue succulents obtenus sur les Mordeuses saumécailles de la Bourbe saumâtre.‡给科沃克喂食6块多汁的乌龟肉片以开始对它的训练。你可以在盐碱泥滩的盐壳钳嘴龟身上找到这种肉。‡',
  }
},
[31093] = {
  {
    'Hozens nas brumas‡Хозен в тумане‡Ho-zen im Nebel‡안개 속의 호젠‡Hozen en la niebla‡‡Hozen dans la brume‡《雾锁猢狲》‡',
    nil,
    'Leve Hozens nas Brumas ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите работу "Хозен в тумане" хранителю истории Чо в Обитель Мудрости. Награда: .‡Bringt "Ho-zen im Nebel" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 안개 속의 호젠을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Hozen en la niebla al eremita Cho en el Trono del Saber.‡‡Apportez Hozen dans la brume au Chroniqueur Cho, au Siège de la Connaissance.‡将《雾锁猢狲》带给闻道之座的游学者周卓。‡',
  }
},
[31094] = {
  {
    'Histórias de Pescador‡Рыбьи байки‡Fischschwänke‡물고기 이야기‡Cuentos de peces‡‡Histoires d’eau‡锦鱼传‡',
    nil,
    'Leve "Histórias de Pescador" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите книгу "Рыбьи хвосты" хранителю истории Чо в Обитель Мудрости. Награда: .‡Bringt "Fischschwänke" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 물고기 이야기를 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Cuentos de peces al eremita Cho, en el Trono del Saber.‡‡Apportez Histoires d’eau au Chroniqueur Cho, au Siège de la Connaissance.‡将《鱼尾传》带给闻道之座的游学者周卓。‡',
  }
},
[31095] = {
  {
    'O sombrio coração dos mogus‡Черное сердце могу‡Das dunkle Herz der Mogu‡모구의 검은 심장‡El corazón oscuro de los mogu‡‡Le sombre cœur des mogu‡《魔古的黑心》‡',
    nil,
    'Leve "O sombrio coração dos mogus" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите книгу "Черное сердце могу" хранителю истории Чо в Обитель Мудрости.‡Bringt "Das dunkle Herz der Mogu" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 모구의 검은 심장을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva El corazón oscuro de los mogu al eremita Cho, en el Trono del Saber.‡‡Apportez Le sombre cœur des mogu au Chroniqueur Cho, au Siège de la Connaissance.‡将《魔古的黑心》带给闻道之座的游学者周卓。‡',
  }
},
[31096] = {
  {
    'Pelo que vale a pena lutar‡За что стоит сражаться‡Wofür es sich zu kämpfen lohnt‡무엇이 싸울 가치가 있는가‡Por qué merece la pena luchar‡‡Combattre pour ce qui en vaut la peine‡《为何而战》‡',
    nil,
    'Leve "Pelo que vale a pena lutar" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите книгу "За что стоит сражаться" хранителю истории Чо в Обитель Мудрости.‡Bringt "Wofür es sich zu kämpfen lohnt" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 무엇이 싸울 가치가 있는가를 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Por qué merece la pena luchar al eremita Cho, en el Trono del Saber.‡‡Apportez Combattre pour ce qui en vaut la peine au Chroniqueur Cho, au Siège de la Connaissance.‡将《为何而战》带给闻道之座的游学者周卓。‡',
  }
},
[31097] = {
  {
    'O coração do enxame mantídeo‡Сердце роя богомолов‡Das Herz des Mantisschwarms‡사마귀 군단의 심장‡Corazón del enjambre mántide‡‡Le cœur de l’essaim mantide‡《螳螂群之心》‡',
    nil,
    'Leve "O coração do enxame mantídeo" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите книгу "Сердце роя богомолов" хранителю истории Чо в Обитель Мудрости.‡Bringt "Das Herz des Mantisschwarms" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 사마귀 군단의 심장을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Corazón del enjambre mántide al eremita Cho, en el Trono del Saber.‡‡Apportez Le cœur de l’essaim mantide au Chroniqueur Cho, au Siège de la Connaissance.‡将《螳螂群之心》带给闻道之座的游学者周卓。‡',
  }
},
[31098] = {
  {
    'A fundação da Ordem da Serpente das Nuvens‡Основание ордена Облачного Змея‡Founding of the Order of the Cloud Serpent‡운룡단의 창설‡La fundación de la Orden del Dragón Nimbo‡‡La création de l’ordre du Serpent-nuage‡《云端翔龙骑士团的建立》‡',
    nil,
    'Leve as "A fundação da Ordem da Serpente das Nuvens" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите книгу "Основание ордена Облачного Змея" хранителю истории Чо в Обитель Мудрости.‡Bring Founding of the Order of the Cloud Serpent to Lorewalker Cho at the Seat of Knowledge.‡지식의 연단에 있는 전승지기 초에게 운룡단의 창설을 가져가야 합니다. 레벨 1 영원꽃 골짜기‡Lleva La fundación de la Orden del Dragón Nimbo al eremita Cho, en el Trono del Saber.‡‡Apportez La création de l’ordre du Serpent-nuage au Chroniqueur Cho, au Siège de la Connaissance.‡将《云端翔龙骑士团的建立》带给闻道之座的游学者周卓。‡',
  }
},
[31099] = {
  {
    'O ataque dos klaxxis‡Атака клакси‡Klaxx Attack‡클락스 공격‡Ataque Klaxxi‡‡L’attaque des Klaxxi‡《卡拉克西之战》‡',
    nil,
    'Leve "O ataque dos klaxxis" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите книгу "Атака клакси" хранителю истории Чо в Обитель Мудрости. Награда: .‡Bring Klaxx Attack to Lorewalker Cho at the Seat of Knowledge.‡지식의 연단에 있는 전승지기 초에게 클락스 공격을 가져가야 합니다. 레벨 1 영원꽃 골짜기‡Lleva Ataque Klaxxi al eremita Cho, en el Trono del Saber.‡‡Apportez L’attaque des Klaxxi au Chroniqueur Cho, au Siège de la Connaissance.‡将《卡拉克西之战》带给闻道之座的游学者周卓。‡',
  }
},
[31100] = {
  {
    'A canção dos yaungóis‡Песнь яунголов‡Das Lied der Yaungol‡야운골의 노래‡La canción de los yaungol‡‡La chanson des yaungols‡《野牛人之歌》‡',
    nil,
    'Leve "A canção dos yaungóis" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите "Песнь яунголов" хранителю истории Чо в Обитель Мудрости.‡Bringt das "Lied der Yaungol" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 야운골의 노래를 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva La canción de los yaungol al eremita Cho, en el Trono del Saber.‡‡Apportez La chanson des yaungols au Chroniqueur Cho, au Siège de la Connaissance.‡将《野牛人之歌》带给闻道之座的游学者周卓。‡',
  }
},
[31101] = {
  {
    'Lendas dos anciãos cervejeiros‡Легенды древних хмелеваров‡Legenden der Brauväter‡양조대부의 전설‡Leyendas de los cerveceros fundadores‡‡Légendes des pères brasseurs‡《酒中仙传奇》‡',
    nil,
    'Leve as "Lendas dos anciãos cervejeiros" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите "Легенды древних хмелеваров" хранителю истории Чо в Обитель Мудрости.‡Bringt "Legenden der Brauväter" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 양조대부의 전설을 가져가야 합니다. 레벨 1 영원꽃 골짜기‡Lleva Leyendas de los cerveceros fundadores al eremita Cho, en el Trono del Saber.‡‡Apportez les Légendes des pères brasseurs au Chroniqueur Cho, au Siège de la Connaissance.‡将《酒中仙传奇》带给闻道之座的游学者周卓。‡',
  }
},
[31102] = {
  {
    'Os sete fardos de Shaohao‡Семь бремен Шаохао‡Die sieben Bürden des Shaohao‡샤오하오의 일곱 짐‡Las siete cargas de Shaohao‡‡Les sept fardeaux de Shaohao‡《少昊的七罪责》‡',
    nil,
    'Leve "Os sete fardos de Shaohao" ao Andarilho das Lendas Cho na Cátedra do Conhecimento. Uma‡Принесите "Семь бремен Шаохао" хранителю истории Чо в Обитель Мудрости. Награда: .‡Bringt "Die sieben Bürden des Shaohao" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 샤오하오의 일곱 짐을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Las siete cargas de Shaohao al eremita Cho, en el Trono del Saber.‡‡Apportez Les sept fardeaux de Shaohao au Chroniqueur Cho, au Siège de la Connaissance.‡将《少昊的七罪责》带给闻道之座的游学者周卓。‡',
  }
},
[31103] = {
  {
    'A Balada de Liu Lang‡Баллада о Лю Лане‡Die Ballade von Liu Lang‡리우 랑의 노래‡La balada de Liu Lang‡‡La ballade de Liu Lang‡《刘浪之歌》‡',
    nil,
    'Leve "A balada de Liu Lang" ao Andarilho das Lendas Cho no Trono do Conhecimento. Uma‡Принесите "Балладу о Лю Лане" хранителю истории Чо в Обитель Мудрости.‡Bringt die "Ballade von Liu Lang" zu Lehrensucher Cho im Heim des Wissens.‡지식의 연단에 있는 전승지기 초에게 리우 랑의 노래를 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva La balada de Liu Lang al eremita Cho, en el Trono del Saber.‡‡Apportez la Ballade de Liu Lang au Chroniqueur Cho, au Siège de la Connaissance.‡将《刘浪之歌》带给闻道之座的游学者周卓。‡',
  }
},
[31104] = {
  {
    'O Ringue do Desafiante: Yalia Sábio Sussurro‡Бойцовский круг: Ялия Мудрый Шепот‡Der Ring des Herausforderers: Yalia Weisenwisper‡도전자의 대련장: 야리아 세이지위스퍼‡El Círculo del Contendiente: Yalia Murmullo Sabio‡‡L’Arène des combattants : Yalia Sage Murmure‡挑战者之环：雅丽亚·圣言者‡',
    nil,
    'Desafie Yalia Sábio Sussurro e derrote-a no Ringue do Desafiante. Uma‡Бросьте вызов Ялии Мудрый Шепот и победите ее в бойцовском круге.‡Fordert Yalia Weisenwisper heraus und bezwingt sie im Ring des Herausforderers.‡야리아 세이지위스퍼에게 도전해 도전자의 대련장에서 그를 꺾어야 합니다. 레벨 25 탕랑 평원‡Desafía a Yalia Murmullo Sabio y derrótala en el Círculo del Contendiente.‡‡Défiez et battez Yalia Sage Murmure dans l’Arène des combattants.‡挑战雅丽亚·圣言者，并在挑战者之环击败她。‡',
  }
},
[31105] = {
  {
    'A ameaça mogu‡Угроза могу‡Die Mogubedrohung‡모구의 음모‡La amenaza mogu‡‡La menace mogu‡魔古的威胁‡',
    nil,
    'Mate 12 Amarra-serpentes Shan\'ze ou Senhores das Feras Shan\'ze. Uma‡Убейте 12 змееловов Шань\'цзэ или повелителей зверей Шань\'цзэ.‡Tötet 12 Schlangenbinder oder Bestienmeister der Shan\'ze.‡샨쩌 운룡결속자나 샨쩌 야수조련사 12명을 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 12 vinculadores de dragones de Shan\'ze o maestros de bestias de Shan\'ze.‡‡Tuez 12 Lieurs de serpents shan’ze ou Belluaires shan’ze.‡击败12个山泽缚龙者或山泽兽王。‡',
  }
},
[31106] = {
  {
    'A ameaça mogu‡Угроза могу‡Die Mogubedrohung‡모구의 음모‡La amenaza mogu‡‡La menace mogu‡魔古的威胁‡',
    nil,
    'Mate 12 Amarra-serpentes Shan\'ze ou Senhores das Feras Shan\'ze. Uma‡Убейте 12 змееловов Шань\'цзэ или повелителей зверей Шань\'цзэ.‡Tötet 12 Schlangenbinder oder Bestienmeister der Shan\'ze.‡샨쩌 운룡결속자나 샨쩌 야수조련사 12명을 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 12 vinculadores de dragones de Shan\'ze o maestros de bestias de Shan\'ze.‡‡Tuez 12 Lieurs de serpents shan’ze ou Belluaires shan’ze.‡击败12个山泽缚龙者或山泽兽王。‡',
  }
},
[31107] = {
  {
    'Cidadãos de um novo império‡Граждане новой империи‡Bürger eines neuen Reichs‡새 제국의 시민‡Ciudadanos de un Imperio nuevo‡‡Citoyens d\'un nouvel empire‡新帝国的公民‡',
    nil,
    'Colete 10 Ovos de Vor\'thik em Kypari Vor. Uma‡Соберите 10 яиц вор\'тиков у Кипари Вор.‡Sammelt 10 Eier der Vor\'thik in Kypari Vor.‡키파리 보르에서 보르티크 알 10개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 10 huevos Vor\'thik en Kypari Vor.‡‡Ramassez 10 Œufs vor’thik à Kypari Vor.‡去凯帕圣树·沃尔收集10个沃提克虫卵。‡',
  }
},
[31108] = {
  {
    'Medo concentrado‡Воплощение страха‡Konzentrierte Furcht‡응집된 공포‡Miedo concentrado‡‡Peur concentrée‡密集的恐惧‡',
    nil,
    'Colete 4 Focos de Âmbar do Medo dos Molda-medo Vor\'thik em Kypari Vor. Uma‡Соберите 4 куска жуткого янтаря с вор\'тиков-жуткоревов в Кипари Вор.‡Sammelt 4 Schreckensbernfokusse von den Angstformern der Vor\'thik in Kypari Vor.‡키파리 보르에 있는 보르티크 공포구체병에게서 공포의 호박석 핵 4개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 4 focos de ámbar aterrador de los formadores de miedo Vor\'thik en Kypari Vor.‡‡Collectez 4 Focalisations d’ambre d\'effroi sur les Formepeurs vor\'thik à Kypari Vor.‡从凯帕圣树·沃尔的沃提克塑恐者身上收集4块恐惧琥珀焦镜。‡',
  }
},
[31109] = {
  {
    'Exterminando o enxame‡Уничтожение роя‡Die Vernichtung des Schwarms‡무리의 도태‡La matanza del enjambre‡‡Affaiblir l’essaim‡血洗虫群‡',
    nil,
    'Mate 40 Mantídeos de Shek\'zeer nas Ninhadas de Shek\'zeer. Fale com Kil\'ruk, o Aniquilador dos Ventos, para conseguir transporte aéreo. Um(a) missão.‡Уничтожьте 40 Шек\'зир-роерожденных во Владениях Шек\'зир. Поговорите с Кил\'руком Рассекающим Ветер, чтобы отправиться туда.‡Tötet 40 Mantis der Shek\'zeer in den Gelegen von Shek\'zeer. Bittet Kil\'ruk den Windschnitter, Euch dort abzusetzen.‡셰크지르의 손아귀에서 셰크지르 사마귀 40마리를 처치해야 합니다. 공중 강하를 하려면 칼날바람 킬루크와 대화하십시오.‡Mata a 40 mántides Shek\'zeer en La Nidada de Shek\'zeer. Habla con Kil\'ruk el Atracavientos para solicitar transporte aéreo.‡‡Tuez 40 Mantides shek’zeer dans les Nids de Shek’zeer. Parlez à Kil’ruk le Saccageur des vents pour un largage aérien.‡在夏柯希尔之巢杀死40只夏柯希尔螳螂妖。和掠风者克尔鲁克谈一谈，进行空降。‡',
  }
},
[31110] = {
  {
    'Através do portal‡Через портал‡Durch das Portal‡차원문을 지나‡A través del portal‡‡À travers le portail‡穿过传送门‡',
    nil,
    'Colete 1000 de Poeira Arcana Antiga. Uma‡Соберите 1000 порций древнего чародейского порошка.‡Sammelt 1000 Einheiten uraltes arkanes Pulver.‡고대의 불가사의한 가루 1000개를 모아야 합니다. 레벨 25 탕랑 평원‡Consigue 1000 partículas Arcanas antiguas.‡‡Récupérez 1000 Poudres des Arcanes anciennes.‡收集1000份远古魔粉。‡',
  }
},
[31111] = {
  {
    'Erradicação dos Zan\'thik‡Битва с зан\'тиками‡Die Zan\'thik auslöschen‡잔티크를 말살하라‡Erradicar a los Zan\'thik‡‡L’éradication des Zan’thik‡清剿扎尼提克‡',
    nil,
    'Mate 6 Empaladores Zan\'thik e 6 Manipuladores Zan\'thik em Zan\'vess. Uma‡Убейте 6 зан\'тиков-пронзателей и 6 зан\'тиков-манипуляторов в Зан\'вессе.‡Tötet 6 Pfähler der Zan\'thik und 6 Manipulatoren der Zan\'thik in Zan\'vess.‡잔베스에서 잔티크 관통자 6마리와 잔티크 배후자 6마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 6 empaladores Zan\'thik y a 6 manipuladores Zan\'thik en Zan\'vess.‡‡Tuez 6 Empaleurs zan’thik et 6 Manipulateurs zan’thik à Zan’vess.‡在扎尼维斯杀死6个扎尼提克穿刺者和6个扎尼提克操纵者。‡',
  }
},
[31112] = {
  {
    'Eles são tão espinhosos!‡Они такие колючие!‡Sie sind so dornig!‡앗 따가워!‡¡Vaya pinchos!‡‡Ils ont tout piqué !‡问题变得棘手了！‡',
    nil,
    'Pegue 5 Suprimentos de Emergência com os Duendes d\'Água. Uma‡Заберите 5 комплектов для оказания первой помощи у водных духов.‡Sammelt 5 Notvorräte von den Wassergeistern.‡물 요마에게서 응급 상황 대비 도구 5개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 5 suministros de emergencia de los duendes de agua.‡‡Récupérez 5 Fournitures d’urgence volées par les Lutins des eaux.‡从水精身上收集5份应急补给。‡',
  }
},
[31113] = {
  {
    'Ataque à Guarnição Avançada de Gai-Cho‡Напасть на огненный лагерь Гай-Чо‡Streitlager Gai-Cho angreifen‡불의 야영지 가이초를 공격하라‡Asalto al Campamento Gai-Cho‡‡L’attaque du campement Gai-Cho‡突袭铠胄火营‡',
    nil,
    'Mate 16 Parlaterra, Jogapiche ou Yaungóis de Gai-Cho. Uma‡Убейте 16 яунголов Гай-Чо, толкователей земли или метателей смолы.‡Tötet 16 Yaungol, Erdsprecher oder Pechschleuderer von Gai-Cho.‡가이초 야운골, 가이초 지관 또는 가이초 기름투척병 16명을 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 16 yaungol, hablatierras o lanzabreas de Gai-Cho.‡‡Tuez 16 Yaungols, Parlesols ou Lance-poix de Gai-Cho.‡击败16个铠胄野牛人、铠胄地语者或铠胄投火者。‡',
  }
},
[31114] = {
  {
    'Ataque ao Platô dos Parlamorte‡Напасть на Плато Говорящего с Мертвыми‡Angriff auf das Plateau des Totensprechers‡죽음부름 고원 공격‡Asalto a la Meseta del Espiritista‡‡L’attaque du plateau du Parlemort‡突袭死语者高地‡',
    nil,
    'Mate 8 Profana-corpos Parlamorte e 1 Esmagador Parlamorte. Uma‡Убейте 8 говорящих с мертвыми – осквернителей праха и 1 говорящего с мертвыми – крушителя.‡Tötet 8 Leichenschänder des Totensprechers und 1 Zermalmer des Totensprechers.‡죽음부름 시체타락자 8명과 죽음부름 분쇄자 1명을 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 8 corruptores de cadáveres espiritistas y 1 triturador espiritista.‡‡Tuez 8 Profanateurs de corps parlemorts et 1 Écraseur parlemort.‡击败8个死语渎尸者和1个死语碾压者。‡',
  }
},
[31115] = {
  {
    'MARCAR - Han libertado‡FLAG - Freed Han‡FLAG - Freed Han‡플래그 - 한 구출‡FLAG - Han liberado‡‡DRAPEAU - Han libéré‡FLAG - Freed Han‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[31116] = {
  {
    'Pó espiritual‡Пыль духов‡Geisterstaub‡영혼 티끌‡Polvo de espíritu‡‡Poudre spirituelle‡灵魂尘‡',
    nil,
    'Devolver 8 espíritos aos seus restos mortais no Platô do Parlamorte, que fica nas Estepes de Taolong. Uma‡Верните 8 духов к их телам на Плато Говорящего с Мертвыми, что в Танлунских степях.‡Bringt 8 Geister zur ihren sterblichen Überresten auf dem Plateau des Totensprechers zurück.‡탕랑 평원의 죽음부름 고원에서 8명의 영혼을 유해로 되돌려야 합니다. 레벨 25 탕랑 평원‡Devuelve 8 espíritus a sus restos en la Meseta del Espiritista, en las Estepas de Tong Long.‡‡Renvoyez 8 Esprits dans leur cadavre au Plateau du Parlemort, dans les Steppes de Tanglong.‡在螳螂高原的死语者高地，将8个灵魂尘注入到遗骸中。‡',
  }
},
[31117] = {
  {
    'Uruk!‡Урук!‡Uruk!‡우루크!‡¡Uruk!‡‡Uruk !‡乌奴克！‡',
    nil,
    'Mate Uruk no Platô dos Parlamorte, nas Estepes de Taolong. Uma‡Убейте Урука на Плато Говорящего с Мертвыми в Танлунских степях.‡Tötet Uruk auf dem Plateau des Totensprechers in der Tonlongsteppe.‡탕랑 평원의 죽음부름 고원에서 우루크를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a Uruk en la Meseta del Espiritista, en las Estepas de Tong Long.‡‡Tuez Uruk au Plateau du Parlemort, dans les Steppes de Tanglong.‡去螳螂高原的死语者高地击败乌奴克。‡',
  }
},
[31118] = {
  {
    'O código Parlamorte‡Шифр говорящих с мертвыми‡Die Schrift der Totensprecher‡죽음부름의 암호‡La clave del espiritista‡‡Le code des parlemorts‡顺藤摸瓜‡',
    nil,
    'Colete um Pergaminho de Rituais de Amarração de Espírito dos yaungóis no Platô do Parlamorte. Uma‡Заберите у яунголов с Плато Говорящего с Мертвыми свиток с ритуалами ловли душ.‡Nehmt den Yaungol auf dem Plateau des Totensprechers eine Schriftrolle der Blutbindungsriten ab.‡죽음부름 고원에 있는 야운골에게서 암호로 쓰인 두루마리를 찾아야 합니다. 레벨 25 탕랑 평원‡Consigue un pergamino de ritual de vinculación de espíritus de los yaungol en la Meseta del Espiritista.‡‡Récupérez un Parchemin de rituel de lien d’esprit sur les Yaungols du Plateau du Parlemort.‡从死语者高地的野牛人那里收集缚魂仪式卷轴。‡',
  }
},
[31119] = {
  {
    'Inimigo do meu inimigo... também é meu inimigo!‡Враг моего врага... все равно мой враг!‡Der Feind meines Feindes... ist immer noch mein Feind!‡적의 적은... 그래도 적이다!‡El enemigo de mi enemigo... ¡sigue siendo mi enemigo!‡‡L’ennemi de mon ennemi… reste mon ennemi !‡我敌人的敌人……还是我的敌人！‡',
    nil,
    'Use Barris de Óleo Yaungol Extremamente Explosivo para matar 100 mantídeos ou yaungóis no Campo de Batalha de Gai-Cho. Uma‡С помощью взрывоопасных бочек с яунгольской нефтью убейте 100 богомолов или яунголов на поле битвы Гай-Чо.‡Benutzt hochexplosive Fässer voll Yaungolöl, um damit 100 Mantis oder Yaungol auf dem Schlachtfeld von Gai-Cho zu töten.‡폭발성 강한 야운골 기름통을 사용하여 가이초 전장에서 사마귀나 야운골 100명을 처치해야 합니다.‡Utiliza barriles de petróleo yaungol altamente explosivo para matar a 100 mántides o yaungol en el Frente Gai-Cho.‡‡Tuez 100 Mantides ou Yaungols à l’aide de Barils de naphte yaungols hautement explosifs sur le Champ de bataille de Gai Cho.‡在铠胄战线使用野牛人高爆油桶击败100个螳螂妖或野牛人。‡',
  }
},
[31120] = {
  {
    'Cheng Bo!‡Чэн Бо!‡Cheng Bo!‡쳉 보!‡¡Cheng Bo!‡‡Cheng Bo !‡成柏！‡',
    nil,
    'Mate Cheng-Bo na Guarnição Avançada Gai-Cho, que fica nas Estepes de Taolong. Uma‡Убейте Чэна Бо в огненном лагере Гай-Чо в Танлунских степях.‡Tötet Cheng Bo im Streitlager Gai-Cho in der Tonlongsteppe.‡탕랑 평원의 불의 야영지 가이초에서 쳉 보를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a Cheng-Bo en el Campamento Gai-Cho en las Estepas de Tong Long.‡‡Tuez Cheng Bo au Campement Gai-Cho, dans les Steppes de Tanglong.‡去螳螂高原的铠胄火营击败成柏。‡',
  }
},
[31121] = {
  {
    'Senta que lá vem história‡Постой и послушай‡Bleibt ein Weilchen und hört zu‡잠깐 내 이야기를 들어보겠나‡Quédate un rato y escucha‡‡Restez un instant, et écoutez-moi‡驻足聆听‡',
    nil,
    'Beba da Chaleira de Cho. Uma‡Выпейте чая из чайника Чо.‡Trinkt aus Chos Teekanne.‡초의 찻주전자에 담긴 차를 마셔야 합니다. 레벨 10 비취 숲‡Bebe de la tetera de Cho.‡‡Buvez du thé de la Théière de Cho.‡与周卓一起品茶。‡',
  }
},
[31122] = {
  {
    'Escolheu Guerreiro de Prot‡Chose Prot Warrior‡Wahl des Schutzkriegers‡방어 전사 선택‡Elige guerrero Protección‡‡Choisir le guerrier défensif‡选择防护战士‡',
    nil,
    'Uma‡‡‡레벨 1 탕랑 평원‡‡‡‡‡',
  }
},
[31123] = {
  {
    'Escolheu Guerreiro de Armas‡Chose Arms Warrior‡Wahl des Kriegers der Waffen‡무기 전사 선택‡Elige guerrero Armas‡‡Choisir le guerrier maître d’armes‡选择武器战士‡',
    nil,
    'Uma‡‡‡레벨 1 탕랑 평원‡‡‡‡‡',
  }
},
[31124] = {
  {
    'Escolheu Mestre Cervejeiro‡Chose Brewmaster‡Wahl des Braumeisters‡양조사 선택‡Elige maestro cervecero‡‡Choisir le maître brasseur‡选择酒仙‡',
    nil,
    'Uma‡‡‡레벨 1 탕랑 평원‡‡‡‡‡',
  }
},
[31125] = {
  {
    'Chao Destravado‡Unlocked Chao‡Chao freigeschaltet‡차오 나옴‡Chao desbloqueado‡‡Déblocage de Chao‡解锁查超‡',
    nil,
    'Uma‡‡‡레벨 1 탕랑 평원‡‡‡‡‡',
  }
},
[31126] = {
  {
    'Lao-Chen Destravado‡Unlocked Lao-Chen‡Lao-Chen freigeschaltet‡라오친 나옴‡Lao-Chen desbloqueado‡‡Déblocage de Lao Chin‡解锁老陈‡',
    nil,
    'Uma‡‡‡레벨 1 탕랑 평원‡‡‡‡‡',
  }
},
[31127] = {
  {
    'O Ringue do Desafiante: Chao, a Voz‡Бойцовский круг: Чао Голосистая‡Der Ring des Herausforderers: Chao die Stimme‡도전자의 대련장: 말하는 자 차오‡El Círculo del Contendiente: Chao la Voz‡‡L’Arène des combattants : Chao la Voix‡挑战者之环：魔音贯耳超风‡',
    nil,
    'Desafie Chao, a Voz, e derrote-a em combate na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Вызовите на бой в гарнизоне Шадо-Пан, что в Танлунских степях, Чао Голосистую и победите ее.‡Fordert Chao die Stimme heraus und besiegt sie anschließend im Kampf in der Shado-Pan-Garnison in der Tonlongsteppe.‡말하는 자 차오에게 도전해, 탕랑 평원의 음영파 주둔지에서 그를 꺾어야 합니다. 레벨 25 탕랑 평원‡Desafía a Chao la Voz y derrótala en combate en el Cuartel del Shadopan en las Estepas de Tong Long.‡‡Défiez et battez Chao la Voix à la Garnison des Pandashan, dans les Steppes de Tanglong.‡挑战魔音贯耳超风，然后在螳螂高原的影踪卫戍营中打败她。‡',
  }
},
[31128] = {
  {
    'O Ringue do Desafiante: Lao-Chin, o Barriga de Ferro‡Бойцовский круг: Лао-Чинь Стальное Брюхо‡Der Ring des Herausforderers: Lao-Chen der eiserne Bauch‡도전자의 대련장: 무쇠뱃살 라오친‡El Círculo del Contendiente: Lao-Chen Panza Férrea‡‡L’Arène des combattants : Lao Chin la Panse de Fer‡挑战者之环：铁腹老陈‡',
    nil,
    'Desafie Lao-Chin, o Pança de Ferro, e derrote-o em combate na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Вызовите на бой в гарнизоне Шадо-Пан, что в Танлунских степях, Лао-Чиня Стальное Брюхо и победите его.‡Fordert Lao-Chen den eisernen Bauch heraus und besiegt ihn anschließend im Kampf in der Shado-Pan-Garnison in der Tonlongsteppe.‡무쇠뱃살 라오친에게 도전해, 탕랑 평원의 음영파 주둔지에서 그를 꺾어야 합니다. 레벨 25 탕랑 평원‡Desafía a Lao-Chen Panza Férrea y derrótalo en combate en el Cuartel del Shadopan en las Estepas de Tong Long.‡‡Défiez et battez Lao Chin la Panse de Fer à la Garnison des Pandashan, dans les Steppes de Tanglong.‡挑战铁腹老陈，然后在螳螂高原的影踪卫戍营中打败他。‡',
  }
},
[31129] = {
  {
    'O destino dos Maltes do Trovão‡Судьба семейства Буйный Портер‡Das Schicksal der Sturmbräus‡스톰스타우트 가의 운명‡El destino de los Cerveza de Trueno‡‡Le destin des Brune d’Orage‡风暴烈酒的命运‡',
    nil,
    'Pergunte aos moradores do Parque Cervejeiro do Poente se eles viram algum Malte do Trovão. Uma‡Спросить у обитателей хмелеваренного дворика "На закате", не видели ли они Буйных Портеров.‡Fragt die Bewohner des Abendlichtbraugartens, ob sie Sturmbräus gesehen haben.‡일몰 양조정원의 거주자들에게 스톰스타우트 가문 사람을 본 적이 있는지 물어야 합니다. 레벨 30 공포의 황무지‡Pregunta a los habitantes del Jardín de la Cebada Crepuscular si han visto a algún Cerveza de Trueno.‡‡Demandez aux habitants du Chai du couchant s’ils ont vu des Brune d’Orage.‡向落日酒坊的居民询问风暴烈酒族人的下落。‡',
  }
},
[31130] = {
  {
    'Traz o príncipe amado em cinco dias‡Визит к хранителю истории Чо‡Ein Besuch bei Lehrensucher Cho‡전승지기와의 만남‡Una visita al eremita Cho‡‡La visite du chroniqueur Cho‡拜访游学者周卓‡',
    nil,
    'Faça amizade com o Andarilho das Lendas Cho ajudando-o com afazeres domésticos: pode a árvore, pinte a parede e alimente os pássaros. Um(a) missão.‡Подружитесь с хранителем истории Чо, оказав ему помощь по дому: подстригите дерево, покрасьте стену, накормите птиц.‡Freundet Euch mit Lehrensucher Cho an, indem Ihr ihm Aufgaben abnehmt: Stutzt seinen Baum, streicht seine Mauer und füttert seine Vögel.‡전승지기 초의 집안일을 도와주고 친구가 되어야 합니다. 나무를 손질하고, 벽을 칠하고, 새들에게 먹이를 줘야 합니다.‡Traba amistad con el eremita Cho ayudándolo en sus tareas de casa: poda el árbol, pinta la pared y da de comer a los pájaros.‡‡Montrez-vous aimable avec le Chroniqueur Cho en l’aidant à faire différentes tâches dans sa maison. Élaguez son arbre, peignez son mur, et nourrissez ses oiseaux.‡帮助游学者周卓收拾房间，跟他成为朋友：帮他修剪树木，粉刷墙壁，给他的小鸟喂食。‡',
  }
},
[31131] = {
  {
    'Lago Pétala Branca‡Озеро Белых Лепестков‡Weißblütensee‡흰꽃잎 호수‡Lago Pétalo Níveo‡‡Lac Blanc-Pétale‡琼花湖‡',
    nil,
    'Fale com He Pés Leves no Lago Pétala Branca. Uma‡Поговорите с Хэ Легкой Ногой у Озера Белых Лепестков.‡Sprecht mit Hee Samtfuß am Weißblütensee.‡흰꽃잎 호수에 있는 허 소프트풋과 대화해야 합니다. 레벨 30 영원꽃 골짜기‡Habla con Zheng Paso Cauto en el Lago Pétalo Níveo.‡‡Parlez à He Pas de Loup au lac Blanc-Pétale.‡和琼花湖的禾·软足谈一谈。‡',
  }
},
[31132] = {
  {
    'Falar de mim é fácil‡Попробуй побыть мной‡In meine Situation versetzen‡시작은 내 얘기로‡Un kilómetro en mis zapatos‡‡Mettez-vous une seconde à ma place‡设身处地‡',
    nil,
    'Fale com o Andarilho das Lendas Cho no Círculo de Osso. Uma‡Поговорите с хранителем истории Чо у Круга Кости.‡Sprecht mit Lehrensucher Cho am Ring der Knochen.‡뼈의 원에 있는 전승지기 초와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el eremita Cho en el Círculo de Huesos.‡‡Parlez au Chroniqueur Cho au Cercle d’os.‡和骨之环的游学者周卓谈一谈。‡',
  }
},
[31133] = {
  {
    'Agressão dos Kor\'thik‡Агрессия кор\'тик‡Aggressive Kor\'thik‡코르티크의 공격‡La agresión de Kor\'thik‡‡Attaque kor’thik‡库尔提克的侵袭‡',
    nil,
    'Mate 17 Mantídeos Kor\'thik em Kor\'vess. Uma‡Уничтожьте 17 богомолов-кор\'тиков в Кор\'вессе.‡Tötet 17 Kor\'thik-Mantis in Kor\'vess.‡코르베스에 있는 코르티크 사마귀 17마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 17 mántides Kor\'thik en Kor\'vess.‡‡Tuez 17 Mantides kor’thik à Kor’vess.‡在库尔维斯杀死17只库尔提克螳螂妖。‡',
  }
},
[31134] = {
  {
    'Se essas pedras falassem‡Если бы камни могли говорить‡Wenn diese Steine sprechen könnten‡이 돌이 말을 할 수 있다면‡Si estas piedras hablaran‡‡Si ces pierres pouvaient parler‡顽石开口‡',
    nil,
    'Use os Monolitos de Pedra no Círculo de Osso. Uma‡Используйте каменные монолиты в Круге Кости.‡Nutzt die Steinmonolithen am Ring der Knochen.‡뼈의 원에서 비석을 사용해야 합니다. 레벨 10 비취 숲‡Usa los monolitos de piedra en el Círculo de Huesos.‡‡Utilisez les Monolithes de pierre au Cercle d’os.‡在骨之环使用巨石。‡',
  }
},
[31135] = {
  {
    'O futuro de Gnomeregan‡Будущее Гномрегана‡Die Zukunft von Gnomeregan‡놈리건의 미래‡El futuro de Gnomeregan‡‡L’avenir de Gnomeregan‡诺莫瑞根的未来‡',
    nil,
    'Encontre Xi, Amiga dos Pequenos, na Vila da Gambiarra. Uma‡Поговорите с Си Другом Низкорослых в Новом Городе Механиков.‡Trefft Euch mit Xi, Freundin der Winzlinge, in Neu-Tüftlerstadt.‡신 땜장이 마을에 있는 작은 이들의 친구 시를 만나야 합니다. 레벨 1 신 땜장이 마을‡Reúnete con Xi, Amiga de los Pequeños, en Nueva Ciudad Manitas.‡‡Allez voir Xi, l’Amie des tout-petits à la Nouvelle-Brikabrok.‡到新工匠镇去找侏儒之友西希。‡',
  }
},
[31136] = {
  {
    'Atrás das nossas linhas‡За линией обороны‡Hinter den eigenen Linien‡‡Detrás de nuestras líneas‡‡Derrière nos lignes‡‡',
    nil,
    'Mate o General Temuja. Uma‡Убейте Генерала Темуджа.‡Tötet General Temuja.‡‡Mata al general Temuja.‡‡Tuez le Général Temuja.‡‡',
  }
},
[31137] = {
  {
    'Conheça o Grão-faz-tudo‡Встретиться с главным механиком‡Der Hochtüftler‡땜장이왕 멕카토크와의 만남‡Conocer al manitas mayor‡‡Rencontrez le Grand Bricoleur‡晋见大工匠‡',
    nil,
    'Apresente-se ao Grão-faz-tudo Mekkatorque na Vila da Gambiarra. Uma‡Представьтесь главному механику Меггакруту в Новом Городе Механиков.‡Stellt Euch bei Hochtüftler Mekkadrill in Neu-Tüftlerstadt vor.‡신 땜장이 마을에 있는 땜장이왕 멕카토크를 만나야 합니다. 레벨 1 신 땜장이 마을‡Preséntate al manitas mayor Mekkatorque en Nueva Ciudad Manitas.‡‡Présentez-vous au Grand Bricoleur Mekkanivelle, à La Nouvelle-Brikabrok.‡在新工匠镇里，向大工匠梅卡托克进行自我介绍。‡',
  }
},
[31138] = {
  {
    'A arte do monge‡Искусство монаха‡Die Künste eines Mönchs‡수도사의 기술‡Las artes del monje‡‡La voie du moine‡武僧之道‡',
    nil,
    'Chegue ao nível 3 para aprender Palma do Tigre. Após aprender o feitiço, use-o duas vezes em um Boneco de Treinamento na Vila da Gambiarra.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Выучив, дважды примените его на тренировочном манекене в Новом Городе Механиков.‡Ihr müsst Stufe 3 erreichen, um Tigerklaue zu erlernen. Wenn Ihr sie gelernt habt, wendet sie zweimal auf eine Trainingsattrappe in Neu-Tüftlerstadt an.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 신 땜장이 마을에 있는 훈련용 허수아비에 범의 장풍을 2번 사용해야 합니다.‡Aprende Palma del tigre en el nivel 3. Cuando lo hayas aprendido, utilízalo dos veces sobre un muñeco de entrenamiento en Nueva Ciudad Manitas.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre. Quand vous l’aurez apprise, utilisez-la deux fois sur un Mannequin d’entraînement à la Nouvelle-Brikabrok.‡将等级提升至3级后学习猛虎掌。学成之后，在新工匠镇的训练假人身上使用两次。‡',
  }
},
[31139] = {
  {
    'É hora de reagir‡Дать отпор!‡Schlagt sie zurück!‡격퇴!‡¡Rechazar el ataque!‡‡Repoussez-les !‡击退敌人！‡',
    nil,
    'Mate 6 Worgs Rocha Negra. Uma‡Убейте 6 воргов клана Черной горы.‡Tötet 6 Worgs des Schwarzfels.‡검은바위 검은늑대 6마리를 처치해야 합니다. 레벨 1 북녘골‡Mata a 6 huargos Roca Negra.‡‡Tuez 6 Worgs rochenoires.‡杀死6只黑石战狼。‡',
  }
},
[31140] = {
  {
    'Leões e cordeiros‡Волки и овцы‡Worgs im Schafspelz‡영리한 오크 첩자들‡Leones por corderos‡‡Le lion et l\'agneau‡狮入羊口‡',
    nil,
    'Mate 8 Espiões Rocha Negra. Uma‡Убейте 8 шпионов из клана Черной горы.‡Tötet 8 Spione der Schwarzfelsorcs.‡검은바위 첩보원 8명을 처치해야 합니다. 레벨 1 북녘골‡Mata a 8 espías Roca Negra.‡‡Tuez 8 Espions rochenoires.‡消灭8名黑石间谍。‡',
  }
},
[31141] = {
  {
    'Carta caligrafada‡Каллиграфическое письмо‡Kalligrafiebrief‡붓글씨로 쓴 편지‡Una carta caligrafiada‡‡Lettre calligraphiée‡手写书信‡',
    nil,
    'Leia a Carta Caligrafada e fale com Bao na Abadia de Vila Norte.‡Прочитайте каллиграфическое письмо и поговорите с Бао в Аббатстве Североземья.‡Lest den Kalligrafiebrief und sprecht mit Bao in der Abtei von Nordhain.‡붓글씨로 쓴 편지를 읽고 북녘골 수도원에 있는 바오와 대화해야 합니다.‡Lee la carta caligrafiada y habla con Bao en la Abadía de Villanorte.‡‡Lisez la lettre calligraphiée et parlez à Bao, à l’Abbaye de Comté-du-Nord.‡阅读手写书信，然后和北郡修道院的阿宝谈一谈。‡',
  }
},
[31142] = {
  {
    'Palma do tigre‡Лапа тигра‡Tigerklaue‡범의 장풍‡Palma del tigre‡‡Paume du tigre‡猛虎之掌‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Depois, pratique-a em um Boneco de Treinamento ao sul da entrada da Abadia de Vila Norte.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра", затем опробуйте этот прием на тренировочном манекене, расположенном к югу от входа в аббатство Североземья.‡Erreicht Stufe 3, um \'Tigerklaue\' zu erlernen. Dann übt die Anwendung von \'Tigerklaue\' an einer Trainingsattrappe südlich des Eingangs zur Abtei von Nordhain.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 북녘골 수도원 입구 남쪽에 있는 훈련용 허수아비에 범의 장풍을 사용해야 합니다.‡Alcanza el nivel 3 para aprender Palma del tigre, y practícala con un muñeco de entrenamiento al sur de la entrada de la Abadía de Villanorte.‡‡Atteignez le Niveau 3 pour apprendre la Paume du tigre, puis utilisez cette compétence sur un Mannequin d’entraînement, au sud de l’entrée de l’Abbaye de Comté-du-Nord.‡将等级提升至3级后学习“猛虎掌”，然后在北郡修道院入口南面的训练假人身上进行练习。‡',
  }
},
[31143] = {
  {
    'Vila Norte precisa de você‡В бой!‡Stürzt Euch in die Schlacht!‡전투에 참전하라!‡¡Únete a la batalla!‡‡Rejoignez la bataille !‡加入战斗！‡',
    nil,
    'Fale novamente com o Sargento Vilém atrás da Abadia de Vila Norte, que fica na Floresta de Elwynn. Uma‡Поговорите с сержантом Виллемом за аббатством Североземья, что в Элвиннском лесу.‡Meldet Euch bei Unteroffizier Willem hinter der Abtei von Nordhain im Wald von Elwynn.‡엘윈 숲의 북녘골 수도원 뒤편에 있는 하사관 윌렘에게 보고해야 합니다. 레벨 1 북녘골‡Preséntate ante el sargento Willem detrás de la Abadía de Villanorte, en el Bosque de Elwynn.‡‡Présentez-vous au Sergent Willem derrière l\'Abbaye de Comté-du-Nord, dans la Forêt d\'Elwynn.‡向艾尔文森林北郡修道院后的维里副队长报到。‡',
  }
},
[31144] = {
  {
    'Assassinos de aluguel‡Враг подослал наемных убийц‡Sie haben Auftragsmörder losgeschickt‡저들이 보낸 암살자들‡Enviaron asesinos‡‡Ils ont envoyé des assassins‡他们派来了刺客‡',
    nil,
    'Mate 8 Goblins Assassinos. Uma‡Прикончите 8 гоблинов-убийц.‡Tötet 8 goblinische Auftragsmörder.‡고블린 암살자 8명을 처치해야 합니다. 레벨 1 북녘골‡Mata a 8 asesinos goblins.‡‡Tuez 8 Assassins gobelins.‡杀死8名地精刺客。‡',
  }
},
[31145] = {
  {
    'A retaguarda está livre‡Тыл зачищен‡Gefahr gebannt‡후방 정리 완료‡Retaguardia despejada‡‡La zone est dégagée‡后方已经安全‡',
    nil,
    'Apresente-se ao Major Belmonte na Abadia de Vila Norte, que fica na Floresta de Elwynn. Uma‡Поговорите с маршалом Макбрайдом перед аббатством Североземья, что в Элвиннском лесу.‡Meldet Euch bei Marschall McBride vor der Abtei von Nordhain im Wald von Elwynn.‡엘윈 숲의 북녘골 수도원에 있는 치안대장 맥브라이드에게 보고해야 합니다. 레벨 1 북녘골‡Preséntate ante el alguacil McBride frente a la Abadía de Villanorte, en el Bosque de Elwynn.‡‡Présentez-vous au Maréchal McBride devant l\'Abbaye de Comté-du-Nord, dans la Forêt d\'Elwynn.‡向艾尔文森林北郡修道院前的治安官玛克布莱德报到。‡',
  }
},
[31146] = {
  {
    'Pergaminho rabiscado‡Простой свиток‡Bekritzelte Schriftrolle‡기품있게 쓴 두루마리‡Pergamino simple‡‡Un parchemin gribouillé‡潦草的卷轴‡',
    nil,
    'Leia o Pergaminho Elegante e fale com Ting, a de Estômago Forte, em Plangemortis.‡Прочтите изящный свиток и поговорите с Тин Крепкий Желудок в Похоронном Звоне.‡Lest die elegante Schriftrolle und sprecht mit Ting der Bauchstarken in Todesend.‡기품있게 쓴 두루마리를 읽고 죽음의 종소리 마을에 있는 비위가 좋은 팅과 대화해야 합니다.‡Lee el pergamino elegante y habla con Ting Vientre Firme.‡‡Lisez le Parchemin élégant et parlez à Ting le Ventre gaillard au Glas.‡阅读精致的卷轴，然后和丧钟镇的铁胆海胃丁绿衫谈一谈。‡',
  }
},
[31147] = {
  {
    'Palma do Tigre‡Лапа тигра‡Tigerklaue‡범의 장풍‡Palma del tigre‡‡Paume du tigre‡猛虎掌‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Depois, pratique-a em um Boneco de Treinamento.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра", затем испытайте его на тренировочном манекене.‡Erreicht Stufe 3, um \'Tigerklaue\' zu erlernen und übt die Fähigkeit an einer Trainingsattrappe.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 훈련용 허수아비에 범의 장풍을 사용해야 합니다.‡Alcanza el nivel 3 para aprender Palma del tigre, y después practícala con un muñeco de entrenamiento.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre, puis travaillez cette technique sur un Mannequin d’entraînement.‡等级提升至3级后学习猛虎掌，然后在训练假人身上练习运用掌法。‡',
  }
},
[31148] = {
  {
    'Noviça Elvira‡Новобранец Элрет‡Novizin Elreth‡‡La novicia Elreth‡‡La novice Elreth‡‡',
    nil,
    'Fale com a Noviça Elvira em Plangemortis, que fica nas Clareiras de Tirisfal. Uma‡Поговорите с новобранцем Элрет в Похоронном Звоне, что в Тирисфальских лесах.‡Sprecht mit Novizin Elreth in Todesend in Tirisfal.‡‡Habla con la novicia Elreth en Camposanto, en los Claros de Tirisfal.‡‡Parlez à la novice Elreth au Glas, dans les Clairières de Tirisfal.‡‡',
  }
},
[31150] = {
  {
    'Runa Elegante‡Изящная руна‡Elegante Rune‡기품있는 룬‡Runa elegante‡‡Rune élégante‡‡',
    nil,
    'Leia a Runa Elegante e fale com Lo no Vale Cristálgida. Uma‡Изучите изящную руну и поговорите с Ло в Холодной долине. это‡Lest die elegante Rune und sprecht mit Lo im Eisklammtal.‡기품있는 룬을 읽어보고 눈마루 골짜기에 있는 로와 대화해야 합니다. 레벨 5‡Lee la runa elegante, luego ve al Valle de Crestanevada y habla con Lo.‡‡Lisez la Rune élégante et parlez à Lo, dans la Vallée des Frigères.‡‡',
  }
},
[31151] = {
  {
    'Chute, soco... tudo está no poder da mente‡Бей, снова бей, разум всего сильней!‡Treten & Schlagen - nur eine Frage der Konzentration‡발차기, 지르기, 모두 마음에 달렸다‡Patadas, puñetazos… Todo está en la mente‡‡Coup de pied, coup de poing, tout est dans le mental‡‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Depois, use-a em um dos Bonecos de Treinamento que ficam do lado de fora de Sidermar.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра", а затем испытайте этот прием на одном из тренировочных манекенов рядом с входом в Старую Наковальню.‡Erreicht Stufe 3, um die Technik Tigerklaue zu erlernen und übt dann diese Fähigkeit an einer der Trainingsattrappen vor dem Eingang nach Ambossar.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 앤빌마 입구 바깥의 훈련용 허수아비에 범의 장풍을 사용해야 합니다.‡Alcanza el nivel 3, aprende Palma del tigre y utilízala contra los muñecos de entrenamiento a la entrada de Yunquemar.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre, puis utilisez le sort sur un Mannequin d’entraînement aux portes de Courbenclume.‡‡',
  }
},
[31152] = {
  {
    'Em algum lugar do passado‡Взгляд в прошлое‡Ein Blick in die Vergangenheit‡과거 엿보기‡Removiendo el pasado‡‡Retour vers le passé‡窥探过去‡',
    nil,
    'Fale com Andarilho das Lendas Cho no Círculo de Pedra. Uma‡Поговорите с хранителем истории Чо у Круга Камня.‡Sprecht mit Lehrensucher Cho am Ring der Steine.‡바위의 원에 있는 전승지기 초와 대화해야 합니다. 레벨 10 비취 숲‡Habla con el eremita Cho en el Círculo de Piedras.‡‡Parlez au Chroniqueur Cho au Cercle de pierre.‡和石之环的游学者周卓谈一谈。‡',
  }
},
[31153] = {
  {
    'Tracking Event: Kite 2 Unlocked‡Tracking Event: Kite 2 Unlocked‡Verfolgungsereignis: 2. Papierdrachen freigeschaltet‡이벤트 추적: 다이애니 구출‡Tracking Event: Cometa 2 desbloqueada‡‡Tracking Event: Kite 2 Unlocked‡Tracking Event - Saved Diaani‡',
    nil,
    'Vale dos Quatro Ventos de‡‡‡네 바람의 계곡‡‡‡‡‡',
  }
},
[31154] = {
  {
    'Tracking Event: Kite 3 Unlocked‡Tracking Event: Kite 3 Unlocked‡Verfolgungsereignis: 3. Papierdrachen freigeschaltet‡이벤트 추적: 주울로 구출‡Tracking Event: Cometa 3 desbloqueada‡‡Tracking Event: Kite 3 Unlocked‡Tracking Event - Saved Zuulo‡',
    nil,
    'Vale dos Quatro Ventos de‡‡‡네 바람의 계곡‡‡‡‡‡',
  }
},
[31155] = {
  {
    'Tracking Event: Kite 4 Unlocked‡Tracking Event: Kite 4 Unlocked‡Verfolgungsereignis: 4. Drachen freigeschaltet‡이벤트 추적: 아레크 구출‡Tracking Event: Cometa 4 desbloqueada‡‡Tracking Event: Kite 4 Unlocked‡Tracking Event - Saved Arekk‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31156] = {
  {
    'Pergaminho caligrafado‡Покрытый письменами пергамент‡Kalligrafiepergament‡붓글씨로 쓴 양피지‡Papiro caligrafiado‡‡Parchemin calligraphié‡智者的来信‡',
    nil,
    'Leia o Pergaminho Caligrafado e fale com Gato no Vale das Provações.‡Прочтите покрытый письменами пергамент и поговорите с Гато в Долине Испытаний.‡Lest das Kalligrafiepergament und sprecht mit Gato im Tal der Prüfungen.‡붓글씨로 쓴 양피지를 읽고 시험의 골짜기에 있는 가토와 대화해야 합니다.‡Lee el papiro glífico y habla con Gato en el Valle de los Retos.‡‡Lisez le Parchemin calligraphié, puis parlez à Gato dans la Vallée des Épreuves.‡阅读手写羊皮纸，然后和试炼谷的贾徒谈一谈。‡',
  }
},
[31157] = {
  {
    'Palma do Tigre‡Лапа тигра‡Tigerklaue‡범의 장풍‡Palma del tigre‡‡Paume du tigre‡猛虎掌‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Encontre um Boneco de Treinamento e pratique 2 vezes.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Найдите тренировочный манекен и два раза опробуйте на нем "Лапу тигра".‡Erreicht Stufe 3, um \'Tigerklaue\' zu erlernen. Findet eine Trainingsattrappe und übt daran 2-mal die Anwendung von \'Tigerklaue\'.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 훈련용 허수아비를 찾아서 범의 장풍을 2번 사용해야 합니다.‡Alcanza el nivel 3 para aprender Palma del tigre. Localiza un muñeco de entrenamiento y practica utilizando Palma del tigre 2 veces.‡‡Atteignez le Niveau 3 pour apprendre la Paume du tigre. Lancez ensuite la Paume du tigre à 2 reprises sur un Mannequin d’entraînement.‡将等级提升至3级后学习猛虎掌。选定一个训练假人，然后对其使用2次猛虎掌。‡',
  }
},
[31158] = {
  {
    'O básico: como bater nas coisas‡Азы мастерства: поражение цели‡Die Grundlagen: Dinge schlagen‡기본기: 연타‡A golpe de entrenamiento‡‡La base : savoir frapper des trucs‡基础教程：攻击目标‡',
    nil,
    'Destrua 6 Alvos Carrancas. Uma‡Уничтожьте 6 манекенов-тики.‡Zerstört 6 Tikiziele.‡티키 표적 6개를 파괴해야 합니다. 레벨 1 메아리 섬‡Destruye 6 dianas tiki.‡‡Détruire 6 Cibles tiki.‡摧毁6个蒂基面具假人。‡',
  }
},
[31159] = {
  {
    'O levante dos Lançanegra‡Возрождение Черного Копья‡Aufstieg der Dunkelspeere‡검은창 부족의 봉기‡El levantamiento de los Lanza Negra‡‡L\'ascension des Sombrelances‡暗矛的崛起‡',
    nil,
    'Fale com Zabrax no Campo de Treinamento Lançanegra. Uma‡Встретьтесь с Забраксом на тренировочной площадке Черного Копья.‡Trefft Zabrax auf dem Ausbildungsgelände der Dunkelspeere.‡검은창 훈련장에 있는 자브락스를 만나야 합니다. 레벨 1 메아리 섬‡Reúnete con Zabrax en el Campo de Entrenamiento Lanza Negra.‡‡Allez voir Zabrax sur le Terrain d’entraînement des Sombrelances.‡和暗矛训练场的扎布拉克斯碰面。‡',
  }
},
[31160] = {
  {
    'O começo sempre é difícil‡Практическое занятие‡Aller Anfang ist schwer‡간단한 연습‡Un duro comienzo‡‡Un début difficile‡粗暴的开始‡',
    nil,
    'Consiga 6 Pelagens de Gato Juba Agreste. Uma‡Добудьте 6 шкур буйногривой рыси.‡Sammelt 6 Felle einer Wildmähnenkatze.‡거친갈기표범 모피 6개를 구해야 합니다. 레벨 1 메아리 섬‡Consigue 6 pelajes de gato Ferocrín.‡‡Récupérez 6 Peaux de félins crin-sauvage.‡收集6块蛮鬃豹皮。‡',
  }
},
[31161] = {
  {
    'Fosso da prova‡Яма испытаний‡Grube der Bewährung‡시험의 구덩이‡Foso de pruebas‡‡La fosse de l\'épreuve‡试炼场‡',
    nil,
    'Fale com o Carcereiro Lançanegra, depois entre no fosso da prova e mate um Batedor Escamas Odiosas Cativo. Uma‡Поговорите с тюремщиком Черного Копья, а затем спуститесь в яму испытаний и убейте пленного разведчика из клана Злобной Чешуи.‡Redet mit einem Gefängnisaufseher der Dunkelspeere, betretet dann die Grube der Bewährung und besiegt einen gefangenen Späher der Gallschuppen.‡검은창 교도관과 대화한 다음, 시험의 구덩이로 들어가 사로잡힌 원한비늘 정찰병을 처치해야 합니다.‡Habla con un carcelero Lanza Negra; después entra en el foso de pruebas y mata a un explorador Escama Maliciosa cautivo.‡‡Parlez à un Geôlier sombrelance, puis descendez dans la fosse de l\'épreuve et tuez un Éclaireur Vexécaille captif.‡同暗矛狱卒交谈，然后进入试炼场，杀死一名恶鳞斥候俘虏。‡',
  }
},
[31162] = {
  {
    'A arte do monge‡Искусство монаха‡Die Künste eines Mönchs‡수도사의 기술‡Las artes del monje‡‡La voie du moine‡武僧之道‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Então, pratique essa habilidade contra um Alvo Carranca. Uma‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Потренируйтесь в использовании этого приема на манекене-тики.‡Ihr müsst Stufe 3 erreichen, um Tigerklaue zu erlernen. Übt, indem Ihr die Tigerklaue gegen ein Tikiziel einsetzt.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 검은창 훈련장에 있는 티키 표적에 범의 장풍을 사용해야 합니다.‡Alcanza el nivel 3 para aprender Palma del tigre. Practica Palma del tigre contra una diana Tiki.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre. Entraînez-vous à utiliser la Paume du tigre contre une Cible tiki.‡将等级提升至3级后学习猛虎掌。在那些蒂基面具假人身上练习一下猛虎掌。‡',
  }
},
[31163] = {
  {
    'Melhor do que o esperado‡Превосходя ожидания‡Mehr als erwartet‡기대 이상‡Mejor de lo esperado‡‡Mieux que prévu‡喜出望外‡',
    nil,
    'Apresente-se a Vol\'jin na Cidadela dos Lançanegra. Uma‡Поговорите с Вол\'джином в крепости Черного Копья.‡Meldet Euch bei Vol\'jin in der Dunkelspeerfeste.‡검은창 요새에 있는 볼진에게 보고해야 합니다. 레벨 1 메아리 섬‡Preséntate ante Vol\'jin en el Bastión Lanza Negra.‡‡Présentez-vous à Vol\'jin au Bastion des Sombrelances.‡向暗矛要塞中的沃金报到。‡',
  }
},
[31165] = {
  {
    'Bilhete caligrafado‡Каллиграфическая записка‡Kalligrafienotiz‡붓글씨로 쓴 글쪽지‡Nota caligrafiada‡‡Note calligraphiée‡‡',
    nil,
    'Leia o Bilhete Caligrafado e fale com Shoyu na Aldeia Narache.‡Прочтите каллиграфическую записку и поговорите с Шоюем в Лагере Нараче.‡Lest die Kalligrafienotiz und sprecht mit Shoyu im Camp Narache.‡붓글씨로 쓴 글쪽지를 읽고 나라체 야영지에 있는 쇼위와 대화해야 합니다.‡Lee la nota caligrafiada y habla con Shoyu en el Campamento Narache.‡‡Lisez la Note calligraphiée, et parlez à Shoyu, au Camp Narache.‡‡',
  }
},
[31166] = {
  {
    'Palma do Tigre‡Лапа тигра‡Tigerklaue‡범의 장풍‡Palma del tigre‡‡Paume du tigre‡‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Encontre um Boneco de Treinamento na Aldeia Narache e pratique-a nele.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Найдите тренировочный манекен в Лагере Нараче и отработайте этот прием.‡Ihr müsst Stufe 3 erreichen, um Tigerklaue zu erlernen. Sucht eine Trainingsattrappe in Camp Narache und übt daran.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 나라체 야영지에 있는 훈련용 허수아비를 찾아 범의 장풍을 사용해야 합니다.‡Aprende Palma del tigre en el nivel 3. Busca un muñeco de entrenamiento en el campamento Narache y practica Palma del tigre.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre. Trouvez un Mannequin d’entraînement dans le Camp Narache et essayez cette technique.‡‡',
  }
},
[31167] = {
  {
    'Árvore genealógica‡Фамильное древо‡Stammbaum‡가계도‡Árbol genealógico‡‡Arbre généalogique‡族谱‡',
    nil,
    'Acenda o Maço de Incenso no Círculo de Pedra. Uma‡Зажгите связку благовоний в Круге Камня.‡Zündet das Räucherwerk am Ring der Steine an.‡바위의 원에서 향 묶음에 불을 붙여야 합니다. 레벨 10 비취 숲‡Enciende el fardo de incienso en el Círculo de Piedras.‡‡Allumez le Paquet d’encens au Cercle de pierre.‡点燃石之环的熏香束。‡',
  }
},
[31168] = {
  {
    'Signo caligrafado‡Покрытый письменами знак‡Kalligrafiesiegel‡붓글씨가 새겨진 도장‡Sigilo caligrafiado‡‡Cachet calligraphié‡手写魔符‡',
    nil,
    'Fale com Laoxi no interior Aldrassil, que fica em Umbravale. Uma‡Поговорите с Лаоси в Альдрассиле, что в Тенистой долине. это‡Sprecht mit Laoxi in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 라오시와 대화해야 합니다. 레벨 5‡Habla con Laoxi dentro de Aldrassil, en Cañada Umbría.‡‡Allez parler à Laoxi, à l’intérieur d’Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的劳希谈一谈。‡',
  }
},
[31169] = {
  {
    'A Arte do Monge‡Искусство монахов‡Die Kunst der Mönche‡수도사의 기술‡El arte del monje‡‡La voie du moine‡武僧之道‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Encontre um Boneco de Treinamento e pratique a habilidade.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Поищите тренировочный манекен и попрактикуйтесь в использовании этого приема на нем.‡Ihr müsst Stufe 3 erreichen, um Tigerklaue zu erlernen. Sucht nach einer Trainingsattrappe und übt daran die Anwendung von Tigerklaue.‡3 레벨에 도달하여 범의 장풍 기술을 습득해야 합니다. 그 후 가까이에 있는 훈련용 허수아비를 찾아 범의 장풍을 연습해야 합니다.‡Alcanza el nivel 3 para aprender Palma del tigre. Busca un muñeco de entrenamiento y practica utilizando Palma del tigre.‡‡Atteignez le Niveau 3 pour apprendre la Paume du tigre. Utilisez ensuite la Paume du tigre sur un Mannequin d’entraînement.‡将等级提升至3级后学习猛虎掌。找一个训练假人，在它身上练习使用猛虎掌。‡',
  }
},
[31170] = {
  {
    'Treinamento de monge‡Наставник монахов‡Ausbildung zum Mönch‡수도사 훈련‡Instrucción de monje‡‡La formation de moine‡‡',
    nil,
    'Fale com Pao, o instrutor de monges, na Torre do Sol, que fica na Ilha Andassol. Floresta do Canto Eterno de‡Поговорите с Пао, наставником монахов, в Солнечном Шпиле на Острове Солнечного Скитальца.‡Sprecht mit Pao - dem Mönchlehrer - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 수도사 파오와 대화해야 합니다. 영원노래 숲‡Habla con Pao, la instructora de monjes, en Aguja del Sol en Isla del Caminante del Sol.‡‡Parlez à Pao, le maître des moines, à la Flèche solaire sur l’Île de Haut-Soleil.‡‡',
  }
},
[31171] = {
  {
    'Palma do Tigre‡Лапа тигра‡Tigerklaue‡범의 장풍‡Palma del tigre‡‡Paume du tigre‡猛虎掌‡',
    nil,
    'Alcance o nível 3 para aprender Palma do Tigre. Encontre um Boneco de Treinamento no exterior da Torre do Sol e pratique-a nele.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Найдите тренировочный манекен рядом с Солнечным Шпилем и отработайте этот прием.‡Erreicht Stufe 3 und erlernt Tigerklaue. Findet eine Trainingsattrappe außerhalb des Sonnenturms und übt diese Fähigkeit.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 태양 첨탑 밖에 있는 훈련용 허수아비를 찾아 범의 장풍을 사용해야 합니다.‡Aprende Palma del tigre en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica con él.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre. Trouvez un Mannequin d’entraînement devant la Flèche solaire et pratiquez cette technique.‡将等级提升至3级后学习猛虎掌。在太阳之塔外面找一个训练假人，然后练习使用猛虎掌。‡',
  }
},
[31172] = {
  {
    'Treinamento de monge‡Наставник монахов‡Ausbildung zum Mönch‡‡Instrucción de monje‡‡La formation de moine‡‡',
    nil,
    'Uma‡это‡‡‡‡‡‡‡',
  }
},
[31173] = {
  {
    'A Palma do Tigre‡Лапа тигра‡Die Tigerklaue‡범의 장풍‡La Palma del tigre‡‡La Paume du tigre‡猛虎掌‡',
    nil,
    'Chegue ao nível 3 para aprender Palma do Tigre. Encontre um Boneco de Treinamento na área noroeste do Ponto de Impacto e pratique a técnica.‡Достигните 3-го уровня, чтобы изучить прием "Лапа тигра". Разыщите тренировочный манекен на северо-западной стороне места крушения и потренируйтесь на нем.‡Erreicht Stufe 3, um die Technik Tigerklaue zu erlernen. Sucht eine Trainingsattrappe an der nordwestlichen Seite der Absturzstelle und übt diese Fähigkeit.‡3 레벨에 도달하여 범의 장풍 기술을 습득하고, 추락 지점 북서쪽에 있는 훈련용 허수아비에 범의 장풍을 사용해야 합니다.‡Alcanza el nivel 3 para aprender Palma del tigre. Busca un muñeco de entrenamiento en el lado noroeste del Lugar del Accidente y practica utilizándola.‡‡Atteignez le niveau 3 pour apprendre la Paume du tigre. Trouvez un Mannequin d’entraînement au nord-ouest du Point d’impact puis entraînez-vous dessus.‡将等级提升至3级后学习猛虎掌。在坠毁点西北侧找一个训练假人，利用它进行练习。‡',
  }
},
[31174] = {
  {
    'O Pavoroso Vos‡Озеро Звезд‡Der Schreckensvos‡‡El Lago de los Astros‡‡Le Vor de l’Angoisse‡‡',
    nil,
    'Mate 12 Cava-âmbares Escravizados ou Batescravos Vos\'thik, e então liberte o paragão, Korven, o Escolado. Uma‡Убейте 12 порабощенных янтароискателей или вос\'тик-надсмотрщиков. Освободите Корвена Первейшего.‡Tötet 12 versklavte Berngräber oder Sklavenpeitscher der Vos\'thik und befreit den Getreuen Korven der Erste.‡‡Mata a 12 cavarresinas esclavizados o azotaesclavos Vos\'thik, y libera al dechado, Korven el Perfecto.‡‡Tuez 12 Mineurs d’ambre asservis ou Fouette-esclaves vos’thik, et libérez le parangon, Korven le Premier.‡‡',
  }
},
[31175] = {
  {
    'Skeer, o Sanguinário‡Скир Кровожадный‡Skeer der Blutsucher‡피 추적자 스키르‡Skeer el Cruento‡‡Skeer le Cherche-sang‡觅血者斯基尔‡',
    nil,
    'Acorde Skeer, o Sanguinário, na caverna embaixo d\'água. Uma‡Пробудите Скира Кровожадного в подводной пещере.‡Erweckt Skeer den Blutsucher in der Unterwasserhöhle.‡수중 동굴에서 피 추적자 스키르를 깨워야 합니다. 레벨 30 공포의 황무지‡Despierta a Skeer el Cruento en la cueva submarina.‡‡Réveillez Skeer le Cherche-sang dans la grotte sous-marine.‡在水下洞穴唤醒觅血者斯基尔。‡',
  }
},
[31176] = {
  {
    'Um estranho apetite‡Странный аппетит‡Merkwürdige Gelüste‡괴상한 입맛‡Un apetito extraño‡‡Un étrange appétit‡怪异的食欲‡',
    nil,
    'Pegue 12 Carnes de Estrela-do-mar. Uma‡Соберите 12 кусочков мяса морских звезд.‡Sammelt 12 Portionen Seesternfleisch.‡불가사리 살코기 12조각을 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 12 trozos de carne de estrella marina.‡‡Obtenez 12 morceaux de Viande d’étoile de mer.‡收集12份海星肉。‡',
  }
},
[31177] = {
  {
    'Jantar para um‡Хороший обед‡Schick essen‡맛있는 식사‡Una buena cena‡‡Un dîner parfait‡丰盛大餐‡',
    nil,
    'Colete 8 Rabos de Estalador. Uma‡Соберите 8 хвостов трещотов.‡Sammelt 8 Klackerschwänze.‡딸깍이 꼬리 8개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 8 colas de pinzador.‡‡Obtenez 8 Queues de claqueurs.‡收集8条龙虾尾。‡',
  }
},
[31178] = {
  {
    'Um sangrento deleite‡Кровавое удовольствие‡Ein blutiges Vergnügen‡피투성이의 즐거움‡Una delicia sangrienta‡‡Un délice sanglant‡以血为乐‡',
    nil,
    'Colete 100 Sangues Voláteis de Rêmoras Medonhas. Uma‡Соберите 100 капель неустойчивой крови ужасающих прилипал.‡Sammelt 100 Einheiten flüchtiges Blut von Schreckensschiffshaltern.‡무시무시한 빨판상어에서 피의 휘발물 100개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 100 unidades de sangre volátil de rémoras del temor.‡‡Prélevez 100 échantillons de Sang volatil sur des Rémoras de l’effroi.‡从恐惧鮣魚身上收集100份挥发性的血液。‡',
  }
},
[31179] = {
  {
    'O cheiro de sangue‡Запах крови‡Der Geruch des Blutes‡피의 향기‡El aroma de la sangre‡‡L’odeur du sang‡血之气息‡',
    nil,
    'Mate 12 Come-carnes Escamamuco e o Serpentus Escamamuco. Uma‡Убейте 12 поедаталей плоти и змейников из племени Грязной Чешуи.‡Tötet 12 Fleischfresser der Schlickschuppen und den Serpentus der Schlickschuppen.‡진흙비늘 식인투사와 진흙비늘 뱀투사 12마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 12 comecarnes Mugrescama y al dragón Mugrescama.‡‡Tuez 12 Dévoreurs Fangécaille et le Serpentus Fangécaille.‡击败12个泥鳞食肉者和泥鳞蛇面者。‡',
  }
},
[31181] = {
  {
    'Potes novos‡Свежие горшки‡Frische Körbe‡신선한 게통발‡Trampas frescas‡‡Pièges et maintenance‡新鲜的诱饵‡',
    nil,
    'Coloque iscas em 10 Armadilhas de Caranguejo Vazias na Enseada Solitária. É preciso colocar 2 Pedaços de Monarca dos Mares em cada armadilha.‡Разложите наживку в 10 пустых ловушек для крабов в Одинокой бухте. Для каждой ловушки требуется 2 куска мяса морского монарха.‡Bestückt 10 leere Krabbentöpfe in der Einsamen Bucht mit Ködern. Jeder Topf erfordert 2 Seemonarchenteile.‡쓸쓸한 만에 있는 빈 게통발 10개에 미끼를 채워 넣어야 합니다. 한 개의 빈 게통발에 미끼를 채워넣으려면 바다 제왕어 살덩이 2개가 필요합니다.‡Ceba 10 trampas para cangrejos vacías en la Cala Solitaria. Cada trampa necesita 2 pedazos de monarca del mar.‡‡Placez des appâts dans 10 Pots de crabe vides, à la Crique Inhabitée. Chaque pot nécessite 2 Morceaux de monarque marin.‡给荒寂海湾的10个空蟹笼添加诱饵。每个蟹笼需要2块海王鱼肉块。‡',
  }
},
[31182] = {
  {
    'Prós e lontras‡Кто выдрал наживку из горшка?‡Ihr wisst doch, Otter?‡수달, 이놈들!‡Nutrición‡‡Un appétit de loutre‡原来是水獭‡',
    nil,
    'Use o Saco de Mariscos para alimentar 8 Lontras Bigodes-gelados na Enseada Solitária. Uma‡Накормите из мешка с моллюсками 8 хладноусых выдр из Одинокой бухты.‡Benutzt den Beutel mit Muscheln, um 8 Kaltbartotter in der Einsamen Bucht zu füttern.‡쓸쓸한 만에서 조개 가방을 이용해 시린수염 수달 8마리에게 먹이를 주어야 합니다. 레벨 30 공포의 황무지‡Utiliza la bolsa de almejas para alimentar a 8 nutrias Bigofrío en la Cala Solitaria.‡‡Nourrissez 8 Loutres poil-froid de la Crique Inhabitée à l’aide du Sac de palourdes.‡用一袋蛤蜊喂食荒寂海湾的8只寒须水獭。‡',
  }
},
[31183] = {
  {
    'Conheça o capitão‡Встреча с капитаном‡Den Käpt\'n treffen‡선장과의 만남‡Conocer al capitán‡‡Rencontre avec le capitaine‡会见船长‡',
    nil,
    'Fale com Su-Dao "Molúria" no Gambito do Encharco. Uma‡Поговорите с "Мокрым" Су-Дао в Приюте капитана.‡Sprecht mit "Tropf" Su-Dao in Tropfs Wagnis.‡흠뻑이의 요행수에 있는 "흠뻑이" 쑤다오와 대화해야 합니다. 레벨 30 공포의 황무지‡Habla con "Aguado" Su-Tao en el Lance de Aguado.‡‡Parlez à « Trempette » Su Dao au Pari de Trempette.‡去闷水壶的冒险码头和“闷水壶”苏道谈一谈。‡',
  }
},
[31184] = {
  {
    'Velhice e velhacaria‡Старость и предательство‡Alter und Verrat‡예전의 배신‡Vejez y traición‡‡Grand âge et fourberie‡往事与背叛‡',
    nil,
    'Recupere a carta nos Destroços do Salta-névoa. Uma‡Отыщите договор фрахтования среди обломков "Туманного Кузнечика".‡Bergt die Charta vom Wrack der Nebelhüpfer.‡안개돌이호의 잔해에서 계약서를 되찾아야 합니다. 레벨 30 공포의 황무지‡Recupera el fletamento de los Restos de El Saltanieblas.‡‡Récupérez la Charte dans l’Épave du Fend-la-Brume.‡在雾海飞跃者的残骸中找到航海图。‡',
  }
},
[31185] = {
  {
    'Passeando com Cachorro‡Выгулять Пса‡Gassi mit Hund‡멍멍이와 산책‡Pasear al perro‡‡Promener Chien‡带狗狗散步‡',
    nil,
    'Leve Cachorro para passear pelos gêiseres quentes, o cadáver da baleia e o naufrágio do Salta-névoa na Croa de Mazu. Uma‡Прогуляйтесь вместе с псом к горячим гейзерам, трупу кита и обломкам "Туманного Кузнечика" на шельфе Мацзу.‡Nehmt Hund und stattet mit ihm den heißen Geysiren, dem toten Wal und dem Wrack der Nebelhüpfer auf dem Riff von Mazu einen Besuch ab.‡멍멍이를 데리고 마쭈의 대륙붕에 있는 뜨거운 온천, 고래 시체, 안개돌이호의 잔해에 가야 합니다.‡Lleva a Perro a visitar los géiseres calientes, el cadáver de ballena y los Restos de El Saltanieblas, en la Plataforma de Mazu. Un(a) misión.‡‡Emmenez Chien aux Geysers chauds, au Cadavre de baleine et à l’Épave du Fend-la-Brume, à la Saillie de Mazu.‡带狗狗游览玛祖海床上的间歇温泉，鲸鱼遗骸和雾海飞跃者的残骸。‡',
  }
},
[31186] = {
  {
    'Comida de Cachorro‡Накормить Пса‡Hundefutter‡멍멍이 식사‡Comida para perros‡‡« Pâtée » pour Chien‡狗狗的食物‡',
    nil,
    'Ajude Cachorro a comer os restos de 10 Batenazes Conchapedra. Uma‡Помогите Псу полакомиться останками 10 твердопанцирных клешнехватов.‡Helft Hund, die Reste von 10 Felspanzerschnappklauen zu essen.‡멍멍이가 집게발 바위껍질마크루라 10마리를 먹게 도와주어야 합니다. 레벨 30 공포의 황무지‡Ayuda a Perro a comerse los restos de 10 quebradores Concharroca.‡‡Aidez Chien à manger les restes de 10 Claque-pinces coqueroches.‡帮助狗狗吃掉10只石壳龙虾人。‡',
  }
},
[31187] = {
  {
    'Bem no caranguejo‡Крабы‡Krabbenfülle‡게다, 게‡¡Cangrejos!‡‡Sus aux crabes‡收获螃蟹‡',
    nil,
    'Prenda uma Boia do Salta-névoa a 8 Armadilhas de Caranguejo Cheias na Croa de Mazu. Uma‡Прицепите буй "Туманного Кузнечика" к 8 ловушкам с крабами на шельфе Мацзу. задание.‡Hängt eine Nebelhüpferboje an 8 volle Krabbenkörbe auf dem Riff von Mazu.‡마쭈의 대륙붕에서 꽉 찬 게통발 8개에 안개돌이호 부표를 연결해야 합니다. 레벨 30 공포의 황무지‡Engancha una boya de El Saltanieblas a 8 trampas para cangrejos llenas en la Plataforma de Mazu.‡‡Attachez une Bouée du Fend-la-Brume à 8 Pots de crabes pleins de la Saillie de Mazu.‡在玛祖海床上把雾海飞跃者浮标挂到8个装满的蟹笼上。‡',
  }
},
[31188] = {
  {
    'Semana do tubarão‡Неделя акулы‡Haiwoche‡상어 잡이 기간‡La semana del tiburón‡‡La semaine du requin‡鲨鱼周‡',
    nil,
    'Consiga 200 Dentes de Mangual arrancando-os das mandíbulas de Manguais Pinalonga na Croa de Mazu. Uma‡Соберите 200 зубов крепкозуба, выдирая их из челюстей длинноплавниковых крепкозубов на шельфе Мацзу.‡Sammelt 200 Drescherzähne, indem Ihr sie den Langflossendreschern auf dem Riff von Mazu zieht.‡마쭈의 대륙붕에 사는 긴지느러미 상어의 턱에서 상어 이빨 200개를 뽑아와야 합니다. 레벨 30 공포의 황무지‡Reúne 200 dientes de trillador sacándoselos de las mandíbulas a los trilladores Largaleta en la Plataforma de Mazu.‡‡Récupérez 200 Dents de batteur sur les mâchoires des Batteurs aileron-long de la Saillie de Mazu.‡前往玛祖海床并从长鳍长尾鲨嘴里拔出200枚长尾鲨利齿。‡',
  }
},
[31189] = {
  {
    'Carretel de emoções‡Ловля на живца‡Einholstrategie‡밀고 당기는 전략‡Estrategia en tiempo de pesca‡‡Pêche et stratégie‡提供协助‡',
    nil,
    'Ajude o Mestre Pescador Ju Lien em Gambito do Encharco. Uma‡Помогите мастеру-рыболову Цзюй Лэню, его можно найти в Приюте капитана. задание.‡Helft Meisterangler Ju Lien in Tropfs Wagnis.‡흠뻑이의 요행수에 있는 달인 강태공 주 리엔을 도와줘야 합니다. 레벨 30 공포의 황무지‡Ayuda al maestro pescador Ju Lien en Lance de Aguado.‡‡Aidez le Maître pêcheur Ju Lien au Pari de Trempette.‡前往闷水壶的冒险码头协助钓鱼大师句连。‡',
  }
},
[31190] = {
  {
    'A revanche do marinheiro‡Месть моряка‡Die Rache des Seemanns‡뱃사람의 복수‡La venganza del marinero‡‡La revanche du marin‡水手的复仇‡',
    nil,
    'Lance o Salta-névoa Jr. da doca em Gambito do Encharco e use-o para derrubar Jiao. Uma‡Спустите на воду "малого" "Туманного Кузнечика" на причале в Приюте капитана и уничтожьте Цзяо.‡Lasst die Nebelhüpfer Jr. am Dock in Tropfs Wagnis zu Wasser und benutzt sie, um Jiao zu erledigen.‡흠뻑이의 요행수에 있는 부두에서 안개돌이호 2세를 띄워 쟈오를 처치해야 합니다. 레벨 30 공포의 황무지‡Bota el Saltanieblas Jr. desde el Lance de Aguado y utilízalo para acabar con Jiao.‡‡Appareillez à bord du Fend-la-Brume II depuis le quai du Pari de Trempette et éliminez Jiao.‡前往闷水壶的冒险码头并启动雾海飞跃者二世，用它干掉狡。‡',
  }
},
[31194] = {
  {
    'Supressão dos escama-lisa‡Проблемы со Скользкой Чешуей‡Schlängelschuppen unterdrücken‡뱀비늘 제압‡Supresión Reptaescama‡‡Supprimer les Ondulécailles‡镇压滑鳞氏族‡',
    nil,
    'Mate o Senhor dos Lagartos Escama-lisa. Uma‡Убейте чешуйчатого повелителя из клана Скользкой Чешуи.‡Tötet den Echsenlord der Schlängelschuppen.‡뱀비늘 도마뱀군주를 처치해야 합니다. 레벨 10 비취 숲‡Mata al señor lagarto Reptaescama.‡‡Tuez le Seigneur-lézard ondulécaille.‡击败滑鳞蜥蜴领主。‡',
  }
},
[31195] = {
  {
    'Fedentino, o Fedorento‡Заукать дукера‡Den Knatzel gefiddelt‡응가쟁이 처치 완료‡Miko krakado‡‡Kaker le doukacque‡教训坏蛋‡',
    nil,
    'Uma‡это‡‡레벨 5‡‡‡‡‡',
  }
},
[31196] = {
  {
    'Matança em Sra\'vess‡Мокрое дело на Шра\'вессе‡Sra\'vess-Drecksarbeit‡스라베스에서 사냥‡Trabajo sucio en Sra\'vess‡‡Purge à Sra’vess‡瑟拉维斯的苦差事‡',
    nil,
    'Mate 15 mantídeos comuns perto de Sra\'vess. Uma‡Убейте 15 обычных богомолов около острова Шра\'весс.‡Tötet 15 der nicht zur Elite zählenden Mantis bei Sra\'vess.‡스라베스에서 정예가 아닌 사마귀 15마리를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 15 mántides que no sean élite cerca de Sra\'vess.‡‡Tuez 15 Mantides communs à proximité de Sra’vess.‡在瑟拉维斯附近杀掉15个非精英螳螂妖。‡',
  }
},
[31197] = {
  {
    'Quanto maior o mantídeo...‡Чем они больше...‡Immer auf die Großen‡덩칫값은 하네...‡Cuanto mayores son…‡‡Plus ils sont gros…‡大螳螂妖来了……‡',
    nil,
    'Mate quaisquer 4 mantídeos de elite em Sra\'vess. Uma‡Убейте 4 элитных богомолов на острове Шра\'весс.‡Tötet 4 Elitemantis auf Sra\'vess.‡스라베스에서 정예 사마귀 4마리를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata a 4 mántides de élite cualesquiera en Sra\'vess.‡‡Tuez 4 Mantides d’élite de votre choix à Sra’vess.‡杀掉瑟拉维斯的4个精英螳螂妖。‡',
  }
},
[31198] = {
  {
    'Vitória moral‡Моральная победа‡Ein Schlag für ihre Moral‡적의 사기를 꺾어라‡Una victoria moral‡‡La défaite, ça commence dans la tête‡打击士气‡',
    nil,
    'Destrua os Ídolos Meridional, Central, Oriental e Ocidental em Sra\'vess. Uma‡Уничтожьте южного, центрального, восточного и западного идолов на острове Шра\'весс.‡Zerstört den südlichen, mittleren, östlichen und westlichen Götzen auf Sra\'vess.‡스라베스에서 동쪽, 서쪽, 남쪽, 중앙에 있는 우상을 파괴해야 합니다. 레벨 25 탕랑 평원‡Destruye los ídolos del sur, centro, este y oeste en Sra\'vess.‡‡Détruisez les Idoles du sud, du centre, de l’est et de l’ouest à Sra’vess.‡在瑟拉维斯摧毁南部、中部、东部和西部邪神像。‡',
  }
},
[31199] = {
  {
    'Destrua as armas de cerco!‡Уничтожить осадные орудия!‡Zerstörung der Belagerungsgeschütze‡공성 무기를 파괴하라!‡¡Destruye las armas de asedio!‡‡Détruisez les armes de siège !‡摧毁攻城武器！‡',
    nil,
    'Destrua as quatro armas de cerco dos mantídeos em Sra\'vess, que fica nas Estepes de Taolong. Uma‡Уничтожьте четыре осадных орудия богомолов на острове Шра\'весс в Танлунских степях.‡Zerstört die vier Mantis-Belagerungswaffen auf Sra\'vess in der Tonlongsteppe.‡탕랑 평원의 스라베스에서 사마귀 공성 무기 4개를 파괴해야 합니다. 레벨 25 탕랑 평원‡Destruye las cuatro armas de asedio mántides en Sra\'vess, en las Estepas de Tong Long.‡‡Détruisez les quatre Armes de siège mantides de Sra’vess dans les Steppes de Tanglong.‡在螳螂高原的瑟拉维斯摧毁螳螂妖的4部攻城武器。‡',
  }
},
[31200] = {
  {
    'Fumigação‡Выкуривание‡Ausräucherung‡연기가 모락모락‡Fumigación‡‡Fumigation‡烟熏消毒‡',
    nil,
    'Plante Bombas de Gás Shado-Pan dentro das 5 estruturas alvejadas de Sra\'vess. Uma‡Установите газовые бомбы Шадо-Пан на 5 указанных объектах на Шра\'вессе.‡Platziert die Shado-Pan-Gasbomben an den 5 Zielgebäuden auf Sra\'vess.‡스라베스의 목표 구조물 5개에 음영파 가스탄을 설치해야 합니다. 레벨 25 탕랑 평원‡Coloca bombas de gas del Shadopan en los 5 edificios señalados de Sra\'vess.‡‡Posez des Bombes de gaz pandashan dans les 5 bâtiments cibles de Sra’vess.‡在瑟拉维斯的5座目标建筑中放置影踪派瓦斯弹。‡',
  }
},
[31201] = {
  {
    'Amigos, não comida!‡Друзья – не еда!‡Freunde sind kein Fressen!‡간식이 아니라 친구라고!‡¡Amigos, no comida!‡‡Ce sont nos hommes, pas de la nourriture !‡朋友，不是食物！‡',
    nil,
    'Resgate um Discípulo Shado-Pan em cada um dos fossos de alimentação: do Norte, Central e do Sul. Uma‡Спасите учеников Шадо-Пан из северной, центральной и южной кормовых ям куньчунов.‡Rettet jeweils einen Shado-Pan-Auszubildenden in der nördlichen, mittleren und südlichen Kunchongfütterungsgrube.‡쿤총 탐식의 구덩이 북쪽, 중앙, 남쪽에 있는 음영파 수련생을 구출해야 합니다. 레벨 25 탕랑 평원‡Rescata a un aprendiz del Shadopan en cada una de las fosas de alimentación de kunchong al norte, centro y sur.‡‡Allez secourir une Recrue pandashan dans chacune des fosses à kunchong au nord, au centre et au sud.‡救出北方、中央和南方恐虫饲料洞中的影踪派受训者。‡',
  }
},
[31203] = {
  {
    'Alvo de oportunidade: Senhor do Enxame Sra\'thik‡Попутная цель: шра\'тик – повелитель роя‡Günstige Gelegenheit: Schwarmfürst der Sra\'thik‡공격 목표: 스라티크 무리군주‡Objetivo: Señor de enjambre Sra\'thik‡‡Fenêtre d’opportunité : le seigneur de l’essaim sra’thik‡机会目标：瑟拉提克统群者‡',
    nil,
    'Mate o Senhor do Enxame Sra\'thik em Sra\'vess, que fica nas Estepes de Taolong. Uma‡Убейте шра\'тика – повелителя роя в Шра\'вессе, что в Танлунских степях.‡Tötet den Schwarmfürsten der Sra\'thik auf Sra\'vess in der Tonlongsteppe.‡탕랑 평원의 스라베스에서 스라티크 무리군주를 처치해야 합니다. 레벨 25 탕랑 평원‡Mata al señor de enjambre Sra\'thik en Sra\'vess, en las Estepas de Tong Long.‡‡Tuez le Seigneur de l’essaim sra’thik à Sra’vess dans les Steppes de Tanglong.‡在螳螂高原的瑟拉维斯击败瑟拉提克统群者。‡',
  }
},
[31204] = {
  {
    'Alvo de oportunidade: Senhor da Colmeia Sra\'thik‡Попутная цель: шра\'тик – повелитель улья‡Günstige Gelegenheit: Brutfürst der Sra\'thik‡공격 목표: 스라티크 둥지군주‡Objetivo: Señor de la colmena Sra\'thik‡‡Fenêtre d’opportunité : le seigneur de la ruche sra’thik‡机会目标：瑟拉提克领巢者‡',
    nil,
    'Derrote o Senhor da Colmeia Sra\'thik. Uma‡Убейте шра\'тика – повелителя улья.‡Tötet den Brutfürsten der Sra\'thik.‡스라티크 둥지군주를 처치해야 합니다. 레벨 25 탕랑 평원‡Derrota al señor de la colmena Sra\'thik.‡‡Tuez le Seigneur de la ruche sra’thik.‡击败瑟拉提克领巢者。‡',
  }
},
[31205] = {
  {
    'Missão de rastreamento do Andarilho das Lendas Cho marcada‡Lorewalker Cho Tracking Quest‡Verfolgungsquest: Lehrensucher Cho‡전승지기 초 추적 퀘스트‡Misión de seguimiento del eremita Cho‡‡Quête de suivi Chroniqueur Cho‡游学者周卓追踪任务‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31206] = {
  {
    'O Caldeirão da Carnificina: o briguento Olho de Sangue!‡Горнило Крови: боец из клана Кровавого Глаза!‡Der Schmelztiegel des Gemetzels: Haudrauf der Blutaugen!‡대학살의 도가니: 붉은눈 투사!‡El Crisol de Matanza: ¡el truhan Ojosangre!‡‡Le Creuset du carnage : le Cogneur œil-sanglant !‡杀戮熔炉竞技场：血眼斗士！‡',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente Hurp\'derp! Uma‡Выйдите на арену Горнила Крови и одержите победу над Хурп\'дерпом!‡Betretet die Arena im Schmelztiegel des Gemetzels und besiegt Strunz\'blunz!‡대학살의 도가니 투기장 안으로 들어가 허프더프를 제압하십시오! 레벨 30 황혼의 고원‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡‡Entrez dans l’arène du Creuset du carnage, et triomphez de Hurp\'derp !‡进入杀戮熔炉竞技场，击败胡尔德普！‡',
  }
},
[31207] = {
  {
    'A Arena da Aniquilação‡Арена Истребления‡Die Arena der Auslöschung‡파멸의 투기장‡La Arena de la Aniquilación‡‡L’arène de l’Annihilation‡破军比武场‡',
    nil,
    'Entre e conclua o cenário da Arena da Aniquilação. Depois, pegue sua recompensa com Wodin, o Serviçal Troll. Uma‡Выйдите на Арену Истребления и выполните все предложенные задания. Не забудьте забрать свою награду у тролля-прислужника Водина.‡Betretet und beendet das Szenario der Arena der Auslöschung. Holt Euch anschließend Eure Belohnung von Wodin, dem Trolldiener.‡파멸의 투기장에 들어가 결투를 마친 다음, 하수인 우딘에게서 보상을 받아야 합니다. 레벨 20 쿤라이 봉우리‡Entra y completa la gesta de la Arena de la Aniquilación. Después, recibe tu recompensa de manos de Wodin, el sirviente trol.‡‡Pénétrez dans l’Arène de l’Annihilation et terminez-en le scénario. Ensuite, allez chercher votre récompense auprès de Wodin le Serviteur-troll.‡进入破军比武场并完成比赛。然后向巨魔仆从伍迪索要奖金。‡',
  }
},
[31208] = {
  {
    'Intenção peçonhenta‡Ядовитый умысел‡Giftige Absichten‡독한 계획‡Intenciones venenosas‡‡Pensées empoisonnées‡邪恶意图‡',
    nil,
    'Obtenha 8 Aguilhões Peçonhentos. Uma‡Соберите 8 ядовитых жал.‡Sammelt 8 giftige Stacheln.‡맹독 침 8개를 구해야 합니다. 레벨 30 공포의 황무지‡Reúne 8 aguijones venenosos.‡‡Récupérez 8 Aiguillons venimeux.‡收集8个剧毒蛰针。‡',
  }
},
[31209] = {
  {
    'Asas sombrias, coisas sombrias‡Черные крылья, черные дела‡Finstere Schwinge, finstere Dinge‡검은 날개와 검은 의도‡Alas oscuras, cuestiones oscuras‡‡Les ailes du bénéfice‡黑色翅膀，黑暗谋划‡',
    nil,
    'Junte 150 Asas de Escaravelho. Uma‡Соберите 150 крыльев скарабея.‡Sammelt 150 Skarabäenflügel.‡딱정벌레 날개 150개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 150 alas de escarabajos.‡‡Récupérez 150 Ailes de scarabée.‡收集150个甲虫翅膀。‡',
  }
},
[31210] = {
  {
    'Uma sombra de medo‡Жуткоцвет‡Ein Schatten des Schreckens‡공포의 그늘‡Una sombra de terror‡‡Les fleurs de l’effroi‡恐惧之影‡',
    nil,
    'Colha 8 Sombras-do-medo. Uma‡Соберите 8 жуткоцветов.‡Sammelt 8 Angstschatten.‡공포그늘 8개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 8 sombrinas.‡‡Récupérez 8 Sombreffrois.‡收集8株恐惧之影。‡',
  }
},
[31211] = {
  {
    'A mente envenenada‡Отравленный разум‡Der vergiftete Geist‡독한 마음‡La mente envenenada‡‡L’Esprit empoisonné‡毒心者‡',
    nil,
    'Fale com Xaril, a Mente Envenenada. Mate 200 Mantídeos e 3 Kunchongs voando com ele. Uma‡Поговорите с Ксарилом Отравленный Разум. Убейте 200 богомолов и 3 кунчунов, пока летите вместе с ним.‡Sprecht mit Xaril dem vergifteten Geist. Tötet 200 Mantis und 3 Kunchong, während Ihr mit ihm fliegt.‡독한 마음의 자릴과 대화한 후 함께 비행하면서 사마귀 200마리와 쿤총 3마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Habla con Xaril, la Mente Envenenada. Mata a 200 mántides y 3 kunchong mientras vuelas con él.‡‡Parlez à Xaril l’Esprit empoisonné. Tuez 200 Mantides et 3 Kunchong en volant à ses côtés.‡和毒心者夏克里尔谈一谈。然后和他结伴飞行并杀死200只螳螂妖和3只恐虫。‡',
  }
},
[31212] = {
  {
    'MARCADOR - Tenwu Escolhido‡FLAG - Chose Tenwu‡FLAGGE - Tenwu gewählt‡플래그 - 텐우 선택‡FLAG - Chose Tenwu‡‡FLAG - Chose Tenwu‡旗帜——选择腾武‡',
    nil,
    'Estepes de Taolong de‡‡‡탕랑 평원‡‡‡‡‡',
  }
},
[31213] = {
  {
    'MARCADOR - Taoshi Escolhido‡FLAG - Chose Taoshi‡FLAGGE - Taoshi gewählt‡플래그 - 타오스 선택‡FLAG - Chose Taoshi‡‡FLAG - Chose Taoshi‡旗帜——选择陶矢‡',
    nil,
    'Estepes de Taolong de‡‡‡탕랑 평원‡‡‡‡‡',
  }
},
[31214] = {
  {
    'MARCADOR - Nurong Escolhido‡FLAG - Chose Nurong‡FLAGGE - Nurong gewählt‡플래그 - 누롱 선택‡FLAG - Chose Nurong‡‡FLAG - Chose Nurong‡旗帜——选择砮荣‡',
    nil,
    'Estepes de Taolong de‡‡‡탕랑 평원‡‡‡‡‡',
  }
},
[31216] = {
  {
    'Céus escuros‡Темные небеса‡Der Himmel verfinstert sich‡검은 하늘‡Cielos oscuros‡‡Un ciel ténébreux‡黑暗天空‡',
    nil,
    'Mate 200 Mantídeos e 3 Kunchongs ou Beemotes do Medo num voo com Xaril, a Mente Envenenada. Uma‡Убейте 200 богомолов и 3 кунчунов или ужасающих чудищ, пока вас несет по воздуху Ксарил Отравленный Разум.‡Tötet 200 Mantis und 3 Kunchong oder grauenhafte Ungetüme, während Ihr mit Xaril dem vergifteten Geist fliegt.‡독한 마음의 자릴과 함께 비행하면서 사마귀 200마리와, 쿤총 또는 공포의 거수 3마리를 처치해야 합니다.‡Mata a 200 mántides y 3 kunchong o behemoths aterradores mientras vuelas con Xaril, la Mente Envenenada.‡‡Tuez 200 Mantides et 3 Kunchong ou Béhémoths de l’effroi en volant avec Xaril l’Esprit empoisonné.‡和毒心者夏克里尔一起飞行时，杀死200只螳螂妖和3只恐虫或恐惧巨兽。‡',
  }
},
[31218] = {
  {
    'MARCADOR - Tenwu Liberado‡FLAG - Unlocked Tenwu‡FLAGGE - Tenwu freigespielt‡플래그 - 텐우 잠금 해제‡FLAG - Unlocked Tenwu‡‡FLAG - Unlocked Tenwu‡旗帜——解锁腾武‡',
    nil,
    'Estepes de Taolong de‡‡‡탕랑 평원‡‡‡‡‡',
  }
},
[31219] = {
  {
    'MARCADOR - Nurong Liberado‡FLAG - Unlocked Nurong‡FLAGGE - Nurong freigespielt‡플래그 - 누롱 잠금 해제‡FLAG - Unlocked Nurong‡‡FLAG - Unlocked Nurong‡旗帜——解锁砮荣‡',
    nil,
    'Estepes de Taolong de‡‡‡탕랑 평원‡‡‡‡‡',
  }
},
[31220] = {
  {
    'O Ringue do Desafiante: Mestre Falcoeiro Nurong‡Бойцовский круг: повелитель ястребов Нужун‡Der Ring des Herausforderers: Falkenmeister Nurong‡도전자의 대련장: 매사냥꾼 누롱‡El Círculo del Contendiente: maestro de halcones Nurong‡‡L’Arène des combattants : le maître des faucons Nurong‡挑战者之环：鹰眼大师砮荣‡',
    nil,
    'Desafie o Mestre Falcoeiro Nurong e derrote-o em combate na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Вызовите на бой в гарнизоне Шадо-Пан, что в Танлунских степях, повелителя ястребов Нужуна и победите его.‡Fordert Falkenmeister Nurong heraus und besiegt ihn im Kampf in der Shado-Pan-Garnison in der Tonlongsteppe.‡매사냥꾼 누롱에게 도전해 탕랑 평원의 음영파 주둔지에서 그를 꺾어야 합니다. 레벨 25 탕랑 평원‡Desafía al maestro de halcones Nurong y derrótalo en combate en el Cuartel del Shadopan, en las Estepas de Tong Long.‡‡Défiez le Maître des faucons Nurong à la Garnison des Pandashan, dans les Steppes de Tanglong et triomphez de lui.‡在螳螂高原的影踪卫戍营中向鹰眼大师砮荣发起挑战并打败他。‡',
  }
},
[31221] = {
  {
    'O Ringue do Desafiante: Tenwu da Fumaça Vermelha‡Бойцовский круг: Тэнь-у Красный Дым‡Der Ring des Herausforderers: Tenwu der Rote Rauch‡도전자의 대련장: 붉은 연기의 텐우‡El Círculo del Contendiente: Tenwu del Humo Rojo‡‡L’Arène des combattants : Tenwu de la Fumée rouge‡挑战者之环：“赤烟”腾武‡',
    nil,
    'Desafie o Tenwu da Fumaça Vermelha e derrote-o em combate na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Вызовите на бой в гарнизоне Шадо-Пан, что в Танлунских степях, Тэнь-у Красного Дыма и победите его.‡Fordert Tenwu den Roten Rauch heraus und besiegt ihn im Kampf in der Shado-Pan-Garnison in der Tonlongsteppe.‡붉은 연기의 텐우에게 도전해 탕랑 평원의 음영파 주둔지에서 그를 꺾어야 합니다. 레벨 25 탕랑 평원‡Desafía a Tenwu del Humo Rojo y derrótalo en combate en el Cuartel del Shadopan, en las Estepas de Tong Long.‡‡Défiez Tenwu de la Fumée rouge à la Garnison des Pandashan, dans les Steppes de Tanglong et triomphez de lui.‡在螳螂高原的影踪卫戍营中向“赤烟”腾武发起挑战并打败他。‡',
  }
},
[31228] = {
  {
    'Profeta Khar\'zul‡Пророк Хар\'зул‡Prophet Khar\'zul‡예언자 카르줄‡Profeta Khar\'zul‡‡Le prophète Khar’zul‡先知克哈祖尔‡',
    nil,
    'Derrote o Profeta Khar\'zul. Uma‡Победите пророка Хар\'зула.‡Besiegt Prophet Khar\'zul.‡예언자 카르줄을 꺾어야 합니다. 레벨 20 쿤라이 봉우리‡Derrota al profeta Khar\'zul.‡‡Triomphez du Prophète Khar’zul.‡击败先知克哈祖尔。‡',
  }
},
[31230] = {
  {
    'Boas-vindas a Flor da Manhã‡Добро пожаловать в Цветущую Зарю!‡Willkommen in Morgenblüte‡새벽의 꽃에 잘 오셨습니다!‡Bienvenidos a Floralba‡‡Bienvenue à Fleur-de-l’Aurore‡欢迎来到晨芳园‡',
    nil,
    'Fale com Kai Lúpulo Errante, com o Mestre Pelo ao Vento e com Peiji Áurea Cevada em Flor da Manhã. Uma‡Поговорите с Каем Бродячим Бражником, мастером Воздушный Мех и Пэйцзи Золотистый Нектар в Цветущей Заре.‡Sprecht mit Kai Wanderbräu, Meister Windpelz und Peiji Zapfgold in Morgenblüte.‡새벽의 꽃에 있는 카이 원더브루, 사부 윈드퍼, 페이지 골든드래프트와 대화해야 합니다. 레벨 10 비취 숲‡Habla con Kai Pócima Errante, el maestro Pelaje Recio y Peiji Brisa Dorada en Floralba.‡‡Parlez à Kai Bière Bohème, Maître Fourrure de Vent, et Peiji Pression d’Or à Fleur-de-l’Aurore.‡和晨芳园的凯·游酒、风裘大师以及佩吉·金酿谈一谈。‡',
  }
},
[31231] = {
  {
    'Extermínio de girateia‡Истребление страхопрядов‡Die Auslöschung der Schreckensspinner‡공포실거미 근절 작전‡El exterminio de la hiladora de pavor‡‡Extermination de tisseffroi‡根除恐惧织网蛛‡',
    nil,
    'Mate 8 Protetoras Girateia no Terraço de Gurthan. Fale com Kil\'ruk, o Aniquilador dos Ventos, para conseguir transporte aéreo. Uma‡Убейте 8 страхопрядов-охранников на террасе Гуртани. Поговорите с Кил\'руком Рассекающим Ветер для выброски с воздуха.‡Tötet 8 Schreckensspinnerhüter auf der Terrasse von Gurthan. Bittet Kil\'ruk den Windschnitter, Euch dort abzusetzen.‡구르단 정원에서 공포실거미 망꾼 8마리를 처치해야 합니다. 공중 강하를 하려면 칼날바람 킬루크와 대화하십시오.‡Mata a 8 cuidadoras hiladoras de pavor en el Bancal Gurthan. Habla con Kil\'ruk el Atracavientos para hacer un lanzamiento aéreo.‡‡Tuez 8 Choyeuses tisseffroi à la Terrasse de Gurthan. Demandez un largage aérien à Kil’ruk le Saccageur des vents.‡在格尔桑平台杀死8只恐惧织网小蜘蛛。和掠风者克尔鲁克谈一谈空投的事情。‡',
  }
},
[31232] = {
  {
    'Um império antigo‡Древняя империя‡Ein uraltes Reich‡고대의 제국‡Un Imperio ancestral‡‡Un empire d’un autre âge‡远古帝国‡',
    nil,
    'Pegue 8 Tabuletas de Gurthani. Uma‡Соберите 8 скрижалей Гуртани.‡Sammelt 8 Gurthanitafeln.‡구르다니 서판 8개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 8 tablillas Gurthani.‡‡Récupérez 8 Tablettes gurthanies.‡收集8块格萨尼石板。‡',
  }
},
[31233] = {
  {
    'Coleta de seiva‡Сбор смолы‡Saft anzapfen‡수액을 모아라‡Extracción de savia‡‡Siphonnage d’ambre‡采集树脂‡',
    nil,
    'Colete 6 Seivas de Âmbar. Uma‡Соберите 6 образцов янтарной смолы.‡Sammelt 6 Portionen Bernsaft.‡호박 수액 6개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 6 unidades de savia ámbar.‡‡Récupérez 6 doses de Sève d’ambre.‡收集6份琥珀汁液。‡',
  }
},
[31234] = {
  {
    'Olho gordo‡Выколоть глаз‡Ein Auge ausstechen‡눈알을 모아라‡Echar un ojo‡‡Des yeux à l’œil‡完美的信息‡',
    nil,
    'Consiga 1 Olho Imaculado de Monstro do Pântano. Uma‡Добудьте 1 безупречный глаз болотного чудища.‡Sammelt 1 makelloses Morastbestienauge.‡온전한 수렁 안개도깨비 눈 1개를 모아야 합니다. 레벨 30 공포의 황무지‡Consigue 1 ojo de bestia de lodazal prístino.‡‡Obtenez 1 Œil de bête du bourbier en parfait état.‡收集1颗泥泞兽信息囊。‡',
  }
},
[31235] = {
  {
    'Não, não e não‡Нет-нет-нет‡Pfui, noch mehr Spinnen‡안돼 안돼 안돼‡No, no, no‡‡Non, non et non !‡除虫良方‡',
    nil,
    'Use a Arma-Dragão Shado-pan para destruir 20 Ovos de Girateia no Terraço de Gurthani. Uma‡C помощью драконьего ружья Шадо-Пан уничтожьте 20 яиц страхопрядов на террасе Гуртани.‡Benutzt das Drachengewehr der Shado-Pan, um 20 Schreckensspinnereier auf der Terrasse von Gurthan zu zerstören.‡음영파 용화포를 사용해서 구르단 정원에 있는 공포실거미 알 20개를 파괴해야 합니다. 레벨 30 공포의 황무지‡Utiliza la pistola de dragón del Shadopan para destruir 20 huevos de hiladoras de pavor en el Bancal Gurthan.‡‡Détruisez 20 Œufs de tisseffroi à la Terrasse de Gurthan avec le Fusil-dragon pandashan.‡使用影踪派龙枪在格尔桑平台摧毁20枚恐惧织网蛛的卵。‡',
  }
},
[31237] = {
  {
    'Limpando o Terraço‡Борьба с насекомыми‡Die Terrasse von Insekten befreien‡정원 수색‡Fumigar la veranda‡‡Désinsectiser la terrasse‡清理平台‡',
    nil,
    'Extermine 6 Olhos da Imperatriz na área perto do Terraço de Gurthan. Matar qualquer coisa lhe concederá Rastreamento de Feromônio, ajudando a localizar os olhos.‡Растопчите 6 Очей Императрицы на террасе Гуртан. Убийство любого существа позволит вам отслеживать феромоны и поможет их обнаружить.‡Zerstampft 6 Augen der Kaiserin auf der Terrasse von Gurthan. Wenn Ihr etwas tötet, wird Euch die Pheromonfährtensuche bei der Aufstöberung helfen.‡구르단 정원 주위에서 여제의 눈 6개를 짓밟아야 합니다. 구르단 정원에 있는 아무 몬스터나 처치하면 페로몬 추적이 발동되어 여제의 눈을 발견할 수 있습니다.‡Pisotea a 6 ojos de la Emperatriz en el Bancal Gurthan. Al matar cualquier cosa, revelarás un rastro de feromonas que te ayudará a detectarlos.‡‡Récupérez 6 Yeux de l’impératrice sur la Terrasse de Gurthan. Toute créature tuée vous confère la capacité Pistage de phéromones, qui vous permet de détecter vos cibles.‡在格尔桑平台清理6只女皇之眼。杀死任何东西都可以让你获得信息素追踪的能力，以帮助你找到它们。‡',
  }
},
[31238] = {
  {
    'Comida para o cérebro‡Пища для мозгов‡Nahrung fürs Hirn‡뇌에 좋은 먹이‡Alimento cerebral‡‡Nourriture « spirituelle »‡健脑食品‡',
    nil,
    'Traga 4 Línguas de Mushan para Kaz\'tik, o Manipulador, em Klaxxi\'vess. Uma‡Принесите 4 языка мушана Каз\'тику Манипулятору в Клакси\'весс.‡Bringt 4 Mushanzungen zu Kaz\'tik dem Manipulator in Klaxxi\'vess.‡클락시베스에 있는 배후자 카즈티크에게 무샨 혀 4개를 가져가야 합니다. 레벨 30 공포의 황무지‡Lleva 4 lenguas de mushan a Kaz\'tik el Manipulador, en Klaxxi\'vess.‡‡Rapportez 4 Langues de mushan à Kaz’tik le Manipulateur, à Klaxxi’vess.‡带4条穆山兽之舌给卡拉克西维斯的操纵者卡兹提克。‡',
  }
},
[31239] = {
  {
    'O que importa um nome-nome?‡Что тебе в имени-имени моем?‡Name ist gut, Name Name ist besser!‡이름 이름이 뭐길래?‡¿Qué importa el nombre nombre?‡‡Nom de nom !‡你叫什么名字名字？‡',
    nil,
    'Mate 7 Jinyus Passo n\'Água. Uma‡Уничтожьте 7 приречных цзинь-юй.‡Tötet 7 Strandläufer der Jinyu.‡진위 물가순찰병 7마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 7 jinyu Zancarrío.‡‡Tuez 7 Batteurs de grève jinyu.‡击败7个溪行锦鱼人。‡',
  }
},
[31240] = {
  {
    'Infestação em Guo-Lai‡Нападение Го-лай‡Guo-Lai-Befall‡‡La infestación de Guo-Lai‡‡Infestation de Guo-Lai‡‡',
    nil,
    'Fale com Anji Luz do Outono nas Ruínas de Guo Lai. Uma‡Поговорите с Аньцзи Осенний Свет на руинах Го-Лай.‡Sprecht mit Anji Herbstlicht in den Guo-Lai-Ruinen.‡‡Habla con Anji Fulgor Otoñal en las Ruinas de Guo-Lai.‡‡Parlez à Anji Clair d’Automne aux Ruines de Guo-Lai.‡‡',
  }
},
[31241] = {
  {
    'Galeritos galerosos‡Гадкие шнуропсы‡Fiese Nappels‡사악한 우낏‡Makakus malvados‡‡Méchants lokdus‡邪恶的无毛怪‡',
    nil,
    'Pegue 6 Medalhões de Serviço da Aliança dos Paraquedistas Fatigados. Uma‡Соберите 6 медальонов воинов Альянса у закаленных в боях парашютистов.‡Sammelt 6 Dienstmedaillons der Allianz von kampferprobten Fallschirmjägern.‡노련한 공수부대원에게서 얼라이언스 무공훈장 6개를 모아야 합니다. 레벨 10 비취 숲‡Consigue 6 medallones de servicio a la Alianza de paracaidistas desgastados por la batalla.‡‡Rassemblez 6 Médailles de service de l’Alliance sur les Parachutistes usés par la guerre.‡从疲惫的伞兵身上收集6枚联盟效力奖章。‡',
  }
},
[31242] = {
  {
    'Vila do Cair da Bruma‡Деревня Туманного Водопада‡Nebelhauch‡‡Aldea Bruma Otoñal‡‡Tombe-Brume‡‡',
    nil,
    'Fale novamente com Che Andarilho Selvagem na Vila do Cair da Bruma. Uma‡Поговорите с Чэ Диким Странником в деревне Туманного Водопада.‡Sprecht mit Che Wildmarsch in Nebelhauch.‡‡Habla con Che Caminante Silvano en la Aldea Bruma Otoñal.‡‡Parlez à Che Marche Sauvage à Tombe-Brume.‡‡',
  }
},
[31243] = {
  {
    'Ataque à Vila do Cair da Bruma‡Нападение на деревню Туманного Водопада‡Angriff auf Nebelhauch‡‡Ataque a la Aldea Bruma Otoñal‡‡L’attaque de Tombe-Brume‡雾临村遭袭‡',
    nil,
    'Fale novamente com Sun Coração Tenro na Vila do Cair da Bruma. Uma‡Поговорите с Сунь Доброе Сердце в деревне Туманного Водопада.‡Sprecht mit Sun Zartherz in Nebelhauch.‡‡Habla con Sun Corazón Afable en la Aldea Bruma Otoñal.‡‡Parlez à Sun Cœur de Douceur à Tombe-Brume.‡和雾临村的孙·柔心谈一谈。‡',
  }
},
[31244] = {
  {
    'Acampamento Guo-Lai‡Лагерь Го-лай‡Guo-Lai-Lager‡‡Campamento Guo-Lai‡‡Le campement de Guo-Lai‡郭莱营地‡',
    nil,
    'Fale com Leven Lâmina da Manhã nas Ruínas de Guo-Lai. Uma‡Поговорите с Левеном Рассветным Клинком в руинах Го-лай.‡Sprecht mit Leven Morgenklinge in den Guo-Lai-Ruinen.‡‡Habla con Leven Hoja Clara en las Ruinas de Guo-Lai.‡‡Parlez à Leven Lame de l’Aube aux Ruines de Guo-Lai.‡和郭莱遗迹的莱文·晨刃谈一谈。‡',
  }
},
[31245] = {
  {
    'Vila do Cair da Bruma‡Деревня Туманного Водопада‡Nebelhauch‡‡Aldea Bruma Otoñal‡‡Tombe-Brume‡雾临村‡',
    nil,
    'Fale novamente com Che Andarilho Selvagem na Vila do Cair da Bruma. Uma‡Поговорите с Чэ Диким Странником в деревне Туманного Водопада.‡Sprecht mit Che Wildmarsch in Nebelhauch.‡‡Habla con Che Caminante Silvano en la Aldea Bruma Otoñal.‡‡Parlez à Che Marche Sauvage à Tombe-brume.‡和雾临村的车·荒野行者谈一谈。‡',
  }
},
[31246] = {
  {
    'Ataque à Vila do Cair da Bruma‡Нападение на деревню Туманного Водопада‡Angriff auf Nebelhauch‡‡Ataque a la Aldea Bruma Otoñal‡‡L’attaque de Tombe-brume‡‡',
    nil,
    'Fale novamente com Rook Dedo-de-pedra na Vila do Cair da Bruma. Uma‡Поговорите с Руком Каменной Ступней в деревне Туманного Водопада.‡Sprecht mit Rook Steinzeh in Nebelhauch.‡‡Habla con Rook Mano Dura en la Aldea Bruma Otoñal.‡‡Parlez à Freux Orteil de Pierre à Tombe-brume.‡‡',
  }
},
[31247] = {
  {
    'Guarnição do Sol Poente‡Гарнизон Заходящего Солнца‡Die Garnison der Untergehenden Sonne‡석양 주둔지‡Baluarte del Sol Poniente‡‡La garnison du Soleil couchant‡残阳关卫戍营‡',
    nil,
    'Fale com Anji Luz do Outono na Guarnição do Sol Poente. Uma‡Поговорите с Аньцзи Осенним Светом в Гарнизоне Заходящего Солнца.‡Sprecht mit Anji Herbstlicht in der Garnison der Untergehenden Sonne.‡석양 주둔지에 있는 안지 오톰라이트와 대화해야 합니다. 레벨 1 영원꽃 골짜기‡Habla con Anji Fulgor Otoñal en el Baluarte del Sol Poniente.‡‡Parlez à Anji Clair d’Automne à la garnison du Soleil couchant.‡和残阳关卫戍营的安济·秋光谈一谈。‡',
  }
},
[31248] = {
  {
    'As Ruínas de Guo-Lai‡Руины Го-Лай‡Die Guo-Lai-Ruinen‡‡Las Ruinas de Guo-Lai‡‡Les ruines de Guo-Lai‡‡',
    nil,
    'Fale com Anji Luz do Outono nas Ruínas de Guo Lai. Uma‡Поговорите с Аньцзи Осенний Свет на руинах Го-Лай.‡Sprecht mit Anji Herbstlicht bei den Guo-Lai-Ruinen.‡‡Habla con Anji Fulgor Otoñal en las Ruinas de Guo-Lai.‡‡Parlez à Anji Clair d’Automne aux Ruines de Guo-Lai.‡‡',
  }
},
[31249] = {
  {
    'Vila do Cair da Bruma‡Деревня Туманного Водопада‡Nebelhauch‡‡Aldea Bruma Otoñal‡‡Tombe-brume‡‡',
    nil,
    'Fale novamente com Che Andarilho Selvagem na Vila do Cair da Bruma. Uma‡Поговорите с Чэ Диким Странником в деревне Туманного Водопада.‡Sprecht mit Che Wildmarsch in Nebelhauch.‡‡Habla con Che Caminante Silvano en la Aldea Bruma Otoñal.‡‡Parlez à Che Marche Sauvage à Tombe-brume.‡‡',
  }
},
[31250] = {
  {
    'Guarnição do Sol Poente‡Гарнизон Заходящего Солнца‡Die Garnison der Untergehenden Sonne‡‡Baluarte del Sol Poniente‡‡La garnison du Soleil couchant‡‡',
    nil,
    'Fale com Anji Luz do Outono na Guarnição do Sol Poente. Uma‡Поговорите с Аньцзи Осенним Светом в Гарнизоне Заходящего Солнца.‡Sprecht mit Anji Herbstlicht in der Garnison der Untergehenden Sonne.‡‡Habla con Anji Fulgor Otoñal en el Baluarte del Sol Poniente.‡‡Parlez à Anji Clair d’Automne à la Garnison du Soleil couchant.‡‡',
  }
},
[31251] = {
  {
    'As melhores comidas já feitas em toda a história!‡Самая лучшая еда‡Besser essen geht nicht!‡최고의 밥상!‡¡Las mejores comidas del mundo!‡‡Les meilleurs plats au monde !‡绝世美肉！‡',
    nil,
    'Pegue 160 Pedaços Carnudos de Kun-Lai. Uma‡Соберите 160 мясных кусочков Кунь-Лай.‡Besorgt 160 Kun-Lai-Fleischbrocken.‡쿤라이 고기 조각을 160개 구해야 합니다. 레벨 20 쿤라이 봉우리‡Consigue 160 tapitas de carne de Kun-Lai.‡‡Collectez 160 Bouts de viande de Kun-Lai.‡收集160份昆莱肉末。‡',
  }
},
[31252] = {
  {
    'De volta ao Repouso do Vento Oeste‡Обратно, в приют Западного Ветра‡Zurück zur Westwindruhestätte‡다시 서풍의 쉼터로‡Regreso a Reposo Viento del Oeste‡‡Retour au repos du Vent de l’Ouest‡返回西风之息‡',
    nil,
    'Fale novamente com o Lavrador Bô no Repouso do Vento Oeste, no Monte Kun-Lai. Uma‡Вернитесь к батраку Бо в приют Западного Ветра на вершине Кунь-Лай.‡Kehrt zu Landarbeiter Bo in der Westwindruhestätte am Kun-Lai-Gipfel zurück.‡쿤라이 봉우리의 서풍의 쉼터에 있는 농장 일꾼 보에게 돌아가야 합니다. 레벨 20 쿤라이 봉우리‡Reúnete con el mozo de labranza Bo en el Reposo Viento del Oeste, en la Cima Kun-Lai.‡‡Retournez voir le Journalier Bo au Repos du Vent de l’Ouest, au Sommet de Kun-Lai.‡去昆莱山的西风之息找雇农小波。‡',
  }
},
[31253] = {
  {
    'De volta ao Repouso do Vento Leste‡Обратно в приют Восточного Ветра.‡Zurück zur Ostwindruhestätte‡다시 동풍의 쉼터로‡Regreso a Reposo Viento del Este‡‡Retour au repos du Vent de l’Est‡返回东风之眠‡',
    nil,
    'Fale novamente com o Lavrador Kô no Repouso do Vento Leste, no Monte Kun-Lai. Uma‡Вернитесь к батраку Ко в приют Восточного Ветра на вершине Кунь-Лай.‡Kehrt zu Landarbeiter Ko in der Ostwindruhestätte am Kun-Lai-Gipfel zurück.‡쿤라이 봉우리의 동풍의 쉼터에 있는 농장 일꾼 코에게 돌아가야 합니다. 레벨 20 쿤라이 봉우리‡Reúnete con el mozo de labranza Ko en el Reposo Viento del Este, en la Cima Kun-Lai.‡‡Retournez voir le Journalier Ko au Repos du Vent de l’Est, au Sommet de Kun-Lai.‡去昆莱山的东风之眠找雇农小寇。‡',
  }
},
[31254] = {
  {
    'A estrada para Kun-Lai‡Дорога в Кунь-Лай‡Die Straße nach Kun-Lai‡쿤라이로 가는 길‡El camino a Kun-Lai‡‡En route pour Kun-Lai‡昆莱之路‡',
    nil,
    'Viaje pela Escadaria Oculta até a Vila Binan. Uma‡Отправляйтесь в деревню Бинан по Сокрытой лестнице.‡Reist über die Verhüllte Treppe nach Binan.‡장막의 계단을 거쳐 빈안 마을로 여행해야 합니다. 레벨 20 장막의 계단‡Viaja a través de La Escalera Velada hasta la Aldea Binan.‡‡Prenez l’Escalier dérobé jusqu’à Binan.‡穿过雾纱栈道并抵达滨岸村。‡',
  }
},
[31255] = {
  {
    'A estrada para Kun-Lai‡Дорога в Кунь-Лай‡Die Straße nach Kun-Lai‡쿤라이로 가는 길‡El camino a Kun-Lai‡‡En route pour Kun-Lai‡昆莱之路‡',
    nil,
    'Viaje pela Escadaria Oculta até a Vila Binan. Uma‡Отправляйтесь в деревню Бинан по Сокрытой лестнице.‡Reist über die Verhüllte Treppe nach Binan.‡장막의 계단을 거쳐 빈안 마을로 여행해야 합니다. 레벨 20 장막의 계단‡Viaja a través de La Escalera Velada hasta la Aldea Binan.‡‡Prenez l’Escalier dérobé jusqu’à Binan.‡穿过雾纱栈道并抵达滨岸村。‡',
  }
},
[31256] = {
  {
    'Peão de boiadeiro‡Отлов яков‡Treibt sie zusammen‡야크 몰이‡Atrápalos‡‡Regroupez-les‡赶牛‡',
    nil,
    'Arrebanhe 3 Iaques da Planície Selvagem e entregue-os no Repouso do Vento Leste. Uma‡Поймайте 3 диких яков равнин и отведите их в приют Восточного Ветра.‡Treibt 3 Yaks der Wilden Ebenen zusammen und bringt sie zur Ostwindruhestätte.‡야생 초원 야크 3마리를 모아 동풍의 쉼터로 돌아와야 합니다. 레벨 20 쿤라이 봉우리‡Atrapa a 3 yaks de Las Llanuras Salvajes y devuélvelos al Reposo Viento del Este.‡‡Regroupez 3 Yacks des plaines Sauvages et conduisez-les au Repos du Vent de l’Est.‡捕捉3头野生平原牦牛，将它们带到东风之眠。‡',
  }
},
[31260] = {
  {
    'Maestria do lucro: Caxim‡Охота за наживой: Чашин‡Meisterprofiteur: Casheen‡돈 사냥법 익히기: 차쉰‡Maestría rentable: Chasheen‡‡La maîtrise du profit : Chasheen‡唯利是图：查舍恩‡',
    nil,
    'Colete Sangue de Tigre Ancião. Uma‡Добудьте кровь старой тигрицы.‡Sammelt das Blut der alten Tigerin.‡고대 호랑이의 피를 구해야 합니다. 레벨 15 크라사랑 밀림‡Consigue sangre de tigresa anciana.‡‡Récupérez le Sang de tigre antique.‡收集古代虎血。‡',
  }
},
[31261] = {
  {
    'O Capitão Jack está morto‡Голова капитана Джека‡Kapitän Jack ist tot‡잭 선장의 죽음‡El capitán Jack ha muerto‡‡Le capitaine Jack est mort‡杰克船长的亡灵‡',
    nil,
    'Leve a cabeça do Capitão Jack para o Chefe Koh Koh no Morro Bagarai. Uma‡Отнесите голову капитана Джека вождю Ках-Каху, который находится на холме Грукин.‡Bringt Kapitän Jacks Kopf zu Häuptling Kah Kah in Flotschhügel.‡그루끼끼 언덕에 있는 족장 카 카에게 선장 잭의 머리를 가져가야 합니다. 레벨 10 비취 숲‡Llévale la cabeza del capitán Jack al jefe Kah Kah en Cerro Makaku.‡‡Rapportez la Tête du Capitaine Jack au Chef Koh Koh, au Tertre des Groukards.‡把杰克船长的遗物带给古鲁金猴山的酋长卡哈卡哈。‡',
  }
},
[31262] = {
  {
    'Maestria da garça: Bicofino‡Охота на журавля: иглоклюв‡Kranichbeherrschung: Dolchschnabel‡학 사냥법 익히기: 바늘부리‡Dominio de grullas: Picaguja‡‡La maîtrise des grues : Bec-acéré‡猎鹤高手：针尖铁嘴‡',
    nil,
    'Consiga o bico fino de Bicofino. Uma‡Добудьте иглоклюв.‡Holt Euch den Dolchschnabel.‡바늘부리를 손에 넣어야 합니다. 레벨 15 크라사랑 밀림‡Consigue la picaguja.‡‡Récupérez le Bec-acéré.‡取得针喙。‡',
  }
},
[31265] = {
  {
    'Fôlego de Mazu‡Дыхание Мацзу‡Mazus Atem‡마쭈의 숨결‡Aliento de Mazu‡‡Le souffle de Mazu‡玛祖的气息‡',
    nil,
    'Beba a Poção do Fôlego de Mazu. Uma‡Выпейте зелье "Дыхание Мацзу".‡Trinkt den Trank aus Mazus Atem.‡마쭈의 숨결 물약을 마셔야 합니다. 레벨 30 공포의 황무지‡Bebe la poción de aliento de Mazu.‡‡Buvez la Potion de souffle de Mazu.‡喝下玛祖的气息药水。‡',
  }
},
[31266] = {
  {
    'Incursões mogus‡Набеги могу‡Einfall der Mogu‡모구의 습격‡Incursiones mogu‡‡Incursions mogu‡魔古大军入侵‡',
    nil,
    'Mate o Mestre Espião Shan\'ze. Uma‡Найдите и убейте шпиона Шань\'цзэ.‡Findet und tötet den Spionagemeister der Shan\'ze.‡샨쩌 첩보단장을 처치해야 합니다. 레벨 25 탕랑 평원‡Encuentra y mata al maestro de espías de Shan\'ze.‡‡Trouvez le Maître-espion shan’ze et tuez-le.‡找到并击败山泽间谍大师。‡',
  }
},
[31267] = {
  {
    'Destruição dos Lamina da Névoa‡Уничтожение клана Туманного Клинка‡Die Vernichtung der Nebelklingen‡안개칼날 파괴‡Destrucción de Hojaniebla‡‡Extermination des Lame-de-brume‡雾刃覆灭‡',
    nil,
    'Mate 6 Estripadores Lâmina da Névoa. Uma‡Убейте 6 раздирателей из клана Туманного Клинка.‡Tötet 6 Reißer der Nebelklingen.‡안개칼날 학살자 6명을 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 6 desgarradores Hojaniebla.‡‡Tuez 6 Éventreurs lame-de-brume.‡杀死6个雾刃撕裂者。‡',
  }
},
[31268] = {
  {
    'Um pouco de trabalho mental‡Работа мысли‡Kleine, graue Zellen‡사소한 두뇌노동‡Trabajo cerebral‡‡La fuite des cerveaux‡脑力劳动‡',
    nil,
    'Colete 3 Cérebros Incrustados de Âmbar de Ferrâmbares Ik\'thik. Uma‡Соберите 3 покрытых янтарем мозга с тел ик\'тиков-янтарожалов.‡Sammelt 3 bernverkrustete Gehirne von Bernstechern der Ik\'thik.‡이크티크 호박쐐기전갈에게서 호박석 박힌 두뇌 3개를 모아야 합니다. 레벨 30 공포의 황무지‡Reúne 3 cerebros taraceados con ámbar de los aguijoneros de ámbar.‡‡Récupérez 3 Cerveaux incrustés d’ambre sur les Aiguillonambres ik’thik.‡从伊克提克珀针蝎身上收集3个琥珀化的大脑。‡',
  }
},
[31269] = {
  {
    'O Senhor das Escamas‡Чешуйчатый повелитель‡Der Schuppenlord‡비늘군주‡El señor de escamas‡‡Le seigneur des écailles‡邪鳞领主‡',
    nil,
    'Mate o Senhor das Escamas dos Lâmina da Névoa. Uma‡Убейте чешуйчатого повелителя из клана Туманного Клинка.‡Tötet den Schuppenlord der Nebelklingen.‡안개칼날 비늘군주를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata al señor de escamas Hojaniebla.‡‡Tuez le Seigneur des écailles lame-de-brume.‡杀死雾刃邪鳞领主。‡',
  }
},
[31270] = {
  {
    'A luta contra o medo‡Схватка со страхом‡Der Kampf gegen die Angst‡공포에 맞서 싸워라‡Combatir el miedo‡‡Un combat contre la peur‡以暴制暴‡',
    nil,
    'Mate 15 Escorpídeos Deimoscamas. Uma‡Убейте 15 мерзкочешуйчатых скорпидов.‡Tötet 15 Schreckensschuppenskorpide.‡공포비늘 전갈 15마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 15 escórpidos Aterraescamas.‡‡Tuez 15 Scorpides horrécailles.‡杀死15只恐鳞蝎。‡',
  }
},
[31271] = {
  {
    'Genes ruins‡Дурные гены‡Schlechte Gene‡불량 유전자‡Malos genes‡‡Génie génétique‡恶毒基因‡',
    nil,
    'Mate 3 Genemantes Ik\'thik e 6 Cuidadores de Ovos Ik\'thik. Uma‡Убейте 3 ик\'тиков-скрещивателей и 6 ик\'тиков – смотрителей яиц.‡Tötet 3 Genomanten der Ik\'thik und 6 Eierdrohnen der Ik\'thik.‡이크티크 유전학자 3마리와 이크티크 알지기 6마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 3 genománticos Ik\'thik y a 6 zánganos ovíparos Ik\'thik.‡‡Tuez 3 Gènemanciens ik’thik et 6 Bourdons à œufs ik’thik.‡杀死3个伊克提克基因操纵师和6个伊克提克护卵者。‡',
  }
},
[31272] = {
  {
    'Infecção‡Заражение‡Ansteckung‡감염‡Infección‡‡Infection‡感染‡',
    nil,
    'Mate 6 animais selvagens infectados. Os animais infectados incluem Mariposas Pó-de-osso, Mushans Couro-azul e Escorpídeos Mutantes. Um(a) missão.‡Убейте 6 зараженных тварей. Заражены могут быть костепылые мотыльки, синешкурые мушаны и мутирующие скорпиды.‡Tötet 6 infizierte Wildtiere. Infizierte Wildtiere sind Knochenstaubmotten, Blauhautmushan und mutierende Skorpide.‡감염된 야생동물 6마리를 처치해야 합니다. 뼛가루 나방, 푸른가죽 무샨, 돌연변이 전갈이 감염되었을 가능성이 있습니다.‡Mata a 6 animales infectados, entre los que pueden incluirse polillas polvohueso, mushan pielazul y escórpidos mutantes.‡‡Tuez 6 représentants de la Faune infectée. Il peut s’agir de Phalènes poussière-d’os, de Mushan céruléchines et de Scorpions en mutation.‡杀死6只被感染的野生动物。被感染的野生动物可能包括骨尘飞蛾、蓝皮穆山兽和变异巨蝎。‡',
  }
},
[31273] = {
  {
    'Relíquias do enxame‡Реликвии роя‡Relikte des Schwarms‡무리의 유물‡Reliquias del enjambre‡‡Les reliques de l’essaim‡虫群的圣物‡',
    nil,
    'PH. Uma‡PH.‡PH.‡PH. 레벨 1 공포의 황무지‡PH.‡‡PH.‡PH‡',
  }
},
[31274] = {
  {
    'LFGDungeons - Mists - Raid Finder - 1st‡LFGDungeons - Mists - Raid Finder - 1st‡LFGDungeons - Mists - Raid Finder - 1st‡LFGDungeons - Mists - Raid Finder - 1st‡Buscador de bandas (1º)‡‡LFGDungeons - Mists - Raid Finder - 1st‡团队查找器（第一次）‡',
