[31807] = {
  {
    'Missão de Rastreio: Abertura do Vale Dourado II‡Tracking Quest: Opened the Golden Valley‡Verfolgungsquest: Öffnen des Goldenen Tales II‡퀘스트 추적: 황금 골짜기 열기 II‡Tracking Quest: Opened the Golden Valley II‡‡Tracking Quest: Opened the Golden Valley II‡追踪任务：开启金色谷入口II‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31808] = {
  {
    'Destrua a máquina‡Механическая ярость‡Hiebe sind für alle da‡사마귀에 대한 분노‡Ahí viene la plaga‡‡Ravage contre les mantides‡冲撞机器‡',
    nil,
    'Matar 200 Mantídeos controlando Kovok na Cicatriz. Uma‡Уничтожьте 200 богомолов, управляя Ковоком во рве.‡Tötet 200 Mantis, während Ihr Kovok in der Schneise kontrolliert.‡셰크지르의 손아귀에서 코보크를 조종해 사마귀 200마리를 처치해야 합니다. 레벨 30 공포의 황무지‡Mata a 200 mántides mientras controlas a Kovok en la grieta.‡‡Tuez 200 Mantides en controllant Kovok dans la Balafre.‡在峡谷中操纵科沃克击败200只螳螂妖。‡',
  }
},
[31809] = {
  {
    'Restos de Ira‡Остатки злости‡Überbleibsel des Zorns‡분노의 잔재‡Los restos de la ira‡‡Les vestiges de la colère‡怒之煞的残肢‡',
    nil,
    'Entregue a Garra da Ira a Ban Coração de Urso na Guarnição Shado-Pan, que fica nas Estepes de Taolong. Uma‡Доставьте Коготь гнева Баню Медвежьему Сердцу, который находится в Танлунских степях, в гарнизоне Шадо-Пан.‡Bringt die Klaue des Zorns zu Ban Bärenherz bei der Shado-Pan-Garnison in der Tonlongsteppe.‡탕랑 평원의 음영파 주둔지에 있는 반 베어하트에게 분노의 발톱을 가져가야 합니다. 레벨 25 탕랑 평원‡Entrega la garra de ira a Ban Corazón Fiero en el Cuartel del Shadopan, en las Estepas de Tong Long.‡‡Apportez la Griffe de la colère à Ban Cœur d\'Ours à la Garnison des Pandashan dans les Steppes de Tanglong.‡将愤怒之爪带给螳螂高原影踪卫戍营的班·熊心。‡',
  }
},
[31810] = {
  {
    'Cortando os céus‡Полет Облачного Змея‡Am Himmel reiten‡하늘을 달려‡Surcar los cielos‡‡Chevaucher dans les cieux‡展翅高飞‡',
    nil,
    'Junte-se à Ordem da Serpente das Nuvens. Uma‡Вступите в орден Облачного Змея.‡Schließt Euch dem Orden der Wolkenschlange an.‡운룡단의 일원이 되어야 합니다. 레벨 10 비취 숲‡Únete a la Orden del Dragón Nimbo.‡‡Rejoignez l’Ordre du Serpent-nuage.‡加入云端翔龙骑士团。‡',
  }
},
[31811] = {
  {
    'Cortando os céus‡Полет Облачного Змея‡Am Himmel reiten‡하늘을 달려‡Surcar los cielos‡‡Chevaucher dans les cieux‡展翅高飞‡',
    nil,
    'Junte-se à Ordem da Serpente das Nuvens. Uma‡Вступите в орден Облачного Змея.‡Schließt Euch dem Orden der Wolkenschlange an.‡운룡단의 일원이 되어야 합니다. 레벨 10 비취 숲‡Únete a la Orden del Dragón Nimbo.‡‡Rejoignez l’Ordre du Serpent-nuage.‡加入云端翔龙骑士团。‡',
  }
},
[31812] = {
  {
    'Zunta, o domador de mascotes‡Зунта, укротитель питомцев‡Zunta, der Tierzähmer‡애완동물 조련사, 준타‡Zunta, el domador de mascotas‡‡Zunta le dompteur de mascottes‡宠物训练师祖塔‡',
    nil,
    'Derrote Zunta numa batalha de mascotes. Uma‡Победите Зунту в битве питомцев. это‡Besiegt Zunta in einem Haustierkampf.‡애완동물 대전에서 준타를 꺾어야 합니다. 레벨 1‡Derrota a Zunta en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Zunta.‡在宠物战斗中击败祖塔。‡',
  }
},
[31813] = {
  {
    'Dagra, a Bruta‡Дагра Яростная‡Dagra die Grimmige‡맹렬한 다그라‡Dagra la Fiera‡‡Dagra la Féroce‡凶狠的达戈‡',
    nil,
    'Derrote Dagra, a Bruta, numa batalha de mascotes. Uma‡Победите Дагру Яростную в битве питомцев. это‡Besiegt Dagra die Grimmige in einem Haustierkampf.‡애완동물 대전에서 맹렬한 다그라를 꺾어야 합니다. 레벨 1‡Derrota a Dagra la Fiera en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Dagra la Féroce.‡在宠物战斗中击败凶狠的达戈。‡',
  }
},
[31814] = {
  {
    'Analynn‡Аналинн‡Analynn‡아날린‡Analynn‡‡Analynn‡安纳林‡',
    nil,
    'Derrote Analynn numa batalha de mascotes. Uma‡Победите Аналинн в битве питомцев. это‡Besiegt Analynn in einem Haustierkampf.‡애완동물 대전에서 아날린을 꺾어야 합니다. 레벨 1‡Derrota a Analynn en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Analynn.‡在宠物战斗中击败安纳林。‡',
  }
},
[31815] = {
  {
    'Zonya, a Sádica‡Зоня Садистка‡Zonya die Sadistin‡성격 나쁜 존야‡Zonya la Sádica‡‡Zonya la Sadique‡嗜虐的索亚‡',
    nil,
    'Derrote Zonya, a Sádica, numa batalha de mascotes. Uma‡Победите Зоню Садистку в битве питомцев. это‡Besiegt Zonya die Sadistin in einem Haustierkampf.‡애완동물 대전에서 성격 나쁜 존야를 꺾어야 합니다. 레벨 1‡Derrota a Zonya la Sádica en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Zonya la Sadique.‡在宠物战斗中击败嗜虐的索亚。‡',
  }
},
[31816] = {
  {
    'Traidor Gluk‡Предатель Глак‡Gluk der Verräter‡배신자 글루크‡Traidor Gluk‡‡Gluk le traître‡‡',
    nil,
    'Vença Bill, o Pirata, numa batalha de mascotes. Uma‡Defeat Bill the Pirate in a pet battle. это‡Besiegt Bill den Piraten in einem Haustierkampf.‡애완동물 전투에서 빌 버클러를 물리쳐야 합니다. 레벨 5‡Derrota a Bill el Pirata en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Bill le pirate.‡‡',
  }
},
[31817] = {
  {
    'Xit Cascoforte‡Мерда Могучее Копыто‡Merda Starkhuf‡메르다 스트롱후프‡Herda Pezuña Fuerte‡‡Mardi Sabot-Puissant‡梅达·硬蹄‡',
    nil,
    'Derrote Xit Cascoforte numa batalha de mascotes. Uma‡Победите Мерду Могучее Копыто в битве питомцев. это‡Besiegt Merda Starkhuf in einem Haustierkampf.‡애완동물 대전에서 메르다 스트롱후프를 꺾어야 합니다. 레벨 1‡Derrota a Herda Pezuña Fuerte en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Mardi Sabot-Puissant.‡在宠物战斗中击败梅达·硬蹄。‡',
  }
},
[31818] = {
  {
    'Zunta‡Зунта‡Zunta‡준타‡Zunta‡‡Zunta‡祖塔‡',
    nil,
    'Derrote Zunta numa batalha de mascotes. Uma‡Победите Зунту в битве питомцев. это‡Besiegt Zunta in einem Haustierkampf.‡애완동물 대전에서 준타를 꺾어야 합니다. 레벨 1‡Derrota a Zunta en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Zunta.‡在一场宠物对战中击败祖塔。‡',
