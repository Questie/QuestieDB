[26997] = {
  {
    'Os suspeitos‡Обычные подозреваемые‡Die üblichen Verdächtigen‡일단 의심하고 보자‡Sospechosos habituales‡Sospechosos habituales‡Les suspects habituels‡通常嫌疑犯‡一般性的猜測',
    nil,
    'Interrogue 6 Trabalhadores das Docas de Ventobravo no Porto de Ventobravo.‡Допросите 6 штормградских портовых рабочих в порту Штормграда.‡Fühlt im Hafen von Sturmwind 6 Dockarbeitern von Sturmwind auf den Zahn.‡스톰윈드 항구에 있는 스톰윈드 항구 일꾼 6명을 심문해야 합니다.‡Interroga a 6 trabajadores del muelle de Ventormenta en el Puerto de Ventormenta.‡Interroga a 6 trabajadores del muelle de Ventormenta en el Puerto de Ventormenta.‡Interrogez 6 Portefaix de Hurlevent au Port de Hurlevent.‡在暴风城码头讯问6名暴风城码头工人。‡在暴風港審問6名暴風碼頭工人',
  }
},
[26998] = {
  {
    'Se eu pudesse, matava mil‡Закрепление успехов‡Den Erfolg fortsetzen‡예행연습‡Poniendo el éxito a prueba‡Poniendo el éxito a prueba‡Un génocide clinique‡延续成功‡再次成功',
    nil,
    'Mate 50 Murlocs Pinavil.‡Уничтожьте 50 мурлоков из племени Злобного Плавника.‡Tötet 50 Murlocs der Finsterflossen.‡썩은지느러미 멀록 50마리를 처치해야 합니다.‡Mata a 50 múrlocs Anca Vil.‡Mata a 50 múrlocs Anca Vil.‡Tuez 50 Murlocs ailerons noirs.‡杀死50头邪鳍鱼人。‡殺死50隻邪鰭魚人。',
  }
},
[26999] = {
  {
    'Uma nova era para as Terras Pestilentas‡Новая эра Чумных земель‡Eine neue Ära für die Pestländer‡역병지대의 새로운 시대‡Una nueva era para las Tierras de la Peste‡Una nueva era para las Tierras de la Peste‡Une nouvelle ère pour les Maleterres‡瘟疫之地的新时代‡瘟疫之地的新紀元',
    nil,
    'Consiga 4 Amostras de Tocaieira Pestilenta, 4 Amostras de Tocaieira Rasterruça, 4 Amostras de Ursovil Canhestro e 4 Amostras de Lobo Doente.‡Раздобудьте по 4 образца следующих тканей: чумного воронкового паука, воронкового паука Ядовитого Тумана, неповоротливого чумного медведя и зараженного волка.‡Sammelt Proben von 4 Seuchenlauerern, 4 Giftnebellauerern, 4 schwerfälligen Seuchenbären und 4 kranken Wölfen.‡돌연변이 늑대거미 견본과 독안개 늑대거미 견본, 덩치 큰 역병곰 견본과 병에 걸린 늑대 견본을 각각 4개씩 획득해야 합니다.‡Consigue 4 muestras de rondador de peste, 4 muestras de rondador Bromatósigo, 4 muestras de oso apestado descomunal y 4 muestras de lobo malsano.‡Consigue 4 muestras de rondador de peste, 4 muestras de rondador Bromatósigo, 4 muestras de oso apestado descomunal y 4 muestras de lobo malsano.‡Obtenez 4 Échantillons de rôdeuse pestilentielle, 4 Échantillons de rôdeuse venimeuse des brumes, 4 Échantillons d’ours pesteux massif et 4 Échantillons de loup malade.‡采集4份天灾潜伏者样本，4份毒雾潜伏者样本，4份巨大的疫病熊样本和4份生病的狼样本‡取得4份瘟疫潛伏者樣本、4份毒霧潛伏者樣本、4份笨重的瘟疫熊樣本、以及4份染病的狼樣本。',
  }
},
[27000] = {
  {
    'Tapa na aranha‡Разобраться досконально‡Komm, hol das Lasso raus‡요령 익히기‡Aprendiendo la profesión‡Aprendiendo la profesión‡Apprendre les ficelles‡熟能生巧‡學習使用韁繩',
    nil,
    'Monte em um Mustangue de Amparo na Serraria de Beiranorte. Depois, use a habilidade Relinchar dele para espantar 25 Aranhas Beiranorte.‡Садитесь на мустанга Дольнего Очага у лесопилки Северного Кряжа и при помощи его способности "Ржание" напугайте 25 пауков Северного Кряжа.‡Steigt am Sägewerk des Nordkamms auf einen Herdweiler Mustang und benutzt seine Fähigkeit \'Wiehern\', um 25 Nordkammspinnen Angst einzujagen.‡북마루 벌목지에 있는 하스글렌 야생마에 올라타 말울음 능력을 이용해 북마루 거미 25마리를 위협해야 합니다.‡Monta en un caballo mesteño de Vega del Amparo en el Aserradero Crestanorte y después emplea su facultad Relinchar para asustar a 25 arañas de Crestanorte.‡Monta en un caballo mesteño de Vega del Amparo en el Aserradero Crestanorte y después emplea su facultad Relinchar para asustar a 25 arañas de Crestanorte.‡Montez sur un Mustang d’Âtreval à la Scierie de la Crête du nord, puis utilisez sa capacité Hennissement pour effrayer 25 Araignées de la Crête du nord.‡骑上一匹壁炉谷野马前往北山伐木场，用它的嘶鸣技能吓跑25只北山蜘蛛。‡到北山伐木場去騎上一匹壁爐谷野馬，然後利用牠的嘶鳴聲驚嚇25隻北山蜘蛛。',
  }
},
[27001] = {
  {
    'Tá na hora do PAU (Porrada nas Aranhas Urgente!)‡Охота на пауков‡Hier ist WoW (Wald ohne Wildspinnen)‡이제는 전쟁이야!‡Esto es la GUERRA (Gran Unificación y Erradicación de Raras y Rabiosas Arañas)‡Esto es la GUERRA (Gran Unificación y Erradicación de Raras y Rabiosas Arañas)‡Je veux une vraie boucherie !‡这就是战争（野生蜘蛛大赶集）‡這意味著戰爭(圍捕野生蜘蛛)',
    nil,
    'Monte em um Mustangue de Amparo na Serraria de Beiranorte. Depois, use a habilidade Relinchar dele para direcionar 10 Aranhas Beiranorte para os Recrutas de Amparo que estão na Serraria Beiranorte. Você pode arrebanhar várias aranhas de cada vez.‡Садитесь на мустанга Дольнего Очага у лесопилки Северного Кряжа и с помощью его способности "Ржание" выгоните 10 пауков Северного Кряжа на новобранцев Дольного Очага у лесопилки Северного Кряжа. Одновременно вы можете гнать несколько пауков.‡Besteigt am Sägewerk des Nordkamms einen Herdweiler Mustang und benutzt seine Fähigkeit \'Wiehern\', um 10 Nordkammspinnen zu den Rekruten von Herdweiler an der Nordkamm Sägemühle zu treiben. Ihr könnt mehrere Spinnen auf einmal zusammentreiben.‡북마루 벌목지 주변에 있는 하스글렌 야생마를 탄 뒤에 말울음 능력을 이용해 북마루 거미 10마리를 하스글렌 신병들에게 몰아 보내야 합니다. 한번에 여러 마리의 북마루 거미를 몰아 보낼 수 있습니다.‡Monta en un caballo mesteño de Vega del Amparo cerca del Aserradero Crestanorte y después emplea su facultad Relinchar para enviar a 10 arañas de Crestanorte hasta los reclutas de Vega del Amparo en el Aserradero Crestanorte. Puedes acorralar a varias arañas a la vez.‡Monta en un caballo mesteño de Vega del Amparo cerca del Aserradero Crestanorte y después emplea su facultad Relinchar para enviar a 10 arañas de Crestanorte hasta los reclutas de Vega del Amparo en el Aserradero Crestanorte. Puedes acorralar a varias arañas a la vez.‡Montez sur un Mustang d’Âtreval près de la Scierie de la Crête du nord, puis utilisez sa capacité Hennissement pour rabattre 10 Araignées de la Crête du nord vers les Recrues d’Âtreval, à la Scierie de la Crête du nord. Vous pouvez rabattre plusieurs araignées à la fois.‡在北山伐木场附近骑一匹壁炉谷野马，用它的嘶鸣技能将10只北山蜘蛛赶到北山伐木场的壁炉谷新兵那儿。你一次可以多赶几只。‡到北山伐木場附近去騎上一匹壁爐谷野馬，然後利用牠的嘶鳴聲把10隻北山蜘蛛趕到北山伐木場的壁爐谷志願兵所在地。你可以一次圍捕數隻蜘蛛。',
  }
},
[27002] = {
  {
    'Uma audiência com o grão-lorde‡Аудиенция у верховного лорда‡Eine Audienz mit dem Hochlord.‡대영주와의 만남‡Una audiencia con el alto señor‡Una audiencia con el alto señor‡Une audience auprès du généralissime‡觐见大领主‡大領主的召見',
    nil,
    'Apresente-se ao Grão-lorde Tirion Fordring em Amparo, que fica nas Terras Pestilentas Ocidentais.‡Отправляйтесь в Дольный Очаг, что в Западных Чумных землях, и доложите о своем прибытии верховному лорду Тириону Фордрингу.‡Meldet Euch in den Westlichen Pestländern in Herdweiler bei Hochlord Tirion Fordring.‡서부 역병지대의 하스글렌에 있는 대영주 티리온 폴드링에게 보고해야 합니다.‡Preséntate ante el alto señor Tirion Vadín en la Vega del Amparo en las Tierras de la Peste del Oeste.‡Preséntate ante el alto señor Tirion Vadín en la Vega del Amparo en las Tierras de la Peste del Oeste.‡Présentez-vous au Généralissime Tirion Fordring à Âtreval, dans les Maleterres de l’Ouest.‡去向西瘟疫之地壁炉谷的大领主提里奥·弗丁报告。‡到西瘟疫之地的壁爐谷去向大領主提里奧·弗丁回報。',
  }
},
[27003] = {
  {
    'Dinheiro fácil‡Легкие деньги‡Leichtverdientes Geld‡눈먼 돈‡Dinero fácil‡Dinero fácil‡Argent facile‡轻松赚钱‡土裡蹦出的錢',
    nil,
    'Acompanhe a caravana de Adarrah para Uldum.‡Сопроводите караван Адарры в Ульдум.‡Begleitet Adarrahs Karawane hinein nach Uldum.‡아다라의 마차를 호위하며 울둠으로 가야 합니다.‡Acompaña a la caravana de Adarrah hasta Uldum.‡Acompaña a la caravana de Adarrah hasta Uldum.‡Accompagnez la Caravane d\'Adarrah jusqu\'en Uldum.‡陪伴埃达尔拉的车队进入奥丹姆。‡陪同阿達拉的商隊進入奧丹姆。',
  }
},
[27004] = {
  {
    'Conspiração crepuscular‡Заговор Сумеречного Молота‡Zwielichtpläne‡황혼의 계획서‡El complot Crepuscular‡El complot Crepuscular‡Le complot du Crépuscule‡暮光的阴谋‡暮光的陰謀',
    nil,
    'Pegue os Planos do Portão do Mestre.‡Достаньте планы Врат Мастеров.‡Sammelt die Pläne für das Tor der Meister.‡지배자의 관문 계획서를 수집해야 합니다.‡Consigue los planes de la Puerta de los Maestros.‡Consigue los planes de la Puerta de los Maestros.‡Récupérez les Plans de la Porte des Maîtres.‡搜集真主之门计划书。‡收集主宰之門計畫。',
  }
},
[27005] = {
  {
    'Conspiração crepuscular‡Заговор Сумеречного Молота‡Zwielichtpläne‡황혼의 계획서‡El complot Crepuscular‡El complot Crepuscular‡Le complot du Crépuscule‡暮光的阴谋‡暮光的陰謀',
    nil,
    'Pegue os Planos do Portão do Mestre.‡Достаньте планы Врат Мастеров.‡Sammelt die Pläne für das Tor der Meister.‡지배자의 관문 계획서를 수집해야 합니다.‡Consigue los planes de la Puerta de los Maestros.‡Consigue los planes de la Puerta de los Maestros.‡Récupérez les Plans de la Porte des Maîtres.‡搜集真主之门计划书。‡收集主宰之門計畫。',
