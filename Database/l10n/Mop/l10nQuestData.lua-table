[28084] = {
  {
    'O poder de Krom\'gar‡Мощь Кром\'гара‡Die Macht der Krom\'gar‡크롬가르의 힘‡El poder de Krom\'gar‡El poder de Krom\'gar‡La puissance de Krom’gar‡克罗姆加的力量‡克羅姆加的力量',
