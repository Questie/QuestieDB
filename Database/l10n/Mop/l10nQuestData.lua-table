[30200] = {
  {
    'Em teias cinzentas‡Пепельная паутина‡Im Netz der Glut‡땅거미 거미줄‡En redes cinéreas‡‡Toiles de cendre‡灰色蛛网‡',
    nil,
    'Mate 8 Aranhas Teiacinzas. Uma‡Убейте 8 пепельных пауков.‡Tötet 8 Glutnetzspinnen.‡잿빛그물 거미 8마리를 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a 8 arañas Telaceniza.‡‡Tuez 8 Araignées cendretoile.‡击败8个灰网蜘蛛。‡',
  }
},
