[7681] = {
  {
    'Hunter test quest‡Hunter test quest‡Hunter test quest‡Hunter test quest‡Hunter test quest‡Hunter test quest‡Hunter test quest‡Hunter test quest‡Hunter test quest',
    nil,
    'Alimente o seu ajudante e, então, fale com o seu recrutador.‡Покормите своего питомца и поговорите с персонажем, который выдал это задание.‡Füttert Euer Tier und sprecht dann mit dem Questgeber.‡야수에게 먹이를 준 후 퀘스트 NPC와 대화해야 합니다.‡Alimenta a tu mascota y luego habla con el asignador de misión.‡Dale de comer a tu mascota y habla con tu personaje con misión.‡Nourrissez votre familier, puis parlez au donneur de quête.‡喂养你的宠物，随后与任务发布者交谈。‡餵你的寵物，然後和你的任務給予者對話。',
  }
},
[7682] = {
  {
    'Hunter test quest2‡Hunter test quest2‡Hunter test quest2‡Hunter test quest2‡Hunter test quest2‡Hunter test quest2‡Hunter test quest2‡Hunter test quest2‡Hunter test quest2',
    nil,
    'Alimente o seu ajudante e, então, fale com o seu recrutador.‡Покормите своего питомца и поговорите с персонажем, который выдал это задание.‡Füttert Euer Tier und sprecht dann mit dem Questgeber.‡야수에게 먹이를 준 후 퀘스트 NPC와 대화해야 합니다.‡Alimenta a tu mascota y luego habla con el asignador de misión.‡Dale de comer a tu mascota y habla con tu personaje con misión.‡Nourrissez votre familier, puis parlez au donneur de quête.‡喂养你的宠物，随后与任务发布者交谈。‡餵你的寵物，然後和你的任務給予者對話。',
  }
},
[7701] = {
  {
    'PROCURA-SE: Feitor Maltorius‡Разыскивается: надзиратель Мальториус‡GESUCHT: Aufseher Maltorius‡현상 수배: 감독관 말토류스‡SE BUSCA: Sobrestante Maltorius‡SE BUSCA: Sobrestante Maltorius‡ON RECHERCHE : Surveillant Maltorius‡悬赏：工头玛托留斯‡懸賞:監督者瑪托留斯',
    nil,
    'Nas profundezas do Fosso de Lava do Caldeirão, na Garganta Abrasadora, você encontrará o anão traidor dos Ferro Negro chamado Feitor Maltorius.|n|nMate o Feitor Maltorius, arranque a cabeça dele e leve-a para o Capitão-vigia Lolo Longalcance na Garganta Abrasadora para receber sua recompensa.‡Дворф из клана Черного Железа, вероломный надзиратель Мальториус, скрывается в глубине Шлаковой Ямы в Котле, что в Тлеющем ущелье. |n|nУбейте надзирателя Мальториуса и принесите его голову дозорному капитану Лоло Долгобою.‡Tief in der Schlackengrube des Kessels in der Sengenden Schlucht werdet Ihr den verräterischen Dunkeleisenzwerg, Aufseher Maltorius, finden. |n|nTötet den Aufseher Maltorius und nehmt seinen Kopf an Euch. Bringt diesen zum Hauptmann des Ausgucks Lolo Langhieb in der Sengenden Schlucht für eine Belohnung.‡이글거리는 협곡의 용광로에 있는 잿가루 채석장 깊은 곳에서 검은무쇠 드워프 변절자인 감독관 말토류스를 찾아 처치하고, 이글거리는 협곡에 있는 감시대장 롤로 롱스트라이커에게 그의 머리카락을 증거로 가져가 보상을 받아야 합니다.‡El traidor Hierro Negro llamado sobrestante Maltorius está en La Fosa de la Escoria de La Caldera, en La Garganta de Fuego. |n|nMátalo y lleva su cabeza al capitán de vigía Lolo Zancalarga a La Garganta de Fuego para recibir tu recompensa.‡El traidor Hierro Negro llamado sobrestante Maltorius está en La Fosa de la Escoria de La Caldera, en La Garganta de Fuego. |n|nMátalo y lleva su cabeza al capitán de vigía Lolo Zancalarga a La Garganta de Fuego para recibir tu recompensa.‡Loin dans les profondeurs de la fosse aux Scories dans le Chaudron, dans la Gorge des Vents brûlants, vous trouverez le nain traître du clan Sombrefer répondant au nom de surveillant Maltorius.|n|nTuez le surveillant Maltorius et prenez sa tête. Apportez-la au capitaine de guet Lolo Heurteloin dans la Gorge des Vents brûlants pour la récompense.‡那个叫做工头玛托留斯的黑铁矮人叛徒就藏在大熔炉的熔渣之池深处。|n|n杀死工头玛托留斯，将他的徽记交给灼热峡谷的侦查队长洛洛尔以换取你的奖励。‡那個叫做監督者瑪托留斯的黑鐵矮人叛徒就藏在大熔爐的熔渣之池深處。|n|n殺死監督者瑪托留斯，將他的頭顱交給灼熱峽谷的偵察隊長洛洛爾以換取你的獎勵。',
  }
},
[7702] = {
  {
    'Mate-os de sono‡Казнь через лишение сна‡Tötet sie mit Schlafentzug‡수면 방해‡¡Mátalos de sueño!‡¡Mátalos de sueño!‡Privez-les de sommeil‡让他们失眠！‡讓他們失眠!',
    nil,
    'Lá no fundo do Fosso de Lava do Caldeirão, você vai encontrar os dormitórios dos anões Ferro Negro.|n|nVá até lá e roube 20 Travesseiros de Ferro Negro. Fale novamente com Evonice Fumarenta na Garganta Abrasadora quando tiver terminado a tarefa.‡Найдите спальные кварталы дворфов Черного Железа в глубине Шлаковой Ямы, что в Котле. |n|nУкрадите 20 подушек дворфов Черного Железа. По выполнении задания вернитесь к Эвонис Сажекурке.‡Tief in der Schlackengrube des Kessels, findet Ihr die Schlafräume der Dunkeleisenzwerge.|n|nFindet diese Schlafkammern und stibitzt 20 Dunkeleisenkissen. Kehrt dann zu Evonice Rußraucher in der Sengenden Schlucht, wenn Ihr die Aufgabe erfüllt habt.‡용광로에 있는 잿가루 채석장 깊은 곳에 가면 검은무쇠 드워프들의 침소를 찾을 수 있습니다.|n|n이글거리는 협곡에 있는 에보니스 수트스모커에게 침소에서 훔친 검은무쇠 베개 20개를 가져가야 합니다.‡Los dormitorios de los Hierro Negro están en La Fosa de la Escoria de La Caldera, en La Garganta de Fuego. |n|nRoba 20 almohadas y ve a ver a Evonis Fumollín.‡Los dormitorios de los Hierro Negro están en La Fosa de la Escoria de La Caldera, en La Garganta de Fuego. |n|nRoba 20 almohadas y ve a ver a Evonis Fumollín.‡Loin dans les profondeurs de la fosse aux Scories, dans le Chaudron, vous trouverez le dortoir des nains Sombrefer.|n|nAllez dans leur dortoir et volez 20 Oreillers Sombrefer. Revenez voir Evonice Fumesuie dans la gorge des Vents brûlants quand vous aurez accompli cette tâche.‡在大熔炉的熔渣之池深处，你可以发现黑铁矮人的休息区。|n|n到休息区去偷走20只黑铁枕头。当你完成任务后就回到灼热峡谷的艾沃奈斯那里复命。‡在大熔爐的熔渣之池深處，你可以發現黑鐵矮人的休息區。|n|n到休息區去偷走20個黑鐵枕頭。當你完成任務後就回到灼熱峽谷的艾沃奈斯那裡覆命。',
  }
},
[7703] = {
  {
    'Negócios pendentes‡Неоконченное дело Гордоков‡Die offene Rechnung der Gordok‡고르독 일 마무리‡Asunto Gordok sin finiquitar‡Asunto Gordok sin finiquitar‡Affaires inachevées chez les Gordok‡戈多克食人魔的事务‡戈多克巨魔的事務',
    nil,
    'Encontre as Manoplas do Poder de Gordok e devolva-as para o Capitão Kebrapaw no Gládio Cruel.|n|nDe acordo com Kebrapaw, a "história de ancião" diz que Tortheldrin — um elfo "medonho" que se diz príncipe — roubou as manoplas de um dos reis Gordok.‡Добудьте латную рукавицу Мощи Гордока и вернитесь с ней к капитану Давигрому в Забытом Городе.|n|nПо словам Давигрома, в "старых байках" говорится, что Тортелдрин – "страшный эльф", называющий себя принцем, – похитил эту рукавицу у одного из королей Гордоков.‡Findet die Stulpen der Gordokmacht und bringt sie zu Hauptmann Krombruch in Düsterbruch.|n|nKrombruch zufolge sagen die "Alte Zeit Geschichten", dass Tortheldrin - ein "gruseliger" Elf, der sich selbst als Prinz bezeichnet- sie einem der Gordokkönige gestohlen hat.‡권력의 고르독 건틀릿을 찾아 혈투의 전장에 있는 대장 크롬크러쉬에게 가져가야 합니다.|n|n크롬크러쉬의 "옛날 얘기"에 따르면 자칭 왕자라는 토르텔드린이라는 이름의 "기분 나쁜" 엘프가 고르독 왕에게서 빼앗아갔다고 합니다.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre. |n|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre. |n|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Trouvez le Gantelet de puissance gordok et rendez-le au Capitaine Kromcrush à Hache-tripes.|n|nSelon Kromcrush, les histoires des « vieux » racontent que Tortheldrin - un « vilain » elfe qui se fait appeler prince - l\'a volé à l\'un des rois gordok.‡找到戈多克力量护手，并将它交给厄运之槌的克罗卡斯。|n|n根据克罗卡斯所说的，"传说"自称是王子的精灵托塞德林从一名戈多克食人魔手中偷走了那件神器。‡找到戈多克力量護手，並將它交給厄運之槌的克羅卡斯。|n|n根據克羅卡斯所說的，「傳說」自稱是王子的精靈托塞德林從一名戈多克巨魔手中偷走了那件神器。',
  }
},
[7704] = {
  {
    'Olha o tamanho disso!‡Размер имеет значение‡Wie groß das ist!‡엄청나게 큰 베개!‡¡Mira el tamaño de esto!‡¡Mira el tamaño de esto!‡Regardez un peu la taille !‡看看它的个头！‡看看它的個頭!',
    nil,
    'Leve o Travesseiro da Camareira Alma Fada para Evonice Fumarenta, na Garganta Abrasadora.‡Отнесите подушку горничной Крепкие Тиски Эвонис Сажекурке в Тлеющее ущелье.‡Bringt das Kissen von Zimmermädchen Kissenquetscher zu Evonice Rußraucher in der Sengenden Schlucht.‡이글거리는 협곡에 있는 에보니스 수트스모커에게 하녀 필라클렌처의 베개를 가져가야 합니다.‡Lleva la almohada de la ayudante de cámara Pilaprieta a Evonis Fumollín a La Garganta de Fuego.‡Lleva la almohada de la ayudante de cámara Pilaprieta a Evonis Fumollín a La Garganta de Fuego.‡Apportez l\'Oreiller de la Femme de chambre Pincetaie à Evonice Fumesuie dans la Gorge des Vents brûlants.‡将比拉凯琳的枕头交给灼热峡谷的艾沃奈斯。‡將比拉凱琳的枕頭交給灼熱峽谷的艾沃奈斯。',
  }
},
[7721] = {
  {
    'Bota dez aí, chefia!‡Энергия для уменьшения‡Treibstoff fürs Schrumpfen‡변환을 위한 연료‡Combustible para el Ultra-reductor‡Combustible para el Ultra-reductor‡Du carburant pour la zappette‡压缩器的动力‡壓縮器的動力',
    nil,
    'Colete 10 Âmagos dos Elementais de Água dos Elementais do Mar e dos Borrifos do Mar ao longo da Costa Esquecida de Feralas, e leve-os para Zorbin Cegasvista, próximo às docas.‡Соберите 10 ядер элементалей воды, убивая морских элементалей и морских валов на Забытом берегу в Фераласе, и принесите их Зорбину Дребезгуну, который находится неподалеку от порта.‡Sammelt 10 Wasserelementarkerne von den Meereselementaren und Meeresschauern entlang der Vergessenen Küste von Feralas und bringt sie zurück zu Zorbin von Schiller in der Nähe des dortigen Docks.‡페랄라스의 잊혀진 해안에 있는 바다 정령과 바다 물보라 정령에게서 물의 정령 핵 10개를 모아 부두 근처에 있는 조르빈 팬대즐에게 가져가야 합니다.‡Reúne 10 núcleos de elemental de agua de los elementales marinos y de los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Hipnoviento, que está cerca del embarcadero.‡Reúne 10 núcleos de elemental de agua de los elementales marinos y de los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Hipnoviento, que está cerca del embarcadero.‡Récupérez 10 Noyaux élémentaires d\'eau sur les Elémentaires marins et les Embruns le long de la Côte Oubliée de Féralas, et rapportez-les à Zorbin Poudrozieu, près du quai là-bas.‡从菲拉斯被遗忘的海岸那里的海元素和巨型海元素身上获取10块水元素核心，把它们交给码头附近的索尔宾·范达瑟。‡從菲拉斯被遺忘的海岸那裡的海元素和巨型海元素身上獲取10塊水元素核心，把它們交給碼頭附近的索爾賓·范達瑟。',
  }
},
[7722] = {
  {
    'Segue o fluxo‡Какой еще плавень?‡Was zum Fluxus?!‡불꽃 융해촉진제?‡¿Qué pasa con el flujo?‡¿Qué pasa con el flujo?‡Le flux embrasé‡绝密配方！‡絕密配方!',
    nil,
    'Em algum lugar do Fosso de Lava do Caldeirão você encontra as Instruções Secretas: Fluxo Ígneo que o Feitor Maltorius roubou. Encontre as instruções e devolva-as ao Mestre Ferreiro Queimatar na Garganta Abrasadora.|n‡Верните секретные документы по изготовлению огненного плавня, украденные надзирателем Мальториусом. Инспектор скорее всего находится в Шлаковой Яме в Котле. Документы верните мастеру-кузнецу Гориврату в Тлеющем ущелье.‡Irgendwo in der Schlackengrube des Kessels findet Ihr die geheimen Pläne des Feurigen Fluxus, die der Aufseher Maltorius stahl. Findet diese Pläne und bringt sie zurück zu Meisterschmied Burninate in der Sengenden Schlucht.‡용광로의 잿가루 채석장 어딘가에 감독관 말토류스가 훔친 비밀조제법: 불꽃 융해촉진제가 있을 것입니다. 이 조제법을 찾아서 이글거리는 협곡에 있는 수석대장장이 버니네이트에게 가져가야 합니다.‡Busca la receta de fluido ardiente robada por el vigía Maltorius en La Fosa de la Escoria de La Caldera. Llévasela al maestro herrero Cremación a La Garganta de Fuego.‡Busca los diseños secretos: flujo ígneo robados por el sobrestante Maltorius en La Fosa de la Escoria de La Caldera. Llévaselos al herrero maestro Burninate a La Garganta de Fuego.|n‡Quelque part dans la fosse aux Scories du Chaudron, vous trouverez les Plans secrets : Flux embrasé dérobés par le surveillant Maltorius. Trouvez ces plans et rapportez-les au Maître forgeron Brûlotin, dans la Gorge des Vents brûlants.‡在大熔炉的熔渣之池中的某个地方，你可以找到工头玛托留斯偷走的秘密设计图：炽热助熔剂。找到这些设计图，把它们还给灼热峡谷的大铁匠博恩奈特。‡在大熔爐的熔渣之池中的某個地方，你可以找到監督者瑪托留斯偷走的秘密設計圖:熾熱助熔劑。找到這些設計圖，把它們還給灼熱峽谷的大鐵匠博恩奈特。',
  }
},
[7723] = {
  {
    'Malditos dedos gordos‡Будь прокляты эти толстые пальцы‡Verdammt seien diese fetten Finger‡두꺼운 손가락의 슬픔‡¡Malditos dedos gordos!‡¡Malditos dedos gordos!‡Maudits gros doigts‡该死的手指头！‡該死的胖手指!',
    nil,
    'Hansel Mão-pesada quer que você mate 20 Golens de Guerra Pesados.|n|nOs Golens de Guerra Pesados perambulam pelas áreas em torno do Caldeirão, na Garganta Abrasadora. Quando tiver matado a quantidade necessária, fale novamente com Hansel na Garganta Abrasadora.‡По поручению Хансела Большерука убейте 20 тяжелых боевых големов, которых можно найти в землях, окружающих Котел в Тлеющем ущелье. По выполнении задания вернитесь к Ханселу.‡Hansel Bleihand möchte, dass Ihr 20 Schwere Kriegsgolems tötet. |n|nDie Schweren Kriegsgolems wandern in der Gegend um den Kessel in der Sengenden Schlucht herum. Sobald Ihr genug getötet habt, kehrt zu Hansel zurück.‡이글거리는 협곡의 용광로 주변을 돌아다니는 육중한 전쟁 골렘 20마리를 처치하고 임무를 완수하면 이글거리는 협곡에 있는 한셀 헤비핸드에게 가야 합니다.‡Hansel Manospesadas quiere que mates 20 gólems de guerra pesados. |n|nSuelen estar cerca de La Caldera en La Garganta de Fuego. Después ve a ver a Hansel a La Garganta de Fuego.‡Hansel Manospesadas quiere que mates 20 gólems de guerra pesados. |n|nSuelen estar cerca de La Caldera en La Garganta de Fuego. Después ve a ver a Hansel a La Garganta de Fuego.‡Hansel Lourdemains veut que vous tuiez 20 Golems de guerre lourds.|n|nLes golems de guerre lourds errent dans les régions qui entourent le Chaudron dans la Gorge des Vents brûlants. Quand vous en aurez tué assez, revenez voir Hansel dans la Gorge des Vents brûlants.‡汉瑟尔·重拳让你杀掉20个重型作战傀儡。|n|n重型作战傀儡就在灼热峡谷的大熔炉附近。当你杀死足够多的傀儡后，就回去找汉瑟尔·重拳。‡漢瑟爾·重拳讓你殺掉20個重型戰爭魔像。|n|n重型戰爭魔像就在灼熱峽谷的大熔爐附近。當你殺死足夠多的魔像後，就回去找漢瑟爾·重拳。',
  }
},
[7724] = {
  {
    'Toco cru pegando fogo‡Огненная угроза‡Feurige Bedrohung!‡뒤꽁무니에서 불을 뿜는 거미‡Amenaza abrasadora‡Amenaza abrasadora‡Une menace incandescente‡熔岩蜘蛛的威胁！‡熔岩蜘蛛的威脅!',
    nil,
    'Hansel Mão-pesada quer que você mate 20 Grandes Aranhas de Lava na Garganta Abrasadora. Você pode encontrá-las nos platôs e poços de lava do local.|n|nDepois de matar as Grandes Aranhas de Lava, fale novamente com Hansel Mão-pesada na Garganta Abrasadora.‡По указанию Хансела Большерука убейте 20 больших лавовых пауков в Тлеющем ущелье. Пауки водятся на вулканических плато и в озерах лавы в Тлеющем ущелье.|n|nкогда убьете достаточно пауков, вернитесь к Ханселу.‡Hansel Bleihand möchte, dass Ihr 20 große Lavaspinnen in der Sengenden Schlucht tötet. |n|nDie großen Lavaspinnen findet Ihr auf den Plateaus und in den Lavabecken der Sengenden Schlucht. Sobald Ihr genug getötet habt, kehrt zu Hansel zurück.‡이글거리는 협곡의 고원과 용암 지대에서 서식하는 거대한 용암거미 20마리를 처치한 후, 이글거리는 협곡에 있는 한셀 헤비핸드에게 가야 합니다.‡Hansel Manospesadas quiere que mates 20 arañas de lava superiores en La Garganta de Fuego. Las encontrarás en las mesetas y los estanques de lava de La Garganta de Fuego. |n|nCuando hayas matado suficientes arañas de lava superiores ve a ver a Hansel Manospesadas a La Garganta de Fuego.‡Hansel Manospesadas quiere que mates 20 arañas de lava superiores en La Garganta de Fuego. Las encontrarás en las mesetas y los estanques de lava de La Garganta de Fuego. |n|nCuando hayas matado suficientes arañas de lava superiores ve a ver a Hansel Manospesadas a La Garganta de Fuego.‡Hansel Lourdemains veut que vous tuiez 20 Grandes araignées de lave dans la gorge des Vents brûlants. Vous pouvez trouver les Grandes araignées de lave dans les plateaux et les mares de lave de la gorge des Vents brûlants.|n|nRevenez voir Hansel dans la gorge des Vents brûlants quand vous aurez tué assez de Grandes araignées de lave.‡汉瑟尔·重拳要你杀死灼热峡谷中的20只巨型熔岩蜘蛛。你可以在灼热峡谷的高地和熔岩池里找到巨型熔岩蜘蛛。|n|n当你杀死足够的巨型熔岩蜘蛛之后，回到汉瑟尔·重拳那里复命。‡漢瑟爾·重拳要你殺死灼熱峽谷中的20隻巨型熔岩蜘蛛。你可以在灼熱峽谷的高地和熔岩池裡找到巨型熔岩蜘蛛。|n|n當你殺死足夠的巨型熔岩蜘蛛之後，回到漢瑟爾·重拳那裡覆命。',
  }
},
[7725] = {
  {
    '‡Еще раз ослабим великанов‡Und wieder unter den geschrumpften Riesen‡‡Encoge más gigantes‡Encoge más gigantes‡Le retour des géants rétrécis‡更多被缩小的巨人！‡',
    nil,
    '‡Используйте ультрасжиматель Зорбина, чтобы уменьшить великанов любого вида, каких вы найдете в Фераласе. Принесите 10 миниатюрных великанов Зорбину Дребезгуну в порт Забытого берега в Фераласе.‡Benutzt Zorbins Ultraschrumpfer, um jegliche Art von Riesen in Feralas in eine handlichere Form zu schrumpfen. Bringt 10 Schrumpfüberreste, die auf den kleineren handlicheren Riesen liegen zu Zorbin von Schiller am Dock der Vergessenen Küste in Feralas.‡‡Utiliza el Ultra-reductor de Zorbin para encoger a cualquier gigante que encuentres en Feralas a un tamaño más manejable. Lleva 10 residuos de miniaturización encontrados en las versiones encogidas de los gigantes a Zorbin Hipnoviento, al embarcadero de La Costa Olvidada de Feralas.‡Utiliza el Ultra-reductor de Zorbin para encoger a cualquier gigante que encuentres en Feralas a un tamaño más manejable. Lleva 10 residuos de miniaturización encontrados en las versiones encogidas de los gigantes a Zorbin Hipnoviento, al embarcadero de La Costa Olvidada de Feralas.‡Utilisez l\'Ultra-réducteur de Zorbin sur des géants de n\'importe quel type en Féralas afin les rendre plus faciles à gérer. Apportez 10 Résidus de miniaturisation que vous trouverez sur les versions rétrécies des géants à Zorbin Poudrozieu aux docks de la Côte Oubliée, en Féralas.‡使用索尔宾的超级压缩器来缩小菲拉斯的任意种类的巨人，将他们缩小到更容易控制的体积。从缩小过的巨人身上收集10份微缩残渣，把它们交给菲拉斯被遗忘的海岸码头的索尔宾·范达瑟。‡',
  }
},
[7726] = {
  {
    '‡Новая энергия для уменьшения‡Neuer Treibstoff fürs Schrumpfen‡‡Más combustible para el Ultra-reductor‡Más combustible para el Ultra-reductor‡Encore du carburant pour la zappette‡补充动力‡',
    nil,
    '‡Соберите 6 ядер элементалей воды, убивая морских элементалей и морских валов на Забытом берегу в Фераласе, и принесите их Зорбину Дребезгуну, который находится неподалеку от порта.‡Sammelt 6 Wasserelementarkerne von den Meereselementaren und Meeresschauern entlang der Vergessenen Küste von Feralas und bringt sie zurück zu Zorbin von Schiller in der Nähe des dortigen Docks.‡‡Reúne 6 núcleos de elemental de agua de los elementales marinos y los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Hipnoviento, que está cerca del embarcadero.‡Reúne 6 núcleos de elemental de agua de los elementales marinos y los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Hipnoviento, que está cerca del embarcadero.‡Récupérez 6 Noyaux élémentaires d\'eau sur les Elémentaires marins et les Embruns le long de la Côte Oubliée de Féralas, et rapportez-les à Zorbin Poudrozieu, près du quai.‡从菲拉斯被遗忘的海岸那里的海元素和巨型海元素身上获取6块水元素核心，把它们交给码头附近的索尔宾·范达瑟。‡',
  }
},
[7727] = {
  {
    'Incendossauro? É de comer?‡Пламезавры? Ну и название...‡Incendosaurier? Was-auch-immer-Saurier?‡인센도사우루스라니 무슨...‡¿Incendosaurio? Loqueseasaurio más bien‡¿Incendosaurio? Loqueseasaurio más bien‡Incendosaures ? N\'importosaures, plutôt‡熏火龙‡燻火龍',
    nil,
    'Hansel Mão-pesada quer que você mate 20 Incendossauros.|n|nEles ocupam as poças dentro do Fosso de Lava. O Fosso de Lava fica no Caldeirão da Garganta Abrasadora.|n|nDepois de matar os Incendossauros, fale novamente com Hansel Mão-pesada na Garganta Abrasadora.‡По поручению Хансела Большерука убейте 20 пламезавров, обитающих в озерах лавы в Шлаковой Яме - это часть Котла в Тлеющем ущелье. |n|nПо выполнении задания вернитесь к Ханселу в Тлеющее ущелье.‡Hansel Bleihand möchte, dass Ihr 20 Incendosaurier tötet.|n|nDie Incendosaurier haben sich in den Lavabecken der Schlackengrube eingenistet. Ihr findet die Schlackengrube im Kessel der Sengenden Schlucht.|n|nSobald Ihr genug Incendosaurier getötet habt, kehrt zu Hansel Bleihand in der Sengenden Schlucht zurück.‡용광로에 있는 잿가루 채석장 안의 용암 지대를 점령하고 있는 인센도사우루스 20마리를 처치한 후, 이글거리는 협곡에 있는 한셀 헤비핸드에게 가야 합니다.‡Hansel Manospesadas quiere que mates 20 incendosaurios.|n|nSuelen estar en los estanques de lava de La Fosa de la Escoria. La Fosa de la Escoria está en La Caldera de La Garganta de Fuego. |n|nCuando hayas matado suficientes incendosaurios ve a ver a Hansel Manospesadas a La Garganta de Fuego.‡Hansel Manospesadas quiere que mates 20 incendosaurios.|n|nSuelen estar en los estanques de lava de La Fosa de la Escoria. La Fosa de la Escoria está en La Caldera de La Garganta de Fuego. |n|nCuando hayas matado suficientes incendosaurios ve a ver a Hansel Manospesadas a La Garganta de Fuego.‡Hansel Lourdemains veut que vous tuiez 20 Incendosaures.|n|nOn peut les trouver dans les bassins de lave de la Fosse aux scories, qui occupe une partie du Chaudron de la gorge des Vents brûlants.|n|nRetournez voir Hansel Lourdemains dans la gorge des Vents brûlants lorsque vous aurez tué suffisamment d\'Incendosaures.‡汉瑟尔·重拳让你去杀掉20个熏火龙。|n|n熏火龙侵占了熔渣之池中的那些岩浆池。熔渣之池就在灼热峡谷的大熔炉中。|n|n当你杀死足够数量的熏火龙后，就回去找汉瑟尔·重拳。‡漢瑟爾·重拳要你去殺掉20隻燻火龍。|n|n燻火龍侵佔了熔渣之池中的那些岩漿池。熔渣之池就在灼熱峽谷的大熔爐中。|n|n當你殺死足夠數量的燻火龍後，就回到灼熱峽谷找漢瑟爾·重拳。',
  }
},
[7728] = {
  {
    'OBJETOS ROUBADOS: Alcaraviz de Ferraria e Luneta do Espia‡УКРАДЕНО: фурма и подзорная труба наблюдателя‡GESTOHLEN: Schmiedewindform und ein Ausguckhandfernrohr‡도난품: 가열로 바람구멍 및 망꾼의 망원경‡OBJETOS ROBADOS: Tobera y catalejo‡OBJETOS ROBADOS: Tobera y catalejo‡OBJETS VOLES : Tuyère et longue-vue‡被盗：鼓风机和望远镜‡被盜:鼓風機和望遠鏡',
    nil,
    'Encontre e devolva o Alcaraviz de Ferraria e a Luneta do Espia ao Capataz Scrange na Garganta Abrasadora.|n|nA única informação que você tem sobre esses itens é a seguinte: com certeza foram roubados por anões Ferro Negro. O Alcaraviz de Ferraria é uma ferramenta usada por ferreiros e a Luneta do Espia é um aparelho de monitoramento inestimável para vigias. ‡Найдите и верните фурму и подзорную трубу наблюдателя надсмотрщику Скренджу в Тлеющем ущелье. Единственная известная информация: вещи были украдены дворфами Черного Железа. Подзорная труба является бесценным прибором для наблюдения, а фурма – незаменимым кузнечным инструментом.‡Sucht die Schmiedewindform und das Ausguckhandfernrohr. Bringt diese Gegenstände zu Zuchtmeister Skrange in der Sengenden Schlucht.|n|nDie einzigen Informationen die Ihr habt sind: Die Schmiedewindform ist ein Schmiedewerkzeug welches von Schmieden verwendet wird und das Ausguckhandfernrohr ist ein unverzichtbares Werkzeug für Spähposten.‡이글거리는 협곡에 있는 작업반장 스크랜지에게 가열로 바람구멍과 망꾼의 망원경을 찾아가져가야 합니다.|n|n이 물건들에 대해 가지고 있는 유일한 정보는 다음과 같습니다.|n|n검은무쇠 드워프들이 훔쳐간 것이 분명합니다.|n가열로 바람구멍은 대장장이들이 사용하는 대장 도구입니다.|n망꾼의 망원경은 망꾼들에게는 값으로 따질 수 없을 만큼 중요한 감시 도구입니다.‡Encuentra la tobera y el catalejo y llévaselos al capataz Scrange a La Garganta de Fuego. |n|nLo único que sabes es que fueron robados por enanos Hierro Negro. La tobera es una herramienta de herrero y el catalejo es un instrumento muy valioso para los oteadores.‡Encuentra la tobera y el catalejo y llévaselos al capataz Scrange a La Garganta de Fuego. |n|nLo único que sabes es que fueron robados por enanos Hierro Negro. La tobera es una herramienta de herrero y el catalejo es un instrumento muy valioso para los oteadores.‡Trouvez la Tuyère de forge et la Longue-vue du guetteur et rapportez-les au sous-chef Scrange dans la gorge des Vents brûlants.|n|nLes seules informations dont vous disposez sur ces objets sont les suivantes : ils ont été dérobés par les nains Sombrefer, la Tuyère de forge est un outil utilisé par les forgerons et la Longue-vue du guetteur est un outil de surveillance inestimable pour les guetteurs.‡找到冶炼鼓风机和侦查员的望远镜，把它们还给灼热峡谷的监工斯克兰格。|n|n你所知道的关于这些物品的惟一信息是：它们肯定是被黑铁矮人偷走的。冶炼鼓风机是铁匠用的锻造工具，侦查员的望远镜是侦查员所需的侦查工具。‡找到冶煉鼓風機和偵察員的望遠鏡，把它們還給灼熱峽谷的監工斯克蘭格。|n|n你所知道的關於這些物品的惟一資訊是:它們肯定是被黑鐵矮人偷走的。冶煉鼓風機是鐵匠用的鍛造工具，偵察員的望遠鏡是偵察員所需的偵察工具。',
  }
},
[7729] = {
  {
    'TEMOS VAGAS: desbancando a concorrência‡ВАКАНСИЯ: устранитель конкурентов‡STELLE ZU VERGEBEN: Erledige die Konkurrenz‡구인광고: 경쟁 선별‡OPORTUNIDAD LABORAL: Acabar con la competencia‡OPORTUNIDAD LABORAL: Acabar con la competencia‡OFFRE D\'EMPLOI : Réduire la concurrence‡工作机会：肃清竞争对手‡工作機會:肅清競爭對手',
    nil,
    'Mate 15 Capatazes Ferro Negro e 15 Feitores Ferro Negro. Depois, fale novamente com Capataz Scrange, na Garganta Abrasadora.‡Убейте 15 надсмотрщиков и 15 поработителей из клана Черного Железа. По выполнении задания вернитесь к десятнику Скренджу в Тлеющее ущелье.‡Tötet 15 Zuchtmeister der Dunkeleisenzwerge und 15 Sklavenhändler der Dunkeleisenzwerge. Kehrt zu Zuchtmeister Skrange in der sengenden Schlucht zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은무쇠 감독관 15명과 검은무쇠 노예상인 15명을 처치하고 임무를 완수한 후, 이글거리는 협곡에 있는 작업반장 스크랜지에게 가야 합니다.‡Mata a 15 Capataces y 15 esclavistas Hierro Negro y ve a ver al capataz Scrange a La Garganta de Fuego.‡Mata a 15 Capataces y 15 esclavistas Hierro Negro y ve a ver al capataz Scrange a La Garganta de Fuego.‡Tuez 15 Sous-chefs Sombrefer et 15 Esclavagistes Sombrefer. Revenez voir le sous-chef Scrange dans la gorge des Vents brûlants quand vous aurez accompli cette tâche.‡杀死15个黑铁工头和15个黑铁奴隶贩子。完成任务之后就回去找监工斯克兰格。‡殺死15個黑鐵監工和15個黑鐵奴隸販子。完成任務之後就回去找監工斯克蘭格。',
  }
},
[7730] = {
  {
    'Infestação Zukk\'ash‡Нападение на улей Зукк\'аш‡Zukk\'ash-Plage‡주크애쉬 출몰‡Infestación de Zukk\'ash‡Infestación de Zukk\'ash‡Infestation de Zukk\'ash‡祖卡什的入侵‡',
    nil,
    'Traga 20 Carapaças de Zukk\'ash para Hadoken Passo Veloz na Aldeia Mojache, que fica em Feralas.‡Принесите 20 панцирей Зукк\'аш Хадокену Быстрому Страннику в Лагерь Мохаче в Фераласе.‡Bringt Hadoken Flinkschreiter im Camp Mojache in Feralas 20 Zukk\'ashknochenpanzer.‡페랄라스의 모자케 야영지에 있는 아도겐 스위프트스트라이더에게 주크애쉬 등껍질 20개를 가져가야 합니다.‡Lleva 20 caparazones Zukk\'ash a Hadoken Zanco Veloz al Campamento Mojache en Feralas.‡Lleva 20 caparazones Zukk\'ash a Hadoken Zanco Veloz al Campamento Mojache en Feralas.‡Rapportez 20 Carapaces de Zukk\'ash à Hadoken Rôdeur-agile au Camp Mojache en Féralas.‡把20块祖卡什虫壳交给菲拉斯莫沙彻营地的哈杜肯·迅蹄。‡',
  }
},
[7731] = {
  {
    'Cravaçoite‡Жалохвост‡Zornstachel‡채찍쐐기‡Latigador con aguijón‡Latigador con aguijón‡Fouet-cuisant‡毒刺鞭笞者‡毒刺鞭笞者',
    nil,
    'Derrote Cravaçoite na Profundeza Atormentada, leve as glândulas para Hadoken Passo Veloz na Aldeia Mojache, que fica em Feralas.‡Убейте жалохвоста в Гудящей Бездне и принести железы ядохлеста Хадокену Быстрому Страннику в Лагерь Мохаче в Фераласе.‡Besiegt Zornstachel in der Gewundenen Tiefe und bringt seine Drüsen zu Hadoken Flinkschreiter im Camp Mojache in Feralas zurück.‡고통의 구덩이에서 채찍쐐기를 물리치고 페랄라스의 모자케 야영지에 있는 아도겐 스위프트스트라이더에게 분비선을 가져가야 합니다.‡Derrota al latigador con aguijón en Las Galerías Retorcidas y lleva sus glándulas a Hadoken Zanco Veloz al Campamento Mojache en Feralas.‡Derrota al latigador con aguijón en Las Galerías Retorcidas y lleva sus glándulas a Hadoken Zanco Veloz al Campamento Mojache en Feralas.‡Battez Fouet-cuisant dans le Gouffre Grouillant et rapportez ses glandes à Hadoken Rôdeur-agile au Camp Mojache en Féralas.‡击败痛苦深渊中的毒刺鞭笞者，把它的腺体交给菲拉斯莫沙彻营地的哈杜肯·迅蹄。‡',
  }
},
[7732] = {
  {
    '‡Донесение об улье Зукк\'аш‡Bericht über die Zukk\'ash‡‡El informe Zukk\'ash‡El informe Zukk\'ash‡Le rapport sur les Zukk\'ash‡祖卡什报告‡',
    nil,
    '‡Доставьте отчет о нашествии насекомых-Зукк\'аш на Лагерь Мохаче Зилзибину Барабанному Бою, который проживает на Волоке в Оргриммаре.‡Bringt den Bericht über die Zukk\'ash aus Camp Mojache zu Zilzibin Tomtom. Er wohnt in der Gasse von Orgrimmar.‡‡Entrega a Zilzibin Tambor Sabio el informe del campamento Mojache Zukk\'ash. Reside en La Calle Mayor de Orgrimmar.‡Entrega a Zilzibin Tambor Sabio el informe del campamento Mojache Zukk\'ash. Reside en La Calle Mayor de Orgrimmar.‡Apportez le rapport sur les Zukk\'ash du Camp Mojache à Zilzibin Kongadok. Il réside à la Herse d\'Orgrimmar.‡把莫沙彻营地祖卡什报告交给奥格瑞玛暗巷区的基尔兹宾·鼓眼。‡',
  }
},
[7733] = {
  {
    'Melhoria de qualidade‡Борьба за качество‡Beste Qualität‡품질 향상‡Calidad mejorada‡Calidad mejorada‡Qualité améliorée‡更高的品质‡更高的品質',
    nil,
    'Leve 10 Pelegos de Yeti Cortifúria para Pradal McGrubben no Domínio de Plumaluna, em Feralas.‡Принесите 10 шкур йети из пещеры Бешеного оврага Пратту Макгруббену в Крепость Оперенной Луны в Фераласе.‡Bringt Pratt McGrubben in der Mondfederfeste in Feralas 10 Wutschrammyetibälge.‡페랄라스의 페더문 요새에 있는 프랫 맥그루벤에게 무쇠설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos de yeti Cicatriz de Rabia a Pratt McGrubben al Bastión Plumaluna en Feralas.‡Lleva 10 pellejos de yeti Cicatriz de Rabia a Pratt McGrubben al Bastión Plumaluna en Feralas.‡Fournir 10 Peaux de yéti griffe féroce à Pratt McGrubben au bastion de Pennelune, en Féralas.‡把10块怒痕雪人的毛皮交给菲拉斯羽月要塞的普拉特·马克格鲁比。‡把10塊怒痕雪人的毛皮交給菲拉斯羽月要塞的普拉特·馬克格魯比。',
  }
},
[7734] = {
  {
    'Melhoria de qualidade‡Борьба за качество‡Beste Qualität‡품질 향상‡Calidad mejorada‡Calidad mejorada‡Qualité améliorée‡更高的品质‡更高的品質',
    nil,
    'Leve 10 Pelegos de Yeti Cortifúria para Jangdor Passo Veloz na Aldeia Mojache, em Feralas.‡Принесите 10 шкур йети из пещеры Бешеного оврага Джангору Быстрому Страннику в Лагерь Мохаче в Фераласе.‡Bringt Jangdor Flinkschreiter im Camp Mojache in Feralas 10 Wutschrammyetibälge.‡페랄라스의 모자케 야영지에 있는 장도르 스위프트스트라이더에게 무쇠설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos de yeti Cicatriz de Rabia a Jangdor Zanco Veloz al Campamento Mojache de Feralas.‡Lleva 10 pellejos de yeti Cicatriz de Rabia a Jangdor Zanco Veloz al Campamento Mojache de Feralas.‡Fournir 10 Peaux de yéti griffe féroce à Jangdor Rôdeur-agile au Camp Mojache, en Féralas.‡把10块怒痕雪人的毛皮交给菲拉斯莫沙彻营地的杉多尔·迅蹄。‡把10塊怒痕雪人的毛皮交給菲拉斯莫沙徹營地的杉多爾·迅蹄。',
  }
},
[7735] = {
  {
    '‡Безупречная шкура йети‡Makelloser Yetibalg‡온전한 설인 가죽‡Pellejo de yeti prístino‡Pellejo de yeti prístino‡Peau de yéti en parfait état‡原始雪人毛皮‡原始雪人毛皮',
    nil,
    '‡Отнесите безупречную шкуру йети Пратту Макгруббену в Крепость Оперенной Луны в Фераласе.‡Bringt Pratt McGrubben in der Mondfederfeste den makellosen Yetibalg.‡페랄라스의 페더문 요새에 있는 프랫 맥그루벤에게 온전한 설인 가죽을 가져가야 합니다.‡Lleva el pellejo de yeti prístino a Pratt McGrubben al Bastión Plumaluna de Feralas.‡Lleva el pellejo de yeti prístino a Pratt McGrubben al Bastión Plumaluna de Feralas.‡Apportez la Peau de yéti en parfait état à Pratt McGrubben au bastion de Pennelune, en Féralas.‡把原始雪人毛皮交给菲拉斯羽月要塞的普拉特·马克格鲁比。‡',
  }
},
[7736] = {
  {
    '‡Пополнение запасов огненного плавня – королевская кровь‡Nachschub an feurigem Fluxus: Königsblut‡‡Fabricar flujo ígneo con sangrerregia‡Fabricar flujo ígneo con sangrerregia‡Le réapprovisionnement en flux embrasé (Sang-royal)‡炽热助熔剂的补给：皇血草‡',
    nil,
    '‡‡‡‡‡‡‡向史密斯·伯宁纳特大师交付2个熏火龙鳞片，4个皇血草和1个煤块。‡',
  }
},
[7737] = {
  {
    'Conquistando ainda mais confiança‡Завоевать еще большую благосклонность‡Noch mehr Anerkennung erlangen‡훨씬 더 인정받기‡Conseguir más aceptación‡Conseguir más aceptación‡Se faire encore mieux accepter‡获得更多信任‡獲得更多的信任',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[7738] = {
  {
    '‡Совершенная шкура йети‡Perfekter Yetibalg‡완전한 설인 가죽‡Pellejo de yeti perfecto‡Pellejo de yeti perfecto‡Peau de yéti parfaite‡完美的雪人毛皮‡完美的雪人毛皮',
    nil,
    '‡Отнесите безупречную шкуру йети Джангору Быстрому Страннику в Лагерь Мохаче в Фераласе.‡Bringt Jangdor Flinkschreiter im Camp Mojache in Feralas den perfekten Yetibalg.‡‡Lleva los pellejos de yeti perfecto a Jangdor Zanco Veloz al Campamento Mojache de Feralas.‡Lleva los pellejos de yeti perfecto a Jangdor Zanco Veloz al Campamento Mojache de Feralas.‡Apportez la Peau de yéti parfaite à Jangdor Rôdeur-agile au Camp Mojache, en Féralas.‡把完美的雪人毛皮交给菲拉斯莫沙彻营地的杉多尔·迅蹄。‡',
  }
},
[7741] = {
  {
    '‡Похвала Изумрудного Круга <NYI> <TXT>‡Lob des Smaragdkreises <NYI> <TXT>‡‡Elogios del Círculo Esmeralda <NYI> <TXT>‡Elogios del Círculo Esmeralda <NYI> <TXT>‡‡‡',
