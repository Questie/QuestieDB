    nil,
  }
},
[25072] = {
  {
    'Alguns bons goblins‡Несколько хороших гоблинов‡Eine Frage der Goblinehre‡소수 정예 고블린‡Algunos goblins buenos‡Algunos goblins buenos‡Quelques bons gobelins‡好地精寥寥‡一些好哥布林',
    nil,
    'Salve 8 Goblins Coletores de Insetos Capturados de dentro dos Casulos Hazzali.‡Освободите из коконов Хаззали 8 пленных гоблинов – охотников на жуков.‡Rettet 8 gefangene Goblinkäferjäger aus den Kokons der Hazzali.‡하잘리 고치에서 사로잡힌 고블린 벌레사냥꾼 8명을 구출해야 합니다.‡Salva de los capullos Hazzali a 8 cazabichos goblins capturados.‡Salva de los capullos Hazzali a 8 cazabichos goblins capturados.‡Libérez 8 Chasseurs d’insectes gobelins capturés dans des Cocons hazzali.‡从哈扎里虫茧中解救8名被俘的地精昆虫学者。‡從哈札里蟲繭中救出8個被俘虜的捕蟲者。',
  }
},
[25073] = {
  {
    'Aldeia Sen\'jin‡Деревня Сен\'джин‡Sen\'jin‡센진 마을‡El Poblado Sen\'jin‡El Poblado Sen\'jin‡Le village de Sen\'jin‡森金村‡森金村',
    nil,
    'Apresente-se ao Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Meldet Euch bei Meister Gadrin in Sen\'jin.‡센진 마을에 있는 장로 가드린에게 보고해야 합니다.‡Preséntate ante el maestro Gadrin en el Poblado Sen\'jin.‡Preséntate ante el maestro Gadrin en el Poblado Sen\'jin.‡Présentez-vous à Maître Gadrin au Village de Sen\'jin.‡向森金村的加德林大师报到。‡到森金村向加德林大師回報。',
  }
},
[25074] = {
  {
    'Encontre-me no Forte Triunfo‡Встретимся в Форте Триумфа‡Bei Triumph sehen wir uns wieder‡승전을 위한 발걸음‡Reúnete conmigo en Triunfo‡Reúnete conmigo en Triunfo‡Rendez-vous à Fort-Triomphe‡在凯旋壁垒碰头‡在凱旋堡壘和我碰面',
    nil,
    'Apresente-se ao Comandante Roberts no Forte Triunfo, que fica nos Sertões Meridionais.‡Доложитесь командиру Робертсу в Форте Триумфа в Южных Степях.‡Meldet Euch bei Kommandant Roberts in der Triumphfeste im Südlichen Brachland.‡남부 불모의 땅, 승전의 요새에 있는 사령관 로버츠에게 보고해야 합니다.‡Preséntate ante el comandante Roberts en Fuerte Triunfo en Los Baldíos del Sur.‡Preséntate ante el comandante Roberts en Fuerte Triunfo en Los Baldíos del Sur.‡Faites votre rapport au Commandant Roberts à Fort-Triomphe, dans les Tarides du Sud.‡去找贫瘠之地凯旋壁垒的指挥官罗伯兹。‡到南貧瘠之地的凱旋堡壘向指揮官羅伯茲回報。',
  }
},
[25075] = {
  {
    'Peça e receberá peças‡Сбор деталей‡Teilejagd‡부품 수거‡Por aquí y por allá‡Por aquí y por allá‡Ferrailleur en herbe‡淘零件‡撿零件',
    nil,
    'Colete 8 pedaços de Sucata da Máquina de Cerco na Chaga de Guerra, que fica nos Sertões Meridionais.‡Соберите 8 фрагментов осадных машин в Боевом Шраме в Южных Степях.‡Sammelt 8 Teile Belagerungsmaschinenschrott in der Kriegsnarbe im Südlichen Brachland auf.‡남부 불모의 땅, 전투의 흉터에서 공성 전차 고철조각 8개를 모아야 합니다.‡Recoge 8 piezas de chatarra de máquina de asedio de Marca de Guerra en Los Baldíos del Sur.‡Recoge 8 piezas de chatarra de máquina de asedio de Marca de Guerra en Los Baldíos del Sur.‡Récoltez 8 Débris d’engin de siège dans la Balafre, dans les Tarides du Sud.‡在南贫瘠之地的战斗之痕中收集8块攻城坦克废料。‡從南貧瘠之地的戰痕取回8個攻城機具碎塊。',
  }
},
[25076] = {
  {
    '‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡',
    nil,
    '‡Приручите сумеречницу-вампира при помощи хлыста приручения.‡Benutzt die Zähmerrute, um Euch mit einem Vampirnachtsauger anzufreunden.‡‡Usa la fusta de doma para domesticar a un murciumbrío vampírico.‡‡Utilisez le Bâtonnet de domptage pour apprivoiser une Chauve-souris de la pénombre vampirique.‡‡',
  }
},
[25077] = {
  {
    '‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡',
    nil,
    '‡Используйте хлыст приручения, чтобы подружиться с зачумленным мишкой.‡Benutzt die Zähmerrute, um Euch mit einem verseuchten Meister Petz anzufreunden.‡‡Usa la fusta de doma para domesticar a un oso pardusco apestado.‡‡Utilisez le Bâtonnet de domptage pour apprivoiser un Ours kodiak pestiféré.‡‡',
  }
},
[25078] = {
  {
    '‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡',
    nil,
    '‡Приручите злобного ночного кругопряда при помощи хлыста приручения.‡Benutzt die Zähmerrute, um Euch mit einem heimtückischen Nachtweber anzufreunden.‡‡Usa la fusta de doma para domesticar a una nocturácnida sañosa.‡‡Utilisez le Bâtonnet de domptage pour apprivoiser une Tisse-nuit vicieuse.‡‡',
  }
},
[25079] = {
  {
    'Qual é o pó?‡Игры с порохом‡Pulverspielchen‡가루 놀이‡Jugando con pólvora‡Jugando con pólvora‡Pénurie de poudre‡玩火药‡火藥秀',
    nil,
    'Derrote um Especialista Sapador perto da Chaga de Guerra e consiga um Barril de Pólvora K-Pou.‡Победите специалиста по минированию возле Боевого Шрама и отберите у него бочонок взрывчатой смеси М04И-8СЕХ.‡Besiegt einen Pionierspezialisten in der Nähe der Kriegsnarbe und bringt ein Fass mit Spreng-und-Weg-Pulver an Euch.‡전투의 흉터 근처에 있는 기술 공병을 처치하고 폭발 가루통을 획득해야 합니다.‡Acaba con un zapador especialista cerca de Marca de Guerra y consigue un barril de polvo-de-bum.‡Acaba con un zapador especialista cerca de Marca de Guerra y consigue un barril de polvo-de-bum. ‡Tuez un sapeur spécialiste près de la Balafre et récupérez un Baril de poudre X-ploz.‡在战斗之痕附近击败一名专家级工兵，然后弄一桶烈性火药回来。‡在戰痕附近打倒一個工兵專家並取得一小桶的強力火藥桶。',
  }
},
[25080] = {
  {
    'Pilhas não inclusas‡Батарейки в комплект не входят‡Batterien nicht eingeschlossen‡동력원만 장착하면...‡Pilas no incluidas‡Pilas no incluidas‡Piles non encore incluses‡本品暂不包含电池‡電池還沒算進去',
    nil,
    'Consiga uma Eletromoela Zumbidora de um Cabeça-de-trovão, nos Sertões Meridionais.‡Убейте громоголова в Южных Степях и достаньте гудящую электрогизаторную железу.‡Besorgt einen summenden Elektromagen von einem Donnerkopf im Südliches Brachland.‡남부 불모의 땅에 있는 천둥뿔도마뱀을 잡아 윙윙거리는 전기모래주머니를 구해야 합니다.‡Consigue una electromolleja zumbante de un tronatesta en Los Baldíos del Sur.‡Consigue una electromolleja zumbante de un tronatesta en Los Baldíos del Sur.‡Récupérez un Électrogésier vrombissant sur un Tête-tonnerre des Tarides du Sud.‡从南贫瘠之地的雷霆蜥蜴身上弄到一个嗡嗡作响的电囊。‡在南貧瘠之地從雷首蜥蜴身上取得一個嗡嗡作響的電囊。',
  }
},
[25081] = {
  {
    'Conquiste a Chaga de Guerra‡Захватить Боевой Шрам‡Anspruch auf die Kriegsnarbe erheben‡전투의 흉터 쟁탈전‡Reclamar Marca de Guerra‡Reclamar Marca de Guerra‡La revendication de la Balafre‡占领战斗之痕‡奪下戰痕',
    nil,
    'Vá para a Chaga de Guerra. Procure a bandeira marcadora e mate 10 Saqueadores do Forte Desolação.|n|nCapturar a bandeira dará vantagem em combate para todos os jogadores da Aliança na Chaga.‡Отправляйтесь в Боевой Шрам. Найдите флаг и убейте 10 налетчиков Крепости Отчаяния.|n|nЗахват флага даст преимущество в бою всем игрокам Альянса, находящимся в Боевом Шраме.‡Geht zu der Kriegsnarbe. Findet die Flagge und tötet 10 Ödnisräuber|n|nDie Flagge einzunehmen wird allen Allianzspielern in der Narbe einen Vorteil im Kampf gewähren.‡전투의 흉터로 가서 깃발 주변을 정찰하고 황폐의 요새 침략자 10명을 처치해야 합니다.|n|n깃발을 차지하면 전투의 흉터에 있는 모든 얼라이언스 플레이어가 강화 효과를 받습니다.‡Ve a Marca de Guerra. Encuentra las banderas y mata a 10 asaltantes de la Desolación.|n|nCapturar las banderas otorgará a los jugadores de la Alianza una ventaja en el combate en la grieta.‡Ve a Marca de Guerra. Encuentra las banderas y mata a 10 asaltantes de la Desolación.|n|nCapturar las banderas otorgará a los jugadores de la Alianza una ventaja en el combate en la grieta.‡Rendez-vous à la Balafre. Trouvez le drapeau et tuez 10 Écumeurs de la Désolation.|n|nLa capture du drapeau donnera un avantage à tous les joueurs de l’Alliance dans la Balafre.‡前往战斗之痕。找到旗帜并干掉10名凄凉袭击者。|n|n夺取旗帜会让联盟玩家在战斗之痕中获得战场上的优势。‡前往戰痕。找到旗竿標示並殺死10名淒涼的劫掠者。|n|n奪下旗竿將為所有位於戰痕的聯盟玩家帶來戰鬥上的優勢。',
  }
},
[25082] = {
  {
    'Fogo no buraco‡Выкурить жуков‡Die Käfer beseitigen‡벌레 소탕‡Tapando agujeros‡Tapando agujeros‡Au menu ce soir : friture d\'insectes‡解决虫害‡找出蟲來',
    nil,
    'Use o Balde de Piche Ardente nos morros de silitídeos perto do Forte Triunfo para expulsar e matar 10 Enxameadores Silitídeos.‡Вылейте ведро пылающей смолы на жилища силитидов за воротами Форта Триумфа, чтобы заставить силитидов уйти. Убейте 10 членистоногов силитида.‡Wendet den Eimer mit brennendem Pech auf Silithidenhügel außerhalb der Triumphfeste an und tötet 10 Silithidschwärmer, wenn sie herauskommen.‡승전의 요새 바깥에 있는 실리시드 흙더미에 불타는 기름찌끼 양동이를 사용하고 올라오는 우두머리 실리시드 10마리를 처치해야 합니다.‡Utiliza el cubo de brea ardiente sobre los montículos de silítidos del exterior de Fuerte Triunfo para hacer salir y matar a 10 enjambristas silítidos.‡Utiliza el cubo de brea ardiente sobre los montículos de silítidos del exterior de Fuerte Triunfo para hacer salir y matar a 10 enjambristas silítidos.‡Utilisez le Seau de poix ardente sur les Antres des silithides autour de Fort-Triomphe pour en faire sortir 10 Grouillants silithides et les tuer.‡用一桶燃烧着的沥青倒在凯旋壁垒外面的异种蝎土丘上，然后杀掉10只被烧出来的异种群居蝎。‡在凱旋堡壘外面的異種蠍土丘使用一桶燃燒的瀝青，殺死10隻被趕出來的異種群居蠍。',
  }
},
[25083] = {
  {
    '‡Дрессировка‡Bestienausbildung‡‡Doma de bestias‡Doma de bestias‡La formation de dresseur‡‡',
    nil,
    '‡Поговорите с Аполием в Квартале Воинов в Подгороде.‡Sprecht mit Apolos im Kriegsviertel von Unterstadt.‡‡Habla con Apolo en el Barrio de la Guerra en Entrañas.‡‡Parlez à Apolos dans le Quartier de la Guerre à Fossoyeuse.‡‡',
  }
},
[25084] = {
  {
    'Ameaça crescente‡Растущая угроза‡Wachsende Bedrohung‡커져가는 위협‡Amenaza creciente‡Amenaza creciente‡Une menace grandissante‡增长的威胁‡崛起的威脅',
    nil,
    'Mate 13 Javatuscos Crinavalha.‡Убейте 13 свинобразов из племени Иглогривых.‡Tötet 13 Stacheleber der Klingenmähnen.‡서슬갈기 가시멧돼지 13마리를 처치해야 합니다.‡Mata a 13 jabaespines Crines de Acero.‡Mata a 13 jabaespines Crines de Acero.‡Tuez 13 Hurans tranchecrins.‡杀掉13头钢鬃野猪人。‡殺死13名剃鬃野豬人。',
  }
},
[25085] = {
  {
    'Denterroto‡Кривозуб‡Quetschzahn‡뻐드렁니‡Quebrantadientes‡Quebrantadientes‡Mutiledent‡碎牙‡碎牙',
    nil,
    'Mate Denterroto.‡Убейте Кривозуба.‡Tötet Quetschzahn.‡뻐드렁니를 처치해야 합니다.‡Mata a Quebrantadientes.‡Mata a Quebrantadientes.‡Tuez Mutiledent.‡杀死碎牙。‡殺死碎牙。',
  }
},
[25086] = {
  {
    'Posto Pedra de Fogo‡Кремневый лагерь‡Flammensteinspitze‡화염석 거점‡Punta Piedra de Fuego‡Punta Piedra de Fuego‡La halte de Pierre-feu‡火石岗哨‡火石崗哨',
    nil,
    'Encontre Dorn Rubraterra no Posto Pedra de Fogo, que fica nos Sertões Meridionais.‡Найдите Дорна Краснозема в Кремневом лагере в Южных Степях.‡Sucht nach Dorn Roterde an der Flammensteinspitze im Südlichen Brachland.‡남부 불모의 땅, 화염석 거점에 있는 도른 레드어스를 찾아야 합니다.‡Busca a Dorn Tierra Roja en Punta Piedra de Fuego en Los Baldíos del Sur.‡Busca a Dorn Tierra Roja en Punta Piedra de Fuego en Los Baldíos del Sur.‡Allez trouver Dorn Terre-rouge à la Halte de Pierre-feu dans les Tarides du Sud.‡去南贫瘠之地的火石岗哨寻找多恩·红土。‡在南貧瘠之地的火石崗哨找到多恩‧紅土。',
  }
},
[25087] = {
  {
    'Apresente-se a Duas-tranças‡Доклад Двукоссе‡Meldet Euch bei Doppelzopf‡트윈브레이드에게 보고‡Informa a Trenzado‡Informa a Trenzado‡Rapport à Doublenattes‡向双辫将军汇报‡向塔文布萊德回報',
    nil,
    'Entregue o Relatório das Linhas de Frente ao General Duas-tranças, que está patrulhando os Sertões Meridionais.‡Отнесите отчет с передовой генералу Двукоссе, который патрулирует Южные Степи.‡Liefert den Bericht von der Front bei General Doppelzopf ab, der im Südlichen Brachland auf Patrouille ist.‡남부 불모의 땅을 순찰하는 장군 트윈브레이드에게 최전방 보고서를 전달해야 합니다.‡Entrega el informe del frente al general Trenzado que está patrullando por Los Baldíos del Sur.‡Entrega el informe del frente al general Trenzado que está patrullando por Los Baldíos del Sur.‡Apportez le Rapport du front au Général Doublenattes, qui patrouille dans les Tarides du Sud.‡将前线战报送给双辫将军，他正在南贫瘠之地巡逻。‡將前線報告送給正在南貧瘠之地巡邏的塔文布萊德將軍。',
  }
},
[25089] = {
  {
    'Além das tumbas‡По ту сторону могилы‡Nach den Gräbern‡무덤 밖으로‡Más allá de las tumbas‡Más allá de las tumbas‡Outre-tombe‡走出墓穴‡墓地之外',
    nil,
    'Fale com o Necroguarda Saulo em Plangemortis, nas Clareiras de Tirisfal.‡Поговорите со стражем смерти Салтеном в Похоронном Звоне в Тирисфальских лесах.‡Sprecht mit Todeswache Saltain in Todesend in Tirisfal.‡티리스팔 숲의 죽음의 종소리 마을에 있는 죽음경비병 살테인과 대화해야 합니다.‡Habla con el guardia de la Muerte Saltain en Camposanto, en los Claros de Tirisfal.‡Habla con el guardia de la Muerte Saltain en Camposanto, en los Claros de Tirisfal.‡Parlez au Nécrogarde Saltain au Glas, dans les Clairières de Tirisfal.‡与提瑞斯法林地丧钟镇的亡灵卫兵萨尔坦交谈。‡到提里斯法林地的喪鐘鎮和亡靈守衛薩爾坦談談。',
  }
},
[25090] = {
  {
    'Uma tarefa podre‡Грязная работа‡Eine eitrige Aufgabe‡더러운 임무‡Una tarea pútrida‡Una tarea pútrida‡Une tâche putride‡腐烂的爪子‡腐爛的爪子',
    nil,
    'Traga 7 Garras Pútridas para o Necroguarda Dinis no Casarão Lar Glacial.‡Принесите 7 гнилых когтей стражу смерти Диллинжеру в поместье "Остывший Очаг".‡Bringt 7 eitrige Klauen zu Todeswache Dillinger auf dem Verlassenen Anwesen.‡버려진 장원에 있는 죽음경비병 딜링거에게 부패한 발톱 7개를 가져가야 합니다.‡Entrega 7 garras podridas al guardia de la Muerte Dillinger en la Mansión Fríogar.‡Entrega 7 garras podridas al guardia de la Muerte Dillinger en la Mansión Fríogar.‡Rapporter 7 Griffes putrides au Nécrogarde Dillinger au Manoir du Foyer froid.‡给炉灰庄园的亡灵卫兵迪林格尔带回7只腐烂的爪子。‡將7個腐爛的爪子帶給爐灰莊園的亡靈守衛迪林格爾。',
  }
},
[25091] = {
  {
    'Posto Silitriste‡Застава Скорбных песков‡Sandmarterwache‡슬픈모래 감시탑‡Vigía Penas de Arena‡Vigía Penas de Arena‡Le guet de Tristesable‡流沙岗哨‡流沙崗哨',
    nil,
    'Fale com Trenton Lumartelo no Posto Silitriste.‡Поговорите с Трентоном Молотом Света на Заставе Скорбных песков.‡Sprecht mit Trenton Lichthammer in Sandmarterwache.‡슬픈모래 감시탑에 있는 트렌튼 라이트해머와 대화해야 합니다.‡Habla con Trenton Mazaligera en Vigía Penas de Arena.‡Habla con Trenton Mazaligera en Vigía Penas de Arena.‡Allez voir Trenton Martelume au Guet de Tristesable.‡跟流沙岗哨的特伦顿·轻锤谈一谈。‡到流沙崗哨找特倫頓·輕錘說話。',
  }
},
[25092] = {
  {
    '‡Усмирение стихий‡Die Elemente kontrollieren‡정령 진압‡Subyugando a los elementos‡Subyugando a los elementos‡Élémentaire, mon cher…‡制伏元素‡',
    nil,
    '‡Провидица Бахура хочет, чтобы с помощью сапты стихий и тотема очищения из припасов Служителей Земли вы усмирили 20 потревоженных духов огня.‡Seherin Bahura möchte, dass Ihr das Elementarsapta und das Läuterungstotem aus der Tasche mit den Vorräten des Irdenen Rings benutzt, um 20 aufgebrachte Feuergeister unter Kontrolle zu bringen.‡현자 바후라가 대지 고리회 보급품에 있는 정령의 정기와 정화 토템을 이용해 흥분한 불의 정령 20마리를 진압해 달라고 했습니다.‡La vidente Bahura quiere que utilices la sapta elemental y el tótem de limpieza suministrados por el Anillo de la Tierra para subyugar a 20 espíritus de fuego perturbados.‡‡Le Voyant Bahura veut que vous utilisiez le sapta élémentaire et le totem de purification du sac de fournitures du Cercle terrestre pour soumettre 20 Esprits de la terre agités.‡先知巴胡拉要你使用大地之环补给品中的元素灵契和净化图腾，制服20个激动的火焰之魂。‡',
  }
},
[25093] = {
  {
    'As cabeças dos cabeças‡Обезглавить ШРУ‡Die Köpfe des SI:7‡SI:7 수뇌부‡Los comandantes del IV:7‡Los comandantes de la IV:7‡Les chefs du SI:7‡军情七处的头目们‡軍情七處的頭頭',
    nil,
    'Pegue as cabeças do Comandante Arrington, de Laminegra Cyn e Alexi Uivaquieto.‡Убейте командира Арингтона, Цин Черный Клинок и Алексия Тихого Воя и отрежьте им головы.‡Sammelt die Köpfe von Kommandant Arrington, Dunkelklinge Cyn und Alexi Stummheuler.‡사령관 아링턴, 검은칼날 신, 알렉시 사일런트하울의 머리카락을 모아야 합니다.‡Consigue las cabezas del comandante Arrington, de Cyn Filoscuro y de Alexi Aullido Silencioso.‡Consigue las cabezas del comandante Arrington, de Cyn Filoscuro y de Alexi Aullido Silencioso.‡Récupérez les Têtes du Commandant Arrington, du sombrelame Cyn et d\'Alexi Grondesilence.‡取得指挥官亚林登、黑刃希恩和阿莱克西·默嚎的徽记。‡取得指揮官阿靈頓、暗刃莘茵、阿萊克斯·靜嚎的頭顱。',
  }
},
[25094] = {
  {
    'Cúpula do Trovão: Zumonga!‡Громодром: Зумонга!‡Donnerkuppel: Zumonga!‡천둥경기장: 주몽가!‡Truenódromo: ¡Zumonga!‡Truenódromo: ¡Zumonga!‡Le dôme du Tonnerre : Zumonga !‡雷霆斗技场：祖蒙加！‡雷霆競技場:祖孟迦!',
    nil,
    'Derrote Zumonga.‡Победите в бою Зумонгу.‡Besiegt Zumonga.‡주몽가를 처치해야 합니다.‡Derrota a Zumonga.‡Derrota a Zumonga.‡Tuez Zumonga.‡击败祖蒙加。‡擊敗祖孟迦。',
  }
},
[25095] = {
  {
    'Cúpula do Trovão: Sarinexx!‡Громодром: Саринекс!‡Donnerkuppel: Sarinexx!‡천둥경기장: 사리넥스!‡Truenódromo: ¡Sarinexx!‡Truenódromo: ¡Sarinexx!‡Le dôme du Tonnerre : Sarinexx !‡雷霆斗技场：萨里尼克斯！‡雷霆競技場:薩利尼克斯!',
    nil,
    'Derrote Sarinexx‡Победите в бою Саринекса.‡Besiegt Sarinexx.‡사리넥스를 처치해야 합니다.‡Derrota a Sarinexx.‡Derrota a Sarinexx.‡Tuez Sarinexx.‡击败萨里尼克斯。‡擊敗薩利尼克斯。',
  }
},
[25096] = {
  {
    '‡Громодром: Принц Мош!‡Donnerkuppel: Prinz Mosh!‡‡Truenódromo: ¡Príncipe Mosh!‡‡Le dôme du Tonnerre : le prince Mosh !‡‡',
    nil,
    '‡Одержите победу над принцем Мошем.‡Besiegt Prinz Mosh.‡‡Derrota al Príncipe Mosh.‡‡Tuez le Prince Mosh.‡‡',
  }
},
[25097] = {
  {
    '‡Тут такое дело…‡Eine kleine Aufgabe‡작은 일거리‡Pequeño detalle‡‡Un ch\'tit quek-chose‡小事‡',
    nil,
    '‡Поговорите с Верном Всякоштукинсом в Тысяче Игл по просьбе Драззита Кранотека.‡Drazzit Tropfhahn möchte, dass Ihr mit Vern Basteldings in Tausend Nadeln sprecht.‡버섯구름 봉우리에 있는 베른 푸츠위젯과 대화해야 합니다.‡Drazzit Gotera quiere que hables con Vern Marchatrasto en Las Mil Agujas.‡‡Drazzit Suintevalve veut que vous parliez à Vern Futzrouage dans les Mille pointes.‡德拉兹特·迪普瓦尔要你跟千针石林的韦恩·法兹维吉谈一谈。‡',
  }
},
[25098] = {
  {
    'O Chefe Guerreiro precisa de você‡Вождь зовет!‡Der Kriegshäuptling braucht Euch‡대족장님께서 부르신다‡El Jefe de Guerra te reclama‡El Jefe de Guerra te reclama‡Le chef de guerre a besoin de vous‡觐见酋长‡大酋長要你',
    nil,
    'Fale com Thrall na Guarita do Chefe Guerreiro, que fica nas Ilhas Perdidas.‡Поговорите с Траллом на дозорном пункте вождя на Затерянных островах.‡Sprecht mit Thrall am Spähposten des Kriegshäuptlings auf den Verlorenen Inseln.‡잃어버린 섬의 대족장의 망루에 있는 스랄과 대화해야 합니다.‡Habla con Thrall en la Atalaya del Jefe de Guerra, en Las Islas Perdidas.‡Habla con Thrall en la Atalaya del Jefe de Guerra, en Las Islas Perdidas.‡Parlez à Thrall au Poste de guet du Chef de guerre, sur les Îles Perdues.‡跟失落群岛酋长瞭望台的萨尔谈一谈。‡在失落群島上的大酋長守望和索爾談話。',
  }
},
[25099] = {
  {
    'Carona na Bastia‡Одолжить Бастию‡Borgt Euch Bastia aus‡바스티아 빌리기‡Un préstamo bestial‡Un préstamo bestial‡Empruntez Bastia‡借巴斯蒂亚一用‡借用巴斯堤亞',
    nil,
    'Fale com Kilag Dilaceros na Costa da Bonança, que fica nas Ilhas Perdidas.‡Поговорите с Килагом Жутеклыком на Тихом берегу на Затерянных островах‡Sprecht mit Kilag Blutmaul an der Stillen Küste auf den Verlorenen Inseln.‡잃어버린 섬에 있는 평온의 해안에서 킬라그 고어팽과 대화해야 합니다.‡Habla con Kilag Mandisangre en Costa Tranquila, en Las Islas Perdidas.‡Habla con Kilag Mandisangre en Costa Tranquila, en Las Islas Perdidas.‡Parlez à Kilag Sangrecroc sur la Côte Tranquille, sur les Îles Perdues.‡跟失落群岛静谧湾岸的基拉格·血牙谈一谈。‡在失落群島上的寧靜海岸和奇拉格·血牙談話。',
  }
},
[25100] = {
  {
    'Vamos cavalgar‡Покатаемся?‡Aufsitzen!‡바스티아를 타고‡Vamos de paseo‡Vamos de paseo‡En route pour l\'aventure‡奔跑吧‡上路吧',
    nil,
    'Fale com Kika Furafundo na Cachoeira Celeste, que fica nas Ilhas Perdidas.‡Поговорите с Крадли Дротик у Небесного водопада на Затерянных островах.‡Sprecht mit Slinky Scharfklinge an den Himmelsfällen auf den Verlorenen Inseln.‡잃어버린 섬의 하늘 폭포에 있는 슬링키 샤프쉬브와 대화해야 합니다.‡Habla con Finta Navajazos en Cascadas del Cielo, en Las Islas Perdidas.‡Habla con Finta Navajazos en Cascadas del Cielo, en Las Islas Perdidas.‡Parlez à Fugace Coutelard aux Chutes du Ciel, sur les Îles Perdues.‡跟失落群岛天坠瀑布的史莉琪·剃刀谈一谈。‡在失落群島上的天空瀑布和史琳琪·利刀談話。',
  }
},
[25101] = {
  {
    '‡Друг моего друга‡Der Freund eines Freundes‡친구의 친구‡Un amigo de un amigo‡‡L\'ami d\'un ami‡朋友的朋友‡',
    nil,
    '‡Поговорите с Верном Всякоштукинсом в Тысяче Игл по просьбе Улыбки Джима.‡Lächelnder Jim möchte, dass Ihr mit Vern Basteldings in Tausend Nadeln sprecht.‡버섯구름 봉우리에 있는 베른 푸츠위젯과 대화해야 합니다.‡Jim Sonrisas quiere que hables con Vern Marchatrasto en Las Mil Agujas.‡‡Jim le Souriant veut que vous parliez à Vern Futzrouage dans les Mille pointes.‡微笑的吉姆要你跟千针石林的韦恩·法兹维吉谈一谈。‡',
  }
},
[25102] = {
  {
    'Passando o rodo no kodo‡Нет тяжелоногим кодо!‡Keine Bullen‡코도는 이제 그만‡¡Al toro!‡¡Al toro!‡Faire du tort aux taureaux‡驱赶巨兽‡無牛之地',
    nil,
    'Mate 4 Kodos Treme-terra e 1 Tsáurio Treme-terra nos Sertões Meridionais.‡Убейте 4 обычных тяжелоногих кодо и 1 самца тяжелоногого кодо в Южных Степях.‡Tötet 4 Landbeberkodos und 1 Landbeberbulle im Südlichen Brachland.‡남부 불모의 땅에 있는 대지격동코도 4마리와 대지격동코도 수컷 1마리를 처치해야 합니다.‡Mata a 4 kodos Sacudetierra y a un toro Sacudetierra.‡Mata a 4 kodos Sacudetierra y a un toro Sacudetierra.‡Tuez 4 Kodos vibreterre et 1 Mâle vibreterre dans les Tarides du Sud.‡在南贫瘠之地杀死4头震地科多兽和1头震地蛮兽。‡在南貧瘠之地殺死4隻科多獸顫地者以及1隻雄科多獸顫地者。',
  }
},
[25103] = {
  {
    'Vilarejo dos Falsários‡Стоянка бутлегеров‡Schmugglerposten‡밀조장이 전초기지‡Avanzada del Contrabandista‡Avanzada del Contrabandista‡L’avant-poste des Contrebandiers‡商旅哨站‡私酒商哨站',
    nil,
    'Fale com Zeke Borrabotas no Vilarejo dos Falsários.‡Поговорите с Зеке Волочилкинсом на стоянке бутлегеров.‡Sprecht mit Zeke Scheuerschuh am Schmugglerposten.‡밀조장이 전초기지에 있는 제크 부트스커프와 대화해야 합니다.‡Habla con Zeke Atabotas en la Avanzada del Contrabandista.‡Habla con Zeke Atabotas en la Avanzada del Contrabandista.‡Allez voir Zeke Traînebottes à l’Avant-poste des Contrebandiers.‡跟商旅哨站的泽克·磨靴谈一谈。‡到私酒商哨站找札克·靴磨說話。',
  }
},
[25104] = {
  {
    'O estado do sítio‡Состояние раскопок‡Zustand der Grabungsstätte‡발굴현장 상황‡El estado de la excavación‡El estado de la excavación‡Topo du site de fouilles‡挖掘场的情形‡挖掘場的狀況',
    nil,
    'Encontre Marley Duas-tranças perto do Sítio Arqueológico Bael Modan, que fica nos Sertões Meridionais.‡Найдите Марли Двукоссу за раскопками Бейл Модана в Южных Степях.‡Findet Marley Doppelzopf außerhalb der Ausgrabungsstätte von Bael Modan im Südlichen Brachland.‡남부 불모의 땅, 바엘 모단 발굴현장 외곽에 있는 말리 트윈브레이드를 찾아야 합니다.‡Localiza a Marley Trenzado fuera de la Excavación de Bael Modan en Los Baldíos del Sur.‡Localiza a Marley Trenzado fuera de la Excavación de Bael Modan en Los Baldíos del Sur.‡Trouvez Marley Doublenattes à l’extérieur de l’Excavation de Bael Modan, dans les Tarides du Sud.‡在南贫瘠之地的巴尔莫丹挖掘场外找到马尔雷·双辫。‡到南貧瘠之地的巴爾莫丹挖掘場外面找馬爾利‧塔文布萊德。',
  }
},
[25105] = {
  {
    'Nibbler! Não!‡Грызун! Только не это!‡Nibbler! Nein!‡야금치! 안 돼!‡¡Mordisquitos! ¡No!‡¡Mordisquitos! ¡No!‡Grignoteur ! Non !‡龅牙！不！‡啃咬者!不!',
    nil,
    'Lapide três Zefiritas Maciças e entregue-as a Isabel Jones em Ventobravo.‡Ограньте три цельных зефирита и отдайте их Изабели Джонс в Штормграде.‡Schleift drei gediegene Zephyrite und gebt sie Isabel Jones in Sturmwind.‡단단한 서풍석 3개를 세공해서 스톰윈드에 있는 이자벨 존스에게 전달해야 합니다.‡Talla tres cefiritas sólidas y dáselas a Isabel Jones en la Ciudad de Ventormenta.‡Talla tres cefiritas sólidas y dáselas a Isabel Jones en la Ciudad de Ventormenta.‡Taillez 3 Zéphyrites solides et donnez-les à Isabel Jones à Hurlevent.‡切割3颗致密泽菲蓝晶石，把它们交给暴风城的伊莎贝尔·琼斯。‡切出三顆堅固的西風石並送去暴風城給伊莎貝爾·瓊斯。',
  }
},
[25106] = {
  {
    'Pondo ordem na bagunça‡Руки прочь от моих раскопок!‡Hände weg von meiner Grabung!‡발굴현장을 지켜라!‡¡Quítame las manos de encima!‡¡Quítame las manos de encima!‡Touche pas à mon filon !‡考古成果属于我！‡把我挖的東西交出來!',
    nil,
    'Mate 8 Saqueadores de Escavações, resgate 5 Artefatos de Bael Modan e recupere as Ferramentas de Duas-tranças no Sítio Arqueológico Bael Modan.‡Убейте 8 налетчиков-землекопов, спасите 5 артефактов Бейл Модана и найдите инструменты Двукоссы на раскопках Бейл Модана.‡Tötet 8 Räuber der Ausgrabungsstätte, rettet 5 Artefakte aus Bael Modan und findet Doppelzopfs Werkzeuge in der Ausgrabungsstätte von Bael Modan.‡바엘 모단 발굴지에서 발굴현장 침략자 8명을 처치하고 바엘 모단 유물 5개를 모은 다음, 트윈브레이드의 도구를 찾아야 합니다.‡Mata a 8 asaltantes de excavación, rescata 5 artefactos de Bael Modan y consigue las herramientas de Trenzado en la Excavación de Bael\'modan.‡Mata a 8 asaltantes de excavación, rescata 5 artefactos de Bael Modan y consigue las herramientas de Trenzado en la Excavación de Bael\'modan.‡Tuez 8 Écumeurs d’excavation, récupérez 5 Artéfacts de Bael Modan et mettez la main sur les Outils de Doublenattes, au Site de fouilles de Bael Modan.‡进入巴尔莫丹挖掘场，杀死8名挖掘袭击者，取回5块巴尔莫丹圣物并找到双辫的工具。‡在巴爾莫丹挖掘場殺死8名挖掘場劫掠者，救回5件巴爾莫丹神器，並且取回塔文布萊德的工具。',
  }
},
[25107] = {
  {
    'A grande tabuleta‡Великая скрижаль‡Die große Tafel‡거대한 서판‡La gran tablilla‡La gran tablilla‡La grande tablette‡庄严的石板‡大石板',
    nil,
    'Leve a Grande Tabuleta para Andoren Alvorada.‡Принесите Великую скрижаль Андорену Восходу Солнца.‡Bringt die große Tafel zu Andoren Morgendunst.‡거대한 서판을 안도렌 돈라이즈에게 가져가야 합니다.‡Lleva la gran tablilla a Andoren Alzalba.‡Lleva la gran tablilla a Andoren Alzalba.‡Apportez la Grande tablette à Andoren Montelaube.‡将庄严的石板交给安多伦·晨光。‡將大石板帶去給安多連·曦揚。',
  }
},
[25108] = {
  {
    'Feegly, o Exilado‡Фиглай Изгнанник‡Feegly der Verbannte‡추방자 피글리‡Feegly el Exiliado‡Feegly el Exiliado‡Feegly l\'Exilé‡被流放的费格雷‡被流放的費格雷',
    nil,
    'Mate Feegly, o Exilado, no Sítio de Escavação de Bael Modan.‡Убейте Фиглая Изгнанника на раскопках Бейл Модана.‡Tötet Feegly den Verbannten in der Ausgrabungsstätte von Bael Modan.‡바엘 모단 발굴지에 있는 추방자 피글리를 처치해야 합니다.‡Mata a Feegly el Exiliado en la Excavación de Bael Modan.‡Mata a Feegly el Exiliado en la Excavación de Bael Modan.‡Tuez Feegly l\'Exilé au Site de fouilles de Bael Modan.‡杀死巴尔莫丹挖掘场中被流放的费格雷。‡在巴爾莫丹挖掘場殺死被流放的費格雷。',
  }
},
[25109] = {
  {
    'A mina de trabalhos forçados de Gallywix‡Исправительная шахта Галливикса‡Gallywix\' Fronmine‡갤리윅스 노동광산‡La Mina de Trabajos Forzados de Gallywix‡La Mina de Trabajos Forzados de Gallywix‡La mine de travail de Gallywix‡加里维克斯劳工矿井‡加里維克斯的勞工礦坑',
    nil,
    'Fale com a Assistente Grilly na Mina de Trabalhos Forçados de Gallywix, que fica nas Ilhas Perdidas.‡Поговорите с ассистенткой Грили в исправительной шахте Галливикса на Затерянных островах.‡Sprecht mit Assistentin Greely in Gallywix\' Fronmine auf den Verlorenen Inseln.‡잃어버린 섬의 갤리윅스 노동광산 안에서 조수 그릴리와 대화해야 합니다.‡Habla con la ayudante Greely en la Mina de Trabajos Forzados de Gallywix, en Las Islas Perdidas.‡Habla con la ayudante Greely en la Mina de Trabajos Forzados de Gallywix, en Las Islas Perdidas.‡Parlez à l\'Assistante Greely dans la Mine de travail de Gallywix, sur les Îles Perdues.‡跟失落群岛加里维克斯劳工矿井内的助手格瑞里谈一谈。‡和位於失落群島上加里維克斯的勞工礦坑內的助理格里利談談。',
  }
},
[25110] = {
  {
    'Jaka\'Cola te dá IDEIAS! (R)‡"Каджа-Кола" ОСЕНЯЕТ! (TM)‡Kaja\'Cola! Hier kommen die IDEEN (TM)‡생각이 번뜩입니다, 카자콜라!™‡¡La Kaja\'Cola te da IDEAS! (TM)‡¡La Kaja\'Cola te da IDEAS! (TM)‡Kaja\'Cola, ça vous donne des IDÉES ! (TM)‡卡亚可乐，给你灵感！(注册商标)‡卡迦可樂給你好靈感!(TM)',
    nil,
    'Pegue 1 Jaka\'Cola Zero-um.‡Добудьте 1 порцию "Каджа-Колы Полулайт".‡Sammelt 1 Kaja\'Cola minus eins.‡카자콜라 제로 1개를 구해야 합니다.‡Consigue una Kaja\'Cola Zero-Uno.‡Consigue una Kaja\'Cola Zero-Uno.‡Récupérez 1 Kaja\'Cola Zéro-Un.‡取回1罐卡亚零一度可乐。‡收集1罐卡迦可樂Zero-One。',
  }
},
[25111] = {
  {
    'Bancando o urubu‡Падальщики и падаль‡Wiederverwerter zur Wiederverwertung‡청소당한 청소부‡Carroña de carroñeros‡Carroña de carroñeros‡Roc n’ roll‡清扫食腐动物‡收拾拾荒者',
    nil,
    'Use o Robô-açougueiro para destrinchar os cadáveres de 12 Rocas de Fogo.‡Соберите "урожай" с трупов 12 огненных рухов.‡Benutzt den Schlächterbot, um 12 tote Feuerrocs auszuschlachten.‡도살로봇을 이용해 화염 로크 시체 12구를 모아와야 합니다.‡Usa el Robocarnicero para recoger 12 cadáveres de roc de fuego.‡Usa el Robocarnicero para recoger 12 cadáveres de roc de fuego.‡Utilisez le Robot-boucher pour ramasser 12 cadavres de Rocs de feu.‡使用收集机器人采集12具火鹏尸体。‡使用屠殺機器人拾取12個火鵬屍體。',
  }
},
[25112] = {
  {
    'Robô-açougueiro‡Мясорез‡Schlächterbot‡도살로봇‡Robocarnicero‡Robocarnicero‡Le robot-boucher‡收集机器人‡屠殺機器人',
    nil,
    'Use o Robô-açougueiro para destrinchar os cadáveres de 10 Basiliscos Silicouro.‡С помощью мясореза соберите добычу с 10 трупов стеклошкурых василисков.‡Benutzt den Schlächterbot, um 10 Kadaver von Glashautbasilisken auszuschlachten.‡도살로봇을 이용해 유리비늘 바실리스크 시체 10구를 모아와야 합니다.‡Usa el Robocarnicero para recoger 10 cadáveres de basiliscos Cristaldermo.‡Usa el Robocarnicero para recoger 10 cadáveres de basiliscos Cristaldermo.‡Utilisez le Robot-boucher pour ramasser 10 cadavres de Basilics peau-de-verre.‡使用收集机器人采集8具晶鳞蜥蜴尸体。‡使用屠殺機器人拾取10個晶鱗蜥蜴屍體。',
  }
},
[25115] = {
  {
    'Carnificina Patapústula‡Гиенобойня‡Eiterpfotenschlachtung‡문둥발하이에나 사냥‡Carnicería de Llagapata‡Carnicería de Llagapata‡Boucherie de brûlepattes‡疱爪肉贩‡屠殺皰爪土狼',
    nil,
    'Use o Robô-açougueiro para destrinchar os cadáveres de 10 Hienas Patapústula.‡С помощью мясореза соберите добычу с 10 трупов хромоногих гиен.‡Benutzt den Schlächterbot, um 10 Kadaver von Eiterpfotenhyänen auszuschlachten.‡도살로봇을 이용해 문둥발하이에나 시체 10구를 모아와야 합니다.‡Usa el Robocarnicero para reunir 10 cadáveres de hienas Llagapata.‡Usa el Robocarnicero para reunir 10 cadáveres de hienas Llagapata.‡Utilisez le Robot-boucher pour ramasser 10 Cadavres d\'Hyène brûlepatte.‡使用收集机器人采集10具疱爪土狼尸体。‡使用屠殺機器人拾取10個皰爪土狼屍體。',
  }
},
[25117] = {
  {
    '‡Позор разведчика‡Die Schmach des Spähers‡정찰병의 불명예‡El deshonor del explorador‡‡Haro sur l\'éclaireur‡‡',
    nil,
    '‡Возьмите донесения Черного Железа у разведчика Черного Железа.‡Nehmt die Depesche der Dunkeleisenzwerge dem Späher der Dunkeleisenzwerge ab.‡검은무쇠 정찰병을 처치하고 검은무쇠 급송문서를 수집해야 합니다.‡Recoge el informe Hierro Negro del explorador Hierro Negro.‡‡Collectez la Dépêche des Sombrefers sur le corps de l\'Éclaireur sombrefer.‡‡',
  }
},
[25118] = {
  {
    'Aracnofobia‡В поисках пауков-скрытней‡Nach den Lauerern schauen‡거미 처치‡En busca de merodeadores‡En busca de merodeadores‡Sur la piste des rôdeuses‡寻找潜伏者‡尋找潛伏者',
    nil,
    'Mate 8 Tocaieiras da Floresta.‡Убейте 8 лесных пауков-скрытней.‡Tötet 8 Waldlauerer.‡숲늑대거미 8마리를 처치해야 합니다.‡Mata a 8 rondadoras del bosque.‡Mata a 8 rondadoras del bosque.‡Tuez 8 Rôdeuses des forêts.‡消灭8只森林潜伏者。‡殺死8個森林潛伏者。',
  }
},
[25119] = {
  {
    '‡Краткая охота‡Spontane Jagd‡‡Caza impulsiva‡‡Cibles d\'opportunité‡‡',
    nil,
    '‡Соберите 6 боков кроколисков, поохотившись на кроколисков с озера Лок.‡Besorgt 6 Krokiloskenhälften von Lochkrokilisken.‡‡Reúne 6 costales de carne de crocolisco de los crocoliscos del lago.‡‡Collectez 6 Flancs de crocilisque sur des Crocilisques du loch.‡‡',
  }
},
[25120] = {
  {
    'O último voo de Marley‡Последний бой Марли‡Marleys letzter Flug‡말리의 마지막 비행‡El vuelo final de Marley‡El vuelo final de Marley‡Le dernier vol de Marley‡马尔雷最后的飞行‡馬爾利最後的飛行',
    nil,
    'Fale com Marley Duas-tranças e dê uma volta em sua máquina voadora.‡Поговорите с Марли Двукоссой и прокатитесь на его летающей машине.‡Sprecht mit Marley Doppelzopf und akzeptiert einen Flug in seiner Flugmaschine.‡말리 트윈브레이드와 대화하고 비행기에 탑승해야 합니다.‡Habla con Marley Trenzado y date una vuelta en su máquina voladora.‡Habla con Marley Trenzado y date una vuelta en su máquina voladora.‡Parlez à Marley Doublenattes et embarquez dans sa machine volante.‡跟马尔雷·双辫谈一谈，乘坐他的飞行器兜一圈。‡和馬爾利‧塔文布萊德交談以搭乘他的飛行器。',
  }
},
[25121] = {
  {
    'Próxima parada: Enseada do Armador Perdido‡Время идет!‡Momentum‡계기‡Momento‡Momento‡Continuer sur sa lancée‡推进力‡氣勢',
    nil,
    'Encontre Kelsey Fagulhaço na Enseada do Armador Perdido.‡Встретьтесь с Келси Стализвон в Бухте Сорванных Парусов.‡Trefft Kelsey Stahlfunken in der Mast- und Schotbucht.‡해적단 소굴에 있는 켈시 스틸스파크를 만나야 합니다.‡Encuéntrate con Kelsey Chispacero en la Cala del Aparejo Perdido.‡Encuéntrate con Kelsey Chispacero en la Cala del Aparejo Perdido.‡Rejoignez Kelsey Etinçacier à la Crique des Gréements.‡去找落帆海湾的凯尔希·钢烁。‡到落帆海灣與凱爾希·鋼火碰面。',
  }
},
[25122] = {
  {
    'É bom para o moral‡Для поднятия духа‡Moralschub‡사기 고취‡Liberar la mente‡Liberar la mente‡Gonflés à bloc‡重振士气‡士氣大增',
    nil,
    'Use Jaka\'Cola Zero-um para libertar Reco-reco, Bolão, Azeitona e 6 Sobreviventes Goblins ou Cidadãos de Kezan.‡При помощи "Каджа-Колы Полулайт" освободите разум Туза, Иззи, Гоббера и 6 уцелевших гоблинов или кезанских горожан.‡Benutzt die Kaja\'Cola minus eins, um Ass, Izzy, Gobber und 6 überlebende Goblins oder Bürger von Kezan zu befreien.‡카자콜라 제로로 에이스, 이지, 고버와 고블린 생존자나 케잔 시민 6명을 해방해야 합니다.‡Usa la Kaja\'Cola Zero-Uno para liberar las mentes de As, Izzy, Gargajo y a 6 supervivientes goblin o ciudadanos de Kezan.‡Usa la Kaja\'Cola Zero-Uno para liberar las mentes de As, Izzy, Gargajo y a 6 supervivientes goblin o ciudadanos de Kezan.‡Utilisez le Kaja\'Cola Zéro-Un pour libérer Crack, Izzy, Gobeur et 6 Survivants gobelins ou Citoyens de Kezan.‡使用卡亚零一度可乐营救王牌、小静、大胖以及6名地精幸存者或是科赞公民。‡用卡迦可樂Zero-One解放愛司、伊茲、古柏和總數6名的哥布林生還者或凱贊居民。',
  }
},
[25123] = {
  {
    'Uma pedra no meio do caminho‡Смерть насовсем!‡Werft ihn zu Boden!‡땅에 던져버려!‡¡Tíralo al suelo!‡¡Tíralo al suelo!‡Jetez-la par terre !‡摧毁灵魂石！‡丟到地上!',
    nil,
    'Destrua a pedra da alma de Ruinumbra, o Brutomestre.‡Уничтожьте камень души Вспыхомрака Главы Громил.‡Vernichtet Knallschattens Seelenstein.‡야만군주 블라스트섀도의 영혼석을 파괴해야 합니다.‡Destruye la piedra de alma de Bombaumbro el Señor de las Bestias.‡Destruye la piedra de alma de Bombaumbro el Señor de las Bestias.‡Détruisez la pierre d\'âme de Splozombre le Meneur de brutes.‡摧毁残酷主人“裂影”的灵魂石。‡摧毀蠻卒指揮官爆影的靈魂石。',
  }
},
[25124] = {
  {
    '‡Невыносимая жестокость‡Brutalität gegen Brutalos‡‡Brutalidad déspota‡‡Brutalité brute‡‡',
    nil,
    '‡Убейте 6 громил-надзирателей.‡Tötet 6 brutale Aufseher.‡‡Mata a 6 sobrestantes déspotas.‡‡Tuez 6 Surveillants brutaux.‡‡',
  }
},
[25125] = {
  {
    'A luz no fim do túnel‡Свет в конце туннеля‡Licht am Ende des Tunnels‡통로 끝에 보이는 빛‡Una luz al final del túnel‡Una luz al final del túnel‡De la lumière au bout du tunnel‡矿道尽头的亮光‡隧道盡頭的光',
    nil,
    'Interaja com o Vagonete da Mina do lado de fora da Mina de Trabalhos Forçados de Gallywix, nas Ilhas Perdidas.‡Найдите вагонетку на Затерянных островах у исправительной шахты Галливикса.‡Bedient den Minenwagen außerhalb von Gallywix\' Fronmine auf den Verlorenen Inseln.‡잃어버린 섬의 갤리윅스 노동광산 밖에 있는 광산 수레를 이용해야 합니다.‡Utiliza el vagón de mina situado en la salida de la Mina de Trabajos Forzados de Gallywix, en Las Islas Perdidas.‡Utiliza el vagón de mina situado en la salida de la Mina de Trabajos Forzados de Gallywix, en Las Islas Perdidas.‡Utilisez le Chariot de mine à l\'extérieur de la Mine de travail de Gallywix, sur les Îles Perdues.‡与失落群岛加里维克斯劳工矿井外的采矿车进行交互。‡在失落群島的加里維克斯的勞工礦坑使用礦坑推車。',
  }
},
[25126] = {
  {
    'Dentes cortantes‡Кабаньи клыки‡Scharfe Zähne‡몸 풀기‡Dientes afilados‡Dientes afilados‡La dent tranchante‡小试身手‡小試身手',
    nil,
    'Mate 6 Mosquetuscos.‡Убейте 6 пятнистых вепрей.‡Tötet 6 scheckige Eber.‡점박이멧돼지를 6마리 처치해야 합니다.‡Mata a 6 jabalíes jaspeados.‡Mata a 6 jabalíes jaspeados.‡Tuez 6 Sangliers tachetés.‡杀掉6只杂斑野猪。‡殺死6隻雜斑野豬。',
  }
},
[25127] = {
  {
    'Ferroada do escorpídeo‡Жала скорпидов‡Stich des Skorpiden‡전갈의 독침‡Aguijón de escórpido‡Aguijón de escórpido‡L\'aiguillon du scorpide‡工蝎的尾巴‡工蠍的尾巴',
    nil,
    'Obtenha 8 Caudas de Escorpídeo Operário.‡Добудьте 8 хвостов рабочего скорпида.‡Beschafft 8 Skorpidarbeiterschwänze.‡일꾼전갈 꼬리 8개를 모아야 합니다.‡Consigue 8 colas de escórpido obrero.‡Consigue 8 colas de escórpido obrero.‡Obtenir 8 Queues de scorpides ouvriers.‡获得8根工蝎的尾巴。‡收集8支工蠍的尾巴。',
  }
},
[25128] = {
  {
    'Hana\'zua‡Хана\'зуа‡Hana\'zua‡하나주아‡Hana\'zua‡Hana\'zua‡Hana\'zua‡哈纳祖‡哈納祖',
    nil,
    'Encontre Hana\'zua no Vale das Provações.‡Найдите Хана\'зуа в Долине Испытаний.‡Findet Hana\'zua im Tal der Prüfungen.‡시험의 골짜기에서 하나주아를 찾아야 합니다.‡Encuentra a Hana\'zua en el Valle de los Retos.‡Encuentra a Hana\'zua en el Valle de los Retos.‡Trouvez Hana\'zua dans la Vallée des Épreuves.‡在试炼谷中找到哈纳祖。‡到試煉谷去找到哈納祖。',
  }
},
[25129] = {
  {
    'Sarkoth‡Саркот‡Sarkoth‡사르코스‡Sarkoth‡Sarkoth‡Sarkoth‡萨科斯‡薩科斯',
    nil,
    'Mate Sarkoth e leve a garra dele para Hana\'zua.‡Убейте Саркота и принесите его клешню Хана\'зуа.‡Tötet Sarkoth und bringt seine Klaue zu Hana\'zua.‡사르코스를 처치하고 그 발톱을 하나주아에게 가져가야 합니다.‡Mata a Sarkoth y llévale su zarpa a Hana\'zua.‡Mata a Sarkoth y llévale su zarpa a Hana\'zua.‡Tuez Sarkoth et rapportez sa pince à Hana\'zua.‡杀死萨科斯，并将它的爪子带回去交给哈纳祖。‡殺死薩科斯並將它的爪子帶回去交給哈納祖。',
  }
},
[25130] = {
  {
    'De volta ao covil‡Назад, в Логово‡Zurück zum Höhlenbau‡다시 동굴 막사로‡De vuelta a El Cubil‡De vuelta a El Cubil‡Retour à l\'Antre‡返回大兽穴‡回到洞穴',
    nil,
    'Leve as notícias sobre os apuros de Hana\'zua a Gornek, no Vale das Provações.‡Отправляйтесь в Долину Испытаний и расскажите Горнеку о том, что случилось с Хана\'зуа.‡Überbringt Gornek im Tal der Prüfungen die Nachricht von Hana\'zuas Notlage.‡시험의 골짜기에 있는 고르넥에게 하나주아의 현재 상황을 전해야 합니다.‡Informa de la situación de Hana\'zua a Gornek en el Valle de los Retos.‡Informa de la situación de Hana\'zua a Gornek en el Valle de los Retos.‡Informez Gornek, à la Vallée des Épreuves, de la situation critique dans laquelle se trouve Hana\'zua.‡将哈纳祖目前的状况告诉试炼谷的高内克。‡將哈納祖目前的狀況告訴在試煉谷的高內克。',
  }
},
[25131] = {
  {
    'Familiares torpes‡Злобные фамилиары‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Mate 8 Familiares Torpes.‡Уничтожьте 8 злобных фамилиаров.‡Tötet 8 üble Familiare.‡악마의 하수인 8마리를 처치해야 합니다.‡Mata a 8 familiares viles.‡Mata a 8 familiares viles.‡Tuez 8 Vils quasits.‡杀死8只邪灵劣魔。‡殺死8名邪靈劣魔。',
  }
},
[25132] = {
  {
    'Medalhão da Lâmina Ardente‡Медальон Пылающего Клинка‡Medaillon der Brennenden Klinge‡불타는 칼날단 메달‡El medallón del Filo Ardiente‡El medallón del Filo Ardiente‡Le médaillon de la Lame ardente‡火刃奖章‡燃刃勳章',
    nil,
    'Mate 7 Espreitadores Vis e obtenha o Medalhão da Lâmina Ardente.‡Уничтожьте 7 ловцов Скверны и добудьте медальон Пылающего Клинка.‡Tötet 7 Teufelspirscher und bringt das Medaillon der Brennenden Klinge an Euch.‡하급 지옥사냥개 7마리를 처치하고 불타는 칼날단 메달을 획득해야 합니다.‡Mata a 7 acechadores viles y consigue el medallón del Filo Ardiente.‡Mata a 7 acechadores viles y consigue el medallón del Filo Ardiente.‡Tuez 7 Traqueurs gangrenés et récupérez le Médaillon de la Lame ardente.‡杀死7只地狱捕猎者，并获得火刃奖章。‡殺死7隻惡魔潛獵者並取得燃刃勳章。',
  }
},
[25133] = {
  {
    'Apresente-se na Aldeia Sen\'jin‡Донесение для деревни Сен\'джин‡Bericht erstatten in Sen\'jin‡센진 마을에 보고‡Preséntate en el Poblado Sen\'jin‡Preséntate en el Poblado Sen\'jin‡Faire un rapport au Village de Sen\'jin‡去森金村报到‡去森金村報到',
    nil,
    'Fale com o Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Sprecht mit Meister Gadrin in Sen\'jin.‡센진 마을의 장로 가드린과 대화해야 합니다.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Parler à Maître Gadrin au village de Sen\'jin.‡与森金村的加德林大师谈一谈。‡與森金村的加德林大師談話。',
  }
},
[25134] = {
  {
    'Peões preguiçosos‡Ленивые батраки‡Faule Peons‡게으른 일꾼들‡Peones vagos‡Peones vagos‡Les péons paresseux‡懒惰的苦工‡懶惰的苦工',
    nil,
    'Use o Cassetete do Encarregado em 4 Peões Preguiçosos enquanto eles dormem.‡Отлупите дубинкой штейгера 4 ленивых батраков, застуканных во время сна.‡Benutzt den Totschläger des Großknechts an 4 faulen Peons, wenn sie schlafen.‡작업반장의 가죽곤봉을 자고 있는 게으른 일꾼 4명에게 사용해야 합니다.‡Utiliza la Cachiporra del supervisor con los peones vagos que estén durmiendo.‡Utiliza la Cachiporra del supervisor con los peones vagos que estén durmiendo.‡Utiliser la Masse du contremaître sur 4 Péons fainéants, lorsqu’ils sont en train de dormir.‡在懒惰的苦工睡觉时，用工头的木棒敲醒4个苦工。‡在4名懶惰的苦工偷懶睡覺時，在他們身上使用工頭的木棒。',
  }
},
[25135] = {
  {
    'A picareta de Thazz\'ril‡Кирка Тазз\'рила‡Thazz\'rils Hacke‡타즈릴의 곡괭이‡Pico de Thazz\'ril‡Pico de Thazz\'ril‡La pioche de Thazz\'ril‡塔兹利尔的镐‡塔茲利爾的鎬',
    nil,
    'Leve a Picareta de Thazz\'ril para o Encarregado Thazz\'ril.‡Принесите кирку Тазз\'рила штейгеру Тазз\'рилу.‡Bringt Thazz\'rils Hacke zu Großknecht Thazz\'ril.‡타즈릴의 곡괭이를 작업반장 타즈릴에게 가져가야 합니다.‡Lleva el pico de Thazz\'ril al supervisor Thazz\'ril.‡Lleva el pico de Thazz\'ril al supervisor Thazz\'ril.‡Apportez la Pioche de Thazz\'rill au Contremaître Thazz\'rill.‡将塔兹利尔的镐还给塔兹利尔。‡將塔茲利爾的鎬還給工頭塔茲利爾。',
  }
},
[25136] = {
  {
    'A surpresa de sabra do Galgar‡Кактусовый десерт Галгара‡Galgars Kaktusapfel Surprise‡갈가르의 선인장 사과 별미‡Sorpresa de manzanas de cactus de Galgar‡Sorpresa de manzanas de cactus de Galgar‡Surprise aux pommes de cactus de Galgar‡戈加尔的清凉果‡戈加爾的清涼果',
    nil,
    'Obtenha 6 Sabras.‡Добудьте 6 плодов кактуса.‡Sammelt 6 Kaktusäpfel.‡선인장 사과 6개를 획득해야 합니다.‡Consigue 6 manzanas de cactus.‡Consigue 6 manzanas de cactus.‡Obtenez 6 Pommes de cactus.‡收集6颗仙人掌果。‡收集6個仙人掌果。',
  }
},
[25137] = {
  {
    '‡‡Tal der Prüfungen: PRK - H - Warlock Pet Imp‡‡‡‡Vallée des Épreuves: PRK – H – Diablotin familier de démoniste‡‡',
    nil,
    '‡Принесите Рузану 6 голов злобных фамильяров.‡Bringt 6 Köpfe schändlicher Familiare zu Ruzan.‡‡Lleva 6 cabezas de familiar vil a Ruzan.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Apporter 6 Têtes de vils quasits à Ruzan.‡给鲁赞带回6颗邪灵劣魔的头颅。‡',
  }
},
[25138] = {
  {
    'Pergaminho glífico‡Покрытый письменами пергамент‡Glyphenpergament‡상형 문자가 새겨진 양피지‡Papiro glífico‡Papiro glífico‡Parchemin glyphé‡雕文羊皮纸‡雕紋羊皮紙',
    nil,
    'Leia o Pergaminho Glífico e fale com Acrypha no Vale das Provações.‡Прочтите покрытый письменами пергамент и поговорите с Акрифой в Долине Испытаний.‡Lest das Glyphenpergament und sprecht mit Acrypha im Tal der Prüfungen.‡상형 문자가 새겨진 양피지를 읽고 시험의 골짜기에 있는 아크리파와 대화해야 합니다.‡Lee el papiro glífico y habla con Acrypha en el Valle de los Retos.‡Lee el papiro glífico y habla con Acrypha en el Valle de los Retos.‡Lire le Parchemin glyphé, puis parler à Acrypha dans la Vallée des Épreuves.‡阅读雕文羊皮纸，然后与试炼谷的奥克莱法谈谈。‡閱讀雕紋羊皮紙並與試煉谷的阿克力法交談。',
  }
},
[25139] = {
  {
    'Tiro firme‡Верный выстрел‡Zuverlässiger Schuss‡고정 사격‡Disparo firme‡Disparo firme‡Le tir assuré‡稳固射击‡穩固射擊',
    nil,
    'Aprenda Tiro Firme com Karranisha, no Vale das Provações. Encontre um Boneco de Treinamento e pratique o Tiro Firme 5 vezes.‡Научитесь Верному выстрелу у Карраниши в Долине Испытаний. Найдите тренировочный манекен и пять раз произведите по нему "Верный выстрел".‡Lernt "Zuverlässiger Schuss" von Karranisha im Tal der Prüfungen. Findet eine Trainingsattrappe und übt daran 5 Mal den zuverlässigen Schuss.‡시험의 골짜기에 있는 카라니샤에게 고정 사격을 배운 다음 훈련용 허수아비를 찾아 고정 사격을 5번 연습해야 합니다.‡Aprende Disparo firme de Karranisha en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Disparo firme 5 veces.‡Aprende Disparo firme de Karranisha en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Disparo firme 5 veces.‡Apprenez le Tir assuré auprès de Karranisha dans la Vallée des Épreuves. Ensuite, trouvez un Mannequin d\'entraînement et utilisez le Tir assuré dessus à cinq reprises.‡向试炼谷的卡朗尼沙学习稳固射击，然后找一个训练假人，对其使用5次稳固射击。‡向試煉谷的卡倫尼夏學習穩固射擊。找一個訓練假人練習穩固射擊5次。',
  }
},
[25140] = {
  {
    '‡Охота на свинью‡Schweinejagd‡‡Cazando cerdos‡‡Chasse au pourceau‡‡',
    nil,
    '‡Вырвите у Ло\'Шалла щетинку. Вам может понадобиться "Выслеживание животных".‡Reißt Lo\'shall ein Haar aus. Ihr solltet vielleicht "Wildtiere aufspüren" verwenden.‡‡Arráncale una cerda a Lo\'shall. Deberías usar Rastrear bestias.‡‡Arrachez un Poil de Lo\'shall. Vous aurez peut-être besoin de Pistage des bêtes.‡‡',
  }
},
[25141] = {
  {
    'Eviscerar‡Потрошение‡Ausweiden‡절개‡Eviscerar‡Eviscerar‡Éviscération‡刺骨‡剔骨',
    nil,
    'Aprenda Eviscerar com Rwag no Vale das Provações. Encontre um Boneco de Treinamento e pratique Eviscerar 3 vezes.‡Обучитесь Потрошению у Руага в Долине Испытаний. Найдите тренировочный манекен и трижды проведите на нем прием потрошения.‡Lernt "Ausweiden" von Rwag im Tal der Prüfungen. Findet eine Trainingsattrappe und übt daran 3 Mal das Ausweiden.‡시험의 골짜기의 르와그에게 절개를 배운 다음 훈련용 허수아비를 찾아 절개를 3번 연습해야 합니다.‡Aprende Eviscerar de Rwag en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Eviscerar 3 veces.‡Aprende Eviscerar de Rwag en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Eviscerar 3 veces.‡Apprenez Éviscération auprès de Rwag dans la Vallée des Épreuves. Ensuite, trouvez un Mannequin d\'entraînement et utilisez Éviscération dessus à trois reprises.‡向试炼谷的鲁瓦格学习刺骨，然后找一个训练假人，对其使用3次刺骨。‡向試煉谷的魯瓦格學習剔骨。找一個訓練假人並練習使用剔骨3次。',
  }
},
[25142] = {
  {
    '‡Под покровом тени‡In die Schatten‡‡En la oscuridad‡‡Dans les ombres‡‡',
    nil,
    '‡С помощью вашей способности быть незаметным проскользните мимо Руага в Долине Испытаний.‡Benutzt Eure Fähigkeit \'Verstohlenheit\' in Rwags Nähe im Tal der Prüfungen.‡‡Usa tu facultad de Sigilo junto a Rwag en el Valle de los Retos.‡‡Utilisez votre technique Camouflage près de Rwag dans la Vallée des Épreuves.‡‡',
  }
},
[25143] = {
  {
    'Golpe primevo‡Стихийный удар‡Urtümlicher Schlag‡원시의 일격‡Golpe primigenio‡Golpe primigenio‡Frappe primordiale‡根源打击‡原始之擊',
    nil,
    'Pratique o Golpe Primevo com Shikrik, no Vale das Provações. Procure um boneco de treinamento próximo a Shikrik e pratique o Golpe Primevo 3 vezes.‡Обучитесь Стихийному удару у Шикрик в Долине Испытаний. Найдите поблизости тренировочный манекен и три раза осуществите Стихийный удар.‡Lernt "Urtümlicher Schlag" von Shikrik im Tal der Prüfungen. Findet eine Trainingsattrappe in Shikriks Nähe und übt daran 3 Mal den urtümlichen Schlag.‡시험의 골짜기에 있는 시크리크에게서 원시의 일격을 배워야 합니다. 그 후 시크리크 주위의 훈련용 허수아비를 찾아 태고의 일격을 3회 연습해야 합니다.‡Aprende Golpe primigenio de Shikrik en el Valle de los Retos. Busca un muñeco de entrenamiento cerca de Shikrik y practica Golpe primigenio 3 veces.‡Aprende Golpe primigenio de Shikrik en el Valle de los Retos. Busca un muñeco de entrenamiento cerca de Shikrik y practica Golpe primigenio 3 veces.‡Apprendre Frappe primordiale auprès de Shikrik dans la vallée des Épreuves. Ensuite, trouvez un Mannequin d\'entraînement non loin de Shikirk et utilisez Frappe primordiale dessus à trois reprises.‡向试炼谷的史克里克学习根源打击，然后在史克里克附近找一个训练假人，对其使用3次根源打击。‡向試煉谷的史克里克學習原始之擊。在史克里克身邊找一個訓練假人並練習使用原始之擊3次。',
  }
},
[25144] = {
  {
    '‡Камень бьет плоть‡Stein trifft Fleisch‡‡La roca atraviesa la carne‡‡Roc contre chair‡‡',
    nil,
    '‡Уничтожьте пойманного разведчика Северной Стражи, предварительно наложив на свое вооружение чары оружия камнедробителя.‡Besiegt einen gefangenen Späher der Nordwacht, während Eure Waffe mit "Felsbeißer" verzaubert ist.‡‡Derrota a un explorador del Fuerte del Norte capturado mientras tu arma está encantada con Arma Muerdepiedras.‡‡Vainquez un Éclaireur de Guet-du-Nord capturé alors que votre arme est enchantée avec Arme Croque-roc.‡‡',
  }
},
[25145] = {
  {
    'Imolação‡Жертвенный огонь‡Feuerbrand‡제물‡Inmolar‡Inmolar‡L\'immolation‡献祭‡獻祭',
    nil,
    'Treine Imolação com Nartok, no Vale das Provações. Encontre um Boneco de Treinamento e pratique Imolação 5 vezes.‡Изучите заклинание "Жертвенный огонь" у Нартока в Долине Испытаний. Затем 5 раз испытайте это заклинание на тренировочном манекене.‡Erlernt Feuerbrand von Nartok im Tal der Prüfungen. Findet eine Trainingsattrappe und wirkt Feuerbrand 5 Mal.‡시험의 골짜기의 나르톡에게 제물을 배우고 나서 훈련용 허수아비를 찾아 제물을 5번 연습해야 합니다.‡Aprende Inmolar de Nartok en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica a lanzar Inmolar 5 veces.‡Aprende Inmolar de Nartok en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica a lanzar Inmolar 5 veces.‡Apprenez Immolation auprès de Nartok dans la Vallée des Épreuves. Ensuite, lancez Immolation à 5 reprises sur un Mannequin d\'entraînement.‡向试炼谷的纳托克学习献祭，然后找一个训练假人，对其使用5次献祭。‡向試煉谷的納托克學習獻祭。找一個訓練假人並練習使用獻祭5次。',
  }
},
[25146] = {
  {
    '‡Демонический огонь‡Ein dämonisches Feuer‡‡Un fuego demoníaco‡‡Un feu démoniaque‡‡',
    nil,
    '‡Уничтожьте пойманного разведчика Северной Стражи, применив заклинание "Жертвенный огонь".‡Wirkt "Feuerbrand" auf einen gefangenen Späher der Nordwacht.‡‡Lanza Inmolar contra un explorador del Fuerte del Norte capturado.‡‡Lancez Immolation sur un Éclaireur de Guet-du-Nord capturé.‡‡',
  }
},
[25147] = {
  {
    'Investida‡Рывок‡Sturmangriff‡돌진‡Cargar‡Cargar‡À la charge !‡冲锋‡衝鋒',
    nil,
    'Aprenda a Investida com Frang, no Vale das Provações. Encontre um Boneco de Treinamento e pratique a Investida.‡Изучите способность "Рывок" у Франга в Долине Испытаний, а затем испытайте изученную способность на тренировочном манекене.‡Erlernt Sturmangriff von Frang im Tal der Prüfungen. Sucht eine Trainingsattrappe und übt die Benutzung von Sturmangriff.‡시험의 골짜기에 있는 프랑에게 돌진을 배운 다음 훈련용 허수아비를 찾아 돌진을 연습해야 합니다.‡Aprende Cargar de Frang en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Cargar.‡Aprende Cargar de Frang en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Cargar.‡Apprenez la Charge auprès de Frang, dans la Vallée des Épreuves. Ensuite, trouvez un Mannequin d\'entraînement et entraînez-vous à utiliser la Charge.‡向试炼谷的弗朗恩学习冲锋，然后找一个训练假人，对其使用冲锋。‡向試煉谷的弗朗恩學習衝鋒。找一個訓練假人並練習使用衝鋒。',
  }
},
[25148] = {
  {
    '‡Всесильный вопль‡Zu Eurem Wort stehen‡‡Afina tu grito‡‡Exercer votre hurlement‡‡',
    nil,
    '‡С помощью способности "Боевой крик" победите пойманного разведчика Северной Стражи до окончания действия способности.‡Besiegt einen gefangenen Späher der Nordwacht, während Ihr unter dem Einfluss Eures Schlachtrufs steht.‡‡Derrota a un explorador del Fuerte del Norte capturado mientras esté bajo los efectos de tu grito de batalla.‡‡Vaincre un Éclaireur de Guet-du-Nord capturé alors que vous êtes sous l\'effet de Cri de guerre.‡‡',
  }
},
[25149] = {
  {
    'Mísseis arcanos‡Чародейские стрелы‡Arkane Geschosse‡신비한 화살‡Misiles Arcanos‡Misiles Arcanos‡Les projectiles des Arcanes‡奥术飞弹‡秘法飛彈',
    nil,
    'Aprenda Mísseis Arcanos com Acrypha, no Vale das Provações. Encontre um Boneco de Treinamento e pratique usando Mísseis Arcanos 2 vezes.‡Выучите у Акрифы заклинание "Чародейские стрелы" в Долине Испытаний. Найдите тренировочный манекен и два раза испытайте на нем Чародейские Стрелы.‡Lernt "Arkane Geschosse" von Acrypha im Tal der Prüfungen. Findet eine Trainingsattrappe und übt daran 2 Mal die Anwendung arkaner Geschosse.‡시험의 골짜기에 있는 아크리파에게 신비한 화살을 배운 다음 훈련용 허수아비를 찾아 신비한 화살을 2번 연습해야 합니다.‡Aprende Misiles Arcanos de Acryptha en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Misiles Arcanos 2 veces.‡Aprende Misiles Arcanos de Acryptha en el Valle de los Retos. Localiza un muñeco de entrenamiento y practica Misiles Arcanos 2 veces.‡Apprenez Projectiles des Arcanes auprès d\'Acrypha dans la Vallée des Épreuves. Ensuite, lancez Projectiles des Arcanes à 2 reprises sur un Mannequin d\'entraînement.‡向试炼谷的奥克莱法学习奥术飞弹，然后找一个训练假人，对其使用2次奥术飞弹。‡向試煉谷的阿克力法學習秘法飛彈。找一個練習假人練習秘法飛彈2次。',
  }
},
[25150] = {
  {
    '‡Мозговой штурм‡Machterfüllter Geist‡‡Mentes potenciadas‡‡Des esprits accélérés‡‡',
    nil,
    '‡Испытать действие Чародейского интеллекта на Акрифе.‡Wirkt Arkane Intelligenz auf Acrypha.‡‡Lánzale Intelecto Arcano a Acrypha.‡‡Lancez Intelligence des arcanes sur Acrypha.‡‡',
  }
},
[25151] = {
  {
    'Com cerveja!‡Срочно нужен эль!‡Er braucht Bier!‡최후의 한 모금‡¡Una de cerveza!‡¡Una de cerveza!‡Il nous faut de la bière !‡他需要麦酒！‡他需要麥酒!',
    nil,
    'Vasculhe a Bastilha Bael\'Dun, encontre uma Caneca de Cerveja Béim e leve-a para Marley Duas-tranças, na entrada.‡Найдите в крепости Бейл\'дан кружку "Старого Баркерстаутского" и принесите ее Марли Двукоссе ко входу.‡Durchsucht Burg Bael\'dun nach einem Krug mit Hager-Bschorr und bringt ihn zu Marley Doppelzopf am Eingang.‡바엘던 요새에서 옛 포고꾼 맥주잔을 찾은 다음 입구에 있는 말리 트윈브레이드에게 가져가야 합니다.‡Dirígete a Fortaleza de Bael\'Dun y consigue una jarra de Ol\' Barkerstout. Entrégasela a Marley Trenzado en la entrada.‡Dirígete a la Fortaleza de Bael\'Dun y consigue una jarra de Ol\' Barkerstout. Entrégasela a Marley Trenzado en la entrada.   ‡Trouvez une Chope d’Aboyeuse dans le Donjon de Bael’dun et apportez-la à Marley Doublenattes, à l’entrée du donjon.‡在巴尔丹城堡内找到一杯陈年招牌烈酒，将它交给入口处的马尔雷·双辫。‡在巴爾丹城堡中找出一杯陳年招牌烈酒，並且帶回給在入口處的馬爾利‧塔文布萊德。',
  }
},
[25152] = {
  {
    'O seu lugar no mundo‡Твое место в мире‡Euer Platz in der Welt‡할 일 찾기‡Tu lugar en el mundo‡Tu lugar en el mundo‡Votre place en ce monde‡你的位置‡起點',
    nil,
    'Fale com Gornek.‡Поговорите с Горнеком.‡Sprecht mit Gornek.‡고르넥과 대화해야 합니다.‡Habla con Gornek.‡Habla con Gornek.‡Parler à Gornek.‡跟高内克谈一谈。‡與高內克交談。',
  }
},
[25153] = {
  {
    'Resgate em Bael\'dun‡Спасательная операция в Бейл\'дане‡Bael\'duns Rettung‡바엘던 구출 작전‡El rescate de Bael\'dun‡El rescate de Bael\'dun‡Au secours de Bael\'dun‡营救巴尔丹幸存者‡巴爾丹救援行動',
    nil,
    'Entre em Bastilha Bael\'Dun e resgate 10 Sobreviventes de Bael\'dun dos destroços.|n|nUse as Válvulas Anti-incêndio de Emergência para se proteger.‡Идите в крепость Бейл\'дан и спасите из-под обломков 10 уцелевших бейл\'данских археологов.|n|nВоспользуйтесь аварийными пожарными клапанами, чтобы защитить себя от огня.‡Begebt Euch in die Burg Bael\'dun und rettet 10 Überlebende von Bael\'dun aus den Trümmern.|n|nBenutzt die Notfallfeuerventile, um Euch vor den Flammen zu schützen.‡바엘던 요새로 들어가 잔해에서 바엘던 생존자 10명을 구출해야 합니다.|n|n비상 화재 밸브를 사용하면 불길로부터 몸을 보호할 수 있습니다.‡Entra en la Fortaleza de Bael\'dun y rescata a 10 supervivientes de Bael\'dun de entre los escombros.|n|nUtiliza las válvulas antiincendio para protegerte de las llamas.‡Entra en la Fortaleza de Bael\'dun y rescata a 10 supervivientes de Bael\'dun de entre los escombros.|n|nUtiliza las válvulas antiincendio para protegerte de las llamas.‡Pénétrez dans le Donjon de Bael’dun et sauvez 10 Survivants de Bael’dun des décombres.|n|nUtilisez les Valves d’incendie d’urgence pour vous protéger des flammes.‡进入巴尔丹城堡，从废墟中营救10名巴尔丹幸存者。|n|n使用紧急灭火阀保护自己不被火焰吞噬。‡進入巴爾丹城堡，並從碎石瓦礫中救出10個巴爾丹倖存者。|n|n利用緊急消防出水閥在大火中保護自己。',
  }
},
[25154] = {
  {
    'Um presente para Lila‡Подарок для Лайлы‡Ein Geschenk für Lila‡릴라를 위한 선물‡Un regalo para Lila‡Un regalo para Lila‡Un présent pour Lila‡给莉娜的礼物‡給莉拉的禮物',
    nil,
    'Lapide três Noctilitas Eternas e entregue-as a Isabel Jones em Ventobravo.‡Ограните три вневременных камня ночи и отдайте их Изабели Джонс в Штормграде.‡Schleift drei zeitlose Nachtsteine und gebt sie Isabel Jones in Sturmwind.‡변함없는 야밤석 3개를 세공해서 스톰윈드에 있는 이자벨 존스에게 가져가야 합니다.‡Talla tres piedras nocturnas intemporales y dáselas a Isabel Jones, en la Ciudad de Ventormenta.‡Talla tres piedras nocturnas intemporales y dáselas a Isabel Jones, en la Ciudad de Ventormenta.‡Taillez 3 Pierres de nuit intemporelles et donnez-les à Isabel Jones à Hurlevent.‡切割3颗永恒夜之石，把它们交给暴风城的伊莎贝尔·琼斯。‡切出三顆恆久的夜石並送去暴風城給伊莎貝爾·瓊斯。',
  }
},
[25155] = {
  {
    'Ogrozânianas a procura de companhia‡Огрезонцы негодуют‡Ogermazonen in Stimmung‡오거조니아의 행복한 여자 오우거‡Las ogrozonianas están de humor‡Las ogrozonianas están de humor‡Les ogrezones amoureuses‡诡异的欧格佐尼亚斯‡興致勃勃的歐格索尼亞人',
    nil,
    'Lapide três Jaspes Serrilhados e entregue-os a Isabel Jones em Ventobravo.‡Ограньте три экземпляра зазубренной яшмы и отдайте их Изабели Джонс в Штормграде.‡Schleift drei gezackte Jaspise und gebt sie Isabel Jones in Sturmwind.‡톱니모양 벽옥 3개를 세공해서 스톰윈드에 있는 이자벨 존스에게 전달해야 합니다.‡Talla tres jaspes dentados y entrégaselos a Isabel Jones en la ciudad de Ventormenta.‡Talla tres jaspes dentados y entrégaselos a Isabel Jones en la ciudad de Ventormenta.‡Taillez 3 Jaspes dentelés et donnez-les à Isabel Jones à Hurlevent.‡切割3颗裂纹碧玉，把它们交给暴风城的伊莎贝尔·琼斯。‡切割三顆鋸齒的翠玉並送去暴風城給伊莎貝爾·瓊斯。',
  }
},
[25156] = {
  {
    'Meleca Elemental‡Клейкая субстанция элементалей‡Elementarglibber‡정기의 점액질‡Baba elemental‡Baba elemental‡La gelée élémentaire‡元素粘稠物‡元素黏液',
    nil,
    'Colete 10 Melecas Elementais de qualquer elemental do Cataclismo e traga-as para Isabel Jones em Ventobravo.‡Получите 10 порций клейкой субстанции с любых элементалей территорий Cataclysm и принесите их Изабели Джонс в Штормграде.‡Besorgt 10 Elementarglibber von beliebigen Cataclysm-Elementaren und bringt sie zu Isabel Jones in Sturmwind.‡아무 대격변 정령으로부터 정기의 점액질 10개를 획득해서 스톰윈드에 있는 이자벨 존스에게 가져가야 합니다.‡Reúne 10 babas elementales de cualquier elemental del Cataclismo y llévaselas a Isabel Jones, en Ciudad de Ventormenta.‡Reúne 10 babas elementales de cualquier elemental del Cataclismo y llévaselas a Isabel Jones, en Ciudad de Ventormenta.‡Récupérez 10 Gelées élémentaires sur n\'importe quel Élémentaire du Cataclysme, et apportez-les à Isabel Jones, à Hurlevent.‡从任意灾变元素生物身上收集10份元素粘稠物，把它们交给暴风城的伊莎贝尔·琼斯。‡從資料片浩劫與重生中的任何元素身上收集10份元素黏液，並送去暴風城給伊莎貝爾·瓊斯。',
  }
},
[25157] = {
  {
    'Tá na moda!‡Писк моды!‡Der letzte Schrei!‡최신 유행!‡¡La última moda!‡¡La última moda!‡C\'est la dernière mode !‡时尚潮流！‡最新的流行!',
    nil,
    'Teste a Poeira Estelar n.º 2 em 10 "cobaias humanoides".‡Опробуйте "Звездную пыль № 2" на людях.‡Testet den Sternenstaub No. 2 an 10 "humanoiden Testobjekten".‡2번 별가루를 가져가서 10명의 인간형 대상에게 시험해야 합니다.‡Prueba el polvo estelar nº 2 con 10 "sujetos humanoides".‡Prueba el polvo estelar nº 2 con 10 "sujetos humanoides".‡Testez la Poussière d\'étoile n°2 sur 10 « Sujets humanoïdes ».‡对10名“人型生物目标”测试星尘2号。‡在10名「人型目標」身上測試星塵2號。',
  }
},
[25158] = {
  {
    'Dentinho! Não!‡Грызун! Только не это!‡Nibbler! Nein!‡야금치! 안 돼!‡¡Mordisquitos! ¡No!‡‡Grignoteur ! Non !‡龅牙！不！‡啃咬者!不!',
    nil,
    'Lapide três Zefiritas Maciças e entregue-as para Marith Lazuria em Orgrimmar.‡Ограните три цельных зефирита и отдайте их Марит Лазурии в Оргриммаре.‡Schleift drei gediegene Zephyrite und gebt sie Marith Lazuria in Orgrimmar.‡단단한 서풍석 3개를 세공해서 오그리마에 있는 마리스 라주리아에게 전달해야 합니다.‡‡‡Taillez 3 Zéphyrites solides et donnez-les à Marith Lazuria à Orgrimmar‡切割3颗致密泽菲蓝晶石，把它们交给奥格瑞玛的玛瑞希·拉苏妮亚。‡切出三顆堅固的西風石並送去奧格瑪給瑪莉絲·拉撒莉亞。',
  }
},
[25159] = {
  {
    'Tá na moda!‡Писк моды!‡Der letzte Schrei!‡최신 유행!‡¡La última moda!‡¡La última moda!‡C\'est la dernière mode !‡时尚潮流！‡最新的流行!',
    nil,
    'Teste a Poeira Estelar n.º 2 em 10 "cobaias humanoides".‡Опробуйте "Звездную пыль № 2" на обывателях.‡Testet den Sternenstaub No. 2 an 10 "humanoiden Testobjekten".‡2번 별가루를 가져가서 10명의 인간형 대상에게 시험해야 합니다.‡Prueba el polvo estelar nº 2 con 10 "sujetos humanoides".‡Prueba el polvo estelar nº 2 con 10 "sujetos humanoides".‡Testez la Poussière d\'étoile n°2 sur 10 « Sujets humanoïdes ».‡对10名“人型生物目标”测试星尘2号。‡在10名「人型目標」身上測試星塵2號。',
  }
},
[25160] = {
  {
    'Um presente para Lila‡Подарок для Лайлы‡Ein Geschenk für Lila‡릴라를 위한 선물‡Un regalo para Lila‡Un regalo para Lila‡Un présent pour Lila‡给莉娜的礼物‡莉拉的禮物',
    nil,
    'Lapide três Noctilitas Eternas e entregue-as a Maria Lazuria em Orgrimmar.‡Ограните три вневременных камня ночи и отдайте их Марит Лазурии в Оргриммаре.‡Schleift drei zeitlose Nachtsteine und gebt sie Marith Lazuria in Orgrimmar.‡변함없는 야밤석 3개를 세공해서 오그리마에 있는 마리스 라주리아에게 가져가야 합니다.‡Talla tres piedras nocturnas intemporales y dáselas a Marith Lazuria, en Orgrimmar.‡Talla tres piedras nocturnas intemporales y dáselas a Marith Lazuria, en Orgrimmar.‡Taillez 3 Pierres de nuit intemporelles et donnez-les à Marith Lazuria à Orgrimmar.‡切割3颗永恒夜之石，把它们交给奥格瑞玛的玛瑞希·拉苏妮亚。‡切磨出三顆恆久的夜石，送去給奧格瑪的瑪莉絲·拉撒莉亞。',
  }
},
[25161] = {
  {
    'Ogrozânianas a procura de companhia‡Огрезонцы негодуют‡Ogermazonen in Stimmung‡오거조니아의 행복한 여자 오우거‡Las ogrozonianas están de humor‡Las ogrozonianas están de humor‡Les ogrezones amoureuses‡诡异的欧格佐尼亚斯‡興致勃勃的歐格索尼亞人',
    nil,
    'Lapide três Jaspes Serrilhados e entregue-os a Maria Lazuria em Orgrimmar.‡Ограньте три экземпляра зазубренной яшмы и отдайте их Марит Лазурии в Оргриммаре.‡Schleift drei gezackte Jaspise und gebt sie Marith Lazuria in Orgrimmar.‡톱니모양 벽옥 3개를 세공해서 오그리마에 있는 마리스 라주리아에게 전달해야 합니다.‡Talla tres jaspes dentados y entrégaselos a Marith Lazuria en Orgrimmar.‡Talla tres jaspes dentados y entrégaselos a Marith Lazuria en Orgrimmar.‡Taillez 3 Jaspes dentelés et donnez-les à Marith Lazuria à Orgrimmar‡切割3颗裂纹碧玉，把它们交给奥格瑞玛的玛瑞希·拉苏妮亚。‡切割三顆鋸齒的翠玉並送去奧格瑪給瑪莉絲·拉撒莉亞。',
  }
},
[25162] = {
  {
    '‡Клейкая субстанция элементалей‡Elementarglibber‡정기의 점액질‡Baba elemental‡Baba elemental‡La gelée élémentaire‡元素粘稠物‡元素黏液',
    nil,
    '‡Получите 10 порций клейкой субстанции с любых элементалей территорий Cataclysm и принесите их Марит Лазурии в Оргриммаре.‡Besorgt 10 Elementarglibber von beliebigen Cataclysm-Elementaren und bringt sie zu Marith Lazuria in Orgrimmar.‡아무 대격변 정령으로부터 정기의 점액질 10개를 획득하여 오그리마에 있는 마리스 라주리아에게 가져가야 합니다.‡Reúne 10 babas elementales de cualquier elemental del Cataclismo y llévaselas a Marith Lazuria, en Orgrimmar.‡Reúne 10 babas elementales de cualquier elemental del Cataclismo y llévaselas a Marith Lazuria, en Orgrimmar.‡Récupérez 10 Gelées élémentaires sur n\'importe quel Élémentaire du Cataclysme, et apportez-les à Marith Lazuria, à Orgrimmar.‡从任意灾变元素生物身上收集10份元素粘稠物，把它们交给奥格瑞玛的玛瑞希·拉苏妮亚。‡從資料片浩劫與重生中的任何元素身上收集10份元素黏液，並送去奧格瑪給瑪莉絲‧拉撒莉亞。',
  }
},
[25163] = {
  {
    'Quem é o responsável?‡Кто за этим стоит?‡Wer war das?‡누구의 소행인가?‡¿Quién lo hizo?‡¿Quién lo hizo?‡Qui a fait ça ?‡谁干的？‡誰做的好事?',
    nil,
    'Encontre um cadáver da Horda dentro da Bastilha Bael\'Dun.‡Обследуйте крепость Бейл\'дан и найдите тело ордынца.‡Sucht in Burg Bael\'dun nach einer Leiche der Horde.‡바엘던 요새 안에서 호드 시체를 찾아야 합니다.‡Busca un cadáver de la Horda dentro de la Fortaleza de Bael\'dun.‡Busca un cadáver de la Horda dentro de la Fortaleza de Bael\'dun.‡Essayez de trouver un cadavre de la Horde dans le Donjon de Bael’dun.‡在巴尔丹城堡中找到一具部落的尸体。‡在巴爾丹城堡裡搜索1具部落的屍體。',
  }
},
[25164] = {
  {
    'Encurralados‡Загнанные в угол‡In die Ecke gedrängt‡또다시 궁지에 몰리다‡Arrinconados‡Arrinconados‡Acculés‡背水一战‡逼入絕境',
    nil,
    'Defenda o acampamento da Harmonia Telúrica até que as nagas batam em retirada.‡Защищайте лагерь Служителей Земли, пока наги не отступят.‡Verteidigt das Lager des Irdenden Rings, bis die Naga sich zurückziehen.‡나가가 후퇴할 때까지 대지 고리회 야영지를 방어해야 합니다.‡Defiende el campamento del Anillo de la Tierra hasta que los nagas se retiren.‡Defiende el campamento del Anillo de la Tierra hasta que los nagas se retiren.‡Défendez le camp du Cercle terrestre jusqu’à ce que les nagas battent en retraite.‡保卫大地之环营地直到纳迦撤退。‡防禦陶土議會營地直到納迦撤退。',
  }
},
[25165] = {
  {
    'As aparências enganam‡Невинные глаза тоже лгут‡Große Haken und Lächeln sollten Misstrauen hervorrufen‡독침 주의‡Nunca te fíes de un gran pincho y una sonrisa‡Nunca te fíes de un gran pincho y una sonrisa‡Crache ton venin !‡永远不要相信大蝎刺和微笑‡永遠別相信藏刺的微笑',
    nil,
    'Obtenha 6 amostras de Peçonha de Escorpídeo posicionando o Totem de Extração de Veneno perto de um Escorpídeo Estalador.‡Получите 6 образцов яда скорпидов, поставив тотем извлечения яда на землю рядом с гремучим скорпидом.‡Erhaltet 6 Proben Skorpidtoxin, indem Ihr das Totem der Giftextraktion in der Nähe eines rasselnden Skorpids aufstellt.‡독성 추출 토템을 집게발전갈 주변에 설치하여 전갈 맹독 견본을 6번 채취해야 합니다.‡Consigue 6 muestras de veneno de escórpido colocando el tótem de extracción de veneno cerca de un escórpido castañeteante.‡Consigue 6 muestras de veneno de escórpido colocando el tótem de extracción de veneno cerca de un escórpido castañeteante.‡Récupérez 6 Échantillons de venin de scorpide en plaçant le Totem d’extraction de poison près d’un Scorpide cliquetant.‡将毒素萃取图腾插在巨钳蝎附近，收集6份蝎毒样本。‡在巨鉗蠍附近放置毒素萃取圖騰來取得6份蠍毒。',
  }
},
[25166] = {
  {
    'Capitão Barborrendo‡Капитан "Борода ужаса"‡Kapitän Schreckensbart‡선장 드레드비어드‡Capitán Barbatroz‡Capitán Barbatroz‡Le capitaine Barbeffroi‡恐须船长‡恐鬍上尉',
    nil,
    'Mate o Capitão Barborrendo.‡Убейте капитана "Борода Ужаса"‡Tötet Kapitän Schreckensbart.‡선장 드레드비어드를 처치해야 합니다.‡Mata al capitán Barbatroz.‡Mata al capitán Barbatroz.‡Tuez le Capitaine Barbeffroi.‡杀死恐须船长。‡殺死恐鬍上尉。',
  }
},
[25167] = {
  {
    'Quebrando as correntes‡Слабое звено‡Die Ketten durchbrechen‡보급 차단‡Rompiendo la cadena‡Rompiendo la cadena‡Rompre la chaîne‡斩断链条‡破壞補給線',
    nil,
    'Destrua 3 Caixotes de Suprimentos de Guardanorte e mate 10 Marujos de Guardanorte.‡Уничтожьте 3 ящика с припасами Северной Стражи и убейте 10 громил крепости Северной Стражи.‡Zerstört 3 Vorratskisten aus Nordwacht und tötet 10 Träger der Nordwacht.‡북부감시 보급품 상자를 3개 파괴하고 북부감시 짐꾼 10명을 처치해야 합니다.‡Destruye 3 cajones de suministros de Fuerte del Norte y mata a 10 arrastradores del Fuerte del Norte.‡Destruye 3 cajones de suministros de Fuerte del Norte y mata a 10 arrastradores del Fuerte del Norte.‡Détruisez 3 Caisses de fournitures de Guet-du-Nord et tuez 10 Porteurs de Guet-du-Nord.‡摧毁3只北方城堡补给箱，并杀死10个北卫军劳工。‡摧毀3個北方補給箱並殺死10個北方搬運工。',
  }
},
[25168] = {
  {
    'Expurgando o vale‡Очистить долину‡Das Tal reinigen‡골짜기 토벌‡Purgar el valle‡Purgar el valle‡Purger la vallée‡净化峡谷‡淨化村莊',
    nil,
    'Derrote 12 Soldados de Guardanorte na Base da Guardanorte.‡Убейте 12 солдат Северной Стражи в Крепи Северной Стражи.‡Besiegt 12 Trupps der Nordwacht am Vorposten der Nordwacht.‡북부감시 거점에서 북부감시 부대원 12명을 쓰러뜨려야 합니다.‡Derrota a 12 tropas de Fuerte del Norte en la Ciudadela del Fuerte del Norte.‡Derrota a 12 tropas de Fuerte del Norte en la Ciudadela del Fuerte del Norte.‡Vaincre 12 Troupiers de Guet-du-Nord dans la Tête de pont de Guet-du-Nord.‡在北卫军根据地击败12名北卫军的士兵。‡在北方根據地裡擊敗12名北方城堡的部隊成員。',
  }
},
[25169] = {
  {
    'A melhor defesa é o ataque‡Скажем нет агрессии Северной Стражи!‡Der Kampf gegen die Aggression der Nordwacht‡북부감시 거점 첩보 작전‡La guerra de la agresión de Fuerte del Norte‡La guerra de la agresión de Fuerte del Norte‡Guet-du-Nord attaque !‡北卫军的侵略战争‡北方城堡侵略站',
    nil,
    'Destrua os 3 conjuntos de Planos de Ataque mantidos dentro da Base da Guardanorte.‡Сожгите 3 комплекта планов нападения в Крепи Северной Стражи.‡Zerstört 3 Angriffspläne, die beim Vorposten der Nordwacht gelagert werden.‡북부감시 거점에서 세 종류의 공격 계획서를 없애야 합니다.‡Destruye 3 conjuntos de planes de ataque guardados en la Ciudadela del Fuerte del Norte.‡Destruye 3 conjuntos de planes de ataque guardados en la Ciudadela del Fuerte del Norte.‡Détruisez les 3 séries de Plans d’attaque qui se trouvent dans la Tête de pont de Guet-du-Nord.‡在北卫军根据地里摧毁3份进攻计划。‡在北方根據地裡摧毀3組攻擊計畫。',
  }
},
[25170] = {
  {
    'Faxina no litoral‡Зачистка побережья‡Küstensäuberung‡해안 청소‡Limpiando la costa‡Limpiando la costa‡Nettoyer le littoral‡清理海岸‡淨空海岸線',
    nil,
    'Obtenha 5 punhados de Muco de Rastejante.‡Добудьте 5 пригоршень слизи крабов.‡Erhaltet 5 Handvoll Kriechersekret.‡붉은톱니게 점액을 5개 획득해야 합니다.‡Consigue 5 puñados de mucosidad de reptador.‡Consigue 5 puñados de mucosidad de reptador.‡Obtenir 5 poignées de Mucus de clampant.‡收集5抷蟹胶。‡取得5份蟹膠。',
  }
},
[25171] = {
  {
    'Galopada‡Дорога верхом‡Weiterreiten‡도움 요청‡Dando una vuelta‡Dando una vuelta‡En selle !‡骑狼旅行‡乘狼',
    nil,
    'Fale com o Saqueador Jhash para que ele o leve ao Monte Navalha. Uma vez lá, fale com Gar\'Thok.‡Поговорите с налетчиком Джашем для того, чтобы он отправил вас на Колючий Холм. Как только доберетесь, поговорите с Гар\'током.‡Sprecht mit Räuber Jhash, um nach Klingenhügel zu gelangen. Sprecht mit Gar\'Thok, sobald Ihr angekommen seid.‡공격대원 자쉬와 대화하여 칼바위 언덕까지 탈것을 타고 가야 합니다. 도착하면 가르톡과 대화하십시오.‡Habla con el Asaltante Jhash para que te lleve a Cerrotajo. Una vez allí, habla con Gar\'thok.‡Habla con el Asaltante Jhash para que te lleve a Cerrotajo. Una vez allí, habla con Gar\'thok.‡Parlez à l\'Ecumeur Jhash pour vous rendre à Tranchecolline. Une fois sur place, parlez à Gar\'Thok.‡与狼骑兵希亚什交谈，让他送你前往剃刀岭。抵达之后，与加索克交谈。‡和狼騎兵希亞什談話，騎乘座狼抵達剃刀嶺。一旦到達那裡，去和加索克談話。',
  }
},
[25172] = {
  {
    'Invasores no nosso lar‡Если дорог тебе твой дом‡Eindringlinge in unserer Heimat‡우리 고향의 침략자‡Invasores en nuestro hogar‡Invasores en nuestro hogar‡Des envahisseurs sur notre terre‡家园里的入侵者‡家園的入侵者',
    nil,
    'Mate 7 Batedores de Guardanorte.‡Убейте 7 разведчиков Северной Стражи.‡Tötet 7 Späher der Nordwacht.‡북부감시 정찰병 7명을 처치해야 합니다.‡Mata a 7 exploradores del Fuerte del Norte.‡Mata a 7 exploradores del Fuerte del Norte.‡Tuer 7 Éclaireurs de Guet-du-Nord.‡杀死7个北卫军斥候。‡殺死7名北方斥候。',
  }
},
[25173] = {
  {
    'De mal a pior‡От плохого к худшему‡Schlimmer geht immer‡정세 악화‡De mal en peor‡De mal en peor‡De mal en pis‡越来越糟‡每下愈況',
    nil,
    'Mate 6 Fuzileiros de Guardanorte, 6 Atiradores de Elite de Guardanorte e o Tenente Pallitero na Bastilha Tiragarde.‡Отправляйтесь в крепость Тирагард и убейте там 6 моряков Северной Стражи, 6 метких стрелков Северной стражи и лейтенанта Паллитера.‡Tötet 6 Marinesoldaten der Nordwacht, 6 Heckenschützen der Nordwacht und Leutnant Palliter in Burg Tiragarde.‡타이라가드 요새에서 북부감시 해병 6명, 북부감시 명사수 6명, 부관 팰리터를 처치해야 합니다.‡Mata 6 soldados del Fuerte del Norte, 6 tiradores certeros del Fuerte del Norte y al teniente Palliter en el Fuerte de Tiragarde.‡Mata 6 soldados del Fuerte del Norte, 6 tiradores certeros del Fuerte del Norte y al teniente Palliter en el Fuerte de Tiragarde.‡Tuez 6 Soldats de marine de Guet-du-Nord, 6 Tireurs de précision de Guet-du-Nord et le Lieutenant Palliter au Donjon de Tiragarde.‡在提拉加德城堡中杀死6个北卫军水兵、6个北卫军射手和帕里特中尉。‡到提拉加德城堡殺死6名北方水兵、6名北方狙擊兵和帕爾利特中尉。',
  }
},
[25174] = {
  {
    'Duas-tranças precisa saber‡Генерал Двукосса желает знать‡Doppelzopf muss es wissen‡알아야만 할 정보‡Trenzado debe enterarse‡Trenzado debe enterarse‡Doublenattes doit savoir‡告知双辫将军‡塔文布萊德必須知道',
    nil,
    'Apresente-se ao General Duas-tranças na Patrulha de Duas-tranças, que fica nos Sertões Meridionais.‡Поговорите с генералом Двукоссой в Обходе Двукоссы в Южных Степях.‡Meldet Euch bei General Doppelzopf bei Doppelzopfs Patrouille im Südlichen Brachland.‡남부 불모의 땅, 트윈브레이드 지구대에 있는 장군 트윈브레이드에게 보고해야 합니다.‡Preséntate ante el general Trenzado en la Patrulla de Trenzado, en Los Baldíos del Sur.‡Preséntate ante el general Trenzado en la Patrulla de Trenzado, en Los Baldíos del Sur.‡Faites votre rapport au général Doublenattes à la Patrouille de Doublenattes, dans les Tarides du Sud.‡返回南贫瘠之地双辫将军的巡逻岗，向双辫将军复命。‡到南貧瘠之地的塔文布萊德巡防地向塔文布萊德將軍回報。',
  }
},
[25175] = {
  {
    'As más notícias‡Плохие новости‡Schlechte Nachrichten‡슬픈 소식‡Malas noticias‡Malas noticias‡Une mauvaise nouvelle‡坏消息‡壞消息',
    nil,
    'Leve a triste notícia para o General Duas-tranças na Patrulha Duas-tranças, que fica nos Sertões Meridionais.‡Принесите плохие новости генералу Двукоссе в Обход Двукоссы в Южных Степях.‡Überbringt General Doppelzopf bei Doppelzopfs Patrouille im Südlichen Brachland die schlechte Nachricht.‡남부 불모의 땅, 트윈브레이드 지구대에 있는 장군 트윈브레이드에게 슬픈 소식을 전해야 합니다.‡Lleva las malas noticias al general Trenzado en la Patrulla de Trenzado en Los Baldíos del Sur.‡Lleva las malas noticias al general Trenzado en la Patrulla de Trenzado en Los Baldíos del Sur.‡Apportez la mauvaise nouvelle au Général Doublenattes à la Patrouille de Doublenattes, dans les Tarides du Sud.‡前往南贫瘠之地双辫将军的巡逻岗，告诉双辫将军这一坏消息。‡到南貧瘠之地的塔文布萊德巡防地告訴塔文布萊德將軍這個壞消息。',
  }
},
[25176] = {
  {
    'Explorando a situação‡Воспользоваться случаем‡Die Situation ausnützen‡상황 이용‡Aprovechando la situación‡Aprovechando la situación‡Exploiter la situation‡顺手牵羊‡因勢制宜',
    nil,
    'Obtenha 6 peças do Tesouro de Kul Tiraz.‡Добудьте 6 кул-тирасских сокровищ.‡Erhaltet 6 Stücke vom Schatz von Kul Tiras.‡쿨 티라스 보물 6개를 모아야 합니다.‡Reúne 6 piezas de tesoro de Kul Tiras.‡Reúne 6 piezas de tesoro de Kul Tiras.‡Récupérer 6 Trésors de Kul Tiras.‡收集6份库尔提拉斯宝藏。‡取得6個庫爾提拉斯寶藏。',
  }
},
[25177] = {
  {
    'Interditado para banhistas‡Буря на взморье‡Die Strände stürmen‡해변의 물정령‡Arrasando las playas‡Arrasando las playas‡Une virée à la plage‡突袭海滩‡搶灘',
    nil,
    'Mate 11 Elementais do Mar Espumantes.‡Убейте 11 пенящихся морских элементалей.‡Tötet 11 schäumende Meereselementare.‡물거품 바다 정령을 11마리 처치해야 합니다.‡Mata 11 elementales de mar espumosos.‡Mata 11 elementales de mar espumosos.‡Tuez 11 Élémentaires marins écumants.‡杀死11只泡沫海元素。‡殺死11個泡沫海水元素。',
  }
},
[25178] = {
  {
    'Vasculhando destroços‡В поисках разбитых кораблей‡Schiffswracks durchsuchen‡난파선 수색‡Rastreando el naufragio‡Rastreando el naufragio‡Fouiller les épaves‡搜寻船骸‡搜尋船骸',
    nil,
    'Obtenha 4 conjuntos de Ferramentas Gnômicas.‡Раздобудьте 4 набора гномских инструментов.‡Erhaltet 4 Kisten Gnomenwerkzeuge.‡노움 공구 4개를 얻어야 합니다.‡Reúne 4 conjuntos de herramientas gnómicas.‡Reúne 4 conjuntos de herramientas gnómicas.‡Récupérer 4 jeux d\'Outils gnomes.‡收集4套侏儒的工具。‡取得4組的地精工具箱。',
  }
},
[25179] = {
  {
    'Redução de baixas‡Снижение потерь‡Abbau der Verluste‡피해 줄이기‡Reducción de bajas‡Reducción de bajas‡Réduire les pertes‡减少损失‡減少損失',
    nil,
    'Resgate 4 Brutos Feridos do Monte Navalha.‡Спасите 4 раненых рубак Колючего Холма.‡Rettet 4 verletzte Grunzer von Klingenhügel.‡부상당한 칼바위 언덕 그런트를 4명 구출해야 합니다.‡Rescata 4 toscos de Cerrotajo heridos.‡Rescata 4 toscos de Cerrotajo heridos.‡Sauvez 4 Grunts de Tranchecolline blessés.‡营救4个受伤的剃刀岭步兵。‡拯救4名受傷的剃刀嶺蠻兵。',
  }
},
[25180] = {
  {
    '‡Скрижали земли‡Tafeln der Erde‡대지의 서판‡Tablillas de la tierra‡Tablillas de la tierra‡Les tablettes de la Terre‡地之石板‡大地石板',
    nil,
    '‡Отнесите скрижали земли советнику Белграму в Стальгорн.‡Bringt die Tafeln der Erde zu Berater Belgrum in Eisenschmiede.‡아이언포지에 있는 조언자 벨그룸에게 대지의 서판을 가져가야 합니다.‡Lleva las tablillas de la tierra al consejero Belgrum en Forjaz.‡‡Apportez les Tablettes de la terre au Conseiller Belgrum à Forgefer.‡将地之石板带给铁炉堡的顾问贝尔格拉姆。‡',
  }
},
[25181] = {
  {
    '‡Скрижали огня‡Tafeln des Feuers‡불의 서판‡Tablillas de fuego‡Tablillas de fuego‡Les tablettes du Feu‡火之石板‡火焰石板',
    nil,
    '‡Принесите скрижали огня целительнице земли Норсале в Оргриммар.‡Bringt die Tafeln des Feuers zu Erdheilerin Norsala in Orgrimmar.‡오그리마에 있는 대지치유사 노르살라에게 불의 서판을 가져가야 합니다.‡Llévale las tablillas de fuego a la ensalmadora de la tierra Norsala en Orgrimmar.‡‡Apportez les Tablettes du feu à la Soigneterre Norsala à Orgrimmar.‡‡',
  }
},
[25182] = {
  {
    'Mate todos eles!‡Убить всех!‡Tötet sie alle!‡모두 해치워라!‡¡Que no quede títere con cabeza!‡¡Que no quede títere con cabeza!‡Zigouillez-les tous !‡杀光他们！‡殺光他們!',
    nil,
    'Mate 10 Mineradores de Lufa-lufa no Veio Lufa-lufa, que fica nos Sertões Meridionais.‡Убейте 10 шахтеров в шахтерском городке Дранфикса в Южных Степях.‡Tötet 10 Minenarbeiter von Frazzelcraz in Frazzelcraz\' Hauptader im Südlichen Brachland.‡남부 불모의 땅, 프라즐크라즈 광맥에서 프라즐크라즈 광부 10명을 처치해야 합니다.‡Mata a 10 mineros Catacroquer en Filón Catacroquer, en Los Baldíos del Sur.‡Mata a 10 mineros Catacroquer en Filón Catacroquer, en Los Baldíos del Sur.‡Tuez 10 Mineurs de Folcrame à la Veine de Folcrame, dans les Tarides du Sud.‡杀死10名在南贫瘠之地弗兹卡勒的主矿脉中劳作的弗兹卡勒矿工。‡在南貧瘠之地的弗雷卓克雷茲母礦殺死10名弗雷卓克雷茲礦工。',
  }
},
[25183] = {
  {
    '...E enterre o restante‡…и закопать остальных!‡… und vergrabt die Reste‡그리고 나머지는 묻어버려라‡Y entierra al resto...‡Y entierra al resto...‡… et enterrez le reste‡……并掩埋一切‡...埋了剩下的',
    nil,
    'Posicione 6 Explosivos no Veio Lufa-lufa, que fica na mina Lufa-lufa.‡Заложите 6 частей взрывчатки в шахтерском городке Дранфикса.‡Macht 6 Sprengsätze von Frazzelcraz in Frazzelcraz\' Hauptader scharf.‡프라즐크라즈 광맥 내부에서 프라즐크라즈 폭탄 6개를 폭파시킬 준비를 해야 합니다.‡Monta 6 explosivos de Catacroquer en la mina del Filón Catacroquer.‡Monta 6 explosivos de Catacroquer en la mina del Filón Catacroquer.‡Armez 6 Explosifs de Folcrame dans la mine de la Veine de Folcrame.‡在弗兹卡勒的主矿脉中装填6桶弗兹卡勒炸药。‡在弗雷卓克雷茲母礦內安裝6個弗雷卓克雷茲炸藥。',
  }
},
[25184] = {
  {
    'Passeio louco de vagonete‡Головокружительная поездка на тачке‡Wilder Minenwagenritt‡달려라, 광산 수레‡Trayecto en vagón de mina‡Trayecto en vagón de mina‡Le petit train de la mine‡乘坐采矿车‡狂野礦車滑行',
    nil,
    'Use o Vagonete da Mina para dar um passeio até o fim da linha e então fale com a Assistente Grilly.‡Заберитесь в вагонетку поезжайте на ней до конца маршрута, а потом поговорите с ассистенткой Грили.‡Reist mit dem Minenwagen an das Ende der Strecke und sprecht mit Assistentin Greely.‡광산 수레를 타고 선로 끝까지 간 다음 조수 그릴리와 대화해야 합니다.‡Utiliza el vagón de mina para llegar al final de la línea y habla con la ayudante Greely.‡Utiliza el vagón de mina para llegar al final de la línea y habla con la ayudante Greely.‡Utilisez le Chariot de mine pour aller jusqu\'au bout de la ligne, puis parlez à l\'Assistante Greely.‡乘坐采矿车抵达矿道尽头，然后与助手格瑞里谈一谈。‡利用礦坑推車行駛到軌道終點，然後和助理格里利談話。',
  }
},
[25185] = {
  {
    'Está feito‡Дело сделано‡Es ist vollbracht‡폭파 완료‡Ya está hecho‡Ya está hecho‡C\'est chose faite‡任务完成‡工作完成',
    nil,
    'Fale novamente com o General Duas-tranças na Patrulha Duas-tranças, que fica nos Sertões Meridionais.‡Вернитесь к генералу Двукоссе в Обход Двукоссы в Южных Степях.‡Kehrt zu General Doppelzopf an Doppelzopfs Patrouille im Südlichen Brachland zurück.‡남부 불모의 땅, 트윈브레이드 지구대에 있는 장군 트윈브레이드에게 가야 합니다.‡Vuelve con el general Trenzado en la Patrulla de Trenzado en Los Baldíos del Sur.‡Vuelve con el general Trenzado en la Patrulla de Trenzado en Los Baldíos del Sur.‡Retournez voir le Général Doublenattes à la Patrouille de Doublenattes, dans les Tarides du Sud.‡返回南贫瘠之地双辫将军的巡逻岗，向双辫将军复命。‡到南貧瘠之地的塔文布萊德巡防地找塔文布萊德將軍。',
  }
},
[25186] = {
  {
    'Resistência fútil‡Безрезультатное сопротивление‡Zweckloser Widerstand‡부질없는 저항‡Resistencia inútil‡Resistencia inútil‡Une résistance futile‡徒劳的反抗‡無謂的抵抗',
    nil,
    'Mate Rona Passo de Trovão na fronteira entre as Torres de Pedra e os Sertões Meridionais.‡Убейте Кону Шаг Грома на границе между Когтистыми Горами и Южными Степями.‡Tötet Kona Donnerlauf an der Grenze zwischen dem Steinkrallengebirge und dem Südlichen Brachland.‡돌발톱 산맥과 남부 불모의 땅 접경지에 있는 코나 썬더워크를 처치해야 합니다.‡Mata a Kona Camino del Trueno en la frontera entre el Espolón y Los Baldíos del Sur.‡Mata a Kona Camino del Trueno en la frontera entre el Espolón y Los Baldíos del Sur.‡Tuez Kona Marche-tonnerre à la frontière entre les Serres-rocheuses et les Tarides du Sud.‡杀死位于石爪山脉和南贫瘠之地交界处的科纳·雷行。‡在石爪山脈和南貧瘠之地之間的邊界殺死寇納‧雷行。',
  }
},
[25187] = {
  {
    'Ilhados‡Жертвы наводнения‡In den Fluten verloren‡홍수 속 실종자‡Perdidos en el desbordamiento‡Perdidos en el desbordamiento‡Perdu dans les flots‡迷失在洪水中‡遭洪水吞噬',
    nil,
    'Use a Luneta de Thonk para procurar por sobreviventes na Bacia Furiaustral.‡Разыщите выживших после разлива реки Строптивой с помощью подзорной трубы Тонка.‡Benutzt Thonks Handfernrohr, um in der Südstromaue nach Überlebenden zu suchen.‡통크의 망원경을 써서 성난남녘 분수령에 있는 생존자를 찾아야 합니다.‡Utiliza el catalejo de Thonk para buscar supervivientes en la Cuenca Furia del Sur.‡Utiliza el catalejo de Thonk para buscar supervivientes en la Cuenca Furia del Sur.‡Servez-vous de la Longue-vue de Thonk pour trouver des survivants dans le Débord de la Furie-du-Sud.‡使用索恩克的望远镜，在怒水河流域盆地搜索幸存者。‡利用通克的望遠鏡搜尋怒水河氾濫平原裡的生還者。',
  }
},
[25188] = {
  {
    'Resgate na Bacia Furiaustral‡Патрулирование Разлива Строптивой‡Die Aue patrouillieren‡분수령 정찰‡La patrulla de la cuenca‡La patrulla de la cuenca‡Patrouiller le débord‡巡逻流域盆地‡怒水搜尋',
    nil,
    'Faça uma busca na Bacia Furiaustral e ajude as pessoas que você avistou com a luneta.‡Отправляйтесь к Разливу Строптивой и помогите тем, кого вы видели в подзорную трубу.‡Sucht die Südstromaue nach den Leuten ab, die Ihr mit dem Handfernrohr gesehen habt und helft ihnen.‡성난남녘 분수령으로 가서 망원경으로 봤던 이들을 구조해야 합니다.‡Investiga la Cuenca Furia del Sur y ayuda a la gente que viste por el catalejo.‡Investiga la Cuenca Furia del Sur y ayuda a la gente que viste por el catalejo.‡Allez au Débord de la Furie-du-Sud et aidez les gens que vous avez vu dans la longue-vue.‡搜索怒水河流域盆地，帮助那些你用望远镜看到的人。‡搜尋怒水河氾濫平原並幫助你在望遠鏡裡看到的生還者。',
  }
},
[25189] = {
  {
    'Benditos espíritos‡Хвала духам‡Die Geister seien gelobt‡정령의 찬가‡Alabados sean los espíritus‡Alabados sean los espíritus‡Loués soient les esprits‡赞美万灵‡禮讚魂靈',
    nil,
    'Escolte a Grã-matrona Tekla até Raggaran.‡Проводите престарелую Теклу к Ярагану.‡Begleitet Großmatrone Tekla zu Raggaran.‡대모 테클라를 라가란에게 데려가야 합니다.‡Escolta a la gran matrona Tekla a Raggaran.‡Escolta a la gran matrona Tekla a Raggaran.‡Escortez la Grande-matrone Tekla jusqu\'à Raggaran.‡护送特克拉主母到拉格兰那里去。‡護送監護總管泰卡拉到拉迦連那兒。',
  }
},
[25190] = {
  {
    'A ira de Raggaran‡Ярость Ярагана‡Der Zorn Raggarans‡분노한 라가란‡La ira de Raggaran‡La ira de Raggaran‡La rage de Raggaran‡拉格兰的愤怒‡拉迦連的暴怒',
    nil,
    'Mate 4 Javatuscos Crinavalha e 4 Batedores Crinavalha.‡Убейте 4 свинобразов из племени Иглогривых и 4 разведчиков племени Иглогривых.‡Tötet 4 Stacheleber der Klingenmähnen und 4 Späher der Klingenmähnen.‡서슬갈기 가시멧돼지 4마리와 서슬갈기 정찰병 4마리를 처치해야 합니다.‡Mata 4 jabaespines Crines de Acero y 4 exploradores Crines de Acero.‡Mata 4 jabaespines Crines de Acero y 4 exploradores Crines de Acero.‡Tuez 4 Hurans tranchecrins et 4 Éclaireurs tranchecrins.‡杀死4个钢鬃野猪人和4个钢鬃斥候。‡殺死4隻剃鬃野豬人和4隻剃鬃斥候。',
  }
},
[25191] = {
  {
    'Investigue a destruição‡Исследование разрушений‡Begutachtet die Zerstörung‡파괴 현장 조사‡Peritar la destrucción‡Peritar la destrucción‡Évaluer la destruction‡调查灾情‡破壞評估',
    nil,
    'Fale com Nibb Rodafuso no Posto da Honra e faça um levantamento da destruição causada pelo cataclismo.‡Поговорите с Нибб Прядулягой на Заставе Чести, чтобы исследовать разрушения, вызванные катаклизмом.‡Sprecht mit Nibb Spindelgang in Ehrenwacht, um die Zerstörung des Kataklysmus zu vermessen.‡명예의 감시탑에 있는 니브 스핀들기어와 대화하여 대격변의 파괴 현장을 조사해야 합니다.‡Habla con Milo Tocamotores en Alto del Honor para peritar la destrucción del Cataclismo.‡Habla con Milo Tocamotores en Alto del Honor para peritar la destrucción del Cataclismo.‡Parlez à Nibb Fusécrou au Séjour de l’honneur pour évaluer la destruction causée par le cataclysme.‡跟荣耀岗哨的妮布·轴轮谈一谈，调查这场浩劫的情况。‡在榮譽看臺與妮布‧軸輪交談，以勘查災難的破壞程度。',
  }
},
[25192] = {
  {
    'A fúria de Raggaran‡Неистовство Ярагана‡Raggaran regt sich auf‡격분한 라가란‡La furia de Raggaran‡La furia de Raggaran‡La fureur de Raggaran‡拉格兰的怒火‡拉迦連的狂怒',
    nil,
    'Mate 5 Levanta-poeira Crinavalha e 5 Guardas de Batalha Crinavalha.‡Убейте 5 пылемутов из племени Иглогривых и 5 боевых стражей племени Иглогривых.‡Tötet 5 Staubläufer der Klingenmähnen und 5 Schlachtwachen der Klingenmähnen.‡서슬갈기 사막길잡이 5마리와 서슬갈기 전투호위병 5마리를 처치해야 합니다.‡Mata 5 polvorosos Crines de Acero y 5 guardias de batalla Crines de Acero.‡Mata 5 polvorosos Crines de Acero y 5 guardias de batalla Crines de Acero.‡Tuez 5 Lève-poussière tranchecrins et 5 Gardes de guerre tranchecrins.‡杀死5个钢鬃传令兵和5个钢鬃卫兵。‡殺死5隻剃鬃傳令兵和5隻剃鬃戰地衛士。',
  }
},
[25193] = {
  {
    'Em memória‡Пропавший, но не забытый‡Verloren, aber nicht vergessen‡죽어도 잊지 못하리‡Perdido, pero no olvidado‡Perdido, pero no olvidado‡Perdu, mais pas oublié‡刻骨铭心的伤痛‡逝去但不被遺忘',
    nil,
    'Obtenha 250 Dentes de Crocoliscos.‡Соберите 250 зубов кроколисков.‡Sammelt 250 Krokiliskenzähne.‡악어 이빨 250개를 획득해야 합니다.‡Consigue 250 dientes de crocolisco.‡Consigue 250 dientes de crocolisco.‡Obtenez 250 Dents de crocilisque.‡收集250颗鳄鱼的牙齿。‡取得250顆鱷魚牙齒。',
  }
},
[25194] = {
  {
    'Visitantes inoportunos‡Незваные гости‡Ungebetene Gäste‡예상치 못한 손님‡Visitantes inesperados‡Visitantes inesperados‡Têtes de piafs‡不请自来的访客‡未受邀請的訪客',
    nil,
    'Ataque 3 Pinotes Errantes até que eles fujam em direção aos Sertões.‡Заставить трех своенравных долгоногов побежать в сторону Степей.‡Greift 3 launische Ebenenschreiter an, bis sie in Richtung Brachland fliehen.‡난폭한 초원타조 3마리가 불모의 땅으로 건너갈 때까지 공격해야 합니다.‡Ataca a 3 zancudos de llanura díscolos hasta que huyan a los Baldíos.‡Ataca a 3 zancudos de llanura díscolos hasta que huyan a los Baldíos.‡Attaquez 3 Trotteurs des plaines voyageurs jusqu\'à ce qu\'ils fuient vers les Tarides.‡攻击3只游荡的平原陆行鸟，直到它们往贫瘠之地逃去。‡攻擊3隻遊蕩的平原陸行鳥，直到牠們逃向貧瘠之地。',
  }
},
[25195] = {
  {
    'Fim da linha para o raptor‡Вот и пришел конец этому ящеру‡Das Ende dieses Raptors‡그 랩터의 종말‡Este es el final de ese raptor‡Este es el final de ese raptor‡Débarrassons-nous de ce raptor‡迅猛龙的末日‡迅猛龍的末日',
    nil,
    'Mate o raptor chamado Gritaçoite.‡Убей ящера по имени Живоглот.‡Tötet den als Hiebkreischer bekannten Raptor.‡랩터 발톱울음을 처치해야 합니다.‡Mata al raptor llamado Gritotajo.‡Mata al raptor llamado Gritotajo.‡Tuez le raptor Tranchecri.‡杀死迅猛龙尖啸利爪。‡殺死名叫嘯割的迅猛龍。',
  }
},
[25196] = {
  {
    'Barreira Dranosh\'ar‡Застава Дранош\'ар‡Die Blockade von Dranosh\'ar‡드라노쉬아르 봉쇄선‡El Bloqueo Dranosh\'ar‡El Bloqueo Dranosh\'ar‡La barricade de Dranosh\'ar‡德拉诺什尔封锁线‡德拉諾許艾爾封鎖線',
    nil,
    'Fale com Gor, o Impositor, na Barreira Dranosh\'ar, que fica em Durotar.‡Отправляйтесь с докладом к Гору "Головорезу" на Заставу Драноша в Дуротар.‡Meldet Euch bei Gor dem Vollstrecker bei der Blockade von Dranosh\'ar.‡듀로타의 드라노쉬아르 봉쇄선에 있는 집행자 고르에게 보고해야 합니다.‡Preséntate ante Gor el Déspota en el Bloqueo Dranosh\'ar en Durotar.‡Preséntate ante Gor el agente en el Bloqueo Dranosh\'ar en Durotar.‡Présentez-vous à Gor le Massacreur à la Barricade de Dranosh\'ar en Durotar.‡向杜隆塔尔德拉诺什尔封锁线的执行者戈尔报到。‡回去杜洛塔的德拉諾許艾爾封鎖線向執法者戈爾回報。',
  }
},
[25197] = {
  {
    'O Almirante não recua‡Адмирал не отступит‡Der Admiral gibt nicht klein bei‡제독에게 후퇴는 없다‡El almirante no se echa atrás‡El almirante no se echa atrás‡L\'amiral meurt mais ne se rend pas !‡不愿撤离的海军司令‡上將不會示弱',
    nil,
    'Apresente-se ao Almirante Cochrane na Fortaleza da Guardanorte, que fica nos Sertões Meridionais.‡Поговорите с адмиралом Обри в Северной Страже в Южных Степях.‡Meldet Euch bei Admiral Aubrey in der Feste Nordwacht im Südlichen Brachland.‡남부 불모의 땅, 북부감시 요새에 있는 제독 오브리에게 보고해야 합니다.‡Preséntate ante el almirante Aubrey en Fuerte del Norte en Los Baldíos del Sur.‡Preséntate ante el almirante Aubrey en Fuerte del Norte en Los Baldíos del Sur.‡Présentez-vous à l\'Amiral Aubrey au Fort de Guet-du-Nord dans les Tarides du Sud.‡向南贫瘠之地北方城堡的海军司令奥布里报到。‡到南貧瘠之地的北方城堡向奧布里上將回報。',
  }
},
[25198] = {
  {
    '‡Винноа Сосновый Бор‡Winnoa Kiefernwald‡위노아 파인포레스트‡Winnoa Bosque de Pinos‡‡Winnoa Forêt-de-pins‡温诺亚·松林‡',
    nil,
    '‡Поговорите с Винноа Сосновый Бор в Лагере Вендетты в Южных Степях.‡Sprecht mit Winnoa Kiefernwald an der Vendettakuppe im Südlichen Brachland.‡남부 불모의 땅, 원한의 거점에 있는 위노아 파인포레스트와 대화해야 합니다.‡Habla con Winnoa Bosque de Pinos en Punta Vendetta, en Los Baldíos del Sur.‡‡Parlez à Winnoa Forêt-de-Pins à la Halte de la Vendetta, dans les Tarides du Sud.‡跟南贫瘠之地世仇哨站的温诺亚·松林谈一谈。‡',
  }
},
[25199] = {
  {
    'Instruções simples‡Начальная подготовка‡Grundbefehle‡기초 훈련‡Órdenes básicas‡Órdenes básicas‡Des ordres simples‡基本命令‡基礎命令',
    nil,
    'Siga as instruções do Sargento-instrutor Virabrequim e, então, apresente-se novamente ao Capitão Esteira Bicochispa.‡Следуйте командам сержанта-инструктора Парогона, после чего вернитесь к капитану Ступу Искражу.‡Folgt Ausbildungsoffizier Dampfkurbels Befehlen und meldet Euch dann bei Hauptmann Tret Funkdüse zurück.‡훈련교관 스팀크랭크가 보여주는 신호를 따라 한 후 대장 트레드 스파크노즐에게 보고해야 합니다.‡Sigue las indicaciones del sargento de maniobras Mecavapor y luego vuelve a informar al capitán Tread Chispaboquilla.‡Sigue las indicaciones del sargento de maniobras Mecavapor y luego vuelve a informar al capitán Tread Chispaboquilla.‡Suivez les instructions du Sergent instructeur Nébulevier, puis faites votre rapport au Capitaine Chape Étincetuyère.‡完成教官汽轴的命令，然后回去向崔德·火钻队长报告。‡跟著訓練中士蒸汽軸的口號動作，然後向特瑞德‧炫鼻上尉回報。',
  }
},
[25200] = {
  {
    'Que emocionante é uma partida de futebomba‡Выключение крошшеров‡Schredderangriff‡벌목기 정지‡Desconectar trituradoras‡Desconectar trituradoras‡Panne de déchiqueteur‡清理伐木机‡關掉伐木機',
    nil,
    'Derrote 8 jogadores do Flamingo de Bondebico.‡Убейте 8 акул Хитрой Шестеренки.‡Tötet 8 Dampfdruckhaie.‡스팀휘들 상어 선수 8명을 처치해야 합니다.‡Mata a 8 tiburones Bonvapor.‡Mata a 8 tiburones Bonvapor.‡Tuez 8 Requins de Gentepression.‡杀死8名热砂港大鲨鱼队的队员。‡殺死8名熱砂鯊魚隊員。',
  }
},
[25201] = {
  {
    'O melhor uniforme de futebomba do mundo‡Идеальная футбомбная униформа‡Die ultimative Fußbombenuniform‡궁극의 축구탄 제복‡El uniforme de bombalón supremo‡El uniforme de bombalón supremo‡La tenue de footbombe ultime‡终极足球炸弹制服‡終極足球炸彈戰鬥裝',
    nil,
    'Colete 8 Peças Sobressalentes de Retalhadora.‡Соберите 8 запчастей крошшера.‡Sammelt 8 Schredderersatzteile.‡벌목기 예비 부품 8개를 수집해야 합니다.‡Recoge 8 piezas de repuesto de trituradora.‡Recoge 8 piezas de repuesto de trituradora.‡Récupérez 8 Pièces détachées du déchiqueteur.‡收集8块伐木机备用零件。‡收集8份備用伐木機零件。',
  }
},
[25202] = {
  {
    'Caminhos do coração‡Кратчайший путь к сердцу‡Der schnellste Weg zu seinem Herzen‡마음에 도달하는 가장 빠른 방법‡El camino más rápido al corazón‡El camino más rápido al corazón‡Le plus court chemin vers son cœur‡通往他的内心的捷径‡如何最快得到他的心',
    nil,
    'Arranque o Coração Ainda Batendo do peito de Léo Pardo.‡Вырвите все еще бьющееся сердце из груди Чипа Идейла.‡Reißt Chip Endale das noch schlagende Herz aus der Brust.‡칩 엔데일의 가슴에서 텅 빈 마음을 훔쳐와야 합니다.‡Arranca el corazón que aún late del pecho de Locko Mia.‡Arranca el corazón que aún late del pecho de Locko Mia.‡Arrachez le Cœur palpitant de la poitrine de Benji Golo.‡从奇普·英代尔处收回贵重的黄金项链。‡挖出奇普·恩戴爾那顆仍在跳動的心臟。',
  }
},
[25203] = {
  {
    'Furando o fura-olho‡Что за имя такое – Чип?‡Wer heißt denn schon Chip?‡칩이라니, 무슨 이름이 그래?‡¿Qué clase de nombre es Locko?‡¿Qué clase de nombre es Locko?‡Et puis d\'abord, Benji, c\'est vraiment un nom ridicule !‡奇普是什么鬼名字？‡奇普是啥鳥名字?',
    nil,
    'Mate Léo Pardo.‡Убейте Чипа Идейла.‡Tötet Chip Endale.‡칩 엔데일을 처치해야 합니다.‡Mata a Locko Mia.‡Mata a Locko Mia.‡Tuez Benji Golo.‡杀死奇普·英代尔。‡殺死奇普·恩戴爾。',
  }
},
[25204] = {
  {
    'Abra as válvulas‡Система охлаждения‡Ein gelöstes Problem‡밸브 열기‡Abrir las válvulas‡Abrir las válvulas‡Ouvrez les valves‡打开阀门‡開啟閥門',
    nil,
    'Abra as Válvulas de 1 a 4.‡Откройте клапаны с 1-го по 4-й.‡Löst die Ventile 1 bis 4.‡밸브 1, 밸브 2, 밸브 3, 밸브 4를 열어야 합니다.‡Abre las cuatro válvulas.‡Abre las cuatro válvulas.‡Ouvrez les valves n°1 à 4.‡打开阀门#1至阀门#4。‡開啟1到4號閥門。',
  }
},
[25205] = {
  {
    'O lobo e o kodo‡Волк и кодо‡Der Wolf und der Kodo‡늑대와 코도‡El lobo y el kodo‡El lobo y el kodo‡Le loup et le kodo‡狼和科多兽‡狼與科多獸',
    nil,
    'Ouça a fábula de Shin Pilarpétreo.‡Выслушайте поучительную притчу Шина Каменостолба.‡Lauscht der Moral der Geschichte von Shin Steinsäule.‡신 스톤필라의 이야기를 듣고 교훈을 얻어야 합니다.‡Escucha la historia con moraleja de Shin Columnapétrea.‡Escucha la historia con moraleja de Shin Columnapétrea.‡Écoutez la morale de l’histoire de Gambe Pilepierre.‡听听希恩·石柱的寓言故事。‡聽取辛·石柱故事的寓意。',
  }
},
[25206] = {
  {
    'Ignorando avisos‡Пустые предостережения‡Die Warnungen nicht beachten‡경고 무시‡Ignorando las advertencias‡Ignorando las advertencias‡Ignorer les avertissements‡无视警告‡無視警告',
    nil,
    'Destrua 12 Elementais Antagônicos. Você pode matar tanto Terraguardas Furiosos quanto Guardaquáticos Fervilhantes.‡Убейте 12 неистовствующих элементалей. Подойдут гневные земляные стражи или бурлящие водяные стражи.‡Zerstört 12 verfeindete Elementare. Ihr könnt wütende Erdwächter oder belebte Wasserwächter töten.‡분쟁 중인 정령 12마리를 처치해야 합니다. 사나운 대지수호병이나 들끓는 물수호병을 종류에 상관없이 처치하면 됩니다.‡Destruye 12 elementales enfrentados. Puedes matar o bien guardias de tierra furiosos o guardias acuáticos prolíficos.‡Destruye 12 elementales enfrentados. Puedes matar o bien guardias de tierra furiosos o guardias acuáticos prolíficos.‡Détruisez 12 élémentaires en guerre. Vous pouvez, au choix, vous en prendre à des Gardes-terre furieux ou à des Gardes d’eau submergeants.‡杀死12个正在交战的元素生物。杀死狂怒的大地卫士或翻腾的水流卫士都可以。‡摧毀12個交戰中的元素。你可以殺死狂怒的大地守衛或是聚水守衛。',
  }
},
[25207] = {
  {
    'Óleo por óleo, acidente por acidente‡Прощай, черное золотце!‡Macht die Plattform platt‡안녕, 사랑스러운 기름이여‡Hasta la vista petróleo‡Hasta la vista petróleo‡Ce n\'est qu\'un au revoir, mon fuel‡再见，甜蜜的油井‡再見，我親愛的石油',
    nil,
    'Aperte o Grande Botão Vermelho para destruir a Plataforma de Petróleo da CCJ.‡Нажмите на большую красную кнопку, чтобы уничтожить нефтяную платформу ТКК.‡Drückt den großen roten Knopf auf der Ölplattform der HGK.‡큰 적색 단추를 눌러 케잔 무역 회사 굴착대를 파괴해야 합니다.‡Pulsa el gran botón rojo para destruir la Plataforma Petrolera SCK.‡Pulsa el gran botón rojo para destruir la Plataforma Petrolera SCK.‡Appuyez sur le Gros bouton rouge pour détruire la Plateforme pétrolière de la SCK.‡按下红色大按钮炸毁卡亚罗贸易公司钻井平台。‡按下紅色大按鈕以摧毀卡亞羅貿易公司石油平台。',
  }
},
[25208] = {
  {
    'Conte a Sílvia‡Донесение для Сильвии‡Berichtet Silvia‡실비아와의 대화‡Díselo a Silvia‡Díselo a Silvia‡Prévenir Silvia‡告诉西尔维亚‡告訴希爾薇雅',
    nil,
    'Fale com Sílvia na Torre de Estulan.‡Поговорите с Сильвией в башне Эстулана.‡Sprecht mit Silvia am Turm von Estulan.‡에스툴란의 탑에 있는 실비아와 대화해야 합니다.‡Habla con Silvia en la Torre de Estulan.‡Habla con Silvia en la Torre de Estulan.‡Parlez à Silvia à la Tour d\'Estulan.‡跟埃斯图兰之塔的西尔维亚谈一谈。‡到艾斯圖蘭之塔與希爾薇雅交談。',
  }
},
[25209] = {
  {
    'A ameaça Gordunni‡Угроза Гордунни‡Bedrohung durch die Gordunni‡골두니 일족의 위협‡La amenaza Gordunni‡La amenaza Gordunni‡Le péril gordunni‡戈杜尼的威胁‡來自戈杜尼的威脅',
    nil,
    'Mate 16 Ogros Gordunni na Selva Alta.‡Убейте 16 огров из клана Гордунни в Высокогорных дебрях.‡Tötet 16 Oger der Gordunni in der Oberen Wildnis.‡높은벌에서 골두니 오우거 16마리를 처치해야 합니다.‡Mata a 16 ogros Gordunni en las Altas Tierras Salvajes.‡Mata a 16 ogros Gordunni en las Altas Tierras Salvajes.‡Tuez 16 Ogres gordunni dans les Plateaux Sauvages.‡杀死高原荒野的16名戈杜尼食人魔。‡到高原荒野去殺死16個戈杜尼巨魔。',
  }
},
[25210] = {
  {
    'Sinais de mudança‡Знаки перемен‡Zeichen des Wandels‡변화의 징조‡Signos de cambio‡Signos de cambio‡Les augures d\'un changement‡改变的迹象‡改變的徵兆',
    nil,
    'Colete 8 Chifres de Cervos Infectados.‡Соберите 8 рогов зараженных оленей.‡Sammelt 8 infizierte Hirschgeweihe.‡오염된 사슴뿔 8개를 모아야 합니다.‡Reúne 8 astas de venados infectados.‡Reúne 8 cornamentas de venados infectados.‡Récoltez 8 Ramures de Cerfs infectés.‡收集8个被感染的鹿角。‡收集8份受到感染的鹿角。',
  }
},
[25211] = {
  {
    'Limpeza geral nas ruínas‡Сор из избы!‡Die Behausung säubern‡오두막 청소‡Limpiando las ruinas‡Limpiando las ruinas‡La fée du taudis‡大扫除‡打掃屋舍',
    nil,
    'Mate 5 Orcs Presa do Dragão em Dun Algaz.‡Убейте 5 орков из клана Драконьей Пасти в Дун Альгазе.‡Tötet 5 Orcs des Drachenmals in Dun Algaz.‡던 알가즈에 있는 용아귀 오크 5명을 처치해야 합니다.‡Mata a 5 orcos Faucedraco en Dun Algaz.‡Mata a 5 orcos Faucedraco en Dun Algaz.‡Tuez 5 Orcs Gueule-de-dragon à Dun Algaz.‡杀掉丹奥加兹的5名龙喉兽人。‡到丹奧加茲殺死15個龍喉獸人。',
  }
},
[25212] = {
  {
    'Radio atividade‡Разведать обстановку‡Am Rande der Schächte‡환기의 지평선‡Horizonte de conductos‡Horizonte de conductos‡Radiations à l\'horizon‡通风口测量‡通風地平線',
    nil,
    'Use a máquina voadora do Piloto Engenhoco para lançar Radiageigertrons nos dutos de ventilação ao redor de Gnomeregan.‡Воспользуйтесь летательным аппаратом пилота Винтоуха, чтобы сбросить радиометрозиметры в вентиляционные шахты Гномрегана.‡Benutzt Pilot Sprossmündungs Flugmaschine, um Radiageigatrons auf die Luftschächte um Gnomeregan herum zu werfen.‡조종사 머즐스프록의 비행기를 타고 간 다음 놈리건을 둘러싼 환기통에서 방사능측정장치를 던져 넣어야 합니다.‡Utiliza la máquina voladora del piloto Engranahocico para lanzar Radiageigatrones a los conductos de ventilación que rodean Gnomeregan.‡Utiliza la máquina voladora del piloto Engranahocico para lanzar Radiageigatrones a los conductos de ventilación que rodean Gnomeregan.‡Servez-vous de la machine volante du Pilote Muserouage pour jeter des Radiageigatrons dans les sorties de la ventilation de Gnomeregan.‡使用飞行员杰夫·玛兹斯波克的飞行工具，将辐射计量仪投放到诺莫瑞根周围的通风口去。‡搭乘駕駛員摩卓普拉克的飛行器，將輻射測量器丟進諾姆瑞根周圍的通風口中。',
  }
},
[25213] = {
  {
    'O Buraco do Escravo‡Ямы рабов‡Die Sklavengruben‡노예 구덩이‡Los Pozos de Esclavos‡Los Pozos de Esclavos‡Les fosses à esclaves‡奴隶营‡奴隸之坑',
    nil,
    'Fale com Espoleta Chaveforte no Buraco do Escravo.‡Поговорите с Хамми Кофельнагель в Ямах рабов.‡Sprecht mit Sassy Hartzang bei den Sklavengruben.‡노예 구덩이에 있는 새시 하드렌치와 대화해야 합니다.‡Habla con Sassy Malallave en Los Pozos de Esclavos.‡Habla con Sassy Malallave en Los Pozos de Esclavos.‡Parlez à Chipie Serrelavis aux Fosses à esclaves.‡跟奴隶营的莎希·硬钳谈一谈。‡在奴隸之坑和賽希·硬心談話。',
  }
},
[25214] = {
  {
    'Velocidade de escape‡Вторая космическая‡Flucht nach oben‡빠른 탈출‡Velocidad de escape‡Velocidad de escape‡La vitesse de l\'évasion‡极速逃逸‡逃亡的速度',
    nil,
    'Use os Foguetes Propulsores de Estágio Único para lançar para o espaço as jaulas de 8 Cidadãos de Kezan ou Sobreviventes Goblins.‡С помощью одноступенчатых ракет-носителей запустите в полет 8 клеток с кезанскими горожанами или уцелевшими гоблинами.‡Benutzt die einstufigen Trägerraketen, um die Käfige von 8 Bürgern von Kezan oder überlebenden Goblins in die Luft zu schießen.‡케잔 시민이나 고블린 생존자가 갇힌 철창 8개에 단식 보조 로켓을 사용해야 합니다.‡Usa los cohetes propulsores de una etapa para abrir las jaulas de 8 ciudadanos de Kezan o de supervivientes goblin.‡Usa los cohetes propulsores de una etapa para abrir las jaulas de 8 ciudadanos de Kezan o de supervivientes goblin.‡Utilisez les Fusées d\'appoint à un étage pour lancer les cages de 8 Citoyens de Kezan ou Survivants gobelins.‡使用单级助推火箭发射8只关押科赞公民或地精幸存者的牢笼。‡用一段式火箭推進器將8名凱贊居民或哥布林生還者的籠子發射出去。',
  }
},
[25215] = {
  {
    'Um odor perturbador‡Генеральная уборка‡Ein ablenkender Geruch‡정신 산만한 향기‡Un olor pestilente‡Un olor pestilente‡Diversion odorante‡扰人的气味‡滅跡',
    nil,
    'Arraste 3 Saqueadores Zin\'jatar Mortos para o mar aberto sobre o Abismo das Profundezas Cintilantes ao sul.‡Оттащите троих мертвых налетчиков Зин\'жатара в открытое море за Теснину Мерцающих Глубин.‡Zerrt 3 tote Räuber des Zin\'jatar in das offene Meer über der Glimmertiefenschlucht im Süden.‡죽은 진자타르 약탈자 시체 3구를 남쪽의 흐린심연 골짜기 너머 탁 트인 곳으로 끌고 가야 합니다.‡Arrastra a 3 asaltantes Zin\'jatar muertos a las aguas abiertas sobre el Barranco Brillahondo, al sur.‡Arrastra a 3 asaltantes Zin\'jatar muertos a las aguas abiertas sobre el Barranco Brillahondo, al sur.‡Traînez 3 Écumeurs Zin’jatar morts dans les eaux libres de la Gorge du Gouffre scintillant, au sud.‡将3具金加塔尔袭击者的躯体拖到南边光渊峡谷的开阔海域。‡把3個死亡的金加塔劫掠者拖到南方的深光峽谷的開放水域裡。',
  }
},
[25216] = {
  {
    'O grande Sambino‡Великий Самбино‡Der große Sambino‡위대한 샘비노‡El Gran Sambino‡El Gran Sambino‡Le grand Sambino‡了不起的萨比诺‡偉大的山比諾',
    nil,
    'Encontre "Sam" na extremidade oeste da Trincheira da Maré Prateada.‡Найдите "Сэма" на западе Котловины Серебряной Волны.‡Sucht nach "Sam" am westlichen Ende des Silberflutgrabens.‡은빛 너울 협곡 서쪽 끝에서 "샘"을 찾아야 합니다.‡Encuentra a "Sam" en el lado occidental de la Zanja de Marea Argenta.‡Encuentra a "Sam" en el lado occidental de la Zanja de Marea Argenta.‡Trouvez « Sam » à l’extrémité ouest de la Tranchée des Flots argentés.‡在银潮海沟西侧找到“萨姆”。‡到銀浪海溝最西端找「山姆」。',
  }
},
[25217] = {
  {
    'Alteração totêmica‡Тотемы нового поколения‡Totemmodifikation‡토템 조정‡Modificación de tótem‡Modificación de tótem‡Le totem modifié‡图腾改良‡改良過的圖騰',
    nil,
    'Coloque um dos totens modificados do Sambino nas areias da Trincheira da Maré Prateada.‡Поместите один из усовершенствованных тотемов Самбино в песок Котловины Серебряной Волны.‡Stellt eines von Sambinos modifizierten Totems im Sand des Silberflutgrabens auf.‡샘비노가 조정한 토템을 은빛 너울 협곡에 설치해야 합니다.‡Coloca uno de los tótems modificados de Sambino en la Zanja de Marea Argenta.‡Coloca uno de los tótems modificados de Sambino en la Zanja de Marea Argenta.‡Plantez l’un des totems modifiés de Sambino dans le sable de la Tranchée des Flots argentés.‡将萨比诺的改良型图腾安放在银潮海沟的沙石中。‡在銀浪海溝的砂礫上植入一個山比諾的改良圖騰。',
  }
},
[25218] = {
  {
    'Inflação submarina‡Подводный воздух‡Unterwasserinflation‡바닷속 인플레‡Hinchado submarino‡Hinchado submarino‡Gonflette sous-marine‡海底膨胀‡深海充氣',
    nil,
    'Encha um dos Balões de Ar do Sambino e encontre a Válvula de Ar Perdida.‡Наполните один из воздушных шаров Самбино и найдите его потерянный воздушный клапан.‡Füllt einen von Sambinos Luftballons und findet das verloren gegangene Luftventil.‡샘비노의 공기 풍선 하나를 채우고 그가 잃어버린 공기 밸브를 찾아야 합니다.‡Llena uno de los globos aerostáticos de Sambino y encuentra su válvula de aire perdida.‡Llena uno de los globos aerostáticos de Sambino y encuentra su válvula de aire perdida.‡Gonflez l’un des Ballons d’air de Sambino et retrouvez son Détendeur.‡给萨比诺的气球充气，找到他丢失的气阀。‡充飽山比諾的一個熱氣球並找出他遺失的氣閥。',
  }
},
[25219] = {
  {
    'Não seja moluscocêntrico‡Ракушкомания‡Nicht verschnecken‡달팽이의 비밀‡No te cierres como una almeja‡No te cierres como una almeja‡Sortez-les de leurs coquilles !‡别自蛳‡別那樣小氣',
    nil,
    'Junte 10 Caracóis-peneira.‡Соберите 10 улиток c витыми раковинами.‡Sammelt 10 Spiralmuschelknochenwühler.‡똬리껍질 달팽이 10마리를 모아야 합니다.‡Obtén 10 cernedores Concha Espiral.‡Obtén 10 cernedores Concha Espiral.‡Récoltez 10 Bigorneaux nettoyeurs.‡收集10条卷壳筛虫。‡收集10個盤殼篩選者。',
  }
},
[25220] = {
  {
    'Perigo escorregadio‡Скользкая угроза‡Glitschige Bedrohung‡미끄러운 위협‡Amenaza escurridiza‡Amenaza escurridiza‡Une menace glissante‡滑不溜手的威胁‡滑溜溜的威脅',
    nil,
    'Mate 12 Enguias Dentagulha.‡Убейте 12 шипозубых угрей.‡Tötet 12 Spitzzahnaale.‡뾰족니 장어 12마리를 처치해야 합니다.‡Mata 12 anguilas Dientepincho.‡Mata 12 anguilas Dientepincho.‡Tuez 12 Anguilles piquedent.‡杀掉12条刺牙鳗。‡殺死12條釘齒鰻。',
  }
},
[25221] = {
  {
    'Caça às nagas‡Погоня‡Verfolgungsjagd‡추격‡Atropello a la carga‡Atropello a la carga‡Pourchasser l’ennemi‡追捕‡追殺',
    nil,
    'Use a Lança de Caça de Toshe para abater 20 nagas Zin\'jatar fugitivas.‡Пронзите охотничьим копьем Тоша 20 убегающих наг Зин\'жатара.‡Benutzt Toshes Jagdspeer, um 20 fliehende Naga des Zin\'jatar zu töten.‡토셰의 사냥용 창으로 달아나는 진자타르 나가를 20마리 처치해야 합니다.‡Usa las lanzas cazadoras de Toshe para abatir a 20 naga Zin\'jatar en fuga.‡Usa las lanzas cazadoras de Toshe para abatir a 20 naga Zin\'jatar en fuga.‡Utilisez les Épieux de chasse de Toshe pour tuer 20 Nagas zin’jatar en déroute.‡用托什的狩猎长矛追捕20名逃跑的金加塔尔纳迦。‡使用塔許的狩獵長矛獵殺20個逃走的金加塔納迦。',
  }
},
[25222] = {
  {
    'Antro da Maré Prateada‡Пещера Серебряной Волны‡Die Silberfluthöhle‡은빛 너울 동굴‡Cuenca de Marea Argenta‡Cuenca de Marea Argenta‡Le creux des Flots argentés‡银潮谷‡銀浪谷地',
    nil,
    'Procure Felora Grinígnea no Antro da Maré Prateada.‡Найдите Фелору Огненное Кольцо в Пещере Серебряной Волны.‡Sucht nach Felora Feuerkranz in der Silberfluthöhle.‡은빛 너울 동굴에 있는 펠로라 파이어리스를 찾아야 합니다.‡Busca a Felora Coronafuego en la cuenca de Marea Argenta.‡Busca a Felora Coronafuego en la cuenca de Marea Argenta.‡Trouvez Felora Volutefeu dans le Creux des Flots argentés.‡去找银潮谷的费罗拉·火冠。‡在銀浪谷地找到菲蘿拉·火環。',
  }
},
[25223] = {
  {
    'Prova de fogo‡Испытание огнем‡Feuerprobe‡불의 시험‡Prueba de fuego‡Prueba de fuego‡Baptême du feu‡浴火尖兵‡火的試煉',
    nil,
    'Derrote 8 Instrutores Flamejantes.‡Победите 8 огненных наставников.‡Besiegt 8 feurige Instrukteure.‡불의 교관 8마리를 처치해야 합니다.‡Derrota a 8 instructores ígneos.‡Derrota a 8 instructores ígneos.‡Sortez vainqueur face à 8 Instructeurs embrasés.‡击败8名火焰导师。‡擊敗8個熾炎講師。',
  }
},
[25224] = {
  {
    'O desabrochar de um recruta‡В цвете‡In voller Blüte‡활짝 핀 화염꽃‡En flor‡En flor‡En fleur‡盛开‡盛開',
    nil,
    'Colha 5 Florescências de Chama.‡Добудьте 5 огненных цветков.‡Besorgt 5 Flammenblüten.‡화염꽃 5송이를 입수해야 합니다.‡Obtén 5 flores de llamas.‡Obtén 5 flores de llamas.‡Obtenez 5 Fleur-de-flammes.‡获得5株烈焰花。‡取得5朵焰綻花。',
  }
},
[25225] = {
  {
    '‡Замена смазки‡Ölwechsel‡‡Cambiar el aceite‡‡Changement de carburant‡‡',
    nil,
    '‡Соберите 6 порций каджарского масла категории 0В.‡Sammelt 6 Einheiten Kajaroöl 0W.‡‡Recoge 6 aceites Kajaro tipo 0W.‡‡Collectez 6 doses d\'Huile de grade 0W du Kajaro.‡‡',
  }
},
[25226] = {
  {
