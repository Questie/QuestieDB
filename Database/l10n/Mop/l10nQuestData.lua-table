},
[25022] = {
  {
    'Falha na comunicação‡Неудавшаяся попытка договориться‡Fehlkommunikation‡교섭 실패‡Error de comunicación‡Error de comunicación‡Mauvaise com\'‡失败的和谈‡失去聯絡',
    nil,
    'Resgate o Embaixador Gaines dos javatuscos na Profusão Verde.‡Спасите посла Гейнса от свинобразов в Буйных зарослях.‡Rettet Botschafter Gaines von den Stachelebern in der Überwucherung.‡우거진 땅에 있는 가시멧돼지로부터 대사 게인스를 구출해야 합니다.‡Rescata al embajador Gaines de los jabaespines en La Hojarasca.‡Rescata al embajador Gaines de los jabaespines en La Hojarasca.‡Sauvez l\'Ambassadeur Gaines des hurans dans le Lacis.‡从蔓生绿洲的野猪人手中救回盖恩斯大使。‡從蔓生之地的野豬人手中救回蓋恩斯大使。',
  }
},
[25023] = {
  {
    'Velhos amigos‡Старые друзья‡Alte Freunde‡옛 친구‡Viejos amigos‡Viejos amigos‡De vieux amis‡老朋友‡老朋友',
    nil,
    'Fale com Thrall na Guarita do Chefe Guerreiro, que fica nas Ilhas Perdidas.‡Поговорите с Траллом у дозорного пункта вождя на Затерянных островах.‡Sprecht mit Thrall am Spähposten des Kriegshäuptlings auf den Verlorenen Inseln.‡잃어버린 섬의 대족장의 망루에 있는 스랄과 대화해야 합니다.‡Habla con Thrall en la Atalaya del Jefe de Guerra, en Las Islas Perdidas.‡Habla con Thrall en la Atalaya del Jefe de Guerra, en Las Islas Perdidas.‡Parlez à Thrall au Poste de guet du Chef de guerre, sur les Îles Perdues.‡跟失落群岛酋长瞭望台的萨尔谈一谈。‡到失落群島的大酋長守望和索爾說話。',
  }
},
[25024] = {
  {
    'Expulse os paraquedistas!‡Противостояние десанту‡Vertreibt die Fallschirmjäger‡공수부대원 격퇴‡Repeler a los paracaidistas‡Repeler a los paracaidistas‡La chute des parachutistes‡击退伞兵‡擊退傘兵',
    nil,
    'Mate 10 Paraquedistas da Aliança.‡Убейте 10 парашютистов Альянса.‡Tötet 10 Fallschirmjäger der Allianz.‡얼라이언스 공수부대원 10명을 처치해야 합니다.‡Mata a 10 paracaidistas de la Alianza.‡Mata a 10 paracaidistas de la Alianza.‡Tuez 10 Parachutistes de l’Alliance.‡杀死10名联盟伞兵。‡殺死10名聯盟傘兵。',
  }
},
[25025] = {
  {
    'Sang\'thraze, a Defletora‡Санг\'траз Отражатель‡Sang\'thraze der Schmetterer‡굴절의 상트라제‡Sang\'thraze la Deflectora‡Sang\'thraze la Deflectora‡Sang’thraze la Déflectrice‡反击者桑萨斯‡反擊者桑薩斯',
    nil,
    'Derrote Zakkaru e consiga a Sang\'thraze Selada.‡Победите Заккару и заберите усмиренный Санг\'траз.‡Besiegt Zakkaru und erhaltet das versiegelte Sang\'thraze.‡자카루를 처치하고 봉인된 상트라제를 입수해야 합니다.‡Derrota a Zakkaru y recoge la Sang\'Thraze lacrada.‡Derrota a Zakkaru y recoge la Sang\'Thraze lacrada.‡Tuez Zakkaru et récupérez Sang’thraze scellée.‡击败扎卡鲁，获得被封印的桑萨斯。‡擊敗札克卡魯並取得封印的桑薩斯。',
  }
},
[25026] = {
  {
    'Mojo Meganegro‡Темнейший настой‡Dunkelstes Mojo‡가장 어두운 모조‡Mojo más oscuro‡Mojo más oscuro‡Le mojo enténébré‡至黯魔精‡最漆黑的魔精',
    nil,
    'Colete 6 Mojos Meganegros de Zumbis Zangareia.‡Убейте зомби из племени Песчаной Бури и соберите 6 темнейших настоев.‡Sammelt 6 dunkelstes Mojo von Zombies der Sandwüter.‡성난모래 좀비에게서 가장 어두운 모조 6개를 수집해야 합니다.‡Reúne 6 muestras de mojo más oscuro de los zombis Furiarena.‡Reúne 6 muestras de mojo más oscuro de los zombis Furiarena.‡Récupérez 6 Mojos enténébrés sur des Zombies furie-des-sables.‡从沙怒僵尸身上收集6份至黯魔精。‡從沙怒殭屍身上取得6個最漆黑的魔精。',
  }
},
[25027] = {
  {
    'Se essa selva fosse minha, eu mandava desmatar‡Отомстить Трехзубой‡Und das Schweinchen, das hat Zähne...‡여족장의 종말‡Cuestión de hojas‡Cuestión de hojas‡Le grand démembrement‡你轻轻地走了，不带走一根棘刺‡你輕敲著細籐，留給我葉子',
    nil,
    'Use o Tuscajado em Três-dentes e mate 2 Bruacas Anormais na Profusão Verde.‡Воспользуйтесь ежевичным посохом, чтобы победить Трехзубую, и убейте 2 загадочных ведьм в Буйных зарослях.‡Verwendet den Dornenstab gegen Dreizahn und tötet 2 Deviatgreisinnen in der Überwucherung.‡가시나무 지팡이를 세이빨에게 사용하고 우거진 땅에서 돌연변이 마녀 2마리를 처치해야 합니다.‡Usa la zarzarita en Tresdientes y mata a dos viejas brujas descarriadas en La Hojarasca.‡Usa la zarzarita en Tresdientes y mata a dos viejas brujas descarriadas en La Hojarasca.‡Utilisez le Bâton de ronce sur Trois-dents et tuez 2 de ses Mégères déviantes dans le Lacis.‡对蔓生绿洲的三瓣牙使用荆刺之杖，并杀死她身边的2名变异野猪人巫师。‡在蔓生之地將刺藤法杖使用在三齒的身上，然後殺死其他2名變異老巫婆。',
  }
},
[25028] = {
  {
    'Problemas brotando do chão‡Проблемы растут из земли‡Von Grund auf Ärger‡땅 속의 문제‡Problemas térreos‡Problemas térreos‡Des fleurs à la loupe‡地面的威胁‡來自地底的麻煩',
    nil,
    'Colete 10 Botões de Flor Incomuns da vegetação hipertrofiada.‡Соберите 10 необычных цветочных бутонов в Буйных зарослях.‡Sammelt 10 ungewöhnliche Blütenknospen von knospenden Blüten in der Überwucherung auf.‡우거진 땅에서 피어나는 꽃송이로부터 진귀한 꽃봉오리 10개를 모아야 합니다.‡Reúne 10 capullos poco corrientes de flores en ciernes en La Hojarasca.‡Reúne 10 capullos poco corrientes de flores en ciernes en La Hojarasca.‡Récoltez 10 Boutons de fleur insolites sur des Fleurs en bourgeon dans le Lacis.‡从蔓生绿洲中的初生的花朵上收集10个不寻常的花芽。‡從蔓生之地萌芽的花朵上採集10朵不尋常的花蕾。',
  }
},
[25029] = {
  {
    'Mortes na família‡Смерти в семье‡Todesfälle in der Familie‡가문의 몰살‡Muertes en la familia‡Muertes en la familia‡Des morts dans la famille‡阿加曼德家族‡阿加曼德家族',
    nil,
    'Obtenha os Restos Mortais de Gregor, os Restos Mortais de Nissa, os Restos Mortais de Timóteo e os Restos Mortais de Delmiro.‡Добудьте останки Грегора, Ниссы, Тармена и Девлина.‡Beschafft Euch die Überreste von Gregor, Nissa, Thurman und Devlin.‡니사의 유해, 그레고르의 유골, 투르만의 유골, 데블린의 유골을 모아야 합니다.‡Consigue los restos de Gregor, los restos de Nissa, los restos de Thurman y los restos de Devlin.‡Consigue los restos de Gregor, los restos de Nissa, los restos de Thurman y los restos de Devlin.‡Emparez-vous du Cadavre de Gregor, du Cadavre de Nissa, du Cadavre de Thurman et du Cadavre de Devlin.‡弄到格里高的遗物、妮萨的遗物、萨尔曼的遗物和代弗林的遗物。‡取得格里高的遺骸，妮薩的遺骸，薩爾曼的遺骸，以及戴弗林的遺骸。',
  }
},
[25030] = {
  {
    'Os moinhos assombrados‡Мельницы с привидениями‡Die Spukmühlen‡제분소의 유령‡Los molinos fantasma‡Los molinos fantasma‡Les moulins hantés‡闹鬼的磨坊‡鬧鬼的磨坊',
    nil,
    'Leve o Crânio de Dargol para Eurico Palhares, nos Moinhos dos Agamand.‡Отнечите череп Даргола Колману Фартингу на Мельницы Агамондов.‡Bringt Dargols Schädel zu Coleman Heller bei Agamands Mühlen.‡다르골의 해골을 콜만 파딩이 있는 아가만드 제분소로 가져가야 합니다.‡Lleva la calavera de Dargol a Coleman Farthing a los Molinos de Agamand.‡Lleva la calavera de Dargol a Coleman Farthing a los Molinos de Agamand.‡Apportez le Crâne de Dargol à Coleman Farthing aux Moulins d\'Agamand.‡将达高尔的徽记带给阿加曼德磨坊的库勒曼·法席恩。‡將達高爾的顱骨帶給阿加曼德磨坊的庫勒曼·法席恩。',
  }
},
[25031] = {
  {
    'Para os moinhos!‡Курс на мельницы‡Auf zu den Mühlen‡제분소를 향해‡En dirección a los molinos‡En dirección a los molinos‡En route pour les moulins‡前往磨坊‡磨坊復仇',
    nil,
    'Apresente-se a Eurico Palhares nos Moinhos dos Agamand, que fica nas Clareiras de Tirisfal.‡Поговорите с Колманом Фартингом на Мельницах Агамондов в Тирисфальских лесах.‡Meldet Euch bei Coleman Heller bei Agamands Mühlen in Tirisfal.‡티리스팔 숲의 아가만드 제분소에 있는 콜만 파딩에게 보고해야 합니다.‡Preséntate ante Coleman Farthing en los Molinos de Agramand en Claros de Tirisfal.‡Preséntate ante Coleman Farthing en los Molinos de Agramand en Claros de Tirisfal.‡Faites votre rapport à Coleman Farthing aux Moulins d\'Agamand, dans les Clairières de Tirisfal.‡去找提瑞斯法林地阿加曼德磨坊的库勒曼·法席恩。‡到提里斯法林地的阿加曼德磨坊向庫勒曼•法席恩回報。',
  }
},
[25032] = {
  {
    'Segredos do oásis‡Секреты оазиса‡Geheimnisse in der Oase‡오아시스의 비밀‡Secretos en el oasis‡Secretos en el oasis‡Le secret de l’oasis‡绿洲的秘密‡綠洲的秘密',
    nil,
    'Procure Jang\'thraze, a Protetora.‡Разыщите Джанг\'траз Охранитель.‡Sucht nach dem Jang\'thraze der Beschützer.‡보호의 장트라제를 찾아야 합니다.‡Busca Jang\'thraze la Protectora.‡Busca Jang\'thraze la Protectora.‡Cherchez Jang’thraze la Protectrice.‡寻找保护者迦萨斯。‡尋找保衛者迦薩斯。',
  }
},
[25033] = {
  {
    '‡Красный гонец‡Der Rote Bote‡붉은십자군 전령‡El mensajero rojo‡El mensajero rojo‡Le messager rouge‡十字军信使‡',
    nil,
    '‡Убейте Мевена Коргала в лагере рыцарей и получите информацию, которой он обладает.‡Tötet Meven Korgal den Boten am Lager der Kreuzzügler und stellt jegliche Informationen sicher, die Ihr finden könnt.‡‡Mata a Meven Korgal, el mensajero, en el campamento de los Cruzados, y obtén cualquier información que puedas encontrar.‡‡Tuez Meven Korgal, le messager, au Camp des croisés, et récupérez toutes les informations que vous pourrez trouver.‡‡',
  }
},
[25034] = {
  {
    'Para a frente de batalha!‡На фронт!‡An die Front!‡전선을 향하여!‡¡Al frente!‡¡Al frente!‡Au front !‡上前线！‡到前線去!',
    nil,
    'Encontre o Embaixador Gaines no Comando Avançado, que fica nos Sertões Meridionais.‡Разыщите посла Гейнса в передовой ставке в Южных Степях.‡Findet Botschafter Gaines im Gefechtsstand im Südlichen Brachland.‡남부 불모의 땅, 전방 지휘소에 있는 대사 게인스를 찾아야 합니다.‡Localiza al embajador Gaines en el Mando de Vanguardia en Los Baldíos del Sur.‡Localiza al embajador Gaines en el Mando de Vanguardia en Los Baldíos del Sur.‡Trouvez l’Ambassadeur Gaines au Quartier général avancé, dans les Tarides du Sud.‡在南贫瘠之地的前线指挥站找到盖恩斯大使。‡到南貧瘠之地的前線指揮營地找到蓋恩斯大使。',
  }
},
[25035] = {
  {
    'Ignorando a linha inimiga‡Прорыв обороны‡Die Linien durchbrechen‡경계 돌파‡Romper el frente‡Romper el frente‡Rompre la ligne‡突破防线‡突破防線',
    nil,
    'Fale com Jornun para conseguir transporte para o Covil dos Escamas Odiosas. Chegando lá, procure Morakki.‡Поговорите с Йорнуном, чтобы отправиться в грот Злобной Чешуи, а там найдите Моракки.‡Sprecht mit Jornun, um Euch einen Ritt zur Bucht der Gallschuppen zu sichern und sucht dort nach Morakki.‡조르눈과 대화하여 원한비늘 만으로 가는 탈것을 얻고 모라키를 찾아야 합니다.‡Habla con Jornun para asegurarte un transporte a la Cala Escama Maliciosa y busca a Morakki.‡Habla con Jornun para asegurarte un transporte a la Cala Escama Maliciosa y busca a Morakki.‡Parlez à Jornun pour faire le voyage jusqu’à la Crique des Vexécailles, puis allez voir Morakki.‡与佐奴恩交谈，前往恶鳞海湾，然后找到莫拉基。‡和喬弄說話，騎上坐騎前往惡鱗灣去找摩拉基。',
  }
},
[25036] = {
  {
    'Os problemas de Timeu‡Беспокойство Тигана‡Teegans Sorgen‡티간의 골칫거리‡La preocupación de Teegan‡La preocupación de Teegan‡Les ennuis de Teegan‡缇甘的麻烦‡提根的麻煩',
    nil,
    'Apresente-se ao Cabo Timeu na Expedição de Timeu, que fica nos Sertões Meridionais.‡Идите к капралу Тигану в Экспедицию Тигана в Южных Степях.‡Meldet Euch bei Korporal Teegan bei Teegans Expedition im Südlichen Brachland.‡남부 불모의 땅, 티간의 원정대에 있는 하사관 티간에게 보고해야 합니다.‡Preséntate ante el cabo Teegan en la Expedición de Teegan en Los Baldíos del Sur.‡Preséntate ante el cabo Teegan en la Expedición de Teegan en Los Baldíos del Sur.‡Faites votre rapport au Caporal Teegan à l\'Expédition de Teegan, dans les Tarides du Sud.‡向南贫瘠之地缇甘远征军营地的缇甘下士报到。‡到南貧瘠之地的提根遠征隊向提根下士回報。',
  }
},
[25037] = {
  {
    'Pescar caranguejo‡Ловля крабов‡Krebsfischen‡게 낚시‡Pescar cangrejos‡Pescar cangrejos‡À la pêche aux crabes‡捉螃蟹‡捕螃蟹',
    nil,
    'Mate Surfatiscos Pigmeus e consiga 5 nacos de Carne de Rastejante Fresca.‡Убейте карликовых приливных крабов и добудьте 5 порций свежего крабового мяса.‡Tötet Zwergbrandungskriecher und sammelt 5 Stücke frisches Kriecherfleisch.‡작은 붉은톱니게를 처치하여 신선한 게살 5개를 모아야 합니다.‡Mata reptadores de espuma pigmeos y recoge 5 trozos de carne de reptador fresca.‡Mata reptadores de espuma pigmeos y recoge 5 trozos de carne de reptador fresca.‡Tuez des Clampants de l\'écume pygmées et collectez 5 Chairs de clampant fraîches.‡杀死一些小海浪蟹，收集5份新鲜的螃蟹肉。‡殺死小海浪蟹並收集5份新鮮蟹肉。',
  }
},
[25038] = {
  {
    'Beijo do Gordo‡Задание Толстяка‡Gordos Aufgabe‡고르도의 임무‡La tarea de Gordo‡La tarea de Gordo‡La tâche de Gordo‡葛尔多的任务‡葛爾多的任務',
    nil,
    'Colha 3 Ervas-do-emo e entregue para o Boticário-júnior Holland, em Montalvo.‡Соберите 3 мракоцвета для младшего аптекаря Холланда из Брилла.‡Sammelt 3 Düsterkräuter und bringt sie zu Jungapotheker Holland in Brill.‡어둠풀 3개를 채집해 브릴에 있는 초보연금술사 홀랜드에게 가져가야 합니다.‡Recoge 3 hierbas luminiscentes y entrégaselas al boticario auxiliar Holland en Rémol.‡Recoge 3 hierbas luminiscentes y entrégaselas al boticario auxiliar Holland en Rémol.‡Récoltez 3 Herbes des ténèbres et apportez-les à l’Apprenti apothicaire Holland au Cimetière de Brill.‡收集3根阴暗草，把它们交给布瑞尔的初级药剂师霍兰德。‡收集3株陰暗草，並把它們帶給布瑞爾的初級藥劑師霍蘭德。',
  }
},
[25039] = {
  {
    '‡Воргенов не видали?‡Habt Ihr etwas Merkwürdiges gesehen?‡‡¿Has visto algo raro?‡‡Vous n\'avez rien vu de bizarre dans le coin ?‡‡',
    nil,
    '‡Поведайте палачу Зуганду о воргенах.‡Sprecht mit Exekutor Zygand über Eure Begegnung mit dem Worgen.‡‡Habla con el ejecutor Zygand sobre tu encuentro con el huargen.‡‡Parlez à l\'Exécuteur Zygand de votre rencontre avec les worgens.‡‡',
  }
},
[25040] = {
  {
    '‡‡‡FLAG - 늑대인간이 공격하다‡‡‡DRAPEAU - Attaqué par les worgens‡‡',
    nil,
    nil,
  }
},
[25041] = {
  {
    'Leões como esses dos Sertões‡Гордость льва‡Der Stolz des Löwen‡사자의 자부심‡Orgullo de león‡Orgullo de león‡La fierté du lion‡狮子的尊严‡獅子之傲',
    nil,
    'Mate 5 leões Predadores da Planície ou Jubaltivas da Planície, em qualquer combinação.‡Убейте равнинных хищников и хозяев стаи общим числом 5 особей.‡Tötet insgesamt 5 Ebenenstreuner oder Ebenenstolzmähnen.‡배회하는 초원사자나 우두머리 초원사자를 종류에 상관없이 총 5마리 처치해야 합니다.‡Mata cualquier combinación de 5 merodeadores y melenaorgullos de las llanuras.‡Mata cualquier combinación de 5 merodeadores y melenaorgullos de las llanuras.‡Tuez n’importe quelle combinaison de 5 Rôdeurs des plaines ou de Fiercrins des plaines.‡任意杀死5名只野徘徊者或原野傲鬃狮。‡殺死5隻的平地徘徊者或是平地傲鬃獅。',
  }
},
[25042] = {
  {
    'Saco vazio não para em pé‡Хороший солдат – сытый солдат‡Leerer Bauch marschiert nicht gern‡전투력의 원천‡Marchar con el estómago‡Marchar con el estómago‡Une armée marche avec son estomac‡填饱肚子‡靠我們的胃袋行軍',
    nil,
    'Mate Eletrossauros nos Sertões Meridionais e colete 4 Bifes Frescos de Eletrossauro.‡Приготовьте 4 стейка из свежей грозорылятины, убив грозорылов в Южных Степях.‡Besorgt 4 frische Sturmschnauzensteaks, indem Ihr Sturmschnauzen im Südlichen Brachland tötet.‡남부 불모의 땅에 있는 폭풍주둥이도마뱀을 처치하여 신선한 폭풍주둥이도마뱀 스테이크 4덩이를 모아야 합니다.‡Reúne 4 filetes de morrotormenta frescos que conseguirás matando a Morrotormentas en Los Baldíos del Sur.‡Reúne 4 filetes de morrotormenta frescos que conseguirás matando a morrotormentas en Los Baldíos del Sur. ‡Collectez 4 Steaks de groin-tempête frais en tuant des Groin-tempête dans les Tarides du Sud.‡杀死南贫瘠之地的雷角蜥蜴，收集4块新鲜的雷角蜥蜴肉排。‡殺死在南貧瘠之地的雷角蜥蜴，以收集4份新鮮的雷角蜥蜴肉排。',
  }
},
[25043] = {
  {
    'Campos de Sangue‡Кровавые поля‡Felder des Blutes‡피의 들판‡Campos de Sangre‡Campos de Sangre‡Les champs du Sang‡鲜血旷野‡鮮血草原',
    nil,
    'Mate 10 Brutos do Forte Desolação nos Campos de Sangue, que ficam nos Sertões Meridionais.‡Убейте 10 рубак Крепости Отчаяния в Кровавых полях, что в Южных Степях.‡Tötet 10 Ödnisgrunzer in den Feldern des Blutes im Südlichen Brachland.‡남부 불모의 땅, 피의 들판에서 황폐의 요새 그런트 10명을 처치해야 합니다.‡Mata a 10 brutos de la Desolación en los Campos de Sangre en Los Baldíos del Sur.‡Mata a 10 brutos de la Desolación en los Campos de Sangre en Los Baldíos del Sur.‡Tuez 10 Grunts de la Désolation aux Champs du Sang dans les Tarides du Sud.‡去南贫瘠之地的鲜血旷野，杀死10名凄凉蛮兵。‡在南貧瘠之地的鮮血草原殺死10名淒涼的蠻兵。',
  }
},
[25044] = {
  {
    'Diplomacia por outros meios‡Обратная сторона дипломатии‡Die etwas andere Diplomatie‡또 다른 외교 수단‡Diplomacia por otros medios‡Diplomacia por otros medios‡La diplomatie par d\'autres moyens‡另一种形式的外交‡外交的其他途徑',
    nil,
    'Leve a Trompa do Desafio para o Círculo de Desafio dos Costagulha, nos Sertões Meridionais. Sopre a trompa para desafiar Rinossabre e matá-lo.‡Принесите боевой рог на площадку Дыбогривов для боя в Южных Степях. Протрубите в него, чтобы вызвать на бой Саблеморда, и убейте его.‡Geht mit dem Horn der Herausforderung zum Herausforderungsring der Borstennacken im Südlichen Brachland. Lasst das Horn erschallen, um Säbelschnauze herauszufordern und tötet ihn.‡도전의 뿔피리를 가지고 남부 불모의 땅에 있는 뾰족털 도전의 투기장으로 가야 합니다. 뿔피리를 불어 칼주둥이에게 도전한 다음 해치우십시오.‡Lleva el cuerno de desafío al círculo de desafío Erizapúas en Los Baldíos del Sur. Sopla el cuerno para retar a Hozasable y mátalo.‡Lleva el cuerno de desafío al círculo de desafío Erizapúas en Los Baldíos del Sur. Sopla el cuerno para retar a Hozasable y mátalo.‡Prenez le Cor du défi et pénétrez dans le Cercle du défi dos-hirsute, dans les Tarides du Sud. Soufflez dans le cor pour défier Hurecroc en combat singulier et tuez-le.‡带上挑战之角前往南贫瘠之地的刺背挑战之环。吹响号角，向刃鼻发起挑战并杀死他。‡帶著挑戰號角到南貧瘠之地的刺背挑戰之環。吹響號角挑戰刃鼻並殺了他。',
  }
},
[25045] = {
  {
    'Um traço na areia‡Отступать некуда‡Eine Linie im Schmutz‡언덕 쟁탈전‡Una línea en el suelo‡Una línea en el suelo‡Délimiter notre territoire‡寸土必争‡泥土中的防線',
    nil,
    'Capture um morro neutro nos Campos de Sangue e defenda-o contra os contra-ataques da Horda.‡Захватите нейтральный холм в Кровавых полях и защитите его от атак Орды.‡Erobert einen neutralen Hügel in den Feldern des Blutes und verteidigt ihn gegen den Gegenangriff der Horde.‡피의 들판에 있는 중립 언덕을 점령하고 호드의 반격으로부터 방어해야 합니다.‡Conquista una colina neutral en los Campos de Sangre y defiéndela del contraataque de la Horda.‡Conquista una colina neutral en los Campos de Sangre y defiéndela del contraataque de la Horda.‡Prenez une colline neutre dans les Champs du Sang et défendez-la contre une contre-attaque de la Horde.‡夺取鲜血旷野中的一座中立丘陵，然后在那里抵御部落的反击。‡在鮮血草原奪下一座中立的山丘，並且防守住部落的反擊。',
  }
},
[25046] = {
  {
    'O abraço de uma filha‡Объятия дочери‡Die Umarmung einer Tochter‡딸의 한‡El abrazo de una hija‡El abrazo de una hija‡L\'étreinte d\'une fille‡女儿的拥抱‡女兒的擁抱',
    nil,
    'Leve Lilian Voss até o pai, na torre que fica no Caminho do Cruzado.‡Отведите Лилиан Восс к ее отцу в башню на Пути Рыцаря.‡Bringt Lilian Voss zu ihrem Vater im Turm am Kreuzfahrerpass.‡릴리안 보스를 십자군의 터에 위치한 탑에 있는 그녀의 아버지에게 데려가야 합니다.‡Lleva a Lilian Voss junto a su padre a la torre de la Senda del Cruzado.‡Lleva a Lilian Voss junto a su padre a la torre de la Senda del Cruzado.‡Accompagnez Lilian Voss auprès de son père dans la tour du Défilé du Croisé.‡把莉莉安·沃斯带到十字军小径她父亲的高塔里去。‡帶莉莉安·佛斯到十字軍小徑的塔樓去見她父親。',
  }
},
[25047] = {
  {
    'Estatueta de pantera quebrada‡Разбитая статуэтка пантеры‡Zerbrochene Pantherfigur‡부서진 표범 조각상‡Figurilla de pantera rota‡Figurilla de pantera rota‡La figurine de panthère cassée‡破损的黑豹雕像‡破損的獵豹刻像',
    nil,
    'Conserte a estatueta quebrada usando sua perícia e os materiais necessários.‡Почините разбитую статуэтку, применив необходимые умения и материалы.‡Repariert die zerbrochene Figur mit den Fähigkeiten und den Materialien, die Euch zur Verfügung stehen.‡보석세공 기술과 적절한 재료로 부서진 조각상을 수리해야 합니다.‡Repara la figurilla rota con tu habilidad y los materiales adecuados.‡Repara la figurilla rota con tu habilidad y los materiales adecuados.‡Réparez la figurine cassée en utilisant votre compétence et les matériaux appropriés.‡运用你的技能和材料，修复破损的雕像。‡用你的技巧與材料來修復破損的刻像。',
  }
},
[25048] = {
  {
    'Resgate dos suprimentos‡Спасение имущества‡Wiederverwertung an der Küste‡보급품 회수 작업‡Salvamento costero‡Salvamento costero‡Chasseur d’épaves‡海边打捞‡海濱撈寶',
    nil,
    'Recupere 7 Suprimentos de Bondebico.‡Соберите 7 контейнеров с припасами Хитрой Шестеренки.‡Sammelt 7 Dampfdruckvorräte.‡스팀휘들 보급품 7개를 수집해야 합니다.‡Recoge 7 suministros de Bonvapor.‡Recoge 7 suministros de Bonvapor.‡Récupérez 7 caisses de Ravitaillement de Gentepression.‡收集7份热砂补给品。‡收集7個熱砂補給物資。',
  }
},
[25049] = {
  {
    'Pisando na poça‡Топая по лужам‡Pfützenstampfer‡거인들로 들썩이는 웅덩이‡Chapoteando en los charcos‡Chapoteando en los charcos‡Plouf dans les flaques‡踩水坑‡踏浪',
    nil,
    'Mate 8 Andarilhos das Marés.‡Убейте 8 приливных странников.‡Tötet 8 Gezeitenschreiter.‡파도거인 8마리를 처치해야 합니다.‡Mata a 8 zancudos de marea.‡Mata a 8 zancudos de marea.‡Tuez 8 Marcheurs des marées.‡杀死8名潮行巨人。‡殺死8個逐潮者。',
  }
},
[25050] = {
  {
    'Carona numa cauda de foguete‡Спасательная ракета‡Raketenrettung‡로켓 구출 작전‡Rescate cohete‡Rescate cohete‡Les fusées de sauvetage‡火箭营救‡火箭救援',
    nil,
    'Entregue Foguetes Salva-vidas para 5 Sobreviventes de Bondebico e use bombas para matar 40 Bloqueadores dos Mares do Sul.‡Доставьте спасательные ракеты 5 уцелевшим из картеля и убейте бомбами 40 громил Южных морей.‡Bringt Lebensraketen zu 5 Überlebenden des Dampfdruckkartells und benutzt Bomben, um 40 Blockierer der Südmeerfreibeuter zu töten.‡스팀휘들 생존자 5명에게 구명로켓을 가져다주고 폭탄을 이용해 남쪽바다 봉쇄자 40명을 처치해야 합니다.‡Entrega cohetes salvavidas a 5 supervivientes Bonvapor y usa las bombas para matar a 40 bloqueadores de los Mares del Sur.‡Entrega cohetes salvavidas a 5 supervivientes Bonvapor y usa las bombas para matar a 40 bloqueadores de los Mares del Sur.‡Apportez des fusées de sauvetage à 5 Rescapés de Gentepression et utilisez les bombes pour tuer 40 Intercepteurs des mers du Sud.‡把救生火箭交给5名热砂港幸存者，用炸弹杀死40名南海封锁者。‡將救生火箭交給5個熱砂倖存者，並使用炸彈殺死40個南海攔路者。',
  }
},
[25051] = {
  {
    'A exterminação dos Névoa Negra‡Истребление пауков‡Graunebelausrottung‡거미 박멸‡Exterminio Niebla Negra‡Exterminio Niebla Negra‡L\'extermination des Sombrebrumes‡黑雾灭绝‡滅絕暗霧',
    nil,
    'Destrua 8 Ovos de Névoa Negra na Caverna Névoa Negra.‡Уничтожьте 8 яиц пауков Мглистой пещеры в Мглистой пещере.‡Zerstört 8 Graunebeleier in den Graunebelhöhlen.‡암흑안개 굴에서 암흑안개거미 알 8개를 파괴해야 합니다.‡Destruye 8 huevos Niebla Negra en la Caverna Niebla Negra.‡Destruye 8 huevos Niebla Negra en la Caverna Niebla Negra.‡Détruisez 8 Œufs sombrebrume, dans la caverne de Sombrebrume.‡在黑雾洞穴里摧毁8枚黑雾之卵。‡在暗霧洞穴裡摧毀8個暗霧蜘蛛蛋。',
  }
},
[25052] = {
  {
    'Tre... Quinze piratas sobre o caixão‡Сундук мертвеца‡Die Truhe des toten Mannes‡죽은 자의 상자‡Cofre de un hombre muerto‡Cofre de un hombre muerto‡Le coffre du mort‡加基森海盗：亡灵宝藏‡死人的箱子',
    nil,
    'Mate 15 Piratas dos Mares do Sul.‡Убейте 15 пиратов Южных морей.‡Tötet 15 Piraten der Südmeerfreibeuter.‡남쪽바다 해적 15명을 처치해야 합니다.‡Mata a 15 piratas de los Mares del Sur.‡Mata a 15 piratas de los Mares del Sur.‡Tuez 15 Pirates des mers du Sud.‡杀死15名南海海盗。‡殺死15個南海海賊。',
  }
},
[25053] = {
  {
    'Rumolotov!‡Дотла!‡Niederbrennen!‡땅으로!‡¡Hasta los cimientos!‡¡Hasta los cimientos!‡Des cendres aux cendres‡夷为平地！‡燒成灰燼!',
    nil,
    'Use a garrafa de Rumolotov para atear fogo na Cabana Noroeste, na Cabana Nordeste e na Cabana Sudoeste.‡Подожгите лачуги на северо-западе, северо-восторе и юго-западе с помощью горючего рома.‡Benutzt den brennenden Rum, um die nordwestliche Hütte, die nordöstliche Hütte und die südwestliche Hütte niederzubrennen.‡불타는 럼주를 이용해 북서쪽 판잣집, 남서쪽 판잣집과 북동쪽 판잣집에 불을 질러야 합니다.‡Utiliza el ron ardiente para prender fuego a la cabaña noroeste, la cabaña noreste y a la cabaña suroeste.‡Utiliza el ron ardiente para prender fuego a la cabaña noroeste, la cabaña noreste y a la cabaña suroeste.‡Utilisez le Rhum enflammé pour mettre le feu à la Cabane du nord-ouest, à la Cabane du nord-est et à la Cabane du sud-ouest.‡用灼烧的朗姆酒点燃西北小屋、东北小屋，以及西南小屋。‡使用燃燒的蘭姆酒點燃西北棚屋、東北棚屋和西南棚屋。',
  }
},
[25054] = {
  {
    'Pilhando o saque ou saqueando a pilhagem?‡Ограбить пиратов‡Beute plündern‡노획물 훔치기‡Qué botín, qué botín‡Qué botín, qué botín‡Piller les pirates‡抢宝贝‡打劫',
    nil,
    'Consiga 10 peças de Butim Pirata.‡Соберите 10 ящиков с пиратской добычей.‡Sammelt 10 Stück Piratenbeute.‡해적 노획물 10개를 수집해야 합니다.‡Reúne 10 piezas de botín de pirata.‡Reúne 10 piezas de botín de pirata.‡Rassemblez 10 Butins de pirate.‡获得10份海盗赃物。‡收集10份海賊寶藏。',
  }
},
[25055] = {
  {
    '‡Усмирение стихий‡Die Elemente kontrollieren‡정령 진압‡Subyugando a los elementos‡Subyugando a los elementos‡Élémentaire, mon cher…‡制伏元素‡',
    nil,
    '‡Гаван Серое Перо хочет, чтобы с помощью сапты стихий и тотема очищения из припасов Служителей Земли вы усмирили 20 потревоженных духов земли.‡Gavan Graufeder möchte, dass Ihr das Elementarsapta und das Läuterungstotem aus der Tasche mit den Vorräten des Irdenen Rings benutzt, um 20 aufgebrachte Erdgeister unter Kontrolle zu bringen.‡가반 그레이페더가 대지 고리회 보급품에 있는 정령의 정기와 정화 토템을 이용해 흥분한 대지의 정령 20마리를 진압해 달라고 했습니다.‡Gavan Plumagrís quiere que utilices la sapta elemental y el tótem de limpieza suministrados por el Anillo de la Tierra para subyugar a 20 espíritus de tierra perturbados.‡‡Gavan Griseplume veut que vous utilisiez le sapta élémentaire et le totem de purification du sac de fournitures du Cercle terrestre pour soumettre 20 Esprits de la terre agités.‡加文·灰羽要你使用大地之环补给品中的元素灵契和净化图腾，制服20个激动的大地之魂。‡',
  }
},
[25056] = {
  {
    'Cinzentos pestilentos‡Чумные мишки‡Grausige Grizzlys‡소름 끼치는 불곰‡Pellejos apestados‡Pellejos apestados‡Pif paf kodiak‡可怕的灰熊‡恐怖的灰熊',
    nil,
    'Obtenha 5 Pelegos de Urso Pestilento.‡Добудьте 5 шкур зачемленного мишки.‡Beschafft 5 Bälge eines verseuchten Braunbären.‡역병 걸린 불곰 가죽 5개를 모아야 합니다.‡Consigue 5 pellejos de oso apestado.‡Consigue 5 pellejos de oso apestado.‡Obtenez 5 Peaux d\'ours kodiak pestifiéré.‡获得5张染病褐熊的毛皮。‡取得5張染疫褐熊毛皮。',
  }
},
[25057] = {
  {
    'Ponham-nos a ferros‡В кандалы‡Werft sie in Ketten‡정당한 심판‡Ajústales los hierros‡Ajústales los hierros‡Jetez-les aux fers‡铐上他们‡軍令如鐵',
    nil,
    'Fale com os Saqueadores de Taurajo nas Ruínas Taurajo e lhes dê ordem de prisão. Use as Algemas da Guardanorte para subjugar 5 saqueadores feridos.‡Поговорите с мародерами Таурахо на руинах Таурахо и арестуйте их. Используйте кандалы Северной Стражи, чтобы арестовать 5 раненых мародеров.‡Sprecht mit Plünderern von Taurajo in den Überresten von Camp Taurajo und verhaftet sie. Benutzt die Handschellen von Nordwacht, um 5 verwundete Plünderer zu überwältigen.‡타우라조 폐허에 있는 타우라조 노략꾼들과 대화한 다음 체포하십시오. 부상당한 노략꾼 5명에게 북부감시 수갑을 사용해야 합니다.‡Habla con los despojadores de Taurajo en las ruinas de Taurajo y ponlos bajo arresto. Utiliza las esposas de Fuerte del Norte para subyugar a 5 despojadores heridos.‡Habla con los despojadores de Taurajo en las ruinas de Taurajo y ponlos bajo arresto. Utiliza las esposas de Fuerte del Norte para subyugar a 5 despojadores heridos.‡Parlez aux Pillards de Taurajo dans les Ruines de Taurajo et mettez-les en état d’arrestation. Utilisez les Menottes de Guet-du-Nord pour maîtriser 5 pillards blessés.‡跟陶拉祖废墟的陶拉祖强夺者谈一谈并逮捕他们。使用北卫军镣铐逮捕5名受伤的强夺者。‡在陶拉祖營地廢墟與陶拉祖營地強奪者交談並且逮捕他們。使用北方城堡的鐐銬制服5名受傷的強奪者。',
  }
},
[25058] = {
  {
    'Desarmando minas (à maneira goblin)‡Разминирование по-гоблински‡Minenentschärfung nach Goblinart‡지뢰 처리도 고블린답게‡Deshacerse de las minas a lo goblin‡Deshacerse de las minas a lo goblin‡Déminage, façon gobelins‡以地精的方式拆除地雷‡哥布林除雷法',
    nil,
    'Detone 10 Minas Terrestres.‡Взорвите 10 наземных мин.‡Sprengt 10 Landminen.‡지뢰 10개를 폭파해야 합니다.‡Detona 10 minas terrestres.‡Detona 10 minas terrestres.‡Faites exploser 10 Mines.‡引爆10枚地雷。‡引爆10枚地雷。',
  }
},
[25059] = {
  {
    'Os documentos de Taurajo‡Оперативные данные из Таурахо‡Die Taurajo Informationen‡타우라조에 묻힌 정보‡La información de Taurajo‡La información de Taurajo‡Les dossiers de Taurajo‡陶拉祖的情报‡陶拉祖營地的簡報',
    nil,
    'Vasculhe as Ruínas de Taurajo e encontre 3 documentos com Informações dos Taurajo.‡Обыщите руины Таурахо и найдите 3 документа оперативной информации Таурахо.‡Durchsucht die Überreste von Camp Taurajo nach 3 Geheiminformationen der Taurajo.‡타우라조 폐허를 뒤져 타우라조 정보 3장을 찾아내야 합니다.‡Busca por las ruinas de Taurajo 3 muestras de información de Taurajo.‡Busca por las ruinas de Taurajo 3 muestras de información de Taurajo.‡Fouillez les Ruines de Taurajo pour trouver 3 fragments de Renseignements du Camp Taurajo.‡在陶拉祖废墟搜寻3份陶拉祖情报。‡在陶拉祖營地廢墟尋找3張陶拉祖營地的情報。',
  }
},
[25060] = {
  {
    'Hmm... Defina "louco"‡Что такое "сумасшествие"‡Definiert "verrückt"‡"정신이 나갔다"라는 의미‡Define "Loco"‡Define "Loco"‡Définissez « cinglé »‡定义“疯狂”‡定義「瘋狂」',
    nil,
    'Mate 10 Sobreviventes Enlouquecidos.‡Убейте 10 уцелевших безумцев.‡Tötet 10 verrückte Überlebende.‡광기 어린 빌지워터 생존자 10명을 처치해야 합니다.‡Mata a 10 supervivientes enloquecidos.‡Mata a 10 supervivientes enloquecidos.‡Tuez 10 Survivants affolés.‡杀死10个疯狂的幸存者。‡殺死10個瘋狂的倖存者。',
  }
},
[25061] = {
  {
    'Próxima parada: Estação Fagulhaço‡Край земли‡Landende‡끝자락 해안‡El confín de la tierra‡El confín de la tierra‡La plage du Bout-du-monde‡世界的尽头‡天涯',
    nil,
    'Fale com Kelsey Fagulhaço na Estação Fagulhaço.‡Поговорите с Келси Стализвон на Станции Стализвон.‡Sprecht mit Kelsey Stahlfunken an der Station Stahlfunken.‡강철불꽃 거점에 있는 켈시 스틸스파크와 대화해야 합니다.‡Habla con Kelsey Chispacero en la Estación Chispacero.‡Habla con Kelsey Chispacero en la Estación Chispacero.‡Parlez à Kelsey Etinçacier, au Campement d’Etinçacier.‡跟钢烁哨站的凯尔希·钢烁谈一谈。‡到鋼火崗哨找凱爾希·鋼火說話。',
  }
},
[25062] = {
  {
    'À procura de respostas‡То, зачем мы пришли‡Warum wir hier sind‡얻고자 하는 것‡A lo que vinimos‡A lo que vinimos‡Les petits hommes verts‡我们来此的目的‡為何而來',
    nil,
    'Procure por evidências nos Baús do Borraquilha.‡Обыскать сундучки Трюмных вод в поисках информации о случившемся.‡Sucht in den Bilgewässer Schließkisten nach Hinweisen.‡빌지워터 사물함에서 증거를 찾아야 합니다.‡Busca pistas por los baúles de Pantoque.‡Busca pistas por los baúles de Pantoque.‡Cherchez des indices dans les Cantines de Baille-Fonds.‡在锈水箱里寻找证据。‡在污水置物箱中尋找線索。',
  }
},
[25063] = {
  {
    'Tartarugação‡Черепахизация‡Verschildkrötet‡거북이 사냥‡Tortugador‡Tortugador‡La tortue et la clé‡泥龟一族‡海龜世界',
    nil,
    'Obtenha uma Chave Digerida pela Tartaruga de uma Tartaruga Ondesliza.‡Добудьте ключ из желудка черепахи. Должно быть, его проглотила одна из гигантских береговых черепах.‡Erhaltet den von einer Schildkröte verdauten Schlüssel von einem Brandungsgleiter.‡파도거북에게서 거북이가 소화시킨 열쇠를 획득해야 합니다.‡Consigue una llave digerida por tortuga de un planoleador.‡Consigue una llave digerida por tortuga de un planoleador.‡Récupérez la Clé digérée par la tortue sur un Glisseur.‡从海浪龟身上获得海龟消化过的钥匙。‡從海浪龜身上取得烏龜消化過的鑰匙',
  }
},
[25064] = {
  {
    'Moraya‡Морайа‡Moraya‡모라야‡Moraya‡Moraya‡Moraya‡莫拉亚‡摩拉雅',
    nil,
    'Fale com Moraya.‡Поговорите с Морайей.‡Sprecht mit Moraya.‡모라야와 대화해야 합니다.‡Habla con Moraya.‡Habla con Moraya.‡Parlez à Moraya.‡跟莫拉亚谈谈。‡和摩拉雅談話。',
  }
},
[25065] = {
  {
    'Até tu, Bruto?‡И ты, Брут?‡Ein Schlag ins Gesicht‡짐승마저...‡¿Tú también, Bruto?‡¿Tú también, Bruto?‡Vraiment trognon‡你也是吗，蛮兵？‡你也是嗎，蠻卒?',
    nil,
    'Consiga o Baú Trancado de Caroça.‡Добудьте сундук Мордофарша.‡Beschafft die Truhe von Hackvisage.‡살덩이얼굴의 궤짝을 획득해야 합니다.‡Consigue el cofre de Carnécara.‡Consigue el cofre de Carnecara.‡Récupérez le Coffre de Trognechair.‡获得肉脸的箱子。‡取得肉臉的箱子。',
  }
},
[25066] = {
  {
    'O orgulho de Kezan‡Гордость Кезана‡Der Stolz von Kezan‡케잔의 명예호‡El orgullo de Kezan‡El orgullo de Kezan‡La fierté de Kezan‡科赞的骄傲‡凱贊之傲',
    nil,
    'Derrube 10 Caças Furtivos de Gnomeregan.‡Сбейте 10 гномреганских истребителей-невидимок.‡Schießt 10 Tarnkappenflugzeuge von Gnomeregan vom Himmel.‡놈리건 은신 전투기 10대를 저격해야 합니다.‡Abate 10 cazas sigilosos de Gnomeregan.‡Abate 10 cazas sigilosos de Gnomeregan.‡Descendez 10 Avions furtifs de Gnomeregan.‡击毁10架诺莫瑞根隐形战机。‡射下10架諾姆瑞根隱形戰機。',
  }
},
[25067] = {
  {
    'Cúpula do Trovão: O Grandepacas!‡Громодром: Ненормий!‡Donnerkuppel: Der Ginormus!‡천둥경기장: 자이노무스‡Truenódromo: ¡El Enormus!‡Truenódromo: ¡El Enormus!‡Le dôme du Tonnerre : l’Immenstrueux !‡雷霆斗技场：巨又霸！‡雷霆競技場:大巨人!',
    nil,
    'Derrote Lorde Grandepacas.‡Одержите победу над Ненормием.‡Besiegt Ginormus.‡자이노무스를 처치해야 합니다.‡Derrota al Señor Enormus.‡Derrota al Señor Enormus.‡Tuez le Seigneur Immenstrueux.‡击败巨又霸。‡擊敗大巨人。',
  }
},
[25068] = {
  {
    'Passado despedaçado‡Рассыпающееся прошлое‡Bruchstücke der Vergangenheit‡조각나는 과거‡Un pasado ruinoso‡Un pasado ruinoso‡Quand le passé tombe en ruine‡崩裂的历史‡粉碎的過去',
    nil,
    'Consiga 5 Joias Terranas.‡Соберите 5 самоцветов земли.‡Sammelt 5 Juwelen der Irdenen.‡대지의 보석 5개를 모아야 합니다.‡Reúne 5 joyas terráneas.‡Reúne 5 joyas terráneas.‡Rassemblez 5 Joyaux de terrestre.‡收集5份土灵珠宝。‡收集5個大地珠寶。',
  }
},
[25069] = {
  {
    'Os segredos de Uldum‡Тайны Ульдума‡Die Geheimnisse Uldums‡울둠의 비밀‡Los secretos de Uldum‡Los secretos de Uldum‡Les secrets d\'Uldum‡奥丹姆的秘密‡奧丹姆的秘密',
    nil,
    'Procure um artefato intacto na Antecâmara de Uldum.‡Осмотрите вестибюль Ульдума в поисках неповрежденных артефактов.‡Sucht in der Vorkammer von Uldum nach einem unzerstörten Artefakt.‡울둠의 대기실에서 온전한 유물을 찾아야 합니다.‡Registra la antecámara de Uldum en busca de un artefacto intacto.‡Registra la antecámara de Uldum en busca de un artefacto intacto.‡Fouillez l’antichambre d’Uldum à la recherche d’un Artéfact intact.‡搜索奥丹姆前厅，寻找安然无恙的神器。‡在奧丹姆的前廳內尋找完整的神器。',
  }
},
[25070] = {
  {
    'O que há lá dentro?‡Что сокрыто внутри‡Was im Inneren ist‡궤짝 안에 든 물건‡Lo que hay en el interior‡Lo que hay en el interior‡Le secret du coffre‡里面是什么‡裡頭的東西',
    nil,
    'Derrote do Guardião da Antecâmara.‡Победите привратника.‡Besiegt den Wächter der Vorkammer.‡대기실 수호자를 처치해야 합니다.‡Derrota al guardián de la antecámara.‡Derrota al guardián de la antecámara.‡Tuez le Gardien de l’antichambre.‡击败前厅守卫者。‡擊敗前廳守護者。',
  }
},
[25071] = {
  {
    '‡‡‡FLAG - 보라색 멀록‡‡‡DRAPEAU - Murloc violet‡‡',
