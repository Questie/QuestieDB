},
[31053] = {
  {
    'Tracking Event: Started Shado-Pan Dailies‡Tracking Event: Started Shado-Pan Dailies‡Tracking Event: Started Shado-Pan Dailies‡이벤트 추적: 음영파 일일 퀘스트 시작‡Evento de seguimiento: comienzo de las diarias del Shadopan‡‡Tracking Event: Started Shado-Pan Dailies‡跟踪事件：已开始影踪派日常任务‡',
    nil,
    'Uma‡‡‡레벨 1 탕랑 평원‡‡‡‡‡',
