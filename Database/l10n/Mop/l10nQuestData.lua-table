[25789] = {
  {
    '‡Докопаться до истины‡Es hat sich ausgehammert‡‡Rómpete el coco‡‡Le Marteau enfonce le clou‡‡',
    nil,
    '‡Отнесите загадочное устройство в Оргриммар, Подгород, Луносвет или Громовой Утес и покажите его представителю Служителей Земли.‡Bringt das mysteriöse Gerät nach Orgrimmar, Unterstadt, Silbermond oder Donnerfels und zeigt es einem Botschafter des Irdenen Rings.‡‡Lleva el dispositivo misterioso a Orgrimmar, a Entrañas, a Ciudad de Lunargenta o a Cima del Trueno y muéstraselo a un representante del Anillo de la Tierra.‡‡Apportez le Mystérieux appareil à Orgrimmar, Fossoyeuse, Lune-d\'Argent ou aux Pitons-du-Tonnerre et montrez-le à un Représentant du Cercle terrestre.‡‡',
  }
},
[25790] = {
  {
    'De volta para o Crazzle‡Назад к Краззлу‡Zurück zu Crazzle‡다시 크래즐에게‡Regresa con Crazzle‡Regresa con Crazzle‡Retour à la case Pignouf‡回去找克拉兹‡回到克拉索那兒',
    nil,
    'Fale com Crazzle Molavivaz na Serra do Casco Fendido, que fica em Mil Agulhas.‡Поговорите с Краззлом Шустрецом на Утесе Треснувшего Копыта в Тысяче Игл.‡Sprecht mit Crazzle Flinkspross in Spalthufanhöhen in Tausend Nadeln.‡버섯구름 봉우리의 갈래발굽 언덕에 있는 크래즐 스프리스프로켓과 대화해야 합니다.‡Habla con Crazzle Engranágil en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Habla con Crazzle Engranágil en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Parlez à Pignouf Fulgurouage, dans les Hauteurs du Sabot fendu, dans les Mille pointes.‡同千针石林裂蹄高地的克拉兹·滑链交谈。‡在千針石林的裂蹄陵地與克拉索·滑鏈交談。',
  }
},
[25791] = {
  {
    'De volta para o Riznek‡Назад к Ризнеку‡Zurück zu Riznek‡다시 리즈넥에게‡Regresa con Riznek‡Regresa con Riznek‡Retour à la case Riznek‡回去找瑞兹尼克‡回到瑞茲尼克那兒',
    nil,
    'Fale novamente com Riznek na Serra do Casco Fendido, que fica em Mil Agulhas.‡Поговорите с Ризнеком на Утесе Треснувшего Копыта в Тысяче Игл.‡Sprecht mit Riznek in Spalthufanhöhen in Tausend Nadeln.‡버섯구름 봉우리의 갈래발굽 언덕에 있는 리즈넥과 대화해야 합니다.‡Habla con Riznek en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Habla con Riznek en Las Cumbres Pezuña Quebrada en Las Mil Agujas.‡Parlez à Riznek, dans les Hauteurs du Sabot fendu, dans les Mille pointes.‡同千针石林裂蹄高地的瑞兹尼克交谈。‡在千針石林的裂蹄陵地與瑞茲尼克交談。',
  }
},
[25792] = {
  {
    'Sempre em frente!‡Наступление‡Vorwärts drängen‡밀어붙이기‡El avance‡El avance‡La barrière asphyxiante‡推进‡往前推進',
    nil,
    'Use a Runa de Fogo para destruir 4 Totens de Constrição no Front Jubafria.‡Воспользуйтесь руной огня, чтобы разрушить 4 тотема удушения на передовой Мерзлогривов.‡Benutzt die Rune des Feuers, um 4 Totems der Konstriktion an der Frontlinie der Frostmähnen zu zerstören.‡불의 룬을 사용해 서리갈기 싸움터에 있는 압박의 토템 4개를 파괴해야 합니다.‡Utiliza la runa de Fuego para destruir 4 tótems de constricción en el Frente de Peloescarcha.‡Utiliza la runa de Fuego para destruir 4 tótems de constricción en el Frente de Peloescarcha.‡Utilisez la Rune de feu pour détruire 4 Totems constricteurs le long du Front Crins-de-givre.‡使用烈焰符文在霜鬃前线摧毁4根压缩图腾。‡用火之符文在霜鬃前線摧毀4個壓迫圖騰。',
  }
},
[25793] = {
  {
    'As Entranhas da Terra‡Глубокие плёсы‡Die Ausufernden Tiefen‡깊은 산마루‡La Hondura Insondable‡La Hondura Insondable‡Le Fin-fond‡幽暗曲径‡礦坑深層',
    nil,
    'Fale com McGee Pé-de-Aço nas Entranhas da Terra, que ficam na Cordilheira das Torres de Pedra.‡Поговорите с Железной Лапой Макги в Глубоких Плесах в Когтистых горах.‡Sprecht mit Stahlzeh McGee an den Ausufernden Tiefen im Steinkrallengebirge.‡돌발톱 산맥의 깊은 산마루에 있는 스틸토 맥기와 대화해야 합니다.‡Habla con Piesdeacero McGee en La Hondura Insondable, en Sierra Espolón.‡Habla con Piesdeacero McGee en La Hondura Insondable, en Sierra Espolón.‡Parlez à Orteil-d’acier McGee au Fin-fond des Serres-Rocheuses.‡跟石爪山脉幽暗曲径的钢趾麦格谈一谈。‡到石爪山脈的礦坑深層找鋼趾·麥克基說話。',
  }
},
[25794] = {
  {
    'Santuário submarino‡Подводное убежище‡Zuflucht unter dem Meer‡해저 성역‡Santuario submarino‡Santuario submarino‡Sanctuaire subaquatique‡海底避难所‡海底避難所',
    nil,
    'Use o Orbe de Vidência de Erunak para ver a localização da Gruta Densanévoa.‡Загляните в гадальный шар Эрунака, чтобы выяснить, где находится Дымчатый грот.‡Benutzt Erunaks Seherkugel, um die Position der Tiefennebelgrotte zu sehen.‡에루낙의 수정구를 사용하여 깊은안개 종유동의 위치를 찾아야 합니다.‡Usa el orbe de visión de Erunak para ver la posición de Gruta Brumadensa.‡Usa el orbe de visión de Erunak para ver la posición de Gruta Brumadensa.‡Utilisez l’Orbe de divination d’Erunak pour voir l’endroit où se trouve la Grotte Brume-épaisse.‡使用埃鲁纳克的占卜球观测重雾洞穴的位置。‡使用伊魯納克的占卜寶珠觀看深霧岩洞的位置。',
  }
},
[25795] = {
  {
    'De volta ao santuário‡Возвращение в святилище‡Rückkehr zum Schrein‡다시 제단으로‡Regresa al santuario‡Regresa al santuario‡Retour au sanctuaire‡回到圣殿‡重回聖壇',
    nil,
    'Fale novamente com Choluna no Santuário de Aviana, no Monte Hyjal.‡Вернитесь к Чолуне в святилище Авианы на горе Хиджал.‡Kehrt zu Choluna am Schrein von Aviana auf dem Hyjal zurück.‡하이잘 산의 아비아나의 제단에 있는 초루나에게 가야 합니다.‡Vuelve con Choluna en el Santuario de Aviana en Monte Hyjal.‡Vuelve con Choluna en el Santuario de Aviana en Monte Hyjal.‡Retournez voir Choluna au sanctuaire d’Aviana, sur le Mont Hyjal.‡去找海加尔山艾维娜圣殿的楚伦娜。‡回去海加爾山的艾維娜聖壇找克魯娜。',
  }
},
[25796] = {
  {
    'Desapropriação‡Богатые недра‡Enteignung‡기름진 영토‡Dominio inminente‡Dominio inminente‡Dans les hautes terres‡强行征用‡突出的領域',
    nil,
    'Mate 15 centauros da Serra do Casco Fendido.‡Убейте 15 кентавров на Утесе Треснувшего Копыта.‡Tötet 15 Zentauren der Spalthufanhöhen.‡갈래발굽 언덕 켄타우로스를 15마리 처치해야 합니다.‡Mata a 15 centauros de las Cumbres Pezuña Quebrada.‡Mata a 15 centauros de las Cumbres Pezuña Quebrada.‡Tuez 15 Centaures des Hauteurs du Sabot fendu.‡杀死15只裂蹄高地半人马。‡殺死15名裂蹄高地的半人馬。',
  }
},
[25797] = {
  {
    'Desapropriação‡Богатые недра‡Enteignung‡기름진 영토‡Dominio inminente‡Dominio inminente‡Dans les hautes terres‡强行征用‡突出的領域',
    nil,
    'Mate 15 centauros da Serra do Casco Fendido.‡Убейте 15 кентавров на Утесе Треснувшего Копыта.‡Tötet 15 Zentauren der Spalthufanhöhen.‡갈래발굽 언덕 켄타우로스를 15마리 처치해야 합니다.‡Mata a 15 centauros de las Cumbres Pezuña Quebrada.‡Mata a 15 centauros de las Cumbres Pezuña Quebrada.‡Tuez 15 Centaures des Hauteurs du Sabot fendu.‡杀死15只裂蹄高地半人马。‡殺死15名裂蹄高地的半人馬。',
  }
},
[25798] = {
  {
    'Proteja a perfuratriz‡На защиту бура‡Verteidigt den Turm!‡굴착 장치를 사수하라‡Defiende la plataforma petrolera‡Defiende la plataforma petrolera‡Opération : Exploitation sauvage‡保卫钻机‡鑽油防守',
    nil,
    'Proteja a Perfuradeira de Petróleo.‡Защитите оборудование для добычи нефти.‡Verteidigt den Ölbohrturm.‡원유 굴착 장치를 보호해야 합니다.‡Defiende la plataforma petrolera.‡Defiende la plataforma petrolera.‡Défendez le Trépan.‡保卫钻油机。‡防守鑽油機。',
  }
},
[25799] = {
  {
    'Proteja a perfuratriz‡На защиту бура‡Verteidigt den Turm!‡굴착 장치를 사수하라‡Defiende la plataforma petrolera‡Defiende la plataforma petrolera‡Opération : Exploitation sauvage‡保卫钻机‡鑽油防守',
    nil,
    'Proteja a Perfuradeira de Petróleo.‡Защитите оборудование для добычи нефти.‡Verteidigt den Ölbohrturm.‡원유 굴착 장치를 보호해야 합니다.‡Defiende la plataforma petrolera.‡Defiende la plataforma petrolera.‡Défendez le Trépan.‡保卫钻油机。‡防守鑽油機。',
  }
},
[25800] = {
  {
    'Caranguejos da vida‡Не было бы счастья, да несчастье помогло‡Wenn das Leben dir Krabben schenkt...‡인생이 우울할 때‡Cuando la vida te da cangrejos‡Cuando la vida te da cangrejos‡A la pêche aux crabes-crabes-crabes…‡生活给了你螃蟹‡當生命給你螃蟹',
    nil,
    'Colete 5 Garras Carnudas de Rastejante dos Baitiscos.‡Добудьте 5 мясистых клешней крабов гавани.‡Findet 5 fleischige Kriecherklauen von Hafenkriechern.‡항구게를 사냥해 살이 많은 집게발 5개를 모아야 합니다.‡Recoge 5 patas de reptador carnosas de reptadores de puerto.‡Recoge 5 patas de reptador carnosas de reptadores de puerto.‡Récoltez 5 Pinces de clampant charnues sur des Clampants de port.‡从港湾蟹身上拆5只多肉的蟹爪。‡從海港蟹身上收集5個多肉的蟹爪。',
  }
},
[25801] = {
  {
    'Garras das profundezas‡Угроза из глубин‡Klauen aus der Tiefe‡멀록과 고블러‡Zarpas de las profundidades‡Zarpas de las profundidades‡Les griffes des profondeurs‡海中的鱼人‡海中的魚人',
    nil,
    'Colete a Cabeça de Comilão e mate 12 Murlocs Guelrazul de qualquer tipo.‡Добудьте голову Жруна и убейте 12 мурлоков любого вида из племени Синежабрых.‡Holt Euch Gobblers Kopf von Gobbler und tötet 12 beliebige Murlocs der Blaukiemen.‡고블러를 처치해 고블러의 머리를 획득하고, 푸른아가미 멀록 12마리를 처치해야 합니다.‡Consigue la cabeza de Engullidor y mata a 12 múrlocs Branquiazul cualesquiera.‡Consigue la cabeza de Engullidor y mata a 12 múrlocs Branquiazul cualesquiera.‡Coupez la Tête d’Enfourneur et tuez 12 Murlocs Branchies-bleues.‡从高布勒尔那儿拿走高布勒尔的徽记，杀死12名任意种类的蓝鳃鱼人。‡從高布勒爾身上取得高布勒爾的頭顱，並殺死12個藍鰓魚人。',
  }
},
[25802] = {
  {
    'O que é nosso de direito‡Украденные товары‡Waren-Wiederbeschaffung‡뱃짐 되찾기‡Recuperación de bienes‡Recuperación de bienes‡Récupération de marchandises‡寻找货物‡奪回雕像',
    nil,
    'Vasculhe os caixotes e barris nos acampamentos dos murlocs na costa.‡Обыщите ящики и бочки в прибрежных поселениях мурлоков.‡Durchsucht die Kisten und Fässer in den Murloclagern an der Küste.‡해안가의 멀록 소굴에서 상자와 통을 찾아야 합니다.‡Busca los cajones y barriles en los campamentos múrloc de la costa.‡Busca los cajones y barriles en los campamentos múrloc de la costa.‡Fouillez les caisses et les barils dans les camps murlocs le long de la côte.‡在沿海的鱼人营地搜索木箱和木桶。‡搜索海邊魚人村落中的木箱和木桶。',
  }
},
[25803] = {
  {
    'A busca continua‡Поиски продолжаются‡Die Suche geht weiter‡계속되는 수색‡La búsqueda continúa‡La búsqueda continúa‡La recherche continue‡继续搜寻‡繼續搜尋',
    nil,
    'Procure a Estatueta de Menethil.‡Найдите статуэтку Менетила.‡Sucht nach der Statuette von Menethil.‡메네실 조각상을 찾아야 합니다.‡Busca la Estatuilla de Menethil.‡Busca la Estatuilla de Menethil.‡Cherchez la statuette de Menethil.‡寻找米奈希尔雕像。‡搜索米奈希爾雕像。',
  }
},
[25804] = {
  {
    'Vasculhe mais cabanas‡Поиски в поселениях мурлоков‡Suche in weiteren Hütten‡다른 멀록 소굴 수색‡Inspecciona más casuchas‡Inspecciona más casuchas‡À la recherche d\'autres taudis‡搜索小屋‡搜尋雕像',
    nil,
    'Continue vasculhando as cabanas dos Murlocs em busca da Estatueta de Menethil.‡Продолжайте поиски статуэтки Менетила в поселениях мурлоков.‡Sucht weiter in den Hütten der Murlocs nach der Statuette von Menethil.‡멀록 소굴에서 메네실 조각상을 계속 찾아봐야 합니다.‡Sigue buscando la Estatuilla de Menethil en las casuchas de los múrlocs.‡Sigue buscando la Estatuilla de Menethil en las casuchas de los múrlocs.‡Continuez à fouiller les taudis des murlocs pour retrouver la Statuette de Menethil.‡继续在鱼人小屋里寻找米奈希尔雕像。‡繼續在魚人村落中搜尋米奈希爾雕像的蹤跡。',
  }
},
[25805] = {
  {
    'Devolva a estatueta‡Возвращение статуэтки‡Rückgabe der Statuette‡조각상 돌려주기‡Devuelve la Estatuilla‡Devuelve la Estatuilla‡Rapporter la statuette‡归还雕像‡歸還雕像',
    nil,
    'Leve a Estatueta de Menethil a Carlos Borba no Porto de Menethil, que fica no Pantanal.‡Отнесите статуэтку Менетила Карлу Борану в Гавань Менетилов, что в Болотине.‡Bringt Karl Boran im Hafen von Menethil im Sumpfland die Statuette von Menethil.‡저습지의 메네실 항구에 있는 칼 보란에게 메네실 조각상을 가져가야 합니다.‡Lleva la Estatuilla de Menethil a Karl Boran al Puerto de Menethil, en Los Humedales.‡Lleva la Estatuilla de Menethil a Karl Boran al Puerto de Menethil, en Los Humedales.‡Apportez la Statuette de Menethil à Karl Boran dans le Port de Menethil, dans les Paluns.‡把米奈希尔雕像还给湿地米奈希尔港的卡尔·伯伦。‡到濕地的米奈希爾港，將米奈希爾雕像還給卡爾‧波蘭。',
  }
},
[25806] = {
  {
    'Antes quatro-olhos do que morto‡В такой глубокой… а, ничего.‡Sie haben die Assass in... ach, egal‡등 뒤의 암살자는... 신경 끄세요‡Asesinos silenciosos‡Asesinos silenciosos‡Les assassins ont mauvaise mine‡他们把刺客放进来……算了‡他們把刺客...算了',
    nil,
    'Mate 12 Assassinos de Krom\'gar.‡Убейте 12 кром\'гарских убийц.‡Tötet 12 Auftragsmörder von Krom\'gar.‡크롬가르 암살자 12명을 처치해야 합니다.‡Mata a 12 asesinos Krom\'gar.‡Mata a 12 asesinos Krom\'gar.‡Tuez 12 Assassins de Krom’gar.‡消灭12名克罗姆加刺客。‡殺死12個克羅姆加刺客。',
  }
},
[25807] = {
  {
    'O despertar da anciã‡Возрождение древней богини‡Die Wiedergeburt eines Ahnen‡다시 태어난 고대정령‡Un ancestro renace‡Un ancestro renace‡La renaissance d\'un ancien‡一个古神的重生‡祖靈的重生',
    nil,
    'Use o Incenso do Arauto diante do Ovo de Aviana no Santuário de Aviana.‡Примените фимиам вестника на яйце Авианы в святилище Авианы.‡Benutzt das Rauchwerk des Herolds vor Avianas Ei im Schrein von Aviana.‡아비아나의 제단에 있는 아비아나의 알 앞에서 전령의 향료를 사용해야 합니다.‡Usa el incienso de heraldo delante del Huevo de Aviana en el Santuario de Aviana.‡Usa el incienso de heraldo delante del Huevo de Aviana en el Santuario de Aviana.‡Utilisez l’Encens de héraut devant l’Œuf d’Aviana, au Sanctuaire d’Aviana.‡在艾维娜圣殿里的艾维娜的卵前使用预兆熏香。‡在艾維娜聖壇的艾維娜之卵前使用信使的薰香。',
  }
},
[25808] = {
  {
    'Esse negócio está ligado?‡Эта штука работает?‡Ist das Ding an?‡제 말 들리시는 분?‡¿Está encendida esta cosa?‡¿Está encendida esta cosa?‡Il est allumé, ce machin ?‡这东西开了吗？‡這有開嗎?',
    nil,
    'Mate a Mestre Assassina Kel\'istra.‡Ликвидируйте главу убийц Кел\'истру.‡Tötet Meisterassassine Kel\'istra.‡일급 암살자 켈이스트라를 처치해야 합니다.‡Mata al maestro asesino Kel\'istra.‡Mata al maestro asesino Kel\'istra.‡Tuez le Maître assassin Kel’istra.‡杀死刺客大师凯莉丝卓。‡殺死刺客大師凱爾伊絲翠。',
  }
},
[25809] = {
  {
    'Não deixe ninguém para trás!‡Своих не бросать!‡Lasst niemanden zurück!‡낙오자는 없다!‡¡No dejes atrás a nadie!‡¡No dejes atrás a nadie!‡On ne laisse personne derrière !‡一个人都不能落下！‡決不丟下任何人!',
    nil,
    'Resgate 8 Mineradores Assustados.‡Спасите 8 испуганных шахтеров.‡Rettet 8 Verängstigte Minenarbeiter.‡겁에 질린 광부 8명을 구출해야 합니다.‡Rescata a 8 mineros aterrorizados.‡Rescata a 8 mineros aterrorizados.‡Secourez 8 Mineurs effrayés.‡营救8名惊恐的矿工。‡救出8個害怕的礦工。',
  }
},
[25810] = {
  {
    'Fogo na incubadora!‡Разорение инкубатора‡Die Brutstätte muss brennen‡부화장을 불태워라‡El Criadero debe arder‡El Criadero debe arder‡Que le couvoir brûle !‡必须烧掉孵化场‡燒掉孵化室',
    nil,
    'Atravesse o portal de chamas no meio da Ardilanta, no Monte Hyjal. Em seguida, fale com Farden Garrafiada.‡Пройдите через огненные врата в центре Негаснущего пожара и найдите Фардена Когтекрыла.‡Reist durch das Flammentor in der Mitte der Flammenschneise auf dem Hyjal. Sprecht mit Farden Klauenwürger, sobald Ihr hindurchgegangen seid.‡하이잘 산의 불꽃의 흔적 중앙에 있는 화염관문으로 들어가야 합니다. 그 안에서 파든 탈론슈라이크와 대화하십시오.‡Atraviesa la puerta de llamas en el centro de La Estela Ardiente en Monte Hyjal. Habla con Farden Alcaudón una vez dentro.‡Atraviesa la puerta de llamas en el centro de La Estela Ardiente en Monte Hyjal. Habla con Farden Alcaudón una vez dentro.‡Franchissez le portail de flammes au milieu du Sillage des flammes, au Mont Hyjal. Une fois de l’autre côté, parlez à Farden Serres-grièche.‡穿过位于海加尔山烈焰之痕中心的火焰之门。跟里面的法登·爪击谈一谈。‡到海加爾山的烈焰之甦，穿過中央的烈焰之門，和裡面的法爾登‧猛禽說話。',
  }
},
[25811] = {
  {
    'Acabando com ela‡Обвал шахты‡Stilllegung‡광산 폐쇄‡Abajo con la mina‡Abajo con la mina‡La mine doit fermer ses volets‡关门大吉‡關閉礦坑',
    nil,
    'Plante o Feixe de Dinamite na Primeira Viga, na Segunda Viga, na Terceira Viga e na Quarta Viga.‡Заложите связку динамита у первой, второй, третьей и четвертой балки.‡Verankert jeweils ein Dynamitbündel am ersten, zweiten, dritten und vierten Träger.‡1, 2, 3, 4번 지지대에 다이너마이트 묶음을 설치해야 합니다.‡Coloca el fardo de dinamita en la primera, segunda, tercera y cuarta viga de apoyo.‡Coloca el fardo de dinamita en la primera, segunda, tercera y cuarta viga de apoyo.‡Placez un Paquet de dynamite sur la Première, la Deuxième, la Troisième et la Quatrième poutre.‡将一捆炸药装在第一、第二、第三及第四承重梁上。‡將一捆炸藥放置在第一支撐樑、第二支撐樑、第三支撐樑和第四支撐樑。',
  }
},
[25812] = {
  {
    'Espeleologia‡Спелеологи‡Höhlenforscher‡동굴 탐험‡Espeleología‡Espeleología‡Spéléologie‡洞穴探险‡洞穴探索',
    nil,
    'Fale com o Recruta Pollard na Gruta Densanévoa.‡Поговорите с рядовым Поллардом в Дымчатом гроте.‡Sprecht mit dem Gefreiten Pollard in der Tiefennebelgrotte.‡깊은안개 종유동에 있는 병사 폴라드와 대화해야 합니다.‡Habla con el soldado Polard en Gruta Brumadensa.‡Habla con el soldado Polard en Gruta Brumadensa.‡Parlez au Soldat Pollard dans la Grotte Brume-épaisse.‡跟重雾洞穴的列兵伯纳德谈一谈。‡在深霧岩洞和士兵波拉德說話。',
  }
},
[25813] = {
  {
    'Chamado dos ventos‡Подуй в рог‡Das Horn erklingen lassen‡뿔피리를 불어라‡Toca el cuerno‡Toca el cuerno‡L’appeau élémentaire‡去吹响号角‡吹響號角',
    nil,
    'Mate Whrrrl.‡Покончите с Вырррлом.‡Tötet Whrrrl.‡도라라를 처치해야 합니다.‡Mata a Whrrrl.‡Mata a Whrrrl.‡Tuez Ffffchhhh.‡杀死乌尔。‡殺死旋旋。',
  }
},
[25814] = {
  {
    'Chamado dos ventos‡Подуй в рог‡Das Horn erklingen lassen‡뿔피리를 불어라‡Toca el cuerno‡Toca el cuerno‡L’appeau élémentaire‡去吹响号角‡吹響號角',
    nil,
    'Mate Whrrrl.‡Покончите с Вырррлом.‡Tötet Whrrrl.‡도라라를 처치해야 합니다.‡Mata a Whrrrl.‡Mata a Whrrrl.‡Tuez Ffffchhhh.‡杀死乌尔。‡殺死旋旋。',
  }
},
[25815] = {
  {
    'A terceira frota‡Третья флотилия‡Die Dritte Flotte‡제3 함대‡La Tercera Flota‡La Tercera Flota‡La troisième flotte‡第三舰队‡第三艦隊',
    nil,
    'Obtenha o Hidromel de Simonez na adega da estalagem do Porto de Menethil.‡Заберите медовуху Фитсиммонса из подвала таверны в Гавани Менетилов.‡Erhaltet Fitzsimmons\' Met aus dem Keller des Gasthauses im Hafen von Menethil.‡메네실 항구의 여관에서 피츠시몬즈의 벌꿀술을 가져가야 합니다.‡Consigue el hidromiel de Fistimos del sótano de la posada del Puerto de Menethil.‡Consigue el hidromiel de Fistimos del sótano de la posada del Puerto de Menethil.‡Allez chercher l’Hydromel de Fitzsimmons dans la cave de l’auberge, dans le Port de Menethil.‡从米奈希尔港旅店的酒窖里拿到菲兹莫斯的蜂蜜酒。‡到米奈希爾港的旅店地窖裡去取得菲茲莫斯的蜜酒。',
  }
},
[25816] = {
  {
    'Condenado a vagar‡Обреченные на вечные скитания‡Zum Umherwandeln verdammt‡배회의 저주‡Condenado a vagar‡Condenado a vagar‡Condamné à l\'errance‡诅咒成魂‡蔓延的詛咒',
    nil,
    'Converse com o fantasma do Primeiro Oficial Expedito.‡Поговорите с призраком первого помощника Снеллига.‡Sprecht mit dem Geist des Ersten Maats Snellig.‡일등항해사 스넬리그와 대화해야 합니다.‡Habla con el fantasma del contramaestre Snellig.‡Habla con el fantasma del contramaestre Snellig.‡Parlez au spectre du Second Snellig.‡同大副斯涅利格的鬼魂交谈。‡與鬼魂大副斯涅利格交談。',
  }
},
[25817] = {
  {
    'A tripulação amaldiçoada‡Проклятая команда‡Die verfluchte Crew‡저주받은 선원‡La tripulación maldita‡La tripulación maldita‡L\'équipage maudit‡被诅咒的船员‡被詛咒的船員',
    nil,
    'Mate 5 Marinheiros Amaldiçoados e 5 Fuzileiros Amaldiçoados na Frota Perdida.‡Убейте 5 проклятых матросов и 5 проклятых стражей бухты у Погибшего Плота.‡Tötet 5 verfluchte Seemänner und 5 verfluchte Marinesoldaten in der Verlorenen Flotte.‡잃어버린 해안에서 저주받은 선원 5명과 저주받은 해병 5명을 처치해야 합니다.‡Mata a 5 marineros malditos y a 5 marinos malditos en La Flota Perdida.‡Mata a 5 marineros malditos y a 5 marinos malditos en La Flota Perdida.‡Tuez 5 Marins maudits et 5 Soldats de marine maudits à la Flotte perdue.‡在失落的舰队杀死5名被诅咒的水手和5名被诅咒的水兵。‡到失落的艦隊裡去殺死5個被詛咒的水手與5個被詛咒的水兵。',
  }
},
[25818] = {
  {
    'O fim da maldição‡Очищение‡Brechen des Fluchs‡저주 풀기‡Purga de la maldición‡Purga de la maldición‡Lever la malédiction‡解除诅咒‡解除詛咒',
    nil,
    'Obtenha a Chave do Cofre do Intrépido do Capitão Halyndor.‡Отберите ключ от сейфа на "Отважном" у капитана Халиндора.‡Besorgt den Geldkassettenschlüssel der \'Kühnheit\' von Kapitän Halyndor.‡할린도르 선장을 처치한 후 용감무쌍호의 금고 열쇠를 획득해야 합니다.‡Consigue la llave de caja fuerte de El Intrépido del capitán Halyndor.‡Consigue la llave de caja fuerte de El Intrépido del capitán Halyndor.‡Prenez la Clé du coffre de l’Intrépide au Capitaine Halyndor.‡从哈林多尔船长身上获得无畏号保险箱钥匙。‡從哈林多爾船長身上取得無畏號的保險箱鑰匙。',
  }
},
[25819] = {
  {
    'Olho de Paleth‡Око Палета‡Das Auge von Paleth‡팔레스의 눈‡El ojo de Paleth‡El ojo de Paleth‡L\'Œil de Paleth‡帕雷斯之眼‡帕雷斯之眼',
    nil,
    'Leve o Olho Maldito de Paleth a Glorin Testaço no Porto de Menethil, que fica no Pantanal.‡Отнесите проклятое Око Палета Глорину Стальному Лбу в Гавань Менетилов, что в Болотине.‡Bringt das verfluchte Auge von Paleth zu Glorin Stahlbraue im Hafen von Menethil im Sumpfland.‡저습지의 메네실 항구에 있는 글로린 스틸브라우에게 팔레스의 저주받은 눈을 가져가야 합니다.‡Lleva el Ojo maldito de Paleth a Glorin Frenteacerada al Puerto de Menethil en Los Humedales.‡Lleva el Ojo maldito de Paleth a Glorin Frenteacerada al Puerto de Menethil en Los Humedales.‡Apportez l’Œil maudit de Paleth à Glorin Front-d’acier au Port de Menethil, dans les Paluns.‡把被诅咒的帕雷斯之眼交给湿地米奈希尔港的戈罗林·钢眉。‡把被詛咒的帕雷斯之眼帶去濕地的米奈希爾港，交給戈羅林·鋼眉。',
  }
},
[25820] = {
  {
    'O meu filho é uma joia de moço‡Материнская тревога‡Die Sorgen einer Mutter‡어머니의 걱정‡Amor de madre‡Amor de madre‡Les soucis d\'une mère‡母亲的担忧‡母親的憂慮',
    nil,
    'Mate 10 Rasgatanas da Baía.‡Убейте 10 режущих плавников гавани.‡Tötet 10 Hafenschredderflossen.‡항구 갈기상어 10마리를 처치해야 합니다.‡Mata a 10 tiburones de puerto.‡Mata a 10 tiburones de puerto.‡Tuez 10 Carnageoires de port.‡杀死10条海湾裂鳍鱼。‡殺死10隻海港切鱗鯊。',
  }
},
[25821] = {
  {
    'Um trabalho especial‡Особое задание‡Ein ganz besonderer Auftrag‡특별한 일‡Un trabajo un poco especial‡Un trabajo un poco especial‡Une singulière besogne‡一件特别的工作‡特殊工作',
    nil,
    'Apresente-se ao Comandante de Força Valen na Base da Expedição Guardanorte, que fica na Cordilheira das Torres de Pedra.‡Доложитесь командиру армии Валену в лагере экспедиции Северной Стражи, что в Когтистых горах.‡Meldet Euch bei Truppenkommandant Valen im Basislager der Nordwachtexpedition im Steinkrallengebirge.‡돌발톱 산맥의 북부감시 원정대 기지에 있는 전투사령관 발렌에게 보고해야 합니다.‡Preséntate ante el Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Preséntate ante el Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Allez vous mettre à la disposition du Commandant de corps Valen au Camp de base de l’expédition de Guet-du-Nord, dans les Serres-Rocheuses.‡去找石爪山脉北卫远征军营地的部队指挥官范伦。‡到石爪山脈的北方遠征隊營地向軍隊指揮官瓦倫回報。',
  }
},
[25822] = {
  {
    'Armamentos para a guerra‡Оружие для войны‡Kriegswerkzeug‡전쟁 장비 수집‡Armamentos de guerra‡Armamentos de guerra‡Arsenal de guerre‡军备‡戰爭軍備',
    nil,
    'Colete 10 Caixotes de Armas da Aliança.‡Добудьте 10 ящиков с оружием Альянса.‡Sammelt 10 Waffenkisten der Allianz.‡얼라이언스 무기 상자 10개를 모아야 합니다.‡Recoge 10 cajones de armas de la Alianza.‡Recoge 10 cajones de armas de la Alianza.‡Récupérez 10 Caisses d’armes de l’Alliance.‡收集10个联盟武器箱。‡收集10個聯盟武器箱。',
  }
},
[25823] = {
  {
    'A impiedosa Horda‡Безжалостная Орда‡Die unerbittliche Horde‡한도 끝도 없는 호드‡La implacable Horda‡La implacable Horda‡La Horde implacable‡没完没了的部落‡頑強的部落',
    nil,
    'Mate 12 inimigos integrantes da Horda nas Terras Escavadas.‡Убейте 12 врагов из Орды на месте раскопок.‡Tötet 12 Angehörige der Horde an der Grabstätte.‡발굴된 땅에서 호드 12명을 처치해야 합니다.‡Mata a 12 enemigos de la Horda en los Campos Desenterrados.‡Mata a 12 enemigos de la Horda en los Campos Desenterrados.‡Tuez 12 ennemis de la Horde dans les Terres Exhumées.‡在不毛之地杀死12名部落敌人。‡到掘出的遺址殺死12個部落敵人。',
  }
},
[25824] = {
  {
    'Relato de missão‡Отчет‡Befragung‡임무 보고‡Informe‡Informe‡Débriefing‡最后的汇报‡聽取報告',
    nil,
    'Fale com o Recruta Pollard sobre a missão dele.‡Обратитесь к рядовому Полларду и попросите поведать об испытаниях, которые выпали на его долю.‡Sprecht mit Gefreiter Pollard und erfahrt etwas über seine Tortur.‡병사 폴라드와 대화하여 그가 무슨 일을 겪었는지 들어야 합니다.‡Habla con el soldado Polard y entérate de su terrible experiencia.‡Habla con el soldado Polard y entérate de su terrible experiencia.‡Parlez au Soldat Pollard et faites-lui raconter l’épreuve qu’il a traversée.‡听列兵伯纳德讲述他经历的种种磨难。‡和士兵波拉德談話以得知他所經歷的一切。',
  }
},
[25825] = {
  {
    'Entregando a mercadoria‡Неси добро‡Rohstofflieferung‡물건 배달‡Entrega el petróleo‡Entrega el petróleo‡Livraison de butin‡送货‡貨物快遞',
    nil,
    'Entregue o Barril de Petróleo a Xabu Latafuso no Barcódromo do Xabu e do Relé, que fica em Mil Agulhas.‡Доставьте бочку нефти Пшиксу Медноштифу на гоночную баржу Пшикса и Поззика в Тысяче Игл.‡Bringt das Fass mit Öl zu Fizzel Kupferbolz auf Fizzels & Pozziks Turbodampfer in Tausend Nadeln.‡기름통을 버섯구름 봉우리에 있는 피즐과 포직의 쾌속선의 피즐 브라스볼츠에게 전달해야 합니다.‡Entrega el barril de petróleo a Fizzle Engranágil en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Entrega el barril de petróleo a Fizzle Engranágil en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Livrez le Baril de pétrole à Féplouf Zéboulon, sur la péniche de course de Féplouf et Pozzik, dans les Mille pointes.‡将这一桶油送交给千针石林菲兹尔和普兹克的赛艇平台的菲兹尔·铜栓。‡到千針石林的菲茲爾與普茲克的高速駁船將油桶交給菲茲爾·銅栓。',
  }
},
[25826] = {
  {
    'Entregando a mercadoria‡Неси добро‡Rohstofflieferung‡물건 배달‡Entrega el petróleo‡Entrega el petróleo‡Livraison de butin‡送货‡貨物快遞',
    nil,
    'Entregue o Barril de Petróleo a Relé no Barcódromo do Xabu e do Relé, que fica em Mil Agulhas.‡Доставьте бочку нефти Поззику на гоночную баржу Пшикса и Поззика в Тысяче Игл.‡Bringt das Fass mit Öl zu Pozzik auf Fizzels & Pozziks Turbodampfer in Tausend Nadeln.‡기름통을 버섯구름 봉우리에 있는 피즐과 포직의 쾌속선의 포직에게 전달해야 합니다.‡Entrega el barril de petróleo a Pozzik en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Entrega el barril de petróleo a Pozzik en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Livrez le Baril de pétrole à Pozzik, sur la péniche de course de Féplouf et Pozzik, dans les Mille pointes.‡将这一桶油送交给千针石林菲兹尔和普兹克的赛艇平台的普兹克。‡到千針石林的菲茲爾與普茲克的高速駁船將油桶交給普茲克。',
  }
},
[25827] = {
  {
    '‡Ло\'гош готов к бою‡Lo\'Gosh ist bereit für die Schlacht‡‡Lo\'Gosh está preparado para la batalla‡‡Lo\'Gosh est prêt à en découdre‡‡',
    nil,
    '‡Поговорите с Изерой у Древа Жизни на горе Хиджал.‡Sprecht mit Ysera am Weltenbaum auf dem Hyjal.‡‡Habla con Ysera en el Árbol del Mundo en Monte Hyjal.‡‡Parlez à Ysera à l\'Arbre-Monde, sur le Mont Hyjal.‡‡',
  }
},
[25828] = {
  {
    '‡Послание к Изере: Голдринн‡Goldrinns Botschaft an Ysera‡‡El mensaje de Goldrinn para Ysera‡‡Le message de Goldrinn à Ysera‡‡',
    nil,
    '‡Поговорите с Изерой у Древа Жизни на горе Хиджал.‡Sprecht mit Ysera am Weltenbaum auf dem Hyjal.‡‡Habla con Ysera en el Árbol del Mundo en Monte Hyjal.‡‡Adressez-vous à Ysera à l\'Arbre-Monde, au Mont Hyjal.‡‡',
  }
},
[25829] = {
  {
    '‡‡‡추적 퀘스트 - 골드린 지역 완료‡Misión de rastreo - Centro Goldrinn completa‡‡Suivi de quête - Série de Goldrinn terminée‡‡',
    nil,
    nil,
  }
},
[25830] = {
  {
    'O último erudito‡Последний хранитель знаний‡Der letzte lebende Wissenshüter‡살아 있는 마지막 지식의 파수꾼‡El último tradicionalista‡El último tradicionalista‡Le dernier gardien du savoir‡最后一名博学者‡最後的博識者',
    nil,
    'Encontre Nordu, um Anciente da Tradição, na Ardilanta, que fica no Monte Hyjal.‡Найдите Норду, древо мудрости, в Негаснущем Пожаре на горе Хиджал.‡Findet Nordu, das Urtum der Lehren, in der Flammenschneise auf dem Hyjal.‡하이잘 산의 불꽃의 흔적에 있는 지식의 고대정령 노르두를 찾아야 합니다.‡Busca a Nordu, un Anciano del Conocimiento, en La Estela Ardiente en Monte Hyjal.‡Busca a Nordu, un Anciano del Conocimiento, en La Estela Ardiente en Monte Hyjal.‡Trouvez Nordu, un ancien du savoir, au Sillage des flammes, sur le Mont Hyjal.‡去找海加尔山烈焰之痕的知识古树诺尔度。‡到海加爾山的烈焰之甦，尋找知識之樹諾爾度。',
  }
},
[25831] = {
  {
    '‡Послание к Изере: Хамуул‡Hamuuls Botschaft an Ysera‡‡El mensaje de Hamuul para Ysera‡‡Le message de Hamuul à Ysera‡‡',
    nil,
    '‡Поговорите с Изерой у Древа Жизни на горе Хиджал.‡Sprecht mit Ysera am Weltenbaum auf dem Hyjal.‡‡Habla con Ysera en el Árbol del Mundo en Monte Hyjal.‡‡Parlez à Ysera à l\'Arbre-Monde, sur le Mont Hyjal.‡‡',
  }
},
[25832] = {
  {
    'Novo encontro com Aviana‡Возвращение к Авиане‡Rückkehr zu Aviana‡다시 아비아나에게로‡Vuelve con Aviana‡Vuelve con Aviana‡Retourner près d\'Aviana‡返回艾维娜身边‡回去找艾維娜',
    nil,
    'Fale novamente com Aviana no Santuário de Aviana, no Monte Hyjal.‡Вернитесь к Авиане в Святилище Авианы на горе Хиджал.‡Kehrt zu Aviana am Schrein von Aviana auf dem Hyjal zurück.‡하이잘 산의 아비아나의 제단에 있는 아비아나에게 가야 합니다.‡Vuelve con Aviana en el Santuario de Aviana en Monte Hyjal.‡Vuelve con Aviana en el Santuario de Aviana en Monte Hyjal.‡Retournez voir Aviana dans son sanctuaire, sur le Mont Hyjal.‡回到海加尔山的艾维娜圣殿，去找艾维娜。‡回去海加爾山的艾維娜聖壇找艾維娜。',
  }
},
[25833] = {
  {
    '‡Послание к Изере: Авиана‡Avianas Botschaft für Ysera‡‡El mensaje de Aviana para Ysera‡‡Le message d\'Aviana à Ysera‡‡',
    nil,
    '‡Поговорите с Изерой у Древа Жизни на горе Хиджал.‡Sprecht mit Ysera am Weltenbaum auf dem Hyjal.‡‡Habla con Ysera en el Árbol del Mundo en Monte Hyjal.‡‡Parlez à Ysera à l\'Arbre-Monde, sur le Mont Hyjal.‡‡',
  }
},
[25834] = {
  {
    'A batata deles está assando...‡Смерть по доверенности‡Stellvertreterkrieg‡죽이는 맛‡Más listo que el hambre‡Más listo que el hambre‡La mort par procuration‡死亡代理人‡死亡代理人',
    nil,
    'Fale com o "Cuca" MacMolhofraco na Base da Expedição Guardanorte, que fica na Cordilheira das Torres de Pedra.‡Поговорите с "Пирожком" МакСоусом в лагере экспедиции Северной Стражи в Когтистых горах.‡Sprecht mit "Kräcka" Aschebäscha im Basislager der Nordwachtexpedition im Steinkrallengebirge.‡돌발톱 산맥의 북부감시 원정대 기지에 있는 "쿠키" 맥위크소스와 대화해야 합니다.‡Habla con "Cocinitas" MacSalsafloja en el Campamento base de la Expedición del Fuerte del Norte en Sierra Espolón.‡Habla con "Cocinitas" MacSalsafloja en el Campamento base de la Expedición del Fuerte del Norte en Sierra Espolón.‡Parlez à « Cuistot » McFadesauce au Camp de base de l’expédition de Guet-du-Nord, dans les Serres-Rocheuses.‡跟石爪山脉北卫远征军营地的“曲奇”米维克索斯谈一谈。‡在石爪山脈的北方遠征隊營地找『小廚』麥克威醬談話。',
  }
},
[25835] = {
  {
    'Liberdade para a Aldeia Vento Livre!‡Волю заставе Вольного Ветра!‡Freiwindposten befreien‡높새바람 봉우리에 자유를‡Libera al Poblado Viento Libre‡Libera al Poblado Viento Libre‡La libération de Librevent‡解放乱风岗‡解放亂風崗',
    nil,
    'Fale com Quentin na Aldeia Vento Livre, que fica em Mil Agulhas.‡Поговорите с Квентином на заставе Вольного Ветра в Тысяче Игл.‡Sprecht mit Quentin in Freiwindposten in Tausend Nadeln.‡버섯구름 봉우리의 높새바람 봉우리에 있는 켄튼과 대화해야 합니다.‡Habla con Quentin en el Poblado Viento Libre en Las Mil Agujas.‡Habla con Quentin en el Poblado Viento Libre en Las Mil Agujas.‡Parlez à Quentin au Poste de Librevent, dans les Mille pointes.‡同千针石林乱风岗的库恩汀交谈。‡在千針石林的亂風崗與奎恩丁交談。',
  }
},
[25836] = {
  {
    'Liberdade para a Aldeia Vento Livre!‡Волю заставе Вольного Ветра!‡Freiwindposten befreien‡높새바람 봉우리에 자유를‡Libera al Poblado Viento Libre‡Libera al Poblado Viento Libre‡La libération de Librevent‡解放乱风岗‡解放亂風崗',
    nil,
    'Fale com Thalia Couro Âmbar na Aldeia Vento Livre, que fica em Mil Agulhas.‡Поговорите с Талией Янтарной Шкурой на заставе Вольного Ветра в Тысяче Игл.‡Sprecht mit Thalia Bernhaut in Freiwindposten in Tausend Nadeln.‡버섯구름 봉우리의 높새바람 봉우리에 있는 탈리아 앰버하이드와 대화해야 합니다.‡Habla con Thalia Pellejo Ámbar en el Poblado Viento Libre en Las Mil Agujas.‡Habla con Thalia Pellejo Ámbar en el Poblado Viento Libre en Las Mil Agujas.‡Parlez à Thalia Peau-d’ambre au Poste de Librevent, dans les Mille Pointes.‡同千针石林乱风岗的萨利亚·琥皮交谈。‡在千針石林的亂風崗與薩莉亞·珀革交談。',
  }
},
[25837] = {
  {
    'Uma oferta de paz adequada‡Достойное угощение‡Das perfekte Dinner‡맛깔스러운 공물‡Una ofrenda de paz sabrosa‡Una ofrenda de paz sabrosa‡Un gage de paix appétissant‡体面的感恩祭‡和平佳餚',
    nil,
    'Colete 6 Ovos de Águia de Kalimdor, 8 Ancas de Carneiro e 10 pedaços de Queijo da Ravina da Avalanche.‡Добудьте 6 яиц калимдорских орлов, 8 бараньих окороков и 10 кусков сыра Камнепадов.‡Sammelt 6 Eier von Kalimdoradlern, 8 Widderkeulen und 10 Stücke Steinschlagkäse.‡칼림도어 독수리 알 6개, 산양 허벅지 고기 8개, 구릉바위 치즈 10개를 구해야 합니다.‡Consigue 6 huevos de águila de Kalimdor, 8 ancas de carnero y 10 trozos de queso del Alud.‡Consigue 6 huevos de águila de Kalimdor, 8 ancas de carnero y 10 trozos de queso del Alud.‡Procurez-vous 6 Œufs d’aigle de Kalimdor, 8 Cuissots de bélier et 10 morceaux de Fromage des Éboulis.‡收集6枚卡利姆多鹰蛋、8块羊腰肉和10片滚岩奶酪。‡收集6顆卡林多雄鷹蛋、8份山羊腰臀肉和10個滾岩起司。',
  }
},
[25838] = {
  {
    'Ajuda da Garagem do Gradaço‡Помощь из поселка Сталежаров‡Hilfe aus Stahlrosts Depot‡스틸그릴의 정비소로부터의 원조‡Ayuda del Almacén de Brasacerada‡Ayuda del Almacén de Brasacerada‡Le dépôt de Grillacier entre en action‡来自钢架补给站的帮手‡鋼架補給站的援助',
    nil,
    'Fale com Delber Manigiro na Garagem do Gradaço.‡Поговорите с Делбером Кривошипом в поселке Сталежаров.‡Sprecht mit Delber Kurbeldreh in Stahlrosts Depot.‡스틸그릴의 정비소에 있는 델버 크랭크토글과 대화해야 합니다.‡Habla con Delber Giramanivela en el Almacén de Brasacerada.‡Habla con Delber Giramanivela en el Almacén de Brasacerada.‡Parlez à Delber Tournelevier au Dépôt de Grillacier.‡跟钢架补给站的戴博·曲针谈一谈。‡找鋼架補給站的戴爾伯‧曲針交談。',
  }
},
[25839] = {
  {
    'O lançador pessoal super seguro‡Ультрабезопасный переместитель войск‡Das ultrasichere Personalabschussgerät!‡초안전 병력 발사기‡El lanzador personal ultraseguro‡El lanzador personal ultraseguro‡Le vecteur d\'agents ultra-sécurisé‡超安全单兵发射器‡超安全單兵發射器',
    nil,
    'Use o Lançador Pessoal Super Seguro para entrar em posição no Refúgio Jubafria.‡Воспользуйтесь ультрабезопасным переместителем войск, чтобы отправиться в Укрытие Мерзлогривов.‡Fliegt mit dem ultrasicheren Personalabschussgerät zur Zuflucht der Frostmähnen.‡초안전 병력 발사기를 이용해 서리갈기 은신처로 가야 합니다.‡Utiliza el lanzador personal ultraseguro para desplegarte en el Refugio Peloescarcha.‡Utiliza el lanzador personal ultraseguro para desplegarte en el Refugio Peloescarcha.‡Utilisez le Vecteur d’agents ultra-sécurisé pour vous poster à la Retraite des Crins-de-givre.‡使用超安全单兵发射器前往霜鬃营地。‡使用超安全單兵發射器到霜鬃居所。',
  }
},
[25840] = {
  {
    'Como minar a resistência‡Сломить сопротивление‡Eliminiert den Widerstand‡저항세력 제거‡Eliminar la resistencia‡Eliminar la resistencia‡Éliminer la résistance‡消灭抵抗‡瓦解抵抗',
    nil,
    'Mate Battok, o Berserker, e 5 Guerreiros Jubafria no Refúgio Jubafria.‡Убейте Баттока Берсерка и 5 воинов из племени Мерзлогривов в Укрытии Мерзлогривов.‡Tötet Battok den Berserker und 5 Krieger der Frostmähnen in der Zuflucht der Frostmähnen.‡서리갈기 은신처에서 광전사 바톡과 서리갈기 전사 5명을 처치해야 합니다.‡Mata a Battok el Rabioso y a 5 guerreros Peloescarcha en el Refugio Peloescarcha.‡Mata a Battok el Rabioso y a 5 guerreros Peloescarcha en el Refugio Peloescarcha.‡Tuez Battok le Berserker et 5 Guerriers crins-de-givre à la Retraite des Crins-de-givre.‡在霜鬃营地消灭狂战士巴托克和5名霜鬃战士。‡前往霜鬃居所，殺掉狂戰士巴托克和5個霜鬃戰士。',
  }
},
[25841] = {
  {
    'O perigo vem de cima‡Удар сверху‡Angriff von oben‡공중습격‡Ataque desde el cielo‡Ataque desde el cielo‡Frappe aérienne‡从天而降‡天降奇兵',
    nil,
    'Use o Sinal de Fumaça para chamar ataques aéreos contra os limites norte e sul do Refúgio Jubafria.‡Воспользуйтесь сигнальной ракетой, чтобы вызывать воздушные удары по северной и южной сторонам Укрытия Мерзлогривов.‡Benutzt das Signalleuchtfeuer, um Luftangriffe am nördlichen und südlichen Rand der Zuflucht der Frostmähnen anzufordern.‡서리갈기 은신처의 북쪽 끝과 남쪽 끝 지역에서 신호용 불꽃을 사용해 공중습격을 요청해야 합니다.‡Utiliza la bengala de señalización para lanzar ataques aéreos en los límites norte y sur del Refugio Peloescarcha.‡Utiliza la bengala de señalización para lanzar ataques aéreos en los límites norte y sur del Refugio Peloescarcha.‡Utilisez la Fusée de signalisation pour demander une frappe aérienne aux extrémités nord et sud de la Retraite des Crins-de-givre.‡在霜鬃营地北端和南端用信号枪呼叫空中打击。‡在霜鬃居所的北面和南面使用信號槍，呼叫空襲。',
  }
},
[25842] = {
  {
    'Bombeiro‡Огнеборство‡Feuergefecht‡화재 진압‡Lucha contra el fuego‡Lucha contra el fuego‡La proie des flammes‡涅槃之火‡救火',
    nil,
    'Mate 5 Atormentadores de Fogo para mantê-los afastados de Nordu.‡Уничтожьте 5 огненных мучителей, чтобы защитить от них Норду.‡Tötet 5 feurige Peiniger, um sie von Nordu fernzuhalten.‡노르두에게 다가오지 못하도록 불의 심문관 5마리를 처치해야 합니다.‡Mata a 5 torturadores ígneos para evitar que lleguen hasta Nordu.‡Mata a 5 torturadores ígneos para evitar que lleguen hasta Nordu.‡Tuez 5 Tourmenteurs embrasés pour les empêcher de détruire Nordu.‡消灭5名火焰折磨者，让他们远离诺尔度。‡消滅5個熾炎折磨者，別讓他們靠近諾爾度。',
  }
},
[25843] = {
  {
    'A vingança de Tortolla‡Месть Тортоллы‡Tortollas Rache‡토르톨라의 복수‡La venganza de Tortolla‡La venganza de Tortolla‡La vengeance de Tortolla‡托尔托拉的复仇‡托爾托拉的復仇',
    nil,
    'Fale com Tortolla na Terra Queimada, que fica no Monte Hyjal.‡Поговорите с Тортоллой на Выжженной равнине на горе Хиджал.‡Sprecht mit Tortolla in der Verbrannten Ebene auf dem Hyjal.‡하이잘 산의 불타버린 평원에 있는 토르톨라와 대화해야 합니다.‡Habla con Tortolla en La Llanura Agostada en Monte Hyjal.‡Habla con Tortolla en La Llanura Agostada en Monte Hyjal.‡Parlez à Tortolla dans la Plaine Incendiée, au Mont Hyjal.‡跟海加尔山焦痕平原的托尔托拉谈一谈。‡在海加爾山的烈焰平原和托爾托拉談話。',
  }
},
[25844] = {
  {
    'Saciando a fera selvagem‡Сколько дикого дверя ни корми‡Sättigt die wilde Bestie‡난폭한 야수 비위 맞추기‡Saciar a la bestia salvaje‡Saciar a la bestia salvaje‡Les réceptions de l\'ambassadeur…‡让野兽满意‡野獸大餐',
    nil,
    'Entregue a Oferenda Carnuda a Ton Arco de Vento na Aldeia do Temível Totem, que fica na Cordilheira das Torres de Pedra.‡Принесите мясное угощение Тону Поклону Ветра на заставу Зловещего Тотема в Когтистых горах.‡Bringt Ton Windbogen am Posten der Grimmtotem die fleischige Gabe.‡돌발톱 산맥의 그림토템 초소에 있는 톤 윈드보우에게 고기 공물을 전해야 합니다.‡Entrega la ofrenda de carne a Ton Doblegaviento en el Poblado Tótem Siniestro, en Sierra Espolón.‡Entrega la ofrenda de carne a Ton Doblegaviento en el Poblado Tótem Siniestro, en Sierra Espolón.‡Remettez l’Offrande culinaire à Ton Arc-du-vent au Poste totem-sinistre, dans les Serres-Rocheuses.‡将丰盛的贡品献给石爪山脉恐怖图腾岗哨的图恩·风弓。‡將美味的佳餚送到石爪山脈的恐怖圖騰崗哨給透‧風弓。',
  }
},
[25845] = {
  {
    'Termos de serviço‡Условия службы‡Forderungen‡규약‡Términos de Servicio‡Términos de Servicio‡Les termes de l\'accord‡服务条款‡服務條款',
    nil,
    'Entregue os Termos de Serviço Temível Totem ao Comandante de Força Valen na Base da Expedição Guardanorte, que fica na Cordilheira das Torres de Pedra.‡Передайте условия Зловещего Тотема командиру армии Валену, находящемуся в лагере экспедиции Северной Стражи в Когтистых горах.‡Bringt die Forderungen der Grimmtotem zu Truppenkommandant Valen im Basislager der Nordwachtexpedition im Steinkrallengebirge.‡돌발톱 산맥의 북부감시 원정대 기지에 있는 전투사령관 발렌에게 그림토템 규약을 전달해야 합니다.‡Entrega los Términos de Servicio Tótem Siniestro al Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Entrega los Términos de Servicio Tótem Siniestro al Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Transmettez les Termes du pacte des Totems-sinistres au Commandant de corps Valen au Camp de base de l’expédition de Guet-du-Nord, dans les Serres-Rocheuses.‡将恐怖图腾工作条款转达给石爪山脉北卫远征军营地的部队指挥官范伦。‡將恐怖圖騰服務條款送到石爪山脈的北方遠征隊營地給軍隊指揮官瓦倫。',
  }
},
[25846] = {
  {
    'Grundig Nuvem Negra, chefe dos Temível Totem‡Грундиг Темное Облако, вождь клана Зловещего Тотема‡Grundig Finsterwolke, Häuptling der Grimmtotem‡그림토템 부족장 그룬디히 다크클라우드‡El jefe Tótem Siniestro, Grundig Nube Negra‡El jefe Tótem Siniestro, Grundig Nube Negra‡Grundig Noir-nuage, chef des Totems-sinistres‡恐怖图腾酋长，格鲁迪格·黑云‡格魯迪格·暗雲，恐怖圖騰的酋長',
    nil,
    'Entregue os Caixotes de Armas da Aliança a Grundig Nuvem Negra na Aldeia do Temível Totem, que fica na Cordilheira das Torres de Pedra.‡Доставьте ящики с оружием Альянса Грундигу Темному Облаку на заставу Зловещего Тотема в Когтистых горах.‡Bringt die Waffenkisten der Allianz zu Grundig Finsterwolke am Posten der Grimmtotem im Steinkrallengebirge.‡돌발톱 산맥의 그림토템 초소에 있는 그룬디히 다크클라우드에게 얼라이언스 무기 상자를 가져가야 합니다.‡Entrega los cajones de armas de la Alianza a Grundig Nube Oscura en el Poblado Tótem Siniestro, en Sierra Espolón.‡Entrega los cajones de armas de la Alianza a Grundig Nube Oscura en el Poblado Tótem Siniestro, en Sierra Espolón.‡Livrez les Caisses d’armes de l’Alliance à Grundig Noir-nuage au Poste Totem-sinistre, dans les Serres-Rocheuses.‡将联盟武器箱交给石爪山脉恐怖图腾岗哨的格鲁迪格·黑云。‡到石爪山脈的恐怖圖騰崗哨，把聯盟武器箱交付給格魯迪格·暗雲。',
  }
},
[25847] = {
  {
    'Supremacia do Temível Totem‡Превосходство Зловещего Тотема‡Die Überlegenheit der Grimmtotem‡그림토템 부족의 힘‡La supremacía de los Tótem Siniestro‡La supremacía de los Tótem Siniestro‡La suprématie des Totems-sinistres‡恐怖图腾霸权‡恐怖圖騰萬歲',
    nil,
    'Use o Caixote de Armas da Aliança para armar 12 dos Temível Totem.‡Используйте оружие из ящика с оружием Альянса, чтобы вооружить 12 воинов клана Зловещего Тотема.‡Bewaffnet 12 Grimmtotem mit der Waffenkiste der Allianz.‡얼라이언스 무기 상자로 그림토템 부족 12명을 무장시켜야 합니다.‡Utiliza el cajón de armas de la Alianza para armar a 12 Tótem Siniestro.‡Utiliza el cajón de armas de la Alianza para armar a 12 Tótem Siniestro.‡Utilisez les Caisses d’armes de l’Alliance pour armer 12 Totems-sinistres.‡使用联盟武器箱武装12名恐怖图腾。‡使用聯盟武器箱武裝12個恐怖圖騰',
  }
},
[25848] = {
  {
    'Queda‡Падение‡Untergang‡장군 처리‡Camino a la perdición‡Camino a la perdición‡La défaite‡垮台‡末日降臨',
    nil,
    'Mate os generais da Horda na Aldeia Apareje e recupere a Insígnia do General da Horda.‡Убейте генералов Орды в лагере Апарахе и добудьте знак различия генерала Орды.‡Tötet die Hordengeneräle in Camp Aparaje und erbeutet das Insigne des Hordengenerals.‡아파라제 야영지에서 호드 장군을 처치하고 호드 장군의 계급장을 입수해야 합니다.‡Mata a los generales de la Horda en el Campamento Aparaje y recupera la insignia del General de la Horda.‡Mata a los generales de la Horda en el Campamento Aparaje y recupera la insignia del General de la Horda.‡Tuez les généraux de la Horde au Camp Aparaje et obtenez l’Insigne de général de la Horde.‡杀死阿帕拉耶营地的部落将军，获得部落将军的徽记。‡殺死阿帕拉耶營地的部落將軍，並取得部落將軍的徽記。',
  }
},
[25849] = {
  {
    'A revolução dos fósseis‡Ожившие ископаемые‡Angriff der Archäologie‡화석 뼈 수집‡Cuando la arqueología ataca‡Cuando la arqueología ataca‡Quand les fossiles attaquent‡考古也疯狂‡考古學的反撲',
    nil,
    'Colete 20 Ossos Fossilizados dos Fósseis Vivos.‡Добудьте 20 окаменелых костей из живых ископаемых.‡Erbeutet 20 versteinerte Knochen von lebenden Fossilien.‡살아있는 화석에서 화석 뼈 20개를 수집해야 합니다.‡Reúne 20 huesos fosilizados de fósiles vivientes.‡Reúne 20 huesos fosilizados de fósiles vivientes.‡Prélevez 20 Os fossilisés sur des Fossiles vivants.‡从活生生的化石处收集10份石化骨骼。‡從活體化石身上收集20根變成化石的骨骼。',
  }
},
[25850] = {
  {
    'A terra contra-ataca!‡Бей прямо по земле!‡Schlagt die Erde!‡정령 처치!‡¡Combate la tierra!‡¡Combate la tierra!‡Matez la terre !‡攻击大地！‡擊打土地!',
    nil,
    'Mate 7 Elementais Paleolíticos.‡Убейте 7 палеолитических элементалей.‡Tötet 7 paläolithische Elementare.‡구석기의 정령 7마리를 처치해야 합니다.‡Mata a 7 elementales paleolíticos.‡Mata a 7 elementales paleolíticos.‡Tuez 7 Élémentaires paléolithiques.‡杀死7只古老的石元素。‡殺死7個舊石器時代元素。',
  }
},
[25851] = {
  {
    'Dança com os Temível Totem‡Танцы со Зловещим Тотемом‡Der mit den Grimmtotem tanzt‡그림토템과 춤을‡La danza de los Tótem Siniestro‡La danza de los Tótem Siniestro‡La danse de la victoire‡与恐怖图腾共舞‡與恐怖圖騰共舞',
    nil,
    'Apresente-se ao Comandante de Força Valen na Base da Expedição Guardanorte, que fica na Cordilheira das Torres de Pedra.‡Доложитесь командиру армии Валену в лагере экспедиции Северной Стражи, что в Когтистых горах.‡Meldet Euch bei Truppenkommandant Valen im Basislager der Nordwachtexpedition im Steinkrallengebirge.‡돌발톱 산맥의 북부감시 원정대 기지에 있는 전투사령관 발렌에게 보고해야 합니다.‡Preséntate ante el Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Preséntate ante el Comandante en Jefe Valen en el Campamento Base de la Expedición del Fuerte del Norte, en Sierra Espolón.‡Faites votre rapport au Commandant de corps Valen au Camp de base de l’expédition de Guet-du-Nord, dans les Serres-Rocheuses.‡去找石爪山脉北卫远征军营地的部队指挥官范伦。‡到石爪山脈的北方遠征隊營地向軍隊指揮官瓦倫回報。',
  }
},
[25852] = {
  {
    'Tudo limpo‡Все чисто‡Alles frei‡활로 개척‡Luz verde‡Luz verde‡Tout est réglé‡都清楚了‡一切清楚',
    nil,
    'Apresente-se ao Comandante Tomas Walpole no Desfiladeiro das Torres de Pedra, que fica nos Sertões Meridionais.‡Доложитесь командиру Томасу Уолполу на тропе Каменного Когтя в Южных Степях.‡Meldet Euch bei Kommandant Thomas Walpole auf dem Steinkrallenpass im Südlichen Brachland.‡남부 불모의 땅, 돌발톱 고개에 있는 사령관 토마스 월폴에게 보고해야 합니다.‡Preséntate ante el comandante Thomas Walpole en el Paso del Espolón en Los Baldíos del Sur.‡Preséntate ante el comandante Thomas Walpole en el Paso del Espolón en Los Baldíos del Sur.‡Faites votre rapport au Commandant Thomas Walpole à la Passe des Serres-rocheuses, dans les Tarides du Sud.‡去找石爪山脉石爪小径的部队指挥官托马斯·瓦波尔。‡到南貧瘠之地的石爪小徑向指揮官湯瑪斯·瓦爾波回報。',
  }
},
[25853] = {
  {
    'Minhas queridas ferramentas‡Быстро поднятое не считается упавшим‡Ohne Hut und Peitsche‡고고학자의 도구‡Herramientas abandonadas‡Herramientas abandonadas‡La foire aux outils‡一地工具‡四處兜風',
    nil,
    'Colete 6 Ferramentas do Arqueólogo.‡Соберите 6 инструментов археолога.‡Beschafft 6 Archäologenwerkzeuge.‡고고학자의 연장을 6개 수집해야 합니다.‡Recoge 6 herramientas de arqueólogo.‡Recoge 6 herramientas de arqueólogo.‡Retrouvez 6 Outils d’archéologue.‡收集6个考古学家的工具箱。‡收集6個考古學家的工具。',
  }
},
[25854] = {
  {
    'O nome dele vai ser Costelinha‡Домашний Кусандр‡Ich nenne ihn Bisschen‡새끼 랩터가 좋아!‡Le llamaré Mordisquitos‡Le llamaré Mordisquitos‡Je l\'appellerai Mordicator‡我要叫它咬咬‡我要叫牠咬咬',
    nil,
    'Colete 6 Ovos Vibrantes de Raptor.‡Соберите 6 подпрыгивающих яиц ящеров.‡Beschafft sechs wackelnde Raptoreneier.‡흔들리는 랩터 알 6개를 수집해야 합니다.‡Recoge 6 huevos de raptor temblorosos.‡Recoge 6 huevos de raptor temblorosos.‡Récoltez 6 Œufs de raptor gigotants.‡收集6枚晃动的迅猛龙蛋。‡收集6個在晃動的迅猛龍蛋。',
  }
},
[25855] = {
  {
    'Trecos e tralhas‡Плоды инженерной мысли‡Dingsdabumse‡잃어버린 장치‡Cacharros y artilugios‡Cacharros y artilugios‡Bidules et trucmuches‡小零小件儿‡齒輪與器具',
    nil,
    'Encontre 7 Engenhocas Entrós.‡Найдите 7 механизмов Бынструмента.‡Findet 7 Dingsdas der Schnellschalts.‡날쌘톱니 장치 7개를 찾아야 합니다.‡Encuentra 7 cacharros Cambioveloz.‡Encuentra 7 cacharros Cambioveloz.‡Trouvez 7 Bidules de Vifembraye.‡找到7件飞轮装置。‡找到7個迅輪齒輪。',
  }
},
[25856] = {
  {
    'Couro de crocolisco‡Шкуры кроколисков‡Krokiliskenbälge‡악어 가죽‡Pellejo de crocolisco‡Pellejo de crocolisco‡Les crocilisques du cœur‡鳄鱼皮‡鱷魚皮',
    nil,
    'Colete 10 Couros de Crocolisco do Pântano dos Crocoliscos do Pantanal.‡Добудьте 10 шкур болотного кроколиска.‡Erbeutet 10 Marschenkrokiliskenbälge von Sumpflandkrokilisken.‡습지악어를 처치해 늪지대 악어 가죽 10개를 모아야 합니다.‡Consigue 10 pellejos de crocolisco pantanosos de crocoliscos de Los Humedales.‡Consigue 10 pellejos de crocolisco pantanosos de crocoliscos de Los Humedales.‡Récoltez 10 Peaux de crocilisque des Paluns sur des Crocilisques des Paluns.‡从湿地鳄鱼身上割下10张沼泽鳄鱼皮。‡從溼地鱷魚身上收集10張濕地鱷魚皮。',
  }
},
[25857] = {
  {
    'Atrás do Garganto‡Охота на Челюсти Кошмара‡Jagt Horrorkiefer‡공포턱 사냥‡Cazando a Horroquija‡Cazando a Horroquija‡Faire la peau à Cauchemâchoire‡狩猎恐钳‡獵殺懼顎',
    nil,
    'Mate Garganto e colete o Pelego do Garganto.‡Убейте Челюсти Кошмара и заберите его шкуру.‡Tötet Horrorkiefer und erbeutet Horrorkiefers Haut.‡공포턱을 처치해 공포턱의 가죽을 수집해야 합니다.‡Mata a Horroquija y consigue su pellejo.‡Mata a Horroquija y consigue su pellejo.‡Obtenez la Peau de Cauchemâchoire en le tuant.‡杀死恐钳，扒下恐钳的皮。‡殺死懼顎並取走懼顎的皮。',
  }
},
[25858] = {
  {
    'Por ordens de Lady Sira\'kess‡Просьба госпожи‡Im Namen der Lady‡여군주의 뜻대로‡En el nombre de su Dama‡En el nombre de su Dama‡Au doigt et à l’œil‡秉承女士的命令‡女士殿下的命令',
    nil,
    'Fale com o Senhor das Profundezas Zin\'jatar, com a Lady Sira\'kess e com o Feitor Idra\'kess.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Поговорите с Повелителем глубин Зин\'жатаром, Леди Сира\'кесс и надзирателем Идра\'кессом.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Sprecht mit Tiefenlord Zin\'jatar, Lady Sira\'kess und Aufseher Idra\'kess.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡심해군주 진자타르, 여군주 시라케스, 감독관 이드라케스와 대화해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Habla con el señor de las profundidades Zin\'jatar, Lady Sira\'kess y el sobrestante Idra\'kess.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Habla con el señor de las profundidades Zin\'jatar, Lady Sira\'kess y el sobrestante Idra\'kess.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Parlez au Seigneur des fonds Zin’jatar, à Dame Sira’kess et au Surveillant Idra’kess.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡跟深水领主金加塔尔、希拉柯丝女士和监督者埃卓凯丝谈一谈。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡與深淵領主金加塔、席拉克斯女士、以及監督者艾德拉奇斯交談。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，如果有必要，在某個時間點使用納茲賈爾戰鬥仕女之刃，好回到幻象之中。',
  }
},
[25859] = {
  {
    'Passou, morreu‡Посторонним вход запрещен‡Keine Vergebung‡무단 출입 엄금‡No se tolerará la intrusión‡No se tolerará la intrusión‡Pas de pitié pour les intrus‡此路不通‡不可饒恕的入侵',
    nil,
    'Mate 20 Kvaldir na Crista Vraikal.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Убейте 20 квалдиров на выступе Врайкулов.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Tötet 20 Kvaldir auf der Vrykulklippe.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡브리쿨 절벽에서 크발디르 20마리를 처치해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Mata a 20 Kvaldir en el arrecife de los vrykuls.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Mata a 20 Kvaldir en el arrecife de los vrykuls.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Tuez 20 Kvaldirs sur la Saillie des Vrykuls.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡杀死20名维库崖上的克瓦迪尔人。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡在維酷岩臺殺死20名科瓦迪爾族人。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25860] = {
  {
    'A qualquer custo‡Любой ценой‡Koste es, was es wolle‡무슨 수를 써서라도‡A toda costa‡A toda costa‡À tout prix‡不惜代价‡不計代價',
    nil,
    'Mate 20 Kvaldir que estão atacando o Templo de Quel\'Durmar para impedir o ritual.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Убейте 20 квалдиров в храме Кель\'Дормир.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Tötet 20 Angreifer der Kvaldir im Tempel von Quel\'Dormir.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡쿠엘도르미르 사원에 침입하는 크발디르 20마리를 처치해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Mata a 20 atacantes Kvaldir en el Templo de Quel\'Dormir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Mata a 20 atacantes Kvaldir en el Templo de Quel\'Dormir.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Tuez 20 Assaillants kvaldirs dans le Temple de Quel’Dormir.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡杀死20名进犯奎尔多米尔神殿的克瓦迪尔人。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡在奎多米爾神殿內殺死20名科瓦迪爾攻擊者。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25861] = {
  {
    'Dando o exemplo‡Показательный пример‡Ein Exempel statuieren‡본때 보이기‡Dando ejemplo‡Dando ejemplo‡Décapité pour l\'exemple‡杀鸡儆猴‡樹立典範',
    nil,
    'Traga um Sumo Xamã Kvaldir à presença do Carrasco Varathress.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Приведите квалдирского верховного шамана к палачу Вератрессу.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Bringt einen Hochschamanen der Kvaldir zu Henker Verathress\' Füßen.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡크발디르 고위주술사를 집행자 베라스레스의 발밑에 데려가야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Pon un alto chamán Kvaldir a los pies del verdugo Verathress.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Pon un alto chamán Kvaldir a los pies del verdugo Verathress.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Traînez un Haut-chaman kvaldir aux pieds de l’Exécuteur Verathress.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡将一名克瓦迪尔高阶萨满祭司押送给行刑者瓦拉萨雷斯。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡帶一名科瓦迪爾高階薩滿給行刑人維拉瑟瑞斯。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25862] = {
  {
    'Propriedade roubada‡Украденное имущество‡Gestohlenes Eigentum‡도둑맞은 재산‡Propiedad robada‡Propiedad robada‡Le corps du délit‡失窃物品‡失竊的資產',
    nil,
    'Recupere o Cadinho de Nazsharin.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Верните украденный тигель Наз\'жар.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужный момент воспользуйтесь клинком воительницы Леди Наз\'жар.‡Besorgt den Schmelztiegel von Nazsharin.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡나즈샤린의 도가니를 되찾아야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Recupera el crisol de Nazsharin.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Recupera el crisol de Nazsharin.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Récupérez le Creuset de Nazsharin.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡夺回纳萨林坩埚。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡取回納茲莎林爐缸。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25863] = {
  {
    'Fardo escolhido‡Избранный груз‡Freiwillige Last‡주어진 임무‡Carga elegida‡Carga elegida‡Une fardeau nécessaire‡天降之任‡獲選的重擔',
    nil,
    'Retorne à extremidade oeste da Crista Biel\'aran com as notícias do Cadinho de Nazsharin.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Вернитесь на запад гряды Бейл\'аран и сообщите новости о тигле Наз\'жар.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужный момент воспользуйтесь клинком воительницы Леди Наз\'жар.‡Kehrt mit Euren Nachrichten vom Schmelztiegel von Nazsharin zum westlichen Ende des Biel\'arangrats zurück.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡비엘아란 마루의 서쪽 가장자리로 가서 나즈샤린의 도가니를 발견했음을 알려야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Vuelve al borde occidental de la Cresta de Biel\'aran con noticias sobre el crisol de Nazsharin.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Vuelve al borde occidental de la Cresta de Biel\'aran con noticias sobre el crisol de Nazsharin.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Retournez à l’extrémité ouest de la crête de Biel’aran pour parler du Creuset de Nazsharin à Dame Naz’jar.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡将夺回纳萨林坩埚的消息带回贝耶拉兰山西侧。|n|n这个任务是纳兹夏尔女武士幻像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回幻像。‡帶納茲莎林爐缸的消息回到畢耶拉蘭山脊的西側邊緣。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25864] = {
  {
    'Crise dos dinossauros‡Неприятности с динозаврами‡Dinosaurierkrise‡고원랩터 처치‡Crisis de dinosaurios‡Crisis de dinosaurios‡Je ne vois pas le raptor‡恐龙危机‡恐龍危機',
    nil,
    'Mate 8 Raptores do Planalto de qualquer tipo.‡Убейте 8 ящеров нагорья любого вида.‡Tötet 8 beliebige Hochlandraptoren.‡고원랩터 15마리를 처치해야 합니다.‡Mata a 8 raptores de las Tierras Altas cualesquiera.‡Mata a 8 raptores de las Tierras Altas cualesquiera.‡Tuez 8 Raptors des Hautes-terres de n’importe quel type.‡杀死8头任意种类的高地迅猛龙。‡殺死8隻任何種類的高地迅猛龍。',
  }
},
[25865] = {
  {
    'Um basta nos Pelemusgo‡Ограбление по-гнолльски‡Die Moosfellmission‡이끼가죽 놀 처치‡El asunto Pellejomusgo‡El asunto Pellejomusgo‡Raser les Poils-moussus‡藓皮偷金‡蘚皮豺狼人',
    nil,
    'Recupere 8 Lingotes de Altaforja dos Gnolls Pelemusgo.‡Заберите 8 стальгорнских слитков у гноллов из стаи Мохошкуров.‡Beschafft 8 Barren von Eisenschmiede von den Gnollen der Moosfelle.‡이끼가죽 놀을 처치해 아이언포지 주괴 8개를 되찾아야 합니다.‡Recupera 8 lingotes de Forjaz de los gnolls Pellejomusgo.‡Recupera 8 lingotes de Forjaz de los gnolls Pellejomusgo.‡Récupérez 8 Lingots de Forgefer sur des Gnolls poils-moussus.‡从藓皮豺狼人身上获得8块铁炉堡金锭。‡從蘚皮豺狼人身上取回8個鐵爐堡金錠。',
  }
},
[25866] = {
  {
    'Coureadores Ferro Negro‡Звероловы из клана Черного Железа‡Fallensteller der Dunkeleisenzwerge‡검은무쇠 덫사냥꾼‡Tramperos Hierro Negro‡Tramperos Hierro Negro‡Les trappeurs sombrefer‡黑铁诱捕者‡黑鐵陷捕者',
    nil,
    'Mate 10 Coureadores Ferro Negro.‡Убейте 10 звероловов из клана Черного Железа.‡Tötet 10 Fallensteller der Dunkeleisenzwerge.‡검은무쇠 덫사냥꾼 10명을 처치해야 합니다.‡Mata a 10 tramperos Hierro Negro.‡Mata a 10 tramperos Hierro Negro.‡Tuez 10 Trappeurs sombrefer.‡杀死10名黑铁诱捕者。‡殺死10個黑鐵陷捕者。',
  }
},
[25867] = {
  {
    'Fuga dos Gnolls‡Свободу гноллам‡Die Flucht der Gnolle‡놀 대피 작전‡Huida gnoll‡Huida gnoll‡Au secours des gnolls‡豺狼人大逃亡‡豺狼人逃脫',
    nil,
    'Obtenha as Chaves do Coureador dos Coureadores Ferro Negro e use-as para libertar 6 Gnolls das Jaulas de Gnoll.‡Заберите ключи зверолова у звероловов из клана Черного Железа, отоприте клетки гноллов и выпустите на волю 6 гноллов.‡Erbeutet den Schlüssel des Fallenstellers von Fallenstellern der Dunkeleisenzwerge und befreit damit 6 Gnolle aus den Gnollkäfigen.‡검은무쇠 덫사냥꾼으로부터 덫사냥꾼의 열쇠를 획득해 놀 우리에 있는 놀 6마리를 풀어줘야 합니다.‡Consigue la llave de trampero de los tramperos Hierro Negro y utilízalas para liberar a 6 gnolls de las jaulas gnoll.‡Consigue la llave de trampero de los tramperos Hierro Negro y utilízalas para liberar a 6 gnolls de las jaulas gnoll.‡Procurez-vous 6 Clés de trappeur en tuant des Trappeurs sombrefers et utilisez-les pour libérer autant de gnolls des Cages gnolls.‡从黑铁诱捕者身上搜到捕猎者的钥匙，打开豺狼人牢笼释放6名豺狼人。‡從黑鐵陷捕者身上取得陷捕者的鑰匙，並用鑰匙從豺狼人牢籠中釋放出6個豺狼人。',
  }
},
[25868] = {
  {
    'Yorla Laçadeira‡Йорла Темная Петля‡Yorla Dunkelschlinge‡욜라 다크스네어‡Yorla Freno Negro‡Yorla Freno Negro‡Yorla Sombrecol‡约尔拉·暗网‡尤拉‧暗陷',
    nil,
    'Mate Yorla Laçadeira.‡Убейте Йорлу Темную Петлю.‡Tötet Yorla Dunkelschlinge.‡욜라 다크스네어를 처치해야 합니다.‡Mata a Yorla Freno Negro.‡Mata a Yorla Freno Negro.‡Tuez Yorla Sombrecol.‡杀死约尔拉·暗网。‡殺死尤拉‧暗陷。',
  }
},
[25869] = {
  {
    'Temível Totem na Aldeia‡Выдворение Зловещего Тотема‡Grimmtotem in Freiwindposten‡초소의 그림토템 부족‡El Tótem Siniestro en el poblado‡El Tótem Siniestro en el poblado‡La sinistre menace‡岗哨里的恐怖图腾‡亂風崗的恐怖圖騰',
    nil,
    'Mate 10 Invasores Temível Totem.‡Убейте 10 захватчиков из клана Зловещего Тотема.‡Tötet 10 Eindringlinge der Grimmtotem.‡그림토템 침략자 10명을 처치해야 합니다.‡Mata a 10 invasores Tótem Siniestro.‡Mata a 10 invasores Tótem Siniestro.‡Tuez 10 Envahisseurs du Totem-sinistre.‡杀死10名恐怖图腾入侵者。‡殺死10名恐怖圖騰入侵者。',
  }
},
[25870] = {
  {
    'Temível Totem na Aldeia‡Выдворение Зловещего Тотема‡Grimmtotem in Freiwindposten‡초소의 그림토템 부족‡El Tótem Siniestro en el poblado‡El Tótem Siniestro en el poblado‡La sinistre menace‡岗哨里的恐怖图腾‡亂風崗的恐怖圖騰',
    nil,
    'Mate 10 Invasores Temível Totem.‡Убейте 10 захватчиков из клана Зловещего Тотема.‡Tötet 10 Eindringlinge der Grimmtotem.‡그림토템 침략자 10명을 처치해야 합니다.‡Mata a 10 invasores Tótem Siniestro.‡Mata a 10 invasores Tótem Siniestro.‡Tuez 10 Envahisseurs du Totem-sinistre.‡杀死10名恐怖图腾入侵者。‡殺死10名恐怖圖騰入侵者。',
  }
},
[25871] = {
  {
    'Por favor, salvem a sentinela‡Спасение часового‡Rettet die Schildwache‡파수꾼을 구출하라‡Salva a la centinela‡Salva a la centinela‡Sauvetage en terrain ennemi‡拯救哨兵‡拯救哨兵',
    nil,
    'Resgate a Sentinela de Feralas.‡Освободите часового Фераласа.‡Rettet die Schildwache von Feralas.‡페랄라스 파수꾼을 구출해야 합니다.‡Rescata a la centinela de Feralas.‡Rescata a la centinela de Feralas.‡Portez secours à la Sentinelle de Féralas.‡救出菲拉斯哨兵。‡解救菲拉斯哨兵。',
  }
},
[25872] = {
  {
    'Os Bravos e Destemidos‡Без страха и упрека‡Der Kriegerheld und die Wagemütigen‡용감무쌍‡Valientes y bravos‡Valientes y bravos‡Le brave et le téméraire‡勇敢与鲁莽‡勇者無懼',
    nil,
    'Salve o Valente de Vento Livre.‡Выручите храбреца заставы Вольного Ветра.‡Retten den Kriegerheld des Freiwindpostens.‡높새바람 용사를 구출해야 합니다.‡Rescata al valiente Viento Libre.‡Rescata al valiente Viento Libre.‡Portez secours au Brave de Librevent.‡救出乱风岗卫士。‡解救亂風崗勇士。',
  }
},
[25873] = {
  {
    'Chifre do traidor‡Рог предателя‡Das Horn des Verräters‡배신자의 뿔‡El cuerno del traidor‡El cuerno del traidor‡La corne de discorde‡叛徒的角‡背叛者的角',
    nil,
    'Consiga o Chifre do Chifre Longo‡Добудьте рог Долгорога.‡Erhaltet Langhorns Horn.‡롱혼의 뿔을 획득해야 합니다.‡Consigue el cuerno de Cuerno Largo.‡Consigue el cuerno de Cuerno Largo.‡Obtenez la Corne de Longue-corne.‡拿到长角之角。‡收集長角的角。',
  }
},
[25874] = {
  {
    'Chifre do traidor‡Рог предателя‡Das Horn des Verräters‡배신자의 뿔‡El cuerno del traidor‡El cuerno del traidor‡La corne de discorde‡叛徒的角‡背叛者的角',
    nil,
    'Consiga o Chifre do Chifre Longo‡Добудьте рог Долгорога.‡Erhaltet Langhorns Horn.‡롱혼의 뿔을 획득해야 합니다.‡Consigue el cuerno de Cuerno Largo.‡Consigue el cuerno de Cuerno Largo.‡Obtenez la Corne de Longue-corne.‡拿到长角之角。‡收集長角的角。',
  }
},
[25875] = {
  {
    'Gnomida infiltrada‡Гном с той стороны‡Der eingeschleuste Gnom‡내부의 노움‡La gnoma infiltrada‡La gnoma infiltrada‡Une gnome en sous-marin‡里面的侏儒‡地精內應',
    nil,
    'Procure Dada, que está disfarçada como uma Controladora de Bomba "Goblina", no Barreiro, que fica na Cordilheira das Torres de Pedra.‡Найдите Минкс, которая маскируется под "гоблина" – смотрителя помпы на Илоразработках в Когтистых горах.‡Sucht in den Schlickwerken im Steinkrallengebirge nach Minx. Sie hat sich als "Goblin" Pumpenkontrolleur getarnt.‡돌발톱 산맥의 진흙작업장에서 고블린 펌프 관리자로 위장한 밍스를 찾아야 합니다.‡Busca a Minx disfrazada de controlador de bomba "goblin" en Los Fangados, en Sierra Espolón.‡Busca a Minx disfrazada de controlador de bomba "goblin" en Los Fangados, en Sierra Espolón.‡Entrez en contact avec Coquine, qui est déguisée en contrôleur de pompe « gobelin » à la Vidangerie, dans les Serres-Rocheuses.‡去石爪山脉油污潭找伪装成“地精”油泵操作员的明克斯。‡在石爪山脈的淤泥作坊，找到偽裝成『哥布林』幫浦控制者的敏克絲。',
  }
},
[25876] = {
  {
    'Lá em cima!‡Это там!‡Sie ist da oben!‡저 높은 곳에!‡¡Ahí arriba!‡¡Ahí arriba!‡C\'est tout en haut !‡就在上面！‡就在上頭!',
    nil,
    'Roube o Livro de Registros de Krom\'gar.‡Украдите Кром\'гарский буровой журнал.‡Stehlt das Logbuch von Krom\'gar.‡크롬가르 항해 일지를 훔쳐야 합니다.‡Roba el libro de registro Krom\'gar.‡Roba el libro de registro Krom\'gar.‡Volez le Journal de bord de Krom’gar.‡偷走克罗姆加日志簿.‡偷走克羅姆加日誌。',
  }
},
[25877] = {
  {
    'Sem tempo para despedidas!‡Не время раскланиваться!‡Keine Zeit für Verabschiedungen!‡이별은 짧게!‡¡Sin tiempo para despedidas!‡¡Sin tiempo para despedidas!‡Pas le temps pour des adieux !‡没时间道别了！‡沒時間說再見!',
    nil,
    'Fale novamente com o Comandante dos Batedores Barus no Posto Mirkfallon, que fica na Cordilheira das Torres de Pedra.‡Вернитесь к командиру разведчиков Барусу на пост на Мутном озере в Когтистых горах.‡Kehrt zu Späherkommandant Barus am Mirkfallonposten im Steinkrallengebirge zurück‡돌발톱 산맥의 땅거미 주둔지에 있는 정찰대장 바루스에게 가야 합니다.‡Vuelve con el comandante Barus al Puesto Mirkfallon, en Sierra Espolón.‡Vuelve con el comandante Barus al Puesto Mirkfallon, en Sierra Espolón.‡Retournez auprès du commandant des éclaireurs Barus au Poste de Mirkfallon, dans les Serres-Rocheuses.‡去找石爪山脉暗色哨站的斥候指挥官巴努斯。‡到石爪山脈的暗色崗哨找斥候指揮官巴魯斯。',
  }
},
[25878] = {
  {
    'Tramando aquela sabotagem...‡План саботажа‡Anleitung zur Sabotage‡펌프 파괴‡Planear el sabotaje‡Planear el sabotaje‡Sabotage de pompes‡密谋破坏‡密謀破壞',
    nil,
    'Use o Controlador de Bomba Goblínico para destruir 4 Bombas Petrolíferas Goblínicas.‡Используйте пульты управления гоблинскими помпами, чтобы уничтожить 4 гоблинских нефтяных насоса.‡Zerstört 4 Goblinölpumpen mit der Goblinpumpensteuerung.‡고블린 펌프 조종기를 사용하여 고블린 기름 펌프 4대를 파괴해야 합니다.‡Utiliza a los controladores de bomba goblin para destruir 4 bombas de petróleo goblin.‡Utiliza a los controladores de bomba goblin para destruir 4 bombas de petróleo goblin.‡Utilisez le Boîtier de commande des pompes pour détruire 4 Pompes de naphte gobelines.‡用地精油泵控制器摧毁4座地精油泵。‡利用哥布林幫浦控制器摧毀4個哥布林石油幫浦。',
  }
},
[25879] = {
  {
    'O problema dos parvos desorientados‡Проблема болвана неотесанного‡Ärger mit den Trampeln‡미련퉁이 문제‡El problema del patán inútil‡El problema del patán inútil‡Le problème des dadais chancelants‡伐木场巨怪之难‡笨重的蠢蛋',
    nil,
    'Mate 10 Parvos Desorientados‡Перебейте 10 болванчиков.‡Tötet 10 Trampel.‡미련퉁이 10명을 처치해야 합니다.‡Mata a 10 patanes inútiles.‡Mata a 10 patanes inútiles.‡Tuez 10 Dadais chancelants.‡杀死10头伐木场巨怪。‡殺死10個笨重的蠢蛋。',
  }
},
[25880] = {
  {
    'Avise o mestre Thal\'darah‡Предупредить мастера Тал\'дару‡Warnt Meister Thal\'darah‡탈다라 스승님께 경고‡Avisa al maestro Thal\'darah‡Avisa al maestro Thal\'darah‡Avertissez maître Thal\'darah‡警告萨拉达大师‡警告薩歐達拉大師',
    nil,
    'Apresente-se ao Mestre Thal\'darah no Mirante de Thal\'darah, que fica na Cordilheira das Torres de Pedra.‡Отнесите весть мастеру Тал\'даре на Дозорный холм Тал\'дара в Когтистых горах.‡Meldet Euch bei Meister Thal\'darah an der Aussicht von Thal\'darah im Steinkrallengebirge.‡돌발톱 산맥의 탈다라 전망대에 있는 스승 탈다라에게 보고해야 합니다.‡Preséntate ante el maestro Thal\'darah en el Mirador Thal\'darah, en Sierra Espolón.‡Preséntate ante el maestro Thal\'darah en el Mirador Thal\'darah, en Sierra Espolón.‡Rendez-vous auprès de Maître Thal’darah au Surplomb de Thal’darah, dans les Serres-Rocheuses.‡去找石爪山脉萨达拉瞭望台的萨拉达大师。‡到石爪山脈的薩歐達拉瞰臺向薩歐達拉大師回報。',
  }
},
[25881] = {
  {
    'Protetor perdido‡Выжившие стражи‡Verschollene Wächter‡길 잃은 감시자‡Celadores perdidos‡Celadores perdidos‡Gardiens égarés‡失踪的守望者‡失蹤的看守者',
    nil,
    'Encontre e resgate 8 Protetores Perdidos.‡Найдите и спасите 8 выживших стражей‡Findet und rettet 8 verschollene Wächter.‡길 잃은 감시자 8명을 찾아 구출해야 합니다.‡Localiza y rescata a 8 celadores perdidos.‡Localiza y rescata a 8 celadores perdidos.‡Trouvez et sauvez 8 Gardiens égarés.‡找到并救出8名失踪的守望者。‡搜救8個失蹤的看守者。',
  }
},
[25882] = {
  {
    'Uma mãozinha para o rancho‡Помощь на ферме‡Hilfe für das Gehöft‡도움이 필요한 목장‡Echar una mano en la granja‡Echar una mano en la granja‡Un coup de main à la ferme‡支援农场‡協助農場',
    nil,
    'Fale com o Sargento Pedertelo no Rancho Ambarmanso.‡Поговорите с сержантом Кремнемолотом на ферме Янтарленов.‡Sprecht mit Unteroffizier Flinthammer auf dem Gehöft Bernruh.‡앰버스틸 목장에 있는 하사관 플린트해머와 대화해야 합니다.‡Habla con el sargento Martílex en la Granja Semperámbar.‡Habla con el sargento Martílex en la Granja Semperámbar.‡Parlez au Sergent Martel-silex à la Ferme des Distillambre.‡跟冻石农场的火锤中士谈一谈。‡到凍石農場找火錘中士談話。',
  }
},
[25883] = {
  {
    'Naga má fica sem brinquedo‡Найти и обезвредить‡Entwaffnend‡무장 해제‡Sin armas‡Sin armas‡Non-prolifération des armes‡拆卸武器‡大撤防',
    nil,
    'Destrua 6 conjuntos de Tridentes Naga.‡Уничтожьте 6 комплектов трезубцев наг.‡Zerstört 6 Dreizackstapel der Naga.‡나가 삼지창을 세워 놓은 곳 6군데를 파괴해야 합니다.‡Debes destruir 6 pilas de tridentes de naga.‡Debes destruir 6 pilas de tridentes de naga.‡Vous devez détruire 6 faisceaux de Tridents nagas.‡你必须摧毁6套纳迦三叉戟。‡你必須摧毀6組納迦三叉戟。',
  }
},
[25884] = {
  {
    'Haja o que houver‡Будь что будет!‡Auf Biegen und Brechen‡이판사판‡Pase lo que pase‡Pase lo que pase‡Envers et contre tout‡赴汤蹈火‡赴湯蹈火在所不辭',
    nil,
    'Mate 12 Nagas Zin\'jatar na Amarra, que fica na Floresta Kelp\'thar.‡Убейте 12 наг Зин\'жатара на Жемчужной ферме в лесу Келп’тар.‡Tötet 12 Naga des Zin\'jatar in der Umklammerung im Tang\'tharwald.‡켈프타르 숲의 구속의 손아귀 안에 있는 진자타르 나가 12마리를 처치해야 합니다.‡Mata a 12 nagas Zin\'jatar en El Encierro, en el Bosque Kelp\'thar.‡Mata a 12 nagas Zin\'jatar en El Encierro, en el Bosque Kelp\'thar.‡Tuez 12 Nagas zin’jatar à l\'Étreinte, dans la Forêt de Varech\'thar.‡在柯尔普萨之森的关押所击败12只金加塔尔纳迦。‡到凱波薩爾森林的窩巢殺死12名金加塔納迦。',
  }
},
[25885] = {
  {
    'O quê? Quê? Nas minhas entranhas...?‡Ой-ой – что со мной?‡Keine Macht den Algen‡뭐? 뭐지? 뱃속의 이 느낌은...?‡¿Qué? ¿Qué? ¿En mis tripas...?‡¿Qué? ¿Qué? ¿En mis tripas...?‡Transit tumultueux‡啊……痛！我的肚子……‡什麼?什麼?在我的腸子裡...?',
    nil,
    'Colete 7 Brotos de Alga-crespa dos Ceifadores Luzespinha, que ficam na Amarra.‡Соберите 7 побегов вьющихся водорослей у жнецов Мерцающего хребта на Жемчужной ферме.‡Sammelt 7 Schlängelgrassprösslinge von Erntern der Schimmerrücken in der Umklammerung.‡구속의 손아귀에 있는 흐린빛가시 채집꾼으로부터 용틀임해초 싹 7개를 수집해야 합니다.‡Reúne 7 brotes de hierba titilante de los cosechadores Brillespina en El Encierro.‡Reúne 7 brotes de hierba titilante de los cosechadores Brillespina en El Encierro.‡Récupérez 7 Pousses de gigoteuse sur des Moissonneurs scintépines dans l\'Étreinte.‡从关押所里的光脊收割者身上收集7株蜷草苗芽。‡從窩巢的光脊收割者那裡收集7棵扭草嫩芽。',
  }
},
[25886] = {
  {
    'Aproveitando a vantagem‡Закрепление успехов‡Den Vorteil nutzen‡여세를 몰아‡Aprovechar la ventaja‡Aprovechar la ventaja‡Conserver l\'avantage‡扩大优势‡佔領優勢',
    nil,
    'Mate 4 Capitães Avançados do Crepúsculo.‡Истребите 4 сумеречных полевых командиров.‡Tötet 4 Zwielichtfeldhauptmänner.‡황혼의 야전 지휘관 4마리를 처치해야 합니다.‡Asesina a 4 capitanes de campo Crepusculares.‡Asesina a 4 capitanes de campo Crepusculares.‡Tuez 4 Capitaines du Crépuscule.‡消灭4名暮光战地头领。‡消滅4個暮光戰場隊長。',
  }
},
[25887] = {
  {
    'Rastro de destruição‡Волна разрушения‡Welle der Zerstörung‡눈 뜨는 파괴 본능‡Estela de destrucción‡Estela de destrucción‡La destruction dans son sillage‡毁灭的苏醒‡在毀滅之後',
    nil,
    'Use o Orbe da Sugestão para dominar um Grande Tubarão Faminto e, a seguir, use-o para destruir 25 Zin\'jatar na Amarra.‡С помощью сферы внушения укротите изголодавшихся больших акул, затем натравите их на 12 стражей Зин\'жатара на Жемчужной ферме.‡Benutzt die Kugel der Anregung, um einen ausgemergelten großen Hai zu unterwerfen und benutzt ihn dann, um 12 Gefolgsleute des Zin\'jatar in der Umklammerung zu töten.‡독려의 수정구를 사용하여 굶주린 거대한 귀상어를 구슬린 다음, 귀상어로 구속의 손아귀에 있는 진자타르 나가 12마리를 처치해야 합니다.‡Utiliza el orbe de sugestión para someter a un gran tiburón famélico y úsalo para destruir a 12 Zin\'jatar en El Encierro.‡Utiliza el orbe de sugestión para someter a un gran tiburón famélico y úsalo para destruir a 12 Zin\'jatar en El Encierro.‡Utilisez l\'Orbe de suggestion pour assujettir un Grand requin famélique, puis utilisez l\'animal pour tuer 12 Zin\'jatar dans l\'Étreinte.‡使用示意宝珠驯服一头饥饿的巨鲨，然后指挥它消灭关押所内的12只金加塔尔纳迦。‡用建言寶珠降服一隻極餓的大鯊魚，然後利用牠到窩巢消滅12名金加塔劫掠者。',
  }
},
[25888] = {
  {
    'Descompressão‡Декомпрессия‡Druckabbau‡수압 적응‡Descompresión‡Descompresión‡Décompression‡减压‡減壓',
    nil,
    'Use a Pedra da Respiração de Moana em 10 Soldados Aprisionados na Amarra.‡Воспользуйтесь камнем дыхания Моаны, чтобы выручить 10 пленных солдат на Жемчужной ферме.‡Benutzt Moanahs Atemstein an 10 eingekerkerten Soldaten in der Umklammerung.‡모아나의 호흡석을 구속의 손아귀 안에 갇힌 병사 10명에게 사용해야 합니다.‡Usa la piedra de aliento de Moanah en 10 soldados encarcelados en El Encierro.‡Usa la piedra de aliento de Moanah en 10 soldados encarcelados en El Encierro.‡Utilisez la Pierre de souffle de Moanah sur 10 Soldats emprisonnés dans l\'Étreinte.‡对关押所的被禁锢的卫兵使用莫安纳的气息之石，搭救10名卫兵。‡將摩亞那的氣浮石用在窩巢裡10名被囚禁的士兵。',
  }
},
[25889] = {
  {
    'Salve as crianças!‡Спасите детей!‡Rettet die Kinder!‡젊은 제자들을 구출하라!‡¡Salva a los niños!‡¡Salva a los niños!‡Les enfants d\'abord !‡救救孩子们！‡救救孩子!',
    nil,
    'Use o Hipogrifo do Mestre Thal\'darah para resgatar 5 Jovens Druidas Indefesos do Bosque de Thal\'darah.‡С помощью гиппогрифа мастера Тал\'дара спасите 5 молодых беспомощных друидов из рощи Тал\'дара.‡Rettet mit Meister Thal\'darahs Hippogryph 5 hilflose junge Druiden aus dem Hain von Thal\'darah.‡스승 탈다라의 히포그리프를 타고 탈다라 숲에서 무력한 젊은 드루이드 5명을 구출해야 합니다.‡Monta el hipogrifo del maestro Thal\'darah y rescata a 5 druidas jóvenes indefensos de la Arboleda de Thal\'darah.‡Monta el hipogrifo del maestro Thal\'darah y rescata a 5 druidas jóvenes indefensos de la Arboleda de Thal\'darah.‡Utilisez l’Hippogriffe de Maître Thal\'darah pour secourir 5 Jeunes druides sans défense du Bosquet de Thal\'darah.‡用萨达拉大师的角鹰兽营救萨达拉营地的5名无助的年轻德鲁伊。‡使用薩歐達拉大師的角鷹獸，從薩歐達拉樹林救出5個無助的年輕德魯伊。',
  }
},
[25890] = {
  {
    'Nespirah‡Неспира‡Nespirah‡네스피라‡Nespirah‡Nespirah‡Nespirah‡奈瑟匹拉‡奈斯畢拉',
    nil,
    'Passe pela entrada noroeste de Nespirah e, em seguida, descubra um jeito de se comunicar com ela.‡Войдите в раковину Неспиры через северо-западный вход и найдите способ с ней поговорить.‡Betretet Nespirahs nordwestlichen Eingang und findet dann einen Weg, um mit ihr zu sprechen.‡네스피라 북서쪽 입구로 들어가 네스피라와 대화할 수단을 찾아야 합니다.‡Introdúcete por la entrada noroeste de Nespirah. Después, busca una forma de comunicarte con ella.‡Introdúcete por la entrada noroeste de Nespirah. Después, busca una forma de comunicarte con ella.‡Entrez dans Nespirah par l’entrée nord-ouest, puis trouvez le moyen de communiquer avec elle.‡进入奈瑟匹拉的西北入口，然后找到与其交流的方法。‡進入奈斯畢拉西北邊的入口，然後找到跟她溝通的方式。',
  }
},
[25891] = {
  {
    'Um último esforço‡Последний заход‡Eine Letzte Anstrengung‡필사적인 노력‡Un último esfuerzo por la descendencia‡Un último esfuerzo por la descendencia‡Effort désespéré‡孤注一掷‡最後的努力',
    nil,
    'Auxilie o Mestre Thal\'darah na busca por qualquer druida deixado para trás no Bosque de Thal\'darah.‡Помогите мастеру Тал\'даре найти уцелевших друидов в роще Тал\'дара.‡Helft Meister Thal\'darah bei der Suche nach Druiden, die im Hain von Thal\'darah zurückgelassen wurden.‡스승 탈다라를 도와 탈다라 숲에 남겨진 드루이드가 없는지 수색해야 합니다.‡Ayuda al maestro Thal\'darah en su búsqueda de druidas rezagados en la Arboleda de Thal\'darah.‡Ayuda al maestro Thal\'darah en su búsqueda de druidas rezagados en la Arboleda de Thal\'darah.‡Aidez Maître Thal’darah à repérer des druides encore prisonniers du Bosquet de Thal’darah.‡帮助萨达拉大师寻找在萨达拉林地掉队的德鲁伊。‡協助薩歐達拉大師尋找留在薩歐達拉樹林的德魯伊。',
  }
},
[25892] = {
  {
    'Perdendo terreno‡Отступление‡Haltlos‡후퇴‡Perdiendo terreno‡Perdiendo terreno‡On perd du terrain‡失地‡失去領土',
    nil,
    'Use o cavalo-marinho da Falaondas Valoren para voltar até o Almirante Dvorek sob o terraço sul nas Ruínas de Vashj\'ir.‡Воспользуйтесь морским коньком говорящей с волнами Валорен, чтобы вернуться к адмиралу Двореку, находящемуся под южной террасой в Руинах Вайш\'ира.‡Benutzt Wellensprecherin Valorens Seepferd, um zu Admiral Dvorek unter der südlichen Terrasse in den Ruinen von Vashj\'ir zurückzukehren.‡파도예언자 발로렌의 해마를 이용하여 바쉬르 폐허 남쪽 계단지 밑에 있는 제독 드보렉에게 가야 합니다.‡Utiliza el caballito de mar de la hablaolas Valoren para volver con el almirante Dvorek bajo el bancal sur en las Ruinas de Vashj\'ir.‡Utiliza el caballito de mar de la hablaolas Valoren para volver con el almirante Dvorek bajo el bancal sur en las Ruinas de Vashj\'ir.‡Utilisez l’hippocampe de la parle-vague Valoren pour retourner auprès de l’amiral Dvorek sous la terrasse sud, dans les Ruines de Vashj’ir.‡使用波涛语者瓦罗伦的海马去找瓦丝琪尔废墟南部平台下的德沃雷克将军。‡回去瓦許伊爾廢墟裡的南邊殿堂下方找德弗瑞克上將。',
  }
},
[25893] = {
  {
    'Plano de emergência‡Отчаянный план‡Ein verzweifelter Plan‡필사적인 계획‡Plan desesperado‡Plan desesperado‡Un plan désespéré‡绝望的计划‡背水一戰',
    nil,
    'Encontre-se com o Engenheiro Hexasfrega na Crista Biel\'aran.‡Встретьтесь с инженером Мегагексом на гряде Бейл\'аран.‡Trefft Euch mit Ingenieur Hexasept auf dem Biel\'arangrat.‡비엘아란 마루에 있는 기술자 헥사스크럽을 만나야 합니다.‡Reúnete con el ingeniero Friegahexágonos en la Cresta de Biel\'aran.‡Reúnete con el ingeniero Friegahexágonos en la Cresta de Biel\'aran.‡Allez retrouver l’Ingénieur Hexabrosse sur la Crête de Biel’aran.‡去贝耶拉兰山找工程师“洗衣桶”。‡在畢耶拉蘭山脊和工程師赫克薩克拉碰面。',
  }
},
[25894] = {
  {
    'Águas hostis‡Опасные воды‡Feindliche Gewässer‡위협적인 수중 생물‡Aguas hostiles‡Aguas hostiles‡Des eaux hostiles‡敌对水域‡敵方水域',
    nil,
    'Mate 10 Bicões Pelancalamas.‡Уничтожьте 10 слизнешкурых хапуг.‡Tötet 10 Schlickhautschnorrer.‡진흙피부 강탈자를 10마리 처치해야 합니다.‡Mata a 10 chupópteros Pielmugre.‡Mata a 10 chupópteros Pielmugre.‡Tuez 10 Écornifleurs bourbepeau.‡消灭10名污鳞拾荒者。‡殺死10名汙皮收集者。',
  }
},
[25895] = {
  {
    'É melhor se preparar‡Наготове‡Immer vorbereitet‡준비하시고‡Hay que venir preparados‡Hay que venir preparados‡Toujours prêt !‡有备而来‡有備而來',
    nil,
    'Recupere o Kit de Sobrevivência da Aliança.‡Достаньте ящик Альянса с предметами первой необходимости.‡Besorgt eine Überlebensausrüstung der Allianz.‡얼라이언스 구명 상자를 입수해야 합니다.‡Recupera un equipo de supervivencia de la Alianza.‡Recupera un equipo de supervivencia de la Alianza.‡Retrouvez un Kit de survie de l’Alliance.‡回收联盟救生箱。‡取得聯盟求生包。',
  }
},
[25896] = {
  {
    'Assembleia dos devotos‡Сбор на ритуал‡Andächtige Versammlung‡헌신적인 집회‡Asamblea devota‡Asamblea devota‡Une assemblée dévote‡集合虔诚者‡虔誠集會',
    nil,
    'Procure o Invocador das Profundezas Azrajar no meio das escadas ao norte e 6 Sacerdotisas da Maré na região superior das ruínas, e ordene que eles retornem ao templo.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Найдите призывателя глубин Азражара на полпути вниз по северной лестнице и 6 жриц прилива Сира\'кесс в верхней части руин, после чего попросите их вернуться в храм.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Sucht Tiefenrufer Azrajar in der Mitte der nördlichen Treppe sowie 6 Gezeitenpriesterinnen der Sira\'kess auf der oberen Ebene der Ruinen und tragt ihnen auf, zum Tempel zurückzukehren.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡북쪽 계단으로 가는 길에서 심해소환사 아즈라자르를, 폐허의 상층부에서 시라케스 해일여사제 6명을 찾아 사원으로 돌아오도록 전해야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Busca al clamaprofundidades Azrajar a medio camino de las escaleras del norte y a 6 sacerdotisas de las mareas Sira\'kess en la zona superior de las ruinas y comunícales las instrucciones de regresar al templo.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Busca al clamaprofundidades Azrajar a medio camino de las escaleras del norte y a 6 sacerdotisas de las mareas Sira\'kess en la zona superior de las ruinas y comunícales las instrucciones de regresar al templo.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar en un marco temporal para volver a la visión.‡Trouvez le Mandefonds Azrajar à mi-hauteur des escaliers nord et 6 Prêtresses des marées de Sira’kess dans la partie supérieure des ruines, et dites-leur de retourner au temple.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡在北部台阶的中途找到深渊召唤者阿泽拉夏，在废墟上部找到6名希拉柯丝海潮女祭司，指示她们回到神殿。|n|n这个任务是纳兹夏尔女武士幻像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回幻像。‡找尋深淵呼喚者阿茲拉賈爾及6名席拉克斯海潮女祭司，並指引他們回到神殿。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25897] = {
  {
    'Corda cabeluda‡Веревочный план‡Seilakrobatik‡펼쳐지는 계획‡Plan desplegable‡Plan desplegable‡Un plan de sac et de corde‡展开计划‡揭露計畫',
    nil,
    'Colete 8 Rolos de Corda Kvaldir.‡Добудьте 8 мотков квалдирской веревки.‡Sammelt 8 Kvaldirseile.‡크발디르 밧줄 똬리 8묶음을 모아야 합니다.‡Reúne 8 espirales de cuerda Kvaldir.‡Reúne 8 espirales de cuerda Kvaldir.‡Obtenez 8 Rouleaux de corde kvaldir.‡收集8根克瓦迪尔套索。‡收集8綑科瓦迪爾繩索。',
  }
},
[25898] = {
  {
    'Fazendo as honras‡Честь и слава‡Ehre und Privileg‡명예로운 특권‡Honor y privilegio‡Honor y privilegio‡Honneur et privilège‡荣幸与特权‡榮譽與特權',
    nil,
    'Nade até a superfície, pegue o sinalizador e use-o na direção das embarcações da Aliança.‡Поднимитесь на поверхность, возьмите сигнальное ружье и запустите сигнальную ракету в направлении кораблей Альянса.‡Schwimmt zur Oberfläche, holt die Leuchtpistole und feuert ein Rettungsleuchtfeuer in Richtung der Allianzschiffe.‡수면으로 올라가서 신호용 권총을 구한 다음, 얼라이언스 함선을 향해 구명 신호탄을 쏴야 합니다.‡Nada hacia la superficie, recupera la pistola de bengalas y dispara una centella de rescate hacia los barcos de la Alianza.‡Nada hacia la superficie, recupera la pistola de bengalas y dispara una centella de rescate hacia los barcos de la Alianza.‡Nagez jusqu’à la surface, prenez le lance-fusées et tirez une fusée de détresse vers les Vaisseaux de l’Alliance.‡游上水面，拿到信号枪，朝联盟船只发射信号弹。‡游到水面上，取得信號槍，然後對聯盟船隻發射救援的信號彈。',
  }
},
[25899] = {
  {
    'Através das linhas inimigas‡Прорыв‡Durchbruch‡적진을 뚫고‡Romper las defensas‡Romper las defensas‡Percée‡突破‡突圍',
    nil,
    'Mate 10 Senhores Calcinantes do Crepúsculo.‡Уничтожьте 10 выжигателей из культа Сумеречного Молота.‡Tötet 10 sengende Zwielichtfürsten.‡황혼의 불길군주 10마리를 처치해야 합니다.‡Asesina a 10 señores de las brasas Crepusculares.‡Asesina a 10 señores de las brasas Crepusculares.‡Tuez 10 Seigneurs incendiaires du Crépuscule.‡消灭10名暮光灼炎主宰。‡消滅10個暮光焦灼之王。',
  }
},
[25900] = {
  {
    'Fazendo contato‡Контакт‡Kontaktaufnahme‡교류‡Estableciendo contacto‡Estableciendo contacto‡Prise de contact‡尝试交流‡接觸',
    nil,
    'Observe enquanto o Reparador da Terra Duarn tenta se comunicar com Nespirah.‡Проследите за тем, как Целитель Земли Дуарн попытается заговорить с Неспирой.‡Beobachtet Erdheiler Duarn, während er versucht, mit Nespirah zu sprechen.‡네스피라와 이야기하는 대지치유사 두아른을 지켜보아야 합니다.‡Observa cómo el ensalmador de la tierra Duarn trata de comunicarse con Nespirah.‡Observa cómo el ensalmador de la tierra Duarn trata de comunicarse con Nespirah.‡Observez le Soigneterre Duarn essayer de communiquer avec Nespirah.‡在大地治愈者达鲁尝试与奈瑟匹拉进行交流时，在一旁观察。‡觀察大地治癒者杜亞恩嘗試與奈斯畢拉溝通。',
  }
},
[25901] = {
  {
    'Programa de reciclagem de Hyjal‡План очищения Хиджала‡Wiederverwertung auf dem Hyjal‡하이잘 재활용 작전‡Programa de reciclaje de Hyjal‡Programa de reciclaje de Hyjal‡Rien ne se perd à Hyjal‡海加尔回收计划‡海加爾資源回收計畫',
    nil,
    'Recolha 15 Flechas do Protetor.‡Соберите 15 стрел стража.‡Sammelt 15 Pfeile des Aufsehers.‡감시자의 화살 15개를 수집해야 합니다.‡Reúne 15 flechas de celador.‡Reúne 15 flechas de celador.‡Ramassez 15 Flèches de sylvegarde.‡收集15支监护者之箭。‡收集15支守衛者之箭。',
  }
},
[25902] = {
  {
    '‡Твой первый тотем!‡Euer erstes Totem!‡‡¡Tu primer tótem!‡‡Votre premier totem !‡‡',
    nil,
    nil,
  }
},
[25903] = {
  {
    '‡[Deprecated] It\'s Hot and it Might Explode‡‡‡Misión kamikaze‡‡Très chaud, très explosif !‡‡',
    nil,
    nil,
  }
},
[25904] = {
  {
    'O Martelo e a chave‡Молот и Ключ‡Der Hammer und der Schlüssel‡망치단과 열쇠‡El martillo y la llave‡El martillo y la llave‡Le marteau et la clé‡锤子和钥匙‡錘子與鑰匙',
    nil,
    'Mate um Capitão Avançado do Crepúsculo e recupere o Glifo de Abertura.‡Убейте сумеречного полевого командира и добудьте символ Открытия.‡Tötet einen Zwielichtfeldhauptmann und besorgt Euch die Glyphe des Öffnens.‡황혼의 야전 지휘관을 처치하고 개방의 문양을 입수해야 합니다.‡Mata a un capitán de campo Crepuscular y recupera el Glifo de Apertura.‡Mata a un capitán de campo Crepuscular y recupera el Glifo de Apertura.‡Tuez un Capitaine du Crépuscule et récupérez le Glyphe d’ouverture.‡消灭一名暮光战地头领，并且拿到开启雕文。‡殺死一個暮光戰場隊長，取回開啟雕紋符石。',
  }
},
[25905] = {
  {
    'A fuga dos carneiros‡Бараны в бегах‡Widder auf der Flucht‡없어진 산양들‡Carneros prófugos‡Carneros prófugos‡Béliers en vadrouille‡山羊大潜逃‡逃走的山羊',
    nil,
    'Recupere 6 Carneiros Roubados nos Montes Túndricos usando /assobiar.‡Выведите с холмов Тандрид 6 украденных баранов, используя /свист.‡Benutzt /pfeifen, um 6 gestohlene Widder aus den Tundridhügeln zurückzuholen.‡휘파람을 불어 툰드리드 언덕에 있는 도둑맞은 산양 6마리를 데려가야 합니다. 대화창에 /휘파람을 입력하면 휘파람을 불 수 있습니다.‡Recupera 6 carneros robados de Las Colinas Tundra utilizando el comando /silbar.‡Recupera 6 carneros robados de Las Colinas Tundra utilizando el comando /silbar.‡Récupérez 6 Béliers volés dans les Collines de Tundrid en utilisant la commande /siffle.‡用/whistle从冻土岭找回6头被偷走的山羊。‡利用/whistle指令在凍土嶺取回失竊的山羊。',
  }
},
[25906] = {
  {
    'O terceiro Portal de Chamas‡Третьи огненные врата‡Das dritte Flammentor‡세 번째 화염관문‡La tercera puerta de llamas‡La tercera puerta de llamas‡Le tiers portail‡第三道火焰之门‡第三道烈焰之門',
    nil,
    'Atravesse o portal de chamas na Terra Queimada e encontre Garunda Picomonte do outro lado.‡Пройдите через огненные врата на Огненные Просторы и найдите там Гарунда Горного Пика.‡Reist durch das Flammentor in der Verbrannten Ebene und sucht nach Garunda Bergkuppe.‡불타버린 평원의 화염관문으로 들어가, 그 안에서 가룬다 마운틴피크를 찾아야 합니다.‡Atraviesa la puerta de llamas en La Llanura Agostada y localiza a Garunda Picomontaña en el interior.‡Atraviesa la puerta de llamas en La Llanura Agostada y localiza a Garunda Picomontaña en el interior.‡Traversez le portail de flammes dans la Plaine Incendiée et retrouvez Garunda Pic-de-Montagne de l’autre côté.‡穿过焦痕平原的火焰之门找到里面的加仑达·山峰。‡通過烈焰平原的烈焰之門，尋找加讓達·山巔。',
  }
},
[25907] = {
  {
    'Trabalho escravo‡Рабский труд‡Sklavenarbeit‡노예 일꾼‡Trabajo de esclavos‡Trabajo de esclavos‡Désesclavagisme‡奴隶劳工‡奴隸的工作',
    nil,
    'Use a Corda de Duarn para salvar 8 Mineradores de Pérolas Escravizados.‡Воспользуйтесь веревкой Дуарна, чтобы освободить 8 порабощенных добытчиков жемчуга.‡Benutzt Duarns Seil, um 8 versklavte Perlenminenarbeiter zu retten.‡두아른의 밧줄을 사용하여 진주 캐는 노예 8명을 구해야 합니다.‡Usa la Cuerda de Duarn para salvar a 8 mineros de perlas esclavizados.‡Usa la Cuerda de Duarn para salvar a 8 mineros de perlas esclavizados.‡Utilisez la Corde de Duarn pour sauver 8 Collecteurs de perles asservis.‡使用达鲁的绳子营救8个被奴役的采珠人。‡用杜亞恩的繩索解救8位被奴役的珍珠採礦工。',
  }
},
[25908] = {
  {
    'Limpando o organismo‡Уничтожить врага‡Bestraft sie‡고통 완화‡Cíñete a ellos‡Cíñete a ellos‡Décrassage intérieur‡忍无可忍‡給他們好看',
    nil,
    'Mate 7 Sentinelas Idra\'kess e 7 Encantadoras Idra\'kess.‡Убейте по 7 часовых и чародеек Идра\'кесса.‡Tötet 7 Schildwachen des Idra\'kess und 7 Verzauberinnen des Idra\'kess.‡이드라케스 파수꾼 7마리와 이드라케스 요술사 7마리를 처치해야 합니다.‡Mata a 7 centinelas Idra\'kess y a 7 encantadoras Idra\'kess.‡Mata a 7 centinelas Idra\'kess y a 7 encantadoras Idra\'kess.‡Tuez 7 Sentinelles d’Idra’kess et 7 Enchanteresses d’Idra’kess.‡杀死7个埃卓凯丝哨兵和7个埃卓凯丝导魔师。‡殺死7名艾德拉奇斯哨兵和7名艾德拉奇斯女巫師。',
  }
},
[25909] = {
  {
    'Capture o caranguejo‡Захват краба‡Fang den Krebs‡게 사냥‡Captura al cangrejo‡Captura al cangrejo‡Capturer un crabe‡抓螃蟹‡抓螃蟹',
    nil,
    'Use a Rede de Duarn para capturar um Caranguejo Buscafundo dentro de Nespirah.‡Поймайте сетью Дуарна глубинного краба в Неспире.‡Benutzt Duarns Netz, um einen Tiefensucherkrebs in Nespirah zu fangen.‡두아른의 그물을 써서 네스피라 안에 있는 해저 땅게를 잡아야 합니다.‡Usa la red de Duarn para capturar a un cangrejo Buscaprofundo en el interior de Nespirah.‡Usa la red de Duarn para capturar a un cangrejo Buscaprofundo en el interior de Nespirah.‡Utilisez le Filet de Duarn pour capturer un Crabe cherchefonds dans Nespirah.‡在奈瑟匹拉体内，使用达鲁的网捕捉一只深渊猎手蟹。‡用杜亞恩的網子抓住奈斯畢拉裡的深尋蟹。',
  }
},
[25910] = {
  {
    'Acabou a moleza‡Пощады больше не будет‡Die Zeit für Gnade ist vorbei‡자비는 없다‡El tiempo de la compasión pasó‡El tiempo de la compasión pasó‡L\'heure n\'est plus à la pitié‡慈悲的时间过去了‡仁慈的時機已過',
    nil,
    'Mate 10 Atormentadores Derretidos e 4 Senhores da Chama Sombria.‡Убейте 10 раскаленных мучителей и 4 мастеров пламени Тьмы.‡Tötet 10 geschmolzene Peiniger und 4 Meister der Schattenflamme.‡용암 심문관 10마리와 암흑불길 지배자 4마리를 처치해야 합니다.‡Asesina a 10 torturadores fundidos y a 4 maestros Pirosombra.‡Asesina a 10 torturadores fundidos y a 4 maestros Pirosombra.‡Tuez 10 Tourmenteurs en fusion et 4 Maîtres Ombreflamme.‡消灭10名熔岩折磨者和4名影焰主宰。‡殺死10個熔火折磨者和4個暗影之焰大師。',
  }
},
[25911] = {
  {
    'Boas notícias‡Добрые вести‡Willkommene Nachrichten‡반가운 소식‡Noticias bienvenidas‡Noticias bienvenidas‡De bonnes nouvelles‡好消息‡歡迎的消息',
    nil,
    'Fale novamente com o Capitão Taylor na Praia Tranquila.‡Вернитесь к капитану Тейлору в Тихий залив.‡Kehrt zu Kapitän Taylor am Stillen Strand zurück.‡평온의 침식지에 있는 부대장 테일러에게 가야 합니다.‡Vuelve con el capitán Taylor a la Estela Tranquila.‡Vuelve con el capitán Taylor a la Estela Tranquila.‡Retournez voir le Capitaine Taylor au Reflux Tranquille.‡去找静谧海滩的泰勒上尉。‡到寧靜港灣找泰勒隊長。',
  }
},
[25912] = {
  {
    'Bons velhos tempos...‡Что за времена…‡Gute alte Zeit‡예전엔 좋았지‡Hubo tiempo mejores‡Hubo tiempos mejores‡Des jours meilleurs‡那些美好的日子‡從前的好日子',
    nil,
    'Encontre o Caderno de Esboços da Anciã Sareth\'na.‡Найдите записную книжку предка Сарет\'ны.‡Findet das Zeichenbuch der Urahnin Sareth\'na.‡장로 사레스나의 사생첩을 찾아야 합니다.‡Encuentra el libro de bocetos de la ancestro Sareth\'na.‡Encuentra el libro de bocetos de la ancestro Sareth\'na.‡Retrouvez le Carnet de croquis de l’Ancienne Sareth’na.‡找到长者莎瑞丝娜的草稿本。‡找到長者莎瑞絲娜的素描本。',
  }
},
[25913] = {
  {
    'Botando-as para descansar‡Даровать им покой‡Die letzte Ruhe‡자매들에게 안식을‡Que en paz descansen‡Que en paz descansen‡Qu\'elles reposent en paix‡让她们安息‡讓他們安息',
    nil,
    'Recupere 8 Glaives das Sentinelas.‡Принесите 8 глеф часовых.‡Bergt 8 Schildwachengleven.‡파수꾼의 투척창 8개를 회수해야 합니다.‡Recupera 8 gujas de centinela.‡Recupera 8 gujas de centinela.‡Récupérez 8 Glaives de sentinelle.‡收集8把哨兵的阔刃刀。‡取得8個哨兵旋刃。',
  }
},
[25914] = {
  {
    'De volta às profundezas!‡Назад, в глубины!‡Zurück in die Tiefe!‡다시 심연으로!‡¡Regreso a las profundidades!‡¡Regreso a las profundidades!‡Rendre aux profondeurs ce qui leur appartient‡回到地底去！‡返回地底!',
    nil,
    'Mate o Emissário Aph\'lass e 10 Tentáculos Invasores.‡Убейте предвестника Аф\'ласса и 10 щупалец-захватчиков.‡Tötet Aph\'lass und 10 einfallende Tentakel.‡선구자 아프라스를 처치하고 들이닥친 촉수 10개를 없애야 합니다.‡Mata a la presagista Aph\'lass y a 10 tentáculos invasores.‡Mata a la presagista Aph\'lass y a 10 tentáculos invasores.‡Tuez le Messager Aph’lass et 10 Tentacules envahissants.‡消灭预言者阿菲拉斯和10条入侵的触须。‡殺死先驅者阿菲拉斯和10個入侵的藤鬚。',
  }
},
[25915] = {
  {
    'A força de Tortolla‡Сила Тортоллы‡Tortollas Stärke‡토르톨라의 힘‡La fuerza de Tortolla‡La fuerza de Tortolla‡La force de Tortolla‡托尔托拉的力量‡托爾托拉的力量',
    nil,
    'Acompanhe um Filho de Tortolla até um Cristal de Nêmesis. Volte a falar com Garunda Picomonte se você se desencontrar do Filho de Tortolla.‡Проводите дитя Тортоллы к кристаллу Немесиса. Если вы потеряете своего спутника, вернитесь к Гарунду Горному Пику.‡Begleitet einen Abkömmling von Tortolla zu einem Nemesiskristall. Falls Ihr Euren Begleiter verliert, meldet Euch bei Garunda Bergkuppe.‡토르톨라의 자식을 네메시스 수정으로 데려가야 합니다. 거북이를 잃으면 가룬다 마운틴피크에게 가십시오.‡Escolta a un hijo de Tortolla hasta un cristal de Némesis. Si pierdes a tu compañero, ve a ver a Garunda Picomontaña.‡Escolta a un hijo de Tortolla hasta un cristal de Némesis. Si pierdes a tu compañero, ve a ver a Garunda Picomontaña.‡Escortez un Enfant de Tortolla jusqu’à un Cristal de Némésis. Retournez voir Garunda si vous perdez votre protégé.‡护送托尔托拉之子去找涅墨西斯水晶。若是失去了同伴就去找加仑达·山峰。‡護送托爾托拉之子找到復仇水晶。如果你和同伴失散，回去找加讓達‧山巔。',
  }
},
[25916] = {
  {
    'Abrindo caminho‡Прорыв‡Durchbruch‡돌파구‡Abriéndose paso‡Abriéndose paso‡Avancée décisive‡冲破障碍‡突破',
    nil,
    'Observe enquanto o Reparador da Terra Duarn tenta falar com Nespirah.‡Проследите за тем, как Целитель Земли Дуарн попытается заговорить с Неспирой.‡Beobachtet Erdheiler Duarn, während er versucht, mit Nespirah zu sprechen.‡대지치유사 두아른이 네스피라와 대화를 시도하는 모습을 지켜봐야 합니다.‡Observa cómo el ensalmador de la tierra Duarn trata de hablar con Nespirah.‡Observa cómo el ensalmador de la tierra Duarn trata de hablar con Nespirah.‡Observez le Soigneterre Duarn essayer de parler à Nespirah.‡在大地治愈者达鲁尝试与奈瑟匹拉交谈时，在一旁观察。‡觀看大地治癒者杜亞恩跟奈斯畢拉交談。',
  }
},
[25917] = {
  {
    'Não estamos sozinhos‡Мы не одиноки‡Wir sind nicht allein‡혼자가 아니야‡No estamos solos‡No estamos solos‡Nous ne sommes pas seuls‡我们并不孤单‡我們並不孤單',
    nil,
    'Encontre os sobreviventes da Aliança dentro de Nespirah, que fica em Vash\'jir.‡Отыщите в Неспире, что в Вайш\'ире, выживших Альянса.‡Findet die Überlebenden der Allianz in Nespirah in Vashj\'ir.‡바쉬르의 네스피라 안에서 얼라이언스 생존자를 찾아야 합니다.‡Encuentra a los supervivientes de la Alianza en el interior de Nespirah, en Vashj\'ir.‡Encuentra a los supervivientes de la Alianza en el interior de Nespirah, en Vashj\'ir.‡Trouvez les survivants de l’Alliance dans Nespirah, en Vashj’ir.‡在瓦丝琪尔的奈瑟匹拉内部找到联盟的幸存者。‡到瓦許伊爾的奈斯畢拉找出聯盟生還者。',
  }
},
[25918] = {
  {
    'Totalmente desequipado‡Безоружные‡Hoffnungslos ausrüstungslos‡비무장의 절망‡Muy mal equipados‡Muy mal equipados‡Des armes pour les braves‡手无寸铁‡無望的裝備短缺',
    nil,
    'Obtenha 4 Armas de Haste Furtadas dos cavaletes de armas dentro de Nespirah.‡Принесите 4 похищенных трезубца с оружейных стоек в Неспире.‡Besorgt 4 entwendete Stangenwaffen aus den Waffenregalen in Nespirah.‡네스피라에 있는 무기 선반에서 훔쳐낸 장창 4개를 손에 넣어야 합니다.‡Obtén 4 armas de asta hurtadas de los expositores de armas del interior de Nespirah.‡Obtén 4 armas de asta hurtadas de los expositores de armas del interior de Nespirah.‡Prenez 4 Armes d’hast dérobées sur les râteliers d’armes dans Nespirah.‡从奈瑟匹拉里面的武器架上收集4支被盗的长矛。‡從奈斯畢拉裡的武器架取得4隻偷來的長柄武器。',
  }
},
[25919] = {
  {
    'Golpes corporais‡Удар по телу‡Voller Körpereinsatz‡몸통 공격‡Golpes en el cuerpo‡Golpes en el cuerpo‡Des coups au corps‡刺痛躯体‡擊打軀體',
    nil,
    'Ataque 7 Abscessos de Nespirah ao longo das paredes da câmara respiratória de Nespirah.‡Ударьте Неспиру в 7 гнойников, расположенных на стенах ее полости.‡Greift 7 Abszesse von Nespirah an den Wänden von Nespirahs Körperkammer an.‡네스피라 몸 속 방의 벽을 따라 나 있는 네스피라 농양 7개를 공격해야 합니다.‡Ataca a 7 abscesos de Nespirah a lo largo de las paredes de la cámara corporal de Nespirah.‡Ataca a 7 abscesos de Nespirah a lo largo de las paredes de la cámara corporal de Nespirah.‡Attaquez 7 Abcès de Nespirah sur les murs de la chambre principale du corps de Nespirah.‡在奈瑟匹拉的体腔内的墙上攻击7处奈瑟匹拉脓肿。‡到奈斯畢拉的軀體腔室中，攻擊牆上的7個奈斯畢拉囊腫。',
  }
},
[25920] = {
  {
    'Não deixam de ser valiosas‡Ценные вещи‡Immer noch wertvoll‡여전히 소중한‡No menos valiosas‡No menos valiosas‡Le pot aux perles‡仍有价值‡仍然價值連城',
    nil,
    'Obtenha 5 Pérolas Misteriosas de Senhores da Guerra e Profetas Idra\'kess dentro de Nespirah.‡Добудьте у полководцев и пророков Идра\'кесса в Неспире 5 таинственных жемчужин.‡Besorgt 5 mysteriöse Perlen von Kriegsherren des Idra\'kess und Prophetinnen des Idra\'kess in Nespirah.‡네스피라에 있는 이드라케스 사령관과 이드라케스 예언자에게서 신비한 진주 5개를 얻어야 합니다.‡Obtén 5 perlas misteriosas de señores de la guerra Idra\'kess y profetas Idra\'kess en el interior de Nespirah.‡Obtén 5 perlas misteriosas de señores de la guerra Idra\'kess y profetas Idra\'kess en el interior de Nespirah.‡Récupérez 5 Perles mystérieuses sur le cadavre de Seigneurs de guerre ou de Prophètes d’Idra’kess dans Nespirah.‡从奈瑟匹拉里面的埃卓凯丝督军和埃卓凯丝先知手中夺取5颗神秘的珍珠。‡到奈斯畢拉裡，從艾德拉奇斯督軍和艾德拉奇斯預言者身上取得5顆神秘的珍珠。',
  }
},
[25921] = {
  {
    'Feitor Idra\'kess‡Надзиратель Идра\'кесс‡Aufseher Idra\'kess‡감독관 이드라케스‡Sobrestante Idra\'kess‡Sobrestante Idra\'kess‡Le surveillant Idra’kess‡监督者埃卓凯丝‡監督者艾德拉奇斯',
    nil,
    'Vá para o topo de Nespirah e mate o Feitor Idra\'kess.‡Отправляйтесь в верхнюю полость Неспиры и убейте надзирателя Идра\'кесса.‡Geht zur Spitze Nespirahs und tötet Aufseher Idra\'kess.‡네스피라 꼭대기로 올라가 감독관 이드라케스를 처치해야 합니다.‡Dirígete a la parte superior de Nespirah y mata al sobrestante Idra\'kess.‡Dirígete a la parte superior de Nespirah y mata al sobrestante Idra\'kess.‡Grimpez au sommet de Nespirah et tuez le Surveillant Idra’kess.‡前往奈瑟匹拉的顶部，杀死监督者埃卓凯丝。‡前往奈斯畢拉頂端並殺死監督者艾德拉奇斯。',
  }
},
[25922] = {
  {
    'Despertando a fera‡Пробуждение‡Die Erweckung der Bestie‡네스피라 깨우기‡Despierta a la bestia‡Despierta a la bestia‡Éveiller la Bête‡唤醒巨兽‡喚醒野獸',
    nil,
    'Fale com o Reparador da Terra Duarn dentro de Nespirah, para ativar as defesas biológicas dela. Em seguida, escape do corpo de Nespirah.‡Поговорите с Целителем Земли Дуарном в Неспире, чтобы запустить защитные процессы. Затем покиньте тело Неспиры.‡Sprecht mit Erdheiler Duarn in Nespirah, um ihre biologische Verteidigung zu aktivieren und flieht dann aus Nespirahs Körper.‡네스피라 안에 있는 대지치유사 두아른과 대화하여 생체 방어 계통을 활성화시킨 다음 탈출해야 합니다.‡Habla con el Ensalmador de la tierra Duarn en el interior de Nespirah para activar sus defensas biológicas. Después, huye del cuerpo de Nespirah.‡Habla con el Ensalmador de la tierra Duarn en el interior de Nespirah para activar sus defensas biológicas. Después, huye del cuerpo de Nespirah.‡Parlez au Soigneterre Duarn dans Nespirah, afin que celle-ci active ses défenses immunitaires, puis échappez-vous de son organisme.‡与奈瑟匹拉里面的大地治愈者达鲁交谈，激活奈瑟匹拉的生物防御机制，然后逃离奈瑟匹拉的身体。‡到奈斯畢拉裡去跟大地治癒者杜亞恩交談，以活化她的生理防禦機能，然後逃出奈斯畢拉的身體。',
  }
},
[25923] = {
  {
    'O fim de Nêmesis‡Покончить с Немесисом‡Vernichtet Nemesis‡네메시스 처단‡Acaba con Némesis‡Acaba con Némesis‡Achevez Némésis‡消灭涅墨西斯‡終結涅密希斯',
    nil,
    'Use o Totem de Tortolla e a ajuda de um Filho de Tortolla para derrotar Nêmesis. Volte a falar com Garunda Picomonte se você se desencontrar do Filho de Tortolla.‡Используйте тотем Тортоллы и победите Немесиса вместе со своим спутником. Если вы потеряете дитя Тортоллы, вернитесь к Гарунду Горному Пику.‡Benutzt das Totem von Tortolla, um einem Abkömmling von Tortolla dabei zu helfen, Nemesis zu besiegen. Falls Ihr Euren Schildkrötenfreund verliert, sprecht mit Garunda Bergkuppe.‡토르톨라의 토템을 사용하고 토르톨라의 자식의 도움을 받아 네메시스를 처치해야 합니다. 거북이를 잃으면 가룬다 마운틴피크에게 가십시오.‡Usa el tótem de Tortolla y la ayuda de uno de los hijos de Tortolla para derrotar a Némesis. Ve a ver a Garunda Picomontaña si pierdes a tu compañero tortuga.‡Usa el tótem de Tortolla y la ayuda de uno de los hijos de Tortolla para derrotar a Némesis. Ve a ver a Garunda Picomontaña si pierdes a tu compañero tortuga.‡Utilisez le Totem de Tortolla et l’aide d’un de ses enfants pour vaincre Némésis. Retournez voir Garunda si vous perdez votre compagnon tortue.‡使用托尔托拉图腾，在托尔托拉之子的帮助下打败涅墨西斯。若是失去了乌龟同伴就去找加仑达·山峰。‡使用托爾托拉圖騰和托爾托拉之子的幫助，擊敗涅密希斯。如果和你的烏龜同伴失散了，回去找加讓達‧山巔。',
  }
},
[25924] = {
  {
    'O chamado do dever‡Зов долга‡Die Pflicht ruft‡연합의 부름‡La llamada del deber‡La llamada del deber‡L’appel du devoir‡使命召唤‡決勝時刻',
    nil,
    'Embarque na nau mercenária para ir ao local da batalha.‡Отправляйтесь в бой на корабле наемников.‡Fahrt mit dem Söldnerboot zur Schlacht.‡전장으로 향하는 용병선에 타야 합니다.‡Viaja en el barco mercenario a la batalla.‡Viaja en el barco mercenario a la batalla.‡Empruntez le navire mercenaire pour rejoindre le champ de bataille.‡乘坐雇佣船只参加战斗。‡乘坐傭兵船加入戰鬥。',
  }
},
[25925] = {
  {
    'A vingança de Thal\'darah‡Месть Тал\'дара‡Thal\'darahs Rache‡탈다라의 복수‡La venganza de Thal\'darah‡La venganza de Thal\'darah‡La revanche de Thal\'darah‡萨达拉的复仇‡薩歐達拉的復仇',
    nil,
    'Mate 20 soldados da Horda e destrua 3 Demolidores de Krom\'gar no Vale Chaga de Guerra.‡Убейте 20 солдат Орды и уничтожьте 3 кром\'гарских разрушителя в долине Боевого Шрама.‡Tötet 20 Soldaten der Horde und zerstört 3 Verwüster von Krom\'gar im Kriegsnarbental.‡전투의 흉터 계곡에서 호드 병사 20명을 처치하고 크롬가르 파괴전차 3대를 파괴해야 합니다.‡Mata a 20 soldados de la Horda y destruye 3 demoledores Krom\'gar en el Valle Marca de Guerra.‡Mata a 20 soldados de la Horda y destruye 3 demoledores Krom\'gar en el Valle Marca de Guerra.‡Tuez 20 soldats de la Horde et détruisez 3 Démolisseurs de Krom’gar dans la Balafre.‡在战痕谷杀死20名部落战士，摧毁3台克罗姆加攻城车。‡到戰痕山谷殺死20個部落士兵並摧毀3部克羅姆加石毀車。',
  }
},
[25926] = {
  {
    'Repleto de ódio‡Погрязшие в трясине ненависти‡Modernder Hass‡증오로 가득 찬 늪‡Enlodados en odio‡Enlodados en odio‡Le marécage de la haine‡深陷仇恨‡仇恨的泥淖',
    nil,
    'Mate 10 Monstros do Pântano Putrescentes.‡Убейте 10 тлеющих трясинников.‡Tötet 10 modernde Morastbestien.‡썩어가는 수렁괴물 10마리를 처치해야 합니다.‡Mata a 10 bestias de lodo incandescentes.‡Mata a 10 bestias de lodo incandescentes.‡Tuez 10 Boueux nécrosants.‡杀掉10头腐败的沼泽兽。‡殺死10個腐爛的沼獸。',
  }
},
[25927] = {
  {
    'A ameaça das chamas‡Устрашающее пламя‡Brennende Bedrohung‡불길의 위협‡La amenaza de la llama‡La amenaza de la llama‡Risque d\'incendie‡火焰的威胁‡火焰的威脅',
    nil,
    'Mate 8 Elementais do Fogo Exaltados.‡Убейте 8 буйных элементалей огня.‡Tötet 8 zügellose Feuerelementare.‡드센 불의 정령 8마리를 처치해야 합니다.‡Mata a 8 elementales de fuego desenfrenado.‡Mata a 8 elementales de fuego desenfrenado.‡Tuez 8 Élémentaires de feu déchaînés.‡摧毁8只狂暴火元素。‡殺死8個猛烈火元素。',
  }
},
[25928] = {
  {
    'O triunfo de Tortolla‡Триумф Тортоллы‡Tortollas Triumph‡토르톨라의 승리‡El triunfo de Tortolla‡El triunfo de Tortolla‡Le triomphe de Tortolla‡托尔托拉的胜利‡托爾托拉的勝利',
    nil,
    'Atravesse o portal de chamas e fale novamente com Tortolla na Terra Queimada, em Hyjal.‡Пройдите сквозь огненные врата и вернитесь к Тортолле на Выжженную равнину на Хиджале.‡Geht erneut durch das Flammentor und kehrt zu Tortolla auf der Verbrannten Ebene auf dem Hyjal zurück.‡화염관문으로 나간 다음, 하이잘의 불타버린 평원에 있는 토르톨라에게 가야 합니다.‡Vuelve a atravesar la puerta de llamas y regresa con Tortolla en La Llanura Agostada en Hyjal.‡Vuelve a atravesar la puerta de llamas y regresa con Tortolla en La Llanura Agostada en Hyjal.‡Retraversez le portail de flammes et retournez voir Tortolla dans la Plaine Incendiée, au Mont Hyjal.‡用火焰之门回到海加尔山焦痕平原的托尔托拉那里。‡退出烈焰之門，回去海加爾的烈焰平原找托爾托拉。',
  }
},
[25929] = {
  {
    'Calças do mar‡Морской волк‡Seetauglich‡바다 걸음‡Piernas marinas‡Piernas marinas‡Pied marin‡告别晕船‡熟悉水性',
    nil,
    'Colete 3 Estrelas-do-mar de Água Salgada e uma Concha do fundo do mar no Destino da Legião.‡Добудьте с морского дна в Судьбе Легиона 3 солоноводных морских звезды и раковину стромбиды.‡Sammelt 3 Salzwasserseesterne und ein Tritonshorn am Meeresgrund im Verhängnis der Legion.‡군단의 운명 해저에서 바닷물 불가사리 3마리와 소라 껍데기를 모아야 합니다.‡Consigue 3 estrellas marinas y una caracola del lecho marino en el Destino de la Legión.‡Consigue 3 estrellas marinas y una caracola del lecho marino en el Destino de la Legión.‡Récoltez 3 Étoiles de mer et une Coquille de conque sur le fond de la mer, au Destin de la Légion.‡收集3条咸水海星，并从军团之劫带回1个海螺壳。‡到軍團的命運的海床收集3個鹹水海星與1個海螺殼。',
  }
},
[25930] = {
  {
    'Subindo o vale‡Подъем в долину‡Talstürmer‡불타는 계곡‡La ascensión de la vega‡La ascensión de la vega‡L\'ascension du val‡飞上山谷‡攀上山谷',
    nil,
    'Use a Mochila-foguete de Salsbury para subir o vulcão do Vale Carbonizado.‡Используйте ракетный агрегат Сэлсбери для подъема на вулкан Обугленной долины.‡Erklimmt mit Salsburys Raketenpack den Vulkan im Verbrannten Tal.‡살스베리의 로켓 장치를 이용하여 잿더미 계곡에 있는 화산 꼭대기로 올라가야 합니다.‡Utiliza el paquete propulsor de Salsbury para ascender por el volcán de La Vega Carbonizada.‡Utiliza el paquete propulsor de Salsbury para ascender por el volcán de La Vega Carbonizada.‡Utilisez les Fusées d’appoint de Salsbury pour gravir le volcan du Val Calciné.‡使用沙尔斯巴里的火箭包飞到焦炭谷的火山上。‡使用沙爾斯伯利的火箭包攀上焦炭谷的火山。',
  }
},
[25931] = {
  {
    'Prole de Seldarria‡Потомство Селдаррии‡Die Brut von Seldarria‡셀다리아의 혈족‡La prole de Seldarria‡La prole de Seldarria‡La couvée de Seldarria‡瑟达利亚的子嗣‡賽達里亞的子嗣',
    nil,
    'Destrua 5 dos Ovos de Seldarria‡Уничтожьте 5 яиц Селдаррии.‡Zerstört 5 Eier von Seldarria.‡셀다리아의 알 5개를 파괴해야 합니다.‡Destruye 5 huevos de Seldarria.‡Destruye 5 huevos de Seldarria.‡Détruisez 5 Œufs de Seldarria.‡破坏5枚瑟达利亚的卵。‡摧毀5顆賽達里亞的蛋。',
  }
},
[25932] = {
  {
    'Não há nada que os impeça quando a noite cai‡Набеги ночь за ночью‡Jede Nacht ein Überfall‡계속되는 공격‡Asalto nocturno‡Asalto nocturno‡La nuit, tous les trolls sont gris‡每天晚上都来袭‡夜夜夜襲',
    nil,
    'Ajude o Sargento Pedertelo e seus montanhistas a defender o Rancho Ambarmanso dos Saqueadores Jubafria.‡Помогите сержанту Кремнемолоту и его горным пехотинцам защитить ферму Янтарленов от налетчиков из клана Мерзлогривов.‡Helft Unteroffizier Flinthammer und seinen Gebirgsjägern, das Gehöft Bernruh gegen die Frostmähnenräuber zu verteidigen.‡앰버스틸 목장에서 하사관 플린트해머와 그의 산악경비대원들을 도와 서리갈기 약탈자의 공격을 방어해야 합니다.‡Ayuda al sargento Martílex y a sus montaraces a defender la Granja de Semperámbar de los asaltantes Peloescarcha.‡Ayuda al sargento Martílex y a sus montaraces a defender la Granja de Semperámbar de los asaltantes Peloescarcha.‡Aidez le Sergent Martel-silex et ses montagnards à défendre la Ferme des Distillambre contre les Écumeurs crins-de-givre.‡帮助火锤中士和他的巡山人防御冻石农场，抵挡住霜鬃袭击者的进攻。‡幫助火錘中士和他的巡山人保衛凍石農場，抵抗霜鬃劫掠者。',
  }
},
[25933] = {
  {
    'Ajuda na pedreira‡Помощь карьеру‡Hilfe für den Steinbruch‡채석장에 생긴 일‡Ayuda en la cantera‡Ayuda en la cantera‡Au secours des carriers‡支援采石场‡礦場救援',
    nil,
    'Fale com o Encarregado Pedracenho na Pedreira Gol\'Bolar.‡Поговорите со штейгером Камнелобом в карьере Гол\'Болар.‡Sprecht mit Großknecht Steinbraue im Steinbruch Gol\'Bolar.‡골볼라 채석장에 있는 현장감독 스톤브라우와 대화해야 합니다.‡Habla con el supervisor Petrocejas en la Cantera de Gol\'Bolar.‡Habla con el supervisor Petrocejas en la Cantera de Gol\'Bolar.‡Parlez au Contremaître Front-de-pierre à la Carrière de Gol’Bolar.‡跟古博拉采掘场的工头乔尼·石眉谈一谈。‡到古博拉採掘場找工頭喬尼·石眉談話。',
  }
},
[25934] = {
  {
    'O primeiro gnomogen do mundo‡Первый в мире гнорген‡Weltneuheit: Gnomgen‡세계 최초의 늑대노움‡El primer gnomohuargen del mundo‡El primer gnomohuargen del mundo‡Le premier worgnome au monde‡世界首位：狼侏儒‡世界第一:地精狼人',
    nil,
    'Consiga 1 Coração de Fogo Fulgurante‡Добудьте 1 пылающее сердце огня.‡Beschafft 1 flammendes Herz des Feuers.‡타오르는 불의 심장을 구해야 합니다.‡Consigue un corazón de fuego llameante.‡Consigue un corazón de fuego llameante.‡Obtenez un Cœur de feu flamboyant.‡收集1颗燃焰之心。‡收集1個火焰熾亮之心。',
  }
},
[25935] = {
  {
    'Filhotes famintos‡Голодные щенки‡Hungrige Welpen‡배고픈 강아지‡Cachorros hambrientos‡Cachorros hambrientos‡Les chiots affamés‡饥饿的小狗‡饑餓的小狗',
    nil,
    'Consiga 6 Filés de Filhote de Dragonete Negro.‡Добудьте 6 филе черного дракончика.‡Beschafft 6 Schwarzdrachenwelpenfilets.‡새끼 검은용 살코기 6덩이를 구해야 합니다.‡Consigue 6 filetes de cría de dragón Negro.‡Consigue 6 filetes de cría de dragón Negro.‡Récoltez 6 Filets de dragonnet noir.‡收集6块黑龙幼兽肉片。‡收集6塊小黑龍里脊肉。',
  }
},
[25936] = {
  {
    'Corrente do bem‡Время вернуть должок‡Wie ich Euch, so Ihr ihnen‡이제 일을 해야지‡Cadena de favores‡Cadena de favores‡Payez au suivant‡回馈恩情‡把泡傳出去',
    nil,
    'Use a Concha Encantada para resgatar 6 Guerreiros em Afogamento.‡Воспользуйтесь зачарованной раковиной для спасения 6 тонущих воинов.‡Benutzt das verzauberte Tritonshorn, um 6 ertrinkende Soldaten zu retten.‡마력 깃든 소라를 써서 물에 빠진 전사 6명을 구출해야 합니다.‡Utiliza la caracola encantada para rescatar a 6 guerreros sumidos.‡Utiliza la caracola encantada para rescatar a 6 guerreros sumidos.‡Utilisez la Conque enchantée pour secourir 6 Guerriers qui se noient.‡使用附魔海螺壳营救6名溺水的战士。‡使用附魔海螺拯救6個溺水的戰士。',
  }
},
[25937] = {
  {
    'Tesouros inestimáveis‡Бесценные сокровища‡Unermessliche Reichtümer‡값을 매길 수 없는 보물‡Tesoros de valor incalculable‡Tesoros de valor incalculable‡Trésors inestimables‡无价之宝‡無價的寶藏',
    nil,
    'Recupere 8 Artefatos Congelados do fundo da Pedreira Gol\'Bolar.‡Достаньте из карьера Гол\'Болар 8 замерзших артефактов.‡Bergt 8 gefrorene Artefakte aus der Mine des Steinbruchs Gol\'Bolar.‡골볼라 채석장에서 얼어붙은 유물 8개를 회수해야 합니다.‡Recupera 8 artefactos congelados de la mina de la Cantera de Gol\'Bolar.‡Recupera 8 artefactos congelados de la mina de la Cantera de Gol\'Bolar.‡Mettez à jour 8 Artéfacts glacés dans la Mine de la carrière de Bol’Golar.‡从古博拉采掘场矿洞里获得8个冰封的圣物。‡從古博拉礦場的裡面取回8個冰凍的神器。',
  }
},
[25938] = {
  {
    'Ajuda para Desolação‡Помощь Пустошам‡Hilfe für Desolace‡잊혀진 땅 지원‡Ayuda para Desolace‡Ayuda para Desolace‡Désolace a besoin de vous !‡凄凉之地求救‡幫助淒涼之地',
    nil,
    'Apresente-se à Oficial Matilde em Tethris Aran, que fica em Desolação.‡Доложитесь офицеру Дженки, которая находится в Тефрис-Аране в Пустошах.‡Meldet Euch bei Offizierin Jankie in Tethris Aran in Desolace.‡잊혀진 땅의 테드리스 아란에 있는 장교 쟁키에게 보고해야 합니다.‡Preséntate ante la oficial Jankie en Tethris Aran en Desolace.‡Preséntate ante la oficial Jankie en Tethris Aran en Desolace.‡Présentez-vous à l’officier Jankie, à Tethris Aran, en Désolace.‡去找凄凉之地塔迪萨兰的军官金妮。‡到淒涼之地的塔迪薩蘭向軍官薔琪回報。',
  }
},
[25939] = {
  {
    'Pelo bem das turfas‡Спасение торфяников‡Feuerteufel‡늪지대를 위해‡¡Cieno santo!‡¡Cieno santo!‡S.O.S. tourbières‡看在泥炭的份上‡為了泥炭',
    nil,
    'Use o Inundalírio Abençoado para extinguir 7 Focos de Incêndio no Pântano.‡С помощью благословенной водяной лилии потушите 7 блуждающих огоньков.‡Löscht 7 Moorfeuer mit der gesegneten Flutlilie.‡축복받은 홍수백합을 이용해 늪지대 불 7개를 꺼야 합니다.‡Utiliza el lirio de inundación bendito para extinguir 7 fuegos de pantano.‡Utiliza el lirio de inundación bendito para extinguir 7 fuegos de pantano.‡Utilisez le Lys des crues béni pour éteindre 7 Feux de marais.‡用受祝福的深水百合扑灭7处沼泽大火。‡使用受過祝福的水湧百合熄滅7團沼澤火焰。',
  }
},
[25940] = {
  {
    'Resistência no Bosque Silvante‡Помощь в Роще Трелей‡Letztes Gefecht am Rauschenden Hain‡휘파람 숲의 마지막 수호자‡La última resistencia en la Arboleda Sibilante‡La última resistencia en la Arboleda Sibilante‡Dernier carré au bosquet Sifflant‡呼啸林地背水一战‡哨嘯樹林的最終防線',
    nil,
    'Apresente-se ao Guardião Taldros no Bosque Silvante, que fica no Monte Hyjal.‡Найдите хранителя Талдроса в Роще Трелей.‡Meldet Euch bei Bewahrer Taldros im Rauschenden Hain auf dem Hyjal.‡하이잘 산의 휘파람 숲에 있는 관리인 탈드로스에게 보고해야 합니다.‡Preséntate ante el vigilante Taldros en la Arboleda Sibilante en Monte Hyjal.‡Preséntate ante el vigilante Taldros en la Arboleda Sibilante en Monte Hyjal.‡Rendez-vous auprès du Gardien Taldros dans le Bosquet Sifflant, au Mont Hyjal.‡去找海加尔山呼啸林地的丛林守护者塔尔德罗斯。‡在海加爾山的哨嘯樹林向看守者塔爾德羅斯報告。',
  }
},
[25941] = {
  {
    'Descanso para os exaustos‡Отдохновение для утомленных‡Rast für die Erschöpften‡지친 자에게 휴식을‡Descanso para los derrengados‡Descanso para los derrengados‡Le repos des guerriers‡我需要休息‡喘息時間',
    nil,
    'Fale com o Legionário Nazgrim.‡Поговорите с легионером Назгримом.‡Sprecht mit Legionär Nazgrim.‡부관 나즈그림과 대화해야 합니다.‡Habla con el legionario Nazgrim.‡Habla con el legionario Nazgrim.‡Parlez au Légionnaire Nazgrim.‡跟军团士兵纳兹戈林谈一谈。‡和軍團士兵納茲格寧姆說話。',
  }
},
[25942] = {
  {
    'Ganhando algum tempo‡Выиграть время‡Verschafft uns Zeit‡시간을 좀‡Consíguenos algo de tiempo‡Consíguenos algo de tiempo‡Donnez-nous un peu de temps‡争取时间‡爭取一點時間',
    nil,
    'Mate 8 Saqueadores Zin\'jatar no Destino da Legião.‡Убейте 8 налетчиков Зин\'жатара в Судьбе Легиона.‡Tötet 8 Räuber des Zin\'jatar im Verhängnis der Legion.‡군단의 운명에서 진자타르 약탈자 8마리를 처치해야 합니다.‡Mata a 8 asaltantes Zin\'jatar en el Destino de la Legión.‡Mata a 8 asaltantes Zin\'jatar en el Destino de la Legión.‡Tuez 8 Écumeurs zin’jatar au Destin de la Légion.‡在军团之劫杀死8名金加塔尔袭击者。‡在軍團的命運殺死8個金加塔劫掠者。',
  }
},
[25943] = {
  {
    'Saco vazio não fica em pé‡Голод не тетка‡Siege gehen durch den Magen‡위장과의 싸움‡Marchar con el estómago lleno‡Marchar con el estómago lleno‡Le ventre vide‡吃饱了好上路‡以胃袋行軍',
    nil,
    'Colete 8 pedaços de Carne Suculenta de Caranguejo de Pateantes Garrabífidas.‡Добудьте 8 кусков сочного мяса крабов c быстролапов с надтреснутой клешней.‡Sammelt 8 Stück saftiges Krebsfleisch von Spaltscherenhuschern.‡갈래발 번개집게에게서 육즙이 많은 게살 8개를 모아야 합니다.‡Reúne 8 carnes suculentas de cangrejo de arácnidos Doblegarra.‡Reúne 8 carnes suculentas de cangrejo de arácnidos Doblegarra.‡Récoltez 8 morceaux de Chair de crabe succulente sur des Glisseurs pince-fendue.‡从裂钳诱捕蟹那里收集6块多汁的蟹肉。‡從惡爪誘捕者那裡收集8個多汁蟹肉。',
  }
},
[25944] = {
  {
    'Preparando o nosso lombo‡Во всеоружии‡Der Horde alte Kleider‡각오 다지기‡En cueros‡En cueros‡Fourbir nos armes‡勒紧裤腰带‡備好我們的傢伙',
    nil,
    'Colete 5 Machados de Orgrimmar, 5 Peitorais de Orgrimmar e 5 Elmos de Orgrimmar do fundo do mar e de Ladravazes Guelblin no Destino da Legião.‡Соберите на морском дне и у жаблинов-расхитителей в Судьбе Легиона 5 топоров, 5 кирас и 5 шлемов Оргриммара.‡Sammelt 5 Äxte von Orgrimmar, 5 Brustplatten von Orgrimmar und 5 Helme von Orgrimmar am Meeresboden oder von Strauchdieben der Gilblin im Verhängnis der Legion.‡군단의 운명에 있는 길블린 강도 또는 바다 밑바닥에서 오그리마 도끼 5자루, 오그리마 가슴보호갑 5벌, 오그리마 투구 5개를 모아야 합니다.‡Recoge 5 hachas de Orgrimmar, 5 corazas de Orgrimmar y 5 yelmos de Orgrimmar del lecho marino y de los desvalijadores Gilblin en el Destino de la Legión.‡Recoge 5 hachas de Orgrimmar, 5 corazas de Orgrimmar y 5 yelmos de Orgrimmar del lecho marino y de los desvalijadores Gilblin en el Destino de la Legión.‡Récupérez 5 Haches, 5 Cuirasses et 5 Casques d’Orgrimmar au fond de la mer, ou sur des Écumeurs gloubelins au Destin de la Légion.‡收集5把奥格瑞玛战斧、5件奥格瑞玛胸铠以及5个奥格瑞玛头盔。你可以在军团之劫的海床以及海地精抢劫者身上找到这些装备。‡在軍團的命運從海床和吉爾布林拾荒者那裡收集5把奧格瑪之斧、 5副奧格瑪胸甲，和5頂奧格瑪頭盔。',
  }
},
[25945] = {
  {
    'Estamos aqui para fazer uma coisa, talvez duas...‡Мы все делаем одно дело. Или два…‡Wir haben hier nur eine Aufgabe, vielleicht auch zwei...‡임무 하나, 어쩌면 둘...‡Estamos aquí para una cosa, o dos...‡Estamos aquí para una cosa, o dos...‡On est juste là pour faire deux, trois petites choses…‡我们来是做一件，也许是两件事的……‡我們到這兒是為了一件事，也許兩件...',
    nil,
    'Embarque na Carroça de Krom\'gar rumo ao Nicho, que fica na Cordilheira das Torres de Pedra.‡Доставьте кром\'гарский фургон к Изгибу Когтистых гор.‡Reist mit dem Wagen von Krom\'gar zum Bruch im Steinkrallengebirge.‡크롬가르 수레를 타고 돌발톱 산맥에 있는 습곡으로 가야 합니다.‡Coge el vagón Krom\'gar hasta El Redil, en Sierra Espolón.‡Toma el vagón Krom\'gar hasta El Redil en Sierra Espolón.‡Prenez le Chariot de Krom’gar jusqu’au Repli des Serres-Rocheuses.‡乘克罗姆加马车前往石爪山脉的皱石岗。‡將克羅姆加貨車帶去石爪山脈的山間營地。',
  }
},
[25946] = {
  {
    'Os segredos do elmo‡Тайна шлема‡ScHELMenstück‡심오한 투구‡Casco de las profundidades‡Casco de las profundidades‡Casque de pointe‡神秘的头盔‡頭盔的深度',
    nil,
    'Leve o Equipamento F.O.C.A. da Aliança para o Legionário Nazgrim na Espiral Imortal.‡Отнесите оборудование СМЭШ с корабля Альянса легионеру Назгриму на Серпантин Бессмертного.‡Bringt die Kampfschwimmerausrüstung der Allianz zu Legionär Nazgrim in der "Ewiger Kreislauf".‡얼라이언스 특전대 장비를 불멸의 똬리호에 있는 부관 나즈그림에게 가져가야 합니다.‡Lleva el equipo G. O. E. V. de la Alianza al legionario Nazgrim en La Espiral Inmortal.‡Lleva el equipo G. O. E. V. de la Alianza al legionario Nazgrim en La Espiral Inmortal.‡Apportez l’Équipement de commando de l’Alliance au légionnaire Nazgrim, dans la Glène immortelle.‡将联盟海豹突击队员装备交给永不沉没号上的军团士兵纳兹戈林。‡將聯盟海豹部隊裝備帶去不朽之環號給軍團士兵納茲格寧姆。',
  }
},
[25947] = {
  {
    'Achado não é roubado‡Что упало, то пропало‡Wer es findet, darf es behalten‡찾는 자와 챙기는 자‡Quien lo encuentra, se lo queda‡Quien lo encuentra, se lo queda‡Qui trouve, garde !‡谁捡到就归谁‡先找到先贏',
    nil,
    'Colete 5 peças do Equipamento F.O.C.A. de Ventobravo.‡Найдите 5 предметов оборудования штормградского СМЭШ.‡Sammelt 5 Teile einer Kampfschwimmerausrüstung von Sturmwind.‡스톰윈드 특전대 장비 5개를 모아야 합니다.‡Reúne 5 unidades de equipo G.O.E.V. de Ventormenta.‡Reúne 5 unidades de equipo G.O.E.V. de Ventormenta.‡Retrouvez 5 pièces d’Équipement de commando de Hurlevent.‡收集5套暴风城海豹突击队员装备。‡收集5件暴風城海豹部隊裝備。',
  }
},
[25948] = {
  {
    'Podem vir com tudo!‡Вперед!‡Genug gewartet!‡덤벼라!‡¡Sin miedo!‡¡Sin miedo!‡Qu\'ils y viennent !‡宣战！‡促進發展!',
    nil,
    'Fale com o Legionário Nazgrim a bordo da Espiral Imortal.‡Поговорите с легионером Назгримом на Серпантине Бессмертного.‡Sprecht mit Legionär Nazgrim an Bord der "Ewiger Kreislauf".‡불멸의 똬리호에 있는 부관 나즈그림과 대화해야 합니다.‡Habla con el legionario Nazgrim a bordo de la Espiral Inmortal.‡Habla con el legionario Nazgrim a bordo de la Espiral Inmortal.‡Parlez au légionnaire Nazgrim à bord de la Glène immortelle.‡与永不沉没号上的军团士兵纳兹戈林交谈。‡到不朽之環號去和軍團士兵納茲格寧姆交談。',
  }
},
[25949] = {
  {
    'Sangue e trovão!‡Кровь и гром!‡Blut und Donner!‡피와 번개의 축복을!‡¡Sangre y truenos!‡¡Sangre y truenos!‡Sang et tonnerre !‡鲜血与雷霆！‡鮮血與雷霆!',
    nil,
    'Auxilie o Legionário Nazgrim na defesa da Espiral Imortal.‡Помогите легионеру Назгриму защитить Серпантин Бессмертного.‡Helft Legionär Nazgrim dabei, die "Ewiger Kreislauf" zu verteidigen.‡부관 나즈그림을 도와 불멸의 똬리호를 지켜내야 합니다.‡Ayuda al legionario Nazgrim en la defensa de la Espiral Inmortal.‡Ayuda al legionario Nazgrim en la defensa de la Espiral Inmortal.‡Battez-vous aux côtés du légionnaire Nazgrim pour défendre la Glène immortelle.‡协助军团士兵纳兹戈林保卫永不沉没号。‡幫助軍團士兵納茲格寧姆防禦不朽之環號。',
  }
},
[25950] = {
  {
    'Extermínio das Sira\'kess‡Истребление Сира\'кесс‡Tod den Sira\'kess‡시라케스 사냥‡Matanza de Sira\'kess‡Matanza de Sira\'kess‡Le massacre de Sira’kess‡进攻希拉柯丝‡席拉克斯大屠殺',
    nil,
    'Mate 10 Nagas Sira\'kess.‡Убейте 10 наг Сира\'кесс.‡Tötet 10 Naga der Sira\'kess.‡시라케스 나가 10마리를 처치해야 합니다.‡Mata a 10 nagas Sira\'kess.‡Mata a 10 nagas Sira\'kess.‡Tuez 10 Nagas de Sira’kess.‡杀死10只希拉柯丝纳迦。‡殺掉10個席拉克斯納迦。',
  }
},
[25951] = {
  {
    'O julgamento final‡Приговор‡Schlussurteil‡최후의 심판‡Juicio final‡Juicio final‡L’ultime épreuve‡最终审判‡最後制裁',
    nil,
    'Proteja a ponte do Terraço de Quel\'Durmar até que os aliados da Lady Sira\'kess apareçam.|n|nEssa missão faz parte da visão da Dama Guerreira Naz\'jar. Caso necessário, use a Lâmina da Dama Guerreira Naz\'jar em um foco temporal para voltar à visão.‡Удерживайте мост на террасе Кель\'Дормир, пока не прибудут союзники Леди Сира\'кесс.|n|nЭто задание из цикла "Видения воительницы Леди Наз\'жар". Чтобы вернуться к видению, в нужном месте воспользуйтесь клинком воительницы Леди Наз\'жар.‡Haltet die Brücke auf der Terrasse von Quel\'Dormir, bis Lady Sira\'kess\' Verbündete eintreffen.|n|nDiese Aufgabe ist Teil der Vision der Kriegsmaid der Naz\'jar. Wenn Ihr zur Vision zurückkehren müsst, benutzt die Klinge der Kriegsmaid der Naz\'jar an einem Zeitfokus.‡여군주 시라케스의 동맹이 도착할 때까지 쿠엘도르미르 단상을 지켜야 합니다.|n|n이 임무는 나즈자르 여전사 환영의 일부입니다. 필요하다면, 나즈자르 여전사의 외날창을 사용하여 과거의 환영으로 돌아가십시오.‡Mantén el puente en el Bancal de Quel\'Dormir hasta que lleguen los aliados de Lady Sira\'kess.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Mantén el puente en el Bancal de Quel\'Dormir hasta que lleguen los aliados de Lady Sira\'kess.|n|nEsta tarea forma parte de una visión de la doncella de batalla Naz\'jar. Si es necesario, usa la hoja de la doncella de batalla Naz\'jar como marco temporal para volver a la visión.‡Tenez le pont sur la terrasse de Quel’Dormir jusqu’à l’arrivée des alliés de Dame Sira’kess.|n|nCette mission fait partie d’une vision de la vierge combattante naz’jar. Si nécessaire, utilisez la Lame de la vierge combattante naz’jar près d’un focalisateur temporel pour retourner dans la vision.‡守住奎尔多米尔平台的大桥直到希拉柯丝女士的盟军到来。|n|n这个任务是纳兹夏尔女武士影像的一部分。如有需要，可以使用纳兹夏尔女武士之刃在时间焦点处返回影像。‡守住奎多米爾殿堂直到席拉克斯女士盟軍到達。|n|n這個任務是納茲賈爾戰鬥仕女幻象的一部分。如果有需要的話，使用納茲賈爾戰鬥仕女之刃來專心回到幻象之中。',
  }
},
[25952] = {
  {
    'Pego de surpresa‡Внезапный удар‡Überraschungsangriff‡경계 태세‡Con la guardia bajada‡Con la guardia bajada‡Sécurisation du périmètre‡毫无防备‡趁虛而入',
    nil,
    'Mate 10 Patrulheiros Azsh\'ir.‡Уничтожьте 10 патрульных Азш\'ира.‡Tötet 10 Patrouillen der Azsh\'ir.‡아즈쉬르 순찰병 10마리를 처치해야 합니다.‡Mata a 10 patrullas de Azsh\'ir.‡Mata a 10 patrullas de Azsh\'ir.‡Tuez 10 Patrouilleurs azsh’ir.‡杀死10名艾萨尔巡逻兵。‡消滅10個艾薩伊爾巡邏者。',
  }
},
[25953] = {
  {
    'Ataque preventivo‡Быстрый подход‡Schnelles Handeln‡신속한 접근‡Aproximación rápida‡Aproximación rápida‡Approche furtive‡蹑手蹑脚‡迅速接近',
    nil,
    'Destrua 8 Monitores Azsh\'ir.‡Уничтожьте 8 наблюдателей Азш\'ира.‡Zerstört 8 Überwacher der Azsh\'ir.‡아즈쉬르 감시기를 8대 파괴해야 합니다.‡Destruye 8 supervisores de Azsh\'ir.‡Destruye 8 supervisores de Azsh\'ir.‡Détruisez 8 Appareils de surveillance azsh’ir.‡摧毁8个艾萨尔监控器。‡摧毀8個艾薩伊爾監控裝置。',
  }
},
[25954] = {
  {
    'Investigação aquática‡Чтобы занять время‡Suche nach der Vergangenheit‡시간 작업‡Para matar el rato‡Para matar el rato‡Passe-temps innocent‡时光的记录‡佔據的時間',
    nil,
    'Investigue 4 estátuas intactas nos Jardins de Vashj\'ir.‡Осмотрите 4 неразрушенные статуи в садах Вайш\'ира.‡Untersucht die 4 unversehrten Statuen in den Gärten von Vashj\'ir.‡바쉬르 정원에 있는 온전한 석상을 4개 조사해야 합니다.‡Investiga las 4 estatuas intactas de los jardines de Vashj\'ir.‡Investiga las 4 estatuas intactas de los jardines de Vashj\'ir.‡Examinez les 4 Statues intactes dans les Jardins de Vashj’ir.‡调查瓦丝琪尔花园4处完好的雕像。‡在瓦許伊爾花園搜尋4個完好無缺的雕像。',
  }
},
[25955] = {
  {
    'Estabelecendo uma posição favorável‡Новая база‡Ein besserer Standort‡유리한 고지‡Ganar ventaja‡Ganar ventaja‡Une meilleure position‡奇袭点‡更優勢的地位',
    nil,
    'No nível mais baixo das ruínas, vasculhe: a extremidade norte dos Jardins de Quel\'Durmar, a passagem que leva para baixo das ruínas a oeste dos jardins, e as estruturas no canto sudeste das ruínas sob as pontes.‡Спуститесь на нижний уровень руин и исследуйте северную часть садов Кель\'Дормир, туннель, проходящий под руинами на западе от садов, и постройки в юго-восточном углу руин, под мостами.‡Späht den nördlichen Teil der Gärten von Quel\'Dormir, den Tunnel unter den Ruinen im Westen der Gärten und die Gebäude im Süden der Gärten aus. Bleibt auf der untersten Ebene der Ruinen.‡폐허의 가장 낮은 지역에서, 쿠엘도르미르 정원의 북쪽 끝, 정원 서쪽의 폐허 아래로 통하는 통로, 그리고 폐허의 남동쪽 구석 다리 밑에 있는 일련의 구조물들을 정찰해야 합니다.‡En el nivel inferior de las ruinas, explora el extremo norte de los Jardines de Quel\'Dormir, el pasaje que va por debajo de las ruinas al oeste de los jardines y las estructuras en la esquina sureste de las ruinas, debajo de los puentes.‡En el nivel inferior de las ruinas, explora el extremo norte de los Jardines de Quel\'Dormir, el pasaje que va por debajo de las ruinas al oeste de los jardines y las estructuras en la esquina sureste de las ruinas, debajo de los puentes.‡Au niveau le plus bas des ruines, explorez l’extrémité nord des Jardins de Quel’Dormir, le passage qui mène sous les ruines à l’ouest des jardins, et les structures du coin sud-est des ruines, sous les ponts.‡去废墟最下层，调查奎尔多米尔花园北边的尽头，在花园以西的废墟下面有条小路可以通往那里，还有废墟东南角落的建筑群，就在桥下。‡在廢墟的低層，偵查奎多米爾花園的北端、花園西邊通往遺跡底下的通道，以及廢墟東南邊橋底下的建築。',
  }
},
[25956] = {
  {
    'Na cena de batalha‡На поле брани‡Auf dem Schlachtfeld‡전투 현장에서‡En la escena de la batalla‡En la escena de la batalla‡Sur le théâtre d’opérations‡在战斗现场‡戰爭遺址',
    nil,
    'Leve o estilhaço partido de volta para o Repouso da Legião.‡Принесите обломок на базу Легиона.‡Bringt das Bruchstück zurück zur Ruhestatt der Legion.‡부러진 조각을 군단의 안식처로 가져가야 합니다.‡Lleva el fragmento roto de vuelta al Reposo de la Legión.‡Lleva el fragmento roto de vuelta al Reposo de la Legión.‡Rapportez le Fragment brisé au Repos de la Légion.‡将破损的碎片带回军团营地。‡將破損的碎片帶回軍團之眠。',
  }
},
[25957] = {
  {
    'Visões do passado: a invasão de Vashj\'ir‡Видения прошлого: вторжение в Вайш\'ир‡Visionen der Vergangenheit: Die Invasion von Vashj\'ir‡과거의 환영: 바쉬르 침략‡Visiones del pasado: La invasión de Vashj\'ir‡Visiones del pasado: La invasión de Vashj\'ir‡Visions du passé : l’invasion de Vashj’ir‡过去的影像：瓦丝琪尔的入侵‡過去的幻景:瓦許伊爾的入侵',
    nil,
    'Use a Lâmina da Dama Guerreira Naz\'jar no campo de batalha na extremidade sudeste das ruínas.‡Воспользуйтесь клинком воительницы Леди Наз\'жар на поле битвы возле юго-восточной окраины руин.‡Benutzt die Klinge der Kriegsmaid der Naz\'jar auf dem Schlachtfeld am südöstlichen Ende der Ruinen.‡폐허 남동쪽 끝에 있는 격전지로 가서 나즈자르 여전사의 외날창을 사용해야 합니다.‡Usa la hoja de la doncella de batalla Naz\'jar en el lugar de la batalla, en el extremo sureste de las ruinas.‡Usa la hoja de la doncella de batalla Naz\'jar en el lugar de la batalla, en el extremo sureste de las ruinas.‡Utilisez la Lame de la vierge combattante naz’jar sur le champ de bataille à l’extrémité sud-est des ruines.‡在花园东南部尽头的战斗现场使用纳兹夏尔女武士之刃。‡在廢墟東南端的戰爭遺址使用納茲賈爾戰鬥仕女之刃。',
  }
},
[25958] = {
  {
    'Prevenindo o pior‡Взгляд в будущее‡Ein Blick nach vorne‡부대장 찾아가기‡Mirando hacia delante‡Mirando hacia delante‡Le capitaine a de l’avancement‡向前看‡向前看',
    nil,
    'Encontre e fale com o Capitão Vilespinho ao norte das Ruínas de Vashj\'ir.|n|nUse o cavalo-marinho da Falaondas Tulra para chegar até o posto avançado rapidamente.‡Найдите капитана Злобешипа к северу от садов Кель\'Дормир и поговорите с ним.|n|nВоспользуйтесь морским коньком говорящей с волнами Талры, чтобы быстро добраться до форпоста.‡Sprecht mit Hauptmann Übeldorn nördlich der Gärten von Quel\'Dormir.|n|nBenutzt das Seepferdchen von Wellensprecherin Tulra, um den Vorposten schnell zu erreichen.‡쿠엘도르미르 정원 북쪽에서 부대장 바일쏜을 찾아 대화해야 합니다.|n|n파도예언자 툴라의 해마를 사용하여 신속하게 전진 기지로 이동하십시오.‡Encuentra al capitán Espinavil y habla con él al norte de los Jardines de Quel\'Dormir.|n|nUtiliza el caballito de mar de la hablaolas Tulra para llegar rápidamente al puesto avanzado.‡Encuentra al capitán Espinavil y habla con él al norte de los Jardines de Quel\'Dormir.|n|nUtiliza el caballito de mar de la hablaolas Tulra para llegar rápidamente al puesto avanzado.‡Parlez au Capitaine Vileronce après l’avoir trouvé au nord des Jardins de Quel’Dormir.|n|nUtilisez l’hippocampe de la parle-vague Tulra pour arriver plus rapidement à destination.‡去奎尔多米尔花园北部找维索恩队长谈一谈。|n|n骑上波涛语者图尔拉的海马可以快速抵达前哨站。‡到奎多米爾花園北邊找惡刺隊長談話。|n|n使用語濤者圖爾拉的海馬來快速抵達前哨站。',
  }
},
[25959] = {
  {
    'Objetivos claros‡Ясные цели‡Deutliche Ziele‡명확한 목표‡Objetivos evidentes‡Objetivos evidentes‡Des objectifs clairs‡清晰的目标‡清楚的目標',
    nil,
    'Mate 10 tropas nagas que se reúnem sob o terraço a sudoeste, no térreo do local.‡Убейте 10 наг, собирающихся на нижнем уровне под юго-западной террасой.‡Tötet 10 Naga der Streitmächte, die sich unter der südlichen Terrasse auf der Grundebene zusammenziehen.‡남서쪽 계단지 아래 바닥층에 집합한 나가 군대 중 10마리를 처치해야 합니다.‡Mata a 10 miembros de las fuerzas naga que se están concentrando en la planta baja, bajo el bancal suroeste.‡Mata a 10 miembros de las fuerzas naga que se están concentrando en la planta baja, bajo el bancal suroeste.‡Tuez 10 éléments des troupes nagas s’amassant au niveau du sol, sous la terrasse sud.‡消灭10名在西南部平台下聚集的纳迦。‡殺死10名位於西南邊臺地下層的納迦部隊。',
  }
},
[25960] = {
  {
    'Não completamente despreparado‡Не так уж безоружны‡Nicht ganz unvorbereitet‡아주 무방비한 건 아니야‡No del todo desprevenidos‡No del todo desprevenidos‡C’est le vitrier !‡并非毫无准备‡並非全無準備',
    nil,
    'Leve 8 Pacotes de Setas de Besta para os Vigias da Horda posicionados em volta da extremidade norte dos Jardins de Quel\'Durmar.‡Принесите 8 связок арбалетных болтов дозорным Орды, расставленным на уступах на северном краю Садов Кель\'дормир.‡Bringt 8 Schachteln mit Armbrustbolzen zu den Aufklärern der Horde auf den Felsvorsprüngen um das nördliche Ende der Gärten von Quel\'Dormir.‡쿠엘도르미르 정원의 북쪽 끝 부근 벼랑에 있는 호드 보초병에게 석궁 화살 상자 8개를 가져가야 합니다.‡Entrega 8 puñados de pernos de ballesta a los oteadores de la Horda en el extremo norte de los jardines de Quel\'Dormir.‡Entrega 8 puñados de pernos de ballesta a los oteadores de la Horda en el extremo norte de los jardines de Quel\'Dormir.‡Allez livrer 8 Boîtes de carreaux d’arbalète aux Guetteurs de la Horde postés sur les rebords, le long de l’extrémité nord des Jardins de Quel’Dormir.‡给奎尔多米尔花园北部尽头附近的部落警戒哨兵送去8捆十字弓弩箭矢。‡將8捆弩箭帶去給部署在奎多米爾花園北端的部落偵查員。',
  }
},
[25961] = {
  {
    '‡Необычное поручение‡Spannende Ablenkung‡‡Curiosa distracción‡‡Un bien curieux passe-temps‡‡',
    nil,
    '‡Скопируйте надписи с 4 скрижалей высокорожденных.‡Schreibt die 4 Tafeln der Hochgeborenen ab.‡‡Copia las cuatro tablillas Altonato.‡‡Retranscrivez les 4 Tablettes de Bien-né.‡‡',
  }
},
[25962] = {
  {
    'Hora de improvisar‡Внезапное озарение‡Ausreichende Inspiration‡딱 맞는 영감‡La inspiración adecuada‡La inspiración adecuada‡Question d’inspiration‡备受启发‡適當地啟發',
    nil,
    'Colete 8 Bulbos Inchados de Alga que ficam pendurados sob o terraço a sudoeste.‡Соберите 8 раздувшихся шишек водорослей, висящих под юго-западной террасой.‡Sammelt 8 aufgedunsene Tangblasen, die unterhalb der südlichen Terrasse hängen.‡남서쪽 계단지 밑에 매달려 있는 불어오른 해초 알뿌리 8개를 모아가야 합니다.‡Reúne 8 bulbos de alga hinchados que cuelgan bajo el bancal suroeste.‡Reúne 8 bulbos de alga hinchados que cuelgan bajo el bancal suroeste.‡Récoltez 8 Bulbes de varech boursouflé qui pendent sous la terrasse sud-ouest.‡在西南部平台下收集8颗胀大的海藻球。‡在西南部臺地底下收集8個腫脹的海藻球莖。',
  }
},
[25963] = {
  {
    'Ação rápida‡Медлить нельзя‡Blitzangriff‡신속한 행동‡Acción rápida‡Acción rápida‡Une action enlevée‡动如脱兔‡快速行動',
    nil,
    'Fale com Fiasco Girafuso do lado de fora do prédio para tomar parte no ataque, e então use os explosivos improvisados para matar 100 Soldados Azsh\'ir, 20 Gritaondas Azsh\'ir e 12 Arkaens Azsh\'ir.‡Поговорите с Облином Свистозубом, стоящим у здания, чтобы присоединиться к атаке, а затем убейте 100 солдат Азш\'ира, 20 водных визгуний Азш\'ира и 12 археев Азш\'ира с помощью импровизированной взрывчатки.‡Sprecht mit Fiasco Siedefeix, um Euch dem Überfall anzuschließen. Benutzt dann Euren improvisierten Sprengstoff, um 100 Soldaten der Azsh\'ir, 20 Wellenkreischer der Azsh\'ir und 12 Archaeen der Azsh\'ir zu töten.‡공격에 참여하려면 건물 바로 밖에 있는 피아스코 시즐그린과 이야기한 다음, 즉석 폭탄을 사용하여 계단지 위쪽에 있는 아즈쉬르 병사 100마리, 아즈쉬르 파도 비명술사 20마리, 아즈쉬르 고대나가 12마리를 처치해야 합니다.‡Habla con Fiasco Girafusible en el exterior del edificio para unirte al asalto y utiliza tus explosivos improvisados para matar a 100 soldados de Azsh\'ir, 20 vociferadoras de las olas de Azsh\'ir y 12 arqueanos Azsh\'ir.‡Habla con Fiasco Girafusible en el exterior del edificio para unirte al asalto y utiliza tus explosivos improvisados para matar a 100 soldados de Azsh\'ir, 20 vociferadoras de las olas de Azsh\'ir y 12 arqueanos Azsh\'ir.‡Parlez à Fiasco Grésirictus juste à l’extérieur du bâtiment pour participer à l’attaque, puis utilisez vos explosifs improvisés pour tuer 100 Soldats azsh’ir, 20 Hurle-vagues azsh’ir et 12 Archéens azsh’ir.‡跟房子外面的菲亚斯科·尖笑交谈并加入总攻，使用你的速成炸药杀死平台上的100个艾萨尔士兵、20个艾萨尔波涛尖啸者和12个艾萨尔上古卫士。‡和建築外面的菲亞斯戈·嘶咧談話來加入突擊行動，然後使用你臨時做出來的爆裂物在臺地上殺死100個艾薩伊爾士兵、20個艾薩伊爾嘯浪者和12個艾薩伊爾執政官。',
  }
},
[25964] = {
  {
    'Caídos, mas não esquecidos‡Повержены, но не забыты‡Gefallen, aber nicht vergessen‡스러졌으나 잊지 않으리라‡Caídos, pero no olvidados‡Caídos, pero no olvidados‡Tombés mais pas oubliés‡任何人都不能落下‡失落但不被遺忘',
    nil,
    'Resgate 6 Voluntários do Ataque Feridos‡Спасите 6 раненых добровольцев.‡Rettet 6 verletzte freiwillige Angreifer.‡부상당한 돌격 지원병 6명을 구출해야 합니다.‡Rescata a 6 voluntarios de asalto heridos.‡Rescata a 6 voluntarios de asalto heridos.‡Secourez 6 Volontaires pour l’assaut blessés.‡营救6名受伤的突击志愿兵。‡解救6名受傷的志願突襲兵。',
  }
},
[25965] = {
  {
    'Avaliando o sucesso‡Подсчет‡Einschätzung des Erfolgs‡성공 가늠하기‡Estimación de éxito‡Estimación de éxito‡Post mortem‡估测胜算‡成功標準',
    nil,
    'Examine a área noroeste do terraço circular e o túnel sob as escadas principais ao norte. Ambos os locais se encontram no Terraço de Nar\'shola, o nível intermediário das ruínas.‡Проведите разведку по краю круглой террасы на северо-западе и в туннеле под главной лестницей на севере. Оба места расположены на террасе Нар\'шолы на среднем уровне развалин.‡Späht den Rand der runden Terrasse im Nordwesten und den Tunnel unter der Haupttreppe im Norden aus. Beides befindet sich auf der Terrasse von Nar\'shola, in der mittleren Ebene der Ruinen.‡계단지의 북서쪽 지역과 주 계단으로 이어지는 북쪽 터널을 정찰해야 합니다. 양 지역 모두 폐허의 중간층 나르숄라 계단지에 있습니다.‡Explora la sección noroeste del bancal circular y el túnel que hay bajo las escaleras principales del norte. Ambos lugares se encuentran en el Bancal de Nar\'shola, el nivel medio de las ruinas.‡Explora la sección noroeste del bancal circular y el túnel que hay bajo las escaleras principales del norte. Ambos lugares se encuentran en el Bancal de Nar\'shola, el nivel medio de las ruinas.‡Explorez la partie nord-ouest de la terrasse circulaire, ainsi que le tunnel sous le grand escalier nord. Ces deux endroits se situent sur la terrasse de Nar’shola, le niveau intermédiaire des ruines.‡侦查圆形平台的西北边缘，以及北部主台阶下的隧道。这两个地点都在废墟的中层。‡偵查圓形殿堂的西北邊和北邊主階梯下面的通道。兩個地點都在廢墟中層的納爾朔拉殿堂之上。',
  }
},
[25966] = {
  {
    'Visões do passado: o massacre da Crista Biel\'aran‡Видения прошлого: битва на гряде Бейл\'аран‡Visionen der Vergangenheit: Das Massaker von Biel\'aran‡과거의 환영: 비엘아란 마루의 학살자‡Visiones del pasado: La matanza de la Cresta de Biel\'aran‡Visiones del pasado: La matanza de la Cresta de Biel\'aran‡Visions du passé : le massacre de la crête de Biel\'aran‡过去的影像：贝耶拉兰山惨案‡過去的幻景:畢耶拉蘭山脊的屠殺',
    nil,
    'Assista à história da Dama Guerreira usando a lâmina quebrada no local da morte do general kvaldir.‡Отправляйтесь на место гибели квалдирского генерала и с помощью сломанного клинка Воительницы призовите видение из прошлого, чтобы узнать продолжение истории о Воительнице.‡Werdet Zeuge des weiteren Verlaufs der Geschichte der Kriegsmaid, indem Ihr ihre gebrochene Klinge am Sterbeort des Generals der Kvaldir benutzt.‡크발디르 장군이 죽은 곳으로 간 다음, 부러진 창을 사용하여 나가 여전사의 다음 이야기를 확인해야 합니다.‡Contempla la continuación de la historia de la doncella de batalla utilizando su hoja rota en el lugar de la muerte del general Kvaldir.‡Contempla la continuación de la historia de la doncella de batalla utilizando su hoja rota en el lugar de la muerte del general Kvaldir.‡Apprenez la suite de l’histoire de la vierge combattante en utilisant sa lame brisée à l’endroit où est tombé le général kvaldir.‡在克瓦迪尔将军的阵亡之地使用女武士的断剑，目睹她随后的经历。‡使用戰鬥仕女的斷劍來見證她在科瓦迪爾將軍陣亡之地的後續故事。',
  }
},
[25967] = {
  {
    'Perdendo terreno‡Отступление‡Haltlos‡후퇴‡Perdiendo terreno‡Perdiendo terreno‡On perd du terrain‡失地‡失去領土',
    nil,
    'Use o cavalo-marinho da Falaondas Tulra para retornar ao Capitão Vilespinho ao norte das Ruínas de Vashj\'ir.‡Воспользуйтесь морским коньком говорящей с волнами Талры, чтобы вернуться к капитану Злобешипу, находящемуся к северу от Садов Кель\'Дормир.‡Benutzt das Seepferdchen von Wellensprecherin Tulra, um zu Hauptmann Übeldorn nördlich der Gärten von Quel\'Dormir zurückzukehren.‡파도예언자 툴라의 해마를 사용하여 쿠엘도르미르 정원 북쪽에 있는 부대장 바일쏜에게 가야 합니다.‡Utiliza el caballito de mar de la hablaolas Tulra para volver con el capitán Espinavil justo al norte de los Jardines de Quel\'Dormir.‡Utiliza el caballito de mar de la hablaolas Tulra para volver con el capitán Espinavil justo al norte de los Jardines de Quel\'Dormir.‡Utilisez l’hippocampe de la parle-vague Tulra pour retourner auprès du capitaine Vileronce, juste au nord des Jardins de Quel’Dormir.‡骑上波涛语者图尔拉的海马去奎尔多米尔花园的北部找维索恩队长。‡使用語濤者圖爾拉的海馬來回到奎多米爾花園的北邊找惡刺隊長。',
  }
},
[25968] = {
  {
    'Plano de emergência‡Отчаянный план‡Ein verzweifelter Plan‡필사적인 계획‡Plan desesperado‡Plan desesperado‡Un plan désespéré‡绝望的计划‡背水一戰',
    nil,
    'Encontre-se com Fiasco Girafuso na Crista Biel\'aran.‡Найдите Облина Свистозуба на гряде Бейл\'аран.‡Trefft Euch mit Fiasco Siedefeix auf dem Biel\'arangrat.‡비엘아란 마루에 있는 피아스코 시즐그린을 만나야 합니다.‡Reúnete con Fiasco Girafusible en la Cresta de Biel\'aran.‡Reúnete con Fiasco Girafusible en la Cresta de Biel\'aran.‡Allez retrouver Fiasco Grésirictus sur la Crête de Biel’aran.‡去贝耶拉兰山找菲亚斯科·尖笑。‡在畢耶拉蘭山脊和菲亞斯戈·嘶咧碰面。',
  }
},
[25969] = {
  {
    'Águas hostis‡Опасные воды‡Feindliche Gewässer‡위협적인 수중 생물‡Aguas hostiles‡Aguas hostiles‡Des eaux hostiles‡敌对水域‡敵方水域',
    nil,
    'Mate 10 Bicões Pelancalamas.‡Уничтожьте 10 слизнешкурых хапуг.‡Tötet 10 Schlickhautschnorrer.‡진흙피부 강탈자 10마리를 처치해야 합니다.‡Mata a 10 chupópteros Pielmugre.‡Mata a 10 chupópteros Pielmugre.‡Tuez 10 Écornifleurs bourbepeau.‡消灭10名污鳞拾荒者。‡殺死10名汙皮收集者。',
  }
},
[25970] = {
  {
    'É melhor se preparar‡Наготове‡Immer vorbereitet‡준비하시고‡Hay que venir preparados‡Hay que venir preparados‡Toujours prêt !‡有备而来‡有備而來',
    nil,
    'Recupere um Kit de Sobrevivência da Horda.‡Разыщите ящик Орды с предметами первой необходимости.‡Besorgt eine Überlebensausrüstung der Horde.‡호드 구명 상자를 입수해야 합니다.‡Recupera un equipo de supervivencia de la Horda.‡Recupera un equipo de supervivencia de la Horda.‡Retrouvez un Kit de survie de la Horde.‡回收部落救生箱。‡取得部落求生包。',
  }
},
[25971] = {
  {
    'Corda cabeluda‡Веревочный план‡Seilakrobatik‡펼쳐지는 계획‡Plan desplegable‡Plan desplegable‡Un plan de sac et de corde‡展开计划‡揭露計畫',
    nil,
    'Colete 8 Rolos de Corda Kvaldir.‡Добудьте 8 мотков квалдирской веревки.‡Sammelt 8 Kvaldirseile.‡크발디르 밧줄 똬리 8묶음을 모아야 합니다.‡Reúne 8 espirales de cuerda Kvaldir.‡Reúne 8 espirales de cuerda Kvaldir.‡Obtenez 8 Rouleaux de corde kvaldir.‡收集8根克瓦迪尔套索。‡收集8綑科瓦迪爾繩索。',
  }
},
[25972] = {
  {
    'Fazendo as honras‡Честь и слава‡Ehre und Privileg‡명예로운 특권‡Honor y privilegio‡Honor y privilegio‡Honneur et privilège‡荣幸与特权‡榮譽與特權',
    nil,
    'Nade até a superfície, pegue o sinalizador e use-o na direção das embarcações da Horda.‡Поднимитесь на поверхность, возьмите сигнальное ружье и запустите сигнальную ракету в направлении кораблей Орды.‡Schwimmt zur Oberfläche, holt die Leuchtpistole und feuert ein Rettungsleuchtfeuer in Richtung der Hordenschiffe.‡수면으로 올라가서 신호용 권총을 구한 다음, 호드 함선을 향해 구명 신호탄을 쏘아야 합니다.‡Nada hacia la superficie, recupera la pistola de bengalas y dispara una centella de rescate hacia los barcos de la Horda.‡Nada hacia la superficie, recupera la pistola de bengalas y dispara una centella de rescate hacia los barcos de la Horda.‡Nagez jusqu’à la surface, prenez le lance-fusées et tirez une fusée de détresse vers les Vaisseaux de la Horde.‡游上水面，拿到信号枪，朝部落船只发射信号弹。‡游到水面，取得信號槍，然後對聯盟船隻發射救援的信號彈。',
  }
},
[25973] = {
  {
    'Notícias de boas-vindas‡Добрые вести‡Willkommene Nachrichten‡반가운 소식‡Noticias bienvenidas‡Noticias bienvenidas‡De bonnes nouvelles‡好消息‡歡迎的消息',
    nil,
    'Fale novamente com o Legionário Nazgrim no Repouso da Legião.‡Возвращайтесь к легионеру Назгриму на базу Легиона.‡Kehrt zu Legionär Nazgrim an der Ruhestatt der Legion zurück.‡군단의 안식처에 있는 부관 나즈그림에게 가야 합니다.‡Vuelve con el legionario Nazgrim al Reposo de la Legión.‡Vuelve con el legionario Nazgrim al Reposo de la Legión.‡Retournez voir le Légionnaire Nazgrim au repos de la Légion.‡去找军团营地的军团士兵纳兹戈林。‡到軍團之眠找軍團士兵納茲格寧姆。',
  }
},
[25974] = {
  {
    'Extermínio das Sira\'kess‡Истребление Сира\'кесс‡Tod den Sira\'kess‡시라케스 사냥‡Matanza de Sira\'kess‡Matanza de Sira\'kess‡Le massacre de Sira’kess‡进攻希拉柯丝‡席拉克斯大屠殺',
    nil,
    'Mate 10 Nagas Sira\'kess.‡Убейте 10 наг Сира\'кесс.‡Tötet 10 Naga der Sira\'kess.‡시라케스 나가 10마리를 처치해야 합니다.‡Mata a 10 nagas Sira\'kess.‡Mata a 10 nagas Sira\'kess.‡Tuez 10 Nagas de Sira’kess.‡杀死10只希拉柯丝纳迦。‡消滅10個席拉克斯納迦。',
  }
},
[25975] = {
  {
    'Reivindicação do tesouro‡Экспроприация сокровищ‡Einforderung der Schätze‡보물 되찾기‡Reclamar tesoros‡Reclamar tesoros‡Le trésor à son inventeur‡夺回财宝‡取回寶藏',
    nil,
    'Colete 6 Tesouros das Barbatanas‡Соберите 6 предметов добычи Глубинных Плавников.‡Sammelt 6 Stück Tiefenflossenbeute.‡심해지느러미 약탈품 6개를 수집해야 합니다.‡Reúne 6 saqueos de Aleta Profunda.‡Reúne 6 saqueos de Aleta Profunda.‡Récupérez 6 parties de Butin nagegouffre.‡收集6份深鳍战利品。‡收集6份深鰭掠奪物資。',
  }
},
[25976] = {
  {
    'Reivindicação do tesouro‡Экспроприация сокровищ‡Einforderung der Schätze‡보물 되찾기‡Reclamar tesoros‡Reclamar tesoros‡Le trésor à son inventeur‡夺回财宝‡取回寶藏',
    nil,
    'Colete 6 Tesouros das Barbatanas.‡Соберите 6 предметов добычи Глубинных Плавников.‡Sammelt 6 Stück Tiefenflossenbeute.‡심해지느러미 약탈품 6개를 수집해야 합니다.‡Reúne 6 saqueos de Aleta Profunda.‡Reúne 6 saqueos de Aleta Profunda.‡Récupérez 6 parties de Butin nagegouffre.‡收集6份深鳍战利品。‡收集6份深鰭掠奪物資。',
  }
},
[25977] = {
  {
    'Mais um dia na vida de Azrajar‡Знаменательный день для Азражара‡Ein standartenmäßiger Tag für Azrajar‡깃발 휘날리며‡Un día "señalado" para Azrajar‡Un día "señalado" para Azrajar‡Sale temps pour un mandefonds‡阿泽拉夏的末日‡阿茲拉賈爾的一天',
    nil,
    'Crave o Estandarte da Aliança no cadáver do Invocador das Profundezas Azrajar.‡Воткните знамя Альянса в труп призывателя глубин Азражара.‡Rammt die Standarte der Allianz in Tiefenrufer Azrajars Leichnam.‡심해소환사 아즈라자르의 시체 바로 옆에 얼라이언스 기를 꽂아야 합니다.‡Coloca el confalón de la Alianza en el cadáver del clamaprofundidades Azrajar.‡Coloca el confalón de la Alianza en el cadáver del clamaprofundidades Azrajar.‡Plantez l’Étendard de l’Alliance dans le cadavre du Mandefonds Azrajar.‡将联盟旗帜插在深渊召唤者阿泽拉夏的躯体旁。‡在深淵呼喚者阿茲拉賈爾屍體上植入聯盟戰旗。',
  }
},
[25978] = {
  {
    'Caindo numa fria‡Погребенные во льду‡Im Eis eingeschlossen‡얼음 속에 갇힌 산악경비대‡Tumbas de hielo‡Tumbas de hielo‡Congelés vivants‡冰中之棺‡寒冰之墓',
    nil,
    'Rompa 6 Tumbas Geladas para libertar os Montanhistas Congelados que estão presos no Lago Helm.‡Вскройте 6 ледяных гробниц, чтобы освободить замерзших горных пехотинцев, находящихся в плену озера Хельмово Ложе.‡Öffnet sechs eisige Gräber, um die gefrorenen Gebirgsjäger am Helmsbettsee zu befreien.‡얼음 무덤 6개를 파괴해 투구바닥 호수에 갇힌 얼어붙은 산악경비대를 구출해야 합니다.‡Abre 6 tumbas heladas para liberar a los montaraces congelados atrapados en el Lago de Helm.‡Abre 6 tumbas heladas para liberar a los montaraces congelados atrapados en el Lago de Helm.‡Fracassez 6 Tombes glaciales pour en libérer les Montagnards gelés au Lac du lit d’Helm.‡在盔枕湖打破六口冰墓，解救困在里面的被冻结的巡山人。‡在盔枕湖破開6個寒冰之墓來解放被困在裡面的被冰凍的巡山人。',
  }
},
[25979] = {
  {
    'Surto elemental‡Утихомирить волны‡Glättet die Wogen‡정령 처치‡Cuando la marea sube‡Cuando la marea sube‡Combattre le jaillissement lacustre‡情绪澎湃‡抑制波濤',
    nil,
    'Mate 6 Rebentadores do Lago Helm no Lago Helm.‡Убейте 6 озерных волногонов в озере Хельмово Ложе.‡Tötet 6 Woger des Helmbettsees am Helmbettsee.‡투구바닥 호수에 있는 투구바닥 호수 정령 6마리를 처치해야 합니다.‡Mata a 6 mareas de Helm en el Lago de Helm.‡Mata a 6 mareas de Helm en el Lago de Helm.‡Tuez 6 Surgisseurs du lit d’Helm au Lac du lit d’Helm.‡在盔枕湖杀死6只盔枕湖涌动者。‡在盔枕湖殺死6個盔枕奔騰者。',
  }
},
[25980] = {
  {
    'Mais um dia na vida de Azrajar‡Знаменательный день для Азражара‡Ein standartenmäßiger Tag für Azrajar‡깃발 휘날리며‡Un día "señalado" para Azrajar‡Un día "señalado" para Azrajar‡Sale temps pour un mandefonds‡阿泽拉夏的末日‡阿茲拉賈爾的一天',
    nil,
    'Crave o Estandarte da Horda no cadáver do Invocador das Profundezas Azrajar.‡Воткните знамя Орды в труп призывателя глубин Азражара.‡Rammt die Standarte der Horde in Tiefenrufer Azrajars Leichnam.‡심해소환사 아즈라자르의 시체 바로 옆에 호드 기를 꽂아야 합니다.‡Coloca el confalón de la Horda en el cadáver del clamaprofundidades Azrajar.‡Coloca el confalón de la Horda en el cadáver del clamaprofundidades Azrajar.‡Plantez l’Étendard de la Horde dans le cadavre du Mandefonds Azrajar.‡将部落旗帜插在深渊召唤者阿泽拉夏的躯体旁。‡把部落戰旗立在深淵呼喚者阿茲拉賈爾的屍體上。',
  }
},
[25981] = {
  {
    'Tudo menos máscaras‡Это не маски‡Das sind gar keine Masken‡가면이 아니야‡No son máscaras‡No son máscaras‡Ce ne sont pas des masques‡那些不是面具‡那些不是面具',
    nil,
    'Colete 6 Cabeças Impiedosas.‡Добудьте 6 голов безжалостных.‡Sammelt 6 Köpfe eines Gnadenlosen.‡무자비한 머리 6개를 모아야 합니다.‡Reúne 6 cabezas despiadadas.‡Reúne 6 cabezas despiadadas.‡Récoltez 6 Têtes sans-pitié.‡收集6个无悯之头。‡收集6個殘虐獸的頭。',
  }
},
[25982] = {
  {
    'Tudo menos máscaras‡Это не маски‡Das sind gar keine Masken‡가면이 아니야‡No son máscaras‡No son máscaras‡Ce ne sont pas des masques‡那些不是面具‡那些不是面具',
    nil,
    'Colete 6 Cabeças Impiedosas.‡Добудьте 6 голов безжалостных.‡Sammelt 6 Köpfe eines Gnadenlosen.‡무자비한 머리 6개를 모아야 합니다.‡Reúne 6 cabezas despiadadas.‡Reúne 6 cabezas despiadadas.‡Récoltez 6 Têtes sans-pitié.‡收集6个无悯之头。‡收集6個殘虐獸的頭。',
  }
},
[25983] = {
  {
    'Promontório‡Подводный выступ‡Das Kap‡낭떠러지 거점‡Alto del Promontorio‡Alto del Promontorio‡Le Promontoire‡海角岗哨‡岬點',
    nil,
    'Fale com o Capitão Taylor no Promontório em Vashj\'ir.‡Поговорите с капитаном Тейлором на Подводном выступе в Вайш\'ире.‡Sprecht mit Kapitän Taylor am Kap in Vashj\'ir.‡바쉬르의 낭떠러지 거점에 있는 부대장 테일러와 대화해야 합니다.‡Habla con el capitán Taylor en Alto del Promontorio, en Vashj\'ir.‡Habla con el capitán Taylor en Alto del Promontorio, en Vashj\'ir.‡Parlez au Capitaine Taylor sur le Promontoire, en Vashj’ir.‡与瓦丝琪尔海角岗哨的泰勒上尉交谈。‡到瓦許伊爾的岬點和泰勒隊長談話。',
  }
},
[25984] = {
  {
    'Promontório‡Подводный выступ‡Das Kap‡낭떠러지 거점‡Alto del Promontorio‡Alto del Promontorio‡Le Promontoire‡海角岗哨‡岬點',
    nil,
    'Fale com o Legionário Nazgrim no Promontório em Vashj\'ir.‡Поговорите с легионером Назгримом на Подводном выступе в Вайш\'ире.‡Sprecht mit Legionär Nazgrim am Kap in Vashj\'ir.‡바쉬르의 낭떠러지 거점에 있는 부관 나즈그림과 대화해야 합니다.‡Habla con el legionario Nazgrim en Alto del Promontorio, en Vashj\'ir.‡Habla con el legionario Nazgrim en Alto del Promontorio, en Vashj\'ir.‡Parlez au Légionnaire Nazgrim sur le Promontoire, en Vashj’ir.‡与瓦丝琪尔海角岗哨的军团士兵纳兹戈林交谈。‡到瓦許伊爾的岬點和軍團士兵納茲格寧姆談話。',
  }
},
[25985] = {
  {
    'Asas de Hyjal‡Крылья над Хиджалом‡Schwingen über dem Hyjal‡하이잘 산의 날개‡Sobrevolando Monte Hyjal‡Sobrevolando Monte Hyjal‡Vol au-dessus du mont Hyjal‡海加尔山上的鹰‡飛越海加爾山',
    nil,
    'Encontre Choluna no Santuário de Aviana, no Monte Hyjal.‡Найдите Чолуну в святилище Авианы на горе Хиджал.‡Findet Choluna am Schrein von Aviana auf dem Hyjal.‡하이잘 산의 아비아나의 제단에서 초루나를 찾아야 합니다.‡Encuentra a Choluna en el Santuario de Aviana, en Monte Hyjal.‡Encuentra a Choluna en el Santuario de Aviana, en Monte Hyjal.‡Trouvez Choluna au Sanctuaire d’Aviana, au Mont Hyjal.‡去找海加尔山艾维娜圣殿的楚伦娜。‡在海加爾山的艾維娜聖壇找到克魯娜。',
  }
},
[25986] = {
  {
    'Problemas no lago‡Проблема на озере‡Ärger am See‡호수에서 발생한 문제‡Problemas en el lago‡Problemas en el lago‡Eaux à problèmes‡盔枕湖的麻烦‡湖邊的麻煩',
    nil,
    'Fale com o Sargento Bahrum no Posto de Bahrum.‡Поговорите с сержантом Бахрумом в Лагере Бахрума.‡Sprecht mit Unteroffizier Bahrum an Bahrums Posten.‡바룸의 초소에 있는 하사관 바룸과 대화해야 합니다.‡Habla con el sargento Bahrum en el Puesto de Bahrum.‡Habla con el sargento Bahrum en el Puesto de Bahrum.‡Parlez au Sergent Bahrum au Poste de Bahrum.‡跟巴赫隆岗哨的巴赫隆中士谈一谈。‡到巴盧姆崗哨找巴盧姆中士談話。',
  }
},
[25987] = {
  {
    'Cai de cabeça‡Прекрасная маскировка‡Setzt es auf‡착용 소감‡Coge tu sombrero y póntelo‡Coge tu sombrero y póntelo‡Coiffez-moi ça‡戴上它‡穿上去',
    nil,
    'Observe o que acontece ao "vestir" o Impiedoso na cabeça.‡Посмотрите, что будет, если надеть на голову мертвого Безжалостного.‡Beobachtet, was passiert, wenn Ihr einen Gnadenlosen auf Euren Kopf setzt.‡무자비한 생물을 머리에 썼을 때 생기는 일을 목격해야 합니다.‡Observa qué ocurre cuando te pones El Despiadado en la cabeza.‡Observa qué ocurre cuando te pones El Despiadado en la cabeza.‡Observez ce qui se passe lorsque vous mettez le sans-pitié sur votre tête.‡戴上无悯之头，看看会发生什么。‡看看當你將殘虐獸戴到頭上時發生了什麼事。',
  }
},
[25988] = {
  {
    'Cai de cabeça‡Прекрасная маскировка‡Setzt es auf‡착용 소감‡Coge tu sombrero y póntelo‡Coge tu sombrero y póntelo‡Coiffez-moi ça‡戴上它‡穿上去',
    nil,
    'Observe o que acontece ao "vestir" o Impiedoso na cabeça.‡Посмотрите, что будет, если надеть на голову мертвого Безжалостного.‡Beobachtet, was passiert, wenn Ihr einen Gnadenlosen auf Euren Kopf setzt.‡무자비한 생물을 머리에 썼을 때 생기는 일을 목격해야 합니다.‡Observa qué ocurre cuando te pones El Despiadado en la cabeza.‡Observa qué ocurre cuando te pones El Despiadado en la cabeza.‡Observez ce qui se passe lorsque vous mettez le sans-pitié sur votre tête.‡戴上无悯之头，看看会发生什么。‡看看當你將殘虐獸戴到頭上時發生了什麼事。',
  }
},
[25989] = {
  {
    'Capture o caranguejo‡Захват краба‡Fang den Krebs‡게 사냥‡Captura al cangrejo‡Captura al cangrejo‡Capturer un crabe‡抓螃蟹‡抓螃蟹',
    nil,
    'Use a Rede de Duarn para capturar um Caranguejo Buscafundo dentro de Nespirah.‡Поймайте сетью Дуарна глубинного краба в Неспире.‡Benutzt Duarns Netz, um einen Tiefensucherkrebs in Nespirah zu fangen.‡두아른의 그물을 써서 네스피라 안에 있는 해저 땅게를 잡아야 합니다.‡Usa la red de Duarn para capturar a un cangrejo Buscaprofundo en el interior de Nespirah.‡Usa la red de Duarn para capturar a un cangrejo Buscaprofundo en el interior de Nespirah.‡Utilisez le Filet de Duarn pour capturer un Crabe cherchefonds dans Nespirah.‡在奈瑟匹拉体内，使用达鲁的网捕捉一只深渊猎手蟹。‡用杜亞恩的網子捕抓一隻奈斯畢拉體內的深尋蟹。',
  }
},
[25990] = {
  {
    'Abrindo caminho‡Прорыв‡Durchbruch‡돌파구‡Abriéndose paso‡Abriéndose paso‡Avancée décisive‡冲破障碍‡突破',
    nil,
    'Observe enquanto o Reparador da Terra Duarn tenta falar com Nespirah.‡Проследите за тем, как Целитель Земли Дуарн попытается заговорить с Неспирой.‡Beobachtet Erdheiler Duarn, während er versucht, mit Nespirah zu sprechen.‡대지치유사 두아른이 네스피라와 대화를 시도하는 모습을 지켜봐야 합니다.‡Observa cómo el ensalmador de la tierra Duarn trata de hablar con Nespirah.‡Observa cómo el ensalmador de la tierra Duarn trata de hablar con Nespirah.‡Observez le Soigneterre Duarn essayer de parler à Nespirah.‡在大地治愈者达鲁尝试与奈瑟匹拉交谈时，在一旁观察。‡觀察大地治癒者杜亞恩嘗試與奈斯畢拉溝通。',
  }
},
[25991] = {
  {
    'Não estamos sozinhos‡Мы не одиноки‡Wir sind nicht allein‡혼자가 아니야‡No estamos solos‡No estamos solos‡Nous ne sommes pas seuls‡我们并不孤单‡我們並不孤單',
    nil,
    'Encontre os sobreviventes da Horda dentro de Nespirah, que fica em Vash\'jir.‡Отыщите выживших представителей Орды в Неспире, что находится в Вайш\'ире.‡Findet die Überlebenden der Horde in Nespirah in Vashj\'ir.‡바쉬르의 네스피라 안에서 호드 생존자를 찾아야 합니다.‡Encuentra a los supervivientes de la Horda en el interior de Nespirah, en Vashj\'ir.‡Encuentra a los supervivientes de la Horda en el interior de Nespirah, en Vashj\'ir.‡Trouvez les survivants de la Horde dans Nespirah, en Vashj’ir.‡在瓦丝琪尔的奈瑟匹拉内部找到部落的幸存者。‡在奈斯畢拉體內的瓦許伊爾尋找部落倖存者。',
  }
},
[25992] = {
  {
    'Totalmente desequipado‡Безоружные‡Hoffnungslos ausrüstungslos‡비무장의 절망‡Muy mal equipados‡Muy mal equipados‡Des armes pour les braves‡手无寸铁‡無望的裝備短缺',
    nil,
    'Obtenha 4 Armas de Haste Furtadas dos cavaletes de armas dentro de Nespirah.‡Принесите 4 похищенных трезубца с оружейных стоек в Неспире.‡Besorgt 4 entwendete Stangenwaffen aus den Waffenregalen in Nespirah.‡네스피라에 있는 무기 선반에서 훔쳐낸 장창 4개를 획득해야 합니다.‡Obtén 4 armas de asta hurtadas de los expositores de armas del interior de Nespirah.‡Obtén 4 armas de asta hurtadas de los expositores de armas del interior de Nespirah.‡Prenez 4 Armes d’hast dérobées sur les râteliers d’armes dans Nespirah.‡从奈瑟匹拉里面的武器架上收集4支被盗的长矛。‡從奈斯畢拉體內的武器架取得4把偷來的長柄武器。',
  }
},
[25993] = {
  {
    'Golpes corporais‡Удар по телу‡Voller Körpereinsatz‡몸통 공격‡Golpes en el cuerpo‡Golpes en el cuerpo‡Des coups au corps‡刺痛躯体‡重擊身體',
    nil,
    'Ataque 7 Abscessos de Nespirah ao longo das paredes da câmara respiratória de Nespirah.‡Ударьте Неспиру в 7 гнойников, расположенных на стенах ее полости.‡Greift 7 Abszesse von Nespirah an den Wänden von Nespirahs Körperkammer an.‡네스피라 몸 속 방의 벽을 따라 나 있는 네스피라 농양 7개를 공격해야 합니다.‡Ataca a 7 abscesos de Nespirah a lo largo de las paredes de la cámara corporal de Nespirah.‡Ataca a 7 abscesos de Nespirah a lo largo de las paredes de la cámara corporal de Nespirah.‡Attaquez 7 Abcès de Nespirah sur les murs de la chambre principale du corps de Nespirah.‡在奈瑟匹拉的体腔内的墙上攻击7处奈瑟匹拉脓肿。‡攻擊7個位於奈斯畢拉體內壁上的奈斯畢拉囊腫。',
  }
},
[25994] = {
  {
    'Não deixam de ser valiosas‡Ценные вещи‡Immer noch wertvoll‡여전히 소중한‡No menos valiosas‡No menos valiosas‡Le pot aux perles‡仍有价值‡仍有價值',
    nil,
    'Obtenha 5 Pérolas Misteriosas de Senhores da Guerra e Profetas Idra\'kess dentro de Nespirah.‡Добудьте у полководцев и пророков Идра\'кесса в Неспире 5 таинственных жемчужин.‡Besorgt 5 mysteriöse Perlen von Kriegsherren des Idra\'kess und Prophetinnen des Idra\'kess in Nespirah.‡네스피라에 있는 이드라케스 사령관과 이드라케스 예언자에게서 신비한 진주 5개를 얻어야 합니다.‡Obtén 5 perlas misteriosas de señores de la guerra Idra\'kess y profetas Idra\'kess en el interior de Nespirah.‡Obtén 5 perlas misteriosas de señores de la guerra Idra\'kess y profetas Idra\'kess en el interior de Nespirah.‡Récupérez 5 Perles mystérieuses sur le cadavre de Seigneurs de guerre ou de Prophètes d’Idra’kess dans Nespirah.‡从奈瑟匹拉里面的埃卓凯丝督军和埃卓凯丝先知手中夺取5颗神秘的珍珠。‡在奈斯畢拉體內從艾德拉奇斯督軍和艾德拉奇斯預言者取得5個神秘的珍珠。',
  }
},
[25995] = {
  {
    'Feitor Idra\'kess‡Надзиратель Идра\'кесс‡Aufseher Idra\'kess‡감독관 이드라케스‡Sobrestante Idra\'kess‡Sobrestante Idra\'kess‡Le surveillant Idra’kess‡监督者埃卓凯丝‡監督者艾德拉奇斯',
    nil,
    'Vá para o topo de Nespirah e mate o Feitor Idra\'kess.‡Отправляйтесь в верхнюю полость Неспиры и убейте надзирателя Идра\'кесса.‡Geht zur Spitze Nespirahs und tötet Aufseher Idra\'kess.‡네스피라 꼭대기로 올라가 감독관 이드라케스를 처치해야 합니다.‡Dirígete a la parte superior de Nespirah y mata al sobrestante Idra\'kess.‡Dirígete a la parte superior de Nespirah y mata al sobrestante Idra\'kess.‡Grimpez au sommet de Nespirah et tuez le Surveillant Idra’kess.‡前往奈瑟匹拉的顶部，杀死监督者埃卓凯丝。‡到奈斯畢拉頭頂並殺死監督者艾德拉奇斯。',
  }
},
[25996] = {
  {
    'Despertando a fera‡Пробуждение‡Die Erweckung der Bestie‡네스피라 깨우기‡Despierta a la bestia‡Despierta a la bestia‡Éveiller la Bête‡唤醒巨兽‡喚醒野獸',
    nil,
    'Fale com o Reparador da Terra Duarn dentro de Nespirah, para ativar as defesas biológicas dela. Em seguida, escape do corpo de Nespirah.‡Поговорите с Целителем Земли Дуарном в Неспире, чтобы запустить защитные процессы. Затем покиньте тело Неспиры.‡Sprecht mit Erdheiler Duarn in Nespirah, um ihre biologische Verteidigung zu aktivieren und flieht dann aus Nespirahs Körper.‡네스피라 안에 있는 대지치유사 두아른과 대화하여 생체 방어 계통을 활성화시킨 후 탈출해야 합니다.‡Habla con el Ensalmador de la tierra Duarn en el interior de Nespirah para activar sus defensas biológicas. Después, huye del cuerpo de Nespirah.‡Habla con el Ensalmador de la tierra Duarn en el interior de Nespirah para activar sus defensas biológicas. Después, huye del cuerpo de Nespirah.‡Parlez au Soigneterre Duarn dans Nespirah, afin que celle-ci active ses défenses immunitaires, puis échappez-vous de son organisme.‡与奈瑟匹拉里面的大地治愈者达鲁交谈，激活奈瑟匹拉的生物防御机制，然后逃离奈瑟匹拉的身体。‡與大地治癒者杜亞恩說話以啟動奈斯畢拉自身的防衛機關，然後逃離奈斯畢拉的身體。',
  }
},
[25997] = {
  {
    'Armações dos Ferro Negro‡Тайные планы Черного Железа‡Die Heimtücke der Dunkeleisenzwerge‡검은무쇠 부족의 음모‡La conspiración de los Hierro Negro‡La conspiración de los Hierro Negro‡Les Sombrefers ourdissent un complot‡黑铁的阴谋‡黑鐵計畫',
    nil,
    'Mate 5 Espiões Ferro Negro e tome os Planos de Ataque dos Ferro Negro do Capitão Beld no Complexo de Bandaferro.‡Отправляйтесь в мастерскую Сталекрута, убейте 5 шпионов из клана Черного Железа и отберите план нападения Черного Железа у капитана Бельда.‡Tötet 5 Spione der Dunkeleisenzwerge und erbeutet die Angriffspläne der Dunkeleisenzwerge von Hauptmann Beld in Eisenbands Truppenlager.‡아이언밴드 야영지에서 검은무쇠 비밀 요원 5명과 부대장 벨트를 처치하고 검은무쇠 공격 계획서를 찾아와야 합니다.‡Mata a 5 espías Hierro Negro y apodérate de planes de ataque Hierro Negro del capitán Beld en el Complejo Vetaferro.‡Mata a 5 espías Hierro Negro y apodérate de planes de ataque Hierro Negro del capitán Beld en el Complejo Vetaferro.‡Tuez 5 Espions sombrefers et arrachez les Plans d’attaque des Sombrefers des mains du Capitaine Beld, dans la Base de Baguefer.‡在铁环营地杀死5名黑铁间谍，从贝尔德队长的身上缴获黑铁攻击计划。‡殺死5名黑鐵間諜並從鐵環營地的貝爾德隊長那裡取得黑鐵攻擊計畫。',
  }
},
[25998] = {
  {
    'Vá voando para a base aérea!‡Попасть на аэродром‡Auf zum Flugplatz‡아이언포지 비행장으로‡A la Base Aérea‡A la Base Aérea‡À l\'aérodrome ! Vite !‡前往机场‡前往機場',
    nil,
    'Embarque na Máquina Voadora do Marcos na Pedreira Gol\'Bolar.‡Сядьте на ветролет Мателя в карьере Гол\'Болар.‡Steigt in Mathels Flugmaschine im Steinbruch Gol\'Bolar.‡골볼라 채석장에서 마셀의 비행기를 타야 합니다.‡Embárcate en la máquina voladora de Mathel en la Cantera Gol\'Bolar.‡Embárcate en la máquina voladora de Mathel en la Cantera Gol\'Bolar.‡Prenez place dans la Machine volante de Mathel à la Carrière de Gol’Bolar.‡在古博拉采掘场乘坐马歇尔的飞行器。‡前往古博拉採掘場，搭乘瑪瑟爾的飛行器。',
  }
},
[25999] = {
  {
    'Entrada barrada‡Вход перекрыт‡Schritt für Schritt‡진입로 차단‡Campo de minas‡Campo de minas‡Cordon anti-elfes‡门槛‡進入的障礙',
    nil,
    'Arme 8 "Mata-elfos" de Krom\'gar‡Поставьте 8 кром\'гарских "Убийц эльфов".‡Macht 8 Krom\'gar "Elfentöter" scharf.‡크롬가르 "엘프 처치기" 8개를 재설치해야 합니다.‡Arma 8 "mataelfos" Krom\'gar.‡Arma 8 "mataelfos" Krom\'gar.‡Armez 8 « Tueuses d’elfes » de Krom’gar.‡埋设8个克罗姆加“精灵杀手”。‡武裝8個克羅姆加『精靈殺手』。',
  }
},
[26000] = {
  {
    'Espeleologia‡Спелеологи‡Höhlenforscher‡동굴 탐험‡Espeleología‡Espeleología‡Spéléologie‡洞穴探险‡洞穴探索',
    nil,
    'Fale com Gurrok na Gruta Densanévoa.‡Поговорите с Гурроком в Дымчатом гроте.‡Sprecht mit Gurrok in der Tiefennebelgrotte.‡깊은안개 종유동에 있는 구로크와 대화해야 합니다.‡Habla con Gurrok en Gruta Brumadensa.‡Habla con Gurrok en Gruta Brumadensa.‡Parlez à Gurrok dans la Grotte Brume-épaisse.‡跟重雾洞穴的古罗克谈一谈。‡到深霧岩洞找古爾洛克說話。',
  }
},
[26001] = {
  {
    'O cabumgenheiro desaparecido‡Пропавший взрынженер‡Der vermisste Sprengenieur‡실종된 폭파기술자‡El explosingeniero perdido‡El explosingeniero perdido‡L\'explogénieur manque à l\'appel‡失踪的爆破工程师‡失蹤的爆破工程師',
    nil,
    'Encontre o Cabumgenheiro Sussujo.‡Найдите взрынженера Улюлюка.‡Findet Sprengenieur Fusselpfiff.‡폭파기술자 퍼즈휘슬을 찾아야 합니다.‡Encuentra al explosingeniero Silbapelusa.‡Encuentra al explosingeniero Silbapelusa.‡Retrouvez l’Explogénieur Duvepipeau.‡找到爆破工程师弗兹维塞。‡尋找爆破工程師弗茲威索。',
  }
},
[26002] = {
  {
    'Plano de ataque da Aliança‡План нападения Альянса‡Angriffspläne der Allianz‡얼라이언스 공격 계획서‡Los planes de ataque de la Alianza‡Los planes de ataque de la Alianza‡Les plans d\'attaque de l\'Alliance‡联盟进攻计划书‡聯盟攻擊計畫',
    nil,
    'Consiga o Plano de Ataque da Aliança, em posse da Caçadora Davinia.‡Отнимите план нападения Альянса у охотницы Давинии.‡Erbeutet die Angriffspläne der Allianz von Jägerin Davinia.‡여사냥꾼 다비니아를 처치하고 얼라이언스 공격 계획서를 입수해야 합니다.‡Recupera los planes de ataque de la Alianza de la cazadora Davinia.‡Recupera los planes de ataque de la Alianza de la cazadora Davinia.‡Récupérez les Plans d’attaque de l’Alliance sur la Chasseresse Davinia.‡从女猎手达文尼娅处获得联盟进攻计划书。‡從女獵手戴薇妮娜那裏找到聯盟攻擊計畫。',
  }
},
[26003] = {
  {
    'Lições das Ilhas Perdidas‡Урок с Затерянных островов‡Lehren von den Verlorenen Inseln‡잃어버린 섬의 교훈‡Lecciones de las Islas Perdidas‡Lecciones de las Islas Perdidas‡Souvenir des îles Perdues‡失落群岛的教训‡失落群島的教訓',
    nil,
    'Mate 12 Batedores Darnassianos.‡Убейте 12 дарнасских разведчиков.‡Tötet 12 Späher von Darnassus.‡다르나서스 정찰병 12명을 처치해야 합니다.‡Mata a 12 rastreadores darnassianos.‡Mata a 12 rastreadores darnassianos.‡Tuez 12 Éclaireurs darnassiens.‡杀死12名达纳苏斯斥候。‡殺死12名達納蘇斯斥候。',
  }
},
[26004] = {
  {
    'A Fortaleza Krom\'gar‡Крепость Кром\'гар‡Feste Krom\'gar‡크롬가르 요새‡La Fortaleza Krom\'gar‡La Fortaleza Krom\'gar‡La forteresse de Krom\'gar‡克罗姆加壁垒‡克羅姆加堡壘',
    nil,
    'Entregue o Plano de Ataque da Aliança ao Suserano Krom\'gar na Fortaleza Krom\'gar, que fica na Cordilheira das Torres de Pedra.‡Доставьте план нападения Альянса властителю Кром\'гару в крепость Кром\'гар в Когтистых горах.‡Bringt die Angriffspläne der Allianz zu Oberanführer Krom\'gar in der Feste Krom\'gar im Steinkrallengebirge.‡돌발톱 산맥의 크롬가르 요새에 있는 대군주 크롬가르에게 얼라이언스 공격 계획서를 전달해야 합니다.‡Entrega los planes de ataque de la Alianza al señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Entrega los planes de ataque de la Alianza al señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Remettez les Plans d’attaque de l’Alliance au Suzerain Krom’gar dans la Forteresse de Krom’gar, dans les Serres-Rocheuses.‡将联盟进攻计划书呈给石爪山脉克罗姆加壁垒的克罗姆加大王。‡將聯盟攻擊計畫帶去石爪山脈的克羅姆加堡壘，交給霸主克羅姆加。',
  }
},
[26005] = {
  {
    'Finalmente ar puro‡Глоток свежего воздуха‡Ein Hauch frischer Luft‡신선한 공기 한 모금‡Una bocanada de aire fresco‡Una bocanada de aire fresco‡Une bouffée d\'air frais‡一口新鲜空气‡一絲新鮮空氣',
    nil,
    'Encontre o Capitão Taylor no Castelo de Voldrin, na superfície acima das Ruínas de Vashj\'ir.‡Найдите капитана Тейлора на борту "Крепости Волдрина" в море над Руинами Вайш\'ира.‡Findet Kapitän Taylor auf der Voldrins Mut an der Oberfläche über den Ruinen von Vashj\'ir.‡바쉬르 폐허 위에 있는 볼드린의 장악호에서 부대장 테일러를 만나야 합니다.‡Busca al capitán Taylor a bordo del Bastión de Voldrin, atracado en la superficie encima de las Ruinas de Vashj\'ir.‡Busca al capitán Taylor a bordo del Bastión de Voldrin, atracado en la superficie encima de las Ruinas de Vashj\'ir.‡Retrouvez le Capitaine Taylor à bord du Bastion de Voldrin, à la verticale des Ruines de Vashj’ir.‡去找停泊在瓦丝琪尔废墟海面上沃德林之拥号的泰勒上尉。‡在瓦許伊爾廢墟水面之上的佛德林堡號找到泰勒隊長。',
  }
},
[26006] = {
  {
    'Finalmente ar puro‡Глоток свежего воздуха‡Ein Hauch frischer Luft‡신선한 공기 한 모금‡Una bocanada de aire fresco‡Una bocanada de aire fresco‡Une bouffée d\'air frais‡一口新鲜空气‡一絲新鮮空氣',
    nil,
    'Encontre o Legionário Nazgrim a bordo da Recompensa Estígia na superfície acima das Ruínas de Vashj\'ir.‡Разыщите легионера Назгрима на борту "Стигийской Награды" в море над Руинами Вайш\'ира.‡Findet Legionär Nazgrim auf der Höllenjuwel an der Oberfläche über den Ruinen von Vashj\'ir.‡바쉬르 폐허 위에 떠 있는 저승의 자비호에서 부관 나즈그림을 만나야 합니다.‡Busca al legionario Nazgrim a bordo del Recompensa Estigia, atracado en la superficie encima de las Ruinas de Vashj\'ir.‡Busca al legionario Nazgrim a bordo del Recompensa Estigia, atracado en la superficie encima de las Ruinas de Vashj\'ir.‡Retrouvez le Légionnaire Nazgrim à bord du Bonnet stygien, à la verticale des Ruines de Vashj’ir.‡去找停泊在瓦丝琪尔废墟海面上冥河恩赐号的军团士兵纳兹戈林。‡在瓦許伊爾廢墟水面之上的冥河賞金號找到軍團士兵納茲格寧姆。',
  }
},
[26007] = {
  {
    'Relato de missão‡Отчет‡Befragung‡임무 보고‡Informe‡Informe‡Débriefing‡最后的汇报‡聽取報告',
    nil,
    'Fale com Gurrok sobre a missão dele.‡Поговорите с Гурроком и узнайте все, что с ним произошло.‡Sprecht mit Gurrok und erfahrt etwas über seine Tortur.‡구로크와 대화하여 그가 무슨 일을 겪었는지 들어야 합니다.‡Habla con Gurrok y entérate de su terrible experiencia.‡Habla con Gurrok y entérate de su terrible experiencia.‡Parlez à Gurrok et faites-lui raconter l’épreuve qu’il a traversée.‡听古罗克讲述他经历的种种磨难。‡和古爾洛克談話以得知他所經歷的一切。',
  }
},
[26008] = {
  {
    'Descompressão‡Декомпрессия‡Druckabbau‡수압 적응‡Descompresión‡Descompresión‡Décompression‡减压‡減壓',
    nil,
    'Use a Pedra da Respiração de Moana em 10 Guerreiros Aprisionados na Amarra.‡Воспользуйтесь камнем дыхания Моаны, чтобы выручить 10 пленных воинов на Жемчужной ферме.‡Benutzt Moanahs Atemstein an 10 eingekerkerten Kriegern in der Umklammerung.‡모아나의 호흡석을 구속의 손아귀에 갇힌 전사 10명에게 사용해야 합니다.‡Usa la piedra de aliento de Moanah en 10 guerreros encarcelados en El Encierro.‡Usa la piedra de aliento de Moanah en 10 guerreros encarcelados en El Encierro.‡Utilisez la Pierre de souffle de Moanah sur 10 Guerriers emprisonnés dans lÉtreinte.‡对关押所的被禁锢的战士使用莫安纳的气息之石，搭救10名战士。‡將摩亞那的氣浮石用在窩巢裡10名被囚禁的戰士。',
  }
},
[26009] = {
  {
    'Busque e destrua‡Найти и уничтожить‡Suchen und Zerstören‡수색과 파괴‡Busca y destruye‡Busca y destruye‡Chercher et détruire‡寻找并摧毁‡索敵消滅',
    nil,
    'Mate quaisquer 20 soldados da Aliança na Cordilheira das Torres de Pedra.‡Убейте 20 солдат Альянса в Когтистых горах.‡Tötet 20 beliebige Soldaten der Allianz im Steinkrallengebirge.‡돌발톱 산맥에서 종류에 관계없이 얼라이언스 병사 20명을 처치해야 합니다.‡Mata a 20 soldados de la Alianza cualesquiera en Sierra Espolón.‡Mata a 20 soldados de la Alianza cualesquiera en Sierra Espolón.‡Tuez 20 soldats de l’Alliance de n’importe quel type, dans les Serres-Rocheuses.‡杀死石爪山脉的20名联盟士兵。‡到石爪山脈去殺死任意20名聯盟士兵。',
  }
},
[26010] = {
  {
    'Do pó ao pó‡Прах к праху‡Asche zu Asche‡몽땅 재로‡Cenizas a las cenizas‡Cenizas a las cenizas‡Tu es poussière…‡尘归尘，土归土‡塵歸塵',
    nil,
    'Use o Lança-chamas de Krom\'gar para destruir 8 Tendas da Guardanorte.‡Используйте кром\'гарский огнемет, чтобы уничтожить 8 палаток Северной Стражи.‡Zerstört 8 Zelte der Nordwacht mit Krom\'gars Flammenwerfer.‡크롬가르 화염방사기를 사용하여 북부감시 막사 8개를 파괴해야 합니다.‡Utiliza el lanzallamas Krom\'gar para destruir 8 tiendas de Fuerte del Norte.‡Utiliza el lanzallamas Krom\'gar para destruir 8 tiendas de Fuerte del Norte.‡Utilisez le Lance-flammes de Krom’gar pour détruire 8 Tentes du Guet-du-Nord.‡使用克罗姆加火焰喷射器摧毁8座北方城堡帐篷。‡使用克羅姆加火焰噴射器摧毀8座北方帳篷。',
  }
},
[26011] = {
  {
    'Inimigo da Horda: marechal Paltrow‡Враг Орды: маршал Полтроу‡Feind der Horde: Marschall Paltrow‡호드의 적: 작전사령관 팰트로‡Enemigo de la Horda: Alguacil Paltrow‡Enemigo de la Horda: Alguacil Paltrow‡Ennemi de la Horde : le maréchal Paltrow‡部落的敌人：帕特劳元帅‡部落之敵:帕爾特洛元帥',
    nil,
    'Mate o Marechal Paltrow.‡Убейте маршала Полтроу.‡Tötet Marschall Paltrow.‡작전사령관 팰트로를 처치해야 합니다.‡Mata al alguacil Paltrow.‡Mata al alguacil Paltrow.‡Tuez le Maréchal Paltrow.‡杀死帕特劳元帅。‡殺死帕爾特洛元帥。',
  }
},
[26012] = {
  {
    'Bafafá no repouso‡Беда в храме Драконьего Покоя‡Ärger im Wyrmruhtempel‡고룡쉼터의 골칫거리‡Problemas en Reposo del Dragón‡Problemas en Reposo del Dragón‡Troubles au Repos du ver‡龙眠之灾‡龍眠神殿的麻煩',
    nil,
    'Fale com Krasus no Templo do Repouso das Serpes, que fica no Ermo das Serpes.‡Поговорите с Красом в храме Драконьего Покоя, что в Драконьем Погосте.‡Sprecht mit Krasus im Wyrmruhtempel in der Drachenöde.‡용의 안식처에 있는 고룡쉼터 사원에서 크라서스와 대화해야 합니다.‡Habla con Krasus en el Templo del Reposo del Dragón en el Cementerio de Dragones.‡Habla con Krasus en el Templo del Reposo del Dragón en el Cementerio de Dragones.‡Parlez à Krasus, au Temple du Repos du ver, dans la Désolation des dragons.‡前往龙骨荒野，和龙眠神殿中的克拉苏斯交谈。‡到龍骨荒野的龍眠神殿找卡薩斯談談。',
  }
},
[26013] = {
  {
    'Ataque ao santuário‡Нападение на святилище‡Angriff auf das Sanktum‡공격받은 성소‡Asalto al Sagrario‡Asalto al Sagrario‡Assaut sur le sanctum‡突袭红玉圣殿‡對聖所的攻擊',
    nil,
    'Investigue o Santuário Rubi, embaixo do Templo do Repouso das Serpes.‡Осмотрите Рубиновое святилище под храмом Драконьего Покоя.‡Untersucht das Rubinsanktum unterhalb des Wyrmruhtempels.‡고룡쉼터 사원 아래에 있는 루비 성소를 조사해야 합니다.‡Investiga el Sagrario Rubí bajo el Templo del Reposo del Dragón.‡Investiga el Sagrario Rubí bajo el Templo del Reposo del Dragón.‡Menez une enquête au Sanctum Rubis, sous le Temple du Repos du ver.‡调查龙眠神殿之下的红玉圣殿。‡調查龍眠神殿下的晶紅神殿。',
  }
},
[26014] = {
  {
    'Os irmãos Cavaclave‡Братья Ройпой‡Die Gebrüder Grabungslied‡디그송 형제‡Los hermanos Buenacanción‡Los hermanos Buenacanción‡Les frères Chante-fouilles‡掘歌兄弟‡掘曲兄弟',
    nil,
    'Apresente-se a Humberto Cavaclave na Garganta Telúmina, que fica em Vashj\'ir.‡Поговорите с Хамфри Ройпоем в Затемненной впадине в Вайш\'ире.‡Meldet Euch bei Humphrey Grabungslied in der Tiefenlichtkluft in Vashj\'ir.‡바쉬르의 미명 협곡에 있는 험프리 디그송에게 보고해야 합니다.‡Informa a Humphrey Buenacanción en el cañón Sondaluz, en Vashj\'ir.‡Informa a Humphrey Buenacanción en el cañón Sondaluz, en Vashj\'ir.‡Présentez-vous à Humphrey Chante-fouilles au Canyon de Terradiance, en Vashj’ir.‡前往瓦丝琪尔的光渊海峡，向哈弗雷·掘歌报到。‡到瓦許伊爾的光底峽谷去向韓福瑞·掘曲回報。',
  }
},
[26015] = {
  {
    'Caça fosforescente‡Охота за фосфориями‡Phosphorajagd‡자체 발광 사냥‡Caza de fósfora‡Caza de fósfora‡Chasse au phosphore‡收集粘液‡獵捕磷液',
    nil,
    'Obtenha 6 amostras de Fósforo Telúmino de Caranguejos Fogaça e Garoupas Luxescala na Garganta Telúmina.‡Добудьте 6 люминесцентных фосфорий из огнепанцирных крабов и блестящих окуней в Затемненной впадине.‡Besorgt Euch 6 Tiefenlichtphosphora von den Pyropanzerkrabblern und Luxschuppenbarschen in der Tiefenlichtkluft.‡미명 협곡에 있는 장작껍질게와 형광비늘농어에게서 미명 인광물질 6개를 입수해야 합니다.‡Obtén 6 fósforas Sondaluz de hundidores Piroconcha y meros Escama Luminosa en el Cañón Sondaluz.‡Obtén 6 fósforas Sondaluz de hundidores Piroconcha y meros Escama Luminosa en el Cañón Sondaluz.‡Obtenez 6 doses de Phosphore terradiance sur des Carapateurs pyrocoques et des Mérous luxécailles, dans le Canyon de Terradiance.‡从光渊海峡的赤壳凿孔蟹和光鳞石斑鱼身上收集6份冷光粘液。‡到光底峽谷去，從炎殼蟹與華鱗石斑魚身上取得6份光底磷液。',
  }
},
[26016] = {
  {
    'Ordens da Base da Expedição‡Распоряжения из главного лагеря‡Befehle aus dem Basislager‡기지에서 보낸 명령서‡Órdenes del campamento base‡Órdenes del campamento base‡Les ordres du camp de base‡营地发来的命令‡來自營地的命令',
    nil,
    'Repasse as Ordens do Acampamento-base ao Suserano Krom\'gar na Fortaleza Krom\'gar, que fica na Cordilheira das Torres de Pedra.‡Доставьте распоряжения из главного лагеря властителю Кром\'гару в крепость Кром\'гар в Когтистые горы.‡Bringt die Befehle des Stützpunkts zu Oberanführer Krom\'gar in der Feste Krom\'gar im Steinkrallengebirge.‡돌발톱 산맥의 크롬가르 요새에 있는 대군주 크롬가르에게 기지에서 보낸 명령서를 가져가야 합니다.‡Entrega las órdenes del Campamento Base al señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Entrega las órdenes del Campamento Base al señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Remettez les Ordres du camp de base au Suzerain Krom’gar à la Forteresse de Krom’gar, dans les Serres-Rocheuses.‡将营地发来的命令交给石爪山脉克罗姆加壁垒的克罗姆加大王。‡將來自營地的命令帶去石爪山脈的克羅姆加堡壘，交給霸主克羅姆加。',
  }
},
[26017] = {
  {
    'Uma isca‡Приманка‡Ein Köder‡미끼‡Un cebo‡Un cebo‡Un appât‡诱饵‡一個誘餌',
    nil,
    'Coloque a Fedora Fosforescente e, em seguida, nade pelas algas na Garganta Telúmina para atrair 30 Mordiscadores Telúminos.‡Наденьте светошляпу и проплывите через заросли водорослей в Затемненной впадине, чтобы привлечь 30 люминесцентных гирелл.‡Setzt die Phosphorafedora auf und schwimmt durch die Korallen in der Tiefenlichtkluft, um 30 Tiefenlichtknabberfische anzulocken.‡인광성 중절모를 쓰고, 미명 협곡의 산호 사이를 수영하여 미명 야금치 30마리를 유인해야 합니다.‡Ponte la fedora fósfora y nada a través del coral en el Cañón Sondaluz para atraer a 30 mordisqueadores de Sondaluz.‡Ponte la fedora fósfora y nada a través del coral en el Cañón Sondaluz para atraer a 30 mordisqueadores de Sondaluz.‡Mettez le Chapeau mou phosphoré, puis nagez dans le corail du Canyon de Terradiance pour attirer 30 Grignoteurs de Terradiance.‡戴上磷光软帽，游过光渊海峡的海藻丛，吸引30条光渊利齿鱼。‡戴上磷光軟呢帽，然後游過光底峽谷裡的海藻以吸引30隻光底啃咬者。',
  }
},
[26018] = {
  {
    'Apagando a luz fria‡Смерть Холодному Сиянию‡Licht aus für die Tiefenlichter‡멀록 수중 탐구‡Apagando luces frías‡Apagando luces frías‡Qui a éteint les Froide-lumière ?‡猎杀寒光鱼人‡探索冷光',
    nil,
    'Mate 4 Caçadores de Luz Fria e 4 Oráculos de Luz Fria.‡Убейте 4 охотников Холодного Сияния и 4 оракулов Холодного Сияния.‡Tötet 4 Tiefenlichtjäger und 4 Tiefenlichtorakel.‡시린빛 사냥꾼 4마리와 시린빛 점쟁이 4마리를 처치해야 합니다.‡Mata a 4 cazadores Luz Fría y a 4 oráculos Luz Fría.‡Mata a 4 cazadores Luz Fría y a 4 oráculos Luz Fría.‡Tuez 4 Chasseurs et 4 Oracles froide-lumière.‡杀死4个寒光猎手和4个寒光智者。‡殺死4個冷光獵手和4個冷光神諭者。',
  }
},
[26019] = {
  {
    'Ovo gigante de enguia‡Огромная икринка угря‡Enormes Aalei‡거대한 뱀장어 알‡Huevo de anguila enorme‡Huevo de anguila enorme‡L\'énorme œuf d\'anguille‡巨大的鳗鱼卵‡巨鰻卵',
    nil,
    'Entregue o Ovo Gigante de Enguia para Humberto Cavaclave no fundo da Garganta Telúmina, que fica em Vashj\'ir.‡Отнесите огромную икринку угря Хамфри Ройпою на дно Затемненной впадины в Вайш\'ире.‡Bringt das enorme Aalei zu Humphrey Grabungslied am Grund der Tiefenlichtkluft in Vashj\'ir.‡바쉬르의 미명 협곡 바닥에 있는 험프리 디그송에게 거대한 뱀장어 알을 가져가야 합니다.‡Entrega el huevo de anguila enorme a Humphrey Buenacanción en el fondo del Cañón Sondaluz, en Vashj\'ir.‡Entrega el huevo de anguila enorme a Humphrey Buenacanción en el fondo del Cañón Sondaluz, en Vashj\'ir.‡Remettez l’Énorme œuf d’anguille à Humphrey Chante-fouilles au fond du Canyon de Terradiance, en Vashj’ir.‡将巨大的鳗鱼卵交给瓦丝琪尔光渊海峡底部的哈弗雷·掘歌。‡將巨鰻卵帶去瓦許伊爾的冷光裂口給韓福瑞·掘曲。',
  }
},
[26020] = {
  {
    'Apresente-se a Bombatripa‡В распоряжение Бомбиглотс‡Meldet Euch bei Bombgutz‡봄거츠에게 보고‡Informa a Tripasbomba‡Informa a Tripasbomba‡Allez voir Bombetripes‡去找邦姆古兹‡向炸彈格茲回報',
    nil,
    'Apresente-se à Cabumgenheira-chefe Bombatripa na Fortaleza Krom\'gar, que fica na Cordilheira das Torres de Pedra.‡Поступите в распоряжение взрынженера Бомбиглотc в крепости Кром\'гар в Когтистых горах.‡Meldet Euch bei Obersprengenieurin Bombgutz in der Feste Krom\'gar im Steinkrallengebirge.‡돌발톱 산맥의 크롬가르 요새에 있는 선임 폭파기술자 봄거츠에게 보고해야 합니다.‡Preséntate ante la explosingeniera jefe Tripasbomba en la Fortaleza Krom\'gar, en Sierra Espolón.‡Preséntate ante la explosingeniera jefe Tripasbomba en la Fortaleza Krom\'gar, en Sierra Espolón.‡Allez parler à l’explogénieur en chef Bombetripes à la Forteresse de Krom’gar, dans les Serres-Rocheuses.‡去找石爪山脉克罗姆加壁垒的首席爆破工程师邦姆古兹。‡到石爪山脈的克羅姆加堡壘，向首席爆破工程師炸彈格茲回報。',
  }
},
[26021] = {
  {
    'Os irmãos Cavaclave 2: omelete de ovo de enguia‡Братья Ройпой – 2: фокус с икринкой угря‡Die Gebrüder Grabungslied Teil 2: Der Eier-Aal-Trick-Blues‡디그송 형제 2: 분노의 알 폭탄‡Los hermanos Buenacanción 2: El Retorno del Huevo‡Los hermanos Buenacanción 2: El Retorno del Huevo‡Les frères Chante-fouilles 2 : omelette explosive‡掘歌兄弟2：鳗鱼卵大爆炸‡掘曲兄弟之二:鰻蛋詭計搖擺舞',
    nil,
    'Use o Dispositivo Enguiexplosivo perto de uma Grandenguia Tortuosa na Garganta Telúmina. Em seguida, derrote a Grandenguia Enfraquecida.‡При помощи угретонатора взорвите ужасного огромного угря в Затемненной впадине, а затем добейте раненого угря.‡Benutzt das aal-splosive Gerät in der Nähe eines verschlagenen Großaals in der Tiefenlichtkluft und besiegt dann den geschwächten Großaal.‡미명 협곡의 약삭빠른 왕뱀장어 근처에서 뱀장어 철퍽폭파 장치를 사용한 다음, 약해진 왕뱀장어를 처치해야 합니다.‡Usa el dispositivo anguilexplosivo cerca de una gran anguila taimada en el Cañón Sondaluz. Después, derrota a la gran anguila debilitada.‡Usa el dispositivo anguilexplosivo cerca de una gran anguila taimada en el Cañón Sondaluz. Después, derrota a la gran anguila debilitada.‡Utilisez l’Œuf d’anguille explosif près d’une Grande anguille sournoise dans le Canyon de Terradiance, puis achevez la Grande anguille affaiblie.‡在光渊海峡的扭曲的巨海鳗附近使用鳗鱼爆破装置，然后击败被削弱的巨海鳗。‡到冷光裂口去，在一隻狡詐的巨鰻附近使用鰻魚爆炸裝置，然後擊敗衰弱的巨鰻。',
  }
},
[26022] = {
  {
    'Primeira gota‡Первая кровь‡Das erste Blut‡첫 번째 피‡La primera, en la frente‡La primera, en la frente‡Verser le premier sang‡第一滴血‡第一滴血',
    nil,
    'Consiga 10 Amuletos de Pedra-sangrenta de membros da Camarilha.‡Убейте наемников Синдиката и соберите 10 амулетов из кровавого камня.‡Erbeutet 10 Blutsteinamulette von Mitgliedern des Syndikats.‡비밀결사대 대원에게서 혈석 아뮬렛 10개를 모아야 합니다.‡Consigue 10 amuletos de sangrita de mercenarios de la Hermandad.‡Consigue 10 amuletos de sangrita de mercenarios de la Hermandad.‡Rassemblez 10 Amulettes de pierre de sang en tuant des membres du Syndicat.‡从辛迪加雇佣兵身上获得10根血石护符。‡從辛迪加的成員那裡收集10條血石護符。',
  }
},
[26023] = {
  {
    'O Matatroll Renegado‡Отрекшийся Троллебой‡Der Trollbann der Verlassenen‡포세이큰 트롤베인‡El Aterratrols renegado‡El Aterratrols renegado‡Trollemort le Réprouvé‡被遗忘的托尔贝恩‡被遺忘的托爾貝恩',
    nil,
    'Fale com Galen Matatroll.‡Поговорите с Галеном Троллебоем.‡Sprecht mit Galen Trollbann.‡갈렌 트롤베인과 대화해야 합니다.‡Habla con Galen Aterratrols.‡Habla con Galen Aterratrols.‡Parlez à Galen Trollemort.‡跟加林·托尔贝恩谈一谈。‡和加林·托爾貝恩說話。',
  }
},
[26024] = {
  {
    'Procura-se: Marez Capucho‡Разыскивается: Марез Клобук‡GESUCHT: Marez Schattenkutte‡마레즈 코울 현상 수배!‡Se busca: Marez Cogulla‡Se busca: Marez Cogulla‡On recherche : Marez Capuche‡通缉！玛雷兹·考尔‡通緝:瑪雷茲‧考爾',
    nil,
    'Entregue a Cabeça de Marez para a Capitã Nélia na Ponta do Refúgio.‡Принесите голову Марез капитану Ниалс в Опорный пункт.‡Bringt Marez\' Kopf zu Hauptmann Nials bei der Zuflucht.‡마레즈를 처치하고 그 증거로 그녀의 머리카락을 임시 주둔지에 있는 부대장 나이얼스에게 가져가야 합니다.‡Llévale la cabeza de Marez a la capitana Nials en el Refugio de la Zaga.‡Llévale la cabeza de Marez a la capitana Nials en el Refugio de la Zaga.‡Apportez la Tête de Marez au Capitaine Nials, au Refuge de l\'Ornière.‡把玛雷兹的徽记交给避难谷地的尼艾丝队长。‡把瑪雷茲的頭顱交給避難谷地的尼艾絲隊長。',
  }
},
[26025] = {
  {
    'A orquisa traidora‡Орк изменник‡Der verräterische Orc‡배신자 오크‡El orco traidor‡El orco traidor‡L\'orc félon‡兽人叛徒‡獸人叛徒',
    nil,
    'Pegue o Orbe de Pedra-sangrenta Conspurcado de Marez Capucho.‡Найдите оскверненную сферу из кровавого камня Марез Клобук.‡Erbeutet Marez Schattenkuttes beschmutzte Blutsteinkugel.‡마레즈 코울의 더럽혀진 혈석 수정구를 되찾아야 합니다.‡Recupera el orbe de sangrita contaminada de Marez Cogulla.‡Recupera el orbe de sangrita contaminada de Marez Cogulla.‡Récupérez l’Orbe de pierre de sang souillé de Marez Capuche.‡取回玛雷兹·考尔的邪恶的血石宝珠。‡取得瑪雷茲‧考爾的邪惡的血石寶珠。',
  }
},
[26026] = {
  {
    'Sonhe com um futuro melhor‡Мечта о будущем‡Traum von einer besseren Zukunft‡더 나은 미래의 꿈‡Soñar con un futuro mejor‡Soñar con un futuro mejor‡Des lendemains qui chantent‡明天会更好‡夢想更美好的明天',
    nil,
    'Recupere o Aparato de Guerra BD-816, o Fogo Mecanizado, o Gelo Mecanizado e o Ar Mecanizado.‡Добудьте машину войны БА-64, механизированный огонь, механизированный лед и механизированный воздух.‡Bergt die BD-816 Kriegsmaschine, das mechanisierte Feuer, das mechanisierte Eis und die mechanisierte Luft.‡BD-816 전쟁 장비, 기계화 불, 기계화 얼음, 기계화 공기를 입수해야 합니다.‡Recupera el aparato de guerra BD-816, el fuego mecanizado, el hielo mecanizado y el aire mecanizado.‡Recupera el aparato de guerra BD-816, el fuego mecanizado, el hielo mecanizado y el aire mecanizado.‡Retrouvez l’Appareil de guerre BD-816, le Feu, la Glace et l’Air mécanisés.‡找到BD-816战斗仪器、机械火焰、机械之冰和机械空气。‡找回BD-816戰鬥控制裝置、火焰機械裝置、冰凍機械裝置以及風力機械裝置。',
  }
},
[26027] = {
  {
    'Chamado às armas‡Призыв к оружию‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡L\'appel aux armes‡战斗的号召‡短兵相接',
    nil,
    'Mate 7 Xamãs Punho de Pedra e 3 Senhores dos Punho de Pedra em Stromgarde.‡Убейте 7 шаманов из клана Тяжелого Кулака и 3 вождей клана Тяжелого Кулака.‡Tötet 7 Schamanen der Felsfäuste und 3 Lords der Felsfäuste in Stromgarde.‡스트롬가드에 있는 돌주먹 주술사 7마리와 돌주먹 우두머리 3마리를 처치해야 합니다.‡Mata a 7 chamanes Puño de Roca y a 3 señores Puño de Roca en Stromgarde.‡Mata a 7 chamanes Puño de Roca y a 3 señores Puño de Roca en Stromgarde.‡Tuez 7 Chamans et 3 Seigneurs rochepoings à Stromgarde.‡杀死激流堡的7个石拳萨满祭司和3个石拳领主。‡在激流堡中殺死7名石拳薩滿和3名石拳領主。',
  }
},
[26028] = {
  {
    'O passeio radical do Sr. P‡Дикая охота господина З. П.‡Herr Rosies wilder Ritt‡달려라, 오빠씨‡El alucinante viaje del Sr. D‡El alucinante viaje del Sr. D‡La chevauchée fantastique de monsieur C.‡气泡先生的狂野之旅‡老爹大暴走',
    nil,
    'Mate 20 Engenheiros Gnomos e 5 Bate-estacas Gnômicos‡Убейте 20 гномских инженеров и 5 гномских патрульных.‡Tötet 20 Gnomingenieure und 5 Gnomklopfer.‡노움 기술자 20명을 처치하고 노움 난타로봇 5대를 파괴해야 합니다.‡Mata a 20 ingenieros gnomos y a 5 aporreadores gnomos.‡Mata a 20 ingenieros gnomos y a 5 aporreadores gnomos.‡Tuez 20 Ingénieurs gnomes et 5 Marteleurs gnomebots.‡击败20名侏儒工程师和5名侏儒重拳机兵。‡消滅20名地精工程師以及5台地精機械搗碎機。',
  }
},
[26029] = {
  {
    'A ameaça real‡Настоящая угроза‡Die echte Bedrohung‡거대한 위협‡Una auténtica amenaza‡Una auténtica amenaza‡La véritable menace‡真正的威胁‡真正的威脅',
    nil,
    'Mate Or\'Kalar e arranque a cabeça dele.‡Убейте Ор\'Калара и заберите его голову.‡Tötet Or\'Kalar und nehmt seinen Kopf.‡오르칼라를 처치하고 그 증거로 그의 머리카락을 획득해야 합니다.‡Mata a Or\'Kalar y consigue su cabeza.‡Mata a Or\'Kalar y consigue su cabeza.‡Massacrez Or’Kalar et prenez sa tête.‡杀死奥卡拉尔，拿下他的徽记。‡殺死奧卡拉爾並取得他的頭顱。',
  }
},
[26030] = {
  {
    'Signo de Strom‡Печать Строма‡Siegelzeichen von Strom‡스트롬의 인장‡El sigilo de Strom‡El sigilo de Strom‡Le cachet de Strom‡激流堡符印‡激流堡符印',
    nil,
    'Consiga o Signo de Strom dos membros da Camarilha na Bastilha de Stromgarde.‡Заберите печать Строма у членов Синдиката в крепости Стромгард.‡Erhaltet das Siegelzeichen von Strom von den Mitgliedern des Syndikats in Burg Stromgarde.‡스트롬가드 요새에 있는 비밀결사대 일당에게서 스트롬의 인장을 획득해야 합니다.‡Consigue el sigilo de Strom de los miembros de la Hermandad en el Castillo de Stromgarde.‡Consigue el sigilo de Strom de los miembros de la Hermandad en el Castillo de Stromgarde.‡Récupérez le Cachet de Strom sur le cadavre d’un membre du Syndicat au Donjon de Stromgarde.‡从激流堡的辛迪加组织成员手中获得激流堡符印。‡從激流堡中的辛迪加成員身上取得激流堡符印。',
  }
},
[26031] = {
  {
    'Signo de Thoradin‡Печать Торадина‡Siegelzeichen des Thoradin‡소라딘의 인장‡El sigilo de Thoradin‡El sigilo de Thoradin‡Le cachet de Thoradin‡索拉丁符印‡索拉丁符印',
    nil,
    'Consiga 5 Fragmentos de Signo dos defensores de Stromgarde, na Bastilha de Stromgarde.‡Соберите 5 фрагментов печати, убив стромгардских защитников в крепости Стромгард.‡Erbeutet 5 Siegelzeichenfragmente von Vollstreckern von Stromgarde in Burg Stromgarde.‡스트롬가드 요새의 스트롬가드 수호병을 처치하고 인장 조각 5개를 모아야 합니다.‡Recupera los 5 trozos de sigilo de los defensores de Stromgarde en el Castillo de Stromgarde.‡Recupera los 5 trozos de sigilo de los defensores de Stromgarde en el Castillo de Stromgarde.‡Récoltez 5 Fragments de cachet sur les cadavres des défenseurs de Stromgarde, au Donjon de Stromgarde.‡从激流堡的激流堡防御者身上收集5块符印碎片。‡從激流堡中的激流堡防衛者身上收集5個符印碎片。',
  }
},
[26032] = {
  {
    'Signo de Arathor‡Печать Аратора‡Siegelzeichen von Arathor‡아라소르의 인장‡El sigilo de Arathor‡El sigilo de Arathor‡Le cachet d\'Arathor‡阿拉索符印‡阿拉索符印',
    nil,
    'Consiga o Signo de Arathor do Tenente Clamabravo.‡Заберите печать Аратора у лейтенанта Храброгласа.‡Nehmt Leutnant Heldenruf das Siegelzeichen von Arathor ab.‡부관 밸러콜에게서 아라소르의 인장을 획득해야 합니다.‡Consigue el sigilo de Arathor del teniente Valeroso.‡Consigue el sigilo de Arathor del teniente Valeroso.‡Récupérez le Cachet d’Arathor sur le cadavre du Lieutenant Vaillehuche.‡从瓦罗卡尔中尉身上取回阿拉索符印。‡從瓦羅卡爾中尉那裡取得阿拉索符印。',
  }
},
[26033] = {
  {
    'Trol\'kalar‡Трол\'калар‡Trol\'kalar‡트롤칼라‡Trol\'kalar‡Trol\'kalar‡Trol\'kalar‡托卡拉尔‡托卡拉爾',
    nil,
    'Recupere Trol\'kalar de dentro da tumba de Matatroll, na Bastilha de Stromgarde.‡Достаньте Трол\'калар из могилы Троллебоя в Стромгарде.‡Bergt Trol\'kalar aus Trollbanns Grabmal in Burg Stromgarde.‡스트롬가드 요새의 트롤베인의 무덤에 있는 트롤칼라를 회수해야 합니다.‡Recupera Trol\'kalar de la Tumba de Aterratrols en el Castillo de Stromgarde.‡Recupera Trol\'kalar de la Tumba de Aterratrols en el Castillo de Stromgarde.‡Récupérez Trol’kalar dans le Tombeau de Trollemort, au Donjon de Stromgarde.‡从激流堡的托尔贝恩墓室中取回托卡拉尔剑。‡從激流堡的托爾貝恩墓穴中取得托卡拉爾。',
  }
},
[26034] = {
  {
    'O destruidor do crepúsculo‡Сумеречный разрушитель‡Der Zwielichtzerstörer‡황혼의 파괴자‡El Destructor del Crepúsculo‡El Destructor del Crepúsculo‡Le destructeur du Crépuscule‡暮光毁灭者‡暮光毀滅者',
    nil,
    'Derrote Halion e rechace a invasão do Santuário Rubi.‡Победите Халиона и отразите нападение на Рубиновое святилище.‡Besiegt Halion und drängt die Invasion des Rubinsanktums zurück.‡할리온을 처치하고 루비 성소 습격자들을 물리쳐야 합니다.‡Derrota a Halion y repele la invasión del Sagrario Rubí.‡Derrota a Halion y repele la invasión del Sagrario Rubí.‡Détruisez Halion et repoussez les envahisseurs qui ont investi le Sanctum Rubis.‡击败海里昂和入侵红玉圣殿的敌人。‡擊敗海萊恩並擊退對晶紅聖所的入侵。',
  }
},
[26035] = {
  {
    'Isto vale ouro‡На вес золота‡Sein Gewicht in Gold‡마법 재료 구하기‡Valer su peso en oro‡Valer su peso en oro‡Valoir son poids en or‡证明实力‡證明實力',
    nil,
    'Consiga 10 Presas de Cascasseca e 4 Bolsas Medicinais de Cascasseca dos Trolls Cascasseca.‡Соберите 10 клыков троллей из племени Сухокожих и 4 лекарские сумки племени Сухокожих.‡Erbeutet 10 Hauer der Bleichborken und 4 Medizinbeutel der Bleichborken von Trollen der Bleichborken.‡마른나무껍질 트롤에게서 마른나무껍질 엄니 10개, 마른나무껍질 약초 주머니 4개를 모아야 합니다.‡Consigue 10 colmillos Secacorteza y 4 faltriqueras de medicina Secacorteza de los trols Secacorteza.‡Consigue 10 colmillos Secacorteza y 4 faltriqueras de medicina Secacorteza de los trols Secacorteza.‡Obtenez 10 Défenses de Fanécorce et 4 Bourses-médecine de Fanécorce sur des Trolls fanécorces.‡从枯木巨魔身上获得10颗枯木巨魔的獠牙以及4包枯木巨魔的医药包。‡從枯木食人妖身上收集10份枯木食人妖的獠牙和4份枯木食人妖的醫藥包。',
  }
},
[26036] = {
  {
    'Entre a varinha e a espada‡Оружие получше кулаков‡Zauberstab gegen Faust‡마법지팡이 회수‡Empuñar la varita‡Empuñar la varita‡La baguette au poing‡特雷莱恩的符咒魔杖‡特雷萊恩的符咒魔杖',
    nil,
    'Encontre a Varinha de Evocação de Trelane e devolva-a para Rodapeh, na Ponta do Refúgio.‡Найдите заклинательный жезл Трелана и принесите его Скуэрто в Опорный пункт.‡Sucht Trelanes Zauberstab der Herbeirufung und bringt ihn Skuerto bei der Zuflucht.‡트렐레인의 마법지팡이를 찾아 임시 주둔지에 있는 스쿼토에게 가져가야 합니다.‡Encuentra la varita de evocación de Trelane y llévasela a Skuerto en el Refugio de la Zaga.‡Encuentra la varita de evocación de Trelane y llévasela a Skuerto en el Refugio de la Zaga.‡Trouvez la Baguette d’invocation de Trelane et rapportez-la à Skuerto au Refuge de l’Ornière.‡帮避难谷地的斯奎尔图找到特雷莱恩的符咒魔杖，并把它带回来。‡找到特雷萊恩的符咒魔杖並交還給避難谷地的斯奎爾圖。',
  }
},
[26037] = {
  {
    'Defesas de Trelane‡Оборона Трелана‡Trelanes Verteidigung‡트렐레인의 방어 장치‡Las defensas de Trelane‡Las defensas de Trelane‡Les défenses de Trelane‡特雷莱恩的防御‡特雷萊恩的防禦',
    nil,
    'Consiga uma Ágata Lazúli e entregue-a para o Aprendiz Kraiten, na Bastilha de Stromgarde‡Найдите лазурный агат и принесите его ученику Крайтену в крепость Стромгард.‡Sucht einen azurblauen Achat und bringt ihn Lehrling Kryten in Burg Stromgarde.‡푸른색 마노를 찾아서 스트롬가드 요새에 있는 수습마법사 크리텐에게 가져가야 합니다.‡Encuentra un ágata azur y llévasela al aprendiz Kryten en el Castillo de Stromgarde.‡Encuentra un ágata azur y llévasela al aprendiz Kryten en el Castillo de Stromgarde.‡Trouvez une Agate azur et apportez-la à l’Apprenti Kryten, au Donjon de Stromgarde.‡找到一块碧蓝玛瑙石，把它交给激流堡的学徒克里汀。‡找到蒼藍瑪瑙石並帶回去激流堡給學徒克里汀。',
  }
},
[26038] = {
  {
    'Ataque à torre‡Атака на башню‡Angriff auf den Turm‡탑 공격‡Ataque a la torre‡Ataque a la torre‡Attaque sur la tour‡进攻高塔‡進攻高塔',
    nil,
    'Encontre o Filactério de Trelane, o Orbe de Trelane e a Ágata-de-fogo de Trelane e entregue-os para Rodapeh na Ponta do Refúgio.‡Найдите талисман Трелана, сферу Трелана и угольный агат Трелана и принесите их Скуэрто в Опорный пункт.‡Findet Trelanes Phylakterium, Trelanes Kugel und Trelanes Glutachat und bringt sie Skuerto in der Zuflucht.‡트렐레인의 부적, 트렐레인의 수정구, 트렐레인의 잿불 마노를 찾아 임시 주둔지에 있는 스쿼토에게 가져가야 합니다.‡Encuentra la filacteria de Trelane, el orbe de Trelane y el ágata de ascuas de Trelane, y llévaselo todo a Skuerto en el Refugio de la Zaga.‡Encuentra la filacteria de Trelane, el orbe de Trelane y el ágata de ascuas de Trelane, y llévaselo todo a Skuerto en el Refugio de la Zaga.‡Trouvez le Phylactère de Trelane, l’Orbe de Trelane et l’Agate de braise de Trelane, et rapportez-les à Skuerto, au Refuge de l’Ornière.‡找到特雷莱恩的护符匣、特雷莱恩的宝珠和特雷莱恩的黑玛瑙，把它们交给避难谷地的斯奎尔图。‡找出特雷萊恩的骨匣、特雷萊恩的寶珠和特雷萊恩的黑瑪瑙，然後帶回避難谷地給斯奎爾圖。',
  }
},
[26039] = {
  {
    'A princesa aprisionada‡Плененная принцесса‡Die gefangene Prinzessin‡함정에 빠진 공주‡La princesa encerrada‡La princesa encerrada‡La princesse emprisonnée‡被困的公主‡受困的公主',
    nil,
    'Consiga 12 Partículas de Myzrael dos Kobolds Bigodesseco.‡Отберите 12 частиц Мизраэль у кобольдов из племени Сухоусов.‡Sammelt 12 Körner von Myzrael von Kobolden der Trockenstoppel.‡마른수염 코볼트를 처치해 미즈라엘의 결정 파편을 12개 모아야 합니다.‡Recolecta 12 motas de Myzrael en el Cañón Mostacho Seco.‡Recolecta 12 motas de Myzrael en el Cañón Mostacho Seco.‡Collectez 12 Poussières de Myzrael sur des Kobolds sèches-moustaches.‡从枯须狗头人身上收集12份密斯莱尔之尘。‡從枯鬚狗頭人那裡收集12份密斯賴爾之塵。',
  }
},
[26040] = {
  {
    'O quê? Quê? Nas minhas entranhas...?‡Ой-ой – что со мной?‡Keine Macht den Algen‡뭐? 뭐지? 뱃속의 이 느낌은...?‡¿Qué? ¿Qué? ¿En mis tripas...?‡¿Qué? ¿Qué? ¿En mis tripas...?‡Transit tumultueux‡啊……痛！我的肚子……‡什麼?什麼?在我的腸子裡...?',
    nil,
    'Colete 7 Brotos de Alga-crespa dos Ceifadores Luzespinha, que ficam na Amarra.‡Соберите 7 побегов вьющихся водорослей у жнецов Мерцающего хребта на Жемчужной ферме.‡Sammelt 7 Schlängelgrassprösslinge von Erntern der Schimmerrücken in der Umklammerung.‡구속의 손아귀에 있는 흐린빛가시 채집꾼으로부터 용틀임해초 싹 7개를 수집해야 합니다.‡Reúne 7 brotes de hierba titilante de los cosechadores Brillespina en El Encierro.‡Reúne 7 brotes de hierba titilante de los cosechadores Brillespina en El Encierro.‡Récupérez 7 Pousses de gigoteuse sur des Moissonneurs scintépines dans l\'Étreinte.‡从关押所里的光脊收割者身上收集7株蜷草苗芽。‡從窩巢的光脊收割者那裡收集7個扭草嫩芽。',
  }
},
[26041] = {
  {
    'Pedras de vínculo‡Связывающие камни‡Steine der Bindung‡마법진의 돌‡Piedras de Vínculo‡Piedras de Vínculo‡Les pierres de lien‡禁锢之石‡禁錮之石',
    nil,
    'Consiga a Chave Ardente, a Chave Troante e a Chave Trovejante nas Pedras da União Ocidental, da União Oriental e de União Exterior.‡Соберите огненный ключ, резной ключ и громовой ключ с западного, восточного и внешнего связывающих камней.‡Holt den brennenden Schlüssel, den schäumenden Schlüssel und den donnernden Schlüssel vom Stein der Westlichen Bindung, dem Stein der Östlichen Bindung und dem Stein der Äußeren Bindung.‡서부 봉인석, 동부 봉인석, 외부 봉인석에서 각각 불타는 열쇠, 용마루장식 열쇠, 천둥 열쇠를 구해야 합니다.‡Reúne la llave ardiente, la llave blasonada y la llave del trueno de la Piedra de Vínculo Occidental, la Piedra de Vínculo Este y la Piedra de Vínculo Exterior.‡Reúne la llave ardiente, la llave blasonada y la llave del trueno de la Piedra de Vínculo Occidental, la Piedra de Vínculo Este y la Piedra de Vínculo Exterior.‡Collectez la Clé ardente, la Clé armoriée et la Clé de tonnerre aux lieux suivants : la Pierre de lien occidentale, la Pierre de lien orientale et la Pierre de lien extérieure.‡从西禁锢之石、东禁锢之石和外禁锢之石中搜集烈焰钥匙、海浪钥匙和雷霆钥匙。‡在西禁錮之石、東禁錮之石和外禁錮之石那裡收集烈焰鑰匙、海浪鑰匙和雷霆鑰匙。',
  }
},
[26042] = {
  {
    'Quebrando a pedra-chave‡Разбить краеугольный камень‡Den Hauptstein zerbrechen‡쐐기돌 깨기‡Desbloquear la piedra angular‡Desbloquear la piedra angular‡La Pierre cruciale‡打开钥石‡打開鑰匙之石',
    nil,
    'Tome o Bastão de Ordem das mãos de Fozruk.‡Заберите у Фозрука Жезл Порядка.‡Beschafft die Rute der Ordnung von Fozruk.‡포즈루크에게서 질서의 마법봉을 획득해야 합니다.‡Consigue la vara del Orden de Fozruk.‡Consigue la vara del Orden de Fozruk.‡Arrachez le Bâtonnet de l’ordre à Fozruk.‡从弗兹鲁克那里得到秩序魔棒。‡從弗茲魯克那裡取得秩序魔棒。',
  }
},
[26043] = {
  {
    'CUIDADO COM QUEIXADA!‡Берегись Рифогрыза!‡HÜTET EUCH VOR FELSKIEFER!‡칼바위턱 조심!‡¡CUIDADO CON PEÑAMANDÍBULA!‡¡CUIDADO CON PEÑAMANDÍBULA!‡ATTENTION À ROCHEGUEULE !‡当心峭壁之腭！‡小心壁顎!',
    nil,
    'Mate Queixada e pegue o Dente Enorme do Queixada.‡Убейте Рифогрыза и заберите огромный зуб Рифогрыза.‡Tötet Felskiefer und nehmt Euch Felskiefers riesigen Zahn.‡칼바위턱을 처치하고 칼바위턱의 거대한 이빨을 획득해야 합니다.‡Mata a Peñamandíbula y consigue el diente enorme de Peñamandíbula.‡Mata a Peñamandíbula y consigue el diente enorme de Peñamandíbula.‡Tuez Rochegueule et arrachez-lui son Énorme dent.‡杀死峭壁之腭，拿到峭壁之腭的巨齿。‡殺死壁顎並取得壁顎的巨齒。',
  }
},
[26044] = {
  {
    'Onde estão as peças?‡Ну, и где детали?‡Wo sind die Teile?‡부품은 어디에?‡¿Dónde están los repuestos?‡¿Dónde están los repuestos?‡Où sont les pièces ?‡零件在哪儿？‡零件在哪裡?',
    nil,
    'Fale com o Sargento Dontrag nas Entranhas da Terra, que ficam na Cordilheira das Torres de Pedra.‡Поговорите с сержантом Донтрагом в Глубоких Плёсах, что в Когтистых горах.‡Sprecht mit Unteroffizier Dontrag in den Ausufernden Tiefen im Steinkrallengebirge.‡돌발톱 산맥에 있는 깊은 산마루 안에서 하사관 돈트래그와 대화해야 합니다.‡Habla con el sargento Dontrag en La Hondura Insondable, en Sierra Espolón.‡Habla con el sargento Dontrag en La Hondura Insondable, en Sierra Espolón.‡Parlez au Sergent Dontrag, au Fin-fond des Serres-Rocheuses.‡跟石爪山脉幽暗曲径的多特拉格中士谈一谈。‡去石爪山脈的礦坑深層裡和東崔格中士談話。',
  }
},
[26045] = {
  {
    'Tô com as suas peças bem aqui...‡Где-то тут были запчасти…‡Eure Teile sind schon hier...‡부품은 바로 여기에...‡Tengo tus repuestos justo aquí...‡Tengo tus repuestos justo aquí...‡Vos pièces sont tout près d\'ici… Plus près…‡你的零件就在这儿……‡我這裡有你要的零件......',
    nil,
    'Colete 10 Peças Sobressalentes.‡Соберите 10 запчастей.‡Sammelt 10 Ersatzteile.‡예비 부품 10개를 모아야 합니다.‡Recoge 10 piezas de repuesto.‡Recoge 10 piezas de repuesto.‡Retrouvez 10 Pièces détachées.‡收集10个备用零件。‡收集10個備用零件。',
  }
},
[26046] = {
  {
    'Entre a cruz e a espada‡Между молотом и наковальней‡Was immer wir tun...‡진퇴양난‡Entre la espada y la pared‡Entre la espada y la pared‡Entre le marteau et l\'enclume‡进退两难‡陷入困境',
    nil,
    'Mate 12 Elementais da Terra Enfurecidos.‡Убейте 12 бушующих духов земли.‡Tötet 12 tobende Erdelementare.‡흉포한 대지의 정령 12마리를 처치해야 합니다.‡Mata a 12 elementales de tierra enfurecidos.‡Mata a 12 elementales de tierra enfurecidos.‡Tuez 12 Élémentaires de terre enragés.‡消灭12个愤怒的土元素。‡殺死12個狂怒的土元素。',
  }
},
[26047] = {
  {
    'E é por isso que eles são chamados de peões...‡Батраки – они такие…‡Deshalb nennt man sie Peons...‡일꾼 밖에 못 되는 녀석들...‡Por eso los llaman peones...‡Por eso los llaman peones...‡Et voilà pourquoi on les appelle des péons…‡这就是他们为什么叫苦工的原因……‡所以他們叫做苦工',
    nil,
    'Resgate 10 Peões Assustados.‡Спасите 10 испуганных батраков.‡Rettet 10 verängstigte Peons.‡겁에 질린 일꾼 10명을 구출해야 합니다.‡Rescata a 10 peones aterrorizados.‡Rescata a 10 peones aterrorizados.‡Secourez 10 Péons effrayés.‡营救10名受惊吓的苦工。‡救出10個害怕的苦工。',
  }
},
[26048] = {
  {
    'Nadando em peças sobressalentes!‡Запчасти сюда!‡Ersatzteile hier herauf!‡예비 부품 배달‡¡A mí los repuestos!‡¡A mí los repuestos!‡Pièces détachées en solde !‡这儿有备用零件！‡備用零件在此!',
    nil,
    'Entregue o Caixote de Peças Sobressalentes à Cabumgenheira-chefe Bombatripa na Fortaleza Krom\'gar, que fica na Cordilheira das Torres de Pedra.‡Доставьте ящик с запчастями взрынженеру Бомбиглотc в крепость Кром\'гар в Когтистых горах.‡Bringt die Kiste mit Ersatzteilen zu Obersprengenieurin Bombgutz in der Feste Krom\'gar im Steinkrallengebirge.‡돌발톱 산맥의 크롬가르 요새에 있는 선임 폭파기술자 봄거츠에게 예비 부품 상자를 가져가야 합니다.‡Entrega el cajón de piezas de recambio a la explosingeniera jefe Tripasbomba en la Fortaleza Krom\'gar, en Sierra Espolón.‡Entrega el cajón de piezas de recambio a la explosingeniera jefe Tripasbomba en la Fortaleza Krom\'gar, en Sierra Espolón.‡Livrez la Caisse de pièces détachées à l’Explogénieur en chef Bombetripes, à la Forteresse de Krom’gar, dans les Serres-Rocheuses.‡将一箱备用零件交给石爪山脉克罗姆加壁垒的首席爆破工程师邦姆古兹。‡將備用零件箱帶去石爪山脈的克羅姆加堡壘，交給首席爆破工程師炸彈格茲。',
  }
},
[26049] = {
  {
    'A princesa libertada‡Освобожденная принцесса‡Die entfesselte Prinzessin‡해방된 공주‡Liberar a la princesa‡Liberar a la princesa‡La princesse déchaînée‡被释放的公主‡釋放公主',
    nil,
    'Evoque e derrote Myzrael nos Estilhaços de Myzrael.‡Призовите к кристаллам Мизраэль и победите ее.‡Beschwört und besiegt Myzrael an den Splittern von Myzrael.‡미즈라엘의 결정에서 미즈라엘을 소환한 후에 쓰러뜨려야 합니다.‡Invoca y derrota a Myzrael en los Fragmentos de Myzrael.‡Invoca y derrota a Myzrael en los Fragmentos de Myzrael.‡Invoquez Myzrael aux Fragments de Myzrael et terrassez-la‡在密斯莱尔水晶碎块处召唤并打败密斯莱尔。‡在密斯賴爾水晶裂片召喚並擊敗密斯賴爾。',
  }
},
[26050] = {
  {
    'Óculos à prova d\'água‡Хитрые очки‡Leuchtbrille‡고글 보글‡Al agua patos‡Al agua patos‡Les bésicles fantasticles‡神奇潜水镜‡潛水鏡之亂',
    nil,
    'Escolte o Professor Bruzundanga até a caverna e retorne com ele.‡Проводите профессора Физзлторпа в пещеру и обратно.‡Begleitet Professor Prasseltrop zur Höhle und zurück.‡학자 피즐솔프가 동굴에 들어갔다 나올 수 있도록 호위해야 합니다.‡Escolta al profesor Fiseltor hasta la cueva y a su regreso.‡Escolta al profesor Fiseltor hasta la cueva y a su regreso.‡Escortez le Professeur Phloppenthrope pour atteindre la caverne et pour en revenir.‡护送菲兹索普教授到洞穴里去并平安返回。‡護送菲茲索普教授到洞穴然後回來。',
  }
},
[26051] = {
  {
    'Tesouro afundado‡Затонувшее сокровище‡Versunkene Schätze‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'O Doutor Medeixo na Enseada de Faldir quer que você consiga 10 Gemas Élficas e devolva os Óculos para Caçar Gemas quando tiver terminado.‡Доктор Драксельмер в бухте Фальдира просит вас собрать 10 эльфийских самоцветов и после этого вернуть ему очки Ловца сокровищ.‡Doktor Drechselknacks in der Faldirbucht will, dass Ihr 10 Elfenedelsteine einsammelt und die Edelsteinjagdschutzbrille zurückgebt, sobald Ihr fertig seid.‡팔디르의 만에 있는 발명가 드랙슬게이지가 엘프의 보석 10개를 주워 오고 이 일을 끝낸 후 보물찾기 고글을 돌려 달라고 했습니다.‡El doctor Draxlegauge de la Cala de Faldir quiere que reúnas 10 gemas de elfo y le devuelvas las gafas de caza de gemas cuando hayas acabado.‡El doctor Draxlegauge de la Cala de Faldir quiere que reúnas 10 gemas de elfo y le devuelvas las gafas de caza de gemas cuando hayas acabado.‡Le docteur Draunessieu, à la Crique de Faldir, veut que vous lui rapportiez 10 Gemmes elfiques ainsi que les Lunettes de chasse aux gemmes, une fois celles-ci collectées.‡法迪尔海湾的德拉克里格博士要你去收集10块精灵宝石并在完成任务后归还寻宝潜水镜。‡法迪爾海灣裡的德拉克里格博士希望你收集10顆精靈寶石，並在完成後歸還尋寶潛水鏡。',
  }
},
[26052] = {
  {
    'Tremenda encomenda‡Разговор с Мурашом‡Sprecht mit Wank‡선장과 대화하기‡Habla con Temblores‡Habla con Temblores‡Parler à monsieur O\'Breen‡同沙克斯交谈‡與沙克斯對話',
    nil,
    'Leve as Gemas Élficas para o Capitão Juanka Nabrava na Enseada de Faldir, que fica no Planalto Arathi.‡Отнесите эльфийские самоцветы капитану О\'Брину в бухту Фальдира на Нагорье Арати.‡Bringt die Elfenedelsteine zu Kapitän O\'Breen in der Faldirbucht im Arathihochland.‡아라시 고원의 팔디르의 만에 있는 선장 오브린에게 엘프의 보석을 가져가야 합니다.‡Llévale las gemas de elfo al capitán O\'Breen a la Cala de Faldir, en las Tierras Altas de Arathi.‡Llévale las gemas de elfo al capitán O\'Breen a la Cala de Faldir, en las Tierras Altas de Arathi.‡Apportez les Gemmes elfiques au Capitaine O\'Breen à la Crique de Faldir, dans les Hautes-terres Arathies.‡把精灵宝石交给阿拉希高地法迪尔海湾的奥布里船长。‡將精靈寶石帶去阿拉希高地的法迪爾海灣給奧布里船長。',
  }
},
[26053] = {
  {
    'Limpando o Planalto‡Очистить нагорье‡Säuberung des Hochlands‡고원 청소‡Limpiar las Tierras Altas‡Limpiar las Tierras Altas‡Nettoyer les hautes-terres‡打扫高地‡掃蕩高地',
    nil,
    'Mate 8 Ogros Punho de Pedra e 10 Impositores Punho de Pedra.‡Убейте 8 огров из клана Тяжелого Кулака и 10 головорезов из клана Тяжелого Кулака.‡Tötet 8 Oger der Felsfäuste und 10 Vollstrecker der Felsfäuste.‡돌주먹 오우거 8마리와 돌주먹 집행자 10마리를 처치해야 합니다.‡Mata a 8 ogros y a 10 déspotas Puño de Roca.‡Mata a 8 ogros y a 10 agentes Puño de Roca.‡Tuez 8 Ogres rochepoings et 10 Massacreurs rochepoings.‡杀死8名石拳食人魔和10名石拳执行者。‡殺死8名石拳巨魔和10名石拳執行者。',
  }
},
[26054] = {
  {
    '‡Что-то они там мутят‡Wasser haben die vor?‡물오른 작전‡Al enemigo, ni agua‡‡Des coups d’épée dans l’eau‡洪涛漫漫，尽没其中‡',
    nil,
    '‡Убейте Кай\'жу Газ\'риллу и поставьте об этом в известность генерала Маркуса Джонатана в Штормграде.‡Tötet Kai\'ju Gahz\'rilla und informiert General Marcus Jonathan in Sturmwind darüber.‡카이주 가즈릴라를 처치하고 스톰윈드에 있는 장군 마커스 조나단에게 알려야 합니다.‡Mata a Kai\'ju Gahz\'rilla e informa al general Marcus Jonathan en Ciudad de Ventormenta.‡‡Tuez Kai’ju Gahz’rilla et informez-en le Général Marcus Jonathan, à Hurlevent.‡杀死巨型加兹瑞拉，并通知暴风城的马库斯·乔纳森将军。‡',
  }
},
[26055] = {
  {
    'Afogando as mágoas‡Затонувшие печали‡Ertrunkene Trauer‡비통한 마음‡Ahogar las penas‡Ahogar las penas‡Chagrin noyé‡溺水冤魂‡船長的復仇',
    nil,
    'O Capitão Tripaço, na Enseada de Faldir, quer que você mate 10 Saqueadores Espinhadaga e 3 Feiticeiras Espinhadaga.‡Капитан Стальные Нервы из бухты Фальдира хочет, чтобы вы убили 10 налетчиков и 3 колдуний из клана Пронзающего Гребня.‡Kapitän Stahlmagen in der Faldirbucht will, dass Ihr 10 Räuber der Säbelflossen und 3 Zauberinnen der Säbelflossen tötet.‡팔디르의 만에 있는 선장 스틸구트가 비수가시 침략자 10마리와 비수가시 여마법사 3마리를 처치해 달라고 했습니다.‡El capitán Tripacero de Cala de Faldir quiere que mates a 10 asaltantes Espinadaga y a 3 hechiceras Espinadaga.‡El capitán Tripacero de Cala de Faldir quiere que mates a 10 asaltantes Espinadaga y a 3 hechiceras Espinadaga.‡Le capitaine Tripacier de la Crique de Faldir veut que vous tuiez 10 Écumeurs daguéchines et 3 Sorcières daguéchines.‡法迪尔海湾的斯迪加特船长要你去杀掉10个刺脊袭击者和3个刺脊巫师。‡法迪爾海灣裡的鋼膽船長希望你殺死10隻刺脊劫掠者和3隻刺脊巫女。',
  }
},
[26056] = {
  {
    'A Falaondas‡Говорящая с волнами‡Die Wellensprecherin‡파도예언자‡La hablaolas‡La hablaolas‡La parle-vague‡波涛语者‡語濤者',
    nil,
    'Encontre a Falaondas Valoren no Abismo dos Pesadelos em Vashj\'ir.‡Разыщите говорящую с волнами Валорен в Глубинах Кошмаров в Вайш\'ире.‡Findet Wellensprecherin Valoren in den Alptraumtiefen in Vashj\'ir.‡바쉬르의 악몽의 나락에 있는 파도예언자 발로렌을 찾아야 합니다.‡Encuentra a la hablaolas Valoren en las Profundidades de Pesadilla, en Vashj\'ir.‡Encuentra a la hablaolas Valoren en las Profundidades de Pesadilla, en Vashj\'ir.‡Retrouvez la parle-vague Valoren dans les Profondeurs du Cauchemar, en Vashj\'ir.‡在瓦丝琪尔的梦魇深渊中找到波涛语者瓦罗伦。‡在瓦許伊爾的夢靨深淵找到語濤者維勒連。',
  }
},
[26057] = {
  {
    'A Falaondas‡Говорящая с волнами‡Die Wellensprecherin‡파도예언자‡La hablaolas‡La hablaolas‡La parle-vague‡波涛语者‡語濤者',
    nil,
    'Encontre a Falaondas Valoren no Abismo dos Pesadelos em Vashj\'ir.‡Разыщите говорящую с волнами Валорен в Глубинах Кошмаров в Вайш\'ире.‡Findet Wellensprecherin Valoren in den Alptraumtiefen in Vashj\'ir.‡바쉬르의 악몽의 나락에 있는 파도예언자 발로렌을 찾아야 합니다.‡Encuentra a la hablaolas Valoren en las Profundidades de Pesadilla, en Vashj\'ir.‡Encuentra a la hablaolas Valoren en las Profundidades de Pesadilla, en Vashj\'ir.‡Retrouvez la parle-vague Valoren dans les Profondeurs du Cauchemar, en Vashj\'ir.‡在瓦丝琪尔的梦魇深渊中找到波涛语者瓦罗伦。‡在瓦許伊爾的夢靨深淵找到語濤者維勒連。',
  }
},
[26058] = {
  {
    'Em defesa da Fortaleza Krom\'gar‡Защита крепости Кром\'гар‡Die Verteidigung der Feste Krom\'gar‡크롬가르 요새 방어‡En defensa de la Fortaleza Krom\'gar‡En defensa de la Fortaleza Krom\'gar‡La défense de la forteresse de Krom\'gar‡防御克罗姆加壁垒‡防禦克羅姆加堡壘',
    nil,
    'Destrua 15 Máquinas Voadoras Gnômicas ou Bombardeiros e 25 Comandantes de Ala Gnomos.‡Уничтожьте 15 гномских ветролетов или бомбардировщиков и 25 командиров звена гномов.‡Zerstört 15 gnomische Flugmaschinen oder Gnomenbomber und 25 Gnomenschwadronskommandanten.‡노움 비행기 15대를 파괴하고 노움 편대사령관 25명을 처치해야 합니다.‡Destruye 15 máquinas voladoras gnómicas o bombarderos y 25 comandantes del aire gnomos.‡Destruye 15 máquinas voladoras gnómicas o bombarderos y 25 comandantes del aire gnomos.‡Descendez 15 Machines volantes ou Bombardiers gnomes et 25 Chefs d’escadrille gnomes.‡摧毁15架侏儒飞行器或轰炸机，以及25名侏儒飞将。‡摧毀15架地精飛行器或轟炸機，以及25名地精空軍指揮官。',
  }
},
[26059] = {
  {
    'Olhos e ouvidos: Malaka\'jin‡Глаза и уши: Малака\'джин‡Augen und Ohren: Malaka\'jin‡눈과 귀: 말라카진‡Vista y oído: Malaka\'jin‡Vista y oído: Malaka\'jin‡À l\'affût à Malaka\'jin‡耳目：玛拉卡金‡眼與耳:瑪拉卡金',
    nil,
    'Apresente-se ao Mandingueiro Jin\'zil em Malaka\'jin, que fica na Cordilheira das Torres de Pedra.‡Отправляйтесь к Знахарю Джин\'Зилу в Малака\'джин, что в Когтистых горах.‡Meldet Euch bei Hexendoktor Jin\'Zil in Malaka\'jin im Steinkrallengebirge‡돌발톱 산맥의 말라카진에서 의술사 진질에게 보고해야 합니다.‡Preséntate ante el médico brujo Jin\'Zil en Malaka\'jin, en Sierra Espolón.‡Preséntate ante el médico brujo Jin\'Zil en Malaka\'jin, en Sierra Espolón.‡Présentez-vous au Féticheur Jin’zil à Malaka’jin, dans les Serres-Rocheuses.‡去找石爪山脉玛拉卡金的巫医金吉尔。‡到石爪山脈的瑪拉卡金向巫醫金吉爾回報。',
  }
},
[26060] = {
  {
    'Vodu: coração de eletrocutor‡Вуду: сердце скалозавра‡Der Voodoo: Stürmerherz‡부두교 마법: 천둥절벽도마뱀 심장‡El vudú: corazón de agitador‡El vudú: corazón de agitador‡Vaudou : cœur de lézard-tempête‡巫毒：雷鸣蜥蜴之心‡巫毒:雷鳴蜥蜴的心臟',
    nil,
    'Obtenha um Coração de Eletrocutor do Penhasco‡Добудьте сердце скалозавра.‡Besorgt ein Klippenstürmerherz.‡천둥절벽도마뱀 심장을 획득해야 합니다.‡Consigue el corazón de un agitador de precipicio.‡Consigue el corazón de un agitador de precipicio.‡Obtenez un Cœur de Lézard-tempête des falaises.‡获得一颗峭壁雷鸣蜥蜴之心。‡取得1顆峭壁雷鳴蜥蜴的心臟。',
  }
},
[26061] = {
  {
    'Vodu: chifres de carneiro‡Вуду: бараний рог‡Der Voodoo: Widderhörner‡부두교 마법: 산양 뿔‡El vudú: cuerno de carnero‡El vudú: cuerno de carnero‡Vaudou : cornes de bélier‡巫毒：山羊角‡巫毒:山羊角',
    nil,
    'Obtenha 6 Chifres de Carneiro das Torres de Pedra.‡Добудьте 6 рогов баранов Когтистых гор.‡Besorgt 6 Hörner eines Steinkrallenwidders.‡돌발톱 산양 뿔 6개를 획득해야 합니다.‡Consigue 6 cuernos de carnero del Espolón.‡Consigue 6 cuernos de carnero del Espolón.‡Procurez-vous 6 Cornes de bélier des Serres-Rocheuses.‡获得6只石爪山羊角。‡取得6根石爪山羊角。',
  }
},
[26062] = {
  {
    'Vodu: cristal de ressonita‡Вуду: кристалл резонита‡Der Voodoo: Resonitkristall‡부두교 마법: 리조나이트 수정‡El vudú: cristal de resonita‡El vudú: cristal de resonita‡Vaudou : cristal de résonite‡巫毒：共鸣水晶‡巫毒:共鳴水晶',
    nil,
    'Obtenha 8 Cristais de Ressonita.‡Добудьте 8 кристаллов резонита.‡Besorgt 8 Resonitkristalle.‡리조나이트 수정 8개를 획득해야 합니다.‡Consigue 8 cristales de resonita.‡Consigue 8 cristales de resonita.‡Obtenez 8 Cristaux de résonite.‡获得6颗共鸣水晶。‡取得8個共鳴水晶。',
  }
},
[26063] = {
  {
    'A rainha e sua corte‡Королеву играет свита‡Die Königin und ihr Hofstaat‡여왕과 그 신하들‡La Reina y su corte‡La Reina y su corte‡La reine et sa suite‡皇后及群臣‡皇后和她的宮廷',
    nil,
    'Mate a Rainha Silith e quaisquer 10 aranhas no Antro Enrediço.‡Убейте королеву Силит и любых 10 пауков в Паучьей лощине.‡Tötet Königin Silith und 10 beliebige Spinnen in der Weberkuhle.‡그물누비 동굴에서 여왕 실리스와 종류를 가리지 않고 거미 10마리를 처치해야 합니다.‡Mata a la reina Silith y a 10 arañas cualesquiera en la Cuenca de las Tejedoras.‡Mata a la reina Silith y a 10 arañas cualesquiera en la Cuenca de las Tejedoras.‡Tuez la Reine Silith et 10 araignées de n’importe quel type dans le Creux des Tisseuses.‡在蛛网盆地杀死蛛后西莉丝和任意10只蜘蛛。‡在蛛網谷裡殺死希莉絲皇后和任意10隻蜘蛛。',
  }
},
[26064] = {
  {
    'Guerra estomacal‡Война с голодом‡Kein Kampf auf leeren Magen‡굶주림과 싸워라‡De tripas corazón‡De tripas corazón‡Ventre affamé n\'a point d\'oreilles‡为了他们的肚子而战‡同胃袋戰鬥',
    nil,
    'Colete 8 Ovos de Águia de Kalimdor.‡Соберите 8 яиц калимдорских орлов.‡Beschafft 8 Eier des Kalimdoradlers.‡칼림도어 독수리 알 8개를 구해야 합니다.‡Recoge 8 huevos de águila de Kalimdor.‡Recoge 8 huevos de águila de Kalimdor.‡Récoltez 8 Œufs d’aigle de Kalimdor.‡收集8枚卡利姆多鹰蛋。‡收集8顆卡林多雄鷹蛋。',
  }
},
[26065] = {
  {
    'Libertando Wil\'hai‡Освободите Вил\'ле‡Freiheit für Willi‡윌하이 풀어주기‡Liberad a Wil\'hai‡Liberad a Wil\'hai‡Sauvez Wil’hai‡释放维尔哈伊‡救出威爾豪',
    nil,
    'Mate todos os Tentáculos Horrendos para libertar Wil\'hai.‡Уничтожьте все щупальца ужаса и освободите Вил\'ле.‡Tötet alle Tentakelschrecken, um Willi zu befreien.‡공포의 촉수괴물을 모두 처치하고 윌하이를 풀어 줘야 합니다.‡Mata a todos los horrores de tentáculos para liberar a Wil\'hai.‡Mata a todos los horrores de tentáculos para liberar a Wil\'hai.‡Tuez toutes les Horreurs tentaculaires afin de sauver Wil’hai.‡杀死所有的恐怖触须，释放维尔哈伊。‡消滅所有觸鬚恐獸救出威爾豪。',
  }
},
[26066] = {
  {
    'Reforços...‡Подкрепление…‡Verstärkung...‡증원군이라...‡Refuerzos...‡Refuerzos...‡Des renforts…‡援兵……‡增援...',
    nil,
    'Use o Chicote do Subjugador Divo para subjugar 6 Kobolds da Caverna da Avalanche.‡Используйте хлыст поработителя Дэво, чтобы поработить 6 кобольдов из племени Камнепадов.‡Bändigt 6 Steinschlagkobolde mit der Peitsche von Unterwerfer Devo.‡정복자 데보의 채찍을 사용하여 구릉바위 코볼트 6마리를 복종시켜야 합니다.‡Utiliza el látigo del subyugador Devo para subyugar a 6 kóbolds del Alud.‡Utiliza el látigo del subyugador Devo para subyugar a 6 kóbolds del Alud.‡Utilisez le Fouet du Subjugateur Devo pour maîtriser 6 Kobolds des éboulis.‡用征服者德沃的鞭子抽服6名滚岩狗头人。‡使用征服者迪佛的鞭子制服6個滾岩狗頭人。',
  }
},
[26067] = {
  {
    'A bênção de Jin\'Zil‡Магия Джин\'Зила‡Jin\'Zils Segen‡진질의 축복‡La bendición de Jin\'Zil‡La bendición de Jin\'Zil‡La bénédiction de Jin\'zil‡金吉尔的祝福‡金吉爾的祝福',
    nil,
    'Use o Bastão Vodu de Jin\'Zil para infundir 12 Espoliadores de Krom\'gar com Vodu.‡Используйте вудуистскую палку Джин\'Зила, чтобы наслать на 12 кром\'гарских мародеров магию вуду.‡Benutzt Jin\'Zil\'s Voodoostecken, um 12 Marodeure von Krom\'gar mit Voodoo zu erfüllen.‡진질의 부두 막대기를 사용하여 크롬가르 약탈자 12명에게 부두 마력을 불어넣어야 합니다.‡Utiliza la vara de vudú de Jin\'Zil para infundir vudú a 12 maleantes Krom\'gar.‡Utiliza la vara de vudú de Jin\'Zil para infundir vudú a 12 maleantes Krom\'gar.‡Utilisez le Bâton vaudou de Jin’zil pour infuser de la magie vaudou à 12 Maraudeurs de Krom’gar.‡使用金吉尔的巫毒棒在12名克罗姆加掠夺者身上施下巫毒。‡用金吉爾的巫毒手杖幫12名克羅姆加掠奪者注入巫毒之力。',
  }
},
[26068] = {
  {
    'A fúria dos kobolds!‡Кобольды, вперед!‡Die Wut der Kobolde!‡코볼트의 분노!‡¡Furia kóbold!‡¡Furia kóbold!‡Déchaîne les kobolds, Maximus !‡狗头人之怒！‡狗頭人狂怒!',
    nil,
    'Use a Trompa de Guerra Kobold perto do Estandarte da Horda nas Terras Escavadas para convocar o Exército de Kobolds!‡Используйте боевой рог кобольдов рядом со знаменем Орды на Месте раскопок, чтобы послать в бой армию кобольдов!‡Benutzt das Koboldkriegshorn nahe des Banners der Horde an der Grabstätte, um die Koboldarmee loszulassen!‡발굴된 땅의 호드 깃발 근처에서 코볼트 전쟁 뿔피리를 불어 코볼트 군대를 불러내야 합니다!‡¡Utiliza el cuerno de guerra kóbold cerca del estandarte de la Horda en los Campos Desenterrados para liberar el ejército kóbold!‡¡Utiliza el cuerno de guerra kóbold cerca del estandarte de la Horda en los Campos Desenterrados para liberar el ejército kóbold!‡Utilisez le Cor de guerre kobold près de la Bannière de la Horde sur les Terres Exhumées pour déchaîner l’armée des kobolds !‡在不毛之地的部落军旗旁使用狗头人战争号角，释放狗头人大军！‡在掘出的遺址的部落旌旗使用狗頭人戰爭號角，以放出狗頭人軍隊!',
  }
},
[26069] = {
  {
    'Nura Caminheira‡Нура Землепроходица‡Nura Pfadfinder‡누라 패스파인더‡Nura Abrecaminos‡Nura Abrecaminos‡Nura la Guide‡探路者鲁娜‡努拉·探路者',
    nil,
    'Apresente-se a Nura Caminheira na Estrada Alta, que fica nos Sertões Meridionais.‡Поговорите с Нурой Землепроходицей на Верхнем пути в Южных Степях.‡Meldet Euch bei Nura Pfadfinder auf dem Höhenpfad im Südlichen Brachland.‡남부 불모의 땅에 있는 높은 길에서 누라 패스파인더에게 보고해야 합니다.‡Preséntate ante Nura Abrecaminos en La Carretera en Los Baldíos del Sur.‡Preséntate ante Nura Abrecaminos en La Carretera en Los Baldíos del Sur.‡Faites votre rapport à Nura la Guide à la Haute-route, dans les Tarides du Sud.‡去找南贫瘠之地高地之路的探路者鲁娜‡到南貧瘠之地的高地小道向努拉·探路者回報。',
  }
},
[26070] = {
  {
    'Limpando a sujeira‡Уничтожение скверны‡Läuterung der Entweihten‡오염 정화‡Eliminando a los profanados‡Eliminando a los profanados‡Opération mains propres‡清理被腐蚀的生物‡淨化污穢',
    nil,
    'Mate 8 Enguias Esmagadoras, Rêmoras do Abismo ou Espreitadores do Abismo.‡Уничтожьте несколько угрей-сокрушителей, глубоководных прилипал или ловцов провала – в общей сложности 8 тварей.‡Tötet eine beliebige Kombination aus 8 Schmetteraalen, Tiefenschiffshaltern oder Schluchtpirschern.‡박치기 장어, 심연빨판상어, 협곡 추적자 중에서 8마리를 처치해야 합니다.‡Mata a 8 anguilas aplastantes, rémoras profundas o acechadores de sima.‡Mata a 8 anguilas aplastantes, rémoras profundas o acechadores de sima.‡Tuez 8 créatures, qu’elles soient des Anguilles écrasantes, des Rémoras des profondeurs ou des Traqueurs des tranchées.‡杀死任意8只碾压巨鳗、深海鮣魚或是海沟猎手。‡殺死8個碾齒鰻魚、深海印魚或溝渠潛獵者。',
  }
},
[26071] = {
  {
    'Limpando a sujeira‡Уничтожение скверны‡Läuterung der Entweihten‡오염 정화‡Eliminando a los profanados‡Eliminando a los profanados‡Opération mains propres‡清理被腐蚀的生物‡淨化污穢',
    nil,
    'Mate 8 Enguias Esmagadoras, Rêmoras do Abismo ou Espreitadores do Abismo.‡Уничтожьте несколько угрей-сокрушителей, глубоководных прилипал или ловцов провала – в общей сложности 8 тварей.‡Tötet eine beliebige Kombination aus 8 Schmetteraalen, Tiefenschiffshaltern oder Schluchtpirschern.‡박치기 장어, 심연빨판상어, 협곡 추적자 중에서 8마리를 처치해야 합니다.‡Mata a 8 anguilas aplastantes, rémoras profundas o acechadores de sima.‡Mata a 8 anguilas aplastantes, rémoras profundas o acechadores de sima.‡Tuez 8 créatures, qu’elles soient des Anguilles écrasantes, des Rémoras des profondeurs ou des Traqueurs des tranchées.‡杀死任意8只碾压巨鳗、深海鮣魚或是海沟猎手。‡殺死8個碾齒鰻魚、深海印魚或溝渠潛獵者。',
  }
},
[26072] = {
  {
    'Totem adentro‡Зарядка тотема‡In das Totem‡토템 속으로‡Dentro del tótem‡Dentro del tótem‡Tout le monde dans le même totem‡图腾的威力‡進入圖騰',
    nil,
    'Mate 5 Profanadores Sem-rosto enquanto eles estiverem perto do Totem de Confinamento.‡Уничтожьте 5 безликих сквернителей в непосредственной близости от улавливающего тотема.‡Tötet 5 gesichtslose Entweiher, während sie sich in der Reichweite des Totems der Einsperrung befinden.‡봉쇄의 토템 사정거리 안에 있는 얼굴 없는 파멸자 5마리를 처치해야 합니다.‡Mata a 5 ignotos en corrupción que estén dentro del alcance del tótem de confinamiento.‡Mata a 5 ignotos en corrupción que estén dentro del alcance del tótem de confinamiento.‡Tuez 5 Profanateurs sans-visage lorsqu’ils sont à portée du Totem de détention.‡在限制图腾的范围内消灭5个腐蚀无面者。‡在伊魯納克的監禁圖騰範圍內消滅5個無面污染者。',
  }
},
[26073] = {
  {
    'Nada de novo no front sul‡На южном фронте без перемен‡Im Süden nichts Neues‡모두 정리된 남부 전선‡La calma reina en el frente sur‡La calma reina en el frente sur‡Au sud, rien de nouveau‡南线无战事‡南線無戰事',
    nil,
    'Apresente-se ao suserano Krom\'gar na Fortaleza Krom\'gar, que fica na Cordilheira das Torres de Pedra.‡Поговорите с властителем Кром\'гаром в крепости Кром\'гар в Когтистых горах.‡Meldet Euch bei Oberanführer Krom\'gar in der Feste Krom\'gar im Steinkrallengebirge.‡돌발톱 산맥의 크롬가르 요새에 있는 대군주 크롬가르에게 보고해야 합니다.‡Preséntate ante el señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Preséntate ante el señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Faites votre rapport au Suzerain Krom’gar à la Forteresse de Krom’gar, dans les Serres-Rocheuses.‡去找石爪山脉克罗姆加壁垒的克罗姆加大王。‡到石爪山脈的克羅姆加堡壘向霸主克羅姆加回報。',
  }
},
[26074] = {
  {
    'Começo do fim‡Начало конца‡Der Anfang vom Ende‡끝의 시작‡El principio del fin‡El principio del fin‡Le début de la fin‡终结的开始‡走向滅亡',
    nil,
    'Leve o Balão de Ar Quente de Krom\'gar ao Barreiro, que fica na Cordilheira das Torres de Pedra.‡Доставьте кром\'гарский воздушный шар к илоразработкам в Когтистых горах.‡Fahrt im Heißluftballon von Krom\'gar zu den Schlickwerken im Steinkrallengebirge.‡크롬가르 열기구를 타고 돌발톱 산맥의 진흙작업장으로 가야 합니다.‡Coge el dirigible Krom\'gar hasta Los Fangados, en Sierra Espolón.‡Lleva el globo aerostático Krom\'gar hasta Los Fangados, en Sierra Espolón.‡Emportez la Montgolfière de Krom’gar à la Vidangerie des Serres-Rocheuses.‡护送克罗姆加热气球前往石爪山脉的油污潭。‡將克羅姆加熱氣球帶去石爪山脈的淤泥作坊。',
  }
},
[26075] = {
  {
    'As mantícoras, quando avoam...‡Грязь по колено‡Ein Haufen Probleme‡똥 문제‡Problema de zurullos‡Problema de zurullos‡Étron, étron, petit patapon…‡粪便问题‡糞堆問題',
    nil,
    'Mate quaisquer 6 Mantícoras Asaltivas.‡Убейте 6 величавых виверн любого вида.‡Tötet 6 beliebige Prachtschwingenwyvern.‡사자날개 와이번 6마리를 처치해야 합니다.‡Mata a 6 dracoleones Alaorgullo cualesquiera.‡Mata a 6 dracoleones Alaorgullo cualesquiera.‡Tuez 6 Wyvernes ailes-fières de n’importe quel type.‡消灭任意6头巨翼双足飞龙。‡殺死任意6隻巨翼雙足翼龍。',
  }
},
[26076] = {
  {
    'Infestação de espiões‡Шпионы-паразиты‡Spionageplage‡사방에 널린 첩보원‡Infestado de espías‡Infestado de espías‡Invasion d\'espions‡间谍横行‡間諜出沒',
    nil,
    'Mate 8 Espiões da Aliança. Use a Bomba de Gás do Jibbly para revelar os espiões!‡Убейте 8 шпионов Альянса. Для разоблачения шпионов используйте газовую бомбу Джиббли.‡Tötet 8 Allianzspione. Enttarnt die Spione mit Jibblys Gasbombe!‡얼라이언스 첩보원 8명을 처치해야 합니다. 은폐한 첩보원이 모습을 드러나게 하려면 지블리의 가스탄을 사용하십시오!‡Mata a 8 espías de la Alianza. ¡Utiliza la bomba de gas de Jibbly para desenmascarar a los espías!‡Mata a 8 espías de la Alianza. ¡Utiliza la bomba de gas de Jibbly para desenmascarar a los espías!‡Tuez 8 Espions de l’Alliance. Utilisez la Bombe de gaz de Jibbly pour les démasquer!‡杀死8名联盟间谍。用吉卜力的气弹找到他们！‡殺死8名聯盟間諜。使用吉畢利的瓦斯炸彈讓間諜現形!',
  }
},
[26077] = {
  {
    'Entrega final‡Доставка до места назначения‡Letzte Lieferung‡최종 배달‡La entrega final‡La entrega final‡Livraison finale‡最后交货‡最後的快遞',
    nil,
    'Leve o Balão de Ar Quente de Krom\'gar ao Posto  Andarilho da Montanha, na Cordilheira das Torres de Pedra.‡Доставьте кром\'гарский воздушный шар на Плато Скалоступов в Когтистых горах.‡Fahrt mit dem Heißluftballon von Krom\'gar zum Klippenläuferposten im Steinkrallengebirge.‡크롬가르 열기구를 돌발톱 산맥의 절벽지기 초소로 가져가야 합니다.‡Coge el dirigible de Krom\'gar hasta el Puesto Caminarrisco, en Sierra Espolón.‡Lleva el globo aerostático Krom\'gar hasta el Puesto Caminarrisco, en Sierra Espolón.‡Emmenez la Montgolfière de Krom’gar jusqu’au Poste de Rôde-falaise, dans les Serres-Rocheuses.‡将克罗姆加热气球驶往石爪山脉的峭壁行者哨站。‡將克羅姆加熱氣球帶去石爪山脈的崖行者崗哨。',
  }
},
[26078] = {
  {
    'Fogo!‡Потушить огонь‡Löscht die Feuer‡소화작업‡Extinguir las llamas‡Extinguir las llamas‡Maîtriser les flammes‡灭火‡滅火',
    nil,
    'Usando o Equipamento de Combate a Incêndio, apague 6 focos de incêndios na Base Aérea de Altaforja.‡Воспользуйтесь противопожарным оборудованием, чтобы потушить 6 пожаров на аэродроме Стальгорна.‡Löscht 6 Feuer auf dem Flugplatz von Eisenschmiede mit Eurer Feuerwehrausrüstung.‡아이언포지 비행장에 소방 장비를 사용해 6곳의 불을 꺼야 합니다.‡Utiliza el equipo antiincendios y extingue 6 fuegos en la Base Aérea de Forjaz.‡Utiliza el equipo antiincendios y extingue 6 fuegos en la Base Aérea de Forjaz.‡Utilisez la Lance d’incendie pour éteindre 6 foyers sur l’Aérodrome de Forgefer.‡使用灭火装置，扑灭铁炉堡飞行器机坪的6处大火。‡使用滅火設備，撲滅鐵爐堡機場上的6處火源。',
  }
},
[26079] = {
  {
    'Procura-se: Otto e Falcocrista‡Разыскивается: Отто и лорд Соколиный Шлем‡GESUCHT: Falkenstein und Otto‡오토와 팰컨크레스트 현상 수배!‡Se busca: Otto y Lord Falconcrest‡Se busca: Otto y Lord Falconcrest‡On recherche : Otto et Lépervier‡通缉！奥图和法库雷斯特‡通緝:奧圖和法庫雷斯特',
    nil,
    'Entregue a Cabeça de Otto e a Cabeça de Falcocrista para a Capitão Nélia na Ponta do Refúgio.‡Принесите головы Отто и Соколиного Шлема капитану Ниалс в Опорный пункт.‡Bringt Ottos und Falkensteins Köpfe zu Hauptmann Nials bei der Zuflucht.‡오토와 팰컨크레스트를 처치하고 그 증거로 머리카락을 임시 주둔지에 있는 부대장 나이얼스에게 가져가야 합니다.‡Llévale la cabeza de Otto y la de Lord Falconcrest a la capitana Nials en el Refugio de la Zaga.‡Llévale la cabeza de Otto y la de Lord Falconcrest a la capitana Nials en el Refugio de la Zaga.‡Apporter les Têtes de Lépervier et d\'Otto au capitaine Nials au Refuge de l\'Ornière.‡把奥图的徽记和法库雷斯特的徽记交给避难谷地的尼艾丝队长。‡把法庫雷斯特和奧圖的頭顱交給避難谷地的尼艾絲隊長。',
  }
},
[26080] = {
  {
    'Um último favor‡Последняя услуга‡Ein letzter Gefallen‡마지막 부탁‡Un último favor‡Un último favor‡Un dernier service‡最后的请求‡最後一個忙',
    nil,
    'Entregue o Filé com Dicas do Cavaclave para o Capitão Glovaal no Covil do Abismo Sombrio.‡Отнесите ройпоевскую рыбу в бумаге капитану Гловаалю в Темную пещеру.‡Bringt Grabungslieds Fisch und Tipps zu Kapitän Glovaal in der Dämmerbucht.‡어둠돌파 동굴에 있는 선장 글로바알에게 디그송의 생선과 도움말을 전달해야 합니다.‡Entrega pescados y recados de Buenacanción al capitán Glovaal en la Cala Brechaoscura.‡Entrega pescados y recados de Buenacanción al capitán Glovaal en la Cala Brechaoscura.‡Remettez les Poissons et tuyaux de Chante-fouilles au Capitaine Glovaal, dans la Crique du Sombre brisant.‡将掘歌的鲜鱼与便笺包交给驱暗海窟的格罗瓦船长。‡到黑裂灣去將掘曲的鮮魚和秘密情報遞交給葛羅沃船長。',
  }
},
[26081] = {
  {
    'A recompensa de Alina‡Награда Алины‡Alinas Belohnung‡앨리나의 포상‡La recompensa de Alina‡La recompensa de Alina‡La récompense d\'Alina‡阿莉娜的奖赏‡奧麗娜的獎勵',
    nil,
    'Fale com a Patrulheira Sombria Alina.‡Поговорите с темным следопытом Алиной.‡Sprecht mit Dunkelruferin Alina.‡어둠 순찰자 앨리나와 대화해야 합니다.‡Habla con la forestal oscura Alina.‡Habla con la forestal oscura Alina.‡Parlez au Forestier-sombre Alina.‡跟黑暗游侠奥丽娜谈一谈。‡和黑暗遊俠奧麗娜說話。',
  }
},
[26082] = {
  {
    'Rumo à Chaga de Guerra!‡К Боевому Шраму!‡Auf nach Kriegsnarbe!‡전투의 흉터로!‡¡A la Marca de Guerra!‡¡A la Marca de Guerra!‡À bas la Balafre !‡去战痕谷！‡到戰痕去!',
    nil,
    'Use o Demolidor de Krom\'gar para destruir 5 Lançadoras de Glaives Darnassianas e quaisquer 20 Soldados da Aliança no Vale Chaga de Guerra.‡С помощью кром\'гарского разрушителя убейте 5 дарнасских метателей глеф и 20 любых солдат Альянса в долине Боевого Шрама.‡Benutzt den Verwüster von Krom\'gar, um 5 darnassische Glevenschleudern und 20 beliebige Soldaten der Allianz im Kriegsnarbental zu vernichten.‡전투의 흉터 계곡에서 크롬가르 파괴전차를 이용하여 다르나서스 수리검 투척기 5대를 파괴하고 얼라이언스 병사 20명을 처치해야 합니다.‡Utiliza el demoledor Krom\'gar para matar a 5 lanzagujas darnassianos y a 20 soldados de la Alianza cualesquiera en el Valle Marca de Guerra.‡Utiliza el demoledor Krom\'gar para matar a 5 lanzagujas darnassianos y a 20 soldados de la Alianza cualesquiera en el Valle Marca de Guerra.‡Utilisez le Démolisseur de Krom’gar pour détruire 5 Lanceurs de glaive darnassiens et 20 Soldats de l’Alliance, dans la Balafre.‡用克罗姆加攻城车摧毁战痕谷的5辆达纳苏斯投刃车和20名联盟士兵。‡在戰痕山谷用克羅姆加石毀車摧毀5個達納蘇斯旋刃投擲器，與20個聯盟士兵。',
  }
},
[26083] = {
  {
    'Olá, Lolo‡Привет, Лоло‡Hallo Lolo‡안녕 롤로‡Hola Lolo‡Hola Lolo‡Salut Lolo !‡你好鲁鲁‡哈囉魯魯',
    nil,
    'Encontre Lolo, o Olheiro, na Enseada de Faldir.‡Найдите дозорного Лоло в бухте Фальдира.‡Findet Lolo den Ausguck in der Faldirbucht.‡팔디르의 만에 있는 망꾼 롤로를 찾아야 합니다.‡Busca a Lolo en la Atalaya de la Cala de Faldir.‡Busca a Lolo en la Atalaya de la Cala de Faldir.‡Trouver Lolo le Guetteur dans la Crique de Faldir.‡在法迪尔海湾的瞭望台上找到鲁鲁。‡到法迪爾海灣找哨兵魯魯。',
  }
},
[26084] = {
  {
    'Ruína do Martelo‡Павший Молот‡Hammerfall‡망치 주둔지‡Sentencia‡Sentencia‡Le Trépas-d\'Orgrim‡落锤镇‡落錘鎮',
    nil,
    'Apresente-se a Gor\'mul na Ruína do Martelo, que fica no Planalto Arathi.‡Отправляйтесь с докладом к Гор\'мулю в Павший Молот, что на Нагорье Арати.‡Meldet Euch bei Gor\'mul in Hammerfall im Arathibecken.‡아라시 고원의 망치 주둔지에 있는 고르멀에게 보고해야 합니다.‡Preséntate ante Gor\'mul en Sentencia en las Tierras Altas de Arathi.‡Preséntate ante Gor\'mul en Sentencia en las Tierras Altas de Arathi.‡Rendez-vous auprès de Gor’mul au Trépas-d’Orgrim, dans les Hautes-terres Arathies.‡去找阿拉希高地落锤镇的戈穆尔。‡到阿拉希高地的落錘鎮向戈莫爾回報。',
  }
},
[26085] = {
  {
    'É bom para o moral‡Сплочение защитников‡Sammelt die Verteidiger‡투지의 경비병‡Reforzando las defensas‡Reforzando las defensas‡Rendre courage aux défenseurs‡鼓舞防御者‡集結防衛者',
    nil,
    'Finque 8 Estandartes de Altaforja nos montes de Neve Fofa ao longo da Base Aérea de Altaforja.‡Установите 8 знамен Стальгорна над сугробами из рыхлого снега в разных частях аэродрома Стальгорна.‡Platziert 8 Banner von Eisenschmiede in Hügel aus losem Schnee überall auf dem Flugplatz von Eisenschmiede.‡아이언포지 비행장 곳곳에 있는 살짝 쌓인 눈더미에 아이언포지 깃발 8개를 꽃아야 합니다.‡Coloca 8 estandartes de Forjaz en montañas de nieve blanda por toda la Base Aérea de Forjaz.‡Coloca 8 estandartes de Forjaz en montañas de nieve blanda por toda la Base Aérea de Forjaz.‡Plantez 8 Bannières de Forgefer dans des monticules de Neige molle, partout dans l’Aérodrome de Forgefer.‡在铁炉堡飞行器机坪的松散的雪堆上插上8面铁炉堡旗帜。‡將8面鐵爐堡旌旗豎立在鐵爐堡機場各處的鬆軟的雪堆上。',
  }
},
[26086] = {
  {
    'Orako‡Орако‡Orako‡오라코‡Orako‡Orako‡Orako‡欧纳柯‡歐拉寇',
    nil,
    'Apresente-se a Orako na Garganta Telúmina, que fica em Vashj\'ir.‡Поговорите с Орако в Затемненной впадине в Вайш\'ире.‡Meldet Euch bei Orako bei der Tiefenlichtkluft in Vashj\'ir.‡바쉬르의 미명 협곡에 있는 오라코에게 보고해야 합니다.‡Informa a Orako en el Cañón Sondaluz, en Vashj\'ir.‡Informa a Orako en el Cañón Sondaluz, en Vashj\'ir.‡Présentez-vous à Orako au Canyon de Terradiance, en Vashj’ir.‡前往瓦丝琪尔的光渊海峡，向欧纳柯报到。‡到瓦許伊爾的冷光裂口向歐拉蔻回報。',
  }
},
[26087] = {
  {
    '"Suco fluorescente"‡"Светящийся сок"‡Leuchtsaft‡"빛나는 즙"‡"Zumo brillante"‡"Zumo brillante"‡« Jus luminescent »‡发光的浓汁‡「微光果汁」',
    nil,
    'Obtenha 6 amostras de Suco Fluorescente de Caranguejos-aranha Fogaça e Garoupas Luxescala na Garganta Telúmina.‡Добудьте 6 порций светящегося сока из огнепанцирных крабов и блестящих окуней в Затемненной впадине.‡Besorgt Euch 6 Einheiten Leuchtsaft von den Pyropanzerkrabblern und Luxschuppenbarschen in der Tiefenlichtkluft.‡미명 협곡에 사는 장작껍질게와 형광비늘농어에게서 빛나는 즙 6잔을 얻어야 합니다.‡Consigue 6 pegotes de zumo brillante de hundidores Piroconcha y meros Escama Luminosa en el Cañón Sondaluz.‡Consigue 6 pegotes de zumo brillante de hundidores Piroconcha y meros Escama Luminosa en el Cañón Sondaluz.‡Récupérez 6 doses de Jus luminescent sur des Carapateurs pyrocoques et des Mérous luxécailles, dans le Canyon de Terradiance.‡从光渊海峡的赤壳凿孔蟹和光鳞石斑鱼身上收集6份发光的浓汁。‡在光底峽谷從炎殼蟹和華鱗石斑魚身上取得6份微光果汁。',
  }
},
[26088] = {
  {
    'Aqui, peixinho‡Ловись, рыбка!‡Hierher, Fischlein Fischlein!‡물고기야 이리 와라‡Pescadito, pescadito‡Pescadito, pescadito‡Laissez venir à moi les petits poissons‡小鱼儿，来吧来吧‡來吧小魚兒',
    nil,
    'Coloque o Chapéu de Peixe. Em seguida, nade pelas algas na Garganta Telúmina para atrair 30 Mordiscadores Telúminos.‡Наденьте шляпу рыболова и проплывите через заросли водорослей в Затемненной впадине, чтобы привлечь 30 люминесцентных гирелл.‡Setzt den Fischerhut auf und schwimmt durch die Korallen in der Tiefenlichtkluft, um 30 Tiefenlichtknabberfische anzulocken.‡낚시 모자를 쓰고 미명 협곡 내에 있는 산호 사이를 수영하며 미명 야금치 30마리를 유인해야 합니다.‡Ponte el sombrero de pescado y nada a través del coral en el Cañón Sondaluz para atraer a 30 mordisqueadores Luz Fría.‡Ponte el sombrero de pescado y nada a través del coral en el Cañón Sondaluz para atraer a 30 mordisqueadores Luz Fría.‡Mettez le Chapeau à poisson, puis nagez dans le corail du Canyon de Terradiance pour attirer 30 Grignoteurs de Terradiance.‡戴上捕鱼帽，游过光渊海峡的海藻丛，吸引30条光渊利齿鱼。‡將魚帽戴上，然後游過光底峽谷裡的海藻以吸引30隻光底啃咬者。',
  }
},
[26089] = {
  {
    'Morra, homem-peixe! Morra!‡Я убью тебя, рыба‡Stirb, Fischmann, stirb‡물고기 인간은 저리 가라‡Muerte al hombre pez‡Muerte al hombre pez‡Tremblez, hommes-poissons !‡死吧，鱼人！‡死吧魚人死吧',
    nil,
    'Mate 4 Caçadores de Luz Fria e 4 Oráculos de Luz Fria.‡Убейте 4 охотников Холодного Сияния и 4 оракулов Холодного Сияния.‡Tötet 4 Tiefenlichtjäger und 4 Tiefenlichtorakel.‡시린빛 사냥꾼 4마리와 시린빛 점쟁이 4마리를 처치해야 합니다.‡Mata a 4 cazadores Luz Fría y a 4 oráculos Luz Fría.‡Mata a 4 cazadores Luz Fría y a 4 oráculos Luz Fría.‡Tuez 4 Chasseurs et 4 Oracles froide-lumière.‡杀死4个寒光猎手和4个寒光智者。‡殺死4位冷光獵手和4位冷光神諭者。',
  }
},
[26090] = {
  {
    'Eu trouxe este ovo para você‡Я принес тебе икринку‡Hier, ein Ei!‡알 배달이오‡Te he traído este huevo‡Te he traído este huevo‡Je vous ai apporté des nœ-nœufs‡这枚卵交给你‡我帶給你這顆蛋',
    nil,
    'Entregue o Ovo Gigante de Enguia a Orako na Garganta Telúmina, que fica em Vashj\'ir.‡Отнесите огромную икринку угря Орако в Затемненную впадину в Вайш\'ире.‡Bringt das enorme Aalei zu Orako bei der Tiefenlichtkluft in Vashj\'ir.‡바쉬르의 미명 협곡에 있는 오라코에게 거대한 뱀장어 알을 가져가야 합니다.‡Entrega el huevo de anguila enorme a Orako en el Cañón Sondaluz, en Vashj\'ir.‡Entrega el huevo de anguila enorme a Orako en el Cañón Sondaluz, en Vashj\'ir.‡Remettez l’Énorme œuf d’anguille à Orako dans le Canyon de Terradiance, en Vashj’ir.‡将巨大的鳗鱼卵交给瓦丝琪尔光渊海峡底部的欧纳柯。‡將超大巨鰻蛋送去瓦許伊爾的冷光裂口給歐拉蔻。',
  }
},
[26091] = {
  {
    'Aqui, peixinho 2: omelete de ovo de enguia‡Ловись, рыбка – 2: фокус с икринкой угря‡Hierher, Fischlein Fischlein, Teil 2: Der Eier-Aal-Trick-Blues‡물고기야 이리 와라 2: 뱀장어 알과 춤을‡Pescadito, pescadito 2: El Retorno del Huevo‡Pescadito, pescadito 2: El Retorno del Huevo‡Laissez venir à moi les petits poissons 2 : omelette explosive‡鱼儿鱼儿看过来2：鳗鱼卵大爆炸‡來吧小魚兒2:鰻蛋詭計搖擺舞',
    nil,
    'Use o Dispositivo Enguiexplosivo perto de uma Grandenguia Tortuosa na Garganta Telúmina. Então, derrote a Grandenguia Enfraquecida.‡При помощи угретонатора взорвите ужасного огромного угря в Затемненной впадине, а затем добейте раненого угря.‡Benutzt das aal-splosive Gerät in der Nähe eines verschlagenen Großaals in der Tiefenlichtkluft und besiegt dann den geschwächten Großaal.‡뱀장어 철퍽폭파 장치를 미명 협곡에 사는 약삭빠른 왕뱀장어 근처에서 사용한 후, 약해진 왕뱀장어를 처치해야 합니다.‡Usa el dispositivo anguilexplosivo cerca de una gran anguila taimada en el Cañón Sondaluz. Después, derrota a la gran anguila debilitada.‡Usa el dispositivo anguilexplosivo cerca de una gran anguila taimada en el Cañón Sondaluz. Después, derrota a la gran anguila debilitada.‡Utilisez l’Œuf d’anguille explosif près d’une Grande anguille sournoise dans le Canyon de Terradiance, puis achevez la Grande anguille affaiblie.‡在光渊海峡的扭曲的巨海鳗附近使用鳗鱼爆破装置，然后击败被削弱的巨鳗。‡在光底峽谷的狡詐的巨鰻附近引爆鰻魚爆炸裝置，然後擊敗衰弱的巨鰻。',
  }
},
[26092] = {
  {
    'Relatório do Orako‡Донесение Орако‡Orakos Bericht‡오라코의 보고서‡El informe de Orako‡El informe de Orako‡Le rapport d’Orako‡欧纳柯的报告‡歐拉寇的報告',
    nil,
    'Entregue o Relatório do Orako ao Capitão "Julho" Verne na Caverna Tenebrosa.‡Отнесите донесение Орако капитану "Жуху" Верну в Зловещий грот.‡Bringt Orakos Bericht zu Kapitän "Juwel" Verne in der Schattenhöhle.‡음침한 동굴에 있는 선장 "주얼스" 베른에게 오라코의 보고서를 전달해야 합니다.‡Entrega el Informe de Orako al capitán "Julios" Verne en la Caverna Tenebrosa.‡Entrega el Informe de Orako al capitán "Julios" Verne en la Caverna Tenebrosa.‡Remettez le Rapport d’Orako au Capitaine Jules « Verni » dans la Caverne ténébreuse.‡将欧纳柯的报告交给阴暗洞穴的凡尔纳·“珍宝”船长。‡將歐拉蔻的報告送去陰暗洞穴給維恩「珠寶」船長。',
  }
},
[26093] = {
  {
    'Casa Grande do Norte‡Северное поместье‡Nordhof‡북부습곡 장원‡Mansión Redilnorte‡Mansión Redilnorte‡Le manoir de Nordclos‡诺斯弗德农场‡諾斯弗德農場',
    nil,
    'Mate 10 membros da Camarilha na Casa Grande do Norte.‡Убейте 10 наемников Стромгарда в Северном поместье.‡Tötet 10 Mitglieder des Syndikats.‡북부습곡 장원에 있는 비밀결사대 대원 10명을 처치해야 합니다.‡Mata a 10 mercenarios de la Hermandad en la Mansión Redilnorte.‡Mata a 10 mercenarios de la Hermandad en la Mansión Redilnorte.‡Tuez 10 membres du Syndicat au Manoir de Norclos.‡在诺斯弗德农场杀死10名辛迪加雇佣兵。‡在諾斯弗德農場殺死10名辛迪加雇傭兵。',
  }
},
[26094] = {
  {
    'O revide‡Ответный удар‡Gegenschlag‡반격‡El contraataque‡El contraataque‡La défense s\'organise‡反击‡反攻',
    nil,
    'Embarque no Bombardeiro Consertado e use a Bomba Martelo de Ferro para matar 30 atacantes Ferro Negro. Você pode matar quaisquer anões Ferro Negro ou seus aliados na Base Aérea de Altaforja.‡Поднимитесь в воздух на отремонтированном бомбардировщике и при помощи железных штурмовых бомб убейте 30 атакующих Черного Железа. Можно убивать любых дворфов Черного Железа или их союзников на аэродроме Стальгорна.‡Steigt in den reparierten Bomber und tötet 30 Angreifer der Dunkeleisenzwerge mit der Eisenhammerbombe. Ihr könnt beliebige Dunkeleisenzwerge oder ihre Verbündeten auf dem Flugplatz töten.‡수리한 폭격기를 타고 비행하며 철제 망치 폭탄을 이용해 검은무쇠 드워프 30명을 처치해야 합니다. 아이언포지 비행장에 있는 검은무쇠 드워프들이나 그들의 동맹군도 처치할 수 있습니다.‡Embarca en el bombardero reparado y utiliza la bomba de martillo de hierro para matar a 30 agresores Hierro Negro. Puedes matar a cualquier enano Hierro Negro o a sus aliados en la Base Aérea de Forjaz.‡Embarca en el bombardero reparado y utiliza la bomba de martillo de hierro para matar a 30 agresores Hierro Negro. Puedes matar a cualquier enano Hierro Negro o a sus aliados en la Base Aérea de Forjaz.‡Montez à bord du Bombardier réparé et larguez les Bombes de Forgefer pour tuer 30 Attaquants sombrefers. Vous pouvez tuer n’importe quel nain sombrefer ainsi que leurs alliés à l’Aérodrome de Forgefer.‡登上修复的轰炸机，使用铁锤炸弹杀死30名黑铁矮人。铁炉堡飞行器机坪上的任何黑铁矮人以及他们的盟友都算。‡登上修復的轟炸機，用鐵錘炸彈殺死30個黑鐵攻擊者。你可以殺死任何黑鐵矮人，或是他們在鐵爐堡機場上的其他盟軍。',
  }
},
[26095] = {
  {
    'Insígnias de Stromgarde‡Знаки Стромгарда‡Abzeichen von Stromgarde‡스트롬가드 휘장‡Distintivos de Stromgarde‡Distintivos de Stromgarde‡Les écussons de Stromgarde‡激流堡徽章‡激流堡徽章',
    nil,
    'Consiga 7 Insígnias de Stromgarde dos integrantes da Camarilha na Bastilha de Stromgarde.‡Отберите 7 знаков Стромгарда у членов Синдиката в крепости Стромгард.‡Erbeutet 7 Abzeichen von Stromgarde vom feindlichen Syndikat in Burg Stromgarde.‡스트롬가드 요새에 있는 비밀결사대에게서 스트롬가드 휘장 7개를 모아야 합니다.‡Consigue 7 distintivos de Stromgarde de enemigos de la Hermandad en el Castillo de Stromgarde.‡Consigue 7 distintivos de Stromgarde de enemigos de la Hermandad en el Castillo de Stromgarde.‡Collectez 7 Écussons de Stromgarde sur des membres du Syndicat au Donjon de Stromgarde.‡从激流堡的敌人身上获得7枚激流堡徽章。‡從激流堡中的辛迪加敵人身上取得7個激流堡徽章。',
  }
},
[26096] = {
  {
    'Cogumelos escaldantes‡Жгучие грибы‡Verbrühende Pilze‡끓어오르는 마법버섯‡Setas escaldantes‡Setas escaldantes‡Les champis brûlants‡烫灼之菇‡滾燙蕈菇',
    nil,
    'Colete 5 Cogumelos Escaldantes.‡Соберите 5 жгучих грибов.‡Sammelt 5 Verbrühende Pilze.‡끓어오르는 마법버섯 5개를 모아야 합니다.‡Reúne 5 setas escaldantes.‡Reúne 5 setas escaldantes.‡Cueillez 5 Champignons brûlants.‡收集5颗烫灼之菇。‡收集5個火羽蕈菇。',
  }
},
[26097] = {
  {
    'Prova de mentiras‡Доказательство лжи‡Beweis für eine Lüge‡거짓의 증거‡Demostrar lo incierto‡Demostrar lo incierto‡Preuve à l\'appui‡谎言的证明‡說謊的證據',
    nil,
    'Encontre Orthus no Bosque de Thal\'darah, que fica na Cordilheira das Torres de Pedra.‡Найдите Ортия в роще Тал\'дара в Когтистых горах.‡Findet Orthus im Hain von Thal\'darah im Steinkrallengebirge.‡돌발톱 산맥의 탈다라 숲에서 오르투스를 찾아야 합니다.‡Encuentra a Orthus en la Arboleda de Thal\'darah, en Sierra Espolón.‡Encuentra a Orthus en la Arboleda de Thal\'darah, en Sierra Espolón.‡Retrouvez Orthus au Bosquet de Thal’darah, dans les Serres-Rocheuses.‡去找石爪山脉萨达拉林地的奥修斯。‡到石爪山脈的薩歐達拉樹林裡找歐蘇斯。',
  }
},
[26098] = {
  {
    'Traição no bosque‡Предательство в чаще‡Verrat im Hain‡숲에서 일어난 배신‡Traición en la arboleda‡Traición en la arboleda‡Trahison au bosquet‡林地里的背叛‡樹林裡的背叛',
    nil,
    'Leve a Insígnia do General de Krom\'gar de volta ao Grande Chefe Andarilho da Montanha no Posto Andarilho da Montanha, que fica na Cordilheira das Torres de Pedra.‡Отнесите знак различия кром\'гарского генерала верховному вождю Скалоступу на Плато Скалоступов в Когтистых горах.‡Bringt das Insigne des Generals von Krom\'gar zurück zu Oberhäuptling Klippenläufer am Klippenläuferposten im Steinkrallengebirge.‡크롬가르 장군의 계급장을 돌발톱 산맥의 절벽지기 초소에 있는 대부족장 클리프워커에게 가져가야 합니다.‡Entrega la insignia de General Krom\'gar al gran cabecilla Caminarrisco en el Puesto Caminarrisco, en Sierra Espolón.‡Entrega la insignia de General Krom\'gar al gran cabecilla Caminarrisco en el Puesto Caminarrisco, en Sierra Espolón.‡Rapportez l’Insigne de général de Krom’gar au Grand chef Rôde-falaise au Poste de Rôde-falaise, dans les Serres-Rocheuses.‡把克罗姆加将军的徽章带给石爪山脉峭壁行者哨站的峭壁行者族长。‡將克羅姆加將軍的徽印帶回石爪山脈的崖行者崗哨交給大酋長崖行者。',
  }
},
[26099] = {
  {
    'Isso é justiça?‡Это ли правосудие?‡Das soll Gerechtigkeit sein?‡이것이 정의인가?‡¿Esto es justicia?‡¿Esto es justicia?‡Est-ce là la justice ?‡这是正义吗？‡這是正義嗎?',
    nil,
    'Defenda-se.‡Защитите себя.‡Verteidigt Euch.‡자신을 방어해야 합니다.‡Defiéndete.‡Defiéndete.‡Défendez-vous.‡自卫。‡保護你自己。',
  }
},
[26100] = {
  {
    'O general está morto‡Генерал мертв‡Der General ist tot‡장군의 사망‡El General ha muerto‡El General ha muerto‡Le général est mort‡将军死了‡將軍已死',
    nil,
    'Fale com o Suserano Krom\'gar na Fortaleza Krom\'gar, que fica na Cordilheira das Torres de Pedra.‡Поговорите с властителем Кром\'гаром в крепости Кром\'гар в Когтистых горах.‡Sprecht mit Oberanführer Krom\'gar in der Feste Krom\'gar im Steinkrallengebirge.‡돌발톱 산맥의 크롬가르 요새에 있는 대군주 크롬가르와 대화해야 합니다.‡Habla con el señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Habla con el señor supremo Krom\'gar en la Fortaleza Krom\'gar, en Sierra Espolón.‡Parlez au Suzerain Krom’gar à la Forteresse de Krom’gar, dans les Serres-Rocheuses.‡跟石爪山脉克罗姆加壁垒的克罗姆加大王谈一谈。‡到石爪山脈的克羅姆加堡壘與霸主克羅姆加交談。',
  }
},
[26101] = {
  {
    'Contra a força não há argumento‡Прав сильнейший‡Über dem Gesetz‡힘으로 바로잡기‡El poder otorga el derecho‡El poder otorga el derecho‡La raison du plus fort…‡力量才是正义‡或許能補救',
    nil,
    'Encontre o Suserano Krom\'gar no Posto Andarilho da Montanha, que fica na Cordilheira das Torres de Pedra.‡Встретьтесь с властителем Кром\'гаром на Плато Скалоступов в Когтистых горах.‡Trefft Oberanführer Krom\'gar am Klippenläuferposten im Steinkrallengebirge.‡돌발톱 산맥의 절벽지기 초소에서 대군주 크롬가르를 만나야 합니다.‡Reúnete con el señor supremo Krom\'gar en el Puesto Caminarrisco, en Sierra Espolón.‡Reúnete con el señor supremo Krom\'gar en el Puesto Caminarrisco, en Sierra Espolón.‡Rejoignez le Suzerain Krom’gar au Poste de Rôde-falaise, dans les Serres-Rocheuses.‡去找石爪山脉峭壁行者哨站的克罗姆加大王。‡到石爪山脈的崖行者崗哨與霸主克羅姆加見面。',
  }
},
[26102] = {
  {
    'O fim de Sinistracha‡Кончина Лютореза‡Grimmaxts Ende‡그림액스 장군 처치‡El deceso de Hacha Macabra‡El deceso de Hacha Macabra‡La défaite de Hache-sinistre‡恐斧的末日‡巨斧之死',
    nil,
    'Mate o General Sinistracha na Base Aérea de Altaforja.‡Убейте генерала Лютореза на аэродроме Стальгорна.‡Tötet General Grimmaxt auf dem Flugplatz von Eisenschmiede.‡아이언포지 비행장에 있는 장군 그림액스를 처치해야 합니다.‡Mata al general Hacha Macabra en la Base Aérea de Forjaz.‡Mata al general Hacha Macabra en la Base Aérea de Forjaz.‡Tuez le Général Hache-sinistre à l’Aérodrome de Forgefer.‡杀死铁炉堡飞行器机坪的恐斧将军。‡殺死鐵爐堡機場的巨斧將軍。',
  }
},
[26103] = {
  {
    'Biocombustível‡Биотопливо‡Biotreibstoff‡생체 연료‡Biocarburante‡Biocarburante‡Biocarburant‡生物燃料‡生質燃料',
    nil,
    'Use a Bomba de Extração de Óleo nos cadáveres de Tartarugas Onda do Mar, Rêmoras das Profundezas e Cabeças de Martelo Espinhescama na Ruína de Kothrun para obter 4 amostras de Óleo de Tartaruga, 4 amostras de Óleo de Rêmora e 4 amostras de Óleo de Tubarão Martelo.‡С помощью жироотсоса добудьте в Краю Кортуна по 4 банки черепашьего жира, жира прилипалы и жира акулы-молота из тел водорослевых черепах, прилипал-чистильщиков и чешуеспинных акул-молотов.‡Benutzt die Ölextraktionspumpe an den Kadavern von Meeresdickichtschildkröten, Kolkschiffshaltern und Dornenschuppenhammerhaien in Korthuns Ende, um 4 Einheiten Schildkrötenöl, 4 Einheiten Schiffshalteröl und 4 Einheiten Hammerhaiöl zu sammeln.‡바다덤불거북, 청소부빨판상어, 가시비늘귀상어의 시체에 기름 추출 펌프를 사용하여 거북이 기름 4개, 빨판상어 기름 4개, 귀상어 기름 4개를 얻어야 합니다.‡Usa la bomba de extracción de aceite en los cadáveres de tortugas de agua dulce Malezamarina, rémoras Registraintestinos y tiburones martillo Escamaespina en el Fin de Korthun para obtener 4 unidades de aceite de tortuga de agua dulce, 4 de aceite de rémora y 4 de aceite de tiburón martillo.‡Usa la bomba de extracción de aceite en los cadáveres de tortugas de agua dulce Malezamarina, rémoras Registraintestinos y tiburones martillo Escamaespina en el Fin de Korthun para obtener 4 unidades de aceite de tortuga de agua dulce, 4 de aceite de rémora y 4 de aceite de tiburón martillo.‡Utilisez la Pompe à extrusion oléagineuse sur les cadavres de Cistudes frôlemer, de Rémoras racletripes et de Requins-marteaux épinécailles à la Fin de Korthun afin d’obtenir 4 fioles d’Huile de cistude, 4 fioles d’Huile de rémora et 4 fioles d’Huile de requin-marteau.‡前往库图恩之末，对画笔海岭潜水龟、亮腹鮣魚和脊鳞锤头鲨的尸体使用油脂吸收泵，收集4份龟油、4份鮣魚油和4份锤头鲨鱼油。‡到寇爾蘇恩之歿去，在海拂鑽紋龜、通腸印魚及脊鱗雙髻鯊的屍體上使用榨油幫浦，以取得4份鑽紋龜油、4份印魚魚油，與4份錘頭鯊魚油。',
  }
},
[26104] = {
  {
    '‡Подводные соседи‡Holt das Lasso raus‡해저 이웃‡Nuestros vecinos acuáticos‡‡Nos voisins syngnathidés‡海中的邻居‡',
    nil,
    '‡С помощью лассо поймайте среди водорослей на вершине башен Края Кортуна 5 испуганных морских коньков.‡Benutzt das Seepferdchenlasso in der Nähe des Tangs auf den Säulen in Korthuns Ende, um 5 panische Seepferdchen zu fangen.‡코르툰의 최후에 있는 기둥 꼭대기에서 해마 올가미를 사용하여 겁먹은 해마 5마리를 생포해야 합니다.‡Usa el lazo de caballito de mar cerca de las algas sobre los pilares del Fin de Korthun para capturar a 5 caballitos de mar aterrados.‡‡Utilisez le Lasso à hippocampe près du varech, au sommet des piliers de la Fin de Korthun, pour capturer 5 Hippocampes paniqués.‡在库图恩之末台柱顶端的海藻丛附近使用海马套索，捕获5只惊慌的海马。‡',
  }
},
[26105] = {
  {
    'Reivindicando a Ruína de Korthun‡Защита Края Кортуна‡Erobert Korthuns Ende‡코르툰의 최후를 차지하라‡Reclamando el Fin de Korthun‡Reclamando el Fin de Korthun‡Revendiquer la Fin de Korthun‡保卫库图恩之末‡取下寇爾蘇恩之歿',
    nil,
    'Mate 7 Lobos-do-mar Grito Infernal na Ruína de Kothrun.‡Убейте 7 морских волков Адского Крика в Краю Кортуна.‡Tötet 7 von Höllschreis Seebären in Korthuns Ende.‡코르툰의 최후에서 헬스크림 뱃사람 7명을 처치해야 합니다.‡Mata a 7 lobos de mar Grito Infernal en el Fin de Korthun.‡Mata a 7 lobos de mar Grito Infernal en el Fin de Korthun.‡Tuez 7 Loups de mer de Hurlenfer à la Fin de Korthun.‡在库图恩之末杀死7名地狱咆哮水兵。‡在寇爾蘇恩之歿殺死7名地獄吼老練水兵。',
  }
},
[26106] = {
  {
    'Combustologia 1‡Топливоведение-101‡Treibstoffologie leicht gemacht‡연료학 101‡Experimentos con carburante‡Experimentos con carburante‡Carburologie niveau un‡初级燃料学‡燃料學科101',
    nil,
    'Use a Estação de Amostragem de Combustível no Covil do Abismo Sombrio para criar o biocombustível perfeito.‡Создайте идеальное биотопливо при помощи стола для приготовления топливных образцов в Темной пещере.‡Benutzt die Treibstofftestanlage in der Dämmerbucht, um den perfekten Biotreibstoff herzustellen.‡어둠돌파 동굴에 있는 연료 표본 작업대에서 완벽한 생체 연료를 만들어야 합니다.‡Usa la estación de muestras de combustible en la Cala Brechascura para crear el biocarburante perfecto.‡Usa la estación de muestras de combustible en la Cala Brechascura para crear el biocarburante perfecto.‡Utilisez le Poste d’échantillonnage de carburant à la Crique du Sombre brisant pour créer le parfait biocarburant.‡使用驱暗海窟的燃料采样站制造完美的生物燃料。‡到黑裂灣的燃料採樣站去創造出完美的生質燃料。',
  }
},
[26107] = {
  {
    'Espíritos elevados‡Вызов духов‡Stimmungsaufheller‡기운 북돋기‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡振奮精神',
    nil,
    'Consiga 10 Olhos de Raptores do Planalto matando os Andarilhos do Planalto ou os Espancadores do Planalto.‡Соберите 10 глаз ящеров нагорья, убив долгоногов нагорья или твердозубов нагорья.‡Erbeutet 10 Hochlandraptoraugen von Hochlandschreitern oder Hochlandhauern.‡줄무늬 고원랩터나 외뿔 고원랩터에게서 고원랩터 눈 10개를 모아야 합니다.‡Consigue 10 ojos de raptor de las Tierras Altas de zancudos de las Tierras Altas o de descarnadores de las Tierras Altas.‡Consigue 10 ojos de raptor de las Tierras Altas de zancudos de las Tierras Altas o de descarnadores de las Tierras Altas.‡Récupérez 10 Yeux de raptor des hautes-terres sur les Arpenteurs des hautes-terres et les Vandales des hautes-terres.‡从高地阔步龙和高地长尾龙身上取得10个高地迅猛龙的眼球。‡從高地闊步龍或高地長尾龍那裡收集10顆高地迅猛龍的眼球。',
  }
},
[26108] = {
  {
    'A astúcia dos raptores‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡迅猛龍的狡詐',
    nil,
    'Consiga 12 Corações de Raptores dos Espreitacarnes do Planalto.‡Соберите 12 сердец ящеров, убив плотоглотов нагорья.‡Sammelt 12 Raptorherzen von Hochlandfleischpirschern.‡식인 고원랩터에게서 랩터 심장 12개를 얻어야 합니다.‡Consigue 12 corazones de raptor de acechacarnes de las Tierras Altas.‡Consigue 12 corazones de raptor de acechacarnes de las Tierras Altas.‡Récupérez 12 Cœurs de raptor sur des Charognards des hautes-terres.‡从高地猎兽龙身上获取12颗迅猛龙的心脏。‡從高地獵獸龍身上收集12顆迅猛龍的心臟。',
  }
},
[26109] = {
  {
    '‡Эй, там!‡Land in Sicht!‡육지다!‡¡Tierra a vista!‡¡Tierra a vista!‡Terre !‡法迪尔海湾‡發現陸地!',
    nil,
    '‡Поговорите с капитаном О\'Брином в бухте Фальдира, что на нагорье Арати.‡Sprecht mit Kapitän O\'Breen in der Faldirbucht im Arathihochland.‡아라시 고원의 팔디르의 만에 있는 선장 오브린과 대화해야 합니다.‡Habla con el capitán O\'Breen en la Cala de Faldir, en las Tierras Altas de Arathi.‡Habla con el capitán O\'Breen en la Cala de Faldir, en las Tierras Altas de Arathi.‡Parler au capitaine O\'Breen dans la Crique de Faldir, dans les Hautes-terres Arathies.‡跟阿拉希高地法迪尔海湾的奥布里船长谈一谈。‡',
  }
},
[26110] = {
  {
    'Como nos velhos tempos‡Как в старые добрые времена‡Wie in alten Zeiten‡그때 그 시절‡Como en los viejos tiempos‡Como en los viejos tiempos‡Comme en quarante !‡就像以前‡就像往日一般',
    nil,
    'Pegue a Pasta Lacrada da Mensageira Renegada.‡Заберите у курьера-Отрекшегося запечатанную папку.‡Nehmt dem Kurier der Verlassenen den versiegelten Ordner ab.‡포세이큰 급사에게서 봉인된 서류를 획득해야 합니다.‡Consigue la carpeta sellada de la mensajera Renegada.‡Consigue la carpeta sellada de la mensajera Renegada.‡Tuez la Messagère des Réprouvés pour lui prendre les Documents scellés.‡从被遗忘者信使身上拿到密封的信件。‡從被遺忘者信差身上取得密封的信件。',
  }
},
[26111] = {
  {
    'Ele virá‡...И он придет‡… und er wird kommen‡...모습을 드러내리라‡... Vendrá‡... Vendrá‡…Il répondra à votre appel‡……它会现身的‡...他將到來',
    nil,
    'Obtenha o Cérebro do Inconcebível.‡Раздобудьте мозг Непостижимого.‡Besorgt Euch das Gehirn des Unergründlichen.‡속을 알 수 없는 자의 뇌를 손에 넣어야 합니다.‡Consigue el cerebro del Inconmensurable.‡Consigue el cerebro del Inconmensurable.‡Obtenez le Cerveau de l’Insondable.‡取得不可估量者的触须。‡拿到高深莫測者的大腦。',
  }
},
[26112] = {
  {
    'Pedido de resposta‡Требование ответа‡Überfällige Antworten‡필요한 대답‡Pidiendo respuestas‡Pidiendo respuestas‡Explication exigée‡寻求答案‡尋求答覆',
    nil,
    'Leve o Relatório de Quebrapedra para Moira Thaurissan na Sala do Trono de Altaforja.‡Отнесите донесение Камнеломов Мойре Тауриссан к Высокому трону Стальгорна.‡Bringt Steinbrechers Bericht zu Moira Thaurissan im Hohen Sitz von Eisenschmiede.‡스톤브레이커의 보고서를 아이언포지의 왕좌에 있는 모이라 타우릿산에게 가져가야 합니다.‡Lleva el informe de Rompepedras a Moira Thaurissan ante El Trono de Forjaz.‡Lleva el informe de Rompepedras a Moira Thaurissan ante El Trono de Forjaz.‡Remettez le Rapport des Brise-pierres à Moira Thaurissan, au Haut siège de Forgefer.‡将碎石的报告交给铁炉堡王座厅的茉艾拉·铜须。‡將碎石的報告帶去鐵爐堡王座廳給茉艾拉‧銅鬚。',
  }
},
[26113] = {
  {
    'Quae e Kinelory‡Кви и Кинелори‡Quae und Kinelory‡쿠에와 키넬로리‡Quae y Kinelory‡Quae y Kinelory‡Quae et Kinelory‡奎艾和基恩洛‡奎艾和基恩洛',
    nil,
    'Encontre Quae no morro acima da Fazenda Go\'Shek.‡Найдите Кви на холме напротив фермы Го\'Шека.‡Findet Quae auf dem Hügel über Go\'sheks Hof.‡언덕 위에서 고셰크 농장을 내려다보고 있는 쿠에를 찾아야 합니다.‡Busca a Quae en la colina con vistas a la Granja de Go\'shek.‡Busca a Quae en la colina con vistas a la Granja de Go\'shek.‡Trouvez Quae sur la colline surplombant la Ferme de Go’shek.‡在俯瞰格沙克农场的山丘上找到奎艾。‡找到在山丘上觀察格沙克農場的奎艾。',
  }
},
[26114] = {
  {
    'Quae confia em você‡Кви верит тебе‡Quae vertraut Euch‡쿠에는 당신을 믿는다‡Quae confía en ti‡Quae confía en ti‡Quae vous fait confiance‡奎艾信任你‡奎艾的信任',
    nil,
    'Fale com Kinelory perto da Fazenda Go\'Shek no Planalto Arathi.‡Поговорите с Кинелори у фермы Го\'Шека на Нагорье Арати.‡Sprecht mit Kinelory nahe Go\'Sheks Hof im Arathihochland.‡아라시 고원의 고셰크 농장에 있는 키넬로리와 대화해야 합니다.‡Habla con Kinelory cerca de la Granja Go\'shek, en las Tierras Altas de Arathi.‡Habla con Kinelory cerca de la Granja Go\'shek, en las Tierras Altas de Arathi.‡Parlez à Kinelory près de la Ferme de Go’shek, dans les Hautes-terres d’Arathi.‡跟阿拉希高地格沙克农场的基恩洛谈一谈。‡在阿拉希高地的格沙克農場附近和基恩洛說話。',
  }
},
[26115] = {
  {
    'O que significa ser da Horda...‡Что значит быть Ордой…‡Sehen ist verstehen‡호드란...‡Para pertenecer a la Horda...‡Para pertenecer a la Horda...‡Être de la Horde…‡成为部落……‡像個部落人......',
    nil,
    'Aprenda o que significa ser da Horda.‡Узнайте, что значит быть Ордой.‡Versteht, was es bedeutet, zur Horde zu gehören.‡호드란 무엇인지 배워야 합니다.‡Aprende lo que significa pertenecer a la Horda.‡Aprende lo que significa pertenecer a la Horda.‡Apprenez ce que signifie faire partie de la Horde.‡了解一下成为部落意味着什么。‡學習身為部落人的意義。',
  }
},
[26116] = {
  {
    'O ataque de Kinelory‡Удар Кинелори‡Kinelory schlägt zu‡키넬로리 돌격‡Kinelory ataca‡Kinelory ataca‡Kinelory entre en action‡基恩洛出击‡基恩洛出擊',
    nil,
    'Proteja Kinelory até que ela volte para Quae.‡Защитите Кинелори во время ее возвращения к Кви.‡Beschützt Kinelory, bis sie zu Quae zurückkehrt.‡쿠에에게 돌아갈 때까지 키넬로리를 보호해야 합니다.‡Protege a Kinelory hasta que haya regresado con Quae.‡Protege a Kinelory hasta que haya regresado con Quae.‡Protégez Kinelory jusqu’à son retour auprès de Quae.‡保护基恩洛直到她回到奎艾处。‡保護基恩洛，直到她回到奎艾身邊。',
  }
},
[26117] = {
  {
    'Pela Costa Sul‡За Южнобережье‡Für Süderstade‡남녘해안을 위해‡Por Costasur‡Por Costasur‡Pour Austrivage‡为了南海镇‡為了南海鎮',
    nil,
    'Fale com a Comandante Amaren na Ponta do Refúgio.‡Вернитесь к командиру Амарену в Опорный пункт.‡Kehrt zu Kommandantin Amaren in der Zuflucht zurück.‡임시 주둔지에 있는 사령관 아마렌에게 가야 합니다.‡Vuelve con el comandante Amaren al Refugio de la Zaga.‡Vuelve con el comandante Amaren al Refugio de la Zaga.‡Retournez auprès du Commandant Amaren au Refuge de l’Ornière.‡去找避难谷地的阿玛伦指挥官。‡回去找避難谷地的阿瑪倫指揮官。',
  }
},
[26118] = {
  {
    'Peguem o Embaixador!‡Арестовать посла‡Fasst den Botschafter‡대사를 체포하라‡Detener al embajador‡Detener al embajador‡Arrêtez l\'ambassadeur‡逮捕大使‡捉拿大使',
    nil,
    'Vá até a Embaixada dos Ferro Negro e use as Algemas Inflexíveis para prender o Embaixador Skoriamalho.‡Отправляйтесь в посольство Черного Железа и воспользуйтесь прочными наручниками, чтобы арестовать посла Шлакомолота.‡Geht zur Botschaft der Dunkeleisenzwerge und verhaftet Botschafter Schlackenhammer mit Hilfe der stabilen Handfesseln.‡검은무쇠 대사관으로 가서 튼튼한 수갑으로 사절 슬래그해머를 체포해야 합니다.‡Ve a la embajada Hierro Negro y utiliza las esposas robustas para arrestar al embajador Martillo de Escoria.‡Ve a la embajada Hierro Negro y utiliza las esposas robustas para arrestar al embajador Martillo de Escoria.‡Allez à l’Ambassade des Sombrefers et utilisez les Solides menottes pour arrêter l’Ambassadeur Martel-scories.‡找到黑铁大使馆，使用坚实的镣铐逮捕熔锤大使。‡到黑鐵大使館，用結實的鐐銬逮捕戰錘大使。',
  }
},
[26119] = {
  {
    '‡‡‡FLAG - 우리 몫 되찾기 실행‡FLAG - Reclamando nuestra apuesta iniciada‡‡DRAPEAU – Claim our stake démarré‡‡',
    nil,
    nil,
  }
},
[26120] = {
  {
    'Os Presa do Dragão perderam a cabeça‡Драконья Пасть и драконы‡Der wahnsinnige Orc des Drachenmals‡광기에 빠진 용아귀 부족‡La demencia de los Faucedraco‡La demencia de los Faucedraco‡Les grandes Gueules-de-dragon‡疯狂的龙喉‡瘋狂的龍喉',
    nil,
    'Mate 12 Sequestradores de Dragonetes Presa do Dragão.‡Убейте 12 похитителей детенешей из клана Драконьей Пасти.‡Tötet 12 Welpendiebe des Drachenmals.‡용아귀 용도둑 12명을 처치해야 합니다.‡Mata a 12 robacrías Faucedraco.‡Mata a 12 robacrías Faucedraco.‡Tuez 12 Voleurs de dragonnets gueules-de-dragon.‡杀死12名龙喉偷猎者。‡殺死12個龍喉幼龍竊賊。',
  }
},
[26121] = {
  {
    'Reivindicando a Ruína de Korthun‡Защита Края Кортуна‡Erobert Korthuns Ende‡코르툰의 최후를 차지하라‡Reclamando el Fin de Korthun‡‡Revendiquer la Fin de Korthun‡保卫库图恩之末‡取下寇爾蘇恩之歿',
    nil,
    'Mate 7 Lobos-do-mar Grito Infernal na Ruína de Kothrun.‡Убейте 7 морских волков Адского Крика в Краю Кортуна.‡Tötet 7 von Höllschreis Seebären in Korthuns Ende.‡코르툰의 최후에서 헬스크림 뱃사람 7명을 처치해야 합니다.‡Mata a 7 lobos de mar Grito Infernal en el Fin de Korthun.‡‡Tuez 7 Loups de mer de Hurlenfer à la Fin de Korthun.‡在库图恩之末杀死7名地狱咆哮水兵。‡在寇爾蘇恩之歿殺死7名地獄吼老練水兵。',
  }
},
[26122] = {
  {
    'Consciência ambiental‡Защита окружающей среды‡Umweltbewusstsein‡환경 보전‡Conciencia medioambiental‡Conciencia medioambiental‡Respect environnemental‡环保意识‡環保意識',
    nil,
    'Use a Bomba de Extração de Óleo nos cadáveres de Tartarugas Onda do Mar, Rêmoras das Profundezas e Cabeças de Martelo Espinhescama na Onda do Mar para obter 4 amostras de Óleo de Tartaruga, 4 amostras de Óleo de Rêmora e 4 amostras de Óleo de Tubarão Martelo.‡Используйте жироотсос, чтобы добыть в Донных зарослях по 4 банки черепашьего жира, жира прилипалы и жира акулы-молота из тел водорослевых черепах, прилипал-чистильщиков и чешуеспинных акул-молотов.‡Benutzt die Ölextraktionspumpe an den Kadavern von Meeresdickichtschildkröten, Kolkschiffshaltern und Dornenschuppenhammerhaien in Korthuns Ende, um 4 Einheiten Schildkrötenöl, 4 Einheiten Schiffshalteröl und 4 Einheiten Hammerhaiöl zu sammeln.‡기름 추출 펌프를 바다덤불에 있는 바다덤불거북, 청소부빨판상어, 가시비늘귀상어 시체에 사용하여 거북이 기름 4개, 빨판상어 기름 4개, 귀상어 기름 4개를 얻어야 합니다.‡Usa la bomba de extracción de aceite en los cadáveres de tortugas de agua dulce Malezamarina, rémoras Registraintestinos y tiburones martillo Escamaespina en Malezamarina para obtener 4 unidades de aceite de tortuga de agua dulce, 4 de aceite de rémora y 4 de aceite de tiburón martillo.‡Usa la bomba de extracción de aceite en los cadáveres de tortugas de agua dulce Malezamarina, rémoras Registraintestinos y tiburones martillo Escamaespina en Malezamarina para obtener 4 unidades de aceite de tortuga de agua dulce, 4 de aceite de rémora y 4 de aceite de tiburón martillo.‡Utilisez la Pompe à extrusion oléagineuse sur les cadavres de Cistudes frôlemer, de Rémoras racletripes et de Requins-marteaux épinécailles à Frôlemer afin d’obtenir 4 fioles d’Huile de cistude, 4 fioles d’Huile de rémora et 4 fioles d’Huile de requin-marteau.‡前往画笔海岭，对画笔海岭潜水龟、亮腹鮣魚和脊鳞锤头鲨的尸体使用油脂吸收泵，收集4份龟油、4份鮣魚油和4份锤头鲨鱼油。‡到盛海林在海拂鑽紋龜，通腸印魚，脊鱗雙髻鯊身上使用榨油幫浦以取得4份鑽紋龜油，4份印魚油和4份雙髻鯊油。',
  }
},
[26123] = {
  {
    '‡В Вайш\'ире...‡Unterwasserwölfe‡‡Allá donde fueres...‡‡Lorsqu\'on est en Vashj\'ir…‡‡',
    nil,
    '‡С помощью лассо поймайте среди водорослей на вершине башен Донных зарослей 5 испуганных морских коньков.‡Benutzt das Seepferdchenlasso in der Nähe des Tangs auf den Säulen im Meeresdickicht, um 5 panische Seepferdchen zu fangen.‡‡Usa el lazo de caballito de mar cerca de las algas sobre los pilares en Malezamarina para capturar a 5 caballitos de mar aterrados.‡‡Utilisez le Lasso à hippocampe près du varech, au sommet des piliers de Frôlemer, pour capturer 5 Hippocampes paniqués.‡‡',
  }
},
[26124] = {
  {
    'Defenda a Onda do Mar‡Защита Донных зарослей‡Sichert das Meeresdickicht‡바다덤불을 확보하라‡Asegurando Malezamarina‡Asegurando Malezamarina‡Sécuriser Frôlemer‡保卫画笔海岭‡固守盛海林',
    nil,
    'Mate 7 Batedores dos Mares da Aliança na Onda do Mar.‡Убейте 7 морских разведчиков Альянса в Донных зарослях.‡Tötet 7 Meeresspäher der Allianz im Meeresdickicht.‡바다덤불에서 얼라이언스 바다정찰병 7명을 처치해야 합니다.‡Mata a 7 exploradores marinos de la Alianza en Malezamarina.‡Mata a 7 exploradores marinos de la Alianza en Malezamarina.‡Tuez 7 Éclaireurs marins de l’Alliance.‡在画笔海岭杀死7名联盟海军斥候。‡在盛海林裡殺死7名聯盟海探。',
  }
},
[26125] = {
  {
    'Defenda a Onda do Mar‡Защита Донных зарослей‡Sichert das Meeresdickicht‡바다덤불을 확보하라‡Asegurando Malezamarina‡‡Sécuriser Frôlemer‡保卫画笔海岭‡固守盛海林',
    nil,
    'Mate 7 Batedores dos Mares da Aliança na Onda do Mar.‡Убейте 7 морских разведчиков Альянса в Донных зарослях.‡Tötet 7 Meeresspäher der Allianz im Meeresdickicht.‡바다덤불에서 얼라이언스 바다정찰병 7명을 처치해야 합니다.‡Mata a 7 exploradores marinos de la Alianza en Malezamarina.‡‡Tuez 7 Éclaireurs marins de l’Alliance.‡在画笔海岭杀死7名联盟海军斥候。‡在盛海林裡殺死7名聯盟海探。',
  }
},
[26126] = {
  {
    'O combustível perfeito‡Идеальное топливо‡Der perfekte Treibstoff‡완벽한 연료‡El combustible perfecto‡El combustible perfecto‡Le carburant parfait‡完美的燃料‡最佳燃料',
    nil,
    'Use a Estação de Amostragem de Combustível na Caverna Tenebrosa para criar o biocombustível perfeito.‡Создайте идеальное биотопливо при помощи стола для приготовления топливных образцов в Зловещем гроте.‡Benutzt die Treibstofftestanlage in der Schattenhöhle, um den perfekten Biotreibstoff herzustellen.‡음침한 동굴에 있는 연료 표본 작업대에서 완벽한 생체 연료를 만들어야 합니다.‡Usa la estación de muestras de combustible en la Caverna Tenebrosa para crear el biocarburante perfecto.‡Usa la estación de muestras de combustible en la Caverna Tenebrosa para crear el biocarburante perfecto.‡Utilisez le Poste d’échantillonnage de carburant à la Caverne Ténébreuse pour créer le parfait biocarburant.‡使用阴暗洞穴的燃料采样站制造完美的生物燃料。‡在陰暗洞穴的燃料採樣站製作最佳的生質燃料。',
  }
},
[26127] = {
  {
    'O segredo do Martelo do Crepúsculo‡Явление Сумеречного Молота‡Die Enthüllung des Schattenhammers‡정체가 드러난 황혼의 망치단‡La revelación del Martillo Crepuscular‡La revelación del Martillo Crepuscular‡Bas les masques !‡发现暮光之锤‡揭發暮光之錘',
    nil,
    'Mate 12 membros do Martelo do Crepúsculo em Dun Modr.‡Убейте 12 сектантов из культа Сумеречного Молота.‡Tötet 12 Mitglieder des Schattenhammers in Dun Modr.‡던 모드르에서 황혼의 망치단 일원 12명을 처치해야 합니다.‡Mata a 12 miembros del Martillo Crepuscular en Dun Modr.‡Mata a 12 miembros del Martillo Crepuscular en Dun Modr.‡Tuez 12 Convertis du Crépuscule dans Dun Modr.‡杀掉丹莫德的12名暮光之锤成员。‡到丹莫德去殺死12個暮光之錘成員。',
  }
},
[26128] = {
  {
    'A batalha da Ponte Thandol‡Битва за мост Тандола‡Die Schlacht um den Thandolübergang‡탄돌 교각 전투‡La batalla del Puente Thandol‡La batalla del Puente Thandol‡La bataille du viaduc de Thandol‡萨多尔大桥之战‡薩多爾大橋之戰',
    nil,
    'Derrote Calamoth Barbacinza na Ponte Thandol.‡Одолейте Каламота Пепельную Бороду на Мосту Тандола.‡Besiegt Calamoth Aschbart am Thandolübergang.‡탄돌 교각에서 칼라모스 애쉬비어드를 처치해야 합니다.‡Derrota a Calamoth Barbaceniza en el Puente Thandol.‡Derrota a Calamoth Barbaceniza en el Puente Thandol.‡Tuez Calamoth Barbe-de-cendres au Viaduc de Thandol.‡击败萨多尔大桥的卡拉莫斯·烬须。‡到薩多爾大橋去擊敗卡拉摩斯·灰鬍。',
  }
},
[26129] = {
  {
    'Irmãos de armas‡Братья по оружию‡Waffenbrüder‡동지애‡Hermanos enfrentados‡Hermanos enfrentados‡Frères d\'armes‡兄弟情深‡袍澤',
    nil,
    'Fale com o Rei Genn Greymane no Distrito Militar da cidade de Guilnéas.‡Поговорите с королем Генном Седогривом в Военном квартале Гилнеаса.‡Sprecht mit König Genn Graumähne im Militärviertel in Gilneas.‡길니아스 시의 군사 지구에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Distrito Militar en la Ciudad de Gilneas.‡Habla con el rey Genn Cringris en el Distrito Militar en la Ciudad de Gilneas.‡Parlez au roi Genn Grisetête dans le Secteur Militaire, à Gilnéas.‡跟吉尔尼斯城军事区的吉恩·格雷迈恩国王谈一谈。‡在吉爾尼斯城的軍事區和吉恩·葛雷邁恩國王談話。',
  }
},
[26130] = {
  {
    'Cortando a conexão com L\'ghorek‡Отсоединение Л\'горека‡Keine Verbindung zu L\'ghorek‡고레크의 연결 해제‡Desenchufando a L\'ghorek‡Desenchufando a L\'ghorek‡Débrancher L’ghorek‡帮助拉葛雷克摆脱束缚‡讓勒苟雷克脫離',
    nil,
    'Mate Ur\'Goz, Sku\'Bu e Neph\'Lahim.‡Убейте Ур\'Гоза, Ску\'Бу и Неф\'Лахима.‡Tötet Ur\'Goz, Sku\'Bu und Neph\'Lahim.‡우르고즈, 스쿠부, 네프라힘을 처치해야 합니다.‡Mata a Ur\'Goz, a Sku\'Bu y a Neph\'Lahim.‡Mata a Ur\'Goz, a Sku\'Bu y a Neph\'Lahim.‡Tuez Ur’Goz, Sku’Bu et Neph’Lahim.‡杀死乌尔高兹、斯库布和尼伏拉辛。‡消滅烏爾戈茲、史古布，和奈夫拉希姆。',
  }
},
[26131] = {
  {
    'Reforços para Loch Modan‡Подкрепление для Лок Модана‡Verstärkung für Loch Modan‡모단 호수를 위한 증원군‡Refuerzos para Loch Modan‡Refuerzos para Loch Modan‡Des renforts pour le Loch Modan‡洛克莫丹的援军‡增援洛克莫丹',
    nil,
    'Peça ao Grif Trovino, na Grande Forja, um voo para Loch Modan. Fale com o Piloto Pisafundo quando chegar.‡Отправляйтесь в Великую Кузню и поговорите с Гритом Турденом о полете в Лок Модан. Когда прибудете, поговорите с пилотом Большеногом.‡Bittet Gryth Thurden in der Großen Schmiede um einen Flug nach Loch Modan. Sprecht bei Eurer Ankunft mit Pilot Hammerfuß.‡대용광로에 있는 그리핀 조련사 그리스 서든과 대화해 모단 호수로 가야 합니다. 모단 호수에 도착하면 조종사 해머풋과 대화하십시오.‡Habla con Gryth Thurden en La Gran Fundición para volar a Loch Modan. Habla con Piloto Podomartillo cuando llegues.‡Habla con Gryth Thurden en La Gran Fundición para volar a Loch Modan. Habla con Piloto Podomartillo cuando llegues.‡Parlez à Gryth Thurden, à la Grande Forge, pour qu’il vous envoie au Loch Modan à dos de griffon. Quand vous aurez atterri, parlez au Pilote Martèlepied.‡跟大熔炉的格莱斯·瑟登谈一谈，飞往洛克莫丹。抵达目的地后跟驾驶员塞克·锤足谈一谈。‡和位於大鍛爐的格萊斯·瑟登交談以飛往洛克莫丹。到達後，找駕駛員塞克·錘足交談。',
  }
},
[26132] = {
  {
    'Malévolos do mundo etéreo‡Чудовища Пустоты‡Scheusale aus der Netherwelt‡황천에서 온 마귀‡Malignos del inframundo‡Malignos del inframundo‡Les fiels des profondeurs‡来自虚空世界的恶魔‡虛空世界的惡魔',
    nil,
    'Mate 8 Malévolos Etéreos.‡Уничтожьте 8 исчадий Пустоты.‡Tötet 8 Netherscheusale.‡황천 마귀 8마리를 처치해야 합니다.‡Mata a 8 malignos abisales.‡Mata a 8 malignos abisales.‡Tuez 8 Démons du Néant.‡杀死8只虚空恶魔。‡殺死8隻虛空惡魔。',
  }
},
[26133] = {
  {
    'Malévolos do mundo etéreo‡Чудовища Пустоты‡Scheusale aus der Netherwelt‡황천에서 온 마귀‡Malignos del inframundo‡Malignos del inframundo‡Les fiels des profondeurs‡来自虚空世界的恶魔‡虛空世界的惡魔',
    nil,
    'Mate 8 Malévolos Etéreos.‡Уничтожьте 8 исчадий Пустоты.‡Tötet 8 Netherscheusale.‡황천 마귀 8마리를 처치해야 합니다.‡Mata a 8 malignos abisales.‡Mata a 8 malignos abisales.‡Tuez 8 Démons du Néant.‡杀死8只虚空恶魔。‡殺死8隻虛空惡魔。',
  }
},
[26134] = {
  {
    'Nada resta para você aqui‡Ничего тут для тебя нет‡Nichts mehr für Euch hier‡여기에서 할 일은 없다‡No han dejado nada para ti‡No han dejado nada para ti‡Non, rien de rien‡人非事休‡無所眷戀',
    nil,
    'Fale com Furien em Tethris Aran, que fica em Desolação.‡Поговорите с Фуриеном в Тефрис-Аране в Пустошах.‡Sprecht mit Furien in Tethris Aran in Desolace.‡잊혀진 땅의 테드리스 아란에서 퓨리엔과 대화해야 합니다.‡Habla con Furien en Tethris Aran en Desolace.‡Habla con Furien en Tethris Aran en Desolace.‡Allez parler à Furien à Tethris Aran, en Désolace.‡跟凄凉之地塔迪萨兰的弗瑞恩谈一谈。‡和位於淒涼之地塔迪薩蘭的弗里安談談。',
  }
},
[26135] = {
  {
    'Visões do passado: ascensão das profundezas‡Видения прошлого: подъем из глубин‡Visionen der Vergangenheit: Aufstieg aus der Tiefe‡과거의 환영: 드러나는 심연‡Visiones del pasado: Desde las profundidades‡Visiones del pasado: Desde las profundidades‡Visions du passé : le soulèvement des abysses‡过去的影像：自深渊崛起‡過去的幻景:從深淵崛起',
    nil,
    'Observe a história da Dama Guerreira usando a lâmina quebrada no Templo de Quel\'Durmar.‡Воспользуйтесь сломанным клинком Воительницы в храме Кель\'Дормир и посмотрите заключительную часть истории.‡Werdet Zeuge der letzten Geschichte der Kriegsmaid, indem Ihr ihre gebrochene Klinge im Tempel von Quel\'Dormir benutzt.‡쿠엘도르미르 사원 어딘가에서 부러진 창을 사용하여 나가 여전사의 마지막 이야기를 지켜보아야 합니다.‡Contempla el desenlace de la historia de la doncella de batalla utilizando su hoja rota en algún lugar del Templo de Quel\'Dormir.‡Contempla el desenlace de la historia de la doncella de batalla utilizando su hoja rota en algún lugar del Templo de Quel\'Dormir.‡Apprenez l’épilogue de l’histoire de la vierge combattante en utilisant sa lame brisée quelque part dans le temple de Quel’Dormir.‡在奎尔多米尔神殿某处使用女武士的断剑来目睹她最后的经历。‡在奎多米爾神殿的某處使用戰鬥仕女的斷劍，來見證她故事的結局。',
  }
},
[26136] = {
  {
    '‡‡‡[미완성] 사후강직 제거됨‡‡‡‡‡',
    nil,
    nil,
  }
},
[26137] = {
  {
    'Cuidando dos rapazes‡Проверить мальчиков‡Auf der Suche nach den Jungs‡산악경비대원들을 찾아라‡Controlar a los chicos‡Controlar a los chicos‡Inspection-surprise‡小子们情况如何‡看看那些小夥子',
    nil,
    'Vá até o Pantanal e fale com o Montanhista Rharen nos arredores de Dun Algaz.‡Отправляйтесь в Болотину и поговорите с горным пехотинцем Рареном возле Дун Альгаза.‡Reist ins Sumpfland und sprecht mit Gebirgsjäger Rharen nahe Dun Algaz.‡저습지로 가서 던 알가즈 근처에 있는 산악경비대 라렌과 대화해야 합니다.‡Viaja a Los Humedales y habla con el montaraz Rharen cerca de Dun Algaz.‡Viaja a Los Humedales y habla con el montaraz Rharen cerca de Dun Algaz.‡Allez parler au Montagnard Rharen tout près de Dun Algaz, dans les Paluns.‡到湿地去同丹奥加兹附近的巡山人拉伦谈一谈。‡到濕地去和丹奧加茲附近的巡山人拉倫談話。',
  }
},
[26138] = {
  {
    'Feralon Verdefólio‡Ферилон Дитя Листвы‡Ferilon Laubkind‡페릴론 리프본‡Ferilon Hojanato‡Ferilon Hojanato‡Férilon Feuillené‡费里隆·叶生‡菲里隆·葉成',
    nil,
    'Encontre Feralon Verdefólio no Bosque do Verdião.‡Найдите Ферилона Дитя Листвы в Роще Стража Природы.‡Findet Ferilon Laubkind im Hain des Sumpfhüters.‡신록수호자의 숲에 있는 페릴론 리프본을 찾아야 합니다.‡Encuentra a Ferilon Hojanato en la Arboleda del Guardaverde.‡Encuentra a Ferilon Hojanato en la Arboleda del Guardaverde.‡Trouvez Férilon Feuillené au Bosquet du Gardien vert.‡到绿色守卫者林地去找费里隆·叶生。‡在綠意守望者之林找到菲里隆·葉成。',
  }
},
[26139] = {
  {
    'Caminho para Arathi‡В Арати‡Nach Arathi‡아라시로‡Hacia Arathi‡Hacia Arathi‡Incursion à Arathi‡进入阿拉希‡深入阿拉希',
    nil,
    'Vá para o Planalto Arathi e fale com a Capitão Nélia na Ponta do Refúgio.‡Отправляйтесь на Нагорье Арати и поговорите с капитаном Ниалс в Опорном пункте.‡Reist ins Arathihochland und sprecht mit Hauptmann Nials in der Zuflucht.‡아라시 고원의 임시 주둔지에 있는 부대장 나이얼스와 대화해야 합니다.‡Viaja hasta las Tierras Altas de Arathi y habla con la capitana Nials en el Refugio de la Zaga.‡Viaja hasta las Tierras Altas de Arathi y habla con la capitana Nials en el Refugio de la Zaga.‡Rendez-vous dans les Hautes-terres d’Arathi et parlez au Capitaine Nials, au Refuge de l’Ornière.‡去阿拉希高地跟避难谷地的尼艾丝队长谈一谈。‡前往阿拉希高地並和避難谷地的尼艾絲隊長說話。',
  }
},
[26140] = {
  {
    'Comunicando-se com os Ancestrais‡Беседа с Древним‡Mit dem Ahnen reden‡고대 생물과의 교감‡Comunión con el ancestro‡Comunión con el ancestro‡Communier avec l’ancien‡与上古生物交流‡與先祖交流',
    nil,
    'Entregue o Cérebro do Inconcebível para L\'ghorek, no Cerebrilho, localizado dentro de L\'ghorek, em Vashj\'ir.‡Принесите мозг Непостижимого Л\'гореку в Церебриллий в Вайш\'ире.‡Bringt das Gehirn des Unergründlichen zu L\'ghorek im Cerebrillum in L\'ghorek in Vashj\'ir.‡속을 알 수 없는 자의 뇌를 바쉬르의 고레크 안에 있는 두뇌실로 가져가야 합니다.‡Entrega el cerebro del Inconmensurable a L\'ghorek en El Cerebelo, dentro de L\'ghorek, en Vashj\'ir.‡Entrega el cerebro del Inconmensurable a L\'ghorek en El Cerebelo, dentro de L\'ghorek, en Vashj\'ir.‡Remettez le Cerveau de l’Insondable à L’ghorek dans le Cervellium de L’ghorek, en Vashj’ir.‡将不可估量者的触须交给瓦丝琪尔拉葛雷克脑室的拉葛雷克。‡將高深莫測者的大腦送去瓦許伊爾的勒苟雷克裡，交給腦室中的勒苟雷克。',
  }
},
[26141] = {
  {
    'Pedras rúnicas da vinculação‡Рунные камни обуздания‡Runensteine der Bindung‡결속의 마법석‡Piedras rúnicas de vinculación‡Piedras rúnicas de vinculación‡Les pierres runiques de lien‡禁锢符文石‡禁錮符石',
    nil,
    'Colete 7 Pedras Rúnicas da Vinculação.‡Соберите 7 рунных камней обуздания.‡Sammelt 7 Runensteine der Bindung.‡결속의 마법석 7개를 모아야 합니다.‡Reúne 7 piedras rúnicas de vinculación.‡Reúne 7 piedras rúnicas de vinculación.‡Obtenez 7 Pierres runiques de lien.‡收集7块禁锢符文石。‡收集7個禁錮符石。',
  }
},
[26142] = {
  {
    'Ascender nunca mais!‡Теперь они не переродятся!‡Aufstieg verboten!‡더는 승천하지 못하리라‡¡Fin de la ascensión!‡¡Fin de la ascensión!‡Plus ne s’élèveront !‡阻止升腾仪式！‡卓越不再',
    nil,
    'Destrua 5 Dutos Antigos.‡Уничтожьте 5 древних каналов.‡Zerstört 5 uralte Leitungen.‡고대의 수송관 5개를 파괴해야 합니다.‡Destruye 5 conductos antiguos.‡Destruye 5 conductos antiguos.‡Détruisez 5 Anciens conduits.‡摧毁5根上古导管。‡摧毀5條祖靈引導裝置。',
  }
},
[26143] = {
  {
    'Nada mais elevado‡Халлазил Перерожденный‡Alles, was aufsteigt‡행동 개시‡Todo lo que sube‡Todo lo que sube‡Plus dure est la chute‡升腾者‡飛升者',
    nil,
    'Mate Hallazeal, o Elevado.‡Уничтожьте Халлазила Перерожденного.‡Tötet Hallazeal den Aufgestiegenen.‡승천한 할라질을 처치해야 합니다.‡Mata a Hallazeal el Ascendido.‡Mata a Hallazeal el Ascendido.‡Tuez Hallazèle l’Élevé.‡杀死升腾者海纳泽尔。‡殺死飛升的海拉希爾。',
  }
},
[26144] = {
  {
    'Aprisionados‡Пленники‡Gefangene‡포로들‡Prisioneros‡Prisioneros‡Les captifs‡囚徒‡囚犯',
    nil,
    'Resgate 5 Prisioneiros da Aliança.‡Освободите 5 узников из Альянса.‡Rettet 5 Gefangene der Allianz.‡얼라이언스 포로 5명을 구출해야 합니다.‡Rescata a 5 prisioneros de la Alianza.‡Rescata a 5 prisioneros de la Alianza.‡Libérez 5 Prisonniers de l’Alliance.‡营救5名联盟囚犯。‡釋放5名聯盟囚犯。',
  }
},
[26145] = {
  {
    'A ameaça trogg‡Угроза со стороны троггов‡Die Bedrohung durch die Troggs‡트로그의 위협‡La amenaza trogg‡La amenaza trogg‡La menace trogg‡穴居人的威胁‡穴居怪的威脅',
    nil,
    'Pegue 8 Dentes de Pedra de Trogg.‡Соберите 8 каменных зубов троггов.‡Sammelt 8 Troggsteinzähne.‡트로그의 단단한 이빨 8개를 수집해야 합니다.‡Reúne 8 dientes de trogg de piedra.‡Reúne 8 dientes de trogg de piedra.‡Collectez 8 Dents de pierre de troggs.‡收集8颗穴居人的石牙。‡收集8顆穴居怪的石牙。',
  }
},
[26146] = {
  {
    'Em defesa das terras do Rei‡Защита королевских земель‡Verteidigung der Länder des Königs‡왕국 수호‡En defensa de las tierras del rey‡En defensa de las tierras del rey‡À la défense des terres du roi‡为了保卫国王的领土‡保衛國王的領土',
    nil,
    'Mate 12 Troggs Lascapedra ou Batedores Lascapedra.‡Убейте 12 троггов из племени Камнедробов.‡Tötet 12 Splittersteintroggs oder Späher der Splittersteintroggs.‡가루바위 트로그나 가루바위 정찰병 12마리를 처치해야 합니다.‡Mata a 12 troggs Rompecantos o a exploradores Rompecantos.‡Mata a 12 troggs Rompecantos o a exploradores Rompecantos.‡Tuez 12 Troggs ou Éclaireurs brisepierre.‡杀死12只碎石穴居人或碎石怪斥候。‡殺死12個石裂穴居怪或石裂斥候。',
  }
},
[26147] = {
  {
    'Agora é que o bicho pega‡Больше и страшнее‡Größer und ekliger‡더 크고 못생긴 것들‡Más grande y más feo‡Más grande y más feo‡Plus c\'est grand, plus c\'est laid‡更大更丑‡更大更醜',
    nil,
    'Mate 8 Xamãs Lascapedra e 8 Quebraossos Lascapedra.‡Убейте 8 шаманов из племени Камнедробов и 8 костегрызов из племени Камнедробов.‡Tötet 8 Schamanen der Splittersteintroggs und 8 Knochenknacker der Splittersteintroggs.‡가루바위 주술사와 가루바위 뼈다귀싸움꾼을 각각 8마리씩 처치해야 합니다.‡Mata a 8 chamanes Rompecantos y a 8 cascahuesos Rompecantos.‡Mata a 8 chamanes Rompecantos y a 8 cascahuesos Rompecantos.‡Tuez 8 Chamans et 8 Briseurs d\'os brisepierre.‡杀死8名碎石怪萨满祭司和8名碎石怪断骨者。‡殺死8個石裂薩滿和8個石裂斷骨者。',
  }
},
[26148] = {
  {
    'Um ataque decisivo‡Решающий удар‡Ein Entscheidungsschlag‡결정적인 공격‡Un golpe decisivo‡Un golpe decisivo‡Une frappe décisive‡决定性的一击‡果斷的一擊',
    nil,
    'Mate Gromug.‡Убейте Громага.‡Tötet Grawmug.‡그로머그를 처치해야 합니다.‡Mata a Gromug.‡Mata a Gromug.‡Tuez Grawmug.‡杀掉格劳姆格。‡殺死格勞姆格。',
  }
},
[26149] = {
  {
    'Aprisionados‡Пленники‡Gefangene‡포로들‡Prisioneros‡Prisioneros‡Les captifs‡囚徒‡囚犯',
    nil,
    'Resgate 5 Prisioneiros da Horda.‡Спасите 5 узников из Орды.‡Rettet 5 Gefangene der Horde.‡호드 포로 5명을 구출해야 합니다.‡Rescata a 5 prisioneros de la Horda.‡Rescata a 5 prisioneros de la Horda.‡Libérez 5 Prisonniers de la Horde.‡营救5名部落囚犯。‡釋放5名部落囚犯。',
  }
},
[26150] = {
  {
    'Visitando Mabel‡Навестить Мейбелл‡Ein Besuch bei Maybell‡메이벨에게 무슨 일이?‡Una visita con Maybell‡Una visita con Maybell‡Une petite visite à Maybell‡拜访梅贝尔‡與梅貝爾會面',
    nil,
    'Fale com Mabel Madruga nos Vinhedos dos Madruga, que fica na Floresta de Elwynn.‡Поговорите с Мейбелл Маклур на виноградниках Маклур в Элвиннском лесу.‡Sprecht mit Maybell Maclure in den Weinbergen der Maclures in den Wäldern von Elwynn.‡엘윈 숲의 매클루어 포도밭에 있는 메이벨 매클루어와 대화해야 합니다.‡Habla con Maybell Maclure en Los Viñedos de Maclure en el Bosque de Elwynn.‡Habla con Maybell Maclure en Los Viñedos de Maclure en el Bosque de Elwynn.‡Parlez à Maybell Maclure dans les Vignes des Maclure, dans la Forêt d\'Elwynn.‡与艾尔文森林马科伦农场的梅贝尔·马科伦交谈。‡到艾爾文森林的馬科倫農場與梅貝爾·馬科倫交談。',
  }
},
[26151] = {
  {
    '‡Зловещее письмо‡Dunkler Brief‡암흑의 편지‡Carta oscura‡Carta oscura‡La lettre noire‡黑色信件‡黑暗信件',
    nil,
    '‡Прочитайте зловещее письмо и поговорите с Друзиллой ла Салле на кладбище в долине Североземья.‡Lest den dunklen Brief und sprecht mit Drusilla La Salle auf dem Friedhof von Nordhaintal.‡‡Lee la carta oscura y habla con Drusilla La Salle en el cementerio del Valle de Villanorte.‡‡Lisez la Lettre noire et parlez à Dursilla La Salle dans le cimetière de la Vallée de Comté-du-Nord.‡阅读这封黑色信件，然后与北郡山谷墓地中的杜希拉·拉萨雷交谈。‡',
  }
},
[26152] = {
  {
    'Procura-se: Tiago Ciríaco‡Разыскивается: Джеймс Кларк‡Gesucht: James Clark‡현상 수배: 제임스 클락‡Se busca: James Clark‡SE BUSCA: James Clark‡On recherche : James Clark‡通缉：詹姆斯·克拉克‡懸賞:詹姆士·克拉克',
    nil,
    'Mate Tiago Ciríaco e arranque a cabeça dele.‡Убейте Джеймса Кларка и заберите его голову.‡Tötet James Clark und nehmt James Clarks Kopf.‡제임스 클락을 처치하고 제임스 클락의 머리카락를 획득해야 합니다.‡Mata a james Clark y consigue la cabeza de James Clark.‡Mata a james Clark y consigue la cabeza de James Clark.‡Tuez James Clark et prenez la Tête de James Clark.‡杀死詹姆斯·克拉克，并取走詹姆斯·克拉克的徽记。‡殺死詹姆士·克拉克，並取得詹姆士·克拉克的頭顱。',
  }
},
[26153] = {
  {
    'Panquecas de abóbora da Magali‡Тыквенные оладьи Пэнни‡Pennys Kürbiskuchen‡페니의 호박 팬케이크‡Tortitas de calabaza de Penny‡Tortitas de calabaza de Penny‡Des galettes à la citrouille pour Penny‡潘妮的南瓜饼‡潘妮的南瓜烙餅',
    nil,
    'Obtenha 8 Abóboras de Ventobravo. Entregue-as para Chico Magarefe em Ventobravo.‡Раздобудьте 6 штормградских тыкв. Принесите их Робби Флею в Штормграде.‡Sammelt 6 Sturmwindkürbisse und bringt sie Robby Flay in Sturmwind.‡스톰윈드 호박 6개를 따서 스톰윈드에 있는 로비 플레이에게 가져가야 합니다.‡Consigue 6 calabazas de Ventormenta. Entrégaselas a Robby Flay en la Ciudad de Ventormenta.‡Consigue 6 calabazas de Ventormenta. Entrégaselas a Robby Flay en la Ciudad de Ventormenta.‡Récupérez 6 Citrouilles de Hurlevent et livrez-les à Robby Flay à Hurlevent.‡收集6个暴风城南瓜，把它们交给暴风城的罗比·弗雷。‡取得6顆暴風城南瓜。將南瓜帶去暴風城給羅比·福雷。',
  }
},
[26154] = {
  {
    'Extermínio do crepúsculo‡Искоренение Сумеречного Молота‡Schattenkammerjäger‡황혼의 몰락‡Exterminio Crepuscular‡Exterminio Crepuscular‡L’extermination du crépuscule‡暮光大扫除‡暮光終結',
    nil,
    'Tome controle de uma Torrente Vinculada e use-a para matar 50 Devotos do Crepúsculo e 10 Feitores Sem-rosto.‡Подчините себе скованный поток и уничтожьте 50 сумеречных энтузиастов и 10 безликих надзирателей.‡Ergreift Besitz von einem gebundenen Strom und tötet dann 50 Zwielichtverehrer und 10 gesichtslose Aufseher.‡속박된 격류를 지배한 다음 황혼의 헌신자 50명과 얼굴 없는 감시자 10마리를 처치해야 합니다.‡Posee a un torrente esclavo y luego mata a 50 devotos Crepusculares y a 10 sobrestantes ignotos.‡Posee a un torrente esclavo y luego mata a 50 devotos Crepusculares y a 10 sobrestantes ignotos.‡Possédez un Torrent lié, puis massacrez 50 Fidèles du Crépuscule et 10 Surveillants sans-visage.‡占据一个束缚奔流，然后杀死50名暮光狂信者和10名无面监督者。‡掌控1個被束縛的洪流，然後殺死50名暮光誓徒和10名無臉監督者。',
  }
},
[26155] = {
  {
    '‡Черная угроза не забыта‡Erinnerungen an eine dunkle Bedrohung‡‡Una amenaza oscura no olvidada‡‡La réminiscence d\'une sombre menace‡‡',
    nil,
    '‡Раздобудьте чертежи Каменной Плотины в лагере Черного Железа в центре озера Лок.‡Besorgt Euch die Baupläne des Steinwerkdamms von den Dunkeleisenzwergen mitten im Loch.‡‡Consigue los esquemas de las Tres Cabezas de los Hierro Negro en el centro de Loch Modan.‡‡Obtenez les Schémas de Formepierre chez les Sombrefers au milieu du Loch Modan.‡‡',
  }
},
[26156] = {
  {
    '‡Все люди короля‡Der König mit seinem Heer‡‡Todos los hombres del Rey‡‡Tous les hommes du roi‡‡',
    nil,
    '‡Убейте 6 саперов из клана Черного Железа.‡Tötet 6 Pioniere der Dunkeleisenzwerge.‡‡Mata a 6 zapadores Hierro Negro.‡‡Tuez 6 Sapeurs sombrefer.‡‡',
  }
},
[26157] = {
  {
    'Kasim Sharim‡Касым Шарим‡Kasim Sharim‡카심 샤림‡Kasim Sharim‡Kasim Sharim‡Kasim Sharim‡卡西姆·夏利姆‡卡辛·夏利姆',
    nil,
    'Apresente-se a Kasim Sharim na parte de trás das Cavernas Serpeantes, que ficam na Barreira do Inferno.‡Разыщите Касыма Шарима в пещерах Змеиные Кольца в Выжженных землях.‡Meldet Euch bei Kasim Sharim im hinteren Teil der Schlangenschlinge in den Verwüsteten Landen.‡저주받은 땅의 뱀의 보금자리 뒤편에 있는 카심 샤림에게 보고해야 합니다.‡Preséntate ante Kasim Sharim al fondo de la Serpiente Enroscada en Las Tierras Devastadas.‡Preséntate ante Kasim Sharim al fondo de la Serpiente Enroscada en Las Tierras Devastadas.‡Présentez-vous à Kasim Sharim, au fond des Anneaux du serpent dans les Terres Foudroyées.‡向诅咒之地盘蛇谷深处的卡西姆·夏利姆报到。‡到詛咒之地的盤蛇谷後面向卡辛·夏利姆回報。',
  }
},
[26158] = {
  {
    'Em harmonia com a pedra-sangrenta‡Настроиться на кровавый камень‡Stimmt den Blutstein ab‡혈석 조정‡Armonización de la sangrita‡Armonización de la sangrita‡Harmonisation d’une pierre de sang‡血石同调‡與血石同調',
    nil,
    'Harmonize-se com as Pedras-sangrentas Teleportadoras nas Cavernas Serpeantes.‡Научитесь использовать телепортирующие кровавые камни в Змеиных Кольцах.‡Stellt euch auf die Blutsteinteleporter in der Schlangenschlinge ein.‡뱀의 보금자리에 있는 혈석 순간이동기에 맞춰 자신을 조정해야 합니다.‡Ponte en armonía con los teletransportadores de sangrita en la Serpiente Enroscada.‡Ponte en armonía con los teletransportadores de sangrita en la Serpiente Enroscada.‡Harmonisez-vous avec les Téléporteurs de la pierre de sang, dans les Anneaux du serpent.‡与盘蛇谷的血石传送器进行同调。‡讓自己和盤蛇谷中的血石傳送器同調。',
  }
},
[26159] = {
  {
    'A primeira etapa‡Первый шаг‡Der erste Schritt‡첫 단계‡El primer paso‡El primer paso‡La chasse sanglante‡第一步‡第一步',
    nil,
    'Obtenha 9 frascos de Sangue de Hiena Rasgarrindo e 9 frascos de Sangue de Basilisco Itarrubra.‡Раздобудьте 9 флаконов крови хохочущей гиены и 9 флаконов крови краснокаменного василиска.‡Beschafft 9 Phiolen mit Blut einer Kicherfanghyäne und 9 Phiolen mit Blut eines Rotsteinbasilisken.‡칼송곳니하이에나 피 9병과 붉은바위 바실리스크 피 9병을 획득해야 합니다.‡Consigue 9 viales de sangre de hiena risitas y 9 viales de sangre de basilisco Rocarroja.‡Consigue 9 viales de sangre de hiena risitas y 9 viales de sangre de basilisco Rocarroja.‡Recueillez 9 fioles de Sang de hyène raillecroc et 9 fioles de Sang de basilic rougepierre.‡收集9瓶弯牙土狼的血液和9瓶红石蜥蜴的血。‡取得9瓶彎牙土狼的血和9瓶紅石蜥蜴的血。',
  }
},
[26160] = {
  {
    'Ritual de sangue‡Ритуал крови‡Blutritual‡피의 의식‡Ritual de sangre‡Ritual de sangre‡Le rituel de sang‡鲜血仪祭‡血之祭儀',
    nil,
    'Fale com Kasim Sharim para começar o ritual de sangue.‡Поговорите с Касымом Шаримом, чтобы начать ритуал крови.‡Sprecht mit Kasim Sharim, um das Blutritual einzuleiten.‡카심 샤림과 대화하고 피의 의식을 시작해야 합니다.‡Habla con Kasim Sharim para comenzar el ritual de sangre.‡Habla con Kasim Sharim para comenzar el ritual de sangre.‡Parlez à Kasim Sharim pour commencer le rituel de sang.‡与卡西姆·夏利姆交谈，开始鲜血仪祭。‡和卡辛•夏利姆談話來開始血之祭儀。',
  }
},
[26161] = {
  {
    'Não apenas um corpo‡По кусочкам‡Nicht irgendeine Leiche‡아무거나 구해서는 안 된다‡No es cualquier cuerpo‡No es cualquier cuerpo‡Morceaux de bravoure‡特别的尸体‡不是誰的屍體都行',
    nil,
    'Encontre a Cabeça de Loramus, o Torso de Loramus e as Pernas de Loramus.‡Разыщите голову, туловище и ноги Лорама.‡Findet Loramus\' Kopf, Loramus\' Torso und Loramus\' Beine.‡로라무스의 가면, 로라무스의 옷, 로라무스의 바지를 찾아와야 합니다.‡Encuentra la cabeza de Loramus, el torso de Loramus y las piernas de Loramus.‡Encuentra la cabeza de Loramus, el torso de Loramus y las piernas de Loramus.‡Trouvez la Tête de Loramus, le Torse de Loramus et les Jambes de Loramus.‡找到洛拉姆斯的头颅、洛拉姆斯的躯干和洛拉姆斯的腿。‡找到洛拉姆斯的頭、洛拉姆斯的軀幹和洛拉姆斯的雙腿。',
  }
},
[26162] = {
  {
    'O altar das tempestades‡Алтарь Бурь‡Der Altar der Stürme‡폭풍의 제단‡El Altar de la Tempestad‡El Altar de la Tempestad‡L’autel des Tempêtes‡风暴祭坛‡暴風祭壇',
    nil,
    'Leve o Cadáver de Loramus ao Altar das Tempestades e proteja-o enquanto o ritual é realizado.‡Отнесите тело Лорама к Алтарю Бурь и охраняйте его, пока идет ритуал воскрешения.‡Bringt Loramus\' Leichnam zum Altar der Stürme und beschützt ihn während des Rituals.‡로라무스의 시신을 폭풍의 제단으로 가져간 다음, 의식이 끝날 때까지 보호해야 합니다.‡Lleva el cuerpo de Loramus al Altar de la Tempestad y después protégelo hasta que se complete el ritual.‡Lleva el cuerpo de Loramus al Altar de la Tempestad y después protégelo hasta que se complete el ritual.‡Portez le corps de Loramus à l’Autel des Tempêtes et là, protégez-le pendant la durée du rituel.‡将洛拉姆斯的躯体带到风暴祭坛去，然后在仪式进行期间保护它。‡將洛拉姆斯的身體帶到暴風祭壇，然後保護它直到祭儀結束。',
  }
},
[26163] = {
  {
    'O tempo é curto‡Времени нет‡Die Zeit ist knapp‡시간이 없다‡Hay poco tiempo‡Hay poco tiempo‡Le temps est compté‡时间紧迫‡時間無多',
    nil,
    'Entregue a Runa Dissonante ao Vigia Grímeo no Portal Negro, que fica na Barreira do Inferno.‡Отнесите диссонирующую руну дозорному Гримео у Темного портала в Выжженных землях.‡Bringt die disharmonische Rune zu Behüter Grimeo am Dunklen Portal in den Verwüsteten Landen.‡저주받은 땅의 어둠의 문에 있는 파수병 그리메오에게 불협의 룬을 전달해야 합니다.‡Entrega la runa discordante al Vigía Grimeo en El Portal Oscuro en Las Tierras Devastadas.‡Entrega la runa discordante al Vigía Grimeo en El Portal Oscuro en Las Tierras Devastadas.‡Apportez la Rune discordante au Gardien Grimeo à la Porte des ténèbres, dans les Terres Foudroyées.‡将不谐符文交给诅咒之地黑暗之门的观察者格雷米奥。‡將絮亂符文送去詛咒之地裡的黑暗之門給看守者格林密歐。',
  }
},
[26164] = {
  {
    'O granito carbonizado do Portal Negro‡Обугленный гранит у Темного портала‡Der verkohlte Granit des Dunklen Portals‡어둠의 문 주변의 까맣게 탄 화강암‡El granito carbonizado de El Portal Oscuro‡El granito carbonizado de El Portal Oscuro‡Le granite carbonisé de la Porte des ténèbres‡黑暗之门的焦黑花岗岩‡黑暗之門的燒焦花崗岩石片',
    nil,
    'Obtenha 24 Lascas de Granito Carbonizado.‡Соберите 24 обугленных гранитных осколка.‡Besorgt 24 verkohlte Granitsplitter.‡까맣게 탄 화강암 조각 24개를 획득해야 합니다.‡Consigue 24 astillas de granito carbonizado.‡Consigue 24 astillas de granito carbonizado.‡Trouvez 24 Fragments de granite carbonisés.‡收集24块焦黑的花岗岩片。‡取得24個燒焦的花崗岩石片。',
  }
},
[26165] = {
  {
    'O sangue vil dos demônios‡Поганая кровь демонов‡Das abscheuliche Blut der Dämonen‡악마의 사악한 피‡La sangre vil de los demonios‡La sangre vil de los demonios‡Le sang infâme des démons‡邪能魔化之血‡邪惡的惡魔之血',
    nil,
    'Obtenha 7 garrafas de Sangue Demoníaco Torpe.‡Соберите 7 бутылок жуткой крови демонов.‡Besorgt 7 Flaschen mit abscheulichem Dämonenblut.‡사악한 악마의 피 7병을 획득해야 합니다.‡Consigue 7 botellas de sangre demoníaca vil.‡Consigue 7 botellas de sangre demoníaca vil.‡Obtenez 7 bouteilles de Sang démoniaque infâme.‡收集7瓶邪能魔化之血。‡取得7瓶邪惡的惡魔之血。',
  }
},
[26166] = {
  {
    'Potencializando a pedra‡Дальнейшая подготовка‡Verbesserung des Steins‡돌 강화‡Realzar la piedra‡Realzar la piedra‡La pierre contre-attaque‡强化石头‡石之附魔',
    nil,
    'Leve o Pacote do Grímeo para Kasim Sharam nas Cavernas Serpeantes, que ficam na Barreira do Inferno.‡Отнесите посылку Гримео Касыму Шариму в пещеры Змеиные Кольца в Выжженных землях.‡Bringt Grimeos Paket zu Kasim Sharim in der Schlangenschlinge in den Verwüsteten Landen.‡저주받은 땅의 뱀의 보금자리에 있는 카심 샤림에게 그리메오의 꾸러미를 전달해야 합니다.‡Lleva el paquete de Grimeo a Kasim Sharim en la Serpiente Enroscada en Las Tierras Devastadas.‡Lleva el paquete de Grimeo a Kasim Sharim en la Serpiente Enroscada en Las Tierras Devastadas.‡Apportez le Paquet de Grimeo à Kasim Sharim aux Anneaux du serpent, dans les Terres Foudroyées.‡将格雷米奥的包裹交给诅咒之地盘蛇谷的卡西姆·夏利姆。‡將格林密歐的包裹帶去詛咒之地裡的盤蛇谷給卡辛•夏利姆。',
  }
},
[26167] = {
  {
    'O amuleto de Allistarj‡Амулет Аллистария‡Das Amulett von Allistarj‡알리스타즈의 아뮬렛‡El amuleto de Allistarj‡El amuleto de Allistarj‡L’amulette d\'Allistarj‡奥利斯塔的护符‡奧利斯塔的護符',
    nil,
    'Obtenha o Amuleto de Allistarj das Cavernas Serpeantes, que ficam na Barreira do Inferno.‡Раздобудьте амулет Аллистария в пещерах Змеиные Кольца в Выжженных землях.‡Besorgt das Amulett von Allistarj aus der Schlangenschlinge in den Verwüsteten Landen.‡저주받은 땅의 뱀의 보금자리에서 알리스타즈의 아뮬렛을 획득해야 합니다.‡Consigue el amuleto de Allistarj en la Serpiente Enroscada en Las Tierras Devastadas.‡Consigue el amuleto de Allistarj en la Serpiente Enroscada en Las Tierras Devastadas.‡Retrouvez l’Amulette d’Allistarj dans les Anneaux du serpent, dans les Terres Foudroyées.‡在诅咒之地的盘蛇谷获得奥利斯塔的护符。‡在詛咒之地的盤蛇谷取得奧利斯塔的護符。',
  }
},
[26168] = {
  {
    'O amuleto de Sevine‡Амулет Севины‡Das Amulett von Sevine‡세바인의 아뮬렛‡El amuleto de Sevine‡El amuleto de Sevine‡L’amulette de Sevine‡瑟温妮的护符‡瑟溫妮的護符',
    nil,
    'Obtenha o Amuleto de Sevine de Fiasco-sal perto da Costa Partida, que fica na Barreira do Inferno.‡Раздобудьте амулет Севины у Солюна близ Берега Обломков в Выжженных землях.‡Besorgt das Amulett von Sevine von Salzflopper nahe der Havarieküste in den Verwüsteten Landen.‡저주받은 땅의 산산조각 바닷가 근처에 있는 짠발이에게서 세바인의 아뮬렛을 획득해야 합니다.‡Consigue el amuleto de Sevine de Voltesal cerca de Costa Quebrada en Las Tierras Devastadas.‡Consigue el amuleto de Sevine de Voltesal cerca de Costa Quebrada en Las Tierras Devastadas.‡Obtenez l’Amulette de Sevine des mains de Rate’Sel, près du Rivage Ravagé dans les Terres Foudroyées.‡从诅咒之地破碎海滩附近的盐腮手中夺取瑟温妮的护符。‡在詛咒之地的破碎海岸附近取得瑟溫妮的護符。',
  }
},
[26169] = {
  {
    'O amuleto de Grol‡Амулет Грола‡Das Amulett von Grol‡그롤의 아뮬렛‡El amuleto de Grol‡El amuleto de Grol‡L’amulette de Grol‡戈洛尔的护符‡戈洛爾的護符',
    nil,
    'Obtenha o Amuleto de Grol na Costa Partida, que fica na Barreira do Inferno.‡Раздобудьте амулет Грола на Берегу Обломков в Выжженных землях.‡Besorgt das Amulett von Grol von der Havarieküste in den Verwüsteten Landen.‡저주받은 땅의 산산조각 바닷가에서 그롤의 아뮬렛을 획득해야 합니다.‡Consigue el amuleto de Grol en Costa Quebrada, en Las Tierras Devastadas.‡Consigue el amuleto de Grol en Costa Quebrada, en Las Tierras Devastadas.‡Trouvez l’amulette de Grol sur le Rivage Ravagé, dans les Terres Foudroyées.‡在诅咒之地的破碎海滩获得戈洛尔的护符。‡在詛咒之地的破碎海岸取得戈洛爾的護符。',
  }
},
[26170] = {
  {
    'O ritual final‡Завершающий ритуал‡Das letzte Ritual‡마지막 의식‡El ritual definitivo‡El ritual definitivo‡Le rituel final‡最后的仪式‡最終祭儀',
    nil,
    'Fale com Kasim Sharim e participe do ritual dele.‡Примите участие в ритуале Касыма Шарима.‡Sprecht mit Kasim Sharim, um an seinem Ritual teilzunehmen.‡카심 샤림과 대화하고 의식을 준비해야 합니다.‡Habla con Kasim Sharim y participa en su ritual.‡Habla con Kasim Sharim y participa en su ritual.‡Parlez à Kasim Sharim et participez au rituel.‡与卡西姆·夏利姆交谈，参与他的仪式。‡和卡辛•夏利姆說話並參與他的祭儀。',
  }
},
[26171] = {
  {
    'Você é Rakh\'likh, demônio‡Демон, имя тебе Рах\'лих‡Ihr seid Rakh\'likh, Dämon‡악마, 네 이름은 라크리크‡Eres Rakh\'likh, demonio‡Eres Rakh\'likh, demonio‡Son nom est Rakh’likh‡恶魔拉瑟莱克‡惡魔，汝真名為拉瑟萊克',
    nil,
    'Fale com o Psicopompus ao norte do Cerro do Profanador. Uma vez no topo do Cerro, destrua o corpo de Razelikh e então use a Faca Pétrea do Aprisionamento para encarcerar a alma do demônio.‡Поговорите с привратником смерти у северного подножия утеса Осквернителя. Поднявшись на вершину утеса, уничтожьте тело Разелиха и воспользуйтесь каменным ножом опечатывания, чтобы пленить душу демона.‡Sprecht mit dem tödlichen Pförtner nördlich der Anhöhe des Entweihers. Wenn Ihr oben auf der Anhöhe angelangt seid, zerstört Razelikhs Körper und benutzt dann das Steinmesser des Versiegelns, um seine Seele gefangen zu nehmen.‡파멸자의 봉우리 북쪽에 있는 죽음의 안내인과 대화하십시오. 봉우리 꼭대기에서 라젤리크를 처치하고 봉인의 돌칼로 그의 영혼을 가둬야 합니다.‡Habla con el Ujier sepulcral al norte de Alto de los Rapiñadores. Una vez en lo alto, destruye el cuerpo de Razelikh y usa el cuchillo de piedra de estampa para atrapar su alma.‡Habla con el Ujier sepulcral al norte de Alto de los Rapiñadores. Una vez en lo alto, destruye el cuerpo de Razelikh y usa el cuchillo de piedra de estampa para atrapar su alma.‡Parlez à la Mort silencieuse au nord du pic du Souilleur. Une fois au sommet, détruisez le corps de Razelikh puis utilisez le Couteau d’enfermement en pierre pour emprisonner son âme.‡与污染者高地北面的乌舍尔交谈。抵达高地顶端之后，摧毁拉瑟莱克的躯体，然后用封印石匕禁锢他的灵魂。‡在污染者高地的北方和烏舍爾說話。登上高地之後，摧毀拉瑟萊克的肉身，然後用封印之石製小刀來禁錮他的靈魂。',
  }
},
[26172] = {
  {
    'Um mago sangrento também precisa comer‡Волшебнику крови тоже хочется кушать‡Auch Blutmagier müssen essen‡혈법사도 먹어야 산다‡Los magos sangrientos también comen‡Los magos sangrientos también comen‡Même les mages de sang ont de petites faims‡血法师也要吃饭啊‡血法師也得吃飯',
    nil,
    'Obtenha 5 Bifes de Jubacinza de Javalis Jubacinza na Barreira do Inferno.‡Отправляйтесь в Выжженные земли и раздобудьте 5 кусков мяса пеплогривых кабанов.‡Besorgt 5 Aschmähnensteaks von Aschmähnenebern in den Verwüsteten Landen.‡저주받은 땅의 잿빛갈기멧돼지에서 잿빛갈기멧돼지 스테이크 5개를 획득해야 합니다.‡Consigue 5 filetes de Cenicrín de jabalíes Cenicrín en Las Tierras Devastadas.‡Consigue 5 filetes de Cenicrín de jabalíes Cenicrín en Las Tierras Devastadas.‡Prenez 5 Steaks de cendre-crin sur des Sangliers cendre-crins, dans les Terres Foudroyées.‡从诅咒之地的灰鬃野猪身上收集5块灰鬃肉排。‡從詛咒之地的灰鬃野豬那裡取得5份灰鬃肉排。',
  }
},
[26173] = {
  {
    'Protegendo a retaguarda‡Защита тылов‡Rückendeckung‡후방 방어‡Proteger la retaguardia‡Proteger la retaguardia‡Arrière-garde‡保护后方‡保衛後方',
    nil,
    'Mate Jarroc Asa-dilacerada, Shahandana e Gomegaz.‡Убейте Джаррока Рваное Крыло, Шахандану и Гумгаза.‡Tötet Jarroc Flügelriss, Shahandana und Gomegaz.‡찢긴 날개 자록, 샤한다나, 고메가즈를 처치해야 합니다.‡Mata a Jarroc Alarrota, a Shahandana y a Gomegaz.‡Mata a Jarroc Alarrota, a Shahandana y a Gomegaz.‡Tuez Jarroc Aile-déchirée, Shahandana et Gomegaz‡杀死伽罗克·裂翼、莎罕达娜和格姆加兹。‡殺死詹洛克·裂翼、夏寒達納和戈姆加茲。',
  }
},
[26174] = {
  {
    'O seguro morreu de velho‡Осторожность не помешает‡Nachhut‡후방 감시‡Cubrirse las espaldas‡Cubrirse las espaldas‡Au service – secret – de l\'Alliance‡留个心眼‡注意後方',
    nil,
    'Examine os Planos da Horda no Portal Negro sem ser pego.‡Изучите планы Орды у Темного портала и постарайтесь, чтобы вас не поймали за этим занятием.‡Untersucht die Pläne der Horde am Dunklen Portal, ohne erwischt zu werden.‡어둠의 문에 있는 호드 계획서를 들키지 않고 살펴봐야 합니다.‡Examina los planes de la Horda en El Portal Oscuro sin que te cacen.‡Examina los planes de la Horda en El Portal Oscuro sin que te cacen.‡Étudiez les Plans de la Horde sans vous faire prendre, à la Porte des ténèbres dans les Terres Foudroyées.‡在不被发现的情况下，查阅黑暗之门的部落计划书。‡在不被人抓到的情況下檢驗黑暗之門那裡的部落計畫。',
  }
},
[26175] = {
  {
    'Mecassur‡Сурвич‡Surwich‡수르위치‡Mechasur‡Mechasur‡Surwich‡瑟维奇‡瑟威奇',
    nil,
    'Apresente-se ao Prefeito Charlton Connisport em Mecassur, que fica na Barreira do Inferno.‡Отправляйтесь к Майору Чарлтону Конниспоту в Сурвич в Выжженных землях.‡Meldet Euch bei Bürgermeister Carl Connisport in Surwich in den Verwüsteten Landen.‡저주받은 땅의 수르위치에 있는 시장 찰턴 코니스포트에게 보고해야 합니다.‡Preséntate ante el alcalde Charlton Connisport en Mechasur en Las Tierras Devastadas.‡Preséntate ante el alcalde Charlton Connisport en Mechasur en Las Tierras Devastadas.‡Présentez-vous au Maire Charlton Connisport à Surwich dans les Terres Foudroyées.‡去找诅咒之地瑟维奇的查尔顿·康宁斯伯镇长。‡到詛咒之地裡的瑟威奇向查爾頓·康尼史伯特鎮長回報。',
  }
},
[26176] = {
  {
    'Para Thelsamar!‡Вперед на Телсамар‡Auf nach Thelsamar‡텔사마로‡Hacia Thelsamar‡Hacia Thelsamar‡En route pour Thelsamar‡前往塞尔萨玛‡往塞爾薩瑪去',
    nil,
    'Entregue o Relatório Situacional de Balbúrdia para o Montanhista Kadrell em Thelsamar.‡Доставьте отчет капитана Ругельфасса горному пехотинцу Кэдреллу в Телсамар.‡Bringt den Statusbericht von Hauptmann Rugelfuß zu Gebirgsjäger Kadrell in Thelsamar.‡경비대장 루겔퍼스의 상황 보고서를 텔사마에 있는 산악경비대 카드렐에게 전달해야 합니다.‡Entrega el informe de estado del Capitán Rugelfuss al montaraz Kadrell en Thelsamar.‡Entrega el informe de estado del Capitán Rugelfuss al montaraz Kadrell en Thelsamar.‡Remettez le Rapport de situation du Capitaine Rudagite au Montagnard Kadrell à Thelsamar.‡将拉格弗斯上尉的进度报告交给塞尔萨玛的巡山人卡德雷尔。‡把拉格弗斯上尉的形勢報告送去給塞爾薩瑪的巡山人卡德雷爾。',
  }
},
[26177] = {
  {
    'Da lama ao caos‡Крабный день‡Lust auf Krebs?‡게가 느껴지나요?‡¿Antojo de cangrejo?‡¿Antojo de cangrejo?‡Il en pince pour les crabes…‡捕捉螃蟹‡感覺到螃蟹了嗎?',
    nil,
    'Pegue 6 Caranguejos do Canal e entregue-os para Chico Magarefe em Ventobravo.‡Поймайте 6 сточных крабов. Отнесите их Робби Флею в Штормград.‡Sammelt 6 Kanalkrebse und bringt sie zu Robby Flay in Sturmwind.‡대운하 게 6마리를 잡아 스톰윈드에 있는 로비 플레이에게 가져가야 합니다.‡Atrapa 6 cangrejos de canal. Entrégaselos a Robby Flay en la Ciudad de Ventormenta.‡Atrapa 6 cangrejos de canal. Entrégaselos a Robby Flay en la Ciudad de Ventormenta.‡Attrapez 6 crabes des canaux. Apportez-les ensuite à Robby Flay, à Hurlevent.‡捕捉6只运河蟹，把它们交给暴风城的罗比·弗雷。‡抓6隻運河蟹。將牠們帶去暴風城給羅比·福雷。',
  }
},
[26178] = {
  {
    'Planning for the Future‡Планы на будущее‡Zukunftsplanungen‡미래를 위한 계획‡Pensando en el futuro‡Pensando en el futuro‡Préparer l\'avenir‡Planning for the Future‡計畫未來',
    nil,
    'Collect 12 Snowfall Glade Pups. Deliver them to Trapper Mau\'i at Moa\'ki Harbor.‡Соберите 12 щенков Поляны Снегопада. Принесите их зверолову Мау\'и в гавани Моа\'ки.‡Sammelt 12 Schneewehenwelpen und liefert sie anschließend bei Fallensteller Mau\'i im Hafen Moa\'ki ab.‡눈사태 숲 새끼 울바르 12마리를 모아키 항구에 있는 덫사냥꾼 마우이에게 가져가야 합니다.‡Recoge 12 cachorros de Claro Avalancha. Llévaselos al trampero Mau\'i al Puerto Moa\'ki.‡Recoge 12 cachorros de Claro Avalancha. Llévaselos al trampero Mau\'i al Puerto Moa\'ki.‡Récupérez 12 Louveteaux de la Clairière de Tombeneige, puis remettez-les au Trappeur Mau’i à Port-Moa’ki.‡Collect 12 Snowfall Glade Pups. Deliver them to Trapper Mau\'i at Moa\'ki Harbor.‡收集12隻落雪林地小獾狼。將他們交給默亞基港的陷捕者茂伊。',
  }
},
[26179] = {
  {
    'Empreendimentos S.A.‡Торговая Компания‡Die Venture Company‡투자개발회사‡Los Ventura y Cía.‡Los Ventura y Cía.‡La KapitalRisk‡风险投资公司‡風險投資公司',
    nil,
    'Mate 7 Trabalhadores da Empreendimentos S.A. para Morin Espreita Nuvem na Aldeia Casco Sangrento.‡Убейте 7 рабочих Торговой Компании по поручению Морина Ловца Облаков из деревни Кровавого Копыта.‡Tötet 7 Tagelöhner der Venture Co. für Morin Wolkenpirscher in der Nähe des Dorfs der Bluthufe.‡블러드후프 마을에 있는 모린 클라우드스토커를 위해 투자개발회사 노역꾼 7명을 처치해야 합니다.‡Mata a 7 trabajadores de Ventura y Cía. para Morin Acechanubes en Poblado Pezuña de Sangre.‡Mata a 7 trabajadores de Ventura y Cía. para Morin Acechanubes en Poblado Pezuña de Sangre.‡Tuez 7 Travailleurs de la KapitalRisk pour Morin Traqueur-de-Nuage de Sabot-de-Sang.‡血蹄村的摩林·云行者要你去杀死7个风险投资公司工人。‡為血蹄村的摩林‧雲巡者殺死7位風險投資公司工人。',
  }
},
[26180] = {
  {
    'Supervisor Geringonça‡Бригадир Шумовик‡Vorsteher Zischelspross‡감독관 피즈스프로켓‡Supervisor Saltatuercas‡Supervisor Saltatuercas‡Le superviseur Vibrouage‡菲兹普罗克主管‡菲茲普羅克主管',
    nil,
    'Mate o Supervisor Geringonça e pegue a Prancheta do Geringonça.‡Убейте бригадира Шумовика и принесите его планшет Морину Ловцу Облаков в деревню Кровавого Копыта.‡Tötet Vorsteher Zischelspross und nehmt sein Klemmbrett an Euch.‡감독관 피즈스프로켓을 처치하고 피즈스프로켓의 서류철을 얻어야 합니다.‡Mata al supervisor Saltatuercas y recoge el sujetapapeles de Saltatuercas.‡Mata al supervisor Saltatuercas y recoge el sujetapapeles de Saltatuercas.‡Tuer le Superviseur Vibrouage et récupérer l\'Écritoire de Vibrouage.‡杀掉菲兹普罗克主管，拿到菲兹普罗克的笔记板。‡消滅菲茲普羅克主管並收集菲茲普羅克的筆記板。',
  }
},
[26181] = {
  {
    'De volta ao Covil do Abismo Sombrio‡Возвращение в Темную пещеру‡Rückkehr zur Dämmerbucht‡다시 어둠돌파 동굴로‡De vuelta a la Cala Brechaoscura‡De vuelta a la Cala Brechaoscura‡Retour à la crique du Sombre brisant‡返回驱暗海窟‡回到黑裂灣',
    nil,
    'Fale com Erunak Falapedra no Covil do Abismo Sombrio em Vashj\'ir.‡Поговорите с Эрунаком Говорящим с Камнем в Темной пещере, что в Вайш\'ире.‡Sprecht mit Erunak Steinsprecher in der Dämmerbucht in Vashj\'ir.‡바쉬르에 있는 어둠돌파 동굴에서 에루낙 스톤스피커와 대화해야 합니다.‡Habla con Erunak Hablapiedra en la Cala Brechaoscura, en Vashj\'ir.‡Habla con Erunak Hablapiedra en la Cala Brechaoscura, en Vashj\'ir.‡Parlez à Erunak Parlepierre dans la Crique du Sombre brisant, en Vashj’ir.‡跟瓦丝琪尔驱暗海窟的石语者埃鲁纳克谈一谈。‡在瓦許伊爾的黑裂灣和伊魯納克·石語者說話。',
  }
},
[26182] = {
  {
    'De volta à Caverna Tenebrosa‡Возвращение в Зловещий грот‡Rückkehr zur Schattenhöhle‡다시 음침한 동굴로‡De vuelta a la Caverna Tenebrosa‡De vuelta a la Caverna Tenebrosa‡Retour à la caverne Ténébreuse‡返回阴暗洞穴‡回到陰暗洞穴',
    nil,
    'Fale com Erunak Falapedra na Caverna Tenebrosa em Vashj\'ir.‡Поговорите с Эрунаком Говорящим с Камнем в Зловещем гроте, что в Вайш\'ире.‡Sprecht mit Erunak Steinsprecher in der Schattenhöhle in Vashj\'ir.‡바쉬르에 있는 음침한 동굴에서 에루낙 스톤스피커와 대화해야 합니다.‡Habla con Erunak Hablapiedra en la Caverna Tenebrosa, en Vashj\'ir.‡Habla con Erunak Hablapiedra en la Caverna Tenebrosa, en Vashj\'ir.‡Parlez à Erunak Parlepierre dans la Caverne Ténébreuse, en Vashj’ir.‡跟瓦丝琪尔阴暗洞穴的石语者埃鲁纳克谈一谈。‡到瓦許伊爾的陰暗洞穴和伊魯納克·石語者談話。',
  }
},
[26183] = {
  {
    'Cidra para o rei‡Королевский сидр‡Des Königs Apfelwein‡왕의 탄산수‡La sidra del Rey‡La sidra del Rey‡Le cidre du roi‡国王的苹果酒‡國王的蘋果酒',
    nil,
    'Pegue 12 Maçãs Suculentas e entregue-as para Chico Magarefe em Ventobravo.‡Соберите 12 сочных яблок. Отнесите их Робби Флею в Штормграде.‡Sammelt 12 saftige Äpfel und bringt sie zu Robby Flay in Sturmwind.‡과즙이 풍부한 사과 12개를 주워 스톰윈드에 있는 로비 플레이에게 가져가야 합니다.‡Consigue 12 manzanas jugosas. Entrégale la fruta a Robby Flay en la Ciudad de Ventormenta.‡Consigue 12 manzanas jugosas. Entrégale la fruta a Robby Flay en la Ciudad de Ventormenta.‡Récupérez 12 Pommes juteuses et remettez-les à Robby Flay à Hurlevent.‡收集12只多汁的苹果，把它们交给暴风城的罗比·弗雷。‡取得12顆多汁的蘋果，然後帶去暴風城交給羅比·福雷。',
  }
},
[26184] = {
  {
    'O sonho de Wormthorn‡Мечта Червоточного‡Wurmdorns Traum‡웜쏜의 꿈‡El sueño de Gusaespina‡El sueño de Gusaespina‡Le rêve de Roncever‡虫棘的梦境‡蠕棘之夢',
    nil,
    'Mate 5 Destruidores Demonarcas, 5 Senhores do Medo Profanadores, 5 Arvorosos Lenhanegra Corrompidos e 3 Senhores do Brejo Esporovil na Floresta Maculada.‡Убейте 5 стражников ужаса-разрушителей, 5 повелителей ужаса-осквернителей, 5 оскверненных темностволых древней и 3 скверноспорых болотников в Проклятом лесу.‡Tötet 5 Zerstörer der Verdammniswache, 5 Schreckenslordschänder, 5 verderbte Dunkelwaldtreants und 3 Teufelssporensumpflords im Besudelten Wald.‡오염된 숲에서 파멸의 수호병 파괴자 5마리, 공포의 군주 파멸자 5마리, 타락한 흑단 나무정령 5마리, 지옥포자 수렁군주 3마리를 처치해야 합니다.‡Mata a 5 destructores guardias apocalípticos, a 5 señores del terror rapiñadores, a 5 antárboles Leñosocuro corruptos y a 3 señores de la marisma Vilespora en El Bosque Corrupto.‡Mata a 5 destructores guardias apocalípticos, a 5 señores del terror rapiñadores, a 5 antárboles Leñosocuro corruptos y a 3 señores de la marisma Vilespora en El Bosque Corrupto.‡Tuez 5 Destructeurs de la Garde funeste, 5 Seigneurs de l’effroi profanateurs, 5 Tréants sombrebois corrompus et 3 Seigneurs-tourbe gangrespores dans la Forêt Impure.‡在腐烂森林里杀死5个厄运守卫毁灭者、5个恐惧领主污染者、5个堕落的黑木树人和3个邪孢沼泽领主。‡在腐化之森裡殺死5隻末日守衛毀滅者、5隻驚懼領主污染者、5隻被腐化的暗木樹人和3隻魔孢泥沼領主。',
  }
},
[26185] = {
  {
    'Conselho do Círculo Cenariano‡Спросить совета у Круга Кенария‡Rat vom Zirkel des Cenarius‡세나리온 의회의 조언‡Consejos del Círculo Cenarion‡Consejos del Círculo Cenarion‡Un conseil du Cercle cénarien‡塞纳里奥议会的建议‡塞納里奧議會的建議',
    nil,
    'Apresente-se à Observadora Cenariana Shayana em Mecassur, que fica na Barreira do Inferno.‡Поговорите с кенарийской наблюдательницей Шайаной в Сурвиче в Выжженных землях.‡Meldet Euch bei der cenarischen Beobachterin Shayana in Surwich in den Verwüsteten Landen.‡저주받은 땅의 수르위치에 있는 세나리온 관찰자 샤야나에게 보고해야 합니다.‡Preséntate ante la observadora Cenarion Shayana en Mechasur en Las Tierras Devastadas.‡Preséntate ante la observadora Cenarion Shayana en Mechasur en Las Tierras Devastadas.‡Présentez-vous à l’Observatrice cénarienne Shayana à Surwich, dans les Terres Foudroyées.‡向诅咒之地瑟维奇的塞纳里奥观察者莎雅娜报到。‡到詛咒之地裡的瑟威奇向塞納里奧觀察者莎亞娜回報。',
  }
},
[26186] = {
  {
    'Recipiente demoníaco‡Демонический резервуар‡Dämonisches Gefäß‡악마의 용기‡Vasija demoníaca‡Vasija demoníaca‡Le réceptacle démoniaque‡魔能容器‡惡魔之軀',
    nil,
    'Mate os Ursos Pretos Maculados, Espreitadoras Noturnas Maculadas e Uivadores Maculados na Floresta Maculada e tente reunir os pedaços deles em um Recipiente Demoníaco.‡Убейте нечистых черных медведей, нечистых ночных ловцов и нечистых крикунов в Проклятом лесу, а потом составьте из их органов демонический резервуар.‡Tötet besudelte Schwarzbären, besudelte Nachtpirscher und besudelte Kreischer im Besudelten Wald und versucht, ihre Kadaverteile zu einem dämonischen Gefäß zusammenzusetzen.‡오염된 숲에서 오염된 검은곰, 오염된 흑거미, 오염된 비명박쥐를 처치한 다음, 신체 기관을 합쳐 악마의 용기를 만들어야 합니다.‡Mata a los osos negros corruptos, a los acechadores nocturnos corruptos y a los estridadores corruptos en El Bosque Corrupto, y trata de reunir sus trozos en una vasija demoníaca.‡Mata a los osos negros corruptos, a los acechadores nocturnos corruptos y a los estridadores corruptos en El Bosque Corrupto, y trata de reunir sus trozos en una vasija demoníaca.‡Tuez les Ours noirs impurs, les Traquenuits impurs et les Hurleurs impurs dans la Forêt Impure, et essayez d’assembler leurs fragments pour former un Réceptacle démoniaque.‡在腐烂森林里杀死腐烂的黑熊、腐烂的夜行蜘蛛和腐烂的尖啸蝙蝠，并将它们的肢体组合成魔能容器。‡在腐化之森殺死被感染的黑熊、被感染的夜間潛獵者和被感染的尖嘯者，然後試著將他們的屍體部位組合成惡魔之軀。',
  }
},
[26187] = {
  {
    'A ruína de Marl Wormthorn‡Падение Марла Червоточного‡Der Fall des Marl Wurmdorn‡마를 웜쏜의 몰락‡La caída de Marl Gusaespina‡La caída de Marl Gusaespina‡La chute de Marl Roncever‡玛尔·虫棘之死‡瑪爾·蠕棘之末日',
    nil,
    'Mate Marl Wormthorn em Maldraz, que fica na Barreira do Inferno. Você pode usar o Recipiente Demoníaco para despertá-lo do transe.‡Убейте Марла Червоточного у дерева Малдраз в Выжженных землях. Для того чтобы вывести Марла из транса, используйте демонический резервуар.‡Tötet Marl Wurmdorn bei Maldraz in den Verwüsteten Landen. Ihr könnt das dämonische Gefäß benutzen, um ihn aus seiner Trance zu holen.‡저주받은 땅의 말드라즈에 있는 마를 웜쏜을 처치해야 합니다. 마를 웜쏜을 무아지경 상태에서 깨어나게 하려면 악마의 용기를 사용하십시오.‡Mata a Marl Gusaespina en Maldraz en Las Tierras Devastadas. Puedes usar la vasija demoníaca para sacarlo de su trance.‡Mata a Marl Gusaespina en Maldraz en Las Tierras Devastadas. Puedes usar la vasija demoníaca para sacarlo de su trance.‡Tuez Marl Roncever à Maldraz, dans les Terres Foudroyées. Utilisez le Réceptacle démoniaque pour le sortir de sa transe.‡在诅咒之地的玛尔卓斯杀死玛尔·虫棘。你可以使用魔能容器打断他的沉睡。‡在詛咒之地裡的瑪爾德拉茲殺死瑪爾·蠕棘。你可以利用惡魔之軀將他脫出沈睡狀態。',
  }
},
[26188] = {
  {
    'Mazzranache‡Маззранач‡Mazzranach‡마즈라나체‡Mazzranache‡Mazzranache‡Mazzranache‡马兹拉纳其‡馬茲拉納奇',
    nil,
    'Leve um Fêmur de Puma das Estepes para Maur Clamachuva na Aldeia Casco Sangrento.‡Принесите бедренную кость пумы плоскогорья Мауру Заклинателю Дождя в деревню Кровавого Копыта.‡Bringt einen Knochen eines Flachlandpumas zu Maur Regenrufer im Dorf der Bluthufe.‡블러드후프 마을에 있는 마우르 레인콜러에게 평원퓨마 다리뼈를 가져가야 합니다.‡Lleva un fémur de puma de las estepas a Maur Clamalluvias en el Poblado Pezuña de Sangre.‡Lleva un fémur de puma de las estepas a Maur Clamalluvias en el Poblado Pezuña de Sangre.‡Apportez un Fémur de puma des basses plaines à Maur Mande-Pluie, à Sabot-de-Sang.‡把一根平原狮的腿骨交给血蹄村的茂尔·祈雨。‡把平原獅的腿骨帶去給血蹄村的茂爾‧祈雨。',
  }
},
[26189] = {
  {
    'A ameaça Presirada‡Угроза Злого Клыка‡Die Grollhauerbedrohung‡성난송곳니 용아귀 부족의 위협‡La amenaza Dentellada‡La amenaza Dentellada‡La menace de Hargnecroc‡怒牙的威胁‡怒牙的威脅',
    nil,
    'Mate Gorfax Presirada e mais 16 Orcs Presa do Dragão no Acampamento Presirada.‡Убейте Горфакса Злого Клыка и 16 орков из клана Драконьей Пасти в Лагере Злого Клыка.‡Tötet Gorfax Grollhauer und 16 Orcs des Drachenmals im Lager der Grollhauer.‡성난송곳니 야영지에서 고르팩스 앵거팽과 용아귀 오크 16명을 처치해야 합니다.‡Mata a Gorfax Dentellada y a 16 orcos Faucedraco en el Campamento Dentellada.‡Mata a Gorfax Dentellada y a 16 orcos Faucedraco en el Campamento Dentellada.‡Tuez Gorfax Hargnecroc et 16 Orcs gueules-de-dragon au Campement de Hargnecroc.‡杀死怒牙营地的戈尔弗克·怒牙以及16名龙喉兽人。‡到怒牙營地殺死戈爾法克斯·怒牙和16個龍喉獸人。',
  }
},
[26190] = {
  {
    'Um banquete de pescador‡Рыбацкая услада‡Ein Fischerschmaus‡낚시꾼의 잔치 음식‡El festín de un pescador‡El festín de un pescador‡Un festin de pêcheur‡渔夫的美餐‡漁夫的盛宴',
    nil,
    'Pegue 5 Bagres Gigantescos. Entregue os peixes para Chico Magarefe em Ventobravo.‡Раздобудьте 5 гигантских зубаток. Принесите рыбу Робби Флею в Штормграде.‡Bringt 5 gigantische Welse in Euren Besitz und bringt sie zu Robby Flay in Sturmwind.‡거대 메기 5개를 구해서 스톰윈드에 있는 로비 플레이에게 가져가야 합니다.‡Consigue 5 siluros gigantes. Entrégale el pescado a Robby Flay en la ciudad de Ventormenta.‡Consigue 5 siluros gigantes. Entrégale el pescado a Robby Flay en la ciudad de Ventormenta.‡Récupérez 5 Poissons-chats gigantesques. Apportez-les à Robby Flay à Hurlevent.‡收集5条巨大的鲶鱼，把它们交给暴风城的罗比·弗雷。‡取得5隻巨大鯰魚。將魚帶去暴風城給羅比·福雷。',
  }
},
[26191] = {
  {
    'O auge dos nossos esforços‡Плод стараний‡Der Gipfel unserer Bemühungen‡노력의 절정‡La culminación de nuestros esfuerzos‡La culminación de nuestros esfuerzos‡Le point culminant‡我等功业之大成‡努力的頂峰',
    nil,
    nil,
  }
},
[26192] = {
  {
    'Órfãos também gostam de biscoitos!‡Сиротки тоже любят печенье!‡Auch Waisen mögen Kekse!‡고아들도 과자를 좋아해!‡¡A los huérfanos también les gustan las galletas!‡¡A los huérfanos también les gustan las galletas!‡Les orphelins aiment aussi les macarons !‡孤儿也喜欢点心！‡孤兒們也喜歡餅乾!',
    nil,
    'Obtenha 4 sacos de Açúcar de Confeiteiro. Entregue-os para Chico Magarefe em Ventobravo.‡Раздобудьте 4 мешка сахарной пудры и отнесите Робби Флею в Штормград.‡Bringt 4 Säcke Puderzucker zu Robby Flay in Sturmwind.‡스톰윈드에 있는 로비 플레이에게 제과점 설탕 4부대를 가져가야 합니다.‡Consigue 4 sacos de azúcar de confitería. Llévale el azúcar a Robby Flay en la Ciudad de Ventormenta.‡Consigue 4 sacos de azúcar de confitería. Llévale el azúcar a Robby Flay en la Ciudad de Ventormenta.‡Récupérez 4 Sacs de sucre glace. Apportez-les à Robby Flay, à Hurlevent.‡收集4袋精制细砂糖，把它们交给暴风城的罗比·弗雷。‡取得4袋製作甜點用的糖。將糖帶去暴風城給羅比·福雷。',
  }
},
[26193] = {
  {
    'Defendendo a Fissura‡Оборона Провала‡Verteidigung des Abgrunds‡균열을 방어하라‡La defensa de la falla‡La defensa de la falla‡Défendre la faille‡保卫深渊裂口‡保衛裂隙',
    nil,
    'Fale com Erunak, no Covil do Abismo Sombrio, para participar da batalha pela Brecha Abissal.‡Обратитесь к Эрунаку в Темной пещере, чтобы отправиться в битву за Обрыв над бездной.‡Sprecht mit Erunak in der Dämmerbucht, um Euch dem Kampf um den Wirbelnden Abgrund anzuschließen.‡어둠돌파 동굴에 있는 에루낙과 대화하여 심연의 틈에서 벌어질 전투에 참여해야 합니다.‡Habla con Erunak en la Cala Brechascura para participar en la batalla por la Brecha Abisal.‡Habla con Erunak en la Cala Brechascura para participar en la batalla por la Brecha Abisal.‡Parlez à Erunak dans la Crique du Sombre brisant afin de vous joindre à la bataille pour la Brèche Abyssale.‡跟驱暗海窟的埃鲁纳克谈一谈，参与深渊裂口之战。‡和黑裂灣的伊魯納克說話，以進入深淵止境的戰役。',
  }
},
[26194] = {
  {
    'Defendendo a Fissura‡Оборона Провала‡Verteidigung des Abgrunds‡균열을 방어하라‡La defensa de la falla‡La defensa de la falla‡Défendre la faille‡保卫深渊裂口‡保衛裂隙',
    nil,
    'Fale com Erunak na Caverna Tenebrosa para participar da batalha pela Brecha Abissal.‡Обратитесь к Эрунаку Говорящему с Камнем в Зловещем гроте, чтобы вступить в битву за Обрыв над бездной.‡Sprecht mit Erunak in der Schattenhöhle, um Euch dem Kampf um den Wirbelnden Abgrund anzuschließen.‡음침한 동굴에 있는 에루낙과 대화하여 심연의 틈에서 벌어질 전투에 참여해야 합니다.‡Habla con Erunak en la Caverna Tenebrosa para participar en la batalla por la Brecha Abisal.‡Habla con Erunak en la Caverna Tenebrosa para participar en la batalla por la Brecha Abisal.‡Parlez à Erunak dans la Caverne Ténébreuse afin de vous joindre à la bataille pour la Brèche Abyssale.‡跟阴暗洞穴的埃鲁纳克谈一谈，参与深渊裂口之战。‡到陰暗洞穴去和伊魯納克交談，以加入深淵止境的戰役。',
  }
},
[26195] = {
  {
    'O verde do Verdião‡Кто сторожит Стража Природы‡Wer hütet den Sumpfhüter‡신록수호자‡Quién vigila al Guardaverde‡Quién vigila al Guardaverde‡Qui veut l\'écorce du gardien vert ?‡谁来守卫绿色守卫者‡綠意守望者的保護者',
    nil,
    'Fale com Feralon Verdefólio no Bosque do Verdião, que fica no Pantanal.‡Поговорите с Ферилоном Дитя Листвы в Роще Стража Природы, что в Болотине.‡Sprecht mit Ferilon Laubkind im Hain des Sumpfhüters im Sumpfland.‡저습지의 신록수호자의 숲에 있는 페릴론 리프본과 대화해야 합니다.‡Habla con Ferilon Hojanato en la Arboleda del Guardaverde en Los Humedales.‡Habla con Ferilon Hojanato en la Arboleda del Guardaverde en Los Humedales.‡Allez parler à Férilon Feuillené au Bosquet du Gardien vert, dans les Paluns.‡同湿地绿色守卫者林地的费里隆·叶生交谈。‡到濕地的綠意守望者之林去找菲里隆·葉成。',
  }
},
[26196] = {
  {
    'Trançalonga, o Austero‡Длиннокос Мрачный‡Langzopf der Grimmige‡결의의 롱브레이드‡Largatrenza el Nefasto‡Largatrenza el Nefasto‡Tresse-longue le Macabre‡坚毅者长须‡布萊德·長鬚',
    nil,
    'Leve o Pacote de Suprimentos de Feralon a Trançalonga, o Austero, em Dun Modr.‡Отнести полевой набор Ферилона Длиннокосу Мрачному в Дун Модре.‡Bringt Ferilons Überlebenspaket zu Langzopf dem Grimmigen in Dun Modr.‡페를리온의 구급품을 던 모드르에 있는 결의의 롱브레이드에게 가져가야 합니다.‡Entrega el botiquín de Ferilon a Largatrenza el Nefasto en Dun Modr.‡Entrega el botiquín de Ferilon a Largatrenza el Nefasto en Dun Modr.‡Apportez le Colis de secours de Férilon à Tresse-longue le Macabre, à Dun Modr.‡将费里隆的补给包交给丹莫德的坚毅者长须。‡將菲里隆的醫療包帶去丹莫德給布萊德·長鬚。',
  }
},
[26197] = {
  {
    'O futuro de Gnomeregan‡Будущее Гномрегана‡Die Zukunft von Gnomeregan‡놈리건의 미래‡El futuro de Gnomeregan‡El futuro de Gnomeregan‡L\'avenir de Gnomeregan‡诺莫瑞根的未来‡諾姆瑞根的未來',
    nil,
    'Encontre-se com Bipsi Tacagelo na Vila da Gambiarra.‡Встретьтесь с Бипси Хладолей в Новом Городе Механиков.‡Trefft Bipsi Frostschleuder in Neu-Tüftlerstadt.‡신 땜장이 마을에 있는 빕시 프로스트플링어를 만나야 합니다.‡Reúnete con Bipsi Lanzaescarcha en Nueva Ciudad Manitas.‡Reúnete con Bipsi Lanzaescarcha en Nueva Ciudad Manitas.‡Rendez-vous auprès de Bipsi Flanquegivre à La Nouvelle-Brikabrok.‡到新工匠镇去找贝西·冰雹。‡到新地精區找畢普希‧霜擲。',
  }
},
[26198] = {
  {
    'A arte do mago‡Искусство мага‡Die Künste eines Magiers‡마법사의 기술‡Las artes del mago‡Las artes del mago‡Les arts du mage‡法师的技艺‡法師之藝',
    nil,
    'Fale com Bipsi Tacagelo para treinar Mísseis Arcanos. Após aprender o feitiço, lance Mísseis Arcanos duas vezes contra um Boneco de Treinamento na Vila da Gambiarra.‡Поговорите с Бипси Хладолей, чтобы изучить заклинание "Чародейские стрелы". Когда заклинание будет изучено, дважды опробуйте его на тренировочном манекене в Новом Городе Механиков.‡Sprecht mit Bipsi Frostschleuder, um arkane Geschosse zu erlernen. Wenn Ihr den Zauber gelernt habt, dann schießt zweimal erfolgreich arkane Geschosse auf eine Trainingsattrappe in Neu-Tüftlerstadt ab.‡빕시 프로스트플링어와 대화해 신비한 화살을 배워야 합니다. 신비한 화살을 배운 뒤에는 신 땜장이 마을에 있는 훈련용 허수아비에 신비한 화살을 성공적으로 2회 명중시켜야 합니다.‡Habla con Bipsi Lanzaescarcha para aprender Misiles Arcanos. Cuando hayas aprendido el hechizo, acierta dos veces en un muñeco de entrenamiento con Misiles Arcanos en Nueva Ciudad Manitas.‡Habla con Bipsi Lanzaescarcha para aprender Misiles Arcanos. Cuando hayas aprendido el hechizo, acierta dos veces en un muñeco de entrenamiento con Misiles Arcanos en Nueva Ciudad Manitas.‡Parlez à Bipsi Flanquegivre pour vous exercer à lancer Projectiles des Arcanes. Une fois ce sort appris, lancez-le deux fois avec succès sur un Mannequin d’entraînement à La Nouvelle-Brikabrok.‡与贝西·冰雹交谈，学习奥术飞弹。然后对新工匠镇的训练假人施放2次奥术飞弹。‡和畢普希‧霜擲交談，學會秘法飛彈。一旦學會這個法術，到新地精區對訓練假人施放兩次秘法飛彈。',
  }
},
[26199] = {
  {
    'O futuro de Gnomeregan‡Будущее Гномрегана‡Die Zukunft von Gnomeregan‡놈리건의 미래‡El futuro de Gnomeregan‡El futuro de Gnomeregan‡L\'avenir de Gnomeregan‡诺莫瑞根的未来‡諾姆瑞根的未來',
    nil,
    'Encontre-se com a "Doutora" Girarroda na Vila da Gambiarra.‡Поговорите с "Доком" Вертушкой в Новом Городе Механиков.‡Trefft "Doc" Raddreh in Neu-Tüftlerstadt.‡신 땜장이 마을에 있는 "의사" 코그스핀을 만나야 합니다.‡Reúnete con "Doc" Rotadiente en Nueva Ciudad Manitas.‡Reúnete con "Doc" Rotadiente en Nueva Ciudad Manitas.‡Rendez-vous auprès de « Doc » Girodent à La Nouvelle-Brikabrok.‡到新工匠镇去找“怪医”克斯宾。‡到新地精區找『醫生』科士賓。',
  }
},
[26200] = {
  {
    'A arte do sacerdote‡Искусство жреца‡Die Künste eines Priesters‡사제의 기술‡Las artes del sacerdote‡Las artes del sacerdote‡Les arts du prêtre‡牧师的技艺‡牧師之藝',
    nil,
    'Fale com a "Doutora" Girarroda para treinar a Cura Célere. Pratique o uso da Cura Célere 5 vezes nos Soldados de Infantaria Feridos na Vila da Gambiarra.‡Поговорите с "Доком" Вертушкой, чтобы изучить заклинание "Быстрое исцеление". Потренируйтесь применять эту технику 5 раз на раненых пехотинцах в Новом Городе Механиков.‡Sprecht mit "Doc" Raddreh, um Blitzheilung zu lernen. Wendet Blitzheilung 5-mal an verwundeten Infanteristen in Neu-Tüftlerstadt an.‡"의사" 코그스핀과 대화해 순간 치유를 배운 후 신 땜장이 마을에 있는 부상당한 보병들에게 순간 치유를 5회 사용해야 합니다.‡Habla con "Doc" Rotadiente para aprender Sanación relámpago. Utiliza Sanación relámpago 5 veces sobre la infantería herida de Nueva Ciudad Manitas.‡Habla con "Doc" Rotadiente para aprender Sanación relámpago. Utiliza Sanación relámpago 5 veces sobre la infantería herida de Nueva Ciudad Manitas.‡Parlez à « Doc » Girodent pour apprendre Soins rapides. Utilisez 5 fois Soins rapides sur des Soldats d’infanterie blessés à La Nouvelle-Brikabrok.‡与“怪医”克斯宾交谈，学习快速治疗。然后对新工匠镇的受伤的步兵使用5次快速治疗。‡和「醫生」科士賓交談，學會快速治療。到新地精區對受傷的步兵使用5次快速治療。',
  }
},
[26201] = {
  {
    'O poder do bruxo‡Власть чернокнижника‡Die Macht eines Hexenmeisters‡흑마법사의 힘‡El poder de un brujo‡El poder de un brujo‡La puissance du démoniste‡术士的技艺‡術士之力',
    nil,
    'Fale com Alamar Carranca e aprenda a Imolação. Em seguida, lance o feitiço 5 vezes contra um Boneco de Treinamento na Vila da Gambiarra.‡Поговорите с Аламаром Мрачнном и 5 раз потренируйтесь применять заклинание "Жертвенный огонь" на тренировочном манекене в Новом Городе Механиков.‡Sprecht mit Alamar Grimm und lernt Feuerbrand. Dann wirkt Feuerbrand 5-mal auf eine Trainingsattrappe in Neu-Tüftlerstadt.‡알라마 그림과 대화해 제물을 배운 후 신 땜장이 마을에 있는 훈련용 허수아비에 제물을 5회 사용해야 합니다.‡Habla con Alamar Grimm y aprende Inmolar. Luego lanza Inmolar 5 veces sobre un muñeco de entrenamiento en Nueva Ciudad Manitas.‡Habla con Alamar Grimm y aprende Inmolar. Luego lanza Inmolar 5 veces sobre un muñeco de entrenamiento en Nueva Ciudad Manitas.‡Parlez à Alamar Grimm et apprenez le sort Immolation, puis lancez 5 fois ce sort sur un Mannequin d’entraînement à La Nouvelle-Brikabrok‡与阿拉玛尔·格里姆交谈，学习献祭。然后对新工匠镇的训练假人施放5次献祭。‡找阿拉瑪爾‧格里姆交談，學會獻祭。接著對新地精區的訓練假人施放5次獻祭。',
  }
},
[26202] = {
  {
    'O futuro de Gnomeregan‡Будущее Гномрегана‡Die Zukunft von Gnomeregan‡놈리건의 미래‡El futuro de Gnomeregan‡El futuro de Gnomeregan‡L\'avenir de Gnomeregan‡诺莫瑞根的未来‡諾姆瑞根的未來',
    nil,
    'Encontre-se com Alamar Carranca na Vila da Gambiarra.‡Встретьтесь с Аламаром Мрачнном в Новом Городе Механиков.‡Sucht Alamar Grimm in Neu-Tüftlerstadt auf.‡신 땜장이 마을에 있는 알라마 그림을 만나야 합니다.‡Reúnete con Alamar Grimm en Nueva Ciudad Manitas.‡Reúnete con Alamar Grimm en Nueva Ciudad Manitas.‡Rendez-vous auprès d’Alamar Grimm à La Nouvelle-Brikabrok.‡到新工匠镇去找阿拉玛尔·格里姆。‡在新地精區和阿拉瑪爾‧格里姆碰面。',
  }
},
[26203] = {
  {
    'O futuro de Gnomeregan‡Будущее Гномрегана‡Die Zukunft von Gnomeregan‡놈리건의 미래‡El futuro de Gnomeregan‡El futuro de Gnomeregan‡L\'avenir de Gnomeregan‡诺莫瑞根的未来‡諾姆瑞根的未來',
    nil,
    'Encontre-se com o Sargento-instrutor Virabrequim na Vila da Gambiarra.‡Поговорите с сержантом-инструктором Парогоном в Новом Городе Механиков.‡Sucht Ausbildungsoffizier Dampfkurbel in Neu-Tüftlerstadt auf.‡신 땜장이 마을에 있는 훈련교관 스팀크랭크를 만나야 합니다.‡Reúnete con el sargento de maniobras Mecavapor en Nueva Ciudad Manitas.‡Reúnete con el sargento de maniobras Mecavapor en Nueva Ciudad Manitas.‡Présentez-vous au Sergent Nébulevier à La Nouvelle-Brikabrok.‡到新工匠镇去找教官汽轴。‡到新地精區找訓練中士蒸汽軸。',
  }
},
[26204] = {
  {
    'A arte do guerreiro‡Искусство воина‡Die Künste eines Kriegers‡전사의 기술‡Las artes del guerrero‡Las artes del guerrero‡Les arts du guerrier‡战士的技艺‡戰士之藝',
    nil,
    'Fale com o Sargento-instrutor Virabrequim para aprender a habilidade de Investida. Em seguida, encontre um Boneco de Treinamento na Vila da Gambiarra e use a Carga contra ele.‡Поговорите с сержантом-инструктором Парогоном, чтобы обучиться атаке. Найдите тренировочный манекен в Новом Городе Механиков и потренируйтесь на нем.‡Sprecht mit Ausbildungsoffizier Dampfkurbel, um Sturmangriff zu erlernen. Wendet Sturmangriff an einer Trainingsattrappe in Neu-Tüftlerstadt an.‡훈련교관 스팀크랭크와 대화해 돌진을 배워야 합니다. 그 후 신 땜장이 마을에 있는 훈련용 허수아비를 찾아 돌진을 사용해야 합니다.‡Habla con el sargento de maniobras Mecavapor para aprender Cargar. Busca un muñeco de entrenamiento en Nueva Ciudad Manitas y utiliza Cargar contra él.‡Habla con el sargento de maniobras Mecavapor para aprender Cargar. Busca un muñeco de entrenamiento en Nueva Ciudad Manitas y utiliza Cargar contra él.‡Parlez au Sergent instructeur Nébulevier pour apprendre Charge. Trouvez un Mannequin d’entraînement à La Nouvelle-Brikabrok et Chargez-le.‡与教官汽轴交谈，学习冲锋。然后对新工匠镇的训练假人使用冲锋。‡找訓練中士蒸汽軸交談，學會衝鋒。在新地精區附近找個訓練假人，對著它使用衝鋒。',
  }
},
[26205] = {
  {
    'Esse é um trabalho para o multibô‡Работа для робота‡Eine Aufgabe für den Multi-Bot‡다목적로봇을 위한 일‡Un trabajo para el multi robot‡Un trabajo para el multi robot‡Une mission pour le robot multifonction‡多功能机器人的工作‡多工機器人的職責',
    nil,
    'Use o Multibô GS-9x para limpar 5 Gêiseres Tóxicos no Aeroporto Tóxico. Quando você se aproximar de um gêiser, o Multibô GS-9x vai começar a trabalhar imediatamente.‡Воспользуйтесь многофункциональным роботом GS-9x, чтобы очистить 5 ядовитых гейзеров на зараженном аэродроме. Когда подберетесь достаточно близко к ядовитой луже, робот автоматически начнет очищение.‡Benutzt den GS-9x Multi-Bot, um 5 toxische Geysire auf dem Toxischen Flugplatz zu säubern. Wenn Ihr nahe genug an einen Geysir herangekommen seid, wird der GS-9x Multi-Bot automatisch mit seiner Arbeit beginnen.‡GS-9x 다목적로봇을 이용해 맹독 비행장에 있는 맹독 웅덩이 5곳을 청소해야 합니다. 맹독 웅덩이에 가까이 다가가면 GS-9x 다목적로봇이 자동으로 청소를 시작할 것입니다.‡Utiliza el multi robot GS-9x para limpiar 5 géiseres tóxicos en La Base Aérea Tóxica. Cuando lo acerques bastante a un géiser, el multi robot GS-9x emprenderá su tarea de forma automática.‡Utiliza el multi robot GS-9x para limpiar 5 géiseres tóxicos en La Base Aérea Tóxica. Cuando lo acerques bastante a un géiser, el multi robot GS-9x emprenderá su tarea de forma automática.‡Utilisez le Robot multifonction GS-9x pour décontaminer 5 Geysers Toxiques à l’Aérodrome Toxique. Quand vous vous serez suffisamment approché d’un geyser, votre Robot multifonction GS-9x effectuera automatiquement la tâche pour laquelle il est programmé.‡用GS-9x多功能机器人清理剧毒机场的5处剧毒喷泉。当你距离喷泉足够近的时候，你的GS-9x多功能机器人会自动开始工作。‡在劇毒機場使用GS-9x多工機器人，清理5處劇毒湧泉。當你與湧泉離得夠近時，你的GS-9x多工機器人就會自動開始工作。',
  }
},
[26206] = {
  {
    'O futuro de Gnomeregan‡Будущее Гномрегана‡Die Zukunft von Gnomeregan‡놈리건의 미래‡El futuro de Gnomeregan‡El futuro de Gnomeregan‡L\'avenir de Gnomeregan‡诺莫瑞根的未来‡諾姆瑞根的未來',
    nil,
    'Encontre-se com Kelsey Fagulhaço na Vila da Gambiarra.‡Поговорите с Келси Стализвон в Новом Городе Механиков.‡Sucht Kelsey Stahlfunken in Neu-Tüftlerstadt auf.‡신 땜장이 마을에 있는 켈시 스틸스파크를 만나야 합니다.‡Reúnete con Kelsey Chispacero en Nueva Ciudad Manitas.‡Reúnete con Kelsey Chispacero en Nueva Ciudad Manitas.‡Rendez-vous auprès de Kelsey Étinçacier à La Nouvelle-Brikabrok.‡到新工匠镇去找凯尔希·钢烁。‡到新地精區找凱爾希‧鋼火。',
  }
},
[26207] = {
  {
    'A arte do ladino‡Искусство разбойника‡Die Künste eines Schurken‡도적의 기술‡Las artes del pícaro‡Las artes del pícaro‡Les arts du voleur‡潜行者的技艺‡盜賊之藝',
    nil,
    'Fale com Kelsey Fagulhaço para aprender a Eviscerar. Em seguida, encontre um boneco de treinamento na Vila da Gambiarra e pratique a técnica 3 vezes.‡Поговорите с Келси Стализвон, чтобы обучиться способности "Потрошение", а затем найдите в Новом Городе Механиков тренировочный манекен и попрактикуйтесь в использовании техники 3 раза.‡Sprecht mit Kelsey Stahlfunken, um Ausweiden zu lernen. Sucht dann nach einer Trainingsattrappe in Neu-Tüftlerstadt und übt Ausweiden 3-mal.‡켈시 스틸스파크와 대화해 절개를 배운 후 신 땜장이 마을에 있는 훈련용 허수아비를 찾아 절개를 3회 사용해야 합니다.‡Habla con Kelsey Chispacero para aprender Eviscerar. Luego busca un muñeco de entrenamiento en Nueva Ciudad Manitas y practica Eviscerar 3 veces.‡Habla con Kelsey Chispacero para aprender Eviscerar. Luego busca un muñeco de entrenamiento en Nueva Ciudad Manitas y practica Eviscerar 3 veces.‡Parlez à Kelsey Étinçacier pour apprendre Éviscération, puis trouvez un mannequin d’entraînement à La Nouvelle-Brikabrok et exercez-vous à l’utiliser trois fois.‡与凯尔希·钢烁交谈，学习刺骨。然后对新工匠镇的训练假人使用3次刺骨。‡和凱爾希‧鋼火交談，學會剔骨。接著對新地精區的訓練假人使用3次剔骨。',
  }
},
[26208] = {
  {
    'A luta continua‡Битва продолжается‡Der Kampf wird fortgesetzt‡전투는 계속된다‡La lucha continúa‡La lucha continúa‡Le combat continue !‡战斗继续‡繼續戰鬥',
    nil,
    'Assista à apresentação da holomesa em frente ao Grão-faz-tudo Mekkatorque para saber mais sobre a Operação: Gnomeregan.‡Посмотрите на голографическую панель перед главным механиком Меггакрутом, чтобы узнать об операции "Гномреган".‡Betrachtet den Holo-Tisch vor Hochtüftler Mekkadrill, um mehr über Operation: Gnomeregan zu erfahren.‡땜장이왕 멕카토크와 함께 놈리건 작전이 어떻게 진행되었는지 알아봐야 합니다.‡Observa la holomesa que hay enfrente del Manitas Mayor Mekkatorque para aprender sobre la Operación: Gnomeregan.‡Observa la holomesa que hay enfrente del Manitas Mayor Mekkatorque para aprender sobre la Operación: Gnomeregan.‡Regardez l’holotable en face du Grand Bricoleur Mekkanivelle pour apprendre en quoi consiste l’opération Gnomeregan.‡观看大工匠梅卡托克前面的全息桌面，了解诺莫瑞根行动的内容。‡查看大工匠梅卡托克面前的全像顯示台，了解「諾姆瑞根行動」的資訊。',
  }
},
[26209] = {
  {
    'Olho vivo e faro fino‡На меня повесили убийство‡Der Mordfall war der Fall, den sie mir gaben‡그들이 내게 준 사건은 살인사건이었다‡El caso que me dieron era de asesinato‡El caso que me dieron era de asesinato‡Meurtre au soleil‡他们把谋杀案撂我这儿了‡謀殺案調查',
    nil,
    'Fale com os desabrigados que ocuparam o Sítio dos Jansen para reunir pistas sobre o assassinato dos Taturanas.‡Поговорите с несколькими бездомными людьми, населяющими владение Янсена, чтобы найти какие-нибудь указания на то, кто убил Хмуробровов.‡Sprecht mit den verschiedenen Obdachlosen, die auf Jansens Hof leben, um Hinweise über die Brauenwirbelmorde zu sammeln.‡얀센 농장을 점거 중인 여러 피난민과 대화하여 펄브라우 살인자에 대한 단서를 모아야 합니다.‡Habla con varios vagabundos que ocupan la Finca de Jansen para reunir pruebas sobre el asesinato de los Cejade.‡Habla con varios vagabundos que ocupan la Finca de Jansen para reunir pruebas sobre el asesinato de los Cejade.‡Parlez aux sans-abri qui occupent la Ferme des Jansen, pour rassembler des indices sur le meurtre des Froncebouille.‡同贾森农场的多名无家可归者交谈，收集法布隆谋杀案的线索。‡與傑生農場上的遊民說話，收集有關法布隆謀殺案的情報。',
  }
},
[26210] = {
  {
    'Gammerita, cara!‡Гаммерита!‡Gammerita, Alter!‡감메리타!‡¡Gammerita, colega!‡¡Gammerita, colega!‡Gammerita, l\'ami !‡加莫里塔，伙计！‡加莫里塔!',
    nil,
    'Katum, o Pesqueiro, na Aldeia Revatusco, que fica nas Terras Agrestes, quer que você mate Gammerita e apanhe a Melhor Isca de Katum da carcaça.|n|nKatum mencionou que Gammerita circula pela costa com as outras tartarugas.‡Убейте Гаммериту и верните Катуму Удильщику из деревни Сломанного Клыка его лучшую блесну.|n|nКатум сказал, что Гаммерита ползает по берегу среди остальных черепах.‡Katoom, der Angler aus dem Dorf der Bruchhauer im Hinterland möchte, dass Ihr Gammerita tötet und Katooms besten Köder aus ihrem Kadaver holt.|n|nKatoom meinte, dass Gammerita sich an der Küste bei den anderen Schildkröten aufhält.‡동부 내륙지의 깨진엄니 마을에 있는 낚시꾼 카툼이 감메리타를 처치하고 카툼의 최고급 미끼를 되찾아 달라고 했습니다.|n|n감메리타는 해안에서 다른 거북들과 함께 있다고 합니다.‡Katoom el Pescador, del Poblado Sañadiente en las Tierras del Interior, quiere que mates a Gammerita y que le saques el cebo del estómago.|n|nDijo que Gammerita está en la costa con las otras tortugas.‡Katoom el Pescador, del Poblado Sañadiente en las Tierras del Interior, quiere que mates a Gammerita y que le saques el cebo del estómago.|n|nDijo que Gammerita está en la costa con las otras tortugas.‡Katoom le pêcheur, du village des Vengebroches dans les Hinterlands, veut que vous tuiez Gammerita et que vous récupériez le Meilleur appât de Katoom sur son cadavre.|n|nKatoom a mentionné que Gammerita rôdait sur la côte, avec d’autres tortues.‡辛特兰恶齿村的钓鱼者卡图姆要你去杀掉加莫里塔，从她的尸体里拿回卡图姆的超级鱼饵。|n|n卡图姆提到加莫里塔会和海岸上的其他乌龟在一起。‡辛特蘭惡齒村的「垂釣者」卡圖姆要你去殺掉加莫里塔，並從她的屍體上找到卡圖姆的超級擬餌。|n|n卡圖姆說加莫里塔和其他海龜都在海岸附近活動。',
  }
},
[26211] = {
  {
    'Mordeliscas, cara!‡Хрустогрызы, чувак!‡Schnappkiefer, Alter!‡바닷물 무쇠턱거북!‡¡Quijafortes, colega!‡¡Quijafortes, colega!‡Les Gueules d\'acier, l\'ami !‡钳嘴，伙计！‡鉗嘴龜!',
    nil,
    'Katum, o Pesqueiro, na Aldeia Revatusco, que fica nas Terras Agrestes, quer que você mate 10 tartarugas Mordeliscas de Água Salgada. Fale novamente com ele quando concluir a tarefa.‡Убейте 10 морских хрустогрызов по поручению Катума Удильщика из деревни Сломанного Клыка во Внутренних землях.‡Katoom der Angler aus dem Dorf der Bruchhauer im Hinterland möchte, dass Ihr 10 Salzwasserschnappkiefer tötet. Kehrt zu ihm zurück, sobald Ihr Eure Aufgabe erledigt habt.‡바닷물 무쇠턱거북 10마리를 처치하고 동부 내륙지의 깨진엄니 마을에 있는 낚시꾼 카툼에게 가야 합니다.‡Katoom el Pescador, del Poblado Sañadiente en las Tierras del Interior, quiere que mates 10 quijafortes marinos. Ve a verlo cuando hayas terminado.‡Katoom el Pescador, del Poblado Sañadiente en las Tierras del Interior, quiere que mates 10 quijafortes marinos. Ve a verlo cuando hayas terminado.‡Katoom le pêcheur, du village des Vengebroches des Hinterlands, veut que vous tuiez 10 tortues Gueules d’acier des mers. Retournez le voir lorsque vous aurez terminé.‡辛特兰恶齿村的钓鱼者卡图姆要你去杀掉10只海水钳嘴龟。任务完成后再去找他。‡辛特蘭惡齒村的「垂釣者」卡圖姆要你去殺掉10隻海水鉗嘴龜。完成任務之後回到他那裡去覆命。',
  }
},
[26212] = {
  {
    'Banha perdeu o almoço‡Лярд потерял свой обед‡Lards vergessene Brotzeit‡잃어버린 라드의 점심‡Lard perdió su almuerzo‡Lard perdió su almuerzo‡Lard a perdu son déjeuner !‡拉尔德把午饭弄丢了‡拉爾德的午餐',
    nil,
    'Banha na Aldeia Revatusco, que fica nas Terras Agrestes, quer que você encontre o Almoço do Banha. Fale novamente com ele quando a tarefa for concluída.|n|nBanha mencionou tê-lo esquecido na ilha ao norte. Cuidado com os trolls Ramatorpe.‡Найдите обед Лярда из деревни Сломанного Клыка во Внутренних землях.|n|nЛярд сказал, что потерял свой обед на острове к северу, где могут встретиться тролли из племени Порочной Ветви.‡Lard aus dem Dorf der Bruchhauer im Hinterland möchte, dass Ihr Lards Brotzeit wieder findet. Kehrt nach Erfüllung dieser Aufgabe zu ihm zurück.|n|nLard erwähnte, dass er es auf der Insel im Norden vergessen habe. Achtet auf die Trolle der Blutfratzen.‡동부 내륙지의 깨진엄니 마을에 있는 라드에게 라드의 점심을 가져가야 합니다.|n|n라드가 점심을 북쪽에 있는 섬에 두고왔다고 했습니다. 썩은가지 트롤을 조심하십시오.‡Lard, del Poblado Sañadiente en las Tierras del Interior, quiere que vayas a buscar su almuerzo. Llévaselo cuando lo encuentres.|n|nDijo que se lo dejó en la isla del norte. Ten cuidado con los trols Vilrama.‡Lard, del Poblado Sañadiente en las Tierras del Interior, quiere que vayas a buscar su almuerzo. Llévaselo cuando lo encuentres.|n|nDijo que se lo dejó en la isla del norte. Ten cuidado con los trols Vilrama.‡Lard, du village des Vengebroches, dans les Hinterlands, veut que vous retrouviez le Repas de Lard. Retournez le voir lorsque ce sera fait.|n|nD’après Lard, il l’aurait laissé dans l’île, au nord. Prenez garde aux trolls vilebranches !‡辛特兰恶齿村的拉尔德要你去找拉尔德的午餐。任务完成后再去找他。|n|n拉尔德提到他将其落在北方的岛上了。当心邪枝巨魔。‡辛特蘭惡齒村的拉爾德要求你去找到拉爾德的午餐。完成任務之後就回到他那裡去。|n|n拉爾德說他把午餐留在了北面的島上。當心邪枝食人妖。',
  }
},
[26213] = {
  {
    'De olho no lance: o clã Pata Molhada‡По горячему следу: клан Речной лапы‡Auf heißer Spur: Der Flusspfotenklan‡불타는 대수사선: 갈퀴발 일족‡Siguiendo el rastro: el clan Zarparrío‡Siguiendo el rastro: el clan Zarparrío‡Sur la piste du clan Rivepatte‡重要线索：河爪氏族‡重要線索:河爪氏族',
    nil,
    'Recolha a Pista de Gnoll Pata Molhada.‡Найдите улику против гноллов из стаи Речной Лапы.‡Erhaltet den Hinweis der Flusspfotengnolle.‡갈퀴발 놀 단서를 획득해야 합니다.‡Recupera la pista gnoll Zarparrío.‡Recupera la pista gnoll Zarparrío.‡Récupérez l\'Indice des gnolls rivepattes.‡收集河爪豺狼人的线索。‡收集河爪豺狼人的線索。',
  }
},
[26214] = {
  {
    'De olho no lance: murlocs‡По горячему следу: мурлоки‡Auf der Spur: Murlocs‡불타는 대수사선: 멀록‡Siguiendo el rastro: múrlocs‡Siguiendo el rastro: múrlocs‡Sur la piste des murlocs‡重要线索：鱼人‡重要線索:魚人',
    nil,
    'Recolha a Pista do Murloc.‡Добудьте улику против мурлоков.‡Findet den Murlochinweis.‡멀록 단서를 획득해야 합니다.‡Encuentra la pista de múrloc.‡Encuentra la pista de múrloc.‡Récupérez l\'Indice des murlocs.‡收集鱼人的线索。‡收集魚人的線索。',
  }
},
[26215] = {
  {
    'Conheça o Lu "Dois Sapatos"‡Встреча с Переобутым Лу‡Ein Treffen mit Lou Zweischuh‡쌍신발 루를 소개합니다‡Presentamos a Lou Dos Zapatos‡Presentamos a Lou Dos Zapatos‡Permettez-moi de vous présenter Lou Deux-Semelles‡拜访“老好人”洛伊‡認識「雙蹄鐵」勞',
    nil,
    'Fale com o Lu "Dois Sapatos" na Plantação de Abóboras do Taturana, em Cerro Oeste.‡Поговорите с Переобутым Лу на тыквенной ферме Хмуроброва в Западном крае.‡Sprecht mit Lou Zweischuh auf Brauenwirbels Kürbishof in Westfall.‡서부 몰락지대의 펄브라우 호박밭에 있는 쌍신발 루와 대화해야 합니다.‡Habla con Lou Dos Zapatos en la Plantación de Calabazas de Cejade, en Páramos de Poniente.‡Habla con Lou Dos Zapatos en la Plantación de Calabazas de Cejade, en Páramos de Poniente.‡Parlez à Lou Deux-Semelles à la Ferme de potirons des Froncebouille, dans la Marche de l\'Ouest.‡同法布隆南瓜农场的“老好人”洛伊交谈。‡到西部荒野的法布隆南瓜農場和「雙蹄鐵」勞說話。',
  }
},
