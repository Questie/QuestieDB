},
[13502] = {
  {
    'A cesta de Jardinova‡Что вам надо? Шоколада!‡Einen Korb bekommen!‡소쿠리, 광주리, 귀족의 정원 바구니‡¿Qué llevas en la cestita?‡¿Qué llevas en la cestita?‡Mettez tous vos œufs dans ce panier‡巧克力甜又甜，全都装进彩蛋篮‡滴搭滴，貴族花園籃',
    nil,
    'O Comerciante de Jardinova quer que você colete 10 Chocolates de Jardinova e os entregue junto com a Cesta de Ovos.‡Соберите 10 праздничных шоколадных яиц и отдайте их продавцу Сада чудес вместе с позаимствованной корзиной для яиц.‡Der Nobelgartenverkäufer möchte, dass Ihr 10 Nobelgartenschokoladen sammelt und ihm zusammen mit dem Eierkorb zurückbringt.‡귀족의 정원 상인이 귀족의 정원 초콜릿 10개를 모아, 빌린 알 바구니와 함께 가져와 달라고 했습니다.‡El vendedor del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves de vuelta junto a la cesta de huevos prestada.‡El vendedor del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves de vuelta junto a la cesta de huevos prestada.‡Le Vendeur du Jardin des nobles vous demande de ramasser 10 Chocolats du Jardin des nobles et de les lui rapporter, ainsi que le Panier à œufs emprunté.‡复活节小贩要你收集10块复活节巧克力，并将巧克力和借来的蛋篮一起交还给他。‡貴族花園商販要你收集10個貴族花園巧克力，並帶著借來的蛋籃回去找他。',
  }
},
[13503] = {
  {
    'A cesta de Jardinova‡Что вам надо? Шоколада!‡Einen Korb bekommen!‡소쿠리, 광주리, 귀족의 정원 바구니‡¿Qué llevas en la cestita?‡¿Qué llevas en la cestita?‡Mettez tous vos œufs dans ce panier‡巧克力甜又甜，全都装进彩蛋篮‡滴搭滴，貴族花園籃',
    nil,
    'O Mercador de Jardinova quer que você colete 10 Chocolates de Jardinova e os entregue junto com a Cesta de Ovos.‡Соберите 10 праздничных шоколадных яиц и отдайте их торговцу Сада чудес вместе с позаимствованной корзиной для яиц.‡Der Nobelgartenhändler möchte, dass Ihr 10 Nobelgartenschokoladen sammelt und ihm zusammen mit dem Eierkorb zurückbringt.‡귀족의 정원 판매원이 귀족의 정원 초콜릿 10개를 모아, 빌린 알 바구니와 함께 가져와 달라고 했습니다.‡El mercader del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves de vuelta junto a la cesta de huevos prestada.‡El mercader del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves de vuelta junto a la cesta de huevos prestada.‡Le Marchand du Jardin des nobles vous demande de ramasser 10 Chocolats du Jardin des nobles et de les lui rapporter, ainsi que le Panier à œufs emprunté.‡复活节商人要你收集10块复活节巧克力，并将巧克力和借来的蛋篮一起交还给他。‡貴族花園商人要你收集10個貴族花園巧克力，並帶著借來的蛋籃回去找他。',
  }
},
[13504] = {
  {
    'Os operários Lança Partida‡Работники Пронзающего Копья‡Arbeiter der Splitterspeere‡뾰족창 부족의 일꾼들‡Los obreros Rompelanzas‡Los obreros Rompelanzas‡Les travailleurs briselances‡碎矛劳工‡碎矛苦力',
    nil,
    'Mate 10 Operários Lança Partida.‡Убейте 10 работников из племени Пронзающего Копья.‡Tötet 10 Arbeiter der Splitterspeere.‡뾰족창 일꾼 10마리를 처치해야 합니다.‡Mata a 10 obreros Rompelanzas.‡Mata a 10 obreros Rompelanzas.‡Tuez 10 Travailleurs briselances.‡消灭10名碎矛劳工。‡殺死10名碎矛苦力。',
  }
},
[13505] = {
  {
    'Vestígios dos Altaneiros‡Оставшиеся высокорожденные‡Relikte der Hochgeborenen‡명가의 유산‡Las reliquias Altonato‡Las reliquias Altonato‡Les vestiges des Bien-nés‡上层精灵的遗留‡精靈貴族遺跡',
    nil,
    'Resgate 8 Relíquias dos Altaneiros.‡Добудьте 8 реликвий высокорожденных.‡Erhaltet 8 Relikte der Hochgeborenen.‡명가의 유물 8개를 되찾아야 합니다.‡Recoge 8 reliquias Altonato.‡Recoge 8 reliquias Altonato.‡Récupérez 8 Reliques de Bien-né.‡收集8件上层精灵的遗物。‡取得8個精靈貴族聖物。',
  }
},
[13506] = {
  {
    'Motivo de preocupação‡Причины для волнения‡Grund zur Sorge‡걱정의 이유‡Espías a la vista‡Espías a la vista‡Des raisons de s\'inquiéter‡担心的理由‡擔心的理由',
    nil,
    'Leve as Ordens dos Lança Partida à Tenente Moira Brisastral nas Ruínas de Mathistra.‡Принесите приказы Сумеречного Молота лейтенанту Морре Звездный Ветер на руины Матистры.‡Bringt die Splitterspeerbefehle zu Leutnant Morra Sternenhauch in den Ruinen von Mathystra.‡마시스트라 폐허에 있는 부관 모라 스타브리즈에게 감독관의 명령서를 가져가야 합니다.‡Lleva las órdenes Rompelanzas a la teniente Morra Brisa Estelar en las Ruinas de Mathystra.‡Lleva las órdenes Rompelanzas a la teniente Morra Brisa Estelar en las Ruinas de Mathystra.‡Remettez les Ordres briselances au Lieutenant Morra Brise-Stellaire, aux Ruines de Mathystra.‡将碎矛命令带给玛塞斯特拉废墟的莫拉·星风中尉。‡將碎矛命令帶回去瑪塞斯特拉廢墟給莫拉·星風中尉。',
  }
},
[13507] = {
  {
    'Ataque os atacantes‡Отрицание силы‡Verwehrt ihnen die Arbeit‡병력 차단‡Negar mano de obra‡Negar mano de obra‡Privation de personnel‡消减人手‡削減人力',
    nil,
    'Mate 6 Impositores da Horda e 6 Místicos Lança Partida.‡Убейте 6 головорезов Орды и 6 мистиков племени Пронзающего Копья.‡Tötet 6 Vollstrecker der Horde und 6 Mystiker der Splitterspeere.‡호드 집행자 6마리와 뾰족창 비술사 6마리를 처치해야 합니다.‡Mata a 6 déspotas de la Horda y a 6 místicos Rompelanzas.‡Mata a 6 agentes de la Horda y a 6 místicos Rompelanzas.‡Tuez 6 Massacreurs de la Horde et 6 Mystiques briselances.‡消灭6名部落执行者6名碎矛秘法师。‡殺死6個部落執行者和6個碎矛秘術使。',
  }
},
[13508] = {
  {
    'Resposta rápida‡Мгновенный ответ‡Schnelle Reaktion‡신속한 대응‡Una respuesta veloz‡Una respuesta veloz‡Une réponse rapide‡快速反应‡快速反應',
    nil,
    'Encontre as prisioneiras elfas noturnas no Acampamento de Guerra Lança Partida.‡Найдите пленных ночных эльфов в Боевом лагере Пронзающего Копья.‡Findet die gefangenen Nachtelfen im Kriegslager der Splitterspeere.‡뾰족창 전쟁 기지에 있는 나이트 엘프 포로들을 찾아야 합니다.‡Encuentra a los elfos de la noche prisioneros en el Campamento de Guerra Rompelanzas.‡Encuentra a los elfos de la noche prisioneros en el Campamento de Guerra Rompelanzas.‡Retrouvez les prisonnières elfes de la nuit, au Camp de guerre des Briselances.‡在碎矛战争营地里找到暗夜精灵囚犯。‡在碎矛戰營找出夜精靈囚犯。',
  }
},
[13509] = {
  {
    'Suprimentos de guerra‡Военный склад‡Kriegsvorräte‡전투 보급품‡Suministros de guerra‡Suministros de guerra‡Fournitures de guerre‡战时补给‡戰爭物資',
    nil,
    'Destrua 12 Armamentos dos Lança Partida.‡Уничтожьте 12 единиц оружия троллей Пронзающего Копья.‡Zerstört 12 Vorratskisten der Splitterspeere.‡뾰족창 장비 12개를 파괴해야 합니다.‡Destruye 12 armamentos Rompelanzas.‡Destruye 12 armamentos Rompelanzas.‡Détruisez 12 Armes briselances.‡摧毁12处碎矛军备。‡摧毀12個碎矛武裝。',
  }
},
[13510] = {
  {
    'Bem na hora!‡Своевременное прибытие‡Rechtzeitige Ankunft‡때맞춘 구원의 손길‡Una llegada oportuna‡Una llegada oportuna‡Une arrivée providentielle‡及时赶到‡及時趕到',
    nil,
    'Escolte a Sentinela Aynasha em Segurança.‡Сопроводите часового Айнашу в безопасное место.‡Bringt Schildwache Aynasha in Sicherheit.‡파수꾼 아이나샤를 안전하게 호위해야 합니다.‡Escolta a la centinela Aynasha hasta que esté a salvo.‡Escolta a la centinela Aynasha hasta que esté a salvo.‡Escortez la sentinelle Aynasha jusqu\'à ce qu\'elle soit en sécurité‡安全护送哨兵阿娜莎。‡護送哨兵阿娜莎到安全的處所。',
  }
},
[13511] = {
  {
    'Desejo amargo‡Последняя просьба‡Ein verbitterter Wunsch‡마지막 소원‡Un deseo amargo‡Un deseo amargo‡Un vœu amer‡悲恨仇怨‡苦澀的願望',
    nil,
    'Mate Rit\'ko, o Torturador dos Lança Partida.‡Убейте Рит\'ко, мучителя из племени Пронзающего Копья.‡Tötet Rit\'ko, den Folterer der Splitterspeere.‡뾰족창일족 고문관인 리트코를 처치해야 합니다.‡Mata a Rit\'ko, el torturador Rompelanzas.‡Mata a Rit\'ko, el torturador Rompelanzas.‡Tuez Rit\'ko, le Tortionnaire Briselance.‡杀死碎矛拷问者力克托。‡殺死瑞寇，碎矛拷問者。',
  }
},
[13512] = {
  {
    'Golpes estratégicos‡Предупредительный удар‡Strategische Schläge‡전략적 공격‡Ataques estratégicos‡Ataques estratégicos‡Frappes stratégiques‡战略打击‡戰略攻擊',
    nil,
    'Mate Sheyla Tempestece e Lorenth Trovejada.‡Убейте Шейю Вьющую Грозы и Лорента Громовой Зов.‡Tötet Sheya Sturmwirker und Lorenth Donnerruf.‡쉐야 스톰위버와 로렌스 썬더콜을 처치해야 합니다.‡Mata a Sheya Tejetormentas y a Lorenth Invocatruenos.‡Mata a Sheya Tejetormentas y a Lorenth Invocatruenos.‡Tuez Sheya Tissetempête et Lorenth Mandetonnerre.‡杀死风暴编织者赛雅和洛伦瑟·唤雷。‡殺死希亞·風暴編織者與羅倫斯·喚雷。',
  }
},
[13513] = {
  {
    'No limite‡На грани‡Kein Zurück‡임박한 최후‡En el límite‡En el límite‡Sur le fil‡一触即发‡邊緣',
    nil,
    'Consiga 6 Amuletos dos Lança Partida.‡Добудьте 6 амулетов племени Пронзающего Копья.‡Erhaltet 6 Amulette der Splitterspeere.‡뾰족창 아뮬렛 6개를 회수해야 합니다.‡Consigue 6 amuletos Rompelanzas.|n‡Consigue 6 amuletos Rompelanzas.|n‡Rapportez 6 Amulettes briselances.‡收集6个碎矛护符。‡取回6個碎矛護符。',
  }
},
[13514] = {
  {
    'A ira dos ancientes‡Гнев Древних‡Der Zorn der Urtume‡고대정령의 분노‡La ira de los Ancestros‡La ira de los Ancestros‡Le courroux des anciens‡古树的怒火‡古樹的憤怒',
    nil,
    'Acompanhe um Protetor Vingativo, mate 30 Trolls Lança Partida e destrua 6 Construções dos Lança Partida.‡Присоединитесь к мстительным заступникам, чтобы убить 30 троллей Пронзающего Копья и уничтожить 6 построек Пронзающего Копья.‡Benutzt einen rachsüchtigen Beschützer um 30 Trolle der Splitterspeere zu töten und 6 Gebäude der Splitterspeere zu zerstören.‡복수심에 찬 수호자를 활용하여 뾰족창 트롤 30명을 처치하고 뾰족창 건물 6채를 파괴해야 합니다.‡Utiliza a un protector vengativo para matar a 30 trols Rompelanzas y destruir 6 edificios Rompelanzas.‡Utiliza a un protector vengativo para matar a 30 trols Rompelanzas y destruir 6 edificios Rompelanzas.‡Utilisez un Protecteur vengeur pour tuer 30 Trolls briselances, et pour détruire 6 Bâtiments briselances.‡调用狂怒的保护者杀死30名碎矛巨魔，并摧毁6处碎矛建筑。‡利用復仇保衛者殺死30名碎矛食人妖並摧毀6個碎矛建築。',
  }
},
[13515] = {
  {
    'O fim da ameaça‡Покончить с угрозой‡Das Ende der Bedrohung‡위협의 종결‡Acabar con la amenaza‡Acabar con la amenaza‡Mettre un terme à la menace‡结束威胁‡終結威脅',
    nil,
    'Fale com Sandrya Luméluna para que o ataque comece, e ajude-a a matar Jor\'kil, o Ranca-alma.‡Поговорите с охотницей Сандрией Закат Луны, чтобы она отдала приказ к наступлению, и помогите ей убить Джор\'кила Убийцу Душ.‡Sprecht mit Sandrya Mondsturz, um den Angriff zu starten, und helft ihr dann dabei, Jor\'kil den Seelenreißer zu töten.‡산드리아 문폴과 대화하여 공격을 시작하고, 영혼해체자 조르킬을 처치하도록 도와야 합니다.‡Habla con Sandrya Puestaluna para iniciar el ataque y ayúdala a matar a Jor\'kil el Desgarrador de Almas.‡Habla con Sandrya Puestaluna para iniciar el ataque y ayúdala a matar a Jor\'kil el Desgarrador de Almas.‡Allez parler à Sandrya Tombelune lorsque vous serez prêt à passer à l’attaque, et aidez-la à tuer Jor\'kil le Faucheur d\'âmes.‡跟桑德娅·月落交谈以展开进攻，帮她杀掉剥魂者乔基尔。‡和珊崔雅‧月落說話來開始攻擊，並協助他殺死『靈魂撕裂者』賈基爾。',
  }
},
[13518] = {
  {
    'A última onda de sobreviventes‡Последняя группа беженцев‡Die letzte Welle Überlebender‡마지막 생존자들‡La última oleada de supervivientes‡La última oleada de supervivientes‡La dernière vague de survivants‡最后一波幸存者‡最後一波倖存者',
    nil,
    'Procure refugiados de Auberdine vivos.‡Найдите всех выживших беженцев из Аубердина.‡Macht alle überlebenden Flüchtlinge von Auberdine ausfindig.‡살아남은 아우버다인의 생존자들을 찾아야 합니다.‡Localiza a los refugiados de Auberdine que hayan sobrevivido.‡Localiza a los refugiados de Auberdine que hayan sobrevivido.‡Retrouvez tout réfugié d\'Auberdine encore vivant.‡找到依然生还的奥伯丁难民。‡在奧伯丁尋找任何仍然活著的難民。',
  }
},
[13519] = {
  {
    'O Martelo do Crepúsculo‡Культ Сумеречного Молота‡Der Schattenhammer‡황혼의 망치단‡El Martillo Crepuscular‡El Martillo Crepuscular‡Le Marteau du crépuscule‡暮光之锤‡暮光之錘',
    nil,
    'Mate o Grão-sectário Azerynn e 10 Fanáticos do Crepúsculo no Acampamento do Crepúsculo.‡Убейте верховного сектанта Азеринна и 10 фанатиков культа Сумеречного Молота в лагере Сумеречного Молота.‡Tötet Hochkultist Azerynn und 10 Fanatiker des Schattenhammers im Lager des Schattenhammers.‡황혼의 야영지에서 황혼의 광신자 10마리와 고위 이교도 아제린을 처치해야 합니다.‡Mata al sumo cultor Azerynn y a 10 fanáticos Crepusculares en el Campamento Crepuscular.‡Mata al sumo cultor Azerynn y a 10 fanáticos Crepusculares en el Campamento Crepuscular.‡Tuez le Haut-sectateur Azerynn et 10 Fanatiques du Crépuscule au Campement du crépuscule.‡击败暮光营地的高阶教徒阿泽林以及10名暮光狂热者。‡在暮光營地殺死高階教徒埃瑟因和10名暮光狂熱者。',
  }
},
[13520] = {
  {
    'A dádiva dos mares‡Дар морей‡Der Segen der Meere‡바다의 은혜‡El favor del mar‡El favor del mar‡Le don des mers‡海洋的恩赐‡大海的恩賜',
    nil,
    'Colete 16 pedaços de Carne de Marisco Encrustada.‡Соберите 16 затвердевших мышц моллюска.‡Sammelt 16 verkrustete Muschelmuskeln.‡딱딱한 조개 관자 16개를 모아야 합니다.‡Recoge 16 músculos de almeja taraceados.‡Recoge 16 músculos de almeja taraceados.‡Récupérez 16 Muscles de palourdes incrustés.‡收集16份带壳蚌肉。‡收集16份鑲嵌蚌殼肉。',
  }
},
[13521] = {
  {
    'Caixazorra 413‡Жужжалка 413‡Dröhnkiste 413‡윙윙상자 413‡La caja mecánica 413‡La caja mecánica 413‡Bigobox 413‡传声盒413号‡傳聲盒413號',
    nil,
    'Colete 4 peças de Carne de Maretisco Corrompido e leve-as à Caixazorra 413 para análise.‡Соберите 4 куска мяса зараженного прибрежного краба и отнесите их к Жужжалке 413 для анализа.‡Sammelt 4 Proben verderbtes Gezeitenkriecherfleisch und bringt es zur Analyse zur Dröhnkiste 413.‡타락한 파도게 살덩이 표본 4개를 모은 다음, 분석을 위해 윙윙상자 413으로 가져가야 합니다.‡Recoge 4 muestras de carne de reptador de marea corrupto y llévalas a la caja mecánica 413 para que las analice.‡Recoge 4 muestras de carne de reptador de marea corrupto y llévalas a la caja mecánica 413 para que las analice.‡Récupérez 4 échantillons de Chair de clampant des marées corrompu et amenez-les à la Bigobox 413 pour analyse.‡收集4块堕落潮行蟹的肉片，把它们放到传声盒413号里去分析。‡收集4份腐化潮行蟹的肉樣本並帶去傳聲盒413號進行檢驗。',
  }
},
[13522] = {
  {
    'A ameaça das águas‡Угроза из воды‡Gefahr aus dem Wasser‡물 정령의 위협‡Amenaza acuífera‡Amenaza acuífera‡Une menace venue des eaux‡水的威胁‡水的威脅',
    nil,
    'Mate 8 Espirros Torpes.‡Убейте 8 коварных потоков.‡Tötet 8 widerwärtige Gischte.‡사악한 물보라 정령 8마리를 처치해야 합니다.‡Mata a 8 rocíos viles.‡Mata a 8 rocíos viles.‡Tuez 8 Projections viles.‡杀死8只邪恶喷涌者。‡殺死8個邪惡的浪花。',
  }
},
[13523] = {
  {
    'Controle sobre as marés‡Власть над приливами‡Macht über die Gezeiten‡파도를 잠재워라‡Poder sobre las olas‡Poder sobre las olas‡Un pouvoir sur les marées‡控潮之力‡逆抗潮水',
    nil,
    'Use o Orbe de Eluna nos restos de 6 Espíritos Enfurecidos da Maré.‡Прикоснитесь Сферой Элуны к останкам 6 разъяренных духов волны.‡Wendet die Kugel von Elune an den Überresten von 6 wütenden Gezeitengeistern an.‡분노한 파도의 정령 6마리의 유해에 엘룬의 보주를 사용해야 합니다.‡Utiliza el orbe de Elune en los restos de 6 espíritus de mareas iracundos.‡Utiliza el orbe de Elune en los restos de 6 espíritus de mareas iracundos.‡Utilisez l\'Orbe d\'Élune sur la dépouille de 6 Esprits des marées enragés.‡对6个被激怒的潮汐之魂的残余使用艾露恩宝珠。‡將伊露恩寶珠用在6個怒潮之靈的殘骸上。',
  }
},
[13524] = {
  {
    '‡Побег из Среброречья‡Flucht aus Silberwasser‡은빛시내 마을 탈출‡Huye de Arroyoplata‡Huye de Arroyoplata‡L\'évasion de Ruissargent‡逃离银溪镇‡',
    nil,
    '‡Откройте деревянную клетку и помогите освобожденному разведчику Альянса сбежать из Среброречья. Доложитесь лейтенанту Думонту по прибытии в Приют Янтарной Сосны.‡Öffnet den hölzernen Käfig und helft dem befreiten Späher der Allianz, aus Silberwasser zu entkommen. Meldet Euch bei Leutnant Dumont, sobald Ihr die Ammertannhütte erreicht habt.‡나무 우리를 연 다음, 풀려난 얼라이언스 정찰병이 은빛시내 마을에서 탈출할 수 있도록 도와야 합니다. 호박빛소나무 오두막에 도착하면 부관 듀몬트에게 보고하십시오.‡Abre la jaula de madera y ayuda al explorador de la Alianza liberado a escapar de Arroyoplata. Cuando llegues al Refugio Pino Ámbar, informa al teniente Dumont.‡Abre la jaula de madera y ayuda al explorador de la Alianza liberado a escapar de Arroyoplata. Cuando llegues al Refugio Pino Ámbar, informa al teniente Dumont.‡Ouvrez la Cage en bois et aidez l\'Éclaireur de l\'Alliance libéré à s\'échapper de Ruissargent. Présentez-vous au Lieutenant Dumont quand vous aurez atteint le Gîte Ambrepin.‡打开木笼，帮助联盟斥候逃出银溪镇。抵达琥珀松木营地后向杜蒙特中尉汇报情况。‡',
  }
},
[13525] = {
  {
    'O que está acontecendo com os pelursos Bosquenero?‡Что случилось с фурболгами Чернолесья?‡Was ist mit den Furbolgs der Schwarzfelle los?‡검은나무 일족에게 무슨 일이?‡¿Qué ocurre con los fúrbolgs Bosque Negro?‡¿Qué ocurre con los fúrbolgs Bosque Negro?‡Qu\'arrive-t-il aux furbolgs Noirbois ?‡黑木熊怪怎么了？‡黑木熊怪出了什麼事?',
    nil,
    'Fale com o Ancião Brolg na Aldeia Bosquenero.‡Поговорите со старейшиной Бролгом в логове Чернолесья.‡Sprecht mit dem Ältesten Brolg in der Schwarzfellfeste.‡검은나무 요새에 있는 장로 브롤그와 대화해야 합니다.‡Habla con el anciano Brolg en el Fuerte del Bosque Negro.‡Habla con el anciano Brolg en el Fuerte del Bosque Negro.‡Parlez à l’Ancien Brolg, au Bastion des Noirbois.‡跟黑木要塞的熊怪长者谈一谈。‡和黑木要塞裡的長者布洛格說話。',
  }
},
[13526] = {
  {
    'Pata de urso‡Медвежья лапка‡Der Bärenklau‡곰발풀‡La pata de oso‡La pata de oso‡La patte d\'ours‡熊爪草‡熊掌草',
    nil,
    'Leve 8 caules de Pata de Urso ao Ancião Brolg na Aldeia Bosquenero.‡Принесите 8 пучков медвежьей лапы старейшине Бролгу в логово Чернолесья.‡Bringt 8 Stängel Bärenklau zum Ältesten Brolg in der Schwarzfellfeste.‡검은나무 요새에 있는 장로 브롤그에게 곰발풀 8줄기를 가져가야 합니다.‡Lleva 8 tallos de pata de oso al anciano Brolg al Fuerte del Bosque Negro.‡Lleva 8 tallos de pata de oso al anciano Brolg al Fuerte del Bosque Negro.‡L’Ancien Brolg, du Bastion des Noirbois, a besoin de 8 tiges de Pattes d’ours.‡给黑木要塞的熊怪长者带去8株熊爪草。‡帶回8株熊掌草回去黑木要塞給長者布洛格。',
  }
},
[13527] = {
  {
    'Gosto não se discute‡Никакого вкуса‡Über Geschmack lässt sich nicht streiten‡알 수 없는 존재의 먹이‡Una cata repugnante‡Una cata repugnante‡Les questions de goût, ça ne se discute pas…‡食性无常‡人各有所好',
    nil,
    'Colete uma amostra de carcaça de urso em decomposição a leste da Caixazorra 413.‡Принесите образец разложившейся медвежьей плоти на восток к Жужжалке 413.‡Erhaltet die Probe eines faulenden Bärenkadavers östlich von Dröhnkiste 413.‡윙윙상자 413의 동쪽에서 썩어가는 곰 시체를 찾아 견본을 입수해야 합니다.‡Recoge una muestra de un cadáver de oso en descomposición al este de la caja mecánica 413.‡Recoge una muestra de un cadáver de oso en descomposición al este de la caja mecánica 413.‡Cherchez une carcasse d\'ours à l\'est de la Bigobox 413 et rapportez-en un échantillon.‡从传声盒413号东边的腐烂的熊尸上获取一份样本。‡從傳聲盒413號東邊的一具腐爛熊屍身上取得樣本。',
  }
},
[13528] = {
  {
    'Caixazorra 723‡Жужжалка 723‡Dröhnkiste 723‡윙윙상자 723‡La caja mecánica 723‡La caja mecánica 723‡Bigobox 723‡传声盒723号‡傳聲盒723號',
    nil,
    'Colete 6 amostras de Entranhas de Ursocardo Corrompido e leve-as à Caixazorra 723 para análise.‡Соберите 6 образцов внутренностей зараженных колючешерстных медведей и принесите их к Жужжалке 723 для анализа.‡Sammelt 6 Proben verderbte Eingeweide eines Distelbären und bringt sie zu Dröhnkiste 723 für eine Analyse.‡로르다넬에 있는 위즈뱅 크랭크토글이 타락한 엉겅퀴곰 내장 6개를 구한 다음, 분석할 수 있도록 윙윙상자 723으로 운반해 달라고 했습니다.‡Recoge 6 muestras de tripas de oso cardo corrupto y llévalas a la caja mecánica 723 para que las analice.‡Recoge 6 muestras de tripas de oso cardo corrupto y llévalas a la caja mecánica 723 para que las analice.‡Rassemblez 6 échantillons de Tripes d’ours des chardons corrompus, et rapportez-les à la Bigobox 723 pour analyse.‡收集6份堕落蓟熊的精华，把它们放到传声盒723号里去分析。‡收集6份腐化薊熊的內臟樣本並帶去傳聲盒723號進行檢驗。',
  }
},
[13529] = {
  {
    'A raiz da corrupção‡Источник разложения‡Der Ursprung der Verderbnis‡타락의 근원‡La fuente de la corrupción‡La fuente de la corrupción‡La source de la corruption‡腐化的源头‡腐化的源頭',
    nil,
    'Mate Zenn Cascovil e 8 Capetas Torpes no Antro de Fontescarpa.‡Убейте Зенна Грязное Копыто и 8 коварных греллей в Скалистой пещере.‡Tötet Zenn Faulhuf und 8 üble Grells in der Klippenquellgrotte.‡폭포수 동굴에 있는 젠 파울후프와 비열한 그렐 8마리를 처치해야 합니다.‡Mata a Zenn Nauseapezuña y a 8 grells viles en la Cuenca Fonroca.‡Mata a Zenn Nauseapezuña y a 8 grells viles en la Cuenca Fonroca.‡Tuez Zenn Vilsabot et 8 Grells maléfiques au Val de la Bondissante.‡杀掉峭泉洞的赛恩·腐蹄和8名邪劣魔。‡在壁泉瀑布殺死賽恩‧腐蹄和8名邪惡劣魔。',
  }
},
[13537] = {
  {
    'Desejo de garoupa‡Любовь к окуням‡Lust auf Barsch‡맛있는 농어‡Sabor a mero‡Sabor a mero‡Une envie de mérou‡尝尝石斑鱼‡石斑滋味',
    nil,
    'Use suas habilidades de pesca para obter 4 Garoupas da Costa Negra.‡С помощью навыка рыбной ловли поймайте 4 морских окуня Темных берегов.‡Benutzt Eure Angelfertigkeit, um 4 Dunkelküstenbarsche zu erhalten.‡낚시 기술을 이용하여 어둠해안 농어 4마리를 잡아야 합니다.‡Usa tu habilidad para la pesca para obtener 4 meros de Costa Oscura.‡Usa tu habilidad para la pesca para obtener 4 meros de Costa Oscura.‡Utilisez vos compétences en pêche pour obtenir 4 Mérous de Sombrivage.‡使用技能钓4黑海岸石斑鱼。‡使用你的釣魚技巧取得4條黑海岸石斑魚。',
  }
},
[13538] = {
  {
    'Sabotagem ao sul‡Южный саботаж‡Sabotage aus dem Süden‡남쪽의 방해 공작‡Sabotaje al sur‡Sabotaje al sur‡Sabotage au sud‡南部的塔楼‡南方破壞工作',
    nil,
    'Destrua o Mirante Negro, a Torre da Guarda Ígnea ou a Torre da Borda Invernal e fale novamente com o Oficial Tático Ahbramis em Invérnia.‡Уничтожьте башню Темного Взора, башню Огненного Дозора или башню Клинка Зимы, а затем вернитесь к офицеру-стратегу Абрамису на Озере Ледяных Оков.‡Zerstört den Schattenblickturm, den Flammenaugenturm oder den Wintersturzturm und kehrt zu Taktikoffizier Ahbramis in Tausendwinter zurück.‡그늘눈 경비탑이나 불꽃감시 경비탑 또는 겨울 칼날 경비탑을 파괴한 후 겨울손아귀에 있는 전술장교 아브라미스에게 가야 합니다.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Ahbramis en Conquista del Invierno.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Ahbramis en Conquista del Invierno.‡Détruisez la Tour d\'Ombrevue, la Tour Guetteflamme ou la Tour Bornehiver, puis retournez voir l\'Officier tactique Ahbramis à Joug-d\'hiver.‡摧毁影目塔楼、火光塔楼或冬缘塔楼，然后向冬拥湖的参谋官安布拉米斯复命。‡摧毀影景哨塔、焰望哨塔或冬際哨塔，然後向冬握湖的戰術軍官阿布拉米斯回報。',
  }
},
[13539] = {
  {
    'A derrubada das torres‡Свержение башен‡Einstürzende Turmbauten‡경비탑 무너뜨리기‡Derribar las torres‡Derribar las torres‡Abattre les tours‡摧毁塔楼‡推倒哨塔',
    nil,
    'Destrua o Mirante Negro, a Torre da Guarda Ígnea ou a Torre da Borda Invernal e fale novamente com o Oficial Tático Kilrath em Invérnia.‡Уничтожьте башню Темного Взора, башню Огненного Дозора или башню Клинка Зимы, затем вернитесь к офицеру-стратегу Килрату.‡Zerstört den Schattenblickturm, den Flammenaugenturm oder den Wintersturzturm und kehrt zu Taktikoffizier Kilrath in Tausendwinter zurück.‡그늘눈 경비탑이나 불꽃감시 경비탑 또는 겨울 칼날 경비탑을 파괴한 후 겨울손아귀에 있는 전술장교 킬라스에게 가야 합니다.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Kilrath en Conquista del Invierno.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Kilrath en Conquista del Invierno.‡Détruisez la Tour d\'Ombrevue, la Tour Guetteflamme ou la Tour Bornehiver, puis retournez voir l\'Officier tactique Kilrath à Joug-d\'hiver.‡摧毁影目塔楼、火光塔楼或冬缘塔楼，然后向冬拥湖的参谋官基尔拉斯复命。‡摧毀影景哨塔、焰望哨塔或冬際哨塔，然後向冬握湖的戰術軍官科伊瑞斯回報。',
  }
},
[13542] = {
  {
    'Contra o vento‡Против ветра‡Gegen den Wind‡바람에 맞서다‡A contraviento‡A contraviento‡Contre le vent‡对抗暴风‡與風對抗',
    nil,
    'Use o poço lunar, nas Ruínas de Auberdine, para destruir 8 pares de Braçadeiras de Ciclone Frenético.‡Воспользуйтесь лунным колодцем в руинах Аубердина, чтобы уничтожить 8 наручей бесноватого циклона.‡Benutzt den Mondbrunnen in den Ruinen von Auberdine, um 8 Armschienen des rasenden Zyklons zu zerstören.‡아우버다인 폐허에 있는 달샘을 이용하여 광포한 회오리 팔보호구 8개를 파괴해야 합니다.‡Utiliza la Poza de la Luna de las Ruinas de Auberdine para destruir 8 conjuntos de brazales de ciclón demenciado.‡Utiliza la Poza de la Luna de las Ruinas de Auberdine para destruir 8 conjuntos de brazales de ciclón demenciado.‡Utilisez le Puits de lune des Ruines d\'Auberdine pour détruire 8 jeux de Brassards de cyclone frénétique.‡使用奥伯丁废墟里的月亮井，摧毁8副狂暴飓风的护腕。‡使用奧伯丁廢墟的月井摧毀8套狂亂颶風護腕。',
  }
},
[13543] = {
  {
    'Martelos são para quebrar‡Три молота‡Drei Hammer zu Brechen...‡망치단의 일원 처단‡Los tres cultores Crepusculares‡Los tres cultores Crepusculares‡Trois marteaux à briser‡三柄将碎之锤‡破錘',
    nil,
    'Mate Domanimbus Juba Agreste, o Mestre-ventos Tzu-tzu e o Senhor Celeste Braax.‡Убейте подругу облаков Буйногривую, повелителя ветров Цу-Цу и повелителя небес Браакса.‡Tötet Wolkenzähmerin Wildmähne, Windmeister Tzu-Tzu und Himmelsfürst Braax.‡구름조련사 와일드메인, 바람기수 추추, 하늘군주 브라악스를 처치해야 합니다.‡Mata a Domanubes Ferocrín, al Maestro del Viento Tzu-Tzu y al Señor del Cielo Braax.‡Mata a Domanubes Ferocrín, al Maestro del Viento Tzu-Tzu y al Señor del Cielo Braax.‡Tuez la Dompteuse de nuages Crin-sauvage, le Maître du vent Tzu-Tzu et le Seigneur du ciel Braax.‡杀死克劳坦莫·蛮鬃、御气大师祖祖和啸天者布纳克斯。‡殺死馴雲者蠻鬃、御風者楚祖和傲天者布拉克斯。',
  }
},
[13544] = {
  {
    'A bênção do urso‡Благословение медведя‡Der Bärensegen‡곰의 축복‡La bendición del oso‡La bendición del oso‡La bénédiction de l\'ours‡熊的祝福‡熊之祝福',
    nil,
    'O Ancião Brolg, na Aldeia Bosquenero, quer que você lhe entregue o Ramalhete Abençoado.‡Старейшина Бролг из логова Чернолесья попросил вас принести ему пучок благословенных трав.‡Bringt das gesegnete Kräuterbündel zum Ältesten Brolg in Schwarzfellfeste.‡검은나무 요새에 있는 장로 브롤그가 축복받은 약초 묶음을 가져오라고 했습니다.‡El anciano Brolg del Fuerte del Bosque Negro quiere que le lleves el fardo de hierbas benditas.‡El anciano Brolg del Fuerte del Bosque Negro quiere que le lleves el fardo de hierbas benditas.‡L’Ancien Brolg, du Bastion des Noirbois, veut que vous lui rameniez le Paquet d’herbes bénies.‡把受祝福的草药包带给黑木要塞的熊怪长者。‡黑木要塞的長者布洛格要你帶一捆受祝福的草藥給他。',
  }
},
[13545] = {
  {
    'A purificação dos aflitos‡Очищение оскверненных‡Die Befallenen reinigen‡정화된 형제들‡Purificando a los afectados‡Purificando a los afectados‡Purifier les souffrants‡净化感染者‡將苦楚淨化',
    nil,
    'O ancião Brolg quer que você use o Ramalhete Abençoado para purificar 7 Pelursos da Aldeia Bosquenero e mate os Espíritos da Corrupção que os estão enlouquecendo.‡Старейшина Бролг просит вас воспользоваться пучком благословенных трав, чтобы очистить 7 фурболгов Чернолесья, после чего убейте духов осквернения, сводивших их с ума.‡Der Älteste Brolg möchte, dass Ihr das gesegnete Kräuterbündel benutzt, um 7 Furbolgs der Schwarzfellfeste zu läutern und die Geister der Verderbnis, die sie in den Wahnsinn treiben, tötet.‡장로 브롤그가 축복받은 약초 묶음을 사용하여 검은나무요새 펄볼그 7마리를 정화하고 그들을 광기에 빠뜨린 타락의 영혼을 제거해달라고 했습니다.‡El anciano Brolg quiere que utilices el fardo de hierbas benditas para purificar a 7 fúrbolgs del Fuerte del Bosque Negro y mates a los espíritus de corrupción que les hicieron enloquecer.‡El anciano Brolg quiere que utilices el fardo de hierbas benditas para purificar a 7 fúrbolgs del Fuerte del Bosque Negro y mates a los espíritus de corrupción que les hicieron enloquecer.‡L’Ancien Brolg veut que vous utilisiez le Paquet d’herbes bénies pour purifier 7 furbolgs du Bastion des Noirbois et que vous tuiez les Esprits de corruption qui leur ont fait perdre la raison.‡熊怪长者要你用受祝福的草药包净化7名黑木要塞的熊怪，并杀掉令他们发狂的污染之魂。‡長者布洛格要你使用一捆受祝福的草藥，淨化7個在黑木要塞的熊怪，並殺死讓他們陷入瘋狂的腐化之靈。',
  }
},
[13546] = {
  {
    'O profanador‡Осквернитель‡Der Schänder‡파멸자‡El Rapiñador‡El Rapiñador‡Le Souilleur‡污染者‡污染者',
    nil,
    'O Ancião Brolg, na Aldeia Bosquenero, quer que você mate Zarax, o Profanador.‡Старейшина Бролг из логова Чернолесья просит вас убить Шаракса Осквернителя.‡Der Älteste Brolg in der Schwarzfellfeste möchte, dass Ihr Sharax den Schänder tötet.‡검은나무 요새에 있는 장로 브롤그가 파멸자 샤락스를 처치해 달라고 했습니다.‡El anciano Brolg en el Fuerte del Bosque Negro quiere que mates a Sharax el Rapiñador.‡El anciano Brolg en el Fuerte del Bosque Negro quiere que mates a Sharax el Rapiñador.‡L’Ancien Brolg, du Bastion des Noirbois, veut que vous tuiez Sharax le Souilleur.‡黑木要塞的熊怪长者要你去击败污染者萨纳克斯。‡黑木要塞的長者布洛格要你殺死『污染者』夏拉克斯。',
  }
},
[13547] = {
  {
    'A travessia dos espíritos‡Отделение душ‡Die Geister locken‡영혼을 위한 노래‡Sonsacando a los espíritus‡Sonsacando a los espíritus‡Amadouer les esprits‡说服灵魂‡誘導魂靈',
    nil,
    'Atraia os espíritos de Trovejius Tecevento, Elissa Brisastral, Taldan e Caylais Plumaluna para fora de seus corpos.‡Отделите души Тандриса Ветропряда, Элиссы Звездный Ветер, Тальдана и Кайлаис Лунное Перо.‡Lockt die Geister von Thundris Windwirker, Elissa Sternenhauch, Taldan und Caylais Mondfeder.‡툰드리스 윈드위버와 엘리자 스타브리즈, 탈단, 케이레이 문페더의 영혼을 달래야 합니다.‡Sonsaca a los espíritus de Thundris Tejevientos, Elissa Brisa Estelar, Taldan y Caylais Plumalunar.‡Sonsaca a los espíritus de Thundris Tejevientos, Elissa Brisa Estelar, Taldan y Caylais Plumalunar.‡Amadouez les esprits de Thundris Tissevent, Elissa Brise-Stellaire, Taldan et Caylais Plumelune.‡说服桑迪斯·织风、艾莉萨·星风、塔尔丹以及凯莱斯·月羽的灵魂。‡誘導桑迪斯·織風、艾麗莎·星風、塔爾丹和凱萊絲·月羽的魂靈。',
  }
},
[13548] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Un seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[13549] = {
  {
    'Caudas para cima!‡Хвост трубой‡Männchen oder Weibchen?‡꼬리를 들춰라‡Arriba la cola‡Arriba la cola‡Haut les queues !‡拎尾巴‡驗明正身',
    nil,
    'O Cronista To\'kini, em Zim\'Torga, quer que você use a Zarabatana de To\'kini nos Leopardos Glaciais e nos Ursos Pata de Gelo. Retorne com 3 fêmeas de cada.‡По просьбе летописца То\'кини из Зим\'Торги усыпляйте из воздушного ружья То\'кини северных леопардов и ледолапых медведей. Возвращайтесь к нему, поймав по три самки каждого вида.‡Chronist To\'kini in Zim\'Torga möchte, dass Ihr mit To\'kinis Blasrohr Frostleoparden und Eispfotenbären einschläfert. Kehrt mit jeweils 3 Weibchen zu ihm zurück.‡짐토르가에 있는 기록가 토키니가 서리 표범과 얼음발 곰에게 토키니의 바람총을 사용해 암컷을 3마리씩 구해 돌아와 달라고 했습니다.‡El cronista To\'kini en Zim\'Torga quiere que utilices la cerbatana de To\'kini sobre leopardos de escarcha y osos Patahielo. Vuelve con tres hembras de cada especie.‡El cronista To\'kini en Zim\'Torga quiere que utilices la cerbatana de To\'kini sobre leopardos de escarcha y osos Patahielo. Vuelve con tres hembras de cada especie.‡Le Chroniqueur To\'kini, à Zim\'Torga, vous demande d\'utiliser la Sarbacane de To\'kini sur des Léopards de givre et des Ours Patteglace. Retournez le voir quand vous aurez 3 Femelles de chaque.‡希姆托加的记载者图基尼希望你对冰霜豹和冰爪熊使用麻醉飞镖，并给他带回三头雌性冰霜豹和三头雌性冰爪熊。‡辛托加的撰史者托基尼要你對霜豹和冰掌熊使用托基尼的吹箭。把兩種雌獸各3隻帶回來給他。',
  }
},
[13554] = {
  {
    'Uma cura no escuro‡Излечение во тьме‡Heilung im Dunkeln‡어둠 속의 빛‡Una cura en la oscuridad‡Una cura en la oscuridad‡Un remède dans l\'obscurité‡黑暗中的解药‡黑暗中的解藥',
    nil,
    'Consiga 6 Amostras de Linfa Podre das criaturas do Antro de Fontescarpa.‡Добудьте 6 образцов зараженной лимфы существ из Скалистой пещеры.‡Erhaltet 6 Proben widerlicher Schleim von den Kreaturen in der Klippenquellgrotte.‡폭포수 동굴 안에 있는 생물들에게서 부정의 영액 6개를 회수해야 합니다.‡Consigue 6 muestras de icor hediondo de las criaturas que habitan la Cuenca Fonroca.‡Consigue 6 muestras de icor hediondo de las criaturas que habitan la Cuenca Fonroca.‡Récupérez 6 échantillons d\'Ichor infect sur des créatures du Val de la Bondissante.‡从峭泉洞的生物身上收集6份脏污的液体样本。‡從壁泉谷地裡的生物取回6個腐敗膿液樣本。',
  }
},
[13556] = {
  {
    'Ovos para Dubra\'Jin‡Яйца для Дубра\'джина‡Eier für Dubra\'Jin‡두브라진은 알을 좋아해‡Huevos para Dubra\'Jin‡Huevos para Dubra\'Jin‡Des œufs pour Dubra\'Jin‡杜布拉金需要迅猛龙卵‡杜布拉金的蛋',
    nil,
    'Ha\'wana, em Dubra\'Jin, precisa que você colete 12 Ovos de Raptor de Gundrak.‡Соберите 12 яиц ящера Гундрака по заданию Га\'ваны из Дубра\'джина.‡Ha\'wana in Dubra\'Jin möchte, dass Ihr 12 Raptoreier von Gundrak sammelt.‡두브라진에 있는 하와나가 군드락 랩터 알 12개를 모아 달라고 했습니다.‡Ha\'wana en Dubra\'Jin necesita que recojas 12 huevos de raptor de Gundrak.‡Ha\'wana en Dubra\'Jin necesita que recojas 12 huevos de raptor de Gundrak.‡Ha\'wana, à Dubra\'Jin, vous demande de trouver 12 Œufs de raptor de Gundrak.‡杜布拉金的哈瓦纳希望你去收集12枚古达克迅猛龙卵。‡杜布拉金的哈瓦那要你收集12個剛德拉克迅猛龍蛋。',
  }
},
[13557] = {
  {
    'O arauto da boa sorte‡Неожиданная удача‡Der Wächter des Glücks‡행운의 전도사‡Portar la buena suerte‡Portar la buena suerte‡Le porte-chance‡幸运儿‡幸運使者',
    nil,
    'Liberte um total de 8 Ursocardos e Ratumbros Incorruptos aprisionados no Antro de Fontescarpa.‡Освободите 8 незараженных колючешерстных медведей или незараженных сумеречников из клеток в Скалистой пещере.‡Befreit 8 unverderbte Distelbären oder unverderbte Nachtratten aus den Käfigen in der Klippenquellgrotte.‡폭포수 동굴에서 타락하지 않은 엉겅퀴곰이나 그늘쥐 8마리를 풀어줘야 합니다.‡Libera a 8 osos cardos o ratardeceres incorruptos de las jaulas de la Cuenca Fonroca.‡Libera a 8 osos cardos o ratardeceres incorruptos de las jaulas de la Cuenca Fonroca.‡Libérez 8 Ours des chardons non corrompus ou Rats de la pénombre non corrompus des cages du Val de la Bondissante.‡释放被关在峭泉洞捕兽笼里的8头未堕落的蓟熊或未堕落的暮色鼠。‡在壁泉瀑布從籠子裡解放合計8隻的未腐化的薊熊或未腐化的夜行鼠。',
  }
},
[13558] = {
  {
    'Evoque o trovão‡Призывая гром‡Donner herbeirufen‡폭풍을 부르는 자‡Invocar al trueno‡Invocar al trueno‡L\'appel du tonnerre‡降雷之术‡喚雷',
    nil,
    'Use o Orbe Ritualístico de Etérion e obtenha a Essência de Etérion.‡Воспользуйтесь ритуальной сферой Эфериона, чтобы добыть сущность Эфериона.‡Benutzt Aetherions Ritualkugel und erhaltet Aetherions Essenz.‡애테리온의 의식용 보주를 사용한 다음 애테리온의 정수를 획득해야 합니다.‡Utiliza el orbe de ritual de Aetherion y consigue la esencia de Aetherion.‡Utiliza el orbe de ritual de Aetherion y consigue la esencia de Aetherion.‡Utilisez l\'Orbe rituel d\'Aetherion et récupérez l\'Essence d\'Aetherion.‡用阿瑟里恩的仪式宝珠来获得阿瑟里恩的精华。‡使用伊瑟里奧儀式寶珠取得伊瑟里奧的精華。',
  }
},
[13559] = {
  {
    'Tributo a Hodir‡Подношение Ходиру‡Hodirs Tribut‡호디르께 공물을‡El tributo de Hodir‡El tributo de Hodir‡Un tribut à Hodir‡霍迪尔的供品‡霍迪爾的祭禮',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[13560] = {
  {
    'Um oceano não tão profundo‡Океан не столь глубок‡Der nicht so tiefe Ozean‡얕은 바다‡Un océano poco profundo‡Un océano poco profundo‡Un océan pas si profond‡不那么深的海洋‡不這麼深的大海',
    nil,
    'Gorbold Manácero, em Lor\'danel, quer que você fale com Gary para receber novas instruções.‡Горбольд Сталерук из Лор\'данела просит вас поговорить с Гари и получить у него дальнейшие указания.‡Gorbold Stahlhand möchte, dass Ihr Gary aufsucht, um weitere Anweisungen zu erhalten.‡로르다넬에 있는 골볼트 스틸핸드가 게리를 만나 지시를 받으라고 했습니다.‡Gorbold Mano de Acero de Lor\'danel quiere que hables con Gary para recibir más instrucciones.‡Gorbold Mano de Acero de Lor\'danel quiere que hables con Gary para recibir más instrucciones.‡Gorbold Main-d\'acier à Lor\'danel vous a demandé de parler à Gary pour obtenir de nouvelles instructions.‡洛达内尔的高尔博德·钢手要你去找盖瑞接受进一步指示。‡洛丹諾的高爾博多·鋼手希望你和葛瑞談話以取得進一步指示。',
  }
},
[13561] = {
  {
    'O conforto dos Altaneiros‡Утешение для высокорожденного‡Trost für die Hochgeborenen‡명가의 위안‡Consuelo para los Altonato‡Consuelo para los Altonato‡Du réconfort pour les Bien-nés‡安抚上层精灵‡撫慰精靈貴族',
    nil,
    'Mate 6 Altaneiras Amaldiçoadas e 6 Altaneiros Contorcidos.‡Убейте 6 проклятых высокорожденных и 6 терзаемых высокорожденных.‡Tötet 6 verfluchte Hochgeborene und 6 zuckende Hochgeborene.‡저주받은 명가의 원혼 6마리와 고뇌하는 명가의 원혼 6마리를 처치해야 합니다.‡Mata a 6 Altonato malditos y a 6 Altonato en pena.‡Mata a 6 Altonato malditos y a 6 Altonato en pena.‡Tuez 6 Bien-nées maudites et 6 Bien-nés frémissants.‡杀死6名被诅咒的上层精灵和6名痛苦的上层精灵。‡殺死6名被詛咒的精靈貴族和6名悲苦的精靈貴族。',
  }
},
[13562] = {
  {
    'A última chama de Bashal\'Aran‡Последние огни Башал\'Арана‡Die letzte Flamme von Bashal\'Aran‡바샬아란의 마지막 불꽃‡La Llama Final de Bashal\'Aran‡La Llama Final de Bashal\'Aran‡La dernière flamme de Bashal\'Aran‡巴莎兰的终焉之焰‡巴莎蘭的最終烈焰',
    nil,
    'Extingua a Última Chama de Bashal\'Aran.‡Погасите последний огонь Башал\'Арана.‡Löscht die letzte Flamme von Bashal\'Aran aus.‡바샬아란의 마지막 불꽃을 꺼야 합니다.‡Extingue la Llama Final de Bashal\'Aran.‡Extingue la Llama Final de Bashal\'Aran.‡Éteignez la Dernière flamme de Bashal\'Aran.‡熄灭巴莎兰的终焉之焰。‡撲滅巴莎蘭的最終烈焰。',
  }
},
[13563] = {
  {
    'Amor eterno‡Вечная любовь‡Ewige Liebe‡사랑은 영원히‡Amor eterno‡Amor eterno‡Un amour éternel‡爱别离‡永誌不渝',
    nil,
    'Liberte o espírito de Anaya Correalba e pegue seu pingente.‡Освободите душу Анайи Вестницы Зари и добудьте ее подвеску.‡Befreit den Geist von Anaya Dämmerflucht und erhaltet ihren Anhänger.‡아나야 돈러너의 영혼을 해방시키고 그녀의 펜던트를 회수해야 합니다.‡Libera el espíritu de Anaia Correalba y consigue su colgante.‡Libera el espíritu de Anaia Correalba y consigue su colgante.‡Libérez l\'esprit d\'Anaya Coursaurore et rapportez son pendentif.‡解放安娜雅·晨行者的灵魂，获取她的坠饰。‡解放安娜雅‧曦奔之靈並取得她的墜飾。',
  }
},
[13564] = {
  {
    'Companheiro perdido‡Пропавший спутник‡Ein verlorener Freund‡실종된 친구‡El compañero perdido‡El compañero perdido‡Un compagnon perdu‡失踪的伙伴‡失蹤的伴侶',
    nil,
    'Encontre Garratroz.‡Найдите Лютого Когтя.‡Findet Grimmklaue.‡잔혹발톱을 찾아야 합니다.‡Localiza a Zarpadura.‡Localiza a Zarpadura.‡Retrouvez Griffe-sinistre.‡找到锐爪。‡找到銳爪。',
  }
},
[13565] = {
  {
    'Duplamente expulsas‡Уничтожить дважды‡Zweiten Grades‡신중함의 교훈‡Eliminar por segunda vez‡Eliminar por segunda vez‡De lointains cousins‡今非昔比‡二度被移除',
    nil,
    'Use a Raiz Petrificada para erguer 6 Arvorosos Murchos e despache a líder naga, a Lady Najaína.‡Воспользуйтесь окаменелым корнем, чтобы поднять из небытия 6 иссхоших энтов, и убейте предводительницу наг Леди Жаниру.‡Benutzt die versteinerte Wurzel, ruft 6 siechende Ents und entledigt Euch Lady Janiras, der Anführerin der Naga.‡단단한 뿌리를 사용하여 말라버린 나무정령 6마리를 소환하고 나가들의 우두머리인 여군주 자니라를 처치해야 합니다.‡Utiliza la raíz petrificada para resucitar a 6 ents marchitos y matar a Lady Janira, la líder naga.‡Utiliza la raíz petrificada para resucitar a 6 ents marchitos y matar a Lady Janira, la líder naga.‡Utilisez la Racine pétrifiée pour lever 6 Ents flétris et tuer le chef naga, Dame Janira.‡石化之根召唤6名枯萎的树人，剿除纳迦首领简妮拉女士。‡使用石化根召喚出6個枯萎的樹靈，並殺死納迦領袖賈妮拉女士。',
  }
},
[13566] = {
  {
    'Um ritual cabeludo‡Ингредиенты для ритуала‡Materialien für das Ritual‡의식을 위한 재료‡Materiales de ritual‡Materiales de ritual‡Des matériaux pour le rituel‡仪式的材料‡儀式的材料',
    nil,
    'Consiga 3 pelos de Bigode de Espreitaluna, 3 Tufos de Crina de Corça Mosqueada e 3 tufos de Pele de Ursocardo.‡Добудьте 3 уса лунопарда, 3 клочка шерсти пятнистой оленихи и 3 клочка меха колючешерстного медведя.‡Besorgt 3 Schnurrhaare eines Mondpirschers, 3 Büschel gefleckter Rehhaare und 3 Proben Distelbärenfell.‡달표범 수염 3개와 점박이 암사슴 털뭉치 3개, 엉겅퀴곰 모피 3장을 구해야 합니다.‡Consigue 3 bigotes de Acechalunas, 3 mechones de pelo de cierva jaspeada y 3 pelajes de oso cardo.‡Consigue 3 bigotes de Acechalunas, 3 mechones de pelo de cierva jaspeada y 3 pelajes de oso cardo.‡Récupérez 3 Moustaches de traquelune, 3 Touffes de poils de biche tachetée et 3 Fourrures d\'ours des chardons.‡收集3根月夜猛虎之须、3把杂斑母鹿毛以及3块蓟熊毛皮。‡取得3根月巡虎的鬍鬚、3把雜斑雌鹿毛和3張薊熊毛皮。',
  }
},
[13567] = {
  {
    'O espírito do cervo‡Дух оленя‡Der Geist des Hirsches‡수사슴의 영‡El espíritu del venado‡El espíritu del venado‡L\'esprit du cerf‡雄鹿巨灵‡雄鹿之靈',
    nil,
    'O Guardião Karithus o ensinou a receber a bênção do Grande Espírito Cervo.‡Хранитель Каритий велел вам получить благословение великого духа оленя.‡Bewahrer Karithus hat Euch angewiesen, den Segen des großen Hirschgeists einzuholen.‡수호자 카리투스의 말에 따라 거대한 수사슴의 영으로부터 축복을 받아야 합니다.‡El vigilante Karithus te ha indicado cómo recibir la bendición del gran espíritu del venado.‡El vigilante Karithus te ha indicado cómo recibir la bendición del gran espíritu del venado.‡Le Gardien Karithus vous a demandé de recevoir la bénédiction du Grand esprit cerf.‡守护者卡里修斯吩咐你接受雄鹿巨灵的祝福。‡守衛者卡利蘇斯已指示你如何受到偉大雄鹿之靈的祝福。',
  }
},
[13568] = {
  {
    'O espírito do espreitaluna‡Дух лунопарда‡Der Geist des Mondpirschers‡달표범의 영‡El espíritu Acechalunas‡El espíritu Acechalunas‡L\'esprit du traquelune‡月夜猛虎巨灵‡月巡虎之靈',
    nil,
    'O Guardião Karithus o ensinou a receber a bênção do Grande Espírito Espreitaluna.‡Хранитель Каритий велел вам получить благословение великого духа лунопарда.‡Bewahrer Karithus hat Euch angewiesen, den Segen des großen Mondpirschergeists einzuholen.‡수호자 카리투스의 말에 따라 거대한 달표범의 영으로부터 축복을 받아야 합니다.‡El vigilante Karithus te ha indicado cómo recibir la bendición del gran espíritu Acechalunas.‡El vigilante Karithus te ha indicado cómo recibir la bendición del gran espíritu Acechalunas.‡Le Gardien Karithus vous a demandé de recevoir la bénédiction du Grand esprit traquelune.‡守护者卡里修斯吩咐你接受月夜猛虎巨灵的祝福。‡守衛者卡利蘇斯已指示你如何受到偉大月巡虎之靈的祝福。',
  }
},
[13569] = {
  {
    'O ritual de união‡Ритуальное грозовое облако‡Der Bund des Rituales‡교감의 의식‡El vínculo del ritual‡El vínculo del ritual‡Le lien rituel‡誓缚仪式‡結合儀式',
    nil,
    'Inale o incenso diante do guardião Karithus e escolha entre as bênçãos do Grande Espírito Cervo, do Grande Espírito Ursocardo ou do Grande Espírito Espreitaluna.|n|nMas lembre-se de que você poderá receber a bênção de apenas um espírito. Assim, faça uma escolha sábia.‡Вдохните эссенцию перед хранителем Каритием и примите благословение одного из великих духов: оленя, колючешерстного медведя или лунопарда.|n|nУчтите, что вы можете получить благословение только одного духа.‡Atmet den Weihrauch vor Bewahrer Karithus ein und trefft eine Entscheidung zwischen dem Segen des großen Hirschgeistes, des großen Distelbärgeistes und des großen Mondpirschergeistes.|n|nNur einer der Geister kann Euch seinen Segen erteilen, also wählt weise.‡수호자 카리투스 앞에 있는 향료를 들이마신 다음 거대한 수사슴의 영이나 거대한 엉겅퀴곰의 영, 거대한 달표범의 영 중 하나를 선택하여 축복을 받아야 합니다.|n|n축복은 한 가지만 받을 수 있으므로 신중하게 선택해야 합니다.‡Respira el incienso delante del vigilante Karithus y, después, elige la bendición del gran espíritu del venado, el gran espíritu del oso cardo o el gran espíritu Acechalunas.|n|nTen presente que solo podrás recibir la bendición de un espíritu, así que, elige sabiamente.‡Respira el incienso delante del vigilante Karithus y, después, elige la bendición del gran espíritu del venado, el gran espíritu del oso cardo o el gran espíritu Acechalunas.|n|nTen presente que solo podrás recibir la bendición de un espíritu, así que, elige sabiamente.‡Respirez l\'encens devant le gardien Karithus, puis choisissez la bénédiction du Grand esprit cerf, du Grand esprit ours des chardons ou du Grand esprit traquelune.|n|nSongez que vous ne pouvez recevoir la bénédiction que d\'un esprit à la fois, donc choisissez judicieusement.‡在守护者卡里修斯之前沐浴于焚香中，然后从雄鹿巨灵、蓟熊巨灵，以及月夜猛虎巨灵的祝福中选择其一。|n|n记住，你只可接受一位巨灵的祝福，因此请务必考虑周全。‡在守衛者卡利蘇斯身前沐浴在焚香的煙裡，然後選擇偉大雄鹿之靈、偉大薊熊之靈或是偉大月巡虎之靈的祝福。|n|n要記住，你只能獲得一種魂靈的祝福，所以好好選擇。',
  }
},
[13570] = {
  {
    'A lembrança de Auberdine‡Воспоминания об Аубердине‡Zum Andenken an Auberdine‡아우버다인의 기억‡Recuerdos de Auberdine‡Recuerdos de Auberdine‡Souvenirs d\'Auberdine‡铭记奥伯丁‡紀念奧伯丁',
    nil,
    nil,
  }
},
[13571] = {
  {
    'A marvada‡Бюро находок Флетчера‡Fletchers Fundbüro‡주정뱅이 유실물 보관소‡Objetos perdidos de Flechero‡Objetos perdidos de Flechero‡Aux objets trouvés de Fletcher‡失而复得‡伏萊齊的失物招領',
    nil,
    nil,
  }
},
[13572] = {
  {
    'Os braseiros Flamejade‡Жаровни Нефритового Пламени‡Jadefeuerkohlenpfannen‡비취불꽃 화로‡Los blandones Fuego de Jade‡Los blandones Fuego de Jade‡Les braseros jadefeu‡碧火火盆‡碧火火盆',
    nil,
    'Gren Pelo Rasgado, na Aldeia Bosquenero, quer que você destrua 8 Braseiros Flamejade.‡Грен Деримех из логова Чернолесья просит вас уничтожить 8 жаровен Нефритового Пламени.‡Gren Fetzfell in der Schwarzfellfeste möchte, dass Ihr 8 Jadefeuerkohlenpfannen zerstört.‡검은나무 요새에 있는 그렌 토른퍼가 비취불꽃 화로 8개를 파괴해달라고 했습니다.‡Gren Pelajirón del Fuerte del Bosque Negro quiere que destruyas 8 blandones Fuego de Jade.‡Gren Pelajirón del Fuerte del Bosque Negro quiere que destruyas 8 blandones Fuego de Jade.‡Gren poil-semé, au Bastion des Noirbois, veut que vous détruisiez 8 Braseros jadefeu.‡黑木要塞的戈伦·裂皮要你去摧毁8个碧火火盆。‡黑木要塞的格蘭·裂皮要你摧毀8個碧火火盆。',
  }
},
[13573] = {
  {
    'O retorno de Malfurion‡Возвращение Малфуриона‡Malfurions Rückkehr‡말퓨리온의 귀환‡El retorno de Malfurion‡El retorno de Malfurion‡Le retour de Malfurion‡玛法里奥的回归‡瑪法里恩再臨',
    nil,
    'Procure Malfurion Tempesfúria no Olho do Vórtice, a sudeste do Acampamento de Refugiados, que fica na Costa Negra.‡Найдите Малфуриона Ярость Бури в Оке Урагана, что к юго-востоку от лагеря беженцев на Темных берегах.‡Sucht nach Malfurion Sturmgrimm beim Auge des Vortex südöstlich des Flüchtlingslagers in Dunkelküste.‡어둠해안 피난민 야영지 남동쪽에 있는 소용돌이의 눈에서 말퓨리온 스톰레이지를 찾아야 합니다.‡Busca a Malfurion Tempestira en El Ojo del Vórtice al sureste del Campamento de Refugiados de Costa Oscura.‡Busca a Malfurion Tempestira en El Ojo del Vórtice al sureste del Campamento de Refugiados de Costa Oscura.‡Cherchez Malfurion Hurlorage dans l\'Œil du Vortex, au sud-est du Camp de réfugiés, à Sombrivage.‡去找黑海岸难民营东南边漩涡之眼的玛法里奥·怒风‡到黑海岸難民營東南方的巨旋風之眼找瑪法里恩·怒風。',
  }
},
[13575] = {
  {
    'A terra corre no sangue‡Эта земля в их крови‡Das Land im Blut‡핏줄 속에 흐르는 대지‡La tierra está en su sangre‡La tierra está en su sangre‡Cette terre est dans leurs veines‡大地的血脉‡土地在他們血脈之中',
    nil,
    'Fale com o Ancião Pata Castanha na Aldeia Bosquenero, a sudoeste do Olho do Vórtice.‡Поговорите со старейшиной Карелапом в Лагере Чернолесья к юго-западу от Ока урагана.‡Sprecht mit dem Ältesten Braunpfote im Lager der Schwarzfelle südwestlich des Auges des Vortex.‡소용돌이의 눈 남서쪽의 검은나무 야영지에 있는 장로 브라운포와 대화해야 합니다.‡Habla con el anciano Zarpamarrón en el Campamento Bosque Negro al suroeste del Ojo del Vórtice.‡Habla con el anciano Zarpamarrón en el Campamento Bosque Negro al suroeste del Ojo del Vórtice.‡Parlez à l\'Ancien Brunepatte au Camp des Noirbois, au sud-ouest de l\'Œil du Vortex.‡跟漩涡之眼西南黑木营地的棕掌长者谈一谈。‡前往巨旋風之眼西南方的黑木營地與長者棕掌交談。',
  }
},
[13576] = {
  {
    'Ajuda mútua‡Взаимная помощь‡Gegenseitige Hilfe‡상부상조‡Ayuda mutua‡Ayuda mutua‡Assistance mutuelle‡互惠互助‡互相幫助',
    nil,
    'Use o Totem Reconfortante para absorver os restos de 8 Elementais do Fogo Livres.‡Воспользуйтесь успокаивающим тотемом, чтобы поглотить останки 8 вольных духов огня.‡Benutzt das besänftigende Totem, um die Überreste von 8 unbändigen Feuerelementaren zu absorbieren.‡위안의 토템을 사용하여 속박 풀린 불의 정령 8마리의 잔재를 흡수해야 합니다.‡Utiliza el tótem reconfortante para absorber los restos de 8 elementales de fuego desatados.‡Utiliza el tótem reconfortante para absorber los restos de 8 elementales de fuego desatados.‡Utilisez le Totem apaisant pour absorber les restes de 8 Élémentaires de feu déliés.‡使用抚慰图腾吸收8名肆掠的火元素的残余。‡使用舒和圖騰吸收8隻無縛的火元素殘骸。',
  }
},
[13577] = {
  {
    'O último dos coruscantes‡Последний совух‡Der letzte Wildekin‡마지막 올빼미야수‡Los últimos lechúcicos salvajes‡Los últimos lechúcicos salvajes‡Le dernier Indomptable‡最后的枭兽‡最後的梟獸',
    nil,
    'Fale com Aruum na Gruta Lunamarca, a norte do Olho do Vórtice.‡Поговорите с Арумом в Осененной луной берлоге к северу от Ока Урагана.‡Sprecht mit Aroom beim Mondbestrahlten Bau nördlich vom Auge des Vortex.‡소용돌이의 눈 북쪽에 있는 달빛마루 동굴에서 아룸을 만나 대화해야 합니다.‡Habla con Aroom en el Cubil Lunadón, al norte de El Ojo del Vórtice.‡Habla con Aroom en el Cubil Lunadón, al norte de El Ojo del Vórtice.‡Parlez à Aroom à la Tanière des Frôlelunes, au nord de l\'Œil du Vortex.‡跟漩涡之眼北方沐月兽穴的阿隆姆谈一谈。‡去巨旋風之眼北邊的月觸之穴與厄羅姆交談。',
  }
},
[13578] = {
  {
    'O adeus de Aruum‡Прощание с Аруном‡Arooms Abschied‡아룸의 작별 인사‡La despedida de Aroom‡La despedida de Aroom‡L\'adieu d\'Aroom‡阿隆姆的告别‡厄羅姆的道別',
    nil,
    'Obtenha 8 Penas de Coruscantes Massacrados.‡Добудьте 8 перьев убитых совухов.‡Erhaltet 8 Federn von getöteten Wildekin.‡죽은 올빼미야수 깃털 8개를 모아야 합니다.‡Consigue 8 plumas de lechúcico salvaje muerto.‡Consigue 8 plumas de lechúcico salvaje muerto.‡Obtenez 8 Plumes d\'indomptables tués.‡获得8根死去野枭兽的羽毛。‡取得8份死去梟獸的羽毛。',
  }
},
[13579] = {
  {
    'O protetor de Ameth\'Aran‡Защитник Амет\'Арана‡Der Beschützer von Ameth\'Aran‡아메스아란의 수호자‡El protector de Ameth\'Aran‡El protector de Ameth\'Aran‡Le protecteur d\'Ameth\'Aran‡亚米萨兰的保护者‡亞米薩蘭的守護者',
    nil,
    'Fale com Selenn nas Ruínas de Ameth\'Aran.‡Поговорите с Селенном на руинах Амет\'Арана.‡Sprecht mit Selenn in den Ruinen von Ameth\'Aran.‡아메스아란의 폐허에 있는 셀렌과 대화해야 합니다.‡Habla con Selenn en las Ruinas de Ameth\'Aran.‡Habla con Selenn en las Ruinas de Ameth\'Aran.‡Parlez à Selenn dans les Ruines d\'Ameth\'Aran.‡跟亚米萨兰废墟的瑟里恩谈一谈。‡和位於亞米薩蘭廢墟的賽連談談。',
  }
},
[13580] = {
  {
    'Elementais agitados‡Успокоение стихий‡Die Elemente beruhigen‡파도에 잦아드는 분노‡Sosegando a los elementos‡Sosegando a los elementos‡Apaiser les éléments‡安抚元素‡安撫元素',
    nil,
    'Finque o Totem Reconfortante Carregado no topo da costa rasgada, perto da margem flamejante, e proteja-o até o ritual ser concluído.‡Поместите заряженный успокаивающий тотем на вершину скалы рядом с Искристым берегом и защищайте его, пока ритуал не будет завершен.‡Platziert das aufgeladene Besänftigungstotem auf der Spitze des Gezackten Riffs am Lodernden Strand und beschützt es, bis das Ritual abgeschlossen ist.‡타오르는 해안 근처의 톱니 산호초 꼭대기로 충만한 위안의 토템을 가져간 다음, 위안의 의식이 끝날 때까지 토템을 보호해야 합니다.‡Coloca el tótem reconfortante cargado en la cima del arrecife que hay cerca de La Playa Llameante y protégelo hasta que se complete el ritual.‡Coloca el tótem reconfortante cargado en la cima del arrecife que hay cerca de La Playa Llameante y protégelo hasta que se complete el ritual.‡Placez le Totem apaisant énergisé au sommet du récif près de la grève Flamboyante et protégez-le jusqu’à ce que le Rituel d’apaisement soit terminé.‡将充能的安抚图腾放在炽热海岸附近的礁石顶部，保护它直到仪式结束。‡將充能的舒和圖騰放置在熾炎水岸附近的鋸齒暗礁頂端並且保護它直到儀式完成。',
  }
},
[13581] = {
  {
    'O juramento dos Bosquenero‡Дар Чернолесья‡Der Schwur der Schwarzfelle‡검은나무 일족의 맹세‡La promesa de los Bosque Negro‡La promesa de los Bosque Negro‡Le serment des Noirbois‡黑木誓言‡黑木的誓約',
    nil,
    'Fale novamente com Malfurion Tempesfúria no Olho do Vórtice.‡Вернитесь к Малфуриону Ярость Бури в Око Урагана.‡Kehrt zu Malfurion Sturmgrimm beim Auge des Vortex zurück.‡소용돌이의 눈에 있는 말퓨리온 스톰레이지에게 가야 합니다.‡Vuelve con Malfurion Tempestira al Ojo del Vórtice.‡Vuelve con Malfurion Tempestira al Ojo del Vórtice.‡Retournez voir Malfurion Hurlorage dans l\'Œil du Vortex.‡去找漩涡之眼的玛法里奥·怒风。‡回到巨旋風之眼的瑪法里恩·怒風那兒。',
  }
},
[13582] = {
  {
    'O fogo de Eluna‡Огонь Элуны‡Das Feuer Elunes‡엘룬의 불꽃‡El fuego de Elune‡El fuego de Elune‡Le feu d\'Élune‡艾露恩之火‡伊露恩之火',
    nil,
    'Obtenha a Tocha de Eluna com Huruu, o Guardião da Chama.‡Добудьте факел Элуны у Хору Хранителя пламени.‡Erhaltet Elunes Fackel von Horoo dem Flammenbewahrer.‡동굴 동쪽에 있는 불꽃지기 호루에게서 엘룬의 횃불을 획득해야 합니다.‡Consigue la antorcha de Elune de Horoo el Guardián de la llama.‡Consigue la antorcha de Elune de Horoo el Guardián de la llama.‡Obtenez la Torche d\'Élune auprès de Horoo le Gardien des flammes.‡从护火者霍鲁那里获得月神之火。‡從『火焰守衛者』荷魯那裡取得伊露恩之炬。',
  }
},
[13583] = {
  {
    'O juramento dos coruscantes‡Клятва совуха‡Der Schwur der Wildekin‡올빼미야수의 맹세‡El juramento de los lechúcicos salvajes‡El juramento de los lechúcicos salvajes‡Le serment de l\'Indomptable‡枭兽之誓‡梟獸的誓言',
    nil,
    'Fale novamente com Malfurion Tempesfúria no Olho do Vórtice.‡Вернитесь к Малфуриону Ярость Бури в Око Урагана.‡Kehrt zu Malfurion Sturmgrimm beim Auge des Vortex zurück.‡소용돌이의 눈에 있는 말퓨리온 스톰레이지에게 가야 합니다.‡Vuelve con Malfurion Tempestira a El Ojo del Vórtice.‡Vuelve con Malfurion Tempestira a El Ojo del Vórtice.‡Retournez voir Malfurion Hurlorage dans l\'Œil du Vortex.‡去找漩涡之眼的玛法里奥·怒风。‡回到巨旋風之眼的瑪法里恩·怒風那兒。',
  }
},
[13584] = {
  {
    'Terra em polvorosa‡Колыбельная для Земли‡Die Erde beruhigen‡대지를 안정시키는 일‡Calmando la tierra‡Calmando la tierra‡Calmer la terre‡平息土地‡安撫大地',
    nil,
    'Mate 8 Elementais da Terra Enfurecidos.‡Убейте 8 разъяренных элементалей земли.‡Tötet 8 wütende Erdelementare.‡격노한 대지의 정령 8마리를 처치해야 합니다.‡Mata a 8 elementales de tierra iracundos.‡Mata a 8 elementales de tierra iracundos.‡Tuez 8 Élémentaires de terre enragés.‡消灭8名被激怒的大地元素。‡殺死8隻狂怒的土元素。',
  }
},
[13585] = {
  {
    'Jura de proteção‡Клятва защитника‡Der Eid, zu beschützen‡수호의 맹세‡Juramento de protección‡Juramento de protección‡Le serment de protéger‡誓死保护‡誓言保護',
    nil,
    'Fale com Malfurion Tempesfúria, no Olho do Vórtice, que fica na Costa Negra.‡Поговорите с Малфурионом Яростью Бури в Оке Урагана, что на Темных берегах.‡Sprecht mit Malfurion Sturmgrimm beim Auge des Vortex in Dunkelküste.‡어둠해안, 소용돌이의 눈에 있는 말퓨리온 스톰레이지와 대화해야 합니다.‡Habla con Malfurion Tempestira en El Ojo del Vórtice en Costa Oscura.‡Habla con Malfurion Tempestira en El Ojo del Vórtice en Costa Oscura.‡Parlez à Malfurion Hurlorage dans l\'Œil du Vortex, à Sombrivage.‡跟黑海岸漩涡之眼的玛法里奥·怒风谈一谈。‡去黑海岸的巨旋風之眼與瑪法里恩交談。',
  }
},
[13586] = {
  {
    'Sonho Esmeralda‡Изумрудный сон‡Der Smaragdgrüne Traum‡에메랄드의 꿈‡El Sueño Esmeralda‡El Sueño Esmeralda‡Le Rêve d\'émeraude‡翡翠梦境‡翡翠夢境',
    nil,
    'Atravesse o Portal do Pesadelo na Caverna Quebraterra, e fale com Thessera.‡Пройдите сквозь портал кошмаров в Пещеру землекрушителя и поговорите с Тессерой.‡Begebt Euch durch das Alptraumportal in der Erdspaltergrotte und sprecht mit Thessera.‡지축이동 동굴에 있는 악몽의 차원문으로 가서 테세라를 찾아 대화해야 합니다.‡Atraviesa el portal pesadilla en la Caverna Rompetierra y habla con Thessera.‡Atraviesa el portal pesadilla en la Caverna Rompetierra y habla con Thessera.‡Franchissez le Portail cauchemardesque à la Caverne de Brise-terre, et parlez à Thessera.‡穿过碎地者洞穴的噩梦传送门，同塔丝瑟拉交谈。‡穿過碎地者洞窟的夢魘之門並和賽瑟拉談話。',
  }
},
[13587] = {
  {
    'Pesadelo lúcido‡Ходячий кошмар‡Der erwachende Alptraum‡깨어나는 악몽‡La pesadilla despierta‡La pesadilla despierta‡Cauchemar éveillé‡清醒的梦魇‡清醒的夢魘',
    nil,
    'Tome o Pergaminho Esmeraldino do Guardião Pesadelo no interior da Caverna Quebraterra.‡Добудьте изумрудный свиток у стража кошмара в Пещере землекрушителя.‡Erhaltet die smaragdgrüne Schriftrolle von dem Alptraumwächter in der Erdspaltergrotte.‡지축이동 동굴에 있는 악몽의 수호자에게서 에메랄드 두루마리를 획득해야 합니다.‡Consigue el pergamino esmeralda del guardián pesadilla en la Caverna Rompetierra.‡Consigue el pergamino esmeralda del guardián pesadilla en la Caverna Rompetierra.‡Obtenez le Parchemin émeraude du Gardien cauchemardesque, à l’intérieur de la Caverne de Brise-terre.‡从碎地者洞穴的噩梦守护者那里获得翡翠卷轴。‡從碎地者洞窟內的夢魘守護者那裡取得翡翠卷軸。',
  }
},
[13588] = {
  {
    'O olho de todas as tempestades‡Око бурь‡Das Auge aller Stürme‡폭풍우의 눈‡El ojo de todas las tormentas‡El ojo de todas las tormentas‡L\'œil de toutes les tempêtes‡群风之眼‡萬千風暴之眼',
    nil,
    'Monte em Thessera para derrotar 12 Viajores do Crepúsculo e destruir o Portal do Crepúsculo.‡Оседлайте Тессеру и убейте 12 наездников из культа Сумеречного Молота, а также уничтожьте сумеречный портал.‡Fliegt mit Thessera und zerstört 12 Zwielichtreiter und das Zwielichtportal.‡테세라에 올라 황혼의 기수 12마리를 처치하고 황혼의 차원문을 파괴해야 합니다.‡Monta en Thessera para derrotar a 12 jinetes Crepusculares y destruye el Portal Crepuscular.‡Monta en Thessera para derrotar a 12 jinetes Crepusculares y destruye el Portal Crepuscular.‡Chevauchez Thessera pour vaincre 12 Chevaucheurs du Crépuscule et détruisez le Portail du Crépuscule.‡乘塔丝瑟拉打败12名暮光龙骑兵，并摧毁暮光传送门。‡乘著賽瑟拉擊敗12名暮光騎兵並摧毀暮光傳送門。',
  }
},
[13589] = {
  {
    'Os invasores Lança Partida‡Захватчики из племени Пронзающего Копья‡Die Eindringlinge der Splitterspeere‡뾰족창 부족의 침략‡Los invasores Rompelanzas‡Los invasores Rompelanzas‡Les envahisseurs briselances‡碎矛入侵者‡碎矛入侵者',
    nil,
    'Apresente-se à Tenente Moira Brisastral nas Ruínas de Mathistra.‡Разыщите лейтенанта Морру Звездный Ветер на руинах Матистры.‡Meldet Euch bei Leutnant Morra Sternenhauch bei den Ruinen von Mathystra.‡마시스트라 폐허에 있는 부관 모라 스타브리즈에게 보고해야 합니다.‡Preséntate ante la teniente Morra Brisa Estelar en las Ruinas de Mathystra.‡Preséntate ante la teniente Morra Brisa Estelar en las Ruinas de Mathystra.‡Faites votre rapport au lieutenant Morra Brise-Stellaire, aux Ruines de Mathystra.‡去找玛塞斯特拉废墟的莫拉·星风中尉。‡到瑪塞斯特拉廢墟向莫拉·星風中尉回報。',
  }
},
[13590] = {
  {
    'A frente de batalha‡Передовая‡An vorderster Front‡최전선에서‡La línea de frente‡La línea de frente‡La ligne de front‡前线‡前線',
    nil,
    'Apresente-se à Caçadora Sandrya Luméluna no Vale da Lança Partida.‡Доложите Охотнице Сандрии Закат Луны, которую можно найти в долине Пронзающего Копья.‡Meldet Euch bei Jägerin Sandrya Mondsturz im Splitterspeertal.‡뾰족창 골짜기에 있는 여사냥꾼 산드리아 문폴에게 보고해야 합니다.‡Preséntate ante la cazadora Sandrya Puestaluna en el interior del Valle Rompelanzas.‡Preséntate ante la cazadora Sandrya Puestaluna en el interior del Valle Rompelanzas.‡Faites votre rapport à la chasseresse Sandrya Tombelune, dans la Vallée des Briselances.‡去找碎矛谷的女猎手桑德娅·月落。‡到碎矛谷深處向女獵手珊崔雅·月落回報。',
  }
},
[13591] = {
  {
    'Conexões perturbadoras‡Странные совпадения‡Beunruhigende Verbindungen‡위협적인 동맹‡Conexiones preocupantes‡Conexiones preocupantes‡Des liens inquiétants‡令人不安的联系‡叫人不安的關聯',
    nil,
    'Leve a Carta de Grito Infernal à Patrulheira Glynda Nal\'Shea em Lor\'danel.‡Принесите Послание Адского Крика стрелку Глинде Нал\'Шие в Лор\'данел.‡Bringt Höllschreis Brief zu Waldläuferin Glynda Nal\'Shea in Lor\'danel.‡로르다넬에 있는 순찰자 글린다 날셰에게 헬스크림의 서신을 가져가야 합니다.‡Lleva la misiva de Grito Infernal a la forestal Glynda Nal\'Shea a Lor\'danel.‡Lleva la misiva de Grito Infernal a la forestal Glynda Nal\'Shea a Lor\'danel.‡Apportez la Lettre de Hurlenfer au forestier Glynda Nal\'Shea, à Lor\'danel.‡将地狱咆哮的信函带给洛达内尔的游侠戈琳达·纳希恩。‡將地獄吼的公文帶去洛丹諾給遊俠戈琳達·納希亞。',
  }
},
[13592] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Sir Marcus Barlowe, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию сэра Маркуса Барлоу из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Sir Marcus Barlow beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 마커스 발로 경이 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Sir Marcus Barlowe en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sir Marcus Barlowe en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sire Marcus Barlowe, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的马库斯·巴洛爵士要你消灭10名被转化的英雄。‡銀白聯賽場地的馬庫斯‧巴羅威爵士要你殺死10名轉化的英雄。',
  }
},
[13593] = {
  {
    'Valente de Ventobravo‡Искатель славы из Штормграда‡Recke von Sturmwind‡스톰윈드 용맹전사‡Valeroso de Ventormenta‡Valeroso de Ventormenta‡Vaillant de Hurlevent‡暴风城的勇士‡暴風城驍士',
    nil,
    'Fale com o Marechal Jacob Alerius novamente se desejar se tornar um valente de Ventobravo.‡Если вы хотите стать искателем славы Штормграда, поговорите еще раз с маршалом Якобом Алерием в Павильоне Серебряного союза.‡Sprecht wieder mit Marschall Jacob Alerius, falls Ihr ein Recke von Sturmwind werden wollt.‡작전사령관 제이콥 알레리우스와 다시 대화하면 스톰윈드 용맹전사가 될 수 있습니다.‡Habla con el mariscal Jacob Alerius de nuevo si quieres convertirte en un Valeroso de Ventormenta.‡Habla con el mariscal Jacob Alerius de nuevo si quieres convertirte en un Valeroso de Ventormenta.‡Parlez à nouveau au Maréchal Jacob Alerius si vous voulez devenir un vaillant de Hurlevent.‡如果你想要成为暴风城的勇士，就再找雅克布·奥勒留斯元帅谈一谈。‡如果你想成為一位暴風城驍士，再去和傑科布·亞雷瑞斯元帥談談。',
  }
},
[13594] = {
  {
    'Lição bem dada‡Не забывайте про Орду‡Vergesst die Horde nicht‡호드를 잊지 말자‡No te olvides de la Horda‡No te olvides de la Horda‡N\'oubliez pas la Horde‡别忘了部落‡別忘了部落',
    nil,
    'Mate 10 membros da Horda no Refúgio de Bathran.‡Убейте 10 ордынцев в Убежище Батрана.‡Tötet 10 beliebige Mitglieder der Horde in Bathrans Schlupfwinkel.‡배스랜 서식지에서 호드 병사 10명을 처치해야 합니다.‡Mata a 10 miembros de la Horda en las Ruinas de Bathran.‡Mata a 10 miembros de la Horda en las Ruinas de Bathran.‡Tuez 10 membres de la Horde au Repaire de Bathran.‡在巴斯兰鬼屋杀死任意10名部落。‡殺死在巴斯蘭鬼屋的任意10名部落敵人。',
  }
},
[13595] = {
  {
    'Do pó vieste, ao pó voltarás‡Ни пряди волос‡Mit ihren eigenen Waffen‡그들의 뜻대로‡De su propio diseño‡De su propio diseño‡Tel est pris qui croyait prendre‡自食其果‡自創設計',
    nil,
    'Pegue uma Garrafa de Fogo Indômito e jogue-a no Cadáver de Bathran para queimá-lo.‡Бросьте бутыль буйного огня на тело Батрана и сожгите его.‡Erbeutet eine Wildfeuerflasche und werft sie auf Bathrans Leichnam, um ihn zu verbrennen.‡도깨비불 병을 획득해 배스랜의 시체에 던져 불태워야 합니다.‡Consigue una botella de fuego salvaje y tírala sobre el cadáver de Bathran para quemarlo.‡Consigue una botella de fuego salvaje y tírala sobre el cadáver de Bathran para quemarlo.‡Récupérez une Bouteille braisière et lancez-la sur le Cadavre de Bathran pour le brûler.‡获得一瓶火种，把它扔在巴斯兰的尸体上，将其烧掉。‡取得一瓶野火並將它丟在巴斯蘭的屍體上好將屍體燒掉。',
  }
},
[13596] = {
  {
    'Planos do Crepúsculo‡Планы Сумеречного Молота‡Schattenhammerpläne‡황혼의 계획서‡Los planes del Martillo Crepuscular‡Los planes del Martillo Crepuscular‡Les plans du Crépuscule‡暮光计划‡暮光計畫書',
    nil,
    'Obtenha 6 documentos com Planos do Crepúsculo no Acampamento do Crepúsculo.‡Добудьте 6 планов Сумеречного Молота из их лагеря.‡Erhaltet 6 Schattenhammerpläne aus dem Lager der Schattenhammer.‡황혼의 야영지에서 황혼의 계획서 6장을 구해야 합니다.‡Consigue los planes Crepusculares en el Campamento Crepuscular.‡Consigue los planes Crepusculares en el Campamento Crepuscular.‡Récupérez 6 Plans du Crépuscule au Campement du crépuscule.‡在暮光营地搜集6份暮光计划书。‡在暮光營地取得6份暮光計畫書。',
  }
},
[13597] = {
  {
    'O espírito do ursocardo‡Дух колючешерстного медведя‡Der Geist des Distelbären‡엉겅퀴곰의 영‡El espíritu del oso cardo‡El espíritu del oso cardo‡L\'esprit de l\'Ours des chardons‡蓟熊巨灵‡薊熊之靈',
    nil,
    'O Guardião Karithus o ensinou a receber a bênção do Grande Espírito Ursocardo.‡Хранитель Каритий велел вам получить благословение великого духа колючешерстного медведя.‡Bewahrer Karithus hat Euch angewiesen, den Segen des großen Distelbärgeists einzuholen.‡수호자 카리투스의 말에 따라 거대한 엉겅퀴곰의 영으로부터 축복을 받아야 합니다.‡El vigilante Karithus te ha indicado cómo recibir la bendición del gran espíritu del oso cardo.‡El vigilante Karithus te ha indicado cómo recibir la bendición del gran espíritu del oso cardo.‡Le Gardien Karithus vous a demandé de recevoir la Bénédiction du Grand esprit ours des chardons.‡守护者卡里修斯吩咐你接受蓟熊巨灵的祝福。‡守衛者卡利蘇斯已指示你如何受到偉大薊熊之靈的祝福。',
  }
},
[13598] = {
  {
    'Remédios amargos‡Горькое лекарство‡Widerliche Arznei‡고약한 치료제‡Remedios indeseables‡Remedios indeseables‡Des remèdes déplaisants‡良药苦口‡難受的療法',
    nil,
    'Consiga 6 Cogumelos Fumaça.‡Разыщите 6 дымных поганок.‡Sammelt 6 rauchende Fliegenpilze.‡독기 뿜는 독버섯 6개를 모아야 합니다.‡Recoge 6 setas humeantes.‡Recoge 6 setas humeantes.‡Récupérez 6 Amanites fumantes.‡采集6株熏烟伞菌。‡取回6份濃臭傘菌。',
  }
},
[13599] = {
  {
    'O retorno de Garratroz‡Возвращение Лютого Когтя‡Grimmklaues Rückkehr‡잔혹발톱의 귀환‡El retorno de Zarpadura‡El retorno de Zarpadura‡Le retour de Griffe-sinistre‡锐爪复元‡銳爪的回歸',
    nil,
    'Fale com Volcor e Garratroz em Lor\'danel.‡Вернитесь к Волкору и Лютому Когтю в Лор\'данел.‡Kehrt zu Volcor und Grimmklaue in Lor\'danel zurück.‡로르다넬에 있는 볼코르와 잔혹발톱에게 가야 합니다.‡Vuelve con Volcor y con Zarpadura a Lor\'danel.‡Vuelve con Volcor y con Zarpadura a Lor\'danel.‡Retournez voir Volcor et Griffe-sinistre à Lor\'danel.‡去找洛达内尔的沃科尔和锐爪。‡回去洛丹諾找沃科爾和銳爪。',
  }
},
[13600] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar ao Marechal Jacob Alerius nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара маршалу Якобу Алерию в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Marschall Jacob Alerius beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar au Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的雅克布·奥勒留斯元帅。‡把德拉克瑪之刃帶給銀白聯賽場地的傑科布·亞雷瑞斯元帥。',
  }
},
[13601] = {
  {
    'Socorro aos refugiados‡На помощь беженцам‡Hilfe für die Flüchtlinge‡살아남은 이들을 위하여‡Ayudar a los refugiados‡Ayudar a los refugiados‡Au secours des réfugiés‡援助难民‡幫助難民',
    nil,
    'A Sentinela Leandra, em Lor\'danel, quer que você fale com a Sacerdotisa Alinya no Acampamento de Refugiados.‡Часовой Лендра из Лор\'данела просит вас поговорить с жрицей Алинией в Лагере беженцев.‡Schildwache Lendra in Lor\'danel möchte, dass Ihr mit Priesterin Alinya im Flüchtlingslager sprecht.‡로르다넬에 있는 파수꾼 렌드라가 피난민 야영지에 있는 여사제 알리냐를 만나라고 했습니다.‡La centinela Lendra de Lor\'danel quiere que hables con la sacerdotisa Alinya en el Campo de Refugiados.‡La centinela Lendra de Lor\'danel quiere que hables con la sacerdotisa Alinya en el Campo de Refugiados.‡La Sentinelle Lendra, à Lor\'danel, vous demande d\'aller parler à la Prêtresse Alinya, au Camp de réfugiés.‡洛达内尔的哨兵兰德拉要你跟难民营的女祭司艾琳雅谈一谈。‡洛丹諾的哨兵蘭卓拉希望你去難民營和女牧師艾爾琳雅談話。',
  }
},
[13602] = {
  {
    'Nagas de praia‡Наги Зорамского взморья‡Naga des Strandes‡해안의 나가‡Naga de la ensenada‡Naga de la ensenada‡Gang de nagas‡海岸的纳迦‡海岸納迦',
    nil,
    'Mate 15 Nagas Iracauda de qualquer tipo na Praia de Zoram.‡Убейте 15 наг из клана Зловещего Хвоста на Зорамском взморье.‡Tötet 15 beliebige Naga der Rächerflossen am Zoramstrand.‡조람 해안에 있는 성난지느러미 일족 나가 15마리를 처치해야 합니다.‡Mata 15 nagas Colafuria en la Ensenada de Zoram.‡Mata 15 nagas Colafuria en la Ensenada de Zoram.‡Tuez 15 Nagas irequeue, sur la Grève de Zoram.‡在佐拉姆海岸杀死15只怒尾纳迦。‡在佐拉姆海岸殺死任意15隻怒尾納迦。',
  }
},
[13603] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a ao Marechal Jacob Alerius nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его маршалу Якобу Алерию в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Marschall Jacob Alerius beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 잿빛나무 검을 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le au maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的雅克布·奥勒留斯元帅。‡取得灰木古劍，並帶給銀白聯賽場地的傑科布‧亞雷瑞斯元帥。',
  }
},
[13604] = {
  {
    'Disco de Dados do Archivum‡Диск доступа к Архиву‡Datenscheibe des Archivums‡고대 기록관 자료 원반‡Disco de datos de El Archivum‡Disco de datos de El Archivum‡Le disque de données de l\'Archivum‡档案馆数据圆盘‡大資料庫資料圓盤',
    nil,
    'Leve o Disco de Dados do Archivum ao Console do Archivum em Ulduar.‡Отнесите диск доступа к Архиву к панели управления Архивом в Ульдуаре.‡Bringt die Datenscheibe des Archivums zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 고대 기록관 자료 원반을 가져가야 합니다.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Apportez le Disque de données de l\'Archivum à la Console de l\'Archivum dans Ulduar.‡将档案馆数据圆盘带到奥杜尔的档案馆控制台前。‡將大資料庫資料圓盤帶到奧杜亞的大資料庫控制臺。',
  }
},
[13605] = {
  {
    'A última refugiada‡Последний выживший‡Der letzte Flüchtling‡마지막 피난민‡El último refugiado‡El último refugiado‡Le dernier réfugié‡最后的难民‡最後的難民',
    nil,
    'Escolte a Arqueóloga Hollee em segurança.‡Сопроводите археолога Холли в безопасное место.‡Begleitet Archäologin Hollee in Sicherheit.‡고고학자 호올리를 안전하게 호위해야 합니다.‡Escolta a la arqueóloga Hollee hasta que esté a salvo.‡Escolta a la arqueóloga Hollee hasta que esté a salvo.‡Escortez l\'Archéologue Hollee jusqu\'à ce qu\'elle soit en sécurité.‡安全护送考古学家霍莉。‡護送考古學家霍莉到安全處',
  }
},
[13606] = {
  {
    'Signo de Freya‡Печать Фрейи‡Freyas Siegel‡프레이야의 인장‡El sigilo de Freya‡El sigilo de Freya‡Le cachet de Freya‡弗蕾亚的徽记‡芙蕾雅的符印',
    nil,
    'O Prospector Doren no Archivum em Ulduar quer que você se apodere do Signo de Freya.|n|nPara obter mais informações sobre como conseguir o Signo de Freya, consulte o Console do Archivum.‡Добудьте печать Фрейи по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Freyas Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Freyas Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 프레이야의 인장을 가져와 달라고 했습니다.|n|n프레이야의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Freya.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将弗蕾亚的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得弗蕾亚的徽记。‡奧杜亞大資料庫的勘察員多倫要你取得芙蕾雅的符印。|n|n想知道更多關於如何取得芙蕾雅的符印，請詢問大資料庫控制臺。',
  }
},
[13607] = {
  {
    'O Planetário Celestial‡Священный планетарий‡Das Himmlische Planetarium‡별자리 투영관‡El Planetario Celestial‡El Planetario Celestial‡Le planétarium céleste‡天文台‡星穹渾天儀',
    nil,
    'O Prospector Doren no Archivum em Ulduar quer que você localize a entrada do Planetário Celestial.‡Найдите Священный планетарий по заданию геолога Дорена из Архива в Ульдуаре.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr den Eingang zum Himmlischen Planetarium findet.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 별자리 투영관의 입구를 찾아 달라고 했습니다.‡El prospector Doren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡El prospector Doren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé de trouver l\'entrée du Planétarium céleste.‡奥杜尔档案馆中的勘探员多尔伦要你找到天文台的入口。‡奧杜亞大資料庫的勘察員多倫要你找到通往星穹渾天儀的入口。',
  }
},
[13608] = {
  {
    '‡На прогулку‡Mitgegangen‡공중 정찰‡De paseo aéreo‡‡S\'envoyer en l\'air‡‡',
    nil,
    '‡Стрелок Глинда Нал\'Шия из Лор\'данела поручила вам присоединиться к разведывательной миссии. Поговорите с ней, когда будете готовы к вылету.‡Schildwache Glynda Nal\'Shea hat Euch gebeten, mit einer der Schildwachen einen Erkundungsflug anzutreten. Sprecht mit Glynda, wenn Ihr bereit zum Abflug seid.‡로르다넬에 있는 파수꾼 글린다 날셰가 파수꾼의 공중 정찰 임무에 합류하라고 했습니다. 떠날 준비가 되면 그녀와 대화해야 합니다.‡La centinela Glynda Na\'Shea de Lor\'danel te ha pedido que te unas a una de sus centinelas en una misión de exploración aérea. Habla con ella cuando estés <listo/lista> para salir.‡‡La Sentinelle Glynda Na\'Shea à Lor\'danel vous a demandé de vous joindre à une de ses sentinelles pour une mission de reconnaissance aérienne. Parlez-lui quand vous serez <prêt/prête> à partir.‡‡',
  }
},
[13609] = {
  {
    'Signo de Hodir‡Печать Ходира‡Hodirs Siegel‡호디르의 인장‡El sigilo de Hodir‡El sigilo de Hodir‡Le cachet de Hodir‡霍迪尔的徽记‡霍迪爾的符印',
    nil,
    'O Prospector Doren no Archivum em Ulduar quer que você se apodere do Signo de Hodir.|n|nPara obter mais informações sobre como conseguir o Signo de Hodir, consulte o Console do Archivum.‡Добудьте печать Ходира по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Hodirs Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Hodirs Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 호디르의 인장을 가져와 달라고 했습니다.|n|n호디르의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Hodir.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将霍迪尔的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得霍迪尔的徽记。‡奧杜亞大資料庫的勘察員多倫要你取得霍迪爾的符印。|n|n想知道更多關於如何取得霍迪爾的符印，請詢問大資料庫控制臺。',
  }
},
[13610] = {
  {
    'Signo de Thorim‡Печать Торима‡Thorims Siegel‡토림의 인장‡El sigilo de Thorim‡El sigilo de Thorim‡Le cachet de Thorim‡托里姆的徽记‡索林姆的符印',
    nil,
    'O Prospector Doren no Archivum em Ulduar quer que você se apodere do Signo de Thorim.|n|nPara obter mais informações sobre como conseguir o Signo de Thorim consulte o Console do Archivum.‡Добудьте печать Торима по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Thorims Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Thorims Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 토림의 인장을 가져와 달라고 했습니다.|n|n토림의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Thorim.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将托里姆的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得托里姆的徽记。‡奧杜亞大資料庫的勘察員多倫要你取得索林姆的符印。|n|n想知道更多關於如何取得索林姆的符印，請詢問大資料庫控制臺。',
  }
},
[13611] = {
  {
    'Signo de Mimiron‡Печать Мимирона‡Mimirons Siegel‡미미론의 인장‡El sigilo de Mimiron‡El sigilo de Mimiron‡Le cachet de Mimiron‡米米尔隆的徽记‡彌米倫的符印',
    nil,
    'O Prospector Doren no Archivum de Ulduar quer que você se apodere do Signo de Mimiron.|n|nPara obter mais informações sobre como conseguir o Signo de Mimiron, consulte o Console do Archivum.‡Добудьте печать Мимирона по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Mimirons Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Mimirons Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 미미론의 인장을 가져와 달라고 했습니다.|n|n미미론의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d’Ulduar, vous a demandé d\'obtenir le Cachet de Mimiron.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将米米尔隆的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得米米尔隆的徽记。‡奧杜亞大資料庫的勘察員多倫要你取得彌米倫的符印。|n|n想知道更多關於如何取得彌米倫的符印，請詢問大資料庫控制臺。',
  }
},
[13612] = {
  {
    'Em defesa de Mor\'shan‡Защита лагеря Мор\'Шан‡Die Verteidigung von Mor’shan‡몰샨의 망루 방어‡La defensa de Mor\'shan‡La defensa de Mor\'shan‡La défense de Mor\'shan‡莫尔杉的防御‡莫爾杉防禦',
    nil,
    'Kadrak, na Paliçada Mor\'shan, quer que você mate 5 Escaramuçadores do Vale Gris e 5 Atiradores do Vale Gris.‡Кадрак с заставы Мор\'шан поручил вам убить 5 застрельщиков Ясеневого леса и 5 стрелков Ясеневого леса.‡Kadrak beim Schutzwall von Mor\'shan will, dass Ihr 5 Scharmützler des Eschentals und 5 Bogenschützen des Eschentals tötet.‡몰샨의 망루에 있는 카드라크가 잿빛 골짜기 척후병과 잿빛 골짜기 궁병을 각각 5명씩 처치해 달라고 했습니다.‡Kadrak en la Empalizada de Mor\'shan quiere que mates a 5 hostigadores de Vallefresno y a 5 asaeteadores de Vallefresno.‡Kadrak en la Empalizada de Mor\'shan quiere que mates a 5 hostigadores de Vallefresno y a 5 asaeteadores de Vallefresno.‡Kadrak, au Rempart de Mor\'shan, vous demande de tuer 5 Tirailleurs d\'Orneval et 5 Francs-archers d\'Orneval.‡莫尔杉农场的卡德拉克要你杀死5名灰谷步兵和5名灰谷弓箭手。‡莫爾杉堡壘的卡德拉克要你殺死5名梣谷爭鬥者和5名梣谷弓箭手。',
  }
},
[13613] = {
  {
    'Resgate dos feridos‡Спасение павших‡Rettet die Gefallenen‡사상자 구출‡Rescatar a los caídos‡Rescatar a los caídos‡Sauvez les blessés‡救治伤兵‡拯救受傷的戰士',
    nil,
    'Use o Bálsamo Medicinal em 5 Defensores Feridos de Mor\'shan.‡Исцелите врачебным зельем 5 раненых защитников заставы Мор\'шан.‡Verwendet die heilkräftige Salbe bei 5 verletzten Verteidigern von Mor’shan.‡부상당한 몰샨 수호병 5명에게 치료용 연고를 사용해야 합니다.‡Utiliza el ungüento medicado en 5 defensores Mor\'shan heridos.‡Utiliza el ungüento medicado en 5 defensores Mor\'shan heridos.‡Utilisez l\'Onguent médicinal sur 5 Défenseurs de Mor\'shan blessés.‡用药膏救治5名受伤的莫尔杉防御者。‡對5個受傷的莫爾杉防衛者使用醫藥軟膏。',
  }
},
[13614] = {
  {
    'Algalon‡Алгалон‡Algalon‡알갈론‡Algalon‡Algalon‡Algalon‡奥尔加隆‡艾爾加隆',
    nil,
    'Leve os Signos dos Vigilantes ao console do Archivum em Ulduar.‡Принесите печати хранителей к панели управления Архивом в Ульдуаре.‡Bringt die Siegel der Wächter zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 감시자의 인장 묶음을 가져가야 합니다.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Apportez les Cachets des guetteurs à la Console de l\'Archivum d\'Ulduar.‡将守护者的徽记带到奥杜尔的档案馆控制台前。‡將看守者符印帶給奧杜亞的大資料庫控制臺。',
  }
},
[13615] = {
  {
    'Aljavas vazias‡Пустой колчан‡Leere Köcher‡빈 화살통‡Carcajes vacíos‡Carcajes vacíos‡Des carquois vides‡箭壶见底‡空箭袋',
    nil,
    'Truun, na Paliçada Mor\'shan, quer que você junte 10 Flechas Utilizáveis na região do Lago Céu Caído.‡Труун с заставы Мор\'шан поручил вам собрать 10 исправных стрел вокруг Зеркала Небес.‡Truun im Schutzwall von Mor’shan verlangt von Euch, 10 brauchbare Pfeile in der Umgebung des Himmelssturzsees einzusammeln.‡몰샨의 망루에 있는 트룬이 유성 호수 지역에서 쓸모 있는 화살 10개를 찾아와 달라고 했습니다.‡Truun, en la Empalizada de Mor\'shan quiere que recojas 10 flechas útiles en la región del Lago Cielo Estrellado.‡Truun, en la Empalizada de Mor\'shan quiere que recojas 10 flechas útiles en la región del Lago Cielo Estrellado.‡Truun, au Rempart de Mor\'shan, vous demande de récupérer 10 Flèches utilisables dans la région du Lac Tombeciel.‡莫尔杉农场的图伦要你从坠星湖地区收集10支耐用的箭矢。‡莫爾杉壁壘的楚恩要你去墜星湖地區，收集10隻可用的箭。',
  }
},
[13616] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'O Marechal Jacob Alerius, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Маршал Якоб Алерий из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Marschall Jacob Alerius beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스가 겨울 칼날을 가져다 달라고 했습니다.‡El mariscal Jacob Alerius en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡El mariscal Jacob Alerius en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Le Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的雅克布·奥勒留斯元帅。‡銀白聯賽場地的傑科布‧亞雷瑞斯元帥要你把凜冬之鋒帶給他。',
  }
},
[13617] = {
  {
    'Para o oeste, para a praia‡К западу от Пучины‡Nach Westen zum Strand‡해안의 서쪽‡Arena a la Ensenada‡Arena a la Ensenada‡En route pour la grève‡西行海岸‡海濱之西',
    nil,
    'Fale com o Talen no Acampamento das Profundezas Negras, que fica no Vale Gris.‡Поговорите с Таленом в лагере у Непроглядной Пучины в Ясеневом лесу.‡Sprecht mit Talen am Stützpunkt an der Grotte im Eschental.‡잿빛 골짜기의 검은심연 야영지에 있는 탈렌과 대화해야 합니다.‡Habla con Talen en el Campamento Brazanegra en Vallefresno.‡Habla con Talen en el Campamento Brazanegra en Vallefresno.‡Allez parler à Talen, au Camp de Brassenoire en Orneval.‡去跟灰谷黑渊营地的塔尔伦谈一谈。‡在梣谷的黑澗營地和塔爾倫說話。',
  }
},
[13618] = {
  {
    'Encontre Gorat!‡Найти Гората!‡Findet Gorat!‡고라트를 찾아라!‡¡Busca a Gorat!‡¡Busca a Gorat!‡Trouvez Gorat !‡找到高拉特！‡找到戈瑞特!',
    nil,
    'Kadrak, na Paliçada Mor\'shan, quer que você procure por Gorat na região do Lago Céu Caído.‡Кадрак с заставы Мор\'шан попросил вас обойти Зеркало Небес в поисках Гората.‡Kadrak am Schutzwall von Mor‘shan will, dass Ihr die Gegend um den Himmelssturzsee herum nach Gorat durchsucht.‡몰샨의 망루에 있는 카드라크가 유성 호수 지역에서 고라트를 찾아달라고 했습니다.‡Kadrak en la Empalizada de Mor\'shan quiere que rastrees la región del Lago Cielo Estrellado para buscar a Gorat.‡Kadrak en la Empalizada de Mor\'shan quiere que rastrees la región del Lago Cielo Estrellado para buscar a Gorat.‡Kadrak, au Rempart de Mor\'shan, vous demande de fouiller la région du Lac Tombeciel pour retrouver Gorat.‡莫尔杉农场的卡德拉克要你在坠星湖地区寻找高拉特。‡莫爾杉壁壘的卡德拉克要你到墜星湖地區搜尋戈瑞特。',
  }
},
[13619] = {
  {
    'Relatório final‡Последний отчет‡Abschlussbericht‡마지막 보고‡El último informe‡El último informe‡Le dernier rapport‡最后的报告‡最後報告',
    nil,
    'Gorat quer que você leve a Ampola de Sangue para Kadrak na Paliçada Mor\'shan.‡Горат попросил вас отнести пузырек с его кровью Кадраку на заставу Мор\'шан.‡Gorat will, dass Ihr die Phiole mit Gorats Blut zu Kadrak beim Schutzwall von Mor’shan bringt.‡고라트가 자신의 피가 든 유리병을 몰샨의 망루에 있는 카드라크에게 가져가 달라고 했습니다.‡Gorat quiere que lleves el Vial de sangre de Gorat a Kadrak en la Empalizada de Mor\'shan.‡Gorat quiere que lleves el Vial de sangre de Gorat a Kadrak en la Empalizada de Mor\'shan.‡Gorat vous demande de rapporter la Fiole de sang de Gorat à Kadrak, au Rempart de Mor\'shan.‡高拉特要你把高拉特之血带给莫尔杉农场的卡德拉克。‡戈瑞特要你把一瓶戈瑞特之血帶回莫爾杉壁壘給卡德拉克。',
  }
},
[13620] = {
  {
    'Para Dinah, agora mesmo!‡Наконец-то, к Дине!‡Zu Dinah, sofort!‡어서 디나에게로!‡¡A Dinah, a la una!‡¡A Dinah, a la una!‡Livraison expresse‡去找迪娜，立刻出发！‡立刻到丁娜那兒去!',
    nil,
    'Kadrak quer que você leve a Ampola de Sangue de Gorat para Dinah na Paliçada Mor\'shan.‡Кадрак просит вас отнести пузырек с кровью Гората Дине на заставу Мор\'шан.‡Kadrak möchte, dass Ihr die Phiole mit Gorats Blut zu Dinah am Schutzwall von Mor\'shan bringt.‡카드라크가 고라트의 피가 든 유리병을 몰샨의 망루에 있는 디나에게 가져다 달라고 했습니다.‡Kadrak quiere que lleves el Vial de sangre de Gorat a Dinah en la Empalizada de Mor\'shan.‡Kadrak quiere que lleves el Vial de sangre de Gorat a Dinah en la Empalizada de Mor\'shan.‡Kadrak vous a demandé de rapporter la Fiole de sang de Gorat à Dinah au Rempart de Mor\'shan.‡卡德拉克要你把高拉特之血带给莫尔杉农场的迪娜。‡卡德拉克要你帶一瓶戈瑞特之血去莫爾杉壁壘給丁娜。',
  }
},
[13621] = {
  {
    'A vingança de Gorat‡Месть Гората‡Gorats Vergeltung‡고라트의 복수‡La venganza de Gorat‡La venganza de Gorat‡La vengeance de Gorat‡高拉特的复仇‡戈瑞特的復仇',
    nil,
    'Use o Sangue Enfeitiçado de Gorat no corpo de Gorat e, em seguida, derrote o Capitão Elendilad.‡Окропите тело Гората его густой кровью и убейте капитана Элендилада.‡Dinah will, dass Ihr Gorats machterfülltes Blut auf Gorats Leichnam anwendet und dann Hauptmann Elendilad vernichtet.‡고라트의 마력 깃든 피를 고라트의 시체에 사용한 다음 대장 엘렌딜라드를 처치해야 합니다.‡Utiliza la sangre imbuida de Gorat sobre el cadáver de Gorat y derrota al capitán Elendilad.‡Utiliza la sangre imbuida de Gorat sobre el cadáver de Gorat y derrota al capitán Elendilad.‡Utilisez le Sang imprégné de Gorat sur le Cadavre de Gorat, puis battez le Capitaine Elendilad.‡在高拉特的尸体上使用高拉特的灌魔之血，然后击败艾伦迪拉德队长。‡丁娜要你在戈瑞特的屍體上使用戈瑞特的灌魔之血，然後打敗伊蘭迪拉德上尉。',
  }
},
[13622] = {
  {
    'História antiga‡Древняя история‡Uralte Geschichten‡고대사‡Historia antigua‡Historia antigua‡De l\'histoire ancienne‡远古的历史‡上古史',
    nil,
    'Leve os Fragmentos Estilhaçados de Val\'anyr ao Console do Archivum em Ulduar.‡Принесите расколотый Вал\'анир к панели управления в Архив Ульдуара.‡Bringt die zerschmetterten Fragmente von Val\'anyr zur Archivumkonsole im Archivum in Ulduar.‡울두아르의 고대 기록관 조작대에 부서진 발아니르 조각을 가져가야 합니다.‡Lleva los fragmentos rotos de Val\'anyr a la consola de El Archivum en El Archivum de Ulduar.‡Lleva los fragmentos rotos de Val\'anyr a la consola de El Archivum en El Archivum de Ulduar.‡Apportez les Fragments brisés de Val\'anyr à la Console de l\'Archivum, à l\'Archivum, dans Ulduar.‡将瓦兰奈尔的碎片拿到奥杜尔的档案馆控制台那里去。‡將破裂的瓦蘭尼珥碎片帶給奧杜亞大資料庫的大資料庫控制臺。',
  }
},
[13623] = {
  {
    'Entrega para Orendil‡Посылка для Орендила‡Lieferung für Orendil‡오렌딜을 위한 배달‡Un envío para Orendil‡Un envío para Orendil‡Une livraison pour Orendil‡给奥雷迪尔的货物‡給奧蘭迪爾的快遞',
    nil,
    'Entregue o Saco com Cabelo-de-bathran para Orendil Folharga no Entreposto de Maestra, que fica no Vale Gris.‡Доставьте мешочек с Батрановым волосом Орендилу Широколисту на заставу Мейстры, что в Ясеневом лесу.‡Bringt den Beutel voll Bathranshaar zu Orendil Rundblatt in Maestras Posten im Eschental.‡배스랜모초 가방을 잿빛 골짜기의 마에스트라 주둔지에 있는 오렌딜 브로드리프에게 가져가야 합니다.‡Lleva la bolsa de cabello de Bathran a Orendil Hojagrande en la Atalaya de Maestra, Vallefresno.‡Lleva la bolsa de cabello de Bathran a Orendil Hojagrande en la Atalaya de Maestra, Vallefresno.‡Apportez le Sac de cheveux de Bathran à Orendil Largefeuille au Poste de Maestra, en Orneval.‡将一包巴斯兰的头发送给灰谷梅伊瑟娜岗哨的奥雷迪尔·阔叶。‡將一袋巴斯蘭之髮帶去梣谷的邁斯特拉崗哨給奧蘭迪爾·闊葉。',
  }
},
[13624] = {
  {
    'Um pelotão para chamar de seu‡Отряд под твоим командованием‡Eine Staffel nur für Euch‡전우와 함께‡Tu propio escuadrón‡Tu propio escuadrón‡Votre propre escouade‡你自己的人马‡你自己的小隊',
    nil,
    'Comande um pelotão de Sentinelas do Entreposto de Maestra para destruir 3 Destroçadores do Vale Gris e matar 10 Invasores da Horda.‡Часовой Ойнея отдает под ваше командование отряд стражников заставы Мейстры, чтобы вы убили 3 крушителей из Ясеневого леса и 10 захватчиков из Орды.‡Verwendet eine Staffel der Schildwachen aus Maestras Posten, um 3 Zerstörer des Eschentals und 10 Eindringlinge der Horde zu vernichten.‡마에스트라 주둔지 파수꾼을 이용해 잿빛 골짜기 파괴차 3대와 호드 침략자 10명을 처치해야 합니다.‡Utiliza un escuadrón de centinelas de la Atalaya de Maestra para destruir 3 asoladores de Vallefresno y asesinar a 10 invasores de la Horda.‡Utiliza un escuadrón de centinelas de la Atalaya de Maestra para destruir 3 asoladores de Vallefresno y asesinar a 10 invasores de la Horda.‡Utilisez une escouade de Sentinelles du Poste de Maestra pour détruire 3 Casseurs d\'Orneval et pour tuer 10 Envahisseurs de la Horde.‡带一队梅伊瑟娜哨兵消灭3名灰谷劫掠者和10名部落入侵者。‡使用一小隊邁斯特拉崗哨的哨兵摧毀3個梣谷破壞者和殺死10個部落入侵者。',
  }
},
[13625] = {
  {
    'Dominando as rédeas‡Большая тренировка‡Reitgrundlagen‡고삐 다루는 법 익히기‡Aprende a llevar las riendas‡Aprende a llevar las riendas‡Sachez tenir vos rênes‡学习骑战‡學習駕馭',
    nil,
    'Golpeie um Alvo Corpo a Corpo com Estocada 5 vezes, use Quebra-escudo em 2 Alvos à Distância vulneráveis, use Investida em 2 Alvos de Investida e depois fale novamente com a Batedora Shalíndria nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Отработайте прием "Выпад" 5 раз на манекене для ближнего боя, прием "Удар по щиту" 2 раза на мишени для дальнего боя и прием "Рывок" 2 раза на манекене для стремительной атаки, затем вернитесь к разведчице Шалиндрии на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Trefft ein Nahkampfziel 5 Mal mit der Fähigkeit "Zustoßen" und wendet die Fähigkeit "Schildbrecher" auf 2 ungeschützte Distanzziele sowie die Fähigkeit "Sturmangriff" auf 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Späherin Shalyndria beim Argentumturnierplatz zurück.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡근접 표적에 찌르기를 5번 사용하고, 약해진 원거리 표적 2개에 방패 부수기를 사용하고, 약해진 돌진 표적 2개에 돌진을 사용한 후 은빛십자군 마상시합 광장의 정찰병 샬린드리아에게 가야 합니다.|n|n창을 잃어버리면 마구간 근처의 아무 창 선반이나 은빛 서약단 막사에서 다른 창을 얻을 수 있습니다.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Frappez 5 fois une Cible de mêlée avec un Coup de lance, utilisez 2 fois un Brise-bouclier sur des Cibles à distance vulnérables, utilisez 2 fois la Charge sur des Cibles de charge vulnérables, puis retournez voir l\'Eclaireur Shalyndria dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡使用刺击技能攻击一个近战目标5次，使用碎盾技能攻击2个脆弱的远程目标，使用冲锋技能攻击2个脆弱的冲锋目标，然后回到银色比武场，向斥候沙琳蒂亚复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡以戳刺擊中近戰標靶5次，對2個脆弱的遠程標靶使用破盾，對2個脆弱的衝鋒標靶使用衝鋒。然後回到銀白聯賽場地找斥候夏琳卓雅。|n|n如果你弄丟了長槍，你可以從任何一個靠近白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13626] = {
  {
    'Em respeito aos mortos‡Последние почести‡Den Gefallenen zu Ehren‡망자를 위한 예의‡Respeto a los caídos‡Respeto a los caídos‡Le respect envers les morts‡存荣没哀‡尊敬亡者',
    nil,
    'Consiga o Martelo Sagrado de Firo e o Devocionário do Purificador.‡Добудьте священный молот Фиро и молитвенник Очистителя.‡Holt Feeros heiligen Hammer und das Gebetsbuch des Läuterers zurück.‡피이로의 성스러운 망치와 수호자의 기도서를 회수해야 합니다.‡Recupera el martillo sagrado de Feero y el libro de oración del Purificador.‡Recupera el martillo sagrado de Feero y el libro de oración del Purificador.‡Récupérez le Marteau sacré de Feero et le Livre de prières du Purificateur.‡找回费罗的圣光之锤和净化者的祷文手册。‡取回菲羅的聖錘和淨化者的祈禱書。',
  }
},
[13627] = {
  {
    'Me arruma madeira serrada‡Откуда дровишки?‡Wie die Axt im Walde‡불법 벌채‡Agénciame unos maderos‡Agénciame unos maderos‡Allez bûcher un peu…‡砍木头‡幫我盜伐一些木材',
    nil,
    'Leve 12 Tábuas Não Aplainadas para Juntatudo Estourapino nos Campos do Torneio Argênteo.‡Принесите 12 грубо обтесанных досок Беззлу Рвизасову на Ристалище Серебряного турнира.‡Bringt 12 grob gehauene Bauhölzer zu Stumpi Sprengbolz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장의 베즐 블라스트볼트에게 거칠게 잘라낸 나무판자 12개를 가져가야 합니다.‡Llévale 12 tablones sin rematar a Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Llévale 12 tablones sin rematar a Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Apportez 12 Planches grossièrement taillées à Gaspi Boumboulon dans l\'Enceinte du tournoi d\'Argent.‡把12块做工粗糙的木板交给银色比武场的贝兹尔·布拉斯波。‡把12個亂劈的木板帶給銀白聯賽場地的貝索·爆栓。',
  }
},
[13628] = {
  {
    'Vai madeira aí?‡Где бревна?‡Gut Holz‡나무 가진 것 좀 있나?‡¿Tienes madera?‡¿Tienes madera?‡Z\'avez du bois ?‡有木头没有？‡木材到手了嗎?',
    nil,
    'Truun quer que você cavalgue o Brucutu até o Campo de Trabalho Brado Guerreiro.|n|nFale com Kadrak para pegar as Rédeas de Kadrak, que lhe permitirão montar o Brucutu.‡Труун поручил вам оседлать Жестокого Бивня и отправиться в рабочий лагерь Песни Войны.|n|nЧтобы получить поводья для управления Жестоким Бивнем, поговорите с Кадраком.‡Truun will, dass Ihr mit Brutusk zum Lager des Kriegshymnenklans reitet.|n|nSprecht mit Kadrak, um Kadraks Zügel zu erhalten und Brutusk reiten zu können.‡트룬이 브루터스크를 타고 전쟁노래 노동기지로 이동해달라고 했습니다.|n|n브루터스크를 타려면 카드라크와 대화해서 카드라크의 고삐를 얻어야 합니다.‡Truun quiere que montes a Brutusk hasta el Campo de trabajos forzados Grito de Guerra.|n|nHabla con Kadrak para obtener las riendas de Kadrak para montar a Brutusk.‡Truun quiere que montes a Brutusk hasta el Campo de trabajos forzados Grito de Guerra.|n|nHabla con Kadrak para obtener las riendas de Kadrak para montar a Brutusk.‡Truun vous a demandé de chevaucher Brutusk jusqu\'au camp de travail chanteguerre.|n|nAdressez-vous à Kadrak pour obtenir les rênes de Kadrak et chevaucher Brutusk.‡图伦要你坐蛮角前往战歌劳工营地。|n|n跟卡德拉克交谈，拿到卡德拉克的缰绳，骑上布鲁图斯。‡楚恩希望你騎上蠻獠到戰歌勞工營地。|n|n和卡德拉克說話以取得卡德拉克的韁繩來駕馭蠻獠。',
  }
},
[13629] = {
  {
    '‡Вал\'анир, молот древних королей‡Val\'anyr, Hammer der Uralten Könige‡발아니르 - 고대 왕의 망치‡Val\'anyr, Martillo de los antiguos reyes‡Val\'anyr, Martillo de los antiguos reyes‡Val\'anyr, le marteau des anciens rois‡瓦兰奈尔，远古王者之锤‡瓦蘭尼珥，遠古諸王之錘',
    nil,
    '‡Бросьте расколотый Вал\'анир в пасть Йогг-Сарона во время "Оглушающего рева" и победите его, чтобы получить перекованный молот древних королей.|n|nЭто задание можно пройти только в героическом режиме и только в том случае, если хотя бы один из хранителей Ульдуара не помогает вам.‡Werft die zerschmetterten Teile von Val\'anyr in Yogg-Sarons Schlund, während er den Zauber \'Ohrenbetäubendes Gebrüll\' wirkt, und vernichtet ihn, um den neugeschmiedeten Hammer der Uralten Könige zu erhalten.|n|nDies kann nur auf dem Schwierigkeitsgrad "Heroisch" beendet werden und nur dann, wenn Ihr von maximal drei Wächtern von Ulduar unterstützt werdet.‡귀청이 터질듯한 포효를 시전하는 요그사론의 입속에 부서진 발아니르 조각을 던져넣고 그를 쓰러뜨려, 고대 왕의 재련된 망치를 회수해야 합니다.|n|n영웅 난이도에서 울두아르 감시자 셋 이하에게만 도움을 받아야 이 퀘스트를 완료할 수 있습니다.‡Lanza los fragmentos rotos de Val\'anyr a las fauces de Yogg-Saron mientras lanza Rugido ensordecedor y derrota a Yogg-Saron para recuperar el Martillo reforjado de los antiguos reyes.|n|nEsto solo puede hacerse en modo Heroico y solo si al menos un vigía de Ulduar no te está ayudando.‡Lanza los fragmentos rotos de Val\'anyr a las fauces de Yogg-Saron mientras lanza Rugido ensordecedor y derrota a Yogg-Saron para recuperar el Martillo reforjado de los antiguos reyes.|n|nEsto solo puede hacerse en modo Heroico y solo si al menos un vigía de Ulduar no te está ayudando.‡Lancez les Fragments brisés de Val\'anyr dans la gueule de Yogg-Saron pendant qu’il lance un Rugissement assourdissant et triomphez de lui pour récupérer le Marteau des anciens rois reforgé.|n|nCette quête ne peut être accomplie qu’en mode héroïque, et seulement si au moins l’un des Gardiens d’Ulduar ne vous aide pas.‡在尤格-萨隆发出震耳咆哮时，将瓦兰奈尔的碎片投入尤格-萨隆张开的嘴中，然后击败尤格-萨隆，获得重铸的远古王者之锤。|n|n只能在英雄模式下完成，且至少需要有一位奥杜尔的守护者没有协助你。‡當尤格薩倫在施放震耳咆哮時，將破裂的瓦蘭尼珥碎片丟入尤格薩倫的嘴中，然後擊敗尤格薩倫並取回重鑄的遠古諸王之錘。|n|n只能在英雄模式下完成，並且至少有一名奧杜亞看守者未提供協助。',
  }
},
[13630] = {
  {
    'Tudo tem motivo‡Главная причина‡Aus diesem Grund‡이유‡El porqué‡El porqué‡Raison de plus !‡事出有因‡理由',
    nil,
    'Desative as Pedras-da-lua Azul, Verde e Vermelha.‡Отключите синий, зеленый и красный лунные камни.‡Deaktiviert den blauen, den grünen und den roten Mondstein.‡파란색과 녹색, 그리고 빨간색 월장석의 작동을 중단시켜야 합니다.‡Desactiva las piedras lunares azul, verde y roja.‡Desactiva las piedras lunares azul, verde y roja.‡Désactivez les Pierres de lune bleue, verte et rouge‡关闭蓝色、绿色和红色月亮石。‡關閉藍色、綠色、和紅色的月亮石。',
  }
},
[13631] = {
  {
    'Tudo está bem quando termina bem‡Все хорошо, что хорошо кончается‡Ende gut, alles gut‡끝이 좋으면 다 좋다‡Bien está lo que bien acaba‡Bien está lo que bien acaba‡Tout est bien qui finit bien‡结果好，一切都好‡情況良好，完美收場',
    nil,
    'Leve o Código de Resposta Alfa para Rhonin em Dalaran.‡Доставьте код отклика "Альфа" Ронину в Даларан.‡Überbringt Rhonin in Dalaran den Antwortcode Alpha.‡응답 코드 알파를 달라란에 있는 로닌에게 가져가야 합니다.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Apportez le Code-réponse Alpha à Rhonin, à Dalaran.‡将回复代码阿尔法交给达拉然的罗宁。‡將回覆代碼Α帶給達拉然的羅甯。',
  }
},
[13632] = {
  {
    'Cuidado com a retaguarda‡Служба в арьергарде‡Zwei Fronten‡후위 방어 임무‡Turno de retaguardia‡Turno de retaguardia‡À l\'arrière-garde‡后方吃紧‡平定大後方',
    nil,
    'Mate 10 pelursos de qualquer tipo nas Ruínas de Ordil\'Aran.‡Убейте 10 фурболгов на руинах Ордил\'Арана.‡Tötet 10 beliebige Furbolgs in den Ruinen von Ordil\'Aran.‡오르딜아란의 폐허에서 펄볼그 10마리를 처치해야 합니다.‡Mata a 10 fúrbolgs cualesquiera en las Ruinas de Ordil\'Aran.‡Mata a 10 fúrbolgs cualesquiera en las Ruinas de Ordil\'Aran.‡Tuez 10 Furbolgs aux Ruines d\'Ordil\'Aran‡杀死奥迪拉兰废墟的任意10个熊怪。‡在奧迪拉蘭廢墟殺死任意10個熊怪。',
  }
},
[13633] = {
  {
    'O Cavaleiro Negro de Cerro Oeste?‡Черный рыцарь из Западного Края?‡Der schwarze Ritter von Westfall?‡서부 몰락지대의 흑기사?‡¿El Caballero Negro de los Páramos de Poniente?‡¿El Caballero Negro de los Páramos de Poniente?‡Le Chevalier noir de la marche de l\'Ouest ?‡西部荒野的黑骑士？‡西部荒野的黑騎士?',
    nil,
    'Investigue as alegações do Cavaleiro Negro e informe as descobertas que fizer à Cruzada Rhydalla nos Campos do Torneio Argênteo.‡Узнайте правду о Черном рыцаре и поделитесь информацией с рыцарем Райдаллой на Ристалище Серебряного турнира.‡Überprüft die Angaben des Schwarzen Ritters und kehrt mit den Informationen zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz zurück.‡흑기사의 주장이 사실인지 조사하고 나서, 은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 결과를 알려야 합니다.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Menez une enquête sur les déclarations du Chevalier noir, puis rapportez vos découvertes à la Croisée Rhydalla dans l\'Enceinte du tournoi d\'Argent.‡调查黑骑士的身世是否属实，然后回到银色比武场，向北伐军战士莱达拉汇报你的发现。‡調查黑騎士的說詞，然後帶著你的發現回到銀白聯賽場地去找十字軍萊達菈。',
  }
},
[13634] = {
  {
    'O Cavaleiro Negro de Pinhaprata?‡Черный рыцарь из Серебряного бора?‡Der schwarze Ritter von Silberwald?‡은빛소나무 숲의 흑기사?‡¿El Caballero Negro del Bosque de Argénteos?‡¿El Caballero Negro del Bosque de Argénteos?‡Le Chevalier noir des Pins-Argentés ?‡银松森林的黑骑士？‡銀松的黑騎士?',
    nil,
    'Investigue as alegações do Cavaleiro Negro e informe as descobertas que fizer à Cruzada Rhydalla nos Campos do Torneio Argênteo.‡Узнайте правду о Черном рыцаре и поделитесь информацией с рыцарем Райдаллой на Ристалище Серебряного турнира.‡Überprüft die Angaben des Schwarzen Ritters und kehrt mit den Informationen zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz zurück.‡흑기사의 주장이 사실인지 조사하고 나서, 은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 결과를 알려야 합니다.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Menez une enquête sur les déclarations du Chevalier noir, puis rapportez vos découvertes à la Croisée Rhydalla dans l\'Enceinte du tournoi d\'Argent.‡调查黑骑士的身世是否属实，然后回到银色比武场，向北伐军战士莱达拉汇报你的发现。‡調查黑騎士的說詞，然後帶著你的發現回到銀白聯賽場地去找十字軍萊達菈。',
  }
},
[13635] = {
  {
    'Relatório situacional do Portão Sul‡Отчет Южных врат‡Statusbericht des südlichen Tors‡남부 관문 상황 보고서‡Informe del estado de la Puerta Sur‡Informe del estado de la Puerta Sur‡Rapport sur la porte sud‡南门进度报告‡南門形勢報告',
    nil,
    'Entregue o Relatório Situacional do Piloto Pisafundo para o Capitão Balbúrdia no Vale dos Reis.‡Доставьте отчет пилота Большенога капитану Ругельфассу в Долину Королей.‡Liefert den Statusbericht von Pilot Hammerfuß bei Hauptmann Rugelfuß im Tal der Könige ab.‡조종사 해머풋이 준 남부 관문 상황 보고서를 왕의 계곡에 있는 경비대장 루겔퍼스에게 전달해야 합니다.‡Entrega el Informe de estado del piloto Podomartillo al capitán Rugelfuss en el Valle de los Reyes.‡Entrega el Informe de estado del piloto Podomartillo al capitán Rugelfuss en el Valle de los Reyes.‡Remettez le Rapport de situation du pilote Martèlepied au Capitaine Rudagite, dans la Vallée des Rois.‡将驾驶员塞克·锤足的进度报告交给国王谷的拉格弗斯上尉。‡把駕駛員塞克·錘足的形勢報告送去國王谷給拉格弗斯上尉。',
  }
},
[13636] = {
  {
    'Ordens dos Lançatroz‡Заказы для Грозовой Вершины‡Befehle für Sturmlanze‡스톰파이크의 명령서‡Órdenes Pico Tormenta‡Órdenes Pico Tormenta‡Les ordres des Foudrepiques‡雷矛的命令‡雷矛的命令',
    nil,
    'Entregue as Ordens de Lançatroz para o Montanhista Lançatroz na Estação Algaz.‡Доставьте заказы для Грозовой Вершины горному пехотинцу Грозовой Вершине на станцию Альгаз.‡Bringt die Befehle für Sturmlanze zu Gebirgsjäger Sturmlanze in der Station Algaz.‡스톰파이크의 명령서를 알가즈 주둔지에 있는 산악경비대 스톰파이크에게 가져가야 합니다.‡Entrega las órdenes de Pico Tormenta al Montaraz Pico Tormenta en la Estación de Algaz.‡Entrega las órdenes de Pico Tormenta al Montaraz Pico Tormenta en la Estación de Algaz.‡Remettez les Ordres des Foudrepiques au Montagnard foudrepique, au Poste d’Algaz.‡将雷矛的命令送交给奥加兹岗哨的巡山人雷矛。‡將雷矛的命令帶給奧加茲崗哨哨站的巡山人雷矛。',
  }
},
[13637] = {
  {
    'Ram Delivery‡Доставка барана‡Widdertransport‡산양 전달하기‡Ram Delivery‡Ram Delivery‡Livraison de béliers‡Ram Delivery‡運送山羊',
    nil,
    nil,
  }
},
[13638] = {
  {
    'O montanhista capturado‡Плененный горный пехотинец‡Der gefangene Gebirgsjäger‡생포된 산악경비대원‡El montaraz capturado‡El montaraz capturado‡Le montagnard capturé‡被抓走的巡山人‡被俘虜的巡山人',
    nil,
    'O Capitão Balbúrdia, de Thelsamar, quer que você encontre o Montanhista Cascalhaça.‡Капитан Ругельфасс в Телсамаре просит вас отыскать горного пехотинца Булыжного Карьера.‡Hauptamnn Rugelfuß in Thelsamar möchte, dass Ihr den Gebirgsjäger Kieselwut findet.‡텔사마에 있는 경비대장 루겔퍼스가 산악경비대 그래블고를 찾아달라고 했습니다.‡El Capitán Regulfuss de Thelsamar quiere que localices al Montaraz Gravelgau.‡El Capitán Regulfuss de Thelsamar quiere que localices al Montaraz Gravelgau.‡Le Capitaine Rudagite, à Thelsamar, veut que vous retrouviez le Montagnard Gravegalle.‡塞尔萨玛的拉格弗斯上尉要你找到巡山人格拉维戈。‡塞爾薩瑪的拉格弗斯上尉要你找出巡山人格拉維戈。',
  }
},
[13639] = {
  {
    'Suprimentos para a escavação‡Снабжение экспедиции‡Nachschub für die Ausgrabungsstätte‡물자 공급 재개‡Aprovisionar la excavación‡Aprovisionar la excavación‡Approvisionnement du site de fouilles‡补给挖掘场‡挖掘場補給',
    nil,
    'Encontre Huldar, Miran e Saean.‡Найдите Хальдара, Мирана и Сайана.‡Findet Huldar, Miran und Saean.‡훌다르와 미란, 그리고 사옌을 찾아야 합니다.‡Localiza a Huldar, a Miran y a Saean.‡Localiza a Huldar, a Miran y a Saean.‡Trouvez Huldar, Miran et Saean.‡找到胡达尔、米兰和赛恩。‡找到胡達爾、米蘭、還有賽恩。',
  }
},
[13640] = {
  {
    'Administração de pessoal‡Руководящий состав‡Managerqualitäten‡물자 관리‡Material de gestión‡Material de gestión‡Gestion des ressources‡资材管理‡張羅材料',
    nil,
    'Convença os Peões Desmoralizados a trabalhar e consiga 5 pilhas de Madeira Recém-cortada.‡Заставьте работать несобранных батраков и соберите 5 вязанок свежесрубленного леса.‡Überzeugt demoralisierte Peons, wieder an die Arbeit zu gehen und 5 Stück frisch gespaltenes Holz zu sammeln.‡사기 꺾인 일꾼들을 설득해 갓 벤 나무 5묶음을 모으게 해야 합니다.‡Convence a los peones desmoralizados para que trabajen y recojan 5 fardos de madera recién cortada.‡Convence a los peones desmoralizados para que trabajen y recojan 5 fardos de madera recién cortada.‡Convainquez des Péons démoralisés de se remettre au travail et de rassembler 5 fagots de Bois fraîchement coupé.‡说服垂头丧气的苦工们开工，收集5捆刚切下的木头。‡說服士氣低落的苦工們去工作並且收集5捆剛劈下的木頭。',
  }
},
[13641] = {
  {
    'O cristal do vidente‡Кристалл провидца‡Der Seherkristall‡예언자의 수정‡El cristal de vidente‡El cristal de vidente‡Le cristal de voyant‡先知的水晶‡先知水晶',
    nil,
    'Leve um Cristal do Vidente à Cruzada Rhydalla nos Campos do Torneio Argênteo.‡Принесите кристалл провидца рыцарю Райдалле в Серебряный павильон на Ристалище Серебряного турнира.‡Bringt einen Seherkristall zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 예언자의 수정을 가져가야 합니다.‡Llévale un cristal de vidente a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Llévale un cristal de vidente a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Apportez un Cristal de voyant à la Croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent.‡将一块先知的水晶交给银色比武场的北伐军战士莱达拉。‡把先知水晶帶給銀白聯賽場地的十字軍萊達菈。',
  }
},
[13642] = {
  {
    'Banho de lua‡Свет Элуны‡In Licht getaucht‡엘룬의 빛‡Bañado en luz‡Bañado en luz‡Bain de lumière‡沐浴在月光中‡沐光而生',
    nil,
    'Crie uma Concocção Banhada.‡Создайте Омытое светом зелье.‡Stellt ein eingetauchtes Gebräu her.‡빛이 깃든 혼합물을 만들어야 합니다.‡Crea un brebaje sumergido.‡Crea un brebaje sumergido.‡Créez une Décoction baignée de lumière.‡制作一瓶经过浸泡的药剂。‡創造浸泡完的藥劑。',
  }
},
[13643] = {
  {
    'Gente morta conta histórias‡История погибших‡Die Geschichten toter Männer‡죽은 자의 이야기‡Historias que cuentan los muertos‡Historias que cuentan los muertos‡Ce dont les morts peuvent parler‡死者讲述的故事‡死者的故事',
    nil,
    'Use o Cristal do Vidente nos túmulos de Sir Wendell Balfour, Lorien Ardessol e Conall Garraferro para descobrir como eles morreram e depois fale novamente com a Cruzada Rhydalla.‡Воспользуйтесь кристаллом провидца перед могилами сэра Венделла Балфура, Лориена Блеска Солнца и Коналла Железной Хватки, узнайте причину их гибели и доложите рыцарю Райдалле из Серебряного павильона.‡Benutzt den Seherkristall an den Gräbern von Sir Wendell Balfour, Lorien Sonnenfeuer und Conall Eisengriff, um herauszufinden, wie sie gestorben sind, und kehrt anschließend zu Kreuzfahrerin Rhydalla zurück.‡웬델 발포어 경, 로리엔 선블레이즈, 코날 아이언그립의 무덤에서 예언자의 수정을 사용해 그들이 어떻게 죽었는지 알아보고 나서, 성전사 라이달라에게 가야 합니다.‡Usa el cristal de vidente en las tumbas de Sir Wendell Balfour, Lorien Resplandor y Conall Empuñadura de Hierro para determinar la causa de su muerte, luego vuelve a ver a la cruzada Rhydalla.‡Usa el cristal de vidente en las tumbas de Sir Wendell Balfour, Lorien Resplandor y Conall Empuñadura de Hierro para determinar la causa de su muerte, luego vuelve a ver a la cruzada Rhydalla.‡Utilisez le Cristal de voyant devant les Tombes de Sire Wendell Balfour, Lorien Solembrase et Connall Poigne-de-fer afin de comprendre comment ils sont morts, puis retournez voir la Croisée Rhydalla.‡在温德尔·巴尔弗爵士、洛林·阳焰和康纳尔·铁拳的坟墓前使用先知的水晶，查出他们死亡的真相，然后将结果报告给北伐军战士莱达拉。‡在溫德爾·貝爾弗爵士、洛瑞安·日炎和康歐·鐵握的墳墓前使用先知水晶，找出他們的死因，然後向十字軍萊達菈回報。',
  }
},
[13644] = {
  {
    'Cortando o mal pela raiz‡Тот, кто был воскрешен‡Aus den Tiefen‡땅밑에서 솟아오르는 촉수‡Los que se han levantado‡Los que se han levantado‡Tuer le messager‡地底来客‡從地心竄出',
    nil,
    'Mate o Precursor Afótico.‡Убейте предвестника Афотика.‡Tötet Bote Aphotic.‡선구자 에이포틱을 처치해야 합니다.‡Mata al presagista Aphotic.‡Mata al presagista Aphotic.‡Tuez le Messager Aphotic.‡杀死预言者阿伏提克。‡殺死先驅者厄佛提克。',
  }
},
[13645] = {
  {
    'Para Raene Correlobos‡К Раэне Волкопас‡Zu Raene Wolfsläufer‡레이네 울프러너에게로‡A Raene Correlobo‡A Raene Correlobo‡Raene Mène-loup‡给莱恩·狼行者‡會見萊恩·狼行者',
    nil,
    'Entregue a Gema Faiscante para Raene Correlobos em Astranaar, no Vale Gris.‡Отнесите светящийся самоцвет Раэне Волкопас в Астранаар, что в Ясеневом лесу.‡Überbringt den leuchtenden Edelstein an Raene Wolfsläufer in Astranaar im Eschental.‡빛나는 보석을 잿빛 골짜기의 아스트라나르에 있는 레이네 울프러너에게 가져가야 합니다.‡Lleva la gema resplandeciente a Raene Correlobo en Astranaar, Vallefresno.‡Lleva la gema resplandeciente a Raene Correlobo en Astranaar, Vallefresno.‡Apportez la Gemme luminescente à Raene Mène-loup, à Astranaar, en Orneval.‡将发光的宝石交给灰谷阿斯特兰纳的莱恩·狼行者。‡將發光的寶石帶去梣谷的阿斯特蘭納給萊恩·狼行者。',
  }
},
[13646] = {
  {
    'Destino: Astranaar‡Связь с Астранааром‡Auf einen Sprung nach Astranaar‡아스트라나르 경계로‡Ligado a Astranaar‡Ligado a Astranaar‡Destination Astranaar‡姐妹情深‡阿斯特蘭納',
    nil,
    'Fale com a Sentinela Luara em Astranaar, que fica no Vale Gris.‡Поговорите с часовым Луарой в Астранааре, что в Ясеневом лесу.‡Sprecht mit Schildwache Luara in Astranaar im Eschental.‡잿빛 골짜기의 아스트라나르에서 파수꾼 루아라와 대화해야 합니다.‡Habla con la centinela Luara en Astranaar en Vallefresno.‡Habla con la centinela Luara en Astranaar en Vallefresno.‡Allez voir la Sentinelle Luara à Astranaar, en Orneval.‡跟灰谷阿斯特兰纳的哨兵露亚娜谈一谈。‡到梣谷裡的阿斯特蘭納和哨兵露兒拉說話。',
  }
},
[13647] = {
  {
    'Junte-se aos bons‡Присоединение к охоте‡Jagdanschluss‡사냥의 시작‡Únete a la cacería‡Únete a la cacería‡Bienvenue chez les chasseurs‡参加狩猎‡加入獵殺',
    nil,
    'Fale com Marek Ferrocordis no Pavilhão dos Andarilhos.‡Поговорите с Мареком Железносердом в Приюте Странников.‡Sprecht mit Marek Eisenherz bei der Jagdhütte der Weltenwanderer.‡원정순찰대 오두막에 있는 마렉 아이언하트와 대화해야 합니다.‡Habla con Marek Coracero en la Cabaña del Errante.‡Habla con Marek Coracero en la Cabaña de los Errantes.‡Parlez à Marek Cœur-de-fer au Pavillon des Pérégrins.‡跟旅行者营地的马雷克·铁心谈一谈。‡與遠行者小屋的馬雷克·鐵心交談。',
  }
},
[13648] = {
  {
    'PROCURA-SE: espião dos Ferro Negro‡РАЗЫСКИВАЕТСЯ: шпион Черного Железа‡GESUCHT: Der Spion der Dunkeleisenzwerge‡현상 수배: 검은무쇠 첩자‡SE BUSCA: El espía Hierro Negro‡SE BUSCA: El espía Hierro Negro‡AVIS DE RECHERCHE : l\'espion Sombrefer‡通缉：黑铁间谍‡懸賞:黑鐵間諜',
    nil,
    'Mate Golick Virachope.‡Убейте Горика Пивохлеба.‡Tötet Gorick Fassschlucker.‡첩자 고릭 거즐드래프트를 처치해야 합니다.‡Mata a Gorick Agriojarabe.‡Mata a Gorick Agriojarabe.‡Tuez Gorick Siffle-breuvage.‡击败葛瑞克·豪饮。‡殺死戈利克·暴飲。',
  }
},
[13649] = {
  {
    'Justin\'s Fun Test‡Веселая проверка Джастина‡Justins spaßiger Test‡저스틴의 즐거운 테스트‡La prueba de la diversión de Justin‡Justin\'s Fun Test‡Le test marrant de Justin‡Justin\'s Fun Test‡賈斯汀的趣味測試',
    nil,
    'Use the Complimentary Brewfest Sampler to hit S.T.O.U.T. 5 times, then talk to Boxey Boltspinner.‡Попадите кружкой с бесплатным пивом в С.С.М. 5 раз, затем поговорите с Бокси Болтокрутом.‡Benutzt den Freibierkrug, um A.L.K. fünfmal zu treffen, und sprecht dann mit Boxey Bolzdreher.‡시음용 가을 축제 맥주를 사용하여 주.정.뱅.이.를 5번 맞힌 후 복시 볼트스피너와 대화해야 합니다.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utilisez le Taste-bière cadeau pour toucher la C.E.R.V.O.I.S.E. 5 fois, puis revenez parler à Boxey Tournécrou.‡Use the Complimentary Brewfest Sampler to hit S.T.O.U.T. 5 times, then talk to Boxey Boltspinner.‡使用免費招待的啤酒節樣品並丟中S.T.O.U.T.5次，然後和博克西·栓旋者談談。',
  }
},
[13650] = {
  {
    'Tire as mãos desse artefato!‡Руки прочь от имущества!‡Hände weg von unseren Gütern!‡유물 조사‡¡Esas manos lejos de las mercancías!‡¡Esas manos lejos de las mercancías!‡Pas touche à la marchandise !‡把你的脏手拿开！‡把你的手拿開!',
    nil,
    'Inspecione o Gigante Tombado, a Mulher Deselegante e a Tabuleta Partida.‡Проверьте состояние следующих артефактов: опрокинутого великана, нарядной женщины и разбитой скрижали.‡Untersucht das Artefakt des umgestürzten Riesen, das Artefakt der übertrieben gekleideten Frau und das Artefakt der zerbrochenen Schrifttafel.‡거꾸로 묻힌 거인, 곱게 치장한 여인, 부서진 서판 유물이 무사한지 확인해야 합니다.‡Inspecciona los artefactos del Gigante del revés, la Mujer demasiado vestida y la Tablilla rota.‡Inspecciona los artefactos del Gigante del revés, la Mujer demasiado vestida y la Tablilla rota.‡Inspectez les Artéfacts du Géant renversé, de la Femme lourdement vêtue et de la Tablette brisée.‡检查颠倒的巨人、盛装的妇女，以及破碎的石板神器。‡檢查翻轉的巨人像神器，過度打扮的女子神器，和破裂的石板神器。',
  }
},
[13651] = {
  {
    'Requer um pouco de óleo‡Надо немного смазки‡Braucht bisschen Öl‡기름이 필요해‡Necesita algo de aceite‡Les falta aceite‡De l’huile de coude‡需要加点油‡需要一點油',
    nil,
    'Gorka, no Campo de Trabalho Brado Guerreiro, quer que você junte 5 porções de Óleo Natural dos Viscos Putrefatos no Vale Gris.‡Горка из рабочего лагеря Песни Войны просит вас собрать 5 порций слизи в Ясеневом лесу.‡Gorka im Lager des Kriegshymnenklans möchte, dass Ihr 5 natürliche Öle von den faulenden Schleimen im Eschental sammelt.‡잿빛 골짜기의 전쟁노래 노동기지에 있는 고르카가 썩어가는 진흙괴물로부터 천연 기름 5개를 가져다 달라고 했습니다.‡Gorka, en el Campo de trabajos forzados Grito de Guerra, quiere que recojas 5 aceites naturales de las babosas en podredumbre de Vallefresno.‡Gorka, en el Campo de trabajos forzados Grito de Guerra, quiere que recojas 5 aceites naturales de las babosas en podredumbre de Vallefresno.‡Gorka, du Camp de travail chanteguerre, vous a demandé de récupérer 5 extraits d’Huile naturelle sur les Gelées pourrissantes d’Orneval.‡战歌劳工营地的戈尔卡要你从腐烂的泥浆怪身上获得5份自然之油。‡戰歌勞工營地的戈爾卡希望你從梣谷的腐爛泥漿怪那裡收集5份自然之油。',
  }
},
[13652] = {
  {
    'Em defesa do Dique Lapidado‡Защита Каменной Плотины‡Verteidigung des Steinwerkdamms‡돌다지 댐 수비‡Defensa de la Presa de las Tres Cabezas‡Defensa de la Presa de las Tres Cabezas‡La défense du barrage de Formepierre‡巨石水坝防御战‡防守巨石水壩',
    nil,
    'Procure o Engenheiro-chefe Vedaçude VII no Dique Lapidado.‡Найдите главного инженера Плотиннера VII на Каменной Плотине.‡Sucht Chefingenieur Hinderweir VII am Steinwerkdamm.‡돌다지 댐에서 선임기술자 힌더바이르 7세를 찾아야 합니다.‡Busca al ingeniero jefe Hinderweir VII en la Presa de las Tres Cabezas.‡Busca al ingeniero jefe Hinderweir VII en la Presa de las Tres Cabezas.‡Cherchez l\'Ingénieur en chef Hinderweir VII au Barrage de Formepierre.‡去找巨石水坝的主工程师辛德维尔七世。‡在巨石水壩找到首席工程師辛德維爾七世。',
  }
},
[13653] = {
  {
    'Crise em Machadada‡Кризис на заставе‡Krise am Splitterholzposten‡토막나무 주둔지의 위기‡Crisis en El Hachazo‡Crisis en El Hachazo‡Crise à Bois-Brisé‡碎木的危机‡碎木的危機',
    nil,
    'Gorka quer que você vá com ela até a Paliçada Mor\'shan e apresente-se a Kadrak.|n|nFale com ela quando estiver pronto para partir.‡Горка просит вас сопроводить ее к заставе Мор\'шан и отчитаться перед Кадраком.|n|nОкликните ее, когда вы будете готовы отправиться в путь.‡Gorka will, dass Ihr sie zum Schutzwall von Mor’shan begleitet und Euch bei Kadrak meldet.|n|nSprecht mit Ihr, wenn Ihr bereit zur Abreise seid.‡고르카가 몰샨의 망루까지 동행해 카드라크에게 보고해 달라고 했습니다.|n|n출발할 준비가 되면 고르카와 대화해야 합니다.‡Gorka quiere que la acompañes hasta la Empalizada de Mor\'shan a informar a Kadrak.|n|nHabla con ella cuando estés listo para partir.‡Gorka quiere que la acompañes hasta la Empalizada de Mor\'shan a informar a Kadrak.|n|nHabla con ella cuando estés listo para partir.‡Gorka vous demande de l\'accompagner au Rempart de Mor\'shan et de faire votre rapport à Kadrak.|n|nAllez la voir quand vous serez prêt à partir.‡戈尔卡要你陪她前往莫尔杉农场去找卡德拉克。|n|n准备好出发的话就跟她谈一谈。‡戈爾卡要你和她一起前往莫爾杉壁壘並且向卡德拉克報告。|n|n當你準備好出發時和她進行交談。',
  }
},
[13654] = {
  {
    'Há algo de errado com o escudeiro‡Странный оруженосец‡Etwas ist mit dem Knappen‡흑기사의 종자에겐 뭔가 특별한 것이 있다‡Algo pasa con el escudero‡Algo pasa con el escudero‡Le manège de l\'écuyer‡怪异的侍从‡侍從的秘密',
    nil,
    'Obtenha um Fêmur Grande de um Lenhador Descarnado e use-o para incapacitar Maloric. Reviste Maloric em busca de evidências e depois fale novamente com a Cruzada Rhydalla nos Campos do Torneio Argênteo.‡Добудьте большую бедренную кость дровосека-скелета и оглушите Малорика. Обыщите его и доложите обо всем рыцарю Райдалле из Серебряного павильона на Ристалище Серебряного турнира.‡Beschafft einen großen Oberschenkelknochen eines skelettierten Holzfällers und setzt damit Maloric außer Gefecht. Durchsucht ihn nach Beweisen und meldet Euch anschließend bei Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡해골 벌목꾼에게서 큰 다리뼈를 획득해 말로릭에게 사용해야 합니다. 말로릭을 조사해 증거를 찾아낸 후, 은빛십자군 마상시합 광장의 성전사 라이달라에게 보고해야 합니다.‡Consigue un fémur grande de un cortador de leña esquelético y úsalo para incapacitar a Maloric. Registra a Maloric en busca de pruebas, luego preséntate ante la cruzada Rhydalla en los Campos del Torneo Argenta.‡Consigue un fémur grande de un cortador de leña esquelético y úsalo para incapacitar a Maloric. Registra a Maloric en busca de pruebas, luego preséntate ante la cruzada Rhydalla en los Campos del Torneo Argenta.‡Procurez-vous un Grand fémur sur un Bûcheron squelettique, et utilisez-le pour assommer Maloric. Fouillez Maloric pour trouver des preuves, puis retournez faire votre rapport à la Croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent.‡从一个骷髅伐木工身上取下一根大腿骨，用它打昏玛洛里克。在玛洛里克身上搜查一番，找到证据后向银色比武场的北伐军战士莱达拉报告。‡從骷髏樵夫身上拿一根大型腿骨，用它敲昏瑪洛瑞克。從瑪洛瑞克身上搜尋證據，然後向銀白聯賽場地的十字軍萊達菈回報。',
  }
},
[13655] = {
  {
    'Documento da Liga dos Exploradores (2 de 6)‡Документ Лиги исследователей (2 из 6)‡Dokument der Forscherliga (2 von 6)‡탐험가 연맹 문서 (6장 중 2장)‡Documento de la Liga de Expedicionarios (2 de 6)‡Documento de la Liga de Expedicionarios (2 de 6)‡Document de la Ligue des explorateurs (2 sur 6)‡探险者协会的文件（2/6）‡探險者協會文件(2-6頁)',
    nil,
    'Devolva o Documento da Liga dos Exploradores para Torren Queixorreto em Thelsamar.‡Верните документ Лиги исследователей Торрену Квадратной Челюсти в Телсамар.‡Bringt das Dokument der Forscherliga zu Torren Querkiefer in Thelsamar.‡탐험가 연맹 문서를 텔사마에 있는 토렌 스퀘어조에게 가져가야 합니다.‡Devuelve el documento de la Liga de Expedicionarios a Torren Mandicuadrada en Thelsamar.‡Devuelve el documento de la Liga de Expedicionarios a Torren Mandicuadrada en Thelsamar.‡Rapportez le Document de la Ligue des explorateurs à Torren Gueule-carrée à Thelsamar.‡将探险者协会的文件交给塞尔萨玛的托瑞恩·方颔。‡將探險者協會的文件帶回給塞爾薩瑪的托瑞恩·方頷。',
  }
},
[13656] = {
  {
    'Documento da Liga dos Exploradores (1 de 6)‡Документ Лиги исследователей (1 из 6)‡Dokument der Forscherliga (1 von 6)‡탐험가 연맹 문서 (6장 중 1장)‡Documento de la Liga de Expedicionarios (1 de 6)‡Documento de la Liga de Expedicionarios (1 de 6)‡Document de la Ligue des explorateurs (1 sur 6)‡探险者协会的文件（1/6）‡探險者協會文件(1-6頁)',
    nil,
    'Devolva o Documento da Liga dos Exploradores para Torren Queixorreto em Thelsamar.‡Верните документ Лиги исследователей Торрену Квадратной Челюсти в Телсамар.‡Bringt das Dokument der Forscherliga zu Torren Querkiefer in Thelsamar.‡탐험가 연맹 문서를 텔사마에 있는 토렌 스퀘어조에게 가져가야 합니다.‡Devuelve el documento de la Liga de Expedicionarios a Torren Mandicuadrada en Thelsamar.‡Devuelve el documento de la Liga de Expedicionarios a Torren Mandicuadrada en Thelsamar.‡Rapportez le Document de la Ligue des explorateurs à Torren Gueule-carrée à Thelsamar.‡将探险者协会的文件交给塞尔萨玛的托瑞恩·方颔。‡將探險者協會的文件帶回給塞爾薩瑪的托瑞恩·方頷。',
  }
