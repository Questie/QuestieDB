[78225] = {
  {
    'Para Nortúndria‡В Нордскол‡Nach Nordend‡노스렌드로‡A Rasganorte‡A Rasganorte‡En route pour le Norfendre‡前往诺森德‡前往北裂境',
    nil,
    'Use o pergaminho de teleporte do seu inventário para chegar a Nortúndria e falar com a Imagem do Arquimago Aethas Fendessol.‡Воспользуйтесь свитком из вашей сумки, чтобы телепортироваться в Нордскол, и поговорите с проекцией верховного мага Этаса Похитителя Солнца.‡Benutzt eine Schriftrolle der Teleportation aus Eurem Inventar, um Nordend zu erreichen, und sprecht dort mit dem Abbild des Erzmagiers Aethas Sonnenhäscher.‡가방에서 새로운 순간이동 두루마리를 꺼내 노스렌드로 가서 대마법사 에이타스 선리버의 환영과 대화해야 합니다.‡Usa el pergamino de teletransporte de tu inventario para llegar a Rasganorte y habla con la imagen del archimago Aethas Atracasol.‡Usa el pergamino de teletransportación de tu inventario para llegar a Rasganorte y habla con la imagen del archimago Aethas Atracasol.‡Utilisez le parchemin de téléportation dans votre inventaire pour atteindre le Norfendre et parler à l’image de l’archimage Aethas Saccage-Soleil‡使用你的物品栏里的一个传送卷轴前往诺森德，然后与大法师艾萨斯·夺日者的影像交谈。‡使用物品欄裡的傳送卷軸前往北裂境與大法師埃薩‧奪日者的影像交談。',
  }
},
[82948] = {
  {
    'Mural do Chamado ao Heroísmo‡Доска объявлений для героев‡Heldenruftafel‡영웅의 부름 게시판‡Tablero de ¡Se busca héroe!‡Tablero de ¡Se busca héroe!‡Tableau de l’appel des héros‡英雄的召唤布告牌‡英雄公告板',
    nil,
    'Vá para o Distrito Comercial de Ventobravo e fale com Melris Malagan.‡Отправляйтесь в Торговый квартал Штормграда и поговорите с Мерлисом Малаганом.‡Begebt Euch in den Handelsdistrikt in Sturmwind und sprecht mit Melris Malagan.‡스톰윈드 상업 지구로 가서 멜리스 말라간과 대화해야 합니다.‡Dirígete al Distrito de Mercaderes en Ventormenta y habla con Melris Malagan.‡Ve al Distrito de Mercaderes en Ventormenta y habla con Melris Malagan.‡Rendez-vous au quartier commerçant de Hurlevent et parlez à Melris Malagan.‡前往暴风城的贸易区，与梅里斯·玛拉甘交谈。‡前往暴風城的貿易區，與梅里斯‧瑪拉甘交談。',
  }
},
[82949] = {
  {
    'Mural de Ordens do Chefe Guerreiro‡Доска приказов вождя‡Befehlstafel des Kriegshäuptlings‡대족장의 명령 게시판‡Tablón de mando del Jefe de Guerra‡Tablón de mando del Jefe de Guerra‡Tableau de commandement du chef de guerre‡大酋长的命令布告板‡大酋長公告板',
    nil,
    'Vá até o Vale da Força de Orgrimmar e fale com o Arauto do Chefe Guerreiro.‡Отправляйтесь в Аллею Силы в Оргриммаре и поговорите с глашатаем вождя.‡Begebt Euch ins Tal der Stärke in Orgrimmar und sprecht mit dem Herold des Kriegshäuptlings.‡오그리마 힘의 골짜기로 가서 대족장의 전령과 대화해야 합니다.‡Dirígete al Valle de la Fuerza en Orgrimmar y habla con el heraldo del Jefe de Guerra.‡Ve al Valle de la Fuerza en Orgrimmar y habla con el heraldo del Jefe de Guerra.‡Rendez-vous dans la vallée de la Force à Orgrimmar et parlez au héraut du chef de guerre.‡前往奥格瑞玛的力量谷，与大酋长的使者交谈。‡前往奧格瑪的力量谷，與大酋長的使者交談。',
  }
},
[82981] = {
  {
    'Talento é para quem tem‡Талантливый герой‡Talentiert‡특성‡‡Talentoso‡Quel talent !‡天赋异禀‡天賦異稟',
    nil,
    'Ative a interface de Talentos e atribua 5 Pontos de Talento.‡Откройте интерфейс талантов и распределите 5 очков талантов.‡Öffnet das Talentfenster und verteilt 5 Talentpunkte.‡특성 창을 열고 특성 포인트 5점을 분배해야 합니다.‡‡Activa la interfaz de talentos y asigna 5 puntos de talento.‡Activez l’interface des talents et dépensez 5 points de talent.‡打开天赋界面并分配五个天赋点数。‡打開天賦介面，使用5個天賦點數。',
  }
},
[82983] = {
  {
    'Mural do Chamado ao Heroísmo‡Доска объявлений для героев‡Heldenruftafel‡영웅의 부름 게시판‡‡Tablero de ¡Se busca héroe!‡Tableau de l’appel des héros‡英雄的召唤布告牌‡英雄公告板',
    nil,
    'Use o pergaminho de teleporte do seu inventário para chegar a Ventobravo e falar com Melris Malagan.‡Воспользуйтесь свитком телепортации из сумки, чтобы переместиться в Штормград, и поговорите с Мерлисом Малаганом.‡Nutzt eine Schriftrolle der Teleportation aus Eurem Inventar, um Sturmwind zu erreichen, und sprecht dort mit Melris Malagan.‡가방에서 새로운 순간이동 두루마리를 꺼내 스톰윈드로 가서 멜리스 말라간과 대화해야 합니다.‡‡Usa el pergamino de teletransportación de tu inventario para llegar a la Ciudad de Ventormenta y habla con Melris Malagan.‡Utilisez le parchemin de téléportation dans votre inventaire pour atteindre Hurlevent et parler à Melris Malagan.‡使用你的物品栏里的传送卷轴前往暴风城，与梅里斯·玛拉甘交谈。‡使用物品欄裡的傳送卷軸前往暴風城與梅里斯‧瑪拉甘交談。',
  }
},
[82984] = {
  {
