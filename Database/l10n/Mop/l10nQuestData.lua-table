},
[1795] = {
  {
    '‡Оковы‡Die Bindung‡균열 봉합‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    '‡Призовите и одолейте охотника скверны при помощи фолианта заговора и верните фолиант Страхаду Фарсану из Кабестана.‡Beschwört mithilfe des \'Folianten der Kabale\' einen Teufelsjäger, unterwerft ihn und bringt den \'Folianten der Kabale\' zu Strahad Farsan in Ratschet zurück.‡‡Mediante el libro del conciliábulo invoca y subyuga a un manáfago y luego devuélvele el Libro del Conciliábulo a Strahad Farsan en Trinquete.‡Mediante el libro del conciliábulo invoca y subyuga a un manáfago y luego devuélvele el Libro del Conciliábulo a Strahad Farsan en Trinquete.‡Utiliser le Tome de la Cabale pour invoquer et soumettre un Chasseur corrompu, puis rapporter le Tome de la Cabale à Strahad Farsan, à Cabestan.‡召唤地狱猎犬并打败它，然后把阴谋之书交给棘齿城的斯坦哈德·法尔杉。‡',
  }
},
[1796] = {
  {
    'Componentes para um Robessangre Dourado Encantado‡Материалы для зачарованного золотого кровавого одеяния‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡附魔金線血袍',
    nil,
    'Leve Vestes de Arcana para Menara Nihila nos Sertões.‡Принесите одеяния Тайны Менаре Расщепительнице Бездны в Степи.‡Bringt die Roben von Arcana zu Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더에게 아카나의 로브를 가져가야 합니다.‡Llévale las togas de Arcana a Menara Nadiz en Los Baldíos.‡Llévale las togas de Arcana a Menara Nadiz en Los Baldíos.‡Apporter une Robe d\'Arcana à Menara Taillevide, dans les Tarides.‡将奥法之袍交给贫瘠之地的梅纳拉·沃伦德。‡將秘法之袍交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[1798] = {
  {
    'Procurando Strahad‡На поиски Страхада‡Die Suche nach Strahad‡스트라드를 찾아서‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Fale com Strahad Farsan nos Sertões.‡Поговорите со Страхадом Фарсаном в Степях.‡Sprecht mit Strahad Farsan im Brachland.‡불모의 땅에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Los Baldíos.‡Habla con Strahad Farsan en Los Baldíos.‡Parler à Strahad Farsan dans les Tarides.‡与贫瘠之地的斯坦哈德·法尔杉谈一谈。‡與貧瘠之地的斯坦哈德·法爾杉談話。',
  }
},
[1799] = {
  {
    'Fragmentos do Orbe de Orahil‡Части шара Орахила‡Fragmente der Kugel von Orahil‡오라힐 보주의 파편‡Los trozos del orbe de Orahil‡Los trozos del orbe de Orahil‡Fragments de l\'Orbe d\'Orahil‡宝珠碎片‡寶珠碎片',
    nil,
    'Fale com os acólitos de Menara dentro da torre acima da Vila Catraca e escolha um caminho a seguir.|n|nDepois, leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Поговорите с послушниками Менары в башне над Кабестаном и изберите свой путь.|n|nПосле этого принесите Табете в Пылевые топи сферу Подземного огня.‡Sprecht mit Menaras Akolythen im Inneren des Turms über Ratschet und wählt einen ihrer Wege, um ihm zu folgen.|n|nBringt danach eine Höllenkugel zu Tabetha in den Düstermarschen.‡톱니항이 내려다보이는 탑 안에 살고 있는 미네라의 조수들과 대화하고 그들이 제시하는 길 중 하나를 따라가야 합니다.|n|n그 후엔 지옥의 보주를 구해 먼지진흙 습지대의 타베사에게 가져가야 합니다.‡Habla con los acólitos de Menara que están en el interior de la torre que domina Trinquete y elige uno de sus caminos para seguirlo.|n|nDespués, llévale un orbe infernal a Tabetha en Marjal Revolcafango.‡Habla con los acólitos de Menara que están en el interior de la torre que domina Trinquete y elige uno de sus caminos para seguirlo.|n|nDespués, llévale un orbe infernal a Tabetha en Marjal Revolcafango.‡Parler aux acolytes de Menara dans la tour qui domine Cabestan et choisir de suivre l\'une de leurs voies.|n|nEnsuite, apporter un Orbe infernal à Tabetha, dans le marécage d\'Âprefange.‡在棘齿城外的塔里与梅纳拉的侍僧们谈话，选择自己修行的方式。|n|n然后给尘泥沼泽的塔贝萨带去一颗地狱火珠。‡在棘齒城外的塔里與梅納拉的侍僧們談話，選擇自己修行的方式。|n|n然後給塵泥沼澤的塔貝薩帶去一顆煉獄火寶珠。',
  }
},
[1800] = {
  {
    'Sala do Trono de Lordaeron‡Тронный зал Лордерона‡Der Thronsaal von Lordaeron‡로데론의 왕실‡Sala del Trono de Lordaeron‡Sala del Trono de Lordaeron‡La salle du trône de Lordaeron‡洛丹伦的王座‡羅德隆的王座廳',
    nil,
    'Leve o seu protegido para a antiga Sala do Trono de Lordaeron, que fica logo antes da entrada subterrânea para a Cidade Baixa.‡Отведите своего подопечного в старый тронный зал Лордерона, который находится как раз у входа в Подгород.‡Besucht mit Eurem Schützling den alten Thronsaal in Lordaeron. Er befindet sich kurz vor dem Abgang nach Unterstadt.‡언더시티로 내려가기 바로 전에 있는 고대 로데론의 왕실로 돌보고 있는 고아를 데려가야 합니다.‡Lleva a tu pupilo a la antigua Sala del Trono de Lordaeron. La encontrarás justo antes de llegar al acceso a Entrañas.|n‡Lleva a tu pupilo a la antigua Sala del Trono de Lordaeron. La encontrarás justo antes de llegar al acceso a Entrañas.|n‡Emmenez votre protégé à la vieille salle du trône de Lordaeron, qui se trouve juste avant l\'endroit où il faut descendre pour aller à Fossoyeuse.‡带着你看护的孤儿去幽暗城升降梯外的王座大厅。‡帶著你看護的孤兒去幽暗城升降梯外的王座廳。',
  }
},
[1801] = {
  {
    'Tomo do Conluio‡Фолиант заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Fale com Jonas Anísio na Cidade Baixa.‡Поговорите с Джорахом Аннисоном в Подгороде.‡Sprecht mit Jorah Annison in Unterstadt.‡언더시티에 있는 조라 애니슨과 대화해야 합니다.‡Habla con Jorah Annison en Entrañas.‡Habla con Jorah Annison en Entrañas.‡Parler à Jorah Annison à Fossoyeuse.‡和幽暗城的约拉·安尼森谈一谈。‡和幽暗城的約拉·安尼森談話。',
  }
},
[1802] = {
  {
    'Tomo do Conluio‡Фолиант заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Recupere o Tomo Mofado e o Manuscrito Rasgado para Krom Braçoforte em Altaforja.‡Добудьте заплесневелый фолиант и потрепанный манускрипт для Крома Крепкорука из Стальгорна.‡Beschafft den schimmeligen Folianten und das zerlumpte Manuskript für Krom Starkarm in Eisenschmiede.‡아이언포지에 있는 크롬 스타우트암을 위해 곰팡이 슨 고서와 너덜너덜한 필사본을 모아야 합니다.‡Lleva el escrito mohoso y el manuscrito andrajoso a Krom Brazorrecio a Forjaz.‡Lleva el escrito mohoso y el manuscrito maltrecho a Krom Brazorrecio a Forjaz.‡Retrouver le Tome moisi et le Manuscrit en lambeaux pour Krom Rudebras à Forgefer.‡为铁炉堡的克罗姆·粗臂找回发霉的书籍和破损的手稿。‡為鐵爐堡的克羅姆·粗臂找回發黴的書籍和破損的手稿。',
  }
},
[1803] = {
  {
    'Tomo do Conluio‡Фолиант заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Recupere o Tomo Mofado e o Manuscrito Rasgado para Jonas Anísio na Cidade Baixa.‡Отыщите заплесневелый фолиант и потрепанный манускрипт для Йораха Аннисона из Подгорода.‡Beschafft den schimmeligen Folianten und das zerlumpte Manuskript für Jorah Annison in Unterstadt.‡언더시티에 있는 조라 애니슨을 위해 곰팡이 슨 고서와 너덜너덜한 필사본을 모아야 합니다.‡Recupera el escrito mohoso y el manuscrito andrajoso para Jorah Annison de Entrañas.‡Recupera el escrito mohoso y el manuscrito andrajoso para Jorah Annison de Entrañas.‡Retrouver le Tome moisi et le Manuscrit en lambeaux pour Jorah Annison à Fossoyeuse.‡给幽暗城的约拉·安尼森带回发霉的书籍和破损的手稿。‡給幽暗城的約拉·安尼森帶回發黴的書籍和破損的手稿。',
  }
},
[1804] = {
  {
    'Tomo do Conluio‡Фолиант заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Leve o Tomo Reformado e 3 Bastões de Canalização para Strahad Farsan na Vila Catraca.‡Принесите восстановленный фолиант и три жезла направления Страхаду Фарсану в Кабестан.‡Bringt den rekonstruierten Folianten und 3 Kanalisierungsruten zu Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선에게 복원된 고서와 정신 집중의 마법봉 3개를 가져가야 합니다.‡Lleva el escrito reconstruido y 3 varas de mediación a Strahad Farsan a Trinquete.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Apporter le Tome recomposé et 3 Bâtonnets de canalisation à Strahad Farsan à Cabestan.‡将翻修过的书籍和3根导能魔棒交给棘齿城的斯坦哈德·法尔杉。‡將翻修過的書籍和3根導能魔棒交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1805] = {
  {
    'Tomo do Conluio‡Фолиант заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Leve o Tomo Reformado e 3 Bastões de Canalização para Strahad Farsan na Vila Catraca.‡Принесите восстановленный фолиант и три жезла направления Страхаду Фарсану в Кабестан.‡Bringt den rekonstruierten Folianten und 3 Ruten des Kanalisierens zu Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선에게 복원된 고서와 정신 집중의 마법봉 3개를 가져가야 합니다.‡Lleva el escrito reconstruido y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Apportez le Tome reconstitué et 3 Bâtonnet de canalisation à Strahad Farsan, à Cabestan.‡将翻修过的书籍和3根导能魔棒交给棘齿城的斯坦哈德·法尔杉。‡將翻修過的書籍和3根導能魔棒交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1806] = {
  {
    '‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡',
    nil,
    '‡Подождите, пока Джордан Стилвелл не закончит изготовление оружия.‡Wartet, bis Jordan Stillbrunn eine Waffe für Euch geschmiedet hat.‡‡Espera mientras Jordan Fontana te forja un arma.‡Espera mientras Jordan Fontana te forja un arma.‡Attendre que Jordan Morpuits finisse de forger votre arme.‡等待乔丹·斯迪威尔为你铸造武器。‡',
  }
},
[1818] = {
  {
    'Uma conversa com Dinis‡Разговор с Диллинджером‡Gespräch mit Dillinger‡딜링거와의 대화‡Habla con Dillinger‡Habla con Dillinger‡Parler à Dillinger‡迪林格尔‡迪林格爾',
    nil,
    'Fale com o Necroguarda Dinis em Montalvo.‡Поговорите со стражем смерти Диллинджером в Брилле.‡Sprecht mit Todeswache Dillinger in Brill.‡브릴에 있는 죽음경비병 딜링거와 대화해야 합니다.‡Habla con el Guardia de la Muerte Dillinger en Rémol.‡Habla con el Guardia de la Muerte Dillinger en Rémol.‡Parler au Nécrogarde Dillinger à Brill.‡和布瑞尔的亡灵卫兵迪林格尔谈一谈。‡和布瑞爾的亡靈衛兵迪林格爾談話。',
  }
},
[1819] = {
  {
    'Ulag, o Cutelo‡Улаг Колун‡Ulag der Spalter‡학살자 울라그‡Ulag el Cuchilla‡Ulag el Cuchilla‡Ulag le Fendeur‡切割者奥拉格‡『斬擊者』奧拉格',
    nil,
    'Mate Ulag, o Cutelo, depois fale com Necroguarda Dinis.‡Убейте Улага Колуна и поговорите со стражем смерти Диллинджером.‡Tötet Ulag den Spalter und sprecht dann mit Todeswache Dillinger.‡학살자 울라그를 처치한 후 죽음경비병 딜링거와 대화해야 합니다.‡Mata a Ulag el Cuchilla y ve a hablar con el Guardia de la Muerte Dillinger.‡Mata a Ulag el Cuchilla y ve a hablar con el Guardia de la Muerte Dillinger.‡Tuer Ulag le Fendeur, puis parler au Nécrogarde Dillinger.‡杀死切割者奥拉格，然后和亡灵卫兵迪林格尔谈一谈。‡殺死『斬擊者』奧拉格，然後和亡靈衛兵迪林格爾談話。',
  }
},
[1820] = {
  {
    '‡Разговор с Колманом‡Gespräch mit Coleman‡콜만과의 대화‡Habla con Coleman‡Habla con Coleman‡Parler à Coleman‡库勒曼‡',
    nil,
    '‡Поговорите с Колманом Фартингом.‡Sprecht mit Coleman Heller.‡콜만 파딩과 대화해야 합니다.‡Habla con Coleman Farthing.‡Habla con Coleman Farthing.‡Parler à Coleman Farthing.‡和库勒曼·法席恩谈一谈。‡',
  }
},
[1821] = {
  {
    '‡Наследие Агамондов‡Agamand-Erbstücke‡‡Reliquias Agamand‡Reliquias Agamand‡L\'héritage des Agamand‡阿加曼德家传武器‡',
    nil,
    '‡Принесите Колману Фартингу фамильный топор Агамондов, фамильный меч Агамондов, фамильную палицу Агамондов, фамильный кинжал Агамондов.‡Bringt Coleman Heller die Axt, das Schwert, den Streitkolben und den Dolch der Familie Agamand.‡‡Lleva a Coleman Farthing el hacha de la familia Agamand, la espada de la familia Agamand, la maza de la familia Agamand y la daga de la familia Agamand.‡Lleva a Coleman Farthing el hacha de la familia Agamand, la espada de la familia Agamand, la maza de la familia Agamand y la daga de la familia Agamand.‡Rapporter à Coleman Farthing la Hache de la famille Agamand, l\'Épée de la famille Agamand, la Masse de la famille Agamand et la Dague de la famille Agamand.‡把阿加曼德家传长剑、阿加曼德家传战斧、阿加曼德家传钉锤和阿加曼德家传匕首交给库勒曼·法席恩。‡',
  }
},
[1822] = {
  {
    '‡Фамильное оружие‡Erbstückwaffe‡가보 무기‡Arma reliquia‡Arma reliquia‡Une arme en héritage‡祖传武器‡',
    nil,
    nil,
  }
},
[1823] = {
  {
    'Fale com Ruga‡Разговор с Ругой‡Gespräch mit Ruga‡루가와의 대화‡Habla con Ruga‡Habla con Ruga‡Parler à Ruga‡和鲁迦交谈‡和魯迦交談',
    nil,
    'Fale com Ruga Totem da Fúria.‡Поговорите с Ругой Тотемом Ярости.‡Sprecht mit Ruga Rachtotem.‡루가 레이지토템과 대화해야 합니다.‡Habla con Ruga Tótem de Ira.‡Habla con Ruga Tótem de Ira.‡Parler à Ruga Totem-de-rage.‡和鲁迦·暴怒图腾谈一谈。‡和魯迦·狂暴圖騰談話。',
  }
},
[1824] = {
  {
    'Provação no Campo dos Gigantes‡Испытание на Полях Великанов‡Prüfung auf dem Feld der Riesen‡거인의 들판에서의 시험‡Prueba en Tierra de Gigantes‡Prueba en Tierra de Gigantes‡L\'épreuve du Champ des géants‡巨人旷野的试炼‡巨人曠野的試煉',
    nil,
    'Leve 5 antenas tremelicantes para Ruga Totem da Fúria no Acampamento Taurajo‡Принесите 5 дергающихся усиков Руге Тотему Ярости в Лагерь Таурахо.‡Bringt 5 zuckende Fühler zu Ruga Rachtotem im Camp Taurajo.‡타우라조 야영지에 있는 루가 레이지토템에게 꿈틀거리는 더듬이 5개를 가져가야 합니다.‡Lleva 5 antenas agitadas a Ruga Tótem de Ira de Campamento Taurajo.‡Lleva 5 antenas agitadas a Ruga Tótem de Ira de Campamento Taurajo.‡Apporter 5 Antennes mobiles à Ruga Totem-de-rage au Camp Taurajo.‡收集5根颤抖的触角，把它们带给贫瘠之地陶拉祖营地的鲁迦。‡收集5根顫抖的觸角，把它們帶給貧瘠之地陶拉祖營地的魯迦。',
  }
},
[1825] = {
  {
    'Fale com Thun\'grim‡Разговор с Тун\'гримом‡Gespräch mit Thun\'grim‡툰그림과의 대화‡Habla con Thun\'grim‡Habla con Thun\'grim‡Parler à Thun\'grim‡和索恩格瑞姆交谈‡和索恩格瑞姆交談',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화해야 합니다.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Mirefeu dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡與貧瘠之地的索恩格瑞姆·火眼談話。',
  }
},
[1838] = {
  {
    'Armadura brutal‡Доспехи Жестокости‡Brutale Rüstung‡투사의 방어구‡Armadura brutal‡Armadura brutal‡Armure de brutalité‡野蛮护甲‡野蠻護甲',
    nil,
    'Leve para Thun\'grim Olhafogo 15 Lingotes Fumegantes de Ferro, 10 Azuritas Pulverizadas, 10 Barras de Ferro e a Ampola de Flogisto.‡Принесите Тун\'гриму Огневзору 15 закопченных железных слитков, 10 мер толченого азурита, 10 железных слитков и сосуд флогистона.‡Bringt Thun\'grim Brandblick 15 rauchige Eisenblöcke, 10 pulverisierte Azurite, 10 Eisenbarren und 1 Phiole mit Phlogiston.‡툰그림 파이어게이즈에게 연기나는 철제 주괴 15개, 아주라이트 가루 10개, 철 주괴 10개, 연소 약병 1개를 가져가야 합니다.‡Lleva 15 lingotes de hierro humeantes, 10 azuritas en polvo, 10 barras de hierro y un vial de flogisto a Thun\'grim Vistafuego.‡Lleva 15 lingotes de hierro humeantes, 10 azuritas en polvo, 10 barras de hierro y un vial de flogisto a Thun\'grim Vistafuego.‡Apportez à Thun\'grim Mirefeu 15 Lingots de Fer cendré, 10 Azurites en poudre, 10 Barres de Fer et une Fiole de Phlogiston.‡为索恩格瑞姆收集15根烟雾铁锭、10份蓝铜粉、10块铁锭和1瓶燃素。‡為索恩格瑞姆收集15根煙霧鐵錠、10份藍銅粉、10塊鐵錠和1瓶燃素。',
  }
},
[1839] = {
  {
    'Ula\'elek e as Manoplas Brutais‡Ула\'елек и рукавицы Жестокости‡Ula\'elek und die brutalen Stulpen‡울라엘레크와 투사 건틀릿‡Ula\'elek y los guanteletes brutales‡Ula\'elek y los guanteletes brutales‡Ula\'elek et les Gantelets de brutalité‡尤拉莱克和野蛮护手‡尤拉萊克和野蠻護手',
    nil,
    'Fale com Ula\'elek em Durotar.‡Поговорите с Ула\'елеком из Дуротара.‡Sprecht mit Ula\'elek in Durotar.‡듀로타에 있는 울라엘레크와 대화해야 합니다.‡Habla con Ula\'elek en Durotar.‡Habla con Ula\'elek en Durotar.‡Parler à Ula\'elek en Durotar.‡与杜隆塔尔的尤拉莱克谈一谈。‡與杜洛塔的尤拉萊克談話。',
  }
},
[1840] = {
  {
    '‡Орм Каменное Копыто и шлем Жестокости‡Orm Steinhuf und der brutale Helm‡‡Orm Pezuña Pétrea y el yelmo brutal‡Orm Pezuña Pétrea y el yelmo brutal‡Orm Sabot-de-pierre et le Camail de brutalité‡奥姆·石蹄和野蛮头盔‡',
    nil,
    '‡Обратитесь к Орму Каменному Копыту из Громового Утеса.‡Sprecht mit Orm Steinhuf in Donnerfels.‡‡Habla con Orm Pezuña Pétrea en Cima del Trueno.‡Habla con Orm Pezuña Pétrea en Cima del Trueno.‡Parler à Orm Sabot-de-pierre aux Pitons-du-Tonnerre.‡和雷霆崖的奥姆·石蹄谈一谈。‡',
  }
},
[1841] = {
  {
    'Velora Noitile e as Guarda-pernas Brutais‡Велора Нители и набедренники Жестокости‡Velora Nachtens und die brutalen Beinschützer‡벨로라 나이틀리와 투사 다리보호대‡Velora Noctis y las musleras brutal‡Velora Noctis y las musleras brutal‡Velora Nitely et les garde-jambes de brutalité‡维罗拉·奈特雷和野蛮腿甲‡維羅拉·奈特雷和野蠻腿甲',
    nil,
    'Fale com Velora Noitile na Cidade Baixa.‡Поговорите с Велорой Нители из Подгорода.‡Sprecht in Unterstadt mit Velora Nachtens.‡언더시티에 있는 벨로라 나이틀리와 대화해야 합니다.‡Habla con Velora Noctis en Entrañas.‡Habla con Velora Noctis en Entrañas.‡Parler à Velora Nitely à Fossoyeuse.‡与幽暗城的维罗拉·奈特雷谈一谈。‡與幽暗城的維羅拉·奈特雷談話。',
  }
},
[1842] = {
  {
    'Cascos de Sátiro‡Копыта сатиров‡Satyrhufe‡사티로스 발굽‡Pezuñas de sátiro‡Pezuñas de sátiro‡Les sabots de satyre‡萨特之蹄‡薩特之蹄',
    nil,
    'Leve 7 Cascos Não-fendidos de Sátiro para Ula\'elek na Aldeia Sen\'jin, em Durotar.‡Принесите 7 целых копыт сатиров Ула\'елеку в Дуротар, в деревню Сен\'джин.‡Bringt 7 ungespaltene Satyrhufe zu Ula\'elek in Sen\'jin in Durotar.‡듀로타의 센진 마을에 있는 울라엘레크에게 사티로스 통발굽 7개를 가져가야 합니다.‡Lleva 7 pezuñas de sátiro sin rajar a Ula\'elek de Poblado Sen\'jin en Durotar.‡Lleva 7 pezuñas de sátiro sin rajar a Ula\'elek de Poblado Sen\'jin en Durotar.‡Rapporter 7 Sabots fendus de satyre à Ula\'elek au village de Sen\'jin en Durotar.‡收集7只完整的萨特之蹄，把它们交给杜隆塔尔森金村的尤拉莱克。‡收集7隻完整的薩特之蹄，把它們交給杜洛塔森金村的尤拉萊克。',
  }
},
[1843] = {
  {
    '‡Рукавицы Жестокости‡Brutale Stulpen‡투사 건틀릿‡Guanteletes brutales‡Guanteletes brutales‡Gantelets de brutalité‡野蛮护手‡野蠻護手',
    nil,
    nil,
  }
},
[1844] = {
  {
    '‡Рог химеры‡Schimärenhorn‡‡Cuerno de quimera‡Cuerno de quimera‡La corne de chimère‡奇美拉之角‡',
    nil,
    '‡Принести Орму Каменному Копыту из Громового Утеса гальванизированный рог.‡Bringt ein galvanisiertes Horn zu Orm Steinhuf in Donnerfels.‡‡Lleva un cuerno galvanizado a Orm Pezuña Pétrea de Cima del Trueno.‡Lleva un cuerno galvanizado a Orm Pezuña Pétrea de Cima del Trueno.‡Apporter une Corne galvanisée à Orm Sabot-de-Pierre aux Pitons-du-Tonnerre.‡把光滑的奇美拉角交给雷霆崖的奥姆·石蹄。‡',
  }
},
[1845] = {
  {
    '‡Шлем Жестокости‡Brutaler Helm‡투사 투구‡Yelmo brutal‡Yelmo brutal‡Camail de brutalité‡野蛮头盔‡野蠻頭盔',
    nil,
    nil,
  }
},
[1846] = {
  {
    '‡Берцовые кости‡Schienbeinknochen der Drachenmalorcs‡‡Tibias de Faucedraco‡Tibias de Faucedraco‡Les tibias de Gueule-de-dragon‡龙喉胫骨‡',
    nil,
    '‡Принесите 8 крепких берцовых костей Драконьей Пасти Велоре Нители в Подгород.‡Bringt 8 stabile Schienbeinknochen eines Drachenmalorcs zu Velora Nachtens in Unterstadt.‡‡Lleva 8 tibias de Faucedraco robustas a Velora Noctis de Entrañas.‡Lleva 8 tibias de Faucedraco robustas a Velora Noctis de Entrañas.‡Apporter 8 Solides tibias de Gueule-de-dragon à Velora Nitely, à Fossoyeuse.‡给幽暗城的维罗拉·奈特雷带去12根结实的龙喉胫骨。‡',
  }
},
[1847] = {
  {
    '‡Набедренники Жестокости‡Brutale Beinschützer‡투사 다리보호대‡Musleras brutales‡Musleras brutales‡Garde-jambes de brutalité‡野蛮腿甲‡野蠻腿甲',
    nil,
    nil,
  }
},
[1848] = {
  {
    '‡Хауберк жестокости‡Brutale Halsberge‡투사 갑옷‡Camisote brutal‡Camisote brutal‡Haubert de brutalité‡野蛮锁甲‡野蠻鍊衫',
    nil,
    nil,
  }
},
[1858] = {
  {
    'A Mão Despedaçada‡Изувеченная Длань‡Die Zerschmetterte Hand‡으스러진 손‡Mano Destrozada‡Mano Destrozada‡La Main brisée‡碎手氏族‡破碎之手氏族',
    nil,
    'Roube a chave de Tazan e use-a para abrir a Algibeira dele, levando o conteúdo para Therzok no Antro das Sombras, em Orgrimmar.‡Украдите ключ Тазана, откройте сумку Тазана и отнесите содержимое сумки Терзоку в Расселину Теней в Оргриммаре.‡Stehlt Tazans Schlüssel, öffnet seinen Ranzen damit und bringt den Inhalt zu Therzok in der Kluft der Schatten in Orgrimmar.‡타잔의 열쇠를 훔쳐 가방을 열고 그 속에 든 물건들을 오그리마의 어둠의 틈에 있는 테르조크에게 가져가야 합니다.‡Roba la llave de Tazan, abre su cartera y llévale el contenido a Therzok al Circo de las Sombras, en Orgrimmar.‡Roba la llave de Tazan, abre su cartera y llévale el contenido a Therzok al Circo de las Sombras, en Orgrimmar.‡Voler la Clé de Tazan puis l\'utiliser pour ouvrir sa Sacoche et livrer son contenu à Therzok dans la Faille de l\'Ombre à Orgrimmar.‡偷来塔赞的钥匙，用它打开他的背包，然后将里面的物品交给奥格瑞玛暗影裂口的瑟祖克。‡偷來塔贊的鑰匙，用它打開他的背袋，然後將裡面的物品交給奧格瑪暗影裂口的瑟祖克。',
  }
},
[1859] = {
  {
    'Therzok‡Терзок‡Therzok‡테르조크‡Therzok‡Therzok‡Therzok‡‡',
    nil,
    'Fale com Therzok no Antro das Sombras em Orgrimmar.‡Поговорите с Терзоком в Расселине Теней в Оргриммаре.‡Sprecht mit Therzok in der Kluft der Schatten in Orgrimmar.‡오그리마의 어둠의 틈에 있는 테르조크와 대화해야 합니다.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Therzok.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Therzok.‡Aller voir Therzok dans la Faille de l\'Ombre à Orgrimmar.‡到奥格瑞玛的暗影裂口和瑟祖克谈谈。‡',
  }
},
[1860] = {
  {
    'Fale com Jana‡Поговорите с Джиннией‡Gespräch mit Jennea‡제니아와의 대화‡Habla con Jennea‡Habla con Jennea‡Parler à Jennea‡和詹妮亚交谈‡和詹妮亞交談',
    nil,
    'Fale com Jana Catão em Ventobravo.‡Поговорите с Джиннией Пушкой в Штормграде.‡Sprecht in Sturmwind mit Jennea Haubitz.‡스톰윈드에 있는 제니아 캐논과 대화해야 합니다.‡Habla con Jennea Cañón en Ventormenta.‡Habla con Jennea Cañón en Ventormenta.‡Parler à Jennea Cannon à Hurlevent.‡和暴风城的詹妮亚·坎农谈一谈。‡和暴風城的詹妮亞·坎農談話。',
