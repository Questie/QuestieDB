[31989] = {
  {
    'O Pico da Serenidade - Complete seu treinamento‡Пик Безмятежности - завершение обучения‡Der Gipfel der Ruhe - Schließt Eure Ausbildung ab‡평온의 봉우리 - 훈련을 완수하라‡El Pico de la Serenidad: Completa el entrenamiento‡‡Le pic de la Sérénité - Achevez votre entraînement‡晴日峰：完成训练‡',
    nil,
    'Use Peregrinação Zen para ir ao Pico da Serenidade. Fale com Mestre Hight no Templo do Boi quando chegar. Uma‡Воспользуйтесь способностью "Духовное путешествие", чтобы отправиться на пик Безмятежности. По прибытии поговорите с мастером Хайтом в Святилище Быка.‡Reist mithilfe der Zenpilgerfahrt zum Gipfel der Ruhe. Sprecht bei Eurer Ankunft mit Meister Hight am Schrein des Ochsen.‡순례를 사용하여 평온의 봉우리로 떠나야 합니다. 도착하면 흑우의 제단에 있는 사부 하이트와 대화해야 합니다.‡Usa Peregrinaje zen para viajar al Pico de la Serenidad y habla con el maestro Cenit en el Santuario del Buey cuando llegues.‡‡Utilisez Pèlerinage zen pour vous rendre au Pic de la Sérénité, puis parlez à Maître Culmine au Sanctuaire du Buffle à votre arrivée.‡使用禅宗朝圣前往晴日峰，和玄牛神龛的海特大师谈一谈。‡',
  }
},
[31990] = {
  {
    'Audreia Répibãrne‡Одри Бернхеп‡Marlene Trichdie‡‡Audrey Burnhep‡‡Audrey Burnhep‡‡',
    nil,
    'Apresente-se a Audreia Répibãrne em Ventobravo. Uma‡Обратитесь к Одри Бернхеп в Штормграде. это‡Meldet Euch bei Marlene Trichdie in Sturmwind.‡‡Ve a ver a Audrey Burnhep en Ventormenta.‡‡Allez vous présenter à Audrey Burnhep à Hurlevent.‡‡',
  }
},
[31991] = {
  {
    'Grão-mestre Zusshi‡Великий укротитель Зусши‡Großmeister Zusshi‡특급 조련사 주쉬‡Gran maestro Zusshi‡‡Grand maître Zusshi‡驯宠宗师祖什‡',
    nil,
    'Vença o Perscrutador Zusshi numa batalha de mascotes. Uma‡Победите искателя Зусши в битве питомцев. это‡Besiegt Sucher Zusshi in einem Haustierkampf.‡애완동물 대전에서 수색자 주쉬를 꺾어야 합니다. 레벨 1‡Derrota al buscador Zusshi en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre le Chercheur Zusshi.‡在宠物战斗中击败探索者祖什。‡',
  }
},
[31998] = {
  {
    'Um desafio digno: Sha da Dúvida‡Серьезное испытание: Ша Сомнения‡Eine würdige Herausforderung: Sha des Zweifels‡보람찬 도전: 의심의 샤‡Un desafío digno: Sha de la duda‡‡Un défi de taille : le sha du doute‡艰难的挑战：疑之煞‡',
    nil,
    'Completar o Modo Desafio do Templo da Serpente de Jade. Uma‡Пройдите храм Нефритовой Змеи в режиме испытания.‡Schließt den Tempel der Jadeschlange im Herausforderungsmodus ab.‡옥룡사 도전 모드를 완료해야 합니다. 레벨 35 옥룡사‡Completa el Templo del Dragón de Jade en modo desafío.‡‡Terminez le Temple du Serpent de jade en mode Défi.‡完成青龙寺挑战。‡',
  }
},
[31999] = {
  {
    'O comando de Nazgrim‡Приказ Назгрима‡Nazgrims Befehl‡나즈그림의 명령‡La orden de Nazgrim‡‡Aux ordres de Nazgrim‡纳兹戈林的命令‡',
    nil,
    'Apresente-se ao General Nazgrim na Pista de Pouso Pulso Firme, na Floresta de Jade. Uma‡Поговорите с генералом Назгримом на Взлетной полосе Сильной Руки в Нефритовом лесу.‡Meldet Euch bei General Nazgrim auf dem Starkarmflugplatz im Jadewald.‡비취 숲의 우격다짐 비행장에 있는 장군 나즈그림과 대화해야 합니다. 레벨 10 비취 숲‡Preséntate ante el general Nazgrim en la Pista de Aterrizaje Armafuerte, en El Bosque de Jade.‡‡Faites votre rapport au Général Nazgrim sur la Piste d’atterrissage de Gros-Bras, dans la Forêt de Jade.‡去翡翠林的铁腕机坪向纳兹戈林将军报到。‡',
  }
},
[32000] = {
  {
    'Um desafio digno: Yan-Zhu, o Desenvasado‡Серьезное испытание: Янь-Чжу Высвобожденный‡Eine würdige Herausforderung: Yan-Zhu der Dekantierte‡‡Un desafío digno: Yan-Zhu el Peleón‡‡Un défi de taille : Yan Zhu le Déballonné‡艰难的挑战：破桶而出的炎诛‡',
    nil,
    'Completar o Modo Desafio da Cervejaria Malte do Trovão. Uma‡Пройдите Хмелеварню Буйных Портеров в режиме испытания.‡Schließt die Brauerei Sturmbräu im Herausforderungsmodus ab.‡‡Completa la Cervecería del Trueno en modo desafío.‡‡Terminez la Brasserie Brune d’Orage en mode Défi.‡完成风暴烈酒酿造厂挑战。‡',
  }
},
[32001] = {
  {
    'Um desafio digno: Sha do Ódio‡Серьезное испытание: Ша Ненависти‡Eine würdige Herausforderung: Sha des Hasses‡보람찬 도전: 증오의 샤‡Un desafío digno: Sha del odio‡‡Un défi de taille : le sha de la haine‡艰难的挑战：恨之煞‡',
    nil,
    'Completar o Modo Desafio do Monastério Shado-pan. Uma‡Пройдите Монастырь Шадо-Пан в режиме испытания.‡Schließt das Shado-Pan-Kloster im Herausforderungsmodus ab.‡음영파 수도원 도전 모드를 완료해야 합니다. 레벨 35 음영파 수도원‡Completa el Monasterio del Shadopan en modo desafío.‡‡Terminez le Monastère des Pandashan en mode Défi.‡完成影踪禅院挑战。‡',
  }
},
[32002] = {
  {
    'Um desafio digno: Xin, o Mestre de Armas‡Серьезное испытание: Синь Мастер Боя‡Eine würdige Herausforderung: Xin der Waffenmeister‡‡Un desafío digno: Xin, el Maestro de armas‡‡Un défi de taille : Xin le Maître d’armes‡艰难的挑战：武器大师席恩‡',
    nil,
    'Completar o Modo Desafio do Palácio Mogu\'shan. Uma‡Пройдите Дворец Могу\'шан в режиме испытания.‡Schließt den Mogu\'shanpalast im Herausforderungsmodus ab.‡‡Completa el Palacio Mogu\'shan en modo desafío.‡‡Terminez le Palais Mogu’shan en mode Défi.‡完成魔古山宫殿挑战。‡',
