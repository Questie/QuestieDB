[28608] = {
  {
    'O Sepulcro Sombrio‡Мрачный склеп‡Das Schattengrab‡암흑의 무덤‡El Sepulcro Sombrío‡El Sepulcro Sombrío‡Le tombeau des Ombres‡灰影墓穴‡灰影墓穴',
    nil,
    'Obtenha o Fluido Embalsamador Denso e a Gavinha de Costurar Cadáver do Sepulcro Sombrio, em Plangemortis.‡Принесите из Мрачного склепа, что в Похоронном Звоне, густой бальзамировочный состав и нить для сшивания трупов.‡Holt zähe Balsamierungsflüssigkeit und Leichenflickerzwirn aus dem Schattengrab in Todesend.‡죽음의 종소리 마을에 있는 암흑의 무덤에서 진한 불변의 액체와 시체 접합용 노끈을 획득해야 합니다.‡Obtén el líquido de embalsamar espeso y el cordel para coser cadáveres en el Sepulcro Sombrío, en Camposanto.‡Obtén el líquido de embalsamar espeso y el cordel para coser cadáveres en el Sepulcro Sombrío, en Camposanto.‡Allez chercher le Fluide d’embaumement épais et la Ficelle suture-cadavres dans le Tombeau des Ombres, au Glas.‡从丧钟镇的灰影墓穴中拿取粘稠的防腐剂和缝尸麻线。‡到喪鐘鎮的灰影墓穴取得濃稠的防腐液和屍體縫合麻繩。',
  }
},
[28609] = {
  {
    'Hora do Martelo‡Молотилка‡Hammerschläge‡때려부술 시간‡La hora del martillo‡La hora del martillo‡Soucis de marteau‡该抡起锤子了！‡打擊時間',
    nil,
    'Fale com Rocas Calho.‡Поговорите с Дизом Дятло.‡Sprecht mit Deez Felsklau.‡디즈 록스니치와 대화해야 합니다.‡Habla con Deez Hurtarroca.‡Habla con Deez Hurtarroca.‡Parlez à Deez Fourgue-roc.‡跟迪兹·石爆谈一谈。‡與迪滋·岩偷交談。',
  }
},
[28610] = {
  {
    'Faturando um cascalho‡Беда с этими обломками‡Grollendes Geröll‡돌덩어리 문제‡Enrocado‡Enrocado‡Cailloux joujoux‡石料短缺‡麻煩的礫石',
    nil,
    'Colete 6 Pedaços de Cascalho de Primeira dos Estrondosos Chispagelo.‡Соберите 6 первосортных обломков, убивая ледяных грохотунов.‡Beschafft 6 hochwertige Geröllbrocken von Frostsplitterrumplern.‡서리조각 우레정령에서 우수한 돌덩어리 6개를 수집해야 합니다.‡Obtén 6 trozos de escombros primordiales de los estruendores Trocescarcha.‡Obtén 6 trozos de escombros primordiales de los estruendores Trocescarcha.‡Collectez 6 Morceaux de gravats primordiaux sur des Grondeurs givréclats.‡从霜岩滚石元素身上收集6块大块粗石。‡從霜片奔行者身上取得6份優質礫石。',
  }
},
[28611] = {
  {
    'O ritual dos profanadores‡Ритуал осквернителей‡Das Ritual der Entweiher‡파멸자들의 의식‡El ritual de los Rapiñadores‡El ritual de los Rapiñadores‡Le rituel des profanateurs‡污染者的仪式‡污染者儀式',
    nil,
    'Detenha o Ritual dos Neferset na Caverna Lodofundo.‡Прервите ритуал неферсетов в пещере Глубомрака.‡Unterbrecht das Ritual der Neferset in der Finstergrundhöhle.‡먹구렁 동굴에서 네페르세트 의식을 중단시켜야 합니다.‡Detén el ritual de Neferset en la Caverna Negrasombra.‡Detén el ritual de Neferset en la Caverna Negrasombra.‡Arrêtez le Rituel de Neferset à la Caverne de Fondeboue.‡去深暗洞穴阻止尼斐塞特仪式。‡到莫克迪普山洞阻止奈斐賽特儀式。',
  }
},
[28612] = {
  {
    'Harrison Jones e o Templo de Uldum‡Харрисон Джонс и храм Ульдума‡Harrison Jones und der Tempel von Uldum‡해리슨 존스와 울둠의 사원‡Harrison Jones y el Templo de Uldum‡Harrison Jones y el Templo de Uldum‡Harrison Jones et le temple d\'Uldum‡哈里森·琼斯与奥丹姆神殿‡哈里遜·瓊斯與奧丹姆神殿',
    nil,
    'Recupere o Baú da Promessa.‡Доберитесь до саркофага Предвестья.‡Erbeutet die Lade der Verheißung.‡약속의 성궤를 찾아야 합니다.‡Recupera el Arca de la promesa.‡Recupera el Arca de la promesa.‡Récupérez le Coffre des merveilles.‡获得应许约柜。‡取得應許法櫃。',
  }
},
[28613] = {
  {
    'Vejo você no outro lado!‡Увидимся по ту сторону!‡Wir sehen uns auf der anderen Seite!‡반대편에서 만납시다!‡¡Nos vemos al otro lado!‡¡Nos vemos al otro lado!‡On se revoit de l\'autre côté !‡另一边见！‡另一頭再見!',
    nil,
    'Fale com Harrison Jones no topo da Encosta do Criador, que fica em Uldum.‡Обратитесь к Харрисону Джонсу, его можно найти на вершине Возвышения Творца в Ульдуме.‡Sprecht mit Harrison Jones auf dem Aufstieg des Schöpfers in Uldum.‡울둠 창조주의 오르막길 꼭대기에서 해리슨 존스와 대화해야 합니다.‡Habla con Harrison Jones en lo alto del Ascenso del Hacedor, en Uldum.‡Habla con Harrison Jones en lo alto del Ascenso del Hacedor, en Uldum.‡Allez voir Harrison Jones en haut de l\'Ascension des Faiseurs, en Uldum.‡与奥丹姆造物主高地顶端的哈里森·琼斯交谈。‡到奧丹姆的造物者高地找哈里遜‧瓊斯說話。',
  }
},
[28614] = {
  {
    'Furiurso‡Берсерк‡Bärserker‡곰폭화‡Rabioso‡Rabioso‡Espèce de Grolnar‡狂暴熊怪‡狂暴熊',
    nil,
    'Mate Grolnar, o Berserk.‡Убейте Гролнара Берсерка.‡Tötet Grolnar den Berserker.‡광포한 그롤나르를 처치해야 합니다.‡Mata a Grolnar el Rabioso.‡Mata a Grolnar el Rabioso.‡Tuez Grolnar le Berserk.‡杀死狂暴者格罗尔纳。‡殺死狂暴者葛羅納爾。',
  }
},
[28615] = {
  {
    'Quem com terra fere...‡Гнев Земли‡Erdwiderstand‡땅 뒤집기‡Volver la tierra en su contra‡Volver la tierra en su contra‡Ma terre dolorosa‡大地之怒‡翻覆大地',
    nil,
    'Use o Totem Sobrecarregado de Tanrir para sobrecarregar 4 Totens da Terra dos Invernosos.‡С помощью заряженного тотема Танрира уничтожьте 4 тотема земли Зимней Спячки.‡Überladet 4 Erdtotems der Winterfelle mit Tanrirs überladenem Totem.‡탄리르의 과충전된 토템을 사용해 겨울눈 대지의 토템 4개에 과부하를 줘야 합니다.‡Utiliza el tótem sobrecargado de Tanrir para sobrecargar 4 tótems de tierra Nevada.‡Utiliza el tótem sobrecargado de Tanrir para sobrecargar 4 tótems de tierra Nevada.‡Utilisez le Totem surchargé de Tanrir pour mettre en surcharge 4 Totems de terre tombe-hiver.‡使用塔尼尔的过载图腾，使4根冬泉大地图腾过载。‡用塔恩瑞爾的超載圖騰讓四支冬泉谷大地圖騰的元素超載。',
  }
},
[28616] = {
  {
    'O crepúsculo dos Lançatroz‡Конец клану Грозовой Вершины‡Sturmlanzenapokalypse‡스톰파이크의 종말‡Apocalipsis Pico Tormenta‡Apocalipsis Pico Tormenta‡L\'apocalypse foudrepique‡雷矛的末日‡雷矛的末日',
    nil,
    'Testemunhe o Crepúsculo dos Lançatroz.‡Станьте свидетелем гибели клана Грозовой Вершины.‡Werdet Zeuge der Sturmlanzenapokalypse.‡스톰파이크의 종말을 지켜봐야 합니다.‡Presencia el apocalipsis Pico Tormenta.‡Presencia el apocalipsis Pico Tormenta.‡Assistez à l\'Apocalypse des Foudrepiques.‡见证雷矛的末日。‡目睹雷矛的末日。',
  }
},
[28617] = {
  {
    'O poder das flores‡Цветочная сила‡Blumenkinder‡꽃의 힘‡Flores al poder‡Flores al poder‡Dites-le avec des fleurs‡花朵的力量‡花朵的力量',
    nil,
    'Sobreviva a uma Onda Imensa de Zumbis.‡Выдержите 1 внушительную волну наступления зомби.‡Überlebt eine riesige Zombiewelle.‡좀비의 총공격에서 살아남아야 합니다.‡Sobrevive a una gigantesca oleada de zombis.‡Sobrevive a una gigantesca oleada de zombis.‡Survivez à une vague massive de zombies.‡抵御一大波僵尸攻击。‡撐過1波殭屍的猛烈攻擊。',
  }
},
[28618] = {
  {
    'Penedo em domicílio‡Доставка валунов‡Felslieferung‡바위 배달‡Entrega de rocas‡Entrega de rocas‡Livraison de rocher‡巨石到货‡運送巨礫',
    nil,
    'Entregue o Penedo Encaixotado à Lilith, a Ligeira, em Visteterna.‡Доставьте валун-в-коробке Лилит Гибкой в Круговзор.‡Gebt einen Fels in einer Kiste bei Lilith der Lieblichen in der Ewigen Warte ab.‡상자 호박돌을 눈망루 마을에 있는 호리호리한 릴리스에게 전달해야 합니다.‡Entrega la roca de bolsillo a Lilith la Ágil en Vista Eterna.‡Entrega la roca de bolsillo a Lilith la Ágil en Vista Eterna.‡Livrez le Rocher-en-boîte à Lilith l\'Agile, dans Long-Guet.‡将盒装巨石交给永望镇的轻盈的莉莉丝。‡將礫石封裝盒帶去永望鎮遞交給輕盈的莉莉絲。',
  }
},
[28619] = {
  {
    'Ordens do Chefe Guerreiro: Planalto Arathi!‡Приказ вождя: Нагорье Арати!‡Auf Befehl des Kriegshäuptlings: Arathihochland!‡대족장의 명령: 아라시 고원!‡¡La orden del Jefe de Guerra: Tierras Altas de Arathi!‡¡La orden del Jefe de Guerra: Tierras Altas de Arathi!‡Ordre du chef de guerre : les hautes-terres Arathies !‡酋长的命令：阿拉希高地！‡大酋長的命令:阿拉希高地!',
    nil,
    'Apresente-se à Patrulheira Sombria Alina na Ruína de Galen, que fica no Planalto Arathi.‡Доложите о своем прибытии темному следопыту Алине в Уделе Галена, что на Нагорье Арати.‡Meldet Euch bei Dunkelläuferin Alina bei Galens Sturz im Arathihochland.‡아라시 고원의 갈렌의 타락지에 있는 어둠 순찰자 앨리나에게 보고해야 합니다.‡Preséntate ante la forestal oscura Alina en Caída de Galen, en las Tierras Altas de Arathi.‡Preséntate ante la forestal oscura Alina en Caída de Galen, en las Tierras Altas de Arathi.‡Présentez-vous au Forestier-sombre Alina à la Chute de Galen, dans les Hautes-terres Arathies.‡去找阿拉希高地加林之陨的黑暗游侠阿莉娜。‡到阿拉希高地的加林之殞向黑暗遊俠奧麗娜報到。',
  }
},
[28620] = {
  {
    'Torre Leste‡Восточная башня‡Ostwachtturm‡동부경비 탑‡Torre Oriental‡Torre Oriental‡La tour du Point de l\'Est‡东点哨塔‡東點哨塔',
    nil,
    'Fale com Nilson Putrefacto na Torre Leste do Contraforte de Eira dos Montes.‡Поговорите с Нильсом Гнилопчелом в Восточной башне, что в Предгорьях Хилсбрада.‡Sprecht mit Nils Bierwurz am Ostwachttum im Vorgebirge des Hügellands.‡언덕마루 구릉지의 동부경비 탑에 있는 닐스 비로트과 대화해야 합니다.‡Habla con Nils Beerot en la Torre Oriental, en las Laderas de Trabalomas.‡Habla con Nils Beerot en la Torre Oriental, en las Laderas de Trabalomas.‡Allez voir Nils Putressaim à la Tour du Point de l\'Est, dans les Contreforts de Hautebrande.‡跟希尔斯布莱德丘陵东点哨塔的尼尔斯·毕若特谈一谈。‡和希爾斯布萊德丘陵的東點哨塔的尼爾斯·畢羅特談話。',
  }
},
[28621] = {
  {
    'Coloque aquele bebê no berço!‡Каждой малютке – по колыбельке‡Legt das Baby in die Wiege!‡아이는 요람으로!‡¡Pon esta monada en la cuna!‡¡Pon esta monada en la cuna!‡Touche pas à mon coffre !‡把宝宝放进摇篮！‡把娃娃放回搖籃裡!',
    nil,
    'Fale com Harrison Jones no Templo de Uldum.‡Поговорите с Харрисоном Джонсом возле храма Ульдума.‡Sprecht mit Harrison Jones beim Tempel von Uldum.‡울둠 사원에 있는 해리슨 존스와 대화해야 합니다.‡Habla con Harrison Jones en el Templo de Uldum.‡Habla con Harrison Jones en el Templo de Uldum.‡Allez voir Harrison Jones au Temple d\'Uldum.‡与奥丹姆神殿的哈里森·琼斯交谈。‡到奧丹姆神殿找哈里遜‧瓊斯說話。',
  }
},
[28622] = {
  {
    'Se pelo ar, três...‡Трое в воздухе, не считая саркофага‡Ein, zwei, nein, drei Signalleuchtfeuer‡비행에는 세 명이 필요해‡Por aire, tres‡Por aire, tres‡Coffry-fret‡三人飞行‡閃三下',
    nil,
    'Use os Sinais de Fumaça no Templo de Uldum.‡Расставьте сигнальные ракеты возле храма Ульдума.‡Benutzt die Signalleuchtfeuer beim Tempel von Uldum.‡울둠 사원에서 해리슨의 신호용 불꽃을 사용해야 합니다.‡Usa las bengalas de señalización en el Templo de Uldum.‡Usa las bengalas de señalización en el Templo de Uldum.‡Utilisez les Fusées de signalisation au Temple d\'Uldum.‡在奥丹姆神殿中使用信号弹。‡在奧丹姆神殿使用信號槍。',
  }
},
[28623] = {
  {
    'Dando um empurrãozinho‡Поход на запад‡Auf nach Westen‡서부로 진격하라‡El avance occidental‡El avance occidental‡La poussée vers l\'ouest‡朝西方挺进‡往西前進',
    nil,
    'Apresente-se ao Rei Phaoris nos Arredores da Cidade dos Neferset em Uldum.‡Встретьтесь с королем Фаорисом на окраине города Неферсет в Ульдуме.‡Meldet Euch bei König Phaoris in den Außenbezirken von Neferset in Uldum.‡울둠의 네페르세트 도시 교외에 있는 왕 파오리스에게 보고해야 합니다.‡Preséntate ante el rey Phaoris en las Afueras de la Ciudad de Neferset, en Uldum.‡Preséntate ante el rey Phaoris en las Afueras de la Ciudad de Neferset, en Uldum.‡Faites un rapport au Roi Phaoris dans les Faubourgs de Neferset, en Uldum.‡去找奥丹姆尼斐塞特城郊的法奥瑞斯国王。‡到奧丹姆的奈斐賽特城郊區向法歐瑞斯王回報。',
  }
},
[28624] = {
  {
    'O caô do Kilram‡Похвальба Килрама‡Kilrams Prahlerei‡킬램의 허세‡La bravuconada de Kilram‡La bravuconada de Kilram‡La fanfaronnade de Kilram‡爱吹嘘的基尔拉姆‡基爾拉姆的自傲',
    nil,
    'Fale com Rocas Calho.‡Поговорите с Дизом Дятло.‡Sprecht mit Deez Felsklau.‡디즈 록스니치와 대화해야 합니다.‡Habla con Deez Hurtarroca.‡Habla con Deez Hurtarroca.‡Parlez à Deez Fourgue-roc.‡跟迪兹·石爆谈一谈。‡與迪滋·岩偷交談。',
  }
},
[28625] = {
  {
    'Serrando na serra‡Лесозаготовки‡Baum fällt!‡나무 베기‡Dar leña‡Dar leña‡Coupe coupe‡砍啊砍‡砍啊砍',
    nil,
    'Colete 10 Lenhas Gélidas Recém-cortadas dos Arvorosos da Folha Gélida.‡Соберите 10 кусков свежей ледяной древесины, убивая древней с морозными листьями.‡Beschafft 10 Stücke frischgeschlagenes Frostholz von Frostlaubtreants.‡서리잎 나무정령에서 갓 벤 서리나무 10개를 획득해야 합니다.‡Recoge 10 trozos de madera de escarcha recién cortada de los antárboles Hojaescarcha.‡Recoge 10 trozos de madera de escarcha recién cortada de los antárboles Hojaescarcha.‡Récupérez 10 pièces de Bois gelé fraîchement coupé provenant de Tréants feuillegivre.‡从霜叶树人身上收集10片刚切下的冻心木料。‡從霜葉樹人身上收集10片新伐的霜木。',
  }
},
[28626] = {
  {
    'Árvores em domicílio‡Доставка деревьев‡Baumlieferung‡나무 배달‡Entrega de árboles‡Entrega de árboles‡Livraison d\'arbre‡大树到货‡運送樹木',
    nil,
    'Entregue a Instantárvore Super-crescida a Kilram na estalagem em Visteterna.‡Доставьте суперростовое быстродерево Килраму в таверну Круговзора.‡Bringt den Wunderwuchs-Instantbaum zu Kilram im Gasthaus der Ewigen Warte.‡눈망루 마을 여관에 있는 킬램에게 강력성장 즉석나무를 전달해야 합니다.‡Entrégale el árbol de súper crecimiento instantáneo a Kilram en la posada de Vista Eterna.‡Entrégale el árbol de súper crecimiento instantáneo a Kilram en la posada de Vista Eterna.‡Livrez le Super-Instarbre à Kilram, à l\'auberge de Long-Guet.‡将超易用速植树交给永望镇的基尔拉姆。‡將超級速成樹帶去永望鎮的旅店遞交給基爾拉姆。',
  }
},
[28627] = {
  {
    'O caô de Seril‡Похвальба Сирила‡Serils Prahlerei‡세릴의 허세‡La bravuconada de Seril‡La bravuconada de Seril‡La fanfaronnade de Seril‡爱吹嘘的瑟里尔‡瑟里爾的自傲',
