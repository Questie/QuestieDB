[31439] = {
  {
    'Derrubando nosso sinal‡Потерянный сигнал‡Verlorenes Signal‡끊어진 신호‡Establecer nuestra señal‡‡Signal en détresse‡释放信号‡',
    nil,
    'Desperte o paragão no Pântano da Raiz do Ocaso. Uma‡Пробудите Идеала в Топях Темного Корня.‡Erweckt den Getreuen im Dämmerwurzmoor.‡그늘뿌리 늪에서 용장을 깨워야 합니다. 레벨 30 공포의 황무지‡Despierta al dechado en el Fangal Raíz Negra.‡‡Éveillez le Parangon du Marécage de Point-du-Couchant.‡唤醒暮根沼泽的英杰。‡',
  }
},
[31440] = {
  {
    'Os quatro tomos‡Четыре фолианта‡Die vier Folianten‡네 개의 고서‡Los cuatro tomos‡‡Les quatre tomes‡四部古籍‡',
    nil,
    'Destrua os quatro tomos: "À Sombra da Luz", "O Profundo Conhecimento de Kel\'Thuzad", "Ritos Proibidos e Outros Rituais Necromânticos" e "Grimório Negro".‡Уничтожьте четыре фолианта: "В тени света", "Сокровенное знание Кел\'Тузада", "Запретные обряды и иные ритуалы некромантов" и "Гримуар Тьмы".‡Vernichtet die vier Folianten: "Im Schatten des Lichts", "Kel\'Thuzads tiefgründiges Wissen", "Verbotene Riten und andere nekromantische Rituale" und "Der dunkle Zauberfoliant".‡고서 네 개를 없애야 합니다. 고서의 제목은 다음과 같습니다. "빛의 그림자 속에서", "켈투자드의 심오한 지식", "금단의 의식 및 기타 강령 의식", "어둠의 흑마법서".‡Destruye los cuatro tomos: "A la sombra de la Luz", "Saber profundo de Kel\'Thuzad", "Ritos prohibidos y otros rituales nigrománticos" y "El grimorio oscuro".‡‡Détruisez les quatre tomes : « À l\'ombre de la Lumière », « Connaissances approfondies de Kel\'Thuzad », « Rites interdits et autres rituels nécromantiques » et « Le Grimoire noir ».‡摧毁四部古籍——《光明下的阴影》、《克尔苏加德的深层知识》、《禁忌咒文及其他死灵仪式》和《黑暗法典》。‡',
  }
},
[31441] = {
  {
    'A corrupção é profunda‡Порча повсюду‡Korruption auf allen Ebenen‡깊게 퍼진 타락‡La corrupción es profunda‡‡La corruption est profonde‡深层腐化‡',
    nil,
    'Derrote o traidor no Pântano Raiz do Ocaso. Uma‡Победите предателя в Топи Темного Корня.‡Bezwingt den Verräter im Dämmerwurzmoor.‡그늘뿌리 늪에서 배신자를 물리쳐야 합니다. 레벨 30 공포의 황무지‡Derrota al traidor en el Fangal Raíz Negra.‡‡Battez le traître au Marécage de Point-du-Couchant.‡击败暮根沼泽的叛徒。‡',
  }
},
[31442] = {
  {
    'Os quatro tomos‡Четыре фолианта‡Die vier Folianten‡네 개의 고서‡Los cuatro tomos‡‡Les quatre tomes‡四部古籍‡',
    nil,
    'Destrua os quatro tomos: "À Sombra da Luz", "O Profundo Conhecimento de Kel\'Thuzad", "Ritos Proibidos e Outros Rituais Necromânticos" e "Grimório Negro".‡Уничтожьте четыре фолианта: "В тени света", "Сокровенное знание Кел\'Тузада", "Запретные обряды и иные ритуалы некромантов" и "Гримуар Тьмы".‡Vernichtet die vier Folianten: "Im Schatten des Lichts", "Kel\'Thuzads tiefgründiges Wissen", "Verbotene Riten und andere nekromantische Rituale" und "Der dunkle Zauberfoliant".‡고서 네 개를 없애야 합니다. 고서의 제목은 다음과 같습니다. "빛의 그림자 속에서", "켈투자드의 심오한 지식", "금단의 의식 및 기타 강령 의식", "어둠의 흑마법서".‡Destruye los cuatro tomos: "A la sombra de la Luz", "Saber profundo de Kel\'Thuzad", "Ritos prohibidos y otros rituales nigrománticos" y "El grimorio oscuro".‡‡Détruisez les quatre tomes : « À l\'ombre de la Lumière », « Connaissances approfondies de Kel\'Thuzad », « Rites interdits et autres rituels nécromantiques » et « Le Grimoire noir ».‡摧毁四部古籍——《光明下的阴影》、《克尔苏加德的深层知识》、《禁忌咒文及其他死灵仪式》和《黑暗法典》。‡',
  }
},
[31443] = {
  {
    'Gourami-tigre voador‡Летающий тигровый гурами‡Fliegender Tigergurami‡나는 호랑이 구라미‡Gurami tigre volador‡‡Gourami tigre volant‡飞行虎皮丝足鱼‡',
    nil,
    'Leve o Gourami-tigre Voador para Nat Pagle no Cais dos Pescadores. Uma‡Отнесите летающего тигрового гурами Нату Пэглу в Деревню рыболовов. это‡Bringt den fliegenden Tigergurami zu Nat Pagle an der Anlegestelle der Angler.‡강태공 부두에 있는 내트 페이글에게 나는 호랑이 구라미를 가져가야 합니다. 레벨 15‡Lleva el gurami tigre volador a Nat Pagle al Muelle de los Pescadores.‡‡Apportez le Gourami tigre volant à Nat Pagle au Quai des Hameçonneurs.‡把飞行虎皮丝足鱼交给渔人码头的纳特·帕格。‡',
  }
},
[31444] = {
  {
    'Peixe-espinho alfa‡Самец иглоспинки‡Stachelfischalpha‡우두머리 가시고기‡Pez espinoso alfa‡‡Poisson-hérisson alpha‡霸王刺皮鱼‡',
    nil,
    'Leve o Peixe-espinho Alfa para Nat Pagle no Cais dos Pescadores. Uma‡Отнесите самца иглоспинки Нату Пэглу в Деревню рыболовов. это‡Bringt den Stachelfischalpha zu Nat Pagle an der Anlegestelle der Angler.‡강태공 부두에 있는 내트 페이글에게 우두머리 가시고기를 가져가야 합니다. 레벨 15‡Lleva el pez espinoso alfa a Nat Pagle al Muelle de los Pescadores.‡‡Apportez le Poisson-hérisson alpha à Nat Pagle au Quai des Hameçonneurs.‡把霸王刺皮鱼交给渔人码头的纳特·帕格。‡',
  }
},
[31445] = {
  {
    'zzOld‡zzOld‡zzOld‡‡zzOld‡‡zzOld‡‡',
    nil,
    'Speak to Fisherman Haito at the Anglers Wharf in the Krasarang Wilds. Uma‡Speak to Fisherman Haito at the Anglers Wharf in the Krasarang Wilds.‡Sprecht mit Angler Haito an der Anlegestelle der Angler in der Krasarangwildnis.‡‡Habla con el pescador Haito en el Muelle de los Pescadores, en la Espesura Krasarang.‡‡Parlez au Pêcheur Haito au Quai des Hameçonneurs dans les Étendues sauvages de Krasarang.‡‡',
  }
},
[31446] = {
  {
    'Polvo-mímico‡Мимикрирующий осьминог‡Fintenfisch‡흉내쟁이 문어‡Pulpo imitador‡‡Pieuvre caméléon‡拟态章鱼‡',
    nil,
    'Leve o Polvo-mímico para Nat Pagle no Cais dos Pescadores. Uma‡Отнесите мимикрирующего осьминога Нату Пэглу в Деревню рыболовов. это‡Bringt den Fintenfisch zu Nat Pagle an der Anlegestelle der Angler.‡강태공 부두에 있는 내트 페이글에게 흉내쟁이 문어를 가져가야 합니다. 레벨 15‡Llévale el pulpo imitador a Nat Pagle al Muelle de los Pescadores.‡‡Apportez la Pieuvre caméléon à Nat Pagle au Quai des Hameçonneurs.‡把拟态章鱼交给渔人码头的纳特·帕格。‡',
  }
},
[31447] = {
  {
    'Um fim para o sofrimento‡Конец страданиям‡Dem Leiden ein Ende‡고통의 끝‡Poner fin al sufrimiento‡‡Une fin à la souffrance‡苦难的终结‡',
    nil,
    'Mate o Umbromestre Gandling. Uma‡Убейте темного магистра Гандлинга.‡Tötet Dunkelmeister Gandling.‡암흑스승 간들링을 없애야 합니다. 레벨 15 스칼로맨스‡Mata al maestro oscuro Gandling.‡‡Tuez le Sombre Maître Gandling.‡杀死黑暗院长加丁。‡',
  }
},
[31448] = {
  {
    'Um fim para o sofrimento‡Конец страданиям‡Dem Leiden ein Ende‡고통의 끝‡Poner fin al sufrimiento‡‡Une fin à la souffrance‡苦难的终结‡',
    nil,
    'Mate o Umbromestre Gandling. Uma‡Убейте темного магистра Гандлинга.‡Tötet Dunkelmeister Gandling.‡암흑스승 간들링을 없애야 합니다. 레벨 35 스칼로맨스‡Mata al maestro oscuro Gandling.‡‡Tuez le Sombre Maître Gandling.‡杀死黑暗院长加丁。‡',
  }
},
[31450] = {
  {
    'Um novo destino‡Новая судьба‡Ein neues Schicksal‡새로운 운명‡Un nuevo destino‡‡Un nouveau destin‡新的命运‡',
    nil,
    'Fale com o Espírito do Mestre Shang Xi e escolha se quer partir com a Aliança ou com a Horda. Uma‡Поговорите с духом мастера Шан Си и сообщите ему, с кем вы желаете пойти: с Альянсом или с Ордой.‡Sprecht mit dem Geist von Meister Shang Xi und entscheidet Euch dann, ob Ihr mit der Allianz oder der Horde losziehen wollt.‡사부 샹 시의 영혼에게 말을 걸어, 얼라이언스와 함께 갈지 호드와 함께 갈지 선택해야 합니다. 레벨 1 유랑도‡Habla con el espíritu del maestro Shang Xi y decide si quieres marcharte con la Alianza o con la Horda.‡‡Parlez à l\'Esprit de maître Shang Xi et choisissez si vous voulez partir avec l\'Alliance ou la Horde.‡和尚喜师父的灵魂谈一谈，然后选择加入联盟，还是部落。‡',
  }
},
[31451] = {
  {
    'O mercador desaparecido‡Пропавший торговец‡Der vermisste Händler‡사라진 상인‡El mercader perdido‡‡Un marchand porté disparu‡失踪的商人‡',
    nil,
    'Fale novamente com o Mercador Shi na Lagoa Guelra-pintada, que fica no Monte Kun-Lai. Uma‡Поговорите с торговцем Ши у озера Чернильной Жабры на вершине Кунь-Лай. Награда: .‡Sprecht mit Händler Shi am Tintenkiemenweiher am Kun-Lai-Gipfel.‡쿤라이 봉우리의 먹물아가미 호수에 있는 상인 스와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el mercader Shi en la Presa Branquias de Tinta, en la Cima Kun-Lai.‡‡Parlez au Marchand Shi à l\'Étang des Branchies-d\'encre, au Sommet de Kun-Lai.‡去昆莱山的墨鳃潭和商人施禄谈一谈。‡',
  }
},
[31452] = {
  {
    'O mercador desaparecido‡Пропавший торговец‡Der vermisste Händler‡사라진 상인‡El mercader perdido‡‡Shi, cané ?‡失踪的商人‡',
    nil,
    'Fale novamente com o Mercador Shi na Lagoa Guelra-pintada, que fica no Monte Kun-Lai. Uma‡Поговорите с торговцем Ши у озера Чернильной Жабры на вершине Кунь-Лай. Награда: .‡Sprecht mit Händler Shi am Tintenkiemenweiher am Kun-Lai-Gipfel.‡쿤라이 봉우리의 먹물아가미 호수에 있는 상인 스와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el mercader Shi en la Presa Branquias de Tinta, en la Cima Kun-Lai.‡‡Parlez au Marchand Shi à l\'Étang des Branchies-d\'encre, au Sommet de Kun-Lai.‡去昆莱山的墨鳃潭和商人施禄谈一谈。‡',
  }
},
[31453] = {
  {
    'Os shado-pans‡Шадо-Пан‡Die Shado-Pan‡음영파‡El Shadopan‡‡Les Pandashan‡影踪派‡',
    nil,
    'Fale com o Shado-Mestre Chong no Refúgio Shado-Pan, que fica na Gruta Galhareda. Uma‡Поговорите с шадо-мастером Чуном в оплоте Шадо-Пан в убежище Огненной Ветви. Награда: .‡Sprecht mit Shado-Meister Chong am Shado-Pan-Rückzug in Feuerzweigwinkel.‡파이어바우 변두리마을의 음영파 퇴각지에 있는 음영사부 총과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el maestro Shado Chong en la Retirada del Shadopan, en el Rincón Tallo Ardiente.‡‡Parlez au Maître-pandashan Chong à la Retraite des Pandashan, dans la Retraite de Rameau-de-Feu.‡去火树村的影踪别院和影踪派翀大师谈一谈。‡',
  }
},
[31454] = {
  {
    'A construção de uma lenda‡Так рождается легенда‡Eine Legende im Werden‡시작되는 전설‡Una leyenda en ciernes‡‡Naissance d\'une légende‡创造传奇‡',
    nil,
    'Beba uma rodada com Wrathion. É por conta dele.‡Выпейте с Гневионом. Он угощает.‡Lasst Euch von Furorion einen ausgeben und trinkt mit ihm.‡래시온과 한잔해야 합니다. 물론 래시온이 삽니다.‡Toma un trago con Wrathion. Él invita.‡‡Prenez un verre avec Irion. C\'est sa tournée.‡和拉希奥喝一杯。他请客。‡',
  }
},
[31455] = {
  {
    'Os shado-pans‡Шадо-Пан‡Die Shado-Pan‡음영파‡El Shadopan‡‡Les Pandashan‡影踪派‡',
    nil,
    'Fale com o Shado-Mestre Chong no Refúgio Shado-Pan, que fica na Gruta Galhareda. Uma‡Поговорите с шадо-мастером Чуном в оплоте Шадо-Пан в убежище Огненной Ветви. задание.‡Sprecht mit Shado-Meister Chong am Shado-Pan-Rückzug in Feuerzweigwinkel.‡파이어바우 변두리마을의 음영파 퇴각지에 있는 음영사부 총과 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el maestro Shado Chong en la Retirada del Shadopan, en el Rincón Tallo Ardiente.‡‡Parlez au Maître-pandashan Chong à la Retraite des Pandashan, dans la Retraite de Rameau-de-Feu.‡去火树村的影踪别院和影踪派翀大师谈一谈。‡',
  }
},
[31456] = {
  {
    'Rancho do Almiscarado‡Ферма Мускусной Лапы‡Gehöft Moschuspranke‡머스크포우 목장‡Rancho Zarpa Lanuda‡‡L\'élevage Patte Musquée‡麝香爪牧场‡',
    nil,
    'Viaje até o Rancho do Almiscarado, que fica no Monte Kun-Lai, e fale com Lao Almiscarado. Uma‡Отправляйтесь на ферму Мускусной Лапы, что на вершине Кунь-Лай, и поговорите там с Лао Мускусной Лапой.‡Reist zum Gehöft Moschuspranke am Kun-Lai-Gipfel und sprecht dort mit Lao Moschuspranke.‡쿤라이 봉우리에 있는 머스크포우 목장으로 가서 라오 머스크포우와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Viaja hasta el Rancho Zarpa Lanuda en la Cima Kun-Lai y habla con Lao Zarpa Lanuda.‡‡Allez à l\'Élevage Patte Musquée sur le Sommet de Kun-Lai et parlez à Lao Patte Musquée.‡前往昆莱山的麝香爪牧场，和老麝香爪谈一谈。‡',
  }
},
[31457] = {
  {
    'Rancho do Almiscarado‡Ферма Мускусной Лапы‡Gehöft Moschuspranke‡머스크포우 목장‡Rancho Zarpa Lanuda‡‡L\'élevage Patte Musquée‡麝香爪牧场‡',
    nil,
    'Viaje até o Rancho do Almiscarado, que fica no Monte Kun-Lai, e fale com Lao Almiscarado. Uma‡Отправляйтесь на ферму Мускусной Лапы, что на вершине Кунь-Лай, и поговорите там с Лао Мускусной Лапой.‡Reist zum Gehöft Moschuspranke am Kun-Lai-Gipfel und sprecht dort mit Lao Moschuspranke.‡쿤라이 봉우리에 있는 머스크포우 목장으로 가서 라오 머스크포우와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Viaja hasta el Rancho Zarpa Lanuda en la Cima Kun-Lai y habla con Lao Zarpa Lanuda.‡‡Allez à l\'Élevage Patte Musquée sur le Sommet de Kun-Lai et parlez à Lao Patte Musquée.‡前往昆莱山的麝香爪牧场，和老麝香爪谈一谈。‡',
  }
},
[31458] = {
  {
    'Controle de danos‡Устранение ущерба‡Schadenskontrolle‡피해 대책‡Control de daños‡‡Gestion des risques‡减少损失‡',
    nil,
    'Destrua 5 Sussurrantes Ik\'thik e desative o Sinalizador de Kypari Ik. Uma‡Убейте 5 ик\'тиков-шептателей и выведите из строя маяк Кипари Ик.‡Vernichtet 5 Flüsterer der Ik\'thik und deaktiviert das Signalfeuer von Kypari Ik.‡이크티크 전령 5마리를 처치하고 키파리 이크 봉화를 비활성화시켜야 합니다. 레벨 30 공포의 황무지‡Acaba con 5 susurradores Ik\'thik y desactiva la baliza del kypari Ik.‡‡Détruisez 5 Chuchoteurs ik’thik et désactivez la Balise de Kypari Ik.‡杀死5名伊克提克耳语者，停用凯帕圣树·伊克信标。‡',
  }
},
[31459] = {
  {
    'Missiva de Cho‡Послание от Чо‡Chos Schreiben‡초의 전갈‡La misiva de Cho‡‡Certains aiment Cho‡周卓的书信‡',
    nil,
    'Fale com o Andarilho das Lendas Cho em Barriluno, que fica no Monte Kun-Lai. Uma‡Поговорите с хранителем истории Чо в Пэй-Лэй на вершине Кунь-Лай.‡Sprecht mit Lehrensucher Cho in Einfass am Kun-Lai-Gipfel.‡쿤라이 봉우리의 맥주통 휴게소에 있는 전승지기 초와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el eremita Cho en Barrilia, en la Cima Kun-Lai.‡‡Parlez au Chroniqueur Cho à Monofu au Sommet de Kun-Lai.‡去昆莱山的酒坛集和游学者周卓谈一谈。‡',
  }
},
[31460] = {
  {
    'Missiva de Cho‡Послание от Чо‡Chos Schreiben‡초의 전갈‡La misiva de Cho‡‡Certains aiment Cho‡周卓的书信‡',
    nil,
    'Fale com o Andarilho das Lendas Cho em Barriluno, que fica no Monte Kun-Lai. Uma‡Поговорите с хранителем истории Чо в Пэй-Лэй на вершине Кунь-Лай.‡Sprecht mit Lehrensucher Cho in Einfass am Kun-Lai-Gipfel.‡쿤라이 봉우리의 맥주통 휴게소에 있는 전승지기 초와 대화해야 합니다. 레벨 20 쿤라이 봉우리‡Habla con el eremita Cho en Barrilia, en la Cima Kun-Lai.‡‡Parlez au Chroniqueur Cho à Monofu au Sommet de Kun-Lai.‡去昆莱山的酒坛集和游学者周卓谈一谈。‡',
  }
},
[31461] = {
  {
    'Falou com Xuen‡Spoke with Xuen‡Mit Xuen gesprochen‡쉬엔과 대화했음‡Tras hablar con Xuen‡‡A parlé à Xuen‡已经和雪怒交谈‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[31462] = {
  {
    'Espírito da Violência derrotado‡Spirit of Violence Defeated‡Geist der Gewalt besiegt‡폭력의 영혼 꺾음‡Espíritu de la violencia derrotado‡‡Esprit de violence vaincu‡击败暴虐之灵‡',
