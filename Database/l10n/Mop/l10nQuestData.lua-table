[32105] = {
  {
    'Lápide Monumental Impecável‡Безупречная надгробная плита‡Makelloses Kassenbuch eines Architekten‡온전한 기념물 장부‡Libro de monumentos prístino‡‡Grand livre en parfait état‡完好如初的石碑底座‡',
    nil,
    'Colocar o artefato em exibição. Uma‡Выставите артефакт на обозрение. это‡Stellt das Artefakt zur Schau.‡유물을 전시해야 합니다. 레벨 10‡Expón el artefacto.‡‡Exposez l’artéfact.‡将神器进行展览。‡',
  }
},
[32106] = {
  {
    'Um presente de Véu de Inverno‡Подарок к Зимнему Покрову‡Ein Winterhauchgeschenk‡겨울맞이 선물‡Un obsequio del Festival de Invierno‡‡Un cadeau du Voile d’hiver‡冬幕节礼物‡',
    nil,
    'Véu de Inverno de missão. Premia Presente do Véu de Inverno. Adicionado em World of Warcraft: Mists of Pandaria. Sempre atualizado com o último patch.‡задание из категории Зимний Покров. Награда: Подарок к Зимнему Покрову. Всегда актуальная информация.‡‡겨울맞이 축제‡Una misión de Festival de Invierno. Otorga Obsequio del Festival de Invierno como recompensa. Añadido en World of Warcraft: Mists of Pandaria.‡‡Une quête de Voile d\'hiver. Donne Cadeau du Voile d\'hiver en récompense. Ajouté dans World of Warcraft : Mists of Pandaria. Toujours à jour.‡‡',
  }
},
[32107] = {
  {
    'Gourami-tigre voador‡Летающий тигровый гурами‡Fliegender Tigergurami‡나는 호랑이 구라미‡Gurami tigre volador‡‡Gourami tigre volant‡飞行虎皮丝足鱼‡',
    nil,
    'Leve o Gourami-tigre Voador para Nat Pagle no Cais dos Pescadores. Uma‡Отнесите летающего тигрового гурами Нату Пэглу в Деревню рыболовов. это‡Bringt den fliegenden Tigergurami zu Nat Pagle an der Anlegestelle der Angler.‡강태공 부두에 있는 내트 페이글에게 나는 호랑이 구라미를 가져가야 합니다. 레벨 15‡Lleva el gurami tigre volador a Nat Pagle al Muelle de los Pescadores.‡‡Apportez le Gourami tigre volant à Nat Pagle au Quai des Hameçonneurs.‡把飞行虎皮丝足鱼交给渔人码头的纳特·帕格。‡',
  }
},
[32108] = {
  {
    'Ponto de Dominação‡Крепость Покорителей‡Herrschaftsfeste‡지배령 거점‡El Punto de Dominio‡‡Halte de la Domination‡统御岗哨‡',
    nil,
    'Acenda o Sinal de Fumaça na praia do Local de Pouso da Horda para sinalizar para a frota da Horda. Uma‡Зажгите сигнальный огонь на берегу в Точке высадки Орды, чтобы подать сигнал флоту Орды.‡Zündet das Signalfeuer am Strand der Landezone der Horde an, um der Flotte ein Zeichen zu senden.‡호드 상륙지에 있는 봉화에 불을 붙여 호드 함대에 신호를 보내야 합니다. 레벨 15‡Enciende la señal de fuego en la playa del Lugar del Desembarco de la Horda para avisar a la flota de la Horda.‡‡Allumez le Feu de signal sur la plage du Lieu de débarquement de la Horde pour faire signe à la flotte de la Horde.‡点燃海滩上部落登陆点的烽火，给部落舰队发信号。‡',
  }
},
[32109] = {
  {
    'Ancoradouro do Leão‡Львиный лагерь‡Löwenlandung‡사자의 상륙지‡El Desembarco del León‡‡Le territoire du Lion‡雄狮港‡',
    nil,
    'Use o Lançador de Sinalizador na Angra de Krasarang e sinalize para a frota da Aliança. Uma‡Воспользуйтесь установкой для запуска сигнальных ракет в Красарангской бухте, чтобы подать сигнал флоту Альянса.‡Signalisiert der Flotte der Allianz in der Krasarangbucht mit einem Abschussgerät für Leuchtfeuer.‡크라사랑 만에서 신호탄 발사대를 사용해 얼라이언스 함대에 신호를 보내야 합니다. 레벨 15‡Utiliza el lanzador de bengalas en la Cala Krasarang para avisar a la flota de la Alianza.‡‡Utilisez le Lance-fusées dans la Crique de Krasarang pour faire signe à la flotte de l’Alliance.‡在卡桑琅海湾使用信号弹发射器给联盟舰队发信号。‡',
  }
},
[32112] = {
  {
    'FLAG - Foi ao Clube da Luta‡FLAG - Been to Fight Club‡FLAG - Been to Fight Club‡플래그 - 싸움꾼 조합 간 적 있음‡FLAG - Been to Fight Club‡‡DRAPEAU - Visite chez les Bastonneurs‡FLAG - Been to Fight Club‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[32113] = {
  {
    'FLAG - Foi ao Clube da Luta Hoje‡FLAG - Been to Fight Club Today‡FLAG - Been to Fight Club Today‡플래그 - 싸움꾼 조합 간 적 있음 (오늘)‡FLAG - Been to Fight Club Today‡‡DRAPEAU - Visite chez les Bastonneurs aujourd’hui‡FLAG - Been to Fight Club Today‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[32114] = {
  {
    'Quer dizer que você quer testar as diárias?‡Так ты хочешь потестировать ежедневные задания ?‡Du willst also tägliche Quests ausprobieren?‡일일 퀘스트를 테스트하고 싶은가요?‡¿Así que querías probar misiones diarias?‡‡Alors, vous voulez essayer les quêtes journalières ?‡你想测试日常任务？‡',
    nil,
    'Uma‡это‡‡레벨 1‡‡‡‡‡',
  }
},
[32115] = {
  {
    'Grilhões do passado‡Узы прошлого‡Fesseln der Vergangenheit‡과거의 족쇄‡Las cadenas del pasado‡‡Les chaînes du passé‡旧日的枷锁‡',
    nil,
    'Liberte 14 Espíritos de Escravo Atormentado. Uma‡Освободите 14 беспокойных духов рабов. это‡Befreit 14 aufgewühlte Sklavengeister.‡괴로워하는 노예 영혼 14명을 풀어줘야 합니다. 레벨 15‡Libera a 14 espíritus esclavos atribulados.‡‡Libérez 14 Esprits asservis troublés.‡解救14个不安的灵奴。‡',
  }
},
[32116] = {
  {
    'Olha as prioridades, pessoal!‡Не забываем о приоритетах!‡Prioritäten vonnöten!‡급한 것 먼저!‡¡Lo primero es lo primero!‡‡Réévaluer ses priorités‡救人要紧！‡',
    nil,
    'Encontre-se com Hilda Traquitana nas Ruínas de Ogudei, que ficam na Selva de Krasarang. Uma‡Встретьтесь с Хильдой Хорнсвоггл на Руинах Огудея в Красарангских джунглях.‡Trefft Euch mit Hilda Hornsturz bei den Ruinen von Ogudei in der Krasarangwildnis.‡크라사랑 밀림의 오구데이 폐허에 있는 힐다 혼스웨글을 만나야 합니다. 레벨 15‡Reúnete con Hilda Brindacuerno en las Ruinas de Ogudei, en la Espesura Krasarang.‡‡Allez voir Hilda cornegidouille au Ruines d’Ogudei, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的敖骨打废墟找希尔达·盘角。‡',
  }
},
[32118] = {
  {
    'Levando vantagem‡Воспользоваться преимуществом‡Den Vorteil nutzen‡이점을 노려라‡Aprovecharse‡‡Profitons-en !‡伺机而动‡',
    nil,
    'Use o portal no Posto Avançado Foguetelouco para se encontrar com Kaelis Planassol nas Ruínas de Ogudei, que fica na Selva de Krasarang. Premia .‡Зайдите в портал на аванпосте Искрожига и встретьтесь с Келисом Солнечным Полетом на руинах Огудея, что в Красарангских джунглях.‡Benutzt das Portal im Außenposten Zündmine, um Euch bei den Ruinen von Ogudei in der Krasarangwildnis mit Kaelis Segelstrahl zu treffen. Entlohnt .‡스파크로켓 전초기지에 있는 차원문을 타고 이동해 크라사랑 밀림의 오구데이 폐허에 있는 캐리스 선소어를 만나야 합니다.‡Utiliza el portal de la Avanzada de Chispamisil para reunirte con Kaelis Encumbrasol en las Ruinas de Ogudei, en la Espesura Krasarang. Otorga  como recompensa.‡‡Utilisez le portail de l’Avant-poste de Grilletorpille pour rejoindre Kaelis Lever-de-Soleil aux Ruines d’Ogudei, dans les Étendues sauvages de Krasarang.‡使用火箭岗哨的传送门去卡桑琅丛林的敖骨打废墟找凯利斯·舞阳。‡',
  }
},
[32119] = {
  {
    'É um mistério‡Это загадка‡Mysteriös‡기이한 일‡Es un misterio‡‡C’est un mystère‡这是个谜‡',
    nil,
    'Use o Rastreador de Anomalias da Hilda para dissipar uma anomalia. Uma‡Воспользуйтесь детектором аномалии, который дала вам Хильда, и уничтожьте аномалию.‡Benutzt Hildas Anomaliensucher, um eine Anomalie zu finden und zu neutralisieren.‡힐다의 거리 추적기를 사용해 이상 물체를 찾아 처치해야 합니다. 레벨 15‡Utiliza el rastreador de anomalías de Hilda para encontrar y dispersar una anomalía.‡‡Utilisez le Détecteur d’anomalie de Hilda pour découvrir et disperser une anomalie.‡使用希尔达的异常跟踪器，找到并消灭异形体。‡',
  }
},
[32120] = {
  {
    'Legado de Ogudei‡Наследие Огудея‡Das Vermächtnis von Ogudei‡오구데이의 유물‡El legado de Ogudei‡‡L’héritage d’Ogudei‡敖骨打的遗产‡',
    nil,
    'Colete 5 Essências Mogus Ancestrais. Uma‡Соберите 5 древних частиц духов могу. это‡Sammelt 5 uralte Moguessenzen.‡고대 모구 정수 5개를 수집해야 합니다. 레벨 15‡Reúne 5 esencias mogu antiguas.‡‡Récupérez 5 Antiques essences de mogu.‡收集5份古代魔古精华。‡',
  }
},
[32121] = {
  {
    'A armadilha espiritual‡Ловушка для духа‡Die Geisterfalle‡영혼 덫‡Trampa para espíritus‡‡Le piège à esprit‡灵魂陷阱‡',
    nil,
    'Destrua 3 Armadilhas Espirituais. Uma‡Уничтожьте 3 ловушки для духов. это‡Zerstört 3 Geisterfallen.‡영혼 덫 3개를 파괴해야 합니다. 레벨 15‡Destruye 3 trampas para espíritus.‡‡Détruisez 3 Pièges à esprit.‡摧毁3个灵魂陷阱。‡',
  }
},
[32122] = {
  {
    'Os tenentes de Ogudei‡Служители Огудея‡Ogudeis Leutnants‡오구데이의 부관들‡Los tenientes de Ogudei‡‡Les lieutenants d’Ogudei‡敖骨打的副官‡',
    nil,
    'Mate Meng-do, a Força das Montanhas, e Gen-li, o Distorcedor de Palavras. Uma‡Убейте Мэн-до, Силу Гор, и Гэнь-ли, Играющего со Словами. это‡Tötet Meng-do, die Stärke des Berges und Gen-li, Verdreher von Worten.‡산의 투사 멩도와 뒤틀린 진언자 겐리를 처치해야 합니다. 레벨 15‡Mata a Meng-do, Fuerza de las Montañas, y a Gen-li, el Tergiversador.‡‡Tuez Meng Do, Force des montagnes et Gen Li, le Déformeur de mots.‡击败担山力士孟都和织谎者庚离。‡',
  }
},
[32123] = {
  {
    'A morte vem a pé mesmo‡Стоять насмерть‡Tod auf zwei Beinen‡걸어다니는 죽음‡La muerte en pie‡‡Lutte à mort‡死战到底‡',
    nil,
    'Derrote 10 soldados da Aliança no Ponto de Dominação. Uma‡Уничтожьте 10 солдат Альянса в Крепости Покорителей. это‡Besiegt 10 Soldaten der Allianz in der Herrschaftsfeste.‡지배령 거점에서 얼라이언스 병사 10명을 처치해야 합니다. 레벨 15‡Derrota a 10 soldados de la Alianza en el Punto de Dominio.‡‡Tuez 10 Soldats de l’Alliance à la Halte de la Domination.‡在统御岗哨击败10名联盟士兵。‡',
  }
},
[32125] = {
  {
    'Não tente tanto - DEPRECATED‡Don\'t Try So Hard - DEPRECATED‡Don\'t Try So Hard - DEPRECATED‡‡No te esfuerces tanto - DEPRECATED‡‡Ne faites pas autant d’efforts‡‡',
    nil,
    'Mate 8 Sabotadores da AVIN. Uma‡Убейте 8 саботажников ШРУ. это‡Kill 8 SI:7 Saboteurs.‡‡Mata a 8 saboteadores del IV:7.‡‡Tuez 8 Saboteurs du SI:7.‡‡',
  }
},
[32126] = {
  {
    'Estraçalhando‡Разбить ящики‡Zeigt, was Ihr könnt‡태우고 부숴라‡En ruinas‡‡Envie de tout casser‡破灭的希望‡',
    nil,
    'Destrua 8 Cargas de Suprimentos da Aliança. Uma‡Уничтожьте 8 поставок Альянса. это‡Zerstört 8 Versorgungsgüter der Allianz.‡투하된 얼라이언스 보급품 8개를 파괴해야 합니다. 레벨 15‡Destruye 8 envíos de suministros de la Alianza.‡‡Détruisez 8 Points d’approvisionnement de l’Alliance.‡摧毁8个联盟空投补给。‡',
  }
},
[32127] = {
  {
    'Cabeças vão rolar‡Все мертвы, все мертвы‡Tot, alle tot‡그리고 아무도 없었다‡Todos muertos, todos muertos‡‡Arrêt de mort‡统统干掉‡',
    nil,
    'Derrote o Capitão Brent, o Negro, e o Capitão Mulkey. Uma‡Победите капитана Брента Черного и капитана Малки. это‡Besiegt Kapitän Brent der Schwarze und Kapitänin Mulkey.‡검은 선장 브렌트와 선장 멀키를 처치해야 합니다. 레벨 15‡Derrota al capitán Brent el Negro y a la capitana Mulkey.‡‡Tuez le Capitaine Brent le Noir et le Capitaine Pétarade.‡击败“黑炭”布伦特船长和马尔基船长。‡',
  }
},
[32128] = {
  {
    'O efeito devastador do pó‡Еще один урок‡Schon wieder beißt einer ins Gras‡또 한 놈이 쓰러진다‡Otro que muerde el polvo‡‡Faites-leur mordre la poussière‡又干掉一个‡',
    nil,
    'Detone a carga explosiva da Desafiadora e do Fio do Valor. Uma‡Уничтожьте взрывоопасный груз на "Непокорном" и на "Клинке Доблести". это‡Jagt die explosive Ladung der Kühnheit und der Klinge der Tapferkeit in die Luft.‡무법자호와 용맹의 칼날호에 있는 폭발물을 폭파하십시오. 레벨 15‡Detona el cargamento de explosivos de El Desafiante y la Frontera del Valor.‡‡Faites exploser les Réserves de poudre à bord de l’Insurgé et de l’Éperon des Vaillants.‡引爆挑战号和无畏界限号上的爆炸品。‡',
  }
},
[32129] = {
  {
    'Diária de Defesa 06‡Defense Daily 06‡Tägliche Verteidigung 06‡일일 방어 06‡Defense Daily 06‡‡Défense quotidienne 06‡‡',
    nil,
    'Uma‡это‡‡레벨 15‡‡‡‡‡',
  }
},
[32130] = {
  {
    'Boa sorte, divirta-se‡Богатое месторождение‡Viel Glück, viel Spaß‡취향이라고. 존중해줘!‡Buena suerte y diviértete‡‡Bonne chance et amusez-vous !‡祝你好运，好好享受‡',
    nil,
    'Colete 10 Orelhas da Aliança Cheias de Cera no Ancoradouro do Leão, que fica na Selva de Krasarang. Uma‡Соберите 10 толстых ушей Альянса во Львином лагере, что в Красарангских джунглях.‡Sammelt 10 besonders schmalzige Allianzohren in der Löwenlandung in der Krasarangwildnis.‡크라사랑 밀림의 사자의 상륙지에서 얼라이언스 귀걸이 10개를 수집해야 합니다. 레벨 15‡Reúne 10 orejas de la Alianza extra cerosas en el Desembarco del León, en la Espesura Krasarang.‡‡Collectez 10 Oreilles de l’Alliance extra-cireuses au Territoire du Lion, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的雄狮港收集10个闪亮联盟耳环。‡',
  }
},
[32131] = {
  {
    'Precisamos de mais minérios!‡Нам нужно больше минералов‡Wir brauchen mehr Mineralien‡광물이 모자랍니다!‡Necesitamos más minerales‡‡Il nous faut plus de minerai !‡我们要更多的矿石！‡',
    nil,
    'Colete 20 pedaços de Pedra Animável na Pedreira do Ancoradouro do Leão. Os engenheiros do Ancoradouro do Leão carregam as pedras, e você também pode explodir os pedaços de pedra com dano colateral para parti-los em pedaços pequenos que você possa carregar.‡Соберите 20 живых камней в карьере Львиного лагеря. Их можно забрать у инженеров из Львиного лагеря или добыть, взрывая раскопоботов возле каменных глыб.‡Besorgt 20 Brocken belebbaren Steins aus dem Steinbruch der Löwenlandung. Ihr findet sie bei Ingenieuren der Löwenlandung, die sie tragen, oder Ihr könnt Steinplatten mithilfe von Kollateralschaden in tragbare Brocken sprengen.‡사자의 상륙지 채석장에서 생명이 깃든 돌 20개를 수집해야 합니다. 생명이 깃든 돌은 사자의 상륙지 기술자들에게서 획득하거나, 발파로봇으로 암석을 폭파시켜 얻을 수 있습니다.‡Reúne 20 trozos de piedra animable en la cantera del Desembarco del León. Los llevan los ingenieros de Desembarco del León, pero también puedes destruir bloques de piedra con daños colaterales para que se rompan en pedazos que puedas llevarte contigo.‡‡Récupérez 20 morceaux de Pierre viable à la carrière du Territoire du Lion sur des Ingénieurs du Territoire du Lion. Vous pouvez également détruire des dalles de pierre grâce aux dégâts collatéraux qui les feront exploser en morceaux pouvant être transportés.‡收集20块松动的石头。石头可以在雄狮港工程师身上找到，或者摧毁石板附近的雄狮港挖掘者，把石板炸成便于携带的小块岩石。‡',
  }
},
[32132] = {
  {
    'Assédio aos trabalhadores‡Травля рабочих‡Arbeiterschikane‡노동력 학살‡Acoso laboral‡‡Massacre paysan‡骚扰工人‡',
    nil,
    'Mate 30 Camponeses do Ancoradouro do Leão. Uma‡Убейте 30 крестьян из Львиного лагеря. это‡Tötet 30 Arbeiter der Löwenlandung.‡사자의 상륙지 인부 30명을 처치해야 합니다. 레벨 15‡Mata a 30 campesinos del Desembarco del León.‡‡Tuez 30 Paysans du territoire du Lion.‡击败30名雄狮港农夫。‡',
  }
},
[32133] = {
  {
    'Proteções de sentinela‡Наблюдательные тотемы‡Wächterschutz‡감시의 수호물‡Resguardos avizores‡‡Gardiens factionnaires‡真视之眼‡',
    nil,
    'Coloque Proteções de Sentinela nas Docas, na Prefeitura e no Segundo Andar do Quartel do Ancoradouro do Leão. Uma‡Установите наблюдательные тотемы на пристани, в ратуше и на втором этаже казарм Львиного лагеря.‡Stellt auf den Docks, im Rathaus und im zweiten Geschoss der Kaserne in der Löwenlandung Wächterschutze auf.‡사자의 상륙지에 있는 부두, 마을회관, 그리고 병영 2층에 감시의 수호물을 설치해야 합니다. 레벨 15‡Coloca resguardos avizores en los muelles, en el concejo y en el segundo piso del barracón del Desembarco del León.‡‡Placez des Gardiens factionnaires sur les Quais, à l’Hôtel de ville, et au deuxième étage de la Caserne au Territoire du Lion. Un(e) quête.‡将真视之眼放置在雄狮港的码头、市政厅和兵营二层。‡',
  }
},
[32134] = {
  {
    'Contra-ataque ferrenho‡Жесткий отпор‡Hart gekontert‡절대천적‡Contraataque intenso‡‡Riposte fulgurante‡棋逢对手‡',
    nil,
    'Mate 8 Engenheiros da Equipe de Morteiros do Ancoradouro do Leão e destrua 2 Tubos de Morteiro do Ancoradouro do Leão. Uma‡Убейте 8 инженеров дворфийских орудий и 2 дворфийские мортиры Львиного лагеря.‡Tötet 8 Mörserteamingenieure der Löwenlandung und zerstört 2 Mörserrohre der Löwenlandung.‡사자의 상륙지 박격포부대 기술자 8명을 처치하고 사자의 상륙지 박격포 2대를 파괴해야합니다. 레벨 15‡Mata a 8 ingenieros de equipo de morteros del Desembarco del León y destruye 2 tubos de mortero del Desembarco del León.‡‡Tuez 8 Ingénieurs de mortier du Territoire du Lion et détruisez 2 Tubes de mortier du Territoire du Lion.‡击败8名雄狮港迫击炮小队工程师并摧毁2座雄狮港迫击炮。‡',
  }
},
[32135] = {
  {
    'Matador de heróis‡Смерть героям!‡Heldenmörder‡영웅을 쓰러뜨리는 영웅‡Asesino de héroes‡‡Tueur de héros‡英雄杀手‡',
    nil,
    'Mate um Herói da Aliança no Ancoradouro do Leão, que fica na Selva de Krasarang. Uma‡Убейте героя Альянса во Львином лагере, что в Красарангских джунглях. это‡Tötet einen Helden der Allianz an der Löwenlandung in der Krasarangwildnis.‡크라사랑 밀림의 사자의 상륙지에서 얼라이언스 영웅 한 명을 처치해야 합니다. 레벨 15‡Mata a un héroe de la Alianza en el Desembarco del León, en la Espesura Krasarang.‡‡Tuez un Héros de l’Alliance au Territoire du Lion, dans les Étendues sauvages de Krasarang.‡去卡桑琅丛林的雄狮港击败一名联盟英雄。‡',
  }
},
[32136] = {
  {
    'Ordem de Serviço: Combustível‡Заказ: топливо‡Arbeitsauftrag: Treibstoff‡주문서: 연료‡Pedido de combustible‡‡Commande : carburant‡‡',
    nil,
    'Encontre Grislo Engrenário na Praia Borraquilha. Uma‡Найдите Гриззла Скрипетола на пляже Трюмных Вод. это‡Findet Grizzle Radflutsch am Bilgewasserstrand.‡빌지워터 해변에 있는 그리즐 기어슬립을 찾아야 합니다. 레벨 15‡Encuentra a Llorica Tuercafloja en Playa Pantoque.‡‡Trouvez Geignard Glissécrou à la Plage Baille-Fonds.‡‡',
  }
},
[32137] = {
  {
    'Saindo pelo ladrão‡Топливо на исходе‡Kein Sprit mehr‡어떻게 하나‡Depósito vacío‡‡À sec !‡‡',
    nil,
    'Recupere 9 Barris de Combustível \'Destilado\' no Vertedouro Areia Negra. Uma‡Соберите 9 бочек с "очищенным" топливом в Водосливе Черных Песков. это‡Bergt 9 Fässer mit "Destilliertem" Treibstoff vom Schwarzsandüberlauf.‡검은모래 여수로에서 "증류된" 연료 통 9개를 회수해야 합니다. 레벨 15‡Recupera 9 barricas de combustible "destilado" en el Aliviadero Gravanegra.‡‡Récupérez 9 Barils de carburant « distillé » au Déversoir de Noirsang.‡‡',
  }
},
[32138] = {
  {
    'Ordem de serviço: madeira serrada‡Заказ: лес‡Arbeitsauftrag: Holz‡주문서: 목재‡Pedido de leña‡‡Commande : bois‡‡',
    nil,
    'Encontre Zino Picadinho, o Fatiador, na Fazenda da Serraria. Uma‡Найдите Зино "Крошшера" Скоротяпеля на лесопилке. это‡Findet Zino "den Schredder" Blitzbeil auf dem Holzhof.‡퀵촙의 목재소에 있는 "벌목꾼" 지노 퀵촙을 찾아야 합니다. 레벨 15‡Encuentra a Zino "Triturador" Hachaveloz en el Aserradero.‡‡Trouvez Zino « le déchiqueteur » Hachémenu à la Ferme d’abattage.‡‡',
  }
},
[32139] = {
  {
    'Empilhado!‡Лесозаготовка‡Gestapelt!‡적군이 우글우글‡¡A talar!‡‡Commande effectuée !‡加班加点！‡',
    nil,
    'Colete 9 Pedaços de Madeira do Ponto de Dominação na Fazenda da Serraria. Uma‡Соберите 9 досок Крепости Покорителей на Лесопилке Скоротяпеля. это‡Sammelt 9 Stücke Bauholz der Herrschaftsfeste auf dem Holzhof.‡퀵촙의 목재소에서 지배령 거점 목재 9개를 모아야 합니다. 레벨 15‡Reúne 9 piezas de leña del Punto de Dominio del Aserradero.‡‡Récoltez 9 morceaux de Bois de coupe de la Halte de la Domination à la Ferme d’abattage.‡在伐木场收集9堆统御岗哨木材。‡',
  }
},
[32140] = {
  {
    'Ordem de Serviço: Ferro‡Заказ: руда‡Arbeitsauftrag: Eisen‡주문서: 철‡Pedido de hierro‡‡Commande : fer‡作业订单：铁矿‡',
    nil,
    'Encontre Daxil Quebraferro, a "Gema", perto da Escavação de Quebraferro. Uma‡Найдите "Бриллиантовую" Дакси Рудогрызь у карьера Рудогрызя". это‡Findet Daxil "Klunker" Erzschleif bei Erzschleifs Grabung.‡오어그라인드의 채굴지 근처에서 "보석" 닥실 오어그라인드를 찾아야 합니다. 레벨 15‡Encuentra a Daxil "Alhaja" Picamena cerca de la Excavación de Picamena.‡‡Allez trouver Daxil « la Gemme » Rochégrise près du Site de fouilles de Rochégrise.‡去奥格林德挖掘场附近找“宝石”达克希尔·研矿。‡',
  }
},
[32141] = {
  {
    'Metal brutal‡Мощный металл‡Energetisches Metall‡힘이 담긴 금속‡El poder del metal‡‡La puissance du métal‡能量金属‡',
    nil,
    'Obtenha 7 pedaços de Minério Energizado da Escavação de Quebraferro. Uma‡Соберите 7 кусков заряженной руды в карьере Рудогрызя. это‡Besorgt 7 aufgeladene Eisenerzklumpen aus Erzschleifs Grabung.‡오어그라인드의 채굴지에서 기운이 주입된 철 광석 7개를 모아야 합니다. 레벨 15‡Consigue 7 trozos de mena energizada en la Excavación de Picamena.‡‡Récupérez 7 morceaux de Minerai énergisé au Site de fouilles de Rochégrise.‡在奥格林德挖掘场获得7块充能铁矿石。‡',
  }
},
[32142] = {
  {
    'A cobra vai fumar‡Разрушительная мощь‡Bis zum felsigen Ende‡혼쭐을 내주마‡Muerte al orco‡‡Ça va secouer !‡干掉他们！‡',
    nil,
    'Mate 10 Orcs no Ponto de Dominação. Uma‡Убейте 10 орков в Крепости Покорителей. это‡Tötet 10 Orcs an der Herrschaftsfeste.‡지배령 거점에서 오크 10명을 처치해야 합니다. 레벨 15‡Mata a 10 orcos en el Punto de Dominio.‡‡Tuez 10 Orcs à la Halte de la Domination.‡在统御岗哨击败10个兽人。‡',
  }
},
[32143] = {
  {
    'Uma certa magia‡Некая магия‡Erkund-o-magie‡위대한 과학의 힘‡Es magia‡‡Un tour de magie‡神奇魔法‡',
    nil,
    'Encontre os três Mensuradores no Ponto de Dominação. Uma‡Найдите 3 разведбота в крепости Покорителей. это‡Findet die drei Erkund-o-meter in der Herrschaftsfeste.‡지배령 거점에서 정찰로봇 3기를 찾아야 합니다. 레벨 15‡Encuentra las tres asediomáticas del Punto de Dominio.‡‡Trouvez 3 Explore-matics à la Halte de la Domination.‡在统御岗哨找到3个探查器。‡',
  }
},
[32144] = {
  {
    'Sob pressão‡Враг под напором‡Mit Hochdruck‡궁지로 몰아넣기‡Bajo presión‡‡Sous pression‡重压之下‡',
    nil,
    'Destrua 8 Caixotes de Suprimentos da Horda. Uma‡Уничтожьте 8 ящиков с припасами Орды. это‡Zerstört 8 Vorratskisten der Horde.‡호드 보급품 상자 8개를 파괴해야 합니다. 레벨 15‡Destruye 8 cajones de suministros de la Horda.‡‡Détruisez 8 Caisses de ravitaillement de la Horde.‡摧毁8个部落补给箱。‡',
  }
},
[32145] = {
  {
    'Não perca a cabeça‡Не теряй головы‡Kopfgeld‡정신 똑바로 차리고‡No pierdas la cabeza‡‡Qu’on leur coupe la tête !‡小心你的脑袋‡',
    nil,
    'Derrote o Guarda Pétreo Ruk\'ra, o Explogenheiro-chefe Bombadão Snicklefritz e Or\'Dac. Uma‡Победите каменного стража Рук\'ру, бумженера Зарубеня и Ор\'дака. это‡Besiegt Steingardistin Ruk\'ra, Bombentechniker Klickefritz und Or\'Dac.‡바위 수호자 룩라, 폭탄기술자 스니클프릿츠, 그리고 오르닥을 처치해야 합니다. 레벨 15‡Derrota a la guardia de piedra Ruk\'ra, al bombingeniero jefe Tronafritz y a Or\'Dac.‡‡Tuez le Garde de pierre Ruk’Ra, le Boumgénieur Galapiat et Or’dac.‡击败石头守卫鲁克拉、首席炸弹技师斯尼克弗里兹和奥·达克。‡',
  }
},
[32146] = {
  {
    'A Queda do Martelo‡Молот гнева‡Schwere Hämmer‡분노를 담은 일격‡La caída del martillo‡‡Quand y’en a marre…‡达摩克利斯之锤‡',
    nil,
    'Mate 5 Imbecis Pesados. Uma‡Убейте 5 неуклюжих балбесов. это‡Tötet 5 schwere Schergen.‡육중한 떡대 5명을 처치해야 합니다. 레벨 15‡Mata a 5 catetos pesados.‡‡Tuez 5 Gros malabars.‡击败5只重装巨怪。‡',
  }
},
[32147] = {
  {
    'Diária de Ataque 06‡Attack Daily 06‡Täglicher Angriff 06‡일일 공격 06‡Attack Daily 06‡‡Attaque quotidienne 06‡‡',
    nil,
    'Uma‡это‡‡레벨 15‡‡‡‡‡',
  }
},
[32148] = {
  {
    'Ataquem! Mexam-se!‡Защита базы‡Angriff! Bewegung!‡공격하고 움직여라‡¡Ataca! ¡Muévete!‡‡Attaquez ! Bougez !‡进攻！前进！‡',
    nil,
    'Mate 12 Xamãs ou Saqueadores de Dominância. Uma‡Убейте 12 шаманов или налетчиков из Крепости Покорителей. это‡Tötet 12 Schamanen oder Räuber der Herrschaftsoffensive.‡지배령 주술사 혹은 지배령 약탈자 12명을 처치해야 합니다. 레벨 15‡Mata a 12 chamanes o asaltantes de la Dominancia.‡‡Tuez 12 Chamans ou chevaucheurs de la Domination.‡击败12名统御萨满或统御掠夺者。‡',
  }
},
[32149] = {
  {
    'Coletando recursos‡Сбор ресурсов‡Ressourcen sammeln‡자원 확보‡Recolectar recursos‡‡Bois de coupe‡资源采集‡',
    nil,
    'Colete 12 pedaços de Madeira do Ancoradouro do Leão, recolhendo-os das pilhas de Madeira Abandonada Às Pressas. Uma‡Соберите 12 бревен Львиного лагеря, вытаскивая их из штабелей брошенной в спешке древесины.‡Besorgt 12 Stücke Bauholz der Löwenlandung, die Ihr von den Stapeln fluchtartig aufgegebenen Bauholzes bergt.‡급히 버려진 목재에서 사자의 상륙지 목재 12개를 수집해야 합니다. 레벨 15‡Recupera 12 montones de leña del Desembarco del León de los montones de madera abandonada a toda prisa.‡‡Ramassez 12 lots de Bois de coupe du territoire du Lion dans des piles de Bois abandonné à la hâte.‡从被仓促遗弃的木材堆中收集12份雄狮港木材。‡',
  }
},
[32150] = {
  {
    'Bloqueio de suprimentos‡Отрезать снабжение‡Versorgungsblockade‡보급품 차단‡Bloqueo de suministros‡‡Épuisement des ressources‡补给困难‡',
    nil,
    'Destruir 8 Carroças de Suprimentos do Ponto de Dominação. Uma‡Уничтожьте 8 тележек с припасами из Крепости Покорителей. это‡Zerstört 8 Versorgungskarren der Herrschaftsfeste.‡지배령 거점 보급품 수레 8대를 파괴해야 합니다. 레벨 15‡Destruye 8 carros de suministros del Punto de Dominio.‡‡Détruisez 8 Chariots de marchandises de la Halte de la Domination.‡摧毁8个统御岗哨补给箱。‡',
  }
},
[32151] = {
  {
    'Defender a Torre‡Защита башен‡Turmverteidigung‡경비탑 보수‡Defender las torres‡‡Tours de défense‡塔防建材‡',
    nil,
    'Coletar 20 Pedras Animáveis na Pedreira do Ancoradouro do Leão; obtenha-as dos Goblins de Borraquilha ou destruindo os pedaços de pedra com dano colateral.‡Соберите 20 живых камней в карьере Львиного лагеря, убивая гоблинов из картеля Трюмных Вод или осуществляя взрывы вблизи каменных глыб.‡Besorgt 20 Brocken belebbaren Steins aus dem Steinbruch der Löwenlandung von Bilgewässer Goblins oder indem Ihr Steinplatten mit Kollateralschaden zerstört.‡사자의 상륙지 채석장에서 생명이 깃든 돌 20개를 수집해야 합니다. 생명이 깃든 돌은 빌지워터 고블린들에게서 획득하거나, 암석을 폭파해서 얻을 수 있습니다.‡Recoge 20 piedras animables en la Cantera del Desembarco del León de los goblins de Pantoque o destruye los bloques de piedra con daño colateral.‡‡Récupérez 20 Pierres viables à la carrière du Territoire du Lion sur des Gobelins Baille-Fonds. Vous pouvez également détruire des dalles de pierre grâce aux dégâts collatéraux.‡收集20块松动的石头。石头可以在雄狮港采石场的锈水地精身上或被战斗余波摧毁的岩层附近找到。‡',
  }
},
[32152] = {
  {
    'Dano de cerco‡Прорыв осады‡Belagerungsschaden‡공성 무기 무력화‡Daño de asedio‡‡Dégâts de siège‡攻城利器‡',
    nil,
    'Encontre uma Cápsula de detonação em um Sapador Borraquilha e plante-a em um Demolidor do Ponto de Dominação. Uma‡Заберите запал картеля Трюмных Вод у сапера картеля Трюмных Вод, а затем установите его на разрушителе из Крепости Покорителей.‡Findet eine Bilgewässer Sprengkapsel bei einem Bilgewässer Pionier und platziert sie bei einem Verwüster der Herrschaftsfeste.‡빌지워터 공병으로부터 빌지워터 뇌관을 획득하고 지배령 거점 파괴전차에 설치해야 합니다. 레벨 15‡Encuentra un cartucho explosivo Pantoque en un zapador de Pantoque y colócalo en un demoledor de Punto de Dominio.‡‡Trouvez une amorce explosive de Baille-Fonds sur un Sapeur de Baille-Fonds, puis placez-la sur un Démolisseur de la Halte de la Domination.‡在锈水工兵身上找到锈水雷管，然后将其放置在一台统御岗哨歼灭者上。‡',
  }
},
[32153] = {
  {
    'Matador de heróis‡Смерть героям!‡Heldenmörder‡영웅을 쓰러뜨리는 영웅‡Asesino de héroes‡‡Tueur de héros‡英雄杀手‡',
    nil,
    'Mate um Herói da Horda. Uma‡Убейте героя Орды. это‡Tötet einen Helden der Horde.‡호드 영웅 한 명을 처치해야 합니다. 레벨 15‡Mata a un héroe de la Horda.‡‡Tuez un Héros de la Horde.‡击败1名部落英雄。‡',
  }
},
[32154] = {
  {
    'Queima!‡Поджог‡Ausgebrannt!‡다 태워버려!‡Quemados‡‡Grillés !‡统统烧光！‡',
    nil,
    'Use o Explosivo Instável para destruir o Tanque de Combustível Nordeste, o Tanque de Combustível Norte e o Tanque de Combustível Noroeste.‡Используйте нестабильную взрывчатку, чтобы подорвать северо-восточный бак с горючим, северный бак с горючим и северо-западный бак с горючим.‡Verwendet den instabilen Sprengstoff, um den nordöstlichen Treibstoffbehälter, den nördlichen Treibstoffbehälter und den nordwestlichen Treibstoffbehälter zu zerstören.‡불안정한 폭발물을 이용해 북동쪽 연료 탱크, 북쪽 연료 탱크, 북서쪽 연료 탱크를 파괴해야 합니다.‡Utiliza el explosivo inestable para destruir los tanques de combustible del noreste, del norte y del noroeste.‡‡Utilisez les Explosifs instables pour détruire le Réservoir de carburant nord-est, le Réservoir de carburant nord et le Réservoir de carburant nord-ouest.‡使用不稳定的炸药摧毁东北方油罐、西北方油罐以及北方油罐。‡',
  }
},
[32155] = {
  {
    'Quebrando tudo‡Вынужденные поломки‡Sabotage‡꼭 필요한 파괴 공작‡Rompedor‡‡Rupture nécessaire‡‡',
    nil,
    'Roube 7 Válvulas Enferrujadas da operação de combustível na Praia Borraquilha. Uma‡Украдите 7 ржавых вентилей с нефтяной платформы на Пляже Трюмных Вод. это‡Stehlt 7 rostige Ventile von den Ölanlagen auf dem Bilgewasserstrand.‡빌지워터 해변의 연료 공급 장치에서 녹슨 밸브 7개를 손에 넣어야 합니다. 레벨 1‡Roba 7 válvulas oxidadas de la operación de combustible de la Playa Pantoque.‡‡Volez 7 Valves rouillées à l’opération de carburant sur la Plage Baille-Fonds.‡‡',
  }
},
[32156] = {
  {
    'É a coisa certa‡Последние почести‡Das gehört sich so‡옳은 일‡Es lo justo‡‡Ce n’est que justice‡最后的关怀‡',
    nil,
    'Colete 7 Etiquetas de Identificação de Soldados da Muralha de Escudos dos Soldados da Muralha de Escudos Tombados perto da Praia Borraquilha.‡Соберите 7 армейских жетонов павших солдат операции "Заслон" на пляже Трюмных Вод или в его окрестностях.‡Bergt 7 Erkennungsmarken von den gefallenen Soldaten der Operation Schildwall am Bilgewasserstrand.‡빌지워터 해변과 그 주변의 전사한 철벽방패 병사들에게서 철벽방패 병사 군번표 7개를 모아야 합니다.‡Recupera 7 placas de identificación de soldado del Muro de escudos de soldados del Muro de escudos caídos en la Playa Pantoque y sus alrededores.‡‡Récupérez 7 Plaques d’identification de soldat de l’opération Bouclier sur des Soldats de l’opération Bouclier morts sur et autour de la Plage Baille-Fonds.‡从锈水海滩的阵亡的神盾士兵身上收集7枚神盾士兵狗牌。‡',
  }
},
[32157] = {
  {
    'Goblin bom...‡Хороший гоблин – мертвый гоблин‡...ist ein guter Goblin.‡좋은 고블린이란 죽은 고블린뿐‡El único goblin bueno...‡‡Un bon gobelin…‡唯一的好地精……‡',
    nil,
    'Mate 10 Goblins Borraquilha na Praia Borraquilha e nas áreas próximas. Uma‡Убейте 10 гоблинов из картеля Трюмных Вод на пляже Трюмных Вод. это‡Tötet 10 Bilgewässer Goblins beim Bilgewasserstrand.‡빌지워터 해변과 그 주변에 있는 빌지워터 고블린 10명을 처치해야 합니다. 레벨 15‡Mata a 10 goblins de Pantoque en la Playa Pantoque y alrededores.‡‡Tuez 10 Gobelins de Baille-Fonds sur la Plage Baille-Fonds et dans ses environs.‡在锈水海滩击败10个锈水地精。‡',
  }
},
[32158] = {
  {
    'Programa de dois passos‡Два шага до победы‡Programm in zwei Schritten‡문제 해결의 두 단계‡Solución en dos pasos‡‡Programme en deux étapes‡两步走‡',
    nil,
    'Destrua o Retalhador Packle na Fazenda da Serraria de Zino Picadinho. Uma‡Уничтожьте крошмейстера Пакля рядом с лесопилкой Скоротяпеля. это‡Zerstört Schreddermeister Packle in Blitzbeils Holzhof.‡퀵촙의 목재소에 있는 벌목감독관 패클을 처치해야 합니다. 레벨 15‡Acaba con el maestro triturador Atadijo en el Aserradero de Hachaveloz.‡‡Détruisez le Maître-déchiqueteur Packle à la Ferme d’abattage de Hachémenu.‡消灭快锯伐木场的粉碎大师帕克尔。‡',
  }
},
[32159] = {
  {
    'Ciclo da vida‡Круг жизни‡Kreis des Lebens‡생명의 순환‡El ciclo de la vida‡‡Le cycle de la vie‡‡',
    nil,
    'Plante 11 Sementes Energizadas perto da Fazenda da Serraria de Zino Picadinho. Uma‡Посадите 11 беспокойных семян рядом с Лесопилкой Скоротяпеля. это‡Pflanzt 11 energiegeladene Samen in der Nähe von Blitzbeils Holzhof.‡퀵촙의 목재소 근처에 기운이 주입된 씨앗 11개를 심어야 합니다. 레벨 1‡Planta 11 semillas energizadas cerca del Aserradero de Hachaveloz.‡‡Plantez 11 Graines énergisées près de la Ferme d’abattage de Hachémenu.‡‡',
  }
},
[32161] = {
  {
    'Caçada do Senhor das Feras: a Garça‡Охота повелителя зверей: журавль‡Jagd des Bestienmeisters: Der Kranich‡야수조련사의 사냥감: 고대 피의 왕관 학‡La caza del maestro de bestias: la grulla‡‡Technique de chasse du belluaire : la grue‡兽王的狩猎：仙鹤‡',
    nil,
    'Obtenha 5 Penachos Dourados Imaculados e um Penacho Negro Imaculado. Uma‡Соберите 5 безупречных золотистых журавлиных перьев и 1 безупречное черное журавлиное перо.‡Besorgt 5 makellose goldene Kronenfedern und 1 makellose schwarze Kronenfeder.‡온전한 황금 머리 깃과 온전한 칠흑 머리 깃을 각각 5개씩 획득해야 합니다. 레벨 15‡Hazte con 5 plumacintas doradas prístinas y una plumacinta azabache prístina.‡‡Récupérez 5 Aigrettes dorées en parfait état et 1 Aigrette de jais en parfait état.‡收集5根完整的金色冠羽和1根完整的墨黑冠羽。‡',
  }
},
[32162] = {
  {
    'Caçada do Senhor das Feras: o Tigre‡Охота повелителя зверей: тигр‡Jagd des Bestienmeisters: Der Tiger‡야수조련사의 사냥감: 덩치 큰 크라사리 호랑이‡La caza del maestro de bestias: el tigre‡‡Technique de chasse du belluaire : le tigre‡兽王的狩猎：老虎‡',
    nil,
    'Obtenha 25 Quartos de Iaque Intactos. Uma‡Соберите 25 неотбитых филе яка. это‡Besorgt 25 unbeschädigte Yakkeulen.‡상처 없는 야크 허벅지 고기 25개를 획득해야 합니다. 레벨 15‡Hazte con 25 ancas de yak ilesas.‡‡Récupérez 25 Cuissots de yack intacts.‡收集25块完整的牦牛腰肉。‡',
  }
},
[32163] = {
  {
    'Caçada do Senhor das Feras: o Caranguejo‡Охота повелителя зверей: краб‡Jagd des Bestienmeisters: Die Krabbe‡야수조련사의 사냥감: 거대 야물집게발‡La caza del maestro de bestias: el cangrejo‡‡Technique de chasse du belluaire : le crabe‡兽王的狩猎：螃蟹‡',
    nil,
    'Obtenha 30 Peixes Podres Fedidos dos Aldeões Ungá em Ungá Ingô. Uma‡Заберите 30 вонючих тухлых рыб у жителей поселения Унга-Ингу. это‡Besorgt 30 müffelnde verrottete Fische von Ungadorfbewohnern in Unga Ingu.‡웅가 잉구에 있는 웅가 주민에게서 냄새나는 썩은 물고기 30마리를 획득해야 합니다. 레벨 15‡Hazte con 30 pescados podridos hediondos de habitantes de Unga, en Unga Ingoo.‡‡Récupérez 30 Poissons pourris bizarres sur des Villageois d’Unga, à Unga Ingou.‡从盎迦猴岛的盎迦村民处获得30条恶臭烂鱼。‡',
  }
},
[32164] = {
  {
    'Caçada do Senhor das Feras: a Garça‡Охота повелителя зверей: журавль‡Jagd des Bestienmeisters: Der Kranich‡야수조련사의 사냥감: 고대 피의 왕관 학‡La caza del maestro de bestias: la grulla‡‡Technique de chasse du belluaire : la grue‡兽王的狩猎：仙鹤‡',
