[7507] = {
  {
    '‡Справочник Форора‡Forors Kompendium‡‡Compendio de Foror‡Compendio de Foror‡Le guide de Dagharn‡弗洛尔的屠龙技术纲要‡',
    nil,
    '‡Верните "Справочник Форора по убийству драконов" в Читальню.‡Bringt Forors Kompendium des Drachentötens zurück in das Athenaeum.‡‡Devuelve el compendio de matar dragones de Foror a El Athenaeum.‡Devuelve el compendio de matar dragones de Foror a El Athenaeum.‡Rendez “Le guide de Dagharn du tueur de dragons“ à l\'Athenaeum.‡将《弗洛尔的屠龙技术纲要》还回图书馆。‡',
  }
},
[7508] = {
  {
    '‡Ковка Кель\'Серрара‡Das Schmieden von Quel\'Serrar‡쿠엘세라 검 만들기‡Forjar Quel\'Serrar‡Forjar Quel\'Serrar‡Forger Quel\'Serrar‡铸造奎尔塞拉‡鑄造奎爾賽拉',
    nil,
    '‡Отдайте тусклый и плоский эльфийский клинок сказителю Лидросу.‡Bringt dem Wissenshüter Lydros die stumpfe und glanzlose Elfenklinge.‡‡Entrega la hoja élfica roma Tradicionalista Lydros.‡Entrega la hoja élfica roma Tradicionalista Lydros.‡Donnez la Lame elfique inachevée au Gardien du savoir Lydros.‡把黯淡的精灵剑交给博学者莱德罗斯。‡',
  }
},
[7509] = {
  {
    '‡Ковка Кель\'Серрара‡Das Schmieden von Quel\'Serrar‡쿠엘세라 검 만들기‡Forjar Quel\'Serrar‡Forjar Quel\'Serrar‡Forger Quel\'Serrar‡铸造奎尔塞拉‡鑄造奎爾賽拉',
    nil,
    '‡Заставьте Ониксию дохнуть своим огненным дыханием на потускневший древний клинок. После этого схватите раскаленный древний клинок. Имейте в виду, что раскаленным он останется ненадолго, так что медлить не следует!|n|nПоследнее, что нужно сделать – это убить драконицу и вонзить раскаленный древний клинок в ее труп.|n|nСделайте это – и Кель\'Серрар навеки станет вашим!‡Bringt Onyxia dazu, ihren Feueratem auf die noch unerhitzte Klinge zu benutzen. Sobald dies geschehen ist, hebt die erhitzte Klinge wieder auf. Doch seid gewarnt, die erhitzte Klinge wird nicht auf ewig erhitzt bleiben - behaltet also die Zeit im Auge.|n|nZuletzt müsst Ihr das Biest töten und die uralte erhitzte Klinge in ihren Leib rammen. Kehrt anschließend zu mir zurück und Quel\'Serrar wird Euer sein.‡‡Debes conseguir que Onyxia escupa fuego sobre la hoja antigua sin templar. Una vez hecho, recógela, su hoja estará candente. Pero ten cuidado: una hoja candente no permanecerá así para siempre, no tienes tiempo que perder. |n|nAntes de volver a mí, tienes que terminar lo empezado, debes matar a la bestia e introducir la hoja candente en su cadáver. |n|nHazlo y Quel\'Serrar será tuya.‡Debes conseguir que Onyxia escupa fuego sobre la hoja antigua sin templar. Una vez hecho, recógela, su hoja estará candente. Pero ten cuidado: una hoja candente no permanecerá así para siempre, no tienes tiempo que perder. |n|nAntes de volver a mí, tienes que terminar lo empezado, debes matar a la bestia e introducir la hoja candente en su cadáver. |n|nHazlo y Quel\'Serrar será tuya.‡Vous devez amener Onyxia à cracher le feu sur la Lame ancienne brute. Lorsque ce sera fait, ramassez la Lame ancienne chauffée. Attention, elle ne restera pas chaude éternellement. Le temps est très important.|n|nAvant de revenir me voir, il vous faudra tuer la bête et plonger la Lame ancienne chauffée dans son cadavre.|n|nSi vous y parvenez, Quel\'Serrar sera à vous.‡你必须设法让奥妮克希亚对这把未淬火的上古之刃喷射火焰。完成之后，捡起加热过的上古之刃。你要注意的是，加热过的上古之刃不会一直保持被加热的状态，时间非常紧迫。|n|n在把它给我拿回来之前的最后一步是杀掉那条龙，并将加热过的上古之刃插入她的尸体中。|n|n完成这些之后，奎尔塞拉就是你的了。‡',
  }
},
[7521] = {
  {
    '‡Громораан Искатель Ветра‡Donneraan der Windsucher‡바람추적자 썬더란‡Thunderaan el Hijo del Viento‡Thunderaan el Hijo del Viento‡Tonneraan le Cherchevent‡逐风者桑德兰‡',
    nil,
    '‡Чтобы освободить Громораана Искателя Ветра из тюрьмы, отнесите правый и левый наручник Ветроносца, 10 слитков элементия и сущность Повелителя Огня верховному лорду Демитриану.‡Um Donneraan den Windsucher aus seiner Gefangenschaft zu befreien, müsst Ihr Hochlord Demitrian die rechten und linken Hälften der Fesseln des Windsuchers, 10 Elementiumbarren und die Essenz des Feuerfürsten bringen.‡[To free Thunderaan the Windseeker from his prison, you must present the right and left halves of the Bindings of the Wind Seeker, 10 bars of Elementium, and the Essence of the Firelord to Highlord Demitrian. ]‡Para liberar a Thunderaan el Hijo del Viento de su cárcel, debes entregarle al alto señor Demitrian la mitad izquierda y la derecha del vínculo del Hijo del Viento, 10 lingotes de elementium y la esencia del Señor del Fuego.‡Para liberar a Thunderaan el Hijo del Viento de su cárcel, debes entregarle al alto señor Demitrian la mitad izquierda y la derecha del vínculo del Hijo del Viento, 10 lingotes de elementium y la esencia del Señor del Fuego.‡Pour libérer Tonneraan le Cherchevent de sa prison, vous devez présenter au généralissime Demitrian les moitiés droite et gauche des Liens du Cherchevent, 10 barres d\'élémentium, et l\'Essence du seigneur du Feu.‡要将Windseeker的Thunderaan从监狱释放，必须将寻风者的绑定物，原物的10个酒吧和Firelord的本质呈现给主流Demitrian。‡',
  }
},
[7522] = {
  {
    '‡Сосуд Возрождения‡Untersuchung des Gefäßes‡결정 조사‡Examina la vasija‡Examina la vasija‡Examiner le Calice‡复生之瓶‡',
    nil,
    '‡Изучите Сосуд Возрождения и вернитесь к верховному лорду Демитриану.‡Untersucht das Gefäß der Wiedergeburt und bringt es zu Hochlord Demitrian.‡환생의 관을 조사한 후, 대영주 데미트리안에게 가져가야 합니다.‡Examina la vasija de renacer y devuélvesela al alto señor Demitrian.‡Examina la vasija de renacer y devuélvesela al alto señor Demitrian.‡Examiner le Calice de la renaissance et le rapporter au généralissime Demitrian.‡查看复生之瓶，然后回到德米提恩那里去。‡',
  }
},
[7541] = {
  {
    '‡Служба Орде‡Dienst an der Horde‡‡Un servicio para la Horda‡Un servicio para la Horda‡Un service pour la Horde‡为部落效力‡',
    nil,
    nil,
  }
},
[7561] = {
  {
    '‡Громовая ярость‡Donnerzorn erwache!‡일어나라, 우레폭풍이여!‡¡Arriba, Trueno Furioso!‡¡Arriba, Trueno Furioso!‡Éveille-toi, Lame-tonnerre !‡觉醒吧,雷霆之怒‡',
    nil,
    '‡Отдайте Дремлющий клинок Игривого Ветра верховному лорду Демитриану.‡Präsentiert Hochlord Demitrian die vom Wind berührte, schlummernde Klinge.‡대영주 데미트리안에게 잠들어 있는 바람의 성검을 보여줘야 합니다.‡Lleva la hoja besada por el viento durmiente al alto señor Demitrian.‡Lleva la hoja besada por el viento durmiente al alto señor Demitrian.‡Présenter la Lame du baiser du vent dormante au généralissime Demitrian.‡把风吻之刃交给德米提恩。‡',
  }
},
[7562] = {
  {
    'Mor\'zul Trazangre‡Мор\'зул Вестник Крови‡Mor\'zul Blutbringer‡모르줄 블러드브링어‡Mor\'zul Sangredoble‡Mor\'zul Sangredoble‡Mor\'zul Porte-sang‡莫苏尔·召血者‡莫蘇爾·召血者',
    nil,
    'Speak with Mor\'zul Bloodbringer at the Altar of Storms in the Burning Steppes.‡Поговорите с Мор\'зулом Вестником Крови у Алтаря Бурь в Пылающих степях.‡Sprecht mit Mor\'zul Blutbringer beim Altar der Stürme in der Brennenden Steppe.‡불타는 평원의 폭풍의 제단에 있는 모르줄 블러드브링어와 대화해야 합니다.‡Habla con Mor\'zul Sangredoble en el Altar de la Tempestad en Las Estepas Ardientes.‡Habla con Mor\'zul Sangredoble en el Altar de la Tempestad en Las Estepas Ardientes.‡Allez voir Mor\'zul Porte-sang à l\'Autel des Tempêtes, dans les Steppes Ardentes.‡与燃烧平原风暴祭坛的莫苏尔·召血者谈一谈。‡到燃燒平原的暴風祭壇，與莫蘇爾·召血者談話。',
  }
},
[7563] = {
  {
    'Raiva de Sangue‡Ярость крови‡Kochendes Blut‡피의 광란‡La ira de sangre‡La ira de sangre‡Rage de sang‡血之狂暴‡血之狂暴',
    nil,
    'Leve 30 garrafas de Sangue de Fera em Fúria para Mor\'zul Trazangre nas Estepes Ardentes.‡Принесите 30 бутылок крови яростных зверей Мор\'зулу Вестнику Крови в Пылающие степи.‡Mor\'zul Blutbringer in der Brennenden Steppe möchte, dass Ihr ihm 30 Flaschen mit dem Blut der tobenden Bestien bringt.‡불타는 평원에 있는 모르줄 블러드브링어에게 흉포한 올빼미야수의 피 30병을 가져가야 합니다.‡Llévale 30 botellas de sangre de bestia embravecida a Mor\'zul Sangredoble en Las Estepas Ardientes.‡Llévale 30 botellas de sangre de bestia embravecida a Mor\'zul Sangredoble en Las Estepas Ardientes.‡Apportez 30 bouteilles de Sang de bêtes déchaînées à Mor\'zul Porte-sang dans les Steppes Ardentes.‡把30瓶狂暴野兽的血交给燃烧平原的莫苏尔·召血者。‡把30瓶狂暴野獸的血交給燃燒平原的莫蘇爾·召血者。',
  }
},
[7564] = {
  {
    '‡Дикоглаз‡Wildaug‡‡Ojovago‡Ojovago‡Gorzeeki Fouregard‡戈瑟奇·邪眼‡',
    nil,
    '‡Принесите ларец Крови Горзиеки Дикоглазу в Алтарь Бурь, что в Пылающих степях.‡Bringt den Behälter mit Blut zu Gorzeeki Wildaug beim Altar der Stürme in der Brennenden Steppe.‡‡Llévale el estuche de sangre a Gorzeeki Ojovago al Altar de la Tempestad, en Las Estepas Ardientes.‡Llévale el estuche de sangre a Gorzeeki Ojovago al Altar de la Tempestad, en Las Estepas Ardientes.‡Apportez la Caisse de sang à Gorzeeki Fouregard à l\'Autel des tempêtes, dans les Steppes Ardentes.‡把血箱交给燃烧平原的戈瑟奇·邪眼。‡',
  }
},
[7581] = {
  {
    'Montando a prisão‡Тюремные кандалы‡Das Fundament des Gefängnisses‡감옥벽의 재료‡Las selladuras de la prisión‡Las selladuras de la prisión‡Les ancrages de la prison‡监牢之链‡囚牢之鏈',
    nil,
    'Vá até o Gládio Cruel, em Feralas, e obtenha 15 amostras de Sangue de Sátiro dos Sátiros Criasselvagem que habitam o Distrito Lenhatorta. Fale novamente com Daio no Rasgo Infecto quando tiver feito isso.|n‡Отправляйтесь в Забытый Город, что в Фераласе и добудьте 15 порций крови сатиров из племени Исчадий Природы, что живут в Квартале Криводревов. Вернитесь к Дайо из Гниющего Шрама по выполнении поручения.‡Reist nach Düsterbruch in Feralas und holt Euch das Blut von 15 Satyrn der Wildhufe, die im Wucherborkenviertel ansässig sind. Kehrt anschließend zu Daio in der Faulenden Narbe zurück.‡페랄라스에 있는 혈투의 전장으로 간 다음 굽이나무 지구에 서식하는 야생혈족 사티르로부터 사티르의 피 15개를 회수한 후 타락의 흉터에 있는 다이오에게 가야 합니다.‡Viaja a La Masacre en Feralas y consigue 15 muestras de sangre de sátiro del sátiro Mala Hierba que habita en el Barrio Alabeo. Cuando hayas acabado, ve a ver a Daio a la Escara Impía.|n‡Viaja a La Masacre en Feralas y consigue 15 muestras de sangre de sátiro del sátiro Mala Hierba que habita en el Barrio Alabeo. Cuando hayas acabado, ve a ver a Daio a la Escara Impía.|n‡Rendez-vous à Hache-Tripes en Féralas et récupérez 15 doses de Sang de satyre sur les satyres Follengeance qui habitent le quartier de Crochebois. Lorsque ce sera fait, retournez voir Daio à la Balafre impure.‡到菲拉斯的厄运之槌去，从扭木广场的荒野萨特身上找到15份萨特之血，然后把它们交给腐烂之痕的戴奥。‡到菲拉斯的厄運之槌去，從扭木廣場的荒野薩特身上找到15份薩特之血，然後把它們交給腐化之痕的戴奧。',
  }
},
[7582] = {
  {
    'O revestimento da prisão‡Тюремная камера‡Die Gefängnishülle‡감옥의 외벽‡El revestimiento de la prisión‡El revestimiento de la prisión‡Les parois de la prison‡监牢之壁‡監牢之壁',
    nil,
    'Vá à Garganta do Sussurro Sombrio em Hibérnia e recupere 5 Lágrimas dos Hederine dos demônios Hederine que ocupam o lugar. Fale novamente com Daio no Rasgo Infecto quando você tiver completado esta tarefa.‡Отправляйтесь к Теснине Зловещего Шепота в Зимних ключах и добудьте 5 слез Хедерины у демонов Хедерины, что населяют эту теснину. Вернитесь к Дайо из Гниющего Шрама по выполнении поручения.‡Reist in die Flüsternde Schlucht in Winterquell und besorgt Euch 5 Tränen bei den Dämonen von Hederine, die in der Schlucht leben. Kehrt zu Daio in der Faulenden Narbe zurück, sobald Ihr diese Aufgabe vollständig erledigt habt.‡여명의 설원에 있는 검은속삭임 협곡에서 서식하는 헤더린의 악마들로부터 헤더린의 눈물 5개를 모아야 합니다. 임무를 완수하면 타락의 흉터에 있는 다이오에게 돌아가십시오.‡Viaja a la Garganta Negro Rumor en Cuna del Invierno y recoge 5 Lágrimas de los Hederine de los demonios Hederine que ocupan la garganta. Cuando hayas cumplido tu tarea, ve a ver a Daio a la Escara Impía.‡Viaja a la Garganta Negro Rumor en Cuna del Invierno y recoge 5 Lágrimas de los Hederine de los demonios Hederine que ocupan la garganta. Cuando hayas cumplido tu tarea, ve a ver a Daio a la Escara Impía.‡Rendez-vous à la gorge du Sombre murmure, au Berceau-de-l\'Hiver, et récupérez 5 Larmes de l\'Hederine sur les démons Hederine qui occupent la gorge. Lorsque ce sera fait, retournez voir Levandre à la Balafre impure.‡到冬泉谷的暗语峡谷去，从盘踞在峡谷中的赫达琳恶魔身上找到5块赫达琳之泪。完成任务之后回到腐烂之痕的戴奥那里。‡到冬泉谷的暗語峽谷去，從盤踞在峽谷中的赫達琳惡魔身上找到5塊赫達琳之淚。完成任務之後回到腐化之痕的戴奧那裡。',
  }
},
[7583] = {
  {
    '‡Заточение‡Unterdrückung‡억제‡Supresión‡Supresión‡‡压制‡鎮壓',
    nil,
    '‡Отправляйтесь в Гниющий шрам и и найдите командира стражников ужаса.|n|nПри помощи светящегося кристалла заточения поймайте командира стражников ужаса. Будьте готовы к отчаянным атакам и сопротивлению, поскольку демон будет пытаться избежать заточения.|n|nЕсли вы добьетесь успеха, отнесите пленного стражника ужаса Дайо в Гниющий шрам.‡Wagt Euch in die Faulende Narbe heraus und macht einen Verdammniswachenkommandanten ausfindig.|n|nWendet das leuchtende Kristallgefängnis auf den Verdammniswachenkommandanten an. Bereitet Euch auf eine heftige Serie von Attacken vor, da der Dämon alles gegen seine Gefangennahme unternehmen wird.|n|nSolltet Ihr erfolgreich sein, bringt die gefangene Verdammniswache zu Daio in der Faulenden Narbe.‡‡Aventúrate en la Escara Impía y localiza a un comandante Guardia apocalíptico.|n|nUtiliza la prisión de cristal resplandeciente para atrapar al comandante Guardia apocalíptico. Prepárate para una sucesión de ataques pues el demonio intentará escapar.|n|nSi tienes éxito, llévale el Guardia apocalíptico encarcelado a Daio, en la Escara Impía.‡Aventúrate en la Escara Impía y localiza a un comandante Guardia apocalíptico.|n|nUtiliza la prisión de cristal resplandeciente para atrapar al comandante Guardia apocalíptico. Prepárate para una sucesión de ataques pues el demonio intentará escapar.|n|nSi tienes éxito, llévale el Guardia apocalíptico encarcelado a Daio, en la Escara Impía.‡Pénétrez dans la Balafre impure et localisez un Commandant de la garde funeste.|n|nServez-vous de la Prison de cristal luminescente sur lui. Attendez-vous à être sauvagement $Gattaqué:attaquée;, car le démon fera l\'impossible pour éviter d\'être capturé.|n|nSi vous réussissez, amenez le garde funeste emprisonné à Daio à la Balafre impure.‡在腐烂之痕中找到一个末日守卫指挥官。|n|n对其使用光芒水晶监牢。你要做好承受疯狂攻击的准备，那个恶魔会拼命挣扎试图逃脱。|n|n如果你成功了，就把被囚禁的末日守卫交给腐烂之痕的戴奥。‡',
  }
},
[7601] = {
  {
    '‡Что хочет Ниби‡Nibys Anweisungen‡‡La orden de Niby‡La orden de Niby‡Les Commandements de Niby‡尼比的助手‡',
    nil,
    '‡Поговорите с Бесенком в Оскверненном лесу.‡Sprecht mit Impsy im Teufelswald.‡‡Habla con Diblis en Frondavil.‡Habla con Diblis en Frondavil.‡Parlez à Démonet à Gangrebois.‡与费伍德森林的伊普斯谈一谈。‡',
  }
},
[7602] = {
  {
    'Essência Vil Impecável‡Безупречная субстанция Скверны‡Reine Teufelsessenz‡완전무결한 지옥의 정수‡Esencia de energía vil pura‡Esencia de energía vil pura‡La gangressence parfaite‡无瑕的恶魔精华‡無瑕的惡魔精華',
    nil,
    'Leve três Essências Vis Impecáveis, originárias de três locais distintos, para Diabretim na Selva Maleva.|n|nOs Sátiros Legashi de Azshara possuem a Essência Vil Impecável da região deles, assim como os Legionários de Jaedenar e as Sentinelas Guardas Vis da Barreira do Inferno.|n|nBusque as Essências Vis Impecáveis e leve-as para Diabretim, na Selva Maleva.‡Бесенок из Оскверненного леса просит вас принести ему три порции безупречной субстанции скверны из трех различных мест.|n|nБезупречной субстанцией в Азшаре владеют сатиры из племени Легаши. В Джеденаре она есть у джеженарских легионеров. Стражи Скверны в Выжженных землях владеют этой субстанцией в своих краях.|n|nДобудьте три типа безупречной субстанции Скверны и возвращайтесь к Бесенку в Оскверненный лес.‡Impsy im Teufelswald möchte, dass Ihr ihm drei reine Teufelsessenzen aus drei bestimmten Gebieten besorgt.|n|nDie Satyrn der Legashi von Azshara bergen die Teufelsessenz ihrer Region. Die Legionäre von Jaedenar in Jaedenar bergen die Teufelsessenz ihrer Region. Die Wachposten der Teufelswache in den Verwüsteten Landen bergen die Teufelsessenz ihrer Region.|n|nFindet die Teufelsessenzen und bringt sie zu Impsy im Teufelswald.‡악령숲에 있는 임프시가 이 세계의 각기 다른 세 개의 지역에서 완전무결한 지옥의 정수 3개를 가져다 달라고 했습니다.|n|n아즈샤라에는 레가쉬 사티로스들, 제데나르에는 제데나르 부대원들, 그리고 저주받은 땅에서는 지옥군단병 보초들이 각기 그 지역의 완전무결한 지옥의 정수를 갖고 있습니다.|n|n완전무결한 지옥의 정수 3개를 다 모은 다음에는 악령숲에 있는 임프시에게 가야 합니다.‡Diblis de Frondavil te ha pedido que le lleves 3 esencias viles impecables que provengan de 3 lugares distintos.|n|nLos sátiros Legashi de Azshara tienen la esencia vil impecable de su región. Los Legionarios Jaedenar de Jaedenar tienen la esencia vil impecable de su región. Los guardias viles de Las Tierras Devastadas tienen la esencia vil impecable de su región.|n|nReúne las esencias viles impecables y vuelve con Diblis a Frondavil.‡Diblis de Frondavil te ha pedido que le lleves 3 esencias viles impecables que provengan de 3 lugares distintos.|n|nLos sátiros Legashi de Azshara tienen la esencia vil impecable de su región. Los Legionarios Jaedenar de Jaedenar tienen la esencia vil impecable de su región. Los guardias viles de Las Tierras Devastadas tienen la esencia vil impecable de su región.|n|nReúne las esencias viles impecables y vuelve con Diblis a Frondavil.‡Démonet vous a demandé de lui apporter trois Gangressences parfaites, venant de trois régions distinctes.|n|nLes satyres Legashi d\'Azshara, les légionnaires de Jaedenar et les gangregardes sentinelles des terres Foudroyées détiennent la Gangressence parfaite de leur région.|n|nRécupérez les Gangressences parfaites et rapportez-les à Démonet, à Gangrebois.‡费伍德的伊普斯要求你从三个不同的地区收集三块无瑕的恶魔精华，然后把它们交给他。|n|n艾萨拉的雷加斯萨特、费伍德森林的加德纳尔军团士兵和诅咒之地的地狱卫士斥候分别拥有一种无瑕的恶魔精华。‡費伍德的伊普斯要求你從三個不同的地區收集三塊無瑕的惡魔精華，然後把它們交給他。|n|n艾薩拉的雷加斯薩特、費伍德森林的加德納爾軍團士兵和詛咒之地的惡魔守衛斥候分別擁有一種無瑕的惡魔精華。',
  }
},
[7603] = {
  {
    'Núcleo Infernal de Kroshius‡Огненное ядро Крошиуса‡Kroshius Höllenbestienkern‡크로쉬우스의 지옥핵‡El núcleo infernal de Kroshius‡Núcleo infernal de Kroshius‡Le noyau infernal de Kroshius‡克罗苏斯的恶魔之核‡克羅蘇斯的煉獄火之核',
    nil,
    'Procure os restos mortais de Kroshius no Vale das Escaras Pungentes, que fica na Selva Maleva. Ao encontrá-los, use o Fogo Vil perto deles e aguarde o retorno de Kroshius. Quando o infernal acordar, mate-o e retire do corpo dele o Núcleo Infernal de Kroshius.|n|nLeve o Núcleo para Niby, o Todo-poderoso na Selva Maleva.‡Обыщите долину Рваных Ран в Оскверненном лесу и найдите останки Крошиуса. Когда вы их найдете, поднесите к ним пламень Скверны и подождите, пока Крошиус не восстанет из праха. Когда инфернал очнется, убейте его и возьмите из его тела огненное ядро Крошиуса.|n|nПринесите огненное ядро Крошиуса Ниби Всемогущему в Оскверненный лес.‡Sucht im Narbengrund im Teufelswald nach den Überresten von Kroshius. Habt Ihr sie gefunden, so verwendet das Teufelsfeuer in deren Nähe und wartet dann auf Kroshius\' Rückkehr. Tötet die Höllenbestie und entnehmt ihrem Körper den Höllenbestienkern.|n|nBringt Kroshius\' Höllenbestienkern zu Niby dem Allmächtigen im Teufelswald.‡악령숲에 있는 불벼락 골짜기를 수색해 크로쉬우스의 잔해를 찾아야 합니다. 찾으면 부근에서 지옥의 불꽃을 사용해 크로쉬우스를 되살리십시오. 크로쉬우스가 깨어나면 놈을 처치한 후 크로쉬우스의 지옥핵을 꺼내야 합니다.|n|n크로쉬우스의 지옥핵을 악령숲에 있는 전지전능한 나이비에게 가져다주십시오.‡Busca los restos de Kroshius en la Cañada Gran Cicatriz de Frondavil. Cuando localices sus restos, utiliza el fuego vil cerca de ellos y espera el regreso de Kroshius. Cuando el infernal se haya despertado, acaba con él y extrae de su cuerpo el núcleo infernal de Kroshius.|n|nLleva el núcleo infernal de Kroshius a Niby el Todopoderoso a Frondavil.‡Busca los restos de Kroshius en la Cañada Gran Cicatriz de Frondavil. Cuando localices sus restos, utiliza el fuego vil cerca de ellos y espera el regreso de Kroshius. Cuando el infernal se haya despertado, acaba con él y extrae de su cuerpo el núcleo infernal de Kroshius.|n|nLleva el núcleo infernal de Kroshius a Niby el Todopoderoso a Frondavil.‡Fouillez le Val Grêlé pour trouver les restes de Kroshius. Quand vous les aurez localisés, utilisez le Gangrefeu à proximité et attendez le retour de Kroshius. Quand l\'Infernal se sera réveillé, tuez-le et prenez le Noyau infernal sur son cadavre.|n|nRapportez le Noyau infernal de Kroshius à Niby le Tout-Puissant, à Gangrebois.‡在费伍德森林的碎痕谷中搜寻克罗苏斯的尸体。当你找到尸体后，在他身上使用魔火，并等待克罗苏斯复生。当这个地狱火被唤醒之后，干掉他，从他的身上拿取克罗苏斯的恶魔之核。|n|n把克罗苏斯的恶魔之核交给费伍德森林的尼比。‡在費伍德森林的碎痕谷中搜尋克羅蘇斯的屍體。當你找到屍體後，在他身上使用魔化火焰，並等待克羅蘇斯複生。當這個煉獄火被喚醒之後，幹掉他，從他的身上取得克羅蘇斯的煉獄火之核。|n|n把克羅蘇斯的煉獄火之核交給費伍德森林的『全能』尼比。',
  }
},
[7604] = {
  {
    'Contrato vinculante‡Заключение договора‡Ein verbindlicher Vertrag‡대장조합 계약서‡Un contrato vinculante‡Un contrato vinculante‡Un contrat contraignant‡瑟银兄弟会契约‡一份必須遵守的契約',
    nil,
    'Entregue o Contrato da Irmandade do Tório para Lokhtos Umbrarganha, caso tenha interesse em receber as instruções para Sulfuron.‡Подпишите договор с представителем Братства Тория Локтосом Зловещим Торговцем, если вам нужен чертеж Сульфурона.‡Bringt den Vertrag der Thoriumbruderschaft zu Lokhtos Düsterfeilsch, wenn Ihr die Pläne für das Sulfuron erhalten möchtet.‡설퍼론 도면을 받으려면 설퍼론 주괴와 토륨 대장조합 계약서를 로크토스 다크바게이너에게 가져가야 합니다.‡Entrégale el contrato de La Hermandad del Torio a Lokhtos Tratoscuro si quieres recibir los planes de Sulfuron.‡Entrégale el contrato de La Hermandad del Torio a Lokhtos Tratoscuro si quieres recibir los planes de Sulfuron.‡Apportez le Contrat de la Confrérie du thorium à Lokhtos Sombrescompte, si vous voulez recevoir les plans du marteau de sulfuron.‡如果你愿意接受萨弗隆的设计图，请将瑟银兄弟会契约交给罗克图斯·暗契。‡如果你願意接受薩弗隆的設計圖，請將瑟銀兄弟會契約交給羅克圖斯·暗契。',
  }
},
[7621] = {
  {
    '‡Предупреждение‡Eine Warnung‡‡Un aviso‡Un aviso‡Un avertissement‡警示‡',
    nil,
    nil,
  }
},
[7622] = {
  {
    'Equilíbrio entre luz e sombra‡Баланс Света и Тьмы‡Die Waage von Licht und Schatten‡빛과 어둠의 균형‡Equilibrio de Luz y Sombras‡Equilibrio de Luz y Sombras‡L\'équilibre de la Lumière et de l\'Ombre‡光与影的平衡‡光與影的平衡',
    nil,
    'Salve 50 Camponeses antes que 15 sejam mortos. Fale com Eris Abrigoardente se conseguir completar a tarefa.|n|nVocê pode conferir o Poste da Morte para saber quantos Camponeses foram mortos.‡Спасите жизни 50 крестьян прежде, чем 15 из них будут убиты. Поговорите с Эрис Тайнопламень по выполнении задания.|n|nЧисло погибших крестьян можно узнать, посмотрев на Колья Смерти.‡Rettet 50 Arbeiter bevor 15 getötet wurden. Sprecht mit Eris Himmelsfeuer, falls Ihr diesen Auftrag erfolgreich zu Ende bringen solltet.|n|nKonsultiert den Todesposten, um zu sehen wie viele Arbeiter bereits getötet wurden.‡15명이 살해되기 전에 인부 50명을 구해야 합니다. 이 임무를 완수하면 에리스 헤이븐파이어와 대화하십시오.|n|n살해된 농부의 수를 보려면 죽음의 말뚝을 보십시오.‡Salva a 50 campesinos antes de que 15 sean asesinados. Habla con Eris Feleste si tienes éxito.|n|nPuedes ver el Poste de la muerte para ver cuántos campesinos han sido asesinados.‡Salva a 50 campesinos antes de que 15 sean asesinados. Habla con Eris Feleste si tienes éxito.|n|nPuedes ver el Poste de la muerte para ver cuántos campesinos han sido asesinados.‡Sauvez 50 Paysans avant que 15 d\'entre eux aient été tués. Si vous y parvenez, allez parler à Eris Havrefeu.|n|nConsultez le Panneau des morts pour voir combien de paysans ont été tués.‡在总计有15个农夫被杀死之前拯救50个农夫。完成任务之后与艾瑞斯·哈文法谈谈。|n|n你可以通过浏览死亡布告来了解自己拯救了多少农夫。‡在總計有15個農民被殺死之前拯救50個農民。完成任務之後與艾瑞斯·哈文法談談。|n|n你可以通過瀏覽死亡佈告來瞭解自己拯救了多少農民。',
  }
},
[7623] = {
  {
    'Lorde Nihilus‡Лорд Гиблопуст‡Lord Schattenfluch‡군주 베인할로우‡Lord Pesadilla‡Lord Pesadilla‡Le seigneur Creuseplaie‡魔王贝恩霍勒‡貝恩霍勒領主',
    nil,
    'Purchase Shadowy Potions from Gorzeeki Wildeyes at the Altar of Storms in the Burning Steppes.|n|nUse the potions to travel through Jaedenar in Felwood, and speak with Lord Banehollow inside the Shadow Hold.‡Купите зелья Теней у Горзиеки в Алтаре Бурь, что в Пылающих степях.|n|nПриняв зелья, пройдите через Джеденар в Оскверненном лесу и поговорите с лордом Гиблопустом, который находится в Оплоте Теней.‡Erwerbt schattenhafte Tränke von Gorzeeki Wildaug beim Altar der Stürme in der Brennenden Steppe.|n|nBenutzt die Tränke um durch Jaedenar im Teufelswald zu reisen und sprecht mit Lord Schattenfluch in der Schattenfeste.‡불타는 평원의 폭풍의 제단에 있는 고르지키 와일드아이즈에게서 어둠의 물약을 구입해야 합니다.|n|n이 물약을 사용하여 악령숲의 제데나르로 가서 어둠의 요새에 있는 군주 베인할로우와 대화하십시오.‡Cómprale pociones enigmáticas a Gorzeeki Ojovago en el Altar de la Tempestad en Las Estepas Ardientes.|n|nUsa las pociones para viajar por Jaedenar en Frondavil y habla con Lord Pesadilla en el interior de la Guarida Sombría.‡Cómprale pociones enigmáticas a Gorzeeki Ojovago en el Altar de la Tempestad en Las Estepas Ardientes.|n|nUsa las pociones para viajar por Jaedenar en Frondavil y habla con Lord Pesadilla en el interior de la Guarida Sombría.‡Achetez des Potions des ténèbres à Gorzeeki à l\'Autel des Tempêtes, dans les Steppes Ardentes.|n|nServez-vous-en pour vous rendre à Jaedenar, dans Gangrebois et parlez au seigneur Creuseplaie à l\'intérieur du Fort des Ombres.‡从燃烧平原风暴祭坛的戈瑟奇那里购买暗影药水。|n|n使用这种药剂进入费伍德森林的加德纳尔，然后与暗影堡中的魔王贝恩霍勒谈一谈。‡到燃燒平原的風暴祭壇，從戈瑟奇那裡購買暗影藥水。|n|n使用這種藥劑進入費伍德森林的加德納爾，然後與暗影堡的貝恩霍勒領主談話。',
  }
},
[7624] = {
  {
    '‡Улатек Предатель‡Ulathek der Verräter‡‡Ulathek el Traidor‡Ulathek el Traidor‡Ulathek le traître‡背叛者乌拉泰克‡',
    nil,
    '‡Сразитесь с Улатеком и принесите сердце предателя лорду Гиблопусту в Джеденар.‡Stellt Euch Ulathek und bringt das Herz des Verräters zu Lord Schattenfluch in Jaedenar.‡‡Enfréntate a Ulathek y llévale el corazón del traidor a Lord Pesadilla en Jaedenar.‡Enfréntate a Ulathek y llévale el corazón del traidor a Lord Pesadilla en Jaedenar.‡Affrontez Ulathek, puis apportez le Cœur du traître au seigneur Creuseplaie à Jaedenar.‡找到并杀死乌拉泰克，然后把叛徒的精华交给加德纳尔的魔王贝恩霍勒。‡',
  }
},
[7625] = {
  {
    'Poeira Estelar Zorothiana‡Зоротианская звездная пыль‡Xorothianischer Sternenstaub‡소로시안 별가루‡Polvo estelar xorothiano‡Polvo estelar xorothiano‡Poussière d\'étoile xorothienne‡克索诺斯星尘‡克索諾斯星塵',
    nil,
    'Purchase Xorothian Stardust from Ur\'dan inside the Shadow Hold at Jaedenar in Felwood. Bring it to Gorzeeki Wildeyes in the Burning Steppes.‡Купите зоротианскую звездную пыль у Ур\'Дана из Оплота Теней в Джеденаре, что в Оскверненном лесу. Отнесите ее Горзиеки Дикоглазу в Пылающие степи.‡Erwerbt xorothianischen Sternenstaub von Ur\'dan tief im Inneren der Schattenfeste in Jaedenar im Teufelswald. Bringt es anschließend Gorzeeki Wildaug in der Brennenden Steppe.‡악령숲, 제데나르의 어둠의 요새에 있는 우르단에게서 소로시안 별가루를 구입한 다음, 불타는 평원에 있는 고르지키 와일드아이즈에게 가져가야 합니다.‡Cómprale polvo estelar xorothiano a Ur\'dan en el interior de la Guarida Sombría en Jaedenar, en Frondavil. Llévaselo a Gorzeeki Ojovago en Las Estepas Ardientes.‡Cómprale polvo estelar xorothiano a Ur\'dan en el interior de la Guarida Sombría en Jaedenar, en Frondavil. Llévaselo a Gorzeeki Ojovago en Las Estepas Ardientes.‡Achetez de la Poussière d’étoile xorothienne à Ur’dan dans le Fort des Ombres à Jaedenar, dans Gangrebois. Apportez-la à Gorzeeki Fouregard dans les Steppes Ardentes.‡前往费伍德森林的加德纳尔，从暗影堡的乌尔丹那里购买克索诺斯星尘，把它交给燃烧平原的戈瑟奇·邪眼。‡到費伍德森林的加德納爾，從暗影堡的烏爾丹那裡購買克索諾斯星塵，然後把它交給燃燒平原的戈瑟奇·邪眼。',
  }
},
[7626] = {
  {
    'Sino de Defimura‡Колокол Детмуры‡Die Glocke von Dethmoora‡데스무라의 종‡La Campana de Dethmoora‡La Campana de Dethmoora‡La Cloche de Dethmoora‡达斯莫拉之铃‡達斯莫拉之鈴',
    nil,
    'Leve 2 Elixires de Poder Sombrio para Gorzeeki Olholouco nas Estepes Ardentes.‡Отнесите 2 эликсира энергии Тьмы Горзиеки Дикоглазу в Пылающие степи.‡Bringt 2 Elixiere der Schattenmacht zu Gorzeeki Wildaug in die Brennende Steppe.‡불타는 평원에 있는 고르지키 와일드아이즈에게 암흑 강화의 비약 2개를 가져가야 합니다.‡Llévale 2 elixires de poder de las sombras a Gorzeeki Ojovago en Las Estepas Ardientes.‡Llévale 2 elixires de poder de las sombras a Gorzeeki Ojovago en Las Estepas Ardientes.‡Apportez 2 Elixirs de puissance de l\'ombre à Gorzeeki Fouregard dans les Steppes ardentes.‡把2瓶暗影之力药剂交给燃烧平原的戈瑟奇·邪眼。‡把2瓶暗影之力藥劑交給燃燒平原的戈瑟奇·邪眼。',
  }
},
[7627] = {
  {
    'Roda da Marcha Negra‡Колесо Черного Похода‡Das Rad des Schwarzen Marsches‡어둠의 물레‡Rueda de la Marcha Negra‡Rueda de la Marcha Negra‡La Roue de la Marche noire‡黑暗战车之轮‡黑暗戰車之輪',
    nil,
    'Leve 6 Estilhaços Brilhantes Grandes e 25 Minérios de Ferro Negro para Gorzeeki nas Estepes Ardentes.‡Отнесите 6 больших блестящих осколка и 25 кусков руды черного железа Дикоглазу в Пылающие степи.‡Bringt 6 große glänzende Splitter und 25 Stücke Dunkeleisenerz zu Gorzeeki Wildaug in die Brennende Steppe.‡불타는 평원에 있는 고르지키 와일드아이즈에게 눈부신 큰 결정 6개와 검은무쇠 광석 25개를 가져가야 합니다.‡Llévale 6 fragmentos luminosos grandes y 25 minerales de hierro negro a Gorzeeki Ojosalvajes en Las Estepas Ardientes.‡Llévale 6 fragmentos luminosos grandes y 25 minerales de hierro negro a Gorzeeki Ojosalvajes en Las Estepas Ardientes.‡Apportez 6 Grands éclats brillants et 25 charges de Minerai de sombrefer à Gorzeeki dans les Steppes ardentes.‡把6份大块魔光碎片和25块黑铁矿石交给燃烧平原的戈瑟奇·邪眼。‡把6份大塊魔光裂片和25塊黑鐵礦石交給燃燒平原的戈瑟奇·邪眼。',
  }
},
[7628] = {
  {
    'Vela do Juízo Final‡Свеча Судного дня‡Die Altarkerze des Jüngsten Gerichts‡심판의 양초‡La Vela del Apocalipsis‡La Vela del Apocalipsis‡La Chandelle de l\'apocalypse‡末日蜡烛‡末日蠟燭',
    nil,
    'Leve 3 Escamas de Dragão Negro para Gorzeeki Olholouco nas Estepes Ardentes.‡Принесите 3 куска чешуи черного дракона Горзики Дикоглазу в Пылающие степи.‡Bringt 3 Schuppen eines schwarzen Drachen zu Gorzeeki Wildaug in der Brennenden Steppe.‡불타는 평원에 있는 고르지키 와일드아이즈에게 검은용 비늘 3개를 가져가야 합니다.‡Lleva 3 dragontinas negras a Gorzeeki Ojovago a Las Estepas Ardientes.‡Lleva 3 dragontinas negras a Gorzeeki Ojovago a Las Estepas Ardientes.‡Apportez 3 Écailles de dragon noir à Gorzeeki Fouregard dans les Steppes Ardentes.‡把3块黑龙鳞片交给燃烧平原的戈瑟奇·邪眼。‡把3塊黑龍鱗片交給燃燒平原的戈瑟奇·邪眼。',
  }
},
[7629] = {
  {
    'Entrega de diabrete‡Доставка беса‡Wichtellieferung‡임프 배달‡Entrega de diablillo‡Entrega de diablillo‡Livraison de diablotin‡瓶中的小鬼‡運送小鬼',
    nil,
    'Leve o Diabrete numa Jarra para o laboratório de alquimia em Scolomântia. Depois que o pergaminho for criado, devolva a jarra para Gorzeeki Olholouco.‡Отнесите беса в бутылке в алхимическую лабораторию Некроситета. После создания пергамента верните бутылку Горзики Дикоглазу.‡Bringt den Wichtel im Glas in das Alchemielabor in Scholomance. Bringt das Glas nach der Herstellung des Pergaments zurück zu Gorzeeki Wildaug.‡단지 안에 든 임프를 스칼로맨스에 있는 연금술 실험대로 가져가야 합니다. 양피지가 완성되면 단지를 고르지키 와일드아이즈에게 돌려 주십시오.‡Llévale el diablillo en un tarro al laboratorio de alquimia de Scholomance. Después de crear el papiro llévale el tarro a Gorzeeki Ojovago.‡Llévale el diablillo en un tarro al laboratorio de alquimia de Scholomance. Después de crear el papiro llévale el tarro a Gorzeeki Ojovago.‡Apportez le Diablotin en bouteille au laboratoire d\'alchimie de la Scholomance. Une fois le parchemin créé, rapportez la bouteille à Gorzeeki Fouregard.‡把瓶中的小鬼带到通灵学院的炼金实验室中。在小鬼制造出羊皮纸之后，把瓶子还给戈瑟奇·邪眼。‡把瓶中的小鬼帶到通靈學院的鍊金實驗室中。在小鬼製造出羊皮紙之後，把瓶子還給戈瑟奇·邪眼。',
  }
},
[7630] = {
  {
    'Arcanita‡Арканит‡Arkanit‡아케이나이트‡La arcanita‡La arcanita‡L\'arcanite‡奥金锭‡奧金錠',
    nil,
    'Leve 1 Barra de Arcanita para Gorzeeki nas Estepes Ardentes.‡Принесите 1 арканитовый слиток Горзики в Пылающие степи.‡Bringt 1 Arkanitbarren zu Gorzeeki in der Brennenden Steppe.‡불타는 평원에 있는 고르지키에게 아케이나이트 주괴 1개를 가져가야 합니다.‡Lleva una barra de arcanita a Gorzeeki Ojosalvajes a Las Estepas Ardientes.‡Lleva una barra de arcanita a Gorzeeki Ojosalvajes a Las Estepas Ardientes.‡Apporter 1 Barre d\'arcanite à Gorzeeki dans les Steppes ardentes.‡把1块奥金锭交给燃烧平原的戈瑟奇·邪眼。‡把1塊奧金錠交給燃燒平原的戈瑟奇·邪眼。',
  }
},
[7631] = {
  {
    'Corcel Medonho de Zoroth‡Зоротианский конь погибели‡Schreckensross von Xoroth‡소로스의 공포마‡Corcel nefasto xorothiano‡Corcel nefasto xorothiano‡Le destrier de l\'effroi de Xoroth‡克索诺斯恐惧战马‡克索諾斯恐懼戰馬',
    nil,
    'Leia as Instruções de Mor\'zul. Evoque um Corcel Medonho Zorothiano, derrote-o e então vincule o espírito dele a você.‡Прочтите инструкции Мор\'зула. Призовите зоротианского коня погибели, одолейте его и подчините его дух.‡Lest Morzuls Anweisungen. Beschwört ein xorothianisches Schreckensross, besiegt es und bindet seinen Geist an Euch.‡모르줄의 지시서를 잘 읽으십시오. 소로시안 공포마를 소환해 물리친 후 그 영혼을 결속시켜야 합니다.‡Lee las instrucciones de Mor\'zul. Invoca a un corcel nefasto xorothiano, derrótalo y después vincula su espíritu al tuyo.‡Lee las instrucciones de Mor\'zul. Invoca a un corcel nefasto xorothiano, derrótalo y después vincula su espíritu al tuyo.‡Lisez les Instructions de Mor\'zul. Invoquez un Destrier de l\'effroi xorothien, vainquez-le, et liez son esprit.‡阅读莫苏尔的指南，并召唤出一匹克索诺斯恐惧战马，击败它，然后控制它的灵魂。‡閱讀莫蘇爾的指南，並召喚出一匹克索諾斯恐懼戰馬，擊敗它，然後控制它的靈魂。',
  }
},
[7632] = {
  {
    'A folha antiga‡Древний лист‡Das uralte Blatt‡고대의 잎사귀‡La hoja antigua‡La hoja antigua‡La feuille ancienne‡远古石叶‡遠古石葉',
    nil,
    'Encontre o dono da Folha Antiga Petrificada. Boa sorte, Bomdiyada, pois o mundo é grande.‡Найдите хозяина древнего окаменелого древесного листа. Удачи, Bomdiyada, мир велик.‡Findet den Besitzer des uralten, versteinerten Blatts. Viel Glück, Bomdiyada; die Welt ist groß.‡단단한 고대의 잎사귀의 주인을 찾아야 합니다. 행운을 빕니다, Bomdiyada. 세상은 아주 넓으니까요.‡Encuentra al dueño de la hoja petrificada vieja. Buena suerte, Bomdiyada; este es un mundo enorme...‡Encuentra al dueño de la hoja petrificada vieja. Buena suerte, Bomdiyada; este es un mundo enorme...‡Trouvez le propriétaire de la Feuille ancienne pétrifiée. Bonne chance, Bomdiyada, le monde est vaste.‡找到远古石叶的主人。祝你好运，Nekotestthre。这个世界是很大的。‡找到遠古石葉的主人。祝你好運，Bomdiyada。這個世界是很大的。',
  }
},
[7633] = {
  {
    '‡Посвящение‡Eine Einführung‡‡Una presentación‡Una presentación‡Une rencontre‡介绍‡',
    nil,
    nil,
  }
},
[7634] = {
  {
    'Lâmina Embrulhada de Tendão Antigo‡Перетянутый жилами лист древня‡Uraltes in Sehnen eingewickeltes Laminablatt‡힘줄 감긴 고대의 잎주머니‡Carcaj antiguo cosido con tendón‡Carcaj antiguo cosido con tendón‡Feuille d\'Ancien cousue de tendons‡龙筋箭袋‡龍筋箭袋',
    nil,
    'Hastat, o Anciente, lhe pediu um Tendão de Dragão Azul Maduro. Se você encontrar esse tendão, vá falar com Hastat na Selva Maleva.‡Хастат Древний просит вас принести ему жилу взрослого синего дракона. По выполнении задания возвращайтесь к Хастату в Оскверненный лес.‡Hastat der Uralte hat Euch um die Beschaffung einer Sehne eines ausgewachsenen, blauen Drachen gebeten. Kehrt zu Hastat im Teufelswald zurück, solltet Ihr diese Sehne finden.‡다 자란 푸른용 힘줄을 찾아서 악령숲에 있는 고대정령 하스타트에게 가져가야 합니다.‡Hastat el anciano te ha pedido que le lleves 1 tendón de dragón Azul maduro. Si lo encuentras, llévaselo a Hastat a Frondavil.‡Hastat el anciano te ha pedido que le lleves 1 tendón de dragón azul maduro. Si lo encuentras, llévaselo a Hastat a Frondavil.‡L\'Ancien Hastat vous demande de lui ramener un Tendon de dragon bleu adulte. Si vous en trouvez un, ramenez-le-lui à Gangrebois.‡费伍德森林的古树哈斯塔特要求你带回一块成年蓝龙的肌腱。‡費伍德森林的古樹哈斯塔特要求你帶回一塊成年藍龍的肌腱。',
  }
},
[7635] = {
  {
    'A melhor corda‡Подходящая тетива‡Die passende Sehne‡최고의 활시위‡La cuerda adecuada‡La cuerda adecuada‡La bonne corde‡合适的弓弦‡合適的弓弦',
    nil,
    'Stoma, o Anciente, lhe pediu um Tendão de Dragão Negro Maduro. Se você encontrar esse tendão, vá falar com Stoma na Selva Maleva.‡Стома Древний просит вас принести ему жилу взрослого черного дракона. Добыв жилу, возвращайтесь к Стоме в Оскверненный лес.‡Stoma der Uralte hat Euch um die Beschaffung einer Sehne eines ausgewachsenen, schwarzen Drachen gebeten. Solltet Ihr diese Sehne finden, kehrt zu Stoma im Teufelswald zurück.‡다 자란 푸른용 힘줄을 찾아서 악령숲에 있는 고대정령 하스타트에게 가져가야 합니다.‡Estoma el Anciano te ha pedido que le lleves 1 tendón de dragón Negro maduro. Si lo encontraras, llévaselo a Estoma a Frondavil.‡Estoma el Anciano te ha pedido que le lleves 1 tendón de dragón Negro maduro. Si lo encontraras, llévaselo a Estoma a Frondavil.‡L\'Ancien Stoma vous demande de lui ramener un Tendon de dragon noir adulte. Si vous en trouvez un, ramenez-le à Stoma à Gangrebois.‡费伍德森林的古树斯托玛要求你带给他一块成年黑龙的肌腱。‡費伍德森林的古樹斯托瑪要求你帶給他一塊成年黑龍的肌腱。',
  }
},
[7636] = {
  {
    'Báculo dos Antigos‡Ветвь ходячего Древа‡Holzstab der Uralten‡고대정령의 지팡이‡El báculo de los Ancestros‡El báculo de los Ancestros‡Le bâton des Anciens‡古树的手杖‡上古守護者的手杖',
    nil,
    'Você precisa encontrar e destruir aqueles quatro corruptores demoníacos:|n|nSimone, a Sedutora.|n|nKlinfran, o Enlouquecido.|n|nSolenor, o Matador.|n|nArtórius, o Destruidor.|n|nDestrua aquelas criaturas e fale novamente com Vartrus, o Anciente, na Selva Maleva, trazendo as cabeças deles.|n|nConsulte a Casca Petrificada no seu inventário para ter pistas da localização deles.|n|nVocê TEM QUE completar a tarefa sozinha.‡Вы должны найти и уничтожить следующих четверых демонических разносчиков порчи:|n|nСимон Совратительницу.|n|nКлинфрана Безумного.|n|nСоленора Убийцу.|n|nАрториуса Судьбоносного.|n|nУничтожьте этих тварей и возвращайтесь к Вартусу Древнему в Оскверненный лес с их головами.|n|nВ поисках местонахождения этих демонов сверяйтесь с окаменевшей корой.|n|nВы ОБЯЗАНЫ выполнить это задание в одиночку.‡Ihr müsst die vier dämonischen Verderber ausfindig machen und zerstören:|n|nSimone die Verführerin.|n|nKlinfran der Wahnsinnige.|n|nSolenor der Schlächter.|n|nArtorius der Verhängnisvolle.|n|nVernichtet diese Kreaturen und kehrt zu Vartrus dem Uralten im Teufelswald zurück.|n|nHaltet Euch an die versteinerte Rinde in Eurem Inventar, um Hinweise zu ihren Aufenthaltsorten zu erhalten.|n|nIhr MÜSST diese Aufgabe eigenständig erledigen.‡타락한 악령의 4인조를 찾아 처치해야 합니다.|n|n매혹의 시몬|n|n광기의 클린프랑|n|n학살자 솔레노르|n|n파멸의 인도자 아토리우스|n|n위 넷의 혼을 갈무리하여 악령숲에 있는 고대정령 바르투스에게 돌아가십시오.|n|n이들의 위치에 대한 단서는 바르투스가 주는 돌껍질을 참조하십시오.|n|n이 임무는 반드시 혼자서 완수해야 합니다.‡Debes encontrar y destruir a estos 4 corruptores demoníacos:|n|nSimone la Seductora.|n|nKlinfran el Enloquecido.|n|nSolenor el Destripador.|n|nArtorius el Fatídico.|n|nDestruye a estas criaturas, vuelve a Frondavil y entrega sus cabezas a Vartrus el Ancestro.|n|nBusca pistas de su paradero en la corteza petrificada.|n|nDEBES completar esta misión tú sola.‡Debes encontrar y destruir a estos 4 corruptores demoníacos:|n|nSimone la Seductora.|n|nKlinfran el Enloquecido.|n|nSolenor el Destripador.|n|nArtorius el Fatídico.|n|nDestruye a estas criaturas, vuelve a Frondavil y entrega sus cabezas a Vartrus el Ancestro.|n|nBusca pistas de su paradero en la corteza petrificada.|n|nDEBES completar esta misión tú sola.‡Vous devez trouver et tuer quatre corrupteurs démoniaques :|n|nSimona la Séductrice.|n|nKlinfran l\'Enragé.|n|nSolenor le Tueur.|n|nArtorius le Néfaste.|n|nDétruisez ces créatures et retournez voir l\'Ancien Vartus à Gangrebois.|n|nVous trouverez des indices sur leurs faits et gestes sur l\'Ecorce pétrifiée qui se trouve dans votre inventaire.|n|nVous DEVEZ agir seul.‡你必须找到并干掉下列4个恶魔：|n|n迷人的西蒙妮。|n|n疯狂的克林弗兰。|n|nS屠杀者索伦诺尔。|n|n摧毁者阿托留斯。|n|n杀掉这些恶魔，然后回到费伍德森林的古树瓦特鲁斯那里去。|n|n根据你背包中的石化树皮来找到它们所在位置的线索。|n|n你必须独自完成这个任务。‡你必須找到並幹掉下列4個惡魔:|n|n迷人的西蒙妮。|n|n瘋狂的克林弗蘭。|n|n『殺戮者』索倫諾爾。|n|n『末日使者』阿托留斯。|n|n殺掉這些惡魔，然後回到費伍德森林的古樹瓦特魯斯那裡去。|n|n根據你背包中的石化樹皮來找到它們所在位置的線索。|n|n你必須獨自完成這個任務。',
  }
},
[7637] = {
  {
    'Ênfase em sacrifício‡Жертва необходима‡Ein Opfer darbieten‡희생의 중요성‡Énfasis en el sacrificio‡Énfasis en el sacrificio‡L\'accent sur le sacrifice‡牺牲精神‡犧牲精神',
    nil,
    'Viaje para Altaforja e obtenha o Incensório de Exorcismo do Sumo Sacerdote Rohan. Você precisará fazer uma doação de 150 moedas de ouro para obtê-lo.‡Доберитесь до Стальгорна и получите курильницу экзорцизма у верховного жреца Рохана. За курильницу нужно будет внести плату в размере 150 золотых.‡Reist nach Eisenschmiede und besorgt Euch Hohepriester Rohans Weihrauchschwenker. Eine Spende von 150 Gold wird erforderlich sein, um es zu bekommen.‡아이언포지에 가서 대사제 로한의 퇴마 향로를 얻어야 합니다. 퇴마 향로를 얻으려면 150골드를 기부해야 합니다.‡Viaja a Forjaz y consigue el incensario de exorcismos del sumo sacerdote Rohan. Tendrás que hacer una donación de 150 monedas de oro para conseguirlo.‡Viaja a Forjaz y consigue el incensario de exorcismos del sumo sacerdote Rohan. Tendrás que hacer una donación de 150 monedas de oro para conseguirlo.‡Rendez-vous à Forgefer et procurez-vous l\'Encensoir d\'exorcisme du grand prêtre Rohan. Pour vous le procurer, il vous faudra verser une donation de 150 pièces d\'or.‡到铁炉堡去找高阶牧师洛汉，从他那里拿到驱魔香炉。你需要捐赠150金币来获得它。‡到鐵爐堡去找高階牧師洛漢，從他那裡拿到驅魔香爐。你需要捐贈150金幣來獲得它。',
  }
},
[7638] = {
  {
    'Lorde Grayson Quebrassombra‡Лорд Грейсон Тенелом‡Lord Grayson Schattenbruch‡그레이슨 섀도브레이커 경‡Lord Grayson Quiebrasombras‡Lord Grisillo Quiebrasombras‡Le seigneur Grayson Brisombre‡格雷森·沙东布瑞克公爵‡格雷森·破影者領主',
    nil,
    'Fale com o Lorde Grayson Quebrassombra no Distrito da Catedral de Ventobravo.‡Поговорите с лордом Грейсоном Тенеломом в Соборном квартале Штормграда.‡Sprecht mit Lord Grayson Schattenbruch im Kathedralenviertel von Sturmwind.‡스톰윈드 빛의 대성당에 있는 그레이슨 섀도브레이커 경과 대화해야 합니다.‡Habla con Lord Grayson Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Habla con Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Parler au seigneur Grayson Brisombre dans le Quartier de la Cathédrale de Hurlevent.‡与暴风城教堂区的格雷森·沙东布瑞克公爵谈一谈。‡與暴風城教堂區的格雷森·破影者領主談話。',
  }
},
[7639] = {
  {
    'O devido julgamento‡Демонстрация истинного правосудия‡Lass Gerechtigkeit walten‡희생과 심판‡Mostrarse juicioso‡Mostrarse juicioso‡Des preuves de jugement‡圣骑士的审判‡聖騎士的審判',
    nil,
    'Leve o Incensório de Exorcismo para Lorde Grayson Quebrassombra no Distrito da Catedral de Ventobravo.‡Принесите курильницу экзорцизма лорду Грейсону Тенелому в храмовый квартал Штормграда.‡Bringt den Weihrauchschwenker zu Lord Grayson Schattenbruch in Sturmwind zurück.‡퇴마 향로를 스톰윈드 빛의 대성당에 있는 그레이슨 섀도브레이커 경에게 가져가야 합니다.‡Devuelve el incensario de exorcismos a Lord Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Devuelve el incensario de exorcismos a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Ramener l\'Encensoir d\'exorcisme au seigneur Grayson Brisombre, dans le Quartier de cathédrale de Hurlevent.‡把驱魔香炉交给暴风城教堂区的格雷森·沙东布瑞克公爵。‡把驅魔香爐交給暴風城教堂區的格雷森·破影者領主。',
  }
},
[7640] = {
  {
    'Exorcizando a Várzea do Medo‡Изгнание призраков из Долины Ужаса‡Der Exorzismus des Schreckenstals‡테러데일 퇴마‡Exorcismo en Valle del Terror‡Exorcismo en Valle del Terror‡Exorciser Val-Terreur‡恐惧谷的灵魂‡恐懼谷的靈魂',
    nil,
    'Use o Incensório de Exorcismo para expulsar os espíritos que atormentam a Várzea do Medo. Quando você tiver eliminado 25 Espíritos da Várzea do Medo, fale novamente com Lorde Grayson Quebrassombra no Distrito da Catedral de Ventobravo.‡Используйте курильницу экзорцизма для вызова из-под земли призраков, мучающих долину Ужаса. Когда убьете 25 духов долины Ужаса, вернитесь к лорду Грейсону Тенелому в храмовый квартал Штормграда.‡Vertreibt mithilfe des Weihrauchschwenkers die Geister im Schreckenstal. Vernichtet 25 Schreckenstalgeister und kehrt anschließend zu Lord Grayson Schattenbruch im Kathedralenviertel von Sturmwind zurück.‡퇴마 향로를 사용하여 테러데일에 고통을 주는 영혼을 몰아내야 합니다. 25명의 테러데일 영혼을 해치운 다음 스톰윈드 빛의 대성당에 있는 그레이슨 섀도브레이커 경에게 가야 합니다.‡Utiliza el incensario de exorcismos para expulsar los espíritus que atormentan el Valle del Terror. Cuando hayas matado 25 espíritus del Valle del Terror, vuelve a ver a Lord Grayson Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Utiliza el incensario de exorcismos para expulsar los espíritus que atormentan el Valle del Terror. Cuando hayas matado 25 espíritus del Valle del Terror, vuelve a ver a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Servez-vous de l\'Encensoir d\'exorcisme pour chasser les esprits qui tourmentent Val-Terreur. Lorsque vous aurez tué 25 Esprits de Val-Terreur, retournez voir le seigneur Grayson Brisombre dans le Quartier de la cathédrale de Hurlevent.‡使用驱魔香炉召唤恐惧谷中的灵魂。当你杀掉25个恐惧谷的灵魂之后，回到暴风城教堂区的格雷森·沙东布瑞克公爵那里复命。‡使用驅魔香爐召喚恐懼谷中的靈魂。當你殺掉25個恐懼谷的靈魂之後，回到暴風城教堂區的格雷森·破影者領主那裡覆命。',
  }
},
[7641] = {
  {
    'O trabalho de Grimand Elmore‡Работа Гриманда Элмора‡Grimand Elmores Werk‡그리만트 엘모어의 마갑‡El trabajo de Grimand Elmore‡El trabajo de Grimand Elmore‡L\'œuvre de Grimand Elmore‡格瑞曼德·艾尔默‡格瑞曼德·艾爾默的工作',
    nil,
    'Fale com Grimand Elmore em Ventobravo no Distrito dos Anões de Ventobravo.‡Поговорите с Гримандом Элмором в Квартале Дворфов Штормграда.‡Sprecht mit Grimand Elmore im Zwergendistrikt von Sturmwind.‡스톰윈드의 드워프 지구에 있는 그리만트 엘모어와 대화해야 합니다.‡Habla con Grimand Elmore en el Distrito de los Enanos, en Ventormenta.‡Habla con Grimand Elmore en el Distrito de los Enanos, en Ventormenta.‡Parlez à Grimand Elmore dans le Quartier des Nains de Hurlevent.‡与暴风城矮人区的格瑞曼德·艾尔默谈一谈。‡與暴風城矮人區的格瑞曼德·艾爾默談話。',
  }
},
[7642] = {
  {
    'Coleta de produtos‡Сбор необходимого‡Fünf Dinge‡마갑 재료 수집‡Recopilación de artículos‡Recopilación de artículos‡Une ribambelle d\'objets‡收集材料‡收集材料',
    nil,
    'Leve 40 Runatramas, 6 Barras de Arcanita, 10 Lágrimas-de-arthas, 5 ampolas de Água Benta de Stratholme e 150 moedas de ouro para Grimand Elmore, no Distrito dos Anões de Ventobravo.‡Принесите Гриманду Элмору в Квартал дворфов Штормграда 40 отрезов рунической ткани, 6 арканитовых слитков, 10 цветков слезы Артаса, 5 сосудов со святой водой из Стратхольма и 150 золотых монет.‡Bringt 40 Lagen Runenstoff, 6 Arkanitbarren, 10 Arthas\' Tränen, 5 Phiolen Weihwasser aus Stratholme und 150 Gold zu Grimand Elmore im Zwergendistrikt von Sturmwind.‡룬무늬 옷감 40장, 아케이나이트 주괴 6개, 아서스의 눈물 10개, 스트라솔름 성수 물병 5개 그리고 150골드를 스톰윈드의 드워프 지구에 있는 그리만트 엘모어에게 가져가야 합니다.‡Lleva 40 paños rúnicos, 6 lingotes de arcanita, 10 lágrimas de Arthas, 5 frascos de agua sagrada de Stratholme y 150 monedas de oro a Grimand Elmore en el Distrito de los Enanos de Ventormenta.‡Lleva 40 paños rúnicos, 6 barras de arcanita, 10 lágrimas de Arthas, 5 viales de agua sagrada de Stratholme y 150 monedas de oro a Grimand Elmore en el Distrito de los Enanos de Ventormenta.‡Apporter 40 Etoffes runiques, 6 Barres d\'arcanite, 10 Larmes d\'Arthas, 5 Fioles d\'eau sacrée de Stratholme, et 150 pièces d\'or à Grimand Elmore, au Quartier des nains de Hurlevent.‡把40块符文布、6块奥金锭、10棵阿尔萨斯之泪、5瓶斯坦索姆圣水和150枚金币交给暴风城矮人区的格瑞曼德·艾尔默。‡把40塊符文布、6塊奧金錠、10份阿薩斯之淚、5瓶斯坦索姆聖水和150枚金幣交給暴風城矮人區的格瑞曼德·艾爾默。',
  }
},
[7643] = {
  {
    'O Espírito Equino Antigo‡Дух древнего коня‡Der uralte Pferdegeist‡고대 준마의 영혼‡El antiguo espíritu equino‡El antiguo espíritu equino‡L\'ancien esprit équin‡上古圣马之魂‡上古聖馬之魂',
    nil,
    'Obtenha uma ração de cavalo especial para alimentar o cavalo espiritual. Aparentemente, Judite Castanheira, que vive na Costa Sul, é a fornecedora da tal ração.|n|nEntre na masmorra de Gládio Cruel, em Feralas, e mate Gavíneo Lenhatorta. Isso libertará o Espírito Equino Antigo. Alimente-o com a ração de cavalo especial, o que acalmará o espírito. Finalmente, dê-lhe a Barda de Arcanita para que ele a abençoe.‡Купите лошадиный корм для духа древнего коня у Меридет Карлсон в Южнобережье.|n|nУбейте Тендриса Криводрева в башне Забытого Города в Фераласе и освободите духа. Накормите духа кормом и получите благословление для арканитового чепрака.‡Beschafft spezielles Pferdefutter, mit dem man ein Geisterpferd füttern kann. Merideth Carlson in Süderstade scheint dafür eine recht gute Quelle zu sein.|n|nReist anschließend nach Düsterbruch in Feralas und tötet Tendris Wucherborke. Dies wird den uralten Pferdegeist befreien. Füttert den Geist zur Beruhigung mit dem speziellen Pferdefutter. Gebt dem Pferdegeist das Arkanitpferdegeschirr, um es segnen zu lassen.‡남녘해안에 있는 메리데스 칼슨에게서 말의 영혼에게 먹일 특별한 말 먹이를 획득해야 합니다.|n|n페랄라스에 있는 혈투의 전장 던전으로 가서 굽이나무 텐드리스를 무찔러야 합니다. 굽이나무 텐드리스를 무찌르고 고대 준마의 영혼이 풀려나면 특별한 말 먹이를 먹여 영혼을 진정시키십시오. 마지막으로 아케이나이트 마갑을 주면 영혼이 축복을 내릴 것입니다.‡Consigue comida para caballos para alimentar a un espíritu equino. Por lo visto, Merideth Carlson, en Costasur, tiene esa comida.|n|nVe a la mazmorra de La Masacre, en Feralas y mata a Tendris Alabeo. Al hacerlo, liberarás al antiguo espíritu equino. Dale la comida para caballos y lo aplacarás. Por último, dale la gualdrapa de arcanita para que la bendiga.‡Consigue comida para caballos para alimentar a un espíritu equino. Por lo visto, Merideth Carlson, en Costasur, tiene esa comida.|n|nVe a la mazmorra de La Masacre, en Feralas y mata a Tendris Alabeo. Al hacerlo, liberarás al antiguo espíritu equino. Dale la comida para caballos y lo aplacarás. Por último, dale la gualdrapa de arcanita para que la bendiga.‡Procurez-vous un aliment pour chevaux capable de nourrir un esprit équin. Il semble que Merideth Carlson, à Austrivage, sache en fabriquer.|n|nEnsuite, rendez-vous au donjon de Hache-tripes en Féralas, et tuez Tendris Crochebois. Sa mort libérera l\'Ancien esprit équin. Nourrissez-le avec l\'aliment spécial afin de l\'apaiser. Enfin, donnez-lui le Caparaçon d\'arcanite pour qu\'il le bénisse.‡你需要特殊的饲料来喂养灵魂马。南海镇的梅丽德丝·卡尔森可以为你提供这样的粮草。|n|n到菲拉斯的厄运之槌去，杀掉特迪斯·扭木，释放上古圣马之魂。用特殊的粮草喂养它，这样可以安抚它的灵魂。最后，把奥金马铠交给它就可以完成祝福。‡你需要特殊的飼料來餵養靈魂馬。南海鎮的梅麗德絲·卡爾森可以為你提供這樣的糧草。|n|n到菲拉斯的厄運之槌去，殺掉特迪斯·扭木，釋放上古聖馬之魂。用特殊的糧草餵養它，這樣可以安撫它的靈魂。最後，把奧金馬鎧交給它就可以完成祝福。',
  }
},
[7644] = {
  {
    '‡Благословенный арканитовый чепрак‡Gesegnetes Arkanitpferdegeschirr‡축복받은 아케이나이트 마갑‡Gualdrapa de arcanita bendita‡Gualdrapa de arcanita bendita‡Caparaçon en arcanite béni‡被祝福的奥金马铠‡受祝福的奧金馬鎧',
    nil,
    '‡Вернитесь вместе с благословенным арканитовым чепраком к лорду Грейсону Тенелому в Храмовый квартал Штормграда.‡Kehrt mit dem gesegneten Arkanitpferdegeschirr zu Lord Grayson Schattenbruch in das Kathedralenviertel von Sturmwind zurück.‡‡Devuelve la gualdrapa de arcanita bendita a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Devuelve la gualdrapa de arcanita bendita a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Retourner dans le Quartier de la Cathédrale de Hurlevent avec le Caparaçon d\'arcanite béni pour voir le seigneur Grayson Brisombre.‡将被祝福的奥金马铠交给暴风城教堂区的格雷森·沙东布瑞克公爵。‡',
  }
},
[7645] = {
  {
    'Ração de Cavalo Enriquecida com Mana‡Сытный манный лошадиный корм‡Mit Manna angereichertes Pferdefutter‡맛좋은 만나 사료‡Alimento para caballos enriquecido con maná‡Alimento para caballos enriquecido con maná‡Fourrage enrichi en manne‡魔法粮草‡魔法糧草',
    nil,
    'Obtenha 20 Biscoitos de Maná Enriquecido — o ingrediente chave para fazer Ração de Cavalo Enriquecida com Mana — para Judite Castanheira da Costa Sul, no Contraforte de Eira dos Montes. A Aurora Argêntea é conhecida como a única fornecedora dos biscoitos.|n|nVocê também precisa dar a ela 50 moedas de ouro para a apaziguar os ânimos dela.‡Принесите 20 cытных манных печений – ключевых составляющих сытного манного лошадиного корма – Меридет Карлсон в Южнобережье в предгорьях Хилсбрада. Продается печенье только в Серебряном Рассвете.|n|nКроме того, понадобится дать ей 50 золотых, чтобы успокоить ее ущемленное самолюбие.‡Treibt 20 angereicherte Mannakekse - die ausschlaggebende Zutat für die Herstellung von mit Manna angereichertem Pferdefutter - für Merideth Carlson aus Süderstade im Vorgebirge des Hügellands auf. Die Argentumdämmerung ist als alleiniger Händler dieser Kekse bekannt.|n|nZusätzlich müsst Ihr ihre Gefühle noch mit 50 Goldstücken besänftigen.‡맛좋은 만나빵 20개를 모아서 언덕마루 구릉지의 남녘해안에 있는 메리데스 칼슨에게 가져가야 합니다. 맛좋은 만나빵은 맛좋은 만나 사료에 꼭 필요한 재료입니다. 맛좋은 만나빵은 은빛 여명회에서 독점적으로 파는 것으로 알려져 있습니다.|n|n메리데스 칼슨에게도 50골드를 주어야만 화가 난 마음을 진정시킬 수 있습니다.‡Consigue 20 galletas enriquecidas con maná, ingrediente principal del alimento especial para caballos, y llévaselas a Merideth Carlson a las Laderas de Trabalomas, en Costasur. Solo El Alba Argenta fabrica esas galletas.|n|nTambién tienes que darle 50 piezas de oro para aplacar su orgullo herido.‡Consigue 20 galletas enriquecidas con maná, ingrediente principal del alimento especial para caballos, y llévaselas a Merideth Carlson a las Laderas de Trabalomas, en Costasur. Solo El Alba Argenta fabrica esas galletas.|n|nTambién tienes que darle 50 piezas de oro para aplacar su orgullo herido.‡Récupérer 20 Biscuits de manne enrichis, l\'ingrédient vital qui permet de préparer du Fourrage enrichi en manne, pour le compte de Merideth Carlson de Southore dans les contreforts de Hautebrande. L\'Aube d\'argent est la seule à fabriquer ces biscuits.|n|nVous devrez également lui donner 50 pièces d\'or pour apaiser sa susceptibilité.‡把制作魔法粮草所需要的重要材料：20块可口的魔法点心带给希尔斯布莱德丘陵的梅丽德丝-卡尔森。据说银色黎明会出售这种饼干。|n|n你还需要给她50金币来对她进行安抚。‡把製作魔法糧草所需要的重要材料:20塊可口的魔法點心帶給希爾斯布萊德丘陵的梅麗德絲·卡爾森。據說銀色黎明會出售這種餅乾。|n|n你還需要給她50金幣來對她進行安撫。',
  }
},
[7646] = {
  {
    '‡Магический кристалл‡Das Orakel der Anrufung‡‡El cristal de adivinación‡El cristal de adivinación‡Le Clairvoyant‡预言水晶球‡',
    nil,
    '‡Принесите азеротский алмаз и безупречный черный алмаз лорду Грейсону Тенелому в Храмовый квартал Штормграда.‡Bringt Lord Grayson Schattenbruch im Kathedralenviertel von Sturmwind einen azerothischen Diamanten und einen makellosen schwarzen Diamanten.‡‡Lleva un diamante de Azeroth y un diamante negro prístino a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Lleva un diamante de Azeroth y un diamante negro prístino a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Apportez un Diamant d\'Azeroth et un Diamant noir en parfait état au seigneur Grayson Brisombre dans le Quartier de la Cathédrale de Hurlevent.‡把一块艾泽拉斯钻石和一块原始黑钻石交给暴风城教堂区的格雷森·沙东布瑞克公爵。‡',
  }
},
[7647] = {
  {
    'Julgamento e redenção‡Суд и расплата‡Gerechtigkeit und Erlösung‡심판과 구원의 손길‡Juzgar y redimir‡Juzgar y redimir‡Jugement et rédemption‡审判和救赎‡審判和救贖',
    nil,
    'Use o Cristal Divinatório no coração do porão do Grande Ossário, em Scolomântia. Isso invocará espíritos que você precisará julgar. A derrota dos espíritos evocará o Cavaleiro da Morte Noctilatrus. Derrote-o e reclame a alma perdida do corcel caído.|n|nEntregue a Alma Redimida do Corcel e a Barda Encantada Abençoada ao Corcel Caído de Noctilatrus.‡Используйте магический кристалл в центре подвала Великого оссуария в Некроситете. Победите вызванных духов, а затем – рыцаря смерти Темного Терзателя, который появится после поражения духов.|n|nВерните падшему скакуну Темного Терзателя его спасенную душу и покройте его благословенным зачарованным чепраком.‡Benutzt das Orakel der Anrufung im Herzen des Kellergewölbes des Großen Ossuariums, in Scholomance. Damit ruft Ihr die verfluchten Geister, über deren Schicksal Ihr richten müsst. Durch das Besiegen der Geister wird der Todesritter Schattensichel beschworen. Besiegt ihn und holt Euch die verlorene Seele des gefallenen Streitrosses.|n|nGebt die Seele des gefallenen Streitrosses und das gesegnete und verzauberte Pferdegeschirr Schattensichels gefallenem Streitross zurück.‡스칼로맨스에 있는 대형 납골당 지하의 중심부로 가서 예언의 탐지기를 사용해야 합니다. 그러면 영혼들이 나타날 것이니 그들을 해치우십시오. 그들을 해치우면 죽음의 기사 다크리버가 나타날 것이니 그를 물리친 다음 군마의 영혼의 잃어버린 영혼을 되찾아야 합니다.|n|n구원된 군마의 영혼과 축복받은 아케이나이트 마갑을 다크리버 군마의 영혼에게 돌려줘야 합니다.‡Utiliza el cristal de adivinación en el centro del sótano de El Gran Osario en Scholomance. Al hacerlo, aparecerán los espíritus que tienes que juzgar. Si derrotas a esos espíritus, aparecerá el Caballero de la Muerte Atracoscuro. Acaba con él y reclama el alma perdida del destrero caído.|n|nEntrega el alma redimida del destrero y la gualdrapa encantada bendecida al destrero caído de Atracoscuro.‡Utiliza el cristal de adivinación en el centro del sótano de El Gran Osario en Scholomance. Al hacerlo, aparecerán los espíritus que tienes que juzgar. Si derrotas a esos espíritus, aparecerá el Caballero de la Muerte Atracoscuro. Acaba con él y reclama el alma perdida del destrero caído.|n|nEntrega el alma redimida del destrero y la gualdrapa encantada bendecida al destrero caído de Atracoscuro.‡Utilisez le Clairvoyant au coeur du sous-sol du Grand ossuaire, dans la Scholomance. Cela attirera des esprits que vous devrez juger. Lorsqu\'ils seront vaincus, le Chevalier de la mort Ravassombre apparaîtra. Vainquez-le et purifiez l\'âme du destrier déchu.|n|nEnsuite, donnez l\'Ame rachetée du destrier et le Caparaçon enchanté et béni au Destrier déchu de Ravassombre.‡在通灵学院尸骨储藏所地下室的中心使用预言水晶球。将你要审判的灵魂引领出来。将这些灵魂击败然后死亡骑士达克雷尔就将被召唤出来。将其击败然后获得堕落战马的灵魂。|n|n把赎罪的战马之魂和被祝福的奥金马铠一起附在达克雷尔的堕落战马身上。‡在通靈學院屍骨儲藏所地下室的中心使用預言水晶球。將你要審判的靈魂引領出來。將這些靈魂擊敗然後死亡騎士達克雷爾就將被召喚出來。將其擊敗然後獲得墮落戰騎的靈魂。|n|n把戰騎的救贖之魂和受祝福的奧金馬鎧一起附在達克雷爾的墮落戰騎身上。',
  }
},
[7648] = {
  {
    '‡Шедевр Гриманда‡Grimands feinste Arbeit‡‡Un trabajo bien hecho‡Un trabajo bien hecho‡Le chef-d\'œuvre de Grimand‡艾尔默的手艺‡',
    nil,
    '‡Покажите арканитовый чепрак лорду Грейсону Тенелому в Храмовом квартале Штормграда.‡Bringt das Arkanitpferdegeschirr zur Begutachtung zu Lord Grayson Schattenbruch im Kathedralenviertel von Sturmwind.‡‡Lleva la gualdrapa de arcanita a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta para que la inspeccione.‡Lleva la gualdrapa de arcanita a Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta para que la inspeccione.‡Présentez le Caparaçon d\'arcanite au seigneur Grayson Brisombre dans le Quartier de la Cathédrale de Hurlevent, pour inspection.‡把奥金马铠交给暴风城教堂区的格雷森·沙东布瑞克公爵。‡',
  }
},
[7649] = {
  {
    'Malha de Placas de Tório Encantado: volume I‡"Зачарованная ториевая броня", том I‡Verzauberter Thoriumplattenpanzer: Band I‡마력 깃든 토륨 갑옷 I‡Las mallas de placas en torio encantado: volumen I‡Las mallas de placas en torio encantado: volumen I‡Les plates en thorium enchanté - Volume I‡魔化瑟银板甲：第一卷‡附魔瑟銀鎧甲:第一卷',
    nil,
    'Devolva o livro aos legítimos donos.‡Верните книгу законным владельцам.‡Bringt das Buch seinen rechtmäßigen Besitzern zurück.‡주인에게 책을 돌려줘야 합니다.‡Devuelve el libro a sus legítimos dueños.‡Devuelve el libro a sus legítimos dueños.‡Rendez ce livre à ses légitimes propriétaires.‡将这本典籍交给它的主人。‡將這本典籍交給它的主人。',
