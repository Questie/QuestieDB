},
[9322] = {
  {
    'As chamas selvagens de Kalimdor‡Костры Калимдора‡Glühende Feuer in Kalimdor‡칼림도어의 거친 불꽃‡Los fuegos salvajes de Kalimdor‡Los fuegos salvajes de Kalimdor‡Feux sauvages en Kalimdor‡卡利姆多的野火‡卡林多的藍色火焰',
    nil,
    'Visite o Festival de Verão em Azshara, em Silithus, na Cratera Un\'Goro e em Hibérnia. Em seguida, fale novamente com o Guardachamas do Festival.‡Посетите лагеря праздника Огненного солнцеворота, размещенные в Азшаре, Силитусе, Кратере Ун\'Горо и Зимних Ключах, затем вернитесь к хранителю праздничного пламени.‡Sucht die Lager des Sonnenwendfests in Azshara, Silithus, dem Krater von Un\'Goro und Winterquell auf. Kehrt dann zum Flammenbewahrer zurück.‡아즈샤라, 실리더스, 운고로 분화구 및 여명의 설원에 있는 한여름 불꽃 축제 야영지를 방문하고 한여름 축제 불꽃지기에게 가야 합니다.‡Visita los campamentos del Solsticio de Azshara, Silithus, Cráter de Un\'Goro y Cuna del Invierno y ve a ver al guardián de la llama del Festival.‡Visita los campamentos del Solsticio de Azshara, Silithus, Cráter de Un\'Goro y Cuna del Invierno y ve a ver al guardián de la llama del Festival.‡Visitez les campements du solstice d\'été en Azshara, en Silithus, au cratère d\'Un\'Goro et à Berceau-de-l\'Hiver, puis revenez voir le Gardien des flammes.‡造访艾萨拉、希利苏斯、安戈洛环行山和冬泉谷的仲夏庆典营地，然后回到节日护火者处。‡拜訪艾薩拉，希利蘇斯，安戈洛環形山，和冬泉谷的仲夏營地，再回去找節慶營火管理者。',
  }
},
[9323] = {
  {
    'As chamas selvagens dos Reinos do Leste‡Костры Восточных королевств‡Glühende Feuer in den Östlichen Königreichen‡동부 왕국의 거친 불꽃‡Los fuegos salvajes de los Reinos del Este‡Los fuegos salvajes de los Reinos del Este‡Feux sauvages dans les royaumes de l\'Est‡东部王国的野火‡東部王國的藍色火焰',
    nil,
    'Visite o Festival do Fogo na Barreira do Inferno, nas Terras Pestilentas Orientais, nas Terras Agrestes e na Garganta Abrasadora. Em seguida, fale com o Guardachamas do Festival.‡Посетите лагеря Праздника Огня, размещенные в Выжженных землях, Восточных Чумных землях, во Внутренних землях и Тлеющем ущелье, затем поговорите с хранителем праздничного пламени.‡Reist zu den Lagern des Sonnenwendfests in den Verwüsteten Landen, den Östlichen Pestländern, dem Hinterland und der Sengenden Schlucht. Kehrt dann zum Flammenbewahrer zurück.‡저주받은 땅, 동부 역병지대, 동부 내륙지, 이글거리는 협곡에 있는 불꽃 축제 야영지를 방문한 다음 한여름 축제 불꽃지기와 대화해야 합니다.‡Visita los campamentos del Festival del Solsticio de Las Tierras Devastadas, las Tierras de la Peste del Este, las Tierras del Interior y La Garganta de Fuego y ve a ver al guardián de la llama del Festival.‡Visita los campamentos del Festival del Solsticio de Las Tierras Devastadas, las Tierras de la Peste del Este, las Tierras del Interior y La Garganta de Fuego y ve a ver al guardián de la llama del Festival.‡Rendez visite aux campements de la fête du Feu situés dans les Terres foudroyées, les Maleterres de l\'est, les Hinterlands, et la gorge des Vents brûlants, puis allez parler au gardien des flammes de la fête.‡造访诅咒之地、东瘟疫之地、辛特兰和灼热峡谷的火焰节营地，然后回到节日护火者处。‡拜訪詛咒之地，東瘟疫之地，辛特蘭和灼熱峽谷的火焰節慶營地。',
  }
},
[9324] = {
  {
    'Roubando a chama de Orgrimmar‡Похищение пламени Оргриммара‡Raubt die Flamme von Orgrimmar‡오그리마 불꽃 훔치기‡Robar la llama de Orgrimmar‡Robar la llama de Orgrimmar‡Voler la flamme d\'Orgrimmar‡盗取奥格瑞玛的烈焰‡偷取奧格瑪之焰',
    nil,
    'Devolva a Chama de Orgrimmar para o Historiador do Festival.‡Верните Пламя Оргриммара хранителю мудрости Праздника.‡Bringt die Flamme von Orgrimmar zum Meister der Lehren.‡한여름 축제 현자에게 오그리마 불꽃을 돌려줘야 합니다.‡Devuelve la llama de Orgrimmar al maestro cultural del Festival.‡Devuelve la llama de Orgrimmar al maestro cultural del Festival.‡Rapportez la Flamme d\'Orgrimmar au Maître des traditions.‡将奥格瑞玛烈焰交给节日博学者。‡將奧格瑪之焰交給節慶博學大師。',
  }
},
[9325] = {
  {
    'Roubando a chama do Penhasco do Trovão‡Похищение пламени Громового Утеса‡Raubt die Flamme von Donnerfels‡썬더 블러프 불꽃 훔치기‡Robar la llama de Cima del Trueno‡Robar la llama de Cima del Trueno‡Voler la flamme des Pitons-du-Tonnerre‡盗取雷霆崖的烈焰‡偷取雷霆崖之焰',
    nil,
    'Entregue a chama do Penhasco do Trovão para o Historiador do Festival.‡Верните Пламя Громового Утеса хранителю мудрости Праздника.‡Bringt die Flamme von Donnerfels zum Meister der Lehren.‡한여름 축제 현자에게 썬더 블러프 불꽃을 가져가야 합니다.‡Devuelve la Llama de Cima del Trueno al maestro del Conocimiento del festival.‡Devuelve la llama de Cima del Trueno al maestro cultural del Festival.‡Rapportez la flamme des Pitons-du-Tonnerre au Maître des traditions.‡将雷霆崖烈焰交给节日博学者。‡將雷霆崖之焰交給節慶博學大師。',
  }
},
[9326] = {
  {
    'Roubando as chamas da Cidade Baixa‡Похищение пламени Подгорода‡Raubt die Flamme von Unterstadt‡언더시티 불꽃 훔치기‡Robar la llama de Entrañas‡Robar la llama de Entrañas‡Voler la flamme de Fossoyeuse‡盗取幽暗城的烈焰‡偷取幽暗城之焰',
    nil,
    'Entregue a chama da Cidade Baixa para o Historiador do Festival.‡Верните Пламя Подгорода хранителю мудрости Праздника.‡Bringt die Flamme von Unterstadt zum Meister der Lehren.‡한여름 축제 현자에게 언더시티 불꽃을 가져가야 합니다.‡Devuelve la llama de Entrañas al maestro cultural del Festival.‡Devuelve la llama de Entrañas al maestro cultural del Festival.‡Rapportez la flamme de Fossoyeuse au Maître des traditions.‡将幽暗城烈焰交给节日博学者。‡將幽暗城之焰交給節慶博學大師。',
  }
},
[9327] = {
  {
    'Os Renegados‡Отрекшиеся‡Die Verlassenen‡포세이큰‡Los Renegados‡Los Renegados‡Les Réprouvés‡被遗忘者‡被遺忘者',
    nil,
    'Fale com o Alto-executor Malta em Tranquillien, que fica na Terra Fantasma.‡Поговорите с верховным вершителем Мавреном в Транквиллионе, что в Призрачных землях.‡Sprecht mit Hochexekutor Mavren in Tristessa in den Geisterlanden.‡유령의 땅, 트랜퀼리엔에 있는 고위집행관 마브렌과 대화해야 합니다.‡Habla con el sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Habla con el sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Allez parler au Grand exécuteur Mavren à Tranquillien, dans les Terres fantômes.‡与塔奎林的高级执行官玛尔伦谈一谈。‡到鬼魂之地的安寧地和高階執行官瑪弗倫談談。',
  }
},
[9328] = {
  {
    'Herói dos Sin\'dorei‡Герой син\'дорай‡Held der Sin\'dorei‡신도레이의 영웅‡Héroe de los sin\'dorei‡Héroe de los sin\'dorei‡Un héros parmi les Sin\'dorei‡辛多雷的英雄‡辛多雷的英雄',
    nil,
    'Leve a Cabeça de Dar\'Khan para Lor\'themar Theron em Luaprata.‡Принесите голову Дар\'Хана Лор\'темару Терону в Луносвет.‡Bringt Dar\'Khans Kopf zu Lor\'themar Theron in Silbermond.‡다르칸의 머리카락을 실버문에 있는 로르테마르 테론에게 가져가야 합니다.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron a Ciudad de Lunargenta.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron en la Ciudad de Lunargenta.‡Apportez la Tête de Dar\'Khan à Lor\'themar Theron, à Lune-d\'argent.‡将达尔坎的徽记交给银月城的洛瑟玛·塞隆。‡把達克汗的頭顱帶給銀月城的洛索瑪·塞隆。',
  }
},
[9329] = {
  {
    'Os Renegados‡Отрекшиеся‡Die Verlassenen‡포세이큰‡Los Renegados‡Los Renegados‡Les Réprouvés‡被遗忘者‡被遺忘者',
    nil,
    'Fale com o Alto-executor Malta em Tranquillien, que fica na Terra Fantasma.‡Поговорите с верховным вершителем Мавреном в Транквиллионе, что в Призрачных землях.‡Sprecht mit Hochexekutor Mavren in Tristessa in den Geisterlanden.‡유령의 땅, 트랜퀼리엔에 있는 고위집행관 마브렌과 대화해야 합니다.‡Habla con el sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Habla con el sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Allez parler au Grand exécuteur Mavren à Tranquillien, dans les Terres fantômes.‡与塔奎林的高级执行官玛尔伦谈一谈。‡到鬼魂之地的安寧地和高階執行官瑪弗倫談談。',
  }
},
[9330] = {
  {
    '‡Похищение пламени Штормграда‡Raubt die Flamme von Sturmwind‡스톰윈드 불꽃 훔치기‡Robar la llama de Ventormenta‡Robar la llama de Ventormenta‡Voler la flamme de Hurlevent‡盗取暴风城的烈焰‡偷取暴風城之焰',
    nil,
    '‡Верните Пламя Штормграда Праздничному Сказителю.‡Bringt die Flamme von Sturmwind zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 스톰윈드 불꽃을 가져가야 합니다.‡Devuelve la Llama de Ventormenta al Cuentacuentos del festival.‡Devuelve la llama de Ventormenta al cuentacuentos del Festival.‡Rapportez la flamme de Hurlevent au Conteur de la fête.‡将暴风城烈焰交给节日诗人。‡將暴風城之焰交給節慶故事使者。',
  }
},
[9331] = {
  {
    '‡Похищение пламени Стальгорна‡Raubt die Flamme von Eisenschmiede‡아이언포지 불꽃 훔치기‡Robar la llama de Forjaz‡Robar la llama de Forjaz‡Voler la flamme de Forgefer‡盗取铁炉堡的烈焰‡',
    nil,
    '‡Верните Пламя Стальгорна Праздничному Сказителю.‡Bringt die Flamme von Eisenschmiede zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 아이언포지 불꽃을 가져가야 합니다.‡Devuelve la llama de Forjaz al cuentacuentos del Festival.‡Devuelve la llama de Forjaz al cuentacuentos del Festival.‡Rapportez la flamme de Forgefer au Conteur de la fête.‡将铁炉堡烈焰交给节日诗人。‡',
