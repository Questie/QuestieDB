[4361] = {
  {
    '‡Недобрые вести‡Der Überbringer schlechter Botschaften...‡‡Portador de malas noticias‡Portador de malas noticias‡Le porteur des mauvaises nouvelles‡糟糕的消息‡',
    nil,
    '‡Вернитесь в Стальгорн и сообщите нехорошие новости королю Магни Бронзобороду.‡Kehrt nach Eisenschmiede zurück und überbringt König Magni Bronzebart die schlechten Nachrichten.‡‡Regresa a Forjaz y dale las malas noticias al rey Magni Barbabronce.‡Regresa a Forjaz y dale las malas noticias al rey Magni Barbabronce.‡Retourner à Forgefer et apporter la mauvaise nouvelle au Roi Magni Barbe-de-bronze.‡回到铁炉堡，把这个坏消息带给国王麦格尼·铜须。‡',
  }
},
[4362] = {
  {
    'O destino do reino‡Судьба королевства‡Das Schicksal des Königreichs‡왕국의 운명‡El destino del reino‡El destino del reino‡Le destin du Royaume‡王国的命运‡王國的命運',
    nil,
    'Volte ao Abismo Rocha Negra e resgate a Princesa Moira Barbabronze das garras malignas do Imperador Dagran Thaurissan.|n‡Вернитесь в Глубины Черной горы и освободите принцессу Мойру Бронзобород от злобного императора Даграна Тауриссана.‡Kehrt in die Schwarzfelstiefen zurück und rettet Prinzessin Moira Bronzebart aus den Fängen des bösen Imperators Dagran Thaurissan.‡검은바위 나락으로 돌아가 제왕 다그란 타우릿산의 사악한 손아귀에서 공주 모이라 브론즈비어드를 구출해야 합니다.‡Vuelve a las Profundidades de Roca Negra y rescata a la princesa Moira Barbabronce de las garras del emperador Dragan Thaurissan.|n‡Vuelve a las Profundidades de Roca Negra y rescata a la princesa Moira Barbabronce de las garras del emperador Dragan Thaurissan.|n‡Retourner dans les Profondeurs de Rochenoire et secourir la Princesse Moira Barbe-de-bronze, prisonnière de l\'Empereur Dagran Thaurissan.‡回到黑石深渊，从达格兰·索瑞森大帝的魔掌中救出铁炉堡公主茉艾拉·铜须。‡回到黑石深淵，從達格蘭·索瑞森大帝的魔掌中救出鐵爐堡公主茉艾拉·銅鬚。',
  }
},
[4363] = {
  {
    '‡Королевский сюрприз‡Die Überraschung der Prinzessin‡‡La sorpresa de la princesa‡La sorpresa de la princesa‡La surprise de la Princesse‡语出惊人的公主‡',
    nil,
    '‡Вернитесь в Стальгорн и переговорите с королем Магни Бронзобородом.‡Kehrt nach Eisenschmiede zurück und sprecht mit König Magni Bronzebart.‡‡Regresa a Forjaz y habla con el rey Magni Barbabronce.‡Regresa a Forjaz y habla con el rey Magni Barbabronce.‡Retourner à Forgefer et parler au roi Magni Barbe-de-bronze.‡回到铁炉堡去，与国王麦格尼·铜须谈一谈。‡',
  }
},
