[1264] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Encontre o Comandante Samaul no Pântano Vadeoso.‡Найдите командира Самаула в Пылевых топях.‡Sucht Kommandant Samaul in den Düstermarschen.‡먼지진흙 습지대에서 사령관 사마울을 찾아야 합니다.‡Encuentra al comandante Samaul en el Marjal Revolcafango.‡Encuentra al comandante Samaul en el Marjal Revolcafango.‡Trouver le commandant Samaul, dans le marécage d\'Âprefange.‡找到尘泥沼泽的指挥官萨穆尔。‡找到塵泥沼澤的指揮官薩莫爾。',
  }
},
[1265] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Procure pistas sobre o Recruta Remos no Pontal de Vigília.‡Обыщите сторожевой пост, чтобы найти следы рядового Хендела.‡Sucht die Späherwacht nach Spuren des Gefreiten Hendel ab.‡감시초소에서 병사 헨델에 대한 단서를 찾아야 합니다.‡Explora el Alto del Centinela en busca de alguna señal del soldado Hendel.‡Explora el Alto del Centinela en busca de alguna señal del soldado Hendel.‡Chercher le soldat Hendel à la halte de la Vigie.‡在警戒哨岗中打探亨德尔下士的消息。‡在警戒崗哨中搜索士兵亨德爾的消息。',
  }
},
[1266] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Encontre o Recruta Remos no Pântano Vadeoso.‡Найдите рядового Хендела в Пылевых топях.‡Sucht den Gefreiten Hendel in den Düstermarschen.‡먼지진흙 습지대에서 병사 헨델을 찾아야 합니다.‡Encuentra al soldado Hendel en el Marjal Revolcafango.‡Encuentra al soldado Hendel en el Marjal Revolcafango.‡Trouver le soldat Hendel dans le marécage d\'Âprefange.‡找到尘泥沼泽中的亨德尔下士。‡找到塵泥沼澤中的士兵亨德爾。',
  }
},
[1267] = {
  {
    '‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡',
    nil,
    '‡Поговорите с леди Джайной Праудмур в Пылевых топях.‡Sprecht mit Jaina Prachtmeer im Sumpf der Düstermarschen.‡‡Habla con Jaina Valiente en el Pantano Revolcafango.‡Habla con Jaina Valiente en el Pantano Revolcafango.‡Parler à Jaina Portvaillant au marécage d\'Âprefange.‡与尘泥沼泽的吉安娜·普罗德摩尔谈一谈。‡',
  }
},
[1268] = {
  {
    '[DEPRECATED]Suspicious Hoofprints‡[DEPRECATED]Suspicious Hoofprints‡Verdächtige Hufabdrücke‡수상한 발굽 자국‡[DEPRECATED]Huellas de pezuñas sospechosas‡‡[PÉRIMÉ]Des empreintes de sabots suspectes‡‡',
    nil,
    'Informe Krog, na Aldeia Muralha Verde, sobre as pegadas suspeitas na Estalagem Pouso do Umbral.‡Доложите о подозрительных следах возле таверны "Последний привал" Крогу из деревни Гиблотопь.‡Berichtet Krog in Brackenwall von den verdächtigen Abdrücken beim Gasthaus "Zur Süßen Ruh".‡담쟁이 마을에 있는 크로그에게 그늘 쉼터 여관의 수상한 흔적에 대해 보고해야 합니다.‡Informa a Krog en el Poblado Murohelecho sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informa a Krog en el Poblado Murohelecho sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Faire votre rapport sur les empreintes suspectes de l\'auberge du repos ombragé à Krog, au village de Mur-de-Fougères.‡把树荫旅店的可疑蹄印报告给蕨墙村的克罗格。‡',
  }
},
[1269] = {
  {
    '[DEPRECATED]Lieutenant Paval Reethe‡[DEPRECATED]Lieutenant Paval Reethe‡Leutnant Paval Reethe‡부관 파발 리테‡[DEPRECATED]Teniente Paval Reethe‡‡[PÉRIMÉ]Le lieutenant Paval Reethe‡‡',
    nil,
    'Leve o Distintivo de Reethe para Krog na Aldeia Muralha Verde.‡Принесите бляху Рита Крогу в деревню Гиблотопь.‡Bringt Reethes Abzeichen zu Krog in Brackenwall.‡담쟁이 마을에 있는 크로그에게 리테의 배지를 가져가야 합니다.‡Lleva el distintivo de Reethe a Krog al Poblado Murohelecho.‡‡Rapporter l\'insigne de Reethe à Krog à Mur-de-Fougères.‡‡',
  }
},
[1270] = {
  {
    'A fuga do Cascão‡Побег Вонючки‡Stinkis Flucht‡말썽꾼의 탈출‡La fuga de Apestoso‡La fuga de Apestoso‡Sauvetage du Puant‡伊格纳兹的逃亡‡伊格納茲的逃亡',
    nil,
    'Escolte Inácio "Cascão" e, em seguida, fale com Cáliper Porcatraca na Vila Catraca.‡Сопроводите "Вонючку" Игнаца, затем пообщайтесь с Мебоком Миззриксом в Кабестане.‡Begleitet "Stinki" Ignatz und sprecht dann mit Mebok Mizzyrix in Ratschet.‡"말썽꾼" 이그나츠를 호위한 다음 톱니항에 있는 메보크 미지릭스와 대화해야 합니다.‡Escolta a "Apestoso" Ignatz y luego ve a Trinquete a hablar con Mebok Mizzyrix.‡Escolta a "Apestoso" Ignatz y luego ve a Trinquete a hablar con Mebok Mizzyrix.‡Escortez Ignatz « Puant » puis parlez à Mebok Mizzyrix à Cabestan.‡护送伊格纳兹，然后和棘齿城的麦伯克·米希瑞克斯谈一谈。‡護送伊格納茲，然後和棘齒城的麥伯克·米希瑞克斯談話。',
  }
},
[1271] = {
  {
    'O banquete do Recôndito Azulego‡Праздник в "Печальном отшельнике"‡Festmahl im Blauen Eremiten‡고독한 은둔자 선술집에서의 잔치‡¡Una fiesta en tu honor!‡¡Una fiesta en tu honor!‡Fête au Solitaire Bleu‡盛筵‡盛筵',
    nil,
    nil,
  }
},
[1272] = {
  {
    '‡Найти Рита <CHANGE INTO GOSSIP>‡Sucht Reethe <ZU TRATSCH WECHSELN>‡‡Encontrar a Reethe <CHANGE INTO GOSSIP>‡Encontrar a Reethe <CHANGE INTO GOSSIP>‡Trouver Reethe <CHANGE INTO GOSSIP>‡‡',
    nil,
