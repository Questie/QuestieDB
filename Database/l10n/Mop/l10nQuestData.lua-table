[13661] = {
  {
    'Reconhecimento sincero‡Сердечная признательность‡Wertschätzung aus tiefstem Herzen‡진실 어린 감사‡Aprecio de corazón‡Aprecio de corazón‡Notre appréciation la plus sincère‡衷心的感谢‡衷心感激',
    nil,
    nil,
  }
},
[13662] = {
  {
    'Conquistando a confiança‡Завоевать благосклонность‡Anerkennung erlangen‡인정받기‡Conseguir aceptación‡Conseguir aceptación‡Se faire accepter‡获得信任‡贏得認同',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[13663] = {
  {
    'As ordens do Cavaleiro Negro‡Приказы для Черного рыцаря‡Die Befehle des Schwarzen Ritters‡흑기사의 명령서‡Las órdenes del Caballero Negro‡Las órdenes del Caballero Negro‡Les ordres du Chevalier noir‡黑骑士的命令‡黑騎士的命令',
    nil,
    'Use o Bridão Encantado para assumir o controle do Grifo do Cavaleiro Negro e voe nele até chegar ao destino. Depois disso, recupere o Convite do Torneio Roubado e as Ordens do Cavaleiro Negro e leve-as à Cruzada Rhydalla nos Campos do Torneio Argênteo.‡Воспользуйтесь волшебной уздечкой, чтобы подчинить грифона Черного рыцаря и попасть к дому его хозяина. Как только вы попадете на место, найдите украденное приглашение на турнир и приказы для Черного рыцаря, после чего отнесите их рыцарю Райдалле в Серебряный павильон на Ристалище Серебряного Турнира.‡Erhaltet mithilfe des verzauberten Zaumzeugs Kontrolle über den Greifen des Schwarzen Ritters und reitet auf seinem Rücken zum Zielort. Beschafft Euch die gestohlene Einladung zum Turnier und die Befehle des Schwarzen Ritters, sobald Ihr dort angekommen seid, und bringt sie zurück zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡마력 깃든 고삐를 이용해 흑기사의 그리핀을 제압한 후, 목적지까지 타고 가십시오. 도착하면 도둑맞은 마상시합 초대장과 흑기사의 명령서를 입수해 은빛십자군 마상시합 광장의 성전사 라이달라에게 가져가야 합니다.‡Usa la brida encantada para controlar al grifo del Caballero Negro y que te lleve a su destino. Cuando llegues, coge la invitación para el torneo robada y las órdenes del Caballero Negro y llévaselas a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Usa la brida encantada para controlar al grifo del Caballero Negro y que te lleve a su destino. Cuando llegues, coge la invitación para el torneo robada y las órdenes del Caballero Negro y llévaselas a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Utilisez la Bride enchantée pour prendre le contrôle du Griffon du Chevalier noir et chevauchez-le vers sa destination. Une fois que vous y serez, récupérez l\'Invitation au tournoi volée et les Ordres du Chevalier noir, puis apportez-les à la Croisée Rhydalla dans l\'Enceinte du tournoi d\'Argent.‡使用魔法缰绳控制黑骑士的狮鹫，骑着它飞到目的地，然后找到被偷走的锦标赛邀请函和黑骑士的命令，并把它们带回银色比武场，交给北伐军战士莱达拉。‡使用附魔韁轡控制黑騎士的獅鷲獸，並騎著牠前往目的地。一旦你抵達後，找到失竊的聯賽邀請函和黑騎士的命令，然後把這些東西帶給銀白聯賽場地的十字軍萊達菈。',
  }
},
[13664] = {
  {
    'A queda do Cavaleiro Negro‡Падение Черного рыцаря‡Der Sturz des Schwarzen Ritters‡흑기사의 최후‡La caída del Caballero Negro‡La caída del Caballero Negro‡La chute du Chevalier noir‡黑骑士之死‡黑騎士之死',
    nil,
    'Derrote o Cavaleiro Negro e depois fale com a Cruzada Rhydalla nos Campos do Torneio Argênteo.‡Одержите победу над Черным рыцарем, после чего поговорите с рыцарем Райдаллой в Серебряном павильоне на Ристалище Серебряного турнира.‡Besiegt den Schwarzen Ritter und sprecht anschließend mit Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡흑기사를 쓰러뜨린 후 은빛십자군 마상시합 광장에 있는 성전사 라이달라와 대화해야 합니다.‡Derrota al Caballero Negro y luego habla con la cruzada Rhydalla en los Campos del Torneo Argenta.‡Derrota al Caballero Negro y luego habla con la cruzada Rhydalla en los Campos del Torneo Argenta.‡Battez le Chevalier noir puis allez parler à la Croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent.‡击败黑骑士，然后向银色比武场的北伐军战士莱达拉复命。‡擊敗黑騎士然後與銀白聯賽場地的十字軍萊達菈談話。',
  }
},
[13665] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente ao Capitão Josué Rolém.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите три знака искателя славы капитану Джозефу Холли в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Hauptmann Joseph Holley beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 대장 조셉 홀리에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso al capitán Joseph Holley en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso al capitán Joseph Holley en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant au Capitaine Joseph Holley, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的约瑟夫·霍雷上尉。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的約瑟夫‧霍雷上尉。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13666] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a ao Arcanista Taelis nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его чародею Таэлису в шатер Альянса на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Arkanist Taelis beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 잿빛나무 검을 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al arcanista Taelis en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al arcanista Taelis en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的奥术师泰利斯。‡取得灰木古劍，並帶給銀白聯賽場地的秘法師泰利斯。',
  }
},
[13667] = {
  {
    'O Torneio Argênteo‡Серебряный Турнир‡Das Argentumturnier‡은빛십자군 마상시합‡El Torneo Argenta‡El Torneo Argenta‡Le tournoi d\'Argent‡银色锦标赛‡銀白聯賽',
    nil,
    'Fale com o Arcanista Taelis nos Campos do Torneio Argênteo para se inscrever no torneio.‡Чтобы принять участие в турнире, поговорите с чародеем Таэлисом в шатре Альянса на Ристалище Серебряного турнира, он внесет ваше имя в списки.‡Sprecht mit Arkanist Taelis beim Argentumturnierplatz, um Euch für das Turnier anzumelden.‡은빛십자군 마상시합 광장에 있는 신비술사 탤리스와 대화하여 마상시합에 참여해야 합니다.‡Habla con el arcanista Taelis en los Campos del Torneo Argenta para inscribirte en el torneo.‡Habla con el arcanista Taelis en los Campos del Torneo Argenta para inscribirte en el torneo.‡Parlez à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent, pour vous inscrire au tournoi.‡与银色比武场的奥术师泰利斯谈一谈，报名参加锦标赛。‡與銀白聯賽場地的秘法師泰利斯交談，以參加聯賽。',
  }
},
[13668] = {
  {
    'O Torneio Argênteo‡Серебряный Турнир‡Das Argentumturnier‡은빛십자군 마상시합‡El Torneo Argenta‡El Torneo Argenta‡Le tournoi d\'Argent‡银色锦标赛‡銀白聯賽',
    nil,
    'Fale com o Magíster Edien Solinane nos Campos do Torneio Argênteo para se inscrever no torneio.‡Чтобы принять участие в турнире, поговорите с магистром Эдиеном Солнечной Низиной в шатре Орды на Ристалище Серебряного турнира, он внесет ваше имя в списки.‡Sprecht mit Magister Edien Sonnental beim Argentumturnierplatz, um Euch für das Turnier anzumelden.‡은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우와 대화하고 마상시합에 참여해야 합니다.‡Habla con el magister Edien Vacuosol en los Campos del Torneo Argenta para inscribirte en el torneo.‡Habla con el magister Edien Vacuosol en los Campos del Torneo Argenta para inscribirte en el torneo.‡Parlez au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent, pour vous inscrire au tournoi.‡与银色比武场的魔导师埃迪恩·炎谷谈一谈，报名参加锦标赛。‡與銀白聯賽場地的博學者艾狄恩·日谷交談，以參加聯賽。',
  }
},
[13669] = {
  {
    'Uma arma digna‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar ao Arcanista Taelis nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара чародею Таэлису в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt die Klinge von Drak\'Mar zu Arkanist Taelis beim Argentumturnierplatz.‡드락마의 검을 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 가져가야 합니다.‡Llévale la hoja de Drak\'Mar al arcanista Taelis en los Campos del Torneo Argenta.‡Llévale la hoja de Drak\'Mar al arcanista Taelis en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的的奥术师泰利斯。‡將德拉克瑪之刃帶給銀白聯賽場地的秘法師泰利斯。',
  }
},
[13670] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'O Arcanista Taelis, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Чародей Таэлис из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Arkanist Taelis beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 신비술사 탤리스가 겨울 칼날을 가져다 달라고 했습니다.‡El arcanista Taelis en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡El arcanista Taelis en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡L\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的奥术师泰利斯。‡銀白聯賽場地的秘法師泰利斯要你把凜冬之鋒帶給他。',
  }
},
[13671] = {
  {
    'Treinamento de campo‡Тренировка на поле боя‡Feldübung‡전장에서 단련하기‡Instrucción en el campo‡Instrucción en el campo‡Entraînement sur le terrain‡实战训练‡實地訓練',
    nil,
    'Avareth Ligérion, nos Campos do Torneio Argênteo, quer que você mate 8 membros do Flagelo da Coroa de Gelo. Você pode matar os membros do Flagelo em qualquer parte da Coroa de Gelo exceto no Bombardeio.‡Убейте 8 воинов Плети в Ледяной Короне по заданию Аварета Молниеносного Удара из Павильона Серебряного союза на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны, за исключением зоны бомбардировки.‡Avareth Flinkstoß beim Argentumturnierplatz möchte, dass Ihr 8 Diener der Geißel von Eiskrone tötet. Dazu zählen alle Diener der Geißel im Bereich von Eiskrone, abgesehen vom Bombardement.‡은빛십자군 마상시합 광장에 있는 아바레스 스위프트스트라이크가 얼음왕관 스컬지 8마리를 처치해 달라고 했습니다. 폭격지를 제외한 얼음왕관 전 지역에서 아무 스컬지나 처치하면 됩니다.‡Avareth Golpeveloz en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Avareth Golpeveloz en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Avareth Frappe-rapide, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 8 membres du Fléau de la Couronne de glace. Vous pouvez tuer des membres du Fléau partout dans la Couronne de glace, sauf au Bombardement.‡银色比武场的阿瓦雷斯·迅击要你在冰冠冰川地区消灭8名天灾军团士兵。除了轰炸场之外，在冰冠冰川的任何地方遇到的天灾都可以。‡銀白聯賽場地的阿凡瑞斯·迅擊要你殺死8個寒冰皇冠天譴軍。你可以殺死在轟炸地以外的任何天譴軍。',
  }
},
[13672] = {
  {
    'À altura do desafio‡Подготовка к испытанию‡Der Herausforderung gewachsen‡도전에 맞서라‡A la altura del desafío‡A la altura del desafío‡Prêt pour le défi‡迎接挑战‡準備挑戰',
    nil,
    'Apresente-se ao Arcanista Taelis nos Campos do Torneio Argênteo com 15 Selos do Aspirante para provar que está pronto para ser submetido ao desafio do aspirante.‡Чтобы продемонстрировать свою готовность пройти испытание претендентов, покажите 15 печатей претендента чародею Таэлису из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Überreicht Arkanist Taelis beim Argentumturnierplatz 15 Siegel des Streiters, um zu zeigen, dass Ihr bereit seid, Euch der Herausforderung des Streiter zu unterziehen.‡지원자의 도전에 응할 준비가 되었음을 증명하기 위해, 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 지원자의 문장 15개를 가져가야 합니다.‡Entrégale al arcanista Taelis en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Entrégale al arcanista Taelis en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Apportez à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent, 15 Sceaux d\'aspirant pour indiquer que vous souhaitez participer au Défi de l\'aspirant.‡将15枚候选者的徽记交给银色比武场的奥术师泰利斯，证明你已经准备好迎接候选者的挑战了。‡帶15個志士徽印給銀白聯賽的秘法師泰利斯，表示你準備好接受志士的挑戰。',
  }
},
[13673] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a ao Magíster Edien Solinane nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его магистру Эдиену Солнечной Низине в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Magister Edien Sonnental beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 잿빛나무 검을 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的魔导师埃迪恩·炎谷。‡取得灰木古劍，並帶給銀白聯賽場地的博學者艾狄恩·日谷。',
  }
},
[13674] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar ao Magíster Edien Solinane nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара магистру Эдиену Солнечной Низине в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt die Klinge von Drak\'Mar zu Magister Edien Sonnental beim Argentumturnierplatz.‡드락마의 검을 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 가져가야 합니다.‡Llévale la hoja de Drak\'Mar al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Llévale la hoja de Drak\'Mar al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的魔导师埃迪恩·炎谷。‡將德拉克瑪之刃帶給銀白聯賽場地的博學者艾狄恩·日谷。',
  }
},
[13675] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'O Magíster Edien Solinane, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Магистр Эдиен Солнечная Низина из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Magister Edien Sonnental beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 겨울 칼날을 가져가야 합니다.‡El magister Edien Vacuosol en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡El magister Edien Vacuosol en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡Le Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的魔导师埃迪恩·炎谷。‡銀白聯賽場地的博學者艾狄恩·日谷要你把凜冬之鋒帶給他。',
  }
},
[13676] = {
  {
    'Treinamento de campo‡Тренировка на поле боя‡Feldübung‡전장에서 단련하기‡Instrucción en el campo‡Instrucción en el campo‡Entraînement sur le terrain‡实战训练‡實地訓練',
    nil,
    'Amariel Jurassolar, nos Campos do Torneio Argênteo, quer que você mate 8 membros do Flagelo da Coroa de Gelo. Você pode matar os membros do Flagelo em qualquer parte da Coroa de Gelo, com exceção do Bombardeio.‡Убейте 8 воинов Плети в Ледяной Короне по заданию Амариэля Верного Солнцу из Павильона Похитителей Солнца на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны, за исключением зоны бомбардировки.‡Amariel Sonnenschwur beim Argentumturnierplatz möchte, dass Ihr 8 Diener der Geißel von Eiskrone tötet. Dazu zählen alle Diener der Geißel im Bereich von Eiskrone, abgesehen vom Bombardement.‡은빛십자군 마상시합 광장에 있는 아마리엘 선스원이 얼음왕관 스컬지 8마리를 처치해 달라고 했습니다. 폭격지를 제외한 얼음왕관 전 지역에서 아무 스컬지나 처치하면 됩니다.‡Amariel Jurasol en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Amariel Jurasol en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Amariel Ligesol, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 8 membres du Fléau de la Couronne de glace. Vous pouvez tuer des membres du Fléau partout dans la Couronne de glace, sauf au Bombardement.‡银色比武场的阿玛里尔·火盟要你在冰冠冰川地区消灭8名天灾军团士兵。除了轰炸场之外，在冰冠冰川的任何地方遇到的天灾都可以。‡銀白聯賽場地的艾瑪瑞爾·日誓要你殺死8個寒冰皇冠天譴軍。你可以殺死寒冰皇冠中除了轟炸地以外，任何地方的天譴軍。',
  }
},
[13677] = {
  {
    'Dominando as rédeas‡Большая тренировка‡Reitgrundlagen‡고삐 다루는 법 익히기‡Aprende a llevar las riendas‡Aprende a llevar las riendas‡Sachez tenir vos rênes‡学习骑战‡學習駕馭',
    nil,
    'Golpeie um Alvo Corpo a Corpo com Estocada 5 vezes, use Quebra-escudo em 2 Alvos à Distância vulneráveis, use Investida em 2 Alvos de Investida e depois fale novamente com Galátia Brilhalvo nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Отработайте прием "Выпад" 5 раз на манекене для ближнего боя, прием "Удар по щиту" 2 раза на мишени для дальнего боя и прием "Рывок" 2 раза на манекене для стремительной атаки, затем вернитесь к Галатии Сияющий Рассвет в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Trefft ein Nahkampfziel 5 Mal mit der Fähigkeit \'Zustoßen\' und wendet die Fähigkeit \'Schildbrecher\' auf 2 ungeschützte Distanzziele sowie die Fähigkeit \'Sturmangriff\' auf 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Galathia Morgenglanz beim Argentumturnierplatz zurück.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡근접 표적에 찌르기를 5번 사용하고, 약해진 원거리 표적 2개에 방패 부수기를 사용하고, 약해진 돌진 표적 2개에 돌진을 사용한 후 은빛십자군 마상시합 광장의 갈라시아 브라이트돈에게 가야 합니다.|n|n창을 잃어버리면 마구간 근처의 아무 창 선반이나 선리버 막사에서 다른 창을 얻을 수 있습니다.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Frappez 5 fois une Cible de mêlée avec un Coup de lance, utilisez 2 fois un Brise-bouclier sur des Cibles à distance vulnérables, utilisez 2 fois la Charge sur des Cibles de charge vulnérables, puis retournez voir Galathia Brillaube dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡使用刺击技能攻击一个近战目标5次，使用碎盾技能攻击2个脆弱的远程目标，使用冲锋技能攻击2个脆弱的冲锋目标，然后回到银色比武场，向加拉希亚·晨光复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡以戳刺擊中近戰標靶5次，對2個脆弱的遠程標靶使用破盾，對2個脆弱的衝鋒標靶使用衝鋒。然後回到銀白聯賽場地找加拉西雅·明曦。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13678] = {
  {
    'À altura do desafio‡Подготовка к испытанию‡Der Herausforderung gewachsen‡도전에 맞서라‡A la altura del desafío‡A la altura del desafío‡Prêt pour le défi‡迎接挑战‡準備挑戰',
    nil,
    'Apresente-se ao Magíster Edien Solinane, nos Campos do Torneio Argênteo, com 15 Selos do Aspirante para informar que está pronto para ser submetido ao desafio do aspirante.‡Чтобы продемонстрировать свою готовность пройти испытание претендентов, отдайте 15 печатей претендента магистру Эдиену Солнечной Низине из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Überreicht Magister Edien Sonnental beim Argentumturnierplatz 15 Siegel des Streiters, um zu zeigen, dass Ihr bereit seid, Euch der Herausforderung des Streiters zu unterziehen.‡지원자의 도전에 응할 준비가 되었음을 증명하기 위해, 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 지원자의 문장 15개를 가져가야 합니다.‡Entrégale al magister Edien Vacuosol en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Entrégale al magister Edien Vacuosol en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Apportez au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent, 15 Sceaux d\'aspirant pour indiquer que vous souhaitez participer au Défi de l\'aspirant.‡将15枚候选者的徽记交给银色比武场的魔导师埃迪恩·炎谷，证明你已经准备好迎接候选者的挑战了。‡帶15個志士徽印給銀白聯賽場地的博學者艾狄恩·日谷，表示你準備好接受志士的挑戰。',
  }
},
[13679] = {
  {
    'O desafio do aspirante‡Испытание претендента‡Die Herausforderung des Streiters‡지원자의 도전‡El desafío del aspirante‡El desafío del aspirante‡Le défi de l\'aspirant‡候选者的挑战‡志士的挑戰',
    nil,
    'Fale com o Escudeiro Davi para chamar o adversário. Após derrotar o Valente Argênteo, fale novamente com o Arcanista Taelis nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Поговорите с оруженосцем Давидом, чтобы вызвать на поединок вашего противника. Как только вы победите искателя славы Серебряного Авангарда, вернитесь к чародею Таэлису в шатер Альянса на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe David und ruft Euren Widersacher herbei. Kehrt zu Arkanist Taelist beim Argentumturnierplatz zurück, sobald Ihr den Argentumrecken besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 데이비드와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용맹전사를 물리친 다음 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Habla con el escudero David para llamar a tu oponente. Cuando hayas derrotado al Valeroso Argenta, regresa con el arcanista Taelis en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero David para llamar a tu oponente. Cuando hayas derrotado al Valeroso Argenta, regresa con el arcanista Taelis en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer David pour invoquer votre adversaire. Une fois le Vaillant d\'argent vaincu, retournez voir l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡和侍从大卫谈一谈，召唤你的对手。击败银色勇士之后回到银色比武场，向奥术师泰利斯复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡和侍從大衛交談以召喚你的對手。一旦你擊敗銀白驍士，回去銀白聯賽場地找秘法師泰利斯。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13680] = {
  {
    'O desafio do aspirante‡Испытание претендента‡Die Herausforderung des Streiters‡지원자의 도전‡El desafío del aspirante‡El desafío del aspirante‡Le défi de l\'aspirant‡候选者的挑战‡志士的挑戰',
    nil,
    'Fale com o Escudeiro Davi para chamar o adversário. Após derrotar o Valente Argênteo, fale novamente com o Magíster Edien Solinane nos Campos do Torneio Argênteo.‡Поговорите с оруженосцем Давидом, чтобы вызвать на поединок вашего противника. Как только вы победите искателя славы Серебряного Авангарда, вернитесь к магистру Эдиену Солнечной Низине в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Sprecht mit Knappe David und ruft Euren Widersacher herbei. Kehrt zu Magister Edien Sonnental beim Argentumturnierplatz zurück, sobald Ihr den Argentumrecken besiegt habt.‡종자 데이비드와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용맹전사를 물리친 다음 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 가야 합니다.‡Habla con el escudero David para invocar a tu oponente. Cuando hayas derrotado al valeroso Argenta, vuelve a hablar con el magister Edien Vacuosol en los Campos del Torneo Argenta.‡Habla con el escudero David para invocar a tu oponente. Cuando hayas derrotado al valeroso Argenta, vuelve a hablar con el magister Edien Vacuosol en los Campos del Torneo Argenta.‡Parlez à l\'Écuyer David pour invoquer votre adversaire. Une fois le Vaillant d\'argent vaincu, retournez voir le Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent.‡和侍从大卫谈一谈，召唤你的对手。击败银色勇士之后回到银色比武场，向魔导师埃迪恩·炎谷复命。‡和侍從大衛交談以召喚你的對手。一旦你擊敗銀白驍士，回去銀白聯賽場地找博學者艾狄恩·日谷。',
  }
},
[13681] = {
  {
    'Uma pedrinha não faz falta...‡Обломки стен Ульдуара‡Wie der Block so der Splitter‡이 돌덩어리는 어디에서 왔을까‡Un trozo del bloque de Ulduar‡Un trozo del bloque de Ulduar‡Un fragment du bloc d\'Ulduar‡奥杜尔的石块‡奧杜亞石塊的碎片',
    nil,
    'Leve 15 Pequenos Blocos de Pedra para Jogafora Estourapino nos Campos do Torneio Argênteo.‡Принесите 15 небольших камней Боззлу Рвизасову на Ристалище Серебряного турнира.‡Bringt 15 kleine Steinblöcke zu Stümpi Sprengbolz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 보즐 블라스트볼트에게 작은 돌덩어리 15개를 가져가야 합니다.‡Llévale 15 bloques de piedra pequeños a Bozzle Cargarrayo en los Campos del Torneo Argenta.‡Llévale 15 bloques de piedra pequeños a Bozzle Cargarrayo en los Campos del Torneo Argenta.‡Apportez 15 Petits blocs de pierre à Gaspu Boumboulon, dans l\'Enceinte du tournoi d\'Argent.‡将15块小石块交给银色比武场的波兹尔·布拉斯波。‡帶15個小型石塊堆給銀白聯賽場地的波索·爆栓。',
  }
},
[13682] = {
  {
    'A ameaça vem de cima‡Атака с воздуха‡Bedrohung von oben‡위로부터의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    'Eadric, o Puro, no Torneio Argênteo, quer que você derrote Gargagelo e 3 Bombardeiros Sectários.‡Эдрик Чистый из Серебряного павильона на Ристалище Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов-сектантов.‡Eadric der Reine beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡은빛십자군 마상시합 광장에 있는 성기사 에드릭이 서리아귀와 이교도 폭격수 3명을 처치해 달라고 했습니다.‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric le Pur, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡银色比武场的纯洁者耶德瑞克要你消灭3名诅咒教派投弹手，并击败冰喉。‡銀白聯賽的『純淨者』埃卓克要你擊敗寒冽之喉和3個教徒投彈手。',
  }
},
[13683] = {
  {
    'Interromper os rituais‡Прервать ритуалы‡Die Rituale aufhalten‡의식을 중지시켜라‡Detener los rituales‡Detener los rituales‡Arrêter les rituels‡阻止仪式‡阻止儀式',
    nil,
    'Desestabilize 8 Gemas Ritualísticas.‡Уничтожьте 8 ритуальных самоцветов.‡Stört 8 Ritualedelsteine.‡의식의 보석 8개를 방해해야 합니다.‡Interrumpe 8 gemas rituales.‡Interrumpe 8 gemas rituales.‡Dérangez 8 Gemmes de rituel.‡干扰8块仪式宝石。‡干擾8顆儀式寶石。',
  }
},
[13684] = {
  {
    'Um valente de Ventobravo‡Искатель славы из Штормграда‡Ein Recke von Sturmwind‡스톰윈드 용맹전사‡Un Valeroso de Ventormenta‡Un Valeroso de Ventormenta‡Un vaillant de Hurlevent‡暴风城的勇士‡暴風城驍士',
    nil,
    'Fale com o Marechal Jacob Alerius nos Campos do Torneio Argênteo para se tornar um valente de Ventobravo.‡Если вы хотите стать искателем славы Штормграда, поговорите с маршалом Якобом Алерием на Ристалище Серебряного турнира.‡Sprecht mit Marschall Jacob Alerius beim Argentumturnierplatz, um ein Recke von Sturmwind zu werden.‡스톰윈드 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스와 대화해야 합니다.‡Habla con el mariscal Jacob Alerius en los Campos del Torneo Argenta para convertirte en un Valeroso de Ventormenta.‡Habla con el mariscal Jacob Alerius en los Campos del Torneo Argenta para convertirte en un Valeroso de Ventormenta.‡Parlez au Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant de Hurlevent.‡与银色比武场的雅克布·奥勒留斯元帅谈一谈，成为暴风城的勇士。‡跟銀白聯賽場地的傑科布·亞雷瑞斯元帥談談，以成為一名暴風城驍士。',
  }
},
[13685] = {
  {
    '‡Искатель славы из Стальгорна‡Ein Recke von Eisenschmiede‡‡Un Valeroso de Forjaz‡Un Valeroso de Forjaz‡Un vaillant de Forgefer‡‡',
    nil,
    '‡Если вы хотите стать искателем славы Стальгорна, поговорите с Ланой Твердомолот в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Lana Starkhammer beim Argentumturnierplatz, um ein Recke von Eisenschmiede zu werden.‡‡Habla con Lana Martillotenaz en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Forjaz.‡Habla con Lana Martillotenaz en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Forjaz.‡Parlez à Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Forgefer.‡‡',
  }
},
[13686] = {
  {
    '‡‡Markierung für Allianzturniersqualifikation‡얼라이언스 마상시합 참가자격 표지‡Marcador de elegibilidad del torneo de la Alianza‡Marcador de elegibilidad del torneo de la Alianza‡Marqueur d\'éligibilité au tournoi de l\'Alliance‡‡',
    nil,
    nil,
  }
},
[13687] = {
  {
    '‡‡Markierung für Hordeturniersqualifikation‡호드 마상시합 참가자격 표지‡Marcador de elegibilidad del torneo de la Horda‡Marcador de elegibilidad del torneo de la Horda‡Marqueur d\'éligibilité au tournoi de la Horde‡‡',
    nil,
    nil,
  }
},
[13688] = {
  {
    '‡Искатель славы из Гномрегана‡Ein Recke von Gnomeregan‡‡Un Valeroso de Gnomeregan‡Un Valeroso de Gnomeregan‡Un vaillant de Gnomeregan‡‡',
    nil,
    '‡Если вы хотите стать искателем славы Гномрегана, поговорите с Амброзом Искрокрутом в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Ambrose Bolzenfunk beim Argentumturnierplatz, um ein Recke von Gnomeregan zu werden.‡‡Habla con Ambrose Chisparrayo en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Gnomeregan.‡Habla con Ambrose Chisparrayo en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Gnomeregan.‡Parlez à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Gnomeregan.‡‡',
  }
},
[13689] = {
  {
    '‡Искатель славы из Дарнаса‡Ein Recke von Darnassus‡다르나서스 용맹전사‡Un Valeroso de Darnassus‡Un Valeroso de Darnassus‡Un vaillant de Darnassus‡‡',
    nil,
    '‡Чтобы стать искателем славы Дарнаса, поговорите с Джейлин Закатной Песней в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Jaelyne Abendlied beim Argentumturnierplatz, um ein Recke von Darnassus zu werden.‡다르나서스 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 제일린 이븐송과 대화해야 합니다.‡Habla con Jaelyne Unicanto en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Darnassus.‡Habla con Jaelyne Unicanto en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Darnassus.‡Parlez à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Darnassus.‡‡',
  }
},
[13690] = {
  {
    'Um valente da Exodar‡Искатель славы из Экзодара‡Ein Recke der Exodar‡엑소다르 용맹전사‡Un Valeroso de El Exodar‡Un Valeroso de El Exodar‡Un vaillant de l\'Exodar‡埃索达的勇士‡艾克索達驍士',
    nil,
    'Fale com Colossos nos Campos do Torneio Argênteo para se tornar um valente da Exodar.‡Если вы хотите стать искателем славы Экзодара, поговорите с Колосусом на Ристалище Серебряного турнира.‡Sprecht mit Kolosos beim Argentumturnierplatz, um ein Recke der Exodar zu werden.‡엑소다르 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 콜로소스와 대화해야 합니다.‡Habla con Colosos en los Campos del Torneo Argenta para convertirte en un Valeroso de El Exodar.‡Habla con Colosos en los Campos del Torneo Argenta para convertirte en un Valeroso de El Exodar.‡Parlez à Colossos, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant de l\'Exodar.‡与银色比武场的克罗索斯谈一谈，成为埃索达的勇士。‡跟銀白聯賽場地的克羅索斯談談，以成為一名艾克索達驍士。',
  }
},
[13691] = {
  {
    'Um valente de Orgrimmar‡Искатель славы из Оргриммара‡Ein Recke von Orgrimmar‡오그리마 용맹전사‡Un Valeroso de Orgrimmar‡Un Valeroso de Orgrimmar‡Un vaillant d\'Orgrimmar‡奥格瑞玛的勇士‡奧格瑪驍士',
    nil,
    'Fale com Mokra, o Esmaga-crânios, nos Campos do Torneio Argênteo para se tornar um valente de Orgrimmar.‡Если вы хотите стать искателем славы Оргриммара, поговорите с Мокрой Дробителем Черепов на Ристалище Серебряного турнира.‡Sprecht mit Mokra dem Schädelberster beim Argentumturnierplatz, um ein Recke von Orgrimmar zu werden.‡오그리마 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라와 대화해야 합니다.‡Habla con Mokra el Trituracráneos en los Campos del Torneo Argenta para convertirte en un Valeroso de Orgrimmar.‡Habla con Mokra el Trituracráneos en los Campos del Torneo Argenta para convertirte en un Valeroso de Orgrimmar.‡Parlez à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant d\'Orgrimmar.‡与银色比武场的碎颅者莫克拉谈一谈，成为奥格瑞玛的勇士。‡跟銀白聯賽場地的『碎顱者』莫克拉談談，以成為一名奧格瑪驍士。',
  }
},
[13692] = {
  {
    'Espada ao mar‡Меч из моря‡Das Schwert und die See‡검과 바다‡La espada y el mar‡La espada y el mar‡L\'épée et la mer‡剑与海‡劍與海',
    nil,
    'O Velho Barlo, na Floresta do Canto Cristalino, quer que você lhe traga a Espada de Cavaleiro.‡Старина Барло из Леса Хрустальной Песни просит вас принести ему Меч Рыцарства.‡Der alte Barlo im Kristallsangwald möchte, dass Ihr ihm das Schwert der Ritterwürde bringt.‡수정노래 숲에 있는 노인 발로가 기사도의 검을 가져다 달라고 했습니다.‡El viejo Barlo en el Bosque Canto de Cristal quiere que le lleves la espada de caballería.‡El viejo Barlo en el Bosque Canto de Cristal quiere que le lleves la espada de caballería.‡Le Vieux Barlo, dans la Forêt du Chant de cristal, vous demande de lui apporter l’Épée de chevalerie.‡晶歌森林的老渔夫巴尔洛要你把骑士之剑交给他。‡水晶之歌森林的老人巴洛要你幫他找回騎士位階之劍。',
  }
},
[13693] = {
  {
    'Um valente de Sen\'Jin‡Искатель славы из Сен\'джина‡Ein Recke von Sen\'jin‡센진 용맹전사‡Un Valeroso de Sen\'jin‡Un Valeroso de Sen\'jin‡Un vaillant de Sen\'jin‡森金的勇士‡森金驍士',
    nil,
    'Fale com Zul\'tore nos Campos do Torneio Argênteo para se tornar um valente de Sen\'Jin.‡Если вы хотите стать искателем славы Сен\'джина, поговорите с Зул\'тором в Павильоне Похитителей Солнца на Ристалище Серебряного Турнира.‡Sprecht mit Zul\'tore beim Argentumturnierplatz, um ein Recke von Sen\'jin zu werden.‡센진 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 줄토어와 대화해야 합니다.‡Habla con Zul\'tore en los Campos del Torneo Argenta para convertirte en un Valeroso de Sen\'jin.‡Habla con Zul\'tore en los Campos del Torneo Argenta para convertirte en un Valeroso de Sen\'jin.‡Parlez à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant de Sen\'jin.‡与银色比武场的祖尔托谈一谈，成为森金的勇士。‡跟銀白聯賽場地的祖爾拓談談，以成為一名森金驍士。',
  }
},
[13694] = {
  {
    'Um valente do Penhasco do Trovão‡Искатель славы из Громового Утеса‡Ein Recke von Donnerfels‡썬더 블러프 용맹전사‡Un Valeroso de Cima del Trueno‡Un Valeroso de Cima del Trueno‡Un vaillant des Pitons-du-Tonnerre‡雷霆崖的勇士‡雷霆崖驍士',
    nil,
    'Fale com Runok Juba Agreste nos Campos do Torneio Argênteo para se tornar um valente do Penhasco do Trovão.‡Если вы хотите стать искателем славы Громового Утеса, поговорите с Руноком Буйногривым на Ристалище Серебряного турнира.‡Sprecht mit Runok Wildmähne beim Argentumturnierplatz, um ein Recke von Donnerfels zu werden.‡썬더 블러프 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 루노크 와일드메인과 대화해야 합니다.‡Habla con Runok Ferocrín en los Campos del Torneo Argenta para convertirte en un Valeroso de Cima del Trueno.‡Habla con Runok Ferocrín en los Campos del Torneo Argenta para convertirte en un Valeroso de Cima del Trueno.‡Parlez à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant des Pitons-du-Tonnerre.‡与银色比武场的鲁诺克·蛮鬃谈一谈，成为雷霆崖的勇士。‡跟銀白聯賽場地的魯諾克·蠻鬃談談，以成為一名雷霆崖驍士。',
  }
},
[13695] = {
  {
    'Um valente da Cidade Baixa‡Искатель славы из Подгорода‡Ein Recke von Unterstadt‡언더시티 용맹전사‡Un Valeroso de Entrañas‡Un Valeroso de Entrañas‡Un vaillant de Fossoyeuse‡幽暗城的勇士‡幽暗城驍士',
    nil,
    'Fale com o Sicário Viscerae nos Campos do Torneio Argênteo para se tornar um valente da Cidade Baixa.‡Если вы хотите стать искателем славы Подгорода, поговорите со стражем смерти Визери на Ристалище Серебряного турнира.‡Sprecht mit Todespirscher Visceri beim Argentumturnierplatz, um ein Recke von Unterstadt zu werden.‡언더시티 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 죽음추적자 비세리와 대화해야 합니다.‡Habla con el mortacechador Visceri en los Campos del Torneo Argenta para convertirte en un Valeroso de Entrañas.‡Habla con el mortacechador Visceri en los Campos del Torneo Argenta para convertirte en un Valeroso de Entrañas.‡Parlez au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant de Fossoyeuse.‡与银色比武场的死亡猎手维赛里谈一谈，成为幽暗城的勇士。‡跟銀白聯賽場地的亡靈哨兵威瑟瑞談談，以成為一名幽暗城驍士。',
  }
},
[13696] = {
  {
    'Um valente de Luaprata‡Искатель славы из Луносвета‡Ein Recke von Silbermond‡실버문 용맹전사‡Un Valeroso de Lunargenta‡Un Valeroso de Lunargenta‡Un vaillant de Lune-d\'argent‡银月城的勇士‡銀月城驍士',
    nil,
    'Fale com Erasséa Cantalva nos Campos do Torneio Argênteo para se tornar um valente de Luaprata.‡Если вы хотите стать искателем славы Луносвета, поговорите с Эрессеей Певицей Рассвета на Ристалище Серебряного турнира.‡Sprecht mit Eressea Morgensänger beim Argentumturnierplatz, um ein Recke von Silbermond zu werden.‡실버문 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 에레시아 돈싱어와 대화해야 합니다.‡Habla con Eressea Cantoalba en los Campos del Torneo Argenta para convertirte en un Valeroso de Lunargenta.‡Habla con Eressea Cantoalba en los Campos del Torneo Argenta para convertirte en un Valeroso de Lunargenta.‡Parlez à Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent, pour devenir un vaillant de Lune-d\'argent.‡与银色比武场的埃蕾希·晨歌谈一谈，成为银月城的勇士。‡跟銀白聯賽場地的艾瑞西雅·曦詠談談，以成為一名銀月城驍士。',
  }
},
[13697] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Mokra, o Esmaga-crânios, nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Мокре Дробителю Черепов в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Mokra dem Schädelberster beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的碎颅者莫克拉。‡帶25個驍士徽印給銀白聯賽場地的『碎顱者』莫克拉。',
  }
},
[13698] = {
  {
    'O retalhador é nosso!‡Взрывчатые материалы на борту‡Sprengstoffschreddern‡폭발물 제거‡Explosivos que trituran‡Explosivos que trituran‡C’est de la bombe !‡粉碎炸药‡伐爆機',
    nil,
    'Use um Retalhador do Brado Guerreiro para destruir 8 Barris de Pólvora.‡Уничтожьте 8 бочонков со взрывчаткой с помощью крошшера клана Песни Войны.‡Verwendet einen Kriegshymnenschredder um 8 Fässer mit Sprengstoff zu vernichten.‡전쟁노래 벌목기를 이용해 호드 폭발물 8개를 파괴해야 합니다.‡Utiliza una trituradora Grito de Guerra para destruir 8 barriles de explosivos.‡Utiliza una trituradora Grito de Guerra para destruir 8 barriles de explosivos.‡Utilisez un Déchiqueteur chanteguerre pour détruire 8 Tonneaux d’explosifs.‡使用战歌伐木机摧毁8桶炸药。‡使用戰歌伐木機摧毀8個炸藥桶。',
  }
},
[13699] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com o Marechal Jacob Alerius nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к маршалу Якобу Алерию на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Marschall Jacob Alerius beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 은빛 서약단 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con el mariscal Jacob Alerius en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con el mariscal Jacob Alerius en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir le Maréchal Jacob Alerius dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向雅克布·奥勒留斯元帅复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找傑科布‧亞雷瑞斯元帥。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13700] = {
  {
    '‡‡Markierung für Champion der Allianz‡얼라이언스 용사 표지‡Marcador de Campeón de la Alianza‡Marcador de Campeón de la Alianza‡Marqueur de champion de l\'Alliance‡‡',
    nil,
    nil,
  }
},
[13701] = {
  {
    '‡‡Markierung für Champion der Horde‡호드의 용사 표지‡Marcador de Campeón de la Horda‡Marcador de Campeón de la Horda‡Marqueur de champion de la Horde‡‡',
    nil,
    nil,
  }
},
[13702] = {
  {
    'Surge um campeão‡Рождение героя‡Aufstieg eines Champions‡용사 등극‡Se alza un Campeón‡Se alza un Campeón‡La naissance d\'un champion‡冠军诞生‡一位勇士的出現',
    nil,
    'Fale com a Justicar Mariel Veras nos Campos do Torneio Argênteo.‡Поговорите с вершительницей правосудия Мариэль Чистосердечной на Ристалище Серебряного турнира.‡Sprecht mit Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트와 대화해야 합니다.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Parlez à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的裁决者玛蕾尔·图哈特谈一谈。‡跟銀白聯賽場地的審判者瑪瑞爾·真心談談。',
  }
},
[13703] = {
  {
    'Valente de Altaforja‡Искатель славы из Стальгорна‡Recke von Eisenschmiede‡아이언포지 용맹전사‡Valeroso de Forjaz‡Valeroso de Forjaz‡Vaillant de Forgefer‡铁炉堡的勇士‡鐵爐堡驍士',
    nil,
    'Fale com Lana Fortemalho novamente se desejar se tornar um valente de Altaforja.‡Если вы хотите стать искателем славы Стальгорна, поговорите еще раз с Ланой Твердомолот в Павильоне Серебряного Союза.‡Sprecht wieder mit Lana Starkhammer, falls Ihr ein Recke von Eisenschmiede werden wollt.‡라나 스타우트해머와 다시 대화하면 아이언포지 용맹전사가 될 수 있습니다.‡Habla de nuevo con Lana Martillotenaz si quieres convertirte en Valeroso de Forjaz.‡Habla de nuevo con Lana Martillotenaz si quieres convertirte en Valeroso de Forjaz.‡Parlez à nouveau à Lana Rudemartel si vous voulez devenir un vaillant de Forgefer.‡如果你想要成为铁炉堡的勇士，就再找兰娜·硬锤谈一谈。‡如果你想成為一位鐵爐堡驍士，再去和菈娜·頑錘談談。',
  }
},
[13704] = {
  {
    'Valente de Gnomeregan‡Искатель славы из Гномрегана‡Recke von Gnomeregan‡놈리건 용맹전사‡Valeroso de Gnomeregan‡Valeroso de Gnomeregan‡Vaillant de Gnomeregan‡诺莫瑞根的勇士‡諾姆瑞根驍士',
    nil,
    'Fale com Ambrósio Chisparafuso novamente se desejar se tornar um valente de Gnomeregan.‡Если вы хотите стать искателем славы Гномрегана, поговорите еще раз с Амброзом Искрокрутом в Павильоне Серебряного Союза.‡Sprecht wieder mit Ambrose Bolzenfunk, falls Ihr ein Recke von Gnomeregan werden wollt.‡암브로스 볼트스파크와 다시 대화하면 놈리건 용맹전사가 될 수 있습니다.‡Habla de nuevo con Ambrose Chisparrayo si quieres convertirte en Valeroso de Gnomeregan.‡Habla de nuevo con Ambrose Chisparrayo si quieres convertirte en Valeroso de Gnomeregan.‡Parlez à nouveau à Ambrose Étinceboulon si vous voulez devenir un vaillant de Gnomeregan.‡如果你想要成为诺莫瑞根的勇士，就再找阿姆布罗斯·电光谈一谈。‡如果你想成為一位諾姆瑞根驍士，再去和安布羅斯·拴炫談談。',
  }
},
[13705] = {
  {
    'Valente da Exodar‡Искатель славы из Экзодара‡Recke der Exodar‡엑소다르 용맹전사‡Valeroso de El Exodar‡Valeroso de El Exodar‡Vaillant de l\'Exodar‡埃索达的勇士‡艾克索達驍士',
    nil,
    'Fale com Colossos novamente se desejar se tornar um valente da Exodar.‡Если вы хотите стать искателем славы Экзодара, поговорите еще раз с Колосусом в Павильоне Серебряного Союза.‡Sprecht wieder mit Kolosos, falls Ihr ein Recke der Exodar werden wollt.‡엑소다르 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 콜로소스와 대화해야 합니다.‡Habla con Colosos de nuevo si deseas convertirte en Valerosa de El Exodar.‡Habla con Colosos de nuevo si deseas convertirte en Valeroso de El Exodar.‡Parlez à nouveau à Colossos si vous voulez devenir un vaillant de l\'Exodar.‡如果你想要成为埃索达的勇士，就再找科鲁索斯谈一谈。‡如果你想成為一位艾克索達驍士，再去和克羅索斯談談。',
  }
},
[13706] = {
  {
    'Valente de Darnassus‡Искатель славы из Дарнаса‡Recke von Darnassus‡다르나서스 용맹전사‡Valeroso de Darnassus‡Valeroso de Darnassus‡Vaillant de Darnassus‡达纳苏斯的勇士‡達納蘇斯驍士',
    nil,
    'Fale com Jaeline Ortocanto novamente se desejar tornar-se um valente de Darnassus.‡Если вы хотите стать искателем славы Дарнаса, поговорите еще раз с Джейлин Закатной Песней.‡Sprecht wieder mit Jaelyne Abendlied, falls Ihr ein Recke von Darnassus werden wollt.‡제일린 이븐송과 다시 대화하면 다르나서스 용맹전사가 될 수 있습니다.‡Habla de nuevo con Jaelyne Unicanto si quieres convertirte en Valeroso de Darnassus.‡Habla de nuevo con Jaelyne Unicanto si quieres convertirte en Valeroso de Darnassus.‡Parlez à nouveau à Jaelyne Chant-du-soir si vous voulez devenir un vaillant de Darnassus.‡如果你想要成为达纳苏斯的勇士，就再找亚琳·永歌谈一谈。‡如果你想成為一位達納蘇斯驍士，再去和潔琳·晚歌談談。',
  }
},
[13707] = {
  {
    'Valente de Orgrimmar‡Искатель славы из Оргриммара‡Recke von Orgrimmar‡오그리마 용맹전사‡Valeroso de Orgrimmar‡Valeroso de Orgrimmar‡Vaillant d\'Orgrimmar‡奥格瑞玛的勇士‡奧格瑪驍士',
    nil,
    'Fale com Mokra, o Esmaga-crânios, novamente se desejar se tornar um valente de Orgrimmar.‡Если вы хотите стать искателем славы Оргриммара, поговорите еще раз с Мокрой Дробителем Черепов в Павильоне Похитителей Солнца.‡Sprecht wieder mit Mokra dem Schädelberster, falls Ihr ein Recke von Orgrimmar werden wollt.‡오그리마 용맹전사가 되고 싶으면 해골분쇄자 모크라와 다시 대화해야 합니다.‡Habla de nuevo con Mokra el Trituracráneos si quieres convertirte en Valeroso de Orgrimmar.‡Habla de nuevo con Mokra el Trituracráneos si quieres convertirte en Valeroso de Orgrimmar.‡Parlez à nouveau à Mokra le Brise-tête si vous voulez devenir un vaillant d\'Orgrimmar.‡如果你想要成为奥格瑞玛的勇士，就再找碎颅者莫克拉谈一谈。‡如果你想成為一位奧格瑪驍士，再去和『碎顱者』莫克拉談談。',
  }
},
[13708] = {
  {
    'Valente de Sen\'jin‡Искатель славы из Сен\'джина‡Recke von Sen\'jin‡센진 용맹전사‡Valeroso de Sen\'jin‡Valeroso de Sen\'jin‡Vaillant de Sen\'jin‡森金的勇士‡森金驍士',
    nil,
    'Fale com Zul\'tore novamente se desejar se tornar um valente de Sen\'jin.‡Если вы хотите стать искателем славы Сен\'джина, поговорите еще раз с Зул\'тором в Павильоне Похитителей Солнца.‡Sprecht wieder mit Zul\'tore, falls Ihr ein Recke von Sen\'jin werden wollt.‡센진 용맹전사가 되고 싶으면 줄토어와 다시 대화해야 합니다.‡Habla de nuevo con Zul\'tore si deseas convertirte en un Valeroso de Sen\'jin.‡Habla de nuevo con Zul\'tore si deseas convertirte en un Valeroso de Sen\'jin.‡Parlez à nouveau à Zul\'tore si vous voulez devenir un vaillant de Sen\'jin.‡如果你想要成为森金的勇士，就再找祖尔托谈一谈。‡如果你想成為一位森金驍士，再去和祖爾拓談談。',
  }
},
[13709] = {
  {
    'Valente do Penhasco do Trovão‡Искатель славы из Громового Утеса‡Recke von Donnerfels‡썬더 블러프 용맹전사‡Valeroso de Cima del Trueno‡Valeroso de Cima del Trueno‡Vaillant des Pitons-du-Tonnerre‡雷霆崖的勇士‡雷霆崖驍士',
    nil,
    'Fale com Runok Juba Agreste novamente se desejar se tornar um valente do Penhasco do Trovão.‡Если вы хотите стать искателем славы Громового Утеса, поговорите еще раз с Руноком Буйногривым в Павильоне Похитителей Солнца.‡Sprecht wieder mit Runok Wildmähne, falls Ihr ein Recke von Donnerfels werden wollt.‡썬더 블러프 용맹전사가 되고 싶으면 루노크 와일드메인과 다시 대화해야 합니다.‡Habla de nuevo con Runok Ferocrín si quieres convertirte en Valeroso de Cima del Trueno.‡Habla de nuevo con Runok Ferocrín si quieres convertirte en Valeroso de Cima del Trueno.‡Parlez à nouveau à Runok Crin-sauvage si vous voulez devenir un vaillant des Pitons-du-Tonnerre.‡如果你想要成为雷霆崖的勇士，就再找鲁诺克·蛮鬃谈一谈。‡如果你想成為一位雷霆崖驍士，再去和魯諾克·蠻鬃談談。',
  }
},
[13710] = {
  {
    'Valente da Cidade Baixa‡Искатель славы из Подгорода‡Recke von Unterstadt‡언더시티 용맹전사‡Valeroso de Entrañas‡Valeroso de Entrañas‡Vaillant de Fossoyeuse‡幽暗城的勇士‡幽暗城驍士',
    nil,
    'Fale com o Sicário Viscerae novamente se desejar se tornar um valente da Cidade Baixa.‡Если вы хотите стать искателем славы Подгорода, поговорите еще раз со стражем смерти Визери в Павильоне Похитителей Солнца.‡Sprecht wieder mit Todespirscher Visceri, falls Ihr ein Recke von Unterstadt werden wollt.‡언더시티 용맹전사가 되려면 죽음추적자 비세리와 대화해야 합니다.‡Habla de nuevo con el mortacechador Visceri si deseas convertirte en Valeroso de Entrañas.‡Habla de nuevo con el mortacechador Visceri si deseas convertirte en Valeroso de Entrañas.‡Parlez à nouveau au Nécrotraqueur Viscéri si vous voulez devenir un vaillant de Fossoyeuse.‡如果你想要成为幽暗城的勇士，就再找死亡猎手维瑟里谈一谈。‡如果你想成為一位幽暗城驍士，再去和亡靈哨兵威瑟瑞談談。',
  }
},
[13711] = {
  {
    'Valente de Luaprata‡Искатель славы из Луносвета‡Recke von Silbermond‡실버문 용맹전사‡Valeroso de Lunargenta‡Valeroso de Lunargenta‡Vaillant de Lune-d\'argent‡银月城的勇士‡銀月城驍士',
    nil,
    'Fale com Erasséa Cantalva novamente se desejar se tornar um valente de Luaprata.‡Если вы хотите стать искателем славы Луносвета, поговорите еще раз с Эрессеей Певицей Рассвета в Павильоне Похитителей Солнца.‡Sprecht wieder mit Eressea Morgensänger, falls Ihr ein Recke von Silbermond werden wollt.‡실버문 용맹전사가 되려면 에레시아 돈싱어와 대화해야 합니다.‡Habla de nuevo con Eressea Cantoalba si quieres convertirte en Valeroso de Lunargenta.‡Habla de nuevo con Eressea Cantoalba si quieres convertirte en Valeroso de Lunargenta.‡Parlez à nouveau à Eressea Chantelaube si vous voulez devenir un vaillant de Lune-d\'argent.‡如果你想要成为银月城的勇士，就再找伊蕾希亚·晨歌谈一谈。‡如果你想成為一位銀月城驍士，再去和艾瑞西雅·曦詠談談。',
  }
},
[13712] = {
  {
    'Ao resgate!‡Путь к спасению‡Rettung in der Not‡구출 작전!‡¡Al rescate!‡¡Al rescate!‡Prêter main-forte‡雷霆救兵！‡進行救援!',
    nil,
    'Fale novamente com Kadrak, na Paliçada Mor\'shan, para acompanhá-lo até o Posto Machadada.‡Поговорите с Кадраком на заставе Мор\'шан и сопроводите его к Заставе Расщепленного Дерева.‡Sprecht mit Kadrak am Schutzwall von Mor\'shan und begleitet ihn zum Splitterholzposten.‡몰샨의 망루에 있는 카드라크와 대화해 토막나무 주둔지로 함께 가야 합니다.‡Habla con Kadrak en la Empalizada de Mor\'shan y acompáñale hasta el Puesto del Hachazo.‡Habla con Kadrak en la Empalizada de Mor\'shan y acompáñale hasta el Puesto del Hachazo.‡Parlez à Kadrak au Rempart de Mor\'shan et accompagnez-le au Poste de Bois-Brisé.‡跟莫尔杉农场的卡德拉克谈一谈，陪伴他前往碎木岗哨。‡到莫爾杉壁壘與卡德拉克交談，並陪著他去碎木崗哨。',
  }
},
[13713] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Lana Fortemalho nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Лане Твердомолот в шатер Альянса на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Lana Starkhammer beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 라나 스타우트해머에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 은빛 서약단 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Lana Martillotenaz en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Lana Martillotenaz en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Lana Rudemartel dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向兰娜·硬锤复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找菈娜‧頑錘。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13714] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Lana Fortemalho nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Лане Твердомолот в Павильон Серебряного союза на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Lana Starkhammer beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 라나 스타우트해머에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Lana Martillotenaz en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Lana Martillotenaz en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的兰娜·硬锤。‡帶25個驍士徽印給銀白聯賽場地的菈娜‧頑錘。',
  }
},
[13715] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Ambrósio Chisparafuso nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Амброзу Искрокруту в шатер Альянса на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Ambrose Bolzenfunk beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的安布罗斯·雷钉。‡帶25個驍士徽印給銀白聯賽場地的安布羅斯‧拴炫。',
  }
},
[13716] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Colossos nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Колосусу в шатер Альянса на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Kolosos beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 콜로소스에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Colosos en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Colosos en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Colossos, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的科鲁索斯。‡帶25個驍士徽印給銀白聯賽場地的克羅索斯。',
  }
},
[13717] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Jaeline Ortocanto nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Джейлин Закатной Песне в шатер Альянса на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Jaelyne Abendlied beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 제일린 이븐송에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的亚琳·永歌。‡帶25個驍士徽印給銀白聯賽場地的潔琳‧晚歌。',
  }
},
[13718] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente ao Marechal Jacob Alerius nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы маршалу Якобу Алерию в шатер Альянса на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Marschall Jacob Alerius beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant au Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的雅克布·奥勒留斯元帅。‡帶25個驍士徽印給銀白聯賽場地的傑科布‧亞雷瑞斯元帥。',
  }
},
[13719] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Zul\'tore nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Зул\'тору в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt 25 Siegel des Recken zu Zul\'tore beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 줄토어에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Zul\'tore en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Zul\'tore en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的祖尔托。‡帶25個驍士徽印給銀白聯賽場地的祖爾拓。',
  }
},
[13720] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Runok Juba Agreste nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Руноку Буйногривому в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Runok Wildmähne beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 루노크 와일드메인에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Runok Ferocrín en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Runok Ferocrín en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的鲁诺克·蛮鬃。‡帶25個驍士徽印給銀白聯賽場地的魯諾克·蠻鬃。',
  }
},
[13721] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente ao Sicário Viscerae nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы стражу смерти Визери в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Todespirscher Visceri beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 죽음추적자 비세리에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso al mortacechador Visceri en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso al mortacechador Visceri en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的死亡猎手维瑟里。‡帶25個驍士徽印給銀白聯賽場地的亡靈哨兵威瑟瑞。',
  }
},
[13722] = {
  {
    'A investida do valente‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    'Leve 25 Selos do Valente a Erasséa Cantalva nos Campos do Torneio Argênteo.‡Принесите 25 печатей искателя славы Эрессее Певице Рассвета в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Eressea Morgensänger beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 에레시아 돈싱어에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Eressea Cantoalba en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Eressea Cantoalba en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的伊蕾希亚·晨歌。‡帶25個驍士徽印給銀白聯賽場地的艾瑞西雅·曦詠。',
  }
},
[13723] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com o Escudeiro Daniel nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Амброзу Искрокруту в шатер Альянса на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Ambrose Bolzenfunk beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 처치한 다음, 은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 은빛 서약단 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Ambrose Chisparrayo en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Ambrose Chisparrayo en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Ambrose Étinceboulon dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向安布罗斯·雷钉复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找安布羅斯‧拴炫。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13724] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Colossos nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Колосусу в шатер Альянса на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Kolosos beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 콜로소스에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 은빛 서약단 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Colosos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Colosos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Colossos dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向科鲁索斯复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找克羅索斯。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13725] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Jaeline Ortocanto nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Джейлин Закатной Песне в шатер Альянса на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Jaelyne Abendlied beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 제일린 이븐송에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 은빛 서약단 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Jaelyne Unicanto en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Jaelyne Unicanto en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Jaelyne Chant-du-soir dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向亚琳·永歌复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找潔琳‧晚歌。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13726] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Mokra, o Esmaga-crânios, nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Мокре Дробителю Черепов в шатер Орды на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Mokra dem Schädelberster beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 선리버 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Mokra el Trituracráneos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Mokra el Trituracráneos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Mokra le Brise-tête dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向碎颅者莫克拉复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找『碎顱者』莫克拉。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13727] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Zul\'tore nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Зул\'тору в шатер Орды на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Zul\'tore beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 줄토어에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 선리버 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Zul\'tore en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Zul\'tore en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Zul\'tore dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向祖尔托复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找祖爾拓。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13728] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Runok Juba Agreste nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Руноку Буйногривому в шатер Орды на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Runok Wildmähne beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 루노크 와일드메인에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 선리버 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Runok Ferocrín en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Runok Ferocrín en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Runok Crin-sauvage dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向鲁诺克·蛮鬃复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找魯諾克·蠻鬃。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13729] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com o Sicário Viscerae nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к стражу смерти Визери в шатер Орды на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Todespirscher Visceri beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 죽음추적자 비세리에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 선리버 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con el mortacechador Visceri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con el mortacechador Visceri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir le Nécrotraqueur Viscéri dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向死亡猎手维瑟里复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找亡靈哨兵威瑟瑞。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13730] = {
  {
    'Brincando com fogovil‡Игры с огнем Скверны‡Spiel mit dem Teufelsfeuer‡악령불 장난‡Jugando con fuego vil‡Jugando con fuego vil‡Jouer avec le gangrefeu‡邪火烧身‡玩弄惡魔烈焰',
    nil,
    'Draaka, no Posto Machadada, quer que você encha o Recipiente Reforçado com 7 porções de Fogovil no Monte Fogovil.‡Драака с Заставы Расщепленного Дерева просит вас заполнить усиленную канистру, поместив в нее 7 огней скверны с холма Демонического Огня.‡Draaka im Splitterholzposten möchte, dass Ihr den verstärkten Kanister mit 7 Teufelsfeuern vom Dämonenhügel füllt.‡토막나무 주둔지에 있는 드라카가 강화된 통에 악령불 언덕에서 악령불 7개를 담아와 달라고 했습니다.‡Draaka del Hachazo quiere que llenes el bote reforzado con 7 fuegos viles de Cerro Lumbrevil.‡Draaka del Hachazo quiere que llenes el bote reforzado con 7 fuegos viles de Cerro Lumbrevil.‡Draaka, à Bois-Brisé, vous demande de remplir la Boîte renforcée de 7 Gangrefeux de la Colline Gangrefeu.‡碎木岗哨的德娜卡要你去冥火岭用7团魔火装满加强型采集罐。‡碎木崗哨的德拉卡要你去冥火嶺，並將強化油罐裝滿7個惡魔烈焰。',
  }
},
[13731] = {
  {
    'O desafio do valente‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    'Fale com o Escudeiro Daniel para chamar o adversário. Após derrotar o Campeão Argênteo, fale novamente com Erasséa Cantalva nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к Эрессее Певице Рассвета в шатер Орды на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Eressea Morgensänger beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der angebundenen Nähe der Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 에레시아 돈싱어에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 선리버 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Eressea Cantoalba en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con Eressea Cantoalba en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir Eressea Chantelaube dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡与侍从丹尼谈一谈，他会为你安排对手。击败银色冠军之后，回到银色比武场，向伊蕾希亚·晨歌复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡和侍從丹尼談談以召喚你的對手。一旦你擊敗銀白勇士，回到銀白聯賽場地去找艾瑞西雅·曦詠。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13732] = {
  {
    'Surge um campeão‡Рождение героя‡Aufstieg eines Champions‡용사 등극‡Se alza un Campeón‡Se alza un Campeón‡La naissance d\'un champion‡冠军诞生‡一位勇士的出現',
    nil,
    'Fale com a Justicar Mariel Veras nos Campos do Torneio Argênteo.‡Поговорите с вершительницей правосудия Мариэль Чистосердечной на Ристалище Серебряного турнира.‡Sprecht mit Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트와 대화해야 합니다.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Parlez à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的裁决者玛蕾尔·图哈特谈一谈。‡跟銀白聯賽場地的審判者瑪瑞爾·真心談談。',
  }
},
[13733] = {
  {
