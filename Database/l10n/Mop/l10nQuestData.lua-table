[11107] = {
  {
    'Curve-se ante o Grão-lorde‡Склонитесь перед верховным господином‡Verneigt Euch vor dem Hochlord‡군주에게 경의를‡Inclínate ante el Alto Señor‡Inclínate ante el Alto Señor‡À genoux devant le généralissime !‡莫格霍尔大王‡向大領主鞠躬',
    nil,
    'Fale com o Suserano Mor\'ghor, do Campo-base Presa do Dragão no Vale da Lua Negra.‡Поговорите с властителем Мор\'гором в лагере Драконьей Пасти в долине Призрачной Луны.‡Sprecht mit Oberanführer Mor\'ghor beim Basislager des Drachenmals im Schattenmondtal.‡어둠달 골짜기 용아귀 주둔지에 있는 대군주 모르고르와 대화해야 합니다.‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.|n‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.|n‡Parlez au Suzerain Mor\'ghor au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡与影月谷龙喉营地的莫格霍尔大王谈一谈。‡到影月谷的龍喉營地和霸主莫格談談。',
  }
},
[11108] = {
  {
    'Lorde Illidan Tempesfúria‡Владыка Иллидан Ярость Бури‡Fürst Illidan Sturmgrimm‡군주 일리단 스톰레이지‡Lord Illidan Tempestira‡Lord Illidan Tempestira‡Le seigneur Illidan Hurlorage‡伊利丹·怒风大人‡伊利丹·怒風',
    nil,
    'Encontre-se com Illidan Tempesfúria. Procure Barthamus no Bairro Inferior de Shattrath caso você sobreviva.‡Встретьтесь с Иллиданом Яростью Бури. Найдите Бартамуса в Нижнем городе Шаттрата, если останетесь в живых.‡Trefft Euch mit Illidan Sturmgrimm. Solltet Ihr überleben, sucht Barthamus im Unteren Viertel von Shattrath auf.‡일리단 스톰레이지를 만나야 합니다. 살아남는다면 샤트라스, 고난의 거리에 있는 바르타무스를 찾아가야 합니다.‡Ve al encuentro de Illidan Tempestira. Si vives para contarlo, busca a Barthamus en el Bajo Arrabal de Shattrath.‡Ve al encuentro de Illidan Tempestira. Si vives para contarlo, busca a Barthamus en el Bajo Arrabal de Shattrath.‡Rencontrez Illidan Hurlorage. Si jamais vous survivez, allez trouver Barthamus dans la Ville basse de Shattrath.‡与伊利丹·怒风会面。如果你有幸活下来，就前往沙塔斯城的贫民窟寻找巴萨姆斯。‡會見伊利丹·怒風。如果你僥倖存活的話，去撒塔斯的陰鬱城找巴薩姆斯。',
  }
},
[11109] = {
  {
    'Jorus, o Draco Asa Etérea Cobalto‡Кобальтовый дракон Пустоты Хорус‡Jorus, der kobaltblaue Drache der Netherschwingen‡조러스, 푸른빛 황천날개 비룡‡Jorus el draco Ala Abisal cobalto‡Jorus el draco Ala Abisal cobalto‡Jorus le drake de l\'Aile-du-Néant cobalt‡约鲁斯，蓝色灵翼幼龙‡深藍色虛空之翼龍喬瑞斯',
    nil,
    nil,
  }
},
[11110] = {
  {
    'Malfas, o Draco Asa Etérea Roxo‡Лиловый дракон Пустоты Малфас‡Malfas, der lila Drache der Netherschwingen‡말퍼스, 보랏빛 황천날개 비룡‡Malfas el draco Ala Abisal morado‡Malfas el draco Ala Abisal morado‡Malfas le drake de l\'Aile-du-Néant violet‡玛尔法斯，紫色灵翼幼龙‡紫色虛空之翼龍莫法斯',
    nil,
    nil,
  }
},
[11111] = {
  {
    'Onyxien, o Draco Asa Etérea Ônix‡Ониксовый дракон Пустоты Ониксиен‡Onyxien, der onyxfarbene Drache der Netherschwingen‡오닉시엔, 칠흑의 황천날개 비룡‡Onyxien el draco Ala Abisal de ónice‡Onyxien el draco Ala Abisal de ónice‡Onyxian le drake de l\'Aile-du-Néant onyx‡奥尼克森，黑色灵翼幼龙‡黑瑪瑙色虛空之翼龍奧尼克希安',
    nil,
    nil,
  }
},
[11112] = {
  {
    'Surako, o Draco Asa Etérea Lazúli‡Лазурный дракон Пустоты Сураку‡Suraku, der azurblaue Drache der Netherschwingen‡슈라쿠, 하늘빛 황천날개 비룡‡Suraku el draco Ala Abisal azur‡Suraku el draco Ala Abisal azur‡Suraku le drake de l\'Aile-du-Néant azur‡‡藍色虛空之翼龍蘇拉庫',
    nil,
    nil,
  }
},
[11113] = {
  {
    'Voranako, o Draco Asa Etérea Violáceo‡Пурпурный дракон Пустоты Воранаку‡Voranaku, der violette Drache der Netherschwingen‡보라나쿠, 자줏빛 황천날개 비룡‡Voranaku, el draco Ala Abisal violeta‡Voranaku, el draco Ala Abisal violeta‡Voranaku le drake de l\'Aile-du-Néant pourpre‡沃兰纳库，红色灵翼幼龙‡紫紅色虛空之翼龍弗拉納庫',
    nil,
    nil,
  }
},
[11114] = {
  {
    'Zoya, o Draco Asa Etérea Viridiano‡Зои, изумрудный дракон Пустоты‡Zoya, der viridiangrüne Drache der Netherschwingen‡조야, 초록빛 황천날개 비룡‡Zoya, el draco Ala Abisal veridiana‡Zoya, el draco Ala Abisal veridiana‡Zoya le drake de l\'Aile-du-Néant viride‡‡翠綠色虛空之翼龍佐亞',
    nil,
    nil,
  }
},
[11115] = {
  {
    '‡Метка Вайш (ТОЛЬКО ФЛАГ)‡Das Mal von Vashj‡바쉬의 증표‡La marca de Vashj (FLAG ONLY)‡La marca de Vashj (FLAG ONLY)‡La marque de Vashj‡‡',
    nil,
    nil,
  }
},
[11116] = {
  {
    '‡Испытание Наару: Магтеридон (QUEST FLAG)‡Die Prüfung der Naaru: (QUEST FLAG)‡나루의 시험: 마그테리돈‡Prueba de los naaru: Magtheridon (QUEST FLAG)‡Prueba de los naaru: Magtheridon (QUEST FLAG)‡L\'épreuve des naaru : (DRAPEAU DE QUÊTE)‡纳鲁的试炼：玛瑟里顿‡',
    nil,
    '‡По заданию А\'дала из Шаттрата убейте Магтеридона.‡A\'dal in Shattrath möchte, dass Ihr Magtheridon vernichtet.‡샤트라스에 있는 아달이 마그테리돈을 처치해 달라고 했습니다.‡A\'dal en la Ciudad de Shattrath quiere que mates a Magtheridon.‡A\'dal en la Ciudad de Shattrath quiere que mates a Magtheridon.‡A\'dal de Shattrath vous demande de tuer Magtheridon.‡沙塔斯城的阿达尔要求你杀死玛瑟里顿。‡',
  }
},
[11117] = {
  {
    'Capturar os Lebrervos Selvagens!‡Поймать дикого зайцелопа!‡Fangt die wilden Wolpertinger!‡야생 노루토끼를 잡아라!‡¡Atrapa al wolpertinger salvaje!‡¡Atrapa al wolpertinger salvaje!‡Attraper le Wolpertinger sauvage !‡抓住鹿角小飞兔！‡抓住野生鹿角兔!',
    nil,
    'Ourarca Caça-atirador pediu que você capture 5 Lebrervos Atordoados usando a Rede de Lebrervo. Ele disse que você precisa estar bêbado ou usando os Óculos da Visão Cervejárica para vê-los.‡Голдарк Меткий Охотник попросил вас поймать 5 оглушенных диких зайцелопов с помощью особой сети. Он намекнул, что необходимо достичь состояния сильного алкогольного опьянения – или надеть Синтехмельные очки.‡Goldark Spatzenjäger möchte, dass Ihr 5 betäubte Wolpertinger mit dem Wolpertingernetz einfangt. Er hat auch erwähnt, dass Ihr entweder ordentlich betrunken sein oder eine Syntheholbrille tragen müsst, um die Biester sehen zu können.‡골다크 스나이프헌터가 술에 취하거나 신더브루 고글을 착용하고 노루토끼 그물을 이용해 5마리의 기절한 노루토끼를 잡아오라고 했습니다.‡Goldark Novatada te ha pedido que captures 5 wolpertingers aturdidos usando la red de wolpertinger. Ha mencionado que para verlos hace falta una buena borrachera o llevar las gafas birratizadoras.‡Goldark Novatada te ha pedido que captures 5 wolpertingers aturdidos usando la red de wolpertinger. Ha mencionado que para verlos hace falta una buena borrachera o llevar las gafas birratizadoras.‡Archedor Chassebécasse vous a demandé de capturer 5 Wolpertingers sonnés avec le Filet à wolpertinger. Il a indiqué qu\'il fallait être soûl ou porter des Lunettes Synthébière pour les voir.‡葛达克·猎枪要你用鹿角小飞兔网捕捉5只昏迷的鹿角小飞兔。他说，你必须喝得酩酊大醉，或者是戴上合成酿酒护目镜，才能看见它们。‡茍達克·狙獵者要你用鹿角兔捕網幫他抓5隻昏迷的鹿角兔。他提到你必須要喝醉或戴上模擬醉眼護目鏡才看得到那些鹿角兔。',
  }
},
[11118] = {
  {
    'Elekks Rosa no desfile‡Розовые элекки на марше‡Parade der rosa Elekk‡엘레크를 무찔러라!‡Elekks rosas a la vista‡Elekks rosas a la vista‡Le défilé des elekk roses‡粉色的雷象‡粉紅伊萊克遊行',
    nil,
    'Visite os jardins de cerva do lado de fora de Ventobravo, Darnassus e Exodar, destrua três elekks em cada local e fale novamente com Ourarca Caça-atirador.‡Отправляйтесь в сады спелого хмеля рядом с Штормградом, Дарнасом и Экзодаром, истребите по три элекка в каждом из мест и возвращайтесь к Голдарку Меткому Охотнику. Чтобы увидеть розовых элекков, необходимо напиться или надеть Синтехмельные очки.‡Reist zu den Biergärten außerhalb von Sturmwind, Darnassus und der Exodar, zappt an jedem Ort drei Elekk und kehrt anschließend zu Goldark Spatzenjäger zurück. Um die rosa Elekk sehen zu können, müsst Ihr betrunken sein oder eine Syntheholbrille tragen.‡스톰윈드, 다르나서스, 엑소다르 바깥의 노천 선술집을 찾아가 술에 취하거나 신더브루 고글을 착용한 채로 분홍색 엘레크를 세 마리씩 처치하고 골다크 스나이프헌터에게 가야 합니다.‡Visita las terracitas a las afueras de Ventormenta, Darnassus y El Exodar, mata 3 elekks en cada uno de estos lugares y vuelve a ver a Goldrak Novatada. Tienes que estar borracho o que llevar las gafas birratizadoras para ver elekks rosas.‡Visita las terracitas a las afueras de Ventormenta, Darnassus y El Exodar, mata 3 elekks en cada uno de estos lugares y vuelve a ver a Goldrak Novatada. Tienes que estar borracho o que llevar las gafas birratizadoras para ver elekks rosas.‡Rendez-vous aux guinguettes à l\'extérieur de Hurlevent, Darnassus et l\'Exodar. Supprimez trois elekk dans chacune d\'elles, puis revenez voir Archedor Chassebécasse. Vous devez vous soûler ou bien porter des Lunettes Synthébière pour voir les Elekk roses.‡前往暴风城、达纳苏斯和埃索达城外的啤酒店，分别击败三头雷象，然后向葛达克·猎枪复命。你必须在醉酒或者戴上合成酿酒护目镜的情况下才能看见这些粉色的雷象。‡前往暴風城、達納蘇斯還有艾克索達外頭的啤酒廣場，在那些地方宰掉三頭伊萊克，然後回去找茍達克·狙獵者。你一定要喝醉或戴上模擬醉眼護目鏡才看得見那些粉紅伊萊克。',
  }
},
[11119] = {
  {
    '‡Налет на Лагерь Баш\'ира!‡Angriff auf den Landeplatz von Bash\'ir!‡바시르 영지 공격!‡¡Asalto al Alto Bash\'ir!‡¡Asalto al Alto Bash\'ir!‡Haro sur le point d\'ancrage de Bash\'ir‡突袭巴什伊尔码头！‡襲擊貝許爾平臺!',
    nil,
    '‡‡Sprecht mit dem Äthertechnikerlehrling im Außenposten der Himmelswache im Schergrat.‡‡Habla con el aprendiz técnico de éter en la Avanzada de la Guardia del Cielo en las Montañas Filospada.‡‡Parlez au Techno-éther apprenti à l’Avant-poste de la Garde-ciel, dans les Tranchantes.‡与刀锋山天空卫队哨站的以太技师学徒谈一谈。‡到劍刃山脈的禦天者前哨和蒼穹技師學徒談談。',
  }
},
[11120] = {
  {
    'Elekks Rosa no desfile‡Розовые элекки на марше‡Parade der rosa Elekk‡거리 축제에 나선 분홍색 엘레크‡Elekks rosas a la vista‡Elekks rosas a la vista‡Le défilé des elekk roses‡粉色的雷象‡粉紅伊萊克遊行',
    nil,
    'Visite os jardins de cerva do lado de fora de Luaprata, Penhasco do Trovão e Cidade Baixa, destrua três elekks em cada local e fale novamente com Glodrak Caçatiros. Você precisa estar bêbado ou usando os Óculos da Visão Cervejárica para enxergar os elekks rosa.‡Отправляйтесь в сады спелого хмеля рядом с Луносветом, Громовым Утесом и Подгородом, истребите по три элекка в каждом из них и возвращайтесь к Глодраку Меткому Охотнику. Чтобы увидеть розовых элекков, необходимо напиться – или хотя бы надеть Синтехмельные очки.‡Reist zu den Biergärten außerhalb von Silbermond, Donnerfels und Unterstadt, zappt an jedem Ort drei Elekk und kehrt anschließend zu Glodrak Jägerspatz zurück. Um die rosa Elekk sehen zu können, müsst Ihr betrunken sein oder eine Syntheholbrille tragen.‡실버문, 썬더 블러프, 언더시티 외곽의 맥주 정원을 방문하여 각 지역에 있는 엘레크를 세 마리씩 잡고 글로드락 헌트스나이퍼에게 가야 합니다. 취하거나 신더브루 고글을 써야만 분홍색 엘레크를 볼 수 있습니다.‡Visita las terracitas a las afueras de Lunargenta, la Cima del Trueno y Entrañas, mata 3 elekks en cada uno de estos lugares y vuelve a ver a Glodrak Guasa. Tienes que estar borracho o llevar las gafas birratizadoras para ver elekks rosas.‡Visita las terracitas a las afueras de Lunargenta, la Cima del Trueno y Entrañas, mata 3 elekks en cada uno de estos lugares y vuelve a ver a Glodrak Guasa. Tienes que estar borracho o que llevar las gafas birratizadoras para ver elekks rosas.‡Rendez-vous aux guinguettes à l\'extérieur de Lune-d\'argent, des Pitons-du-Tonnerre et de Fossoyeuse. Supprimez trois elekk dans chacune d\'elles, puis revenez voir Charedor Cassebéchasse. Vous devez vous soûler ou porter des Lunettes Synthébière pour voir les Elekk roses.‡前往银月城、雷霆崖和幽暗城外的啤酒店，分别击败三头雷象，然后向高达克·枪猎复命。你必须在醉酒或者戴上合成酿酒护目镜的情况下才能看见这些粉色的雷象。‡造訪銀月城、雷霆崖還有幽暗城外的啤酒廣場，在每個地方各宰掉三頭伊萊克，然後回去找葛羅卓克·獵狙者。你一定要喝醉或戴上模擬醉眼護目鏡才看得見那些粉紅伊萊克。',
  }
},
[11121] = {
  {
    'DAILY TEST QUEST (RAID)‡ЕЖЕДНЕВНОЕ ИСПЫТАТЕЛЬНОЕ ЗАДАНИЕ (РЕЙД)‡DAILY TEST QUEST (RAID)‡DAILY TEST QUEST (RAID)‡DAILY TEST QUEST (RAID)‡DAILY TEST QUEST (RAID)‡QUÊTE JOURNALIÈRE DE TEST (Raid)‡DAILY TEST QUEST (RAID)‡DAILY TEST QUEST (RAID)',
    nil,
    'Speak with <QUESTGIVER> in the <AREA>.‡Поговорите с <QUESTGIVER> в <AREA>.‡Sprecht mit <QUESTGIVER> in <AREA>.‡Speak with <QUESTGIVER> in the <AREA>.‡Habla con <QUESTGIVER> en <AREA>.‡Habla con <QUESTGIVER> en <AREA>.‡Parlez à <QUESTGIVER> dans <REGION>.‡Speak with <QUESTGIVER> in the <AREA>.‡Speak with <QUESTGIVER> in the <AREA>.',
  }
},
[11122] = {
  {
    'Lá e de volta outra vez‡Туда и обратно‡Hin und zurück‡왔다 갔다, 맥주통 배달!‡Historia de una ida y una vuelta‡Historia de una ida y una vuelta‡Histoire d\'un aller et retour‡来来回回‡來回跑',
    nil,
    'Pegue um barril com Flynn Aguardente, em Kharanos, e entregue-o a Pol Ambarmanso. Faça isso 3 vezes, antes que o carneiro vá embora.‡Возьмите бочку у Флинна Огневара и верните ее Полу Янтарлену. Пока баран не сбежит от вас, постарайтесь доставить три бочки.‡Holt ein Fässchen von Flynn Feuerbräu in Kharanos und bringt es zu Pol Bernruh zurück. Macht das Ganze dreimal, bevor Euer Widder verschwindet.‡산양이 사라지기 전에, 카라노스에 있는 플린 파이어브루에게 맥주통을 받아 폴 앰버스틸에게 3번 전달해야 합니다.‡Coge el barril de Flynn Aguardiente en Kharanos y entrégaselo a Pol Semperámbar. Haz esto 3 veces antes de que tu carnero se marche.‡Consigue un barril de Flynn Aguardiente en Kharanos y entrégaselo a Pol Semperámbar. Haz esto 3 veces antes de que tu carnero se marche.‡Allez chercher un tonneau auprès de Flynn Brassefeu à Kharanos et rapportez-le à Pol Distillambre. Rapportez trois tonneaux avant que votre bélier ne s\'en aille.‡从卡拉诺斯的弗莱恩·火酒那儿接过一只酒桶，然后将它交给波尔·冻石。在赛羊消失之前取回3只酒桶。‡從卡拉諾斯的弗萊恩·火酒那邊接過酒桶，然後回去找保爾·安伯斯堤爾。要在山羊跑掉之前要來回3次。',
  }
},
[11123] = {
  {
    '[DEPRECATED]Inspecting the Ruins‡[DEPRECATED]Inspecting the Ruins‡Untersuchung der Ruinen‡[미사용]폐허 조사‡[DEPRECATED]Inspeccionando las ruinas‡[DEPRECATED]Inspeccionando las ruinas‡[PÉRIMÉ]Inspection des ruines‡[DEPRECATED] 调查废墟‡[DEPRECATED]Inspecting the Ruins',
    nil,
    'Speak to Inspector Tarem at the Shady Rest Inn.‡Поговорите с инспектором Таремом у трактира "Последний привал".‡Sprecht mit Inspektor Tarem beim Gasthaus "Zur Süßen Ruh".‡그늘 쉼터 여관에 가서 조사관 타렘과 대화해야 합니다.‡Habla con el inspector Tarem en la Posada Reposo Umbrío.‡Habla con el inspector Tarem en la Posada Reposo Umbrío.‡Parlez à l\'Inspecteur Tarem à l\'Auberge du Repos ombragé.‡去和树荫旅店的调查员塔雷姆谈一谈。‡和樹蔭旅店的巡察員塔倫談談。',
  }
},
[11124] = {
  {
    '[DEPRECATED]Inspecting the Ruins‡[DEPRECATED]Inspecting the Ruins‡Untersuchung der Ruinen‡[미사용]폐허 조사‡[DEPRECATED]Inspeccionando las ruinas‡[DEPRECATED]Inspeccionando las ruinas‡[PÉRIMÉ]Inspection des ruines‡[DEPRECATED] 调查废墟‡[DEPRECATED]調查廢墟',
    nil,
    'Investigate the Shady Rest Inn in at the border of the Barrens in Dustwallow Marsh.‡Расследуйте дело в таверне "Последний привал", что стоит на границе Степей и Пылевых топей.‡Untersucht das Gasthaus "Zur Süßen Ruh" an der Grenze zwischen dem Brachland und den Düstermarschen.‡먼지진흙 습지대의 불모의 땅 경계에 있는 그늘 쉼터 여관을 조사해야 합니다.‡Investiga la Posada Reposo Umbrío en la frontera de Los Baldíos en el Marjal Revolcafango.‡Investiga la Posada Reposo Umbrío en la frontera de Los Baldíos en el Marjal Revolcafango.‡Enquêtez à l\'Auberge du Repos ombragé à la frontière des Tarides, au Marécage d\'äprefange.‡调查尘泥沼泽与贫瘠之地边境处的树荫旅店。‡調查塵泥沼澤的貧瘠之地邊界的樹蔭旅店。',
  }
},
[11125] = {
  {
    '‡[PH] Новые внутренние земли – задание‡Neues im Hinterland‡‡‡‡[PH] Nouvelle quête Hinterlands‡‡',
    nil,
    nil,
  }
},
[11126] = {
  {
    'Traitors Among Us‡Чужой среди своих‡Verräter unter uns‡무리의 배신자‡Traidores entre nosotros‡Traidores entre nosotros‡Des traîtres parmi nous‡叛徒‡叛徒就在我們之中',
    nil,
    'Confronte 5 Desertores Subversivos e fale novamente com Calia Hastings perto das docas de Theramore.‡Прогоните 5 дезертиров-подстрекателей и вернитесь к докам Терамора к Калии Гастингс.‡Konfrontiert 5 Aufwiegler der Deserteure und kehrt zu Calia Hastings nahe der Docks in Theramore zurück.‡탈영 선동원 5명을 찾아낸 후 테라모어의 부두 근처에 있는 칼리아 헤이스팅스에게 가야 합니다.‡Enfréntate a 5 agitadores desertores y vuelve junto a Calia Castilla cerca de los muelles de Theramore.‡Enfréntate a 5 agitadores desertores y vuelve junto a Calia Castilla cerca de los muelles de Theramore.‡Démasquez 5 Agitateurs des déserteurs puis retournez voir Calia Hastings près des quais de Theramore.‡与5个叛逃煽动者对质，然后向塞拉摩码头附近的加莉亚·哈斯汀汇报。‡找出5個叛逃者煽動家，然後向塞拉摩碼頭的卡莉雅·哈斯丁回報。',
  }
},
[11127] = {
  {
    '‡<NYI>Тайны Громопойла‡<NYI>Thunderbrew Secrets‡[미완성] 양조법의 비밀‡‡‡Les secrets des Tonnebière‡‡',
    nil,
    '‡Украдите тайный рецепт Мрачнобуха из лагеря Мрачнобуха в Западном Крае и отнесите его <NAME> Ячменовару на территории Хмельного фестиваля.‡Stehlt Schnapsbarts geheimes Rezept aus Schnapsbarts Lager in Westfall und kehrt zu Gerstenbräu beim Braufestplatz zurück.‡서부 몰락지대에 있는 그림부즈의 야영지에서 그림부즈의 비밀 양조법을 훔쳐 가을 축제 광장의 <NAME> 발리브루에게 가야 합니다.‡Roba la receta secreta de Tragoamargo del campamento de Tragoamargo, en los Páramos de Poniente y regresa junto a <NOMBRE> Cebadiz que se encuentra en la zona de la Fiesta de la Cerveza.‡Roba la receta secreta de Tragoamargo del campamento de Tragoamargo, en los Páramos de Poniente y regresa junto a <NOMBRE> Cebadiz que se encuentra en la zona de la Fiesta de la Cerveza.‡Volez la Recette secrète de Tristevin au Camp de Tristevin dans la Marche de l\'Ouest, puis revenez voir <NOM> Brasselorge sur le terrain de la fête des Brasseurs.‡‡',
  }
},
[11128] = {
  {
    'Propaganda War‡Пропагандистская война‡Propagandakrieg‡선동 전쟁‡Guerra de propaganda‡Guerra de propaganda‡Guerre de propagande‡宣传战‡宣傳戰',
    nil,
    'Leve a Propaganda do Desertor para Calia Hastings perto do píer de Theramore.‡Доставьте дезертирскую пропаганду Калии Гастингс к докам в Тераморе.‡Bringt das Propagandamaterial der Deserteure zu Calia Hastings nahe der Docks in Theramore.‡테라모어 부두 근처의 칼리아 헤이스팅스에게 선동 유인물 상자를 가져가야 합니다.‡Lleva la propaganda de los desertores a Calia Castilla, cerca del puerto de Therarmore.‡Lleva la propaganda de los desertores a Calia Castilla, cerca del puerto de Therarmore.‡Remettez la Propagande des déserteurs à Calia Hastings près des quais de Theramore.‡将叛逃者传单交给塞拉摩码头附近的加莉亚·哈斯汀。‡把叛逃者宣傳計畫帶給塞拉摩碼頭的卡莉雅·哈斯丁。',
  }
},
[11129] = {
  {
    'Kyle sumiu!‡Пропал Кайл!‡Kyle wird vermisst!‡사라진 강아지 카일‡¡Kyle ha desaparecido!‡¡Kyle ha desaparecido!‡Kyle a disparu !‡凯雷失踪了！‡凱爾失蹤了!',
    nil,
    'Ahab Casco Trigo, na Aldeia Casco Sangrento em Mulgore, quer que você alimente o bichinho de estimação dele, Kyle, o Frenético.|n|nAlimente Kyle com Carne Tenra de Moa e fale novamente com Ahab Casco Trigo.‡Анаб Пшеничная Грива из деревни Кровавого Копыта в Мулгоре попросил найти его лучшего щенка, Кайла Бесноватого.|n|nПокормите Кайла нежным мясом долгонога и возвращайтесь к Анабу Пшеничной Гриве.‡Ahab Weizhuf beim Dorf der Bluthufe in Mulgore möchte, dass Ihr seinen geliebten Hund Kyle den Wilden füttert.|n|nFüttert Kyle mit zartem Schreiterfleisch und kehrt anschließend zu Ahab Weizhuf zurück.‡멀고어의 블러드후프 마을에 있는 아합 윗후프가 광포한 카일에게 먹이를 주라고 했습니다.|n|n카일에게 연한 타조 고기를 준 후 아합 윗후프에게 가야 합니다.‡Ahab Pezuña de Trigo del Poblado Pezuña de Sangre, en Mulgore, quiere que des de comer a su apreciado cachorro, Kyle el Demenciado.|n|nDale a Kyle carne de zancudo tierna y vuelve junto a Ahab Pezuñatrigo.‡Ahab Pezuña de Trigo del Poblado Pezuña de Sangre, en Mulgore, quiere que des de comer a su apreciado cachorro, Kyle el Demenciado.|n|nDale a Kyle carne de zancudo tierna y vuelve junto a Ahab Pezuñatrigo.‡Ahab Sabot-de-blé, à Sabot-de-Sang en Mulgore, veut que vous nourrissiez son précieux chiot, Kyle le Frénétique.|n|nDonnez de la Viande de trotteur tendre à Kyle puis retournez voir Ahab Sabot-de-Blé.‡血蹄村的阿哈布·麦蹄希望你帮他给小狗凯雷喂食。|n|n让凯雷吃过鲜嫩的陆行鸟肉之后回去向阿哈布·麦蹄复命。‡莫高雷地區血蹄村的亞哈伯·麥蹄希望你幫忙餵餵他寶貝的狗狗，狂亂的凱爾。|n|n餵凱爾吃嫩陸行鳥肉，然後回去找亞哈伯·麥蹄。',
  }
},
[11130] = {
  {
    'Uuuh, coisas brilhantes!‡Ой, блестяшечки!‡Oh, es glitzert!‡오, 진귀한 것들!‡¡Oooh! ¡Cositas que brillan!‡¡Oooh! ¡Cositas que brillan!‡Houuuu, ça brille !‡闪亮闪亮的东西！‡噢，閃亮的東西!',
    nil,
    'Trambik quer que você entregue o Bilhete de Trambik para Bino na Terra Fantasma, ao lado de Zul\'Aman.‡Жуль хочет, чтобы вы взяли его записку и отнесли ее Бадду в Призрачные земли к Зул\'Аману.‡Gaunah möchte, dass Ihr Gaunahs Notiz zu Budd in den Geisterlanden, direkt außerhalb von Zul\'Aman, bringt.‡그립타가 유령의 땅에 있는 줄아만의 바로 바깥에 있는 버드에게 그립타의 쪽지를 가져다 달라고 했습니다.‡Griftah quiere que le lleves su nota a Budd en las Tierras Fantasma, justo a las afueras de Zul\'Aman.‡Griftah quiere que le lleves su nota a Budd en las Tierras Fantasma, justo a las afueras de Zul\'Aman.‡Eskrokar veut que vous remettiez la Note d\'Eskrokar à Budd, dans les Terres fantômes, à l\'extérieur de Zul\'Aman.‡格里伏塔要求你将他的便笺交给幽魂之地的巴德，他就在祖阿曼外。‡格利夫塔要你拿著格利夫塔的便條去找鬼魂之地的霸德，就在祖阿曼的外頭。',
  }
},
[11131] = {
  {
    'Pare com esses incêndios!‡Гаси пожар!‡Löscht das Feuer!‡화재를 진화하라!‡¡Apaga el fuego!‡¡Apaga el fuego!‡Éteignez les incendies !‡赶快灭火！‡阻止火勢!',
    nil,
    'A Matriarca Fantasiada quer que você ajude a apagar os incêndios da vila. Quando acabar, fale novamente com a Matriarca Fantasiada.‡Переодетая попечительница сирот просит вас помочь потушить пожар в деревне. Когда пожар будет потушен, снова поговорите с попечительницей сирот.‡Die kostümierte Matrone bittet um Eure Hilfe. Sie möchte, dass Ihr alle Feuer im Dorf löscht. Sprecht noch einmal mit der kostümierten Matrone, sobald alle Feuer erloschen sind.‡축제 의상을 입은 보육원 원장님이 마을에 발생한 화재를 진화해 달라고 했습니다. 불이 꺼지면 축제 의상을 입은 보육원 원장님과 대화해야 합니다.‡La supervisora de huérfanos disfrazada quiere que ayudes a apagar todos los incendios de la ciudad. Cuando termines, vuelve a hablar con ella.‡La supervisora de huérfanos disfrazada quiere que ayudes a apagar todos los incendios de la ciudad. Cuando termines, vuelve a hablar con ella.‡La Directrice d\'orphelinat costumée vous demande d\'aider à éteindre tous les foyers d\'incendie du village. Une fois qu\'ils seront éteints, retournez lui parler.‡穿戏服的孤儿院长希望你帮忙扑灭村子里的所有火焰。在所有火焰都被扑灭后，回去向穿戏服的孤儿院长汇报。‡變裝的孤兒監護員希望你幫助撲滅村莊中的火勢。等火完全撲滅之後，再和變裝的孤兒監護員交談。',
  }
},
[11132] = {
  {
    'Promessas, promessas...‡Все обещаешь и обещаешь‡Versprechen, Versprechen...‡약속, 약속...‡Promesas, promesas...‡Promesas, promesas...‡Des promesses, toujours des promesses...‡诱人的保证‡承諾，承諾…',
    nil,
    'Bino Cilada, na Serra da Machadinha, quer que você tome de volta o mapa do Sumo Sacerdote Nalorakk, em Zul\'Aman.‡Разыщите карту Бадда Недрека на террасе верховного шамана Налоракка в Зул\'Амане и верните ее хозяину.‡Budd Winterhäldler in den Axthügeln möchte, dass Ihr bei Hohepriester Nalorakks Terrasse in Zul\'Aman nach seiner Karte sucht.‡손도끼 언덕에 있는 버드 네드렉이 줄아만에 있는 대사제 날로라크의 정원에서 그의 지도를 찾아다 달라고 했습니다.‡Budd Magallenas en las Colinas Hacha quiere que recuperes su mapa del bancal del sumo sacerdote Nalorakk en Zul\'Aman.‡Budd Magallenas en las Colinas Hacha quiere que recuperes su mapa del bancal del sumo sacerdote Nalorakk en Zul\'Aman.‡Budd Truducou, dans les collines de la Cognée, veut que vous récupériez sa carte. Elle se trouve sur la terrasse du Grand prêtre Nalorakk à Zul\'Aman.‡战斧岭的巴德·奈德雷克要你前往祖阿曼的高阶祭司纳洛拉克所在的平台，找回他的地图。‡戰斧嶺的霸德·奈德瑞克希望你能從高階祭司納羅拉克的露臺那邊找回他的地圖。',
  }
},
[11133] = {
  {
    'Discrediting the Deserters‡Дискредитация вражеской агентуры‡Diskreditierung der Deserteure‡탈영병 쫓아내기‡Desprestigiando a los desertores‡Desprestigiando a los desertores‡Discréditer les déserteurs‡羞辱叛逃者‡',
    nil,
    'Calia Hastings quer que você distribua Panfletos Alterados para 6 Guardas de Theramore e se reapresente a ela perto das docas de Theramore.‡Калия Гастингс просит вас всучить подправленные листовки 6 тераморским стражникам. После этого вернитесь к Калии и доложите о выполнении задания.‡Calia Hastings möchte, dass Ihr verfälschte Handzettel an 6 Wachen von Theramore verteilt. Erstattet ihr anschließend Bericht nahe der Docks in Theramore.‡테라모어 경비병 6명에게 변경된 유인물을 배포하고 테라모어의 부두 근처에 있는 칼리아 헤이스팅스에게 보고해야 합니다.‡Calia Castilla quiere que entregues los panfletos modificados a 6 guardias de Theramore, después vuelve junto a ella en los muelles de Theramore.‡Calia Castilla quiere que entregues los panfletos modificados a 6 guardias de Theramore, después vuelve junto a ella en los muelles de Theramore.‡Calia Hastings veut que vous distribuiez les Pamphlets trafiqués à 6 Gardes de Theramore. Ensuite, retournez la voir près des quais de Theramore.‡‡',
  }
},
[11134] = {
  {
    'The End of the Deserters‡Конец вражеской пропаганде‡Das Ende der Deserteure‡탈영병들의 종말‡El fin de los desertores‡El fin de los desertores‡La fin des déserteurs‡叛逃者的末日‡叛逃者的末日',
    nil,
    'Capture Gavis Escudogris e reapresente-se a Calia Hastings perto das docas de Theramore.‡Арестуйте Гависа Серого Щита, затем доложитесь Калии Гастингс у доков Терамора.‡Nehmt Gavis Grauschild gefangen und erstattet anschließend Bericht bei Calia Hastings nahe der Docks in Theramore.‡가비스 그레이쉴드를 체포해 테라모어 부두 근처의 칼리아 헤이스팅스에게 보고해야 합니다.‡Captura a Gavis Rodelagris y después informa a Calia Castilla, cerca del puerto de Theramore.‡Captura a Gavis Rodelagris y después informa a Calia Castilla, cerca del puerto de Theramore.‡Capturez Gavis Targegrise, puis allez faire votre rapport à Calia Hastings près des quais de Theramore.‡抓住贾维斯·格雷希德，然后向塞拉摩码头附近的加莉亚·哈斯汀复命。‡俘虜蓋維司·灰盾，然後向塞拉摩碼頭的卡莉雅·哈斯丁回報。',
  }
},
[11135] = {
  {
    '‡Всадник без головы‡Der kopflose Reiter‡저주받은 기사‡El Jinete decapitado‡El Jinete decapitado‡Le Cavalier sans tête‡无头骑士‡無頭騎士',
    nil,
    '‡Найдите святилище тыквы Всадника без головы.‡Sucht nach dem Kürbisschrein des kopflosen Reiters.‡붉은십자군 수도원에서 저주받은 기사의 호박 제단을 찾아야 합니다.‡Encuentra el santuario calabaza de El Jinete decapitado.‡Encuentra el santuario calabaza de El Jinete decapitado.‡Trouvez le Sanctuaire de citrouille du Cavalier sans tête.‡找到无头骑士的南瓜神龛。‡',
  }
},
[11136] = {
  {
    '‡Тревожные события‡Beunruhigende Berichte‡불안한 전개‡Un progreso preocupante‡Un progreso preocupante‡Un développement inquiétant‡麻烦的事态‡',
    nil,
    '‡Отрапортуйте капитану Ваймору на Сторожевом посту.‡Erstattet Hauptmann Wymor bei der Späherwacht Bericht.‡감시초소에 있는 경비대장 와이모어에게 보고해야 합니다.‡Preséntate ante el capitán Wymor en el Alto del Centinela.‡Preséntate ante el capitán Wymor en el Alto del Centinela.‡Présentez-vous au capitaine Wymor à la Halte de la vigie.‡向警戒哨岗的维摩尔上尉报到。‡',
  }
},
[11137] = {
  {
    '[DEPRECATED]Defias in Dustwallow?‡[DEPRECATED]Defias in Dustwallow?‡Defias in den Düstermarschen?‡[미사용]먼지진흙 습지대에 나타난 데피아즈단‡[DEPRECATED]¿Defias en Revolcafango?‡[DEPRECATED]¿Defias en Revolcafango?‡[PÉRIMÉ]Des défias à Âprefange ?‡[DEPRECATED] 尘泥沼泽有迪菲亚兄弟会？‡[DEPRECATED]迪菲亞在塵泥沼澤?',
    nil,
    'Obtenha as Ordens dos Défias de Galvão Matreiro e entregue-as para o Capitão Walmor, no Pontal de Vigília.‡Добудьте приказы Братства Справедливости у Гарна Маферса и принесите его капитану Ваймору на Сторожевой пост.‡Besorgt Euch die Befehle der Defias von Garn Mathers und bringt sie zu Hauptmann Wymor bei der Späherwacht.‡가른 마더스에게 데피아즈단 명령서를 빼앗아 감시초소의 경비대장 와이모어에게 가져가야 합니다.‡Obtén las órdenes Defias de Gran Mathers y llévaselas al capitán Wymor al Alto del Centinela.‡Obtén las órdenes Defias de Gran Mathers y llévaselas al capitán Wymor al Alto del Centinela.‡Récupérez les Ordres des défias sur Garn Mathers, et remettez-les au Capitaine Wymor à la halte de la Vigie.‡从加恩·马瑟斯手中夺得迪菲亚命令书，把它们交给警戒岗哨的维摩尔上尉。‡從加爾恩·邁瑟斯身上取得迪菲亞指令，然後交給警戒崗哨的魏摩爾上尉。',
  }
},
[11138] = {
  {
    '[DEPRECATED]Renn McGill‡[DEPRECATED]Renn McGill‡Renn McGill‡[미사용]렌 맥길‡[DEPRECATED]Renn McBranquia‡[DEPRECATED]Renn McBranquia‡[PÉRIMÉ]Renn McBranchie‡[DEPRECATED] 雷恩·米克基尔‡[DEPRECATED]瑞恩·麥格吉爾',
    nil,
    'Bring the Defias Orders to Renn McGill in the waters off the Dreadmurk Shore.‡Отнесите приказы Братства Справедливости Ренну Макгиллу. Он плавает недалеко от Зловещего берега.‡Bringt die Befehle der Defias zu Renn McGill in den Gewässern nahe der Schreckensmoorküste.‡몸서리 해안 근처의 물속에 있는 렌 맥길에게 데피아즈단 명령서를 가져가야 합니다.‡Lleva las órdenes Defias a Renn McBranquia a las aguas más allá de Playa Tenebruma.‡Lleva las órdenes Defias a Renn McBranquia a las aguas más allá de Playa Tenebruma.‡Apportez les Ordres des défias à Renn McBranchie dans les eaux au large du Rivage de Troubleffroi.‡将迪菲亚命令书交给恐惧海岸水边的雷恩·米克基尔。‡把迪菲亞指令交給恐懼海岸的瑞恩·麥格吉爾。',
  }
},
[11140] = {
  {
    '‡‡Bergt die Fracht!‡‡[DEPRECATED]¡Recupera la mercancía!‡‡[PÉRIMÉ]Récupérez la cargaison !‡‡',
    nil,
    '‡Принесите 6 поднятых со дна сундуков Ренну Макжабру в Пылевые топи.‡Bringt 6 geborgene Geldkassetten zu Renn McGill in den Düstermarschen.‡‡Lleva 6 cajas fuertes rescatadas a Renn McBranquia en el Marjal Revolcafango.‡Lleva 6 cajas fuertes rescatadas a Renn McBranquia en el Marjal Revolcafango.‡Remettez 6 Coffres récupérés à Renn McBranchie, dans le marécage d\'Âprefange.‡‡',
  }
},
[11141] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED] 通知吉安娜‡',
    nil,
    '‡‡‡‡‡‡‡与塞拉摩的吉安娜·普罗德摩尔谈一谈。‡',
  }
},
[11142] = {
  {
    '[DEPRECATED]Survey Alcaz Island‡[DEPRECATED]Survey Alcaz Island‡Beobachtet die Insel Alcaz‡[미사용]알카즈 섬 조사‡[DEPRECATED]Inspecciona la Isla de Alcaz‡[DEPRECATED]Inspecciona la Isla de Alcaz‡[PÉRIMÉ]Survoler l\'île d\'Alcaz‡[DEPRECATED] 调查奥卡兹岛‡[DEPRECATED]偵察奧卡茲島',
    nil,
    'Fale com Cassa Carminasa e use um de seus grifos para inspecionar a Ilha Alcaz. Quando terminar a inspeção, fale com a Grã-senhora Jaina Proudmore, em Theramore.‡Поговорите с Коссой Багровое Крыло и возьмите одного из ее грифонов, чтобы обследовать остров Алькац. После выполнения поручения отрапортуйте леди Джайне Праудмур в Тераморе.‡Sprecht mit Cassa Purpurschwinge und nutzt einen ihrer Greifen, um die Insel Alcaz zu beobachten. Sprecht mit Lady Jaina Prachtmeer in Theramore, wenn Ihr die Beobachtung abgeschlossen habt.‡카사 크림슨윙에게 그리핀을 빌려 알카즈 섬을 조사한 후, 테라모어에 있는 여군주 제이나 프라우드무어와 대화해야 합니다.‡Habla con Cassa Ala Carmesí y utiliza uno de sus grifos para inspeccionar la Isla de Alcaz. Cuando acabes la inspección, habla con Lady Jaina Valiente en Theramore.‡Habla con Cassa Ala Carmesí y utiliza uno de sus grifos para inspeccionar la Isla de Alcaz. Cuando acabes la inspección, habla con Lady Jaina Valiente en Theramore.‡Parlez à Cassa Cramoissaile et utilisez l\'un de ses griffons pour survoler l\'île d\'Alcaz. Lorsque vous aurez achevé vos observations, parlez à dame Jaina Portvaillant à Theramore.‡与卡萨·赤翼谈一谈，乘坐她的狮鹫调查奥卡兹岛。调查完成之后，回去向塞拉摩的吉安娜·普罗德摩尔报告。‡和卡莎·紅翼談談，並用她的獅鷲獸偵察奧卡茲島。當你的偵察結束之後，和塞拉摩的珍娜女士談談。',
  }
},
[11143] = {
  {
    '[DEPRECATED]A Grim Connection‡[DEPRECATED]A Grim Connection‡Der entscheidende Grimmweis‡[미사용]불길한 관계‡[DEPRECATED]Una conexión sombría‡[DEPRECATED]Una conexión sombría‡[PÉRIMÉ]Un lien Sinistre‡[DEPRECATED] 恐怖图腾‡[DEPRECATED]A Grim Connection',
    nil,
    'Report to Captain Darill at North Point.‡Доложитесь капитану Дариллу в Северной башне.‡Erstattet Hauptmann Darill bei der Nordwacht Bericht.‡북부 경비탑에 있는 대장 다릴에게 보고해야 합니다.‡Preséntate ante el capitán Darill en la Torre de la Punta Norte.‡Preséntate ante el capitán Darill en la Torre de la Punta Norte.‡Présentez-vous au Capitaine Darill à la Halte nord.‡向北点哨塔的达利尔上尉报告。‡向北點哨塔的達利爾上尉回報。',
  }
},
[11146] = {
  {
    '[DEPRECATED]Raptor Captor‡[DEPRECATED]Raptor Captor‡Raptorenfänger‡랩터 포획‡[DEPRECATED]Captor de raptores‡‡[PÉRIMÉ]Rapt de raptor‡[DEPRECATED] 捕捉迅猛龙‡[DEPRECATED]捕捉迅猛龍',
    nil,
    'O Sargento Lukas, na Torre Norte, quer que você capture 6 raptores. Você pode capturar Raptores Dinossangue ou Gritadores Dinossangue.‡Сержант Лукас из Северной башни просит вас поймать 6 ящеров. Вы можете ловить как ящеров Кровавой Топи, так и крикунов Кровавой Топи.‡Unteroffizier Lukas bei der Nordwacht möchte, dass Ihr 6 Raptoren einfangt. Ihr könnt entweder Blutsumpfraptoren oder Blutsumpfkreischer einfangen.‡북부 경비탑에 있는 하사관 루카스가 붉은늪지랩터나 긴송곳니 붉은늪지랩터 중 6마리를 포획해 달라고 했습니다.‡El sargento Lukas en la Torre de la Punta Norte quiere que captures a 6 raptores. Puedes capturar bien a raptores Cienorrojo a o estridadores Cienorrojo.‡El sargento Lukas en la Torre de la Punta Norte quiere que captures a 6 raptores. Puedes capturar bien a raptores Cienorrojo a o estridadores Cienorrojo.‡Le Sergent Lukas, de la Tour de la halte nord, veut que vous capturiez 6 raptors. Vous pouvez capturer des Raptors Rougefange ou des Hurleurs Rougefange, au choix.‡北点哨塔的卢卡斯中士要求你捕捉6只迅猛龙。血沼迅猛龙或是血沼尖啸龙都可以满足他的要求。‡北點哨塔的盧卡斯中士要你去捕捉6隻迅猛龍。你可以捕捉血沼迅猛龍或血沼尖嘯龍。',
  }
},
[11149] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED] 塔贝萨的协助‡',
    nil,
    '‡‡‡‡‡‡‡与塔贝萨农场的塔贝萨谈一谈。‡',
  }
},
[11152] = {
  {
    '[DEPRECATED]Peace at Last‡[DEPRECATED]Peace at Last‡[DEPRECATED] Endlich Frieden‡[미사용]평화롭게 잠들길‡[DEPRECATED]Al fin paz‡[DEPRECATED]Al fin paz‡[PÉRIMÉ]Enfin la paix‡[DEPRECATED] 安息‡[DEPRECATED]Peace at Last',
    nil,
    'Captain Garran Vimes at Foothold Citadel wants you to lay the Wreath at the Hyal Family Monument.‡По просьбе капитана Гаррана Ваймса из цитадели возложите венок к памятнику семейства Хьяль.‡Hauptmann Garran Mumm bei der Wehrzitadelle möchte, dass Ihr den Kranz bei dem Monument der Familie Hyal niederlegt.‡거점 요새의 사령관 개런 바임스가 하이얄 가족 추모비에 화관을 놓아 달라고 했습니다.‡El capitán Garran Vimes de la Ciudadela Garrida quiere que coloques la corona en el monumento de la familia Hyal.‡El capitán Garran Vimes de la Ciudadela Garrida quiere que coloques la corona en el monumento de la familia Hyal.‡Le Capitaine Garran Vimaire, de la citadelle de Theramore, veut que vous déposiez la Couronne au Monument de la famille Hyal.‡塞拉摩城堡中的盖兰·维米斯队长想让你在海厄尔家族墓碑前放上一个花圈。‡塞拉摩堡壘的蓋蘭·維米斯上尉希望你向海爾家族的紀念碑獻上花圈。',
  }
},
[11153] = {
  {
    'Furar o bloqueio‡Прорвать блокаду‡Durchbrecht die Blockade‡차단선 돌파‡Rompe el bloqueo‡Rompe el bloqueo‡Forcer le blocus‡冲破封锁‡突破封鎖線',
    nil,
    'Pegue as Bombas de Fragmentação do Petrov e lance-as em piratas em quantidade suficiente para destruir 25 Piratas do Bloqueio e 10 Canhões do Bloqueio. Em seguida, apresente-se ao Bombardeiro Petrov na Bastilha da Guarda Oeste.‡Возьмите кассетные бомбы Петрова и сбросьте их на корабли, убив 25 матросов абордажной команды и уничтожив 10 абордажных пушек. Как только задание будет выполнено, вернитесь к бомбардиру Петрову в Крепость Западной Стражи.‡Nehmt Petrovs Splitterbomben und werft sie auf die Piraten. Beseitigt 25 Piraten der Blockade und 10 Kanonen der Blockade. Kehrt zu Bombenschütze Petrov in Westwacht zurück, sobald Ihr den Auftrag erfüllt habt.‡페트로프의 연발 폭탄으로 해적선에 폭격을 가해 봉쇄선 해적 25명과 봉쇄선 대포 10개를 제거하십시오. 임무를 완료하면 서부경비대 성채에 있는 폭격수 페트로프에게 가야 합니다.‡Toma las bombas de racimo de Petrov y lánzalas sobre tantos piratas como sea necesario para matar a 25 piratas del bloqueo y destruir 10 cañones del bloqueo. Cuando hayas terminado, vuelve a ver al bombardero Petrov a la Fortaleza de la Guardia Oeste.‡Toma las bombas de racimo de Petrov y lánzalas sobre tantos piratas como sea necesario para matar a 25 piratas del bloqueo y destruir 10 cañones del bloqueo. Cuando hayas terminado, vuelve a ver al bombardero Petrov a la Fortaleza de la Guardia Oeste.‡Prenez les Bombes à sous-munitions de Petrov et lâchez-les sur les pirates. Vous devez tuer 25 Pirates du blocus et détruire 10 Canons du blocus. Lorsque vous aurez terminé, retournez voir le Bombardier Petrov au Donjon de la Garde de l’ouest.‡使用匹特洛夫的集束炸弹炸死25名封锁船海盗，并摧毁10门封锁船的火炮。完成任务后返回嚎风峡湾的西部卫戍要塞，向炮兵匹特洛夫复命。‡帶著派特洛夫的榴散彈然後把它們往海賊多的地方丟，殺死或摧毀25個封鎖線海賊以及10個封鎖線火砲。一旦你完成行動，向鎮西要塞的投彈手派特洛夫回報。',
  }
},
[11154] = {
  {
    'Que façam guano nas calças!‡Пусть обделаются от страха!‡Jagt ihnen eine Guanoangst ein!‡박쥐 놀래주기!‡¡Dales un susto de guano!‡¡Sácales el guano de un susto!‡Dans le guano jusqu\'au cou !‡吓出它们的……‡嚇到他們挫屎!',
    nil,
    'Recolha 10 punhados de Guano de Garra-negra e entregue-os para o Engenheiro Feknut no Portão de Aço.‡Соберите 10 кусков гуано темнолапых летучих мышей и отнесите их инженеру Фекнату к Стальным воротам.‡Sammelt 10 Stück Dunkelklauenguano ein und bringt sie zu Ingenieur Feknut am Stählernen Tor.‡검은발톱 조분석 10개를 모아 강철 관문에 있는 기술자 페크넛에게 가져가야 합니다.‡Consigue 10 guanos Garranegra y entrégaselos al ingeniero Feknut en Las Puertas de Acero.‡Consigue 10 guanos Garranegra y entrégaselos al ingeniero Feknut en Las Puertas de Acero.‡Récupérez 10 doses de Guano de sombregriffe et livrez-les à l’Ingénieur Fauboulon, à la Porte d’acier.‡将10坨暗爪蝙蝠的粪便交给嚎风峡湾钢铁之门的工程师菲纳特。‡收集10塊暗爪糞便，送去給鋼鐵之門的工程師費克努。',
  }
},
[11155] = {
  {
    'Sopa de cavacorne de novo?‡Снова суп из черпорога?‡Schon wieder Schaufelhauersuppe?‡또 뾰족엄니 수프라고?‡¿Sopa de colmipala otra vez?‡¿Sopa de colmipala otra vez?‡Encore de la soupe de brochepelle ?‡又是铲齿鹿汤？‡又是鍬牙湯?',
    nil,
    'A Chef Tachopreto pediu para você arranjar 6 nacos de Carne de Cavacorne e entregar para ela na Bastilha da Guarda Oeste.‡Шеф-повар Дымкотел поручила вам добыть 6 кусков мяса черпорогов и принести их ей в Крепость Западной Стражи.‡Küchenchefin Schwarzkessel hat Euch gebeten, ihr 6 Schaufelhauerfleisch zu beschaffen. Sie befindet sich in Westwacht.‡서부경비대 성채에 있는 주방장 케틀블랙이 뾰족엄니 고기 6개를 구해 달라고 했습니다.‡Chef Caldera Negra te ha pedido que consigas 6 pedazos de carne de colmipala y que se los lleves a la Fortaleza de la Guardia Oeste.‡Chef Caldera Negra te ha pedido que consigas 6 pedazos de carne de colmipala y que se los lleves a la Fortaleza de la Guardia Oeste.‡Le chef Bouillenoire vous a demandé de récupérer 6 morceaux de Viande de brochepelle et de les lui remettre au donjon de la Garde de l\'ouest.‡将6块铲齿鹿肉交给西部卫戍要塞的厨师凯图·黑罐。‡主廚黑壺要你帶6塊鍬牙肉，回到鎮西要塞交給她。',
  }
},
[11156] = {
  {
    '[DEPRECATED]Direhorn Raiders‡[DEPRECATED]Direhorn Raiders‡[DEPRECATED] Räuber des Grollhornpostens‡[미사용]공포뿔 침략자‡[DEPRECATED]Asaltantes del Puesto Cuernoatroz‡[DEPRECATED]Asaltantes del Puesto Cuernoatroz‡[PÉRIMÉ]Les écumeurs navrecorne‡[DEPRECATED] 恐角袭击者‡[DEPRECATED]Direhorn Raiders',
    nil,
    'Mate 12 Temíveis Totens de Chifrebravo e fale novamente com o Aprendiz Morlann na Fazenda de Tabetha.‡Убейте 12 тауренов из племени Зловещего Тотема с заставы Дикого Рога и вернитесь к ученику Морланну в усадьбу Табеты.‡Tötet 12 Grimmtotem des Grollhornpostens und kehrt zu Lehrling Morlann auf Tabethas Hof zurück.‡공포뿔 거점에서 그림토템 부족 12명을 처치하고 타베사의 농장에 있는 수습생 모를란에게 가야 합니다.‡Mata a 12 Tótem Siniestro Cuernoatroz e informa al aprendiz Morlann en la Granja de Tabetha.‡Mata a 12 Tótem Siniestro Cuernoatroz e informa al aprendiz Morlann en la Granja de Tabetha.‡Tuez 12 Totem-sinistre de Navrecorne puis revenez voir l\'Apprenti Morlann à la Ferme de Tabetha.‡在恐角岗哨消灭12个恐怖图腾成员，然后向塔贝萨农场的学徒莫兰恩复命。‡殺死12個恐角的恐怖圖騰，然後向塔貝薩農場的學徒莫蘭恩回報。',
  }
},
[11157] = {
  {
    'A ninhada do mal‡В тисках зла‡Das Gelege des Bösen‡악마의 손아귀‡Las garras del mal‡Las garras del mal‡Les œufs maléfiques‡邪恶之巢‡邪惡窩巢',
    nil,
    'Destrua 15 Ovos de Protodraco e 15 Protodragonetes. Depois, fale novamente com o Capitão Carneiro na Bastilha da Guarda Oeste.‡Уничтожьте 15 яиц протодраконов и 15 детенышей протодраконов, после чего вернитесь к капитану Адамсу в Крепость Западной Стражи.‡Zerstört 15 Eier der Protodrachen und 15 Protowelpen. Kehrt danach zu Hauptmann Adams in Westwacht zurück.‡원시비룡 알 15개와 새끼 원시용 15마리를 처치하고 서부경비대 성채에 있는 경비대장 아담스에게 가야 합니다.‡Destruye 15 huevos de protodraco y 15 protocrías y regresa junto al capitán Adams a la Fortaleza de la Guardia Oeste.‡Destruye 15 huevos de protodraco y 15 protocrías y regresa junto al capitán Adams a la Fortaleza de la Guardia Oeste.‡Détruisez 15 Œufs de proto-drake et 15 Proto-dragonnets, puis retournez voir le Capitaine Adams au Donjon de la Garde de l\'ouest.‡摧毁15枚始祖龙卵，并杀死15只始祖龙崽，然后返回西部卫戍要塞，向亚当斯上尉复命。‡消滅15個元龍蛋和15隻元龍幼龍，然後向亞當斯隊長回報，他就在凜風峽灣的鎮西要塞。',
  }
},
[11158] = {
  {
    '[DEPRECATED]Bloodfen Feathers‡[DEPRECATED]Bloodfen Feathers‡Blutsumpffedern‡[미사용]붉은늪지랩터 깃털‡[DEPRECATED]Plumas Cienorrojo‡[DEPRECATED]Plumas Cienorrojo‡[PÉRIMÉ]Les plumes de Rougefange‡[DEPRECATED] 血沼羽毛‡[DEPRECATED]Bloodfen Feathers',
    nil,
    'Leve 5 Penas de Dinossangue para Brogg em Coroa de Barro.‡Принесите 5 перьев Кровавой Топи Броггу в Шестермуть.‡Bringt 5 Blutsumpffedern zu Brogg in Morastwinkel.‡진흙톱니 거점에 있는 브록에게 붉은늪지랩터 깃털 5개를 가져가야 합니다.‡Lleva 5 plumas Cienorrojo a Brogg en Piñón de Barro.‡Lleva 5 plumas Cienorrojo a Brogg en Piñón de Barro.‡Brogg de Bourbe-à-brac veut 5 Plumes de Rougefange.‡将5片血沼羽毛交给泥链镇的布洛格。‡帶5根血沼羽毛給泥鏈營地的布洛葛。',
  }
},
[11159] = {
  {
    '[DEPRECATED]Spirits of Stonemaul Hold‡[DEPRECATED]Spirits of Stonemaul Hold‡Geister der Festung der Steinbrecher‡[미사용]돌망치 폐허의 영혼‡[DEPRECATED]Espíritus del Bastión Quebrantarrocas‡‡[PÉRIMÉ]Les esprits du bastion Cognepierre‡‡',
    nil,
    'Brogg, em Coroa de Barro, quer que você dê descanso a 10 Espíritos de Pedramalho.‡Брогг из Шестермути просит вас дать покой 10 духам клана Каменного Молота.‡Brogg in Morastwinkel möchte, dass Ihr 10 Geister der Steinbrecher tötet, um sie so ihrer letzten Ruhe zu überantworten.‡진흙톱니 거점에 있는 브록이 10명의 돌망치 영혼에 안식을 찾아달라고 했습니다.‡Brogg de Piñón de Barro quiere que hagas descansar a 10 espíritus Quebrantarrocas.‡Brogg de Piñón de Barro quiere que hagas descansar a 10 espíritus Quebrantarrocas.‡Brogg de Bourbe-à-brac veut que vous apportiez le repos à 10 Esprits Cognepierre.‡‡',
  }
},
[11160] = {
  {
    '[DEPRECATED]Banner of the Stonemaul‡[DEPRECATED]Banner of the Stonemaul‡Das Banner der Steinbrecher‡[미사용]돌망치 깃발‡[DEPRECATED]El estandarte de los Quebrantarrocas‡[DEPRECATED]El estandarte de los Quebrantarrocas‡[PÉRIMÉ]La bannière des Cognepierres‡[DEPRECATED] 石槌战旗‡[DEPRECATED]Banner of the Stonemaul',
    nil,
    'Recupere o Estandarte de Pedramalho e entregue-o a Brogg em Coroa de Barro.‡Добудьте знамя Каменного Молота и принесите его Броггу в Шестермуть.‡Beschafft das Banner der Steinbrecher und bringt es Brogg in Morastwinkel.‡돌망치 깃발을 되찾아 진흙톱니 거점에 있는 브록에게 가져가야 합니다.‡Recupera el estandarte Quebrantarrocas y llévaselo a Brogg a Piñón de Barro.‡Recupera el estandarte Quebrantarrocas y llévaselo a Brogg a Piñón de Barro.‡Récupérez la Bannière cognepierre et remettez-la à Brogg de Bourbe-à-brac.‡夺取石槌战旗，并将它交给泥链镇的布洛格。‡找到石槌旌旗並且把它帶給泥鏈營地的布洛葛。',
  }
},
[11161] = {
  {
    '[DEPRECATED]The Essence of Enmity‡[DEPRECATED]The Essence of Enmity‡Die Essenz der Feindschaft‡[미사용]증오의 정수‡[DEPRECATED]La esencia de la animadversión‡[DEPRECATED]La esencia de la animadversión‡[PÉRIMÉ]L\'essence de l\'ennemi‡[DEPRECATED] 憎恨的精华‡[DEPRECATED]The Essence of Enmity',
    nil,
    'Bring 10 Black Dragonkin Essences to Brogg at Mudsprocket.‡Принесите 10 сущностей черного дракона Броггу в Шестермуть.‡Bringt 10 Essenzen eines schwarzen Drachkin zu Brogg in Morastwinkel.‡검은용혈족 정수 10개를 진흙톱니 거점에 있는 브록에게 가져가야 합니다.‡Llévale 10 esencias de dragonante negro a Brogg a Piñón de Barro.‡Llévale 10 esencias de dragonante negro a Brogg a Piñón de Barro.‡Apportez 10 Essences de draconien noir à Brogg à Bourbe-à-brac.‡将10份黑龙精华交给泥链镇的布洛格。‡帶10個黑龍精華給泥鏈營地的布洛葛。',
  }
},
[11162] = {
  {
    '‡‡Herausforderung für den schwarzen Drachenschwarm‡‡[DEPRECATED]Reta al Vuelo Negro‡‡[PÉRIMÉ]Un défi au Vol noir‡[DEPRECATED] 挑战黑龙军团‡',
    nil,
    '‡Установите знамя Каменного Молота у входа в Логово Ониксии, затем вернитесь к Броггу в Шестермуть.‡Stellt das Banner der Steinbrecher nahe des Eingangs zu Onyxias Hort auf, wartet auf ihre Reaktion und kehrt anschließend zu Brogg in Morastwinkel zurück.‡‡Coloca el estandarte Quebrantarrocas cerca de la entrada a la Guarida de Onyxia, espera a recibir la respuesta de Onyxia y después ve a ver a Brogg en Piñón de Barro.‡Coloca el estandarte Quebrantarrocas cerca de la entrada a la Guarida de Onyxia, espera a recibir la respuesta de Onyxia y después ve a ver a Brogg en Piñón de Barro.‡Plantez la Bannière cognepierre près de l\'entrée du Repaire d\'Onyxia, attendez la réponse d\'Onyxia, puis rendez la bannière à Brogg de Bourbe-à-brac.‡将石槌战旗插在奥妮克希亚的巢穴入口附近，等待奥妮克希亚的回应，然后回去向泥链镇的布洛格复命。‡',
  }
},
[11163] = {
  {
    '‡Тайная Сестрица‡Agentin mit Herz‡‡Hermana clandestina‡Hermana clandestina‡Taupe secrète‡对不起，我是卧底‡',
    nil,
    '‡Доберитесь до Донны Браско, чтобы получить причитающуюся вам награду. Найти Донну можно на Призрачных Землях, сразу за окраиной Зул\'Амана.‡Meldet Euch bei Donna Brascoe, um eine Belohnung für Euer Heldentum in Zul\'Aman zu erhalten. Donna hält sich momentan in den Geisterlanden, direkt außerhalb von Zul\'Aman auf.‡‡Preséntate ante Donna Brascoe para obtener una recompensa por tu heroísmo en Zul\'Aman. En este momento, Donna se encuentra en las Tierras Fantasma, justo a las afueras de Zul\'aman.‡Preséntate ante Donna Brascoe para obtener una recompensa por tu heroísmo en Zul\'Aman. En este momento, Donna se encuentra en las Tierras Fantasma, justo a las afueras de Zul\'aman.‡Présentez-vous à Donna Brascoe afin de recevoir une récompense pour votre héroïsme à Zul\'Aman. Donna est actuellement postée dans les Terres fantômes, juste à l\'extérieur de Zul\'Aman.‡向多娜·布拉斯库报告你的英雄事迹，并领取你的奖励。多娜现在驻扎在祖阿曼外面的幽魂之地。‡',
  }
},
[11164] = {
  {
    'Dente por dente‡Клыкастые всадники‡Jäger der verlorenen Hauer‡숲트롤 엄니‡Asaltantes colmillo‡Asaltantes colmillo‡Illégitimes défenses‡夺牙奇兵‡長牙劫掠者',
    nil,
    'Prigmon quer que você colete 10 Presas de Troll da Floresta de trolls em Zul\'Aman. Entregue-as a ele no acampamento de Bino, na Terra Fantasma.‡Соберите для Пригмона 10 клыков лесных троллей в Зул\'Амане и принесите их ему в лагерь Бадда в Призрачных Землях.‡Prigmon möchte, dass Ihr 10 Hauer eines Waldtrolls von Trollen in Zul\'Aman einsammelt. Bringt sie zu ihm bei Budds Lager in den Geisterlanden.‡줄아만에 있는 트롤에게서 숲트롤 엄니 10개를 구해서 유령의 땅, 버드의 야영지에 있는 프리그몬에게 가져가야 합니다.‡Prigmon necesita que consigas 10 colmillos de trol de bosque de los trols de Zul\'Aman. Llévaselos al campamento de Budd en las Tierras Fantasma.‡Prigmon necesita que consigas 10 colmillos de trol de bosque de los trols de Zul\'Aman. Llévaselos al campamento de Budd en las Tierras Fantasma.‡Dasnob veut que vous récupériez 10 Défenses de trolls des forêts sur les trolls de Zul\'Aman. Apportez-les-lui au camp de Budd dans les Terres fantômes.‡普雷蒙要你从祖阿曼的巨魔身上收集10根森林巨魔獠牙，把它们带回巴德的营地交给他。‡皮格蒙需要你從祖阿曼的食人妖那邊收集10根森林食人妖長牙。把東西帶給他，他就在鬼魂之地的霸德營地。',
  }
},
[11165] = {
  {
    'Um troll especial‡Тролль в стане троллей‡Ein Troll unter Trollen‡트롤 중에 트롤‡Un trol entre los trols‡Un trol entre los trols‡Un troll parmi les trolls‡失踪的巨魔‡食人妖中的食人妖',
    nil,
    'Prigmon pediu a você que localize e auxilie o primo dele, Zungam, em algum lugar dentro de Zul\'Aman.‡Найдите Зунгама и помогите ему выбраться из Зул\'Амана.‡Prigmon möchte, dass Ihr seinen Vetter Zungam in Zul\'Aman ausfindig macht und ihm zur Seite steht.‡프리그몬이 줄아만 내부 어딘가에 있는 자신의 사촌, 중암을 찾아서 그를 도와 달라고 했습니다.‡Prigmon necesita que localices a su primo Zungam y le ayudes. Está en algún lugar de Zul\'Aman.‡Prigmon necesita que localices a su primo Zungam y le ayudes. Está en algún lugar de Zul\'Aman.‡Dasnob vous a chargé de trouver son cousin Zungam pour lui venir en aide, quelque part à l\'intérieur de Zul\'Aman.‡普雷蒙希望你深入祖阿曼，找到并帮助他的表兄苏加姆。‡皮格蒙希望你去尋找並且幫助他的表弟祖剛，人應該在祖阿曼中的某處。',
  }
},
[11166] = {
  {
    'O X marca... a sua perdição!‡Крестом на карте обозначена... твоя смерть!‡Das X markiert Euren Untergang!‡X 표시... 당신의 운명!‡La X indica... ¡tu perdición!‡La X indica... ¡tu perdición!‡X marque... votre mort !‡X标记......你的末日！‡X標記…你的末日!',
    nil,
    'Entre em Zul\'Aman e visite a Câmara de Halazzi, a Plataforma de Jan\'alai e a Plataforma de Akil\'zon. Relate suas descobertas para Bino, que está no acampamento dele, na Terra Fantasma.‡Отправляйтесь в Зул\'Аман и посетите чертог Халаззи, платформу Джан\'алая и платформу Акил\'зона. Заметьте все подробности и по возвращении доложите о них Бадду в его лагере в Призрачных землях.‡Betretet Zul\'Aman und erkundet Halazzis Kammer, Jan\'alais Plattform und Akil\'zons Plattform. Berichtet Budd bei seinem Lager in den Geisterlanden von den Details dieser Bereiche.‡줄아만으로 가서 할라지의 거처, 잔알라이의 승강단과 아킬존의 연단을 조사한 후, 세부적인 정보를 습득하여 유령의 땅 야영지에 있는 버드에게 보고해야 합니다.‡Entra en Zul\'Aman y visita la cámara de Halazzi, la plataforma de Jan\'alai y la de Akil\'zon. Informa de lo que veas a Budd, que está en su campamento en las Tierras Fantasma.‡Entra en Zul\'Aman y visita la cámara de Halazzi, la plataforma de Jan\'alai y la de Akil\'zon. Informa de lo que veas a Budd, que está en su campamento en las Tierras Fantasma.‡Entrez dans Zul\'Aman et visitez la Chambre d\'Halazzi, la Plate-forme de Jan\'alai et la Plate-forme d\'Akil\'zon. Rendez compte des détails de ces zones à Budd, dans son camp des Terres fantômes.‡进入祖阿曼并调查哈尔拉兹的大厅、加亚莱的平台和埃基尔松的平台。将这些地方的细节报告给巴德，他的营地就在幽魂之地。‡進入祖阿曼並造訪哈拉齊的房間，賈納雷的平台與阿奇爾森的平台。回報這些地區的細節給霸德，就在鬼魂之地他的營地中。',
  }
},
[11167] = {
  {
    'A nova peste‡Новая чума‡Die neue Seuche‡새로운 역병‡La nueva peste‡La nueva peste‡La Peste nouvelle‡新的药剂‡新種瘟疫',
    nil,
    'O Boticário Lisandro, de Porto Vendeta, quer que você resgate 10 Recipientes de Peste Intactos do navio naufragado a sudeste.‡Аптекарь Лисандер из Лагеря Возмездия просит вас собрать 10 неповрежденных флаконов с чумой с места кораблекрушения на юго-востоке.‡Apotheker Lysander im Hafen der Vergeltung will, dass Ihr 10 unversehrte Behälter aus dem Schiffswrack im Südosten bergt.‡복수의 상륙지에 있는 연금술사 라이샌더가 남동쪽에 있는 난파선에서 온전한 역병 용기 10개를 가져다 달라고 했습니다.‡El boticario Lysander de Campo Venganza quiere que recuperes 10 contenedores de peste intactos de entre los restos del barco al sureste.‡El boticario Lysander de Campo Venganza quiere que recuperes 10 contenedores de peste intactos de entre los restos del barco al sureste.‡L\'Apothicaire Lysander, à l\'Accostage de la Vengeance, vous demande de récupérer 10 Conteneurs de peste intacts dans le navire échoué au sud-est.‡复仇港的药剂师雷杉德尔要求你从东南边的沉船残骸附近回收10个完整的药剂容器。‡復仇臺地的藥劑師黎珊達，要你從東南方的沉船中回收10個完好的瘟疫容器。',
  }
},
[11168] = {
  {
    'É preciso batizar a mistura‡Добавить крепости‡Die Mischung verstärken‡역병 효력 강화‡Una mezcla más fuerte‡Una mezcla más fuerte‡Enrichir le mélange‡强化毒素‡摻入混合物',
    nil,
    'Leve 3 Glândulas Tóxicas Gigantes de Maretiscos Gigantes para o Boticário Lisandro em Porto Vendeta, no Fiorde Uivante.‡Принесите 3 гигантские ядовитые железы гигантских прибрежных крабов аптекарю Лисандеру, который будет ждать вас в Лагере Возмездия в Ревущем фьорде.‡Bringt Apotheker Lysander im Hafen der Vergeltung im Heulenden Fjord 3 riesige Giftdrüsen von riesigen Gezeitenkrabblern.‡거대한 바닷게의 거대한 독 분비선 3개를 울부짖는 협만, 복수의 상륙지에 있는 연금술사 라이샌더에게 가져가야 합니다.‡Llévale 3 glándulas de toxinas gigantes al boticario Lysander, que conseguirás de los reptadores de marea gigantes. El boticario Lysander se encuentra en Campo Venganza, en el Fiordo Aquilonal.‡Llévale 3 glándulas de toxinas gigantes al boticario Lysander, que conseguirás de los reptadores de marea gigantes. El boticario Lysander se encuentra en Campo Venganza, en el Fiordo Aquilonal.‡Remettez 3 Glandes à toxine géantes prélevées sur des Clampants des marées géants à l\'Apothicaire Lysander, à l\'Accostage de la Vengeance, dans le Fjord hurlant.‡从巨型潮行蟹身上获取3个巨型毒腺，把它们交给复仇港的药剂师雷杉德尔。‡從巨型潮行蟹的身上收集3具巨型毒素腺體，交給藥劑師黎珊達，她就在凜風峽灣的復仇臺地上。',
  }
},
[11169] = {
  {
    '[DEPRECATED]The Grimtotem Weapon‡[DEPRECATED]The Grimtotem Weapon‡Die Waffe der Grimmtotem‡[미사용]그림토템 무기‡[DEPRECATED]El arma Tótem Siniestro‡[DEPRECATED]El arma Tótem Siniestro‡[PÉRIMÉ]L\'arme des Totems-sinistres‡[DEPRECATED] 恐怖图腾的武器‡[DEPRECATED]The Grimtotem Weapon',
    nil,
    'O Aprendiz Garion, na Fazenda de Tabetha, quer que você teste o Totem Capturado em 10 Crocoliscos Secâmoros Mosqueados ou Secâmoros Gorjadaga.‡Ученик Гарион из усадьбы Табеты хочет, чтобы вы испытали захваченный тотем на 10 крапчатых кроколисках-грязекупах или грязекупах-острозубах.‡Lehrling Garion bei Tabethas Hof möchte, dass Ihr das erbeutete Totem an 10 scheckigen Staubsuhlerkrokilisken oder Staubsuhlerdolchrachen ausprobiert.‡타베사의 농장에 있는 수습생 가리온이 노획한 토템을 얼룩무늬 늪지악어나 비수송곳니 늪지악어 10마리에게 실험해 보라고 했습니다.‡El aprendiz Garion de la granja de Tabetha quiere que pruebes el tótem capturado con 10 crocoliscos secorrones jaspeados o faucedagas socorrones.‡El aprendiz Garion de la granja de Tabetha quiere que pruebes el tótem capturado con 10 crocoliscos secorrones jaspeados o faucedagas socorrones.‡L\'Apprenti Garion, de la ferme de Tabetha, veut que vous testiez le Totem capturé sur 10 Crocilisques tachetés Sèchefange ou Crocs-lames Sèchefange.‡塔贝萨农场的学徒加里奥希望你在10头尘泥杂斑鳄鱼身上测试被捕获的图腾。‡塔貝薩農場的學徒加利昂希望你對10隻塵泥雜斑鱷魚或塵泥利齒鱷魚測試俘虜圖騰。',
  }
},
[11170] = {
  {
    'Teste no mar‡Испытания на море‡Test auf See‡해상 실험‡Prueba en el mar‡Prueba en el mar‡Essai en mer‡海中测试‡海上測試',
    nil,
    'Fale com a Tratadora de Morcegos Camila e pegue um morcego de montaria para interceptar os reforços da Aliança. Quando passar sobre a frota, use as Ampolas da Peste para contaminar 16 reservistas da Frota Norte.‡Поговорите с дрессировщицей нетопырей Камиллой, возьмите ездового нетопыря и летите наперерез войскам Альянса. Когда вы будете пролетать над флотом, сбросьте склянки с чумой и заразите 16 резервистов Северного флота.‡Sprecht mit Fledermausführerin Kamilla, nehmt eine Reitfledermaus und fangt die Verstärkungstruppen der Allianz ab. Werft die Seuchenphiolen auf 16 Reservisten der Nordflotte, sobald Ihr Euch in Reichweite befindet.‡박쥐 조련사 카미유와 이야기하여 길들인 박쥐를 타고 얼라이언스의 증원군을 도중에서 막아야 합니다. 얼라이언스 함대 위까지 날아간 다음, 역병이 담긴 약병을 사용해 북쪽바다 함대 보충병 16명을 감염시키십시오.‡Habla con la cuidadora de murciélagos Camille y toma un murciélago de montar para interceptar los refuerzos de la Alianza. Una vez sobre sus tropas, utiliza los viales de peste para infectar a 16 reservistas de la Flota Norte.‡Habla con la cuidadora de murciélagos Camille y toma un murciélago de montar para interceptar los refuerzos de la Alianza. Una vez sobre sus tropas, utiliza los viales de peste para infectar a 16 reservistas de la Flota Norte.‡Parlez à l\'Éleveuse de chauves-souris Camille et prenez une chauve-souris pour intercepter les renforts de l\'Alliance. Lorsque vous serez au-dessus de leur flotte, utilisez les Fioles de peste pour contaminer 16 Réservistes de la flotte du nord.‡与蝙蝠管理员卡米蕾交谈，骑乘蝙蝠前去拦截联盟的增援部队。飞到联盟舰队上空时，使用药剂瓶拦截他们并统计16份测试结果。‡和蝙蝠管理員卡蜜兒交談，然後騎上一隻蝙蝠去攔截聯盟的援軍。一旦抵達艦隊上空，使用瘟疫之瓶去感染16個北方艦隊預備兵。',
  }
},
[11171] = {
  {
    'Grão-bagateiro? Ha!‡Повелитель Проклятий? Пффф!‡Hexlord? Pah!‡사술 군주라고? 하!‡¿Señor aojador? ¡Ja!‡¿Señor aojador? ¡Ja!‡Seigneur des maléfices ? Ha !‡妖术领主？哈！‡妖術領主?哈!',
    nil,
    'Bino Cilada, na Serra da Machadinha, quer que você mate o Grão-bagateiro Malacrass, em Zul\'Aman.‡Убейте в Зул\'Амане повелителя проклятий Малакрасса и вернитесь к Бадду Недреку на Холмы Томагавков.‡Budd Winterhäldler in den Axthügeln möchte, dass Ihr Hexlord Malacrass in Zul\'Aman tötet.‡손도끼 언덕에 있는 버드 네드렉이 줄아만에 있는 사술 군주 말라크라스를 처치해 달라고 했습니다.‡Budd Magallenas en Colinas Hacha quiere que vayas a Zul\'Aman y liquides al señor aojador Malacrass.‡Budd Magallenas en Colinas Hacha quiere que vayas a Zul\'Aman y liquides al señor aojador Malacrass.‡Budd Truducou, aux Collines de la Cognée, veut que vous alliez tuer le Seigneur des maléfices Malacrass à Zul\'Aman.‡战斧岭的巴德·奈德雷克要你前往祖阿曼，杀死妖术领主玛拉卡斯。‡戰斧嶺的霸德·奈德瑞克要你殺死祖阿曼中的妖術領主瑪拉克雷斯。',
  }
},
[11172] = {
  {
    '[DEPRECATED]The Zeppelin Crash‡[DEPRECATED]The Zeppelin Crash‡Der Zeppelinabsturz‡[미사용]비행선 추락‡[DEPRECATED]El accidente del zepelín‡[DEPRECATED]El accidente del zepelín‡[PÉRIMÉ]L\'épave du zeppelin‡[DEPRECATED] 坠毁的飞艇‡[DEPRECATED]The Zeppelin Crash',
    nil,
    'Speak with Moxie Steelgrille at Beezil\'s Wreck.‡Поговорите с Мокси Сталегриль на месте крушения дирижабля Бизила.‡Sprecht mit Moxie Stahlgrill bei Beezils Wrack.‡비질의 추락지에 있는 목시 스틸그릴과 대화해야 합니다.‡Habla con Moxie Soplete en el lugar del Siniestro de Beezil.‡Habla con Moxie Soplete en el lugar del Siniestro de Beezil.‡Parler à Moxie Grilledacier à l\'Épave de Beezil.‡与比吉尔的飞艇残骸处的莫希·斯蒂格里谈一谈。‡跟比吉爾的飛艇殘骸的莫克希·鋼格談話。',
  }
},
[11173] = {
  {
    '[DEPRECATED]The Reagent Thief‡[DEPRECATED]The Reagent Thief‡[DEPRECATED] Der Reagenziendieb‡[미사용]약재 도둑‡[DEPRECATED]El ladrón de componentes‡[DEPRECATED]El ladrón de componentes‡[PÉRIMÉ]Le voleur de composants‡[DEPRECATED] 沼泽中的毒药‡[DEPRECATED]The Reagent Thief',
    nil,
    'Leve 6 ampolas de Peçonha do Pântano para o Aprendiz Garion na Fazenda de Tabetha.‡Принесите 6 флаконов болотного яда ученику Гариону в усадьбу Табеты.‡Bringt 6 Phiolen Marschengift zu Lehrling Garion bei Tabethas Hof.‡습지대 독 6병을 타베사의 농장에 있는 수습생 가리온에게 가져가야 합니다.‡Llévale 6 viales de veneno de marisma al aprendiz Garion a la granja de Tabetha.‡Llévale 6 viales de veneno de marisma al aprendiz Garion a la granja de Tabetha.‡Apporter 6 fioles de Venin des marais à l\'Apprenti Garion à la Ferme de Tabetha.‡将6瓶沼泽毒药交给塔贝萨农场的学徒加里奥。‡將6瓶沼澤毒液交給塔貝薩的農場的學徒加利昂。',
  }
},
[11174] = {
  {
    '[DEPRECATED]Corrosion Prevention‡[DEPRECATED]Corrosion Prevention‡Korrosionsschutz‡[미사용]부식 방지‡[DEPRECATED]Prevención contra la corrosión‡[DEPRECATED]Prevención contra la corrosión‡[PÉRIMÉ]Prévention de la corrosion‡[DEPRECATED] 阻止腐蚀‡[DEPRECATED]Corrosion Prevention',
    nil,
    'Moxie Steelgrille wants you to dissolve 10 oozes and report back to her at Beezil\'s Wreck.‡Мокси Сталегриль хочет, чтобы вы уничтожили 10 слизнюков и доложили ей о выполнении задания на месте крушения дирижабля Бизила.‡Moxie Stahlgrill bei Beezils Wrack möchte, dass Ihr 10 Schlamme auflöst.‡비질의 추락지에 있는 목시 스틸그릴이 수액괴물 10마리를 녹여 처치해 달라고 했습니다.‡Moxie Soplete quiere que disuelvas 10 mocos y que vuelvas junto a ella al Siniestro de Beezil.‡Moxie Soplete quiere que disuelvas 10 mocos y que vuelvas junto a ella al Siniestro de Beezil.‡Moxie Grilledacier vous demande de dissoudre 10 limons avant de retourner la voir à l\'Épave de Beezil.‡莫希·斯蒂格里希望你去溶解10只软泥怪，然后回到比吉尔的飞艇残骸旁向她复命。‡莫克希·鋼格要你熔解10個軟泥怪然後回到比吉爾的飛艇殘骸向她回報。',
  }
},
[11175] = {
  {
    'Minha filha‡Дочка моя‡Meine Tochter‡사랑하는 나의 딸‡Mi hija‡Mi hija‡Ma fille‡我的女儿‡我的女兒',
    nil,
    'O Velho Itamanto pediu para você encontrar a filha, Feitora Mariposa Itamanto, no Portão de Aço.‡Старик Каменная Мантия попросил вас найти его дочку, надзирательницу Ирену Каменная Мантия в Стальных воротах.‡Der alte Zasterstein hat Euch gebeten, seine Tochter, die Vorarbeiterin Irena Zasterstein, zu finden. Sie sollte sich am Stählernen Tor befinden.‡노인 스톤맨틀이 강철 관문에서 자신의 딸인 감시자 이레나 스톤맨틀을 찾아달라고 했습니다.‡Viejo Mantopétreo te ha pedido que vayas a buscar a su hija, la sobrestante Irena Mantopétreo, en Las Puertas de Acero.‡Viejo Mantopétreo te ha pedido que vayas a buscar a su hija, la sobrestante Irena Mantopétreo, en Las Puertas de Acero.‡Le Vieux Mantepierre vous a demandé de trouver sa fille, la Surveillante Irena Mantepierre, à la Porte d\'acier du Fjord hurlant.‡前往钢铁之门找到石衣老爹的女儿，工头伊蕾娜·石衣。‡石衣老者請你去尋找他的女兒，監督者艾琳娜·石衣，就在鋼鐵之門。',
  }
},
[11176] = {
  {
    'Para garantir a operação‡Присматривая за работой‡An die Arbeit‡작전 준비‡Supervisa el trabajo‡Supervisa el trabajo‡Allez, au travail !‡工程的进展‡監督運作',
    nil,
    'A Feitora Mariposa Itamanto quer que você fale com um Arqueólogo-chefe do Portão de Aço, no Portão de Aço.‡Надзиратель Ирена Каменная Мантия попросила вас поговорить с главным археологом Стальных ворот.‡Forscherin Irena Zasterstein hat Euch gebeten, mit einem der Chefarchäologen des Stählernen Tores zu sprechen. Diese befinden sich am Stählernen Tor.‡감시자 이레나 스톤맨틀이 강철 관문에 있는 강철 관문 수석고고학자와 대화해 달라고 했습니다.‡La sobrestante Irena Mantopétreo te ha pedido que hables con un arqueólogo jefe de Las Puertas de Acero.‡La sobrestante Irena Mantopétreo te ha pedido que hables con un arqueólogo jefe de Las Puertas de Acero.‡L’exploratrice Irena Mantepierre vous a demandé de parler avec un Chef archéologue de la Porte d’acier, à la Porte d’acier.‡伊蕾娜·石衣要你和钢铁之门的钢铁之门首席考古学家谈一谈。‡探險者艾琳娜·石衣請你前往鋼鐵之門，與鋼鐵之門首席考古學家談談。',
  }
},
[11177] = {
  {
    '[DEPRECATED]The Hermit of Swamplight Manor‡[DEPRECATED]The Hermit of Swamplight Manor‡Der Einsiedler beim Irrlichtanwesen‡[미사용]늪지기 오두막의 은둔자‡[DEPRECATED]El ermitaño de la Mansión Cienaluz‡[DEPRECATED]El ermitaño de la Mansión Cienaluz‡[PÉRIMÉ]L\'ermite du manoir des Flammeroles‡[DEPRECATED] 水光庄园的隐士‡[DEPRECATED]水光莊園的隱士',
    nil,
    'Speak to "Swamp Eye" Jarl at Swamplight Manor.‡Поговорите с Ярлом "Болотным глазом" в сторожке "Болотный огонек".‡Sprecht mit "Sumpfauge" Jarl beim Irrlichtanwesen.‡늪지기 오두막에 있는 "늪지눈알" 자를과 대화해야 합니다.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Parlez à Jarl « Oeil-des-marais » au Manoir des Flammeroles.‡与水光庄园的"沼泽之眼"加尔谈一谈。‡跟水光莊園的『沼澤之眼』加爾談話。',
  }
},
[11178] = {
  {
    'Sangue do senhor da guerra‡Кровь Вождя‡Blut des Kriegsherren‡대장군의 피‡Sangre del señor de la guerra‡Sangre del señor de la guerra‡Le sang du seigneur de guerre‡督军之血‡督軍之血',
    nil,
    'Leve o Sangue de Zul\'jin para Bino, no acampamento dele, que fica perto de Zul\'Aman, na Terra Fantasma.‡Принесите кровь Зул\'джина Бадду в его лагерь в Призрачных Землях. За пределами Зул\'Амана.‡Bringt Zul\'jins Blut zu Budd bei seinem Lager in den Geisterlanden, direkt außerhalb von Zul\'Aman.‡줄아만 밖, 유령의 땅에 있는 야영지에서 버드를 만나 줄진의 피를 전해야 합니다.‡Lleva la sangre de Zul\'jin a Budd en su campamento de las Tierras Fantasma, a las afueras de Zul\'Aman.‡Lleva la sangre de Zul\'jin a Budd en su campamento de las Tierras Fantasma, a las afueras de Zul\'Aman.‡Apportez le Sang de Zul\'jin à Budd à son campement dans les Terres fantômes, à l\'extérieur de Zul\'Aman.‡把祖尔金之血交给祖阿曼外面幽魂之地的巴德。‡將祖爾金之血交給霸德，他的營地位在鬼魂之地的祖阿曼外頭。',
  }
},
[11179] = {
  {
    '‡‡Finlay ist darmlos‡‡‡‡‡‡',
    nil,
    '‡‡Sammelt 7 Stück makellosen Schattensäblerkatzendarm und kehrt zu Finlay Pfeilmacher zurück. Er befindet sich in Westwacht.‡‡‡‡‡‡',
  }
},
[11180] = {
  {
    'What\'s Haunting Witch Hill?‡Что таится на Ведьмином холме?‡Was sucht den Hexenhügel heim?‡마녀 언덕에 나타나는 존재는?‡¿Quién atormenta la Colina de las Brujas?‡¿Quién atormenta la Colina de las Brujas?‡Qui hante la Colline des sorcières ?‡女巫岭的幽灵‡是什麼在女巫嶺作祟?',
    nil,
    'Mordente Tenúbrio, no Casarão do Pantanal Iluminado, quer que você consiga informações de 10 Carcaças Moventes ou Espíritos Revividos.‡Моргант Мрачник из сторожки "Болотный огонек" хочет, чтобы вы добыли информацию у 10 восставших мертвецов или духов.‡Mordant Grimsby beim Irrlichtanwesen möchte, dass Ihr Informationen von 10 auferstandenen Gebeinen oder auferstandenen Geistern sammelt.‡모던트 그림스비가 되살아난 허울과 되살아난 영혼 10구에게서 정보를 알아오라고 했습니다.‡Mordant Navarro, de la Mansión Cienaluz, quiere que consigas información de 10 cáscaras resucitadas o espíritus resucitados.‡Mordant Navarro, de la Mansión Cienaluz, quiere que consigas información de 10 cáscaras resucitadas o espíritus resucitados.‡Mordant Grimsby du manoir des Flammeroles vous demande de collecter des informations auprès de 10 Carcasses ressuscitées ou Esprits ressuscités.‡水光庄园的摩丹特·格雷斯比希望你能从10个复活的躯壳或复活的游魂身上收集到信息。‡水光莊園的莫丹特·格林思比希望你從10個復活之軀或復活之靈身上獲得情報。',
  }
},
[11181] = {
  {
    '‡Ведьмина погибель‡Der Hexenfluch‡마녀독풀‡La ruina de las brujas‡La ruina de las brujas‡La plaie de la sorcière‡除巫草‡',
    nil,
    '‡Принесите 9 ростков ведьминой погибели Морганту Мрачнику в сторожку "Болотный огонек".‡Bringt 9 Zweige Hexenfluch zu Mordant Grimsby beim Irrlichtanwesen.‡‡Lleva 9 ramitas de Ruinabruja a Mordant Navarro a la Mansión Cienaluz.‡Lleva 9 ramitas de Ruinabruja a Mordant Navarro a la Mansión Cienaluz.‡Apporter 9 branches de Sorbier à Mordant Grimsby au Manoir des Flammeroles.‡将9根除巫草交给水光庄园的摩丹特·格雷斯比。‡',
  }
},
[11182] = {
  {
    'Causas-raiz‡В поисках первопричины‡Ursachen‡악의 근원‡Causas fundamentales‡Causas fundamentales‡Aux racines du mal‡问题的根源‡根本原因',
    nil,
    'Mate 5 Tratadores Esfola-dragão e Skeld Dracson. Caso consiga, fale com um Anciente do Ninho Incandescente, no Ninho Incandescente.‡Убить 5 укротителей из клана Укротителей драконов и Скелда Сына Дракона. Если вам удастся выполнить это задание, вернитесь к древу Пылающего Гнездовья.‡Tötet 5 Tierführer der Drachenschinder und Skeld Drachensohn. Geht in die Glutstätte und sucht ein Urtum der Glutstätte auf, falls Ihr das schaffen solltet.‡용약탈 조련사 5명과 스켈드 드레이크슨을 제거하고 잿불의 손아귀에 있는 잿불의 손아귀 고대정령에게 가야 합니다.‡Asesina a 5 cuidadores Desuelladragones y a Skeld Dracónez. Si lo logras, preséntate ante un ancestro de Encierro Ámbar en Encierro Ámbar.‡Asesina a 5 cuidadores Desuelladragones y a Skeld Dracónez. Si lo logras, preséntate ante un ancestro de Encierro Ámbar en Encierro Ámbar.‡Tuez 5 Dresseurs vrykuls et Skeld Fils-de-drake ; Si vous y parvenez, retournez voir un Ancien de l\'Étreinte de braise.‡杀死斯克尔德·达拉克森和5名掠龙训练者，完成任务后向灰烬龙巢中的灰烬龙巢古树复命。‡殺死5名掠龍管理員和史克德·龍裔。等你完成之後，向餘燼窩巢的餘燼窩巢古樹回報。',
  }
},
[11183] = {
  {
    'Cleansing Witch Hill‡Очищение Ведьминого холма‡Die Reinigung des Hexenhügels‡마녀 언덕 정화‡Limpiar la Colina de las Brujas‡Limpiar la Colina de las Brujas‡Nettoyer la Colline des sorcières‡净化女巫岭‡淨化女巫嶺',
    nil,
    'Mordente Tenúbrio, no Casarão do Pantanal Iluminado, quer que você finque a tocha no fim do píer e derrote tudo o que aparecer.‡Моргант Мрачник из сторожки "Болотный огонек" хочет, чтобы вы установили факел в конце дока и сразились с тем, что выйдет на свет.‡Mordant Grimsby beim Irrlichtanwesen möchte, dass Ihr die Fackel am Ende des Docks aufstellt und alles bezwingt, was daraufhin erscheint.‡늪지기 오두막에 있는 모던트 그림스비가 부두 끝에 횃불을 세우고 무언가 나타나면 물리쳐달라고 했습니다.‡Mordant Navarro en la Mansión Cienaluz quiere que plantes la antorcha al final del muelle y venzas a todo lo que aparezca.‡Mordant Navarro en la Mansión Cienaluz quiere que plantes la antorcha al final del muelle y venzas a todo lo que aparezca.‡Mordant Grimsby au Manoir des Flammeroles veut que vous plantiez la torche au bout du quai et que vous abattiez tout ce qui pourrait apparaître.‡水光庄园的摩丹特·格雷斯比希望你将火把放置在码头的尽头，并打败随后出现的任何东西。‡水光莊園的莫丹特·格林思比希望你把火炬放在碼頭的盡頭，並且擊敗任何出現的東西。',
  }
},
[11184] = {
  {
    '[DEPRECATED]WANTED: Goreclaw the Ravenous‡[DEPRECATED]WANTED: Goreclaw the Ravenous‡GESUCHT: Schlächterklaue der Gefräßige‡[미사용]현상 수배: 포악한 피발톱‡[DEPRECATED]SE BUSCA: Garrasangrienta el Voraz‡[DEPRECATED]SE BUSCA: Garrasangrienta el Voraz‡[PÉRIMÉ]ON RECHERCHE : Griffétripe le Vorace‡[DEPRECATED] 悬赏：贪婪的血爪‡[DEPRECATED]WANTED: Goreclaw the Ravenous',
    nil,
    'Kill Goreclaw the Ravenous and report to Drazzit Dripvalve at Mudsprocket.‡Уничтожьте Кровокогтя Ненасытного и сообщите об этом Драззиту Кранотеку, который находится в Шестермути.‡Tötet Schlächterklaue den Gefräßigen und meldet Euch anschließend bei Drazzit Tropfhahn in Morastwinkel.‡포악한 피발톱을 처치하고 진흙톱니 거점에 있는 드라짓 드립밸브에게 보고해야 합니다.‡Mata a Garrasangrienta el Voraz y preséntate ante Drazzit Gotera en Piñón de Barro.‡Mata a Garrasangrienta el Voraz y preséntate ante Drazzit Gotera en Piñón de Barro.‡Tuer Griffétripe le Vorace et se présenter à Drazzit Suintevalve à Bourbe-à-brac.‡杀死贪婪的血爪，然后向泥链镇的德拉兹特·迪普瓦尔复命。‡殺死貪婪的血爪並且向泥鏈營地的德拉席特·滴栓回報。',
  }
},
[11185] = {
  {
    '‡‡Brief der Apothekerin‡[미사용]연금술사의 편지‡[DEPRECATED]La carta de la boticaria‡‡[PÉRIMÉ]La lettre de l\'apothicaire‡[DEPRECATED] 药剂师的信‡',
    nil,
    '‡Отнесите запечатанное письмо привратнику Анделло в усадьбу Табеты.‡Bringt den versiegelten Brief zu Andello Porter auf Tabethas Hof.‡‡Lleva la carta lacrada a Andello Porter a la Granja de Tabetha.‡Lleva la carta lacrada a Andello Porter a la Granja de Tabetha.‡Apportez la Lettre scellée à Andello Porter à la Ferme de Tabetha.‡‡',
  }
},
[11186] = {
  {
    '‡‡Zeichen des Verrats?‡‡[DEPRECATED]¿Signos de traición?‡‡[PÉRIMÉ]Des signes de trahison ?‡‡',
    nil,
    '‡Доставьте запечатанное письмо Назиру Кровавому Копью в Деревню Гиблотопь.‡Bringt den versiegelten Brief zu Nazeer Blutlanze in Brackenwall.‡‡Lleva la carta lacrada a Nazeer Picasangre al Poblado Murohelecho.‡Lleva la carta lacrada a Nazeer Picasangre al Poblado Murohelecho.‡Apportez la Lettre scellée à Nazeer Pique-sanglante à Mur-de-Fougères.‡‡',
  }
},
[11187] = {
  {
    'Mago-tenente Malister‡Маг-лейтенант Малистер‡Magierleutnant Malister‡마법사 부관 말리스터‡Teniente mago Malister‡Teniente mago Malister‡Le lieutenant-mage Malister‡法师中尉玛利斯特‡法師中尉瑪歷斯特',
    nil,
    'O Capitão Carneiro quer que você fale com o Mago-tenente Malister, que é conselheiro dele, na Bastilha da Guarda Oeste.‡Капитан Адамс попросил вас поговорить с его советником, магом-лейтенаном Малистером. Его можно найти в Крепости Западной Стражи.‡Hauptmann Adams möchte, dass Ihr mit seinem Berater Magierleutnant Malister sprecht. Er befindet sich in Westwacht.‡경비대장 아담스가 서부경비대 성채에서 그의 조언자인 마법사 부관 말리스터와 대화해 달라고 했습니다.‡El capitán Adams te ha pedido que hables con su consejero, el teniente mago Malister, que se encuentra en la Fortaleza de la Guardia Oeste.‡El capitán Adams te ha pedido que hables con su consejero, el teniente mago Malister, que se encuentra en la Fortaleza de la Guardia Oeste.‡Le Capitaine Adams vous a demandé de parler à son conseiller, le Lieutenant-mage Malister, au Donjon de la Garde de l\'ouest.‡亚当斯上尉要你与法师中尉玛利斯特谈一谈，他就在西部卫戍要塞中。‡亞當斯隊長要你去和他的顧問，法師中尉瑪歷斯特談談，他就在鎮西要塞。',
  }
},
[11188] = {
  {
    'Dois erros não fazem um...‡Минус на минус‡Zwei Untaten...‡두 가지 잘못‡Dos errores...‡Dos errores...‡Deux torts…‡一错再错……‡兩個錯誤…',
    nil,
    'O Mago-tenente Malister, da Bastilha da Guarda Oeste, quer que você destrua 3 Protodracos.‡Маг-лейтенант Малистер из Крепости Западной Стражи поручил вам уничтожить 3 протодраконов.‡Magierleutnant Malister in Westwacht hat Euch damit beauftragt, 3 Protodrachen zu vernichten.‡서부경비대 성채에 있는 마법사 부관 말리스터가 원시비룡 3마리를 처치해 달라고 했습니다.‡El teniente mago Malister en la Fortaleza de la Guardia Oeste te ha encomendado la tarea de destruir a 3 protodracos.‡El teniente mago Malister en la Fortaleza de la Guardia Oeste te ha encomendado la tarea de destruir a 3 protodracos.‡Le Lieutenant-mage Malister, du donjon de la Garde de l\'ouest, vous a demandé de détruire 3 Proto-drakes.‡西部卫戍要塞的法师中尉玛利斯特要你杀死3只始祖幼龙。‡鎮西要塞的法師中尉瑪歷斯特交代你摧毀3隻元龍。',
  }
},
[11189] = {
  {
    '‡В последний раз‡Ein letztes Mal‡마지막 인사‡Una última vez‡Una última vez‡Une dernière fois‡‡',
    nil,
    '‡Сопроводите привидение исследователя Джарена к надзирательнице Ирене Каменная Мантия в Стальные ворота Ревущего фьорда.‡Eskortiert den Geist von Entdecker Jaren sicher zu Irena Zasterstein. Sie befindet sich am Stählernen Tor im Heulenden Fjord.‡탐험가 야렌의 유령을 울부짖는 협만의 강철 관문에 있는 감시자 이레나 스톤맨틀에게 무사히 데려가야 합니다.‡Escolta al fantasma de expedicionario Jaren hasta llegar junto a la expedicionaria Irena Mantopétreo en Las Puertas de Acero, en el Fiordo Aquilonal.‡Escolta al fantasma de expedicionario Jaren hasta llegar junto a la expedicionaria Irena Mantopétreo en Las Puertas de Acero, en el Fiordo Aquilonal.‡Escortez le Fantôme de l\'Explorateur Jaren à l\'Exploratrice Irena Mantepierre, à la Porte d\'acier du Fjord Hurlant.‡‡',
  }
},
[11190] = {
  {
    'Não é tamanho único‡К каждой пушке затычка‡Nicht allen passt dieselbe Größe‡규격 문제‡El tamaño sí importa‡El tamaño sí importa‡Ce modèle n\'existe pas en taille unique !‡非标准炮弹‡一個尺寸可不是全部適用',
    nil,
    'O Canhoneiro Ely incumbiu você de juntar 10 Bolas de Canhão da Guarda Oeste e depois entregá-las a ele, na Bastilha da Guarda Oeste.‡Канонир Эли поручил вам собрать 10 пушечных ядер и отнести их в Крепость Западной Стражи.‡Kanonier Ely hat Euch damit beauftragt, 10 Kanonenkugeln der Westwacht einzusammeln und sie zu ihm zurückzubringen. Er befindet sich in Westwacht.‡서부경비대 성채에 있는 포병 엘리가 서부경비대 포탄 10개를 회수해 달라고 했습니다.‡El cañonero Ely te ha pedido que recojas 10 bolas de cañón de la Guardia Oeste y que se las lleves a la Fortaleza de la Guardia Oeste.‡El cañonero Ely te ha pedido que recojas 10 bolas de cañón de la Guardia Oeste y que se las lleves a la Fortaleza de la Guardia Oeste.‡Le Canonnier Ely veut que vous récupériez 10 Boulets de canons de la Garde de l’ouest et que vous les lui remettiez, au donjon de la Garde de l’ouest.‡收集10颗西部卫戍要塞炮弹，将它们交给西部卫戍要塞的炮兵伊莱。‡砲手伊利要你收集10顆鎮西砲彈，然後回到鎮西要塞交給他。',
  }
},
[11191] = {
  {
    '[DEPRECATED]This Old Lighthouse‡[DEPRECATED]This Old Lighthouse‡Der alte Leuchtturm‡[미사용]오래된 등대‡[DEPRECATED]Este viejo faro‡[DEPRECATED]Este viejo faro‡[PÉRIMÉ]Le vieux phare‡[DEPRECATED] 破旧的灯塔‡[DEPRECATED]廢棄的燈塔',
    nil,
    'Speak to Babs Fizzletorque at the lighthouse on the island east of Theramore.‡Поговорите с Бабс Шипокруткой на маяке на острове к востоку от Терамора.‡Sprecht mit Babs Zischeldrill bei dem Leuchtturm auf der Insel östlich von Theramore.‡테라모어의 동쪽 섬에 있는 등대로 가서 밥스 피즐톨크와 대화해야 합니다.‡Habla con Babs Dinamométrica en el faro de la isla al este de Theramore.‡Habla con Babs Dinamométrica en el faro de la isla al este de Theramore.‡Parler à Babs Patranivelle au phare sur l\'île à l\'est de Theramore.‡与塞拉摩东边岛上灯塔里的巴布·菲兹托克谈一谈。‡跟塞拉摩東邊島上燈塔的鮑伯斯·嘶鍊談話。',
  }
},
[11192] = {
  {
    '[DEPRECATED]Thresher Oil‡[DEPRECATED]Thresher Oil‡[DEPRECATED] Drescheröl‡[미사용]트레샤돈 기름‡[DEPRECATED]Aceite de trillador‡[DEPRECATED]Aceite de trillador‡[PÉRIMÉ]L\'huile de batteur‡[DEPRECATED] 蛇颈鱼油‡[DEPRECATED]蛇頸龍油',
    nil,
    'Leve 4 volumes de Óleo de Mangual para Dani Torqueimado no farol, perto de Theramore.‡Принесите 4 контейнера жира крепкозуба Бабс Шипокрутке на маяк близ Терамора.‡Bringt 4 Behälter mit Drescheröl zu Babs Zischeldrill beim Leuchtturm in der Nähe von Theramore.‡테라모어 근처의 등대에 있는 밥스 피즐톨크에게 트레샤돈 기름 4통을 가져가야 합니다.‡Lleva 4 contenedores de aceite de trillador a Babs Dinamométrica al faro cerca de Theramore.‡Lleva 4 contenedores de aceite de trillador a Babs Dinamométrica al faro cerca de Theramore.‡Apportez 4 récipients d\'Huile de batteur à Babs Patranivelle au phare près de Theramore.‡将4瓶蛇颈龙油交给塞拉摩附近灯塔的巴布·菲兹托克。‡將4罐蛇頸龍油交給塞拉摩附近燈塔內的鮑伯斯·嘶鍊。',
  }
},
[11193] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED] 深海中的卑鄙生物‡',
    nil,
    '‡‡‡‡‡‡‡将《深海中的卑鄙生物》交给塞拉摩码头上的"脏鬼"迈克尔·克罗维。‡',
  }
},
[11194] = {
  {
    '[DEPRECATED]Is it Real?‡[DEPRECATED]Is it Real?‡Ist das wahr?‡[미사용]진실 혹은 거짓?‡[DEPRECATED]¿Es real?‡[DEPRECATED]¿Es real?‡[PÉRIMÉ]Il existe ?‡[DEPRECATED] 这是真的吗？‡[DEPRECATED]這會是真的嗎?',
    nil,
    'Talk to Nat Pagle at Nat\'s Landing in Dustwallow Marsh.‡Поговорите с Натом Пэглом в лагере Ната, что в Пылевых топях.‡Sprecht mit Nat Pagle bei Nats Angelplatz in den Düstermarschen.‡먼지진흙 습지대의 내트의 정박지에 있는 내트 페이글과 대화해야 합니다.‡Habla con Nat Pagle en el Embarcadero de Nat, en Marjal Revolcafango.‡Habla con Nat Pagle en el Embarcadero de Nat, en Marjal Revolcafango.‡Parlez à Nat Pagle au Point d’accostage de Nat, au Marécage d\'Âprefange.‡前往狂潮湾的纳特的码头，与纳特·帕格谈一谈。‡到塵泥沼澤的納特的平臺與納特·帕格談話。',
  }
},
[11195] = {
  {
    'Brincando de casinha‡Игра в куклы‡Das Spiel mit der Puppe‡누더기 부두 인형‡Jugando con muñecas‡Jugando con muñecas‡Jouer à la poupée‡破烂的巫毒人偶‡玩娃娃',
    nil,
    'Leve a Boneca Vodu Esfarrapada para Trambik em Shattrath.‡Отнесите потрепанную куклу вуду Жулю в Шаттрат.‡Bringt die zerlumpte Voodoopuppe zu Gaunah in Shattrath.‡샤트라스에 있는 그립타에게 누더기 부두 인형을 가져가야 합니다.‡Lleva el muñeco de vudú hecho jirones a Griftah en la Ciudad de Shattrath.‡Lleva el muñeco de vudú hecho jirones a Griftah en la Ciudad de Shattrath.‡Apportez la Poupée vaudou en lambeaux à Eskrokar à Shattrath.‡将破烂的巫毒人偶交给沙塔斯城的格里伏塔。‡把破爛的巫毒娃娃帶給撒塔斯城的格利夫塔。',
  }
},
[11196] = {
  {
    '‡Вождь Амани‡Der Kriegsherr der Amani‡아마니의 장군‡Señor de la guerra de los Amani‡‡Le seigneur de guerre des Amani‡阿曼尼督军‡',
    nil,
    '‡Победите нового вождя племени Амани, Даакару.‡‡‡‡‡‡‡',
  }
},
[11198] = {
  {
    '[DEPRECATED]Take Down Tethyr!‡[DEPRECATED]Take Down Tethyr!‡[DEPRECATED] Bezwingt Tethyr!‡[미사용]테시르 사냥!‡[DEPRECATED]¡Elimina a Tethyr!‡[DEPRECATED]¡Elimina a Tethyr!‡[PÉRIMÉ]Il faut tuer Tethyr !‡[DEPRECATED] 击败泰瑟尔！‡[DEPRECATED]打倒泰瑟爾!',
    nil,
    'O Major Moendas, das docas de Theramore, quer que você derrote o Tethyr.‡Майор Миллз из доков Терамора хочет, чтобы вы покончили с Тетуром.‡Major Mühlens bei den Docks von Theramore möchte, dass Ihr Tethyr bezwingt.‡테라모어 부두에 있는 상사 밀스가 테시르를 물리쳐 달라고 했습니다.‡El mayor Molina en los muelles de Theramore quiere que derrotes a Tethyr.‡El mayor Molina en los muelles de Theramore quiere que derrotes a Tethyr.‡Le Major Mills aux Docks de Theramore veut que vous abattiez Tethyr.‡塞拉摩码头的米尔斯少校希望你打败泰瑟尔。‡泰拉摩碼頭的米爾斯少校要你打敗泰瑟爾。',
  }
},
[11199] = {
  {
    'Apresente-se ao batedor Knowles‡Доклад разведчика Ноулса‡Meldung bei Kundschafter Wisslich‡정찰병 노울스에게 보고‡Informa al Explorador Knowles‡Informa al Explorador Knowles‡Se présenter à l\'éclaireur Knowles‡向斥候诺勒斯报到‡向斥候諾雷斯回報',
    nil,
    'O Capitão Carneiro quer que você se apresente ao Batedor Knowles na Torre da Lança Incandescente.‡Капитан Адамс попросил вас разыскать разведчика Ноулса у Тлеющей башни.‡Hauptmann Adams möchte, dass Ihr Euch bei Kundschafter Wisslich am Glutspeerturm meldet.‡경비대장 아담스가 잿불창 경비탑에 있는 정찰병 노울스에게 보고해 달라고 했습니다.‡El capitán Adams te ha pedido que te presentes ante el explorador Knowles en la Torre Lanza Ámbar.‡El capitán Adams te ha pedido que te presentes ante el explorador Knowles en la Torre Lanza Ámbar.‡Le capitaine Adams vous a demandé de vous présenter à l\'Éclaireur Knowles, à la Tour de la Lance de braise.‡亚当斯上尉要你前往灰烬长矛塔楼，向斥候诺勒斯报到。‡亞當斯隊長要求你向餘燼矛塔的斥候諾雷斯回報。',
  }
},
[11202] = {
  {
    'Missão: chama eterna‡Задание: вечный огонь‡Mission \'Ewige Flamme\'‡임무: 영원의 불꽃‡Misión: Llama eterna‡Misión: Llama eterna‡Mission : la flamme éternelle‡任务：永恒的烈焰‡任務:永燃之焰',
    nil,
    'O Batedor Knowles, da Torre da Lança Incandescente, aconselhou você a usar as Tochas Inextinguíveis para destruir os quatro Tanques Pestilentos dos arredores de Halgrind.‡Разведчик Ноулс посоветовал вам воспользоваться неугасимыми факелами, чтобы уничтожить четыре контейнера с чумой, окружающих Халгринд.‡Kundschafter Wisslich im Glutspeerturm hat vorgeschlagen, dass Ihr mithilfe der Immerbrandfackeln die 4 Pestkessel um Halgrind herum zerstört.‡잿불창 경비탑에 있는 정찰병 노울스가 영원히 타오르는 횃불을 사용하여 할그린드 주변의 역병 수조 4개를 파괴해 달라고 했습니다.‡El explorador Knowles en la Torre Lanza Ámbar te ha recomendado que utilices las antorchas siempreardientes para destruir los cuatro tanques de peste alrededor de Haltorboll.‡El explorador Knowles en la Torre Lanza Ámbar te ha recomendado que utilices las antorchas siempreardientes para destruir los cuatro tanques de peste alrededor de Haltorboll.‡L’Éclaireur Knowles, de la Tour de la Lance de braise, souhaite que vous utilisiez les Torches semperardentes pour détruire les quatre Chars de peste qui entourent Halegrince.‡灰烬长矛塔楼的斥候诺勒斯要你利用永燃火炬摧毁哈尔格林德附近的4只药剂罐。‡餘燼矛塔的斥候諾雷斯，要你使用永燃火炬摧毀霍葛萊周圍的四個瘟疫槽。',
  }
},
[11204] = {
  {
    '‡‡‡‡‡‡‡‡[DEPRECATED]Return to Krog',
    nil,
    '‡‡‡‡‡‡‡‡跟蕨牆村的克羅格談話。',
  }
},
[11205] = {
  {
    '[DEPRECATED]Raze Direhorn Post!‡[DEPRECATED]Raze Direhorn Post!‡Brennt den Grollhornposten nieder!‡[미사용]공포뿔 거점을 파괴하라!‡[DEPRECATED]¡Arrasa el Puesto Cuernoatroz!‡[DEPRECATED]¡Arrasa el Puesto Cuernoatroz!‡[PÉRIMÉ]Rasez le poste de Navrecorne !‡[DEPRECATED] 烧毁恐角岗哨！‡[DEPRECATED]Raze Direhorn Post!',
    nil,
    'Queime a Tenda Norte, a Tenda Leste e a Tenda Nordeste no Posto Chifrebravo, e depois fale novamente com Tabetha na fazenda.‡Сожгите северный, восточный и северо-западный шатры на заставе Дикого Рога, затем вернитесь в усадьбу Табеты.‡Brennt das nördliche, östliche und nordöstliche Zelt beim Grollhornposten nieder und kehrt anschließend zu Tabetha auf ihrem Hof zurück.‡공포뿔 거점에 있는 북쪽 막사, 동쪽 막사, 북동쪽 막사를 불태우고 농장에 있는 타베사에게 가야 합니다.‡Quema la tienda norte, la tienda este y la tienda noreste en el Puesto Cuernoatroz, después vuelve a ver a Tabetha a su granja.‡Quema la tienda norte, la tienda este y la tienda noreste en el Puesto Cuernoatroz, después vuelve a ver a Tabetha a su granja.‡Brûlez la Tente nord, la Tente est et la Tente nord-est du Poste de Navrecorne, puis revenez voir Tabetha dans sa ferme.‡烧毁恐角岗哨的北部帐篷、东部帐篷和东北部帐篷，然后回到塔贝萨的农场，向塔贝萨复命。‡把恐角崗哨的北方帳篷、東方帳篷和東北方帳篷燒毀，然後回到塔貝薩的農場向她回報。',
  }
},
[11206] = {
  {
    '[DEPRECATED]Justice Dispensed‡[DEPRECATED]Justice Dispensed‡Das Walten der Gerechtigkeit‡[미사용]정의 실현‡[DEPRECATED]Justicia administrada‡[DEPRECATED]Justicia administrada‡[PÉRIMÉ]Justice est faite !‡[DEPRECATED] 伸张正义‡[DEPRECATED]Justice Dispensed',
    nil,
    'Return to Krog at Brackenwall Village.‡Вернитесь к Крогу в деревню Гиблотопь.‡Kehrt zu Krog in Brackenwall zurück.‡담쟁이 마을에 있는 크로그에게 가야 합니다.‡Vuelve junto a Krog en el Poblado Murohelecho.‡Vuelve junto a Krog en el Poblado Murohelecho.‡Retourner voir Krog au village de Mur-de-Fougères.‡回到蕨墙村的克罗格那里复命。‡回到蕨牆村找克羅格。',
  }
},
[11207] = {
  {
    '[DEPRECATED]Secure the Cargo!‡[DEPRECATED]Secure the Cargo!‡Bergt die Fracht!‡[미사용]화물을 확보하라!‡[DEPRECATED]¡Asegura el cargamento!‡[DEPRECATED]¡Asegura el cargamento!‡[PÉRIMÉ]Sauvez la cargaison !‡[DEPRECATED] 回收货物！‡[DEPRECATED]Secure the Cargo!',
    nil,
    'Moxie Steelgrille at Beezil\'s Wreck wants you to recover 8 pieces of Zeppelin Cargo.‡Мокси Сталегриль попросила вас собрать 8 контейнеров груза с дирижабля и принести ей на место крушения Бизиля.‡Moxie Stahlgrill bei Beezils Wrack möchte, dass Ihr 8 Teile der Zeppelinfracht bergt.‡비질의 추락지에 있는 목시 스틸그릴이 비행선 화물 8개를 가져다 달라고 했습니다.‡Moxie Soplete en el Siniestro de Beezil quiere que recuperes 8 trozos de cargamento del zepelín.‡Moxie Soplete en el Siniestro de Beezil quiere que recuperes 8 trozos de cargamento del zepelín.‡Moxie Grilledacier à l\'Épave de Beezil veut que vous retrouviez 8 morceaux de Cargaison de zeppelin.‡比吉尔的飞艇残骸处的莫希·斯蒂格里要你找回8件飞艇上的货物。‡比吉爾的飛艇殘骸的莫克希·鋼格要你取得8個飛艇貨物。',
  }
},
[11208] = {
  {
    'Uma entrega para Drazzit‡Поставка для Драззита‡Lieferung für Drazzit‡드라짓에게 전달‡Envío para Drazzit‡Envío para Drazzit‡Une livraison pour Drazzit‡给德拉兹特的货物‡替德拉席特送貨',
    nil,
    'Leve a Carga do Zepelim para Drazzit Pingajunta em Coroa de Barro.‡Доставьте груз с дирижабля Драззиту Кранотеку в Шестермуть.‡Bringt die Zeppelinfracht zu Drazzit Tropfhahn in Morastwinkel.‡진흙톱니 거점에 있는 드라짓 드립밸브에게 비행선 화물을 가져가야 합니다.‡Lleva el cargamento del zepelín a Drazzit Gotera a Piñón de Barro.‡Lleva el cargamento del zepelín a Drazzit Gotera a Piñón de Barro.‡Remettre la Cargaison du zeppelin à Drazzit Suintevalve à Bourbe-à-brac.‡把飞艇上的货物交给泥链镇的德拉兹特·迪普瓦尔。‡把飛艇貨物交給泥鏈營地的德拉席特·滴栓。',
  }
},
[11209] = {
  {
    '[DEPRECATED]Nat\'s Bargain‡[DEPRECATED]Nat\'s Bargain‡Nats Abmachung‡[미사용]내트의 제안‡[DEPRECATED]El trato de Nat‡[DEPRECATED]El trato de Nat‡[PÉRIMÉ]Le marché de Nat‡[DEPRECATED] 纳特的交易‡[DEPRECATED]納特的討價還價',
    nil,
    'Nat Pagle, do Píer do Nat, quer que você teste a nova isca de pesca dele.‡Нат Пэгл из лагеря Ната хочет, чтобы вы испытали его новую наживку для рыбы.‡Nat Pagle bei Nats Angelplatz möchte, dass Ihr seinen neuen Köder ausprobiert.‡내트의 정박지에 있는 내트 페이글이 미끼를 시험해 달라고 했습니다.‡Nat Pagle en el Embarcadero de Nat quiere que pruebes su nuevo cebo para pescar.‡Nat Pagle en el Embarcadero de Nat quiere que pruebes su nuevo cebo para pescar.‡Nat Pagle, au Point d\'accostage de Nat, vous demande de tester son nouvel appât à poissons.‡纳特的码头上的纳特·帕格想让你去测试一下他的新鱼饵。‡納特平台的納特·帕格要你去測試他的新魚餌。',
  }
},
[11210] = {
  {
    '[DEPRECATED]Oh, It\'s Real‡[DEPRECATED]Oh, It\'s Real‡Oh, es ist wahr!‡[미사용]진실!‡[DEPRECATED]Oh, es real‡[DEPRECATED]Oh, es real‡[PÉRIMÉ]Il existe !‡[DEPRECATED] 果然是真的‡[DEPRECATED]噢，這是真的',
    nil,
    'Speak with Major Mills at the docks in Theramore.‡Поговорите с майором Миллзом в доках Терамора.‡Sprecht mit Major Mühlens bei den Docks von Theramore.‡테라모어 부두의 상사 밀스와 대화해야 합니다.‡Habla con el mayor Molina en los muelles de Theramore.‡Habla con el mayor Molina en los muelles de Theramore.‡Parler au Major Mills sur les quais de Theramore.‡与塞拉摩港口的米尔斯少校谈一谈。‡和塞拉摩碼頭的米爾斯少校談談。',
  }
},
[11211] = {
  {
    'Socorro à Coroa de Barro‡Помощь деревне Шестермуть‡Hilfe für Morastwinkel‡진흙톱니 거점 지원‡Ayuda para Piñón de Barro‡Ayuda para Piñón de Barro‡De l\'aide pour Bourbe-à-brac‡帮助泥链镇‡幫助泥鏈營地',
    nil,
    'Fale com Drazzit Pingajunta em Coroa de Barro.‡Поговорите с Драззитом Кранотеком в Шестермути.‡Sprecht mit Drazzit Tropfhahn in Morastwinkel.‡진흙톱니 거점에 있는 드라짓 드립밸브와 대화해야 합니다.‡Habla con Drazzit Gotera en Piñón de Barro.‡Habla con Drazzit Gotera en Piñón de Barro.‡Parler à Drazzit Suintevalve à Bourbe-à-brac.‡与泥链镇的德拉兹特·迪普瓦尔谈一谈。‡跟泥鏈營地的德拉席特·滴栓談話。',
  }
},
[11212] = {
  {
    'A fazenda de Tabetha‡Ферма Табеты‡Tabethas Hof‡타베사의 농장‡La granja de Tabetha‡La granja de Tabetha‡La ferme de Tabetha‡塔贝萨的农庄‡塔貝薩的農場',
    nil,
    'Fale com Tabetha em sua fazenda no Atoleiro.‡Поговорите с Табетой в ее доме на Трясине.‡Sprecht mit Tabetha auf ihrem Hof im Morast.‡먼지 수렁에 있는 농장에 있는 타베사와 대화해야 합니다.‡Habla con Tabetha en su granja de El Lodazal.‡Habla con Tabetha en su granja de El Lodazal.‡Allez trouver Tabetha dans sa ferme, dans le Bourbier.‡与泥潭沼泽中的一处小农庄里的塔贝萨谈一谈。‡跟泥潭沼澤的塔貝薩談話，她就在她的農場裡。',
  }
},
[11213] = {
  {
    'A visita a Tabetha‡Навестить Табету‡Seht nach Tabetha‡타베사의 근황‡Vela por Tabetha‡Vela por Tabetha‡Quelles nouvelles de Tabetha ?‡寻找塔贝萨‡探訪塔貝薩',
    nil,
    'Fale com Tabetha em sua fazenda no Atoleiro.‡Поговорите с Табетой в ее усадьбе на Трясине.‡Sprecht mit Tabetha auf ihrem Hof im Morast.‡먼지 수렁에 있는 농장에서 타베사와 대화해야 합니다.‡Habla con Tabetha en su granja de El Lodazal.‡Habla con Tabetha en su granja de El Lodazal.‡Parlez à Tabetha dans sa ferme du Bourbier.‡与泥潭沼泽农场里的塔贝萨谈一谈。‡跟泥潭沼澤的塔貝薩談話，她位在她的農場裡。',
  }
},
[11214] = {
  {
    '[DEPRECATED]Mission to Mudsprocket‡[DEPRECATED]Mission to Mudsprocket‡Mission nach Morastwinkel‡진흙톱니 거점으로의 임무‡[DEPRECATED]Misión a Piñón de Barro‡[DEPRECATED]Misión a Piñón de Barro‡[PÉRIMÉ]En mission à Bourbe-à-brac‡[DEPRECATED] 前往泥链镇‡[DEPRECATED]前往泥鏈營地的任務',
    nil,
    'Speak with Drazzit Dripvalve at Mudsprocket.‡Поговорите с Драззитом Кранотеком в Шестермути.‡Sprecht mit Drazzit Tropfhahn in Morastwinkel.‡진흙톱니 거점에 있는 드라짓 드립밸브와 대화해야 합니다.‡Habla con Drazzit Gotera en Piñón de Barro.‡Habla con Drazzit Gotera en Piñón de Barro.‡Parler à Drazzit Suintevalve à Bourbe-à-brac.‡与泥链镇的德拉兹特·迪普瓦尔谈一谈。‡跟泥鏈營地的德拉席特·滴栓談話。',
  }
},
[11215] = {
  {
    'Ajude a Coroa de Barro‡Помощь Шестермути‡Helft Morastwinkel‡진흙톱니 거점 지원‡Ayuda a Piñón de Barro‡Ayuda a Piñón de Barro‡Aider Bourbe-à-brac‡帮助泥链镇‡幫助泥鏈營地',
    nil,
    'Fale com Drazzit Pingajunta em Coroa de Barro.‡Поговорите с Драззитом Кранотеком в Шестермути.‡Sprecht mit Drazzit Tropfhahn in Morastwinkel.‡진흙톱니 거점에 있는 드라짓 드립밸브와 대화해야 합니다.‡Habla con Drazzit Gotera en Piñón de Barro.‡Habla con Drazzit Gotera en Piñón de Barro.‡Parler à Drazzit Suintevalve à Bourbe-à-brac.‡与泥链镇的德拉兹特·迪普瓦尔谈一谈。‡跟泥鏈營地的德拉席特·滴栓談話。',
  }
},
[11216] = {
  {
    'Arquimago Alturus‡Верховный маг Альтур‡Erzmagier Alturus‡대마법사 알투루스‡Archimago Alturus‡Archimago Alturus‡L\'archimage Alturus‡大法师奥图鲁斯‡大法師艾特羅斯',
    nil,
    'Fale com o Arquimago Alturus, perto da torre de Karazhan, que fica na Trilha do Vento Morto.‡Поговорите с верховным магом Альтуром близ Каражана на перевале Мертвого Ветра.‡Sprecht mit Erzmagier Alturus außerhalb von Karazhan im Gebirgspass der Totenwinde.‡저승바람 고개에 있는 카라잔 외곽에서 대마법사 알투루스와 대화해야 합니다.‡Habla con el archimago Alturus fuera de Karazhan en el Paso de la Muerte.‡Habla con el archimago Alturus fuera de Karazhan en el Paso de la Muerte.‡Parlez à l\'Archimage Alturus à l\'extérieur de Karazhan au défilé de Deuillevent.‡与逆风小径卡拉赞外的大法师奥图鲁斯谈一谈。‡到逆風小徑跟卡拉贊外的大法師艾特羅斯談話。',
  }
},
[11217] = {
  {
    '[DEPRECATED]Catch a Dragon by the Tail‡[DEPRECATED]Catch a Dragon by the Tail‡Entwindet den Drachen‡[미사용]용에 달린 꼬리도 약에 쓰려니...‡[DEPRECATED]Atrapa a un dragón por la cola‡[DEPRECATED]Atrapa a un dragón por la cola‡[PÉRIMÉ]Attraper un dragon par la queue‡[DEPRECATED] 龙尾草‡[DEPRECATED]Catch a Dragon by the Tail',
    nil,
    'Gizzix Gargaressujo, na Coroa de Barro, quer que você leve a ele 8 Rabos-de-serpe.‡Гиззикс Грязебульк из Шестермути просит принести ему 8 стеблей змейкиного хвоста.‡Gizzix Rußgurgel in Morastwinkel möchte, dass Ihr ihm 8 Drachenwinden bringt.‡진흙톱니 거점에 있는 기직스 그림구르글이 용꼬리 8줄기를 가져다 달라고 했습니다.‡Gizzix Gluglú en Piñón de barro quiere que le lleves 8 tallos de cola de vermis.‡Gizzix Gluglú en Piñón de barro quiere que le lleves 8 tallos de cola de vermis.‡Gizzix Glougloutache de Bourbe-à-brac vous a demandé de lui apporter 8 tiges de Queue de wyrm.‡泥链镇的吉兹克斯·格里古格希望你帮他收集8根龙尾草。‡泥鏈營地的吉希克斯·污流要你交給他8根龍尾草的莖。',
  }
},
[11218] = {
  {
    'Perigo! Explosivos!‡Осторожно! Взрывчатка!‡Warnung! Sprengstoff!‡화기 엄금!‡¡Peligro! ¡Explosivos!‡¡Peligro! ¡Explosivos!‡Danger ! Explosifs !‡危险！爆炸品！‡危險!炸彈!',
    nil,
    'Use a Dinamite Infalível do Aroferro para garimpar 6 Fragmentos de Minério do Desfiladeiro dos Sussurros e 18 Gemas do Desfiladeiro dos Sussurros. Em seguida, fale novamente com o Sapador Aroferro na Bastilha da Guarda Oeste.‡Воспользуйтесь динамитом Стальной Чеки, чтобы собрать 6 кусков руды из Шепчущей теснины и 18 драгоценных камней из Шепчущей теснины. Затем принесите руду и камни саперу Стальной Чеке в Крепость Западной Стражи.‡Verwendet Stahlrings idiotensicheres Dynamit, um 6 Erzfragmente aus der Flüsterschlucht und 18 Edelsteine aus der Flüsterschlucht zu beschaffen. Bringt die Gegenstände anschließend zu Pionier Stahlring in Westwacht zurück.‡바보라도 쓸 수 있는 스틸링의 다이너마이트를 사용하여 속삭임 협곡 광석 조각 6개와 속삭임 협곡 보석 18개를 모은 다음, 서부경비대 성채에 있는 공병 스틸링에게 가져가야 합니다.‡Usa la dinamita para tontos de Aro de Acero para recolectar 6 fragmentos de mena de Garganta Susurro y 18 gemas de Garganta Susurro. Después devuélveselas a Zapador Aro de Acero en la Fortaleza de la Guardia Oeste.‡Usa la dinamita para tontos de Aro de Acero para recolectar 6 fragmentos de mena de Garganta Susurro y 18 gemas de Garganta Susurro. Después devuélveselas a Zapador Aro de Acero en la Fortaleza de la Guardia Oeste.‡Utilisez la Dynamite sécurisée d’Anneau-d’acier pour récupérer 6 Fragments de minerai du goulet des Murmures et 18 Gemmes du goulet des Murmures. Ensuite, allez remettre tout ça au Sapeur Anneau-d’acier, au donjon de la Garde de l’ouest.‡利用斯迪尔林的安全雷管收集6份低语峡谷矿石碎块和18颗低语峡谷宝石，将它们交给西部卫戍要塞的斯迪尔林。‡利用鋼環防呆火藥來收集6枚低語峽谷礦石碎片以及18顆低語峽谷寶石，然後交給鎮西要塞的賽波·鋼環。',
  }
},
[11219] = {
  {
    'Pare com esses incêndios!‡Гаси пожар!‡Löscht das Feuer!‡화재를 진압하라!‡¡Apaga el fuego!‡¡Apaga el fuego!‡Éteignez les incendies !‡赶快灭火！‡阻止火勢!',
    nil,
    'A Matriarca Mascarada quer que você ajude a apagar os incêndios da vila. Quando acabar, fale novamente com a Matriarca Mascarada na cidade.‡Попечительница сирот в маске просит вас помочь потушить пожар в деревне. Когда пожар потухнет, снова поговорите с попечительницей сирот в маске в городе.‡Die maskierte Matrone bittet um Eure Hilfe. Sie möchte, dass Ihr alle Feuer im Dorf löscht. Sprecht noch einmal mit der kostümierten Matrone, sobald alle Feuer erloschen sind.‡마을에 일어난 화재를 잠재운 후 칼바위 언덕에 있는 가면 쓴 보육원 원장님과 대화해야 합니다.‡La supervisora de huérfanos enmascarada quiere que ayudes a apagar todos los incendios en los poblados. Cuando estén apagados, vuelve a hablar con ella.‡La supervisora de huérfanos enmascarada quiere que ayudes a apagar todos los incendios en los poblados. Cuando estén apagados, vuelve a hablar con ella.‡La Directrice d\'orphelinat masquée vous demande d\'aider à éteindre tous les foyers d\'incendie du village. Une fois qu\'ils seront éteints, retournez lui parler en ville.‡戴面具的孤儿院长希望你能帮忙扑灭村子里的所有火焰。在扑灭了所有火焰之后，回去向戴面具的孤儿院长汇报。‡戴面具的孤兒監護員要你幫忙撲滅村莊中的火勢。等火完全撲滅之後，再和鎮上的戴面具的孤兒監護員交談。',
  }
},
[11220] = {
  {
    '‡Всадник без головы‡Der kopflose Reiter‡저주받은 기사‡El Jinete decapitado‡El Jinete decapitado‡Le Cavalier sans tête‡无头骑士‡無頭騎士',
    nil,
    '‡Найдите святилище тыквы Всадника без головы.‡Sucht nach dem Kürbisschrein des kopflosen Reiters.‡붉은십자군 수도원에서 저주받은 기사의 호박 제단을 찾아야 합니다.‡Encuentra el santuario calabaza de El Jinete decapitado.‡Encuentra el santuario calabaza de El Jinete decapitado.‡Trouvez le Sanctuaire de la citrouille du Cavalier sans tête.‡找到无头骑士的南瓜神龛。‡',
  }
},
[11221] = {
  {
    'Notícias do front‡Донесения с полей‡Berichte vom Schlachtfeld‡야전 보고‡Informes desde el campo‡Informes desde el campo‡Rapports de terrain‡战况报告‡來自戰場的報告',
    nil,
    'Fale com a Patrulheira Sombria Lyana e o Sicário Raul no campo de batalha do Vale Sangrento, a sul de Porto Vendeta. Fale novamente com o alto-executor Anselmo ao terminar a tarefa.‡Поговорите с темным следопытом Лианой и стражем смерти Разаэлем на поле боя в Кровоточащей долине к югу от Лагеря Возмездия, после чего вернитесь к Верховному палачу Ансельму.‡Sprecht mit Dunkelläuferin Lyana und Todespirscher Razael. Sie befinden sich auf dem Schlachtfeld in der Blutklamm südlich vom Hafen der Vergeltung. Kehrt zu Hochexekutor Anselm zurück, sobald Ihr die Aufgabe abgeschlossen habt.‡복수의 상륙지 남쪽의 피투성이 계곡 교전 지역에 있는 어둠 순찰자 리아나와 죽음추적자 라자엘과 이야기한 다음 고위집행관 안셀름에게 가야 합니다.‡Habla con la forestal oscura Lyana y con el mortacechador Razael en el campo de batalla de la Vega Sangrante, al sur de Campo Venganza. Preséntate ante el sumo ejecutor Anselm cuando hayas completado esta tarea.‡Habla con la forestal oscura Lyana y con el mortacechador Razael en el campo de batalla de la Vega Sangrante, al sur de Campo Venganza. Preséntate ante el sumo ejecutor Anselm cuando hayas completado esta tarea.‡Parlez au Forestier-sombre Lyana et au Nécrotraqueur Razael, sur le champ de bataille du Val Sanglant, au sud de l’Accostage de la Vengeance. Lorsque ce sera fait, retournez voir le Grand exécuteur Anselme.‡前往复仇港南方的鲜血谷，与战场上的黑暗游侠莉安娜和死亡猎手拉扎尔谈一谈。完成任务后向高级执行官安希尔姆复命。‡和戰場上的黑暗遊俠利雅娜以及亡靈哨兵拉薩爾交談，他們就在復仇臺地南方的浴血谷。等你完成之後，向高階執行官安賽姆回報。',
  }
},
[11222] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED] 叛变的证据‡',
    nil,
    '‡‡‡‡‡‡‡与暴风城要塞的瓦里安·乌瑞恩国王谈一谈。‡',
  }
},
[11223] = {
  {
    '[DEPRECATED]Return to Jaina‡[DEPRECATED]Return to Jaina‡Rückkehr zu Jaina‡[미사용]다시 제이나에게로‡[DEPRECATED]Regresa junto a Jaina‡[DEPRECATED]Regresa junto a Jaina‡[PÉRIMÉ]Retourner voir Jaina‡[DEPRECATED] 返回吉安娜身边‡[DEPRECATED]回覆珍娜',
    nil,
    'Fale com a Grã-senhora Jaina Proudmore em Theramore.‡Поговорите в Тераморе с леди Джайной Праудмур.‡Sprecht mit Lady Jaina Prachtmeer in Theramore.‡테라모어에 있는 제이나 프라우드무어와 대화해야 합니다.‡Habla con Lady Jaina Valiente en Theramore.‡Habla con Lady Jaina Valiente en Theramore.‡Parler à dame Jaina Portvaillant à Theramore.‡与塞拉摩的吉安娜·普罗德摩尔谈一谈。‡跟塞拉摩的珍娜·普勞德摩爾女士談話。',
  }
},
[11224] = {
  {
    'Vai pastar!‡Пришли мулов сюда‡Schickt die Packmulis packen‡짐노새 되찾기‡Envíalas de vuelta‡Envíalas de vuelta‡Têtes de mule‡骡子和货物‡趕回騾群',
    nil,
    'A Exploradora Abigail quer que você levante a /mão para 10 Mulas de Carga Abandonadas e depois volte até ela na Bastilha da Guarda Oeste.‡Исследовательница Эбигейл просит вас пригрозить рукой (команда /рука) 10 брошенным груженым мулам, после чего вернуться к ней в Крепость Западной Стражи.‡Forscherin Abigail möchte, dass Ihr Euch in die Nähe von 10 verlassenen Packmulis begebt, um jedes Mal Eure Hand zu /heben. Kehrt zu ihr zurück sobald Ihr damit fertig seid. Sie befindet sich in der Westwacht.‡서부경비대 성채에 있는 탐험가 아비게일이 버려진 짐노새 10마리에게 /저요 하고 손을 번쩍 들어 보인 다음 돌아와 달라고 했습니다.‡La expedicionaria Abigail te ha pedido que hagas un /levantarmano a 10 mulas de carga abandonadas y vuelvas a verla a la Fortaleza de la Guardia Oeste.‡La expedicionaria Abigail te ha pedido que hagas un /levantarmano a 10 mulas de carga abandonadas y vuelvas a verla a la Fortaleza de la Guardia Oeste.‡L’Exploratrice Abigail vous a demandé de faire /ohé devant 10 Mules de bât abandonnées, puis de retourner la voir au donjon de la Garde de l’ouest.‡探险者亚比盖尔要你吓唬10头被遗弃的骡子（使用/raise命令），然后返回西部卫戍要塞向她复命。‡探險者艾比蓋兒要你對10隻被遺棄的運貨馱騾使用/舉手，然後回到鎮西要塞向她回報。',
  }
},
[11225] = {
  {
    'The Hermit of Witch Hill‡Отшельник с Ведьминого холма‡Der Einsiedler des Hexenhügels‡마녀 언덕의 은둔자‡El ermitaño de la Colina de las Brujas‡El ermitaño de la Colina de las Brujas‡L\'ermite de la Colline des sorcières‡女巫岭的隐士‡女巫嶺的隱士',
    nil,
    'Speak with "Swamp Eye" Jarl at Swamplight Manor.‡Поговорите с Ярлом "Болотным глазом" в сторожке "Болотный огонек".‡Sprecht mit "Sumpfauge" Jarl beim Irrlichtanwesen.‡늪지기 오두막에 있는 "늪지눈알" 자를과 대화해야 합니다.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Parlez à Jarl « Oeil-des-marais » au Manoir des Flammeroles.‡与水光庄园的"沼泽之眼"加尔谈一谈。‡和水光莊園的『沼澤之眼』加爾談談。',
  }
},
[11226] = {
  {
    '‡Upper Deck Promo – Призрачный верховой тигр‡Reittier: Spektraltiger‡카드매니아 - 유령 호랑이‡Upper Deck Promo - Ghost Wolf Mount‡Upper Deck Promo - Ghost Wolf Mount‡Promo Upper Deck - Monture tigre spectral‡幽灵虎坐骑‡',
    nil,
    nil,
  }
},
[11227] = {
  {
    'Não tem pão? Que comam corvos!‡Пусть едят вволю!‡Lasst sie Krähen fressen‡까마귀 고기를 먹여라‡¡Que coman grajos!‡¡Que coman grajos!‡Qu\'ils mangent du corbeau‡让它们吃乌鸦‡讓牠們吃烏鴉',
    nil,
    'Pôncio, o tratador do canil de Porto Vendeta, quer que você use a Jaula de Cão Pestilento para evocar um Cão Pestilento Esfomeado e em seguida alimente o animal com Carne de Corvo dos Corvos de Fiorde a oeste de Porto Vendeta.‡Понтий, псарь из Лагеря Возмездия, просит вас забрать голодного чумного пса из клетки и накормить его мясом ворон фьорда, которые кружат к западу от Лагеря Возмездия.‡Pontius, der Hüter des Zwingers im Hafen der Vergeltung, möchte, dass Ihr mithilfe des Seuchenhundkäfigs einen hungrigen Seuchenhund herbeiruft und diesen dann mit dem Krähenfleisch der Fjordkrähen füttert. Letztere befinden sich westlich des Hafens der Vergeltung.‡복수의 상륙지에 있는 사육사 폰티우스가 역병사냥개 우리로 배고픈 역병사냥개를 소환하고 나서, 복수의 상륙지 서쪽에서 협만 까마귀를 처치하고 얻은 까마귀 고기를 먹여달라고 했습니다.‡Pontius, el vigilante de la perrera de Campo Venganza, quiere que utilices la jaula de can de peste para invocar a un can de peste hambriento y darle carne de grajo para comer. Conseguirás la carne de los grajos de fiordo al oeste de Campo Venganza.‡Pontius, el vigilante de la perrera de Campo Venganza, quiere que utilices la jaula de can de peste para invocar a un can de peste hambriento y darle carne de grajo para comer. Conseguirás la carne de los grajos de fiordo al oeste de Campo Venganza.‡Pontius, le maître du chenil de l’Accostage de la Vengeance, veut que vous utilisiez la Cage de chien pestiféré pour invoquer un Chien pestiféré affamé. Vous lui donnerez de la Viande de corbeau, prélevée sur les Corbeaux du Fjord, à l’ouest de l’Accostage de la Vengeance.‡复仇港的猎犬管理员伯提乌斯要求你使用瘟疫犬笼召唤一只饥饿的瘟疫犬，并用复仇港西边那些峡湾乌鸦的肉将它喂饱。‡龐提烏斯，復仇臺地的狗籠管理者要你使用瘟疫獵犬鐵籠來召喚一隻飢餓的瘟疫獵犬，用峽灣烏鴉的烏鴉肉來餵飽牠們。那些烏鴉就在復仇臺地的西邊。',
  }
},
[11228] = {
  {
    'Até o inferno gelou...‡Во власти ледяного кошмара...‡Eine Hölle aus Eis...‡얼어붙은 지옥‡El infierno se ha congelado...‡El infierno se ha congelado...‡L\'enfer a gelé…‡冰冻的地狱……‡冰封地獄……',
    nil,
    'Fale com o Vice-almirante Castro em Valgarde.‡Поговорите с вице-адмиралом Келлером в Валгардском порту.‡Sprecht mit Vizeadmiral Keller im Hafen von Valgarde.‡발가드 항만의 부제독 켈러와 대화해야 합니다.‡Habla con el vicealmirante Keller en el Puerto de Valgarde.‡Habla con el vicealmirante Keller en el Puerto de Valgarde.‡Parlez au vice-amiral Keller au port de Valgarde.‡与瓦加德港口的凯勒中将谈一谈。‡與瓦爾加德港口的海軍中將凱勒談談。',
  }
},
[11229] = {
  {
    'A Esquadra Correventos‡Флагман "Ветрокрылая"‡Die Windläuferflotte‡윈드러너 함대‡La flota de El Brisaveloz‡La flota de El Brisaveloz‡La flotte du Coursevent‡风行者舰队‡風行者艦隊',
    nil,
    'Fale com a Tratadora de Morcegos Camila em Porto Vendeta e consiga um transporte até o Correventos. Apresente-se à Capitão Harker a bordo do navio.‡Поговорите с дрессировщицей нетопырей Камиллой в Лагере Возмездия и летите к флагману "Ветрокрылая". Доложите о своем прибытии капитану Харкеру.‡Sprecht mit Fledermausführerin Kamilla im Hafen der Vergeltung und fragt nach einer Möglichkeit, zur Windläufer hindurchzukommen. Meldet Euch dann bei Kapitän Harker an Bord des Schiffs.‡복수의 상륙지에 있는 박쥐 조련사 카미유와 이야기하고 윈드러너호로 이동하여 배에 있는 순찰대장 하커에게 보고해야 합니다.‡Habla con la cuidadora de murciélagos Camille en Campo Venganza y consigue llegar a El Brisaveloz. Preséntate ante la capitana Harker a bordo del barco.‡Habla con la cuidadora de murciélagos Camille en Campo Venganza y consigue llegar a El Brisaveloz. Preséntate ante la capitana Harker a bordo del barco.‡Parlez à l’Éleveuse de chauve-souris Camille à l’Accostage de la Vengeance, et demandez-lui de vous envoyer sur le Coursevent. Une fois à bord, présentez-vous au capitaine Harker.‡与复仇港的蝙蝠管理员卡米蕾交谈，然后前往风行者号，向甲板上的哈克尔船长报到。‡與復仇臺地的蝙蝠管理員卡蜜兒談談，並取得前往風行者號的路線。回報給船上的哈克船長。',
  }
},
[11230] = {
  {
    'Pegos em emboscada‡Засада!‡Hinterhalt!‡습격!‡¡Una emboscada!‡¡Una emboscada!‡Embusqués !‡伏击！‡埋伏!',
    nil,
    'A capitão Harker, a bordo do Correventos, quer que você mate 15 Fuzileiros da Frota Norte.‡Капитан Харкер на борту "Ветрокрылой" просит вас убить 15 стражей бухты Северного флота.‡Kapitän Harker an Bord der Windläufer möchte, dass Ihr 15 Marinesoldaten der Nordflotte tötet.‡윈드러너호에 있는 순찰대장 하커가 북쪽바다 함대 해병 15명을 제거해 달라고 했습니다.‡La capitana Harker, a bordo de El Brisaveloz, quiere que mates a 15 marinos de la Flota Norte.‡La capitana Harker, a bordo de El Brisaveloz, quiere que mates a 15 marinos de la Flota Norte.‡Le capitaine Harker, à bord du Coursevent, veut que vous tuiez 15 Soldats de marine de la flotte du nord.‡风行者号上的哈克尔船长要求你杀死15名北方舰队陆战队员。‡風行者號上的哈克船長要你殺死15個北方艦隊海員。',
  }
},
[11231] = {
  {
    'De chaves e jaulas‡О ключах и клетках‡Von Schlüsseln und Käfigen‡철창과 열쇠‡De llaves y jaulas‡De llaves y jaulas‡Des clés et des cages‡钥匙和牢笼‡鑰匙與牢籠',
    nil,
    'Padre Levariol quer que você pegue Chaves da Jaula de Gjalerbron em quantidade suficiente para libertar 10 Prisioneiros de Gjalerbron. Fale novamente com ele, na Bastilha da Guarda Oeste, após terminar a tarefa.‡Отец Левариол попросил вас собрать достаточное количество ключей от гьялербронских клеток, чтобы освободить 10 гьялербронских узников. Когда вы выполните задание, вернитесь к нему в Крепость Западной Стражи.‡Vater Levariol möchte, dass Ihr genug Schlüssel für einen Gjalerbronkäfig sammelt, um 10 Gefangene von Gjalerbron zu befreien. Kehrt zu ihm zurück, sobald Ihr damit fertig seid. Er befindet sich in Westwacht.‡샬레르브론 철창 열쇠를 모아 샬레르브론 포로 10명을 풀어 준 후, 서부경비대 성채에 있는 신부 레바리올에게 가야 합니다.‡Padre Levariol te ha pedido que consigas tantas llaves de jaula de Gjalerbron como sean necesarias para liberar a 10 prisioneros de Gjalerbron. Vuelve a verlo a la Fortaleza de la Guardia Oeste cuando lo consigas.‡Padre Levariol te ha pedido que consigas tantas llaves de jaula de Gjalerbron como sean necesarias para liberar a 10 prisioneros de Gjalerbron. Vuelve a verlo a la Fortaleza de la Guardia Oeste cuando lo consigas.‡Le Père Levariol vous a demandé de récupérer assez de Clés de cage de Gjalerbron pour libérer 10 Prisonniers de Gjalerbron. Lorsque ce sera fait, retournez le voir au Donjon de la Garde de l’ouest.‡莱瓦里安神父要你去搜集足够的亚勒伯龙牢笼钥匙，用它们解救10个亚勒伯龙囚犯。完成任务后，返回西部卫戍要塞向他复命。‡雷瓦瑞爾神父要你收集足夠的夏勒布隆鐵籠鑰匙，去釋放10個夏勒布隆囚犯。等你完成之後回到鎮西要塞向神父報告。',
  }
},
[11232] = {
  {
    'Guie o nosso olhar‡Дайте нам знак‡Lenkt unseren Blick‡시야 확보‡Sé nuestros ojos‡Sé nuestros ojos‡Guidez nos tirs‡指引方位‡指引方向',
    nil,
    'Use os Sinalizadores de Fumaça para marcar a localização dos Canhões da Aliança na muralha norte da Praia do Naufrágio. Apresente-se à Patrulheira Sombria Lyana no Vale Sangrento após terminar a tarefa.‡С помощью дымовых сигнальных ракет обозначьте местонахождение пушек Альянса вдоль северной стены Обнажившегося дна. Доложите о выполнении задания темному следопыту Лиане из Кровоточащей долины.‡Markiert mit den Rauchsignalen die Stellen entlang der Nordwand am Verlassenen Strand, an denen sich die Kanonen der Allianz befinden. Meldet Euch bei Dunkelläufer Lyana in der Blutklamm, sobald Ihr die Aufgabe abgeschlossen habt.‡적막한 해안의 북쪽 벽으로 가서 얼라이언스 대포가 있는 곳에 조명탄을 사용한 다음, 피투성이 계곡에 있는 어둠 순찰자 리아나에게 보고해야 합니다.‡Usa las bengalas de humo en el lugar donde se encuentran los cañones de la Alianza, en el muro norte de Playa Derelicta. Cuando hayas completado esta tarea, informa a la forestal oscura Lyana en la Vega Sangrante.‡Usa las bengalas de humo en el lugar donde se encuentran los cañones de la Alianza, en el muro norte de Playa Derelicta. Cuando hayas completado esta tarea, informa a la forestal oscura Lyana en la Vega Sangrante.‡Utilisez les Fumigènes aux emplacements des Canons de l’Alliance, sur la paroi nord de la Grève des Épaves. Lorsque ce sera fait, présentez-vous au Forestier-sombre Lyana, au Val Sanglant.‡使用烟雾信号弹标记出荒弃海岸北墙外的联盟火炮位置。完成任务后向鲜血谷的黑暗游侠莉安娜复命。‡在遺棄水岸北邊牆壁的聯盟火砲處使用煙霧照明彈。完成任務後回到浴血谷回報黑暗遊俠利雅娜。',
  }
},
[11233] = {
  {
    'O tiro de misericórdia‡Решающий удар‡Den Todesstoß landen‡결정타 날리기‡Asestar el golpe de gracia‡Asestar el golpe de gracia‡Le coup de grâce‡致命的打击‡痛下殺手',
    nil,
    'A Patrulheira Sombria Lyana, do sul de Porto Vendeta, quer que você mate o Capitão Olster, a Tenente Celeyne e o Sargento Lorico na Praia do Naufrágio.‡Темный следопыт Лиана из Лагеря Возмездия послала вас убить капитана Ольстера, сержанта Лоррика и лейтенанта Селейну, обосновавшихся на Обнажившемся дне.‡Dunkelläuferin Lyana südlich des Hafens der Vergeltung möchte, dass Ihr Hauptmann Olster, Leutnant Celeyne und Unteroffizier Lorric tötet. Ihr findet sie am Verlassenen Strand.‡복수의 상륙지 남쪽에 있는 어둠 순찰자 리아나가 적막한 해안에 있는 선장 올스터, 부관 셀레인, 하사관 로릭을 처치해 달라고 했습니다.‡La forestal oscura Lyana, al sur de Campo Venganza, quiere que mates al capitán Olster, a la teniente Celeyne y al sargento Lorric en Playa Derelicta.‡La forestal oscura Lyana, al sur de Campo Venganza, quiere que mates al capitán Olster, a la teniente Celeyne y al sargento Lorric en Playa Derelicta.‡Le forestier-sombre Lyana, au sud de l’Accostage de la Vengeance, veut que vous tuiez le Capitaine Olster, le Sergent Lorric et le Lieutenant Celeyne à la Grève des Épaves.‡复仇港南方的黑暗游侠莉安娜要你潜入荒弃海岸，杀死欧斯勒上尉、塞雷尼中尉和洛瑞克中士。‡復仇臺地南邊的黑暗遊俠利雅娜要你去遺棄水岸殺了上尉歐斯特、中尉西里尼和士官羅利克。',
  }
},
[11234] = {
  {
    'Apresente-se a Anselmo‡Доложите Ансельму‡Meldung an Anselm‡안셀름에게 보고‡Informa a Anselm‡Informa a Anselm‡Se présenter à Anselme‡向安希尔姆复命‡回報安賽姆',
    nil,
    'Apresente-se ao alto-executor Anselmo em Porto Vendeta, no Fiorde Uivante.‡Вернитесь к верховному палачу Ансельму в Лагерь Возмездия в Ревущем фьорде.‡Erstattet Hochexekutor Anselm Bericht. Er befindet sich im Hafen der Vergeltung im Heulenden Fjord.‡울부짖는 협만의 복수의 상륙지에 있는 고위집행관 안셀름에게 보고해야 합니다.‡Informa al sumo ejecutor Anselm en Campo Venganza, en el Fiordo Aquilonal.‡Informa al sumo ejecutor Anselm en Campo Venganza, en el Fiordo Aquilonal.‡Présentez-vous au Grand exécuteur Anselme à l\'Accostage de la Vengeance, dans le Fjord hurlant.‡回到嚎风峡湾的复仇港，向高级执行官安希尔姆复命。‡回報給高階執行官安賽姆，他就在凜風峽灣的復仇臺地。',
  }
},
[11235] = {
  {
    'Dando cabo de Gjalerbron‡Очистить Гьялерброн‡Mit Gjalerbron fertig werden‡샬레르브론의 문제‡Encargarse de Gjalerbron‡Encargarse de Gjalerbron‡S\'occuper de Gjalerbron‡亚勒伯龙的麻烦‡對付夏勒布隆',
    nil,
    'O Capitão Carneiro quer que você mate 15 Guerreiros de Gjalerbron, 8 Lança-runas de Gjalerbron e 8 Guarda-sonhos de Gjalerbron. Depois disso, fale novamente com o Capitão na Bastilha da Guarda Oeste.‡Капитан Адамс поручил вам убить 15 гьялербронских воинов, 8 гьялербронских руночаров и 8 гьялербронских сноходцев. После чего вам надлежит вернуться к нему в Крепость Западной Стражи.‡Hauptmann Adams möchte, dass Ihr 15 Krieger von Gjalerbron, 8 Runenmagier von Gjalerbron und 8 Schlafwächter von Gjalerbron tötet. Kehrt danach zu ihm zurück. Ihr findet ihn in Westwacht.‡샬레르브론 전사 15명, 샬레르브론 룬마술사 8명, 샬레르브론 수면의 감시자 8명을 처치하고 서부경비대 성채에 있는 경비대장 아담스에게 가야 합니다.‡El capitán Adams te ha pedido que mates 15 guerreros de Gjalerbron, 8 taumaturgos de runas de Gjalerbron y 8 vigías del sueño de Gjalerbron. Después vuelve a verle a la Fortaleza de la Guardia Oeste.‡El capitán Adams te ha pedido que mates 15 guerreros de Gjalerbron, 8 taumaturgos de runas de Gjalerbron y 8 vigías del sueño de Gjalerbron. Después vuelve a verle a la Fortaleza de la Guardia Oeste.‡Le Capitaine Adams vous a demandé de tuer 15 Guerriers de Gjalerbron, 8 Lanceurs de runes de Gjalerbron et 8 Gardiens du sommeil de Gjalerbron. Ensuite, revenez le voir au donjon de la Garde de l’ouest.‡亚当斯上尉要你去杀死15个亚勒伯龙战士、8个亚勒伯龙符文法师和8个亚勒伯龙沉睡卫士，然后返回西部卫戍要塞向他复命。‡亞當斯隊長要你去殺死15個夏勒布隆戰士、8個夏勒布隆符文使和8個夏勒布隆守眠者。完成之後，再回到鎮西要塞向他報告。',
  }
},
[11236] = {
  {
    'Necrolorde supremo Mezhen‡Некровладыка Мезхен‡Nekrogroßfürst Mezhen‡강령 대군주 메젠‡Necroseñor Supremo Mezhen‡Necroseñor Supremo Mezhen‡Le nécro-suzerain Mezhen‡通灵主宰麦森‡死靈主宰梅贊',
    nil,
    'Mate o Necrolorde Supremo Mezhen. Em seguida, apresente-se novamente ao Capitão Carneiro na Bastilha da Guarda Oeste, que fica no Fiorde Uivante.‡Убейте некровладыку Мезхена. Затем вернитесь к капитану Адамсу в Крепость Западной Стражи.‡Tötet Nekrogroßfürst Mezhen. Kehrt dann zu Hauptmann Adams zurück. Ihr findet ihn in Westwacht.‡강령 대군주 메젠을 처치하고 서부경비대 성채에 있는 경비대장 아담스에게 가야 합니다.‡Mata al Necroseñor Supremo Mezhen y vuelve a ver al capitán Adams en la Fortaleza de la Guardia Oeste.‡Mata al Necroseñor Supremo Mezhen y vuelve a ver al capitán Adams en la Fortaleza de la Guardia Oeste.‡Tuez le Nécro-suzerain Mezhen, puis retournez voir le Capitaine Adams au Donjon de la Garde de l’ouest.‡杀死通灵主宰麦森，然后返回西部卫戍要塞向亚当斯上尉复命。‡殺死死靈主宰梅贊。然後向鎮西要塞的亞當斯隊長回報。',
  }
},
[11237] = {
  {
    'Planos de ataque de Gjalerbron‡Гьялербронский план нападения‡Angriffspläne von Gjalerbron‡샬레르브론 공격 계획서‡Los planes de ataque de Gjalerbron‡Los planes de ataque de Gjalerbron‡Les plans d\'attaque de Gjalerbron‡亚勒伯龙攻击计划‡夏勒布隆攻擊計畫',
    nil,
    'Entregue os Planos de Ataque de Gjalerbron para o Mago-tenente Malister na Bastilha da Guarda Oeste.‡Отнесите гьялербронский план нападения магу-лейтенанту Малистеру в Крепость Западной Стражи.‡Übergebt die Angriffspläne von Gjalerbron an Magierleutnant Malister. Er befindet sich in Westwacht.‡샬레르브론 공격 계획서를 서부경비대 성채에 있는 마법사 부관 말리스터에게 전달해야 합니다.‡Entrégale los planes de ataque de Gjalerbron al teniente mago Malister en la Fortaleza de la Guardia Oeste.‡Entrégale los planes de ataque de Gjalerbron al teniente mago Malister en la Fortaleza de la Guardia Oeste.‡Remettez les Plans d\'attaque de Gjalerbron au Lieutenant-mage Malister, au Donjon de la Garde de l\'ouest.‡前往西部卫戍要塞，将亚勒伯龙攻击计划交给法师中尉玛利斯特。‡把夏勒布隆攻擊計畫交給鎮西要塞的法師中尉瑪歷斯特。',
  }
},
[11238] = {
  {
    'A serpe gélida e seu mestre‡Ледяной змей и его повелитель‡Der Frostwyrm und sein Meister‡서리고룡과 주인‡La vermis de escarcha y su maestro‡La vermis de escarcha y su maestro‡Le wyrm de givre et son maître‡冰霜巨龙和它的主人‡冰霜巨龍與它的主人',
    nil,
    'Mate o Arauto Vil da Serpe e use a Corneta do Arauto da Serpe para chamar e matar Glacion. Em seguida, entregue a corneta para o Mago-tenente Malister, na Bastilha da Guarda Oeste, que fica no Fiorde Uivante.‡Убейте Зловещего призывателя драконов и воспользуйтесь его рогом, чтобы позвать обратно Ледиона. Убейте ледяного змея и принесите рог магу-лейтенанту Малистеру в Крепость Западной Стражи.‡Erschlagt Wyrmrufer Elend und benutzt das Wyrmruferhorn, um Glacion herbeizurufen und ihn niederzustrecken. Kehrt anschließend gemeinsam mit dem Horn zu Magierleutnant Malister zurück. Er befindet sich in Westwacht.‡용소환사 바일을 처치하고 용소환사의 뿔피리를 사용하여 글라시온을 불러내 처치한 후, 서부경비대 성채에 있는 마법사 부관 말리스터에게 뿔피리를 가져가야 합니다.‡Mata al Clamavermis Vil y usa el cuerno de clamavermis para llamar y matar a Glacion. Después llévale el cuerno al teniente mago Malister a la Fortaleza de la Guardia Oeste.‡Mata al Clamavermis Vil y usa el cuerno de clamavermis para llamar y matar a Glacion. Después llévale el cuerno al teniente mago Malister a la Fortaleza de la Guardia Oeste.‡Tuez le Mande-wyrm Vile et utilisez le Cor mande-wyrm pour appeler et tuer Glacion. Lorsque ce sera fait, retournez avec le cor voir le Lieutenant-mage Malister au Donjon de la Garde de l’ouest.‡杀死唤龙者维尔，使用唤龙者的号角召唤并杀死格拉希恩。然后返回西部卫戍要塞，将号角交给法师中尉玛利斯特。‡殺了喚龍者惡邪並使用喚龍者號角將加拉希恩召喚回來，殺了牠。接著，帶著號角回到鎮西要塞交給法師中尉瑪歷斯特。',
  }
},
[11239] = {
  {
    'A serviço da Luz‡На службе Света‡Im Dienste des Lichts‡빛의 가호 아래‡En servicio a la Luz‡En servicio a la Luz‡Au service de la Lumière‡为圣光效力‡侍奉聖光',
    nil,
    'Mate 10 Guardiões Imortais, 4 Horrores Temerários, e 2 Criaturas Pútridas. Em seguida, relate ao Padre Levariol, na Bastilha da Guarda Oeste, o sucesso da missão.‡Убейте 10 бессмертных дозорных, 4 чудовищных ужаса и 2 тлетворных существа по просьбе отца Левариола из Крепости Западной Стражи.‡Erschlagt 10 ewige Beobachter, 4 furchterregende Schrecken und 2 eitrige Kreaturen. Informiert danach Vater Levariol von Eurem Erfolg. Er befindet sich in Westwacht.‡죽지 않는 감시자 10마리, 무시무시한 역병괴물 4마리, 부패한 망령 2마리를 처치한 후, 서부경비대 성채에 있는 신부 레바리올에게 알려야 합니다.‡Mata a 10 vigías inextinguibles, 4 horrores aterradores y 2 criaturas pútridas. Después informa de tu éxito al Padre Levariol en la Fortaleza de la Guardia Oeste.‡Mata a 10 vigías inextinguibles, 4 horrores aterradores y 2 criaturas pútridas. Después informa de tu éxito al Padre Levariol en la Fortaleza de la Guardia Oeste.‡Tuez 10 Guetteurs impérissables, 4 Horreurs effroyables et 2 Nécrophages putrides. Lorsque ce sera fait, informez de votre réussite le Père Levariol au Donjon de la Garde de l’ouest.‡消灭10个不死的看守者、4个可怕的丧尸和2个腐烂的畸形妖，然后返回西部卫戍要塞向莱瓦里安神父复命。‡殺死10隻不滅的看守者、4頭駭人的恐獸以及2隻腐爛的活屍。結束以後，將成功的消息告訴鎮西要塞的雷瓦瑞爾神父。',
  }
},
[11240] = {
  {
    'O demente-mor‡Предводитель Спятивших‡Anführer der Verwirrten‡광기에 찬 지도자‡Líder de los trastornados‡Líder de los trastornados‡Le chef des dérangés‡疯人的头领‡發狂者的首領',
    nil,
    'Mate Simon Bacamarte e depois apresente-se ao Sapador Aroferro na Bastilha da Guarda Oeste.‡Убейте Сквига Идолохотника и сообщите об этом саперу Стальная Чека, который находится в Крепости Западной Стражи.‡Erschlagt Squeeg Götzenjäger und meldet Euch dann bei Pionier Stahlring in Westwacht.‡스퀴그 아이돌헌터를 처치한 다음 서부경비대 성채에 있는 공병 스틸링에게 보고해야 합니다.‡Mata a Squeeg Cazador de Ídolos y después informa a Zapador Aro de Acero en la Fortaleza de la Guardia Oeste.‡Mata a Squeeg Cazador de Ídolos y después informa a Zapador Aro de Acero en la Fortaleza de la Guardia Oeste.‡Tuez Squeeg Chassidole, puis présentez-vous au Sapeur Anneau-d\'acier, au Donjon de la Garde de l\'ouest.‡杀死斯奎格·埃德亨特，然后返回西部卫戍要塞向工兵斯迪尔林复命。‡殺掉史盔吉·獵像者，然後回到鎮西要塞回報賽波·鋼環。',
  }
},
[11241] = {
  {
    'Rastro de fogo‡Путь огня‡Flammenspur‡불의 흔적‡Rastro de fuego‡Rastro de fuego‡Une piste enflammée‡烈火冲天‡火的蹤跡',
    nil,
    'Acompanhe o Boticário Hanibal para fora da Praia do Naufrágio. Em seguida, apresente-se ao Boticário Lisandro, no Fiorde Uivante.‡Выведите аптекаря Хейнса из Обнажившегося дна после чего сообщите о произошедшем аптекарю Лисандеру из Лагеря Возмездия в Ревущем фьорде.‡Eskortiert Apotheker Hanes vom Verlassenen Strand. Meldet Euch bei Apotheker Lysander, sobald Ihr diese Aufgabe abgeschlossen habt. Er befindet sich im Hafen der Vergeltung im Heulenden Fjord.‡연금술사 헤인즈를 적막한 해안 밖으로 호위한 다음 울부짖는 협만에 있는 복수의 상륙지로 가 연금술사 라이샌더에게 보고해야 합니다.‡Escolta al boticario Hanes fuera de la Playa Derelicta. Informa al boticario Lysander de Campo Venganza en el Fiordo Aquilonal cuando hayas completado esta tarea.‡Escolta al boticario Hanes fuera de la Playa Derelicta. Informa al boticario Lysander de Campo Venganza en el Fiordo Aquilonal cuando hayas completado esta tarea.‡Escortez l’Apothicaire Hanes jusqu’à la sortie de la Grève des Épaves. Lorsque ce sera fait, présentez-vous à l’Apothicaire Lysander à l’Accostage de la Vengeance.‡护送药剂师哈恩斯离开荒弃海岸。完成这个任务之后回到嚎风峡湾的复仇港，向药剂师雷杉德尔复命。‡護送藥劑師漢尼斯逃出遺棄水岸。完成這個任務後，回報給藥劑師黎珊達。她就在凜風峽灣的復仇臺地。',
  }
},
[11242] = {
  {
    'Enfim, livre!‡Наконец, свободен!‡Endlich frei!‡마침내 얻은 자유!‡¡Por fin libre!‡¡Por fin libre!‡Enfin libre !‡终于解脱了！‡終獲自由!',
    nil,
    'Leve o Tomo de Tomás Tomilho para a Matriarca Fantasiada da Vila d\'Ouro, de Kharanos ou do Entreposto Lazúli.‡Возьмите книгу Томаса Томсона и отнесите ее переодетой попечительнице сирот в Златоземье, Каранос или на Лазурную заставу.‡Bringt den Folianten von Thomas Thomson zu einer maskierten Waisenmatrone in Goldhain, Kharanos oder bei der Azurwacht.‡황금골이나 카라노스, 하늘 감시초소의 축제 의상을 입은 보육원 원장님에게 토마스 톰슨의 기도서를 가져가야 합니다.‡Lleva el Escrito de Thomas Thomson a la supervisora de huérfanos disfrazada de Villadorada, Kharanos o de la Avanzada Azur.‡Lleva el Escrito de Thomas Thomson a la supervisora de huérfanos disfrazada de Villadorada, Kharanos o de la Avanzada Azur.‡Apportez le Tome de Thomas Thomson à la Directrice d\'orphelinat costumée à Comté-de-l\'Or, à Kharanos ou au Guet d\'azur.‡将这本破损的圣典交给闪金镇、卡拉诺斯或碧蓝岗哨的穿戏服的孤儿院长。‡帶著湯瑪斯·托姆森的聖典交給變裝的孤兒監護員，她在閃金鎮、卡拉諾斯或藍色守望。',
  }
},
[11243] = {
  {
    'Se Valgarde cair...‡Если Валгард падет...‡Falls Valgarde fällt...‡발가드가 함락되면...‡Si Valgarde cae...‡Si Valgarde cae...‡Si Valgarde tombe…‡如果瓦加德失守……‡如果瓦爾加德陷落…',
    nil,
    'O Vice-almirante Castro, do Porto de Valgarde, no Fiorde Uivante, quer que você mate 12 Invasores Esfola-dragão ou 12 Worgs Esfola-dragão.‡Вице-адмирал Келлер из Валгардского порта в Ревущем фьорде просит вас убить 12 захватчиков из клана Укротителей драконов или воргов из клана Укротителей драконов.‡Vizeadmiral Keller möchte, dass Ihr 12 Eindringlinge der Drachenschinder oder Worge der Drachenschinder tötet. Er befindet sich im Hafen von Valgarde im Heulenden Fjord.‡울부짖는 협만의 발가드 항만에 있는 부제독 켈러가 용약탈 침입자 또는 용약탈 검은늑대 12마리를 처치해 달라고 했습니다.‡El vicealmirante Keller en el Puerto de Valgarde del Fiordo Aquilonal quiere que mates 12 invasores Desuelladragones o huargos Desuelladragones.|n‡El vicealmirante Keller en el Puerto de Valgarde del Fiordo Aquilonal quiere que mates 12 invasores Desuelladragones o huargos Desuelladragones.|n‡Le Vice-amiral Keller, du port de Valgarde dans le Fjord hurlant, veut que vous tuiez 12 Envahisseurs écorche-dragon ou Worgs écorche-dragon.‡嚎风峡湾瓦加德港口的凯勒中将要你杀死12个掠龙入侵者或掠龙座狼。‡海軍中將凱勒要你殺死12個掠龍入侵者或掠龍座狼。他就在凜風峽灣的瓦爾加德港口。',
  }
},
[11244] = {
  {
    'Socorrendo os socorristas‡На помощь спасателям‡Die Retter retten‡구조대를 구조하라‡Rescatar a los rescatadores‡Rescatar a los rescatadores‡Au secours des secours‡营救行动‡拯救那些救援者',
    nil,
    'O Vice-almirante Castro, do Porto de Valgarde, no Fiorde Uivante, quer que você resgate 8 Batedores de Valgarde empalados e abandonados à morte.‡Вице-адмирал Келлер из Валгардского порта в Ревущем фьорде просит вас спасти 8 валгардских разведчиков, которых проткнули гарпунами и оставили умирать.‡Vizeadmiral Keller möchte, dass Ihr 8 Späher von Valgarde rettet, die mit Harpunen beschossen und zum Sterben liegen gelassen wurden. Er befindet sich im Hafen von Valgarde im Heulenden Fjord.‡울부짖는 협만의 발가드 항만에 있는 부제독 켈러가 발가드 정찰병 8명을 구조해 달라고 했습니다.‡El vicealmirante Keller del Puerto de Valgarde en el Fiordo Aquilonal quiere que encuentres a 8 exploradores de Valgarde que han sido empalados y abandonados hasta la muerte.‡El vicealmirante Keller del Puerto de Valgarde en el Fiordo Aquilonal quiere que encuentres a 8 exploradores de Valgarde que han sido empalados y abandonados hasta la muerte.‡Le Vice-amiral Keller, du port de Valgarde dans le Fjord hurlant, veut que vous secouriez 8 Éclaireurs de Valgarde qui ont été empalés et laissés pour morts.‡嚎风峡湾瓦加德港口的凯勒中将要你解救8名奄奄一息的瓦加德斥候。‡海軍中將凱勒要你拯救8個被刺穿等死的瓦爾加德斥候。他就在凜風峽灣的瓦爾加德港口。',
  }
},
[11245] = {
  {
    'Torres da morte certa‡Смертельно опасные башни‡Türme des sicheren Untergangs‡파멸의 탑‡Torres de cierta fatalidad‡Torres de cierta fatalidad‡Les tours de la fatalité‡危险的塔楼‡厄運的哨塔',
    nil,
    'O Sargento da Guarda Oeste informou a você que seria aconselhável usar a Tocha do Sargento para sinalizar as quatro torres de Skorn como alvo das salvas de canhão.‡Сержант из крепости Западной Стражи сообщил вам, что сторожевые башни Скорна разумнее всего разрушить с воздуха.‡Der Unteroffizier der Westwacht meint, dass es sinnvoll wäre, wenn man mit dem Leuchtsignal des Unteroffiziers die Türme in Skorn markiert, damit sie anschließend unter Kanonenbeschuss genommen werden können.‡서부경비대 하사관이 하사관의 신호탄을 사용해 스코른에 있는 탑 4개에 포격 표시를 해 달라고 했습니다.‡El Sargento de la Guardia Oeste te ha informado de que sería conveniente usar la Bengala de Sargento para fijar las cuatro torres de Skorn como objetivos para ataques con cañones.‡El Sargento de la Guardia Oeste te ha informado de que sería conveniente usar la Bengala de Sargento para fijar las cuatro torres de Skorn como objetivos para ataques con cañones.‡Le Sergent de la Garde de l’ouest vous a expliqué qu’il serait souhaitable de marquer les quatre tours de Mörg en prévision d’une canonnade, à l\'aide du Fumigène du sergent.‡西部卫戍军士要你前往斯克恩，利用军士的烟幕弹标记四座塔楼的位置，供炮击定位用。‡鎮西士官告訴你使用士官火焰信號來做為斯考恩四座高塔的砲擊標記會比較好。',
  }
},
[11246] = {
  {
    'Repulsivo, mas necessário‡Тяжело, но необходимо‡Grausam, aber notwendig‡브리쿨의 영혼‡Horripilante, pero necesario‡Horripilante, pero necesario‡Salissant, mais nécessaire‡可怕而必要的手段‡駭人聽聞的必要工作',
    nil,
    'O Sargento da Guarda Oeste quer que você use o Facão do Sargento para desmembrar 20 vraikalen da tribo Hiberfel em Skorn.‡Сержант из крепости Западной Стражи попросил вас разрубить на куски 20 снежескорнских врайкулов в Скорне.‡Der Unteroffizier der Westwacht möchte, dass Ihr nach Skorn geht und mit der Machete des Unteroffiziers 20 Vrykul des Winterskornstammes zerstückelt.‡서부경비대 하사관이 하사관의 마체테를 사용해 스코른에 있는 윈터스코른 부족의 브리쿨 20명의 영혼을 수습해 달라고 했습니다.‡El sargento de la Guardia Oeste te ha pedido que uses el machete del Sargento para desmembrar a 20 vrykuls de la tribu Inbjerskorn en Skorn.‡El sargento de la Guardia Oeste te ha pedido que uses el machete del Sargento para desmembrar a 20 vrykuls de la tribu Inbjerskorn en Skorn.‡Le Sergent de la Garde de l’ouest vous a demandé de démembrer 20 Vrykuls de la tribu Mörghiver, à Mörg, à l\'aide de la Machette du sergent.‡西部卫戍军士要你前往斯克恩，利用军士的弯刀确保20个斯克恩部族的维库人无法复活。‡鎮西士官要你使用士官砍刀肢解20名斯考恩的溫特斯考恩部族維酷人。',
  }
},
[11247] = {
  {
    'Queime, Skorn, queime!‡Гори, Скорн, гори!‡Brenne, Skorn - brenne!‡불타라, 스코른이여!‡¡Arde, Skorn, arde!‡¡Arde, Skorn, arde!‡Brûle, Mörg, brûle !‡燃烧吧，斯克恩，燃烧吧！‡燒啊，斯考恩，燒啊!',
    nil,
    'O Sargento da Guarda Oeste recebeu ordens indicando que você deve usar a Tocha do Sargento para incendiar as Casas Comunais do Nordeste e do Noroeste e a Guarnição de Skorn.‡Сержант из крепости Западной Стражи поручил вам поджечь два больших дома и казармы в Скорне.‡Der Unteroffizier der Westwacht hat Befehle erhalten, nach denen Ihr mit der Fackel des Unteroffiziers die beiden Langhäuser und die Kaserne in Skorn in Brand stecken sollt.‡서부경비대 하사관이 하사관의 횃불을 사용해 스코른에 있는 북동쪽 공동주택, 북서쪽 공동주택, 병영을 불태워 달라고 했습니다.‡El sargento de la Guardia Oeste tiene órdenes de que, con la antorcha de Sargento, prendas fuego a las casas comunales del noreste y noroeste y a los barracones de Skorn.‡El sargento de la Guardia Oeste tiene órdenes de que, con la antorcha de Sargento, prendas fuego a las casas comunales del noreste y noroeste y a los barracones de Skorn.‡Le Sergent de la Garde de l’ouest vous a ordonné de mettre le feu aux maisons longues du nord-est et du nord-ouest et à la caserne de Mörg, à l\'aide de la Torche du sergent.‡西部卫戍军士要你前往斯克恩，利用军士的火炬烧毁东北方的长屋、西北方的长屋以及兵营。‡鎮西士官奉命要你使用士官火炬，在斯考恩東北與西北邊的長屋以及兵營縱火。',
  }
},
[11248] = {
  {
    'Operação: ira de Skorn‡Операция: Атака на Скорн‡Operation: Skorns Zorn‡작전: 조롱과 분노‡Operación: cólera de Skorn‡Operación: cólera de Skorn‡Opération Croque-Mörg‡行动代号：斯克恩之怒‡行動:斯考恩之怒',
    nil,
    'O Capitão Carneiro quer que você use a Insígnia de Comando da Guarda Oeste em Skorn e então fale com o Sargento de Guarda Oeste.‡Капитан Адамс попросил вас воспользоваться знаком отличия командира Западной Стражи в Скорне и поговорить с сержантом из крепости Западной Стражи.‡Hauptmann Adams möchte, dass Ihr die Befehlsinsignie der Westwacht in Skorn benutzt und anschließend mit dem Unteroffizier der Westwacht sprecht.‡경비대장 아담스가 스코른에서 서부경비대 지휘관 계급장을 사용한 다음 서부경비대 하사관과 대화해 달라고 했습니다.‡El capitán Adams te ha pedido que uses la insignia de mando de la Guardia Oeste en Skorn, y que después hables con el Sargento de la Guardia Oeste.‡El capitán Adams te ha pedido que uses la insignia de mando de la Guardia Oeste en Skorn, y que después hables con el Sargento de la Guardia Oeste.‡Le capitaine Adams vous a demandé d’utiliser l’Insigne de commandement de la Garde de l’ouest à Mörg, puis de parler avec le Sergent de la Garde de l’ouest.‡亚当斯上尉要你前往斯克恩，在那里使用西部卫戍令牌，然后跟西部卫戍军士谈一谈。‡亞當斯隊長要你在斯考恩使用鎮西指揮徽記，然後與鎮西士官談談。',
  }
},
[11249] = {
  {
    'Pare a ascensão!‡Остановить вознесение!‡Verhindert seinen Aufstieg!‡승천을 막아라!‡¡Detén la ascensión!‡¡Detén la ascensión!‡Arrêter l\'ascension !‡阻止升华！‡阻止飛升!',
    nil,
    'Apresente o Pergaminho Vraikal de Ascensão próximo à pira para chamar e matar o Thane. Em seguida, devido à natureza do ritual, o Padre Levariol, na Bastilha da Guarda Oeste, se interessará em ver o pergaminho.‡Разверните врайкульский свиток вознесения рядом с погребальным костром тана, призовите и убейте его. Исходя из магической природы ритуала, вы можете предположить, что отцу Левариолу из Крепости Западной Стражи будет очень интересно взглянуть на этот свиток.‡Präsentiert die Vrykulrolle des Aufstiegs in der Nähe des Scheiterhaufens vor der Hütte des Thans, um ihn herauszurufen und ihn niederzustrecken. Ihr seid Euch sicher, dass Vater Levariol an dem Ritual und damit auch an der Schriftrolle Interesse finden wird. Er befindet sich in Westwacht.‡영주의 장작불 근처에서 브리쿨 승천의 두루마리를 펼쳐 영주를 불러내 처치한 다음, 서부경비대 성채에 있는 신부 레바리올에게 알리십시오. 의식의 성격으로 볼 때 두루마리를 보고 싶어 할 것 같습니다.‡Presenta el Pergamino de ascensión vrykul cerca de la pira del señor feudal para hacerle salir y matarlo. Después, debido a la naturaleza del ritual, estás seguro de que a Padre Levariol, en la Fortaleza de la Guardia Oeste, le interesará ver el pergamino.‡Presenta el Pergamino de ascensión vrykul cerca de la pira del señor feudal para hacerle salir y matarlo. Después, debido a la naturaleza del ritual, estás seguro de que a Padre Levariol, en la Fortaleza de la Guardia Oeste, le interesará ver el pergamino.‡Utilisez le Parchemin d’ascension vrykul près du Bûcher du thane pour faire venir ce dernier et le tuer. Lorsque ce sera fait, vous êtes sûr que le Père Levariol, au Donjon de la Garde de l’ouest, sera intéressé par le parchemin, en raison de la nature du rituel.‡在领主的火堆附近展开维库升华卷轴，召唤出维库领主并杀死他。完成以后，鉴于这种仪式的性质，你确信西部卫戍要塞里的莱瓦里安神父会对这张卷轴感兴趣。‡在族長的柴堆附近使用維酷飛升卷軸將他召喚出來並殺掉他。之後，由於儀式的類型，你確定鎮西要塞的雷瓦瑞爾神父肯定會對這份卷軸很感興趣。',
  }
},
[11250] = {
  {
    'Um viva para o conquistador de Skorn!‡Слава покорителю Скорна!‡Hoch lebe der Eroberer von Skorn!‡스코른 정복자에게 경의를!‡¡Aclamad todos al conquistador de Skorn!‡¡Aclamad todos al conquistador de Skorn!‡Gloire au conquérant de Mörg !‡向斯克恩的征服者致敬！‡斯考恩征服者萬歲!',
    nil,
    'Devolva a Insígnia de Comando da Guarda Oeste para o Capitão Carneiro na Bastilha da Guarda Oeste.‡Отнесите знак отличия командира Западной Стражи капитану Адамсу в Крепость Западной Стражи.‡Bringt die Befehlsinsigne der Westwacht zu Hauptmann Adams zurück. Ihr findet ihn in Westwacht.‡서부경비대 성채에 있는 경비대장 아담스에게 서부경비대 지휘관 계급장을 돌려줘야 합니다.‡Devuélvele la Insignia de mando de la Guardia Oeste al capitán Adams en la Fortaleza de la Guardia Oeste.‡Devuélvele la Insignia de mando de la Guardia Oeste al capitán Adams en la Fortaleza de la Guardia Oeste.‡Allez rendre l’Insigne de commandement de la Garde de l’ouest au Capitaine Adams, au Donjon de la Garde de l’ouest.‡将西部卫戍令牌交给西部卫戍要塞的亚当斯上尉。‡將鎮西指揮徽記還給鎮西要塞的亞當斯隊長。',
  }
},
[11251] = {
  {
    'Ver com novos olhos‡С новыми силами‡Ein neuer Abschnitt‡새로운 전력‡Piernas frescas‡Piernas frescas‡Un second souffle‡跑腿侦查‡接棒人',
    nil,
    'A Batedora Valéria quer que você investigue o barulho de batalha que vem do nordeste da Aldeia Caveira de Dragão.‡Разведчица Валори просит вас узнать, что за звуки битвы доносятся из-за холма на северо-востоке Деревни Драконьего Черепа.‡Kundschafterin Valory möchte, dass Ihr den Geräuschen nachgeht, die vom nordöstlichen Teil von Wyrmskol herstammen.‡정찰병 발로리가 고룡해골 마을 북동쪽에서 들려오는 싸움 소리를 조사해 달라고 했습니다.‡La exploradora Valory quiere que investigues los sonidos de batalla procedentes del noreste del Poblado Calavermis.‡La exploradora Valory quiere que investigues los sonidos de batalla procedentes del noreste del Poblado Calavermis.‡L’Éclaireur Valory veut que vous enquêtiez sur les bruits de combat qui viennent du nord-est de Crâne-du-ver.‡斥候瓦罗瑞要你前往龙颅村的东北方调查情况。‡斥候維樂利要你調查從龍顱村東北邊傳來的戰鬥聲響。',
  }
},
[11252] = {
  {
    'Para Utgarde!‡На Утгард!‡Nach Utgarde!‡우트가드로!‡¡A Utgarde!‡¡A Utgarde!‡Dans Utgarde !‡杀入乌特加德！‡進入俄特加德!',
    nil,
    'O Defensor Mordun incumbiu você de executar Ingvar, o Ladravaz, que mora em Utgarde.|n|nEm seguida, entregue a cabeça de Ingvar para o Vice-almirante Castro.‡Защитник Мордун поручил вам казнить Ингвара Грабителя, который обитает в Утгарде, и принести его голову вице-адмиралу Келлеру.‡Verteidiger Mordun hat Euch mit der Exekution von Ingvar dem Brandschatzer, der tief in Utgarde wohnt, beauftragt.|n|nAnschließend sollt Ihr dessen Kopf zu Vizeadmiral Keller bringen.‡수호병 모르둔이 우트가드 깊은 곳에 사는 약탈자 잉그바르를 처치해 달라고 했습니다.|n|n일을 마치면 그 증거를 부제독 켈러에게 가져가야 합니다.‡El defensor Mordun te ha encargado la ejecución de Ingvar el Desvalijador que reside en las profundidades de Utgarde.|n|nLlévale su cabeza al Vicealmirante Keller.‡El defensor Mordun te ha encargado la ejecución de Ingvar el Desvalijador que reside en las profundidades de Utgarde.|n|nLlévale su cabeza al Vicealmirante Keller.‡Le Défenseur Mordun vous a demandé de tuer Ingvar le Pilleur, qui réside dans les profondeurs d’Utgarde.|n|nLorsque ce sera fait, vous devez présenter sa tête au Vice-amiral Keller.‡防御者墨尔顿指派你去消灭乌特加德城堡的劫掠者因格瓦尔。|n|n将因格瓦尔的徽记交给凯勒中将。‡防衛者摩丹要你去殺死住在俄特加德深處的『盜掠者』因格瓦。|n|n然後把他的頭交給海軍中將凱勒。',
  }
},
[11253] = {
  {
    'Farejar o inimigo‡По следу врага‡Den Feind ausschnüffeln‡냄새로 찾아라‡Sigue la pista del enemigo‡Sigue la pista del enemigo‡Renifler l\'ennemi‡嗅出敌人‡嗅出敵人',
    nil,
    'Use a Correia de Cão Pestilento próximo às jaulas de cães pestilentos em Porto Vendeta e procure pistas aonde o Cão Pestilento levar você.‡Воспользуйтесь ошейником чумного пса и заберите из клетки в Лагере Возмездия чумного пса-ищейку. Идите с ним по следу, куда бы он вас не привел.‡Benutzt die Seuchenhundleine in der Nähe der Seuchenhundkäfige im Hafen der Vergeltung und sucht dort nach Hinweisen, wo der Seuchenhundfährtenleser Euch hinführt.‡복수의 상륙지에 있는 역병사냥개 우리 근처에서 역병사냥개 목줄을 사용하십시오. 훈련받은 역병사냥개를 불러낸 다음 따라가서 단서를 찾아야 합니다.‡Utiliza la correa de can de peste junto a las jaulas de can de peste en Campo Venganza y busca pistas en el lugar al que te lleve el can de peste rastreador.‡Utiliza la correa de can de peste junto a las jaulas de can de peste en Campo Venganza y busca pistas en el lugar al que te lleve el can de peste rastreador.‡Utilisez la Laisse de chien pestiféré près des cages des chiens pestiférés à l’Accostage de la Vengeance, et cherchez les indices là où vous conduira le Chien pestiféré traqueur.‡在复仇港的天灾犬笼子附近使用天灾犬绳，然后在天灾猎犬的带领下仔细搜寻线索。‡在復仇臺地的瘟疫獵犬鐵籠附近使用瘟疫獵犬之鍊，然後在瘟疫追蹤獵犬所帶你去的地點尋找線索。',
  }
},
[11254] = {
  {
    'O mapa de pele de dragão‡Карта на шкуре дракона‡Die Karte aus Drachenhaut‡용가죽 지도‡El mapa de piel de dragón‡El mapa de piel de dragón‡La carte en peau de dragon‡龙皮地图‡龍皮地圖',
    nil,
    'Entregue o Mapa de Pele de Dragão para o alto-executor Anselmo no Porto Vendeta.‡Принесите карту на шкуре дракона верховному палачу Ансельму в Лагерь Возмездия.‡Bringt die Karte aus Drachenhaut zu Hochexekutor Anselm im Hafen der Vergeltung.‡용가죽 지도를 복수의 상륙지에 있는 고위집행관 안셀름에게 가져가야 합니다.‡Lleva el mapa de piel de dragón al sumo ejecutor Anselm en Campo Venganza.‡Lleva el mapa de piel de dragón al sumo ejecutor Anselm en Campo Venganza.‡Apportez la Carte en peau de dragon au Grand exécuteur Anselme à l’Accostage de la Vengeance.‡将龙皮地图交给复仇港的高级执行官安希尔姆。‡把龍皮地圖交給復仇臺地的高階執行官安賽姆。',
  }
},
[11255] = {
  {
    'Prisioneiros da Caveira de Dragão‡Пленники в Деревне Драконьего Черепа‡Gefangene in Wyrmskol‡고룡해골의 포로‡Prisioneros de Calavermis‡Prisioneros de Calavermis‡Les prisonniers de Crâne-du-ver‡龙颅村的囚犯‡龍顱囚犯',
    nil,
    'O Vice-almirante Castro, do Porto de Valgarde, no Fiorde Uivante, quer que você resgate 3 Cidadãos de Valgarde Capturados.‡Вице-адмирал Келлер из Валгардского порта в Ревущем фьорде просит вас спасти 3 пленных валгардских узников.‡Vizeadmiral Keller im Hafen von Valgarde im Heulenden Fjord möchte, dass Ihr 3 Gefangene aus Valgarde befreit.‡울부짖는 협만의 발가드 항만에 있는 부제독 켈러가 사로잡힌 발가드 포로 3명을 구출해 달라고 했습니다.‡El vicealmirante Keller en el Puerto de Valgarde, en el Fiordo Aquilonal, quiere que rescates a 3 prisioneros de Valgarde.‡El vicealmirante Keller en el Puerto de Valgarde, en el Fiordo Aquilonal, quiere que rescates a 3 prisioneros de Valgarde.‡Le Vice-amiral Keller, au port de Valgarde dans le Fjord hurlant, veut que vous sauviez 3 Prisonniers de Valgarde capturés.‡嚎风峡湾瓦加德港口的凯勒中将要你营救3名被俘虏的瓦加德囚犯。‡海軍中將凱勒要你去解救3個被俘虜的瓦爾加德囚犯。他就在凜風峽灣的瓦爾加德港口。',
  }
},
[11256] = {
  {
    'Skorn tem que cair!‡Скорн должен пасть!‡Skorn muss fallen!‡스코른을 함락시켜라!‡¡Skorn debe caer!‡¡Skorn debe caer!‡Mörg doit tomber !‡进攻斯克恩！‡拿下斯考恩!',
    nil,
    'O Chefe Totem de Cinzas quer que você use o Emblema dos Casco Invernal em Skorn e então fale com o Valente Casco Invernal.‡Вождь Прахтотем попросил вас воспользоваться эмблемой Заиндевевшего Копыта в Скорне и поговорить с храбрецом из Лагеря Заиндевевшего Копыта.‡Häuptling Aschtotem möchte, dass Ihr das Emblem der Winterhufe in Skorn benutzt und dann mit dem Helden der Winterhufe sprecht.‡족장 애쉬토템이 스코른에서 겨울발굽 문장을 사용한 다음 겨울발굽 용사와 대화해달라고 했습니다.‡El cabecilla Tótem de Ceniza te ha pedido que uses el Emblema de Pezuña Invernal en Skorn y después hables con el Valiente Pezuña Invernal.‡El cabecilla Tótem de Ceniza te ha pedido que uses el Emblema de Pezuña Invernal en Skorn y después hables con el Valiente Pezuña Invernal.‡Le Chef Totem-de-frêne vous a demandé d’utiliser l’Emblème de Sabot-d’hiver à Mörg, puis de parler avec le Brave Sabot-d’hiver.‡灰烬图腾酋长要求你前往斯克恩，在那里使用冬蹄徽章，然后与冬蹄勇士谈一谈。‡灰燼圖騰酋長要求你在斯考恩使用冬蹄紋章，與冬蹄勇者交談。',
  }
},
[11257] = {
  {
    'Repulsivo, mas necessário‡Тяжело, но необходимо‡Grausam, aber notwendig‡브리쿨의 영혼‡Horripilante, pero necesario‡Horripilante, pero necesario‡Salissant, mais nécessaire‡可怕而必要的手段‡駭人聽聞的必要工作',
    nil,
    'O Valente da Casco Invernal quer que você use o Facão do Valente para desmembrar 20 Vraikalen da tribo Hiberfel, em Skorn.‡Храбрец из лагеря Заиндевевшего Копыта попросил вас разрубить на куски 20 снежескорнских врайкулов в Скорне.‡Der Held der Winterhufe möchte, dass Ihr mit der Machete des Kriegerhelden 20 Vrykul des Winterskornstammes in Skorn zerstückelt.‡겨울발굽 용사가 용사의 마체테를 사용하여 스코른에 있는 윈터스코른 부족의 브리쿨 20명의 영혼을 수습해 달라고 했습니다.‡El valiente Pezuña Invernal te ha pedido que uses el machete de Valiente para desmembrar a 20 vrykuls de la tribu Inbjerskorn en Skorn.‡El valiente Pezuña Invernal te ha pedido que uses el machete de Valiente para desmembrar a 20 vrykuls de la tribu Inbjerskorn en Skorn.‡Le Brave Sabot-d’hiver vous a demandé de démembrer 20 Vrykuls Mörghiver, à Mörg, à l\'aide de la Machette du brave.‡冬蹄营地勇士要你前往斯克恩，利用勇士的弯刀确保20个斯克恩部族的维库人无法复活。‡冬蹄勇者要你使用勇者砍刀支解20名斯考恩的溫特斯考恩部族維酷人。',
  }
},
[11258] = {
  {
    'Queime, Skorn, queime!‡Гори, Скорн, гори!‡Brenne, Skorn - brenne!‡불타라 스코른, 다 타버려라!‡¡Arde, Skorn, arde!‡¡Arde, Skorn, arde!‡Brûle, Mörg, brûle !‡燃烧吧，斯克恩，燃烧吧！‡燒啊，斯考恩，燒啊!',
    nil,
    'O Valente da Casco Invernal está sugerindo que você use a Tocha do Valente para incendiar as Casas Comunais do Nordeste e do Noroeste e a Guarnição de Skorn.‡Храбрец из Лагеря Заиндевевшего Копыта поручил вам поджечь северо-восточный большой дом, северо-западный большой дом и казармы в Скорне с помощью его факела. Когда дело будет сделано, поговорите с ним еще раз.‡Der Held der Winterhufe schlägt vor, dass Ihr mit der Fackel des Helden die zwei Langhäuser im Nordosten und -westen und die Baracken in Skorn in Brand setzt.‡겨울발굽 용사가 용사의 횃불을 사용하여 스코른에 있는 북서쪽 공동주택과 북동쪽 공동주택, 병영에 불을 놓으라고 했습니다.‡El valiente Pezuña Invernal te ha sugerido que uses la antorcha de Valiente para prender fuego a las casas comunales noreste y noroeste y a los barracones de Skorn.‡El valiente Pezuña Invernal te ha sugerido que uses la antorcha de Valiente para prender fuego a las casas comunales noreste y noroeste y a los barracones de Skorn.‡Le Brave Sabot-d’hiver suggère que vous mettiez le feu aux deux maisons longues les plus basses et à la caserne de Mörg à l\'aide de la Torche du brave.‡冬蹄勇士建议你前往斯克恩，利用勇士的火炬烧毁东北方的长屋、西北方的长屋以及兵营。‡冬蹄勇者建議你使用勇者火炬，在斯考恩東北與西北邊的長屋以及兵營縱火。',
  }
},
[11259] = {
  {
    'Torres da morte certa‡Смертельно опасные башни‡Türme des sicheren Untergangs‡파멸이 예정된 탑‡Torres de cierta fatalidad‡Torres de cierta fatalidad‡Les tours de la fatalité‡危险的塔楼‡厄運的哨塔',
    nil,
    'O Valente da Casco Invernal informou a você que seria aconselhável usar a Tocha do Valente para sinalizar as quatro torres de Skorn como alvo para ataques aéreos.‡Храбрец из Лагеря Заиндевевшего Копыта сообщил вам, что сторожевые башни Скорна разумнее всего разрушить атакой с воздуха, предварительно отметив их местонахождение с помощью сигнальной ракеты Храбреца.‡Der Held der Winterhufe meint, dass es sinnvoll wäre, wenn man mit dem Leuchtsignal des Kriegerhelden die Türme in Skorn für Luftangriffe markiert.‡겨울발굽 용사가 용사의 신호탄으로 스코른에 있는 탑 4개에 공습 표시를 해야 한다고 했습니다.‡El valiente Pezuña Invernal te ha informado de que sería conveniente usar la bengala de Valiente para fijar las cuatro torres de Skorn como objetivos para ataques aéreos.‡El valiente Pezuña Invernal te ha informado de que sería conveniente usar la bengala de Valiente para fijar las cuatro torres de Skorn como objetivos para ataques aéreos.‡Le Brave Sabot-d’hiver vous a informé qu’il serait souhaitable de marquer les quatre tours de Mörg en prévision de frappes aériennes à l\'aide du Fumigène du brave.‡冬蹄勇士要你前往斯克恩，利用勇士的烟幕弹为空袭部队标记四座塔楼的位置。‡冬蹄勇者告訴你使用勇者信號彈標記出所有的四座斯考恩哨塔，以利空襲成功。',
  }
},
[11260] = {
  {
    'Pare a ascensão!‡Остановить вознесение!‡Verhindert seinen Aufstieg!‡승천을 막아라!‡¡Detén la ascensión!‡¡Detén la ascensión!‡Arrêter l\'ascension !‡阻止升华！‡阻止飛升!',
    nil,
    'Leve o Pergaminho Vraikal de Ascensão à pira para evocar e matar o Thane. Isto feito, você tem certeza que a anciã Ankha, da Aldeia Casco Invernal, se interesserá pelo pergaminho, devido à natureza do ritual.‡Разверните врайкульский свиток вознесения рядом с погребальным костром тана, призовите и убейте его. Исходя из магической природы ритуала, вы можете предположить, что Великой Матери Анкхе из Лагеря Заиндевевшего Копыта будет очень интересно взглянуть на этот свиток.‡Präsentiert die Vrykulrolle des Aufstiegs in der Nähe des Scheiterhaufens vor der Hütte des Thans, um ihn herauszurufen und ihn niederzustrecken. Ihr seid Euch sicher, dass Großmutter Ankha an dem Ritual und damit auch an der Schriftrolle Interesse finden wird. Sie befindet sich im Lager der Winterhufe.‡영주의 장작불 근처에서 브리쿨 승천의 두루마리를 사용하여 영주를 불러낸 다음 처치해야 합니다. 그리고서 겨울발굽 야영지에 있는 대모 안카에게 알리십시오. 두루마리에 그려진 의식이 기묘하기 때문에, 대모 안카가 관심을 둘 듯합니다.‡Presenta el Pergamino de ascensión vrykul cerca de la pira del señor feudal para hacerle salir y matarlo. Después, debido a la naturaleza del ritual, estás seguro de que a la abuela Ankha del Campamento Pezuña Invernal le interesará ver el pergamino.‡Presenta el Pergamino de ascensión vrykul cerca de la pira del señor feudal para hacerle salir y matarlo. Después, debido a la naturaleza del ritual, estás seguro de que a la abuela Ankha del Campamento Pezuña Invernal le interesará ver el pergamino.‡Utilisez le Parchemin d’ascension vrykul près du Bûcher du thane pour faire apparaître ce dernier et le tuer. Lorsque ce sera fait, vous êtes sûr que la Grande-mère Ankha, au Camp Sabot-d’hiver, sera intéressée par le parchemin, en raison de la nature du rituel.‡在领主的火堆附近展开维库升华卷轴，召唤出维库领主并杀死他。完成以后，鉴于这种仪式的性质，你确信冬蹄营地里的安卡祖母会对这张卷轴感兴趣。‡在族長的柴堆附近使用維酷飛升卷軸將他召喚出來並殺掉他。之後，由於儀式的類型，你確定冬蹄營地的主母安卡會對這份卷軸相當感興趣。',
  }
},
[11261] = {
  {
    'O conquistador de Skorn!‡Покоритель Скорна!‡Der Bezwinger von Skorn!‡스코른 정복자!‡¡El conquistador de Skorn!‡¡El conquistador de Skorn!‡Le conquérant de Mörg‡斯克恩的征服者！‡斯考恩征服者!',
    nil,
    'Fale novamente com o Chefe Totem de Cinzas na Aldeia Casco Invernal.‡Верните эмблему Зимнего Копыта вождю Прахтотему в Лагерь Заиндевевшего Копыта.‡Bringt das Zeichen der Winterhufe zu Häuptling Aschtotem im Lager der Winterhufe zurück.‡겨울발굽 문장을 겨울발굽 야영지에 있는 족장 애쉬토템에게 돌려줘야 합니다.‡Devuelve el tótem Pezuña Invernal al cabecilla Tótem de Ceniza del Campamento Pezuña Invernal.‡Devuelve el tótem Pezuña Invernal al cabecilla Tótem de Ceniza del Campamento Pezuña Invernal.‡Allez rendre l’Emblème Sabot-d’hiver au Chef Totem-de-frêne, au Camp Sabot-d’hiver.‡将冬蹄徽章交给冬蹄营地的灰烬图腾酋长。‡將冬蹄紋章交給冬蹄營地的灰燼圖騰酋長。',
  }
},
[11262] = {
  {
    'Ingvar tem que morrer!‡Ингвар должен умереть!‡Ingvar muss sterben!‡잉그바르를 처단하라!‡¡Ingvar ha de morir!‡¡Ingvar ha de morir!‡Ingvar doit mourir !‡除掉因格瓦尔！‡因格瓦非死不可!',
    nil,
    'A Patrulheira Sombria Marrah pediu para você matar Ingvar, o Ladravaz, na Bastilha Utgarde.‡Темный следопыт Марра просит вас убить Ингвара Расхитителя в Крепости Утгард.‡Dunkelläuferin Marrah möchte, dass Ihr Ingvar den Brandschatzer in Burg Utgarde tötet.‡어둠 순찰자 마라가 우트가드 성채에 있는 약탈자 잉그바르를 처치해 달라고 했습니다.‡La forestal oscura Marrah te ha pedido que mates a Ingvar el Desvalijador en la Fortaleza de Utgarde.‡La forestal oscura Marrah te ha pedido que mates a Ingvar el Desvalijador en la Fortaleza de Utgarde.‡Le Forestier-sombre Marrah vous a demandé de tuer Ingvar le Pilleur à l’intérieur du Donjon d\'Utgarde.‡黑暗游侠玛尔拉要求你杀死乌特加德城堡内的劫掠者因格瓦尔。‡黑暗遊俠瑪拉請求你殺死俄特加德要塞的『盜掠者』因格瓦。',
  }
},
[11263] = {
  {
    'Dando cabo de Gjalerbron‡Очистить Гьялерброн‡Mit Gjalerbron fertig werden‡샬레르브론 처리‡Encargarse de Gjalerbron‡Encargarse de Gjalerbron‡S\'occuper de Gjalerbron‡亚勒伯龙的麻烦‡對付夏勒布隆',
    nil,
    'O Chefe Totem de Cinzas quer que você mate 15 Guerreiros de Gjalerbron, 8 Lança-runas de Gjalerbron e 8 Guarda-sonhos de Gjalerbron. Em seguida, fale novamente com ele na Aldeia Casco Invernal.‡Вождь Прахтотем попросил вас убить 15 гьялербронских воинов, 8 гьялербронских руночаров и 8 гьялербронских сноходцев, после чего вернитесь в Лагерь Заиндевевшего Копыта.‡Häuptling Aschtotem hat Euch gebeten, 15 Krieger von Gjalerbron, 8 Runenmagier von Gjalerbron und 8 Schlafwächter von Gjalerbron zu töten. Kehrt im Anschluss zu ihm im Lager der Winterhufe zurück.‡족장 애쉬토템이 샬레르브론 전사 15명, 샬레르브론 룬마술사 8명, 그리고 샬레르브론 수면의 감시자 8명을 처치해 달라고 했습니다. 임무를 완수하면 겨울발굽 야영지에 있는 족장 애쉬토템에게 가야 합니다.‡El cabecilla Tótem de Ceniza te ha pedido que mates 15 guerreros de Gjalerbron, 8 taumaturgos de runas de Gjalerbron y 8 vigías del sueño de Gjalerbron. Después vuelve a verle al Campamento Pezuña Invernal.‡El cabecilla Tótem de Ceniza te ha pedido que mates 15 guerreros de Gjalerbron, 8 taumaturgos de runas de Gjalerbron y 8 vigías del sueño de Gjalerbron. Después vuelve a verle al Campamento Pezuña Invernal.‡Le Chef Totem-de-frêne vous a demandé de tuer 15 Guerriers de Gjalerbron, 8 Lanceurs de runes de Gjalerbron et 8 Gardiens du sommeil de Gjalerbron. Ensuite, revenez le voir au Camp Sabot-d’hiver.‡灰烬图腾酋长要你杀死15个亚勒伯龙战士、8个亚勒伯龙符文法师和8个亚勒伯龙沉睡卫士，然后返回冬蹄营地向他复命。‡灰燼圖騰酋長要求你殺掉15名夏勒布隆戰士、8名夏勒布隆符文使和8名夏勒布隆守眠者。事成之後，回到冬蹄營地向他回報。',
  }
},
[11264] = {
  {
    'Necrolorde supremo Mezhen‡Некровладыка Мезхен‡Nekrogroßfürst Mezhen‡강령 대군주 메젠‡Necroseñor Supremo Mezhen‡Necroseñor Supremo Mezhen‡Le nécro-suzerain Mezhen‡通灵主宰麦森‡死靈主宰梅贊',
    nil,
    'Mate o Necrolorde Supremo Mezhen. Em seguida, fale novamente com o Chefe Totem de Cinzas na Aldeia Casco Invernal.‡Убейте некровладыку Мезхена. Затем вернитесь к вождю Прахтотему в Лагерь Заиндевевшего Копыта.‡Tötet Nekrogroßfürst Mezhen. Kehrt danach zu Häuptling Aschtotem im Lager der Winterhuf zurück.‡강령 대군주 메젠을 제거한 다음 겨울발굽 야영지에 있는 족장 애쉬토템에게 가야 합니다.‡Mata al Necroseñor Supremo Mezhen y vuelve a ver al cabecilla Tótem de Ceniza en Campamento Pezuña Invernal.‡Mata al Necroseñor Supremo Mezhen y vuelve a ver al cabecilla Tótem de Ceniza en Campamento Pezuña Invernal.‡Tuez le Nécro-suzerain Mezhen, puis retournez voir le Chef Totem-de-frêne au Camp Sabot-d’hiver.‡杀死通灵主宰麦森，然后返回冬蹄营地向灰烬图腾酋长复命。‡殺掉死靈主宰梅贊以後，向冬蹄營地的灰燼圖騰酋長回報。',
  }
},
[11265] = {
  {
    'De chaves e jaulas‡О ключах и клетках‡Von Schlüsseln und Käfigen‡철창과 열쇠‡De llaves y jaulas‡De llaves y jaulas‡Des clés et des cages‡钥匙和牢笼‡鑰匙與牢籠',
    nil,
    'A Anciã Ankha quer que você pegue Chaves da Jaula de Gjalerbron em quantidade suficiente para libertar 10 Prisioneiros de Gjalerbron. Fale novamente com ela, na Aldeia Casco Invernal, após terminar a tarefa.‡Великая Мать Анкха попросила вас собрать достаточное количество ключей от гьялербронских клеток, чтобы освободить 10 гьялербронских узников. Когда вы выполните задание, вернитесь к ней в Лагерь Заиндевевшего Копыта.‡Großmutter Ankha möchte, dass Ihr genug Schlüssel für einen Gjalerbronkäfig sammelt, um 10 Gefangene von Gjalerbron zu befreien. Kehrt zu ihr zurück, sobald Ihr damit fertig seid. Sie befindet sich im Lager der Winterhufe.‡샬레르브론 철창 열쇠를 모아 샬레르브론 포로 10명을 풀어 주고 나서 겨울발굽 야영지에 있는 대모 안카에게 가야 합니다.‡La abuela Ankha te ha pedido que consigas suficientes llaves de jaula de Gjalerbron para liberar a 10 prisioneros de Gjalerbron. Vuelve a verla al Campamento Pezuña Invernal cuando lo hayas conseguido.‡La abuela Ankha te ha pedido que consigas suficientes llaves de jaula de Gjalerbron para liberar a 10 prisioneros de Gjalerbron. Vuelve a verla al Campamento Pezuña Invernal cuando lo hayas conseguido.‡La Grande-mère Ankha vous a demandé de récupérer assez de Clés de cages de Gjalerbron pour libérer 10 Prisonniers de Gjalerbron. Si vous y parvenez, retournez la voir au Camp Sabot-d’hiver.‡安卡祖母要你去搜集足够的亚勒伯龙牢笼钥匙，用它们解救10个亚勒伯龙囚犯。完成任务后返回冬蹄营地向她复命。‡主母安卡要求你收集足夠的夏勒布隆鐵籠鑰匙，將10名夏勒布隆囚犯救出來。當你完成以後，回到冬蹄營地向她回報。',
  }
},
[11266] = {
  {
    'Planos de ataque de Gjalerbron‡Гьялербронский план нападения‡Angriffspläne von Gjalerbron‡샬레르브론 공격 계획서‡Los planes de ataque de Gjalerbron‡Los planes de ataque de Gjalerbron‡Les plans d\'attaque de Gjalerbron‡亚勒伯龙攻击计划‡夏勒布隆攻擊計畫',
    nil,
    'Entregue os Planos de Ataque de Gjalerbron para Celea Crina de Gelo na Aldeia Casco Invernal.‡Отнесите гьялербронский план нападения Целее Ледогрив в Лагерь Заиндевевшего Копыта.‡Übergebt die Angriffspläne von Gjalerbron an Celea Frostmähne. Sie befindet sich im Lager der Winterhufe.‡샬레르브론 공격 계획서를 겨울발굽 야영지에 있는 셀리아 프로즌메인에게 전달해야 합니다.‡Entrégale los planes de ataque de Gjalerbron a Celea Crines de Hielo en el Campamento Pezuña Invernal.‡Entrégale los planes de ataque de Gjalerbron a Celea Crines de Hielo en el Campamento Pezuña Invernal.‡Remettez les Plans d’attaque de Gjalerbron à Celea Crin-gelé, au Camp Sabot-d’hiver.‡将亚勒伯龙攻击计划交给冬蹄营地的塞莉亚·冰鬃。‡將夏勒布隆攻擊計畫送到冬蹄營地交給賽利亞·冰鬃。',
  }
},
[11267] = {
  {
    'A serpe gélida e seu mestre‡Ледяной змей и его повелитель‡Der Frostwyrm und sein Meister‡서리고룡과 주인‡La vermis de escarcha y su maestro‡La vermis de escarcha y su maestro‡Le wyrm de givre et son maître‡冰霜巨龙和它的主人‡冰霜巨龍與它的主人',
    nil,
    'Mate o Arauto Vil da Serpe e use a Corneta do Arauto da Serpe para chamar e matar Glacion. Em seguida, leve a corneta para Celea Crina de Gelo na Aldeia Casco Invernal, no Fiorde Uivante.‡Убейте Зловещего призывателя драконов и воспользуйтесь его рогом, чтобы позвать обратно Ледиона. Убейте ледяного змея и принесите рог Целее Ледогрив в Лагерь Заиндевевшего Копыта.‡Erschlagt Wyrmrufer Elend und benutzt das Wyrmruferhorn, um Glacion herbeizurufen und ihn niederzustrecken. Kehrt anschließend gemeinsam mit dem Horn zu Celea Frostmähne zurück. Sie befindet sich im Lager der Winterhufe.‡용소환사 바일을 처치하고 용소환사의 뿔피리를 사용하여 글라시온을 불러내 처치해야 합니다. 그런 다음 울부짖는 협만의 겨울발굽 야영지에 있는 셀리아 프로즌메인에게 뿔피리를 가져가야 합니다.‡Mata al Clamavermis Vil y usa el cuerno de clamavermis para llamar y matar a Glacion. Después llévale el cuerno a Celea Crines de Hielo al Campamento Pezuña Invernal.‡Mata al Clamavermis Vil y usa el cuerno de clamavermis para llamar y matar a Glacion. Después llévale el cuerno a Celea Crines de Hielo al Campamento Pezuña Invernal.‡Tuez le Mande-wyrm Vile, puis utilisez le Cor mande-wyrm pour appeler Glacion. Tuez-le, et retournez voir Celea Crin-gelé au Camp Sabot-d’hiver avec le cor.‡杀死唤龙者维尔，使用唤龙者的号角召唤并杀死格拉希恩。然后返回冬蹄营地，将号角交给塞莉亚·冰鬃。‡殺了喚龍者惡邪並使用喚龍者號角將加拉希恩召喚下來然後殺掉它。完成後，帶著號角回到冬蹄營地找賽利亞·冰鬃。',
  }
},
[11268] = {
  {
    'Os mortos-que-andam‡Ходячие мертвецы‡Die wandelnden Toten‡걸어다니는 시체‡Los muertos andantes‡Los muertos andantes‡Les morts qui marchent‡行尸走肉‡活屍橫行',
    nil,
    'Mate 10 Guardiões Imortais, 4 Horrores Temerários, e 2 Criaturas Pútridas. Em seguida, relate o sucesso da missão à Anciã Ankha, na Aldeia Casco Invernal.‡Убейте 10 бессмертных дозорных, 4 чудовищных ужаса и 2 тлетворных существа, после чего уведомите Великую Мать Анкху из Лагеря Заиндевевшего Копыта об успешном выполнении поручения.‡Tötet 10 ewige Beobachter, 4 furchterregende Schrecken und 2 eitrige Kreaturen. Bringt anschließend Nachricht Eures Erfolgs zu Großmutter Ankha im Lager der Winterhufe.‡죽지 않는 감시자 10마리, 무시무시한 역병괴물 4마리, 그리고 부패한 망령 2마리를 제거한 다음 겨울발굽 야영지로 가서 대모 안카에게 보고해야 합니다.‡Mata a 10 vigías inextinguibles, 4 horrores aterradores y 2 criaturas pútridas. Después informa de tu éxito a la abuela Ankha del Campamento Pezuña Invernal.‡Mata a 10 vigías inextinguibles, 4 horrores aterradores y 2 criaturas pútridas. Después informa de tu éxito a la abuela Ankha del Campamento Pezuña Invernal.‡Tuez 10 Guetteurs impérissables, 4 Horreurs effroyables et 2 Nécrophages putrides. Lorsque ce sera fait, allez informer de votre succès la Grande-mère Ankha, au Camp Sabot-d’hiver.‡消灭10个不死的看守者、4个可怕的丧尸和2个腐烂的畸形妖，然后返回冬蹄营地向安卡祖母复命。‡殺死10個不滅的看守者、4隻駭人的恐獸和2隻腐爛的活屍。然後，通知主母安卡你的成功，她就在冬蹄營地。',
  }
},
[11269] = {
  {
    'Até o último segundo‡Работаем до упора‡Daunen in letzter Minute‡촉박한 재료 준비‡Esfuerzo final‡Esfuerzo final‡Y laisser des plumes‡羽绒披风‡羽絨之於絲線',
    nil,
    'Gil Griserdo quer que você lhe traga 10 tufos de Pluma de Hipogrifo Malhado.‡Гил Гризерт просит вас принести ему 10 клочков пуха пятнистых гиппогрифов.‡Gil Grisert möchte, dass Ihr ihm 10 Büschel Daunen eines gefleckten Hippogryphen bringt.‡길 그리서트가 점박이 히포그리프 솜털 10뭉치를 가져다 달라고 했습니다.‡Gil Grisert quiere que le lleves 10 montones de plumón de hipogrifo moteado.‡Gil Grisert quiere que le lleves 10 montones de plumón de hipogrifo moteado.‡Gil Grisert veut que vous lui rapportiez 10 touffes de Duvet d’hippogriffe tacheté.‡基尔·克利瑟要你去收集10根斑点角鹰兽的羽毛。‡吉爾·葛瑞斯特要你帶10團斑點角鷹獸羽絨給他。',
  }
},
[11270] = {
  {
    'Guerras são um inferno‡Ужасы войны‡Krieg ist die Hölle‡지옥같이 참혹한 전쟁‡La guerra es un infierno‡La guerra es un infierno‡La guerre, c\'est l\'enfer‡地狱般的战争‡戰爭就是地獄',
    nil,
    'O alto-executor Anselmo, de Porto Vendeta, quer que você pegue a Tocha Ardente e use-a para cremar 10 cadáveres abandonados a oeste da vila.‡Верховный палач Ансельм из Лагеря Возмездия просит вас взять горящий факел и сжечь десять трупов, лежащих к западу от города.‡Hochexekutor Anselm im Hafen der Vergeltung möchte, dass Ihr mithilfe der brennenden Fackel 10 der Leichen, die westlich des Orts herumliegen, verbrennt.‡복수의 상륙지에 있는 고위집행관 안셀름이 불타는 횃불을 사용해 마을 서쪽에 버려진 시체 10구를 태워 달라고 했습니다.‡El sumo ejecutor Anselm en Campo Venganza quiere que cojas la antorcha ardiente y la uses para quemar 10 de los cadáveres desperdigados al oeste de la ciudad.‡El sumo ejecutor Anselm en Campo Venganza quiere que cojas la antorcha ardiente y la uses para quemar 10 de los cadáveres desperdigados al oeste de la ciudad.‡Le Grand exécuteur Anselme, de l’Accostage de la Vengeance, veut que vous preniez la Torche ardente et que vous l’utilisiez pour brûler 10 des cadavres qui se trouvent à l’ouest de la ville.‡复仇港的高级执行官安希尔姆要求你到镇子的西边去，使用净化之炬净化10具尸体。‡復仇臺地的高階執行官安賽姆要你拿著點燃的火炬，使用它燒掉10具被丟棄在城鎮西邊的屍體。',
  }
},
[11271] = {
  {
    'Preparativos apressados‡Спешные приготовления‡Hastige Vorbereitungen‡준비는 미리미리‡Preparativos precipitados‡Preparativos precipitados‡Des préparatifs hâtifs‡物资储备‡加緊準備',
    nil,
    'Aota Gelo Branco, da Aldeia Casco Invernal, quer que você lhe traga 10 tufos de Pluma de Hipogrifo Malhado.‡Ахота Белый Иней из Лагеря Заиндевевшего Копыта просит вас принести ему 10 клочков пуха пятнистых гиппогрифов.‡Ahota Weißfrost im Lager der Winterhufe möchte, dass Ihr ihm 10 Büschel Daunen eines gefleckten Hippogryphen bringt.‡겨울발굽 야영지에 있는 아호타 화이트프로스트가 점박이 히포그리프 솜털 10 뭉치를 가져다 달라고 했습니다.‡Ahota Escarcha Blanca te ha pedido que le traigas 10 plumones de hipogrifo moteado.‡Ahota Escarcha Blanca te ha pedido que le traigas 10 plumones de hipogrifo moteado.‡Ahota Givre-blanc, du Camp Sabot-d’hiver, veut que vous lui rapportiez 10 touffes de Duvet d’hippogriffe tacheté.‡冬蹄营地的安霍塔·白霜要你去收集10根斑点角鹰兽的羽毛。‡冬蹄營地的阿喉塔·白霜要你帶10團斑點角鷹獸羽絨給他。',
  }
},
[11272] = {
  {
    'Ajuste de contas‡Сведение счетов‡Eine Rechnung begleichen‡받은 만큼 돌려주기‡Ajuste de cuentas‡Ajuste de cuentas‡Un compte à régler‡旗开得胜‡有待解決的宿怨',
    nil,
    'O Alto-executor Anselmo quer que você mate o Príncipe Keleseth na Bastilha Utgarde.‡Верховный палач Ансельм велел вам отправиться в Утгард и убить принца Келесета.‡Hochexekutor Anselm möchte, dass Ihr Prinz Keleseth in Burg Utgarde tötet.‡고위집행관 안셀름이 우트가드 성채 안에 있는 공작 켈레세스를 처치해 달라고 했습니다.‡El sumo ejecutor Anselm quiere que mates al príncipe Keleseth en la Fortaleza de Utgarde.‡El sumo ejecutor Anselm quiere que mates al príncipe Keleseth en la Fortaleza de Utgarde.‡Le Grand exécuteur Anselme vous demande de tuer le prince Keleseth à l’intérieur du Donjon d\'Utgarde.‡高级执行官安希尔姆要求你进入乌特加德城堡，杀死凯雷塞斯王子。‡高階執行官安賽姆要你進入俄特加德要塞並殺掉凱雷希斯親王。',
  }
},
[11273] = {
  {
    'A liga dos humanos‡Объединение людей‡Die Menschenliga‡인간들의 연맹‡La liga de los humanos‡La liga de los humanos‡La ligue humaine‡协会的发现‡人類同盟',
    nil,
    'Procure Pulroy na Aldeia Caveira de Dragão.‡Найдите Пулроя в Деревне Драконьего Черепа.‡Sucht Wyrmskol nach Pulroy ab.‡고룡해골 마을에서 풀로이를 찾아야 합니다.‡Busca a Pulroy en el Poblado Calavermis.‡Busca a Pulroy en el Poblado Calavermis.‡Fouillez Crâne-du-ver à la recherche de Pulroy.‡在龙颅村内搜寻普罗伊。‡在龍顱村尋找普爾羅伊。',
  }
},
[11274] = {
  {
    'Zedd provavelmente está morto‡Зедд мертв, детка?‡Zedd ist wahrscheinlich tot‡위험에 빠진 제드‡Es probable que Zedd esté muerto‡Es probable que Zedd esté muerto‡Zedd est probablement mort‡塞德也许已经死了‡齊德可能死了',
    nil,
    'Procure Zedd na Aldeia Caveira de Dragão.‡Найдите Зедда в Деревне Драконьего Черепа.‡Sucht Wyrmskol nach Zedd ab.‡고룡해골 마을에서 제드를 찾아야 합니다.‡Busca a Zedd en el Poblado Calavermis.‡Busca a Zedd en el Poblado Calavermis.‡Fouiller le village de Crâne-du-ver à la recherche de Zedd.‡在龙颅村内搜寻塞德。‡在龍顱村搜尋齊德。',
  }
},
[11275] = {
  {
    'Tocando o berrante‡Охотничий рог‡Das Horn schnitzen‡뿔피리 만들기‡Haciendo el cuerno‡Haciendo el cuerno‡Fabriquer le cor‡制作号角‡製作號角',
    nil,
    'Nakoma Vidente da Neve, da Aldeia Casco Invernal, quer que você lhe traga 6 Chifres Intactos de Carneiro.‡Нокома Заклинатель Снегов из Лагеря Заиндевевшего Копыта просит вас принести ей 6 неповрежденных рогов барана.‡Nokoma Schneeseher im Lager der Winterhufe möchte, dass Ihr ihr 6 unbeschädigte Widderhörner bringt.‡겨울발굽 야영지에 있는 노코마 스노우시어가 온전한 산양 뿔 6개를 가져다 달라고 했습니다.‡Nokoma Vidente de la Nieve del Campamento Pezuña Invernal quiere que le lleves 6 cuernos de carnero sin estropear.‡Nokoma Vidente de la Nieve del Campamento Pezuña Invernal quiere que le lleves 6 cuernos de carnero sin estropear.‡Nokoma Œil-des-neiges, au camp Sabot-d’hiver, veut que vous lui rapportiez 6 Cornes de bélier intactes.‡冬蹄营地的诺库玛·雪眼要你将6只完整的羊角交给她。‡冬蹄營地的諾可瑪·雪先知要你帶6個未受損傷的山羊角給她。',
  }
},
[11276] = {
  {
    'Éramos dois...‡И их осталось двое...‡Und da waren es Zwei...‡그리고 두 명이 있었다‡Solo quedaban dos...‡Solo quedaban dos...‡Ils étaient deux‡失踪的两人……‡還有兩個……',
    nil,
    'Procure Glorenfeld nas Catacumbas de Utgarde.‡Обыщите Катакомбы Утгард в поисках Глоренфелда.‡Sucht in den Katakomben von Utgarde nach Glorenfeld.‡우트가드 지하묘지에서 글로렌펠드를 찾아야 합니다.‡Busca a Glorenfeld en las Catacumbas de Utgarde.‡Busca a Glorenfeld en las Catacumbas de Utgarde.‡Fouillez les Catacombes d\'Utgarde à la recherche de Glorenfeld.‡在乌特加德墓穴内搜寻格罗菲尔德。‡到俄特加德墓窖搜找葛羅倫費德。',
  }
},
[11277] = {
  {
    'As profundezas da perversidade‡Глубины порока‡Die Tiefen des Anrüchigen‡부패의 심연‡Las profundidades de la depravación‡Las profundidades de la depravación‡Les profondeurs de la dépravation‡堕落的深渊‡邪惡深淵',
    nil,
    'Glorenfeld, das Catacumbas de Utgarde, quer que você recolha 10 Tabuletas da Caveira de Dragão.‡Глоренфелд из Катакомб Утгард просит вас собрать 10 табличек Драконьего Черепа.‡Glorenfeld in den Katakomben von Utgarde möchte, dass Ihr 10 Wyrmskoltafeln einsammelt.‡우트가드 지하묘지에 있는 글로렌펠드가 고룡해골 서판 10개를 모아 달라고 했습니다.‡Glorenfeld, de las Catacumbas de Utgarde, quiere que consigas 10 tablillas de Calavermis.‡Glorenfeld, de las Catacumbas de Utgarde, quiere que consigas 10 tablillas de Calavermis.‡Glorenfeld, dans les Catacombes d\'Utgarde, vous demande de réunir 10 Tablettes Crâne-du-ver.‡乌特加德墓穴的格罗菲尔德要你收集10块龙颅石板。‡俄特加德墓窖的葛羅倫費德要你去收集10個龍顱石板。',
  }
},
[11278] = {
  {
    'Retorno a Valgarde‡Возвращение в Валгард‡Rückkehr nach Valgarde‡발가드로 돌아가기‡Regresa a Valgarde‡Regresa a Valgarde‡Retour à Valgarde‡返回瓦加德‡回到瓦爾加德',
    nil,
    'Leve o Pacote do Glorenfeld para Beltrão McSurf no Porto de Valgarde.‡Отнесите сверток Глоренфелда Белтранду Максорфу в Валгардский порт.‡Bringt Glorenfelds Päckchen zu Beltrand McSorf im Hafen von Valgarde.‡글로렌펠드의 배달물을 발가드 항만에 있는 벨트란드 맥소르프에게 가져가야 합니다.‡Lleva el paquete de Glorenfeld a Beltrand McSorf al Puerto de Valgarde.‡Lleva el paquete de Glorenfeld a Beltrand McSorf al Puerto de Valgarde.‡Remettez le Paquet de Glorenfeld à Beltrand McSorf, au port de Valgarde.‡将格罗菲尔德的包裹交给瓦加德港口的贝尔塔德·米科索夫。‡把葛羅倫費德的包裹交給瓦爾加德港口的貝爾川·麥克索夫。',
  }
},
[11279] = {
  {
    'Ovo verde, filhote verde!‡Зеленые и светящиеся‡Grüne Eier und Welpen‡녹색 알과 새끼용‡Huevos verdes con crías‡Huevos verdes con crías‡Ces proto-dragonnets sont trop verts…‡绿色的龙卵和龙崽‡綠色的龍蛋和幼龍',
    nil,
    'O Pestífero Tilingaste pediu para você coletar 10 Espécimes Pestilentos de Protodragonete e entregá-los para ele, em Nova Agamand.‡Распространитель чумы Тилингаст попросил вас собрать 10 образцов плоти зачумленных детенышей протодраконов и отнести их к нему в Новый Агамонд.‡Seuchenbringer Tillinghast möchte, dass Ihr 10 Exemplare verseuchter Protowelpen einsammelt und sie anschließend bei ihm abliefert. Er befindet sich in Neu-Agamand.‡역병인도자 틸링하스트가 역병 걸린 새끼 원시용 표본 10개를 모아 신 아가만드로 가져다 달라고 했습니다.‡El pesteador Tillinghast te ha pedido que reúnas 10 especímenes de protocría apestadas y que se las lleves a Nuevo Agamand.‡El pesteador Tillinghast te ha pedido que reúnas 10 especímenes de protocría apestadas y que se las lleves a Nuevo Agamand.‡Le Porte-peste Tillinghast vous a demandé de récupérer 10 Spécimens de proto-dragonnets pestiférés, et de les lui remettre à la Nouvelle-Agamand.‡将10份被感染的始祖龙崽样本交给新阿加曼德的药剂师提灵哈斯特。‡瘟疫使者提林加斯特要你去收集10個染疫元龍幼龍採樣，並送到新阿加曼德給他。',
  }
},
[11280] = {
  {
    'Gastrite dracônica‡Драконис гастритис‡Draconis Gastritis‡배탈난 용‡Draconis Gastritis‡Draconis Gastritis‡Draconis Gastritis‡龙的胃病‡龍胃炎',
    nil,
    'O Pestífero Tilingaste, de Nova Agamand, quer que você use a Carne Pestilenta do Tilingaste para atrair um Protodraco. Em seguida, observe a reação da criatura ao comê-la.‡Распространитель чумы Тилингаст просит вас приманить протодракона с помощью куска зачумленного мяса Тилингаста и понаблюдать за его реакцией на угощение.‡Seuchenbringer Tillinghast in Neu-Agamand möchte, dass Ihr mit Tillinghasts verseuchtem Fleisch einen Protodrachen anlockt und verfolgt, wie er auf das gefressene Zeug reagiert.‡신 아가만드에 있는 역병인도자 틸링하스트가 원시비룡을 틸링하스트의 역병 고기로 유인하여 먹인 다음 반응을 조사해 달라고 했습니다.‡El pesteador Tillinghast en Nuevo Agamand quiere que uses la carne apestada de Tillinghast para atraer a un protodraco y que observes su reacción al comérsela.‡El pesteador Tillinghast en Nuevo Agamand quiere que uses la carne apestada de Tillinghast para atraer a un protodraco y que observes su reacción al comérsela.‡Le Porte-peste Tillinghast, de la Nouvelle-Agamand, veut que vous utilisiez la Viande pestiférée de Tillinghast pour attirer un Proto-drake. Observez ses réactions lorsqu’il la mangera.‡新阿加曼德的药剂师提灵哈斯特要你利用提灵哈斯特的特殊肉块吸引一头始祖幼龙，并观察它进食后的反应。‡新阿加曼德的瘟疫使者提林加斯特要你使用提林加斯特的染疫肉塊去吸引一隻元龍降落，並觀察牠吃肉塊的反應。',
  }
},
[11281] = {
  {
    'Imitar o chamado da natureza‡Подражая зову природы‡Den Ruf der Natur nachahmen‡자연의 소리 흉내내기‡Imitando la llamada de la naturaleza‡Imitando la llamada de la naturaleza‡Imiter l\'appel de la nature‡模仿叫声‡模仿自然的呼喚',
    nil,
    'Teste o Chifre Entalhado e conte o resultado para Nakoma Vidente da Neve, na Aldeia Casco Invernal.‡Испытайте вырезанный рог и верните его Нокоме Заклинателю Снегов в Лагерь Заиндевевшего Копыта.‡Testet das geschnitzte Horn und kehrt anschließend mit den Ergebnissen zu Nokoma Schneeseher im Lager der Winterhufe zurück.‡깎아 만든 뿔피리를 시험해 보고 겨울발굽 야영지에 있는 노코마 스노우시어에게 그 결과를 알려야 합니다.‡Prueba el cuerno tallado y ve a contarle los resultados que observes a Nokoma Vidente de la Nieve al Campamento Pezuña Invernal.‡Prueba el cuerno tallado y ve a contarle los resultados que observes a Nokoma Vidente de la Nieve al Campamento Pezuña Invernal.‡Testez le Cor sculpté, puis allez faire part du résultat à Nokoma Œil-des-neiges, au Camp Sabot-d’hiver.‡测试雕刻过的号角，然后返回冬蹄营地向诺库玛·雪眼汇报测试结果。‡測試雕紋號角，然後將結果帶回冬蹄營地交給諾可瑪·雪先知。',
  }
},
[11282] = {
  {
    'Uma lição sobre o medo‡Урок страха‡Eine Lektion in Sachen Angst‡공포란 이런 것이다!‡Una lección de miedo‡Una lección de miedo‡Une leçon de peur‡领略恐惧‡恐懼的一課',
    nil,
    'Gorth quer que você mate Ulf, o Dessangrador; Oric, o Terrível; e Gunnar Thorvardsson e atravesse os cadáveres deles com o Estandarte Renegado. Mate vários vraikalen do outro lado do bloqueio dos Renegados até que os alvos apareçam.‡По приказу Горта вам надо победить Улфа Кровопускателя, Орика Зловещего и Гуннара Торвардссона, после чего проткнуть их тела древком знамени Отрекшихся. Убивайте врайкулов вдоль баррикады, возведенной Отрекшимися, пока не появятся чемпионы.‡Gorth möchte, dass Ihr Ulf den Aderlasser, Oric den Elenden und Gunnar Thorvardsson tötet und das Banner der Verlassenen durch ihre Körper rammt. Erschlagt solange Vrykul auf der anderen Seite der Blockade der Verlassenen, bis die Drei auftauchen.‡고르스가 피를 부르는 울프, 재앙의 오릭, 군나르 토르바르드슨을 각각 처치한 다음 포세이큰 깃발을 시체에 꽂아 달라고 했습니다. 그들이 나타날 때까지 포세이큰 저지선에서 브리쿨을 처치해야 합니다.‡Gorth quiere que mates a Ulf el Flebotomista, a Oric el Torvo y a Gunnar Thorvardsson y que atravieses sus cuerpos con el estandarte de los Renegados. Mata vrykuls por la zona de bloqueo de los Renegados hasta que aparezcan.‡Gorth quiere que mates a Ulf el Flebotomista, a Oric el Torvo y a Gunnar Thorvardsson y que atravieses sus cuerpos con el estandarte de los Renegados. Mata vrykuls por la zona de bloqueo de los Renegados hasta que aparezcan.‡Gorth veut que vous tuiez Ulf le Saigneur, Oric le Torve et Gunnar Thorvardsson, et que vous plantiez la Bannière des Réprouvés sur leurs corps. Tuez des vrykuls tout au long du blocus des Réprouvés jusqu’à ce qu’ils apparaissent.‡戈斯要你杀死放血者伍尔弗、恶毒的奥瑞克和贡纳·索瓦德森，并将被遗忘者旗帜插在他们面前。你需要杀死数名封锁线对面的维库人，直到他们露面。‡葛司要你去殺死『放血者』兀夫、『災害』歐立克和古拿·索瓦德森然後把被遺忘者旌旗插在他們的屍體上。在被遺忘者封鎖線附近殺死那些維酷人直到他們出現。',
  }
},
[11283] = {
  {
    'Contagem de Corpos de Baleheim‡Кровавая бойня в Гибльхейме‡Zahl der Toten in Quälheim‡베일하임으로 출동‡Recuento de cuerpos de Baleheim‡Recuento de cuerpos de Baleheim‡Le décompte des cadavres de Torvheim‡血战拜尔海姆‡貝爾海姆死亡人數統計',
    nil,
    'O Sargento Gorth quer que você mate 16 Vraikalen de Hiberfel dentro de Baleheim.‡Сержант Горт просит вас убить 16 снежескорнских врайкулов в Гибльхейме.‡Unteroffizier Gorth möchte, dass Ihr nach Quälheim geht und 16 Vrykul des Winterskornstammes tötet.‡부대장 고르스가 베일하임에 있는 윈터스코른 브리쿨 16마리를 처치해 달라고 했습니다.‡El sargento Gorth quiere que mates a 16 vrykuls Inbjerskorn en el interior de Baleheim.‡El sargento Gorth quiere que mates a 16 vrykuls Inbjerskorn en el interior de Baleheim.‡Le sergent Gorth veut que vous entriez dans Torvheim pour y tuer 16 Vrykuls de Mörghiver.‡戈斯中士要你前往拜尔海姆，杀死16名斯克恩维库人。‡葛司中士需要你去貝爾海姆殺掉16名溫特斯考恩維酷族人。',
  }
},
[11284] = {
  {
    'O yeti mora ao lado‡Соседство с йети‡Der Yeti von nebenan‡옆집 설인‡El yeti de al lado‡El yeti de al lado‡Le yéti d\'à-côté‡隔壁的雪人‡隔壁的雪人',
    nil,
    'O Encarregado Caubi, do Forte Vildervar, quer que você derrote o Modorrento.‡Старшина Колби из крепости Вилдервар просит вас убить Сколорога.‡Vorarbeiter Colbey bei Fort Wildervar möchte, dass Ihr Schmetterhorn besiegt.‡빌더바르 요새의 현장감독 콜비가 짝뿔을 처치해 달라고 했습니다.‡El supervisor Colbey en el Fuerte Vildervar quiere que derrotes a Modorro.‡El supervisor Colbey en el Fuerte Vildervar quiere que derrotes a Modorro.‡Le Contremaître Colbey de Fort Hardivar veut que vous battiez Brise-corne.‡维德瓦堡垒的工头科尔贝要你击败裂角。‡威德瓦堡壘的工頭寇畢要你去打倒碎角。',
  }
},
[11285] = {
  {
    'Queimando tudo até a última ponte‡Гори, Гибльхейм!‡Quälheim muss brennen!‡베일하임을 불태워라!‡¡Baleheim debe arder!‡¡Baleheim debe arder!‡Torvheim doit brûler !‡拜尔海姆在燃烧！‡燒盡貝爾海姆!',
    nil,
    'O Sargento Gorth quer que você vá para Baleheim e use a Tocha de Gorth para queimar 1 Moradia de Hiberfel, 1 Torre da Guarda de Hiberfel, 1 Ponte de Hiberfel e 1 Quartel de Hiberfel.‡Сержант Горт послал вас в Гибльхейм с факелом Горта, чтобы вы сожгли 1 снежескорнское здание, 1 снежескорнскую сторожевую башню, 1 снежескорнский мост и 1 снежескорнские казармы.‡Unteroffizier Gorth will, dass Ihr nach Quälheim geht und Gorths Fackel benutzt, um 1 Behausung der Winterskorn, 1 Wachturm der Winterskorn, 1 Brücke der Winterskorn und 1 Kaserne der Winterskorn in Brand zu stecken.‡부대장 고르스가 베일하임에서 고르스의 횃불을 사용해 윈터스코른 주거지, 윈터스코른 감시탑, 윈터스코른 교량, 윈터스코른 병영 한 군데씩을 불태워 달라고 했습니다.‡El sargento Gorth quiere que vayas a Baleheim y utilices la antorcha de Gorth para quemar 1 morada Inbjerskorn, 1 torre de observación Inbjerskorn, 1 puente Inbjerskorn y 1 barraca Inbjerskorn.‡El sargento Gorth quiere que vayas a Baleheim y utilices la antorcha de Gorth para quemar 1 morada Inbjerskorn, 1 torre de observación Inbjerskorn, 1 puente Inbjerskorn y 1 barraca Inbjerskorn.‡Le sergent Gorth veut que vous entriez dans Torvheim et que vous vous serviez de la Torche de Gorth pour brûler 1 Logis Mörghiver, 1 Tour de guet Mörghiver, 1 Pont Mörghiver et 1 Caserne Mörghiver.‡戈斯中士要你前往拜尔海姆，使用戈斯的火把烧毁1座斯克恩民房、1座斯克恩瞭望塔、1座斯克恩桥梁和1座斯克恩兵营。‡葛司中士要你前去貝爾海姆，並使用葛司的火炬燒毀1間溫特斯考恩居所、1間溫特斯考恩瞭望塔、1座溫特斯考恩橋樑以及1間溫特斯考恩兵營。',
  }
},
[11286] = {
  {
    'Os artefatos do Portão de Aço‡Артефакты Стальных ворот‡Die Artefakte des Stählernen Tores‡강철 관문 유물‡Los artefactos de Las Puertas de Acero‡Los artefactos de Las Puertas de Acero‡Les artéfacts de la Porte d\'acier‡钢铁之门的古器‡鋼鐵之門的神器',
    nil,
    'O Sábio Andanévoa pediu para você recolher 10 Artefatos do Portão de Aço. Após reunir todos os itens, fale novamente com ele, no Portão de Aço.‡Ведун Странник Туманов попросил вас принести 10 артефактов Стальных ворот. Когда вы соберете их все, вернитесь к ведуну в Стальные ворота.‡Weiser Nebelläufer möchte, dass Ihr 10 Artefakte vom Stählernen Tor aufsammelt. Kehrt zu ihm zurück, sobald Ihr alle habt. Er befindet sich am Stählernen Tor.‡현인 미스트워커가 강철 관문 유물 10개를 모아 달라고 했습니다. 모두 모으면 강철 관문에 있는 그에게 가야 합니다.‡El sabio Caminaniebla te ha pedido que consigas 10 artefactos de Las Puertas de Acero. Cuando los tengas todos, vuelve a verle a Las Puertas de Acero.‡El sabio Caminaniebla te ha pedido que consigas 10 artefactos de Las Puertas de Acero. Cuando los tengas todos, vuelve a verle a Las Puertas de Acero.‡Le Sage Marche-brume veut que vous récupériez 10 Artéfacts de la Porte d’acier. Lorsque vous les aurez, remettez-les-lui à la Porte d’acier.‡将10件钢铁之门古器交给嚎风峡湾钢铁之门的先知拉瑞恩·迷雾行者。‡賢者霧行要求你收集10樣鋼鐵之門神器。收集完成以後，回到鋼鐵之門向他回報。',
  }
},
[11287] = {
  {
    'Encontre o sábio Andanévoa‡Найти ведуна Странника Туманов‡Findet den Weisen Nebelläufer‡현인 미스트워커 찾기‡Encuentra al sabio Caminaniebla‡Encuentra al sabio Caminaniebla‡Trouver le sage Marche-brume‡找到先知拉瑞恩·迷雾行者‡尋找賢者霧行',
    nil,
    'A Anciã Ankha pediu para você checar se o Sábio Andanévoa está em segurança. Ela acha que ele está dentro ou perto do Portão de Aço.‡Великая Мать Анкха попросила вас найти ведуна Странника Туманов. Она полагает, что он сейчас находится где-то рядом со Стальными Воротами.‡Großmutter Ankha hat Euch gebeten nachzusehen, in welcher Verfassung sich der Weise Nebelläufer befindet. Sie glaubt, dass er sich am oder in der Nähe des Stählernen Tores befindet.‡대모 안카가 강철 관문이나 그 근처에 있을 현인 미스트워커의 생사를 확인해 달라고 했습니다.‡La abuela Ankha te ha pedido que averigües el estado del sabio Caminaniebla. Cree que se encuentra en o cerca de Las Puertas de Acero.‡La abuela Ankha te ha pedido que averigües el estado del sabio Caminaniebla. Cree que se encuentra en o cerca de Las Puertas de Acero.‡La Grande-mère Ankha vous a demandé d\'aller vérifier si le Sage Marche-brume allait bien. Elle pense qu\'il se trouve à la Porte d\'acier ou bien à proximité.‡安卡祖母要你去寻找先知拉瑞恩·迷雾行者的下落。他应该在嚎风峡湾的钢铁之门附近。‡主母安卡請你調查賢者霧行的情況。她相信賢者霧行在鋼鐵之門附近。',
  }
},
[11288] = {
  {
    'A luz rutilante‡Сияние света‡Das strahlende Licht‡눈부신 빛‡La luz brillante‡La luz brillante‡La Lumière rayonnante‡闪耀的圣光‡閃耀的聖光',
    nil,
    'Ares, o Juramentado, das Catacumbas de Utgarde, quer que você recupere o Artefato Sagrado.|n|nEsta é uma missão com tempo de conclusão limitado.‡Арес Поклявшийся, лежащий при смерти в Катакомбах Утгард, попросил вас вернуть священный артефакт.|n|nЭто задание ограничено по времени.‡Ares der Schwurgebundene in den Katakomben von Utgarde möchte, dass Ihr das geheiligte Artefakt bergt.|n|nDiese Aufgabe ist zeitlich begrenzt.‡우트가드 지하묘지에 있는 명예의 아레스가 성스러운 유물을 찾아달라고 했습니다.|n|n시간제한 퀘스트입니다.‡Ares el Juramentado en las Catacumbas de Utgarde quiere que recuperes el artefacto sacro.|n|nEsta es una misión contrarreloj.‡Ares el Juramentado en las Catacumbas de Utgarde quiere que recuperes el artefacto sacro.|n|nEsta es una misión contrarreloj.‡Arès le Féal des Catacombes d’Utgarde veut que vous récupériez l’Artéfact sacré.|n|nCette quête est en temps limité.‡乌特加德墓穴的誓缚者阿瑞斯要你夺回圣器。|n|n这是一项限时任务。‡俄特加德墓窖的『誓縛』愛力士要你去取回神聖法器。|n|n這是個有時間限制的任務。',
  }
},
[11289] = {
  {
    'Guiado pela honra‡Ведомый честью‡Von Ehre geleitet‡명예의 인도‡Guiado por el honor‡Guiado por el honor‡Guidé par l\'honneur‡荣耀的指引‡受榮耀的指引',
    nil,
    'Devolva o Artefato Sagrado ao senhor Irulon Gumecerto, em Valgarde.‡Верните священный артефакт лорду Ирулону Верный Клинок в Валгард.‡Bringt das geheiligte Artefakt zu Lord Irulon Wahrklinge zurück. Er befindet sich in Valgarde.‡성스러운 유물을 발가드에 있는 이룰론 트루블레이드 경에게 돌려줘야 합니다.‡Devuelve el artefacto sacro a Lord Irulon Filoveraz en Valgarde.‡Devuelve el artefacto sacro a Lord Irulon Filoveraz en Valgarde.‡Rapportez l\'Artéfact sacré au Seigneur Irulon Lamevraie à Valgarde.‡将圣器交给瓦加德的伊鲁伦·图布雷勋爵。‡將神聖法器交還給瓦爾加德的埃盧隆·真刃領主。',
  }
},
[11290] = {
  {
    'Planos de batalha dos Esfola-dragão‡Военные планы клана Укротителей драконов‡Schlachtpläne der Drachenschinder‡용약탈 전투 계획서‡Planes de batalla de los Desuelladragones‡Planes de batalla de los Desuelladragones‡Les plans de bataille des Écorche-dragon‡掠龙作战计划‡掠龍戰鬥計畫',
    nil,
    'O Vice-almirante Castro, do Porto de Valgarde, no Fiorde Uivante, quer que você lhe traga os Planos de Batalha dos Esfola-dragão.‡Вице-адмирал Келлер из Валгардского порта в Ревущем фьорде поручил вам достать военные планы клана Укротителей драконов.‡Vizeadmiral Keller im Hafen von Valgarde im Heulenden Fjord möchte, dass Ihr ihm die Schlachtpläne der Drachenschinder bringt.‡울부짖는 협만의 발가드 항만에 있는 부제독 켈러가 용약탈 전투 계획서를 가져다 달라고 했습니다.‡El vicealmirante Keller en el Puerto de Valgarde, en el Fiordo Aquilonal, te ha pedido que le lleves los planes de batalla de los Desuelladragones.|n‡El vicealmirante Keller en el Puerto de Valgarde, en el Fiordo Aquilonal, te ha pedido que le lleves los planes de batalla de los Desuelladragones.|n‡Le Vice-amiral Keller, au port de Valgarde dans le Fjord hurlant, vous a demandé de lui apporter les plans de bataille des Écorche-dragon.‡嚎风峡湾瓦加德港口的凯勒中将要你取回掠龙作战计划。‡海軍中將凱勒要你把掠龍戰鬥計畫帶給他。他就在凜風峽灣的瓦爾加德港口。',
  }
},
[11291] = {
  {
    'Para a Bastilha da Guarda Oeste!‡В Крепость Западной Стражи!‡Auf nach Westwacht!‡서부경비대 성채로!‡¡A la Fortaleza de la Guardia Oeste!‡¡A la Fortaleza de la Guardia Oeste!‡Au donjon de la Garde de l\'ouest !‡前往西部卫戍要塞！‡前往鎮西要塞!',
    nil,
    'Entregue os Planos de Batalha dos Esfola-dragão para o Capitão Carneiro na Bastilha da Guarda Oeste, no Fiorde Uivante.‡Отнесите военные планы Укротителей драконов капитану Адамсу в Крепость Западной Стражи в Ревущем фьорде.‡Bringt die Schlachtpläne der Drachenschinder zu Hauptmann Adams. Er befindet sich in Westwacht im Heulenden Fjord.‡울부짖는 협만의 서부경비대 성채에 있는 경비대장 아담스에게 용약탈 전투 계획서를 가져가야 합니다.‡Lleva los planes de batalla de los Desuelladragones al capitán Adams a la Fortaleza de la Guardia Oeste en el Fiordo Aquilonal.|n‡Lleva los planes de batalla de los Desuelladragones al capitán Adams a la Fortaleza de la Guardia Oeste en el Fiordo Aquilonal.|n‡Remettez les Plans de bataille des Écorche-dragon au Capitaine Adams, au donjon de la Garde de l’ouest, dans le Fjord hurlant.‡将掠龙作战计划交给嚎风峡湾西部卫戍要塞的亚当斯上尉。‡帶著掠龍戰鬥計畫前往凜風峽灣的鎮西要塞交給亞當斯隊長。',
  }
},
[11292] = {
  {
    'Caçar os fracos‡Слабое звено‡Auf die Schwachen Jagd machen‡약육강식‡Acechando a los débiles‡Acechando a los débiles‡Faire des faibles sa proie‡陷阱中的猎物‡掠奪弱者',
    nil,
    'O Coureador Jethan, do Forte Vildervar, quer que você lhe traga 8 Presas Capturadas.‡Зверолов Джетан из крепости Вилдервар просит вас принести ему 8 пойманных зверьков.‡Fallensteller Jethan in Fort Wildervar möchte, dass Ihr ihm aus 8 Fallen gefangene Beute bringt.‡빌더바르 요새의 덫사냥꾼 제탄이 덫에 걸린 동물 8마리를 가져다 달라고 했습니다.‡El trampero Jethan en el Fuerte Vildervar quiere que le lleves 8 trozos de presa atrapada.‡El trampero Jethan en el Fuerte Vildervar quiere que le lleves 8 trozos de presa atrapada.‡Le Trappeur Jethan, au Fort Hardivar, veut que vous lui rameniez 8 Proies piégées.‡将8份被陷阱捕获的猎物交给维德瓦堡垒的猎户杰森。‡威德瓦堡壘的陷捕者傑桑要你帶8個受困的獵物給他。',
  }
},
[11293] = {
  {
    '‡Пивоварня Ячменоваров ищет зазывалу!‡Marktschreier für die Gerstenbräus!‡발리브루를 알려라!‡¡Grita por los Cebadiz!‡¡Grita por los Cebadiz!‡Des aboyeurs pour les Brasselorge !‡为麦酒呐喊！‡',
    nil,
    '‡Зазывайте посетителей на Хмельной фестиваль у флагов в Палатах Войны, в Зале Исследователей и в Палатах Магии.‡Verbreitet die Kunde vom Braufest bei den Flaggen außerhalb der Bank, im Militärviertel, in der Halle der Forscher und im Mystikerviertel.‡은행 밖, 군사 지구, 탐험가의 전당, 마법 지구에 있는 깃발에서 썬더브루를 광고해야 합니다.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera del banco, en la Sala Militar, en la Sala de los Expedicionarios y en la Sala Mística.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera del banco, en la Sala Militar, en la Sala de los Expedicionarios y en la Sala Mística.‡Allez porter la nouvelle de la fête des Brasseurs aux drapeaux devant la banque, à la Garde militaire, dans le hall des Explorateurs et à la Garde mystique.‡在银行外、军事区、探险者大厅以及秘法区的旗帜下高声叫喊，宣传美酒节。‡',
  }
},
[11294] = {
  {
    '‡Пивоварня Громоваров ищет зазывалу!‡Marktschreier für die Donnerbräus!‡썬더브루를 알려라!‡¡Grita por los Cebatruenos!‡¡Grita por los Cebatruenos!‡Des aboyeurs pour les Tonnebière !‡‡',
    nil,
    '‡Зазывайте посетителей на Хмельной фестиваль у флагов в Палатах Войны, в Зале Исследователей и в Палатах Магии.‡Verbreitet die Kunde vom Braufest bei den Flaggen außerhalb der Bank, im Militärviertel, in der Halle der Forscher und im Mystikerviertel.‡은행 밖, 군사 지구, 탐험가의 전당, 마법 지구에 있는 깃발에서 썬더브루를 광고해야 합니다.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera del banco, en la Sala Militar, en la Sala de los Expedicionarios y en la Sala Mística.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera del banco, en la Sala Militar, en la Sala de los Expedicionarios y en la Sala Mística.‡Allez porter la nouvelle de la fête des Brasseurs aux drapeaux devant la banque, à la Garde militaire, dans le hall des Explorateurs et à la Garde mystique.‡在银行外、军事区、探险者大厅以及秘法区的旗帜下高声叫喊，宣传美酒节。‡',
  }
},
[11295] = {
  {
    'A ofensiva começa‡В наступление!‡Die Offensive beginnt‡공격 개시‡La ofensiva comienza‡La ofensiva comienza‡L\'offensive commence‡开始进攻‡展開進攻',
    nil,
    'Fale com o Sargento Gorth no bloqueio próximo ao elevador a oeste de Porto Vendeta, no Fiorde Uivante.‡Поговорите с сержантом Гортом на баррикаде рядом с подъемником к западу от Лагеря Возмездия в Ревущем Фьорде.‡Sprecht mit Unteroffizier Gorth bei der Blockade in der Nähe des Aufzugs westlich vom Hafen der Vergeltung im Heulenden Fjord.‡울부짖는 협만, 복수의 상륙지 서쪽에 있는 승강기 근처 저지선에서 부대장 고르스와 대화해야 합니다.‡Habla con el sargento Gorth en el bloqueo cerca del elevador oeste de Campo Venganza en el Fiordo Aquilonal.‡Habla con el sargento Gorth en el bloqueo cerca del elevador oeste de Campo Venganza en el Fiordo Aquilonal.‡Parlez au Sergent Gorth, qui dirige le blocus, non loin de l’ascenseur, à l’ouest de l’Accostage de la Vengeance, dans le Fjord hurlant.‡与复仇港西边升降机旁的哨站内的戈斯中士谈一谈。‡和封鎖線的葛司中士談談，他就在凜風峽灣的復仇臺地西邊的升降梯附近。',
  }
},
[11296] = {
  {
    'Prisioneiros do Bosque Fendido‡Пленники терзающих вдов‡Gefangen im Bruchwald‡비틀린 숲의 포로들‡Cautivos de El Bosque Hendido‡Cautivos de El Bosque Hendido‡Les prisonniers de Clivebois‡裂木森林的囚犯‡裂木森林的俘虜',
    nil,
    'O Pisaléguas Nuvem do Céu pediu para você libertar 7 Pisaléguas Casco Invernal. Fale novamente com ele, no Portão de Aço, após terminar a tarefa.‡Тученеб попросил вас освободить 7 выносливых гонцов из лагеря Заиндевевшего Копыта. Выполнив это задание, вернитесь к нему в Стальные ворота.‡Fernläufer Himmelswolke möchte, dass Ihr 7 seiner Fernläufer der Winterhufe befreit. Meldet Euch wieder bei ihm, sobald Ihr Eure Aufgabe erledigt habt. Er befindet sich am Stählernen Tor.‡겨울발굽 수색꾼 7명을 구출한 다음 강철 관문에 있는 수색꾼 스카이클라우드에게 가야 합니다.‡El enviado Nube del Cielo te ha pedido que liberes a sus 7 enviados Pezuña Invernal. Cuando lo hayas conseguido, vuelve junto a él a Las Puertas de Acero.‡El enviado Nube del Cielo te ha pedido que liberes a sus 7 enviados Pezuña Invernal. Cuando lo hayas conseguido, vuelve junto a él a Las Puertas de Acero.‡Le Long-coureur Nuage-du-ciel vous a demandé de libérer 7 Longs-coureurs Sabot-d’hiver. Lorsque ce sera fait, retournez à la Porte d’acier.‡远行者斯图卡·天云要你去营救7名冬蹄远行者，完成任务后钢铁之门向他复命。‡遠偵斥候穹雲要你釋放7名冬蹄遠偵斥候。完成之後，回到鋼鐵之門找他。',
  }
},
[11297] = {
  {
    'De olho nos intrusos‡Слежка за нарушителями границ‡Nach Eindringlingen Ausschau halten‡침입자 감시‡Observando de cerca a los intrusos‡Observando de cerca a los intrusos‡Garder un œil sur les intrus‡留神不速之客‡注意入侵者',
    nil,
    'Fale com o Boticário Malvino no Acampamento da Sociedade dos Boticários.‡Поговорите с аптекарем Малтусом в Аптекарском поселке.‡Sprecht mit Apotheker Malthus im Apothekerlager.‡연금술사 야영지에서 연금술사 말더스와 대화해야 합니다.‡Habla con el boticario Malthus en el Campamento de los Boticarios.‡Habla con el boticario Malthus en el Campamento de los Boticarios.‡Parlez à l’Apothicaire Malthus, au Camp des Apothicaires.‡与药剂师营地的药剂师玛尔苏斯谈一谈。‡與藥劑師營地的藥劑師馬爾薩斯談談。',
  }
},
[11298] = {
  {
    'O que puseram nessa cerveja?‡Что они пьют?‡Was ist in dem Gebräu?‡술 속에 뭐가 들었기에?‡¿Qué lleva esa bebida?‡¿Qué lleva esa bebida?‡Mais qu\'est-ce qu\'il y a dans ce truc ?‡酒里有什么？‡那瓶酒是啥?',
    nil,
    'O Boticário Malvino, do Acampamento da Sociedade dos Boticários, quer que você lhe traga 5 Barris Enânicos.‡Аптекарь Малтус из Аптекарского поселка просит вас принести ему 5 дворфийских бочонков.‡Apotheker Malthus im Apothekerlager möchte, dass Ihr ihm 5 zwergische Fässchen bringt.‡연금술사 야영지에 있는 연금술사 말더스가 드워프 맥주통 5개를 가져다 달라고 했습니다.‡El boticario Malthus en el Campamento de los Boticarios quiere que le lleves 5 barriles enanos.‡El boticario Malthus en el Campamento de los Boticarios quiere que le lleves 5 barriles enanos.‡L’Apothicaire Malthus, du Camp des Apothicaires, veut que vous lui rapportiez 5 Tonneaux des nains.‡将5只矮人酒桶交给药剂师营地的药剂师玛尔苏斯。‡藥劑師營地的藥劑師馬爾薩斯要你帶5個矮人酒桶給他。',
  }
},
[11299] = {
  {
    'O Ringue do Julgamento‡Круг Правосудия‡Der Ring des Richturteils‡심판의 투기장‡El Círculo del Juicio‡El Círculo del Juicio‡L\'arène du Jugement‡审判竞技场‡審判之環',
    nil,
    'Encontre Daegarn no Ringue do Julgamento, nas Catacumbas de Utgarde.‡Найдите Дегарна в Круге Правосудия. Он заперт в Катакомбах Утгард.‡Findet Daegarn. Sucht im Ring des Richturteils im Inneren der Katakomben von Utgarde.‡우트가드 지하묘지 안에 있는 심판의 투기장에서 대간을 찾아야 합니다.‡Encuentra a Daegarn en El Círculo del Juicio situado dentro de las Catacumbas de Utgarde.‡Encuentra a Daegarn en El Círculo del Juicio situado dentro de las Catacumbas de Utgarde.‡Trouvez Daegarn dans l’Arène du jugement, à l’intérieur des Catacombes d’Utgarde.‡在乌特加德墓穴的审判竞技场中找到戴加恩。‡前往俄特加德墓窖的審判之環，找到迪剛恩。',
  }
},
[11300] = {
  {
    'Derrota arrasadora no ringue‡Поражение на ринге‡Überwältigende Niederlage im Ring‡투기장에서 승리를!‡Una derrota asombrosa en el Círculo‡Una derrota asombrosa en el Círculo‡Formidable déconfiture dans l\'arène‡扫平竞技场‡審判之環中的慘敗',
    nil,
    'Derrote os gladiadores no Ringue do Julgamento para enfrentar Oluf, o Violento. Derrote-o e recupere o Código Perdido.|n|nLeve o Código Perdido para Glorenfeld, na entrada das Catacumbas de Utgarde.‡Победите гладиаторов в Круге Правосудия, сразитесь с Олуфом Неистовым и заберите у него древнюю тайнопись.|n|nОтнесите тайнопись Глоренфелду ко входу в Катакомбы Утгард.‡Besiegt die Gladiatoren im Ring des Richturteils und stellt Euch Oluf dem Gewalttätigen. Besiegt Oluf und nehmt ihm die uralte Glyphe ab.|n|nBringt die uralte Glyphe zu Glorenfeld am Eingang zu den Katakomben von Utgarde.‡심판의 투기장에서 검투사들을 물리친 다음 난폭한 울루프를 처치하고 고대의 암호를 되찾아야 합니다.|n|n그런 다음 고대의 암호를 우트가드 지하묘지 입구에 있는 글로렌펠드에게 가져가야 합니다.‡Derrota a los gladiadores en el Círculo del Juicio y enfréntate a Oluf el Violento. Vence a Oluf y recupera la clave antigua.|n|nDevuelve la clave antigua a Glorenfeld en la entrada a las catacumbas de Utgarde.‡Derrota a los gladiadores en el Círculo del Juicio y enfréntate a Oluf el Violento. Vence a Oluf y recupera la clave antigua.|n|nDevuelve la clave antigua a Glorenfeld en la entrada a las catacumbas de Utgarde.‡Triomphez des gladiateurs de l’Arène du Jugement et affrontez Oluf le Violent. Battez-le et récupérez le Code antique.|n|nRemettez le Code antique à Glorenfeld à l’entrée des Catacombes d’Utgarde.‡击败审判竞技场内的所有角斗士，然后挑战残暴的沃鲁夫。击败沃鲁夫并夺回古代密码表。|n|n将古代密码表交给乌特加德墓穴入口处的格罗菲尔德。‡擊敗審判之環的鬥士們，然後面對『暴力』歐路夫。擊敗歐路夫然後取回上古密碼。|n|n將上古密碼交給俄特加德墓窖入口的葛羅倫費德。',
  }
},
[11301] = {
  {
    'Miolos! Miolos! Miolos!‡Мозги! Мозги!‡Gehirne! Wir wollen Gehirne!‡머리카락 말이야! 머리카락!‡¡Cerebros! ¡Cerebros! ¡Cerebros!‡¡Cerebros! ¡Cerebros! ¡Cerebros!‡Cerveaux ! Cerveaux ! Cerveaux !‡疯狂的研究‡腦!腦!腦!',
    nil,
    'O Boticário Grácio, do Acampamento da Sociedade dos Boticários, quer que você lhe traga 12 Cérebros de Exploradores Dementes.‡Аптекарь Грик из Аптекарского поселка просит вас принести ему 12 мозгов спятивших исследователей.‡Apotheker Grick im Apothekerlager möchte, dass Ihr ihm 12 verwirrte Forscherhirne bringt.‡연금술사 야영지에 있는 연금술사 그릭이 광기 어린 탐험가의 머리카락 12가닥을 가져다 달라고 했습니다.‡El boticario Grick en el Campamento de los Boticarios quiere que le lleves 12 Cerebros de expedicionario perturbado.‡El boticario Grick en el Campamento de los Boticarios quiere que le lleves 12 Cerebros de expedicionario perturbado.‡L’Apothicaire Grick, du Camp des Apothicaires, veut que vous lui rapportiez 12 Cerveaux d’explorateurs dérangés.‡将12份疯狂探险者的“样本”交给药剂师营地的药剂师葛瑞克。‡藥劑師營地的藥劑師格里克要你帶給他12個發狂的探險者大腦。',
  }
},
[11302] = {
  {
    'As enigmáticas ninfas álgidas‡Загадочные ледяные нимфы‡Die geheimnisvollen Frostnymphen‡불가사의한 서리 요정‡Las enigmáticas ninfas escarcha‡Las enigmáticas ninfas escarcha‡Les énigmatiques nymphes de givre‡神秘的冰雪树妖‡謎樣的冰霜水精',
    nil,
    'Fale com Sedielle na Clareira Congelada.‡Поговорите с Луриэль на Заиндевевшей поляне.‡Sprecht mit Lurielle auf der Gefrorenen Lichtung.‡얼어붙은 숲에서 루리엘과 대화해야 합니다.‡Habla con Lurielle en El Claro Helado.‡Habla con Lurielle en El Claro Helado.‡Allez parler à Lurielle dans la Clairière Gelée.‡与冰雪林地的鲁莉尔蕾谈一谈。‡和冰凍林地的露麗兒談談。',
  }
},
[11303] = {
  {
    'A emboscada‡Засада‡Der Hinterhalt‡매복‡La emboscada‡La emboscada‡L\'embuscade‡伏击‡伏擊',
    nil,
    'Fale com Lídio na Cilada de Lídio.‡Поговорите с Лиделлом в Засаде Лиделла.‡Geht zu Lydells Hinterhalt und sprecht mit Lydell.‡리델의 매복지로 가서 대화해야 합니다.‡Habla con Lydell en La Emboscada de Lydell.‡Habla con Lydell en La Emboscada de Lydell.‡Parlez à Lydell à l\'Embuscade de Lydell.‡前往林德尔的伏击点，与林德尔谈一谈。‡在黎戴爾的埋伏處和黎戴爾談談。',
  }
},
[11304] = {
  {
    'Nova Agamand‡Новый Агамонд‡Neu-Agamand‡신 아가만드‡Nuevo Agamand‡Nuevo Agamand‡La Nouvelle-Agamand‡新阿加曼德‡新阿加曼德',
    nil,
    'Entregue a Cepa do Lisandro para o Pestífero-chefe Espargosa em Nova Agamand, na parte oeste do Fiorde Uivante.‡Отнесите штамм Лисандера главному распространителю чумы Харрису в Новый Агамонд на запад Ревущего фьорда.‡Bringt Lysanders Erregerstamm zum obersten Seuchenfürsten Harris. Er befindet sich in Neu-Agamand im Westen des Heulenden Fjords‡라이샌더의 역병 변종을 울부짖는 협만 서쪽의 신 아가만드에 있는 고위 역병인도자 해리스에게 가져가야 합니다.‡Llévale la cepa de Lysander al jefe pesteador Harris en Nuevo Agamand, al oeste del Fiordo Aquilonal.‡Llévale la cepa de Lysander al jefe pesteador Harris en Nuevo Agamand, al oeste del Fiordo Aquilonal.‡Remettez la Souche de Lysander au Porte-peste en chef Harris, à la Nouvelle-Agamand, à l’ouest du Fjord Hurlant.‡前往嚎风峡湾西部的新阿加曼德，将雷杉德尔的菌株交给首席药剂师哈瑞斯。‡把黎珊達的菌種帶給首席瘟疫使者哈里斯，他在凜風峽灣西部的新阿加曼德。',
  }
},
[11305] = {
  {
    'Uma fórmula sob medida‡Идеальная формула‡Eine maßgeschneiderte Formel‡맞춤형 역병 제조‡Una fórmula hecha a medida‡Una fórmula hecha a medida‡Une formule sur mesure‡量身订制‡特製的配方',
    nil,
    'Colete Sangue de Patriarca Esfola-dragão de Thorvald, no Acampamento do Thorvald, e entregue o material para o Pestífero-chefe Espargosa em Nova Agamand.‡Добудьте кровь патриарха Укротителей драконов – вождя Торвальда, который укрылся в Лагере Торвальда, и принесите ее главному распространителю чумы Харрису в Новый Агамонд.‡Geht zu Thorvalds Lager, erschlagt Thorvald, nehmt das Blut des Patriarchen der Drachenschinder an Euch und bringt es zum obersten Seuchenfürsten Harris in Neu-Agamand.‡토르발트의 야영지에 있는 토르발트에게서 용약탈 시조의 혈액을 구한 다음 신 아가만드에 있는 고위 역병인도자 해리스에게 가져가야 합니다.‡Obtén la sangre de patriarca Desuelladragones de Thorvald en el Campamento de Thorvald y llévasela al jefe pesteador Harris en Nuevo Agamand.‡Obtén la sangre de patriarca Desuelladragones de Thorvald en el Campamento de Thorvald y llévasela al jefe pesteador Harris en Nuevo Agamand.‡Procurez-vous le Sang du patriarche écorche-dragon sur Thorvald au Camp de Thorvald, et apportez-le au Porte-peste en chef Harris à la Nouvelle-Agamand.‡前往托尔瓦德的营地，从托尔瓦德身上取得掠龙族长的样本，将它交给新阿加曼德的首席药剂师哈瑞斯。‡從索瓦爾德的身上得到掠龍族王之血，他就在索瓦爾德營地中，並將血液交給新阿加曼德的首席瘟疫使者哈里斯。',
  }
},
[11306] = {
  {
    'Misture e aqueça‡Нагреть и перемешать‡Aufkochen und umrühren‡가열하고 휘젓고‡Calentar y remover‡Calentar y remover‡Réchauffez et remuez‡加热搅拌‡進行高溫攪拌',
    nil,
    'Encha o Frasco Vazio do Boticário no Caldeirão de Sangue de Vraikal e depois misture o Frasco de Sangue de Vraikal às Amostras de Peste do Espargosa próximas até obter uma Concocção Equilibrada.|n|nFale novamente com o Pestífero-chefe Espargosa ao terminar a tarefa.‡Наполните пустой аптекарский флакон кровью из котла с кровью врайкулов, после чего добавляйте во флакон с кровью врайкула образцы чумы Харисса, пока не получите равномерную смесь. |n|nКогда вы выполните это поручение, вернитесь к Главному распространителю чумы Харрису.‡Füllt die leere Apothekerflasche im Kessel mit Vrykulblut auf und vermischt ihren Inhalt so lange mit Harris\' Seuchenproben, die sich in der Nähe befinden, bis Ihr eine ausgewogene Mixtur erhaltet.|n|nSprecht wieder mit dem obersten Seuchenfürsten Harris, sobald Ihr die Aufgabe erledigt habt.‡브리쿨 혈액이 담긴 가마솥에서 연금술사의 빈 플라스크를 채운 다음 잘 섞인 혼합물을 만들 때까지 브리쿨 혈액이 담긴 플라스크를 근처에 있는 해리스의 역병 견본과 섞어야 합니다.|n|n임무를 마치면 고위 역병인도자 해리스에게 가야 합니다.‡Llena el frasco de boticario vacío con el contenido de la caldera de sangre vrykul y luego mezcla el contenido del frasco de sangre vrykul con las muestras de peste de Harris cercanas hasta que obtengas un brebaje equilibrado.|n|nPreséntate ante el jefe pesteador Harris cuando hayas completado esta tarea.‡Llena el frasco de boticario vacío con el contenido de la caldera de sangre vrykul y luego mezcla el contenido del frasco de sangre vrykul con las muestras de peste de Harris cercanas hasta que obtengas un brebaje equilibrado.|n|nPreséntate ante el jefe pesteador Harris cuando hayas completado esta tarea.‡Remplissez le Flacon d’apothicaire vide au Chaudron de sang de vrykul, puis mélangez le contenu du Flacon de sang de vrykul avec les Échantillons de peste de Harris jusqu’à ce que vous obteniez une Décoction équilibrée.|n|nLorsque ce sera fait, retournez voir le Porte-peste en chef Harris.‡在大锅旁装满药剂师的空瓶，然后在其中混入哈瑞斯的药剂样本，最终调制出一瓶均衡的溶液。|n|n完成调制任务后向首席药剂师哈瑞斯复命。‡用維酷血液之鍋的血裝滿空的藥劑師燒瓶，接著將維酷血液瓶混和進哈瑞斯的瘟疫樣本中，直到你獲得了安定的化合物為止。|n|n任務完成以後，向首席瘟疫使者哈里斯回報。',
  }
},
[11307] = {
  {
    'Teste de campo‡Полевые испытания‡Feldversuch‡임상 실험‡Ensayo de campo‡Ensayo de campo‡Essai sur le terrain‡药剂喷雾‡實地測試',
    nil,
    'Vá até Halgrind e use o Spray Pestilento em 10 Vraikalen Esfola-dragão Pestilentos. Fale novamente com o Pestífero-chefe Espargosa para apresentar os resultados.‡Отправляйтесь в Халгринд и заразите ассимилированным штаммом чумы 10 зачумленных врайкулов из клана Укротителей драконов, после чего вернитесь к главному распространителю чумы Харрису.‡Geht nach Halgrind und wendet das Seuchenspray auf 10 Verseuchte Vrykul der Drachenschinder an. Kehrt anschließend zum obersten Seuchenfürsten Harris zurück und erstattet ihm über die Ergebnisse Bericht.‡할그린드에 들어가 역병 분사기를 역병 걸린 용약탈 브리쿨 10명에게 사용한 다음 고위 역병인도자 해리스에게 돌아가 결과를 보고해야 합니다.‡Aventúrate en Haltorboll y utiliza el spray de peste con 10 vrykuls Desuelladragones apestados. Vuelve a ver al jefe pesteador Harris para informarle de los resultados.‡Aventúrate en Haltorboll y utiliza el spray de peste con 10 vrykuls Desuelladragones apestados. Vuelve a ver al jefe pesteador Harris para informarle de los resultados.‡Pénétrez dans Halegrince et utilisez le Pestorisateur sur 10 Vrykuls Écorche-dragon pestiférés. Ensuite, retournez voir le Porte-peste en chef Harris pour lui présenter les résultats.‡潜入哈尔格林德，找到10名被感染的掠龙维库人并使用药剂喷雾。‡前往霍葛萊，對10個染疫掠龍維酷人使用瘟疫噴霧劑。然後向首席瘟疫使者哈里斯回報。',
  }
},
[11308] = {
  {
    'Hora da limpeza‡Пора заметать следы‡Zeit aufzuräumen‡청소 시간‡Es hora de limpiar‡Es hora de limpiar‡On nettoie et on ferme‡清理实验场‡打掃時間',
    nil,
    'Fale com Claudete "Serra de Arco" em Nova Agamand.‡Поговорите с Дженни по прозвищу "Пила" в Новом Агамонде.‡Sprecht mit "Eisensäge" Jenny in Neu-Agamand.‡신 아가만드에 있는 "무쇠톱" 제니와 대화해야 합니다.‡Habla con "Sierra" Jenny en Nuevo Agamand.‡Habla con "Sierra" Jenny en Nuevo Agamand.‡Parlez à Jenny « Scie à métaux » à Nouvelle-Agamand.‡与新阿加曼德的“钢锯”杰妮谈一谈。‡和新阿加曼德的『鋼鋸』潔妮聊聊。',
  }
},
[11309] = {
  {
    'Peças para o serviço‡Запчасти для Дженни‡Benötigte Teile‡작업용 재료 수집‡Partes para el trabajo‡Partes para el trabajo‡Des p\'tits bouts partout‡重要零件‡工作所需',
    nil,
    'Claudete "Serra de Arco" quer que você consiga 6 Ligamentos de Cavacorne e 1 Quilo de Carne Fresca.‡Принесите 6 жил черпорога и 1 килограмм свежего мяса Дженни по прозвищу "Пила" в Новый Агаманд.‡"Eisensäge" Jenny in Neu-Agamand möchte, dass Ihr 6 Schaufelhauerbänder und 1 Pfund frisches Fleisch besorgt.‡신 아가만드에 있는 "무쇠톱" 제니가 뾰족엄니 인대 6개와 갓 저민 고깃덩이 1개를 구해 달라고 했습니다.‡"Sierra" Jenny en Nuevo Agamand quiere que consigas 6 ligamentos de colmipala y 1 porción de medio kilo de carne fresca.‡"Sierra" Jenny en Nuevo Agamand quiere que consigas 6 ligamentos de colmipala y 1 porción de medio kilo de carne fresca.‡Jenny « Scie à métaux », à la Nouvelle-Agamand, veut que vous récupériez 6 Ligaments de brochepelle et 1 Livre de chair fraîche.‡新阿加曼德的“钢锯”杰妮要求你收集6条铲齿鹿筋，再从旅行商安东那里购买一磅鲜肉，然后把这些东西带回去交给她。‡新阿加曼德的『鋼鋸』潔妮要你收集6條鍬牙韌帶和1磅新鮮的肉塊。',
  }
},
[11310] = {
  {
    'Aviso: requer montagem‡Внимание: требуется сборка‡Warnung: Ein wenig Montage benötigt‡주의: 조립 필요‡Aviso: requiere montaje‡Aviso: requiere montaje‡Avertissement : assemblage nécessaire‡集中处理‡警告:待組裝',
    nil,
    'Use o Kit de Montagem de Abominações em Halgrind e reúna Vraikalen pestilentos com a sua Abominação Mentecapta. Mate pelo menos 20 deles e em seguida fale novamente com Claudete "Serra de Arco".‡Воспользуйтесь набором для сборки поганища в Халгринде и сгоните в одно место как минимум 20 зачумленных врайкулов. Взорвите их с помощью поганища, после чего вернитесь к Дженни по прозвищу "Пила" в Новый Агамонд.‡Benutzt den Monstrositätenbausatz in Halgrind und tötet mithilfe der hirnlosen Monstrosität 20 verseuchte Vrykul. Kehrt nach Neu-Agamand zu "Eisensäge" Jenny zurück, sobald Ihr fertig seid.‡할그린드에서 누더기골렘 조립 도구를 사용해 넋 나간 누더기골렘을 불러낸 다음, 역병 걸린 브리쿨을 20명 이상 처치하고 신 아가만드에 있는 "무쇠톱" 제니에게 가야 합니다.‡Utiliza el juego de montaje de abominación en Haltorboll y reúne vrykuls apestados con tu abominación descerebrada. Acaba por lo menos con 20 y vuelve a ver a "Sierra" Jenny a Nuevo Agamand cuando hayas terminado.‡Utiliza el juego de montaje de abominación en Haltorboll y reúne vrykuls apestados con tu abominación descerebrada. Acaba por lo menos con 20 y vuelve a ver a "Sierra" Jenny a Nuevo Agamand cuando hayas terminado.‡Servez-vous de la Trousse de confection d’abomination à Halegrince. Attirez des Vrykuls pestiférés avec votre Abomination décérébrée. Tuez-en au moins 20, puis retournez voir Jenny « Scie à métaux » à la Nouvelle-Agamand.‡在哈尔格林德内使用憎恶装配包，然后使用无脑的憎恶消灭感染的维库人。至少打倒20个维库人以后回去向新阿加曼德的“钢锯”杰妮复命。‡在霍葛萊中使用憎惡體配件工具，利用無腦的憎惡體組圍捕染疫維酷人。殺死至少20個維酷人後，向新阿加曼德的『鋼鋸』潔妮回報。',
  }
},
[11311] = {
  {
    'O domínio dos elementos‡Сопротивляясь стихиям‡Die Elemente bekämpfen‡정령 억제‡Dar muerte a los elementos‡Dar muerte a los elementos‡Supprimer les éléments‡压制元素生物‡壓制元素',
    nil,
    'O Doma-ventos Kegam, da Aldeia Casco Invernal, quer que você mate 8 elementais da montanha. Você pode matar Ciclones Uivantes ou Elementais de Lasca de Gelo.‡Укротитель ветра Каган из Лагеря Заиндевевшего Копыта просит вас убить 8 горных элементалей. Уничтожайте завывающих циклонов или осколочных ледяных элементалей.‡Windzähmer Kagan im Lager der Winterhufe möchte, dass Ihr 8 Bergelementare tötet. Zu töten sind entweder heulende Zyklone oder Eissplitterelementare.‡겨울발굽 야영지에 있는 바람의 조련사 카간이 산에 있는 정령 8마리를 제거해 달라고 했습니다. 울부짖는 회오리 또는 얼음조각 정령을 처치하면 임무를 수행할 수 있습니다.‡El domador del viento Kajan, del Campamento Pezuña Invernal, quiere que mates 8 elementales de montaña. Puedes matar ciclones rugientes o elementales de fragmentos de hielo.‡El domador del viento Kajan, del Campamento Pezuña Invernal, quiere que mates 8 elementales de montaña. Puedes matar ciclones rugientes o elementales de fragmentos de hielo.‡Le Dompteur des vents Kagan, au Camp Sabot-d’hiver, veut que vous tuiez 8 élémentaires des montagnes. Il peut s’agir de Cyclones hurlants ou d’Élémentaires Glacéclat.‡冬蹄营地的驯风者卡根要你杀死附近雪山中的8个元素生物，咆哮的旋风或是碎冰元素都可以。‡冬蹄營地的馴風者卡剛要你殺死8個山地的元素。你可以殺死冰裂片元素或咆哮颶風。',
  }
},
[11312] = {
  {
    'Clareira Congelada‡Заиндевевшая поляна‡Die Gefrorene Lichtung‡얼어붙은 숲‡El Claro Helado‡El Claro Helado‡La clairière Gelée‡冰雪林地‡冰凍林地',
    nil,
    'Fale com Sedielle na Clareira Congelada.‡Поговорите с Луриэль на Заиндевевшей поляне.‡Sprecht mit Lurielle in der Gefrorenen Lichtung.‡얼어붙은 숲에 있는 루리엘과 대화해야 합니다.‡Habla con Lurielle en El Claro Helado.‡Habla con Lurielle en El Claro Helado.‡Parlez à Lurielle à la Clairière Gelée.‡与冰雪林地的鲁莉尔蕾谈一谈。‡和冰凍林地的露麗兒談談。',
  }
},
[11313] = {
  {
    'Espíritos do gelo‡Духи льда‡Geister des Eises‡얼음 정령‡Espíritus del hielo‡Espíritus del hielo‡Les esprits de la glace‡冰之精魂‡冰的靈魂',
    nil,
    'Sedielle, da Clareira Congelada, quer que você lhe traga 15 Núcleos Gélidos.‡Луриэль с Заиндевевшей поляны просит вас принести ей 15 ледяных ядер.‡Lurielle auf der Gefrorenen Lichtung möchte, dass Ihr ihr 15 eisige Kerne bringt.‡얼어붙은 숲에 있는 루리엘이 얼음 핵 15개를 가져다 달라고 했습니다.‡Lurielle en El Claro Helado quiere que le lleves 15 núcleos helados.‡Lurielle en El Claro Helado quiere que le lleves 15 núcleos helados.‡Lurielle de la Clairière Gelée veut que vous lui rapportiez 15 Noyaux glacials.‡冰雪林地的鲁莉尔蕾要求你为她带回15块冰冷核心。‡冰凍林地的露麗兒要你帶給他15顆冰結之核。',
  }
},
[11314] = {
  {
    'As irmãs decaídas‡Падшие сестры‡Die gefallenen Schwestern‡타락한 자매들‡Las hermanas caídas‡Las hermanas caídas‡Les sœurs déchues‡堕落的姐妹‡墮落的姊妹',
    nil,
    'Sedielle, da Clareira Congelada, quer que você use o pingente dela em 7 Ninfas Gélidas.‡Луриэль с Заиндевевшей поляны попросила вас воспользоваться ее подвеской, чтобы освободить 7 морозных нимф.‡Lurielle auf der Gefrorenen Lichtung möchte, dass Ihr ihren Anhänger auf 7 Eisnymphen verwendet.‡얼어붙은 숲의 루리엘이 그녀의 펜던트를 사용하여 얼음 요정 7명을 해방시켜 달라고 했습니다.‡Lurielle, en El Claro Helado, quiere que uses su colgante con 7 ninfas escalofrío.‡Lurielle, en El Claro Helado, quiere que uses su colgante con 7 ninfas escalofrío.‡Lurielle de la Clairière Gelée veut que vous utilisiez son pendentif sur 7 Nymphes algides.‡冰雪林地的鲁莉尔蕾要你对7只冰冷树妖使用她的坠饰。‡冰凍林地的露麗兒要你在7名冰寒水精身上使用她的墜飾。',
  }
},
[11315] = {
  {
    'Trepadeiras selvagens‡Дикие ветви‡Wilde Ranken‡야생의 덩굴‡Enredaderas salvajes‡Enredaderas salvajes‡Le lierre sauvage‡野蛮之藤‡狂亂的藤蔓',
    nil,
    'Sedielle, da Clareira Congelada, quer que você mate 8 Heras Escarlate.‡Луриэль с Заиндевевшей поляны попросила вас уничтожить 8 цветков алого плюща.‡Lurielle auf der Gefrorenen Lichtung möchte, dass Ihr 8 Exemplare des scharlachroten Efeus tötet.‡얼어붙은 숲의 루리엘이 붉은 담쟁이 8마리를 처치해 달라고 했습니다.‡Lurielle, en El Claro Helado, quiere que mates 8 hiedras escarlata.‡Lurielle, en El Claro Helado, quiere que mates 8 hiedras escarlata.‡Lurielle de la Clairière Gelée veut que vous tuiez 8 Lierres écarlates.‡冰雪林地的鲁莉尔蕾要求你杀死8只血色常青藤。‡冰凍林地的露麗兒要你去殺死8棵血色常春藤。',
  }
},
[11316] = {
  {
    'Filhos da Clareira Deformada‡Порождения Холмистой поляны‡Geflechte der Siechenden Lichtung‡뒤틀린 숲의 생명체‡Engendros de El Claro Retorcido‡Engendros de El Claro Retorcido‡L\'engeance de la clairière Tordue‡扭曲之林‡扭曲林地之子',
    nil,
    'Sedielle, da Clareira Congelada, quer que você mate 10 Rastejantes Vinhespinho.‡Луриэль с Заиндевевшей поляны просит вас убить 10 терноплющей.‡Lurielle auf der Gefrorenen Lichtung möchte, dass Ihr 10 Dornrankenkriecher tötet.‡얼어붙은 숲의 루리엘이 덩굴가시 이끼괴물 10마리를 처치해 달라고 했습니다.‡Lurielle en El Claro Helado quiere que mates a 10 trepadores viñaespina.‡Lurielle en El Claro Helado quiere que mates a 10 trepadores viñaespina.‡Lurielle de la Clairière Gelée veut que vous tuiez 10 Rampants roncevigne.‡冰雪林地的鲁莉尔蕾要求你杀死10只棘藤爬行者。‡冰凍林地的露麗兒要你去殺掉10個刺藤蠕行者。',
  }
},
[11317] = {
  {
    'A limpeza‡Очищение‡Die Läuterung‡정화‡La limpieza‡La limpieza‡La purification‡净化‡淨化',
    nil,
    'O Sábio Andanévoa, do Portão de Aço, o aconselhou a limpar sua Confusão Interior por meio de meditação no Santuário de Cunhalva.‡Ведун Странник Туманов у Стальных ворот посоветовал вам очиститься от внутреннего смятения путем медитации в святилище Ледяного Клинка.‡Weiser Nebelläufer am Stählernen Tor hat Euch geraten, Euren inneren Aufruhr durch Meditation am Frostklingenschrein zu besänftigen.‡서릿날 제단에서 명상으로 혼란한 속마음을 정화한 다음, 강철 관문에 있는 현인 미스트워커에게 가야 합니다.‡El sabio Caminaniebla en Las Puertas de Acero te ha aconsejado que limpies tu alma de tu conflicto interior meditando en el Santuario Filoescarcha.‡El sabio Caminaniebla en Las Puertas de Acero te ha aconsejado que limpies tu alma de tu conflicto interior meditando en el Santuario Filoescarcha.‡Le Sage Marche-brume vous a conseillé de vous purifier de votre Trouble intérieur par la méditation au Sanctuaire de Givrelame.‡钢铁之门的先知拉瑞恩·迷雾行者建议你前往霜刃神龛，通过冥想净化你内心的杂念。‡鋼鐵之門的賢者霧行建議你去霜刃聖壇冥想，好淨化你的內在騷動。',
  }
},
[11318] = {
  {
    'Isso sim é uma corrida de carneiro... ou quase‡А теперь гонки на баранах... Или вроде того.‡Das ist Widderrennen... zumindest fast‡산양 달리자‡Carrera de carneros... o algo parecido‡Carrera de carneros... o algo parecido‡Ça c\'est de la course de béliers... enfin, presque.‡赛羊会前的热身‡現在就是山羊競速…差不多。',
    nil,
    'Você tem 4 minutos para cavalgar o carneiro e manter 3 níveis diferentes de velocidade por 8 segundos cada.‡У вас есть 4 минуты, чтобы погонять барана на всех трех скоростях по 8 секунд.‡Ihr habt 4 Minuten, um den Widder zu reiten und dabei 3 verschiedene Geschwindigkeitsstufen für jeweils 8 Sekunden zu halten.‡4분 동안 산양을 타면서 3가지 서로 다른 속도를 각각 8초간 유지해야 합니다.‡Tienes 4 minutos para montar el carnero y mantener 3 niveles de velocidad diferentes durante 8 segundos.‡Tienes 4 minutos para montar el carnero y mantener 3 niveles de velocidad diferentes durante 8 segundos.‡Vous avez 4 minutes pour chevaucher le bélier et maintenir 3 différentes allures pendant 8 secondes chacune.‡你有4分钟时间驾驭赛羊，让它保持三种不同的速度各8秒。‡你有4分鐘的時間可以鞭打山羊，然後在3種不同速度下各維持8秒。',
  }
},
[11319] = {
  {
    'Sementes dos guardiões de alma negra‡Семена негодующих хранителей‡Samen der schwarzbeseelten Bewahrer‡영혼이 타락한 수호자의 씨앗‡Semillas de los vigilantes Almanegra‡Semillas de los vigilantes Almanegra‡Les graines de gardiens à l\'âme noircie‡暗魂守护者的种子‡黑魂看守者種子',
    nil,
    'Sedielle, da Clareira Congelada, quer que você mate 8 Esporos.‡Луриэль с Заиндевевшей поляны поручила вам заморозить 8 спор.‡Lurielle auf der Gefrorenen Lichtung möchte, dass ihr 8 Sporen einfriert.‡얼어붙은 숲에 있는 루리엘이 포자 8개를 얼려 달라고 했습니다.‡Lurielle en El Claro Helado quiere que congeles 8 esporas.‡Lurielle en El Claro Helado quiere que congeles 8 esporas.‡Lurielle de la Clairière Gelée veut que vous geliez 8 Spores.‡冰雪林地的鲁莉尔蕾要求你冻结8个孢子。‡冰凍林地的露麗兒要你摧毀8個孢子。',
  }
},
[11320] = {
  {
    '[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.‡[NYI] Now this is Ram Racing... Almost.',
    nil,
    'Log Descritpion‡Краткая формулировка‡Log Descritpion‡Log Descritpion‡Log Descritpion‡Log Descritpion‡Texte à venir‡Log Descritpion‡Log Descritpion',
  }
},
[11321] = {
  {
    '‡Кто сказал "сувениры"?‡Sagte da jemand "Souvenir"?‡‡¿Alguien dijo "souvenir?"‡¿Alguien dijo "souvenir?"‡Quelqu\'un a dit « souvenir » ?‡‡',
    nil,
    '‡Отоварьте свой купон на праздничную кружку у Бликса Чиништукса в лагере Хмельного фестиваля.‡Löst Euren Gutschein für einen Braufestkrug bei Belbi Blitzknips im Braufestlager ein.‡가을 축제 광장 뒤쪽에 있는 벨비 퀵스위치에게 가을 축제 잔 상품권을 가져가서 축제 잔으로 교환해야 합니다.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la Cerveza.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la Cerveza.‡Échangez le bon-cadeau à Belbi Coupecircuit dans le campement de la fête des Brasseurs.‡去美酒节营地的贝尔比那里兑换美酒节礼品券。‡',
  }
},
[11322] = {
  {
    'A limpeza‡Очищение‡Die Läuterung‡정화‡La limpieza‡La limpieza‡La purification‡净化‡淨化',
    nil,
    'A Guardiã Folha-da-lua, no Portão de Aço, o aconselhou a limpar sua Confusão Interior por meio de meditação no Santuário de Cunhalva.‡Дозорная Лунный Лепесток у Стальных ворот посоветовала вам очиститься от внутреннего смятения путем медитации в святилище Ледяного Клинка.‡Behüterin Mondblatt am Stählernen Tor hat Euch geraten, Euren inneren Aufruhr durch Meditation am Frostklingenschrein zu besänftigen.‡서릿날 제단에서 명상으로 혼란한 속마음을 정화한 다음, 강철 관문에 있는 감시자 문리프에게 가야 합니다.‡La vigía Hojaluna en Las Puertas de Acero te ha aconsejado que limpies tu alma de tu conflicto interior meditando en el Santuario Filoescarcha.‡La vigía Hojaluna en Las Puertas de Acero te ha aconsejado que limpies tu alma de tu conflicto interior meditando en el Santuario Filoescarcha.‡La guetteuse Feuillelune vous a conseillé de vous purifier de votre Trouble intérieur par la méditation au Sanctuaire de Givrelame.‡钢铁之门的观察者莉莎·月叶建议你前往霜刃神龛，通过冥想净化你内心的杂念。‡鋼鐵之門的看守者月葉建議你去霜刃聖壇冥想，好淨化你的內在騷動。',
  }
},
[11323] = {
  {
    'Em pele de worg‡В обличье ворга‡Im Worgpelz‡검은늑대의 모습으로‡En el pellejo de un huargo‡En el pellejo de un huargo‡Déguisé en worg‡座狼的伪装‡披著座狼皮',
    nil,
    'O Sábio Andanévoa pediu para você procurar e ajudar Ulfang, no Bosque Fendido.|n|nSe o Disfarce de Worg desaparecer, peça outro para o Sábio Andanévoa.‡Ведун Странник Туманов попросил вас найти Улклыка в Вырубках и помочь ему.|n|nЕсли вы потеряете личину ворга, вернитесь к ведуну Страннику Туманов, и он даст вам новую.‡Der Weise Nebelläufer hat Euch gebeten, Ulfang im Bruchwald zu suchen und ihm zu helfen.|n|nKehrt zum Weisen Nebelläufer zurück, um einen Ersatz zu erhalten, solltet Ihr die Worgverkleidung verlieren.‡현인 미스트워커가 비틀린 숲에서 울팡을 찾아 도와주라고 했습니다.|n|n검은늑대 위장복을 잃어버리면 현인 미스트워커에게 돌아가 새로 받아야 합니다.‡El sabio Caminaniebla te ha pedido que encuentres y ayudes a Ulkang en El Bosque Hendido.|n|nSi por algún motivo pierdes el disfraz de huargo, vuelve a ver al sabio Caminaniebla para que te dé otro.‡El sabio Caminaniebla te ha pedido que encuentres y ayudes a Ulkang en El Bosque Hendido.|n|nSi por algún motivo pierdes el disfraz de huargo, vuelve a ver al sabio Caminaniebla para que te dé otro.‡Le Sage Marche-brume vous a demandé de trouver Ulfang et de l’aider. Il doit se trouver dans Clivebois.|n|nSi vous perdez le déguisement de worg, demandez au Sage Marche-brume de vous le remplacer.‡先知拉瑞恩·迷雾行者要你前往裂木森林，找到并帮助乌尔芬。|n|n如果你弄丢了座狼伪装，可以找先知拉瑞恩·迷雾行者再要一件。‡賢者霧行要你到裂木森林找出巫牙並且幫助牠。如果你失去了座狼偽裝，回去找賢者霧行再要一個。',
  }
},
[11324] = {
  {
    'Worg alfa‡Альфа-ворг‡Alphaworg‡검은늑대 우두머리‡Huargo alfa‡Huargo alfa‡L\'alpha des worgs‡头狼‡座狼首領',
    nil,
    'Ulfang quer que você mate Garwal. Em seguida, devolva o Disfarce de Worg para o Sábio Andanévoa, no Portão de Aço.‡Улклык попросил вас убить Гарвала. После этого вы должны будете вернуть личину ворга ведуну Страннику Туманов в Стальные ворота.‡Ulfang hat Euch gebeten, Garwal zu erschlagen. Kehrt danach zum Weisen Nebelläufer am Stählernen Tor zurück und bringt die Worgverkleidung mit.‡울팡이 가르왈을 처치한 다음, 강철 관문에 있는 현인 미스트워커에게 검은늑대 위장복을 돌려주라고 했습니다.‡Ulkang te ha pedido que mates a Garwal. Después, devuelve el disfraz de huargo al sabio Caminaniebla en Las Puertas de Acero.‡Ulkang te ha pedido que mates a Garwal. Después, devuelve el disfraz de huargo al sabio Caminaniebla en Las Puertas de Acero.‡Ulfang vous a demandé de tuer Garwal. Ensuite, retournez voir le Sage Marchebrume à la Porte d’acier et rendez-lui le Déguisement de worg.‡乌尔芬要你去杀死迦瓦尔。然后返回钢铁之门，将座狼伪装还给先知拉瑞恩·迷雾行者。‡巫牙要求你殺掉賈爾沃。接著將座狼偽裝交還給鋼鐵之門的賢者霧行。',
  }
},
[11325] = {
  {
    'Em pele de worg‡В обличье ворга‡Im Worgpelz‡검은늑대의 모습으로‡En el pellejo de un huargo‡En el pellejo de un huargo‡Déguisé en worg‡座狼的伪装‡披著座狼皮',
    nil,
    'A Guardiã Folha-da-lua pediu para você procurar e ajudar Ulfang, no Bosque Fendido.|n|nSe o disfarce desaparecer, peça outro para a Guardiã Folha-da-lua.‡Дозорная Лунный Лепесток попросила вас найти Улклыка в Вырубках и помочь ему.|n|nЕсли вы потеряете личину ворга, вернитесь к дозорной Лунный Лепесток, и она даст вам новую.‡Behüterin Mondblatt hat Euch gebeten, Ulfang im Bruchwald zu suchen und ihm zu helfen.|n|nKehrt zu Behüterin Mondblatt zurück, um einen Ersatz zu erhalten, solltet Ihr die Worgverkleidung verlieren.‡감시자 문리프가 비틀린 숲에서 울팡을 찾아 도와주라고 했습니다.|n|n검은늑대 위장복을 잃어버리면 감시자 문리프에게 돌아가 새로 받아야 합니다.‡La vigía Hojaluna te ha pedido que encuentres y ayudes a Ulkang en El Bosque Hendido.|n|nSi por algún motivo pierdes el disfraz de huargo, vuelve a ver a la vigía Hojaluna para que te dé otro.‡La vigía Hojaluna te ha pedido que encuentres y ayudes a Ulkang en El Bosque Hendido.|n|nSi por algún motivo pierdes el disfraz de huargo, vuelve a ver a la vigía Hojaluna para que te dé otro.‡La guetteuse Feuillelune vous a demandé de trouver Ulfang et de l’aider. Il doit se trouver dans Clivebois.|n|nSi vous perdez le Déguisement de worg, demandez à la guetteuse Feuillelune de vous le remplacer.‡观察者莉莎·月叶要你前往裂木森林，找到并帮助乌尔芬。|n|n如果你弄丢了座狼伪装，可以找观察者莉莎·月叶再要一件。‡看守者月葉要你到裂木森林找出巫牙並且幫助牠。如果你失去了座狼偽裝，回去找看守者月葉再要一個。',
  }
},
[11326] = {
  {
    'Worg alfa‡Альфа-ворг‡Alphaworg‡검은늑대 우두머리‡Huargo alfa‡Huargo alfa‡L\'alpha des worgs‡头狼‡座狼首領',
    nil,
    'Ulfang quer que você mate Garwal. Em seguida, devolva o Disfarce de Worg para a Guardiã Folha-da-lua, no Portão de Aço.‡Улклык попросил вас убить Гарвала. После этого вы должны будете вернуть личину ворга дозорной Лунный Лепесток в Стальные ворота.‡Ulfang hat Euch gebeten, Garwal zu erschlagen. Kehrt danach zu Behüterin Mondblatt am Stählernen Tor zurück und bringt die Worgverkleidung mit.‡울팡이 가르왈을 처치한 다음, 강철 관문에 있는 감시자 문리프에게 검은늑대 위장복을 돌려주라고 했습니다.‡Ulkang te ha pedido que mates a Garwal. Después, devuelve el disfraz de huargo a la vigía Hojaluna en Las Puertas de Acero.‡Ulkang te ha pedido que mates a Garwal. Después, devuelve el disfraz de huargo a la vigía Hojaluna en Las Puertas de Acero.‡Ulfang vous a demandé de tuer Garwal. Ensuite, retournez voir la Guetteuse Feuillelune à la Porte d’acier et rendez-lui le Déguisement de worg.‡乌尔芬要你去杀死迦瓦尔。然后返回钢铁之门，将座狼伪装还给观察者莉莎·月叶。‡巫牙要求你殺掉賈爾沃。接著將座狼偽裝交還給鋼鐵之門的看守者月葉。',
  }
},
[11327] = {
  {
    'Missão: recuperar o pacote‡Задание: найти сверток‡Mission \'Paket beschaffen\'‡임무: 꾸러미 탈환‡Misión: Devolver el paquete‡Misión: Devolver el paquete‡Mission : récupération de paquet‡任务：夺回包裹‡任務:取回包裹',
    nil,
    'O Batedor Knowles quer que você resgate o Pacote do Boticário de dentro de Halgrind. Assim que conseguir, apresente-se ao batedor na Torre da Lança Incandescente.‡Разведчик Ноулс просит вас найти сверток аптекаря в Халгринде. Принесите его разведчику в Тлеющую башню.‡Kundschafter Wisslich möchte, dass Ihr nach Halgrind geht und das Paket des Apothekariums beschafft. Kehrt zu ihm zurück, sobald Ihr das getan habt. Er befindet sich am Glutspeerturm.‡잿불창 경비탑에 있는 정찰병 노울스가 할그린드에서 연금술사의 꾸러미를 회수해 달라고 했습니다.‡El explorador Knowles te ha pedido que recuperes el paquete de boticario que está en el interior de Haltorboll. Cuando lo tengas, vuelve a ver al explorador a la Torre Lanza Ámbar.‡El explorador Knowles te ha pedido que recuperes el paquete de boticario que está en el interior de Haltorboll. Cuando lo tengas, vuelve a ver al explorador a la Torre Lanza Ámbar.‡L’Éclaireur Knowles vous a demandé de récupérer le Paquet de l’apothicaire, qui est quelque part dans Halegrince. Lorsque vous l’aurez, retournez le voir à la tour de la Lance de braise.‡斥候诺勒斯要你前往哈尔格林德，夺回药剂师的包裹。然后返回灰烬长矛塔楼向他复命。‡斥候諾雷斯要去霍葛萊取回藥劑師的包裹。一旦你完成任務，回到餘燼矛塔向他報告。',
  }
},
[11328] = {
  {
    'Missão: informações dos Renegados‡Задание: чума Отрекшихся‡Mission \'Kunde über die Verlassenen\'‡임무: 포세이큰 정보‡Misión: Inteligencia Renegada‡Misión: Inteligencia Renegada‡Mission : des infos sur les Réprouvés‡任务：被遗忘者的情报‡任務:被遺忘者的情報',
    nil,
    'O Batedor Knowles quer que você entregue o Pacote do Boticário para Pepa Bicotorto, na Bastilha da Guarda Oeste.‡Разведчик Ноулс просит вас отнести сверток аптекаря Пеппи Нетосопло в Крепость Западной Стражи.‡Kundschafter Wisslich möchte, dass Ihr das Paket des Apothekariums zu Peppy Falschdüse bringt. Sie befindet sich in der Taverne in Westwacht.‡정찰병 노울스가 서부경비대 성채에 있는 페피 롱노즐에게 연금술사의 꾸러미를 전달해 달라고 했습니다.‡El explorador Knowles te ha pedido que entregues el paquete de boticario a Peppy Pedal en la Fortaleza de la Guardia Oeste.‡El explorador Knowles te ha pedido que entregues el paquete de boticario a Peppy Pedal en la Fortaleza de la Guardia Oeste.‡L’Éclaireur Knowles vous a demandé de livrer le Paquet de l’apothicaire à Peppy Tuyèrronée, au donjon de la Garde de l’ouest.‡斥候诺勒斯要你将药剂师的包裹送往西部卫戍要塞，交给贝比·鲁诺兹。‡斥候諾雷斯要求你將藥劑師的包裹送給鎮西要塞的派比·錯鼻。',
  }
},
[11329] = {
  {
    'Farei de tudo!‡Я готов на все!‡Ich werde alles versuchen!‡나는 뭐든지 한다!‡¡Probaré lo que sea!‡¡Probaré lo que sea!‡J\'essayerai n\'importe quoi !‡想尽办法！‡我什麼都願意嘗試!',
    nil,
    'Cristóvão Slento, do Forte Vildervar, quer que você lhe traga 5 Farpeixes do Norte.‡Принесите Кристоферу Слоану из крепости Вилдервар 5 северных рыб-шипов.‡Christopher Sloan bei Fort Wildervar möchte, dass Ihr ihm 5 Nordbarben bringt.‡빌더바르 요새의 크리스토퍼 슬로안이 극지 가시물고기 5마리를 구해 달라고 했습니다.‡Christopher Sloan de Fuerte Vildervar quiere que le traigas 5 rascacios del Norte.‡Christopher Sloan de Fuerte Vildervar quiere que le traigas 5 rascacios del Norte.‡Christopher Sloan, au Fort Hardivar, veut que vous lui rapportiez 5 Rascasses nordiques.‡维德瓦堡垒的克里斯托弗·斯洛安要求你给他带回5条北方鲶鱼。‡威德瓦堡壘的克里斯多夫·斯洛安要你帶5條北地刺鬚魚給他。',
  }
},
[11330] = {
  {
    'Com cherveza... Issho vai dar certo!‡Это... точно сработает!‡Dasch wird auf jeden Fall... funzen!‡이건... 제대로 먹힐 걸!‡Pods shupuesshto... ¡Eshto fva a fvuncionar!‡Pods shupuesshto... ¡Eshto fva a fvuncionar!‡Farpaitement ! Cha va marcher !‡绝对……没问题！‡當然…有用!',
    nil,
    'Pepa Bicotorto, da Bastilha da Guarda Oeste, sugeriu que você pegue a Batida Especial da Pepa e a administre via oral no Prisioneiro Vraikal Esfola-dragão para observar os efeitos.‡Пеппи Нетосопло предложила вам отнести ее особую смесь врайкулу-узнику из клана Укротителей драконов. Когда он выпьет смесь, вернитесь в Крепость Западной Стражи и расскажите Пеппи о результатах эксперимента.‡Peppi Falschdüse in Westwacht schlägt vor, dass Ihr dem gefangenen Vrykul der Drachenschinder Peppis Spezialmix verabreicht, um zu sehen, welche Wirkung er hat.‡서부경비대 성채에 있는 페피 롱노즐이 페피의 특별 혼합물을 용약탈 브리쿨 포로에게 투여하고 결과를 관찰해 달라고 했습니다.‡Peppy Pedal en la Fortaleza de la Guardia Oeste te ha sugerido que le lleves la mezcla especial de Peppy y se la administres al prisionero vrykul Desuelladragones para observar los resultados.‡Peppy Pedal en la Fortaleza de la Guardia Oeste te ha sugerido que le lleves la mezcla especial de Peppy y se la administres al prisionero vrykul Desuelladragones para observar los resultados.‡Peppy Tuyèrronée suggère que vous preniez son Mélange spécial de Peppy et que vous l’administriez au Vrykul écorche-dragon prisonnier, pour voir.‡西部卫戍要塞的贝比·鲁诺兹要你让疯狂的掠龙维库长老喝下贝比的特殊混合剂，并观察药剂的效果。‡鎮西要塞的派比·錯鼻建議你把她的派比的特殊混合物給掠龍維酷囚犯服下，並且觀察服用後的結果。',
  }
},
[11331] = {
  {
    'Diga a ele que... Hic!‡Ик... Ты ему и скажи!‡Du sagst\'s ihm... hicks!‡당신이 말해줘... 딸꾹!‡Se lo cuentas tú... ¡hip!‡Se lo cuentas tú... ¡hip!‡Allez lui dire que... Hips !‡你去告诉他……嗝儿！‡你跟他說…嗝!',
    nil,
    'Pepa Bicotorto convenceu você a dar as más notícias sobre a peste dos Renegados para o Capitão Carneiro. Procure-o na Bastilha da Guarda Oeste.‡Пеппи Нетосопло уговорила вас сообщить плохие новости о новой чуме Отрекшихся капитану Адамсу. Его можно найти в Крепости Западной Стражи.‡Peppi Falschdüse hat Euch dazu gebracht, Hauptmann Adams die schlechten Nachrichten über die Seuche der Verlassenen zu überbringen. Ihr findet ihn in Westwacht.‡페피 롱노즐이 포세이큰 역병에 관한 나쁜 소식을 서부경비대 성채에 있는 경비대장 아담스에게 전해 달라고 했습니다.‡Peppy Pedal te ha liado para que le des las malas noticias acerca de la peste de los Renegados al capitán Adams. Ve a verle a la Fortaleza de la Guardia Oeste.‡Peppy Pedal te ha liado para que le des las malas noticias acerca de la peste de los Renegados al capitán Adams. Ve a verle a la Fortaleza de la Guardia Oeste.‡Peppy Tuyèrronée vous a manipulé afin que ce soit vous qui annonciez au Capitaine Adams les mauvaises nouvelles concernant la peste des Réprouvés. Allez le voir au donjon de la Garde de l’ouest.‡贝比·鲁诺兹让你前往西部卫戍要塞，将关于被遗忘者疫病的坏消息告诉亚当斯上尉。‡派比·錯鼻拖著你要你把被遺忘者瘟疫的壞消息告訴亞當斯隊長。前往凜風峽灣的鎮西要塞拜訪他。',
  }
},
[11332] = {
  {
    'Missão: empesteie isso!‡Задание: уничтожить чуму!‡Mission: Verseucht mal das hier!‡임무: 역병 막기!‡Misión: Echar pestes‡Misión: Echar pestes‡Mission : contamination !‡任务：瘟疫罐！‡任務:毀掉瘟疫!',
    nil,
    'O Capitão Carneiro mandou você lançar 5 bombas nos Tanques Pestilentos de Nova Agamand. Não se apresente a ele novamente enquanto não completar a missão.‡Капитан Адамс приказал вам сбросить 5 бомб на резервуары с чумой в Новом Агамонде. Вернитесь к нему в Крепость Западной Стражи, когда это поручение будет выполнено.‡Hauptmann Adams hat Euch befohlen, 5 Bomben auf die Seuchenkessel bei Neu-Agamand abzuwerfen. Kehrt erst zu ihm zurück, sobald Ihr die Aufgabe erledigt habt. Er befindet sich in Westwacht.‡신 아가만드에 있는 역병 수조에 폭탄을 5발 명중시키고 나서, 서부경비대 성채에 있는 경비대장 아담스에게 가야 합니다.‡El capitán Adams te ha ordenado que destruyas 5 tanques de peste en Nuevo Agamand. No vuelvas a verlo a la Fortaleza de la Guardia Oeste hasta que no hayas cumplido tu misión.‡El capitán Adams te ha ordenado que destruyas 5 tanques de peste en Nuevo Agamand. No vuelvas a verlo a la Fortaleza de la Guardia Oeste hasta que no hayas cumplido tu misión.‡Le Capitaine Adams vous a ordonné de larguer 5 bombes sur les Chars de peste de la Nouvelle-Agamand. Ne revenez pas le voir au donjon de la Garde de l’ouest tant que ce ne sera pas fait.‡亚当斯上尉命令你前往新阿加曼德，对瘟疫罐投下5颗炸弹。完成任务后返回西部卫戍要塞向他复命。‡亞當斯隊長命令你丟5顆炸彈擊中新阿加曼德的瘟疫槽。完成任務之前不要回到鎮西要塞找他。',
  }
},
[11333] = {
  {
    'No mundo dos espíritos‡В мир духов‡Reise in die Welt der Geister‡정령의 세계로‡En el mundo de los espíritus‡En el mundo de los espíritus‡Dans le monde des esprits‡进入灵魂世界‡進入靈體世界',
    nil,
    'Thorálius, o Sábio, de Valgarde, quer que você encontre o Bornal de Reagentes dele.‡Торелий Мудрый в Валгарде просит вас найти его мешочек с реагентами.‡Thoralius der Weise in Valgarde möchte, dass Ihr seinen Reagenzienbeutel findet.‡발가드에 있는 현자 토랄리우스가 그의 시약 주머니를 찾아달라고 했습니다.‡Thoralius el Sabio, en Valgarde, quiere que busques su faltriquera de componentes.‡Thoralius el Sabio, en Valgarde, quiere que busques su faltriquera de componentes.‡Thoralius le Sage à Valgarde veut que vous retrouviez sa Bourse de réactifs.‡瓦加德的智者索拉留斯要你找回他的材料包。‡瓦爾加德的『智者』索拉利亞思要你去尋找試劑袋。',
  }
},
[11334] = {
  {
    'Ele atira, ele acerta!‡В яблочко!‡Er schießt, er trifft!‡당신은 백발백중!‡¡Dispara y marca!‡¡Dispara y marca!‡Dans le mille !‡He Shoots, He Scores!‡打中，得分!',
    nil,
    '[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.‡[PH] Rinling wants you to shoot a marked target and then return the Target Rifle to him.',
  }
},
[11335] = {
  {
    'Chamado às armas: Bacia Arathi‡Призыв к оружию: низина Арати‡Ruf zu den Waffen: Arathibecken‡전장으로: 아라시 분지‡Llamamiento a las armas: Cuenca de Arathi‡Llamamiento a las armas: Cuenca de Arathi‡Appel aux armes : bassin Arathi‡战斗的召唤：阿拉希盆地‡戰鬥的號角: 阿拉希盆地',
    nil,
    'Vença uma partida no campo de batalha da Bacia Arathi e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Низины Арати и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Arathibecken und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡아라시 분지 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Bassin Arathi, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在阿拉希盆地战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在阿拉希盆地的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[11336] = {
  {
    'Chamado às armas: Vale Alterac‡Призыв к оружию: Альтеракская долина‡Ruf zu den Waffen: Alteractal‡전장으로: 알터랙 계곡‡Llamamiento a las armas: Valle de Alterac‡Llamamiento a las armas: Valle de Alterac‡Appel aux armes : vallée d\'Alterac‡战斗的召唤：奥特兰克山谷‡戰鬥的號角:奧特蘭克山谷',
    nil,
    'Vença uma partida no campo de batalha do Vale Alterac e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Альтеракской долины и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Alteractal und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡알터랙 계곡 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla del Valle de Alterac y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.|n‡Gana un encuentro en el campo de batalla del Valle de Alterac y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.|n‡Remportez la bataille dans la Vallée d\'Alterac, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在奥特兰克山谷战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在奧特蘭克山谷的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[11337] = {
  {
    'Chamado às armas: Olho da Tormenta‡Призыв к оружию: Око Бури‡Ruf zu den Waffen: Auge des Sturms‡전장으로: 폭풍의 눈‡Llamamiento a las armas: Ojo de la Tormenta‡Llamamiento a las armas: Ojo de la Tormenta‡Appel aux armes : Œil du cyclone‡战斗的召唤：风暴之眼‡戰鬥的號角:暴風之眼',
    nil,
    'Vença uma partida no campo de batalha do Olho da Tormenta e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Ока Бури и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Auge des Sturms und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡폭풍의 눈 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla del Ojo de la Tormenta y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla del Ojo de la Tormenta y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gagnez dans l\'Œil du cyclone, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在风暴之眼战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在暴風之眼的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[11338] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Ущелья Песни Войны и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在战歌峡谷战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在戰歌峽谷的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[11339] = {
  {
    'Chamado às armas: Bacia Arathi‡Призыв к оружию: низина Арати‡Ruf zu den Waffen: Arathibecken‡전장으로: 아라시 분지‡Llamamiento a las armas: Cuenca de Arathi‡Llamamiento a las armas: Cuenca de Arathi‡Appel aux armes : bassin Arathi‡战斗的召唤：阿拉希盆地‡戰鬥的號角: 阿拉希盆地',
    nil,
    'Vença uma partida no campo de batalha da Bacia Arathi e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Низины Арати и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Arathibecken und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡아라시 분지 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Bassin Arathi, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在阿拉希盆地战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在阿拉希盆地的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
