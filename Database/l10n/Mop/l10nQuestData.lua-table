[27133] = {
  {
    'De olho no céu‡Небесные очи‡Blick zum Himmel‡하늘의 눈‡Ojos en el cielo‡Ojos en el cielo‡Des yeux dans le ciel‡空中的眼睛‡空中的偵察眼',
    nil,
    'Fale com o Druida do Gadanho.‡Поговорите с друидом-вороном.‡Sprecht mit dem Druiden der Kralle.‡갈퀴발톱의 드루이드와 대화해야 합니다.‡Habla con el Druida de la Garfa.‡Habla con el Druida de la Garfa.‡Parlez au Druide de la Serre.‡与猛禽德鲁伊交谈。‡和猛禽德魯伊說話。',
  }
},
[27134] = {
  {
    'Tem ogro na área‡Огр на поле боя‡Oger im Feld‡전장의 오우거‡Ogro en el campo‡Ogro en el campo‡Les ogres au combat‡战场的食人魔‡戰地巨魔',
    nil,
    'Fale com o Ogro Pedramalho.‡Поговорите с огром Каменного Молота.‡Sprecht mit dem Oger der Steinbrecher.‡돌망치 오우거와 대화해야 합니다.‡Habla con el ogro Quebrantarrocas.‡Habla con el ogro Quebrantarrocas.‡Parlez à l\'Ogre Cognepierre.‡与石槌食人魔交谈。‡和石槌巨魔說話。',
  }
},
[27135] = {
  {
    'Cadê o combustível?‡Что-то пылающее‡Etwas, das brennt‡화끈한 게 좋아‡Algo que arda‡Algo que arda‡Matériau inflammable !‡能点着的‡火燙燙的東西',
    nil,
    'Pegue o Coração Ardente.‡Добудьте пылающее сердце.‡Erhaltet das brennende Herz.‡불타는 심장을 구해야 합니다.‡Consigue El Corazón Ardiente.‡Consigue El Corazón Ardiente.‡Récupérez le Cœur ardent.‡获得灼燃之心。‡取得燃燒的心。',
  }
},
[27136] = {
  {
    'Energia elemental‡Энергия элементалей‡Elementarenergie‡정령의 에너지‡Energía elemental‡Energía elemental‡Énergie élémentaire‡元素能量‡元素能量',
    nil,
    'Destrua 8 Geodos Energizados ou Elementais de Magnetita ao lado do Totem Exaurido.‡Уничтожьте 8 заряженных жеод или магнитных элементалей вблизи опустошенного тотема.‡Zerstört 8 aufgeladene Geoden oder Leitsteinelementare in der Nähe des erschöpften Totems.‡마력이 고갈된 토템 주위에서 충전된 정동석 또는 자철광 정령 8마리를 파괴해야 합니다.‡Acaba con 8 geodas energizadas o elementales de magnetita cerca del tótem mermado.‡Acaba con 8 geodas energizadas o elementales de magnetita cerca del tótem mermado.‡Détruisez 8 Géodes énergisées ou Élémentaires de magnétite près du Totem déchargé.‡在能量枯竭的图腾附近摧毁8个充能的晶簇或磁石元素。‡在枯竭的圖騰的附近摧毀8個充滿能量的晶簇或磁石元素。',
  }
},
[27137] = {
  {
    '‡С земными девушками не совладать‡Erdmädchen sind nicht einfach‡난공불락의 대지 소녀‡Las chicas de la tierra no son tan fáciles‡‡C\'est pas chouette, les filles du bord de terre‡大地女孩，殊难伺候‡',
    nil,
    nil,
  }
},
[27138] = {
  {
    '‡С земными девушками не совладать‡Erdmädchen sind nicht einfach‡난공불락의 대지 소녀‡Las chicas de la tierra no son tan fáciles‡‡C\'est pas chouette, les filles du bord de terre‡大地女孩，殊难伺候‡',
    nil,
    nil,
  }
},
[27139] = {
  {
    'Roberto precisa de você‡Хобарту нужна твоя помощь‡Hobart braucht Euch‡호바트의 부름‡Hobart te necesita‡Hobart te necesita‡Hobart a besoin de vous‡霍巴特需要你‡荷巴爾特需要你',
    nil,
    'Fale com Roberto Agarramalho na Cidade Portátil, que fica nas Ilhas Perdidas.‡Поговорите с Хобартом Дреком в Городке-из-табакерки на Затерянных островах.‡Sprecht mit Hobart Wurfhammer in Instastadt auf den Verlorenen Inseln.‡잃어버린 섬의 상자 마을에 있는 호바트 그래플해머와 대화해야 합니다.‡Habla con Hobart Martillazos en la Ciudad de Bolsillo, en Las Islas Perdidas.‡Habla con Hobart Martillazos en la Ciudad de Bolsillo, en Las Islas Perdidas.‡Parlez à Hobart Martelutte à Ville-en-Boîte sur les Îles Perdues.‡跟失落群岛胶囊镇的霍巴特·钩锤谈一谈。‡在失落群島上的盒中鎮和荷巴爾特·繫錘說話。',
  }
},
[27140] = {
  {
    'Artimanha de Alexei‡Ловушка Алексия‡Alexis Gambit‡알렉시의 계략‡El Gambito de Alexi‡El Gambito de Alexi‡Le gambit d\'Alexi‡阿莱克斯的谋略‡黎明先鋒',
    nil,
    'Coloque a Artimanha de Alexei na Sala de Exibição e mate Vectus e Marduk.‡Положите ловушку в демонстрационной комнате и уничтожьте Вектуса и Мардука.‡Platziert das Gambit im Vorführraum und tötet Vectus und Marduk.‡스칼로맨스 강당에 알렉시의 계략을 배치한 채로 벡투스와 마르두크를 처치해야 합니다.‡Coloca el Gambito en la Sala de la Visión y mata a Vectus y a Marduk.‡Coloca el Gambito en la Sala de la Visión y mata a Vectus y a Marduk.‡Placez le Gambit dans la Chambre des Visions puis tuez Vectus et Marduk.‡将阿莱克斯的谋略箱放在观察室里，然后杀死维克图斯和玛杜克。‡把先鋒放在觀察室裡面並殺死維克圖斯和馬杜克。',
  }
},
[27141] = {
  {
    'Entrada explosiva‡Преждевременный взрыв‡Explosiv‡폭발 너머로‡Se hace camino al explotar‡El camino a la explosión‡Une explosion fracassante‡炸裂‡炸過去',
    nil,
    'Ajude Harrison Jones na Tumba de Khartut.‡Помогите Харрисону Джонсу войти в гробницу Хартута.‡Helft Harrison Jones am Grab des Khartut.‡카르투트의 무덤에서 해리슨 존스를 도와야 합니다.‡Ayuda a Harrison Jones en la Tumba de Khartut.‡Ayuda a Harrison Jones en la Tumba de Khartut.‡Aidez Harrison Jones dans la Tombe de Khartut.‡在卡塔图陵墓里协助哈里森·琼斯。‡在卡爾吐特之墓協助哈里遜•瓊斯。',
  }
},
[27142] = {
  {
    'O lich, Ras Friomúrmuro‡Рас Ледяной Шепот – лич‡Der Lich Ras Frostraunen‡리치, 라스 프로스트위스퍼‡El exánime, Ras Murmuhielo‡El exánime, Ras Murmuhielo‡La liche Ras Murmegivre‡巫妖莱斯·霜语‡巫妖萊斯‧霜語',
    nil,
    'Aniquile Ras Friomúrmuro.‡Уничтожьте Раса Ледяного Шепота.‡Vernichtet Ras Frostraunen.‡라스 프로스트위스퍼를 처치해야 합니다.‡Destruye a Ras Murmuhielo.‡Destruye a Ras Murmuhielo.‡Triomphez de Ras Murmegivre.‡消灭莱斯·霜语。‡消滅萊斯‧霜語。',
  }
},
[27143] = {
  {
    'A fortuna da família Barov‡Сокровище Баровых‡Das Familienvermögen der Barovs‡바로브 가의 유산‡La fortuna de la familia Barov‡La fortuna de la familia Barov‡La fortune de la famille Barov‡巴罗夫家族的宝藏‡巴羅夫家族的寶藏',
    nil,
    'Recupere a Escritura de Castro das Flechas, a Escritura de Montalvo, a escritura da Serraria Tarren e a escritura de Costa Sul.‡Добудьте документы на Каэр Дэрроу, Брилл, мельницу Таррен и Южнобережье.‡Findet die Besitzurkunde für Darrowehr, die Besitzurkunde für Brill, die Besitzurkunde für Tarrens Mühle und die Besitzurkunde für Süderstade.‡카엘 다로우 증서, 브릴 증서, 타렌 제분소 증서, 남녘해안 증서를 획득해야 합니다.‡Recupera las escrituras de Castel Darrow, de Rémol, del molino Tarren, y de Costasur.‡Recupera las escrituras de Castel Darrow, de Rémol, del molino Tarren, y de Costasur.‡Récupérez le Titre de propriété de Caer Darrow, le Titre de propriété de Brill, le Titre de propriété du Moulin de Tarren, et le Titre de propriété d\'Austrivage.‡取回凯尔达隆地契、布瑞尔地契、塔伦米尔地契，以及南海镇地契。‡取回凱爾達隆地契、布瑞爾地契、塔倫米爾地契和南海鎮地契。',
  }
},
[27144] = {
  {
    'O ajuste de contas‡Расплата‡Die Abrechnung‡심판‡La venganza‡La venganza‡L’évaluation finale‡清算‡清算',
    nil,
    'Fique ao lado da Grande Dama Sylvana Correventos enquanto ela fala com Koltirus Tecemorte.‡Поприсутствуйте при разговоре леди Сильваны Ветрокрылой с Кольтирой Ткачом Смерти.‡Wartet, bis Fürstin Sylvanas Windläufer mit Koltira Todesweber gesprochen hat.‡콜티라 데스위버와 대화하는 여군주 실바나스 윈드러너의 옆에 서 있어야 합니다.‡Mantente al margen mientras Lady Sylvanas Brisaveloz habla con Koltira Tejemuerte.‡Mantente al margen mientras Lady Sylvanas Brisaveloz habla con Koltira Tejemuerte.‡Assistez à la discussion entre Dame Sylvanas Coursevent et Koltira Tissemort.‡在希尔瓦娜斯·风行者同库尔迪拉·织亡者交谈时待命。‡當希瓦娜斯·風行者女士和寇爾提拉·亡織者談話時在一旁待命。',
  }
},
[27145] = {
  {
    'Filhotes pestilentos... por pouco tempo‡Зачумленные детеныши драконов‡Verseuchte Jungtiere ... im Moment‡지금은 역병 걸린 작은 새끼용일 뿐이지만...‡Crías de dragón apestadas... por ahora‡Crías de dragón apestadas... por ahora‡De jeunes pestiférés… pour l\'instant‡瘟疫之龙‡染疫幼龍...到此為止',
    nil,
    'Mate 10 Filhotes Pestilentos e Ossorrange.‡Убейте Громоклина и 10 зачумленных детенышей драконов.‡Tötet 10 verseuchte Jungtiere und Blutrippe.‡역병 걸린 작은 새끼용 10마리와 들창엄니를 처치해야 합니다.‡Mata a 10 crías apestadas y a Traquesangre.‡Mata a 10 crías apestadas y a Traquesangre.‡Tuez 10 Jeunes pestiférés et Cliquettripes.‡杀死血骨傀儡和10只天灾龙崽。‡殺死10隻染疫幼龍和血骨傀儡。',
  }
},
[27146] = {
  {
    'Doutor Theolen Krastinov, o Carniceiro‡Доктор Теолен Крастинов по прозвищу Мясник‡Doktor Theolen Krastinov, der Schlächter‡도살자, 테올렌 크라스티노브‡Doctor Theolen Krastinov, el Carnicero‡Doctor Theolen Krastinov, el Carnicero‡Docteur Theolen Krastinov, le Boucher‡瑟尔林·卡斯迪诺夫教授‡『屠夫』瑟爾林·卡斯迪諾夫教授',
    nil,
    'Aniquile o Doutor Theolen Krastinov e depois queime os Restos Mortais de Eva Sarkhoff e os Restos Mortais de Lucien Sarkhoff.‡Уничтожьте доктора Теолена Крастинова, затем сожгите останки Евы и Люсьена Саркоффов.‡Vernichtet Doktor Theolen Krastinov, und verbrennt die Überreste von Eva Sarkhoff und die Überreste von Lucien Sarkhoff.‡학자 테올렌 크라스티노브를 찾아 처치한 후, 에바 사크호프의 유해와 루시앙 사크호프의 유해를 불태워야 합니다.‡Destruye al doctor Theolen Krastinov, luego quema los restos de Eva y Lucien Sarkhoff.‡Destruye al doctor Theolen Krastinov, luego quema los restos de Eva y Lucien Sarkhoff.‡Tuez le docteur Theolen Krastinov, puis brûlez les Cadavres d\'Eva Sarkhoff et de Lucien Sarkhoff.‡消灭瑟尔林·卡斯迪诺夫教授，并烧毁艾瓦·萨克霍夫和卢森·萨克霍夫的遗体。‡摧毀瑟爾林•卡斯迪諾夫教授，然後燒毀伊娃•薩克霍夫和盧希恩•薩克霍夫的遺骸。',
  }
},
[27147] = {
  {
    'Kirtonos, o Arauto‡Киртонос Глашатай‡Kirtonos der Herold‡사자 키르토노스‡Kirtonos el Heraldo‡Kirtonos el Heraldo‡Kirtonos le Héraut‡传令官基尔图诺斯‡傳令官基爾圖諾斯',
    nil,
    'Aniquile Kirtonos.‡Уничтожьте Киртоноса.‡Zerstört Kirtonos.‡키르토노스를 처치해야 합니다.‡Destruye a Kirtonos.‡Destruye a Kirtonos.‡Détruisez Kirtonos.‡杀死基尔图诺斯。‡消滅基爾圖諾斯。',
  }
},
[27148] = {
  {
    'Férias prolongadas‡Ректор Некроситета‡Ewige Sommerferien‡영원한 폐교‡La escuela está cerrada para siempre‡La escuela está cerrada para siempre‡Mais oui, mais oui…. L\'école est finie !‡永久休课‡無限期休學',
    nil,
    'Mate o Umbromestre Gandling.‡Уничтожьте темного магистра Гандлинга.‡Tötet Dunkelmeister Gandling.‡암흑스승 간들링을 처치해야 합니다.‡Mata al maestro oscuro Gandling.‡Mata al maestro oscuro Gandling.‡Tuez le Sombre maître Gandling‡杀死黑暗院长加丁。‡殺死黑暗院長加丁。',
  }
},
[27149] = {
  {
    'Escola dos malditos‡Школа проклятых‡Schule der Verdammten‡저주받은 자의 학교‡La escuela de los condenados‡La escuela de los condenados‡L\'école des damnés‡诅咒学院‡詛咒學院',
    nil,
    'Fale com Weldon Barov em Scolomântia.‡Поговорите с Вэлдоном Баровым в Некроситете.‡Sprecht mit Weldon Barov in Scholomance.‡스칼로맨스에 있는 웰던 바로브와 대화해야 합니다.‡Habla con Walden Barov en Scholomance.‡Habla con Walden Barov en Scholomance.‡Allez voir Walden Barov, à la Scholomance.‡与通灵学院里的维尔顿·巴罗夫交谈。‡在通靈學院內和維爾頓·巴羅夫談談。',
  }
},
[27150] = {
  {
    'O Acampamento dos Restauradores‡Участок Целителей Земли‡Die Stätte der Heiler‡치유사의 처소‡La Finca de los Ensalmadores‡La Finca de los Ensalmadores‡Le bivouac des Soigneurs‡治愈者营地‡治癒者崗哨',
    nil,
    'Apresente-se ao Agente de Campo Kaartish no Acampamento dos Restauradores, que fica nas Terras Pestilentas Ocidentais.‡Сообщите о своем прибытии агенту ШРУ Каартишу на Участке Целителей Земли в Западных Чумных землях.‡Meldet Euch bei Außenagent Kaartish in der Stätte der Heiler in den Westlichen Pestländern.‡서부 역병지대의 치유사의 처소에 있는 현장 요원 카티쉬에게 보고해야 합니다.‡Preséntate ante el agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Preséntate ante el agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Présentez-vous à l\'Agent de terrain Kaartish au Bivouac des Soigneurs, dans les Maleterres de l\'Ouest.‡向西瘟疫之地治愈者营地的战地特工卡尔缇舍报告。‡到西瘟疫之地的治癒者崗哨向戰場密探卡爾堤須回報。',
  }
},
[27151] = {
  {
    'O legado de Taelan Fordring‡Наследство Телана Фордринга‡Taelan Fordrings Vermächtnis‡탤런 폴드링의 유물‡El legado de Taelan Vadín‡El legado de Taelan Vadín‡La chair et le sang de Taelan Fordring‡泰兰·弗丁的遗产‡泰蘭·弗丁的遺產',
    nil,
    'Mate 10 Gatunos Pinhorrubro.‡Убейте 10 мародеров из племени Красной Сосны.‡Tötet 10 Plünderer der Rotkiefer.‡붉은소나무 노략꾼 10마리를 처치해야 합니다.‡Mata a 10 despojadores Pinorrojo.‡Mata a 10 despojadores Pinorrojo.‡Tuez 10 Pillards rougepins.‡杀死10头赤松强夺者。‡殺死10個紅松強奪者。',
  }
},
[27152] = {
  {
    'Comportamento incomum... mesmo para gnolls‡Необычное поведение... Даже для гноллов‡Ungewöhnliches Verhalten ... selbst für Gnolle‡놀들의 비정상적인 행동‡Un comportamiento extraño... Incluso para los gnolls‡Un comportamiento extraño... Incluso para los gnolls‡Un comportement insolite… même pour des gnolls‡行为反常……即便是豺狼人‡怪異的舉動...即便是豺狼人',
    nil,
    'Investigue o esconderijo de gnolls ao lado da trilha para Amparo, nas Terras Pestilentas Ocidentais.‡Исследуйте укрытие гноллов возле пути на Дольный Очаг в западных Чумных землях.‡Erkundet das Versteck der Gnolle entlang des Wegs nach Herdweiler in den Westlichen Pestländern.‡서부 역병지대에서 하스글렌을 따라 이어지는 길에 있는 놀들의 은신처를 조사해야 합니다.‡Investiga la guarida gnoll en la senda que lleva a la Vega del Amparo en las Tierras de la Peste del Oeste.‡Investiga la guarida gnoll en la senda que lleva a la Vega del Amparo en las Tierras de la Peste del Oeste.‡Explorez la cachette des gnolls le long de la piste d’Âtreval, dans les Maleterres de l’Ouest.‡沿着西瘟疫之地途径壁炉谷的小路调查豺狼人藏身地。‡到西瘟疫之地沿著通往壁爐谷的小徑，調查豺狼人藏身處。',
  }
},
[27153] = {
  {
    'O bom povo de Amparo‡Цвет Дольного Очага‡Die braven Bürger von Herdweiler‡하스글렌의 선량한 주민들‡La buena gente de la Vega del Amparo‡La buena gente de la Vega del Amparo‡Les bonnes gens d\'Âtreval‡壁炉谷的好人‡壁爐谷的好人',
    nil,
    'Fale com Morris Vant, Provedor Mendelev, Bia Raçaférrea e Alto-clérigo Álphus dentro de Amparo.‡Поговорите с Моррисом Вантом, галантерейщиком Менделевым, Бри Железняк и верховным священником Альфусом в Дольном Очаге.‡Sprecht mit Morris Vant, Ausstatter Mendelev, Bree Eisenstock und dem Hohen Kleriker Alphus in Herdweiler.‡하스글렌 내에 있는 모리스 반트, 재단사 멘델레프, 브리 아이언스톡, 그리고 고위 성직자 알푸스와 대화해야 합니다.‡Habla con Morris Vant, con el proveedor Mendelev, con Bree Cargacero y con el Sumo clérigo Alphus en la Vega del Amparo.‡Habla con Morris Vant, con el proveedor Mendelev, con Bree Cargacero y con el Sumo clérigo Alphus en la Vega del Amparo.‡Parlez à Morris Vant, à Mendelev le Tailleur, à Bree Troupefer et au Grand clerc Alphus à Âtreval.‡同壁炉谷的莫里斯·凡特、物资官门德勒夫、布雷·铁枷和高阶牧师阿尔法斯交谈。‡到壁爐谷內找莫里斯·馮特、物資官門德列夫、布里·鐵樁和高階牧師阿爾佛斯說話。',
  }
},
[27154] = {
  {
    'Encurralando Bisp‡Разборка с Биспом‡Bisp festsetzen‡학자 비스프 처치‡Cazar a Bisp‡Cazar a Bisp‡Coffrer Bisp‡追捕毕斯普‡逮捕畢斯普',
    nil,
    'Fale com Magus Bisp no alto da torre dos magos, em Amparo.‡Поговорите с волхвом Биспом на вершине башни магов в Дольном Очаге.‡Sprecht mit Magier Bisp im oberen Teil des Magierturms in Herdweiler.‡하스글렌의 마법사 탑에 있는 학자 비스프와 대화해야 합니다.‡Habla con el Magus Bisp en lo alto de la Torre de los Magos en la Vega del Amparo.‡Habla con el Magus Bisp en lo alto de la Torre de los Magos en la Vega del Amparo.‡Parlez au Magus Bisp au sommet de la tour des mages, à Âtreval.‡同壁炉谷法师塔顶的魔导师毕斯普交谈。‡到壁爐谷的法師塔頂端找魔導師畢斯普說話。',
  }
},
[27155] = {
  {
    'Se entregando‡Явка с повинной‡Sich stellen‡자수‡Entrégate‡Entrégate‡Faute avouée…‡自首吧‡自首',
    nil,
    'Apresente-se ao Grão-lorde Tirion Fordring em Amparo, que fica nas Terras Pestilentas Ocidentais.‡Отправляйтесь к верховному лорду Тириону Фордрингу в Дольный Очаг в Западных Чумных землях.‡Meldet Euch bei Hochlord Tirion Fordring in Herdweiler in den Westlichen Pestländern.‡서부 역병지대의 하스글렌에 있는 대영주 티리온 폴드링에게 보고해야 합니다.‡Preséntate ante el alto señor Tirion Vadín en la Vega del Amparo en las Tierras de la Peste del Oeste.‡Preséntate ante el alto señor Tirion Vadín en la Vega del Amparo en las Tierras de la Peste del Oeste.‡Livrez-vous au Généralissime Tirion Fordring à Âtreval, dans les Maleterres de l’Ouest.‡向西瘟疫之地壁炉谷的大领主提里奥·弗丁报告。‡到西瘟疫之地的壁爐谷向大領主提里奧·弗丁回報。',
  }
},
[27156] = {
  {
    'Já era hora!‡Самое время!‡Es wird langsam Zeit!‡이제야 오셨군‡¡Ya era hora!‡¡Ya era hora!‡C\'est pas trop tôt !‡是时候了！‡時候到了!',
    nil,
    'Desafie e derrote 7 Aprendizes de Amparo.‡Бросьте вызов 7 рекрутами Дольного Очага и победите их.‡Fordert 7 Lehrlinge von Herdweiler zum Kampf heraus und besiegt sie.‡하스글렌 훈련병 7명에게 도전해 승리해야 합니다.‡Desafía y derrota a 7 practicantes de la Vega del Amparo.‡Desafía y derrota a 7 practicantes de la Vega del Amparo.‡Défiez et combattez 7 Jeunes recrues d’Âtreval.‡挑战并击败7名壁炉谷新兵。‡挑戰並擊敗7名壁爐谷受訓員。',
  }
},
[27157] = {
  {
    'Peões... <suspiro>‡Помеха рудокопам‡Akkordarbeiter... <Seufz>‡노역꾼들...‡Mis braceros...‡Mis braceros...‡Les forçats… Pffff…‡苦工啊……<叹气>‡苦工...<嘆氣>',
    nil,
    'Mate Shadril dentro da mina de Amparo.‡Убейте Шадрил в руднике в Дольном Очаге.‡Tötet Shadril in der Mine in Herdweiler.‡하스글렌의 광산 안에 있는 샤드릴을 처치해야 합니다.‡Mata a Shadril en el interior de la mina que hay en la Vega del Amparo.‡Mata a Shadril en el interior de la mina que hay en la Vega del Amparo.‡Tuez Shadril dans la mine, à Âtreval.‡杀死壁炉谷内矿洞里的沙德利。‡到壁爐谷的礦坑內殺死薛德瑞爾。',
  }
},
[27158] = {
  {
    'A batalha por Andorhal‡Битва за Андорал‡Die Schlacht um Andorhal‡안돌할 전투‡La batalla por Andorhal‡La batalla por Andorhal‡La bataille pour Andorhal‡安多哈尔战争‡安多哈爾之戰',
    nil,
    'Apresente-se a Thassarian em Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Отчитайтесь перед Тассарианом в Андорале в Западных Чумных землях.‡Meldet Euch bei Thassarian in Andorhal in den Westlichen Pestländern.‡서부 역병지대의 안돌할에 있는 타사리안에게 보고해야 합니다.‡Preséntate ante Thassarian en el interior de Andorhal, en las Tierras de la Peste del Oeste.‡Preséntate ante Thassarian en el interior de Andorhal, en las Tierras de la Peste del Oeste.‡Présentez-vous à Thassarian à Andorhal, dans les Maleterres de l’Ouest.‡向西瘟疫之地安多哈尔城的萨萨里安报告。‡到西瘟疫之地的安多哈爾向薩沙理安報到。',
  }
},
[27159] = {
  {
    'O Flagelo primeiro... Depois a Horda‡Сначала Плеть... Потом Орда‡Erst die Geißel ... dann die Horde‡호드보다는 스컬지를‡La Plaga primero... La Horda después‡La Plaga primero... La Horda después‡Le Fléau d\'abord… la Horde ensuite‡先是天灾……再是部落‡先天譴...後部落',
    nil,
    'Mate 15 Flagelos Ressequidos dentro de Andorhal.‡Уничтожьте 15 иссохших воинов Плети в Андорале.‡Tötet 15 ausgedörrte Geißeldiener in Andorhal.‡안돌할 안에 있는 뼈만 남은 스컬지 15명을 처치해야 합니다.‡Asesina a 15 miembros de la Plaga disecados en el interior de Andorhal.‡Asesina a 15 miembros de la Plaga disecados en el interior de Andorhal.‡Tuez 15 Fléaux desséchés dans Andorhal.‡杀死安多哈尔城里的15名枯骨天灾战士。‡在安多哈爾內殺死15名乾枯的天譴士兵。',
  }
},
[27160] = {
  {
    'Máquinas de guerra‡Боевые машины‡Kriegsmaschinen‡전쟁 기계‡Máquinas de guerra‡Máquinas de guerra‡Machines de guerre‡战争机器‡戰爭機器',
    nil,
    'Destrua 6 Beemotes Tripaberta em Andorhal.‡Уничтожьте 6 пустобрюхих громадин в Андорале.‡Zerstört 6 aufgeschlitzte Ungetüme in Andorhal.‡안돌할에서 뚫린배 거수 6마리를 처치해야 합니다.‡Acaba con 6 behemoths Panzabierta en Andorhal.‡Acaba con 6 behemoths Panzabierta en Andorhal.‡Tuez 6 Béhémots tranchegorge à Andorhal.‡摧毁安多哈尔的6具缝腹巨怪。‡在安多哈爾摧毀6名開腸破肚的憎惡巨獸。',
  }
},
[27161] = {
  {
    'O fluxo interminável‡Бесконечный поток‡Der unendliche Fluss‡끝없는 흐름‡El flujo incesante‡El flujo incesante‡Squelettes à la chaîne‡源源不绝的兵力‡無限之流',
    nil,
    'Use as Granadas de Mão do Lango para matar 5 Berserkers Espetosso e destruir um Animus dos Ossos do Flagelo.‡Подорвите 5 костяных берсерков и уничтожьте костяного стража Плети ручными гранатами Ланга.‡Benutzt Langs Handgranaten und tötet 5 Berserker der Klapperknochen und zerstört einen Knochenanimus der Geißel.‡랭의 수류탄을 사용해 해골 광전사 5명과 스컬지 뼈 원혼을 처치해야 합니다.‡Usa las granadas de mano de Lang para matar a 5 rabiosos Pegahueso y para destruir un animus de hueso de la Plaga.‡Usa las granadas de mano de Lang para matar a 5 rabiosos Pegahueso y para destruir un animus de hueso de la Plaga.‡Utilisez les Grenades de Lang pour tuer 5 Berserkers pique-os et détruire un Animus osseux du Fléau.‡用朗格的手榴弹消灭5具拾骨狂战士，摧毁天灾骨堆法阵。‡用蘭格的手榴彈殺死5名棒骨狂戰士來摧毀天譴骸骨意念。',
  }
},
[27162] = {
  {
    'Scolomantiano‡Некроректор‡Scholomancer‡스칼로맨스의 지도자‡El habitante de Scholomance‡El habitante de Scholomance‡Le scholomancien‡通灵学院‡通靈學院人',
    nil,
    'Mate o Umbromestre Gandling em Andorhal.‡Убейте в Андорале темного магистра Гандлинга.‡Tötet Dunkelmeister Gandling in Andorhal.‡안돌할에 있는 암흑스승 간들링을 처치해야 합니다.‡Mata al maestro oscuro Gandling en el interior de Andorhal.‡Mata al maestro oscuro Gandling en el interior de Andorhal.‡Tuez le Sombre Maître Gandling dans Andorhal.‡杀死安多哈尔城内的黑暗院长加丁。‡在安多哈爾裡面殺死黑暗院長加丁。',
  }
},
[27163] = {
  {
    'Força bruta‡Грубая сила‡Rohe Gewalt‡강대한 들창엄니‡Fuerza bruta‡Fuerza bruta‡Force brute‡蛮力‡蠻力',
    nil,
    'Mate o Ossorrange em Andorhal.‡Убейте Громоклина в Андорале.‡Tötet Blutrippe in Andorhal.‡안돌할에 있는 들창엄니를 처치해야 합니다.‡Mata a Traquesangre en el interior de Andorhal.‡Mata a Traquesangre en el interior de Andorhal.‡Tuez Cliquetripes à Andorhal.‡杀死安多哈尔城内的血骨傀儡。‡殺死安多哈爾裡的血骨傀儡。',
  }
},
[27164] = {
  {
    'Araj, o Evocador‡Араж Призыватель‡Araj der Beschwörer‡소환사 아라즈‡Araj el Invocador‡Araj el Invocador‡Araj l’invocateur‡召唤者阿拉基‡『召喚者』阿拉基',
    nil,
    'Mate Araj, o Evocador. Você pode usar as Granadas de Mão do Lango para destruir os Berserkers Espetosso.‡Убейте Аража Призывателя. С костяными берсерками справляйтесь с помощью ручных гранат Ланга.‡Tötet Araj den Beschwörer. Ihr könnt Langs Handgranaten benutzen, um die Berserker der Klapperknochen zu zerstören.‡소환사 아라즈를 처치해야 합니다. 랭의 수류탄을 사용하면 소환된 해골 광전사를 처치할 수 있습니다.‡Mata a Araj el Invocador. Puedes usar las granadas de mano de Lang para acabar con rabiosos Pegahueso.‡Mata a Araj el Invocador. Puedes usar las granadas de mano de Lang para acabar con rabiosos Pegahueso.‡Tuez Araj l’Invocateur. Vous pouvez utiliser les Grenades de Lang pour détruire les Berserkers pique-os.‡杀掉召唤者阿拉基。你可以用朗格的手榴弹消灭拾骨狂战士。‡殺死『召喚者』阿拉基。你可以用蘭格的手榴彈摧毀棒骨狂戰士。',
  }
},
[27165] = {
  {
    'Vitória, por enquanto.‡Сиюминутная победа‡Sieg, im Moment‡짧은 승리감‡Victoria, por ahora‡Victoria, por ahora‡La victoire pour un temps‡暂时的胜利‡暫時的勝利',
    nil,
    'Apresente-se ao Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Доберитесь до командира Ашлама Неутомимого в лагере Промозглого Ветра в Западных Чумных землях.‡Meldet Euch bei Kommandant Ashlam Ehrenschlag in Zugwindlager in den Westlichen Pestländern.‡서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 보고해야 합니다.‡Preséntate ante el comandante Ashlam Puñovalor en el Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Preséntate ante el comandante Ashlam Puñovalor en el Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Présentez-vous à Ashlam Vaillepoing au Camp du Noroît, dans les Maleterres de l’Ouest.‡向西瘟疫之地寒风营地的指挥官阿什拉姆·瓦罗菲斯特报告。‡到西瘟疫之地的冰風營地向指揮官阿胥拉姆•瓦羅菲斯特回報。',
  }
},
[27166] = {
  {
    'Vá flechar!‡Перышки!‡Pfeile machen!‡깃털 수집‡¡A por las plumas!‡¡A por las plumas!‡Fléchiers !‡捡羽毛！‡裝上羽毛!',
    nil,
    'Obtenha 9 Cálamos de Penaparda‡Раздобудьте 9 перьев бурокрылого ястреба.‡Erhaltet 9 Braunfederkiele.‡갈색깃털 꽁지깃 9개를 모아야 합니다.‡Consigue 9 plumas de Plumaparda.‡Consigue 9 plumas de Plumaparda.‡Obtenez 9 Plumes de plumebrune.‡收集9根棕色尾羽。‡取得9根褐羽羽刺。',
  }
},
[27167] = {
  {
    'Uma fome violenta‡Угроза голодной смерти‡Magenknurren‡극심한 굶주림‡Un apetito poderoso‡Un apetito poderoso‡Une faim atroce‡大饥荒‡巨大的飢餓',
    nil,
    'Obtenha 5 Picanhas de Urso de Ursos Pretos Desgrenhados nas Terras Pestilentas Ocidentais.‡Раздобудьте 5 кусков мяса косматых черных медведей в Западных Чумных землях.‡Beschafft Euch 5 Stücke Bärenfleisch von struppigen Schwarzbären in den Westlichen Pestländern.‡서부 역병지대에 있는 털북숭이 검은곰을 처치해 곰 고기 옆구리살 5개를 획득해야 합니다.‡Consigue 5 costales de carne de oso de osos negros peludos en las Tierras de la Peste del Oeste.‡Consigue 5 costales de carne de oso de osos negros peludos en las Tierras de la Peste del Oeste.‡Prélevez 5 Gigues d’ours sur des Ours noir hirsutes des Maleterres de l’Ouest.‡从西瘟疫之地的蓬毛黑熊身上割下5块熊肉。‡到西瘟疫之地從長毛黑熊身上取得5塊熊肉。',
  }
},
[27168] = {
  {
    'Aqueles que não puderam partir‡Неприкаянные‡Wer nicht loslassen kann‡떠나지 못하는 자들‡Los que siguen aferrándose a este mundo‡Los que siguen aferrándose a este mundo‡Ceux qui s’éternisent‡无法释怀的鬼魂‡放不了手',
    nil,
    'Use o Turíbulo Sagrado em 12 Almas Recolhidas na Colina do Pesar. Mate-as se elas reagirem de forma negativa.‡Окурите с помощью священного кадила 12 неприкаянных духов на Холме Печали. Тех, кто воспротивится, уничтожьте.‡Benutzt das Heilige Weihrauchfass bei 12 zurückgezogenen Geistern in Trauerhügel, und tötet sie, falls ihre Reaktion dies verlangt.‡슬픔의 언덕에 있는 홀로 떠도는 영혼 12명에게 신성한 훈로를 사용해야 합니다. 영혼이 부정적으로 반응하면 처치하십시오.‡Usa el tríbulo sagrado en 12 espíritus abandonados en la Colina de las Penas, y mátalos si reaccionan negativamente.‡Usa el tríbulo sagrado en 12 espíritus abandonados en la Colina de las Penas, y mátalos si reaccionan negativamente.‡Utilisez l’Encensoir sacré sur 12 Âmes recluses à la Colline des Chagrins, et tuez-les si elles deviennent hostiles.‡对悔恨岭上的12个沉默的灵魂使用神圣焚香，要是有什么异常就消灭他们。‡到悔恨嶺對12個沉默的靈魂使用神聖香爐，要是對方不合作就殺死他們。',
  }
},
[27169] = {
  {
    'A bênção de Uther‡Благословение Утера‡Uthers Segen‡우서 경의 축복‡La bendición de Uther‡La bendición de Uther‡La bénédiction d’Uther‡乌瑟尔的祝福‡烏瑟的祝福',
    nil,
    'Entre na Tumba de Uther e use a Homenagem de Ventogelante em frente à estátua dele.‡Войдите в гробницу Утера и положите подношения лагеря Промозглого Ветра у его статуи.‡Begebt Euch zu Uthers Grabmal und verwendet den Eiswindtribut vor seiner Statue.‡우서 경의 무덤으로 들어간 뒤 그의 동상 앞에 서리바람 공물을 사용해야 합니다.‡Entra en la tumba de Uther y coloca el tributo a Orvallo ante su estatua.‡Entra en la tumba de Uther y coloca el tributo a Orvallo ante su estatua.‡Entrez dans le Tombeau d’Uther et utilisez l’Offrande du Noroît aux pieds de sa statue.‡进入乌瑟尔之墓，在他的塑像前使用寒风贡品。‡進入烏瑟之墓，在雕像前使用冰風貢品。',
  }
},
[27170] = {
  {
    'A cripta abandonada‡Покинутая крипта‡Die verlassene Gruft‡버려진 납골당‡La cripta abandonada‡La cripta abandonada‡La crypte abandonnée‡被遗弃的墓穴‡被遺棄的墓穴',
    nil,
    'Encontre o Caixote de Armas no último andar da Cripta da Colina do Pesar, que fica nas Terras Pestilentas Ocidentais.‡Найдите ящик с оружием на нижнем уровне крипты в Западных Чумных землях.‡Findet die Waffenkiste unten in der Gruft in den Westlichen Pestländern.‡서부 역병지대에 있는 납골당 최하층에서 부서진 무기 상자를 찾아야 합니다.‡Encuentra el cajón de armas en el fondo de la cripta en las Tierras de la Peste del Oeste.‡Encuentra el cajón de armas en el fondo de la cripta en las Tierras de la Peste del Oeste.‡Trouvez la Caisse d’armes cassée au fond de la Crypte, dans les Maleterres de l’Ouest.‡在西瘟疫之地的墓穴深处找到武器箱。‡到西瘟疫之地的墓穴底層尋找武器箱。',
  }
},
[27171] = {
  {
    'Emboscado!‡Засада!‡Hinterhalt!‡매복이다!‡¡Una emboscada!‡¡Una emboscada!‡Tombé dans une embuscade !‡有埋伏！‡有埋伏!',
    nil,
    'Pegue 4 Peitorais Gastos pelo Tempo e 4 Espadas Enferrujadas.‡Добудьте 4 износившихся кирасы и 4 ржавых меча.‡Erhaltet 4 abgenutzte Brustplatten und 4 verrostete Schwerter.‡세월에 낡은 가슴보호갑 4개와 녹슨 검 4자루를 획득해야 합니다.‡Consigue 4 corazas desgastadas y 4 espadas oxidadas.‡Consigue 4 corazas desgastadas y 4 espadas oxidadas.‡Récupérez 4 Cuirasses éculées et 4 Épées rouillées.‡获取4件陈旧的胸甲和4把生锈的长剑。‡取得4件陳舊的胸甲和4把生鏽的劍。',
  }
},
[27172] = {
  {
    'O Antro Repelente‡Удел Страданий‡Das Trostlose Feld‡고통의 흉가‡El Tormento‡El Tormento‡Le repaire Putride‡嚎哭鬼屋‡苦痛鬼屋',
    nil,
    'Leve as Armas e Armaduras Desgastadas para Anton DeGrandis no Antro Repelente, que fica nas Terras Pestilentas Ocidentais.‡Доставьте изношенное оружие и доспехи Турману Гранту в Удел Страданий в Западных Чумных землях.‡Bringt die ramponierten Waffen und Rüstungen zu Thurman Grant zum Trostlosen Feld in den Westlichen Pestländern.‡서부 역병지대의 고통의 흉가에 있는 투르만 그랜트에게 닳아해진 무기와 방어구를 가져가야 합니다.‡Lleva las armas y armadura maltrechas a Thurman Grant en El Tormento en las Tierras de la Pestes del Oeste.‡Lleva las armas y armadura maltrechas a Thurman Grant en El Tormento en las Tierras de la Pestes del Oeste.‡Apportez les Armes et armures endommagées à Thurman Grant au Repaire Putride, dans les maleterres de l’Ouest.‡将破旧的武器和盔甲带给西瘟疫之地嚎哭鬼屋的瑟尔曼·格兰特。‡將破碎的武器和護甲帶去西瘟疫之地的苦痛鬼屋，給薩爾曼·格蘭特。',
  }
},
[27173] = {
  {
    'Este é o nosso exército‡Это наша армия‡Dies ist unsere Armee‡이것이 우리 군대다‡Este es nuestro ejército‡Este es nuestro ejército‡Agriculteurs en colère‡这就是我们的军队‡這就是我們的軍隊',
    nil,
    'Mate 10 Pioneiros Renegados.‡Уничтожьте 10 всадников-Отрекшихся.‡Tötet 10 Streitkräfte der Vorhut der Verlassenen.‡포세이큰 수색병 10명을 처치해야 합니다.‡Mata a 10 escoltas Renegados.‡Mata a 10 escoltas Renegados.‡Tuez 10 Voltigeurs réprouvés.‡消灭10名被遗忘者前锋。‡殺死10個亡靈先遣軍。',
  }
},
[27174] = {
  {
    'Treino de combate‡Боевые учения‡Kampftraining‡전투 훈련‡Entrenamiento de combate‡Instrucción de combate‡L’entraînement au combat‡战斗训练‡戰鬥訓練',
    nil,
    'Fale com o Gangrena no Antro Repelente e o desafie para um combate.‡Поговорите с Жутким Рылом в Уделе Страданий и заставьте его драться.‡Sprecht mit Gory im Trostlosen Feld und fordert ihn zum Kampf heraus.‡고통의 흉가에 있는 몸서리와 대화한 후 그에게 도전해야 합니다.‡Habla con Gory en El Tormento y desafíalo a un combate.‡Habla con Gory en El Tormento y desafíalo a un combate.‡Parlez à Gory au Repaire Putride, et défiez-le en combat.‡同嚎哭鬼屋的血肚交谈，向他挑战。‡到苦痛鬼屋找勾里說話，向他提出挑戰。',
  }
},
[27175] = {
  {
    'Acampamento dos Restauradores‡Участок Целителей Земли‡Die Stätte der Heiler‡치유사의 처소‡La Finca de los Ensalmadores‡La Finca de los Ensalmadores‡Le bivouac des Soigneurs‡治愈者营地‡治癒者崗哨',
    nil,
    'Apresente-se ao Agente de Campo Kaartish no Acampamento dos Restauradores, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с агентом ШРУ Каартишем на Участке Целителей Земли в Чумных землях.‡Meldet Euch bei Außenagent Kaartish in der Stätte der Heiler in den Westlichen Pestländern.‡서부 역병지대의 치유사의 처소에 있는 현장 요원 카티쉬에게 보고해야 합니다.‡Preséntate ante el agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Preséntate ante el agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Présentez-vous à l’Agent de terrain Kaartish au Bivouac des Soigneurs, dans les Maleterres de l’Ouest.‡向西瘟疫之地治愈者营地的战地特工卡尔缇舍报告。‡到西瘟疫之地的治癒者崗哨向戰場密探卡爾堤須回報。',
  }
},
[27176] = {
  {
    'Um disco estranho‡Странный диск‡Eine seltsame Scheibe‡수상한 원반‡Un disco extraño‡Un disco extraño‡Un étrange disque‡奇怪的圆盘‡奇怪的碟片',
    nil,
    'Obtenha o Cajado do Sultão e, então, use o Disco Sofisticado para criar o Cajado das Estrelas.‡Разыщите посох Султана и с помощью замысловатого диска превратите его в древко Звезд.‡Erhaltet den Stab des Sultans und benutzt die aufwendige Scheibe, um den Schaft der Sterne zu erstellen.‡술탄의 지팡이를 얻은 후, 정교한 원반을 결합하여 별 막대를 만들어야 합니다.‡Consigue el bastón de sultán, después usa el disco elaborado para crear el bastón de las estrellas.‡Consigue el bastón de sultán, después usa el disco elaborado para crear el bastón de las estrellas.‡Trouvez le Bâton du sultan, puis utilisez le Disque élaboré pour créer la Hampe des étoiles.‡获得苏丹之杖，然后用精致的圆盘制作辰星之柄。‡取得蘇爾丹的法杖，然後用精巧的圓盤製作星之軸。',
  }
},
[27177] = {
  {
    'Operação de resgate‡Спасательная операция‡Bergungsaktion‡회수 임무‡Operación de rescate‡Operación de rescate‡Opération de récupération‡打捞行动‡打撈行動',
    nil,
    'Colete 8 Suprimentos Recuperados dos Caixotes Encharcados nas Quebradas Obsidianas.‡Найдите сохранившиеся припасы в Обсидиановых рифах. Достаньте 8 таких грузов из промокших ящиков.‡Bergt 8 wiedergefundene Vorräte aus den durchnässten Kisten in Obsidianbrecher.‡흑요석 파괴자에 있는 물에 젖은 상자에서 되찾은 보급품 8개를 회수해야 합니다.‡Recupera 8 suministros recuperados de cajones estropeados por el agua en la Rompiente Obsidiana.‡Recupera 8 suministros recuperados de cajones encharcados en la Rompiente Obsidiana.‡Rapportez 8 Provisions récupérées que vous trouverez dans les Caisses détrempées des Brisants d\'Obsidienne.‡前往黑曜石海滩，从浸水的箱子中找回8份补给品。‡從黑曜破碎的浸水木箱取回8件補給品。',
  }
},
[27178] = {
  {
    'Reforços naga‡Наги спешат на помощь‡Verstärkung der Naga‡나가 증원군‡Refuerzos nagas‡Refuerzos nagas‡Les renforts des nagas‡纳迦的支援‡納迦援軍',
    nil,
    'Mate 10 Mirmidões Escamanegra ou Arautos do Mar Escamanegra.‡Убейте 10 мирмидонов из клана Черной Чешуи или зовущих море из клана Черной Чешуи.‡Tötet 10 Myrmidone der Schwarzschuppen oder Seerufer der Schwarzschuppen.‡검은비늘 미르미돈이나 검은비늘 바다소환사 10마리를 처치해야 합니다.‡Mata a 10 mirmidones o clamamares Escama Negra.‡Mata a 10 mirmidones o clamamares Escama Negra.‡Tuez 10 Myrmidons écailles-noires ou Mande-mers écailles-noires.‡杀死10名黑鳞侍从或是黑鳞唤海者。‡殺死10名黑鱗部屬或是黑鱗喚海者。',
  }
},
[27179] = {
  {
    'Trabalho de campo‡Еще одна интересная находка‡Feldarbeit‡현장 조사‡Trabajo de campo‡Trabajo de campo‡Un travail de terrain‡实地作业‡實地調查',
    nil,
    'Colete 10 Fragmentos de Tabuleta Ancestral.‡Соберите 10 фрагментов древней таблички.‡Sammelt 10 uralte Tafelfragmente.‡고대 서판 조각 10개를 모아야 합니다.‡Recoge 10 trozos de tablilla antigua.‡Recoge 10 trozos de tablilla antigua.‡Récupérez 10 Fragments de tablette antique.‡找到10块远古石板碎片。‡在眾星方尖碑附近的區域收集10片上古石板碎片。',
  }
},
[27180] = {
  {
    'Em honra aos mortos‡Поминовение усопших‡Ehret die Toten‡망자의 명예‡Honra a los muertos‡Honra a los muertos‡L’hommage aux morts‡向死者致敬‡逝者的榮耀',
    nil,
    'Colete 6 Insígnias dos Renegados dos cadáveres dos Soldados Renegados Veteranos.‡Принесите 6 знаков различия Отрекшихся, снятых с тел ветеранов Отрекшихся.‡Findet 6 Insignien der Verlassenen bei den Leichnamen der Veteranengardisten der Verlassenen.‡정예 포세이큰 돌격병의 사체에서 포세이큰 휘장 6개를 회수해야 합니다.‡Recupera 6 insignias de Renegado de los cadáveres de los soldados de caballería Renegados veteranos.‡Recupera 6 insignias de Renegado de los cadáveres de los soldados de caballería Renegados veteranos.‡Récupérez 6 Insignes de Réprouvé sur les cadavres des Troupiers réprouvés vétérans.‡在被遗忘者老兵尸体上获取6个被遗忘者的徽记。‡從老練的被遺忘者裝甲兵的屍體上取回6枚被遺忘者徽記。',
  }
},
[27181] = {
  {
    'Limpando a mácula‡Снятие порчи‡Der Schmach ein Ende bereiten‡오염원 박멸‡Cortando por lo sano‡Cortando por lo sano‡Le devoir de vengeance‡洗刷污点‡進行感染',
    nil,
    'Mate 10 Espreitadores Dentessangue.‡Убейте 10 ловцов из стаи Кровавого Клыка.‡Tötet 10 Blutfangpirscher.‡붉은송곳니 추적자 10명을 처치해야 합니다.‡Mata a 10 acechadores Colmillo de Sangre.‡Mata a 10 acechadores Colmillo de Sangre.‡Tuez 10 Traqueurs crocs-de-sang.‡杀死10名血牙猎手。‡殺死10名血牙潛獵者。',
  }
},
[27182] = {
  {
    'O ermitão do Morro das Bruxas‡Отшельник с Ведьмина холма‡Der Einsiedler des Hexenhügels‡마녀 언덕의 은둔자‡El ermitaño de la Colina de las Brujas‡El ermitaño de la Colina de las Brujas‡L\'ermite de la Colline des sorcières‡女巫岭的隐士‡女巫嶺的隱士',
    nil,
    'Fale com Zé "Olho de Lama", no Casarão do Pantanal Iluminado.‡Поговорите с Ярлом "Болотным глазом" в сторожке "Болотный огонек".‡Sprecht mit "Sumpfauge" Jarl beim Irrlichtanwesen.‡늪지기 오두막에 있는 "늪지눈알" 자를과 대화해야 합니다.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Parlez à Jarl « Oeil-des-marais » au Manoir des Flammeroles.‡跟水光庄园的“沼泽之眼”加尔谈一谈。‡和水光莊園的『沼澤之眼』加爾談談。',
  }
},
[27183] = {
  {
    'Pernas de sapo do pântano‡Лягушачьи лапки‡Marschenfroschschenkel‡습지 개구리 다리‡Ancas de rana de marisma‡Ancas de rana de marisma‡Les cuisses de grenouille des marais‡沼泽蛙的腿‡沼澤青蛙腿',
    nil,
    'Colete 10 Pernas de Sapo do Pântano dos Sapos Gigantes do Pântano.‡Добудьте 10 лапок гигантских болотных лягушек.‡Sammelt 10 Marschenfroschschenkel von riesigen Marschenfröschen.‡거대한 습지 개구리로부터 습지 개구리 다리 10개를 모아야 합니다.‡Reúne 10 ancas de rana de marisma de ranas de marisma gigantes.‡Reúne 10 ancas de rana de marisma de ranas de marisma gigantes.‡Récupérez 10 Cuisses de Grenouilles géantes des marais.‡从大型沼泽蛙身上收集10条沼泽蛙的腿。‡從巨型沼澤蛙身上收集到10條沼澤青蛙腿。',
  }
},
[27184] = {
  {
    'Zé "olho em falta"‡Ярлу нужны глаза‡Jarl braucht Augen‡자를의 부탁‡Jarl necesita ojos‡Jarl necesita ojos‡Jarl a besoin d’yeux‡加尔和蜘蛛眼‡加爾需要蜘蛛眼',
    nil,
    'Colete 20 Olhos Névoa Negra Inteiros das aranhas Névoa Negra.‡Соберите 20 целых глаз паука Мглистой пещеры.‡Sammelt 20 unzerplatzte Graunebelaugen von Graunebelspinnen.‡암흑안개거미에게서 터지지 않은 암흑안개거미의 눈 20개를 모아야 합니다.‡Reúne 20 ojos de Niebla Negra sin reventar de arañas Niebla Negra.‡Reúne 20 ojos de Niebla Negra sin reventar de arañas Niebla Negra.‡Récupérez 20 Yeux de Sombrebrume entiers sur des Araignées de Sombrebrume.‡从黑雾蜘蛛身上收集20颗黑雾蜘蛛的眼球。‡從暗霧蜘蛛身上收集到20顆暗霧蜘蛛眼球。',
  }
},
[27185] = {
  {
    'Eliminando a concorrência‡Конкурентное преимущество‡Die Wettstreiter ausmerzen‡경쟁자 처치‡Sabotear la competencia‡Sabotear la competencia‡S\'attaquer à la concurrence‡破坏竞争‡中斷比賽',
    nil,
    'Mate o Marteleiro Reanimado.‡Убейте молотобойца Багрового Легиона.‡Tötet den purpurroten Hammerschmied.‡되살아난 대장장이를 처치해야 합니다.‡Mata al forjamartillos resucitado.‡Mata al forjamartillos resucitado.‡Tuez le Forgeur de marteaux ressuscité.‡杀死复生的铸锤师。‡殺死紅衣錘類鍛造師。',
  }
},
[27186] = {
  {
    'Zé precisa de uma lâmina‡Ярлу нужен клинок‡Jarl braucht eine Klinge‡자를의 검‡Jarl necesita una hoja‡Jarl necesita una hoja‡Jarl a besoin d\'une épée‡加尔的剑‡加爾需要一把劍',
    nil,
    'Obtenha a Espada de Cortaspinha.‡Добудьте меч Костяной Чешуи.‡Besorgt Messerwirbels Schwert‡서슬돌기의 검을 획득해야 합니다.‡Consigue una Espada de Espinafilada.‡Consigue una Espada de Espinafilada.‡Récupérez l’Épée de Tranchéchine.‡获得刺脊的剑。‡取得尖背之劍。',
  }
},
[27187] = {
  {
    'Faça um favor ao mundo‡Сделай миру одолжение‡Ein Gefallen für die Welt‡세상을 도와주는 방법‡Haz un favor al mundo‡Haz un favor al mundo‡Un service rendu au monde‡让世界更美好‡為世界盡點力',
    nil,
    'Mate 12 Hienas Sarnentas.‡Убейте 12 облезлых гиен.‡Tötet 12 räudige Hyänen.‡병든 하이에나 12마리를 처치해야 합니다.‡Mata a 12 hienas sarnosas.‡Mata a 12 hienas sarnosas.‡Tuez 12 Hyènes galeuses.‡杀死12头赖皮土狼。‡殺死12隻癩皮土狼。',
  }
},
[27188] = {
  {
    'Que é que assombra o Morro das Bruxas?‡Что таится на Ведьмином холме?‡Was sucht den Hexenhügel heim?‡마녀 언덕에 나타나는 존재는?‡¿Quién atormenta la Colina de las Brujas?‡¿Quién atormenta la Colina de las Brujas?‡Qui hante la Colline des sorcières ?‡女巫岭的幽灵‡是什麼在女巫嶺作祟?',
    nil,
    'Consiga informações derrotando 10 Carcaças Moventes ou Espíritos Revividos.‡Получите нужные сведения, уничтожив 10 восставших мертвецов или духов.‡Sammelt Informationen, indem Ihr 10 auferstandene Gebeine oder auferstandene Geister besiegt.‡되살아난 허울과 되살아난 영혼 10구에게서 정보를 수집해야 합니다.‡Reúne información derrotando a 10 raquíticos resucitados o espíritus resucitados.‡Reúne información derrotando a 10 raquíticos resucitados o espíritus resucitados.‡Collectez des informations auprès de 10 Carcasses ressuscitées ou Esprits ressuscités.‡打败10个复活的躯壳或复活的游魂，从它们身上收集情报。‡擊敗10個復活之軀或復活之靈來獲得情報。',
  }
},
[27189] = {
  {
    'A ruína da bruxa‡Ведьмина погибель‡Der Hexenfluch‡마녀독풀‡La ruina de las brujas‡La ruina de las brujas‡La plaie de la sorcière‡除巫草‡女巫剋星',
    nil,
    'Colete 9 talos de Espanta-bruxa nas proximidades do Morro das Bruxas.‡Соберите 9 побегов ведьминой погибели близ Ведьмина холма.‡Sammelt 9 Zweige Hexenfluch am Hexenhügel.‡마녀 언덕에서 마녀독풀 9줄기를 모아야 합니다.‡Reúne 9 brotes de ruinabruja cerca de la Colina de las Brujas.‡Reúne 9 brotes de ruinabruja cerca de la Colina de las Brujas.‡Collectez 9 branches de Sorbier près de la Colline des Sorcières‡在女巫岭附近采集9根除巫草。‡在女巫嶺附近收集9株女巫剋星。',
  }
},
[27190] = {
  {
    'A expurgação do Morro das Bruxas‡Очищение Ведьмина холма‡Die Reinigung des Hexenhügels‡마녀 언덕 정화‡Limpiar la Colina de las Brujas‡Limpiar la Colina de las Brujas‡Nettoyer la Colline des sorcières‡净化女巫岭‡淨化女巫嶺',
    nil,
    'Coloque a Tocha de Espanta-bruxa no fim da doca e derrote o mal que assombra o Morro das Bruxas.‡Установите факел Ведьминой погибели в конце доков и сразитесь с нечистью, населяющей Ведьмин холм.‡Platziert die Hexenfluchfackel am Ende des Anlegstegs und besiegt das Böse, das Hexenhügel heimsucht.‡부두 끝에 마녀독풀 횃불을 세우고 마녀 언덕을 공포로 몰아넣은 사악한 무언가를 처치해야 합니다.‡Coloca la antorcha ruinabruja en el extremo del puerto y derrota al mal que embruja la Colina de las Brujas.‡Coloca la antorcha ruinabruja en el extremo del puerto y derrota al mal que embruja la Colina de las Brujas.‡Plantez la Torche en sorbier au bout du quai et combattez le mal qui hante la Colline des Sorcières.‡将除巫火炬放置在码头的尽头，击败出没于女巫岭的邪恶。‡將女巫剋星火炬放在碼頭的盡頭來擊敗糾纏在女巫嶺的邪惡力量。',
  }
},
[27191] = {
  {
    'Uma fome de ogro!‡Голодный как огр!‡Hungrig wie ein Oger!‡너무 배고파!‡¡Tan hambriento como un ogro!‡¡Tan hambriento como un ogro!‡Affamé comme un ogre !‡跟食人魔一样饿‡餓得像隻巨魔!',
    nil,
    'Colete 8 Cabeças de Lamapina dos Murlocs Lamapina.‡Соберите 8 голов мурлоков из племени Болотного Плавника.‡Sammelt 8 Schlammflossenköpfe von den Murlocs der Schlammflossen.‡진흙아가미 멀록의 머리를 8개 모아야 합니다.‡Reúne 8 cabezas de Ancalodo de múrlocs Ancalodo.‡Reúne 8 cabezas de Ancalodo de múrlocs Ancalodo.‡Récupérez 8 Têtes d\'Aileron boueux sur des Murlocs Aileron boueux.‡从黑鳍鱼人身上获得8条泥鳍小鱼。‡從沼鰭魚人的身上取得8個沼鰭魚人頭。',
  }
},
[27192] = {
  {
    'A tentação de Fras Siabi‡Великий Фрас Сиаби‡Der große Fras Siabi‡위대한 프라스 샤비‡El gran Fras Siabi‡El gran Fras Siabi‡Le grand Fras Siabi‡了不起的弗拉斯·希亚比‡弗拉斯·希亞比',
    nil,
    'Recupere uma caixa do Tabaco da Lata do Fras Siabi.‡Раздобудьте коробку отличного табака Фраса Сиаби.‡Bergt einen Kasten von Fras Siabis Tollem Tabak.‡프라스 샤비의 최고급 담배를 회수해야 합니다.‡Recobra una caja del tabaco de calidad de Fras Siabi.‡Recobra una caja del tabaco de calidad de Fras Siabi.‡Trouvez une boîte de Tabac de Fras Siabi.‡找到一箱弗拉斯·希亚比的香烟。‡發現1盒弗拉斯·希亞比的特級煙草。',
  }
},
[27193] = {
  {
    'Busque e destrua‡Найти и уничтожить‡Suchen und Zerstören‡탐색과 격멸‡Busca y destruye‡Busca y destruye‡Curieuses tueries‡搜索并毁灭‡搜索與摧毀',
    nil,
    'Vasculhe as fazendas na Miséria de Olsen.‡Обыскать фермы в Уделе Ольсена.‡Durchsucht die Bauernhäuser auf Olsens Acker.‡올슨 농장을 수색해야 합니다.‡Registra las granjas en la Finca de Olsen.‡Registra las granjas en la Finca de Olsen.‡Fouillez les fermes des Essarts des Olsen.‡搜索奥森农场的农舍。‡在奧森農場搜索農舍。',
  }
},
[27194] = {
  {
    'Encurralados e esmagados!‡Загнать и уничтожить!‡In die Ecke gedrängt und zermalmt!‡추적하여 전멸시켜라!‡¡Arrinconados y aplastados!‡¡Arrinconados y aplastados!‡Qu’on les accule !‡走投无路！‡逼進死角、徹底擊垮!',
    nil,
    'Apresente-se ao Mestre Forteski na Mina Elenfunda, que fica na Floresta de Pinhaprata.‡Явитесь к мастеру Фортески на Серебряный рудник в Серебряном бору.‡Meldet Euch bei Meister Forteski in der Tiefenfelsmine im Silberwald.‡은빛소나무 숲의 심원 광산에 있는 장교 포테스키에게 보고해야 합니다.‡Preséntate ante el maestro Forteski en la Mina de Elem en el Bosque de Argénteos.‡Preséntate ante el maestro Forteski en la Mina de Elem en el Bosque de Argénteos.‡Présentez-vous à Maître Forteski à la Mine du gouffre d\'Elem, dans la Forêt des Pins-Argentés.‡去找银松森林埃利姆矿洞的士官长弗尔特斯基 。‡到銀松森林的深埃連礦坑向佛泰斯基大師回報。',
  }
},
[27195] = {
  {
    'Sem ter pra onde correr‡Бежать некуда‡Es gibt keinen Ausweg‡도주로 차단‡Sin salida‡Sin salida‡Sans échappatoire‡无处可跑‡無處可逃',
    nil,
    'Escolte o Mestre Forteski dentro da Mina Elenfunda.‡Сопроводите мастера Фортески на Серебряный рудник.‡Begleitet Meister Forteski durch die Tiefenfelsmine.‡심원 광산까지 장교 포테스키를 호위해야 합니다.‡Escolta al maestro Forteski a través de la Mina de Elem.‡Escolta al maestro Forteski a través de la Mina de Elem.‡Escortez Maître Forteski dans la Mine du gouffre d\'Elem.‡护送士官长弗尔特斯基通过埃利姆矿洞。‡護衛佛泰斯基大師通過深埃連礦坑。',
  }
},
[27196] = {
  {
    'Aprontando alguma coisa‡Исторический момент‡Irgendetwas geht vor sich‡놀라운 사실‡En el buen camino‡En el buen camino‡Sur un gros coup‡大事件‡開始有眉目了',
    nil,
    'Acompanhe Harrison Jones à Câmara das Estrelas.‡Сопроводите Харрисона Джонса в Зал Звезд.‡Begleitet Harrison Jones zur Kammer der Sterne.‡해리슨 존스와 함께 별의 방으로 가야 합니다.‡Acompaña a Harrison Jones a la Cámara de las Estrellas.‡Acompaña a Harrison Jones a la Cámara de las Estrellas.‡Accompagnez Harrison Jones à la Chambre des Étoiles.‡陪伴哈里森·琼斯前往群星之厅。‡陪同哈里遜‧瓊斯前往眾星之間。',
  }
},
[27197] = {
  {
    'A batalha continua‡Борьба возобновляется!‡Die Schlacht geht weiter!‡전투 재개!‡¡Se reanuda la batalla!‡¡Se reanuda la batalla!‡La bataille reprend !‡战斗又打响了！‡戰火重新點燃',
    nil,
    'Apresente-se ao Thassarian em Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с Тассарианом в Андорале в Западных Чумных землях.‡Meldet Euch bei Thassarian in Andorhal in den Westlichen Pestländern.‡서부 역병지대의 안돌할에 있는 타사리안에게 보고해야 합니다.‡Preséntate ante Thassarian en Andorhal, en las Tierras de la Peste del Oeste.‡Preséntate ante Thassarian en Andorhal, en las Tierras de la Peste del Oeste.‡Présentez-vous à Thassarian à Andorhal, dans les Maleterres de l’Ouest.‡向西瘟疫之地安多哈尔城的萨萨里安报告。‡到西瘟疫之地的安多哈爾向薩沙理安報到。',
  }
},
[27198] = {
  {
    'Ajuda às tropas‡Поддержка войск‡Die Truppen unterstützen‡아군 지원‡Apoyar a las tropas‡Apoyar a las tropas‡À la rescousse des défenseurs‡支援部队‡支援部隊',
    nil,
    'Mate 15 Necroguardas de Andorhal.‡Убейте 15 стражей смерти из Андорала.‡Tötet 15 Todeswachen von Andorhal.‡안돌할 죽음경비병 15명을 처치해야 합니다.‡Asesina a 15 guardias de la Muerte de Andorhal.‡Asesina a 15 guardias de la Muerte de Andorhal.‡Tuez 15 Nécrogardes d’Andorhal.‡消灭15名安多哈尔亡灵卫兵。‡殺死15名安多哈爾亡靈守衛。',
  }
},
[27199] = {
  {
    'Do pó ao pó‡Прах к праху‡Asche zu Asche‡재에서 재로‡Cenizas a las cenizas‡Cenizas a las cenizas‡Éliminer le haut commandement‡尘归尘‡塵歸塵',
    nil,
    'Mate 3 Necroguardas Capitães-de-guerra‡Уничтожьте 3 военачальников стражей смерти.‡Tötet 3 Kriegshauptmänner der Todeswache.‡죽음경비병 전투대장 3명을 처치해야 합니다.‡Asesina a 3 capitanes de guerra Guardia de la Muerte.‡Asesina a 3 capitanes de guerra Guardia de la Muerte.‡Tuez 3 Capitaines de guerre nécrogardes.‡杀死3名亡灵卫兵战地队长。‡殺死3名亡靈守衛作戰指揮。',
  }
},
[27200] = {
  {
    'Canção da sereia‡Зов сирены‡Sirenenlied‡세이렌의 노래‡Canto de sirena‡Canto de sirena‡Le chant de la Sirène‡海妖之歌‡海妖之歌',
    nil,
    'Mate Ophelia, a Sereia do Planalto.‡Убейте Офелию, сирену нагорья.‡Tötet Ophelia, die Sirene des Hochlands.‡고원의 세이렌, 오필리아를 처치해야 합니다.‡Mata a Ofelia, la sirena de las Tierras Altas.‡Mata a Ophelia, la sirena de las Tierras Altas.‡Tuez Ophelia, la sirène des Hautes-terres.‡杀死奥菲莉亚，高地的海妖。‡殺死在高地的海妖，奧芬利亞。',
  }
},
[27201] = {
  {
    'Incursão val\'kyr‡Вторжение валь\'кир‡Angriff der Val\'kyr‡발키르의 침략‡La incursión de las Val\'kyr‡La incursión de las Val\'kyr‡L\'incursion val’kyr‡瓦格里进犯‡華爾琪入侵',
    nil,
    'Mate 9 Val\'kyren Menores em Andorhal.‡Убейте 9 низших валь\'кир в Андорале.‡Tötet 9 niedrige Val\'kyr in Andorhal.‡안돌할 안에 있는 하급 발키르 9명을 처치해야 합니다.‡Mata a 9 Val\'kyr inferiores en el interior de Andorhal.‡Mata a 9 Val\'kyr inferiores en el interior de Andorhal.‡Tuez 9 Val’kyrs inférieures à Andorhal.‡杀死安多哈尔城内的9只低阶瓦格里。‡在安多哈爾裡殺了9個小型華爾琪。',
  }
},
[27202] = {
  {
    'Irmão contra irmão‡Брат против брата‡Bruder gegen Bruder‡동족상잔의 비극‡Hermano contra hermano‡Hermano contra hermano‡Duel fratricide‡兄弟阋墙‡兄弟鬩牆',
    nil,
    'Mate 20 Soldados Renegados em Andorhal.‡Убейте 20 солдат-Отрекшихся в Андорале.‡Tötet 20 Reitersoldaten der Verlassenen in Andorhal.‡안돌할 안에서 포세이큰 돌격병 20명을 처치해야 합니다.‡Mata a 20 soldados de caballería Renegados en el interior de Andorhal.‡Mata a 20 soldados de caballería Renegados en el interior de Andorhal.‡Tuez 20 Troupiers réprouvés à Andorhal.‡杀死安多哈尔城里的20名被遗忘者步兵。‡在安多哈爾裡殺了20個被遺忘者裝甲兵。',
  }
},
[27203] = {
  {
    'Voragem‡Водоворот‡Der Mahlstrom‡혼돈의 소용돌이‡La Vorágine‡La Vorágine‡Le Maelström‡大漩涡‡大漩渦',
    nil,
    'Atravesse o Portal para Voragem e fale com Thrall.‡Пройдите через портал в Водоворот и поговорите с Траллом.‡Geht durch das Portal in den Mahlstrom und sprecht mit Thrall.‡혼돈의 소용돌이로 통하는 차원문으로 들어가 스랄과 대화해야 합니다.‡Atraviesa el portal en dirección a La Vorágine y habla con Thrall.‡Atraviesa el portal en dirección a La Vorágine y habla con Thrall.‡Traversez le Portail vers le Maelström et allez parler à Thrall.‡通过传送门前往大漩涡，跟萨尔谈一谈。‡穿過傳送門抵達大漩渦並且和索爾談話。',
  }
},
[27204] = {
  {
    'Aradne‡Арадне‡Aradne‡아라드네‡Aradne‡Aradne‡Aradne‡阿娜德尼‡亞拉登',
    nil,
    'Mate Aradne no topo da torre que fica na parte ocidental de Andorhal.‡Убейте Арадне на вершине башни в западном Андорале.‡Tötet Aradne auf dem Turm im westlichen Teil von Andorhal.‡안돌할 서쪽의 탑 위에 있는 아라드네를 처치해야 합니다.‡Asesina a Aradne en lo alto de la torre en la parte oeste de Andorhal.‡Asesina a Aradne en lo alto de la torre en la parte oeste de Andorhal.‡Tuez Aradne au sommet de la tour, dans la partie ouest d’Andorhal.‡杀死安多哈尔西侧塔顶的阿娜德尼。‡到安多哈爾西部的哨塔上殺死亞拉登。',
  }
},
[27205] = {
  {
    'A depravação dos Renegados‡Коварство Отрекшихся‡Die Verderbtheit der Verlassenen‡포세이큰의 타락‡La depravación de los Renegados‡La depravación de los Renegados‡La vilenie des Réprouvés‡被遗忘者的败落‡被遺忘者的墮落',
    nil,
    'Descubra o que Thassarian está vendo.‡Узнайте, что привлекло внимание Тассариана.‡Findet heraus, was Thassarian anschaut.‡타사리안이 보는 것이 무엇인지 알아봐야 합니다.‡Averigua lo que está mirando Thassarian.‡Averigua lo que está mirando Thassarian.‡Découvrez ce que Thassarian regarde.‡查看萨萨里安在瞧什么。‡找出薩沙理安在看什麼。',
  }
},
[27206] = {
  {
    'Adeus, Andorhal‡Увы тебе, Андорал‡Weh dir, Andorhal‡아, 안돌할이여‡Ah, Andorhal‡Ah, Andorhal‡Adieu, Andorhal‡唉，安多哈尔‡啊，安多哈爾!',
    nil,
    'Relate os eventos da batalha de Andorhal para o Comandante Ashlam Punhobom.‡Расскажите командиру Ашламу Неутомимому о ходе битвы за Андорал.‡Berichtet Kommandant Ashlam Ehrenschlag von den Ereignissen der Schlacht von Andorhal.‡사령관 아쉬람 발러피스트에게 안돌할 전투에서 일어났던 일들을 보고해야 합니다.‡Informa de los acontecimientos de la batalla de Andorhal al comandante Ashlam Puñovalor.‡Informa de los acontecimientos de la batalla de Andorhal al comandante Ashlam Puñovalor.‡Faites le rapport des évènements de la bataille d’Andorhal au Commandant Ashlam Vaillepoing.‡向指挥官阿什拉姆·瓦罗菲斯特汇报安多哈尔战况。‡向指揮官阿胥拉姆·瓦羅菲斯特報告安多哈爾的戰事。',
  }
},
[27207] = {
  {
    '‡Такого ветром не сдует‡Es ist windig‡바람의 왕자‡Esto no va bien‡‡Au vent mauvais‡狂风骤起，有待扑灭‡',
    nil,
    '‡Убейте принца Сарсаруна и поставьте об этом в известность генерала Маркуса Джонсона в Штормграде.‡Tötet Prinz Sarsarun und erstattet General Marcus Jonathan in Sturmwind Bericht.‡왕자 사르사룬을 처치하고 스톰윈드에 있는 장군 마커스 조나단에게 알려야 합니다.‡Mata al príncipe Sarsarun e informa al general Marcus Jonathan en Ciudad de Ventormenta.‡‡Massacrez le Prince Sarsarun et informez-en le Général Marcus Jonathan à Hurlevent.‡杀死萨尔萨隆王子，并通知暴风城的马库斯·乔纳森将军。‡',
  }
},
[27208] = {
  {
    'O senhor do medo Balnazzar‡Повелитель Ужаса Бальназар‡Der Schreckenslord Balnazzar‡공포의 군주 발나자르‡El Señor del Terror Balnazzar‡El Señor del Terror Balnazzar‡Le Seigneur de l\'effroi Balnazzar‡恐惧领主巴纳扎尔‡驚懼領主巴納札爾',
    nil,
    'Mate Balnazzar.‡Убейте Бальназара.‡Tötet Balnazzar.‡발나자르를 처치해야 합니다.‡Mata a Balnazzar.‡Mata a Balnazzar.‡Tuez Balnazzar.‡杀死巴纳扎尔。‡殺死巴納札爾。',
  }
},
[27209] = {
  {
    '‡Такого ветром не сдует‡Es ist windig‡바람의 왕자‡Esto no va bien‡‡Au vent mauvais‡狂风骤起，有待扑灭‡',
    nil,
    '‡Убейте принца Сарсаруна и поставьте об этом в известность Хамуула Рунического Тотема в Громовом Утесе.‡Tötet Prinz Sarsarun und erstattet Hamuul Runentotem in Donnerfels Bericht.‡왕자 사르사룬을 처치하고 썬더 블러프에 있는 하뮬 룬토템에게 알려야 합니다.‡Mata a al príncipe Sarsarun e informa a Hamuul Tótem de Runa en Cima del Trueno.‡‡Massacrez le Prince Sarsarun et informez-en Hamuul Totem-Runique aux Pitons-du-Tonnerre.‡‡',
  }
},
[27210] = {
  {
    'Há traidores entre nós‡Чужой среди своих‡Verräter unter uns‡무리의 배신자‡Traidores entre nosotros‡Traidores entre nosotros‡Des traîtres sont parmi nous‡叛徒‡叛徒就在我們之中',
    nil,
    'Confronte 5 Desertores Subversivos em Theramore.‡Прогоните 5 дезертиров-подстрекателей в Тераморе.‡Konfrontiert 5 Aufwiegler der Deserteure in Theramore.‡테라모어에 있는 탈영 선동원 5명을 찾아내야 합니다.‡Enfréntate a 5 agitadores desertores en Theramore.‡Enfréntate a 5 agitadores desertores en Theramore.‡Affrontez 5 Déserteurs agitateurs à Theramore.‡在塞拉摩面对5名叛逃煽动者。‡在塞拉摩找出5個叛逃者煽動家。',
  }
},
[27211] = {
  {
    'Propaganda de guerra‡Пропагандистская война‡Propagandakrieg‡선동 전쟁‡Guerra de propaganda‡Guerra de propaganda‡Guerre de propagande‡宣传战‡宣傳戰',
    nil,
    'Obtenha a Propaganda do Desertor em uma embarcação, no fim das docas de Theramore.‡Добудьте листовки дезертиров с корабля в дальнем конце доков Терамора.‡Erhaltet das Propagandamaterial der Deserteure vom Schiff am Ende der Docks in Theramore.‡테라모어 부두 끝에서 선동 유인물 상자를 획득해야 합니다.‡Obtén la propaganda de los desertores del barco que se encuentra en el extremo del puerto de Theramore.‡Obtén la propaganda de los desertores del barco que se encuentra en el extremo del puerto de Theramore.‡Récupérez la Propagande des déserteurs dans le bateau au bout des quais de Theramore.‡在塞拉摩码头尽头的船上获得叛逃者传单。‡在塞拉摩碼頭盡頭的船上取得叛逃者宣傳計畫。',
  }
},
[27212] = {
  {
    'Difamando os desertores‡Дискредитация вражеской агентуры‡Diskreditierung der Deserteure‡탈영병 쫓아내기‡Desprestigiando a los desertores‡Desprestigiando a los desertores‡Discréditer les déserteurs‡羞辱叛逃者‡敗壞叛逃者的名聲',
    nil,
    'Distribua os Panfletos Alterados entre 6 Guardas de Theramore.‡Всучите подправленные листовки 6 тераморским стражникам.‡Verteilt verfälschte Handzettel an 6 Wachen von Theramore.‡테라모어 경비병 6명에게 변경된 유인물을 배포해야 합니다.‡Distribuye los panfletos modificados a 6 guardias de Theramore.‡Distribuye los panfletos modificados a 6 guardias de Theramore.‡Distribuez les Pamphlets trafiqués à 6 Gardes de Theramore.‡向6个塞拉摩卫兵发放修改过的传单。‡將竄改過的傳單散發給6個塞拉摩守衛。',
  }
},
[27213] = {
  {
    'O fim dos desertores‡Конец вражеской пропаганде‡Das Ende der Deserteure‡탈영병들의 종말‡El fin de los desertores‡El fin de los desertores‡La fin des déserteurs‡叛逃者的末日‡叛逃者的末日',
    nil,
    'Derrote Gavis Escudogris, a bordo do navio ao sudeste de Theramore.‡Победите Гависа Серого Щита на борту корабля к юго-востоку от Терамора.‡Besiegt Gavis Grauschild auf dem Schiff südöstlich von Theramore.‡테라모어 남동쪽의 배에 탄 가비스 그레이쉴드를 처치해야 합니다.‡Derrota a Gavis Rodelagris a bordo del barco que se encuentra al sureste de Theramore.‡Derrota a Gavis Rodelagris a bordo del barco que se encuentra al sureste de Theramore.‡Affrontez Gavis Targegrise sur le bateau au sud-est de Theramore.‡打败塞拉摩东南方船上的贾维斯·格雷希德。‡在東南邊的船上擊敗蓋維司‧灰盾。',
  }
},
[27214] = {
  {
    'Um desenvolvimento perturbador dos fatos‡Тревожные события‡Beunruhigende Berichte‡불안한 전개‡Un progreso preocupante‡Un progreso preocupante‡Un développement inquiétant‡麻烦的事态‡令人困擾的發展',
    nil,
    'Apresente-se ao Capitão Walmor no Pontal de Vigília.‡Поговорите с капитаном Ваймором на Сторожевом посту.‡Erstattet Hauptmann Wymor bei der Späherwacht Bericht.‡감시초소에 있는 경비대장 와이모어에게 보고해야 합니다.‡Preséntate ante el capitán Wymor en el Alto del Centinela.‡Preséntate ante el capitán Wymor en el Alto del Centinela.‡Présentez-vous au capitaine Wymor à la Halte de la Vigie.‡向警戒哨岗的维摩尔上尉报到。‡向警戒崗哨的魏摩爾上尉回報。',
  }
},
[27215] = {
  {
    'O ermitão do Casarão do Pantanal Iluminado‡Отшельник из сторожки "Болотный огонек"‡Der Einsiedler beim Irrlichtanwesen‡늪지기 오두막의 은둔자‡El ermitaño de la Mansión Cienaluz‡El ermitaño de la Mansión Cienaluz‡L\'ermite du manoir des Flammeroles‡水光庄园的隐士‡水光莊園的隱士',
    nil,
    'Fale com Zé "Olho de Lama", no Casarão do Pantanal Iluminado.‡Поговорите с Ярлом "Болотным глазом" в сторожке "Болотный огонек".‡Sprecht mit "Sumpfauge" Jarl im Irrlichtanwesen.‡늪지기 오두막에 있는 "늪지눈알" 자를과 대화해야 합니다.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Habla con "Ojolodo" Jarl en la Mansión Cienaluz.‡Parlez à Jarl « Oeil-des-marais » au Manoir des Flammeroles.‡跟水光庄园的“沼泽之眼”加尔谈一谈。‡跟水光莊園的『沼澤之眼』加爾談話。',
  }
},
[27216] = {
  {
    'O farol velho‡Этот старый маяк‡Der alte Leuchtturm‡오래된 등대‡Este viejo faro‡Este viejo faro‡Le vieux phare‡这座旧灯塔‡廢棄的燈塔',
    nil,
    'Fale com Dani Torqueimado no farol da ilha ao leste de Theramore.‡Поговорите с Бабс Шипокруткой на маяке на острове к востоку от Терамора.‡Sprecht mit Babs Zischeldrill am Leuchtturm auf der Insel östlich von Theramore.‡테라모어의 동쪽 섬에 있는 등대로 가서 밥스 피즐톨크와 대화해야 합니다.‡Habla con Babs Dinamométrica en el faro de la isla al este de Theramore.‡Habla con Babs Dinamométrica en el faro de la isla al este de Theramore.‡Parler à Babs Patranivelle au phare, sur l\'île à l\'est de Theramore.‡跟塞拉摩东边岛屿上灯塔的巴布·菲兹托克谈一谈。‡跟塞拉摩東邊島上燈塔的鮑伯斯·嘶鍊談話。',
  }
},
[27217] = {
  {
    'Óleo de mangual‡Жир крепкозуба‡Drescheröl‡트레샤돈 기름‡Aceite de trillador‡Aceite de trillador‡L\'huile de batteur‡蛇颈龙油‡蛇頸龍油',
    nil,
    'Colete 4 caixas de Óleo de Mangual dos Mangualamas abaixo das docas de Theramore.‡Добудьте 4 контейнера жира черных крепкозубов, живущих в доках Терамора.‡Sammelt 4 Behälter mit Drescheröl von den Düsterdreschern unter den Docks von Theramore.‡테라모어 부두 밑에 있는 늪지트레샤돈으로부터 트레샤돈 기름 4통을 모아야 합니다.‡Reúne 4 contenedores de aceite de trillador de trilladores de la oscuridad bajo el puerto de Theramore.‡Reúne 4 contenedores de aceite de trillador de trilladores de la oscuridad bajo el puerto de Theramore.‡Collectez 4 récipients d’Huile de batteur des Batteurs des boues vivant sous les docks de Theramore.‡从塞拉摩码头下的黑色蛇颈龙身上获取4瓶蛇颈龙油。‡從塞拉摩碼頭底下的黑色蛇頸龍那裡收集4罐蛇頸龍油。',
  }
},
[27218] = {
  {
    'Pavorosos Pusilânimes das Profundezas‡Подлые обитатели глубин‡Heimtückische Bewohner der Tiefe‡깊은 바다에 사는 사악한 생물들‡Ruines Moradores de las Profundidades‡Ruines Moradores de las Profundidades‡Créatures ignobles des profondeurs‡深海中的卑劣生物‡深海的卑鄙居民',
    nil,
    'Leve o livro Pavorosos Pusilânimes das Profundezas a Michael Crowe, o Sujo, nas docas de Theramore.‡Отнесите книгу "Подлые обитатели глубин" в доки Терамора и отдайте "Весельчаку" Ленни Полечуду.‡Bringt das Buch "Heimtückische Bewohner der Tiefe" zu Michael "Schmutz" Fink bei den Docks von Theramore.‡테라모어 부두의 "더러운" 마이클 크로에게 깊은 바다에 사는 사악한 생물들을 가져가야 합니다.‡Lleva Ruines Moradores de las Profundidades a "Sucio" Michael Crowe en el puerto de Theramore.‡Lleva Ruines Moradores de las Profundidades a "Sucio" Michael Crowe en el puerto de Theramore.‡Apporter « Créatures ignobles des profondeurs » à Michael « Crado » Crowe sur les docks de Theramore.‡把《深海中的卑劣生物》交给塞拉摩码头上的“脏鬼”迈克尔·克罗维。‡將《深海的卑鄙居民》交給塞拉摩碼頭的『髒鬼』麥可·克羅威。',
  }
},
[27219] = {
  {
    'É de verdade?‡Так это правда?‡Ist das wahr?‡진실 혹은 거짓?‡¿Es real?‡¿Es real?‡Il existe ?‡这是真的吗？‡這會是真的嗎?',
    nil,
    'Fale com Nat Pagle no Píer do Nat, que fica no Pântano Vadeoso.‡Поговорите с Натом Пэглом в лагере Ната, что в Пылевых топях.‡Sprecht mit Nat Pagle bei Nats Angelplatz in Düstermarschen.‡먼지진흙 습지대의 내트의 정박지에 있는 내트 페이글과 대화해야 합니다.‡Habla con Nat Pagle en el Embarcadero de Nat, en Marjal Revolcafango.‡Habla con Nat Pagle en el Embarcadero de Nat, en Marjal Revolcafango.‡Parlez à Nat Pagle au Point d’accostage de Nat, au Marécage d\'Âprefange.‡跟尘泥沼泽纳特的码头的纳特·帕格谈一谈。‡到塵泥沼澤的納特的平臺與納特·帕格談話。',
  }
},
[27220] = {
  {
    'A barganha de Nat‡Сделка Ната‡Nats Abmachung‡내트의 제안‡El trato de Nat‡El trato de Nat‡Le marché de Nat‡纳特的交易‡納特的討價還價',
    nil,
    'Espalhe o Patê de Peixe do Pagle, Extraforte no seu corpo e adentre a Enseada da Fúria das Marés nadando.‡Испытайте особую рыбную пасту Пэгла на себе, после чего плывите в Залив Яростных Волн.‡Schmiert Euch mit Pagles Fischpaste, extra stark ein und schwimmt dann hinaus in die Tidenbucht.‡몸에 페이글의 초강력 생선 반죽을 바르고 성난파도 만으로 헤엄쳐야 합니다.‡Úntate la pasta de pescado de Pagle, fuerza extra y nada hasta la Cala Furiamarea.‡Úntate la pasta de pescado de Pagle, fuerza extra y nada hasta la Cala Furiamarea.‡Enduisez-vous de la Pâte de poisson de Pagle, extra-forte, puis nagez dans la Crique du Mascaret.‡把帕格的超粘稠鱼肉酱涂在身上，然后游进狂潮湾。‡納特平台的納特·帕格要你去測試他的新魚餌。',
  }
},
[27221] = {
  {
    'Caramba, é de verdade!‡Он настоящий!‡Oh, es ist wahr!‡진실!‡Oh, es real‡Oh, es real‡Il existe !‡果然是真的‡喔，這是真的',
    nil,
    'Fale com o major Moendas nas docas de Theramore.‡Поговорите с майором Миллзом в доках Терамора.‡Sprecht mit Major Mühlens bei den Docks von Theramore.‡테라모어 부두의 상사 밀스와 대화해야 합니다.‡Habla con el mayor Mills en el puerto en Theramore.‡Habla con el mayor Molina en los muelles de Theramore.‡Parler au Major Mills sur les quais de Theramore.‡跟塞拉摩码头的米尔斯少校谈一谈。‡到塞拉摩碼頭與米爾斯少校談話。',
  }
},
[27222] = {
  {
    'Acabe com Tethyr!‡Сразить Тетура!‡Bezwingt Tethyr!‡테시르 사냥!‡¡Elimina a Tethyr!‡¡Elimina a Tethyr!‡Il faut tuer Tethyr !‡击败泰瑟尔！‡打倒泰瑟爾!',
    nil,
    'Use os morteiros para derrotar Tethyr.‡Сразите Тетура с помощью мортир.‡Benutzt die Mörser, um Tethyr zu besiegen.‡대포를 사용해 테시르를 처치해야 합니다.‡Usa los morteros para derrotar a Tethyr.‡Usa los morteros para derrotar a Tethyr.‡Utilisez les mortiers pour vaincre Tethyr.‡用迫击炮击败泰瑟尔。‡使用迫擊砲打敗泰瑟爾。',
  }
},
[27223] = {
  {
    'Retaliação‡Воздаяние‡Vergeltung‡심판‡Represalias‡Represalias‡Vindicte‡报应‡懲戒',
    nil,
    'Mate o Imperdoável e Tico, o Cruel.‡Убейте Непрощенного и Тимми Беспощадного.‡Tötet den Unverziehenen und Timmy den Grausamen.‡용서받지 못한 자와 잔혹한 티미를 처치해야 합니다.‡Mata a El Imperdonable y a Timmy el Cruel.‡Mata a La Imperdonable y a Timmy el Cruel. ‡Tuez le Condamné et Timmy le Cruel.‡杀死不可宽恕者和悲惨的提米。‡殺死不可寬恕者與悲慘的提米。',
  }
},
[27224] = {
  {
    '‡Знамя Андорала‡Andorhal, Phase: Flagge‡안돌할 페이즈 플래그‡‡‡Marqueur de phase d\'Andorhal‡‡',
    nil,
    nil,
  }
},
[27225] = {
  {
    'Convocação de Abner Germano‡Встреча с Андером Гермайном‡Aufforderung von Ander Germaine‡앤더 저메인의 부름‡Una llamada de Ander Germaine‡Una llamada de Ander Germaine‡Une convocation d’Ander Germaine‡安德尔·杰曼的召唤‡安得爾·傑曼的傳喚',
    nil,
    'Fale com Abner Germano no Centro de Comando de Ventobravo.‡Поговорите с Андером Гермайном в Ставке командования в Штормграде.‡Sprecht mit Ander Germaine in der Kommandozentrale von Sturmwind.‡스톰윈드 사령부에 있는 앤더 저메인과 대화해야 합니다.‡Habla con Ander Germaine en el Centro de Mando de Ventormenta.‡Habla con Ander Germaine en el Centro de Mando de Ventormenta.‡Parlez à Ander Germaine, dans le Centre de commandement de Hurlevent.‡跟暴风城指挥中心的安德尔·杰曼谈一谈。‡到暴風城的指揮所與安得爾·傑曼說話。',
  }
},
[27226] = {
  {
    'Nós trupica mas não cai‡Живительная влага‡Um ein Seebärenhaar‡화끈한 치료제‡El pelaje del lobo‡Pelo del perro‡Les loups reprennent du poil de la bête‡解醉酒‡水手的毛髮',
    nil,
    'Atice 8 Lobos do Mar Orcs.‡Приведите в чувство 8 орков-морских волков.‡Weckt 8 orcische Seebären auf.‡노련한 오크 선원 8명을 깨워야 합니다.‡Reanima a 8 lobos de mar orcos.‡Reanima a 8 lobos de mar orcos.‡Réveillez 8 Loups de mer orcs.‡弄醒8名兽人水兵。‡救醒8名獸人老水手。',
  }
},
[27227] = {
  {
    'Lorde Aurius Rivendare‡Лорд Аурий Ривендер‡Baron Aurius Totenschwur‡군주 아우리우스 리븐데어‡Lord Aurius Osahendido‡Lord Aurius Osahendido‡Le seigneur Aurius Vaillefendre‡奥里克斯·瑞文戴尔领主‡奧里爾斯·瑞文戴爾領主',
    nil,
    'Mate o Lorde Aurius Rivendare.‡Убейте лорда Аурия Ривендера.‡Tötet Baron Aurius Totenschwur.‡군주 아우리우스 리븐데어를 처치해야 합니다.‡Mata a Lord Aurius Osahendido.‡Mata a Lord Aurius Osahendido.‡Tuez le Seigneur Aurius Vaillefendre.‡杀掉奥里克斯·瑞文戴尔领主。‡殺死奧里爾斯·瑞文戴爾領主。',
  }
},
[27228] = {
  {
    'Abaixo a Abominação‡Человек против чудовища‡Mann gegen Monstrosität‡누더기골렘에 대항하는 인간의 자세‡Hombre contra abominación‡Hombre contra abominación‡Face à l\'Abomination‡对抗憎恶‡對抗憎恨的男人',
    nil,
    'Assassine Ramstein, o Engolidor.‡Прикончите Рамштайна Ненасытного.‡Tötet Ramstein den Verschlinger.‡먹보 람스타인을 처치해야 합니다.‡Asesina a Ramstein el Empachador.‡Asesina a Ramstein el Empachador.‡Massacrez Ramstein Grandgosier.‡宰杀吞咽者拉姆斯登。‡屠殺『暴食者』拉姆斯登。',
  }
},
[27229] = {
  {
    'DESTRUA A RAINHA DA NINHADA‡ГРОХНИ КОРОЛЕВУ‡ZERMATSCHT DIE BRUTKÖNIGIN‡여왕거미 처치‡APLASTA A LA REINA DE LINAJE‡APLASTA A LA REINA DE LINAJE‡ÉCRASER REINE DES COUVÉES‡砸扁蛛后‡打爛蛛后',
    nil,
    'Obtenha o Pedipalpo da Rainha da Ninhada.‡Добудьте педипальпу королевы.‡Beschafft den Pedipalpus der Brutkönigin.‡여왕거미 다리수염을 획득해야 합니다.‡Obtén el pedipalpo de la Reina de linaje.‡Obtén el pedipalpo de la Reina de linaje.‡Obtenez le Pédipalpe de la Reine des couvées.‡取得黑雾巢穴女王的触肢。‡取得蛛后觸肢。',
  }
},
[27230] = {
  {
    'Armas de guerra‡Вооружение‡Waffen für den Krieg‡전쟁용 무기‡Armas para la guerra‡Armas para la guerra‡Des armes de guerre‡战争的武器‡戰爭的武器',
    nil,
    'Mate o Cuteleiro da Guarda Negra.‡Убейте оружейника Черной Стражи.‡Tötet den Schwertschmied der schwarzen Wache.‡검은호위대 검제작자를 처치해야 합니다.‡Mata al armero Guardia Negra.‡Mata al armero Guardia Negra.‡Tuez le Fabricant d\'épées de la Garde noire.‡杀死黑衣守卫铸剑师。‡殺死黑衣守衛劍類鍛造師。',
  }
},
[27231] = {
  {
    'Reforços de Fenris‡Подкрепления с Фенриса‡Verstärkung aus Fenris‡펜리스의 지원군‡Refuerzos de Fenris‡Refuerzos de Fenris‡Les atroces renforts de Fenris‡芬里斯的援兵‡芬里斯的援軍',
    nil,
    'Mate 10 Worgens de Eira dos Montes.‡Уничтожьте 10 хилсбрадских воргенов.‡Tötet 10 Worgen des Hügellands.‡언덕마루 늑대인간 10명을 처치해야 합니다.‡Mata a 10 huargen de Trabalomas.‡Mata a 10 huargen de Trabalomas.‡Tuez 10 Worgens de Hautebrande.‡杀死10名希尔斯布莱德狼人。‡殺死10名希爾斯布萊德狼人。',
  }
},
[27232] = {
  {
    'Água rubra‡И вода обратилась в кровь...‡Rot gefärbte Gewässer ...‡붉게 물든 호수‡Las aguas se tiñeron de rojo...‡Las aguas se tiñeron de rojo...‡Les eaux rouges du lac Lordamere‡血染湖水……‡湖水已被染紅...',
    nil,
    'Mate 50 Worgens de Eira dos Montes com o Canhão da Horda.‡Уничтожьте 50 хилсбрадских воргенов при помощи пушки Орды.‡Tötet 50 Worgen des Hügellands mit der Kanone der Horde.‡호드 대포로 언덕마루 늑대인간 50명을 처치해야 합니다.‡Mata a 50 huargen de Trabalomas con el cañón de la Horda.‡Mata a 50 huargen de Trabalomas con el cañón de la Horda.‡Tuez 50 Worgens de Hautebrande avec le Canon de la Horde.‡用部落大炮杀死50名希尔斯布莱德狼人。‡用部落火砲殺死50名希爾斯布萊德狼人。',
  }
},
[27233] = {
  {
    'Acampamento dos Restauradores‡Участок Целителей Земли‡Die Stätte der Heiler‡치유사의 처소‡La Finca de los Ensalmadores‡La Finca de los Ensalmadores‡Le bivouac des Soigneurs‡治愈者营地‡治癒者崗哨',
    nil,
    'Apresente-se ao Agente de Campo Kaartish no Acampamento dos Restauradores, que fica nas Terras Pestilentas Ocidentais.‡Отчитайтесь перед агентом ШРУ Каартишем на Участке Целителей Земли в Западных Чумных землях.‡Meldet Euch bei Außenagent Kaartish in der Stätte der Heiler in den Westlichen Pestländern.‡서부 역병지대의 치유사의 처소에 있는 현장 요원 카티쉬에게 보고해야 합니다.‡Preséntate ante el agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Preséntate ante el agente de campo Kaartish en La Finca de los Ensalmadores en las Tierras de la Peste del Oeste.‡Présentez-vous à l’Agent de terrain Kaartish au Bivouac des Soigneurs, dans les Maleterres de l’Ouest.‡向西瘟疫之地治愈者营地的战地特工卡尔缇舍报告。‡到西瘟疫之地的治癒者崗哨向戰場密探卡爾堤須回報。',
  }
},
[27234] = {
  {
    'Os Défias, aqui no pântano?‡Братство Справедливости в Пылевых топях?‡Defias in Düstermarschen?‡먼지진흙 습지대에 나타난 데피아즈단‡¿Defias en Revolcafango?‡¿Defias en Revolcafango?‡Des Défias à Âprefange ?‡尘泥沼泽有迪菲亚兄弟会？‡迪菲亞在塵泥沼澤?',
    nil,
    'Obtenha as Ordens dos Défias de Galvão Matreiro.‡Заберите приказы Братства Справедливости у Гарна Маферса.‡Erhaltet die Befehle der Defias von Garn Mathers.‡가른 마더스에게서 데피아즈단 명령서를 획득해야 합니다.‡Obtén las órdenes Defias de Gran Mathers.‡Obtén las órdenes Defias de Gran Mathers.‡Récupérez les Ordres des Défias sur Garn Mathers.‡从加恩·马瑟斯手中夺得迪菲亚命令书。‡從加爾恩‧邁瑟斯身上取得迪菲亞指令。',
  }
},
[27235] = {
  {
    'Renato Deguelra‡Ренн Макжабр‡Renn McGill‡렌 맥길‡Renn McBranquia‡Renn McBranquia‡Renn McBranchie‡雷恩·米克基尔‡瑞恩‧麥格吉爾',
    nil,
    'Leve as Ordens de Défias para Renato Deguelra nas águas da Costa Tenebrosa.‡Отнесите приказы Братства Справедливости Ренну Макжабру. Он плавает недалеко от Зловещего берега.‡Bringt die Befehle der Defias zu Renn McGill in den Gewässern nahe Schreckensmoorküste.‡몸서리 해안 근처의 물속에 있는 렌 맥길에게 데피아즈단 명령서를 가져가야 합니다.‡Lleva las órdenes Defias a Renn McBranquia a las aguas más allá de Playa Tenebruma.‡Lleva las órdenes Defias a Renn McBranquia a las aguas más allá de Playa Tenebruma.‡Apportez les Ordres des Défias à Renn McBranchie dans les eaux au large du Rivage de Troubleffroi.‡将迪菲亚命令书交给恐惧海岸水域里的雷恩·米克基尔。‡把迪菲亞指令交給恐懼海岸的瑞恩‧麥格吉爾。',
  }
},
[27236] = {
  {
    'Equipamento de mergulho de segunda mão‡Старое водолазное снаряжение‡Tauchausrüstung aus zweiter Hand‡중고 잠수 장비‡Equipo de buceo de segunda mano‡Equipo de buceo de segunda mano‡Équipement de plongée d\'occasion‡二手潜水设备‡二手的潛水裝備',
    nil,
    'Leve o Kit de Ferramentas e o Equipamento de Mergulho Danificado para Renato Deguelra no Pântano Vadeoso.‡Принесите набор инструментов и испорченное водолазное снаряжение Ренну МакЖабру в Пылевые топи.‡Bringt den Werkzeugsatz und die beschädigte Tauchausrüstung zu Renn McGill in Düstermarschen.‡먼지진흙 습지대의 렌 맥길에게 수리 도구와 손상된 잠수 장비를 가져가야 합니다.‡Lleva la caja de herramientas y el equipo de buceo dañado a Renn McBranquia al Marjal Revolcafango.‡Lleva la caja de herramientas y el equipo de buceo dañado a Renn McBranquia al Marjal Revolcafango.‡Apportez le Jeu d\'outils et l\'Équipement de plongée endommagé à Renn McBranchie, dans le Marécage d\'Âprefange.‡将工具包和损坏的潜水设备交给尘泥沼泽的雷恩·米克基尔。‡把工具組和受損的潛水裝備帶給塵泥沼澤的瑞恩‧麥格吉爾。',
  }
},
[27237] = {
  {
    'Recolha a carga!‡Вернуть груз!‡Bergt die Fracht!‡뱃짐을 되찾아라!‡¡Recupera la mercancía!‡¡Recupera la mercancía!‡Récupérez la cargaison !‡找回货物！‡找回貨物!',
    nil,
    'Colete 1 Cofre Resgatado.‡Найдите спасенный сейф.‡Sammelt 1 geborgene Geldkassetten.‡인양된 금고 1개를 모아야 합니다.‡Recoge 1 caja fuerte rescatada.‡Recoge 1 caja fuerte rescatada.‡Collectez 1 Coffre récupéré.‡获得1只打捞上来的保险箱。‡收集1個打撈起來的保險箱。',
  }
},
[27238] = {
  {
    'Jaina precisa saber‡Джайна должна быть в курсе‡Jaina muss davon erfahren‡제이나에게 보고‡Jaina debe saberlo‡Jaina debe saberlo‡Jaina doit être informée‡通知吉安娜‡一定得讓珍娜知道',
    nil,
    'Fale com a Grã-senhora Jaina Proudmore em Theramore.‡Поговорите с леди Джайной Праудмур в Тераморе.‡Sprecht mit Lady Jaina Prachtmeer in Theramore.‡테라모어에 있는 여군주 제이나 프라우드무어와 대화해야 합니다.‡Habla con Lady Jaina Valiente en Theramore.‡Habla con Lady Jaina Valiente en Theramore.‡Parlez à dame Jaina Portvaillant à Theramore.‡跟塞拉摩的吉安娜·普罗德摩尔谈一谈。‡和塞拉摩的珍娜·普勞德摩爾談話。',
  }
},
[27239] = {
  {
    'Inspeção na Ilha Alcaz‡Исследование острова Алькац‡Beobachtet die Insel Alcaz‡알카즈 섬 조사‡Inspecciona la Isla de Alcaz‡Inspecciona la Isla de Alcaz‡Survoler l\'île d\'Alcaz‡调查奥卡兹岛‡偵察奧卡茲島',
    nil,
    'Fale com Cassa Carminasa e use um de seus grifos para inspecionar a Ilha Alcaz.‡Поговорите с Коссой Багровое Крыло и возьмите одного из ее грифонов, чтобы исследовать остров Алькац.‡Sprecht mit Cassa Purpurschwinge und nutzt einen ihrer Greifen, um die Insel Alcaz zu beobachten.‡카사 크림슨윙에게 그리핀을 빌려 알카즈 섬을 조사해야 합니다.‡Habla con Cassa Ala Carmesí y utiliza uno de sus grifos para inspeccionar la Isla de Alcaz.‡Habla con Cassa Ala Carmesí y utiliza uno de sus grifos para inspeccionar la Isla de Alcaz.‡Parlez à Cassa Cramoissaile et utilisez l’un de ses Griffons pour survoler l’île d’Alcaz.‡跟卡萨·赤翼谈一谈，乘坐她的一头狮鹫调查奥卡兹岛。‡和卡莎·紅翼談談，並用她的獅鷲獸偵察奧卡茲島。',
  }
},
[27240] = {
  {
    'Prova da traição‡Доказательство предательства‡Beweis des Verrats‡반역의 증거‡Prueba de traición‡Prueba de traición‡La preuve de la trahison‡叛变的证据‡背叛的證據',
    nil,
    'Fale com Jaina para ir a Ventobravo e conferenciar com o Rei Varian Wrynn.‡Поговорите с Джайной, чтобы добраться до Штормграда и поговорить с королем Варианом Ринном.‡Sprecht mit Jaina, sobald Ihr bereit seid, nach Sturmwind zu reisen und König Varian Wrynn zu treffen.‡제이나에게 말을 걸어 스톰윈드로 간 후, 스톰윈드 성의 국왕 바리안 린과 대화해야 합니다.‡Habla con Jaina para viajar hasta Ventormenta y encontrarte con el rey Varian Wrynn.‡Habla con Jaina para viajar hasta Ventormenta y encontrarte con el rey Varian Wrynn.‡Parlez avec Jaina pour voyager jusqu\'à Hurlevent et rencontrer le roi Varian Wrynn.‡跟吉安娜谈一谈，前往暴风城觐见瓦里安·乌瑞恩国王。‡和珍娜談話以傳送到暴風城與瓦里安·烏瑞恩國王會面。',
  }
},
[27241] = {
  {
    'Fale novamente com Jaina‡Возвращение к Джайне‡Rückkehr zu Jaina‡다시 제이나에게로‡Regresa junto a Jaina‡Regresa junto a Jaina‡Retourner voir Jaina‡返回吉安娜身边‡回覆珍娜',
    nil,
    'Apresente-se à Grã-senhora Jaina Proudmore em Theramore.‡Вернитесь к леди Джайне Праудмур в Терамор.‡Kehrt zu Lady Jaina Prachtmeer in Theramore zurück.‡테라모어에 있는 여군주 제이나 프라우드무어에게 가야 합니다.‡Vuelve con Lady Jaina Valiente en Theramore.‡Vuelve con Lady Jaina Valiente en Theramore.‡Retournez voir dame Jaina Portvaillant à Theramore.‡跟塞拉摩的吉安娜·普罗德摩尔谈一谈。‡到塞拉摩找珍娜·普勞德摩爾女士。',
  }
},
[27242] = {
  {
    'Quem rapta capta‡Ловец ящеров‡Raptorenfänger‡랩터 포획‡Captor de raptores‡Captor de raptores‡Rapt de raptor‡迅猛龙捕手‡捕捉迅猛龍',
    nil,
    'Use a Corda Robusta para capturar 6 Raptores ou Gritadores Dinossangue.‡При помощи прочной веревки поймайте 6 ящеров Кровавой Топи или крикунов Кровавой Топи.‡Benutzt den strapazierfähigen Strick, um 6 Blutsumpfraptoren oder Blutsumpfkreischer zu fangen.‡튼튼한 덩굴을 사용해 붉은늪지랩터나 긴송곳니 붉은늪지랩터 중에 6마리를 생포해야 합니다.‡Usa la cuerda resistente para capturar a 6 raptores Cienorrojo o estridadores Cienorrojo.‡Usa la cuerda resistente para capturar a 6 raptores Cienorrojo o estridadores Cienorrojo.‡Utilisez la Corde solide pour capturer 6 Raptors rougefange ou Hurleurs rougefange.‡使用结实的绳子捕获6条血沼迅猛龙或血沼尖啸龙。‡使用結實的繩索捕捉6隻血沼迅猛龍或血沼尖嘯龍。',
  }
},
[27243] = {
  {
    'Solte os raptores‡Боевые ящеры‡Lasst die Raptoren los‡랩터 풀어놓기‡Libera a los raptores‡Libera a los raptores‡Lâcher de raptors‡释放迅猛龙‡放出迅猛龍',
    nil,
    'Coloque a Isca de Raptor perto do moinho da Aldeia Casco Negro.‡Положите приманку для ящеров рядом с мельницей в деревне Черного Копыта.‡Platziert den Raptorköder in der Nähe der Windmühle im Dorf der Schwarzhufe.‡검은발굽 마을에 있는 풍차 근처에 랩터 미끼를 내려놓아야 합니다.‡Coloca la carnada de raptor cerca del molino de viento en el Poblado Pezuñanegra.‡Coloca la carnada de raptor cerca del molino de viento en el Poblado Pezuñanegra.‡Placez l’Appât à raptor près du moulin à vent de Sabot-Noir.‡将迅猛龙诱饵放在黑蹄村的风车附近。‡把迅猛龍誘餌放在黑蹄村的風車附近。',
  }
},
[27244] = {
  {
    'O relatório perdido‡Потерянный рапорт‡Der verlorene Bericht‡사라진 보고서‡El informe perdido‡El informe perdido‡Le rapport perdu‡失踪的报告‡遺失的報告',
    nil,
    'Leve o Relatório do Espião para Nazir Piquessangue na Aldeia Muralha Verde.‡Доставьте донесение шпиона Назиру Кровавое Копье в деревню Гиблотопь.‡Bringt den Bericht des Spions zu Nazeer Blutlanze in Brackenwall.‡담쟁이 마을에 있는 나지르 블러드파이크에게 밀정의 보고서를 가져가야 합니다.‡Lleva el informe de espía a Nazeer Picasangre al Poblado Murohelecho.‡Lleva el informe de espía a Nazeer Picasangre al Poblado Murohelecho.‡Apportez le Rapport de l\'espion à Nazeer Pique-sanglante, à Mur-de-Fougères.‡把间谍的报告交给蕨墙村的纳泽尔·血矛。‡把間諜的報告交給蕨牆村的納澤爾·血矛。',
  }
},
[27245] = {
  {
    'Os prisioneiros dos Temível Totem‡Пленники Зловещего Тотема‡Gefangene der Grimmtotem‡그림토템의 포로들‡Prisioneros de los Tótem Siniestro‡Prisioneros de los Tótem Siniestro‡Prisonniers des Totems-sinistres‡恐怖图腾的囚犯‡恐怖圖騰的囚犯',
    nil,
    'Pegue as Chaves dos Temível Totem dos taurens Temível Totem, na Aldeia Casco Negro, e use-as para libertar 5 Prisioneiros de Theramore.‡Отправляйтесь в деревню Черного Копыта, отберите ключи у тауренов из клана Зловещего Тотема и освободите 5 тераморских пленников.‡Erlangt die Schlüssel der Grimmtotem von den Taurendruiden der Grimmtotem im Dorf der Schwarzhufe und benutzt sie, um 5 Gefangene von Theramore zu befreien.‡검은발굽 마을의 그림토템 타우렌에게서 그림토템 열쇠를 모아, 5명의 테라모어 포로를 구해야 합니다.‡Reúne llaves de Tótem Siniestro de los tauren Tótem Siniestro en el Poblado Pezuñanegra y úsalas para liberar a 5 prisioneros de Theramore.‡Reúne llaves de Tótem Siniestro de los tauren Tótem Siniestro en el Poblado Pezuñanegra y úsalas para liberar a 5 prisioneros de Theramore.‡Récupérez des Clés du Totem-sinistre sur les taurens totems-sinistres à Sabot-Noir et utilisez-les pour libérer 5 Prisonniers de Theramore.‡从黑蹄村的恐怖图腾牛头人身上获得恐怖图腾钥匙，用它们解救5名塞拉摩囚犯。‡從黑蹄村的恐怖圖騰牛頭人手上取得恐怖圖騰鑰匙，並用來解放5名塞拉摩俘虜。',
  }
},
[27246] = {
  {
    'O relatório orc‡Орочий рапорт‡Der Orcbericht‡오크 보고서‡El informe orco‡El informe orco‡Le rapport orc‡兽人报告‡獸人的報告',
    nil,
    'Leve o Relatório do Espião ao Tenente Adão, em Theramore.‡Доставьте донесение шпиона лейтенанту Адену в Терамор.‡Bringt den Spionbericht zu Leutnant Aden in Theramore.‡테라모어에 있는 부관 아덴에게 밀정의 보고서를 가져가야 합니다.‡Lleva el informe de espía al teniente Aden a Theramore.‡Lleva el informe de espía al teniente Aden a Theramore.‡Apportez le Rapport de l\'Espion au lieutenant Aden, à Theramore.‡把间谍的报告交给塞拉摩的艾登中尉。‡把間諜的報告交給塞拉摩的亞汀中尉。',
  }
},
[27247] = {
  {
    'O Capitão Valente‡Капитан Ваймс‡Hauptmann Mumm‡사령관 바임스‡El capitán Vimes‡El capitán Vimes‡Le capitaine Vimaire‡维米斯队长‡維米斯隊長',
    nil,
    'Leve o Relatório do Espião ao Capitão Garrido Valente.‡Отнесите шпионское донесение капитану Гаррану Ваймсу.‡Bringt den Spionbericht zu Hauptmann Garran Mumm.‡사령관 개런 바임스에게 밀정의 보고서를 가져가야 합니다.‡Lleva el informe de espía al capitán Garran Vimes.‡Lleva el informe de espía al capitán Garran Vimes.‡Apportez le Rapport orc au capitaine Garran Vimaire.‡把间谍的报告交给盖兰·维米斯队长。‡把間諜的報告交給蓋蘭·維米斯隊長。',
  }
},
[27248] = {
  {
    'A missão Coroa de Barro‡Миссия в Шестермуть‡Mission nach Morastwinkel‡진흙톱니 거점으로의 임무‡Misión a Piñón de Barro‡Misión a Piñón de Barro‡En mission à Bourbe-à-brac‡泥链镇的任务‡前往泥鏈營地的任務',
    nil,
    'Fale com Drazzit Pingajunta em Coroa de Barro.‡Поговорите с Драззитом Кранотеком в Шестермути.‡Sprecht mit Drazzit Tropfhahn in Morastwinkel.‡진흙톱니 거점에 있는 드라짓 드립밸브와 대화해야 합니다.‡Habla con Drazzit Gotera en Piñón de Barro.‡Habla con Drazzit Gotera en Piñón de Barro.‡Parlez à Drazzit Suintevalve à Bourbe-à-brac.‡跟泥链镇的德拉兹特·迪普瓦尔谈一谈。‡跟泥鏈營地的德拉席特·滴栓談話。',
  }
},
[27249] = {
  {
    'A inspeção das ruínas‡Исследование пепелища‡Untersuchung der Ruinen‡폐허 조사‡Inspeccionando las ruinas‡Inspeccionando las ruinas‡Inspection des ruines‡调查废墟‡調查廢墟',
    nil,
    'Fale com o Inspetor Tarem, na Estalagem Pouso do Umbral.‡Поговорите с инспектором Таремом у трактира "Последний привал".‡Sprecht mit Inspektor Tarem beim Gasthaus "Zur Süßen Ruh".‡그늘 쉼터 여관에 가서 조사관 타렘과 대화해야 합니다.‡Habla con el inspector Tarem en la Posada Reposo Umbrío.‡Habla con el inspector Tarem en la Posada Reposo Umbrío.‡Parlez à l\'Inspecteur Tarem à l\'Auberge du Repos ombragé.‡跟树荫旅店的调查员塔雷姆谈一谈。‡和樹蔭旅店的巡察員塔倫談談。',
  }
},
[27250] = {
  {
    'REUSE - BAD COPY‡REUSE - BAD COPY‡WIEDERVERARBEITUNG - SCHLECHTE KOPIE‡REUSE - BAD COPY‡REUSE - BAD COPY‡REUSE - BAD COPY‡REUSE - BAD COPY‡REUSE - BAD COPY‡重新使用－壞副本',
    nil,
    'Speak with Vincent Hyal in Menethil Harbor.‡Поговорите с Винсентом Хьялем в Гавани Менетилов.‡Sprecht mit Vincent Hyal im Hafen von Menethil.‡Speak with Vincent Hyal in Menethil Harbor.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Allez voir Vincent Hyal au Port de Menethil.‡和米奈希尔港的文森特·海厄尔谈一谈。‡到米奈希爾港和文森·海爾談談。',
  }
},
[27251] = {
  {
    'Chamam-no Jim Sorridente‡Его зовут Улыбка Джим‡Sie nennen ihn den lächelnden Jim‡유쾌한 짐이라 불리는 사나이‡Le llaman Jim Sonrisas‡Le llaman Jim Sonrisas‡Ils l\'appellent Jim le Souriant‡微笑的吉姆‡他們叫他微笑的吉姆',
    nil,
    'Fale com o Capitão Garrido Valente, no último andar da Cidadela do Esteio.‡Поговорите с капитаном Гарраном Ваймсом на верхнем этаже Цитадели.‡Sprecht mit Hauptmann Garran Mumm auf der obersten Etage der Wehrzitadelle.‡거점 요새의 최상층에 있는 사령관 개런 바임스와 대화해야 합니다.‡Habla con el capitán Garran Vimes que está en el piso de arriba de la Ciudadela Garrida.‡Habla con el capitán Garran Vimes que está en el piso de arriba de la Ciudadela Garrida.‡Parlez au Capitaine Garran Vimaire au dernier étage de la citadelle de Theramore.‡与塞拉摩城堡顶层的盖兰·维米斯队长谈一谈。‡與塞拉摩堡壘的蓋蘭·維米斯上尉談話。',
  }
},
[27252] = {
  {
    'Vento ventania‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mate o Príncipe Sarsarun. Depois, informe esse feito ao General Marcus Jonas em Ventobravo.‡Отнесите почерневший железный щит капитану Гаррану Ваймсу в Терамор.‡Bringt den geschwärzten Eisenschild zu Hauptmann Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스에게 검은 철제 방패를 가져가야 합니다.‡Lleva el escudo de hierro ennegrecido al capitán Garran Vimes a Theramore.‡Lleva el escudo de hierro ennegrecido al capitán Garran Vimes a Theramore.‡Rapportez le Bouclier en fer noirci au capitaine Garran Vimaire à Theramore.‡把被熏黑的铁盾牌交给塞拉摩的盖兰·维米斯队长。‡把被燻黑的鐵盾帶去塞拉摩給蓋蘭·維米斯上尉。',
  }
},
[27253] = {
  {
    'A inspeção das ruínas‡Исследование пепелища‡Untersuchung der Ruinen‡폐허 조사‡Inspeccionando las ruinas‡Inspeccionando las ruinas‡Inspection des ruines‡调查废墟‡調查廢墟',
    nil,
    'Investigue a Estalagem Pouso do Umbral na extremidade dos Sertões, que fica no Pântano Vadeoso.‡Исследуйте пепелище таверны "Последний привал" на границе Степей и Пылевых топей.‡Erforscht das Gasthaus "Zur Süßen Ruh" an der Grenze Brachlands in Düstermarschen.‡먼지진흙 습지대의 불모의 땅 경계에 있는 그늘 쉼터 여관을 조사해야 합니다.‡Investiga la Posada Reposo Umbrío en la frontera de Los Baldíos en el Marjal Revolcafango.‡Investiga la Posada Reposo Umbrío en la frontera de Los Baldíos en el Marjal Revolcafango.‡Enquêtez à l\'Auberge du Repos ombragé à la frontière des Tarides, dans le Marécage d\'Âprefange.‡调查尘泥沼泽与贫瘠之地边境处的树荫旅店。‡和樹蔭旅店的巡察員塔倫談談。',
  }
},
[27254] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Leve o Escudo de Ferro Enegrecido a Krog, na Aldeia Muralha Verde.‡Отнесите почерневший железный щит Крогу в деревню Гиблотопь.‡Bringt den geschwärzten Eisenschild zu Krog in Brackenwall.‡담쟁이 마을에 있는 크로그에게 검은 철제 방패를 가져가야 합니다.‡Lleva el escudo de hierro ennegrecido a Krog al Poblado Murohelecho.‡Lleva el escudo de hierro ennegrecido a Krog al Poblado Murohelecho.‡Rapportez le Bouclier en fer noirci à Krog, à Mur-de-Fougères.‡把被熏黑的铁盾牌带给蕨墙村的克罗格。‡把被燻黑的鐵盾帶給蕨牆村的克羅格。',
  }
},
[27255] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Do\'gol na Aldeia Muralha Verde.‡Покажите потемневший железный щит До\'голу из деревни Гиблотопь.‡Zeigt den geschwärzten Eisenschild Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골에게 검은 철제 방패를 보여줘야 합니다.‡Muestra el escudo de hierro ennegrecido a Do\'gol en el Poblado Murohelecho.‡Muestra el escudo de hierro ennegrecido a Do\'gol en el Poblado Murohelecho.‡Montrez le Bouclier en fer noirci à Do\'gol, au village de Mur-de-Fougères.‡把被熏黑的铁盾牌拿给蕨墙村的杜高尔看一看。‡把被燻黑的鐵盾牌拿給蕨牆村的杜高爾看一看。',
  }
},
[27256] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Pegue 5 Vesículas de Peçonha Ácida das Aranhas Névoa Negra.‡Добудьте 5 ядовитых желез паука Мглистой пещеры для До\'гола из деревни Гиблотопь.‡Sammelt 5 Säuregiftbeutel von Graunebelspinnen.‡담쟁이 마을에 있는 도골을 위해 산성 독주머니 5개를 구해야 합니다.‡Reúne 5 glándulas de veneno ácido de arañas Niebla Negra.‡Reúne 5 glándulas de veneno ácido de arañas Niebla Negra.‡Récupérez 5 Sacs de venin acide sur des Araignées de Sombrebrume.‡从黑雾蜘蛛身上收集5个酸性毒囊。‡從暗霧蜘蛛身上收集到5個酸性毒囊。',
  }
},
[27257] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Fale com Krog na Aldeia Muralha Verde.‡Поговорите с Крогом в деревне Гиблотопь.‡Sprecht mit Krog in Brackenwall.‡담쟁이 마을에 있는 크로그와 대화해야 합니다.‡Ve al Poblado Murohelecho y habla con Krog.‡Ve al Poblado Murohelecho y habla con Krog.‡Parlez à Krog à Mur-de-Fougères.‡和蕨墙村的克罗格谈一谈。‡和蕨牆村的克羅格談話。',
  }
},
[27258] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Mosarn no Penhasco do Trovão.‡Покажите почерневший железный щит Мозарну в Громовом Утесе.‡Zeigt den geschwärzten Eisenschild Mosarn in Donnerfels.‡썬더 블러프에 있는 모사른에게 검은 철제 방패를 보여줘야 합니다.‡Ve a Cima del Trueno y enseña el escudo de hierro ennegrecido a Mosarn.‡Ve a Cima del Trueno y enseña el escudo de hierro ennegrecido a Mosarn.‡Montrez le Bouclier en fer noirci à Mosarn aux Pitons-du-Tonnerre.‡把被熏黑的铁盾牌拿给雷霆崖的莫萨恩看一看。‡把燻黑的鐵盾牌拿給雷霆崖的莫薩恩看看。',
  }
},
[27259] = {
  {
    'Pegadas em forma de casco‡Подозрительные отпечатки копыт‡Verdächtige Hufabdrücke‡수상한 발굽 자국‡Huellas de pezuñas sospechosas‡Huellas de pezuñas sospechosas‡Des empreintes de sabots suspectes‡可疑的蹄印‡可疑的蹄印',
    nil,
    'Informe Krog, na Aldeia Muralha Verde, sobre as pegadas suspeitas na Estalagem Pouso do Umbral.‡Расскажите о подозрительных следах около трактира "Последний Привал" Крогу в деревне Гиблотопь.‡Berichtet Krog in Brackenwall von den verdächtigen Abdrücken beim Gasthaus "Zur Süßen Ruh".‡담쟁이 마을에 있는 크로그에게 그늘 쉼터 여관의 수상한 흔적에 대해 보고해야 합니다.‡Informa a Krog, en el Poblado Murohelecho, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informa a Krog en el Poblado Murohelecho sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informez Krog, à Mur-de-Fougères, de la présence d\'empreintes suspectes à l’auberge du Repos ombragé.‡把树荫旅店的可疑蹄印报告给蕨墙村的克罗格。‡把樹蔭旅店的可疑蹄印報告給蕨牆村的克羅格。',
  }
},
[27260] = {
  {
    'Tenente Paval Reethe‡Лейтенант Павал Рит‡Leutnant Paval Reethe‡부관 파발 리테‡Teniente Paval Reethe‡Teniente Paval Reethe‡Le lieutenant Paval Reethe‡帕瓦尔·雷瑟上尉‡帕瓦爾·雷瑟上尉',
    nil,
    'Leve o Distintivo de Reethe para Krog na Aldeia Muralha Verde.‡Отнесите значок Рита Крогу в деревню Гиблотопь.‡Bringt Reethes Abzeichen zu Krog in Brackenwall.‡담쟁이 마을에 있는 크로그에게 리테의 배지를 가져가야 합니다.‡Lleva el distintivo de Reethe a Krog al Poblado Murohelecho.‡Lleva el distintivo de Reethe a Krog al Poblado Murohelecho.‡Rapportez le Badge de Reethe à Krog, à Mur-de-Fougères.‡把雷瑟的徽章带给蕨墙村的克罗格。‡把雷瑟的徽章帶給蕨牆村的克羅格。',
  }
},
[27261] = {
  {
    'O interrogatório de Reethe‡Допрос Рита‡Befragt Reethe‡리테 심문‡El interrogatorio de Reethe‡El interrogatorio de Reethe‡Questionner Reethe‡盘问雷瑟‡盤問雷瑟',
    nil,
    'Vá com Ogron para falar com Reethe.‡Пойдите с Огроном и поговорите с Ритом.‡Folgt Ogron und sprecht mit Reethe.‡오그론과 함께 가서 리테와 대화해야 합니다.‡Ve con Ogron a hablar con Reethe.‡Ve con Ogron a hablar con Reethe.‡Accompagnez Ogron pour questionner Reethe.‡和奥格隆一起去和雷瑟谈一谈。‡和奧格隆一起詢問雷瑟。',
  }
},
[27262] = {
  {
    'Pegadas em forma de casco‡Подозрительные отпечатки копыт‡Verdächtige Hufabdrücke‡수상한 발굽 자국‡Huellas de pezuñas sospechosas‡Huellas de pezuñas sospechosas‡Des empreintes de sabots suspectes‡可疑的蹄印‡可疑的蹄印',
    nil,
    'Informe o Capitão Garrido Valente, em Theramore, sobre as pegadas suspeitas na Estalagem Pouso do Umbral.‡Расскажите о подозрительных следах около трактира "Последний Привал" капитану Ваймсу в Тераморе.‡Berichtet Hauptmann Garran Mumm in Theramore von den verdächtigen Abdrücken beim Gasthaus "Zur Süßen Ruh".‡테라모어에 있는 사령관 개런 바임스에게 그늘 쉼터 여관의 수상한 흔적에 대해 보고해야 합니다.‡Informa al capitán Garran Vimes, en Theramore, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informa al capitán Garran Vimes, en Theramore, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informez le Capitaine Vimaire, à Theramore, de la présence d\'empreintes suspectes à l’Auberge du Repos ombragé.‡把树荫旅店的可疑蹄印报告给塞拉摩的盖兰·维米斯队长。‡把樹蔭旅店的可疑蹄印報告給塞拉摩的蓋蘭·維米斯上尉。',
  }
},
[27263] = {
  {
    'Tenente Paval Reethe‡Лейтенант Павал Рит‡Leutnant Paval Reethe‡부관 파발 리테‡Teniente Paval Reethe‡Teniente Paval Reethe‡Le lieutenant Paval Reethe‡帕瓦尔·雷瑟上尉‡帕瓦爾·雷瑟上尉',
    nil,
    'Leve o Distintivo de Reethe ao Capitão Garrido Valente em Theramore.‡Отнесите значок Рита капитану Гаррану Ваймсу в Терамор.‡Bringt Reethes Abzeichen zu Hauptmann Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스에게 리테의 배지를 가져가야 합니다.‡Lleva el distintivo de Reethe al capitán Garran Vimes de Theramore.‡Lleva el distintivo de Reethe al capitán Garran Vimes de Theramore.‡Rapportez le badge de Reethe au capitaine Garran Vimaire, à Theramore.‡把雷瑟的徽章拿给塞拉摩的盖兰·维米斯队长。‡把雷瑟的徽章拿給塞拉摩的蓋蘭·維米斯上尉。',
  }
},
[27264] = {
  {
    'Tenente Paval Reethe‡Лейтенант Павал Рит‡Leutnant Paval Reethe‡부관 파발 리테‡Teniente Paval Reethe‡Teniente Paval Reethe‡Le lieutenant Paval Reethe‡帕瓦尔·雷瑟上尉‡帕瓦爾·雷瑟上尉',
    nil,
    'Descubra mais sobre Reethe consultando o Auxiliar Tesoran em Theramore.‡Поговорите о Рите с адъютантом Тезораном в Тераморе.‡Findet bei Adjutant Tesoran in Theramore mehr über Reethe heraus.‡테라모어에 있는 부관 테소렌으로부터 리테에 대해 알아내야 합니다.‡Averigua más sobre Reethe hablando con el ayudante Tesoran en Theramore.‡Averigua más sobre Reethe hablando con el ayudante Tesoran en Theramore.‡Trouvez plus de renseignements sur Paval Reethe auprès de l\'adjudant Tesoran, à Theramore.‡从塞拉摩的泰索兰副官那儿找出更多关于雷瑟的消息。‡從塞拉摩的泰索蘭副官那兒找出更多關於雷瑟的消息。',
  }
},
[27265] = {
  {
    'Lorde Grayson Quebrassombra‡Лорд Грейсон Тенелом‡Lord Grayson Schattenbruch‡그레이슨 섀도브레이커 경‡Lord Grisillo Quiebrasombras‡Lord Grisillo Quiebrasombras‡Le seigneur Grayson Brisombre‡格雷森·沙东布瑞克公爵‡格雷森·破影者領主',
    nil,
    'Fale com o Lorde Grayson Quebrassombra na Catedral da Luz, em Ventobravo.‡Поговорите с лордом Грейсоном Тенеломом в Соборе Света в Штормграде.‡Sprecht mit Lord Grayson Schattenbruch in der Kathedrale des Lichts in Sturmwind.‡스톰윈드 빛의 대성당에 있는 그레이슨 섀도브레이커 경과 대화해야 합니다.‡Habla con Lord Grisillo Quiebrasombras en la Catedral de la Luz de Ventormenta.‡Habla con Lord Grisillo Quiebrasombras en la Catedral de la Luz de Ventormenta.‡Allez parler au seigneur Grayson Brisombre dans la Cathédrale de la Lumière, à Hurlevent.‡跟暴风城圣光大教堂的格雷森·沙东布瑞克公爵谈一谈。‡到暴風城的聖光大教堂與格雷森·破影者領主說話。',
  }
},
[27266] = {
  {
    'O chamado de Wulf‡Зов Вульфа‡Wulf ruft‡울프의 부름‡La llamada de Wulf‡La llamada de Wulf‡Lou vous demande‡乌尔夫的召唤‡伍爾夫的呼叫',
    nil,
    'Fale com Wulf Hansreim em Ventobravo.‡Поговорите с Вульфом Хансраймом в Штормграде.‡Sprecht mit Wulf Hansreim in Sturmwind.‡스톰윈드에서 울프 한스라임과 대화해야 합니다.‡Habla con Wulf Hansreim en Ventormenta.‡Habla con Wulf Hansreim en Ventormenta.‡Allez Lou Hansreim à Hurlevent.‡跟暴风城的乌尔夫·哈斯雷姆谈一谈。‡到暴風城與伍爾夫·韓斯里姆說話。',
  }
},
[27267] = {
  {
    'Encontro com a AVIN‡Контакт с ШРУ‡Nehmt zum SI:7 Kontakt auf‡SI:7 접견‡Entrar en contacto con el IV:7‡Entrar en contacto con la IV:7‡Prise de contact avec le SI:7‡联系军情七处‡與軍情七處接洽',
    nil,
    'Fale com Osborne, o Homem da Madrugada, na Cidade Velha, em Ventobravo.‡Поговорите с Осборном Дитя Ночи в Старом Штормграде.‡Sprecht mit Osborne dem Nachtmensch in Sturmwinds Altstadt.‡스톰윈드 구 시가지에 있는 밤의 사나이 오스본과 대화해야 합니다.‡Habla con Osborne el Nocturno en el Casco Antiguo de Ventormenta.‡Habla con Osborne el Nocturno en el Casco Antiguo de Ventormenta.‡Parlez à Osborne l’Oiseau de nuit dans la Vieille ville, à Hurlevent.‡跟暴风城旧城区的夜行者奥斯伯谈一谈。‡到暴風城的舊城區與『夜行者』奧斯伯說話。',
  }
},
[27268] = {
  {
    'Depressa, para a Catedral‡Скорее в Собор‡Eilt zur Kathedrale‡서둘러 대성당으로‡A la catedral, deprisa‡A la catedral, deprisa‡Filez à la cathédrale‡赶往大教堂‡加速前往大教堂',
    nil,
    'Fale com a Alta-sacerdotisa Laurena na Catedral da Luz, em Ventobravo.‡Поговорите с верховной жрицей Лореной в Соборе Света в Штормграде.‡Sprecht mit Hohepriesterin Laurena in der Kathedrale des Lichts in Sturmwind.‡스톰윈드 빛의 대성당에 있는 대여사제 로레나와 대화해야 합니다.‡Habla con la suma sacerdotisa Laurena en la Catedral de la Luz de Ventormenta.‡Habla con la suma sacerdotisa Laurena en la Catedral de la Luz de Ventormenta.‡Parlez à la grande prêtresse Laurena dans la Cathédrale de la Lumière, à Hurlevent.‡跟暴风城圣光大教堂的高阶牧师劳瑞娜谈一谈。‡與暴風城聖光大教堂的高階牧師勞瑞娜交談。',
  }
},
[27269] = {
  {
    'O Templo da Lua‡Храм Луны‡Der Tempel des Mondes‡달의 신전‡El templo de la Luna‡El templo de la Luna‡Le temple de la Lune‡月神殿‡月神殿',
    nil,
    'Fale com Tyrande Murmuréolo no Templo da Lua, que fica em Darnassus.‡Поговорите с Тирандой Шелест Ветра в Храме Луны в Дарнасе.‡Sprecht mit Tyrande Wisperwind im Tempel des Mondes in Darnassus.‡다르나서스 달의 신전에 있는 티란데 위스퍼윈드와 대화해야 합니다.‡Habla con Tyrande Susurravientos en el Templo de la Luna, en Darnassus.‡Habla con Tyrande Susurravientos en el Templo de la Luna, en Darnassus.‡Allez voir Tyrande Murmevent au Temple de la Lune, à Darnassus.‡跟达纳苏斯月神殿的泰兰德·语风谈一谈。‡與達納蘇斯月神殿的高階女祭司，泰蘭妲·語風交談。',
  }
},
[27270] = {
  {
    'Audiência com o clarividente‡Встреча с прорицательницей‡Eine Audienz bei der Scharfseherin‡선견자 알현‡Una audiencia con la clarividente‡Una audiencia con la clarividente‡Une audience avec le long-voyant‡晋见先知‡會見先知安布洛',
    nil,
    'Fale com a Clarividente Umbrua no Barril Dourado, que fica no Distrito dos Anões em Ventobravo.‡Поговорите с прорицательницей Умбруа в таверне "Золотой бочонок", что в Квартале Дворфов Штормграда.‡Sprecht mit Scharfseherin Umbrua im Gasthaus Zum Goldenen Fass im Zwergendistrikt in Sturmwind.‡스톰윈드 드워프 지구에 있는 황금 술통 여관에서 선견자 움브루아와 대화해야 합니다.‡Habla con la clarividente Umbrua en el Tonel Dorado, en el Distrito de los Enanos de Ventormenta.‡Habla con la clarividente Umbrua en el Tonel Dorado, en el Distrito de los Enanos de Ventormenta.‡Parlez à la long-voyante Umbrua au Baril ambré, dans le quartier des Nains de Hurlevent.‡跟暴风城矮人区“黄金酒桶”店里的先知安布洛尔谈一谈。‡到暴風城矮人區的黃金酒桶與先知安布洛說話。',
  }
},
[27271] = {
  {
    'Viagem para o Sacrário dos Teurgos‡Путешествие в Башню магов‡Reise zum Sanktum des Magiers‡마법사의 성소로의 여정‡Viaje al Sagrario del Mago‡Viaje al Sagrario del Mago‡Voyage au sanctuaire du Sorcier‡前往巫师的殿堂‡巫師聖所之旅',
    nil,
    'Fale com Maginor Dumas no Sacrário dos Teurgos, que fica no Distrito dos Magos em Ventobravo.‡Поговорите с Магинором Дюма в Башне магов, что в квартале магов Штормграда.‡Sprecht mit Maginor Dumas im Sanktum des Magiers in Sturmwinds Magierviertel.‡스톰윈드 마법사 지구의 마법사의 성소에 있는 마지노르 뒤마와 대화해야 합니다.‡Habla con Maginor Dumas en el Sagrario del Mago, en el Barrio de los Magos de Ventormenta.‡Habla con Maginor Dumas en el Sagrario del Mago, en el Barrio de los Magos de Ventormenta.‡Parlez à Maginor Dumas dans le Sanctuaire du Sorcier, dans le Quartier des Mages de Hurlevent.‡前往暴风城法师区的巫师圣殿，跟玛吉诺·仲马谈一谈。‡到暴風城法師區的巫師聖所與瑪姬諾·仲馬說話。',
  }
},
[27272] = {
  {
    'Convocação de Joyce‡Послание от Демизетты‡Demisette schickt Kunde‡드미제트의 부름‡Un mensaje de Demisette‡Un mensaje de Demisette‡Demisette vous fait mander‡德米赛特的邀请‡德米賽特捎來的信息',
    nil,
    'Fale com Joyce Lopes no Cordeiro Imolado, que fica no Distrito dos Magos em Ventobravo.‡Поговорите с Демизеттой Клойс в таверне "Забитый ягненок" в квартале магов Штормграда.‡Sprecht mit Demisette Cloyce im Gasthaus "Zum Geschlachteten Lamm" in Sturmwinds Magierviertel.‡스톰윈드 마법사 지구에 있는 어둠의 희생양 선술집에서 드미제트 클로이스와 대화해야 합니다.‡Habla con Demisette Cloyce en El Cordero Degollado, en el Barrio de los Magos de Ventormenta.‡Habla con Demisette Cloyce en El Cordero Degollado, en el Barrio de los Magos de Ventormenta.‡Parlez à Demisette Cloyce dans l’Agneau assassiné, dans le Quartier des Mages de Hurlevent.‡进入暴风城法师区的已宰的羔羊店铺，跟德米赛特·克劳斯谈一谈。‡到暴風城法師區的已宰的羔羊與德米賽特·克勞斯說話。',
  }
},
[27273] = {
  {
    'Convite da Clareira da Lua‡Приглашение в Лунную поляну‡Eine Einladung aus Mondlichtung‡달숲으로부터의 초대‡Una invitación del Claro de la Luna‡Una invitación del Claro de la Luna‡Une invitation pour Reflet-de-Lune‡来自月光林地的邀请‡月光林地的邀請',
    nil,
    'Fale com Loganaar no Refúgio Noturno, que fica na Clareira da Lua.‡Поговорите с Логанааром в Ночной Гавани в Лунной поляне.‡Sprecht mit Loganaar in Nachthafen in Mondlichtung.‡달숲에 있는 밤의 안식처에서 로가나르와 대화해야 합니다.‡Habla con Loganaar en Amparo de la Noche, en Claro de la Luna.‡Habla con Loganaar en Amparo de la Noche, en Claro de la Luna.‡Parlez à Loganaar à Havrenuit, à Reflet-de-Lune.‡跟月光林地永夜港的洛甘纳尔谈一谈。‡到月光林地的永夜港與洛甘納爾說話。',
  }
},
[27274] = {
  {
