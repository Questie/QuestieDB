[32706] = {
  {
    'Aliados nas sombras‡Союзники, скрывающиеся в тенях‡Verbündete in den Schatten‡음영 속의 동지‡Aliados en las sombras‡‡Des alliés dans l’ombre‡暗影中的盟友‡',
    nil,
    'Fale com Taran Zhu no Vale Desolado. Uma‡Поговорите с Тажанем Чжу в Мрачной пещере.‡Sprecht in der Tristen Höhle mit Taran Zhu.‡싸늘한 동굴에 있는 타란 주와 대화해야 합니다. 레벨 32 천둥의 섬‡Habla con Taran Zhu en la Fosa Lúgubre.‡‡Parlez à Taran Zhu au Morne Creux.‡在阴冷洞窟与祝踏岚交谈。‡',
  }
},
[32707] = {
  {
    'Segredos na Ilha do Trovão‡Секреты острова Грома‡Geheimnisse auf der Insel des Donners‡천둥의 섬에 숨겨진 비밀‡Secretos de la Isla del Trueno‡‡Secrets sur l’île du Tonnerre‡雷神岛的秘密‡',
    nil,
    'Recupere 3 Pedras Rituais Shan\'ze. Essas pedras são muito raras, e pode levar algum tempo para reuni-las. Uma‡Найдите три ритуальных камня Шань\'цзэ. Эти камни – большая редкость, на то, чтобы найти их, может уйти немало времени.‡Beschafft Euch 3 Ritualsteine der Shan\'ze. Die Steine sind sehr selten, und es könnte eine Weile dauern, sie zu sammeln.‡샨쩌 의식용 돌을 3개 획득해야 합니다. 이 돌은 매우 희귀하므로 모으는 데 시간이 좀 걸릴지도 모릅니다.‡Recupera 3 piedras de ritual de Shan\'ze. Estas piedras son muy raras y puede que te lleve tiempo encontrarlas.‡‡Récupérez 3 Pierres rituelles shan’ze. Ces pierres sont très rares, alors il vous faudra peut-être du temps pour les rassembler. Un(e) quête.‡找回3块山泽仪式石。这些石头极为稀少，且需要花费一定时间才能找齐。‡',
  }
},
[32708] = {
  {
    'Montando a armadilha‡Ловушка для могу‡Die Falle stellen‡덫 놓기‡Colocar la trampa‡‡Tendre le piège‡布设陷阱‡',
    nil,
    'Use 3 Pedras Rituais Shan\'ze para atrair um Campeão do Rei Trovão e depois mate-o. Uma‡Используйте 3 ритуальных камня Шань\'цзэ, чтобы привлечь внимание защитника Властелина Грома, а затем убейте его.‡Benutzt 3 Ritualsteine der Shan\'ze, um einen Champion des Donnerkönigs herbeizurufen, und tötet ihn.‡샨쩌 의식용 돌 3개를 사용하여 천둥왕의 용사를 불러낸 후 처치해야 합니다. 레벨 32 천둥의 섬‡Usa 3 piedras de ritual de Shan\'ze para invocar a un campeón del Rey del Trueno y luego matarlo.‡‡Utilisez 3 Pierres rituelles shan’ze pour appeler un Champion du roi-tonnerre, puis tuez-le.‡用3块山泽仪式石召唤雷电之王的勇士，然后将他消灭。‡',
  }
},
[32709] = {
  {
    'Aliados nas sombras‡Союзники, скрывающиеся в тенях‡Verbündete in den Schatten‡음영 속의 동지‡Aliados en las sombras‡‡Des alliés dans l’ombre‡暗影中的盟友‡',
    nil,
    'Fale com Taran Zhu no Vale Desolado. Uma‡Поговорите с Тажанем Чжу в Мрачной пещере.‡Sprecht in der Tristen Höhle mit Taran Zhu.‡싸늘한 동굴에 있는 타란 주와 대화해야 합니다. 레벨 32 천둥의 섬‡Habla con Taran Zhu en la Fosa Lúgubre.‡‡Parlez à Taran Zhu au Morne Creux.‡在阴冷洞窟与祝踏岚交谈。‡',
  }
},
[32710] = {
  {
    'Algum futum‡Я чую неприятности!‡Was riecht denn hier so?‡심한 악취의 무언가가 코앞에‡Algo huele a chamusquina‡‡Quelque chose d’horrible dans l’air‡酝酿中的腐化‡',
    nil,
    'Procure e destrua Carne\'rok, o Doente. Uma‡Найдите и убейте Мясо\'рока Прокаженного.‡Findet und vernichtet Fleisch\'rok den Verpesteten.‡감염된 플레시록을 찾아 처치해야 합니다. 레벨 35 천둥의 왕좌‡Busca y destruye a Flesh\'rok el Enfermo.‡‡Trouvez et éliminez Carne’rok le Malade.‡找到并消灭感染者弗赖什鲁克。‡',
  }
},
[32711] = {
  {
    'Agonia e Anima‡Агония и анима‡Angst und Anima‡고통과 령‡Agonía y ánima‡‡Agonie et animus‡痛苦与心能‡',
    nil,
    'Mate o Arquirritualista Kelada. Uma‡Убейте предводителя ритуалистов Келада.‡Tötet Erzritualist Kelada.‡대의식술사 켈라다를 처치해야 합니다. 레벨 35 천둥의 왕좌‡Mata al archiritualista Kelada.‡‡Tuez l’Archiritualiste Kelada.‡击败大祭师克拉达。‡',
  }
},
[32712] = {
  {
    'Zao\'cho o Malévolo‡Зао\'чо Кровожадный‡Zao\'cho der Hinterhältige‡사악한 짜오초‡Zao\'cho el Malvado‡‡Zao’cho le Malfaisant‡邪恶的曹卓‡',
    nil,
    'Mate Zao\'cho. Uma‡Убейте Зао\'чо.‡Tötet Zao\'cho.‡짜오초를 처치해야 합니다. 레벨 35 천둥의 왕좌‡Mata a Zao\'cho.‡‡Tuez Zao’cho.‡击败曹卓。‡',
  }
},
[32713] = {
  {
    'Pedras caem, pessoas morrem‡Камни губят все живое‡Ton, Steine, Sterben‡바위가 떨어지면 누군가 죽는다‡Cuando caen rocas, la gente muere‡‡Chutes de pierres et dernier soupir‡石落人亡‡',
    nil,
    'Mate o Horror de Pedra. Uma‡Уничтожьте скальный ужас.‡Tötet Krankenstein.‡공포의 바위를 처치해야 합니다. 레벨 35 천둥의 왕좌‡Mata al horror rocoso.‡‡Tuez l’Horreur rocheuse.‡击败岩石恐魔。‡',
  }
},
[32714] = {
  {
    'Domando a tempestade‡Приручение бури‡Den Sturm besänftigen‡폭풍 길들이기‡Domar la tempestad‡‡La tempête apprivoisée‡力压暴风雨‡',
    nil,
    'Mate No\'kah Manda-procela. Uma‡Убейте Но\'ку Буревестника.‡Tötet No\'ku Sturmsprecher.‡폭풍예언자 노쿠를 처치해야 합니다. 레벨 35 천둥의 왕좌‡Mata al orador de la tormenta No\'ku.‡‡Tuez No’ku Parle-Tempête.‡击败颂风者诺库。‡',
  }
},
[32715] = {
  {
    'Réquiem para uma rainha‡Реквием по королеве‡Requiem für eine Königin‡여왕을 위한 진혼곡‡Réquiem por una reina‡‡Requiem pour une reine‡皇后的安魂曲‡',
    nil,
    'Faça com que Monara finalmente descanse. Uma‡Упокойте Монару.‡Bettet Monara zur ewigen Ruhe.‡모나라를 처치해야 합니다. 레벨 35 천둥의 왕좌‡Haz que Monara descanse en paz.‡‡Donnez le repos à Monara.‡让莫纳拉安息。‡',
  }
},
[32716] = {
  {
    'Olhos do Rei Trovão‡Глаза Властелина Грома‡Augen des Donnerkönigs‡천둥왕의 눈‡Los ojos del Rey del Trueno‡‡Les yeux du roi-tonnerre‡雷电之王的眼目‡',
    nil,
    'Derrote a emboscada! Uma‡Победите засаду!‡Setzt Euch gegen den Überfall zur Wehr!‡기습 공격을 막아야 합니다! 레벨 35 천둥의 왕좌‡¡Sal &lt;victorioso/victoriosa&gt; de la emboscada!‡‡Contrez l’embuscade !‡击败伏兵！‡',
  }
},
[32717] = {
  {
    'REUSE ME‡REUSE ME‡RECYCELT MICH‡‡REUSE ME‡‡RÉUTILISER‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[32720] = {
  {
    'Escolha sua missão‡Выбери задание‡Wählt Eure Aufgabe‡임무 선택‡Elige tu tarea‡‡Choisissez votre affectation‡‡',
    nil,
    'Mate 10 unidades do Kirin Tor na Ilha do Trovão. Uma‡Убейте 10 последователей Кирин-Тора или игроков на острове Грома.‡Tötet 10 Einheiten oder Spielercharaktere der Kirin Tor auf der Insel des Donners.‡천둥의 섬에서 키린 토 병력 또는 플레이어 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 unidades o jugadores del Kirin Tor en la Isla del Trueno.‡‡Tuez 10 unités du Kirin Tor ou personnages-joueurs sur l’Île du Tonnerre.‡‡',
  }
},
[32721] = {
  {
    'Escolha sua missão‡Выбери задание‡Wählt Eure Aufgabe‡임무 선택‡Elige tu tarea‡‡Choisissez votre affectation‡‡',
    nil,
    'Mate 10 unidades do Kirin Tor na Ilha do Trovão. Uma‡Убейте 10 последователей Кирин-Тора или игроков на острове Грома.‡Tötet 10 Einheiten oder Spielercharaktere der Kirin Tor auf der Insel des Donners.‡천둥의 섬에서 선리버 병력 또는 플레이어 10명을 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 10 unidades o jugadores del Kirin Tor en la Isla del Trueno.‡‡Tuez 10 unités du Kirin Tor ou personnages-joueurs sur l’Île du Tonnerre.‡‡',
  }
},
[32722] = {
  {
    'Forja adiante!‡Впереди кузня!‡Schmiede voraus!‡제련소로!‡¡Hacia la forja!‡‡Forge droit devant !‡近在眼前！‡',
    nil,
    'Mate o Mestre da Forja e pegue um Fragmento de Códice do Moldacarne Hoku na Ilha do Trovão. Uma‡Убейте главного кузнеца и получите фрагмент кодекса от Плотореза Хоку на острове Грома.‡Tötet den Meister der Schmiede und sammelt ein Kodexfragment von Fleischschmied Hoku auf der Insel des Donners ein.‡천둥의 섬에 있는 제련소 대장 코타를 처치하고 살덩이창조자 호쿠로부터 전서 조각을 수집해야 합니다.‡Mata al maestro de la forja y recoge un fragmento de códice del modelador de carne Hoku en la Isla del Trueno.‡‡Tuez le Maître de la forge et récupérez un Fragment de codex sur le Façonneur de chair Hoku, sur l’Île du Tonnerre.‡在雷神岛上消灭锻造大师，然后从塑肌者霍古身上找到一块法典碎片。‡',
  }
},
[32723] = {
  {
    'reuse me‡reuse me‡recycelt mich‡재사용하시오‡reuse me‡‡reuse me‡reuse me‡',
    nil,
    'Mate o Mestre da Forja e pegue um Fragmento de Códice do Guarda-pórtico Mogu na Ilha do Trovão. Uma‡Убейте главного кузнеца и получите фрагмент кодекса от стража врат могу на Острове Грома.‡Tötet den Meister der Schmiede und sammelt ein Kodexfragment vom Mogutorhüter auf der Insel des Donners ein.‡천둥의 섬에 있는 제련소의 우두머리를 처치한 뒤 모구 문지기에게서 모구 전서 조각을 수집해야 합니다.‡Mata al maestro de la forja y recoge un fragmento de códice del guardián mogu en la Isla del Trueno.‡‡Tuez le Maître de la forge et récupérez un Fragment de codex sur le Gardien de la porte mogu, sur l’Île du Tonnerre.‡在雷神岛上消灭锻造大师，然后从魔古看门人身上找到一块法典碎片。‡',
  }
},
[32724] = {
  {
    'Forja adiante!‡Впереди кузня!‡Schmiede voraus!‡제련소로!‡¡Hacia la forja!‡‡Forge droit devant !‡近在眼前！‡',
    nil,
    'Mate o Mestre da Forja e pegue um Fragmento de Códice do Guarda-pórtico Mogu na Ilha do Trovão. Uma‡Убейте главного кузнеца и получите фрагмент кодекса от стража врат могу на острове Грома.‡Tötet den Meister der Schmiede und sammelt ein Kodexfragment vom Mogutorhüter auf der Insel des Donners ein.‡천둥의 섬에 있 제련소 대장 코타를 처치하고 모구 문지기인 살덩이창조자 호쿠로부터 전서 조각을 수집해야 합니다.‡Mata al maestro de la forja y recoge un fragmento de códice del guardián mogu en la Isla del Trueno.‡‡Tuez le Maître de la forge et récupérez un Fragment de codex sur le Gardien de la porte mogu, sur l’Île du Tonnerre.‡在雷神岛上消灭锻造大师，然后从魔古看门人身上找到一块法典碎片。‡',
  }
},
[32725] = {
  {
    'FLAG - Bruxo - Chegou a Kanrethad‡FLAG - Warlock - Reached Kanrethad‡FLAG - Warlock - Reached Kanrethad‡플래그 - 흑마법사 - 칸레타드에게 도착‡FLAG - Warlock - Reached Kanrethad‡‡FLAG - Warlock - Kanrethad atteint‡FLAG - Warlock - Reached Kanrethad‡',
    nil,
    'Floresta de Jade de‡‡‡비취 숲‡‡‡‡‡',
  }
},
[32726] = {
  {
    'Quer dizer que você quer ser ferreiro...‡Так ты хочешь быть кузнецом...‡Ihr wollt also Schmied werden…‡대장장이가 되고 싶다면...‡En casa del herrero...‡‡Alors vous voulez apprendre à forger…‡这么说，你想当铁匠……‡',
    nil,
    'Crie uma Chave-mestra Fantasma. Para isso, obtenha pelo menos 500 pontos de habilidade em ferraria. Se você quiser treinar com matéria-prima pandariana, um projeto de treinamento apropriado ao seu nível de habilidade pode ser aprendido com Jorunga Casco de Pedra.‡Создайте призрачную отмычку, достигнув уровня навыка кузнечного дела, равного 500, и принесите эту вещь своему учителю. Если вы хотите совершенствоваться, используя пандаренские материалы, изучите соответствующие вашему уровню учебные чертежи у Джорунги Каменное Копыто.‡Erschafft einen geisterhaften Dietrich, indem Ihr 500 Fertigkeitspunkte in Schmiedekunst erlangt. Falls Ihr Euch mithilfe von Pandarenmaterialien in der Schmiedekunst üben wollt, könnt Ihr von Jorunga Steinhuf ein Eurer Fertigkeitsstufe angemessenes Ausbildungsprojekt erhalten.‡대장기술 숙련도를 최소 500 달성하여 유령 들린 해골 열쇠를 제작해야 합니다. 판다리아 재료를 써서 훈련하고 싶다면 조룬가 스톤후프에게서 자기 수준에 맞는 훈련용 과제를 배울 수 있습니다.‡Crea una llave esqueleto fantasmal al llegar al menos al nivel 500 de habilidad en herrería. Si quieres entrenarte con material pandaren, puedes obtener un proyecto de instrucción adecuado a tu nivel de habilidad de Jorunga Pezuña Firme.‡‡Créez un Passe-partout fantomatique après avoir atteint une compétence de 500 en forge. Si vous souhaitez vous entraîner en utilisant des matériaux pandarens, vous pouvez apprendre un Ouvrage approprié à votre niveau de compétence auprès de Jorunga Sabot-de-Pierre.‡锻造技能达到500点后制作出一把幽冥万能钥匙。如果你想通过熊猫人材料进行训练，可以去找贾鲁高·石蹄学习与你当前技能等级相适应的训练项目。‡',
  }
},
[32727] = {
  {
    'Contribuiu para Rastreamento de Missão Porcentagem do Servidor Diária‡Contributed to Server Percentage Daily Tracking Quest‡Contributed to Server Percentage Daily Tracking Quest‡서버 퍼센티지 기여 일일 추적 퀘스트‡Contributed to Server Percentage Daily Tracking Quest‡‡Contributed to Server Percentage Daily Tracking Quest‡Contributed to Server Percentage Daily Tracking Quest‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32728] = {
  {
    'O Paço dos Ossos‡Двор Костей‡Der Hof der Knochen‡망자의 궁정‡El Patio de los Huesos‡‡La cour des Ossements‡白骨庭院‡',
    nil,
    'Encontre o Grão-Magíster Rommath perto do Paço dos Ossos. Uma‡Разыщите верховного магистра Роммата возле Двора Костей.‡Findet Großmagister Rommath außerhalb des Hofs der Knochen.‡망자의 궁정 밖에 있는 대마법학자 롬매스를 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra al gran magister Rommath en las afueras de El Patio de los Huesos.‡‡Retrouvez le Grand magistère Rommath à l’extérieur de la Cour des Ossements.‡在白骨庭院外面找到大法师罗曼斯。‡',
  }
},
[32729] = {
  {
    'Za\'tual‡За\'Туал‡Za\'Tual‡자투알‡Za\'Tual‡‡Za’Tual‡赞图尔‡',
    nil,
    'Encontre Halduron Asaluz perto de Za\'Tual. Uma‡Разыщите Халдарона Светлое Крыло снаружи За\'Туала.‡Findet Halduron Wolkenglanz außerhalb von Za\'Tual.‡자투알 외곽에서 할두런 브라이트윙을 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra a Halduron Alasol en las afueras de Za\'Tual.‡‡Retrouvez Halduron Luisaile à l’extérieur de Za’Tual.‡在赞图尔外面找到哈杜伦·明翼。‡',
  }
},
[32730] = {
  {
    'Penhasco Ihgaluk‡Утесы Ихгалук‡Ihgalukklamm‡이갈룩 바위산‡Risco Ihgaluk‡‡La combe d’Ihgaluk‡伊瓜鲁克峭壁‡',
    nil,
    'Encontre o Arquimago Aethas Fendessol, perto do Penhasco Ihgaluk. Uma‡Разыщите верховного мага Этаса Похитителя Солнца возле утесов Ихгалук. Награда: .‡Findet Erzmagier Aethas Sonnenhäscher an der Ihgalukklamm.‡이갈룩 바위산 밖에 있는 대마법사 에이타스 선리버를 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra al archimago Aethas Atracasol a las afueras del Risco Ihgaluk.‡‡Retrouvez l’Archimage Aethas Saccage-Soleil à l’extérieur de la Combe d’Ihgaluk.‡在伊瓜鲁克峭壁外面找到大法师艾萨斯·夺日者。‡',
  }
},
[32731] = {
  {
    'O Paço dos Ossos‡Двор Костей‡Der Hof der Knochen‡망자의 궁정‡El Patio de los Huesos‡‡La cour des Ossements‡白骨庭院‡',
    nil,
    'Encontre Nasari Albaneve perto do Paço dos Ossos. Uma‡Разыщите Нараси Снежную Зарю возле Двора Костей.‡Findet Narasi Schneedämmerung außerhalb des Hofs der Knochen.‡망자의 궁정 밖에 있는 나라시 스노우돈을 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra a Narasi Albanieve en El Patio de los Huesos.‡‡Retrouvez Narasi Aubeneige à l’extérieur de la Cour des Ossements.‡在白骨庭院外面找到纳莱丝·晨雪。‡',
  }
},
[32732] = {
  {
    'Penhasco Ihgaluk‡Утесы Ихгалук‡Ihgalukklamm‡이갈룩 바위산‡Risco Ihgaluk‡‡La combe d’Ihgaluk‡伊瓜鲁克峭壁‡',
    nil,
    'Encontre a Arquimaga Modera, perto do Penhasco Ihgaluk. Uma‡Разыщите верховного мага Модеру возле утесов Ихгалук.‡Findet Erzmagierin Modera an der Ihgalukklamm.‡이갈룩 바위산 밖에 있는 대마법사 모데라를 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra a la archimaga Modera a las afueras del Risco Ihgaluk.‡‡Retrouvez l’Archimage Modera à l’extérieur de la Combe d’Ihgaluk.‡在伊瓜鲁克峭壁外面找到大法师茉德拉。‡',
  }
},
[32733] = {
  {
    'Za\'tual‡За\'Туал‡Za\'Tual‡자투알‡Za\'Tual‡‡Za’Tual‡赞图尔‡',
    nil,
    'Encontre o Arquimago Lan\'dalock, perto de Za\'Tual. Uma‡Разыщите верховного мага Лан\'далока рядом с За\'Туалом.‡Findet Erzmagier Lan\'dalock außerhalb von Za\'Tual.‡자투알 외곽에 있는 대마법사 랜달록을 찾아야 합니다. 레벨 32 천둥의 섬‡Encuentra al archimago Lan\'dalock en las afueras de Za\'Tual.‡‡Retrouvez l’Archimage Lan’dalock à l’extérieur de Za’Tual.‡在赞图尔外面找到大法师兰达洛克。‡',
  }
},
