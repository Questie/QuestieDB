    nil,
  }
},
[1000] = {
  {
    '‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡',
    nil,
    '‡Обратитесь к верховному друиду Хамуулу Руническому Тотему на Вершине Старейшин Громового Утеса по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht auf der Anhöhe der Ältesten in Donnerfels mit dem Erzdruiden Hamuul Runentotem über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡썬더 블러프의 장로의 봉우리에 있는 대드루이드 하뮬 룬토템을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대해 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l\'Archidruide Hamuul Totem-Runique, sur la Cime des Anciens des Pitons-du-Tonnerre. Évoquer l\'appel du Cercle cénarien concernant l\'exploration des frontières de Kalimdor.‡与雷霆崖长者高地的大德鲁伊哈缪尔·符文图腾谈一谈关于议会号召部落成员探索卡利姆多大陆的事情。‡',
  }
},
[1001] = {
  {
    'Caixazorra 411‡Жужжалка 411‡Dröhnkiste 411‡윙윙상자 411‡La caja mecánica 411‡La caja mecánica 411‡Bigobox 411‡传声盒411号‡傳聲盒411號',
    nil,
    'Recolha 3 Olhos de Mangual dos Manguais da Costa Negra no fundo do mar, perto da Caixazorra 411.‡Добудьте 3 глаза крепкозуба с крепкозубов Темных берегов, которые водятся в море неподалеку от Жужжалки 411.‡Besorgt Euch 3 Drescheraugen von den Dunkelküstendreschern im tiefen Meer in der Nähe der Dröhnkiste 411.‡윙윙상자 411 근처 깊은 바다에 있는 어둠해안 트레샤돈에게서 트레샤돈의 눈 3개를 모아야 합니다.‡Consigue 3 ojos de trillador de los trilladores de Costa Oscura en las profundidades del mar, cerca de la caja mecánica 411.‡Consigue 3 ojos de trillador de los trilladores de Costa Oscura en las profundidades del mar, cerca de la caja mecánica 411.‡Rassembler 3 Yeux de batteur de Sombrivage au fond de la mer, près de la Bigobox 411.‡从位于传声盒411号附近的深海中收集3颗黑海岸蛇颈龙的眼球。‡從位於傳聲盒411號附近的深海中收集3顆黑海岸蛇頸龍的眼球。',
  }
},
[1002] = {
  {
    'Caixazorra 323‡Жужжалка 323‡Dröhnkiste 323‡윙윙상자 323‡La caja mecánica 323‡La caja mecánica 323‡Bigobox 323‡传声盒323号‡傳聲盒323號',
    nil,
    'Recolha 6 Presas de Espreitaluna e deposite-as na Caixazorra 323.‡Добудьте 6 клыков лунопарда и поместите их в "Жужжалку 323".‡Sammelt 6 Mondpirscherfangzähne und baut sie in Dröhnkiste 323 ein.‡달표범 송곳니 6개를 모아 윙윙상자 323에 넣어야 합니다.‡Reúne 6 colmillos de Acechalunas y colócalos en la caja mecánica 323.‡Reúne 6 colmillos de Acechalunas y colócalos en la caja mecánica 323.‡Trouver 6 Crocs de traquelune et les mettre dans la Bigobox 323.‡收集6颗月夜猛虎的牙齿，把它们放进传声盒323号。‡收集6顆月夜猛虎的牙齒，把它們放進傳聲盒323號。',
  }
},
[1003] = {
  {
    'Caixazorra 525‡Жужжалка 525‡Dröhnkiste 525‡윙윙상자 525‡La caja mecánica 525‡La caja mecánica 525‡Bigobox 525‡传声盒525号‡傳聲盒525號',
    nil,
    'Recolha 4 Escalpos Grisalhos dos Ursocardos Grisalhos ao sul de Auberdine e deposite-os na Caixazorra 525.‡Соберите 4 седых скальпа с седых колючешерстных медведей к югу от Аубердина и положите их в Жужжалку 525.‡Sammelt 4 ergraute Skalps von ergrauten Distelbären südlich von Auberdine und legt sie in die Dröhnkiste 525.‡아우버다인 남쪽에 있는 엉겅퀴불곰에게서 불곰 가죽 4개를 모아 윙윙상자 525에 집어넣어야 합니다.‡Consigue 4 cueros cabelludos grisáceos de los osos cardo grisáceos del sur de Auberdine y colócalos en la caja mecánica 525.‡Consigue 4 cueros cabelludos grisáceos de los osos cardo grisáceos del sur de Auberdine y colócalos en la caja mecánica 525.‡Se procurer 4 Scalps vieillis sur de Vieux ours des chardons au sud d\'Auberdine et les placer dans la Bigobox 525.‡收集4块灰色头皮，然后把它们放在传声盒525号中。‡收集4塊灰色頭皮，然後把它們放在傳聲盒525號中。',
  }
},
[1004] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Platô dos Anciãos, no Penhasco do Trovão, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Обратитесь к верховному друиду Хамуулу Руническому Тотему на Вершине Старейшин Громового Утеса по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht auf der Anhöhe der Ältesten in Donnerfels mit dem Erzdruiden Hamuul Runentotem über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡썬더 블러프, 장로의 봉우리에 있는 대드루이드 하뮬 룬토템을 찾아가 세나리온 의회의 칼림도어 개척 지원자 모집에 대해 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l\'archidruide Hamuul Totem-runique, sur la Cime des Anciens des Pitons du Tonnerre. Évoquer l\'appel du Cercle cénarien concernant l\'exploration des frontières de Kalimdor.‡与雷霆崖长者高地的大德鲁伊哈缪尔·符文图腾谈一谈关于议会号召部落成员探索卡利姆多大陆的事情。‡與雷霆崖長者高地的大德魯伊哈繆爾·符文圖騰談一談關於議會號召部落成員探索卡林多大陸的事情。',
  }
},
[1005] = {
  {
    '‡Шныряющие за стеной‡Was dahinter lauert‡문 너머에 있는 적‡Lo que acecha detrás‡Lo que acecha detrás‡Ce qui se cache au-delà‡逃出影牙城堡‡',
