[14291] = {
  {
    'Quanto mais, melhor‡Спасение в единстве‡Je mehr, desto sicherer‡뭉쳐야 산다‡Cuantos más, mejor‡Cuantos más, mejor‡Le groupe apporte la sécurité‡人多安全‡眾人的庇護',
    nil,
    'Fale com o Rei Genn Greymane no Distrito Militar.‡Поговорите с королем Генном Седогривом в Военном квартале.‡Sprecht mit König Genn Graumähne im Militärviertel.‡군사 지구에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Parlez au Roi Genn Grisetête dans le Secteur Militaire.‡跟军事区的吉恩·格雷迈恩国王谈一谈。‡到軍事區和吉恩·葛雷邁恩國王談話。',
  }
},
[14292] = {
  {
    'O inimigo do nosso inimigo‡Враг наших врагов…‡Der Feind unserer Feinde‡적군의 적군‡El enemigo de tu enemigo‡El enemigo de tu enemigo‡L\'ennemi de notre ennemi‡我们敌人的敌人‡我們敵人的敵人',
    nil,
    'A Pesquisadora Cenariana Korrah quer que você fale com o Lorde Hydronis.‡По поручению кенарийской исследовательницы Корры побеседуйте с Лордом Гидронисом.‡Korrah, Forscher des Cenarius, will, dass Ihr mit Lord Hydronis sprecht.‡세나리온 연구원 코라가 군주 하이드로니스와 대화해 달라고 했습니다.‡La investigadora Cenarion Korrah quiere que hables con Lord Hydronis.‡La investigadora Cenarion Korrah quiere que hables con Lord Hydronis.‡Korrah, la chercheuse cénarienne, vous a demandé de parler au Seigneur Hydronis.‡塞纳里奥研究员库拉要你跟元素勋爵海卓尼斯谈一谈。‡塞納里奧研究員柯拉要你去和海德洛尼斯領主談談。',
  }
},
[14293] = {
  {
    'O resgate do alquimista Aranas‡Спасти Креннана Аранаса‡Rettet Krennan Aranas‡크레난 아라나스 구출‡Salvar a Krennan Aranas‡Salvar a Krennan Aranas‡Sauver Krennan Aranas‡救援克雷南·阿朗纳斯‡拯救卡瑞南•阿拉納斯',
    nil,
    'Resgate Krennan Aranas.‡Спасите Креннана Аранаса.‡Rettet Krennan Aranas.‡크레난 아라나스를 구출해야 합니다.‡Rescata a Krennan Aranas en el Distrito Militar.‡Rescata a Krennan Aranas en el Distrito Militar.‡Portez secours à Krennan Aranas.‡营救克雷南·阿朗纳斯。‡援救卡瑞南•阿拉納斯。',
  }
},
[14294] = {
  {
    'Hora de reagrupar‡Время перегруппироваться‡Neu formieren‡재정비의 시간‡Hora de reagruparse‡Hora de reagruparse‡Il est temps de se regrouper‡重整旗鼓‡重新整隊',
    nil,
    'Fale com o Rei Genn Greymane no Paço Greymane, na cidade de Guilnéas.‡Поговорите с королем Генном Седогривом на площади Седогрива в Гилнеасе.‡Sprecht mit König Genn Graumähne im Graumähnenhof in Gilneas.‡길니아스 시의 그레이메인 궁정에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Patio de Cringris en la Ciudad de Gilneas.‡Habla con el rey Genn Cringris en el Patio de Cringris en la Ciudad de Gilneas.‡Parlez au roi Genn Grisetête dans la Cour de Grisetête, dans la ville de Gilnéas.‡跟吉尔尼斯城格雷迈恩皇家庭院的吉恩·格雷迈恩国王谈一谈。‡在吉爾尼斯城的葛雷邁恩宮廷和吉恩·葛雷邁恩國王談話。',
  }
},
[14295] = {
  {
    'Irmãs do mar‡Сестры моря‡Schwestern des Meeres‡바다 마녀‡Hermanas del mar‡Hermanas del mar‡Les sœurs de la mer‡海的姐妹‡海中姊妹',
    nil,
    'Incapacite as pedras de poder e mate Lady Silisthra e Lady Vesthra.‡Убейте леди Силистру и леди Вестру, уничтожив их камни силы.‡Tötet Lady Silisthra und Lady Vesthra, indem Ihr ihre Kraftsteine deaktiviert.‡마녀 실리스트라와 마녀 베스트라의 마법석을 파괴하고 그들을 처치해야 합니다.‡Mata a Lady Silisthra y a Lady Vesthra inutilizando sus piedras de energía.‡Mata a Lady Silisthra y a Lady Vesthra inutilizando sus piedras de energía.‡Tuez Dame Silisthra et Dame Vesthra en désactivant leurs pierres de puissance.‡破坏希莉丝拉女士和薇丝拉女士的能量石，杀了她们。‡摧毀希莉斯瑟拉女士和維絲索拉女士的能量石，然後殺死她們。',
  }
},
[14296] = {
  {
    'Olhe por onde pisa‡Смотри, куда идешь‡Stolpert nicht‡제대로 밟기‡Vigila tus pasos‡Vigila tus pasos‡Attention à la marche‡当心脚下‡當心你的腳步',
    nil,
    'Receba 6 Cargas Energizadas dos Conduítes de Energia à medida que você subir até o topo do Pináculo Arcano.‡Получите 6 энергетических зарядов, прикасаясь к силовым проводам при подъеме к Волшебному замку.‡Empfangt 6 Energieladungen von den Energieleitungen, während ihr zum Gipfel der Arkanen Spitze gelangt.‡비전 봉우리를 오르는 동안 마력 수송관에서 마력을 6번 충전해야 합니다.‡Recibe 6 descargas de energía de los conductos de energía mientras asciendes a la cima del Pináculo Arcano.‡Recibe 6 descargas de energía de los conductos de energía mientras asciendes a la cima del Pináculo Arcano.‡Absorbez 6 Charges énergisées en montant le long des Conduits d’énergie jusqu’à la Cime des Arcanes.‡在通往奥术之巅顶部的路上借助能量传导器收集6束能量束。‡在登上秘法之巔頂部時從能量噴泉那裡取得6次充能。',
  }
},
[14297] = {
  {
    'Alforria!‡За освобождение‡Freiheitskämpfer‡일꾼 구출작전‡Pro liberación‡Pro liberación‡Pro-libération‡提前解放‡解放主義',
    nil,
    'Use as Chaves Feitas de Ferro dos sectários e draconianos e liberte 4 Trabalhadores Goblins na Serra Zibelina.‡Воспользуйтесь железнокованными ключами сектантов и драконов, чтобы освободить 4 гоблинов-рабочих на Черной гряде.‡Verwendet die schmiedeeisernen Schlüssel der Kultisten und der Drachenkin, um 4 Arbeiter der Goblins auf dem Säbelrücken zu befreien.‡이교도와 용족에게서 철세공 열쇠를 구한 다음 검은담비 마루에 붙잡혀 있는 고블린 일꾼 4명을 구출해야 합니다.‡Utiliza las llaves de hierro forjado de los cultores y de los dragonantes para liberar a 4 obreros goblin en Cumbre Cebellina.‡Utiliza las llaves de hierro forjado de los cultores y de los dragonantes para liberar a 4 obreros goblin en Cumbre Cebellina.‡Récupérez des Clés en fer forgé sur des Sectateurs et des Draconiens, puis utilisez-les pour libérer 4 Ouvriers gobelins, sur la Crête Fuligineuse.‡用教徒和龙人身上的铁铸钥匙释放漆黑山脊的4名地精工人。‡使用從教徒和龍族身上取得的鐵鑄鑰匙解放黑角嶺裡的4名哥布林工人。',
  }
},
[14298] = {
  {
    '‡Убить сектантов/драконов‡Tötet Kultisten/Drachenschwarm‡이교도/용군단 처치‡Matar cultores/Vuelo‡‡Tuez des Sectateurs/Dragons‡‡',
    nil,
    nil,
  }
},
[14299] = {
  {
    'O pinel do Tauriel‡Пристанище Ксилема‡Xylems Asyl‡실렘의 실마리‡El asilo de Xylem‡El asilo de Xylem‡Le refuge de Xylem‡克希雷姆疯人院‡克希雷姆收容所',
    nil,
    'Use o portal para ir à torre do Arquimago Tauriel, e encontre Joana.‡Воспользуйтесь порталом в башню верховного мага Ксилема и найдите в башне Джоанну.‡Nehmt das Portal zum Turm des Erzmagiers Xylem und sucht im Turm nach Joanna.‡대마법사 실렘의 탑으로 가는 차원문으로 들어간 다음 안쪽에서 조안나를 찾아야 합니다.‡Atraviesa el portal hasta la torre del archimago Xylem y busca dentro a Joanna.‡Atraviesa el portal hasta la torre del archimago Xylem y busca dentro a Joanna.‡Prenez le portail pour accéder à la tour de l’Archimage Xylem et cherchez-y Joanna.‡进入传送门，回到大法师克希雷姆的高塔，去找乔安娜。‡利用傳送門前往大法師克希雷姆的塔並找出瓊安娜。',
  }
},
[14300] = {
  {
    'A prova de fogo‡Испытание огнем‡Die Prüfung des Feuers‡불의 시험‡La prueba de Fuego‡La prueba de Fuego‡L\'Épreuve du Feu‡火焰试炼‡火之試煉',
    nil,
    'Complete a Prova de Fogo, permanecendo nas runas de fogo sem ser atingido pela chama por 10 explosões consecutivas.‡Пройдите испытание огнем, находясь среди огненных рун и не загоревшись в течение 10 последовательных вспышек.‡Besteht die Prüfung des Feuers, indem Ihr in den Feuerrunen steht und 10 aufeinanderfolgende Explosionen übersteht, ohne getroffen zu werden.‡화염의 룬 안에서 불꽃이 10번 연달아 폭발할 동안 모두 피하여 불의 시험을 통과해야 합니다.‡Completa la prueba de Fuego permaneciendo en las runas de fuego sin que te alcancen las llamas durante 10 explosiones consecutivas.‡Completa la prueba de Fuego permaneciendo en las runas de fuego sin que te alcancen las llamas durante 10 explosiones consecutivas.‡Terminez l’Épreuve du Feu en sautant entre les runes de feu sans vous faire toucher par le feu pendant 10 explosions consécutives.‡在火焰符文中保持连续10波不被击中以完成火焰试炼。‡站在火焰符文中經過10次的連續噴發而不受傷以完成火之試煉。',
  }
},
[14301] = {
  {
    'Volte e explique‡Возвращение с докладом‡Kehrt zurück und berichtet‡귀환 후 보고‡Vuelve e informa‡Vuelve e informa‡Rapport : le retour‡复命‡返回報告',
    nil,
    'Você deve falar novamente com a Pesquisadora Cenariana Korrah em Ethel Rethor.‡Возвращайтесь в Этель-Ретор к кенарийской исследовательнице Корре.‡Kehrt zu Korrah, Forscherin des Cenarius in Ethel Rethor zurück.‡에텔 레소르에 있는 세나리온 연구원 코라에게 가야 합니다.‡Vuelve con la investigadora Cenarion Korrah a Ethel Rethor.‡Vuelve con la investigadora Cenarion Korrah a Ethel Rethor.‡Vous devez retourner voir Korrah, la chercheuse cénarienne, à Ethel Rethor.‡返回艾瑟雷索，向塞纳里奥研究员库拉复命。‡你要回去艾瑟雷索找塞納里奧研究員柯拉。',
  }
},
[14302] = {
  {
    'Relatório oficial‡Рапорт начальству‡Offizielle Einschätzung‡공식 보고서‡Evaluación oficial‡Evaluación oficial‡Analyse officielle‡官方评估‡官方估計',
    nil,
    'A Pesquisadora Cenariana Korrah quer que você leve o Relatório de Korrah para Karnum, na Clareira de Karnum.‡Отнесите отчет Корры Карнуму в рощу Карнума.‡Korrah, Forscherin des Cenarius, will, dass Ihr Korrahs Bericht zu Karnum in Karnums Hain bringt.‡세나리온 연구원 코라가 카눔의 숲에 있는 카눔에게 코라의 보고서를 가져가 달라고 했습니다.‡La investigadora Cenarion Korrah quiere que lleves el informe de Korrah a Karnum al Claro de Karnum.‡La investigadora Cenarion Korrah quiere que lleves el informe de Korrah a Karnum al Claro de Karnum.‡Korrah, la chercheuse cénarienne, vous a demandé d’apporter le Rapport de Korrah à Karnum, au bosquet de Karnum.‡塞纳里奥研究员库拉要你将库拉的报告带给卡隆林地的卡隆。‡塞納里奧研究員柯拉要你把柯拉的報告帶去卡努姆林地交給卡努姆。',
  }
},
[14303] = {
  {
    'De volta a Aggra‡Возвращение к Аггре‡Zurück zu Aggra‡아그라에게 돌아가기‡Vuelve con Aggra‡Vuelve con Aggra‡Retourner voir Aggra‡向阿格娜复命‡回到阿格拉身邊',
    nil,
    'Informe Aggra no Campo-base da Horda, nas Ilhas Perdidas, sobre tudo o que ocorreu até agora.‡Сообщите Аггре о том, что произошло. Она находится на Затерянных островах, в главном лагере Орды.‡Informiert Aggra im Basislager der Horde auf den Verlorenen Inseln über die Geschehnisse.‡잃어버린 섬의 호드 주둔지에 있는 아그라에게 그동안 일어났던 일을 모두 알려야 합니다.‡Informa de lo sucedido a Aggra en el Campamento Base de la Horda, en Las Islas Perdidas.‡Informa de lo sucedido a Aggra en el Campamento Base de la Horda, en Las Islas Perdidas.‡Informez Aggra sur les récents évènements au Camp de base de la Horde, sur les Îles Perdues.‡返回失落群岛的部落营地，告诉阿格娜发生了什么事。‡到失落群島的部落營地告訴阿格拉所發生的一切。',
  }
},
[14304] = {
  {
    'Teoria do sangue‡Кровь на анализ‡Blutabnahme‡혈액 이론‡Teoría sangrienta‡Teoría sangrienta‡La théorie du sang‡血之理论‡血液研究',
    nil,
    'Colete 10 Sanguessugas Repletas de Sangue.‡Принесите 10 напившихся крови пиявок.‡Sammelt 10 blutgefüllte Egel.‡피를 빤 거머리 10마리를 모아야 합니다.‡Consigue 10 sanguijuelas llenas de sangre.‡Consigue 10 sanguijuelas llenas de sangre.‡Obtenez 10 Sangsues gorgées de sang.‡收集10条吸满血的水蛭。‡收集10隻吸滿血液的寄生蟲。',
  }
},
[14305] = {
  {
    'Tempo de colher‡Время пожинать‡Erntezeit‡채취의 시간‡Recogida de plantas‡Recogida de plantas‡Le temps des récoltes‡收割时节‡收穫的時間到了',
    nil,
    'Colete 10 Cardos de Aloé.‡Соберите 10 образцов дикого алоэ.‡Sammelt 10 Aloedisteln.‡침향 엉겅퀴 10개를 모아야 합니다.‡Recoge 10 cardos áloe.‡Recoge 10 cardos áloe.‡Trouvez 10 Chardons d\'aloès.‡收集10棵芦蓟草。‡收集10顆蘆薈薊。',
  }
},
[14306] = {
  {
    'Arrancando plantas‡Прополка‡Unkraut jäten‡씨를 말려라‡Quitar malas hierbas‡Quitar malas hierbas‡La mauvaise herbe‡清理杂草‡拔草',
    nil,
    'Mate 7 Açoitadeiras Desenraizadas.‡Уничтожьте 7 выкорчеванных плеточников.‡Tötet 7 entwurzelte Peitscher.‡뿌리 뽑힌 덩굴손 7마리를 처치해야 합니다.‡Mata a 7 azotadores desarraigados.‡Mata a 7 azotadores desarraigados.‡Tuez 7 Flagellants déracinés.‡杀死7个拔根鞭笞者。‡殺死7隻拔根的鞭笞者。',
  }
},
[14307] = {
  {
    'Ventos teimosos‡Враждебный ветер‡Steife Brise‡끈질긴 바람‡Vientos testarudos‡Vientos testarudos‡Vents contraires‡固执的风‡執拗的風',
    nil,
    'Destrua 5 Redemoinhos Andarilhos‡Уничтожьте 5 вихревых штормоходов.‡Zerstört 5 Wirbelsturmgänger.‡휘몰아치는 회오리를 5마리 처치해야 합니다.‡Destruye a 5 caminatormentas espirálicos.‡Destruye a 5 caminatormentas espirálicos.‡Détruisez 5 Tourbillons marchetempête.‡消灭5名旋风雷暴行者。‡摧毀5個旋風雷暴行者。',
  }
},
[14308] = {
  {
    'Ciência, demência, qual a diferência?‡Когда наука атакует‡Angriff der Wissenschaft‡과학의 습격‡Cuando la ciencia ataca‡Cuando la ciencia ataca‡Quand la science attaque‡科学发火了‡科學的攻擊',
    nil,
    'Use o Fogapagou X-21 para apagar 8 incêndios e para resgatar 6 Estagiários Pesquisadores das chamas no Laboratório Secreto. Se você perder o seu Fogapagou X-21, fale novamente com a Assistente Grilly no Terminal Sul da Foguetovia.‡Воспользуйтесь огнеустранителем Х-21, чтобы потушить 8 очагов пожара и спасти 6 студентов-исследователей из пекла в секретной лаборатории.|n|nЕсли вы потеряете ваш огнеустранитель, возьмите еще один у ассистентки Грили на южной конечной станции ракетной дороги.‡Verwendet den Feuerliminator X-21, um 8 Feuer zu löschen und rettet 6 Laborpraktikanten aus dem Inferno im Geheimlabor.|n|nSprecht mit Assistentin Greely an der Südlichen Endhaltestelle der Raketenbahn, solltet Ihr Euren Feuerliminator verlieren.‡화염소각기 X-21을 사용하여 8곳의 불을 끄고 비밀 실험실의 불길 속에서 수습 연구원 6명을 구출해야 합니다.|n|n화염소각기를 잃어버리면, 남부 로켓길 종착지에 있는 조수 그릴리와 대화하여 새로운 화염소각기를 얻으십시오.‡Utiliza el Fuegoeliminator X-21 para extinguir 8 llamas y rescatar a 6 becarios de investigación del incendio en El Laboratorio Secreto.|n|nVe a ver a la ayudante Greely a la Terminal de la Cohetepista del Sur si pierdes tu Fuegoeliminator.‡Utiliza el Fuegoeliminator X-21 para extinguir 8 llamas y rescatar a 6 becarios de investigación del incendio en El Laboratorio Secreto.|n|nVe a ver a la ayudante Greely a la Terminal de la Cohetepista del Sur si pierdes tu Fuegoeliminator.‡Utilisez l’Éliminafeu X-21 pour éteindre 8 feux et sauver 6 Chercheurs stagiaires des flammes du Laboratoire secret.|n|nSi vous perdez votre Éliminafeu, allez voir l\'Assistante Greely au Terminus Sud du fusorail.‡使用X-21型灭火器扑灭8处火场，从秘密实验室的烈焰中救出6名实习研究员。|n|n如果你丢失了X-21型灭火器，就去找南部火箭车终点站的助手格瑞里。‡使用熄火器X-21消滅8處的火勢並從秘密實驗室的烈火中解救6名研究實習生。|n|n若你遺失滅火器則到南方火箭道終點去找助理格里利。',
  }
},
[14309] = {
  {
    'Acalmando os kodos‡Успокоительное для кодо‡Der Kodoflüsterer‡코도 진정시키기‡Calmando al kodo‡Calmando al kodo‡Quota de kodos‡安抚科多兽‡安撫科多獸',
    nil,
    'Use o Caldo Reconfortante perto de 5 Kodos Enraivecidos.‡Напоите 5 разъяренных кодо успокаивающим настоем.‡Benutzt das Kodobesänftigungsmittel in der Nähe von 5 wütenden Kodos.‡분노한 코도 5마리 근처에서 코도 혼합물을 사용해야 합니다.‡Utiliza el brebaje de kodo cerca de 5 kodos iracundos.‡Utiliza el brebaje de kodo cerca de 5 kodos iracundos.‡Utilisez la Décoction de kodo près de 5 Kodos enragés.‡在5只暴怒的科多兽旁使用科多药汤。‡在5隻暴怒的科多獸附近使用科多獸調合劑。',
  }
},
[14310] = {
  {
    'Falha de segmentação: núcleo expulso‡Ошибка сегментации: дамп памяти сохранен‡Schutzverletzung: Kernabkopplung‡기능 결함: 핵 분리‡Fallo de segmentación: verter el núcleo‡Fallo de segmentación: verter el núcleo‡Erreur de segmentation : évacuation du noyau‡总结段错误：卸除核心‡總結段錯誤:拋除核心',
    nil,
    'Ative o Console do Controle do Reator e leve o Núcleo de Azsharita de volta até o Terminal Sul da Foguetovia. Use o Fogapagou X-21 no Núcleo se este começar a esquentar.‡Активируйте панель управления реактором и сопроводите азшаритовое ядро на южную конечную станцию ракетной дороги. Используйте огнеустранитель Х-21, когда ядро будет перегреваться.‡Aktiviert das Reaktorkontrollpult und eskortiert den Azsharitkern zurück zur Südlichen Endhaltestelle der Raketenbahn. Wendet den Feuerliminator X-21 auf den Kern an, damit er sich nicht überhitzt.‡반응로 제어장치를 사용하여 아즈샤리트 핵을 남부 로켓길 종착지까지 옮겨야 합니다. 핵이 과열되기 시작하면 화염소각기 X-21을 사용하십시오.‡Activa la consola de control del reactor y escolta el núcleo de azsharita hasta la Terminal de la Cohetepista del Sur. Utiliza el Fuegoeliminator X-21 en el núcleo si empieza a recalentarse.‡Activa la consola de control del reactor y escolta el núcleo de azsharita hasta la Terminal de la Cohetepista del Sur. Utiliza el Fuegoeliminator X-21 en el núcleo si empieza a recalentarse.‡Activez la Console de contrôle du réacteur et protégez le Noyau d’azsharite jusqu’au Terminus sud du fusorail. Utilisez l’Éliminafeu X-21 sur le noyau s’il se met à surchauffer.‡激活反应堆控制台，将艾萨莱特水晶核心送回南部火箭车终点站。万一核心过热，使用X-21型灭火器。‡啟動反應爐控制臺，並護送艾薩拉水晶核心回南方火箭道終點。當核心開始過熱時，使用熄火器X-21幫它降溫。',
  }
},
[14311] = {
  {
    'Fazendo a sua parte‡Чудо своими руками‡Wer Ernten will muss säen‡식목일‡Participando‡Participando‡Mise à contribution‡参与其中‡參與其中',
    nil,
    'Use as Sementes Cenarianas perto de 5 Monturos Férteis nas Terras Virgens Cenarianas.‡Посадите семена Кенария в 5 местах на плодородной земле в Кенарийских Зарослях.‡Pflanzt 5 Samen des Cenarius in der Nähe der fruchtbaren Erdhügel in der Cenariuswildnis.‡세나리온 자생지의 비옥한 흙더미 5곳에 세나리온 씨앗을 사용해야 합니다.‡Usa las semillas Cenarion cerca de los 5 montones fértiles que hay alrededor de las Tierras Vírgenes Cenarion.‡Usa las semillas Cenarion cerca de los 5 montones fértiles que hay alrededor de las Tierras Vírgenes Cenarion.‡Utilisez les Graines cénariennes à proximité de 5 Monticules fertiles, dans les Terres sauvages Cénariennes.‡前往塞纳里奥旷野，对5处肥沃土堆使用塞纳里奥之种。‡在塞納里奧曠野周圍的5個肥沃的土堆上，使用塞納里奧種子。',
  }
},
[14312] = {
  {
    'Hora de ser apresentado‡Позвольте представить‡Vorstellung beim Khan‡적절한 인사‡Una introducción en marcha‡Una introducción en marcha‡Des présentations sont de rigueur‡准备见面‡序幕已準備就緒',
    nil,
    'Garren Ventonegro na Clareira de Karnum quer que você fale com o Khan Leh\'Prah.‡Гаррен Темный Ветер на Просеке Карнума хочет, чтобы вы поговорили с ханом Ле\'прахом.‡Garren Finsterwind auf Karnums Lichtung will, dass Ihr mit Khan Leh\'prah sprecht.‡카눔의 숲에 있는 가렌 다크윈드가 칸 레프라의 이야기를 들어 달라고 했습니다.‡Garren Vientoscuro del Claro de Karnum quiere que hables con el Khan Leh\'prah.‡Garren Vientoscuro del Claro de Karnum quiere que hables con el Khan Leh\'prah.‡Garren Vent-noir, de la clairière de Karnum, vous a demandé d’aller parler au khan Leh’prah.‡卡隆林地的格伦·暗风要你去跟力普拉可汗谈一谈。‡卡努姆林地的加倫‧暗風要你去和雷普拉可汗交談。',
  }
},
[14313] = {
  {
    'Entre humanos, outra vez‡Снова среди людей‡Wieder unter Menschen‡다시 인간으로‡Otra vez entre humanos‡Otra vez entre humanos‡De nouveau parmi les humains‡恢复人性‡重回人群',
    nil,
    'Fale com Krennan Aranas no Refúgio do Ocaso.‡Поговорите с Креннаном Аранасом в Темной Гавани.‡Sprecht mit Krennan Aranas in Dämmerhafen.‡어스름 안식처에 있는 크레난 아라나스와 대화해야 합니다.‡Habla con Krennan Aranas en el Refugio del Ocaso.‡Habla con Krennan Aranas en el Refugio del Ocaso.‡Parlez à Krennan Aranas à Havre-du-Soir.‡跟暮湾镇的克雷南·阿朗纳斯谈一谈。‡在暮色港和卡瑞南·阿拉納斯談話。',
  }
},
[14314] = {
  {
    'Fuga!‡Побег из плена‡Ausbruch!‡탈옥!‡¡A la fuga!‡¡A la fuga!‡Sauve qui peut !‡突围！‡分道揚鑣!',
    nil,
    'Mate o Guardião Magram na Vila Magram.‡Уничтожьте стражей племени Маграм в деревне Маграм.‡Tötet den Wächter der Magram im Dorf der Magram.‡마그람 마을로 가서 마그람 감시자를 처치해야 합니다.‡Mata al celador Magram en el Poblado Magram.‡Mata al celador Magram en el Poblado Magram.‡Tuez le Gardien magram, au Village des Magram.‡杀死玛格拉姆村的玛格拉姆看守者。‡到瑪格拉姆村去殺死瑪格拉姆看守者。',
  }
},
[14315] = {
  {
    '‡Лиам в замешательстве‡Liams Schock‡‡El delirio de Liam‡‡La cuite de Liam‡‡',
    nil,
    '‡Поговорите с Гвен Армстед в Темной Гавани.‡Sprecht mit Gwen Armstead in Dämmerhafen.‡어스름 안식처에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡‡Parlez à Gwen Armstead à Havre-du-Soir.‡跟暮湾镇的格温·阿姆斯特谈一谈。‡',
  }
},
[14316] = {
  {
    'Propriedade cenariana‡Имущество кентавров‡Cenarisches Eigentum‡세나리온의 자산‡Propiedad de Cenarion‡Propiedad de Cenarion‡Propriété cénarienne‡塞纳里奥的财产‡塞納里奧的財產',
    nil,
    'Encontre 7 Caixotes de Suprimentos Cenarianos das terras dos Magram.‡Отыщите 7 ящиков с припасами Кенария в землях Маграм.‡Sammelt 7 Vorratskisten des Cenarius in den Ländern der Magram.‡마그람 일족의 땅으로 가서 세나리온 보급품 상자를 7개 모아야 합니다.‡Recoge 7 cajones de suministros Cenarion en el Poblado Magram.‡Recoge 7 cajones de suministros Cenarion en el Poblado Magram.‡Récupérez 7 Caisses de provisions cénariennes en territoire magram.‡在玛格拉姆领地收集7个塞纳里奥补给箱。‡去瑪格拉姆氏族的領地收集7個塞納里奧補給箱。',
  }
},
[14317] = {
  {
    '‡Подземный толчок‡‡‡‡‡‡‡',
    nil,
    '‡Гвен Армстед просит вас осмотреть Врата Королевы.‡Gwen Armstead möchte, dass Ihr das Königinnentor in Augenschein nehmt.‡‡Gwen Armstead quiere que investigues la Puerta de la Reina.‡‡Gwen Armstead vous a demandé d\'enquêter à la Porte de la Reine.‡‡',
  }
},
[14318] = {
  {
    'Negociações delicadas‡Сложные переговоры‡Feinfühlige Verhandlungen‡까다로운 협상‡Negociaciones delicadas‡Negociaciones delicadas‡De délicates négociations‡微妙的谈判‡微妙的協商方式',
    nil,
    'O Khan Leh\'Prah quer que você plante a Lança do Khan Kolkar na Pedra Paterna e defenda-a dos Magram até que o Khan Kammah apareça.|n|nFale com o Khan Leh\'Prah quando estiver pronto para cavalgar para o local de batalha.‡Хан Ле\'прах хочет, чтобы вы вонзили Копье хана Колкар в камень Отцов и защищали его от клана Маграм, пока не появится вождь Камма.|n|nПоговорите с ханом Ле\'прахом, когда будете готовы отправиться на поле боя.‡Khan Leh\'prah will, dass Ihr den Speer des Khans der Kolkar in den Vaterstein treibt und ihn vor den Magram verteidigt, bis Khan Kammah erscheint.|n|nSprecht mit Khan Leh\'prah, sobald Ihr bereit seid, zum Schlachtfeld zu reiten.‡칸 레프라가 콜카르 칸의 창을 선조의 돌에 사용한 다음 칸 카마가 나타날 때까지 마그람 일족으로부터 선조의 돌을 지켜 달라고 했습니다.|n|n전투 지점으로 향할 준비가 되었다면 칸 레프라와 이야기하십시오.‡El Khan Leh\'prah quiere que coloques la lanza del Khan Kolkar en la Piedra del Patriarca y que la defiendas de los Magram hasta que aparezca el Khan Kammah.|n|nHabla con el Khan Leh\'prah cuando estés listo para trasladarte al lugar de la batalla.‡El Khan Leh\'prah quiere que coloques la lanza del Khan Kolkar en la Piedra del Patriarca y que la defiendas de los Magram hasta que aparezca el Khan Kammah.|n|nHabla con el Khan Leh\'prah cuando estés listo para trasladarte al lugar de la batalla.‡Le khan Leh’prah vous a demandé d’enfoncer la Lance du khan des Kolkar dans la Pierre du père et de la protéger des Magram jusqu’à ce que le Khan Kammah apparaisse.|n|nAllez parler au khan Leh’prah quand vous serez prêt à vous rendre sur le champ de bataille.‡力普拉可汗要你将科卡尔可汗之矛插在先祖之石上，并从玛格拉姆的手中保护它，直到坎玛可汗出现。|n|n你做好前往战场的准备后就跟力普拉可汗谈一谈。‡雷普拉可汗要你把科卡爾可汗之矛插在父石上，保衛它不受瑪格拉姆半人馬攻擊，直到卡姆瑪可汗現身。|n|n當你準備好加入戰場時，就與雷普拉可汗交談。',
  }
},
[14319] = {
  {
    '‡Долгий путь к исцелению‡Weitere Behandlung‡‡Continuación del tratamiento‡‡Traitement complémentaire‡‡',
    nil,
    '‡Поговорите с Креннаном Аранасом в Темной Гавани.‡Sprecht mit Krennan in Dämmerhafen.‡어스름 안식처에 있는 크레난 아라나스와 대화해야 합니다.‡Habla con Krennan Aranas en el Refugio del Ocaso.‡‡Parlez à Krennan Aranas à Havre-du-Soir.‡跟暮湾镇的克雷南·阿朗纳斯谈一谈。‡',
  }
},
[14320] = {
  {
    'Em busca dos ingredientes‡В поисках ингредиентов‡Benötigte Zutaten‡재료 모으기‡Faltan ingredientes‡Faltan ingredientes‡Il nous faut des ingrédients‡急需药材‡需要原料',
    nil,
    'Encontre o Caixote de Essência de Mandrágora.‡Найдите ящик с эссенцией мандрагоры.‡Findet die Kiste mit Alraunenessenz.‡독말풀즙이 든 상자를 찾아야 합니다.‡Encuentra el cajón de esencia de mandrágora.‡Encuentra el cajón de esencia de mandrágora.‡Trouvez la Caisse d\'essence de mandragore.‡找到一箱毒参茄精萃。‡找到一箱曼陀羅精華。',
  }
},
[14321] = {
  {
    'Invasão‡Вторжение‡Invasion‡침공‡Invasión‡Invasión‡L\'invasion‡入侵‡入侵',
    nil,
    'Fale com Gwen Armstead no Refúgio do Ocaso.‡Поговорите с Гвен Армстед в Темной Гавани.‡Sprecht mit Gwen Armstead in Dämmerhafen.‡어스름 안식처에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Parlez à Gwen Armstead à Havre-du-Soir.‡跟暮湾镇的格温·阿姆斯特谈一谈。‡在暮色港和葛玟·阿姆史特談話。',
  }
},
[14322] = {
  {
    'Ai ai ai, Dona Ciência! Coisa feia!‡Плохая наука! Плохая!‡Böse Wissenschaft! Pfui!‡해로운 과학‡¡Ciencia mala!‡¡Ciencia mala!‡La science, c\'est le MAL !‡悲剧的科学！悲剧！‡科學壞壞!壞壞!',
    nil,
    'Mate 8 Hipogrifos Carregados de Estática.‡Убейте 8 заряженных электричеством гиппогрифов.‡Tötet 8 statisch aufgeladene Hippogryphen.‡정전기 충전된 히포그리프 8마리를 처치해야 합니다.‡Mata a 8 hipogrifos cargados con electricidad estática.‡Mata a 8 hipogrifos cargados con electricidad estática.‡Tuez 8 Hippogriffes chargés d’électricité statique.‡杀掉8头静电充能角鹰兽。‡殺死8隻充滿靜電的角鷹獸。',
  }
},
[14323] = {
  {
    'Mil e uma utilidades‡Абсорбент‡Supersaugstark‡흡수력이 끝내줘요‡Absorbente‡Absorbente‡Absorbant‡吸水‡吸收',
    nil,
    'Colete 20 Gotas de Água Fervente dos Borrifos Torpes a leste das Ruínas de Arkkoran.‡Соберите 20 капель кипящей воды из Коварного источника восточнее руин храма Арккоран.‡Saugt 20 köchelnde Wassertropfen der üblen Platscher im Osten der Ruinen von Arkkoran auf.‡아크코란의 폐허 동쪽에 있는 사악한 물방울 정령에게서 끓어 오르는 작은 물방울 20개를 모아야 합니다.‡Recoge 20 gotitas de agua tibia de las salpicaduras viles que hay al este de las Ruinas de Arkkoran.‡Recoge 20 gotitas de agua tibia de las salpicaduras viles que hay al este de las Ruinas de Arkkoran.‡Collectez 20 Gouttes d\'eau frémissante sur des Éclabousseurs maléfiques à l\'est des Ruines d\'Arkkoran.‡从亚考兰神殿废墟东边的邪恶水滴身上收集20份临近沸腾的水滴。‡在亞考蘭廢墟的東邊從邪惡濺潑者身上收集20個一小滴即將沸騰的高溫水滴。',
  }
},
[14324] = {
  {
    'O tal do elemental‡Горячая вода‡Voll heißen Wassers‡펄펄 끓는 물‡Lleno de agua caliente‡Lleno de agua caliente‡Le plein d\'eau bouillante‡好多热水‡裝滿熱水',
    nil,
    'Obtenha um Globo de Água Fervente de um Lorde da Água Escaldante, na Torre de Eldara.‡Получите магическую сферу кипящей воды от повелителя кипящей воды у башни Эльдары.‡Erlangt eine Kugel voll kochendem Wasser von einem brühenden Wasserlord am Turm von Eldara.‡엘다라의 탑에서 끓어오르는 물의 군주를 소환하여 끓는 물의 보주를 획득해야 합니다.‡Consigue un globo de agua hirviente de un señor Aguarviente en la Torre de Eldara.‡Consigue un globo de agua hirviente de un señor Aguarviente en la Torre de Eldara.‡Récupérez un Globe d’eau bouillante sur un Seigneur de l’eau brûlante, à la Tour d’Eldara.‡从埃达拉之塔处滚烫的水元素领主身上获得沸水之球。‡從艾達拉之塔滾燙的水元素中，取得沸水之球。',
  }
},
[14325] = {
  {
    'Trabalho por comida‡Работа за еду‡Arbeite für Essen‡먹어야 일하지‡Trabajar para comer‡Trabajar para comer‡Un flanchet de basilic, et ça repart !‡有吃的就干‡為了食物而工作',
    nil,
    'Junte 5 Flancos de Basilisco.‡Соберите 5 боков василиска.‡Sammelt 5 Basiliskenflanken.‡바실리스크 살코기 5개를 모아야 합니다.‡Recoge 5 costillares de basilisco.‡Recoge 5 costillares de basilisco.‡Collectez 5 Flanchets de basilic.‡收集5块蜥蜴的肋肉。‡收集5片蜥蜴腰肉。',
  }
},
[14326] = {
  {
    'Encontre-me lá em cima‡Встретимся наверху‡Aufs Oberdeck‡위에서 만나기‡Reunión en cubierta‡Reunión en cubierta‡Rencontre au sommet‡甲板上见‡在上面和我碰面',
    nil,
    'Suba para o convés do Vigília da Vingança, na costa das Ilhas Perdidas, e fale com Thrall.‡Проберитесь на верхнюю палубу "Караула Возмездия", который стоит у Затерянных островов, и поговорите с Траллом.‡Begebt Euch auf das obere Deck der Sog der Vergeltung an der Küste der Verlorenen Inseln und sprecht mit Thrall.‡잃어버린 섬의 해변에 정박한 복수의 흔적호 상층 갑판으로 길을 내며 올라간 다음 스랄과 대화해야 합니다.‡Sube a la cubierta superior del Rastro Venganza, frente a la orilla de Las Islas Perdidas, y habla con Thrall.‡Sube a la cubierta superior del Rastro Venganza, frente a la orilla de Las Islas Perdidas, y habla con Thrall.‡Remontez sur le pont du Vogue-Vengeance au large des Îles Perdues, et parlez à Thrall.‡爬上停泊在失落群岛岸边的复仇觉醒号的甲板上层，跟萨尔谈一谈。‡到失落群島海岸線外的復仇之醒號的上層甲板和索爾談話。',
  }
},
[14327] = {
  {
    'Minha palavra é meu compromisso‡Я даю слово‡Versprochen ist versprochen‡말이 곧 인연‡Mi palabra es sagrada‡Mi palabra es sagrada‡Parole d’honneur‡言行一致‡一諾千金',
    nil,
    'O Khan Kammah quer que você fale com o Khan Leh\'Prah.‡Хан Камма хочет, чтобы вы поговорили с ханом Ле\'прахом.‡Khan Kammah will, dass Ihr mit Khan Leh\'prah sprecht.‡칸 카마가 칸 레프라와 대화해 달라고 했습니다.‡El Khan Kammah quiere que hables con el Khan Leh\'prah.‡El Khan Kammah quiere que hables con el Khan Leh\'prah.‡Le khan Kammah vous a demandé d’aller parler au khan Leh’prah.‡坎玛可汗要你跟力普拉可汗谈一谈。‡卡姆瑪可汗要你去與雷普拉可汗交談。',
  }
},
[14328] = {
  {
    'Três príncipes‡Три принца‡Drei Prinzen‡세 아들‡Los tres príncipes‡Los tres príncipes‡Les trois petits princes‡三个王子‡三個王子',
    nil,
    'Mate Rhoho, Sherik e Jorreth.‡Расправьтесь с Рохо, Шериком и Джорретом.‡Tötet Rhoho, Sherik, und Jorreth.‡로호, 셰릭, 조레스를 처치해야 합니다.‡Mata a Rhoho, a Sherik y a Jorreth.‡Mata a Rhoho, a Sherik y a Jorreth.‡Tuez Rhoho, Sherik, et Jorreth.‡杀死洛忽、舍利克和觉伦斯，然后跟苏度可汗谈一谈。‡殺死洛侯、什里克與喬瑞斯。',
  }
},
[14329] = {
  {
    'Não tão rápido!‡Не так быстро!‡Nicht so schnell!‡서두르지 마라!‡¡Para el carro!‡¡Para el carro!‡Pas si vite !‡慢着！‡別急!',
    nil,
    'O Khan Shodo quer que você mate 10 Espancadores Maraudinos no Vale das Lanças.|n|nReviste os cadáveres para encontrar pistas sobre o paradeiro de Kherrah.‡Хан Шодо хочет, чтобы вы убили 10 извергов из племени Мародин в Долине Копий.|n|nВы должны обыскать их тела в поисках подсказок о местонахождении Керры.‡Khan Shodo will, dass Ihr 10 Raufer der Maraudine im Tal der Speere tötet.|n|nIhr müsst ihre Leichen nach Hinweisen über den Verbleib von Kherrah durchsuchen.‡칸 쇼도가 뾰족바위 골짜기에 있는 마라우돈 투사 10마리를 처치해 달라고 했습니다.|n|n그리고 시체에서 케라의 행방에 관한 단서를 찾아야 합니다.‡El Khan Shodo quiere que mates a 10 aplastadores Maraudine en el Valle de las Lanzas.|n|nBusca pistas del paradero de Kherrah en sus cadáveres.‡El Khan Shodo quiere que mates a 10 aplastadores Maraudine en el Valle de las Lanzas.|n|nBusca pistas del paradero de Kherrah en sus cadáveres.‡Le khan Shodo veut que vous tuiez 10 Marteleurs maraudines dans la Vallée des Lances.|n|nVous devez fouiller leurs cadavres à la recherche d’indices sur le lieu où est retenue Kherrah.‡苏度可汗要你在长矛谷中杀死10名玛洛迪虐待者。|n|n你可以在他们的尸体上搜寻关于柯尔拉下落的线索。‡蘇多可汗希望你在長矛谷消滅10個瑪洛迪虐待者。|n|n你要搜查他們的屍體，找出凱拉在哪的線索。',
  }
},
[14330] = {
  {
    'Por trás de portas fechadas‡За закрытыми дверьми‡Hinter verschlossenen Türen‡닫힌 문 너머로‡A puerta cerrada‡A puerta cerrada‡Derrière les portes closes‡被囚的公主‡在關上的門後面',
    nil,
    'Você deve encontrar Kherrah em algum lugar atrás das portas para Maraudon.‡Найдите Керру в стенах Марадона.‡Ihr müsst Kherrah finden, die in Maraudon gefangen gehalten wird.‡마라우돈 석실 문 너머 어딘가에 있는 케라를 찾아야 합니다.‡Encuentra a Kerrah en algún lugar tras las puertas de que conducen a Maraudon.‡Encuentra a Kerrah en algún lugar tras las puertas de que conducen a Maraudon.‡Vous devez retrouver Kherrah quelque part à l’intérieur de Maraudon.‡进入玛拉顿，寻找柯尔拉。‡你要在通往瑪拉頓的某扇門後面找到凱拉。',
  }
},
[14332] = {
  {
    'Hora de mudança‡Время перемен‡Zeit für eine Veränderung‡변화할 시간‡Hora de cambiar‡Hora de cambiar‡L\'heure du changement a sonné‡化敌为友‡改變的時候到了',
    nil,
    'Kherrah quer que você fale com o Khan Leh\'Prah.‡Керра хочет, чтобы вы поговорили с ханом Ле\'прахом.‡Kherrah will, dass Ihr mit Khan Leh\'prah sprecht.‡케라가 칸 레프라와 대화해 달라고 했습니다.‡Kerrah quiere que hables con el Khan Leh\'prah.‡Kerrah quiere que hables con el Khan Leh\'prah.‡Kherrah vous a demandé d’aller parler au khan Leh’prah.‡柯尔拉要你跟力普拉可汗谈一谈。‡凱拉要你去和雷普拉可汗交談。',
  }
},
[14333] = {
  {
    'Enquanto você está aqui‡Пока ты здесь‡Wo Ihr schon mal hier seid‡여기 온 김에‡Reliquias profanas‡Reliquias profanas‡Pendant que vous êtes là‡你既然来了‡當你在此',
    nil,
    'Você deve esquadrinhar o Vale das Lanças para encontrar 6 Relíquias Profanadas.‡Обыщите Долину Копий и найдите 6 оскверненных реликвий.‡Ihr sollt das Tal der Speere nach 6 entweihten Relikten absuchen.‡뾰족바위 골짜기를 수색하여 더럽혀진 유물 6개를 찾아야 합니다.‡Rastrea el Valle de las Lanzas en busca de 6 reliquias profanadas.‡Rastrea el Valle de las Lanzas en busca de 6 reliquias profanadas.‡Vous devez fouiller la Vallée des lances à la recherche de 6 Reliques profanées.‡搜寻长矛谷，找到6件被亵渎的圣物。‡你要到長矛谷尋找6個遭褻瀆的聖物。',
  }
},
[14334] = {
  {
    'Gordoleia‡Брюхажира‡Blubberwampe‡먹보고래‡Tripasebo‡Tripasebo‡Boule-de-gras‡肥肠‡肥腸',
    nil,
    'Mai\'Lahii quer que você mate a Gordoleia.‡Убейте Брюхажиру по заданию Май\'Лахии.‡Mai\'Lahii will, dass Ihr Blubberwampe tötet.‡마이라히가 먹보고래를 처치해 달라고 했습니다.‡Mai\'Lahii quiere que mates a Tripasebo.‡Mai\'Lahii quiere que mates a Tripasebo.‡Mai\'Lahii vous a demandé de tuer Boule-de-gras.‡麦拉斯要你去杀掉肥肠。‡麥拉斯希望你殺死肥腸。',
  }
},
[14335] = {
  {
    'Desobstruindo‡Дело нужное‡Hummerplage‡백지장도 맞들면‡Obstáculos en el camino‡Obstáculos en el camino‡Leur fermer le claquet‡插足‡介入',
    nil,
    'Taiga Crina Sábia, na Aldeia Pescassombra, quer que você mate 5 Rastejantes Estalo-seco e 5 Tenazes Estalo-seco.‡Убейте 5 крабов с мертвой хваткой и 5 жестколапых клешневиков.‡Tötet 5 Kaltschnappkriecher und 5 Kaltschnappzangen.‡마른껍질 마크루라 5마리와 뾰족뿔 마른껍질 마크루라 5마리를 처치해야 합니다.‡Mata a 5 reptadores Golpeseco y a 5 tenazarios Golpeseco.‡Mata a 5 reptadores Golpeseco y a 5 tenazarios Golpeseco.‡Tuez 5 Rampants claquesec et 5 Pinceurs claquesec.‡杀死5名枯钳龙虾人和5名枯钳巨螯龙虾人。‡殺死5名枯鉗龍蝦人和5名枯鉗巨螯龍蝦人。',
  }
},
[14336] = {
  {
    'Matar ou morrer‡Убивай или будешь убит‡Töten oder getötet werden‡죽거나 죽이거나‡Mata o muere‡Mata o muere‡Tuer ou être tué‡猎物还是猎人‡殺或被殺',
    nil,
    'Fale com o Príncipe Liam Greymane do lado de fora do Refúgio do Ocaso.‡Поговорите с принцем Лиамом Седогривом. Вы найдете его рядом с Темной Гаванью.‡Sprecht mit Prinz Liam Graumähne außerhalb von Dämmerhafen.‡어스름 안식처 외곽에 있는 왕자 리암 그레이메인과 대화해야 합니다.‡Habla con el príncipe Liam Cringris en el exterior del Refugio del Ocaso.‡Habla con el príncipe Liam Cringris en el exterior del Refugio del Ocaso.‡Parlez au Prince Liam Grisetête à l\'extérieur de Havre-du-Soir.‡跟暮湾镇外的利亚姆·格雷迈恩王子谈一谈。‡在暮色港外面和黎姆·葛雷邁恩王子談話。',
  }
},
[14337] = {
  {
    'Aldeia Pescassombra‡Деревня Ночных Охотников‡Schattenflucht‡그늘수렵 마을‡La Aldea Cazasombras‡La Aldea Cazasombras‡Proie-de-l’Ombre‡葬影村‡葬影村',
    nil,
    'Karnum Tecelão do Pântano quer que você fale com Mai\'Lahii.‡Поговорите с Май\'Лахией по просьбе Карнума Ткача Болот.‡Karnum Marschenwirker will, dass Ihr mit Mai\'Lahii sprecht.‡카눔 마쉬위버가 마이라히와 대화해 달라고 했습니다.‡Karnum Tejedor de Marismas quiere que hables con Mai\'Lahii.‡Karnum Tejedor de Marismas quiere que hables con Mai\'Lahii.‡Karnum Tisse-marais vous a demandé d’aller parler à Mai’Lahii.‡卡隆·沼织要你去跟麦拉斯谈一谈。‡卡奴姆·沼織者希望你去和麥拉斯談話。',
  }
},
[14338] = {
  {
    'Entreposto do Espírito que Anda‡Застава Скитающихся Духов‡Der Geistwandlerposten‡침묵의 초소‡Campamento del Espíritu Errante‡Campamento del Espíritu Errante‡Le poste de Rôdeur-fantôme‡幽灵岗哨‡鬼旅崗哨',
    nil,
    'Karnum Tecelão do Pântano quer que você fale com Maurin Rachaosso.‡По поручению Карнума Ткача Болот поговорите с Маурином Костоломом.‡Karnum Marschenwirker will, dass Ihr mit Maurin Knochenspalter sprecht.‡카눔 마쉬위버가 마우린 본스플리터와 대화해 달라고 했습니다.‡Karnum Tejedor de Marismas quiere que hables Maurin Partehuesos.‡Karnum Tejedor de Marismas quiere que hables Maurin Partehuesos.‡Karnum Tisse-marais vous a demandé d’aller parler à Maurin Craquossement.‡卡隆·沼织要你去跟玛乌林·碎骨谈一谈。‡卡奴姆·沼織者要你去和莫林·碎骨者交談。',
  }
},
[14339] = {
  {
    'Dispositivo de entrega‡Тара для перевозки‡Lieferungsgerät‡그릇이 필요해‡El dispositivo de contención‡El dispositivo de contención‡Voie d\'administration‡发射装置‡傳遞裝置',
    nil,
    'Maurin Rachaosso quer que você arranque 3 Chifres Ocos de Kodo dos Kodos Moribundos.‡Соберите 3 полых рога умирающих кодо и отнесите их Маурину Костолому.‡Maurin Knochenspalter will, dass Ihr 3 hohle Kodohörner von sterbenden Kodos sammelt.‡마우린 본스플리터가 임종의 코도에게서 속이 빈 코도 뿔 3개를 구해 달라고 했습니다.‡Maurin Partehuesos quiere que consigas 3 cuernos de kodo huecos de kodos moribundos.‡Maurin Partehuesos quiere que consigas 3 cuernos de kodo huecos de kodos moribundos.‡Maurin Craquossement vous a demandé de trouver 3 Cornes creuses de kodos sur des Kodos mourants.‡玛乌林·碎骨要你从濒死的科多兽身上收集3个中空的科多兽角。‡莫林·碎骨者要你從瀕死的科多獸身上，收集3個中空的科多獸角。',
  }
},
[14340] = {
  {
    'Que bonita sua roupa‡Встречают по одежке‡Schicker Fummel‡마음을 움직이는 의상‡Vístete para impresionar‡Vístete para impresionar‡La fripe pour la frime‡打扮整齐‡服裝是第一印象',
    nil,
    'Ponha seu novo chapéu de teurgo e fale com a Imagem do Arquimago Tauriel a nordeste da Estação Norte da Foguetovia.‡Наденьте вашу новую шляпу волшебника и поговорите с проекцией верховного мага Ксилема. Его можно найти к северо-востоку от северной пересадочной станции ракетной дороги.‡Setzt Euren neuen Zaubererhut auf und dann sprecht mit dem Abbild von Erzmagier Xylem nordöstlich des Nördlichen Umschlagplatzes der Raketenbahn.‡새로 얻은 마술사 모자를 쓰고 북부 로켓길 교역소 바로 북동쪽에서 대마법사 실렘의 환영과 대화해야 합니다.‡Ponte tu nuevo sombrero de zahorí y habla con la imagen del archimago Xylem justo al noreste del Intercambiador de la Cohetepista del Norte.‡Ponte tu nuevo sombrero de zahorí y habla con la imagen del archimago Xylem justo al noreste del Intercambiador de la Cohetepista del Norte.‡Mettez votre nouveau Chapeau de sorcier, puis allez voir l’Image de l’archimage Xylem, juste au nord-est de la Station nord du fusorail.‡戴上你的新法师帽，同北方火箭车换乘站东北面大法师克希雷姆的影像交谈。‡戴上你的新巫師帽，然後在北方火箭道交會點的東北邊和大法師克希雷姆的影像講話。',
  }
},
[14341] = {
  {
    'Arneses do Smid‡Снаряжение Смида‡Smeeds Harnische‡스미드의 마구‡Los arneses de Smeed‡Los arneses de Smeed‡Les harnais de Smeed‡斯米德的挽具‡斯米德的座具',
    nil,
    'Nataoka, no Entreposto do Espírito que Anda, quer que você entregue os Arneses do Smid para o Smid.‡По поручению Натаки на Заставе Скитающихся Духов отнесите Смиду его снаряжение.‡Nataka im Geistwandlerposten will, dass Ihr Smeeds Harnische an Smeed ausliefert.‡침묵의 초소에 있는 나타카가 스미드의 마구를 스미드에게 배달해 달라고 했습니다.‡Nataka del Campamento del Espíritu Errante quiere que entregues a Smeed los arneses de Smeed.‡Nataka del Campamento del Espíritu Errante quiere que entregues a Smeed los arneses de Smeed.‡Nataka, du Poste de Rôdeur-fantôme, veut que vous ameniez les Harnais de Smeed à Smeed.‡幽灵岗哨的纳塔卡要你将斯米德的挽具交给斯米德。‡鬼旅崗哨的納塔卡要你把斯米德的座具遞送給斯米德。',
  }
},
[14342] = {
  {
    'Invasão infernal‡Вторжение демонов‡Höllische Übergriffe‡밀려드는 지옥불정령‡Invasión infernal‡Invasión infernal‡Intrusion infernale‡地狱火入侵‡來自地獄的侵略',
    nil,
    'Felgur Doiscortes quer que você destrua 10 Infernais Menores.‡По поручению Фелгура Бью-Двоих уничтожьте 10 младших инферналов.‡Felgur Zweischneid will, dass Ihr 10 niedere Höllenbestien vernichtet.‡펠굴 투커츠가 하급 지옥불정령을 10마리 처치해 달라고 했습니다.‡Felgur Doscortes quiere que destruyas 10 infernales inferiores.‡Felgur Doscortes quiere que destruyas 10 infernales inferiores.‡Felgur Doublecoupe veut que vous détruisiez 10 Infernaux inférieurs.‡费古尔·双刃要你消灭10名次级地狱火。‡費古爾·雙刃要你去摧毀10個次級煉獄火。',
  }
},
[14343] = {
  {
    'Concocção do Maurin‡Зелье Маурина‡Maurins Gebräu‡마우린의 혼합물‡El brebaje de Maurin‡El brebaje de Maurin‡La décoction de Maurin‡玛乌林的调和物‡莫林的化合物',
    nil,
    'O Maurin quer que você entregue a Concocção do Maurin para o Karnum, na Clareira do Karnum.‡По поручению Маурина отнесите зелье Маурина Карнуму в Рощу Карнума.‡Maurin will, dass Ihr Maurins Gebräu zu Karnum in Karnums Hain bringt.‡마우린이 마우린의 혼합물을 카눔의 숲에 있는 카눔에게 가져다 달라고 했습니다.‡Maurin quiere que entregues el brebaje de Maurin a Karnum en el Claro de Karnum.‡Maurin quiere que entregues el brebaje de Maurin a Karnum en el Claro de Karnum.‡Maurin vous a demandé d’apporter la Décoction de Maurin à Karnum, au bosquet de Karnum.‡玛乌林要你将玛乌林的调和物交给卡隆林地的卡隆。‡莫林要你把莫林的化合物遞送給卡努姆林地的卡奴姆。',
  }
},
[14344] = {
  {
    'A derrocada de Jugkar‡Уничтожение Джукгара‡Jugkars Verderben‡죽카르의 몰락‡La ruina de Jugkar‡La ruina de Jugkar‡Juguler Jugkar‡祖格卡的垮台‡祖格卡的毀滅',
    nil,
    'Você deve usar o Núcleo de Força Infernal para controlar o Lorde Azrethoc no Altar de Jugkar e usar o poder dele para matar Jugkar Grim\'rod.‡Используйте источник мощи преисподней, чтобы взять под контроль лорда Азретока у алтаря Джукгара и использовать его силы для убийства Джугкара Грим\'рода.‡Ihr seid dazu auserkoren, den höllischen Kern der Macht zu verwenden, um an Jugkars Altar die Herrschaft über Lord Azrethoc zu übernehmen und mit dessen Kräften Jugkar Grimm\'rod zu vernichten.‡지옥의 마력 핵을 사용하여 죽카르의 제단에 있는 제왕 아즈레토크를 지배한 후, 그 힘으로 죽카르 그림로드를 처치해야 합니다.‡Utiliza el núcleo de energía infernal para controlar a Lord Azrethoc en el Altar de Jugkar y aprovecha su energía para matar a Jugkar Lug\'vara.‡Utiliza el núcleo de energía infernal para controlar a Lord Azrethoc en el Altar de Jugkar y aprovecha su energía para matar a Jugkar Lug\'vara.‡Vous devez utiliser le Noyau de puissance infernal pour prendre le contrôle du seigneur Azrethoc, à l’autel de Jugkar, et utiliser ses pouvoirs pour tuer Jugkar Grim’rod.‡你要在祖格卡的祭坛使用地狱动力核心控制魔王阿兹雷索克，用它的力量消灭祖格卡。‡用煉獄火能量核控制祖格卡祭壇的阿茲雷索克領主，並用它的力量殺死祖格卡。',
  }
},
[14345] = {
  {
    'Quando a esmola é muita‡Изматывающая учеба‡Waschtag‡완전한 실패‡Andar con ojo‡Andar con ojo‡Les apprentis‡被淘汰者‡筋疲力竭',
    nil,
    'Fale com Sorathos Fiachama, na Estação Norte da Foguetovia.‡Поговорите с Соратой Жонглирующим Огнем на северной пересадочной станции ракетной дороги.‡Sprecht mit Sorata Feuerspinner am Nördlichen Umschlagplatz der Raketenbahn.‡북부 로켓길 교역소에 있는 소라타 파이어스피너와 대화해야 합니다.‡Habla con Sorata Hilafuego en el Intercambiador de la Cohetepista del Norte.‡Habla con Sorata Hilafuego en el Intercambiador de la Cohetepista del Norte.‡Allez voir Sorata Filefeu à la Station nord du fusorail.‡同北方火箭车换乘站的索纳塔·火舞交谈‡在北方火箭道交會點和索拉塔·火紡說話。',
  }
},
[14346] = {
  {
    'Purificando Nossa Fenda Geológica‡Очищение нашей расселины‡Säubert unseren Riss‡협곡 정화‡Limpiando la grieta‡Limpiando la grieta‡Nettoyer notre crevasse‡清理我们的裂口‡淨化我們的裂縫',
    nil,
    'Karnum Tecelão do Pântano quer que você use a Concocção do Maurin para matar 10 Invasores Sibilâmina, 10 Sirenas Sibilâmina e 3 Gigantes do Mar.‡По поручению Карнума Ткача Болот убейте 10 захватчиков и 10 сирен из клана Скользящего Плавника, а также трех морских великанов при помощи зелья Маурина.‡Karnum Marschenwirker will, dass Ihr Maurins Gebräu verwendet, um 10 Eindringlinge der Zackenkämme, 10 Sirenen der Zackenkämme und 3 Meeresriesen zu töten.‡카눔 마쉬위버가 마우린의 혼합물을 사용하여 뱀갈퀴 침략자 10마리, 뱀갈퀴 세이렌 10마리, 바다 거인 3마리를 처치해 달라고 했습니다.‡Karnum Tejedor de Marismas quiere que utilices el brebaje de Maurin para matar a 10 invasores Filozante, a 10 sirenas Filozante y a 3 gigantes de mar.‡Karnum Tejedor de Marismas quiere que utilices el brebaje de Maurin para matar a 10 invasores Filozante, a 10 sirenas Filozante y a 3 gigantes de mar.‡Karnum Tisse-marais veut que vous utilisiez la Décoction de Maurin pour tuer 10 Envahisseurs ondulames, 10 Sirènes ondulames, et 3 Géants des mers.‡卡隆·沼织要你使用玛乌林的调和物杀死10名滑刃入侵者和10名滑刃海妖，以及3名海洋巨人。‡卡奴姆·沼織者希望你用莫林的化合物殺死10名滑刃入侵者、10名滑刃海妖和3名海巨人。',
  }
},
[14347] = {
  {
    'Mantenha a formação‡Держать строй!‡Bleibt standhaft‡전방을 사수하라‡Mantener el frente‡Mantener el frente‡Empêchez-les d\'avancer‡坚守阵地‡守住防線',
    nil,
    'Mate 10 Invasores Renegados.‡Убейте 10 отрекшихся-захватчиков.‡Tötet 10 Eindringlinge der Verlassenen.‡포세이큰 침략자 10명을 처치해야 합니다.‡Mata a 10 invasores Renegados.‡Mata a 10 invasores Renegados.‡Tuez 10 Envahisseurs réprouvés.‡击败10名入侵的被遗忘者。‡殺死10個被遺忘者入侵者。',
  }
},
[14348] = {
  {
    'Sozinho não dá‡Одному не справиться‡Ihr schafft sie nicht alleine‡합동 공격‡No puedes acabar con ellos solo‡No puedes acabar con ellos solo‡Impossible de s\'en charger seul‡合作‡你沒法獨自挑掉他',
    nil,
    'Use os Barris de Pólvora Negra para explodir 4 Abominações Horrendas.‡Воспользуйтесь черными бочонками с порохом, чтобы взорвать 4 кошмарных поганища.‡Jagt mit den Schwarzpulverfässern 4 entsetzliche Monstrositäten in die Luft.‡검은 화약통을 사용해 지독한 누더기골렘 4마리를 처치해야 합니다.‡Utiliza los barriles de pólvora negra para reventar 4 abominaciones horrorosas.‡Utiliza los barriles de pólvora negra para reventar 4 abominaciones horrorosas.‡Utilisez les Barils de poudre à canon noire pour faire exploser 4 Abominations affreuses.‡使用黑色火药桶炸死4只恐怖憎恶。‡使用黑色火藥桶炸飛4個恐怖的憎惡體。',
  }
},
[14349] = {
  {
    '‡Приказ по армии‡Der Befehl‡‡La llamada del teniente‡La llamada del teniente‡L\'appel du commandement‡上级的命令‡上級的命令',
    nil,
    '‡Отправляйтесь в Подгород и поговорите с леди Сильваной Ветрокрылой.‡Reist nach Unterstadt und sprecht mit Fürstin Sylvanas Windläufer.‡‡Viaja a Entrañas y habla con Sylvanas Brisaveloz.‡Viaja a Entrañas y habla con Sylvanas Brisaveloz.‡Aller à Fossoyeuse et parler à Dame Sylvanas Coursevent.‡‡出發到幽暗城找希瓦娜斯·風行者談話。',
  }
},
[14350] = {
  {
    'The Crimson Courier‡Курьер из Багрового Легиона‡Der Purpurrote Kurier‡진홍십자군 급사‡El mensajero carmesí‡El mensajero carmesí‡Le messager cramoisi‡红衣信使‡紅衣信差',
    nil,
    'Return to Eastern Plaguelands and track down the Crimson Courier. Kill the Courier and recover the Grand Crusader\'s Command.|n|nTake the command to Nathanos Blightcaller for further instruction.‡Возвращайтесь в Восточные Чумные земли и выследите курьера из Багрового Легиона. Убейте его и заберите приказ верховного рыцаря.|n|nЗа дальнейшими указаниями обращайтесь к Натаносу Гнилостню.‡Kehrt in die Östlichen Pestländer zurück und spürt den Purpurroten Kurier auf. Tötet den Kurier und schnappt Euch den Befehl des Obersten Kreuzfahrers.|n|nBringt den Befehl zu Nathanos Pestrufer und wartet auf weitere Anweisungen.‡동부 역병지대로 돌아가 진홍십자군 급사를 추적해야 합니다. 급사를 처치하고 십자군 사령관의 명령서를 회수해야 합니다.|n|n이 명령서를 나타노스 블라이트콜러에게 가져다주고 다음 지시를 받으십시오.‡Vuelve a las Tierras de la Peste del Este y encuentra al mensajero carmesí. Mata al mensajero y recupera la Orden del Gran Cruzado.|n|nLleva el documento a Nathanos Clamañublo y espera sus instrucciones.‡Vuelve a las Tierras de la Peste del Este y encuentra al mensajero carmesí. Mata al mensajero y recupera la Orden del Gran Cruzado.|n|nLleva el documento a Nathanos Clamañublo y espera sus instrucciones.‡Retourner dans les Maleterres de l’est et traquer le Messager cramoisi, le tuer et récupérer les Ordres du Grand croisé.|n|nApporter les Ordres à Nathanos le Flétrisseur pour obtenir des instructions supplémentaires.‡返回东瘟疫之地，找到并杀死红衣信使，拿到大十字军的命令。|n|n把命令交给纳萨诺斯·凋零者，并等待进一步的指示。‡回到東瘟疫之地並尋找出紅衣信差。把信差殺掉以取得大十字軍的命令。|n|n把命令交給納薩諾斯·凋零者並聽取下一個指示。',
  }
},
[14352] = {
  {
    'An Unholy Alliance‡Нечестивый союз‡Eine unheilige Allianz‡사악한 동맹‡Una alianza impía‡Una alianza impía‡Une alliance impie‡邪恶的盟友‡邪惡的盟友',
    nil,
    'Take the Small Scroll to Bragor Bloodfist in the Undercity.‡Отнесите маленький свиток Брагору Кровопалу в Подгород.‡Bringt die kleine Rolle zu Bragor Blutfaust nach Unterstadt.‡언더시티에 있는 브라고르 블러드피스트에게 작은 두루마리를 가져가야 합니다.‡Lleva el pergamino pequeño a Bragor Puñosangre, que está en Entrañas.‡Lleva el pergamino pequeño a Bragor Puñosangre, que está en Entrañas.‡Apporter le Petit parchemin à Bragor Poing-de-sang, à Fossoyeuse.‡把小卷轴交给幽暗城的布拉贡·血拳。‡把小卷軸交給幽暗城的貝拉戈·血拳。',
  }
},
[14353] = {
  {
    'An Unholy Alliance‡Нечестивый союз‡Eine unheilige Allianz‡사악한 동맹‡Una alianza impía‡Una alianza impía‡Une alliance impie‡邪恶的盟友‡邪惡的盟友',
    nil,
    'Bring Ambassador Malcin\'s Head to Bragor Bloodfist in the Undercity.‡Принести голову посла Брагору Кровопалу в Подгород.‡Bringt den Kopf von Botschafter Malcin zu Bragor Blutfaust nach Unterstadt.‡‡Lleva la cabeza del embajador Malcin a Bragor Puñosangre, que está en Entrañas.‡Lleva la cabeza del embajador Malcin a Bragor Puñosangre, que está en Entrañas.‡Apportez la Tête de l’ambassadeur Malcin à Bragor Poing-de-sang, à Fossoyeuse.‡将玛克林大师的信物交给幽暗城的布拉贡·血拳。‡把瑪克林大使的頭顱交給幽暗城的貝拉戈·血拳。',
  }
},
[14354] = {
  {
    'Dádivas de Eluna‡Дары Элуны‡Elunes Gaben‡엘룬의 선물‡Los dones de Elune‡Los dones de Elune‡Les cadeaux d\'Élune‡艾露恩的礼物‡伊露恩的禮物',
    nil,
    'Visite as Relíquias de Eluna em Sargeron.‡Отправьтесь к реликвиям Элуны в Саргероне.‡Besucht Elunes Relikte in Sargeron.‡살게론에서 엘룬의 성물을 찾아야 합니다.‡Visita las reliquias de Elune en Sargeron.‡Visita las reliquias de Elune en Sargeron.‡Examinez les Reliques d’Élune à Sargeron.‡造访萨格隆的艾露恩的遗迹。‡到薩格隆去查看伊露恩的聖物。',
  }
},
[14355] = {
  {
    'Into The Scarlet Monastery‡В монастырь Алого ордена‡In das Scharlachrote Kloster‡붉은십자군 수도원으로‡En el Monasterio Escarlata‡En el Monasterio Escarlata‡Au monastère écarlate‡进入血色修道院‡深入血色修道院',
    nil,
    'Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Bragor Bloodfist in the Undercity.‡Убейте верховного инквизитора Вайтмейн, командира Алого ордена Могрейна, Ирода из Алого ордена и псаря Локси, после этого вернитесь с докладом к Брагору Кровопалу в Подгород.‡Tötet Hochinquisitorin Weißsträhne, den Scharlachroten Kommandant Mograine, Herod, den Scharlachroten Helden sowie den Hundemeister Loksey und meldet Euch dann wieder bei Bragor Blutfaust in Unterstadt.‡종교재판관 화이트메인, 붉은십자군 사령관 모그레인, 붉은십자군 용사 헤로드와 사냥개조련사 록시를 처치한 후 언더시티에 있는 브라고르 블러드피스트에게 돌아가 보고해야 합니다.‡Mata a la alta inquisidora Melenablanca, al comandante Escarlata Mograine, a Herod el Campeón Escarlata y al maestro de canes Loksey, y después ve a ver de nuevo a Bragor Puñosangre a Entrañas.‡Mata a la alta inquisidora Melenablanca, al comandante Escarlata Mograine, a Herod el Campeón Escarlata y al maestro de canes Loksey, y después ve a ver de nuevo a Bragor Puñosangre a Entrañas.‡Tuez la grande inquisitrice Blanchetête, le commandant écarlate Mograine, Hérode le champion écarlate et le maître-chien Loksey, puis retournez faire votre rapport à Bragor Poing-de-sang à Fossoyeuse.‡消灭大检察官怀特迈恩、血色十字军指挥官莫格莱尼、血色十字军勇士赫洛德和驯犬者洛克希，然后向幽暗城的布拉贡·血拳。‡殺掉高階審判官懷特邁恩、血色十字軍指揮官莫格萊尼、血色十字軍勇士赫洛德和馴犬者洛克希，然後向幽暗城的貝拉戈·血拳回報。',
  }
},
[14356] = {
  {
    'The Power to Destroy...‡Силы разрушения...‡Die Macht zu Zerstören...‡파괴해야 할 힘‡Poder destructivo‡Poder destructivo‡Le pouvoir de détruire...‡毁灭的力量……‡毀滅之力…',
    nil,
    'Bring the books Spells of Shadow and Incantations from the Nether to Bragor Bloodfist in Undercity.‡Принесите книги "Заклинания Тьмы" и "Заклятия Пустоты" Брагору Кровопалу в Подгород.‡Bringt die Bücher \'Schattenzauber\' und \'Zauberformeln aus dem Nether\' zu Bragor Blutfaust nach Unterstadt.‡언더시티에 있는 브라고르 블러드피스트에게 어둠의 주문서와 황천의 마법서를 가져가야 합니다.‡Llévale los libros Hechizos de las Sombras y Encantamientos desde el infierno a Bragor Puñosangre, que está en Entrañas.‡Llévale los libros Hechizos de las Sombras y Encantamientos desde el infierno a Bragor Puñosangre, que está en Entrañas.‡Apportez les livres « Les Sorts de l’Ombre » et « Les Incantations du Néant » à Bragor Poing-de-sang, à Fossoyeuse.‡将《暗影法术研究》和《扭曲虚空的魔法》这两本书交给幽暗城的布拉贡·血拳。‡將《暗影法術研究》和《扭曲虛空的魔法》這兩本書交給幽暗城的貝拉戈·血拳。',
  }
},
[14357] = {
  {
    'Às armas!‡Оружие поверженного врага‡Zu den Waffen!‡최대한으로!‡¡Haz bien sin mirar a quién!‡¡Haz bien sin mirar a quién!‡Les sabres mouvants‡净化军刀！‡盡力去做!',
    nil,
    'Colete 20 Sabres de Sátiros de cavaletes de armas e dos vários sátiros da região.‡Соберите 20 сабель сатиров – возьмите с оружейных стоек или отберите у сатиров, обитающих в этих краях.‡Besorgt 20 Satyrsäbel aus dem Waffenregal und von den Satyrn aus der Gegend.‡이 지역에 있는 무기 선반이나 여러 종류의 사티로스에게서 사티로스 사브르를 20자루 모아야 합니다.‡Recoge 20 sables de sátiro de los expositores de armas y de varios sátiros de la zona.‡Recoge 20 sables de sátiro de los expositores de armas y de varios sátiros de la zona.‡Récupérez 20 Sabres de satyre dans les râteliers d’armes et sur les satyres de la région.‡从武器架以及各种萨特身上收集20把萨特军刀。‡從武器架上或此區域內各式各樣的薩特身上收集20柄薩特軍刀。',
  }
},
[14358] = {
  {
    'Dez libras de carne‡Десять фунтов плоти‡Zehn Pfund Fleisch‡살덩이 열 근‡10 kilos de carne‡10 kilos de carne‡Dix livres de chair‡十枚魔印‡十磅的血肉',
    nil,
    'Colete 10 pedaços de Carne de Sátiro dos vários sátiros em Sargeron.‡Добудьте 10 кусков плоти различных сатиров в Саргероне.‡Beschafft 10 Stücke Satyrfleisch von den zahlreichen Satyrn in Sargeron.‡살게론에 있는 여러 종류의 사티로스에게서 사티로스 살덩이를 10개 모아야 합니다.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron.‡Rassembler 10 lambeaux de Chair de satyre sur les satyres de Sargeron.‡从萨格隆的各种萨特身上收集10枚萨特魔印。‡從薩格隆各式各樣的薩特身上，收集10片薩特血肉。',
  }
},
[14359] = {
  {
    'Bênçãos do alto‡Благословение свыше‡Segen von oben‡하늘에서 내린 축복‡Bendiciones caídas del cielo‡Bendiciones caídas del cielo‡Bénédiction divine‡来自上天的恩赐‡從上面來的祝福',
    nil,
    'Você deve coletar 10 pedaços de Carne de Sátiro dos vários sátiros em Sargeron e colocá-los no Braseiro de Eluna.‡Добудьте 10 кусков плоти различных сатиров в Саргероне и возложите на жаровню Элуны.‡Ihr müsst 10 Stücke Satyrfleisch von den zahlreichen Satyrn in Sargeron beschaffen und sie in Elunes Kohlenbecken legen.‡살게론에 있는 여러 종류의 사티로스에게서 사티로스 살덩이를 10개 모은 후 엘룬의 화로에 올려놓아야 합니다.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron y colócalos en el blandón de Elune.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron y colócalos en el blandón de Elune.‡Vous devez rassembler 10 lambeaux de Chair de satyre provenant des satyres de Sargeron, et les déposer sur le Brasero d’Élune.‡从萨格隆的各种萨特身上收集10枚萨特魔印，将它们放在艾露恩的火盆上。‡你要從薩格隆各式各樣的薩特身上，收集10片薩特血肉，並把它們放在伊露恩的火盆上。',
  }
},
[14360] = {
  {
    'Nada que um par de melões não dê jeito‡Пара дынь решит любую проблему‡Nichts, was ein paar Melonen nicht richten können‡먹지 마세요, 피부에 양보하세요‡Nada que no puedan arreglar un par de melones‡Nada que no puedan arreglar un par de melones‡Choper le melon‡没什么是几颗瓜解决不了的‡沒有幾粒瓜搞不定的東西',
    nil,
    'Você deve coletar 8 Melões e espremer o sumo deles na Taça de Eluna, em Sargeron.‡Соберите 8 плодов дыни и выжмите их сок в кубок Элуны в Саргероне.‡Ihr müsst 8 Melonenfrüchte sammeln und ihren Saft in den Kelch von Elune in Sargeron pressen.‡멜론 8개를 모아 그 즙을 살게론에 있는 엘룬의 잔에 채워야 합니다.‡Recoge 8 melones y exprime su jugo en la Copa de Elune en Sargeron.‡Recoge 8 melones y exprime su jugo en la Copa de Elune en Sargeron.‡Vous devez rassembler 8 Melons et presser leur jus dans la Coupe d’Élune, à Sargeron.‡收集8枚瓜果，将它们的汁水挤到萨格隆的艾露恩之杯中去。‡你必須取得8顆瓜果，並把汁液擠進薩格隆的伊露恩聖杯裡。',
  }
},
[14361] = {
  {
    'Paz de espírito‡Спокойный сон капитана‡Seelenfrieden‡마음의 평화‡Paz mental‡Paz mental‡La paix de l’âme‡心平气和‡心中的平靜',
    nil,
    'Mate Kohor.‡Ликвидируйте Кохора.‡Tötet Kohor‡코호르를 처치해야 합니다.‡Mata a Kohor.‡Mata a Kohor.‡Tuez Kohor.‡杀死科霍。‡殺了庫霍。',
  }
},
[14362] = {
  {
    'As orelhas estão queimando‡Надрать уши‡Ein Satz heiße Ohren‡불타는 귀걸이‡Las orejas de Filo Ardiente‡Las orejas de Filo Ardiente‡Les oreilles qui chauffent‡火刃耳饰‡耳朵在燃燒',
    nil,
    'Junte 25 Orelhas da Lâmina Ardente.‡Добудьте 25 ушей орков Пылающего Клинка.‡Sammelt 25 Ohren von Mitgliedern der Brennenden Klinge.‡불타는 칼날단 귀걸이를 25개 모아야 합니다.‡Consigue 25 orejas de Filo Ardiente.‡Consigue 25 orejas de Filo Ardiente.‡Obtenez 25 Oreilles de la Lame ardente.‡收集25个火刃耳饰。‡收集25個燃刃的耳朵。',
  }
},
[14363] = {
  {
    'Você vai saber quando vir‡Ты поймешь, когда увидишь‡Ihr erkennt es, wenn Ihr es seht‡백문이 불여일견‡Lo sabrás cuando lo veas‡Lo sabrás cuando lo veas‡Vous le saurez quand vous le verrez‡眼见为实‡你看見就會明白',
    nil,
    'Encontre o Ritual de Evocação Antigo na Fortaleza Machado do Trovão.‡Найдите следы древнего ритуала призыва в крепости Громового Топора.‡Findet das uralte Beschwörungsritual in der Festung Donneraxt.‡천둥도끼 요새에서 고대 소환 의식을 찾아야 합니다.‡Encuentra el ritual de invocación antiguo en la Fortaleza del Hacha de Trueno.‡Encuentra el ritual de invocación antiguo en la Fortaleza del Hacha de Trueno.‡Trouvez l’Ancien rituel d’invocation dans la Forteresse de Hache-Tonnerre.‡前往雷斧堡垒，寻找远古召唤仪式羊皮卷。‡到雷斧堡壘找出上古召喚儀式。',
  }
},
[14364] = {
  {
    'Juntando as cabeças‡Голова на голове‡Die Köpfe zusammenstecken‡머리를 모으면‡Juntar cabezas‡Juntar cabezas‡Le casse-tête‡收集徽记‡把他們的頭綁在一起',
    nil,
    'O Capitão Pentigast, no Posto do Nijel, quer que você colete 100 Crânios Alvejados da Fortaleza Machado do Trovão, bote-os no Círculo de Evocação da Lâmina Ardente e, então, mate Nazargen.‡Соберите 100 отбеленных черепов в Крепости Громового Топора, затем принесите их в круг призыва Пылающего Клинка, вызовите и убейте Назаргена.‡Sammelt 100 gebleichte Schädel aus der Festung Donneraxt, stapelt sie am Beschwörungszirkel der Brennenden Klinge auf und tötet dann Nazargen.‡천둥도끼 요새에서 표백된 해골 100개를 모아 불타는 칼날단 소환 마법진에 놓은 다음 나자르겐을 처치해야 합니다.‡Recoge 100 calaveras blanquecinas en la Fortaleza del Hacha de Trueno, colócalas en el Círculo de Invocación del Filo Ardiente y después mata a Nazargen.‡Recoge 100 calaveras blanquecinas en la Fortaleza del Hacha de Trueno, colócalas en el Círculo de Invocación del Filo Ardiente y después mata a Nazargen.‡Rassemblez 100 Crânes blanchis de la Forteresse de Hache-Tonnerre, déposez-les dans le Cercle d’invocation de la Larme ardente, puis tuez Nazargen.‡在雷斧堡垒收集100个褪色的徽记，将它们放入火刃召唤法阵，然后杀死纳扎尔贡。‡去雷斧堡壘收集100個變白的顱骨，把顱骨放在燃刃召喚法陣，然後殺死納札爾干。',
  }
},
[14365] = {
  {
    'Ethel Rethor‡Этель-Ретор‡Ethel Rethor‡에텔 레소르‡Ethel Rethor‡Ethel Rethor‡Ethel Rethor‡艾瑟雷索‡艾瑟雷索',
    nil,
    'O Cabo Melquias quer que você fale com Korrah em Ethel Rethor.‡Капрал Мелкис хочет, чтобы вы поговорили с Коррой у Этель-Ретора.‡Korporal Melkins will, dass Ihr mit Korrah in Ethel Rethor sprecht.‡하사관 멜킨스가 에텔 레소르에 있는 코라와 대화해 달라고 했습니다.‡El cabo Melkins quiere que hables con Korrah en Ethel Rethor.‡El cabo Melkins quiere que hables con Korrah en Ethel Rethor.‡Le caporal Melkins vous a demandé d’aller parler à Korrah, à Ethel Rethor.‡麦尔金斯下士要你去艾瑟雷索跟库拉谈一谈。‡麥爾金斯下士要你到艾瑟雷索去與柯拉交談。',
  }
},
[14366] = {
  {
    'Aguentando firme‡Удержание позиций‡Durchhalten‡소강 상태‡Mantenerse firme‡Mantenerse firme‡Tenir bon‡沉着迎敌‡穩住',
    nil,
    'Fale com Gwen Armstead no Refúgio do Ocaso.‡Поговорите с Гвен Армстед в Темной Гавани.‡Sprecht mit Gwen Armstead in Dämmerhafen.‡어스름 안식처에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Parlez à Gwen Armstead à Havre-du-Soir.‡跟暮湾镇的格温·阿姆斯特谈一谈。‡與暮色港的葛玟·阿姆史特交談。',
  }
},
[14367] = {
  {
    'O porão dos Allen‡Подвал Фермы Аллена‡Allens Sturmkeller‡알렌의 폭풍 대피용 지하실‡El refugio de tormentas de Allen‡El refugio de tormentas de Allen‡L\'abri des Allen‡艾伦农场的防风地窖‡艾倫的防風地窖',
    nil,
    'Fale com o Lorde Godfrey dentro do abrigo contra tempestades da Fazenda dos Allen, em Guilnéas.‡Поговорите с лордом Годфри в подвале Фермы Аллена, что в Гилнеасе.‡Sprecht mit Lord Godfrey im Sturmkeller von Allens Bauernhof in Gilneas.‡길니아스에 있는 알렌 농장의 폭풍 대피용 지하실 안에서 전투를 지휘하는 고드프리 경과 대화해야 합니다.‡Habla con Lord Godfrey en el interior del refugio de tormentas de la Hacienda de Allen en Gilneas.‡Habla con Lord Godfrey en el interior del refugio de tormentas de la Hacienda de Allen en Gilneas.‡Parlez au Seigneur Godfrey dans l\'Abri de la Ferme des Allen, en Gilnéas.‡进入吉尔尼斯艾伦农场的防风地窖，跟高弗雷勋爵谈一谈。‡在吉爾尼斯，前往艾倫農莊裡的防風地窖和高佛雷領主談話。',
  }
},
[14368] = {
  {
    'Salvem as crianças!‡Спасите детей!‡Rettet die Kinder!‡아이들을 구하라!‡¡Salva a los niños!‡¡Salva a los niños!‡Sauvez les enfants !‡救救我的孩子！‡救救孩子!',
    nil,
    'Resgate a Cynthia, a Ashley e o James na Fazenda dos Hammond.‡Спасите Синтию, Эшли и Джеймса, которые остались где-то на ферме Хэммондов.‡Rettet Cynthia, Ashley und James in Hammonds Bauernhof.‡해몬드 농장에 있는 아이들인 신시아, 애쉴리, 제임스를 구출해야 합니다.‡Rescata a Cynthia, Ashley y James en la Hacienda de Hammond.‡Rescata a Cynthia, Ashley y James en la Hacienda de Hammond.‡Sauvez Cynthia, Ashley et James à la Ferme des Hammond.‡营救哈蒙德农场的辛西娅、阿什莉和詹姆斯。‡到漢孟德農莊解救辛西雅、艾西莉和詹姆士。',
  }
},
[14369] = {
  {
    'Worgenfobia‡Звериная сила‡Entfesselt die Bestie‡전장의 늑대인간‡Libera a la bestia‡Libera a la bestia‡Libérer la bête‡释放兽性‡釋放野獸',
    nil,
    'Mate 8 Soldados ou Marinheiros Renegados.‡Убейте 8 рядовых или матросов Отрекшихся.‡Tötet 8 Fußsoldaten der Verlassenen oder Seeleute der Verlassenen.‡포세이큰 보병 또는 선원 8명을 처치해야 합니다.‡Mata 8 soldados de a pie o marineros Renegados.‡Mata 8 soldados de a pie o marineros Renegados.‡Tuez 8 Fantassins ou Marins réprouvés.‡杀死8名被遗忘者步兵或是被遗忘者水手。‡殺死8名亡靈步行兵或亡靈水手。',
  }
},
[14370] = {
  {
    'O mistério da Azsharita‡Таинственный азшарит‡Rätselhaftes Azsharit‡신비로운 아즈샤리트‡La misteriosa azsharita‡La misteriosa azsharita‡La mystérieuse azsharite‡神秘的艾萨莱特水晶‡神祕的艾薩拉水晶',
    nil,
    'Colete 5 Amostras de Azsharita dos penhascos próximos.‡Соберите 5 образцов азшарита в ближайших скалах.‡Sammelt 5 Azsharitproben an den nahegelegenen Klippen.‡근처의 절벽에서 아즈샤리트 견본 5개를 모아야 합니다.‡Recoge 5 muestras de azsharita de los acantilados cercanos.‡Recoge 5 muestras de azsharita de los acantilados cercanos.‡Récupérez 5 Échantillons d’azsharite sur les falaises à proximité.‡在附近的悬崖收集五份艾萨莱特水晶样本。‡從附近的峭壁收集5份艾薩拉水晶樣本。',
  }
},
[14371] = {
  {
    'Fome de gigante‡Гигантская закуска‡Ein Riesenimbiss‡거인의 간식‡Un aperitivo gigantesco‡Un aperitivo gigantesco‡Un en-cas de géant‡巨型茶点‡巨大點心',
    nil,
    'Colete 8 Carcaças Mutiladas de Alanévoa dos Penedontes Alanévoa.‡Соберите 8 изуродованных туш скальных мокрокрылов.‡Sammelt 8 verstümmelte Nebelschwingenkadaver von Nebelschwingenkliffbewohnern.‡안개날개 절벽키메라를 처치하여 잘린 안개날개 시체 8개를 모아야 합니다.‡Reúne 8 cadáveres de Brumala mutilados de los habitariscos Brumala.‡Reúne 8 cadáveres de Brumala mutilados de los habitariscos Brumala.‡Récupérez 8 Carcasses brumailes mutilées sur les Hante-falaises brumailes.‡杀死雾翼崖居者，收集8具残缺的雾翼遗骸。‡從霧翼崖居者身上收集到8份殘缺的霧翼屍體。',
  }
},
[14372] = {
  {
    'Acampamento de Thargad‡Лагерь Таргада‡Thargads Lager‡타르가드 야영지‡El Campo de Thargad‡El Campo de Thargad‡Le camp de Thargad‡萨加德营地‡薩爾加德的營地',
    nil,
    'Karnum Tecelão do Pântano quer você fale com Thargad.‡Карнум Ткач Болот хочет, чтобы вы поговорили с Таргадом.‡Karnum Marschenwirker will, dass Ihr mit Thargad sprecht.‡카눔 마쉬위버가 타르가드와 대화해 달라고 했습니다.‡Karnum Tejedor de Marismas quiere que hables con Thargad.‡Karnum Tejedor de Marismas quiere que hables con Thargad.‡Karnum Tisse-marais veut que vous alliez parler à Thargad.‡卡隆·沼织要你跟萨加德谈一谈。‡卡奴姆·沼織者要你去和薩爾加德交談。',
  }
},
[14373] = {
  {
    'Invasão infernal‡Вторжение демонов‡Höllische Übergriffe‡밀려드는 지옥불정령‡Invasión infernal‡Invasión infernal‡Intrusion infernale‡入侵的地狱火‡地獄般的入侵',
    nil,
    'Destrua 10 Infernais Menores.‡Уничтожьте 10 младших инферналов.‡Tötet 10 niedere Höllenbestien.‡하급 지옥불정령 10마리를 처치해야 합니다.‡Destruye a 10 infernales inferiores.‡Destruye a 10 infernales inferiores.‡Détruisez 10 Infernaux inférieurs.‡杀死10个次级地狱火。‡摧毀10個次級煉獄火。',
  }
},
[14374] = {
  {
    'Portais da Legião‡Порталы Легиона‡Portale der Legion‡군단의 차원문‡Los portales de la Legión‡Los portales de la Legión‡Les portails de la Légion‡军团的传送门‡燃燒軍團的傳送門',
    nil,
    'Feche 6 Portais nas Ruínas de Mannoroc.‡Закройте 6 порталов на поле Маннорок.‡Verbannt 6 Portale beim Zirkel des Mannoroc.‡만노로크 소굴에서 악마의 차원문 6개를 없애야 합니다.‡Destruye 6 Portales en el Aquelarre Mannoroc.‡Destruye 6 Portales en el Aquelarre Mannoroc.‡Bannissez 6 Portails du Convent de Mannoroc.‡放逐玛诺洛克集会所的6扇传送门。‡在瑪諾洛克集會所放逐6個傳送門。',
  }
},
[14375] = {
  {
    'A última chance de humanidade‡Последняя капля человечности‡Die letzte Hoffnung auf Menschlichkeit‡인간성을 찾을 마지막 기회‡Última esperanza de humanidad‡Última esperanza de humanidad‡Dernier espoir d\'humanité‡人性的最后希望‡人性的最後機會',
    nil,
    nil,
  }
},
[14376] = {
  {
    'A derrocada de Jugkar‡Уничтожение Джукгара‡Jugkars Verderben‡죽카르의 몰락‡La ruina de Jugkar‡La ruina de Jugkar‡Juguler Jugkar‡祖格卡的垮台‡祖格卡的毀滅',
    nil,
    'Você deve usar o Núcleo de Força Infernal no Altar de Jugkar para controlar o Lorde Azrethoc e usar o poder dele para matar Jugkar Grim\'rod.‡Используйте источник мощи преисподней, чтобы взять под контроль лорда Азретока у алтаря Джукгара и использовать его силы для убийства Джугкара Грим\'рода.‡Ihr seid dazu auserkoren, den höllischen Kraftkern zu verwenden, um an Jugkars Altar die Herrschaft über Lord Azrethoc zu übernehmen und mit dessen Kräften Jugkar Grimm\'rod zu vernichten.‡지옥의 마력 핵을 사용하여 죽카르의 제단에 있는 제왕 아즈레토크를 지배한 후, 그 힘으로 죽카르 그림로드를 처치해야 합니다.‡Utiliza el núcleo de energía infernal para controlar a Lord Azrethoc en el Altar de Jugkar y aprovecha su energía para matar a Jugkar Lug\'vara.‡Utiliza el núcleo de energía infernal para controlar a Lord Azrethoc en el Altar de Jugkar y aprovecha su energía para matar a Jugkar Lug\'vara.‡Vous devez utiliser le Noyau de puissance infernal pour prendre le contrôle du seigneur Azrethoc, à l’autel de Jugkar, et utiliser ses pouvoirs pour tuer Jugkar Grim’rod.‡你要在祖格卡的祭坛使用地狱动力核心控制魔王阿兹雷索克，用它的力量消灭祖格卡。‡你要用煉獄火能量核控制祖格卡祭壇的阿茲雷索克領主，並用它的力量殺死祖格卡。',
  }
},
[14377] = {
  {
    'Grandes amigos‡Дружба с великанами‡Ein Freund der Riesen‡거인과 친해지기‡Entablar amistad con los gigantes‡Entablar amistad con los gigantes‡C’est géant !‡亲近巨人‡親近巨人',
    nil,
    'Fale com Gormungan, na entrada do Terminal Sul da Foguetovia e descubra o segredo da azsharita.‡Поговорите с Гормунганом у южной конечной станции ракетной дороги и узнайте секрет азшарита.‡Sprecht mit Gormungan außerhalb der Südlichen Endhaltestelle der Raketenbahn und entlockt ihm das Geheimnis des Azsharits.‡남부 로켓길 종착지 바깥에 있는 고르문간과 대화하여 아즈샤리트의 비밀을 알아내야 합니다.‡Habla con Gormungan fuera de la Terminal de la Cohetepista del Sur y averigua el secreto de la azsharita.‡Habla con Gormungan fuera de la Terminal de la Cohetepista del Sur y averigua el secreto de la azsharita.‡Allez voir Gormungan devant le Terminus sud du fusorail, et découvrez le secret de l’azsharite.‡同南部火箭车终点站外的格蒙刚交谈，找出艾萨莱特水晶的秘密‡在南方火箭道終點和戈穆恩甘說話並發掘艾薩拉水晶的祕密。',
  }
},
[14378] = {
  {
    'Caçando Brendol‡Охота на Брендола‡Die Jagd nach Brendol‡브렌돌을 잡아라‡Cazando a Brendol‡Cazando a Brendol‡La chasse à Brendol‡诛杀布伦多‡獵殺布倫多',
    nil,
    'Recupere a Algibeira do Brendol.‡Отыщите сумку Брендола.‡Beschafft Brendols Beutel.‡브렌돌의 가방을 획득해야 합니다.‡Recupera la cartera de Brendol.‡Recupera la cartera de Brendol.‡Récupérez la Sacoche de Brendol.‡找到布伦多的背包。‡帶回布倫多的背袋。',
  }
},
[14379] = {
  {
    'Um toque de lagostroc!‡Удар по лобстудару!‡Hummerstroks!‡마크루라 요리‡¡Delicias de langostrok!‡¡Delicias de langostrok!‡Homstrok au wok !‡嫩虾尾！‡搖滾蝦怪!',
    nil,
    'Consiga 7 Rabos de Lagostroc Tenros.‡Достаньте 7 сочных хвостов лобстудара.‡Beschafft 7 zarte Hummerstrokschwänze.‡부드러운 마크루라 꼬리를 7개 구해야 합니다.‡Consigue 7 colas de langostrok tiernas.‡Consigue 7 colas de langostrok tiernas.‡Obtenez 7 Queues de homstrok tendres.‡收集7条嫩虾尾。‡取得7只柔軟的蝦怪尾巴。',
  }
},
[14380] = {
  {
    'Uma descoberta impactante‡Впечатляющее открытие‡Eine bedeutsame Entdeckung‡굉장한 발견‡Un descubrimiento impactante‡Un descubrimiento impactante‡Une découverte cruciale‡令人瞩目的发现‡衝擊的大發現',
    nil,
    'Leve a Mistura Misteriosa para Karnum na Clareira de Karnum.‡Отнесите странное зелье Карнуму на Просеку Карнума.‡Bringt das mysteriöse Gebräu zu Karnum auf Karnums Lichtung.‡카눔의 숲에 있는 카눔에게 수수께끼의 혼합물을 가져가야 합니다.‡Lleva el brebaje misterioso a Karnum al Claro de Karnum.‡Lleva el brebaje misterioso a Karnum al Claro de Karnum.‡Apportez la Décoction mystérieuse à Karnum, à la clairière de Karnum.‡将神秘的调和物交给卡隆林地的卡隆。‡把神秘的化合物帶去卡努姆林地給卡努姆。',
  }
},
[14381] = {
  {
    'Purificando nossa fenda geológica‡Очищение нашей расселины‡Säubert unseren Riss‡협곡 정화‡Limpiando la grieta‡Limpiando la grieta‡Nettoyer notre crevasse‡清理我们的裂口‡淨化我們的裂縫',
    nil,
    'Use a Concocção do Maurin para matar 10 Invasores Sibilâmina, 10 Sirenas Sibilâmina e 3 Gigantes do Mar.‡Убейте 10 захватчиков и 10 сирен из клана Скользящего Плавника, а также трех морских великанов при помощи зелья Маурина.‡Verwendet Maurins Gebräu, um 10 Eindringlinge der Zackenkämme, 10 Sirenen der Zackenkämme und 3 Meeresriesen zu töten.‡마우린의 혼합물을 사용하여 뱀갈퀴 침략자 10마리, 뱀갈퀴 세이렌 10마리, 바다 거인 3마리를 처치해야 합니다.‡Utiliza el brebaje de Maurin para matar a 10 invasores Filozante, a 10 sirenas Filozante y a 3 gigantes de mar.‡Utiliza el brebaje de Maurin para matar a 10 invasores Filozante, a 10 sirenas Filozante y a 3 gigantes de mar.‡Utilisez la Décoction de Maurin pour tuer 10 Envahisseurs ondulames, 10 Sirènes ondulames, et 3 Géants des mers.‡使用玛乌林的调和物杀死10名滑刃入侵者和10名滑刃海妖，以及3名海洋巨人。‡使用莫林的化合物消滅10個滑刃入侵者，10個滑刃海妖，以及3個海巨人。',
  }
},
[14382] = {
  {
    'O worgen-bala‡Двое у моря‡Nimm mich mit, Kapitän, auf die Reise‡바다의 두 함선‡Dos junto al mar‡Dos junto al mar‡Deux réprouvés sont dans un bateau...‡海边的船长‡海上雙艦',
    nil,
    'Use as Catapultas dos Renegados para abordar os navios dos Renegados e mate o Capitão Morres e o Capitão Anderson.‡Воспользуйтесь катапультой Отрекшихся, чтобы попасть на корабли и убить капитанов – Морриса и Ансона.‡Benutzt die Katapulte der Verlassenen, um auf die Schiffe zu gelangen und tötet Kapitän Morris und Kapitän Anson.‡포세이큰 투석기를 이용해 배에 올라타 선장 모리스와 선장 앤슨을 처치해야 합니다.‡Utiliza las catapultas de los Renegados para abordar los barcos Renegados y mata al capitán Morris y al capitán Anson.‡Utiliza las catapultas de los Renegados para abordar los barcos Renegados y mata al capitán Morris y al capitán Anson.‡Utilisez les Catapultes des Réprouvés pour aborder leurs bateaux et tuer les Capitaines Morris et Anson.‡使用被遗忘者投石车登上被遗忘者战船，击败莫里斯船长和安森船长。‡利用被遺忘者投石車登上被遺忘者的船艦並分別殺死莫里斯船長和安森船長。',
  }
},
[14383] = {
  {
    'Os terríveis engenhoqueiros das Profundezas Devastadas‡Ужасные механики Опустошенного берега‡Die tobenden Tüftler der Verfallenen Gegenden‡버려진 착륙장의 골칫거리들‡Los terribles manitas de Las Ruinas‡Los terribles manitas de Las Ruinas‡Les affreux bricolos des confins Dévastés‡废墟海岸的邪恶侏儒‡廢墟海岸的不入流技工',
    nil,
    'Mate Blingo Apertaporca nas Profundezas Devastadas, e mais 4 Gnomos da Arma de Rede e 6 Gnomos Sapecadores.‡Убейте Бингема Прибамбаса на Опустошенном берегу, а вместе с ним 4 гномов с сетеметами и 6 гномов с шокерами.‡Tötet Bingham Federdings in den Verfallenen Gegenden und dazu 4 Netzgewehrgnome und 6 Britzelgnome.‡버려진 착륙장에서 그물총 노움 4명과 전기충격총 노움 6명, 그리고 빙엄 가젯스프링을 처치해야 합니다.‡Mata a Bingham Cacharretio, a 4 gnomos lanzarredes y a 6 gnomos machacados en Las Ruinas.‡Mata a Bingham Cacharretio, a 4 gnomos lanzarredes y a 6 gnomos machacados en Las Ruinas.‡Tuez Bingham Gadgetaressort aux Confins Dévastés, ainsi que 4 Gnomes lance-filet et 6 Gnomes zappeurs.‡击败废墟海岸里的宾汉姆，顺带干掉4名网枪侏儒和6名光枪侏儒。‡殺死廢墟海岸的賓漢‧機簧，以及4名網槍地精和6名電擊地精。',
  }
},
[14384] = {
  {
    'Redirecionamento!‡Изменение маршрута!‡Umgeleitet!‡경로 변경!‡El desvío‡El desvío‡Dérouté !‡被抓了！‡重新配送!',
    nil,
    'A Oficial Matilde quer que você vá na montaria dela até o Posto do Nijel e fale com o Cabo Melquias.‡Офицер Дженки хочет, чтобы вы, используя ее грифона, добрались до Высоты Найджела и поговорили с капралом Мелкисом.‡Offizierin Jankie möchte, dass Ihr auf ihrem Reittier zur Nijelspitze fliegt und dort mit Korporal Melkins sprecht.‡장교 쟁키가 그녀의 탈것을 타고 나이젤의 야영지로 가서 하사관 멜킨스와 대화해 달라고 했습니다.‡La oficial Jankie quiere que utilices su montura para ir hasta Punta de Nijel y que hables con el cabo Melkins.‡La oficial Jankie quiere que utilices su montura para ir hasta Punta de Nijel y que hables con el cabo Melkins.‡L’officier Jankie veut que vous utilisiez sa monture jusqu’à la Combe de Nijel et que vous alliez parler au Caporal Melkins.‡军官金妮要你乘她的坐骑前往尼耶尔前哨站去跟麦尔金斯下士谈一谈。‡軍官薔琪希望你用她的坐騎到尼耶爾前哨站和麥爾金斯下士談話。',
  }
},
[14385] = {
  {
    'Experimento com azsharita Nº1‡Первый эксперимент с азшаритом‡Azsharitexperiment Nummer Eins‡첫 번째 아즈샤리트 실험‡El primer experimento de azsharita‡El primer experimento de azsharita‡Azsharite : expérience n° 1‡艾萨莱特水晶实验一号‡艾薩拉水晶實驗計畫一',
    nil,
    'Pegue um Laxante Tamanho Gigante da torre dos gnomos, nas Profundezas Devastadas. Tente dar o Laxante para Gormungan, o gigante.‡Заберите гигантскую порцию слабительного из башни гномов на Опустошенном берегу. Попытайтесь накормить слабительным великана Гормунгана.‡Besorgt Euch ein Abführmittel in Riesengröße von dem Gnomenturm in den Verfallenen Gegenden. Versucht, das Abführmittel dem Riesen Gormungan zu verabreichen.‡버려진 착륙장에 있는 노움 탑에서 거인용 설사제를 손에 넣은 다음 고르문간에게 먹여야 합니다.‡Coge un laxante de tamaño gigante de la torre de los gnomos situada en Las Ruinas. Después, intenta dárselo al gigante Gormungan.‡Coge un laxante de tamaño gigante de la torre de los gnomos situada en Las Ruinas. Después, intenta dárselo al gigante Gormungan.‡Récupérez un Laxatif format géant dans la tour gnome des Confins Dévastés. Essayez ensuite de le faire avaler au géant Gormungan.‡从废墟海岸的侏儒塔里拿一剂巨人用量的泻药。想办法喂给格蒙刚吃。‡從廢墟海岸的地精塔裡取得巨型瀉藥。試著讓巨人戈穆恩甘吃下瀉藥。',
  }
},
[14386] = {
  {
    'A líder do bando‡Вожак стаи‡Der Leithund‡무리의 지휘자‡Líder de la manada‡Líder de la manada‡Le chef de la meute‡敌军的首领‡群龍之首',
    nil,
    'Use o Apito para Mastins para ajudá-lo a matar a Patrulheira Sombria Thyala.‡Выследите темного следопыта Тиалу и убейте ее с помощью мастифов.‡Benutzt die Mastiffpfeife, um Hilfe dabei zu bekommen, Dunkelläuferin Thyala zu töten.‡파수견 호루라기를 이용해 어둠 순찰자 티알라를 제거해야 합니다.‡Utiliza el silbato para mastines para poder matar a la forestal oscura Thyala.‡Utiliza el silbato para mastines para poder matar a la forestal oscura Thyala.‡Aidez-vous du Sifflet de mastiff pour tuer le forestier sombre Thyala.‡使用训犬口哨，在猎犬的帮助下击败黑暗游侠西亚拉。‡利用獒犬狗哨幫助你殺死黑暗遊俠瑟雅拉。',
  }
},
[14387] = {
  {
    'Reconhecimento do terreno‡Дела на местности‡Beschaffenheit des Geländes‡상황 살피기‡Preparar el terreno‡Preparar el terreno‡Tâter le terrain‡形势‡情勢判斷',
    nil,
    'O Capitão Pentigast quer que você fale com Vahlarriel no Posto do Nijel.‡Капитан Пентигаст хочет, чтобы вы поговорили с Валлариэлем в Высоте Найджела.‡Hauptmann Pentigast möchte, dass Ihr mit Vahlarriel auf der Nijelspitze sprecht.‡대장 펜티가스트가 나이젤의 야영지에 있는 발라리엘과 대화해 달라고 했습니다.‡El capitán Pentigast quiere que hables con Vahlarriel en Punta de Nijel.‡El capitán Pentigast quiere que hables con Vahlarriel en Punta de Nijel.‡Le capitaine Pentigast vous a demandé d’aller parler à Vahlarriel, à la combe de Nijel.‡本迪加斯上尉要你去跟尼耶尔前哨站的瓦拉里尔谈一谈。‡潘迪加斯上尉要你到尼耶爾前哨站去與瓦拉里爾交談。',
  }
},
[14388] = {
  {
    'Experimento com azsharita Nº2‡Второй эксперимент с азшаритом‡Azsharitexperiment Nummer Zwei‡두 번째 아즈샤리트 실험‡El segundo experimento de azsharita‡El segundo experimento de azsharita‡Azsharite : expérience n° 2‡艾萨莱特水晶实验二号‡艾薩拉水晶實驗計畫二',
    nil,
    'Fale com a Assistente Grilly para ser encolhido ao tamanho de um rato. Monte num Rato da Foguetovia e use-o para aterrorizar Gormungan, o gigante.‡Сообщите ассистентке Грили, что вы готовы быть уменьшенным до размера крысы. Затем оседлайте крысу ракетной дороги и воспользуйтесь ею, чтобы напугать великана Гормунгана.‡Sprecht mit Assistentin Greely, um auf Rattengröße zusammengeschrumpft zu werden. Steigt auf eine Ratte der Raketenbahn und jagt Gormungan dem Riesen damit Angst ein.‡조수 그릴리와 대화해 쥐와 비슷한 크기로 몸집을 줄이십시오. 로켓길 쥐에 올라탄 다음 고르문간을 겁줘야 합니다.‡Habla con la asistente Greely para que te encoja. Monta una rata de la Cohetepista y utilízala para aterrorizar al gigante Gormungan.‡Habla con la asistente Greely para que te encoja. Monta una rata de la Cohetepista y utilízala para aterrorizar al gigante Gormungan.‡Allez voir l’Assistante Greely pour qu’elle vous donne la taille d’un rat. Enfourchez un Rat du fusorail et utilisez-le pour terrifier le géant Gormungan.‡同助手格瑞里谈谈，让他把你缩成老鼠一般大小。再骑一只火箭老鼠去吓唬巨人格蒙刚。‡和助理格里利談話好讓他將你縮到老鼠大小。騎上一隻火箭道鼠並用牠來嚇巨人戈穆恩甘。',
  }
},
[14389] = {
  {
    'Não era óbvio?‡Разве не очевидно?‡War das nicht klar?‡분명하지 않은가요?‡¿No era obvio?‡¿No era obvio?‡C\'était évident !‡难道不是很明显吗？‡不是很明顯嗎?',
    nil,
    'Use o portal atrás de Joana, na torre de Tauriel, para encontrar Anara, o Anjo da Cura. E, quem sabe, Azuregos.‡Воспользуйтесь порталом за спиной Джоанны в башне Ксилема, чтобы найти Анару целительницу душ и, возможно, Азурегоса.‡Benutzt das Portal hinter Joanna in Xylems Turm, um Anara, die Geistheilerin - und hoffentlich Azuregos - zu finden.‡실렘의 탑에서 조안나 뒤쪽의 차원문을 이용하여 영혼의 치유사 아나라와 아주어고스를 찾아야 합니다.‡Utiliza el portal que hay detrás de Joanna en la Torre de Xylem para encontrar a Anara, el ángel de la Resurrección, y, con un poco de suerte, a Azuregos.‡Utiliza el portal que hay detrás de Joanna en la Torre de Xylem para encontrar a Anara, el ángel de la Resurrección, y, con un poco de suerte, a Azuregos.‡Utilisez le portail derrière Joanna à la Tour de Xylem pour trouver Anara la Gardienne des âmes et, avec un peu de chance, Azuregos.‡使用克希雷姆高塔里乔安娜后面的传送门找到灵魂医者安娜拉——可能的话，还有艾索雷葛斯。‡在克希雷姆的塔裡，使用瓊安娜身後的傳送門找到靈魂醫者安娜拉，如果幸運的話，還有艾索雷葛斯。',
  }
},
[14390] = {
  {
    'Se fosse fácil não teria graça‡Когда легко – скучно‡Einfach kann jeder‡쉬운 일은 시시한 법‡Fácil significa aburrido‡Fácil significa aburrido‡Pourquoi faire simple quand on peut faire compliqué ?‡好事多磨‡簡單就是無聊',
    nil,
    'Convença Azuregos a retornar ao mundo dos vivos e se encontrar com Kalecgos.‡Убедите Азурегоса прекратить отшельничество и встретиться с Калесгосом.‡Überzeugt Azuregos, in die Welt der Lebenden zurückzukehren und sich mit Kalecgos zu treffen.‡산 자들의 세계로 돌아가 칼렉고스와 만나라고 아주어고스를 설득해야 합니다.‡Convence a Azuregos para que regrese al mundo de los vivos y se reúna con Kalecgos.‡Convence a Azuregos para que regrese al mundo de los vivos y se reúna con Kalecgos.‡Persuadez Azuregos de regagner le monde des vivants et de rencontrer Kalecgos.‡说服艾索雷葛斯返回物质世界同卡雷苟斯汇合。‡說服艾索雷葛斯回到生者的世界並和卡雷苟斯會面。',
  }
},
[14391] = {
  {
    'Virando a mesa‡Смена ролей‡Das Blatt wenden‡형세 역전‡Cambiando las tornas‡Cambiando las tornas‡Retournement de situation‡扭转局面‡逆轉情勢',
    nil,
    'Fale com Anara para voltar ao mundo dos vivos, então vá encontrar Kalecgos no Terminal Norte da Foguetovia.‡Поговорите с Анарой, чтобы вернуться в мир живых, а затем встретьтесь с Калесгосом на северной конечной станции ракетной дороги.‡Sprecht mit Anara, um in die Welt der Lebenden zurückzukehren, dann sprecht mit Kalecgos an der Nördlichen Endhaltestelle der Raketenbahn.‡아나라와 대화하여 산 자들의 세계로 돌아온 다음 북부 로켓길 종착지에 있는 칼렉고스와 만나야 합니다.‡Habla con Anara para regresar al mundo de los vivos. Después reúnete con Kalecgos en la Terminal de la Cohetepista del Norte.‡Habla con Anara para regresar al mundo de los vivos. Después reúnete con Kalecgos en la Terminal de la Cohetepista del Norte.‡Allez voir Anara pour revenir dans le monde des vivants, puis retrouvez Kalecgos au Terminus nord du fusorail.‡同安娜拉交谈，返回生者世界，然后与卡雷苟斯在北部火箭车终点站见面。‡和安娜拉談話來回到生者的世界，然後在北方火箭道終點和卡雷苟斯會面。',
  }
},
[14392] = {
  {
    'Adeus, pequena criatura‡Прощай, рыбка‡Leb wohl, Minnow‡잘 가라, 작은 존재여‡Adiós, pezqueñín‡Adiós, pezqueñín‡Ce n’est qu’un au revoir‡再见吾爱，还有米诺鱼‡再見了，小魚',
    nil,
    'Fale com Sorathos Fiachama, no Ancoradouro Borraquilha.‡Поговорите с Соратой Жонглирующим Огнем в Гавани Трюмных Вод.‡Sprecht mit Sorata Feuerspinner im Bilgewasserhafen.‡빌지워터 항만에 있는 소라타 파이어스피너와 대화해야 합니다.‡Habla con Sorata Hilafuego en el Muelle Pantoque.‡Habla con Sorata Hilafuego en el Muelle Pantoque.‡Allez voir Sorata Filefeu au Havre Baille-Fonds.‡与锈水港的索纳塔谈谈。‡在污水碼頭和索拉塔·火紡談話。',
  }
},
[14393] = {
  {
    'Ao combate!‡В бой!‡Auf in den Kampf!‡격전을 향해!‡¡A la refriega!‡¡A la refriega!‡Au cœur de la bataille !‡开战吧！‡加入戰鬥!',
    nil,
    'O Khan Leh\'Prah quer que você derrote 15 Bruxos da Lâmina Ardente, 3 Demonarcas Invasores e a Sacerdotisa Than\'darissa.|n|nFale com Khan Leh\'Prah para entrar em combate.‡Хан Ле\'прах хочет, чтобы вы убили 15 чернокнижников из клана Пылающего Клинка, 3 стражников ужаса -захватчиков и жрицу Тан\'дариссу.|n|nПоговорите с ханом Ле\'прахом, чтобы вступить в бой.‡Khan Leh\'prah möchte, dass Ihr 15 Hexenmeister der Brennenden Klinge, 3 Verdammniswacheneindringlinge und Priesterin Than\'darissa besiegt.|n|nSprecht mit Khan Leh\'prah, um in den Kampf zu ziehen.‡칸 레프라가 불타는 칼날단 흑마법사 15명, 파멸의 수호병 침략자 3명, 여사제 탄다리사를 쓰러뜨려 달라고 했습니다.|n|n전투에 참가하려면 칸 레프라와 이야기하십시오.‡El Khan Leh\'prah quiere que derrotes a 15 brujos Filo Ardiente, 3 invasores guardias apocalípticos y a la sacerdotisa Than\'darissa.|n|nHabla con el Khan Leh\'prah para ir a la batalla.‡El Khan Leh\'prah quiere que derrotes a 15 brujos Filo Ardiente, 3 invasores guardias apocalípticos y a la sacerdotisa Than\'darissa.|n|nHabla con el Khan Leh\'prah para ir a la batalla.‡Le khan Leh’prah vous a demandé de tuer 15 Démonistes de la Lame ardente, 3 Envahisseurs de la Garde funeste, et la Prêtresse Than’darissa.|n|nAllez parler au khan Leh’prah pour vous rendre sur le champ de bataille.‡力普拉可汗要你击败15名火刃术士、3名末日守卫入侵者以及女祭司桑德丽萨。|n|n跟力普拉可汗交谈，发动攻击。‡雷普拉可汗要你打敗15個燃刃術士、3個末日守衛入侵者、以及女祭司桑達里莎。|n|n與雷普拉可汗交談以加入戰鬥。',
  }
},
[14394] = {
  {
    'Morte a Agogridon‡Смерть Агогридону!‡Tod dem Agogridon‡아고그리돈에게 죽음을‡Muerte a Agogridon‡Muerte a Agogridon‡L\'agonie d\'Agogridon‡埃高戈里登的死亡‡亞勾格里敦之死',
    nil,
    'Derrote Agogridon.‡Убейте Агогридона.‡Besiegt Agogridon.‡아고그리돈을 처치해야 합니다.‡Derrota a Agogridon‡Derrota a Agogridon‡Vaincre Agogridon‡击败埃高戈里登。‡擊敗亞勾格里敦',
  }
},
[14395] = {
  {
    'Afogados‡Слушая наше дыхание‡Atemlos‡호흡 곤란‡Luchando por respirar‡Luchando por respirar‡Besoin d\'air‡屏住呼吸‡驚慌失措',
    nil,
    'Resgate 4 Vigilantes em Afogamento.‡Cпасите 4 утопающих стражей.‡Rettet 4 ertrinkende Wachleute.‡물에 빠진 경비병 4명을 구출해야 합니다.‡Rescata a 4 veladores sumidos.‡Rescata a 4 veladores sumidos.‡Portez secours à 4 Veilleurs qui se noient.‡营救4名溺水的哨兵。‡解救4名溺水的警備兵。',
  }
},
[14396] = {
  {
    'A terra treme‡И земля содрогнулась‡Als das Land zerbarst‡대지가 무너질 때‡Mientras la tierra se hace añicos‡Mientras la tierra se hace añicos‡Pendant que la terre se fracture‡天崩地裂‡當大地碎裂',
    nil,
    'Fale com o Príncipe Liam Greymane do lado de fora da Fazenda dos Allen.‡Поговорите с принцем Лиамом Седогривом на Ферме Аллена.‡Sprecht mit Prinz Liam Graumähne auf Allens Bauernhof.‡알렌 농장에 있는 왕자 리암 그레이메인과 대화해야 합니다.‡Habla con el príncipe Liam Cringris en la Hacienda de Allen.‡Habla con el príncipe Liam Cringris en la Hacienda de Allen.‡Parlez au Prince Liam Grisetête à la Ferme des Allen.‡跟艾伦农场的利亚姆·格雷迈恩王子谈一谈。‡在艾倫農莊和黎姆·葛雷邁恩王子談話。',
  }
},
[14397] = {
  {
    'A evacuação‡Эвакуация‡Evakuierung‡대피‡Evacuación‡Evacuación‡L\'évacuation‡撤退行动‡疏散',
    nil,
    'Fale com Gwen Armstead no Refúgio do Ocaso.‡Поговорите с Гвен Армстед в Темной Гавани.‡Sprecht mit Gwen Armstead in Dämmerhafen.‡어스름 안식처에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Parlez à Gwen Armstead à Havre-du-Soir.‡跟暮湾镇的格温·阿姆斯特谈一谈。‡在暮色港和葛玟·阿姆史特談話。',
  }
},
[14398] = {
  {
    'Vó Wahl‡Бабуля Валь‡Oma Wahl‡왈 할머니‡La abuela Wahl‡La abuela Wahl‡Grand-maman Wahl‡薇儿外婆‡瓦爾祖母',
    nil,
    'Encontre a Vó Wahl na Cabana dos Wahl.‡Найдите бабулю Валь в ее домике.‡Findet Oma Wahl in Wahls Landhaus.‡왈 산장에서 왈 할머니를 찾아야 합니다.‡Encuentra a la abuela Wahl en la Cabaña de Wahl.‡Encuentra a la abuela Wahl en la Cabaña de Wahl.‡Trouvez Grand-maman Wahl au Cottage des Wahl.‡前往薇儿小屋，找到薇儿外婆。‡到瓦爾小屋找瓦爾祖母。',
  }
},
[14399] = {
  {
    'A vovó pirou mesmo‡Девичья память‡Oma hat sie nicht mehr alle‡할머니의 건망증‡La abuela no rige bien‡La abuela no rige bien‡Grand-maman a complètement perdu l\'esprit‡失踪的宝贝‡祖母真的是老糊塗了',
    nil,
    'Encontre o Livro Envolto em Linho.‡Найдите завернутую в холст книгу.‡Findet das leinengebundene Buch.‡리넨으로 싼 책을 찾아야 합니다.‡Encuentra el libro envuelto en lino.‡Encuentra el libro envuelto en lino.‡Trouvez le Livre enroulé dans un linge.‡找到亚麻布包裹的书籍。‡找回亞麻外皮書冊。',
  }
},
[14400] = {
  {
    'Não visto isso nem morta!‡Мне нечего надеть!‡So gehe ich nicht außer Haus‡할머니의 나들이옷‡No puedo llevar esto‡No puedo llevar esto‡Je ne peux pas porter ça‡我不要穿成这样‡這我不能穿',
    nil,
    'Pegue as Roupas Boas da Vovó.‡Принесите бабушкино выходное платье.‡Besorgt Omas gute Kleider.‡할머니의 나들이옷을 구해야 합니다.‡Encuentra la ropa buena de la abuela.‡Encuentra la ropa buena de la abuela.‡Récupérez les Vêtements de bonne qualité de grand-maman.‡取回外婆的漂亮衣服。‡收回祖母的好衣裳。',
  }
},
[14401] = {
  {
    'O gato da vovó‡Любимый кот бабули‡Omas Katze‡할머니의 고양이‡El gato de la abuela‡El gato de la abuela‡Le chat de grand-maman‡外婆的猫咪‡祖母的貓',
    nil,
    'Resgate Lucky, o gato da vovó.‡Найдите кота Шанса.‡Holt Felix, die Katze.‡고양이 희망이를 데려가야 합니다.‡Recupera a Suertudo el gato.‡Recupera a Suertudo el gato.‡Retrouvez Chance le chat.‡找回黄猫小运。‡帶回小貓『運氣』。',
  }
},
[14402] = {
  {
    'Pronta para partir‡В путь!‡Abmarschbereit‡출발 준비 완료‡Listos para partir‡Listos para partir‡Prête à partir‡准备就绪‡準備好出發',
    nil,
    'Fale com Gwen Armstead no Refúgio do Ocaso.‡Поговорите с Гвен Армстед в Темной Гавани.‡Sprecht mit Gwen Armstead in Dämmerhafen.‡어스름 안식처에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Parlez à Gwen Armstead à Havre-du-Soir.‡跟暮湾镇的格温·阿姆斯特谈一谈。‡在暮色港和葛玟·阿姆史特談話。',
  }
},
[14403] = {
  {
    'Os irmãos Hayward‡Братья Хейварды‡Die Brüder Hayward‡헤이워드 형제‡Los hermanos Hayward‡Los hermanos Hayward‡Les frères Hayward‡海瓦尔德兄弟‡海華德兄弟',
    nil,
    'Fale com Sebastian Hayward na Colônia de Pesca Hayward.‡Поговорите с Себастьяном Хейвардом в Рыбном хозяйстве Хейварда.‡Sprecht mit Sebastian Hayward in der Fischerei Hayward.‡헤이워드 양어장에 있는 세바스찬 헤이워드와 대화해야 합니다.‡Habla con Sebastian Hayward en el Caladero Hayward.‡Habla con Sebastian Hayward en el Caladero Hayward.‡Parlez à Sebastian Hayward aux Pêcheries Hayward.‡跟海瓦尔德渔场的塞巴斯蒂安·海瓦尔德谈一谈。‡與海華德漁場的塞巴斯汀·海華德交談。',
  }
},
[14404] = {
  {
    'Remendando buraco‡Судно требует ремонта‡Nicht alles im Lot auf\'m Boot‡쉽지 않은 상황‡No tiene forma de barco‡No tiene forma de barco‡Pas très bon état général‡丢三落四‡不成船形',
    nil,
    'Pegue Pranchas de Madeira, Piche de Hulha e as Ferramentas do Construtor Naval.‡Найдите доски, угольную смолу и инструменты корабельного плотника.‡Besorgt Holzplanken, Kohlenteer und Schiffbauerwerkzeuge.‡나무 판자, 콜타르, 조선공의 도구를 획득해야 합니다.‡Consigue tablones de madera, alquitrán de carbón y herramientas de carpintería de barcos.‡Consigue tablones de madera, alquitrán de carbón y herramientas de carpintería de barcos.‡Trouvez des Planches de bois, du Goudron de charbon et des Outils de charpentier naval.‡找到厚木板、煤焦油和造船者的工具。‡取得木板、柏油，和造船工人的工具。',
  }
},
[14405] = {
  {
    'Fuga pelo mar‡Спасение в море‡Flucht zur See‡바다로 대피‡Escape por mar‡Escape por mar‡L\'évasion par la mer‡海路出逃‡由海路潛逃',
    nil,
    'Fale novamente com Gwen Armstead no Refúgio do Ocaso.‡Вернитесь к Гвен Армстед в Темную Гавань.‡Kehrt zu Gwen Armstead in Dämmerhafen zurück.‡어스름 안식처에 있는 그웬 암스테드에게 가야 합니다.‡Vuelve con Gwen Armstead en el Refugio del Ocaso.‡Vuelve con Gwen Armstead en el Refugio del Ocaso.‡Parlez à Gwen Armstead à Havre-du-Soir.‡返回暮湾镇，向格温·阿姆斯特复命。‡回到暮色港找葛玟·阿姆史特。',
  }
},
[14406] = {
  {
    'O Horto dos Crowley‡Сад Краули‡Crowleys Obstgarten‡크롤리 과수원‡El Huerto de Crowley‡El Huerto de Crowley‡Le verger de Crowley‡克罗雷果园‡克羅雷果園',
    nil,
    'Fale com Lorna Crowley no Horto dos Crowley.‡Поговорите с Лорной Краули в саду Краули.‡Sprecht mit Lorna Crowley bei Crowleys Obstgarten.‡크롤리 과수원에 있는 로르나 크롤리와 대화해야 합니다.‡Habla con Lorna Crowley en el Huerto de Crowley.‡Habla con Lorna Crowley en el Huerto de Crowley.‡Parlez à Lorna Crowley au Verger de Crowley.‡跟克罗雷果园的罗娜·克罗雷谈一谈。‡在克羅雷果園和羅娜·克羅雷談話。',
  }
},
[14407] = {
  {
    'Blues de Azshara‡Тоска Азшары‡Azshara Blues‡아즈샤라의 푸른 빛‡El blues de Azshara‡El blues de Azshara‡Le blues d’Azshara‡艾萨拉的蓝龙‡艾薩拉之藍',
    nil,
    'Encontre Kalec no Ancoradouro Borraquilha.‡Отправляйтесь к Кейлеку в Гавань Трюмных Вод.‡Sprecht mit Kalec im Bilgewasserhafen.‡빌지워터 항만에 있는 칼렉과 만나야 합니다.‡Reúnete con Kalec en el Muelle Pantoque.‡Reúnete con Kalec en el Muelle Pantoque.‡Retrouvez Kalec au Havre Baille-Fonds.‡同锈水港的卡雷会面。‡在污水碼頭和卡雷苟斯碰面。',
  }
},
[14408] = {
  {
    'O Plano da 9‡План объекта номер 9‡Neuns Plan‡9번 실험체의 계획‡El plan de Nueve‡El plan de Nueve‡Le plan de n° 9‡九号实验品的计划‡實驗體九號的計畫',
    nil,
    'Pegue os Esboços Secretos de Foguete que estão nos Arquivos do Laboratório, na parte leste do Laboratório Secreto. Toque a campainha da porta e mate o diretor do laboratório quando ele aparecer.‡Найдите чертежи секретной ракеты в здании архива в восточной части лаборатории. Воспользуйтесь дверным звонком и убейте директора лаборатории, когда он появится.‡Beschafft die geheimen Raketenbaupläne aus den Laborarchiven am östlichen Ende des Geheimlabors. Betätigt die Türklingel und tötet den Labordirektor, wenn er herauskommt.‡비밀 실험실 동쪽 끝에 있는 실험실 기록 보관소에서 비밀 로켓 설계도를 획득해야 합니다. 밖에서 초인종을 울리고 실험실 관리자가 나오면 그를 처치해야 합니다.‡Consigue los diseños del cohete secreto en el edificio de los archivos del laboratorio situado en el extremo este de El Laboratorio Secreto. Llama al timbre de la puerta que hay en el exterior y mata al director cuando salga.‡Consigue los diseños del cohete secreto en el edificio de los archivos del laboratorio situado en el extremo este de El Laboratorio Secreto. Llama al timbre de la puerta que hay en el exterior y mata al director cuando salga.‡Récupérez les Plans secrets de la fusée dans le bâtiment des Archives du laboratoire, à l’extrémité est du Laboratoire secret. Sonnez à la porte et tuez le Directeur du laboratoire à son arrivée.‡从秘密实验室东头的实验室档案馆里获取秘密火箭图纸。按下实验室的门铃并杀掉出现的实验室主管。‡從秘密實驗室東端的實驗室檔案庫建築取得秘密火箭設計圖。按下門外的門鈴並在實驗室負責人出來應門時殺死他。',
  }
},
[14409] = {
  {
    'Um retorno cauteloso‡Осторожное возвращение‡Eine vorsichtige Rückkehr‡조심스러운 귀환‡Un regreso cauteloso‡Un regreso cauteloso‡Un retour prudent‡谨慎的回访‡謹慎的回歸',
    nil,
    'Leve o Diário de Daros para Morden Sombracerta em Darnassus.‡Отнесите журнал Дароса Морденту Вечерней Тени в Дарнас.‡Bringt Mordent Schattenfall in Darnassus Daros\' Tagebuch.‡다르나서스에 있는 모든트 이븐셰이드에게 다로스의 일지를 가져가야 합니다.‡Lleva el diario de Daros a Mordent Sombrapar en Darnassus.‡Lleva el diario de Daros a Mordent Sombrapar en Darnassus.‡Apportez le Journal de Daros à Mordent Ombrégale à Darnassus.‡将达罗斯的日记带给身处达纳苏斯的莫丹特·永影。‡將達洛斯的日誌交給達納蘇斯的摩丹特·平影。',
  }
},
[14410] = {
  {
    'As selvas de Feralas‡В дебрях Фераласа‡Die Wildnis von Feralas‡페랄라스 자생지‡Las tierras salvajes de Feralas‡Las tierras salvajes de Feralas‡Les étendues sauvages de Féralas‡菲拉斯的荒野‡',
    nil,
    'Vá até Feralas e fale com Telaron Volaventos no Repouso do Sonhador.‡Отправляйтесь в Фералас и поговорите с Телароном Полетом Ветра в Покоях Дремлющего.‡Reist nach Feralas und sprecht mit Telaron Windsegler bei Träumersruh.‡페랄라스로 가서 꿈꾸는 자의 휴식처에 있는 텔라론 윈드플라이트와 대화해야 합니다.‡Viaja hasta Feralas y habla con Telaron Vuelavento en el Reposo de la Soñadora.‡Viaja hasta Feralas y habla con Telaron Vuelavento en el Reposo de la Soñadora.‡Allez en Féralas et parlez à Telaron Volevent, au Repos du Rêveur.‡到菲拉斯去跟梦游者栖地的特拉隆·风程谈一谈。‡',
  }
},
[14411] = {
  {
    'Feralas Breadcrumb [PH]‡‡Feralas Brotkrumen [PH]‡페랄라스 선행퀘 [PH]‡‡Feralas Breadcrumb [PH]‡Suite Féralas‡菲拉斯标记‡',
    nil,
    nil,
  }
},
[14412] = {
  {
    'Maré vermelha‡Как в море корабли‡Angespült‡끝장‡Limpieza‡Limpieza‡Des Réprouvés à la mer‡清理渔场‡刷洗乾淨',
    nil,
    'Mate 6 Náufragos Renegados.‡Убейте 6 Отрекшихся-изгоев.‡Tötet 6 schiffbrüchige Verlassene.‡포세이큰 조난자 6명을 처치해야 합니다.‡Mata a 6 náufragos Renegados.‡Mata a 6 náufragos Renegados.‡Tuez 6 Naufragés réprouvés.‡杀死6名流窜的被遗忘者。‡殺死6名亡靈船難者。',
  }
},
[14413] = {
  {
    'O pináculo do aprendizado‡Вершина обучения‡Der Gipfel des Lernens‡배움의 봉우리‡El Pináculo del aprendizaje‡El Pináculo del aprendizaje‡La cime de la connaissance‡学习之巅‡學習的山巔',
    nil,
    'Fale com a Imagem do Arquimago Tauriel na base do Pináculo Arcano.‡Поговорите с проекцией верховного мага Ксилема у подножия Волшебного замка.‡Sprecht mit dem Abbild von Erzmagier Xylem am Fuß der Arkanen Spitze.‡비전 봉우리 아래쪽에서 대마법사 실렘의 환영과 대화해야 합니다.‡Habla con la imagen del archimago Xylem en la base del Pináculo Arcano.‡Habla con la imagen del archimago Xylem en la base del Pináculo Arcano.‡Allez voir l’Image de l’Archimage Xylem au pied de la Cime des Arcanes.‡在奥术之巅底部同大法师克希雷姆的影像交谈。‡在秘法之巔的底部和大法師克希雷姆的影像說話。',
  }
},
[14414] = {
  {
    'Feralas Breadcrumb [PH]‡Feralas Breadcrumb [PH]‡Feralas Brotkrumen [PH]‡페랄라스 선행퀘 [PH]‡Feralas Breadcrumb [PH]‡Feralas Breadcrumb [PH]‡Suite Féralas‡菲拉斯标记‡Feralas Breadcrumb [PH]',
    nil,
    nil,
  }
},
[14415] = {
  {
    '‡Призраки в саду‡Erscheinungen im Obstgarten‡‡Apariciones en el Huerto‡‡Des apparitions dans le verger‡‡',
    nil,
    '‡Осмотрите сад Краули.‡Untersucht Crowleys Obstgarten.‡‡Investiga el Huerto de Crowley.‡‡Enquêtez dans le Verger de Crowley.‡‡',
  }
},
[14416] = {
  {
    'O gorjala faminto‡Голодный эттин‡Der hungrige Ettin‡배고픈 거인‡El ettin hambriento‡El ettin hambriento‡L\'ettin affamé‡饥饿的双头怪‡飢餓的雙頭巨人',
    nil,
    'Leve 5 Cavalos da Montanha para Lorna Crowley no Horto dos Crowley.‡Приведите 5 горных коней Лорне Краули в сад Краули.‡Bringt 5 Gebirgspferde zu Lorna Crowley bei Crowleys Obstgarten.‡크롤리 과수원에 있는 로르나 크롤리에게 산악 야생마 5마리를 데려가야 합니다.‡Lleva 5 caballos de montaña a Lorna Crowley en el Huerto de Crowley.‡Lleva 5 caballos de montaña a Lorna Crowley en el Huerto de Crowley.‡Apportez 5 Chevaux des montagnes à Lorna Crowley au Verger de Crowley.‡克罗雷果园的罗娜·克罗雷要你带回5匹高山马。‡將5匹高山馬帶去克羅雷果園給羅娜·克羅雷。',
  }
},
[14418] = {
  {
    'The Deathstalkers‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Deliver Andron\'s Ledger to Aleric Hawkins in the Hall of the Dark Lady in the Undercity.‡Отнесите гроссбух Андрона Алерику Хоукинсу в Зал Темной Госпожи в Подгороде.‡Bringt Androns Geschäftsbuch zu Aleric Hawkins in die Halle der Dunklen Fürstin in Unterstadt.‡언더시티의 실바나스의 전당에 있는 앨러릭 호킨스에게 안드론의 장부를 가져가야 합니다.‡Lleva el libro de contabilidad de Andron a Aleric Hawkins a la sala de la Dama Oscura, en Entrañas.‡Lleva el libro de contabilidad de Andron a Aleric Hawkins a la sala de la Dama Oscura, en Entrañas.‡Livrer le Grand Livre d\'Andron à Aleric Hawkins au Hall de la Dame noire à Fossoyeuse.‡将安德隆的账本交给幽暗城黑暗女王大厅里的霍克金斯。‡將安德隆的帳本交給幽暗城黑暗女王大廳裡的艾爾瑞克·霍金斯。',
  }
},
[14419] = {
  {
    'The Deathstalkers‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Speak with Andron Gant in the Undercity.‡Поговорите с Андроном Гантом в Подгороде.‡Sprecht mit Andron Gant in Unterstadt.‡언더시티에 있는 안드론 건트와 대화해야 합니다.‡Habla con Andron Gant en Entrañas.‡Habla con Andron Gant en Entrañas.‡Aller voir Andron Gant à Fossoyeuse.‡与幽暗城的安德隆·甘特交谈。‡與幽暗城的安德隆·甘特交談。',
  }
},
[14420] = {
  {
    'The Deathstalkers‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Get Astor\'s Letter of Introduction and return it to Mennet Carkad in the Rogues\' Quarter.‡Принесите рекомендательное письмо Астора Менниту Каркаду в Квартал Разбойников Подгорода.‡Beschafft Astors Vorstellungsschreiben und bringt es zu Mennet Carkad im Schurkenviertel.‡아스토르의 소개장을 구해, 도적 지구에 있는 메넷 칼카드에게 가져가야 합니다.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, en el Barrio de los Pícaros.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, en el Barrio de los Pícaros.‡Trouver la Lettre de recommandation d\'Astor et l\'apporter à Mennet Carkad dans le Quartier des Voleurs.‡得到阿斯托的介绍信，并将其交给盗贼区的米奈特·卡加德。‡取得阿斯托的介紹信，並將其交給盜賊區的米奈特·卡加德。',
  }
},
[14421] = {
  {
    'The Deathstalkers‡Cтражи смерти‡Die Todespirscher‡죽음추적자‡Los mortacechadores‡Los mortacechadores‡Les nécrotraqueurs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Bring Andron\'s Ledger to Mennet Carkad in the Rogues\' Quarter of Undercity.‡Отнесите гроссбух Андрона Менниту Каркаду в Квартал Разбойников Подгорода.‡Bringt Androns Geschäftsbuch zu Mennet Carkad im Schurkenviertel von Unterstadt.‡언더시티의 도적 지구에 있는 메넷 칼카드에게 안드론의 장부를 가져가야 합니다.‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Apporter le Grand Livre d\'Andron à Mennet Carkad dans le Quartier des Voleurs de Fossoyeuse.‡将阿斯托的账本交给幽暗城盗贼区的米奈特·卡加德。‡將安德隆的帳本交給幽暗城盜賊區的米奈特·卡加德。',
  }
},
[14422] = {
  {
    'Eram os deuses dinossauros?‡Ракета ящеров‡Raptor Rakete‡랩터 전용 로켓‡Cohete raptor‡Cohete raptor‡Ouvrez, ouvrez la cage aux raptors‡飞向外太空的迅猛龙‡迅猛迅猛火箭',
    nil,
    'Liberte cinco Raptores Experimentais das jaulas no Laboratório Secreto, e leve-os para o foguete perto da Cobaia Nove.‡Освободите из клеток пять экспериментальных ящеров и доставьте их объекту №9 к ракете.‡Befreit fünf Versuchsraptoren aus ihren Käfigen im Geheimlabor und liefert sie bei der Rakete neben Versuchsobjekt neun ab.‡비밀 실험실의 우리에서 실험용 랩터 5마리를 구출하여 9번 실험체 옆에 있는 로켓으로 데려가야 합니다.‡Libera a 5 raptores experimentales de sus jaulas en El Laboratorio Secreto y llévalos hasta el cohete que hay al lado del Sujeto Nueve.‡Libera a 5 raptores experimentales de sus jaulas en El Laboratorio Secreto y llévalos hasta el cohete que hay al lado del Sujeto Nueve.‡Libérez 5 Raptors expérimentaux de leurs cages dans le Laboratoire secret, puis amenez-les jusqu’à la fusée, à côté du Sujet n°9.‡释放秘密实验室里的5只试验迅猛龙，把它们和九号实验品送上火箭。‡在秘密實驗室解放牢籠中的五隻實驗用迅猛龍，並將牠們送到實驗體九號身邊的火箭裡。',
  }
},
[14423] = {
  {
    'O exorcismo de Petúnia‡Бульдозерсизм‡Raupenexorzismus‡불도저 퇴마의식‡Bulldozexorcismo‡Bulldozexorcismo‡La gêne de Margène‡推土驱魔术‡推土機主義',
    nil,
    'Use a Arma Sinalizadora Abençoada perto do Trator do Chamorra para convocar ajuda, e então exorcize o trator.‡Воспользуйтесь освященным сигнальным пистолетом, чтобы призвать жреца на помощь, а затем "изгоните духов" из бульдозера.‡Benutzt die gesegnete Leuchtpistole in der Nähe von Clubniks Planierraupe, um Hilfe herbeizurufen, dann führt an der Planierraupe einen "Exorzismus" durch.‡클럽니크의 불도저 근처에서 축복받은 신호용 권총을 사용하여 도움을 요청한 다음, 불도저에서 유령을 쫓아내야 합니다.‡Utiliza la pistola de bengalas bendita cerca del bulldozer de Clubnik para pedir ayuda. Después, exorciza el bulldozer.‡Utiliza la pistola de bengalas bendita cerca del bulldozer de Clubnik para pedir ayuda. Después, exorciza el bulldozer.‡Utilisez le Lance-fusée béni près du Buldo de Clubnik pour demander de l’aide, puis « Exorcisez » le bulldozer.‡在克拉伯尼克的推土机旁使用圣佑信号枪，召唤牧师为推土机“驱魔”。‡在棒柄的挖土機附近使用受過祝福的照明信號槍以召喚援助，然後對推土機進行「驅邪」。',
  }
},
[14424] = {
  {
    'Uma pitadinha de ciência‡Снова нужна наука‡Mehr Wissenschaft benötigt‡또 다른 과학의 손길‡Necesitamos más ciencia‡Necesitamos más ciencia‡Science, on tourne !‡再来点科学‡需要更高科技',
    nil,
    'Encontre a Assistente Grilly no Terminal Sul da Foguetovia. A Foguetovia Goblin pode ser usada para ir rapidamente a qualquer parte de Azshara.‡Найдите ассистентку Грили на южной конечной станции ракетной дороги. Ракетная дорога гоблинов позволяет быстро перемещаться по Азшаре.‡Findet Assistentin Greely an der Südlichen Endhaltestelle der Raketenbahn. Man kann die Goblinraketenbahn nutzen, um schnell durch Azshara zu reisen.‡남부 로켓길 종착지에 있는 조수 그릴리를 찾아야 합니다. 고블린 로켓길을 이용하면 아즈샤라 각지로 빠르게 이동할 수 있습니다.‡Busca a la asistente Greely en la Terminal de la Cohetepista del Sur. Puedes utilizar la Cohetepista de los goblins para desplazarte rápidamente por Azshara.‡Busca a la asistente Greely en la Terminal de la Cohetepista del Sur. Puedes utilizar la Cohetepista de los goblins para desplazarte rápidamente por Azshara.‡Trouvez l’Assistante Greely au Terminus sud du fusorail. On peut utiliser le fusorail gobelin pour se déplacer plus vite en Azshara.‡在南部火箭车终点站找到助手格瑞里。使用地精火箭车可以在艾萨拉快速行进。‡去南方火箭道終點找到助理格里利。哥布林火箭道可以用來在艾薩拉迅速移動。',
  }
},
[14425] = {
  {
    '‡‡Die erste Quest‡첫 번째 모험‡‡‡La première quête‡‡',
    nil,
    '‡‡Thrall möchte, dass Ihr Zeug umbringt.‡스랄이 무언가를 죽여달라고 했습니다.‡‡‡Le Thrall de test veut que vous tuiez un truc.‡‡',
  }
},
[14426] = {
  {
    '‡‡Die zweite Quest‡‡La segunda misión‡‡La seconde quête‡‡',
    nil,
    '‡‡Santa Thrall möchte, dass Ihr 5 Schnäpschen einsammelt, was immer das sein soll.‡‡‡‡Le thrall de Noël veut que vous lui trouviez 5 Bidules, ou quelque chose comme ça.‡‡',
  }
},
[14427] = {
  {
    'Item Quest‡Item Quest‡Gegenstandsquest‡Item Quest‡Item Quest‡Item Quest‡Quête d\'objets‡Item Quest‡物品任務',
    nil,
    'Get the items‡Get the items‡Holt die Gegenstände‡Get the items‡Get the items‡Get the items‡Récupérez les objets‡Get the items‡拿東西',
  }
},
[14428] = {
  {
    'O diário de Ventâmbar‡Записи сказительницы Янтарный Ветер‡Goldwinds Tagebuch‡앰버윈드의 일지‡El diario de Ventámbar‡El diario de Ventámbar‡Le journal d\'Ambrevent‡珀风的手记‡琥珀風的日誌',
    nil,
    'Assassine a Erudita Ventâmbar na Base Darnassiana e obtenha o diário dela.‡Убейте сказительницу Янтарный Ветер в Лагере дарнасских эльфов и возьмите ее записи.‡Tötet Wissenshüterin Goldwind im Darnassischen Basislager und bringt ihr Tagebuch in Euren Besitz.‡다르나서스 주둔지에 있는 현자 앰버윈드를 처치하고 그녀의 일지를 입수해야 합니다.‡Mata a la tradicionalista Ventámbar en el Campamento Base Darnassiano y consigue su diario.‡Mata a la tradicionalista Ventámbar en el Campamento Base Darnassiano y consigue su diario.‡Tuez la Gardienne du savoir Ambrevent au Camp de base Darnassien et récupérez son journal.‡击败达纳希恩营地的博学者珀风，夺走她的手记。‡在達納蘇斯營地殺死博識者琥珀風並取得她的日誌。',
  }
},
[14429] = {
  {
    'Desconstrução arcana‡Разрушение порождений тайной магии‡Arkane Dekonstruktion‡비전 해체‡Deconstrucción Arcana‡Deconstrucción Arcana‡Désassemblage arcanique‡奥术解构‡秘法解構',
    nil,
    'Mate Investigadores Aprendizes e Iluminadores Aprendizes para coletar 10 Pedras Rúnicas Harmonizadas.‡Убейте начинающих наставников и начинающих исследователей и соберите 10 настроенных рунических камней.‡Tötet Angehende Ermittler und Angehende Illuminatoren um 10 Abgestimmte Runensteine einzusammeln.‡수습 수색요원과 수습 분석요원을 해치워 조율된 마법석 10개를 모아야 합니다.‡Asesina a aprendices de investigador y a aprendices de iluminador para reunir 10 piedras rúnicas armonizadas.‡Asesina a aprendices de investigador y a aprendices de iluminador para reunir 10 piedras rúnicas armonizadas.‡Tuez des Apprentis enquêteurs et des Apprentis illuminateurs pour récupérer 10 Pierres runiques en phase.‡杀掉调查员学徒和夜明者学徒，收集10颗调和过的符文石。‡殺死調查員學徒和啟迪者學徒來收集10個同調的符石。',
  }
},
[14430] = {
  {
    'Hackeando o construto‡Взлом порождений тайной магии‡Das Konstrukt hacken‡피조물 조작하기‡Manipulando el ensamblaje‡Manipulando el ensamblaje‡Pirater l\'assemblage‡构造体黑客‡入侵傀儡',
    nil,
    'Fale com o Construto Arcano na Base Darnassiana e pronuncie as palavras de poder arcano.‡Обратитесь к порождению тайной магии в Лагере дарнасских эльфов и произнесите магические слова.‡Sprecht mit dem arkanen Konstrukt im Darnassischen Basislager und sprecht die Worte der arkanen Macht.‡다르나서스 주둔지에 있는 비전 피조물과 대화하고 비전 마력이 담긴 주문을 외워야 합니다.‡Habla con el ensamblaje Arcano en el Campamento Base Darnassiano y pronuncia las palabras de poder Arcano.‡Habla con el ensamblaje Arcano en el Campamento Base Darnassiano y pronuncia las palabras de poder Arcano.‡Allez voir l\'Assemblage arcanique au Camp de base Darnassien, et prononcez les mots chargés de puissance arcanique.‡同达纳希恩营地的奥术构造体对话，讲出奥术控制指令。‡到達納蘇斯營地，並對秘法傀儡說出秘法能量咒語。',
  }
},
[14431] = {
  {
    'Problemas no horizonte‡Овраг Черночревов‡Die Schwarzschlund-Narbe‡검은아귀의 흉터‡La escara de los Faucenegra‡La escara de los Faucenegra‡Coup de noiregueule‡黑喉裂谷‡黑喉之疤',
    nil,
    'Mate 8 Biólogos de Talrendis e pegue as Informações dos Bocanera de um dos cadáveres.‡Убейте 8 биологов с заставы Талрендис, обыщите одно из тел и заберите оперативную информацию Черночревов.‡Tötet 8 Biologen der Talrendisspitze und nehmt die Geheimdienstinformationen des Schwarzschlunds von einer der Leichen an Euch.‡탈렌디스 생물학자 8명을 처치하고 검은아귀 정보를 모아야 합니다.‡Asesina a 8 biólogos de Talrendis y reúne información de los Faucenegra de uno de los cadáveres.‡Asesina a 8 biólogos de Talrendis y reúne información de los Faucenegra de uno de los cadáveres.‡Tuez 8 Biologistes de Talrendis, et récupérez les Informations noiregueules sur l’un des corps.‡杀掉8名塔伦迪斯生物学家，从其中一具尸体上收集黑喉情报。‡殺死8名塔倫迪斯生物學家，並從其中一具屍體上取得黑喉部族情報。',
  }
},
[14432] = {
  {
    'O barato do vapor‡Отвар из древовидного вереска‡Ein fahles Gebräu‡신비한 음료‡Una infusión de hierbas‡Una infusión de hierbas‡L’heure du thé‡苦酒‡無味的酒',
    nil,
    'Colete 10 amostras do Fermentado de Raiz de Urze Branca, na área em redor à Gruta Bocanera.‡Принесите 10 порций отвара из древовидного вереска из крепости Черночревов.‡Sammelt 10 Proben Strauchwurzelgebräu außerhalb der Schwarzschlundfeste.‡검은아귀 요새에서 찔레뿌리 차의 견본 10개를 모아야 합니다.‡Reúne 10 muestras de infusión de brezoriz junto al Bastión Faucenegra.‡Reúne 10 muestras de infusión de brezoriz junto al Bastión Faucenegra.‡Récupérez 10 échantillons de Tisane de racine de bruyère au Repaire des Noiregueules.‡在黑喉要塞外收集10份石南根特酿样本。‡從黑喉村莊收集10份歐石南佳釀的樣本。',
  }
},
[14433] = {
  {
    'Diplomacia por outros meios‡Обратная сторона дипломатии‡Diplomatie mal anders‡또 다른 외교 수단‡Diplomacia por otros medios‡Diplomacia por otros medios‡Diplomatie à tout prix !‡另类的外交‡另一種外交途徑',
    nil,
    'Colete uma Agenda de Reuniões dos Bocanera, na Gruta Bocanera, e mate uma Embaixadora de Talrendis para coletar Vestes de Embaixadora.‡Заберите из крепости Черночревов план встречи Черночревов, убейте посланницу с заставы Талрендис и заберите его одеяния посла.‡Bringt eine Versammlungsagenda des Schwarzschlunds in der Schwarzschlundfeste an Euch und tötet einen Botschafter der Talrendisspitze, um eine Botschafterrobe in Euren Besitz zu bringen.‡검은아귀 요새에서 검은아귀 회합 의제를 찾고 탈렌디스 사절을 처치한 다음 사절의 로브를 구해야 합니다.‡Reúne la agenda de la reunión de los Faucenegra en el bastión Faucenegra y mata a la embajadora de Talrendis para apoderarte de sus togas de embajadora.‡Reúne la agenda de la reunión de los Faucenegra en el bastión Faucenegra y mata a la embajadora de Talrendis para apoderarte de sus togas de embajadora.‡Récupérez le Programme de la rencontre avec les Noiregueules au Repaire des Noiregueules, puis tuez une Ambassadrice de Talrendis pour lui prendre sa Robe d’ambassadrice.‡去黑喉营地截取一份黑喉会面日程，杀掉一名塔伦迪斯使节，把她的使者的长袍带回来。‡在黑喉營地收集黑喉會議備忘錄，並殺死一名塔倫迪斯大使來取得她的使節長袍。',
  }
},
[14434] = {
  {
    'Vila de Rut\'theran‡Деревня Рут\'теран‡Rut\'theran‡루테란 마을‡Aldea Rut\'theran‡Aldea Rut\'theran‡Rut’theran‡鲁瑟兰村‡魯瑟蘭村',
    nil,
    nil,
  }
},
[14435] = {
  {
    'A traição dos Bocanera‡Обман Черночревов‡Doppeltes Spiel bei den Schwarzschlund‡검은아귀의 배신‡La traición a los Faucenegra‡La traición a los Faucenegra‡La trahison des Noiregueules‡黑喉离间计‡黑喉的背叛',
    nil,
    'Vista o Disfarce de Embaixadora e peça a Andorel Jurassolar que teleporte você para a Gruta Bocanera. Fale com Ungarl para descarrilar as negociações, e mate 4 Guerreiros Bocanera e 4 Xamãs Bocanera ao sair.‡Наденьте маскировочные одеяния посла и обратитесь к Андорелу Верному Солнцу, чтобы он телепортировал вас в крепость Черночревов. Поговорите с Унгарлом, чтобы сорвать переговоры. Затем убейте на обратном пути 4 воинов из клана Черночревов и 4 шаманов из клана Черночревов.‡Tragt die Verkleidung als Botschafter und sprecht mit Andorel Sonnenschwur, damit er Euch in die Schwarzschlundfeste teleportiert. Sprecht mit Ungarl, um die Verhandlungen zunichte zu machen, dann tötet 4 Krieger des Schwarzschlunds und 4 Schamanen des Schwarzschlunds auf dem Weg nach draußen.‡사절 위장을 착용한 다음 안도렐 선스원과 대화하여 검은아귀 요새로 순간이동 하십시오. 운갈과 대화하여 협상을 깨뜨린 후 탈출하면서 검은아귀 전사 4마리와 검은아귀 주술사 4마리를 처치해야 합니다.‡Ponte el disfraz de embajador y habla con Andorel Jurasol para teletransportarte hasta Bastión Faucenegra. Habla con Ungarl para romper las negociaciones y después mata a 4 guerreros Faucenegra y a 4 chamanes Faucenegra en tu camino de vuelta.‡Ponte el disfraz de embajador y habla con Andorel Jurasol para teletransportarte hasta Bastión Faucenegra. Habla con Ungarl para romper las negociaciones y después mata a 4 guerreros Faucenegra y a 4 chamanes Faucenegra en tu camino de vuelta.‡Portez le Déguisement d’ambassadrice et allez voir Andorel Ligesol pour qu’il vous téléporte au Repaire des Noiregueules. Allez voir Ungarl pour faire échouer les négociations, puis tuez 4 Guerriers noiregueules et 4 Chamans noiregueules sur le chemin du retour.‡穿上使者伪装服同安多瑞尔·誓日交谈，让他把你传送到黑喉要塞。同乌加尔对话，破坏谈判，杀死4名黑喉战士和4名黑喉萨满。‡穿上使節偽裝並和安多雷爾‧日誓說話來傳送進黑喉要塞。和安迦爾說話來破壞談判，然後在你離開的路上殺死4名黑喉戰士和4名黑喉薩滿。',
  }
},
[14436] = {
  {
    'Escavação enânica‡Дворфийские делишки‡Zwergenbuddelei‡드워프 발굴지‡Una excavación de los enanos‡Una excavación de los enanos‡Les fouilles des nains‡矮人的挖掘场‡矮人挖掘',
    nil,
    'Recolha 5 Picaretas do Prospector.|n|nEm uma forja, esmague as Picaretas do Prospector para criar Ferramentas Quebradas.|n|nLeve 5 Ferramentas Quebradas para Ahmo Chifre Troante na Aldeia Casco Sangrento.‡Соберите 5 кирок геолога.|n|nСломайте их в кузнице. |n|nОтнесите 5 сломанных инструментов Ахмо Громовому Рогу в деревню Кровавого Копыта.‡Sammelt 5 Ausgrabungsleiterhacken ein.|n|nZerschlagt die Ausgrabungsleiterhacken in einer Schmiede, um zerbrochene Werkzeuge zu erhalten.|n|nBringt Ahmo Donnerhuf im Dorf der Bluthufe 5 zerbrochene Werkzeuge.‡발굴조사단장의 곡괭이 5개를 모아야 합니다.|n|n가열로에서 발굴조사단장의 곡괭이를 부러진 곡괭이로 만들어야 합니다.|n|n블러드후프 마을에 있는 아모 썬더혼에게 부러진 곡괭이 5개를 가져가야 합니다.‡Consigue 5 picos de prospector.|n|nRompe los picos de prospector en una forja para crear herramientas rotas.|n|nLlévale 5 herramientas rotas a Ahmo Tronacuerno a Poblado Pezuña de Sangre.‡Consigue 5 picos de prospector.|n|nRompe los picos de prospector en una forja para crear herramientas rotas.|n|nLlévale 5 herramientas rotas a Ahmo Tronacuerno a Poblado Pezuña de Sangre.‡Collectez 5 Piolets de prospecteur.|n|nÀ la forge, brisez les Piolets de prospecteur pour obtenir des Outils cassés.|n|nRapportez 5 Outils cassés à Ahmo Corne-Tonnerre, à Sabot-de-Sang.‡收集5个勘察员的锄头。|n|n在铁匠铺砸碎这些勘察员的锄头。|n|n把5件损坏的工具交给血蹄村的艾莫·雷角。‡收集5個勘察員的十字鎬。|n|n在熔爐砸爛這些勘察員的十字鎬以製造損壞的工具。|n|n將5個損壞的工具交給血蹄村的奧莫·雷角。',
  }
},
[14437] = {
  {
    '‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les rites de la Terre-mère‡大地之母仪祭‡',
    nil,
    '‡Отнесите тотем Соколиного Ветра Ахмо Громовому Рогу в Деревню Кровавого Копыта. Следуйте по дороге из Лагеря Нараче.‡Bringt Ahmo Donnerhuf im Dorf der Bluthufe Falkenwinds Totem. Folgt der Straße, die aus dem Camp Narache herausführt.‡‡Llévale el tótem de Viento de Halcón a Ahmo Tronacuerno a Poblado Pezuña del Trueno. Sigue el camino que sale de Campamento Narache.‡Llévale el tótem de Viento de Halcón a Ahmo Tronacuerno a Poblado Pezuña del Trueno. Sigue el camino que sale de Campamento Narache.‡Apporter le Totem de Vent-du-faucon à Ahmo Corne-Tonnerre à Sabot-de-Sang. Suivre la route hors du camp Narache.‡‡',
  }
},
[14438] = {
  {
    'Dividindo a terra‡Недобрые соседи‡Gemeinsame Nutzung des Landes‡대지의 공유‡Compartir la tierra‡Compartir la tierra‡Partager la terre‡土地之争‡土地之爭',
    nil,
    'Mate 15 Gnolls Jubalba e fale novamente com Ahmo Chifre Troante na Aldeia Casco Sangrento.‡Убейте 15 гноллов из стаи Бледногривов и возвращайтесь к Ахмо Громовому Рогу в деревню Кровавого Копыта.‡Tötet 15 Gnolle der Bleichmähnen und kehrt dann zu Ahmo Donnerhorn ins Dorf der Bluthufe zurück.‡회색갈기 놀 15마리를 처치하고 블러드후프 마을에 있는 아모 썬더혼에게 가야 합니다.‡Mata a 15 gnolls Crines Pálidas y vuelve a ver a Ahmo Tronacuerno, que está en Poblado Pezuña de Sangre.‡Mata a 15 gnolls Crines Pálidas y vuelve a ver a Ahmo Tronacuerno, que está en Poblado Pezuña de Sangre.‡Tuez 15 Gnolls crins-pâles, puis retournez voir Ahmo Corne-Tonnerre, à Sabot-de-Sang.‡杀死15个白鬃豺狼人，然后回到血蹄村向艾莫·雷角复命。‡殺死15個白鬃豺狼人，然後回到血蹄村找奧莫‧雷角。',
  }
},
[14439] = {
  {
    'Siga para o Penhasco do Trovão‡Путешествие в Громовой Утес‡Reise nach Donnerfels‡썬더 블러프로의 여정‡Viaje a Cima del Trueno‡Viaje a Cima del Trueno‡Un voyage aux Pitons-du-Tonnerre‡雷霆崖之旅‡雷霆崖之旅',
    nil,
    'Fale com Baine Casco Sangrento no Penhasco do Trovão.‡Поговорите с Бейном Кровавым Копытом в Громовом Утесе.‡Sprecht mit Baine Bluthuf in Donnerfels.‡썬더 블러프에 있는 바인 블러드후프와 대화해야 합니다.‡Habla con Baine Pezuña de Sangre en Cima del Trueno.‡Habla con Baine Pezuña de Sangre en Cima del Trueno.‡Parlez à Baine Sabot-de-Sang, aux Pitons-du-Tonnerre.‡和雷霆崖的贝恩·血蹄谈一谈。‡與雷霆崖的貝恩·血蹄交談。',
  }
},
[14440] = {
  {
    '‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les rites de la Terre-mère‡大地之母仪祭‡',
    nil,
    '‡Бейн Кровавое Копыто из Громового Утеса попросил принести ему рог Арра\'чеи.‡Baine Bluthuf in Donnerfels möchte, dass Ihr ihm das Horn von Arra\'chea bringt.‡‡Baine Pezuña de Sangre quiere que le lleves el cuerno de Arra\'chea a Cima del Trueno.‡Baine Pezuña de Sangre quiere que le lleves el cuerno de Arra\'chea a Cima del Trueno.‡Apporter la Corne d\'Arra\'chea à Baine Sabot-de-Sang, aux Pitons-du-Tonnerre.‡‡',
  }
},
[14441] = {
  {
    '‡Автограф Гарроша‡Garroshs Autogramm‡가로쉬의 친필서명‡El autógrafo de Garrosh‡El autógrafo de Garrosh‡L\'autographe de Garrosh‡卡爾洛斯的親筆簽名‡卡爾洛斯的親筆簽名',
    nil,
    '‡Отправляйтесь в Оргриммар и постарайтесь получить автограф Гарроша Адского Крика для своего подопечного.‡Reist zur Feste Grommash im Herzen des Tals der Stärke in Orgrimmar und kümmert Euch darum, für Euren Schützling ein Autogramm von Garrosh Höllschrei zu bekommen.‡‡Viaja al Fuerte Grommash, en el corazón del Valle de la Fuerza en Orgrimmar, para intentar conseguir el autógrafo de Garrosh Grito Infernal para tu pupilo.‡Viaja al Fuerte Grommash, en el corazón del Valle de la Fuerza en Orgrimmar, para intentar conseguir el autógrafo de Garrosh Grito Infernal para tu pupilo.‡Allez à Fort Grommash au centre de la Vallée de la Force à Orgrimmar pour tenter d\'obtenir un autographe de Garrosh Hurlenfer pour votre protégé.‡‡',
  }
},
[14442] = {
  {
    'Minha cobaia favorita‡Мой любимый объект‡Mein Lieblingsversuchsobjekt‡가장 귀중한 실험체‡Mi sujeto favorito‡Mi sujeto favorito‡Mon sujet favori‡钟爱的实验品‡我最喜歡的物件',
    nil,
    'Localize a Cobaia Nove em algum lugar perto do complexo do Laboratório Secreto, em Azshara.‡Найдите объект №9 где-то возле комплекса секретной лаборатории в Азшаре.‡Findet Versuchsobjekt neun irgendwo in der Nähe des Geheimlabors in Azshara.‡아즈샤라의 비밀 실험실 건물 근처 어딘가에 있는 9번 실험체를 찾아야 합니다.‡Localiza a Sujeto Nueve en algún lugar cerca del complejo de El Laboratorio Secreto en Azshara.‡Localiza a Sujeto Nueve en algún lugar cerca del complejo de El Laboratorio Secreto en Azshara.‡Trouvez le Sujet n°9 près du complexe du Laboratoire secret, en Azshara.‡在艾萨拉的秘密实验室附近找到九号实验品。‡在艾薩拉秘密實驗室設施的附近找到實驗體九號。',
  }
},
[14443] = {
  {
    'O Punho Danificado‡Потертая рукоять‡Der ramponierte Schwertgriff‡마모된 칼자루‡La empuñadura maltrecha‡La empuñadura maltrecha‡La poignée endommagée‡残破的剑柄‡破損的劍柄',
    nil,
    'Leve o Punho Danificado para Caladis Setalume no Repouso de Quel\'Delar, ao sul dos Campos do Torneio Argênteo.‡Принесите потертую рукоять Каладису Сияющему Копью в Покой Кель\'Делара к югу от ристалища Серебряного Турнира.‡Bringt den ramponierten Schwertgriff zu Caladis Prunkspeer in Quel\'Delars Ruh südlich des Argentumturnierplatzes.‡마모된 칼자루를 은빛십자군 마상시합 광장 남쪽, 쿠엘델라의 쉼터에 있는 칼라디스 브라이트스피어에게 가져가야 합니다.‡Lleva la empuñadura maltrecha a Caladis Lanza Reluciente en el Reposo de Quel\'Delar, al sur de los Campos del Torneo Argenta.‡Lleva la empuñadura maltrecha a Caladis Lanza Reluciente en el Reposo de Quel\'Delar, al sur de los Campos del Torneo Argenta.‡Apporter la Poignée endommagée à Caladis Brillelance au Repos de Quel\'Delar, au sud de l\'Enceinte du tournoi d\'Argent.‡将残破的剑柄交给奎尔德拉之冢的卡莱迪斯·亮矛。他就在银色比武场的南边。‡到銀白聯賽場地南邊的奎爾德拉之眠，把破損的劍柄帶給卡拉迪斯·亮矛。',
  }
},
[14444] = {
  {
    'O que os dragões sabem‡То, что знают драконы‡Das Wissen der Drachen‡용이 아는 것‡Lo que saben los dragones‡Lo que saben los dragones‡Ce que savent les dragons‡巨龙所知道的‡龍族的知識',
    nil,
    'Fale com Krasus no topo do Templo do Repouso das Serpes.‡Поговорите с Красом на вершине Храма Драконьего Покоя.‡Sprecht mit Krasus in der Spitze des Wyrmruhtempels.‡고룡쉼터 사원 꼭대기에 있는 크라서스와 대화해야 합니다.‡Habla con Krasus en lo alto del Templo del Reposo del Dragón.‡Habla con Krasus en lo alto del Templo del Reposo del Dragón.‡Parlez à Krasus, au sommet du Temple du Repos du ver.‡同龙眠神殿顶端的克拉苏斯交谈。‡與龍眠神殿最上層的卡薩斯談話。',
  }
},
[14445] = {
  {
    'Adeus, por enquanto‡До скорой встречи‡Abschied auf Zeit‡지금은 안녕‡Esto no es un adiós, sino un hasta luego‡Esto no es un adiós, sino un hasta luego‡Adieu, pour l\'instant‡暂时的离别‡暫時再會',
    nil,
    'Fale com Espoleta Chaveforte no Mirante Selvagem, que fica nas Ilhas Perdidas.‡Поговорите с Хамми Кофельнагель на Лесном наблюдательном пункте на Затерянных островах.‡Sprecht mit Sassy Hartzang an der Wilden Aussicht auf den Verlorenen Inseln.‡잃어버린 섬의 황량한 전망대에 있는 새시 하드렌치와 대화해야 합니다.‡Habla con Sassy Malallave en el Mirador Salvaje, en Las Islas Perdidas.‡Habla con Sassy Malallave en el Mirador Salvaje, en Las Islas Perdidas.‡Parlez à Chipie Serrelavis au Surplomb Sauvage, sur les Îles Perdues.‡跟失落群岛荒野瞭望台的莎希·硬钳谈一谈。‡在失落群島上的野生眺望和賽希·硬心說話。',
  }
},
[14446] = {
  {
    'Cataclismo!‡Катаклизм!‡Kataklysmus!‡대격변!‡¡Cataclismo!‡¡Cataclismo!‡Cataclysme !‡大灾变！‡大災難!',
    nil,
    'Nambria quer que você olhe dentro das Águas da Vidência.‡Намбрия желает, чтобы вы взглянули в Воды предвидения.‡Nambria möchte, dass Ihr in das Wasser der Weitsicht blickt.‡남브리아가 통찰력의 물을 들여다보라고 했습니다.‡Nambria quiere que mires en las Aguas de Clarividencia.‡Nambria quiere que mires en las Aguas de Clarividencia.‡Nambria veut que vous contempliez les Eaux de longue-vision.‡娜布莉亚希望你观察先知之水中的景象。‡南布瑞亞要你凝視著遠視之水裡面。',
  }
},
[14447] = {
  {
    'Os iguais se reconhecem‡Уж кто бы говорил!‡Der Insider‡사돈 남 말‡Coge uno para conocer a uno‡Coge uno para conocer a uno‡Les ennemis de mes ennemis…‡知根知底‡引薦',
    nil,
    'O Exterminador dos Céus Korm quer que você se apresente a Koltirus Tecemorte no Martelo de Orgrim.‡По заданию покорителя небес Корма поговорите с Кольтирой Ткачом Смерти на борту "Молота Оргрима".‡Himmelshäscher Korm möchte, dass Ihr mit Koltira Todesweber auf der Orgrims Hammer sprecht.‡하늘약탈자 코름이 오그림의 망치호에서 콜티라 데스위버를 만나보라고 했습니다.‡El atracador del cielo Korm quiere que hables con Koltira Tejemuerte en el Martillo de Orgrim.‡El atracador del cielo Korm quiere que hables con Koltira Tejemuerte en el Martillo de Orgrim.‡Le Saccageur-des-cieux Korm Noire-balafre vous demande de parler à Koltira Tissemort, à bord du Marteau d\'Orgrim.‡掠天者考尔姆要你与奥格瑞姆之锤的库尔迪拉·织亡者谈一谈。‡空奪者寇姆·黑疤要求你，和奧格林之錘上的寇爾提拉·亡織者對話。',
  }
},
[14448] = {
  {
    'Os iguais se reconhecem‡Уж кто бы говорил!‡Der Insider‡사돈 남 말‡Coge uno para conocer a uno‡Coge uno para conocer a uno‡Les ennemis de mes ennemis…‡知根知底‡引薦',
    nil,
    'O Exterminador dos Céus Korm quer que você se apresente a Koltirus Tecemorte no Martelo de Orgrim.‡По заданию покорителя небес Корма поговорите с Кольтирой Ткачом Смерти на борту "Молота Оргрима".‡Himmelshäscher Korm möchte, dass Ihr mit Koltira Todesweber auf der Orgrims Hammer sprecht.‡하늘약탈자 코름이 오그림의 망치호에서 콜티라 데스위버를 만나보라고 했습니다.‡El atracador del cielo Korm quiere que hables con Koltira Tejemuerte en el Martillo de Orgrim.‡El atracador del cielo Korm quiere que hables con Koltira Tejemuerte en el Martillo de Orgrim.‡Le Saccageur-des-cieux Korm Noire-balafre vous demande de parler à Koltira Tissemort, à bord du Marteau d\'Orgrim.‡掠天者考尔姆要你与奥格瑞姆之锤的库尔迪拉·织亡者谈一谈。‡空奪者寇姆·黑疤要求你，和奧格林之錘上的寇爾提拉·亡織者對話。',
  }
},
[14449] = {
  {
    'A primeira etapa‡Первый шаг‡Der erste Schritt‡첫 번째 단계‡El primer paso‡El primer paso‡La première étape‡第一步‡第一步',
    nil,
    'Siga o caminho para o Leste na saída da Aldeia Narache e encontre Grull Vento do Falcão.‡Идите по дороге на восток от Лагеря Нараче и найдите Грулла Соколиного Ветра.‡Folgt dem Weg, der aus Camp Narache nach Osten führt und sucht Grull Falkenwind auf.‡나라체 야영지 동쪽 길을 따라가 그룰 호크윈드를 찾아야 합니다.‡Sigue el camino que hay hacia el este saliendo del Campamento Narache y busca a Grull Viento de Halcón.‡Sigue el camino que hay hacia el este saliendo del Campamento Narache y busca a Grull Viento de Halcón.‡Suivez le sentier qui part vers l\'est depuis le Camp Narache et trouvez Grull Vent-du-faucon.‡从纳拉其营地往东，沿着小径去找格鲁尔·鹰风。‡離開納拉其營地並沿著小路向東走，去找格盧爾‧鷹風。',
  }
},
[14450] = {
  {
    'Teste progressivo de saque aleatório‡Random Drop Test Progressive‡Randomdrop-Test Progressiv‡Random Drop Test Progressive‡Random Drop Test Progressive‡Random Drop Test Progressive‡Distribution à taux progessif‡Random Drop Test Progressive‡隨機掉落物測試過程',
    nil,
    'Consiga 10 Trecos Progressivos.‡Get 10 Progressive Widgets.‡Beschafft 10 progressive Dingse.‡Get 10 Progressive Widgets.‡Get 10 Progressive Widgets.‡Get 10 Progressive Widgets.‡Récupérez 10 Rouages progressifs.‡Get 10 Progressive Widgets.‡取得10份運作中的小裝置。',
  }
},
[14451] = {
  {
    'Taxa fixa de saque aleatório‡Random Drop Flat Rate‡Randomdrop-Test FlatRate‡Random Drop Flat Rate‡Random Drop Flat Rate‡Random Drop Flat Rate‡Distribution à taux constant‡Random Drop Flat Rate‡隨機掉落物相同機率',
    nil,
    'Consiga 10 Trecos Planos.‡Get 10 Flat Widgets.‡Beschafft 10 Flatratedingse.‡Get 10 Flat Widgets.‡Get 10 Flat Widgets.‡Get 10 Flat Widgets.‡Récupérez 10 Rouages plats.‡Get 10 Flat Widgets.‡取得10份扁平的小裝置。',
  }
},
[14452] = {
  {
    'Rito de força‡Обряд силы‡Ritus der Kraft‡힘의 의식‡Rito de la fuerza‡Rito de la fuerza‡Le rite de force‡力量仪祭‡力量祭儀',
    nil,
    'Mate 6 Invasores Costagulha.‡Убейте 6 налетчиков из племени Дыбогривов.‡Tötet 6 Eindringlinge der Borstennacken.‡뾰족털 침략자 6마리를 처치해야 합니다.‡Mata a 6 invasores Erizapúas.‡Mata a 6 invasores Erizapúas.‡Tuez 6 Envahisseurs dos-hirsutes.‡杀死6头刺背野猪人。‡消滅6個刺背入侵者。',
  }
},
[14453] = {
  {
    '‡Скромная просьба‡Eine bescheidene Bitte‡작은 부탁‡Una humilde contribución‡Una humilde contribución‡Une humble contribution‡一件琐事‡',
    nil,
    '‡Поищите матушку вождя Соколиный Ветер у источника к юго-востоку от Лагеря Нараче.‡Häuptling Falkenwind möchte, dass Ihr seine Mutter beim Brunnen südöstlich vom Camp Narache sucht.‡족장 호크윈드가 나라체 야영지 남동쪽에 있는 우물 근처에서 그의 어머니를 찾아봐 달라고 했습니다.‡El Jefe Viento de Halcón quiere que vayas a buscar a su madre cerca del pozo que hay al sureste del Campamento Narache.‡El Jefe Viento de Halcón quiere que vayas a buscar a su madre cerca del pozo que hay al sureste del Campamento Narache.‡Partir chercher la mère du Chef Vent-du-faucon, près du puits, au sud-est de Camp Narache.‡鹰风酋长要求你去纳拉其营地东南方的水井处寻找他的母亲。‡',
  }
},
[14454] = {
  {
    'O guerreiro capturado‡Плененный воин‡Der gefangene Krieger‡사로잡힌 전사‡El guerrero capturado‡El guerrero capturado‡Le guerrier capturé‡被捕的战士‡被俘虜的戰士',
    nil,
    'Consiga a Chave Rudimentar com um dos Javatuscos Costagulha e use-a para destrancar a Jaula do Javatusco em que o Valente Chifre Cortante está preso.‡Найдите у свинобразов из племени Дыбогривов грубый ключ и отоприте клетку, в которой держат Храбреца Острого Рога.‡Erhaltet einen primitiven Schlüssel von einem Stacheleber der Borstennacken und benutzt den Schlüssel, um den Stacheleberkäfig zu öffnen, in dem Kriegerheld Scharfhorn gefangen ist.‡뾰족털 가시멧돼지에게서 조잡한 열쇠를 획득한 후, 가시멧돼지 우리를 열어 브레이브 샤프혼을 구해야 합니다.‡Consigue una llave rudimentaria de uno de los jabaespines Erizapúas y úsala para abrir la jaula de jabaespines que encierra a Valiente Cuerno Afilado.‡Consigue una llave rudimentaria de uno de los jabaespines Erizapúas y úsala para abrir la jaula de jabaespines que encierra a Valiente Cuerno Afilado.‡Obtenez une Clé grossière sur l’un des Hurans dos-hirsutes, et servez-vous en pour ouvrir la Cage de huran où est enfermé le Brave Corne-pointue.‡从刺背野猪人那里夺得粗糙的钥匙，打开关押布雷夫·利角的牢笼。‡從一位刺背野豬人身上取得粗製鑰匙，然後用它來開啟囚禁勇者銳角的野豬人牢籠。',
  }
},
[14455] = {
  {
    'Impeça as tormentadoras‡Остановите заклинателей шипов‡Haltet die Dornenrufer auf‡가시소환사를 막아라‡Detén a los clamaespinas‡Detén a los clamaespinas‡Mort aux mande-épines !‡阻止号角手‡阻止荊棘召喚者',
    nil,
    'Mate 7 Tormentadoras Costagulha.‡Убейте 7 заклинателей шипов из племени Дыбогривов.‡Tötet 7 Dornenrufer der Borstennacken.‡뾰족털 가시소환사 7마리를 처치해야 합니다.‡Mata a 7 clamaespinas Erizapúas.‡Mata a 7 clamaespinas Erizapúas.‡Tuez 7 Mande-épines dos-hirsutes.‡杀死7名刺背号角手。‡消滅7個刺背荊棘召喚者。',
  }
},
[14456] = {
  {
    'Rito de bravura‡Обряд смелости‡Ritus des Muts‡용기의 의식‡Rito del Valor‡Rito del Valor‡Le rite de courage‡勇气仪祭‡勇氣儀式',
    nil,
    'Retome 7 Rifles Roubados dos Ladrões de Armas Costagulha.‡Верните 7 винтовок, украденных ворами из племени Дыбогривов.‡Holt 7 gestohlene Gewehre von den Waffendieben der Borstennacken zurück.‡뾰족털 총도둑에게서 도둑맞은 소총 7개를 되찾아야 합니다.‡Recupera 7 rifles robados de los ladrones de armas Erizapúas.‡Recupera 7 rifles robados de los ladrones de armas Erizapúas.‡Récupérer 7 Fusils volés sur des Voleurs d’armes dos-hirsutes.‡从刺背枪匪身上夺回7把被偷走的步枪。‡從刺背槍賊那裡取回7支失竊的步槍。',
  }
},
[14457] = {
  {
    'O plano dos Fendessol‡План Похитителей Солнца‡Der Plan der Sonnenhäscher‡선리버의 계획‡El plan de los Atracasol‡El plan de los Atracasol‡Le plan des Saccage-soleil‡夺日者的计划‡奪日者計畫',
    nil,
    'Obtenha as Ordens de Fendessol.‡Добудьте приказы Похитителей Солнца.‡Gelangt an die Befehle der Sonnenhäscher.‡선리버 명령서를 획득해야 합니다.‡Obtén las órdenes Atracasol.‡Obtén las órdenes Atracasol.‡Obtenez les Ordres des Saccage-soleil.‡取得夺日者命令。‡取得奪日者的命令。',
  }
},
[14458] = {
  {
    'Vá até Adana‡Идите к Эдане‡Sucht Adana auf‡아다나 찾아가기‡Ve con Adana‡Ve con Adana‡Allez voir Adana‡去找阿达娜‡到阿達那去',
    nil,
    'Vá até Adana Chifre Troante a Sudoeste.‡Идите к Эдане Громовой Рог на юго-запад.‡Sucht Adana Donnerhorn im Südwesten auf.‡남서쪽에 있는 아다나 썬더혼에게 가야 합니다.‡Ve con Adana Tronacuerno al suroeste.‡Ve con Adana Tronacuerno al suroeste.‡Cherchez Adana Corne-tonnerre au sud-ouest.‡去找西南方的阿达娜·雷角。‡前往西南方找阿達那·雷角。',
  }
},
[14459] = {
  {
    'Os javaliços‡Боевые вепри‡Die Kampfeber‡전투멧돼지‡Los jabaguerreros‡Los jabaguerreros‡Les sangliers de guerre‡斗猪‡鬥豬',
    nil,
    'Mate 10 Javaliços Encouraçados.‡Убейте 10 бронированных боевых вепрей.‡Tötet 10 gepanzerte Kampfeber.‡무장한 전투멧돼지 10마리를 처치해야 합니다.‡Mata a 10 jabaguerreros acorazados.‡Mata a 10 jabaguerreros acorazados.‡Tuez 10 Sangliers de guerre cuirassés.‡杀死10头重甲斗猪。‡消滅10隻裝甲鬥豬。',
  }
},
[14460] = {
  {
    'Rito de honra‡Обряд чести‡Ritus der Ehre‡명예의 의식‡Rito del Honor‡Rito del Honor‡Le rite d\'honneur‡荣誉仪祭‡榮耀祭儀',
    nil,
    'Mate o Chefe Grunhido Mantospinho.‡Убейте Визгуна Терновую Мантию.‡Tötet Häuptling Quieker Dornenmantel.‡왕불평쟁이 가시목도리를 처치해야 합니다.‡Mata al chivato jefe Mantospina.‡Mata al chivato jefe Mantospina.‡Tuez le chef Hurleur Mantépine.‡杀掉尖啸·刺鬃酋长。‡消滅尖叫者酋長刺鬃。',
  }
},
[14461] = {
  {
    'Alimento do mal‡Пища зла‡Futter des Bösen‡악마의 먹이‡Alimento maligno‡Alimento maligno‡Les auges du mal‡邪恶的食粮‡邪惡大餐',
    nil,
    'Use a Tocha de Adana para atear fogo em todas as 3 Gamelas nos Cercados dos Javaliços.‡Используйте факел Эданы, чтобы сжечь три корыта с сырым мясом в Загоне боевых вепрей.‡Benutzt Adanas Fackel, um alle 3 Tröge im Kriegseberpferch in Flammen zu setzen.‡아다나의 횃불을 사용해 전투멧돼지 우리 안의 여물통 3개에 불을 질러야 합니다.‡Usa la antorcha de Adana para prender fuego a los 3 abrevaderos en El Cercado de Jabaguerreros.‡Usa la antorcha de Adana para prender fuego a los 3 abrevaderos en El Cercado de Jabaguerreros.‡Servez-vous de la Torche d’Adana pour mettre le feu à 3 Auges dans l’Enclos des sangliers de guerre.‡用阿达娜的火炬烧掉斗猪围栏里的3处食槽。‡使用阿達那的火炬燒毀鬥豬圍欄裡的3個飼料槽。',
  }
},
[14462] = {
  {
    'Cabeça a prêmio‡Где моя голова?‡Wo ist mein Kopf?‡처치의 증거‡¿Dónde tengo la cabeza?‡¿Dónde tengo la cabeza?‡Où est ma tête ?‡我的头呢？‡我的頭在哪裡?',
    nil,
    'Você foi enviado para encontrar a assassina goblina Kika Furafundo na base da torre norte do Campo Talrendis.‡Встретьтесь с Крадли Дротик у подножия северной башни заставы Талрендис.‡Ihr wurdet ausgeschickt, um Euch mit der Goblinattentäterin Slinky Scharfklinge am Fuß des nördlichen Turms von Talrendisspitze zu treffen.‡탈렌디스 초소 북쪽에 있는 탑 아래에서 고블린 암살자인 슬링키 샤프쉬브를 만나야 합니다.‡Te han enviado a la base de la torre norte de Punta Talrendis para que te encuentres con la asesina goblin Finta Navajazos.‡Te enviaron a la base de la torre norte de Punta Talrendis para que te encuentres con la asesina goblin Finta Navajazos. ‡Vous devez aller chercher l’assassin gobelin Fugace Coutelard au pied de la tour du Nord de la Halte de Talrendis.‡你被派去塔伦迪斯营地北部塔底同地精刺客史莉琪·剃刀会面。‡你被派去在塔倫迪斯營地的北部高塔的底部和哥布林暗殺者史琳琪•利刀見面。',
  }
},
[14463] = {
  {
    'Cavalos para o Refúgio do Ocaso‡Лошади для Темной Гавани‡Pferde für Dämmerhafen‡어스름 안식처를 위한 말‡Caballos para El Refugio del Ocaso‡Caballos para El Refugio del Ocaso‡Des chevaux pour Havre-du-Soir‡暮湾镇的马匹‡暮色港的馬',
    nil,
    'Fale com Gwen Armstead no Refúgio do Ocaso.‡Поговорите с Гвен Армстед в Темной Гавани.‡Sprecht mit Gwen Armstead in Dämmerhafen.‡어스름 안식처에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Habla con Gwen Armstead en el Refugio del Ocaso.‡Parlez à Gwen Armstead à Havre-du-Soir.‡跟暮湾镇的格温·阿姆斯特谈一谈。‡和暮色港的葛玟·阿姆史特說話。',
  }
},
[14464] = {
  {
    'Atentado-relâmpago‡Молниеносное убийство‡Blitzschnelles Attentat‡번개같이 움직여서 정확하게 암살하기‡Asesinato a golpe de relámpago‡Asesinato a golpe de relámpago‡Attentat à la foudre‡一闪必杀‡閃擊暗殺',
    nil,
    'Fale com Kika Furafundo para subir à torre e assassinar o Capitão Mataverde. Consiga a cabeça do Capitão Mataverde.‡Сообщите Крадли Дротик, что вы готовы подняться на башню и совершить покушение на капитана Грюнвальда. Заберите голову капитана.‡Sprecht mit Slinky Scharfklinge, um auf den Turm zu klettern und Hauptmann Grunwald zu töten. Holt Hauptmann Grunwalds Kopf.‡슬링키 샤프쉬브와 대화해서 탑으로 올라가 대장 그룬발트를 암살한 후, 그의 머리카락을 획득해야 합니다.‡Habla con Finta Navajazos para ascender a la torre y asesinar al capitán Grunwald. Recoge la cabeza del capitán Grunwald.‡Habla con Finta Navajazos para ascender a la torre y asesinar al capitán Grunwald. Recoge la cabeza del capitán Grunwald.‡Allez voir Fugace Coutelard pour monter au sommet de la tour et assassiner le Capitaine Grunwald. Récupérez la Tête de Grunwald.‡同史莉琪·剃刀对话，然后爬上塔顶，刺杀格伦沃德队长，拿下格伦沃德的徽记。‡和史琳琪‧利刀交談，好登上塔頂暗殺格朗沃德隊長。取走格朗沃德隊長的腦袋。',
  }
},
[14465] = {
  {
    'Rumo ao Solar dos Greymane‡В Поместье Седогрива‡Zum Graumähnenanwesen‡그레이메인 장원으로‡Hacia la Mansión de Cringris‡Hacia la Mansión de Cringris‡Direction le manoir de Grisetête‡前往格雷迈恩庄园‡前往葛雷邁恩莊園',
    nil,
    'Fale com a Rainha Mia Greymane no Solar dos Greymane.‡Поговорите с королевой Миа Седогрив в Поместье Седогрива.‡Sprecht mit Königin Mia Graumähne im Graumähnenanwesen.‡그레이메인 장원에 있는 왕비 미아 그레이메인과 대화해야 합니다.‡Habla con la reina Mia Cringris en la Mansión de Cringris.‡Habla con la reina Mía Cringris en la Mansión de Cringris.‡Parlez à la Reine Mia Grisetête dans le Manoir de Grisetête.‡跟格雷迈恩庄园的米亚·格雷迈恩王后谈一谈。‡在葛雷邁恩莊園裡和米雅·葛雷邁恩皇后談話。',
  }
},
[14466] = {
  {
    'O observatório do rei‡Королевская обсерватория‡Das Observatorium des Königs‡왕의 관측소‡El observatorio del Rey‡El observatorio del Rey‡L\'observatoire du roi‡国王的瞭望台‡國王的觀測所',
    nil,
    'Fale com o Rei Genn Greymane no observatório do Solar dos Greymane.‡Поговорите с королем Генном Седогривом в обсерватории Поместья Седогрива.‡Sprecht mit König Genn Graumähne im Observatorium des Graumähnenanwesens.‡그레이메인 장원의 관측소 안에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el observatorio de la Mansión de Cringris.‡Habla con el rey Genn Cringris en el observatorio de la Mansión de Cringris.‡Parlez au Roi Genn Grisetête à l\'observatoire dans le Manoir de Grisetête.‡跟格雷迈恩庄园瞭望台的吉恩·格雷迈恩国王谈一谈。‡在葛雷邁恩莊園的觀測所裡和吉恩·葛雷邁恩國王談話。',
  }
},
[14467] = {
  {
    'Pobre Guilnéas...‡Горе тебе, Гилнеас!‡Oh weh, Gilneas!‡아, 길니아스여!‡¡Ah, Gilneas!‡¡Ah, Gilneas!‡Hélas, Gilnéas !‡天哪，吉尔尼斯！‡可嘆，吉爾尼斯!',
    nil,
    nil,
  }
},
[14468] = {
  {
    'Precisa-se: buchas de canhão‡Очередной новобранец‡Noch ein warmer Körper‡새로운 잡일꾼‡Otro recién llegado‡Otro recién llegado‡Le bouche-trou‡天降美差‡又一個新兵',
    nil,
    'Apresente-se ao Comandante Molotov na Cordilheira Esquecida.‡Поговорите с командующим Молотовым на Одинокой вершине.‡Meldet Euch bei Kommandant Molotov am Einsamen Grat.‡쓸쓸한 마루에 있는 사령관 몰로토브에게 보고해야 합니다.‡Preséntate ante el comandante Molotov en la Loma Desolada.‡Preséntate ante el comandante Molotov en la Loma Desolada.‡Présentez-vous au Commandant Molotov sur la Crête Lugubre.‡向凄凉山的指挥官莫洛托夫报到。‡在加里維克斯防禦哨所向指揮官摩洛托夫報到。',
  }
},
[14469] = {
  {
    'Otimização de recursos‡Подержанные вещи‡Aus zweiter Hand‡물려받기‡Material heredado‡Material heredado‡Matériel de récupération‡接过同志的包‡接續使用',
    nil,
    'Recupere 12 Pacotes de Suprimento Militar no campo minado central.‡Принесите 12 упаковок с боеприпасами с центрального минного поля.‡Beschafft Euch 12 Militärversorgungspacks vom mittleren Minenfeld.‡중부 지뢰밭에서 군사 보급품 12개를 획득해야 합니다.‡Recupera 12 paquetes de suministros militares en el campo de minas central.‡Recupera 12 paquetes de suministros militares en el campo de minas central.‡Récupérez 12 Packs de ravitaillement militaire dans le champ de mines central.‡从中央雷区回收12个军事补给包。‡從中央地雷區取回12個軍事補給包。',
  }
},
[14470] = {
  {
    'Inovação militar‡Военный прорыв‡Militärischer Durchbruch‡돌파 작전‡Avance militar‡Avance militar‡Percée militaire‡军事突破‡軍事突破',
    nil,
    'Mate o Senhor da Guerra Krellen e recupere a GAF.‡Убейте полководца Креллиана и верните РЗТ.‡Tötet Kriegsherr Krellen und beschafft Euch die BGG.‡장군 크렐리안을 처치하고 깜놀탄을 회수해야 합니다.‡Mata al Señor de la Guerra Krellen y recupera la GCS.‡Mata al Señor de la Guerra Krellen y recupera la GCS.‡Tuez le Seigneur de guerre Krellen et récupérez la GSB.‡杀死军阀克雷利安，收回SFG。‡殺死督軍克雷利安並取回SFG地對臉榴彈。',
  }
},
[14471] = {
  {
    'Morteiro certeiro‡Первоклассная мортира‡Mörser ersten Grades‡일등급 박격포 사수‡Mortero de primera‡Mortero de primera‡Mortier au premier degré‡一级准备‡初級迫擊砲',
    nil,
    'Use um Morteiro Goblínico para matar 60 Atacantes Iralisca.‡Воспользуйтесь гоблинской мортирой, чтобы убить 60 нападающих из клана Бича Злобы.‡Benutzt einen Goblinmörser, um 60 Angreifer der Grollflossen zu töten.‡고블린 박격포로 원한꼬리 공격자 60마리를 처치해야 합니다.‡Usa un mortero goblin para asesinar a 60 agresores Látigo de Ira.‡Usa un mortero goblin para asesinar a 60 agresores Látigo de Ira.‡Utilisez un Mortier gobelin pour tuer 60 Attaquants fouette-bile.‡用地精迫击炮杀掉60只恶鞭攻击者。‡使用哥布林迫擊砲殺死60個惡鞭攻擊者。',
  }
},
[14472] = {
  {
    'Bem na fuça!‡В голову!‡Dahin, wo es weh tut!‡정면으로 응수!‡¡En toda la cara!‡¡En toda la cara!‡Dans ta face !‡正中面门！‡打臉!',
    nil,
    'Use uma GAF para matar um Filho Escravizado de Arkkoroc, no campo minado ao sul.‡Воспользуйтесь РЗТ, чтобы убить порабощенного сына Арккорока на южном минном поле.‡Benutzt eine BGG, um einen versklavten Sohn von Arkkoroc auf dem südlichen Minenfeld zu töten.‡남쪽 지뢰밭에서 깜놀탄을 사용하여 사로잡힌 아크코로크의 후예 하나를 처치해야 합니다.‡Usa una GCS para matar a un hijo de Arkkoroc esclavizado en el campo de minas del sur.‡Usa una GCS para matar a un hijo de Arkkoroc esclavizado en el campo de minas del sur.‡Utilisez une GSB pour tuer un Fils d’Arkkoroc asservi au champ de mines du Sud.‡用SFG杀掉南部雷区的被奴役的亚考罗克之子。‡使用SFG在南部地雷區殺死1名被奴役的亞考羅克之子。',
  }
},
[14473] = {
  {
    'Agora o problema é nosso‡Теперь это наше дело‡Jetzt ist es unser Problem‡이젠 우리 문제‡Ahora es nuestro problema‡Ahora es nuestro problema‡C\'est notre problème, maintenant‡收拾烂摊子‡現在是我們的問題了',
    nil,
    'Mate 6 Filhotes de Teraptor.‡Убейте 6 тероящеров-детенышей.‡Tötet 6 Teraptorjunge.‡거대랩터 새끼 6마리를 처치해야 합니다.‡Mata a 6 proles de teraptor.‡Mata a 6 proles de teraptor.‡Tuez 6 Jeunes téraptors.‡杀死6只刺角雏龙。‡殺死6隻小迅猛龍。',
  }
},
[14474] = {
  {
    'Cápsulas de Fuga Goblínicas‡Гоблинские спасательные шлюпки‡Rettungskapseln der Goblins‡고블린 탈출 장치‡Cápsulas de escape goblin‡Cápsulas de escape goblin‡Les capsules de sauvetage gobelines‡地精逃生舱‡哥布林逃生艙',
    nil,
    'Resgate 6 Sobreviventes Goblins.‡Спасите 6 уцелевших гоблинов.‡Rettet 6 überlebende Goblins.‡고블린 생존자 6명을 구출해야 합니다.‡Libera a 6 supervivientes goblin.‡Libera a 6 supervivientes goblin.‡Portez secours à 6 Survivants gobelins.‡营救6名地精幸存者。‡解救6名哥布林生還者。',
  }
},
[14475] = {
  {
    'Repouso forçado‡Нелетная погода!‡Gestrandet!‡꼼짝 못해!‡¡En tierra!‡¡En tierra!‡Coursiers du vent à terre !‡落地！‡禁錮!',
    nil,
    'Encontre o Capitão Bombardeiro Fumaço, na torre noctiélfica mais ao sul, no Campo Talrendis.‡Найдите бомбардира капитана Смукса в самой южной башне ночных эльфов на заставе Талрендис.‡Findet Bombardierhauptmann Smooks im südlichsten Nachtelfenturm bei der Talrendisspitze.‡탈렌디스 초소 남쪽 끝에 있는 나이트 엘프 탑에서 폭격대장 스무크스를 찾아야 합니다.‡Encuentra al capitán bombardero Smooks en la torre más austral de los elfos de la noche en Punta Talrendis.‡Encuentra al capitán bombardero Smooks en la torre más austral de los elfos de la noche en Punta Talrendis.‡Trouvez le Capitaine bombardier Smooks près de la tour elfe de la nuit la plus au sud, à la Halte de Talrendis.‡在塔伦迪斯营地最南边的暗夜精灵塔找到掷弹兵队长斯莫科斯。‡在塔倫迪斯營地最南端的夜精靈塔找到投彈手隊長斯慕克斯。',
  }
},
[14476] = {
  {
    'Show de fogos‡Ко взрыву готовы‡Verkabelt zum großen Knall‡폭파 준비‡Preparado para la explosión‡Preparado para la explosión‡Une idée explosive‡遥控引爆‡設定爆炸',
    nil,
    'Arme as três Cargas Explosivas localizadas ao redor da base da torre mais ao sul, no Campo Talrendis.‡Приведите в боевое положение три детонатора взрывчатки, заложенной у подножия самой южной башни заставы Талрендис.‡Macht die drei Sprengladungen, die um den Fuß des südlichsten Turms an der Talrendisspitze angebracht sind, scharf.‡탈렌디스 초소 남쪽 끝의 탑 아래쪽에 있는 폭발물 3개를 설치해야 합니다.‡Arma las tres cargas explosivas localizadas alrededor de la base de la torre más austral en Punta Talrendis.‡Arma las tres cargas explosivas localizadas alrededor de la base de la torre más austral en Punta Talrendis.‡Amorcez les trois Charges explosives situées autour de la base de la tour la plus au sud, à la Halte de Talrendis.‡在塔伦迪斯营地南部塔底附近给3个炸药束接上引信。‡在塔倫迪斯營地最南端塔樓基座的三個炸藥桶設置雷管。',
  }
},
[14477] = {
  {
    'Aperta aí!‡Нажми на кнопку!‡Drückt auf den Knopf!‡단추를 눌러라!‡¡Pulsa el botón!‡¡Pulsa el botón!‡Appuyez sur le bouton !‡摁开关！‡按下按鈕!',
    nil,
    'Detone os explosivos!‡Подорвите взрывчатку!‡Zündet die Sprengladungen!‡폭발물을 터뜨리십시오!‡¡Detona los explosivos!‡¡Detona los explosivos!‡Faites péter les explosifs !‡引爆炸药！‡引爆炸彈!',
  }
},
[14478] = {
  {
    'Operação Estripa-Peixe‡Операция по потрошению рыбы‡Operation Ausnehmer‡작전명 생선 가르기‡Operación Pezentraña‡Operación Pezentraña‡Opération Poiscaille‡鱼肚行动‡魚腸行動',
    nil,
    'Apresente-se ao Comandante Molotov debaixo do canhão principal, que fica no Ancoradouro Borraquilha.‡Прибудьте для исполнения службы к командующему Молотову к главному орудию в Гавань Трюмных Вод.‡Meldet Euch bei Kommandant Molotov unter der Hauptkanone im Bilgewasserhafen zum Dienst.‡빌지워터 항만의 주포 아래에 있는 사령관 몰로토브에게 지원하겠다고 보고해야 합니다.‡Preséntate para el servicio ante el comandante Molotov, situado bajo el cañón principal del Puerto Pantoque.‡Preséntate para el servicio ante el comandante Molotov, situado bajo el cañón principal del Puerto Pantoque.‡Allez vous présenter au Commandant Molotov sous le canon principal, au Havre Baille-Fonds.‡向锈水港主炮下的指挥官莫洛托夫报到。‡向污水碼頭主要砲台下的指揮官摩洛托夫回報當前的任務。',
  }
},
[14479] = {
  {
    'Para o Areal Despedaçado!‡Таких много‡Es gibt viele andere‡즐거운 로켓 여행‡Hay muchos como ese‡Hay muchos como ese‡Il y en a beaucoup des comme ça‡人手多的是‡像這樣的還很多',
    nil,
    'Pegue um foguete até o Areal Despedaçado e então apresente-se ao Tenente Drex.‡Воспользуйтесь ракетой, чтобы добраться до Разоренного побережья, и явитесь на службу к лейтенанту Дрексу.‡Nehmt eine Rakete zum Strand der Trümmer und meldet Euch dann bei Leutnant Drex zum Dienst.‡로켓을 타고 조각난 해안으로 이동하여 부관 드렉스에게 보고해야 합니다.‡Usa un cohete para llegar a La Playa Arrasada y después preséntate ante el teniente Drex.‡Usa un cohete para llegar a La Playa Arrasada y después preséntate ante el teniente Drex.‡Utilisez une fusée pour atteindre la Grève Fracassée, puis présentez-vous au Lieutenant Drex.‡乘火箭前往破碎海岸，向德雷克斯中尉报到。‡使用一架火箭抵達碎裂水岸，然後向杜瑞克斯中尉報到。',
  }
},
[14480] = {
  {
    'Extermínio‡Истребление‡Auslöschung‡박멸‡Exterminio‡Exterminio‡Extermination‡灭绝‡殲滅',
    nil,
    'Mate 30 Nagas Iralisca nas Ruínas de Eldarath.‡Убейте 30 наг из клана Бича Злобы в руинах Эльдарата.‡Tötet 30 Naga der Grollflossen in den Ruinen von Eldarath.‡엘다라스 폐허에서 원한꼬리 나가 30마리를 처치해야 합니다.‡Mata a 30 nagas Látigo de Ira en las Ruinas de Eldarath.‡Mata a 30 nagas Látigo de Ira en las Ruinas de Eldarath.‡Tuez 30 Nagas fouette-bile aux Ruines d’Eldarath.‡在埃达拉斯废墟里杀死30只恶鞭纳迦。‡在埃達拉斯廢墟裡殺死30隻惡鞭納迦。',
  }
},
[14481] = {
  {
    '‡В бездну‡In den Abgrund‡‡En el abismo‡‡Dans les abysses‡‡',
    nil,
    '‡Намбрия просит вас поговорить с вербовщиком Бернсом в порту Штормграда.‡Nambria möchte, dass Ihr mit Rekrutierer Burns am Hafen von Sturmwind sprecht.‡‡Nambria quiere que hables con el reclutador Burns en el Puerto de Ventormenta.‡‡Nambria veut que vous parliez au Recruteur Burns sur le Port de Hurlevent.‡‡',
  }
},
[14482] = {
  {
    'O chamado do dever‡Зов долга‡Die Pflicht ruft‡연합의 부름‡La llamada del deber‡La llamada del deber‡L\'appel du devoir‡使命召唤‡決勝時刻',
    nil,
    'Embarque na nau mercenária para ir ao local da batalha.‡Отправляйтесь в бой на корабле наемников.‡Fahrt mit dem Söldnerboot zur Schlacht.‡전장으로 향하는 용병선에 타야 합니다.‡Viaja en el barco mercenario a la batalla.‡Viaja en el barco mercenario a la batalla.‡Allez à la bataille à bord du navire des mercenaires.‡乘坐雇佣船只参加战斗。‡乘坐傭兵船加入戰鬥。',
  }
},
[14483] = {
  {
    'Algo está no ar (e não é o amor)‡Не любовь витает в воздухе (а что-то иное!)‡Irgendwas liegt in der Luft (und Liebe ist es nicht)‡사랑은 아니지만, 무언가 특별한 분위기에 휩싸여‡Hay algo en el aire (y no es amor)‡Hay algo en el aire (y no es amor)‡Il y a quelque chose dans l\'air (et ce n\'est pas de l\'amour)‡微妙的气氛（肯定不是爱）‡微妙的氣氛(肯定不是愛)',
    nil,
    'Leve o Adorável Cartão Esmaecido para o Detetive Estalo Garrafuso em Orgrimmar.‡Принесите выцветшую открытку ко дню всех влюбленных детективу Крямсу Гвоздезубу в Оргриммар.‡Bringt die vergilbte schöne Grußkarte zu Detektiv Snap Schnappbolz in Orgrimmar.‡빛 바랜 아름다운 카드를 오그리마에 있는 명탐정 스냅 스내글볼트에게 가져가야 합니다.‡Llévale la tarjeta preciosa descolorida al detective Snap Tuerceganzúas en Orgrimmar.‡Llévale la tarjeta preciosa descolorida al detective Snap Tuerceganzúas en Orgrimmar.‡Rapportez la Ravissante carte de vœux décolorée à l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡将褪色的情人节卡片交给奥格瑞玛的侦探斯奈普·滑栓。‡把褪色的可愛邀請卡拿給奧格瑪的警探史內卜·凸栓。',
  }
},
[14484] = {
  {
    'Cabeça da cobra‡Голова змеи‡Kopf der Schlange‡뱀의 머리‡La cabeza de la serpiente‡La cabeza de la serpiente‡La tête du serpent‡七寸‡殺蛇要砍頭',
    nil,
    'Mate Lorde Kassarus no Templo de Zin-Malor.‡Убейте лорда Кассара в храме Зин-Малор.‡Tötet Lord Kassarus im Tempel von Zin-Malor.‡진말로의 신전에 있는 군주 카사루스를 처치해야 합니다.‡Mata a Lord Kassarus en el Templo de Zin-Malor.‡Mata a Lord Kassarus en el Templo de Zin-Malor.‡Tuez le Seigneur Kassarus au Temple de Zin-Malor.‡杀掉辛玛洛神殿里的卡萨鲁斯领主。‡在辛瑪洛神殿殺死卡斯薩魯斯領主。',
  }
},
[14485] = {
  {
    'Tique nervoso‡Нужен Тикер‡Wir brauchen Ticker‡티커가 필요해‡Necesitamos a Tictac‡Necesitamos a Tictac‡Tocant est demandé au rayon explosifs‡还少个钟摆‡需要提克爾',
    nil,
    'Leve o Tique até as ruínas e dê cobertura enquanto ele instala bombas em 3 das Pedras Rúnicas Iralisca.‡Приведите Тикера в руины и прикройте его, пока он прикрепляет бомбы к 3 руническим камням Бича Злобы.‡Bringt Ticker in die Ruinen und gebt ihm Deckung, während er Bomben an 3 der Runensteine der Grollflossen anbringt.‡티커를 폐허까지 호위한 다음 원한꼬리 마법석 3개에 폭탄을 설치하는 동안 보호해야 합니다.‡Lleva a Tictac a las ruinas y cúbrelo mientras coloca bombas en 3 de las piedras rúnicas Látigo de Ira.‡Lleva a Tictac a las ruinas y cúbrelo mientras coloca bombas en 3 de las piedras rúnicas Látigo de Ira.‡Appelez Tocant dans les ruines à l’aide de la Fusée de l’escouade Gob\' et couvrez ses arrières jusqu’à ce qu’il ait fait exploser 3 Pierres runiques fouette-bile.‡把钟摆带到遗迹里去，掩护他在3颗恶鞭符文石处埋设炸弹。‡將提克爾帶進廢墟，當他在3個惡鞭符石設定炸彈時掩護他。',
  }
},
[14486] = {
  {
    'Uns merréis‡Доставка заказа‡Die Ware anfassen‡상품 운반‡Manejar la mercancía‡Manejar la mercancía‡Bien tabler‡货物买办‡處理貨品',
    nil,
    'Colete 12 Tabuletas dos Altaneiros das Ruínas de Eldarath.‡Соберите 12 скрижалей высокорожденных в руинах Эльдарата.‡Sammelt 12 Tafeln der Hochgeborenen aus den Ruinen von Eldarath.‡엘다라스 폐허에서 명가의 서판 12개를 모아야 합니다.‡Reúne 12 tablillas de Altonato en las Ruinas de Eldarath.‡Reúne 12 tablillas de Altonato en las Ruinas de Eldarath.‡Récupérez 12 Tablettes de Bien-né dans les Ruines d\'Eldarath.‡从埃达拉斯废墟收集12块上层精灵石板。‡在埃達拉斯廢墟收集12個精靈貴族石板。',
  }
},
[14487] = {
  {
    'Quanto vale um coração‡Все еще бьющееся сердце‡Noch schlagendes Herz‡아직도 고동치는 심장‡Corazón palpitante‡Corazón palpitante‡Coup de cœur‡仍在跳动的心‡跳動的心臟',
    nil,
    'Recupere o Coração de Arkkoroc do centro das Ruínas de Eldarath.‡Найдите сердце Арккорока в центре руин Эльдарата.‡Beschafft Euch das Herz von Arkkoroc aus der Mitte der Ruinen von Eldarath.‡엘다라스 폐허 중앙에서 아크코로크의 심장을 획득해야 합니다.‡Recupera el corazón de Arkkoroc del centro de las Ruinas de Eldarath.‡Recupera el corazón de Arkkoroc del centro de las Ruinas de Eldarath.‡Récupérez le Cœur d’Arkkoroc au centre des Ruines d’Eldarath.‡从埃达拉斯废墟中央回收亚考罗克的精华。‡在埃達拉斯廢墟的中央取回亞考羅克之心。',
  }
},
[14488] = {
  {
    'Intimação‡Получите, распишитесь‡Zustellung‡서류 전달‡¡Citado!‡¡Citado!‡Vous êtes servi‡递送传票‡服務到家',
    nil,
    'Apresente a Intimação do Tribunal para o Boticário Humberto na Bastilha da Presa Negra.‡Отнесите повестку в суд аптекарю Хаммелу в Крепость Темного Клыка.‡Stellt Apotheker Hummel auf Burg Schattenfang die Vorladung bei Gericht zu.‡법정 소환장을 그림자송곳니 성채에 있는 연금술사 훔멜에게 전달해야 합니다.‡Entrega la citación judicial al boticario Hummel en el Castillo de Colmillo Oscuro.‡Entrega la citación judicial al boticario Hummel en el Castillo de Colmillo Oscuro.‡Remettez la Convocation au tribunal à l\'Apothicaire Hummel, au Donjon d\'Ombrecroc.‡将法庭传票送给影牙城堡的药剂师汉摩尔。‡把法院傳票交給影牙城堡的藥劑師胡默爾。',
  }
},
[14491] = {
  {
    'A terra indócil‡Беспокойная земля‡Ruhelose Erde‡대지의 안식‡La tierra inquieta‡La tierra inquieta‡La terre s\'agite‡不休的大地‡不平靜的大地',
    nil,
    'Use o Tambor da Terra Descansada para acalmar 6 Espíritos Terrenos Agitados.‡Используйте барабан успокоения Земли, чтобы успокоить 6 потревоженных духов земли.‡Benutzt die Trommel der besänftigten Erde, um 6 aufgebrachte Erdgeister zu beruhigen.‡위로받은 대지의 북으로 흥분한 대지의 정령 6마리를 달래야 합니다.‡Utiliza los tambores de la tierra aliviada para calmar a 6 espíritus de tierra perturbados.‡Utiliza los tambores de la tierra aliviada para calmar a 6 espíritus de tierra perturbados.‡Servez-vous du Tambour de la terre apaisée pour calmer 6 Esprits de la terre agités.‡使用宁静大地之鼓安抚6名躁动的大地之魂。‡使用安撫大地之鼓讓6個激動的大地之靈平靜。',
  }
},
[20438] = {
  {
    'Um disfarce adequado‡Подходящая маскировка‡Eine passende Verkleidung‡꼭 맞는 변장‡Un disfraz apropiado‡Un disfraz apropiado‡Nettoyage à secte‡适当的伪装‡適當的偽裝',
    nil,
    'Fale com Shandy Vaigraxa e obtenha um Tabardo Emprestado.‡Позаимствуйте у Шанди Шикблеска гербовую накидку.‡Besorgt Euch von Shandy Lackglanz einen geliehenen Wappenrock.‡섄디 글로스글림으로부터 대여 휘장을 얻어야 합니다.‡Consigue un tabardo prestado de Shandy Lustre Brillo.‡Consigue un tabardo prestado de Shandy Lustre Brillo.‡Procurez-vous un Tabard emprunté auprès de Shandy Cireluisante.‡从山迪·格罗斯那里取得“借来的战袍”。‡從桑迪·光爍那裡取得一件借來的外袍。',
  }
},
[20439] = {
  {
    'Um encontro com o magíster‡Встреча с магистром Хаторелем‡Ein Treffen mit dem Magister‡마법학자와 만나기‡Reunión con el magister‡Reunión con el magister‡Une rencontre avec le magistère‡与魔导师会面‡與博學者會面',
    nil,
    'Fale com o Magíster Hathorel e recupere o tomo das Lâminas Antigas Forjadas por Dragões.‡Возьмите книгу "Древние клинки драконьей ковки" у магистра Хатореля из Прибежища Похитителя Солнца.‡Besorgt den Folianten "Uralte drachengeschmiedete Klingen" von Magister Hathorel.‡마법학자 하소렐에게서 \'고대의 용이 벼려낸 검\'이라는 책을 구해야 합니다.‡Consigue el escrito de Hojas antiguas forjadas por los dragones del magister Hathorel.‡Consigue el escrito de Hojas antiguas forjadas por los dragones del magister Hathorel.‡Procurez-vous le tome « Lames anciennes forgées par les dragons » auprès du Magistère Hathorel.‡从魔导师哈瑟尔那里取得上古龙铸之刃典籍。‡從博學者哈索瑞爾那裡取回上古龍鑄劍刃之書。',
  }
},
[20440] = {
  {
    'Água venenosa‡Отравленная вода‡Vergiftetes Wasser‡오염된 우물‡Pozos envenenados‡Pozos envenenados‡L\'eau empoisonnée‡有毒的水‡毒水',
    nil,
    'Colete 6 Patas de Lobos-da-pradaria e 4 Garras de Pinotes.‡Принесите 6 лап волков прерий и 4 когтя равнинного долгонога.‡Sammelt 6 Präriewolftatzen und 4 Ebenenschreiterkrallen.‡초원늑대 앞발 6개와 초원타조 갈퀴발톱 4개를 모아야 합니다.‡Reúne 6 garras de lobo de pradera y 4 garfas de zancudo de llanura.‡Reúne 6 garras de lobo de pradera y 4 garfas de zancudo de llanura.‡Récupérez 6 Pattes de loups des prairies et 4 Serres de trotteurs des plaines.‡获取6只草原狼的爪子和4只平原陆行鸟的爪子。‡收集6個草原狼的爪子和4個平原陸行鳥的爪子。',
  }
},
[20441] = {
  {
    'Rito de visão‡Обряд прозрения‡Ritus der Vision‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le rite de vision‡幻象仪祭‡幻象祭儀',
    nil,
    'Beba a Água da Visão em frente à fogueira tribal na Aldeia Casco Sangrento.‡Выпейте воду провидения перед костром племени в деревне Кровавого Копыта.‡Trinkt vor dem Stammesfeuer im Dorf der Bluthufe das Wasser der Vision.‡블러드후프 마을에 있는 부족의 불 앞에서 예언의 물을 마셔야 합니다.‡Bebe el Agua de Visión delante del fuego tribal en el Poblado Pezuña de Sangre.‡Bebe el Agua de Visión delante del fuego tribal en el Poblado Pezuña de Sangre.‡Buvez l’Eau de vision devant le feu tribal de Sabot-de-Sang.‡在血蹄村的部族营火前将视像之水喝下。‡在血蹄村的部族之火前喝下幻象之水。',
  }
},
[23733] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les rites de la Terre-mère‡大地母亲的仪式‡大地之母祭儀',
    nil,
    'Fale com Dyami Ventos Altos no topo da Chapada Miralonge.‡Поговорите с Дайми Резким Ветром на Плато Востроглазой.‡Sprecht mit Dyami Windsegler oben auf der Horizontmesa.‡아득한 응시의 고원에 있는 디아미 윈드소어와 대화해야 합니다.‡Habla con Dyami Surcacielos en la cima de la Colina de Vistalonga.‡Habla con Dyami Surcacielos en la cima de la Colina de Vistalonga.‡Parler à Dyami Plane-vent au sommet de la Mesa de Mireloin.‡与远眺台地顶部的德亚米·翱风交谈。‡和遠凝台地底端的戴米·風騰談談。',
  }
},
[24215] = {
  {
    'Rito dos ventos‡Обряды Ветров‡Ritus des Winds‡바람의 의식‡Los ritos de los Vientos‡Los ritos de los Vientos‡Le rite des vents‡风之仪式‡風之祭儀',
    nil,
    'Beba a Água da Visão.‡Выпейте воду провидения.‡Trinkt das Wasser der Vision.‡예언의 물을 마셔야 합니다.‡Bebe el agua de Visión.‡Bebe el agua de Visión.‡Boire l\'Eau de vision.‡饮下视像之水。‡喝下幻象之水。',
  }
},
[24216] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: Ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Ущелья Песни Войны и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.|n‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.|n‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在战歌峡谷战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在戰歌峽谷的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[24217] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: Ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Ущелья Песни Войны и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.|n‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.|n‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在战歌峡谷战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在戰歌峽谷的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[24218] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: Ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Ущелья Песни Войны и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在战歌峡谷战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在戰歌峽谷的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[24219] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: Ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Ущелья Песни Войны и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在战歌峡谷战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在戰歌峽谷的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[24220] = {
  {
    'Chamado às armas: Bacia Arathi‡Призыв к оружию: Низина Арати‡Ruf zu den Waffen: Arathibecken‡전장으로: 아라시 분지‡Llamamiento a las armas: Cuenca de Arathi‡Llamamiento a las armas: Cuenca de Arathi‡Appel aux armes : bassin Arathi‡战斗的召唤：阿拉希盆地‡戰鬥的號角: 阿拉希盆地',
    nil,
    'Vença uma partida no campo de batalha da Bacia Arathi e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Низины Арати и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Arathibecken und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡아라시 분지 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Bassin Arathi, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在阿拉希盆地战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在阿拉希盆地的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[24221] = {
  {
    'Chamado às armas: Bacia Arathi‡Призыв к оружию: Низина Арати‡Ruf zu den Waffen: Arathibecken‡전장으로: 아라시 분지‡Llamamiento a las armas: Cuenca de Arathi‡Llamamiento a las armas: Cuenca de Arathi‡Appel aux armes : bassin Arathi‡战斗的召唤：阿拉希盆地‡戰鬥的號角: 阿拉希盆地',
    nil,
    'Vença uma partida no campo de batalha da Bacia Arathi e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Низины Арати и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Arathibecken und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡아라시 분지 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Bassin Arathi, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在阿拉希盆地战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在阿拉希盆地的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
