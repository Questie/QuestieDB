[8918] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡誠摯的建議',
    nil,
    'Adquira 15 Amostras de Peçonha de Silithus, 20 peças de ouro, um par de Braceletes dos Elementos e leve para Mokvar, em Orgrimmar.|n‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с поручьями Стихий Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Bindungen der Elemente zu Mokvar in Orgrimmar zurück.‡오그리마에 있는 모크바르에게 실리시드 독 견본 15개와 20골드를 정령의 손목띠 1개와 함께 가져가야 합니다.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de ataduras de elementos a Mokvar a Orgrimmar.|n‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de ataduras de elementos a Mokvar a Orgrimmar.|n‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d\'or, et apportez-les avec une paire de Manchettes des éléments à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副元素腕轮交给奥格瑞玛的莫克瓦尔。‡取得15滴希利蘇斯毒液樣本，20金和1套元素束腕，帶給奧格瑪的莫克瓦。',
  }
},
[8919] = {
  {
    '‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡',
    nil,
    '‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручами Багрового Тумана Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Armschienen der Furcht zu Mokvar in Orgrimmar zurück.‡‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales calígine a Mokvar a Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales calígine a Mokvar a Orgrimmar.‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d\'or, et apportez-les avec une paire de Brassards de Brume-funeste à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副鬼雾护腕交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8920] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡誠摯的建議',
    nil,
    'Adquira 15 Amostras de Peçonha de Silithus, 20 peças de ouro, um par de Braçadeiras do Valor e leve para Mokvar, em Orgrimmar.|n‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручами Доблести Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt es zusammen mit 20 Gold und einem Paar Armschienen der Ehre zu Mokvar in Orgrimmar zurück.‡오그리마에 있는 모크바르에게 실리시드 독 견본 15개와 20골드를 용맹의 팔보호구 1개와 함께 가져가야 합니다.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales de valor a Mokvar a Orgrimmar.|n‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales de valor a Mokvar a Orgrimmar.|n‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d\'or, et apportez-les avec une paire de Brassards de vaillance à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副勇气护腕交给奥格瑞玛的莫克瓦尔。‡取得15份希利蘇斯血液樣本，20金和1套勇氣護腕，帶給奧格瑪的莫克瓦。',
  }
},
[8921] = {
  {
    'O destilador ectoplásmico‡Эктоплазматический дистиллятор‡Der Ektoplasmadestillierer‡심령체 추출기‡El destilador ectoplásmico‡El destilador ectoplásmico‡L\'alambic ectoplasmique‡灵质提纯器‡魂能蒸餾器',
    nil,
    'Leve para o Mux Zoamana, em Geringontzan, 1 Conversor Delicado de Arcanita, 4 Essências Eternas Maiores, 10 unidades de Óleo de Petrescama, 25 Cinzas Vulcânicas e 40 peças de ouro.‡Принести Муксу Маноскребу из Прибамбасска 1 сверхточный арканитовый преобразователь, 4 великих сущности вечности, 10 порций масла каменного угря, 25 горстей вулканического пепла и 40 золотых.‡Kehrt mit einem empfindlichen Arkanitwandler, 4 großen ewigen Essenzen, 10 Flaschen Steinschuppenöl, 25 Einheiten Vulkanasche und 40 Gold im Gepäck zu Mux Manamix in Gadgetzan zurück.‡정교한 아케이나이트 변환기 1개, 상급 영원의 정수 4개, 돌비늘 기름 10개, 화산재 25개와 40골드를 가지고 가젯잔에 있는 먹스 마나스크램블러에게 가야 합니다.‡Vuelve a ver a Mux Cazamaná a Gadgetzan cuando tengas 1 conversor de arcanita delicado, 4 esencias eternas superiores, 10 unidades de aceite de escama pétrea, 25 cenizas volcánicas y 40 piezas de oro.‡Vuelve a ver a Mux Cazamaná a Gadgetzan cuando tengas 1 conversor de arcanita delicado, 4 esencias eternas superiores, 10 unidades de aceite de escama pétrea, 25 cenizas volcánicas y 40 piezas de oro.‡Retournez voir Mux Brouillemana à Gadgetzan avec 1 Convertisseur d\'arcanite délicat, 4 Essences éternelles supérieures, 10 Huiles de pierre-écaille, 25 Cendres volcaniques et 40 pièces d\'or.‡将1个精密奥金转换器、4份强效不灭精华、10瓶石鳞鱼油、25份火山灰和40枚金币交给加基森的穆克斯·玛纳斯卡波。‡將1個精密奧金轉換器、4份強效不滅精華、10瓶石鱗魚油，25份火山灰和40金交給在加基森的莫克斯·法力爭奪者。',
  }
},
[8922] = {
  {
    '‡Сверхъестественное устройство‡Ein übernatürlicher Apparat‡‡Un artefacto sobrenatural‡Un artefacto sobrenatural‡Un objet surnaturel‡超自然的设备‡',
    nil,
    '‡Отнесите запечатанный контейнер с кровью Муксу Маноскребу в Прибамбасск в Танарисе.‡Bringt den versiegelten Blutbehälter zu Mux Manamix in Gadgetzan in Tanaris.‡‡Lleva el frasco de sangre sellado a Mux Cazamaná a Gadgetzan, en Tanaris.‡Lleva el frasco de sangre sellado a Mux Cazamaná a Gadgetzan, en Tanaris.‡Apportez le Récipient de sang scellé à Mux Brouillemana, à Gadgetzan en Tanaris.‡将封起来的血液容器交给加基森的穆克斯·玛纳斯卡波。‡',
  }
},
[8923] = {
  {
    '‡Сверхъестественное устройство‡Ein übernatürlicher Apparat‡‡Un artefacto sobrenatural‡Un artefacto sobrenatural‡Un objet surnaturel‡超自然的设备‡超自然儀器',
    nil,
    '‡Отнесите запечатанный ларчик с ядом Муксу Маноскребу в Прибамбасск.‡Bringt den versiegelten Giftbehälter zu Mux Manamix in Gadgetzan.‡‡Lleva el frasco de veneno sellado a Mux Cazamaná a Gadgetzan.‡Lleva el frasco de veneno sellado a Mux Cazamaná a Gadgetzan.‡Remettez le Récipient de venin scellé à Mux Brouillemana, à Gadgetzan.‡将封起来的毒液容器交给加基森的穆克斯·玛纳斯卡波。‡將密封的毒液交給在加基森的莫克斯·法力爭奪者。',
  }
},
[8924] = {
  {
    'Em busca de ectoplasma‡В поисках эктоплазмы‡Ektoplasmajagd‡심령체 수집‡Caza de ectoplasmas‡Caza de ectoplasmas‡La chasse aux ectoplasmes‡猎取灵质‡尋找魂能',
    nil,
    'Use o Destilador Ectoplásmico perto de mortos-vivos incorpóreos para coletar 12 Ectoplasmas Chamuscados em Silithus, 12 Ectoplasmas Congelados em Hibérnia e 12 Ectoplasmas Estáveis nas Terras Pestilentas Orientais. Leve-os juntamente com o Destilador Ectoplásmico para Mux Zoamana em Geringontzan.‡Воспользуйтесь эктоплазматическим дистиллятором рядом с бестелесной нежитью и соберите 12 образцов опаленной эктоплазмы в Силитусе, 12 образцов замороженной эктоплазмы в Зимних Ключах и 12 образцов стабильной эктоплазмы в Восточных Чумных землях. Принесите их вместе с эктоплазматическим дистиллятором Муксу Маноскребу в Прибамбасск.‡Benutzt den Ektoplasmadestillierer in der Nähe von schemenhaften Untoten, um 12 Einheiten versengtes Ektoplasma in Silithus, 12 Einheiten gefrorenes Ektoplasma in Winterquell und 12 Einheiten stabiles Ektoplasma in den Östlichen Pestländern zu erhalten. Bringt das Ektoplasma dann mitsamt des Ektoplasmadestillierers zu Mux Manamix in Gadgetzan zurück.‡언데드 가까이에 심령체 추출기를 설치하여 실리더스에서 불타버린 심령체를, 여명의 설원에서 얼어붙은 심령체를, 동부 역병지대에서 안정적인 심령체를 각각 12개씩 수집해야 합니다. 심령체 추출기와 함께 가지고 가젯잔에 있는 먹스 마나스크램블러에게 돌아가십시오.‡Utiliza el destilador ectoplásmico cerca de los no-muertos incorpóreos y consigue 12 ectoplasmas agostados en Silithus, 12 ectoplasmas helados en Cuna del Invierno y 12 ectoplasmas estables en las Tierras de la Peste del Este. Llévaselos, junto con el destilador ectoplásmico, a Mux Cazamaná a Gadgetzan.‡Utiliza el destilador ectoplásmico cerca de los no-muertos incorpóreos y consigue 12 ectoplasmas agostados en Silithus, 12 ectoplasmas helados en Cuna del Invierno y 12 ectoplasmas estables en las Tierras de la Peste del Este. Llévaselos, junto con el destilador ectoplásmico, a Mux Cazamaná a Gadgetzan.‡Utilisez l\'Alambic ectoplasmique à proximité de morts-vivants désincarnés pour recueillir 12 Ectoplasmes brûlés en Silithus, 12 Ectoplasmes glacés au Berceau-de-l\'hiver et 12 Ectoplasmes stables dans les Maleterres de l\'est. Remettez à Mux Brouillemana à Gadgetzan. Il veut aussi récupérer l\'Alambic ectoplasmique.‡使用灵质提纯器在希利苏斯收集12份烧焦的灵质，在冬泉谷收集12份冰冻的灵质，以及在东瘟疫之地收集12份稳定的灵质。然后将这些东西与灵质提纯器一起交给加基森的穆克斯·玛纳斯卡波。‡前往東瘟疫之地，在無形的不死族附近使用魂能蒸餾器收集12個希利蘇斯燒焦的魂能、12個冬泉谷冰凍的魂能和12個東瘟疫之地穩定的魂能。將它們和魂能蒸餾器一起交給在加基森的莫克斯·法力爭奪者。',
  }
},
[8925] = {
  {
    'Fonte de energia portátil‡Портативный источник энергии‡Eine portable Energiequelle‡휴대용 에너지원‡Fuente de energía portátil‡Fuente de energía portátil‡Une source d\'énergie portable‡便携的能量源‡攜帶式能量泉源',
    nil,
    'Encontre Bokk, Senhor do Magma, nas Estepes Ardentes, obtenha o Núcleo de Magma dele e leve-o para Mux Zoamana em Geringontzan.‡Отыщите в Пылающих степях Повелителя магмы Бокка, добудьте его магмовое ядро и отнесите его Муксу Маноскребу в Прибамбасск.‡Findet Magmafürst Bokk in der Brennenden Steppe, nehmt seinen Magmakern an Euch und bringt ihn zu Mux Manamix in Gadgetzan.‡불타는 평원에서 용암 군주 보크를 찾아서 용암 핵을 구한 후 가젯잔에 있는 먹스 마나스크램블러에게 가져가야 합니다.‡Encuentra al Señor del Magma Bokk en Las Estepas Ardientes, consigue el núcleo de arrabio y llévaselo a Mux Cazamaná a Gadgetzan.‡Encuentra al Señor del Magma Bokk en Las Estepas Ardientes, consigue el núcleo de arrabio y llévaselo a Mux Cazamaná a Gadgetzan.‡Trouvez le Seigneur-magma Bokk dans les Steppes ardentes, prenez son Cœur de magma et rapportez-le à Mux Brouillemana, à Gadgetzan.‡前往燃烧平原，找到熔岩领主博奥克，把它的岩浆核心交给加基森的穆克斯·玛纳斯卡波。‡去燃燒平原找到熔岩領主博克，取得他的岩漿之核帶給在加基森的莫克斯·法力爭奪者。',
  }
},
[8926] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡',
    nil,
    '‡Принесите пояс дикого cердца и пару перчаток дикого cердца в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel des Wildherzens und ein Paar Handschuhe des Wildherzens.‡‡Lleva 1 cinturón y 1 par de guantes Corazón Salvaje a Deliana a Forjaz.‡Lleva 1 cinturón y 1 par de guantes Corazón Salvaje a Deliana a Forjaz.‡Apportez une Ceinture du Cœur-sauvage et une paire de Gants du Cœur-sauvage à Deliana à Forgefer.‡将一条野性之心腰带和一副野性之心手套交给铁炉堡的德莉亚娜。‡',
  }
},
[8927] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡公平的補償',
    nil,
    'Leve um Cinto do Coração Selvagem e um par de Luvas do Coração Selvagem para Mokvar em Orgrimmar.‡Принесите Моквару в Оргриммар пояс дикого cердца и перчатки дикого cердца.‡Bringt Mokvar in Orgrimmar einen Gürtel des Wildherzens und ein Paar Handschuhe des Wildherzens.‡‡Lleva 1 cinturón y 1 par de guantes Corazón Salvaje a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes Corazón Salvaje a Mokvar a Orgrimmar.‡Apportez une Ceinture du Cœur-sauvage et une paire de Gants du Cœur-sauvage à Mokvar à Orgrimmar.‡将一条野性之心腰带和一副野性之心手套交给奥格瑞玛的莫克瓦尔。‡將野性之心腰帶和1套野性之心手套帶給奧格瑪的莫克瓦。',
  }
},
[8928] = {
  {
    '‡Сомнительный торговец‡Ein verschlagener Händler‡‡Un mercader sospechoso‡Un mercader sospechoso‡Un marchand à éclipses‡小巧的商人‡',
    nil,
    '‡Отыщите беса в пещере у входа в Теснину Зловещего Шепота в южной части Зимних Ключей, купите жезл Скверны Стихий и отнесите его Муксу Маноскребу в Прибамбасск.‡Sucht den Wichtel in der Höhle in der Nähe der Flüsternden Schlucht im Süden von Winterquell. Kauft ihm einen teufelselementaren Brennstab ab und kehrt zu Mux Manamix in Gadgetzan zurück.‡‡Busca a un diablillo dentro de una cueva situada a la entrada de la Garganta Negro Rumor en la zona sur de Cuna del Invierno, compra una biela de energía vil elemental y vuelve a ver a Mux Cazamaná a Gadgetzan.‡Busca a un diablillo dentro de una cueva situada a la entrada de la Garganta Negro Rumor en la zona sur de Cuna del Invierno, compra una biela de energía vil elemental y vuelve a ver a Mux Cazamaná a Gadgetzan.‡Trouvez un diablotin qui vivrait dans une caverne à l\'entrée de la gorge du Sombre murmure, au sud du Berceau-de-l\'Hiver. Achetez-lui un Bâtonnet élémentaire de corruption, puis retournez voir Mux Brouillemana à Gadgetzan.‡到冬泉谷南部的暗语峡谷入口附近去，在那里的一处洞穴内的某个小鬼那里购买一根恶魔元素之杖，并把它交给加基森的穆克斯·玛纳斯卡波。‡',
  }
},
[8929] = {
  {
    '‡В поисках Антиона‡Suche nach Anthion‡‡Buscando a Anthion‡Buscando a Anthion‡À la recherche d\'Anthion‡寻找安泰恩‡',
    nil,
    '‡Используйте спектральный сканер иных измерений на входе в Стратхольм и поговорите с духом Антиона Хармона.‡Benutzt den extradimensionalen Geisterdetektor am Eingang zu Stratholme und sprecht mit dem Geist von Anthion Harmon.‡‡Usa el detector de fantasmas extradimensional en la entrada de Stratholme y habla con el fantasma de Anthion Harmon.‡Usa el detector de fantasmas extradimensional en la entrada de Stratholme y habla con el fantasma de Anthion Harmon.‡Utilisez le Révélateur de fantômes extradimensionnel à l\'entrée de Stratholme et parlez au fantôme d\'Anthion Harmon.‡在斯坦索姆的入口处使用超维度幽灵显形器，然后与安泰恩·哈尔蒙的灵魂交谈。‡',
  }
},
[8930] = {
  {
    '‡В поисках Антиона‡Suche nach Anthion‡‡Buscando a Anthion‡Buscando a Anthion‡À la recherche d\'Anthion‡寻找安泰恩‡',
    nil,
    '‡Используйте спектральный сканер иных измерений на входе в Стратхольм и поговорите с духом Антиона Хармона.‡Benutzt den extradimensionalen Geisterdetektor am Eingang zu Stratholme und sprecht mit dem Geist von Anthion Harmon.‡‡Usa el detector de fantasmas extradimensional en la entrada de Stratholme y habla con el fantasma de Anthion Harmon.‡Usa el detector de fantasmas extradimensional en la entrada de Stratholme y habla con el fantasma de Anthion Harmon.‡Utilisez le Révélateur de fantômes extradimensionnel à l\'entrée de Stratholme, et parlez au fantôme d\'Anthion Harmon.‡在斯坦索姆的入口处使用超维度幽灵显形器，然后与安泰恩-哈尔蒙的灵魂交谈。‡',
  }
},
[8931] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс загонщика и пару перчаток загонщика в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Bestienjägergürtel und ein Paar Bestienjägerhandschuhe.‡‡Lleva 1 cinturón y 1 par de guantes de acechabestias a Deliana a Forjaz.‡Lleva 1 cinturón y 1 par de guantes de acechabestias a Deliana a Forjaz.‡Apportez une Ceinture de bestiaire et une paire de Gants de bestiaire à Deliana à Forgefer.‡将驭兽者腰带和1套驭兽者手套带给铁炉堡的德莉娜。‡',
  }
},
[8932] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс Магистра и пару перчаток Магистра в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel des Magisters und ein Paar Handschuhe des Magisters.‡‡Lleva 1 cinturón y 1 par de guantes de magister a Deliana a Forjaz.|n‡Lleva 1 cinturón y 1 par de guantes de magister a Deliana a Forjaz.|n‡Apportez une Ceinture de magistère et une paire de Gants de magistère à Deliana à Forgefer.‡将博学者腰带和1套博学者手套带给铁炉堡的德莉娜。‡',
  }
},
[8933] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс из светлостали и пару рукавиц из светлостали в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel des Lichts und ein Paar Stulpen des Lichts.‡‡Lleva 1 cinturón y 1 par de guanteletes Forjaluz a Deliana a Forjaz.|n‡Lleva 1 cinturón y 1 par de guanteletes Forjaluz a Deliana a Forjaz.|n‡Apportez une Ceinture de Sancteforge et une paire de Gantelets de Sancteforge à Deliana à Forgefer.‡将一条光铸腰带和一副光铸护腕交给铁炉堡的德莉亚娜。‡',
  }
},
[8934] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс преданности и перчатки преданности в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel des Gläubigen und ein Paar Handschuhe des Gläubigen.‡‡Lleva 1 cinturón y 1 par de guantes de devoto a Deliana a Forjaz.‡Lleva 1 cinturón y 1 par de guantes de devoto a Deliana a Forjaz.‡Apportez une Ceinture de dévot et une paire de Gants de dévot à Deliana à Forgefer.‡将虔诚腰带和1套虔诚手套带给铁炉堡的德莉娜。‡',
  }
},
[8935] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс Незаметности и пару перчаток Незаметности в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel der Schattenkunst und ein Paar Handschuhe der Schattenkunst.‡‡Lleva 1 cinturón y 1 par de guantes arte sombrío a Deliana a Forjaz.‡Lleva 1 cinturón y 1 par de guantes arte sombrío a Deliana a Forjaz.‡Apportez une Ceinture Sombreruse et une paire de Gants Sombreruse à Deliana à Forgefer.‡将迅影腰带和1套迅影手套带给铁炉堡的德莉娜。‡',
  }
},
[8936] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс Багрового Тумана и повязки Багрового Тумана в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel der Furcht und ein Paar Wickeltücher der Furcht.‡‡Lleva 1 cinturón y 1 par de guantes calígine a Deliana a Forjaz.‡Lleva 1 cinturón y 1 par de guantes calígine a Deliana a Forjaz.‡Apportez une Ceinture de Brume-funeste et des Gants de Brume-funeste à Deliana à Forgefer.‡将一条鬼雾腰带和一副鬼雾手套交给铁炉堡的德莉亚娜。‡',
  }
},
[8937] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите пояс Доблести и пару рукавиц Доблести в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede einen Gürtel der Ehre und ein Paar Stulpen der Ehre.‡‡Lleva 1 cinturón y 1 par de guanteletes de valor a Deliana a Forjaz.‡Lleva 1 cinturón y 1 par de guanteletes de valor a Deliana a Forjaz.‡Apportez une Ceinture de vaillance et une paire de Gantelets de vaillance à Deliana à Forgefer.‡将勇气腰带和1套勇气护手带给铁炉堡的德莉娜。‡',
  }
},
[8938] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар пояс загонщика и перчатки загонщика.‡Bringt Mokvar in Orgrimmar einen Bestienjägergürtel und ein Paar Bestienjägerhandschuhe.‡‡Lleva 1 cinturón y 1 par de guantes de acechabestias a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes de acechabestias a Mokvar a Orgrimmar.‡Apportez une Ceinture de bestiaire et une paire de Gants de bestiaire à Mokvar à Orgrimmar.‡将一条野兽追猎者腰带和一副野兽追猎者手套交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8939] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар пояс Магистра и перчатки Магистра.‡Bringt Mokvar in Orgrimmar einen Gürtel des Magisters und ein Paar Handschuhe des Magisters.‡‡Lleva 1 cinturón y 1 par de guantes de magister a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes de magister a Mokvar a Orgrimmar.‡Apportez une Ceinture de magistère et une paire de Gants de magistère à Mokvar à Orgrimmar.‡将一条博学者腰带和一副博学者手套交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8940] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар пояс преданности и перчатки преданности.‡Bringt Mokvar in Orgrimmar einen Gürtel des Gläubigen und ein Paar Handschuhe des Gläubigen.‡‡Lleva 1 cinturón y 1 par de guantes de devoto a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes de devoto a Mokvar a Orgrimmar.‡Apportez une Ceinture de dévot et une paire de Gants de dévot à Mokvar à Orgrimmar.‡将一条虔诚腰带和一副虔诚手套交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8941] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар пояс Незаметности и перчатки Незаметности.‡Bringt Mokvar in Orgrimmar einen Gürtel der Schattenkunst und ein Paar Handschuhe der Schattenkunst.‡‡Lleva 1 cinturón y 1 par de guantes arte sombrío a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes arte sombrío a Mokvar a Orgrimmar.‡Apportez une Ceinture Sombreruse et une paire de Gants Sombreruse à Mokvar à Orgrimmar.‡将一条迅影腰带和一副迅影手套交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8942] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар плетеный ремень Стихий и рукавицы Стихий.‡Bringt Mokvar in Orgrimmar eine Kordel der Elemente und ein Paar Stulpen der Elemente.‡‡Lleva 1 cordón y 1 par de guanteletes de elementos a Mokvar a Orgrimmar.|n‡Lleva 1 cordón y 1 par de guanteletes de elementos a Mokvar a Orgrimmar.|n‡Apportez une Corde des éléments et une paire de Gantelets des éléments à Mokvar à Orgrimmar.‡将一条元素束腰和一副元素护手交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8943] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар пояс Багрового Тумана и повязки Багрового Тумана.‡Bringt Mokvar in Orgrimmar einen Gürtel der Furcht und ein Paar Wickeltücher der Furcht.‡‡Lleva 1 cinturón y 1 par de guantes calígine a Mokvar a Orgrimmar.|n‡Lleva 1 cinturón y 1 par de guantes calígine a Mokvar a Orgrimmar.|n‡Apportez une Ceinture de Brume-funeste et des Gants de Brume-funeste à Mokvar à Orgrimmar.‡将一条鬼雾腰带和一副鬼雾手套交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8944] = {
  {
    '‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    '‡Принесите Моквару в Оргриммар пояс Доблести и рукавицы Доблести.‡Bringt Mokvar in Orgrimmar einen Gürtel der Ehre und ein Paar Stulpen der Ehre.‡‡Lleva 1 cinturón y 1 par de guanteletes de valor a Mokvar a Orgrimmar.|n‡Lleva 1 cinturón y 1 par de guanteletes de valor a Mokvar a Orgrimmar.|n‡Apportez une Ceinture de vaillance et une paire de Gantelets de vaillance à Mokvar à Orgrimmar.‡将一条勇气腰带和一副勇气护手交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8945] = {
  {
    'Súplica de um morto‡Просьба мертвеца‡Die letzte Bitte eines toten Mannes‡죽은 자의 부탁‡La súplica de un muerto‡La súplica de un muerto‡La supplique du mort‡死人的请求‡逝者的請求',
    nil,
    'Entre em Stratholme e resgate Ysida Harmon do Barão Rivendare.‡Отправляйтесь в Стратхольм и спасите Исиду Хармон от барона Ривендера.‡Geht nach Stratholme und befreit Ysida Harmon aus den Fängen von Baron Totenschwur.‡스트라솔름으로 가서 남작 리븐데어로부터 이시다 하몬을 구출해야 합니다.‡Ve a Stratholme y rescata a Ysida Harmon del Barón Osahendido.‡Ve a Stratholme y rescata a Ysida Harmon del Barón Osahendido.‡Entrez à Stratholme et sauvez Ysida Harmon du baron Vaillefendre.‡进入斯坦索姆，从瑞文戴尔男爵手中救出伊思达。‡前往斯坦索姆從瑞文戴爾男爵那裡救出亞希達·哈莫。',
  }
},
[8946] = {
  {
    'Prova de vida‡Доказательство жизни‡Lebensbeweis‡생존의 증거‡Prueba de vida‡Prueba de vida‡Une preuve de vie‡生命的证据‡生命的證據',
    nil,
    'Leve o Medalhão de Ysida para Anthion Harmon nas Terras Pestilentas Orientais.‡Отнесите медальон Исиды Антиону Хармону в Восточные Чумные земли.‡Bringt Anthion Harmon in den Östlichen Pestländern Ysidas Medaillon.‡동부 역병지대에 있는 안시온 하몬에게 이시다의 펜던트를 가져가야 합니다.‡Lleva el Guardapelo de Ysida a Anthion Harmon a las Tierras de la Peste del Este.‡Lleva el Guardapelo de Ysida a Anthion Harmon a las Tierras de la Peste del Este.‡Remettre le Médaillon d\'Ysida à Anthion Harmon, dans les Maleterres de l\'est.‡将伊思达的盒子交给东瘟疫之地的安泰恩·哈尔蒙。‡將亞希達的小墜子帶給東溫疫之地的安希恩·哈莫。',
  }
},
[8947] = {
  {
    'O estranho pedido de Anthion‡Странная просьба Антиона‡Anthions merkwürdige Anforderung‡안시온의 이상한 부탁‡La extraña petición de Anthion‡La extraña petición de Anthion‡L\'étonnante requête d\'Anthion‡安泰恩的奇怪请求‡安希恩奇怪的要求',
    nil,
    'Leve 3 Barras de Ferro Negro, 20 Couros Encantados, 3 Lunatramas e 4 Pelegos Rústicos Curados para Anthion Harmon nas Terras Pestilentas Orientais.‡Принести три слитка черного железа, 20 кусков зачарованной кожи, 3 куска луноткани и 4 обработанные грубые шкуры Антиону Хармону в Восточные Чумные земли.‡Bringt Anthion Harmon in den Östlichen Pestländern 3 Dunkeleisenbarren, 20 verzaubertes Leder, 3 Mondstoff und 4 geschmeidige unverwüstliche Bälge.‡동부 역병지대에 있는 안시온 하몬에게 검은무쇠 주괴 3개, 마력 깃든 가죽 20개, 달빛 옷감 3개, 거친 경화 가죽 4개를 가져가야 합니다.‡Lleva 3 barras de hierro negro, 20 retales de cuero encantado, 3 de tela lunar y 4 pellejos bastos curtidos a Anthion Harmon a las Tierras de la Peste del Este.‡Lleva 3 barras de hierro negro, 20 retales de cuero encantado, 3 de tela lunar y 4 pellejos bastos curtidos a Anthion Harmon a las Tierras de la Peste del Este.‡Remettre 3 Barres de sombrefer, 20 Cuirs enchantés, 3 Etoffes lunaires et 4 Peaux robustes traitées à Anthion Harmon dans les Maleterres de l\'est.‡将3块黑铁锭、20张魔化皮、3块月布和4块熟化毛皮交给东瘟疫之地的安泰恩·哈尔蒙。‡將3塊黑鐵錠，20塊附魔皮，3塊月布和4塊熟化毛皮帶給東溫疫之地的安希恩·哈莫。',
  }
},
[8948] = {
  {
    '‡Старый приятель Антиона‡Anthions alter Freund‡‡Un viejo amigo de Anthion‡Un viejo amigo de Anthion‡Le vieil ami d\'Anthion‡安泰恩的老朋友‡',
    nil,
    '‡Отнесите незаконченное Знамя Вызова Фалрину Садовнику в библиотеку Забытого Города.‡Bringt Falrin Rankenweber in der Bibliothek von Düsterbruch das unvervollständigte Banner der Provokation.‡‡Lleva el estandarte de Provocación incompleto a Falrin Tallarbol que está en la biblioteca de La Masacre.‡Lleva el estandarte de Provocación incompleto a Falrin Tallarbol que está en la biblioteca de La Masacre.‡Apportez la Bannière de défi incomplète à Farlin Sculpteflore, dans la bibliothèque de Hache-Tripes.‡将未完成的挑战之旗交给厄运之槌图书馆内的法尔林·树影。‡',
  }
},
[8949] = {
  {
    'A vendeta de Falrin‡Кровная месть Фарлина‡Falrins Rachefeldzug‡팔린의 피의 복수‡La vendetta de Falrin‡La vendetta de Falrin‡La vendetta de Falrin‡法尔林的复仇‡法琳的仇恨',
    nil,
    'Colete 25 Colares de Guerra dos Ogros dos Ogros no Gládio Cruel ou no Pico da Rocha Negra e fale novamente com Falrin Arboril no Ateneu do Gládio Cruel.‡Соберите 25 боевых ожерелий огров с огров Забытого Города или Пика Черной горы и вернитесь в Читальню Забытого Города к Фалрину Садовнику.‡Nehmt den Ogern in der Schwarzfelsspitze oder in Düsterbruch 25 Ogerkriegsperlen ab und bringt sie zu Falrin Rankenweber im Athenaeum, der Bibliothek von Düsterbruch.‡혈투의 전장이나 검은바위 첨탑의 오우거로부터 오우거 전투 목걸이 25개를 모은 후 도서관 안에 있는 팔린 트리셰이퍼에게 가야 합니다.‡Reúne 25 abalorios de guerra de ogro de los ogros de La Masacre o de la Cumbre de Roca Negra y vuelve a El Athenaeum de La Masacre a hablar con Falrin Tallarbol.‡Reúne 25 abalorios de guerra de ogro de los ogros de La Masacre o de la Cumbre de Roca Negra y vuelve a El Athenaeum de La Masacre a hablar con Falrin Tallarbol.‡Collecter 25 Perles de guerre ogres à l\'intérieur de Hache-tripes ou du Pic Rochenoire, puis revenir voir Falrin Sculpteflore, à l\'intérieur de l\'Athenaeum à Hache-tripes.‡在厄运之槌和黑石塔的食人魔身上收集25串食人魔珠串，然后回去向厄运之槌图书馆内的法尔林·树影复命。‡從厄運之槌或黑石塔的巨魔身上收集25個巨魔戰爭串珠再回到厄運之槌圖書館找法琳·樹形者。',
  }
},
[8950] = {
  {
    '‡Чары подстрекателя‡Die Verzauberung des Aufhetzers‡‡El encantamiento del provocador‡El encantamiento del provocador‡L\'enchantement du provocateur‡旗帜上的附魔‡',
    nil,
    '‡Принесите 1 сущность язвительного призрака, 4 черных руны и 8 больших сверкающих осколков Фалрину Садовнику в Забытом Городе.‡Bringt Falrin Rankenweber in Düsterbruch 1 Essenz eines spöttischen Geisterwesens, 4 Dunkelrunen und 8 große glänzende Splitter.‡‡Lleva a Falrin Tallarbol a La Masacre, lo siguiente: 1 esencia de espectro bufón, 4 runas oscuras y 8 fragmentos luminosos grandes.‡Lleva a Falrin Tallarbol a La Masacre, lo siguiente: 1 esencia de espectro bufón, 4 runas oscuras y 8 fragmentos luminosos grandes.‡Apportez les choses suivantes à Falrin Sculpteflore dans Hache-Tripes : 1 Essence de spectre railleur, 4 Runes ténébreuses et 8 Grands éclats brillants.‡将1份游荡鬼灵的精华、4个黑暗符文和8个大块魔光碎片交给厄运之槌图书馆内的法尔林·树影。‡',
  }
},
[8951] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    '‡Вернитесь в Стальгорн к Делиане с сапогами дикого cердца, килтом дикого cердца и наплечем дикого сердца.‡Kehrt mit einem Paar Stiefel des Wildherzens, einem Kilt des Wildherzens und einer Schiftung des Wildherzens zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 falda y 1 par de bufas Corazón Salvaje a Deliana a Forjaz.‡Lleva 1 par de botas, 1 falda y 1 par de bufas Corazón Salvaje a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des bottes du Cœur-sauvage, un Kilt du Cœur-sauvage et des Spallières du Cœur-sauvage.‡带上一双野性之心长靴、一条野性之心褶裙和一副野性之心肩甲，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8952] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Принесите в Стальгорн Делиане сапоги загонщика, штаны загонщика и оплечье загонщика.‡Kehrt mit einem Paar Bestienjägerstiefeln, einer Bestienjägerhose und einem Bestienjägermantel zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 pantalón y 1 manto de acechabestias a Deliana a Forjaz.‡Lleva 1 par de botas, 1 pantalón y 1 manto de acechabestias a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de bestiaire, un Pantalon de bestiaire et un Mantelet de bestiaire.‡带着驭兽者长靴，驭兽者短裤和驭兽者衬肩回到铁炉堡的德莉娜那里。‡',
  }
},
[8953] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Deliana em Altaforja, levando um par de Botas do Magíster, um par de Perneiras do Magíster e Dragonas do Magíster.‡Вернитесь в Стальгорн к Делиане с сапогами Магистра, поножами Магистра и мантией Магистра.‡Kehrt mit einem Paar Stiefel des Magisters, Gamaschen des Magisters und einem Mantel des Magisters zu Deliana in Eisenschmiede zurück.‡원소술사 장화, 원소술사 다리보호구, 원소술사 어깨덧옷을 가지고 아이언포지에 있는 델리아나에게 가야 합니다.‡Lleva 1 par de botas, 1 manto y 1 par de leotardos de magister a Deliana a Forjaz.‡Lleva 1 par de botas, 1 manto y 1 par de leotardos de magister a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de magistère, des Jambières de magistère et un Mantelet de magistère.‡带上一双博学者长靴、一条博学者护腿和一副博学者衬肩，回去向铁炉堡的德莉亚娜复命。‡帶著博學者長靴，博學者護腿和博學者披肩回到鐵爐堡的德莉娜那裡。',
  }
},
[8954] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Принесите в Стальгорн Делиане сапоги из светлостали, ножные латы из светлостали и наплеч из светлостали.‡Kehrt mit einem Paar Stiefel des Lichts, Beinplatten des Lichts, und einer Schiftung des Lichts zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas Forjaluz a Deliana a Forjaz.‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas Forjaluz a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de Sancteforge, des Cuissards de Sancteforge et des Spallières de Sancteforge.‡带上一双光铸战靴、一条光铸腿铠和一副光铸肩铠，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8955] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Принесите в Стальгорн Делиане сандалии Преданности, юбку Преданности и оплечье Преданности.‡Kehrt mit einem Paar Sandalen des Gläubigen, einem Rock des Gläubigen und einem Mantel des Gläubigen zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de zapatos, 1 saya y 1 manto de devoto a Deliana a Forjaz.‡Lleva 1 par de zapatos, 1 saya y 1 manto de devoto a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Sandales de dévot, une Jupe de dévot et un Mantelet de dévot.‡带着虔诚软鞋，虔诚长裙和虔诚衬肩回到铁炉堡的德莉娜那里。‡',
  }
},
[8956] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    '‡Принесите в Стальгорн Делиане сапоги Незаметности, штаны Незаметности и наплеч Незаметности.‡Kehrt mit einem Paar Stiefel der Schattenkunst, einer Hose der Schattenkunst und einer Schiftung der Schattenkunst zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 pantalón y 1 par de bufas arte sombrío a Deliana a Forjaz.‡Lleva 1 par de botas, 1 pantalón y 1 par de bufas arte sombrío a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes Sombreruse, un Pantalon Sombreruse et des Spallières Sombreruse.‡带上一双迅影长靴、一条迅影短裤和一副迅影肩甲，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8957] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    '‡Отдайте Моквару в Оргриммаре сапоги Стихий, килт Стихий и наплечье Стихий.‡Kehrt mit einem Paar Stiefel der Elemente, einem Kilt der Elemente und Schulterstücken der Elemente zu Mokvar in Orgrimmar zurück.‡‡Lleva 1 par de botas, 1 falda y unos espaldares de elementos a Mokvar a Orgrimmar.‡Lleva 1 par de botas, 1 falda y unos espaldares de elementos a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Bottes des éléments, un Kilt des éléments et des Espauliers des éléments.‡带上一双元素长靴、一条元素护腿和一副元素护肩，回去向奥格瑞玛的莫克瓦尔复命。‡',
  }
},
[8958] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    '‡Принесите в Стальгорн Делиане сандалии Багрового Тумана, поножи Багрового Тумана и оплечье Багрового Тумана.‡Kehrt mit einem Paar Sandalen der Furcht, Gamaschen der Furcht und einem Mantel der Furcht zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de sandalias, 1 par de leotardos y 1 manto calígine a Deliana a Forjaz.‡Lleva 1 par de sandalias, 1 par de leotardos y 1 manto calígine a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Sandales de Brume-funeste, des Jambières de Brume-funeste et un Mantelet de Brume-funeste.‡带上一双鬼雾便鞋、一条鬼雾护腿和一副鬼雾衬肩，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8959] = {
  {
    '‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    '‡Принесите в Стальгорн Делиане сапоги Доблести, ножные латы Доблести и наплеч Доблести.‡Kehrt mit einem Paar Stiefel der Ehre, Beinplatten der Ehre und einer Schiftung der Ehre zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas de valor a Deliana a Forjaz.‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas de valor a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de vaillance, des Cuissards de vaillance et des Spallières de vaillance.‡带着勇气战靴，勇气腿铠和勇气肩甲回到铁炉堡的德莉娜那里。‡',
  }
},
[8960] = {
  {
    'O infeliz destino de Bodley‡Злосчастная доля Бодли‡Bodleys trauriges Schicksal‡보들리의 불행한 운명‡El triste destino de Bodley‡El triste destino de Bodley‡Le triste destin de Bodley‡伯德雷的不幸‡布德利不幸的命運',
    nil,
    'Vá até a Montanha Rocha Negra e use o Revelador Extradimensional de Fantasmas para encontrar Bodley próximo ao Pico da Rocha Negra.‡Отыщите Бодли у Пика Черной горы с помощью спектрального сканера иных измерений.‡Reist zum Schwarzfels und benutzt den extradimensionalen Geisterdetektor, um Bodley nahe der Schwarzfelsspitze zu finden.‡검은바위 산으로 가 검은바위 첨탑 근처에서 4차원 유령 탐색기를 사용하여 보들리를 찾아야 합니다.‡Viaja hasta la Montaña Roca Negra y usa el detector de fantasmas extradimensionales para encontrar a Bodley cerca de la Cumbre de Roca Negra.‡Viaja hasta la Montaña Roca Negra y usa el detector de fantasmas extradimensionales para encontrar a Bodley cerca de la Cumbre de Roca Negra.‡Rendez-vous au mont Rochenoire, près du pic Rochenoire, et utilisez le Révélateur de fantômes extradimensionnel pour trouver Bodley.‡到黑石山去，使用超维度幽灵显形器找到伯德雷。‡到黑石山並使用超空間鬼魂顯像機，去黑石塔附近尋找布德利。',
  }
},
[8961] = {
  {
    'Três reis das chamas‡Три властелина огня‡Die drei Könige der Flammen‡세 고위 정령의 불꽃‡Tres reyes de Fuego‡Tres reyes de Fuego‡Les trois rois des flammes‡烈焰之王‡烈焰三巨頭',
    nil,
    'Colete a Incendicita de Incendius, a Brasa do Mirabrasa e a Cinza das Cinzas, além de um Braseiro Santificado, e fale novamente com Bodley na Montanha Rocha Negra.‡Добыть огневит Опалителя, уголь Углевзора и уголь Огарцога и принести их Бодли в Черную гору вместе с жаровней Благословения.‡Bringt Bodley im Schwarzfels Incendius\' Pyrophor, Glutsehers Glut, die Asche des Fürsten und ein geheiligtes Räuchergefäß.‡인센디우스의 발연석, 불꽃 군주의 불꽃, 엠버시어의 불씨를 얻은 후, 성스러운 화로를 함께 가지고 검은바위 산 안에 있는 보들리에게 가져가야 합니다.‡Recolecta la incendicita de Incendius, el ascua del Brasadivino y el rescoldo de las brasas junto con el blandón sagrado y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Recolecta la incendicita de Incendius, el ascua del Brasadivino y el rescoldo de las brasas junto con el blandón sagrado y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Récupérez l\'Incendicite d\'Incendius, la Braise du prophète ardent sur le pyrogarde Prophète ardent et les Cendres de Cendres, ainsi qu\'un Brasero béni, puis retournez voir Bodley au mont Rochenoire.‡收集伊森迪奥斯的余炭、艾博希尔灰烬和灰烬公爵的残渣，并从银色黎明军需官那儿购买一只空火盆，然后将这些东西交给黑石山的伯德雷。‡收集伊森迪奧斯的煤渣，艾博希爾的煤炭和辛德爾的煤渣，並帶著神聖火盆回到黑石山找布德利。',
  }
},
[8962] = {
  {
    '‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡',
    nil,
    '‡Найдите останки друидов и принести их Бодли в Черную гору.‡Bringt Bodley im Schwarzfels einige Druidenüberreste.‡‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous des Restes druidiques et rapportez-les à Bodley, à l\'intérieur du mont Rochenoire.‡收集德鲁伊的遗骸，把它们交给黑石山的伯德雷。‡',
  }
},
[8963] = {
  {
    '‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡',
    nil,
    '‡Найдите реликвию Деревни Звездного Ветра и принести ее Бодли в Черную гору.‡Bringt Bodley in der Schwarzfelsspitze ein Relikt von Sternenhauch.‡‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Relique de Brise-Stellaire et rapportez-la à Bodley, à l\'intérieur du Mont Rochenoire.‡取得星风村圣物，再回到黑石山找布德利。‡',
  }
},
[8964] = {
  {
    '‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡重要的材料',
    nil,
    '‡Добыть сверкающий меч Фанатизма и принести его Бодли в Черную гору.‡Bringt Bodley im Schwarzfels ein gleißendes Schwert des Zeloten.‡‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Épée brillante de fanatisme, puis rapportez-la à Bodley, à l\'intérieur du mont Rochenoire.‡取得光亮的狂热之剑，再回到黑石山找布德利。‡取得光亮的狂熱之劍，再回到黑石山找布德利。',
  }
},
[8965] = {
  {
    '‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡',
    nil,
    '‡Добыть пепел душ Изгнанников и принести его Бодли в Черную гору.‡Bringt Bodley im Schwarzfels etwas Seelenasche der Verbannten.‡‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Prélevez des Cendres d\'âme de banni, puis retournez voir Bodley à l\'intérieur du mont Rochenoire.‡拿到放逐者的灵魂灰烬，把它交给黑石山的伯德雷。‡',
  }
},
[8966] = {
  {
    '‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦萨拉克护符的左半块‡',
    nil,
    '‡Вызвать дух Мора Серого Копыта с помощью жаровни Призыва, прикончить его и забрать недостающую часть амулета Лорда Вальтхалака. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Mor Grauhuf zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Mor Pezuña Gris y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Mor Pezuña Gris y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit de Mor Sabot-gris, puis tuez-le. Ensuite, retournez voir Bodley à l\'intérieur du mont Rochenoire avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆来召唤莫尔·灰蹄的灵魂并杀了他。带着瓦萨拉克护符的左半块和召唤火盆回到黑石山的布德利那里。‡',
  }
},
[8967] = {
  {
    '‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦萨拉克护符的左半块‡',
    nil,
    '‡С помощью жаровни Призыва вызвать дух Изалиен и убить ее. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Лорда Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Isalien zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit d\'Isalien, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出伊萨利恩的灵魂，然后杀掉她。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给伯德雷。‡',
  }
},
[8968] = {
  {
    'A parte esquerda do amuleto do Lorde Valthalak‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 왼쪽 조각‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的左瓣‡瓦薩拉克領主護符的左半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar os espíritos de Jil e Soeiro e então mate os dois. Fale novamente com Bodley na Montanha Rocha Negra, com a Parte Esquerda do Amuleto do Lorde Valthalak e o Braseiro de Sinalização.‡Вызвать духов Джариен и Сотоса с помощью жаровни Призыва и убить их обоих. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Лорда Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um die Geister von Jarien und Sothos zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡부름의 화로를 사용하여 자리엔과 소도스의 영혼을 소환한 후 처치하십시오. 군주 발타라크의 아뮬렛 왼쪽 조각과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer Jarien et Sothos et les tuer. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出亚雷恩和索托斯的灵魂，然后杀掉他们。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给黑石山的伯德雷。‡使用召喚火盆來召喚賈林和索索斯並殺了他們。帶著瓦薩拉克領主護符的左半塊和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8969] = {
  {
    'A parte esquerda do amuleto do Lorde Valthalak‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的左瓣‡瓦薩拉克領主護符的左半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Kormok e então mate-o. Fale novamente com Bodley, na Montanha Rocha Negra, com a Parte Esquerda do Amuleto do Lorde Valthalak e o Braseiro de Sinalização.‡С помощью жаровни Призыва вызвать дух Кормока и убить его. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Лорда Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Kormok zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit de Kormok, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出库尔莫克的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给黑石山的伯德雷。‡使用召喚火盆召喚科爾莫克的靈魂並殺了他。帶著瓦薩拉克領主護符的左半塊和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8970] = {
  {
    '‡Я вижу в твоем будущем остров Алькац...‡Ich sehe die Insel Alcaz in Eurer Zukunft‡‡En tu destino veo la Isla de Alcaz...‡En tu destino veo la Isla de Alcaz...‡Votre avenir passe par l\'île d\'Alcaz‡奥卡兹岛在你前方……‡',
    nil,
    '‡Собрать 20 порций кровавой ламинарии у наг из клана Страшаз и принести их Бодли в Черную гору.‡Bringt Bodley im Schwarzfels 20 Einheiten Bluttang von den Naga der Strashaz.‡‡Reúne 20 algas de sangre de los nagas de Strashaz y regresa junto a Bodley en el interior de la Montaña Roca Negra.‡Reúne 20 algas de sangre de los nagas de Strashaz y regresa junto a Bodley en el interior de la Montaña Roca Negra.‡Récupérez 20 Varechs de sang sur les nagas Strashaz, puis retournez voir Bodley au mont Rochenoire.‡前往尘泥沼泽的奥卡兹岛，从斯塔莎兹纳迦身上收集20份血藻，然后返回黑石山的伯德雷那儿。‡',
  }
},
[8971] = {
  {
    'REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[8972] = {
  {
    'REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE‡REUSE',
    nil,
