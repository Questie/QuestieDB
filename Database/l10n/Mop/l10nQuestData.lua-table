    nil,
  }
},
[29072] = {
  {
    '‡Последний курорт, в буквальном смысле‡Vollpensionierung‡‡Un asunto complejo, literalmente‡‡La dernière station… au sens propre‡‡',
    nil,
    '‡Убейте Ахти.‡Tötet Ahti.‡‡Mata a Ahti.‡‡Tuez Ahti.‡‡',
