},
[14084] = {
  {
    'Aprenda a cavalgar em Dun Morogh‡Уроки верховой езды в Дун Мороге‡Reiten lernen in Dun Morogh‡던 모로에서 타는 법 배우기‡Aprende a montar en Dun Morogh‡Aprende a montar en Dun Morogh‡Un cavalier débutant en Dun Morogh‡驰骋在丹莫罗‡在丹莫洛學習騎術',
    nil,
    'Entregue o panfleto a Binjy Penapita na Garagem do Gradaço, que fica em Dun Morogh.‡Верните это рекламное сообщение Бинджи Перосвисту в поселок Сталежара в Дун Мороге.‡Bringt diesen Handzettel zu Binjy Federpfiff bei Stahlrosts Depot in Dun Morogh.‡던 모로의 스틸그릴의 정비소에 있는 빈지 페더휘슬에게 이 전단지를 가져가야 합니다.‡Devuelve este panfleto a Binjy Plumasilba, que se encuentra en el Almacén de Brasacerada en Dun Morogh.‡Devuelve este panfleto a Binjy Plumasilba, que se encuentra en el Almacén de Brasacerada en Dun Morogh.‡Rapportez ce fascicule à Binjy Siffleplume au Dépôt de Grillacier en Dun Morogh.‡将这本小册子交给丹莫罗钢架补给站的宾吉·羽哨。‡到丹莫洛的鋼架補給站，把這本小手冊繳回給賓吉·羽哨。',
  }
},
[14085] = {
  {
    'Aprenda a cavalgar em Darnassus‡Уроки верховой езды в Дарнасе‡Reiten lernen in Darnassus‡다르나서스에서 타는 법 배우기‡Aprende a montar en Darnassus‡Aprende a montar en Darnassus‡Un cavalier débutant à Darnassus‡驰骋在达纳苏斯‡在達納蘇斯學習騎術',
    nil,
    'Entregue o panfleto a Jartsam no Enclave Cenariano, que fica em Darnassus.‡Верните это рекламное сообщение Джартсаму в анклав Кенария в Дарнасе.‡Bringt diesen Handzettel zu Jartsam bei der Enklave des Cenarius in Darnassus.‡다르나서스의 세나리온 자치령에 있는 잘트삼에게 이 전단지를 가져가야 합니다.‡Devuelve este panfleto a Jartsam, que se encuentra en el Enclave Cenarion en Darnassus.‡Devuelve este panfleto a Jartsam, que se encuentra en el Enclave Cenarion en Darnassus.‡Rapportez ce fascicule à Jartsam, dans l\'Enclave cénarienne de Darnassus.‡将这本小册子交给达纳苏斯塞纳里奥区的贾萨姆。‡到達納蘇斯的塞納里奧區，把這本小手冊繳回給賈薩姆。',
  }
},
[14086] = {
  {
    'Aprenda a cavalgar em Orgrimmar‡Уроки верховой езды в Оргриммаре‡Reiten lernen in Orgrimmar‡오그리마에서 타는 법 배우기‡Aprende a montar en Orgrimmar‡Aprende a montar en Orgrimmar‡Un cavalier débutant à Orgrimmar‡驰骋在奥格瑞玛‡在奧格瑪學習騎術',
    nil,
    'Entregue o panfleto a Kildar no Vale da Honra, que fica em Orgrimmar.‡Верните это рекламное сообщение Кильдару на Аллею Чести в Оргриммаре.‡Bringt diesen Handzettel zu Kildar im Tal der Ehre in Orgrimmar.‡오그리마의 명예의 골짜기에 있는 킬다르에게 이 전단지를 가져가야 합니다.‡Devuelve este panfleto a Kildar, que se encuentra en el Valle del Honor de Orgrimmar.‡Devuelve este panfleto a Kildar, que se encuentra en el Valle del Honor de Orgrimmar.‡Rapportez ce fascicule à Kildar, dans la Vallée de l\'Honneur d\'Orgrimmar.‡将这本小册子交给奥格瑞玛荣耀谷的基尔达。‡到奧格瑪的榮譽谷，把這本小手冊繳回給基爾達。',
  }
},
[14087] = {
  {
    'Aprenda a cavalgar em Mulgore‡Уроки верховой езды в Мулгоре‡Reiten lernen in Mulgore‡멀고어에서 타는 법 배우기‡Aprende a montar en Mulgore‡Aprende a montar en Mulgore‡Un cavalier débutant à Mulgore‡驰骋在莫高雷‡在莫高雷學習騎術',
    nil,
    'Entregue este panfleto a Kar Tormenta Cantante na Aldeia Casco Sangrento, que fica em Mulgore.‡Верните это рекламное сообщение Кару Певцу Бури в деревню Кровавого Копыта в Мулгоре.‡Bringt diesen Handzettel zu Kar Sturmsang beim Dorf der Bluthufe in Mulgore.‡멀고어의 블러드후프 마을에 있는 카르 스톰싱어에게 이 전단지를 가져가야 합니다.‡Devuelve este panfleto a Kar Tormensón, que se encuentra en el Poblado Pezuña de Sangre en Mulgore.‡Devuelve este panfleto a Kar Tormensón, que se encuentra en el Poblado Pezuña de Sangre en Mulgore.‡Rapportez ce fascicule à Kar Chante-l’Orage, à Sabot-de-Sang en Mulgore.‡将这本小册子交给莫高雷血蹄村的卡尔·雷歌。‡到莫高雷的血蹄村，把這本小手冊繳回給卡爾·雷詠。',
  }
},
[14088] = {
  {
    'Aprenda a cavalgar em Durotar‡Уроки верховой езды в Дуротаре‡Reiten lernen in Durotar‡듀로타에서 타는 법 배우기‡Aprende a montar en Durotar‡Aprende a montar en Durotar‡Un cavalier débutant en Durotar‡驰骋在杜隆塔尔‡在杜洛塔學習騎術',
    nil,
    'Entregue o panfleto a Xar\'Ti na Aldeia Sen\'jin, que fica na parte sul de Durotar.‡Верните это рекламное сообщение Ксар\'Ти в деревню Сен\'джин в Дуротаре.‡Bringt diesen Handzettel zu Xar\'Ti in Sen\'jin im südlichen Durotar.‡듀로타 남쪽의 센진 마을에 있는 살티에게 이 전단지를 가져가야 합니다.‡Devuelve este panfleto a Xar\'Ti, que se encuentra en el Poblado Sen\'jin en la parte sur de Durotar.‡Devuelve este panfleto a Xar\'Ti, que se encuentra en el Poblado Sen\'jin en la parte sur de Durotar.‡Rapportez ce fascicule à Xar\'Ti, à Sen\'jin en Durotar.‡将这本小册子交还给杜隆塔尔南面森金村的克萨尔迪。‡到杜洛塔南邊的森金村，把這本小手冊繳回給札爾提。',
  }
},
[14089] = {
  {
    'Aprenda a cavalgar nas Clareiras de Tirisfal‡Уроки верховой езды в Тирисфальских лесах‡Reiten lernen in Tirisfal‡티리스팔 숲에서 타는 법 배우기‡Aprende a montar en los Claros de Tirisfal‡Aprende a montar en los Claros de Tirisfal‡Un cavalier débutant dans les clairières de Tirisfal‡驰骋在提瑞斯法林地‡在提里斯法林地學習騎術',
    nil,
    'Entregue o panfleto a Vilma Warnam em Montalvo, que fica nas Clareiras de Tirisfal.‡Верните это рекламное сообщение Вельме Варнам в Брилл в Тирисфальских лесах.‡Bringt diesen Handzettel zu Velma Warnam in Brill in Tirisfal.‡티리스팔 숲의 브릴에 있는 벨마 워넘에게 이 전단지를 가져가야 합니다.‡Devuelve este panfleto a Velma Warnam, que se encuentra en Rémol en los Claros de Tirisfal.‡Devuelve este panfleto a Velma Warnam, que se encuentra en Rémol en los Claros de Tirisfal.‡Rapportez ce fascicule à Velma Warnam à Brill dans les Clairières de Tirisfal.‡将这本小册子交给提瑞斯法林地布瑞尔的维尔玛。‡到提里斯法林地的布瑞爾，把這本小手冊繳回給維爾瑪·瓦納姆。',
  }
},
[14090] = {
  {
    'Gormok quer o nevold e pronto!‡Гормоку нужны снобольды‡Gormok will seine Schneebolde‡스노볼트를 찾는 고르목‡Gormok quiere sus snóbolds‡Gormok quiere sus snóbolds‡Gormok veut ses frigbolds !‡戈莫克想要他的雪地狗头人‡戈莫克要他的極地狗頭人',
    nil,
    'Use a Rede com Pandulho para capturar 8 Seguidores Ceganeve e leve-os a Savinia Povocanto nos Campos do Torneio Argênteo.‡Воспользуйтесь утяжеленной сетью, чтобы поймать 8 последователей с Холмов Снежной Слепоты, и приведите их Савинии Певице Преданий в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Fangt mithilfe des beschwerten Netzes 8 schneeblinde Anhänger und bringt sie zu Savinia Lehrensang auf dem Argentumturnierplatz.‡무거운 그물로 설맹의 추종자 8마리를 붙잡아 은빛십자군 마상시합 광장에 있는 사비나 로어송에게 가져가야 합니다.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Savinia Romanza, en los Campos del Torneo Argenta.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Savinia Romanza, en los Campos del Torneo Argenta.‡Servez-vous du Filet lesté pour capturer 8 Suivants Brûleglace, et remettez-les à Savinia Chanterite, dans l’Enceinte du tournoi d’Argent.‡使用强化渔网抓住8个雪盲追随者，并把它们交给银色比武场的萨雯妮娅·慧歌。‡使用加重的網子捕捉8隻雪盲跟隨者，並帶給銀白聯賽場地的莎薇娜‧識歌。',
  }
},
[14091] = {
  {
    'Algo errado‡Дурной знак‡Da stimmt was nicht‡잘못된 일‡Aquí pasa algo‡Aquí pasa algo‡Quelque chose ne va pas‡事有蹊跷‡有差錯',
    nil,
    'Fale novamente com o Príncipe Liam Greymane na Praça dos Mercadores.‡Вернитесь к принцу Лиаму Седогриву на Торговую площадь.‡Kehrt zu Prinz Liam Graumähne auf dem Händlerplatz zurück.‡상업 지구에 있는 왕자 리암 그레이메인에게 가야 합니다.‡Vuelve con Liam Cringris en la Plaza de los Mercaderes.‡Vuelve con Liam Cringris en la Plaza de los Mercaderes.‡Retournez voir le Prince Liam Grisetête sur la Place des Marchands.‡返回商人广场，向利亚姆·格雷迈恩王子复命。‡回去商業廣場找黎姆·葛雷邁恩王子。',
  }
},
[14092] = {
  {
    'Desjejum dos campeões‡Завтрак для чемпионов‡Frühstück der Champions‡용사의 아침 식사‡Desayuno de campeones‡Desayuno de campeones‡Le petit-déjeuner des champions‡勇士的早餐‡勇士的早餐',
    nil,
    'Obtenha 4 Bolsas de Ovos de Yormungar e leve-as a Tylos Aurovelos nos Campos do Torneio Argênteo.‡Принесите 4 яйца йормунгаров Тайлосу Вестнику Зари в шатер Орды на Ристалище Серебряного турнира.‡Beschafft Euch 4 Eiersäcke eines Jormungars und bringt sie zu Tylos Dämmerflucht auf dem Argentumturnierplatz.‡요르문가르 알 주머니 4개를 은빛십자군 마상시합 광장에 있는 틸로스 돈러너에게 가져가야 합니다.‡Consigue 4 sacos de huevos de jormungar y llévaselos a Tylos Correalba en los Campos del Torneo Argenta.‡Consigue 4 sacos de huevos de jormungar y llévaselos a Tylos Correalba en los Campos del Torneo Argenta.‡Procurez-vous 4 Cocons d’œufs de jormungar et remettez-les à Tylos Coursaurore dans l’Enceinte du tournoi d’argent.‡取得4只冰虫的卵鞘，将它们交给银色比武场的泰罗斯·晨行者。‡取得4份蟄猛巨蟲卵囊並帶給銀白聯賽場地的提洛斯·曦奔。',
  }
},
[14093] = {
  {
    'O inferno se abriu sobre nós‡И разверзся ад‡Die Hölle bricht los‡엄청난 혼란‡La hora del caos‡La hora del caos‡Une pagaille monstrueuse‡天下大乱‡亂成一團',
    nil,
    'O Príncipe Liam Greymane quer que você mate 6 Worgens Descontrolados.‡Принц Лиам Седогрив приказал вам убить 6 озлобленных воргенов.‡Prinz Liam Graumähne wünscht, dass Ihr 6 tobende Worgen tötet.‡왕자 리암 그레이메인이 광란의 늑대인간 6마리를 처치해 달라고 했습니다.‡El Príncipe Liam Cringris quiere que mates a 6 huargen arrasadores.‡El Príncipe Liam Cringris quiere que mates a 6 huargen arrasadores.‡Le Prince Liam Grisetête vous demande de tuer 6 Worgens déchaînés.‡利亚姆·格雷迈恩王子要你杀死6名暴怒的狼人。‡黎姆‧葛雷邁恩王子希望你殺死6隻暴怒的狼人。',
  }
},
[14094] = {
  {
    'Resgatar os suprimentos‡Спасение припасов‡Bergt die Vorräte‡보급품 회수‡Recuperar los suministros‡Recuperar los suministros‡Préserver le ravitaillement‡抢救补给品‡搶救補給',
    nil,
    'Resgate 4 Caixotes de Suprimentos.‡Спасите 4 ящика с припасами.‡Bergt 4 Vorratskisten.‡보급품 상자 4개를 회수해야 합니다.‡Recupera 4 cajones de suministros.‡Recupera 4 cajones de suministros.‡Récupérez 4 Caisses de fournitures.‡回收4只补给箱。‡回收4個補給木箱。',
  }
},
[14095] = {
  {
    'Identificando os restos mortais‡Опознание останков‡Die Überreste identifizieren‡유해 식별‡Identificar los restos‡Identificar los restos‡L\'identification des restes‡鉴定遗留物‡鑑定屍體',
    nil,
    'Leve o Dente de Kraken ao Cruzado Albargenta como prova da sua vitória.‡Отнесите зуб кракена Крестоносцу Серебристый Рассвет в Серебряный павильон.‡Bringt den Krakenzahn zum Beweis Eures Sieges zu Kreuzfahrer Silberdämmerung.‡승리의 증거로 북해 크라켄 이빨을 성전사 실버돈에게 가져가야 합니다.‡Llévale el diente de kraken al cruzado Albaplata como prueba de tu victoria.‡Llévale el diente de kraken al cruzado Albaplata como prueba de tu victoria.‡Apportez la Dent de kraken au Croisé Aubargent comme preuve de votre victoire.‡带上海怪的牙齿作为你胜利的证明，去见北伐军战士希瓦多恩。‡把海怪牙交給十字軍銀曦來作為勝利的證明。',
  }
},
[14096] = {
  {
    'Kal, você já passou dos limites!‡На этот раз ты нарвался, Кул‡Diesmal habt Ihr Euch wirklich selbst übertroffen, Kul‡제대로 한 건 했군, 쿨‡Esta vez la has liado, Kul‡Esta vez la has liado, Kul‡Oh bravo, Kul !!!‡这次你真的做到了，库尔‡庫爾，看看你這次幹得好事',
    nil,
    'Resgate Kal, o Negligente, e 4 Aspirantes Cativos na Vigília do Morta-voz. Depois fale novamente com Nasari Albaneve nos Campos do Torneio Argênteo.‡Спасите Кула Безрассудного и 4 пленных претендентов с Заставы Вестника Смерти и вернитесь к Нараси Снежной Заре в шатер Альянса на Ристалище Серебряного турнира.‡Rettet Kul den Tollkühnen und 4 gefangene Streiter aus Todessprechers Wacht und kehrt dann zu Narasi Schneedämmerung auf dem Argentumturnierplatz zurück.‡못 말리는 쿨과 4명의 사로잡힌 지원자들을 죽음예언자 감시초소에서 구하고 은빛십자군 마상시합 광장에 있는 나라시 스노우돈에게 가야 합니다.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Narasi Albanieve en los Campos del Torneo Argenta.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Narasi Albanieve en los Campos del Torneo Argenta.‡Sauvez Kul le Téméraire et 4 Aspirants captifs du Guet du nécrorateur. Lorsque ce sera fait, retournez voir Narasi Aubeneige, dans l\'Enceinte du tournoi d\'Argent.‡在亡语者岗哨援救鲁莽的库尔和4名被俘虏的候选者，然后返回银色比武场，去见纳莱丝·晨雪。‡從亡頌者之望救出『魯莽』庫爾和4位被俘虜的志士，然後回去找銀白聯賽場地的娜拉希‧雪曦。',
  }
},
[14097] = {
  {
    '‡Уберите этого торговца!‡Schafft diesen Händler hier raus!‡‡¡Llévate a ese mercader de aquí!‡‡Faites-moi partir ce marchand !‡‡',
    nil,
    nil,
  }
},
[14098] = {
  {
    'Evacue a Praça dos Mercadores‡Эвакуация Торговой площади‡Evakuiert den Händlerplatz‡상업 지구에서의 철수‡Evacúa la Plaza de los Mercaderes‡Evacúa la Plaza de los Mercaderes‡L\'évacuation de la place des Marchands‡疏散商人广场‡疏散商業廣場',
    nil,
    'Evacue 3 Casas de Civis.‡Помогите эвакуировать людей из 3 домов.‡Evakuiert 3 Zivilistenhäuser.‡시민 3명을 대피시켜야 합니다.‡Evacúa 3 casas civiles.‡Evacúa 3 casas civiles.‡Évacuez 3 Maisons de civils.‡疏散3户平民。‡疏散3戶民房。',
  }
},
[14099] = {
  {
    'Ordens reais‡Королевский приказ‡Königlicher Befehl‡왕자의 명령‡Órdenes reales‡Órdenes reales‡Des ordres royaux‡皇家命令‡皇家命令',
    nil,
    'Fale com Gwen Armstead no Distrito Militar a sudeste.‡Поговорите с Гвен Армстед в северо-восточной части Военного квартала.‡Sprecht mit Gwen Armstead im Militärviertel im Südosten.‡남동쪽 군사 지구에 있는 그웬 암스테드와 대화해야 합니다.‡Habla con Gwen Armstead en el Distrito Militar, al sureste.‡Habla con Gwen Armstead en el Distrito Militar, al sureste.‡Parlez à Gwen Armstead dans le Secteur Militaire, au sud-est.‡前往东南方的军事区，跟格温·阿姆斯特谈一谈。‡到東南方的軍事區和葛玟•阿姆史特談話。',
  }
},
[14100] = {
  {
    'Relic of the Earthen Ring‡Реликвия Служителей Земли‡Relikt des Irdenen Rings‡대지 고리회 유물‡Reliquia del Anillo de la Tierra‡Reliquia del Anillo de la Tierra‡La relique du Cercle terrestre‡大地之环的遗迹‡',
    nil,
    'Bring your four totems to Gotura Fourwinds in Orgrimmar.‡Принесите четыре тотема Готуру Четыре Ветра в Оргриммар.‡Bringt Eure vier Totems nach Orgrimmar zu Gotura Vierwind.‡오그리마에 있는 고투라 포윈즈에게 4개의 토템을 가져가야 합니다.‡Llévale tus cuatro tótems a Gotura Cuatro Vientos a Orgrimmar.‡Llévale tus cuatro tótems a Gotura Cuatro Vientos a Orgrimmar.‡Apportez vos quatre totems à Gotura Quatre-vents à Orgrimmar.‡将你的四大元素图腾交给奥格瑞玛的戈图拉·林风。‡',
  }
},
[14101] = {
  {
    'Drottinn Hrothgar‡Дроттинн Хротгар‡Drottinn Hrothgar‡드로틴 흐로스가르‡Drottinn Hrothgar‡Drottinn Hrothgar‡Le drottinn Hrothgar‡德罗丁洛斯加尔‡多廷‧赫魯斯加',
    nil,
    'O Grão-cruzado Adelard, nos Campos do Torneio Argênteo, quer que você derrote Drottinn Hrothgar.‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Дроттинна Хротгара.‡Hochmeister Adelard auf dem Argentumturniergelände möchte, dass Ihr Drottinn Hrothgar besiegt.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 드로틴 흐로스가르를 물리쳐 달라고 했습니다.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que derrotes a Drottinn Hrothgar.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que derrotes a Drottinn Hrothgar.‡Le Haut croisé Adélard, dans l’Enceinte du tournoi d’Argent, veut que vous vainquiez le Drottinn Hrothgar.‡银色比武场的高阶十字军艾德拉德希望你去击败德罗丁洛斯加尔。‡銀白聯賽場地的高階十字軍艾德拉要你去擊敗多廷‧赫魯斯加。',
  }
},
[14102] = {
  {
    'Chamabruma Yngvar‡Призыватель туманов Йингвар‡Nebelrufer Yngvar‡안개부름이 잉그바르‡El clamaneblina Yngvar‡El clamaneblina Yngvar‡Le mandebrume Yngvar‡唤雾者伊戈瓦尔‡喚霧者伊格瓦',
    nil,
    'O Grão-cruzado Adelard, nos Campos do Torneio Argênteo, quer que você mate Chamabruma Yngvar.‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Призывателя туманов Йингвара.‡Hochmeister Adelard auf dem Argentumturnierplatz möchte, dass Ihr Nebelrufer Yngvar tötet.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 안개부름이 잉그바르를 처치해 달라고 했습니다.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates al clamaneblina Yngvar.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates al clamaneblina Yngvar.‡Le Haut croisé Adélard, dans l’Enceinte du tournoi d’Argent, veut que vous tuiez le Mandebrume Yngvar.‡银色比武场的高阶十字军艾德拉德希望你能消灭唤雾者伊戈瓦尔。‡銀白聯賽場地的高階十字軍艾德拉要你去殺掉喚霧者伊格瓦。',
  }
},
[14103] = {
  {
    'Pó de Titânico‡Титановый порошок‡Titanstaub‡티타늄 가루‡Partículas de titanio‡Partículas de titanio‡La poudre de titane‡泰坦神铁粉末‡泰坦鋼粉末',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[14104] = {
  {
    'Ornolf, o Escarioso‡Орнолф Меченый‡Ornolf der Vernarbte‡칼부림 오르놀프‡Ornolf el Cicatrices‡Ornolf el Cicatrices‡Ornolf le Balafré‡疤面者奥诺夫‡『刀疤』歐諾夫',
    nil,
    'O Grão-cruzado Adelard, nos Campos do Torneio Argênteo, quer que você mate Ornolf, o Escarioso.‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Орнолфа Меченого.‡Hochmeister Adelard auf dem Argentumturnierplatz möchte, dass Ihr Ornolf den Vernarbten tötet.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 칼부림 오르놀프를 처치해 달라고 했습니다.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates a Ornolf el Cicatrices.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates a Ornolf el Cicatrices.‡Le Haut croisé Adélard, dans l’Enceinte du tournoi d’Argent, veut que vous tuiez Ornolf le Balafré.‡银色比武场的高阶十字军艾德拉德希望你能消灭疤面者奥诺夫。‡銀白聯賽場地的高階十字軍艾德拉要你去殺掉『刀疤』歐諾夫。',
  }
},
[14105] = {
  {
    'Morta-voz Kharos‡Вестник смерти Карос‡Todessprecher Kharos‡죽음예언자 카로스‡Portavoz de la muerte Kharos‡Portavoz de la muerte Kharos‡Le nécrorateur Kharos‡亡语者卡罗斯‡亡頌者凱洛斯',
    nil,
    'O Grão-cruzado Adelard, nos Campos do Torneio Argênteo, quer que você mate o Morta-voz Kharos.‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть вестника смерти Кароса.‡Hochmeister Adelard auf dem Argentumturnierplatz möchte, dass Ihr Todessprecher Kharos tötet.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 죽음예언자 카로스를 처치해 달라고 했습니다.‡El alto cruzado Adelard, en los Campos del Torneo Argenta, quiere que mates al portavoz de la muerte Kharos.‡El alto cruzado Adelard, en los Campos del Torneo Argenta, quiere que mates al portavoz de la muerte Kharos.‡Le Haut croisé Adélard, dans l’Enceinte du tournoi d’Argent, veut que vous tuiez le Nécrorateur Kharos.‡银色比武场的高阶十字军艾德拉德想让你消灭亡语者卡罗斯。‡銀白聯賽場地的高階十字軍艾德拉要你去殺掉亡頌者凱洛斯。',
  }
},
[14106] = {
  {
    'Na Kada\'s Quest Test‡Na Kada\'s Quest Test‡Na Kada\'s Questtest‡퀘스트 시험용‡Na Kada\'s Quest Test‡Na Kada\'s Quest Test‡Quête de test de Na Kada‡纳·卡达的任务测试‡納卡達的任務測試',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[14107] = {
  {
    'O destino dos caídos‡Судьба Павших‡Das Schicksal der Gefallenen‡죽은 자의 운명‡El destino de los caídos‡El destino de los caídos‡Le destin des défunts‡阵亡者的命运‡逝往者的命運',
    nil,
    'O Cruzado Albargenta quer que você leve paz a 6 Espíritos de Heróis Caídos.‡Крестоносец Серебристый Рассвет из Серебряного павильона просит вас даровать покой 6 духам павших героев.‡Kreuzfahrer Silberdämmerung möchte, dass Ihr dafür sorgt, dass 6 Geister der gefallenen Helden Frieden finden.‡성전사 실버돈이 전사한 영웅의 영혼 6명에게 안식을 되찾아 달라고 했습니다.‡El cruzado Albaplata quiere que proporciones paz a 6 espíritus de héroe caído.‡El cruzado Albaplata quiere que proporciones paz a 6 espíritus de héroe caído.‡Le Croisé Aubargent veut que vous apportiez la paix à 6 Esprits de héros défunts.‡北伐军战士希瓦多恩希望你让6位死去英雄的灵魂得到安息。‡十字軍銀曦要你讓6位陣亡英雄之靈獲得安息。',
  }
},
[14108] = {
  {
    'Pegue o Kraken!‡Изгнать Кракена!‡Kraken am Haken‡크라켄을 잡아라!‡¡Toma kraken!‡¡Toma kraken!‡Sus au kraken !‡猎捕海怪！‡逮住海怪!',
    nil,
    'O Cruzado Albargenta quer que você monte em um Hipogrifo Argênteo, arremesse 6 Lanças Flamejantes no Kraken do Mar do Norte e mate 3 Evocantes Vraikalen.|n|nO Hipogrifo Argênteo está do lado de fora da tenda da Cruzada Argêntea nos Campos do Torneio.‡Крестоносец Серебристый Рассвет просит вас оседлать серебряного гиппогрифа, бросить 8 пылающих копий в кракена Северного моря и поразить 6 квалдиров-пробудителей глубин.|n|nСеребряного гиппогрифа можно найти возле палатки Серебряного Авангарда на Ристалище Серебряного Турнира.‡Kreuzfahrer Silberdämmerung möchte, dass Ihr auf einen Argentumhippogryph steigt, 8 flammende Speere auf den Nordmeerkraken werft und 6 Tiefenrufer der Kvaldir ausschaltet.|n|nIhr findet die Argentumhippogryphen gleich außerhalb des Zelts auf dem Argentumturnierplatz.‡성전사 실버돈이 은빛십자군 히포그리프를 타고 날아가 북해 크라켄에게 불타는 창을 8번 던지고, 브리쿨 심연의 소환사 6명을 처치해 달라고 했습니다.|n|n은빛십자군 히포그리프는 마상시합 광장의 은빛십자군 천막 바로 바깥에 있습니다.‡El cruzado Albaplata quiere que montes un hipogrifo Argenta, lances 8 lanzas llameantes al Kraken de El Mar del Norte y que acabes con 6 clamahondos vrykul.|n|nPuedes encontrar los hipogrifos Argenta justo en el exterior de la tienda de La Cruzada Argenta en los Campos del Torneo.‡El cruzado Albaplata quiere que montes un hipogrifo Argenta, lances 8 lanzas llameantes al Kraken de El Mar del Norte y que acabes con 6 clamahondos vrykul.|n|nPuedes encontrar los hipogrifos Argenta justo en el exterior de la tienda de La Cruzada Argenta en los Campos del Torneo.‡Le Croisé Aubargent veut que vous chevauchiez un Hippogriffe d’Argent, que vous lanciez 8 Lances enflammées sur le Kraken de la mer Boréale, et que vous abattiez 6 Mande-fonds kvaldirs.|n|nVous trouverez des Hippogriffes d’Argent devant la tente de la Croisade d’argent, dans l’Enceinte du tournoi d’argent.‡北伐军战士希瓦多恩想让你骑乘一头银色角鹰兽，向北海海怪投射8根烈焰长矛，并除掉6个克瓦迪尔深渊呼唤者。|n|n你可以在比武场的银色北伐军大帐外找到那头银色角鹰兽。‡十字軍銀曦要你騎上銀白角鷹獸，對北海海怪投擲8支烈焰之矛並解決6個維酷深海呼喚者。|n|n你可以在聯賽場地的銀白十字軍帳篷外面找到銀白角鷹獸。',
  }
},
[14109] = {
  {
    'O novo você‡Новый наряд‡Ein ganz neues Ihr‡때 빼고 광내기‡Tu nuevo yo‡Tu nuevo yo‡Un nouveau vous‡崭新的你‡全新的你',
    nil,
    'Compre alguns Balangandãs Brilhosos de Mileum Denteprata, uma Roupa Nova Estilosa de Rercovitch, e Óculos Maneiros de Lulu Neta, na Rua dos Pilantras.‡Купите блестящие украшения у Гэппи Серебряного Зуба, новый стильный костюмчик у Забо и модные темные очки у Миссы Фарцовщицы в переулке Дельцов.‡Kauft strahlende Klunker von Gappy Silberzahn, ein hippes neues Outfit von Szabo und eine coole Sonnenbrille von Missa Spekkies in der Gaunergasse.‡덤터기 거리의 개피 실버투스에게서 빛나는 반짝이를, 스자보에게서 끝내주는 새 옷을, 미사 스페키스에게서 근사한 색안경을 구입해야 합니다.‡Cómprale una cadena de oro lustrosa a Gappy Dienteplata, un atuendo pistonudo a Szabo y unas gafas de sol chulas a Missa Mercadillo en la Calle del Timo.‡Cómprale una cadena de oro lustrosa a Gappy Dienteplata, un atuendo a la moda a Szabo y unas gafas de sol con estilo a Missa Mercadillo en la Calle del Timo.‡Achetez un Bling-bling rutilant à Diastème Dent-d\'argent, une Nouvelle tenue branchée auprès de Szabo et des Lunettes de soleil cool chez Missa Labinocle, dans la Rue de la Fauche.‡从奸商街的“大金牙”盖比那里购买一些亮闪闪的珠宝，从苏扎博那里购买一套潮人装束，从“软糖”米萨那里购买一副清爽遮阳镜。‡在騙你錢商店街向加痞·銀齒買些亮晶晶的玩意兒，向薩波買時髦新裝，向米莎·史派基買拉風墨鏡。',
  }
},
[14110] = {
  {
    'A nova você‡Новый наряд‡Ein ganz neues Ihr‡때 빼고 광내기‡Tu nuevo yo‡Tu nuevo yo‡Une nouvelle vous‡崭新的你‡全新的你',
    nil,
    'Compre alguns Balangandãs Brilhosos de Mileum Denteprata, uma Roupa Nova Estilosa de Rercovitch, e Óculos Maneiros de Lulu Neta, na Rua dos Pilantras.‡Купите блестящие украшения у Гэппи Серебряного Зуба, новый стильный костюмчик у Забо и модные темные очки у Миссы Фарцовщицы в переулке Дельцов.‡Kauft strahlende Klunker von Gappy Silberzahn, ein hippes neues Outfit von Szabo und eine coole Sonnenbrille von Missa Spekkies in der Gaunergasse.‡덤터기 거리의 개피 실버투스에게서 빛나는 반짝이를, 스자보에게서 끝내주는 새 옷을, 미사 스페키스에게서 근사한 색안경을 구입해야 합니다.‡Cómprale una cadena de oro lustrosa a Gappy Dienteplata, un atuendo pistonudo a Szabo y unas gafas de sol chulas a Missa Mercadillo en la Calle del Timo.‡Cómprale una cadena de oro lustrosa a Gappy Dienteplata, un atuendo a la moda a Szabo y unas gafas de sol con estilo a Missa Mercadillo en la Calle del Timo.‡Achetez un Bling-bling rutilant à Diastème Dent-d\'argent, une Nouvelle tenue branchée auprès de Szabo et des Lunettes de soleil cool chez Missa Labinocle, dans la Rue de la Fauche.‡从奸商街的“大金牙”盖比那里购买一些亮闪闪的珠宝，从苏扎博那里购买一套潮人装束，从“软糖”米萨那里购买一副清爽遮阳镜。‡在騙你錢商店街向加痞·銀齒買些亮晶晶的玩意兒，向薩波買時髦新裝，向米莎·史派基買拉風墨鏡。',
  }
},
[14111] = {
  {
    'Relic of the Earthen Ring‡Реликвия Служителей Земли‡Relikt des Irdenen Rings‡대지 고리회 유물‡Reliquia del Anillo de la Tierra‡Reliquia del Anillo de la Tierra‡La relique du Cercle terrestre‡大地之环的遗迹‡陶土議會聖物',
    nil,
    'Bring your four totems to Farseer Eannu in Ironforge.‡Принесите четыре тотема Предсказателю Эанну в Стальгорн.‡Bringt Eure vier Totems nach Eisenschmiede zu Weitseher Eannu.‡아이언포지에 있는 선견자 이누에게 4개의 토템을 가져가야 합니다.‡Llévale tus cuatro tótems al clarividente Eannu a Forjaz.‡Llévale tus cuatro tótems al clarividente Eannu a Forjaz.‡Apportez vos quatre totems au Long-voyant Eannu à Forgefer.‡带着你的四件图腾去见铁炉堡的先知安努。‡帶著你的四種圖騰去找鐵爐堡的先知埃努。',
  }
},
[14112] = {
  {
    'Yeti come o quê?‡Кстати, чем питаются йети?‡Was fressen eigentlich Yetis?‡설인에게는 뭘 먹이세요?‡¿Y qué comen los yetis?‡¿Y qué comen los yetis?‡Ça mange quoi, un yéti, d\'abord ?‡你们到底喂雪人吃什么？‡雪人到底該吃什麼?',
    nil,
    'Savinia Povocanto, nos Campos do Torneio Argênteo, quer que você lhe traga 3 pedaços de Carne de Tubarão do Mar do Norte.‡Савиния Певица Преданий из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести ей 3 куска мяса акулы Северного моря.‡Savinia Lehrensang auf dem Argentumturnierplatz möchte, dass Ihr ihr 3 Stück Fleisch eines Nordmeerhais bringt.‡은빛십자군 마상시합 광장에 있는 사비나 로어송이 북해 상어 고기 3개를 가져다 달라고 했습니다.‡Savinia Romanza en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Savinia Romanza en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Savinia Chanterite, dans l\'Enceinte du tournoi d\'Argent, veut que vous lui apportiez 3 morceaux de Chair de requin de la mer Boréale.‡银色比武场的萨雯妮娅·慧歌想让你带给她3块北海鲨鱼肉。‡銀白聯賽場地的莎薇娜·識歌要你帶3片北海鯊魚肉給她。',
  }
},
[14113] = {
  {
    'A alma da festa‡Банкет‡Der Mittelpunkt der Party‡파티 생활‡El alma de la fiesta‡El alma de la fiesta‡Membre d\'honneur‡聚会生活‡派對人生',
    nil,
    'Vista seu Conjunto Incrível de Festa (Óculos Maneiros, Roupa Nova Estilosa e Balangandãs Brilhosos). Então siga para a festa na Sede da CCJ para entreter 10 Baladeiros de Kezan.‡Наденьте свой потрясный прикид для вечеринки (темные очки, новый стильный костюмчик и блестящие украшения) и отправляйтесь развлекать 10 кутил из Кезана, собравшихся у бассейна в штаб-квартире ТКК.‡Zieht Eure großartige Partyausstattung an (Coole Sonnenbrille, Hippes neues Outfit und Strahlende Klunker). Begebt Euch danach auf die Party am Pool des Hauptgeschäftssitzes der HGK und unterhaltet 10 kezanische Feiernde.‡근사한 연회 복장(근사한 색안경, 끝내주는 새 옷, 빛나는 반짝이)을 입고 케잔 무역 회사 본사에 있는 수영장에 가서 케잔 파티 하객 10명을 즐겁게 해 줘야 합니다.‡Ponte tu modelito de fiesta impresionante (gafas de sol chulas, atuendo pistonudo y cadena de oro lustrosa) y dirígete a la fiesta en la piscina de la Central SCK para entretener a 10 fiesteros de Kezan.‡Ponte tu modelito de fiesta impresionante (gafas de sol chulas, atuendo pistonudo y cadena de oro lustrosa) y dirígete a la fiesta en la piscina de la Central SCK para entretener a 10 fiesteros de Kezan.‡Revêtez votre Tenue de fête sensationnelle (Lunettes de soleil cool, Nouvelle tenue branchée et Bling-bling rutilant), puis dirigez-vous vers la fête à la piscine du Quartier général de la SCK et divertissez 10 Bambocheurs de Kezan.‡穿戴好你的超酷派对套装（亮闪闪的珠宝、潮人装束和清爽遮阳镜），然后前往在卡亚罗贸易公司总部泳池边举行的聚会，款待10位科赞聚会者。‡穿上你超炫的舞會套裝(拉風墨鏡，時髦新裝，和亮晶晶的玩意兒)然後前往卡亞羅貿易公司總部，在泳池邊的派對中招待10位凱贊派對客。',
  }
},
[14114] = {
  {
    '‡‡‡때빼고 광내기 (이벤트 추적)‡Tu nuevo yo‡‡Un nouveau vous (suivi d\'évènement)‡‡',
    nil,
    nil,
  }
},
[14115] = {
  {
    'Piratas penetras‡Пираты-наемники‡Ungeladene Piraten‡파티 훼방꾼 해적‡Aguafiestas piratas‡Aguafiestas piratas‡Les trouble-fête pirates‡捣乱的海盗‡海盜派對破壞者',
    nil,
    'Mate 12 Piratas Penetras para salvar sua carreira.‡Убейте 12 пиратов-наемников, чтобы спасти свою карьеру.‡Tötet 12 ungeladene Piraten, um Eure Karriere zu retten.‡파티 훼방꾼 해적 12명을 처치하고 승진 기회를 지켜내야 합니다.‡Mata a 12 aguafiestas piratas a fin de salvar tu carrera.‡Mata a 12 aguafiestas piratas a fin de salvar tu carrera.‡Tuez 12 Trouble-fête pirates pour sauver votre carrière.‡杀死12名扰乱聚会的海盗，挽救你的事业。‡消滅12個海賊派對破壞者以挽救你的事業。',
  }
},
[14116] = {
  {
    'Mais um penetra‡Незваный гость‡Der ungeladene Gast‡초대받지 않은 손님‡El invitado no deseado‡El invitado no deseado‡Un invité indésirable‡不速之客‡不速之客',
    nil,
    'Fale com o Príncipe Mercador Puzik Gallywix no andar de cima da Sede da CCJ, em Kezan.‡Поговорите с торговым принцем Галливиксом на верхнем этаже штаб-квартиры ТКК на Кезане.‡Sprecht mit Handelsprinz Gallywix oben im Hauptgebäude des Hauptgeschäftssitzes der HGK auf Kezan.‡케잔의 케잔 무역 회사 본사 주 건물 2층에 있는 무역왕 갤리윅스와 대화해야 합니다.‡Habla con el príncipe mercante Gallywix al final de la escalera en el edificio principal de la Central SCK, en Kezan.‡Habla con el príncipe mercante Gallywix al final de la escalera en el edificio principal de la Central SCK, en Kezan.‡Parlez au Prince marchand Gallywix à l\'étage du bâtiment principal du Quartier général de la SCK, sur Kezan.‡跟科赞岛上卡亚罗贸易公司总部主楼上层的贸易大王加里维克斯谈一谈。‡到卡亞羅貿易公司在凱贊的總部主建築樓上和貿易親王加里維克斯談話。',
  }
},
[14117] = {
  {
    'Olhos atentos do Vale Gris‡Глаза Ясеневого леса‡Die Augen von Eschental‡잿빛 골짜기의 눈‡Los ojos de Vallefresno‡Los ojos de Vallefresno‡Les yeux d\'Orneval‡灰谷之眼‡梣谷之眼',
    nil,
    'Mate 8 Batedores de Talrendis.‡Убейте 8 разведчиков с заставы Талрендис.‡Tötet 8 Späher der Talendrisspitze.‡탈렌디스 정찰병 8명을 처치해야 합니다.‡Mata a 8 exploradores de Talrendis.‡Mata a 8 exploradores de Talrendis.‡Tuez 8 Éclaireurs de Talrendis.‡杀掉8个塔伦迪斯斥候。‡殺死8名塔倫迪斯斥候。',
  }
},
[14118] = {
  {
    'Carne para as tropas‡Оленина для солдат‡Wildbret für die Truppen‡사슴 고기 수집‡Venado para las tropas‡Venado para las tropas‡Une livraison de venaison‡军餐鹿肉‡部隊野味',
    nil,
    'Colete 15 Nacos de Carne dos Cervos Cascomusgos Enfraquecidos.‡Соберите 15 больших кусков оленины, убив ослабших мохоногих маралов.‡Sammelt 15 Scheiben Wildbret von geschwächten Mooshufhirschen.‡약해진 이끼발굽순록에게서 사슴 고기 조각 15개를 모아야 합니다.‡Reúne 15 trozos de carne de venado de los venados Pezuñamusgo debilitados.‡Reúne 15 trozos de carne de venado de los venados Pezuñamusgo debilitados.‡Récupérez 15 Tranches de venaison sur des Cerfs sabot-de-mousse affaiblis.‡在衰弱的苔蹄雄鹿身上收集15块鹿肉。‡從虛弱的苔蹄雄鹿身上收集到15份鹿肉塊。',
  }
},
[14120] = {
  {
    'Um quaquilhão de paçoquinhas?!‡Миллиард деревянных?!‡Eine Bazillion Moneten?!‡1억 마카롱이라고?!‡¡¿Un bazillón de macarrones?!‡¡¿Un bazillón de macarrones?!‡Mille milliards de radis ?!‡万亿杏仁币‡一份鉅額的鈔票?!',
    nil,
    'Fale com Espoleta Chaveforte na Sede da CCJ, em Kezan.‡Поговорите с Хамми Кофельнагель в штаб-квартире ТКК на Кезане.‡Sprecht mit Sassy Hartzang im Hauptgeschäftssitz der HGK auf Kezan.‡케잔의 케잔 무역 회사 본사에 있는 새시 하드렌치와 대화해야 합니다.‡Habla con Sassy Malallave en la Central SCK, en Kezan.‡Habla con Sassy Malallave en la Central SCK, en Kezan.‡Parlez à Chipie Serrelavis au Quartier général de la SCK, sur Kezan.‡跟科赞岛上卡亚罗贸易公司总部的莎希·硬钳谈一谈。‡在凱贊的卡亞羅貿易公司總部和賽希‧硬心談話。',
  }
},
[14121] = {
  {
    'Cem anos de perdão‡Грабь награбленное‡Plündert die Plünderer‡강도 약탈하기‡Atracadores‡Atracadores‡Robin des bois moderne‡热力追踪‡橫衝直撞',
    nil,
    'Use seu Carango para passar por cima de 12 Saqueadores Contratados, coletando 12 Mercadorias Roubadas no processo.‡Садитесь в хотрод, задавите 12 наемных грабителей и заберите у каждого украденные им вещи.‡Benutzt den Hot Rod, um 12 angeheuerte Plünderer umzufahren, und sammelt dabei 12 Einheiten gestohlene Beute.‡화끈한 개조차를 몰고 용병 노략꾼 12명을 쓰러뜨린 후, 훔친 전리품 12개를 모아야 합니다.‡Usa tu bólido para atropellar a 12 despojadores contratados y de paso recoge 12 botines robados.‡Usa tu bólido para atropellar a 12 despojadores contratados y de paso recoge 12 botines robados.‡Utilisez votre Voiture de sport pour renverser 12 Pillards embauchés et récolter 12 Butins volés par la même occasion.‡驾驶改装跑车阻止12名受雇的抢掠者，收集12份被偷走的物品。‡使用你的酷炫改裝車輾過12個受雇的強奪者，在過程中順便收集12個失竊的贓物。',
  }
},
[14122] = {
  {
    'O grande assalto ao banco‡Ограбление банка‡Der große Banküberfall‡대은행강도‡El gran atraco al banco‡El gran atraco al banco‡Le casse du jour‡紧急措施‡銀行大盜',
    nil,
    'Arrombe o cofre do Banco Central de Kezan para recuperar seu Rico Dinheirinho.‡Взломайте хранилище Первого банка Кезана и заберите свои личные сбережения.‡Knackt den Tresor der Ersten Bank von Kezan, um an Eure privaten Reichtümer zu gelangen.‡케잔 일등 은행의 금고를 조작하여 개인 재산을 되찾아야 합니다.‡Abre la cámara del Primer Banco de Kezan para recuperar tus riquezas personales.‡Abre la cámara del Primer Banco de Kezan para recuperar tus riquezas personales.‡Faites sauter le coffre de la Banque Centrale de Kezan pour récupérer vos Biens personnels.‡打开科赞第一银行的金库，取出你的私人财产。‡破解凱贊第一銀行的金庫並拿回你的個人財富。',
  }
},
[14123] = {
  {
    'Só no sapatinho‡Антикварные ценности‡Einfach hereinspaziert‡적절한 접근‡Entrar como si nada‡Entrar como si nada‡On entre et on ressort‡别墅漫步‡如入無人之境',
    nil,
    'Obtenha o Falcão Martinez, a Goblin Lisa e a Melhor Bomba do Mundo.‡Раздобудьте "Ястреба Малди", "Гоблину Лизу" и "Платиновую бомбу".‡Beschafft Euch Maltes Falken, die Mona Goblisa und die ultimative Bombe.‡말디의 매, 고블리자, 궁극의 폭탄을 획득해야 합니다.‡Obtén el Halcón de Maldy, La Goblin Lisa y la bomba suprema.‡Obtén el Halcón de Maldy, La Goblin Lisa y la bomba suprema.‡Obtenez l\'Épervier de Maldy, La gobeline Lisa et la Bombe ultime.‡取回玛尔迪的猎鹰、地精丽莎的画像和终极炸弹。‡取得瑪迪的獵隼、哥布林麗莎以及究極炸彈。',
  }
},
[14124] = {
  {
    'Toneladas de tutu‡Каджа\'митовые месторождения‡Schnappt Euch das Kaja\'mit‡카자마이트 약탈‡Libera la kaja\'mita‡Libera la kaja\'mita‡L\'extraction de la kaja\'mite‡搜刮卡亚矿石‡解放卡迦邁',
    nil,
    'Colete 12 Pedaços de Jakamita.‡Соберите 12 кусков каджа\'мита.‡Sammelt 12 Kaja\'mitbrocken.‡카자마이트 덩어리 12개를 수집해야 합니다.‡Recoge 12 trozos de kaja\'mita.‡Recoge 12 trozos de kaja\'mita.‡Collectez 12 Morceaux de kaja\'mite.‡收集12块大块卡亚矿石。‡收集12個卡迦邁礦石塊。',
  }
},
[14125] = {
  {
    'Emergência 171‡Страховочный план‡Versicherungsbetrug‡묻지도 따지지도 않고‡447‡447‡447‡447‡447',
    nil,
    'Sobrecarregue o Gerador Defeituoso, ative o Fogão com Vazamento, deixe um charuto na Cama Inflamável, e use o Gasômato para incendiar a Sede da CCJ!‡Устройте перегрузку барахлящего генератора, включите прохудившуюся печку, уроните сигару на легковоспламеняющуюся кровать и запустите газобота, чтобы поджечь штаб-квартиру ТКК!‡Überlastet den defekten Generator, macht den undichten Ofen an und lasst eine Zigarre auf das leicht entzündliche Bett fallen. Benutzt dann den Gasbot, um den Hauptgeschäftssitz der HGK in Brand zu setzen!‡결함 생성기에 과부하를 일으키고, 구멍 난 난로를 작동시켜야 합니다. 그리고 타기 쉬운 침대에 담뱃불을 떨어뜨린 후 케잔 무역 회사 본사에 있는 가스로봇을 사용해야 합니다.‡¡Sobrecarga el generador defectuoso, activa la estufa con fugas, deja caer un puro en la cama inflamable y usa al gasbot para hacer arder la central SCK!‡¡Sobrecarga el generador defectuoso, activa la estufa con fugas, deja caer un puro en la cama inflamable y usa al gasbot para hacer arder la central SCK!‡Surchargez le Générateur défectueux, activez le Poêle qui fuit, laissez tomber un cigare sur le Lit inflammable et utilisez le Gazbot pour mettre le feu au Quartier général de la SCK !‡销毁隐藏在过载故障的发电机，渗漏的炉子，和易燃的床垫上的机密，然后使用燃气机器人完成整个清理工作！‡讓故障的發電機超載，啟動會漏瓦斯的鍋爐，在易燃的床上丟雪茄，再用瓦斯機器人讓卡亞羅貿易公司總部起火!',
  }
},
[14126] = {
  {
    'As economias de uma vida‡Сбережения‡Lebensersparnisse‡평생 모은 재산‡Ahorros de toda una vida‡Ahorros de toda una vida‡Les économies de toute une vie‡毕生积蓄‡救命',
    nil,
    'Entregue as Economias da sua Vida para o Príncipe Mercador Puzik Gallywix, a bordo do Iate do Príncipe Mercador, em Kezan.‡Отдайте ваши сбережения торговому принцу Галливиксу на борту его яхты на Кезане.‡Übergebt Handelsprinz Gallywix auf Gallywix\' Yacht auf Kezan Eure Lebensersparnisse.‡케잔에서 무역왕의 쾌속선에 탑승한 무역왕 갤리윅스에게 평생 모은 재산을 건네줘야 합니다.‡Entrega los ahorros de toda una vida al príncipe mercante Gallywix a bordo de su yate en Kezan.‡Entrega los ahorros de toda una vida al príncipe mercante Gallywix a bordo de su yate en Kezan.‡Cédez vos Économies d\'une vie au Prince marchand Gallywix sur le Voilier du prince marchand, sur Kezan.‡将你的毕生积蓄交给贸易大王加里维克斯，他就在科赞岛港口的游艇上。‡把你的畢生積蓄交給貿易親王加里維克斯以登上他那艘位於凱贊的貿易親王的遊艇。',
  }
},
[14127] = {
  {
    'O retorno dos Altaneiros?‡Возвращение высокорожденных?‡Die Rückkehr der Hochgeborenen?‡명가의 귀환?‡¿El regreso de los Altonato?‡¿El regreso de los Altonato?‡Le retour des Bien-nés ?‡上层精灵归来？‡精靈貴族的回歸?',
    nil,
    'Entregue as Ordens do Batedor para Ag\'tor Punho de Sangue, no Portão Traseiro de Orgrimmar.‡Доставьте приказы разведчика Аг\'тору Кровопалу к задним вратам Оргриммара.‡Bringt die Befehle des Spähers zu Ag\'tor Blutfaust am Hinteren Tor von Orgrimmar.‡정찰병의 명령서를 오그리마 뒷문에 있는 아그토르 블러드피스트에게 전달해야 합니다.‡Lleva las órdenes de explorador a Ag\'tor Puñosangre en la puerta trasera a Orgrimmar.‡Lleva las órdenes de explorador a Ag\'tor Puñosangre en la puerta trasera a Orgrimmar.‡Apportez les Ordres de l’éclaireur à Ag’tor Poing-de-sang, à la Porte d’Azshara.‡将斥候的命令送往奥格瑞玛后门的阿格图·血拳处。‡將斥候的命令送去奧格瑪後門的阿格圖·血拳。',
  }
},
[14128] = {
  {
    'O retorno dos Altaneiros?‡Возвращение высокорожденных?‡Die Rückkehr der Hochgeborenen?‡명가의 귀환?‡¿El regreso de los Altonato?‡¿El regreso de los Altonato?‡Le retour des Bien-nés ?‡上层精灵归来？‡精靈貴族的回歸?',
    nil,
    'Entregue as Ordens do Batedor para Malínea Devastacéu, na Estação da Foguetovia de Orgrimmar.‡Доставьте приказы разведчика Малинее Опустошительнице Небес на оргриммарскую пересадочную станцию ракетной дороги.‡Bringt die Befehle des Spähers zu Malynea Himmelshäscher am Umschlagplatz der Raketenbahn von Orgrimmar.‡정찰병의 명령서를 오그리마 로켓길 교역소에 있는 말리니아 스카이리버에게 전달해야 합니다.‡Lleva las órdenes de exploradores a Malynea Atracacielo en el Intercambiador de la Cohetepista de Orgrimmar.‡Lleva las órdenes de exploradores a Malynea Atracacielo en el Intercambiador de la Cohetepista de Orgrimmar.‡Apportez les Ordres de l’éclaireur à Malynéa Saccagecieux, à la Station d’Orgrimmar du fusorail.‡把斥候的命令交给奥格瑞玛火箭车换乘站的梅琳妮·碎天者。‡將斥候的命令送去奧格瑪火箭道交會點給瑪萊妮雅·奪天者。',
  }
},
[14129] = {
  {
    'Retalhador desgovernado!‡Сбежавшие крошшеры!‡Schredder außer Rand und Band‡날뛰는 벌목기‡¡Trituradora fuera de control!‡¡Trituradora fuera de control!‡Déchiqueteur emballé !‡逃跑的伐木机！‡失控的伐木機!',
    nil,
    'Ataque um dos Retalhadores Desgovernados perto dos portões traseiros de Orgrimmar. Entre no Retalhador quando ele tiver sido danificado o suficiente.‡Атакуйте один из сбежавших крошшеров возле задних врат Оргриммара и заберитесь внутрь, когда он будет значительно поврежден.‡Greift einen der entlaufenen Schredder in der Nähe der Tore von Orgrimmar an. Dann setzt Euch hinein, nachdem Ihr ihm erheblichen Schaden zugefügt habt.‡오그리마 뒷문에서 날뛰는 벌목기 한 대를 공격하여 상당한 피해를 준 다음 조종석에 올라타야 합니다.‡Ataca una de las trituradoras en huida cerca de la Puerta Trasera de Orgrimmar y salta a su interior una vez que haya sufrido daños significativos.‡Ataca una de las trituradoras en huida cerca de la Puerta Trasera de Orgrimmar y salta a su interior una vez que haya sufrido daños significativos.‡Attaquez l’un des Déchiqueteurs emballés près de la Porte d’Azshara et sautez dedans une fois qu’il aura subi des dégâts importants.‡在奥格瑞玛后门攻击一架逃跑的伐木机，造成一定破坏后乘上去。‡攻擊位於奧格瑪後門的其中一具失控伐木機，並在它受到顯著傷害後跳進去。',
  }
},
[14130] = {
  {
    'Amigos de todas as cores‡Друзья бывают разных цветов‡Freundschaft kennt keine Farbe‡다양한 친구‡Amigos de todos los colores‡Amigos de todos los colores‡Un ami haut en couleur‡各色朋友‡各式各樣的朋友',
    nil,
    'Localize Ergll na costa das Ruínas de Arkkoran.‡Найдите Эргла в руинах храма Арккоран.‡Findet Ergll an der Küste der Ruinen von Arkkoran.‡아크코란의 폐허 근처의 해안에서 어글을 찾아야 합니다.‡Encuentra a Ergll en la costa de las Ruinas de Arkkoran.‡Encuentra a Ergll en la costa de las Ruinas de Arkkoran.‡Trouvez Ergll sur la côte des Ruines d’Arkkoran.‡在亚考兰神殿废墟的海岸上找到厄格尔罗。‡在亞考蘭廢墟的海岸上找到厄爾勾。',
  }
},
[14131] = {
  {
    'Um pequeno incentivo‡Собери мне чуть-чуть‡Bohnensammler‡사소한 부탁‡Una pequeña recolecta‡Una pequeña recolecta‡Un petit remontant‡先提提神‡來點提神的',
    nil,
    'Colete 10 Grãos de Kofé das plantas nas Ruínas de Arkkoran.‡Соберите 10 бобов кауфи с растений в руинах храма Арккоран.‡Pflückt 10 Kahpheebohnen von den Pflanzen in den Ruinen von Arkkoran.‡아크코란의 폐허에서 카우피 콩 10개를 모아야 합니다.‡Recoge 10 judías Kawphi de las plantas de las Ruinas de Akkoran.‡Recoge 10 frijoles Kawphi de las plantas de las Ruinas de Akkoran.‡Récupérez 10 Fèves de kaphay sur les kaphayers dans les Ruines d’Arkkoran.‡在亚考兰神殿废墟收集10颗卡啡豆。‡在亞考蘭廢墟的植物上收集10份咖灰豆。',
  }
},
[14132] = {
  {
    'Bruta falta de sacanagem!‡Это просто невежливо!‡Was für eine Frechheit!‡너무나 무례해!‡¡Qué maleducado!‡¡Qué maleducado!‡C’est vraiment mal élevé !‡没礼貌！‡太失禮了',
    nil,
    'Mate 10 Makrinnis nas Ruínas de Arkkoran.‡Убейте 10 макринни в руинах храма Арккоран.‡Tötet 10 Makrinnis in den Ruinen von Arkkoran.‡아크코란의 폐허에서 마크리니마크루라 10마리를 처치해야 합니다.‡Mata 10 makrinnis en las Ruinas de Arkkoran.‡Mata 10 makrinnis en las Ruinas de Arkkoran.‡Tuez 10 Makrinnis dans les Ruines d’Arkkoran.‡去亚考兰神殿废墟杀掉10头玛科尼龙虾人。‡在亞考蘭廢墟殺死10隻瑪科尼。',
  }
},
[14133] = {
  {
    '‡Путь к сердцу мага‡Ein Magierherz erobern‡‡Conquistar el corazón de un mago‡‡Le véritable chemin pour toucher un mage…‡‡',
    nil,
    '‡Спросите Эргла об Азурегосе.‡Fragt Ergll nach Azuregos.‡‡Pregunta a Ergll sobre Azuregos.‡‡Interrogez Ergll à propose d\'Azuregos.‡‡',
  }
},
[14134] = {
  {
    'MADEEEIRA!!!‡Древесина для подрядчика‡Holz vor der Hütte‡감독관의 통나무‡El diario del capitán‡El diario del capitán‡Il faut bûcher‡队长的木料‡隊長的日誌',
    nil,
    'Use o Retalhador Reprogramado para coletar 6 pilhas de Lenha de Azshara. Se você perder o retalhador, basta atacar e reprogramar outro.‡Воспользуйтесь перепрограммированным крошшером, чтобы собрать 6 штабелей азшарской древесины. Если вы потеряете свой крошшер, можно поймать и перепрограммировать другой.‡Verwendet den umprogrammierten Schredder, um 6 Haufen azsharisches Holz zu sammeln. Falls Ihr Euren Schredder verliert, kann ein weiterer angegriffen und umprogrammiert werden.‡새로 고친 벌목기를 조작해서 아즈샤라 목재 6더미를 모아야 합니다. 벌목기를 잃어버리면 다른 벌목기를 공격한 다음 고쳐서 사용하십시오.‡Utiliza la trituradora reprogramada para obtener 6 montones de madera de Azshara. Si pierdes la trituradora, puedes atacar y reprogramar otra.‡Utiliza la trituradora reprogramada para obtener 6 montones de madera de Azshara. Si pierdes la trituradora, puedes atacar y reprogramar otra.‡Utilisez le Déchiqueteur reprogrammé pour récupérer 6 piles de Bois d’Azshara. Si vous perdez votre déchiqueteur, vous pouvez en attaquer un autre et le reprogrammer.‡用重新编程的伐木机收集6堆艾萨拉木料。假如你失去了你的伐木机，攻击另一台，并重新编程。‡使用程式重寫的伐木機收集6份艾薩拉木材。如果你的伐木機壞了，可以攻擊另一架並重設它的程式。',
  }
},
[14135] = {
  {
    'As árveres somos nozes‡На деревья‡Auf den Baum‡나무 위의 위협‡Subidos a un árbol‡Subidos a un árbol‡Une coupe sombre‡树上的敌人‡在樹上',
    nil,
    'Use a motosserra do retalhador para derrubar Brotinhos de Azshara e mate 9 Francoatiradores de Talrendis quando eles surgirem.‡Воспользуйтесь циркулярной пилой крошшера, чтобы спилить азшарские молодые деревца и убейте 9 снайперов с заставы Талрендис, когда они появятся.‡Verwendet die Motorsäge des Schredders, um die azsharischen Schösslinge niederzumähen und tötet 9 Scharfschützen von der Talrendisspitze, sobald sie auftauchen.‡벌목기의 원형 톱을 이용해서 어린 아즈샤라 나무를 쓰러뜨린 다음, 모습을 드러내는 탈렌디스 저격수 9명을 처치해야 합니다.‡Utiliza la sierra de la trituradora para talar pimpollos de Azshara y mata 9 francotiradores de Talrendis cuando aparezcan.‡Utiliza la sierra de la trituradora para talar pimpollos de Azshara y mata 9 francotiradores de Talrendis cuando aparezcan.‡Utilisez la scie circulaire du déchiqueteur pour abattre des Arbrisseaux d’Azshara, et tuez 9 Snipers de Talrendis dès que vous les apercevez.‡用伐木机的电锯砍倒5棵艾萨拉幼树，杀掉9个现身的塔伦迪斯狙击手。‡使用伐木機的圓鋸砍倒艾薩拉樹苗，然後在塔倫迪斯狙擊手現身時殺死9名。',
  }
},
[14136] = {
  {
    'Resgate em alto-mar‡Спасательная операция на море‡Rettungseinsatz auf See‡해상 구조‡Rescate en el mar‡Rescate en el mar‡Secours en mer‡海上救援‡海上救援',
    nil,
    'Girana, a Ensanguentada, nos Campos do Torneio Argênteo, quer que você mate 8 Berserkers Kvaldir e 3 Arpoadores Kvaldir no Flamáquila.‡Гирана Окровавленная из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас убить 8 квалдиров-берсерков и 3 квалдиров-гарпунеров, напавших на "Огненный Ястреб".‡Girana die Blutgezeichnete auf dem Argentumturnierplatz möchte, dass Ihr 8 Berserker der Kvaldir und 3 Harpunierer der Kvaldir an Bord der Feuerfalke tötet.‡은빛십자군 마상시합 광장에 있는 피의 여전사 지라나가 불꽃매호에 올라타서 크발디르 광전사 8명과 크발디르 작살병 3명을 처치하라고 했습니다.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates 8 rabiosos Kvaldir y 3 arponeros Kvaldir a bordo del Halcón de Fuego.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates 8 rabiosos Kvaldir y 3 arponeros Kvaldir a bordo del Halcón de Fuego.‡Girana Premier-sang, de l’Enceinte du tournoi d’Argent, veut que vous tuiez 8 Berserkers kvaldirs et 3 Harponneurs kvaldirs à bord du Faucon-de-feu.‡银色比武场的身经百战的吉莱娜要你在炎鹰号上消灭8名克瓦迪尔狂暴者和3名克瓦迪尔持戟者。‡銀白聯賽場地的『血漬』吉拉納要你殺掉登上火鷹號的8個科瓦迪爾狂戰士及3個科瓦迪爾魚叉手。',
  }
},
[14137] = {
  {
    '‡Изучение классовых навыков‡Klassenausbildung (Verfolgenereignis)‡직업 훈련 (추적 이벤트)‡Entrenador personal (Tracking Event)‡‡Formation de classe (suivi d\'évènement)‡职业训练（追踪事件）‡',
    nil,
    nil,
  }
},
[14138] = {
  {
    'Tomando conta do negócio‡Бизнес – прежде всего‡Dienst ist Dienst und Cola ist Cola‡직무 수행‡Cuidando del negocio‡Cuidando del negocio‡La main à la pâte‡照看生意‡照顧生意',
    nil,
    'Entregue o Incentivo de Espoleta para o Encarregado Molhavela, na Sede da CCJ, em Kezan.‡Передайте поощрение Хамми штейгеру Промокаху в штаб-квартире ТКК на Кезане.‡Bringt Sassys Motivation zu Vorarbeiter Feuchtlunte im Hauptgeschäftssitz der HGK auf Kezan.‡새시의 장려 선물을 케잔의 케잔 무역 회사 본사에 있는 현장감독 댐윅에게 전달해야 합니다.‡Entrega el incentivo de Sassy al supervisor Mechamojada en la Central SCK, en Kezan.‡Entrega el incentivo de Sassy al supervisor Mechamojada en la Central SCK, en Kezan.‡Apportez l\'Encouragement de Chipie au Contremaître Mèchumide au Quartier général de la SCK, sur Kezan.‡将莎希的奖励交给科赞岛上卡亚罗贸易公司总部的工头戴姆维克。‡將賽希的激勵交給卡亞羅貿易公司總部的工頭唐威克。',
  }
},
[14139] = {
  {
    '‡‡‡페이즈 1 완료 (추적 이벤트)‡‡‡Fin de phase 1 (suivi d\'évènement)‡‡',
    nil,
    nil,
  }
},
[14140] = {
  {
    'Impeça os agressores‡Остановить нападение‡Einhalt den Aggressoren‡침략자를 저지하라‡Detén a los agresores‡Detén a los agresores‡Arrêter les agresseurs‡抗击侵略者‡阻止侵略者',
    nil,
    'Girana, a Ensanguentada, nos Campos do Torneio Argênteo, quer que você mate 10 Kvaldir.‡Гирана Окровавленная с Ристалища Серебряного турнира просит вас убить 10 квалдиров.‡Girana die Blutgezeichnete auf dem Argentumturnierplatz möchte, dass Ihr 10 Kvaldir tötet.‡은빛십자군 마상시합 광장에 있는 피의 여전사 지라나가 크발디르 10명을 처치해 달라고 했습니다.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates a 10 Kvaldir.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates a 10 Kvaldir.‡Girana Premier-sang, de l’Enceinte du tournoi d’Argent, veut que vous tuiez 10 Kvaldirs.‡银色比武场的身经百战的吉莱娜想让你消灭10名克瓦迪尔。‡銀白聯賽場地的『血漬』吉拉納要你去殺掉10個科瓦迪爾人。',
  }
},
[14141] = {
  {
    'Gormok quer o nevold e pronto!‡Гормоку нужны снобольды‡Gormok will seine Schneebolde‡스노볼트를 찾는 고르목‡Gormok quiere sus snóbolds‡Gormok quiere sus snóbolds‡Gormok veut ses frigbolds !‡戈莫克想要他的雪地狗头人‡戈莫克要他的極地狗頭人',
    nil,
    'Use a Rede com Pandulho para capturar 8 Seguidores Ceganeve e leve-os a Tylos Aurovelos nos Campos do Torneio Argênteo.‡Воспользуйтесь утяжеленной сетью, чтобы поймать 8 последователей с Холмов Снежной Слепоты, и приведите их Тайлосу Вестнику Зари в шатер Орды на Ристалище Серебряного турнира.‡Fangt mithilfe des beschwerten Netzes 8 schneeblinde Anhänger und bringt sie zu Tylos Dämmerflucht auf dem Argentumturnierplatz.‡무거운 그물로 설맹의 추종자 8마리를 붙잡아 은빛십자군 마상시합 광장에 있는 틸로스 돈러너에게 가져가야 합니다.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Tylos Correalba, en los Campos del Torneo Argenta.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Tylos Correalba, en los Campos del Torneo Argenta.‡Servez-vous du Filet lesté pour capturer 8 Suivants Brûleglace, et remettez-les à Tylos Coursaurore, dans l’Enceinte du tournoi d’Argent.‡使用强化渔网抓住8个雪盲追随者，并把它们交给银色比武场的泰罗斯·晨行者。‡使用加重的網子捕捉8隻雪盲跟隨者，並帶給銀白聯賽場地的提洛斯·曦奔。',
  }
},
[14142] = {
  {
    'Kal, você já passou dos limites!‡На этот раз ты нарвался, Кул‡Diesmal habt Ihr Euch wirklich selbst übertroffen, Kul‡제대로 한 건 했군, 쿨‡Esta vez la has liado, Kul‡Esta vez la has liado, Kul‡Oh bravo, Kul !!!‡这次你真的做到了，库尔‡庫爾，看看你這次幹得好事',
    nil,
    'Resgate Kal, o Negligente, e 4 Aspirantes Cativos na Vigília da Voz Mórbida e fale novamente com Girana, a Ensanguentada, nos Campos do Torneio Argênteo.‡Спасите Кула Безрассудного и 4 пленных претендентов с Заставы Вестника Смерти и вернитесь к Гиране Окровавленной на Ристалище Серебряного турнира.‡Rettet Kul den Tollkühnen und 4 gefangene Streiter aus Todessprechers Wacht und kehrt dann zu Girana der Blutgezeichneten auf dem Argentumturnierplatz zurück.‡못 말리는 쿨과 사로잡힌 지원자 4명을 죽음예언자 감시초소에서 구한 다음 은빛십자군 마상시합 광장에 있는 피의 여전사 지라나에게 가야 합니다.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Girana la Ensangrentada a los Campos del Torneo Argenta.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Girana la Ensangrentada a los Campos del Torneo Argenta.‡Sauvez Kul le Téméraire et 4 Aspirants captifs du Guet du nécrorateur. Lorsque ce sera fait, retournez voir Girana Premier-sang dans l\'Enceinte du tournoi d\'Argent.‡在亡语者岗哨援救鲁莽的库尔和4名被俘虏的候选者，然后返回银色比武场，去见身经百战的吉莱娜。‡從亡頌者之望救出『魯莽』庫爾和4位被俘虜的志士，然後回去找銀白聯賽場地的『血漬』吉拉納。',
  }
},
[14143] = {
  {
    'Pernas pra que te quero‡Лапами кверху‡Legt mal ein Bein zu‡다리 지원‡Por patas‡Por patas‡Comment retomber sur ses pattes…‡一腿之力‡被劫的腿肉補給',
    nil,
    'Recupere 10 Pernas Roubadas de Moa para Girana, a Ensanguentada, nos Campos do Torneio Argênteo.‡Верните 10 украденных окорочков долгонога Гиране Окровавленной из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Beschafft 10 gestohlene Weitschreiterbeine zurück und bringt sie zu Girana der Blutgezeichneten auf dem Argentumturnierplatz.‡도난당한 타조 다리 10개를 되찾아 은빛십자군 마상시합 광장에 있는피의 여전사 지라나에게 가져가야 합니다.‡Recupera 10 patas de zancaalta robadas para Girana la Ensangrentada en los Campos del Torneo Argenta.‡Recupera 10 patas de zancaalta robadas para Girana la Ensangrentada en los Campos del Torneo Argenta.‡Récupérer 10 Pilons de haut-trotteur volés pour Girana Premier-sang, dans l\'Enceinte du tournoi d\'Argent.‡夺回10条被偷走的陆行鸟腿，交给银色比武场的身经百战的吉莱娜。‡取回10份被偷的陸行鳥腿給銀白聯賽場地的『血漬』吉拉納。',
  }
},
[14144] = {
  {
    'A misericórdia da Luz‡Милосердие Света‡Die Barmherzigkeit des Lichts‡빛의 자비‡La piedad de la Luz‡La piedad de la Luz‡La miséricorde de la Lumière‡圣光的仁慈‡聖光的憐憫',
    nil,
    'Use o Livro de Orações da Confessora para realizar últimos ritos para 8 Aldeões Tualiq Mortos e depois fale novamente com Girana, a Ensanguentada, nos Campos do Torneio Argênteo.‡Воспользуйтесь Молитвенником исповедницы для проведения последнего обряда над телами 8 убитых туаликов, после чего вернитесь к Гиране Окровавленной в шатер Орды на Ристалище Серебряного турнира.‡Benutzt das Gebetsbuch der Beichtpatin, um 8 erschlagenen Tualiq-Bewohnern ihre Sterbesakramente zu lesen, und kehrt dann zu Girana der Blutgezeichneten auf dem Argentumturnierplatz zurück.‡고해사제의 기도서를 사용하여 살해된 투알리크 주민 8명에게 종부성사를 해 주고 은빛십자군 마상시합 광장에 있는 피의 여전사 지라나에게 돌아와야 합니다.‡Usa el libro de oraciones de la confesora para dar la extremaunción a 8 habitantes Tualiq asesinados y después vuelve a ver a Girana la Ensangrentada en los Campos del Torneo Argenta.‡Usa el libro de oraciones de la confesora para dar la extremaunción a 8 habitantes Tualiq asesinados y después vuelve a ver a Girana la Ensangrentada en los Campos del Torneo Argenta.‡Utilisez le Livre de prière du confesseur pour célébrer les derniers sacrements sur 8 Villageois tualiq morts, puis retournez voir Girana Premier-sang dans l\'Enceinte du tournoi d\'Argent.‡使用神官的祈祷书，为8位被屠戮的图亚里克村民举行追悼仪式，然后返回银色比武场，去见身经百战的吉莱娜。‡使用告解者的祈禱書對8個被殺的托利克村民執行最後的儀式，然後回去找銀白聯賽場地的『血漬』吉拉納。',
  }
},
[14145] = {
  {
    'Yeti come o quê?‡Кстати, чем питаются йети?‡Was fressen eigentlich Yetis?‡설인에게는 뭘 먹이세요?‡¿Y qué comen los yetis?‡¿Y qué comen los yetis?‡Ça mange quoi, un yéti, d\'abord ?‡你们到底喂雪人吃什么？‡雪人到底該吃什麼?',
    nil,
    'Tylos Aurovelos, nos Campos do Torneio Argênteo, quer que você lhe traga 3 pedaços de Carne de Tubarão do Mar do Norte.‡Тайлос Вестник Зари из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести ему 3 куска мяса акулы Северного моря.‡Tylos Dämmerflucht auf dem Argentumturnierplatz möchte, dass Ihr ihm 3 Stück Fleisch eines Nordmeerhais bringt.‡은빛십자군 마상시합 광장에 있는 틸로스 돈러너가 북해 상어 고기 3개를 가져다 달라고 했습니다.‡Tylos Correalba en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Tylos Correalba en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Tylos Coursaurore, dans l\'Enceinte du tournoi d\'Argent, veut que vous lui apportiez 3 morceaux de Chair de requin de la mer Boréale.‡银色比武场的泰罗斯·晨行者想让你带给她3块北海鲨鱼肉。‡銀白聯賽場地的提洛斯·曦奔要你帶3片北海鯊魚肉給他。',
  }
},
[14146] = {
  {
    'Defenda os portões!‡Защитить врата!‡Verteidigt die Tore!‡성문을 방어하라!‡¡Defended las puertas!‡¡Defiende las puertas!‡Défendez les portes !‡防守大门！‡守衛大門!',
    nil,
    'O Capataz Agárrio precisa que você retorne ao Portão Traseiro de Orgrimmar para matar 20 Elfos Noturnos Saqueadores.‡Подрядчик Жаднюк просит вас поспешить к задним вратам Оргриммара и убить 20 ночных эльфов-налетчиков.‡Arbeitsaufseher Grabbit will, dass Ihr zurück zum Hinteren Tor von Orgrimmar eilt und dort 20 Räuber der Nachtelfen tötet.‡작업 감독관 그래빗이 오그리마 뒷문으로 돌아가 탈렌디스 약탈자 20명을 처치해 달라고 했습니다.‡El jefe de personal Grabbit necesita que vuelvas a la Puerta Trasera de Orgrimmar para matar 20 asaltantes elfos de la noche.‡El jefe de personal Grabbit necesita que vuelvas a la Puerta Trasera de Orgrimmar para matar 20 asaltantes elfos de la noche.‡Le Capitaine d’ouvrage Grailletout veut que vous retourniez sans tarder à la Porte d’Azshara pour massacrer 20 Écumeurs elfes de la nuit.‡劳工队长格拉比特要你杀回奥格瑞玛后门干掉20个暗夜精灵袭击者。‡工人隊長葛拉比特需要你快點回到奧格瑪後門，消滅 20個夜精靈劫掠者。',
  }
},
[14151] = {
  {
    'O rubi cardinal‡Багровый рубин‡Kardinalsrubin‡선홍빛 루비‡Rubí cárdeno‡Rubí cárdeno‡Le rubis cardinal‡赤玉石‡緋色紅寶石',
    nil,
    'Linzy Raionegro, de Dalaran, quer que você transmute gemas em 5 gemas épicas com sua perícia em alquimia. Você pode criar Ametrina, Olho-de-zul, Medolita, Âmbar-do-rei ou Zircônio Majestoso.‡Линзи Черноболт просит вас успешно трансмутировать пять эпических драгоценных камней с помощью алхимии. Можно трансмутировать аметрин, око Зула, страхолит, царский янтарь и величественный циркон.‡Linzy Schwarzbolz in Dalaran möchte, dass Ihr 5 erfolgreiche Transmutationen epischer Edelsteine mithilfe Eurer Alchemiefertigkeit durchführt. Für die Transmutation akzeptable Edelsteine sind Ametrine, Augen von Zul, Schreckenssteine, Königsbernsteine und Fürstenzirkone.‡달라란에 있는 린지 블랙볼트가 연금술로 다섯 개의 영웅급 보석을 성공적으로 변환해 달라고 했습니다. 허용할 수 있는 변환식은 자황수정, 줄의 눈, 공포석, 왕의 호박석, 귀족 지르콘입니다.‡Linzy Pernonegro de Dalaran quiere que transmutes 5 gemas épicas con tu habilidad en alquimia. Las transmutaciones aceptables son: ametrino, ojo de Zul, piedra de terror, ámbar del rey y circón majestuoso.‡Linzy Pernonegro de Dalaran quiere que transmutes 5 gemas épicas con tu habilidad en alquimia. Las transmutaciones aceptables son: ametrino, ojo de Zul, piedra de terror, ámbar del rey y circón majestuoso.‡Linzy Noirboulon, à Dalaran, veut que vous effectuiez 5 transmutations de gemmes épiques grâce à vos compétences d\'alchimiste. Les transmutations acceptées sont les suivantes : Amétrine, Œil de Zul, Pierre d\'effroi, Ambre du roi et Zircon majestueux.‡达拉然的林奇·黑箭想让你以你的炼金术技能成功地转化5种史诗宝石。这五种史诗宝石是：紫黄晶、祖尔之眼、恐惧石、王者琥珀和巨锆石。‡達拉然的琳西‧黑栓要你用鍊金術成功的轉化5顆史詩級寶石。你可以轉化紫黃晶、祖爾之眼、懼石、王者琥珀和威嚴鋯石。',
  }
},
[14152] = {
  {
    'Resgate em alto-mar‡Спасательная операция на море‡Rettungseinsatz auf See‡해상 구조‡Rescate en el mar‡Rescate en el mar‡Secours en mer‡海上救援‡海上救援',
    nil,
    'Vá ao Mar do Norte e mate 8 Berserkers Vraikalen e 3 Arpoadores Vraikalen que estejam atacando o Olacrístia.‡Отправляйтесь в Северное море и убейте 8 врайкулов-берсерков и 3 врайкулов-гарпунеров, напавших на "Гребень Волны".‡Begebt Euch in Richtung des Nordmeers und tötet unter den Angreifern der Schaumkrone 8 Berserker der Vrykul und 3 Harpunierer der Vrykul.‡북해로 가서 물마루호를 공격하는 크발디르 광전사 8명과 크발디르 작살병 3명을 처치해야 합니다.‡Dirígete a El Mar del Norte y mata 8 rabiosos vrykul y 3 arponeros vrykul que estén atacando el Cresta de la Ola.‡Dirígete a El Mar del Norte y mata 8 rabiosos vrykul y 3 arponeros vrykul que estén atacando el Cresta de la Ola.‡Partez pour la Mer Boréale et tuez 8 Berserkers kvaldirs et 3 Harponneurs kvaldirs parmi les assaillants du Hautevague.‡前往北海，消灭攻击浪巅号的8个克瓦迪尔狂暴者和3个克瓦迪尔持戟者。‡前往北海殺掉正在攻擊浪峰號的8個科瓦迪爾狂戰士及3個科瓦迪爾魚叉手。',
  }
},
[14153] = {
  {
    'A alma da festa‡Банкет‡Der Mittelpunkt der Party‡파티 생활‡El alma de la fiesta‡El alma de la fiesta‡Membre d\'honneur‡聚会生活‡派對人生',
    nil,
    'Vista seu Conjunto Incrível de Festa (Óculos Maneiros, Roupa Nova Estilosa e Balangandãs Brilhosos). Então siga para a festa na Sede da CCJ para entreter 10 Baladeiros de Kezan.‡Наденьте свой потрясный прикид для вечеринки (темные очки, новый стильный костюмчик и блестящие украшения) и отправляйтесь развлекать 10 кутил из Кезана, собравшихся у бассейна в штаб-квартире ТКК.‡Zieht Eure großartige Partyausstattung an (Coole Sonnenbrille, Hippes neues Outfit und Strahlende Klunker). Begebt Euch danach auf die Party am Pool des Hauptgeschäftssitzes der HGK und unterhaltet 10 kezanische Feiernde.‡근사한 연회 복장(근사한 색안경, 끝내주는 새 옷, 빛나는 반짝이)을 입고 케잔 무역 회사 본사에 있는 수영장에 가서 케잔 파티 하객 10명을 즐겁게 해 줘야 합니다.‡Ponte tu modelito de fiesta impresionante (gafas de sol chulas, atuendo pistonudo y cadena de oro lustrosa) y dirígete a la fiesta en la piscina de la Central SCK para entretener a 10 fiesteros de Kezan.‡Ponte tu modelito de fiesta impresionante (gafas de sol chulas, atuendo pistonudo y cadena de oro lustrosa) y dirígete a la fiesta en la piscina de la Central SCK para entretener a 10 fiesteros de Kezan.‡Revêtez votre Tenue de fête sensationnelle (Lunettes de soleil cool, Nouvelle tenue branchée et Bling-bling rutilant), puis dirigez-vous vers la fête à la piscine du Quartier général de la SCK et divertissez 10 Bambocheurs de Kezan.‡穿戴好你的超酷派对套装（亮闪闪的珠宝、潮人装束和清爽遮阳镜），然后前往在卡亚罗贸易公司总部泳池边举行的聚会，款待10位科赞聚会者。‡穿上你超炫的舞會套裝(拉風墨鏡，時髦新裝，和亮晶晶的玩意兒)然後前往卡亞羅貿易公司總部，在泳池邊的派對中招待10位凱贊派對客。',
  }
},
[14154] = {
  {
    'Por um fio de cabelo‡На расстоянии укуса‡Mit knapper Not‡구사일생‡Por los pelos‡Por los pelos‡Pas passé loin‡命悬一线‡一場僥倖',
    nil,
    'Contenha os worgens no alto da Prisão de Guilnéas por 2 minutos.‡В течение 2 минут сдерживайте натиск воргенов на крыше тюрьмы Гилнеаса.‡Haltet die Worgen im oberen Bereich des Stadtgefängnisses von Gilneas 2 Minuten lang auf.‡바위봉쇄 감옥 꼭대기에서 늑대인간의 공격을 2분 동안 막아내야 합니다.‡Retén a los huargen de la parte superior de la Prisión de la Ciudad de Gilneas durante 2 minutos.‡Retén a los huargen de la parte superior de la Prisión de la Ciudad de Gilneas durante 2 minutos.‡Repoussez les worgens au sommet de la prison de Gilnéas pendant 2 minutes.‡在吉尔尼斯城市监狱顶部抵御狼人的攻击，坚持2分钟。‡在吉爾尼斯城監獄上阻擋狼人2分鐘。',
  }
},
[14155] = {
  {
    'Arboricídio‡Арборицид‡Arborzid‡나무 처리 전문‡Arbolcidio‡Arbolcidio‡Arbricide‡砍大树‡除木行動',
    nil,
    'Use o Retalhador para destruir o Anciente de Talrendis. Retalhadores de Emergência estão disponíveis no Portão Traseiro de Orgrimmar se você perder o seu.‡Воспользуйтесь крошшером, чтобы уничтожить древня с заставы Талрендис. Если потеряете крошшер, можете воспользоваться запасным, его можно взять у задних врат Оргриммара.‡Verwendet den Schredder, um das Urtum von der Talrendisspitze zu vernichten. Notfallersatzschredder stehen am Hinteren Tor von Orgrimmar zur Verfügung, wenn Ihr Euren verliert.‡벌목기를 사용하여 탈렌디스 고대정령을 처치해야 합니다. 벌목기를 잃어버리면 오그리마 뒷문에서 비상용 예비 벌목기를 구할 수 있습니다.‡Utiliza la trituradora para destruir al Anciano de Talrendis. Hay trituradoras de repuesto de emergencia en la Puerta Trasera de Orgrimmar en caso de que pierdas la tuya.‡Utiliza la trituradora para destruir al Anciano de Talrendis. Hay trituradoras de repuesto de emergencia en la Puerta Trasera de Orgrimmar en caso de que pierdas la tuya.‡Utilisez le Déchiqueteur pour détruire l’Ancien de Talrendis. Si vous perdez votre déchiqueteur, des machines de secours sont disponibles à la Porte d’Azshara.‡用伐木机摧毁塔伦迪斯战争古树。要是你的伐木机被毁，奥格瑞玛后门还有紧急备用伐木机可供使用。‡使用伐木機摧毀塔倫迪斯古樹。如果你的伐木機壞了，奧格瑪後門那裏有緊急備用的伐木機。',
  }
},
[14156] = {
  {
    '‡Засланный шпион‡V-Mann‡잠복근무‡El topo‡El topo‡Un infiltré‡打入内部‡',
    nil,
    '‡Найдите Шона Демпси на крыше тюрьмы Гилнеаса.‡Findet Sean Dempsey auf dem Dach des Stadtgefängnisses von Gilneas.‡‡Busca a Sean Dempsey en el tejado de la Prisión de la Ciudad de Gilneas.‡‡Trouvez Sean Dempsey sur le toit de la prison de Gilnéas.‡‡',
  }
},
[14157] = {
  {
    'Antigas diferenças‡Старые распри‡Alte Differenzen‡오래된 분열‡Viejas divisiones‡Viejas divisiones‡D\'anciennes rancœurs‡旧日的分歧‡往日的分歧',
    nil,
    'Fale com o Capitão Broderick na Prisão Guardapétrea, em Guilnéas.‡Поговорите с капитаном Бродериком в Каменной тюрьме, что в Гилнеасе.‡Sprecht mit Hauptmann Broderick im Steinwallgefängnis in Gilneas.‡길니아스 시의 바위봉쇄 감옥 안에 있는 대장 브로데릭과 대화해야 합니다.‡Habla con el capitán Broderick en el interior de la Prisión Guardapétrea, en la ciudad de Gilneas.‡Habla con el capitán Broderick en el interior de la Prisión Guardapétrea, en la ciudad de Gilneas.‡Parlez au Capitaine Broderick dans la Prison de Gardepierre, à Gilnéas.‡同吉尔尼斯城中斯通沃德监狱里的布罗德里克队长谈一谈。‡在吉爾尼斯城裡的石衛監獄和伯德瑞克上尉談話。',
  }
},
[14158] = {
  {
    '‡‡‡페이즈 6 완료 (추적 이벤트)‡‡‡Fin de phase 6 (suivi d\'évènement)‡‡',
    nil,
    nil,
  }
},
[14159] = {
  {
    'O arsenal do lorde rebelde‡Арсенал мятежного лорда‡Das Arsenal des Rebellenlords‡반란자의 무기고‡El arsenal del Señor rebelde‡El arsenal del Señor rebelde‡L\'arsenal du seigneur séditieux‡叛军领主的军械库‡叛軍頭子的軍火',
    nil,
    'Fale com o Josiah Avery no Distrito Militar de Guilnéas.‡Поговорите с Джосайей Авери в Военном квартале Гилнеаса.‡Sprecht mit Josiah Avery im Militärdistrikt in Gilneas.‡길니아스 시의 군사 지구에 있는 조시아 에이버리와 대화해야 합니다.‡Habla con Josiah Avery en el Distrito Militar, Ciudad de Gilneas.‡Habla con Josiah Avery en el Distrito Militar, Ciudad de Gilneas.‡Parlez à Josiah Avery dans le Secteur Militaire, à Gilnéas.‡跟吉尔尼斯城军事区的约书亚·阿维利谈一谈。‡在吉爾尼斯城的軍事區和喬希亞•艾弗瑞談話。',
  }
},
[14160] = {
  {
    'Ordem de mérito‡Список заслуг‡Leistungsurkunde‡공로장‡Libranza de mérito‡Libranza de mérito‡Commission de mérite‡功勋状‡功績令狀',
    nil,
    'Entregue a Ordem de Mérito para Falcão Joiado em Dalaran.‡Доставьте Список заслуг Тимоти Джонсу в Даларан.‡Liefert die Leistungsurkunde bei Jonas Timotheus in Dalaran ab.‡달라란에 있는 티모시 존스에게 공로장을 가져가야 합니다.‡Entrega la libranza de mérito a Timothy Jones en Dalaran.‡Entrega la libranza de mérito a Timothy Jones en Dalaran.‡Présentez la Commission de mérite à Timothy Jones, à Dalaran.‡将功勋状交给达拉然的提莫斯·琼斯。‡把功績令狀送給達拉然的提摩西·瓊斯。',
  }
},
[14161] = {
  {
    'Basiliscos ariscos‡Удар по василискам‡Basilisken klatschen‡바실리스크 혼내주기‡Apaleando basiliscos‡Apaleando basiliscos‡Un parfum de basilic‡灭除蜥蜴‡痛扁石化蜥蜴',
    nil,
    'Mate 10 Basiliscos Rochagris na Mina do Sopé.‡Убейте 10 серокаменных василисков в карьере у подножья горы.‡Tötet 10 Grausteinbasilisken im Tagebau am Gebirgsfuß.‡산기슭 노천광산에서 잿빛바위바실리스크 10마리를 처치해야 합니다.‡Mata 10 basiliscos Petragris en la Cantera de la Ladera.‡Mata 10 basiliscos Petragris en la Cantera de la Ladera.‡Tuez 10 Basilics grispierre dans la Mine à ciel ouvert du Puy-du-Pied.‡杀掉山麓矿场里的10只灰石蜥蜴。‡在山腳露天礦場中殺死10隻灰石蜥蜴。',
  }
},
[14162] = {
  {
    'Apresente-se a Horzak‡Отчитаться Хорзаку‡Meldet Euch bei Horzak‡호자크에게 보고‡Informa a Horzak‡Informa a Horzak‡Présentez-vous à Horzak‡向霍扎克汇报‡向荷札克回報',
    nil,
    'Encontre Horzak Fazquetrinca na Estação da Foguetovia de Orgrimmar, que fica em Azshara.‡Найдите Хорзака Кругоглода на оргриммарской пересадочной станции ракетной дороги в Азшаре.‡Findet Horzak Zignibbel am Umschlagplatz der Raketenbahn von Orgrimmar in Azshara.‡아즈샤라의 오그리마 로켓길 교역소에 있는 호자크 지그니블을 찾아야 합니다.‡Busca a Horzak Cuatrobitzip en Intercambiador de la Cohetepista de Orgrimmar, en Azshara.‡Busca a Horzak Cuatrobitzip en Intercambiador de la Cohetepista de Orgrimmar, en Azshara.‡Trouvez Horzak Zigrignote à la Station d’Orgrimmar du fusorail, en Azshara.‡在艾萨拉找到位于奥格瑞玛火箭车换乘站的霍扎克·齐格尼伯。‡在艾薩拉的奧格瑪火箭道交會點找到荷札克·轉啃。',
  }
},
[14163] = {
  {
    'Chamado às armas: Ilha da Conquista‡Призыв к оружию: Остров Завоеваний‡Zu den Waffen: Insel der Eroberung‡전장으로: 정복의 섬‡Llamamiento a las armas: Isla de la Conquista‡Llamamiento a las armas: Isla de la Conquista‡Appel aux armes : île des Conquérants‡战斗的召唤：征服之岛‡戰鬥的號角:征服之島',
    nil,
    'Vença uma partida no campo de batalha da Ilha da Conquista e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Острова Завоеваний и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Erringt den Sieg bei einer Partie auf dem Schlachtfeld "Insel der Eroberung" und kehrt zu einem Brigadegeneral der Allianz in irgendeiner Hauptstadt, Dalaran oder Shattrath zurück.‡정복의 섬 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Isla de la Conquista y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Isla de la Conquista y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gagnez sur l\'Île des Conquérants, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在征服之岛战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在征服之島的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[14164] = {
  {
    'Chamado às armas: Ilha da Conquista‡Призыв к оружию: Остров Завоеваний‡Zu den Waffen: Insel der Eroberung‡전장으로: 정복의 섬‡Llamamiento a las armas: Isla de la Conquista‡Llamamiento a las armas: Isla de la Conquista‡Appel aux armes : île des Conquérants‡战斗的召唤：征服之岛‡戰鬥的號角:征服之島',
    nil,
    'Vença uma partida no campo de batalha da Ilha da Conquista e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Принесите почетные знаки каждого поля боя ордынскому вестнику войны в любую столицу Орды, на Озеро Ледяных Оков, в Даларан или Шаттрат.‡Erringt den Sieg bei einer Partie auf dem Schlachtfeld "Insel der Eroberung" und kehrt zu einem Kriegshetzer der Horde in irgendeiner Hauptstadt, Dalaran oder Shattrath zurück.‡정복의 섬 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Isla de la Conquista y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Isla de la Conquista y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gagnez sur l\'Île des Conquérants, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在征服之岛战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在征服之島的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[14165] = {
  {
    'Coração de pedra (e rins, e fígado, e...)‡Хладный камень‡Kalt wie Stein‡차갑게 굳어버렸다‡Frío como una piedra‡Frío como una piedra‡Pétrifiés‡冷若岩石‡冷血者',
    nil,
    'Colete um Minerador Petrificado da Mina do Sopé e leve-o(a) de volta para Horzak Fazquetrinca na Estação da Foguetovia de Orgrimmar.‡Найдите в карьере у подножья горы окаменевшего горняка и принесите его Хорзаку Кругоглоду на оргриммарскую пересадочную станцию ракетной дороги.‡Holt einen versteinerten Bergfußminenarbeiter aus dem Tagebau am Gebirgsfuß und bringt ihn zurück zu Horzak Zignibble am Umschlagplatz der Raketenbahn von Orgrimmar.‡산기슭 노천광산에서 돌이 된 산기슭 광부를 찾아 오그리마 로켓길 교역소에 있는 호자크 지그니블에게 가져가야 합니다.‡Consigue un minero de ladera petrificado de la Cantera de Ladera y llévaselo de vuelta a Horzak Cuatrobitzip en el Intercambiador de la Cohetepista de Orgrimmar.‡Consigue un minero de ladera petrificado de la Cantera de Ladera y llévaselo de vuelta a Horzak Cuatrobitzip en el Intercambiador de la Cohetepista de Orgrimmar.‡Allez chercher un Mineur du Puy-du-Pied pétrifié dans la Mine à ciel ouvert du Puy-du-Pied, et ramenez-le à Horzak Zigrignote, à la Station d’Orgrimmar du fusorail.‡去山麓矿场抱一个被石化的山麓矿工回来，交给奥格瑞玛火箭车换乘站的霍扎克·齐格尼伯。‡從山腳露天礦場收集一個石化的山腳礦工，並將他或她帶回去給位於奧格瑪火箭道交會點的荷札克·轉啃。',
  }
},
[14166] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Alegre de Dalaran no cemitério de Dalaran.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому даларанскому духу на кладбище Даларана.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Geist aus Dalaran auf dem Friedhof von Dalaran.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 달라란의 무덤에 있는 명랑한 달라란 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de Dalaran alegre en el cementerio de Dalaran.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de Dalaran alegre en el cementerio de Dalaran.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de Dalaran joyeux dans le cimetière de Dalaran.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给达拉然墓地的欢快的达拉然灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給達拉然墓地中興奮的達拉然靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14167] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Enânico Alegre no cemitério de Altaforja.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу дворфа на кладбище Стальгорна.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Zwergengeist auf dem Friedhof von Eisenschmiede.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 아이언포지 무덤에 있는 명랑한 드워프 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de enano alegre en el cementerio de Forjaz.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de enano alegre en el cementerio de Forjaz.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de nain joyeux dans le cimetière de Forgefer.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给铁炉堡墓地的欢快的矮人灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給鐵爐堡墓地中興奮的矮人靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14168] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Gnômico Alegre, no cemitério de Altaforja.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу гнома на кладбище Стальгорна.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Gnomengeist auf dem Friedhof von Eisenschmiede.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 아이언포지의 무덤에 있는 명랑한 노움 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de gnomo alegre en el cementerio de Forjaz.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de gnomo alegre en el cementerio de Forjaz.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de gnome joyeux dans le cimetière de Forgefer.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给铁炉堡墓地的欢快的侏儒灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給鐵爐堡墓地中興奮的地精靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14169] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Draenei Alegre, no cemitério da Exodar.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу дренея на кладбище Экзодара.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Draeneigeist auf dem Friedhof der Exodar.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 엑소다르의 무덤에 있는 명랑한 드레나이 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de draenei alegre en el cementerio de El Exodar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de draenei alegre en el cementerio de El Exodar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de draeneï joyeux dans le cimetière de l\'Exodar.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给埃索达墓地的欢快的德莱尼灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給艾克索達墓地中興奮的德萊尼靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14170] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Noctiélfico Alegre no cemitério de Darnassus.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу ночного эльфа на кладбище Дарнаса.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Nachtelfengeist auf dem Friedhof von Darnassus.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 다르나서스의 무덤에 있는 명랑한 나이트 엘프 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de elfo de la noche alegre en el cementerio de Darnassus.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de elfo de la noche alegre en el cementerio de Darnassus.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit d\'elfe de la nuit joyeux dans le cimetière de Darnassus.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给达纳苏斯墓地的欢快的暗夜精灵灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給達納蘇斯墓地中興奮的夜精靈靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14171] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Sanguinélfico Alegre no cemitério de Luaprata.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу эльфийки крови на кладбище Луносвета.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Blutelfengeist auf dem Friedhof von Silbermond.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 실버문의 무덤에 있는 명랑한 블러드 엘프 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de elfa de sangre alegre en el cementerio de la Ciudad de Lunargenta.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de elfa de sangre alegre en el cementerio de la Ciudad de Lunargenta.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit d\'elfe de sang joyeux dans le cimetière de Lune-d\'argent.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给银月城墓地的欢快的血精灵灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給銀月城墓地中興奮的血精靈靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14172] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Alegre dos Aldor no cemitério de Shattrath.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу Алдора на кладбище Шаттрата.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Geist eines Anhängers der Aldor auf dem Friedhof von Shattrath.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 샤트라스의 무덤에 있는 명랑한 알도르 사제회 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de Aldor alegre en el cementerio de Shattrath.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de Aldor alegre en el cementerio de Shattrath.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de l\'Aldor joyeux dans le cimetière de Shattrath.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给沙塔斯墓地的欢快的奥尔多灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給撒塔斯墓地中興奮的奧多爾靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14173] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Alegre de Áugure, no cemitério de Shattrath.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу Провидца на кладбище Шаттрата.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Geist eines Anhängers der Seher auf dem Friedhof von Shattrath.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 샤트라스의 무덤에 있는 명랑한 점술가 길드 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de Arúspice alegre en el cementerio de Shattrath.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de Arúspice alegre en el cementerio de Shattrath.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de Clairvoyant joyeux dans le cimetière de Shattrath.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给沙塔斯墓地的欢快的占星者灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給撒塔斯墓地中興奮的占卜者靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14174] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Alegre de Renegado no cemitério da Cidade Baixa.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу Отрекшегося на кладбище Подгорода.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Verlassenengeist auf dem Friedhof von Unterstadt.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 언더시티의 무덤에 있는 명랑한 포세이큰 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de Renegado alegre en el cementerio de Entrañas.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de Renegado alegre en el cementerio de Entrañas.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de Réprouvé joyeux dans le cimetière de Fossoyeuse.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给幽暗城墓地的欢快的被遗忘者灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給幽暗城墓地中興奮的被遺忘者靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14175] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Órquico Alegre no cemitério de Orgrimmar.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу орка на кладбище Оргриммара.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Orcgeist auf dem Friedhof von Orgrimmar.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 오그리마의 무덤에 있는 명랑한 오크 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de orco alegre en el cementerio de Orgrimmar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de orco alegre en el cementerio de Orgrimmar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit d\'orc joyeux dans le cimetière d\'Orgrimmar.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给奥格瑞玛墓地的欢快的兽人灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給奧格瑪墓地中興奮的獸人靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14176] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Tauren Alegre no cemitério do Penhasco do Trovão.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу таурена на кладбище Громового Утеса.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Taurengeist auf dem Friedhof von Donnerfels.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 썬더 블러프의 무덤에 있는 명랑한 타우렌 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de tauren alegre en el cementerio de Cima del Trueno.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de tauren alegre en el cementerio de Cima del Trueno.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de tauren joyeux dans le cimetière des Pitons-du-Tonnerre.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给雷霆崖墓地的欢快的牛头人灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給雷霆崖墓地中興奮的牛頭人靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14177] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Trólico Alegre no cemitério de Orgrimmar.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу тролля на кладбище Оргриммара.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Trollgeist auf dem Friedhof von Orgrimmar.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 오그리마의 무덤에 있는 명랑한 트롤 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de trol alegre en el cementerio de Orgrimmar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de trol alegre en el cementerio de Orgrimmar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts, et donnez-le à l\'Esprit de troll joyeux dans le cimetière d\'Orgrimmar.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给奥格瑞玛墓地的欢快的巨魔灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給奧格瑪墓地中興奮的食人妖靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[14178] = {
  {
    'Chamado às armas: Bacia Arathi‡Призыв к оружию: Низина Арати‡Ruf zu den Waffen: Arathibecken‡전장으로: 아라시 분지‡Llamamiento a las armas: Cuenca de Arathi‡Llamamiento a las armas: Cuenca de Arathi‡Appel aux armes : bassin Arathi‡战斗的召唤：阿拉希盆地‡戰鬥的號角: 阿拉希盆地',
    nil,
    'Vença uma partida no campo de batalha da Bacia Arathi e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Низины Арати и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Arathibecken und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡아라시 분지 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Bassin Arathi, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在阿拉希盆地战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在阿拉希盆地的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[14179] = {
  {
    'Chamado às armas: Olho da Tormenta‡Призыв к оружию: Око Бури‡Ruf zu den Waffen: Auge des Sturms‡전장으로: 폭풍의 눈‡Llamamiento a las armas: Ojo de la Tormenta‡Llamamiento a las armas: Ojo de la Tormenta‡Appel aux armes : Œil du cyclone‡战斗的召唤：风暴之眼‡戰鬥的號角:暴風之眼',
    nil,
    'Vença uma partida no campo de batalha do Olho da Tormenta e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Ока Бури и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Auge des Sturms und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡폭풍의 눈 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla del Ojo de la Tormenta y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla del Ojo de la Tormenta y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gagnez dans l\'Œil du cyclone, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在风暴之眼战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在暴風之眼的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[14180] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: Ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Ущелья Песни Войны и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在战歌峡谷战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在戰歌峽谷的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[14181] = {
  {
    'Chamado às armas: Bacia Arathi‡Призыв к оружию: Низина Арати‡Ruf zu den Waffen: Arathibecken‡전장으로: 아라시 분지‡Llamamiento a las armas: Cuenca de Arathi‡Llamamiento a las armas: Cuenca de Arathi‡Appel aux armes : bassin Arathi‡战斗的召唤：阿拉希盆地‡戰鬥的號角: 阿拉希盆地',
    nil,
    'Vença uma partida no campo de batalha da Bacia Arathi e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Низины Арати и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Arathibecken und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡아라시 분지 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Cuenca de Arathi y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans le Bassin Arathi, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在阿拉希盆地战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在阿拉希盆地的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[14182] = {
  {
    'Chamado às armas: Olho da Tormenta‡Призыв к оружию: Око Бури‡Ruf zu den Waffen: Auge des Sturms‡전장으로: 폭풍의 눈‡Llamamiento a las armas: Ojo de la Tormenta‡Llamamiento a las armas: Ojo de la Tormenta‡Appel aux armes : Œil du cyclone‡战斗的召唤：风暴之眼‡戰鬥的號角:暴風之眼',
    nil,
    'Vença uma partida no campo de batalha do Olho da Tormenta e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Ока Бури и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Auge des Sturms und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡폭풍의 눈 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla del Ojo de la Tormenta y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla del Ojo de la Tormenta y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille dans l\'Œil du cyclone, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在风暴之眼战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在暴風之眼的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[14183] = {
  {
    'Chamado às armas: Ravina Brado Guerreiro‡Призыв к оружию: Ущелье Песни Войны‡Ruf zu den Waffen: Kriegshymnenschlucht‡전장으로: 전쟁노래 협곡‡Llamamiento a las armas: Garganta Grito de Guerra‡Llamamiento a las armas: Garganta Grito de Guerra‡Appel aux armes : goulet des Chanteguerres‡战斗的召唤：战歌峡谷‡戰鬥的號角:戰歌峽谷',
    nil,
    'Vença uma partida no campo de batalha da Ravina Brado Guerreiro e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Ущелья Песни Войны и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht in der Kriegshymnenschlucht und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡전쟁노래 협곡 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 전쟁인도자에게 가야 합니다.‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.|n‡Gana un encuentro en el campo de batalla de la Garganta Grito de Guerra y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.|n‡Remportez la bataille dans le Goulet des Chanteguerres, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在战歌峡谷的战场上赢得一场竞赛，然后去见任意部落主城、冬拥湖、达拉然或者沙塔斯的部落战争使者。‡在戰歌峽谷的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[14184] = {
  {
    'Meu tempo acabou‡Мое время прошло…‡Meine Zeit ist um‡내 숨이 다하니‡Se acabó mi tiempo‡Se acabó mi tiempo‡Mon heure est venue‡我的时候已经到了‡我的時間結束了',
    nil,
    'Furien, em Tethris Aran, quer que você cavalgue no Falcodrago dele até o Posto de Furien e informe a irmã, Cerelia, sobre a morte dele.‡Выполняя последнюю волю Фуриена в Тефрис-Аране, садитесь на его дракондора, отправляйтесь на Пост Фуриена и расскажите его сестре Серелии о смерти брата.‡Furien in Tethris Aran will, dass Ihr auf seinem Drachenfalken zu Furiens Posten reitet und seine Schwester Cerelia über seinen Tod unterrichtet.‡테드리스 아란에 있는 퓨리엔이 용매를 타고 퓨리엔의 거점으로 가서 세렐리아에게 자신의 죽음을 알려 달라고 했습니다.‡Furien, de Tethris Aran, quiere que montes su dracohalcón hasta el Puesto de Furien e informes a su hermana Cerelia de su muerte.‡Furien, de Tethris Aran, quiere que montes su dracohalcón hasta el Puesto de Furien e informes a su hermana Cerelia de su muerte.‡Furien de Tethris Aran veut que vous utilisiez son Faucon-dragon pour vous rendre au Poste de Furien et prévenir sa sœur, Cérélia, de sa mort.‡塔迪萨兰的弗瑞恩要你乘他的龙鹰前往弗瑞恩的哨站，去把他的死讯告诉他的姐姐瑟蕾莉亚。‡塔迪薩蘭的弗里安要你騎著他的龍鷹到弗里安崗哨將他死亡的消息通知他的姊妹，賽蕾莉亞。',
  }
},
[14185] = {
  {
    '‡УКАЗАТЕЛЬ: приглашение на тренировки по верховой езде (40)‡‡전문 기수 광고 (40)‡‡‡BALISE : publicité du maître de monte (40)‡‡',
    nil,
    nil,
  }
},
[14186] = {
  {
    '‡УКАЗАТЕЛЬ: приглашение на тренировки по верховой езде (60)‡‡전문 기수 광고 (60)‡‡‡BALISE : publicité du maître de monte (60)‡‡',
    nil,
    nil,
  }
},
[14187] = {
  {
    '‡УКАЗАТЕЛЬ: приглашение на тренировки по верховой езде (70)‡‡전문 기수 광고 (70)‡‡‡BALISE : publicité du maître de monte (70)‡‡',
    nil,
    nil,
  }
},
[14188] = {
  {
    'Vingue Furien!‡Месть за Фуриена‡Rächt Furien!‡퓨리엔의 복수‡¡Vengar a Furien!‡¡Vengar a Furien!‡Vengez Furien !‡为弗瑞恩报仇！‡為弗里安報仇!',
    nil,
    'Cerelia quer que você fale com Sorrem no Posto de Furien.‡По просьбе Серелии поговорите с Сорремом на Посту Фуриена.‡Cerelia will, dass Ihr mit Sorrem in Furions Posten sprecht.‡퓨리엔의 거점에 있는 세렐리아가 소렘과 대화해 달라고 했습니다.‡Cerelia quiere que hables con Sorrem en el Puesto de Furien.‡Cerelia quiere que hables con Sorrem en el Puesto de Furien.‡Cérélia vous a demandé de parler à Sorrem au Poste de Furien.‡瑟蕾莉亚要你跟弗瑞恩的哨站的苏伦谈一谈。‡賽蕾莉亞要你去和弗里安崗哨的索雷姆交談。',
  }
},
[14189] = {
  {
    'Tradução‡Расшифровка‡Übersetzung‡해석‡La traducción‡La traducción‡La traduction‡翻译‡翻譯',
    nil,
    'Sorrem quer que você encontre as Tabuletas Ancestrais.|n|nFale com Narimar no Posto de Furien para ir até onde Furien costumava estudar.‡По поручению Соррема разыщите древние таблички.|n|nПобеседуйте с Наримаром на Посту Фуриена, чтобы отправиться туда, где Фуриен занимался своими исследованиями.‡Sorrem will, dass Ihr die uralten Schrifttafeln findet.|n|nSprecht mit Narimar in Furions Posten, um dorthin zu reiten, wo Furien seine Nachforschungen betrieben hat.‡소렘이 고대 서판을 찾아 달라고 했습니다.|n|n퓨리엔이 연구했던 곳으로 가려면 퓨리엔의 거점에 있는 나리마르와 이야기하여 탈것에 타야 합니다.‡Sorrem quiere que encuentres las tablillas antiguas.|n|nHabla con Narimar en el Puesto de Furien para viajar al lugar donde Furien realizaba sus estudios.‡Sorrem quiere que encuentres las tablillas antiguas.|n|nHabla con Narimar en el Puesto de Furien para viajar al lugar donde Furien realizaba sus estudios.‡Sorrem veut que vous trouviez les Tablettes antiques.|n|nAllez parler à Narimar au Poste de Furien où il vous enverra à l’endroit où Furien faisait ses recherches.‡苏伦要你找到远古石板。|n|n跟弗瑞恩的哨站的纳里玛谈一谈，乘坐骑到弗瑞恩的研究现场去。‡索雷姆要你去找古老的石板。|n|n與弗里安崗哨的奈里瑪交談，好前往弗里安做研究的地方。',
  }
},
[14190] = {
  {
    'O prisma perfeito‡Идеальная призма‡Das perfekte Prisma‡완벽한 프리즘‡El prisma perfecto‡El prisma perfecto‡Le prisme parfait‡完美的棱镜‡完美的稜鏡',
    nil,
    'Consiga um Pingente de Cristal de um Sabotador de Talrendis, na Mina do Sopé.‡Снимите хрустальную подвеску с саботажника с заставы Талрендис в карьере у подножья горы.‡Gelangt in den Besitz eines Kristallanhängers von einem Saboteur der Talrendisspitze im Tagebau am Gebirgsfuß.‡산기슭 노천광산에 있는 탈렌디스 파괴자에게서 수정 펜던트를 획득해야 합니다.‡Consigue un colgante de cristal de un saboteador de Talrendis en la Cantera de la Ladera.‡Consigue un colgante de cristal de un saboteador de Talrendis en la Cantera de la Ladera.‡Récupérez un Pendentif en cristal sur un Saboteur de Talrendis dans la Mine à ciel ouvert du Puy-du-Pied.‡从山麓矿场的塔伦迪斯破坏者身上获得一副水晶坠饰。‡從山腳露天礦場中的塔倫迪斯破壞者那裡取得水晶墜飾。',
  }
},
[14191] = {
  {
    'Os passos de Furien‡По следам Фуриена‡Auf Furiens Spuren‡퓨리엔의 발자취‡Los pasos de Furien‡Los pasos de Furien‡Sur les traces de Furien‡弗瑞恩的脚步‡弗里安的腳步',
    nil,
    'As Tabuletas Ancestrais no Santuário de Eluna direcionaram você a visitar três das ruínas proeminentes em Sargeron.‡Следуя указаниям древних табличек в святилище Элуны, обойдите три места в Саргероне, где расположены самые примечательные руины.‡Die uralten Schrifttafeln am Schrein von Elune haben Euch den Weg zu dreien der markanten Ruinen in Sargeron gewiesen.‡엘룬의 제단에서 찾은 고대 서판의 표시에 따라 살게론에서 눈에 띄는 세 군데 폐허로 가야 합니다.‡Las tablillas antiguas del Santuario de Elune te han conducido a tres de las ruinas preeminentes de Sargeron.‡Las tablillas antiguas del Santuario de Elune te han conducido a tres de las ruinas preeminentes de Sargeron.‡Les tablettes antiques du sanctuaire d’Élune vous ont conduit jusqu\'aux trois plus grandes ruines de Sargeron.‡艾露恩圣殿的远古石板指示你去拜访萨格隆的三处知名废墟。‡伊露恩神殿的上古石板指引你前往薩格隆的三個重要廢墟。',
  }
},
[14192] = {
  {
    'O tal do cristal‡Призмолом‡Tausche Linse gegen Prisma‡프리즘 탈착‡Rompeprisma‡Rompeprisma‡Un cristal à tout prisme !‡棱镜的粉碎‡破鏡',
    nil,
    'Leve o Pingente de Cristal até o Armário de Armas no Quartel General da Mina do Sopé.‡Отнесите хрустальную подвеску в оружейный шкаф в штабе карьера у подножья горы.‡Bringt den Kristallanhänger zum Waffenschrank im Hauptquartier des Tagebaus am Gebirgsfuß.‡수정 펜던트를 산기슭 노천광산 중앙 대장간에 있는 무기함으로 가져가야 합니다.‡Lleva el colgante de cristal al armario de armas en el Centro de Mando de la Cantera de la Ladera.‡Lleva el colgante de cristal al armario de armas en el Centro de Mando de la Cantera de la Ladera.‡Apportez le Pendentif en cristal au Râtelier d’armes du quartier général de la Mine à ciel ouvert du Puy-du-Pied.‡把水晶坠饰带到山麓矿场总部的武器柜旁。‡將水晶墜飾帶去山腳露天礦場總部的武器陳列室。',
  }
},
[14193] = {
  {
    'Nada que um par de melões não dê jeito‡Пара дынь решит любую проблему‡Nichts, was ein paar Melonen nicht richten können‡먹지 마세요, 피부에 양보하세요‡Nada que no puedan arreglar un par de melones‡Nada que no puedan arreglar un par de melones‡Choper le melon‡没什么是几颗瓜解决不了的‡沒有幾粒瓜搞不定的東西',
    nil,
    'Recolha 8 Melões.‡Соберите 8 плодов дыни.‡Sammelt 8 Melonenfrüchte‡멜론 8개를 따야 합니다.‡Recoge 8 melones.‡Recoge 8 melones.‡Récoltez 8 Melons.‡收集8枚瓜果。‡取得8顆瓜果。',
  }
},
[14194] = {
  {
    'Recarnificação‡Превоплощение‡Wiederverfleischlichung‡육체 되돌리기‡Recarnificación‡Recarnificación‡Reviandication‡重塑血肉‡重新血肉化',
    nil,
    'Use o Recarnificador para depetrificar oito Mineradores do Sopé, dentro da Mina do Sopé.‡Воспользуйтесь превоплотителем, чтобы оживить окаменевших горняков в карьере у подножья горы.‡Verwendet den Wiederverfleischlicher um acht Bergfußminenarbeiter im Tagebau am Gebirgsfuß wieder zu entsteinern.‡산기슭 노천광산에서 육체재생성기로 돌이 된 산기슭 광부 8명을 되살려야 합니다.‡Utiliza el Recarnificador para despetrificar ocho mineros de ladera dentro de la Cantera de la Ladera.‡Utiliza el Recarnificador para despetrificar ocho mineros de ladera dentro de la Cantera de la Ladera.‡Utilisez le Reviandicateur pour dépétrifier 8 Mineurs du Puy-du-Pied, dans la Mine à ciel ouvert du Puy-du-Pied.‡用血肉重塑器活化8个山麓矿场里的山麓矿工。‡在山腳露天礦場裡使用血肉重塑器來解除8名山腳礦工的石化狀態。',
  }
},
[14195] = {
  {
    'Tudo fica claro‡Многое проясняется‡Ein Schleier lichtet sich‡밝혀지는 전모‡Todo se va aclarando‡Todo se va aclarando‡Tout devient plus clair‡一切都变得更加清楚了‡逐漸明朗',
    nil,
    'O diário de Furien direcionou você para encontrar as ruínas do Palácio de Eluna, que fica na região norte de Sargeron.‡Воспользовавшись подсказкой, полученной из записей Фуриена, разыщите разрушенные чертоги Элуны на севере Саргерона.‡Furiens Tagebuch hat Euch angewiesen, die Ruinen des Palastes von Elune im Norden Sargeron zu suchen.‡퓨리엔의 일지에 적힌 대로 북부 살게론에 있는 엘룬의 궁전 폐허로 가야 합니다.‡El diario de Furien te ha conducido al Palacio de Elune en ruinas en el norte de Sargeron.‡El diario de Furien te ha conducido al Palacio de Elune en ruinas en el norte de Sargeron.‡Le Journal de Furien vous met sur la piste des ruines du Palais d’Élune, au nord de Sargeron.‡弗瑞恩的日志指示你在北萨格隆找到艾露恩的宫殿。‡弗里安的日誌指引你找到了薩格隆北方的廢棄伊露恩宮殿。',
  }
},
[14196] = {
  {
    'Incendiário‡Поджигатель‡Feuerteufel‡발화점‡La tormenta de fuego‡La tormenta de fuego‡La guerre du feu‡点火人‡點火棒',
    nil,
    'Você deve criar um Vórtice Furioso derrotando 7 Discípulos de Eluna na presença da sua tempestade de fogo.|n|nCaso você perca sua Gema do Vórtice, outra poderá ser obtida da Pedra Rúnica do Vórtice Ancestral.‡Создайте бушующий вихрь, убив 7 адептов Элуны рядом с огненным штормом.|n|nЕсли вы потеряете свой самоцвет вихря, возьмите еще один у древнего рунического камня вихря.‡Ihr müsst einen tobenden Vortex erzeugen, indem Ihr 7 Anhänger von Elune mit Eurem Feuersturm vernichtet.|n|nSolltet Ihr Euren Vortexedelstein verlieren, erhaltet Ihr einen weiteren aus dem uralten Vortexrunenstein.‡소용돌이를 소환한 상태에서 엘룬의 신도를 7명 쓰러뜨리고 격렬한 소용돌이를 창조해야 합니다.|n|n소용돌이 보석을 잃어버리면 고대 소용돌이 마법석으로 돌아가 새로 얻어야 합니다.‡Crea un vórtice enfurecido al derrotar a 7 discípulos de Elune durante la tormenta de Fuego.|n|nSi pierdes la gema de vórtice, podrás conseguir otra en la piedra rúnica del vórtice antigua.‡Crea un vórtice enfurecido al derrotar a 7 discípulos de Elune durante la tormenta de Fuego.|n|nSi pierdes la gema de vórtice, podrás conseguir otra en la piedra rúnica del vórtice antigua.‡Vous devez créer un Vortex déchaîné en tuant 7 Disciples d’Élune en présence de la tempête de feu.|n|nSi vous perdez votre Gemme du vortex, vous pouvez en récupérer une autre sur l’Ancienne pierre runique du vortex.‡你要以火焰风暴的形态打败7名艾露恩的信徒，形成一个盛怒漩涡。|n|n如果你丢失了漩涡宝石，就去上古漩涡符石那里去拿另一颗。‡你要在火焰風暴存在的情況下擊敗7名伊露恩侍徒來製造1個狂虐漩渦。|n|n如果你失去了你的漩渦寶石，你可以從遠古漩渦符石上再次取得。',
  }
},
[14197] = {
  {
    'Ferro fundido (e mal pago)‡Выполнить план‡Ein zu erfüllendes Pensum‡할당량 준수‡Una cuota que cumplir‡Una cuota que cumplir‡Un quota à respecter‡达成指标‡搶達配額',
    nil,
    'Colete 20 lingotes de Ferro do Sopé na Mina do Sopé em Azshara.‡Соберите 20 слитков железа в карьере у подножья горы в Азшаре.‡Sammelt 20 Barren Gebirgsfußeisen aus dem Tagebau am Gebirgsfuß in Azshara.‡아즈샤라의 산기슭 노천광산에서 산기슭 철 주괴 20개를 모아야 합니다.‡Reúne 20 lingotes de hierro de ladera de la Cantera de la Ladera en Azshara.‡Reúne 20 lingotes de hierro de ladera de la Cantera de la Ladera en Azshara.‡Récupérez 20 lingots de Fer du Puy-du-pied dans la Mine à ciel ouvert du Puy-du-pied, en Azshara.‡从艾萨拉的山麓矿场拿20块山麓铁矿。‡在艾薩拉的山腳露天礦場收集20錠的山腳鐵礦。',
  }
},
[14198] = {
  {
    'Cavalgante da tempestade‡Всадник бушующего вихря‡Vortex der Vergeltung‡폭풍의 기수‡El jinete de la tormenta‡El jinete de la tormenta‡Le cavalier de l\'orage‡风暴上的骑士‡暴風上的騎士',
    nil,
    'Use a Gema do Vórtice Furioso no Posto do Nijel. Equanto você estiver comandando sua tempestade, mate 40 Defensores do Posto do Nijel e queime 15 Comerciantes do Posto do Nijel.|n|nCaso você perca sua Gema do Vórtice Furioso, outra poderá ser obtida da Pedra Rúnica do Vórtice Ancestral.‡Используйте силу самоцвета бушующего вихря на руинах Высоты Найджела. Призвав огненный шторм, убейте 40 защитников Высоты Найджела и сожгите 15 торговцев Высоты Найджела.|n|nЕсли вы потеряете свой самоцвет бушующего вихря, возьмите еще один у древнего рунического камня вихря.‡Setzt den Edelstein des tobenden Vortexes gegen die Ruine der Nijelspitze ein. Während ihr den Feuersturm befehligt, tötet 40 Verteidiger der Nijelspitze und verbrennt 15 Händler der Nijelspitze.|n|nSolltet Ihr Euren Vortexedelstein verlieren, erhaltet Ihr einen weiteren aus dem uralten Vortexrunenstein.‡나이젤의 야영지 폐허에서 격렬한 소용돌이 보석을 사용하십시오. 화염폭풍을 조종하여 나이젤의 야영지 수호병 40명을 처치하고 나이젤의 야영지 상인 15명을 불태우십시오.|n|n소용돌이 보석을 잃어버리면 고대 소용돌이 마법석으로 돌아가 새로 얻어야 합니다.‡Utiliza la gema de vórtice enfurecido en las ruinas de Punta de Nijel. Cuando invoques la tormenta de Fuego, mata a 40 defensores de Punta de Nijel y prende fuego a 15 mercaderes de Punta de Nijel.|n|nSi pierdes la gema de vórtice enfurecido, podrás conseguir otra en la piedra rúnica de vórtice antigua.‡Utiliza la gema de vórtice enfurecido en las ruinas de Punta de Nijel. Cuando invoques la tormenta de Fuego, mata a 40 defensores de Punta de Nijel y prende fuego a 15 mercaderes de Punta de Nijel.|n|nSi pierdes la gema de vórtice enfurecido, podrás conseguir otra en la piedra rúnica de vórtice antigua.‡Utilisez la Gemme du vortex déchaîné aux ruines de la combe de Nijel. À l’aide de votre Tempête-de-feu, tuez 40 Défenseurs de la combe de Nijel et brûlez 15 Marchands de la combe de Nijel.|n|nSi vous perdez votre Gemme du vortex déchaîné, vous pouvez en récupérer une autre sur l’Ancienne pierre runique du vortex.‡在尼耶尔前哨站使用盛怒漩涡宝石。指挥你的火焰风暴，杀死40个尼耶尔前哨站防御者，烧死15名尼耶尔前哨站商人。|n|n如果你丢失了盛怒漩涡宝石，可以去上古漩涡符石那里去拿另一颗。‡在尼耶爾前哨站廢墟使用狂虐漩渦寶石。當你控制住火焰風暴時，殺掉40名尼耶爾前哨站防衛者，並燒死15名尼耶爾前哨站商人。|n|n若是失去了狂虐漩渦寶石，你能從古老的漩渦符石那裏取得另一顆寶石。',
  }
},
[14199] = {
  {
    '‡Доказательство смерти: Черный рыцарь‡Todesbeweis: Der Schwarze Ritter‡죽음의 증거: 흑기사‡Prueba de defunción: El Caballero Negro‡Prueba de defunción: El Caballero Negro‡Preuve de la mort du Chevalier noir‡‡',
    nil,
    '‡Верховный маг Лан\'далок из Даларана просит вас принести ему осколок души Черного рыцаря.|n|nЭто задание выполняется в героическом режиме.‡Erzmagier Lan\'dalock in Dalaran möchte, dass Ihr ihm ein Seelenfragment des Schwarzen Ritters bringt.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad "Heroisch" abgeschlossen werden.‡달라란에 있는 대마법사 랜달록이 흑기사의 영혼 조각을 가져다 달라고 했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El archimago Lan\'dalock en Dalaran quiere que le lleves un fragmento de alma del Caballero Negro.|n|nEsta misión solo puede realizarse en dificultad heroica.‡El archimago Lan\'dalock en Dalaran quiere que le lleves un fragmento de alma del Caballero Negro.|n|nEsta misión solo puede realizarse en dificultad heroica.‡L\'Archimage Lan\'dalock de Dalaran veut que vous reveniez avec un Fragment de l\'âme du Chevalier noir.|n|nCette quête ne peut être accomplie qu\'en mode Héroïque.‡‡',
  }
},
[14200] = {
  {
    '‡Знак для почты - начало‡‡‡Marcador de correo de inicio‡Marcador de correo de inicio‡‡‡',
    nil,
    nil,
  }
},
[14201] = {
  {
    'Mil histórias na areia‡Тысяча историй на песке‡Tausende Geschichten im Sand‡모래 속에 묻힌 무수한 이야기‡Mil historias en la arena‡Mil historias en la arena‡Un millier d\'histoires dans le sable‡一沙一世界‡沙中的萬千傳說',
    nil,
    'Colete 5 Artefatos Recuperados nas ruínas ao redor do Lago Mennar, em Azshara.‡Соберите 5 эльфийских артефактов в руинах вокруг озера Меннар в Азшаре.‡Sammelt 5 geborgene Artefakte aus den Ruinen um den Mennarsee in Azshara.‡아즈샤라의 멘나르 호수 주변 폐허에서 복구된 유물 5개를 모아야 합니다.‡Consigue 5 artefactos recuperados en las ruinas que rodean el Lago Mennar en Azshara.‡Consigue 5 artefactos recuperados en las ruinas que rodean el Lago Mennar en Azshara.‡Rassemblez 5 Artéfacts récupérés dans les ruines qui entourent le Lac Mennar, en Azshara.‡在艾萨拉的门纳尔湖遗迹附近收集5件重见天日的神器。‡從艾薩拉的門納爾湖周邊的廢墟取得5件發掘的神器。',
  }
},
[14202] = {
  {
    'A marcha do progresso‡Исследование озера‡Inspiziert das Seeufer‡호숫가 조사‡Peritaje en el lago‡Peritaje en el lago‡La surveillance des rives du lac‡调查湖畔‡測量湖岸',
    nil,
    'Escolte uma Topógrafa Goblina até os três Equipamentos de Topógrafo ao redor do Lago Mennar, e defenda-a enquanto ela faz leituras com o equipamento. Outra Topógrafa sempre pode ser convocada com o seu Sinalizador de Topógrafos.‡Проводите гоблина-геодезиста к трем устройствам исследовательского оборудования, установленного вокруг озера Меннар, и защищайте его, пока он снимает показания. Другого геодезиста всегда можно вызвать при помощи маяка геодезиста.‡Begleitet den Goblinfeldmesser zu den drei Feldmessgeräten, die um den Mennarsee herum aufgestellt sind. Verteidigt ihn, während er die Geräte abliest. Ein weiterer Feldmesser kann stets über das Feldmesssignal herbeigerufen werden.‡고블린 측량사와 함께 멘나르 호수 주변에 설치된 조사 장비 3개를 찾은 다음, 기록을 회수할 동안 측량사를 보호해야 합니다. 측량사의 신호기를 사용하면 언제든지 다른 측량사를 호출할 수 있습니다.‡Escolta a una perita goblin hasta las tres piezas de equipo de perito que rodean el Lago Mennar y defiéndela mientras hace un registro. Siempre podrás invocar a otro perito con la baliza de perito.‡Escolta a una perita goblin hasta las tres piezas de equipo de perito que rodean el Lago Mennar y defiéndela mientras hace un registro. Siempre podrás invocar a otro perito con la baliza de perito.‡Escortez une Géomètre gobeline jusqu’aux trois appareils de l’équipement de géomètre qui entourent le Lac Mennar, et défendez-la le temps qu’elle relève les mesures. Vous pouvez toujours invoquer une autre Géomètre avec votre Balise de géomètre.‡护送一名初级地精勘测员前往门纳尔湖边的三处测量员设备处，并在抄取读数时保护她。你可以用勘测员的信标召唤另一名勘测员。‡護送哥布林勘測員前往門納爾湖附近三處的勘測裝備，並在她取得數據時保護她。你隨時可以用勘測員的信號燈召喚出另一名勘測員。',
  }
},
[14203] = {
  {
    '‡Промокший рецепт‡Durchnässtes Rezept‡물에 젖은 제조법‡Receta encharcada‡Receta encharcada‡Une recette détrempée‡被浸透的配方‡浸水的配方',
    nil,
    '‡Принесите промокший рецепт Кристи Стоктон в Даларан.‡Bringt das durchnässte Rezept zu Christi Stockton nach Dalaran.‡달라란에 있는 크리스티 스톡톤에게 물에 젖은 제조법을 가져가야 합니다.‡Llévale la receta encharcada a Christi Stockton en la Ciudad de Dalaran.‡Llévale la receta encharcada a Christi Stockton en la Ciudad de Dalaran.‡Remettez la Recette détrempée à Christi Stockton à Dalaran.‡将被浸透的配方交给达拉然城中的克莉丝蒂·斯多克顿。‡',
  }
},
[14204] = {
  {
    'Escondidos na escuridão‡Из тени‡Aus den Schatten‡어둠 속의 늑대인간‡Desde las sombras‡Desde las sombras‡Dans les ombres‡来自阴影‡從陰影中',
    nil,
    'Derrote 6 Tocaieiros Dentessangue.‡Убейте 6 скрытней из стаи Кровавых Клыков.‡Besiegt 6 Blutfanglauerer.‡붉은송곳니 매복자 6명을 처치해야 합니다.‡Derrota a 6 rondadores Colmillo de Sangre.‡Derrota a 6 rondadores Colmillo de Sangre.‡Tuez 6 Rôdeurs croc-de-sang.‡击败6只血牙潜伏者。‡擊敗6名血牙潛伏者。',
  }
},
[14209] = {
  {
    'O capô mal-assombrado‡Субстанция в двигателе‡Motorschaden‡엔진실의 오물‡Mugre en el motor‡Mugre en el motor‡Viscosité‡黏糊糊的发动机‡槽中頑垢',
    nil,
    'Inspecione o Trator do Chamorra e colete uma amostra da Ectogosma que está emperrando o motor.‡Осмотрите бульдозер Дубника и соберите образцы неизвестной субстанции, которые засорили двигатель.‡Untersucht Clubniks Planierraupe und sammelt eine Probe des Ektospritzers ein, der den Motor verklebt.‡클럽니크의 불도저를 조사한 다음, 엔진에 달라붙은 외형물질 표본을 수집해야 합니다.‡Inspecciona el bulldozer de Clubnik y recoge una muestra de la ectosalpicadura que está obstruyendo el motor.‡Inspecciona el bulldozer de Clubnik y recoge una muestra de la ectosalpicadura que está obstruyendo el motor.‡Inspectez le Buldo de Clubnik et récupérez un échantillon de l’ectoplaf qui encrasse le moteur.‡检查克拉伯尼克的推土机，收集一份粘阻引擎的外溅液样本。‡調查棒柄的推土機並收集塞住整個引擎的外濺液樣本。',
  }
},
[14212] = {
  {
    'Sacrifícios‡Готовность к жертве‡Aufopferung‡희생‡Sacrificios‡Sacrificios‡Sacrifices‡牺牲‡犧牲',
    nil,
    'Cavalgue ao lado do Lorde Darius Crowley e encurrale 30 Espreitadores Dentessangue.‡Присоединитесь к лорду Дарию Кроули и убейте 30 ловцов из стаи Кровавого Клыка.‡Reitet mit Lord Darius Crowley und treibt 30 Blutfangpirscher zusammen.‡다리우스 크롤리 경과 함께 붉은송곳니 추적자 30마리를 유인해야 합니다.‡Viaja con Lord Darius Crowley y reúne hasta 30 acechadores Colmillo de Sangre.‡Viaja con Lord Darius Crowley y reúne hasta 30 acechadores Colmillo de Sangre.‡Montez derrière le Seigneur Darius Crowley et rassemblez 30 Traqueurs croc-de-sang.‡与达利乌斯·克罗雷领主一同诱走30个血牙猎手。‡騎上坐騎，和達瑞亞斯‧克羅雷領主一起聚集30隻血牙潛獵者。',
  }
},
[14213] = {
  {
    'Dez libras de carne‡Десять фунтов плоти‡Zehn Pfund Fleisch‡살덩이 열 근‡10 kilos de carne‡10 kilos de carne‡Dix livres de chair‡十枚魔印‡十磅的血肉',
    nil,
    'Você deve coletar 10 pedaços de Carne de Sátiro dos vários sátiros em Sargeron e colocá-los no Braseiro de Eluna.‡Соберите 10 кусков плоти сатиров Саргерона и положите их на жаровню Элуны.‡Ihr müsst 10 Stücke Satyrfleisch von den zahlreichen Satyrn in Sargeron beschaffen und sie in Elunes Kohlenbecken legen.‡살게론에 있는 여러 종류의 사티로스에게서 사티로스 살덩이를 10개 모은 후 엘룬의 화로에 올려놓아야 합니다.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron y colócalos en el blandón de Elune.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron y colócalos en el blandón de Elune.‡Vous devez rassembler 10 lambeaux de Chair de satyre sur les satyres de Sargeron, et les déposer sur le Brasero d’Élune.‡你要从萨格隆邪恶的萨特身上收集10枚萨特魔印，将它们放进艾露恩的火盆。‡你要從薩格隆中各式各樣的薩特身上，收集10片薩特血肉，並把它們放在伊露恩的火盆上。',
  }
},
[14214] = {
  {
    'Mensagem para Greymane‡Послание Седогриву‡Nachricht für Graumähne‡왕에게 보내는 전갈‡Mensaje para Cringris‡Mensaje para Cringris‡Un message pour Grisetête‡给格雷迈恩的消息‡給葛雷邁恩的訊息',
    nil,
    'Fale com o Rei Genn Greymane no Distrito Militar.‡Поговорите с королем Генном Седогривом в Военном квартале.‡Sprecht mit König Graumähne im Militärviertel.‡군사 지구에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Parlez au Roi Genn Grisetête dans le Secteur Militaire.‡跟军事区的吉恩·格雷迈恩国王谈一谈。‡在軍事區和吉恩·葛雷邁恩國王談話。',
  }
},
[14215] = {
  {
    'Memórias dos Mortos‡Воспоминания мертвых‡Die Erinnerung der Toten‡망자의 기억‡Recuerdos de los muertos‡Recuerdos de los muertos‡Souvenirs des morts‡亡者的回忆‡亡者的記憶',
    nil,
    'Leve o Anel de Kalytha para a margem do Lago Mennar. Toque o Espírito de Kalytha para reviver suas memórias. Fale com os outros espíritos até descobrir o segredo do Lago Mennar.‡Отнесите перстень Калифы на берег озера Меннар. Прикоснитесь к духу Калифы, чтобы пережить ее воспоминания. Поговорите с другими духами, пока не узнаете секреты озера Меннар.‡Bringt Kalythas Ring zum Ufer des Mennarsees. Berührt den Geist von Kalytha, um ihre Erinnerungen noch einmal zu erleben. Sprecht mit den anderen Geistern, bis Ihr das Geheimnis des Mennarsees gelüftet habt.‡칼리사의 반지를 멘나르 호숫가로 가져가야 합니다. 칼리사의 영혼과 접촉하여 기억을 체험하고, 다른 영혼과 대화하여 멘나르 호수의 비밀을 조사하십시오.‡Lleva el anillo de Kalytha a la orilla del Lago Mennar. Toca el espíritu de Kalytha para rememorar su pasado. Habla con los demás espíritus hasta que desveles el secreto del Lago Mennar.‡Lleva el anillo de Kalytha a la orilla del Lago Mennar. Toca el espíritu de Kalytha para rememorar su pasado. Habla con los demás espíritus hasta que desveles el secreto del Lago Mennar.‡Apportez l’Anneau de Kalytha sur les rives du Lac Mennar. Touchez l’Esprit de Kalytha pour revivre ses souvenirs. Parlez aux autres esprits pour découvrir le secret du Lac Mennar.‡把卡莱莎的指环带往门纳尔湖岸。触碰卡莱莎的灵魂重温她的回忆，同其他灵魂交谈，了解门纳尔湖的秘密。‡將凱麗莎的戒指帶去門納爾湖的湖岸。碰觸凱麗莎的靈魂以重現她的記憶。和其他魂靈說話直到你了解門納爾湖的秘密。',
  }
},
[14216] = {
  {
    'O mistério da Pedra Sarcen‡Загадка песчаникового камня‡Das Geheimnis des Sarsensteins‡신비로운 사암 벽돌‡El misterio de la piedra sarcita‡El misterio de la piedra sarcita‡Le mystère de la pierre de Sarcen‡萨希恩之石的传说‡薩森石的神祕',
    nil,
    'Recupere a Pedra Sarcen do fundo do Lago Mennar.‡Достаньте песчаниковый камень со дна озера Меннар.‡Holt den Sarsenstein vom Grund des Mennarsees herauf.‡멘나르 호수 바닥에서 사암 벽돌을 회수해야 합니다.‡Recoge la piedra sarcita del fondo del Lago Mennar.‡Recoge la piedra sarcita del fondo del Lago Mennar.‡Récupérez la Pierre de Sarcen au fond du Lac Mennar.‡从门纳尔湖底找回萨希恩之石。‡從門納爾湖的底部取回薩森石。',
  }
},
[14217] = {
  {
    'Oferendas satíricas‡Жертвоприношение сатиров‡Satyrisches Opfer‡사티로스 제물‡Ofrendas satíricas‡Ofrendas satíricas‡Offrandes satyriques‡萨特贡品‡薩特祭品',
    nil,
    'Você deve coletar 10 pedaços de Carne de Sátiro dos vários sátiros em Sargeron e colocá-los no Braseiro de Eluna.‡Соберите 10 кусков плоти сатиров Саргерона и положите их на жаровню Элуны.‡Ihr müsst 10 Stücke Satyrfleisch von den zahlreichen Satyrn in Sargeron beschaffen und sie in Elunes Kohlenbecken legen.‡살게론에 있는 여러 종류의 사티로스에게서 사티로스 살덩이를 10개 모은 후 엘룬의 화로에 올려놓아야 합니다.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron y colócalos en el blandón de Elune.‡Recoge 10 trozos de carne de sátiro de los sátiros de Sargeron y colócalos en el blandón de Elune.‡Vous devez rassembler 10 lambeaux de Chair de satyre sur les satyres de Sargeron, et les déposer sur le Brasero d’Élune.‡你要从萨格隆邪恶的萨特身上收集10枚萨特魔印，将它们放进艾露恩的火盆。‡你要從薩格隆中各式各樣的薩特身上，收集10片薩特血肉，並把它們放在伊露恩的火盆上。',
  }
},
[14218] = {
  {
    'Sangue e cinzas‡Кровь и пепел‡Mit Blut und Asche‡피와 잿더미‡Sangre y cenizas‡Sangre y cenizas‡Par le sang et les cendres‡以鲜血与灰烬之名‡血與塵',
    nil,
    'Mate 80 Espreitadores Dentessangue usando os Canhões Rebeldes.‡Убейте 80 ловцов из стаи Кровавого Клыка с помощью пушек повстанцев.‡Tötet 80 Blutfangpirscher mit den Kanonen der Rebellen.‡반란군 대포를 이용해 붉은송곳니 추적자 80마리를 처치해야 합니다.‡Mata a 80 acechadores Colmillo de Sangre con los cañones rebeldes.‡Mata a 80 acechadores Colmillo de Sangre con los cañones rebeldes.‡Massacrez 80 Traqueurs croc-de-sang en utilisant les Canons rebelles.‡使用叛军大炮杀死80个血牙猎手。‡用反抗軍火砲殺死80隻血牙潛獵者。',
  }
},
[14219] = {
  {
    'Às armas!‡Оружие поверженного врага‡Zu den Waffen!‡최대한으로!‡¡Haz bien sin mirar a quién!‡¡Haz bien sin mirar a quién!‡Les sabres mouvants‡追根问柄！‡儘量去做!',
    nil,
    'Colete 20 Sabres de Sátiros de cavaletes de armas e dos vários sátiros da região e coloque na estátua da Criada de Eluna.‡Соберите 20 сабель сатиров – возьмите с оружейных стоек или отберите у сатиров, обитающих в этих краях, – и сложите их у подножия статуи прислужницы Элуны.‡Ihr sollt Euch 20 Satyrsäbel aus den Waffenregalen und von den Satyrn aus der Gegend besorgen. Dann legt sie auf die Statue von Elunes Dienstmaid.‡이 지역에 있는 무기 선반이나 여러 종류의 사티로스에게서 사티로스 사브르를 20자루 모은 다음, 엘룬의 시녀 석상에 올려놔야 합니다.‡Recoge 20 sables de sátiro de los expositores de armas y de varios sátiros de la zona. Después, colócalos sobre la estatua de las Fámulas de Elune.‡Recoge 20 sables de sátiro de los expositores de armas y de varios sátiros de la zona. Después, colócalos sobre la estatua de las Fámulas de Elune.‡Vous devez récupérer 20 Sabres de satyre dans les râteliers d’armes et sur les satyres de la région, puis les placer sur la statue de la Suivante d’Élune.‡你要从这一地区的武器架和邪恶的萨特身上收集20把萨特军刀，将它们贡给艾露恩的侍女像。‡你要從武器架上或區域中各式各樣的薩特身上收集20柄薩特軍刀，並把這些東西放在伊露恩女僕的雕像上。',
  }
},
[14220] = {
  {
    'Acabou‡Конец всего‡Dies ist das Ende‡상황 종료‡Este es el fin‡Este es el fin‡C\'est la fin‡结局‡這就是結局',
    nil,
    nil,
  }
},
[14221] = {
  {
    'Retroceder às vezes, render-se jamais‡Отступать, но не сдаваться‡Niemals aufgeben, nur manchmal zurückziehen‡후퇴는 있되 항복은 없다‡¿Rendirse? Nunca. ¿Retirarse? A veces‡¿Rendirse? Nunca. ¿Retirarse? A veces‡Ne jamais abandonner, mais se replier si nécessaire‡绝不投降，偶尔撤退‡永不投降，偶爾可以撤退',
    nil,
    'Fale com o Lorde Darius Crowley dentro da Catedral Aurora da Luz.‡Поговорите с лордом Дарием Краули в Соборе Рассвета.‡Sprecht mit Darius Crowley in der Kathedrale des Erwachenden Lichts.‡새벽빛 대성당 안에 있는 다리우스 크롤리 경과 대화해야 합니다.‡Habla con Lord Darius Crowley en el interior de la Catedral del Alba.‡Habla con Lord Darius Crowley en el interior de la Catedral del Alba.‡Parlez au Seigneur Darius Crowley dans la Cathédrale de l\'Aube de Lumière.‡跟圣光黎明大教堂的达利乌斯·克罗雷领主谈一谈。‡在聖光黎明大教堂裡和達瑞亞斯•克羅雷領主談話。',
  }
},
[14222] = {
  {
    'A resistência final‡Последний рубеж‡Das letzte Gefecht‡최후의 저항‡Resistencia final‡Resistencia final‡Dans les derniers retranchements‡破釜沉舟‡背水一戰',
    nil,
    'Mate 8 Espreitadores Frenéticos.‡Убейте 8 негодующих ловцов.‡Tötet 8 rasende Pirscher.‡광포한 추적자 8마리를 처치해야 합니다.‡Mata 8 acechadores demenciados.‡Mata 8 acechadores demenciados.‡Tuer 8 Traqueurs frénétiques.‡杀死8个狂暴猎手。‡殺死8隻狂亂的潛獵者。',
  }
},
[14223] = {
  {
    'Paz de espírito‡Спокойный сон капитана‡Seelenfrieden‡마음의 평화‡Paz mental‡Paz mental‡La paix de l\'âme‡心灵的平和‡心中的平靜',
    nil,
    'Sorrem, no Posto de Furien, quer que você mate Kohor.‡Убейте Кохора по просьбе Соррема с Поста Фуриена.‡Sorrem in Furions Posten will, dass Ihr Kohor tötet.‡퓨리엔의 거점에 있는 소렘이 코호르를 처치해 달라고 했습니다.‡Sorrem, del Puesto de Furien, quiere que mates a Kohor.‡Sorrem, del Puesto de Furien, quiere que mates a Kohor.‡Sorrem, du Poste de Furien, vous a demandé de tuer Kohor.‡弗瑞恩的哨站的苏伦要你去杀掉科霍。‡弗里安崗哨的索雷姆要你殺了庫霍。',
  }
},
[14225] = {
  {
    'Você vai saber quando vir‡Ты поймешь, когда увидишь‡Ihr erkennt es, wenn Ihr es seht‡백문이 불여일견‡Lo sabrás cuando lo veas‡Lo sabrás cuando lo veas‡Vous le saurez quand vous le verrez‡等你看到就明白了‡你看見就會明白',
    nil,
    'Sorrem, no Posto de Furien, quer que você encontre o Ritual de Evocação Antigo na Fortaleza Machado do Trovão.‡Найдите следы древнего ритуала призыва в крепости Громового Топора по просьбе Соррема с Поста Фуриена.‡Sorrem in Furions Posten will, dass Ihr das uralte Beschwörungsritual in Festung Donneraxt findet.‡퓨리엔의 거점에 있는 소렘이 천둥도끼 요새에서 고대 소환 의식을 찾아 달라고 했습니다.‡Sorrem, del Puesto de Furien, quiere que encuentres el ritual de invocación antiguo en la Fortaleza del Hacha de Trueno.‡Sorrem, del Puesto de Furien, quiere que encuentres el ritual de invocación antiguo en la Fortaleza del Hacha de Trueno.‡Sorrem, du Poste de Furien, veut que vous trouviez l’Ancien rituel d’invocation dans la Forteresse de Hache-Tonnerre.‡弗瑞恩的哨站的苏伦要你在雷斧堡垒里找到远古召唤仪式羊皮卷。‡弗里安崗哨的索雷姆要你到雷斧堡壘找出上古召喚儀式。',
  }
},
[14226] = {
  {
    'Vingança barata‡Проблема под ногами‡Ärger unter den Füßen‡발밑의 문제‡Pisoteando problemas‡Pisoteando problemas‡Un bon coup de savate‡脚下的麻烦‡腳下的麻煩',
    nil,
    'Use seu Assistente Arcano Pessoal para transformar 12 demônios Legashi em insetos e esmague-os.‡Воспользуйтесь личным чародейским помощником, чтобы обратить в насекомых 12 демонов, а затем прихлопнуть их.‡Verwendet Euren persönlichen arkanen Assistenten, um 12 Legashidämonen in Insekten zu verwandeln und sie zu zerquetschen.‡신비한 개인 조수를 이용하여 12마리의 레가쉬 악마를 벌레로 만든 다음 밟아버려야 합니다.‡Utiliza tu ayudante Arcano personal para convertir a 12 demonios Legashi en insectos y aplastarlos.‡Utiliza tu ayudante Arcano personal para convertir a 12 demonios Legashi en insectos y aplastarlos.‡Utilisez votre Assistant arcanique personnel pour transformer 12 Démons legashi en insectes, puis écrabouillez-les.‡使用私人奥术助手将12名雷加什恶魔变成虫子碾死。‡使用你的個人秘法助手將12隻雷加什惡魔變成昆蟲然後擠扁。',
  }
},
[14227] = {
  {
    'Juntando as cabeças‡Голова на голове‡Die Köpfe zusammenstecken‡머리를 모으면‡Juntar cabezas‡Juntar cabezas‡Le casse-tête‡把它们都放一块儿‡把他們的頭綁在一起',
    nil,
    'Sorrem, no Posto de Furien, quer que você colete 100 Crânios Alvejados da Fortaleza Machado do Trovão, bote-os no Círculo de Evocação da Lâmina Ardente e, então, mate Nazargen.‡Соберите 100 отбеленных черепов в Крепости Громового Топора, затем принесите их в круг призыва Пылающего Клинка, вызовите и убейте Назаргена.‡Sammelt 100 gebleichte Schädel aus der Festung Donneraxt, stapelt sie auf dem Beschwörungszirkel der Brennenden Klinge auf und tötet dann Nazargen.‡천둥도끼 요새에서 표백된 해골 100개를 모아 불타는 칼날단 소환 마법진에 놓은 다음 나자르겐을 처치해야 합니다.‡Recoge 100 calaveras blanquecinas en la Fortaleza del Hacha de Trueno, colócalas en el Círculo de Invocación del Filo Ardiente y después mata a Nazargen.‡Recoge 100 calaveras blanquecinas en la Fortaleza del Hacha de Trueno, colócalas en el Círculo de Invocación del Filo Ardiente y después mata a Nazargen.‡Rassemblez 100 Crânes blanchis de la Forteresse de Hache-tonnerre, déposez-les dans le Cercle d’invocation de la Larme ardente, puis tuez Nazargen.‡在雷斧堡垒收集100个褪色的徽记，把它们放在火刃召唤法阵里，然后杀死纳扎尔贡。‡去雷斧堡壘收集100個變白的顱骨，把顱骨放在燃刃召喚法陣，然後殺死納札爾干。',
  }
},
[14230] = {
  {
    'Trabalho manual‡Физический труд‡Handbucharbeit‡교본 작업‡Mano de obra‡Mano de obra‡Du travail manuel‡体力劳动‡手冊工作',
    nil,
    'Recupere o Manual do Abjurador do Acampamento Lagash.‡Верните Справочник изменника из лагеря Легаш.‡Besorgt Euch das Handbuch des Abschwörers aus dem Lager der Legashi.‡레가쉬 야영지에서 포기자의 교본을 되찾아야 합니다.‡Consigue el manual de lego en el Campamento Legashi.‡Consigue el manual de lego en el Campamento Legashi.‡Récupérez le Manuel d’abjurateur dans le Camp Legash.‡从雷加什营地拿回护法师手册。‡從雷加什營地取回防護師手冊。',
  }
},
[14231] = {
  {
    'Useless quest record‡Useless quest record‡Useless quest record‡미사용 퀘스트‡Useless quest record‡Useless quest record‡Archive de quête inutile‡Useless quest record‡沒有用的任務紀錄',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[14232] = {
  {
    'As orelhas estão queimando‡Надрать уши‡Ein Satz heiße Ohren‡불타는 귀걸이‡Las orejas de Filo Ardiente‡Las orejas de Filo Ardiente‡Les oreilles qui chauffent‡耳饰在燃烧‡耳朵在燃燒',
    nil,
    'Você deve levar 25 Orelhas da Lâmina Ardente para o Sorrem no Posto de Furien.‡Принесите 25 ушей орков Пылающего Клинка Соррему на Пост Фуриена.‡Bringt die Ohren von 25 Brennenden Klingen zu Sorrem in Furions Posten.‡불타는 칼날단 귀걸이를 25개 모아 퓨리엔의 거점에 있는 소렘에게 가져가야 합니다.‡Lleva 25 orejas de Filo Ardiente a Sorrem en el Puesto de Furien.‡Lleva 25 orejas de Filo Ardiente a Sorrem en el Puesto de Furien.‡Vous devez rapporter 25 Oreilles de la Lame ardente à Sorrem, au Poste de Furien.‡你要给弗瑞恩的哨站的苏伦收集25个火刃耳饰。‡你要將25個燃刃的耳朵帶去弗里安崗哨給索雷姆。',
  }
},
[14233] = {
  {
    'Orcs sabem escrever?‡Орки умеют писать?‡Orcs können schreiben?‡오크가 글을 쓸 수 있다고?‡¿Los orcos saben escribir?‡¿Los orcos saben escribir?‡Les orcs savent écrire ?‡兽人会写字？‡獸人會寫字?',
    nil,
    'Entregue o Diário de Campo para Espoleta Chaveforte na Costa do Naufrágio, que fica nas Ilhas Perdidas.‡Отнесите полевой дневник Хамми Кофельнагель на Берег Кораблекрушения на Затерянных островах.‡Bringt das Feldtagebuch zu Sassy Hartzang an der Schiffbruchküste auf den Verlorenen Inseln zurück.‡잃어버린 섬의 난파 해안에 있는 새시 하드렌치에게 전투 일지를 가져가야 합니다.‡Lleva el diario de campo a Sassy Malallave a Costa del Naufragio, en Las Islas Perdidas.‡Lleva el diario de campo a Sassy Malallave a Costa del Naufragio, en Las Islas Perdidas.‡Apportez le Journal de campagne à Chipie Serrelavis sur le Rivage de l’Épave, sur les Îles Perdues.‡将战地日记交给失落群岛船难海岸的莎希·硬钳。‡將戰地日誌帶去失落群島的船骸海岸給賽希·硬心。',
  }
},
[14234] = {
  {
    'O inimigo de meu inimigo‡Враг моего врага‡Der Feind meines Feindes‡내 적의 적‡El enemigo de mi enemigo‡El enemigo de mi enemigo‡L\'ennemi de mon ennemi‡敌人的敌人就是……‡敵人的敵人',
    nil,
    'Entregue o Diário de Campo para Aggra no Campo-base da Horda, que fica nas Ilhas Perdidas.‡Доставьте полевой дневник Аггре в главный лагерь Орды на Затерянных островах.‡Bringt das Feldtagebuch zu Aggra im Basislager der Horde auf den Verlorenen Inseln.‡잃어버린 섬의 호드 주둔지에 있는 아그라에게 전투 일지를 전해야 합니다.‡Entrega el diario de campo a Aggra en el Campamento Base de la Horda, en Las Islas Perdidas.‡Entrega el diario de campo a Aggra en el Campamento Base de la Horda, en Las Islas Perdidas.‡Remettez le Journal de campagne à Aggra au Camp de base de la Horde, sur les Îles Perdues.‡将战地日记交给失落群岛部落营地的阿格娜。‡將戰地日誌帶去失落群島的部落營地給阿格拉。',
  }
},
[14235] = {
  {
    'O Vale Vil‡Гибельная долина‡Das Kleine Horrortal‡악의 골짜기‡El Valle Atroz‡El Valle Atroz‡Le val Vicieux‡恶花谷‡致命叢林',
    nil,
    'Encontre Kilag Dilaceros no Vale Vil, que fica nas Ilhas Perdidas.‡Найдите Килага Жутеклыка в Гибельной долине на Затерянных островах.‡Findet Kilag Blutmaul im Kleinen Horrortal auf den Verlorenen Inseln.‡잃어버린 섬의 악의 골짜기에 있는 킬라그 고어팽을 찾아야 합니다.‡Encuentra a Kilag Mandisangre en El Valle Atroz, en Las Islas Perdidas.‡Encuentra a Kilag Mandisangre en El Valle Atroz, en Las Islas Perdidas.‡Trouvez Kilag Sangrecroc dans le Val Vicieux, sur les Îles Perdues.‡前往失落群岛的恶花谷，找到基拉格·血牙。‡在失落群島的致命叢林找到奇拉格·血牙。',
  }
},
[14236] = {
  {
    'Pela raiz‡Газонокосилка‡Unkrautvernichter‡잡초 제거기‡El segador de malas hierbas‡El segador de malas hierbas‡Un désherbant radical‡除草无双‡割草機',
    nil,
    'Use o Bate-ervas do seu Cinto Goblin de Mil-e-Uma Utilidades para ceifar 100 plantas no Vale Vil.‡С помощью газонокосилки в вашем гоблинском все-в-одном-чудо-поясе выкосите 100 растений в Гибельной долине.‡Benutzt den Unkrautvernichter Eures goblinischen Alles-in-1-zigartigen Gürtels, um 100 Pflanzen im Kleinen Horrortal niederzumähen.‡고블린 만능 허리띠 안에 있는 잡초 제거기로 악의 골짜기에서 식물 100개를 제거해야 합니다.‡Utiliza el segador de malas hierbas de tu cinturón goblin To-2-en-1 para cortar 100 plantas de El Valle Atroz.‡Utiliza el segador de malas hierbas de tu cinturón goblin To-2-en-1 para cortar 100 plantas de El Valle Atroz.‡Utilisez le Massacr\'herbes de votre gadgetoceinture gobeline pour faucher 100 plantes dans le Val Vicieux.‡使用地精百宝腰带中的杂草清理者，割掉恶花谷中的100株植物。‡用哥布林萬用腰帶裡的割草機打倒致命叢林中的100棵植物。',
  }
},
[14237] = {
  {
    'Seguindo em frente‡Движение вперед‡Vorrücken‡앞으로 나아가라‡¡Adelante!‡¡Adelante!‡Déplacement offensif‡继续前进‡向前移動',
    nil,
    'Encontre Kilag Dilaceros e os batedores no Mirante Selvagem, nas Ilhas Perdidas.‡Найдите Килага Жутеклыка и его разведчиков на Лесном наблюдательном пункте на Затерянных островах.‡Findet Kilag Blutmaul und seine Späher an der Wilden Aussicht auf den Verlorenen Inseln.‡잃어버린 섬의 황량한 전망대에서 킬라그 고어팽과 그의 정찰병을 찾아야 합니다.‡Encuentra a Kilag Mandisangre y a sus exploradores en el Mirador Salvaje, en Las Islas Perdidas.‡Encuentra a Kilag Mandisangre y a sus exploradores en el Mirador Salvaje, en Las Islas Perdidas.‡Trouvez Kilag Sangrecroc et ses éclaireurs au Surplomb Sauvage, sur les Îles Perdues.‡前往失落群岛的荒野瞭望台，找到基拉格·血牙和他的斥候。‡在失落群島的野生眺望找到奇拉格·血牙和他的斥候。',
  }
},
[14238] = {
  {
    'Infravermelho de sangue‡Инфракрасный = Инфрамертвый‡Infrarot = Infratot‡적외선으로 적에게 죽음을‡Infrarrojos = inframuertos‡Infrarrojos = inframuertos‡Infrarouge = Inframort‡死亡的红外光‡見光死',
    nil,
    'Mate 10 Assassinos da AVIN.|n|nSe alguma coisa acontecer com o seu Batedor Orc, fale novamente com Kilag e ele lhe designará outro.‡Убейте 10 убийц из ШРУ.|n|nЕсли с вашим орком-разведчиком что-то случится, вернитесь к Килагу – возможно, он выдаст вам другого напарника.‡Tötet 10 Assassinen des SI:7.|n|nWenn Eurem orcischen Späher etwas zustößt, kehrt zu Kilag zurück und schaut, ob er einen anderen Partner für Euch hat.‡SI:7 암살요원 10명을 처치해야 합니다.|n|n함께 있는 오크 정찰병에게 무슨 일이 생기면, 킬라그에게 돌아가 다른 정찰병과 협력할 수 있는지 확인하십시오.‡Mata a 10 asesinos del IV:7.|n|nSi le ocurre algo a tu explorador orco, vuelve con Kilag para hacer equipo con otro.‡Mata a 10 asesinos de la IV:7.|n|nSi le ocurre algo a tu explorador orco, vuelve con Kilag para hacer equipo con otro.‡Tuez 10 Assassins du SI:7.|n|nS\'il arrive quoi que ce soit à votre Éclaireur orc, retournez voir Kilag qui pourra peut-être vous trouver un autre équipier.‡杀死10名军情七处刺客。|n|n如果兽人斥候出了什么意外，就回去让基拉格为你配备新的队友。‡殺死10名軍情七處刺客。如果你的獸人斥候發生了意外，回去找奇拉格，看看他那邊還有沒其他斥候能和你組隊。',
  }
},
[14239] = {
  {
    'Não vá para a luz!‡Не иди к Свету!‡Geht nicht ins Licht!‡빛을 따라가지 말아요!‡¡No vayas hacia la Luz!‡¡No vayas hacia la Luz!‡N\'allez pas vers la Lumière !‡还不是见圣光的时候！‡別走進光裡!',
    nil,
    nil,
  }
},
[14240] = {
  {
    'Para o penhasco, e avante!‡К утесам‡Zu den Klippen‡절벽으로‡A los acantilados‡A los acantilados‡Vers les falaises‡前往峭壁‡前往懸崖',
    nil,
    'Fale com o Batedor Brax no caminho que segue pelos penhascos ao norte do Vale Selvagem, nas Ilhas Perdidas.‡Поговорите с разведчиком Браксом, который находится на Затерянных Островах, на тропе, ведущей к северу от Дикой лощины.‡Sprecht mit Späher Brax am Pfad entlang der Klippen nördlich der Wilden Schlucht auf den Verlorenen Inseln.‡잃어버린 섬에 있는 야만의 골짜기 북쪽 절벽으로 내려가는 길에서 정찰병 브락스와 대화해야 합니다.‡Habla con el explorador Brax en el camino hacia los acantilados, al norte de La Cañada Salvaje, en Las Islas Perdidas.‡Habla con el explorador Brax en el camino hacia los acantilados, al norte de La Cañada Salvaje, en Las Islas Perdidas.‡Parlez à l\'Éclaireur Brax sur le chemin en direction des falaises au nord du Vallon Sauvage, sur les Îles Perdues.‡沿着通往失落群岛蛮人谷北部峭壁的道路前进，跟斥候布拉克斯谈一谈。‡前往失落群島的蠻荒谷，在北方懸崖底下的路徑找到斥候布拉克斯，並與他交談。',
  }
},
[14241] = {
  {
    'Para o girocóptero!‡К гиролету!‡Auf zum Gyroschrauber!‡자이로헬기 입수!‡¡Pilotar el girocóptero!‡¡Pilotar el girocóptero!‡Au gyrocoptère !‡旋翼机！‡到螺旋槳機那裡!',
    nil,
    'Pegue as Chaves do Girocóptero.‡Добудьте ключи от гиролета.‡Besorgt Euch die Gyroschrauberschlüssel.‡자이로헬기 열쇠를 되찾아야 합니다.‡Recoge las llaves del girocóptero.‡Recoge las llaves del girocóptero.‡Récupérez les Clés du gyrocoptère.‡取得旋翼机钥匙。‡取得螺旋槳機啟動鑰匙。',
  }
},
[14242] = {
  {
    'Carga valiosa‡Драгоценный груз‡Wertvolle Fracht‡소중한 화물‡Un cargamento preciado‡Un cargamento preciado‡Une cargaison précieuse‡珍贵的货物‡珍貴的貨物',
    nil,
    'Localize a Carga Valiosa no convés inferior do navio da Aliança, o Vigília da Vingança, na costa das Ilhas Perdidas.‡Обнаружьте местонахождение драгоценного груза в трюме корабля Альянса "Караул Возмездия" у побережья Затерянных островов.‡Findet die wertvolle Fracht unter Deck des Allianzschiffs "Sog der Vergeltung" am Strand der Verlorenen Inseln.‡잃어버린 섬 해안가에 있는 얼라이언스 함선인 복수의 흔적호 갑판 아래에 있는 소중한 화물을 찾아야 합니다.‡Localiza el cargamento preciado bajo la cubierta del barco de la Alianza, el Rastro Venganza, frente a la orilla de Las Islas Perdidas.‡Localiza el cargamento preciado bajo la cubierta del barco de la Alianza, el Rastro Venganza, frente a la orilla de Las Islas Perdidas.‡Trouvez la précieuse cargaison sous le pont du vaisseau de l\'Alliance, le Vogue-Vengeance, au large des Îles Perdues.‡登上停泊在失落群岛岸边的联盟战舰复仇觉醒号，在甲板下层寻找珍贵的货物。‡在失落群島海岸線外的聯盟船艦「復仇之醒」的甲板下層找到珍貴的貨物。',
  }
},
[14243] = {
  {
    'A vingança do Chefe Guerreiro‡Возмездие вождя‡Die Rache des Kriegshäuptlings‡대족장의 복수‡La venganza del Jefe de Guerra‡La venganza del Jefe de Guerra‡La vengeance du chef de guerre‡酋长的复仇‡大酋長的復仇',
    nil,
    'Use os poderes do Ciclone dos Elementos para matar 50 Marinheiros da Aliança.|n|nQuando a tarefa for cumprida, você será levado até o Mirante Selvagem.‡С помощью вихря стихий убейте 50 матросов Альянса.|n|nКогда это будет сделано, вас перенесут к Лесному наблюдательному пункту.‡Benutzt die Macht des Zyklons der Elemente, um 50 Matrosen der Allianz zu töten.|n|nSobald Ihr Eure Aufgabe erledigt habt, werdet Ihr zur Wilden Aussicht geflogen.‡정령의 소용돌이를 이용하여 얼라이언스 선원 50명을 처치해야 합니다.|n|n일을 마치면, 황량한 전망대로 날아갑니다.‡Utiliza los poderes del ciclón de los elementos para matar a 50 marineros de la Alianza.|n|nCuando hayas terminado, serás trasladado al Mirador Salvaje.‡Utiliza los poderes del ciclón de los elementos para matar a 50 marineros de la Alianza.|n|nCuando hayas terminado, serás trasladado al Mirador Salvaje.‡Utilisez les pouvoirs du Cyclone des éléments pour tuer 50 Marins de l\'Alliance.|n|nUne fois que ce sera fait, vous serez renvoyé sur le Surplomb Sauvage.‡使用元素风暴的力量杀死50名水手。|n|n完成任务后，飓风会将你送往荒野瞭望台的。‡使用元素颶風的力量殺死50名聯盟水手。|n|n完成之後，你會被送到野生眺望。',
  }
},
[14244] = {
  {
    'Para o alto e avante!‡Вперед и вверх!‡Auf, auf und davon!‡높이 높이 날아라!‡Preparados, listos, ¡fuego!‡Preparados, listos, ¡fuego!‡Les gobelins s\'envolent vers d\'autres cieux‡爬升，爬升，火箭分离！‡衝，衝，衝向蒼穹!',
    nil,
    'Sobreviva ao tiro de Estilingue de Foguete no Estreito Hostil.‡Постарайтесь не погибнуть во время перелета через Зловещий пролив на ракете, запущенной из ракетной пращи.‡Überlebt den Schuss mit der Raketenschleuder über die Bedrängnis.‡혈투의 해협을 가로지르는 로켓 투척기 발사에서 살아남아야 합니다.‡Sobrevive al viaje del lanzador de cohetes a través del Estrecho Temible.‡Sobrevive al viaje del lanzador de cohetes a través del Estrecho Temible.‡Survivez au tir de la Fronde à fusées au-dessus de la Mauvaise passe.‡使用火箭弹射器将自己发射到险峻海峡的对岸。‡在搭乘火箭穿越恐怖海峽這段旅程中存活下來。',
  }
},
[14245] = {
  {
    'A Cidade Portátil‡Городок-из-табакерки‡Die Stadt in der Kiste‡상자 마을‡La Ciudad de Bolsillo‡La Ciudad de Bolsillo‡C\'est une Ville-en-Boîte‡胶囊镇‡盒中鎮',
    nil,
    'Suba ao topo da montanha de explosivos e use o Detonador da Cidade Portátil.‡Заберитесь на гору взрывчатки и нажмите на поршень Городка-из-табакерки.‡Klettert auf den Sprengstoffberg und benutzt den Auslöser von Instastadt.‡산더미 같은 폭발물 꼭대기로 올라가 상자 마을 막대를 사용해야 합니다.‡Trepa hasta la cima de la montaña de explosivos y aprieta el émbolo de la Ciudad de Bolsillo.‡Trepa hasta la cima de la montaña de explosivos y aprieta el émbolo de la Ciudad de Bolsillo.‡Monter au sommet de la montagne d\'explosifs et utiliser la Ville-en-Boîte.‡爬到炸药堆上，使用胶囊镇活塞。‡爬到炸藥堆的頂端並使用盒中鎮引爆開關。',
  }
},
[14246] = {
  {
    'Adoção antecipada‡Спасение перепелятников‡Zwangsadoption‡조기 입양‡Adopción prematura‡Adopción prematura‡Une adoption précoce‡提前领养‡早期收養',
    nil,
    'Coloque 3 Ovos de Rapineiro nos Ninhos de Rapineiros e proteja-os até que eles sejam levados.‡Разложите 3 яйца перепелятников по гнездам и защищайте яйца от хищников, пока птицы их не увидят и не заберут.‡Legt 3 Sturzflieger-Eier in die Nester von Sturzfliegern und sie beschützt, bis sie eingesammelt wurden.‡검독수리 둥지에 검독수리 알을 3개 넣은 다음 어미새가 가져갈 때까지 지켜야 합니다.‡Coloca 3 huevos de aguilón en los nidos de aguilón y protégelos hasta que los recojan.‡Coloca 3 huevos de aguilón en los nidos de aguilón y protégelos hasta que los recojan.‡Placez 3 Œufs de rapace dans des Nids de rapace et protégez-les jusqu’à ce qu’ils soient en lieu sûr.‡将3枚猛鹫的蛋放在猛鹫之巢里，在它们被带走之前保护好。‡放3顆猛鷲蛋到猛鷲巢裡，然後保護這些蛋，直到蛋被取走。',
  }
},
[14247] = {
  {
    'Terras teimosas‡Упрямые земли‡Raues Land‡고집스러운 땅‡Tierras testarudas‡Tierras testarudas‡Terres rebelles‡固执的大地‡執拗的土地',
    nil,
    'Thunk, na Morada de Thunk, quer que você encontre o Afloramento Inatural.‡По поручению Тунка из Обители Тунка отыщите необычный фрагмент ландшафта.‡Thunk in Thunks Heimstatt will, dass Ihr die unnatürliche Felszunge findet.‡성크의 거처에 있는 성크가 대지에 부자연스러운 무엇인가가 없는지 알아봐 달라고 했습니다.‡Thunk, de la Morada de Thunk, quiere que encuentres el afloramiento antinatural.‡Thunk, de la Morada de Thunk, quiere que encuentres el afloramiento antinatural.‡Thunk, de la Demeure de Thunk, veut que vous trouviez l’Affleurement anormal.‡桑克的住所的桑克要你找到不自然的岩石。‡在桑克的居所的桑克要你找出不自然的露岩。',
  }
},
[14248] = {
  {
    'Precisa-se‡Требуется помощь!‡Hilfe gesucht‡도움 급구‡¡Socorro!‡¡Socorro!‡Besoin d\'aide‡急需帮助‡需要幫忙',
    nil,
    'Fale com o Encarregado Molhavela na entrada da Caverna Jakamita, que fica nas Ilhas Perdidas.‡Поговорите со штейгером Промокахом у входа в Каджа\'митовую пещеру на Затерянных островах.‡Sprecht mit Vorarbeiter Feuchtlunte außerhalb der Kaja\'mithöhle auf den Verlorenen Inseln.‡잃어버린 섬의 카자마이트 동굴 밖에 있는 현장감독 댐윅과 대화해야 합니다.‡Habla con el supervisor Mechamojada en el exterior de la Caverna de Kaja\'mita, en Las Islas Perdidas.‡Habla con el supervisor Mechamojada en el exterior de la Caverna de Kaja\'mita, en Las Islas Perdidas.‡Parlez au Contremaître Méchumide à l\'extérieur de la Caverne de kaja\'mite sur les îles Perdues.‡跟失落群岛卡亚矿洞外的工头戴姆维克谈一谈。‡在失落群島的卡迦邁洞窟外面和工頭唐威克說話。',
  }
},
[14249] = {
  {
    'Tosa pra mim, tosa!‡Приодеть Вилла‡Federgewichtig‡깃털 수집‡El deseo de esquilar‡El deseo de esquilar‡À la mode de chez nous‡剪羽毛‡除毛之心',
    nil,
    'Obtenha 80 Penas Imaculadas de Cabeça-de-trovão dos Hipogrifos perto das Ruínas de Nordressa.‡Добудьте 80 нетронутых перьев громоголова у гиппогрифов возле руин Нордрессы.‡Besorgt 80 makellose Donnerkopffedern von den Hippogryhpen in der Nähe der Ruinen von Nordressa.‡놀드렛사의 폐허 근처에 있는 히포그리프에서 온전한 천둥뿔 히포그리프 깃털 80개를 획득해야 합니다.‡Consigue 80 plumas de tronatesta prístinas de los hipogrifos que hay cerca de las Ruinas de Nordessa.‡Consigue 80 plumas de tronatesta prístinas de los hipogrifos que hay cerca de las Ruinas de Nordessa.‡Récupérez 80 Plumes de Tête-tonnerre en parfait état sur les Hippogriffes près des Ruines de Nordressa.‡从诺德雷萨废墟附近的角鹰兽身上采集80根完整的雷首角鹰兽羽毛。‡從諾德雷沙廢墟附近的角鷹獸那裏收集80份質樸的雷首羽毛。',
  }
},
[14250] = {
  {
    'Tirando uma casquinha‡Возобновляемый ресурс‡Erneuerbare Ressourcen‡쓰고 또 쓰고‡Fuente renovable‡Fuente renovable‡Ressource renouvelable‡可再生资源‡再生性資源',
    nil,
    'Use a Carga Arcana para recuperar 5 lascas de Basalto Vivo do Balboa, perto das Ruínas de Nordressa.‡Воспользуйтесь чародейским зарядом, чтобы получить 5 порций оживленного базальта от Бальбоа в руинах Нордрессы.‡Verwendet die Arkane Aufladung, um 5 Stück belebtes Basalt von Balboa in der Nähe der Ruinen von Nordressa zu erlangen.‡놀드렛사의 폐허 근처에 있는 발보아에게 비전 폭발물을 사용하여 생기 있는 현무암 5덩어리를 모아야 합니다.‡Utiliza las cargas Arcanas para recoger 5 basaltos animados de Balboa cerca de las Ruinas de Nordessa.‡Utiliza las cargas arcanas para recoger 5 basaltos animados de Balboa cerca de las Ruinas de Nordessa.‡Utilisez la Charge arcanique pour récupérer 5 morceaux de Basalte animé de Balboa, près des Ruines de Nordressa.‡从诺德雷萨废墟的巴伯亚身上用奥术炸药收集5块活体玄武岩。‡使用秘法炸藥從諾德雷沙廢墟附近的巴爾玻亞那裡取得5份活化玄武岩。',
  }
},
[14251] = {
  {
    'Novo começo‡Новое начало‡Noch mal von vorne‡새로운 시작‡Un nuevo comienzo‡Un nuevo comienzo‡Un nouveau commencement‡新的开始‡新的開始',
    nil,
    'Colete 15 Aguilhões de Escorpião.‡Соберите 15 жал скорпиона.‡Sammelt 15 Skorpionenstachel.‡전갈 꼬리를 15개 모아야 합니다.‡Consigue 15 aguijoneros de escorpión.‡Consigue 15 aguijoneros de escorpión.‡Obtenez 15 Dards de scorpion.‡收集15根蝎刺。‡收集15根蠍子刺。',
  }
},
[14252] = {
  {
    'Bom dinheiro por rabo ruim‡Много золота за плохие хвосты‡Gutes Gold für schlechte Schwänze‡해로운 꼬리로 이로운 골드 벌기‡Cuanto más viejo más rico‡Cuanto más viejo más rico‡Le basilic est une espèce sonnante et trébuchante‡货次价高‡黃金換爛尾巴',
    nil,
    'Encontre 15 Rabos de Basilisco Envelhecidos‡Соберите 15 хвостов старых василисков.‡Findet 15 alte Basiliskenschwänze.‡늙은 바실리스크 꼬리 15개를 찾아야 합니다.‡Encuentra 15 colas de basilisco viejas.‡Encuentra 15 colas de basilisco viejas.‡Trouvez 15 Queues de basilic âgé.‡收集15条陈年蜥蜴尾。‡找到15條老邁的石化蜥蜴尾巴。',
  }
},
[14253] = {
  {
    'Emplume minhas flechas!‡Оперите меня!‡Befiederung‡깃털을 가져와!‡Plumas para empenachar‡Plumas para empenachar‡Si votre empennage se rapporte à votre plumage…‡给我带些羽毛来！‡幫我裝飾些羽毛!',
    nil,
    'Junte 25 Penas de Pavor Rapineiro.‡Соберите 25 перьев жуткого перепелятника.‡Sammelt 25 Federn von Schreckenssturzfliegern.‡공포의 독수리 깃털 25개를 모아야 합니다.‡Recoge 25 plumas de aguilón aterrador.‡Recoge 25 plumas de aguilón aterrador.‡Collectez 25 Plumes de rapace redoutable.‡收集25根恐怖飞扑者之羽。‡收集25根恐怖猛鷲羽毛。',
  }
},
[14254] = {
  {
    'Metal pesado‡Тяжелый металл‡Schwermetall‡묵직한 금속‡Heavy Metal‡Heavy Metal‡Le 116ème élément‡重金属‡重金屬',
    nil,
    'Você deve coletar 7 pedaços do Elemento 116 e levá-los para o Bizby na Caravana do Bizby.‡Соберите 7 образцов элемента 116 и отнесите их Бизби из каравана Бизби.‡Ihr sollt 7 Stück Element 116 einsammeln und sie zu Bizby in Bizbys Karawane bringen.‡원료 116을 7조각 모아 비즈비의 짐마차에 있는 비즈비에게 가져가야 합니다.‡Recoge 7 trozos de elemento 116 y llévaselos a Bizby a la Caravana de Bizby.‡Recoge 7 trozos de elemento 116 y llévaselos a Bizby a la Caravana de Bizby.‡Vous devez trouver 7 morceaux d’Élément 116 et les rapporter à Bizby, à la Caravane de Bizby.‡你要收集7份116号元素，将它们带给比兹比车队的比兹比。‡你得要收集7片116號元素，並把它們帶去畢茲比的車隊給畢茲比。',
  }
},
[14255] = {
  {
    'Ethel Rethor‡Этель-Ретор‡Ethel Rethor‡에텔 레소르‡Ethel Rethor‡Ethel Rethor‡Ethel Rethor‡艾瑟雷索‡艾瑟雷索',
    nil,
    'Cerelia, no Posto de Furien, quer que você fale com Korrah em Ethel Rethor.‡По поручению Серелии с Поста Фуриена отправляйтесь к Корре в Этель-Ретор.‡Cerelia in Furions Posten will, dass Ihr mit Korrah in Ethel Rethor sprecht.‡퓨리엔의 거점에 있는 세렐리아가 에텔 레소르에 있는 코라와 대화해 달라고 했습니다.‡Cerelia, del Puesto de Furien, quiere que hables con Korrah en Ethel Rethor.‡Cerelia, del Puesto de Furien, quiere que hables con Korrah en Ethel Rethor.‡Cérélia, du Poste de Furien, vous a demandé d’aller parler à Korrah, à Ethel Rethor.‡弗瑞恩的哨站的瑟蕾莉亚要你去艾瑟雷索跟库拉谈一谈。‡位於弗里安崗哨的賽蕾莉亞希望你到艾瑟雷索和柯拉談話。',
  }
},
[14256] = {
  {
    'A ameaça emergente‡Угроза с моря‡Die wachsende Bedrohung‡다가오는 위협‡La amenaza emergente‡La amenaza emergente‡La menace venue de la mer‡新的威胁‡新的威脅',
    nil,
    'Korrah quer que você fale com ela quando estiver pronto para ver a ameaça naga.‡Поговорите с Коррой и она вам покажет, чем опасны наги.‡Korrah will, dass Ihr mit ihr sprecht, wenn Ihr bereit seid, die Bedrohung durch die Naga näher zu besehen.‡나가의 위협에 대해 알아볼 준비가 되면 코라와 대화해야 합니다.‡Korrah quiere que vuelvas a hablar con ella cuando estés listo para aprender sobre la amenaza de los nagas.‡Korrah quiere que vuelvas a hablar con ella cuando estés listo para aprender sobre la amenaza de los nagas.‡Korrah veut que vous alliez lui parler quand vous serez prêt à découvrir la menace naga.‡跟库拉谈一谈，她将为你展示纳迦的威胁。‡柯拉要你在準備好觀看納迦的威脅時，再和她交談。',
  }
},
[14257] = {
  {
    'Massacre das Sibilâmina‡Охота на нагов‡Zackenkämme getötet‡뱀갈퀴 일족 학살‡La matanza Filozante‡La matanza Filozante‡Ondulames laminés‡滑刃之劫‡屠殺滑刃',
    nil,
    'Colete 10 Ossos das Nagas Sibilâmina, 30 Escamas das Feitiçeiras Sibilâmina e 4 Barbatanas dos Guerreiros Sibilâmina.‡Соберите 10 костей наг, 30 образцов чешуи колдуний и 4 гребня воинов из клана Скользящего Плавника.‡Sammelt 10 Zackenkammknochen von Naga der Zackenkämme, 30 Zackenkammschuppen von Zauberinnen der Zackenkämme und 4 Zackenkammflossen von Kriegern der Zackenkämme.‡뱀갈퀴 나가에게서 뱀갈퀴 뼈를 10개, 뱀갈퀴 여마법사에게서 뱀갈퀴 비늘을 30개, 뱀갈퀴 전사에게서 뱀갈퀴 지느러미를 4개 모아야 합니다.‡Recoge 10 huesos de Filozante de los nagas Filozante, 30 escamas de Filozante de las hechiceras Filozante y 4 aletas de Filozante de los guerreros Filozante.‡Recoge 10 huesos de Filozante de los nagas Filozante, 30 escamas de Filozante de las hechiceras Filozante y 4 aletas de Filozante de los guerreros Filozante.‡Collectez 10 Ossements ondulame sur les Nagas ondulame, 30 Écailles ondulame sur les Sorcières ondulame, et 4 Nageoires ondulame sur les Guerriers ondulame.‡从滑刃纳迦身上收集10根滑刃之骨，从滑刃巫师身上收集30片滑刃鳞片，从滑刃战士身上收集4扇滑刃之鳍。‡從滑刃納迦身上收集10根滑刃骸骨、從滑刃巫女身上收集30片滑刃鱗片、以及從滑刃戰士身上收集4片滑刃魚鰭。',
  }
},
[14258] = {
  {
    'Morteiro certeiro‡Обстрел‡Mörsermunition‡포격 지원‡Haz señales al mortero‡Haz señales al mortero‡À bas les nagas !‡炮轰纳迦‡定點轟擊',
    nil,
    'Colete 5 Obuses de Morteiro Goblínico no Laboratório Secreto, em Azshara.‡Принесите 5 снарядов для гоблинской мортиры из секретной лаборатории в Азшаре.‡Holt 5 Goblinmörsergranaten aus dem Geheimlaborkomplex in Azshara.‡아즈샤라의 비밀 실험실 건물에서 고블린 박격포탄 5개를 구해야 합니다.‡Recoge 5 morteros goblin de El Laboratorio Secreto en Azshara.‡Recoge 5 morteros goblin de El Laboratorio Secreto en Azshara.‡Récupérez 5 Obus de mortier gobelins dans le Laboratoire secret, en Azshara.‡从艾萨拉的秘密实验室收集5颗地精迫击炮炮弹。‡到位於艾薩拉的秘密實驗室裡收集5個哥布林迫擊砲彈。',
  }
},
[14259] = {
  {
    '‡Больше, больше снарядов!‡Mehr Mörser, mehr!‡‡¡Más y más morteros!‡‡Des mortiers, encore des mortiers !‡‡',
    nil,
    '‡Принесите 5 снарядов для гоблинской мортиры из секретной лаборатории в Азшаре.‡Sammelt 5 Goblinmörsergranaten aus dem Geheimlabor in Azshara.‡아즈샤라의 비밀 실험실 건물에서 고블린 박격포탄 5개를 구해야 합니다.‡Recoge 5 morteros goblin de El Laboratorio Secreto en Azshara.‡‡Récupérez 5 Obus de mortier gobelins dans le Laboratoire secret, en Azshara.‡从艾萨拉的秘密实验室收集5颗地精迫击炮炮弹。‡',
  }
},
[14260] = {
  {
    'Indo fundo‡Под маскировкой‡In die Tiefe gehen‡물속으로‡El disfraz marino‡El disfraz marino‡Gloups ! Je suis un naga !‡深入敌后‡進入深處',
    nil,
    'Use o Patuá Sibilâmina.‡Используйте оберег Скользящего Плавника.‡Benutzt den Zackenkammglücksbringer‡뱀갈퀴 부적을 사용해야 합니다.‡Usa el talismán de Filozante.‡Usa el talismán de Filozante.‡Utilisez le Charme ondulame.‡使用滑刃之魅。‡使用滑刃符咒。',
  }
},
[14261] = {
  {
    'Dando um gelo‡Ледяной холод‡Eiskalt‡차갑게 얼려라‡Frío polar‡Frío polar‡Un froid glacial‡冰冰冷‡冰鎮龍群',
    nil,
    'Use o Criomático 16 para congelar e matar 8 Dracos Zibelinos.‡Воспользуйтесь Криохладом 16, чтобы убить 8 агатовых драконов.‡Verwendet den Kryomat 16, um 8 finstere Drachen einzufrieren und zu töten.‡자동냉동기 16으로 칠흑 비룡 8마리를 얼려서 처치해야 합니다.‡Utiliza la Criomática 16 para congelar y matar a 8 dracos sable.‡Utiliza la Criomática 16 para congelar y matar a 8 dracos sable.‡Utilisez le Cryomatic 16 pour congeler et tuer 8 Drakes sable.‡使用低温装置16号冷冻并杀死8条漆黑幼龙。‡使用低溫16冰凍並殺死8隻黑角飛龍。',
  }
},
[14262] = {
  {
    'Como peixes fora d\'água‡Выпотрошить рыбку‡Wie man einen Fisch ausnimmt‡나가의 위협‡Limpiar pescado‡Limpiar pescado‡Noyer le poisson‡刮鳞破肠‡剖開魚腹',
    nil,
    'Mate 6 Iraliscas Furiantes e 6 Arautos do Mar Iralisca.‡Убейте 6 сынов штормов из клана Бича Злобы и 6 зовущих море из клана Бича Злобы.‡Tötet 6 Sturmwute der Grollflossen und 6 Seerufer der Grollflossen.‡원한꼬리 폭풍격노병 6마리와 원한꼬리 바다소환사 6마리를 처치해야 합니다.‡Mata a 6 furiatormentas y a 6 clamamares Látigo de Ira.‡Mata a 6 furiatormentas y a 6 clamamares Látigo de Ira.‡Tuez 6 Furies des tempêtes fouette-bile et 6 Mande-mers fouette-bile.‡杀掉6只恶鞭怒雷武士和6只恶鞭唤海者。‡殺死6名惡鞭風暴之怒和6名惡鞭喚海者。',
  }
},
[14263] = {
  {
    'Vai catar no mato‡Расход тимьяна‡Fidele Kräuter‡흐드러진 백리향‡Pérdida de tomillo‡Pérdida de tomillo‡Perte de thym‡浪费百里香‡百里香荒野',
    nil,
    'Colete 8 feixes de Tomilho Iraviva perto das Ruínas de Nordressa.‡Соберите 8 пучков тимьяна живого гнева возле руин Нордрессы.‡Sammelt 8 Bündel Lebendigen Zornthymian in der Nähe der Ruinen von Nordressa.‡놀드렛사의 폐허 주변에서 살아있는 분노의 백리향 8다발을 모아야 합니다.‡Recoge 8 ramas de tomillo ira viviente cerca de las Ruinas de Nordressa.‡Recoge 8 ramas de tomillo ira viviente cerca de las Ruinas de Nordressa.‡Récupérez 8 bouquets de Thym de l\'ire vivante près des Ruines de Nordressa.‡在诺德雷萨废墟附近采8束生命盛怒百里香。‡在諾德雷沙廢墟附近收集8份生命忿怒百里香。',
  }
},
[14264] = {
  {
    'Mais molhado do que água‡Морской бой‡Nasser als Nass‡눅눅하고 축축한 일‡Más húmedo que mojado‡Más húmedo que mojado‡L’eau, ça mouille‡潮上加湿‡濕到家了',
    nil,
    'Derrote 5 Servos de Neptulon. (Você precisa estar sob a forma de naga quando derrotá-los.)|n|nSe você perder o seu Tridente Sibilâmina, fale com Valishj.|n|nSe você perder seu Patuá Sibilâmina, fale com Korrah em Ethel Rethor.‡Убейте 5 слуг Нептулона. (Для того чтобы с ними сразиться, вы должны быть в обличье наги.)|n|nЕсли вы потеряете трезубец клана Скользящего Плавника, возвращайтесь к Валишж.|n|nЕсли вы потеряете оберег клана Скользящего Плавника, возвращайтесь к Корре в Этель-Ретор.‡Besiegt 5 Diener von Neptulon. (Ihr müsst in Nagagestalt sein, während Ihr sie bekämpft.)|n|nSolltet Ihr Euren Dreizack der Zackenkämme verlieren, sprecht mit Valishj.|n|nWenn Ihr Euren Zackenkammglücksbringer verliert, sprecht mit Korrah in Ethel Rethor.‡넵튤론의 하수인 5마리를 처치해야 합니다. 물정령과 싸우려면 나가로 변신해야 합니다.|n|n뱀갈퀴 삼지창을 잃어버리면 발리쉬와 이야기하여 다시 받으십시오.|n|n뱀갈퀴 부적을 잃어버리면 에텔 레소르에 있는 코라와 대화해야 합니다.‡Derrota a 5 sirvientes de Neptulon. (Deberás adoptar la apariencia de naga cuando los derrotes).|n|nSi pierdes el tridente de Filozante, habla con Valishj.|n|nSi pierdes el talismán de Filozante, habla con Korrah en Ethel Rethor.‡Derrota a 5 sirvientes de Neptulon. (Deberás adoptar la apariencia de naga cuando los derrotes).|n|nSi pierdes el tridente de Filozante, habla con Valishj.|n|nSi pierdes el talismán de Filozante, habla con Korrah en Ethel Rethor.‡Anéantissez 5 Serviteurs de Neptulon. (Vous devez adopter la forme de naga pour les tuer).|n|nSi vous perdez votre Trident ondulame, adressez-vous à Valishj.|n|nSi vous perdez votre Charme ondulame, adressez-vous à Korrah, à Ethel Rethor.‡击败5名耐普图隆的仆从。（你必须以纳迦形态打败他们。）|n|n如果你丢失了滑刃三叉戟，就和瓦丽丝琪谈谈。|n|n如果你丢失了滑刃之魅，就和艾瑟雷索的库拉谈谈。‡擊敗5個奈普圖隆之僕。(你必須在處於納迦型態時打敗他們。)|n|n如果你失去了滑刃三叉戟，告訴瓦黎許。|n|n如果你失去了滑刃符咒，告訴艾瑟雷索的柯拉。',
  }
},
[14265] = {
  {
    'Instrutor particular‡Твой наставник‡Euer Lehrmeister‡교관 찾기‡Tu instructor‡Tu instructor‡Votre instructeur‡你的导师‡你的指導者',
    nil,
    'Fale com o Sargento Cleese no Distrito Militar.‡Поговорите с сержантом Клизом в Военном квартале.‡Redet mit Unteroffizier Cleese im Militärviertel.‡군사 지구에 있는 하사관 클리스와 대화해야 합니다.‡Habla con el sargento Cleese en el Distrito Militar.‡Habla con el sargento Cleese en el Distrito Militar.‡Parlez au Sergent Cleese dans le Secteur Militaire.‡跟军事区的克利希中士谈一谈。‡在軍事區裡和克里斯中士說話。',
  }
},
[14266] = {
  {
    'Investida‡Рывок‡Sturmangriff‡돌진‡Cargar‡Cargar‡À la charge !‡冲锋‡衝鋒',
    nil,
    'Fale com o Sargento Cleese para treinar a Investida. Em seguida, pratique a nova técnica em um Worgen Dentessangue.‡Поговорите с сержантом Клизом и выучите способность "Рывок". Затем используйте ее на воргене из стаи Кровавых Клыков.‡Sprecht mit Unteroffizier Cleese und erlernt \'Sturmangriff\'. Übt anschließend \'Sturmangriff\' gegen einen Blutfangworgen.‡하사관 클리스와 대화해 돌진을 배운 후 붉은송곳니 늑대인간에게 시험해봐야 합니다.‡Habla con el sargento Cleese y aprende Cargar. Practica Cargar contra un huargen Colmillo de Sangre.‡Habla con el sargento Cleese y aprende Cargar. Practica Cargar contra un huargen Colmillo de Sangre.‡Parlez au Sergent Cleese qui vous enseignera la Charge. Ensuite, exercez-vous à utiliser la Charge contre un Worgen croc-de-sang.‡跟克里希中士谈一谈，学习冲锋。然后对一个血牙狼人使用冲锋。‡和克里斯中士說話並學得衝鋒。對一名血牙狼人練習使用衝鋒。',
  }
},
[14267] = {
  {
    'Investigação do altar‡Исследование святилища наг‡Die Untersuchung des Meeresschreins‡바다 제단 조사‡Investigando el santuario del mar‡Investigando el santuario del mar‡Enquête au sanctuaire de la mer‡调查海洋祭坛‡調查海洋神殿',
    nil,
    'Investigue o altar Naga para Torg Smagadois.‡Исследуйте святилище наг для Торга Двудроба.‡Untersucht den Schrein der Naga für Torg Zweimalmer.‡토르그 투크러쉬가 나가 제단을 조사해 달라고 했습니다.‡Investiga el santuario naga para Torg Doblegolpe.‡Investiga el santuario naga para Torg Doblegolpe.‡Inspectez le Sanctuaire naga pour Torg Broie-double.‡为托格·图卡斯调查纳迦祭坛。‡為托爾格·雙碾調查納迦神殿。',
  }
},
[14268] = {
  {
    'Impacto profundo‡Глубокая тайна‡Wasserzeichen‡해저 탐사‡Impacto profundo‡Impacto profundo‡L’impact‡深度撞击‡深入挖掘',
    nil,
    'A Sacerdotisa Valishj quer que você encontre os Entalhes Antigos de Neptulon.‡По поручению жрицы Валишж разыщите древнюю гравировку Нептулона.‡Priesterin Valishj will, dass Ihr die uralten Neptulon-Gravuren findet.‡여사제 발리쉬가 넵튤론의 고대 새김판을 찾으라고 했습니다.‡La sacerdotisa Valishj quiere que encuentres los grabados de Neptulon antiguos.‡La sacerdotisa Valishj quiere que encuentres los grabados de Neptulon antiguos.‡La prêtresse Valishj vous a demandé de trouver les Gravures antiques de Neptulon.‡女祭司瓦丽丝琪要你找到耐普图隆的石板。‡女祭司瓦黎許要你去找出奈普圖隆的上古刻紋。',
  }
},
[14269] = {
  {
    'Alguém quer falar com você‡Кто-то ищет тебя‡Jemand sucht nach Euch‡만나야 할 사람‡Alguien te busca‡Alguien te busca‡Quelqu\'un vous cherche‡有人在找你‡有人找你',
    nil,
    'Fale com Loren, a Receptora, no Distrito Militar.‡Поговорите с Лорен Укрывательницей в Военном квартале.‡Sprecht mit Loren der Hehlerin im Militärviertel.‡군사 지구에 있는 장물아비 로렌과 대화해야 합니다.‡Habla con Loren la Perista en el Distrito Militar.‡Habla con Loren la Perista en el Distrito Militar.‡Parlez à Loren la Receleuse dans le Secteur Militaire.‡跟军事区的侠盗萝伦谈一谈。‡在軍事區裡和洛倫說話。',
  }
},
[14270] = {
  {
    'O fragmento do monolito‡Осколок краеугольного камня‡Die Schlüsselsteinscherbe‡쐐기돌 조각‡El fragmento de piedra angular‡El fragmento de piedra angular‡L’éclat de la pierre de voûte‡钥石碎片‡拱心石裂片',
    nil,
    'Encontre o Fragmento do Monolito.‡Найдите поблизости осколок краеугольного камня.‡Findet die Schlüsselsteinscherbe in der Nähe.‡근처에서 쐐기돌 조각을 찾아야 합니다.‡Busca el fragmento de piedra angular en las proximidades.‡Busca el fragmento de piedra angular en las proximidades.‡Trouvez l’Éclat de la pierre de voûte, à proximité.‡在附近找到钥石碎片。‡在附近找到拱心石裂片。',
  }
},
[14271] = {
  {
    'Apresente-se a Smagadois‡Доложиться Двудробу‡Berichtet Zweimalmer‡투크러쉬에게 보고하기‡Informa a Doblegolpe‡Informa a Doblegolpe‡Présentez-vous à Broie-double‡向图卡斯汇报‡向雙碾回報',
    nil,
    'Fale novamente com Torg Smagadois no Terminal Sul da Foguetovia, que fica em Azshara, e relate sua descoberta.‡Вернитесь к Торгу Двудробу на оргриммарскую южную конечную станцию ракетной дороги в Азшаре.‡Kehrt zu Torg Zweimalmer an der Südlichen Endhaltestelle der Raketenbahn in Azshara zurück und berichtet ihm von Eurer Entdeckung.‡발견한 정보를 아즈샤라의 남부 로켓길 종착지에 있는 토르그 투크러쉬에게 알려야 합니다.‡Vuelve con Torg Doblegolpe a la Terminal de la Cohetepista del Sur en Azshara para informarle de tu descubrimiento.‡Vuelve con Torg Doblegolpe a la Terminal de la Cohetepista del Sur en Azshara para informarle de tu descubrimiento.‡Retournez voir Torg Broie-double au Terminus sud du fusorail, en Azshara, et informez-le de votre découverte.‡回到艾萨拉，向南部火箭车终点站的托格·图卡斯报告，告诉他你的发现。‡回去艾薩拉的南方火箭道終點找托爾格·雙碾。',
  }
},
[14272] = {
  {
    'Eviscerar‡Потрошение‡Ausweiden‡절개‡Eviscerar‡Eviscerar‡L\'éviscération‡刺骨‡剔骨',
    nil,
    'Fale com Loren, a Receptora, e aprenda a Eviscerar. Pratique a nova técnica em um Worgen Dentessangue.‡Поговорите с Лорен Укрывательницей и выучите способность "Потрошение". Затем убейте с помощью этой способности воргена из стаи Кровавых Клыков.‡Sprecht mit Loren der Hehlerin und lernt \'Ausweiden\'. Übt \'Ausweiden\' an einem Blutfangworgen.‡장물아비 로렌과 대화해 절개를 배운 뒤 붉은송곳니 늑대인간에게 기술을 시험해야 합니다.‡Habla con Loren la Perista y aprende Eviscerar. Practica Eviscerar contra un huargen Colmillo de Sangre.‡Habla con Loren la Perista y aprende Eviscerar. Practica Eviscerar contra un huargen Colmillo de Sangre.‡Parlez à Loren la Receleuse qui vous enseignera l\'Éviscération. Ensuite, exercez-vous à utiliser l\'Éviscération contre un Worgen croc-de-sang.‡跟侠盗萝伦谈一谈，学习刺骨。然后对一个血牙狼人使用刺骨。‡與『贓物商』洛倫交談，並學會剔骨。在血牙狼人身上練習剔骨。',
  }
},
[14273] = {
  {
    'Gente esquisita‡Странные знакомства‡Zwielichtige Gesellen‡어둠의 조력자‡Asociados umbríos‡Asociados umbríos‡D\'obscurs associés‡神秘的联系人‡可疑的同伴',
    nil,
    'Fale com Vitus Darkwalker no Distrito Militar.‡Поговорите с Витом Дарквокером в Военном квартале.‡Sprecht mit Vitus Dunkelwandler im Militärviertel.‡군사 지구에 있는 비투스 다크워커와 대화해야 합니다.‡Habla con Vitus Camino Oscuro en el Distrito Militar.‡Habla con Vitus Camino Oscuro en el Distrito Militar.‡Parlez à Vitus Sombremarcheur dans le Secteur Militaire.‡跟军事区的维图斯·暗行者谈一谈。‡和軍事區裡的維特斯·黑暗行者說話。',
  }
},
[14274] = {
  {
    'Imolação‡Жертвенный огонь‡Feuerbrand‡제물‡Inmolar‡Inmolar‡L\'immolation‡献祭‡獻祭',
    nil,
    'Fale com Vitus Darkwalker e aprenda a Imolação. Em seguida, lance o novo feitiço em um Worgen Dentessangue.‡Поговорите с Витом Дарквокером и выучите заклинание "Жертвенный огонь". Потренируйтесь применять это заклинание на воргенах из стаи Кровавых Клыков.‡Sprecht mit Vitus Dunkelwandler, um \'Feuerbrand\' zu lernen. Übt \'Feuerbrand\' an einem Blutfangworgen.‡비투스 다크워커와 대화해 제물을 배운 뒤 붉은송곳니 늑대인간에게 주문을 연습해야 합니다.‡Habla con Vitus Camino Oscuro y aprende Inmolar. Practica lanzando Inmolar a un huargen Colmillo de Sangre.‡Habla con Vitus Camino Oscuro y aprende Inmolar. Practica lanzando Inmolar a un huargen Colmillo de Sangre.‡Parlez à Vitus Sombremarcheur qui vous enseignera l\'Immolation. Ensuite, exercez-vous à lancer l’Immolation contre un Worgen croc-de-sang.‡跟维图斯·暗行者谈一谈，学习献祭。然后对一个血牙狼人施放献祭。‡和維特斯·黑暗行者說話並習得獻祭。在血牙狼人身上練習獻祭。',
  }
},
[14275] = {
  {
    'Estão de olho em você‡Кто-то следит за тобой‡Jemand ist Euch auf der Fährte‡추적자‡Alguien te sigue la pista‡Alguien te sigue la pista‡Quelqu\'un vous suit à la trace‡有人想联系你‡有人在追蹤你',
    nil,
    'Fale com o Guarda-caça Blake no Distrito Militar.‡Поговорите с ловчим Блейком в Военном квартале.‡Sprecht mit Jäger Blake im Militärviertel.‡군사 지구에 있는 사냥꾼 블레이크와 대화해야 합니다.‡Habla con el montero Blake en el Distrito Militar.‡Habla con el montero Blake en el Distrito Militar.‡Parlez au Veneur Blake dans le Secteur Militaire.‡跟军事区的猎手布雷克谈一谈。‡在軍事區裡和獵人布雷克說話。',
  }
},
[14276] = {
  {
    'Tiro Firme‡Верный выстрел‡Zuverlässiger Schuss‡고정 사격‡Disparo firme‡Disparo firme‡Le tir assuré‡稳固射击‡穩固射擊',
    nil,
    'Fale com o Guarda-caça Blake e aprenda o Tiro Firme. Use a nova habilidade 2 vezes contra um Worgen Dentessangue.‡Поговорите с ловчим Блейком и обучитесь способности "Верный выстрел". Затем убейте с ее помощью двух воргенов из стаи Кровавых Клыков.‡Sprecht mit Jäger Blake, um \'Zuverlässiger Schuss\' zu lernen. Übt \'Zuverlässiger Schuss\' zweimal gegen einen Blutfangworgen.‡사냥꾼 블레이크와 대화해 고정 사격을 배운 뒤 붉은송곳니 늑대인간에게 고정 사격을 2회 연습해야 합니다.‡Habla con el montero Blake y aprende Disparo firme. Practica tu Disparo firme dos veces contra un huargen Colmillo de Sangre.‡Habla con el montero Blake y aprende Disparo firme. Practica tu Disparo firme dos veces contra un huargen Colmillo de Sangre.‡Parlez au Veneur Blake qui vous enseignera le Tir assuré. Ensuite, exercez-vous au Tir assuré 2 fois contre un Worgen croc-de-sang.‡跟猎手布雷克谈一谈，学习稳固射击。然后对一个血牙狼人施放2次稳固射击。‡和獵人布雷克說話並學得穩固射擊。在血牙狼人身上練習使用穩固射擊2次。',
  }
},
[14277] = {
  {
    'Procura arcana‡Зов магии‡Arkane Anfragen‡신비술 연구‡Preguntas arcanas‡Preguntas arcanas‡Enquêtes arcaniques‡探究奥术‡秘法的質詢',
    nil,
    'Fale com Myriam Spellwaker no Distrito Militar.‡Поговорите с Мириам Пробудительницей Чар в Военном квартале.‡Sprecht mit Myriam Zauberwache im Militärviertel.‡군사 지구에 있는 미리암 스펠웨이커와 대화해야 합니다.‡Habla con Myriam Despiertamagia en el Distrito Militar.‡Habla con Myriam Despiertamagia en el Distrito Militar.‡Parlez à Myriam Éveillesort dans le Secteur Militaire.‡跟军事区的米莉安·唤法者谈一谈。‡在軍事區裡和麥雷姆·喚法者說話。',
  }
},
[14278] = {
  {
    'Atrás da irmã‡В поисках сестры‡Sucht die Schwester‡수녀님의 가르침‡Busca a la hermana‡Busca a la hermana‡Cherchez la sœur‡寻找修女‡探訪修女',
    nil,
    'Fale com a Irmã Almyra no Distrito Militar.‡Поговорите с сестрой Альмирой в Военном квартале.‡Sprecht mit Schwester Almyra im Militärviertel.‡군사 지구에 있는 수녀 알마이라와 대화해야 합니다.‡Habla con la hermana Almyra en el Distrito Militar.‡Habla con la hermana Almyra en el Distrito Militar.‡Parlez à Sœur Almyra dans le Secteur Militaire.‡跟军事区的艾尔米拉修女谈一谈。‡在軍事區裡和雅爾彌拉修女說話。',
  }
},
[14279] = {
  {
    'Cura célere‡Быстрое исцеление‡Blitzheilung‡순간 치유‡Sanación relámpago‡Sanación relámpago‡Soins rapides‡快速治疗‡快速治療',
    nil,
    'Fale com a Irmã Almyra e aprenda a Cura Célere. Em seguida, lance o novo feitiço duas vezes em um Guarda Ferido.‡Поговорите с сестрой Альмирой и выучите заклинание "Быстрое исцеление". Примените его дважды к раненому стражу.‡Sprecht mit Schwester Almyra, um \'Blitzheilung\' zu lernen. Übt \'Blitzheilung\' an zwei verwundeten Wachen.‡수녀 알마이라와 대화해 순간 치유를 배운 뒤 부상당한 근위병 2명에게 연습해야 합니다.‡Habla con la hermana Almyra y aprende Sanación relámpago. Utiliza Sanación relámpago 2 veces con un guardia herido.‡Habla con la hermana Almyra y aprende Sanación relámpago. Utiliza Sanación relámpago 2 veces con un guardia herido.‡Parlez à Sœur Almyra qui vous enseignera les Soins rapides. Ensuite, utilisez les Soins rapides 2 fois sur un Garde blessé.‡跟艾尔米拉修女谈一谈，学习快速治疗。然后对一名受伤的卫兵施放2次快速治疗。‡和雅爾彌拉修女說話並學得快速治療。在受傷的守衛身上練習使用快速治療2次。',
  }
},
[14280] = {
  {
    'Parece que os ventos conhecem você...‡Ветра шепчут твое имя‡Die Winde kennen Euren Namen… anscheinend‡바람은 당신의 이름을 알고 있다‡El viento sabe tu nombre... O eso parece‡El viento sabe tu nombre... O eso parece‡Les vents connaissent votre nom... apparemment‡风中的名字‡顯然...風知道你的名字',
    nil,
    'Fale com Celestine da Colheita no Distrito Militar.‡Поговорите с Целестиной Урожайной в Военном квартале.‡Sprecht mit Celestine Erntedank im Militärviertel.‡군사 지구에 있는 풍요의 셀레스틴과 대화해야 합니다.‡Habla con Celestina de La Cosecha en el Distrito Militar.‡Habla con Celestina de La Cosecha en el Distrito Militar.‡Parlez à Célestine de la Moisson dans le Secteur Militaire.‡跟军事区的丰收女巫塞莱斯廷谈一谈。‡在軍事區裡和『豐收』瑟萊斯丁說話。',
  }
},
[14281] = {
  {
    'Mísseis Arcanos‡Чародейские стрелы‡Arkane Geschosse‡신비한 화살‡Misiles Arcanos‡Misiles Arcanos‡Les projectiles des Arcanes‡奥术飞弹‡秘法飛彈',
    nil,
    'Fale com Myriam Spellwaker e aprenda a usar os Mísseis Arcanos. Em seguida, use o novo feitiço contra um Worgen Dentessangue.‡Поговорите с Мириам Пробудительницей Чар и выучите заклинание "Чародейские стрелы". Убейте с его помощью воргена из стаи Кровавых Клыков.‡Sprecht mit Miriam Zauberwache und lernt \'Arkane Geschosse\'. Übt \'Arkane Geschosse\' an einem Blutfangworgen.‡미리암 스펠웨이커와 대화해 신비한 화살을 배운 뒤 붉은송곳니 늑대인간에게 사용해야 합니다.‡Habla con Myriam Despiertamagia y aprende Misiles Arcanos. Utiliza Misiles Arcanos contra un huargen Colmillo de Sangre.‡Habla con Myriam Despiertamagia y aprende Misiles Arcanos. Utiliza Misiles Arcanos contra un huargen Colmillo de Sangre.‡Parlez à Myriam Éveillesort qui vous enseignera les Projectiles des Arcanes. Ensuite, lancez des Projectiles des Arcanes contre un Worgen croc-de-sang.‡跟米莉安·唤法者谈一谈，学习奥术飞弹。然后对一个血牙狼人使用奥术飞弹。‡和麥雷姆‧喚法者說話並學得秘法飛彈。在血牙狼人身上練習使用秘法飛彈。',
  }
},
[14282] = {
  {
    'Mistério solucionado‡Раскрытая тайна‡Rätsel gelöst‡밝혀진 진실‡Misterio resuelto‡Misterio resuelto‡Mystère résolu‡谜题解开了‡解開謎底',
    nil,
    'Você deve levar os Entalhes Antigos de Neptulon para a Pesquisadora Cenariana Korrah.‡Отнесите древнюю гравировку Нептулона кенарийской исследовательнице Корре.‡Ihr sollt die uralten Neptulon-Gravuren zu Korrah, Forscher des Cenarius bringen.‡넵튤론의 고대 새김판을 세나리온 연구원 코라에게 가져가야 합니다.‡Lleva los grabados de Neptulon antiguos a la investigadora Cenarion Korrah.‡Lleva los grabados de Neptulon antiguos a la investigadora Cenarion Korrah.‡Vous devez apporter les Gravures antiques de Neptulon à Korrah, la chercheuse du Cercle cénarien.‡你得把耐普图隆的石板带给塞纳里奥研究员库拉。‡你要把奈普圖隆的上古刻紋帶去給塞納里奧研究員柯拉。',
  }
},
[14283] = {
  {
    'Toque rejuvenescedor‡Омоложение‡Verjüngende Berührung‡회복의 손길‡Un toque de rejuvenecimiento‡Un toque de rejuvenecimiento‡Récupération‡回春之触‡回春之觸',
    nil,
    'Fale com Celestine da Colheita para aprender Rejuvenescer. Aplique o Rejuvenescer em um Guarda Ferido.‡Поговорите с Целестиной Урожайной и выучите заклинание "Омоложение". Воспользуйтесь им, чтобы помочь раненому стражу.‡Sprecht mit Celestine Erntedank, um \'Verjüngung\' zu lernen. Übt \'Verjüngung\' an einer verwundeten Wache.‡풍요의 셀레스틴과 대화해 회복을 배운 뒤 부상당한 근위병에게 회복을 연습해야 합니다.‡Habla con Celestina de la Cosecha y aprende Rejuvenecimiento. Practica Rejuvenecimiento con un guardia herido.‡Habla con Celestina de la Cosecha y aprende Rejuvenecimiento. Practica Rejuvenecimiento con un guardia herido.‡Allez voir Célestine de la Moisson qui vous enseignera Récupération. Ensuite, exercez-vous à utiliser Récupération 2 fois sur un Garde blessé.‡跟丰收女巫塞莱斯廷谈一谈，学习回春术。然后对一名受伤的卫兵施放回春术。‡和『豐收』瑟萊斯丁說話並學得回春術。對納拉其營地內受傷的守衛使用回春術。',
  }
},
[14284] = {
  {
    'A vingança do elemental vingativo‡Месть загробника‡Die Rache eines Klagegeistes‡망령의 복수‡La venganza del aparecido‡La venganza del aparecido‡La vengeance d\'un revenant‡亡魂的复仇‡亡魄的復仇',
    nil,
    'Hydronis quer que você monte nele e derrote a Sacerdotisa Valishj.‡Сядьте верхом на лорда Гидрониса и сразитесь со жрицей Валишж.‡Hydronis will, dass Ihr ihn besteigt und die Priesterin Valishj besiegt.‡하이드로니스가 자신에게 올라타 여사제 발리쉬를 무찔러 달라고 했습니다.‡Hydronis quiere que montes en él y derrotes a la sacerdotisa Valishj.‡Hydronis quiere que montes en él y derrotes a la sacerdotisa Valishj.‡Hydronis veut que vous le chevauchiez pour aller tuer la Prêtresse Valishj.‡海卓尼斯要你骑在他的身上打败女祭司瓦丽丝琪。‡海德洛尼斯要你乘上他，一同打敗女祭司瓦黎許。',
  }
},
[14285] = {
  {
    'Quanto mais, melhor‡Спасение в единстве‡Je mehr, desto sicherer‡뭉쳐야 산다‡Cuantos más, mejor‡Cuantos más, mejor‡Le groupe apporte la sécurité‡人多安全‡眾人的庇護',
    nil,
    'Fale com o Rei Genn Greymane no Distrito Militar.‡Поговорите с королем Генном Седогривом в Военном квартале.‡Sprecht mit König Genn Graumähne im Militärviertel.‡군사 지구에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Parlez au Roi Genn Grisetête dans le Secteur Militaire.‡跟军事区的吉恩·格雷迈恩国王谈一谈。‡到軍事區和吉恩·葛雷邁恩國王談話。',
  }
},
[14286] = {
  {
    'Quanto mais, melhor‡Спасение в единстве‡Je mehr, desto sicherer‡뭉쳐야 산다‡Cuantos más, mejor‡Cuantos más, mejor‡Le groupe apporte la sécurité‡人多安全‡眾人的庇護',
    nil,
    'Fale com o Rei Genn Greymane no Distrito Militar.‡Поговорите с королем Генном Седогривом в Военном квартале.‡Sprecht mit König Genn Graumähne im Militärviertel.‡군사 지구에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Habla con el rey Genn Cringris en el Distrito Militar.‡Parlez au Roi Genn Grisetête dans le Secteur Militaire.‡跟军事区的吉恩·格雷迈恩国王谈一谈。‡到軍事區和吉恩·葛雷邁恩國王談話。',
