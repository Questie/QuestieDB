},
[28764] = {
  {
    'É hora de reagir‡Дать отпор!‡Schlagt sie zurück!‡격퇴!‡¡Rechazar el ataque!‡¡Rechazar el ataque!‡Repoussez-les !‡击退敌人！‡打退他們!',
    nil,
    'Mate 6 Worgs de Batalha Rocha Negra.‡Убейте 6 боевых воргов клана Черной горы.‡Tötet 6 Kampfworgs des Schwarzfels.‡검은바위 전투늑대 6마리를 처치해야 합니다.‡Mata a 6 huargos de batalla Roca Negra.‡Mata a 6 huargos de batalla Roca Negra.‡Tuez 6 Worgs de guerre rochenoires.‡杀死6只黑石战狼。‡殺死6隻黑石作戰座狼。',
  }
},
[28765] = {
