[32016] = {
  {
    'Antigos Amuletos de Boa Sorte‡Большие амулеты удачи‡Ehrwürdige Amulette des Glücks‡행운의 장로 부적‡Talismanes ancestrales de buena fortuna‡‡Les breloques anciennes de bonne fortune‡长者的好运护符‡',
    nil,
    'Colete 90 Amuletos Menores de Boa Sorte. Uma‡Соберите 90 малых амулетов удачи.‡Sammelt 90 geringe Amulette des Glücks.‡행운의 하급 부적 90개를 모아야 합니다. 레벨 30 영원꽃 골짜기‡Consigue 90 talismanes de buena fortuna inferiores.‡‡Récupérez 90 Breloques de bonne fortune inférieures.‡收集90枚次级好运护符。‡',
  }
},
[32017] = {
  {
    'Antigos Amuletos de Boa Sorte‡Большие амулеты удачи‡Ehrwürdige Amulette des Glücks‡행운의 장로 부적‡Talismanes ancestrales de buena fortuna‡‡Les breloques anciennes de bonne fortune‡长者的好运护符‡',
    nil,
    'Colete 90 Amuletos Menores de Boa Sorte. Uma‡Соберите 90 малых амулетов удачи.‡Sammelt 90 geringe Amulette des Glücks.‡행운의 하급 부적 90개를 모아야 합니다. 레벨 30 영원꽃 골짜기‡Consigue 90 talismanes de buena fortuna inferiores.‡‡Récupérez 90 Breloques de bonne fortune inférieures.‡收集90枚次级好运护符。‡',
  }
},
[32018] = {
  {
    'O nome dele era... Malte do Trovão‡Его звали... Буйный Портер‡Sein Name war Sturmbräu‡그의 이름은... 스톰스타우트‡Le llamaban... Cerveza de Trueno‡‡Son nom était… Brune d’Orage‡他姓……风暴烈酒‡',
    nil,
    'Fale com Chen Malte do Trovão nos Campos Pé de Trovão, que fica no Vale dos Quatro Ventos. Uma‡Поговорите с Чэнем Буйным Портером на лугах Громовой Пяты, что в долине Четырех Ветров.‡Sprecht mit Chen Sturmbräu auf den Donnerfußfeldern im Tal der Vier Winde.‡네 바람의 계곡의 썬더풋 방목지에 있는 첸 스톰스타우트와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Chen Cerveza de Trueno en las Granjas Pie Atronador, en el Valle de los Cuatro Vientos.‡‡Parlez à Chen Brune d’Orage aux Champs Pied de Foudre, dans la Vallée des Quatre vents.‡去四风谷的雷脚农场和陈·风暴烈酒谈一谈。‡',
  }
},
[32019] = {
  {
    'Eles o chamam... Malte do Trovão‡Его звали... Буйный Портер‡Sie nennen ihn Sturmbräu‡그 이름은... 스톰스타우트‡Lo llaman... Cerveza de Trueno‡‡On l’appelle… Brune d’Orage‡他们叫他……风暴烈酒‡',
    nil,
    'Fale com Chen Malte do Trovão nos Campos Pé de Trovão, que fica no Vale dos Quatro Ventos. Uma‡Поговорите с Чэнем Буйным Портером на лугах Громовой Пяты, что в долине Четырех Ветров.‡Sprecht mit Chen Sturmbräu auf den Donnerfußfeldern im Tal der Vier Winde.‡네 바람의 계곡의 썬더풋 방목지에 있는 첸 스톰스타우트와 대화해야 합니다. 레벨 15 네 바람의 계곡‡Habla con Chen Cerveza de Trueno en las Granjas Pie Atronador, en el Valle de los Cuatro Vientos.‡‡Parlez à Chen Brune d’Orage aux Champs Pied de Foudre, dans la Vallée des Quatre vents.‡去四风谷的雷脚农场和陈·风暴烈酒谈一谈。‡',
  }
},
[32020] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡‡Un seau de bonbons‡糖罐‡',
    nil,
    'Baldes de balas como esse encontram-se nas estalagens de todos os reinos. Vá em frente... pegue algumas! Noturnália de missão. Premia Punhado de Balas.‡Кульки с конфетами можно найти в любой таверне. Ну – чего стоишь? Хватай конфетку!‡Süßigkeiteneimer wie diesen hier gibt es in jeder Gaststätte zu finden. Na los... greift zu!‡전 지역에 걸쳐 여관 안에서 이런 사탕 바구니를 발견할 수 있습니다. 주저하실 필요 없어요. 사탕을 가져가세요!‡Hay cubos de caramelos como este en tabernas por los reinos. No te cortes, ¡coge! Una misión de Halloween. Otorga Puñado de golosinas como recompensa.‡‡Vous trouverez des seaux de bonbons comme celui-ci dans des auberges un peu partout dans les royaumes. Allez-y, servez-vous ! Une quête de Sanssaint.‡‡',
  }
},
