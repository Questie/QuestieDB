},
[30279] = {
  {
    'REUTILIZAR PARA PROGRESSÃO‡REUSE FOR PROGRESSION‡REUSE FOR PROGRESSION‡진행 시 재사용‡REUSE FOR PROGRESSION‡‡REUSE FOR PROGRESSION‡REUSE FOR PROGRESSION‡',
    nil,
    'Uma‡‡‡레벨 1 영원꽃 골짜기‡‡‡‡‡',
  }
},
[30280] = {
  {
    'O trovão que vem de baixo‡Гром из глубин‡Ein Röhren aus der Tiefe‡저 아래 우레 같은 소리‡El trueno vive abajo‡‡Tonnerre sous nos pieds‡雷电‡',
    nil,
    'Mate Milau. Uma‡Убейте Милау.‡Tötet Milau.‡밀라우를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Acaba con Milau.‡‡Tuez Milau.‡击败秘烙。‡',
  }
},
[30281] = {
  {
    'O silêncio se aproxima‡Бесшумно, но доходчиво‡Leises Anschleichen‡조용한 접근‡Acercamiento silencioso‡‡Approche silencieuse‡悄然出击‡',
    nil,
    'Mate 6 mogus Shao-Tien no Lago Pétala Branca. Uma‡Убейте 6 могу Шао-Тень на Озере Белых Лепестков.‡Tötet 6 Shao-Tien-Mogu am Weißblütensee.‡흰꽃잎 호수에서 샤오티엔 모구 6명을 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a 6 mogu Shao-Tien en el Lago Pétalo Níveo.‡‡Tuez 6 Mogu shao-tien au lac Blanc-Pétale.‡在琼花湖击败6个韶天魔古人。‡',
  }
},
[30282] = {
  {
    'Queimando a sujeira‡Очищающий огонь‡Den Dreck wegbrennen‡‡Fogatas de inmundicia‡‡Nettoyage par le feu‡烧光秽物‡',
    nil,
    'Queime 10 Estandartes de Shao-Tien. Uma‡Сожгите 10 знамен Шао-Тень.‡Verbrennt 10 Shao-Tien-Banner.‡‡Quema 10 estandartes Shao-Tien.‡‡Brûlez 10 Bannières shao-tien.‡焚烧10面韶天旗帜。‡',
  }
},
[30283] = {
  {
    'Uma impressão impressionante‡Повальное увлечение‡Zerschlagende Argumente‡가슴을 두들기는 감동‡Sencillamente arrasador‡‡Pierre tombée‡破碎印象‡',
    nil,
    'Destrua Estátuas Ritualísticas Shao-Tien. Uma‡Уничтожьте ритуальные статуи Шао-Тень.‡Zerstört die Shao-Tien-Ritualstatuen.‡샤오티엔 의식용 입상을 파괴해야 합니다. 레벨 1 영원꽃 골짜기‡Destroza las estatuas del ritual Shao-Tien.‡‡Détruisez les Statues rituelles de Shao-Tien.‡摧毁韶天仪式雕像。‡',
  }
},
[30284] = {
  {
    'Mil dentinhos pontudos‡Тысяча острых зубов‡Tausend spitze Zähnchen‡수천 개의 뾰족한 이빨‡Un millar de dientes afilados‡‡Les dents de la mare‡千尖之牙‡',
    nil,
    'Mate 9 Cardumeiros Dente-de-faca. Uma‡Убейте 9 стайных острозубов.‡Tötet 9 Messerzahnschwärmer.‡칼이빨 광포어 9마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 9 enjambristas Filodiente.‡‡Tuez 9 Grouillants dent-coupante.‡击败9个刃牙狂鱼。‡',
  }
},
[30285] = {
  {
    'Relatórios de batedores Wu Kao‡Донесения У Као‡Späherberichte der Wukao‡우 카오 정찰 보고서‡Informes de exploración Wu Kao‡‡Les rapports de reconnaissance de Wu Kao‡悟道者侦察报告‡',
    nil,
    'Recupere 3 Relatórios de Batedores Wu Kao. Uma‡Добудьте 3 донесения разведчиков У Као.‡Holt 3 Wukaospäherberichte.‡우 카오 정찰 보고서 3개를 회수해야 합니다. 레벨 1 영원꽃 골짜기‡Recupera 3 informes de exploración Wu Kao.‡‡Récupérez 3 Rapports de reconnaissance de Wu Kao.‡找回3份悟道者侦察报告。‡',
  }
},
[30286] = {
  {
    'Encurralados‡Загнаны в угол‡In die Enge getrieben‡‡Contra la pared‡‡Pris au piège‡绝境逢生‡',
    nil,
    'Resgate 6 Aldeões da Vila do Cair da Bruma Encurralados. Uma‡Спасите 6 жителей деревни Туманного Водопада.‡Rettet 6 in die Enge getriebene Dorfbewohner von Nebelhauch.‡‡Rescata a 6 habitantes de Bruma Otoñal acorralados.‡‡Sauvez 6 Villageois de Tombe-Brume pris au piège.‡营救6个被困的雾临村民。‡',
  }
},
[30287] = {
  {
    'Ou acabamos com eles, ou acabamos com eles‡Могу – плохие гости‡Mogu keine guten Gäste‡불청객 모구‡Los mogu no son buenos anfitriones‡‡Les mogu font de piètres invités‡来者不善‡',
    nil,
    'Mate 6 atacantes Shao-Tien na Vila do Cair da Bruma. Uma‡Убейте 6 налетчиков шадо-тянь в деревне Туманного Водопада.‡Tötet 6 Shao-Tien-Angreifer in Nebelhauch.‡안개내림 마을에서 샤오티엔 공격자 6명을 처치해야 합니다. 레벨 5 영원꽃 골짜기‡Mata a 6 atacantes Shao-Tien en la Aldea Bruma Otoñal.‡‡Tuez 6 Attaquants shao-tien à Tombe-Brume.‡在雾临村击败6名韶天攻击者。‡',
  }
},
[30288] = {
  {
    'Minha cidade está queimando... de novo‡Горит мой город опять‡Es brennt... schon wieder!‡마을이 또 불길에 휩싸였어요‡Mi ciudad se quema... de nuevo‡‡Un incendie dans la ville (encore)‡我们村又着火了‡',
    nil,
    'Use os Baldes d\'Água de Cair da Bruma para apagar 60 incêndios. Uma‡Используйте бочки с водой в деревне Туманного Водопада, чтобы потушить 60 пожаров.‡Nutzt die Wassereimer in Nebelhauch, um 60 Feuer zu löschen.‡안개내림 물동이를 사용해서 불꽃 60개를 꺼야 합니다. 레벨 5 영원꽃 골짜기‡Usa cubos de agua de Bruma Otoñal para apagar 60 fuegos.‡‡Éteignez 60 Feux à l’aide des Seaux d’eau de Tombe-Brume.‡使用雾临水桶熄灭60处火焰。‡',
  }
},
[30289] = {
  {
    'Liberdade pra dentro da cabeça‡Освободить сознание‡Befreiung der gestohlenen Seelen‡몸과 마음의 해방‡Libera cuerpo y mente‡‡Libérer le corps et l’esprit‡解放意志与躯体‡',
    nil,
    'Liberte 6 Guardas Dominados matando os controladores deles. Uma‡Освободите 6 одержимых стражников, убив тех, кто овладел их сознанием.‡Befreit 6 besessene Wachen, indem Ihr die Mogu tötet, die deren Gedanken steuern.‡조종자를 처치해서 지배당한 경비병 6명을 해방시켜야 합니다. 레벨 1 영원꽃 골짜기‡Libera a 6 guardias dominados matando a sus controladores.‡‡Libérez 6 Gardes dominés en éliminant ceux qui les contrôlent.‡击败卫兵的幕后操纵者，解救6个被统御的卫兵。‡',
  }
},
[30290] = {
  {
    'Cachorro!? Que cachorro o quê!‡Каменные убийцы‡Steingebundene Mörder‡바위속박 학살자들‡Asesinos vinculados a la piedra‡‡Des tueurs liés à la pierre‡石缚杀手‡',
    nil,
    'Mate 8 Quílens Rochosos. Uma‡Убейте 8 каменных цийлиней.‡Tötet 8 steingebundene Qilen.‡바위속박 기렌 8마리를 처치해야 합니다. 레벨 5 영원꽃 골짜기‡Mata a 8 quilen vinculados a la piedra.‡‡Tuez 8 Quilen liés à la pierre.‡击败8只石缚魁麟。‡',
  }
},
[30291] = {
  {
    'Demonstração incrível‡Нечто невероятное‡Betäubende Effizienz‡골 때리는 솜씨‡Demostración pasmosa‡‡Canne à mèche‡惊艳之举‡',
    nil,
    'Pegue 12 Carpas Pétala Branca Atordoadas. Uma‡Соберите 12 оглушенных карпов Белых Лепестков.‡Sammelt 12 betäubte Weißblütenkarpfen ein.‡기절한 흰꽃잎 잉어 12마리를 모아야 합니다. 레벨 1 영원꽃 골짜기‡Hazte con 12 carpas Pétalo Níveo aturdidas.‡‡Récupérez 12 Carpes de Blanc-Pétale étourdies.‡收集12条昏迷的琼花鲤鱼。‡',
  }
},
[30292] = {
  {
    'Os despertares bruscos‡Бесцеремонное пробуждение‡Böses Erwachen‡무례한 깨우기‡Despertar brutal‡‡Dominer les dominés‡猛然觉醒‡',
    nil,
    'Mate 8 Comecarne Pálida Lâmina Dominados. Uma‡Убейте 8 одержимых трупоедов Бледного Клинка.‡Tötet 8 besessene Fleischfresser der Bleichklingen.‡지배당하는 회색갈퀴 식인투사 8마리를 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a 8 comecarnes Hojablanca dominados.‡‡Tuez 8 Dévoreurs pâlelames dominés.‡击败8个被控制的白刃食肉者。‡',
  }
},
[30293] = {
  {
    'Em mãos inimigas‡В руках врага‡In der Hand des Feindes‡적의 손아귀‡En manos enemigas‡‡Esclave de l’ennemi‡‡',
    nil,
    'Dê uma surra em 8 Defensores de Pétala Branca Possuídos até que estejam livres da possessão mogu. Uma‡Атакуйте 8 одержимых защитников Белого Лепестка до тех пор, пока они не освободятся от контроля могу.‡Setzt 8 besessenen Weißblütenverteidigern zu, bis sie von der Gedankenkontrolle der Mogu befreit sind.‡지배당한 황금 연꽃 방어병 8명을 모구의 지배에서 벗어나게 해야 합니다. 레벨 1 영원꽃 골짜기‡Derrota a 8 defensores Pétalo Níveo poseídos hasta que se vean liberados de la posesión mogu.‡‡Battez 8 Défenseurs possédés du Lac Blanc-Pétale jusqu’à ce qu’ils échappent à l’emprise des mogu.‡‡',
  }
},
[30294] = {
  {
    'Pequenos caprichos‡Обретение покоя‡Kleiner Trost‡작은 위안‡Pequeños consuelos‡‡Un peu de réconfort‡‡',
    nil,
    'Leia o Rito de Libertação junto aos corpos de 6 Defensores do Lótus Dourado Mortos. Uma‡Произведите обряд Освобождения над телами 6 павших защитников Золотого Лотоса.‡Lest den Ritus der Befreiung 6 gefallenen Verteidigern des Goldenen Lotus vor.‡Fallen Golden Lotus Defender 6명의 시체 앞에서 Rite of Release를 읽어야 합니다. 레벨 1 영원꽃 골짜기‡Lee el rito de liberación frente a los cuerpos caídos de 6 defensores del Loto Dorado.‡‡Lisez le Rite de libération près des cadavres de 6 Défenseurs morts du Lotus doré.‡‡',
  }
},
[30295] = {
  {
    'Turn-in Quest Test Case‡Turn-in Quest Test Case‡Turn-in Quest Test Case‡반납 퀘스트 케이스‡Turn-in Quest Test Case‡‡Test‡交还任务测试例子‡',
