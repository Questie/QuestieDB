[7401] = {
  {
    '‡Разыскиваются: ДВОРФЫ!‡GESUCHT: ZWERGE!‡현상 수배: 드워프!‡Se buscan: ¡ENANOS!‡Se buscan: ¡ENANOS!‡Avis de recherche : NAINS !‡通缉：矮人!‡懸賞:矮人!',
    nil,
    '‡Ваша задача – убивать дворфов в Альтеракской долине.|n|nУбейте дворфа и вырвите ему хребет. Отнесите хребет дворфа сержанту Язре Кровавый Рык в крепость Северного Волка.‡Ihr wurdet damit beauftragt, alle feindlichen Zwergenspieler im Alteractal zu töten.|n|nTötet einen Zwerg und schneidet ihm sein Rückgrat heraus. Bringt anschließend das Zwergenrückgrat zu Unteroffizier Yazra Murrblut in Burg Frostwolf.‡‡Se te asignado la tarea de matar a los jugadores enanos en el Valle de Alterac.|n|nMata a un enano y sácale la espina dorsal. Llévasela al sargento Yazra Gruñido Sangriento en el Bastión Lobo Gélido.‡Se te asignado la tarea de matar a los jugadores enanos en el Valle de Alterac.|n|nMata a un enano y sácale la espina dorsal. Llévasela al sargento Yazra Gruñido Sangriento en el Bastión Lobo Gélido.‡Vous avez été $Gchargé:chargée; de tuer les personnages nains présents dans la vallée d\'Alterac.|n|nTuez des nains et arrachez-leur la colonne vertébrale. Apportez les Colonnes vertébrales de nains au sergent Yazra Gronde-sang au donjon Loup-de-givre.‡你被指派去杀死奥特兰克山谷中的矮人玩家。|n|n杀掉一个矮人，然后把矮人的脊椎交给霜狼要塞的亚斯拉·血矛。‡',
  }
},
[7402] = {
  {
    '‡Разыскиваются: ОРКИ!‡GESUCHT: ORCS!‡현상 수배: 오크!‡Se buscan: ¡ORCOS!‡Se buscan: ¡ORCOS!‡Avis de recherche : ORCS !‡通缉：兽人!‡懸賞:獸人!',
    nil,
    '‡Ваше задание – убивать орков в Альтеракской долине.|n|nУбейте орка и доставьте зуб орка капралу Норгу Грозовой Вершине в Дун Болдар.‡Ihr wurdet damit beauftragt, alle feindlichen orcischen Spieler im Alteractal zu töten.|n|nTötet einen Orc und bringt seinen Zahn zurück zu Korporal Noreg Sturmlanze in Dun Baldar.‡알터랙 계곡에 있는 호드 진영의 오크 플레이어를 쓰러뜨리라는 임무를 받았습니다.|n|n오크를 처치하고 던 발다르에 있는 하사관 노레그 스톰파이크에게 오크 엄니를 가져가야 합니다.‡Se te asignado la tarea de matar a los jugadores orcos en el Valle de Alterac.|n|nMata a un orco y llévale un colmillo de la víctima al cabo Noreg Pico Tormenta en Dun Baldar.‡Se te asignado la tarea de matar a los jugadores orcos en el Valle de Alterac.|n|nMata a un orco y llévale un colmillo de la víctima al cabo Noreg Pico Tormenta en Dun Baldar.‡Vous avez été chargé de tuer les personnages orcs présents dans la Vallée d\'Alterac.|n|nTuez un orc et remettez les Dents d\'orc au caporal Noreg Foudrepique à Dun Baldar.‡你被指派去杀死奥特兰克山谷中的兽人玩家。|n|n杀掉一个兽人，然后把兽人的獠牙交给丹巴达尔的诺雷格·雷矛中尉。‡',
  }
},
