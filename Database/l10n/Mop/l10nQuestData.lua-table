[29742] = {
  {
    'Menkhaf, o Ancião‡Предок Менкхаф‡Urahne Menkhaf‡장로 멘카프‡El ancestro Menkhaf‡El ancestro Menkhaf‡L’Ancien Menkhaf‡门克哈夫长者‡曼卡夫長者',
