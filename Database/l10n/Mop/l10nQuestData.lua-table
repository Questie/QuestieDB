[8274] = {
  {
    'Testar Missão de Morte‡Тестовое задание на убийство‡Test Kill Quest‡시험용 처치 퀘스트‡Misión de muerte de prueba‡Misión de prueba‡Quête test d’élimination‡测试消灭任务‡測試擊殺任務',
    nil,
    'Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.‡Kill 5 Murlocs and come back to the test character.',
  }
},
[8275] = {
  {
    'A retomada de Silithus‡Отвоевание Силитуса‡Die Rückeroberung von Silithus‡실리더스 탈환‡La reconquista de Silithus‡La reconquista de Silithus‡La reconquête de Silithus‡夺回希利苏斯‡奪回希利蘇斯',
    nil,
    'Apresente-se à Arauto do Vento Chifre Altivo no Forte Cenariano, em Silithus.‡Поговорите с призывательницей ветров Гордый Рог в крепости Кенария.‡Sprecht mit Windruferin Prachthorn auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼과 대화해야 합니다.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Parlez à l\'Imploratrice céleste Corne-fière au Fort cénarien, en Silithus.‡与希利苏斯塞纳里奥要塞的唤风者梅恩·长角谈一谈。‡和在希利蘇斯塞納里奧城堡裡的喚風者傲角談話。',
  }
},
[8276] = {
  {
    'A retomada de Silithus‡Отвоевание Силитуса‡Die Rückeroberung von Silithus‡실리더스 탈환‡La reconquista de Silithus‡La reconquista de Silithus‡La reconquête de Silithus‡夺回希利苏斯‡奪回希利蘇斯',
    nil,
    'Apresente-se à Arauto do Vento Chifre Altivo no Forte Cenariano, em Silithus.‡Поговорите с призывательницей ветров Гордый Рог в крепости Кенария.‡Sprecht mit Windruferin Prachthorn auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼과 대화해야 합니다.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Parlez à l\'Imploratrice céleste Corne-fière au Fort cénarien, en Silithus.‡与希利苏斯塞纳里奥要塞的唤风者梅恩·长角谈一谈。‡和在希利蘇斯塞納里奧城堡裡的喚風者傲角談話。',
  }
},
[8277] = {
  {
    'Peçonha mortal do deserto‡Смертельный яд‡Tödliches Wüstengift‡치명적인 사막의 맹독‡Veneno mortal del desierto‡Veneno mortal del desierto‡Venin mortel du désert‡沙漠中的剧毒‡沙漠中的劇毒',
    nil,
    'Belhatriz Corredente, no Forte Cenariano em Silithus, quer que você traga 8 Aguilhões de Escorpídeo Petraçoite e 8 Presas de Rastejante da Areia. Fale com ela quando tiver completado a tarefa.‡Принесите Битиссе Шаткобрус из крепости Кенария 8 жал камнехвостых скорпидов и 8 жвал песчаных пауков-быстроногов.‡Beetix Wankelhupf von der Burg Cenarius in Silithus möchte, dass Ihr 8 Stachel von Steinpanzerskorpiden und 8 Giftzähne von Sandhuschern für sie sammelt. Kehrt zu ihr zurück, sobald Ihr diese Aufgabe erfüllt habt.‡실리더스에서 돌꼬리전갈 독침 8개와 모래그물 바위거미 송곳니 8개를 모은 후, 세나리온 요새에 있는 비틱스 픽클스프라그에게 가야 합니다.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus, quiere que consigas 8 aguijones de escórpido Latipiedra y 8 colmillos de arácnidos de arena. Vuelve a verla cuando hayas cumplido tu misión.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus, quiere que consigas 8 aguijones de escórpido Latipiedra y 8 colmillos de arácnidos de arena. Vuelve a verla cuando hayas cumplido tu misión.‡Beetix Kalefragile au Fort cénarien en Silithus veut que vous ramassiez 8 Dards de scorpide Cinglepierre et 8 Crocs de Glisseuse du sable. Retournez la voir quand vous aurez terminé.‡希利苏斯塞纳里奥要塞的比提克斯·斯巴格要求你带8个石鞭蝎之刺和8个掠沙蜘蛛的牙齿给他。‡希利蘇斯的塞納里奧城堡的比提克斯·斯巴格要你去收集8只石鞭蠍刺和8只掠沙蜘蛛毒牙。完成任務後回到她那裡。',
  }
},
[8278] = {
  {
    'A última esperança de Noggel‡Последняя надежда Ноггла‡Noggles letzte Hoffnung‡노글의 마지막 희망‡La última esperanza de Noggle‡La última esperanza de Noggle‡Le dernier espoir de Noggle‡诺格的最后一线希望‡諾格的最後一線希望',
    nil,
    'Belhatriz Corredente, no Forte Cenariano em Silithus, quer que você consiga 3 Aguilhões de Tenaz Petraçoite, 3 Aguilhões de Esfolador Petraçoite e 3 Presas de Espreitadora de Rocha.‡Принесите Битиссе Шаткобрус из крепости Кенария 3 жала камнехвостых клешневиков, 3 жала камнехвостых живодеров и 3 клыка скальных пауков-скакунов.‡Beetix Wankelhupf von der Burg Cenarius in Silithus möchte, dass Ihr je 3 Stachel von Steinpanzerzangen und Steinpanzerschindern sowie 3 Felspirschergiftzähne für sie sammelt.‡세나리온 요새에 있는 비틱스 픽클스프라그가 실리더스에서 돌꼬리집게전갈 독침 3개, 돌꼬리채찍전갈 독침 3개, 긴다리 바위거미 송곳니 3개를 모아 달라고 했습니다.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus quiere que consigas 3 aguijoneros de tenazario Latipiedra, 3 aguijoneros de despellejador Latipiedra y 3 colmillos de acecharrocas.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus quiere que consigas 3 aguijoneros de tenazario Latipiedra, 3 aguijoneros de despellejador Latipiedra y 3 colmillos de acecharrocas.‡Beetix Kalefragile, du Fort cénarien en Silithus, veut que vous ramassiez 3 Dards de pinceur Cinglepierre, 3 Dards d\'écorcheur Cinglepierre et 3 Crocs de traqueuse des rochers.‡希利苏斯塞纳里奥要塞的比提克斯·斯巴格要求你给他带去3个石鞭巨钳蝎之刺、3个石鞭掠夺者之刺和3个石行蜘蛛的牙齿。‡希利蘇斯塞納里奧城堡的比提克斯·斯巴格要你去收集3只石鞭巨鉗蠍刺，3只石鞭撕掠者刺，和3只石行蜘蛛毒牙。',
  }
},
[8279] = {
  {
    'O dicionário do crepúsculo‡Сумеречный словарь‡Das Zwielichtlexikon‡황혼의 사전‡El Lexicón Crepuscular‡El Lexicón Crepuscular‡Le lexique du Crépuscule‡暮光词典‡暮光詞典',
    nil,
    'Traga os três capítulos do Dicionário do Crepúsculo para o Eremita Ortell em Silithus.‡Принесите три главы Сумеречного словаря отшельнику Ортеллу из Силитуса.‡Bringt Ortell dem Einsiedler in Silithus die drei Kapitel des Zwielichtlexikons.‡실리더스에 있는 은둔자 오르텔에게 황혼의 사전 1,2,3 장을 가져가야 합니다.‡Lleva los tres capítulos del Lexicón Crepuscular al Ermitaño Ortell en Silithus.‡Lleva los tres capítulos del Lexicón Crepuscular al ermitaño Ortell en Silithus.  ‡Apportez les trois chapitres du Lexique du Crépuscule à l\'ermite Ortell, en Silithus.‡把暮光词典的三个章节交给希利苏斯的隐士奥泰尔。‡將暮光詞典的3章帶給希利蘇斯的隱士奧泰爾。',
  }
},
[8280] = {
  {
    'Defendendo as linhas de suprimento‡Надежные поставки‡Sicherung der Versorgungslinien‡보급로 확보‡Asegurar las rutas de suministros‡Asegurar las rutas de suministros‡Sécuriser les lignes d\'approvisionnement‡保护补给线‡保護補給線',
    nil,
    'O Arauto do Vento Chifre Altivo, no Forte Cenariano, quer que você mate 15 Dragatacas.‡Убейте 15 землечерпов по поручению призывательницы ветров Гордый Рог.‡Windruferin Prachthorn auf Burg Cenarius in Silithus möchte, dass Ihr 15 Baggerschläger tötet.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼이 작살미늘벌레 15마리를 처치해 달라고 했습니다.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 15 golpeadores deslizantes.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 15 golpeadores deslizantes.‡L\'Imploratrice céleste Corne-fière au Fort cénarien en Silithus veut que vous tuiez 15 Frappeurs térébrants.‡希利苏斯塞纳里奥要塞的唤风者梅恩·长角要求你去杀死15只掘泥打击者。‡希利蘇斯的塞納里奧城堡的喚風者傲角要你去殺15個掘泥打擊者。',
  }
},
[8281] = {
  {
    'Aumentando a segurança‡Обеспечение безопасности‡Verstärkte Sicherheit‡보급로 안전 강화‡Intensificar la seguridad‡Intensificar la seguridad‡Améliorer la sécurité‡确保安全‡確保安全',
    nil,
    'O Arauto do Vento Chifre Altivo, no Forte Cenariano, quer que você mate 20 Dragasmagas.‡Убейте 20 земляных сокрушителей по поручению призывательницы ветров Гордый Рог.‡Windruferin Prachthorn auf Burg Cenarius in Silithus möchte, dass Ihr 20 Baggerbrecher tötet.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼이 망치미늘벌레 20마리를 처치해 달라고 했습니다.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 20 trituradores deslizantes.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 20 trituradores deslizantes.‡L\'Imploratrice céleste Corne-fière au Fort cénarien en Silithus veut que vous tuiez 20 Ecraseurs térébrants.‡希利苏斯塞纳里奥要塞的唤风者梅恩·长角要求你去杀死20只掘泥摧毁者。‡希利蘇斯的塞納里奧城堡的喚風者傲角要你去殺20個掘泥摧毀者。',
  }
},
[8282] = {
  {
    'Algibeira perdida do Noggel‡Потерянная сумка Ноггла‡Noggles verlorener Ranzen‡노글의 잃어버린 가방‡La cartera perdida de Noggle‡La cartera perdida de Noggle‡La sacoche perdue de Noggle‡诺格的背包‡諾格的背袋',
    nil,
    'Vá para as montanhas na parte sul de Silithus e recupere a Algibeira do Noggel. Devolva-a no Forte Cenariano.‡Принесите сумку Ноггля из гор в южной части Силитуса и верните ее хозяину в крепость Кенария.‡Spürt Noggles Ranzen im südlichen Gebirge von Silithus auf und bringt ihn zu ihm, auf Burg Cenarius, zurück.‡실리더스의 남부 산맥에서 노글의 자루를 회수해 세나리온 요새에 있는 노글에게 가져가야 합니다.‡Recupera la Cartera de Noggle en las montañas al sur de Silithus y devuélvesela en el Fuerte Cenarion.‡Recupera la Cartera de Noggle en las montañas al sur de Silithus y devuélvesela en el Fuerte Cenarion.‡Récupérez la Sacoche de Noggle dans les montagnes au sud de Silithus et rapportez-la-lui au Fort cénarien.‡从希利苏斯南部山中找到诺格的背包，然后将它交给塞纳里奥要塞中的诺格。‡到希利蘇斯南邊山區找回諾格的背袋，並回到塞納里奧城堡交還給他。',
  }
},
[8283] = {
  {
    'Procura-se: Agarramata, o Terror das Areias‡РОЗЫСК: Смертехват, гроза пустыни‡GESUCHT: Totenstachel, Terror der Wüste‡현상 수배: 사막의 난폭자 죽음의 갈고리‡Se busca: Pinzamorten el Terror de las arenas‡Se busca: Pinzamorten el Terror de las arenas‡On recherche : Poigne-de-mort, Terreur des sables‡通缉：死亡弯钩‡通緝:死亡彎鉤',
    nil,
    'Leve a Tenaz da Agarramata para Vish Kozus, Capitão da Guarda.‡Принесите хелицеры Смертехвата Вишу Коцусу, капитану стражи.‡Bringt Totenstachels Zange zu Vish Kozus, Hauptmann der Wache.‡경비대장 비쉬 코주스에게 죽음의 갈고리 집게발을 가져가야 합니다.‡Lleva la pinza de Pinzamorten a Vish Kozus, Capitán de la guardia.‡Lleva la pinza de Pinzamorten a Vish Kozus, Capitán de la guardia.‡Apporter la Pince de Poigne-de-mort à Vish Kozus, capitaine de la garde.‡将死亡弯钩的蝎钳交给卫兵队长维斯·库鲁兹。‡將死亡彎鉤的刺針帶給守衛隊長維斯·庫魯茲。',
  }
},
[8284] = {
  {
    'O mistério do crepúsculo‡Сумеречная тайна‡Das Geheimnis des Zwielichts‡황혼의 망치단의 비밀‡El misterio Crepuscular‡El misterio Crepuscular‡Le mystère du Crépuscule‡暮光的秘密‡暮光的秘密',
    nil,
    'A Geóloga Matarriso, no Forte Cenariano, quer que você recolha 8 Fragmentos de Tabuleta do Crepúsculo.‡Геолог Ехидная из крепости Кенария просит вас собрать 8 фрагментов сумеречной таблички.‡Geologin Lerchenbann auf Burg Cenarius in Silithus möchte, dass Ihr ihr 8 Schrifttafelfragmente des Schattenhammerklans bringt.‡실리더스의 세나리온 요새에 있는 지질학자 락스베인이 황혼의 서판 조각 8개를 모아 달라고 했습니다.‡La Geóloga Trotuina en el Fuerte Cenarion, en Silithus, quiere que consigas 8 fragmentos de tablilla Crepuscular.‡La Geóloga Trotuina en el Fuerte Cenarion, en Silithus, quiere que consigas 8 fragmentos de tablilla Crepuscular.‡La géologue Fablemort du Fort cénarien en Silithus veut que vous rassembliez 8 Fragments de la tablette du Crépuscule.‡希利苏斯塞纳里奥要塞的地质学家拉克斯班要你去收集8块暮光石板碎片。‡希利蘇斯的塞納里奧城堡的地理學家拉克斯班要你去收集8個暮光石板碎片。',
  }
},
[8285] = {
  {
    'O desertor‡Дезертир‡Der Deserteur‡황혼의 망치단 탈영병‡El desertor‡El desertor‡Le déserteur‡沙漠隐士‡沙漠隱士',
    nil,
    'Leve a tabuleta restaurada para o Eremita Ortell em Silithus.‡Отнесите восстановленную табличку отшельнику Ортеллу в Силитус.‡Bringt die wiederhergestellte Schrifttafel zu Ortell dem Einsiedler in Silithus.‡실리더스에 있는 은둔자 오르텔에게 복원한 서판을 가져가야 합니다.‡Lleva la tablilla restaurada a Ermitaño Ortell en Silithus.|n‡Lleva la tablilla restaurada a Ermitaño Ortell en Silithus.|n‡Apportez la Tablette réparée à l\'ermite Ortell à Silithus.‡把复原的石板带给希利苏斯的隐士奥泰尔。‡帶著修補的石板去找希利蘇斯的隱士奧泰爾。',
  }
},
[8286] = {
  {
    'O que nos traz o dia de amanhã‡Что день грядущий нам готовит‡Was uns morgen erwartet‡미래의 운명‡Lo que nos depara el futuro‡Lo que nos depara el futuro‡Ce que demain apportera‡明天的希望‡明天的希望',
    nil,
    'Adentre as Cavernas do Tempo, em Tanaris, e encontre Anacronos, Prole de Nozdormu.‡Отправляйтесь в Пещеры Времени в Танарисе и найдите Анахроноса, из рода Ноздорму.‡Reist zu den Höhlen der Zeit in Tanaris und findet Anachronos, Nachkomme Nozdormus.‡타나리스에 있는 시간의 동굴로 가서 노즈도르무 혈족인 아나크로노스를 찾아야 합니다.‡Ve a las Cavernas del Tiempo en Tanaris y encuentra a Anacronos, del Linaje de Nozdormu.‡Ve a las Cavernas del Tiempo en Tanaris y encuentra a Anacronos, del Linaje de Nozdormu.‡Rendez-vous dans les Grottes du temps en Tanaris et trouvez Anachronos, la progéniture de Nozdormu.‡前往塔纳利斯的时光之穴寻找诺兹多姆的子嗣，阿纳克洛斯。|n|n完成任务后回到希利苏斯塞纳里奥要塞的流沙守望者巴里斯托尔斯那儿。‡到塔納利斯的時光之穴尋找諾茲多姆的子嗣安納克羅斯。',
  }
},
[8287] = {
  {
    'Intenção terrível‡Ужасная цель‡Ein teuflischer Plan‡황혼의 망치단의 존재‡Un propósito terrible‡Un propósito terrible‡Un terrible but‡摆脱困境‡擺脫困境',
    nil,
    'Leve a Transcrição Decodificada da Tabuleta para o Comandante Mar\'alith.‡Отнесите переписанный с таблички расшифрованный текст командору Мар\'алиту.‡Bringt Kommandant Mar\'alith die entschlüsselte Abschrift der Schrifttafel.‡지휘관 마랄리스에게 해독된 서판 탁본을 가져가야 합니다.‡Lleva la trascripción de tablilla decodificada al comandante Mar\'alith.‡Lleva la trascripción de tablilla decodificada al comandante Mar\'alith.‡Remettez la Transcription décodée de la tablette au commandant Mar\'alith.‡把解密石板碑文交给指挥官玛尔利斯。‡將解譯過的碑文羊皮紙交給指揮官瑪爾利斯。',
  }
},
[8288] = {
  {
    'Só pode ascender um‡Кто будет избран?‡Nur einer kann sich erheben‡최후의 한 명‡Solo uno puede alzarse‡Solo uno puede alzarse‡Il ne peut y en avoir qu\'un‡唯一的领袖‡唯一的領袖',
    nil,
    'Leve a Cabeça do Prolemestre Flagelador para Baristolth das Areias Cambiantes no Forte Cenariano, em Silithus.‡Принесите голову предводителя драконов Разящего Бича Баристольфу из Зыбучих Песков в крепость Кенария в Силитусе.‡Bringt Brutwächter Dreschbringers Kopf zu Baristolth der Sandstürme in die Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 흐르는 모래의 바리스톨스에게 용기대장 래쉬레이어의 머리를 가져가야 합니다.‡Lleva la cabeza del Señor de linaje Capazote a Baristolth del Mar de Dunas al Fuerte Cenarion en Silithus.‡Lleva la cabeza del Señor de linaje Capazote a Baristolth del Mar de Dunas al Fuerte Cenarion en Silithus.‡Ramenez la Tête du seigneur des couvées Lanistaire à Baristolth des Sables changeants, au Fort cénarien en Silithus.‡到黑石山中的奈法利安巢穴去，杀死勒什雷尔，并带回它的徽记。|n|n将勒什雷尔的徽记交给希利苏斯塞纳里奥要塞的流沙守望者巴里斯托尔斯。‡帶著幼龍領主勒西雷爾的頭顱回到希利蘇斯，到塞納里奧城堡的流沙之地找巴里斯托爾斯。',
  }
},
[8289] = {
  {
    '‡Талисманы заслуг‡Verdienstabzeichen‡‡Talismanes del mérito‡Talismanes del mérito‡Talismans de vaillance‡功勋奖章‡',
    nil,
    nil,
  }
},
[8296] = {
  {
    '‡Почетный знак‡Ehrenabzeichen‡‡Marca de Honor‡Marca de Honor‡Marque d\'honneur‡荣誉奖章‡',
    nil,
    nil,
  }
},
[8301] = {
  {
    'O caminho do íntegros‡Путь праведника‡Der Pfad des Gerechten‡정의의 길‡El camino del honrado‡El camino del honrado‡Le Chemin des Justes‡正义之路‡正義之路',
    nil,
    'Colete 200 Fragmentos de Carapaça Silitídea e fale novamente com Baristolth.‡Принесите Баристолфу 200 фрагментов силитидских панцирей.‡Kehrt zu Baristolth zurück, sobald Ihr 200 Silithidenknochenpanzerfragmente gesammelt habt.‡실리시드 등껍질 조각 200개를 모아 바리스톨스에게 가져가야 합니다.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Récupérez 200 Fragments de carapaces de silithides et retournez voir Baristolth.‡希利苏斯塞纳里奥要塞的流沙守望者巴里斯托尔斯想要你杀死亚什虫巢、佐拉虫巢和雷戈虫巢中的异种虫类。从死去的虫子尸体上收集异种蝎壳碎片。当你收集到200块异种蝎壳碎片时，回到巴里斯托尔斯那儿去。|n|n作为一名诺兹多姆的特使，只有你和你的副官可以从异种虫类的尸体上拾取异种蝎壳碎片。请注意保持你的包裹空间足够多。‡為流沙守望者巴里斯托爾斯收集200塊異種蠍殼碎片。',
  }
},
[8302] = {
  {
    'A mão do íntegro‡Рука праведника‡Die Hand der Gerechtigkeit‡정의의 손길‡La mano del honrado‡La mano del honrado‡La Main des Justes‡正义之手‡正義之手',
    nil,
    'Colete 200 Fragmentos de Carapaça Silitídea e fale novamente com Baristolth.‡Принесите Баристолфу 200 фрагментов силитидских панцирей.‡Kehrt zu Baristolth zurück, sobald Ihr 200 Silithidenknochenpanzerfragmente gesammelt habt.‡실리시드 등껍질 조각 200개를 모아 바리스톨스에게 가져가야 합니다.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Récupérez 200 Fragments de carapaces de silithides et retournez voir Baristolth.‡希利苏斯塞纳里奥要塞的流沙守望者巴里斯托尔斯想要你杀死亚什虫巢、佐拉虫巢和雷戈虫巢中的异种虫类。从死去的虫子尸体上收集异种蝎壳碎片。当你收集到200块异种蝎壳碎片时，回到巴里斯托尔斯那儿去。‡為流沙守望者巴里斯托爾斯收集200塊異種蠍殼碎片。',
  }
},
[8303] = {
  {
    'Anacronos‡‡Anachronos‡아나크로노스‡‡‡Anachronos‡阿纳克洛斯‡安納克羅斯',
    nil,
    'Encontre Anacronos nas Cavernas do Tempo, em Tanaris.‡Отыщите Анахроноса в Пещерах Времени в Танарисе.‡Sucht nach Anachronos bei den Höhlen der Zeit in Tanaris.‡타나리스의 시간의 동굴에 있는 아나크로노스를 찾아가야 합니다.‡Busca a Anacronos en las Cavernas del Tiempo de Tanaris.‡Busca a Anacronos en las Cavernas del Tiempo de Tanaris.‡Cherchez Anachronos dans les Grottes du temps à Tanaris.‡到塔纳利斯的时光之穴去寻找阿纳克洛斯。‡去塔納利斯的時光之穴尋找安納克羅斯。',
  }
},
[8304] = {
  {
    'Querida Natália‡Дражайшая Наталия‡Liebste Natalia‡사랑하는 여군주 나탈리아‡Queridísima Natalia‡Queridísima Natalia‡Chère Natalia‡亲爱的纳塔莉亚‡親愛的娜塔莉亞',
    nil,
    'Questione Frankal e Rutgar no Acampamento do Barbabronze sobre o paradeiro de Natália Mar\'alith.‡Допросите Франкала и Рутгара в лагере Бронзоборода о местонахождении Наталии Мар\'алит.‡Befragt Frankal und Rutgar in Bronzebarts Lager über den Aufenthaltsort von Natalia Mar\'alith.‡브론즈비어드 야영지에 있는 프랭칼 스톤브리지와 루트거 글립쉐이퍼에게 여군주 나탈리아 마랄리스의 행방에 대해서 물어봐야 합니다.‡Interroga a Frankal y a Rutgar en el Campamento Barbabronce acerca del paradero de Natalia Mar\'alith.‡Interroga a Frankal y a Rutgar en el Campamento Barbabronce acerca del paradero de Natalia Mar\'alith.‡Interrogez Frankal et Rutgar au Campement de Barbe-de-bronze pour savoir où se trouve Natalia Mar’alith.‡询问铜须营地的弗兰卡和鲁特加尔，了解纳塔莉亚·玛尔利斯的去向。‡去銅鬚營地詢問法蘭克爾和魯特加爾有關娜塔莉亞·瑪爾利斯的行蹤。',
  }
},
[8305] = {
  {
    'Relembranças longínquas‡Давно забытые воспоминания‡Lang Vergessenes‡잊혀진 오랜 기억‡Recuerdos olvidados‡Recuerdos olvidados‡Des souvenirs oubliés depuis longtemps‡久远的记忆‡久遠的記憶',
    nil,
    'Localize a Lágrima Cristalina em Silithus, e contemple suas profundezas.‡Отыщите в Силитусе хрустальную слезу и загляните в ее глубины.‡Sucht die Kristallträne in Silithus und blickt in ihr Innerstes.‡실리더스에서 눈물의 결정의 위치를 찾아 그 안을 응시해야 합니다.‡Encuentra la lágrima cristalina en Silithus y mira en sus profundidades.‡Encuentra la lágrima cristalina en Silithus y mira en sus profundidades.‡Trouvez la Larme cristalline, en Silithus, et contemplez ses profondeurs.‡希利苏斯时光之穴的阿纳克洛斯想要你前往位于希利苏斯南部沙漠的甲虫之台。|n|n当你学习完毕后再回到他那儿去。‡找到希利蘇斯的結晶之淚並注視它的深處。',
  }
},
[8306] = {
  {
    'No ventre da loucura‡В бездне безумия‡Der Schlund des Wahnsinns‡광란의 하이브레갈로‡En las fauces de la locura‡En las fauces de la locura‡L\'antre de la folie‡深入疯狂之喉‡深入瘋狂之口',
    nil,
    'O Comandante Mar\'alith do Forte Cenariano em Silithus quer que você encontre Natália. A informação que conseguiu aponta para Colme\'Régia, ao sul, como sendo a área em que você encontrará a Senhora Natália Mar\'alith.|n|nNão se esqueça de falar com os anões no acampamento do Barbabronze antes de se aventurar na colmeia. Eles podem ter algum trabalho e conselhos para você.|n|nE, Bomdiyada, lembre-se das palavras do Comandante: "Faça o que for necessário..."‡Найдите возлюбленную командора Мар\'алита из крепости Кенария в Силитусе. По имеющим сведениям, госпожу Наталию Мар\'алит можно найти в улье Регал.|n|nПрежде чем отправляться в улей, не забудьте поговорить с дворфами из лагеря Бронзоборода. Они могут дать пару советов и подкинуть дополнительную работу.|n|nСледует помнить слова командора: "Сделай, что должно..."‡Kommandant Mar\'alith auf Burg Cenarius in Silithus möchte, dass Ihr seine geliebte Natalia wiederfindet. Die von Euch gesammelten Informationen deuten darauf hin, dass Ihr sie im Bau des Regalschwarms im Süden finden könntet.|n|nSprecht noch einmal mit den Zwergen in Bronzebarts Lager, bevor Ihr Euch in den Schwarmbau begebt. Ihr Wissen könnte sich als hilfreich erweisen und sicherlich, haben sie noch einige Aufgaben für Euch.|n|nUnd Bomdiyada, denkt an die Worte des Kommandanten: "Tut, was Ihr tun müsst..."‡실리더스의 세나리온 요새에 있는 지휘관 마랄리스가 여군주 나탈리아를 찾아 달라고 했습니다. 수집된 정보에 의하면 남쪽에 있는 하이브레갈에서 여군주 나탈리아 마랄리스를 찾을 수 있을 겁니다.|n|n곤충 집에 들어가기 전에 브론즈비어드 야영지에 있는 드워프들을 찾아가야 합니다. 드워프들이 조언과 함께 다른 일을 줄 것입니다.|n|n마지막으로 마랄리스가 했던 말 \'그대가 해야 할 일을 하라.\'를 기억해야 합니다.‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que encuentres a su amada Natalia. Parece que podría estar en Colmen\'Regal, hacia el sur. |n|nNo olvides ir a ver a los enanos del campamento Barbabronce antes de ir a la colmena; puede que tengan otras tareas o consejos que darte. |n|nY, Bomdiyada, recuerda lo que dijo el comandante: "Haz lo que tengas que hacer."‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que encuentres a su amada Natalia. Parece que podría estar en Colmen\'Regal, hacia el sur. |n|nNo olvides ir a ver a los enanos del campamento Barbabronce antes de ir a la colmena; puede que tengan otras tareas o consejos que darte. |n|nY, Bomdiyada, recuerda lo que dijo el comandante: "Haz lo que tengas que hacer."‡Le Commandant Mar\'alith au Fort cénarien en Silithus veut que vous retrouviez sa bien-aimée, Natalia. Selon les informations que vous avez réunies, la Ruche\'Regal au sud serait l\'endroit où vous pourriez trouver Dame Natalia Mar\'alith.|n|nN\'oubliez pas de rendre visite aux nains au camp de Barbe-de-bronze avant de vous aventurer dans la ruche. Ils ont peut-être d\'autres tâches à vous confier et des conseils pour vous.|n|nEt Bomdiyada, souvenez-vous des mots du commandant : « Faites votre devoir… »‡希利苏斯塞纳里奥要塞的指挥官玛尔利斯想要你找到他心爱的纳塔莉亚。你收集到的信息表明纳塔莉亚·玛尔利斯可能在南面的雷戈虫巢。|n|n在你赶往虫巢之前，记得去铜须营地拜访一下那儿的矮人，他们或许会给你提些建议。|n|nNekotestthre，记住指挥官的话：做你应该做的......‡希利蘇斯，塞納里奧城堡的指揮官瑪爾利斯要你去找尋他摯愛的娜塔莉亞。你所收集到的資訊指出，南方的雷戈蟲巢就是你可以找到娜塔莉亞·瑪爾利斯夫人的地方。|n|n別忘記在進入蟲巢之前先去拜訪銅鬚營地的矮人。他們可能有一些額外的工作和建議要給你。|n|n還有Bomdiyada，記得指揮官的話:「做你該做的...」',
  }
},
[8307] = {
  {
    'Receita do deserto‡Блюдо из червей‡Wüstenrezept‡사막의 조리법‡Receta del desierto‡Receta del desierto‡Recette du désert‡沙漠食谱‡沙漠食譜',
    nil,
    'Procure informações sobre como cozinhar Carne de Verme da Areia no acampamento do Martelo do Crepúsculo, a oeste do Forte Cenariano.‡Поищите в лагере Сумеречного Молота на западе от крепости Кенария сведения о приготовлении мяса песчаных червей.‡Haltet beim Lager des Schattenhammers westlich von Burg Cenarius nach Informationen zum Zubereiten von Sandwurmfleisch Ausschau.‡세나리온 요새 서쪽에 있는 황혼의 망치단 주둔지로 가서 미늘벌레 고기 조리법에 대한 정보를 알아내야 합니다.‡Busca información sobre cómo cocinar carne de gusano de arena en el Campamento del Martillo Crepuscular, al oeste del Fuerte Cenarion.‡Busca información sobre cómo cocinar carne de gusano de arena en el Campamento del Martillo Crepuscular, al oeste del Fuerte Cenarion.‡Cherchez des informations sur la façon de cuisiner la Chair de Ver des sables au camp du Marteau du crépuscule à l\'ouest du Fort cénarien.‡前往塞纳里奥要塞以西的暮光之锤营地，调查沙虫的烹饪方法。‡在塞納里奧城堡西方的暮光之錘營地尋找關於烹煮沙蟲肉的資訊。',
  }
},
[8308] = {
  {
    'A carta perdida de Brann Barbabronze‡Потерянное письмо Бранна Бронзоборода‡Der verlorene Brief von Brann Bronzebart‡브란 브론즈비어드의 잃어버린 편지‡La carta perdida de Brann Barbabronce‡La carta perdida de Brann Barbabronce‡La lettre perdue de Brann Barbe-de-bronze‡布莱恩·铜须的信‡布萊恩·銅鬚遺失的信件',
    nil,
    'Leve a Carta de Brann Barbabronze para o Acampamento do Barbabronze na região sul de Silithus.‡Отнесите письмо Бранна Бронзоборода в лагерь Бронзоборода в южной части Силитуса.‡Liefert Brann Bronzebarts verlorenen Brief in Bronzebarts Lager im südlichen Silithus ab.‡실리더스 남쪽에 있는 브론즈비어드 야영지에 브란 브론즈비어드의 잃어버린 편지를 가져가야 합니다.‡Lleva la carta de Brann Barbabronce al campamento Barbabronce al sur de Silithus.‡Lleva la carta de Brann Barbabronce al campamento Barbabronce al sur de Silithus.‡Apporter la Lettre de Brann Barbe-de-bronze au Campement de Barbe-de-bronze dans le sud de Silithus.‡将布莱恩·铜须的信件带往希利苏斯南部的铜须营地。‡將布萊恩·銅鬚的信帶到希利蘇斯南邊的銅鬚營地去。',
  }
},
[8309] = {
  {
    'À procura de glifos‡Поиски рун‡Glyphenjagd‡상형 문자 추적‡Los grabados de los glifos‡Los grabados de los glifos‡À la poursuite des glyphes‡追查雕文‡追查雕紋',
    nil,
    'Use o Kit de Transcrição do Geólogo para obter um Decalque de Colme\'Régia do Cristal Entalhado de Glifos de Colme\'Régia.‡При помощи копирующего устройства геолога получите оттиск покрытого письменами кристалла из Улья Регал.‡Benutzt das Abschriftenset für Geologen, um ein Abpausbild des glyphenverzierten Kristalls des Regalschwarms anzufertigen.‡지질학자의 탁본 도구를 사용하여 문자가 새겨진 하이브레갈 수정에서 하이브레갈 탁본을 만들어야 합니다.‡Utiliza el estuche de transcripción de geólogo para obtener un calco de Colmen\'Regal del cristal con inscripciones de Colmen\'Regal.‡Utiliza el estuche de transcripción de geólogo para obtener un calco de Colmen\'Regal del cristal con inscripciones de Colmen\'Regal.‡Utilisez la Trousse de transcription du géologue pour obtenir une Retranscription de la Ruche’Regal à partir du Cristal orné de glyphes de la Ruche’Regal.‡使用地质学家的抄录工具包，从雷戈虫巢雕文水晶上获取雷戈拓印。‡使用地質學家的抄錄工具從雷戈蟲巢的雕紋水晶上獲取雷戈蟲巢的摹本。',
  }
},
[8310] = {
  {
    'Quebrando o código‡Расшифровка‡Knackt den Kode‡상형 문자 판독‡Descifrar el código‡Descifrar el código‡Déchiffrer le code‡破译密码‡破解密碼',
    nil,
    'Obtenha um Cérebro de Silitídeo de Colme\'Régia intacto de qualquer silitídeo em Colme\'Régia.‡Добудьте мозг силитида из улья Регал.‡Erhaltet ein intaktes Silithidengehirn des Regalschwarms von einem beliebigen Silithiden im Bau des Regalschwarms.‡하이브레갈에 있는 실리시드에게서 온전한 하이브레갈 실리시드 뇌를 얻어야 합니다.‡Obtén un cerebro silítido de Colmen\'Regal de cualquier silítido de Colmen\'Regal.‡Obtén un cerebro silítido de Colmen\'Regal de cualquier silítido de Colmen\'Regal.‡Obtenez un Cerveau de silithide intact provenant de la Ruche’Regal. N’importe quel silithide de cette ruche fera l’affaire.‡从雷戈虫巢的异种虫身上获得一颗完整的雷戈异种虫脑。‡從雷戈蟲巢任何一種異種蟲取回一個完整的雷戈異種蟲腦。',
  }
},
[8311] = {
  {
    'Gostosuras da Noturnália para Jacinto!‡Тыквовинские вкусности для Джеспера!‡Schlotternachtssüßigkeiten für Jesper!‡제스퍼를 위해 할로윈 축제 사탕 모으기!‡Golosinas de Halloween para Jesper‡Golosinas de Halloween para Jesper‡Des bonbons de la Sanssaint pour Jesper !‡耶斯帕尔的万圣节糖果！‡賈斯伯的萬鬼節糖果!',
    nil,
    'Fale com os estalajadeiros de Ventobravo, Altaforja e Darnassus, e também com Didiê Du Mocó, em Altaforja. Pague as prendas que eles pedirem em troca de gostosuras.|n|nLeve um Marzipan de Darnassus, uma Jujuba de Gnomeregan, um Nougat de Ventobravo e uma Balinha de Altaforja para Jacinto, que está em frente a Ventobravo.‡Поговорите с хозяевами таверн в Штормграде, Стальгорне и Дарнасе, а также с Талвашем дель Кисселем в Стальгорне. Выполните то, что они потребуют за предлагамые ими сладости.|n|nВернитесь к Джесперу в сиротский приют Штормграда и принесите ему марципан Дарнаса, леденец Гномрегана, нугу из Штормграда и мятную конфету Стальгорна.‡Sprecht mit den Gastwirten in Sturmwind, Eisenschmiede und Darnassus sowie mit Talvash del Kissel in Eisenschmiede. Führt ihnen vor, nach was sie im Gegenzug für die Süßigkeiten verlangen.|n|nKehrt zu Jesper außerhalb von Sturmwind mit einem Marzipan aus Darnassus, einer Kaugummikugel aus Gnomeregan, Nugat aus Sturmwind und einem Pfefferminzbonbon aus Eisenschmiede zurück.‡스톰윈드, 아이언포지, 다르나서스의 여관 주인들, 아이언포지에 있는 탈바쉬 델 키젤과 대화해야 합니다. 그들이 원하는 행동을 보여 주면 상으로 사탕을 받을 수 있습니다.|n|n스톰윈드 바깥에 있는 제스퍼에게 스톰윈드 초코바, 놈리건 젤리, 아이언포지 박하사탕, 다르나서스 양갱을 가져가야 합니다.‡Habla con los taberneros de Ventormenta, Forjaz y Darnassus, así como con Talvash del Kissel en Forjaz. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|n|nVuelve a ver a Jesper frente a Ventormenta con un mazapán de Darnassus, una gominola de Gnomeregan, un almendrado de Ventormenta y una menta de Forjaz.‡Habla con los taberneros de Ventormenta, Forjaz y Darnassus, así como con Talvash del Kissel en Forjaz. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|n|nVuelve a ver a Jesper frente a Ventormenta con un mazapán de Darnassus, una gominola de Gnomeregan, un almendrado de Ventormenta y una menta de Forjaz.‡Parler aux aubergistes de Hurlevent, de Forgefer, de Darnassus, et à Talvash del Kissel à Forgefer. Accomplissez les blagues qu\'ils vous demanderont de faire en échange de bonbons.|n|nRetournez voir Jesper devant Hurlevent avec un Massepain de Darnassus, une Boule de gomme de Gnomeregan, du Nougat de Hurlevent et un Bonbon à la menthe de Forgefer.‡与暴风城、铁炉堡、达纳苏斯的旅店老板，以及铁炉堡的塔瓦斯德·基瑟尔谈一谈。按照他们的要求做出动作，并获得他们的礼物。|n|n把达纳苏斯水果糖、诺莫瑞根橡皮糖、暴风城杏仁糖和铁炉堡薄荷糖交给暴风城外的耶斯帕尔。‡和暴風城、鐵爐堡、達納蘇斯的旅店老闆及鐵爐堡的塔瓦斯德·基瑟爾交談。完成要求的惡作劇來交換他們提供的糖果。|n|n將達納蘇斯杏仁糖、諾姆瑞根橡皮糖、暴風城牛軋糖，和鐵爐堡薄荷糖帶回暴風城前面給賈斯伯。',
  }
},
[8312] = {
  {
    'Gostosuras de Noturnália para Assustosa!‡Тыквовинские вкусности для Крохи!‡Schlotternachtssüßigkeiten für Spuks!‡스풉스를 위해 할로윈 축제 사탕 모으기!‡Golosinas de Halloween para Pupas‡Golosinas de Halloween para Pupas‡Des bonbons de la Sanssaint pour Spoops !‡斯波普斯的万圣节糖果！‡史波普的萬鬼節糖果!',
    nil,
    'Fale com os estalajadeiros de Orgrimmar, do Bairro Inferior e do Penhasco do Trovão, e também com Kali Remik, no Vale dos Espíritos de Orgrimmar. Pague as prendas que eles pedirem e receba doces como recompensa.|n|nLeve um Marzipã do Penhasco do Trovão, uma Jujuba Lançanegra, um Nougat de Orgrimmar e uma Balinha do Bairro Inferior para Assustosa, nas Ruínas de Lordaeron.‡Поговорите с хозяевами таверн в Оргриммаре, Подгороде и Громовом Утесе, а также с Кали Ремик в Аллее Духов Оргриммара. Выполните то, что они потребуют, за предлагамые ими сладости.|n|nВернитесь к Крохе в сиротский приют Оргриммара и принесите ей марципан Громового Утеса, леденец троллей Черного Копья, нугу из Оргриммара и мятную конфету Подгорода.‡Sprecht mit den Gastwirten in Orgrimmar, Unterstadt und Donnerfels sowie mit Kali Remik im Tal der Geister in Orgrimmar. Führt ihnen vor, nach was sie im Gegenzug für die Süßigkeiten verlangen.|n|nKehrt zu Spuks in den Ruinen von Lordaeron mit einem Marzipan aus Donnerfels, einer Kaugummikugel der Dunkelspeere, Nugat aus Orgrimmar und einem Pfefferminzbonbon aus Unterstadt zurück.‡오그리마, 언더시티, 썬더 블러프의 여관 주인들, 그리고 오그리마 내 정기의 골짜기에 있는 칼리 레믹과 대화해야 합니다. 그들이 원하는 행동을 보여 주면 사탕을 받을 수 있습니다.|n|n로데론의 폐허에 있는 스풉스에게 썬더 블러프 양갱, 검은창 젤리, 오그리마 초코바, 언더시티 박하사탕을 가져가야 합니다.‡Habla con los taberneros de Orgrimmar, Entrañas y Cima del Trueno y con Kali Remik en el Valle de los Espíritus de Orgrimmar. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|n|nVuelve a ver a Pupas en las Ruinas de Lordaeron con un mazapán de Cima del Trueno, una gominola de Lanza Negra, un almendrado de Orgrimmar y una menta de Entrañas.‡Habla con los taberneros de Orgrimmar, Entrañas y Cima del Trueno y con Kali Remik en el Valle de los Espíritus de Orgrimmar. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|n|nVuelve a ver a Pupas en las Ruinas de Lordaeron con un mazapán de Cima del Trueno, una gominola de Lanza Negra, un almendrado de Orgrimmar y una menta de Entrañas.‡Parler aux aubergistes d\'Orgrimmar, de Fossoyeuse, des Pitons-du-Tonnerre, et à Kali Remik au village de Sen\'jin. Accomplissez les blagues qu\'ils vous demanderont de faire en échange de bonbons.|n|nRetournez voir Spoops dans les Ruines de Lordaeron avec un Massepain des Pitons-du-Tonnerre, une Boule de gomme sombrelance, du Nougat d\'Orgrimmar et un Bonbon à la menthe de Fossoyeuse.‡与奥格瑞玛、幽暗城、雷霆崖的旅店老板，以及奥格瑞玛精神谷的卡利·雷米克谈一谈。按照他们的要求做出动作，并获得他们的礼物。|n|n把雷霆崖奶糖、暗矛橡皮糖、奥格瑞玛软糖和幽暗城薄荷糖交给洛丹伦废墟的斯波普斯。‡和奧格瑪、幽暗城、雷霆崖的旅店老闆及奧格瑪精神谷的卡利·雷米克交談。完成要求的惡作劇來交換他們提供的糖果。|n|n將雷霆崖杏仁糖、暗矛橡皮糖、奧格瑪牛軋糖和幽暗城薄荷糖帶回羅德隆廢墟給史波普。',
  }
},
[8313] = {
  {
    'Compartilhando o conhecimento‡Наделение знаниями‡Geteiltes Wissen‡지식 공유‡Compartir el conocimiento‡Compartir el conocimiento‡Partager la connaissance‡分享知识‡分享知識',
    nil,
    'Leve a Página Rasgada de Receita para Calandrath na estalagem do Forte Cenariano.‡Принесите вырванную страницу с рецептом Каландрате в таверну крепости Кенария.‡Bringt die ausgerissene Rezeptseite zu Calandrath ins Gasthaus der Burg Cenarius.‡세나리온 요새 여관에 있는 캘랜드라스에게 찢어낸 조리법 페이지를 가져가야 합니다.‡Lleva la página de receta rota a Calandrath en la taberna del Fuerte Cenarion.‡Lleva la página de receta rota a Calandrath en la taberna del Fuerte Cenarion.‡Remettre la Page de recette déchirée à Calandrath, à l\'auberge du Fort cénarien.‡将破碎的食谱交给塞纳里奥要塞旅店中的卡兰德拉斯。‡將破碎的食譜交給塞納里奧城堡旅店中的卡蘭德拉斯。',
  }
},
[8314] = {
  {
    'Desvendando o mistério‡Разгадка тайны‡Des Rätsels Lösung‡밝혀지는 비밀‡Desentrañar el misterio‡Desentrañar el misterio‡Dévoiler le mystère‡揭开秘密‡解開謎題',
    nil,
    'Entregue o Prisma de Cristal com Glifos para a Geóloga Larksbane no Forte Cenariano, que fica em Silithus.‡Принесите покрытую письменами хрустальную призму геологу Ехидной в Крепость Кенария, что в Силитусе.‡Bringt das glyphenverzierte Kristallprisma zu Geologin Lerchenbann auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 지질학자 락스베인에게 문자가 새겨진 수정 프리즘을 전달해야 합니다.‡Entrégale el prisma de cristal con inscripciones a la geóloga Trotuina en el Fuerte Cenarion de Silithus.‡Entrégale el prisma de cristal con inscripciones a la geóloga Trotuina en el Fuerte Cenarion de Silithus.‡Remettez le Prisme cristallin orné de glyphes à la géologue Fablemort au Fort cénarien, en Silithus.‡将雕文水晶棱柱交给希利苏斯塞纳里奥要塞的地质学家拉克斯班。‡將雕紋水晶稜柱交給希利蘇斯塞納里奧城堡的地質學家拉克斯班。',
  }
},
[8315] = {
  {
    '‡Зов‡Die Anrufung‡‡La llamada‡La llamada‡L\'appel‡召唤‡呼喚',
    nil,
    '‡Геолог Ехидная из Крепости Кенария просит добыть открыватель Кристаллов у киражского посланника.|n|nВам следует отнести письмена зова к Костям Граккаронда, на юг от Крепости Кенария, и нарисовать их на песке. Если появится киражский посланник, убейте его и заберите открыватель Кристаллов. При успехе вернитесь к геологу Ехидной.|n|nДля выполнения задания понадобится целая армия!‡Geologin Lerchenbann auf Burg Cenarius in Silithus möchte, dass Ihr ihr den Kristallentriegelungsmechanismus vom Abgesandten der Qiraji beschafft.|n|nNehmt die Glyphen der Anrufung, begebt Euch zu den Knochen von Grakkarond südlich von Burg Cenarius und zeichnet sie dort in den Sand. Sollte der Abgesandte der Qiraji erscheinen, tötet ihn und nehmt den Kristallentriegelungsmechanismus an Euch. Kehrt anschließend zu Geologin Lerchenbann zurück.|n|nFür diese Aufgabe werdet Ihr eine kleine Armee benötigen, Scanner!‡‡La Geóloga Trotuina del Fuerte Cenarion de Silithus quiere que consigas el mecanismo de desbloqueo de los cristales del emisario qiraji. |n|nTienes que llevar los glifos a Huesos de Grakkarond, al sur del Fuerte Cenarion, y dibujarlos en la arena. Si aparece el emisario qiraji, mátalo y coge el mecanismo de desbloqueo de los cristales. Si lo consigues, ve a ver a la geóloga Trotuina. |n|n¡Lleva un ejército contigo, $N!‡La Geóloga Trotuina del Fuerte Cenarion de Silithus quiere que consigas el mecanismo de desbloqueo de los cristales del emisario qiraji. |n|nTienes que llevar los glifos a Huesos de Grakkarond, al sur del Fuerte Cenarion, y dibujarlos en la arena. Si aparece el emisario qiraji, mátalo y coge el mecanismo de desbloqueo de los cristales. Si lo consigues, ve a ver a la geóloga Trotuina. |n|n¡Lleva un ejército contigo, $N!‡La géologue Fablemort, au Fort cénarien en Silithus, veut que vous récupériez le Mécanisme de déverrouillage du cristal sur le Maître des clés.|n|nElle vous a demandé de vous rendre près des Restes de Grakkarond, au sud du Fort cénarien, et d\'y dessiner les glyphes d\'appel dans le sable. Si le Maître des clés apparaît, tuez-le et récupérez le Mécanisme de déverrouillage du cristal. Ensuite, si vous avez réussi, retournez voir la géologue Fablemort.|n|nElle vous a conseillé d\'emmener une armée, Scanner.‡希利苏斯塞纳里奥要塞的地质学家拉克斯班想让你从其拉虫人使者那里取回水晶分解装置。|n|n你已经奉命将召唤雕文带往塞纳里奥要塞以南的格拉卡隆之骨处，将它们从沙中引出。一旦其拉虫人使者露面，就杀死它，获得水晶分解装置。成功之后回到地质学家拉克斯班那儿去。|n|n你必须召集一支强大的军队来完成这项任务，Nekotestthre！‡希利蘇斯塞納里奧城堡的地質學家拉克斯班想讓你從其拉蟲人使者那裏取回水晶分解裝置。|n|n你已經奉命將召喚雕紋帶往塞納里奧城堡以南的格拉卡隆之骨處，將它們從沙中引出。一旦其拉蟲人使者露面，就殺死它，獲得水晶分解裝置。成功之後回到地質學家拉克斯班那兒去。|n|n你必須召集一支強大的軍隊來完成這項任務，Scanner!',
  }
},
[8316] = {
  {
    '‡Оружие войны‡Kriegsausrüstung‡‡Armamentos de guerra‡Armamentos de guerra‡Armes de guerre‡军备物资‡',
    nil,
    nil,
  }
},
[8317] = {
  {
    'Assistência culinária‡Помощь по кухне‡Küchengehilfe‡주방 보조‡Echar una mano en la cocina‡Echar una mano en la cocina‡Un coup de main à la cuisine‡下厨‡廚房助手',
    nil,
    'Calandrath, no Forte Cenariano, precisa de uma porção de 10 Bolinhos Defumados do Deserto.‡Каландрате из крепости Кенария нужны 10 копченых пустынных клецок.‡Calandrath von der Burg Cenarius braucht 10 geräucherte Wüstenknödel.‡세나리온 요새의 캘랜드라스가 훈제 사막 경단 10개를 가져다 달라고 했습니다.‡Calandrath, en el Fuerte Cenarion, necesita una entrega de 10 albóndigas del desierto ahumadas.‡Calandrath, en el Fuerte Cenarion, necesita una entrega de 10 albóndigas del desierto ahumadas.‡Calandrath, du Fort cénarien, a besoin d\'une fournée de 10 Boulettes fumées du désert.‡塞纳里奥要塞的卡兰德拉斯需要制作10只沙漠肉丸子。‡塞納里奧城堡的卡蘭德拉斯需要製作10個沙漠肉丸子的麵團。',
  }
},
[8318] = {
  {
    'Comunicação secreta‡Тайные послания‡Geheime Nachrichten‡비밀 교신‡Mensajes secretos‡Mensajes secretos‡Communications secrètes‡秘密交流‡秘密通訊',
    nil,
    'Traga 10 Textos Cifrados do Crepúsculo para Bor Juba Agreste no Forte Cenariano.‡Принесите 10 зашифрованных сумеречных текстов Бору Буйногривому в крепость Кенария.‡Bringt Bor Wildmähne auf Burg Cenarius 10 verschlüsselte Schattenhammertexte.‡세나리온 요새에 있는 보르 와일드메인에게 암호화된 황혼의 문서 10개를 가져가야 합니다.‡Lleva 10 textos Crepusculares codificados a Bor Ferocrín en el Fuerte Cenarion.‡Lleva 10 textos Crepusculares codificados a Bor Ferocrín en el Fuerte Cenarion.‡Apportez 10 Textes du Crépuscule cryptés à Bor Crin-sauvage, au Fort cénarien.‡把10片暮光密文信交给塞纳里奥要塞的鲍尔·蛮鬃。‡帶10張暮光文本給塞納里奧城堡的鮑爾·蠻鬃。',
  }
},
[8319] = {
  {
    'Textos codificados do Crepúsculo‡Зашифрованные Сумеречные тексты‡Verschlüsselte Schattenhammertexte‡암호화된 황혼의 문서‡Textos Crepusculares codificados‡Textos Crepusculares codificados‡Les textes du Crépuscule cryptés‡暮光密文信‡暮光加密文件',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[8320] = {
  {
    'Geolordes do Crepúsculo‡Геолорды из культа Сумеречного Молота‡Geolords des Schattenhammers‡황혼의 대지술사‡Geoseñores Crepusculares‡Geoseñores Crepusculares‡Les géoseigneurs du Crépuscule‡暮光地王‡暮光地領主',
    nil,
    'Mate 10 Geolordes do Crepúsculo, então fale novamente com Huum Juba Agreste no Forte Cenariano.‡Убейте 10 геолордов из культа Сумеречного Молота и вернитесь к Хууму Буйногривому в крепость Кенария.‡Tötet 10 Zwielichtgeolords und kehrt anschließend zu Huum Wildmähne auf Burg Cenarius zurück.‡황혼의 대지술사 10명을 처치하고 세나리온 요새에 있는 후움 와일드메인에게 가야 합니다.‡Mata 10 geoseñores Crepusculares y, a continuación, ve a ver a Huum Ferocrín en el Fuerte Cenarion.‡Mata 10 geoseñores Crepusculares y, a continuación, ve a ver a Huum Ferocrín en el Fuerte Cenarion.‡Tuez 10 Géoseigneurs du Crépuscule, puis retournez voir Huum Crin-sauvage au Fort cénarien.‡杀死10个暮光地王，然后向塞纳里奥要塞的霍姆·蛮鬃复命。‡殺死10個暮光地領主, 然後向塞納里奧城堡的胡姆·蠻鬃回報。',
  }
},
[8321] = {
  {
    'Viral, o Vil‡Вайрал Подлый‡Vyral der Üble‡타락의 바이랄‡Vyral el Vil‡Vyral el Vil‡Vyral le Vil‡邪恶的维拉尔‡卑鄙的維拉爾',
    nil,
    'Mate Viral, o Vil, e obtenha o Anel-sinete do Viral.‡Убейте Вайрала Подлого и заберите его перстень-печатку.‡Tötet Vyral den Üblen und erhaltet Vyrals Siegelring.‡타락의 바이랄을 처치하고 바이랄의 인장 반지를 획득해야 합니다.‡Mata a Vyral el Vil y consigue el sello de Vyral.‡Mata a Vyral el Vil y consigue el sello de Vyral.‡Tuez Vyral le Vil et prenez-lui sa Chevalière.‡消灭邪恶的维拉尔，获得维拉尔的徽记之戒。‡殺死卑鄙的維拉爾並取得維拉爾的璽戒。',
  }
},
[8322] = {
  {
    'Ovos podres‡Тухлые яйца‡Faule Eier‡썩은 달걀‡Huevos podridos‡Huevos podridos‡Les œufs pourris‡腐烂的鸡蛋‡惡臭雞蛋',
    nil,
    'Coloque os Ovos Podres no barril de cerveja principal dentro da Estalagem da Costa Sul.‡Бросьте тухлые яйца в главную бочку с пивом в таверне Южнобережья.‡Werft die faulen Eier in die großen Braufässchen im Gasthaus von Süderstade.‡남녘해안 여관 안에 있는 맥주통에 썩은 달걀을 집어넣어야 합니다.‡Introduce los huevos podridos en el barril principal que se encuentra en la Taberna Costasur.‡Introduce los huevos podridos en el barril principal que se encuentra en la Taberna Costasur.‡Placez les Œufs pourris dans le tonneau de bière principal de l\'auberge d\'Austrivage.‡将腐烂的鸡蛋放在南海镇旅店的主酿酒桶里。‡將惡臭雞蛋放到南海鎮旅店主要的釀酒桶子裡。',
  }
},
[8323] = {
  {
    'Crentes Fiéis‡Истинно верующие‡Wahrer Glauben‡진정한 신봉자‡El creyente verdadero‡El creyente verdadero‡Les vrais croyants‡真正的信徒‡真實信仰者',
    nil,
    'O Eremita Ortell quer que você traga 10 Textos Codificados do Crepúsculo‡Принесите 10 зашифрованных Сумеречных текстов отшельнику Ортеллу.‡Ortell der Einsiedler möchte, dass Ihr ihm 10 verschlüsselte Schattenhammertexte beschafft.‡은둔자 오르텔이 암호화된 황혼의 문서 10개를 가져다 달라고 했습니다.‡Ermitaño Ortell quiere que le lleves 10 textos Crepusculares codificados.‡Ermitaño Ortell quiere que le lleves 10 textos Crepusculares codificados.‡L\'ermite Ortell veut que vous lui apportiez 10 Textes du Crépuscule cryptés.‡隐士奥泰尔要你带回10张暮光密文信。‡隱士奧泰爾希望你能帶給他10份加密的暮光文件。',
  }
},
[8324] = {
  {
    'Crendo fielmente‡Не теряя веры‡Fester Glauben‡문서 수집‡Seguir creyendo‡Seguir creyendo‡Je crois encore...‡更多的读物‡更多的讀物',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[8325] = {
  {
    'Retomada da Ilha Andassol‡Очищение Острова Солнечного Скитальца‡Rückeroberung der Insel der Sonnenwanderer‡선스트라이더 섬 재건‡Recuperar la Isla del Caminante del Sol‡Recuperar la Isla del Caminante del Sol‡La reconquête de l\'île de Haut-Soleil‡夺回逐日岛‡奪回逐日者之島',
    nil,
    'Mate 6 Moreias de Mana. Elas ficam perto dos Cristais Flamejantes junto à torre e ao mirante.‡Убейте 6 маназмеев – они находятся у пламенеющих кристаллов, недалеко от башни и беседки.‡Tötet 6 Manawyrm; sie halten sich rund um die brennenden Kristalle auf, die man nahe des Turms und des Vorbaus findet.‡태양 첨탑과 별채 부근의 불타는 수정 가까이에 있는 마나 지룡 6마리를 처치해야 합니다.‡Mata 6 vermis de maná; están cerca de los cristales ardientes que hay junto a la torre y la glorieta.‡Mata 6 vermis de maná; están cerca de los cristales ardientes que hay junto a la torre y la glorieta.‡Tuez 6 Wyrms de mana. Ils se trouvent près des Cristaux ardents, non loin de la tour et du belvédère.‡杀死6只法力浮龙。它们位于法师塔和阳台附近的燃烧水晶周围。‡殺死6條法力龍鰻，牠們就在哨塔與瞭望台旁的燃燒水晶那裡。',
  }
},
[8326] = {
  {
    'Medidas drásticas‡Вынужденные меры‡Bedauerliche Maßnahmen‡유감스러운 조치‡Medidas extremas‡Medidas extremas‡Des mesures regrettables‡令人遗憾的措施‡不幸的手段',
    nil,
    'Recolha 8 Coleiras de Linces Garrataque e de Filhotes de Garrataque. Fale novamente com a Magistra Erona na Ilha Andassol quando terminar.‡Соберите 8 ошейников с убитых рысей-прыголапов и детенышей прыголапов и возвращайтесь к магистру Эроне на острове Солнечного Скитальца.‡Sammelt 8 Luchshalsbänder von erlegten Bachtatzenluchsen und Bachtatzenjungen ein. Kehrt zu Magistrix Erona auf der Insel der Sonnenwanderer zurück, sobald Ihr Eure Aufgabe erfüllt habt.‡갈기발 스라소니와 새끼 갈기발 스라소니를 처치하고 스라소니 목줄 8개를 모으십시오. 다 모으면 선스트라이더 섬에 있는 마법학자 이로나에게 가야 합니다.‡Coge 8 colleras de lince de los linces y cachorros garragil muertos. Luego vuelve a ver a la magistrix Erona a Isla del Caminante del Sol.‡Coge 8 colleras de lince de los linces y cachorros garragil muertos. Luego vuelve a ver a la magistrix Erona a Isla del Caminante del Sol.‡Collectez 8 Colliers de lynx sur des Lynx Preste-pattes et des Jeunes Preste-pattes. Lorsque vous aurez terminé, retournez voir la magistrice Erona sur l\'île de Haut-soleil.‡杀死一些魔泉山猫和魔泉山猫幼崽，并从它们身上收集8个山猫的项圈。完成之后向逐日岛的魔导师艾洛娜复命。‡殺死泉爪山貓和幼年泉爪山貓收集8個山貓項圈。完成後去找逐日者之島的博學者伊羅娜。',
  }
},
[8327] = {
  {
    'Apresente-se a Lanthan Perilon‡Визит к Лантану Перилону‡Berichterstattung an Lanthan Perilon‡란단 페릴론에게 보고‡Informar a Lanthan Perilon‡Informar a Lanthan Perilon‡Se présenter à Lanthan Perilon‡向兰萨恩·派雷隆报到‡向蘭深·佩瑞隆回報',
    nil,
    'Fale com Lanthan Perilon na Ilha Andassol; ele encontra-se perto do caminho para oeste além da Torre do Sol.‡Поговорите с Лантаном Перилоном на острове Солнечного Скитальца – он стоит рядом с дорогой, отходящей на запад от Солнечного Шпиля.‡Sprecht mit Lanthan Perilon auf der Insel der Sonnenwanderer. Er steht in der Nähe des Pfads, der vom Sonnenturm Richtung Westen verläuft.‡선스트라이더 섬에 있는 란단 페릴론과 대화해야 합니다. 그는 태양 첨탑에서 서쪽으로 가는 길가에 서 있습니다.‡Habla con Lanthan Perilon en la Isla del Caminante del Sol. Está cerca del sendero que se aleja de La Aguja del Sol hacia el oeste.‡Habla con Lanthan Perilon en la Isla del Caminante del Sol. Está cerca del sendero que se aleja de La Aguja del Sol hacia el oeste.‡Parlez à Lanthan Perilon sur l\'île de Haut-soleil. Il se tient près du sentier qui part de la Flèche solaire, vers l\'ouest.‡与逐日岛的兰萨恩·派雷隆谈一谈，他就站在向西去的小路旁。‡和逐日者之島的蘭深·佩瑞隆談談;他就在日尖塔往西邊的路上。',
  }
},
[8328] = {
  {
    'Treinamento de mago‡Обучение мага‡Ausbildung zum Magier‡마법사 훈련‡Instrucción de mago‡Instrucción de mago‡Le maître des mages‡法师训练‡法師訓練',
    nil,
    'Fale com Julia Golpessol, a instrutora de Magos, na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставницей магов Джулией Солнцесвет в Солнечном Шпиле на Острове Солнечного Скитальца.‡Sprecht mit Julia Sonnensturm - der Magierlehrerin - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 마법사 줄리아 선스트라이커와 대화해야 합니다.‡Habla con Julia Golpesol, la instructora de magos, en la Aguja del Sol en Isla del Caminante del Sol.‡Habla con Julia Golpesol, la instructora de magos, en la Aguja del Sol en Isla del Caminante del Sol.‡Parlez à Julia Heurtesoleil, le maître des mages, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的法师训练师朱莉亚-射日者谈一谈。‡和茱莉亞·擊日者 - 法師訓練師談談，她就在逐日者之島的日尖塔裡面。',
  }
},
[8329] = {
  {
    'Treinamento de guerreiro‡Обучение воина‡Ausbildung zum Krieger‡전사 훈련‡Instrucción de guerrero‡Instrucción de guerrero‡La formation de guerrier‡战士训练‡戰士的訓練',
    nil,
    'Fale com o instrutor de guerreiros Delios na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с Делиосом – наставником воинов – в Солнечном Шпиле на Острове Солнечного Скитальца.‡Sprecht mit Delios - dem Kriegerlehrer - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 전사 델리오스와 대화해야 합니다.‡Habla con Delios, el instructor de guerreros, en la Aguja del Sol en Isla del Caminante del Sol.‡Habla con Delios, el instructor de guerreros, en la Aguja del Sol en Isla del Caminante del Sol.‡Parlez à Delios, le maître des guerriers, à la Flèche solaire sur l’Île de Haut-Soleil.‡与逐日岛的太阳之塔内的战士职业训练师德利奥斯交谈。‡和戰士訓練師戴利歐斯談談，他就在逐日者之島的日尖塔裡面。',
  }
},
[8330] = {
  {
    'Os pertences de Solanian‡Вещи Соланиана‡Solanians Habe‡솔라니안의 물건‡Las posesiones de Solanian‡Las posesiones de Solanian‡Les possessions de Solanian‡索兰尼亚的物品‡索蘭尼亞的東西',
    nil,
    'Recolha o Orbe de Vidência de Solanian, o Pergaminho de Magia do Flagelo e o Diário. Eles estão na Ilha Andassol ao lado do poço, da fonte e de um dos Cristais Flamejantes. Leve-os ao Vigia da Nascente na Torre do Sol, que fica na Ilha Andassol, quando estiver de posse de todos eles.‡Верните Соланиану его гадальный шар, дневник и свиток магии Плети. Их можно найти на острове Солнечного Скитальца у пруда, у одного из пламенеющих кристаллов и у фонтана. Вернитесь с вещами к хранителю Колодца в Солнечный шпиль на острове Солнечного Скитальца.‡Sammelt Brunnenbehüter Solanians Seherkugel, seine Rolle der Geißelmagie und sein Tagebuch ein. Ihr findet die Gegenstände auf der Insel der Sonnenwanderer bei dem Tümpel, dem Brunnen und bei einem der brennenden Kristalle. Bringt sie zu dem Brunnenbehüter oben im Sonnenturm auf der Insel der Sonnenwanderer, sobald Ihr alle gefunden habt.‡태양샘지기 솔라니안의 수정구, 스컬지 마법 두루마리, 솔라니안의 일지를 입수해야 합니다. 각각 선스트라이더 섬의 연못, 분수대 그리고 불타는 수정 중 한 곳에 있습니다. 다 모으면 선스트라이더 섬의 태양 첨탑에 있는 태양샘지기에게 돌아가십시오.‡Recoge el orbe de visión, el pergamino de magia de la Plaga y el diario del vigía del pozo Solanian. Están en Isla del Caminante del Sol cerca de la charca, la fuente y de uno de los cristales ardientes. Llévaselo todo a La Aguja del Sol en la Isla del Caminante del Sol.‡Recoge el orbe de visión, el pergamino de magia de la Plaga y el diario del vigía del pozo Solanian. Están en Isla del Caminante del Sol cerca de la charca, la fuente y de uno de los cristales ardientes. Llévaselo todo a La Aguja del Sol en la Isla del Caminante del Sol.‡Récupérez l\'Orbe de divination de Solanian, son Parchemin de magie du Fléau et son Journal. Ils se trouvent sur l\'île de Haut-soleil, non loin de l\'étang, de la fontaine et de l\'un des cristaux ardents. Lorsque vous les aurez tous, restituez-les au Veilleur du puits à la Flèche solaire de l\'île de Haut-soleil.‡收集护井者索兰尼亚的占卜宝珠、天灾魔法卷轴和日记。它们分别位于逐日岛上的池塘边、喷泉附近以及一块燃烧水晶旁。找到所有物品后，将它们归还给太阳之塔上的护井者索兰尼亚。‡收集看井者索蘭尼亞的占卜寶珠，他的天譴軍團的魔法卷軸和他的日記。你可以在逐日者之島的池塘邊，噴水池邊和某個燃燒水晶那裡找到這些東西。當你收集好了之後，將它們帶到逐日者之島給日尖塔上的看井者。',
  }
},
[8331] = {
  {
    '‡Аурель Золотой Лист‡Aurel Goldblatt‡오렐 골드리프‡Aurel Hojaurea‡Aurel Hojaurea‡Aurel Feuilledor‡奥蕾尔·金叶‡奧莉爾·金葉',
    nil,
    '‡Поговорите с Аурель Золотой Лист в Крепости Кенария.‡Sprecht mit Aurel Goldblatt auf Burg Cenarius.‡‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥城堡的奥莉尔·金叶谈话。‡',
  }
},
[8332] = {
  {
    'Duques do Conselho‡Герцоги Совета‡Fürsten des Rates‡심연의 군주‡Los Duques del Consejo‡Los Duques del Consejo‡Les ducs du Conseil‡议会的公爵‡議會公爵',
    nil,
    'Leve 1 Estilhaço Brilhante Grande e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 1 большой сверкающий осколок и 3 талисмана бездны.‡Bringt Aurel Goldblatt auf Burg Cenarius 1 großen glänzenden Splitter und 3 Abyssische Wappen.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 1개, 심연의 문장 3개를 가져가야 합니다.‡Lleva 1 fragmento luminoso grande y 3 blasones Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 1 fragmento luminoso grande y 3 blasones Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 1 Grand éclat brillant et 3 Blasons abyssaux à Aurel Feuilledor, au Fort cénarien.‡把1个大块魔光碎片和3顶深渊纹章交给塞纳利奥要塞的奥蕾尔·金叶。‡帶1大塊魔光裂片和3個深淵紋章給塞納里奧城堡的奧莉爾·金葉。',
  }
},
[8333] = {
  {
    '‡Статусный медальон‡Das Standesmedaillon‡‡Medallón de estatus‡Medallón de estatus‡Le médaillon de statut‡身份勋章‡',
    nil,
    nil,
  }
},
[8334] = {
  {
    'Agressão‡Агрессия‡Aggressivität‡공격성‡Agresividad‡Agresividad‡Agression‡攻势‡侵略',
    nil,
    'Mate 7 Conservadores e 7 Arvorosos Ferozes e fale novamente com Lanthan Perilon na Ilha Andassol.‡Убейте 7 древунов и 7 одичавших древунов, затем вернитесь к Лантану Перилону на Острове Солнечного Скитальца.‡Tötet 7 Borklinge und 7 wilde Borklinge. Kehrt dann zu Lanthan Perilon auf der Insel der Sonnenwanderer zurück.‡뜰지기와 사나운 뜰지기를 각각 7마리씩 해치운 후, 선스트라이더 섬에 있는 란단 페릴론에게 가야 합니다.‡Mata 7 tiernos y 7 tiernos ferales y ve a ver a Lanthan Perilon en la Isla del Caminante del Sol.‡Mata 7 tiernos y 7 tiernos ferales y ve a ver a Lanthan Perilon en la Isla del Caminante del Sol.‡Tuez 7 Sylveniers et 7 Sylveniers farouches, puis retournez voir Lanthan Perilon sur l\'île de Haut-soleil.‡杀死7只树人嫩苗和7只凶猛的树人嫩苗，然后向逐日岛的兰萨恩·派雷隆复命。‡殺死7個看管者和7個野生看管者，再回到逐日者之島的蘭深·佩瑞隆那裡。',
  }
},
[8335] = {
  {
    'Felendren, o Banido‡Фелендрен Изгой‡Felendren der Verbannte‡추방자 펠렌드렌‡Felendren el Desterrado‡Felendren el Desterrado‡Felendren le Banni‡放逐者菲伦德雷‡被流放的法蘭德倫',
    nil,
    'Mate 8 Aparições Arcanas e 2 Aparições Arcanas Maculadas, bem como Felendren, o Banido; eles encontram-se na Academia Falthrien. Leve a Cabeça de Felendren para Lanthan Perilon na Ilha Andassol.‡Убейте 8 чародейских призраков, 2 нечистых чародейских призрака и Фелендрена Изгоя в академии Фалтриена. Принесите голову Фелендрена Лантану Перилону на остров Солнечного Скитальца.‡Tötet 8 Arkangespenster, 2 besudelte Arkangespenster und Felendren den Verbannten. Ihr findet sie in der Akademie von Falthrien. Bringt Felendrens Kopf zu Lanthan Perilon auf der Insel der Sonnenwanderer.‡팔스리엔 마법학회에 있는 추방자 펠렌드렌, 비전 망령 8마리와 오염된 비전 망령 2마리를 처치한 후, 선스트라이더 섬에 있는 란단 페릴론에게 추방자가 쓰러졌다는 증거가 될만한 물건을 가져가야 합니다.‡Mata 8 ánimas arcanas, 2 ánimas arcanas máculas y a Felendren el Desterrado en Academia Falthrien. Lleva la cabeza de Felendren a Lanthan Perilon a la Isla del Caminante del Sol.‡Mata 8 ánimas arcanas, 2 ánimas arcanas máculas y a Felendren el Desterrado en Academia Falthrien. Lleva la cabeza de Felendren a Lanthan Perilon a la Isla del Caminante del Sol.‡Tuez 8 Âmes en peine arcaniques et 2 Âmes en peine arcaniques contaminées, ainsi que Felendren le Banni. Ils se trouvent à l\'académie de Falthrien. Ramenez la Tête de Felendren à Lanthan Perilon sur l\'île de Haut-soleil.‡杀死8只奥术怨灵和2只被污染的奥术怨灵，以及放逐者菲伦德雷，他们位于法瑟林学院。将菲伦德雷的徽记交给逐日岛的兰萨恩·派雷隆。‡殺死8個秘法怨靈、2個腐敗的秘法怨靈和被流放的法蘭德倫;他們就在法薩瑞安學院裡面。將法蘭德倫的頭顱帶給逐日者之島的蘭深·佩瑞隆。',
  }
},
[8336] = {
  {
    'Um punhado de lascas‡Пригоршня осколков‡Für eine Handvoll Fragmente‡신비의 조각 한 줌‡Por un puñado de esquirlas‡Por un puñado de esquirlas‡Pour une poignée d\'esquilles‡奥术薄片‡一把稜片',
    nil,
    'Consiga 6 Lascas Arcanas com qualquer criatura da ilha que use mana e fale novamente com o Arcanista Ithanas na Ilha Andassol.‡Соберите 6 магических осколков, убивая любых существ, обладающих магическими способностями, а затем вернитесь к чародею Итанасу.‡Sammelt 6 Arkanspäne und bringt sie zu Arkanist Ithanas auf der Insel der Sonnenwanderer. Derartige Fragmente findet man bei allen Mana benutzenden Kreaturen auf der Insel.‡섬에 있는 생명체 중 마나를 사용하는 생명체를 처치하고 신비의 조각 6개를 모아서 선스트라이더 섬의 비전술사 이타나스에게 가야 합니다.‡Coge 6 esquirlas arcanas de cualquier criatura de la isla que use maná y llévaselas al arcanista Ithanas a la Isla del Caminante del Sol.‡Coge 6 esquirlas arcanas de cualquier criatura de la isla que use maná y llévaselas al arcanista Ithanas a la Isla del Caminante del Sol.‡Récupérer 6 Esquilles arcaniques sur n\'importe quelle créature qui utilise du mana, puis retourner voir l\'arcaniste Ithanas sur l\'île de Haut-soleil.‡从逐日岛上的任意使用魔法的生物身上收集6块奥术薄片，把它们交给奥术师伊塔纳斯。‡從島上任何使用法力的生物身上收集6個秘法稜片，再回到逐日者之島的秘法師艾薩納斯那裡。',
  }
},
[8337] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡[미사용]‡<UNUSED>‡<UNUSED>‡<INUTILISÉ>‡暂无内容‡<UNUSED>',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[8338] = {
  {
    'Lasca Arcana Maculada‡Оскверненный магический осколок‡Besudelter Arkanspan‡오염된 신비의 조각‡Esquirla arcana mácula‡Esquirla arcana mácula‡L\'esquille arcanique contaminée‡被污染的奥术薄片‡腐敗的秘法稜片',
    nil,
    'Leve a Lasca Arcana Maculada ao Arcanista Helion no mirante da Torre do Sol, que fica na Ilha Andassol.‡Принесите оскверненный магический осколок чародею Хелиону, который стоит возле беседки у Солнечного Шпиля на острове Солнечного Скитальца.‡Bringt den besudelten Arkanspan zu Arkanist Helion beim Vorbau des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 별채에 있는 비전술사 헬리온에게 오염된 신비의 조각을 가져가야 합니다.‡Lleva la esquirla arcana mácula al arcanista Helion a la glorieta de la Aguja del Sol en la Isla del Caminante del Sol.‡Lleva la esquirla arcana mácula al arcanista Helion a la glorieta de la Aguja del Sol en la Isla del Caminante del Sol.‡Remettre l\'Esquille arcanique contaminée à l\'arcaniste Helion, au belvédère de la Flèche solaire, sur l\'île de Haut-soleil.‡将被污染的奥术薄片交给逐日岛的太阳之塔露台上的奥术师赫里恩。‡將腐敗的秘法稜片帶到逐日者之島給日尖塔瞭望台的秘法師海利恩。',
  }
},
[8339] = {
  {
    '‡Обмануть Совет<NYI> <TXT> UNUSED‡Belohnung des Rats‡‡‡‡La royauté du Conseil<NYI><TXT>INUTILISÉ‡‡',
    nil,
    '‡Принесите предметы Аурель Золотой Лист в Крепость Кенария.‡Bringt die Gegenstände zu Aurel Goldblatt in der Burg Cenarius.‡‡Lleva los objetos a Aurel Hojaurea en Goldleaf a Fuerte Cenarion.‡Lleva los objetos a Aurel Hojaurea en Goldleaf a Fuerte Cenarion.‡Ramenez les trucs à Aurel Feuilledor au Fort cénarien.‡‡',
  }
},
[8340] = {
  {
    '‡Сумеречный перстень-печатка‡Siegelring des Schattenhammers‡‡‡‡La chevalière du Crépuscule<NYI><TXT>‡‡',
    nil,
    nil,
  }
},
[8341] = {
  {
    'Lordes do Conselho‡Лорды Совета‡Lords des Rates‡심연의 군주 속이기‡Señores del Consejo‡Señores del Consejo‡Les seigneurs du conseil‡议会的领主‡議會領主',
    nil,
    'Leve 5 Estilhaços Brilhantes Grandes e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 5 больших сияющих осколков и 3 перстня бездны.‡Bringt Aurel Goldblatt auf Burg Cenarius 5 große glänzende Splitter und 3 abyssische Siegel.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 5개, 심연의 인장 3개를 가져가야 합니다.‡Lleva 5 fragmentos luminosos grandes y 3 sellos abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 5 fragmentos luminosos grandes y 3 sellos abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 5 Grands éclats brillants et 3 Chevalières abyssales à Aurel Feuilledor, au Fort cénarien.‡把5个大块魔光碎片和3个深渊徽记交给塞纳里奥要塞的奥蕾尔·金叶。‡帶5塊大塊魔光裂片和3個深淵徽記給塞納里奧城堡的奧莉爾·金葉。',
  }
},
[8342] = {
  {
    '‡Кольцо Власти служителя культа Сумеречного Молота‡Zwielichtherrschaftsring‡‡Anillo de nobleza Crepuscular‡Anillo de nobleza Crepuscular‡L\'anneau d\'autorité du Crépuscule‡暮光徽记之戒‡',
    nil,
    nil,
  }
},
[8343] = {
  {
    '‡Открытие Золотого Листа‡Goldblatts Entdeckung‡‡El descubrimiento de Hojaurea‡El descubrimiento de Hojaurea‡La découverte de Feuilledor‡金叶的发现‡',
    nil,
    '‡Поговорите с Аурель Золотой Лист в Крепости Кенария.‡Sprecht mit Aurel Goldblatt auf Burg Cenarius.‡‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥城堡的奥莉尔·金叶谈话。‡',
  }
},
[8344] = {
  {
    '‡Постижение основ‡Schlüssel zur Macht‡‡Ventanas al origen‡Ventanas al origen‡Des fenêtres vers la source‡‡',
    nil,
    '‡Принесите 4 призрачные сущности и 1 оскверненную призрачную сущность призывателю Тель\'Лариену в Солнечный Шпиль на остров Солнечного Скитальца.‡Bring 4 Essenzen eines Gespenstes und 1 Essenz eines besudelten Gespenstes zu Beschwörer Teli\'Larien beim Sonnenturm auf der Insel der Sonnenwanderer.‡‡Lleva 4 esencias de ánimas arcanas y 1 esencia de ánima arcana mácula al invocador Teli\'Larien a la Aguja del Sol a la Isla del Caminante del Sol.‡Lleva 4 esencias de ánimas arcanas y 1 esencia de ánima arcana mácula al invocador Teli\'Larien a la Aguja del Sol a la Isla del Caminante del Sol.‡Remettez 4 Essences d\'âmes en peine et 1 Essence d\'âme en peine contaminée à l\'invocateur Teli\'Larien, à la Flèche solaire de l\'île de Haut-Soleil.‡‡',
  }
},
[8345] = {
  {
    'O Altar de Dath\'Remar‡Святилище Дат\'Ремара‡Der Schrein von Dath\'Remar‡다트리마의 제단‡Santuario de Dath\'Remar‡Santuario de Dath\'Remar‡Le sanctuaire de Dath\'Remar‡达斯雷玛的神龛‡達斯雷瑪神殿',
    nil,
    'Leia a placa no Altar de Dath\'Remar e fale novamente com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Прочтите надпись на святилище Дат\'Ремара и вернитесь к хранителю Колодца Соланиану в Солнечный шпиль на острове Солнечного Скитальца.‡Lest die Tafel am Schrein von Dath\'Remar und kehrt anschließend zu Brunnenbehüter Solanian beim Sonnenturm auf der Insel der Sonnenwanderer zurück.‡다트리마의 제단을 찾아서 비문을 읽은 다음 선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안에게 가야 합니다.‡Lee la placa del Santuario de Dath\'Remar y ve a ver al vigía del pozo Solanian a la Aguja del Sol en la Isla del Caminante del Sol.‡Lee la placa del Santuario de Dath\'Remar y ve a ver al vigía del pozo Solanian a la Aguja del Sol en la Isla del Caminante del Sol.‡Lisez la plaque au Sanctuaire de Dath\'Remar puis retournez auprès du veilleur du puits Solanian, à la Flèche solaire de l\'île de Haut-soleil.‡阅读达斯雷玛的神龛上的铭文之后，向逐日岛太阳之塔上的护井者索兰尼亚复命。‡閱讀達斯雷瑪神殿上的銘文再回到逐日者之島找日尖塔的看井者索蘭尼亞。',
  }
},
[8346] = {
  {
    'Sede eterna‡Неутолимая жажда‡Unstillbarer Durst‡끝없는 욕망‡Sed insaciable‡Sed insaciable‡L\'insatiable soif‡无尽的渴求‡止不了的渴',
    nil,
    'Use a habilidade Torrente Arcana, inerente à sua raça, em uma Moreia de Mana e fale novamente com o Arcanista Helion.‡Используйте вашу расовую способность "Волшебный поток" против маназмея, затем вернитесь к чародею Хелиону.‡Verwendet die Fähigkeit \'Arkaner Strom\' auf einen Manawyrm und kehrt anschließend zu Arkanist Helion zurück.‡마나 지룡에게 종족 특성인 비전 격류를 사용한 후, 비전술사 헬리온에게 가야 합니다.‡Usa tu habilidad racial Torrente Arcano sobre una vermis de maná y luego vuelve junto al arcanista Helion.‡Usa tu habilidad racial Torrente Arcano sobre una vermis de maná y luego vuelve junto al arcanista Helion.‡Servez-vous de votre compétence raciale Torrent arcanique sur un wyrm de mana, puis revenez voir l’arcaniste Helion.‡对一条法力浮龙使用种族特长技能“奥术洪流”，然后向奥术师赫里恩复命。‡對法力龍鰻使用你的奧流之術種族特長，再回到秘法師海利恩那裡。',
  }
},
[8347] = {
  {
    'O auxílio aos vanguardeiros‡Помощь курьерам‡Unterstützung für die Kundschafter‡길잡이 돕기‡Ayudando a los avanzados‡Ayudando a los avanzados‡Aider les estafettes‡帮助信使‡幫助先驅者',
    nil,
    'Fale com a Vanguardeira Alarion perto da ponte que leva ao sul da Ilha Andassol.‡Поговорите с курьером Аларион у моста к югу от острова Солнечного Скитальца.‡Sprecht mit Kundschafterin Alarion nahe der Brücke, die in den Süden der Insel der Sonnenwanderer führt.‡선스트라이더 섬의 남쪽으로 이어진 다리 근처에 있는 길잡이 알라리온과 대화해야 합니다.‡Habla con la avanzada Alarion cerca del puente que va al sur de la Isla del Caminante del Sol.‡Habla con la avanzada Alarion cerca del puente que va al sur de la Isla del Caminante del Sol.‡Parler à l\'estafette Alarion, près du pont qui mène au sud de l\'île de Haut-soleil.‡与逐日岛南部桥梁旁的信使奥拉莉恩谈一谈。‡和先驅者艾拉瑞恩談談，她就在往南方逐日者之島的橋附近。',
  }
},
[8348] = {
  {
    'O sinete dos duques‡Перстень герцогов‡Siegel der Fürsten‡군주의 인장‡Sellos de los Duques‡Sellos de los Duques‡La chevalière des ducs‡公爵的徽记‡公爵的徽記',
    nil,
    'Leve o Sinete Abissal para Bor Juba Agreste no Forte Cenariano.‡Принесите перстень бездны Бору Буйногривому из крепости Кенария.‡Bringt Bor Wildmähne auf Burg Cenarius das abyssische Siegel.‡세나리온 요새에 있는 보르 와일드메인에게 심연의 인장을 가져가야 합니다.‡Lleva el sello abisal a Bor Ferocrín en el Fuerte Cenarion.‡Lleva el sello abisal a Bor Ferocrín en el Fuerte Cenarion.‡Apportez la Chevalière abyssale à Bor Crin-sauvage, au Fort cénarien.‡将深渊徽记交给塞纳里奥要塞的霍姆·蛮鬃。‡把深淵徽記帶給塞納里奧城堡的鮑爾·蠻鬃。',
  }
},
[8349] = {
  {
    'Bor Juba Agreste‡Бор Буйная Грива‡Bor Wildmähne‡보르 와일드메인‡Bor Ferocrín‡Bor Ferocrín‡Bor Crin-sauvage‡鲍尔·蛮鬃‡鮑爾·蠻鬃',
    nil,
    'Fale com Bor Juba Agreste no Forte Cenariano.‡Поговорите с Бором Буйногривым из крепости Кенария.‡Sprecht mit Bor Wildmähne auf Burg Cenarius.‡세나리온 요새에 있는 보르 와일드메인과 대화해야 합니다.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Parlez à Bor Crin-sauvage au Fort cénarien.‡与塞纳里奥要塞的鲍尔·蛮鬃谈一谈。‡與在塞納里奧城堡的鮑爾·蠻鬃談話。',
  }
},
[8350] = {
  {
    'Concluindo a entrega‡Доставка посылки‡Erfolgreiche Lieferung‡소포 배달‡El encargo‡El encargo‡Achever la livraison‡送信‡完成遞送',
    nil,
    'Entregue o Pacote da Erona à Estalajadeira Delaniel na estalagem na Praça Asa do Falcão, que fica na Floresta do Canto Eterno.‡Доставьте посылку Эроны хозяйке таверны Деланиель на площадь Соколиных Крыльев в лесах Вечной Песни.‡Bringt Eronas Päckchen zu Gastwirtin Delaniel im Gasthaus beim Falkenplatz im Immersangwald.‡영원노래 숲의 매날개 광장의 여관에 있는 여관주인 델라니엘에게 이로나의 소포를 전달해야 합니다.‡Entrega el paquete de Erona a la tabernera Delaniel en la Plaza Alalcón en el Bosque Canción Eterna.‡Entrega el paquete de Erona a la tabernera Delaniel en la Plaza Alalcón en el Bosque Canción Eterna.‡Remettez le Paquet d\'Erona à l\'aubergiste Delaniel, à l\'auberge située sur la place de l\'épervier dans le bois des Chants éternels.‡将艾洛娜的包裹交给永歌森林鹰翼广场旅店中的旅店老板德兰妮尔。‡將伊羅娜的包裹送到永歌森林給獵鷹之翼廣場的旅店主人德拉尼歐。',
  }
},
[8351] = {
  {
    '‡Разговор с Бором‡Bor möchte Euch sprechen‡‡Bor quiere hablar contigo‡Bor quiere hablar contigo‡Bor souhaite vous parler‡与鲍尔谈话‡',
    nil,
    '‡Поговорите с Бором Буйногривым из Крепости Кенария.‡Sprecht mit Bor Wildmähne auf Burg Cenarius.‡‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Parlez à Bor Crin-sauvage au Fort cénarien.‡与塞纳里奥要塞的鲍尔·蛮鬃谈一谈。‡',
  }
},
[8352] = {
  {
    'Cetro do conselho‡Скипетр Совета‡Szepter des Rates‡심연의 홀‡Cetro del Consejo‡Cetro del Consejo‡Le sceptre du Conseil‡议会的节杖‡議會權杖',
    nil,
    'Leve um Cetro Abissal para Bor Juba Agreste no Forte Cenariano.‡Принесите скипетр бездны Бору Буйногривому из крепости Кенария.‡Bringt Bor Wildmähne auf Burg Cenarius ein abyssisches Szepter.‡세나리온 요새에 있는 보르 와일드메인에게 심연의 홀을 가져가야 합니다.‡Lleva un cetro abisal a Bor Ferocrín en el Fuerte Cenarion.‡Lleva un cetro abisal a Bor Ferocrín en el Fuerte Cenarion.‡Apportez un Sceptre abyssal à Bor Crin-sauvage, au Fort cénarien.‡将一柄深渊节杖交给塞纳里奥要塞的鲍尔·蛮鬃。‡帶一支深淵權杖給塞納里奧城堡的鮑爾·蠻鬃。',
  }
},
[8353] = {
  {
    '‡Курочка с мятой‡Hühnchengegacker für ein Pfefferminzbonbon‡닭 흉내 내고 박하사탕 얻기‡Una menta por cacarear como un pollo‡Una menta por cacarear como un pollo‡Caqueter pour un bonbon à la menthe‡学小鸡，换糖果‡學小雞，換糖果',
    nil,
    '‡Изобразите курицу для хозяина таверны Огневара.‡Spielt Gastwirt Feuerbräu ein Huhn vor, er wird Euch dafür ein Pfefferminzbonbon aus Eisenschmiede geben!‡여관주인 파이어브루를 위해 닭 흉내를 내야 합니다. 그러면 아이언포지 박하사탕을 받을 수 있습니다!‡Haz el pollo para el posadero Vientofuego y te dará una menta de Forjaz.‡¡Cacarea como un pollo para el tabernero Brebefuego y te dará una menta de Forjaz!‡Utilisez l\'emote /poulet devant l\'aubergiste Brassefeu, et vous recevrez en échange un bonbon à la menthe de Forgefer !‡对旅店老板洛雷·火酒使用表情动作“小鸡”，以换取一颗铁炉堡薄荷糖！‡對旅店老闆火酒模仿小雞的動作並得到一顆鐵爐堡薄荷糖!',
  }
},
[8354] = {
  {
    'Imito uma galinha por uma balinha‡Курочка с мятой‡Hühnchengegacker für ein Pfefferminzbonbon‡닭 흉내 내고 박하사탕 얻기‡Una menta por cacarear como un pollo‡Una menta por cacarear como un pollo‡Caqueter pour un bonbon à la menthe‡学小鸡，换糖果‡學小雞，換糖果',
    nil,
    'Use a expressão /galinha diante do Estalajadeiro Ronan e, em troca, ele lhe dará uma Balinha da Cidade Baixa!‡Изобразите курицу для хозяина таверны Нормана и получите за это конфету Подгорода!‡Spielt Gastwirt Norman ein Huhn vor, er wird Euch dafür ein Pfefferminzbonbon aus Unterstadt geben!‡여관주인 노먼을 위해 닭 흉내를 내면 언더시티 박하사탕을 받을 수 있습니다!‡¡Cacarea como un pollo para el tabernero Norman y a cambio recibirás una menta de Entrañas!‡¡Cacarea como un pollo para el tabernero Norman y a cambio recibirás una menta de Entrañas!‡Utilisez l\'emote /poulet devant l\'aubergiste Norman, et vous recevrez en échange un bonbon à la menthe de Fossoyeuse !‡对旅店老板诺曼使用表情动作“小鸡”，以换取一颗幽暗城薄荷糖！‡對旅店老闆諾曼模仿小雞的動作並得到一顆幽暗城薄荷糖!',
  }
},
[8355] = {
  {
    '‡Плата за леденцы‡Kaugummikugelexpress‡젤리를 주세요‡¡Truco o trato!‡¡Truco o trato!‡Boule de gomme en approche‡学火车，换糖果‡',
    nil,
    '‡Изобразите паровозик для Талваша дель Кисселя.‡Ahmt für Talvash del Kissel einen Zug nach und er wird Euch dafür eine Kaugummikugel aus Gnomeregan geben!‡탈바쉬 델 키젤을 위해 기차 소리를 내야 합니다. 그러면 놈리건 젤리를 받을 수 있습니다!‡Haz el tren para Talvash del Kissel y te dará una gominola de Gnomeregan.‡Haz el tren para Talvash del Kissel y te dará una gominola de Gnomeregan.‡Utilisez l\'emote /tchou devant Talvash del Kissel, et vous recevrez en échange une boule de gomme de Gnomeregan !‡为塔瓦斯德·基瑟尔模仿火车的声音，作为交换，你将得到一颗诺莫瑞根橡皮糖！‡',
  }
},
[8356] = {
  {
    'Mamãe, sou forte!‡Поиграй мускулами!‡Muskelspiel für Nugat‡힘자랑하고 초코바 얻기‡Saca músculo a cambio de almendrados‡Saca músculo a cambio de almendrados‡Montrer ses muscles pour du nougat‡显肌肉，换糖果‡顯肌肉，換糖果',
    nil,
    'Use a expressão /muque na frente da estalajadeira Cristine para ganhar um Nougat de Ventobravo!‡Поиграйте мускулами перед хозяйкой таверны Аллисон и получите от нее за это нугу из Штормграда.‡Ihr müsst vor Gastwirtin Allison angeben, damit sie Euch im Gegenzug etwas vom Nugat aus Sturmwind gibt!‡여관주인 앨리슨에게 힘자랑을 해야 합니다. 그러면 스톰윈드 초코바를 받을 수 있습니다!‡Saca músculos para la tabernera Allison y, a cambio, recibirás un almendrado de Ventormenta.‡Saca músculos para la tabernera Allison y, a cambio, recibirás un almendrado de Ventormenta.|n‡Utilisez l\'emote /frime devant l\'aubergiste Allison, et vous recevrez en échange du nougat de Hurlevent !‡向旅店老板奥里森炫耀自己强壮的肌肉，以换取一颗暴风城杏仁糖！‡對旅店老闆奧里森作展示肌肉的動作，並交換你應得的暴風城牛軋糖!',
  }
},
[8357] = {
  {
    '‡Танец за марципан‡Tanzen für Marzipan‡춤추고 양갱 얻기‡Bailando por mazapanes‡Bailando por mazapanes‡Danser pour du massepain‡跳跳舞，换糖果‡',
    nil,
    '‡Потанцуйте для хозяйки таверны Салиенны, и за это вы получите марципан Дарнаса!‡Tanzt für Gastwirtin Saelienne und Ihr werdet im Gegenzug etwas von dem Marzipan aus Darnassus bekommen!‡여관주인 셀리에네를 위해 춤을 추어야 합니다. 그러면 다르나서스 양갱을 받을 수 있습니다!‡Baila para la tabernera Saelienne, y, a cambio, recibirás mazapán de Darnassus.‡Baila para la tabernera Saelienne, y, a cambio, recibirás mazapán de Darnassus.‡Utilisez l\'emote /danser devant l\'aubergiste Saelienne, et vous recevrez en échange du massepain de Darnassus !‡为旅店老板塞琳尼跳支舞，以换取一颗达纳苏斯水果糖！‡',
  }
},
[8358] = {
  {
    'Café com pão, café com pão‡Плата за леденцы‡Kaugummikugelexpress‡기차소리 내고 젤리 얻기‡¡Truco o trato!‡¡Truco o trato!‡Boule de gomme en approche‡学火车，换糖果‡學火車，換糖果',
    nil,
    'Use a expressão /trem diante de Kali Remik para ganhar uma Jujuba Lançanegra!‡Изобразите паровозик перед Кали Ремик (команда /train) и получите в награду леденец племени Черного Копья!‡Ahmt für Kali Remik einen Zug nach und sie wird Euch dafür eine Kaugummikugel der Dunkelspeere geben!‡칼리 레믹을 위해 기차소리를 내면 검은창 젤리를 받을 수 있습니다!‡Haz el tren para Kali Remik y a cambio recibirás una gominola Lanza Negra.|n‡Haz el tren para Kali Remik y a cambio recibirás una gominola Lanza Negra.|n‡Utilisez l\'emote /tchou devant Kali Remik, et vous recevrez en échange une Boule de gomme sombrelance !‡对卡利·雷米克使用表情动作“火车”，以换取一颗暗矛橡皮糖！‡對卡利·雷米克做出火車的聲音，並交換你應得的暗矛橡皮糖!',
  }
},
[8359] = {
  {
    'Mamãe, sou forte!‡Поиграй мускулами!‡Muskelspiel für Nugat‡힘자랑하고 초코바 얻기‡Saca músculo a cambio de almendrados‡Saca músculo a cambio de almendrados‡Montrer ses muscles pour du nougat‡显肌肉，换糖果‡顯肌肉，換糖果',
    nil,
    'Use a expressão /muque na frente da Estalajadeira Gryshka para ganhar um Nougat de Orgrimmar!‡Поиграйте мускулами перед хозяйкой таверны Гришкой и получите от нее за это нугу из Оргриммара.‡Ihr müsst vor Gastwirtin Gryshka angeben, damit sie Euch im Gegenzug etwas vom Nugat aus Orgrimmar gibt!‡여관주인 그리쉬카를 위해 힘자랑을 하면 오그리마 초코바를 받을 수 있습니다!‡Saca músculo para la tabernera Gryshka y te dará unos almendrados de Orgrimmar.‡Saca músculo para la tabernera Gryshka y te dará unos almendrados de Orgrimmar.‡Utilisez l\'emote /frime devant l\'aubergiste Gryshka, et vous recevrez en échange du nougat d\'Orgrimmar !‡向旅店老板格雷什卡炫耀自己强壮的肌肉，以换取一颗奥格瑞玛软糖！‡對旅店老闆格雷什卡作展示肌肉的動作，並交換你應得的奧格瑪牛軋糖!',
  }
},
[8360] = {
  {
    'Tudo por um marzipã‡Танец за марципан‡Tanzen für Marzipan‡춤추고 양갱 얻기‡Bailando por mazapanes‡Bailando por mazapanes‡Danser pour du massepain‡跳跳舞，换糖果‡跳跳舞，換糖果',
    nil,
    'Use a expressão /dançar na frente da Estalajadeira Pala e ela lhe dará um Marzipã do Penhasco do Trovão em troca!‡Потанцуйте для хозяйки таверны Палы, и за это вы получите марципан Громового Утеса!‡Tanzt für Gastwirtin Pala und Ihr werdet im Gegenzug etwas von dem Marzipan aus Donnerfels bekommen!‡여관주인 팔라를 위해 춤을 추면 썬더 블러프 양갱을 받을 수 있습니다!‡Baila para el tabernero Pala y, a cambio, recibirás mazapán de Cima del Trueno.‡Baila para la tabernera Pala y, a cambio, recibirás mazapán de Cima del Trueno.‡Utilisez l\'emote /danser devant l\'aubergiste Pala, et vous recevrez en échange du massepain des Pitons-du-Tonnerre !‡为旅店老板帕拉跳支舞，以换取一颗雷霆崖奶糖！‡對旅店老闆帕拉跳舞，並交換你應得的雷霆崖杏仁糖!',
  }
},
[8361] = {
  {
    'Contatos abissais‡Связь с Бездной‡Abyssische Kontakte‡심연의 의회와의 교신‡Contactos Abisales‡Contactos Abisales‡Des contacts abyssaux‡深渊联络‡深淵聯絡',
    nil,
    'Bor Juba Agreste no Forte Cenariano, em Silithus, quer que você acabe com um Templário Abissal e leve um Escudo Abissal para ele como prova.‡Убейте храмовника бездны по поручению Бора Буйногривого из крепости Кенария, что в Силитусе, и принесите в доказательство талисман бездны.‡Bor Wildmähne auf Burg Cenarius in Silithus möchte, dass Ihr einen abyssischen Templer vernichtet und ihm dessen abyssisches Wappen als Beweis für Eure Tat bringt.‡실리더스의 세나리온 요새에 있는 보르 와일드메인이 심연의 기사단을 처치하고 그 증거로 심연의 인장을 가져다 달라고 했습니다.‡Bor Ferocrín, del Fuerte Cenarion, en Silithus, quiere que destruyas a un Templario Abisal y le lleves un blasón Abisal como prueba de tu logro.‡Bor Ferocrín, del Fuerte Cenarion, en Silithus, quiere que destruyas a un Templario Abisal y le lleves un blasón Abisal como prueba de tu logro.‡Bor Crin-sauvage, du Fort cénarien en Silithus, veut que vous détruisiez un Templier abyssal et que vous lui rameniez un Blason abyssal comme preuve de votre exploit.‡希利苏斯塞纳里奥要塞的鲍尔·蛮鬃要求你击败一名深渊圣殿骑士，并将一个深渊纹章带回来作为证明。‡在希利蘇斯塞納里奧城堡的鮑爾·蠻鬃希望你能摧毀深淵聖殿騎士並且將深淵紋章作為行動證明帶回去給他。',
  }
},
[8362] = {
  {
    '‡Талисманы Бездны‡Abyssische Wappen‡‡Blasones Abisales‡Blasones Abisales‡Les blasons abyssaux‡深渊纹章‡',
    nil,
    nil,
  }
},
[8363] = {
  {
    '‡Перстни Бездны‡Abyssische Siegel‡‡Sellos abisales‡Sellos abisales‡Les chevalières abyssales‡深渊徽记‡',
    nil,
    nil,
  }
},
[8364] = {
  {
    '‡Скипетры Бездны‡Abyssische Szepter‡‡Cetros Abisales‡Cetros Abisales‡Les sceptres abyssaux‡深渊节杖‡',
    nil,
    nil,
  }
},
[8365] = {
  {
    'Chapéus de pirata, io-hô!‡Пиратские шляпы‡Piratenhüte Ahoy!‡최신 유행 해적 모자‡¡Sombreros de pirata a babor!‡¡Sombreros de pirata a babor!‡Ohé, des chapeaux de pirate !‡海盗的帽子！‡海賊的帽子!',
    nil,
    'Sissi Ashando quer que você colete 20 Chapéus de Pirata dos Mares do Sul e leve-os para ela no Porto de Bondebico, em Tanaris.‡Добудьте 20 шляп пиратов Южных Морей и отнесите их Отти Кутюри в Порт Хитрой Шестеренки в Танарисе.‡Sammelt 20 Südmeerpiratenhüte und bringt sie zurück zur eingebildeten Modeschöpferin beim Dampfdruckpier in Tanaris.‡타나리스의 스팀휘들 항구에 있는 거만한 의류상이 남쪽바다 해적 모자 20개를 가져다 달라고 했습니다.‡La modista Jactancia quiere que reúnas 20 sombreros de pirata de los Mares del Sur y que se los lleves al Puerto Bonvapor de Tanaris.‡La modista Jactancia quiere que reúnas 20 sombreros de pirata de los Mares del Sur y que se los lleves al Puerto Bonvapor de Tanaris.‡Hautaine Lamodiste veut que vous lui rapportiez 20 Chapeaux de pirate des mers du Sud à Port Gentepression, en Tanaris.‡塔纳利斯热砂港的傲慢的店主要你去帮他收集20顶南海海盗帽。‡塔納利斯熱砂港的傲慢的店主要你去幫他收集20頂南海海賊帽。',
  }
},
[8366] = {
  {
    'Recadinho dos Mares do Sul‡Покажи этим пиратам‡Gaunerei und Erpressung im Südmeer‡남쪽바다 처리반‡Mamporros en los Mares del Sur‡Mamporros en los Mares del Sur‡Le racket des mers du Sud‡南海复仇‡南海復仇',
    nil,
    'O Chefe de Segurança Silvadágua do Porto de Bondebico, em Tanaris, quer que você mate 10 Piratas dos Mares do Sul, 10 Flibusteiros dos Mares do Sul, 10 Estivadores dos Mares do Sul e 10 Espadachins dos Mares do Sul.‡Начальник отдела безопасности Чепухастер из Порта Хитрой Шестеренки в Танарисе просит убить 10 пиратов, 10 флибустьеров, 10 рабочих и 10 сорвиголов Южных морей.‡Sicherheitschef Bilgenritzel beim Dampfdruckpier in Tanaris beauftragt Euch, 10 Piraten der Südmeerfreibeuter, 10 Seeräuber der Südmeerfreibeuter, 10 Dockarbeiter der Südmeerfreibeuter und 10 Schwadroneure der Südseefreibeuter zu töten.‡타나리스의 스팀휘들 항구에 있는 보안과장 빌지위즐이 남쪽바다 해적, 약탈자, 부두일꾼, 칼잡이를 각각 10명씩 처치해 달라고 했습니다.‡El jefe de seguridad Pasaquillas del Puerto Bonvapor de Tanaris quiere que mates a 10 piratas de los Mares del Sur, 10 filibusteros de los Mares del Sur, 10 portuarios de los Mares del Sur y 10 espadachines de los Mares del Sur.‡El jefe de seguridad Pasaquillas del Puerto Bonvapor de Tanaris quiere que mates a 10 piratas de los Mares del Sur, 10 filibusteros de los Mares del Sur, 10 portuarios de los Mares del Sur y 10 espadachines de los Mares del Sur.‡Le chef de la sécurité Vizisanie du port Gentepression, en Tanaris, veut que vous tuiez 10 Pirates des mers du Sud, 10 Flibustiers des mers du Sud, 10 Portefaix des mers du Sud et 10 Bretteurs des mers du Sud.‡塔纳利斯热砂港的安全主管吉罗姆·比格维兹要你去干掉10个南海海盗、10个南海劫掠者、10个南海码头工人和10个南海流氓。‡塔納利斯熱砂港的安全主管膨嘯要你去幹掉10個南海海賊、10個南海掠劫者、10個南海碼頭工人和10個南海劍客。',
  }
},
[8367] = {
  {
    'Por grande honra‡Великая честь‡Große Ehre‡커다란 영광을 위하여‡Cuestión de honor‡Cuestión de honor‡Pour le plus grand des honneurs‡无上的荣耀‡無上的榮耀',
    nil,
    'Leve uma Marca de Honra de cada campo de batalha a um Armipotente da Horda em Shattrath ou em qualquer capital da Horda.‡Принесите почетные знаки каждого поля боя ордынскому вестнику войны в любую столицу Орды или в Шаттрат.‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Kriegshetzer der Horde in einer der Hauptstädte oder in Shattrath.‡호드 대도시나 샤트라스에 있는 호드 전쟁인도자에게 각 전장에서 명예 훈장을 하나씩 가져가야 합니다.‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Apportez 1 Marque d’honneur de chaque champ de bataille à un Porteguerre de la Horde, dans n\'importe quelle capitale de la Horde ou à Shattrath.‡在每个战场上都取得1枚荣誉奖章，并将它们交给任意部落主城或沙塔斯城中的部落战争使者。‡把每座戰場的榮譽獎章各一枚交給任何一座部落主城或撒塔斯的部落戰爭使者。',
  }
},
[8368] = {
  {
    '‡‡Schlacht der Kriegshymnenschlucht‡‡‡‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡',
    nil,
    '‡‡Bringt 3 Ehrenabzeichen des Kriegshymnenklans zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡‡‡‡Apportez 3 Marques d\'honneur Chanteguerre à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8369] = {
  {
    'Invasores do Vale Alterac‡Вторжение в Альтеракскую долину‡Die Invasoren des Alteractals‡알터랙 계곡의 침략자‡Invasores del Valle de Alterac‡Invasores del Valle de Alterac‡Les envahisseurs de la vallée d\'Alterac‡奥特兰克的入侵者‡奧特蘭克的入侵者',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Альтеракской долины ордынскому вестнику войны рядом со входом на поле боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à l\'un des porteguerres de la Horde, devant les champs de bataille.‡把1枚奥特兰克山谷荣誉奖章交给战场外的部落战争使者。‡把3枚奧特蘭克山谷榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8370] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin Arathi‡资源竞赛‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8371] = {
  {
    'Esforços combinados‡В едином порыве‡Gemeinsames Bestreben‡공동의 노력‡Esfuerzos concertados‡Esfuerzos concertados‡Des efforts concertés‡共同的努力‡共同的努力',
    nil,
    'Leve uma Marca de Honra de cada campo de batalha a um General de Brigada da Aliança em Dalaran, Shattrath ou qualquer capital da Aliança.‡Принесите почетные знаки каждого поля боя бригадному генералу Альянса в любую столицу Альянса или в Шаттрат.‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Brigadegeneral der Allianz in einer der Hauptstädte, Dalaran oder Shattrath.‡얼라이언스 대도시나 달라란, 샤트라스에 있는 얼라이언스 준장에게 각 전장 명예 훈장을 하나씩 가져가야 합니다.‡Entrega 1 marca de Honor de cada campo de batalla a un general de brigada de la Alianza en cualquiera de las capitales de la Alianza, Dalaran o Shattrath.‡Entrega 1 marca de Honor de cada campo de batalla a un general de brigada de la Alianza en cualquiera de las capitales de la Alianza, Dalaran o Shattrath.‡Apportez 1 Marque d’honneur de chaque champ de bataille à un Général de brigade de l\'Alliance, dans n\'importe quelle capitale de l\'Alliance, à Dalaran ou à Shattrath.‡在每个战场上都取得1枚荣誉奖章，并将它们交给任意联盟主城、达拉然或沙塔斯城中的联盟准将。‡把每座戰場的榮譽獎章各一枚交給交給任何一座聯盟主城、達拉然或撒塔斯的聯盟准將。',
  }
},
[8372] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Chanteguerres‡自然屏障‡自然屏障',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡將3枚戰歌峽谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
[8373] = {
  {
    'O poder do pinho‡Сила сосен‡Die Kraft der Pinie‡소나무의 힘‡El poder del pino‡El poder del pino‡La puissance du pin‡松木的力量‡松木的力量',
    nil,
    'Use o Limpador de Bomba Fedida para remover qualquer Bomba Fedida dos Renegados atirada na Costa Sul. Fale novamente com o Sargento Hartman, na Costa Sul, quando você tiver terminado.‡Уберите любую бомбу-вонючку Отрекшихся, брошенную в Южнобережье, при помощи очистителя бомб-вонючек. По выполнении задания возвращайтесь к сержанту Хартману.‡Verwendet einen Stinkbombenreiniger, um alle Stinkbomben der Verlassenen zu vernichten, die hier in Süderstade losgelassen wurden. Kehrt zu Unteroffizier Hartman in Süderstade zurück, wenn Ihr fertig seid.‡구린내 폭탄 탈취제를 사용하여 남녘해안에 떨어진 포세이큰 구린내 폭탄을 제거한 후 하사관 허트만에게 가야 합니다.‡Usa un limpiador de bombas fétidas para borrar los restos de las que los Renegados hayan lanzado en Costasur. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Usa un limpiador de bombas fétidas para borrar los restos de las que los Renegados hayan lanzado en Costasur. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Utilisez le Nettoyeur de boules puantes pour retirer les Boules puantes que les Réprouvés ont lancées sur Austrivage. Retournez voir le sergent Hartman à Austrivage quand vous aurez terminé.‡使用臭气弹清洁器来把散落在南海镇的亡灵臭气弹处理掉。当任务完成之后，回到南海镇的哈特曼中士那里。‡使用臭彈清潔器來把散落在南海鎮的被遺忘者臭彈處理掉。當任務完成之後，回到南海鎮的哈特曼中士那裏。',
  }
},
[8374] = {
  {
    'Reivindicando a Bacia Arathi‡Завоевание Низины Арати‡Inbesitznahme des Arathibeckens‡아라시 분지 공격‡Reclamo por la Cuenca de Arathi‡Reclamo por la Cuenca de Arathi‡La revendication du bassin Arathi‡战争的动力‡戰爭的動力',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的联盟准将。‡將3枚阿拉希盆地榮譽獎章交給戰場外的聯盟准將。',
  }
},
[8375] = {
  {
    'Lembrem-se do Vale Alterac!‡Помни Альтеракскую долину!‡Vergesst das Alteractal nicht!‡잊지 말자, 알터랙 계곡!‡¡Recuerda el Valle de Alterac!‡¡Recuerda el Valle de Alterac!‡Souvenez-vous de la vallée d\'Alterac !‡铭记奥特兰克！‡銘記奧特蘭克!',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Альтеракской долины бригадному генералу Альянса рядом со входом на поле боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à un général de brigade de l\'Alliance, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章交给战场外的联盟准将。‡把3枚奧特蘭克山谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
