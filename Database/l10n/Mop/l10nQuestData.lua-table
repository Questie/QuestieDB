[33100] = {
  {
    'O caminho do Imperador‡Путь Императора‡Der Weg des Kaisers‡황제의 길‡El camino del Emperador‡‡La voie de l’empereur‡帝王之道‡',
    nil,
    'Derrote Yu\'lon, Chi-Ji, Xuen e Niuzao, os quatro Celestiais Majestosos de Pandária. Uma‡Победите четырех Августейших Небожителей Пандарии – Юй-лун, Чи-Цзи, Сюэня и Нюцзао.‡Bezwingt Yu\'lon, Chi-Ji, Xuen und Niuzao, die vier Himmlischen Erhabenen Pandarias.‡판다리아의 위대한 천신, 위론, 츠지, 쉬엔, 니우짜오를 꺾어야 합니다. 레벨 35‡Derrota a Yu\'lon, Chi-Ji, Xuen y Niuzao: los cuatro Augustos Celestiales de Pandaria.‡‡Battez Yu’lon, Chi Ji, Xuen et Niuzao, les quatre Astres vénérables de la Pandarie.‡击败玉珑、赤精、雪怒和砮皂这四位潘达利亚的至尊天神。‡',
  }
},
[33104] = {
  {
    'Uma lenda pandarênica‡Легенда пандаренов‡Eine Legende Pandarias‡판다리아의 전설‡Una leyenda pandaren‡‡Une légende pandarène‡熊猫人的传说‡',
    nil,
    'Fale com Wrathion no Trono do Conhecimento, que fica no Vale das Flores Eternas. Uma‡Встретьтесь с Гневионом у Обители Мудрости в Вечноцветущем доле. это‡Trefft Furorion im Heim des Wissens im Tal der Ewigen Blüten.‡영원꽃 골짜기, 지식의 연단에 있는 래시온에게 가야 합니다. 레벨 35‡Reúnete con Wrathion en el Trono del Saber, en el Valle de la Flor Eterna.‡‡Retrouvez Irion au Siège de la Connaissance, dans le Val de l’Éternel printemps.‡到锦绣谷的闻道之座与拉希奥会面。‡',
  }
},
[33105] = {
  {
    'Julgamento do Príncipe Negro‡Решение Черного принца‡Urteil des Schwarzen Prinzen‡검은 왕자의 심판‡El juicio del Príncipe Negro‡‡Le jugement du prince noir‡黑王子的审判‡',
    nil,
    'Conclua o Cerco de Orgrimmar e derrote Garrosh Grito Infernal. Uma‡Закончите осаду Оргриммара и победите Гарроша Адского Крика. это‡Schließt die Schlacht um Orgrimmar ab und besiegt Garrosh Höllschrei.‡오그리마 공성전을 완료하고 가로쉬 헬스크림을 쓰러뜨려야 합니다. 레벨 35‡Completa El Asedio de Orgrimmar y derrota a Garrosh Grito Infernal.‡‡Terminez le Siège d’Orgrimmar et battez Garrosh Hurlenfer.‡完成决战奥格瑞玛并击败加尔鲁什·地狱咆哮。‡',
  }
},
[33107] = {
  {
    'Mau pressentimento, resultado ainda pior‡Все хуже, чем кажется‡Schlechtes Gefühl, schlechteres Ergebnis‡나쁜 느낌, 더 나쁜 결과‡Mal presentimiento, peor resultado‡‡Un mauvais pressentiment‡糟糕的预感，更糟的结果‡',
    nil,
    'Derrote o Fantasma de Lin Da-Gu. Uma‡Победите призрака Линь Да-Гу. это‡Besiegt den Geist von Lin Da-Gu.‡린 다구의 유령을 꺾어야 합니다. 레벨 35‡Derrota al fantasma de Lin Da Gu.‡‡Terrassez le Fantôme de Lin Da Gu.‡击败林大顾的鬼魂。‡',
  }
},
[33109] = {
  {
    'Recompensa rara‡Награда за самоотверженность‡Short-Supply Reward‡공급 부족 보상‡Recompensa de escasez de suministros‡‡Récompense de rareté‡短缺奖励‡',
