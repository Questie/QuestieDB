},
[30168] = {
  {
    'Raides de saqueadores‡Налетчики-грабители‡Diebische Räuber‡약탈자들‡Asaltantes ladrones‡‡Les pillards‡野蛮入侵‡',
    nil,
    'Recupere 5 Itens Saqueados dos Jinyus. Uma‡Верните 5 украденных вещей цзинь-юй.‡Beschafft 5 Teile der geplünderten Jinyubeute wieder.‡약탈당한 진위 전리품을 5개 되찾아야 합니다. 레벨 15 크라사랑 밀림‡Recupera 5 piezas del botín jinyu saqueado.‡‡Récupérez 5 Butins jinyu pillés.‡夺回5件遭劫的锦鱼战利品。‡',
  }
},
[30169] = {
  {
    'Slovan, o Líder do Raide‡Командир налетчиков Слован‡Räuberanführer Slovan‡약탈대장 슬로반‡Líder de banda Slovan‡‡Le chef de raid Slovan‡掠夺者首领司罗凡‡',
    nil,
    'Mate Slovan. Uma‡Убейте Слована.‡Tötet Slovan.‡슬로반을 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a Slovan.‡‡Tuez Slovan.‡击败司罗凡。‡',
  }
},
[30172] = {
  {
    'Barrilando pela estrada‡Катить бочку‡Fassgeleit‡물 운반‡Cargamento de barricas‡‡Transbahutage‡一起走‡',
    nil,
    'Leve Caneca de Barro de volta a Meia Colina.Caso você se separe de Caneca de Barro, encontre-o perto da banana gigante no Leque Dourado. Um(a) missão.‡Отведите Грязную Кружку в Полугорье.Если вы разделитесь, ищите Грязную Кружку у огромного банана в Золоченом Веере.‡Führt Trübtrunk zurück nach Halbhügel.Wenn Ihr Trübtrunk verliert, könnt Ihr ihn neben der riesigen Banane am Goldfächer wiederfinden.‡머드머그를 언덕골로 데려가야 합니다.머드머그와 떨어질 경우 금빛 선상지의 커다란 바나나 옆으로 가면 찾을 수 있습니다.‡Lleva a Caolín de vuelta a El Alcor.Si te separas de Caolín, podrás encontrarlo junto al banano gigante de El Abanico Dorado. Un/una misión de World of Warcraft: Mists of Pandaria.‡‡Guidez Gueule de Boue jusqu’à Micolline.Si vous êtes &lt;séparé/séparée&gt; de Gueule de Boue, vous pourrez le retrouver près de la banane géante, au Delta Doré.‡带泥盏回到半山。如果与泥盏走散了，可以在金扇泽的大香蕉旁找到他。‡',
  }
},
[30173] = {
  {
    'Fomentadores de guerra!‡Свиньи войны!‡Frontschweine‡전쟁광들!‡¡Cerdos de guerra!‡War Pigs!‡Les Phacochères !‡战地豪猪！‡戰豬!',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[30174] = {
  {
    'Pela família‡Ради семьи‡Für die Familie‡가족을 위하여‡Por la familia‡‡Pour la famille‡为了家人‡',
    nil,
    'Procure Kor Presa de Sangue. Uma‡Разыщите Кора Кровавого Бивня.‡Sucht Kor Bluthauer.‡코르 블러드터스크를 찾아야 합니다. 레벨 15 크라사랑 밀림‡Busca a Kor Sangradiente.‡‡Retrouvez Kor Brochesang.‡在科夏废墟里寻找科尔·血牙。‡',
  }
},
[30175] = {
  {
    'Os mantídeos‡Богомолы‡Die Mantis‡사마귀‡Los mántides‡‡Les mantides‡螳螂妖‡',
    nil,
    'Mate 10 Precursores Krik\'thik. Uma‡Убейте 10 ик\'тиков-прародителей.‡Tötet 10 Vorläufer der Ik\'thik.‡이크티크 선도자를 10마리 처치해야 합니다. 레벨 15 크라사랑 밀림‡Mata a 10 precursores Ik\'thik.‡‡Tuez 10 Précurseurs ik’thik.‡杀死10个伊克提克先锋。‡',
  }
},
[30177] = {
  {
    'Heroica Aleatória Diária (1a.) (Cataclismo)‡Daily Heroic Random (1st) (Cataclysm)‡Täglicher zufälliger, heroischer Dungeon (Erster) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡Daily Heroic Random (1st) (Cataclysm)‡随机英雄日常 （第一次）（大地的裂变）‡Daily Heroic Random (1st) (Cataclysm)',
    nil,
    nil,
  }
},
[30178] = {
  {
    'Rumo à selva‡Вперед, в глушь‡In die Wildnis‡밀림 속으로‡En la espesura‡‡Dans les étendues sauvages‡深入荒野‡',
    nil,
    'Localize o Mensageiro da Vigia de Zhu que está perdido na área norte do Rio Dojani. Em seguida, siga para o Templo da Garça Vermelha e fale com Koro Andarilho da Névoa.‡Найдите пропавшего посыльного дозора Чжу к южной части реки Доцзян, а затем отправляйтесь в храм Красного Журавля и поговорите с Коро Странником Туманов.‡Findet den vermissten Kurier aus Zhus Wacht am südlichen Flusslauf des Dojani, begebt Euch dann zum Tempel des Roten Kranichs und sprecht mit Koro Nebelgänger.‡도자니 강 북쪽 지역에 있는 쥬의 감시초소 급사를 찾은 후, 주학사로 가서 코로 미스트워커와 대화해야 합니다.‡Busca al mensajero de la Atalaya de Zhu perdido en el área al sur del río Dojani. Luego, prosigue hasta el Templo de la Grulla Roja y habla con Koro Caminante Misterioso.‡‡Localisez le Courrier du guet de Zhu disparu au sud de la Rivière Dojani, puis continuez vers le Temple de la Grue rouge et parlez avec Koro Marche la Brume.‡在都阳河的南部流域找到失踪的朱家堡信使，然后继续前往朱鹤寺和科洛·迷雾行者谈一谈。‡',
  }
},
[30179] = {
  {
    'Envenenado!‡Отрава!‡Vergiftet!‡독이다!‡¡Envenenados!‡‡Empoisonné !‡中毒！‡',
    nil,
    'Consiga 5 Lâminas Envenenadas Mogus. Uma‡Соберите 5 отравленных клинков могу.‡Sammelt 5 vergiftete Klingen der Mogu.‡독 묻은 모구 칼을 5개 모아야 합니다. 레벨 15 크라사랑 밀림‡Reúne 5 hojas mogu envenenadas.‡‡Rassemblez 5 Lames empoisonnées mogu.‡收集5把魔古毒刃。‡',
  }
},
[30180] = {
  {
    'Trabalho por trabalho‡Помощь при родах‡Mit Ach und Weh‡‡Un parto de trabajo‡‡Bûche ou crève !‡‡',
    nil,
    'Colete 8 pedaços de Lenha Seca. Uma‡Соберите 8 кусков древесины.‡Sammelt 8 Stücke Feuerholz.‡‡Reúne 8 piezas de leña.‡‡Rassemblez 8 bouts de Bois de chauffage.‡‡',
  }
},
[30181] = {
  {
    'Maestria dos mushans‡Охота на мушанов‡Mushanjagd‡무샨 사냥의 달인‡Maestría de mushan‡‡La maîtrise des mushans‡猎穆山兽‡',
    nil,
    'Mate 15 Mushans Poentos. Uma‡Убейте 15 серобоких мушанов.‡Tötet 15 Staubrückenmushan.‡먼지등 무샨 15마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 15 mushan de Loma Agreste.‡‡Tuez 15 Mushans saléchines.‡杀死15只沙背穆山兽。‡',
  }
},
[30182] = {
  {
    'Maestria das raposas‡Охота на лис‡Fuchsjagd‡여우 사냥의 달인‡Maestría de zorros‡‡La maîtrise des renards‡猎狐狸‡',
    nil,
    'Mate 15 Raposas Astutas. Uma‡Убейте 15 хитрых лисиц.‡Tötet 15 Schlaufüchse.‡교활한 여우 15마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 15 zorros astutos.‡‡Tuez 15 Renards rusés.‡杀死15只狡猾的狐狸。‡',
  }
},
[30183] = {
  {
    'Maestria em espreitamento‡Охота на тигров‡Beherrschen der Pirscherjagd‡추적의 달인‡Maestría de acechadores‡‡La maîtrise des traqueurs‡猎虎‡',
    nil,
    'Mate 15 Espreitadores Gargântuas. Uma‡Убейте 15 горных хищников.‡Tötet 15 Schluchtpirscher.‡포식 호랑이 15마리를 처치해야 합니다. 레벨 15 네 바람의 계곡‡Mata a 15 acechadores del despeñadero.‡‡Tuez 15 Rôdeurs de la gorge.‡杀死15只峡谷追猎者。‡',
  }
},
[30184] = {
  {
    'Maestria dos mushans: Couro Negro‡Охота на мушанов: Черношкур‡Mushanjagd: Rußhaut‡무샨 사냥의 달인: 검은가죽‡Maestría de mushan: Raspanegra‡‡La maîtrise des mushans : Cuir-Noir‡猎穆山兽：黑暗之皮‡',
    nil,
    'Obtenha a Cabeça de Couro Negro. Uma‡Убейте Черношкура и заберите его голову.‡Holt Euch Rußhauts Kopf.‡검은가죽의 머리를 획득해야 합니다. 레벨 15 네 바람의 계곡‡Consigue la cabeza de Raspanegra.‡‡Obtenez la Tête de Cuir-Noir.‡获得黑暗之皮的脑袋。‡',
  }
},
[30185] = {
  {
    'Mestre das tartarugas‡Охота на черепах‡Schildkrötenjagd‡거북이 사냥의 달인‡Maestría de tortugas‡‡La maîtrise des tortues‡猎龟‡',
    nil,
    'Consiga 5 Cascos Intactos de Tartaruga. Uma‡Соберите 5 неповрежденных черепашьих панцирей.‡Besorgt 5 intakte Schildkrötenpanzer.‡온전한 거북이 등껍질 5개를 수집해야 합니다. 레벨 15 네 바람의 계곡‡Reúne 5 caparazones de tortuga intactos.‡‡Ramassez 5 Carapaces de tortue intactes.‡收集5块完整的龟壳。‡',
  }
},
[30186] = {
  {
    'Maestria paterna‡Отцы и дети‡Elterliche Fürsorge‡사냥의 달인 아버지‡Maestría parental‡‡La maîtrise des parents‡父亲的压力‡',
    nil,
    'Destrua a Ruína de Torjar. Uma‡Уничтожьте Тораджарскую Погибель.‡Besiegt Torjars Fluch.‡토자르의 파멸을 처치해야 합니다. 레벨 15 네 바람의 계곡‡Acaba con Pesadilla de Torjar.‡‡Détruisez Plaie de Torjar.‡消灭托加尔之怨。‡',
  }
},
[30187] = {
  {
    'Treinamento de voo: no percurso certo‡Обучение полету: правильным курсом‡Flugausbildung: Der richtige Kurs‡비행 훈련: 항로 익히기‡Instrucción de vuelo: el recorrido correcto‡‡Leçons de vol : le parcours‡飞行训练：熟悉赛道‡',
    nil,
    'Voe através de 10 Bandeiras da Corrida nos Pontos de Controle que flutuam acima do Mar Nebuloso. Uma‡Пролетите сквозь 10 гоночных флагов, расположенных в контрольных точках в небе над Морем Туманной Дымки.‡Fliegt durch 10 Rennflaggen bei den Kontrollpunkten über der Nebelschleiersee.‡안개장막 바다 위에 떠 있는 통과 지점의 경주 깃발 10개를 통과해야 합니다. 레벨 10 비취 숲‡Atraviesa 10 banderas de carreras de los puntos de control que flotan por encima de El Mar Velo de Niebla.‡‡Traversez 10 Drapeaux de la course aux Points de contrôle qui flottent au-dessus de la Mer du Voile de brume.‡飞越漂浮在纱雾海上方的检查点，收集10面竞赛旗帜。‡',
  }
},
[30188] = {
  {
    'Cortando os céus‡Полет Облачного Змея‡Am Himmel reiten‡하늘을 달려‡Surcar los cielos‡‡Chevaucher dans les cieux‡展翅高飞‡',
    nil,
    'Junte-se à Ordem da Serpente das Nuvens. Uma‡Вступите в орден Облачного Змея.‡Tretet dem Orden der Wolkenschlange bei.‡운룡단의 일원이 되어야 합니다. 레벨 10 비취 숲‡Únete a la Orden del Dragón Nimbo.‡‡Rejoignez l’Ordre du Serpent-nuage.‡加入云端翔龙骑士团。‡',
  }
},
[30189] = {
  {
    'Uma linda maçã para Ella‡Милое яблочко для Эллы‡Ein hübscher Apfel für Ella‡엘라를 위한 아름다운 사과‡Una manzana preciosa para Ella‡‡Une pomme délicieuse pour Ella‡给艾拉的可爱的苹果‡',
    nil,
    'Uma‡Как дела, Рохсе?‡Wie geht\'s Euch denn so, &lt;Name&gt;?‡레벨 15 네 바람의 계곡‡¿Cómo estás hoy, &lt;nombre&gt;?‡‡Comment allez-vous aujourd’hui, &lt;nom&gt; ?‡‡',
  }
},
[30190] = {
  {
    'Desgraça dos duendes‡Снова духи? Я не в духе!‡Dreiste Geister‡요마의 습격‡Problemas con los duendes‡‡Les lutins crétins‡林精之患‡',
    nil,
    'Mate 8 Encrenqueiros Pelardósia. Uma‡Убейте 8 синекожих проказников.‡Löscht 8 Schieferhautunruhestifter aus.‡점판암가죽 말썽꾼 8마리를 처치해야 합니다. 레벨 5 영원꽃 골짜기‡Mata a 8 alborotadores Piel Bruna.‡‡Tuez 8 Fauteurs de troubles cuirardoise.‡击败8个岩肤捣乱者。‡',
  }
},
[30191] = {
  {
    'Tira o olho da minha cerveja!‡Вернуть украденные бочки!‡Weg von unserem Bier‡맥주에서 손 떼‡Aparta las manos de mi cerveza‡‡Pas touche à la bière‡谁动了我的啤酒‡',
    nil,
    'Recupere 10 Barris de Cair da Bruma Roubados. Uma‡Верните 10 украденных бочонков из деревни Туманного Водопада.‡Bergt 10 gestohlene Fässer von Nebelhauch.‡도난당한 안개내림 맥주통 10개를 되찾아야 합니다. 레벨 5 영원꽃 골짜기‡Recupera 10 barriles Bruma Otoñal robados.‡‡Récupérez 10 Tonneaux de Tombe-Brume volés.‡找回10个失窃的雾临酒桶。‡',
  }
},
[30192] = {
  {
    'Minha cidade está queimando‡Горит мой город‡Es brennt!‡마을이 불길에 휩싸였어요‡Mi ciudad se quema‡‡Un incendie dans la ville‡我们村着火了‡',
    nil,
    'Apague 30 Braseiros. Uma‡Потушите 30 огней жаровен.‡Tretet 30 Kohlengrillfeuer aus.‡화롯불 30개를 꺼야 합니다. 레벨 1 영원꽃 골짜기‡Apaga 30 fuegos de blandones.‡‡Éteignez 30 Feux de braseros.‡扑灭30处火盆火焰。‡',
  }
},
[30193] = {
  {
    'Alimentando as esperanças‡Ожидания мясоедов‡Lecker Gazelle‡열심히 일한 자여, 먹어라!‡Expectativas carnosas‡‡Le salaire de la chair‡我们要吃肉‡',
    nil,
    'Consiga 10 pedaços de Carne de Gazela das Terras Belas. Uma‡Добудьте 10 кусков мяса долинной газели.‡Besorgt 10 Stücke Schönlandgazellenfleisch.‡고운땅 가젤 고기 10조각을 구해야 합니다. 레벨 30 영원꽃 골짜기‡Hazte con 10 trozos de carne de gacela Belterra.‡‡Récupérez 10 morceaux de Viande de gazelle de Belle-Terre.‡获得10块仙境瞪羚肉。‡',
  }
},
[30194] = {
  {
    'Tempestade inconveniente‡Надвигается буря‡Stürmische Ausbreitung‡다가오는 폭풍‡Amenaza de tormenta‡‡Un tonnerre envahissant‡山雨欲来风满楼‡',
    nil,
    'Mate 8 Lobos Gorja Trovejante. Uma‡Убейте 8 громовых волков.‡Tötet 8 Donnermaulwölfe.‡천둥아귀 늑대 8마리를 처치해야 합니다. 레벨 30 영원꽃 골짜기‡Mata a 8 lobos Faucetrueno.‡‡Tuez 8 Loups gueule-tonnerre.‡击败8只雷喉狼。‡',
  }
},
[30195] = {
  {
    'Flores florescendo‡Вечноцветы‡Ewige Blüten‡활짝 핀 영원꽃‡Florecimiento‡‡Éphémères fleurs éternelles‡怒放的鲜花‡',
    nil,
    'Colha 10 Flores Eternas. Uma‡Соберите 10 вечноцветов.‡Sammelt 10 Ewige Blüten.‡영원꽃 10송이를 모아야 합니다. 레벨 30 영원꽃 골짜기‡Recoge 10 flores eternas.‡‡Cueillez 10 Fleurs éternelles.‡收集10束锦绣花。‡',
  }
},
[30196] = {
  {
    'Corrida pelo gogumelo‡Мягкогрибной сезон‡Mjampignons!‡싱싱버섯이 필요해‡Marchando una de champiplenos‡‡La course au champibon‡采菇热‡',
    nil,
    'Colete 12 Gogumelos. Uma‡Соберите 12 мягкогрибов.‡Sammelt 12 Mjampignons zusammen.‡싱싱버섯 12개를 모아야 합니다. 레벨 5 영원꽃 골짜기‡Recoge 12 champiplenos.‡‡Ramassez 12 Champibons.‡采摘12朵蘑菇。‡',
  }
},
[30197] = {
  {
    'Passeio de Carroça‡Поездка на повозке‡Wagenfahrt‡수레 타기‡Tirar del carro‡‡Promenade en chariot‡Cart Ride‡',
    nil,
    'Dirija uma carroça de entrega até a Aldeia XXX. Uma‡Отвезите повозку с припасами в деревню XXX.‡Fahrt mit dem Wagen nach XXX.‡배달 수레를 몰고 XXX 마을로 가야 합니다. 레벨 1 영원꽃 골짜기‡Lleva un carro de transporte a la aldea XXX.‡‡Pilotez un chariot de livraison jusqu’au village XXX.‡Ride a delivery cart to XXX Village.‡',
  }
},
