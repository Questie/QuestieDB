},
[407] = {
  {
    'Campos de mágoa‡Поля горя‡Felder des Kummers‡오염된 농장‡Campos de pena‡Campos de pena‡Les champs du Chagrin‡悲伤之地‡悲傷之地',
    nil,
    'Leve a Abóbora Inoculada para o Zelote Escarlate Capturado que esta sendo mantido no porão da Taberna Nó da Forca.‡Отнесите отравленную тыкву пленному ревнителю из Алого ордена, которого держат в погребе таверны "Петля висельника".‡Bringt den getränkten Kürbis zum gefangenen Scharlachroten Zeloten, der im Keller der Taverne Zur Galgenschlinge gefangen gehalten wird.‡사로잡힌 붉은십자군 광신도에게 줄무늬 호박을 가져가야 합니다. 교수대끝 선술집 지하실에 갇혀 있습니다.‡Llévale la calabaza envenenada al zelote Escarlata capturado que está encerrado en el sótano del Mesón La Horca.‡Llévale la calabaza envenenada al zelote Escarlata capturado que está encerrado en el sótano del Mesón La Horca.‡Donner le Potiron arrosé au Zélote écarlate capturé qui est gardé dans le cellier de la taverne des Pendus.‡将斑纹南瓜带给被关在恐惧之末旅店地下室中的血色十字军俘虏。‡將斑紋南瓜帶給被關在恐懼之末旅店地下室中的血色十字軍俘虜。',
  }
},
[408] = {
  {
    'A cripta da família‡Семейный склеп‡Die Familiengruft‡아가만드가 납골당‡La Cripta de la Familia‡La Cripta de la Familia‡La crypte familiale‡家族墓穴‡家族墓穴',
    nil,
    'Mate 8 Ancestrais Ululantes e 8 Ancestrais Apodrecidos.|n|nMate o Capitão Dargol, e leve seu crânio para o Magistrado Sevren em Montalvo.‡Убейте 8 стенающих предков и 8 гниющих предков.|n|nУбейте капитана Даргола и принесите его череп мировому судье Севрену в Брилл.‡Tötet 8 Klagende Vorfahren und 8 Faulende Vorfahren.|n|nTötet Hauptmann Dargol und bringt seinen Schädel zu Magistrat Sevren nach Brill.‡울부짖는 아가만드 망령 8마리와 썩어가는 아가만드 시체 8마리를 처치해야 합니다.|n|n대장 다르골을 처치하고 그의 해골을 브릴에 있는 집정관 세브렌에게 가져가야 합니다.‡Mata a 8 ancestros gemebundos y a 8 ancestros en podredumbre.|n|nMata al capitán Dargol y llévale su calavera al magistrado Sevren de Rémol.‡Mata a 8 ancestros gemebundos y a 8 ancestros en podredumbre.|n|nMata al capitán Dargol y llévale su calavera al magistrado Sevren de Rémol.‡Tuez 8 Spectres ancestraux et 8 Ancêtres pourrissants.|n|nTuez le capitaine Dargol et rapportez son crâne au magistrat Sevren, à Brill.‡杀死8个哀嚎的鬼魂和8个腐烂的古尸。|n|n消灭达高尔队长，并将他的徽记交给布瑞尔的执政官塞弗伦。‡殺死8個哀嚎的鬼魂和8個腐爛的古屍。|n|n消滅達高爾隊長，並將他的顱骨交給布瑞爾的執政官塞弗倫。',
  }
},
[409] = {
  {
    '‡Доказательство преданности‡Treuebeweis‡‡Prueba de lealtad‡Prueba de lealtad‡Prouver l\'allégeance‡证明忠诚‡',
    nil,
    '‡Возьмите манящую свечу.|n|nВызовите Лилит Нефару и убейте ее.|n|nВернитесь на остров к Гюнтеру.‡Beschafft Euch eine Kerze des Heranlockens.|n|nBeschwört Lillith Nefara und tötet sie.|n|nKehrt zu Gunther auf seiner Insel zurück.‡‡Coge una vela de señalización.|n|nDespierta a Lillith Nefala y mátala.|n|nVuelve a ver a Gunther a su isla.‡Coge una vela de señalización.|n|nDespierta a Lillith Nefala y mátala.|n|nVuelve a ver a Gunther a su isla.‡Obtenir une Bougie de signal.|n|nInvoquer Lillith Nefara et la tuer.|n|nRetourner voir Gunther sur son île.‡拿上一根诱灵蜡烛。|n|n召唤出莉莉丝·奈法拉并杀死她。|n|n然后向岛上的冈瑟尔回报。‡',
  }
},
[410] = {
  {
    '‡Спящая тень‡Der Schlummernde Schatten‡‡Sombra durmiente‡Sombra durmiente‡L\'Ombre dormante‡潜伏的阴影‡',
