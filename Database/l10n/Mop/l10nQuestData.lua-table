[10464] = {
  {
    'Voto do sábio‡Обет мудреца‡Das Gelöbnis des Weisen‡현자의 맹세‡La promesa del sabio‡La promesa del sabio‡Le vœu du sage‡先知的誓约‡法師的誓約',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se Honrado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить уважительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen wohlwollenden Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi, aux Grottes du temps, après être devenu Honoré auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到尊敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達尊敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10465] = {
  {
    'Voto do restaurador‡Обет целителя‡Das Gelöbnis des Bewahrers‡구원자의 맹세‡La promesa del restaurador‡La promesa del restaurador‡Le vœu du guérisseur‡治愈者的誓约‡治療師的誓約',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se Honrado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить уважительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen wohlwollenden Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Honoré auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到尊敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達尊敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
},
[10466] = {
  {
    'Voto do campeão‡Обет героя‡Das Gelöbnis des Helden‡용사의 맹세‡La promesa del campeón‡La promesa del campeón‡Le vœu du champion‡勇士的誓约‡勇士的誓約',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se Honrado pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить уважительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen wohlwollenden Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi aux Grottes du temps après être devenu Honoré auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到尊敬后，将永恒之戒交给时空之穴的索莉多米。‡當你的流沙之鱗聲望值到達尊敬之後帶著你的永恆指環給在時光之穴的索芮朵蜜。',
  }
