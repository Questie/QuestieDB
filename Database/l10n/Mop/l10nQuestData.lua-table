[11439] = {
  {
    'Treinamento de bombeiros‡Учения пожарной бригады‡Übung bei der Brandwache‡소방대 훈련‡Prácticas para bomberos‡Prácticas para bomberos‡Un entraînement de pompier‡消防练习‡救火隊演練',
    nil,
    'Jogue Baldes d\'Água em 5 chamas e, a seguir, fale com a Matriarca Fantasiada.‡Выплесните воду из ведра в 5 очагов пожара. Затем поговорите с переодетой попечительницей сирот.‡Löscht 5 Feuer mit Wassereimern und sprecht anschließend mit der kostümierten Waisenmatrone.‡물동이를 불길에 5번 던지고 나서 축제 의상을 입은 보육원 원장님과 대화해야 합니다.‡Echa cubos de agua en 5 fuegos y después vuelve para hablar con la supervisora de huérfanos disfrazada.‡Echa cubos de agua en 5 fuegos y después vuelve para hablar con la supervisora de huérfanos disfrazada.‡Jetez des seaux d\'eau sur 5 feux, puis revenez parler à la Directrice d\'orphelinat costumée.‡将小水桶里的水倒在5处火盆上，然后与穿戏服的孤儿院长谈一谈。‡把水桶丟向5個火源，然後跟變裝的孤兒監護員談話。',
  }
},
[11440] = {
  {
    'Treinamento de bombeiros‡Учения пожарной бригады‡Übung bei der Brandwache‡소방대 훈련‡Prácticas para bomberos‡Prácticas para bomberos‡Un entraînement de pompier‡消防练习‡救火隊演練',
    nil,
    'Jogue Baldes d\'Água em 5 chamas e, a seguir, fale com a Matriarca Fantasiada.‡Выплесните воду из ведра в 5 очагов пожара. Затем поговорите с переодетой попечительницей сирот.‡Löscht 5 Feuer mit Wassereimern und sprecht anschließend mit der kostümierten Waisenmatrone.‡물동이를 불길에 5번 던지고 나서 축제 의상을 입은 보육원 원장님과 대화해야 합니다.‡Echa cubos de agua en 5 fuegos y después vuelve para hablar con la supervisora de huérfanos disfrazada.‡Echa cubos de agua en 5 fuegos y después vuelve para hablar con la supervisora de huérfanos disfrazada.‡Jetez des seaux d\'eau sur 5 feux, puis revenez parler à la Directrice d\'orphelinat costumée.‡将小水桶里的水倒在5处火盆上，然后与穿戏服的孤儿院长谈一谈。‡把水桶丟向5個火源，然後跟變裝的孤兒監護員談話。',
  }
},
[11441] = {
  {
    'CervaFest!‡Хмельной фестиваль!‡Braufest!‡가을 축제!‡¡Fiesta de la cerveza!‡¡Fiesta de la Cerveza!‡La fête des Brasseurs !‡美酒节！‡啤酒節!',
    nil,
    'Fale com o Organizador da CervaFest.‡Поговорите с распорядителем Хмельного фестиваля.‡Sprecht mit dem Organisator des Braufests.‡가을 축제 조직위원과 대화해야 합니다.‡Habla con el organizador de la Fiesta de la cerveza.‡Habla con el organizador de la Fiesta de la Cerveza.‡Parlez à l\'Organisateur de la fête des Brasseurs.‡与美酒节组织者谈一谈。‡和啤酒節管理人交談。',
  }
},
[11442] = {
  {
    'Boas-vindas à CervaFest!‡Добро пожаловать на Хмельной фестиваль!‡Willkommen auf dem Braufest!‡가을 축제에 오신 걸 환영합니다!‡¡Bienvenido a la Fiesta de la cerveza!‡¡Bienvenido a la Fiesta de la Cerveza!‡Bienvenue à la fête des Brasseurs !‡欢迎来到美酒节！‡歡迎來到啤酒節!',
    nil,
    '[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.‡[PH] Speak to the Brewfest Organizer and receive a free beer.',
  }
},
[11443] = {
  {
    'Você já foi à baía?‡Подводное плавание в Бухте Кинжалов‡Tauchgang in der Dolchbucht‡비수집 만의 잠수부‡Submarinismo en Cubredaga‡Submarinismo en Cubredaga‡Plongée à Coiffedague‡匕鞘湾潜水行动‡匕鞘灣潛水',
    nil,
    'Haroldo Lavras, do fundo da Baía da Adaga, quer que você recupere 10 Caixotes de Suprimentos de Valgarde.‡Гарольд Лаграс из Бухты Кинжалов попросил вас найти 10 валгардских ящиков с припасами.‡Harold Lagras auf dem Grund der Dolchbucht möchte, dass Ihr ihm 10 Vorratskisten von Valgarde bringt.‡비수집 만 물속에 있는 해럴드 라그라스가 발가드 보급품 상자 10개를 가져다 달라고 했습니다.‡Harold Lagras en el fondo de la Bahía Cubredaga quiere que recuperes 10 cajones de suministros de Valgarde.‡Harold Lagras en el fondo de la Bahía Cubredaga quiere que recuperes 10 cajones de suministros de Valgarde.‡Harold Lagras, au fond de la Baie de Coiffedague, veut que vous récupériez 10 Caisses de fournitures de Valgarde.‡匕鞘湾海底的哈洛德·拉格拉斯要你打捞10只瓦加德补给箱。‡匕鞘海灣底部的哈洛德·拉格銳思要你收集10個沃爾加德補給木箱。',
  }
},
