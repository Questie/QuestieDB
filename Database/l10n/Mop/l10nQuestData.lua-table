[6844] = {
  {
    'Umbero, o arquivista‡Умбер, архивариус‡Umber, Archivar‡기록관 움버‡Umber, el archivista‡Umber, el archivista‡Umber, Archiviste‡档案馆长阿姆伯尔‡檔案管理員阿姆伯爾',
    nil,
    'Leve o Objeto Silitídeo Incrustado para Umbero, arquivista do Círculo Cenariano, na vila de Refúgio Noturno, na Clareira da Lua.‡Отнесите покрытый коркой предмет Умберу – архивариусу Круга Кенария – в деревню Ночная Гавань, что на Лунной поляне.‡Bringt das verkrustete Silithidenobjekt zu Umber, dem Archivar des Zirkels des Cenarius, ins Dorf Nachthafen auf der Mondlichtung.‡달숲의 밤의 안식처 마을에 있는 세나리온 의회의 기록관, 움버에게 딱딱한 실리시드 조각을 가져가야 합니다.‡Lleva el objeto silítido taraceado a Umber, el archivista del Círculo Cenarion, en la aldea de Amparo de la Noche, en el Claro de la Luna.‡Lleva el objeto silítido taraceado a Umber, el archivista del Círculo Cenarion, en la aldea de Amparo de la Noche, en el Claro de la Luna.‡Apporter l\'Objet silithide incrusté à Umber, l\'archiviste du Cercle cénarien, au village de Havrenuit, à Reflet-de-Lune.‡将异种蝎粘液包裹的物体交给月光林地永夜港的阿姆伯尔，他是塞纳里奥议会的档案管理员。‡將異種蠍粘液包裹的物體交給月光林地永夜港的阿姆伯爾，他是塞納里奧議會的檔案管理員。',
  }
},
[6845] = {
  {
    '‡Раскрытие древних секретов‡Enthüllung von Geheimnissen der Vergangenheit‡‡Desvelar los secretos del pasado‡Desvelar los secretos del pasado‡Les secrets du passé‡发现过去的秘密‡',
    nil,
    '‡Поговорите с Рабином Сатурной в деревне Ночная Гавань в Лунной поляне.‡Sprecht mit Rabine Saturna im Dorf Nachthafen auf der Mondlichtung.‡‡Habla con Rabine Saturna en el poblado Amparo de la Noche, en Claro de la Luna.‡Habla con Rabine Saturna en el poblado Amparo de la Noche, en Claro de la Luna.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。‡',
  }
},
[6846] = {
  {
    'Que comece o ataque!‡В атаку!‡Der Angriff soll beginnen!‡공격 개시!‡¡Al ataque!‡¡Al ataque!‡Que l\'attaque commence !‡展开攻击！‡展開攻擊!',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[6847] = {
  {
    '‡Всевидящее око мастера Рисона‡Meister Rysons Allsehendes Auge‡비밀결사대장 라이슨의 천리안‡El ojo que todo lo ve del maestro Ryson‡El ojo que todo lo ve del maestro Ryson‡L\'Œil qui-voit-tout de Maître Ryson‡雷尔松的全视之眼‡指揮官雷松的全知之眼',
    nil,
    '‡Заберите Всевидящее око мастера Рисона из пещер Секиры Зимы и возвращайтесь к мастеру Рисону.|n|nБудьте осторожны: говорят, что на Всевидящее око мастера Рисона наложено ужасное проклятие!‡Holt das allsehende Auge von Meister Ryson aus den Höhlen der Winterax und kehrt damit zu Meister Ryson zurück.|n|nSeid gewarnt, man sagt, dass das allsehende Auge von Meister Ryson einen schrecklicken Fluch mit sich brächte!‡겨울도끼 동굴에서 천리안을 회수한 후, 비밀결사대장 라이슨에게 가져가야 합니다.|n|n비밀결사대장 라이슨의 천리안은 끔찍한 저주를 불러들인다고 전해지니 조심해야 합니다!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Récupérer l\'Oeil qui-voit-tout de Maître Ryson dans les Grottes Haches-d\'hiver, puis le rapporter à Maître Ryson.|n|nSachez que l\'on dit de l\'Oeil qui-voit-tout de Maître Ryson qu\'il contient une terrible malédiction !‡从冰斧巨魔洞穴中找到雷尔松的全视之眼，然后回到指挥官雷尔松那里。|n|n要当心，据说雷尔松的全视之眼带有可怕的诅咒！‡',
  }
},
[6848] = {
  {
    '‡Всевидящее око мастера Рисона‡Meister Rysons Allsehendes Auge‡비밀결사대장 라이슨의 천리안‡El ojo que todo lo ve del maestro Ryson‡El ojo que todo lo ve del maestro Ryson‡L\'Œil-qui-voit-tout de maître Ryson‡雷尔松的全视之眼‡指揮官雷松的全知之眼',
    nil,
    '‡Заберите Всевидящее око мастера Рисона из пещер Секиры Зимы и возвращайтесь к мастеру Рисону.|n|nБудьте осторожны: говорят, что на Всевидящее око мастера Рисона наложено ужасное проклятие!‡Holt das allsehende Auge von Meister Ryson aus den Höhlen der Winterax und kehrt damit zu Meister Ryson zurück.|n|nSeid gewarnt, man sagt, dass das allsehende Auge von Meister Ryson einen schrecklicken Fluch mit sich brächte!‡겨울도끼 동굴에서 천리안을 회수한 후, 비밀결사대장 라이슨에게 가져가야 합니다.|n|n비밀결사대장 라이슨의 천리안은 끔찍한 저주를 불러들인다고 전해지니 조심해야 합니다!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Récupérez l\'Oeil-qui-voit-tout de Maître Ryson dans les Grottes Hache-d\'hiver, puis rapportez-le à Maître Ryson.|n|nSachez que l\'on dit de l\'Oeil-qui-voit-tout de Maître Ryson qu\'il contient une terrible malédiction !‡从冰斧巨魔洞穴中找到雷尔松的全视之眼，然后回到指挥官雷尔松那里。要当心，据说雷尔松的全视之眼带有可怕的诅咒！‡',
  }
},
[6861] = {
  {
    '‡Портативный резак Зинфиззлекса‡Zinnzischelixs tragbare Schreddereinheit‡진피즐렉스의 휴대용 벌목기 장치‡La unidad trituradora portátil de Zinfizzlex‡La unidad trituradora portátil de Zinfizzlex‡Déchiqueteur portatif de Zinfoirux‡斯菲莱克斯的便携式伐木机‡斯菲萊克斯的可攜式伐木機',
    nil,
    '‡Я хочу опробовать свой портативный крошшер не меньше тебя, |3-6($R), но для того, чтобы его сделать, мне нужны материалы – много материалов!|n|nСказать точнее, целая гора тория, мифрила и железа. Кроме того, по паровой пиле на каждый крошшер. Их можно достать на лесопилке.|n|nДо того, как меня поймали, я здесь все разнюхал и обнаружил, что куча паровых пил есть на лесозаготовках Грозовой Вершины.‡Ich bin ebenso begierig wie Ihr darauf, meine tragbare Schreddereinheit auszuprobieren, $R, aber bevor ich das Set herstellen kann, benötige ich Material - viel Material!|n|nUm genau zu sein, benötige ich einen Berg aus Thorium, Mithril und Eisen. Ich benötige außerdem eine Dampfsäge pro Einheit. Diese müsst Ihr beim Sägewerk beschaffen.|n|nAls ich mich hier umgesehen habe (vor meiner Gefangennahme), ist mir ein Stapel Dampfsägen im Holzlager der Sturmlanzen aufgefallen.‡‡El maestro ingeniero Zinfizzlex quiere que le lleves lo siguiente:|n|n*30 barras de torio.|n|n*50 barras de mitril.|n|n*75 barras de hierro.|n|n*1 sierra de vapor.|n‡Estoy tan ansioso como tú por probar mi nueva trituradora, $R, pero antes de que pueda fabricarla, voy a necesitar materiales, ¡muchos materiales!|n|nPara ser exactos, voy a necesitar una montaña de torio, mitril y hierro. También necesitaré una sierra de vapor por unidad. Tendrás que conseguirlas en la serrería.|n|nCuando estaba curioseando por aquí (antes de mi captura) me fijé en una pila de sierras de vapor en el aserradero Pico Tormenta.‡J\'ai hâte de faire l\'essai de mon déchiqueteur portatif, $R, mais avant que je ne puisse fabriquer le kit, j\'ai besoin de beaucoup de matériel !|n|nPour être précis, il me faut une montagne de thorium, de mithril et de fer. J\'aurai également besoin d\'une scie à vapeur par unité. Vous les trouverez à la scierie.|n|nAlors que je traînais dans les environs (avant ma capture) j\'ai remarqué une pile de scies à vapeur, au Camp de bûcherons des Foudrepiques.‡首席技师斯菲莱克斯要你给他拿去下列物品：|n|n30块瑟银锭。|n|n50块秘银锭。|n|n75块铁锭。|n|n1个蒸汽锯。‡',
  }
},
[6862] = {
  {
    '‡Портативный крошшер Зинфиззлекса‡Zinnzischelix\'s tragbare Schreddereinheit‡진피즐렉스의 휴대용 벌목기 장치‡La unidad trituradora portátil de Zinfizzlex‡La unidad trituradora portátil de Zinfizzlex‡Le Déchiqueteur portatif de Zinfoirux‡斯菲莱克斯的便携式伐木机‡斯菲萊克斯的可攜式伐木機',
    nil,
    '‡Принесите мастеру-инженеру Спустипару|n|n30 ториевых слитков|n|n50 мифриловых слитков|n|n75 железных слитков|n|n1 паровую пилу.‡Meisteringenieur Zinnzischelix möchte, dass Ihr ihm Folgendes bringt:|n|n*30 Thoriumbarren.|n|n*50 Mithrilbarren.|n|n*75 Eisenbarren.|n|n*1 Dampfsäge.‡‡Estoy tan ansioso como tú por probar mi nueva trituradora, $R, pero antes de que pueda fabricarla, voy a necesitar materiales, ¡muchos materiales!|n|nPara ser exactos, voy a necesitar una montaña de torio, mitril y hierro. También necesitaré una sierra de vapor por unidad. Tendrás que conseguirlas en la serrería.|n|nCuando estaba curioseando por aquí (antes de mi captura) me fijé en una pila de sierras de vapor en el aserradero Pico Tormenta.‡Estoy tan ansioso como tú por probar mi nueva trituradora, $R, pero antes de que pueda fabricarla, voy a necesitar materiales, ¡muchos materiales!|n|nPara ser exactos, voy a necesitar una montaña de torio, mitril y hierro. También necesitaré una sierra de vapor por unidad. Tendrás que conseguirlas en la serrería.|n|nCuando estaba curioseando por aquí (antes de mi captura) me fijé en una pila de sierras de vapor en el aserradero Pico Tormenta.‡Le Maître Ingénieur Zinfoirux veut que vous lui apportiez les matériaux suivants :|n|n*30 Barres de thorium.|n|n*50 Barres de Mithril.|n|n*75 Barres de fer.|n|n*1 Scie à vapeur.‡首席技师斯菲莱克斯要你给他拿去下列物品：|n|n30块瑟银锭。|n|n50块秘银锭。|n|n75块铁锭。|n|n1个蒸汽锯。‡工程大師斯菲萊克斯要你給他拿去下列物品:|n|n*30塊瑟銀錠。|n|n*50塊秘銀錠。|n|n*75塊鐵錠。|n|n*1個蒸汽鋸。',
  }
},
[6881] = {
  {
    'Ivus, o Senhor da Floresta‡Ивус Лесной Властелин‡Ivus der Waldfürst‡숲군주 이부스‡Ivus, el Señor del Bosque‡Ivus, el Señor del Bosque‡Ivus le Seigneur des forêts‡森林之王伊弗斯‡『森林之王』伊弗斯',
