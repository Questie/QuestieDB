[31930] = {
  {
    'Domadores de Batalha: Pandária‡Укротители боевых питомцев: Пандария‡Kampfhaustierzähmer: Pandaria‡전투 애완동물 조련사: 판다리아‡Domadores de mascotas de duelo: Pandaria‡‡Dompteurs de mascottes de combat : la Pandarie‡战斗宠物训练师：潘达利亚‡',
    nil,
    'Derrote Hyuna dos Altares, a Fazendeira Nishi, Mo\'ruk, o Corajoso Yon, o Perscrutador Zusshi e o Ermâmbulo Shu em Batalhas de Mascotes. Uma‡Победите Хюну Хранительницу Святилищ, фермера Ниши, Мо\'рука, Отважного Юня, искателя Зусши и странника пустошей Шу в битвах питомцев.‡Besiegt Hyuna von den Schreinen, Bäuerin Nishi, Mo\'ruk, Yon den Mutigen, Sucher Zusshi und Ödniswandler Shu in Haustierkämpfen.‡애완동물 대전에서 성소의 현아, 모루크, 농부 니스, 용감한 욘, 수색자 주쉬, 황야의 방랑자 슈를 꺾어야 합니다.‡Derrota a Hyuna de los Santuarios, a la granjera Nishi, a Mo\'ruk, al Valiente Yon, al buscador Zusshi y al transitayermos Shu en duelos de mascotas.‡‡Gagnez un combat de mascottes contre Hyuna des Sanctuaires, le Fermier Nishi, Mo’ruk, Yon le Courageux, le Chercheur Zusshi et le Marchefriche Shu.‡在宠物战斗中击败圣地的俞娜、农夫倪石、莫鲁克、勇敢的尹勇、探索者祖什和废土行者苏游。‡',
  }
},
[31931] = {
  {
    'Bigo Storapavio‡Бигл Фитиль‡Beegli Lunte‡비글 블라스트퓨즈‡Beegle Mechaexplosiva‡‡Beegle Explomèche‡毕格·爆索‡',
    nil,
    'Vença Bigo Storapavio numa batalha de mascotes. Uma‡Победите Бигла Фитиля в битве питомцев. это‡Besiegt Beegli Lunte in einem Haustierkampf.‡애완동물 대전에서 비글 블라스트퓨즈를 꺾어야 합니다. 레벨 1‡Derrota a Beegle Mechaexplosiva en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Beegle Explomèche.‡在宠物战斗中击败毕格·爆索。‡',
  }
},
[31932] = {
  {
    'Jacó Quase-sem-cabeça‡Почти Безголовый Якоб‡Fast kopfloser Jakob‡뇌가 거의 없는 자콥‡Jacob Casi Decapitado‡‡Jacob Quasi-Sans-Tête‡差点没头的雅各布‡',
    nil,
    'Vença Jacó Quase-sem-cabeça numa batalha de mascotes. Uma‡Победите Почти Безголового Якоба в битве питомцев. это‡Besiegt den fast kopflosen Jakob in einem Haustierkampf.‡애완동물 대전에서 뇌가 거의 없는 자콥을 꺾어야 합니다. 레벨 1‡Derrota a Jacob Casi Decapitado en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Jacob Quasi-Sans-Tête.‡在宠物战斗中击败差点没头的雅各布。‡',
  }
},
[31933] = {
  {
    'Okrut Deserto dos Dragões‡Окрут Убийца Драконов‡Okrut Drachenwüste‡오크러트 드래곤웨이스트‡Okrut Dragostador‡‡Okrut Bouse-de-Dragon‡奥克鲁特·荒龙‡',
    nil,
    'Vença Okrut Deserto dos Dragões numa batalha de mascotes. Uma‡Победите Окрута Убийцу Драконов в битве питомцев. это‡Besiegt Okrut Drachenwüste in einem Haustierkampf.‡애완동물 대전에서 오크러트 드래곤웨이스트를 꺾어야 합니다. 레벨 1‡Derrota a Okrut Dragostador en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Okrut Bouse-de-Dragon.‡在宠物战斗中击败奥克鲁特·荒龙。‡',
  }
},
[31934] = {
  {
    'Vomita-tripa‡Гатреч‡Darmwürger‡구역창자‡Arcadón‡‡Gerbe-tripes‡格特瑞奇‡',
    nil,
    'Vença Vomita-tripa numa batalha de mascotes. Uma‡Победите Гатреча в битве питомцев. это‡Besiegt Darmwürger in einem Haustierkampf.‡애완동물 대전에서 구역창자를 꺾어야 합니다. 레벨 1‡Derrota a Arcadón en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Gerbe-tripes.‡在宠物战斗中击败格特瑞奇。‡',
  }
},
[31935] = {
  {
    'Grão-mestre Payne‡Великий укротитель Пейн‡Großmeister Payne‡특급 조련사 페인‡Gran maestro Payne‡‡Grand maître Payne‡驯宠宗师派恩‡',
    nil,
    'Derrote Major Payne em uma batalha de mascotes. Uma‡Победите майора Пейна в битве питомцев. это‡Besiegt Major Payne in einem Haustierkampf.‡애완동물 대전에서 상사 페인을 꺾어야 합니다. 레벨 1‡Derrota al mayor Payne en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre le Major Payne.‡在宠物战斗中击败派恩少校。‡',
  }
},
[31936] = {
  {
    'Sistema de irrigação "Princesa Jinyu"‡Поливная система "Принцесса цзинь-юй"‡Das Bewässerungssystem "Jinyuprinzessin"‡"진위 공주" 관개 시설‡El sistema de irrigación de la "Princesa Jinyu"‡‡Le système d’irrigation « princesse jinyu »‡“锦鱼公主”灌溉系统‡',
    nil,
    'Leve o Sistema de Irrigação "Princesa Jinyu" ao Fazendeiro Yoon, na Fazenda Sol Cantante ou no Mercado de Meia Colina. Uma‡Отнесите поливную систему "Принцесса цзинь-юй" фермеру Юну, который находится на ферме Солнечной Песни или на рынке Полугорья.‡Bringt das Bewässerungssystem "Jinyuprinzessin" zu Bauer Yoon auf dem Gehöft Sonnensang oder dem Halbhügelmarkt.‡언덕골 시장이나 태양노래 농장에 있는 농부 윤에게 "진위 공주" 관개 시설을 가져가야 합니다. 레벨 15 네 바람의 계곡‡Lleva el sistema de irrigación de la "Princesa Jinyu" al granjero Yoon en el Rancho Cantosol o El Mercado del Alcor.‡‡Apportez le Système d’irrigation « princesse jinyu » au Fermier Yoon, à la Ferme Chant du Soleil ou au Marché de Micolline. Donne  en récompense.‡将“锦鱼公主”灌溉系统带到日歌农场或半山市集，交给农夫老愚。‡',
  }
},
[31937] = {
  {
    'Repelente "Rei Trovão"‡Инсектицид "Властелин Грома"‡Ungezieferschutz "Donnerkönig"‡"천둥왕" 해충 퇴치기‡Pesticidas "Rey del Trueno"‡‡L’insectifuge « roi-tonnerre »‡“雷电之王”驱虫器‡',
    nil,
    'Leve os Repelentes "Rei Trovão" ao Fazendeiro Yoon, na Fazenda Sol Cantante ou no Mercado de Meia Colina. Uma‡Отнесите инсектицид "Властелин Грома" фермеру Юну, который находится на ферме Солнечной Песни или на рынке Полугорья.‡Bringt den Ungezieferschutz "Donnerkönig" zu Bauer Yoon auf dem Gehöft Sonnensang oder dem Halbhügelmarkt.‡언덕골 시장이나 태양노래 농장에 있는 농부 윤에게 "천둥왕" 해충 퇴치기를 가져가야 합니다. 레벨 15 네 바람의 계곡‡Lleva los pesticidas "Rey del Trueno" al granjero Yoon en el Rancho Cantosol o El Mercado del Alcor.‡‡Apportez l’Insectifuge « roi-tonnerre » au Fermier Yoon, à la Ferme Chant du Soleil ou au Marché de Micolline.‡把“雷电之王”驱虫器带到日歌农场或半山市集，交给农夫老愚。‡',
  }
},
[31938] = {
  {
    'Arado "Arranca-Terra" Dominator Plus‡Суперплуг "Бороздящий землю"‡Der "Erdschlitzer"-Meisterpflug‡"대지절단자" 최고급 쟁기‡El arado maestro "Abretierras"‡‡La charrue de maître « balafreuse de terre »‡“翻地者”万能犁‡',
    nil,
    'Leve o Arado "Arranca-Terra" Dominator Plus ao Fazendeiro Yoon, na Fazenda Sol Cantante ou no Mercado de Meia Colina. Uma‡Отнесите суперплуг "Бороздящий землю" фермеру Юну, который находится на ферме Солнечной Песни или на рынке Полугорья.‡Bringt den "Erdschlitzer"-Meisterpflug zu Bauer Yoon auf dem Gehöft Sonnensang oder dem Halbhügelmarkt.‡언덕골 시장이나 태양노래 농장에 있는 농부 윤에게 "대지절단자" 최고급 쟁기를 가져가야 합니다. 을(를) 보상으로 줌.‡Lleva el arado maestro "Abretierras" al granjero Yoon en el Rancho Cantosol o El Mercado del Alcor.‡‡Apportez la Charrue de maître « balafreuse de terre » au Fermier Yoon, à la Ferme Chant du Soleil ou au Marché de Micolline. Donne  en récompense.‡把“翻地者”万能犁带到日歌农场或半山市集，交给农夫老愚。‡',
  }
},
[31939] = {
  {
    '‡‡Test‡시험‡‡‡‡Test‡',
    nil,
    '‡‡Pflanzt und erntet 4 saftigleckere Karotten. Saftigleckere Karottensamen können von Händler Grünfeld auf dem Halbhügelmarkt erworben werden. Nachdem Ihr Euren Ackerboden gepflügt und Euch um Eure Pflanzen gekümmert habt, müsst Ihr bis zum nächsten Tag warten, um Eure saftigleckeren Karotten ernten zu können.‡츄릅아삭 당근 4개를 심고 수확해야 합니다. 츄릅아삭 당근 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다. 당근을 심고 가꾼 후에 하루를 기다려야 다 자란 츄릅아삭 당근을 수확할 수 있습니다.‡‡‡‡种植并收获4份爽脆胡萝卜。爽脆胡萝卜种子可以在半山市集的商人绿野处买到。在开垦土地并照料植株之后，你必须等到第二天才能收获成熟的爽脆胡萝卜。‡',
  }
},
[31940] = {
  {
    'Adestradores de Batalha: Pandária‡Наставники боевых питомцев: Пандария‡Kampfhaustiertrainer: Pandaria‡‡Instructores de mascotas de duelo: Pandaria‡‡Dompteurs de mascottes de combat : la Pandarie‡‡',
    nil,
    'Derrote Ziggy, o Aterrissado; Jacó Quase-sem-cabeça; Okrut Deserto dos Dragões; e Vomita-tripa em batalhas de mascotes. Uma‡Победите Зигги Бескрылого, Почти Безголового Якоба, Окрута Убийцу Драконов и Гатреча в битвах питомцев.‡Besiegt Ziggy den Flugunfähigen, den fast kopflosen Jakob, Okrut Drachenwüste und Darmwürger in Haustierkämpfen.‡‡Derrota a Ziggy Sinvuelo, a Jacob Casi Decapitado, a Okrut Dragostador y a Arcadón en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Ziggy Sans Vol, Jacob le Presque-sans-tête, Okrut Bouse-de-Dragon et Gerbe-tripes.‡‡',
  }
},
[31941] = {
  {
    'Uma abóbora por semana...‡Кабачок против неприятного запаха‡Vierundsiebzig-elf: Kürbisch Wasser‡썩은 내에는 비취 박을‡Acaba con esos malos olores‡‡Lutter contre les mauvaises odeurs‡除臭碧玉瓜‡',
    nil,
    'Plante Abóbora Jade na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите нефритовый кабачок на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt einen Jadekürbis auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에서 비취 박을 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta un calabacín de jade en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez une Courge de jade à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵碧玉瓜。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31942] = {
  {
    'Horário de melão‡Время сажать дыни‡Melonensaison‡멜론 철‡Temporada de melones‡‡C’est l’heure du melon‡种瓜时间‡',
    nil,
    'Plante Melão Listrado na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите полосатую дыню на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt eine Streifenmelone auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에서 줄무늬 멜론을 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta un melón a rayas en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en El Mercado del Alcor.‡‡Plantez un Melon à rayures à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵菜瓜。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31943] = {
  {
    'Comendo uva na chuva‡Ведьмины ягоды‡Häh? Beeren? Hexenbeeren.‡무슨 딸기? 요술딸기!‡¿Qué buscas? Morujas.‡‡Une sorcielle surprise !‡什么浆果？女巫浆果。‡',
    nil,
    'Plante Uvas-de-bruxa na Fazenda Sol Cantante. Você pode comprar sementes do Mercador Moncampo no Mercado de Meia Colina. Uma‡Посадите ведьмины ягоды на ферме Солнечной Песни. Семена можно приобрести у торговца Зеленое Поле на рынке Полугорья.‡Pflanzt Hexenbeeren auf dem Gehöft Sonnensang an. Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben.‡태양노래 농장에서 요술딸기를 심어야 합니다. 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다.‡Planta morujas en el Rancho Cantosol. Puedes comprarle semillas al mercader Campo Fértil en el Mercado del Alcor.‡‡Plantez des Sorcielles à la Ferme Chant du Soleil. Vous pouvez acheter des graines au Marchand Verte Terre, au Marché de Micolline. Un(e) quête.‡在日歌农场种植一棵女巫浆果。你可以从半山市集的商人绿野那里购买种子。‡',
  }
},
[31944] = {
  {
    'Complete seu treinamento: o teste final‡Завершение тренировок: последнее испытание‡Die Ausbildung abschließen: Die letzte Prüfung‡훈련을 완수하라: 마지막 시험‡Completa tu entrenamiento: La prueba final‡‡Achevez votre entraînement : l’épreuve finale‡完成训练：终极试炼‡',
    nil,
    'Vá para o Campo de Treinamento no Pico da Serenidade e complete seu teste final. Uma‡Отправляйтесь на тренировочную площадку, что на пике Безмятежности, и пройдите последнее испытание.‡Begebt Euch zum Ausbildungsgelände am Gipfel der Ruhe und legt Eure letzte Prüfung ab.‡평온의 봉우리에 있는 훈련장으로 가서 마지막 시험을 완수해야 합니다. 레벨 35‡Ve al Campo de Entrenamiento, en el Pico de la Serenidad y completa tu prueba final.‡‡Rendez-vous au Terrain d’entraînement, au Pic de la Sérénité et passez l’épreuve finale.‡去晴日峰的训练场里完成最后的试炼。‡',
  }
},
[31945] = {
  {
    'Caminhando e plantando VI: o voto de Gina‡Растениеводство VI: голос Джины‡Lernen und Wachsen VI: Ginas Stimme‡농사일 배우기 VI: 지나의 한 표‡Aprender y cultivar VI: El voto de Gina‡‡Potasser son potager - Leçon 6 : le vote de Gina‡学习务农（六）：吉娜的选票‡',
    nil,
    'Plante e colha 1 Cebolinha, depois entregue 5 Cebolinhas a Gina Garra de Barro.Sementes de Cebolinha são vendidas pelo Mercador Moncampo no Mercado de Meia Colina. Depois de lavrar e cuidar da planta, você tem que esperar até o dia seguinte para colher Cebolinhas maduras.‡Посадите и вырастите 1 лук-шалот, затем принесите 5 луковиц лука-шалота Джине Грязный Коготь.Семена лука-шалота можно купить на рынке Полугорья у торговца Зеленое Поле. После того как вскопаете грядку и посадите растение, подождите один день, прежде чем собрать урожай.‡Pflanzt 1 Frühlingszwiebel, erntet sie und bringt dann 5 Frühlingszwiebeln zu Gina Lehmkrall.Frühlingszwiebelsamen gibt es beim Händler Grünfeld auf dem Halbhügelmarkt zu kaufen. Nachdem Ihr Eure Pflanzen gepflanzt und gehegt habt, müsst Ihr bis zum nächsten Tag warten, um reife Frühlingszwiebeln ernten zu können.‡파 씨앗 1개를 심어 수확한 후에 지나 머드클로에게 파 5개를 가져가야 합니다.파 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다. 파를 심고 가꾼 후에 하루를 기다려야 잘 익은 파를 수확할 수 있습니다.‡Planta y cosecha 1 cebolleta, y luego entrega 5 cebolletas a Gina Zarpa Fangosa.El mercader Campo Fértil vende semillas de cebolleta en el Mercado del Alcor. Después de arar y cuidar de tu planta, tienes que esperar hasta el día siguiente para cosechar cebolletas maduras.‡‡Plantez et récoltez 1 Échalote, puis livrez 5 Échalotes à Gina Griffe de Tourbe.Les Graines d’échalote peuvent être achetées chez le Marchand Verte Terre, au Marché de Micolline. Après avoir labouré le sol et vous être &lt;occupé/occupée&gt; de votre plant, vous devez attendre le lendemain pour récolter des Échalotes mûres.‡种植并收获一棵葱，然后将5棵葱送给吉娜·泥爪。你可以从半山市集的商人绿野那里买到小葱种子。耕种并灌溉后，你必须等到次日才能收获成熟的葱。‡',
  }
},
[31946] = {
  {
    'O voto de Mung-Mung III: o golpe da cenoura‡Голос Мун-Муна III: великая подмена моркови‡Mung-Mungs Stimme III: Die große Karottenkomödie‡뭉뭉의 한 표 III: 굉장한 당근 절도 사건‡El voto de Mung-Mung III: El gran golpe de las zanahorias‡‡Le vote de Mung-Mung (3) : le grand détournement des carottes‡蒙蒙的选票（三）：狸猫换太子‡',
    nil,
    'Plante e colha 2 Cenouras Mordelícia, depois entregue 10 Cenouras Mordelícia a Mung-Mung.Sementes de Cenoura Mordelícia são vendidas pelo Mercador Moncampo no Mercado de Meia Colina. Depois de lavrar e cuidar da planta, você tem que esperar até o dia seguinte para colher Cenouras Mordelícia maduras.‡Посадите и вырастите 2 сочные хрустящие моркови, затем принесите 10 сочных хрустящих морковок Мун-Муну.Семена сочной хрустящей моркови можно купить на рынке Полугорья у торговца Зеленое Поле. После того как вскопаете грядку и посадите растение, подождите один день, прежде чем собрать урожай.‡Pflanzt 2 saftigleckere Karotten, erntet sie und bringt dann 10 saftigleckere Karotten zu Mung-Mung.Saftigleckere Karottensamen gibt es beim Händler Grünfeld auf dem Halbhügelmarkt zu kaufen. Nachdem Ihr Eure Pflanzen gepflanzt und gehegt habt, müsst Ihr bis zum nächsten Tag warten, um reife saftigleckere Karotten ernten zu können.‡츄릅아삭 당근 씨앗 2개를심어 수확한 뒤 뭉뭉에게 츄릅아삭 당근 10개를 가져가야 합니다.츄릅아삭 당근 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다. 당근을 심고 가꾼 후에 하루를 기다려야 잘 익은 츄릅아삭 당근을 수확할 수 있습니다.‡Planta y cosecha 2 zanahorias Jugoasaz y luego entrega 10 zanahorias Jugoasaz a Mung-Mung.El mercader Campo Fértil vende semillas de zanahoria Jugoasaz en el Mercado del Alcor. Después de arar y cuidar de tu planta, tienes que esperar hasta el día siguiente para cosechar zanahorias Jugoasaz maduras.‡‡Plantez et récoltez 2 Carottes croquejuteuses, puis livrez 10 Carottes croquejuteuses à Mung-Mung.Les Graines de carotte peuvent être achetées chez le Marchand Verte Terre, au Marché de Micolline. Après avoir labouré le sol et vous être occupé de vos plants, vous devez attendre le lendemain pour récolter des Carottes croquejuteuses mûres.‡种植并收获2根爽脆胡萝卜，然后将10根爽脆胡萝卜送给蒙蒙。你可以从半山市集的商人绿野那里买到爽脆胡萝卜种子。耕种并灌溉后，你必须等到次日才能收获成熟的爽脆胡萝卜。‡',
  }
},
[31947] = {
  {
    'O voto do fazendeiro Fung: de olho no repolho‡Голос фермера Фуна III: без ума от капусты‡Bauer Fungs Stimme III: Zum Wohl mit Kohl‡농부 펑의 한 표 III: 양배추에 미치다‡Voto III del granjero Fung: el meollo del repollo‡‡Le vote du fermier Fung (3) : fou de chou‡农夫老方的选票（三）：美味卷心菜‡',
    nil,
    'Plante e colha 3 Repolhos Verdes, depois entregue 15 Repolhos Verdes ao Fazendeiro Fung.Sementes de Repolho Verde são vendidas pelo Mercador Moncampo no Mercado de Meia Colina. Depois de lavrar e cuidar da planta, você tem que esperar até o dia seguinte para colher Repolhos Verdes maduros.‡Посадите и вырастите 3 белокочанной капусты, затем принесите 15 кочанов белокочанной капусты фермеру Фуну.Семена белокочанной капусты можно купить на рынке Полугорья у торговца Зеленое Поле. После того как вскопаете грядку и посадите растение, подождите один день, прежде чем собрать урожай.‡Pflanzt und erntet 3 Grünkohle und bringt dann 15 Grünkohle zu Bauer Fung.Ihr könnt die Samen von Händler Grünfeld auf dem Halbhügelmarkt erwerben. Nach dem Beackern und Pflegen Eurer Pflanze müsst Ihr bis zum nächsten Tag warten, um den reifen Grünkohl zu ernten.‡녹색 양배추 씨앗 3개를 심어 수확한 후에 농부 펑에게 녹색 양배추 15개를 가져가야 합니다.녹색 양배추 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다. 양배추를 심고 가꾼 후에 하루를 기다려야 잘 익은 녹색 양배추를 수확할 수 있습니다.‡Planta y cosecha 3 repollos verdes y luego entrega 15 repollos verdes al granjero Fung.El mercader Campo Fértil vende semillas de repollo verde en el Mercado del Alcor. Después de arar y cuidar de tu planta, tienes que esperar hasta el día siguiente para cosechar repollos verdes maduros.‡‡Plantez et récoltez 3 Choux verts, puis livrez 15 Choux verts au Fermier Fung.Les Graines de chou vert peuvent être achetées chez le Marchand Verte Terre, au Marché de Micolline. Après avoir labouré le sol et vous être occupé de vos plants, vous devez attendre le lendemain pour récolter des Choux verts mûrs.‡种植并收获3颗绿色卷心菜，然后将15颗绿色卷心菜送给农夫老方。你可以从半山市集的商人绿野那里买到绿色卷心菜种子。耕种并灌溉后，你必须等到次日才能收获成熟的绿色卷心菜。‡',
  }
},
[31948] = {
  {
    'O voto de Nana II: as fontes sagradas‡Голос Наны II: священные источники‡Nanas Stimme II: Die Heiligen Quellen‡나나의 한 표 II: 신성한 우물‡El voto de Nana II: Las fuentes sagradas‡‡Le vote de Nana (2) : les sources sacrées‡娜娜的选票（二）：活泉圣水‡',
    nil,
    'Use o Jarro Vazio na Cascata Dourada para coletar Água de Mil Anos. Uma‡Наберите в пустой кувшин тысячелетней воды из Золотого водопада.‡Benutzt den leeren Krug am Goldfächer, um tausend Jahre altes Wasser zu sammeln.‡황금 폭포에서 빈 물병을 사용하여 천년수를 구해야 합니다. 레벨 15 네 바람의 계곡‡Utiliza la jarra vacía en las Cataratas Doradas para recoger agua milenaria.‡‡Utilisez la Cruche vide aux Chutes dorées pour recuellir de l’Eau millénaire.‡用空水罐在流金瀑收集千年沉水。‡',
  }
},
[31949] = {
  {
    'O voto de Nana III: Caipiruva-de-bruxa‡Голос Наны III: сироп из ведьминых ягод‡Nanas Stimme III: Hexenbeeren-Julep‡나나의 한 표 III: 요술딸기 홍초‡El voto de Nana III: Sirope de moruja‡‡Le vote de Nana (3) : l’élixir de sorcielle‡娜娜的选票（三）：浆果冰柠酒‡',
    nil,
    'Plante e colha 3 Uvas-de-bruxa, depois entregue 15 Uvas-de-bruxa a Nana Garra de Barro.Sementes de Uva-de-bruxa são vendidas pelo Mercador Moncampo no Mercado de Meia Colina. Depois de lavrar e cuidar da planta, você tem que esperar até o dia seguinte para colher Uvas-de-bruxa maduras.‡Посадите и вырастите 3 ведьминых ягоды, затем принесите 15 ведьминых ягод Нане Грязный Коготь.Семена ведьминых ягод можно купить на рынке Полугорья у торговца Зеленое Поле. После того как вскопаете грядку и посадите растение, подождите один день, прежде чем собрать урожай.‡Pflanzt 3 Hexenbeeren, erntet sie und bringt dann 15 Hexenbeeren zu Nana Lehmkrall.Hexenbeerensamen gibt es beim Händler Grünfeld auf dem Halbhügelmarkt zu kaufen. Nachdem Ihr Eure Pflanzen gepflanzt und gehegt habt, müsst Ihr bis zum nächsten Tag warten, um reife Hexenbeeren ernten zu können.‡요술딸기 3개를 심고 수확한 후에, 나나 머드클로에게 요술딸기 15개를 가져가야 합니다.요술딸기 씨앗은 언덕골 시장에 있는 상인 그린필드에게서 살 수 있습니다. 딸기를 심고 가꾼 후에 하루를 기다려야 잘 익은 요술딸기를 수확할 수 있습니다.‡Planta y cosecha 3 morujas y luego entrega 15 morujas a Nana Zarpa Fangosa.El mercader Campo Fértil vende semillas de moruja en el Mercado del Alcor. Después de arar y cuidar de tu planta, tienes que esperar hasta el día siguiente para cosechar morujas maduras.‡‡Plantez et récoltez 3 Sorcielles, puis livrez 15 Sorcielles à Nana Griffe de Tourbe.Les Graines de sorcielle peuvent être achetées chez le Marchand Verte Terre, au Marché de Micolline. Après avoir labouré le sol et vous être occupé de vos plants, vous devez attendre le lendemain pour récolter des Sorcielles mûres.‡种植并收获3颗女巫浆果，然后将15颗女巫浆果送给娜娜·泥爪。你可以从半山市集的商人绿野那里买到女巫浆果种子。耕种并灌溉后，你必须等到次日才能收获成熟的女巫浆果。‡',
  }
},
[31950] = {
  {
    'Missão de Rastreio: Levar os PNJs para a Plataforma‡Tracking Quest: Move NPCs to Dais‡Tracking Quest: Move NPCs to Dais‡추적 퀘스트: NPC를 단상으로 이동‡Misión de seguimiento: trasladar a Dais a los PNJ‡‡‡Tracking Quest: Move NPCs to Dais‡',
    nil,
    'Vale dos Quatro Ventos de‡‡‡네 바람의 계곡‡‡‡‡‡',
  }
},
[31951] = {
  {
    'Mestre Zen Aki‡Великая укротительница Аки‡Großmeisterin Aki‡특급 조련사 아키‡Gran maestra Aki‡‡Grand maître Aki‡驯宠宗师亚济‡',
    nil,
    'Vença Aki, a Escolhida, numa batalha de mascotes. Uma‡Победите Аки Избранную в битве питомцев. это‡Besiegt Aki die Auserwählte in einem Haustierkampf.‡애완동물 대전에서 선택받은 자 아키를 꺾어야 합니다. 레벨 1‡Derrota a Aki la Elegida en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Aki l’Élue.‡在宠物战斗中击败天选者亚济。‡',
  }
},
[31952] = {
  {
    'Domadores de Batalha: Pandária‡Укротители боевых питомцев: Пандария‡Kampfhaustierzähmer: Pandaria‡전투 애완동물 조련사: 판다리아‡Domadores de mascotas de duelo: Pandaria‡‡Dompteurs de mascottes de combat : la Pandarie‡战斗宠物训练师：潘达利亚‡',
    nil,
    'Derrote Hyuna dos Altares, a Fazendeira Nishi, Mo\'ruk, o Corajoso Yon, o Perscrutador Zusshi e o Ermâmbulo Shu em Batalhas de Mascotes. Uma‡Победите Хюну Хранительницу Святилищ, фермера Ниши, Мо\'рука, Отважного Юня, искателя Зусши и странника пустошей Шу в битвах питомцев.‡Besiegt Hyuna von den Schreinen, Bäuerin Nishi, Mo\'ruk, Yon den Mutigen, Sucher Zusshi und Ödniswandler Shu in Haustierkämpfen.‡애완동물 대전에서 성소의 현아, 모루크, 농부 니스, 용감한 욘, 수색자 주쉬, 황야의 방랑자 슈를 꺾어야 합니다.‡Derrota a Hyuna de los Santuarios, a la granjera Nishi, a Mo\'ruk, al Valiente Yon, al buscador Zusshi y al transitayermos Shu en duelos de mascotas.‡‡Gagnez un combat de mascottes contre Hyuna des Sanctuaires, le Fermier Nishi, Mo’ruk, Yon le Courageux, le Chercheur Zusshi et le Marchefriche Shu.‡在宠物战斗中击败圣地的俞娜、农夫倪石、莫鲁克、勇敢的尹勇、探索者祖什和废土行者苏游。‡',
  }
},
[31953] = {
  {
    'Grã-mestra Hyuna‡Великая укротительница Хюна‡Großmeisterin Hyuna‡특급 조련사 현아‡Gran maestra Hyuna‡‡Grand maître Hyuna‡驯宠宗师俞娜‡',
    nil,
    'Vença Hyuna dos Altares numa batalha de mascotes. Uma‡Победите Хюну Хранительницу Святилищ в битве питомцев. это‡Besiegt Hyuna von den Schreinen in einem Haustierkampf.‡애완동물 대전에서 성소의 현아를 꺾어야 합니다. 레벨 1‡Derrota a Hyuna de los Santuarios en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Hyuna des Sanctuaires.‡在宠物战斗中击败圣地的俞娜。‡',
  }
},
[31954] = {
  {
    'Mo\'ruk‡Великий укротитель Мо\'рук‡Großmeister Mo\'ruk‡특급 조련사 모루크‡Gran maestro Mo\'ruk‡‡Grand maître Mo’ruk‡驯宠宗师莫鲁克‡',
    nil,
    'Derrote Mo\'ruk em uma batalha de mascotes. Uma‡Победите Мо\'рука в битве питомцев. это‡Besiegt Mo\'ruk in einem Haustierkampf.‡애완동물 대전에서 모루크를 꺾어야 합니다. 레벨 1‡Derrota a Mo\'ruk en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Mo’ruk.‡在宠物战斗中击败莫鲁克。‡',
  }
},
[31955] = {
  {
    'Grã-mestra Nishi‡Великая укротительница Ниши‡Großmeisterin Nishi‡특급 조련사 니스‡Gran maestra Nishi‡‡Grand maître Nishi‡驯宠宗师倪石‡',
    nil,
    'Vença a Fazendeira Nishi numa batalha de mascotes. Uma‡Победите фермера Ниши в битве питомцев. это‡Besiegt Bäuerin Nishi in einem Haustierkampf.‡애완동물 대전에서 농부 니스를 꺾어야 합니다. 레벨 1‡Derrota a la granjera Nishi en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre la Fermière Nishi.‡在宠物战斗中击败农夫倪石。‡',
  }
},
[31956] = {
  {
    'Grão-mestre Yon‡Великий укротитель Юнь‡Großmeister Yon‡특급 조련사 욘‡Gran maestro Yon‡‡Le grand maître Yon‡驯宠宗师尹勇‡',
    nil,
    'Vença o Corajoso Yon numa batalha de mascotes. Uma‡Победите Отважного Юня в битве питомцев. это‡Besiegt Yon den Mutigen in einem Haustierkampf.‡애완동물 대전에서 용감한 욘을 꺾어야 합니다. 레벨 1‡Derrota a Valiente Yon en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Yon le Courageux.‡在宠物战斗中击败勇敢的尹勇。‡',
  }
},
[31957] = {
  {
    'Grão-mestre Shu‡Великий укротитель Шу‡Großmeister Shu‡특급 조련사 슈‡Gran maestro Shu‡‡Grand maître Shu‡驯宠宗师苏游‡',
    nil,
    'Vença o Ermâmbulo Shu numa batalha de mascotes. Uma‡Победите странника пустошей Шу в битве питомцев. это‡Besiegt Ödniswandler Shu in einem Haustierkampf.‡애완동물 대전에서 황야의 방랑자 슈를 꺾어야 합니다. 레벨 1‡Derrota al transitayermos Shu en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre le Marchefriche Shu.‡在宠物战斗中击败废土行者苏游。‡',
  }
},
[31958] = {
  {
    'Mestre Zen Aki‡Великая укротительница Аки‡Großmeisterin Aki‡특급 조련사 아키‡Gran maestra Aki‡‡Grand maître Aki‡驯宠宗师亚济‡',
    nil,
    'Vença Aki, a Escolhida, numa batalha de mascotes. Uma‡Победите Аки Избранную в битве питомцев. это‡Besiegt Aki die Auserwählte in einem Haustierkampf.‡애완동물 대전에서선택받은 자 아키을 꺾어야 합니다. 레벨 1‡Derrota a Aki la Elegida en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Aki l’Élue.‡在宠物战斗中击败天选者亚济。‡',
  }
},
[31959] = {
  {
    'A aposta da imperatriz‡Военный поход императрицы‡Der Trick der Kaiserin‡여제의 도박‡La táctica de la Emperatriz‡‡Le gambit de l’impératrice‡女皇的开局‡',
    nil,
    'Fale com Malik, o Incólume, em frente ao Coração do Medo. Uma‡Поговорите с Маликом Невредимым за пределами Сердца Страха.‡Meldet Euch bei Malik dem Unversehrten vor dem Herzen der Angst.‡공포의 심장 밖에 있는 다치지 않는 말릭에게 보고해야 합니다. 레벨 30 공포의 황무지‡Preséntate ante Malik el Indemne fuera del Corazón del Miedo.‡‡Faites votre rapport à Malik l’Indemne à l’extérieur du Cœur de la peur.‡向恐惧之心的无伤者玛里克报到。‡',
  }
},
