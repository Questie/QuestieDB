},
[9126] = {
  {
    'Matéria-prima de Ceifa-ossos‡Копи костяной косы‡Knochensensenjagd‡해골사신을 위한 발굴‡Excavaciones para la armadura Segahuesos‡Excavaciones para la armadura Segahuesos‡Des morceaux pour la faucheuse d\'os‡骨镰的材料‡骨鐮掘鏟',
    nil,
    'Rohan, o Assassino, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 30 Fragmentos de Osso.|n‡Принесите 30 обломков костей Рохану Убийце в Часовню Последней Надежды в Восточные Чумные земли.‡Rohan der Assassine bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 30 Knochenfragmente.‡동부 역병지대, 희망의 빛 예배당에 있는 암살자 로한이 해골 조각 30개를 가져다 달라고 했습니다.‡Rohan el Asesino, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de huesos.|n‡Rohan el Asesino, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de huesos.|n‡Rohan l\'assassin, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut 30 Fragments d\'os.‡东瘟疫之地圣光之愿礼拜堂的洛汉要30个白骨碎片。‡東瘟疫之地聖光之願禮拜堂的『刺客』羅漢要30個骨頭碎片。',
  }
},
[9127] = {
  {
    '‡Обломки костей‡Knochenfragmente‡해골 조각‡Trozos de huesos‡Trozos de huesos‡Fragments d\'os‡白骨碎片‡骨頭碎片',
    nil,
    nil,
  }
},
[9128] = {
  {
    'A equação elemental‡Уравнение стихий‡Die Elementargleichung‡정령의 정수‡La ecuación elemental‡La ecuación elemental‡L\'équation élémentaire‡元素交易‡元素方程式',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 30 Núcleo dos Elementos.|n‡Принесите 30 средоточий стихий верховному магу Анжеле Досантос в Часовню Последней Надежды в Восточные Чумные земли.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 30 Kerne der Elemente.‡동부 역병지대, 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 정령의 정수 30개를 가져다 달라고 했습니다.‡La archimaga Ángela Dosantos, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 núcleos de elementos.|n‡La archimaga Ángela Dosantos, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 núcleos de elementos.|n‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est veut 30 Noyaux des éléments.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯要30个元素之核。‡東瘟疫之地聖光之願禮拜堂的大法師安琪拉·多桑杜要30個元素之核。',
  }
},
[9129] = {
  {
    '‡Средоточие Стихий‡Kern der Elemente‡정령의 정수‡Núcleo de elementos‡Núcleo de elementos‡Noyau des éléments‡元素之核‡元素之核',
    nil,
    nil,
  }
},
[9130] = {
  {
    'Mercadoria de Luaprata‡Товары из Луносвета‡Waren von Silbermond‡실버문에서 화물 찾아오기‡Mercancía de Ciudad de Lunargenta‡Mercancía de Ciudad de Lunargenta‡Des marchandises de Lune-d\'argent‡银月城的货物‡銀月城的貨物',
    nil,
    'Entregue o Pedido de Sathiel ao Mestre dos Ares Albafulgis na Vila de Brisabela.‡Доставьте список Сатиэль повелителю небес Ясному Рассвету в деревню Легкий Ветерок.‡Bringt Sathiels Frachtbrief zu Himmelsmeister Morgenhell in Morgenluft.‡산들바람 마을에 있는 창공의 조련사 브라이트돈에게 사시엘의 주문서를 가져가야 합니다.‡Entrégale la solicitud de Sathiel al maestro del cielo Alba Brillante en la Aldea Brisa Pura.‡Entrégale la solicitud de Sathiel al maestro del cielo Alba Brillante en la Aldea Brisa Pura.‡Remettez la Demande de Sathiel au maître du ciel Brillaube, à Brise-Clémente.‡将萨希尔的要求交给晴风村的飞行管理员晨光。‡將珊希歐的提貨單交給晴風村裡的飛行師明曦。',
  }
},
[9131] = {
  {
    'Vinculando a Couraçada‡Броня неустрашимости‡Bindung des Schreckenspanzers‡무쌍의 전투장비를 엮을 재료‡Armar la acorator‡Armar la acorator‡Armer un cuirassier‡无畏护甲的材料‡訂做無畏護甲',
    nil,
    'Korfax, lotado na Capela Esperança da Luz, nas Terras Pestilentas Orientais, quer 30 Sucatas de Ferro Negro.‡Принесите 30 пластин черного железа Корфаксу в Часовню Последней Надежды в Восточные Чумные земли.‡Korfax bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 30 Dunkeleisenfragmente.‡동부 역병지대, 희망의 빛 예배당에 있는 코팩스가 검은무쇠 조각 30개를 가져다 달라고 했습니다.‡Korfax, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 fragmentos de hierro negro.‡Korfax, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 fragmentos de hierro negro.‡Korfax, de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut 30 Morceaux de sombrefer.‡东瘟疫之地圣光之愿礼拜堂的科尔法克斯要30个黑铁碎片。‡東瘟疫之地聖光之願禮拜堂的柯菲斯要30個黑鐵碎塊。',
  }
},
[9132] = {
  {
    '‡Пластины из темного железа‡Dunkeleisenfragmente‡검은무쇠 조각‡Fragmentos de hierro negro‡Fragmentos de hierro negro‡Morceaux de sombrefer‡黑铁碎片‡黑鐵碎塊',
    nil,
    nil,
  }
},
[9133] = {
  {
    'Voo para Luaprata‡Полет в Луносвет‡Fliegt nach Silbermond‡하늘을 날아서 실버문으로‡Vuelo a la Ciudad de Lunargenta‡Vuelo a la Ciudad de Lunargenta‡Un vol jusqu\'à Lune-d\'argent‡飞往银月城‡飛往銀月城',
    nil,
    'Pegue um voo para Luaprata e entregue o Pedido de Sathiel para Sathren Albazul.‡Оплатите полет в Луносвет и доставьте список Сатиэль Сатрену Лазурному Рассвету в Луносвет.‡Erwerbt einen Flug nach Silbermond und bringt Sathiels Frachtbrief zu Sathren Morgenblau in Silbermond.‡요금을 치르고 실버문으로 가서 사스렌 아주어돈에게 사시엘의 주문서를 전해야 합니다‡Compra un vuelo a la Ciudad de Lunargenta y entrégale la solicitud de Sathiel a Sathren Azurocaso en la Ciudad de Lunargenta.‡Compra un vuelo a la Ciudad de Lunargenta y entrégale la solicitud de Sathiel a Sathren Azurocaso en la Ciudad de Lunargenta.‡Achetez un vol pour Lune-d’argent et remettez la Demande de Sathiel à Sathren Aube-azur, à Lune-d’argent.‡租用飞行服务前往银月城，并将萨希尔的要求交给银月城的萨斯雷·蓝空。‡飛回銀月城並將珊希歐的提貨單交給銀月城的賽詩倫‧蒼曦。',
  }
},
[9134] = {
  {
    'A mestre dos ares Crepúsculo‡Повелительница небес Полудымка‡Himmelsmeisterin Abendlicht‡창공의 조련사 글로밍‡La maestra del cielo Anochecer‡La maestra del cielo Anochecer‡La maîtresse du ciel Tombejour‡葛拉米‡女飛行師薄暮',
    nil,
    'Leve a Mercadoria de Sathiel para a Mestre dos Ares Crepúsculo perto da entrada do Portão do Pastor em Luaprata.‡Доставьте товары Сатиэль повелительнице небес Полудымке к вратам Пастыря, что ведут в Луносвет.‡Bringt Sathiels Waren zu Himmelsmeisterin Abendlicht am Hirtentor direkt außerhalb von Silbermond.‡실버문의 수호자의 관문 바깥에 있는 창공의 조련사 글로밍에게 사시엘의 물건을 가져가야 합니다.‡Lleva los bienes de Sathiel a la maestra del cielo Anochecer, que está junto a la Puerta del Pastor en Ciudad de Lunargenta.‡Lleva los bienes de Sathiel a la maestra del cielo Anochecer, que está junto a la Puerta del Pastor en Ciudad de Lunargenta.‡Apporter les Marchandises de Sathiel à la maîtresse du ciel Tombejour, juste devant la Porte du Berger, à Lune-d’argent.‡将萨希尔的货物交给银月城的牧羊人之门外的葛拉米。‡將珊希歐的貨物帶給銀月城牧羊人之門外的女飛行師薄暮。',
  }
},
[9135] = {
  {
    'Reencontro com Sathiel‡Возвращение к Сатиэль‡Zurück zu Sathiel‡다시 사시엘에게로‡Regresa junto a Sathiel‡Regresa junto a Sathiel‡Le retour vers Sathiel‡返回萨希尔身边‡回去找珊希歐',
    nil,
    'Pegue um voo de volta para a Vila de Brisabela na Floresta do Canto Eterno e entregue a Mercadoria de Sathiel.‡Оплатите обратный полет в деревню Легкий Ветерок в Лесах Вечной Песни и доставьте Сатиэль товары Сатиэль.‡Erwerbt einen Flug zurück nach Morgenluft im Immersangwald und liefert Sathiels Waren bei Sathiel ab.‡영원노래 숲의 산들바람 마을로 돌아가서 사시엘의 물건을 사시엘에게 전해야 합니다.‡Compra un vuelo de vuelta la Aldea Brisa Pura, en el Bosque Canción Eterna y entrégale a Sathiel los bienes de Sathiel.‡Compra un vuelo de vuelta la Aldea Brisa Pura, en el Bosque Canción Eterna y entrégale a Sathiel los bienes de Sathiel.‡Achetez un vol de retour vers Brise-Clémente dans les Bois des Chants éternels, et remettez les Marchandises de Sathiel à Sathiel.‡租用飞行服务返回永歌森林的晴风村，将萨希尔的货物交给萨希尔。‡使用飛行服務回到永歌森林的飛行師明曦，並將珊希歐貨物送到珊希歐那裡。',
  }
},
[9136] = {
  {
    'Flora selvagem‡Дикая флора‡Wildpflanzen‡야생 잎사귀‡Flora salvaje‡Flora salvaje‡La flore sauvage‡蛮荒之叶‡野性植物群',
    nil,
    'Rayne, baseada na Capela Esperança da Luz, nas Terras Pestilentas Orientais, quer 30 Frondes Selvagens.‡Принесите 30 диких ростков Райн в Часовню Последней Надежды в Восточные Чумные земли.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 30 Wildwedel.‡동부 역병지대, 희망의 빛 예배당에 있는 레인이 야생 잎사귀 30개를 가져다 달라고 했습니다.‡Rayne, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 hojas salvajes.‡Rayne, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 hojas salvajes.‡Rayne de la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est veut 30 Palmes sauvages.‡东瘟疫之地圣光之愿礼拜堂的莱茵需要30片蛮荒之叶。‡東瘟疫之地聖光之願禮拜堂的瑞恩要30個野性藻葉。',
  }
},
[9137] = {
  {
    '‡Дикая флора‡Wildwedel‡‡Flora salvaje‡Flora salvaje‡La flore sauvage‡蛮荒之叶‡',
    nil,
    nil,
  }
},
[9138] = {
  {
    'Vila Corona Solar‡Деревня Солнечной Короны‡Sonnenkuppe‡태양왕관 마을‡La Aldea Corona del Sol‡La Aldea Corona del Sol‡Le village de Solcouronne‡日冕村‡日冠村',
    nil,
    'Mate 10 Guardas de Nerúbis e apresente-se ao Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Убейте 10 нерубов-стражей и возвращайтесь к чародею Вандрилу в Транкивиллион, что в Призрачных землях.‡Tötet 10 nerubische Wachen und kehrt anschließend zu Arkanist Vandril in Tristessa in den Geisterlanden zurück.‡네루비스 경비병 10마리를 해치운 후 유령의 땅의 트랜퀼리엔에 있는 비전술사 반드릴에게 가야 합니다.‡Mata a 10 guardias Nerubis y después regresa junto al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Mata a 10 guardias Nerubis y después regresa junto al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Tuez 10 Gardes nérubis, puis retournez voir l\'arcaniste Vandril à Tranquillien dans les Terres fantômes.‡杀死10个蛛怪卫兵，然后向幽魂之地塔奎林的奥术师范迪瑞尔复命。‡殺死10個奈幽碧斯守衛，再回到鬼魂之地的安寧地找秘法師范德隆。',
  }
},
[9139] = {
  {
    'Vila de Aurinévoa‡Деревня Золотистой Дымки‡Goldnebel‡황금안개 마을‡Aldea Bruma Dorada‡Aldea Bruma Dorada‡Brume-d\'or‡金雾村‡金霧村',
    nil,
    'Mate 6 Fantasmas Quel\'dorei e 4 Espectros Quel\'dorei na Vila de Aurinévoa e apresente-se ao Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Уничтожьте 6 кель\'дорайских привидений и 4 кель\'дорайских призрака в деревне Золотистой Дымки, затем возвращайтесь к чародею Вандрилу в Транквиллион, что в Призрачных землях.‡Besiegt 6 Geister der Quel\'dorei und 4 Gespenster der Quel\'dorei in Goldnebel. Kehrt anschließend zu Arkanist Vandril in Tristessa in den Geisterlanden zurück.‡황금안개 마을에서 쿠엘도레이 유령 6마리, 쿠엘도레이 망령 4마리를 해치운 후 유령의 땅의 트랜퀼리엔에 있는 비전술사 반드릴에게 가야 합니다.‡Derrota a 6 fantasmas y 4 ánimas Quel\'dorei en la Aldea Bruma Dorada y luego ve a ver al arcanista Vandril a Tranquillien en las Tierras Fantasma.‡Derrota a 6 fantasmas y 4 ánimas Quel\'dorei en la Aldea Bruma Dorada y luego ve a ver al arcanista Vandril a Tranquillien en las Tierras Fantasma.‡Vaincre 6 Fantômes quel\'dorei et 4 Âmes en peine quel\'dorei au village de Brume-d\'or, puis retourner voir l\'arcaniste Vandril à Tranquillien, dans les Terres fantômes.‡在金雾村消灭6个奎尔多雷鬼魂和4个奎尔多雷怨灵，然后向幽魂之地塔奎林的奥术师范迪瑞尔复命。‡到金霧村擊敗6個奎爾多雷鬼靈和4個奎爾多雷怨靈，再回到鬼魂之地的安寧地找秘法師范德隆。',
  }
},
[9140] = {
  {
    'Vila dos Correventos‡Деревня Ветрокрылых‡Windläuferdorf‡윈드러너 마을‡La Aldea Brisaveloz‡La Aldea Brisaveloz‡Coursevent‡风行村‡風行者村',
    nil,
    'Colete 6 Substâncias Fantasma e 4 Fragmentos de Gárgula. Devolva-os ao Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Соберите 6 порций иллюзорного вещества и 4 обломка горгульи. Возвращайтесь к чародею Вандрилу в Транквиллион, что в Призрачных землях.‡Sammelt 6 geisterhafte Substanzen und 4 Gargoylefragmente und bringt sie zu Arkanist Vandril in Tristessa in den Geisterlanden.‡실체 없는 잔여물 6개, 가고일 파편 4개를 모아, 유령의 땅, 트랜퀼리엔에 있는 비전술사 반드릴에게 가져가야 합니다.‡Recolecta 6 sustancias fantasmales y 4 fragmentos de gárgola. Vuelve junto al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Recolecta 6 sustancias fantasmales y 4 fragmentos de gárgola. Vuelve junto al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Collectez 6 Substances fantasmatiques et 4 Fragments de gargouille. Rapportez-les à l\'arcaniste Vandril à Tranquillien dans les Terres fantômes.‡收集6份幻影灵质和4块石像鬼碎片，把它们交给幽魂之地塔奎林的奥术师范迪瑞尔。‡收集6份幻魅實體和4份石像鬼碎片並帶到鬼魂之地的安寧地給秘法師范德隆。',
  }
},
[9141] = {
  {
    'Pode me chamar de O Galo‡Не все так просто‡Sie nennen mich "den Schleifer"‡\'거드름쟁이\'라고 불리는 이유‡Me llaman "El Gallo"‡Me llaman "El Gallo"‡On m\'appelle « Le Coq »‡梅兹的文书‡他們叫我「鬥士」',
    nil,
    'O Comandante de Expedição Metz na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer um Símbolo de Bravura da Aurora Argêntea.|n‡Принесите знак доблести Серебряного Рассвета командиру Метцу в Часовню Последней Надежды в Восточные Чумные земли.‡Einsatzkommandant Metz bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte eine Ehrenmarke der Argentumdämmerung.‡동부 역병지대의 희망의 빛 예배당에 있는 파견사령관 메츠가 은빛 여명회 명예 휘장을 가져다 달라고 했습니다.‡El comandante de envíos Metz de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere una muestra de valor de El Alba Argenta.|n‡El comandante de envíos Metz de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere una muestra de valor de El Alba Argenta.|n‡Le commandant d\'ordonnance Metz, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut une Marque de valeur de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的物资官员梅兹要一枚银色黎明勇气勋章。‡東瘟疫之地聖光之願禮拜堂的發送指揮官梅茲想要一枚銀色黎明勇氣勳章。',
  }
},
[9142] = {
  {
    '‡Задание мастера‡Handwerksverfügung‡‡Libranza del artesano‡Libranza del artesano‡Commission d\'artisan‡工匠文书‡',
    nil,
    nil,
  }
},
[9143] = {
  {
    'Dando um jeito em Zeb\'Sora‡Неприятности в Зеб\'Соре‡Maßnahmen gegen Zeb\'Sora‡제브소라 처리‡Encargarse de Zeb\'Sora‡Encargarse de Zeb\'Sora‡S\'occuper de Zeb\'Sora‡塞布索雷的巨魔‡與札布索拉交涉',
    nil,
    'Colete 6 Orelhas de Troll Zeb\'Sora e entregue-as para a Patrulheira Valanna na Terra Fantasma.‡Добудьте 6 ушей троллей из Зеб\'Соры и принесите их следопыту Валанне в Призрачные земли.‡Sammelt 6 Trollohren von Zeb\'Sora und bringt sie zu Waldläuferin Valanna in den Geisterlanden.‡제브소라 트롤 귀걸이 6개를 모아 유령의 땅에 있는 순찰자 발란나에게 가져가야 합니다.‡Lleva 6 orejas de trol de Zeb\'Sora a la forestal Valanna a las Tierras Fantasma.‡Lleva 6 orejas de trol de Zeb\'Sora a la forestal Valanna a las Tierras Fantasma.‡Collecter 6 Oreilles de trolls de Zeb\'Sora et les remettre au Forestier Valanna dans les Terres fantômes.‡收集6个塞布索雷巨魔标记，把它们交给幽魂之地的游侠瓦兰娜。‡收集6個札布索拉食人妖耳朵再回到鬼魂之地找遊俠瓦拉娜。',
  }
},
[9144] = {
  {
    'Perdido na Terra Fantasma‡Пропавший в Призрачных землях‡Verschollen in den Geisterlanden‡유령의 땅에서 실종된 조카‡Desaparecido en las Tierras Fantasma‡Desaparecido en las Tierras Fantasma‡Disparu dans les Terres fantômes‡迷失在幽魂之地‡鬼魂之地的失蹤者',
    nil,
    'Siga a estrada que parte da Vila de Brisabela rumo ao sul e procure o Mensageiro Albatrilha quando se aproximar da Terra Fantasma.‡Идите по дороге, ведущей из деревни Легкий Ветерок на юг, и найдите курьера Рассветного Странника.‡Folgt der Straße, die von Morgenluft aus nach Süden führt, und haltet Ausschau nach Kurier Morgenwandler, wenn Ihr die Geisterlande erreicht.‡산들바람 마을을 나가는 길을 따라 남쪽으로 가서 유령의 땅에 다다르는 길목에서 급사 돈스트라이더를 찾아야 합니다.‡Sigue el camino hacia el sur desde la Aldea Brisa Pura y busca al mensajero Caminalba mientras te acercas a las Tierras Fantasma.‡Sigue el camino hacia el sur desde la Aldea Brisa Pura y busca al mensajero Caminalba mientras te acercas a las Tierras Fantasma.‡Suivez la route qui part du village de Brise-clémente vers le sud. Lorsque vous approcherez les Terres fantômes, cherchez le Courrier Aube-glorieuse.‡沿着道路离开晴风村，到幽魂之地去寻找信使迪卡·晨行者。‡沿著晴風村外面的路往南走，到鬼魂之地找信差晨行者。',
  }
},
[9145] = {
  {
    'Ajude a patrulheira Valanna!‡Спасти следопыта Валанну‡Hilfe für Waldläuferin Valanna!‡순찰자 발란나를 도와주세요!‡¡Ayuda a la forestal Valanna!‡¡Ayuda a la forestal Valanna!‡Il faut aider le forestier Valanna !‡帮助游侠瓦兰娜‡幫幫遊俠瓦拉娜!',
    nil,
    'Encontre a Patrulheira Valanna e o Tenente Tomathren às margens do Lago Elrendar, que fica na Terra Fantasma perto da Vila Corona Solar.‡Найдите следопыта Валанну и лейтенанта Томатрена на берегу озера Эрлендар в Призрачных землях близ деревни Солнечной Короны.‡Findet Waldläuferin Valanna und Leutnant Tomathren am Ufer des Elrendarsees nahe Sonnenkuppe in den Geisterlanden.‡태양왕관 마을 근처 유령의 땅에 있는 엘렌다르 호수 기슭에서 순찰자 발란나와 부관 토마스렌을 찾아야 합니다.‡Encuentra a la forestal Valanna y al teniente Tomathren en la orilla del Lago Elrendar, en las Tierras Fantasma cerca de la Aldea Corona del Sol.‡Encuentra a la forestal Valanna y al teniente Tomathren en la orilla del Lago Elrendar, en las Tierras Fantasma cerca de la Aldea Corona del Sol.‡Trouver le forestier Valanna et le lieutenant Tomathren sur la rive du lac Elrendar, dans les Terres fantômes, près du village de Solcouronne.‡在幽魂之地日冕村附近的艾伦达尔湖畔寻找游侠瓦兰娜和托曼森中尉。‡到日冠村附近的鬼魂之地找到遊俠瓦拉娜與湯瑪索倫中尉，他在艾蘭達之湖的湖岸邊。',
  }
},
[9146] = {
  {
    'Apresente-se ao capitão Helios‡Донесение капитану Гелиосу‡Meldung bei Hauptmann Helios‡순찰대장 헬리오스에게 보고‡Informar al capitán Helios‡Informar al capitán Helios‡Un rapport pour le capitaine Hélios‡向赫里奥斯中尉报到‡向希里歐斯隊長回報',
    nil,
    'Fale com o Capitão Helios no Enclave dos Andarilhos, que fica na margem sul do Lago Elrendar na Terra Fantasma.‡Поговорите с капитаном Гелиосом в Анклаве Странников на южном берегу озера Элрендар в Призрачных землях.‡Sprecht mit Hauptmann Helios bei der Enklave der Weltenwanderer am südlichen Ufer des Elrendarseese in den Geisterlanden.‡유령의 땅, 엘렌다르 호수 남쪽 기슭의 원정순찰대 초소에 있는 순찰대장 헬리오스와 대화해야 합니다.‡Habla con el capitán Helios en el Enclave del Errante, en la orilla sur del Lago Elrendar en las Tierras Fantasma.‡Habla con el capitán Helios en el Enclave del Errante, en la orilla sur del Lago Elrendar en las Tierras Fantasma.‡Parler au capitaine Hélios à l\'enclave des Pérégrins, sur la rive sud du lac Elrendar, dans les Terres fantômes.‡到幽魂之地的艾伦达尔湖南岸去，与远行者营地的赫里奥斯中尉谈一谈。‡到鬼魂之地的艾蘭達之湖南邊，和旅行者營地的希里歐斯隊長談談。',
  }
},
[9147] = {
  {
    'O mensageiro caído‡Умирающий курьер‡Der sterbende Kurier‡쓰러진 전령‡El mensajero caído‡El mensajero caído‡Le courrier blessé‡倒下的信使‡倒下的信差',
    nil,
    'A Boticária Thereza na Floresta do Canto Eterno quer que você colete 4 Amostras de Sangue Pestilento das feras da Terra Fantasma.‡Аптекарь Тедра из лесов Вечной Песни просит вас принести ей 4 образца зараженной крови животных из Призрачных земель.‡Apothekerin Thedra im Immersangwald möchte, dass Ihr ihr 4 verseuchte Blutproben von Tieren aus den Geisterlanden bringt.‡영원노래 숲에 있는 연금술사 세드라가 유령의 땅의 짐승으로부터 역병에 오염된 혈액 견본 4개를 가져다 달라고 했습니다.‡La boticaria Thedra en el Bosque Canción Eterna quiere que le lleves 4 muestras de sangre apestada de las bestias de las Tierras Fantasma.‡La boticaria Thedra en el Bosque Canción Eterna quiere que le lleves 4 muestras de sangre apestada de las bestias de las Tierras Fantasma.‡L\'apothicaire Thedra du bois des Chants éternels veut que vous lui apportiez 4 Échantillons de sang pestiféré pris sur les bêtes des Terres fantômes.‡药剂师瑟德拉要求你从幽魂之地的野兽身上收集4份染疫血样。‡永歌森林的藥劑師泰德拉要你幫她從鬼魂之地的野獸身上帶來4份感染瘟疫的血液樣本。',
  }
},
[9148] = {
  {
    'Entrega para Tranquillien‡Письмо в Транкивиллион‡Zustellung nach Tristessa‡트랜퀼리엔으로 편지 배달‡Entrega en Tranquillien‡Entrega en Tranquillien‡Livraison à Tranquillien‡送往塔奎林的信件‡送貨至安寧地',
    nil,
    'Leve a Carta de Luaprata para o Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Отнесите письмо из Луносвета чародею Вандрилу в Транквиллион, что в Призрачных землях.‡Bringt den Brief aus Silbermond zu Arkanist Vandril in Tristessa in den Geisterlanden.‡유령의 땅의 트랜퀼리엔에 있는 비전술사 반드릴에게 실버문에서 온 편지를 가져가야 합니다.‡Llévale la carta de Lunargenta al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Llévale la carta de Lunargenta al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Apportez la Lettre de Lune-d\'argent à l\'arcaniste Vandril à Tranquillien, dans les Terres fantômes.‡将银月城的信件交给幽魂之地塔奎林的奥术师范迪瑞尔。‡將銀月的信件送到鬼魂之地交給安寧地的秘法師范德隆。',
  }
},
[9149] = {
  {
    'A costa infecta‡Чумной берег‡Die verseuchte Küste‡오염된 해안‡La costa apestada‡La costa apestada‡La côte pestiférée‡瘟疫海岸‡感染瘟疫的海岸',
    nil,
    'Leve 6 Espinhas Pestilentas de Murloc para o Boticário Reinaldo na Terra Fantasma.‡Принесите 6 хребтов чумных мурлоков аптекарю Рензитену в Транквиллион, что в Призрачных землях.‡Bringt 6 verseuchte Murlocrückgrate zu Apotheker Renzithen in Tristessa in den Geisterlanden.‡유령의 땅의 트랜퀼리엔에 있는 연금술사 렌지센에게 역병 걸린 멀록의 등뼈 6개를 가져가야 합니다.‡Llévale 6 espinas dorsales de múrloc apestado al boticario Renzithen en Tranquillien, en las Tierras Fantasma.‡Llévale 6 espinas dorsales de múrloc apestado al boticario Renzithen en Tranquillien, en las Tierras Fantasma.‡Apportez 6 Epines dorsales de murlocs pestiférés à l\'apothicaire Renzithen, à Tranquillien dans les Terres fantômes.‡将6根染疫鱼人脊骨交给塔奎林的药剂师雷兹特恩。‡將6個感染瘟疫的魚人脊椎帶到鬼魂之地給安寧地的藥劑師倫澤紳。',
  }
},
[9150] = {
  {
    'Resgatando o passado‡Спасение прошлого‡Reise zum vergessenen Sanktum‡과거를 구하라‡Al rescate del pasado‡Al rescate del pasado‡Les dépouilles du passé‡重建历史‡搶救過去',
    nil,
    'O Magíster Darenis quer que você vá para o Sacrário Lunar, a oeste de Tranquillien, e recupere 8 Essências de Mana Cristalizadas dos Devoradores Arcanos e Deslocadores de Mana que habitam a estrutura.‡Магистр Даренис хочет, чтобы вы отправились в святилище Луны к западу от Транквиллиона и добыли 8 кристализованных субстанций маны с волшебных пожирателей и маначервей, что населяют это место.‡Magister Darenis möchte, dass Ihr zum Sanktum des Mondes westlich von Tristessa reist und dort 8 kristallisierte Manaessenzen von den dort hausenden Arkanverschlingern und Manaschleichern erlangt.‡마법학자 다레니스가 트랜퀼리엔 서쪽에 있는 달의 성소로 가서 그곳에 서식하는 비전 포식자와 걸신들린 마나 지룡을 처치하고 결정화된 마나 정수 8개를 모아달라고 했습니다.‡El magister Darenis quiere que vayas al Sagrario de la Luna al oeste de Tranquillien y recuperes 8 esencias de maná cristalizado de los devoradores arcanos y de los conmutadores de maná que pueblan la estructura.‡El magister Darenis quiere que vayas al Sagrario de la Luna al oeste de Tranquillien y recuperes 8 esencias de maná cristalizado de los devoradores arcanos y de los conmutadores de maná que pueblan la estructura.‡Le magistère Darenis veut que vous vous rendiez au sanctum de la Lune, à l\'ouest de Tranquillien, et que vous récupériez 8 Essences de mana cristallisées sur les Dévoreurs arcaniques et les Changemana qui occupent les lieux.‡魔导师戴伦尼斯要你前往塔奎林以西的月亮圣殿，从那里的奥术吞噬者和法力流窜者身上取回8份晶化法力精华。‡博學者戴倫尼斯要你前往安寧地西邊的明月聖所並從住在那棟建築物的秘法吞噬者和法力轉移蟲身上取回8個晶化法力精華。',
  }
},
[9151] = {
  {
    'O sacrário solar‡Святилище Солнца‡Das Sanktum der Sonne‡태양의 성소‡El Sagrario del Sol‡El Sagrario del Sol‡Le sanctum du Soleil‡太阳圣殿‡太陽聖所',
    nil,
    'Fale com o Magíster Idonis no Sacrário Solar, que fica na Terra Fantasma.‡Поговорите с магистром Идонисом в святилище Солнца в Призрачных землях.‡Sprecht mit Magister Idonis im Sanktum der Sonne in den Geisterlanden.‡유령의 땅에 있는 태양의 성소에서 마법학자 이도니스와 대화해야 합니다.‡Ve al Sagrario del Sol en las Tierras Fantasma y habla con el magister Idonis.‡Ve al Sagrario del Sol en las Tierras Fantasma y habla con el magister Idonis.‡Parlez au magistère Idonis au sanctum du Soleil dans les Terres fantômes.‡与幽魂之地太阳圣殿的魔导师伊东尼斯谈一谈。‡到鬼魂之地和太陽聖所的博學者艾度尼斯談談。',
  }
},
[9152] = {
  {
    'Suprimentos de Raposo‡Припасы могильщика‡Tombers Vorräte‡톰버의 보급품‡Los suministros de Sepulturero‡Los suministros de Sepulturero‡Les marchandises de Tombal‡托博尔的补给品‡土柏的貨物',
    nil,
    'Recupere os Suprimentos de Maurício Raposo e devolva-os para ele em Tranquillien, que fica na Terra Fantasma.‡Найдите припасы Ратиса Могильщика и верните их хозяину в Транквиллион, что в Призрачных землях.‡Erlangt Rathis Tombers Vorräte und kehrt zu ihm in Tristessa in den Geisterlanden zurück.‡라디스 톰버의 보급상자를 찾아서 유령의 땅에 있는 트랜퀼리엔에 있는 라디스 톰버에게 가져가야 합니다.‡Recupera los suministros de Rathis Sepulturero y llévaselos a Tranquillien, en las Tierras Fantasma.‡Recupera los suministros de Rathis Sepulturero y llévaselos a Tranquillien, en las Tierras Fantasma.‡Retrouver la Marchandise de Rathis Tombal et la lui rapporter à Tranquillien dans les Terres fantômes.‡找到拉提斯·托博尔的补给品，把它交给幽魂之地塔奎林的拉提斯·托博尔。‡取回拉提斯·土柏的貨物並回到鬼魂之地的安寧地交給他。',
  }
},
[9153] = {
  {
    'Sob a sombra‡Под тенью‡Bedrohliche Schatten‡그림자 밑에서‡Bajo la Sombra‡Bajo la Sombra‡Sous les ombres‡阴影之下‡陰影之下',
    nil,
    'Verifique seu mapa para encontrar uma região sob ataque do Flagelo. Vá até lá e derrote os membros do Flagelo em torno da necrópole, a fim de danificá-la. Em seguida, entregue 10 Runas Necróticas para o Comandante Tomás Helleran na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Найдите по карте регион, атакуемый Плетью. Отправляйтесь туда и излейте свою ярость на некрополь, разгромив толпы Плети вокруг него. Доставьте 10 некротических рун Плети командиру Томасу Элерану в Часовню Последней Надежды в Восточные Чумные земли.‡Benutzt Eure Karte, um von der Geißel angegriffene Gebiete ausfindig zu machen. Geht dorthin und beschädigt eine Nekropole, indem Ihr die Truppen der Geißel, die sie umgeben, besiegt. Bringt 10 ihrer nekrotischen Runen zu Kommandant Thomas Helleran bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡지도를 확인하여 스컬지가 침공한 지역을 찾아야 합니다. 그곳에서 요새 아래 모인 스컬지를 무찔러 죽음의 요새를 공격해야 합니다. 죽음의 룬 10개를 모아서 동부 역병지대, 희망의 빛 예배당에 있는 사령관 토마스 헬러랜에게 돌아가십시오.‡Busca en tu mapa una zona que esté bajo el ataque de la Plaga. Ve y derrota a los miembros de la Plaga que custodian la necrópolis. Lleva 10 runas necróticas al comandante Thomas Helleran a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Busca en tu mapa una zona que esté bajo el ataque de la Plaga. Ve y derrota a los miembros de la Plaga que custodian la necrópolis. Lleva 10 runas necróticas al comandante Thomas Helleran a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Surveillez votre carte pour trouver une région subissant une attaque du Fléau. Allez-y et endommagez une nécropole en exterminant les créatures du Fléau aux alentours. Rapportez ensuite 10 de leurs Runes nécrotiques au commandant Thomas Helleran, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡在你的地图上寻找天灾入侵的地区。击败浮空城周围的天灾士兵，摧毁一处浮空城。将10块死灵石交给东瘟疫之地圣光之愿礼拜堂的指挥官托马斯·海勒拉。‡查看你的地圖找到受天譴軍團攻擊的區域。前往那裡並擊敗附近的天譴軍團以破壞一個亡域。帶回10個他們的亡域之石給東瘟疫之地，聖光之願禮拜堂的指揮官湯瑪士·海勒瑞。',
  }
},
[9154] = {
  {
    'Capela Esperança da Luz‡Часовня Последней Надежды‡Kapelle des Hoffnungsvollen Lichts‡희망의 빛 예배당‡Capilla de la Esperanza de la Luz‡Capilla de la Esperanza de la Luz‡La chapelle de l\'Espoir de Lumière‡圣光之愿礼拜堂‡聖光之願禮拜堂',
    nil,
    'Entregue o Anúncio do Chamado às Armas para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите объявление о мобилизации Хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den Ruf zu den Waffen zum Bewahrer der Schriften in der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 징병 통지서를 가져가야 합니다.‡Lleva la llamada a las armas al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la llamada a las armas al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez l\'Annonce de l\'appel aux armes au gardien des registres, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将征兵公告交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將銀色黎明召集令佈告交給在東瘟疫之地聖光之願禮拜堂的名冊保管者。',
  }
},
[9155] = {
  {
    'Na trilha da morte‡По Тропе Мертвых‡Entlang der Todesschneise‡죽음의 흉터 아래로‡Limpiar La Cicatriz Muerta‡Limpiar La Cicatriz Muerta‡Dans la Malebrèche‡前往死亡之痕‡進入死亡之痕',
    nil,
    'Mate 10 Famélicos Reanimados e 10 Canibais Tortos na Trilha da Morte. Fale novamente com o Sicário Raniério em Tranquillien para receber sua recompensa.‡Убейте 10 восставших ненасытников и 10 уродливых каннибалов на Тропе Мертвых. Возвращайтесь к ловчему смерти Ратиэлю в Транквиллион за наградой.‡Tötet 10 hungrige Auferstandene und 10 gegeißelte Kannibalen in der Todesschneise. Kehrt anschließend zu Todespirscher Rathiel in Tristessa zurück, um Eure Belohnung zu erhalten.‡죽음의 흉터에서 굶주린 좀비, 절름발 식인귀를 각각 10마리씩 해치운 후 트랜퀼리엔에 있는 죽음추적자 라시엘에게 가야 합니다.‡Mata 10 hambrientos resucitados y 10 caníbales gangliosos en La Cicatriz Muerta. Ve a ver al mortacechador Rathiel a Tranquillien para recibir una recompensa.‡Mata 10 hambrientos resucitados y 10 caníbales gangliosos en La Cicatriz Muerta. Ve a ver al mortacechador Rathiel a Tranquillien para recibir una recompensa.‡Tuez 10 Affameurs ressuscités et 10 Cannibales dégingandés dans la Malebrèche. Retournez voir le nécrotraqueur Rathiel à Tranquillien dans les Terres fantômes pour obtenir une récompense.‡在死亡之痕除掉10个复生的饥饿者和10个笨拙的食尸者，然后向塔奎林的亡灵哨兵拉提尔复命。‡殺死死亡之痕的10個重生的飢餓者和10個笨拙的食人者。再回到安寧地找亡靈哨兵瑞希爾領取獎勵。',
  }
},
[9156] = {
  {
    'Procura-se: Putripunho e Luzran‡Разыскиваются: Гнилоступ и Лузран‡Gesucht: Faulbein und Luzran‡현상 수배: 썩은돌기와 루즈란‡Se busca: Putrenudillos y Luzran‡SE BUSCAN: Putrenudillos y Luzran‡On recherche : Putrepoing et Luzran‡通缉：纳克雷洛特和卢兹兰‡懸賞:納克羅和路斯萊恩',
    nil,
    'Vasculhe a Terra Fantasma e encontre Putripunho e Luzran. Leve a cabeça deles para o Sicário Raniério em Tranquillien, para receber sua recompensa.‡Найдите в Призрачных землях Гнилоступа и Лузрана. Принесите их головы ловчему смерти Ратиэлю в Транквиллион и получите награду.‡Sucht in den Geisterlanden nach Faulbein und Luzran. Bringt ihre Köpfe zu Todespirscher Rathiel in Tristessa, um eine Belohnung zu erhalten.‡유령의 땅에서 썩은돌기와 루즈란을 찾아내야 합니다. 트랜퀼리엔에 있는 죽음추적자 라시엘에게 놈들이 죽었다는 증거를 들고 가면 보상을 받을 수 있습니다.‡Busca a Putrenudillos y Luzran en las Tierras Fantasma. Lleva sus cabezas al mortacechador Rathiel a Tranquillien y recibirás una recompensa.‡Busca a Putrenudillos y Luzran en las Tierras Fantasma. Lleva sus cabezas al mortacechador Rathiel a Tranquillien y recibirás una recompensa.‡Recherchez Putrepoing et Luzran dans les Terres fantômes et tuez-les. Rapportez leurs têtes au nécrotraqueur Rathiel à Tranquillien pour empocher une prime.‡在幽魂之地搜寻并杀死纳克雷洛特和卢兹兰，将他们的徽记交给塔奎林的亡灵哨兵拉提尔换取奖励。‡前往鬼魂之地找到納克羅和路斯萊恩。把他們的頭顱帶到安寧地給亡靈哨兵瑞希爾以領取賞金。',
  }
},
[9157] = {
  {
    'Rituais esquecidos‡Забытые обряды‡Vergessene Rituale‡잊혀진 의식‡Rituales olvidados‡Rituales olvidados‡Rituels oubliés‡被遗忘的仪祭‡被遺忘的儀式',
    nil,
    'Leve 8 Medalhões das Ondas para Geranis Matinalba na Terra Fantasma.‡Принесите 8 медальонов Волны Геранису Белому Рассвету в Призрачные земли.‡Bringt 8 Wellenfrontmedaillons zu Geranis Weißflor in den Geisterlanden.‡유령의 땅에 있는 제라니스 화이트몬에게 물결무늬 목걸이 8개를 가져가야 합니다.‡Lleva 8 medallones rompeolas a Geranis Albodía a las Tierras Fantasma.‡Lleva 8 medallones rompeolas a Geranis Albodía a las Tierras Fantasma.‡Apportez 8 Médaillons du front de mer à Geranis Blancmatin, dans les Terres fantômes.‡将8枚波浪勋章交给幽魂之地的格兰尼斯·月晨。‡帶8個浪鋒勳章給鬼魂之地的傑若尼斯·白晨。',
  }
},
[9158] = {
  {
    'Vetores da praga‡Разносчики заразы‡Überträger der Seuche‡역병을 보균한 동물들‡Transmisores de la peste‡Transmisores de la peste‡Les porteurs de la peste‡瘟疫的使者‡削弱瘟疫',
    nil,
    'Mate 10 Linces Garralma para a Andarilha Sedina no Enclave dos Andarilhos, que fica na Terra Fantasma.‡Странница Седайна из Анклава Странников в Призрачных землях хочет, чтобы вы убили 10 светлопалых рысей.‡Weltenwanderin Sedina in der Enklave der Weltenwanderer in den Geisterlanden möchte, dass Ihr 10 Geisterklauenluchse erschlagt.‡유령의 땅, 원정순찰대 초소에 있는 원정순찰대원 세디나가 유령발 스라소니 10마리를 해치워 달라고 했습니다.‡La errante Sedina del Enclave del Errante en las Tierras Fantasma quiere que mates 10 linces garrafantasma.‡La errante Sedina del Enclave del Errante en las Tierras Fantasma quiere que mates 10 linces garrafantasma.‡Le pérégrin Sedina, à l\'enclave des pérégrins des Terres fantômes, veut que vous tuiez 10 Lynx Griffes-fantômes.‡远行者营地的远行者塞蒂娜要求你杀死10只鬼爪山猫。‡鬼魂之地，旅行者營地的遠行者賽狄娜要你去殺10個鬼爪暗殺者。',
  }
},
[9159] = {
  {
    'Enfraquecendo a praga‡Обуздание заразы‡Gebietet der Seuche Einhalt‡역병 억제‡Control de plagas‡Control de plagas‡Circonscrire l\'épidémie‡控制瘟疫‡遏止瘟疫',
    nil,
    'Mate 8 Tocaieiras Fusaracna e 10 Brumorcegos Vampíricos para a Andarilha Sedina no Enclave dos Andarilhos, que fica na Terra Fantasma.‡Странница Седайна из анклава Странников, что в Призрачных землях, хочет, чтобы вы убили 8 воронковых пауков-прядильщиков и 10 мрачниц-вампиров.‡Weltenwanderin Sedina in der Enklave der Weltenwanderer in den Geisterlanden möchte, dass Ihr 8 Spindelweberlauerer und 10 Vampirnebelfledermäuse erschlagt.‡유령의 땅, 원정순찰대 초소에 있는 원정순찰대원 세디나가 흡혈 안개박쥐 10마리와 물레그물 늑대거미 8마리를 처치해 달라고 했습니다.‡La errante Sedina del Enclave del Errante en las Tierras Fantasma quiere que mates 8 rondadores husaraña y 10 murciélagos brumosos vampiros.‡La errante Sedina del Enclave del Errante en las Tierras Fantasma quiere que mates 8 rondadores husaraña y 10 murciélagos brumosos vampiros.‡Le pérégrin Sedina à l\'enclave des Pérégrins dans les Terres fantômes veut que vous tuiez 8 Rôdeuses filetoiles et 10 Brumoptères vampiriques.‡远行者营地的远行者塞蒂娜要求你杀死8只纺丝潜伏者和10只吸血迷雾蝠。‡鬼魂之地，旅行者營地的遠行者賽狄娜要你去殺死8隻細網潛伏者和10隻吸血迷霧蝙蝠。',
  }
},
[9160] = {
  {
    'Investigue An\'daroth‡Обследование Ан\'дарота‡Untersucht An\'daroth‡안다로스 조사‡Explorando An\'daroth‡Explorando An\'daroth‡Enquête à An\'daroth‡调查安达洛斯‡調查安都拉斯',
    nil,
    'Investigue a área de An\'daroth, mate 12 Espiãs Sentinelas e depois apresente-se à Dama Aurífera em Tranquillien, que fica na Terra Fantasma.‡Обследуйте район Ан\'дарота, убейте 12 часовых-шпионов и возвращайтесь к госпоже Златилен в Транквиллион, что в Призрачных землях.‡Untersucht das Gebiet um An\'daroth, tötet 12 Spione der Schildwache und kehrt anschließend zu Dame Auriferous in Tristessa in den Geisterlanden zurück.‡안다로스 지역을 조사하고 파수대 비밀요원 12명을 해치운 후 유령의 땅, 트랜퀼리엔에 있는 귀부인 아우리페러스에게 가야 합니다.‡Investiga la zona en An\'daroth, mata a 12 espías centinela y ve a ver a la Dama Aurífera a Tranquillien en las Tierras Fantasma.‡Investiga la zona en An\'daroth, mata a 12 espías centinela y ve a ver a la Dama Aurífera a Tranquillien en las Tierras Fantasma.‡Enquêter dans la région d\'An\'daroth, tuer 12 Espions des Sentinelles et retourner voir dame Auriférias à Tranquillien dans les Terres fantômes.‡调查安达洛斯一带，杀死12个哨兵部队间谍，然后向幽魂之地塔奎林的奥莉菲洛丝夫人复命。‡調查安都拉斯，殺死12名崗哨間諜再回到鬼魂之地的安寧地找阿莉法娜奧絲夫人。',
  }
},
[9161] = {
  {
    'A sombra do traidor‡Тень предателя‡Schatten des Verräters‡배신자의 그림자‡La sombra del traidor‡La sombra del traidor‡L\'ombre du traître‡叛徒之影‡背叛者的陰影',
    nil,
    'Vá para a Torre Aurestela na Terra Fantasma e procure pistas sobre o passado de Dar\'Khan.‡Отправляйтесь к башне Утренней Звезды в Призрачных землях и найдите любую информацию о прошлом Дар\'Хана.‡Begebt Euch in die Geisterlande zum Morgensternturm und sucht nach möglichen Hinweisen auf Dar\'Khans Vergangenheit.‡유령의 땅의 돈스타 첨탑에 가서 다르칸의 과거와 관련된 실마리를 찾아야 합니다.‡Ve a la Aguja de la Estrella del Alba en las Tierras Fantasma y busca pistas sobre el pasado de Dar\'Khan.‡Ve a la Aguja de la Estrella del Alba en las Tierras Fantasma y busca pistas sobre el pasado de Dar\'Khan.‡Allez à la Flèche d\'Aubétoile dans les Terres fantômes et cherchez des indices sur le passé de Dar\'Khan.‡前往幽魂之地的晨星之塔搜寻任何关于达尔坎的过去的线索。‡前往鬼魂之地的晨星尖塔並尋找任何與達克汗的過去有關的蛛絲馬跡。',
  }
},
[9162] = {
  {
    'Vestígios do passado‡Отблески былого‡Die Vergangenheit erwacht‡과거의 단서‡Huellas del pasado‡Huellas del pasado‡Vestiges du passé‡往日的线索‡過去的線索',
    nil,
    'Leve o Diário de Dar\'Khan para a Patrulheira Vynna no Enclave dos Andarilhos.‡Вернитесь к следопыту Винне в анклав Странников, что в Призрачных землях, и отдайте ей дневник Дар\'Хана.‡Kehrt mit Dar\'Khans Tagebuch zu Waldläuferin Vynna bei der Enklave der Weltenwanderer in den Geisterlanden zurück.‡다르칸의 일지를 가지고 원정순찰대 초소에 있는 순찰자 빈나에게 가야 합니다.‡Lleva el diario de Dar\'Khan a la forestal Vynna al Enclave del Errante.‡Lleva el diario de Dar\'Khan a la forestal Vynna al Enclave del Errante.‡Retournez voir le forestier Vynna à l\'Enclave des pérégrins avec le Journal de Dar\'Khan.‡将达尔坎的日记交给远行者营地的游侠维恩娜。‡帶著達克汗的日記回到旅行者營地找遊俠薇娜。',
  }
},
[9163] = {
  {
    'Em território ocupado‡Вылазка на оккупированную территорию‡In besetztem Gebiet‡적의 영토 안으로‡En territorio ocupado‡En territorio ocupado‡En territoire occupé‡深入敌境‡進入被佔據的土地',
    nil,
    'Roube o Plano Noctiélfico: An\'daroth, o Plano Noctiélfico: An\'owyn e o Plano Noctiélfico: Divinação dos Sin\'dorei e leve-os para Dama Aurífera em Tranquillien, que fica na Terra Fantasma.‡Выкрадите планы ночных эльфов относительно Ан\'дарота, Ан\'овина и магического наблюдения за син\'дорай, затем доставьте их госпоже Златилен в Транквиллион, что в Призрачных землях.‡Stehlt die Nachtelfenpläne: An\'daroth, Nachtelfenpläne: An\'owyn und Nachtelfenpläne: Auskundschaften der Sin\'dorei und kehrt anschließend in die Geisterlande zu Dame Auriferous in Tristessa zurück.‡나이트 엘프 계획서: 안다로스, 나이트 엘프 계획서: 안오윈 그리고 나이트 엘프 계획서: 신도레이의 상황 점치기를 탈취해서 유령의 땅의 트랜퀼리엔에 있는 귀부인 아우리페러스에게 가져가야 합니다.‡Roba los Planes de los elfos de la noche: An\'daroth, los Planes de los elfos de la noche: An\'owyn y los Planes de los elfos de la noche: Espiar a los sin\'dorei, y llévaselos a Dama Aurífera en Tranquillien en las Tierras Fantasma.‡Roba los Planes de los elfos de la noche: An\'daroth, los Planes de los elfos de la noche: An\'owyn y los Planes de los elfos de la noche: Espiar a los sin\'dorei, y llévaselos a Dama Aurífera en Tranquillien en las Tierras Fantasma.‡Volez les Plans des elfes de la nuit : An\'daroth, les Plans des elfes de la nuit : An\'owyn, et les Plans des elfes de la nuit : Divination contre les sin\'dorei, puis retournez voir Dame Auriférias à Tranquillien dans les Terres fantômes.‡窃取暗夜精灵计划表：安达洛斯、暗夜精灵计划表：安欧维恩和暗夜精灵计划表：监视辛多雷，然后向幽魂之地塔奎林的奥莉菲洛丝夫人复命。‡偷取夜精靈的計畫:安都拉斯、夜精靈的計畫:安歐恩和夜精靈的計畫:占卜辛多雷，然後帶回鬼魂之地交給安寧地的阿莉法娜奧絲夫人。',
  }
},
[9164] = {
  {
    'Prisioneiros da Cidadela da Morte‡Пленники Смертхольма‡Gefangene der Todesfestung‡데솔름의 포로들‡Cautivos en la Ciudad de la Muerte‡Cautivos en la Ciudad de la Muerte‡Prisonniers de Mortholme‡戴索姆的俘虏‡死亡之域俘虜',
    nil,
    'Leve o Trago Restaurador de Reinaldo até a Cidadela da Morte e resgate o Aprendiz Varnis, a Boticária Edite e o Patrulheiro Vedoran. Fale com a Arcanista Janeda no Sacrário Solar para receber sua recompensa.‡Возьмите приводящее в сознание зелье Рензитена с собой в Смертхольм и спасите ученика Варниса, аптекаря Инит и следопыта Ведорана. Возвращайтесь к чародейке Джанеде в святилище Солнца за наградой.‡Nehmt Renzithens Regenerationsgebräu und begebt Euch zur Todesfestung. Befreit dort Lehrling Varnis, Apothekerin Enith und Waldläufer Vedoran. Kehrt danach zu Arkanistin Janeda beim Sanktum der Sonne zurück, um Eure Belohnung zu erhalten.‡렌지센의 복원의 비약을 데솔름으로 가져가 수습생 바르니스, 연금술사 에니스, 순찰자 베도란을 구해야 합니다. 일을 마친 후 태양의 성소에 있는 비전술사 자네다에게 돌아가서 보상을 받으십시오.‡Lleva el jarabe vigorizante de Renzithen a la Ciudad de la Muerte y rescata al aprendiz Varnis, a la boticaria Enith y al forestal Vedoran. Ve a ver a la arcanista Janeda al Sagrario del Sol y recibirás una recompensa.‡Lleva el jarabe vigorizante de Renzithen a la Ciudad de la Muerte y rescata al aprendiz Varnis, a la boticaria Enith y al forestal Vedoran. Ve a ver a la arcanista Janeda al Sagrario del Sol y recibirás una recompensa.‡Apportez le Breuvage de restauration de Renzithen à Mortholme et venez au secours de l\'apprenti Varnis, de l\'apothicaire Enith et du forestier Vedoran. Puis retournez voir l\'arcaniste Janeda au sanctum du Soleil pour recevoir une récompense.‡前往塔奎林，从药剂师雷兹特恩那儿拿到雷兹特恩的疗伤药膏，然后前往戴索姆，救治学徒瓦尼斯、药剂师恩尼斯和游侠维多兰。完成任务之后返回太阳圣殿找奥术师亚尼达领取奖励。‡帶著倫澤紳製作的恢復藥劑前往死亡之域解救學徒瓦尼司，藥劑師艾尼斯和遊俠維多蘭。然後再回到太陽聖所向秘法師珍妮達領取獎勵。',
  }
},
[9165] = {
  {
    'Salvo-conduto‡Подорожная‡Verfügung des freien Geleits‡무사통과 확인서‡Libranza de salvoconducto‡Libranza de salvoconducto‡Le sauf-conduit‡通行文书‡安全之路令狀',
    nil,
    'Entregue o Salvo-conduto assinado para o Comandante de Expedição Metz na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Доставьте подписанную подорожную командиру Метцу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die unterschriebene Verfügung des freien Geleits zu Einsatzkommandant Metz an der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대, 희망의 빛 예배당에 있는 파견사령관 메츠에게 챔버스의 서명을 받은 무사통과 확인서를 가져가야 합니다.‡Entrega la libranza de salvoconducto firmado al comandante de envíos Metz que está en la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Entrega la libranza de salvoconducto firmado al comandante de envíos Metz que está en la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Apportez le Sauf-conduit signé au commandant d\'ordonnance Metz à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将签过字的通行文书交给东瘟疫之地圣光之愿礼拜堂的物资官员梅兹。‡將簽署的安全之路令狀送到東瘟疫之地給聖光之願禮拜堂的發送指揮官梅茲。',
  }
},
[9166] = {
  {
    'Entregue os planos para An\'telas‡Донесение в Ан\'телас‡Bringt die Pläne nach An\'telas‡안텔라스로 계획서 전달‡Entregando los planes a An\'telas‡Entregando los planes a An\'telas‡Livrer les plans à An\'telas‡返回安泰拉斯‡送計畫書到安泰拉斯',
    nil,
    'Entregue os Planos Noctiélficos para o Magíster Salystor em An\'telas, que fica na Terra Fantasma.‡Передайте планы ночных эльфов магистру Силастору из Ан\'теласа в Призрачных землях.‡Bringt die Nachtelfenpläne zu Magister Sylastor bei An\'telas in den Geisterlanden.‡유령의 땅의 안텔라스에 있는 마법학자 실라스터에게 나이트 엘프 계획서를 가져가야 합니다.‡Entrega los planes de los elfos de la noche al magister Sylastor en An\'telas en las Tierras Fantasma.‡Entrega los planes de los elfos de la noche al magister Sylastor en An\'telas en las Tierras Fantasma.‡Livrez les Plans des elfes de la nuit au magistère Sylastor à An\'telas, dans les Terres fantômes.‡将暗夜精灵计划表交给幽魂之地安泰拉斯的魔导师塞拉斯托。‡將夜精靈的計畫送到鬼魂之地給安泰拉斯的博學者塞拉斯特。',
  }
},
[9167] = {
  {
    'A destruição do traidor‡Гибель предателя‡Der Tod des Verräters‡배신자의 파멸‡La muerte del traidor‡La muerte del traidor‡La destruction du Traître‡叛徒的毁灭‡叛國者的毀滅',
    nil,
    'Mate Dar\'Khan Drathir na Cidadela da Morte e leve sua cabeça para o Magíster Idonis no Sacrário Solar, que fica na Terra Fantasma.‡Убейте Дар\'Хана Дратира в Смертхольме и принесите его голову магистру Кендрису в святилище Солнца в Призрачных землях.‡Begebt Euch in die Todesfestung und tötet Dar\'Khan Drathir. Bringt anschließend Dar\'Khans Kopf zu Magister Kaendris beim Sanktum der Sonne in den Geisterlanden.‡데솔름 안에 있는 다르칸 드라시르를 해치운 후 유령의 땅, 태양의 성소에 있는 마법학자 캔드리스에게 그 증거를 가져가야 합니다.‡Mata a Dar\'Khan Drathir en la Ciudad de la Muerte y lleva su cabeza al magister Kaendris al Sagrario del Sol en las Tierras Fantasma.‡Mata a Dar\'Khan Drathir en la Ciudad de la Muerte y lleva su cabeza al magister Kaendris al Sagrario del Sol en las Tierras Fantasma.‡Abattez Dar\'Khan Drathir à Mortholme et rapportez sa tête au magistère Kaendris, au sanctum du Soleil dans les Terres fantômes.‡进入戴索姆杀死达尔坎，将他的徽记交给幽魂之地太阳圣殿的魔导师坎迪瑞斯。‡殺死死亡之域的達克汗·崔希爾並把他的頭顱帶回鬼魂之地給太陽聖所的博學者坎德立斯。',
  }
},
[9168] = {
  {
    '‡Сердце Смертхольма‡Im Herzen der Todesfestung‡데솔름의 심장부‡El corazón de la Ciudad de la Muerte‡El corazón de la Ciudad de la Muerte‡Au cœur de Mortholme‡戴索姆之心‡',
    nil,
    '‡Уничтожьте 8 очей Дар\'Кхана и доложите об этом магистру Идонису из святилища Солнца в Призрачных землях.‡Zerstört 8 Augen von Dar\'Khan und meldet Euch anschließend bei Magister Idonis am Sanktum der Sonne in den Geisterlanden.‡‡Aniquila a 8 ojos de Dar\'Khan e informa al magister Idonis en el Sagrario del Sol en las Tierras Fantasma.‡Aniquila a 8 ojos de Dar\'Khan e informa al magister Idonis en el Sagrario del Sol en las Tierras Fantasma.‡Détruisez 8 Yeux de Dar\'Khan et rendez compte au magistère Idonis, au Sanctum du Soleil dans les Terres fantômes.‡‡',
  }
},
[9169] = {
  {
    'Desative An\'owyn‡Ан\'овин: отключение‡Die Abschaltung von An\'owyn‡달의 수정 작동 해제‡Desactivando An\'owyn‡Desactivando An\'owyn‡Désactiver An\'owyn‡关闭安欧维恩‡關閉安歐恩水晶',
    nil,
    'Recupere o Orbe Controlador do Cristal e use-o para desativar o Cristal da Lua Noctiélfico em An\'owyn. Depois, apresente-se ao Magíster Salystor em An\'telas, que fica na Terra Fantasma.‡Добудьте сферу управления кристаллом и с ее помощью отключите лунный кристалл ночных эльфов в Ан\'овине. Затем возвращайтесь к магистру Силастору в Ан\'телас в Призрачных землях.‡Beschafft die Kristallkontrollkugel und benutzt sie, um die nachtelfischen Mondkristalle bei An\'owyn zu deaktivieren. Kehrt anschließend zu Magister Sylastor in An\'telas in den Geisterlanden zurück.‡수정 제어 구슬을 찾은 다음 안오윈에 있는 나이트 엘프 달의 수정에 사용하여 작동을 해제해야 합니다. 그런 다음 유령의 땅, 안텔라스에 있는 마법학자 실라스터에게 가야 합니다.‡Recupera el orbe de control y úsalo para desactivar el cristal lunar de los elfos de la noche en An\'owyn. Después ve a ver al magister Sylastor a An\'telas en las Tierras Fantasma.‡Recupera el orbe de control y úsalo para desactivar el cristal lunar de los elfos de la noche en An\'owyn. Después ve a ver al magister Sylastor a An\'telas en las Tierras Fantasma.‡Récupérez l\'Orbe de contrôle du cristal et utilisez-la pour désactiver le Cristal de lune des elfes de la nuit à An\'owyn. Retournez ensuite auprès du magistère Sylastor à An\'telas, dans les Terres fantômes.‡获取水晶控制宝珠，用它关闭安欧维恩的暗夜精灵月亮水晶，然后向幽魂之地安泰拉斯的魔导师塞拉斯托复命。‡取得水晶控制寶珠並使用它關閉安歐恩的夜精靈月水晶。再回到鬼魂之地的安泰拉斯找博學者塞拉斯特。',
  }
},
[9170] = {
  {
    'Os tenentes de Dar\'Khan‡Приспешники Дар\'Хана‡Dar\'Khans Gefolgschaft‡다르칸의 부관들‡Los tenientes de Dar\'Khan‡Los tenientes de Dar\'Khan‡Les lieutenants de Dar\'Khan‡达尔坎的军官‡達克汗的中尉',
    nil,
    'O Magíster Idonis quer que você vá para a Cidadela da Morte e mate Masophet, o Negro, Juron, o Enganador, Borgoth, o Dessangrador e Mirdoran, o Caído. Apresente-se a ele no Sacrário Solar, que fica na Terra Fantasma, quando completar a missão.‡Магистр Идонис хочет, чтобы вы отправились в Смертхольм и сразили Масофета Черного, Джуриона Обманщика, Боргота Кровопускателя и Мирдорана Мерзостного. Выполнив поручение, отчитайтесь перед магистром Идонисом в святилище Солнца Призрачных земель.‡Magister Idonis möchte, dass Ihr Euch zur Todesfestung begebt und Masophet den Schwarzen, Jurion den Betrüger, Borgoth den Blutvergießer und Mirdoran den Gefallenen tötet. Kehrt nach Abschluss Eurer Aufgabe zum Sanktum der Sonne in den Geisterlanden zurück und berichtet ihm.‡마법학자 이도니스가 데솔름으로 가서 타락의 미르도란, 피를 부르는 보르고스, 책략가 주리온, 암흑의 마조피트를 해치워 달라고 했습니다. 임무를 마치면 유령의 땅으로 돌아가서 태양의 성소에 있는 이도니스에게 보고해야 합니다.‡El magister Idonis quiere que vayas a la Ciudad de la Muerte para matar a Masophet el Negro, Jurion el Falsario, Borgoth el Flebotomista y Mirdoran el Caído. Cuando hayas terminado, vuelve a verle en el Sagrario del Sol en las Tierras Fantasma.‡El magister Idonis quiere que vayas a la Ciudad de la Muerte para matar a Masophet el Negro, Jurion el Falsario, Borgoth el Flebotomista y Mirdoran el Caído. Cuando hayas terminado, vuelve a verle en el Sagrario del Sol en las Tierras Fantasma.‡Le magistère Idonis veut que vous alliez à Mortholme pour tuer Masophet le Noir, Jurion le Menteur, Borgoth le Saigneur et Mirdoran le Déchu. Allez ensuite lui rendre compte du succès de votre mission au sanctum du Soleil, dans les Terres fantômes.‡魔导师伊东尼斯要你前往戴索姆杀死黑衣玛索菲特、欺诈者尤瑞恩、放血者鲍尔古斯和堕落者米尔杜兰，完成任务后回到幽魂之地的太阳圣殿向他复命。‡博學者艾度尼斯要你到死亡之域冒險，殺掉黑衣瑪蘇霏爾、『欺詐者』裘萊恩、『放血者』伯格斯和『墮落者』米爾多藍。任務完成之後到鬼魂之地的太陽聖所向他報告。',
  }
},
[9171] = {
  {
    'Comida crocante‡Хрустящий деликатес‡Knusperkost‡오독오독 씹히는 요리‡Texturas crujientes‡Texturas crujientes‡Il faut que ça croustille !‡松脆蜘蛛腿‡香脆料理',
    nil,
    'Colete 5 Pernas Crocantes de Aranha e entregue-as para o Mestre Chef Mouldier em Tranquillien, que fica na Terra Fantasma.‡Добудьте 5 хрустящих паучьих лапок и принесите их главному шеф-повару Плеснеру в Транквиллион, что в Призрачных землях.‡Sammelt 5 knusprige Spinnenbeine ein und kehrt zu Meisterkoch Mouldier in Tristessa in den Geisterlanden zurück.‡단단한 거미 다리 5개를 모아서 유령의 땅, 트랜퀼리엔에 있는 수석요리사 마울디어에게 가져가야 합니다.‡Lleva 5 patas de araña crujientes al maestro cocinero Mouldier a Tranquillien en las Tierras Fantasma.‡Lleva 5 patas de araña crujientes al maestro cocinero Mouldier a Tranquillien en las Tierras Fantasma.‡Collectez 5 Pattes d\'araignée croustillantes et ramenez-les au maître cuisinier Mouldier à Tranquillien dans les Terres fantômes.‡将5条松脆蜘蛛腿交给幽魂之地塔奎林的大厨师莫迪尔。‡收集5隻香脆蜘蛛腿帶回鬼魂之地給安寧地的大廚師瑪戴爾。',
  }
},
[9172] = {
  {
    'Apresente-se ao magíster Kaendris‡Доклад магистру Кендрису‡Bericht an Magister Kaendris‡마법학자 캔드리스에게 보고‡Informa al magister Kaendris‡Informa al magister Kaendris‡Un rapport pour le magistère Kaendris‡向魔导师坎迪瑞斯报到‡向博學者坎德立斯回報',
    nil,
    'Leve o Diário de Dar\'Khan para o Magíster Idonis no Sacrário Solar, que fica na Terra Fantasma.‡Принесите дневник Дар\'Хана магистру Кендрису в святилище Солнца, что в Призрачных землях.‡Bringt Dar\'Khans Tagebuch zu Magister Kaendris beim Sanktum der Sonne in den Geisterlanden.‡유령의 땅, 태양의 성소에 있는 마법학자 캔드리스에게 다르칸의 일지를 가져가야 합니다.‡Lleva el diario de Dar\'Khan al magister Kaendris al Sagrario del Sol en las Tierras Fantasma.‡Lleva el diario de Dar\'Khan al magister Kaendris al Sagrario del Sol en las Tierras Fantasma.‡Remettre le Journal de Dar\'Khan au magistère Kaendris au sanctum du Soleil, dans les Terres fantômes.‡将达尔坎的日记交给幽魂之地太阳圣殿的魔导师坎迪瑞斯。‡將達克汗的日記帶回鬼魂之地交給太陽聖所的博學者坎德立斯。',
  }
},
[9173] = {
  {
    'Reconquistando o Pico dos Correventos‡Захват шпилей Ветрокрылых‡Rückeroberung des Windläuferturms‡윈드러너 첨탑 탈환‡Recuperar Aguja Brisaveloz‡Recuperar Aguja Brisaveloz‡Reprendre la flèche de Coursevent‡夺回风行者之塔‡奪回風行者塔',
    nil,
    'Mate 8 Acólitos da Cidadela da Morte e 10 Patrulheiras Decaídas e depois fale novamente com o Alto-executor Malta em Tranquillien, que fica na Terra Fantasma.‡Убейте 8 послушников из Смертхольма и 10 павших следопытов, затем возвращайтесь к верховному вершителю Маврену в Транквиллион, что в Призрачных землях.‡Besiegt 8 Akolythen der Todesfestung und 10 gefallene Waldläufer, dann kehrt zu Hochexekutor Mavren nach Tristessa in den Geisterlanden zurück.‡데솔름 수행사제 8명과 떠도는 순찰자 영혼 10명을 해치운 후 유령의 땅, 트랜퀼리엔에 있는 고위집행관 마브렌에게 가야 합니다.‡Mata a 8 acólitos de la Ciudad de la Muerte y a 10 forestales caídas y ve a ver al sumo ejecutor Mavren a Tranquillien en las Tierras Fantasma.‡Mata a 8 acólitos de la Ciudad de la Muerte y a 10 forestales caídas y ve a ver al sumo ejecutor Mavren a Tranquillien en las Tierras Fantasma.‡Tuez 8 Acolytes de Mortholme et 10 Forestiers déchus, puis retournez voir le Grand exécuteur Mavren à Tranquillien, dans les Terres fantômes.‡杀死8个戴索姆侍僧和8个堕落游侠，然后向塔奎林的高级执行官玛尔伦复命。‡殺死8名死亡之域侍僧和10名遊俠靈魂，再回到鬼魂之地的安寧地找高階執行官瑪弗倫。',
  }
},
[9174] = {
  {
    'Derrote Aquantion‡Победа над Аквантионом‡Aquantion bezwingen‡아쿠안티온 처치‡Derrotar a Aquantion‡Derrotar a Aquantion‡Vaincre Aquantion‡消灭阿奎艾森‡消滅海之平衡',
    nil,
    'Geranis Matinalba quer que você nade até o fundo do lago que fica a leste da Vila Corona Solar e use o Feixe de Medalhões no Altar da Maestria das Ondas. Evoque e destrua o elemental conhecido como Aquantion e fale novamente com Geranis.‡Геранис Белый Рассвет хочет, чтобы вы нырнули на дно озера к востоку от деревни Солнечной Короны и возложили связку медальонов на алтарь укрощения волн. Призовите и сразите элементаля по имени Аквантион, затем возвращайтесь к Геранису.‡Geranis Weißflor möchte, dass Ihr auf den Grund des Sees östlich von Sonnenkuppe taucht und das Bündel mit Medaillons auf den Altar der Gezeitenbeherrschung legt. Beschwört und besiegt den Elementar Aquantion und kehrt zu Geranis zurück.‡제라니스 화이트문이 태양왕관 마을 동쪽의 호수 바닥으로 잠수하여 해일의 깨달음 제단에 목걸이 묶음을 사용해 달라고 했습니다. 아쿠안티온이라는 정령을 소환하여 해치운 다음 제라니스 화이트몬에게 가야 합니다.‡Geranis Albodía quiere que nades hasta el fondo del lago al este de la Aldea Corona del Sol y uses los medallones ante el Altar del Dominio de las Mareas. Invoca al elemental llamado Aquantion, ejecútalo y regresa junto a Geranis.‡Geranis Albodía quiere que nades hasta el fondo del lago al este de la Aldea Corona del Sol y uses los medallones ante el Altar del Dominio de las Mareas. Invoca al elemental llamado Aquantion, ejecútalo y regresa junto a Geranis.‡Geranis Blancmatin veut que vous nagiez au fond du lac à l\'est de Solcouronne et que vous utilisiez le Paquet de médaillons sur l\'Autel de la maîtrise des flots. Invoquez et détruisez l\'élémentaire appelé Aquantion, puis retournez voir Geranis.‡格兰尼斯·月晨要你潜入日冕村东面的湖底，对海潮掌控祭坛使用你手中的一堆勋章。杀死你召唤出的元素生物阿奎艾森，然后向格兰尼斯复命。‡傑若尼斯·白晨要你游到日冠村東邊的湖底並在潮汐專精祭壇使用一堆勳章。召喚並殺死一個叫海之平衡的元素再回到傑若尼斯那裡。',
  }
},
[9175] = {
  {
    'O colar da Dama Sombria‡Ожерелье Госпожи‡Die Halskette der Fürstin‡여군주의 목걸이‡El collar de Sylvanas‡El collar de Sylvanas‡Le collier de la Dame‡女王的项链‡女士的項鍊',
    nil,
    'Leve o Colar da Dama Sombria ao Alto-executor Malta em Tranquillien, que fica na Terra Fantasma.‡Отнесите ожерелье госпожи верховному вершителю Маврену в Транквиллион, что в Призрачных землях.‡Bringt die Halskette der Fürstin zu Hochexekutor Mavren nach Tristessa in den Geisterlanden.‡유령의 땅, 트랜퀼리엔에 있는 고위집행관 마브렌에게 여군주의 목걸이를 가져가야 합니다.‡Llévale el collar de Sylvanas al sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Llévale el collar de Sylvanas al sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Apportez le Collier de la Dame au Grand exécuteur Mavren à Tranquillien dans les Terres fantômes.‡将女王的项链交给幽魂之地塔奎林的高级执行官玛尔伦。‡將女士的項鍊帶到鬼魂之地給安寧地的高階執行官瑪弗倫。',
  }
},
[9176] = {
  {
    'Os zigurates gêmeos‡Зиккураты-близнецы‡Die Zwillingsziggurats‡두 개의 지구라트‡Los zigurats gemelos‡Los zigurats gemelos‡Les ziggourats jumelles‡通灵双塔‡雙子通靈塔',
    nil,
    'Siga para o Zigurate Sangrento e para o Zigurate Uivante. Recupere a Pedra de Luz e a Pedra de Chamas. Fale novamente com o Magíster Kaendris no Sacrário Solar quando recuperar os itens.‡Отправьтесь к Кровоточащему зиккурату и Воющему зиккурату и добудьте оттуда камень света и камень пламени. После этого возвращайтесь к магистру Кендрису в святилище Солнца.‡Reist zur Blutenden und zur Heulenden Ziggurat und bergt den Stein des Lichts und den Stein der Flamme. Kehrt anschließend zu Magister Kaendris beim Sanktum der Sonne in den Geisterlanden zurück.‡피투성이 지구라트와 울부짖는 지구라트로 가서 불꽃의 돌과 빛의 돌을 되찾은 후 태양의 성소에 있는 마법학자 캔드리스에게 가야 합니다.‡Dirígete al Zigurat Sangrante y al Zigurat Aullante y recupera la piedra de luz y la piedra de llama. Regresa junto al magister Kaendris en el Sagrario del Sol tras recuperar los objetos.‡Dirígete al Zigurat Sangrante y al Zigurat Aullante y recupera la piedra de luz y la piedra de llama. Regresa junto al magister Kaendris en el Sagrario del Sol tras recuperar los objetos.‡Rendez-vous à la Ziggourat sanguinolente et à la Ziggourat hurlante et retrouvez la Pierre de lumière et la Pierre de flammes. Retournez voir le magistère Kaendris au Sanctum du Soleil après avoir récupéré les objets.‡前往鲜血通灵塔和鬼嚎通灵塔寻找光芒之石和烈焰之石，然后向太阳圣殿的魔导师坎迪瑞斯复命。‡前往哀嚎通靈塔和血色通靈塔取回聖光之石與火焰之石。取得物品後回到太陽聖所找博學者坎德立斯。',
  }
},
[9177] = {
  {
    'Jornada para a Cidade Baixa‡Путь в Подгород‡Reise nach Unterstadt‡언더시티 여행‡Viaje a Entrañas‡Viaje a Entrañas‡En route pour Fossoyeuse‡幽暗城之旅‡幽暗城之旅',
    nil,
    'Entregue o Colar da Dama Sombria para a Grande Dama Sylvana Correventos no Distrito Real da Cidade Baixa.‡Отнесите Леди Сильване Ветрокрылой ожерелье Госпожи в Королевский Квартал Подгорода.‡Bringt die Halskette der Fürstin zu Fürstin Sylvanas Windläufer im Königsviertel von Unterstadt.‡언더시티의 왕실에 있는 여군주 실바나스 윈드러너에게 여군주의 목걸이를 가져가야 합니다.‡Ve al Barrio Real, en Entrañas, y entrégale el collar de Sylvanas a Lady Sylvanas Brisaveloz.‡Ve al Barrio Real, en Entrañas, y entrégale el collar de Sylvanas a Lady Sylvanas Brisaveloz.‡Apportez le Collier de la Dame à dame Sylvanas Coursevent dans le Quartier royal de Fossoyeuse.‡将女王的项链交给幽暗城皇家区的希尔瓦娜斯·风行者。‡將女士的項鍊帶給幽暗城皇家區的希瓦娜斯·風行者。',
  }
},
[9178] = {
  {
    '‡Задание мастера: массивное грузило‡Handwerksverfügung - Verdichteter Gewichtsstein‡장인의 계약서: 강도 높은 무게추‡Libranza del artesano: contrapeso denso‡Libranza del artesano: contrapeso denso‡Commission d\'artisan - Pierre de lest denses‡工匠文书 - 致密平衡石‡工匠令狀 - 緻密平衡石',
    nil,
    '‡Доставьте 120 массивных грузил и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 120 verdichtete Gewichtssteine und die Handwerksverfügung für die verdichteten Gewichtssteine zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 120 contrapesos densos y la libranza del artesano: contrapeso denso al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 120 contrapesos densos y la libranza del artesano: contrapeso denso al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 120 Pierres de lest denses et la Commission d\'artisan - Pierres denses au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将120个致密平衡石和工匠文书 - 致密平衡石交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9179] = {
  {
    '‡Задание мастера: имперское зерцало‡Handwerksverfügung - Imperiale Plattenrüstung‡장인의 계약서: 황제의 판금 흉갑‡Libranza del artesano: peto de placas imperiales‡Libranza del artesano: peto de placas imperiales‡Commission d\'artisan - Pansières impériales‡工匠文书 - 君王板甲‡工匠令狀 - 帝國鎧甲護胸',
    nil,
    '‡Доставьте 3 имперских зерцала и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 3 imperiale Plattenrüstungen und die Handwerksverfügung für die imperialen Plattenrüstungen zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 3 petos de placas imperiales y la libranza del artesano: peto de placas imperiales al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 3 petos de placas imperiales y la libranza del artesano: peto de placas imperiales al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 3 Pansières impériales et la Commission d\'artisan - Pansières impériales au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将3个君王板甲护胸和工匠文书 - 君王板甲护胸交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9180] = {
  {
    'Jornada para a Cidade Baixa‡Путь в Подгород‡Reise nach Unterstadt‡언더시티 여행‡Viaje a Entrañas‡Viaje a Entrañas‡En route pour Fossoyeuse‡幽暗城之旅‡幽暗城之旅',
    nil,
    'Entregue o Colar da Dama Sombria para a Grande Dama Sylvana Correventos no Distrito Real da Cidade Baixa.‡Отнесите Леди Сильване Ветрокрылой ожерелье Госпожи в Королевский Квартал Подгорода.‡Bringt die Halskette der Fürstin zu Fürstin Sylvanas Windläufer im Königsviertel von Unterstadt.‡언더시티의 왕실에 있는 여군주 실바나스 윈드러너에게 여군주의 목걸이를 가져가야 합니다.‡Ve al Barrio Real, en Entrañas, y entrégale el collar de Sylvanas a Lady Sylvanas Brisaveloz.‡Ve al Barrio Real, en Entrañas, y entrégale el collar de Sylvanas a Lady Sylvanas Brisaveloz.‡Apportez le Collier de la Dame à dame Sylvanas Coursevent dans le Quartier Royal de Fossoyeuse.‡将女王的项链交给幽暗城皇家区的希尔瓦娜斯·风行者。‡將女士的項鍊帶給幽暗城皇家區的希瓦娜斯·風行者。',
  }
},
[9181] = {
  {
    '‡Задание мастера: вулканический молот‡Handwerksverfügung - Vulkanischer Hammer‡장인의 계약서: 화산 망치‡Libranza del artesano: martillo volcánico‡Libranza del artesano: martillo volcánico‡Commission d\'artisan - Marteaux volcaniques‡工匠文书 - 火山战锤‡工匠令狀 - 火山戰錘',
    nil,
    '‡Доставьте 3 вулканических молота и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 3 vulkanische Hämmer und die Handwerksverfügung für die vulkanischen Hämmer zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 3 martillos volcánicos y la libranza del artesano: martillo volcánico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 3 martillos volcánicos y la libranza del artesano: martillo volcánico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 3 Marteaux volcaniques et la Commission d\'artisan - Marteaux volcaniques au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将3把火山战锤和工匠文书 - 火山战锤交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡',
  }
},
[9182] = {
  {
    '‡Задание мастера: большой ториевый боевой топор‡Handwerksverfügung - Gewaltige Thoriumstreitaxt‡장인의 계약서: 거대한 토륨 전투도끼‡Libranza del artesano: hacha de batalla de torio enorme‡Libranza del artesano: hacha de batalla de torio enorme‡Commission d\'artisan - Hache d\'armes énorme en thorium‡工匠文书 - 巨型瑟银战斧‡工匠令狀 - 巨型瑟銀戰鬥斧',
    nil,
    '‡Доставьте 3 огромных ториевых боевых топора и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 3 gewaltige Thoriumstreitäxte und die Handwerksverfügung für die gewaltigen Thoriumstreitäxte zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 3 hachas de batalla de torio enormes y la libranza del artesano: hacha de batalla de torio enorme al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 3 hachas de batalla de torio enormes y la libranza del artesano: hacha de batalla de torio enorme al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 3 Haches d\'armes énormes en thorium et la Commission d\'artisan - Haches d\'armes énormes en thorium au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将3把巨型瑟银战斧和工匠文书 - 巨型瑟银战斧交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9183] = {
  {
    '‡Задание мастера: Светозарный венец‡Handwerksverfügung - Strahlender Reif‡장인의 계약서: 찬란하게 빛나는 머리장식‡Libranza del artesano: aro radiante‡Libranza del artesano: aro radiante‡Commission d\'artisan - Diadèmes radieux‡工匠文书 - 辐光头饰‡工匠令狀 - 輻光頭環',
    nil,
    '‡Доставьте 3 светозарных венца и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 3 strahlende Reifen und die Handwerksverfügung für die strahlenden Reifen zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 3 aros radiantes y la libranza del artesano: aro radiante al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 3 aros radiantes y la libranza del artesano: aro radiante al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 3 Diadèmes radieux et la Commission d\'artisan - Diadèmes radieux au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将3个辐光头饰和工匠文书 - 辐光头饰交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9184] = {
  {
    '‡Задание мастера: Гибельная кожаная повязка‡Handwerksverfügung - Tückisches Lederstirnband‡장인의 계약서: 악의의 가죽 머리띠‡Libranza del artesano: cinta de cuero maligno‡Libranza del artesano: cinta de cuero maligno‡Commission d\'artisan - Bandeaux corrompus en cuir‡工匠文书 - 邪恶皮甲头环‡工匠令狀 - 邪惡皮甲頭帶',
    nil,
    '‡Доставьте 10 гибельных кожаных головных повязок и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 10 tückische Lederstirnbänder und die Handwerksverfügung für die tückischen Lederstirnbänder zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 10 cintas de cuero maligno y la libranza del artesano: cinta de cuero maligno al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Entrega 10 cintas de cuero maligno y la libranza del artesano: cinta de cuero maligno al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Livrer 10 Bandeaux corrompus en cuir et la Commission d\'artisan - Bandeaux corrompus en cuir au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将10个邪恶皮甲头环和工匠文书 - 邪恶皮甲头环交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9185] = {
  {
    '‡Задание мастера: накладки из грубой кожи‡Handwerksverfügung - Unverwüstliches Rüstungsset‡장인의 계약서: 튼튼한 방어구 강화도구‡Libranza del artesano: refuerzo para armadura basto‡Libranza del artesano: refuerzo para armadura basto‡Commission d\'artisan - Renforts d\'armure robustes‡工匠文书 - 毛皮护甲片‡工匠令狀 - 毛皮護甲片',
    nil,
    '‡Доставьте 25 комплектов накладок из грубой кожи и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 25 unverwüstliche Rüstungssets und die Handwerksverfügung für die unverwüstlichen Rüstungssets zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 25 refuerzos para armadura bastos y la libranza del artesano: refuerzo para armadura basto al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Entrega 25 refuerzos para armadura bastos y la libranza del artesano: refuerzo para armadura basto al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Livrer 25 Renforts d\'armure robustes et la Commission d\'artisan - Renforts d\'armure robustes au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将25个毛皮护甲片和工匠文书 - 毛皮护甲片交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9186] = {
  {
    '‡Задание мастера: Гибельный кожаный пояс‡Handwerksverfügung - Tückischer Ledergürtel‡장인의 계약서: 악의의 가죽 허리띠‡Libranza del artesano: cinturón de cuero maligno‡Libranza del artesano: cinturón de cuero maligno‡Commission d\'artisan - Ceintures corrompues en cuir‡工匠文书 - 邪恶皮甲腰带‡工匠令狀 - 邪惡皮甲腰帶',
    nil,
    '‡Доставьте 9 гибельных кожаных поясов и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 9 tückische Ledergürtel und die Handwerksverfügung für die tückischen Ledergürtel zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 9 cinturones de cuero maligno y la libranza del artesano: cinturón de cuero maligno al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 9 cinturones de cuero maligno y la libranza del artesano: cinturón de cuero maligno al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 9 Ceintures corrompues en cuir et la Commission d\'artisan - Ceintures corrompues en cuir au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将9条邪恶皮甲腰带和工匠文书 - 邪恶皮甲腰带交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9187] = {
  {
    '‡Задание мастера: рунические кожание штаны‡Handwerksverfügung - Runenverzierte Lederhose‡장인의 계약서: 룬문자 가죽 바지‡Libranza del artesano: pantalones de cuero rúnico‡Libranza del artesano: pantalones de cuero rúnico‡Commission d\'artisan - Pantalons runiques en cuir‡工匠文书 - 符文皮甲短裤‡工匠令狀 - 符刻皮甲束褲',
    nil,
    '‡Доставьте 4 пары рунических кожаных штанов и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 4 runenverzierte Lederhosen und die Handwerksverfügung für die runenverzierten Lederhosen zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 4 pantalones de cuero rúnico y la libranza del artesano: pantalones de cuero rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 4 pantalones de cuero rúnico y la libranza del artesano: pantalones de cuero rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 4 Pantalons runiques en cuir et la Commission d\'artisan - Pantalons runiques en cuir au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将4件符文皮甲短裤和工匠令状 - 符文皮甲短裤 - 带到东瘟疫之地给圣光之愿礼拜堂的军需筹备官·石汉 。‡',
  }
},
[9188] = {
  {
    '‡Задание мастера: штаны из яркой ткани‡Handwerksverfügung - Hellstoffhose‡장인의 계약서: 빛매듭 바지‡Libranza del artesano: pantalones de paño brillante‡Libranza del artesano: pantalones de paño brillante‡Commission d\'artisan - Pantalons en étoffe lumineuse‡工匠文书 - 亮布短裤‡工匠令狀 - 亮布束褲',
    nil,
    '‡Доставьте 6 пар штаны из яркой ткани и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 6 Hellstoffhosen und die Handwerksverfügung für die Hellstoffhosen zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 6 pantalones de paño brillante y la libranza del artesano: pantalones de paño brillante al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 6 pantalones de paño brillante y la libranza del artesano: pantalones de paño brillante al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 6 Pantalons en étoffe lumineuse et la Commission d\'artisan - Pantalons en étoffe lumineuse au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将6条亮布短裤和工匠文书 - 亮布短裤交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡',
  }
},
[9189] = {
  {
    'Entrega no Sepulcro‡Посылка в Гробницу‡Lieferung an das Grabmal‡공동묘지로 배달‡Entrega a El Sepulcro‡Entrega a El Sepulcro‡Une livraison au Sépulcre‡送往瑟伯切尔的信‡送貨到瑟伯切爾',
    nil,
    'Entregue as Ordens Seladas dos Sin\'dorei ao Conselheiro Amariyon no Sepulcro, que fica na Floresta de Pinhaprata.‡Отнесите запечатанные приказы син\'дорай советнику Соррелону в Гробницу в Серебряном бору.‡Bringt die versiegelten Befehle der Sin\'dorei zu Berater Sorrelon beim Grabmal in Silberwald.‡은빛소나무 숲의 공동묘지에 있는 조언자 소렐론에게 봉인된 신도레이 명령서를 가져가야 합니다.‡Entrega las órdenes sin\'dorei selladas al consejero Sorrelon en El Sepulcro en el Bosque de Argénteos.‡Entrega las órdenes sin\'dorei selladas al consejero Sorrelon en El Sepulcro en el Bosque de Argénteos.‡Apporter les Ordres sin\'dorei scellés au conseiller Sorrelon au Sépulcre dans la forêt des Pins-Argentés.‡将密封的辛多雷命令交给银松森林瑟伯切尔的顾问索雷伦。‡將密封的辛多雷命令送到銀松森林的瑟伯切爾給諫言者索利安。',
  }
},
[9190] = {
  {
    '‡Задание мастера: сапоги из рунической ткани‡Handwerksverfügung - Runenstoffstiefel‡장인의 계약서: 룬무늬 장화‡Libranza del artesano: botas de paño rúnico‡Libranza del artesano: botas de paño rúnico‡Commission d\'artisan - Bottes en étoffe runique‡工匠文书 - 符文布靴‡工匠令狀 - 符文布靴',
    nil,
    '‡Доставьте 8 пар сапог из рунической ткани и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 8 Runenstoffstiefel und die Handwerksverfügung für die Runenstoffstiefel zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 8 botas de paño rúnico y la libranza del artesano: botas de paño rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 8 botas de paño rúnico y la libranza del artesano: botas de paño rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 8 Bottes en étoffe runique et la Commission d\'artisan - Bottes en étoffe runique au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将8双符文布靴和工匠文书 - 符文布靴交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9191] = {
  {
    '‡Задание мастера: мешок из рунической ткани‡Handwerksverfügung - Runenstofftasche‡장인의 계약서: 룬무늬 가방‡Libranza del artesano: bolsa de paño rúnico‡Libranza del artesano: bolsa de paño rúnico‡Commission d\'artisan - Sacs en étoffe runique‡工匠文书 - 符文布包‡工匠令狀 - 符文布背包',
    nil,
    '‡Доставьте 8 сумок из рунической ткани и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 8 Runenstofftaschen und die Handwerksverfügung für die Runenstofftaschen zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 8 bolsas de paño rúnico y la libranza del artesano: bolsa de paño rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 8 bolsas de paño rúnico y la libranza del artesano: bolsa de paño rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 8 Sacs en étoffe runique et la Commission d\'artisan - Sacs en étoffe runique au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将8个符文布背包和工匠文书 - 符文布背包交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9192] = {
  {
    'Encrenca nas Minas Telúminas‡Беда в Беспросветных рудниках‡Ärger in den Grubenlichtminen‡미명 광산의 소동‡Problemas en las Minas Sondaluz‡Problemas en las Minas Sondaluz‡Des problèmes aux mines de Terradiance‡幽光矿洞的麻烦‡光底礦坑的麻煩',
    nil,
    'Mate 8 Gnolls Patanegra, 6 Carniceiros Patanegra e 4 Xamãs Patanegra. Depois fale novamente com o Sicário Maltendis em Tranquillien, que fica na Terra Fantasma.‡Убейте 8 гноллов-чернолапов, 6 падальщиков-чернолапов и 4 шаманов-чернолапов и возвращайтесь к ловчему смерти Малтендису в Транквиллион, что в Призрачных землях.‡Tötet 8 Gnolle der Schwarzpfoten, 6 Strauchdiebe der Schwarzpfoten und 4 Schamanen der Schwarzpfoten. Kehrt anschließend zu Todespirscher Maltendis in Tristessa in den Geisterlanden zurück.‡검은발 놀 8마리, 검은발 청소부 6마리, 검은발 주술사 4마리를 처치하고 유령의 땅, 트랜퀼리엔에 있는 죽음추적자 말텐디스에게 가야 합니다.‡Mata a 8 gnolls Patanegra, 6 carroñeros Patanegra y 4 chamanes Patanegra, y regresa junto al mortacechador Maltendis en Tranquillien, en las Tierras Fantasma.‡Mata a 8 gnolls Patanegra, 6 carroñeros Patanegra y 4 chamanes Patanegra, y regresa junto al mortacechador Maltendis en Tranquillien, en las Tierras Fantasma.‡Tuez 8 Gnolls pattenoires, 6 Charognards pattenoires et 4 Chamans pattenoires, puis retournez voir le nécrotraqueur Maltendis à Tranquillien dans les Terres fantômes.‡杀死8个黑爪豺狼人、6个黑爪食腐者和4个黑爪萨满祭司，然后向幽魂之地塔奎林的亡灵哨兵玛尔特迪斯复命。‡殺死8個黑掌豺狼人，6個黑掌覓食者和4個黑掌薩滿，再回到鬼魂之地的安寧地找亡靈哨兵瑪塔堤斯。',
  }
},
[9193] = {
  {
    'Investigue as catacumbas Amani‡Обследование катакомб Амани‡Untersucht die Amanikatakomben‡아마니 지하묘지 조사‡Investiga las Catacumbas Amani‡Investiga las Catacumbas Amani‡Enquête dans les catacombes des Amani‡调查阿曼尼墓穴‡調查阿曼尼地下墓穴',
    nil,
    'Investigue as Catacumbas Amani e queime 10 Cadáveres Mumificados de Troll. Depois fale novamente com a Conselheira Valwyn em Tranquillien, na Terra Fantasma.‡Обследуйте катакомбы Амани и сожгите 10 иссохших останков троллей, затем возвращайтесь к советнице Вальвин в Транквиллион в Призрачных землях.‡Untersucht die Amanikatakomben und verbrennt 10 mumifizierte Trollüberreste. Kehrt anschließend zu Beraterin Valwyn in Tristessa in den Geisterlanden zurück.‡아마니 지하묘지를 조사하여 미라가 된 트롤 시신 10구를 불태운 후 유령의 땅, 트랜퀼리엔에 있는 조언자 발윈에게 가야 합니다.‡Investiga en las Catacumbas Amani, quema los restos de 10 trols momificados y regresa junto a la consejera Valwyn de Tranquillien en las Tierras Fantasma.‡Investiga en las Catacumbas Amani, quema los restos de 10 trols momificados y regresa junto a la consejera Valwyn de Tranquillien en las Tierras Fantasma.‡Enquêter dans les catacombes des Amani et brûler 10 Restes de trolls momifiés, puis retourner voir la Conseillère Valwyn à Tranquillien dans les Terres fantômes.‡调查阿曼尼墓穴并烧毁10具巨魔木乃伊残骸，然后向幽魂之地塔奎林的顾问瓦尔文复命。‡調查阿曼尼地下墓穴並燒毀10個屍化食人妖遺體再回到鬼魂之地的安寧地找諫言者法溫。',
  }
},
[9194] = {
  {
    '‡Задание мастера: одеяние из рунической ткани‡Handwerksverfügung - Runenstoffrobe‡장인의 계약서: 룬무늬 로브‡Libranza del artesano: toga de paño rúnico‡Libranza del artesano: toga de paño rúnico‡Commission d\'artisan - Robes en étoffe runique‡工匠文书 - 符文布袍‡工匠令狀 - 符文布袍',
    nil,
    '‡Доставьте 8 одеяний из рунической ткани и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 8 Runenstoffroben und die Handwerksverfügung für die Runenstoffroben zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 8 togas de paño rúnico y la libranza del artesano: toga de paño rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 8 togas de paño rúnico y la libranza del artesano: toga de paño rúnico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 8 Robes en étoffe runique et la Commission d\'artisan - Robes en étoffe runique au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将8件符文布袍和工匠文书 - 符文布袍交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9195] = {
  {
    'Escritura do Artífice - carga sapadora goblínica‡Задание мастера: гоблинская мина‡Handwerksverfügung - Goblinpioniersprengladung‡장인의 계약서: 고블린 공병 폭탄‡Libranza del artesano: carga de zapador goblin‡Libranza del artesano: carga de zapador goblin‡Commission d\'artisan - Charges de sapeur gobelin‡工匠文书 - 地精工兵炸药‡工匠令狀 - 哥布林工事炸藥',
    nil,
    'Leve 20 Cargas Sapadoras Goblínicas e a Escritura do Artífice - Carga Sapadora Goblínica - para o Caravaneiro Esmagapedra na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Доставьте 20 гоблинских саперных зарядов и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 20 Goblinpioniersprengladungen und die Handwerksverfügung für die Goblinpioniersprengladungen zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대, 희망의 빛 예배당에 있는 짐노새 주인 스톤브루저에게 고블린 공병 폭탄 20개와 장인의 계약서: 고블린 공병 폭탄을 가져가야 합니다.‡Entrega 20 cargas de zapador goblin y la libranza del artesano: carga de zapador goblin al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 20 cargas de zapador goblin y la libranza del artesano: carga de zapador goblin al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 20 Charges de sapeur gobelin et la Commission d\'artisan - Charges de sapeur gobelin au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将20个地精工兵炸药和工匠文书 - 地精工兵炸药交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡將20個哥布林工事炸藥和工匠令狀 - 哥布林工事炸藥 - 帶到東瘟疫之地給聖光之願禮拜堂的軍需籌備官石漢 。',
  }
},
[9196] = {
  {
    '‡Задание мастера: ториевая граната‡Handwerksverfügung - Thoriumgranate‡장인의 계약서: 토륨 수류탄‡Libranza del artesano: granada de torio‡Libranza del artesano: granada de torio‡Commission d\'artisan - Grenades en thorium‡工匠文书 - 瑟银手榴弹‡工匠令狀 - 瑟銀手榴彈',
    nil,
    '‡Доставьте 20 ториевых гранат и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 20 Thoriumgranaten und die Handwerksverfügung für die Thoriumgranaten zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 20 granadas de torio y la libranza del artesano: granada de torio al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 20 granadas de torio y la libranza del artesano: granada de torio al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 20 Grenades en thorium et la Commission d\'artisan - Grenades en thorium au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将20枚瑟银手榴弹和工匠文书 - 瑟银手榴弹交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9197] = {
  {
    '‡Задание мастера: боевой цыпленок гномов‡Handwerksverfügung - Gnomenkampfhuhn‡장인의 계약서: 노움 쌈닭‡Libranza del artesano: gallo de batalla gnómico‡Libranza del artesano: gallo de batalla gnómico‡Commission d\'artisan - Coqs de combat gnome‡工匠文书 - 侏儒作战小鸡‡工匠令狀 - 地精作戰小雞',
    nil,
    '‡Доставьте 4 боевых цыпленка гномов и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 4 Gnomenkampfhühner und die Handwerksverfügung für die Gnomenkampfhühner zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 4 gallos de batalla gnómicos y la libranza del artesano: gallo de batalla gnómico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 4 gallos de batalla gnómicos y la libranza del artesano: gallo de batalla gnómico al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 4 Coqs de combat gnome et la Commission d\'artisan - Coqs de combat gnome au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将4只侏儒作战小鸡和工匠文书 - 侏儒作战小鸡交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡',
  }
},
[9198] = {
  {
    '‡Задание мастера: ториевая труба‡Handwerksverfügung - Thoriumröhre‡장인의 계약서: 토륨관‡Libranza del artesano: tubo de torio‡Libranza del artesano: tubo de torio‡Commission d\'artisan - Tubes en thorium‡工匠文书 - 瑟银管‡工匠令狀 - 瑟銀管',
    nil,
    '‡Доставьте 14 ториевых труб и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 14 Thoriumröhren und die Handwerksverfügung für die Thoriumröhren zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 14 tubos de torio y la libranza del artesano: tubo de torio al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 14 tubos de torio y la libranza del artesano: tubo de torio al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 14 Tubes en thorium et la Commission d\'artisan - Tubes en thorium au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将14根瑟银管和工匠文书 - 瑟银管交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡',
  }
},
[9199] = {
  {
    'Fetiche Troll‡Джуджу троллей‡Trolljuju‡반짝이는 트롤 부적‡Juju trol‡Juju trol‡Les jujus trolls‡巨魔的邪符‡食人妖護符',
    nil,
    'Colete 8 Fetiches Troll e entregue-os para o Sicário Maltendis em Tranquillien, na Terra Fantasma.‡Соберите 8 джуджу троллей и принесите их стражу смерти Малтендису в Транквиллион в Призрачных землях.‡Sammelt 8 Trolljuju und bringt sie zu Todespirscher Maltendis in Tristessa in den Geisterlanden.‡반짝이는 트롤 부적 8개를 모아서 유령의 땅, 트랜퀼리엔에 있는 죽음추적자 말텐디스에게 가져가야 합니다.‡Consigue 8 Jujus trol y llévaselos al mortacechador Maltendis en Tranquillien, en las Tierras Fantasma.‡Consigue 8 Jujus trol y llévaselos al mortacechador Maltendis en Tranquillien, en las Tierras Fantasma.‡Amassez 8 Jujus trolls et rapportez-les au nécrotraqueur Maltendis, à Tranquillien dans les Terres fantômes.‡收集8个巨魔的邪符，然后向幽魂之地塔奎林的亡灵哨兵玛尔特迪斯复命。‡收集8個食人妖護符交給亡靈哨兵瑪塔堤斯，他在鬼魂之地的安寧地。',
  }
},
[9200] = {
  {
    '‡Задание мастера: огромный флакон с зельем маны‡Handwerksverfügung - Erheblicher Manatrank‡장인의 계약서: 일급 마나 물약‡Libranza del artesano: poción de maná sublime‡Libranza del artesano: poción de maná sublime‡Commission d\'artisan - Potions de mana majeures‡工匠文书 - 特效法力药水‡工匠令狀 - 極效法力藥水',
    nil,
    '‡Доставьте 10 огромных флаконов с зельем маны и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 10 erhebliche Manatränke und die Handwerksverfügung für die erheblichen Manatränke zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 10 pociones de maná sublimes y la libranza del artesano: poción de maná sublime al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 10 pociones de maná sublimes y la libranza del artesano: poción de maná sublime al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 10 Potions de mana majeure et la Commission d\'artisan - Potions de mana majeures au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将10份特效法力药水和工匠文书 - 特效法力药水交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡',
  }
},
[9201] = {
  {
    '‡Задание мастера: сильное зелье защиты от тайной магии‡Handwerksverfügung - Großer Arkanschutztrank‡장인의 계약서: 상급 비전 보호 물약‡Libranza del artesano: poción de Protección contra lo Arcano superior‡Libranza del artesano: poción de Protección contra lo Arcano superior‡Commission d\'artisan - Potions de protection contre les Arcanes supérieures‡工匠文书 - 强效奥术防护药水‡工匠令狀 - 強效秘法防護藥水',
    nil,
    '‡Доставьте 15 мер сильного зелья защиты от тайной магии и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 15 große Arkanschutztränke und die Handwerksverfügung für die großen Arkanschutztränke zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대, 희망의 빛 예배당에 있는 짐노새 주인 스톤브루저에게 상급 비전 보호 물약 15개와 장인의 계약서: 상급 비전 보호 물약을 가져가야 합니다.‡Entrega 15 pociones de Protección contra lo Arcano superior y la libranza del artesano: poción de Protección contra lo Arcano superior al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Entrega 15 pociones de Protección contra lo Arcano superior y la libranza del artesano: poción de Protección contra lo Arcano superior al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Livrer 15 Potions de protection contre les Arcanes supérieure et la Commission d\'artisan - Potions de protection contre les Arcanes supérieures au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将15份强效奥术防护药水和工匠文书 - 强效奥术防护药水交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9202] = {
  {
    '‡Задание мастера: огромный флакон с лечебным зельем‡Handwerksverfügung - Erheblicher Heiltrank‡장인의 계약서: 일급 치유 물약‡Libranza del artesano: poción de sanación sublime‡Libranza del artesano: poción de sanación sublime‡Commission d\'artisan - Potions de soins majeures‡工匠文书 - 特效治疗药水‡工匠令狀 - 極效治療藥水',
    nil,
    '‡Доставьте 20 огромных флаконов с лечебным зельем и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 20 erhebliche Heiltränke und die Handwerksverfügung für die erheblichen Heiltränke zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 20 pociones de sanación sublime y la libranza del artesano: poción de sanación sublime al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 20 pociones de sanación sublime y la libranza del artesano: poción de sanación sublime al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 20 Potions de soins majeure et la Commission d\'artisan - Potions de soins majeures au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将20份特效治疗药水和工匠文书 - 特效治疗药水交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡',
  }
},
[9203] = {
  {
    '‡Задание мастера: зелье оцепенения‡Handwerksverfügung - Trank der Versteinerung‡장인의 계약서: 석화의 물약‡Libranza del artesano: poción de petrificación‡Libranza del artesano: poción de petrificación‡Commission d\'artisan - Potion de pétrification‡工匠文书 - 化石药水‡工匠令狀 - 石化藥水',
    nil,
    '‡Доставьте 1 зелье оцепенения и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 1 Trank der Versteinerung und die Handwerksverfügung für den Trank der Versteinerung zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 1 poción de petrificación y la libranza del artesano: poción de petrificación al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 1 poción de petrificación y la libranza del artesano: poción de petrificación al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 1 Potion de pétrification et la Commission d\'artisan - Potion de pétrification au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡‡',
  }
},
[9204] = {
  {
    'Escritura do Artífice - enguia petrescama‡Задание мастера: каменный угорь‡Handwerksverfügung - Steinschuppenaal‡장인의 계약서: 돌비늘뱀장어‡Libranza del artesano: anguila escama pétrea‡Libranza del artesano: anguila escama pétrea‡Commission d\'artisan - Anguilles pierre-écaille‡工匠文书 - 石鳞鳗‡工匠令狀 - 石鱗鰻',
    nil,
    'Leve 40 Enguias Petrescama e a Escritura do Artífice - Enguia Petrescama - para o Caravaneiro Esmagapedra na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Доставьте 40 каменных угрей и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 40 Steinschuppenaale und die Handwerksverfügung für die Steinschuppenaale zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대, 희망의 빛 예배당에 있는 짐노새 주인 스톤브루저에게 돌비늘뱀장어 40개와 장인의 계약서: 돌비늘뱀장어를 가져가야 합니다.‡Entrega 40 anguilas escama pétrea y la libranza del artesano: anguila escama pétrea al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 40 anguilas escama pétrea y la libranza del artesano: anguila escama pétrea al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 40 Anguilles pierre-écaille et la Commission d\'artisan - Anguilles pierre-écaille au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将40条石鳞鳗和工匠文书 - 石鳞鳗交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9205] = {
  {
    '‡Задание мастера: пластинчатая бронерыба‡Handwerksverfügung - Panzerfisch‡장인의 계약서: 무쇠비늘 철갑어‡Libranza del artesano: pez coraza de placas‡Libranza del artesano: pez coraza de placas‡Commission d\'artisan - Poissons cuirassés‡工匠文书 - 板鳞鱼‡工匠令狀 - 板鱗魚',
    nil,
    '‡Доставьте 30 пластинчатых бронерыб и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 30 Panzerfische und die Handwerksverfügung für die Panzerfische zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡‡Entrega 30 peces coraza de placas y la libranza del artesano: pez coraza de placas al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 30 peces coraza de placas y la libranza del artesano: pez coraza de placas al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 30 Poissons cuirassés et la Commission d\'artisan - Poissons cuirassés au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est.‡将30条板鳞鱼和工匠文书 - 板鳞鱼交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯·石锤。‡',
  }
},
[9206] = {
  {
    'Escritura do Artífice – Enguia Elétrica‡Задание мастера: молниевый угорь‡Handwerksverfügung - Zitteraal‡장인의 계약서: 번개뱀장어‡Libranza del artesano: anguila relámpago‡Libranza del artesano: anguila relámpago‡Commission d\'artisan - Anguilles électriques‡工匠文书 - 电鳗‡工匠令狀 - 電鰻',
    nil,
    'Leve 30 Enguias Elétricas e a Escritura do Artífice – Enguia Elétrica – para o Caravaneiro Esmagapedra na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Доставьте 30 молниевых угрей и соответствующее задание мастера караванщику Камнетесу в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 30 Zitteraale und die Handwerksverfügung für die Zitteraale zu Rottenkommandant Steinberster bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대, 희망의 빛 예배당에 있는 짐노새 주인 스톤브루저에게 번개뱀장어 30개와 장인의 계약서: 번개뱀장어를 가져가야 합니다.‡Entrega 30 anguilas relámpago y la libranza del artesano: anguila relámpago al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega 30 anguilas relámpago y la libranza del artesano: anguila relámpago al maestro de manada Mazadura que está en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Livrer 30 Anguilles électriques et la Commission d\'artisan - Anguilles électriques au maître-fourrier Navrepierre, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将30条电鳗和工匠文书 - 电鳗交给东瘟疫之地圣光之愿礼拜堂的马队管理者布鲁斯-石锤。‡將30隻電鰻和工匠令狀 - 電鰻 - 帶到東瘟疫之地給聖光之願禮拜堂的軍需籌備官石漢 。',
  }
},
[9207] = {
  {
    'Amostras das Minas Telúminas‡Образцы руды из Беспросветных рудников‡Grubenlichterzproben‡미명 광석 표본‡Muestras de mena de Sondaluz‡Muestras de mena de Sondaluz‡Des échantillons de minerai de Terradiance‡幽光矿石样本‡光底礦物樣本',
    nil,
    'Colete 6 amostras de Minério das Minas Telúminas e entregue-as para o Magíster Quallestis no Sacrário Solar, que fica na Terra Fantasma.‡Принесите 6 образцов руды из Беспросветных рудников и доставьте их магистру Квалестису в святилище Солнца в Призрачных землях.‡Sammelt 6 Einheiten Grubenlichterz und bringt sie zu Magister Quallestis beim Sanktum der Sonne in den Geisterlanden.‡미명 광석 6개를 모아서 유령의 땅의 태양의 성소에 있는 마법학자 쿠알레스티스에게 가져가야 합니다.‡Reúne 6 menas de Sondaluz y entrégaselas al magister Quallestis en el Sagrario del Sol en las Tierras Fantasma.‡Reúne 6 menas de Sondaluz y entrégaselas al magister Quallestis en el Sagrario del Sol en las Tierras Fantasma.‡Récupérer 6 charges de Minerai de Terradiance et les apporter au magistère Quallestis au sanctum du Soleil dans les Terres fantômes.‡收集6块幽光矿石，把它们交给幽魂之地太阳圣殿的魔导师奎尔林提斯。‡收集6個光底礦物帶到鬼魂之地的太陽聖所交給博學者奎壘司提斯。',
  }
},
[9208] = {
  {
    'A guarda selvagem: arcano de proteção‡Защита Джунглей – Магический камень защиты‡Der Greuelwächter - Arkanum des Schutzes‡야생의 수호: 보호의 영석‡La guardia salvaje: arcanum de protección‡La guardia salvaje: arcanum de protección‡La Garde sauvage - Arcanum de protection‡野性戒卫 - 防护秘药‡野蠻護衛-保護秘紋',
    nil,
    'Zanza, o Incansável, em Zul\'Gurub, quer um Arcano de Proteção.‡Занзе Неупокоенному в Зул\'Гурубе нужен магический камень защиты.‡Zanza der Ruhelose in Zul\'Gurub möchte ein Arkanum des Schutzes.‡줄구룹에 있는 잠들지 않는 잔자가 보호의 영석을 가져다 달라고 했습니다.‡Zanza el Incansable de Zul\'Gurub quiere un arcanum de protección.‡Zanza el Incansable de Zul\'Gurub quiere un arcanum de protección.‡Zanza le Sans-Repos, de Zul\'Gurub, veut un Arcanum de protection.‡祖尔格拉布的无眠者赞扎需要一份防护秘药。‡祖爾格拉布的『無眠者』贊札 需要1份保護秘紋。',
  }
},
[9209] = {
  {
    'A guarda selvagem: arcano de rapidez‡Защита Джунглей – Магический камень стремительности‡Der Greuelwächter - Arkanum der Schnelligkeit‡야생의 수호: 신속의 영석‡La guardia salvaje: arcanum de rapidez‡La guardia salvaje: arcanum de rapidez‡La Garde sauvage - Arcanum de rapidité‡野性戒卫 - 急速秘药‡野蠻護衛-疾速秘紋',
    nil,
    'Zanza, o Incansável, em Zul\'Gurub, quer um Arcano de Rapidez.‡Занзе Неупокоенному в Зул\'Гурубе нужен магический камень стремительности.‡Zanza der Ruhelose in Zul\'Gurub möchte ein Arkanum der Schnelligkeit.‡줄구룹에 있는 잠들지 않는 잔자가 신속의 영석을 가져다 달라고 했습니다.‡Zanza el Incansable de Zul\'Gurub quiere un arcanum de rapidez.‡Zanza el Incansable de Zul\'Gurub quiere un arcanum de rapidez.‡Zanza le Sans-Repos, de Zul\'Gurub, veut un Arcanum de rapidité.‡祖尔格拉布的无眠者赞扎需要一份急速秘药。‡祖爾格拉布的『無眠者』贊札 需要1份疾速秘紋。',
  }
},
[9210] = {
  {
    'A guarda selvagem: arcano de concentração‡Защита Джунглей – Магический камень сосредоточения‡Der Greuelwächter - Arkanum des Fokus‡야생의 수호: 집중의 영석‡La guardia salvaje: arcanum de enfoque‡La guardia salvaje: arcanum de enfoque‡La Garde sauvage - Arcanum de focalisation‡野性戒卫 - 专注秘药‡野蠻護衛-專注秘紋',
    nil,
    'Zanza, o Incansável, em Zul\'Gurub, quer um Arcano de Concentração.‡Занзе Неупокоенному в Зул\'Гурубе нужен магический камень сосредоточения.‡Zanza der Ruhelose in Zul\'Gurub möchte ein Arkanum des Fokus.‡줄구룹에 있는 잠들지 않는 잔자가 집중의 영석을 가져다 달라고 했습니다.‡Zanza el Incansable de Zul\'Gurub quiere un arcanum de enfoque.‡Zanza el Incansable de Zul\'Gurub quiere un arcanum de enfoque.‡Zanza le Sans-Repos, de Zul\'Gurub, veut un Arcanum de focalisation.‡祖尔格拉布的无眠者赞扎需要一份专注秘药。‡祖爾格拉布的『無眠者』贊札 需要1份專注秘紋。',
  }
},
[9211] = {
  {
    'A Guardafria‡Ледяная защита‡Der Eiswächter‡얼음의 수호‡El guardahielo‡El guardahielo‡La Garde-glace‡寒冰戒卫‡冰霜守護者',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 10 Insígnias da Cruzada e 30 peças de ouro.‡Заплатите 10 знаков Марша и 30 золотых Матеусу Заклинателю Гнева в Часовню Последней Надежды в Восточные Чумные земли.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 10 Insignien des Kreuzzugs und 30 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 분노의 마타우스가 십자군 휘장 10개와 30골드를 달라고 했습니다.‡Mataus el Colérico, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 10 insignias de la Cruzada y 30 piezas de oro.‡Mataus el Colérico, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 10 insignias de la Cruzada y 30 piezas de oro.‡Mataus la Voix du courroux, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut 10 Insignes de la Croisade et 30 pièces d\'or.‡东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯需要10枚十字军徽记和30金币。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯需要10個十字軍徽記和30金。',
  }
},
[9212] = {
  {
    'Fuga das catacumbas‡Бегство из Катакомб‡Flucht aus den Katakomben‡지하묘지 탈출‡Huida de las catacumbas‡Huida de las catacumbas‡L\'évasion des catacombes‡逃离墓穴‡逃出地下墓穴',
    nil,
    'Escolte Lilatha até o Capitão Helios no Enclave dos Andarilhos, que fica na Terra Fantasma.‡Проводите следопыта Лилату к капитану Гелиосу в анклав Странников, что в Призрачных землях.‡Begleitet Waldläuferin Lilatha zu Hauptmann Helios bei der Enklave der Weltenwanderer in den Geisterlanden.‡유령의 땅, 원정순찰대 초소에 있는 순찰대장 헬리오스에게 순찰자 릴라사를 데려가야 합니다.‡Escolta a la forestal Lilatha junto al capitán Helios hasta el Enclave del Errante en las Tierras Fantasma.‡Escolta a la forestal Lilatha junto al capitán Helios hasta el Enclave del Errante en las Tierras Fantasma.‡Escorter le forestier Lilatha jusqu\'au capitaine Hélios, à l\'enclave des Pérégrins dans les Terres fantômes.‡护送游侠莉拉恩萨回到远行者营地的赫里奥斯中尉身边。‡護送遊俠莉娜薩回到鬼魂之地的旅行者營地找希里歐斯隊長。',
  }
},
[9213] = {
  {
    'O Guardassombra‡Теневая защита‡Der Schattenwächter‡암흑의 수호‡El guardasombras‡El guardasombras‡L\'Ombregarde‡暗影戒卫‡暗影守護者',
    nil,
    'Mataus, o Arauto da Ira, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 10 Insígnias da Cruzada e 30 peças de ouro.‡Заплатите 10 знаков Марша и 30 золотых Матеусу Заклинателю Гнева в Часовню Последней Надежды в Восточные Чумные земли.‡Mataus der Zornwirker bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 10 Insignien des Kreuzzugs und 30 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 분노의 마타우스가 십자군 휘장 10개와 30골드를 가져다 달라고 했습니다.‡Mataus el Colérico, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 10 insignias de la Cruzada y 30 piezas de oro.‡Mataus el Colérico, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 10 insignias de la Cruzada y 30 piezas de oro.‡Mataus la Voix du courroux, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut 10 Insignes de la Croisade et 30 pièces d\'or.‡东瘟疫之地圣光之愿礼拜堂的愤怒者玛塔乌斯需要10枚十字军徽记和30金币。‡東瘟疫之地聖光之願禮拜堂的『施怒者』麥特斯需要10個十字軍徽記和30金。',
  }
},
[9214] = {
  {
    'Armas dos Pinhumbra‡Оружие Призрачной Сосны‡Das Arsenal der Waldschattentrolle‡그림자소나무 트롤의 무기‡Armas Sombrapino‡Armas Sombrapino‡Les armes des Ombrepins‡暗松巨魔的武器‡影松食人妖的軍備',
    nil,
    'Colete 3 Machados dos Caçadores de Cabeça, 3 Maças dos Lança-sombras, 3 Garras do Senhor dos Gatos e 3 Báculos de Bagateiros. Entregue-os ao Capitão Helios no Enclave dos Andarilhos, que fica na Terra Fantasma.‡Принесите 3 топора охотников за головами, 3 булавы чародея, 3 когтя повелителей котов и 3 посоха проклинателя. Возвращайтесь к капитану Гелиосу в анклав Странников в Призрачных землях.‡Sammelt 3 Kopfjägeräxte, 3 Schattenzauberstreitkolben, 3 Klauen eines Pantherlords und 3 Verhexerstäbe. Bringt sie zu Hauptmann Helios bei der Enklave der Weltenwanderer in den Geisterlanden.‡인간사냥꾼의 도끼, 흑마술사의 철퇴, 살쾡이군주의 발톱, 사술사의 지팡이를 3개씩 모아서 유령의 땅, 원정순찰대 초소에 있는 순찰대장 헬리오스에게 가져가야 합니다.‡Reúne 3 hachas de rebanacabezas, 3 mazas de taumaturgo umbrío, 3 zarpas de señor de los felinos y 3 bastones de aojador. Llévaselos al capitán Helios en el Enclave del Errante, en las Tierras Fantasma.‡Reúne 3 hachas de rebanacabezas, 3 mazas de taumaturgo umbrío, 3 zarpas de señor de los felinos y 3 bastones de aojador. Llévaselos al capitán Helios en el Enclave del Errante, en las Tierras Fantasma.‡Récupérer 3 Haches de chasseur de tête, 3 Masses d\'exhalombre, 3 Giffres de seigneur des fauves et 3 Bâtons de maléficieur. Rapportez-les au capitaine Hélios, à l\'enclave des Pérégrins des Terres fantômes.‡收集3把猎头者战斧、3把暗影施法者钉锤、3只驭豹者之爪和3根妖术师法杖，然后向远行者营地的赫里奥斯中尉复命。‡收集3個獵頭者之斧、3個暗影施法者之錘、3個馭貓者之爪和3個妖術師之棍，並且回到鬼魂之地的旅行者營地交給希里歐斯隊長。',
  }
},
[9215] = {
  {
    'Traga-me a cabeça de Kel\'gash!‡Награда за голову Келгаша!‡Bringt mir Kel\'gashs Kopf!‡현상 수배: 사악한 켈가쉬‡¡Tráeme la cabeza de Kel\'gash!‡¡Tráeme la cabeza de Kel\'gash!‡Rapportez-moi la tête de Kel\'gash !‡克尔加什的徽记！‡把卡爾喀旭的頭顱帶來!',
    nil,
    'Entregue a Cabeça de Kel\'gash, o Perverso, para o Capitão Helios no Enclave dos Andarilhos, que fica na Terra Fantasma.‡Принесите голову Кел\'гаша Коварного капитану Гелиосу в анклав Странников, что в Призрачных землях.‡Bringt den Kopf von Kel\'gash dem Boshaften zu Hauptmann Helios bei der Enklave der Weltenwanderer in den Geisterlanden.‡사악한 켈가쉬를 처치한 다음 그 증거를 가지고 유령의 땅, 원정순찰대 초소에 있는 순찰대장 헬리오스를 찾아가야 합니다.‡Llévale la cabeza de Kel\'gash el Malvado al capitán Helios en el Enclave del Errante, en las Tierras Fantasma.‡Llévale la cabeza de Kel\'gash el Malvado al capitán Helios en el Enclave del Errante, en las Tierras Fantasma.‡Remettre la Tête de Kel\'gash le Malfaisant au capitaine Hélios, à l\'enclave des Pérégrins, dans les Terres fantômes.‡将克尔加什的徽记交给远行者营地的赫里奥斯中尉。‡將『邪惡者』卡爾喀旭的頭顱帶到鬼魂之地交給旅行者營地的希里歐斯隊長。',
  }
},
[9216] = {
  {
    'Corações putrefatos‡Гниющие сердца‡Faulende Herzen‡썩어가는 심장‡Corazones putrefactos‡Corazones putrefactos‡Les cœurs pourrissants‡腐烂精华‡腐爛之心',
    nil,
    'Leve 10 Corações Putrefatos para a Magistra Aminel em Tranquillien.‡Принесите 10 гниющих сердец магистру Аминель в Транквиллион.‡Bringt 10 faulende Herzen zu Magistrix Aminel in Tristessa.‡트랜퀼리엔에 있는 마법학자 아미넬에게 썩어가는 심장 10개를 가져가야 합니다.‡Llévale 10 corazones putrefactos a la magistrix Aminel en Tranquillien.‡Llévale 10 corazones putrefactos a la magistrix Aminel en Tranquillien.‡Rapporter 10 Cœurs pourrissants à la magistrice Aminel à Tranquillien.‡将10颗腐烂的精华交给塔奎林的魔导师艾米妮尔。‡把10顆腐爛之心交給安寧地的博學者艾米諾。',
  }
},
[9217] = {
  {
    'Mais corações putrefatos‡Больше гниющих сердец‡Mehr faulende Herzen‡썩어가는 심장 추가 확보‡Más corazones putrefactos‡Más corazones putrefactos‡Encore des cœurs pourrissants‡更多腐烂精华‡更多的腐爛之心',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[9218] = {
  {
    'Pó de espinha‡Позвоночный порошок‡Wirbelknochenstaub‡뼈 가루‡Polvo de espina dorsal‡Polvo de espina dorsal‡Poussière de vertèbres‡脊骨之尘‡脊骨之塵',
    nil,
    'Leve 10 punhados de Pó de Espinha para a Magistra Aminel em Tranquillien.‡Принесите 10 порций позвоночного порошка магистру Аминель в Транквиллион.‡Bringt 10 Einheiten Wirbelknochenstaub zu Magistrix Aminel in Tristessa.‡트랜퀼리엔에 있는 마법학자 아미넬에게 뼈 가루 10개를 가져가야 합니다.‡Llévale 10 puñados de polvo de espina dorsal a la magistrix Aminel en Tranquillien.‡Llévale 10 puñados de polvo de espina dorsal a la magistrix Aminel en Tranquillien.‡Rapportez 10 doses de Poussière de vertèbres à la magistrice Aminel à Tranquillien.‡将10份脊骨之尘交给塔奎林的魔导师艾米妮尔。‡把10份脊骨之塵交給安寧地的博學者艾米諾。',
  }
},
[9219] = {
  {
    'Mais pó de espinha‡Больше позвоночного порошка‡Mehr Wirbelknochenstaub‡뼈 가루 추가 확보‡Más polvo de espina dorsal‡Más polvo de espina dorsal‡Encore de la poussière de vertèbres‡更多脊骨之尘‡更多脊骨之塵',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[9220] = {
  {
    'Guerra na Cidadela da Morte‡Война со Смертхольмом‡Krieg gegen die Todesfestung‡데솔름 전쟁‡Guerra a la Ciudad de la Muerte‡Guerra a la Ciudad de la Muerte‡La guerre contre Mortholme‡戴索姆之战‡死亡之域戰爭',
    nil,
    'Mate 5 Olhos de Dar\'Khan, 6 Centuriões de Nerúbis e 6 Lamentadoras na Cidadela da Morte. Depois fale novamente com o Magíster Idonis no Sacrário Solar, que fica na Terra Fantasma.‡Убейте 5 очей Дар\'Хана, 6 нерубов-центурионов и 6 плакальщиц в Смертхольме. Возвращайтесь к магистру Идонису в святилище Солнца в Призрачных землях.‡Tötet in der Todesfestung 5 Augen von Dar\'khan, 6 nerubische Zenturio und 6 Wehklagende und kehrt anschließend zu Magister Idonis beim Sanktum der Sonne in den Geisterlanden zurück.‡데솔름에서 다르칸의 눈 5마리, 네루비스 백인대장 6마리, 통곡하는 원혼 6마리를 해치운 후 유령의 땅, 태양의 성소에 있는 마법학자 이도니스에게 가야 합니다.‡Mata 5 ojos de Dar\'khan, 6 centuriones Nerubis y 6 plañideras en la Ciudad de la Muerte y regresa junto al magister Idonis en el Sagrario del Sol, en las Tierras Fantasma.‡Mata 5 ojos de Dar\'khan, 6 centuriones Nerubis y 6 plañideras en la Ciudad de la Muerte y regresa junto al magister Idonis en el Sagrario del Sol, en las Tierras Fantasma.‡Tuez 5 Yeux de Dar\'Khan, 6 Centurions nérubis et 6 Pleureuses à Mortholme, puis retournez voir le magistère Idonis au sanctum du Soleil dans les Terres fantômes.‡前往戴索姆杀死5个达尔坎之眼、6个蛛怪百夫长和6个恸哭者，然后向幽魂之地太阳圣殿的魔导师伊东尼斯复命。‡在死亡之域殺掉5名死亡之域通靈師，6名奈幽碧斯百夫長和6名哀嚎者，並回到鬼魂之地向太陽聖所的博學者艾度尼斯回報。',
  }
},
[9221] = {
  {
    'Armamentos de Batalha Superiores: Aliados da Aurora‡Превосходное боевое снаряжениее – Друг Рассвета‡Überragende Kampfausrüstung - Freund der Dämmerung‡희귀한 전투 장비: 여명회에 약간 우호적‡Armamento superior de batalla: amistoso con El Alba‡Armamento superior de batalla: amistoso con El Alba‡Armes de bataille excellentes - Ami de l\'Aube‡精良的作战装备 - 银色黎明友善‡精良級軍備之戰-銀色黎明聲望友善',
    nil,
    'Por 30 Insígnias da Aurora e 30 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.|n‡За 30 знаков Рассвета и 30 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 30 Insignien der Dämmerung und 30 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 30개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 30 insignias de El Alba y 30 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.|n‡Por 30 insignias de El Alba y 30 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.|n‡En échange de 30 Insignes de l\'Aube et 30 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有30枚银色黎明徽记和30枚十字军徽记，就能从银色黎明的宝藏中挑选一件物品。‡付出30個黎明徽記和30個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣強大的物品。',
  }
},
[9222] = {
  {
    'Armamentos Épicos de Batalha: Aliados da Aurora‡Легендарное боевое снаряжение – Друг Рассвета‡Epische Kampfausrüstung - Freund der Dämmerung‡영웅을 위한 전투 장비: 여명회에 약간 우호적‡Armamento épico de batalla: amistoso con El Alba‡Armamento épico de batalla: amistoso con El Alba‡Armes de bataille épiques - Ami de l\'Aube‡史诗级的作战装备 - 银色黎明友善‡史詩級軍備之戰-銀色黎明聲望友善',
    nil,
    'Por 110 Insígnias da Aurora e 110 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.‡За 110 знаков Рассвета и 110 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 110 Insignien der Dämmerung und 110 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 110개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 110 insignias de El Alba y 110 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡Por 110 insignias de El Alba y 110 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡En échange de 110 Insignes de l\'Aube et 110 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有110枚银色黎明徽记和110枚十字军徽记，就能从银色黎明的宝藏中挑选一件物品。‡付出110個黎明徽記和110個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣史詩級的物品。',
  }
},
[9223] = {
  {
    'Armamentos superiores: honrado entre a Aurora‡Превосходное боевое снаряжение – Уважаемый Рассветом‡Überragende Kampfausrüstung - Wohlwollen der Dämmerung‡희귀한 전투 장비: 여명회에 우호적‡Armamento superior de batalla: honorable con El Alba‡Armamento superior de batalla: honorable con El Alba‡Armes de bataille excellentes - Honoré auprès de l\'Aube‡精良的作战装备 - 银色黎明尊敬‡精良級軍備之戰-銀色黎明聲望尊敬',
    nil,
    'Por 20 Insígnias da Aurora e 20 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.‡За 20 знаков Рассвета и 20 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 20 Insignien der Dämmerung und 20 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 20개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 20 insignias de El Alba y 20 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡Por 20 insignias de El Alba y 20 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡En échange de 20 Insignes de l\'Aube et 20 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有20枚银色黎明徽记和20枚十字军徽记，就能从银色黎明库存的宝藏中挑选一件物品。‡付出20個黎明徽記和20個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣強大的物品。',
  }
},
[9224] = {
  {
    'Armamentos Épicos de Batalha: Honrado pela Aurora‡Легендарное снаряжение – Уважаемый Рассветом‡Epische Kampfausrüstung - Wohlwollen der Dämmerung‡영웅을 위한 전투 장비: 여명회에 우호적‡Armamento épico de batalla: honorable con El Alba‡Armamento épico de batalla: honorable con El Alba‡Armes de bataille épiques - Honoré auprès de l\'Aube‡史诗级的作战装备 - 银色黎明尊敬‡史詩級軍備之戰-銀色黎明聲望尊敬',
    nil,
    'Por 75 Insígnias da Aurora e 75 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.‡За 75 знаков Рассвета и 75 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 75 Insignien der Dämmerung und 75 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 75개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 75 insignias de El Alba y 75 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡Por 75 insignias de El Alba y 75 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡En échange de 75 Insignes de l\'Aube et 75 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有75枚银色黎明徽记和75枚十字军徽记，就能从银色黎明库存的宝藏中挑选一件物品。‡付出75個黎明徽記和75個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣史詩級的物品。',
  }
},
[9225] = {
  {
    'Armamentos Épicos de Batalha: Reverenciado pela Aurora‡Легендарное боевое снаряжение – Чтимый Рассветом‡Epische Kampfausrüstung - Respekt der Dämmerung‡영웅을 위한 전투 장비: 여명회에 매우 우호적‡Armamento épico de batalla: venerado con El Alba‡Armamento épico de batalla: venerado con El Alba‡Armes de bataille épiques - Révéré auprès de l\'Aube‡史诗级的作战装备 - 银色黎明崇敬‡史詩級軍備之戰-銀色黎明聲望崇敬',
    nil,
    'Por 45 Insígnias da Aurora e 45 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.‡За 45 знаков Рассвета и 45 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 45 Insignien der Dämmerung und 45 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 45개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 45 insignias de El Alba y 45 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡Por 45 insignias de El Alba y 45 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡En échange de 45 Insignes de l\'Aube et 45 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有45枚银色黎明徽记和45枚十字军徽记，就能从银色黎明库存的宝藏中挑选一件物品。‡付出45個黎明徽記和45個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣史詩級的物品。',
  }
},
[9226] = {
  {
    'Armamentos superiores de batalha - reverenciado pela Aurora‡Превосходное боевое снаряжениее – Чтимый Рассветом‡Überragende Kampfausrüstung - Respekt der Dämmerung‡희귀한 전투 장비: 여명회에 매우 우호적‡Armamento superior de batalla: venerado con El Alba‡Armamento superior de batalla: venerado con El Alba‡Armes de bataille excellentes - Révéré auprès de l\'Aube‡精良的作战装备 - 银色黎明崇敬‡精良級軍備之戰-銀色黎明聲望崇敬',
    nil,
    'Por 7 Insígnias da Aurora e 7 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.|n‡За 7 значков Серебряного Рассвета и 7 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 7 Insignien der Dämmerung und 7 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 7개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 7 insignias de El Alba y 7 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.|n‡Por 7 insignias de El Alba y 7 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.|n‡En échange de 7 Insignes de l\'Aube et 7 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有7枚银色黎明徽记和7枚十字军徽记，就能从银色黎明库存的宝藏中挑选一件物品。‡付出7個黎明徽記和7個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣強大的物品。',
  }
},
[9227] = {
  {
    'Armamentos superiores de batalha - exaltado pela Aurora‡Превосходное боевое снаряжениее – Восторг Рассвета‡Überragende Kampfausrüstung - Ehrfurcht der Dämmerung‡희귀한 전투 장비: 여명회의 확고한 동맹‡Armamento superior de batalla: exaltado con El Alba‡Armamento superior de batalla: exaltado con El Alba‡Armes de bataille excellentes - Exalté auprès de l\'Aube‡精良的作战装备 - 银色黎明崇拜‡精良級軍備之戰-銀色黎明聲望崇拜',
    nil,
    'Por 6 Insígnias da Aurora e 6 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.‡За 6 знаков Рассвета и 6 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 6 Insignien der Dämmerung und 6 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 6개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 6 insignias de El Alba y 6 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡Por 6 insignias de El Alba y 6 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡En échange de 6 Insignes de l\'Aube et 6 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有6枚银色黎明徽记和6枚十字军徽记，就能从银色黎明库存的宝藏中挑选一件物品。‡付出6個黎明徽記和6個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣強大的物品。',
  }
},
[9228] = {
  {
    'Armamentos Épicos de Batalha: Exaltado pela Aurora‡Легендарное боевое снаряжение – Восторг Рассвета‡Epische Kampfausrüstung - Ehrfurcht der Dämmerung‡영웅을 위한 전투 장비: 여명회의 확고한 동맹‡Armamento épico de batalla: exaltado con El Alba‡Armamento épico de batalla: exaltado con El Alba‡Armes de bataille épiques - Exalté auprès de l\'Aube‡史诗级的作战装备 - 银色黎明崇拜‡史詩級軍備之戰-銀色黎明聲望崇拜',
    nil,
    'Por 27 Insígnias da Aurora e 27 Insígnias da Cruzada, você pode escolher um item no tesouro da Aurora Argêntea.‡За 27 знаков Рассвета и 27 значков Алого ордена вы можете выбрать себе предмет из сокровищницы Серебряного Рассвета.‡Für 27 Insignien der Dämmerung und 27 Insignien des Kreuzzugs dürft Ihr Euch einen Gegenstand aus den Schatzkammern der Argentumdämmerung aussuchen.‡여명회 휘장과 십자군 휘장을 각각 27개씩 내면 은빛 여명회의 보물 창고에서 꺼내온 물건을 하나 선택할 수 있습니다.‡Por 27 insignias de El Alba y 27 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡Por 27 insignias de El Alba y 27 de la Cruzada, puedes elegir un objeto del tesoro de El Alba Argenta.‡En échange de 27 Insignes de l\'Aube et 27 Insignes de la Croisade, vous pouvez choisir un objet du trésor de guerre de l\'Aube d\'argent.‡如果你有27枚银色黎明徽记和27枚十字军徽记，就能从银色黎明库存的宝藏中挑选一件物品。‡付出27個黎明徽記和27個十字軍徽記就能換取銀色黎明藏寶庫裡的一樣史詩級的物品。',
  }
},
[9229] = {
  {
    'O destino de Ramaladni‡Кольцо Судьбы Рамаладни‡Ramaladnis Schicksal‡라말라드니의 생사 확인‡El destino de Ramaladni‡El destino de Ramaladni‡Le destin de Ramaladni‡拉玛兰迪的命运‡羅馬拉丁尼的命運',
    nil,
    'Entre em Naxxramas e descubra o Destino de Ramaladni.‡Идите в Наксрамас и найдите кольцо Судьбы Рамаладни.‡Betretet Naxxramas und bringt Ramaladnis Schicksal in Erfahrung.‡낙스라마스로 가서 라말라드니의 생사를 확인해야 합니다.‡Entra en Naxxramas y descubre qué suerte corrió Ramaladni.‡Entra en Naxxramas y descubre qué suerte corrió Ramaladni.‡Entrez dans Naxxramas et découvrez le Destin de Ramaladni.‡进入纳克萨玛斯的宫殿，找到拉玛兰迪的下落。‡進入納克薩瑪斯並找尋羅馬拉丁尼的命運。',
  }
},
[9230] = {
  {
    'O toque frio de Ramaladni‡Ледяная хватка Рамаладни‡Ramaladnis eisiger Griff‡라말라드니의 얼음 고리‡La garra helada de Ramaladni‡La garra helada de Ramaladni‡L\'étreinte de glace de Ramaladni‡拉玛兰迪的寒冰之握‡羅馬拉丁尼的冰握',
    nil,
    'Korfax, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 1 Runa Congelada, 1 Safira Azul e 1 Barra de Arcanita.|n‡Принесите 1 морозную руну, 1 синий сапфир и 1 арканитовый слиток Корфаксу в часовню Последней Надежды в Восточные Чумные земли.‡Korfax bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte, dass Ihr ihm 1 gefrorene Rune, 1 blauen Saphir und 1 Arkanitbarren bringt.‡동부 역병지대의 희망의 빛 예배당에 있는 코팩스가 얼어붙은 룬 1개, 푸른 사파이어 1개, 아케이나이트 주괴 1개를 가져다 달라고 했습니다.‡Korfax, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere que le lleves 1 runa helada, 1 zafiro azul y 1 barra de arcanita.|n‡Korfax, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere que le lleves 1 runa helada, 1 zafiro azul y 1 barra de arcanita.|n‡Korfax, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est, veut que vous lui rameniez 1 Rune de givre, 1 Saphir bleu et 1 Barre d\'arcanite.‡东瘟疫之地圣光之愿礼拜堂的科尔法克斯要1个冰冻符文、1块蓝宝石和1块奥金锭。‡東瘟疫之地聖光之願禮拜堂的柯菲斯需要你帶給他1個冰凍符文，1顆藍寶石，還有1個奧金錠。',
  }
},
[9231] = {
  {
    '‡‡‡재사용‡‡‡RÉUTILISER‡‡',
    nil,
    nil,
  }
},
[9232] = {
  {
    'A única cançoneta que eu conheço...‡Не разгуляешься...‡Das Einzige, das ich kann...‡유일한 제조법...‡La única canción que conozco‡La única canción que conozco‡C\'est tout ce que j\'ai à mon répertoire...‡我只会唱这一首歌......‡唯一本領……',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 2 Runas Congeladas, 2 Essências da Água, 2 Safiras Azuis e 30 de ouro.‡Принесите 2 морозных руны, 2 сущности воды, 2 синих сапфира и 30 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte, dass Ihr ihm 2 gefrorene Runen, 2 Essenzen des Wassers, 2 blaue Saphire und 30 Goldstücke bringt.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 2개, 물의 정수 2개, 푸른 사파이어 2개, 그리고 30골드를 부탁했습니다.‡El artesano Wilhelm, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere que le lleves 2 runas heladas, 2 esencias de agua, 2 zafiros azules y 30 piezas de oro.‡El artesano Wilhelm, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere que le lleves 2 runas heladas, 2 esencias de agua, 2 zafiros azules y 30 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 2 Runes de givre, 2 Essences d\'eau, 2 Saphirs bleus et 30 pièces d\'or.‡将2个冰冻符文、2个水之精华、2块蓝宝石和30金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他2個冰凍符文，2個水之精華 ，2顆藍寶石，還有30金。',
  }
},
[9233] = {
  {
    'Manual de Omarion‡Руководство Омариона‡Omarions Leitfaden‡오마리온의 안내서‡Vademécum de Omarion‡Vademécum de Omarion‡Le recueil d\'Omarion‡奥玛里恩的手册‡歐瑪利安之手冊',
    nil,
    'Leve o Manual de Omarion ao Artesão Wilhelm na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.|n‡Отнесите руководство Омариона ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt Omarions Leitfaden zu Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름에게 오마리온의 안내서를 가져가야 합니다.‡Lleva el vademécum de Omarion al artesano Wilhelm a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.|n‡Lleva el vademécum de Omarion al artesano Wilhelm a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.|n‡Remettre le Recueil d\'Omarion à l\'artisan Wilhelm à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将奥玛里恩的手册交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡把歐瑪利安之手冊交給工匠維爾海姆，他就在東瘟疫之地聖光之願禮拜堂。',
  }
},
[9234] = {
  {
    'Manoplas da perdição gélida‡Рукавицы ледяной погибели‡Eisfluchstulpen‡얼음파열 건틀릿‡Los guanteletes Deliriohelado‡Los guanteletes Deliriohelado‡Les gantelets plaie-de-glace‡破冰护手‡冰剋護手',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 5 Runas Congeladas, 12 Barras de Tório, 2 Barras de Arcanita, 2 Essências da Água e 200 de ouro.‡Принесите 5 морозных рун, 12 ториевых слитков, 2 арканитовых слитка, 2 сущности воды и 200 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 5 gefrorene Runen, 12 Thoriumbarren, 2 Arkanitbarren, 2 Essenzen des Wassers und 200 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 5개, 토륨 주괴 12개, 아케이나이트 주괴 2개, 물의 정수 2개와 200골드를 가져다 달라고 했습니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 12 barras de torio, 2 barras de arcanita, 2 esencias de agua y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 12 barras de torio, 2 barras de arcanita, 2 esencias de agua y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 5 Runes de givre, 12 barres de thorium, 2 barres d\'arcanite, 2 Essences d\'eau et 200 pièces d\'or.‡将5个冰冻符文、12块瑟银锭、2块奥金锭、2个水之精华和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他5個冰凍符文，12個瑟銀錠，2個奧金錠，2個水之精華，還有200金。',
  }
},
[9235] = {
  {
    'Braçadeiras da Perdição Gélida‡Наручи ледяной погибели‡Eisflucharmschienen‡얼음파열 팔보호구‡Los brazales Deliriohelado‡Los brazales Deliriohelado‡Les brassards plaie-de-glace‡破冰护腕‡冰剋護腕',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 4 Runas Congeladas, 12 Barras de Tório, 2 Barras de Arcanita, 2 Essências da Água e 200 de ouro.‡Принесите 4 морозных руны, 12 ториевых слитков, 2 арканитовых слитка, 2 сущности воды и 200 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 4 gefrorene Runen, 12 Thoriumbarren, 2 Arkanitbarren, 2 Essenzen des Wassers und 200 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 4개, 토륨 주괴 12개, 아케이나이트 주괴 2개, 물의 정수 2개와 200골드를 가져다 달라고 했습니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 12 barras de torio, 2 barras de arcanita, 2 esencias de agua y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 12 barras de torio, 2 barras de arcanita, 2 esencias de agua y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 4 Runes de givre, 12 barres de thorium, 2 barres d\'arcanite, 2 Essences d\'eau et 200 pièces d\'or.‡将4个冰冻符文、12块瑟银锭、2块奥金锭、2个水之精华和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他4個冰凍符文，12個瑟銀錠，2個奧金錠，2個水之精華，還有200金。',
  }
},
[9236] = {
  {
    'Peitoral da perdição gélida‡Кираса ледяной погибели‡Eisfluchbrustplatte‡얼음파열 가슴보호갑‡La coraza Deliriohelado‡La coraza Deliriohelado‡La cuirasse plaie-de-glace‡破冰胸甲‡冰剋胸甲',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 8 Runas Congeladas, 16 Barras de Tório, 2 Barras de Arcanita, 4 Essências da Água e 300 de ouro. Também é preciso ter a reputação Exaltado com a Aurora Argêntea.|n‡Принесите 8 морозных рун, 16 ториевых слитков, 2 арканитовых слитка, 4 сущности воды и 300 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли. Для выполнения задания вам также необходимо пользоваться полным доверием в Серебряном Рассвете.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 8 gefrorene Runen, 16 Thoriumbarren, 2 Arkanitbarren, 4 Essenzen des Wassers und 300 Gold. Euer Ruf bei der Argentumdämmerung muss außerdem ehrfürchtig sein.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 8개, 토륨 주괴 16개, 아케이나이트 주괴 2개, 물의 정수 4개와 300골드를 가져다 달라고 했습니다. 또한, 은빛 여명회로부터 확고한 동맹의 평판을 얻은 상태여야 합니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 16 barras de torio, 2 barras de arcanita, 4 esencias de agua y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.|n‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 16 barras de torio, 2 barras de arcanita, 4 esencias de agua y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.|n‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 8 Runes de givre, 16 barres de thorium, 2 barres d\'arcanite, 4 Essences d\'eau et 300 pièces d\'or. Vous devez aussi être Exaltée par l\'Aube d\'argent.‡将8个冰冻符文、16块瑟银锭、2块奥金锭、4个水之精华和300金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。你在银色黎明的声望必须达到崇拜。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他8個冰凍符文，16個瑟銀錠，2個奧金錠，4個水之精華，還有300金。同時你必須在銀色黎明達到崇拜聲望值，才能完成這項任務。',
  }
},
[9237] = {
  {
    'Manto glacial‡Ледовый плащ‡Gletscherumhang‡빙하의 망토‡La capa glacial‡La capa glacial‡La cape glaciaire‡冰川披风‡冰川披風',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 5 Runas Congeladas, 4 Peças de Runatrama, 2 Essências da Água, 4 Sedas de Aranha Ferroteia e 200 de ouro. Também é preciso ter a reputação de Exaltado com a Aurora Argêntea.‡Принесите 5 морозных рун, 4 рулона рунической ткани, 2 сущности воды, 4 железошелковых паутины и 200 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли. Требуется превознесение в Серебряном Рассвете.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 5 gefrorene Runen, 4 Runenstoffballen, 2 Essenzen des Wassers, 4 Einheiten Eisenweberseide und 200 Gold. Euer Ruf bei der Argentumdämmerung muss außerdem ehrfürchtig sein.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 5개, 룬무늬 두루마리 4개, 물의 정수 2개, 강철그물 거미줄 4개와 200골드를 가져다 달라고 했습니다. 또한, 은빛 여명회로부터 확고한 동맹의 평판을 얻어야 합니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 4 madejas de paño rúnico, 2 esencias de agua, 4 sedas de araña Tejehierro y 200 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 4 madejas de paño rúnico, 2 esencias de agua, 4 sedas de araña Tejehierro y 200 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 5 Runes de givre, 4 Rouleaux d\'étoffe runique, 2 Essences d\'eau, 4 Soies d\'araignée toilacier et 200 pièces d\'or. Vous devez aussi être Exaltée par l\'Aube d\'argent.‡将5个冰冻符文、4个符文布卷、2个水之精华、4个铁网蛛丝和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。你在银色黎明的声望必须达到崇拜。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他5個冰凍符文，4份符文布卷，2個水之精華，4份鐵網蛛絲，還有200金。同時你必須在銀色黎明達到崇拜聲望值，才能完成這項任務。',
  }
},
[9238] = {
  {
    'Pulsos glaciais‡Ледовые накулачники‡Gletscherhandschutz‡빙하의 손목보호대‡Las muñequeras glaciales‡Las muñequeras glaciales‡Les poignets glaciaires‡冰川护腕‡冰川腕帶',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 4 Runas Congeladas, 2 Peças de Runatrama, 2 Essências da Água, 2 Sedas de Aranha Ferroteia e 200 de ouro.‡Принесите 4 морозных руны, 2 рулона рунической ткани, 2 сущности воды, 2 железошелковых паутины и 200 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 4 gefrorene Runen, 2 Runenstoffballen, 2 Essenzen des Wassers, 2 Einheiten Eisenweberseide und 200 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 4개, 룬무늬 두루마리 2개, 물의 정수 2개, 강철그물 거미줄 2개와 200골드를 가져다 달라고 했습니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 2 madejas de paño rúnico, 2 esencias de agua, 2 sedas de araña Tejehierro y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 2 madejas de paño rúnico, 2 esencias de agua, 2 sedas de araña Tejehierro y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 4 Runes de givre, 2 Rouleaux d\'étoffe runique, 2 Essences d\'eau, 2 Soies d\'araignée toilacier et 200 pièces d\'or.‡将4个冰冻符文、2个符文布卷、2个水之精华、2个铁网蛛丝和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他4個冰凍符文，2份符文布卷，2個水之精華，2份鐵網蛛絲，還有200金。',
  }
},
[9239] = {
  {
    'Luvas glaciais‡Ледовые перчатки‡Gletscherhandschuhe‡빙하의 장갑‡Los guantes glaciales‡Los guantes glaciales‡Les gants glaciaires‡冰川手套‡冰川手套',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 5 Runas Congeladas, 4 Peças de Runatrama, 4 Essências da Água, 2 Sedas de Aranha Ferroteia e 200 de ouro.‡Принесите 5 морозных рун, 4 рулона рунической ткани, 4 сущности воды, 2 железошелковых паутины и 200 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 5 gefrorene Runen, 4 Runenstoffballen, 4 Essenzen des Wassers, 2 Einheiten Eisenweberseide und 200 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 5개, 룬무늬 두루마리 4개, 물의 정수 4개, 강철그물 거미줄 2개와 200골드를 가져다 달라고 했습니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 4 madejas de paño rúnico, 4 esencias de agua, 2 sedas de araña Tejehierro y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 4 madejas de paño rúnico, 4 esencias de agua, 2 sedas de araña Tejehierro y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 5 Runes de givre, 4 Rouleaux d\'étoffe runique, 4 Essences d\'eau, 2 Soies d\'araignée toilacier et 200 pièces d\'or.‡将5个冰冻符文、4个符文布卷、4个水之精华、2个铁网蛛丝和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要5個冰凍符文，4份符文布卷，4個水之精華，2份鐵網蛛絲，還有200金。',
  }
},
[9240] = {
  {
    'Colete glacial‡Ледовый жилет‡Gletscherweste‡빙하의 조끼‡El jubón glacial‡El jubón glacial‡Le gilet glaciaire‡冰川外衣‡冰川外衣',
    nil,
    'O Artesão Wilhelm, da Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 8 Runas Congeladas, 8 Peças de Runatrama, 6 Essências da Água, 4 Sedas de Aranha Ferroteia e 300 de ouro. Também é preciso ter a reputação Exaltado com a Aurora Argêntea.‡Принесите 8 морозных рун, 8 рулонов рунической ткани, 6 сущностей воды, 4 железошелковых паутины и 300 золотых ремесленнику Вильгельму в часовню Последней Надежды в Восточные Чумные земли. Требуется превознесение в Серебряном Рассвете.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 8 gefrorene Runen, 8 Runenstoffballen, 6 Essenzen des Wassers, 4 Einheiten Eisenweberseide und 300 Gold. Euer Ruf bei der Argentumdämmerung muss außerdem ehrfürchtig sein.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 8개, 룬무늬 두루마리 8개, 물의 정수 6개, 강철그물 거미줄 4개와 300골드를 가져다 달라고 했습니다. 또한, 은빛 여명회로부터 확고한 동맹의 평판을 얻은 상태여야 합니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 8 madejas de paño rúnico, 6 esencias de agua, 4 sedas de araña Tejehierro y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 8 madejas de paño rúnico, 6 esencias de agua, 4 sedas de araña Tejehierro y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 8 Runes de givre, 8 Rouleaux d\'étoffe runique, 6 Essences d\'eau, 4 Soies d\'araignée toilacier et 300 pièces d\'or. Vous devez aussi être Exaltée par l\'Aube d\'argent.‡将8个冰冻符文、8个符文布卷、6个水之精华、4个铁网蛛丝和300金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。你在银色黎明的声望必须达到崇拜。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他8個冰凍符文，8份符文布卷，6個水之精華，4份鐵網蛛絲，還有300金。同時你必須在銀色黎明達到崇拜聲望值，才能完成這項任務。',
  }
},
[9241] = {
  {
    'Braçadeiras polares‡Снежные наручи‡Polararmschienen‡북극의 팔보호구‡Brazales polares‡Brazales polares‡Les brassards polaires‡北极护腕‡極地護腕',
    nil,
    'Craftsman Wilhelm at Light\'s Hope Chapel in the Eastern Plaguelands wants 4 Frozen Runes, 12 Enchanted Leather, 3 Essence of Water, 3 Cured Rugged Hides and 200 gold.‡Принесите 4 морозные руны, 12 кусков зачарованной кожи, 3 сущности воды, 3 обработанных грубых шкуры и 200 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 4 gefrorene Runen, 12 Einheiten verzaubertes Leder, 3 Essenzen des Wassers, 3 geschmeidige unverwüstliche Bälge und 200 Gold.‡동부 역병지대, 희망의 빛 예배당에 있는 기능공 빌헬름이 얼어붙은 룬 4개, 마력 깃든 가죽 12개, 물의 정수 3개, 거친 경화 가죽 3개와 200골드를 가져다 달라고 했습니다.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 12 cueros encantados, 3 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.|n‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 12 cueros encantados, 3 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.|n‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 4 Runes de givre, 12 Cuirs enchantés, 3 Essences d\'eau, 3 Peaux robustes traitées et 200 pièces d\'or.‡将4个冰冻符文、12个魔化皮、3个水之精华、3个熟化毛皮和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡東瘟疫之地聖光之願禮拜堂的工匠維爾海姆需要你帶給他4個冰凍符文，12塊附魔皮，3個水之精華，3塊熟化毛皮，還有200金。',
  }
},
[9242] = {
  {
    '‡Снежные перчатки‡Polarhandschuhe‡북극의 장갑‡Guantes polares‡Guantes polares‡Gants polaires‡北极手套‡極地手套',
    nil,
    '‡Принесите 5 морозных рун, 12 кусков зачарованной кожи, 3 субстанции Воды, 3 обработанных грубых шкуры и 200 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 5 gefrorene Runen, 12 Einheiten verzaubertes Leder, 3 Essenzen des Wassers, 3 geschmeidige unverwüstliche Bälge und 200 Gold.‡‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 12 cueros encantados, 3 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 12 cueros encantados, 3 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'Est, veut 5 Runes de givre, 12 Cuirs enchantés, 3 Essences d\'eau, 3 Peaux robustes traitées et 200 pièces d\'or.‡将5个冰冻符文、12个魔化皮、3个水之精华、3个熟化毛皮和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡',
  }
},
[9243] = {
  {
    '‡Снежный мундир‡Polartunika‡북극의 튜닉‡Guerrera polar‡Guerrera polar‡Tunique polaire‡北极外套‡極地外套',
    nil,
    '‡Принесите 8 морозных рун, 16 кусков зачарованной кожи, 5 субстанций Воды, 5 обработанных грубых шкур и 300 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли. Кроме того, вас должны превозносить в ордене Серебряного Рассвета.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 8 gefrorene Runen, 16 Einheiten verzaubertes Leder, 5 Essenzen des Wassers, 5 geschmeidige unverwüstliche Bälge und 300 Gold. Euer Ruf bei der Argentumdämmerung muss außerdem ehrfürchtig sein.‡‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 16 cueros encantados, 5 esencias de agua, 5 pellejos bastos curtidos y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 16 cueros encantados, 5 esencias de agua, 5 pellejos bastos curtidos y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'Est, veut 8 Runes de givre, 16 Cuirs enchantés, 5 Essences d\'eau, 5 Peaux robustes traitées et 300 pièces d\'or. Vous devez aussi être $GExalté:Exaltée; par l\'Aube d\'argent.‡将8个冰冻符文、16个魔化皮、5个水之精华、5个熟化毛皮和300金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。你在银色黎明的声望必须达到崇拜。‡',
  }
},
[9244] = {
  {
    '‡Наручи из ледяной чешуи‡Eisschuppenarmschienen‡얼어붙은 미늘 팔보호구‡Los brazales de escamas heladas‡Brazales de escamas heladas‡Les brassards glacécaille‡寒鳞护腕‡冰鱗護腕',
    nil,
    '‡Принесите 4 морозные руны, 16 толстых чешуй скорпида, 5 субстанций Воды, 3 обработанные грубые шкуры и 200 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 4 gefrorene Runen, 16 schwere Skorpidschuppen, 5 Essenzen des Wassers, 3 geschmeidige unverwüstliche Bälge und 200 Gold.‡‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 16 escamas de escórpido pesado, 5 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 4 runas heladas, 16 escamas de escórpido pesado, 5 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est, veut 4 Runes de givre, 16 Ecailles de scorpide épaisses, 5 Essences d\'eau, 3 Peaux robustes traitées et 200 pièces d\'or.‡东瘟疫之地圣光之愿礼拜堂的铁匠维尔海姆需要你带给他4个冰冻符文，16个厚蝎鳞，5个水之精华，3块熟化毛皮，还有200金。‡',
  }
},
[9245] = {
  {
    '‡Рукавицы из ледяной чешуи‡Eisschuppenstulpen‡얼어붙은 미늘 건틀릿‡Guanteletes de escamas heladas‡Guanteletes de escamas heladas‡Gantelets glacécaille‡寒鳞护手‡冰鱗護手',
    nil,
    '‡Принесите 5 морозных рун, 16 толстых чешуй скорпида, 5 субстанций Воды, 3 обработанные грубые шкуры и 200 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 5 gefrorene Runen, 16 schwere Skorpidschuppen, 5 Essenzen des Wassers, 3 geschmeidige unverwüstliche Bälge und 200 Gold.‡‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 16 escamas de escórpido pesado, 5 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 runas heladas, 16 escamas de escórpido pesado, 5 esencias de agua, 3 pellejos bastos curtidos y 200 piezas de oro.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'Est, veut 5 Runes de givre, 16 Ecailles de scorpide épaisses, 5 Essences d\'eau, 3 Peaux robustes traitées et 200 pièces d\'or.‡将5个冰冻符文、16片厚蝎鳞、5个水之精华、3个熟化毛皮和200金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。‡',
  }
},
[9246] = {
  {
    '‡Кираса из ледяной чешуи‡Eisschuppenbrustplatte‡얼어붙은 미늘 가슴보호갑‡Coraza de escamas heladas‡Coraza de escamas heladas‡Cuirasse glacécaille‡寒鳞胸甲‡冰鱗胸甲',
    nil,
    '‡Принесите 8 морозных рун, 24 толстые чешуи скорпида, 7 субстанций Воды, 5 обработанных грубых шкур и 300 золотых ремесленнику Вильгельму в Часовню Последней Надежды в Восточные Чумные земли. Кроме того, вас должны превозносить в ордене Серебряного Рассвета.‡Handwerker Wilhelm bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern möchte 8 gefrorene Runen, 24 schwere Skorpidschuppen, 7 Essenzen des Wassers, 5 geschmeidige unverwüstliche Bälge und 300 Gold. Euer Ruf bei der Argentumdämmerung muss außerdem ehrfürchtig sein.‡‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 24 escamas de escórpido pesado, 7 esencias de agua, 5 pellejos bastos curtidos y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡El artesano Wilhelm de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 8 runas heladas, 24 escamas de escórpido pesado, 7 esencias de agua, 5 pellejos bastos curtidos y 300 piezas de oro. Además, debes tener un nivel de reputación de exaltado con El Alba Argenta.‡L\'artisan Wilhelm de la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'Est, veut 8 Runes de givre, 24 Ecailles de scorpide épaisses, 7 Essences d\'eau, 5 Peaux robustes traitées et 300 pièces d\'or. Vous devez aussi être $GExalté:Exaltée; par l\'Aube d\'argent.‡将8个冰冻符文、24片厚蝎鳞、7个水之精华、5个熟化毛皮和300金币交给东瘟疫之地圣光之愿礼拜堂的工匠威尔海姆。你在银色黎明的声望必须达到崇拜。‡',
  }
},
[9247] = {
  {
    'O chamado do guardião‡Зов Хранителя‡Der Ruf des Bewahrers‡기록 보관원의 부름‡La llamada de los guardianes‡La llamada de los guardianes‡L\'appel du Gardien‡圣光的召唤‡保管者的徵召',
    nil,
    'Devolva a Carta para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите письмо хранителя свитков самому хранителю в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den Brief vom Bewahrer der Schriften zu ihm, in die Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 기록 보관원의 편지를 가져가야 합니다.‡Llévale la carta del Guardián de los Pergaminos a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Llévale la carta del Guardián de los Pergaminos a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Rapportez cette lettre au gardien des registres, à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将名单登记员的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將名冊保管者的信交給在東瘟疫之地聖光之願禮拜堂的他。',
  }
},
[9248] = {
  {
    'Uma humilde oferenda‡Скромный подарок‡Eine bescheidene Darbringung‡겸손한 제안‡Una humilde ofrenda‡Una humilde ofrenda‡Une humble offrande‡谦卑的馈赠‡謙卑的提議',
    nil,
    'Aurel Folháurea, do Forte Cenariano, em Silithus, quer que você leve para ela 1 Cetro Abissal. Você também precisa ser Honrado pelo Círculo Cenariano.‡Принесите 1 скипетр бездны Аурель Золотой Лист из крепости Кенария в Силитусе. Требуется уважение со стороны Круга Кенария.‡Aurel Goldblatt auf Burg Cenarius in Silithus möchte, dass Ihr ihr 1 abyssisches Szepter bringt. Euer Ruf bei dem Zirkel des Cenarius muss außerdem wohlwollend sein.‡실리더스의 세나리온 요새에 있는 오렐 골드리프가 심연의 홀 1개를 가져다 달라고 했습니다. 또한 세나리온 의회로부터 우호적 평판을 얻어야 합니다.‡Aurel Hojaurea quiere que le lleves 1 cetro abisal al Fuerte Cenarion, en Silithus. También deben considerarte honorable con el Círculo Cenarion.‡Aurel Hojaurea quiere que le lleves 1 cetro abisal al Fuerte Cenarion, en Silithus. También deben considerarte honorable con el Círculo Cenarion.‡Aurel Feuilledor du Fort cénarien, en Silithus, veut que vous lui apportiez 1 Sceptre abyssal. Vous devez également être Honoré par le Cercle cénarien.‡将一根深渊节杖交给希利苏斯塞纳里奥要塞的奥蕾尔·金叶。你在塞纳里奥议会的声望必须达到尊敬。‡希利蘇斯塞納里奧城堡裡的奧莉爾·金葉要你帶給她1個深淵權杖。同時你必須在塞納里奧議會達到尊敬聲望值，才能完成這項任務。',
  }
},
[9249] = {
  {
    '‡40 купонов – пульт управления паровым танком‡40 Lose - Bauplan: Dampfpanzersteuerung‡상품권 40매 - 설계도: 통통 전차 조종기‡40 vales: esquema (mando de tonque de vapor)‡40 vales: esquema (mando de tonque de vapor)‡40 bons - Schéma : Commande de chariotte à vapeur‡40张奖券 - 高级奖品‡',
    nil,
    '‡Требования:‡Anforderungen:‡요구 조건:‡‡‡Conditions :‡‡',
  }
},
[9250] = {
  {
    'Cajado de Atiesh‡Основа Атиеша‡Grundstab von Atiesh‡아티쉬의 몸통‡Cuerpo de Atiesh‡Cuerpo de Atiesh‡La hampe d\'Atiesh‡埃提耶什之杖‡阿泰絲之杖的骨架',
    nil,
    'Encontre alguém que ajude você a recuperar as duas últimas peças e a livrar o cajado do mal.‡Найдите того, кто поможет отыскать недостающие части посоха и изгнать из него злого духа.‡Findet jemanden, der Euch dabei hilft, die letzten beiden Teile des Stabs zu finden und das Böse daraus zu vertreiben.‡지팡이의 나머지 두 부분을 되찾고 지팡이의 악마를 퇴치하도록 도와줄 자를 찾아야 합니다.‡Busca a alguien que te ayude a buscar las dos piezas del báculo que faltan y a exorcizar el bastón.‡Busca a alguien que te ayude a buscar las dos piezas del báculo que faltan y a exorcizar el bastón.‡Trouvez quelqu\'un pour vous aider à récupérer les deux dernières parties du bâton, et pour le débarrasser du mal qui l\'habite.‡看看有谁能帮你找到法杖的最后两个部分，并且净化邪恶的力量。‡找人一起幫你尋找法杖的最後2塊部位，並和你一同淨化杖中的魔鬼。',
  }
},
[9251] = {
  {
    '‡Атиеш, оскверненный посох‡Atiesh, der korrumpierte Hohestab‡아티쉬, 저주받은 지팡이‡Atiesh, el gran báculo maligno‡Atiesh, el gran báculo maligno‡Atiesh, le grand bâton souillé‡埃提耶什，被玷污的传说之杖‡阿泰絲，被污損的守護者之杖',
    nil,
    '‡Анахронос из Пещер Времени, что в Танарисе, просит вас принести ему навершие и основание Атиеша.‡Anachronos in den Höhlen der Zeit in Tanaris möchte den Stabkopf und -fuß von Atiesh.‡타나리스의 시간의 동굴에 있는 아나크로노스가 아티쉬의 지팡이 머리와 아티쉬의 밑동을 가져다 달라고 했습니다.‡Lleva la cabeza y la base del bastón de Atiesh a Anacronos a las Cavernas del Tiempo, en Tanaris.‡Lleva la cabeza y la base del bastón de Atiesh a Anacronos a las Cavernas del Tiempo, en Tanaris.‡Anachronos, aux Grottes du temps en Tanaris, veut la Tête d\'Atiesh et le Talon d\'Atiesh.‡塔纳利斯时光之穴的阿纳克洛斯要你找到埃提耶什的法杖顶部和埃提耶什的杖柄末端。‡',
  }
},
[9252] = {
  {
    'Defendendo a Vila de Brisabela‡Оборона деревни Легкий Ветерок‡Die Verteidigung von Morgenluft‡산들바람 마을 방어‡Defender la Aldea Brisa Pura‡Defender la Aldea Brisa Pura‡La défense de Brise-clémente‡保卫晴风村‡保衛晴風村',
    nil,
    'Mate 4 Espoliadores Pernapodre e 4 Vultos Negros. Em seguida, fale novamente com a Patrulheira Sareyn na Vila de Brisabela, que fica na Floresta do Canto Eterno.‡Убейте 4 гниющих мародеров и 4 темных призраков и вернитесь к следопыту Сарейн в деревню Легкий Ветерок, что в лесах Вечной Песни.‡Tötet 4 Moderknochenmarodeure und 4 dunkle Gespenster. Kehrt anschließend zu Waldläuferin Sareyn in Morgenluft im Immersangwald zurück.‡썩은다리 약탈자와 어둠의 망령을 각각 4마리씩 해치운 후 영원노래 숲의 산들바람 마을에 있는 순찰자 사레인에게 가야 합니다.‡Mata 4 merodeadores Carnepútrea y 4 espectros oscuros, y regresa junto a la forestal Sareyn en Aldea Brisa Pura, en el Bosque Canción Eterna.‡Mata 4 merodeadores Carnepútrea y 4 espectros oscuros, y regresa junto a la forestal Sareyn en Aldea Brisa Pura, en el Bosque Canción Eterna.‡Tuer 4 Maraudeurs moignons-pourris et 4 Sombres âmes en peine, puis retourner voir le forestier Sareyn au village de Brise-clémente dans le bois des Chants éternels.‡杀死4个腐肢劫掠者和4个黑暗怨灵，然后向永歌森林晴风村的游侠萨蕾恩复命。‡殺掉4個腐肢掠奪者、4個黑暗怨靈。然後回到遊俠塞瑞覆命，他在永歌森林的晴風村。',
  }
},
[9253] = {
  {
    'O guarda-runas Deryan‡Хранитель рун Дериан‡Runenwächter Deryan‡마법석 파수꾼 데리안‡El celador de las runas Deryan‡El celador de las runas Deryan‡Le garderune Deryan‡符文看守者德尔雅‡符文守護者德蘭',
    nil,
    'Fale com o Guarda-runas Deryan na Floresta do Canto Eterno, perto da fronteira com a Terra Fantasma.‡Поговорите с хранителем рун Дерианом в лесах Вечной Песни, близ границы с Призрачными землями.‡Sprecht mit Runenwächter Deryan im Immersangwald nahe der Grenze zu den Geisterlanden.‡영원노래 숲에서 유령의 땅 경계 근처에 있는 마법석 파수꾼 데리안과 대화해야 합니다.‡Habla con el celador de las runas Deryan en el Bosque Canción Eterna, cerca de la frontera con las Tierras Fantasma.‡Habla con el celador de las runas Deryan en el Bosque Canción Eterna, cerca de la frontera con las Tierras Fantasma.‡Parler au garderune Deryan, dans le bois des Chants éternels, près de la frontière des Terres fantômes.‡与永歌森林和幽魂之地交界处的符文看守者德尔雅谈一谈。‡與永歌森林的符文守護者德蘭談話，他在鬼魂之地邊界附近。',
  }
},
[9254] = {
  {
    'A aprendiz desobediente‡Упрямая ученица‡Der eigensinnige Lehrling‡고집불통 수습생‡El aprendiz de díscolo‡El aprendiz de díscolo‡L\'apprentie égarée‡外出的学徒‡遊蕩者學徒',
    nil,
    'Fale com a Aprendiz Mirveda no Sacrário do Leste, que fica na Floresta do Canto Eterno.‡Поговорите с ученицей Мирведой в Восточном святилище в лесах Вечной Песни.‡Sprecht mit Lehrling Mirveda beim Sanktum des Ostens im Immersangwald.‡영원노래 숲의 동부 성소에 있는 수습생 미르베다와 대화해야 합니다.‡Habla con la aprendiza Mirveda en el Sagrario del Este, en el Bosque Canción Eterna.‡Habla con la aprendiza Mirveda en el Sagrario del Este, en el Bosque Canción Eterna.‡Parler à l\'apprentie Mirveda au Sanctum oriental dans le bois des Chants éternels.‡与永歌森林东部圣殿的学徒米尔维达谈一谈。‡與東部聖所的學徒莫維達談話，位置在永歌森林。',
  }
},
[9255] = {
  {
    'Anotações de Pesquisa‡Исследовательские записи‡Forschungsnotizen‡연구 일지‡Notas de investigación‡Notas de investigación‡Les notes de recherche‡研究笔记‡研究報告',
    nil,
    'Entregue as Anotações de Pesquisa à Magistra Landra Albatrilha na Vila de Brisabela, que fica na Floresta do Canto Eterno.‡Доставьте исследовательские записи магистру Ландре Рассветной Страннице в деревню Легкий Ветерок, что в лесах Вечной Песни.‡Bringt die Forschungsnotizen zu Magistrix Landra Morgenwandler in Morgenluft im Immersangwald.‡영원노래 숲의 산들바람 마을에 있는 마법학자 란드라 돈스트라이더에게 연구 일지를 전달해야 합니다.‡Llévale las notas de la investigación a la magistrix Landra Caminalba en la Aldea Brisa Pura, en el Bosque Canción Eterna.‡Llévale las notas de la investigación a la magistrix Landra Caminalba en la Aldea Brisa Pura, en el Bosque Canción Eterna.‡Apporter les Notes de recherche à la magistrice Landra Aube-glorieuse au village de Brise-clémente, dans le bois des Chants éternels.‡将研究笔记交给永歌森林晴风村的魔导师兰德拉·晨行者。‡把研究報告帶到永歌森林交給晴風村的博學者蘭德拉·晨行者。',
  }
},
[9256] = {
  {
    'A Vila de Brisabela‡Деревня Легкий Ветерок‡Morgenluft‡산들바람 마을‡La Aldea Brisa Pura‡La Aldea Brisa Pura‡Le village de Brise-clémente‡晴风村‡晴風村',
    nil,
    'Fale com o Patrulheiro Degolien na Vila de Brisabela, que fica na Floresta do Canto Eterno.‡Поговорите со следопытом Деголиеном в деревне Легкий Ветерок в лесах Вечной Песни.‡Sprecht mit Waldläufer Degolien in Morgenluft im Immersangwald.‡영원노래 숲의 산들바람 마을에 있는 순찰자 데골리엔과 대화해야 합니다.‡Habla con el forestal Degolien en la Aldea Brisa Pura, en el Bosque Canción Eterna.‡Habla con el forestal Degolien en la Aldea Brisa Pura, en el Bosque Canción Eterna.‡Parler au forestier Degolien, au village de Brise-clémente, dans le bois des Chants éternels.‡与永歌森林晴风村的游侠戴戈利恩谈一谈。‡到永歌森林與晴風村的遊俠迪哥里恩談話。',
  }
},
[9257] = {
  {
    '‡Атиеш, большой посох Стража‡‡아티쉬 - 수호자의 지팡이‡Atiesh, gran báculo del Guardián‡Atiesh, gran báculo del Guardián‡Atiesh, grand bâton du Gardien‡埃提耶什，守护者的传说之杖‡阿泰絲，守護者之杖',
    nil,
    '‡Анахронос из Пещер Времени, что в Танарисе, просит вас отнести Атиеш, большой посох Стража, в Стратхольм и установить его на освященную землю. Одолейте силу, которая исторгнется из посоха, и вернитесь к Анахроносу.‡Anachronos in den Höhlen der Zeit in Tanaris möchte, dass Ihr Atiesh, den Hohestab des Wächters, nach Stratholme bringt und dort auf dem geheiligten Boden platziert. Bezwingt das Wesen, das aus dem Stab getrieben wurde, und kehrt danach wieder zu ihm zurück.‡‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, el gran báculo del guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, el gran báculo del guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anachronos, aux Grottes du temps en Tanaris, veut que vous emportiez Atiesh, le grand bâton du Gardien, à Stratholme et que vous le placiez sur la Terre consacrée. Abattez l\'entité qui sera extraite du bâton et retournez le voir.‡塔纳利斯时光之穴的安纳克罗斯要你带着阿泰丝,守护者之杖前往斯坦索姆，在圣化之地上使用它。击败从法杖内被驱除的生物再回去找他。‡',
  }
},
[9258] = {
  {
    'Mata Queimada‡Выжженная роща‡Der Versengte Hain‡불타버린 숲‡La Arboleda Agostada‡La Arboleda Agostada‡Le bosquet incendié‡焦痕谷‡烈焰邊境',
    nil,
    'Encontre Larianna Fluminéola perto da Mata Queimada a sudoeste da Floresta do Canto Eterno.‡Найдите Ларианну Речной Ветер вблизи Выжженной рощи на юго-западе лесов Вечной Песни.‡Findet Larianna Flusswind nahe des Versengten Hains, südwestlich des Immersangwalds.‡영원노래 숲 남서쪽의 불타버린 숲 근처에 있는 라리아나 리버윈드를 찾아야 합니다.‡Encuentra a Larianna Ríobrisa cerca de La Arboleda Agostada al suroeste del Bosque Canción Eterna.‡Encuentra a Larianna Ríobrisa cerca de La Arboleda Agostada al suroeste del Bosque Canción Eterna.‡Trouver Larianna Ruissevent près du Bosquet incendié, au sud-ouest du bois des Chants éternels.‡前往永歌森林西南方的焦痕谷寻找拉莉亚娜·河风。‡去烈焰邊境附近找拉瑞安娜·河風，位置就在永歌森林的西南方。',
  }
},
[9259] = {
  {
    'Um duas-caras na Vela Sangrenta‡Предатель Кровавого Паруса‡Verrat am Blutsegel‡붉은 해적단의 배신자‡Un traidor de Velasangre‡Un traidor de Velasangre‡Un traître envers la Voile sanglante‡血帆海盗的叛徒‡血帆的叛徒',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[9260] = {
  {
    'Investigação do Flagelo em Ventobravo‡Что делает Плеть в Штормграде?‡Erforscht die Geißel von Sturmwind‡스톰윈드의 마법진 조사‡Investigar la Plaga de Ventormenta‡Investigar la Plaga de Ventormenta‡Enquêter au sujet du Fléau à Hurlevent‡调查暴风城的天灾入侵‡調查暴風城的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno de Ventobravo e investigue os círculos rúnicos perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить собравшаяся у Штормграда, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Beschafft Euch drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Sturmwind und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡스톰윈드 외곽에 있는 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모으고, 스컬지 요새 근처에서 빛나는 룬문자 마법진을 조사해야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Ventormenta e investiga los círculos rúnicos que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Ventormenta e investiga los círculos rúnicos que hay cerca de su campamento.‡Se procurer trois Pierres nécrotiques pâles du Fléau à l\'extérieur de Hurlevent et enquêter au sujet des cercles runiques lumineux près du campement.‡从暴风城外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從暴風城外的天譴軍團身上收集三個暗淡的亡域之石並調查它們營地附近發光的符文法陣。',
  }
},
[9261] = {
  {
    'Investigação do Flagelo em Altaforja‡Что делает Плеть в Стальгорне?‡Erforscht die Geißel von Eisenschmiede‡아이언포지의 마법진 조사‡Investigar la Plaga de Forjaz‡Investigar la Plaga de Forjaz‡Enquêter au sujet du Fléau à Forgefer‡调查铁炉堡的天灾入侵‡調查鐵爐堡的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno de Altaforja e investigue os círculos rúnicos perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить, откружившая Стальгорн, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Beschafft Euch drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Eisenschmiede und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡아이언포지 밖에 있는 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모으고, 스컬지 요새 근처에서 빛나는 룬문자 마법진을 조사해야 합니다‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Forjaz e investiga los círculos rúnicos que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Forjaz e investiga los círculos rúnicos que hay cerca de su campamento.‡Se procurer trois Pierres nécrotiques pâles du Fléau à l\'extérieur de Forgefer et enquêter au sujet des cercles runiques lumineux près du campement.‡从铁炉堡外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從鐵爐堡外的天譴軍團身上收集三個暗淡的亡域之石並調查它們營地附近發光的符文法陣。',
  }
},
[9262] = {
  {
    'Investigação do Flagelo em Darnassus‡Что делает Плеть в Дарнасе?‡Erforscht die Geißel von Darnassus‡다르나서스의 마법진 조사‡Investigar la Plaga de Darnassus‡Investigar la Plaga de Darnassus‡Enquêter au sujet du Fléau à Darnassus‡调查达纳苏斯的天灾入侵‡調查達納蘇斯的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno de Darnassus e investigue os círculos rúnicos brilhantes perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить, откружившая Дарнас, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Beschafft Euch drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Darnassus und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡다르나서스 외곽에 있는 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모으고, 스컬지 야영지 근처에서 빛나는 룬문자 마법진을 조사해야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Darnassus e investiga los círculos rúnicos que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Darnassus e investiga los círculos rúnicos que hay cerca de su campamento.‡Se procurer trois Pierres nécrotiques pâles du Fléau à l\'extérieur de Darnassus et enquêter au sujet des cercles runiques lumineux près du campement.‡从达纳苏斯外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從達納蘇斯外的天譴軍團身上收集三個暗淡的亡域之石並調查它們營地附近發光的符文法陣。',
  }
},
[9263] = {
  {
    'Investigação do Flagelo em Orgrimmar‡Что делает Плеть в Оргриммаре?‡Erforscht die Geißel von Orgrimmar‡오그리마의 스컬지 조사‡Investigar la Plaga en Orgrimmar‡Investigar la Plaga en Orgrimmar‡Enquêter au sujet du Fléau à Orgrimmar‡调查奥格瑞玛的天灾入侵‡調查奧格瑪的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno de Orgrimmar e investigue os círculos rúnicos perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить, окружившая Оргриммар, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Beschafft Euch drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Orgrimmar und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡오그리마 바깥의 스컬지 요새 근처에서 빛나는 마법진을 조사해야 합니다. 그리고 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모아야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Orgrimmar e investiga los círculos rúnicos que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Orgrimmar e investiga los círculos rúnicos que hay cerca de su campamento.‡Se procurer trois Pierres nécrotiques pâles du Fléau à l\'extérieur d\'Orgrimmar et enquêter au sujet des cercles runiques lumineux près du campement.‡从奥格瑞玛外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從奧格瑪外的天譴軍團身上收集三個暗淡的亡域之石並調查它們營地附近發光的符文法陣。',
  }
},
[9264] = {
  {
    'Investigação do Flagelo no Penhasco do Trovão‡Что делает Плеть в Громовом Утесе?‡Erforscht die Geißel von Donnerfels‡썬더 블러프의 스컬지 조사‡Investigar la Plaga en Cima del Trueno‡Investigar la Plaga en Cima del Trueno‡Enquêter au sujet du Fléau aux Pitons-du-Tonnerre‡调查雷霆崖的天灾入侵‡調查雷霆崖的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno do Penhasco do Trovão e investigue os círculos rúnicos perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить, откружившая Громовой утес, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Beschafft Euch drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Donnerfels und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡썬더 블러프 바깥의 스컬지 요새 근처에서 빛나는 마법진을 조사해야 합니다. 그리고 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모아야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Cima del Trueno e investiga los círculos rúnicos que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Cima del Trueno e investiga los círculos rúnicos que hay cerca de su campamento.‡Se procurer trois Pierres nécrotiques pâles du Fléau à l\'extérieur des Pitons-du-Tonnerre et enquêter au sujet des cercles runiques lumineux près du campement.‡从雷霆崖外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從雷霆崖外的天譴軍團身上收集三個暗淡的亡域之石並調查它們營地附近發光的符文法陣。',
  }
},
[9265] = {
  {
    'Investigação do Flagelo na Cidade Baixa‡Что делает Плеть в Подгороде?‡Erforscht die Geißel von Unterstadt‡언더시티의 스컬지 조사‡Investigar la Plaga en Entrañas‡Investigar la Plaga en Entrañas‡Enquêter au sujet du Fléau à Fossoyeuse‡调查幽暗城的天灾入侵‡調查幽暗城的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo do lado de fora da Cidade Baixa e investigue os círculos rúnicos perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить, откружившая Подгород, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Beschafft Euch drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Unterstadt und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡언더시티 바깥의 스컬지 요새 근처에서 빛나는 마법진을 조사해야 합니다. 그리고 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모아야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Entrañas e investiga los círculos rúnicos que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Entrañas e investiga los círculos rúnicos que hay cerca de su campamento.‡Se procurer trois Pierres nécrotiques pâles du Fléau à l\'extérieur de Fossoyeuse et enquêter au sujet des cercles runiques lumineux près du campement.‡从幽暗城外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從幽暗城外的天譴軍團身上收集三個暗淡的亡域之石並調查它們營地附近發光的符文法陣。',
  }
},
