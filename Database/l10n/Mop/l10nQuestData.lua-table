[31293] = {
  {
    'Ou acabamos com eles, ou acabamos com eles‡Могу – плохие гости‡Mogu keine guten Gäste‡‡Los mogu no son buenos anfitriones‡‡Les mogu font de piètres invités‡不速之客‡',
    nil,
    'Mate 8 atacantes Shao-Tien na Vila do Cair da Bruma. Uma‡Убейте 8 налетчиков шадо-тянь в деревне Туманного Водопада.‡Tötet 8 Shao-Tien-Angreifer in Nebelhauch.‡‡Mata a 8 atacantes Shao-Tien en la Aldea Bruma Otoñal.‡‡Tuez 8 Attaquants shao-tien à Tombe-brume.‡在雾临村击败8个韶天攻击者。‡',
  }
},
[31294] = {
  {
    'As Ruínas de Guo-Lai‡Руины Го-Лай‡Die Guo-Lai-Ruinen‡‡Las Ruinas de Guo-Lai‡‡Les ruines de Guo-Lai‡‡',
    nil,
    'Fale com Anji Luz do Outono nas Ruínas de Guo-Lai. Uma‡Поговорите с Аньцзи Осенний Свет на руинах Го-Лай.‡Sprecht mit Anji Herbstlicht bei den Guo-Lai-Ruinen.‡‡Habla con Angi Fulgor Otoñal en las Ruinas de Guo-Lai.‡‡Parlez à Anji Clair d’Automne aux Ruines de Guo-Lai.‡‡',
  }
},
[31295] = {
  {
    'Mogus nas Ruínas de Guo-Lai‡Могу внутри руин Го-Лай‡Mogu in den Guo-Lai-Ruinen‡‡Mogu en las Ruinas de Guo-Lai‡‡Les mogu des ruines de Guo-Lai‡郭莱遗迹里的魔古族‡',
    nil,
    'Fale com Leven Lâmina da Manhã nas Ruínas de Guo-Lai. Uma‡Поговорите c Левеном Рассветным Клинком у руин Го-Лай.‡Sprecht mit Leven Morgenklinge in den Guo-Lai-Ruinen.‡‡Habla con Leven Hoja Clara en las Ruinas de Guo-Lai.‡‡Parlez à Leven Lame de l’Aube aux Ruines de Guo-Lai.‡和郭莱遗迹的莱文·晨刃谈一谈。‡',
  }
},
[31296] = {
  {
    'As Ruínas de Guo-Lai‡Руины Го-Лай‡Die Guo-Lai-Ruinen‡‡Las Ruinas de Guo-Lai‡‡Les ruines de Guo-Lai‡‡',
    nil,
    'Fale com Anji Luz do Outono nas Ruínas de Guo-Lai. Uma‡Поговорите с Аньцзи Осенний Свет на руинах Го-Лай.‡Sprecht mit Anji Herbstlicht bei den Guo-Lai-Ruinen.‡‡Habla con Anji Fulgor Otoñal en las Ruinas de Guo-Lai.‡‡Parlez à Anji Clair d’Automne aux Ruines de Guo-Lai.‡‡',
  }
},
[31297] = {
  {
    'Guarnição do Sol Poente‡Гарнизон Заходящего Солнца‡Die Garnison der Untergehenden Sonne‡‡Baluarte del Sol Poniente‡‡La garnison du Soleil couchant‡残阳关卫戍营‡',
    nil,
    'Fale com Anji Luz Outonal no Campo de Treinamento do Sol Poente. Uma‡Поговорить с Аньцзи Осенний Свет в Гарнизоне Заходящего Солнца.‡Sprecht mit Anji Herbstlicht im Ausbildungslager der Untergehenden Sonne.‡‡Habla con Anji Fulgor Otoñal en el Baluarte del Sol Poniente.‡‡Parlez à Anji Clair d’Automne au Camp d’entraînement du Soleil couchant.‡和残阳关卫戍营的安济·秋光谈一谈。‡',
  }
},
