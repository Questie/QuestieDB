[11035] = {
  {
    'Viaje não-tão-bem-assim...‡Недружелюбные небеса‡Ein Schatten am Horizont‡하늘과 땅의 대립‡Los cielos no tan amistosos...‡Los cielos no tan amistosos...‡Les cieux pas si cléments...‡危险的天空‡不太友善的航線……',
    nil,
    'Yarzill, o Mercenário, no Campo-base Presa do Dragão do Vale da Lua Negra, quer que você recupere 10 Relíquias da Asa Etérea.‡Верните Язриллу Наемнику в лагере Драконьей Пасти в долине Призрачной Луны 10 реликвий Крыльев Пустоты.‡Yarzill der Söldner beim Basislager des Drachenmals im Schattenmondtal möchte, dass Ihr 10 Relikte der Netherschwingen sicherstellt.‡어둠달 골짜기의 용아귀 주둔지에 있는 용병 야르질이 황천날개 유물 10점을 가져다 달라고 했습니다.‡Yarzill el Condotiero del Campamento Faucedraco en el Valle Sombraluna quiere que recuperes 10 reliquias de Ala Abisal.‡Yarzill el Condotiero del Campamento Faucedraco en el Valle Sombraluna quiere que recuperes 10 reliquias de Ala Abisal.‡Yarzill le Mercenaire du Campement des Gueules-de-dragon de la Vallée d\'Ombrelune veut que vous récupériez 10 Reliques de l\'Aile-du-Néant.‡将10件灵翼圣物交给影月谷龙喉营地的雇佣兵亚兹尔。‡影月谷裡龍喉營地的商人亞吉歐要你取得10個虛空之翼聖物。',
  }
},
[11036] = {
  {
    'Um fruto do outro mundo!‡Еще один пункт долой!‡Außerirdische Früchte!‡최고급 과일!‡¡Un producto de fuera de este mundo!‡¡Un producto de fuera de este mundo!‡Marchandise extraordinaire !‡食物储备！‡絕無僅有的產品!',
    nil,
    'Leve as Frutas Secas para Mestre-fogueteiro Fuselagem na Área 52, em Eternévoa.‡Доставьте консервированные фрукты командующему ракетами Фюзеляжу в Зону 52 Пустоверти.‡Bringt die konservierten Früchte zu Raketenchef Doppeldecker in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 잘 보존된 과일을 가져가야 합니다.‡Llévale la fruta en conserva al jefe de cohetes Fuselaje al Área 52, en Tormenta Abisal.‡Llévale la fruta en conserva al jefe de cohetes Fuselaje al Área 52, en Tormenta Abisal.‡Apportez les Fruits en conserve au Chef-de-fusée Karlingue dans la Zone 52, à Raz-de-Néant.‡将这箱果脯交给虚空风暴52区的火箭主管弗斯拉格。‡到虛空風暴的52區，把罐頭水果交給火箭主管夫斯拉吉。',
  }
},
[11037] = {
  {
    'Uma visão estranha‡Странное видение‡Eine seltsame Vision‡낯선 환영‡Una extraña visión‡Una extraña visión‡Une vision étrange‡奇怪的幻象‡奇怪的景象',
    nil,
    'Fale com o Mestre-fogueteiro Fuselagem na Área 52.‡Поговорите с ведущим ракетостроителем Фьюзеляжем в Зоне 52.‡Sprecht mit Raketenchef Doppeldecker in Area 52.‡52번 구역에 있는 로켓발사단장 퓨즐라지와 대화해야 합니다.‡Habla con el jefe de cohetes Fuselaje en el Área 52.‡Habla con el jefe de cohetes Fuselaje en el Área 52.‡Parlez au Chef-de-fusée Karlingue dans la Zone 52.‡与52区的火箭主管弗斯拉格谈一谈。‡跟52區的火箭主管夫斯拉吉談話。',
  }
},
[11038] = {
  {
    'Ajude o Exarca Orelis‡Помощь экзарху Орелису‡Unterstützung für Exarch Orelis‡총독 오렐리스 지원‡Ayuda al exarca Orelis‡Ayuda al exarca Orelis‡Aider l\'exarque Orelis‡协助大主教欧雷里斯‡協助主教歐瑞利斯',
    nil,
    'Fale com o Exarca Orelis, na Área 52.‡Поговорите с экзархом Орелисом в Зоне 52.‡Sprecht mit Exarch Orelis in Area 52.‡52번 구역으로 가서 총독 오렐리스와 대화해야 합니다.‡Habla con el exarca Orelis en el Área 52.‡Habla con el exarca Orelis en el Área 52.‡Parlez à l\'Exarque Orelis dans la Zone 52.‡与52区的大主教欧雷里斯谈一谈。‡跟52區的主教歐瑞利斯談話。',
  }
},
[11039] = {
  {
    'Apresente-se ao Mestre Espião Thalodien‡Отчет патрону шпионов Талодиену‡Meldung bei Spionagemeister Thalodien‡첩보단장 탈로디엔에게 보고‡Informa al maestro de espías Thalodien‡Informa al maestro de espías Thalodien‡Se présenter au maître-espion Thalodien‡向间谍大师萨罗迪恩报到‡向間諜大師薩洛迪恩報到',
    nil,
    'Apresente-se ao Mestre Espião Thalodien, na Área 52.‡Доложитесь патрону шпионов Талодиену в Зоне 52.‡Meldet Euch bei Spionagemeister Thalodien in Area 52.‡52번 구역에 있는 첩보단장 탈로디엔에게 보고해야 합니다.‡Preséntate ante el maestro de espías Thalodien en el Área 52.‡Preséntate ante el maestro de espías Thalodien en el Área 52.‡Présentez-vous au Maître-espion Thalodien dans la Zone 52.‡向52区的间谍大师萨罗迪恩报到。‡向52區的間諜大師薩洛迪恩報到。',
  }
},
[11040] = {
  {
    'Peças para o mestre-fogueteiro‡Детали для ведущего ракетостроителя‡Ersatzteile für den Raketenchef‡로켓발사단장을 위한 부품‡Piezas para el jefe de cohetes‡Piezas para el jefe de cohetes‡Des pièces détachées pour le chef-de-fusée‡给火箭主管的零件‡火箭主管的零件',
    nil,
    'Leve as peças sobressalentes da Mandonna para o Mestre-fogueteiro Fuselagem na Área 52, que fica em Eternévoa.‡Доставьте запчасти Босси командующему ракетами Фюзеляжу в Зону 52 Пустоверти.‡Bringt Bossis Ersatzteile zu Raketenchef Doppeldecker nach Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역의 로켓발사단장 퓨즐라지에게 보시의 예비 부품을 가져가야 합니다.‡Llévale las piezas que le sobran a Bossi al jefe de cohetes Fuselaje al Área 52, en Tormenta Abisal.‡Llévale las piezas que le sobran a Bossi al jefe de cohetes Fuselaje al Área 52, en Tormenta Abisal.‡Apportez les Pièces détachées de Bossi au Chef-de-fusée Karlingue dans la Zone 52, à Raz-de-Néant.‡将波希的备用零件交给虚空风暴52区的火箭主管弗斯拉格。‡到虛空風暴的52區，把波西的備用零件帶給火箭主管夫斯拉吉。',
  }
},
[11041] = {
  {
    'Serviço deixado pela metade...‡Неоконченное дело‡Eine unerledigte Aufgabe...‡끝나지 않은 임무...‡Un trabajo sin terminar...‡Un trabajo sin terminar...‡Un travail à terminer...‡未完的工作......‡未完成的工作……',
    nil,
    'Mate 10 Rancapeles de Minacima e a Matriarca do Covil Barash. Fale com o Suserano Mor\'ghor, do Campo-base Presa do Dragão no Vale da Lua Negra, caso tenha sucesso.‡Убейте 10 надземных живодеров и Бараш Мать Стаи. По выполнении вернитесь к властителю Мор\'гору в лагерь Драконьей Пасти.‡Tötet 10 Felslandschinder und Barash die Höhlenmutter. Kehrt nach erfolgreicher Erledigung zu Oberanführer Mor\'ghor beim Basislager des Drachenmals zurück.‡땅굴수정 바위갈퀴 10마리와 여왕 바위갈퀴 바라쉬를 처치한 후, 어둠달 골짜기의 용아귀 주둔지에 있는 대군주 모르고르에게 임무 완수를 보고해야 합니다.‡Mata 10 despellejadores sobremina y a Barash la madre de El Cubil. Si tienes éxito, regresa a donde Mor\'ghor al Campamento Faucedraco.‡Mata 10 despellejadores sobremina y a Barash, la madre del cubil. Si tienes éxito, regresa a donde Mor\'ghor al Campamento Faucedraco.‡Tuez 10 Écorcheurs Supremine et Barash la Mère de la tanière. Revenez voir le Suzerain Mor\'ghor au Campement des Gueules-de-dragon si vous réussissez.‡杀死10只灵翼矿洞剥石者和母兽巴莱什。完成任务后向龙喉营地的莫格霍尔大王复命。‡殺死10個礦坑鐮奪怪和『獸穴之母』芭拉什。成功後回到龍喉營地找霸主莫格。',
  }
},
[11042] = {
  {
    'Uma visão mistificadora‡Таинственное видение‡Eine verblüffende Vision‡혼란스러운 환영‡Una visión mistificadora‡Una visión mistificadora‡Une vision mystique‡神秘的幻象‡令人困惑的幻象',
    nil,
    'Fale com o Mestre-fogueteiro Fuselagem na Área 52.‡Поговорите с ведущим ракетостроителем Фьюзеляжем в Зоне 52.‡Sprecht mit Raketenchef Doppeldecker in Area 52.‡52번 구역에 있는 로켓발사단장 퓨즐라지와 대화해야 합니다.‡Habla con el jefe de cohetes Fuselaje en el Área 52.‡Habla con el jefe de cohetes Fuselaje en el Área 52.‡Parlez au Chef-de-fusée Karlingue dans la Zone 52.‡与52区的火箭主管弗斯拉格谈一谈。‡跟52區的火箭主管夫斯拉吉談話。',
  }
},
[11043] = {
  {
    'Por um grifo melhor‡Усовершенствованный грифон‡Ein besserer Greif‡더 강한 그리핀 훈련‡Crear un grifo mejor‡Crear un grifo mejor‡Le griffon de l\'avenir‡更好的狮鹫‡更好的獅鷲獸',
    nil,
    'Fale com Bruno Barbachama na Fortaleza Martelo Feroz, que fica no Vale da Lua Negra.‡Поговорите с Брюнном Жаробородом в Цитадели Громового Молота в Долине Призрачной Луны.‡Sprecht mit Brunn Flammenbart in der Wildhammerfeste im Schattenmondtal.‡어둠달 골짜기의 와일드해머 성채에 있는 브룬 플레임비어드와 대화해야 합니다.‡Habla con Brunn Barballamas en el Bastión Martillo Salvaje, en el Valle de Sombraluna.‡Habla con Brunn Barballamas en el Bastión Martillo Salvaje, en el Valle de Sombraluna.‡Parlez à Brunn Flammebarbe au Bastion des Marteaux-hardis, dans la Vallée d\'Ombrelune.‡与影月谷蛮锤要塞的拉瑟尔·火须谈一谈。‡到影月谷的蠻錘要塞找布朗恩·焰鬚談話。',
  }
},
[11044] = {
  {
    'Visões da destruição‡Страшные видения‡Visionen voller Zerstörung‡파괴의 환영‡Visiones de destrucción‡Visiones de destrucción‡Visions d\'anéantissement‡灾难的幻象‡夢境中的災難',
    nil,
    'Fale com o Comandante de Ala Nuainn, na Fortaleza Martelo Feroz.‡Поговорите с командиром звена Нуаинном в цитадели Громового Молота.‡Sprecht mit Schwadronskommandant Nuainn in der Wildhammerfeste.‡와일드해머 성채에 있는 편대사령관 누아인과 대화해야 합니다.‡Habla con el comandante del aire Nuainn en el Bastión Martillo Salvaje.‡Habla con el comandante del aire Nuainn en el Bastión Martillo Salvaje.‡Parlez au Chef d\'escadrille Nuainn au Bastion des Marteaux-hardis.‡与蛮锤要塞的空军指挥官努埃恩谈一谈。‡跟蠻錘要塞的空軍指揮官奴艾恩談話。',
  }
},
[11045] = {
  {
    'Zorus, o Judicante‡Зорус Ревнитель‡Zorus der Richter‡심판관 조러스‡Zorus el Justiciero‡Zorus el Justiciero‡Zorus le Judicateur‡仲裁者索鲁斯‡『執法官』索羅斯',
    nil,
    'Fale com Zorus, o Judicante, na Fortaleza Martelo Feroz.‡Поговорите с Зорусом Ревнителем в цитадели Громового Молота.‡Sprecht mit Zorus dem Richter in der Wildhammerfeste.‡와일드해머 성채에 있는 심판관 조러스와 대화해야 합니다.‡Habla con Zorus el Justiciero en el Bastión Martillo Salvaje.‡Habla con Zorus el Justiciero en el Bastión Martillo Salvaje.‡Parlez à Zorus le Judicateur au Bastion des Marteaux-hardis.‡与蛮锤要塞的仲裁者索鲁斯谈一谈。‡和蠻錘要塞的『執法官』索羅斯談談。',
  }
},
[11046] = {
  {
    'Boticária-chefe Hildagard‡Главный аптекарь Хильдегард‡Chefapothekerin Hildagard‡수석 연금술사 힐다가드‡Boticaria jefe Hildagard‡Boticaria jefe Hildagard‡L\'apothicaire en chef Hildagard‡主药剂师希尔达迦‡總藥劑師希爾達嘉',
    nil,
    'Fale com a Boticária-chefe Hildagard na Aldeia Lua Negra.‡Поговорите с главным аптекарем Хильдегард в деревне Призрачной Луны.‡Sprecht mit Chefapothekerin Hildagard in Schattenmond.‡어둠달 마을에 있는 수석 연금술사 힐다가드와 대화해야 합니다.‡Habla con la boticaria jefe Hildagard en la Aldea Sombraluna.‡Habla con la boticaria jefe Hildagard en la Aldea Sombraluna.‡Parlez à l\'Apothicaire en chef Hildagard au village d\'Ombrelune.‡与影月村的主药剂师希尔达迦谈一谈。‡跟影月村的總藥劑師希爾達嘉談話。',
  }
},
[11047] = {
  {
    'O pedido do aprendiz‡Просьба ученика‡Die Bitte des Gesellen‡수습조련사의 요청‡La petición del aprendiz‡La petición del aprendiz‡La requête de l\'apprenti‡学徒的请求‡學徒的請求',
    nil,
    'Fale com Dara Juba Agreste na Aldeia Lua Negra, que fica no Vale da Lua Negra.‡Поговорите с Дамой Буйногривой в Деревне Призрачной Луны, что находится в Долине Призрачной Луны.‡Sprecht mit Dama Wildmähne im Dorf Schattenmond im Schattenmondtal.‡어둠달 골짜기의 어둠달 마을에 있는 다마 와일드메인과 대화해야 합니다.‡Habla con Dama Ferocrín en la Aldea Sombraluna, en el Valle de Sombraluna.‡Habla con Dama Ferocrín en la Aldea Sombraluna, en el Valle de Sombraluna.‡Parlez à Dama Crin-sauvage au village d\'Ombrelune, dans la Vallée d\'Ombrelune.‡与影月谷影月村的达玛·蛮鬃谈一谈。‡到影月谷的影月村找達瑪·蠻鬃談話。',
  }
},
[11048] = {
  {
    'Relatório de Kroghan‡Рапорт Крогхана‡Kroghans Bericht‡크로그한의 보고‡El informe de Kroghan‡El informe de Kroghan‡Le rapport de Kroghan‡克洛坎的报告‡卡洛克汗的報告',
    nil,
    'Fale com o Guarda-de-Sangue Gulmok na Aldeia Lua Negra.‡Объясните кровавому стражу Галмоку в деревне Призрачной Луны, почему Крогхан не может явиться к нему.‡Sprecht mit Blutwache Gulmok im Dorf Schattenmond.‡어둠달 마을에 있는 혈투사 굴모크와 대화해야 합니다.‡Habla con el Guardia de sangre Gulmok en la Aldea Sombraluna.‡Habla con el Guardia de sangre Gulmok en la Aldea Sombraluna.‡Parlez au Garde de sang Gulmok au village d\'Ombrelune.‡与影月村的血卫士古尔穆克谈一谈。‡跟影月村的血衛士高莫克談話。',
  }
},
[11049] = {
  {
    'A grande caçada de ovos da Asa Etérea‡Большая Охота‡Die große Eierjagd‡좋은 황천날개 알 수집‡La gran búsqueda de huevos de Ala Abisal‡La gran búsqueda de huevos de Ala Abisal‡La ruée vers les œufs de l\'Aile-du-Néant‡寻找灵翼龙卵‡虛空之翼獵蛋行動',
    nil,
    'Yarzill, o Mercenário, no Campo-base Presa do Dragão do Vale da Lua Negra, quer que você recupere um Ovo da Asa Etérea.‡Найдите яйцо дракона Крыльев Пустоты для Язрилла Наемника, находящегося в лагере Драконьей Пасти, что в долине Призрачной Луны.‡Yarzill der Söldner beim Basislager des Drachenmals im Schattenmondtal möchte, dass Ihr ein Ei der Netherschwingen einsammelt.‡어둠달 골짜기에 용아귀 주둔지에 있는 용병 야르질이 황천날개 알을 가져다 달라고 했습니다.‡Yarzill el Condotiero en el Campamento Faucedraco en el Valle Sombraluna quiere que recuperes un huevo de Ala Abisal.‡Yarzill el Condotiero en el Campamento Faucedraco en el Valle Sombraluna quiere que recuperes un huevo de Ala Abisal.‡Yarzill le Mercenaire, du campement des Gueules-de-dragon dans la vallée d\'Ombrelune, veut que vous vous procuriez un Œuf de l\'Aile-du-Néant.‡将一枚灵翼龙卵交给影月谷龙喉营地的雇佣兵亚兹尔。‡影月谷，龍喉營地的商人亞吉歐要你取得一顆虛空之翼蛋。',
  }
},
[11050] = {
  {
    'Aceitamos todos os ovos‡Собрать их все!‡Immer her mit den Eiern‡황천날개 알 추가 수집‡Aceptar todos los huevos‡Aceptar todos los huevos‡Tous les œufs sont bons à prendre‡所有的龙卵‡接受所有的蛋',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[11051] = {
  {
    'Expulse mais demônios‡Демонов – долой!‡Bannt mehr Dämonen‡더 많은 악마 추방‡Destierra más demonios‡Destierra más demonios‡Bannissez plus de démons‡放逐更多恶魔‡放逐更多惡魔',
    nil,
    'Use o Cristal de Banimento para banir 15 demônios em Campo-forja: Ira ou Campo-forja: Terror.‡При помощи кристалла изгоните 15 демонов из Лагеря Легиона: Гнев или Ужас в Острогорье.‡Setzt den Bannkristall ein, um 15 Dämonen beim Konstruktionslager: Wut oder Konstruktionslager: Terror zu bannen.‡공포의 괴철로 기지나 격노의 괴철로 기지에 있는 15마리의 악마들에게 추방의 수정을 사용해야 합니다.‡Usa el cristal desterrador para desterrar a 15 demonios en el Campamento Forja: Cólera o en el Campamento Forja: Terror.‡Usa el cristal desterrador para desterrar a 15 demonios en el Campamento Forja: Cólera o en el Campamento Forja: Terror.‡Utilisez le Cristal de bannissement pour bannir 15 démons au Camp de forge : Courroux ou au Camp de forge : Terreur.‡前往刀锋山的铸魔营地：天罚或是铸魔营地：恐怖，利用放逐水晶放逐15个恶魔。‡使用驅逐水晶來放逐劍刃山脈上煉冶場:憤怒或煉冶場:驚駭中15個惡魔。',
  }
},
[11052] = {
  {
    'A promessa de Akama‡Обещание Акамы‡Akamas Versprechen‡아카마의 약속‡La promesa de Akama‡La promesa de Akama‡La promesse d\'Akama‡阿卡玛的保证‡阿卡瑪的承諾',
    nil,
    'Leve o Medalhão de Karabor para A\'dal na cidade de Shattrath.‡Принесите медальон Карабора А\'далу в Шаттрат.‡Bringt das Medaillon von Karabor zu A\'dal in Shattrath.‡샤트라스에 있는 아달에게 카라보르의 메달을 가져가야 합니다.‡Llévale el medallón de Karabor a A\'dal en la Ciudad de Shattrath.‡Llévale el medallón de Karabor a A\'dal en la Ciudad de Shattrath.‡Apportez le Médaillon de Karabor à A\'dal, à Shattrath.‡将卡拉波护符交给沙塔斯城的阿达尔。‡將卡拉伯爾勳章交給撒塔斯城的阿達歐。',
  }
},
[11053] = {
  {
    'Erga-se, feitor!‡Новое назначение‡Erhebt Euch, Aufseher!‡일어나라, 감독관이여!‡¡Levanta, sobrestante!‡¡Levanta, sobrestante!‡Debout, surveillant !‡起立，督工！‡起來吧，監督者!',
    nil,
    'Fale com o Suserano Mor\'ghor, do Campo-base Presa do Dragão no Vale da Lua Negra.‡Поговорите с властителем Мор\'гором в лагере Драконьей Пасти в долине Призрачной Луны.‡Sprecht mit Oberanführer Mor\'ghor beim Basislager des Drachenmals im Schattenmondtal.‡어둠달 골짜기에 있는 용아귀 주둔지의 대군주 모르고르와 대화해야 합니다.‡Habla con el Señor Supremo Mor\'ghor en el Campamento Faucedraco, en el Valle Sombraluna.‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.‡Parlez au Suzerain Mor\'ghor au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡与影月谷龙喉营地的莫格霍尔大王谈一谈。‡到影月谷的龍喉營地和霸主莫格談談。',
  }
},
[11054] = {
  {
    'A Feitoria e Você: Fazendo as Escolhas Certas‡Ты – инспектор: как делать все правильно‡Aufsehen und Ihr: Die richtige Wahl treffen‡사랑의 매와 감독관의 임무‡La supervisión y tú: cómo tomar las decisiones adecuadas‡La supervisión y tú: cómo tomar las decisiones adecuadas‡Être surveillant : savoir faire les bons choix‡新的监工：正确的选择‡工頭與你:做出對的選擇',
    nil,
    'O Feitor-chefe Torrão no Campo-base Presa do Dragão, que fica no Vale da Lua Negra, quer que você lhe traga 10 peças de Couro Nodoso, e 1 Pelego Enrijecido de Tyrantus.‡Принесите 10 кусков узловатой кожи и прочную шкуру Тирантия надзирателю Грязевику в лагерь Драконьей Пасти в долине Призрачной Луны.‡Chefvorarbeiter Lehmklump beim Basislager des Drachenmals im Schattenmondtal möchte, dass Ihr ihm 10 Einheiten Knotenhautleder und 1 gehärteten Balg von Tyrantus bringt.‡어둠달 골짜기의 용아귀 주둔지에 있는 선임감독관 머드럼프에게 티란투스의 질긴 가죽 1개와 톱니매듭 가죽 10개를 가져가야 합니다.‡El sobrestante jefe Limo, del Campamento Faucedraco en el Valle Sombraluna, quiere que le lleves 10 trozos de cuero de pellejo nudoso y un pellejo endurecido de Tyrantus.|n‡El sobrestante jefe Limo, del Campamento Faucedraco en el Valle Sombraluna, quiere que le lleves 10 trozos de cuero de pellejo nudoso y un pellejo endurecido de Tyrantus.|n‡Le Surveillant-chef Tadboue du campement des Gueules-de-dragon dans la vallée d\'Ombrelune veut que vous lui apportiez 10 morceaux de Cuir granuleux et 1 Peau de Tyrantus durcie.‡影月谷龙喉营地的高级监工玛德拉普要你给他带回10张结缔皮和1张泰拉图斯的硬皮。‡影月谷，龍喉營地的大監督者馬朗要你幫他帶來10塊境外皮革和1塊泰藍塔斯的硬甲皮。',
  }
},
[11055] = {
  {
    'O Botarangue: a cura para o inútil peão comum‡Ботиранг: лекарство для нерадивых батраков‡Der Schuhmerang: Das Mittel gegen den wertlosen Peon‡부메랑 - 쓸모없는 일꾼들에 대한 방책‡El botarang: una cura para el insignificante trabajador común‡El botarang: una cura para el insignificante trabajador común‡Le botterang : un traitement pour les péons bons à rien‡训诫靴：懒惰苦工的惩戒‡迴力靴:專治沒用的苦工',
    nil,
    'O Feitor-chefe Torrão no Campo-base Presa do Dragão, que fica no Vale da Lua Negra, quer que você discipline 20 Peões enrolões da Presa do Dragão. Também será necessário devolver o botarangue.‡Призовите к порядку 20 ленивых батраков в лагере Драконьей Пасти. Ботиранг нужно будет вернуть надзирателю Грязевику.‡Chefvorarbeiter Lehmklump beim Basislager des Drachenmals im Schattenmondtal möchte, dass Ihr 20 faule Peons des Drachenmals zur Ordnung ruft. Gebt anschließend auch Euren Schuhmerang wieder zurück.‡어둠달 골짜기의 용아귀 주둔지에 있는 선임감독관 머드럼프가 20명의 게으른 용아귀 일꾼을 처벌한 후, 사용한 부메랑을 돌려달라고 했습니다.‡El sobrestante jefe Limo, del Campamento Faucedraco en el Valle Sombraluna, quiere que disciplines a 20 peones Faucedraco vagos. También tendrás que devolver el botarang.‡El sobrestante jefe Limo, del Campamento Faucedraco en el Valle Sombraluna, quiere que disciplines a 20 peones Faucedraco vagos. También tendrás que devolver el botarang.‡Le Surveillant-chef Tadboue du campement des Gueules-de-dragon dans la vallée d\'Ombrelune veut que vous punissiez 20 Péons Gueules-de-dragon paresseux. Vous devrez aussi rapporter votre Botterang.‡影月谷龙喉营地的高级监工玛德拉普要你惩罚20名懒惰的龙喉苦工，然后将训诫靴还给他。‡影月谷，龍喉營地的大監督者馬朗要你懲罰20個懶惰的龍喉苦工。你還要交回你的迴力靴。',
  }
},
[11056] = {
  {
    'A barganha de Hazzik‡Просьба Хаззика‡Hazziks Handel‡하지크의 거래‡La ganga de Hazzik‡La ganga de Hazzik‡Le marché d\'Hazzik‡哈吉克的协议‡海茲克的交易',
    nil,
    'Adquira o Pacote de Hazzik e devolva-o a Hazzik. Você encontrará o pacote na antiga moradia de Hazzik, que fica na parte leste de Skettis.‡Заберите сверток Хаззика из его дома в восточном Скеттисе и верните сверток хозяину.‡Sucht nach Hazziks Päckchen bei seiner Behausung im östlichen Skettis und kehrt damit zu ihm zurück.‡스케티스의 동쪽 하지크의 거처에서 하지크의 가방을 입수해 그에게 가져가야 합니다.‡Obtén el paquete de Hazzik en su hogar del este de Skettis y llévaselo.‡Obtén el paquete de Hazzik en su hogar del este de Skettis y llévaselo.‡Récupérez le Paquet d\'Hazzik dans sa demeure, à l\'est de Skettis, et remettez-le lui.‡进入斯克提斯的东部区域，在哈吉克的住处中找到哈吉克的包裹，然后把包裹带回去给他。‡到東司凱堤斯，海茲克的住所取得海茲克的包裹再拿回去給他。',
  }
},
[11057] = {
  {
    'Problema abaixo‡Огрское подполье‡Schwierigkeiten in der Tiefe‡저 아래 형제들의 문제‡El problema abajo‡El problema abajo‡Des ennuis en contrebas‡低处的麻烦‡下方的窘境',
    nil,
    'Fale com Mog\'dorg, o Rugoso, no topo de uma das torres perto do Círculo Sangrento, que fica nas Montanhas da Lâmina Afiada.‡Поговорите с Мог\'доргом Мудрым на вершине одной из башен рядом с Кругом Крови в Острогорье.‡Sprecht mit Mog\'dorg dem Weisen. Ihr findet ihn auf einem der Türme außerhalb des Zirkels des Blutes im Schergrat.‡칼날 산맥의 피의 투기장 외부의 탑 꼭대기에 있는 주름투성이 모그도그와 대화해야 합니다.‡Habla con Mog\'dorg el Marchito en lo alto de una de las torres que hay a las afueras del Anillo de Sangre en las Montañas Filospada.|n‡Habla con Mog\'dorg el Marchito en lo alto de una de las torres que hay a las afueras del Anillo de Sangre en las Montañas Filospada.|n‡Parlez à Mog\'dorg le Ratatiné, en haut d\'une des tours juste à l\'extérieur du Cercle de sang dans les Tranchantes.‡跟枯瘦的莫戈多格谈一谈，他就在竞技场外塔楼的顶部。‡到劍刃山脈血之環外的其中一座高塔，與乾癟的莫格多克談話。',
  }
},
[11058] = {
  {
    'Relíquia dos Apexis‡Апекситовая реликвия‡Ein Apexisrelikt‡에펙시스 유물‡Una reliquia de ápices‡Una reliquia de ápices‡Une relique apogide‡埃匹希斯圣物‡頂尖聖物',
    nil,
    'Obtenha Vibrações de Apexis de uma Relíquia de Apexis.‡Получите вибрации Апекса от апекситовой реликвии.‡Erlangt Apexisschwingungen von einem Apexisrelikt.‡에펙시스 유물로부터 에펙시스 직감을 얻어야 합니다.‡Consigue vibraciones de ápices de una reliquia de ápices.‡Consigue vibraciones de ápices de una reliquia de ápices.‡Obtenir des Vibrations apogides d’une Relique apogide.‡利用埃匹希斯圣物获得埃匹希斯的感应效果，然后。‡從一個頂尖聖物獲得頂尖顫動效果。',
  }
},
[11059] = {
  {
    'Guardião do monumento‡Страж монумента‡Wächter des Monuments‡유적의 수호자‡Guardián del monumento‡Guardián del monumento‡Le gardien du monument‡纪念碑的守护者‡紀念碑護衛',
    nil,
    'Colete uma Cabeça de Guardião de Apexis.‡Принесите голову стража апекситов.‡Beschafft den Kopf eines Apexiswächters.‡에펙시스 수호자의 머리를 얻어야 합니다.‡Obtén la cabeza de un guardián de ápices.‡Obtén la cabeza de un guardián de ápices.‡Procurez-vous la tête d’un Gardien apogide.‡获取一枚埃匹希斯卫士的徽记。‡取得頂尖守護者頭顱。',
  }
},
[11060] = {
  {
    '‡Кристалл с темными рунами‡Eine kristallgeschmiedete Rune der Dunkelheit‡‡Una runaoscura de cristal forjado‡Una runaoscura de cristal forjado‡Une sombrerune cristalforgée‡‡',
    nil,
    nil,
  }
},
[11061] = {
  {
    'Não basta ser pai...‡Отцовский долг‡Die Pflichten eines Vaters‡아버지의 의무‡La obligación de un padre‡La obligación de un padre‡Le devoir d\'un père‡父亲的职责‡父親的職責',
    nil,
    'Colete um Frasco Instável do Feiticeiro para ele.‡Добудьте нестабильный настой волшебника.‡Beschafft ihm ein instabiles Fläschchen des Zauberers.‡불안정한 마술사의 영약을 얻어야 합니다.‡Consigue un frasco inestable del hechicero.‡Consigue un frasco inestable del hechicero.‡Procurez-vous un Flacon instable du sorcier pour lui.‡为他取得不稳定的巫术合剂。‡他取得巫士的不穩定精鍊藥劑。',
  }
},
[11062] = {
  {
    '‡Застава Стражи Небес‡Der Außenposten der Himmelswache‡하늘경비대 전초기지‡La Avanzada de la Guardia del Cielo‡La Avanzada de la Guardia del Cielo‡L\'avant-poste de la Garde-ciel‡天空卫队哨站‡',
    nil,
    '‡‡Sprecht mit Himmelskommandant Keller beim Außenposten der Himmelswache im Schergrat.‡‡Habla con el comandante del cielo Keller en la Avanzada de la Guardia del Cielo, en lo alto de las Montañas Filospada.‡‡Parlez au Commandant Keller de la Garde-ciel à l\'Avant-poste de la Garde-ciel, dans les Tranchantes.‡库洛尔要求你与刀锋山天空卫队哨站的天空指挥官凯勒谈一谈。‡',
  }
},
[11063] = {
  {
    'Ganhando asas...‡Заработай крылья‡Sich Flügel verdienen...‡하늘파괴단의 일원‡Ganándote las alas...‡Ganándote las alas...‡Mériter ses ailes...‡你的双翼‡爭取你的翅膀……',
    nil,
    nil,
  }
},
[11064] = {
  {
    'Corrida da Presa do Dragão: A Balada de Velhote McVelho‡Гонки Драконьей Пасти: баллада о старине Макстаре‡Drachenmalrennen: Murg "Grufti" Moorbiss‡용아귀 경주: 노장의 연가‡Carrera Faucedraco: la balada del Viejo Viejete‡Carrera Faucedraco: la balada del Viejo Viejete‡Course Gueule-de-dragon : la ballade de Vieillot McVieux‡壮志凌云：莫尔戈·泥齿‡龍喉競賽:老邁克喬的民謠',
    nil,
    'Siga Murg Lamandíbula, o Velhote, enquanto tenta permanecer montado. Caso vença Murg Lamandíbula, o Velhote, relate a vitória a Ja\'y Nosliw no Campo-base Presa do Dragão, que fica no Vale da Lua Negra.‡Следуйте за "Стариной" Маргом Сквернословом, пытаясь удержаться на своем средстве передвижения. Если вам удастся победить его, сообщите об этом Джаю Нослаю в лагере Драконьей Пасти в долине Призрачной Луны.‡Folgt Murg "Grufti" Moorbiss und versucht auf Eurem Reittier zu bleiben. Solltet Ihr Murg "Grufti" Moorbiss besiegen, berichtet Ja\'y Nosliw beim Basislager des Drachenmals im Schattenmondtal von Eurem Erfolg.‡날아다니는 탈것에 올라 "노장" 모르그 먹저를 쫓아가면서 탈것에서 떨어지지 않아야 합니다. "노장" 모르그 먹저와의 경주에서 이긴 후 승리의 소식을 어둠달 골짜기의 용아귀 주둔지에 있는 제이 노슬리우에게 전하십시오.‡Sigue a Murg Quijada Sucia "el Viejo" mientras intentas mantenerte en tu montura voladora. Si vences a Murg Quijada Sucia "el Viejo", informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Sigue a Murg Quijada Sucia "el Viejo" mientras intentas mantenerte en tu montura voladora. Si vences a Murg Quijada Sucia "el Viejo", informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Suivez Murg « Vieillot » Bourbegueule en tentant de rester sur votre monture volante. Si vous parvenez à le battre, informez Ja\'y Nosliw de votre victoire au Campement des Gueules-de-dragon dans la Vallée d\'Ombrelune.‡驾驶飞行坐骑紧紧跟随莫尔戈·泥齿。击败莫尔戈·泥齿之后，将你的胜利消息报告给向影月谷龙喉营地的亚恩·诺斯利。‡跟隨莫格·老邁克喬並試著待在你的飛行坐騎上。如果你擊敗了莫格·老邁克喬就將你的勝利回報給影月谷，龍喉營地的傑·諾斯利。',
  }
},
[11065] = {
  {
    'Precisa-se de arraias aéreas!‡Ловим летучих скатов!‡Bändigt ein paar Ätherrochen!‡에테르 가오리 생포!‡¡Enlaza algunas rayas de éter!‡¡Enlaza algunas rayas de éter!‡Allez dompter quelques raies de l\'éther !‡捕捉一些以太鳐！‡捆綁一些蒼穹鰭刺!',
    nil,
    'Use o Laço para capturar 5 Arraias Etéreas.‡Поймайте 5 летучих скатов при помощи веревочного аркана.‡Bändigt mithilfe des Bändigungsseils 5 Ätherrochen.‡생포용 올가미를 사용해서 5마리의 에테르 가오리를 생포해야 합니다.‡Utiliza el lazo para capturar 5 rayas de éter.‡Utiliza el lazo para capturar 5 rayas de éter.‡Utilisez le Lasso pour capturer 5 Raies de l’éther.‡天空卫士卡提要你用牧绳捕捉5只以太鳐。‡使用綑綁套索捕捉5隻蒼穹鰭刺。',
  }
},
[11066] = {
  {
    'Segura o laço!‡Нам нужно больше летучих скатов!‡Bändigt noch mehr Ätherrochen!‡더 많은 에테르 가오리 생포!‡¡Atrapa más rayas de éter!‡¡Atrapa más rayas de éter!‡Allez dompter d\'autres raies de l\'éther !‡捕捉更多以太鳐！‡捆綁更多蒼穹鰭刺!',
    nil,
    'Use o Laço para capturar 5 Arraias Etéreas.‡Поймайте 5 летучих скатов при помощи веревочного аркана.‡Bändigt mithilfe des Bändigungsseils 5 Ätherrochen.‡생포용 올가미를 사용하여 에테르 가오리 5마리를 생포해야 합니다.‡Utiliza el lazo para capturar 5 rayas de éter.‡Utiliza el lazo para capturar 5 rayas de éter.‡Utilisez le Lasso pour capturer 5 Raies de l’éther.‡天空卫士卡提要你用牧绳捕捉5只以太鳐。‡使用綑綁套索捕捉5隻蒼穹鰭刺。',
  }
},
[11067] = {
  {
    'Corrida da Presa do Dragão: Trope, o Arrota-lixo‡Гонки Драконьей Пасти: Троп Смраднорыг‡Drachenmalrennen: Trope der Rußhuster‡용아귀 경주: "구린내" 트로프‡Carrera Faucedraco: Trope el Vomitador‡Carrera Faucedraco: Trope el Vomitador‡Course Gueule-de-dragon : Trope le Rote-crasse‡壮志凌云：粗野的特罗普‡龍喉競賽:『污穢者』川普',
    nil,
    'Siga Trope, o Arrota-lixo, enquanto tenta permanecer montado. Caso vença Trope, o Arrota-lixo, relate a vitória a Ja\'y Nosliw no Campo-base Presa do Dragão, que fica no Vale da Lua Negra.‡Следуйте за Тропом Смраднорыгом, пытаясь удержаться на своем средстве передвижения. Если вам удастся победить его, сообщите об этом Джаю Нослаю в лагере Драконьей Пасти в долине Призрачной Луны.‡Folgt Trope dem Rußhuster und versucht auf Eurem Reittier zu bleiben. Solltet Ihr Trope den Rußhuster besiegen, berichtet Ja\'y Nosliw beim Basislager des Drachenmals im Schattenmondtal von Eurem Erfolg.‡날아다니는 탈것에 올라 "구린내" 트로프를 쫓아가면서 탈것에서 떨어지지 않아야 합니다. "구린내" 트로프와의 경주에서 이긴 후 승리의 소식을 어둠달 골짜기의 용아귀 주둔지에 있는 제이 노슬리우에게 전하십시오.‡Sigue a Trope el Vomitador mientras intentas mantenerte en tu montura voladora. Si vences a Trope el Vomitador, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Sigue a Trope el Vomitador mientras intentas mantenerte en tu montura voladora. Si vences a Trope el Vomitador, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Suivez Trope le Rote-crasse en tentant de rester sur votre monture volante. Si vous parvenez à le battre, informez Ja\'y Nosliw de votre victoire au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡驾驶飞行坐骑紧紧跟随粗野的特罗普。击败粗野的特罗普之后，将你的胜利消息报告给向影月谷龙喉营地的亚恩-诺斯利。‡跟隨『污穢者』川普並試著待在你的飛行坐騎上。如果你擊敗了『污穢者』川普就將你的勝利回報給影月谷，龍喉營地的傑·諾斯利。',
  }
},
[11068] = {
  {
    'Corrida da Presa do Dragão: Veterano Corlok‡Гонки Драконьей Пасти: Корлок Ветеринар‡Drachenmalrennen: Corlok der Veteran‡용아귀 경주: 최고참 코를록‡Carrera Faucedraco: Corlok el Veterano‡Carrera Faucedraco: Corlok el Veterano‡Course Gueule-de-dragon : Corlok le Briscard‡壮志凌云：兽医考洛克‡龍喉競賽:年邁的克洛克',
    nil,
    'Siga o Veterano Corlok enquanto tenta permanecer montado. Caso você vença o Veterano Corlok, relate a vitória a Ja\'y Nosliw no Campo-base Presa do Dragão, que fica no Vale da Lua Negra.‡Следуйте за Корлоком Ветеринаром, пытаясь удержаться на своем средстве передвижения. Если вам удастся победить его, сообщите об этом Джаю Нослаю в лагере Драконьей Пасти в долине Призрачной Луны.‡Folgt Corlok dem Veteranen und versucht auf Eurem Reittier zu bleiben. Solltet Ihr Corlok den Veteranen besiegen, berichtet Ja\'y Nosliw beim Basislager des Drachenmals im Schattenmondtal von Eurem Erfolg.‡날아다니는 탈것에 올라 최고참 코를록을 쫓아가면서 탈것에서 떨어지지 않아야 합니다. 최고참 코를록과의 경주에서 이긴 후 승리의 소식을 어둠달 골짜기의 용아귀 주둔지에 있는 제이 노슬리우에게 전하십시오.‡Sigue a Corlok el Veterano mientras intentas mantenerte en tu montura voladora. Si vences a Corlok el Veterano, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Sigue a Corlok el Veterano mientras intentas mantenerte en tu montura voladora. Si vences a Corlok el Veterano, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Suivez Corlok le Briscard en tentant de rester sur votre monture volante. Si vous parvenez à le battre, informez Ja\'y Nosliw de votre victoire au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡驾驶飞行坐骑紧紧跟随兽医考洛克。击败兽医考洛克之后，将你的胜利消息报告给向影月谷龙喉营地的亚恩·诺斯利。‡跟隨年邁的克洛克並試著待在你的飛行坐騎上。如果你擊敗了年邁的克洛克就將你的勝利回報給影月谷，龍喉營地的傑·諾斯利。',
  }
},
[11069] = {
  {
    'Corrida da Presa do Dragão: Comandante de Ala Ichman‡Гонки Драконьей Пасти: командир звена Ромеон‡Drachenmalrennen: Schwadronskommandant Ichman‡용아귀 경주: 편대사령관 이크만‡Carrera Faucedraco: Comandante del aire Ichman‡Carrera Faucedraco: Comandante del aire Ichman‡Course Gueule-de-dragon : Chef d\'escadrille Ichman‡壮志凌云：空军指挥官艾克曼‡龍喉競賽:空軍指揮官艾克曼',
    nil,
    'Siga o Comandante de Ala Ichman enquanto tenta permanecer montado. Caso você vença Comandante de Ala Ichman, relate a vitória a Ja\'y Nosliw no Campo-base Presa do Dragão, que fica no Vale da Lua Negra.‡Следуйте за командиром звена Ромеоном, пытаясь удержаться на своем средстве передвижения. Если вам удастся победить его, сообщите об этом Джаю Нослаю в лагере Драконьей Пасти в долине Призрачной Луны.‡Folgt Schwadronskommandant Ichman und versucht auf Eurem Reittier zu bleiben. Solltet Ihr Schwadronskommandant Ichman besiegen, berichtet Ja\'y Nosliw beim Basislager des Drachenmals im Schattenmondtal von Eurem Erfolg.‡날아다니는 탈것에 올라 편대사령관 이크만을 쫓아가면서 탈것에서 떨어지지 않아야 합니다. 편대사령관 이크만과의 경주에서 이긴 후 승리의 소식을 어둠달 골짜기의 용아귀 주둔지에 있는 제이 노슬리우에게 전하십시오.‡Sigue al comandante del aire Ichman mientras intentas mantenerte en tu montura voladora. Si vences al comandante del aire Ichman, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Sigue al comandante del aire Ichman mientras intentas mantenerte en tu montura voladora. Si vences al comandante del aire Ichman, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Suivez le Chef d\'escadrille Ichman en tentant de rester sur votre monture volante. Si vous parvenez à le battre, informez Ja\'y Nosliw de votre victoire au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡驾驶飞行坐骑紧紧跟随空军指挥官艾克曼。击败空军指挥官艾克曼之后，将你的胜利消息报告给向影月谷龙喉营地的亚恩·诺斯利。‡跟隨空軍指揮官艾克曼並試著待在你的飛行坐騎上。如果你擊敗了空軍指揮官艾克曼就將你的勝利回報給影月谷，龍喉營地的傑·諾斯利。',
  }
},
[11070] = {
  {
    'Corrida da Presa do Dragão: Comandante de Ala Mulverick‡Гонки Драконьей Пасти: командир звена Маэстр‡Drachenmalrennen: Schwadronskommandant Mulverick‡용아귀 경주: 편대사령관 멀베릭‡Carrera Faucedraco: Comandante del aire Mulverick‡Carrera Faucedraco: Comandante del aire Mulverick‡Course Gueule-de-dragon : Chef d\'escadrille Mulverick‡壮志凌云：空军指挥官穆维里克‡龍喉競賽:空軍指揮官穆維里克',
    nil,
    'Siga o Comandante de Ala Mulverick enquanto tenta permanecer montado. Caso você vença Comandante de Ala Mulverick, relate a vitória a Ja\'y Nosliw no Campo-base Presa do Dragão, que fica no Vale da Lua Negra.‡Следуйте за командиром звена Маэстром, пытаясь удержаться на своем средстве передвижения. Если вам удастся победить его, сообщите об этом Джаю Нослаю в лагере Драконьей Пасти в долине Призрачной Луны.‡Folgt Schwadronskommandant Mulverick und versucht auf Eurem Reittier zu bleiben. Solltet Ihr Schwadronskommandant Mulverick besiegen, berichtet Ja\'y Nosliw beim Basislager des Drachenmals im Schattenmondtal von Eurem Erfolg.‡날아다니는 탈것에 올라 편대사령관 멀베릭을 쫓아가면서 탈것에서 떨어지지 않아야 합니다. 편대사령관 멀베릭과의 경주에서 이긴 후 승리의 소식을 어둠달 골짜기의 용아귀 주둔지에 있는 제이 노슬리우에게 전하십시오.‡Sigue al comandante del aire Mulverick mientras intentas mantenerte en tu montura voladora. Si vences al comandante del aire Mulverick, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.|n‡Sigue al comandante del aire Mulverick mientras intentas mantenerte en tu montura voladora. Si vences al comandante del aire Mulverick, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.|n‡Suivez le Chef d\'escadrille Mulverick en tentant de rester sur votre monture volante. Si vous parvenez à le battre, informez Ja\'y Nosliw de votre victoire au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡驾驶飞行坐骑紧紧跟随空军指挥官穆维里克。击败空军指挥官穆维里克之后，将你的胜利消息报告给向影月谷龙喉营地的亚恩·诺斯利。‡跟隨空軍指揮官穆維里克並試著待在你的飛行坐騎上。如果你擊敗了空軍指揮官穆維里克，就將你的勝利回報給影月谷，龍喉營地的傑·諾斯利。',
  }
},
[11071] = {
  {
    'Corrida da Presa do Dragão: Capitão Rasga-céus‡Гонки Драконьей Пасти: капитан Небокрушитель‡Drachenmalrennen: Hauptmann Himmelsdonner‡용아귀 경주: 대장 스카이쉐터‡Carrera Faucedraco: Capitán Devastador del Cielo‡Carrera Faucedraco: Capitán Devastador del Cielo‡Course Gueule-de-dragon : Capitaine Fracasse-ciel‡壮志凌云：汤告鲁士·碎空‡龍喉競賽:碎天者隊長',
    nil,
    'Siga o Capitão Rasga-céus enquanto tenta permanecer montado. Caso você vença o Capitão Rasga-céus, relate a vitória a Ja\'y Nosliw no Campo-base Presa do Dragão, que fica no Vale da Lua Negra.‡Следуйте за капитаном Небокрушителем, пытаясь удержаться на своем средстве передвижения. Если вам удастся победить его, сообщите об этом Джаю Нослаю в лагере Драконьей Пасти в долине Призрачной Луны.‡Folgt Hauptmann Himmelsdonner und versucht auf Eurem Reittier zu bleiben. Solltet Ihr Hauptmann Himmelsdonner besiegen, berichtet Ja\'y Nosliw beim Basislager des Drachenmals im Schattenmondtal von Eurem Erfolg.‡날아다니는 탈것에 올라 대장 스카이쉐터를 쫓아가면서 탈것에서 떨어지지 않아야 합니다. 대장 스카이쉐터와의 경주에서 이긴 후 승리의 소식을 어둠달 골짜기의 용아귀 주둔지에 있는 제이 노슬리우에게 전하십시오.‡Sigue al capitán Devastador del Cielo mientras intentas mantenerte en tu montura voladora. Si vences al capitán Devastador del Cielo, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Sigue al capitán Devastador del Cielo mientras intentas mantenerte en tu montura voladora. Si vences al capitán Devastador del Cielo, informa de tu Victoria a Ja\'y Nosliw en el Campamento Faucedraco, en el Valle Sombraluna.‡Suivez le Capitaine Fracasse-ciel en tentant de rester sur votre monture volante. Si vous parvenez à le battre, informez Ja\'y Nosliw de votre victoire au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡驾驶飞行坐骑紧紧跟随汤告鲁士·碎空。击败汤告鲁士·碎空之后，将你的胜利消息报告给向影月谷龙喉营地的亚恩·诺斯利。‡跟隨碎天者隊長並試著待在你的飛行坐騎上。如果你擊敗了碎天者隊長就將你的勝利回報給影月谷，龍喉營地的傑·諾斯利。',
  }
},
[11072] = {
  {
    'Sangue adversário‡Кровные враги‡Feindesblut‡적의 피‡Sangre adversaria‡Sangre adversaria‡Lignées antagonistes‡仇敌的血脉‡敵人之血',
    nil,
    'Encontre as Pilhas de Crânios no meio dos círculos de evocação em Skettis. Evoque e derrote cada um dos descendentes usando 10 Pergaminhos do Tempo Perdido na Pilha de Crânios. Fale novamente com Hazzik no Campo de Pouso Ventonegro ao obter as marcas de cada um.‡Найдите груды черепов в середине кругов призыва Скеттиса. С помощью 10 свитков затерянных во времени призовите каждого потомка Скеттика, уничтожьте их и отнесите трофеи Хаззику в лагерь Черного Ветра.‡Findet die Schädelhaufen innerhalb der Beschwörungskreise in Skettis. Beschwört die Nachfahren, indem Ihr 10 zeitverlorene Schriftrollen am Schädelhaufen benutzt und bezwingt sie. Kehrt mit einem Beweisstück von jedem zu Hazzik am Schattenwindlager zurück.‡‡Encuentra los montones de cráneos en el centro de los círculos de invocación de Skettis. Invoca y derrota a cada uno de los descendientes usando 10 Pergaminos perdidos en el Tiempo en el montón de cráneos. Llévale a Hazzik una señal de cada uno al Alto de los Vientonegro.‡Encuentra los montones de cráneos en el centro de los círculos de invocación de Skettis. Invoca y derrota a cada uno de los descendientes usando 10 Pergaminos perdidos en el Tiempo en el montón de cráneos. Llévale a Hazzik una señal de cada uno al Alto de los Vientonegro.‡Trouvez les Piles de crânes au milieu des cercles d\'invocation de Skettis. Invoquez et vainquez chacun des descendants des adversaires de Terokk en utilisant 10 Parchemins perdus dans le temps à la Pile de crâne. Retournez auprès de Hazzik au Raie\'odrome de Noirvent avec un gage de chacun d\'eux.‡在斯克提斯找到召唤法阵中央的徽记堆，在此使用10个迷失卷轴，并击败每一只被召唤出来的后裔。完成之后带着从它们身上取下的信物回去向哈吉克复命。‡在司凱堤斯的召喚法陣中央找到顱骨堆。在顱骨堆用10個時光流逝卷軸召喚並擊敗每個子嗣。帶著各個象徵物回到黑風平臺找海茲克。',
  }
},
[11073] = {
  {
    'A queda de Terokk‡Падение Терокка‡Terokks Fall‡테로크의 몰락‡La caída de Terokk‡La caída de Terokk‡La chute de Terokk‡泰罗克的毁灭‡泰洛克的覆滅',
    nil,
    'Leve a Oferenda do Tempo Perdido preparada por Hazzik para a Pilha de Crânios, no centro de Skettis. Evoque e derrote Terokk. Após concluir a tarefa, fale novamente com o Comandante Aéreo Adaris.‡Возьмите приготовленное Хаззиком Подношение Затерянного во Времени и отнесите его к груде черепов в центре Скеттиса. С помощью подношения призовите Терокка и сразитесь с ним, после чего вернитесь к небесному командиру Адарису.‡Bringt die Zeitverlorene Opfergabe, die Hazzik angefertigt hat, zu dem Schädelhaufen im Zentrum von Skettis. Beschwört Terokk und bezwingt ihn. Habt Ihr Eure Aufgabe erfüllt, kehrt zu Himmelskommandant Adaris zurück.‡하지크가 준비한 잃어버린 시간의 제물을 스케티스의 가운데 지점에 있는 해골 더미로 가져가 테로크를 소환하여 처치해야 합니다. 임무를 마치면 하늘경비대 사령관 아다리스에게 가야 합니다.‡Lleva las ofrendas tiempo perdido que ha preparado Hazzik al montón de cráneos en el centro de Skettis e invoca y vence a Terokk. Cuando termines, vuelve junto al comandante del cielo Adaris.‡Lleva las ofrendas tiempo perdido que ha preparado Hazzik al montón de cráneos en el centro de Skettis e invoca y vence a Terokk. Cuando termines, vuelve junto al comandante del cielo Adaris.‡Emportez l\'Offrande perdue dans le temps préparée par Hazzik à la Pile de crânes qui se trouve au milieu de Skettis, puis invoquez et terrassez Terokk. Retournez voir le Commandant Adaris de la Garde-ciel quand vous aurez accompli votre mission.‡将哈吉克准备好的失落的祭品带到斯克提斯中央的徽记堆，召唤出泰罗克并击败它。完成这个任务之后回去向空军指挥官阿达利斯复命。‡帶著海茲克準備的時光流逝祭品到司凱堤斯中心的顱骨堆，召喚並擊敗泰洛克。完成這個任務後回去找天空指揮官艾德瑞斯。',
  }
},
[11074] = {
  {
    'Marcas dos descendentes‡Кровные враги‡Zeichen der Nachfahren‡자손의 증거‡Atributos de los descendientes‡Atributos de los descendientes‡Les attributs des descendants‡仇敌的血脉‡子嗣的象徵',
    nil,
    'Recolha Pergaminhos do tempo perdido dos arakkoas perdidos no tempo em Skettis e leve-os para as Pilhas de Crânios nos círculos de evocação em Skettis. Evoque e derrote os descentes dos adversários de Terokk. Fale novamente com Hakkiz ao obter a Garra de Akkarai, o Espinhaço de Karrog, a Escama de Vakkiz e as Garras de Gezzarak.‡Добудьте у затерянных во времени араккоа их свитки и отнесите их к груде черепов в центре круга призыва в Скеттисе. Вызовите и победите потомков врагов Терокка, после чего отнесите Хаззику коготь Аккарая, хребет Гарокка, чешую Векказа и коготь Геззарака.‡Sammelt zeitverlorene Schriftrollen von den zeitverlorenen Arakkoa in Skettis ein und bringt sie zu den Schädelhaufen innerhalb der Beschwörungskreise in Skettis. Beschwört und bezwingt die Nachfahren der Gegner Terokks und kehrt zu Hakkiz mit Akkarais Kralle, Garokks Stachel, Vekkaz\' Schuppe und Gezzaraks Klaue zurück.‡스케티스에서 소환 마법진과 해골더미를 찾은 후, 잃어버린 시간의 두루마리 20개를 해골더미에 사용하여 자손들을 소환해야 합니다. 자손들을 처치한 후 그 증거로 아카라이의 갈퀴발톱, 카로그의 등뼈, 바키즈의 비늘, 게자라크의 발톱을 가지고 검은바람 영지에 있는 하지크에게 가져가야 합니다.‡Recopila pergaminos perdidos en el tiempo de los arakkoa tiempo perdido en Skettis y llévalos a un montón de cráneos dentro de un círculo de invocación en Skettis. Invoca y derrota a los descendientes de los adversarios de Terokk y llévale a Hazzik la garfa de Akkarai, la espina de Karrog, la escama de Vekkaz y la garra de Gezzarak.‡Recopila pergaminos perdidos en el tiempo de los arakkoa tiempo perdido en Skettis y llévalos a un montón de cráneos dentro de un círculo de invocación en Skettis. Invoca y derrota a los descendientes de los adversarios de Terokk y llévale a Hazzik la garfa de Akkarai, la espina de Karrog, la escama de Vekkaz y la garra de Gezzarak.‡Rassemblez des Parchemins perdus dans le temps détenus par les arakkoa de Skettis, et emportez-les jusqu\'à une Pile de crânes au milieu d\'un cercle d\'invocation de Skettis. Invoquez et vainquez les descendants des adversaires de Terokk et rapportez les Serres d\'Akkarai, l\'Échine de Garrok, l\'Écaille de Vekkaz et les Griffes de Gezzarak à Hakkiz.‡从斯克提斯的迷失鸦人身上收集迷失卷轴，然后将它们拿到召唤法阵的徽记堆内，召唤出泰罗克仇敌的后裔，并击败它们。然后带着阿克卡莱之爪、卡尔洛格之脊、瓦克奇斯之鳞和吉萨拉克之爪回去向哈吉克复命。‡從司凱堤斯的時光流逝阿拉卡身上收集時光流逝卷軸，把它們帶到司凱堤斯，找到召喚法陣裡的顱骨堆。召喚並擊敗泰洛克敵人的子嗣再帶著阿卡萊之爪，凱羅格之刺，瓦奇茲的鱗片和吉札拉之爪回到海茲克那裡。',
  }
},
[11075] = {
  {
    'As minas da Asa Etérea‡Копи Крыльев Пустоты‡Die Netherschwingenminen‡황천날개 광산‡Las Minas del Ala Abisal‡Las Minas del Ala Abisal‡Les mines de l\'Aile-du-Néant‡灵翼矿洞‡虛空之翼礦坑',
    nil,
    'Procure a Senhora das Minas na Plataforma da Asa Etérea.‡Найдите Госпожу Копей на кряже Крыльев Пустоты.‡Sucht die Herrin der Minen auf der Netherschwingenscherbe auf.‡황천날개 마루에 있는 황천광산의 여군주를 찾아야 합니다.‡Busca a la Maestra de las minas en el Arrecife del Ala Abisal.‡Busca a la Maestra de las minas en el Arrecife del Ala Abisal.‡Allez voir la Maîtresse des mines sur l\'Escarpement de l\'Aile-du-Néant.‡前往灵翼浮岛，找到矿洞女王。‡找到虛空之翼岩架的礦坑夫人。',
  }
},
[11076] = {
  {
    'Catando cavaco‡Собрать по кусочкам...‡Die Dinge in den Griff bekommen...‡화물 회수‡Recogiendo los pedazos...‡Recogiendo los pedazos...‡Ramasser les morceaux...‡回收货物‡拾起貨品……',
    nil,
    'A Senhora das Minas da Asa Etérea, no Vale da Lua Negra, quer que você recupere 15 caixotes de Carga de Mina Etérea.‡Соберите для Госпожи Копей груз 15 тачек в Долине Призрачной Луны.‡Die Herrin der Minen bei den Netherschwingenminen im Schattenmondtal möchte, dass Ihr 15 Kisten mit Fracht der Netherminen einsammelt.‡어둠달 골짜기의 황천날개 광산에 있는 황천광산의 여군주가 황천광산 화물 15개를 가져다 달라고 했습니다.‡La maestra de las minas en las Minas del Ala Abisal, en el Valle Sombraluna, quiere que recuperes 15 cajas de carga de mina abisal.‡La maestra de las minas en las Minas del Ala Abisal, en el Valle Sombraluna, quiere que recuperes 15 cajas de carga de mina abisal.‡La Maîtresse des mines, des Mines de l\'escarpement de l\'Aile-du-Néant de la vallée d\'Ombrelune, veut que vous récupériez 15 caisses de Cargaison de Mine-néant.‡影月谷灵翼矿洞的矿洞女王要你取回15份虚空矿洞的货物。‡影月谷，虛空之翼礦坑的礦坑夫人要你取得15個虛空礦坑貨品箱。',
  }
},
[11077] = {
  {
    'Os dragões são o nosso menor problema‡Драконы – это не самое страшное‡Drachen sind unsere geringste Sorge‡하찮은 골칫거리‡Los dragones son el menor de nuestros problemas‡Los dragones son el menor de nuestros problemas‡Les dragons sont les derniers de nos soucis‡龙？不是问题‡龍的問題不算什麼',
    nil,
    'O Encarregado Presa do Dragão nas Minas da Asa Etérea do Vale da Lua Negra quer que você mate 15 Esfola-pedras da Mina Etérea e 5 Assoladores da Mina Etérea.‡Убейте 15 живодеров-пустокопов и 5 опустошителей-пустокопов из Копей Пустоты для штейгера из клана Драконьей Пасти.‡Der Vorarbeiter des Drachenmals bei den Netherschwingenminen im Schattenmondtal möchte, dass Ihr 15 Netherminenschinder und 5 Netherminenhetzer tötet.‡어둠달 골짜기에 있는 황천날개 광산의 용아귀 현장감독이 황천수정 바위갈퀴 15마리와 황천수정 칼날발톱 5마리를 처치해 달라고 했습니다.‡El supervisor Faucedraco de las Minas del Ala Abisal en el Valle Sombraluna quiere que mates 15 despellejadores mina abisal y 5 devastadores mina abisal.‡El supervisor Faucedraco de las Minas del Ala Abisal en el Valle Sombraluna quiere que mates 15 despellejadores mina abisal y 5 devastadores mina abisal.‡Le Contremaître Gueule-de-dragon des Mines de l\'Aile-du-Néant de la vallée d\'Ombrelune veut que vous tuiez 15 Ecorcheurs mine-néant et 5 Ravageurs mine-néant.‡影月谷灵翼矿洞的龙喉工头要你杀死15只虚空矿洞剥石者和5只虚空矿洞掠食者。‡影月谷，虛空之翼礦坑的龍喉工頭要你殺死15個虛空礦坑鐮奪怪和5個虛空礦坑劫毀者。',
  }
},
[11078] = {
  {
    'Para dominar os céus‡В небесах останется только один!‡Den Himmel beherrschen‡하늘의 패권‡Reinar en los cielos‡Reinar en los cielos‡Pour régner sur les cieux‡统治天空‡統治天空',
    nil,
    'Recolha os Dentes de Dragão.‡Добудьте драконьи зубы.‡Beschafft Euch Drachenzähne.‡용 이빨을 얻어야 합니다.‡Consigue dientes de dragón.‡Consigue dientes de dragón.‡Récupérez des Dents de dragon.‡收集龙齿。‡取得龍牙。',
  }
},
[11079] = {
  {
    'Um chicote vil para Gahk‡Бич Скверны для Гахка‡Eine Teufelspeitsche für Gahk‡가크를 위한 지옥 채찍‡Un látigo vil para Gahk‡Un látigo vil para Gahk‡Un gangrefouet pour Gahk‡甘克的魔鞭‡賈克的惡魔皮鞭',
    nil,
    'Colete um Chicote Vil.‡Добудьте бич Скверны.‡Beschafft Euch eine Teufelspeitsche.‡지옥 채찍을 입수해야 합니다.‡Consigue un látigo vil.‡Consigue un látigo vil.‡Procurez-vous un Gangrefouet.‡取得一根魔鞭。‡取得一條惡魔皮鞭。',
  }
},
[11080] = {
  {
    'Emanação da relíquia‡Излучение реликвии‡Die Strahlung des Relikts‡유물의 발산물‡La emanación de la reliquia‡La emanación de la reliquia‡Les émanations des reliques‡埃匹希斯的顿悟‡聖物的增益',
    nil,
    'Obtenha Emanações de Apexis de uma Relíquia de Apexis.‡Испытайте на себе излучение от апекситовой реликвии.‡Erlangt Apexisstrahlung von einem Apexisrelikt.‡에펙시스 유물로부터 에펙시스 발산물을 얻어야 합니다.‡Consigue emanaciones de ápices de una reliquia de ápices.‡Consigue emanaciones de ápices de una reliquia de ápices.‡Obtenir des Emanations apogides d’une Relique apogide.‡利用埃匹希斯圣物获得埃匹希斯的顿悟效果。‡從頂尖聖物獲得頂尖放射增益效果。',
  }
},
[11081] = {
  {
    'A grande revolta dos Sangue-de-lodo‡Восстание в племени Темной Крови‡Der große Aufstand der Finsterblut‡수렁피 일족 폭동‡La gran revuelta Sangreoscura‡La gran revuelta Sangreoscura‡La grande révolte des Bourbesang‡暗血大逃亡‡黑暗之血大反叛',
    nil,
    'Entregue o Plano de Fuga Sangue-de-lodo à Senhora das Minas.‡Отнесите планы побега племени Темной Крови Госпоже Копей.‡Bringt die Fluchtpläne der Finsterblut zur Herrin der Minen.‡황천광산의 여군주에게 수렁피 탈출 계획서를 가져가야 합니다.‡Lleva los planes de fuga de los Sangreoscura a la Maestra de las minas.‡Lleva los planes de fuga de los Sangreoscura a la Maestra de las minas.‡Apportez les Plans d\'évasion bourbesang à la Maîtresse des mines.‡将暗血逃亡计划交给矿洞女王。‡將黑暗之血逃脫計畫交給礦坑夫人。',
  }
},
[11082] = {
  {
    'Em busca da verdade‡Искатель Истины‡Suche nach der Wahrheit‡진실의 추종자‡En busca de la verdad‡En busca de la verdad‡À la recherche de la vérité‡寻找真相‡真相尋求者',
    nil,
    'Encontre um Feitor Sangue-de-lodo e o interrogue. Fale novamente com a Senhora das Minas quando tiver a informação dos Sangue-de-lodo e a Mão do Feitor.‡Найдите надзирателя из племени Темной Крови и допросите его. Вернитесь к Госпоже Копей с информацией об организаторе побега и рукой надзирателя.‡Findet einen Aufpasser der Finsterblut und verhört ihn. Kehrt mit den Informationen der Finsterblut und mit der Hand des Aufpassers zur Herrin der Minen zurück.‡수렁피 감독관을 찾아 그를 심문한 후, 수집한 정보와 감독관의 장갑을 가지고 황천광산의 여군주에게 가야 합니다.‡Encuentra a un sobrestante Sangreoscura e interrógalo. Regresa junto a la maestra de las minas con la información sobre los Sangreoscura y la mano del sobrestante.‡Encuentra a un sobrestante Sangreoscura e interrógalo. Regresa junto a la maestra de las minas con la información sobre los Sangreoscura y la mano del sobrestante.‡Trouvez un Surveillant bourbesang et interrogez-le. Retournez voir la Maîtresse des mines avec les Informations des Bourbesang et la Main du surveillant.‡找到一名暗血监工，然后审讯他。向矿洞女王汇报审讯的结果，并将监工之手交给她。‡找到一個黑暗之血監督者並審問他。帶著黑暗之血的訊息和監督者的手回到礦坑夫人那裡。',
  }
},
[11083] = {
  {
    'Ah, eu tô maluco‡Спятившие и очень опасные...‡Verrückt und verwirrt‡정신나간 수렁피 일족‡Locura y confusión‡Locura y confusión‡Affolés et perturbés‡疯狂与困惑‡瘋狂混亂',
    nil,
    'Ronag, o Feitor, nas Minas da Asa Etérea do Vale da Lua Negra quer que você mate o Encarregado Sangue-de-lodo Enlouquecido e 5 Mineradores Sangue-de-lodo Enlouquecidos.‡Убейте для Ронага Деспота из копей Крыльев Пустоты безумного штейгера и 5 шахтеров из племени Темной Крови.‡Ronag der Sklaventreiber in den Netherschwingenminen im Schattenmondtal möchte, dass Ihr den verrückten Großknecht der Finsterblut und 5 verrückte Minenarbeiter der Finsterblut tötet.‡어둠달 골짜기에 있는 황천날개 광산의 노예감독 로나그가 정신나간 수렁피 현장감독과 5명의 정신나간 수렁피 광부를 처치해 달라고 했습니다.‡Ronag el Explotador de las Minas del Ala Abisal del Valle Sombraluna quiere que mates al supervisor Sangreoscura enloquecido y a los 5 mineros Sangreoscura enloquecidos.‡Ronag el Explotador de las Minas del Ala Abisal del Valle Sombraluna quiere que mates al supervisor Sangreoscura enloquecido y a los 5 mineros Sangreoscura enloquecidos.‡Ronag l\'Esclavagiste, des Mines de l\'Aile-du-Néant dans la vallée d\'Ombrelune, vous demande de tuer le Contremaître bourbesang affolé et 5 Mineurs bourbesang affolés.‡影月谷灵翼矿洞的驱奴者鲁纳格要你杀死疯狂的暗血工头和5名疯狂的暗血矿工。‡影月谷，虛空之翼礦坑的『鞭奴者』羅納葛要你殺死瘋狂的黑暗之血工頭和5個瘋狂的黑暗之血礦工。',
  }
},
[11084] = {
  {
    'Cabeça erguida, Capitão!‡Стой прямо, капитан!‡Seid gegrüßt, Hauptmann!‡준비됐습니다, 대장님!‡¡La cabeza bien alta, Capitán!‡¡La cabeza bien alta, Capitán!‡Haut les cœurs, capitaine !‡立正，队长！‡抬頭挺胸，隊長!',
    nil,
    'Fale com o Suserano Mor\'ghor, do Campo-base Presa do Dragão no Vale da Lua Negra.‡Поговорите с властителем Мор\'гором в лагере Драконьей Пасти в долине Призрачной Луны.‡Sprecht mit Oberanführer Mor\'ghor beim Basislager des Drachenmals im Schattenmondtal.‡어둠달 골짜기의 용아귀 주둔지에 있는 대군주 모르고르와 대화해야 합니다.‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.‡Parlez au Suzerain Mor\'ghor au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡与影月谷龙喉营地的莫格霍尔大王谈一谈。‡到影月谷和龍喉營地的霸主莫格談談。',
  }
},
[11085] = {
  {
    'Fuga de Skettis‡Побег из Скеттиса‡Flucht aus Skettis‡스케티스 탈출‡Fuga de Skettis‡Fuga de Skettis‡L\'évasion de Skettis‡逃离斯克提斯‡逃離司凱堤斯',
    nil,
    'Escolte o Prisioneiro da Guarda Aérea durante a fuga de Skettis e, a seguir, apresente-se ao Sargento Aéreo Doryn.‡Проводите плененного Стража Небес в безопасное место, а затем доложите небесному сержанту Дорину.‡Begleitet die gefangene Himmelswache in Sicherheit und meldet Euch anschließend bei Himmelsoffizier Doryn.‡하늘경비대 포로를 안전하게 호위한 후 하늘경비대 하사관 도린에게 보고해야 합니다.‡Escolta al prisionero de la Guardia del cielo hasta un lugar seguro e informa al sargento del cielo Doryn.‡Escolta al prisionero de la Guardia del cielo hasta un lugar seguro e informa al sargento del cielo Doryn.‡Escorter le Prisonnier de la Garde-ciel à l\'abri, puis se présenter au Sergent Doryn de la Garde-ciel.‡护送天空卫队囚犯前往安全的地方，然后向空军上尉杜尔因复命。‡安全護送禦天者囚犯並向天空士官多林報告。',
  }
},
[11086] = {
  {
    'Atrapalhando o Portal do Crepúsculo‡Разрушение сумеречного портала‡Schwächt das Portal des Zwielichts‡황혼의 차원문 방해하기‡Perturbar el Portal Crepuscular‡Perturbar el Portal Crepuscular‡Perturber la porte du Crépuscule‡暮光岭的传送门‡瓦解暮光傳送門',
    nil,
    'O Suserano Mor\'ghor, do Campo-base Presa do Dragão, no Vale da Lua Negra, quer que você mate 20 Agentes Umbramorte.‡По поручению властителя Мор\'гора из лагеря Драконьей Пасти в долине Призрачной Луны убейте 20 посланников Смертной Тени.‡Oberanführer Mor\'ghor beim Basislager des Drachenmals im Schattenmondtal möchte, dass Ihr 20 Agenten der Todesschatten tötet.‡어둠달 골짜기의 용아귀 주둔지에 있는 대군주 모르고르가 죽음의 그림자 요원 20명을 처치하라고 했습니다.‡El señor supremo Mor\'ghor del Campamento Faucedraco en el Valle Sombraluna quiere que mates a 20 agentes Sombra de Muerte.‡El señor supremo Mor\'ghor del Campamento Faucedraco en el Valle Sombraluna quiere que mates a 20 agentes Sombra de Muerte.‡Le Suzerain Mor\'ghor du campement des Gueules-de-dragon dans la vallée d\'Ombrelune vous demande de tuer 20 Agents ombremort.‡影月谷龙喉营地的莫格霍尔大王要你杀死20名死影密探。‡影月谷，龍喉營地的霸主莫格要你殺死20個死亡之影密探。',
  }
},
[11087] = {
  {
    '‡ФЛАГ ХИДЖАЛА‡Flagge von Hyjal‡영원의 샘‡Bandera Hyjal‡Bandera Hyjal‡MARQUE HYJAL‡‡',
    nil,
    '‡Соридорми из Пещер Времени желает, чтобы вы принесли ей неполный фиал Леди Вайш из Резервуара Кривого Клыка и неполный фиал Кель\'таса из Крепости Бурь.‡Soridormi in den Höhlen der Zeit möchte, dass Ihr die Überreste von Vashjs Phiole im Echsenkessel und die Überreste von Kaels Phiole von Kael\'thas Sonnenwanderer in der Festung der Stürme besorgt.‡시간의 동굴에 있는 소리도르미가 갈퀴송곳니 저수지에 있는 여군주 바쉬에게서 유리병 잔여물을, 폭풍우 요새에 있는 캘타스 선스트라이더로부터 유리병 잔여물을 되찾아 달라고 했습니다.‡Soridormi de las Cavernas del Tiempo quiere que recuperes los restos del vial de Vashj de Lady Vashj en la Reserva Colmillo Torcido, y los restos del vial de Kael de Kael\'thas Caminante del Sol, en El Castillo de la Tempestad.‡Soridormi de las Cavernas del Tiempo quiere que recuperes los restos del vial de Vashj de Lady Vashj en la Reserva Colmillo Torcido, y los restos del vial de Kael de Kael\'thas Caminante del Sol, en El Castillo de la Tempestad.‡Soridormi aux Grottes du temps vous demande de récupérer le Reste de la fiole de Vashj auprès de Dame Vashj au réservoir de Glissecroc et le Reste de la fiole de Kael auprès de Kael\'thas Haut-Soleil au donjon de la Tempête.‡时空之穴的Soridormi要你从盘牙水库Lady Vashj那儿取回Vashj\'s Vial Remnant，并从风暴要塞Kael\'thas Sunstrider那儿取回Kael\'s Vial Remnant。‡',
  }
},
[11089] = {
  {
    'O Canhão das almas de Reth\'hedron‡Пушка души Рет\'хедрона‡Die Seelenkanone Reth\'hedrons‡레스히드론의 영혼 대포‡El cañón de almas de Reth\'hedron‡El cañón de almas de Reth\'hedron‡Le canon à âmes de Reth\'hedron‡雷萨赫尔的灵魂火炮‡雷斯海卓恩的靈魂火砲',
    nil,
    'O Lorde Illidari Balthas, no Campo-base Presa do Dragão, que fica no Vale da Lua Negra, quer que você lhe traga 2 Barras de Açovil, 1 Estrutura de Adamantita, 1 Núcleo de Força de Kório e 1 Essência Arcana Impecável.‡Принесите повелителю иллидари Балтасу, находящемуся в лагере Драконьей Пасти, 2 слитка оскверненной стали, 1 адамантитовую рамку, 1 кориевый сердечник и 1 безупречную чародейскую сущность.‡Illidarifürst Balthas beim Basislager des Drachenmals im Schattenmondtal möchte, dass Ihr ihm 2 Teufelsstahlbarren, 1 Adamantitrahmen, 1 Khoriumkraftkern und 1 makellose arkane Essenz bringt.‡어둠달 골짜기에 있는 용아귀 주둔지의 일리다리 군주 발사스에게 지옥강철 주괴 2개, 아다만타이트 형틀 1개, 코륨 동력핵 1개, 완전무결한 비전 정수 1개를 가져가야 합니다.‡El Señor de los Illidari Balthas, en el Campamento Faucedraco del Valle Sombraluna, quiere que le lleves 2 barras de acero vil, 1 marco de adamantita, 1 núcleo de poder de korio y 1 esencia arcana inmaculada.‡El Señor de los Illidari Balthas, en el Campamento Faucedraco del Valle Sombraluna, quiere que le lleves 2 barras de acero vil, 1 marco de adamantita, 1 núcleo de poder de korio y 1 esencia arcana inmaculada.‡Le Seigneur illidari Balthas du campement des Gueules-de-dragon dans la vallée d\'Ombrelune veut que vous lui apportiez 2 Barres de gangracier, 1 Structure en adamantite, 1 Batterie en khorium et 1 Essence des arcanes sans défaut.‡影月谷龙喉营地的伊利达雷领主巴塔斯要你将2块魔钢锭、1个精金框架、1个氪金能量核心和1份完美的奥术精华交给他。‡影月谷，龍喉營地的伊利達瑞領主巴薩斯要你幫他帶來2個魔鋼錠，1個堅鋼骨架，1個克銀能量核心和1個完美的秘法精華。',
  }
},
[11090] = {
  {
    'Domine o Dominador‡Покорить Покорителя‡Unterdrückt den Unterdrücker‡정복자 제압‡Avasallar al Avasallador‡Avasallar al Avasallador‡Dominer le Dominateur‡征服者雷萨赫尔顿‡壓制征服者雷斯海卓恩',
    nil,
    'O Lorde Illidari Balthas no Campo-base Presa do Dragão, do Vale da Lua Negra, lhe conferiu a tarefa de usar o Canhão das Almas contra Reth\'hedron, o Dominador, em Nagrand.|n|nÉ necessário devolver o Canhão das Almas.‡Используйте пушку душ против Рет\'хедрона Покорителя в Награнде. Потом верните пушку повелителю иллидари Балтасу в лагерь Драконьей Пасти, в долине Призрачной Луны.‡Illidarifürst Balthas beim Basislager des Drachenmals im Schattenmondtal hat Euch den Auftrag gegeben, die Seelenkanone auf Reth\'hedron den Unterdrücker in Nagrand anzuwenden.|n|nBringt auch die Seelenkanone wieder zurück.‡어둠달 골짜기에 있는 용아귀 주둔지의 일리다리 군주 발사스가 나그란드에 있는 정복자 레스히드론에게 영혼 대포를 사용하라고 했습니다.|n|n또한 영혼 대포를 일리다리 군주 발사스에게 돌려줘야 합니다.‡El Señor de los Illidari Balthas del Campamento Faucedraco en el Valle Sombraluna te ha encargado que uses el cañón de almas contra Reth\'hedron el Avasallador en Nagrand.|n|nTambién debes devolver el cañón de almas.‡El Señor de los Illidari Balthas del Campamento Faucedraco en el Valle Sombraluna te ha encargado que uses el cañón de almas contra Reth\'hedron el Avasallador en Nagrand.|n|nTambién debes devolver el cañón de almas.‡Le Seigneur illidari Balthas du campement des Gueules-de-dragon dans la vallée d\'Ombrelune vous a chargée d\'utiliser le Canon à âmes sur Reth\'hedron le Dominateur en Nagrand.|n|nVous devrez aussi rapporter le Canon à âmes.‡影月谷龙喉营地的伊利达雷领主巴塔斯要你前往纳格兰，对征服者雷萨赫尔顿使用灵魂火炮。|n|n完成任务后归还灵魂火炮。‡影月谷的龍喉營地，伊利達瑞領主巴薩斯要你對納葛蘭的『鎮壓者』雷斯海卓恩使用靈魂火砲。|n|n你也必須將靈魂火砲交回。',
  }
},
[11091] = {
  {
    'Um agradecimento especial‡Особая благодарность‡Ein besonderer Dank an Euch‡특별한 감사‡Un agradecimiento especial‡Un agradecimiento especial‡Remerciement spécial‡特殊的感谢‡特別感謝你',
    nil,
    'Fale com Jho\'nass em Ogri\'la, que fica nas Montanhas da Lâmina Afiada.‡Поговорите с Джо\'нассом в Огри\'ле на вершинах Острогорья.‡Sprecht mit Jho\'nass in Ogri\'la im Schergrat.‡‡Habla con Jho\'nass en Ogri\'la, en lo alto de las Montañas Filospada.‡Habla con Jho\'nass en Ogri\'la, en lo alto de las Montañas Filospada.‡Parlez à Jho\'nass, à Ogri\'la, dans les Tranchantes.‡跟刀锋山奥格瑞拉的霍纳斯谈一谈。‡到劍刃山脈頂端的歐格利拉和喬那斯談談。',
  }
},
[11092] = {
  {
    'Saudações, Comandante!‡Приветствую тебя, Командир!‡Glück auf, Kommandant!‡지휘관이여!‡¡Saludos, comandante!‡¡Saludos, comandante!‡Salut, commandant !‡你好，指挥官！‡嗨，指揮官!',
    nil,
    'Fale com o Suserano Mor\'ghor, do Campo-base Presa do Dragão no Vale da Lua Negra.‡Поговорите с властителем Мор\'гором в лагере Драконьей Пасти в долине Призрачной Луны.‡Sprecht mit Oberanführer Mor\'ghor beim Basislager des Drachenmals im Schattenmondtal.‡어둠달 골짜기에 있는 용아귀 주둔지의 대군주 모르고르와 대화해야 합니다.‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.‡Habla con el señor supremo Mor\'ghor en el Campamento Faucedraco en el Valle Sombraluna.‡Parlez au Suzerain Mor\'ghor au Campement des Gueules-de-dragon dans la vallée d\'Ombrelune.‡与影月谷龙喉营地的莫格霍尔大王谈一谈。‡到影月谷的龍喉營地和霸主莫格談談。',
  }
},
[11093] = {
  {
    'Arraias etéreas famintas‡Пропитание для скатов Пустоты‡Hungrige Netherrochen‡배고픈 황천의 가오리‡Rayas abisales hambrientas‡Rayas abisales hambrientas‡Raies du Néant affamées‡饥饿的虚空鳐‡飢餓的虛空鰭刺',
    nil,
    'Use a Jaula de Arraia Etérea nas florestas ao sul do Campo de Pouso Ventonegro e mate os Perseguidores Dimensionais de Ventonegro perto da Arraia Etérea Faminta. Após completar sua missão, fale novamente com o Tratador da Guarda Aérea Deesak.‡Возьмите клетку для скатов Пустоты в лес к югу от лагеря Черного Ветра и убейте прыгуан-ловцов долины Черного Ветра около голодного ската Пустоты. После этого вернитесь к укротителю Диисаку из Стражи Небес.‡Benutzt den Netherrochenkäfig in den Wäldern südlich des Schattenwindlagers und erlegt in der Nähe des hungrigen Netherrochens einige Schattenwindhetzer. Kehrt anschließend zu Deesak dem Tierführer der Himmelswache zurück.‡검은바람 비행기지의 남쪽 숲에서 황천의 가오리 우리를 사용하여 황천의 가오리를 불러낸 후 주변에 있는 검은바람 차원의 추격자를 처치하십시오. 임무를 마치면 하늘경비대 조련사 디사크에게 가야 합니다.‡Usa la jaula de raya abisal en los bosques al sur del Alto de los Vientonegro y mata persecutores de distorsión Vientonegro cerca de la raya abisal hambrienta. Vuelve junto al cuidador de la Guardia del cielo Deesak cuando hayas completado tu misión.‡Usa la jaula de raya abisal en los bosques al sur del Alto de los Vientonegro y mata persecutores de distorsión Vientonegro cerca de la raya abisal hambrienta. Vuelve junto al cuidador de la Guardia del cielo Deesak cuando hayas completado tu misión.‡Utilisez la Cage de raie du Néant dans les bois qui se trouvent au sud du Raie\'odrome de Noirvent et tuez des Poursuivants dimensionnels près de la Raie du Néant affamée. Retournez voir le Dresseur Deesak de la Garde-ciel quand vous aurez terminé.‡在黑风码头南边的森林内使用虚空鳐的笼子，并在饥饿的虚空鳐旁杀死黑风追迹者。完成任务之后回去向天空卫队训练师德萨克复命。‡在黑風平臺南邊的樹林裡使用虛空鰭刺籠並殺死飢餓的虛空鰭刺附近的黑風扭曲追趕者。完成任務後回去找禦天者管理者迪塞克。',
  }
},
[11094] = {
  {
    'Acabe com eles!‡Всех убей, один останься!‡Tötet sie alle!‡학살!‡¡Mátalos a todos!‡¡Mátalos a todos!‡Tuez-les tous !‡把他们都干掉！‡殺光他們!',
    nil,
    'Leve as notícias da missão e a Pistola Sinalizadora Presa do Dragão para o Arcanista Thelis no Sacrário Estelar, que fica no Vale da Lua Negra.‡Доставьте информацию о вашей новой миссии вместе со сигнальным ружьем чародею Телису в святилище Звезд.‡Überbringt Arkanist Thelis beim Sanktum der Sterne im Schattenmondtal die Neuigkeiten von Eurem Einsatz zusammen mit der Leuchtpistole des Drachenmals.‡어둠달 골짜기, 별의 성소에 있는 비전술사 텔리스에게 용아귀 신호용 권총을 보여주고 작전 계획을 알려야 합니다.‡Envía noticias de tu misión junto con la pistola de bengalas Faucedraco al arcanista Thelis que se encuentra en el Sagrario de las Estrellas en el Valle Sombraluna.‡Envía noticias de tu misión junto con la pistola de bengalas Faucedraco al arcanista Thelis que se encuentra en el Sagrario de las Estrellas en el Valle Sombraluna.‡Avertissez l\'Arcaniste Thelis du contenu de votre mission et apportez-lui le Lance-fusée gueule-de-dragon au Sanctum des Étoiles dans la vallée d\'Ombrelune.‡将任务的相关情报和龙喉信号枪一起交给群星圣殿的奥术师塞里斯。‡將你任務的消息和龍喉信號槍帶到影月谷給星光聖所的秘法師賽利斯。',
  }
},
[11095] = {
  {
    'Comandante Hobb‡Командор Хобб‡Kommandant Hobb‡사령관 홉‡Comandante Hobb‡Comandante Hobb‡Le commandant Hobb‡指挥官霍布‡指揮官赫布',
    nil,
    'Entregue a Pistola Sinalizadora Presa do Dragão ao Comandante Hobb no Sacrário Estelar, que fica no Vale da Lua Negra.‡Отдайте сигнальную ракету клана Драконьей Пасти командору Хоббу в святилище Звезд в долине Призрачной Луны.‡Bringt die Leuchtpistole des Drachenmals zu Kommandant Hobb beim Sanktum der Sterne im Schattenmondtal.‡용아귀 신호용 권총을 어둠달 골짜기 별의 성소에 있는 사령관 홉에게 가져가야 합니다.‡Entrega la bengala Faucedraco al comandante Hobb, que se encuentra en el Sagrario de las Estrellas, en el Valle Sombraluna.‡Entrega la bengala Faucedraco al comandante Hobb, que se encuentra en el Sagrario de las Estrellas, en el Valle Sombraluna.‡Donnez le Lance-fusée gueule-de-dragon au Commandant Hobb au Sanctum des Étoiles dans la vallée d\'Ombrelune.‡将龙喉信号枪交给影月谷群星圣殿的指挥官霍布。‡將龍喉信號槍帶到影月谷交給星光聖所的指揮官赫布。',
  }
},
[11096] = {
  {
    'Ameaça vinda do alto‡Атака с воздуха‡Bedrohung von oben‡하늘의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡临近的威胁‡上方的威脅',
    nil,
    'Mate 20 Ogros Gordunni nos Picos da Barreira e fale novamente com Yuula em Shattrath.‡Убейте 20 любых огров из клана Гордунни в Защитных холмах, после чего вернитесь к Юуле в Шаттрат.‡Tötet bei der Hügelwand 20 Oger der Gordunni und kehrt anschließend zu Yuula in Shattrath zurück.‡울타리 언덕에 있는 골두니 오우거 20마리를 처치하고 샤트라스의 유울라에게 가야 합니다.‡Mata 20 ogros Gordunni en las Colinas Barrera y regresa junto a Yuula en la Ciudad de Shattrath.‡Mata 20 ogros Gordunni en las Colinas Barrera y regresa junto a Yuula en la Ciudad de Shattrath.‡Tuez 20 Ogres gordunni de n\'importe quelle variété dans la Barrière, puis retournez voir Yuula à Shattrath.‡在壁垒山杀死任意20个戈杜尼食人魔，然后向沙塔斯城的尤拉复命。‡殺死阻礙之丘任何20個戈杜尼巨魔再回撒塔斯城找尤拉。',
  }
},
[11097] = {
  {
    'A armadilha mais letal já preparada‡Самая Опасная Ловушка‡Die tödlichste Falle aller Zeiten‡무시무시한 함정‡La trampa más mortal jamás tendida‡La trampa más mortal jamás tendida‡Le plus mortel des pièges‡最致命的陷阱‡史上最致命的陷阱',
    nil,
    'Ajude o Comandante Hobb e os Áugures na defesa do Sacrário Estelar. Uma vez que todas as forças Presa do Dragão forem derrotadas, fale novamente com o Suserano Mor\'ghor no Campo-base Presa do Dragão levando as Medalhas dos Áugures.‡Помогите командору Хоббу защитить святилище Звезд. Когда войска клана Драконьей Пасти будут разгромлены, вернитесь к воеводе Мор\'гору в лагерь Драконьей Пасти с медалями Провидцев.‡Helft Kommandant Hobb und den Sehern bei der Verteidigung des Sanktums der Sterne. Sobald alle Streitkräfte des Drachenmals bezwungen wurden, kehrt zu Oberanführer Mor\'ghor beim Basislager des Drachenmals mit den Medaillen der Seher zurück.‡점술가 길드와 사령관 홉을 도와 별의 성소를 방어해야 합니다. 용아귀 군대를 처치하면 점술가길드 메달을 가지고 용아귀 주둔지에 있는 대군주 모르고르에게 가야 합니다.‡Ayuda al Comandante Hobb y a los Arúspices a defender el Sagrario de las Estrellas. Una vez que hayáis acabado con todas las fuerzas de los Faucedraco, preséntate ante el señor supremo Mor\'ghor en el Campamento Faucedraco con las medallas Arúspices.|n‡Ayuda al Comandante Hobb y a los Arúspices a defender el Sagrario de las Estrellas. Una vez que hayan acabado con todas las fuerzas de los Faucedraco, preséntate ante el señor supremo Mor\'ghor en el Campamento Faucedraco con las medallas Arúspices.‡Aidez le Commandant Hobb et les Clairvoyants à défendre le Sanctum des Étoiles. Une fois que l\'ensemble des forces Gueule-de-dragon aura été vaincu, retournez voir le suzerain Mor\'ghor au Campement des Gueules-de-dragon avec les Médailles de Clairvoyant.‡协助指挥官霍布和占星者保卫群星圣殿。击溃所有龙喉军队后，带上占星者勋章返回龙喉营地，向莫格霍尔大王复命。‡協助指揮官赫布和占卜者人保衛星光聖所。等所有的龍喉軍隊都被擊敗，帶著占卜者勳章回到龍喉營地找霸主莫格。',
  }
},
[11098] = {
  {
    'Para Skettis!‡В Скеттис!‡Nach Skettis!‡스케티스로!‡¡A Skettis!‡¡A Skettis!‡En route pour Skettis !‡前往斯克提斯！‡前往司凱堤斯!',
    nil,
    'Leve o Pacote de Explosivos para o Sargento Aéreo Doryn no Povoado Ventonegro, que fica do lado de fora de Skettis.‡Отнесите упаковку взрывчатки сержанту Дорину в лагерь Черного Ветра рядом со Скеттисом.‡Bringt das Paket mit Sprengladungen zu Himmelsoffizier Doryn beim Schattenwindlager außerhalb von Skettis.‡폭약 꾸러미를 스케티스 외곽에 있는 검은바람 비행기지의 하늘경비대 하사관 도린에게 전해야 합니다.‡Lleva el paquete de explosivos al sargento del cielo Doryn al Alto de los Vientonegro, a las afueras de Skettis.‡Lleva el paquete de explosivos al sargento del cielo Doryn al Alto de los Vientonegro, a las afueras de Skettis.‡Apportez le Paquet d\'explosifs au Sergent Doryn de la Garde-ciel au Raie\'odrome de Noirvent à l\'extérieur de Skettis.‡前往位于斯克提斯外的黑风码头，将炸药包交给空军上尉杜尔因。‡帶著爆裂物包去司凱堤斯外的黑風平臺找天空士官多林。',
  }
},
[11099] = {
  {
    'Acabe com eles!‡Всех убей, один останься!‡Tötet sie alle!‡학살!‡¡Mátalos a todos!‡¡Mátalos a todos!‡Tuez-les tous !‡把他们都干掉！‡殺光他們!',
    nil,
    'Leve as notícias da missão e a Pistola Sinalizadora Presa do Dragão para a Anacoreta Ceyla no Altar de Sha\'tar.‡Доставьте информацию о вашей новой миссии вместе с сигнальным ружьем анахоретке Сейле к алтарю Ша\'тар.‡Überbringt Anachoret Ceyla beim Altar der Sha\'tar die Neuigkeiten von Eurem Einsatz zusammen mit der Leuchtpistole des Drachenmals.‡샤타르 제단에 있는 수도사 케일라에게 용아귀 신호용 권총을 보여주고 작전 계획을 알려야 합니다.‡Envía noticias de tu misión junto con la pistola de bengalas Faucedraco a la anacoreta Ceyla que se encuentra en el Altar de Sha\'tar.‡Envía noticias de tu misión junto con la pistola de bengalas Faucedraco a la anacoreta Ceyla que se encuentra en el Altar de Sha\'tar.‡Avertissez l\'Anachorète Ceyla du contenu de votre mission et apportez-lui le Lance-fusée gueule-de-dragon à l\'Autel de Sha\'tar.‡将任务的相关情报和龙喉信号枪一起交给沙塔尔祭坛的学者希拉。‡將你任務的消息和龍喉信號槍帶給薩塔祭壇的隱士希拉。',
  }
},
[11100] = {
  {
    'Comandante Árquis‡Командор Аркус‡Kommandant Arcus‡사령관 아커스‡Comandante Arcus‡Comandante Arcus‡Le commandant Arcus‡指挥官阿库斯‡指揮官阿克斯',
    nil,
    'Entregue a Pistola Sinalizadora Presa do Dragão ao Comandante Árquis no Altar de Sha\'tar, que fica no Vale da Lua Negra.‡Отдайте сигнальную ракету клана Драконьей Пасти командору Аркусу у алтаря Ша\'тар.‡Bringt die Leuchtpistole des Drachenmals zu Kommandant Arcus beim Altar der Sha\'tar im Schattenmondtal.‡용아귀 신호용 권총을 어둠달 골짜기 샤타르 제단에 있는 사령관 아커스에게 가져가야 합니다.‡Entrega la bengala Faucedraco al comandante Arcus, que se encuentra en el Altar de Sha\'tar, en el Valle Sombraluna.‡Entrega la bengala Faucedraco al comandante Arcus, que se encuentra en el Altar de Sha\'tar, en el Valle Sombraluna.‡Donnez le Lance-fusée gueule-de-dragon au Commandant Arcus à l\'Autel de Sha\'tar dans la vallée d\'Ombrelune.‡将龙喉信号枪交给影月谷沙塔尔祭坛的指挥官阿库斯。‡將龍喉信號槍帶到影月谷交給薩塔祭壇的指揮官阿克斯。',
  }
},
[11101] = {
  {
    'A armadilha mais letal já preparada‡Самая Опасная Ловушка‡Die tödlichste Falle aller Zeiten‡무시무시한 함정‡La trampa más mortal jamás tendida‡La trampa más mortal jamás tendida‡Le plus mortel des pièges‡最致命的陷阱‡史上最致命的陷阱',
    nil,
    'Ajude o Comandante Árquis e os Aldor a defender o Altar de Sha\'tar. Uma vez que todas as forças Presa do Dragão forem derrotadas, fale novamente com o Suserano Mor\'ghor no Campo-base Presa do Dragão levando as Medalhas dos Aldor.‡Помогите командору Аркусу защитить алтарь Ша\'тар. Когда войска клана Драконьей Пасти будут разгромлены, вернитесь к воеводе Мор\'гору в лагерь Драконьей Пасти с медалями Алдоров.‡Helft Kommandant Arcus und den Aldor bei der Verteidigung des Altars der Sha\'tar. Sobald alle Streitkräfte des Drachenmals bezwungen wurden, kehrt zu Oberanführer Mor\'ghor beim Basislager des Drachenmals mit den Medaillen der Aldor zurück.‡알도르 사제회 군대와 사령관 아커스를 도와 샤타르 제단을 방어해야 합니다. 용아귀 군대를 무찌르면 알도르 메달을 가지고 용아귀 주둔지에 있는 대군주 모르고르에게 가야 합니다.‡Ayuda al Comandante Arcus y a los Aldor a defender el Altar de Sha\'tar. Una vez que hayáis acabado con todas las fuerzas de los Faucedraco, preséntate ante el señor supremo Mor\'ghor en el Campamento Faucedraco con las medallas de los Aldor.‡Ayuda al Comandante Arcus y a los Aldor a defender el Altar de Sha\'tar. Una vez que hayan acabado con todas las fuerzas de los Faucedraco, preséntate ante el señor supremo Mor\'ghor en el Campamento Faucedraco con las medallas de los Aldor.‡Aidez le Commandant Arcus et l\'Aldor à défendre l\'Autel de Sha\'tar. Une fois que l\'ensemble des forces Gueule-de-dragon aura été vaincu, retournez voir le suzerain Mor\'ghor au Campement des Gueules-de-dragon avec les Médailles de l\'Aldor.‡协助指挥官阿库斯和奥尔多保卫沙塔尔祭坛。击溃所有龙喉军队后，带上奥尔多勋章返回龙喉营地，向莫格霍尔大王复命。‡協助指揮官阿克斯和奧多爾人保衛薩塔祭壇。等所有的龍喉軍隊都被擊敗，帶著奧多爾勳章回到龍喉營地找霸主莫格。',
  }
},
