[11343] = {
  {
    'O eco de Ymiron‡Эхо Имирона‡Das Echo von Ymiron‡이미론의 메아리‡El eco de Ymiron‡El eco de Ymiron‡L\'écho d\'Ymiron‡伊米隆的回响‡依米倫的回響',
    nil,
    'Thorálius, o Sábio, quer que você faça uma busca na Aldeia Caveira de Dragão, enquanto estiver no mundo espiritual, e levante informações sobre os Segredos da Caveira de Dragão.‡Торелий Мудрый просит вас обыскать Деревню Драконьего Черепа в мире духов и найти информацию о тайнах Ниффлвара.‡Thoralius der Weise möchte, dass Ihr die Geisterwelt betretet und Wyrmskol nach Informationen über die Geheimnisse von Wyrmskol durchsucht.‡현자 토랄리우스가 영혼의 세계에 있는 동안 고룡해골 마을에서 고룡해골의 비밀을 조사하고 돌아오라고 했습니다.‡Thoralius el Sabio quiere que registres el Poblado Calavermis mientras estás en el mundo de los espíritus y que encuentres información acerca de los secretos de Calavermis.‡Thoralius el Sabio quiere que registres el Poblado Calavermis mientras estás en el mundo de los espíritus y que encuentres información acerca de los secretos de Calavermis.‡Thoralius le Sage veut que vous exploriez Crâne-du-ver dans le monde des esprits, à la recherche d’informations sur les Secrets de Crâne-du-ver.‡智者索拉留斯要你进入灵魂世界，搜索龙颅村并找出龙颅村的秘密。‡『智者』索拉利亞思要你在處於靈魂世界時去搜查龍顱村，找到有關龍顱的秘密相關資訊。',
  }
},
[11344] = {
  {
    'Agonia de Niffelvar‡Страдания Ниффлвара‡Die Qualen von Niffelvar‡니플바르의 고통‡La angustia de Nafsavar‡La angustia de Nafsavar‡Angoisse à Nifflevar‡尼弗莱瓦的痛苦‡尼弗瓦的苦痛',
    nil,
    'Thorálius, o Sábio, quer que você faça uma busca em Niffelvar, enquanto estiver no mundo espiritual, e levante informações sobre os Segredos de Niffelvar.‡Торелий Мудрый поручил вам осмотреть Ниффлвар из мира духов и найти информацию о тайнах Ниффлвара.‡Thoralius der Weise möchte, dass Ihr die Geisterwelt betretet und Niffelvar nach Informationen über die Geheimnisse von Niffelvar durchsucht.‡현자 토랄리우스가 니플바르에서 영혼의 세계로 들어가 니플바르의 비밀을 조사하고 돌아오라고 했습니다.‡Thoralius el Sabio quiere que registres Nafsavar mientras estás en el mundo de los espíritus y que encuentres información acerca de los secretos de Nafsavar.‡Thoralius el Sabio quiere que registres Nafsavar mientras estás en el mundo de los espíritus y que encuentres información acerca de los secretos de Nafsavar.‡Thoralius le Sage veut que vous exploriez Nifflevar dans le monde des esprits, à la recherche d’informations sur les Secrets de Nifflevar.‡智者索拉留斯要你进入灵魂世界，搜索尼弗莱瓦并找出尼弗莱瓦的秘密。‡『智者』索拉利亞思要你在靈體世界時搜索尼弗瓦，收集關於尼弗瓦秘密的情報。',
  }
},
[11345] = {
  {
    '‡Приз за попадание‡Preise für Kugeln‡‡Premios por los perdigones‡Premios por los perdigones‡Prix et projectiles‡‡',
    nil,
    '‡[PH] Ринлинг хочет, чтобы вы попали в отмеченную цель и вернули ему целевую винтовку.‡Rinling möchte, dass Ihr auf ein vorgegebenes Ziel schießt und ihm anschließend das Luftgewehr wieder bringt.‡[PH] 린링이 표시된 과녁을 맞히고 연습용 소총을 돌려달라고 했습니다.‡‡‡Rinling veut que vous tiriez sur une cible marquée puis que vous lui rendiez le fusil.‡‡',
  }
},
[11346] = {
  {
    'O Livro das Runas‡Книга Рун‡Das Buch der Runen‡룬이 기록된 책‡El libro de las Runas‡El libro de las Runas‡Le Livre des runes‡符文之书‡符文之書',
    nil,
    'O Prospector Belvar, do Forte Vildervar, quer que você lhe traga o Livro das Runas.‡Геолог Белвар из крепости Вилдервар просит вас найти Книгу Рун.‡Ausgrabungsleiter Belvar in Fort Wildervar möchte, dass Ihr ihm das Buch der Runen bringt.‡빌더바르 요새의 발굴조사단장 벨바르가 룬이 기록된 책을 가져다 달라고 했습니다.‡El prospector Belvar, en el Fuerte Vildervar, quiere que le lleves el libro de las Runas.‡El prospector Belvar, en el Fuerte Vildervar, quiere que le lleves el libro de las Runas.‡Le Prospecteur Belvar, de Fort Hardivar, veut que vous lui rapportiez le Livre des runes.‡维德瓦堡垒的勘测员贝瓦尔要你将符文之书交给他。‡威德瓦堡壘的勘察員貝爾瓦要你將符文之書帶去給他。',
  }
},
[11347] = {
  {
    '‡<NYI>Расчистите место‡Schafft Platz‡‡<NYI> Haz un poco de sitio‡<NYI> Haz un poco de sitio‡<NYI> Faire de la place‡‡',
    nil,
    '‡Доставьте в Каранос не меньше одной посылки. Чем больше доставить посылок, тем больше будет награда.‡Bringt das Paket mindestens einmal nach Kharanos. Stellt mehrere Pakete zu, um eine größere Belohnung zu erhalten.‡‡Entrega el paquete a Kharanos al menos una vez. Entrega más de uno si quieres una recompensa mayor.‡Entrega el paquete a Kharanos al menos una vez. Entrega más de uno si quieres una recompensa mayor.‡Livrez au moins un paquet à Kharanos. Si vous en livrez plus, la récompense sera meilleure.‡‡',
  }
},
[11348] = {
  {
    'A runa de comando‡Руна подчинения‡Die Rune des Befehls‡지배의 룬‡La runa de mando‡La runa de mando‡La rune de commandement‡命令符文‡指揮符文',
    nil,
    'O Prospector Belvar, do Forte Vildervar, quer que você teste a Runa de Comando e derrote o atador Murdis.‡Геолог Белвар из крепости Вилдервар просит вас испытать руну подчинения и сразиться с Мурдисом-обуздателем.‡Ausgrabungsleiter Belvar in Fort Wildervar möchte, dass Ihr die Rune des Befehls austestet und Binder Murdis besiegt.‡빌더바르 요새의 발굴조사단장 벨바르가 지배의 룬을 시험하고 결속자 무르디스를 처치해 달라고 했습니다.‡El prospector Belvar en el Fuerte Vildervar quiere que pruebes su runa de mando y que derrotes al vinculador Murdis.‡El prospector Belvar en el Fuerte Vildervar quiere que pruebes su runa de mando y que derrotes al vinculador Murdis.‡Le Prospecteur Belvar de Fort Hardivar veut que vous testiez la Rune de commandement et que vous battiez le Lieur Murdis.‡维德瓦堡垒的勘测员贝瓦尔要你去测试命令符文，并击败缚石者穆迪斯。‡威德瓦堡壘的勘察員貝爾瓦要你測試指揮符文，並且擊敗束縛者穆迪斯。',
  }
},
[11349] = {
  {
    'O domínio das runas‡Освоение рун‡Die Runen meistern‡룬 연마‡Dominar las runas‡Dominar las runas‡Maîtriser les runes‡掌控符文‡精通符文',
    nil,
    'Traga uma maleta de Ferramentas de Entalhe de Runa Férrea para o Prospector Belvar no Forte Vildervar.‡Принесите геологу Белвару из крепости Вилдервар резной инструмент, который используют дворфы клана Железной Руны.‡Bringt Ausgrabungsleiter Belvar in Fort Wildervar ein Set mit Eisenrunenwerkzeugen.‡빌더바르 요새의 발굴조사단장 벨바르에게 무쇠룬 조각 도구를 가져가야 합니다.‡Llévale un juego de herramientas de tallado Runaférrea al prospector Belvar en el Fuerte Vildervar.‡Llévale un juego de herramientas de tallado Runaférrea al prospector Belvar en el Fuerte Vildervar.‡Le Prospecteur Belvar à Fort Hardivar veut que vous lui rapportiez une série d’Outils de gravure de Runes-de-fer.‡将一套铁符文雕刻工具交给维德瓦堡垒的勘测员贝瓦尔。‡帶一組鐵符文雕刻工具給威德瓦堡壘的勘察員貝爾瓦。',
  }
},
[11350] = {
  {
    'O Livro das Runas‡Книга Рун‡Das Buch der Runen‡룬이 기록된 책‡El libro de las Runas‡El libro de las Runas‡Le Livre des runes‡符文之书‡符文之書',
    nil,
    'O Pisaléguas Pepe, da Aldeia Casco Invernal, quer que você lhe traga o Livro das Runas.‡Выносливый гонец Пембе из Лагеря Заиндевевшего Копыта просит вас принести ему Книгу Рун.‡Fernläufer Pembe im Lager der Winterhufe möchte, dass Ihr ihm das Buch der Runen bringt.‡겨울발굽 야영지에 있는 수색꾼 펨베가 룬이 기록된 책을 가져다 달라고 했습니다.‡El enviado Pembe en el Campamento Pezuña Invernal, quiere que le lleves el libro de las Runas.‡El enviado Pembe en el Campamento Pezuña Invernal, quiere que le lleves el libro de las Runas.‡Le Long-coureur Pembe, au Camp Sabot-d’hiver, veut que vous lui rapportiez le Livre des runes.‡冬蹄营地的远行者贝姆比要你将符文之书交给他。‡冬蹄營地的遠偵斥候潘比要你把符文之書帶給他。',
  }
},
[11351] = {
  {
    'O domínio das runas‡Освоение рун‡Die Runen meistern‡룬 연마‡Dominar las runas‡Dominar las runas‡Maîtriser les runes‡掌控符文‡精通符文',
    nil,
    'Traga uma maleta de Ferramentas de Entalhe de Runa Férrea para o Pisaléguas Pepe na Aldeia Casco Invernal.‡Принесите выносливому гонцу Пембе из Лагеря Заиндевевшего Копыта резной инструмент, который используют дворфы клана Железной Руны.‡Bringt Fernläufer Pembe im Lager der Winterhufe ein Set mit Eisenrunenwerkzeugen.‡겨울발굽 야영지에 있는 수색꾼 펨베에게 무쇠룬 조각 도구를 가져가야 합니다.‡Llévale un juego de herramientas de tallado Runaférrea al enviado Pembe al Campamento Pezuña Invernal.‡Llévale un juego de herramientas de tallado Runaférrea al enviado Pembe al Campamento Pezuña Invernal.‡Le Long-coureur Pembe au Camp Sabot-d’hiver veut que vous lui rapportiez une série d’Outils de gravure de Runes-de-fer.‡将一套铁符文雕刻工具交给冬蹄营地的远行者贝姆比。‡把鐵符文雕刻工具帶給冬蹄營地的遠偵斥候潘比。',
  }
},
[11352] = {
  {
    'A runa de comando‡Руна подчинения‡Die Rune des Befehls‡지배의 룬‡La runa de mando‡La runa de mando‡La rune de commandement‡命令符文‡指揮符文',
    nil,
    'O Pisaléguas Pepe, da Aldeia Casco Invernal, quer que você teste a Runa de Comando e derrote o atador Murdis.‡Выносливый гонец Пембе из Лагеря Заиндевевшего Копыта просит вас испытать руну подчинения и сразиться со Мурдисом-обуздателем.‡Fernläufer Pembe im Lager der Winterhufe möchte, dass Ihr die Rune des Befehls ausprobiert und Binder Murdis besiegt.‡겨울발굽 야영지에 있는 수색꾼 펨베가 지배의 룬을 시험하고 결속자 무르디스를 처치해 달라고 했습니다.‡El enviado Pembe en el Campamento Pezuña Invernal quiere que pruebes la runa de mando y derrotes al vinculador Murdis.‡El enviado Pembe en el Campamento Pezuña Invernal quiere que pruebes la runa de mando y derrotes al vinculador Murdis.‡Le Long-coureur Pembe au Camp Sabot-d’hiver veut que vous testiez la Rune de commandement et que vous battiez le Lieur Murdis.‡冬蹄营地的远行者贝姆比要你去测试命令符文，并击败缚石者穆迪斯。‡冬蹄營地的遠偵斥候潘比要你測試指揮符文，並且打倒束縛者穆迪斯。',
  }
},
[11353] = {
  {
    '‡FLAG: есть рабочая рубашка‡Flagge: Auf zur Arbeit‡‡‡‡La chemise de travail‡‡',
    nil,
    nil,
  }
},
[11354] = {
  {
    'Procura-se: rebenque de Nazan‡Разыскивается: Ездовой хлыстик Назана‡Gesucht: Nazans Reitgerte‡구함: 나잔의 비룡 채찍‡Se busca: Fusta de montar de Nazan‡SE BUSCA: Fusta de Nazan‡On recherche : La cravache de Nazan‡悬赏：纳杉的骑鞭‡懸賞:納桑的騎乘馬鞭',
    nil,
    'O Mercador do Vento Zhareem pediu para você pegar o Rebenque de Nazan. Entregue-o para ele no Bairro Inferior de Shattrath para receber a recompensa.|n|nEsta missão só pode ser completada em modo heroico.‡Торговец ветром Зарим просит вас добыть ездовой хлыст Назана. Доставьте его ему в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Nazans Reitgerte zu beschaffen. Bringt sie zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 나잔의 비룡 채찍을 가져가 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas la fusta de montar de Nazan. Llévasela al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas la fusta de montar de Nazan. Llévasela al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer la Cravache de Nazan. Apportez-la lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得纳杉的骑鞭。将骑鞭带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得納桑的騎乘馬鞭。將這樣物品帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11355] = {
  {
    'A marcha dos gigantes‡Марш великанов‡Marsch der Riesen‡거인의 대이동‡La marcha de los gigantes‡La marcha de los gigantes‡La marche des géants‡巨人的迁徙‡巨人的行進',
    nil,
    'O Pesquisador Aragão, do Forte Vildervar, quer que você use a Picareta Cata-runa nos cadáveres de 4 Gigantes de Pedra Rúnicos.‡Ученый Адеран из крепости Вилдервар попросил вас использовать кирку поиска рун на трупах 4 рунических каменных великанов.‡Forscher Aderan in Fort Wildervar möchte, dass Ihr mithilfe der runensuchenden Hacke die Leichen von 4 runenbeschriebenen Steinriesen bearbeitet.‡빌더바르 요새의 연구원 아데란이 룬문자 바위 거인 4마리를 쓰러뜨리고 룬 채집용 곡괭이를 사용해 조사해 달라고 했습니다.‡El investigador Aderan en el Fuerte Vildervar quiere que uses el pico para buscar runas sobre los cuerpos de 4 gigantes de piedra con runas.‡El investigador Aderan en el Fuerte Vildervar quiere que uses el pico para buscar runas sobre los cuerpos de 4 gigantes de piedra con runas.‡Le Chercheur Aderan à Fort Hardivar veut que vous utilisiez le Piolet cherche-rune sur les cadavres de 4 Géants de pierre runifiés.‡维德瓦堡垒的研究员艾德兰要你在4个符文石巨人的尸体上使用符文搜寻之锄。‡威德瓦堡壘的研究員艾德蘭要你對4個符文石巨人的屍體使用符文追尋之鎬。',
  }
},
[11356] = {
  {
    'A matriarca fantasiada‡Переодетая попечительница сирот‡Kostümierte Waisenmatrone‡축제 의상을 입은 보육원 원장님‡Supervisora de huérfanos disfrazada‡Supervisora de huérfanos disfrazada‡La directrice d\'orphelinat costumée‡穿戏服的孤儿院长‡變裝的孤兒監護員',
    nil,
    'Fale com uma Matriarca Fantasiada na Vila d\'Ouro, no Entreposto Lazúli ou em Kharanos.‡Поговорите с переодетой попечительницей сирот в Златоземье, Караносе или на Лазурной заставе.‡Sprecht mit einer kostümierten Waisenmatrone in Goldhain, Kharanos oder bei der Azurwacht.‡황금골이나 카라노스 또는 하늘 감시초소의 축제 의상을 입은 보육원 원장님과 대화해야 합니다.‡Habla con una supervisora de huérfanos enmascarada en Villadorada, en Kharanos o en la Avanzada Azur.‡Habla con una supervisora de huérfanos enmascarada en Villadorada, en Kharanos o en la Avanzada Azur.‡Parlez à une Directrice d\'orphelinat costumée à Comté-de-l\'Or, à Kharanos ou au Guet d\'azur.‡到闪金镇、卡拉诺斯或碧蓝岗哨去，与穿戏服的孤儿院长谈一谈。‡跟閃金鎮、卡拉諾斯，或者藍色守望的其中一位變裝的孤兒監護員談話。',
  }
},
[11357] = {
  {
    'Matriarca Mascarada‡Попечительница сирот в маске‡Maskierte Waisenmatrone‡가면 쓴 보육원 원장님‡Supervisora de huérfanos enmascarada‡Supervisora de huérfanos enmascarada‡La directrice d\'orphelinat masquée‡戴面具的孤儿院长‡戴面具的孤兒監護員',
    nil,
    'Fale com uma Matriarca Mascarada no Monte Navalha, em Montalvo ou na Praça Asa do Falcão.‡Поговорите с попечительницей сирот в маске в Колючем Холме, Брилле или на площади Соколиных Крыльев.‡Sprecht mit einer maskierten Waisenmatrone in Klingenhügel, Brill oder beim Falkenplatz.‡듀로타의 칼바위 언덕, 티리스팔 숲의 브릴, 아니면 영원노래 숲의 매날개 광장에 있는 가면 쓴 보육원 원장님과 대화해야 합니다.‡Habla con la supervisora de huérfanos enmascarada en Cerrotajo, en Rémol o en Plaza Alalcón.‡Habla con la supervisora de huérfanos enmascarada en Cerrotajo, en Rémol o en Plaza Alalcón.‡Parlez à une Directrice d\'orphelinat masquée à Tranchecolline, à Brill ou sur la Place de l\'Épervier.‡到剃刀岭、布瑞尔或者鹰翼广场去，与戴面具的孤儿院长谈一谈。‡跟剃刀嶺、布瑞爾，或者獵鷹之翼廣場的其中一位戴面具的孤兒監護員談話。',
  }
},
[11358] = {
  {
    'O magneto‡Магнит‡Der Leitstein‡거인을 이끄는 힘‡La magnetita‡La magnetita‡L\'aimant‡破碎石板‡誘因',
    nil,
    'O Pesquisador Aragão, do Forte Vildervar, quer que você compare a Amostra de Runa com a Tabuleta Partida.‡Ученый Адеран из крепости Вилдервар просит вас сравнить образцы рун с надписями на разбитой скрижали.‡Forscher Aderan in Fort Wildervar möchte, dass Ihr das Probestück einer Rune mit der zerbrochenen Schrifttafel vergleicht.‡빌더바르 요새의 연구원 아데란이 룬 견본과 부서진 서판을 비교해 달라고 했습니다.‡El investigador Aderan del Fuerte Vildervar quiere que compares la muestra de runa con la tablilla rota.‡El investigador Aderan del Fuerte Vildervar quiere que compares la muestra de runa con la tablilla rota.‡Le Chercheur Aderan, au Fort Hardivar, veut que vous compariez l’Échantillon de rune avec la Tablette brisée.‡维德瓦堡垒的研究员艾德兰要你对符文样本与破碎石板进行比较。‡威德瓦堡壘的研究員艾德蘭要你去比較符文樣本與破損的石板。',
  }
},
[11359] = {
  {
    'Megalito demolidor‡Уничтожить Мегалита‡Megalith zertrümmern‡메가리스를 처치하라‡Destruyendo a Megalito‡Destruyendo a Megalito‡Démolir Mégalithe‡击败麦加利斯‡破壞麥加力斯',
    nil,
    'Derrote Megalito e fale novamente com o Pesquisador Aragão no Forte Vildervar, que fica no Fiorde Uivante.‡Уничтожьте Мегалита и вернитесь к ученому Адерану в крепость Вилдервар.‡Bezwingt Megalith und kehrt anschließend zu Forscher Aderan in Fort Wildervar zurück.‡메가리스를 처치하고 빌더바르 요새의 연구원 아데란에게 가야 합니다.‡Derrota a Megalito y vuelve a ver al investigador Aderan al Fuerte Vildervar.‡Derrota a Megalito y vuelve a ver al investigador Aderan al Fuerte Vildervar.‡Triomphez de Mégalithe puis revenez voir le Chercheur Aderan au Fort Hardivar.‡击败麦加利斯，然后返回维德瓦堡垒，向研究员艾德兰复命。‡擊敗麥加力斯，並且向威德瓦堡壘的研究員艾德蘭回報。',
  }
},
[11360] = {
  {
    'Treinamento de bombeiros‡Учения пожарной бригады‡Übung bei der Brandwache‡소방대 훈련‡Prácticas para bomberos‡Prácticas para bomberos‡Un entraînement de pompier‡消防练习‡救火隊演練',
    nil,
    'Jogue Baldes d\'Água em 5 chamas e, a seguir, fale com a Matriarca Fantasiada.‡Выплесните воду из ведра в 5 очагов пожара. Затем поговорите с переодетой попечительницей сирот.‡Löscht 5 Feuer mit Wassereimern und sprecht anschließend mit der kostümierten Waisenmatrone.‡물동이를 불길에 5번 던지고 나서 축제 의상을 입은 보육원 원장님과 대화해야 합니다.‡Echa cubos de agua en 5 fuegos y después vuelve para hablar con la supervisora de huérfanos disfrazada.‡Echa cubos de agua en 5 fuegos y después vuelve para hablar con la supervisora de huérfanos disfrazada.‡Jetez des seaux d\'eau sur 5 feux, puis revenez parler à la Directrice d\'orphelinat costumée.‡将小水桶里的水倒在5处火盆上，然后与穿戏服的孤儿院长谈一谈。‡把水桶丟向5個火源，然後跟變裝的孤兒監護員談話。',
  }
},
[11361] = {
  {
    'Treinamento contra o fogo‡Учения пожарной бригады‡Feuerübung‡소방대 훈련‡Entrenamiento de bomberos‡Entrenamiento de bomberos‡L\'entraînement au combat du feu‡灭火练习‡消防演練',
    nil,
    'Jogue Baldes d\'Água em 5 chamas e, a seguir, fale com a Matriarca Mascarada no Monte Navalha.‡Выплесните воду из ведра в 5 очагов пожара. Затем поговорите с попечительницей сирот в маске в Колючем Холме.‡Löscht 5 Feuer mit Wassereimern und sprecht anschließend mit der maskierten Waisenmatrone in Klingenhügel.‡물동이를 던져 불을 5번 끄고 칼바위 언덕의 가면 쓴 보육원 원장님과 대화해야 합니다.‡Echa cubos de agua en 5 hogueras y después habla con la supervisora de huérfanos enmascarada en Cerrotajo.‡Echa cubos de agua en 5 hogueras y después habla con la supervisora de huérfanos enmascarada en Cerrotajo.‡Jetez des seaux d\'eau sur 5 feux, puis parlez à nouveau à la Directrice d\'orphelinat masquée à Tranchecolline.‡将小水桶里的水倒在5处火盆上，然后回到剃刀岭，与戴面具的孤儿院长谈一谈。‡把水桶扔向5個火源，然後再和剃刀嶺的戴面具的孤兒監護員談談。',
  }
},
[11362] = {
  {
    'Procura-se: o báculo emplumado de Keli\'dan‡Разыскивается: Украшенный перьями посох Кели\'дана‡Gesucht: Keli\'dans gefiederter Stab‡구함: 켈리단의 깃털장식 지팡이‡Se busca: El báculo con plumas de Keli\'dan‡SE BUSCA: Báculo con plumas de Keli\'dan‡On recherche : Le bâton à plumes de Keli\'dan‡悬赏：克里丹的羽饰法杖‡懸賞:凱利丹的羽飾手杖',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar do Báculo Emplumado de Keli\'dan. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть украшенный перьями посох Кели\'дана. Принесите его ему в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Keli\'dans gefiederten Stab zu beschaffen. Bringt ihn zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 켈리단의 깃털장식 지팡이를 가져가 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el bastón con plumas de Keli\'dan. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el báculo con plumas de Keli\'dan. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Bâton à plumes de Keli\'dan. Apportez-le lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得克里丹的羽饰法杖。将法杖带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得凱利丹的羽飾手杖。將手杖帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11363] = {
  {
    'Procura-se: o selo de Carpunhal‡Разыскивается: печать Острорука‡Gesucht: Messerfausts Siegel‡구함: 블레이드피스트의 인장‡Se busca: El sello de Garrafilada‡SE BUSCA: Sello de Garrafilada‡On recherche : Le sceau de Lamepoing‡悬赏：刃拳的印记‡懸賞:刃拳的徽印',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar do Selo de Carpunhal. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть печать Острорука. Принесите ее ему в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Messerfausts Siegel zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 블레이드피스트의 인장을 가져가 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el sello de Garrafilada. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el sello de Garrafilada. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Sceau de Lamepoing. Apportez-le lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得刃拳的印记。将印记带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得刃拳的徽印。將徽印帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11364] = {
  {
    'Procuram-se: centuriões da Mão Despedaçada‡Разыскиваются: Центурионы клана Изувеченной Длани‡Gesucht: Zenturionen der Zerschmetterten Hand‡현상 수배: 으스러진 손의 백인대장‡Se busca: Centuriones Mano Destrozada‡SE BUSCA: Centuriones Mano Destrozada‡On recherche : Des centurions de la Main brisée‡悬赏：碎手百夫长‡懸賞:破碎之手百夫長',
    nil,
    'O Espreitador Etéreo Mah\'duun o incumbiu da morte de 4 Centuriões da Mão Despedaçada. Fale novamente com ele no Bairro Inferior de Shattrath quando todos estiverem mortos para receber a recompensa.‡Ловчий Пустоты Ма\'дуун поручает вам убить 4 центурионов из клана Изувеченной Длани. Вернитесь к нему в Нижний город Шаттрата за наградой, как только перебьете их всех.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 4 Zenturionen der Zerschmetterten Hand zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle dem Tod überantwortet wurden.‡으스러진 손의 백인대장 4명을 처치한 후에 샤트라스 고난의 거리에 있는 황천의 추적자 마둔에게 돌아와 보상금을 받아야 합니다.‡El acechador abisal Mah\'duun te ha encargado matar a 4 centuriones Mano Destrozada. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha encargado matar a 4 centuriones Mano Destrozada. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de tuer 4 Centurions de la Main Brisée. Revenez le voir à la Ville basse de Shattrath quand ils seront tous morts pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死4名碎手百夫长。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你殺死4名破碎之手百夫長。完成之後回到撒塔斯陰鬱城找他領取賞金。',
  }
},
[11365] = {
  {
    'A marcha dos gigantes‡Марш великанов‡Marsch der Riesen‡거인의 대이동‡La marcha de los gigantes‡La marcha de los gigantes‡La marche des géants‡巨人的迁徙‡巨人的行進',
    nil,
    'O Sábio Edmo, da Aldeia Casco Invernal, quer que você use a Picareta Cata-runa nos cadáveres de 4 Gigantes de Pedra Rúnicos.‡Ведун Эдан из Лагеря Заиндевевшего Копыта попросил вас использовать кирку поиска рун на трупах 4 рунных каменных великанов.‡Weiser Edan im Lager der Winterhufe möchte, dass Ihr mithilfe der Hacke zum Runensuchen die Leichen von 4 runenbeschriebenen Steinriesen bearbeitet.‡겨울발굽 야영지에 있는 현자 에단이 룬문자 바위 거인 4마리에 룬 채집용 곡괭이를 사용해보라고 했습니다.‡El sabio Edan en el Campamento Pezuña Invernal quiere que uses el pico para buscar runas sobre los cuerpos de 4 gigantes de piedra con runas.‡El sabio Edan en el Campamento Pezuña Invernal quiere que uses el pico para buscar runas sobre los cuerpos de 4 gigantes de piedra con runas.‡Le Sage Edan, au Camp Sabot-d’hiver, veut que vous utilisiez le Piolet cherche-rune sur les cadavres de 4 Géants de pierre runifiés.‡冬蹄营地的先知厄丹要你在4个符文石巨人的尸体上使用符文搜寻之锄。‡冬蹄營地的賢者伊丹要你對4個符文石巨人的屍體使用符文追尋之鎬。',
  }
},
[11366] = {
  {
    'O magneto‡Магнит‡Der Leitstein‡거인을 이끄는 힘‡La magnetita‡La magnetita‡L\'aimant‡破碎石板‡誘因',
    nil,
    'O Sábio Edmo, da Aldeia Casco Invernal, quer que você compare a Amostra de Runa com a Tabuleta Partida.‡Ведун Эдан из Лагеря Заиндевевшего Копыта просит вас сравнить образцы рун с надписями на разбитой скрижали.‡Weiser Edan im Lager der Winterhufe möchte, dass Ihr die Runenprobe mit der zerbrochenen Schrifttafel vergleicht.‡겨울발굽 야영지에 있는 현자 에단이 룬 견본과 부서진 서판을 비교해 달라고 했습니다.‡El sabio Edan del Campamento Pezuña Invernal quiere que compares la muestra de runa con la tablilla rota.‡El sabio Edan del Campamento Pezuña Invernal quiere que compares la muestra de runa con la tablilla rota.‡Le Sage Edan, au Camp Sabot-d’hiver, veut que vous compariez l’Échantillon de rune avec la Tablette brisée.‡冬蹄营地的先知厄丹要你对符文样本与破碎石板进行比较。‡冬蹄營地的賢者伊丹希望你去比較符文樣本與破損的石板。',
  }
},
[11367] = {
  {
    'Megalito demolidor‡Уничтожить Мегалита‡Megalith zertrümmern‡메가리스를 처치하라‡Destruyendo a Megalito‡Destruyendo a Megalito‡Démolir Mégalithe‡击败麦加利斯‡破壞麥加力斯',
    nil,
    'Derrote o Megalito e fale novamente com o Sábio Edmo na Aldeia Casco Invernal, no Fiorde Uivante.‡Уничтожьте Мегалита и вернитесь к ведуну Эдану в Лагерь Заиндевевшего Копыта.‡Bezwingt Megalith und kehrt anschließend zu Weiser Edan im Lager der Winterhufe zurück.‡메가리스를 처치하고 겨울발굽 야영지에 있는 현자 에단에게 가야 합니다.‡Derrota a Megalito y vuelve a ver al sabio Edan al Campamento Pezuña Invernal.‡Derrota a Megalito y vuelve a ver al sabio Edan al Campamento Pezuña Invernal.‡Triomphez de Mégalithe puis revenez voir le Sage Edan au Camp Sabot-d\'hiver.‡击败麦加利斯，然后返回冬蹄营地，向先知厄丹复命。‡擊敗麥加力斯，並且向冬蹄營地的賢者伊丹回報。',
  }
},
[11368] = {
  {
    'Procura-se: o coração de Atolaço‡Разыскивается: сердце Квагмирран‡Gesucht: Das Herz von Quagmirran‡구함: 쿠아그미란의 심장‡Se busca: El corazón de Quagmirran‡SE BUSCA: El corazón de Quagmirran‡On recherche : Le cœur de Bourbierreux‡悬赏：夸格米拉之心‡懸賞:奎克米瑞之心',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar do Coração de Atolaço. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте сердце Зыбуна и доставьте его торговцу ветром Зариму в Нижний город Шаттрата за вознаграждение. |n|nЗадание можно выполнить только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm das Herz von Quagmirran zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 쿠아그미란의 심장을 가져가 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el corazón de Quagmirran. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el corazón de Quagmirran. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Cœur de Bourbierreux. Apportez-le lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你取回夸格米拉之心。将心脏带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得奎克米瑞之心。將這顆心帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11369] = {
  {
    'Procura-se: um ovo de espreitadora negra‡Разыскивается: яйцо Черной Охотницы‡Gesucht: Ei der Schattenmutter‡구함: 검은 추적자의 알‡Se busca: Un huevo de acechadora negra‡SE BUSCA: Un huevo de Acechadora negra‡On recherche : Un œuf de traqueuse noire‡悬赏：黑色阔步者的卵‡懸賞:黑色潛獵者的蛋',
    nil,
    'O Mercador do Vento Zhareem quer que você consiga um Ovo de Espreitadora Negra. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте яйцо Черной Охотницы и доставьте его торговцу ветром Зариму в Нижний город Шаттрата за вознаграждение. |n|nЗадание можно выполнить только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm ein Ei der Schattenmutter zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 검은 추적자의 알을 가져다주면 보상을 받을 수 있습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem quiere que consigas un huevo de Acechadora Negra. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem quiere que consigas un huevo de Acechadora Negra. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer un Œuf de traqueuse noire. Apportez-le lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你取回一枚黑色阔步者的卵。将卵带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得黑色潛獵者的蛋。將蛋帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11370] = {
  {
    'Procura-se: o tratado do senhor da guerra‡Требуется: трактат полководца‡Gesucht: Die Aufzeichnungen des Kriegsherren‡구함: 장군의 병법서‡Se busca: El Tratado del Señor de la Guerra‡SE BUSCA: El tratado del Señor de la guerra‡On recherche : Le traité du seigneur de guerre‡悬赏：督军的论文‡懸賞:督軍的論述',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar do Tratado do Senhor da Guerra. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте трактат полководца и доставьте его торговцу ветром Зариму в Нижний город Шаттрата за вознаграждение. |n|nЗадание можно выполнить только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm die Aufzeichnungen des Kriegsherren zu beschaffen. Bringt sie zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 장군의 병법서를 가져다주면 보상을 받을 수 있습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el Tratado del Señor de la Guerra. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el Tratado del Señor de la Guerra. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Traité du seigneur de guerre. Apportez-le lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得督军的论文。将论文带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得督軍的論述。將東西帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11371] = {
  {
    'Procuram-se: Mirmidões Presacurva‡Разыскиваются: Мирмидоны Резервуара Кривого Клыка‡Gesucht: Myrmidonen des Echsenkessels‡현상 수배: 갈퀴송곳니 수호병‡Se busca: Mirmidones Colmillo Torcido‡SE BUSCA: Mirmidones Colmillo Torcido‡On recherche : Des myrmidons de Glissecroc‡悬赏：盘牙侍从‡懸賞:盤牙部屬',
    nil,
    'O Espreitador Etéreo Mah\'duun pediu que você mate 14 Mirmidões Presacurva. Fale novamente com ele no Bairro Inferior de Shattrath quando todos estiverem mortos para receber a recompensa.‡Ловчий Пустоты Ма\'дуун требует, чтобы вы убили 14 мирмидонов из резервуара Кривого Клыка. По исполнению задания возвращайтесь к Ма\'дууну в Нижний город Шаттрата за вознаграждением.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 14 Myrmidonen des Echsenkessels zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle dem Tod überantwortet wurden.‡갈퀴송곳니 수호병 14마리를 처치하고 샤트라스 고난의 거리에 있는 황천의 추적자 마둔에게 가야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates a 14 mirmidones Colmillo Torcido. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates a 14 mirmidones Colmillo Torcido. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de tuer 14 Myrmidons de Glissecroc. Revenez le voir à la Ville basse de Shattrath quand ils seront tous morts pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死14名盘牙侍从。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你殺死14名盤牙部屬。完成之後回到撒塔斯陰鬱城找他領取賞金。',
  }
},
[11372] = {
  {
    'Procura-se: o penacho de Ikiss‡Разыскиваются: головные перья Айкисса‡Gesucht: Die Kopfschmuckfedern von Ikiss‡구함: 이키스의 머리 깃털‡Se busca: Las plumas del tocado de Ikiss‡SE BUSCA: Las plumas del tocado de Ikiss‡On recherche : Le panache d\'Ikiss‡悬赏：艾吉斯的冠羽‡懸賞:伊奇斯的冠羽',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar dos Penachos do Ikiss, o Rei-gadanho. Leve-os para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте перья с головы Айкисса и вернитесь к торговцу ветром Зариму, в Нижний город Шаттрата.|n|nЭто задание может быть выполнено только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm die Kopfschmuckfedern von Ikiss zu beschaffen. Bringt sie zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 이키스의 머리 깃털을 가져다주면 보상을 받을 수 있습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas las plumas del tocado de Ikiss. Llévaselas al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas las plumas del tocado de Ikiss. Llévaselas al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Panache d\'Ikiss. Apportez-le-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得艾吉斯的冠羽。将羽毛带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得伊奇斯的冠羽。將東西帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11373] = {
  {
    'Procura-se: o magnífico pingente de Shaffar‡Разыскивается: Заговоренный Амулет Шаффара‡Gesucht: Shaffars wundersames Amulett‡구함: 샤파르의 불가사의한 아뮬렛‡Se busca: El amuleto maravilloso de Shaffar‡Se busca: El amuleto maravilloso de Shaffar‡On recherche : L\'amulette merveilleuse de Shaffar‡悬赏：沙法尔的精致饰物‡懸賞:薩法爾的奇妙護符',
    nil,
    'O Mercador do Vento Zhareem quer que você consiga o Magnífico Amuleto de Shaffar. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте заговоренный амулет Шаффара и вернитесь к торговцу ветром Зариму, в Нижний город Шаттрата.|n|nЭто задание может быть выполнено только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Shaffars wundersames Amulett zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 샤파르의 불가사의한 아뮬렛을 가져다주면 보상을 받을 수 있습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el amuleto maravilloso de Shaffar. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el amuleto maravilloso de Shaffar. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer l\'Amulette merveilleuse de Shaffar. Apportez-la-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得沙法尔的精致饰物。将饰物带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得薩法爾的奇妙護符。將東西帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11374] = {
  {
    'Procura-se: a pedra da alma do Exarca‡Разыскивается: Самоцвет души Экзарха‡Gesucht: Der Seelenedelstein des Exarchen‡구함: 총독의 영혼 보석‡Se busca: La gema de alma del exarca‡SE BUSCA: La gema de alma del exarca‡On recherche : La gemme d\'âme de l\'exarque‡悬赏：主教的灵魂宝钻‡懸賞:主教的靈魂寶石',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar da pedra da alma do Exarca. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте самоцвет души экзарха и вернитесь к торговцу ветром Зариму, в Нижний город Шаттрата.|n|nЭто задание может быть выполнено только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm den Seelenedelstein des Exarchen zu beschaffen. Bringt diesen zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡총독의 영혼 보석을 회수하고 샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 돌아와 보상을 받으십시오.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas la gema de alma del exarca. Llévasela al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas la gema de alma del exarca. Llévasela al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer la Gemme d\'âme de l\'exarque. Apportez-la-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得主教的灵魂宝钻。将宝钻带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得主教的靈魂寶石。將東西帶回撒塔斯陰鬱城交給他以領取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11375] = {
  {
    'Procura-se: o sussurro do Murmúrio‡Разыскивается: Шепот Бормотуна‡Gesucht: Murmurs Flüstern‡구함: 울림의 소리‡Se busca: El susurro de Murmullo‡SE BUSCA: El susurro de Murmullo‡On recherche : Le murmure de Marmon‡悬赏：摩摩尔的低语‡懸賞:莫爾墨的低語',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar do Sussurro do Murmúrio. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Добудьте шепот Бормотуна и вернитесь к торговцу ветром Зариму, в Нижний город Шаттрата.|n|nЭто задание может быть выполнено только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Murmurs Flüstern zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 울림의 소리를 가져가 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el susurro de Murmullo. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el susurro de Murmullo. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Murmure de Marmon. Apportez-le-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得摩摩尔的低语。将这件器物带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得莫爾墨的低語。把東西帶到撒塔斯陰鬱城交給他好換取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11376] = {
  {
    'Procuram-se: instrutoras maliciosas‡Разыскиваются: злобные инструкторы‡Gesucht: Bösartige Ausbilderinnen‡현상 수배: 무시무시한 주임교관‡Se busca: Instructoras maliciosas‡SE BUSCA: Instructoras maliciosas‡On recherche : Des instructrices malveillantes‡悬赏：恶毒导师‡懸賞:惡毒導師',
    nil,
    'O Espreitador Etéreo Mah\'duun quer que você mate 3 Instrutoras Maliciosas. Fale novamente com ele no Bairro Inferior de Shattrath quando todos estiverem mortos para receber a recompensa.‡Убейте для ловчего Пустоты Ма\'дууна 3 злобных инструкторов, по выполнении вернитесь к нему в Нижний город Шаттрата, чтобы получить свою награду.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 3 bösartige Ausbilderinnen zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle dem Tod überantwortet wurden.‡무시무시한 주임교관 3마리를 처치한 후, 샤트라스의 고난의 거리에 있는 황천의 추적자 마둔에게 돌아가 보상을 받아야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates a 3 instructoras maliciosas. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todas muertas para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates a 3 instructoras maliciosas. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todas muertas para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de tuer 3 Instructrices malveillantes. Revenez le voir à la Ville basse de Shattrath quand elles seront toutes mortes pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死3名恶毒导师。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你殺死3名惡毒導師。完成之後回到撒塔斯陰鬱城找他領取賞金。',
  }
},
[11377] = {
  {
    'A vingança é doce‡Месть сладка‡Rache ist süß‡복수의 감칠맛‡La venganza es sabrosa‡La venganza es sabrosa‡La vengeance est un plat...‡甜美的复仇‡美味的復仇',
    nil,
    'Troagrô, no Bairro Inferior, quer que você cozinhe um Ensopado de Kaliri usando a panela dele. Fale com ele novamente quando terminar.‡Скалл из Нижнего города просит вас приготовить похлебку из калири в его кухонном котелке. По выполнении вернитесь к нему.‡Der Rokk im Unteren Viertel von Shattrath hat Euch darum gebeten, mithilfe seines Kochtopfs einen Kalirieintopf zu kochen. Kehrt anschließend zu ihm zurück.‡고난의 거리에 있는 로크가 준 요리 냄비로 칼리리 스튜를 만들고 그에게 가야 합니다.‡El Rokk en el Bajo Arrabal te ha pedido que cocines estofado de kaliri usando su olla. Vuelve a verle cuando esté listo.‡El Rokk en el Bajo Arrabal te ha pedido que cocines estofado de kaliri usando su olla. Vuelve a verle cuando esté listo.‡Le Rokk, dans la Ville basse, vous a demandé de préparer du Ragoût de kaliri avec sa Marmite. Retournez le voir quand ce sera fait.‡贫民窟的巨石洛克希望你用他的烹锅制作一些炖卡利鸟，完成之后回去找他。‡陰鬱城的洛克要你用他的煮菜鍋幫他料理一些卡里瑞燉肉。做好之後回去找他。',
  }
},
[11378] = {
  {
    'Procura-se: Caçador das Eras‡Разыскивается: Голова Охотника Вечности‡Gesucht: Der Kopf des Epochenjägers‡구함: 시대의 사냥꾼 머리‡Se busca: La cabeza del cazador de Época‡Se busca: La cabeza del cazador de Época‡On recherche : La tête du chasseur d\'époques‡悬赏：时空猎手的徽记‡懸賞:紀元狩獵者的頭顱',
    nil,
    'O Mercador do Vento Zhareem pediu para você obter a Cabeça do Caçador das Eras. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть голову Охотника Вечности. Доставьте ее в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm den Kopf des Epochenjägers zu beschaffen. Bringt diesen zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 시대의 사냥꾼 머리를 가져가서 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas la cabeza del cazador de Época. Llévasela al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas la cabeza del cazador de Época. Llévasela al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer la Tête du chasseur d\'époques. Apportez-la-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你取回时空猎手的徽记。将徽记带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得紀元狩獵者的頭顱。帶到撒塔斯的陰鬱城交給他以換取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11379] = {
  {
    'Ensopado super quente‡Очень горячая похлебка‡Superheißes Ragout‡엄청나게 매운 스튜‡Un estofado súper picante‡Un estofado súper picante‡Un ragoût très épicé‡超级美味烧烤‡超燙的燉肉',
    nil,
    'Troagrô, no Bairro Inferior, quer que você cozinhe um Escondidinho que o Demônio Grelhou usando a panela dele, duas Costelinhas de Mok\'Nathal e uma Serpente Crocante. Fale com ele novamente quando terminar.‡Скалл из Нижнего города просит вас приготовить немного невероятной демонической похлебки в его кухонном котелке. Вернитесь, когда приготовите.‡Der Rokk im Unteren Viertel von Shattrath hat Euch darum gebeten, mithilfe seines Kochtopfs ein Dämonenragout Surprise, zwei Rippchen der Mok\'Nathal und eine Knusperschlange zu kochen. Kehrt anschließend zu ihm zurück.‡모크나탈 갈비 2개와 바삭바삭 천둥매 튀김 1개를 로크가 준 요리 냄비로 조리해 악마불 별미를 만든 후, 고난의 거리에 있는 로크에게 가야 합니다.‡El Rokk en el Bajo Arrabal te ha pedido que cocines sorpresa diabólica a la parrilla usando su olla, dos costillitas de Mok\'Nathal y una serpiente crujiente. Vuelve a verle cuando esté listo.‡El Rokk en el Bajo Arrabal te ha pedido que cocines sorpresa diabólica a la parrilla usando su olla, dos costillitas de Mok\'Nathal y una serpiente crujiente. Vuelve a verle cuando esté listo.‡Le Rokk, dans la Ville basse, vous a demandé de préparer de la Surprise grillée sur démon dans sa Marmite avec deux Côtelettes mok\'nathal et un Serpent croustillant. Retournez le voir quand ce sera fait.‡贫民窟的巨石洛克希望你用他的烹锅、两份莫克纳萨肋排和一份香脆蛇制作一些恶魔烧烤，完成之后回去找他。‡陰鬱城的洛克要你用他的煮菜鍋烹製一些驚奇惡魔燉煮，需要兩份摩克納薩爾小肋排，還有一份的香脆巨蛇肉。完成時回去找他。',
  }
},
[11380] = {
  {
    'Manalicioso‡Мания‡Manaziös‡맛있는 마나‡Manalicioso‡Manalicioso‡Manalicieux‡魔法美味‡美味法力',
    nil,
    'Troagrô, no Bairro Inferior, quer que você colete 15 Manamoras dos Eco-domos em Eternévoa.‡Скалл из Нижнего города просит вас принести 15 манаягод из заповедников Пустоверти.‡Der Rokk im Unteren Viertel von Shattrath möchte, dass Ihr 15 Manabeeren in den Biokuppeln im Nethersturm sammelt.‡고난의 거리에 있는 로크가 황천의 폭풍에 있는 생태지구에서 마나딸기 15개를 모아 달라고 했습니다.‡El Rokk en el Bajo Arrabal te ha pedido que recojas 15 frutos de maná de los Ecodomos en Tormenta Abisal.‡El Rokk en el Bajo Arrabal te ha pedido que recojas 15 frutos de maná de los Ecodomos en Tormenta Abisal.‡Le Rokk, dans la Ville basse, vous a demandé de récupérer 15 Baies de mana dans les Écodômes de Raz-de-Néant.‡贫民窟的巨石洛克要求你从虚空风暴的生态圆顶中收集15颗魔法莓，完成之后回去找他。‡陰鬱城的洛克要你去虛空風暴的秘境收集15個法力莓果。',
  }
},
[11381] = {
  {
    'Canja para a alma‡Супчик для души‡Suppe für die Seele‡영혼의 수프‡Sopa para el alma‡Sopa para el alma‡Une soupe pour l\'âme‡灵魂之汤‡靈魂之湯',
    nil,
    'Troagrô, no Bairro Inferior, quer que você cozinhe uma Canja Espiritual usando a panela dele. Fale novamente com ele quando terminar.‡Скалл из Нижнего города просит вас приготовить суп предков в его кухонном котелке. По выполнении вернитесь к нему.‡Der Rokk im Unteren Viertel von Shattrath hat Euch darum gebeten, mithilfe seines Kochtopfs eine spirituelle Suppe zu kochen. Kehrt anschließend zu ihm zurück.‡고난의 거리에 있는 로크가 준 냄비로 영혼의 수프를 요리하고 그에게 가야 합니다.‡El Rokk en el Bajo Arrabal te ha pedido que cocines sopa espiritual usando su olla. Vuelve a verle cuando esté lista.‡El Rokk en el Bajo Arrabal te ha pedido que cocines sopa espiritual usando su olla. Vuelve a verle cuando esté lista.‡Le Rokk, dans la Ville basse, vous a demandé de préparer de la Soupe spirituelle avec sa Marmite. Retournez le voir quand ce sera fait.‡贫民窟的巨石洛克希望你用他的烹锅制作一些灵魂之汤，完成之后回去找他。‡陰鬱城的洛克要你用他的煮菜鍋煮一些心靈雞湯。完成之後回去找他。',
  }
},
[11382] = {
  {
    'Procura-se: Ampulheta de Aeonus‡Разыскиваются: песочные часы Эонуса‡Gesucht: Aeonus\' Stundenglas‡구함: 아에누스의 모래시계‡Se busca: El reloj de arena de Aeonus‡SE BUSCA: Reloj de arena de Aeonus‡On recherche : Le sablier d\'Aeonus‡悬赏：埃欧努斯的沙漏‡懸賞:艾奧那斯的沙漏',
    nil,
    'O Mercador de Vento Zhareem pediu para você adquirir uma Ampulheta de Aeonus. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть песочные часы Эонуса. Доставьте их в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Aeonus\' Stundenglas zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 아에누스의 모래시계를 가져가서 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el reloj de arena de Aeonus. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el reloj de arena de Aeonus. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Sablier d\'Aeonus. Apportez-le-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得埃欧努斯的沙漏。将沙漏带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得艾奧那斯的沙漏。帶到撒塔斯的陰鬱城交給他以換取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11383] = {
  {
    'Procuram-se: Senhores da Fenda‡Разыскиваются: Повелители временных разломов‡Gesucht: Fürsten der Zeitenrisse‡현상 수배: 균열의 군주‡Se busca: Señores de la falla‡SE BUSCA: Señores de la falla‡On recherche : Des seigneurs des failles‡悬赏：裂隙领主‡懸賞:裂隙領主',
    nil,
    'Fale novamente com ele no Bairro Inferior de Shattrath quando todos estiverem mortos para receber a recompensa.‡Ловчий Пустоты Ма\'дуун хочет, чтобы вы убили 4 повелителей временных разломов. Вернитесь к нему в Нижний город Шаттрата за наградой, когда они будут убиты.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 4 Fürsten der Zeitenrisse zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle dem Tod überantwortet wurden.‡균열의 군주 4마리를 처치한 후, 샤트라스의 고난의 거리에 있는 황천의 추적자 마둔에게 돌아가 보상을 받아야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates a 4 señores de la falla. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates a 4 señores de la falla. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de tuer 4 Seigneurs des failles. Revenez le voir à la Ville basse de Shattrath quand ils seront tous morts pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死4名裂隙领主。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你殺死4名裂隙領主。完成之後回到撒塔斯陰鬱城找他領取賞金。',
  }
},
[11384] = {
  {
    'Procura-se: uma muda de estilhaço dimensional‡Разыскивается: Отросток Узлодревня‡Gesucht: Warpzweigsplitter‡구함: 차원의 분리자 가지‡Se busca: Un esqueje de disidente de distorsión‡SE BUSCA: Esqueje de disidente de distorsión‡On recherche : Une rognure de Brise-Dimension‡悬赏：扭木碎片‡懸賞:扭曲分裂者的剪枝',
    nil,
    'O Mercador do Vento Zhareem pediu para você conseguir uma Muda de Estilhaço Dimensional. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть отросток Узлодревня. Доставьте его ему в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm einen Warpzweigsplitter zu beschaffen. Bringt diesen zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡차원의 분리자 가지를 구해서 샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 돌아와 보상을 받으십시오.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas un esqueje de disidente de distorsión. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas un esqueje de disidente de distorsión. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer une Rognure de Brise-dimension. Apportez-la-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得一份扭木碎片。将碎片带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得扭曲分裂者的剪枝。帶到撒塔斯的陰鬱城交給他以換取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11385] = {
  {
    'Procuram-se: canalizadores Anélion‡Разыскиваются: Солнцеловы-чаротворцы‡Gesucht: Kanalisierer der Sonnensucher‡현상 수배: 태양추적대 역술사‡Se busca: Canalizadores Buscasol‡SE BUSCA: Canalizadores Buscasol‡On recherche : Des canalistes Cherche-soleil‡悬赏：寻日者导魔者‡懸賞:尋日導魔師',
    nil,
    'O Espreitador Etéreo Mah\'duun quer que você mate 6 Canalizadores Anélion. Fale novamente com ele no Bairro Inferior de Shattrath quando todos estiverem mortos para receber a recompensa.‡Ловчий Пустоты Ма\'дуун хочет, чтобы вы убили 6 солнцеловов-чаротворцев. Вернитесь к нему в Нижний город Шаттрата, когда перебьете их, чтобы забрать награду.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 6 Kanalisierer der Sonnensucher zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle dem Tod überantwortet wurden.‡태양추적대 역술사 6명을 처치한 후, 샤트라스의 고난의 거리에 있는 황천의 추적자 마둔에게 돌아가 보상을 받아야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates 6 canalizadores Buscasol. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates 6 canalizadores Buscasol. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de tuer 6 Canalistes Cherche-soleil. Revenez le voir à la Ville basse de Shattrath quand ils seront tous morts pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死6名寻日者导魔者。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你殺死6名尋日導魔師。完成之後回到撒塔斯陰鬱城找他領取賞金。',
  }
},
[11386] = {
  {
    'Procura-se: o projetor de Pathaleon‡Разыскивается: Проектор Паталеона‡Gesucht: Pathaleons Projektionsgerät‡구함: 파탈리온의 투사기‡Se busca: El proyector de Pathaleon‡SE BUSCA: Proyector de Pathaleon‡On recherche : Le projecteur de Pathaleon‡悬赏：帕萨雷恩的投影仪‡懸賞:帕薩里歐的投映器',
    nil,
    'O Mercador do Vento Zhareem pediu para você conseguir o Projetor de Pathaleon. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть проектор Паталеона. Доставьте его в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Pathaleons Projektionsgerät zu beschaffen. Bringt es zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡파탈리온의 투사기를 구해서 샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 가져다주고 보상을 받으십시오.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el proyector de Pathaleon. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el proyector de Pathaleon. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Projecteur de Pathaleon. Apportez-le-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得帕萨雷恩的投影仪。将投影仪带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得帕薩里歐的投映器。帶到撒塔斯的陰鬱城交給他以換取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11387] = {
  {
    'Procuram-se: destruidores da forja da tormenta‡Разыскиваются: разрушители из кузни бурь‡Gesucht: Zerstörer der Sturmschmiede‡현상 수배: 폭풍우 괴철로 파괴자‡Se busca: Destructores de Forja de Tempestad‡SE BUSCA: Destructores de Forja de Tempestad‡On recherche : Des destructeurs Forge-tempête‡悬赏：风暴锻铸摧毁者‡懸賞:風暴要塞-熔爐毀滅者',
    nil,
    'O Espreitador Etéreo Mah\'duun quer que você destrua 5 Destruidores da Forja da Tormenta. Fale novamente com ele no Bairro Inferior de Shattrath quando todos estiverem mortos para receber a recompensa.‡Ловчий Пустоты Ма\'дуун хочет, чтобы вы уничтожили 5 разрушителей из кузни бурь. Вернитесь к нему в Нижний город Шаттрата, когда перебьете их, чтобы забрать награду.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 5 Zerstörer der Sturmschmiede zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle vernichtet wurden.‡폭풍우 괴철로 파괴자 5기를 처치한 후, 샤트라스 고난의 거리에 있는 황천의 추적자 마둔에게 돌아가 보상을 받아야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates 5 destructores de Forja de Tempestad. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates 5 destructores de Forja de Tempestad. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de détruire 5 Destructeurs Forge-tempête. Revenez le voir à la Ville basse de Shattrath quand ils seront tous morts pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死5名风暴锻铸摧毁者。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你殺死5名風暴要塞-熔爐毀滅者。完成之後回到撒塔斯陰鬱城找他領取賞金。',
  }
},
[11388] = {
  {
    'Procura-se: o pergaminho de Skiriss‡Разыскивается: Свиток Скайрисса‡Gesucht: Horizontiss\' Schriftrolle‡구함: 스키리스의 두루마리‡Se busca: El pergamino de Cieloriss‡SE BUSCA: El pergamino de Cieloriss‡On recherche : Le parchemin de Cieuriss‡悬赏：斯克瑞斯的卷轴‡懸賞:史蓋力司卷軸',
    nil,
    'O Mercador do Vento Zhareem pediu para você se apoderar do Pergaminho de Skiriss. Entregue para ele no Bairro Inferior de Shattrath e receba a recompensa.|n|nEsta missão só pode ser concluída no modo heroico.‡Торговец ветром Зарим просит вас добыть свиток Скайрисса. Доставьте его в Нижний город Шаттрата и получите награду.|n|nЭто задание выполняется только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm Horizontiss\' Schriftrolle zu beschaffen. Bringt sie zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡스키리스의 두루마리를 구한 후 샤트라스 고난의 거리에 있는 바람의 무역상 자림에게 돌아와 보상을 받으십시오.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el pergamino de Cieloriss. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el pergamino de Cieloriss. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer le Parchemin de Cieuriss. Apportez-le-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'en mode héroïque.‡商人扎雷姆要求你夺得斯克瑞斯的卷轴。将卷轴带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式下完成。‡風之貿易者札令姆要你取得史蓋力司卷軸。帶到撒塔斯的陰鬱城交給他以換取賞金。|n|n這個任務只能在英雄難度中完成。',
  }
},
[11389] = {
  {
    'Procuram-se: sentinelas de Arcatraz‡Разыскиваются: Часовые Аркатраца‡Gesucht: Schildwachen der Arkatraz‡현상 수배: 알카트라즈 파수병‡Se busca: Centinelas de Arcatraz‡SE BUSCA: Centinelas de Arcatraz‡On recherche : Des sentinelles de l\'Arcatraz‡悬赏：禁魔监狱斥候‡懸賞:亞克崔茲哨兵',
    nil,
    'O Espreitador Etéreo Mah\'duun quer que você desmantele 5 Sentinelas de Arcatraz. Fale novamente com ele no Bairro Inferior de Shattrath quando a tarefa for concluída para receber a recompensa.‡Ловчий Пустоты Ма\'дуун хочет, чтобы вы навсегда деактивировали 5 часовых Аркатраца. Вернитесь к нему в Нижний город Шаттрата, когда выполните задание, чтобы забрать награду.‡Netherpirscher Mah\'duun hat Euch damit beauftragt, 5 Schildwachen der Arkatraz zu töten. Kehrt erst zu ihm in das Untere Viertel in Shattrath zurück, wenn sie alle dem Tod überantwortet wurden.‡알카트라즈 파수병 5명을 처치한 후, 샤트라스 고난의 거리에 있는 황천의 추적자 마둔에게 돌아와 보상을 받아야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates a 5 centinelas de Arcatraz. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates a 5 centinelas de Arcatraz. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de démanteler 5 Sentinelles de l\'Arcatraz. Revenez le voir à la Ville basse de Shattrath quand elles seront toutes mortes pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死5名禁魔监狱斥候。完成任务后返回沙塔斯城的贫民窟，找他领取奖赏。‡虛空巡者瑪頓恩要你解決5個亞克崔茲哨兵。完成之後回到撒塔斯的陰鬱城找他領取賞金。',
  }
},
[11390] = {
  {
    'Eu tenho uma máquina voadora!‡У меня есть ветролет!‡Ich kann fliegen!‡비행기다!‡¡Tengo una máquina voladora!‡¡Tengo una máquina voladora!‡J\'ai une machine volante !‡我有飞行器！‡我有飛行器了!',
    nil,
    'O Arqueólogo-chefe do Portão de Aço quer que você leve 3 Sacos de Relíquias do fundo do sítio para a plataforma do lado sul ou do lado norte do Portão de Aço.|n|nPara tanto, use o gancho de escalada na máquina voadora.|n|nApresente-se ao Arqueólogo-chefe quando tiver terminado.‡Главный археолог Стальных ворот просит вас отвезти 3 мешка с реликвиями из раскопа на платформы к северу и югу от Стальных ворот.|n|nДля этого вам надо будет воспользоваться погрузочным крюком ветролета.|n|nВыполнив задание, вернитесь к главному археологу.‡Der Chefarchäologe des Stählernen Tores möchte, dass Ihr 3 Säcke voller Relikte vom Grund der Ausgrabungsstätte zu einer der Plattformen auf der Nord- oder Südseite des Stählernen Tores befördert.|n|nBenutzt den Enterhaken der Flugmaschine für diese Aufgabe.|n|nMeldet Euch bei ihm zurück, sobald Ihr damit fertig seid.‡강철 관문 수석고고학자가 유물 자루 3개를 현장 바닥에서 강철 관문 북쪽이나 남쪽의 기중기로 운반해 달라고 했습니다.|n|n비행기의 갈고리 던지기 기술을 이용해 임무를 완수한 다음 강철 관문 수석고고학자에게 보고해야 합니다.‡El arqueólogo jefe de Las Puertas de Acero quiere que transportes 3 sacos de reliquias desde el fondo de la excavación y los lleves hasta la plataforma que se encuentra en el flanco norte o sur de Las Puertas de Acero.|n|nPara ello, utiliza el gancho de la máquina voladora.|n|nVuelve a informarle cuando hayas terminado.‡El arqueólogo jefe de Las Puertas de Acero quiere que transportes 3 sacos de reliquias desde el fondo de la excavación y los lleves hasta la plataforma que se encuentra en el flanco norte o sur de Las Puertas de Acero.|n|nPara ello, utiliza el gancho de la máquina voladora.|n|nVuelve a informarle cuando hayas terminado.‡Le Chef archéologue de la Porte d’acier veut que vous transportiez 3 Sacs de reliques du bas du site à la plateforme qui se trouve du côté nord ou sud de la Porte d’acier.|n|nPour cela, vous devez vous servir du grappin de la machine volante.|n|nLorsque ce sera fait, retournez le voir.‡钢铁之门首席考古学家希望你将3袋古器从挖掘场底部运到钢铁之门北边或南边的平台上。|n|n利用飞行器上的抓升钩搬运古器。|n|n完成任务后向钢铁之门首席考古学家复命。‡鋼鐵之門首席考古學家要你去挖掘地點的底部運回3袋聖物，並將東西帶到鋼鐵之門北側或南側的平臺。|n|n使用飛行器上的繩鉤來進行此任務。|n|n完成後回去找鋼鐵之門首席考古學家。',
  }
},
[11391] = {
  {
    'Patrulha do Portão de Aço‡Патрулирование Стальных Ворот‡Patrouille am Stählernen Tor‡강철 관문 순찰‡Patrulla Las Puertas de Acero‡Patrulla Las Puertas de Acero‡Patrouille à la Porte d\'acier‡钢铁之门的巡逻兵‡巡邏鋼鐵之門',
    nil,
    'Como agora você é um ás da aviação do Portão de Aço, o Arqueólogo-chefe do Portão de Aço quer que você patrulhe o sítio de escavação e neutralize qualquer ameaça.|n|nApresente-se a ele novamente ao final da patrulha.‡Теперь вы лучший пилот Стальных ворот, и главный археолог Стальных ворот поручил вам патрулировать раскопки.|n|nОтразите нападение агрессивных существ, после чего вернитесь к главному археологу.‡Für die Leute am Stählernen Tor seid Ihr jetzt ein Fliegerass, also will der Chefarchäologe des Stählernen Tores, dass Ihr über der Ausgrabungsstätte patrouilliert und alle Angreifer bekämpft.|n|nMeldet Euch wieder bei ihm zurück, wenn Ihr Eure Patrouille geflogen habt.‡강철 관문 수석고고학자가 최우수 조종사로서 발굴현장 위를 순찰하면서 공격해 오는 적들을 처치해 달라고 했습니다.|n|n순찰을 마치면 그에게 보고해야 합니다.‡Ahora eres el mejor piloto de Las Puertas de Acero, así que el arqueólogo jefe de Las Puertas de Acero quiere que patrulles alrededor de la excavación y repelas cualquier tipo de ataque.|n|nVuelve a informarle cuando hayas terminado de patrullar.‡Ahora eres el mejor piloto de Las Puertas de Acero, así que el arqueólogo jefe de Las Puertas de Acero quiere que patrulles alrededor de la excavación y repelas cualquier tipo de ataque.|n|nVuelve a informarle cuando hayas terminado de patrullar.‡Vous êtes l’as des as de la Porte d’acier, désormais. Le Chef archéologue de la Porte d’acier veut que vous fassiez une patrouille autour du site et que vous abattiez tout ce qui vous attaquera.|n|nLorsque la patrouille sera terminée, retournez le voir.‡你已经是钢铁之门的王牌飞行员了，因此钢铁之门首席考古学家要你在挖掘场四周巡逻，对付来袭的敌人。|n|n完成巡逻任务后向他复命。‡你現在是鋼鐵之門的一流駕駛，所以鋼鐵之門首席考古學家要你去巡邏挖掘地點，並擊退任何想要進行攻擊的生物。|n|n待你完成你的巡邏後，回報給他。',
  }
},
[11392] = {
  {
    '‡Вызов Всадника без головы‡Ruft den kopflosen Reiter‡저주받은 기사 소환‡Invoca a El Jinete decapitado‡Invoca a El Jinete decapitado‡L\'appel du Cavalier sans tête‡召唤无头骑士‡',
    nil,
    '‡Принесите мрачную свечу к груде рыхлой вывороченной почвы.‡Bringt eine düstere Kerze zur leicht aufgewühlten Erde.‡으스스한 촛불을 살짝 파헤쳐진 흙더미로 가져가야 합니다.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Posez une Morne chandelle sur la Terre fraîchement retournée.‡将一根悲伤蜡烛插入翻过的泥土。‡',
  }
},
[11393] = {
  {
    'Volte, Arlindo Orlandon, volte!‡Куда пропал исследователь Джарен?‡Wo ist Forscher Jaren?‡탐험가 야렌은 어디에‡¿Dónde está el expedicionario Jaren?‡¿Dónde está el expedicionario Jaren?‡Où est l\'explorateur Jaren ?‡探险者亚伦在哪里？‡探險者賈倫在哪?',
    nil,
    'A Feitora Mariposa Itamanto pediu para você encontrar o noivo dela, Explorador Arlindo Orlandon.‡Надзирательница Ирена Каменная Мантия попросила вас отыскать ее суженого, исследователя Джарена.‡Vorarbeiterin Irena Zasterstein hat Euch gebeten, nach ihrem Verlobten Forscher Jaren zu suchen.‡감시자 이레나 스톤맨틀이 약혼자인 탐험가 야렌을 찾아달라고 했습니다.‡La Sobrestante Irena Mantopétreo te ha pedido que localices a su prometido, el expedicionario Jaren.‡La Sobrestante Irena Mantopétreo te ha pedido que localices a su prometido, el expedicionario Jaren.‡La Surveillante Irena Mantepierre vous a demandé de retrouver son fiancé, l’Explorateur Jaren.‡工头伊蕾娜·石衣希望你去找到她的未婚夫，探险者亚伦。‡監督者艾琳娜·石衣請你去尋找她的未婚夫，探險者賈倫。',
  }
},
[11394] = {
  {
    'E você achava que os murlocs fediam!‡Думаешь, мурлоки – самые вонючие существа?‡Und Ihr dachtet, Murlocs würden schlecht riechen!‡멀록 냄새보다도 고약한 일!‡¡Y tú que pensabas que los múrlocs olían mal!‡¡Y tú que pensabas que los múrlocs olían mal!‡Et vous pensiez que les murlocs sentaient mauvais !‡比鱼人更恶臭……‡你還以為魚人已經夠臭了!',
    nil,
    'Arlindo Orlandon quer que você mate 15 soldados do Flagelo de qualquer tipo ao longo da Costa da Água Fria. Fale novamente com ele após completar a missão.‡Исследователь Джарен поручил вам убить 15 любых солдат Плети, которые встретятся вам вдоль Берега Стылой Межи. Когда вы выполните это задание, вернитесь к нему.‡Forscher Jaren hat Euch gebeten, entlang der Küste des Frostmaares wahllos 15 Diener der Geißel zu töten. Kehrt zu ihm zurück, sobald Ihr Eure Aufgabe erledigt habt.‡서릿발 해안에서 종류에 관계없이 스컬지 15마리를 처치하고 탐험가 야렌에게 가야 합니다.‡El expedicionario Jaren te ha pedido que mates a 15 miembros cualquiera de la Plaga en Costafría. Vuelve a hablar con él cuando hayas terminado.‡El expedicionario Jaren te ha pedido que mates a 15 miembros cualquiera de la Plaga en Costafría. Vuelve a hablar con él cuando hayas terminado.‡L’Explorateur Jaren veut que vous tuiez 15 créatures du Fléau de n’importe quel type le long de la Côte de Frissonde. Lorsque vous aurez terminé, retournez le voir.‡探险者亚伦要你前往切米尔海岸，在那里杀死15名任意种类的天灾军团成员，完成任务后向他复命。‡探險者賈倫要求你殺死寒凜海岸上任何種類的15個天譴軍。一旦任務完成就回去找他。',
  }
},
[11395] = {
  {
    'O dispositivo do Flagelo‡Устройство Плети‡Es ist eine Vorrichtung der Geißel‡스컬지 장치‡Es un artefacto de la Plaga‡Es un artefacto de la Plaga‡C\'est un appareil du Fléau‡天灾装置‡這是個天譴裝置',
    nil,
    'Entregue o Dispositivo do Flagelo para o Explorador Arlindo Orlandon, na Costa da Água Fria.‡Отнесите устройство Плети исследователю Джарену на Берег Стылой Межи.‡Liefert die Vorrichtung der Geißel bei Forscher Jaren an der Küste des Frostmaares ab.‡서릿발 해안에 있는 탐험가 야렌에게 스컬지 장치를 가져가야 합니다.‡Entrega el artefacto de la Plaga al expedicionario Jaren en Costafría.‡Entrega el artefacto de la Plaga al expedicionario Jaren en Costafría.‡Remettez l’Appareil du Fléau à l’Exporateur Jaren sur la Côte de Frissonde.‡将天灾设备交给切米尔海岸的探险者亚伦。‡將天譴裝置交給寒凜海岸的探險者賈倫。',
  }
},
[11396] = {
  {
    'Abaixo com os escudos!‡Отключи защитное поле‡Die Schilde abschalten‡방어막 해제‡Derriba esos escudos‡Derriba esos escudos‡Abattez ces boucliers‡关闭护盾‡關閉那些護盾',
    nil,
    'O Explorador Arlindo Orlandon, da Costa da Água Fria, quer que você destrua 3 Cristais do Flagelo.‡Исследователь Джарен поручил вам уничтожить 3 смертоносных кристалла.‡Forscher Jaren an der Küste des Frostmaares hat Euch gebeten, 3 geißelnde Kristalle zu zerstören.‡서릿발 해안에 있는 탐험가 야렌이 스컬지 수정을 3개 파괴해 달라고 했습니다.‡El expedicionario Jaren en Costafría te ha pedido que destruyas 3 cristales apestadores.‡El expedicionario Jaren en Costafría te ha pedido que destruyas 3 cristales apestadores.‡L’Exporateur Jaren, sur la Côte de Frissonde, vous a demandé de détruire 3 Cristaux flaellants.‡切米尔海岸的探险者亚伦要你摧毁3颗天灾水晶。‡寒凜海岸的探險者賈倫要你摧毀3個天譴水晶。',
  }
},
[11397] = {
  {
    'E você achava que os murlocs fediam!‡Думаешь, мурлоки – самые вонючие существа?‡Und Ihr dachtet, Murlocs würden schlecht riechen!‡고약한 멀록 냄새!‡¡Y tú que pensabas que los múrlocs olían mal!‡¡Y tú que pensabas que los múrlocs olían mal!‡Et vous pensiez que les murlocs sentaient mauvais !‡比鱼人更恶臭……‡你還以為魚人已經夠臭了!',
    nil,
    'A Boticária Anastácia quer que você mate 15 soldados do Flagelo de qualquer tipo ao longo da Costa da Água Fria. Fale com ela novamente no Acampamento da Sociedade dos Boticários após terminar a tarefa.‡Аптекарь Анастасия поручила вам убить 15 любых солдат Плети, которые встретятся вам вдоль Берега Стылой Межи. Когда вы выполните это задание, вернитесь к ней в Аптекарский поселок.‡Apothekerin Anastasia möchte, dass Ihr entlang der Küste des Frostmaares wahllos 15 Diener der Geißel vernichtet. Kehrt zu ihr zurück, sobald Ihr Eure Aufgabe erledigt habt. Sie befindet sich im Apothekerlager.‡연금술사 야영지에 있는 연금술사 아나스타샤가 서릿발 해안에 있는 스컬지 15마리를 처치한 후 돌아와 달라고 했습니다.‡La boticaria Anastasia te ha pedido que mates a 15 miembros de la Plaga en Costafría. Cuando lo hagas, vuelve a verla al Campamento de los Boticarios.‡La boticaria Anastasia te ha pedido que mates a 15 miembros de la Plaga en Costafría. Cuando lo hagas, vuelve a verla al Campamento de los Boticarios.‡L’Apothicaire Anastasia veut que vous tuiez 15 créatures du Fléau de n’importe quel type le long de la Côte de Frissonde. Lorsque vous aurez terminé, retournez la voir au Camp des Apothicaires.‡药剂师安娜斯塔西娅要你前往切米尔海岸，杀死15名任意种类的天灾军团成员。完成任务后返回药剂师营地向她复命。‡藥劑師安娜塔西亞要你殺死寒凜海岸上任何種類的天譴軍共15名。一旦你完成去凜風峽灣的藥劑師營地向她回報。',
  }
},
[11398] = {
  {
    'O dispositivo do Flagelo‡Устройство Плети‡Es ist eine Vorrichtung der Geißel‡스컬지 장치‡Es un artefacto de la Plaga‡Es un artefacto de la Plaga‡C\'est un appareil du Fléau‡天灾装置‡這是個天譴裝置',
    nil,
    'Entregue o Dispositivo do Flagelo para a Boticária Anastácia no Acampamento da Sociedade dos Boticários.‡Отнесите устройство Плети аптекарю Анастасии в Аптекарский поселок.‡Liefert die Vorrichtung der Geißel bei Apothekerin Anastasia im Apothekerlager ab.‡연금술사 야영지에 있는 연금술사 아나스타샤에게 스컬지 장치를 가져가야 합니다.‡Lleva el artefacto de la Plaga a la boticaria Anastasia al Campamento de los Boticarios.‡Lleva el artefacto de la Plaga a la boticaria Anastasia al Campamento de los Boticarios.‡Remettez l’Appareil du Fléau à l’Apothicaire Anastasia, au Camp des Apothicaires du Fjord Hurlant.‡将天灾设备交给药剂师营地的安娜斯塔西娅。‡將天譴裝置交給藥劑師營地的藥劑師安娜塔西亞。',
  }
},
[11399] = {
  {
    'Abaixo com os escudos!‡Отключи защитное поле‡Die Schilde abschalten‡마법진 해제‡Derriba esos escudos‡Derriba esos escudos‡Abattez ces boucliers‡关闭护盾‡關閉那些護盾',
    nil,
    'A Boticária Anastácia, do Acampamento da Sociedade dos Boticários, quer que você destrua 3 Cristais do Flagelo.‡Аптекарь Анастасия поручила вам уничтожить 3 смертоносных кристалла.‡Apothekerin Anastasia im Apothekerlager hat Euch gebeten, 3 geißelnde Kristalle zu zerstören.‡연금술사 야영지에 있는 연금술사 아나스타샤가 스컬지 수정 3개를 파괴해 달라고 했습니다.‡La boticaria Anastasia en el Campamento de los Boticarios te ha pedido que destruyas 3 cristales apestadores.‡La boticaria Anastasia en el Campamento de los Boticarios te ha pedido que destruyas 3 cristales apestadores.‡L’Apothicaire Anastasia, du Camp des Apothicaires, vous a demandé de détruire 3 Cristaux flaellants.‡药剂师营地的药剂师安娜斯塔西娅要你摧毁3颗天灾水晶。‡藥劑師營地的藥劑師安娜塔西亞要你摧毀3個天譴水晶。',
  }
},
[11400] = {
  {
    '‡Скаковые бараны Хмельного фестиваля‡Braufestwidder‡가을 축제 경주용 산양‡Carneros de montar de la Fiesta de la cerveza‡Carneros de montar de la Fiesta de la Cerveza‡Les béliers de la fête des Brasseurs‡美酒节赛羊会‡啤酒節騎乘用山羊',
    nil,
    '‡Покажите штамп Полу Янтарлену у входа на территорию Хмельного фестиваля в Дун Мороге.‡Bringt den Handstempel "Ehrenbrauer" zu Pol Bernruh in der Nähe des Eingangs zum Braufestplatz in Dun Morogh.‡던 모로에 있는 가을 축제 광장 입구 근처에 폴 앰버스틸에게 "명예 양조장이" 손도장을 가져가야 합니다.‡Enseña el sello de "Cervecero Honorario" a Pol Semperámbar, que se encuentra cerca de la entrada a la zona de la Fiesta de la cerveza en Dun Morogh.‡Enseña el sello de "Cervecero Honorario" a Pol Semperámbar, que se encuentra cerca de la entrada a la zona de la Fiesta de la Cerveza en Dun Morogh.‡Apportez le Tampon de « Brasseur honoraire » à Pol Distillambre, près de l\'entrée de la Fête des Brasseurs en Dun Morogh.‡给丹莫罗美酒节会场入口处的波尔·冻石看看你手上的戳印。‡將「榮譽釀酒者」手印交給保爾·安伯斯堤爾，他就在丹莫洛的啤酒營地入口附近。',
  }
},
[11401] = {
  {
    'Chame o Cavaleiro Sem Cabeça‡Вызов Всадника без головы‡Ruft den kopflosen Reiter‡저주받은 기사 소환‡Invoca a El Jinete decapitado‡Invoca a El Jinete decapitado‡L\'appel du Cavalier sans tête‡召唤无头骑士‡召喚無頭騎士',
    nil,
    'Leve uma Vela Lúgubre até o Solo Levemente Revirado.‡Принесите мрачную свечу к груде рыхлой вывороченной почвы.‡Bringt eine düstere Kerze zur leicht aufgewühlten Erde.‡으스스한 촛불을 살짝 파헤쳐진 흙더미로 가져가야 합니다.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Posez une Morne chandelle sur la Terre fraîchement retournée.‡将一根悲伤蜡烛插入翻过的泥土。‡帶著一根陰鬱蠟燭去零散翻覆的泥土那邊。',
  }
},
[11402] = {
  {
    '‡‡Clayton\'s Quest: Extreme!‡클레이튼의 퀘스트: 극한!‡‡‡Quête de Clayton : extrême !‡Clayton\'s Quest: Extreme!!‡',
    nil,
    '‡‡Seriously, go slay those Evil Squirrels!‡‡¡En serio, ve a matar a esas ardillas malvadas!‡¡En serio, ve a matar a esas ardillas malvadas!‡Allez donc me tuer ces Écureuils maléfiques !‡Seriously, go slay those Evil Squirrels!‡',
  }
},
[11403] = {
  {
    'Enfim, livre!‡Наконец, свободен!‡Endlich frei!‡마침내 얻은 자유!‡¡Por fin libre!‡¡Por fin libre!‡Enfin libre !‡终于解脱了！‡終獲自由!',
    nil,
    'Leve o Tomo de Tomás Tomilho para a Matriarca Mascarada de Durotar, Montalvo ou da Praça Asa do Falcão.‡Возьмите книгу Томаса Томсона и отнесите ее попечительнице сирот в маске в Дуротар, Брилл или на Площадь Соколиных Крыльев.‡Bringt den Folianten von Thomas Thomson zu einer maskierten Waisenmatrone in Durotar, Brill oder beim Falkenplatz.‡토마스 톰슨의 기도서를 듀로타나 브릴 또는 매날개 광장의 가면 쓴 보육원 원장님에게 가져가야 합니다.‡Lleva el Escrito de Thomas Thomson a una supervisora de huérfanos enmascarada a Durotar, Rémol o Plaza Alalcón.‡Lleva el Escrito de Thomas Thomson a una supervisora de huérfanos enmascarada a Durotar, Rémol o Plaza Alalcón.‡Apportez le Tome de Thomas Thomson à une Directrice d\'orphelinat masquée en Durotar, à Brill ou sur la Place de l\'Épervier.‡将这本破损的圣典交给杜隆塔尔、布瑞尔或鹰翼广场的穿戏服的孤儿院长。‡帶著湯瑪斯·托姆森的聖典交給戴面具的孤兒監護員，她在杜洛塔、布瑞爾和獵鷹之翼廣場。',
  }
},
[11404] = {
  {
    '‡Вызов Всадника без головы‡Ruft den kopflosen Reiter‡저주받은 기사 소환‡Invoca a El Jinete decapitado‡Invoca a El Jinete decapitado‡L\'appel du Cavalier sans tête‡召唤无头骑士‡',
    nil,
    '‡Принесите мрачную свечу к груде рыхлой вывороченной почвы.‡Bringt eine düstere Kerze zur leicht aufgewühlten Erde.‡으스스한 촛불을 살짝 파헤쳐진 흙더미로 가져가야 합니다.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Posez une Morne chandelle sur la Terre fraîchement retournée.‡将一根悲伤蜡烛插入翻过的泥土。‡',
  }
},
[11405] = {
  {
    '‡Вызов Всадника без головы‡Ruft den kopflosen Reiter‡저주받은 기사 소환‡Invoca a El Jinete decapitado‡Invoca a El Jinete decapitado‡L\'appel du Cavalier sans tête‡召唤无头骑士‡',
    nil,
    '‡Принесите мрачную свечу к груде рыхлой вывороченной почвы.‡Bringt eine düstere Kerze zur leicht aufgewühlten Erde.‡으스스한 촛불을 살짝 파헤쳐진 흙더미로 가져가야 합니다.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Lleva una vela lóbrega a la tierra ligeramente revuelta.‡Posez une Morne chandelle sur la Terre fraîchement retournée.‡将一根悲伤蜡烛插入翻过的泥土。‡',
  }
},
[11406] = {
  {
    'Gato escaldado...‡Все должно быть готово‡Alles muss bereit sein‡만반의 준비‡Todo debe estar listo‡Todo debe estar listo‡Tout doit être prêt‡一切必须准备就绪‡一切都要準備好',
    nil,
    'Fale com Gil Griserdo no Forte Vildervar.‡Поговорите с Гилом Гризертом в крепости Вилдервар.‡Sprecht mit Gil Grisert in Fort Wildervar.‡빌더바르 요새의 길 그리서트와 대화해야 합니다.‡Habla con Gil Grisert en el Fuerte Vildervar.‡Habla con Gil Grisert en el Fuerte Vildervar.‡Parlez à Gil Grisert à Fort Hardivar.‡与维德瓦堡垒的基尔·克利瑟谈一谈。‡和威德瓦堡壘的吉爾·葛瑞斯特談談。',
  }
},
[11407] = {
  {
    '‡Пивоварня Дрона ищет зазывалу!‡Marktschreier für die Brauerei Drohn!‡드론의 양조장 광고!‡¡Grita por la destilería de Drohn!‡¡Grita por la destilería de Drohn!‡Des aboyeurs pour la distillerie Drohn !‡‡',
    nil,
    '‡Зазывайте посетителей на Хмельной фестиваль у флагов в Аллее Силы, в Аллее Чести, в Аллее Мудрости и в Аллее Духов.‡Verbreitet die Kunde vom Braufest bei den Flaggen außerhalb des Auktionshauses im Tal der Stärke, im Tal der Ehre, im Tal der Weisheit und im Tal der Geister.‡힘의 골짜기 경매장 바깥, 명예의 골짜기, 지혜의 골짜기, 그리고 정기의 골짜기에 있는 깃발에서 촬리의 부두 양조장을 광고해야 합니다.‡Informa sobre la Fiesta de la cerveza en las banderas fuera de la casa de subastas, en el Valle de la Fuerza, el Valle del Honor, el Valle de la Sabiduría y el Valle de los Espíritus.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera de la casa de subastas, en el Valle de la Fuerza, el Valle del Honor, el Valle de la Sabiduría y el Valle de los Espíritus.‡Faites passer le mot au sujet de la fête des Brasseurs près des drapeaux à l\'extérieur de l\'hôtel des ventes dans la Vallée de la Force, dans la Vallée de l\'Honneur, dans la Vallée de la Sagesse et dans la Vallée des Esprits.‡‡',
  }
},
[11408] = {
  {
    '‡Пивоварня Т\'чали Вуду ищет зазывалу!‡Marktschreier für T\'chalis Voodoobrauerei!‡촬리의 부두 양조장 광고!‡¡Grita por la Cervecería vudú de T\'chali!‡¡Grita por la Cervecería vudú de T\'chali!‡Des aboyeurs pour la brasserie vaudou de T\'chali !‡‡',
    nil,
    '‡Зазывайте посетителей на Хмельной фестиваль у флагов в Аллее Силы, в Аллее Чести, в Аллее Мудрости и в Аллее Духов.‡Verbreitet die Kunde vom Braufest bei den Flaggen außerhalb des Auktionshauses im Tal der Stärke, im Tal der Ehre, im Tal der Weisheit und im Tal der Geister.‡힘의 골짜기 경매장 바깥, 명예의 골짜기, 지혜의 골짜기, 그리고 정기의 골짜기에 있는 깃발에서 촬리의 부두 양조장을 광고해야 합니다.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera de la casa de subastas, en el Valle de la Fuerza, el Valle del Honor, el Valle de la Sabiduría y el Valle de los Espíritus.‡Informa sobre la Fiesta de la Cerveza en las banderas fuera de la casa de subastas, en el Valle de la Fuerza, el Valle del Honor, el Valle de la Sabiduría y el Valle de los Espíritus.‡Faites passer le mot au sujet de la fête des Brasseurs près des drapeaux à l\'extérieur de l\'hôtel des ventes dans la Vallée de la Force, dans la Vallée de l\'Honneur, dans la Vallée de la Sagesse et dans la Vallée des Esprits.‡‡',
  }
},
[11409] = {
  {
    'Isso sim é uma corrida de carneiro... ou quase‡А теперь гонки на баранах... Или вроде того.‡Das ist Widderrennen... zumindest fast‡산양 달리자‡Carrera de carneros... o algo parecido‡Carrera de carneros... o algo parecido‡Ça c\'est de la course de béliers... enfin, presque.‡赛羊会前的热身‡現在就是山羊競速…差不多。',
    nil,
    'Você tem 4 minutos para montar no carneiro e manter 3 níveis diferentes de velocidade por 8 segundos cada.‡У вас есть 4 минуты, чтобы погонять барана на всех трех скоростях по 8 секунд.‡Ihr habt 4 Minuten, um den Widder zu reiten und dabei 3 verschiedene Geschwindigkeitsstufen für jeweils 8 Sekunden zu halten.‡4분 동안 산양을 타면서 3가지 서로 다른 속도를 각각 8초간 유지해야 합니다.‡Tienes 4 minutos para montar el carnero y mantener 3 niveles de velocidad diferentes durante 8 segundos.‡Tienes 4 minutos para montar el carnero y mantener 3 niveles de velocidad diferentes durante 8 segundos.‡Vous avez 4 minutes pour chevaucher le bélier et maintenir 3 différentes allures pendant 8 secondes chacune.‡你有4分钟时间驾驭赛羊，让它保持三种不同的速度各8秒。‡你有4分鐘的時間可以鞭打山羊，然後在3種不同速度下各維持8秒。',
  }
},
[11410] = {
  {
    'O peixe fugitivo‡Та самая рыбка‡Der Eine, der entkam‡놓친 물고기‡Aquel que se escapó‡Aquel que se escapó‡Celui qui s\'échappa‡逃走的大鱼‡逃脫的傢伙',
    nil,
    'Cristóvão Slento, do Forte Vildervar, quer que você derrote o Barbatana de Gelo.‡Кристофер Слоан из крепости Вилдервар просит вас победить Ледяного Плавника.‡Christopher Sloan in Fort Wildervar möchte, dass Ihr Frostflosse besiegt.‡빌더바르 요새의 크리스토퍼 슬로안이 서리지느러미를 처치해 달라고 했습니다.‡Christopher Sloan en el Fuerte Vildervar quiere que derrotes a Aleta de Escarcha.‡Christopher Sloan en el Fuerte Vildervar quiere que derrotes a Aleta de Escarcha.‡Christopher Sloan, du Fort Hardivar, veut que vous triomphiez de Givraileron.‡维德瓦堡垒的克里斯托弗·斯洛安要你击败霜鳞。‡威德瓦堡壘的克里斯多夫·斯洛安要你打敗霜鰭。',
  }
},
[11411] = {
  {
    'Aldeia Casco Invernal‡Лагерь Заиндевевшего Копыта‡Lager der Winterhufe‡겨울발굽 야영지‡Campamento Pezuña Invernal‡Campamento Pezuña Invernal‡Le camp Sabot-d\'hiver‡冬蹄营地‡冬蹄營地',
    nil,
    'Fale com o Chefe Totem de Cinzas na Aldeia Casco Invernal.‡Поговорите с вождем Прахтотемом в Лагере Заиндевевшего Копыта.‡Sprecht mit Häuptling Aschtotem im Lager der Winterhufe.‡겨울발굽 야영지에 있는 족장 애쉬토템과 대화해야 합니다.‡Habla con el cabecilla Tótem de Ceniza en el Campamento Pezuña Invernal.‡Habla con el cabecilla Tótem de Ceniza en el Campamento Pezuña Invernal.‡Parlez au Chef Totem-de-frêne au camp Sabot-d’hiver.‡与冬蹄营地的灰烬图腾酋长谈一谈。‡和冬蹄營地的灰燼圖騰酋長交談。',
  }
},
[11412] = {
  {
    'Lá e de volta outra vez‡Туда и обратно‡Hin und zurück‡왔다 갔다, 맥주통 배달!‡Historia de una ida y una vuelta‡Historia de una ida y una vuelta‡Histoire d\'un aller et retour‡来来回回‡來回跑',
    nil,
    'Pegue um barril com o goblin acidentado na estrada para a Baía Carpunhal e entregue-o para o assistente do Mestre de Carneiros Ray. Faça isso três vezes antes que o carneiro vá embora.‡Возьмите бочку у гоблина, застрявшего возле Бухты Острорука, и отвезите ее помощнику Рэя, погонщика баранов. Пока баран не сбежит от вас, постарайтесь доставить три бочки.‡Holt bei dem Goblin, der auf der Straße zur Messerbucht festsitzt, ein Fässchen ab und bringt es zu Widdermeister Rays Assistenten. Macht das Ganze dreimal, bevor Euer Widder verschwindet.‡산양이 사라지기 전에, 칼날주먹 만으로 가는 길에 있는 추락한 고블린에게 맥주통을 받아 산양 조련사 레이의 수습생에게 3번 전달해야 합니다.‡Coge el barril del goblin que se ha quedado tirado en el camino a la Bahía de Garrafilada y tráeselo al asistente del maestro de carneros Rayo. Haz esto 3 veces antes de que tu carnero se largue.‡Coge el barril del goblin que se ha quedado tirado en el camino a la Bahía de Garrafilada y tráeselo al asistente del maestro de carneros Rayo. Haz esto 3 veces antes de que tu carnero se largue.‡Obtenez un tonneau auprès du Gobelin coincé sur la route de la Baie de Lamepoing, et rapportez-le à l’assistant du Maître des béliers Ray. Faites-le 3 fois avant que votre bélier ne s’en aille.‡前往刃拳海湾，途中你会遇见一名束手无策的地精，从他手中接过一只酒桶，然后将它交给雷恩的助手。在赛羊消失之前取回3只酒桶。‡從倒在通往刃拳海灣路上的哥布林手中得到酒桶，然後交給山羊管理員雷的助手。在山羊跑走之前取得三桶酒。',
  }
},
[11413] = {
  {
    '‡Кто сказал "сувениры"?‡Sagte da jemand "Souvenir"?‡‡¿Alguien dijo "souvenir?"‡¿Alguien dijo "souvenir?"‡Quelqu\'un a dit « souvenir » ?‡‡',
    nil,
    '‡Отоварьте свой купон на праздничную кружку у Бликса Чиништукса в лагере Хмельного фестиваля.‡Löst Euren Gutschein für einen Braufestkrug bei Blix Fixtand im hinteren Teil des Braufestlagers ein.‡가을 축제 광장 뒤쪽에 있는 블릭스 픽스위젯에게 가을 축제 잔 상품권을 가져가서 축제 잔으로 교환해야 합니다.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la Cerveza.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la Cerveza.‡Échangez le Bon pour un bock de la fête des Brasseurs à Blix Réparouage à l\'arrière du campement de la fête des Brasseurs.‡‡',
  }
},
[11414] = {
  {
    'Traidores de irmãos‡Братья-предатели‡Verrat unter den Brüdern‡배신자 형제‡Hermanos traicioneros‡Hermanos traicioneros‡Les frères félons‡兄弟的背叛‡兄弟的背叛',
    nil,
    'Ulfang pediu que você matasse Bjomolf e Varg, os worgs traidores. Em seguida, volte a ele, no Bosque Fendido, ainda usando o disfarce.|n|nSe o disfarce desaparecer, peça outro para a Guardiã Folha-da-lua.‡Улклык попросил вас убить воргов-предателей, Бьомолфа и Варга. Когда вы убьете их, вернитесь к нему в Вырубки в обличье ворга.|n|nЕсли вы потеряете личину ворга, возьмите другую у дозорной Лунный Лепесток.‡Ulfang im Bruchwald möchte, dass Ihr die verräterischen Worgs Bjomolf und Varg tötet. Kehrt zu ihm verkleidet zurück, sobald Ihr Eure Aufgabe erfüllt habt.|n|nFalls Ihr aus irgendeinem Grund die Worgverkleidung verlieren und nach Ersatz suchen solltet, müsstet Ihr zu Behüterin Mondblatt zurückkehren.‡배신한 늑대 비요물프와 바르그를 처치한 다음, 비틀린 숲에 있는 울팡에게 위장한 상태로 가야 합니다.|n|n검은늑대 위장복을 잃어버리면 감시자 문리프에게 돌아가 새로 받아야 합니다.‡Ulkang te ha pedido que mates a los huargos traidores Bjomolf y Varg. Cuando termines, vuelve a verlo con tu disfraz puesto a El Bosque Hendido.|n|nSi por alguna razón pierdes el disfraz de huargo, vuelve a ver a la vigía Hojaluna para que te dé otro.‡Ulkang te ha pedido que mates a los huargos traidores Bjomolf y Varg. Cuando termines, vuelve a verlo con tu disfraz puesto a El Bosque Hendido.|n|nSi por alguna razón pierdes el disfraz de huargo, vuelve a ver a la vigía Hojaluna para que te dé otro.‡Ulfang vous a demandé de tuer les traîtres worgs, Bjomolf et Varg. Lorsque ce sera fait, retournez le voir, déguisé , à Clivebois.|n|nSi par hasard vous perdiez le Déguisement de worg, retournez voir la Guetteuse Feuillelune et demandez-lui un autre exemplaire.‡乌尔芬要你去杀死背叛他的座狼，比奥莫弗和瓦尔戈。完成任务后，穿着斗篷回到裂木森林向他复命。|n|n如果你弄丢了座狼伪装，可以去找观察者莉莎·月叶再要一件。‡巫牙要求你殺掉背叛他的座狼，畢歐莫夫和瓦爾格。成功以後，在偽裝的情況下向巫牙回報，他就在裂木森林裡。|n|n如果你遺失了你的座狼偽裝，向看守者月葉要一個替代品。',
  }
},
[11415] = {
  {
    'Traidores de irmãos‡Братья-предатели‡Verrat unter den Brüdern‡배신자 형제‡Hermanos traicioneros‡Hermanos traicioneros‡Les frères félons‡兄弟的背叛‡兄弟的背叛',
    nil,
    'Ulfang pediu que você matasse Bjomolf e Varg, os worgs traidores. Em seguida, fale novamente com ele, no Bosque Fendido, ainda usando o disfarce.|n|nSe o Disfarce de Worg desaparecer, peça outro para o Sábio Andanévoa.‡Улклык попросил вас убить воргов-предателей, Бьомолфа и Варга. Выполнив его просьбу, наденьте личину ворга и вернитесь к Улклыку.|n|nЕсли вы потеряете личину ворга, вернитесь к ведуну Страннику Туманов, и он даст вам новую.‡Ulfang im Bruchwald möchte, dass Ihr die verräterischen Worgs Bjomolf und Varg tötet. Kehrt zu ihm verkleidet zurück, sobald Ihr Eure Aufgabe erfüllt habt.|n|nFalls Ihr aus irgendeinem Grund die Worgverkleidung verlieren und nach Ersatz suchen solltet, müsstet Ihr zu Weiser Nebelläufer zurückkehren.‡배신한 늑대 비요물프와 바르그를 처치한 다음, 비틀린 숲에 있는 울팡에게 위장한 상태로 가야 합니다.|n|n검은늑대 위장복을 잃어버리면 현인 미스트워커에게 돌아가 새로 받아야 합니다.‡Ulkang te ha pedido que mates a los huargos traidores Bjomolf y Varg. Cuando termines, vuelve a verlo con tu disfraz puesto a El Bosque Hendido.|n|nSi por alguna razón pierdes el disfraz de huargo, vuelve a ver al sabio Caminaniebla para que te dé otro.‡Ulkang te ha pedido que mates a los huargos traidores Bjomolf y Varg. Cuando termines, vuelve a verlo con tu disfraz puesto a El Bosque Hendido.|n|nSi por alguna razón pierdes el disfraz de huargo, vuelve a ver al sabio Caminaniebla para que te dé otro.‡Ulfang vous a demandé de tuer les traîtres worgs, Bjomolf et Varg. Lorsque ce sera fait, retournez le voir, déguisé , à Clivebois.|n|nSi par hasard vous perdiez le Déguisement de worg, retournez voir le Sage Marche-brume et demandez-lui un autre exemplaire.‡乌尔芬要你去杀死背叛他的座狼，比奥莫弗和瓦尔戈。完成任务后，穿着斗篷回到裂木森林向他复命。|n|n如果你弄丢了座狼伪装，可以去找先知拉瑞恩·迷雾行者再要一件。‡巫牙要求你殺掉背叛他的座狼，畢歐莫夫和瓦爾格。成功以後，在偽裝的情況下向巫牙回報，他就在裂木森林裡。|n|n如果你遺失了你的座狼偽裝，向賢者霧行要一個替代品。',
  }
},
[11416] = {
  {
    'Olhos da águia‡Глаза орлицы‡Augen des Adlers‡독수리의 눈‡Los ojos del Águila‡Los ojos del Águila‡Les yeux de l\'aigle‡巨鹰之眼‡雌鷹之眼',
    nil,
    'Ulfang quer que você pegue os Olhos da Águia. Em seguida, volte a ele, no Bosque Fendido, ainda usando o disfarce.|n|nSe o disfarce desaparecer, peça outro para a Guardiã Folha-da-lua.‡Улклык поручил вам вырвать глаза великой орлицы. Вернитесь к нему в Вырубки, когда это задание будет выполнено.|n|nЕсли вы потеряете личину ворга, вернитесь к дозорной Лунный Лепесток, и она выдаст вам новую.‡Ulfang im Bruchwald möchte, dass Ihr die Augen des Adlers beschafft. Kehrt zu ihm verkleidet zurück, sobald Ihr Eure Aufgabe erfüllt habt.|n|nFalls Ihr aus irgendeinem Grund die Worgverkleidung verlieren und nach Ersatz suchen solltet, müsstet Ihr zu Behüterin Mondblatt zurückkehren.‡독수리의 눈을 구한 다음, 비틀린 숲에 있는 울팡에게 위장한 상태로 가야 합니다.|n|n검은늑대 위장복을 잃어버리면 감시자 문리프에게 돌아가 새로 받아야 합니다.‡Ulkang te ha pedido que consigas los ojos del Águila. Vuelve a verle disfrazado a El Bosque Hendido cuando los tengas.|n|nSi pierdes el disfraz de huargo, vuelve junto a la vigía Hojaluna para que te dé otro.‡Ulkang te ha pedido que consigas los ojos del Águila. Vuelve a verle disfrazado a El Bosque Hendido cuando los tengas.|n|nSi pierdes el disfraz de huargo, vuelve junto a la vigía Hojaluna para que te dé otro.‡Ulfang vous a demandé de récupérer les Yeux de l’Aigle. Lorsque ce sera fait, retournez le voir déguisé à Clivebois.|n|nSi vous perdez votre Déguisement de worg, allez en demander un autre à la Guetteuse Feuillelune.‡乌尔芬要你去拿到巨鹰之眼。完成任务后，穿着斗篷回到裂木森林向他复命。|n|n如果你弄丢了座狼伪装，可以去找观察者莉莎·月叶再要一件。‡巫牙要你去取得雌鷹之眼。完成後穿上偽裝，回到裂木森林去找牠。|n|n如果你不知為何失去了座狼偽裝，就回去找看守者月葉再要一個。',
  }
},
[11417] = {
  {
    'Olhos da águia‡Глаза орлицы‡Augen des Adlers‡독수리의 눈‡Los ojos del Águila‡Los ojos del Águila‡Les yeux de l\'aigle‡巨鹰之眼‡雌鷹之眼',
    nil,
    'Ulfang quer que você pegue os Olhos da Águia. Em seguida, fale novamente com ele, no Bosque Fendido, ainda usando o disfarce.|n|nSe o Disfarce de Worg desaparecer, peça outro para o Sábio Andanévoa.‡Улклык поручил вам вырвать глаза великой орлицы. Вернитесь к нему в Вырубки, когда это задание будет выполнено.|n|nЕсли вы потеряете личину ворга, вернитесь к ведуну Страннику Туманов, и он даст вам новую.‡Ulfang im Bruchwald möchte, dass Ihr die Augen des Adlers beschafft. Kehrt zu ihm verkleidet zurück, sobald Ihr Eure Aufgabe erfüllt habt.|n|nFalls Ihr aus irgendeinem Grund die Worgverkleidung verlieren und nach Ersatz suchen solltet, müsstet Ihr zu Weiser Nebelläufer zurückkehren.‡독수리의 눈을 구한 다음, 비틀린 숲에 있는 울팡에게 위장한 상태로 가야 합니다.|n|n검은늑대 위장복을 잃어버리면 현인 미스트워커에게 돌아가 새로 받아야 합니다.‡Ulkang te ha pedido que consigas los ojos del Águila. Vuelve a verle disfrazado a El Bosque Hendido cuando los tengas.|n|nSi pierdes el disfraz de huargo, vuelve junto al sabio Caminaniebla para que te dé otro.‡Ulkang te ha pedido que consigas los ojos del Águila. Vuelve a verle disfrazado a El Bosque Hendido cuando los tengas.|n|nSi pierdes el disfraz de huargo, vuelve junto al sabio Caminaniebla para que te dé otro.‡Ulfang vous a demandé de récupérer les Yeux de l’Aigle. Lorsque ce sera fait, retournez le voir déguisé à Clivebois.|n|nSi vous perdez votre Déguisement de worg, allez en demander un autre au Sage Marche-brume.‡乌尔芬要你去拿到巨鹰之眼。完成任务后，穿着斗篷回到裂木森林向他复命。|n|n如果你弄丢了座狼伪装，可以去找先知拉瑞恩·迷雾行者再要一件。‡巫牙要你去取得雌鷹之眼。完成後穿上偽裝，回到裂木森林去找牠。|n|n如果你不知為何失去了座狼偽裝，就回去找賢者霧行再要一個。',
  }
},
[11418] = {
  {
    'O chamam Pena-de-aço‡Мы зовем его Стальное Перо‡Wir nennen ihn Stahlfeder‡그 이름은 강철깃털‡Lo llamamos "Pluma de Acero"‡Lo llamamos "Pluma de Acero"‡On l\'appelle Plume-d\'acier‡我们叫他钢羽‡我們都叫他鋼羽',
    nil,
    'Encontre o Pena-de-aço sobrevoando o Forte Vildervar e use o Patuá de Penas para descobrir seu segredo. Relate suas descobertas para Gil Griserdo.‡Найдите Стальное Перо, который кружит над крепостью Вилдервар, и воспользуйтесь оперенным амулетом, чтобы разгадать тайну этого загадочного гиппогрифа. Расскажите Гилу Гризерту о вашей находке.‡Spürt Stahlfeder auf, der über Fort Wildervar kreist, und benutzt den gefiederten Glücksbringer, um hinter sein Geheimnis zu kommen. Berichtet Gil Grisert anschließend von dem, was Ihr herausgefunden habt.‡빌더바르 요새 주변을 맴도는 강철깃털에게 깃털장식 부적을 사용하여 강철깃털의 비밀을 알아낸 다음, 길 그리서트에게 보고해야 합니다.‡Localiza a Pluma de Acero rodeando el Fuerte Vildervar y usa el talismán con plumas para descubrir su secreto. Cuando lo hayas averiguado, ve a hablar con Gil Grisert.‡Localiza a Pluma de Acero rodeando el Fuerte Vildervar y usa el talismán con plumas para descubrir su secreto. Cuando lo hayas averiguado, ve a hablar con Gil Grisert.‡Trouvez Plume-d’acier, qui tourne autour de Fort Hardivar, et utilisez le Charme orné de plumes pour découvrir son secret. Ensuite, allez faire part de vos découvertes à Gil Grisert.‡找到盘旋在维德瓦堡垒上空的钢羽，利用饰羽符咒揭开他的秘密。然后向基尔·克利瑟报告情况。‡找到在威德瓦堡壘外徘徊的鋼羽，使用羽毛符咒來得知他的秘密。將你的發現回報給吉爾·葛瑞斯特。',
  }
},
[11419] = {
  {
    'Carneiros de montaria da CervaFest‡Скаковые бараны Хмельного фестиваля‡Braufestwidder‡가을 축제 산양 타기‡Carneros de montar de la Fiesta de la cerveza‡Carneros de montar de la Fiesta de la Cerveza‡Les béliers de la fête des Brasseurs‡美酒节赛羊会‡啤酒節騎乘用山羊',
    nil,
    'Mostre o carimbo de "Cervejeiro Honorário" para Driz Topalogo, que está na entrada da CervaFest, em Durotar.‡Покажите штамп Дризу Неуклюге у входа на территорию Хмельного фестиваля в Дуротаре.‡Bringt den Handstempel "Ehrenbrauer" zu Driz Purzelfix in der Nähe des Eingangs zum Braufestplatz in Durotar.‡듀로타에 있는 가을 축제 광장 입구 근처에 드리즈 텀블퀵에게 "명예 양조장이" 손도장을 가져가야 합니다.‡Enseña el sello de "Cervecero Honorario" a Driz Pataplaf, que se encuentra cerca de la entrada a la zona de la Fiesta de la cerveza en Durotar.‡Enseña el sello de "Cervecero Honorario" a Driz Pataplaf, que se encuentra cerca de la entrada a la zona de la Fiesta de la Cerveza en Durotar.‡Apportez le Tampon de « Brasseur honoraire » à Driz Voltevive, près de l\'entrée de la Fête des Brasseurs, en Durotar.‡给杜隆塔尔美酒节会场入口处的德利兹·塔波奎克看看你手上的戳印。‡將『榮譽釀酒者』手印交給德瑞茲·迅跌，他就在杜洛塔的啤酒營地入口附近。',
  }
},
[11420] = {
  {
    'O caminho da vingança‡Путь к отмщению‡Der Weg zur Vergeltung‡복수의 길‡El camino a la venganza‡El camino a la venganza‡La voie de la vengeance‡报复之路‡償還之途',
    nil,
    'O Capitão da Guarda Zorek, do assentamento Valgarde, no Fiorde Uivante, quer que você recupere o Manual de Operações do Arpão.‡Капитан стражи Зорек из Валгарда в Ревущем фьорде поручил вам вернуть руководство по управлению гарпунной пушкой.‡Wachoffizier Zorek bei Valgarde am Heulenden Fjord möchte, dass Ihr die Harpunenbetriebsanleitung zurückholt.‡울부짖는 협만의 발가드에 있는 경비대장 조렉이 작살포 사용 설명서를 회수해 달라고 했습니다.‡El capitán de la guardia Zorek de Valgarde, en el Fiordo Aquilonal, quiere que recuperes el manual de uso de arpón.‡El capitán de la guardia Zorek de Valgarde, en el Fiordo Aquilonal, quiere que recuperes el manual de uso de arpón.‡Le Capitaine de la garde Zorek, à Valgarde dans le Fjord Hurlant, vous demande de récupérer le Manuel d\'utilisation du harpon.‡瓦加德的守卫队长索雷克要你取回鱼叉操作手册。‡守衛隊長索芮克希望你去找回魚叉操作手冊，他就在凜風峽灣的瓦爾加德。',
  }
},
[11421] = {
  {
    'Vai até onze...‡До упора...‡Jetzt drehen wir mal richtig auf...‡섬멸‡Estos llegan hasta el 11...‡Estos llegan hasta el 11...‡Ça va jusqu\'à 11…‡扫射龙颅村‡火力全開…',
    nil,
    'O Tenente Malhogélido, do Fiorde Uivante, quer que você destrua a Casa Comunal Esfola-dragão, o Galpão das Docas Esfola-dragão, o Armazém Esfola-dragão e 8 Defensores Esfola-dragão.|n|nDevolva o Mecanismo de Controle de Arpões ao terminar a tarefa.‡Лейтенант Ледяной Молот из Ревущего фьорда хочет, чтобы вы уничтожили большой дом Укротителей драконов, верфь Укротителей драконов, склад Укротителей драконов и 8 защитников из клана Укротителей драконов. Как только поручение будет выполнено, верните лейтенанту механизм управления гарпуном.‡Leutnant Eishammer im Heulenden Fjord möchte, dass Ihr das Langhaus der Drachenschinder, das Dockhaus der Drachenschinder, das Lager der Drachenschinder und 8 Verteidiger der Drachenschinder vernichtet.|n|nBringt den Harpunenkontrollmechanismus zu ihm zurück, sobald Ihr Eure Aufgabe erledigt habt.‡울부짖는 협만의 부관 아이스해머가 용약탈 공동주택, 용약탈 부두, 용약탈 저장고를 파괴하고 용약탈 수호병 8명을 처치해 달라고 했습니다.|n|n임무를 완료한 다음 작살포 제어 장치를 그에게 돌려줘야 합니다.‡El teniente Martillo de Hielo en el Fiordo Aquilonal quiere que acabes con la casa comunal Desuelladragones, la caseta del muelle Desuelladragones, el almacén Desuelladragones y con 8 defensores Desuelladragones.|n|nCuando hayas completado esta tarea, devuélvele el mecanismo de control de arpón.‡El teniente Martillo de Hielo en el Fiordo Aquilonal quiere que acabes con la casa comunal Desuelladragones, la caseta del muelle Desuelladragones, el almacén Desuelladragones y con 8 defensores Desuelladragones.|n|nCuando hayas completado esta tarea, devuélvele el mecanismo de control de arpón.‡Le Lieutenant Martel-de-glace, dans le Fjord Hurlant, veut que vous détruisiez la Maison longue écorche-dragon, la Maison des quais écorche-dragon, l’Entrepôt et 8 Défenseurs écorche-dragon.|n|nRapportez-lui le Mécanisme de commande de harpon quand vous aurez accompli votre mission.‡嚎风峡湾的约格莫夫·冰锤中尉要你摧毁掠龙长屋、掠龙码头和掠龙仓库，并杀死8名掠龙防御者。|n|n完成任务后将鱼叉控制器交给他。‡凜風峽灣的冰錘中尉希望你摧毀掠龍長屋、掠龍船塢、掠龍貯藏設施和8個掠龍防衛者。|n|n等到任務完成，將魚叉控制裝置還給他。',
  }
},
[11422] = {
  {
    'O tridente do filho‡Трезубец сына‡Dreizack des Sohnes‡아들의 삼지창‡El tridente del hijo‡El tridente del hijo‡Le trident du fils‡腐鳃的三叉戟‡兒子的三叉戟',
    nil,
    'O Velho Barbagelo quer que você pegue o Tridente do Branquiacre. Entregue o objeto para ele na ilhota da Costa da Água Fria.‡Старый Ледоспин просит вас принести ему трезубец Гниложабера. Он будет ждать вас на маленьком острове возле Берега Стылой Межи.‡Alte Eisflosse möchte, dass Ihr Rottkiems Dreizack zurückholt. Er wohnt auf der kleinen Insel an der Küste des Frostmaares.‡서릿발 해안의 작은 섬에 있는 늙은 얼음지느러미가 로트길의 삼지창을 가져다 달라고 했습니다.‡El viejo Aleta Helada quiere que consigas el tridente de Branquia Putrefacta. Vuelve a verle en la pequeña isla en Costafría.‡El viejo Aleta Helada quiere que consigas el tridente de Branquia Putrefacta. Vuelve a verle en la pequeña isla en Costafría.‡Le Vieux Nageglace veut que vous récupériez le Trident de Branchie-pourrie. Lorsque ce sera fait, rapportez-le-lui sur sa petite île, sur la côte de Frissonde.‡老冰鳞要你夺得腐鳃的三叉戟，然后返回切米尔海岸的小岛上向他复命。‡老冰鰭要你去取得腐鰓的三叉戟。將東西帶回他那位於寒凜海岸的小島上給他。',
  }
},
[11423] = {
  {
    'O legado do inimigo‡Наследие врагов‡Das Vermächtnis des Feindes‡적의 유산‡El legado del enemigo‡El legado del enemigo‡L\'héritage de l\'ennemi‡敌人的史诗‡敵人的遺產',
    nil,
    'Vá para Niffelvar, a norte do Posto Lâmina Espectral, e procure a Saga das Gêmeas, a Saga da Maldição Invernal e a Saga das Val\'kyren.‡Отправляйтесь к северу Заставы Призрачного Клинка, в Ниффлвар, и найдите три свитка: "Сагу о проклятии зимы", "Сагу о валькириях" и "Сагу о близнецах".‡Reist nach Niffelvar nördlich des Geisterklingenpostens und sucht die Sage des Winterfluchs, die Sage der Val\'kyr und die Sage der Zwillinge.‡유령칼날 초소 북쪽에 있는 니플바르로 이동하여 한겨울 저주 전설, 발키르 전설 및 쌍둥이 전설을 찾아야 합니다.‡Viaja a Nafsavar, al norte del Puesto del Filo Fantasmal y busca la Saga de la Maldición del Invierno, la Saga de las Val\'kyr y la Saga de las Gemelas.‡Viaja a Nafsavar, al norte del Puesto del Filo Fantasmal y busca la Saga de la Maldición del Invierno, la Saga de las Val\'kyr y la Saga de las Gemelas.‡Rendez-vous à Nifflevar, au nord du poste de la Lame-fantôme, et cherchez La saga de la malédiction de l’hiver, La saga des Val\'kyrs et La saga des jumeaux.‡进入幽刃岗哨北方的尼弗莱瓦，寻找寒冬诅咒的传说、女武神的传说和双子的传说。‡前往鬼刃崗哨北邊的尼弗瓦，尋找寒冬詛咒的英雄史詩、華爾琪英雄史詩和雙子的英雄史詩。',
  }
},
[11424] = {
  {
    'Monte Égide‡Заградительный холм‡Schildhügel‡방패 언덕‡Colina Escudo‡Colina Escudo‡La colline du Bouclier‡盾牌岭‡盾丘',
    nil,
    'Claudete "Serra de Arco" quer que você lhe traga 5 Ossos de Vraikal Antigos dos vraikalen reanimados do Monte Égide, a sul de Nova Agamand.‡Дженни по прозвищу "Пила" просит вас принести ей 5 древних врайкульских костей оживших мертвецов с Заградительного холма, который находится к югу от Нового Агамонда.‡"Eisensäge" Jenny möchte, dass Ihr 5 alte Knochen der Vrykul von den wiederauferstandenen Vrykul beim Schildhügel südlich von Neu-Agamand besorgt.‡"무쇠톱" 제니가 신 아가만드 남쪽의 방패 언덕에 있는 되살아난 브리쿨로부터 고대 브리쿨 뼈 5개를 가져다 달라고 했습니다.‡"Sierra" Jenny quiere que le traigas 5 huesos vrykuls antiguos de vrykul resucitado de Colina Escudo, al sur de Nuevo Agamand.‡"Sierra" Jenny quiere que le traigas 5 huesos vrykuls antiguos de vrykul resucitado de Colina Escudo, al sur de Nuevo Agamand.‡Jenny « Scie à métaux » vous demande de lui apporter 5 Os de vrykuls anciens des vrykuls réanimés de la Colline du Bouclier, au sud de Nouvelle-Agamand.‡“钢锯”杰妮要你前往新阿加曼德以南的盾牌岭，打败那些被复活的维库人，并收集5枚古代维库人徽记。‡『鋼鋸』潔妮需要你帶給她5個上古維酷骸骨，可以在新阿加曼德的南方的盾丘中，從再活化的維酷族身上找到。',
  }
},
[11425] = {
  {
    'Test Quest - Craig‡Тестовое задание – Крейг‡Test Quest - Craig‡시험용 퀘스트 - 크레이그‡Misión de prueba - Craig‡Misión de prueba - Craig‡Quête de test - Craig‡克莱格测试任务‡測試任務 - 克雷格',
    nil,
    'Pestes, que ódio desses bichos.‡Паразиты, ненавижу!‡Bla, bla.‡Vermin, gotta hate \'em.‡Vermin, gotta hate \'em.‡Vermin, gotta hate \'em.‡La vermine, faut la bousiller !‡Vermin, gotta hate \'em.‡害蟲，開始憎恨他們。',
  }
},
[11426] = {
  {
    'Encontrar o mecanismo‡В поисках механизма‡Den Mechanismus ausfindig machen‡장치를 찾아라‡Encontrar el mecanismo‡Encontrar el mecanismo‡Localiser le mécanisme‡寻找控制器‡找出裝置',
    nil,
    'O Capitão da Guarda Zorek, do assentamento Valgarde, no Fiorde Uivante, quer que você lhe traga o Mecanismo de Controle de Arpões.‡Капитан стражи Зорек из Валгарда в Ревущем фьорде просит вас принести механизм управления гарпуном.‡Wachoffizier Zorek bei Valgarde am Heulenden Fjord möchte, dass Ihr ihm einen Harpunenkontrollmechanismus bringt.‡울부짖는 협만의 발가드에 있는 경비대장 조렉이 작살포 제어 장치를 가져다 달라고 했습니다.‡El capitán de la guardia Zorek de Valgarde, en el Fiordo Aquilonal, quiere que le lleves un mecanismo de control de arpón.‡El capitán de la guardia Zorek de Valgarde, en el Fiordo Aquilonal, quiere que le lleves un mecanismo de control de arpón.‡Le capitaine de la garde Zorek, à Valgarde dans le Fjord Hurlant, vous demande de lui apporter un Mécanisme de commande de harpon.‡将鱼叉控制器交给瓦加德的守卫队长索雷克。‡守衛隊長索芮克要你把魚叉控制裝置帶來給他，他就在凜風峽灣的瓦爾加德。',
  }
},
[11427] = {
  {
    'Apresentando o tenente Malhogélido...‡Познакомьтесь с лейтенантом Ледяным Молотом‡Trefft Leutnant Eishammer‡부관 아이스해머 만나기‡Reúnete con el teniente Martillo de Hielo‡Reúnete con el teniente Martillo de Hielo‡Je vous présente le lieutenant Martel-de-glace…‡约格莫夫·冰锤中尉‡會見冰錘中尉……',
    nil,
    'O Capitão da Guarda Zorek quer que você leve o Mecanismo de Controle de Arpões até o Tenente Malhogélido, na parte externa de Niffelvar.‡Капитан стражи Зорек просит вас отнести механизм управления гарпуном лейтенанту Ледяному Молоту, который укрывается недалеко от Ниффлвара.‡Wachoffizier Zorek möchte, dass Ihr den Harpunenkontrollmechanismus zu Leutnant Eishammer außerhalb von Niffelvar bringt.‡경비대장 조렉이 작살포 제어 장치를 니플바르 밖에 있는 부관 아이스해머에게 전달해 달라고 했습니다.‡El capitán de la guardia Zorek quiere que le lleves el mecanismo de control de arpón al teniente Martillo de Hielo que se encuentra justo a las afueras de Nafsavar.‡El capitán de la guardia Zorek quiere que le lleves el mecanismo de control de arpón al teniente Martillo de Hielo que se encuentra justo a las afueras de Nafsavar.‡Le capitaine de la garde Zorek vous demande d\'apporter le Mécanisme de commande de harpon au Lieutenant Martel-de-glace stationné à l\'extérieur de Nifflevar.‡守卫队长索雷克要你将鱼叉控制器交给驻扎在尼弗莱瓦外的约格莫夫·冰锤中尉。‡守衛隊長索芮克要你去將魚叉控制裝置交給駐守在尼弗瓦外的冰錘中尉。',
  }
},
[11428] = {
  {
    'Guardião Mirrafolha‡Хранитель Листопад‡Hüter Welkblatt‡수호자 위더리프‡Vigilante Hojamarchita‡Vigilante Hojamarchita‡Le gardien Fanefeuille‡凋零之叶‡守護者凋葉',
    nil,
    'Sedielle, da Clareira Congelada, quer que você mate o Guardião Mirrafolha.‡Луриэль с Заиндевевшей поляны просит вас убить Хранителя Листопада.‡Lurielle auf der Gefrorenen Lichtung möchte, dass Ihr Hüter Welkblatt tötet.‡얼어붙은 숲에 있는 루리엘이 수호자 위더리프를 처치해 달라고 했습니다.‡Lurielle de El Claro Helado quiere que mates al vigilante Hojamarchita.‡Lurielle de El Claro Helado quiere que mates al vigilante Hojamarchita.‡Lurielle de la clairière Gelée veut que vous tuiez le Gardien Fanefeuille.‡冰雪林地的鲁莉尔蕾要求你杀死凋零之叶。‡冰凍林地的露麗兒要你去殺了守護者凋葉。',
  }
},
[11429] = {
  {
    'Ajoelhou, tem que rezar!‡Защищай знамя до последнего!‡Aufstellen und abrocken!‡깃발을 꽂아라!‡Déjalo y ondéalo‡Déjalo y ondéalo‡Posez, massacrez !‡不倒的军旗！‡放下，揮舞!',
    nil,
    'O Tenente Malhogélido, do Fiorde Uivante, quer que você finque o Estandarte da Aliança em Baleheim e então o defenda contra os atacantes.|n|nFale novamente com o Tenente Malhogélido levando o Estandarte da Aliança, caso você sobreviva.‡Лейтенант Ледяной Молот из Ревущего фьорда хочет, чтобы вы закрепили Знамя Альянса в Гибльхейме и защищали его от нападающих.|n|nЕсли вам удастся выжить в этом испытании, верните знамя лейтенанту Ледяному Молоту.‡Leutnant Eishammer im Heulenden Fjord möchte, dass Ihr das Banner der Allianz in Quälheim aufstellt und dieses gegen Angreifer verteidigt.|n|nKehrt gemeinsam mit dem Banner zu Leutnant Eishammer zurück, falls Ihr überleben solltet.‡울부짖는 협만의 부관 아이스해머가 얼라이언스 깃발을 베일하임에 설치하고 적에게서 깃발을 지켜 달라고 했습니다.|n|n살아남는다면 얼라이언스 깃발을 가지고 부관 아이스해머에게 가야 합니다.‡El teniente Martillo de Hielo en el Fiordo Aquilonal quiere que coloques el estandarte de la Alianza en Baleheim y que lo defiendas de sus atacantes.|n|nSi sobrevives, regresa junto al teniente Martillo de Hielo con el estandarte de la Alianza.‡El teniente Martillo de Hielo en el Fiordo Aquilonal quiere que coloques el estandarte de la Alianza en Baleheim y que lo defiendas de sus atacantes.|n|nSi sobrevives, regresa junto al teniente Martillo de Hielo con el estandarte de la Alianza.‡Le lieutenant Martel-de-glace, dans le Fjord Hurlant, veut que vous placiez la Bannière de l’Alliance à Torvheim et que vous la défendiez contre les attaquants.|n|nRevenez ensuite voir le lieutenant Martel-de-glace avec la Bannière de l’Alliance, si vous avez survécu.‡嚎风峡湾的约格莫夫·冰锤中尉要你将联盟军旗插在拜尔海姆中央，然后击败前来抢夺旗帜的维库人。|n|n完成任务后将联盟军旗还给他。‡凜風峽灣的冰錘中尉要你將聯盟旌旗放置在貝爾海姆，然後保護旌旗免於攻擊者攻擊。|n|n萬一你沒死，就將聯盟旌旗帶回去給冰錘中尉。',
  }
},
[11430] = {
  {
    'Mestre-arpoador Yavus‡Мастер-гарпунщик Явус‡Harpunenmeister Yavus‡작살대장 야부스‡Maestro arponero Yavus‡Maestro arponero Yavus‡Le maître harponneur Yavus‡鱼叉指挥官雅弗斯‡魚叉大師亞瓦思',
    nil,
    'O Tenente Malhogélido, do Fiorde Uivante, quer que você mate o Mestre-arpoador Yavus em Niffelvar.‡Лейтенант Ледяной Молот из Ревущего фьорда поручил вам убить мастера-гарпунщика Явуса в Ниффлваре.‡Leutnant Eishammer im Heulenden Fjord möchte, dass Ihr Harpunenmeister Yavus in Niffelvar tötet.‡울부짖는 협만의 부관 아이스해머가 니플바르에 있는 작살대장 야부스를 처치해 달라고 했습니다.‡El teniente Martillo de Hielo en el Fiordo Aquilonal quiere que mates al maestro arponero Yavus en Nafsavar.‡El teniente Martillo de Hielo en el Fiordo Aquilonal quiere que mates al maestro arponero Yavus en Nafsavar.‡Le lieutenant Martel-de-glace, dans le Fjord Hurlant, vous demande de tuer le Maître harponneur Yavus à Nifflevar.‡嚎风峡湾的约格莫夫·冰锤中尉要你前往尼弗莱瓦，杀死鱼叉指挥官雅弗斯。‡凜風峽灣的冰錘中尉要你去殺了尼弗瓦的魚叉大師亞瓦思。',
  }
},
[11431] = {
  {
    'Capturar os Lebrervos Selvagens!‡Поймать дикого зайцелопа!‡Fangt die wilden Wolpertinger!‡야생 노루토끼를 잡아라!‡¡Atrapa al wolpertinger salvaje!‡¡Atrapa al wolpertinger salvaje!‡Attraper le Wolpertinger sauvage !‡抓住鹿角小飞兔！‡抓住野生鹿角兔!',
    nil,
    'O "anão" Glodrak Caçatiros pediu para você capturar 5 Lebrervos Atordoados usando a Rede de Lebrervo. Ele disse que você precisa estar bêbado ou usando os Óculos da Visão Cervejárica para vê-los.‡"Дворф", Глодрак Меткий Охотник попросил вас поймать 5 оглушенных диких зайцелопов с помощью особой сети. Он намекнул, что необходимо достичь состояния сильного алкогольного опьянения – или хотя бы надеть Синтехмельные очки.‡Der "Zwerg" Glodrak Jägerspatz möchte, dass Ihr 5 betäubte Wolpertinger mit dem Wolpertingernetz einfangt. Er hat auch erwähnt, dass Ihr entweder ordentlich betrunken sein oder eine Syntheholbrille tragen müsst, um die Biester sehen zu können.‡"드워프" 글로드락 헌트스나이퍼가 술에 취하거나 신더브루 고글을 착용한 채로 노루토끼 그물을 이용해 5마리의 기절한 노루토끼를 잡아오라고 했습니다.‡El "enano" Glodrak Guasa te ha pedido que captures 5 wolpertingers aturdidos usando la red de wolpertinger. Ha mencionado que para verlos hace falta una buena borrachera o llevar las gafas birratizadoras.‡El "enano" Glodrak Guasa te ha pedido que captures 5 wolpertingers aturdidos usando la red de wolpertinger. Ha mencionado que para verlos hace falta una buena borrachera o llevar las gafas birratizadoras.‡Le « nain » Charedor Cassebéchasse vous a demandé de capturer 5 Wolpertingers sonnés avec le Filet à wolpertinger. Il a indiqué qu\'il fallait être soûl ou porter des Lunettes Synthébière pour les voir.‡“矮人”高达克·枪猎要你用鹿角小飞兔网捕捉5只昏迷的鹿角小飞兔。他说，你必须喝得酩酊大醉，或者是戴上合成酿酒护目镜，才有可能看见它们。‡『矮鬼』葛羅卓克·獵狙者要你用鹿角兔捕網幫他抓5隻昏迷的鹿角兔。他提到你必須要喝醉或戴上模擬醉眼護目鏡才看得到那些鹿角兔。',
  }
},
[11432] = {
  {
    'Gigantes adormecidos‡Спящие великаны‡Schlafende Riesen‡잠자는 거인‡Gigantes durmientes‡Gigantes durmientes‡Les géants endormis‡休眠的巨人‡沉睡的巨人',
    nil,
    'O Mago-tenente Malister que que você mate 5 Vraikalen Adormecidos. Apresente-se a ele novamente na Bastilha da Guarda Oeste ao terminar a tarefa.‡Маг-лейтенант Малистер поручил вам уничтожить 5 спящих врайкулов. Когда задание будет выполнено, вернитесь к нему в Крепость Западной стражи.‡Magierleutnant Malister hat Euch damit beauftragt, 5 schlafende Vrykul zu töten. Kehrt zu ihm zurück, sobald Ihr Eure Aufgabe erledigt habt. Er befindet sich in Westwacht.‡잠든 브리쿨 5명을 처치하고 서부경비대 성채에 있는 마법사 부관 말리스터에게 가야 합니다.‡El teniente mago Malister te ha encargado que mates 5 vrykuls en hibernación. Cuando hayas acabado, vuelve a verle a la Fortaleza de la Guardia Oeste.‡El teniente mago Malister te ha encargado que mates 5 vrykuls en hibernación. Cuando hayas acabado, vuelve a verle a la Fortaleza de la Guardia Oeste.‡Le Lieutenant-mage Malister veut que vous tuiez 5 Vrykuls dormants. Lorsque ce sera fait, retournez le voir au donjon de la Garde de l’ouest.‡法师中尉玛利斯特要你杀死5名休眠的维库人。完成任务后返回西部卫戍要塞向他复命。‡法師中尉瑪歷斯特要你殺死5個冬眠的維酷人。等你完成之後回到鎮西要塞向他回報。',
  }
},
[11433] = {
  {
    'Gigantes adormecidos‡Спящие великаны‡Schlafende Riesen‡잠자는 거인‡Gigantes durmientes‡Gigantes durmientes‡Les géants endormis‡休眠的巨人‡沉睡的巨人',
    nil,
    'Aota Gelo Branco que que você mate 5 Vraikalen Adormecidos. Fale novamente com ele na Aldeia Casco Invernal ao terminar a tarefa.‡Ахота Белый Иней поручил вам уничтожить 5 спящих врайкулов. Когда задание будет выполнено, вернитесь к нему в Лагерь Заиндевевшего Копыта.‡Ahota Weißfrost hat Euch damit beauftragt, 5 schlafende Vrykul zu töten. Kehrt zu ihm zurück, sobald Ihr Eure Aufgabe erledigt habt. Er befindet sich im Lager der Winterhufe.‡잠든 브리쿨 5명을 처치한 다음 겨울발굽 야영지에 있는 아호타 화이트프로스트에게 가야 합니다.‡Ahota Escarcha Blanca te ha encargado que mates 5 vrykuls en hibernación. Cuando hayas acabado, vuelve a verlo al Campamento Pezuña Invernal.‡Ahota Escarcha Blanca te ha encargado que mates 5 vrykuls en hibernación. Cuando hayas acabado, vuelve a verlo al Campamento Pezuña Invernal.‡Ahota Givre-blanc veut que vous tuiez 5 Vrykuls dormants. Lorsque ce sera fait, retournez le voir au Camp Sabot-d’hiver.‡安霍塔·白霜要你杀死5名休眠的维库人。完成任务后返回冬蹄营地向他复命。‡阿喉塔·白霜要你殺死5個冬眠的維酷人。等你完成之後回到冬蹄營地向他回報。',
  }
},
[11434] = {
  {
    'Tesouro esquecido‡Забытое сокровище‡Vergessene Schätze‡잊힌 보물‡Tesoro olvidado‡Tesoro olvidado‡Trésors oubliés‡被遗忘的宝藏‡被遺忘的寶藏',
    nil,
    'Téo Bonitão, da Angra dos Malandros, quer que você regate para ele 1 Vaso Amani e 1 Estatueta de Águia do naufrágio ao sul.‡Красавчик Терри из Лагеря Скалаваг просит вас достать аманийскую вазу и статуэтку орла с места кораблекрушения на юге.‡Der hübsche Terry im Halunkeneck möchte, dass Ihr ihm 1 Amanivase und 1 Adlerfigurine aus dem Schiffswrack gen Süden holt.‡해적 야영지의 잘생긴 테리가 남쪽의 난파선에서 아마니 꽃병 1개와 독수리 입상 1개를 가져다 달라고 했습니다.‡Terry el Hermoso del Cabo Pillastre quiere que le lleves 1 jarrón Amani y 1 figurilla de águila de los restos del naufragio al sur.‡Terry el Hermoso del Cabo Pillastre quiere que le lleves 1 jarrón Amani y 1 figurilla de águila de los restos del naufragio al sur.‡Terry le beau gosse, du Cap du Forban, vous demande de lui rapporter un Vase amani et une Figurine d\'aigle de l\'épave de bateau au sud.‡无赖港的帅哥泰里要求你到南方的沉船上找到一只阿曼尼花瓶和一座雄鹰雕像，并把它们交给他。‡無賴角的帥哥泰瑞要你從南方的沉船中帶給他1個阿曼尼飾瓶和1個雄鷹刻像。',
  }
},
[11435] = {
  {
    'Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI‡Gathered Pumpkins NYI',
    nil,
    'Leve as lanternas de abóbora para a Matriarca Fantasiada.‡Возьмите тыквы и переодетой попечительнице сирот.‡Bringt das Bündel Kürbislaternen zur kostümierten Waisenmatrone.‡축제 의상을 입은 보육원 원장님에게 호박등 다발을 가져가야 합니다.‡Lleva las calabazas iluminadas a la supervisora de huérfanos disfrazada.‡Lleva las calabazas iluminadas a la supervisora de huérfanos disfrazada.‡Apportez le Tas de citrouilles de la Sanssaint à la Directrice de l\'orphelinat costumée.‡将一堆南瓜灯交给穿戏服的孤儿院长。‡拿一堆南瓜燈籠回去給變裝的孤兒監護員。',
  }
},
[11436] = {
  {
    'Surfe no Fiorde‡Полетаем?‡Gehen wir Harpunenreiten!‡작살을 타고‡¡Vamos a hacer surf!‡¡Vamos a hacer surf!‡Et si on faisait du surf‡冲浪去！‡衝浪時刻',
    nil,
    'Use o grande Lança-arpão Vraikal, em Niffelvar, para se lançar até Valgarde. Relate sua vitória sobre os vraikalen para o Capitão da Guarda Zorek.‡Воспользуйтесь большой врайкульской пушкой в Ниффлваре и запустите себя в Валгард. Доложите о победе над врайкулами капитану стражи Зореку.‡Katapultiert Euch mithilfe der großen Harpunenkanone der Vrykul nach Valgarde. Erstattet Wachoffizier Zorek Bericht, falls Ihr Erfolg haben solltet.‡니플바르에서 커다란 브리쿨 작살포를 사용하여 발가드로 날아가 경비대장 조렉에게 브리쿨을 격파한 사실을 보고해야 합니다.‡Utiliza el gran arpón vrykul en Nafsavar para lanzarte hasta Valgarde. Informa de tu victoria sobre los vrykuls al capitán de la guardia Zorek.‡Utiliza el gran arpón vrykul en Nafsavar para lanzarte hasta Valgarde. Informa de tu victoria sobre los vrykuls al capitán de la guardia Zorek.‡Utilisez le grand Lance-harpons vrykul de Nifflevar pour vous lancer dans Valgarde. Informez le Capitaine de la garde Zorek de votre victoire sur les vrykuls.‡使用尼弗莱瓦的大型维库鱼叉炮把你自己发射到瓦加德去。向守卫队长索雷克报告你战胜维库人的消息。‡使用尼弗瓦的大型維酷魚叉獵槍把你自己射進瓦爾加德。向守衛隊長索芮克回報你對維酷人的勝利。',
  }
},
