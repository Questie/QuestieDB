[24792] = {
  {
    'O cara infiltrado‡Засланный шпион‡V-Mann‡잠복근무‡El topo‡El topo‡Un infiltré‡打入内部‡裡應外合',
    nil,
    'Fale com o Investigador Enfeza Cartasnamesa na Bastilha da Presa Negra.‡Найдите следователя Феззена Клейстра в Крепости Темного Клыка.‡Meldet Euch bei Ermittler Fezzen Kupferstapel auf Burg Schattenfang.‡그림자송곳니 성채에 있는 수사관 페젠 브라스택스에게 보고해야 합니다.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Faites votre rapport à l\'Enquêteur Fezzen Desfaits au Donjon d\'Ombrecroc.‡向影牙城堡的调查员费岑·布莱斯塔克报告。‡到影牙城堡找調查員菲贊·銅釘回報。',
  }
},
[24793] = {
  {
    'O cara infiltrado‡Засланный шпион‡V-Mann‡잠복근무‡El topo‡El topo‡Un infiltré‡打入内部‡裡應外合',
    nil,
    'Fale com o Investigador Enfeza Cartasnamesa na Bastilha da Presa Negra.‡Найдите следователя Феззена Клейстра в Крепости Темного Клыка.‡Meldet Euch bei Ermittler Fezzen Kupferstapel auf Burg Schattenfang.‡그림자송곳니 성채에 있는 수사관 페젠 브라스택스에게 보고해야 합니다.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Faites votre rapport à l\'Enquêteur Fezzen Desfaits au Donjon d\'Ombrecroc.‡向影牙城堡的调查员费岑·布莱斯塔克报告。‡到影牙城堡找調查員菲贊·銅釘回報。',
  }
},
[24794] = {
  {
    'Fale com Espraga‡Поговорить с Мучей‡Sprecht mit Spraggel‡스프래글과의 대화‡Habla con Spraggle‡Habla con Spraggle‡Parler à Spraggle‡跟斯普拉格交谈‡和斯普拉格談談',
    nil,
    'Fale com Espraga Froque no Posto Avançado do Marshal.‡Поговорите с Мучей Кусора на заставе Маршалла.‡Sprecht mit Spraggel Frock in Marschalls Wehr.‡마샬의 격전지에 있는 스프래글 프록과 대화해야 합니다.‡Habla con Spraggle Frock en el Alto de Marshal.‡Habla con Spraggle Frock en el Alto de Marshal.‡Parlez à Spraggle Frock au Camp retranché des Marshal.‡跟马绍尔哨站的斯普拉格·弗劳克谈一谈。‡到馬紹爾觀測站和斯普拉格·弗勞克談談。',
  }
},
[24795] = {
  {
    'Uma vitória para o Pacto de Prata‡Победа Серебряного союза‡Ein Sieg für den Silberbund‡은빛 서약단의 승리‡Una victoria para El Pacto de Plata‡Una victoria para El Pacto de Plata‡Une victoire pour le Concordat argenté‡银色盟约的胜利‡白銀誓盟的勝利',
    nil,
    'Leve a Quel\'Delar Restaurada para a Justicar Mariel Veras, nos Campos do Torneio Argênteo.‡Принесите восстановленный Кель\'Делар Вершительнице правосудия Мариэль Чистосердечной на ристалище Серебряного Турнира.‡Bringt das wiederhergestellte Quel\'Delar zu Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Rapportez Quel\'Delar réparée à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡将奎尔德拉交给银色比武场的裁决者玛蕾尔·图哈特。‡到銀白聯賽場地，把復原的奎爾德拉交給審判者瑪瑞爾‧真心。',
  }
},
[24796] = {
  {
    'Uma vitória para o Pacto de Prata‡Победа Серебряного союза‡Ein Sieg für den Silberbund‡은빛 서약단의 승리‡Una victoria para El Pacto de Plata‡Una victoria para El Pacto de Plata‡Une victoire pour le Concordat argenté‡银色盟约的胜利‡白銀誓盟的勝利',
    nil,
    'Leve a Quel\'Delar Restaurada para Vereesa Correventos na Cidadela Violeta, em Dalaran.‡Принесите восстановленный Кель\'Делар Верисе Ветрокрылой в Аметистовую цитадель Даларана.‡Bringt das wiederhergestellte Quel\'Delar zu Vereesa Windläufer in der Violetten Zitadelle in Dalaran.‡달라란의 보랏빛 성채에 있는 베리사 윈드러너에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada a Vereesa Brisaveloz a la Ciudadela Violeta de Dalaran.‡Llévale la Quel\'Delar restaurada a Vereesa Brisaveloz a la Ciudadela Violeta de Dalaran.‡Rapportez Quel\'Delar réparée à Vereesa Coursevent à la Citadelle Pourpre, à Dalaran.‡将奎尔德拉交给达拉然紫罗兰城堡中的温蕾萨·风行者。‡到達拉然的紫羅蘭城塞，把復原的奎爾德拉交給凡蕾莎‧風行者。',
  }
},
[24797] = {
  {
    'REUSE‡REUSE‡REUSE‡재사용‡REUSE‡REUSE‡RÉUTILISER‡REUSE‡重複利用',
    nil,
    nil,
  }
},
[24798] = {
  {
    '‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡‡',
    nil,
    '‡Принесите восстановленный Кель\'Делар Вершительнице правосудия Мариэль Чистосердечной на ристалище Серебряного Турнира.‡Bringt das wiederhergestellte Quel\'Delar zu Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Rapportez Quel\'Delar réparée à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡将奎尔德拉交给银色比武场的裁决者玛蕾尔·图哈特。‡',
  }
},
[24799] = {
  {
    'Uma vitória para os Fendessol‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    'Leve a Quel\'Delar Restaurada para a Justicar Mariel Veras, nos Campos do Torneio Argênteo.‡Принесите восстановленный Кель\'Делар Вершительнице правосудия Мариэль Чистосердечной на ристалище Серебряного Турнира.‡Bringt das wiederhergestellte Quel\'Delar zu Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Rapportez Quel\'Delar réparée à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡将奎尔德拉交给银色比武场的裁决者玛蕾尔·图哈特。‡到銀白聯賽場地，把復原的奎爾德拉交給審判者瑪瑞爾‧真心。',
  }
},
[24800] = {
  {
    'Uma vitória para os Fendessol‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    'Leve a Quel\'Delar Restaurada para o Arquimago Aethas Fendessol na Cidadela Violeta, em Dalaran.‡Принесите восстановленный Кель\'Делар Верховному магу Этасу Похитителю Солнца в Аметистовую цитадель Даларана.‡Bringt das wiederhergestellte Quel\'Delar zu Erzmagier Aethas Sonnenhäscher in der Violetten Zitadelle in Dalaran.‡달라란의 보랏빛 성채에 있는 대마법사 에이타스 선리버에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Rapportez Quel\'Delar réparée à l\'Archimage Aethas Saccage-soleil à la Citadelle Pourpre, à Dalaran.‡将奎尔德拉交给达拉然紫罗兰城堡的大法师艾萨斯·夺日者。‡到達拉然紫羅蘭城塞，把復原的奎爾德拉交給大法師埃薩‧奪日者。',
  }
},
[24801] = {
  {
    'Uma vitória para os Fendessol‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    'Leve a Quel\'Delar Restaurada para o Arquimago Aethas Fendessol na Cidadela Violeta, em Dalaran.‡Принесите восстановленный Кель\'Делар Верховному магу Этасу Похитителю Солнца в Аметистовую цитадель Даларана.‡Bringt das wiederhergestellte Quel\'Delar zu Erzmagier Aethas Sonnenhäscher in der Violetten Zitadelle in Dalaran.‡달라란의 보랏빛 성채에 있는 대마법사 에이타스 선리버에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Rapportez Quel\'Delar réparée à l\'Archimage Aethas Saccage-soleil à la Citadelle Pourpre, à Dalaran.‡将奎尔德拉交给达拉然紫罗兰城堡的大法师艾萨斯·夺日者。‡到達拉然紫羅蘭城塞，把復原的奎爾德拉交給大法師埃薩‧奪日者。',
  }
},
[24802] = {
  {
    'A ira do Lich Rei‡Гнев Короля-лича‡Der Zorn des Lichkönigs‡리치 왕의 분노‡La cólera del Rey Exánime‡La cólera del Rey Exánime‡La colère du roi-liche‡巫妖王之怒‡巫妖王之怒',
    nil,
    'Encontre a Grande Dama Sylvana Correventos e escape dos Salões da Reflexão.‡Найдите леди Сильвану Ветрокрылую и выберитесь из Залов Отражений.‡Findet Fürstin Sylvanas Windläufer und flieht aus den Hallen der Reflexion.‡여군주 실바나스 윈드러너를 찾은 다음 투영의 전당을 탈출해야 합니다.‡Encuentra a Lady Sylvanas Brisaveloz y escapa de Las Cámaras de Reflexión.‡Encuentra a Lady Sylvanas Brisaveloz y escapa de Las Cámaras de Reflexión.‡Trouvez Dame Sylvanas Coursevent et enfuyez-vous des Salles des Reflets.‡找到希尔瓦娜斯·风行者，并逃出映像大厅。‡找到希瓦娜斯·風行者女士，逃離倒影大廳。',
  }
},
[24803] = {
  {
    'Campeonato de Pesca dos Kalu\'ak‡Калуакское рыбоборье‡Angelwettstreit der Kalu\'ak‡칼루아크 낚시 대회‡Competición de pesca Kalu\'ak‡Competición de pesca Kalu\'ak‡Le tournoi de pêche kalu\'ak‡卡鲁亚克钓鱼大赛‡卡魯耶克釣魚大賽',
