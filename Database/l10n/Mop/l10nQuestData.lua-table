},
[1642] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Sturmwind.‡‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1643] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Procure Stephanie Turner no Distrito Comercial de Ventobravo.‡Обыщите Торговый квартал и найдите Стефани Тернер.‡Sucht im Handelsdistrikt von Sturmwind nach Stephanie Turner.‡스톰윈드의 상업 지구에서 스테파니 터너를 찾아야 합니다.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Chercher Stephanie Turner dans le Quartier commerçant de Hurlevent.‡在暴风城的贸易区找到斯蒂芬妮·特纳。‡到暴風城的貿易區找尋斯蒂芬妮·特納。',
  }
},
[1644] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    '‡Принесите 10 отрезов льна в Штормград и отдайте Стефани Тернер.‡Bringt 10 Stück Leinenstoff zu Stephanie Turner in Sturmwind.‡‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Apporter 10 morceaux d\'étoffe de lin à Stephanie Turner à Hurlevent.‡给暴风城的斯蒂芬妮·特纳收集10块亚麻布。‡給暴風城的斯蒂芬妮·特納收集10塊亞麻布。',
  }
},
[1645] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    nil,
  }
},
[1646] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Поговорите с Тизой Боевой Горн в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡与铁炉堡的蒂萨·热炉谈话。‡',
  }
},
[1647] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Найдите во внешнем кольце Стальгорна Джона Тернера.‡Sucht im Äußeren Ring von Eisenschmiede nach John Turner.‡‡Busca a John Turner en el anillo exterior de Forjaz.‡Busca a John Turner en el anillo exterior de Forjaz.‡Chercher John Turner à la périphérie de Forgefer.‡在铁炉堡的外环区域找到约翰·特纳。‡',
  }
},
[1648] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve 10 peças de Linho para João Turner em Altaforja.‡Принесите 10 отрезов льняной ткани Джону Тернеру в Стальгорн.‡Bringt 10 Stück Leinenstoff zu John Turner in Eisenschmiede.‡아이언포지에 있는 존 터너에게 리넨 옷감 10개를 가져가 기부해야 합니다.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Apporter 10 morceaux d\'étoffe de lin à John Turner à Forgefer.‡收集10块亚麻布，把它们交给铁炉堡的约翰·特纳。‡收集10塊亞麻布，把它們交給鐵爐堡的約翰·特納。',
  }
},
[1649] = {
  {
    '‡Фолиант Отваги‡Der Foliant der Tapferkeit‡‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡',
    nil,
    '‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Sturmwind.‡‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1650] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Encontre Dafne Calmafonte no Cerro Oeste.‡Найдите Дафну Стилвелл в Западном Крае.‡Sucht Daphne Stillbrunn in Westfall.‡서부 몰락지대에 있는 다프네 스틸웰을 찾아야 합니다.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Trouver Daphne Morpuits dans la marche de l\'Ouest.‡在西部荒野找到达芙妮·斯迪威尔。‡在西部荒野找到達芙妮·斯迪威爾。',
  }
},
[1651] = {
  {
    '‡Фолиант Отваги‡Der Foliant der Tapferkeit‡‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡',
    nil,
    '‡Защитите Дафну Стилвелл от нападения Братства Справедливости. Проследите, чтобы ни ее, ни ваша душа в случае смерти не покинули свои тела, иначе испытание не будет засчитано.|n|nПосле победы поговорите с Дафной Стилвелл.‡Verteidigt Daphne Stillbrunn vor dem Angriff der Defias.|n|nKeiner Eurer Geister darf aus seinen irdischen Fesseln befreit werden, wenn Ihr erfolgreich sein wollt.|n|nSprecht erneut mit Daphne Stillbrunn, wenn Ihr erfolgreich wart.‡‡Defiende a Daphne Fontana del ataque de los Defias.|n|nSi quieres tener éxito, vuestros espíritus no pueden salir de sus espirales mortales.|n|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Defiende a Daphne Fontana del ataque de los Defias.|n|nSi quieres tener éxito, vuestros espíritus no pueden salir de sus espirales mortales.|n|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Défendez Daphne Morpuits contre les attaques des Défias.|n|nAucun de vous deux ne doit mourir, si vous voulez réussir la quête.|n|nQuand vous aurez réussi, reparlez à Daphne Morpuits.‡在迪菲亚兄弟会进攻时保护达芙妮·斯迪威尔的安全。|n|n如果你想成功的话，你和达芙妮都不能死在他们的剑下。‡',
  }
},
[1652] = {
  {
    '‡Фолиант Отваги‡Der Foliant der Tapferkeit‡‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡',
    nil,
    '‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Sturmwind.‡‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1653] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Fale com Jardel Calmafonte em Altaforja.‡Поговорите с Джорданом Стилвеллом в Стальгорне.‡Sprecht mit Jordan Stillbrunn in Eisenschmiede.‡아이언포지에 있는 조던 스틸웰과 대화해야 합니다.‡Habla con Jordan Fontana en Forjaz.‡Habla con Jordan Fontana en Forjaz.‡Parler à Jordan Morpuits à Forgefer.‡去和铁炉堡的乔丹·斯迪威尔谈一谈。‡去和鐵爐堡的喬丹·斯迪威爾談話。',
  }
},
[1654] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Usando as Anotações do Jardel sobre Armas, encontre Madeira de Carvalho de Pedralva, o Carregamento de Minério Refinado do Bailor, o Martelo de Ferreiro de Jardel e uma Gema Kor. Depois, entregue tudo a Jardel Calmafonte em Altaforja.‡Возьмите список Джордана, добудьте немного древесины белокаменного дуба, партию очищенной руды Бэйлора, кузнечный молот Джордана и самоцвет Кора и отдайте их Джордану Стилвеллу в Стальгорне.‡Sucht mit Jordans Waffennotizen etwas Weißsteineichenholz, Bailors aufbereitete Erzlieferung, Jordans Schmiedehammer und einen Koredelstein und bringt alles zusammen zu Jordan Stillbrunn in Eisenschmiede.‡조던의 쪽지를 참고해 흰돌참나무 재목, 조던의 제련된 광석 상자, 조던의 대장장이 망치, 그리고 코르석을 찾아 아이언포지에 있는 조던 스틸웰에게 가져가야 합니다.‡Consulta los apuntes sobre armas y llévale a Jordan Fontana de Forjaz lo siquiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrería de Jordan y una gema Kor.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siguiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Utiliser les Notes sur les armes de Jordan, trouver du Bois de chêne de blanchepierre, la Cargaison de Minerai raffiné de Bailor, le Marteau de forge de Jordan et une Gemme de Kor, puis revenir voir Jordan Morpuits à Forgefer.‡按照乔丹的武器材料单上的说明去寻找一些白石橡木、精炼矿石、乔丹的铁锤和一块科尔宝石，然后回到铁炉堡去见乔丹·斯迪威尔。‡按照喬丹的武器材料單上的說明去尋找一些白石橡木、精煉礦石、喬丹的鐵錘和一塊科爾寶石，然後回到鐵爐堡去見喬丹·斯迪威爾。',
  }
},
[1655] = {
  {
    'Carregamento de minério do Bailor‡Партия руды Балора‡Bailors Erzlieferung‡조던의 광석 상자‡Envío de mena de Bailor‡Envío de mena de Bailor‡Cargaison de minerai de Bailor‡白洛尔的矿石‡白洛爾的礦石',
    nil,
    'Leve o Carregamento de Minério do Jardel até Bailor Manopedra, em Loch Modan.‡Доставьте партию руды для Джордана Балору Крепкоруку к озеру Лок Модан.‡Bringt Jordans Erzlieferung zu Bailor Steinhand in Loch Modan.‡모단 호수에 있는 베일러 스톤핸드에게 조던의 광석 상자를 가져가야 합니다.‡Lleva el envío de mena de Jordan a Bailor Petramano a Loch Modan.‡Lleva el envío de Jordan a Bailor Petramano a Loch Modan.‡Apporter la Cargaison de minerai de Jordan à Bailor Main-de-pierre au Loch Modan.‡把乔丹的矿石带给洛克莫丹的白洛尔·石手。‡把喬丹的礦石帶給洛克莫丹的白洛爾·石手。',
  }
},
[1656] = {
  {
    'Serviço pela metade‡Незаконченное задание‡Eine unvollendete Aufgabe‡완수하지 못한 임무‡Una tarea por terminar‡Una tarea por terminar‡Une tâche inachevée‡未完的任务‡未完的任務',
    nil,
    'Leve a Trouxa de Peles para o Estalajadeiro Kauth na Aldeia Casco Sangrento.‡Отнесите сверток мехов хозяину таверны Кауту в деревню Кровавого Копыта.‡Bringt das Bündel Felle zu Gastwirt Kauth ins Dorf der Bluthufe.‡블러드후프 마을에 있는 여관주인 카우스에게 모피 묶음을 가져가야 합니다.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Livrez le Ballot de fourrures à l\'aubergiste Kauth à Sabot-de-Sang.‡将一捆毛皮带给血蹄村的旅店老板考乌斯。‡將一捆毛皮帶給血蹄村的旅店老闆考烏斯。',
  }
},
[1657] = {
  {
    'Fedor na Costa Sul‡Подпортим воздух в Южнобережье‡Die Verpestung von Süderstade‡남녘해안에 구린내 폭탄 투하‡Apesta Costasur‡Apesta Costasur‡Empuantir Austrivage‡臭气熏天的南海镇‡薰死南海鎮',
    nil,
    'Atire três Bombas Fedidas dos Renegados no coração da Costa Sul, em Eira dos Montes, e fale novamente com a Invoca-trevas Yanka no Festival do Homem de Palha, nas Clareiras de Tirisfal.‡Бросьте три бомбы-вонючки Отрекшихся в центр Южнобережья в Хилсбраде и вернитесь к призывательнице тьмы Янке на фестиваль Плетеного человека в Тирисфальских лесах.‡Werft drei Stinkbomben der Verlassenen ins Herz von Süderstade im Hügelland und kehrt zu Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡언덕마루에 있는 남녘해안 한가운데에 3개의 포세이큰 구린내 폭탄을 던진 후, 티리스팔 숲의 밀짚인형 축제가 열리는 곳에 있는 암흑의 소환사 얀카에게 가야 합니다.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lancer trois Boules puantes des Réprouvés au milieu d\'Austrivage en Hautebrande, puis revenez voir la sombre imploratrice Yanka à la Fête de l\'homme d\'osier, aux Clairières de Tirisfal.‡将三颗亡灵臭气弹放置在希尔斯布莱德丘陵的南海镇中心，完成任务之后回到提瑞斯法林地的黑暗召唤者雅恩卡那里。‡在希爾斯布萊德的南海鎮中心投擲三顆被遺忘者臭彈，然後回去找在提里斯法林地的稻草人節的黑暗召喚者雅恩卡。',
  }
},
[1658] = {
  {
    'Penetra no Festival do Homem de Palha‡Сорвать праздник Плетеного человека‡Bespitzelt das Fest des Weidenmanns‡밀짚인형 축제 정탐‡Arruinar el Festival del Hombre de Mimbre‡Arruinar el Festival del Hombre de Mimbre‡Un intrus à la Fête de l\'homme d\'osier‡稻草人的节日‡破壞稻草人節',
    nil,
    'Localize o Festival do Homem de Palha nas Clareiras de Tirisfal. Depois, fale novamente com o Sargento Hartman na Costa Sul.‡Отыщите место проведения фестиваля Плетеного человека в Тирисфальских лугах и возвращайтесь в Южнобережье к сержанту Хартману.‡Macht das Fest des Weidenmanns der Verlassenen in Tirisfal ausfindig. Kehrt zu Unteroffizier Hartman in Süderstade zurück, sobald Ihr Eure Mission erfüllt habt.‡티리스팔 숲에서 포세이큰의 밀짚인형 축제가 열리고 있는 곳을 찾아 정탐한 후 남녘해안에 있는 하사관 허트만에게 가야 합니다.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Allez voir la Fête de l\'homme d\'osier des Réprouvés dans les clairières de Tirisfal. Revenez voir le Sergent Hartman à Austrivage quand ce sera fait.‡在提瑞斯法林地找到被遗忘者的稻草人节日举办地点。任务完成之后回到南海镇的哈特曼中士那里。‡找出提里斯法林地的被遺忘者的稻草人節所在地。完成後回去向南海鎮的哈特曼中士覆命。',
  }
},
