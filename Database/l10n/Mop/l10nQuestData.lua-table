[3042] = {
  {
    'Têmpera de troll‡Троллье месиво‡Trollaushärter‡트롤 경화제‡Temple trol‡Temple trol‡Agent durcissant troll‡巨魔调和剂‡食人妖調和劑',
    nil,
    'Leve 20 Frascos de Têmpera de Troll para Trenton Lumartelo em Geringontzan.‡Принесите 20 фиалов с Тролльим месивом.‡Bringt 20 Phiolen Trollaushärter zu Trenton Lichthammer in Gadgetzan.‡가젯잔에 있는 트렌튼 라이트해머에게 트롤 경화제 20병을 가져가야 합니다.‡Lleva 20 viales de temple trol a Trenton Mazaligera en Gadgetzan.‡Lleva 20 viales de temple trol a Trenton Mazaligera en Gadgetzan.‡Apporter 20 Fioles d\'agent durcissant troll à Trenton Martelume, à Gadgetzan.‡收集20瓶巨魔调和剂，把它们交给加基森的特伦顿·轻锤。‡收集20瓶食人妖調和劑，把它們交給加基森的特倫頓·輕錘。',
  }
},
[3062] = {
  {
    'Coração sombrio‡Темное сердце‡Dunkles Herz‡검은 심장‡Corazón oscuro‡Corazón oscuro‡Cœur noir‡黑暗坠饰‡黑心',
    nil,
    'Talo Casco de Espinhos, da Aldeia Mojache, quer o Coração Sombrio de Edana Iragarra.‡Принесите темное сердце Эданы Коготь Ненависти Тало Терновому Копыту.‡Talo Dornhuf im Camp Mojache will das dunkle Herz von Edana Hasskralle.‡모자케 야영지에 있는 탈로 쏜후프가 에다나의 검은 심장을 가져다 달라고 했습니다.‡Talo Pezuñahendida, del Campamento Mojache quiere el corazón oscuro de Edana Garfaodio.‡Talo Pezuñahendida, del Campamento Mojache quiere el corazón oscuro de Edana Garfaodio.‡Rapporter le Cœur noir d\'Edana Serrehaine à Talo Sabot-de-ronce, au Camp Mojache.‡莫沙彻营地的塔罗·刺蹄要你给他拿去艾丹娜·邪爪的黑色坠饰。‡莫沙徹營地的塔羅·刺蹄要你給他拿去艾丹娜·邪爪的黑心。',
  }
},
[3063] = {
  {
    'Vingança em Nascente Norte‡Месть стае Студеных Ключей‡Rache an den Nordschwingen‡바람계곡 일족에 대한 복수‡Venganza contra Nortearroyo‡Venganza contra Nortearroyo‡Se venger des Ruissenord‡对鹰身人的复仇‡對鷹身人的復仇',
    nil,
    'Talo Casco de Espinhos quer que você mate 4 Harpias da Nascente Norte, 4 Plumerrantes da Nascente Norte, 4 Arautos do Vento da Nascente Norte e 4 Matadoras da Nascente Norte.‡Убейте 4 гарпий, 4 разбойниц, 4 призывательниц ветра и 4 убийц из стаи Студеных Ключей по просьбе Тало Тернового Копыта.‡Talo Dornhuf möchte, dass Ihr 4 Harpyien der Nordschwingen, 4 Wildfedern der Nordschwingen, 4 Windruferinnen der Nordschwingen und 4 Töter der Nordschwingen erschlagt.‡탈로 쏜후프가 바람계곡 하피 4마리, 바람계곡 약탈자 4마리, 바람계곡 바람소환사 4마리, 그리고 바람계곡 암살자 4마리를 처치해 달라고 했습니다.‡Talo Pezuñahendida quiere que mates a 4 arpías Nortearroyo, 4 Malaplumas Nortearroyo, 4 clamavientos Nortearroyo y 4 destripadoras Nortearroyo.‡Talo Pezuñahendida quiere que mates a 4 arpías Nortearroyo, 4 Malaplumas Nortearroyo, 4 clamavientos Nortearroyo y 4 destripadoras Nortearroyo.‡Tuer 4 Harpies ruissenord, 4 Volplumes ruissenord, 4 Imploratrices célestes ruissenord et 4 Pourfendeuses ruissenord pour Talo Sabot-de-ronce.‡塔罗·刺蹄让你杀掉4个北泉鹰身人、4个北泉游荡者、4个北泉唤风者和4个北泉杀戮者。‡塔羅·刺蹄讓你殺掉4個北泉鷹身人、4個北泉遊蕩者、4個北泉喚風者和4個北泉殺戮者。',
  }
},
[3064] = {
  {
    '<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Sombreros de pirata‡<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Pirate Hats‡<NYI> <TXT> Pirate Hats',
    nil,
    'Leve 20 Chapéus de Pirata Intactos para Yorba Parafuseta.‡Принесите 20 целых пиратских шляп Юрбе Крутипроб.‡Bringt 20 unzerrissene Piratenhüte zu Yorba Schraubstutz.‡멀쩡한 해적 모자 20개를 요르바 스크류스피곳에게 가져가야 합니다.‡Llévale 20 sombreros de pirata intactos a Yorba Llavenrosca.‡Llévale 20 sombreros de pirata nuevos a Yorba Llavenrosca.‡Apporter 20 Chapeaux de pirate à Yorba Fermevanne.‡带20顶Untorn Pirate Hats给......‡帶20頂完整的海賊帽給尤爾巴·斯庫比格特。',
  }
},
[3065] = {
  {
    '‡Простая табличка‡Einfache Schrifttafel‡간결한 서판‡Tablilla simple‡Tablilla simple‡Tablette simple‡普通石板‡普通石板',
    nil,
    '‡Прочтите простую табличку и поговорите с Франгом в Долине Испытаний.‡Lest die einfache Schrifttafel und sprecht mit Frang im Tal der Prüfungen.‡‡Lee la Tablilla simple y habla con Frang en el Valle de los Retos.‡Lee la Tablilla simple y habla con Frang en el Valle de los Retos.‡Lire la Tablette simple, et parler à Frang, dans la Vallée des Épreuves.‡阅读普通石板，然后和试炼谷的弗朗恩谈一谈。‡',
  }
},
[3082] = {
  {
    '‡Каменная табличка‡Geätzte Schrifttafel‡글이 새겨진 서판‡Tablilla con grabados‡Tablilla con grabados‡Tablette gravée‡风蚀石板‡風蝕石板',
    nil,
    '‡Поговорите с Джен\'шан в Долине Испытаний.‡Sprecht mit Jen\'shan im Tal der Prüfungen.‡‡Habla con Jen\'shan en el Valle de los Retos.‡Habla con Jen\'shan en el Valle de los Retos.‡Parler à Jen\'shan dans la Vallée des Épreuves.‡和试炼谷的基沙谈一谈。‡',
  }
},
[3083] = {
  {
    '‡Табличка с письменами‡Verschlüsselte Schrifttafel‡암호화된 서판‡Tablilla encriptada‡Tablilla encriptada‡Tablette codée‡密文石板‡密文石板',
    nil,
    '‡Прочтите табличку с письменами и поговорите с Руагом в Долине Испытаний.‡Lest die verschlüsselte Schrifttafel und sprecht mit Rwag im Tal der Prüfungen.‡‡Lee la Tablilla encriptada y habla con Rwag en el Valle de los Retos.‡Lee la Tablilla encriptada y habla con Rwag en el Valle de los Retos.‡Lire la Tablette codée, et parler à Rwag, dans la Vallée des Épreuves.‡阅读密文石板，然后和试炼谷的鲁瓦格谈一谈。‡',
  }
},
[3084] = {
  {
    '‡Руническая табличка‡Mit Runen beschriftete Schrifttafel‡룬으로 새겨진 서판‡Tablilla con runas grabadas‡Tablilla con runas grabadas‡Tablette runique‡符文石板‡符文銘刻石板',
    nil,
    '‡Поговорите с Шикрик в Долине Испытаний.‡Sprecht mit Shikrik im Tal der Prüfungen.‡‡Habla con Shikrik en el Valle de los Retos.‡Habla con Shikrik en el Valle de los Retos.‡Parlez à Shikrik dans la Vallée des Épreuves.‡和试炼谷的史克里克谈一谈。‡',
  }
},
[3085] = {
  {
    '‡Освященная табличка‡Geheiligte Schrifttafel‡성스러운 서판‡Tablilla sacralizada‡Tablilla sacralizada‡Tablette bénie‡神圣石板‡神聖石板',
    nil,
    '‡Прочтите освященную табличку и поговорите с Кен\'джаем у Логова в Долине Испытаний.‡Lest die geheiligte Schrifttafel und sprecht mit Ken\'jai außerhalb des Höhlenbaus im Tal der Prüfungen.‡‡Lee la tablilla sacralizada y habla con Ken\'jai a las puertas de El Cubil en el Valle de los Retos.‡Lee la tablilla sacralizada y habla con Ken\'jai a las puertas de El Cubil en el Valle de los Retos.‡Lire la Tablette bénie, et parler à Ken\'jai, à l\'extérieur de l\'Antre, dans la Vallée des Épreuves.‡阅读神圣石板，然后和试炼谷大兽穴外的肯杰谈一谈。‡',
  }
},
[3086] = {
  {
    '‡Табличка с тайными знаками‡Glyphenschrifttafel‡상형 문자로 된 서판‡Tablilla glífica‡Tablilla glífica‡Tablette glyphée‡雕文石板‡雕紋石板',
    nil,
    '‡Прочтите табличку с тайными знаками и поговорите с Май\'ах у входа в Логово в Долине Испытаний.‡Lest die mit Glyphen versehene Schrifttafel und sprecht mit Mai\'ah beim Eingang zum Höhlenbau im Tal der Prüfungen.‡‡Lee la tablilla glífica y habla con Mai\'ah junto a la entrada a El Cubil, en el Valle de los Retos.‡Lee la tablilla glífica y habla con Mai\'ah junto a la entrada a El Cubil, en el Valle de los Retos.‡Lire la Tablette glyphée, et parler à Mai\'ah, près de l\'entrée de l\'Antre, dans la Vallée des Épreuves.‡阅读雕文石板，然后和试炼谷里大兽穴入口附近的迈安谈一谈。‡',
  }
},
[3087] = {
  {
    'Pergaminho cinzelado‡Пергамент с письменами‡Geätztes Pergament‡글이 새겨진 양피지‡Papiro con grabados‡Papiro con grabados‡Parchemin gravé‡风蚀羊皮纸‡風蝕羊皮紙',
    nil,
    'Leia o Pergaminho Cinzelado e fale com Karranisha no Vale das Provações.‡Прочтите пергамент с письменами и поговорите с Карранишей в Долине Испытаний.‡Lest das geätzte Pergament und sprecht mit Karranisha im Tal der Prüfungen.‡글이 새겨진 양피지를 읽어보고 시험의 골짜기에 있는 카라니샤와 대화해야 합니다.‡Lee el papiro con grabados y habla con Karranisha en el Valle de los Retos.‡Lee el papiro con grabados y habla con Karranisha en el Valle de los Retos.‡Lire le Parchemin gravé, et parler à Karranisha, dans la Vallée des Épreuves.‡阅读风蚀羊皮纸，然后和试炼谷的卡朗尼沙谈一谈。‡閱讀風蝕羊皮紙，然後和試煉谷的卡倫尼夏談話。',
  }
},
[3088] = {
  {
    'Pergaminho cifrado‡Зашифрованный пергамент‡Verschlüsseltes Pergament‡암호화된 양피지‡Papiro encriptado‡Papiro encriptado‡Parchemin codé‡密文羊皮纸‡密文羊皮紙',
    nil,
    'Leia o Pergaminho Cifrado e fale com Rwag no Vale das Provações.‡Прочтите исписанный пергамент и поговорите с Руагом в долине Испытаний.‡Lest das verschlüsselte Pergament und sprecht mit Rwag im Tal der Prüfungen.‡암호화된 양피지를 읽어보고 시험의 골짜기에 있는 르와그와 대화해야 합니다.‡Lee el papiro encriptado y habla con Rwag en el Valle de los Retos.‡Lee el papiro encriptado y habla con Rwag en el Valle de los Retos.‡Lire le Parchemin codé, et parler à Rwag, dans la Vallée des Épreuves.‡阅读密文羊皮纸，然后和试炼谷的鲁瓦格谈一谈。‡閱讀密文羊皮紙，然後和試煉谷的魯瓦格談話。',
  }
},
[3089] = {
  {
    'Pergaminho inscrito em runas‡Рунический пергамент‡Mit Runen beschriftetes Pergament‡룬으로 새겨진 양피지‡El papiro con runas grabadas‡El papiro con runas grabadas‡Parchemin runique‡符文羊皮纸‡符文羊皮紙',
    nil,
    'Leia o Pergaminho Inscrito em Runas e fale com Shikrik no Vale das Provações.‡Прочтите рунический пергамент и поговорите с Шикрик в долине Испытаний.‡Lest das mit Runen beschriebene Pergament und sprecht mit Shikrik im Tal der Prüfungen.‡룬으로 새겨진 양피지를 읽어보고 시험의 골짜기에 있는 시크리크와 대화해야 합니다.‡Lee el papiro con runas grabadas y habla con Shikrik en el Valle de los Retos.‡Lee el papiro con runas grabadas y habla con Shikrik en el Valle de los Retos.‡Lire le Parchemin runique, et parler à Shikrik, dans la Vallée des Épreuves.‡阅读符文羊皮纸，然后和试炼谷的史克里克谈一谈。‡閱讀符文羊皮紙，然後和試煉谷的史克里克談話。',
  }
},
[3090] = {
  {
    'Pergaminho maculado‡Гниющий пергамент‡Besudeltes Pergament‡오래된 양피지‡Papiro corrupto‡Papiro corrupto‡Parchemin contaminé‡被污染的羊皮纸‡受污染的羊皮紙',
    nil,
    'Leia o Pergaminho Maculado e fale com Nartok no Vale das Provações.‡Прочтите гниющий пергамент и поговорите с Нартоком в Долине Испытаний.‡Lest das besudelte Pergament und sprecht mit Nartok im Tal der Prüfungen.‡오래된 양피지를 읽어보고 시험의 골짜기에 있는 나르톡과 대화해야 합니다.‡Lee el papiro corrupto y habla con Nartok en el Valle de los Retos.‡Lee el papiro corrupto y habla con Nartok en el Valle de los Retos.‡Lire le Parchemin contaminé, et parler à Nartok dans la Vallée des Épreuves.‡阅读被污染的羊皮纸，然后和试炼谷的纳托克谈一谈。‡閱讀受污染的羊皮紙，然後到試煉谷和納托克談話。',
  }
},
[3091] = {
  {
    'Bilhete‡Простая записка‡Einfache Notiz‡간결한 글쪽지‡La nota simple‡La nota simple‡Note simple‡简易便笺‡簡易便箋',
    nil,
    'Leia o Bilhete e fale com Harutt Chifre Troante, na Aldeia Narache.‡Прочтите простую записку и поговорите с Харуттом Громовым Рогом в Лагере Нараче.‡Lest die einfache Nachricht und sprecht mit Harutt Donnerhorn im Camp Narache.‡간결한 글쪽지를 읽고 나라체 야영지에 있는 하루트 썬더혼과 대화해야 합니다.‡Lee la nota simple y habla con Harutt Tronacuerno en el Campamento Narache.‡Lee la nota simple y habla con Harutt Tronacuerno en el Campamento Narache.‡Lire la Note simple, et parler à Harutt Corne-tonnerre, au Camp Narache.‡阅读简易便笺，然后与纳拉其营地的哈鲁特·雷角谈一谈。‡閱讀簡易便箋，然後與納拉其營地的哈魯特·雷角談話。',
  }
},
[3092] = {
  {
    'Bilhete cinzelado‡Нацарапанная записка‡Geätzte Notiz‡글이 새겨진 쪽지‡La nota con grabados‡La nota con grabados‡Note gravée‡风化便笺‡銘刻便箋',
    nil,
    'Leia o Bilhete Cinzelado e fale com Lanka Tiro Distante na Aldeia Narache.‡Прочтите нацарапанную записку и поговорите с Ланко Дальним Выстрелом в Лагере Нараче.‡Lest die geätzte Nachricht und sprecht mit Lanka Weitschuss in Camp Narache.‡글이 새겨진 쪽지를 읽고 나라체 야영지에 있는 랑카 파샷과 대화해야 합니다.‡Lee la nota con grabados y habla con Lanka Tirolejano en el campamento Narache.‡Lee la nota con grabados y habla con Lanka Tirolejano en el campamento Narache.‡Lire la Note gravée, et parler à Lanka Vise-loin, au Camp Narache.‡阅读风化便笺，然后与纳拉其营地的兰卡·远箭谈一谈。‡閱讀銘刻便箋，然後與紅雲臺地的蘭卡‧遠箭談話。',
  }
},
[3093] = {
  {
    'Bilhete inscrito em runas‡Руническая записка‡Mit Runen beschriftete Notiz‡룬으로 새겨진 쪽지‡La nota con runas grabadas‡La nota con runas grabadas‡Note runique‡符文便笺‡符文便箋',
    nil,
    'Leia o Bilhete Inscrito em Runas e fale com Meela Anda com a Aurora na Aldeia Narache.‡Прочтите руническую записку и поговорите с Милой Рассветной Странницей в Лагере Нараче.‡Lest die mit Runen beschriftete Nachricht und sprecht mit Meela Morgenwandler im Camp Narache.‡룬으로 새겨진 쪽지를 읽고 나라체 야영지에 있는 밀라 돈스트라이더와 대화해야 합니다.‡Lee la nota con runas y habla con Meela Caminalba en el Campamento Narache.‡Lee la nota con runas y habla con Meela Caminalba en el Campamento Narache.‡Lire la Note runique, et parler à Meela Aube-glorieuse, au Camp Narache.‡阅读符文便笺，然后与纳拉其营地的米拉-晨行者谈一谈。‡閱讀符文便箋，然後與納拉其營地的米拉·晨行者談話。',
  }
},
[3094] = {
  {
    'Bilhete verdejante‡Зеленая записка‡Tiefgrüne Notiz‡풀빛 쪽지‡La nota verdeante‡La nota verdeante‡Note verdoyante‡绿色便笺‡綠色便箋',
    nil,
    'Leia o Bilhete Verdejante e fale com Gart Corre com a Névoa, na Aldeia Narache.‡Прочтите зеленую записку и поговорите с Гартом Вестником Туманов в Лагере Нараче.‡Lest die tiefgrüne Notiz und sprecht mit Gart Nebelläufer im Camp Narache.‡풀빛 쪽지를 읽고 나라체 야영지에 있는 가트 미스트러너와 대화해야 합니다.‡Lee la nota verdeante y habla con Gart Correbruma en el Campamento Narache.‡Lee la nota verdeante y habla con Gart Correbruma en el Campamento Narache.‡Lire la Note verdoyante, et parler à Gart Cours-la-Brume, au Camp Narache.‡阅读绿色便笺，然后与纳拉其营地的加尔特·迷雾行者谈一谈。‡閱讀綠色便箋，然後與納拉其營地的加爾特·迷霧行者談話。',
  }
},
[3095] = {
  {
    'Pergaminho simples‡Простой свиток‡Einfache Rolle‡간결한 두루마리‡Un pergamino simple‡Un pergamino simple‡Parchemin simple‡简易卷轴‡簡易卷軸',
    nil,
    'Leia o Pergaminho Simples e fale com Dannal Stern em Plangemortis.‡Прочитайте простой свиток и поговорите с Данналом Штерном в Похоронном Звоне.‡Lest die einfache Schriftrolle und sprecht mit Dannal Stern in Todesend.‡간결한 두루마리를 읽고 죽음의 종소리 마을에 있는 다날 스턴과 대화해야 합니다.‡Lee el pergamino simple, luego ve a Camposanto y habla con Dannal Stern.‡Lee el pergamino simple, luego ve a Camposanto y habla con Dannal Stern.‡Lire le Parchemin simple, et parler à Dannal Stern, au Glas.‡阅读简易卷轴，然后和丧钟镇的丹纳尔·斯特恩谈一谈。‡閱讀簡易卷軸，然後和喪鐘鎮的丹納爾·斯特恩談話。',
  }
},
[3096] = {
  {
    'Pergaminho cifrado‡Зашифрованный свиток‡Verschlüsselte Rolle‡암호화된 두루마리‡Un pergamino codificado‡Un pergamino codificado‡Parchemin codé‡密文卷轴‡密文卷軸',
    nil,
    'Leia o Pergaminho Cifrado e fale com o Davi Trias em Plangemortis.‡Прочитайте зашифрованный свиток и поговорите с Давидом Триасом в Похоронном Звоне.‡Lest die verschlüsselte Schriftrolle und sprecht mit David Trias in Todesend.‡암호화된 두루마리를 읽고 죽음의 종소리 마을에 있는 데이비드 트리아스와 대화해야 합니다.‡Lee el pergamino encriptado, luego ve a Camposanto y habla con David Trias.‡Lee el pergamino encriptado, luego ve a Camposanto y habla con David Trias.‡Lire le Parchemin codé, et parler à David Trias, au Glas.‡阅读密文卷轴，然后和丧钟镇的大卫·提亚斯谈一谈。‡閱讀密文卷軸，然後和喪鐘鎮的大衛·提亞斯談話。',
  }
},
[3097] = {
  {
    'Pergaminho consagrado‡Священный свиток‡Geheiligte Rolle‡성스러운 두루마리‡Un pergamino sacralizado‡Un pergamino sacralizado‡Parchemin béni‡神圣卷轴‡神聖卷軸',
    nil,
    'Leia o Pergaminho Consagrado e fale com o Clérigo das Trevas Duesten, na igreja em Plangemortis.‡Прочитайте священный свиток и поговорите с темным священником Дьюстеном в церкви Похоронного Звона.‡Lest die geheiligte Schriftrolle und sprecht mit dem dunklen Kleriker Duesten in der Kirche von Todesend.‡성스러운 두루마리를 읽고 죽음의 종소리 마을의 예배당에 있는 어둠의 사제 듀스텐과 대화해야 합니다.‡Lee el pergamino sagrado, luego ve a la iglesia de Camposanto y habla con el clérigo oscuro Duesten.‡Lee el pergamino sagrado, luego ve a la iglesia de Camposanto y habla con el clérigo oscuro Duesten.‡Lire le Parchemin béni, et parler au sombre clerc Duesten, dans l\'église du Glas.‡阅读神圣卷轴，然后和丧钟镇教堂的黑暗牧师杜斯滕谈一谈。‡閱讀神聖卷軸，然後和喪鐘鎮教堂的黑暗教士杜斯滕談話。',
  }
},
[3098] = {
  {
    'Pergaminho glífico‡Покрытый письменами свиток‡Glyphenrolle‡상형 문자로 된 두루마리‡Un pergamino glífico‡Un pergamino glífico‡Rouleau glyphé‡雕文卷轴‡雕紋卷軸',
    nil,
    'Leia o Pergaminho Glífico e fale com Isabella na igreja em Plangemortis.‡Прочитайте свиток, покрытый письменами, и поговорите с Изабеллой в церкви Похоронного Звона.‡Lest die mit Glyphen versehene Schriftrolle und sprecht mit Isabella in der Kirche von Todesend.‡상형 문자로 된 두루마리를 읽고 죽음의 종소리 마을 예배당에 있는 이자벨라와 대화해야 합니다.‡Lee el pergamino glífico, luego ve a la iglesia de Camposanto y habla con Isabella.‡Lee el pergamino glífico, luego ve a la iglesia de Camposanto y habla con Isabella.‡Lire le Parchemin glyphé, et parler à Isabella, dans l\'église du Glas.‡阅读雕文卷轴，然后和丧钟镇教堂的伊莎贝拉谈一谈。‡閱讀雕紋卷軸，然後和喪鐘鎮教堂的伊莎貝拉談話。',
  }
},
[3099] = {
  {
    'Pergaminho conspurcado‡Грязный свиток‡Besudelte Rolle‡오래된 두루마리‡Un pergamino corrupto‡Un pergamino corrupto‡Rouleau contaminé‡被污染的卷轴‡受污染的卷軸',
    nil,
    'Leia o Pergaminho Conspurcado e fale com Maximillion em Plangemortis.‡Прочитайте свиток и поговорите с Максимиллионом в Похоронном Звоне.‡Lest die besudelte Schriftrolle und sprecht mit Maximillion in Todesend.‡오래된 두루마리를 읽고 죽음의 종소리 마을에 있는 맥시밀리언과 대화해야 합니다.‡Lee el pergamino corrupto, luego ve a Camposanto y habla con Maximillion.‡Lee el pergamino corrupto, luego ve a Camposanto y habla con Maximillion.‡Lire le Rouleau contaminé, et parler à Maximillion, au Glas.‡阅读被污染的卷轴，然后和丧钟镇的马克希米林谈一谈。‡閱讀受污染的卷軸，然後和喪鐘鎮的馬克希米林談話。',
  }
},
[3100] = {
  {
    'Carta simples‡Обычное письмо‡Einfacher Brief‡간결한 편지‡Una carta simple‡Una carta simple‡Une simple lettre‡简要的信件‡簡要的信件',
    nil,
    'Leia a Carta Simples e fale com Hipólito Valentim na Abadia de Vila Norte.‡Прочитайте обычное письмо и поговорите с Лланом Бишером в Аббатстве Североземья.‡Lest den einfachen Brief und sprecht mit Llane Beshere in der Abtei von Nordhain.‡간결한 편지를 읽고 북녘골 수도원에 있는 레인 비셰어와 대화해야 합니다.‡Lee la carta simple y habla con Llane Beshere en la Abadía de Villanorte.‡Lee la carta simple y habla con Llane Beshere en la Abadía de Villanorte.‡Lire la Lettre simple et parler à Llane Beshere, à l\'Abbaye de Comté-du-nord.‡阅读简要的信件，然后与北郡修道院的莱尼·拜舍尔谈一谈。‡閱讀簡要的信件，然後與北郡修道院的萊尼·拜舍爾談話。',
  }
},
[3101] = {
  {
    'Carta consagrada‡Благословенное письмо‡Geweihter Brief‡신성한 편지‡Una carta consagrada‡Una carta consagrada‡La lettre consacrée‡圣洁信件‡聖化信件',
    nil,
    'Leia a Carta Consagrada e fale com o Irmão Samuel na Abadia de Vila Norte.‡Прочитайте благословенное письмо и поговорите с братом Самуэлем в Аббатстве Североземья.‡Lest den geweihten Brief und sprecht mit Bruder Sammuel in der Abtei von Nordhain.‡신성한 편지를 읽고 북녘골 수도원에 있는 수사 사무엘과 대화해야 합니다.‡Lee la carta consagrada y habla con el hermano Sammuel en la Abadía de Villanorte.‡Lee la carta consagrada y habla con el hermano Sammuel en la Abadía de Villanorte.‡Lire la Lettre consacrée, et parler à Frère Sammuel, à l\'Abbaye de Comté-du-nord.‡阅读圣洁信件，然后和北郡修道院的萨缪尔修士谈一谈。‡閱讀聖化信件，然後和北郡修道院的薩繆爾修士談話。',
  }
},
[3102] = {
  {
    'Carta cifrada‡Зашифрованное письмо‡Verschlüsselter Brief‡암호화된 편지‡Una carta cifrada‡Una carta cifrada‡La lettre codée‡密文信件‡密文信件',
    nil,
    'Leia a Carta Cifrada e fale com Rufino Raposo no estábulo atrás da Abadia de Vila Norte.‡Прочитайте зашифрованное письмо и поговорите с Джориком Керриданом в стойлах за Аббатством Североземья.‡Lest den verschlüsselten Brief und sprecht mit Jorik Kerridan im Stall hinter der Abtei von Nordhain.‡암호화된 편지를 읽고 북녘골 수도원 뒤 마구간에 있는 요리크 케리던과 대화해야 합니다.‡Lee la carta cifrada y habla con Jorik Kerridan en el establo que hay tras la Abadía de Villanorte.‡Lee la carta cifrada y habla con Jorik Kerridan en el establo que hay tras la Abadía de Villanorte.‡Lire la Lettre codée, et parler à Jorik Kerridan, dans l\'écurie, derrière l\'Abbaye de Comté-du-nord.‡阅读密文信件，然后与北郡修道院的乔里克·克里丹谈一谈。‡閱讀密文信件，然後與北郡修道院後方獸欄的喬里克·克里丹談話。',
  }
},
[3103] = {
  {
    'Carta santificada‡Благословенное письмо‡Geheiligter Brief‡성스러운 편지‡Una carta sacralizada‡Una carta sacralizada‡La lettre bénie‡神圣信件‡神聖信件',
    nil,
    'Lei a Carta Santificada e fale com a Sacerdotisa Anita na Abadia de Vila Norte.‡Прочитайте благословенное письмо и поговорите с жрицей Анеттой в Аббатстве Североземья.‡Lest den geheiligten Brief und sprecht mit Priesterin Anetta in der Abtei von Nordhain.‡성스러운 편지를 읽고 북녘골 수도원에 있는 여사제 아네타와 대화해야 합니다.‡Lee la carta sacralizada y habla con la sacerdotisa Anetta en la Abadía de Villanorte.‡Lee la carta sacralizada y habla con la sacerdotisa Anetta en la Abadía de Villanorte.‡Lire la Lettre bénie, et parler à la prêtresse Anetta, à l\'abbaye de Comté-du-nord.‡阅读神圣信件，然后与北郡修道院的牧师安妮塔谈一谈。‡閱讀神聖信件，然後與北郡修道院的牧師安妮塔談話。',
  }
},
[3104] = {
  {
    'Carta glífica‡Письмо мага‡Glyphenbrief‡상형 문자로 된 편지‡Una carta glífica‡Una carta glífica‡La lettre glyphée‡雕文信件‡雕紋信件',
    nil,
    'Leia a Carta Glífica e fale com Gaspar Melchior dentro da Abadia de Vila Norte.‡Прочитайте письмо мага и поговорите с Кельденом Бременом в Аббатстве Североземья.‡Lest den mit Glyphen versehenen Brief und sprecht mit Khelden Bremen in der Abtei von Nordhain.‡상형 문자로 된 편지를 읽고 북녘골 수도원 안에 있는 켈덴 브레멘과 대화해야 합니다.‡Lee la carta glífica y habla con Khelden Bremen en la Abadía de Villanorte.‡Lee la carta glífica y habla con Khelden Bremen en la Abadía de Villanorte.‡Lire la Lettre glyphée, et parler à Khelden Bremen, à l\'intérieur de l\'Abbaye de Comté-du-nord.‡阅读雕文信件，然后与北郡修道院的凯尔东·布雷曼谈一谈。‡閱讀雕紋信件，然後與北郡修道院的凱爾東·布雷曼談話。',
  }
},
[3105] = {
  {
    'Carta maculada‡Запачканное письмо‡Besudelter Brief‡오래된 편지‡Una carta manchada‡Una carta manchada‡La lettre contaminée‡被污染的信件‡受污染的信件',
    nil,
    'Leia a Carta Maculada e fale com Drusilla La Salle perto da Abadia de Vila Norte.‡Прочитайте запачканное письмо и поговорите с Друзиллой ла Салле возле Аббатства Североземья.‡Lest den besudelten Brief und sprecht mit Drusilla La Salle nahe der Abtei von Nordhain.‡오래된 편지를 읽고 북녘골 수도원 옆에 있는 드루실라 라 살르와 대화해야 합니다.‡Lee la carta impía y habla con Drusilla La Salle junto a la Abadía de Villanorte.‡Lee la carta impía y habla con Drusilla La Salle junto a la Abadía de Villanorte.‡Lire la Lettre contaminée, et parler à Drusilla La Salle, à proximité de l\'Abbaye de Comté-du-nord.‡阅读被污染的信件，然后与北郡修道院旁边的杜希拉·拉萨雷谈一谈。‡閱讀受污染的信件，然後與北郡修道院旁邊的杜希拉·拉薩雷談話。',
  }
},
[3106] = {
  {
    'Runa simples‡Простая руна‡Einfache Rune‡간결한 룬‡Runa simple‡Runa simple‡Rune simple‡简易符文‡簡易符文',
    nil,
    'Leia a Runa Simples e fale com Thran Khorman no Vale Cristálgida.‡Изучите простую руну. Найдите в Холодной долине Трана Кормана и поговорите с ним.‡Lest die einfache Rune und sprecht mit Thran Khorman im Eisklammtal.‡간결한 룬을 읽어보고 눈마루 골짜기에 있는 스란 코르만과 대화해야 합니다.‡Lee la runa simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lee la runa simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lire la Rune simple, et parler à Thran Khorman, dans la Vallée des Frigères.‡阅读简易符文，然后与寒脊山谷的斯兰·库尔曼谈一谈。‡閱讀簡易符文，然後與寒脊山谷的斯蘭·庫爾曼談話。',
  }
},
[3107] = {
  {
    'Runa consagrada‡Священная руна‡Geweihte Rune‡신성한 룬‡Runa consagrada‡Runa consagrada‡Rune consacrée‡神圣符文‡聖化符文',
    nil,
    'Leia a Runa Consagrada e fale com Bromos Grummner em Sidermar.‡Изучите священную руну и поговорите с Бромосом Груммнером в Старой Наковальне.‡Lest die geweihte Rune und sprecht mit Bromos Grummler in Ambossar.‡신성한 룬을 읽어보고 앤빌마에서 브로모스 그럼너를 찾아 대화해야 합니다.‡Lee la runa consagrada, luego ve a Yunquemar y habla con Bromos Grummner.‡Lee la runa consagrada, luego ve a Yunquemar y habla con Bromos Grummner.‡Lire la Rune consacrée, et parler à Bromos Grummneur, à Courbenclume.‡阅读神圣符文，然后与安威玛尔的布罗莫斯·格鲁诺尔谈一谈。‡閱讀聖化符文，然後與寒脊山谷的布羅莫斯·格魯諾爾談話。',
  }
},
[3108] = {
  {
    'Runa cinzelada‡Гравированная руна‡Geätzte Rune‡글이 새겨진 룬‡Runa con grabados‡Runa con grabados‡Rune gravée‡风蚀符文‡風蝕符文',
    nil,
    'Leia a Runa Cinzelada e fale com o Thorgas Grimson em Sidermar.‡Изучите гравированную руну и поговорите с Торгасом Мрачноном в Старой Наковальне.‡Lest die geätzte Rune und sprecht mit Thorgas Grimson im Ambossar.‡글이 새겨진 룬을 읽어보고 앤빌마에 있는 토르가스 그림슨과 대화해야 합니다.‡Lee la runa con grabados, luego ve a Anvilmar y habla con Thorgas Grimson.‡Lee la runa con grabados, luego ve a Anvilmar y habla con Thorgas Grimson.‡Lire la Rune gravée et parler à Thorgas Grimson, à Courbenclume.‡阅读风蚀符文，然后与安威玛尔的索加斯·格瑞姆森谈一谈。‡閱讀風蝕符文，然後與寒脊山谷的索加斯·格瑞姆森談話。',
  }
},
[3109] = {
  {
    'Runa cifrada‡Зашифрованная руна‡Verschlüsselte Rune‡암호화된 룬‡Runa codificada‡Runa codificada‡Rune codée‡密文符文‡密文符文',
    nil,
    'Leia a Runa Cifrada e fale com Solm Hargrin em Sidermar.‡Изучите зашифрованную руну и поговорите с Сольмом Харгрином в Старой Наковальне.‡Lest die verschlüsselte Rune und sprecht mit Solm Hargrin im Ambossar.‡암호화된 룬을 읽어보고 앤빌마에 있는 솔름 하르그린과 대화해야 합니다.‡Lee la runa codificada, luego ve a Yunquemar y habla con Solm Hargrin.‡Lee la runa codificada, luego ve a Yunquemar y habla con Solm Hargrin.‡Lire la Rune codée, et parler à Solm Hargrin, à Courbenclume.‡阅读密文符文，然后与安威玛尔的索姆·哈格林谈一谈。‡閱讀密文符文，然後與寒脊山谷的索姆·哈格林談話。',
  }
},
[3110] = {
  {
    'Runa santificada‡Благословенная руна‡Geheiligte Rune‡성스러운 룬‡Runa sacralizada‡Runa sacralizada‡Rune bénie‡神圣符文‡神聖符文',
    nil,
    'Leia a Runa Santificada e fale com Branstock Khalder em Sidermar.‡Изучите благословенную руну. Найдите в Старой Наковальне Бранстока Халдера и поговорите с ним.‡Lest die geheiligte Rune und sprecht mit Branstock Khalder in Ambossar.‡성스러운 룬을 읽어보고 앤빌마에 있는 브란스토크 칼더와 대화해야 합니다.‡Lee la runa sacralizada, luego ve a Yunquemar y habla con Silo Khalder.‡Lee la runa sacralizada, luego ve a Yunquemar y habla con Silo Khalder.‡Lire la Rune bénie, et parler à Branstock Khalder, à Courbenclume.‡阅读神圣符文，然后与安威玛尔的布兰斯托·卡尔德谈一谈。‡閱讀神聖符文，然後與安威瑪的布蘭斯托·卡爾德談話。',
  }
},
[3111] = {
  {
    '‡<UNUSED> [DEPRECATED]‡<UNUSED> [DEPRECATED]‡<UNUSED> [DEPRECATED]‡<UNUSED> [DEPRECATED]‡‡‡<UNUSED> [DEPRECATED]‡',
    nil,
    '‡Поговорите с Марреком Стромнуром в Старой Наковальне.‡Sprecht mit Marek Stromnur in Ambossar.‡앤빌마에 있는 마렉 스트롬너와 대화해야 합니다.‡Habla con Marrek Stromnur en Yunquemar.‡‡‡与安威玛尔的玛瑞克·斯托纳尔交谈。‡',
  }
},
[3112] = {
  {
    '‡Записка‡Einfaches Memorandum‡간결한 쪽지‡Memorándum simple‡Memorándum simple‡Note de service simple‡简易备忘录‡簡易備忘錄',
    nil,
    '‡Прочитайте записку и поговорите с Траном Корманом в Холодной долине.‡Lest das einfache Memorandum und sprecht mit Thran Khorman im Eisklammtal.‡‡Lee el memorándum simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lee el memorándum simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lire la Note de service simple, et parler à Thran Khorman, dans la Vallée des Frigères.‡阅读简易备忘录，然后与寒脊山谷的斯兰·库尔曼谈一谈。‡',
  }
},
[3113] = {
  {
    '‡Зашифрованная записка‡Verschlüsseltes Memorandum‡암호화된 쪽지‡Memorándum encriptado‡Memorándum encriptado‡Note de service codée‡密文备忘录‡密文備忘錄',
    nil,
    '‡Прочтите зашифрованную записку. Найдите Сольма Харгрина в Холодной долине и поговорите с ним.‡Lest das verschlüsselte Memorandum und sprecht mit Solm Hargrin im Eisklammtal.‡‡Lee el memorándum encriptado, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lee el memorándum encriptado, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lire la Note de service codée, et parler à Solm Hargrin, dans la Vallée des Frigères.‡阅读密文备忘录，然后与寒脊山谷的索姆·哈格林谈一谈。‡',
  }
},
[3114] = {
  {
    '‡Таинственная записка‡Glyphenmemorandum‡상형 문자로 된 쪽지‡Memorándum glífico‡Memorándum glífico‡Note de service glyphée‡雕文备忘录‡雕紋備忘錄',
    nil,
    '‡Прочитайте таинственную записку. Найдите в Холодной долине Маррайка Нуррибита и поговорите с ним.‡Lest das mit Glyphen versehene Memorandum und sprecht mit Marryk Nurribit in Ambossar oberhalb des Eisklammtals.‡상형 문자로 된 쪽지를 읽어보고 눈마루 골짜기 위 앤빌마에 있는 마릭 너리빗과 대화해야 합니다.‡Lee el memorándum glífico, luego ve a hablar con Marryk Nurribit, dentro de Yunquemar, sobre el Valle de Crestanevada.‡Lee el memorándum glífico, luego ve a hablar con Marryk Nurribit, dentro de Yunquemar, sobre el Valle de Crestanevada.‡Lire la Note de service glyphée, et parler à Marryk Nurribit, dans Courbenclume, au-dessus de la Vallée des Frigères.‡阅读雕文备忘录，然后与寒脊山谷上的安威玛尔镇里的玛瑞克·斯托纳尔谈一谈。‡',
  }
},
[3115] = {
  {
    'Runa Conspurcada‡Оскверненная руна‡Besudelte Rune‡오염된 룬‡Runa corrupta‡Runa corrupta‡Rune contaminée‡被玷污的符文‡受污染的符文',
    nil,
    'Leia a Runa Conspurcada e fale com Sarala Maltagris dentro de Sidermar, acima do Vale Cristálgida.‡Прочитайте оскверненную руну и поговорите с Сарипал Дымоварь в Старой Наковальне над Холодной долиной.‡Lest die besudelte Rune und sprecht mit Saripal Schmauchbräu in Ambossar oberhalb des Eisklammtals.‡오염된 룬을 읽고 눈마루 골짜기 위의 앤빌마에 있는 사리팔 스몰더브루와 대화해야 합니다.‡‡Lee la runa corrupta, luego ve a hablar con Saripal Cervezardiente que está en Yunquemar, sobre el Valle de Crestanevada.‡Lisez la Rune contaminée et parlez à Saripal Couvebrassin, à Courbenclume, au-dessus de la Vallée des Frigères.‡阅读被玷污的符文，然后跟寒脊山谷上的安威玛尔镇里的莎莉帕·石酒谈一谈。‡閱讀受污染的符文，然後去寒脊山谷上的安威瑪鎮和薩利帕爾·燃酒談話。',
  }
},
[3116] = {
  {
    'O selo simples‡Простой знак‡Einfaches Siegelzeichen‡간결한 도장‡El sigilo simple‡El sigilo simple‡Le cachet simple‡简易符记‡簡易符記',
    nil,
    'Fale com Alyissia no interior de Aldrassil, que fica em Umbravale.‡Поговорите с Алайссией в Альдрассиле, что в Тенистой долине.‡Sprecht mit Alyissia in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 알리시아와 대화해야 합니다.‡Habla con Alyissia dentro de Aldrassil, en Cañada Umbría.‡Habla con Alyissia dentro de Aldrassil, en Cañada Umbría.‡Allez voir Alyissia, à l\'intérieur d\'Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的奥莉希亚谈一谈。‡在幽影谷中和奧莉希亞談話。',
  }
},
[3117] = {
  {
    'O selo cinzelado‡Выгравированный знак‡Geätztes Siegelzeichen‡글이 새겨진 도장‡El sigilo con grabados‡El sigilo con grabados‡Le cachet gravé‡风化符记‡風化符記',
    nil,
    'Fale com Ayanna Perenanda no interior de Aldrassil, que fica em Umbravale.‡Поговорите с Аянной Вечной Странницей в Альдрассиле, что в Тенистой долине.‡Sprecht mit Ayanna Immerlauf in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 아얀나 에버스트라이드와 대화해야 합니다.‡Habla con Ayanna Semprerguida dentro de Aldrassil, en Cañada Umbría.‡Habla con Ayanna Semprerguida dentro de Aldrassil, en Cañada Umbría.‡Allez voir Ayanna Vassanfin, à l\'intérieur d\'Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的阿亚娜·远途谈一谈。‡在幽影谷中和阿亞娜‧遠途談話。',
  }
},
[3118] = {
  {
    'O selo cifrado‡Зашифрованный знак‡Verschlüsseltes Siegelzeichen‡암호화된 도장‡El sigilo cifrado‡El sigilo cifrado‡Le cachet codé‡密文符记‡密文符記',
    nil,
    'Fale com Frahun Umbrurmúrio no interior de Aldrassil, que fica em Umbravale.‡Поговорите с Фрагуном Шепотом Тени в Альдрассиле, что в Тенистой долине.‡Sprecht mit Frahun Schattenflüsterer in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 프라훈 셰이드위스퍼와 대화해야 합니다.‡Habla con Frahun Sombrusurro dentro de Aldrassil, en Cañada Umbría.‡Habla con Frahun Sombrusurro dentro de Aldrassil, en Cañada Umbría.‡Lisiez le Cachet codé et allez parler à Frahun Murmombre, à l\'intérieur d\'Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的弗拉胡恩·影语者谈一谈。‡在幽影谷中和弗拉胡恩‧影語談話。',
  }
},
[3119] = {
  {
    'O selo sagrado‡Благословенный знак‡Geheiligtes Siegelzeichen‡성스러운 도장‡Sigilo sacralizado‡Sigilo sacralizado‡Le cachet béni‡神圣符记‡神聖符記',
    nil,
    'Fale com Shanda no interior Aldrassil, que fica em Umbravale.‡Поговорите с Шандой в Альдрассиле, что в Тенистой долине.‡Sprecht mit Shanda in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 샨다와 대화해야 합니다.‡Habla con Shanda dentro de Aldrassil, en Cañada Umbría.‡Habla con Shanda dentro de Aldrassil, en Cañada Umbría.‡Allez voir Shanda, à l\'intérieur d\'Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的珊达谈一谈。‡在幽影谷中和珊達談話。',
  }
},
[3120] = {
  {
    'O selo verdejante‡Зеленый знак‡Tiefgrünes Siegelzeichen‡풀빛 도장‡El sigilo verdeante‡El sigilo verdeante‡Le cachet verdoyant‡绿色符记‡綠色符記',
    nil,
    'Fale com Mardant Carvalhaço no interior de Aldrassil, em Umbravale.‡Поговорите с Мардантом Крепким Дубом на древе Альдрассил, что в Тенистой долине.‡Sprecht mit Mardant Starkeiche in Aldrassil im Laubschattental.‡그늘 협곡의 알드랏실 안에 있는 마르단트 스트롱오크와 대화해야 합니다.‡Habla con Mardant Fuerterroble dentro de Aldrassil, en Cañada Umbría.‡Habla con Mardant Fuerterroble dentro de Aldrassil, en Cañada Umbría.‡Lisez le Cachet verdoyant et allez parler à Mardant Chênefort, à l\'intérieur d\' Aldrassil, au Sombrevallon.‡与幽影谷中奥达希尔里面的玛丹特·硬木谈一谈。‡在幽影谷中和瑪丹特‧硬木談話。',
  }
},
[3121] = {
  {
    'Um pedido estranho‡Странная просьба‡Eine seltsame Bitte‡이상한 부탁‡Una extraña petición‡Una extraña petición‡Une Requête étrange‡奇怪的要求‡奇怪的要求',
    nil,
    'Take the Shrunken Head to Xerash Fireblade at the Lariss Pavilion in Feralas.‡Отнесите сушеную голову Ксерашу Огненному Клинку в павильон Лорисс в Фераласе.‡Bringt den Schrumpfkopf zu Xerash Feuerklinge beim Larisspavillon.‡페랄라스의 라리스 정자에 있는 제라쉬 파이어블레이드에게 구겨진 가면을 가져가야 합니다.‡Lleva la cabeza reducida a Xerash Hojafuego al Pabellón de Lariss en Feralas.‡Lleva la cabeza reducida a Xerash Hojafuego al Pabellón de Lariss en Feralas.‡Porter la Tête réduite à Xerash Lamefeu, au Pavillon de Lariss, en Féralas.‡将皱缩的徽记交给拉瑞斯小亭的夏拉什·火刃。‡將皺縮頭顱交給菲拉斯拉瑞斯小亭的瑟拉希·火刃。',
  }
},
[3122] = {
  {
    '‡Возвращение к знахарю Узер\'и‡Kehrt zu Hexendoktor Uzer\'i zurück‡‡Regresa junto al médico brujo Uzer\'i‡Regresa junto al médico brujo Uzer\'i‡Retourner voir le féticheur Uzer\'i‡向巫医尤克里回复‡',
    nil,
    '‡Отнесите знахарю Узер\'и в Фералас мешочек для трав Ксераша.‡Bringt Xerashs Kräuterbeutel zu Hexendoktor Uzer\'i in Feralas.‡‡Entrega la faltriquera de hierbas de Xerash al médico brujo Uzer\'i en Feralas.‡Entrega la faltriquera de hierbas de Xerash al médico brujo Uzer\'i en Feralas.‡Livrer une Poche d\'herbes de Xerash au Féticheur Uzer\'i, en Féralas.‡将尼尔鲁的草药包送给菲拉斯的巫医尤克里。‡',
  }
},
[3123] = {
  {
    'O teste do recipiente‡Испытание сосуда‡Das Gefäß wird getestet‡단지 실험‡Probar la vasija‡Probar la vasija‡Test du récipient‡测试容器‡測試容器',
    nil,
    'Kill 10 Ironfur Bears or Longtooth Runners, and use the Beast Muisek Vessel to shrink and capture the fallen beasts.|n|nBring 10 Beast Muiseks and the Beast Muisek Vessel to Witch Doctor Uzer\'i in Feralas.‡Убейте 10 медведей-сталемехов или длиннозубов-охотников, и используйте сосуд уменьшения, чтобы уменьшить и пленить их.|n|nОтнесите 10 уменьшенных зверей знахарю Узер\'и в Фералас.‡Tötet 10 Eisenfellbären oder Langzahnläufer und benutzt dann das Gefäß für Bestienmuisek, um die gefallenen Tiere zu schrumpfen und einzufangen.|n|nBringt anschließend 10 Einheiten Bestienmuisek und das Gefäß für Bestienmuisek zu Hexendoktor Uzer\'i in Feralas.‡무쇠가죽곰이나 긴다리 송곳니늑대 10마리를 처치하고 뮤세크 단지를 사용해 죽은 야수들을 갈무리해서 담아와야 합니다.|n|n페랄라스에 있는 의술사 우제리에게 야수 뮤세크 10개와 야수 뮤세크 단지를 가져가야 합니다.‡Mata a 10 osos Cueracero o corredores Dientelargo y usa la vasija de muisek de bestia para reducir y capturar a las bestias caídas.|n|nLleva 10 muestras de muisek de bestia y la vasija de muisek de bestia al médico brujo Uzer\'i en Feralas.‡Mata a 10 osos Cueracero o corredores Dientelargo y usa la vasija de muisek de bestia para reducir y capturar a las bestias caídas.|n|nLleva 10 muestras de muisek de bestia y la vasija de muisek de bestia al médico brujo Uzer\'i en Feralas.‡Tuez 10 Ours Ferpoil ou Coureurs Longues-dents, puis utilisez le Récipient à muisek de bête pour faire rétrécir et capturer les bêtes vaincues.|n|nRamenez 10 Muiseks de bêtes et le Récipient à muisek de bête au Féticheur Uzer\'i, en Féralas.‡去杀掉10头铁鬃熊或是长牙奔跑者，然后使用灵魂精华容器捕获它们的灵魂。|n|n将灵魂精华容器和10个野兽灵魂精华交给菲拉斯的巫医尤克里。‡殺掉10頭鐵鬃熊或長牙奔跑者，然後使用野獸靈魂精華容器濃縮並禁錮那些倒下野獸的靈魂。|n|n將10個野獸靈魂精華和野獸靈魂精華容器交給菲拉斯的巫醫尤克里。',
  }
},
[3124] = {
  {
    'Muisec de hipogrifo‡Уменьшенный гиппогриф‡Muisek von Hippogryphen‡히포그리프 뮤세크‡Muisek de hipogrifo‡Muisek de hipogrifo‡Muisek d\'hippogriffe‡角鹰兽灵魂精华‡角鷹獸靈魂精華',
    nil,
    'Mate 10 Hipogrifos Esfiapluma de qualquer tipo e use o Recipiente de Muisec para encolhê-los e capturá-los.‡Убейте 10 блеклоперых гиппогрифов любого вида, затем используйте сосуд уменьшения, чтобы уменьшить и пленить их.‡Schaltet 10 Fransenfederhippogryphen eines beliebigen Typs aus und benutzt dann das Muisekgefäß, um sie zu schrumpfen und einzufangen.‡종에 상관없이 공작날개 히포그리프 10마리를 처치한 다음 뮤세크 단지를 사용해 갈무리해서 담아와야 합니다.‡ACaba con 10 hipogrifos Plumavieja de cualquier tipo y utiliza la vasija de muisek para encogerlos y capturarlos.‡Acaba con 10 hipogrifos Plumavieja de cualquier tipo y utiliza la vasija de muisek para encogerlos y capturarlos.‡Tuer 10 Hippogriffes Aigreplume de n\'importe quel type, puis utiliser le Récipient à muisek pour les faire rétrécir et les capturer.‡杀掉10只任意种类的乱羽角鹰兽，然后用灵魂精华容器捕获它们的灵魂。‡殺掉任何種類的10隻亂羽角鷹獸，然後用靈魂精華容器縮小並捕獲它們。',
  }
},
[3125] = {
  {
    'Muisec de Dragoleta‡Уменьшенный чудесный дракончик‡Muisek von Feendrachen‡요정용 뮤세크‡Muisek de dragón feérico‡Muisek de dragón feérico‡Muisek de dragon féerique‡精灵龙灵魂精华‡精靈龍靈魂精華',
    nil,
    'Mate 8 Dardejantes ou Dragões-íris. Use o Recipiente de Muisec para encolher e capturar as Dragoletas abatidas.‡Убейте 8 летучих хамелеонов или радужных дракончиков. Используйте сосуд уменьшения, чтобы заключить в них духи павших чудесных дракончиков.‡Schaltet 8 Grimmlingflitzer oder Grimmlingdrachen aus. Benutzt das Muisekgefäß, um die gefallenen Feendrachen zu schrumpfen und einzufangen.‡화살요정용이나 요정용 8마리를 처치하여 뮤세크 단지를 사용해 죽은 요정용을 갈무리해서 담아와야 합니다.‡Mata a 8 duendes dardo o duendes dragón. Utiliza la vasija de muisek para reducir y capturar a los dragones feéricos caídos.‡Mata a 8 duendes dardo o duendes dragón. Utiliza la vasija de muisek para reducir y capturar a los dragones feéricos caídos.‡Tuez 8 Fées fléchetteuses ou Petits dragons féeriques. Utiliser le Récipient à muisek pour rétrécir et capturer les dragons féeriques vaincus.‡杀掉8只精龙或小精龙，然后用灵魂精华容器捕获它们的灵魂。‡殺掉8隻精龍或小精龍，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3126] = {
  {
    '‡Уменьшенный древень‡Treantmuisek‡나무정령 뮤세크‡Muisek de antárbol‡Muisek de antárbol‡Muisek de tréant‡树人灵魂精华‡樹人靈魂精華',
    nil,
    '‡Убейте 3 бродячих лесных древней. Используйте сосуд уменьшения, чтобы уменьшить и пленить павших древней.‡Schaltet 3 umherwandernde Waldgänger aus. Benutzt das Muisekgefäß, um die gefallenen Treants zu schrumpfen und einzufangen.‡떠도는 나무정령 3마리를 처치하고 뮤세크 단지를 이용하여 그들을 갈무리해야 합니다.‡Mata a 3 caminabosques deambulantes. Utiliza la vasija de muisek de antárbol para reducir y capturar a los antárboles caídos.‡Mata a 3 caminabosques deambulantes. Utiliza la vasija de muisek de antárbol para reducir y capturar a los antárboles caídos.‡Tuez 3 Marcheurs des bois errants. Utilisez le Récipient à muisek pour miniaturiser et capturer les tréants vaincus.‡杀掉3个森林漫游者，然后用灵魂精华容器捕获它们的灵魂。‡',
  }
},
[3127] = {
  {
    'Muisec de Gigante da Montanha‡Уменьшенный горный великан‡Bergriesenmuisek‡산악거인 뮤세크‡Muisek de gigante montés‡Muisek de gigante montés‡Muisek de géant des montagnes‡山岭巨人灵魂精华‡山嶺巨人靈魂精華',
    nil,
    'Mate 7 Terrâmbulos ou Gigantes do Penhasco. Use o Recipiente de Muisec para encolher e capturar os Gigantes da Montanha abatidos.‡Убейте 7 сухопутных бродяг или скальных великанов. Используйте сосуд уменьшения, чтобы уменьшить и пленить павших скальных великанов.‡Schaltet 7 Landgänger oder Klippenriesen aus. Benutzt das Muisekgefäß, um die gefallenen Bergriesen zu schrumpfen und einzufangen.‡평지거인이나 절벽거인 7마리를 처치하여 뮤세크 단지를 이용해 죽은 산악거인을 갈무리해서 담아와야 합니다.‡Mata a 7 caminantes de la tierra o gigantes del risco. Utiliza la vasija de muisek para reducir y capturar a los gigantes monteses caídos.‡Mata a 7 caminantes de la tierra o gigantes del risco. Utiliza la vasija de muisek para reducir y capturar a los gigantes monteses caídos.‡Tuer 7 Marcheurs des terres ou Géants des falaises. Utiliser le Récipient à muisek pour faire rétrécir et pour capturer les Géants des montagnes.‡杀掉7个大地行者或者峭壁巨人，然后用灵魂精华容器捕获它们的灵魂。‡殺掉7個大地行者或者峭壁巨人，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3128] = {
  {
    'Caçadores de matérias-primas perdidas‡Натуральные ингредиенты‡Natürliche Materialien‡천연 재료‡Materiales naturales‡Materiales naturales‡Matériaux naturels‡天然材料‡天然材料',
    nil,
    'Leve 2 Pedaços de Lenha, 6 Minerais Incrustados, 20 pedaços de Tendão Resiliente e 40 Fragmentos Metálicos para Mandingueiro Uzer\'i na Aldeia Mojache.‡Принесите 2 расколотых бревна, 6 минералов, покрытых коркой, 20 кусков упругих сухожилий и 40 металлических фрагментов знахарю Узер\'и в Лагерь Мохаче.‡Bringt 2 abgesplitterte Baumstämme, 6 verkrustete Mineralien, 20 Stücke widerstandsfähige Sehne und 40 metallische Fragmente zu Hexendoktor Uzer\'i ins Camp Mojache.‡모자케 야영지에 있는 의술사 우제리에게 쪼개진 통나무 2개, 보석 박힌 광석 6개, 질긴 힘줄 20개, 금속 파편 40개를 가져가야 합니다.‡Lleva 2 troncos astillados, 6 minerales taraceados, 20 tendones resistentes y 40 trozos metálicos al médico brujo Uzer\'i al Campamento Mojache.‡Lleva 2 troncos astillados, 6 minerales taraceados, 20 tendones resistentes y 40 trozos metálicos al médico brujo Uzer\'i al Campamento Mojache.‡Apporter 2 Bûches fendues, 6 Minerais incrustés, 20 Morceaux de tendons résistants et 40 Fragments métalliques au Féticheur Uzer\'i au Camp Mojache.‡为莫沙彻营地的巫医尤克里收集2根断裂的原木、6颗包壳矿石、20片有弹性的肌腱和40块金属碎片。‡為莫沙徹營地的巫醫尤克里收集2根斷裂的原木、6顆包殼礦石、20片有彈性的肌腱和40塊金屬碎片。',
  }
},
[3129] = {
  {
    '‡Оружие духа‡Waffen des Geistes‡영혼의 무기‡Armas del espíritu‡Armas del espíritu‡Armes de l\'Esprit‡灵魂武器‡',
    nil,
    '‡Подождите, пока знахарь Узер\'и готовит оружие.‡Hexendoktor Uzer\'i will, dass Ihr einen Moment wartet, während er die Waffen vorbereitet.‡의술사 우제리가 무기를 만들 동안 잠시 기다려달라고 했습니다.‡El médico brujo Uzer\'i quiere que esperes mientras prepara las armas.‡El médico brujo Uzer\'i quiere que esperes mientras prepara las armas.‡Le Féticheur Uzer\'i veut que vous patientez pendant qu\'il prépare les armes.‡巫医尤克里希望你在他准备武器的时候稍等一会儿。‡',
  }
},
[3130] = {
  {
    '‡Борьба с Гребнем Ненависти‡Gegen die Hasskämme‡‡En contra de los Crestafuria‡En contra de los Crestafuria‡Contre les Hainecrêtes‡憎世纳迦之战‡',
    nil,
    '‡Явитесь к Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Meldet Euch bei Latronicus Mondspeer in der Mondfederfeste.‡‡Preséntate ante Latronicus Lanzaluna, en el Bastión Plumaluna.‡Preséntate ante Latronicus Lanzaluna, en el Bastión Plumaluna.‡Se présenter devant Latronicus Lancelune au bastion de Pennelune.‡到羽月要塞的拉托尼库斯·月矛那里去报到。‡',
  }
},
[3141] = {
  {
    '‡Лорамус‡‡‡‡‡‡洛拉姆斯‡',
    nil,
    '‡Послушайте, как Лорамус Многоног рассказывает свою историю.‡Lasst Loramus Thalipedes seine Geschichte erzählen.‡‡Escucha la historia de Loramus Thalimedes.‡Escucha la historia de Loramus Thalimedes.‡Écoutez l\'histoire de Loramus Thalipedes.‡听洛拉姆斯·萨里比迪斯讲述他的故事。‡',
  }
},
[3161] = {
  {
    'Gahz\'ridian‡Газ\'рилльское украшение‡Gahz\'ridian‡가즈리디안‡Gahz\'rilo‡Gahz\'rilo‡La gahz\'ridienne‡加兹瑞迪安‡加茲瑞迪安',
    nil,
    'Marlon Catarrebite, em Tanaris, quer que você colete 30 Ornamentos de Gahz\'ridian.‡Марвон Клепальщик из Танариса поручил собрать 30 газ\'рилловых украшений.‡Marvon Nietensucher in Tanaris möchte, dass Ihr 30 Ornamente von Gahz\'ridian sammelt.‡타나리스에 있는 마본 리벳시커가 가즈리디안 장신구 30개를 모아 달라고 했습니다.‡Marvon Buscarroblones de Tanaris quiere que reúnas 30 adornos de gahz\'rilo.‡Marvon Buscarroblones de Tanaris quiere que reúnas 30 adornos de gahz\'rilo.‡Marvon Chercherivet, à Tanaris, vous a demandé de ramasser 30 Ornements en gahz\'ridienne.‡塔纳利斯的玛尔冯·瑞文斯克要你收集30件加兹瑞迪安饰物。‡塔納利斯的瑪爾馮·瑞文斯克要你收集30件加茲瑞迪安飾物。',
  }
},
[3181] = {
  {
    'O chifre da fera‡Рог чудовища‡Das Horn der Bestie‡야수의 뿔‡El cuerno de la bestia‡El cuerno de la bestia‡La corne de la bête‡玛尔戈的巨角‡巨獸瑪爾戈的角',
    nil,
    'Leve o Chifre Gigante de Margol para a Montanhista Pedrabrita.|n‡Отнести гигантский рог Маргульи горному пехотинцу Щебеночке.‡Bringt Margols gigantisches Horn zu Gebirgsjägerin Feinkiesel.‡산악경비대 페블비티에게 마르골의 거대한 뿔을 가져가야 합니다.‡Lleva el cuerno enorme de Margol a la montaraz Guijarro.|n‡Lleva el cuerno enorme de Margol a la montaraz Guijarro.|n‡Porter la Corne Gigantesque de Margol à la Montagnarde Minigravillon.‡将玛尔戈的巨角交给巡山人贝波蒂。‡將瑪爾戈的巨角交給巡山人貝波蒂。',
  }
},
[3182] = {
  {
    '‡Доказательство содеянного‡Besitznachweis‡무훈의 증서‡Certificado de autenticidad‡Certificado de autenticidad‡Titre de propriété‡证明信‡索里奧斯的證明信',
    nil,
    '‡Отнесите гигантский рог Маргульи смотрителю Ториусу в Стальгорн.‡Bringt Margols gigantisches Horn zu Kurator Thorius in Eisenschmiede.‡‡Lleva el cuerno enorme de Margol al comisario Torio a Forjaz.‡Lleva el cuerno enorme de Margol al comisario Torio a Forjaz.‡Porter la Corne gigantesque de Margol au conservateur en chef Thorius à Forgefer.‡把玛尔戈的巨角交给铁炉堡的索里奥斯馆长。‡',
  }
},
[3201] = {
  {
    'Finalmente!‡Наконец-то!‡Endlich!‡이글거리는 협곡의 열쇠‡¡Al fin!‡¡Al fin!‡Enfin !‡馆长的证明！‡終於!',
    nil,
    'Leve o Certificado de Realização para a Montanhista Pedrabrita.‡Отнесите доказательство содеянного горному пехотинцу Щебеночке.‡Bringt die Beweisurkunde zurück zu Gebirgsjägerin Feinkiesel.‡산악경비대 페블비티에게 무훈의 증서를 가져가야 합니다.‡Lleva el certificado de autenticidad a la montaraz Guijarro.‡Lleva el certificado de autenticidad a la montaraz Guijarro.‡Apporter le document de preuve à la Montagnarde Minigravillon.‡把索里奥斯的证明信交给巡山人贝波蒂。‡把索里奧斯的證明信交給巡山人貝波蒂。',
  }
},
[3221] = {
  {
    'Fale com Renferrel‡Беседа с Ренферрелом‡Sprecht mit Renferrel‡렌퍼럴과 대화‡Habla con Renferrel‡Habla con Renferrel‡Parler à Renferrel‡与伦弗利尔会面‡與倫法洛會面',
    nil,
    'Fale com o Boticário Renferrel no Sepulcro.‡Поговорите с аптекарем Ренферрелом в Гробнице.‡Sprecht mit Apotheker Renferrel in dem Grabmal.‡공동묘지에 있는 연금술사 렌퍼럴과 대화해야 합니다.‡Habla con el boticario Renferrel en El Sepulcro.‡Habla con el boticario Renferrel en El Sepulcro.‡Parler à l\'apothicaire Renferrel au Sépulcre.‡与瑟伯切尔的药剂师伦弗利尔谈一谈。‡與瑟伯切爾的藥劑師倫法洛談話。',
  }
},
[3241] = {
  {
    '<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak‡<NYI> <TXT><redux> Dreadmist Peak',
    nil,
    'Traga-os para Tonga Runa Totem.‡Принесите тотемы Тонге Руническому Тотему.‡Bringt sie zu Tonga Runentotem.‡통가 룬토템에게 물건을 가져가야 합니다.‡Llévaselos a Tonga Tótem de Runa.‡Llévaselos a Tonga Tótem de Runa.‡Apportez-les à Tonga Totem-runique.‡把他们带给图加·符文图腾。‡把他們帶給圖加·符文圖騰。',
  }
},
[3261] = {
  {
    '[DEPRECATED in 4.x] Jorn Skyseer‡[DEPRECATED in 4.x] Джорн Заклинатель Небес‡Jorn Himmelsdeuter‡[4.x 미사용]조른 스카이시어‡[DEPRECATED in 4.x] Jorn Vidente del Cielo‡[DEPRECATED in 4.x] Jorn Vidente del Cielo‡[PÉRIMÉ 4].xJorn Œil-des-cieux‡[DEPRECATED in 4.x] 乔恩·星眼‡[DEPRECATED in 4.x] 喬恩·星眼',
    nil,
    'Fale com Jorn Vidente do Céu no Acampamento Taurajo.‡Поговорите с Джорном Заклинателем Небес в Лагере Таурахо.‡Sprecht im Camp Taurajo mit Jorn Himmelsdeuter.‡타우라조 야영지에 있는 조른 스카이시어와 대화해야 합니다.‡Habla con Jorn Vidente del Cielo en el Campamento Taurajo.‡Habla con Jorn Vidente del Cielo en el Campamento Taurajo.‡Parler à Jorn Oeil-des-cieux, au Camp Taurajo.‡与陶拉祖营地的乔恩·星眼谈一谈。‡與陶拉祖營地的喬恩·星眼談話。',
  }
},
[3281] = {
  {
    '[DEPRECATED] Stolen Silver‡[DEPRECATED] Похищенное серебро‡Gestohlenes Silber‡[미사용]도둑맞은 은화‡[DEPRECATED] La plata robada‡[DEPRECATED] La plata robada‡[PÉRIMÉ]Argent volé‡[DEPRECATED] 被偷走的银币‡[DEPRECATED] Stolen Silver',
    nil,
    'Leve a Prata Roubada para Gazrog na Encruzilhada.‡Принесите украденное серебро Газрогу в Перекресток.‡Bringt das gestohlene Silber zu Gazrog beim Wegekreuz.‡십자로에 있는 가즈록에게 도둑맞은 은화를 가져가야 합니다.‡Llévale la plata robada a Gazrog en El Cruce.‡Llévale la plata robada a Gazrog en El Cruce.‡Rapportez l\'Argent volé à Gazrog à la Croisée.‡把被偷走的银币交给十字路口的加兹罗格。‡把被偷走的銀幣交給十字路口的加茲羅格。',
  }
},
[3301] = {
  {
    'Mura Runa Totem‡Муура Рунический Тотем‡Mura Runentotem‡무라 룬토템‡Mura Tótem de Runa‡Mura Tótem de Runa‡Mura Totem-runique‡茉拉·符文图腾‡茉拉‧符文圖騰',
    nil,
    'Speak with Mura Runetotem at the Sepulcher in Silverpine Forest.‡Поговорите с Муурой Руническим Тотемом в Гробнице, что в Серебряном бору.‡Sprecht mit Mura Runentotem im Grabmal im Silberwald.‡은빛소나무 숲의 공동묘지에 있는 무라 룬토템과 대화해야 합니다.‡Habla con Mura Tótem de Runa en El Sepulcro, en el Bosque de Argénteos.‡Habla con Mura Tótem de Runa en El Sepulcro, en el Bosque de Argénteos.‡Allez voir Mura Totem-runique au Sépulcre, dans la Forêt des Pins-Argentés.‡和银松森林瑟伯切尔的茉拉·符文图腾谈一谈。‡到銀松森林的瑟伯切爾找茉拉‧符文圖騰談話。',
  }
},
[3321] = {
  {
    '‡Не ее ли ищете?‡Habt Ihr das verloren?‡‡¿Has perdido esto?‡¿Has perdido esto?‡Est-ce que ceci est à vous ?‡秘银会的认可‡',
    nil,
    '‡Дождитесь, пока Трентон закончит работу.‡Wartet, bis Trenton seine Arbeit erledigt hat.‡‡Espera a que Trenton acabe su trabajo.‡Espera a que Trenton acabe su trabajo.‡Attendre que Trenton ait terminé son travail.‡等待特伦顿完成他的工作。‡',
  }
},
[3341] = {
  {
    'Arauto do fim‡Да сгинет Хладовей‡Das Ende bringen‡암네나르 처치‡Acaba con la amenaza‡Acaba con la amenaza‡L\'anéantissement‡寒冰之王‡寒冰之王',
    nil,
    'André Rosado quer que você mate Amnennar, o Frigífero, e volte com a cabeça dele.‡Эндрю Браунелл поручил вам убить Амненнара Хладовея и принести его череп.‡Andrew Braunell will, dass Ihr Amnennar den Kältebringer tötet und ihm dessen Schädel bringt.‡앤드류 브로넬이 혹한의 암네나르를 처치하고 혹한의 해골을 가져다 달라고 했습니다.‡Andrew Brownell quiere que mates a Amnennar el Gélido y que le lleves su cráneo.‡Andrew Brownell quiere que mates a Amnennar el Gélido y que le lleves su cráneo.‡Andrew Brownell veut que vous tuiez Amnennar le Porte-froid et que vous lui rameniez son crâne.‡安德鲁·布隆奈尔要你杀了寒冰之王亚门纳尔并将其头骨带回来。‡安德魯·布隆奈爾要你殺了『寒冰使者』亞門納爾並將其頭骨帶回來。',
  }
},
[3361] = {
  {
    'Um dia na vida de um refugiado‡Беда беженца‡Dilemma eines Flüchtlings‡망명자의 곤경‡Las penurias de un refugiado‡Las penurias de un refugiado‡Les malheurs d\'un réfugié‡逃难者的困境‡逃難者的困境',
    nil,
    'Recupere a Caixa do Félix, o Baú do Félix e o Balde de Parafusos do Félix.‡Найдите ящик, сундук и ведро с гайками, принадлежащие Феликсу.‡Beschafft Euch Felix\' Kasten, Felix\' Truhe und Felix\' Bolzeneimer.‡잃어버린 펠릭스의 상자, 펠릭스의 궤짝, 펠릭스의 나사통을 획득해야 합니다.‡Consigue la caja de Félix, el cofre de Félix y el cubo de tornillos de Félix.‡Consigue la caja de Félix, el cofre de Félix y el cubo de tornillos de Félix.‡Récupérer la Boîte de Felix, le Coffre de Felix et le Seau de boulons de Felix.‡取得菲利克斯的盒子、菲利克斯的箱子和菲利克斯的螺钉桶。‡取回菲利克斯的盒子、菲利克斯的箱子和菲利克斯的螺釘桶。',
  }
},
[3362] = {
  {
    'Vale Moitagulhas‡Долина Кактусов‡Disteltal‡덤불나무 골짜기‡El Valle Cardizal‡El Valle Cardizal‡La vallée des Chardonniers‡灌木谷‡灌木谷',
    nil,
    'Tran\'rek, em Geringontzan, quer que você mate 8 Moitagulhas Rotos e 8 Fazraízes Moitagulhas.‡Тран\'рек из Прибамбасска просит вас убить 8 бугристых шипошкуров и 8 корнеплетов из долины Кактусов.‡Tran\'rek in Gadgetzan möchte, dass Ihr 8 knorrige Distelwandler und 8 Distelwurzelformer erledigt.‡가젯잔에 있는 트란렉이 옹이진 덤불나무괴물 8마리와 억센뿌리 덤불나무괴물 8마리를 처치해 달라고 했습니다.‡Tran\'rek de Gadgetzan quiere que mates a 8 Cardizales nudosos y a 8 enraizadores Cardizales.‡Tran\'rek de Gadgetzan quiere que mates a 8 Cardizales nudosos y a 8 enraizadores Cardizales.‡Tran\'rek, à Gadgetzan, voudrait que vous tuiez 8 Chardonniers noueux et 8 Chardonniers taille-racines.‡加基森的特兰雷克要你杀掉8只长瘤的灌木兽和8只灌木塑根者。‡加基森的特蘭雷克要你殺掉8隻長瘤的灌木獸和8隻灌木塑根者。',
  }
},
[3363] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[3364] = {
  {
    'Rabo-de-galo em domicílio‡Жгучая бражка‡Lieferung des kochend heißen Morgengebräus‡뜨거운 새벽주 배달‡Entrega una infusión de albaza hirviendo‡Entrega una infusión de albaza hirviendo‡Une livraison de thé brûlant‡热酒快递‡熱酒快遞',
    nil,
    'Take a Scalding Mornbrew to Durnan Furcutter inside Anvilmar before it gets cold in five minutes!‡Отнести жгучую бражку в Старую Наковальню и передать ее Дарнану Мехорезу. Это надо сделать за пять минут, пока бражка не остыла!‡Bringt ein kochend heißes Morgengebräu zu Durnan Pelznaht in Ambossar hinein, bevor es innerhalb von fünf Minuten kalt wird!‡앤빌마의 두르난 퍼커터에게 뜨거운 새벽주를 식기 전에 전해야 합니다!‡Lleva la infusión de albaza hirviendo a Durnan Cortapieles a Yunquemar antes de que se enfríe, ¡tienes 5 minutos!‡Lleva la infusión de albaza hirviendo a Durnan Cortapieles a Yunquemar antes de que se enfríe, ¡tienes 5 minutos!‡Apporter un Thé brûlant à Durnan Coupefourrure, dans Courbenclume, dans les cinq minutes imparties avant qu\'il ne refroidisse !‡在5分钟内把热酒交给安威玛尔的德南·弗卡特。‡在5分鐘內把熱騰騰的熱酒交給安威瑪的德南·弗卡特。',
  }
},
[3365] = {
  {
    'Devolva a caneca‡Возвращение кружки‡Den Becher zurückbringen‡빈 머그잔 가져가기‡Devuelve la jarra‡Devuelve la taza‡Rapporter la Tasse‡归还酒杯‡歸還酒杯',
    nil,
    'Return Nori\'s Mug to Nori Pridedrift in Coldridge Valley.‡Отнесите кружку хозяину – Нори по прозвищу Гордый Штрек. Он обитает в Холодной долине.‡Bringt Nori Stolzmut im Eisklammtal den Becher zurück.‡눈마루 골짜기에 있는 노리 프라이드드리프트에게 노리의 머그잔을 가져가야 합니다.‡Devuelve la jarra a Nori Rumborgullo, en el Valle de Crestanevada.‡Devuelve la jarra a Nori Rumborgullo, en el Valle de Crestanevada.‡Apporter la Chope de Nori à Nori Fièroblique dans la Vallée des Frigères.‡把诺里斯的杯子还给寒脊山谷的诺里斯·激流。‡到寒脊山谷把諾里的杯子還給諾里·激流。',
  }
},
[3366] = {
  {
    '‡Светящийся осколок‡Der leuchtende Splitter‡빛나는 조각‡El fragmento resplandeciente‡El fragmento resplandeciente‡L\'Éclat luminescent‡发光的碎片‡發光的裂片',
    nil,
    '‡Отправляйтесь в Кабестан и выясните, какие секреты скрывает кристалл кошмаров.‡Reist nach Ratschet, um die Bedeutung des Alptraumsplitters herauszufinden.‡톱니항으로 가서 악몽의 조각에 숨겨진 의미를 밝혀내야 합니다.‡Viaja hasta Trinquete para averiguar el significado oculto tras el Fragmento de Pesadilla.‡Viaja hasta Trinquete para averiguar el significado oculto tras el Fragmento de Pesadilla.‡Aller à Cabestan pour trouver la raison d\'être de l\'Éclat de cauchemar.‡寻找更多有关这块噩梦碎片的信息。‡',
  }
},
[3367] = {
  {
    'Pedras de Suntara‡Камни Сунтары‡Suntarasteine‡선타라 비석‡Piedras de Suntara‡Piedras de Suntara‡Les pierres de Suntara‡苏塔拉之石‡桑塔拉之石',
    nil,
    'Ajude Dório a voltar a Altaforja.|n‡Помогите Дориусу вернуться в Стальгорн.‡Helft Dorius, zurück nach Eisenschmiede zu kommen.‡도리우스가 아이언포지로 돌아가는 것을 도와야 합니다.‡Ayuda a Dorius a volver a Forjaz.‡Ayuda a Dorius a volver a Forjaz.|n‡Aider Dorius à retourner à Forgefer.‡帮助杜里奥斯回到铁炉堡。‡幫助杜里奧斯回到鐵爐堡。',
  }
},
[3368] = {
  {
    'Pedras de Suntara‡Камни Сунтары‡Suntarasteine‡선타라 비석‡Piedras de Suntara‡Piedras de Suntara‡Les pierres de Suntara‡苏塔拉之石‡桑塔拉之石',
    nil,
    'Leve a Carta Chamuscada para Tórius em Altaforja. Ele fica no Salão dos Exploradores.‡Доставьте опаленное письмо Ториусу в Стальгорн. Его можно найти в Зале Исследователей.‡Bringt den angesengten Brief zu Thorius in Eisenschmiede. Er befindet sich in der Halle der Forscher.‡아이언포지의 탐험가의 전당에 있는 소리우스에게 그을린 편지를 가져가야 합니다.‡Lleva la carta chamuscada a Thorius a Forjaz. Está en la Sala de los Expedicionarios.‡Lleva la carta chamuscada a Thorius a Forjaz. Está en la Sala de los Expedicionarios.‡Apporter la Lettre roussie à Thorius à Forgefer. Il se trouve dans le Hall des Explorateurs.‡把烧焦的信件交给铁炉堡的索里奥斯，他在探险者大厅里。‡把燒焦的信件交給鐵爐堡的索里奧斯，他在探險者大廳裡。',
  }
},
[3369] = {
  {
    'Em pesadelos‡Кошмары‡Alptraum‡악몽‡En las pesadillas‡En las pesadillas‡Au cœur des cauchemars‡在噩梦中‡在夢魘中',
    nil,
    'Leve a Lasca de Pesadelo para Hamuul Runa Totem no Platô dos Anciãos.‡Принесите кошмарный осколок Хамуулу Руническому Тотему на Вершине Старейшин.‡Bringt den Alptraumsplitter zu Hamuul Runentotem auf der Anhöhe der Ältesten.‡장로의 봉우리에 있는 하뮬 룬토템에게 악몽의 조각을 가져가야 합니다.‡Lleva el Fragmento de Pesadilla a Hamuul Tótem de Runa en el Alto de los Ancestros.‡Lleva el Fragmento de Pesadilla a Hamuul Tótem de Runa en el Alto de los Ancestros.‡Apportez l\'Éclat de cauchemar à Hamuul Totem-runique à la Cime des Anciens.‡把噩梦碎片交给长者高地的哈缪尔·符文图腾。‡把夢魘裂片交給長者高地的哈繆爾·符文圖騰。',
  }
},
[3370] = {
  {
    'Em pesadelos‡Кошмары‡Alptraum‡악몽‡En las pesadillas‡En las pesadillas‡Au cœur des cauchemars‡在噩梦中‡在夢魘中',
    nil,
    'Leve a Lasca de Pesadelo para Mathrengyl Ursivagus em Darnassus.‡Принесите кошмарный осколок Матренгилу Медвежьей Лапе в Дарнас.‡Bringt den Alptraumsplitter zu Mathrengyl Bärenfährte in Darnassus.‡다르나서스에 있는 마스렌길 베어워커에게 악몽의 조각을 가져가야 합니다.‡Lleva el Fragmento de Pesadilla a Mathrengyl Garroso de Darnassus.‡Lleva el Fragmento de Pesadilla a Mathrengyl Garroso de Darnassus.‡Apportez l\'Éclat de cauchemar à Mathrengyl Pasdelours à Darnassus.‡把噩梦碎片交给达纳苏斯的玛斯雷·驭熊者。‡把夢魘裂片交給達納蘇斯的瑪斯雷·馭熊者。',
  }
},
[3371] = {
  {
    'Justiça enânica‡Правосудие дворфов‡Zwergengerechtigkeit‡드워프식 정의‡La justicia de los enanos‡La justicia de los enanos‡La justice des nains‡矮人的正义‡矮人的正義',
    nil,
    'Return to the Searing Gorge and find Dorius\'s archaeology unit.‡Вернитесь в Тлеющее ущелье и найдите археологов Дориуса.‡Kehrt zur Sengenden Schlucht zurück und sucht Dorius\' Archäologenteam.‡이글거리는 협곡으로 돌아가서 도리우스의 발굴단 고고학자를 찾아야 합니다.‡Vuelve a La Garganta de Fuego y encuentra a la unidad arqueológica de Dorius.‡Vuelve a La Garganta de Fuego y encuentra a la unidad arqueológica de Dorius.‡Retourner à la Gorge des Vents brûlants et trouver l\'Equipe d\'archéologues de Dorius.‡回到灼热峡谷，找到杜里奥斯的考古队员。‡到灼熱峽谷找杜里奧斯的考古隊員。',
  }
},
[3372] = {
  {
    'Liberta os outros‡Отпусти их‡Erlöst sie‡해방‡Libéralos‡Libéralos‡La libération‡释放他们‡釋放他們',
    nil,
    'Encontre o Artefato Misterioso que está protegido pelos Idólatras do Martelo do Crepúsculo no quadrante noroeste da Garganta Abrasadora e leve-o para o Altar de Suntara, no Fosso de Lava.|n‡Найдите таинственный артефакт, охраняемый идолослужителями Сумеречного Молота в северо-западной области Тлеющего ущелья и возложите его на алтарь Сунтары в Шлаковой Яме.‡Sucht das geheimnisvolle Artefakt, das im nordwestlichen Teil der Sengenden Schlucht von den Götzendienern des Schattenhammerklans bewacht wird, und bringt es zum Altar von Suntara in der Schlackengrube.‡이글거리는 협곡의 북서쪽에 있는 황혼의 망치단 우상숭배자들이 보호하고 있는 수수께끼의 유물을 찾은 후, 잿가루 채석장에 있는 선타라의 제단으로 가져가야 합니다.‡Encuentra el artefacto misterioso que protegen los idólatras de Martillo Crepuscular en el cuadrante noroeste de La Garganta de Fuego y tráelo al altar de Suntara en la Fosa de la Escoria.|n‡Encuentra el artefacto misterioso que protegen los idólatras de Martillo Crepuscular en el cuadrante noroeste de La Garganta de Fuego y tráelo al altar de Suntara en la Fosa de la Escoria.|n‡Trouver l\'Artefact mystérieux gardé par les Idolâtres du Marteau du crépuscule dans le quart nord-est de la Gorge des Vents brûlants et ramenez-le à l\'Autel de Suntara dans la Fosse aux scories.‡到北方去找到被暮光之锤守卫着的神秘的古器，然后把它带到熔渣之池的苏塔纳祭坛上。‡找到被暮光之錘信徒守衛著的神秘古器，就在灼熱峽谷的西北邊緣。然後把東西帶到熔渣之池的蘇塔拉祭壇。',
  }
},
[3373] = {
  {
    'A Essência de Erânicos‡Сущность Эраникуса‡Die Essenz des Eranikus‡에라니쿠스의 정수‡La esencia de Eranikus‡La esencia de Eranikus‡L\'Essence d\'Eranikus‡伊兰尼库斯精华‡伊蘭尼庫斯精華',
    nil,
    'Coloque a Essência de Erânicos na Fonte de Essência encontrada neste covil do Templo Submerso.‡Поместите сущность Эраникуса в купель сущности в его логове в затонувшем храме.‡Legt die Essenz von Eranikus in den Essenzborn, der sich in dem Versunkenen Tempel in seinem Unterschlupf befindet.‡가라앉은 사원의 안식처에 있는 정수의 샘에 에라니쿠스의 정수를 놓아야 합니다.‡Coloca la esencia de Eranikus en la fuente de esencia situada en su guarida del Templo Sumergido.‡Coloca la esencia de Eranikus en la fuente de esencia situada en su guarida del Templo Sumergido.‡Placer l\'Essence d\'Eranikus dans le Réceptacle d\'essence situé dans son antre dans le Temple englouti.‡把伊兰尼库斯精华放在精华之泉里，精华之泉就在沉没的神庙中，伊兰尼库斯的巢穴里。‡把伊蘭尼庫斯精華放在精華之泉裡，精華之泉就在沉沒的神廟中，伊蘭尼庫斯的巢穴裡。',
  }
},
[3374] = {
  {
    'A Essência de Erânicos‡Сущность Эраникуса‡Die Essenz des Eranikus‡에라니쿠스의 정수‡La esencia de Eranikus‡La esencia de Eranikus‡L\'Essence d\'Eranikus‡伊兰尼库斯精华‡伊蘭尼庫斯精華',
    nil,
    'Leve a Pedra do Juramento da Revoada de Ysera e a Essência Acorrentada de Erânicos para Itharius no Pântano das Mágoas. Lá, você decidirá se deseja ajudar a Revoada Dragônica de Ysera ou não.‡Принесите камень Клятвы драконьего выводка Изеры и скованную сущность Эраникуса на Болото Печали. Там вам придется сделать выбор: помогать Драконам Изеры или нет.‡Bringt den Schwurstein von Yseras Drachenschwarm sowie die gebundene Essenz des Eranikus zu Itharius in die Sümpfe des Elends. Dort werdet Ihr Eure Entscheidung treffen, ob Ihr Yseras Drachenschwarm helfen wollt oder nicht.‡슬픔의 늪에 있는 이타리우스에게 이세라 용군단의 서약의 돌과 속박된 에라니쿠스의 정수를 가져가야 합니다. 이세라의 용군단을 도울 것인지 돕지 않을 것인지는 그곳에서 결정하게 됩니다.‡Llévale la piedra de juramento del Vuelo de Ysera y la esencia encadenada de Eranikus a Itharius, que está en el Pantano de las Penas. Una vez allí, deberás decidir si quieres ayudar al Vuelo de Ysera o no.‡Llévale la piedra de juramento del Vuelo de Ysera y la esencia encadenada de Eranikus a Itharius, que está en el Pantano de las Penas. Una vez allí, deberás decidir si quieres ayudar al Vuelo de Ysera o no.‡Apportez la Pierre de voeu des dragons d\'Ysera et l\'Essence d\'Eranikus enchaînée à Itharius au marais des Chagrins. C\'est là que vous choisirez d\'aider ou non les dragons d\'Ysera.‡把伊瑟拉巨龙军团的誓言石和被禁锢的伊兰尼库斯精华交给悲伤沼泽的伊萨里奥斯。在那里你可以决定是否要帮助伊瑟拉的绿龙军团。‡把伊瑟拉巨龍軍團和被禁錮的伊蘭尼庫斯精華帶給悲傷沼澤的伊薩里奧斯。在那裡你可以決定是否要幫助伊瑟拉的綠龍軍團。',
  }
},
[3375] = {
  {
    '‡Запасной фиал‡Ersatzphiole‡수정점의 유리병 다시 받기‡Otra ampolla‡Otra ampolla‡La flasque de remplacement‡占卜之瓶‡',
    nil,
    '‡Принесите зелье маны, уголь и сладкий нектар Талвашу дель Кисселю в Стальгорн, чтобы получить запасной фиал виденья Талваша.‡Bringt einen Manatrank, Kohle und Süßen Nektar zu Talvash del Kissel in Eisenschmiede, um einen Ersatz für Talvashs Wahrsagephiole zu bekommen.‡아이언포지에 있는 탈바쉬 델 키젤에게 마나 물약과 석탄, 달콤한 과즙을 가져가고 새로운 탈바쉬의 수정점 유리병을 얻어야 합니다.‡Lleva 1 poción de maná, 1 trozo de carbón y néctar dulce a Talvash del Kissel a Forjaz. Te dará una ampolla de adivinación.‡Lleva 1 poción de maná, 1 trozo de carbón y néctar dulce a Talvash del Kissel a Forjaz. Te dará una ampolla de adivinación.‡Apportez une Potion de mana, du Charbon, et du Nectar sucré à Talvash del Kissel, à Forgefer, pour remplacer la Flasque de divination de Talvash.‡把一瓶法力药水、一块煤和一瓶蜂蜜酒送到铁炉堡的塔瓦斯德·基瑟尔那里，用以换取塔瓦斯德的占卜之瓶。‡',
  }
},
[3376] = {
  {
    'Quebra-presadura!‡Сразить Остроклыка!‡Tötet Spitzhauer!‡족장 칼날엄니 처치!‡La cabeza de Cornapunta‡La cabeza de Cornapunta‡La fin de Brochaigu !‡刺鬃酋长‡打斷尖牙!',
    nil,
    'Leve a cabeça do Chefe Presadura Mantospinho para a Valente Pena ao Vento na Chapada Nuvem Vermelha.‡Принесите голову вождя Остроклыка Терновой Мантии Храбрецу Перу Ветра на плато Красного Облака.‡Bringt den Kopf von Häuptling Spitzhauer Dornenmantel zu Kriegerheldin Windfeder auf der Hochwolkenebene.‡족장 칼날엄니를 처치한 후 그 증거로 그의 머리카락을 붉은구름 고원에 있는 용사 윈드페더에게 가져가야 합니다.‡Lleva la cabeza del Jefe Cornapunta Mantospina a la Valiente Pluma de Viento en Mesa de la Nube Roja.‡Lleva la cabeza del Jefe Cornapunta Mantospina a la Valiente Pluma de Viento en Mesa de la Nube Roja.‡Apportez la Tête du chef Brochaigu Mantépine à Brave Plume-des-vents à la Mesa de Nuage rouge.‡把刺鬃酋长的徽记交给红云台地的卫兵维萨罗·风羽。‡把尖牙刺鬃酋長的頭顱交給紅雲台地的勇者風羽。',
  }
},
[3377] = {
  {
    '‡Молитва к Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡Rezo a Elune‡Rezo a Elune‡Prière à Élune‡艾露恩祷言‡伊露恩祈禱文',
    nil,
    '‡Выслушайте Зимаэля.‡Hört Zamaels Geschichte.‡잠마엘 룬시슬의 이야기를 들어야 합니다.‡Escucha a Zamael.‡Escucha a Zamael.‡Écouter le récit de Zamael.‡听萨麦尔讲述他的故事。‡',
  }
},
[3378] = {
  {
    'Oração a Eluna‡Молитва к Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡El rezo a Elune‡El rezo a Elune‡Prière à Élune‡艾露恩祷言‡伊露恩祈禱文',
    nil,
    'Encontre a Oração a Eluna e leve-a para Astarii Mirestela em Darnassus.|n‡Найдите молитву Элуне и принесите ее Астарии Ловцу Звезд в Дарнас.‡Findet das Gebet an Elune und bringt es zu Astarii Sternsucher in Darnassus.‡엘룬께 올리는 기도문을 찾아 다르나서스에 있는 아스타리 스타시커에게 가져가야 합니다.‡Lleva el rezo a Elune a Astarii Buscaestelar a Darnassus.|n‡Lleva el rezo a Elune a Astarii Buscaestelar a Darnassus.|n‡Trouver la Prière à Élune et l\'apporter à Astarii Cherchétoile à Darnassus.‡找到艾露恩祷言，然后将其交给达纳苏斯的阿斯塔利·逐星。‡找到伊露恩祈禱文，然後交給達納蘇斯的阿斯塔利·逐星者。',
  }
},
[3379] = {
  {
    'Tecessombras‡Мастер по тенеткани‡Schattenweber‡그림자매듭‡Las tejedoras de sombra‡Las tejedoras de sombra‡Les tisseuses d\'ombre‡暗影蛛丝‡暗影蛛絲',
    nil,
    'Mate os Larápios de Seda Sombria que rondam a Garganta Abrasadora. Nilith acredita que cinco deles precisam ser exterminados. Fale com Nilith novamente na Garganta Abrasadora quando tiver cumprido essa tarefa.|n‡Убейте банду похитителей тенешелка, хозяйничающую в Тлеющем ущелье. Нилит полагает, что их пятеро. Вернитесь к Нилит по выполнению задания.‡Tötet die Gruppe der Schattenseidewilderer, die in der Sengenden Schlucht umherstreifen. Nilith hat Grund zu der Annahme, dass es fünf von ihnen gibt, die ausgeschaltet werden müssen.‡이글거리는 협곡을 돌아다니는 그늘거미 밀렵꾼을 처치해야 합니다. 닐리스는 다섯 명 정도는 처치해야 한다고 생각하고 있습니다. 임무를 완수하면 이글거리는 협곡에 있는 닐리스에게 돌아가십시오.‡Mata a los furtivos Sedaumbría de La Garganta de Fuego. Nilith cree que son 5. Ve a ver a Nilith en La Garganta de Fuego cuando hayas terminado.|n‡Mata a los furtivos Sedaumbría de La Garganta de Fuego. Nilith cree que son 5. Ve a ver a Nilith en La Garganta de Fuego cuando hayas terminado.|n‡Tuer le groupe de braconniers Ombresoie qui rôde dans la gorge des Vents brûlants. Nilith a de bonnes raisons de croire qu\'ils doivent être exterminés tous les cinq. Retourner voir Nilith dans la gorge des Vents brûlants lorsque vous aurez terminé.‡杀死在灼热峡谷游荡的暗影蛛丝偷猎者小队。尼莉丝认为他们共有5名成员，你的任务就是把他们全都干掉。‡殺死在灼熱峽谷遊蕩的暗影蛛絲偷獵者小隊。尼莉絲認為他們共有5名成員，你的任務就是把他們全都幹掉。',
  }
},
[3380] = {
  {
    'O Templo Submerso‡Затонувший храм‡Der Versunkene Tempel‡가라앉은 사원‡El Templo Sumergido‡El Templo Sumergido‡Le Temple englouti‡沉没的神庙‡沉沒的神廟',
    nil,
    'Encontre Marlon Catarrebite em Tanaris.‡Найдите Марвона Клепальщика в Танарисе.‡Sucht Marvon Nietensucher in Tanaris.‡타나리스에서 마본 리벳시커를 찾아야 합니다.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Trouver Marvon Chercherivet à Tanaris.‡到塔纳利斯找到玛尔冯·瑞文斯克。‡到塔納利斯找到瑪爾馮·瑞文斯克。',
  }
},
[3381] = {
  {
    '‡Встреча с господином‡Ein Treffen mit dem Meister‡사나스의 스승‡Un encuentro con el maestro‡Un encuentro con el maestro‡Une rencontre avec le maître‡会见主人‡',
    nil,
    '‡Принесите 2 неповрежденных пера гиппогрифа Санату Лим-Йо в в Азшару, если хотите говорить с его господином.‡Bringt 2 unbeschädigte Hippogryphenfedern zu Sanath Lim-yo in Azshara, wenn Ihr mit seinem Meister sprechen wollt.‡‡Llévale 2 plumas de hipogrifo intactas a Sanath Lim-yo en Azshara si deseas hablar con su maestro.‡Llévale 2 plumas de hipogrifo intactas a Sanath Lim-yo en Azshara si deseas hablar con su maestro.‡Apporter 2 Plumes d\'hippogriffe sans défaut à Sanath Lim-Yo, en Azshara, si vous souhaitez parler à son maître.‡‡',
  }
},
[3382] = {
  {
    'Sob fogo cerrado‡На абордаж!‡Eine Mannschaft in Bedrängnis‡위험에 처한 선원‡Un equipo bajo el fuego enemigo‡Un equipo bajo el fuego enemigo‡Doux whisky‡危难中的船长‡危難中的船長',
    nil,
    'Defenda a Capitão Vanessa Beltis, sua tripulação e os passageiros do Batedor do Horizonte do ataque das nagas. A Capitão Vanessa Beltis deve sobreviver.‡Защитите капитана Ванессу Белтис, ее команду и пассажиров "Покорителя Горизонтов" от нападения наг. Капитан Ванесса Белтис должна выжить.‡Verteidigt Kapitän Vanessa Beltis, ihre Mannschaft und die Passagiere der Herrin des Horizonts gegen den Angriff der Naga. Kapitän Vanessa Beltis muss überleben.‡선장 바네사 벨티스와 그녀의 선원들, 지평선 정찰함의 승객들을 나가의 공격으로부터 보호해야 합니다. 적어도 선장 바네사 벨티스는 반드시 살아남아야 합니다.‡Defiende a la capitana Vanessa Beltis, su tripulación y los pasajeros del Explorador del horizonte frente al ataque de los nagas. La capitana Vanessa Beltis tiene que sobrevivir.‡Defiende a la capitana Vanessa Beltis, su tripulación y los pasajeros del Explorador del horizonte frente al ataque de los nagas. La capitana Vanessa Beltis tiene que sobrevivir.‡Défendre la capitaine Vanessa Beltis, son équipage et les passagers de "l\'Horizon" contre l\'attaque des nagas. La capitaine Vanessa Beltis doit survivre.‡帮助瓦妮莎·贝蒂斯船长、她的船员和地平线轻帆号上的乘客抵御纳迦的攻击。瓦妮莎·贝蒂斯船长必须存活。‡幫助凡妮莎·貝蒂斯船長、她的船員和地平線輕帆號上的乘客抵禦納迦的攻擊。凡妮莎·貝蒂斯船長必須存活。',
  }
},
