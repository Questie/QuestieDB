  }
},
[9288] = {
  {
    'Treinamento de caçador‡Наставник охотников‡Ausbildung zum Jäger‡사냥꾼 훈련‡Instrucción de cazador‡Instrucción de cazador‡La formation de chasseur‡猎人训练‡獵人訓練',
