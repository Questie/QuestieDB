[24897] = {
  {
    'De volta à cidade‡Возвращение в город‡Zurück in die Stadt‡마을로 돌아가기‡Regresar a la ciudad‡Regresar a la ciudad‡Retour en ville‡返回胶囊镇‡回到鎮上',
    nil,
    'Fale com Espoleta Chaveforte na Cidade Portátil, que fica nas Ilhas Perdidas.‡Поговорите с Хамми Кофельнагель в Городке-из-табакерки на Затерянных островах.‡Sprecht mit Sassy Hartzang in Instastadt auf den Verlorenen Inseln.‡잃어버린 섬의 상자 마을에 있는 새시 하드렌치와 대화해야 합니다.‡Habla con Sassy Malallave en la Ciudad de Bolsillo, en Las Islas Perdidas.‡Habla con Sassy Malallave en la Ciudad de Bolsillo, en Las Islas Perdidas.‡Parlez à Chipie Serrelavis à Ville-en-Boîte, sur les Îles Perdues.‡跟失落群岛胶囊镇的莎希·硬钳谈一谈。‡到失落群島上的盒中鎮和賽希‧硬心談話。',
  }
},
[24898] = {
  {
    '‡Груды гуано‡Go, Go, Guano!‡조분석을 나에게!‡Guano del Horado‡Guano del Horado‡Corvée de guano‡蝙蝠的粪便‡',
    nil,
    '‡Принесите Зан\'до в Кремневый лагерь 1 кучку гуано летучей мыши Лабиринтов.‡Bringt Zan\'do an der Flammensteinspitze 1 Häufchen Kralguano.‡화염석 거점의 장도에게 가시덤불 조분석을 가져가야 합니다.‡Lleva una pila de guano del Horado a Zan\'do a Punta Piedra de Fuego.‡‡Apportez 1 tas de Guano du kraal à Zan\'do, à la Halte de Pierre-feu.‡‡',
  }
},
[24899] = {
  {
    '‡Груды гуано‡Go, Go, Guano!‡조분석을 나에게!‡Guano del Horado‡Guano del Horado‡Corvée de guano‡蝙蝠的粪便‡',
    nil,
    '‡Принесите 1 кучку гуано летучей мыши Лабиринтов опытному аптекарю Фаранеллу в Подгород.‡Bringt dem Apothekermeister Faranell in Unterstadt 1 Häufchen Kralguano.‡언더시티에 있는 수석 연금술사 파라넬에게 가시덩굴 조분석을 가져가야 합니다.‡Llévale una pila de guano del Horado al maestro boticario Faranell en Entrañas.‡Llévale una pila de guano del Horado al maestro boticario Faranell en Entrañas.‡Apporter 1 tas de Guano du kraal au maître apothicaire Faranell à Fossoyeuse.‡帮幽暗城的大药剂师法拉尼尔带回一堆沼泽蝙蝠的粪便。‡',
  }
},
[24900] = {
  {
    '‡Корни Синелиста‡Blaulaubknollen‡청엽수 줄기‡Los tubérculos hojazul‡Los tubérculos hojazul‡Racines de feuillebleue‡蓝叶薯‡',
    nil,
    '‡‡Benutzt in Kral der Klingenhauer die Kiste mit Löchern, um die Schnüffelnasenziesel zu beschwören und benutzt den Schnüffelnasenleitstecken, um sie zum Suchen anzuspornen.|n|nBringt 6 Blaulaubknollen zu Mebok Mizzyrix in Ratschet.‡가시덩굴 우리에서 구멍 난 상자를 사용해 땅다람쥐를 소환하고 지휘봉을 사용해 땅다람쥐에게 청엽수 줄기를 찾아내도록 해야 합니다.|n|n톱니항에 있는 메보크 미지릭스에게 청엽수 줄기 6개를 가져가야 합니다.‡En Horado Rajacieno, utiliza el cajón con agujeros para invocar un husmeador taltuza, y utiliza la vara de mando con el husmeador para que busque tubérculos.|n|nLleva 6 tubérculos hojazul a Mebok Mizzyrix en Trinquete.‡‡Dans le Kraal de Tranchebauge, utilisez la Caisse percée pour appeler un Sniffetarin. Ensuite, utilisez le Bâton de commandement de Sniffetarin pour le lancer à la recherche des racines.|n|nApportez 6 Racines de feuillebleue à Mebok Mizzyrix, à Cabestan.‡‡',
  }
},
[24901] = {
  {
    'Cidade Portátil: sob ataque‡Городок-из-табакерки под угрозой!‡Instastadt: Unter Angriff‡공격 받는 상자 마을‡Ciudad de Bolsillo: ¡nos atacan!‡Ciudad de Bolsillo: ¡nos atacan!‡Ville-en-Boîte est attaquée !‡胶囊镇：遭到攻击‡盒中鎮:遭受攻擊',
    nil,
    'Use um Eliminador B.C. para derrotar 30 Guerreiros Trema-trema.‡С помощью баллистического уничтожителя сразите 30 воинов Умлота.‡Verwendet einen B.C. Eliminator, um 30 Krieger von Oomlot zu töten.‡빌지워터 무역회사 섬멸포를 이용해서 움로트 전사 30명을 처치해야 합니다.‡Utiliza un eliminador B.C. para abatir 30 guerreros Oomlot.‡Utiliza un eliminador B.C. para abatir 30 guerreros Oomlot.‡Utilisez un G.C. Éliminator pour vaincre 30 Guerriers oomlot.‡使用B.C.消除者击杀30名乌姆洛特战士。‡操作B.C.殲滅者擊敗30名烏姆拉戰士。',
  }
},
[24902] = {
  {
    'No encalço de Sylvana‡В погоне за Сильваной‡Jagd nach Sylvanas‡실바나스 추적‡A la caza de Sylvanas‡A la caza de Sylvanas‡À la poursuite de Sylvanas‡追踪希尔瓦娜斯‡獵殺希瓦娜斯',
    nil,
    'Acompanhe Tobias Brumanto na Caçada a Sylvana.‡Присоединитесь к Тобиасу Мистмантлу в погоне за Сильваной.‡Folgt Tobias Dunstmantel auf der Jagd nach Sylvanas.‡실바나스를 추적하는 토비아스 미스트맨틀을 따라가야 합니다.‡Sigue a Tobias Mantoniebla a la caza de Sylvanas.‡Sigue a Tobias Mantoniebla a la caza de Sylvanas.‡Suivez Tobias Mantebrume à la poursuite de Sylvanas.‡跟随托比亚斯·密斯特曼托追踪希尔瓦娜斯。‡在狩獵希瓦娜斯的行動中跟隨托比亞斯·密斯特曼托。',
  }
},
[24903] = {
  {
    'Vingança ou sobrevivência?‡Месть или выживание‡Rache oder Überleben‡복수와 생존 사이‡Venganza o supervivencia‡Venganza o supervivencia‡La vengeance ou la survie‡复仇或是生存‡復仇或求生',
    nil,
    'Fale com o Rei Genn Greymane no Paço Greymane, na cidade de Guilnéas.‡Поговорите с королем Генном Седогривом на площади Седогрива в Гилнеасе.‡Sprecht mit König Genn Graumähne auf dem Graumähnenhof in Gilneas.‡길니아스의 그레이메인 궁정에 있는 국왕 겐 그레이메인과 대화해야 합니다.‡Habla con el rey Genn Cringris en el Patio de Cringris en la Ciudad de Gilneas.‡Habla con el rey Genn Cringris en el Patio de Cringris en la Ciudad de Gilneas.‡Parlez au roi Genn Grisetête dans la Cour de Grisetête, dans la ville de Gilnéas.‡跟吉尔尼斯城格雷迈恩皇家庭院的吉恩·格雷迈恩国王谈一谈。‡在吉爾尼斯城的葛雷邁恩宮廷和吉恩·葛雷邁恩國王談話。',
  }
},
[24904] = {
  {
    'A batalha por Guilnéas‡Битва за Гилнеас‡Schlacht um Gilneas‡길니아스 전투‡La Batalla por la Ciudad de Gilneas‡La Batalla por la Ciudad de Gilneas‡La bataille pour Gilnéas‡吉尔尼斯城保卫战‡吉爾尼斯城之戰',
    nil,
    'Ganhe a batalha pela cidade de Guilnéas.‡Одержите победу в битве за Гилнеас.‡Erringt den Sieg in der Schlacht um Gilneas‡길니아스 전투에서 승리해야 합니다.‡Consigue la victoria en la Batalla por la Ciudad de Gilneas.‡Consigue la victoria en la Batalla por la Ciudad de Gilneas.‡Obtenir la victoire dans la bataille pour Gilnéas.‡取得吉尔尼斯城保卫战的胜利。‡為吉爾尼斯城取得勝利。',
  }
},
[24905] = {
  {
    'Ela não para quieta‡Взаимная услуга‡Sich für einen Gefallen revanchieren‡호의‡Devolver un favor‡Devolver un favor‡Un service vaut ce qu’il coûte‡还人情‡報答',
    nil,
    'Encontre Carlota Tomanota no Complexo Dunamalho.‡Найдите Мегз Жестекрошшер в поселении Песчаного Молота.‡Findet Megs Schredderschreck beim Truppenlager der Dünenbrecher.‡모래망치 모집 야영장에서 멕스 드레드슈레더를 찾아야 합니다.‡Encuentra a Megs Trituramatic en el Campo de Reclutamiento Machacaduna.‡Encuentra a Megs Trituramatic en el Campo de Reclutamiento Machacaduna.‡Retrouvez Megs Déchiqueffroi au Camp des Cognedunes.‡去找砂槌营地的梅格斯·碎纸机。‡到砂槌營地尋找梅格斯·驚懼伐木機。',
  }
},
[24906] = {
  {
    'Resgate dos suprimentos‡Спасение имущества‡Wiederverwertung an der Küste‡보급품 회수 작업‡Salvamento costero‡Salvamento costero‡Chasseur d’épaves‡海边打捞‡海濱撈寶',
    nil,
    'Recupere 7 Suprimentos de Bondebico.‡Соберите 7 контейнеров с припасами Хитрой Шестеренки.‡Sammelt 7 Dampfdruckvorräte.‡스팀휘들 보급품 7개를 모아야 합니다.‡Recoge 7 suministros de Bonvapor.‡Recoge 7 suministros de Bonvapor.‡Rassemblez 7 caisses de Ravitaillement de Gentepression.‡收集7份热砂补给品。‡收集7個熱砂補給物資。',
  }
},
[24907] = {
  {
    'Pisando na poça‡Топая по лужам‡Pfützenstampfer‡거인들로 들썩이는 웅덩이‡Chapoteando en los charcos‡Chapoteando en los charcos‡Plouf dans les flaques‡踩水坑‡踏浪',
    nil,
    'Mate 8 Andarilhos das Marés.‡Убейте 8 приливных странников.‡Tötet 8 Gezeitenschreiter.‡파도거인 8마리를 처치해야 합니다.‡Mata a 8 zancudos de marea.‡Mata a 8 zancudos de marea.‡Tuez 8 Marcheurs des marées.‡杀死8名潮行巨人。‡殺死8個逐潮者。',
  }
},
