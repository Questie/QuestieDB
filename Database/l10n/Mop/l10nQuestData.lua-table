[32584] = {
  {
    'Força de invasão‡Вторжение‡Feindlicher Übergriff‡‡Fuerzas invasoras‡‡Une troupe envahissante‡渗透力量‡',
    nil,
    'Mate Nurkala, o Líder Guerreiro dos Zandalari. Uma‡Убейте Нуркала, военного вождя зандаларов.‡Tötet Nurkala, den Kriegsanführer der Zandalari.‡‡Mata a Nurkala, líder de guerra Zandalari.‡‡Tuez Nurkala, le chef de guerre zandalari.‡消灭赞达拉战争首领奴卡拉。‡',
  }
},
[32585] = {
  {
    'Força de invasão‡Вторжение‡Feindlicher Übergriff‡적군의 침략‡Fuerzas invasoras‡‡Une troupe envahissante‡渗透力量‡',
    nil,
    'Mate Nurkala, o Líder Guerreiro dos Zandalari. Uma‡Убейте Нуркала, военного вождя зандаларов.‡Tötet Nurkala, den Kriegsanführer der Zandalari.‡잔달라 전쟁 지도자인 누르카라를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a Nurkala, líder de guerra Zandalari.‡‡Tuez Nurkala, le chef de guerre zandalari.‡消灭赞达拉战争首领奴卡拉。‡',
  }
},
[32586] = {
  {
    'Capacitor máximo‡Максимальная нагрузка‡Der Maximalkondensator‡천공기 과부하‡Condensando energías‡‡Condensateur au max‡电容上限‡',
    nil,
    'Destrua as 3 Brocas de Raios nas Minas de Ferro Fantasma e mate o Senhor do Metal Mono-Han. Uma‡Уничтожьте 3 молниевых бура в Шахте молний и убейте повелителя металла Моно-Ханя.‡Zerstört 3 Blitzbohrer in den Blitzaderminen und tötet Metallfürst Mono-Han.‡유령무쇠 광산에 있는 번개 천공기 3개를 파괴하고 무쇠군주 모노한을 처치해야 합니다. 레벨 32 천둥의 섬‡Destruye las 3 taladradoras de relámpagos en las minas de hierro fantasma y mata al señor del metal Mono-Han.‡‡Détruisez 3 Foreuses de foudre à la Veine de Foudremine et tuez le Seigneur du métal Mono Han.‡在闪电矿脉中摧毁3个闪电钻，并击败金铁领主莫诺汗。‡',
  }
},
[32587] = {
  {
    'Forja adiante!‡Впереди кузня!‡Schmiede voraus!‡제련소로!‡¡Hacia la forja!‡‡Forge droit devant !‡近在眼前！‡',
    nil,
    'Mate o Mestre da Forja e pegue um Fragmento de Códice do Moldacarne Hoku na Ilha do Trovão. Uma‡Убейте главного кузнеца и получите фрагмент кодекса от стража врат могу на острове Грома.‡Tötet den Meister der Schmiede und sammelt ein Kodexfragment von Fleischschmied Hoku auf der Insel des Donners ein.‡천둥의 섬에 있는 제련소 대장을 처치하고 살덩이창조자 호쿠에게서 모구 전서 조각을 수집해야 합니다.‡Mata al maestro de la forja y recoge un fragmento de códice del modelador de carne Hoku en la Isla del Trueno.‡‡Tuez le Maître de la forge et récupérez un Fragment de codex sur le Façonneur de chair Hoku, sur l’Île du Tonnerre.‡击败锻造大师，并从雷神岛的塑肌者霍古身上取得一块法典碎片。‡',
  }
},
[32588] = {
  {
    'A serviço secreto da autoridade arcana‡Секретные агенты Ее Mагичества‡Im Geheimdienst Ihrer Magietät‡제이나의 비밀 요원들‡Rescata y deja morir‡‡Au service secret de sa magie-sté‡女士密令‡',
    nil,
    'Resgate os três agentes do Kirin Tor capturados dentro das Minas de Ferro Fantasma e mate o Senhor do Metal Mono-Han. Uma‡Спасите 3 захваченных представителей Кирин-Тора в Шахте молний и убейте повелителя металла Моно-Ханя.‡Rettet die drei gefangenen Agenten der Kirin Tor aus der Blitzadermine und tötet Metallfürst Mono-Han.‡유령무쇠 광산 안에서 생포된 키린 토 요원 세 명을 구출한 뒤 무쇠군주 모노한을 처치해야 합니다.‡Rescata a los tres agentes del Kirin Tor secuestrados en las minas de hierro fantasma y mata al señor del metal Mono-Han.‡‡Sauvez les 3 Agents du Kirin Tor capturés à la Veine de Foudremine, et tuez le Seigneur du métal Mono Han.‡在闪电矿脉中解救3名被捕的肯瑞托密探，并击败金铁领主莫诺汗。‡',
  }
},
[32589] = {
  {
    'Sangue Vital‡Живая кровь‡Lebensblut‡활력의 근원‡Sangre de vida‡‡Le sang de vie‡生命力‡',
    nil,
    'Use este Cristal Sintonizado para recuperar os Restos de Animus do Animus Sombrio no Trono do Trovão. Uma‡Используйте настроенный кристалл, чтобы извлечь останки Анимуса из Темного Анимуса на Престоле Гроз.‡Benutzt den abgestimmten Kristall, um dem dunklen Animus auf dem Thron des Donners die Reste des Animus zu entziehen.‡천둥의 왕좌에 있는 암흑 원령으로부터 원령의 잔재를 구해 조율된 수정에 담아야 합니다. 레벨 35 천둥의 왕좌‡Usa el cristal armonizado para recuperar los remanentes de Animus del Animus oscuro en el Solio del Trueno.‡‡Utilisez le Cristal harmonisé pour récupérer les Restes de l’animus sur le Sombre animus au sein du Trône du tonnerre.‡使用调和水晶从雷电王座的黑暗意志身上取得意志残渣。‡',
  }
},
[32590] = {
  {
    'Encontre-me no segundo andar‡Встретимся наверху‡Trefft mich oben‡위층으로‡Nos vemos arriba‡‡Retrouvez-moi là-haut‡楼上的约见‡',
    nil,
    'Fale com Wrathion no segundo andar da Taverna na Névoa, que fica na Escadaria Oculta. Uma‡Встретьтесь с Гневионом в таверне "В туманах", что на Сокрытой лестнице. Награда: .‡Trefft Furorion im zweiten Stock der Taverne im Nebel an der Verhüllten Treppe.‡장막의 계단, 안개 속의 주점 2층에서 래시온을 만나야 합니다. 레벨 35‡Reúnete con Wrathion arriba, en la segunda planta de la Taberna en la Niebla, en La Escalera Velada.‡‡Retrouvez Irion au deuxième étage de la Taverne dans les Brumes, dans l’Escalier Dérobé.‡在雾纱栈道的迷雾酒肆二楼与拉希奥会面。‡',
  }
},
[32591] = {
  {
    'Segredos do primeiro império‡Секреты Первой империи‡Geheimnisse des ersten Kaiserreiches‡첫 번째 제국의 비밀‡Los secretos del Primer Imperio‡‡Les secrets du premier empire‡第一帝国的秘密‡',
    nil,
    'Colete 20 Segredos do Império e 40 Barras de Trílio. Uma‡Соберите 20 тайн империи и 40 слитков триллия. это‡Sammelt 20 Geheimnisse des Kaiserreichs und 40 Trilliumbarren.‡제국의 비밀 20개와 트릴리움 주괴 40개를 모아야 합니다. 레벨 35‡Recoge 20 secretos del Imperio y 40 barras de trillium.‡‡Récupérez 20 Secrets de l’empire et 40 Barres de trillium.‡收集20份帝国秘史和40块延极锭。‡',
  }
},
[32593] = {
  {
    'A Forja do Trovão‡Кузня Грома‡Die Donnerschmiede‡천둥 제련소‡La Forja del Trueno‡‡La forge du Tonnerre‡雷霆熔炉‡',
    nil,
    'Avance pela Ilha do Trovão até desbloquear a Forja do Trovão. Encontre Wrathion fora da Forja e cumpra a tarefa dele. Uma‡Исследуйте остров Грома до тех пор, пока вам не откроется доступ в Кузню Грома. Найдите Гневиона у кузни и завершите данное им задание.‡Kämpft Euch durch die Insel des Donners, bis die Donnerschmiede zugänglich wird. Trefft Euch vor der Donnerschmiede mit Furorion und schließt seine Aufgabe ab.‡천둥의 섬에서 천둥 제련소가 개방될 때까지 진행해야 합니다. 그런 다음 천둥 제련소 밖에서 래시온을 만나 임무를 완수해야 합니다.‡Sigue avanzando en la Isla del Trueno hasta que desbloquees la Forja del Trueno. Reúnete con Wrathion fuera de la Forja del Trueno y sigue sus órdenes.‡‡Progressez dans l’île du Tonnerre jusqu’à débloquer la Forge du Tonnerre. Retrouvez Irion à l’extérieur de la Forge du Tonnerre et faites ce qu’il vous demande.‡在雷神岛上继续探索，直到你找到雷霆熔炉。与拉希奥在雷霆熔炉外面碰头，并完成他的任务。‡',
  }
},
[32594] = {
  {
    'Espírito do Senhor da Tempestade‡Дух Повелителя Гроз‡Geist des Sturmfürsten‡폭풍 군주의 영혼‡El espíritu del Señor de la Tormenta‡‡L’esprit du seigneur des tempêtes‡暴风领主之魂‡',
    nil,
    'Avance pela Ilha do Trovão até desbloquear o último pátio. Obtenha um Lança de Raio Temperada cravando a lança no Senhor da Tempestade Nalak e sobrevivendo por tempo suficiente para drenar seu poder.‡Продвигайтесь по острову Грома, пока не откроете последний внутренний двор. Получите закаленное Копье молний, вонзив копье в Повелителя Гроз Налака и убив его.‡Kämpft Euch durch die Insel des Donners, bis der Innenhof zugänglich wird. Beschafft Euch eine gehärtete Blitzlanze, indem Ihr Nalak dem Sturmfürsten die Lanze in den Leib stoßt und lang genug überlebt, um ihm seine Macht zu entziehen.‡천둥의 섬에서 최후의 안마당이 개방될 때까지 진행해야 합니다. 폭풍 군주 나락크의 옆구리에 창을 꽂은 후 그 힘을 흡수할 때까지 살아남아 담금질된 번개 창을 획득해야 합니다.‡Avanza a través de la Isla del Trueno hasta que desbloquees el patio final. Clávale la lanza al Señor de la Tormenta Nalak y sobrevive el tiempo suficiente para succionar su poder para obtener una lanza del relámpago templada.‡‡Progressez sur l’Île du Tonnerre jusqu’à ce que vous ayez débloqué la dernière cour. Obtenez un Javelot de foudre trempé en transperçant le Seigneur des tempêtes Nalak avec le javelot assez longtemps pour siphonner sa puissance.‡在雷神岛上继续探索，直到你找到最后一个庭院。将长枪插进暴风领主纳拉克的身体里，坚持到将他的力量虹吸出来，以获得淬火闪电长枪。‡',
  }
},
[32595] = {
  {
    'A Coroa do Paraíso‡Корона Небес‡Die Krone des Himmels‡천공의 정점‡La corona del cielo‡‡La couronne des cieux‡苍穹之冠‡',
    nil,
    'Encontre-se com Wrathion no topo da Loucura do Alvanel, que fica na Escadaria Oculta, e receba sua recompensa. Uma‡Встретьтесь с Гневионом на вершине Причуды Камнетеса на Сокрытой лестнице и получите свою награду.‡Trefft Euch auf des Steinmetz\' Torheit an der Verhüllten Treppe mit Furorion, um Eure Belohnung zu erhalten.‡장막의 계단에 있는 석공의 우둔함 꼭대기에서 래시온을 만나 보상을 받아야 합니다. 레벨 35‡Reúnete con Wrathion en la cima de la Locura del Albañil en La Escalera Velada y recoge tu recompensa.‡‡Retrouvez Irion en haut de la Folie du maçon, à l’Escalier Dérobé, pour récupérer votre récompense.‡与拉希奥在雾纱栈道的石匠之愚碰面，并领取奖赏。‡',
  }
},
[32596] = {
  {
    'Ecos dos Titãs‡Эхо титанов‡Echos der Titanen‡티탄의 메아리‡El eco de los titanes‡‡Les échos des titans‡泰坦回音‡',
    nil,
    'Colete 12 Pedras Rúnicas Titânicas de chefes de raides nos Salões da Carne Moldada e no Pináculo das Tempestades. Uma‡Соберите 12 рунических камней титанов. Их можно добыть с рейдовых боссов в залах Искажения Плоти и на Вершине Бурь.‡Sammelt 12 Runensteine der Titanen von Schlachtzugsbossen in den Hallen der Fleischformer und der Spitze der Stürme.‡살점구체자의 전당과 폭풍의 첨탑에 있는 공격대 우두머리를 쓰러뜨리고 티탄 마법석을 12개 모아야 합니다.‡Reúne 12 piedras rúnicas de los titanes de jefes de bandas en las Cámaras de Modelado de Carne y en el Pináculo de las Tormentas. Otorga  como recompensa.‡‡Récupérez 12 Pierres runiques des titans sur les Boss de raid dans les Salles des Sculpte-chairs et à la Cime des Tempêtes.‡从修身殿和风暴之巅的团队首领身上取得12块泰坦符文石。‡',
  }
},
[32597] = {
  {
    'Coração do Rei Trovão‡Сердце Властелина Грома‡Herz des Donnerkönigs‡천둥왕의 심장‡El corazón del Rey del Trueno‡‡Le cœur du roi-tonnerre‡雷神之核‡',
    nil,
    'Mate o Rei Trovão nos Salões Trovejantes e pegue o Coração do Rei Trovão. Uma‡Убейте Властелина Грома и заберите сердце Властелина Грома. это‡Tötet den Donnerkönig in den Hallen des Donners und nehmt sein Herz an Euch.‡폭풍의 첨탑에 있는 천둥왕을 처치하고 천둥왕의 심장을 손에 넣어야 합니다. 레벨 35‡Mata al Rey del Trueno en las Cámaras del Trueno y recoge el corazón del Rey del Trueno.‡‡Tuez le Roi-tonnerre dans les Salles du Tonnerre et récupérez le Cœur du roi-tonnerre.‡在雷电王座内殿里消灭雷电之王，并取得雷神之核。‡',
  }
},
[32598] = {
  {
    'Um ajuste de contas‡Расплата‡Eine Abrechnung‡징벌‡Un reconocimiento‡‡Un jugement‡清算‡',
    nil,
    'Fale com Wrathion no andar de cima, na Taberna nas Nuvens, que fica na Escadaria Oculta. Uma‡Поговорите с Гневионом на верхнем этаже таверны "В туманах" на Сокрытой лестнице.‡Sprecht mit Furorion im oberen Stock der Taverne im Nebel an der Verhüllten Treppe.‡장막의 계단, 안개 속의 주점 2층에 있는 래시온과 대화해야 합니다. 레벨 35‡Habla con Wrathion en el piso de arriba de la Taberna en la Niebla, en la Escalera Velada.‡‡Parlez à Irion à l’étage de la Taverne dans les Brumes, à l’Escalier Dérobé.‡在雾纱栈道的迷雾酒肆楼上与拉希奥交谈。‡',
  }
},
[32599] = {
  {
    'Garantindo um futuro‡Защита будущего‡Zukunftssicherung‡미래 확보하기‡Un futuro seguro‡‡Assurer l’avenir‡开创未来‡',
    nil,
    'Derrote o Rei Trovão no Pináculo das Tempestades e use o Cajado de Antônidas para drenar o restante do poder da tribuna. Uma‡Уничтожьте Властелина Грома на Вершине Бурь и используйте посох Антонидаса, чтобы вытянуть остаточную силу из его помоста.‡Besiegt den Donnerkönig in der Spitze der Stürme und benutzt Antonidas\' Stab, um seiner Estrade die restliche Macht zu entziehen.‡폭풍의 첨탑에서 천둥왕을 쓰러뜨리고 안토니다스의 지팡이를 사용해 그의 연단에서 남은 힘을 흡수해야 합니다.‡Derrota al Rey del Trueno en el Pináculo de las Tormentas y usa el bastón de Antonidas para drenar el poder que le queda de su estrado. Un(a) misión.‡‡Terrassez le Roi-tonnerre à la Cime des Tempêtes, et utilisez le Bâton d’Antonidas pour drainer le reste de sa puissance de son estrade.‡在风暴之巅击败雷电之王，然后用安东尼达斯之杖从他的平台中汲取剩余力量。‡',
  }
},
[32600] = {
  {
    'A profecia zandalari‡Пророчество зандаларов‡Die Zandalariprophezeiung‡잔달라의 예언‡La profecía Zandalari‡‡La prophétie zandalari‡赞达拉预言书‡',
    nil,
    'Leve a Profecia Zandalari para o Andarilho das Lendas Cho. Uma‡Принесите хранителю истории Чо книгу "Пророчество Зандаларов".‡Bringt "Die Zandalariprophezeiung" zu Lehrensucher Cho.‡전승지기 초에게 잔달라의 예언을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva la profecía Zandalari al eremita Cho.‡‡Apportez La prophétie zandalari au Chroniqueur Cho.‡将赞达拉预言书带给游学者周卓。‡',
  }
},
[32601] = {
  {
    'Ribombar do Trovão‡Раскаты грома‡Donnergrollen‡우르릉거리는 천둥‡Rumores de tormenta‡‡Le roulement du tonnerre‡雷电轰鸣‡',
    nil,
    'Leve o Ribombar do Trovão para o Andarilho das Lendas Cho. Uma‡Принесите хранителю истории Чо книгу "Раскаты грома".‡Bringt "Donnergrollen" zu Lehrensucher Cho.‡전승지기 초에게 우르릉거리는 천둥을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva los rumores de tormenta al eremita Cho.‡‡Apportez Le roulement du tonnerre au Chroniqueur Cho.‡将雷电轰鸣带给游学者周卓。‡',
  }
},
[32602] = {
  {
    'Deuses e monstros‡Боги и монстры‡Götter und Monster‡신과 괴물‡Dioses y monstruos‡‡Des dieux et des monstres‡神祗与妖魔‡',
    nil,
    'Leve Deuses e Monstros para o Andarilho das Lendas Cho. Uma‡Принесите хранителю истории Чо книгу "Боги и монстры".‡Bringt "Götter und Monster" zu Lehrensucher Cho.‡전승지기 초에게 신과 괴물을 가져가야 합니다. 레벨 30 영원꽃 골짜기‡Lleva Dioses y monstruos al eremita Cho.‡‡Apportez Des dieux et des monstres au Chroniqueur Cho.‡将神祗与妖魔带给游学者周卓。‡',
  }
},
[32603] = {
  {
    'Feras das fábulas‡Звери из легенд‡Fabelhafte Wesen‡전설의 야수‡Las bestias de las fábulas‡‡Créatures des mythes et légendes‡寓言之兽‡',
    nil,
    'Derrote as Mascotes de Batalha de Elite das fábulas pandarênicas. Uma‡Победите элитных боевых питомцев из легенд пандаренов. это‡Besiegt die Elite-Kampfhaustiere der pandarischen Fabelwelt.‡판다렌 전설에 등장하는 정예 전투 애완동물을 꺾어야 합니다. 레벨 1‡Derrota a las mascotas de duelo de élite de las fábulas pandaren.‡‡Gagnez un combat contre les Mascottes d’élite des fables pandarènes.‡击败熊猫人寓言中的精英战宠。‡',
  }
},
[32604] = {
  {
    'Feras das fábulas – Livro I‡Звери из легенд, книга I‡Fabelhafte Wesen, Buch I‡전설의 야수 1권‡Las bestias de las fábulas I‡‡Créatures des mythes et légendes : volume I‡《寓言之兽》第一册‡',
    nil,
    'Derrotar Ka\'wi, o Triturador, Nitun, Kafi e Dos-Ryga. Uma‡Победите Ка\'ви Проглота, Нитуна, Кафи и Дос-Ригара. это‡Besiegt Ka\'wi den Schlinger, Nitun, Kafi und Dos-Ryga.‡먹보 카위, 니툰, 카피, 그리고 도스리가를 꺾어야 합니다. 레벨 1‡Derrota a Ka\'wi el Engullidor, a Nitun, a Kafi y a Dos-Ryga.‡‡Gagnez un combat contre Ka’wi le Goinfre, Nitun, Kafi et Dos-Ryga.‡击败贪吃的卡瓦、尼顿、咖菲和多斯里加。‡',
  }
},
[32605] = {
  {
    'Encorajamento sutil‡Небольшой стимул‡Subtile Anregung‡작은 자극‡Un estímulo sutil‡‡Subtil encouragement‡微妙的鼓励‡',
    nil,
    'Plante Armas Mogus nos corpos de 9 sauroks Gumeskuma. Uma‡Вонзите оружие могу в трупы 9 сауроков Гнилого Клинка.‡Stoßt Moguwaffen in die Leichen von 9 Saurok der Skumklingen.‡부랑칼날 사우록의 시체 9구에 모구 무기를 꽂아야 합니다. 레벨 32 천둥의 섬‡Clava las armas mogu en los cadáveres de 9 saurok Hojaescoria.‡‡Plantez des Armes mogu dans les cadavres de 9 Sauroks crasselames.‡将魔古武器插在9个邪刃蜥蜴人的尸体附近。‡',
  }
},
[32606] = {
  {
    'Encorajamento sutil‡Небольшой стимул‡Subtile Anregung‡작은 자극‡Un estímulo sutil‡‡Subtil encouragement‡微妙的鼓励‡',
    nil,
    'Plante Armas Mogus nos corpos de 9 sauroks Gumeskuma. Uma‡Вонзите оружие могу в трупы 9 сауроков Гнилого Клинка.‡Stoßt Moguwaffen in die Leichen von 9 Saurok der Skumklingen.‡부랑칼날 사우록의 시체 9구에 모구 무기를 꽂아야 합니다. 레벨 32 천둥의 섬‡Clava las armas mogu en los cadáveres de 9 saurok Hojaescoria.‡‡Plantez des Armes mogu dans les cadavres de 9 Sauroks crasselames.‡将魔古武器插在9个邪刃蜥蜴人的尸体附近。‡',
  }
},
[32607] = {
  {
    'Licença prolongada‡Увольнение на берег... надолго‡Ausgedehnter Landgang‡연기된 상륙 허가‡Permiso para bajar a tierra extendido‡‡Permission à terre prolongée‡延长登岸假‡',
    nil,
    'Roube o Relatório da Oficina e mate o novo capitão do navio de guerra Zandalari. Uma‡Украдите ремонтные инструкции и убейте нового капитана зандаларского боевого корабля.‡Stehlt die Werkstattsaufträge und tötet den neuen Kapitän des Kriegsschiffes der Zandalari.‡작업장 피해 보고서를 훔치고 잔달라 함선의 신임 선장을 처치해야 합니다. 레벨 32 천둥의 섬‡Roba los pedidos de taller y mata al nuevo capitán del buque de guerra Zandalari.‡‡Volez les Ordres de réparation et tuez le nouveau capitaine du navire de guerre des Zandalari.‡偷取工坊报告，并消灭赞达拉战船的新船长。‡',
  }
},
[32608] = {
  {
    'Saqueando o Salão‡Набег на хранилище‡Die Kammer plündern‡금고 침투‡Saquear la cámara‡‡Piller le caveau‡突袭宝库‡',
    nil,
    'Roube a Gargantilha das Tormentas no Salão Abaulado. Uma‡Отправляйтесь в Древнее хранилище и раздобудьте амулет "Колье Грома".‡Stehlt das Halsband der Stürme aus der Prall Gefüllten Kammer.‡축축한 금고에서 폭풍의 목장식을 훔쳐야 합니다. 레벨 32 천둥의 섬‡Roba la gargantilla de tormentas de La Cripta Solemne.‡‡Récupérez le Sautoir des tempêtes au Caveau démesuré.‡从浮华宝库里偷取风暴项圈。‡',
  }
},
[32609] = {
  {
    'Listagem de Missão do Baú Raro‡Задание: обнаружить редкий сундук‡Seltene Truhe, Tracking-Quest‡희귀 궤짝 추적 퀘스트‡Misión de rastreo de cofre poco común‡‡Rare Chest Tracking Quest‡Rare Chest Tracking Quest‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32610] = {
  {
    'Listagem de Missão de Chefe Raro‡Задание на поиск редкого босса‡Seltener Boss, Tracking-Quest‡희귀 우두머리 추적 퀘스트‡Misión de rastreo de jefe poco común‡‡Rare Boss Tracking Quest‡Rare Boss Tracking Quest‡',
    nil,
    'Ilha do Trovão de‡‡‡천둥의 섬‡‡‡‡‡',
  }
},
[32611] = {
  {
    'Listagem de Missão de Saque Raro‡Задание на поиск редкой добычи‡Seltener Drop, Tracking-Quest‡희귀 아이템 추적 퀘스트‡Misión de rastreo de botín poco común‡‡Rare Drop Tracking Quest‡Rare Drop Tracking Quest‡',
    nil,
    'Ilha do Trovão de‡‡‡천둥의 섬‡‡‡‡‡',
  }
},
[32613] = {
  {
    'Osso de Dinossauro Gigante‡Огромная кость динозавра‡Riesiger Dinosaurierknochen‡거대 공룡 뼈‡Hueso de dinosaurio gigante‡‡Des os de dinosaure géant‡巨型恐龙骨头‡',
    nil,
    'O que você traz para Ku\'ma? Uma‡Что у тебя есть для Ку\'мы?‡Was habt Ihr für Ku\'ma?‡레벨 35 괴수의 섬‡¿Qué le traes a Ku\'ma?‡‡Qu’apportez-vous à Ku’ma ?‡你给库玛带什么来了？‡',
  }
},
[32614] = {
  {
    'Mais Ossos de Dinossauro Gigantes‡Еще больше огромных костей динозавра‡Mehr riesige Dinosaurierknochen‡거대 공룡 뼈 추가 수집‡Más huesos de dinosaurio gigantes‡‡Davantage d’os de dinosaure géant‡更多的巨型恐龙骨头‡',
    nil,
    'Me dá! Me dá todos! Uma‡Дай! Дай их мне!‡Gebt sie her! Gebt sie mir!‡레벨 35 괴수의 섬‡¡Dámelos! ¡Dámelos ya!‡‡Donnez-les ! Donnez-les-moi !‡给我！快给我！‡',
  }
},
[32615] = {
  {
    'Muitos Ossos Gigantes a Mais‡Намного больше огромных костей динозавра‡Noch mehr riesige Dinosaurierknochen‡거대 공룡 뼈 대량 수집‡Muchos más huesos de dinosaurio gigantes‡‡Encore plus d’os de dinosaure géant‡超多的巨型恐龙骨头‡',
    nil,
    'Quem é você? Por que você voltou? Hehehe... Uma‡Кто ты? Зачем ты здесь снова? Хе-хе-хе...‡Wer seid Ihr? Warum seid Ihr zurück? Hihihi….‡레벨 35 괴수의 섬‡¿Quién eres tú? ¿Por qué has vuelto? Je, je, je...‡‡Qui êtes-vous ? Pourquoi vous revenez ? Hé hé hé….‡你是谁？你为什么又回来了？呵呵呵……‡',
  }
},
[32618] = {
  {
    'Aprender a montar‡Уроки верховой езды‡Lernt Reiten‡타는 법 배우기‡A montar se ha dicho‡‡Un cavalier débutant‡学习骑乘‡',
    nil,
    'Encontre Randal Caçador. Uma‡Найдите Рандала Охотника. это‡Findet Randal Weidmann.‡랜들 헌터를 찾아야 합니다. 레벨 10‡Encuentra a Randal Predatio.‡‡Trouvez Randal Hunter.‡找到兰达尔·亨特。‡',
  }
},
[32621] = {
  {
    'Aço Relâmpago‡Молниеносная сталь‡Donnerstahl‡번개 강철‡Acero del relámpago‡‡Le foudracier‡霹雳钢‡',
    nil,
    'Investigue a Forja do Trovão para encontrar os Segredos do Aço Relâmpago. Uma‡Исследуйте Кузню Грома, чтобы найти "Секреты молниеносной стали".‡Erkundet die Donnerschmiede, um die Geheimnisse des Donnerstahls zu erfahren.‡천둥 제련소를 조사해 번개 강철의 비밀을 찾아야 합니다. 레벨 32 천둥의 섬‡Investiga la Forja del Trueno para encontrar los secretos del acero del relámpago.‡‡Fouillez les Forges du tonnerre afin de trouver les Secrets du foudracier.‡调查雷霆熔炉，找到霹雳钢的奥秘。‡',
  }
},
[32622] = {
  {
    'Voo introdutório‡Вводный полет‡Introflug‡도입 비행‡Intro del vuelo‡‡Vol d’intro‡飞行介绍‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32626] = {
  {
    'Listagem de Missão Chave Sala Saque‡Задание на поиск ключа от комнаты с добычей‡Loot Room Key Tracking Quest‡전리품 방 열쇠 추적 퀘스트‡Loot Room Key Tracking Quest‡‡Loot Room Key Tracking Quest‡Loot Room Key Tracking Quest‡',
    nil,
    'Ilha do Trovão de‡‡‡천둥의 섬‡‡‡‡‡',
  }
},
[32627] = {
  {
    'Moganita Carregada‡Заряженный моганит‡Aufgeladenes Moganit‡충전된 모가나이트‡Moganita cargada‡‡La moganite chargée‡充能绿柱石‡',
    nil,
    'Recupere uma Moganita Carregada e leve-a ao Mago-de-guerra Yurias. Uma‡Найдите заряженный моганит и принесите его боевому магу Юриасу.‡Beschafft ein Stück aufgeladenes Moganit und bringt es zu Kriegsmagier Yurias.‡충전된 모가나이트를 되찾아 전쟁마법사 유리아스에게 가져가야 합니다. 레벨 32 천둥의 섬‡Recupera una moganita cargada y llévasela al mago de guerra Yurias.‡‡Récupérez de la Moganite chargée et rapportez-la au Mage de guerre Yurias.‡找到一块充能绿柱石，并将它带给战斗法师尤里亚斯。‡',
  }
},
[32628] = {
  {
    'Bombas Táticas de Mana‡Тактические мана-бомбы‡Taktische Manabomben‡전술 마나 폭탄‡Explota, explota, me expló...‡‡Bombes de mana tactiques‡战术魔法炸弹‡',
    nil,
    'Plante uma Bomba Tática de Mana em um navio Fendessol, nos Cristais de Vidência e na ponte mais para o interior do Promontório Buscalva. Um(a) missão.‡Установите тактическую мана-бомбу на корабле Похитителей Солнца, у кристаллов ясновидения и на самом внутреннем мосту мыса Искателя Рассвета.‡Bringt jeweils eine taktische Manabombe an einem Schiff der Sonnenhäscher, an den Seherkristallen und an der Brücke, die am weitesten im Inneren des Morgensucherkaps liegt, an.‡전술 마나 폭탄을 선리버 선박, 수정구슬, 그리고 돈시커 곶의 내륙쪽 교각에 설치해야 합니다. 레벨 32 천둥의 섬‡Coloca una bomba de maná táctica en un barco de los Atracasol, en los cristales de visión y en el puente más interior del Promontorio Buscalba.‡‡Posez une Bombe de mana tactique sur un Navire saccage-soleil, une autre sur les Cristaux de divination, et une dernière sur le pont le plus à l’intérieur du Promontoire de Cherchelaube.‡在一艘夺日者舰船上、占卜水晶和寻晨者海角最靠近内陆的桥梁上各放置一枚战术魔法炸弹。‡',
  }
},
[32629] = {
  {
    'Listagem de Missão Trovoasa Capturado‡Задание на поиск пойманного Громокрыла‡Thunderwing Captured Tracking Quest‡천둥날개 포획 추적 퀘스트‡Thunderwing Captured Tracking Quest‡‡Thunderwing Captured Tracking Quest‡Thunderwing Captured Tracking Quest‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32630] = {
  {
    'Diário do Engenheiro-chefe Jard‡Дневник главного инженера Цзарда‡Chefingenieur Jards Tagebuch‡선임기술자 자르드의 일지‡Diario del ingeniero jefe Jard‡‡Le journal de l’ingénieur en chef Jard‡首席工程师贾德的日记‡',
    nil,
    'Investigue as Forjas do Trovão para encontrar os Segredos do Relâmpago Estabilizado. Uma‡Исследуйте Кузню Грома, чтобы найти "Секреты стабилизированных молний". задание.‡Erkundet die Donnerschmiede, um die Geheimnisse des stabilisierten Blitzes zu erfahren.‡천둥 제련소를 조사해 안정된 번개의 비밀을 찾아야 합니다. 레벨 32 천둥의 섬‡Investiga las Forjas del Trueno para encontrar los secretos del relámpago estabilizado.‡‡Fouillez les Forges du tonnerre afin de trouver les Secrets de la foudre stabilisée.‡调查雷霆熔炉，找到固化闪电的秘诀。‡',
  }
},
[32631] = {
  {
    'Alto Reconhecimento‡Признание и почет‡Große Anerkennung‡표창‡Alta estima‡‡Grande reconnaissance‡高度评价‡',
    nil,
    'Sua presença no campo de batalha não pode ser ignorada. Eu quero lhe dar mais uma coisa pelos seus esforços, &lt;class&gt;. Uma‡Твои успехи на поле боя нельзя оставить без внимания. Мне хотелось бы наградить тебя за старания, |3-6(Паладин).‡Eure Präsenz auf dem Schlachtfeld ist nicht zu leugnen. Ich möchte Euch dies als zusätzliche Anerkennung für Eure Leistungen überreichen, &lt;Klasse&gt;.‡레벨 32 천둥의 섬‡No se puede pasar por alto tu presencia en el campo de batalla. Quiero darte algo extra por tus esfuerzos, &lt;clase&gt;.‡‡Il est impossible de ne pas remarquer votre présence sur le champ de bataille. J’aimerais vous donner un petit supplément pour vos efforts, &lt;classe&gt;.‡‡',
  }
},
[32632] = {
  {
    'Feito para a guerra‡Создан для войны‡Für den Krieg geschaffen‡전쟁을 위해 만들어진‡Hecho para la guerra‡‡Conçu pour la guerre‡为战斗而生‡',
    nil,
    'Mate o Demolidor Flamestela. Uma‡Уничтожьте разрушитель "Погребальный огонь".‡Tötet den Pyrosternvernichter.‡장작별 파괴자를 처치해야 합니다. 레벨 32 천둥의 섬‡Mata al demoledor Pirastral.‡‡Tuez le Démolisseur ignétoile.‡击败葬火之星歼灭者。‡',
  }
},
[32633] = {
  {
    'Enfeitiçado‡Зачарованная книга‡Bezaubernd‡마법으로 장정된 책‡Encantado‡‡Sous le charme‡魔法束缚‡',
    nil,
    'Recupere o Livro de Encantamentos de Rommath no Promontório Buscalva. Uma‡Заберите книгу магических формул Роммата с мыса Искателя Рассвета.‡Beschafft Euch Rommaths Buch der Zaubersprüche am Morgensucherkap.‡돈시커 곶에서 롬매스의 마법서를 손에 넣어야 합니다. 레벨 32 천둥의 섬‡Recupera el libro de conjuros de Rommath del Promontorio Buscalba.‡‡Récupérez le Livre d’incantations de Rommath au Promontoire de Cherchelaube.‡从寻晨者海角找回罗曼斯的咒术之书。‡',
  }
},
[32634] = {
  {
    'Derrubando as defesas‡Вывести защиту из строя‡Die Verteidigung zerstören‡방어 무너뜨리기‡Rompiendo las defensas‡‡Briser les défenses‡粉碎防御‡',
    nil,
    'Destrua 6 Proteções do Perímetro Fendessol perto do Promontório Buscalva. Uma‡Уничтожьте 6 защитных кристаллов Похитителей Солнца на мысе Искателя Рассвета.‡Zerstört 6 Schutzzauber der Sonnenhäscher am Morgensucherkap.‡돈시커 곶 주변에 있는 선리버 구역 수호물을 6개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 6 resguardos de perímetro Atracasol cerca del Promontorio Buscalba.‡‡Détruisez 6 Garde-périmètre saccage-soleil autour du Promontoire de Cherchelaube.‡在寻晨者海角附近摧毁6个夺日者监视结界。‡',
  }
},
[32635] = {
  {
    'Chega de bombas, pombas!‡Хватит бомб!‡Jetzt reichts aber mit den Bomben!‡폭탄은 지긋지긋해!‡¡Ya vale con las bombas!‡‡Ça suffit avec ces bombes !‡终止爆炸！‡',
    nil,
    'Desarme as Bombas Táticas de Mana nos Navios da Aliança, no Ritual do Constructo e nos Suprimentos do Pico Violeta. Uma‡Обезвредьте тактические мана-бомбы, установленные на кораблях Альянса, а также около припасов на Аметистовом утесе и рядом с местом проведения ритуала возведения.‡Entschärft die taktischen Manabomben bei den Allianzschiffen, dem Konstruktritual und den Vorräten auf der Violetten Erhebung.‡보랏빛 마루 안의 얼라이언스 함선, 피조물 생성소, 보급품 화물에 설치된 전술 마나 폭탄을 해제해야 합니다.‡Desarma las bombas de maná tácticas en los barcos de la alianza, el ritual de ensamblaje y los suministros en el Alto Violeta.‡‡Désamorcez les Bombes de mana tactiques sur les Vaisseaux de l’Alliance, le Rituel d’assemblage et les Fournitures qui se trouvent sur la Cime Pourpre.‡在紫罗兰高地卸除联盟舰船、构造体仪式和补给品附近的战术魔法炸弹。‡',
  }
},
[32636] = {
  {
    'Audiência cativa‡Возвращение пленников‡Gefesseltes Publikum‡포로 접견‡Público entregado‡‡Entretien forcé‡不情愿的观众‡',
    nil,
    'Liberte 5 Cativos do Kirin Tor perto do Promontório Buscalva. Uma‡Освободите 5 пленников из Кирин-Тора, удерживаемых в окрестностях мыса Искателя Рассвета.‡Befreit 5 gefangene Kirin Tor am Morgensucherkap.‡돈시커 곶 근처에서 키린 토 포로를 5명 구출해야 합니다. 레벨 32 천둥의 섬‡Libera a 5 miembros del Kirin Tor cautivos cerca del Promontorio Buscalba.‡‡Libérez 5 Captifs du Kirin Tor près du Promontoire de Cherchelaube.‡在寻晨者海角附近解救5名肯瑞托俘虏。‡',
  }
},
[32637] = {
  {
    'Subjugados‡Перегрузка‡Viel zu stark‡과부하‡Subyugado‡‡Surpuissance‡超强能量‡',
    nil,
    'Destrua 7 Coletores de Mana Fendessol perto do Promontório Buscalva. Uma‡Уничтожьте 7 сборников маны Похитителей Солнца на мысе Искателя Рассвета. задание.‡Zerstört 7 Manasammler der Sonnenhäscher am Morgensucherkap.‡돈시커 곶 주변에 있는 선리버 마나 수집기를 7개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 7 colectores de maná Atracasol cerca del Promontorio Buscalba.‡‡Détruisez 7 Collecteurs de mana saccage-soleil près du Promontoire de Cherchelaube.‡在寻晨者海角附近摧毁7个夺日者法力收集器。‡',
  }
},
[32638] = {
  {
    'Catadores de mana‡Пожиратели маны‡Manadiebe‡마나의 청소부‡Carroñeros de maná‡‡Les pilleurs de mana‡魔法清道夫‡',
    nil,
    'Mate 9 Moreias de Mana Fendessol. Uma‡Убейте 9 маназмеев Похитителей Солнца.‡Tötet 9 Manawyrms der Sonnenhäscher.‡선리버 마나 지룡을 9마리 처치해야 합니다. 레벨 32 천둥의 섬‡Mata a 9 vermis de maná Atracasol.‡‡Tuez 9 Wyrms de mana saccage-soleil.‡消灭9只夺日者法力浮龙。‡',
  }
},
[32639] = {
  {
    'Desconstrução‡Уничтожение големов‡De-Konstruktion‡해체 작업‡Deconstrucción‡‡Déconstruction‡解体‡',
    nil,
    'Destrua 3 Constructos Fendessol perto do Promontório Buscalva. Uma‡Уничтожьте 3 голема Похитителей Солнца возле мыса Искателя Рассвета.‡Zerstört 3 Konstrukte der Sonnenhäscher vor dem Morgensucherkap.‡돈시커 곶 외곽에 있는 선리버 피조물을 3개 파괴해야 합니다. 레벨 32 천둥의 섬‡Destruye 3 ensamblajes Atracasol fuera del Promontorio Buscalba.‡‡Détruisez 3 Assemblages saccage-soleil à l’extérieur du Promontoire de Cherchelaube.‡在寻晨者海角外摧毁3个夺日者构造体。‡',
  }
},
[32640] = {
  {
    'Campeões do Rei Trovão‡Лучшие бойцы Властелина Грома‡Champions des Donnerkönigs‡천둥왕의 용사들‡Los campeones del Rey del Trueno‡‡Les champions du roi-tonnerre‡雷电之王的勇士‡',
    nil,
    'Use as Pedras Rituais de Shan\'ze para realizar o Ritual do Relâmpago, o Ritual dos Espíritos e o Ritual Primevo em vários pontos da Ilha do Trovão, e depois derrote os poderosos oponentes que serão evocados.‡Используйте ритуальные камни Шань\'цзэ, чтобы провести ритуал молний, ритуал духов и первобытный ритуал в разных частях острова Грома. Затем одержите победу над противниками, которые появятся после ритуала призыва.‡Findet Ritualsteine der Shan\'ze, um das Blitzritual, das Geisterritual und das Urzeitliche Ritual an verschiedenen Orten auf der Insel des Donners durchzuführen und besiegt dann die beschworenen mächtigen Gegner.‡샨쩌 의식용 돌을 사용해 천둥의 섬 각지에서 번개 의식, 영혼 의식, 원시 의식을 거행하고, 소환되는 강력한 적을 처치해야 합니다.‡Usa las piedras de ritual de Shan\'ze para realizar el ritual del relámpago, el ritual del espíritu y el ritual primigenio en diversos lugares de la Isla del Trueno y, a continuación, derrota a los poderosos adversarios que has invocado.‡‡Utilisez les Pierres rituelles shan’ze pour accomplir le Rituel de la foudre, le Rituel de l’esprit et le Rituel primordial en différents endroits de l’Île du Tonnerre, puis terrassez les puissants adversaires invoqués.‡在雷神岛的各个位置使用山泽仪式石举行闪电仪式、灵魂仪式和原始仪式，然后击败被召唤出的强大对手。‡',
  }
},
[32641] = {
  {
    'Campeões do Rei Trovão‡Лучшие бойцы Властелина Грома‡Champions des Donnerkönigs‡천둥왕의 용사들‡Los campeones del Rey del Trueno‡‡Les champions du roi-tonnerre‡雷电之王的勇士‡',
    nil,
    'Use as Pedras Rituais de Shan\'ze para realizar o Ritual do Relâmpago, o Ritual dos Espíritos e o Ritual Primevo em vários pontos da Ilha do Trovão, e depois derrote os poderosos oponentes que serão evocados.‡Используйте ритуальные камни Шань\'цзэ, чтобы провести ритуал молний, ритуал духов и первобытный ритуал в разных частях острова Грома. Затем одержите победу над противниками, которые появятся после ритуала призыва.‡Findet Ritualsteine der Shan\'ze, um das Blitzritual, das Geisterritual und das Urzeitliche Ritual an verschiedenen Orten auf der Insel des Donners durchzuführen und besiegt dann die beschworenen mächtigen Gegner.‡샨쩌 의식용 돌을 사용해 천둥의 섬 각지에서 번개 의식, 영혼 의식, 원시 의식을 거행하고, 소환되는 강력한 적을 처치해야 합니다.‡Usa las piedras de ritual de Shan\'ze para realizar el ritual del relámpago, el ritual del espíritu y el ritual primigenio en diversos lugares de la Isla del Trueno y, a continuación, derrota a los poderosos adversarios que has invocado.‡‡Utilisez les Pierres rituelles shan’ze pour accomplir le Rituel de la foudre, le Rituel de l’esprit et le Rituel primordial en différents endroits de l’Île du Tonnerre, puis terrassez les puissants adversaires invoqués.‡在雷神岛的各个位置使用山泽仪式石举行闪电仪式、灵魂仪式和原始仪式，然后击败被召唤出的强大对手。‡',
  }
},
[32642] = {
  {
    'Ordem de Serviço: Ofensiva de Dominância I‡Заказ: Армия Покорителей I‡Arbeitsauftrag: Herrschaftsoffensive I‡주문서: 지배령 선봉대 I‡Pedido de la Ofensiva de Dominancia I‡‡Commande : offensive Domination I‡产品订单：统御先锋军I‡',
    nil,
    'Plante 8 Sementes de Alho-poró de Florada Vermelha na Fazenda Sol Cantante. Uma‡Посадите 8 семян красного лука-порея на ферме Солнечной Песни.‡Pflanzt 8 Rotblütenlauchsamen auf dem Gehöft Sonnensang.‡태양노래 농장에 붉은꽃 부추 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de puerro Rojaflor en el Rancho Cantosol.‡‡Plantez 8 Graines de poireau à fleur rouge à la Ferme Chant du Soleil.‡在日歌农场播种8颗红韭花种子。‡',
  }
},
[32643] = {
  {
    'Ordem de Serviço: Ofensiva de Dominância II‡Заказ: Армия Покорителей II‡Arbeitsauftrag: Herrschaftsoffensive II‡주문서: 지배령 선봉대 II‡Pedido de la Ofensiva de Dominancia II‡‡Commande : offensive Domination II‡产品订单：统御先锋军II‡',
    nil,
    'Colha 8 pés de Alho-poró de Florada Vermelha Maduro e forneça 40 Alhos-porós de Florada Vermelha à Ofensiva de Dominância. Uma‡Соберите урожай с 8 растений красного лука-порея и упакуйте 40 единиц красного лука порея для Армии Покорителей.‡Erntet 8 reife Rotblütenlauchpflanzen und liefert 40 Rotblütenlauchstangen an die Herrschaftsoffensive.‡잘 익은 붉은꽃 부추를 8개 수확한 후 지배령 선봉대에 붉은꽃 부추를 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de puerro Rojaflor maduras y consigue 40 puerros Rojaflor para la Ofensiva de Dominancia.‡‡Récoltez 8 plants de Poireaux à fleur rouge mûrs et fournissez 40 Poireaux à fleur rouge pour l’Offensive Domination.‡收获8个成熟的红韭花，并向统御先锋军提供40份红韭花。‡',
  }
},
[32644] = {
  {
    'O ataque a Shaol\'mara‡Атака на Шаол\'мару‡Der Angriff auf Shaol\'mara‡샤올마라 강습‡El Asalto a Shaol\'mara‡‡L’assaut sur Shaol’mara‡突袭绍尔马拉‡',
    nil,
    'Complete o Ataque a Shaol\'mara. Fale com Jaina Proudmore para iniciar o ataque. Uma‡Завершите сценарий "Атака на Шаол\'мару". Поговорите с Джайной Праудмур, чтобы начать атаку.‡Schließt den Angriff auf Shaol\'mara ab. Sprecht mit Jaina Prachtmeer, um den Angriff zu beginnen.‡샤올마라 강습 작전을 완수해야 합니다. 제이나 프라우드무어와 대화하여 작전을 시작할 수 있습니다.‡Completa el Asalto a Shaol\'mara. Habla con Jaina Valiente para iniciar el ataque.‡‡Terminez l’Assaut sur Shaol’mara. Parlez à Jaina Portvaillant pour commencer l’attaque.‡完成突袭绍尔马拉。与吉安娜·普罗德摩尔交谈从而开始进攻。‡',
  }
},
[32645] = {
  {
    'Ordem de Serviço: Operação: Muralha de Escudos I‡Заказ: операция "Заслон" I‡Arbeitsauftrag: Operation Schildwall I‡주문서: 철벽방패 작전대 I‡Pedido de la Operación: Muro de escudos I‡‡Commande : opération Bouclier I‡产品订单：神盾守备军I‡',
    nil,
    'Plante 8 Sementes de Uva-de-bruxa na Fazenda Sol Cantante. Uma‡Посадите 8 семян ведьминых ягод на ферме Солнечной Песни.‡Pflanzt 8 Hexenbeerensamen auf dem Gehöft Sonnensang.‡태양노래 농장에 요술딸기 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de moruja en el Rancho Cantosol.‡‡Plantez 8 Graines de sorcielle à la Ferme Chant du Soleil.‡在日歌农场播种8颗女巫浆果种子。‡',
  }
},
[32646] = {
  {
    'Ordem de Serviço: Operação: Muralha de Escudos II‡Заказ: операция "Заслон" II‡Arbeitsauftrag: Operation Schildwall II‡주문서: 철벽방패 작전대 II‡Pedido de la Operación: Muro de escudos II‡‡Commande : opération Bouclier II‡产品订单：神盾守备军II‡',
    nil,
    'Colha 8 pés de Uvas-de-bruxa Maduras e forneça 40 Uvas-de-bruxa para a Operação: Muralha de Escudos. Uma‡Соберите урожай с 8 кустов ведьминых ягод и передайте 40 ведьминых ягод операции "Заслон".‡Erntet 8 reife Hexenbeerenpflanzen und liefert 40 Hexenbeeren an Operation Schildwall.‡잘 익은 요술딸기를 8개 수확한 후 철벽방패 작전대에 요술딸기를 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de moruja maduras y consigue 40 morujas para la Operación: Muro de escudos.‡‡Récoltez 8 plants de Sorcielles mûres et fournissez 40 Sorcielles pour l’Opération Bouclier.‡收获8个成熟的女巫浆果，并向神盾守备军提供40份女巫浆果。‡',
  }
},
[32647] = {
  {
    'Ordem de Serviço: Lótus Dourado I‡Заказ: Золотой Лотос I‡Arbeitsauftrag: Goldener Lotus I‡주문서: 황금 연꽃 I‡Pedido del Loto Dorado I‡‡Commande : Lotus doré I‡产品订单：金莲教I‡',
    nil,
    'Plante 8 Sementes de Nabo Branco na Fazenda Sol Cantante. Uma‡Посадите 8 семян белой репы на ферме Солнечной Песни.‡Pflanzt 8 weiße Rübensamen auf dem Gehöft Sonnensang.‡태양노래 농장에 하얀색 순무 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de naba blanca en el Rancho Cantosol.‡‡Plantez 8 Graines de navet blanc à la Ferme Chant du Soleil.‡在日歌农场播种8颗白色芜菁种子。‡',
  }
},
[32648] = {
  {
    'Ordem de Serviço: Lótus Dourado II‡Заказ: Золотой Лотос II‡Arbeitsauftrag: Goldener Lotus II‡주문서: 황금 연꽃 II‡Pedido del Loto Dorado II‡‡Commande : Lotus doré II‡产品订单：金莲教II‡',
    nil,
    'Colha 8 pés de Nabo Branco Maduro e forneça 40 Nabos Brancos para o Lótus Dourado. Uma‡Соберите 8 спелых белых реп и приготовьте 40 белых реп для Золотого Лотоса. задание.‡Erntet 8 reife Rübenpflanzen und liefert 40 weiße Rüben an den Goldenen Lotus.‡잘 익은 하얀색 순무를 8개 수확한 후 황금 연꽃에 하얀색 순무를 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de naba blanca maduras y consigue 40 nabas blancas para el Loto Dorado.‡‡Récoltez 8 plants de Navets blancs mûrs et fournissez 40 Navets blancs au Lotus doré.‡收获8个成熟的白色芜菁，并向金莲教提供40份白色芜菁。‡',
  }
},
[32649] = {
  {
    'Ordem de Serviço: Os Shado-Pan I‡Заказ: Шадо-Пан I‡Arbeitsauftrag: Shado-Pan I‡주문서: 음영파 I‡Pedido del Shadopan I‡‡Commande : Pandashan I‡产品订单：影踪派I‡',
    nil,
    'Plante 8 Sementes de Repolho Verde na Fazenda Sol Cantante. Uma‡Посадите 8 семян белокочанной капусты на ферме Солнечной Песни.‡Pflanzt 8 Grünkohlsamen auf dem Gehöft Sonnensang.‡태양노래 농장에 녹색 양배추 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de repollo verde en el Rancho Cantosol.‡‡Plantez 8 Graines de chou vert à la Ferme Chant du Soleil.‡在日歌农场播种8颗绿色卷心菜种子。‡',
  }
},
[32650] = {
  {
    'Ordem de Serviço: Os Shado-Pan II‡Заказ: Шадо-Пан II‡Arbeitsauftrag: Shado-Pan II‡주문서: 음영파 II‡Pedido del Shadopan II‡‡Commande : Pandashan II‡产品订单：影踪派II‡',
    nil,
    'Colha 8 pés de Repolho Verde Maduro e forneça 40 Repolhos Verdes para os Shado-Pan. Uma‡Соберите урожай с 8 участков белокочанной капусты и приготовьте 40 кочанов белокочанной капусты для Шадо-Пан.‡Erntet 8 reife Grünkohlpflanzen und liefert 40 Stück Grünkohl an die Shado-Pan.‡잘 익은 녹색 양배추를 8개 수확한 후 음영파에 녹색 양배추를 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de repollo verde maduras y consigue 40 repollos verdes para el Shadopan.‡‡Récoltez 8 plants de Choux verts mûrs et fournissez 40 Choux verts pour les Pandashan.‡收获8个成熟的绿色卷心菜，并向影踪派提供40份绿色卷心菜。‡',
  }
},
[32651] = {
  {
    'Seguir atacando pelo Estaleiro, estabelecer um portal‡Вводный полет‡Introflug‡도입 전투‡Intro del vuelo‡‡Vol d’intro‡飞行介绍‡',
    nil,
    'Uma‡‡‡레벨 1 천둥의 섬‡‡‡‡‡',
  }
},
[32652] = {
  {
    'Para os Céus!‡В небо!‡In die Lüfte!‡하늘 높이!‡¡Hacia los Cielos!‡‡En route vers les cieux !‡直冲云霄！‡',
    nil,
    'Obtenha acesso à Mina do Veio Relampejante. Uma‡Проникните в Шахту Молний.‡Verschafft Euch Zugang zu den Blitzaderminen.‡번개 광맥 광산을 확보해야 합니다. 레벨 32 천둥의 섬‡Consigue acceder a la Mina del Relámpago.‡‡Frayez-vous un chemin jusqu’à la Veine de Foudremine.‡进入闪电矿脉。‡',
  }
},
[32653] = {
  {
    'Ordem de Serviço: Os Celestiais Majestosos I‡Заказ: Августейшие Небожители I‡Arbeitsauftrag: Die Himmlischen Erhabenen I‡주문서: 위대한 천신회 I‡Pedido de los Augustos Celestiales I‡‡Commande : les Astres vénérables I‡产品订单：至尊天神I‡',
    nil,
    'Plante 8 Sementes de Melão Listrado na Fazenda Sol Cantante. Uma‡Посадите 8 семян полосатой дыни на ферме Солнечной Песни.‡Pflanzt 8 Streifenmelonensamen auf dem Gehöft Sonnensang.‡태양노래 농장에 줄무늬 멜론 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de melón a rayas en el Rancho Cantosol.‡‡Plantez 8 Graines de melon à rayures à la Ferme Chant du Soleil.‡在日歌农场播种8颗菜瓜种子。‡',
  }
},
[32654] = {
  {
    'Derrubem a Muralha!‡Разрушить эту стену!‡Die Mauer muss weg!‡성벽을 무너뜨려라!‡¡Abajo la Muralla!‡‡Démolissez ce mur !‡摧毁城墙！‡',
    nil,
    'Fale com a Grã-senhora Jaina Proudmore, depois infiltre-se no bairro inferior e reivindique-o para a Aliança. Uma‡Поговорите с леди Джайной Праудмур, а затем займите нижний город и обеспечьте там безопасность для войск Альянса.‡Sprecht mit Lady Jaina Prachtmeer und dringt dann in die untere Stadt vor, um sie für die Allianz zu erobern.‡여군주 제이나 프라우드무어와 대화하고 얼라이언스를 위해 성벽을 확보해야 합니다. 레벨 32 천둥의 섬‡Habla con Jaina Valiente, entra en el Bajo Arrabal y asegúralo para la Alianza.‡‡Parlez à Dame Jaina Portvaillant, puis introduisez-vous dans la Ville basse et sécurisez-la pour l’Alliance.‡与吉安娜·普罗德摩尔交谈，然后攻入城市下层，为联盟夺取它。‡',
  }
},
[32655] = {
  {
    'Uma ideia audaciosa‡Смелая идея‡Eine waghalsige Idee‡대담한 계획‡Una idea audaz‡‡Une idée audacieuse‡大胆的点子‡',
    nil,
    'Infiltre-se no Ancoradouro do Mar Revolto e abra o portão do paço por dentro. Fale com Taoshi para começar a missão. Uma‡Проникните на Пристань Бушующих Волн и откройте ворота изнутри. Поговорите с Таоши, чтобы начать задание.‡Infiltriert den Sturmgepeitschten Hafen und öffnet das Tor zum Hof von innen. Sprecht mit Taoshi, um die Mission zu beginnen.‡폭풍바다 선착장에 침투하여 안의 안마당 관문을 열어야 합니다. 타오스에게 말을 걸어 임무를 시작하십시오.‡Infíltrate en el Muelle Aguaturbia y abre la puerta del patio desde dentro. Habla con Taoshi para comenzar la misión.‡‡Infiltrez le Débarcadère de la mer des Tempêtes et ouvrez la porte de la cour de l’intérieur. Parlez à Taoshi pour commencer la mission.‡渗透进风暴之海码头并从里面打开庭院大门。与陶矢交谈来开始任务。‡',
  }
},
[32656] = {
  {
    'A Queda de Shan Bu‡Падение Шань-Бу‡Der Sturz von Shan\'Bu‡샨 부의 몰락‡La Caída de Shan Bu‡‡La chute de Shan Bu‡山怖之死‡',
    nil,
    'Derrote Shan Bu. Uma‡Победите Шань-Бу.‡Besiegt Shan\'Bu.‡샨 부를 처치해야 합니다. 레벨 32 천둥의 섬‡Derrota a Shan Bu.‡‡Vainquez Shan Bu.‡击败山怖。‡',
  }
},
[32657] = {
  {
    'Ordem de Serviço: Os Celestiais Majestosos II‡Заказ: Августейшие Небожители II‡Arbeitsauftrag: Die Himmlischen Erhabenen II‡주문서: 위대한 천신회 II‡Pedido de los Augustos Celestiales II‡‡Commande : les Astres vénérables II‡产品订单：至尊天神II‡',
    nil,
    'Colha 8 pés de Melão Listrado Maduro e forneça 40 Melões Listrados aos Celestiais Majestosos. Uma‡Соберите урожай с 8 грядок со спелыми полосатыми дынями и упакуйте 40 полосатых дынь для Августейших Небожителей.‡Erntet 8 reife Streifenmelonenpflanzen und liefert 40 Streifenmelonen an die Himmlischen Erhabenen.‡잘 익은 줄무늬 멜론을 8개 수확한 후 위대한 천신회에 줄무늬 멜론을 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de melón a rayas maduras y consigue 40 melones a rayas para los Augustos Celestiales.‡‡Récoltez 8 plants de Melons à rayures mûrs et fournissez 40 Melons à rayures pour les Astres vénérables.‡收获8个成熟的菜瓜，并向至尊天神提供40份菜瓜。‡',
  }
},
[32658] = {
  {
    'Ordem de Serviço: Os Klaxxi I‡Заказ: Клакси I‡Arbeitsauftrag: Die Klaxxi I‡주문서: 클락시 I‡Pedido de los Klaxxi I‡‡Commande : les Klaxxi I‡产品订单：卡拉克西I‡',
    nil,
    'Plante 8 Sementes de Abóbora Mogu na Fazenda Sol Cantante. Uma‡Посадите 8 семян тыквы могу на ферме Солнечной Песни.‡Pflanzt 8 Mogukürbissamen auf dem Gehöft Sonnensang.‡태양노래 농장에 모구 호박 씨앗을 8개 심어야 합니다. 레벨 15 네 바람의 계곡‡Planta 8 semillas de calabaza mogu en el Rancho Cantosol.‡‡Plantez 8 Graines de citrouille mogu à la Ferme Chant du Soleil.‡在日歌农场播种8颗魔古南瓜种子。‡',
  }
},
[32659] = {
  {
    'Ordem de Serviço: Os Klaxxi II‡Заказ: Клакси II‡Arbeitsauftrag: Die Klaxxi II‡주문서: 클락시 II‡Pedido de los Klaxxi II‡‡Commande : les Klaxxi II‡产品订单：卡拉克西II‡',
    nil,
    'Colha 8 pés de Abóbora Mogu Madura e forneça 40 Abóboras Mogus para os Klaxxi. Uma‡Соберите 8 спелых тыкв могу и упакуйте 40 тыкв могу для Клакси.‡Erntet 8 reife Mogukürbispflanzen und liefert 40 Mogukürbisse an die Klaxxi.‡잘 익은 모구 호박을 8개 수확한 후 클락시에 모구 호박을 40개 공급해야 합니다. 레벨 15 네 바람의 계곡‡Cosecha 8 plantas de calabaza mogu maduras y consigue 40 calabazas mogu para los Klaxxi.‡‡Récoltez 8 plants de Citrouilles mogu mûres et fournissez 40 Citrouilles mogu pour les Klaxxi.‡收获8个成熟的魔古南瓜，并向卡拉克西提供40份魔古南瓜。‡',
  }
},
[32661] = {
  {
    'Aprender a montar‡Уроки верховой езды‡Lernt Reiten‡타는 법 배우기‡A montar se ha dicho‡‡Un cavalier débutant‡学习骑乘‡',
