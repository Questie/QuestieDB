[30204] = {
  {
    'Isso não é uma pedra!‡Это не камень!‡Nicht drauftreten!‡바위가 아니잖아!‡¡No es una roca!‡‡Arrache nos phobies‡那不是一块石头！‡',
    nil,
    'Mate 50 Aranhinhas Teiacinzas. Use a tocha de Kun para queimá-las nas bolsas. Uma‡Убейте 50 пепельных паучат. Факел Куна сожжет их вместе с коконами.‡Tötet 50 Glutnetzspinnlinge. Verwendet Kuns Fackel, um sie noch in den Brutsäcken zu verbrennen.‡쿤의 횃불로 알주머니를 불태워 잿빛그물 새끼거미 50마리를 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a 50 arañitas Telaceniza. Utiliza la antorcha de Kun para quemarlas dentro de sus bolsas.‡‡Tuez 50 Jeunes araignées cendretoile. Utilisez la Torche de Kun pour les brûler dans leurs cocons.‡击败50只灰网幼蛛。使用奎的火炬将他们烧死在卵囊里。‡',
  }
},
[30205] = {
  {
    'Debaixo de quatro runas‡Рунические замки‡Runensperre‡룬의 보호‡Bloqueo de runas‡‡Verrou runique‡符文锁‡',
    nil,
    'Recupere os Artefato Mogu Ancestral. Uma‡Найдите древнюю реликвию могу.‡Bergt das uralte Moguartefakt.‡고대 모구 유물을 찾아야 합니다. 레벨 30 영원꽃 골짜기‡Recupera el artefacto mogu antiguo.‡‡Récupérez l’Ancien artéfact mogu.‡找回古代魔古神器。‡',
  }
},
[30206] = {
  {
    'Runas nas ruínas‡Руны в руинах‡Runen in den Ruinen‡폐허의 룬‡Runas en las ruinas‡‡Des runes dans la ruine‡‡',
    nil,
    'Colete 12 Pedras Rúnicas de Guo-Lai. Uma‡Соберите 12 рунических камней Го-лай.‡Sammelt 12 Guo-Lai-Runensteine zusammen.‡구오라이 마법석 12개를 모아야 합니다. 레벨 1 영원꽃 골짜기‡Reúne 12 piedras rúnicas Guo-Lai.‡‡Récupérez 12 Pierres runiques de Guo-Lai.‡‡',
  }
},
