[5513] = {
  {
    'Dragonas da Aurora‡Оплечья Рассвета‡Mäntel der Dämmerung‡여명의 장막‡Mantos del Alba‡Mantos del Alba‡Les mantelets de l\'aube‡黎明衬肩‡黎明披肩',
    nil,
    'Leve 10 Símbolos de Bravura da Aurora Argêntea à Intendente Cerraculatra, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Принесите 10 знаков доблести Серебряного Рассвета интенданту Затвор в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 10 Ehrenmarken der Argentumdämmerung zu Rüstmeister Knackschloss an der Kapelle des Hoffnungsvollen Lichts, Östliche Pestländer.‡동부 역병지대의 희망의 빛 예배당에 있는 병참장교 미란다 브리치락에게 은빛 여명회 명예 휘장 10개를 가져가야 합니다.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Cerrobrecha a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Cerrobrecha a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Apporter 10 Marques de valeur de l\'Aube d\'argent à l\'intendante Coinceculasse, à la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est.‡把10个银色黎明勇气勋章交给东瘟疫之地圣光之愿礼拜堂的军需官米兰达·布利洛克。‡把10個銀色黎明勇氣勳章交給東瘟疫之地聖光之願禮拜堂的軍需官米蘭達·布利洛克。',
  }
},
[5514] = {
  {
    'Um molde que vale ouro‡Форма денег стоит‡Sold reimt sich auf...‡거푸집과 뼛조각‡Molde rima con... ¿oro?‡Molde rima con... ¿oro?‡À la pêche au moule...‡昂贵的模具‡昂貴的模具',
    nil,
    'Leve os Fragmentos de Ossos Imbuídos e 15 moedas de ouro para Rugov A. Massoaço em Geringontzan.‡Отнесите Кринкелю Сталлеру из Прибамбасска прочные фрагменты скелета и 15 золотых монет.‡Bringt die magieerfüllten Skelettfragmente sowie 15 Goldstücke zu Krinkle Goldstahl in Gadgetzan.‡가젯잔에 있는 크린클 굿스틸에게 15골드와 함께 마력 깃든 뼛조각을 가져가야 합니다.‡Lleva los trozos esqueléticos imbuidos y 15 piezas de oro a Krinkle Buenacero en Gadgetzan.‡Lleva los trozos esqueléticos imbuidos y 15 piezas de oro a Krinkle Buenacero en Gadgetzan.‡Apporter les Fragments de squelette imprégnés et 15 pièces d\'or à Froisse Bonnacier à Gadgetzan.‡把灌魔的骸骨碎片和15枚金币交给加基森的克林科·古德斯迪尔。‡把灌魔的骷髏碎片和15枚金幣交給加基森的克林科·古德斯迪爾。',
  }
},
[5515] = {
  {
    'Saco de Horrores de Krastinov‡Мешок ужасов Крастинова‡Krastinovs Tasche der Schrecken‡소름끼치는 크라스티노브의 가방‡Bolsa de los horrores de Krastinov‡Bolsa de los horrores de Krastinov‡Sac des horreurs de Krastinov‡卡斯迪诺夫的恐惧之袋‡卡斯迪諾夫的恐懼之袋',
    nil,
    'Localize Janice Barov em Scolomântia e a destrua. Recupere o Saco de Horrores de Krastinov do cadáver dela. Entregue o saco a Eva Sarkhoff.‡Найдите в Некроситете Джандис Барову и уничтожьте ее. Заберите мешок ужасов Крастинова. Отнесите мешок Еве Саркофф.‡Sucht nach Jandice Barov in Scholomance und vernichtet sie. Entnehmt ihrer Leiche Krastinovs Tasche der Schrecken. Bringt die Tasche zu Eva Sarkhoff.‡스칼로맨스에서 잔다이스 바로브를 찾아 처치해야 합니다. 그녀의 시체에서 소름끼치는 크라스티노브의 가방을 입수한 후 에바 사크호프에게 가져가야 합니다.‡Localiza a Jandice Barov en Scholomance y destrúyela. En su cadáver encontrarás la Bolsa de los horrores de Krastinov. Devuélvele la bolsa a Eva Sarkhoff.‡Localiza a Jandice Barov en Scholomance y destrúyela. En su cadáver encontrarás la Bolsa de los horrores de Krastinov. Devuélvele la bolsa a Eva Sarkhoff.‡Trouver Jandice Barov dans Scholomance et la tuer. Sur son cadavre, récupérer le Sac des horreurs de Krastinov. Rapporter le sac à Eva Sarkhoff.‡在通灵学院找到詹迪斯·巴罗夫并打败她。从她的尸体上找到卡斯迪诺夫的恐惧之袋，然后将其交给艾瓦·萨克霍夫。‡在通靈學院找到詹迪斯·巴羅夫並打敗她。從她的屍體上找到卡斯迪諾夫的恐懼之袋，然後將其交給艾瓦·薩克霍夫。',
  }
},
[5516] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
