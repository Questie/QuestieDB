},
[1558] = {
  {
    'O Dique Lapidado‡Каменная плотина‡Der Steinwerkdamm‡돌다지 댐‡Presa de las Tres Cabezas‡Presa de las Tres Cabezas‡Le barrage de Formepierre‡巨石水坝‡巨石水壩',
    nil,
    'Leve o órfão ao Dique Lapidado em Loch Modan. Vá com ele até o meio do dique para que ele possa ver por cima da cachoeira.‡Отведите сироту к Каменной плотине у озера Лок Модан. Пусть постоит в центре дамбы и полюбуется огромным водопадом.‡Begleitet Euren Schützling zum Steinwerkdamm in Loch Modan. Geht mit ihm zur Mitte des Damms, damit er auf den riesigen Wasserfall heruntersehen kann.‡랜디스를 모단 호수에 있는 돌다지 댐에 데려가야 합니다. 거대한 폭포를 볼 수 있도록 댐 중간까지 데려다 주십시오.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Conduire l\'orphelin au barrage de Formepierre au Loch Modan. Vous devez le conduire au milieu du barrage pour qu\'il puisse voir par-dessus l\'immense chute d\'eau.‡带着你看护的孤儿去洛克莫丹的巨石水坝。你应该带他去水坝的中间，然后让他俯瞰巨大的瀑布。‡帶著你看護的孤兒去洛克莫丹的巨石水壩。你應該帶他去水壩的中間，然後讓他俯瞰巨大的瀑布。',
  }
},
[1559] = {
  {
    '‡Секрет изготовления световой бомбы‡Blitzbombenanleitung‡‡Receta de bomba cegadora‡Receta de bomba cegadora‡La recette de la bombe éclairante‡闪光弹的制法‡',
    nil,
    nil,
  }
},
[1560] = {
  {
    '‡Задание Туги‡Toogas Bitte‡길 잃은 투가‡La misión de Tooga‡La misión de Tooga‡La quête de Tooga‡图加的任务‡',
    nil,
    '‡Сопроводите Тугу к его жене, Торте.‡Zeigt Tooga den Weg zurück zu seiner Frau Torta.‡투가를 아내 토르타에게 데려다 줘야 합니다.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Montrer à Tooga le chemin du retour vers sa femme, Torta.‡把图加带回到他的妻子托尔塔身边。‡',
  }
},
[1578] = {
  {
    'Suprimentos para o front‡Помощь фронту‡Nachschub für die Front‡전방 보급품 조달‡Abastecer al frente‡Abastecer al frente‡Rééquiper le front‡前线的补给‡前線的補給',
    nil,
    'Entregue 6 Machados de Cobre e 6 Cintos Encadeados de Cobre para Thorvald, na torre de vigia sul de Loch Modan.‡Отнесите 6 медных топоров и 6 медных плетеных поясов Торвальду в южную сторожевую башню озера Лок Модан.‡Bringt 6 Kupferäxte und 6 kupferne Kettengürtel zu Thorvald im südlichen Wachturm von Loch Modan.‡모단 호수 남쪽 방어탑에 있는 토르발트에게 구리 도끼 6개와 구리 사슬 허리띠 6개를 가져가야 합니다.‡Lleva 6 hachas y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Lleva 6 hachas y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Apportez 6 Haches en cuivre et 6 Ceintures en anneaux de cuivre à Thorvald dans la Tour de garde méridionale du Loch Modan.‡给洛克莫丹南部警戒塔的索瓦尔德带去6把铜斧和6条铜质链甲腰带。‡給洛克莫丹南部警戒塔的索瓦爾德帶去6把銅斧和6條銅質鍊甲腰帶。',
  }
},
[1579] = {
  {
    'Deschanfradores‡Суперразъемы‡Klemmmuffen‡개퍼 잭‡Mecanismos eléctricos‡Mecanismos eléctricos‡Rouages électriques‡小齿轮‡小齒輪',
    nil,
    'Entregue 8 Deschanfradores para Xafetim Manigiro em Auberdine.‡Принесите Бацбаху Кривошипу в Аубердин 8 суперразъемов.‡Bringt 8 Klemmmuffen zu Hexknall Kurbeldreh in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 개퍼 잭 8개를 가져가야 합니다.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Apporter 8 Rouages électriques à Crackboum Tournelevier à Auberdine.‡收集8个小齿轮，把它们交给奥伯丁的维兹班恩·曲针。‡收集8個小齒輪，把它們交給奧伯丁的維茲班恩‧曲針。',
  }
},
[1580] = {
  {
    'Eletromolas‡Электропеллеры‡Elektropeller‡전력추진기‡Los electromuelles‡Los electromuelles‡Pêche aux Electropellers‡导电器‡導電器',
    nil,
    'Entregue 12 Eletromolas para o Xafetim Manigiro em Auberdine.‡Принесите 12 электропеллеров Бацбаху Кривошипу в Аубердин.‡Bringt 12 Elektropeller zu Hexknall Kurbeldreh in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 전력추진기 12개를 가져가야 합니다.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Apporter 12 Electropellers à Crackboum Tournelevier à Auberdine.‡收集12个导电器，把它们交给奥伯丁的维兹班恩·曲针。‡收集12個導電器，把它們交給奧伯丁的維茲班恩‧曲針。',
  }
},
[1581] = {
  {
    'Elixires para os Folhâminas‡Эликсиры для клана Режущего Листа‡Elixiere für die Messerblatts‡블레이드리프를 위한 비약‡Elixires para Filohoja‡Elixires para Filohoja‡Les élixirs pour les Feuillelame‡刃叶的药剂‡刃葉的藥劑',
    nil,
    'Traga 6 Elixires de Força de Leão e 2 Elixires de Defesa Menor para Syral Folhâmina, em Dolanaar.‡Доставьте 6 эликсиров львиной силы и 2 слабых эликсира защиты Сирел Остролист в Доланаар.‡Bringt 6 Elixiere der Löwenstärke und 2 Elixiere der schwachen Verteidigung zu Syral Messerblatt in Dolanaar.‡돌라나르에 있는 시랄 블레이드리프에게 사자의 힘 비약 6개와 최하급 방어의 비약 2개를 가져가야 합니다.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Apporter 6 Elixirs de force du lion et 2 Elixirs de défense mineure à Syral Feuillelame à Dolanaar.‡给在多兰纳尔的塞拉尔·刃叶带去6瓶狮王之力药剂和2瓶初级防御药剂。‡給在多蘭納爾的塞拉爾·刃葉帶去6瓶獅王之力藥劑和2瓶初級防禦藥劑。',
  }
},
[1582] = {
  {
    'O colete brilho da lua‡Жилет лунного сияния‡Mondscheinweste‡달빛 조끼‡El jubón resplandor lunar‡El jubón resplandor lunar‡Le gilet Lueur-de-lune‡月光外衣‡月光外衣',
    nil,
    'Leve 1 par de Luvas de Couro com Relevo, 5 pares de Botas de Couro com Relevo e 5 Mantos de Couro com Relevo para Lotherias, em Darnassus.‡Принесите 1 пару тисненых кожаных перчаток, 5 пар тисненых кожаных сапог и 5 тисненых кожаных плащей Лотериас в Дарнас.‡Bringt 1 Paar geprägte Lederhandschuhe, 5 Paar geprägte Lederstiefel und 5 geprägte Lederumhänge zu Lotherias in Darnassus.‡다르나서스에 있는 로서리아스에게 새김무늬 가죽 장갑 1개, 새김무늬 가죽 장화 5개, 새김무늬 가죽 망토 5개를 가져가야 합니다.‡Trae 1 par de guantes de cuero estampado, 5 botas de cuero estampado y 5 capas de cuero estampado para Lotherias en Darnassus.‡Trae 1 par de guantes de cuero estampados, 5 botas de cuero estampadas y 5 capas de cuero estampadas para Lotherias en Darnassus.‡Apporter 1 paire de Gants en cuir estampé, 5 paires de Bottes en cuir estampé et 5 Capes en cuir estampé à Lotherias à Darnassus.‡把1双雕花皮手套、5双雕花皮靴和5件雕花皮质披风交给达纳苏斯的洛瑟里亚斯。‡把1雙雕花皮甲手套、5雙雕花皮甲長靴和5件雕花皮甲披風交給達納蘇斯的洛瑟里亞斯。',
  }
},
[1598] = {
  {
    '‡Украденная книга‡Der gestohlene Foliant‡‡El libro robado‡El libro robado‡Le Tome dérobé‡失窃的典籍‡',
    nil,
    '‡Принесите книгу "Силы Бездны" Друзилле ла Салле.‡Holt Die Macht der Leere für Drusilla La Salle zurück.‡‡Lleva los Poderes del Vacío a Drusilla La Salle.‡Lleva los Poderes del Vacío a Drusilla La Salle.‡Retrouvez la Puissance du Vide pour Drusilla La Salle.‡为杜希拉·拉萨雷找回《虚空灵能》。‡',
  }
},
[1599] = {
  {
    '‡В начале славных дел‡Anfänge‡‡Novato‡Novato‡Les débuts‡开端‡',
    nil,
    '‡Добудьте 3 оберега из перьев и отнесите их Аламару Мрачнну в Старую Наковальню.‡Bringt 3 Federglücksbringer zu Alamar Grimm in Ambossar.‡‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Apporter 3 Charmes de plume à Alamar Grimm à Courbenclume.‡给安威玛尔的阿拉玛尔·格里姆带回3个羽毛咒符。‡',
  }
},
[1618] = {
  {
    'Armamentos para Cristarrubra‡Экипирование Красногорья‡Die Aufrüstung im Rotkammgebirge‡붉은마루산맥 무기 조달‡Equipar Crestagrana‡Equipar Crestagrana‡Le rééquipement des Carmines‡赤脊山的补给‡支援赤脊山',
    nil,
    'Tormus Baixaforja quer que você dê 4 Cintos Rúnicos de Cobre e 4 Malhos Pesados de Cobre para Vervo Obom, em Cristarrubra.‡По просьбе Тормуса Подземной Кузни отнесите 4 рунных медных пояса и 4 тяжелых медных кувалды Вернеру Осгуду в Красногорье.‡Tormus Tiefenschmied möchte, dass Ihr 4 runenverzierte Kupfergürtel und 4 schwere Kupferschlägel zu Verner Gutmark ins Rotkammgebirge bringt.‡토르무스 딥포지가 붉은마루 산맥에 있는 베르너 오스구드에게 구리 룬새김 허리띠 4개와 무거운 구리 마울 4개를 가져다 달라고 했습니다.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 mazas grandes de cobre pesadas a Verner Osbien a Crestagrana.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 mazas grandes de cobre pesadas a Verner Osbien a Crestagrana.‡Tormus Forge-profonde veut que vous apportiez 4 Ceintures runiques en cuivre et 4 Maillets lourds en cuivre à Verner Bongoulot, dans les Carmines.‡托姆斯·深炉要你给赤脊山的弗纳·奥斯古带去4条铜质符文腰带和4把铜质大锤。‡托姆斯·深爐要你帶4條銅質符文腰帶和4把重銅大槌給赤脊山的弗納·奧斯古。',
  }
},
[1638] = {
  {
    'Treinamento de guerreiro‡Обучение воина‡Die Ausbildung eines Kriegers‡전사 훈련‡Instrucción de guerrero‡Instrucción de guerrero‡L\'entraînement du guerrier‡战士的训练‡戰士的訓練',
    nil,
    'Speak with Harry Burlguard in Stormwind.‡Поговорите с Гарри Берлгардом в Штормграде.‡Sprecht mit Harry Burlwacht in Sturmwind.‡스톰윈드에 있는 해리 벌가드와 대화해야 합니다.‡Habla con Harry Burlguard en Ventormenta.‡Habla con Harry Burlguard en Ventormenta.‡Parler à Harry Burlguard à Hurlevent.‡和暴风城的哈里·伯加德谈一谈。‡到暴風城找哈里·伯加德談話。',
  }
},
[1639] = {
  {
    '‡Бартлби Пьянь‡Bartleby der Trunkenbold‡‡Bartleby, el borracho‡Bartleby, el borracho‡Bartleby le poivrot‡醉鬼巴特莱比‡',
    nil,
    '‡Поговорите с Бартлби.‡Sprecht mit Bartleby.‡‡Habla con Bartleby.‡Habla con Bartleby.‡Parler à Bartleby.‡和巴特莱比谈一谈。‡',
  }
},
[1640] = {
  {
    '‡Побить Бартлби‡Besiegt Bartleby‡‡Vence a Bartleby‡Vence a Bartleby‡Battre Bartleby‡击败巴特莱比‡',
    nil,
    '‡Побейте Бартлби и снова поговорите с ним.‡Besiegt Bartleby und redet dann mit ihm.‡‡Golpea a Bartleby y habla con él.‡Golpea a Bartleby y habla con él.‡Battre Bartleby, puis lui parler.‡打败巴特莱比，然后再和他谈一谈。‡',
  }
},
[1641] = {
  {
    '‡Фолиант Божественности‡Der Foliant der Offenbarung‡‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
