},
[28890] = {
  {
    '‡Пустошь‡Einöde‡황무지‡Páramo‡Páramo‡La dévastation‡废土‡',
    nil,
    '‡Доставьте письмо Рабина Лайо Звездному Всполоху, находящемуся у деревни Южного Ветра.‡Überbringt Rabines Brief an Layo Sternenschlag in der Nähe des Südwindpostens.‡마파람 마을 근처에 있는 라요 스타스트라이크에게 라빈의 편지를 가져가야 합니다.‡Entrégale la carta de Rabine a Layo Golpe Estelar cerca de la Aldea del Viento del Sur.‡‡Remettez la Lettre de Rabine à Layo Heurtétoile, près du Village de Sudevent.‡把拉比恩的信交给南风村附近的莱耶·星击。‡',
  }
},
[28891] = {
  {
    '‡Духи Южного Ветра‡Die Geister vom Südwindposten‡‡Los espíritus de Viento del Sur‡Los espíritus de Viento del Sur‡Les esprits de Sudevent‡南风村的灵魂‡',
    nil,
    '‡Освободите души 8 истерзанных друидов и 8 истерзанных часовых в деревне Южного Ветра.‡Befreit die Geister von 8 gequälten Druiden und 8 gequälten Schildwachen im Südwindposten.‡‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturados en la Aldea del Viento del Sur.‡‡Libérez l\'esprit de 8 Druides torturés et de 8 Sentinelles torturées, dans le village de Sudevent.‡‡',
  }
},
[28892] = {
  {
    '‡Улей в башне‡Schwarmbau im Turm‡‡Una colmena en la torre‡Una colmena en la torre‡Une ruche dans la tour‡塔中之巢‡',
    nil,
    '‡Отыщите покрытый коркой щит силитида.‡Bringt das verkrustete Silithidenobjekt in Euren Besitz.‡‡Recupera el objeto silítido taraceado.‡‡Récupérez l\'Objet silithide incrusté.‡‡',
  }
},
[28893] = {
  {
    '‡Умбер, архивариус‡Umber, Archivar‡‡Umber, el archivista‡Umber, el archivista‡Umber, Archiviste‡档案管理员阿姆伯尔‡',
    nil,
    '‡Отнесите покрытый коркой щит силитида Умберу.‡Bringt das verkrustete Silithidenobjekt zu Umber.‡‡Lleva el objeto silítido taraceado a Umber.‡‡Apportez l\'Objet silithide incrusté à Umber.‡‡',
  }
},
[28894] = {
  {
    '‡Раскрытие древних секретов‡Enthüllung von Geheimnissen der Vergangenheit‡‡Desvelar los secretos del pasado‡Desvelar los secretos del pasado‡Les secrets du passé‡发现过去的秘密‡',
    nil,
    '‡Поговорите с Рабином Сатурной в Крепости Кенария, что в Силитусе.‡Sprecht mit Rabine Saturna auf Burg Cenarius in Silithus.‡‡Habla con Rabine Saturna en el Fuerte Cenarion, en Silithus.‡‡Parlez à Rabine Saturna dans le Fort Cénarien, en Silithus.‡‡',
  }
},
[28895] = {
  {
    '‡Осквернители ветра‡Beschmutzer des Windes‡바람 박해자‡Mancilladores del viento‡‡Les profanateurs du vent‡打扰风声的东西‡',
    nil,
    '‡Убейте 10 пустынных грохотунов.‡Zerstört 10 Wüstenrumpler‡우레의 모래정령 10마리를 처치해야 합니다.‡Acaba con 10 estruendores del desierto.‡‡Détruisez 10 Grondeurs du désert.‡消灭10个沙漠奔行者。‡',
  }
},
[28896] = {
  {
    '‡Призыв‡‡‡‡‡‡召唤‡',
    nil,
    '‡Воспользуйтесь письменами вызова у костей Граккаронда, чтобы призвать нового хозяина силитидов.‡Benutzt die Glyphen der Anrufung bei den Knochen von Grakkarond um den neuen Meister der Silithiden herbeizurufen.‡‡Utiliza los glifos de Llamamiento en los Huesos de Grakkarond para invocar al nuevo señor de los silítidos.‡‡Utilisez les Glyphes d\'appel aux Restes de Grakkarond pour invoquer le nouveau maître des silithides.‡在格拉卡隆之骨使用召唤雕文，召唤异种虫的新主人。‡',
  }
},
[28897] = {
  {
    '‡План Баристолфа‡Baristolths Plan‡‡El plan de Baristolth‡‡Le plan de Baristolth‡‡',
    nil,
    '‡Поговорите с Баристолфом из Зыбучих Песков в Крепости Кенария.‡Sprecht mit Baristolth von den Sandstürmen auf Burg Cenarius.‡‡Habla con Baristolth del Mar de Dunas en Fuerte Cenarion.‡‡Parlez à Baristolth des Sables changeants au Fort Cénarien.‡‡',
  }
},
[28898] = {
  {
    '‡Выделения и ухищрения‡Sekrete und List‡‡Secreción y subterfugio‡‡Sécrétion et subterfuge‡‡',
    nil,
    '‡Соберите 8 выделительных желез любого силитида из улья Аши.‡Sammelt 8 Sekretdrüsen des Ashischwarms von beliebigen Silithiden im Bau des Ashischwarms.‡‡Reúne 8 glándulas de secreción de Colmen\'Ashi de cualquier silítido de Colmen\'Ashi.‡‡Récoltez 8 Glandes de silithide de la Ruche\'Ashi sur n\'importe quel silithide de la Ruche\'Ashi.‡‡',
  }
},
[28899] = {
  {
    '‡Прямое проникновение‡Überraschungsei‡‡Oculto a simple vista‡‡L\'œuf de Troie‡‡',
    nil,
    '‡Воспользуйтесь специальной слизью силитидов вблизи кладки яиц перед ульем Аши, чтобы проникнуть внутрь.‡Benutzt den vorbereiteten Silithidenschleim in der Nähe des Eierstapels des Ashischwarms, um den Schwarmbau zu infiltrieren.‡‡Usa el moco de silítido preparado cerca de la pila de huevos Colmen\'Ashi para infiltrarte en la colmena.‡‡Utilisez le Mucus de silithide préparé près des Œufs de la Ruche\'Ashi pour vous infiltrer dans la ruche.‡‡',
  }
},
[28900] = {
  {
    '‡Загадки улья Сумеречного Молота‡Mysterien des Schattenbaus‡‡Los misterios de la colmena Crepuscular‡‡Les mystères de la ruche du Crépuscule‡‡',
    nil,
    '‡Осмотрите улей Аши в поисках следов, проливающих свет на планы Сумеречного Молота, и убейте 10 сектантов культа.‡Durchsucht den Bau des Ashischwarms nach Beweisen für die Pläne des Schattenhammers und tötet 10 Schattenhammerkultisten.‡‡Registra Colmen\'Ashi en busca de pruebas de los planes del Martillo Crepuscular y mata a 10 cultores del Martillo Crepuscular.‡‡Fouillez la Ruche\'Ashi pour trouver la preuve du complot du Marteau du crépuscule et tuez 10 Sectateurs du Marteau du crépuscule.‡‡',
  }
},
[28901] = {
  {
    '‡Узники безумия‡Gefangene des Wahnsinns‡광기의 포로‡Prisioneros de la locura‡‡Prisonniers de la folie‡疯狂的囚犯‡',
    nil,
    '‡Освободите 5 пленников улья Аши.‡Rettet 5 Gefangene des Ashischwarms.‡하이브아쉬 포로 5명을 구출해야 합니다.‡Rescata a 5 prisioneros Colmen\'Ashi.‡‡Venez en aide à 5 Prisonniers de la Ruche\'Ashi.‡救出5名亚什虫巢囚犯。‡',
  }
},
[28902] = {
  {
    '‡‡‡‡‡‡&lt;PH&gt;Ruche\'Zora B/C‡‡',
    nil,
    nil,
  }
},
[28904] = {
