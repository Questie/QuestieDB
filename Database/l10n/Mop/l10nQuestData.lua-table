[8120] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe im Arathibecken und kehrt dann zu Todesmeister Dunkels in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 망치 주둔지에 있는 죽음의경비대장 드와이어에게 가야 합니다.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l\'écurie du bassin Arathi, puis revenez voir le Maître de la mort Dwire, au Trépas-d\'Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦坑、伐木場、鐵匠鋪和獸欄，然後向落錘鎮的屠殺者杜維爾覆命。',
  }
},
[8121] = {
  {
    'Tome quatro bases‡Захват четырех баз‡Erobert vier Stützpunkte‡거점 네 곳 점령‡Toma el control de cuatro bases‡Toma el control de cuatro bases‡Prendre quatre bases‡夺取四座基地‡奪取四座基地',
    nil,
    'Controle quatro bases ao mesmo tempo na Bacia Arathi. Depois, fale novamente com a Senhora da Morte Dwire, na Ruína do Martelo.‡Удерживайте одновременно четыре базы в низине Арати, а затем возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Haltet vier Stützpunkte zur selben Zeit im Arathibecken und kehrt danach zu Todesmeister Dunkels nach Hammerfall zurück.‡아라시 분지로 가서 네 곳의 거점을 동시에 확보하는 임무를 완수한 다음 망치 주둔지에 있는 죽음의경비대장 드와이어에게 가야 합니다.‡Toma el control de cuatro bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Toma el control de cuatro bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Contrôlez quatre bases du bassin Arathi simultanément, puis revenez voir le Maître de la mort Dwire, au Trépas-d\'Orgrim.‡同时占据阿拉希盆地中的四座基地，然后向落锤镇的屠杀者杜维尔复命。‡同時佔據阿拉希盆地中的4座基地，然後向落錘鎮的屠殺者杜維爾覆命。',
  }
},
[8122] = {
  {
    '‡Занять пять баз‡Erobert fünf Stützpunkte‡거점 다섯 곳 점령‡Toma el control de cinco bases‡Toma el control de cinco bases‡Prendre cinq bases‡夺取五座基地‡奪取五座基地',
    nil,
    '‡Захватите и удерживайте все пять баз в Низине Арати, затем возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Haltet fünf Stützpunkte zur selben Zeit im Arathibecken und kehrt danach zu Todesmeister Dunkels nach Hammerfall zurück.‡아라시 분지로 가서 다섯 곳의 거점을 동시에 확보하는 임무를 완수한 다음 망치 주둔지에 있는 죽음의경비대장 드와이어에게 가야 합니다.‡Toma el control de cinco bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Toma el control de cinco bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Contrôlez 5 bases du bassin Arathi simultanément, puis revenez voir le Maître de la mort Dwire, au Trépas-d\'Orgrim.‡同时占据阿拉希盆地中的五座基地，然后向落锤镇的屠杀者杜维尔复命。‡同時佔據阿拉希盆地中的5座基地，然後向落錘鎮的屠殺者杜維爾覆命。',
  }
},
