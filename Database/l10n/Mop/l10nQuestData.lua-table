[31966] = {
  {
    'Domadores de Batalha: Cataclysm‡Укротители боевых питомцев: Cataclysm‡Kampfhaustierzähmer: Cataclysm‡전투 애완동물 조련사: 대격변‡Domadores de mascotas de duelo: Cataclysm‡‡Dompteurs de mascottes de combat : Cataclysme‡战斗宠物训练师：大地的裂变‡',
    nil,
    'Vença Brok, Bordin Punhofirme e Goz Malefúria em batalhas de mascotes. Uma‡Победите Брока, Бордина Крепкорука и Гоза Гибельную Ярость в битвах питомцев.‡Besiegt Brok, Bordin Ruhigfaust und Goz Unheilsfuror in Haustierkämpfen.‡애완동물 대전에서 브로크, 보르딘 스테디피스트, 고즈 베인퓨리를 꺾어야 합니다. 레벨 1‡Derrota a Brok, a Bordin Puñofirme y a Goz Malafuria en un duelo de mascotas.‡‡Gagnez un combat de mascottes contre Brok, Bordin Poing Hardi et Goz Furie du Fléau.‡在宠物战斗中击败布洛克、鲍丁·固拳和高兹·怨怒。‡',
  }
},
[31967] = {
  {
    'Domadores de Batalha: Cataclysm‡Укротители боевых питомцев: Cataclysm‡Kampfhaustierzähmer: Cataclysm‡전투 애완동물 조련사: 대격변‡Domadores de mascotas de duelo: Cataclysm‡‡Dompteurs de mascottes de combat : Cataclysme‡战斗宠物训练师：大地的裂变‡',
