[33374] = {
  {
    'Caminho do Andanévoa‡Путь странника туманов‡Der Weg des Nebelgängers‡안개 속을 걷는 자‡La senda del Caminante de la niebla‡‡La voie du marche-brume‡迷雾行者之道‡',
    nil,
    'Derrote 20 criaturas Elite na Ilha Perene. Uma‡Убейте 20 элитных существ на Вневременном острове.‡Vernichtet 20 Elitekreaturen auf der Zeitlosen Insel.‡영원의 섬에서 정예 몬스터 20마리를 처치해야 합니다. 레벨 30 영원의 섬‡Derrota a 20 criaturas de élite en la Isla Intemporal.‡‡Triomphez de 20 créatures élite sur l’Île du Temps figé.‡在永恒岛上击败20只精英生物。‡',
  }
},
[33375] = {
  {
    'Refinando a Visão‡Усовершенствование видения‡Die Vision genauer bestimmen‡다시 한 번 환영 속으로‡Perfeccionando la visión‡‡Aiguiser la vision‡完善时光之眼‡',
    nil,
    'Use a Visão do Tempo no Cerco a Orgrimmar. Uma‡Используйте видение времени во время осады Оргриммара.‡Verwendet die Vision der Zeit in der Schlacht um Orgrimmar.‡오그리마 공성전에서 시간의 환영을 사용해야 합니다. 레벨 30 영원의 섬‡Usa la visión en el tiempo en el Asedio de Orgrimmar.‡‡Utilisez la Vision du temps lors du Siège d’Orgrimmar.‡在决战奥格瑞玛中使用时光之眼。‡',
  }
},
[33376] = {
  {
    'Em busca do destino‡В поисках судьбы‡Suche nach Bestimmung‡운명을 찾아서‡En busca del destino‡‡À la recherche du destin‡寻找命运‡',
    nil,
    'Use a Visão do Tempo no Cerco a Orgrimmar. Uma‡Используйте видение времени во время осады Оргриммара.‡Verwendet die Vision der Zeit in der Schlacht um Orgrimmar.‡오그리마 공성전에서 시간의 환영을 사용해야 합니다. 레벨 30 영원의 섬‡Usa la visión en el tiempo en el Asedio de Orgrimmar.‡‡Utilisez la Vision du temps lors du Siège d’Orgrimmar.‡在决战奥格瑞玛中使用时光之眼。‡',
  }
},
[33377] = {
  {
    'Trilhas ocultas‡Сокрытые нити‡Verborgene Stränge‡숨겨진 실타래‡Hilos ocultos‡‡Des fils cachés‡销声敛迹‡',
    nil,
    'Use a Visão do Tempo no Cerco a Orgrimmar. Uma‡Используйте видение времени во время осады Оргриммара.‡Verwendet die Vision der Zeit in der Schlacht um Orgrimmar.‡오그리마 공성전에서 시간의 환영을 사용해야 합니다. 레벨 30 영원의 섬‡Usa la visión en el tiempo en el Asedio de Orgrimmar.‡‡Utilisez la Vision du temps lors du Siège d’Orgrimmar.‡在决战奥格瑞玛中使用时光之眼。‡',
  }
},
[33378] = {
  {
    'Cortejando o destino‡Судьба принца‡Das Schicksal herausfordern‡운명을 찾으며‡Cortejando al destino‡‡À la rencontre de la destinée‡祈求命运‡',
    nil,
    'Use a Visão do Tempo no Templo do Tigre Branco, que fica no Monte Kun-Lai. Uma‡Используйте видение времени в храме Белого Тигра, что на вершине Кунь-Лай. задание.‡Verwendet die Vision der Zeit im Tempel des Weißen Tigers auf dem Kun-Lai-Gipfel.‡쿤라이 봉우리에 있는 백호사에서 시간의 환영을 사용해야 합니다. 레벨 30 영원의 섬‡Usa la visión en el tiempo en el Templo del Tigre Blanco, en la Cima Kun-Lai.‡‡Utilisez la Vision du temps au Temple du Tigre blanc, au Sommet de Kun-Lai.‡在昆莱山的白虎寺使用时光之眼。‡',
  }
},
[33379] = {
  {
    'Uma última vez‡Один последний переворот‡Ein letztes Mal‡마지막 단서‡Una última vuelta‡‡Un dernier tour‡最终行动‡',
    nil,
    'Use a Visão do Tempo nas Cavernas do Tempo, que ficam em Tanaris. Uma‡Используйте видение времени в пещерах Времени в Танарисе.‡Verwendet die Vision der Zeit in den Höhlen der Zeit in Tanaris.‡타나리스의 시간의 동굴에서 시간의 환영을 사용해야 합니다. 레벨 30 영원의 섬‡Usa la visión en el tiempo en las Cavernas del Tiempo, en Tanaris.‡‡Utilisez la Vision du temps dans les Grottes du Temps, en Tanaris.‡在塔纳利斯的时光之穴中使用时光之眼。‡',
  }
},
