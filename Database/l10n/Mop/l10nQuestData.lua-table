[11448] = {
  {
    'O Posto Avançado da Liga dos Exploradores‡Лагерь Лиги исследователей‡Der Außenposten der Forscherliga‡탐험가 연맹 전초기지‡La Avanzada de la Liga de Expedicionarios‡La Avanzada de la Liga de Expedicionarios‡L\'avant-poste de la Ligue des explorateurs‡探险者协会哨站‡探險者協會前哨',
    nil,
    'Entregue a Trouxa de McSurf para Stanwad, no Posto Avançado da Liga dos Exploradores, no Fiorde Uivante.‡Отвезите сверток Максорфа Станваду в Лагерь Лиги исследователей в Ревущем фьорде.‡Liefert McSorfs Bündel bei Stanwad im Außenposten der Forscherliga im Heulenden Fjord ab.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 스탄와드에게 맥소르프의 자루를 전달해야 합니다.‡Llévale el fardo de McSorf a Stanwad a la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal.‡Llévale el fardo de McSorf a Stanwad a la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal.‡Remettre le Paquet de McSorf à Stanwad, à l’Avant-poste de la Ligue des explorateurs, dans le Fjord Hurlant.‡将米科索夫的包裹送给嚎风峡湾探险者协会哨站的斯坦瓦德。‡到凜風峽灣的探險者協會前哨，將麥克索夫的包裹交給史坦華。',
  }
},
[11449] = {
  {
    'Treinamento contra o fogo‡Учения пожарной бригады‡Feuerübung‡소방대 훈련‡Entrenamiento de bomberos‡Entrenamiento de bomberos‡L\'entraînement au combat du feu‡灭火练习‡消防演練',
    nil,
    'Jogue Baldes d\'Água em 5 chamas, e então fale com a Matriarca Mascarada em Montalvo.‡Выплесните воду из ведра в 5 очагов пожара. Затем поговорите с попечительницей сирот в маске в Брилле.‡Löscht 5 Feuer mit Wassereimern und sprecht anschließend mit der maskierten Waisenmatrone in Brill.‡물동이를 던져 불을 5번 끄고, 브릴에 있는 가면 쓴 보육원 원장님과 대화해야 합니다.‡Echa cubos de agua en 5 hogueras y ve a hablar con la supervisora de huérfanos enmascarada de Rémol.‡Echa cubos de agua en 5 hogueras y ve a hablar con la supervisora de huérfanos enmascarada de Rémol.‡Jetez des Seaux d’eau sur 5 feux, puis retournez voir la Directrice d\'orphelinat masquée à Brill.‡将小水桶里的水倒在5处火盆上，然后回到布瑞尔，与戴面具的孤儿院长谈一谈。‡把水桶扔向5個火源，然後再和布瑞爾的戴面具的孤兒監護員談談。',
  }
},
[11450] = {
  {
    'Treinamento contra o fogo‡Учения пожарной бригады‡Feuerübung‡소방대 훈련‡Entrenamiento de bomberos‡Entrenamiento de bomberos‡L\'entraînement au combat du feu‡灭火练习‡消防演練',
    nil,
    'Jogue Baldes d\'Água em 5 chamas e, a seguir, fale com a Matriarca Mascarada na Praça Asa do Falcão.‡Выплесните воду из ведра в 5 очагов пожара. Затем поговорите с попечительницей сирот в маске на Площади Соколиных Крыльев.‡Löscht 5 Feuer mit Wassereimern und sprecht anschließend mit der maskierten Waisenmatrone beim Falkenplatz.‡물동이를 던져 불을 5번 끄고, 매날개 광장에 있는 가면 쓴 보육원 원장님과 대화해야 합니다.‡Echa cubos de agua en 5 hogueras y habla con la supervisora de huérfanos enmascarada en Plaza Alalcón.‡Echa cubos de agua en 5 hogueras y habla con la supervisora de huérfanos enmascarada en Plaza Alalcón.‡Jetez des Seaux d’eau sur 5 feux, puis retournez voir la Directrice d\'orphelinat masquée sur la Place de l\'Épervier.‡将小水桶里的水倒在5处火盆上，然后回到鹰翼广场，与戴面具的孤儿院长谈一谈。‡把水桶扔向5個火源，然後再和獵鷹之翼廣場的戴面具的孤兒監護員談談。',
  }
},
[11451] = {
  {
    'Poema de Alícia‡Стишок Алисии‡Alicias Gedicht‡알리시아의 시‡El poema de Alicia‡El poema de Alicia‡Le poème d\'Alicia‡奥利卡的诗‡艾利西亞之詩',
    nil,
    'Pediram para você entregar o Poema de Alícia para Caylee Dak na cidade de Shattrath, que fica em Terralém.‡Вас попросили отнести стишок Алисии Кайли Дак в Шаттрат в Запределье.‡Man hat Euch gebeten, Alicias Gedicht zu Caylee Dak in Shattrath in der Scherbenwelt zu bringen.‡알리시아가 아웃랜드의 샤트라스에 있는 케일리 닥에게 알리시아의 시를 가져다 달라고 했습니다.‡Debes llevar el poema de Alicia a Caylee Dak en la Ciudad de Shattrath, Terrallende.‡Debes llevar el poema de Alicia a Caylee Dak en la Ciudad de Shattrath, Terrallende.‡Alicia vous a demandé d\'apporter son poème à Caylee Dak à Shattrath en Outreterre.‡将奥利卡的诗交给外域沙塔斯城中的凯莉·达克。‡你被要求把艾利西亞之詩帶給外域撒塔斯城的凱莉·達克。',
  }
},
[11452] = {
  {
    'O rei adormecido‡Спящий король‡Der schlummernde König‡잠자는 왕‡El rey durmiente‡El rey durmiente‡Le roi endormi‡沉睡的国王‡沉睡的國王',
    nil,
    'Derrote a Rainha Angerboda e interrompa o ritual para despertar o Rei Ymiron. Caso consiga fazê-lo, retorne à Bastilha da Guarda Oeste e relate o sucesso da missão para o Capitão Carneiro.‡Убейте королеву Ангербоду и прервите ритуал пробуждения короля Имирона. Если вам удастся сделать это, вернитесь в Крепость Западной Стражи и доложите о своей победе капитану Адамсу.‡Besiegt Königin Angerboda und haltet das Ritual, mit dem König Ymiron beschwört werden soll, auf. Kehrt nach Westwacht zurück, falls Euch dies gelingen sollte, und setzt Hauptmann Adams über Euren Erfolg in Kenntnis.‡여왕 앵거보다를 처치하여 왕 이미론을 깨우는 의식을 중단시키고 서부경비대 성채로 돌아가 경비대장 아담스에게 보고해야 합니다.‡Vence a la reina Inquinoda y detén el ritual para despertar al rey Ymiron. Si lo consigues, vuelve a la Fortaleza de la Guardia Oeste e informa al capitán Adams de tu éxito.‡Vence a la reina Inquinoda y detén el ritual para despertar al rey Ymiron. Si lo consigues, vuelve a la Fortaleza de la Guardia Oeste e informa al capitán Adams de tu éxito.‡Triomphez de la Reine Angrboda et arrêtez le rituel destiné à éveiller le Roi Ymiron. Si vous y parvenez, retournez au Donjon de la Garde de l’ouest et annoncez votre succès au Capitaine Adams.‡击败安格博达女王并阻止唤醒伊米隆国王的仪式。完成任务后，回到西部卫戍要塞向亚当斯上尉复命。‡擊敗安格博妲王后並且阻止喚醒依米倫王的儀式。如果你成功的話，回到鎮西要塞向亞當斯隊長回報。',
  }
},
[11453] = {
  {
    'O rei adormecido‡Спящий король‡Der schlummernde König‡잠자는 왕‡El rey durmiente‡El rey durmiente‡Le roi endormi‡沉睡的国王‡沉睡的國王',
    nil,
    'Derrote a Rainha Angerboda e interrompa o ritual para despertar o Rei Ymiron. Caso consiga fazê-lo, volte à Aldeia Casco Invernal e relate o sucesso da missão para o Chefe Totem de Cinzas.‡Убейте королеву Ангербоду и прервите ритуал пробуждения короля Имирона. Если вам удастся сделать это, вернитесь в Лагерь Заиндевевшего Копыта и сообщите о своей победе вождю Прахтотему.‡Besiegt Königin Angerboda und haltet das Ritual, mit dem König Ymiron beschwört werden soll, auf. Kehrt zum Lager der Winterhufe zurück, falls Euch dies gelingen sollte, und berichtet Häuptling Aschtotem über Euren Erfolg.‡여왕 앵거보다를 처치하여 왕 이미론을 깨우는 의식을 중단시키고 겨울발굽 야영지로 돌아가 족장 애쉬토템에게 보고해야 합니다.‡Vence a la reina Inquinoda y detén el ritual para despertar al rey Ymiron. Si lo consigues, vuelve al Campamento Pezuña Invernal e informa al cabecilla Tótem de Ceniza de tu éxito.‡Vence a la reina Inquinoda y detén el ritual para despertar al rey Ymiron. Si lo consigues, vuelve al Campamento Pezuña Invernal e informa al cabecilla Tótem de Ceniza de tu éxito.‡Triomphez de la Reine Angrboda et arrêtez le rituel destiné à éveiller le Roi Ymiron. Si vous y parvenez, retournez au Camp Sabot-d’hiver et annoncez votre succès au Chef Totem-de-frêne.‡击败安格博达女王并阻止唤醒伊米隆国王的仪式。完成任务后，回到冬蹄营地向灰烬图腾酋长复命。‡擊敗安格博妲王后並且阻止喚醒依米倫王的儀式。如果你成功的話，回到冬蹄營地向灰燼圖騰酋長回報。',
  }
},
[11454] = {
  {
    'Procure os sabotadores‡Поиски диверсантов‡Findet die Saboteure‡훼방꾼 수색‡Busca a los saboteadores‡Busca a los saboteadores‡Trouver les saboteurs‡寻找主谋‡尋找破壞者',
    nil,
    'Encontre Coren Cervatroz no Glutão Implacável, que fica dentro do Abismo Rocha Negra.‡Найдите Худовара в "Угрюмом обжоре" в Глубинах Черной горы.‡Sucht nach Coren Düsterbräu im Grimmigen Säufer in den Schwarzfelstiefen.‡검은바위 나락에 있는 험상궂은 주정뱅이 선술집에서 코렌 다이어브루를 찾아야 합니다.‡Encuentra a Coren Cerveza Temible en Tragapenas, dentro de las Profundidades de Roca Negra.‡Encuentra a Coren Cerveza Temible en Tragapenas, dentro de las Profundidades de Roca Negra.‡Trouver Coren Navrebière dans le Sinistre écluseur, à l\'intérieur des Profondeurs de Rochenoire.‡在黑石深渊的酒吧中找到科林·烈酒。‡在黑石深淵的黑鐵酒吧中找到寇仁·恐酒。',
  }
},
[11455] = {
  {
    'Cheirinho de dinheiro‡Запах денег‡Der Duft des Goldes‡돈의 향기‡El olor del dinero‡El olor del dinero‡L\'odeur de l\'argent‡金币的芳香‡錢的氣味',
    nil,
    'Téo Bonitão, da Angra dos Malandros, no Fiorde Uivante, quer que você pegue 4 Almíscares de Urso dos Ursos Pardos Raivosos das cercanias.‡Красавчик Терри из Лагеря Скалаваг в Ревущем фьорде просит вас добыть 4 мускусные железы бешеных бурых медведей, которые бродят по всему острову.‡Der hübsche Terry im Halunkeneck im Heulenden Fjord möchte, dass Ihr 4 Einheiten Bärenmoschus von den tollwütigen Braunbären in der Gegend besorgt.‡울부짖는 협만의 해적 야영지에 있는 잘생긴 테리가 주변 지역의 광포한 불곰으로부터 불곰 사향 4개를 구해달라고 했습니다.‡Terry el Hermoso del Cabo Pillastre del Fiordo Aquilonal quiere que consigas 4 muestras de almizcle de oso de los osos marrones rabiosos que se encuentran en los aledaños.‡Terry el Hermoso del Cabo Pillastre del Fiordo Aquilonal quiere que consigas 4 muestras de almizcle de oso de los osos marrones rabiosos que se encuentran en los aledaños.‡Terry le beau gosse, du Cap du Forban, vous demande de lui rapporter 4 échantillons de Musc d\'ours prélevés sur les Ours bruns enragés des environs.‡无赖港里的帅哥泰里要你从附近的狂暴棕熊身上收集4份熊麝香。‡凜風峽灣，無賴角的帥哥泰瑞要你在附近從狂暴棕熊身上取得4個野熊麝香。',
  }
},
[11456] = {
  {
    'Para alimentar os sobreviventes‡Мясо для выживших‡Den Überlebenden zu essen geben‡생존자 원조‡Alimentar a los supervivientes‡Alimentar a los supervivientes‡Nourrir les rescapés‡难民的食物‡餵飽倖存者',
    nil,
    'O Ancião Atuik, de Kamagua, no Fiorde Uivante, quer que você consiga 6 pedaços de Carne de Cavacorne da Ilha na Ilha das Lanças.‡Предок Атуик из Камагуа в Ревущем фьорде просит вас принести 6 кусков мяса островного черпорога с Острова Копий.‡Urahn Atuik in Kamagua im Heulenden Fjord möchte, dass Ihr zur Insel der Speere geht und ihm 6 Stück Fleisch eines Inselschaufelhauers beschafft.‡울부짖는 협만의 카마구아에 있는 장로 아투이크가 작살잡이 섬에 서식하는 섬 뾰족엄니 고기 6조각을 구해다 달라고 했습니다.‡El ancestro Atuik de Komawa, en el Fiordo Aquilonal, quiere que consigas 6 trozos de carne de colmipala de isla de los colmipala de isla que moran en La Isla de las Lanzas.‡El ancestro Atuik de Komawa, en el Fiordo Aquilonal, quiere que consigas 6 trozos de carne de colmipala de isla de los colmipala de isla que moran en La Isla de las Lanzas.‡L’Ancien Atuik, à Kamagua dans le Fjord Hurlant, veut que vous récupériez 6 morceaux de Viande de brochepelle insulaire sur des Brochepelles insulaires de l’Île des Lances.‡卡玛古的长者阿图伊克要你前往长矛岛，从长矛岛铲齿鹿身上收集6份长矛岛铲齿鹿肉。‡卡瑪廓的長者阿推克要你從群矛之島的海島鍬牙身上取得6個海島鍬牙肉。',
  }
},
[11457] = {
  {
    'Armas para Kamagua‡Вооружая Камагуа‡Kamagua bewaffnen‡카마구아 무장 강화‡Armar a Komawa‡Armar a Komawa‡Armer Kamagua‡卡玛古的武装‡卡瑪廓備戰',
    nil,
    'O Ancião Atuik quer que você pegue 3 Chifres de Quimera.‡Старейшина Атуик просит вас добыть 3 рога химеры.‡Urahn Atuik möchte, dass Ihr ihm 3 Schimärenhörner beschafft.‡장로 아투이크가 키메라 뿔 3개를 구해달라고 했습니다.‡El ancestro Atuik quiere que consigas 3 cuernos de quimera.‡El ancestro Atuik quiere que consigas 3 cuernos de quimera.‡L’Ancien Atuik veut que vous récupériez 3 Cornes de chimères.‡长者阿图伊克要你去收集3根奇美拉角。‡長者阿推克需要你取得3根奇美拉角。',
  }
},
[11458] = {
  {
    'Vingança para Iskaal‡Месть за Искаал‡Rache für Iskaal‡이스카알의 복수‡Vengar a Iskaal‡Vengar a Iskaal‡Venger Iskaal‡伊斯卡尔的复仇‡為伊斯考復仇',
    nil,
    'O Ancião Atuik quer que você vá até Iskaal e mate 8 Feitores do Mar Norte. Use a Trompa de Kamagua caso precise de ajuda.‡Старейшина Атуик просит вас отправиться в Искаал и убить 8 поработителей – пиратов Северных морей. Если вам понадобится помощь, воспользуйтесь Рогом Камагуа.‡Urahn Atuik möchte, dass Ihr nach Iskaal geht und 8 Sklavenhändler des Nordmeeres niederstreckt. Macht von dem Horn von Kamagua Gebrauch, solltet Ihr Unterstützung benötigen.‡장로 아투이크가 이스카알에 가서 광기 어린 북쪽바다 노예사냥꾼 8명을 제거해 달라고 했습니다. 도움이 필요할 때는 카마구아의 뿔피리를 사용하십시오.‡El ancestro Atuik quiere que vayas a Iskaal y mates a 8 esclavistas del Mar del Norte. Utiliza el cuerno de Komawa si necesitas ayuda.‡El ancestro Atuik quiere que vayas a Iskaal y mates a 8 esclavistas del Mar del Norte. Utiliza el cuerno de Komawa si necesitas ayuda.‡L’Ancien Atuik veut que vous alliez à Iskaal et que vous tuiez 8 Esclavagistes des mers du Nord. En cas de besoin, sonnez du Cor de Kamagua.‡长者阿图伊克要你前往伊斯卡尔，消灭8个疯狂的北海奴隶贩子。如果你需要帮助，可以吹响卡玛古号角。‡長者阿推克需要你去伊斯考殺掉8名北海奴隸販子，當你需要協助的時候吹響卡瑪廓號角。',
  }
},
[11459] = {
  {
    'Fala, Zeh\'gehn!‡Что сказал Зех\'ген‡Zeh\'gehn sachd‡제겐이 말하길‡Zeh\'gehn dice‡Zeh\'gehn dice‡Zeh\'gehn li pale‡塞吉说……‡賽吉恩說',
    nil,
    'Fale novamente com Téo Bonitão para decifrar o que Zeh\'gehn pediu para você.‡Вернитесь к Красавчику Терри и попросите объяснить, что хотел от вас Зех\'ген.‡Kehrt zum hübschen Terry zurück, um herauszufinden, was Zeh\'gehn von Euch will.‡잘생긴 테리에게 돌아가 제겐이 한 말을 해석해야 합니다.‡Ve a ver a Terry el Hermoso para descifrar lo que te ha pedido Zeh\'gehn.‡Ve a ver a Terry el Hermoso para descifrar lo que te ha pedido Zeh\'gehn.‡Retournez voir Terry le beau gosse pour comprendre ce que vous demande Zeh’gehn.‡回去向帅哥泰里询问塞吉到底想要些什么。‡回到帥哥泰瑞身邊，請他解釋賽吉恩說了些什麼。',
  }
},
[11460] = {
  {
    'Confiança se conquista‡Завоевание доверия‡Vertrauen will verdient sein‡신뢰 얻기‡La confianza hay que ganársela‡La confianza hay que ganársela‡La confiance, ça se mérite‡获得信任‡贏得信賴',
    nil,
    'Hidalgo, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você encontre uma Larva do Fiorde e a dê como alimento aos falcões engaiolados perto dele.‡Идальго из Лагеря Лиги исследователей в Ревущем фьорде послал вас найти червяка фьорда и скормить его одному из соколов в клетке, стоящей у его ног.‡Hidalgo im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr nach einer Fjordlarve sucht und sie an einen der Falken im Käfig zu seinen Füßen verfüttert.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 히달고가 협만 지렁이를 찾아 그의 발치에 있는 새장 안의 매에게 먹여달라고 했습니다.‡Hidalgo en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que encuentres una larva de fiordo y se la des a uno de los falcones en la jaula que tiene a sus pies.‡Hidalgo en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que encuentres una larva de fiordo y se la des a uno de los falcones en la jaula que tiene a sus pies.‡Hidalgo, de l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous trouviez une Larve du fjord et que vous vous en serviez pour nourrir l’un des éperviers de la cage qui se trouve à ses pieds.‡嚎风峡湾探险者协会哨站的希达尔格要你用一只峡湾幼虫喂养关在他脚边笼子里的猎鹰。‡海達戈要你找一隻峽灣幼蛆來餵飽他腳邊籠子中的獵鷹，他就在凜風峽灣的探險者協會前哨。',
  }
},
[11462] = {
  {
    '‡Красавчик Терри‡Der hübsche Terry‡잘생긴 테리‡Terry el Hermoso‡Terry el Hermoso‡Terry le beau gosse‡帅哥泰里‡帥哥泰瑞',
    nil,
    '‡Наденьте костюм пирата и поговорите с Красавчиком Терри в Лагере Скалаваг.‡Schlüpft in die Piratenverkleidung und sprecht mit dem hübschen Terry im Halunkeneck.‡‡Ponte el disfraz de pirata y habla con Terry el Hermoso en el Cabo Pillastre.‡Ponte el disfraz de pirata y habla con Terry el Hermoso en el Cabo Pillastre.‡Enfilez le Déguisement de pirate et allez voir Terry le beau gosse au Cap du Forban.‡‡',
  }
},
[11463] = {
  {
    '‡Пираты Северных морей‡Piraten der Nordmeere‡북해의 해적‡Piratas del Mar del Norte‡Piratas del Mar del Norte‡Les pirates des mers du nord‡‡',
    nil,
    '‡Найдите Греззикса Иглохруста на северной части Рифа Гарвана. Риф находится на юго-западном побережье Ревущего фьорда.‡Sucht nach Grezzix Achsenbruch. Er befindet sich am nördlichen Ende von Garwans Riff vor der südwestlichen Küste des Heulenden Fjords.‡울부짖는 협만의 남서쪽 해안에 있는 가반의 산호초 북쪽 끝에서 그레직스 스핀들스냅을 찾아야 합니다.‡Encuentra a Grezzix Morthadellix en el extremo norte del Arrecife de Garvan, en la costa sudoeste del Fiordo Aquilonal.‡Encuentra a Grezzix Morthadellix en el extremo norte del Arrecife de Garvan, en la costa sudoeste del Fiordo Aquilonal.‡Trouvez Grezzix Claquefuseau à la pointe nord du Récif de Garvan au large de la côte sud-ouest du Fjord hurlant.‡‡',
  }
},
[11464] = {
  {
    'Dívida é promessa‡Карточный долг‡Spielschulden‡도박 빚‡Deuda de juego‡Deuda de juego‡Une dette de jeu‡赌债‡賭債',
    nil,
    'Taruk, da Angra dos Malandros, quer que você cobre a dívida de Rique "Luaprata".‡Тарук из Лагеря Скалаваг просит вас взыскать долг Гарри "Луносвета".‡Taruk im Halunkeneck möchte, dass Ihr die Schulden von "Silbermond" Harry eintreibt.‡해적 야영지에 있는 타루크가 "실버문" 해리의 빚을 받아다 달라고 했습니다.‡Taruk del Cabo Pillastre quiere que cobres la deuda de Harry "Lunargenta".‡Taruk del Cabo Pillastre quiere que cobres la deuda de Harry "Lunargenta".‡Taruk, au Cap du Forban, veut que vous récupériez la Dette de Harry « Lune-d’argent ».‡无赖港的塔鲁克希望你帮他讨回“银月”哈瑞的赌债。‡無賴角的塔廬克要你去拿回『銀月』哈利的欠款。',
  }
},
[11465] = {
  {
    'A caravana saqueada‡Разграбленный караван‡Die geplünderte Karawane‡칠면조 사냥‡La caravana saqueada‡La caravana saqueada‡La caravane saccagée‡被袭击的车队‡被洗劫的商隊',
    nil,
    'Hidalgo, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use o Falcão das Rochas Adestrado para recolher 5 Perus do Fiorde.|n|nFale novamente com Hidalgo, levando a gaiola, ao terminar a tarefa.‡Идальго из Лагеря Лиги исследователей в Ревущем Фьорде попросил вас поймать 5 индюков фьорда с помощью обученного скального сокола. |n|nКак только поручение будет выполнено, верните клетку сокольничему.‡Hidalgo im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr mithilfe des dressierten Steinfalkens 5 Fjordtruthähne einfangt.|n|nKehrt zu Hidalgo zurück, sobald Ihr Eure Aufgabe erfüllt habt, und bringt den Käfig mit.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 히달고가 길들인 바위매를 사용해 협만 칠면조 5마리를 사냥해 달라고 했습니다.|n|n임무를 마친 다음 새장을 가지고 히달고에게 가야 합니다.‡Hidalgo en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses el falcón de roca adiestrado para recuperar 5 pavos de fiordo.|n|nRegresa a ver a Hidalgo con la jaula cuando hayas completado esta tarea.‡Hidalgo en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses el falcón de roca adiestrado para recuperar 5 pavos de fiordo.|n|nRegresa a ver a Hidalgo con la jaula cuando hayas completado esta tarea.‡Hidalgo, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous vous serviez de votre Epervier des rochers apprivoisé pour capturer 5 Dindes du Fjord.|n|nLorsque ce sera fait, retournez voir Hidalgo avec la cage.‡嚎风峡湾探险者协会哨站的希达尔格要你利用训练过的岩石猎鹰捕捉5只峡湾火鸡。|n|n完成任务后将笼子交给希达尔格。‡海達戈要你使用訓練過的石隼來抓回5隻峽灣火雞，他就在凜風峽灣的探險者協會前哨。|n|n一旦你完成任務請帶著籠子回報。',
  }
},
[11466] = {
  {
    'Johnny toma todas‡Стаканчик для Джека‡Jack hebt gern\' mal einen‡주정뱅이 잭‡A Jack le gusta su bebida‡A Jack le gusta su bebida‡Jack aime trop la bouteille‡嗜酒的杰克‡傑克喜歡他的飲料',
    nil,
    'Taruk, da Angra dos Malandros, no Fiorde Uivante, quer que você cobre a Dívida de Johnny Daniels.‡Тарук из Лагеря Скалаваг просит вас взыскать долг Джека Адамса.‡Taruk im Halunkeneck im Heulenden Fjord möchte, dass Ihr Jack Adams\' Schulden eintreibt.‡울부짖는 협만의 해적 야영지에 있는 타루크가 잭 아담스의 빚을 받아다 달라고 했습니다.‡Taruk del Cabo Pillastre quiere que cobres la deuda de Jack Adams.‡Taruk del Cabo Pillastre quiere que cobres la deuda de Jack Adams.‡Taruk, au Cap du Forban, veut que vous récupériez la Dette de Jack Adams.‡无赖港的塔鲁克希望你帮他讨回杰克·亚当的赌债。‡塔廬克要你去拿回傑克·亞當斯的欠款，他就在凜風峽灣的無賴角。',
  }
},
[11467] = {
  {
    'Cliente morto também paga‡Долг мертвеца‡Des toten Mannes Schulden‡망자의 빚‡La deuda de un hombre muerto‡La deuda de un hombre muerto‡La dette du mort‡死人的债务‡死人的賭債',
    nil,
    'Taruk, da Angra dos Malandros, quer que você procure o Tesouro de Conrado Negro no platô na extremidade noroeste da Ilha das Lanças, a norte de Iskaal.‡Тарук из Лагеря Скалаваг просит вас выкопать сокровище Блэка Конрада с северо-восточного побережья острова Копий, что к северу от Искаала.‡Taruk im Halunkeneck will, dass Ihr auf dem Plateau am nordöstlichen Ende der Insel der Speere gleich nördlich von Iskaal auf die Suche nach dem Schatz des Schwarzen Konrad geht.‡해적 야영지의 타루크가 작살잡이 섬 북동쪽 끝, 이스카알 바로 북쪽에 있는 고원에서 검은 콘라드의 보물을 찾아와 달라고 했습니다.‡Taruk del Cabo Pillastre quiere que busques el tesoro de Jack Conrad en la meseta del extremo noreste de la Isla de las Lanzas, al norte de Iskaal.‡Taruk del Cabo Pillastre quiere que busques el tesoro de Jack Conrad en la meseta del extremo noreste de la Isla de las Lanzas, al norte de Iskaal.‡Taruk, au Cap du Forban, veut que vous retrouviez le Trésor de Conrad le Noir, sur le plateau à l\'extrémité nord-est de l’Île des Lances, au nord d\'Iskaal.‡无赖港的塔鲁克要你前往伊斯卡尔以北的长矛岛，在该岛的东北尽头寻找康纳德的宝藏。‡無賴角的塔廬克要你尋找黑色康拉德的寶藏，在群矛之島東北角的高原上，就在伊斯考的北方。',
  }
},
[11468] = {
  {
    'Falcão versus águia‡Ястреб против сокола‡Falke gegen Habicht‡매와 매의 대결‡Falcón contra halcón‡Falcón contra halcón‡Faucon contre épervier‡鹰隼之战‡獵鷹對隼鷹',
    nil,
    'Hidalgo, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use o Falcão das Rochas Adestrado para capturar 10 Águias do Fiorde.|n|nFale novamente com Hidalgo, levando a gaiola, ao terminar a tarefa.‡Идальго из Лагеря Лиги исследователей в Ревущем фьорде просит вас поймать 10 ястребов фьорда с помощью вашего обученного скального сокола.|n|nКогда вы выполните это задание, верните Идальго клетку с соколом.‡Hidalgo am Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr Euren dressierten Steinfalken nutzt, um 10 Fjordhabichte zu erbeuten.|n|nKehrt mit dem Käfig zu Hidalgo zurück, wenn Ihr die Aufgabe Abgeschlossen habt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 히달고가 길들인 바위매를 사용해 협만 매 10마리를 사냥해 달라고 했습니다.|n|n임무를 마친 다음 새장 옆에 있는 히달고에게 가야 합니다.‡Hidalgo, en la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal, quiere que uses a tu falcón de roca adiestrado para capturar 10 halcones de fiordo.|n|nCuando hayas terminado, vuelve a ver a Hidalgo.|n‡Hidalgo, en la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal, quiere que uses a tu falcón de roca adiestrado para capturar 10 halcones de fiordo.|n|nCuando hayas terminado, vuelve a ver a Hidalgo.|n‡Hidalgo, de l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez votre Epervier des rochers apprivoisé pour capturer 10 Faucons du Fjord.|n|nLorsque ce sera fait, retournez voir Hidalgo avec la cage.‡嚎风峡湾探险者协会哨站的希达尔格要你利用训练过的岩石猎鹰捕捉10只峡湾隼。|n|n完成任务后将笼子交给希达尔格。‡凜風峽灣，探險者協會前哨的海達戈要你使用訓練過的石隼去捕抓10隻峽灣隼鷹。|n|n完成任務後，帶著籠子回去找海達戈。',
  }
},
[11469] = {
  {
    'Sabão milagroso‡Мыло для чистки палуб‡Schrubbseife‡걸레질 비누‡Jabón‡Jabón‡Le savon à briquer‡制作肥皂的原料‡清潔肥皂',
    nil,
    'Pipa Proafria quer que você pegue a Gordura do Grande Roy para ser o ingrediente principal do seu sabão milagroso. Quando conseguir, fale novamente com ela no navio pirata da Angra dos Malandros.‡Побегушка Мерзлонос просит вас принести ей сальник Большого Роя, чтобы она могла сварить из него мыло для чистки палуб. Она ждет вас на восточном пиратском корабле в Лагере Скалаваг.‡Lukchen Frostbug will, dass Ihr Tran vom fetten Roy besorgt, als Hauptbestandteil ihrer magischen Schrubbseife. Kehrt zu ihr auf das östliche Piratenschiff beim Halunkeneck zurück, wenn Ihr ihn habt.‡해적 야영지에 있는 스커틀 프로스트프로우가 마법 걸레질 비누의 주 재료로 사용할 거대한 로이의 지방덩어리를 구해달라고 했습니다.‡Nanash Proahelada quiere que consigas la grasa del Gran Roy, ingrediente principal para su jabón mágico. Cuando la tengas, vuelve a verla al barco pirata que se encuentra al este, en el Cabo Pillastre.‡Nanash Proahelada quiere que consigas la grasa del Gran Roy, ingrediente principal para su jabón mágico. Cuando la tengas, vuelve a verla al barco pirata que se encuentra al este, en el Cabo Pillastre.‡Sabord Givreproue veut que vous récupériez la Graisse de Gros Roy, l’ingrédient principal de son savon à briquer magique. Lorsque vous l’aurez, retournez la voir au vaisseau pirate le plus à l’est du Cap du Forban.‡斯卡特·弗洛斯普要你取回制作魔法肥皂的主要原料——大个子罗伊的脂肪。完成任务后返回无赖港东边的海盗船向她复命。‡史加斗·霜首要你去拿大羅伊的油脂作為他魔法清潔肥皂的主要材料。等你拿到之後，回到無賴角東邊的海賊船找她。',
  }
},
[11470] = {
  {
    'Entre aves não há honra‡Птицы не знают о чести‡Unter dem Vogelvieh gibt es keine Ehre‡새에게는 명예가 없다‡No hay honor entre los pájaros‡No hay honor entre los pájaros‡Les oiseaux n\'ont pas d\'honneur‡鸟类可不管什么荣耀！‡鳥群間沒有榮譽存在',
    nil,
    'Hidalgo, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use o Falcão das Rochas Adestrado para roubar 8 Ovos de Águias do Fiorde.|n|nFale novamente com Hidalgo, levando a gaiola, ao terminar a tarefa.‡Идальго из Лагеря Лиги исследователей в Ревущем фьорде поручил вам выкрасть восемь яиц ястреба фьорда с помощью вашего обученного скального сокола.|n|nКогда вы выполните задание, верните Идальго клетку с соколом.‡Hidalgo im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr mithilfe Eures dressierten Steinfalkens 8 Eier eines Fjordhabichts sammelt.|n|nKehrt zu Hidalgo zurück, sobald Ihr Eure Aufgabe erfüllt habt, und nehmt den Käfig mit.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 히달고가 길들인 바위매를 사용해 협만 매 알 8개를 가져다 달라고 했습니다.|n|n임무를 마친 다음 새장 옆에 있는 히달고에게 가야 합니다.‡Hidalgo en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses tu falcón de roca adiestrado para capturar 8 huevos de halcón de fiordo.|n|nRegresa junto a Hidalgo con la jaula cuando hayas completado esta tarea.‡Hidalgo en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses tu falcón de roca adiestrado para capturar 8 huevos de halcón de fiordo.|n|nRegresa junto a Hidalgo con la jaula cuando hayas completado esta tarea.‡Hidalgo, de l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez votre Épervier des rochers apprivoisé pour vous emparer de 8 Œufs de faucons du fjord.|n|nLorsque ce sera fait, retournez voir Hidalgo avec la cage.‡嚎风峡湾探险者协会哨站的希达尔格要你利用训练过的岩石猎鹰偷取8枚峡湾隼的卵。|n|n完成任务后将笼子交给希达尔格。‡海達戈要你使用訓練過的石隼來抓回8個峽灣隼鷹蛋，他就在凜風峽灣的探險者協會前哨。|n|n等你完成任務後，帶著籠子回去找海達戈。',
  }
},
[11471] = {
  {
    'Acabou a palhaçada‡Конец игры‡Jetzt geht\'s lo-os‡이젠 끝장을 볼 때‡Se acabó lo que se daba‡Se acabó lo que se daba‡Le rideau tombe‡取而代之‡魚兒上勾',
    nil,
    'Annie Bonn, da Angra dos Malandros, quer que você traga para ela a Luneta de Jonas Esterlino.‡Энни Бонн из Лагеря Скалаваг хочет, чтобы вы принесли ей подзорную трубу Ионы Стерлинга.‡Annie Bonn im Halunkeneck möchte, dass Ihr Jonah Sterlings Handfernrohr zu ihr bringt.‡해적 야영지에 있는 애니 본이 조나 스털링의 망원경을 가져다 달라고 했습니다.‡Annie Bonn del Cabo Pillastre quiere que le traigas el catalejo de Jonah Sterling.‡Annie Bonn del Cabo Pillastre quiere que le traigas el catalejo de Jonah Sterling.‡Annie Bonn du Cap du Forban vous demande de lui apporter la Longue-vue de Jonas Sterling.‡无赖港的安妮·波恩要你把“疯狗”约纳·斯特林的望远镜交给她。‡無賴角的安妮·波恩要你將喬納·斯德林的望遠鏡帶給她。',
  }
},
[11472] = {
  {
    'Caminhos do coração‡Путь к его сердцу...‡Der Weg zu seinem Herzen...‡마음 가는 대로...‡El camino a su corazón...‡El camino a su corazón...‡Le chemin de son cœur…‡心心相印……‡傳遞心意……',
    nil,
    'Jogue Deliciosos Peixes-do-recife para um Leão-do-recife e conduza-o até uma Leoa-do-recife. Depois que você tiver ajudado os dois a encontrar o amor verdadeiro, fale novamente com Anuniaq, em Kamagua.‡Подкиньте несколько вкусных рифовых рыб рифовому буйволу, чтобы он последовал за вами к рифовой корове. Когда эти двое одиноких сердец найдут друг друга, вернитесь к Ануниаку в Камагуа.‡Werft einem Riffbullen schmackhafte Rifffische zu, um ihn zu einer Riffkuh zu führen. Habt Ihr den Zweien verholfen, wahre Liebe zu finden, dann kehrt zu Anuniaq in Kamagua zurück.‡맛있는 모래톱 물고기를 모래톱 바다표범 수컷에게 던져 모래톱 바다표범 암컷이 있는 곳으로 데려가, 두 마리가 서로 사랑에 빠지면 카마구아에 있는 아누니아크에게 가야 합니다.‡Lanza peces de arrecife ricos a un macho dominante de arrecife para atraerlo hasta una hembra de arrecife. Cuando hayas ayudado a los dos a encontrar el amor verdadero, vuelve a ver a Anuniaq en Komawa.‡Lanza peces de arrecife ricos a un macho dominante de arrecife para atraerlo hasta una hembra de arrecife. Cuando hayas ayudado a los dos a encontrar el amor verdadero, vuelve a ver a Anuniaq en Komawa.‡Lancez de Délicieux poissons des récifs à une Otarie des récifs mâle pour la conduire à une femelle. Lorsque vous aurez aidé ce couple à trouver l’amour, retournez voir Anuniaq à Kamagua.‡利用美味的暗礁鱼将雄性暗礁海狮引到雌性暗礁海狮身边。帮助它们找到真爱后，返回嚎风峡湾的卡玛古，向阿努尼克复命。‡對暗礁公海獅丟擲美味的暗礁魚好將牠引往一隻暗礁母海獅。一旦你幫助牠們找到真愛，就回到卡瑪廓找安努尼亞克。',
  }
},
[11473] = {
  {
    'Um traidor entre nós‡Предатель среди нас‡Ein Verräter unter uns‡우리 중에 배신자 있다‡Un traidor entre nosotros‡Un traidor entre nosotros‡Il y a un traître parmi nous‡有内鬼！‡叛徒潛伏',
    nil,
    'Fale com Zeh\'gehn na Angra dos Malandros.‡Поговорите с Зех\'геном в Лагере Скалаваг.‡Sprecht mit Zeh\'gehn im Halunkeneck.‡해적 야영지에 있는 제겐과 대화해야 합니다.‡Habla con Zeh\'gehn del Cabo Pillastre.‡Habla con Zeh\'gehn del Cabo Pillastre.‡Parlez à Zeh’gehn au Cap du Forban.‡与无赖港的塞吉谈一谈。‡和無賴角的賽吉恩談談。',
  }
},
[11474] = {
  {
    'Problemas no alto do penhasco‡Беда на Крутых утесах‡Ärger am hohen Kliff‡높은 절벽 위의 난관‡Problemas en la cima alta‡Problemas en la cima alta‡Des problèmes au sommet‡悬崖上的麻烦‡高聳峭壁上的問題',
    nil,
    'Fale com Walt.‡Поговорите с Уолтом.‡Sprecht mit Walt.‡왈트와 대화해야 합니다.‡Habla con Walt.‡Habla con Walt.‡Parlez à Walt.‡与沃尔特谈一谈。‡與渥特談談。',
  }
},
[11475] = {
  {
    'Ferramentas para resolver o problema‡Орудия труда‡Das nötige Werkzeug für den Job‡작업을 위한 공구‡Herramientas para hacer el trabajo‡Herramientas para hacer el trabajo‡Il nous faut des outils pour faire le boulot‡必需的工具‡完成工作的工具',
    nil,
    'O Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você recupere as Ferramentas de Construção dele.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас вернуть его строительные инструменты.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr seine Bauwerkzeuge beschafft.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 작업용 공구를 되찾아 달라고 했습니다.‡Walt en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que recuperes sus herramientas de construcción.‡Walt en la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que recuperes sus herramientas de construcción.‡Walt, de l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous récupériez ses Outils de construction.‡嚎风峡湾探险者协会哨站的沃尔特要求你取回他的建造工具。‡凜風峽灣，探險者協會前哨的渥特要你去取回他的建造工具。',
  }
},
[11476] = {
  {
    'Uma faca e um sapo‡Нож и лягушка‡Ein Frosch und ein Messer‡개굴이와 조각칼‡Un cuchillo y un croador‡Un cuchillo y un croador‡Un coupe-coupe et une coasseuse‡呱呱叫的和刮东西的‡切切和呱呱',
    nil,
    'Pegue a Faca Reluzente do Rique Luaprata e capture um Sapo Malandro. Leve os objetos para Zeh\'gehn, na Angra dos Malandros.‡Купите блестящий нож у Гарри "Луносвета" и поймайте скалавагскую лягушку. Отнесите все это Зех\'гену в Лагерь Скалаваг.‡Besorgt Euch ein glänzendes Messer von "Silbermond" Harry und fangt einen Ganovenfrosch. Bringt dann beides zu Zeh\'Gehn im Halunkeneck.‡"실버문" 해리에게서 빤질빤질한 칼을 받아 해적 야영지 개구리를 잡은 후, 해적 야영지에 있는 제겐에게 가져가야 합니다.‡Consigue un cuchillo lustroso de Harry "Lunargenta" y captura una rana del Cabo Pillastre. Llévaselos a Zeh\'Gehn en el Cabo Pillastre.‡Consigue un cuchillo lustroso de Harry "Lunargenta" y captura una rana del Cabo Pillastre. Llévaselos a Zeh\'Gehn en el Cabo Pillastre.‡Procurez-vous un Couteau rutilant auprès de Harry « Lune-d\'argent » et capturez une Grenouille des forbans. Apportez tout cela à Zeh\'Gehn au Cap du Forban.‡向“银月”哈瑞要一把闪亮的小刀，并抓一只无赖蛙。把它们交给无赖港的塞吉。‡從『銀月』哈利那邊拿到一把閃亮小刀，然後抓一隻無賴蛙。把這些交給無賴角的賽吉恩。',
  }
},
[11477] = {
  {
    'Meio inadequado?‡Дворф другой породы‡Nicht in meinem Element?‡소질이 없다고?‡¿Fuera de mi elemento?‡¿Fuera de mi elemento?‡Hors de mon élément ?‡不自量力？‡非我族群?',
    nil,
    'Donny, da Ruína de Ivald, no Fiorde Uivante, quer que você mate 10 Destruidores da Runa Férrea, 5 Operários da Runa Férrea e 2 Sábios da Runa Férrea.‡Донни из Руин Ивальда в Ревущем фьорде просит вас убить 10 разрушителей из клана Железной Руны, 5 работников из клана Железной Руны и 2 ведуна из клана Железной Руны.‡Donny in Ivalds Ruine im Heulenden Fjord möchte, dass Ihr 10 Eisenrunenzerstörer, 5 Eisenrunenhilfsarbeiter und 2 Eisenrunenweise tötet.‡울부짖는 협만의 이발드의 폐허에 있는 도니가 무쇠룬 파괴자 10명, 무쇠룬 노동자 5명, 그리고 무쇠룬 현자 2명을 처치해 달라고 했습니다.‡Donny de las Ruinas de Ivald, en el Fiordo Aquilonal, quiere que mates a 10 destructores Runaférrea, 5 obreros Runaférrea y 2 sabios Runaférrea.‡Donny de las Ruinas de Ivald, en el Fiordo Aquilonal, quiere que mates a 10 destructores Runaférrea, 5 obreros Runaférrea y 2 sabios Runaférrea.‡Donny, aux Ruines d\'Ivald dans le Fjord Hurlant, vous demande de tuer 10 Destructeurs Rune-de-fer, 5 Travailleurs Rune-de-fer et 2 Sages Rune-de-fer.‡伊瓦尔德废墟的东尼要求你杀死10名铁符文毁灭者、5名铁符文劳工和5名铁符文先知。‡凜風峽灣，伊瓦德遺跡的多尼要你去殺了10個鐵符文摧毀者，5個鐵符文苦力以及2個鐵符文賢者。',
  }
},
[11478] = {
  {
    'Posto Avançado à vista...‡На той заставе...‡Außenposten dort drüben...‡저기 있는 전초기지...‡Aquella avanzada...‡Aquella avanzada...‡L\'avant-poste par là-bas…‡远方的哨站‡遠方的前哨……',
    nil,
    'Entregue a Carta de Donny para Stanwad no Posto Avançado da Liga dos Exploradores.‡Доставьте письмо от Донни Станваду в Лагерь Лиги исследователей.‡Überbringt Donnys Brief an Stanwad im Außenposten der Forscherliga.‡도니의 편지를 탐험가 연맹 전초기지에 있는 스탄와드에게 전달해야 합니다.‡Entrégale la carta de Donny a Stanwad en la Avanzada de la Liga de Expedicionarios.‡Entrégale la carta de Donny a Stanwad en la Avanzada de la Liga de Expedicionarios.‡Remettez la Lettre de Donny à Stanwad à l\'Avant-poste de la Ligue des explorateurs.‡将东尼的信交给探险者协会哨站的斯坦瓦德。‡將多尼的信傳送給探險者協會前哨的史坦華。',
  }
},
[11479] = {
  {
    'Dâni "Perna de Gávea"‡"Хромой" Дэн‡"Krähenbein" Dan‡"까마귀발" 댄‡Dan "Pata de Cuervo"‡Dan "Pata de Cuervo"‡Dan « Patte-de-corbeau »‡“火柴腿”丹‡『鴉腿』丹',
    nil,
    'Confronte o Dâni "Perna de Gávea", que está em um dos navios da Angra dos Malandros. Fale com Téo Bonitão quando terminar a tarefa.‡Проучите "Хромого" Дэна, который прячется на одном из кораблей в Лагере Скалаваг. Когда выполните это задание, поговорите с Красавчиком Терри.‡Konfrontiert "Krähenbein" Dan. Er befindet sich auf einem der Schiffe im Halunkeneck. Sprecht mit dem hübschen Terry, sobald diese Aufgabe erfüllt ist.‡해적 야영지의 배 중 한 척에 있는 "까마귀발" 댄을 상대한 다음 잘생긴 테리와 대화해야 합니다.‡Enfréntate a Dan "Pata de Cuervo" que se encuentra en uno de los barcos en el Cabo Pillastre. Cuando hayas acabado habla con Terry el Hermoso.‡Enfréntate a Dan "Pata de Cuervo" que se encuentra en uno de los barcos en el Cabo Pillastre. Cuando hayas acabado habla con Terry el Hermoso.‡Démasquez Dan « Patte-de-Corbeau », qui se trouve à bord de l’un des navires au Cap du Forban. Lorsque ce sera fait, allez parler à Terry le beau gosse.‡打倒“火柴腿”丹，他就在无赖港内的某条船上。完成任务后去找帅哥泰里谈一谈。‡去挑戰『鴉腿』丹，他就在無賴角的其中一條船上。完成之後和帥哥泰瑞談談。',
  }
},
[11480] = {
  {
    'Conheça a número dois‡Познакомьтесь с номером два‡Nummer Zwei kennenlernen‡2인자와의 면담‡Conoce a la número dos‡Conoce a la número dos‡Rencontrer le Numéro Deux‡见见二把手‡見見副司令',
    nil,
    'Fale com Annie Bonn na Angra dos Malandros.‡Поговорите с Энни Бонн в Лагере Скалаваг.‡Sprecht mit Annie Bonn im Halunkeneck.‡해적 야영지에 있는 애니 본과 대화해야 합니다.‡Habla con Annie Bonn en el Cabo Pillastre.‡Habla con Annie Bonn en el Cabo Pillastre.‡Parlez à Annie Bonn, au Cap du Forban.‡与无赖港的安妮·波恩谈一谈。‡與無賴角的安妮·波恩談談。',
  }
},
[11481] = {
  {
    'Crise na Nascente do Sol‡Чрезвычайная ситуация у Солнечного Колодца‡Krise am Sonnenbrunnen‡태양샘의 위기‡Crisis en La Fuente del Sol‡Crisis en La Fuente del Sol‡Crise au Puits de soleil‡太阳之井的危机‡太陽之井的危機',
    nil,
    'Adyen, o Guardião da Luz, no Terraço dos Aldor, que fica em Shattrath, pediu a você que viaje ao Platô da Nascente do Sol e fale com o Capitão Theris Aurolar.‡Адиен Страж Света с возвышенности Алдоров в Шаттрате поручает вам отправиться на плато Солнечного Колодца и поговорить с Ларетором.‡Adyen der Lichtwächter auf der Aldorhöhe in Shattrath hat Euch gebeten, zum Sonnenbrunnenplateau zu reisen und dort mit Larethor zu sprechen.‡샤트라스의 알도르 마루에 있는 빛의 감시자 아드옌이 태양샘 고원으로 가서 라레소르와 대화해 달라고 했습니다.‡Adyen el Celador de la Luz del Alto Aldor, en la Ciudad de Shattrath, te ha pedido que viajes hasta la Meseta de La Fuente del Sol para hablar con Larethor.‡Adyen el Celador de la Luz del Alto Aldor, en la Ciudad de Shattrath, te ha pedido que viajes hasta la Meseta de La Fuente del Sol para hablar con Larethor.‡Adyen le Gardelumière, de l\'Éminence de l\'Aldor à Shattrath, veut que vous vous rendiez au Plateau du Puits de soleil pour parler à Larethor.‡沙塔斯城奥尔多高地的圣光护卫者阿德因要求你前往太阳之井高地，与主教拉雷索尔谈一谈。‡撒塔斯城，奧多爾階梯的『護光者』艾德伊恩要求你前往太陽之井高地，和雷索爾談談。',
  }
},
[11482] = {
  {
    'O dever chama‡Зов долга‡Pflicht ruft‡사명의 부름‡El deber llama‡El deber llama‡L\'appel du devoir‡使命的召唤‡職責所在',
    nil,
    'Dathris Golpessol, no Terraço dos Áugures, que fica em Shattrath, insistiu que você viaje a Azeroth de imediato e se apresente a Larethor na Nascente do Sol.‡Датрис Солнцесвет с яруса Провидцев Шаттрата настаивает, чтобы вы отправились на Азерот немедленно и поговорили с Ларетором у Солнечного Колодца.‡Dathris Sonnensturm auf der Sehertreppe in Shattrath besteht darauf, dass Ihr umgehend nach Azeroth reist und Euch bei Larethor am Sonnenbrunnen meldet.‡샤트라스 점술가 언덕에 있는 다스리스 선스트라이커가 즉시 아제로스로 가서 태양샘 고원에 있는 라레소르에게 보고하라고 지시했습니다.‡Dathris Golpesol de la Grada del Arúspice, en la Ciudad de Shattrath, ha insistido en que viajes a Azeroth inmediatamente y te presentes ante Larethor en La Fuente del Sol.‡Dathris Golpesol de la Grada del Arúspice, en la Ciudad de Shattrath, ha insistido en que viajes a Azeroth inmediatamente y te presentes ante Larethor en La Fuente del Sol.‡Dathris Heurtesoleil, du Degré des Clairvoyants de Shattrath, insiste pour que vous retourniez immédiatement en Azeroth et que vous vous présentiez à Larethor au Puits de soleil.‡沙塔斯城占星者之台的达斯雷·射日者要求你前往太阳之井高地，与主教拉雷索尔谈一谈。‡撒塔斯城，占卜者階梯的戴斯瑞司·擊日者希望你立刻回到艾澤拉斯，到太陽之井向雷索爾報到。',
  }
},
[11483] = {
  {
    'A reconstrução‡Мы тоже так можем!‡Wir können es nachbauen‡복제의 재료‡Podemos reconstruirlo‡Podemos reconstruirlo‡Nous pouvons le reconstruire‡我们可以重建它‡我們可以重建它',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você lhe traga um Barril Grande, um rolo de Corda Industrial Resistente e Lingotes de Ferro Negro.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас достать ему большую бочку, крепкий промышленный канат и несколько слитков черного железа.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr ihm ein großes Fass, ein Seil in Industriestärke und Dunkeleisenblöcke bringt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 큰 통, 공업용 밧줄과 검은무쇠 덩어리를 가져다 달라고 했습니다.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que le lleves una barrica grande, cuerda de aguante industrial y lingotes de hierro negro.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que le lleves una barrica grande, cuerda de aguante industrial y lingotes de hierro negro.‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous lui rapportiez un Grand tonneau, de la Corde à usage industriel et des Lingots de sombrefer.‡嚎风峡湾探险者协会哨站的沃尔特要你带回一只大桶、一根高强度绳索和一些黑铁条。‡凜風峽灣的探險者協會前哨的渥特要你帶給一個大桶、工業力量之繩和黑鐵鑄塊。',
  }
},
[11484] = {
  {
    'Nós detemos a tecnologia‡Мы знаем технологию‡Wir haben die Technik‡장식의 기술‡Tenemos la tecnología‡Tenemos la tecnología‡Nous avons la technologie‡我们有技术‡我們擁有技術',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você lhe traga um Pelego Imaculado de Cavacorne e um Reforço de Aço.‡Уолт из Лагеря Лиги исследователей просит вас достать ему безупречную шкуру черпорога и стальной каркас.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr ihm einen makellosen Schaufelhauerbalg und ein Stück Rippenstahl bringt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 온전한 뾰족엄니 가죽과 철제 장식용 뼈대를 가져다 달라고 했습니다.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que le lleves un pellejo de colmipala prístino y tejido elástico de acero.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que le lleves un pellejo de colmipala prístino y tejido elástico de acero.‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous lui rapportiez une Peau de brochepelle en parfait état et une Armature en acier.‡嚎风峡湾探险者协会哨站的沃尔特要你带回一张天然铲齿鹿皮和一根钢质棱条。‡凜風峽灣、探險者協會前哨的渥特要你帶給他一張新鮮的鍬牙毛皮和鋼質肋材。',
  }
},
[11485] = {
  {
    'Constructos da Runa Férrea e você: salto propelido‡Голем Железной руны: обучение "Реактивному прыжку"‡Eisenrunenkonstrukte und du: Raketensprünge‡무쇠룬 피조물하고 나하고: 로켓 도약‡Ensamblajes Runaférrea y tú: salto con cohete‡Ensamblajes Runaférrea y tú: salto con cohete‡Les assemblages Rune-de-fer et vous : les fusées de saut‡铁符文构造体与你：火箭跳‡鐵符文傀儡與你:火箭跳躍',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use o Salto Propelido do Constructo da Runa Férrea no Entalhe de Runa Férrea de Walt.|n|nDispense o constructo na janela de ajudantes ao completar a missão.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас воспользоваться способностью "Реактивный прыжок" голема Железной Руны, стоя на вырезанной Уолтом руне.|n|nПосле выполнения упражнения отпустите голема.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr Euch ins Eisenrunenkonstrukt setzt und dessen Fähigkeit \'Raketensprung\' bei Walts Eisenrunengravur ausführt.|n|nÜber das Begleiterfenster, könnt Ihr das Konstrukt freigeben, sobald Ihr die Aufgabe abgeschlossen habt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 무쇠룬 조각물에서 무쇠룬 피조물의 로켓 도약 능력을 사용해 달라고 했습니다.|n|n퀘스트를 완료한 다음에는 소환수 창에서 버튼을 눌러 피조물을 해제해야 합니다.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses la facultad de salto con cohete de ensamblaje Runaférrea sobre el tallado Runaférrea de Walt.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses la facultad de salto con cohete de ensamblaje Runaférrea sobre el tallado Runaférrea de Walt.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez les Fusées de saut de l’Assemblage Rune-de-fer avec la Gravure de rune de fer de Walt.|n|nQuittez votre assemblage en le renvoyant dans la fenêtre du familier, quand vous aurez terminé la quête.‡嚎风峡湾探险者协会哨站的沃尔特要你在沃尔特的铁符文雕像上使用铁符文构造体的火箭助推技能。|n|n完成任务，你可以在宠物选项菜单中点击解散宠物来解散构造体。‡凜風峽灣，探險者協會前哨的渥特要你對鐵符文雕像使用鐵符文傀儡的火箭跳躍能力。|n|n一旦完成任務後，你可以點選寵物視窗選擇解散來取消傀儡。',
  }
},
[11486] = {
  {
    '‡Лучшее пиво‡Das beste aller Biere‡‡La mejor de las cervezas‡La mejor de las cervezas‡La meilleure des bières‡‡',
    nil,
    '‡Отнесите бочонок эля Черного Железа Ипфелькоферу Железному Бочонку в Дун Морог.‡Bringt das Bierfässchen der Dunkeleisenzwerge zu Ipfelkofer Eisenfass in Dun Morogh.‡‡Lleva el barril de cerveza Hierro Negro a Ipfelkofer Barril de Hierro en Dun Morogh.‡Lleva el barril de cerveza Hierro Negro a Ipfelkofer Barril de Hierro en Dun Morogh.‡Apportez le Tonneau de bière sombrefer à Ipfelkofer Baril-de-fer en Dun Morogh.‡‡',
  }
},
[11487] = {
  {
    '‡Лучшее пиво‡Das beste aller Biere‡‡La mejor de las cervezas‡La mejor de las cervezas‡La meilleure des bières‡‡',
    nil,
    '‡Отнесите бочонок эля Черного Железа Слухарю Мухлевару в Дуротар.‡Bringt das Bierfässchen der Dunkeleisenzwerge zu Zapfus Schwindelfass in Durotar.‡‡Lleva el barril de cerveza Hierro Negro a Espitador Barritimo en Durotar.‡Lleva el barril de cerveza Hierro Negro a Espitador Barritimo en Durotar.‡Apportez le Tonneau de bière sombrefer à Perce Fauchebaril en Durotar.‡‡',
  }
},
[11488] = {
  {
    'Terraço dos Magísteres‡Терраса Магистров‡Terrasse der Magister‡마법학자의 정원‡El Bancal del Magister‡El Bancal del Magister‡La terrasse des Magistères‡魔导师平台‡博學者殿堂',
    nil,
    'O Exarca Larethor, no Bivaque Sol Partido, quer que você procure Tyrith, um espião elfo sangrento, no Terraço dos Magísteres.‡Экзарх Ларетор с плацдарма армии Расколотого Солнца просит вас найти на террасе Магистров своего разведчика – эльфа крови Тирита.‡Exarch Larethor beim Sammelpunkt der Zerschmetterten Sonne möchte, dass Ihr die Terrasse der Magister absucht und einen Blutelfenspion namens Tyrith findet.‡무너진 태양 집결지에 있는 총독 라레소르가 마법학자의 정원에서 블러드 엘프 첩보원인 티리스를 찾아봐 달라고 했습니다.‡El exarca Larethor de la Zona de Escala de Sol Devastado quiere que registres el Bancal del Magister y encuentres a Tyrith, un espía elfo de sangre.‡El exarca Larethor de la Zona de Escala de Sol Devastado quiere que registres el Bancal del Magister y encuentres a Tyrith, un espía elfo de sangre.‡L\'exarque Larethor, de la Zone de rassemblement du Soleil brisé, vous demande d\'explorer la Terrasse des magistères à la recherche de Tyrith, un espion elfe de sang.‡破碎残阳基地的主教拉雷索尔要求你前往魔导师平台，寻找血精灵间谍塔雷斯的踪迹。‡破碎之日會所的主教雷索爾要去你搜尋博學者殿堂，找到提里斯，一個血精靈間諜。',
  }
},
[11489] = {
  {
    'Constructos da runa férrea e você: coleta de dados‡Голем Железной руны: обучение "Сбору информации"‡Eisenrunenkonstrukte und du: Daten sammeln‡무쇠룬 피조물하고 나하고: 자료 수집‡Ensamblajes Runaférrea y tú: recopilación de datos‡Ensamblajes Runaférrea y tú: recopilación de datos‡Les assemblages Rune-de-fer et vous : le recueil de données‡铁符文构造体与你：收集数据‡鐵符文傀儡和你:收集資料',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use a habilidade de Coleta de Dados do Constructo da Runa Férrea enquanto estiver perto das Relíquias dos Anões de Ferro.|n|nDispense o constructo por meio da janela de ajudantes para completar a missão.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас воспользоваться способностью голема железной руны "Сбор информации", стоя рядом с реликвией железных дворфов.|n|nПосле выполнения упражнения отпустите голема.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr Euch ins Eisenrunenkonstrukt setzt und die Fähigkeit \'Daten sammeln\' in der Nähe des Eisenzwergrelikts ausführt.|n|nÜber das Begleiterfenster, könnt Ihr das Konstrukt freigeben, sobald Ihr die Aufgabe abgeschlossen habt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 무쇠 드워프 성물 근처에 서서 무쇠룬 피조물의 자료 수집 능력을 사용해 달라고 했습니다.|n|n퀘스트를 완료한 다음에는 소환수 창에서 버튼을 눌러 피조물을 해제해야 합니다.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses la facultad de recopilación de datos del ensamblaje Runaférrea mientras permaneces junto a la reliquia de enano férreo.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses la facultad de recopilación de datos del ensamblaje Runaférrea mientras permaneces junto a la reliquia de enano férreo.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez le système de Recueil de données de l’Assemblage Rune-de-fer en vous plaçant près de la Relique des nains de fer.|n|nQuittez votre assemblage en le renvoyant dans la fenêtre du familier, quand vous aurez terminé la quête.‡嚎风峡湾探险者协会哨站的沃尔特要你在沃尔特的铁符文雕像上使用铁符文构造体的收集数据技能。|n|n完成任务，你可以在宠物选项菜单中点击解散宠物来解散构造体。‡凜風峽灣的探險者協會前哨的渥特要你在接近鐵矮人聖物時使用鐵符文傀儡收集資料的技能。|n|n一旦完成任務後，你可以點選寵物視窗選擇解散來取消傀儡。',
  }
},
[11490] = {
  {
    'O áugure do áugure‡Провидец Провидцев‡Der Seher der Seher‡점술가의 수정구‡El cristal de adivinación del arúspice‡El cristal de adivinación del arúspice‡Clairvoyance pour les Clairvoyants‡占星球‡占卜者的占卜',
    nil,
    'Tyrith quer que você use o orbe na sacada do Terraço dos Magísteres.‡Тирит просит вас использовать шар на балконе террасы Магистров.‡Tyrith möchte, dass Ihr die Kugel auf dem Balkon in der Terrasse der Magister benutzt.‡티리스가 마법학자의 정원 발코니에서 수정구를 사용해 달라고 했습니다.‡Tyrith quiere que uses el orbe en el balcón del Bancal del Magister.‡Tyrith quiere que uses el orbe en el balcón del Bancal del Magister.‡Tyrith veut que vous utilisiez l\'orbe sur le balcon de la Terrasse des Magistères.‡塔雷斯要求你使用魔导师平台内的阳台上的宝珠。‡提里斯要你在博學者殿堂的陽臺使用寶珠。',
  }
},
[11491] = {
  {
    'Constructos da runa férrea e você: o blefe‡Голем Железной руны: обучение "Обманке"‡Eisenrunenkonstrukte und du: Täuschung‡무쇠룬 피조물하고 나하고: 속임수‡Ensamblajes Runaférrea y tú: el engaño‡Ensamblajes Runaférrea y tú: el engaño‡Les assemblages Rune-de-fer et vous : le grand bluff‡铁符文构造体与你：唬骗‡鐵符文傀儡和你:虛張聲勢',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use o Blefe do Constructo da Runa Férrea no Lebronski após caminhar sobre o tapete dele.|n|nDispense o constructo na janela de ajudantes ao completar a missão.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас потренироваться в использовании способности "Обманка" голема Железной руны. Для этого вам надо наступить на коврик Лебронски.|n|nПосле выполнения упражнения отпустите голема.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr Euch ins Eisenrunenkonstrukt setzt und die Fähigkeit \'Bluffen\' auf Lebronski ausführt, nachdem Ihr über seinen Teppich gestiegen seid.|n|nÜber das Begleiterfenster, könnt Ihr das Konstrukt freigeben, sobald Ihr die Aufgabe abgeschlossen habt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 레브론스키의 양탄자 위로 걸어간 다음 레브론스키에게 무쇠룬 피조물의 속임수 능력을 사용해 달라고 했습니다.|n|n퀘스트를 완료한 다음에는 소환수 창에서 버튼을 눌러 피조물을 해제해야 합니다.‡Walt de la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal, quiere que utilices la facultad de engaño del ensamblaje Runaférrea con Lebronski tras haber caminado sobre su alfombra.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.|n‡Walt de la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal, quiere que utilices la facultad de engaño del ensamblaje Runaférrea con Lebronski tras haber caminado sobre su alfombra.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.|n‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez le système de Bluff de l’Assemblage Rune-de-fer sur Lebronski quand vous aurez marché sur son tapis.|n|nQuittez votre assemblage en le renvoyant dans la fenêtre du familier, quand vous aurez terminé la quête.‡嚎风峡湾探险者协会哨站的沃尔特要你在走过雷波斯基的地毯时使用铁符文构造体的唬骗技能。|n|n完成任务，你可以在宠物选项菜单中点击解散宠物来解散构造体。‡凜風峽灣，探險者協會前哨的渥特要你在踏上雷布隆斯基的地毯後，對他使用鐵符文傀儡的虛張聲勢技能。|n|n一旦完成任務後，你可以點選寵物視窗選擇解散來取消傀儡。',
  }
},
[11492] = {
  {
    'Duro de matar‡Страшный противник‡Nicht totzukriegen‡어려운 상대‡Duro de matar‡Duro de matar‡L\'increvable‡大难不死‡難以殺死',
    nil,
    'Kalecgos quer que você derrote Kael\'thas no Terraço dos Magísteres. Pegue a cabeça de Kael e apresente-se a Larethor no Bivaque Sol Partido.‡Калесгос велит вам уничтожить Кель\'таса на террасе Магистров. Отрубите Келю голову и вернитесь к Ларетору на плацдарм армии Расколотого Солнца.‡Kalecgos hat Euch damit beauftragt, Kael\'thas in der Terrasse der Magister zu bezwingen. Ihr sollt Euch mit Kaels Kopf bei Larethor am Sammelpunkt der Zerschmetterten Sonne treffen.‡칼렉고스가 마법학자의 정원에 있는 캘타스를 처치해 달라고 했습니다. 캘타스의 머리카락을 가지고 무너진 태양 집결지에 있는 총독 라레소르에게 보고해야 합니다.‡Kalecgos te ha pedido que derrotes a Kael\'thas en el Bancal del Magister. Coge la cabeza de Kael y preséntate ante Larethor en la Zona de Escala de Sol Devastado.‡Kalecgos te ha pedido que derrotes a Kael\'thas en el Bancal del Magister. Lleva la cabeza de Kael y preséntate ante Larethor en la Zona de escala de Sol Devastado.‡Kalecgos vous a demandé de vaincre Kael\'thas sur la Terrasse des Magistères. Vous devrez ramasser la tête de Kael avant de faire votre rapport à Larethor à la Zone de rassemblement du Soleil brisé.‡卡雷苟斯要求你击败魔导师平台内的凯尔萨斯。取下凯尔萨斯的徽记之后，立刻向破碎残阳基地的主教拉雷索尔复命。‡卡雷苟斯要求你擊敗博學者殿堂的凱爾薩斯。你要帶著凱爾薩斯的頭回報破碎之日會所的雷索爾。',
  }
},
[11493] = {
  {
    'UNUSED‡UNUSED‡UNUSED‡UNUSED‡UNUSED‡UNUSED‡UNUSED‡UNUSED‡UNUSED',
    nil,
    nil,
  }
},
[11494] = {
  {
    'Relíquias instiladas com raios‡Заряженные молнией артефакты‡Blitzerfüllte Relikte‡번개의 힘이 깃든 유물‡Reliquias imbuidas de relámpagos‡Reliquias imbuidas de relámpagos‡La relique imprégnée d\'éclair‡闪电圣物‡閃電灌能神器',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use a habilidade de Coleta de Dados do Constructo da Runa Férrea para recolher 15 conjuntos de Dados da Runa Férrea.|n|nDispense o constructo na janela de ajudantes ao completar a missão.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас собрать 15 наборов данных о Железной Руне с помощью способности "Сбор информации" голема Железной Руны.|n|nПосле выполнения задания отпустите голема.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr Euch ins Eisenrunenkonstrukt setzt und mit der Fähigkeit \'Daten sammeln\' 15 Lesungen von Eisenrunendaten durchführt.|n|nÜber das Begleiterfenster, könnt Ihr das Konstrukt freigeben, sobald Ihr die Aufgabe abgeschlossen habt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 무쇠룬 피조물의 자료 수집 능력을 사용해 무쇠룬 자료 15벌을 수집해 달라고 했습니다.|n|n퀘스트를 완료한 다음에는 소환수 창에서 버튼을 눌러 피조물을 해제해야 합니다.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses la facultad de recopilación de datos de ensamblaje Runaférrea para recoger 15 muestras de datos Runaférrea.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.‡Walt de la Avanzada de la Liga de Expedicionarios en el Fiordo Aquilonal quiere que uses la facultad de recopilación de datos de ensamblaje Runaférrea para recoger 15 muestras de datos Runaférrea.|n|nRetira tu ensamblaje desde la ventana de mascotas cuando hayas completado la misión.‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez le système de Recueil de données de l’Assemblage Rune-de-fer pour récolter 15 séries de Données Rune-de-fer.|n|nQuittez votre assemblage en le renvoyant dans la fenêtre du familier, quand vous aurez terminé la quête.‡嚎风峡湾探险者协会哨站的沃尔特要你使用铁符文构造体的收集数据技能收集15份铁符文数据。|n|n完成任务后，你可以在宠物选项菜单中点击解散宠物来解散构造体。‡凜風峽灣的探險者協會前哨的渥特要你使用鐵符文傀儡收集資料的技能去收集15組鐵符文資料。|n|n一旦完成任務後，你可以點選寵物視窗選擇解散來取消傀儡。',
  }
},
[11495] = {
  {
    'O delicado som do trovão‡Нежный звук грома‡Der zarte Knall des Donners‡동굴을 울리는 천둥소리‡El delicado sonido del trueno‡El delicado sonido del trueno‡Le doux son du tonnerre‡轰鸣的雷霆‡微妙的雷聲',
    nil,
    'Walt, do Posto Avançado da Liga dos Exploradores, no Fiorde Uivante, quer que você use o Constructo da Runa Férrea para explorar a caverna trovejante no Sítio de Escavação Baelgun.|n|nDispense o constructo na janela de ajudantes ao completar a missão.‡Уолт из Лагеря Лиги исследователей в Ревущем фьорде просит вас исследовать грохочущую пещеру на раскопках Бейлгуна с помощью голема из клана Железной Руны.|n|nПосле выполнения задания отпустите голема.‡Walt im Außenposten der Forscherliga im Heulenden Fjord möchte, dass Ihr Euch ins Eisenrunenkonstrukt setzt und die donnernde Höhle in Baelguns Ausgrabungsstätte erkundet.|n|nÜber das Begleiterfenster, könnt Ihr das Konstrukt freigeben, sobald Ihr die Aufgabe abgeschlossen habt.‡울부짖는 협만의 탐험가 연맹 전초기지에 있는 왈트가 무쇠룬 피조물을 사용해 바엘군의 발굴현장에 있는 천둥소리가 들리는 동굴을 탐험해 달라고 했습니다.|n|n퀘스트를 완료한 다음에는 소환수 창에서 버튼을 눌러 피조물을 해제해야 합니다.‡Walt de la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal, quiere que uses el ensamblaje Runaférrea para explorar la atronadora cueva en la Excavación de Baelgun.|n|nRetira a tu ensamblaje desde la ventana de mascotas una vez que hayas completado la misión.‡Walt de la Avanzada de la Liga de Expedicionarios, en el Fiordo Aquilonal, quiere que uses el ensamblaje Runaférrea para explorar la atronadora cueva en la Excavación de Baelgun.|n|nRetira a tu ensamblaje desde la ventana de mascotas una vez que hayas completado la misión.‡Walt, à l’Avant-poste de la Ligue des explorateurs du Fjord Hurlant, veut que vous utilisiez l’Assemblage Rune-de-fer pour explorer la caverne tonnante, aux Excavations de Baelgun.|n|nQuittez votre assemblage en le renvoyant dans la fenêtre du familier, quand vous aurez terminé la quête.‡嚎风峡湾探险者协会哨站的沃尔特要你使用铁符文构造体仔细探索巴尔古挖掘场内的雷霆洞穴。|n|n完成任务，你可以在宠物选项菜单中点击解散宠物来解散构造体。‡探險者協會前哨的渥特要你使用鐵符文傀儡去探勘巴爾古恩挖掘場裡傳出雷聲的洞穴。|n|n一旦你完成了任務，從寵物視窗中解散你的傀儡。',
  }
},
[11496] = {
  {
    'Proteções do sacrário‡Охрана святилища‡Die Barrieren des Sanktums‡성소 수호물‡Los resguardos del sagrario‡Los resguardos del sagrario‡Les protections du sanctum‡圣殿的结界‡聖所結界',
    nil,
    'O Capitão Theris Aurolar, no Bivaque Sol Partido, quer que você obtenha 4 Vestígios de Mana de Malévolos Ignóbeis e Devoradores Ignóbeis e os use para energizar uma das Proteções de Cristal ao redor do Sacrário Beirassol a leste.‡Капитан Терис Рассветное Пламя с плацдарма армии Расколотого Солнца просит вас добыть 4 клочка маны у Презренных-злобней и Презренных-пожирателей и при их помощи активировать поле кристалла-хранителя, окружающее святилище Солнечного Края на востоке.‡Hauptmann Theris Morgenheim beim Sammelpunkt der Zerschmetterten Sonne will, dass Ihr 4 Manaüberreste von getriebenen Unholden und getriebenen Verschlingern verschafft und sie benutzt, um eine der Kristallbarrieren aufzuladen, welche den Osten des Sanktums der Sonnenweiten umgeben.‡무너진 태양 집결지에 있는 대장 테리스 돈하스가 버림받은 엘프 마귀와 버림받은 엘프 포식자로부터 마나 파편 4개를 모아 동쪽으로 가서 태양너울 성소를 둘러싼 수호의 수정을 충전해 달라고 했습니다.‡El capitán Theris Albahogar en la Zona de Escala de Sol Devastado quiere que consigas 4 despojos de maná de malignos desdichados y devoradores desdichados y que los uses como fuente de energía para alguno de los resguardos de cristal que rodean el Sagrario de Tramo del Sol al este.‡El capitán Theris Albahogar en la Zona de Escala de Sol Devastado quiere que consigas 4 despojos de maná de malignos desdichados y devoradores desdichados y que los uses como fuente de energía para alguno de los resguardos de cristal que rodean el Sagrario de Tramo del Sol al este.‡Le Capitaine Theris Âtraurore, de la Zone de rassemblement du Soleil brisé, vous demande de vous procurer 4 Restes de mana sur les Fielleux déshérités et les Dévoreurs déshérités et de vous en servir pour alimenter un des Cristaux de protection qui entoure le Sanctum des Confins du soleil, à l\'est.‡破碎残阳基地的瑟里斯·黎明之心希望你能从失心魔瘾者和失心吞噬者那里获取4份法力余烬，用它们激活东边的阳湾圣殿周围的水晶结界。‡破碎之日會所的塞里斯·曦爐上尉要你從鄙惡者惡魔與鄙惡者吞噬者身上取得4個法力殘餘。使用它們來替日境聖所周圍靠東邊的一個水晶結界充能。',
  }
},
[11497] = {
  {
    'Aprendendo a voar‡Орлята учатся летать‡Fliegen lernen‡비행술 훈련‡Aprendiendo a volar‡Aprendiendo a volar‡Apprendre à voler‡学习飞翔‡學習飛行',
    nil,
    'Fale com Ilsa Cervabum na Fortaleza Martelo Feroz, que fica no Vale da Lua Negra.‡Поговорите с Илсой Бурное Варево в цитадели Громового Молота в долине Призрачной Луны.‡Sprecht mit Ilsa Trubelbräu in der Wildhammerfeste im Schattenmondtal.‡어둠달 골짜기의 와일드해머 성채에 있는 일사 블러스터브루와 대화해야 합니다.‡Habla con Ilsa Bravuconada en Bastión Martillo Salvaje en el Valle Sombraluna.‡Habla con Ilsa Bravuconada en Bastión Martillo Salvaje en el Valle Sombraluna.‡Parlez à Ilsa Fulminebière au Bastion des Marteaux-hardis dans la Vallée d\'Ombrelune.‡与影月谷蛮锤要塞的伊尔萨·枪酒谈一谈。‡伊爾莎·咆釀談談，她在影月谷的蠻錘要塞。',
  }
},
[11498] = {
  {
    'Aprendendo a voar‡Орлята учатся летать‡Fliegen lernen‡비행술 훈련‡Aprendiendo a volar‡Aprendiendo a volar‡Apprendre à voler‡学习飞翔‡學習飛行',
    nil,
    'Fale com Olrokk na Aldeia Lua Negra, que fica no Vale da Lua Negra.‡Поговорите с Олрокком в деревне Призрачной Луны в долине Призрачной Луны.‡Sprecht mit Olrokk in Schattenmond im Schattenmondtal.‡어둠달 골짜기에 있는 어둠달 마을에서 올로크와 대화해야 합니다.‡Habla con Olrokk en la Aldea Sombraluna en el Valle Sombraluna.‡Habla con Olrokk en la Aldea Sombraluna en el Valle Sombraluna.‡Parlez à Olrokk au Village d\'Ombrelune dans la Vallée d\'Ombrelune.‡与影月谷影月村的欧尔洛克谈一谈。‡和歐洛克談談，他在影月谷的影月村。',
  }
},
[11499] = {
  {
    'Procura-se: o anel-sinete do Príncipe Kael\'thas‡Разыскивается: перстень-печатка принца Кель\'таса‡Gesucht: Der Siegelring von Prinz Kael\'thas‡구함: 캘타스 왕자의 인장 반지‡Se busca: El sello del príncipe Kael\'thas‡SE BUSCA: El sello del príncipe Kael\'thas‡On recherche : La chevalière du prince Kael\'thas‡悬赏：凯尔萨斯王子的徽记之戒‡懸賞:凱爾薩斯王子的璽戒',
    nil,
    'Zhareem, o Mercador do Vento, pediu para você pegar o Anel-sinete do Príncipe Kael\'thas. Entregue-lhe o anel no Bairro Inferior de Shattrath para receber a recompensa.|n|nEsta missão só pode ser completada no Terraço dos Magísteres em modo heroico.‡Торговец ветром Зарим хочет, чтобы вы добыли ему перстень-печатку принца Кель\'таса. Доставьте ее в Нижний город Шаттрата и получите награду. |n|nЭто задание выполняется на террасе Магистров только в героическом режиме.‡Windhändler Zhareem hat Euch darum gebeten, ihm den Siegelring von Prinz Kael\'thas zu beschaffen. Bringt diesen zu ihm ins Untere Viertel in Shattrath, um Eure Belohnung zu erhalten.|n|nDiese Aufgabe kann nur auf der Terrasse der Magister und nur auf dem Schwierigkeitsgrad \'Heroisch\' abgeschlossen werden.‡샤트라스의 고난의 거리에 있는 바람의 무역상 자림에게 캘타스 왕자의 인장 반지를 가져가 보상을 받아야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 마법학자의 정원에서 수행해야 합니다.‡El comerciante de viento Zhareem te ha pedido que consigas el sello del príncipe Kael\'thas. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en el Bancal del Magister en dificultad heroica.‡El comerciante de viento Zhareem te ha pedido que consigas el sello del príncipe Kael\'thas. Llévaselo al Bajo Arrabal de la Ciudad de Shattrath para conseguir la recompensa.|n|nEsta misión solo se puede realizar en el Bancal del Magister en dificultad heroica.‡Le Marchand des vents Zhareem vous a demandé de vous procurer la Chevalière du prince Kael\'thas. Apportez-la-lui à la Ville basse de Shattrath pour recevoir votre récompense.|n|nCette quête ne peut être accomplie qu\'à la Terrasse des Magistères en mode Héroïque.‡商人扎雷姆要求你夺得凯尔萨斯王子的徽记之戒。将戒指带回沙塔斯城的贫民窟交给他，就能领取奖赏。|n|n该任务只能在英雄模式的魔导师平台完成。‡風之貿易者札令姆要你取得凱爾薩斯王子的璽戒。帶到撒塔斯的陰鬱城交給他以換取賞金。|n|n這個任務只能在英雄難度中的博學者殿堂完成。',
  }
},
[11500] = {
  {
    'Procuram-se: Irmãs da Angústia‡Разыскиваются: сестры Терзаний‡Gesucht: Schwestern der Qual‡현상 수배: 고난의 자매‡Se busca: Hermanas del Tormento‡SE BUSCA: Hermanas del Tormento‡On recherche : Les sœurs du tourment‡悬赏：痛苦妖女‡懸賞:折磨之女',
    nil,
    'O Espreitador Etéreo Mah\'duun quer que você mate 4 Irmãs da Angústia. Fale novamente com ele no Bairro Inferior de Shattrath quando todas estiverem mortas para receber a recompensa.‡Ловчий Пустоты Ма\'дуун хочет, чтобы вы убили 4 сестер терзаний. Вернитесь к нему в Нижний город Шаттрата, когда перебьете их, чтобы забрать награду.‡Netherpirscher Mah\'duun möchte, dass Ihr 4 Schwestern der Qual erschlagt. Kehrt zu ihm in das Untere Viertel in Shattrath zurück, sobald Ihr sie getötet habt, um das Kopfgeld einzufordern.‡고난의 자매 4마리를 처치한 후, 샤트라스 고난의 거리에 있는 황천의 추적자 마둔에게 돌아와 보상을 받아야 합니다.‡El acechador abisal Mah\'duun te ha pedido que mates 4 Hermanas del Tormento. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡El acechador abisal Mah\'duun te ha pedido que mates 4 Hermanas del Tormento. Vuelve a verle al Bajo Arrabal de Shattrath cuando estén todos muertos para cobrar la recompensa.‡Le Traqueur-du-Néant Mah\'duun vous a chargé de tuer 4 Sœurs du tourment. Revenez le voir à la Ville basse de Shattrath lorsque ce sera fait pour recevoir votre prime.‡虚空猎手玛哈杜恩要求你杀死4名痛苦妖女。完成任务后返回沙塔斯城的贫民窟，向他领取奖赏。‡虛空巡者瑪頓恩要你解決4名折磨之女。完成之後回到撒塔斯的陰鬱城找他以換取賞金。',
  }
},
[11501] = {
  {
    'Notícias do leste‡Вести с востока‡Neues aus dem Osten‡동쪽에서 온 소식‡Noticias del este‡Noticias del este‡Des nouvelles de l\'est‡东边来的消息‡來自東邊的消息',
    nil,
    'Fale com o Capitão Carneiro na Bastilha da Guarda Oeste.‡Поговорите с капитаном Адамсом из Крепости Западной Стражи.‡Sprecht mit Hauptmann Adams in Westwacht.‡서부경비대 성채에서 경비대장 아담스와 대화해야 합니다.‡Habla con el capitán Adams en la Fortaleza de la Guardia Oeste.‡Habla con el capitán Adams en la Fortaleza de la Guardia Oeste.‡Parler au Capitaine Adams au Donjon de la Garde de l\'Ouest.‡与西部卫戍要塞的亚当斯上尉谈一谈。‡與鎮西要塞的亞當斯隊長談談。',
  }
},
[11502] = {
  {
    'Em defesa de Halaa‡Защита Халаа‡Zur Verteidigung von Halaa‡할라아 방어‡En defensa de Halaa‡En defensa de Halaa‡La défense de Halaa‡保卫哈兰‡防衛哈剌',
    nil,
    'Derrote 10 jogadores inimigos em Halaa e fale novamente com Lakoor em Telaar.‡Победите 10 игроков вражеской фракции в Халаа и вернитесь в Телаар к Лакуру.‡Besiegt 10 feindliche Spieler in Halaa und kehrt zu Lakoor in Telaar zurück.‡할라아에서 적 전투원 10명을 처치하고 텔라아르에 있는 라쿠르에게 가야 합니다.‡Derrota a 10 jugadores enemigos en Halaa y vuelve a ver a Lakoor en Telaar.‡Derrota a 10 jugadores enemigos en Halaa y vuelve a ver a Lakoor en Telaar.‡Vaincre 10 joueurs ennemis à Halaa, puis retourner voir Lakoor à Telaar.‡在哈兰击败10名敌对方玩家，然后向塔拉的拉库尔复命。‡在哈剌擊敗10名敵對玩家，然後回去找泰拉的拉寇爾。',
  }
},
[11503] = {
  {
    'Inimigos, novos e velhos‡Враги старые и враги новые‡Feinde - alte und neue‡어제의 적, 오늘의 적‡Enemigos, viejos y nuevos‡Enemigos, viejos y nuevos‡Ennemis, anciens et nouveaux‡新仇旧怨‡新敵與宿怨',
    nil,
    'Derrote 10 jogadores inimigos em Halaa e fale novamente com Karrtog em Garadar.‡Победите 10 игроков вражеской фракции в Халаа и вернитесь в Гарадар к Карртогу.‡Besiegt 10 feindliche Spieler in Halaa und kehrt zu Karrtog in Garadar zurück.‡할라아에서 적 전투원 10명을 처치하고 가라다르에 있는 카르토그에게 가야 합니다.‡Derrota a 10 jugadores enemigos en Halaa y vuelve a ver a Karrtog en Garadar.‡Derrota a 10 jugadores enemigos en Halaa y vuelve a ver a Karrtog en Garadar.‡Abattez 10 joueurs ennemis à Halaa, puis retournez voir Karrtog à Garadar.‡在哈兰击败10名敌对方玩家，然后向加拉达尔的卡尔托格复命。‡在哈剌擊敗10名敵對玩家，然後回去找卡拉達爾的可托克。',
  }
},
[11504] = {
  {
    'Levantam os mortos!‡Ожившие мертвецы‡Die Toten stehen auf!‡시체가 벌떡!‡¡Los muertos se levantan!‡¡Los muertos se levantan!‡Les morts se lèvent !‡亡者复生！‡亡者重生!',
    nil,
    'Orfus de Kamagua, do Elevador Ancestral, no Fiorde Uivante, quer que você encontre a Pista de Fengir, a Pista de Rodin, a Pista de Isuldof e a Pista de Windan.‡Орфус Камагуанский с Древнего подъемника просит вас принести ему улики из могил Фенгира, Родина, Исулдофа и Ветрана.‡Orfus von Kamagua am Uralten Aufzug im Heulenden Fjord möchte, dass Ihr nach Fengirs Hinweis, Rodins Hinweis, Isuldofs Hinweis und Windans Hinweis sucht.‡울부짖는 협만의 고대 승강장에 있는 카마구아의 오르푸스가 펜기르의 단서와 로딘의 단서, 그리고 이술도프의 단서와 윈단의 단서를 찾아달라고 했습니다.‡Orfus de Komawa en El Antiguo Elevador en el Fiordo Aquilonal quiere que encuentres la pista de Fengir, la pista de Rodin, la pista de Isuldof y la pista de Windan.‡Orfus de Komawa en El Antiguo Elevador en el Fiordo Aquilonal quiere que encuentres la pista de Fengir, la pista de Rodin, la pista de Isuldof y la pista de Windan.‡Orfus de Kamagua, à l\'Antique élévateur dans le Fjord Hurlant, veut que vous découvriez l’Indice de Fengir, l’Indice de Rodin, l’Indice d’Isuldof et l’Indice de Windan.‡上古升降梯的奥弗斯希望你去寻找芬基尔的线索、洛丁的线索、伊斯多弗的线索和温丹的线索。‡凜風峽灣的卡瑪廓中，位於遠古升降梯的歐弗斯要你去找出芬吉爾的線索，洛丁的線索，還有伊蘇鐸夫的線索。',
  }
},
[11505] = {
  {
    'Espíritos de Auchindoun‡Духи Аукиндона‡Geister von Auchindoun‡아킨둔의 영혼‡Espíritus de Auchindoun‡Espíritus de Auchindoun‡Les esprits d\'Auchindoun‡奥金顿的幽魂‡奧齊頓之靈',
    nil,
    'Ajude a Aliança a proteger uma torre no Deserto de Ossos.‡Помогите Альянсу удерживать Башню духов в Костяных пустошах.‡Helft der Allianz, einen Turm in der Knochenwüste zu sichern.‡얼라이언스가 해골 무덤에 있는 탑을 점령하도록 도와야 합니다.‡Ayuda a la Alianza a proteger una torre en El Vertedero de Huesos.‡Ayuda a la Alianza a proteger una torre en El Vertedero de Huesos.‡Aidez l\'Alliance à prendre le contrôle d\'une tour dans le désert des Ossements.‡帮助联盟占据白骨荒野上的一座灵魂之塔。‡幫助聯盟佔領白骨荒野的尖塔。',
  }
},
[11506] = {
  {
    'Espíritos de Auchindoun‡Духи Аукиндона‡Geister von Auchindoun‡아킨둔의 영혼‡Espíritus de Auchindoun‡Espíritus de Auchindoun‡Les esprits d\'Auchindoun‡奥金顿的幽魂‡奧齊頓之靈',
    nil,
    'Ajude a Horda a proteger uma Torre Espiritual no Deserto de Ossos.‡Помогите Орде удерживать Башню духов в Костяных пустошах.‡Helft der Horde, einen Turm in der Knochenwüste zu sichern.‡호드가 해골 무덤에 있는 영혼의 탑을 점령하도록 도와야 합니다.‡Ayuda a la Horda a proteger una torre del Espíritu en El Vertedero de Huesos.‡Ayuda a la Horda a proteger una torre del Espíritu en El Vertedero de Huesos.‡Aidez la Horde à prendre le contrôle d\'une Tour des esprits dans le désert des Ossements.‡帮助部落占据白骨荒野上的一座灵魂之塔。‡幫助部落佔領白骨荒野的靈魂尖塔。',
  }
},
[11507] = {
  {
    'Ancião Atuik e Kamagua‡Старейшина Атуик из Камагуа‡Urahn Atuik und Kamagua‡장로 아투이크와 카마구아‡El ancestro Atuik y Komawa‡El ancestro Atuik y Komawa‡L\'Ancien Atuik et Kamagua‡卡玛古的长者阿图伊克‡長者阿推克和卡瑪廓',
    nil,
    'Orfus de Kamagua, do Fiorde Uivante, quer que você entregue o Pacote de Orfus para o Ancião Atuik, em Kamagua.‡Орфус Камагуанский из Ревущего фьорда просит вас отнести узелок старейшине Атуику из Камагуа.‡Orfus von Kamagua im Heulenden Fjord möchte, dass Ihr Orfus\' Bündel nach Kamagua zu Urahn Atuik bringt.‡울부짖는 협만에 있는 카마구아의 오르푸스가 카마구아로 가서 오르푸스의 꾸러미를 장로 아투이크에게 전달해 달라고 했습니다.‡Orfus de Komawa en el Fiordo Aquilonal quiere que entregues el fardo de Orfus al ancestro Atuik en Komawa.‡Orfus de Komawa en el Fiordo Aquilonal quiere que entregues el fardo de Orfus al ancestro Atuik en Komawa.‡Orfus de Kamagua, dans le Fjord hurlant, vous demande d\'apporter le Paquet d\'Orfus à l\'Ancien Atuik à Kamagua.‡嚎风峡湾的奥弗斯希望你能把他的包裹交给卡玛古的长者阿图伊克。‡凜風峽灣的卡瑪廓的歐弗斯要你將歐弗斯的包裹送到卡瑪廓給長者阿推克。',
  }
},
[11508] = {
  {
    'Grazzix Estalarroca‡Греззикс Иглохруст‡Grezzix Achsenbruch‡그레직스 스핀들스냅‡Grezzix Morthadellix‡Grezzix Morthadellix‡Grezzix Claquefuseau‡格雷兹克斯·斯宾德斯纳普‡格瑞希克斯·斷紡',
    nil,
    'Fale com Grazzix Estalarroca.‡Поговорите с Греззиксом Иглохрустом.‡Sprecht mit Grezzix Achsenbruch.‡그레직스 스핀들스냅과 대화해야 합니다.‡Habla con Grezzix Morthadellix.‡Habla con Grezzix Morthadellix.‡Parlez à Grezzix Claquefuseau.‡与格雷兹克斯·斯宾德斯纳普谈一谈。‡去找格瑞希克斯·斷紡談談。',
  }
},
[11509] = {
  {
    'O sangue-bom‡Чудак среди чудаков‡Sich einen Ruf machen‡진정한 "신세대"‡"Credibilidad" callejera‡"Credibilidad" callejera‡Un gars populaire…‡“银月”哈瑞‡街頭「信用」',
    nil,
    'Fale com Rique "Luaprata" na Angra dos Malandros sobre os artefatos vraikalen desaparecidos.‡Поговорите с Гарри "Луносветом" в Лагере Скалаваг и расспросите его о пропавших врайкульских артефактах.‡Sprecht mit "Silbermond" Harry im Halunkeneck über die verschwundenen Vrykulartefakte.‡사라진 브리쿨 유물에 관해 해적 야영지에 있는 "실버문" 해리와 대화해야 합니다.‡Habla con Harry "Lunargenta" en el Cabo Pillastre sobre los artefactos vrykuls desaparecidos.‡Habla con Harry "Lunargenta" en el Cabo Pillastre sobre los artefactos vrykuls desaparecidos.‡Parlez à Harry « Lune-d’argent », au Cap du Forban, des artéfacts vrykuls manquants.‡与无赖港的“银月”哈瑞谈论失踪的维库人圣物。‡與無賴角的『銀月』哈利談談有關不見的維酷神器。',
  }
},
[11510] = {
  {
    '"Fofona"‡"Челюсти"‡"Bodo von der Hermannsklause"‡"씽씽이"‡"Movidic"‡"Movidic"‡« Scoodles »‡斯库德‡『史酷朵斯』',
    nil,
    'Rique "Luaprata", da Angra dos Malandros, quer que você recupere para ele o Cristal de Vidência Sin\'dorei de dentro de "Fofona", a orca.‡Гарри "Луносвет" из Лагеря Скалаваг просит вас достать гадальный шар син\'дорай, принадлежащий ему, из брюха косатки по прозвищу "Челюсти".‡"Silbermond" Harry im Halunkeneck möchte, dass Ihr den Orca "Bodo von der Hermannsklause" tötet und den Wahrsagerkristall der Sin\'dorei wiederbeschafft.‡해적 야영지에 있는 "실버문" 해리가 신도레이 점술 수정을 범고래 "씽씽이"에게서 되찾아 달라고 했습니다.‡Harry "Lunargenta" de Cabo Pillastre quiere que recuperes su cristal de visión sin\'dorei de "Movidic" la orca.‡Harry "Lunargenta" de Cabo Pillastre quiere que recuperes su cristal de visión sin\'dorei de "Movidic" la orca.‡Harry « Lune-d’argent », au Cap du Forban, veut que vous repreniez son Cristal de divination sin’dorei à l’épaulard « Scoodles ».‡无赖港的“银月”哈瑞希望你能从逆戟鲸斯库德那里夺回他的辛多雷占卜水晶。‡無賴角的『銀月』哈利要你從虎鯨『史酷朵斯』的身上取回辛多雷占卜水晶。',
  }
},
[11511] = {
  {
    'O cajado da fúria da tempestade‡Посох Неистовства Бури‡Der Stab des Sturmfurors‡폭풍 강타 지팡이‡El bastón de la Furia de la Tormenta‡El bastón de la Furia de la Tormenta‡Le bâton de la fureur de l\'orage‡风暴愤怒法杖‡風暴之怒法杖',
    nil,
    'Recupere o Cajado da Fúria da Tempestade e entregue-o para Orfus de Kamagua, no Fiorde Uivante.‡Найдите посох Неистовства Бури и отнесите его Орфусу Камагуанскому в Ревущий фьорд.‡Beschafft den Stab des Sturmfurors und bringt ihn zu Orfus von Kamagua im Heulenden Fjord.‡폭풍 강타 지팡이를 되찾아 울부짖는 협만의 고대 승강장에 있는 카마구아의 오르푸스에게 전달해야 합니다.‡Recupera el bastón de la Furia de la Tormenta y llévaselo a Orfus de Komawa en el Fiordo Aquilonal.|n‡Recupera el bastón de la Furia de la Tormenta y llévaselo a Orfus de Komawa en el Fiordo Aquilonal.|n‡Récupérez le Bâton de la fureur de l’orage et remettez-le à Orfus de Kamagua, dans le Fjord hurlant.‡找回风暴愤怒法杖，把它交给嚎风峡湾的海象人——卡玛古的奥弗斯。‡找到風暴之怒法杖，然後把它交給凜風峽灣的卡瑪廓的歐弗斯。',
  }
},
[11512] = {
  {
    'O coração congelado de Isuldof‡Ледяное сердце Исулдофа‡Das gefrorene Herz Isuldofs‡이술도프의 얼어붙은 심장‡El corazón congelado de Isuldof‡El corazón congelado de Isuldof‡Le cœur gelé d\'Isuldof‡伊斯多弗的冰冷之心‡伊蘇鐸夫的冰凍心臟',
    nil,
    'Recupere o Coração Congelado de Isuldof e entregue-o para Orfus de Kamagua, no Fiorde Uivante.‡Найдите ледяное сердце Исулдофа и отнесите его Орфусу Камагуанскому в Ревущий фьорд.‡Beschafft das gefrorene Herz Isuldofs und bringt es zu Orfus von Kamagua im Heulenden Fjord.‡이술도프의 얼어붙은 심장을 되찾아 울부짖는 협만의 고대 승강장에 있는 카마구아의 오르푸스에게 전달해야 합니다.‡Recupera el corazón congelado de Isuldof y llévaselo a Orfus de Komawa en el Fiordo Aquilonal.‡Recupera el corazón congelado de Isuldof y llévaselo a Orfus de Komawa en el Fiordo Aquilonal.‡Récupérez le Cœur gelé d’Isuldof et remettez-le à Orfus de Kamagua dans le Fjord Hurlant.‡找回伊斯多弗的冰冷之心，把它交给嚎风峡湾的海象人——卡玛古的奥弗斯。‡找到伊蘇鐸夫的冰凍心臟，然後把它交給凜風峽灣的卡瑪廓的歐弗斯。',
  }
},
[11513] = {
  {
    'Interceptação das células de mana‡Перехват контейнеров с маной‡Manazellen abfangen‡마나 저장기 탈취‡Interceptar las células de maná‡Interceptar las células de maná‡Intercepter des cellules de mana‡截获法力晶格‡攔截法力電池',
    nil,
    'Obtenha 10 Células de Mana Contrabandeadas e entregue-as a Exarca Nasuun no Terraço da Luz, que fica em Shattrath.‡Добудьте 10 контрабандных контейнеров с маной и отнесите их экзарху Назууну на террасу Света в Шаттрат.‡Beschafft 10 eingeschmuggelte Manazellen und kehrt anschließend zu Exarch Nasuun auf der Terrasse des Lichts in Shattrath zurück.‡밀수한 마나 저장기 10개를 모아 샤트라스 빛의 정원에 있는 총독 나순에게 가져가야 합니다.‡Consigue 10 células de maná de contrabando y vuelve a ver al exarca Nasuun en el Bancal de la Luz, en la Ciudad de Shattrath.‡Consigue 10 células de maná de contrabando y vuelve a ver al exarca Nasuun en el Bancal de la Luz, en la Ciudad de Shattrath.‡Procurez-vous 10 Cellules de mana de contrebande et apportez-les à l\'Exarque Nasuun sur la Terrasse de la Lumière à Shattrath.‡夺取10块走私来的法力晶格，把它们带回沙塔斯城，交给圣光广场上的主教纳苏恩。‡找到10個走私的法力電池，然後把他們交給撒塔斯城，聖光露臺的主教納蘇安。',
  }
},
[11514] = {
  {
    'Manutenção do Portal para a Nascente do Sol‡Поддержка портала Солнечного Колодца‡Das Sonnenbrunnenportal aufrechterhalten‡태양샘 차원문 에너지 공급‡Hay que mantener el Portal de La Fuente del Sol‡Hay que mantener el Portal de La Fuente del Sol‡Maintenir le portail du Puits de soleil‡维持传送门‡維持太陽之井傳送門',
    nil,
    'Obtenha 10 Células de Mana Contrabandeadas e entregue-as a Exarca Nasuun no Terraço da Luz, que fica em Shattrath.‡Добудьте 10 контрабандных контейнеров с маной и отнесите их экзарху Назууну на террасу Света в Шаттрат.‡Beschafft 10 eingeschmuggelte Manazellen und kehrt anschließend zu Exarch Nasuun auf der Terrasse des Lichts in Shattrath zurück.‡밀수한 마나 저장기 10개를 모아 샤트라스 빛의 정원에 있는 총독 나순에게 가져가야 합니다.‡Consigue 10 células de maná de contrabando y vuelve a ver al exarca Nasuun en el Bancal de la Luz, en la Ciudad de Shattrath.‡Consigue 10 células de maná de contrabando y vuelve a ver al exarca Nasuun en el Bancal de la Luz, en la Ciudad de Shattrath.‡Procurez-vous 10 Cellules de mana de contrebande et apportez-les à l\'Exarque Nasuun sur la Terrasse de la Lumière à Shattrath.‡夺取10块走私来的法力晶格，把它们带回沙塔斯城，交给圣光广场上的主教纳苏恩。‡找到10個走私的法力電池，然後把他們交給撒塔斯城，聖光露臺的主教納蘇安。',
  }
},
[11515] = {
  {
    'Sangue por sangue‡Кровь за кровь‡Blut für Blut‡피에는 피‡Sangre por sangre‡Sangre por sangre‡Sang pour sang‡血债血偿‡以血換血',
    nil,
    'A Magistra Seyla, no Trono de Kil\'jaeden, quer que você mate 4 Sangrevis Esquálidos usando o Sifão Vil neles. Você precisará de Sangue Demoníaco dos Arautos da Ira próximos para encher o Sifão Vil.‡Магистр Сейла у трона Кил\'джедена велит вам убить 4 истощенных сквернокровов при помощи конденсатора Скверны. Вам понадобится кровь демонов, которая течет по венам находящихся рядом зловещих глашатаев, чтобы наполнить конденсатор Скверны.‡Magistrix Seyla auf Kil\'jaedens Thron möchte, dass Ihr mit Hilfe des Teufelstrinkers 4 ausgemergelte Getriebene des Teufelsbluts tötet. Um den Teufelstrinker zu speisen, benötigt Ihr das Dämonenblut von Racheherolden, die sich in der Nähe befinden.‡킬제덴의 옥좌에 있는 마법학자 세일라가 악마 흡수기를 사용해 쇠약해진 지옥피엘프 4마리를 처치해 달라고 했습니다. 악마 흡수기에 힘을 불어넣으려면 주변에 있는 분노의 전령에게서 악마의 피를 구해야 합니다.‡La magistrix Seyla en el Trono de Kil\'jaeden quiere que mates 4 Sangrevil demacrados usando el sifón vil sobre ellos. Necesitarás sangre demoníaca de los Heraldos de cólera cercanos para propulsar el sifón vil.‡La magistrix Seyla en el Trono de Kil\'jaeden quiere que mates 4 Sangrevil demacrados usando el succionador vil sobre ellos. Necesitarás sangre demoníaca de los Heraldos de cólera cercanos para propulsar el succionador vil.‡La Magistrice Seyla, au Trône de Kil\'jaeden, vous demande de tuer 4 Gangresangs émaciés en utilisant le gangresiphon sur eux. Vous aurez besoin de sang démoniaque, qui s\'obtient sur les Hérauts de courroux des alentours, pour alimenter le siphon.‡基尔加丹王座的魔导师瑟伊拉希望你使用魔能虹吸宝石杀死4个憔悴的魔血精灵。你需要用附近的天怒先锋身上的恶魔血液来启动魔能虹吸宝石。‡基爾加丹王座的博學者賽菈要你對4名憔悴的魔化血精靈使用魔化虹管，然後再殺死他們。你會需要從附近憤怒傳令官身上取得的惡魔之血來強化血液虹吸。',
  }
},
[11516] = {
  {
    'Bloqueio do portal‡Взрыв врат‡Vernichtet den Durchgang‡관문 폭파‡Destroza el portal‡Destroza el portal‡Détruire la porte‡轰炸传送门‡炸毀入口',
    nil,
    'A Magistra Seyla, no Trono de Kil\'jaeden, quer que você use as Brasas Crepitantes para evocar uma Tocha Viva. Mate Fagulhas Vis Incandescentes perto dela até que se torne uma Tocha Viva Instável. Leve a Tocha Viva Instável ao Portal da Legião e destrua-o.‡Магистр Сейла у трона Кил\'джедена велит вам взять раскаленные угли, чтобы вызвать живую вспышку и убивать рядом с ней раскаленных искр Скверны, пока она не станет нестабильной живой вспышкой. Вернитесь к вратам Легиона вместе с нестабильной живой вспышкой, чтобы уничтожить врата.‡Magistrix Seyla auf Kil\'jaedens Thron möchte, dass Ihr mit Hilfe der zischenden Glut ein lebendiges Leuchtfeuer beschwört und damit so lange glühende Höllenfunken in seiner Nähe tötet, bis es zu einem instabilen lebendigen Leuchtfeuer wird. Kehrt anschließend mit letzterem zum Durchgang der Legion zurück und zerstört ihn.‡킬제덴의 옥좌에 있는 마법학자 세일라가 이글거리는 불씨를 사용해 살아있는 불꽃을 소환한 다음 불안정해진 살아있는 불꽃이 될 때까지 빛나는 지옥불꽃을 사냥해 달라고 했습니다. 불안정해진 살아있는 불꽃을 가지고 불타는 군단 관문으로 돌아가 관문을 파괴해야 합니다.‡La magistrix Seyla del Trono de Kil\'jaeden quiere que uses las brasas muy calientes para invocar a una centella viva y asesinar chispas viles incandescentes cerca de ella hasta que se convierta en una centella viva inestable. Vuelve al portal de la Legión con la centella viva inestable para destruirlo.‡La magistrix Seyla del Trono de Kil\'jaeden quiere que uses las brasas muy calientes para invocar a una centella viva y asesinar chispas viles incandescentes cerca de ella hasta que se convierta en una centella viva inestable. Vuelve al portal de la Legión con la centella viva inestable para destruirlo.‡La Magistrice Seyla, au Trône de Kil\'jaeden, vous demande d\'utiliser les Braises grésillantes pour invoquer une Fusée vivante et de tuer les Gangrétincelles incandescentes près d\'elle jusqu\'à ce qu\'elle devienne une Fusée vivante instable. Retournez à la Porte de la Légion avec la Fusée vivante instable pour la détruire.‡基尔加丹王座的魔导师瑟伊拉希望你使用炽热的灰烬召唤一个活焰，在它周围消灭大型魔能火花，它就会逐渐变成一个不稳定的活焰。带着不稳定的活焰去摧毁军团传送门。‡基爾加丹王座的博學者賽菈要你使用高熱餘燼召喚出生命火花。然後殺死那些閃亮的魔化火光，直到它轉變為不穩定的生命火花。帶著不穩定的生命火花回到軍團入口摧毀它。',
  }
},
[11517] = {
  {
    '‡Встреча с Назууном‡Meldung an Nasuun‡나순에게 보고‡Informa a Nasuun‡Informa a Nasuun‡Se présenter à Nasuun‡向纳苏恩报到‡向納蘇安回報',
    nil,
    '‡Торговец Портануус просит вас поговорить с экзархом Назууном на Террасе Света в Шаттрате.‡Händler Portanuus hat Euch gebeten, mit Exarch Nasuun auf der Terrasse des Lichts in Shattrath zu sprechen.‡포르타누스가 샤트라스 빛의 정원에 있는 총독 나순과 대화해 달라고 했습니다.‡El Proveedor Portanuus te ha pedido que hables con el exarca Nasuun en el Bancal de la Luz de la Ciudad de Shattrath.‡El Proveedor Portanuus te ha pedido que hables con el exarca Nasuun en el Bancal de la Luz de la Ciudad de Shattrath.‡Le Commerçant Portonuus veut que vous parliez à l\'Exarque Nasuun, à la Terrasse de la Lumière de Shattrath.‡商人波塔努斯要求你前往沙塔斯城，与圣光广场上的主教纳苏恩谈一谈。‡商人波塔努斯請你和主教納蘇安談談，他就在撒塔斯城的聖光露臺。',
  }
},
[11518] = {
  {
    '‡Еежедневный указатель портала Солнечного Колодца‡‡태양샘 일일 차원문 플래그‡Bandera diaria del portal de La Fuente del Sol‡Bandera diaria del portal de La Fuente del Sol‡Drapeau quotidien portail puits de soleil‡‡',
    nil,
    nil,
  }
},
[11519] = {
  {
    'O escudo perdido dos aesiritas‡Пропавший щит Эсиритса‡Der verlorene Schild der Aesiriten‡잃어버린 애시리테스의 방패‡El escudo perdido de los Aesirites‡El escudo perdido de los Aesirites‡Le bouclier perdu des Asirites‡失落的古神之盾‡失落的阿薩瑞特之盾',
    nil,
    'Fale com o Capitão Ellis a bordo do Santa Misericórdia.‡Поговорите с капитаном Эллис на борту "Сестренки милосердия".‡Sprecht mit Kapitän Ellis an Bord der Gnädigen Schwester.‡자비로운 수녀호의 선장 엘리스와 대화해야 합니다.‡Habla con el capitán Ellis a bordo del Hermana Misericordia.‡Habla con el capitán Ellis a bordo del Hermana Misericordia.‡Parlez au Capitaine Ellis à bord du Sœur Miséricorde.‡与慈悲修女号上的艾尔雷斯船长谈一谈。‡登上慈悲姊妹號，與船長艾爾利斯交談。',
  }
},
[11520] = {
  {
    'Descobrindo as suas raízes‡Смотри в корень‡Die eigenen Wurzeln entdecken‡뿌리를 찾아서‡Descubriendo tus raíces‡Descubriendo tus raíces‡À la découverte de vos racines‡寻根知底‡尋根',
    nil,
    'Mar\'nah, no Porto de Beirassol, quer que você viaje ao Morro Espinhoso, que fica na Terralém, colete 5 Raízes Espinhosas e torne a falar com ela.‡Мар\'на из гавани Солнечного Края просит вас отправиться на уступ Острого Шипа в Запределье, чтобы добыть для нее 5 корней Острого Шипа.‡Mar\'nah im Hafen der Sonnenweiten möchte, dass Ihr zur Messerdornhöhe in der Scherbenwelt reist, 5 Messerdornwurzeln sammelt und wieder zu ihr zurückkehrt.‡태양너울 항구에 있는 연금술사 마르나가 아웃랜드의 서슬가시 언덕에서 서슬가시 뿌리 5개를 구해 달라고 했습니다.‡Mar\'nah, en el Puerto de Tramo del Sol, quiere que viajes al Alto Rajaespina en Terrallende, recojas 5 raíces de Rajaespina y vuelvas junto a ella.‡Mar\'nah, en el Puerto de Tramo del Sol, quiere que viajes al Alto Rajaespina en Terrallende, recojas 5 raíces de Rajaespina y vuelvas junto a ella.‡Mar\'nah, au Port des Confins du soleil, vous demande de vous rendre sur l\'Éminence de Tranchépine en Outreterre et de réunir 5 Racines de Tranchépine avant de revenir la voir.‡阳湾港口的玛尔娜希望你前往外域的荆刺高地，收集5根荆刺根须给她。‡日境港的瑪納要你去外域的刺棘高地收集5個刺棘根莖，然後再回來找她。',
  }
},
[11521] = {
  {
    'Redescobrindo as suas raízes‡И опять – смотри в корень‡Eure Wurzeln wiederentdecken‡뿌리 재수집‡Redescubriendo tus raíces‡Redescubriendo tus raíces‡À la redécouverte de vos racines‡继续寻根‡重新尋找你的根',
    nil,
    'Mar\'nah, no Porto de Beirassol, quer que você viaje ao Morro Espinhoso, que fica na Terralém, colete 5 Raízes Espinhosas e torne a falar com ela.‡Мар\'на из гавани Солнечного Края просит вас отправиться на уступ Острого Шипа в Запределье, чтобы добыть для нее 5 корней Острого Шипа.‡Mar\'nah im Hafen der Sonnenweiten möchte, dass Ihr zur Messerdornhöhe in der Scherbenwelt reist, 5 Messerdornwurzeln sammelt und wieder zu ihr zurückkehrt.‡태양너울 항구에 있는 연금술사 마르나가 아웃랜드에 있는 서슬가시 언덕에서 서슬가시 뿌리 5개를 구해 달라고 했습니다.‡Mar\'nah, en el Puerto de Tramo del Sol, quiere que viajes al Alto Rajaespina en Terrallende, recojas 5 raíces de Rajaespina y vuelvas junto a ella.‡Mar\'nah, en el Puerto de Tramo del Sol, quiere que viajes al Alto Rajaespina en Terrallende, recojas 5 raíces de Rajaespina y vuelvas junto a ella.‡Mar\'nah, du port des Confins du soleil, vous demande de vous rendre sur l\'Éminence de Tranchépine en Outreterre et de vous procurer 5 Racines de Tranchépine avant de retourner la voir.‡阳湾港口的玛尔娜希望你前往外域的荆刺高地，收集5根荆刺根须给她。‡日境港的瑪納要你去外域的刺棘高地收集5個刺棘根莖，然後再回來找她。',
  }
},
[11522] = {
  {
    '‡‡Anforderungen:‡‡‡‡‡‡',
    nil,
    '‡‡ - Messerdornwurzel x 5‡‡‡‡‡‡',
  }
},
[11523] = {
  {
    'Ative as proteções!‡Подпитка для силового поля‡Fahrt die Barrieren hoch!‡수정 복구!‡¡Armad los resguardos!‡¡Armad los resguardos!‡Armez les protections !‡激活结界！‡保護結界!',
    nil,
    'O Capitão Theris Aurolar, no Bivaque Sol Partido, quer que você obtenha 4 Vestígios de Mana de Malévolos Ignóbeis e Devoradores Ignóbeis e os use para energizar uma das Proteções de Cristal ao redor das estruturas no Beirassol.‡Капитан Терис Рассветное Пламя с плацдарма армии Расколотого Солнца просит вас добыть 4 клочка маны у Презренных-злобней и Презренных-пожирателей и при их помощи активировать поле кристалла-хранителя, окружающее святилище Солнечного Края на востоке.‡Hauptmann Theris Morgenheim beim Sammelpunkt der Zerschmetterten Sonne will, dass Ihr 4 Manaüberreste von getriebenen Unholden und Verschlingern beschafft und sie benutzt, um eine der Kristallbarrieren aufzuladen, welche die Gebäude der Sonnenweiten umgeben.‡무너진 태양 집결지에 있는 대장 테리스 돈하스가 버림받은 엘프 마귀와 버림받은 엘프 포식자에게서 마나 파편 4개를 모아 태양너울 성소를 둘러싼 수호의 수정을 충전해 달라고 했습니다.‡El capitán Theris Albahogar de la Zona de Escala de Sol Devastado quiere que obtengas 4 restos de maná de devoradores desdichados y malignos desdichados y que los uses para energizar uno de los resguardos de cristal que rodean las estructuras del Tramo del Sol.‡El capitán Theris Albahogar de la Zona de Escala de Sol Devastado quiere que obtengas 4 restos de maná de devoradores desdichados y malignos desdichados y que los uses para energizar uno de los resguardos de cristal que rodean las estructuras del Tramo del Sol.‡Le Capitaine Theris Âtraurore, de la Zone de rassemblement du Soleil brisé, vous demande de vous procurer 4 Restes de mana sur les Fielleux déshérités et les Dévoreurs déshérités et de vous en servir pour alimenter un des Cristaux de protection qui entoure les bâtiments des Confins du soleil.‡破碎残阳基地的瑟里斯·黎明之心希望你能从失心魔瘾者和失心吞噬者那里获取4份法力余烬，用它们激活阳湾港建筑物外围的水晶结界。‡破碎之日會所的塞里斯·曦爐上尉要你從鄙惡者惡魔與鄙惡者吞噬者身上取得4個法力殘餘。使用它們來替日境周遭建築的一個水晶結界充能。',
  }
},
[11524] = {
  {
    'Fora de controle‡Хаотичное поведение‡Unberechenbares Verhalten‡오작동하는 파수병‡Comportamiento errático‡Comportamiento errático‡Comportement erratique‡游荡的奥术守卫‡不穩定的運轉',
    nil,
    'A Vindicante Xayann, no Bivaque Sol Partido, quer que você insira os Núcleos Sintonizados de Cristal em 5 Sentinelas Erráticas derrotadas para transformá-las em unidades amistosas.‡Воздаятельница Ксаяна на подготовительном плацдарме Расколотого Солнца просит, чтобы вы поместили настроенные кристаллы-сердечники в корпуса 5 побежденных магических стражей, чтобы перевести их в дружественный режим.‡Verteidigerin Xayann beim Sammelpunkt der Zerschmetterten Sonne möchte, dass Ihr die abgestimmten Kristallkerne ins Innere 5 besiegter herumirrender Wachposten steckt und sie so zu freundlichen Einheiten macht.‡무너진 태양 집결지에 있는 구원자 세이얀이 오작동하는 파수병을 5기 쓰러뜨리고 개량된 수정핵을 집어넣어 아군으로 만들어 달라고 했습니다.‡La vindicadora Xayann de la Zona de Escala de Sol Devastado quiere que coloques núcleos de cristal armonizado dentro de 5 avizores erráticos derrotados para convertirlos en unidades amistosas.‡La vindicadora Xayann de la Zona de Escala de Sol Devastado quiere que coloques núcleos de cristal armonizado dentro de 5 avizores erráticos derrotados para convertirlos en unidades amistosas.‡Le redresseur de torts Xayann, de la Zone de rassemblement du Soleil brisé, vous demande de placer les Noyaux cristallins en phase à l\'intérieur de 5 Factionnaires erratiques vaincus afin d\'en faire des unités alliées.‡破碎残阳基地的守备官夏安希望你将调和过的水晶核心放入5台被打败的奥术守卫体内，将它们转换成友军。‡破碎之日會所的復仇者薩楊希望你將調諧水晶核放入5隻被擊倒的不穩定哨兵體內，將他們轉化為友軍。',
  }
},
[11525] = {
  {
    'Mais conversões‡Дальнейшая перенастройка‡Weitere Konvertierungen‡계속되는 변환‡Más transformaciones‡Más transformaciones‡Plus de conversions‡转化更多奥术守卫‡進一步地轉化',
    nil,
    'A Vindicante Xayann, no Bivaque Sol Partido, quer que você insira os Núcleos Sintonizados de Cristal em 5 Sentinelas Erráticas para transformá-las em unidades amistosas.‡Воздаятельница Ксаяна на подготовительном плацдарме Расколотого Солнца просит вас поместить настроенные кристаллы-сердечники в корпуса 5 побежденных блуждающих караульных, чтобы перевести их в дружественный режим.‡Verteidigerin Xayann beim Sammelpunkt der Zerschmetterten Sonne möchte, dass Ihr die abgestimmten Kristallkerne ins Innere 5 besiegter herumirrender Wachposten steckt und sie so zu freundlichen Einheiten macht.‡무너진 태양 집결지에 있는 구원자 세이얀이 오작동하는 파수병을 5기 쓰러뜨리고 개량된 수정핵을 집어넣어 아군으로 만들어 달라고 했습니다.‡La vindicadora Xayann de la Zona de Escala de Sol Devastado quiere que coloques núcleos de cristal armonizado dentro de 5 avizores erráticos derrotados para convertirlos en unidades amistosas.‡La vindicadora Xayann de la Zona de Escala de Sol Devastado quiere que coloques núcleos de cristal armonizado dentro de 5 avizores erráticos derrotados para convertirlos en unidades amistosas.‡Le redresseur de torts Xayann, de la Zone de rassemblement du Soleil brisé, vous demande de placer les Noyaux cristallins en phase à l\'intérieur de 5 Factionnaires erratiques vaincus afin d\'en faire des unités alliées.‡破碎残阳基地的守备官夏安希望你将调和过的水晶核心放入5台被打败的奥术守卫体内，将它们转换成友军。‡破碎之日會所的復仇者薩楊希望你將調諧水晶核放入5隻被擊倒的不穩定哨兵體內，將他們轉化為友軍。',
  }
},
[11526] = {
  {
    'A magistra desaparecida‡Пропавший магистр‡Eine Magistrix wird vermisst‡사라진 마법학자‡La magistrix desaparecida‡La magistrix desaparecida‡La magistrice disparue‡失踪的魔导师‡失蹤的博學者',
    nil,
    'Use o Pergaminho Capturado da Legião perto do portal na Praça da Aurora. Quando estiver do outro lado do portal, encontre a Magistra Seyla.‡При помощи захваченного свитка Легиона, пройдите сквозь портал на Рассветной площади. Как только пройдете сквозь портал, найдите магистра Сейлу.‡Benutzt die erbeutete Schriftrolle der Legion in der Nähe des Portals auf dem Platz der Morgenröte. Findet Magistrix Seyla, sobald Ihr auf der anderen Seite des Portals seid.‡새벽 광장에 있는 차원문 근처에서 빼앗은 군단 두루마리를 사용하여 차원문을 통해 이동한 후 마법학자 세일라를 찾아야 합니다.‡Usa el pergamino de la Legión capturado cerca del portal de La Plaza Crepuscular. Cuando hayas atravesado el portal, busca a la magistrix Seyla.‡Usa el pergamino de la Legión capturado cerca del portal de La Plaza Crepuscular. Cuando hayas atravesado el portal, busca a la magistrix Seyla.‡Servez-vous du Parchemin de la Légion capturé près du portail de la place du Point-du-jour. Lorsque vous aurez franchi le portail, trouvez la magistrice Seyla.‡在黎明广场的传送门附近使用军团传送卷轴。穿越传送门之后，立刻找到魔导师瑟伊拉。‡靠近曙光廣場的傳送門時使用擄獲的軍團卷軸。一旦你穿過傳送門，找到博學者賽菈。',
  }
},
[11527] = {
  {
    'Motim no Santa Misericórdia‡Бунт на корабле‡Meuterei auf der Gnädigen‡자비로운 수녀호에 일어난 반란‡Motín en el Misericordia‡Motín en el Misericordia‡Les mutins de la Miséricorde‡慈悲修女号上的叛变‡慈悲號上的叛變',
    nil,
    'O Capitão Ellis, a bordo do Santa Misericórdia, no Fiorde Uivante, pediu que você recuperasse 5 Barris de Pólvora do porão.‡Капитан Эллис на борту "Сестренки милосердия" в Ревущем фьорде просит вас принести 5 бочек с порохом из трюма корабля.‡Kapitän Ellis an Bord der Gnädigen Schwester im Heulenden Fjord möchte, dass Ihr 5 Schießpulverfässer aus dem Frachtraum des Schiffs besorgt.‡울부짖는 협만의 자비로운 수녀호를 모는 선장 엘리스가 화약통 5개를 창고에서 가져다 달라고 했습니다.‡El capitán Ellis a bordo del Hermana Misericordia te ha pedido que recuperes 5 barricas de pólvora de la bodega del barco.|n‡El capitán Ellis a bordo del Hermana Misericordia te ha pedido que recuperes 5 barricas de pólvora de la bodega del barco.|n‡Le Capitaine Ellis, à bord du Sœur Miséricorde dans le Fjord Hurlant, vous a demandé de récupérer 5 Tonneaux de poudre d\'explosion dans la cale du bateau.‡嚎风峡湾的慈悲修女号上的艾尔雷斯船长要求你从船上的储藏室夺回5个炸药桶。‡船長艾爾利斯要你從船艙中拿回5個桶裝火藥粉。他就在凜風峽灣的慈悲姐妹號之上。',
  }
},
[11528] = {
  {
    'Um presente de Véu de Inverno‡Подарок к Зимнему Покрову‡Ein Winterhauchgeschenk‡겨울맞이 선물‡Un obsequio del Festival de Invierno‡Un obsequio del Festival de Invierno‡Un cadeau pour la fête du Voile d\'hiver‡冬幕节的礼物‡冬幕節禮物',
    nil,
    nil,
  }
},
[11529] = {
  {
    'Butim de Sorlof‡Сокровища Сорлофа‡Sorlofs Beute‡소를로프의 보물‡El botín de Sorlof‡El botín de Sorlof‡Le butin de Sorlof‡索罗夫的宝藏‡索洛夫的戰利品',
    nil,
    'Mate Sorlof usando o Canhãozão e recupere o Butim de Sorlof. Leve o Butim de Sorlof para o capitão Ellis, a bordo do Santa Misericórdia.‡Убейте Сорлофа из большой пушки и принесите капитану Эллис сокровища Сорлофа на борт "Сестренки милосердия".‡Vernichtet Sorlof mithilfe der Dicken Berta, holt Euch Sorlofs Beute und kehrt mit ihr zu Kapitän Ellis auf der Gnädigen Schwester zurück.‡왕대포를 사용하여 소를로프를 처치하고 소를로프의 보물을 되찾은 다음 자비로운 수녀호에 있는 선장 엘리스에게 가야 합니다.‡Mata a Sorlof usando la gran arma y recupera el botín de Sorlof. Devuélvele el botín de Sorlof al capitán Ellis a bordo del Hermana Misericordia.‡Mata a Sorlof usando la gran arma y recupera el botín de Sorlof. Devuélvele el botín de Sorlof al capitán Ellis a bordo del Hermana Misericordia.‡Tuez Sorlof à l\'aide du Gros canon et récupérez le Butin de Sorlof. Rapportez le Butin de Sorlof au capitaine Ellis à bord du Sœur Miséricorde.‡用大炮杀死索罗夫，夺得索罗夫的宝藏。将索罗夫的宝藏交给慈悲修女号上的艾尔雷斯船长。‡使用大砲殺死索洛夫，取得索洛夫的戰利品。把索洛夫的戰利品還給慈悲姐妹號的船長艾爾利斯。',
  }
},
[11530] = {
  {
    'O escudo dos aesiritas‡Щит Эсиритса‡Der Schild der Aesiriten‡애시리테스의 방패‡El escudo de los Aesirites‡El escudo de los Aesirites‡Le bouclier des Asirites‡古神之盾‡阿薩瑞特之盾',
    nil,
    'Devolva o Escudo dos Aesiritas para Orfus de Kamagua, no Elevador Ancestral, no Fiorde Uivante.‡Верните щит Эсиритса Орфусу Камагуанскому на Древний подъемник в Ревущем фьорде.‡Bringt den Schild der Aesiriten zu Orfus von Kamagua. Er befindet sich am Uralten Aufzug im Heulenden Fjord.‡애시리테스의 방패를 울부짖는 협만의 고대 승강장에 있는 카마구아의 오르푸스에게 돌려줘야 합니다.‡Devuelve el escudo de los Aesirites a Orfus de Komawa en El Antiguo Elevador en el Fiordo Aquilonal.‡Devuelve el escudo de los Aesirites a Orfus de Komawa en El Antiguo Elevador en el Fiordo Aquilonal.‡Rapportez le Bouclier des Asirites à Orfus de Kamagua à l\'Antique élévateur dans le Fjord Hurlant.‡将古神之盾带到嚎风峡湾的上古升降梯去，交给卡玛古的奥弗斯。‡將阿薩瑞特之盾還給卡瑪廓的歐弗斯，他在凜風峽灣的遠古升降梯。',
  }
},
[11531] = {
  {
    'Trapizonga esquisita‡Странная деталь мотора‡Seltsames Motorteil‡이상한 엔진 부품‡La pieza de motor extraña‡La pieza de motor extraña‡Pièce de moteur étrange‡奇怪的发动机零件‡奇怪的引擎零件',
    nil,
    'Leve a Trapizonga Esquisita para K. Lee Smallfry em Telredor.‡Отнесите странную деталь мотора к К. Ли Мелюзге в Терелдор.‡Bringt K. Lee Kleinkram in Telredor das seltsame Motorteil.‡이상한 엔진 부품을 텔레도르의 K. 리 스몰프라이에게 가져가야 합니다.‡Lleva la pieza de motor extraña a K. Lee Fritito en Telredor.‡Lleva la pieza de motor extraña a K. Lee Fritito en Telredor.‡Apportez la Pièce de moteur étrange à Manue Fretin à Telredor.‡将奇怪的发动机零件交给泰雷多尔的凯莉·弗莱。‡把奇怪的引擎零件帶去給泰倫多爾的李小炸。',
  }
},
[11532] = {
  {
    'Distração na Trilha da Morte‡Отвлекающий маневр на Тропе Мертвых‡Ablenkungsmanöver an der Todesschneise‡죽음의 흉터에서의 양동 작전‡Distracción en La Cicatriz Muerta‡Distracción en La Cicatriz Muerta‡Diversion à la Malebrèche‡轰炸死亡之痕‡分散死亡之痕的注意力',
    nil,
    'A Maga de Batalha Arynna quer que você fale com Ayren Quebranuvens quando estiver preparado para sobrevoar a Trilha da Morte. Quando estiver lá, use as Cargas Arcanas para matar 2 Suseranos do Abismo, 3 Feiticeiros Eredar e 12 Impositores da Fúria.‡Боевой маг Аринна хочет, чтобы вы поговорили с Айреном Ясное Небо, когда вы будете готовы к полету к Тропе Мертвых. Оказавшись над Тропой, при помощи чародейских зарядов уничтожьте 2 владык преисподней, 3 эредарских колдунов и 12 зловещих головорезов.‡Kampfmagierin Arynna möchte, dass Ihr mit Ayren Wolkenbrecher sprecht, sobald Ihr bereit seid, zur Todesschneise zu fliegen. Tötet dort mithilfe der arkanen Ladungen 2 Oberanführer der Grube, 3 Zauberer der Eredar und 12 Rachevollstrecker.‡전투마법사 아린나가 죽음의 흉터로 날아갈 준비가 되면 아이렌 클라우드브레이커와 대화하라고 했습니다. 죽음의 흉터에 도착하면 비전 폭파물을 사용해 지옥의 대군주 2명, 에레다르 마술사 3명, 격노의 집행자 12명을 처치해야 합니다.‡La maga de batalla Arynna quiere que hables con Ayren Rompenubes cuando estés preparada para volar a La Cicatriz Muerta. Una vez allí usa las cargas Arcanas para matar a 2 Señores Supremos del foso, 3 hechiceros eredar y 12 déspotas de cólera.‡La maga de batalla Arynna quiere que hables con Ayren Rompenubes cuando estés preparado para volar a La Cicatriz Muerta. Una vez allí usa las cargas arcanas para matar a 2 señores supremos del foso, 3 hechiceros eredar y 12 agentes de cólera.‡La mage de bataille Arynna vous demande de parler à Ayren Brisenuée quand vous serez prête à survoler la Malebrèche. Une fois là-bas, utilisez les Charges arcaniques pour tuer 2 Suzerains des abîmes, 3 Ensorceleurs érédars et 12 Massacreurs de courroux.‡战斗法师艾尔娜希望你去和艾雷·碎云谈一谈，飞往死亡之痕。用奥术炸弹杀死2个深渊霸主、3个艾瑞达巫师和12个天怒执行者。‡戰鬥法師艾里娜要你準備好飛越死亡之痕後，和埃倫·破雲者談談。一旦抵達之後，用秘法炸藥殺死2隻深淵霸主、3隻埃雷達爾巫士和12隻憤怒執行者。',
  }
},
[11533] = {
  {
    'Os ataques aéreos não podem parar‡Воздушные атаки должны продолжаться!‡Die Luftangriffe müssen weitergehen‡공습은 계속되어야 한다‡Los ataques aéreos deben continuar‡Los ataques aéreos deben continuar‡Les frappes aériennes doivent continuer‡继续空袭‡空中攻擊必須持續',
    nil,
    'A Maga de Batalha Arynna quer que você fale com Ayren Quebranuvens quando estiver preparado para sobrevoar a Trilha da Morte. Quando estiver lá, use as Cargas Arcanas para matar 2 Suseranos do Abismo, 3 Feiticeiros Eredar e 12 Impositores da Fúria.‡Боевой маг Аринна хочет, чтобы вы поговорили с Айреном Ясное Небо, когда вы будете готовы к полету к Тропе Мертвых. Оказавшись над Тропой, при помощи чародейских зарядов уничтожьте 2 владык преисподней, 3 эредарских колдунов и 12 зловещих головорезов.‡Kampfmagierin Arynna möchte, dass Ihr mit Ayren Wolkenbrecher sprecht, sobald Ihr bereit seid, zur Todesschneise zu fliegen. Tötet dort mithilfe der arkanen Ladungen 2 Oberanführer der Grube, 3 Zauberer der Eredar und 12 Rachevollstrecker.‡전투마법사 아린나가 죽음의 흉터로 날아갈 준비가 되면 아이렌 클라우드브레이커와 대화해 달라고 했습니다. 죽음의 흉터에 도착하면 비전 폭파물을 사용해 지옥의 대군주 2명, 에레다르 마술사 3명, 격노의 집행자 12명을 처치해야 합니다.‡La maga de batalla Arynna quiere que hables con Ayren Rompenubes cuando estés preparado para volar a La Cicatriz Muerta. Una vez allí usa las cargas Arcanas para matar a 2 Señores Supremos del foso, 3 hechiceros eredar y 12 déspotas de cólera.‡La maga de batalla Arynna quiere que hables con Ayren Rompenubes cuando estés preparado para volar a La Cicatriz Muerta. Una vez allí usa las cargas arcanas para matar a 2 señores supremos del foso, 3 hechiceros eredar y 12 agentes de cólera.‡La mage de bataille Arynna vous demande de parler à Ayren Brisenuée quand vous serez prêt à survoler la Malebrèche. Une fois là-bas, utilisez les Charges arcaniques pour tuer 2 Suzerains des abîmes, 3 Ensorceleurs érédars et 12 Massacreurs de courroux.‡战斗法师艾尔娜希望你去和艾雷·碎云谈一谈，飞往死亡之痕。用奥术炸弹杀死2个深渊霸主、3个艾瑞达巫师和12个天怒执行者。‡戰鬥法師艾里娜要你準備好飛越死亡之痕後，和埃倫·破雲者談談。一旦抵達之後，用秘法炸藥殺死2隻深淵霸主、3隻埃雷達爾巫士和12隻憤怒執行者。',
  }
},
[11534] = {
  {
    'Apresente-se a Nasuun‡Встреча с Назууном‡Meldung an Nasuun‡나순에게 보고‡Informa a Nasuun‡Informa a Nasuun‡Se présenter à Nasuun‡向纳苏恩报到‡向納蘇安回報',
    nil,
    'O Mercador Portaruus pediu para você falar com o Exarca Nasuun no Terraço da Luz, que fica em Shattrath.‡Торговец Портануус просит вас поговорить с экзархом Назууном на террасе Света в Шаттрате.‡Händler Portanuus hat Euch gebeten, mit Exarch Nasuun auf der Terrasse des Lichts in Shattrath zu sprechen.‡포르타누스가 샤트라스 빛의 정원에 있는 총독 나순과 대화해 달라고 했습니다.‡El Proveedor Portanuus te ha pedido que hables con el exarca Nasuun en el Bancal de la Luz de la Ciudad de Shattrath.‡El Proveedor Portanuus te ha pedido que hables con el exarca Nasuun en el Bancal de la Luz de la Ciudad de Shattrath.‡Le Commerçant Portonuus veut que vous parliez à l\'Exarque Nasuun, à la Terrasse de la Lumière de Shattrath.‡商人波塔努斯要求你前往沙塔斯城，与圣光广场上的主教纳苏恩谈一谈。‡商人波塔努斯請你和主教納蘇安談談，他就在撒塔斯城的聖光露臺。',
  }
},
[11535] = {
  {
    'Preparamentos‡Подготовка к работе‡Vorbereitungen‡준비를 위한 준비‡Preparándose‡Preparándose‡Préparatifs‡做好准备‡做好準備',
    nil,
    'Ferreira Hauthaa, no Arsenal de Beirassol, quer que você mate os Mirmidões Espinha Negra, ao leste, e use as chaves deles para roubar três pedaços de minério dos baús.‡Кузнец Хаутаа из оружейной Солнечного Края просит вас перебить мирмидонов из клана Черноспинов к востоку отсюда и при помощи их ключей украсть три куска руды из их сундуков.‡Schmiedin Hauthaa in der Waffenkammer der Sonnenweiten möchte, dass Ihr Myrmidonen der Dunkelflossen, die sich im Osten befinden, tötet und ihre Schlüssel dazu verwendet, 3 Stück Erz aus ihren Truhen zu stehlen.‡태양너울 무기고에 있는 대장장이 하우타가 동쪽의 어둠가시 미르미돈을 처치하고 그들의 열쇠를 사용해 상자에서 광석 3개를 훔쳐와 달라고 했습니다.‡La herrera Hauthaa, en el Arsenal de Tramo del Sol, quiere que mates mirmidones Espina Siniestra al este y que uses sus llaves para robar 3 menas de sus cofres.‡La herrera Hauthaa, en el Arsenal de Tramo del Sol, quiere que mates mirmidones Espina Siniestra al este y que uses sus llaves para robar 3 menas de sus cofres.‡Le forgeron Hauthaa, de l\'armurerie des Confins du soleil, veut que vous tuiez des Myrmidons Sombréchine, à l\'est, et que vous utilisiez leurs clés pour dérober trois morceaux de minerai dans leurs coffres.‡阳湾军械库的铁匠霍尔萨希望你去杀死东面的暗脊侍从，夺取他们的钥匙，然后从他们的箱子里偷取3块矿石。‡日境軍械庫的鐵匠荷莎要你殺死東部的暗脊部屬，用他們身上的鑰匙，然後從箱子中偷取三塊礦石。',
  }
},
[11536] = {
  {
    'Não pare agora...‡Продолжаем...‡Hört jetzt nicht auf!‡이젠 멈추지 않는다...‡No te pares ahora‡No te pares ahora‡Ne vous arrêtez pas...‡不要停下......‡現在不能停止……',
    nil,
    'Ferreira Hauthaa, no Arsenal de Beirassol, quer que você mate os Mirmidões Espinha Negra, ao leste, e use as chaves deles para roubar três pedaços de minério dos baús.‡Кузнец Хаутаа из оружейной Солнечного Края просит вас перебить мирмидонов из клана Черноспинов к востоку отсюда и при помощи их ключей украсть три куска руды из их сундуков.‡Schmiedin Hauthaa in der Waffenkammer der Sonnenweiten möchte, dass Ihr Myrmidonen der Dunkelflossen, die sich im Osten befinden, tötet und ihre Schlüssel dazu verwendet, um 3 Stück Erz aus ihren Truhen zu stehlen.‡태양너울 무기고에 있는 대장장이 하우타가 동쪽의 어둠가시 미르미돈을 처치하고 그들의 열쇠를 사용해 상자에서 광석 3개를 훔쳐와 달라고 했습니다.‡La herrera Hauthaa, en el Arsenal de Tramo del Sol, quiere que mates mirmidones Espina Siniestra al este y que uses sus llaves para robar 3 menas de sus cofres.‡La herrera Hauthaa, en el Arsenal de Tramo del Sol, quiere que mates mirmidones Espina Siniestra al este y que uses sus llaves para robar 3 menas de sus cofres.‡Le forgeron Hauthaa, de l\'armurerie des Confins du soleil, veut que vous tuiez des Myrmidons Sombréchine, à l\'est, et que vous utilisiez leurs clés pour dérober trois morceaux de minerai dans leurs coffres.‡阳湾军械库的铁匠霍尔萨希望你去杀死东面的暗脊侍从，夺取他们的钥匙，然后从他们的箱子里偷取3块矿石。‡日境軍械庫的鐵匠荷莎要你殺死東部的暗脊部屬，用他們身上的鑰匙，然後從箱子中偷取三塊礦石。',
  }
},
[11537] = {
  {
    'A batalha não pode parar‡Битва должна продолжаться!‡Die Schlacht muss weitergehen‡전투는 계속되어야 한다‡La batalla debe continuar‡La batalla debe continuar‡La bataille doit continuer‡继续作战‡戰鬥必須要繼續',
    nil,
    'O Emissário Inuuro quer que você mate 6 Demônios da Legião Ardente e o Emissário do Ódio na Praça da Aurora. Use o Estandarte Sol Partido para empalar o cadáver do Emissário do Ódio.‡Предвестник Инууро просит вас убить 6 демонов Пылающего Легиона и эмиссара Ненависти на Рассветной площади. Пригвоздите к земле древком Знамени Расколотого Солнца труп Эмиссара Ненависти.‡Herold Inuuro möchte, dass Ihr 6 Dämonen der brennenden Legion und den Abgesandten des Hasses auf dem Platz der Morgenröte niederstreckt. Benutzt das Banner der Zerschmetterten Sonne, um den Körper des Abgesandten des Hasses aufzuspießen.‡선구자 이누로가 새벽 광장에서 불타는 군단 악마 여섯과 증오의 사절을 처치해 달라고 했습니다. 사절을 처치한 후 무너진 태양 깃발을 꽂아야 합니다.‡El presagista Inuuro quiere que mates a 6 demonios de la Legión Ardiente y al emisario del Odio en La Plaza Crepuscular. Usa el estandarte de Sol Devastado para empalar el cadáver del emisario del Odio.‡El presagista Inuuro quiere que mates a 6 demonios de la Legión Ardiente y al emisario del Odio en La Plaza Crepuscular. Usa el estandarte de Sol Devastado para empalar el cadáver del emisario del Odio.‡Le Messager Inuuro vous demande de tuer 6 Démons de la Légion ardente et l\'Emissaire de haine sur la place du Point-du-jour. Utilisez la Bannière du Soleil brisé pour empaler le cadavre de l\'Emissaire de haine.‡先驱者伊努罗希望你前往黎明广场，杀死仇恨使者和6名燃烧军团恶魔，然后将破碎残阳战旗插在仇恨使者的尸体上。‡先驅者因努羅要你殺死在曙光廣場的6隻燃燒軍團惡魔和一名憎恨密使。把破碎之日旌旗插在憎恨密使的屍體上。',
  }
},
[11538] = {
  {
    'Batalha pela Armaria de Beirassol‡Сражение за оружейную Солнечного Края‡Die Schlacht um die Waffenkammer der Sonnenweiten‡태양너울 무기고 습격 작전‡La batalla por el Arsenal de Tramo del Sol‡La batalla por el Arsenal de Tramo del Sol‡La bataille pour l\'Armurerie des Confins du soleil‡军械库之战‡日境軍械庫的戰鬥',
    nil,
    'O Emissário Inuuro quer que você mate 6 Demônios da Legião Ardente e o Emissário do Ódio na Praça da Aurora ou na Armaria de Beirassol. Use o Estandarte Sol Partido para empalar o cadáver do Emissário do Ódio.‡Предвестник Инууро просит вас убить 6 демонов Пылающего Легиона и эмиссара ненависти на Рассветной площади или в оружейной Солнечного Края. Пригвоздите труп эмиссара ненависти к земле древком знамени армии Расколотого Солнца.‡Herold Inuuro möchte, dass Ihr 6 Dämonen der brennenden Legion und den Abgesandten des Hasses auf dem Platz der Morgenröte oder der Waffenkammer der Sonnenweiten niederstreckt. Benutzt das Banner der Zerschmetterten Sonne, um den Körper des Abgesandten des Hasses aufzuspießen.‡선구자 이누로가 새벽 광장이나 태양너울 무기고에서 불타는 군단 악마 여섯과 증오의 사절을 처치해 달라고 했습니다. 사절을 처치한 후 무너진 태양 깃발을 꽂아야 합니다.‡El presagista Inuuro quiere que mates a 6 demonios de la Legión Ardiente y al emisario del Odio en La Plaza Crepuscular o en el Arsenal de Tramo del Sol. Usa el estandarte de Sol Devastado para empalar el cadáver del emisario del Odio.‡El presagista Inuuro quiere que mates a 6 demonios de la Legión Ardiente y al emisario del Odio en La Plaza Crepuscular o en el Arsenal de Tramo del Sol. Usa el estandarte de Sol Devastado para empalar el cadáver del emisario del Odio.‡Le Messager Inuuro vous demande de tuer 6 Démons de la Légion ardente et l\'Emissaire de haine sur la place du Point-du-jour ou à l\'armurerie des Confins du soleil. Utilisez la Bannière du Soleil brisé pour empaler le cadavre de l\'Emissaire de haine.‡先驱者伊努罗希望你前往黎明广场或者阳湾军械库，杀死仇恨使者和6名燃烧军团恶魔，然后将破碎残阳战旗插在仇恨使者的尸体上。‡先驅者因努羅要你殺在曙光廣場或日境軍械庫的6隻燃燒軍團惡魔以及憎恨密使。用破碎之日旌旗刺穿憎恨密使的屍體。',
  }
},
[11539] = {
  {
    'A conquista do porto‡Захват гавани‡Den Hafen einnehmen‡항구 공략전‡Tomar el puerto‡Tomar el puerto‡Prendre le port‡占领港口‡',
    nil,
    'O Magíster Ilastar, na Armaria de Beirassol, quer que você mate 6 Evocadores Aurolumes, 6 Cavaleiros Sangrentos Aurolumes e 3 Atiradores Peritos Aurolumes.‡Магистр Иластар из оружейной Солнечного Края просит вас убить 6 призывателей, 6 рыцарей и 3 метких стрелков из клана Клинка Рассвета.‡Magister Ilastar in der Waffenkammer der Sonnenweiten möchte, dass Ihr 6 Beschwörer der Dämmerklingen, 6 Blutritter der Dämmerklingen und 3 Schützen der Dämmerklingen niederstreckt.‡태양너울 무기고에 있는 마법학자 일라스타가 새벽칼날단 소환사 6명, 새벽칼날단 혈기사 6명, 새벽칼날단 명사수 3명을 각각 처치해 달라고 했습니다.‡El Magister Ilastar en el Arsenal de Tramo del Sol quiere que mates a 6 invocadores Hojalba, a 6 Caballeros de sangre Hojalba y a 3 tiradores Hojalba.‡El Magister Ilastar en el Arsenal de Tramo del Sol quiere que mates a 6 invocadores Hojalba, a 6 Caballeros de sangre Hojalba y a 3 tiradores Hojalba.‡Le Magistère Ilastar, de l\'Armurerie des Confins du soleil, vous demande de tuer 6 Invocateurs de la Lame de l\'aube, 6 Chevaliers de sang de la Lame de l\'aube et 3 Archers de la Lame de l\'aube.‡阳湾军械库的魔导师伊拉斯塔希望你去消灭6个晨锋召唤者、6个晨锋血骑士和3个晨锋射手。‡',
  }
},
[11540] = {
  {
    'Esmague os Aurolumes‡Клинки Рассвета должны быть сокрушены!‡Vernichtet die Dämmerklingen‡새벽칼날단 격퇴‡Aplasta a los Hojalba‡Aplasta a los Hojalba‡Écraser la Lame de l\'aube‡击溃晨锋部队‡摧毀曦刃',
    nil,
    'O Magíster Ilastar, na Armaria de Beirassol, quer que você mate 6 Evocadores Aurolumes, 6 Cavaleiros Sangrentos Aurolumes e 3 Atiradores Peritos Aurolumes.‡Магистр Иластар из оружейной Солнечного Края просит вас убить 6 призывателей, 6 рыцарей крови и 3 стрелков из клана Клинка Рассвета.‡Magister Ilastar in der Waffenkammer der Sonnenweiten möchte, dass Ihr 6 Beschwörer der Dämmerklingen, 6 Blutritter der Dämmerklingen und 3 Bogenschützen der Dämmerklingen niederstreckt.‡태양너울 무기고에 있는 마법학자 일라스타가 새벽칼날단 소환사 6명, 새벽칼날단 혈기사 6명, 새벽칼날단 명사수 3명을 각각 처치해 달라고 했습니다.‡El Magister Ilastar en el Arsenal de Tramo del Sol quiere que mates a 6 invocadores Hojalba, a 6 Caballeros de sangre Hojalba y a 3 tiradores Hojalba.‡El Magister Ilastar en el Arsenal de Tramo del Sol quiere que mates a 6 invocadores Hojalba, a 6 Caballeros de sangre Hojalba y a 3 tiradores Hojalba.‡Le Magistère Ilastar, de l\'Armurerie des Confins du soleil, vous demande de tuer 6 Invocateurs de la Lame de l\'aube, 6 Chevaliers de sang de la Lame de l\'aube et 3 Archers de la Lame de l\'aube.‡阳湾军械库的魔导师伊拉斯塔希望你去消灭6个晨锋召唤者、6个晨锋血骑士和3个晨锋射手。‡日境軍械庫的博學者伊拉斯塔要你去殺死6名曦刃召喚師、6名曦刃血騎士和3名曦刃神射手。',
  }
},
[11541] = {
  {
    'Leve o caos à Costa Guelraverde‡Зачистить берег Зеленожабрых!‡Belästigung an der Küste der Grünkiemen‡초록아가미 해안의 혼란 조성‡Perturbar la Costa Branquia Verde‡Perturbar la Costa Branquia Verde‡Déstabilisation de la Côte de Verte-branchie‡解救绿鳃奴隶‡干擾綠鰓海岸',
    nil,
    'A Capitão Valindria quer que você liberte 10 Escravos Guelraverde. Fale novamente com ela a bordo do Orgulho de Luaprata no Porto de Beirassol após cumprir a tarefa.‡Капитан Валиндрия просит вас освободить 10 рабов из племени Зеленожабрых. Вернитесь к ней на борт "Гордости Луносвета" в гавань Солнечного Края по выполнении задания.‡Kapitänin Valindria möchte, dass Ihr 10 Grünkiemensklaven befreit und zu ihr zurückkehrt, sobald Ihr damit fertig seid. Sie befindet sich auf der \'Silbermonds Stolz\' im Hafen der Sonnenweiten.‡초록아가미 노예 10마리를 풀어주고 태양너울 항구에 정박 중인 실버문의 긍지호에 있는 선장 발린드리아에게 가야 합니다.‡La capitana Valindria quiere que liberes a 10 esclavos Branquia Verde. Vuelve junto a ella a bordo del Orgullo de Lunargenta en el Puerto de Tramo del Sol cuando hayas terminado.‡La capitana Valindria quiere que liberes a 10 esclavos Branquia Verde. Vuelve junto a ella a bordo del Orgullo de Lunargenta en el Puerto de Tramo del Sol cuando hayas terminado.‡Le Capitaine Valindria vous demande de libérer 10 Esclaves verte-branchie. Retournez la voir au bord de la Fierté de Lune-d\'argent au Port des Confins du soleil quand ce sera fait.‡瓦琳德拉上尉希望你能解救10个绿鳃奴隶。完成任务之后，去阳湾港口的银月之傲号上向她复命。‡瓦琳翠亞船長要你去釋放10個綠鰓奴隸。一旦任務完成，就回到日境港的銀月之驕的甲板向她回報。',
  }
},
[11542] = {
  {
    'Intercepte os reforços‡Перехватить подкрепление‡Haltet die Verstärkung auf‡증원군 차단‡Interceptar a los refuerzos‡Interceptar a los refuerzos‡Intercepter les renforts‡拦截援军‡攔截援軍',
    nil,
    'O Vindicante Kaalan, na Armaria de Beirassol, quer que você fale com Ayren Quebranuvens e sobrevoe a frota de reforço Aurolume. Use o Óleo Flamejante para atear fogo às velas dos navios durante o voo. Depois pouse e mate 6 Reservistas Aurolume.‡Воздаятель Каалан из оружейной Солнечного Края просит вас поговорить с Айреном Ясным Небом насчет полета до флота Клинков Рассвета. Затем при помощи горящего масла подожгите с воздуха паруса кораблей, а приземлившись, убейте 6 резервистов из армии Клинков Рассвета.‡Verteidiger Kaalan in der Waffenkammer der Sonnenweiten möchte, dass Ihr mit Ayren Wolkenbrecher redet. Fliegt dann über die Unterstützungsflotte der Dämmerklingen hinweg und benutzt das flammende Öl, um die Segel in Brand zu setzen. Erschlagt 6 Reservisten der Dämmerklingen, nachdem Ihr gelandet seid.‡태양너울 무기고에 있는 구원자 카알란이 아이렌 클라우드브레이커와 대화하여 새벽칼날단 증원군 선단을 공격하라고 했습니다. 비행 상태에서 불타는 기름으로 돛에 불을 지르고, 배에 내려 새벽칼날단 보충병 6명을 처치해야 합니다.‡El Vindicador Kaalan del Arsenal de Tramo del Sol quiere hables con Ayren Rompenubes y que vueles sobre la flota de refuerzo de Hojalba. Usa el aceite en llamas para incendiar las velas de los barcos mientras los sobrevuelas y cuando aterrices, mata a 6 reservistas Hojalba.‡El Vindicador Kaalan del Arsenal de Tramo del Sol quiere que hables con Ayren Rompenubes y que vueles sobre la flota de refuerzo de Hojalba. Usa el aceite en llamas para incendiar las velas de los barcos mientras los sobrevuelas y cuando aterrices, mata a 6 reservistas Hojalba.‡Le Redresseur de torts Kaalan, de l\'Armurerie des Confins du soleil, vous demande de parler à Ayren Brisenuée et de survoler la flotte de renforts de la Lame de l\'aube. Utilisez l\'Huile enflammée pendant votre vol pour mettre le feu aux voiles des navires, et après avoir atterri, tuez 6 Réservistes de la Lame de l\'aube.‡阳湾军械库的守备官凯兰要求你去跟艾雷·碎云谈一谈，并飞越晨锋部队的增援舰队。将火油投掷到对方的船帆上，使之引燃。落地后，再杀死6名晨锋预备兵。‡日境軍械庫的復仇者卡藍要你和埃倫·破雲者談談，並且飛往曦刃的支援艦隊。使用燃油點燃那些船帆，等你降落後，殺死6名曦刃後備兵。',
  }
},
[11543] = {
  {
    'Manter o inimigo ao largo‡Загнать врага в угол‡Den Feind vom Leibe halten‡항구 차단 작전‡Mantén al enemigo a raya‡Mantén al enemigo a raya‡Tenir l\'ennemi à distance‡拒敌港外‡在海岸阻擋敵軍',
    nil,
    'O Vindicante Kaalan, na Armaria de Beirassol, quer que você fale com Ayren Quebranuvens e sobrevoe a frota de reforço Aurolume. Use o Óleo Flamejante para atear fogo às velas dos navios durante o voo. Depois pouse e mate 6 Reservistas Aurolumes.‡Воздаятель Каалан из оружейной Солнечного Края просит вас поговорить с Айреном Ясным Небом насчет полета до флота Клинков Рассвета. Затем при помощи горящего масла подожгите с воздуха паруса кораблей, а приземлившись, убейте 6 резервистов из армии Клинков Рассвета.‡Verteidiger Kaalan in der Waffenkammer der Sonnenweiten möchte, dass Ihr mit Ayren Wolkenbrecher redet und über die Flotte mit Verstärkungstruppen der Dämmerklingen hinwegfliegt. Benutzt solange Ihr fliegt das flammende Öl, um die Segel in Brand zu setzen. Erschlagt 6 Reservisten der Dämmerklingen, nachdem Ihr gelandet seid.‡태양너울 무기고에 있는 구원자 카알란이 아이렌 클라우드브레이커와 대화하여 새벽칼날단 증원군 선단을 공격하라고 했습니다. 비행 상태에서 불타는 기름으로 돛에 불을 지르고, 배에 내려 새벽칼날단 보충병 6명을 처치해야 합니다.‡El Vindicador Kaalan del Arsenal de Tramo del Sol quiere hables con Ayren Rompenubes y que vueles sobre la flota de refuerzo de Hojalba. Usa el aceite en llamas para incendiar las velas de los barcos mientras los sobrevuelas y cuando aterrices, mata a 6 reservistas Hojalba.‡El Vindicador Kaalan del Arsenal de Tramo del Sol quiere que hables con Ayren Rompenubes y que vueles sobre la flota de refuerzo de Hojalba. Usa el aceite en llamas para incendiar las velas de los barcos mientras los sobrevuelas y cuando aterrices, mata a 6 reservistas Hojalba.‡Le redresseur de torts Kaalan, de l\'Armurerie des Confins du soleil, vous demande de parler à Ayren Brisenuée et de survoler la flotte de renforts de la Lame de l\'aube. Utilisez l\'Huile enflammée pendant votre vol pour mettre le feu aux voiles des navires, et après avoir atterri, tuez 6 Réservistes de la Lame de l\'aube.‡阳湾军械库的守备官凯兰要求你去跟艾雷·碎云谈一谈，并飞越晨锋部队的增援舰队。将火油投掷到对方的船帆上，使之引燃。落地后，再杀死6名晨锋预备兵。‡日境軍械庫的復仇者卡藍要你和埃倫·破雲者談談，並且飛往曦刃支援艦隊。在飛行途中使用燃油點燃那些船帆，等你降落後，殺死6名曦刃後備兵。',
  }
},
[11544] = {
  {
    'Armamentos de Ata\'mal‡Оружие Ата\'мала‡Waffen von Ata\'mal‡아타말 병기‡Armamentos de Ata\'mal‡Armamentos de Ata\'mal‡Les armes d\'Ata\'mal‡阿塔玛军备‡阿塔莫武裝',
    nil,
    'A Ferreira Hauthaa quer que você produza 5 Metais de Ata\'mal Purificados. Para isso, desmanche os Armamentos de Ata\'mal na bigorna dela na Armaria de Beirassol, que fica na Ilha de Quel\'Danas.‡Кузнец Хаутаа просит вас сделать для нее 5 кусков очищенного металла Ата\'мала. Сделайте это, раздробив на ее наковальне оружие Ата\'мала в оружейной Солнечного Края на острове Кель\'Данас.‡Schmiedin Hauthaa möchte, dass Ihr 5 Stück gereinigtes Metall von Ata\'mal herstellt. Um dies zu tun, müsst Ihr Waffen von Ata\'mal auf ihrem Amboss in der Waffenkammer der Sonnenweiten auf der Insel von Quel\'Danas zerlegen.‡쿠엘다나스 섬에 있는 태양너울 무기고의 대장장이 하우타가 그녀의 모루에서 아타말 병기를 분해해 정화된 아타말 금속 5개를 만들어 달라고 했습니다.‡La herrera Hauthaa necesita que crees 5 metales de Ata\'mal purificados. Puedes crearlos destruyendo armamentos de Ata\'mal en su yunque en el Arsenal de Tramo del Sol en la Isla de Quel\'Danas.‡La herrera Hauthaa necesita que crees 5 metales de Ata\'mal purificados. Puedes crearlos destruyendo armamentos de Ata\'mal en su yunque en el Arsenal de Tramo del Sol en la Isla de Quel\'Danas.‡Le Forgeron Hauthaa vous demande de produire 5 morceaux de Métal ata\'mal purifié. Pour ce faire, cassez des Armes d\'Ata\'mal sur son enclume à l\'Armurerie des Confins du soleil sur l\'île de Quel\'Danas.‡铁匠霍尔萨要求你在奎尔丹纳斯岛阳湾军械库的铁砧上打碎阿塔玛军备，以此制造5块净化过的阿塔玛金属。‡奎爾達納斯之島上的日境軍械庫的鐵匠荷莎希望你能做出5個淨化過的阿塔莫金屬。你可以在她的鐵砧上折毀阿塔莫武裝來取得金屬。',
  }
},
[11545] = {
  {
    'Filantropia‡Никто не забыт...‡Eine milde Gabe‡‡Una donación caritativa‡Una donación caritativa‡Un don charitable‡‡',
    nil,
    'A Anacoreta Ayuri, em Beirassol, que fica na Ilha da Nascente do Sol, quer que você doe 10 moedas de ouro.‡Анахорет Оури из Солнечного Края острова Солнечного Колодца просит вас пожертвовать 10 золотых.‡Anachoretin Ayuri in den Sonnenweiten auf der Insel des Sonnenbrunnens möchte, dass Ihr 10 Gold spendet.‡태양샘 섬의 태양너울에 있는 수도자 아유리가 10골드를 기부해 달라고 했습니다.‡La anacoreta Ayuri de Tramo del Sol, en la Isla de La Fuente del Sol, quiere que dones 10 oros.‡La anacoreta Ayuri de Tramo del Sol, en la Isla de La Fuente del Sol, quiere que dones 10 oros.‡L\'Anachorète Ayuri aux Confins du Soleil dans l\'Île du Puits de soleil veut que vous fassiez don de 10 pièces d\'or.‡奎尔丹纳斯岛阳湾港的学者艾尤莉希望你捐赠10枚金币。‡',
  }
},
[11546] = {
  {
    'Aberto para negócios‡Взаимовыгодный бизнес‡Geschäft geöffnet‡영업 개시‡Abierto al negocio‡Abierto al negocio‡On est ouvert‡开始营业‡開張營業',
    nil,
    'Mar\'nah, no Porto de Beirassol, quer que você colete 5 Frutas-sangue dos arbustos que se encontram em Quel\'Danas.‡Мар\'на из гавани Солнечного Края просит вас принести ей 5 ягод кровяники с кустов, которые можно найти на Кель\'Данасе.‡Mar\'nah im Hafen der Sonnenweiten möchte, dass Ihr 5 Blutbeeren von den Büschen auf Quel\'Danas sammelt.‡태양너울 항구에 있는 마르나가 쿠엘다나스의 덤불에서 선홍딸기 5개를 구해다 달라고 했습니다.‡Mar\'nah del Puerto de Tramo del Sol quiere que recojas 5 bayas de sangre de los arbustos de Quel\'Danas.‡Mar\'nah del Puerto de Tramo del Sol quiere que recojas 5 bayas de sangre de los arbustos de Quel\'Danas.‡Mar\'nah, du Port des Confins du soleil, vous demande de cueillir 5 Sangrelles sur les buissons de Quel\'Danas.‡阳湾港口的玛尔娜希望你从奎尔丹纳斯岛上的灌木丛中收集5颗血莓。‡日境港的瑪納要你從奎爾達納斯的樹叢收集5個血莓。',
  }
},
[11547] = {
  {
    'Decore as suas falas‡Знай свою силовую линию!‡Kenne deine Leylinien‡너희가 순간이동을 알아?!‡Conoce tus líneas Ley‡Conoce tus líneas Ley‡Les lignes telluriques et vous‡魔网能量线的读数‡瞭解你的地脈',
    nil,
    'O Astromante Darnarian, no Sacrário Beirassol, quer que você use o Cristal do Astromante no Cristal de Sangue, no portal da Praça da Aurora e no templo naga na Costa Guelraverde.‡Звездочет Дарнариан из святилища Солнечного Края просит вас при помощи кристалла звездочета настроить кровавый кристалл, портал на Рассветной площади и святилище наг на берегу Зеленожабрых.‡Astromant Darnarian im Sanktum der Sonnenweiten möchte, dass Ihr den Kristall des Astromanten am Blutkristall, am Portal auf dem Platz der Morgenröte und in der Nähe des Nagaschreins an der Küste der Grünkiemen benutzt.‡태양너울 성소에 있는 점성술사 다르나리안이 핏빛수정, 새벽 광장 차원문, 초록아가미 해안의 나가 제단에서 점성술사의 수정을 사용해 달라고 했습니다.‡El astromante Darnarian, en el Sagrario de Tramo del Sol, quiere que uses el cristal de astromante en el cristal de sangre, el portal de La Plaza Crepuscular y el sagrario naga en la Costa Branquia Verde.‡El astromante Darnarian, en el Sagrario de Tramo del Sol, quiere que uses el cristal de astromante en el cristal de sangre, el portal de La Plaza Crepuscular y el sagrario naga en la Costa Branquia Verde.‡L\'astromancien Darnarian du Sanctum des Confins du soleil vous demande d\'utiliser le Cristal de l\'astromancien sur le Cristal-sanglant, le portail de la place du Point-du-jour et le sanctuaire naga de la Côte de Verte-branchie.‡阳湾圣殿的星术师达纳里安希望你在血水晶、黎明广场传送门和绿鳃海岸的纳迦神殿上使用星术师的水晶。‡日境聖所的星術師達納里安要你對血水晶、曙光廣場的傳送門，以及綠鰓海岸的納迦祭壇使用星術師水晶。',
  }
},
[11548] = {
  {
    'Graças ao seu apoio de hoje e sempre‡Щедрое пожертвование‡Eure weitere Unterstützung‡지속적인 지원‡Tu incesante apoyo‡Tu incesante apoyo‡Votre soutien indéfectible‡鼎力支持‡你的持續支持',
    nil,
    'A Anacoreta Ayuri, em Beirassol, que fica na Ilha da Nascente do Sol, quer que você doe 10 moedas de ouro.‡Анахоретка Аюри из Солнечного Края у Солнечного Колодца просит вас пожертвовать 10 золотых.‡Anachoretin Ayuri in den Sonnenweiten auf der Insel des Sonnenbrunnens möchte, dass Ihr 10 Gold spendet.‡태양샘 섬의 태양너울에 있는 수도사 아유리가 10골드를 기부해 달라고 했습니다.‡La anacoreta Ayuri de Tramo del Sol, en la Isla de La Fuente del Sol, quiere que dones 10 oros.‡La anacoreta Ayuri de Tramo del Sol, en la Isla de La Fuente del Sol, quiere que dones 10 oros.‡L\'Anachorète Ayuri, des Confins du soleil sur l\'île du Puits de soleil, vous demande de faire un don de 10 pièces d\'or.‡奎尔丹纳斯岛阳湾港的学者艾尤莉希望你捐赠10枚金币。‡太陽之井島上日境的隱士艾悠里，希望你能夠捐助10枚金幣。',
  }
},
[11549] = {
  {
    'Um benfeitor generoso‡Великодушный благодетель‡Ein großmütiger Spender‡관대한 후원가‡Un benefactor magnánimo‡Un benefactor magnánimo‡Un bienfaiteur magnanime‡慷慨的捐赠者‡高尚的捐款人',
    nil,
    'O Anacoreta Kairthos quer que você doe 1.000 moedas de ouro para o projeto da Anacoreta Ayuri. Você será conhecido como Bomdiyada do Sol Partido, se cumprir esta missão.‡Анахорет Каиртос просит вас пожертвовать 1000 золотых на дело анахоретки Аюри. Вас будут называть Bomdiyada из армии Расколотого Солнца, если вы это сделаете.‡Anachoret Kairthos möchte, dass Ihr 1000 Gold spendet, um Anachoretin Ayuri in ihrem Vorhaben zu unterstützen. Wenn Ihr die Aufgabe abschließen solltet, werdet Ihr den Namen "Bomdiyada der Zerschmetterten Sonne" tragen.‡수도사 케어소스가 수도사 아유리의 선행을 도울 수 있도록 1000골드를 기부해 달라고 했습니다. 이 퀘스트를 완료하면 무너진 태양의 용사 Bomdiyada로 알려지게 됩니다.‡El anacoreta Kairthos quiere que dones 1000 oros para ayudar a la causa de la anacoreta Ayuri. Si completas esta misión, serás conocido como Bomdiyada del Sol Devastado.‡El anacoreta Kairthos quiere que dones 1000 oros para ayudar a la causa de la anacoreta Ayuri. Si completas esta misión, serás conocido como Bomdiyada del Sol Devastado.‡L\'Anachorète Kairthos vous demande de faire don de 1000 pièces d\'or pour soutenir l\'action de l\'anachorète Ayuri. Vous serez connu sous le nom de Bomdiyada du Soleil brisé si vous accomplissez cette quête.‡学者卡伊索斯希望你捐献1000枚金币以协助学者艾尤莉的事业。若完成这个任务，你将会获得"破碎残阳的Nekotestthre"的称号。‡隱士凱爾索斯希望你能夠捐獻1000枚金幣來協助隱士艾悠里的努力。如果完成這個任務的話，你將會以破碎之日的Bomdiyada廣為人知。',
  }
},
[11550] = {
  {
    'O enganador‡Входи, Искуситель...‡Der Betrüger betritt die Bühne...‡기만자의 개입‡Adelante, Falsario...‡Adelante, Falsario...‡Le Trompeur entre en scène‡欺诈者降临‡欺詐者的到來……',
    nil,
    'Apresente-se ao Arquimago Ne\'thul na Ilha de Quel\'Danas, que fica ao norte de Quel\'thalas.|n|nOs mestres de voo em Altaforja e em Luaprata farão com que você chegue ao seu destino.‡Отнесите сообщение верховному магу Нет\'улу на остров Кель\'Данас, к северу от Кель\'Таласа.|n|nЛюбой распорядитель полетов в Стальгорне или Луносвете доставит вас до места назначения.‡Meldet Euch bei Erzmagier Ne\'thul auf der Insel von Quel\'Danas, nördlich von Quel\'Thalas.|n|nSprecht mit Flugmeistern in Eisenschmiede und Silbermond, sie werden Euch dorthin bringen.‡쿠엘탈라스 북쪽의 쿠엘다나스 섬에 있는 대마법사 네툴에게 보고해야 합니다.|n|n아이언포지와 실버문에 있는 비행 조련사가 목적지까지 데려다 줄 겁니다.‡Preséntate ante el archimago Ne\'thul en la Isla de Quel\'Danas, al norte de Quel\'Thalas.|n|nLos maestros de vuelo de Forjaz y de Ciudad de Lunargenta te llevarán hasta tu destino.‡Preséntate ante el archimago Ne\'thul en la Isla de Quel\'Danas, al norte de Quel\'Thalas.|n|nLos maestros de vuelo de Forjaz y de Ciudad de Lunargenta te llevarán hasta tu destino.‡Présentez-vous à l\'Archimage Ne\'thul sur l\'Île de Quel\'Danas, au nord de Quel\'Thalas.|n|nLes maîtres de vol de Forgefer et de Lune-d\'argent peuvent vous y envoyer.‡前往奎尔萨拉斯正北方的奎尔丹纳斯岛，向大法师奈苏尔报到。|n|n铁炉堡和银月城的飞行管理员可以将你送到目的地。‡前往奎爾薩拉斯北方的奎爾達納斯之島，向大法師奈蘇爾報告。鐵爐堡和銀月城的飛行管理員能夠將你送到目的地。',
  }
},
[11551] = {
  {
    '‡Агамат, Первые врата‡Agamath, das erste Tor‡아가마스 - 첫번째 관문‡Agamath, la primera puerta‡Agamath, la primera puerta‡Agamath, la première porte‡阿加麦斯，第一道屏障‡阿格瑪司，初始之門',
    nil,
    nil,
  }
},
[11552] = {
  {
    '‡Рохендор, Вторые врата‡Rohendor, das zweite Tor‡로헨도르 - 두번째 관문‡Rohendor, la segunda puerta‡Rohendor, la segunda puerta‡Rohendor, la deuxième porte‡洛希多尔，第二道屏障‡洛罕鐸，次之門',
    nil,
    nil,
  }
},
[11553] = {
  {
    '‡Архониус, Последние врата‡Archonisus, das letzte Tor‡‡Archonisus, la puerta final‡Archonisus, la puerta final‡Archonisus, la dernière porte‡‡',
    nil,
    nil,
  }
},
[11554] = {
  {
    'Lealdade no fronte‡Солдатская дружба‡Ein Freund an der Front‡최전선에 선 전우‡Un amigo en primera línea‡Un amigo en primera línea‡Un ami sur le front‡前线的伙伴‡在前線的朋友',
    nil,
    nil,
  }
},
[11555] = {
  {
    'Honrado pelos aliados‡Уважение союзников‡Eure Verbündeten wollen Euer Wohl‡동맹에게 받는 존경‡Honrado por tus aliados‡Honrado por tus aliados‡Honoré par vos alliés‡盟友的尊敬‡被盟友所尊敬',
    nil,
    nil,
  }
},
[11556] = {
  {
    'Reverenciado no campo de batalha‡Почтение боевых друзей‡Auf dem Schlachtfeld zollt man Euch Respekt‡전장에서 얻은 영예‡Venerado en el campo de batalla‡Venerado en el campo de batalla‡Révéré sur le champ de bataille‡战友的景仰‡戰場上的崇敬',
    nil,
    nil,
  }
},
[11557] = {
  {
    'O melhor em combate‡Восхищение всего войска‡Alle Kämpfer begegnen Euch mit Ehrfurcht‡가장 고귀한 투사‡Exaltado entre todos los combatientes‡Exaltado entre todos los combatientes‡Exalté parmi tous les combattants‡勇冠三军‡所有戰士的崇拜',
    nil,
    nil,
  }
},
[11558] = {
  {
    'Paixonite aguda‡Опасная любовь‡Gefährliche Liebschaft‡사랑이라는 위험한 병‡Amor peligroso‡Amor peligroso‡Les périls de l\'amour‡危险的爱情‡危險的愛',
    nil,
    'Pegue um Cartão Mofado do Guardião e entregue-o para Félix Amado na Cidade Baixa.‡Возьмите заплесневелую открытку стража и отнесите ее Фенстаду Аргайлу в Подгороде.‡Besorgt eine modrige Karte des Wächters und bringt sie zu Fenstad Argyle in Unterstadt.‡언더시티 수호병의 곰팡이 슨 카드를 구해서 언더시티의 펜스타드 아가일에게 가져가야 합니다.‡Lleva una tarjeta mohosa de guardián a Fenstad Argyle a Entrañas.‡Lleva una tarjeta mohosa de guardián a Fenstad Argyle a Entrañas.‡Obtenez une Carte de garde moisie et rapportez-la à Fenstad Argyle, à Fossoyeuse.‡弄到一张发臭的卡片，并把它交给幽暗城的芬斯塔·艾吉勒。‡取得一張守衛發霉的卡片並帶給幽暗城的芬斯塔德·阿吉歐。',
  }
},
[11559] = {
  {
    'Fazemos qualquer negócio‡Торговля с Зимними Плавниками‡Winterflossenhandel‡겨울지느러미 일족과 거래 트기‡Comercio Aleta Invernal‡Comercio Aleta Invernal‡Commercer avec les Ailerons-d\'hiver‡冬鳍鱼人的贸易‡冬鰭交易',
    nil,
    'Junte 5 Mariscos da Falésia Invernal e entregue-os a Ahlurglgr, no Retiro da Falésia Invernal.‡Соберите 5 моллюсков Зимних Плавников и отдайте их Ахлурглгру в Приюте Зимних Плавников.‡Sammelt 5 Winterflossenmuscheln und liefert sie bei Ahlurglgr ab. Dieser befindet sich in der Zuflucht der Winterflossen.‡겨울지느러미 조개 5개를 모아 겨울지느러미 은신처에 있는 아흐루르글그르에게 가져가야 합니다.‡Reúne 5 almejas Aleta Invernal y llévaselas a Ahlurglgr en el Refugio Aleta Invernal.‡Reúne 5 almejas Aleta Invernal y llévaselas a Ahlurglgr en el Refugio Aleta Invernal.‡Ramassez 5 Palourdes aileron-d\'hiver et apportez-les à Ahlurglgr à la Retraite des Ailerons-d\'hiver.‡收集5只冬鳍蚌壳，将它们交给冬鳍避难所的呀噜咕噜。‡收集5個冬鰭蚌，然後把它們交給冬鰭避居地的阿魯咕嚕咕爾。',
  }
},
[11560] = {
  {
    'Essa não! Os girinos!‡О нет, наши бедные малыши!‡Oh neeiin, die Kaulquappen!‡어린 멀록 구출 작전!‡¡Oh no! ¡Los renacuajos!‡¡Oh no! ¡Los renacuajos!‡Jamais sans mes têtards‡救救蝌蚪！‡喔不，蝌蚪!',
    nil,
    'O Rei Mrgl-Mrgl lhe pediu para resgatar 20 Girinos Falésia Invernal. Fale novamente com ele no Retiro da Falésia Invernal assim que tenha cumprido esta missão.‡По поручению короля Мргла-Мргла спасите 20 головастиков Зимних Плавников. Вернитесь к королю в Приют Зимних Плавников, когда выполните задание.‡König Mrgl-Mrgl möchte, dass Ihr 20 Kaulquappen der Winterflossen befreit und anschließend zu ihm zurückkehrt. Er befindet sich in der Zuflucht der Winterflossen.‡멀록왕 아옳아옳이 어린 겨울지느러미 멀록 20마리를 구해달라고 했습니다. 임무를 마치면 겨울지느러미 은신처에 있는 그에게 가야 합니다.‡El rey Mrgl-Mrgl te ha pedido que rescates a 20 renacuajos Aleta Invernal. Vuelve a verlo al Refugio Aleta Invernal cuando hayas terminado.‡El rey Mrgl-Mrgl te ha pedido que rescates a 20 renacuajos Aleta Invernal. Vuelve a verlo al Refugio Aleta Invernal cuando hayas terminado.‡Le Roi Mrgl-Mrgl vous a demandé de sauver 20 Têtards aileron-d\'hiver. Retournez le voir à la Retraite des Ailerons-d\'hiver quand ce sera fait.‡国王姆嘎姆嘎要你解救20只冬鳍蝌蚪。完成任务后返回冬鳍避难所向他复命。‡莫戈莫戈大王要你去解救20個冬鰭蝌蚪。完成任務後回到冬鰭避居地找他。',
  }
},
[11561] = {
  {
    'Foram eles!‡Они!‡Die da!‡건너편에 원수가!‡¡Ellos!‡¡Ellos!‡Eux !‡就是他们！‡他們!',
    nil,
    'Brglmurgl, no Retiro da Falésia Invernal, pediu-lhe para matar 15 Murlocs da Falésia Invernal. Qualquer combinação de guerreiros, oráculos e costacantes serve.‡По просьбе Брглмургла в Приюте Зимних Плавников убейте воинов, оракулов и гарпунеров Зимних Плавников – всего 15 мурлоков.‡Brglmurgl in der Zuflucht der Winterflossen möchte, dass Ihr insgesamt 15 Murlocs der Winterflossen tötet, egal ob Krieger, Orakel oder Küstenschläger.‡겨울지느러미 은신처에 있는 브르글무르글이 전사, 점쟁이, 작살 사수를 가리지 않고 겨울지느러미 멀록 15마리를 처치해 달라고 했습니다.‡Brglmurgl en el Refugio Aleta Invernal te ha pedido que mates a 15 múrlocs Aleta Invernal. Cualquier combinación de guerreros, oráculos y rompeolas servirá.‡Brglmurgl en el Refugio Aleta Invernal te ha pedido que mates a 15 múrlocs Aleta Invernal. Cualquier combinación de guerreros, oráculos y rompeolas servirá.‡Brglmurgl, de la Retraite des Ailerons-d\'hiver, vous a demandé de tuer 15 Murlocs aileron-d\'hiver. N\'importe quelle combinaison de guerriers, oracles et guerriers des rivages fera l\'affaire.‡冬鳍避难所的吧咕姆咕要你杀死15名冬鳍鱼人，战士、智者或是巡滩者都行。‡冬鰭避居地的布爾格墨葛要你殺死15個冬鰭魚人。任何戰士、神諭者、濱擊者的組合都可以。',
  }
},
[11562] = {
  {
    'Meu faxineiro está me chantageando‡Меня хотят очернить!‡Mein Putzmurloc erpresst mich‡청소부의 협박‡Mi limpiador me está chantajeando‡Mi limpiador me está chantajeando‡Mon teinturier est un maître-chanteur‡我被敲竹杠了！‡我被我的清潔工勒索',
    nil,
    'O Rei Mrgl-Mrgl lhe pediu que você converse com Mrmrglmr na parte noroeste do Retiro da Falésia Invernal.‡По просьбе короля Мргла-Мргла поговорите с Мрмрглмром на северо-западной стороне Приюта Зимних Плавников.‡König Mrgl-Mrgl möchte, dass Ihr mit Mrmrglmr sprecht. Er befindet sich im nordwestlichen Teil der Zuflucht der Winterflossen.‡멀록왕 아옳아옳이 겨울지느러미 은신처 북서쪽 끝에 있는 므름르글므르와 이야기하라고 했습니다.‡El rey Mrgl-Mrgl te ha pedido que hables con Mrmrglmr al extremo noroeste del Refugio Aleta Invernal.‡El rey Mrgl-Mrgl te ha pedido que hables con Mrmrglmr al extremo noroeste del Refugio Aleta Invernal.‡Le Roi Mrgl-Mrgl vous a demandé de parler à Mrmrglmr à l\'extrémité nord-ouest de la Retraite des Ailerons-d\'hiver.‡国王姆嘎姆嘎要你与冬鳍避难所西北角的姆姆咕咕谈一谈。‡莫戈莫戈大王要你前往北風凍原的冬鰭避居地西北盡頭與姆姆戈莫談談。',
  }
},
[11563] = {
  {
    'Grmmurggll Mrllggrl Glrggl!!!‡Грммурглл Мрллглл Глрггл!‡Grmmurggll Mrllggrl Glrggl!!!‡그름무르그글 므를르그그르를 글르글!!!‡¡¡¡Grmmurggll Mrllggrl Glrggl!!!‡¡¡¡Grmmurggll Mrllggrl Glrggl!!!‡Grmmurggll Mrllggrl Glrggl !!!‡咕噜咕噜呜啦哇啦！‡戈墨爾吉珥 墨勒吉爾 吉爾戈!!!',
    nil,
    'Mrmrglmr quer que você lhe traga a Cabeça de Glrggl.‡Принесите Мрмрглмру в Приюте Зимних Плавников голову Глрггла.‡Mrmrglmr will, dass Ihr mit Glrggls Kopf zu ihm zurückkehrt. Er befindet sich in der Zuflucht der Winterflossen.‡겨울지느러미 은신처에 있는 므름르글므르가 글르글의 머리를 가져다 달라고 했습니다.‡Mrmrglmr quiere que regreses al Refugio Aleta Invernal con la cabeza de Glrggl.‡Mrmrglmr quiere que regreses al Refugio Aleta Invernal con la cabeza de Glrggl.‡Mrmrglmr vous demande de revenir le voir à la Retraite des Ailerons-d\'hiver avec la Tête de Glrggl.‡冬鳍避难所的姆姆咕咕要你将咕拉咕拉的徽记带回来给他。‡姆姆戈莫要你帶著吉爾戈的頭顱回到冬鰭避居地給他。',
  }
},
[11564] = {
  {
    'Ensopado Suculento de Orca‡Наваристая похлебка из косатки‡Saftiger Orcaeintopf‡육즙이 많은 범고래 스튜‡Suculento estofado de orca‡Estofado de orca suculento‡Un ragoût d\'épaulard succulent‡美味炖鲸肉‡多汁的虎鯨燉肉',
    nil,
    'O Cuteleiro Bmurglbrm lhe incumbiu de adquirir 7 Gorduras Suculentas de Orca. Leve-as para ele no Retiro da Falésia Invernal.‡По поручению Колуна Бмурглбрма добудьте и принесите 7 кусков мясистого сальника косатки. С мясом возвращайтесь к нему в Приют Зимних Плавников.‡Hackebeil Bmurglbrm hat Euch damit beauftragt, 7 Einheiten saftigen Orcatran zu beschaffen. Bringt sie anschließend zu ihm in die Zuflucht der Winterflossen.‡학살자 브무르글브름이 육즙이 많은 범고래 지방덩어리 7개를 구해달라고 했습니다. 다 모으면 겨울지느러미 은신처에 있는 그에게 가야 합니다.‡El acuchillador Bmurglbrm te ha encargado 7 piezas de grasa de orca suculenta. Llévaselas al Refugio Aleta Invernal.‡El acuchillador Bmurglbrm te ha encargado 7 piezas de grasa de orca suculenta. Llévaselas al Refugio Aleta Invernal.‡Le Fendeur Bmurglbrm vous a demandé de récupérer 7 Succulentes graisses d\'épaulard. Retournez ensuite le voir à la Retraite des Ailerons-d\'hiver.‡北风苔原冬鳍避难所的屠夫布咕布噜要你去收集7块肥美的逆戟鲸脂肪。‡斬擊者布墨格伯姆要你收集7個多汁虎鯨脂。回到北風凍原的冬鰭避居地向他回報。',
  }
},
[11565] = {
  {
    'O outro traje‡Запасной комплект‡Das Ersatzkostüm‡여벌 위장복‡El traje de muda‡El traje de muda‡Le costume de rechange‡备用的鱼人服‡備用服裝',
    nil,
    'Leve o Outro Traje do Rei Mrgl-Mrgl para ele, no Retiro da Falésia Invernal.‡Верните запасной костюм короля Мргла-Мргла королю Мрглу-Мрглу в Приют Зимних Плавников.‡Bringt König Mrgl-Mrgls Ersatzkostüm zu ihm zurück. Er befindet sich in der Zuflucht der Winterflossen.‡멀록왕 아옳아옳의 여벌 위장복을 겨울지느러미 은신처에 있는 멀록왕 아옳아옳에게 돌려줘야 합니다.‡Devuélvele al rey Mrgl-Mrgl su traje de muda. Lo encontrarás en el Refugio Aleta Invernal.‡Devuélvele al rey Mrgl-Mrgl su traje de muda. Lo encontrarás en el Refugio Aleta Invernal.‡Rapportez son Costume de rechange au Roi Mrgl-Mrgl à la Retraite des Ailerons-d\'hiver.‡返回冬鳍避难所，将国王姆嘎姆嘎的备用鱼人服交给他。‡把莫戈莫戈大王的備用服裝帶到冬鰭避居地給他。',
  }
},
[11566] = {
  {
    'Render-se... Jamais!‡Сдаться? Ни за что!‡Ergebt Euch... nicht!‡항복... 은 없다!‡¡De rendirse... nada!‡¡De rendirse... nada!‡Reddition... ou pas !‡决不投降！‡永不...屈服!',
    nil,
    'O Rei Mrgl-Mrgl, no Retiro da Falésia Invernal, pediu que você lhe traga a Garra de Claximus.‡Принесите коготь Клаксимуса королю Мргл-Мргл в Приюте Зимних Плавников.‡König Mrgl-Mrgl in der Zuflucht der Winterflossen möchte, dass Ihr ihm die Klaue von Claximus bringt.‡겨울지느러미 은신처에 있는 멀록왕 아옳아옳이 클랙시무스의 집게발을 가져다 달라고 했습니다.‡El rey Mrgl-Mrgl en el Refugio Aleta Invernal te ha pedido que le traigas una garra de Claximus.‡El rey Mrgl-Mrgl en el Refugio Aleta Invernal te ha pedido que le traigas una garra de Claximus.‡Le Roi Mrgl-Mrgl, de la Retraite des Ailerons-d’hiver, vous a demandé de lui rapporter une Pince de Claximus.‡冬鳍避难所的国王姆嘎姆嘎要你将克拉西姆斯的钳子带回来给他。‡冬鰭避居地的莫戈莫戈大王要你帶一個克拉希穆司之爪給他。',
  }
},
[11567] = {
  {
    'A antiga armadura dos kvaldir‡Древняя броня Квалдира‡Die uralte Rüstung der Kvaldir‡크발디르의 고대 갑옷‡La antigua armadura de los Kvaldir‡La antigua armadura de los Kvaldir‡L\'antique armure des kvaldirs‡克瓦迪尔上古甲胄‡科瓦迪爾的上古盔甲',
    nil,
    'Recupere a Antiga Armadura dos Kvaldir e entregue-a para Orfus de Kamagua, no Fiorde Uivante.‡Найдите древнюю броню Квалдира и отнесите ее Орфусу Камагуанскому в Ревущий фьорд.‡Bergt die uralte Rüstung der Kvaldir und bringt sie zu Orfus von Kamagua im Heulenden Fjord.‡크발디르의 고대 갑옷을 되찾은 다음 울부짖는 협만의 방패 언덕에 있는 카마구아의 오르푸스에게 전달해야 합니다.‡Recupera la antigua armadura de los Kvaldir y entrégasela a Orfus de Komawa en el Fiordo Aquilonal.‡Recupera la antigua armadura de los Kvaldir y entrégasela a Orfus de Komawa en el Fiordo Aquilonal.‡Récupérez l\'Antique armure des kvaldirs et apportez-la à Orfus de Kamagua dans le Fjord Hurlant.‡找回克瓦迪尔上古甲胄，把它交给嚎风峡湾卡玛古的奥弗斯。‡找到科瓦迪爾的上古盔甲，然後把它交給凜風峽灣的卡瑪廓的歐弗斯。',
  }
},
[11568] = {
  {
    'De volta ao repouso eterno‡Возвращение святынь‡Wieder zur Ruhe kommen lassen‡다시 안식으로‡Volver a descansar en paz‡Volver a descansar en paz‡Le retour à la terre‡安息‡歸於平靜',
    nil,
    'Use o Bornal de Artefatos Vraikalen nos túmulos saqueados do Monte Égide para devolver o Coração Congelado de Isuldof, o Escudo dos Aesiritas, o Cajado da Fúria da Tempestade e a Antiga Armadura dos Kvaldir.|n|nFale novamente com Orfus de Kamagua, no Elevador Ancestral, que fica no Fiorde Uivante, caso você obtenha sucesso.‡Используйте мешок с врайкульскими артефактами на разграбленных курганах Заградительного холма и верните на место Ледяное сердце Исулдофа, Щит Эсиритса, Посох Неистовства Бури и Древнюю броню Квалдира. Когда поручение будет выполнено, вернитесь к Орфусу Камагуанскому на Древний подъемник.‡Verwendet das Bündel mit Vrykulartefakten bei den geplünderten Grabhügeln des Schildhügels und legt das gefrorene Herz Isuldofs, den Schild der Aesiriten, den Stab des Sturmfurors und die uralte Rüstung der Kvaldir wieder zurück.|n|nKehrt zu Orfus von Kamagua am Uralten Aufzug zurück, falls Ihr erfolgreich sein solltet.‡방패 언덕의 파헤쳐진 무덤에서 브리쿨 유물 보따리를 사용해 이술도프의 얼어붙은 심장, 애시리테스의 방패, 폭풍 강타 지팡이와 크발디르의 고대 갑옷을 돌려놓아야 합니다.|n|n임무를 마치면 고대 승강장에 있는 카마구아의 오르푸스에게 돌아가십시오.‡Usa el fardo de artefactos vrykul en los túmulos funerarios de Colina Escudo para devolver el corazón congelado de Isuldof, el escudo de los Aesirites, el bastón de la Furia de la Tormenta y la antigua armadura de los Kvaldir.|n|nVuelve con Orfus de Komawa en El Antiguo Elevador si lo consigues.‡Usa el fardo de artefactos vrykul en los túmulos funerarios de Colina Escudo para devolver el corazón congelado de Isuldof, el escudo de los Aesirites, el bastón de la Furia de la Tormenta y la antigua armadura de los Kvaldir.|n|nVuelve con Orfus de Komawa en El Antiguo Elevador si lo consigues.‡Utilisez le Paquet d\'artéfacts vrykuls aux tertres funéraires mis à sac de la Colline du Bouclier pour restituer le Cœur gelé d\'Isuldof, le Bouclier des Asirites, le Bâton de la fureur de l\'orage et l\'Antique armure des kvaldirs.|n|nRetournez voir Orfus de Kamagua à l\'Antique élévateur, si vous réussissez.‡在盾牌岭那些被掠夺过的墓穴处使用维库圣物，将伊斯多弗的冰冷之心、古神之盾、风暴愤怒法杖和克瓦迪尔上古甲胄放回它们原本的位置。|n|n完成任务之后回到上古升降梯，向卡玛古的奥弗斯复命。‡在盾丘被洗劫的墓塚使用一包維酷神器，歸還伊蘇鐸夫的冰凍心臟、阿薩瑞特之盾、風暴之怒法杖和科瓦迪爾的上古盔甲。|n|n完成後回到遠古升降梯找卡瑪廓的歐弗斯。',
  }
},
[11569] = {
  {
    'Guardião da chave Urmgrgl‡Хранитель ключей Ургргрл‡Schlüsselmeister Urmgrgl‡열쇠지기 우름그르글‡El maestro de llaves Urmgrgl‡El maestro de llaves Urmgrgl‡Le maître des clés Urmgrgl‡钥匙管理者呜啦咕噜‡鑰匙大師俄姆戈苟',
    nil,
    'Glrglrglr, dentro da Caverna Falésia Invernal, pediu para que você recupere a Chave do Urmgrgl.‡По просьбе Глрглрглра в пещерах Зимних Плавников раздобудьте ключ Ургргрла.‡Glrglrglr in den Höhlen der Winterflossen möchte, dass Ihr Urmgrgls Schlüssel beschafft.‡겨울지느러미 동굴에 있는 글르글르글르가 우름그르글의 열쇠를 찾아와 달라고 했습니다.‡Glrglrglr en el interior de las Cavernas Aleta Invernal te ha pedido que consigas la llave de Urmgrgl.‡Glrglrglr en el interior de las Cavernas Aleta Invernal te ha pedido que consigas la llave de Urmgrgl.‡Glrglrglr vous a demandé de récupérer la Clé d’Urmgrgl. Lorsque ce sera fait, retournez le voir dans les Cavernes des Ailerons-d’hiver.‡冬鳍洞穴的咕啦咕啦要你夺回呜啦咕噜的钥匙。‡冬鰭洞窟的葛勒格勒格勒要你拿到俄姆戈苟之鑰。',
  }
},
[11570] = {
  {
    'Fuga da caverna Falésia Invernal‡Бегство из пещер Зимних Плавников‡Flucht aus den Höhlen der Winterflossen‡겨울지느러미 동굴에서 탈출‡Escapa de las Cavernas Aleta Invernal‡Escapa de las Cavernas Aleta Invernal‡L\'évasion des cavernes des Ailerons-d\'hiver‡逃离冬鳍洞穴‡逃離冬鰭洞窟',
    nil,
    'Escolte Lurgglbr e conte as boas novas ao Rei Mrgl-Mrgl no Retiro da Falésia Invernal.‡Проводите Лургглбра в безопасное место и вернитесь к королю Мргл-Мрглу в Приют Зимних Плавников, чтобы сообщить ему хорошую новость.‡Eskortiert Lurgglbr, bis er in Sicherheit ist, und überbringt anschließend König Mrgl-Mrgl in der Zuflucht der Winterflossen die guten Neuigkeiten.‡루르글브르를 안전한 곳까지 호위한 다음 겨울지느러미 은신처에 있는 멀록왕 아옳아옳에게 보고해야 합니다.‡Escolta a Lurgglbr hasta un lugar seguro y después dale la buena noticia al rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Escolta a Lurgglbr hasta un lugar seguro y después dale la buena noticia al rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Escorter Lurgglbr jusqu’à ce qu\'il soit en sécurité, puis aller annoncer la bonne nouvelle au Roi Mrgl-Mrgl à la Retraite des Ailerons-d\'hiver.‡护送噜呱吧呱抵达安全区域，然后返回冬鳍避难所，向国王姆嘎姆嘎汇报这一好消息。‡平安地將魯格伯護送回去，然後向冬鰭避居地的莫戈莫戈大王回報這個好消息。',
  }
},
[11571] = {
  {
    'Aprendendo a se comunicar‡Обучение коммуникации‡Lernen, wie man kommuniziert‡의사소통법 익히기‡Aprendiendo a comunicarse‡Aprender a comunicarse‡Apprendre à communiquer‡学习沟通‡學習溝通',
    nil,
    'O Rei Mrgl-Mrgl lhe deu uma concha para usar nos restos de Escaldora. Leve A Concha Cheia do Rei para ele no Retiro da Falésia Invernal.‡Наполните ракушку, которую дал вам король Мргл-Мргл, над останками Скольдер. Верните наполненную ракушку короля Мрглу-Мрглу в Приют Зимних Плавников.‡König Mrgl-Mrgl hat Euch eine Muschel gegeben, die Ihr bei Verbrühers Überresten benutzen sollt. Kehrt mit der gefüllten Muschel des Königs zu ihm zurück. Er befindet sich in der Zuflucht der Winterflossen.‡스칼더의 시체에 빈 조가비를 사용하여 왕의 가득 찬 조가비로 만든 다음, 겨울지느러미 은신처에 있는 멀록왕 아옳아옳에게 가져가야 합니다.‡El rey Mrgl-Mrgl te ha dado una caracola para que la uses sobre los restos de Escaldadora. Devuélvele la caracola del Rey llena en el Refugio Aleta Invernal.‡El rey Mrgl-Mrgl te ha dado una caracola para que la uses sobre los restos de Escaldadora. Devuélvele la caracola del Rey llena en el Refugio Aleta Invernal.‡Le Roi Mrgl-Mrgl vous a donné une conque à utiliser sur les restes de Brûle-gueule. Rapportez-lui la Conque du roi remplie à la Retraite des Ailerons-d\'hiver.‡冬鳍避难所的国王姆嘎姆嘎要你对斯卡德尔的尸体使用空贝壳，然后将国王的充盈贝壳交给他。‡莫戈莫戈大王給你一個海螺要你對史卡德的屍體使用。之後回到冬鰭避居地把國王的盛滿海螺交給他。',
  }
},
[11572] = {
  {
    'Volte a Atuik‡Возвращение к Атуику‡Rückkehr zu Atuik‡아투이크에게 돌아가기‡Regresa junto a Atuik‡Regresa junto a Atuik‡Retourner voir Atuik‡返回阿图伊克身边‡回去找阿推克',
    nil,
    'Conte as más notícias para o Ancião Atuik em Kamagua.‡Доставьте тревожные известия старейшине Атуику в Камагуа.‡Überbringt Urahn Atuik in Kamagua die schlechten Nachrichten.‡나쁜 소식을 카마구아의 장로 아투이크에게 전해야 합니다.‡Dale las malas noticias al ancestro Atuik en Komawa.‡Dale las malas noticias al ancestro Atuik en Komawa.‡Transmettez les mauvaises nouvelles à l’Ancien Atuik à Kamagua.‡将坏消息传达给卡玛古的长者阿图伊克。‡把壞消息告訴在卡瑪廓的長者阿推克。',
  }
},
[11573] = {
  {
    'Orfus de Kamagua‡Орфус Камагуанский‡Orfus der Kamagua‡카마구아의 오르푸스‡Orfus de Komawa‡Orfus de Komawa‡Orfus de Kamagua‡卡玛古的奥弗斯‡卡瑪廓的歐弗斯',
    nil,
    'Encontre Orfus de Kamagua no Elevador Ancestral, no Fiorde Uivante.‡Найдите Орфуса Камагуанского на Древнем подъемнике в Ревущем фьорде.‡Sucht am Uralten Aufzug im Heulenden Fjord nach Orfus von Kamagua.‡울부짖는 협만에 있는 고대 승강장에서 카마구아의 오르푸스를 찾아야 합니다.‡Encuentra a Orfus de Komawa en El Antiguo Elevador de Fiordo Aquilonal.‡Encuentra a Orfus de Komawa en El Antiguo Elevador de Fiordo Aquilonal.‡Trouvez Orfus de Kamagua à l\'Antique élévateur dans le Fjord Hurlant.‡前往嚎风峡湾的上古升降梯，寻找卡玛古的奥弗斯。‡去凜風峽灣的遠古升降梯尋找卡瑪廓的歐弗斯。',
  }
},
[11574] = {
  {
    'Intimidade é uma...‡Переживания на грани‡Zu knapp für meinen Geschmack‡가까이 있기엔 너무 불편한‡Por los pelos‡Por los pelos‡Un peu trop près à mon goût…‡危在旦夕‡千鈞一髮',
    nil,
    'Endorah quer que você vá ao Promontório Âmbar, a norte da Fortaleza Brado Guerreiro, e agradeça aos que a resgataram.‡По просьбе Эндоры отправляйтесь на Янтарную Гряду к северу от Крепости Песни Войны и поблагодарите местных обитателей за ее спасение.‡Endorah möchte, dass Ihr Euch auf das Bernsteinflöz nördlich der Kriegshymnenfeste begebt und ihren Rettern ihren Dank aussprecht.‡엔도라가 전쟁노래 요새의 북쪽에 있는 호박석 절벽으로 가서 그곳에 있는 사람들에게 구조해줘서 고맙다는 말을 전해달라고 했습니다.‡Endorah quiere que vayas a El Saliente Ámbar al noroeste del Bastión Grito de Guerra y les des las gracias a los magos por haberla rescatado.‡Endorah quiere que vayas a El Saliente Ámbar al noroeste del Bastión Grito de Guerra y les des las gracias a los magos por haberla rescatado.‡Endorah veut que vous alliez à l’Escarpement d’Ambre au nord du Bastion Chanteguerre, et que vous remerciiez ceux qui l’ont sauvée.‡恩多拉要你到战歌要塞北方的琥珀崖去找到她的救命恩人，并转达她的谢意。‡伊朵菈要你去戰歌堡北邊的琥珀岩臺，感謝那些拯救她的人。',
  }
},
[11575] = {
  {
    'Na hora H‡Своевременное спасение‡Gerade noch rechtzeitig‡위기 일발‡Justo a tiempo‡Justo a tiempo‡Juste à temps‡千钧一发‡關鍵時刻',
    nil,
    'Ana, na Bastilha Valentia, quer que você vá para o Promontório Âmbar, ao norte, e agradeça aos que a salvaram.‡По просьбе Мушки из Крепости Отваги отправляйтесь на Янтарную гряду к северу и поблагодарите местных обитателей за ее спасение.‡Mücke in der Valianzfeste möchte, dass Ihr Euch auf das Bernsteinflöz im Norden begebt und ihren Rettern ihren Dank aussprecht.‡용맹의 성채에 있는 미지가 북쪽의 호박석 절벽으로 가서 거기 사람들에게 구조에 대한 감사의 말을 전해달라고 했습니다.‡Menudencia de la Fortaleza Denuedo quiere que vayas hasta El Saliente Ámbar al norte y des las gracias a quienes la rescataron.‡Menudencia de la Fortaleza Denuedo quiere que vayas hasta El Saliente Ámbar al norte y des las gracias a quienes la rescataron.‡Moucheronne, au Donjon de la Bravoure, veut que vous alliez à l’Escarpement d’Ambre au nord, et que vous remerciiez ceux qui l’ont sauvée.‡无畏要塞的米吉要你到北方的琥珀崖去找到她的救命恩人，并转达她的谢意。‡驍勇要塞的米吉要你前往北方的琥珀岩臺感謝那些拯救她的人。',
  }
},
[11576] = {
  {
    'Monitoramento da fissura: anomalia no Rochedo Rachado‡Наблюдения за расселиной: обнаружена аномалия‡Die Klamm beobachten: Spaltkliffanomalie‡균열 조사: 벼랑 변형 지형‡Observar la falla: anomalía del Acantilado Agrietado‡Observar la falla: anomalía del Acantilado Agrietado‡Surveiller la faille : l\'anomalie de la falaise fendue‡监视裂谷：悬崖异常‡監控裂口:異常裂壁',
    nil,
    'Garren, no Promontório Âmbar, quer que você use o Arcanômetro na Anomalia do Rochedo Rachado.‡По просьбе Гаррена с Янтарной гряды воспользуйтесь тайнометром у аномалии утеса Западной расселины.‡Garren vom Bernsteinflöz möchte, dass Ihr das Arkanometer bei der Spaltkliffanomalie benutzt.‡호박석 절벽의 가렌이 벼랑 변형 지형에서 비전력 측정기를 사용해 달라고 했습니다.‡Garren de El Saliente Ámbar quiere que utilices el arcanómetro en la anomalía del Acantilado Agrietado.‡Garren de El Saliente Ámbar quiere que utilices el arcanómetro en la anomalía del Acantilado Agrietado.‡Garren, de l\'Escarpement d\'Ambre, vous demande d\'utiliser l\'Arcanomètre à l\'Anomalie de la falaise fendue.‡琥珀崖的盖伦要你在悬崖异常处使用奥术测量器。‡琥珀岩臺的加倫要你在異常裂壁使用奧能檢測儀。',
  }
},
[11577] = {
  {
    '‡Коллекционное издание WoW: – DEM – E – FLAG‡‡소장판‡‡‡‡‡',
    nil,
    nil,
  }
},
[11578] = {
  {
    'The "Chow" Quest (123)aa COPY‡The "Chow" Quest (123)aa COPY‡Die "Fress"-Quest (123)aa‡The "Chow" Quest (123)aa COPY‡La misión "Chow" (123)aa COPIA‡La misión "Chow" (123)aa COPIA‡La quête « Chow » (123)aa‡The "Chow" Quest (123)aa COPY‡The "Chow" Quest (123)aa COPY',
    nil,
    'Kill Kobold Vermin, 2 of em.‡Убей пару кобольдов-вредителей.‡Tötet Koboldgezücht - und zwar 2 davon.‡Kill Kobold Vermin, 2 of em.‡Matar alimaña kóbold, dos.‡Matar alimaña kóbold, dos.‡Tuez au moins deux Vermines kobolds.‡Kill Kobold Vermin, 2 of em.‡殺死兩個狗頭人惡黨。',
  }
},
[11579] = {
  {
    'The "Chow" Quest (123)aa COPY‡The "Chow" Quest (123)aa COPY‡Die "Fress"-Quest (123)aa‡The "Chow" Quest (123)‡La misión "Chow" (123)aa COPIA‡La misión "Chow" (123)aa COPIA‡La quête « Chow » (123)aa COPIE‡The "Chow" Quest (123)aa COPY‡「狗頭人」任務(123)aa COPY',
    nil,
    'Kill Kobold Vermin, 2 of em.‡Убей пару кобольдов-вредителей.‡Tötet Koboldgezücht, und zwar 2 davon.‡Kill Kobold Vermin, 2 of em.‡Matar alimaña kóbold, dos.‡Matar alimaña kóbold, dos.‡Tuez au moins deux Vermines kobolds.‡杀死两个狗头人歹徒。‡殺死兩個狗頭人惡黨。',
  }
},
[11580] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡¡Profana este fuego!‡Désacralisez ce feu !‡亵渎这团火焰！‡褻瀆這些火焰!',
    nil,
    nil,
  }
},
[11581] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡¡Profana este fuego!‡Désacralisez ce feu !‡亵渎这团火焰！‡褻瀆這些火焰!',
