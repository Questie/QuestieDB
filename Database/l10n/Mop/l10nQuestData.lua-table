    nil,
  }
},
[27821] = {
  {
    'Orcs e humanos‡Орки и люди‡Orcs und Menschen‡오크와 인간‡Orcos y humanos‡Orcos y humanos‡Orcs et humains‡兽人与人类‡獸人與人類',
    nil,
    'Mate 8 Guerreiros do Pedregal.‡Убейте 8 воинов Каменора.‡Tötet 8 Krieger von Steinard.‡스토나드 전사 8명을 처치해야 합니다.‡Mata a 8 guerreros de Rocal.‡Mata a 8 guerreros de Rocal.‡Tuez 8 Guerriers de Pierrêche.‡杀死8名斯通纳德战士。‡消滅8個斯通納德戰士。',
  }
},
[27822] = {
  {
    'Parvos desorientados‡Лес рубят – щепки летят‡Trampel‡미련퉁이‡Patanes inútiles‡Patanes inútiles‡Encore du travail ?‡伐木场巨怪‡笨重的蠢蛋',
    nil,
    'Mate 5 Peões do Pedregal.‡Убейте 5 батраков Каменора.‡Tötet 5 Steinardpeons.‡스토나드 일꾼 5명을 처치해야 합니다.‡Mata a 5 peones de Rocal.‡Mata a 5 peones de Rocal.‡Tuez 5 Péons de Pierrêche.‡杀死5个斯通纳德苦工。‡消滅5個斯通納德苦工。',
  }
},
[27823] = {
  {
    'Um anão tem lá suas necessidades‡У дворфов – свои нужды‡Auch ein Zwerg hat Bedürfnisse‡목마른 드워프‡Un enano tiene necesidades‡Un enano tiene necesidades‡Un nain a des besoins‡矮人的需求‡矮人的需求',
    nil,
    'Obtenha 15 canecas de Sombrabier.‡Раздобудьте 15 кружек "Сумеречного крепкого".‡Besorgt 15 Krüge Schattenbräu.‡그림자스타우트 맥주 15개를 획득해야 합니다.‡Consigue 15 jarras de Cebasombras.‡Consigue 15 jarras de Cebasombras.‡Obtenez 15 Bocks de brune ombrée.‡取回15杯暗影烈酒。‡取得15杯暗影烈酒。',
  }
},
[27824] = {
  {
    'O melhor da festa‡За сокровищем – с кулаками‡Das gute Zeug‡값진 물건‡Buena mercancía‡Buena mercancía‡Du beau matériel‡好东西‡好東西',
    nil,
    'Procure o tesouro no andar inferior da Fortaleza Angor.‡Поищите сокровище на нижнем уровне крепости Ангор.‡Sucht im untersten Stockwerk der Festung Angor nach Schätzen.‡고통의 요새 지하에서 티탄의 보물을 찾아야 합니다.‡Busca el tesoro en la planta baja de la Fortaleza de Angor.‡Busca el tesoro en la planta baja de la Fortaleza de Angor.‡Cherchez les trésors au dernier sous-sol de la Forteresse d\'Angor.‡在苦痛堡垒的底楼搜寻财宝。‡在苦痛堡壘的底層找尋寶藏。',
  }
},
[27825] = {
  {
    'Política da boa vizinhança‡Выживает жирнейший‡Überleben der Dicksten‡뚱보들의 생존 방법‡El más gordo sobrevive‡El más gordo sobrevive‡La survie du plus gros‡劫胖济贫‡肥者生存',
    nil,
    'Obtenha 6 pedaços de Carne dos Arrota-pó e 10 cortes de Seda dos Arrota-pó.‡Добудьте 6 порций мясного провианта и 10 отрезов шелка клана Гнилобрюхих.‡Erlangt 6 Fleischstücke der Staubspeier und 10 Lagen Seide der Staubspeier.‡먼지목도리 고기 6개와 먼지목도리 비단 10개를 획득해야 합니다.‡Consigue 6 trozos de carne Rotapolvo y 10 sábanas de seda Rotapolvo.‡Consigue 6 trozos de carne Rotapolvo y 10 sábanas de seda Rotapolvo.‡Obtenez 6 Morceaux de viande de Crache-poussières et 10 Draps de soie crache-poussière.‡收集6块火烟之肉和10张火烟丝绸。‡取得6份火煙肉和10份火煙絲綢。',
  }
},
[27826] = {
  {
    'Boca do Dragão adentro‡Дорога в Драконью Пасть‡In den Drachenschlund‡용의 입으로‡En la boca del dragón‡En la boca del dragón‡Dans la Gueule du dragon‡前往巨龙峡口‡進入龍之口',
    nil,
    'Leve o Ovo de Dragão Negro Purificado para Rhea na Boca do Dragão, que fica nos Ermos.‡Отнесите очищенное от скверны яйцо черного дракона Рее в Драконью Пасть, что в Бесплодных землях.‡Bringt das geläuterte Schwarzdrachenei zu Rhea in Drachenschlund im Ödland zurück.‡황야의 땅, 용의 입에 있는 레아에게 정화된 검은용 알을 가져가야 합니다.‡Llévale el huevo de dragón Negro purificado a Rhea a Boca del Dragón, en las Tierras Inhóspitas.‡Llévale el huevo de dragón Negro purificado a Rhea a Boca del Dragón, en las Tierras Inhóspitas.‡Apportez l\'Œuf purifié de dragon noir à Rhea à la Gueule du dragon, dans les Terres Ingrates.‡将净化过的黑龙卵交给荒芜之地巨龙峡口的瑞亚。‡將淨化過的黑龍蛋帶去荒蕪之地的龍之口給莉雅。',
  }
},
[27827] = {
  {
    'O veloz, o feroz e o grandalhão‡Резвый, Лютый и Крепкий‡Der Flinke, der Starke und der Schreckliche‡날쌘돌이, 험악꾼, 뚱뚱보‡El veloz, el fiero y el robusto‡El veloz, el fiero y el robusto‡L\'agile, le féroce et le costaud‡三位矮人‡迅捷、兇猛、健壯',
    nil,
    'Fale com Eric, o Veloz, na Boca do Dragão, que fica nos Ermos.‡Поговорите с Эриком "Резвым" в Драконьей Пасти, что в Бесплодных землях.‡Sprecht mit Eric "Dem Flinken" beim Drachenschlund im Ödland.‡황야의 땅에 있는 용의 입에서 "날쌘돌이" 에릭과 대화해야 합니다.‡Habla con Eric "El Veloz" en Boca del Dragón, en las Tierras Inhóspitas.‡Habla con Eric "El Veloz" en Boca del Dragón, en las Tierras Inhóspitas.‡Parlez avec Eric « l\'Agile » à la Gueule du dragon, dans les Terres Ingrates.‡跟荒芜之地巨龙峡口的埃瑞克谈一谈。‡在荒蕪之地的龍之口同『迅捷』艾利克談話。',
  }
},
[27828] = {
  {
    'Eric, o anão de utilidades‡Эрик, капитан Необходимость‡Eric, der nützliche Zwerg‡만능 드워프 에릭‡Eric, el enano mañoso‡Eric, el enano mañoso‡Eric, le nain agile‡全能的埃瑞克‡艾利克，有用的矮人',
    nil,
    'Use a Investida do Eric e a Poção de Bolso do Eric.‡Испытайте "Рывок Эрика" и карманное зелье Эрика.‡Benutzt \'Erics Sturmangriff\' und \'Erics Taschentrank\'.‡에릭의 돌진과 주머니 물약을 사용해야 합니다.‡Usa la Carga de Eric y la poción de bolsillo de Eric.‡Usa la Carga de Eric y la poción de bolsillo de Eric.‡Utilisez la Charge d\'Eric et la Potion de poche d\'Eric.‡使用埃瑞克的冲锋和埃瑞克的随身药水。‡使用艾力克的衝鋒和艾力克的口袋藥水。',
  }
},
[27829] = {
  {
    'A ira de uma Revoada‡Поход на дракона‡Der Zorn eines Drachenschwarms‡용군단의 분노‡La ira del Vuelo‡La ira del Vuelo‡La fureur du vol‡龙群之怒‡龍群之怒',
    nil,
    'Mate Kalaran, o Aniquilador, e 4 Soldados Velonero.‡Одолейте Каларана Уничтожителя и четверых солдат Летящей Тьмы.‡Tötet Kalaran den Vernichter und 4 Soldaten des dunklen Schwarms.‡파멸자 칼라란과 암흑군단 병사 4마리를 처치해야 합니다.‡Mata a Kalaran el Aniquilador y a 4 soldados Huida oscura.‡Mata a Kalaran el Aniquilador y a 4 soldados Huida oscura.‡Tuez Kalaran l\'Annihilateur et 4 Soldats sombrevol.‡杀死歼灭者卡拉然和4个暗翔士兵。‡殺死『殲滅者』卡拉然和4名暗翔士兵。',
  }
},
[27830] = {
  {
    'A caçada continua‡Охота продолжается!‡Die Jagd geht weiter‡끈질긴 추적‡Su caza continúa‡Su caza continúa‡Leur traque continue‡永无止尽的搜寻‡繼續狩獵',
    nil,
    'Vença o General Jirakka, Moldarr e 6 Dragomorfos da Revoada Negra.‡Победите генерала Жиракку, Молдарра и 6 черных драконоидов.‡Besiegt General Jirakka, Moldarr und 6 Mitglieder der Drachenbrut des dunklen Schwarms.‡장군 지라카, 몰다르, 암흑군단 화염칼날 6마리를 처치해야 합니다.‡Derrota al general Jirakka, a Moldarr y a 6 dragauros de la Huida oscura.‡Derrota al general Jirakka, a Moldarr y a 6 dragauros de la Huida oscura.‡Terrassez le Général Jirakka, Moldarr et 6 Draconides noirs.‡击败基拉卡将军、莫达尔以及6只黑龙。‡擊敗基拉卡將軍、摩達爾和6名暗翔龍人。',
  }
},
[27831] = {
  {
    'A tristeza e a fúria‡Печаль и гнев‡Das Leid und der Zorn‡슬픔과 분노‡La pena y la ira‡La pena y la ira‡Le chagrin et la fureur‡悲痛与愤怒‡悲傷與狂怒',
    nil,
    'Mate Nyxondra e 12 Filhotes de Nyxondra.‡Убейте Никсондру и 12 ее детенышей.‡Erschlagt Nyxondra und 12 von Nyxondras Brutlingen.‡닉손드라와 닉손드라의 새끼용 12마리를 처치해야 합니다.‡Mata a Nyxondra y a 12 estirpes de Nyxondra.‡Mata a Nyxondra y a 12 estirpes de Nyxondra.‡Tuez Nyxondra et 12 Rejetons de Nyxondra.‡杀死尼希昂卓拉和12条尼希昂卓拉雏龙。‡殺死妮克松德拉和12條妮克松德拉小龍。',
  }
},
[27832] = {
  {
    'O ninho escondido‡Потайная кладка‡Das Versteckte Gelege‡숨겨진 손아귀‡La Guarida Oculta‡La Guarida Oculta‡La Couvée cachée‡隐藏的龙巢‡隱秘窩巢',
    nil,
    'Fale com Rhea no Ninho Escondido, que fica nos Ermos.‡Поговорите с Реей у Потайной кладки в Бесплодных землях.‡Sprecht mit Rhea im Versteckten Gelege im Ödland.‡황야의 땅, 숨겨진 손아귀에 있는 레아와 대화해야 합니다.‡Habla con Rhea en la Guarida Oculta, en las Tierras Inhóspitas.‡Habla con Rhea en la Guarida Oculta, en las Tierras Inhóspitas.‡Parlez avec Rhea à la Couvée cachée dans les Terres Ingrates.‡与荒芜之地隐藏的龙巢的瑞亚交谈。‡到荒蕪之地的隱秘窩巢和莉雅談話。',
  }
},
[27833] = {
  {
    'Problemas de meia tonelada‡Затяжная оборона‡Tonnenschwere Starrköpfe‡뚱보 저항군‡Resistentes de media tonelada‡Resistentes de media tonelada‡Reclus d\'une demi-tonne‡顽固的肥佬‡半噸的伏兵',
    nil,
    'Mate 12 Combatentes Arrota-pó. Você pode matar Espancadores Arrota-pó ou Xamãs Arrota-pó.‡Уничтожьте 12 бойцов клана Гнилобрюхих. Можно убивать как извергов, так и шаманов этого клана.‡Tötet 12 Kämpfer der Staubspeier. Ihr könnt Raufer oder Schamanen der Staubspeier töten.‡먼지목도리 싸움꾼 또는 먼지목도리 주술사 12마리를 처치해야 합니다.‡Mata a 12 combatientes Rotapolvo. Puedes matar a aplastadores Rotapolvo o a chamanes Rotapolvo.‡Mata a 12 combatientes Rotapolvo. Puedes matar a aplastadores Rotapolvo o a chamanes Rotapolvo.‡Tuez 12 Combattants crache-poussières. Vous pouvez tuer des Marteleurs ou des Chamans crache-poussières.‡杀死12名火烟食人魔，火烟虐待者或是火烟萨满祭司都可以。‡殺死12名火煙部族的戰鬥人員。你可以殺死火煙虐待者或火煙薩滿。',
  }
},
[27834] = {
  {
    'Baelog, o canhão de vidro‡Бейлог, капитан Стеклянная Пушка‡Baelog, die Glaskanone‡유리대포 밸로그‡Baelog, el cañón de cristal‡Baelog, el cañón de cristal‡Baelog, féroce mais fragile‡玻璃弓箭手巴尔洛戈‡巴爾洛戈，玻璃大砲',
    nil,
    'Use o Tiro de Valhalla do Baelog e o Grito de Guerra do Baelog.‡Испытайте выстрел Бейлога и боевой крик Бейлога.‡Benutzt \'Baelogs Valhallaschuss\' und \'Baelogs Kriegsschrei\'.‡밸로그의 발할라 사격과 밸로그의 함성을 사용해야 합니다.‡Usa el Disparo del Valhalla de Baelog y el Alarido de guerra de Baelog.‡Usa el Disparo del Valhalla de Baelog y el Alarido de guerra de Baelog.‡Utilisez le Tir du Valhalla de Baelog et le Cri de guerre de Baelog.‡使用巴尔洛戈的英灵神殿射击和巴尔洛戈的战吼。‡使用巴爾洛戈的瓦哈拉射擊和巴爾洛戈的戰嚎。',
  }
},
[27835] = {
  {
    'Olaf, o grandalhão‡Олаф, капитан Громадина‡Olaf, der dicke Brocken‡거구 올라프‡Olaf, el grande‡Olaf, el grande‡Olaf, le costaud‡大胖子奥拉夫‡奧拉夫，大塊頭',
    nil,
    'Use a Muralha de Proteção do Olaf e o Brado Potente do Olaf.‡Испытайте "Глухую защиту Олафа" и могучий рев Олафа.‡Benutzt \'Olafs Schildwall\' und \'Olafs mächtigen Ruf\'.‡올라프의 방패의 벽과 올라프의 강인한 외침을 사용해야 합니다.‡Usa el Muro de escudo de Olaf y el Grito poderoso de Olaf.‡Usa el Muro de escudo de Olaf y el Grito poderoso de Olaf.‡Utilisez le Pavois d\'Olaf et le Cri de puissance d\'Olaf.‡使用奥拉夫的盾墙和奥拉夫的无畏咆哮。‡使用奧拉夫的盾牆和奧拉夫的強力怒吼。',
  }
},
[27836] = {
  {
    'Combatendo a proliferação‡Остановить заразу‡Die Ausbreitung eindämmen‡번식 예방‡Deteniendo la propagación‡Deteniendo la propagación‡Stop à la propagation‡阻止扩散‡阻止蔓延',
    nil,
    'Destrua 6 Ovos de Rastejantes.‡Уничтожьте 6 яиц ползуна.‡Zerstört 6 Gleitereier.‡비단뱀 알 6개를 파괴해야 합니다.‡Destruye 6 huevos de deslizador.‡Destruye 6 huevos de deslizador.‡Détruisez 6 Œufs de siffleur.‡摧毁6枚爬蛇卵。‡摧毀6顆滑行蛇卵。',
  }
},
[27837] = {
  {
    'Invasores na água!‡Чужаки в воде‡Ungebetene Besucher im Wasser‡강물의 침입자‡Intrusos en el agua‡Intrusos en el agua‡Des intrus aquatiques‡水中的入侵者‡水中的非法入侵者',
    nil,
    'Mate 8 Rastejantes das Águas Paradas.‡Убейте 8 ползунов Тихой заводи.‡Tötet 8 Stillwassergleiter.‡청정비단뱀 8마리를 처치해야 합니다.‡Asesina a 8 deslizadores aguaserena.‡Asesina a 8 deslizadores aguaserena.‡Tuez 8 Siffleurs eau-plate.‡杀死8条静水爬蛇。‡殺死8隻靜水滑行蛇。',
  }
},
[27838] = {
  {
    'A raiz da corrupção‡Источник заражения‡Die Wurzel des Übels‡부패의 근원‡La raíz de la corrupción‡La raíz de la corrupción‡La corruption à sa source‡堕落的根源‡腐化的根源',
    nil,
    'Vá para a nascente do Rio Vir\'naal, no nordeste, e mate a Madrescama Hevna.‡Отправляйтесь на северо-восток к истоку реки Вир\'наал и уничтожьте Чешуйчатую прародительницу Хевну.‡Geht zur nordöstlichen Quelle des Vir\'naal und tötet Schuppenmutter Hevna.‡비르나알 강의 북동쪽 수원으로 가서 비늘어미 헤브나를 처치해야 합니다.‡Dirígete a la fuente nororiental del río Vir\'naal y asesina a Madrescama Hevna.‡Dirígete a la fuente nororiental del río Vir\'naal y asesina a Madrescama Hevna.‡Allez à la source nord-est de la Vir\'naal et tuez la Mère-des-écailles Hevna.‡到维尔纳尔河东北的源头杀掉鳞蛇之母海文娜。‡到東北方維爾納爾河的源頭，並殺死鱗母海弗娜。',
  }
},
[27839] = {
  {
    'Armas antigas‡Древнее оружие‡Uralte Waffen‡고대의 무기‡Armas antiguas‡Armas antiguas‡Des armes anciennes‡远古武器‡上古武器',
    nil,
    'Recupere os Armamentos Antigos de Tol\'vir.‡Верните древнее оружие Тол\'вир.‡Besorgt die uralten Waffen der Tol\'vir‡고대 톨비르 무기를 회수해야 합니다.‡Recupera las armas de Tol\'vir antiguas‡Recupera las armas de Tol\'vir antiguas‡Retrouvez les Armes antiques tol\'vir.‡获得古老的托维尔军备物资.‡取回古老的托維爾軍備',
  }
},
[27840] = {
  {
    'Cristais de draenetista‡Кристаллы дренетиста‡Draenethystkristalle‡드레니시스트 수정‡Cristales draenetistas‡Cristales draenetistas‡Les cristaux de draenéthyste‡德莱尼水晶‡德萊尼水晶',
    nil,
    'Pegue 5 Cristais de Draenetista no Retiro Alqueivado.‡Отыщите 5 кристаллов дренетиста в Болотном Пристанище.‡Sammelt 5 Draenethystkristalle in der Zuflucht der Verirrten auf.‡드레노어 성역에서 드레니시스트 수정 5개를 모아야 합니다.‡Hazte con 5 cristales draenetistas en el Retiro Fangoso.‡Hazte con 5 cristales draenetistas en el Retiro Fangoso.‡Récupérez 5 Cristaux de draenéthyste dans le Sanctuaire des Friches.‡从农田避难所收集5颗德莱尼水晶。‡在農田避難所收集5塊德萊尼水晶。',
  }
},
[27841] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡感激的悼念‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Goblínico Alegre no cemitério de Orgrimmar.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу гоблина на кладбище Оргриммара.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Goblingeist auf dem Friedhof von Orgrimmar.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡‡Consigue pan de muerto y dáselo al espíritu de goblin alegre en el cementerio de Orgrimmar.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡‡Obtenez du Pain des morts et donnez-le à l’Esprit de gobelin joyeux, dans le cimetière d\'Orgimmar.|n|nUtilisez un Chrysanthème orange pour voir l’esprit.‡获取一些悼念糕饼，将它交给奥格瑞玛墓地的欢快的地精灵魂。|n|n用橙菊可以看到其他隐形的幽灵。‡拿一些亡者麵包給奧格瑪墓地中興奮的哥布林靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[27842] = {
  {
    'A chapa está esquentando‡Это только начало‡Erst der Anfang‡그저 시작일 뿐‡Solo el principio‡Solo el principio‡Ce n\'est que le début‡只是开始‡只是開始',
    nil,
    'Mate Falagrum.‡Убейте Глубтока.‡Tötet Glubtok.‡글럽톡을 처치해야 합니다.‡Mata a Glubtok.‡Mata a Glubtok.‡Tuez Glubtok.‡杀掉格拉布托克。‡殺死格魯巴托克。',
  }
},
[27843] = {
  {
    'Reforços negados‡Никакого подкрепления‡Verstärkungen abgelehnt‡증원군을 막아라‡Refuerzos denegados‡Refuerzos denegados‡Renforts refusés‡援兵遭拒‡封鎖援軍',
    nil,
    'Mate 3 Bruxos do Pedregal.‡Убейте 3 чернокнижников Каменора.‡Tötet 3 Hexenmeister von Steinard.‡스토나드 흑마법사 3명을 처치해야 합니다.‡Mata a 3 brujos de Rocal.‡Mata a 3 brujos de Rocal.‡Tuez 3 Démonistes de Pierrêche.‡杀死3名斯通纳德术士。‡消滅3個斯通納德術士。',
  }
},
[27844] = {
  {
    'Traidores!!!‡Предатели!!!‡Verräter!!!‡배신자들!!!‡¡¡¡Traidores!!!‡¡¡¡Traidores!!!‡Traîtres !!!‡叛徒！！！‡背叛者!!!',
    nil,
    'Derrote Helix Quebracâmbio.‡Одолейте Хеликса Отломчикса.‡Besiegt Helix Ritzelbrecher.‡헬릭스 기어브레이커를 처치해야 합니다.‡Vence a Helix Rompengranajes.‡Vence a Helix Rompengranajes.‡Vaincre Hélix Engrecasse.‡打败赫利克斯·破甲。‡擊敗赫利克斯‧碎輪者。',
  }
},
[27845] = {
  {
    'Em honra aos mortos‡Отметить павших‡Markiert die Gefallenen‡쓰러진 자의 깃발‡La marca de los caídos‡La marca de los caídos‡Le marquage des morts‡标记阵亡者‡標記逝者',
    nil,
    'Use o Estandarte dos Abatidos para marcar 7 Soldados Rasos Mortos do Posto da Maré.‡Знаменем павших отметьте 7 павших воинов Болотных Волн.‡Benutzt die Banner der Gefallenen, um 7 gefallene Fußsoldaten der Sumpftidenwacht zu markieren.‡쓰러진 자의 깃발을 사용해 쓰러진 습지너울 보병 7명을 표시해야 합니다.‡Utiliza el Estandarte de los Caídos para marcar a 7 lacayos Marea Pantanosa.‡Utiliza el Estandarte de los Caídos para marcar a 7 lacayos Marea Pantanosa.‡Utilisez la Bannière des trépassés pour marquer l\'emplacement de 7 Fantassins de l\'Estran morts.‡使用败亡之旗标记7名阵亡的沼泽之潮步兵。‡用逝者旌旗標記7個死去的沼潮步卒。',
  }
},
[27846] = {
  {
    '‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡感激的悼念‡',
    nil,
    '‡Принесите поминальный хлеб веселому духу воргена на кладбище Оргриммара.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Worgengeist auf dem Friedhof von Darnassus.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡‡Consigue pan de muerto y dáselo al espíritu de huargen alegre en el cementerio de Darnassus.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡‡Obtenez du Pain des morts et donnez-le à l\'Esprit de worgen joyeux, dans le cimetière de Darnassus.|n|nUtilisez un Chrysanthème orange pour voir l\'esprit.‡获取一些悼念糕饼，将它交给达纳苏斯墓地的欢快的狼人灵魂。|n|n用橙菊可以看到其他隐形的幽灵。‡',
  }
},
[27847] = {
  {
    'Ainda não estão no ponto‡Немного не то‡Noch nicht ganz fertig‡2% 부족한‡No del todo‡No del todo‡C\'est pas encore ça‡还没好‡還差了點',
    nil,
    'Destrua o Ceifador de Inimigos 5000.‡Уничтожьте Врагорез-5000.‡Zerstört den Feindschnitter 5000.‡전투 절단기 5000을 파괴해야 합니다.‡Destruye el Siegaenemigos 5000.‡Destruye el Siegaenemigos 5000.‡Détruisez le Faucheur 5000.‡摧毁死神5000。‡摧毀敵人收割者5000。',
  }
},
[27848] = {
  {
    'O que vale é a intenção‡Хотели как лучше, а получилось как всегда‡Gute Absichten... Schlechte Durchführung‡좋은 기획... 나쁜 실행‡Buenas intenciones... Ejecución pobre‡Buenas intenciones... Ejecución pobre‡Les bonnes intentions, on sait où ça mène…‡完美的计划……糟糕的执行‡立意良善...但執行薄弱',
    nil,
    'Mate o Almirante Rosnarrasga.‡Убейте адмирала Терзающего Рева.‡Tötet Admiral Knurrreißer.‡제독 으르렁니를 처치해야 합니다.‡Mata al almirante Rasgagruñido.‡Mata al almirante Rasgagruñido.‡Tuez l\'Amiral Grondéventre.‡杀死撕心狼将军。‡殺死利普斯納爾上將。',
  }
},
[27849] = {
  {
    'Ataque ao Pedregal‡Штурм Каменора‡Angriff auf Steinard‡스토나드 공습‡Asalto a Rocal‡Asalto a Rocal‡L\'assaut sur Pierrêche‡攻击斯通纳德‡攻擊斯通納德',
    nil,
    'Mate 6 Defensores do Pedregal.‡Убейте 6 защитников Каменора.‡Erschlagt 6 Verteidiger von Steinard.‡스토나드 파수병 6명을 처치해야 합니다.‡Mata a 6 defensores de Rocal.‡Mata a 6 defensores de Rocal.‡Tuez 6 Défenseurs de Pierrêche.‡杀死6名斯通纳德防御者。‡消滅6個斯通納德防衛者。',
  }
},
[27850] = {
  {
    'O chefão Défias‡Главарь Братства Справедливости‡Die Nummer Eins der Defias‡데피아즈단 두목‡Principal de los Defias‡Principal de los Defias‡Le caïd défias‡迪菲亚兄弟会首脑‡迪菲亞兄弟會的首腦',
    nil,
    'Mate o Chefão Défias.‡Убейте главаря Братства Справедливости.‡Tötet die Nummer Eins der Defias.‡데피아즈단 두목을 처치해야 합니다.‡Mata a la principal de los Defias.‡Mata a la principal de los Defias.‡Tuez le Caïd défias‡杀掉迪菲亚兄弟会首脑。‡殺死迪菲亞兄弟會的首腦。',
  }
},
[27851] = {
  {
    'Cortando o abastecimento‡Отобрать пайки‡Nachschubunterbrechung‡자원 끊기‡Cortar el suministro‡Cortar el suministro‡Couper les vivres‡切断补给‡切斷補給',
    nil,
    'Colete 5 caixotes de Suprimentos do Pedregal.‡Захватите 5 ящиков провианта Каменора.‡Erbeutet 5 Kisten mit Vorräten von Steinard.‡스토나드 보급품 5 상자를 모아야 합니다.‡Confisca 5 cajones de suministros de Rocal.‡Confisca 5 cajones de suministros de Rocal.‡Récupérez 5 caisses de Ravitaillement de Pierrêche.‡缴获5箱斯通纳德补给。‡搶來5個斯通納德補給品箱。',
  }
},
[27852] = {
  {
    'Orcs e humanos‡Орки и люди‡Orcs und Menschen‡오크와 인간‡Orcos y humanos‡Orcos y humanos‡Orcs et humains‡兽人与人类‡獸人與人類',
    nil,
    'Mate 10 Soldados Rasos da Maré do Pântano.‡Зарубите 10 солдат Болотных Волн.‡Tötet 10 Fußsoldaten der Sumpftidenwacht.‡습지너울 보병 10명을 처치해야 합니다.‡Mata a 10 lacayos Marea Pantanosa.‡Mata a 10 lacayos Marea Pantanosa.‡Tuez 10 Fantassins de l\'Estran.‡消灭10名沼泽之潮步兵。‡消滅10個沼潮步卒。',
  }
},
[27853] = {
  {
    'Parvos desorientados‡Лес рубят – щепки летят‡Trampel‡미련퉁이‡Patanes inútiles‡Patanes inútiles‡Encore du travail ?‡伐木场巨怪‡笨重的蠢蛋',
    nil,
    'Mate 5 Camponeses do Posto Maré do Pântano.‡Убейте 5 крестьян Болотных Волн.‡Tötet 5 Bauern der Sumpftidenwacht.‡습지너울 일꾼 5명을 처치해야 합니다.‡Mata a 5 campesinos Marea Pantanosa.‡Mata a 5 campesinos Marea Pantanosa.‡Tuez 5 Paysans de l\'Estran.‡消灭5名沼泽之潮农夫。‡消滅5個沼潮農民。',
  }
},
[27854] = {
  {
    'Marés Sombrias‡Силы тьмы‡Flut der Dunkelheit‡어둠의 물결‡Mareas oscuras‡Mareas oscuras‡La marée des ténèbres‡黑潮‡暗潮來襲',
    nil,
    'Mate 6 Cavaleiros do Posto Maré do Pântano.‡Убейте 6 рыцарей Болотных Волн.‡Tötet 6 Ritter der Sumpftidenwacht.‡습지너울 기사 6명을 처치해야 합니다.‡Mata a 6 caballeros Marea Pantanosa.‡Mata a 6 caballeros Marea Pantanosa.‡Tuez 6 Chevaliers de l\'Estran.‡消灭6名沼泽之潮骑士。‡消滅6個沼潮騎士。',
  }
},
[27855] = {
  {
    'Reforços negados‡Никакого подкрепления‡Verstärkungen abgelehnt‡증원군을 막아라‡Refuerzos denegados‡Refuerzos denegados‡Renforts refusés‡援兵遭阻‡封鎖援軍',
    nil,
    'Mate 3 Magos do Posto Maré do Pântano.‡Убейте 3 магов Болотных Волн.‡Tötet 3 Magier der Sumpftidenwacht.‡습지너울 마법사 3명을 처치해야 합니다.‡Mata a 3 magos Marea Pantanosa.‡Mata a 3 magos Marea Pantanosa.‡Tuez 3 Mages de l\'Estran.‡消灭3名沼泽之潮法师。‡消滅3個沼潮法師。',
  }
},
[27856] = {
  {
    'Em honra aos mortos‡Отметить павших‡Markiert die Gefallenen‡쓰러진 자의 깃발‡La marca de los caídos‡La marca de los caídos‡Le marquage des morts‡标记阵亡者‡標記逝者',
    nil,
    'Use o Estandarte dos Abatidos para marcar 7 Guerreiros Mortos do Pedregal.‡Знаменем павших отметьте 7 павших воинов Каменора.‡Benutzt das Banner der Gefallenen, um 7 gefallene Krieger von Steinard zu markieren.‡쓰러진 자의 깃발을 사용해 전사한 스토나드 전사 7명을 표시해야 합니다.‡Utiliza el Estandarte de los Caídos para marcar a 7 guerreros de Rocal caídos.‡Utiliza el Estandarte de los Caídos para marcar a 7 guerreros de Rocal caídos.‡Utilisez la Bannière des trépassés pour marquer l\'emplacement de 7 Guerriers de Pierrêche déchus.‡使用败亡之旗标记7名阵亡的斯通纳德战士。‡用逝者旌旗標記7個死去的斯通納德戰士。',
  }
},
[27857] = {
  {
    'Estamos sendo atacados!‡На нас напали!‡Wir werden angegriffen!‡적의 공격이다!‡¡Nos atacan!‡¡Nos atacan!‡Nous sommes attaqués !‡我们遭到了攻击！‡我們正遭受攻擊!',
    nil,
    'Mate 12 Invasores do Posto Maré do Pântano.‡Убейте 12 захватчиков Болотных Волн.‡Tötet 12 Eindringlinge der Sumpftidenwacht.‡습지너울 침략자 12명을 처치해야 합니다.‡Mata a 12 invasores Marea Pantanosa.‡Mata a 12 invasores Marea Pantanosa.‡Tuez 12 Envahisseurs de l\'Estran.‡消灭12名沼泽之潮入侵者。‡消滅12個沼潮入侵者。',
  }
},
[27858] = {
  {
    'O presente de Rheastrasza‡Дар Реастразы‡Rheastraszas Geschenk‡레아스트라자의 선물‡El regalo de Rheastrasza‡El regalo de Rheastrasza‡Le cadeau de Rheastrasza‡瑞亚丝塔萨的礼物‡莉雅史卓莎的禮物',
    nil,
    'Espere enquanto Rhea recupera o ovo do Ninho Escondido.‡Подождите, пока Реа достанет яйцо из Потайной кладки.‡Wartet, während Rhea das Ei aus dem Versteckten Gelege holt.‡레아가 숨겨진 손아귀에서 알을 되찾아올 때까지 기다려야 합니다.‡Espera mientras Rhea recupera el huevo de la Guarida Oculta.‡Espera mientras Rhea recupera el huevo de la Guarida Oculta.‡Patientez pendant que Rhea récupère l\'œuf à la Couvée cachée.‡等待瑞亚从隐藏的龙巢中把蛋拿回来。‡等待莉雅從隱秘窩巢取回龍蛋。',
  }
},
[27859] = {
  {
    '‡Яйцо в безопасности‡Das Ei lebt weiter‡알은 영원하다‡El huevo sobrevive‡‡L\'œuf grandit‡龙蛋仍在成长‡',
    nil,
    '‡Подождите, пока Реа достанет яйцо из Потайной кладки.‡Wartet, während Rhea das Ei aus dem Versteckten Gelege holt.‡레아가 숨겨진 손아귀에서 알을 되찾아올 때까지 기다려야 합니다.‡Espera mientras Rhea recupera el huevo de la Guarida Oculta.‡‡Patientez pendant que Rhea récupère l\'œuf à la Couvée cachée.‡等待瑞亚从隐藏的龙巢中把蛋拿回来。‡',
  }
},
[27860] = {
  {
    'Os Perdidos‡Заблудшие‡Die Verirrten‡잃어버린 드레나이‡Los Perdidos‡Los Perdidos‡Les perdus‡失落者‡失落者',
    nil,
    'Mate 12 Perdidos no Retiro Alqueivado.‡Перебейте 12 Заблудших в Болотном пристанище.‡Tötet 12 Verirrte in der Zuflucht der Verirrten.‡드레노어 성역에 있는 잃어버린 드레나이 12명을 처치해야 합니다.‡Mata a 12 Perdidos en el Retiro Fangoso.‡Mata a 12 Perdidos en el Retiro Fangoso.‡Tuez 12 Perdus dans le Sanctuaire des Friches.‡到农田避难所去消灭12名失落者。‡在農田避難所消滅12個失落者。',
  }
},
[27861] = {
  {
    'O Caldeirão da Carnificina: o briguento Olho de Sangue!‡Горнило Крови: боец из клана Кровавого Глаза!‡Der Schmelztiegel des Gemetzels: Haudrauf der Blutaugen!‡대학살의 도가니: 붉은눈 투사!‡El Crisol de Matanza: ¡el truhán Ojosangre!‡El Crisol de Matanza: ¡el truhán Ojosangre!‡Le Creuset du carnage : le Cogneur œil-sanglant !‡杀戮熔炉竞技场：血眼斗士！‡兇殘之爐:血眼衛士!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente Hurp\'derp!‡Выйдите на арену Горнила Крови и одержите победу над Хурп\'дерпом!‡Betretet die Arena im Schmelztiegel des Gemetzels und besiegt Strunz\'blunz!‡대학살의 도가니 투기장 안으로 들어가 허프더프를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡Entrez dans l’arène du Creuset du carnage, et triomphez de Hurp\'derp !‡进入杀戮熔炉竞技场，击败胡尔德普！‡進入兇殘之爐的競技場並擊敗赫普德普!',
  }
},
[27862] = {
  {
    'O Caldeirão da Carnificina: o briguento Olho de Sangue!‡Горнило Крови: боец из клана Кровавого Глаза!‡Der Schmelztiegel des Gemetzels: Haudrauf der Blutaugen!‡대학살의 도가니: 붉은눈 투사!‡El Crisol de Matanza: ¡el truhán Ojosangre!‡El Crisol de Matanza: ¡el truhán Ojosangre!‡Le Creuset du carnage : le Cogneur œil-sanglant !‡杀戮熔炉竞技场：血眼斗士！‡兇殘之爐:血眼衛士!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente Hurp\'derp!‡Выйдите на арену Горнила Крови и одержите победу над Хурп\'дерпом!‡Betretet die Arena im Schmelztiegel des Gemetzels und besiegt Strunz\'blunz!‡대학살의 도가니 투기장 안으로 들어가 허프더프를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡Entrez dans l’arène du Creuset du carnage, et triomphez de Hurp\'derp !‡进入杀戮熔炉竞技场，击败胡尔德普！‡進入兇殘之爐的競技場並擊敗赫普德普!',
  }
},
[27863] = {
  {
    'O Caldeirão da Carnificina: o briguento Olho de Sangue!‡Горнило Крови: боец из клана Кровавого Глаза!‡Der Schmelztiegel des Gemetzels: Haudrauf der Blutaugen!‡대학살의 도가니: 붉은눈 투사!‡El Crisol de Matanza: ¡el truhán Ojosangre!‡El Crisol de Matanza: ¡el truhán Ojosangre!‡Le Creuset du carnage : le Cogneur œil-sanglant !‡杀戮熔炉竞技场：血眼斗士！‡兇殘之爐:血眼衛士!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente Hurp\'derp!‡Выйдите на арену Горнила Крови и одержите победу над Хурп\'дерпом!‡Betretet die Arena im Schmelztiegel des Gemetzels und besiegt Strunz\'blunz!‡대학살의 도가니 투기장 안으로 들어가 허프더프를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡¡Entra en la arena en el Crisol de Matanza y derrota a Hurp\'derp!‡Entrez dans l’arène du Creuset du carnage, et triomphez de Hurp\'derp !‡进入杀戮熔炉竞技场，击败胡尔德普！‡進入兇殘之爐的競技場並擊敗赫普德普!',
  }
},
[27864] = {
  {
    'O Caldeirão da Carnificina: os mortais Presa do Dragão!‡Горнило Крови: смертоносная Драконья Пасть.‡Der Schmelztiegel des Gemetzels: Todbringer des Drachenmals!‡대학살의 도가니: 무시무시한 용아귀 부족!‡El Crisol de Matanza: ¡el mortal Faucedraco!‡El Crisol de Matanza: ¡el mortal Faucedraco!‡Le Creuset du carnage : le Gueule-de-dragon implacable !‡杀戮熔炉竞技场：致命的龙喉！‡兇殘之爐:致命的龍喉!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e derrote Torg Esfoladraco!‡Выйдите на арену Горнила Крови и одержите победу над Торгом Свежевателем Драконов!‡Betretet die Arena am Schmelztiegel des Gemetzels und besiegt Torg Drachenschinder!‡대학살의 도가니 투기장 안으로 들어가 비룡잡이 토르그를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota a Torg Cazadraco!‡¡Entra en la arena en el Crisol de Matanza y derrota a Torg Cazadraco!‡Entrez dans l’arène du Creuset du carnage, et triomphez de Torg Écorche-drake !‡进入杀戮熔炉竞技场，击败托格·掠龙者！‡進入兇殘之爐的競技場，擊敗托爾格‧剝龍者!',
  }
},
[27865] = {
  {
    'O Caldeirão da Carnificina: o Martelo Feroz teimoso!‡Горнило Крови: грозный Грозовой Молот.‡Der Schmelztiegel des Gemetzels: Der unberechenbare Wildhammer!‡대학살의 도가니: 고집쟁이 와일드해머!‡El Crisol de Matanza: ¡el perverso Martillo Salvaje!‡El Crisol de Matanza: ¡el perverso Martillo Salvaje!‡Le Creuset du carnage : l’Incontrôlable Marteau-hardi !‡杀戮熔炉竞技场：固执的蛮锤！‡兇殘之爐:固執的蠻錘!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente Súlio Rompedor!‡Выйдите на арену Горнила Крови и одержите победу над Суллом Коленодробом!‡Betretet die Arena am Schmelztiegel des Gemetzels und besiegt Sully Kniescheibler!‡대학살의 도가니 투기장 안으로 들어가 설리 니캐퍼를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota a Sully Cortarrótulas!‡¡Entra en la arena en el Crisol de Matanza y derrota a Sully Cortarrótulas!‡Entrez dans l’arène du Creuset du carnage, et triomphez de Sully Pète-Rotule !‡进入杀戮熔炉竞技场，击败萨利·碎膝！‡進入兇殘之爐的競技場，擊敗蘇利·蓋膝!',
  }
},
[27866] = {
  {
    'O Caldeirão da Carnificina: a criação de Calder!‡Горнило Крови: чудовище Колдера‡Der Schmelztiegel des Gemetzels: Calders Geschöpf!‡대학살의 도가니: 칼더의 창조물!‡El Crisol de Matanza: ¡la creación de Calder!‡El Crisol de Matanza: ¡la creación de Calder!‡Le Creuset du carnage : la Création de Calder !‡杀戮熔炉竞技场：卡尔德的造物！‡兇殘之爐:考德爾的創造物!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente o Remendão!‡Выйдите на арену Горнила Крови и одержите победу над составным кадавром!‡Betretet die Arena am Schmelztiegel des Gemetzels und besiegt die Kadavercollage!‡대학살의 도가니 투기장 안으로 들어가 시체누더기를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota al Collage de cadáver!‡¡Entra en la arena en el Crisol de Matanza y derrota al Collage de cadáver!‡Entrez dans l’arène du Creuset du carnage, et triomphez du Collage cadavérique !‡进入杀戮熔炉竞技场，击败拼装巨人！‡進入兇殘之爐的競技場並擊敗拼湊的死屍!',
  }
},
[27867] = {
  {
    'O Caldeirão da Carnificina: o senhor da Estripação!‡Горнило Крови: лорд-Потрошитель‡Der Schmelztiegel des Gemetzels: Der Graf des Ausweidens!‡대학살의 도가니: 학살자 백작!‡El Crisol de Matanza: ¡el duque del destripamiento!‡El Crisol de Matanza: ¡el duque del destripamiento!‡Le Creuset du carnage : le Comte de l\'Éviscération !‡杀戮熔炉竞技场：剔骨男爵！‡兇殘之爐:開膛手伯爵!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente o Lorde Geoffery Tulvan!‡Выйдите на арену Горнила Крови и одержите победу над лордом Джеффри Талваном!‡Betretet die Arena am Schmelztiegel des Gemetzels und besiegt Lord Geoffery Tulvan!‡대학살의 도가니 투기장 안으로 들어가 지오프리 툴반 경을 제압해야 합니다!‡¡Entra en la arena en el Crisol de Matanza y derrota a Lord Geoffery Tulvan!‡¡Entra en la arena en el Crisol de Matanza y derrota a Lord Geoffery Tulvan!‡Entrez dans l’arène du Creuset du carnage, et triomphez du Seigneur Geoffrey Tulvan !‡进入杀戮熔炉竞技场，击败吉奥弗雷·塔尔文领主！‡進入兇殘之爐的競技場，擊敗喬佛瑞·圖爾凡伯爵!',
  }
},
[27868] = {
  {
    'O Caldeirão da Carnificina: o terror do Crepúsculo!‡Горнило Крови: Сумеречный ужас‡Der Schmelztiegel des Gemetzels: Der Schattenterror!‡대학살의 도가니: 황혼의 공포!‡El Crisol de Matanza: ¡el terror Crepuscular!‡El Crisol de Matanza: ¡el terror Crepuscular!‡Le Creuset du carnage : la Terreur du Crépuscule !‡杀戮熔炉竞技场：暮光的恐惧！‡兇殘之爐:暮光的恐怖!',
    nil,
    'Vá até a arena do Caldeirão da Carnificina e enfrente Escoriabrasa, o Devorador!‡Выйдите на арену Горнила Крови и одержите победу над Углеколом Пожирателем!‡Betretet die Arena am Schmelztiegel des Gemetzels und besiegt Glutnarbe den Verschlinger!‡대학살의 도가니 투기장 안으로 들어가 포식자 잿불흉터를 제압하십시오!‡¡Entra en la arena en el Crisol de Matanza y derrota a Brasaescara el Devorador!‡¡Entra en la arena en el Crisol de Matanza y derrota a Brasaescara el Devorador!‡Entrez dans l’arène du Creuset du carnage, et triomphez de Braisentaille le Dévoreur !‡进入杀戮熔炉竞技场，击败吞噬者余烬之痕！‡進入兇殘之爐的競技場，擊敗『吞噬者』燼痕!',
  }
},
[27869] = {
  {
    'O dragão e o templo‡Дракон и храм‡Der Drache und der Tempel‡용과 신전‡El dragón y el templo‡El dragón y el templo‡Le dragon et le temple‡龙与神庙‡巨龍與神廟',
    nil,
    'Fale com Lorde Itharius no topo dos degraus externos do templo de Atal\'Hakkar.‡Поговорите с лордом Итаром на вершине лестницы в храме Атал\'Хаккара.‡Redet mit Lord Itharius oben auf den äußeren Stufen des Tempels von Atal\'Hakkar.‡아탈학카르 신전의 바깥쪽 계단의 꼭대기에 있는 군주 이타리우스와 대화해야 합니다.‡Habla con Lord Itharius en lo alto de las escaleras exteriores del Templo de Atal\'Hakkar.‡Habla con Lord Itharius en lo alto de las escaleras exteriores del Templo de Atal\'Hakkar.‡Parlez au Seigneur Itharius, au sommet des marches extérieures du Temple d\'Atal\'Hakkar.‡跟阿塔哈卡神庙外部台阶顶部的伊萨里奥斯勋爵谈一谈。‡到阿塔哈卡神廟外面台階上和伊薩里奧斯領主談話。',
  }
},
[27870] = {
  {
    'Rumo ao Posto Maré do Pântano‡Возвращение на Заставу Болотной Воды‡Zur Sumpftidenwacht‡습지너울 감시초소로‡A la Avanzada Marea Pantanosa‡A la Avanzada Marea Pantanosa‡Vers le guet de l\'Estran‡到沼泽之潮哨站去‡前往沼潮哨站',
    nil,
    'Fale com Joana Tristalma no Posto Maré do Pântano.‡Поговорите с Джоанной Блухарт на Заставе Болотной Воды.‡Sprecht mit Joanna Blauherz bei der Sumpftidenwacht.‡습지너울 감시초소에 있는 조안나 블루하트와 대화해야 합니다.‡Habla con Joanna Corazón Azul en la Avanzada Marea Pantanosa.‡Habla con Joanna Corazón Azul en la Avanzada Marea Pantanosa.‡Parlez à Joanna Cœurbleu au Guet de l\'Estran, dans le Marais des Chagrins.‡跟沼泽之潮哨站的琼娜·布鲁哈特谈一谈。‡到沼潮哨站找瓊安娜·普魯哈特說話。',
  }
},
[27871] = {
  {
    'Rumo ao Pedregal‡Возвращение в Каменор‡Nach Steinard‡스토나드로‡A Rocal‡A Rocal‡Vers Pierrêche‡去斯通纳德‡前往斯通納德',
    nil,
    'Fale com o Comandante de Expedição Ruag no Pedregal, que fica no Pântano das Mágoas.‡Поговорите с командиром разведотряда Руагом в Каменоре на Болоте Печали.‡Sprecht mit Zentralenkommandant Ruag in Steinard in den Sümpfen des Elends.‡슬픔의 늪의 스토나드에 있는 파견사령관 루아그와 대화해야 합니다.‡Habla con el comandante de envíos Ruag en Rocal, en el Pantano de las Penas.‡Habla con el comandante de envíos Ruag en Rocal, en el Pantano de las Penas.‡Parlez au commandant d\'ordonnance Ruag à Pierrêche, dans le Marais des Chagrins.‡跟悲伤沼泽斯通纳德的分队指挥官鲁尔格谈一谈。‡到悲傷沼澤的斯通納德找分隊指揮官盧爾格說話。',
  }
},
[27872] = {
  {
    '‡‡‡‡Misiones de Tortolla completadas‡‡Série de Tortolla terminée‡‡',
    nil,
    nil,
  }
},
[27873] = {
  {
    '‡Контрольная точка Авианы пройдена‡‡‡Misiones de Aviana completadas‡‡Série d\'Aviana terminée‡‡',
    nil,
    nil,
  }
},
[27874] = {
  {
    'O legado de Aviana‡Наследие Авианы‡Avianas Vermächtnis‡아비아나가 남긴 것‡El legado de Aviana‡El legado de Aviana‡La descendance d’Aviana‡艾维娜的遗产‡艾維娜的遺產',
    nil,
    'Encontre Choluna no Santuário de Aviana, no Monte Hyjal.‡Разыщите Чолуну в святилище Авианы на горе Хиджал.‡Findet Choluna im Schrein von Aviana auf dem Hyjal.‡하이잘 산의 아비아나의 제단에 있는 초루나를 찾아야 합니다.‡Encuentra a Choluna en el Santuario de Aviana, en Monte Hyjal.‡Encuentra a Choluna en el Santuario de Aviana, en Monte Hyjal.‡Trouvez Choluna dans le Sanctuaire d’Aviana, au Mont Hyjal.‡去找海加尔山艾维娜圣殿的楚伦娜。‡到海加爾的艾維娜聖壇尋找克魯娜。',
  }
},
[27875] = {
  {
    'Florrogo‡Молитвоцвет‡Gebetsblume‡기원의 꽃‡Flor de plegaria‡Flor de plegaria‡La chapelette‡祝祷之花‡祈花',
    nil,
    'Colete 10 brotos de Florrogo do Lodaçal Mutante.‡Соберите 10 побегов молитвоцвета в Ползучей трясине.‡Sammelt 10 Zweige der Gebetsblume im Wabersumpf.‡변화의 늪에서 기원의 꽃 10송이를 모아야 합니다.‡Recoge 10 ramos de flor de plegaria del Lodo Traicionero.‡Recoge 10 ramos de flor de plegaria del Lodo Traicionero.‡Récoltez 10 brins de Chapelette dans le Bourbier Changeant.‡从流沙泥潭收集10株祝祷之花。‡在流沙泥潭收集10枝祈花。',
  }
},
[27876] = {
  {
    'Segredos do lodo‡Тайны Ползучей Трясины‡Die Geheimnisse des Sumpfes‡늪의 비밀‡Los secretos del lodo‡Los secretos del lodo‡Les secrets du bourbier‡泥潭的秘密‡泥潭的秘密',
    nil,
    'Colete 10 amostras de Lama Envigorada de Bolhas do Lodaçal Mutante.‡Соберите 10 образцов укрепляющего ила в Ползучей трясине.‡Sammelt 10 Exemplare kräftigen Schlick von Wabersumpfklumpen.‡변화의 진흙덩어리로부터 생기로운 침적토 10개를 모아야 합니다.‡Recoge 10 muestras de cieno vigorizado de pegotes de lodo traicionero.‡Recoge 10 muestras de cieno vigorizado de pegotes de lodo traicionero.‡Récupérez 10 Échantillons de vase vivifiée sur des Globules de bourbier changeants.‡从移动的潭泥身上收集10份充满活力的淤泥样本。‡到流沙泥潭收集10個充滿活力的淤泥樣本。',
  }
},
[27877] = {
  {
    'A liga dos idiotas‡Цирк непуганых идиотов‡Die Schwachkopfliga‡얼간이 연맹‡La Liga de Cretinos‡La Liga de Cretinos‡La ligue des idiots‡低能者协会‡白痴同盟',
    nil,
    'Obtenha 15 Cabeças de Ferro Negro.‡Раздобудьте 15 голов дворфов клана Черного Железа.‡Besorgt 15 Dunkeleisenköpfe.‡검은무쇠 머리카락 15개를 획득해야 합니다.‡Consigue 15 cabezas de Hierro Negro.‡Consigue 15 cabezas de Hierro Negro.‡Obtenez 15 Têtes de nains sombrefers.‡取回15顶黑铁的罩帽。‡取下15顆黑鐵矮人頭。',
  }
},
[27878] = {
  {
    'Aquisição forçada‡Насильственный захват‡Gewaltsame Aneignung‡강제 취득‡Adquisición forzosa‡Adquisición forzosa‡Acquisition par effraction‡强取豪夺‡豪取巧奪',
    nil,
    'Procure o tesouro no andar inferior da Fortaleza Angor.‡Поищите сокровище на самом нижнем уровне крепости Ангор.‡Sucht im untersten Geschoss der Festung Angor nach Schätzen.‡고통의 요새 지하에서 보물을 찾아야 합니다.‡Busca el tesoro en la planta baja de la Fortaleza de Angor.‡Busca el tesoro en la planta baja de la Fortaleza de Angor.‡Cherchez un trésor au dernier sous-sol de la Forteresse d\'Angor.‡在苦痛堡垒的底楼搜寻财宝。‡在苦痛堡壘的底層搜尋寶藏。',
  }
},
[27879] = {
  {
    'Política da boa vizinhança‡Выживает жирнейший‡Überleben der Dicksten‡뚱보들의 생존 방법‡El más gordo sobrevive‡El más gordo sobrevive‡La survie du plus gros‡劫胖济贫‡肥者生存',
    nil,
    'Obtenha 6 pedaços de Carne dos Arrota-pó e 10 cortes de Seda dos Arrota-pó.‡Добудьте 6 порций мяса и 10 отрезов шелка клана Гнилобрюхих.‡Erlangt 6 Fleischstücke der Staubspeier und 10 Lagen Seide der Staubspeier.‡먼지목도리 고기 6개와 먼지목도리 비단 10개를 획득해야 합니다.‡Consigue 6 trozos de carne Rotapolvo y 10 sábanas de seda Rotapolvo.‡Consigue 6 trozos de carne Rotapolvo y 10 sábanas de seda Rotapolvo.‡Obtenez 6 Morceaux de viande de Crache-poussières et 10 Draps de soie crache-poussière.‡收集6块火烟之肉和10张火烟丝绸。‡取得6份火煙肉和10份火煙絲綢。',
  }
},
[27880] = {
  {
    'Problemas de meia tonelada‡Затяжная оборона‡Tonnenschwere Starrköpfe‡뚱보 저항군‡Resistentes de media tonelada‡Resistentes de media tonelada‡Reclus d\'une demi-tonne‡顽固的肥佬‡半噸的伏兵',
    nil,
    'Mate 12 Combatentes Arrota-pó. Você pode matar Espancadores Arrota-pó ou Xamãs Arrota-pó.‡Уничтожьте 12 бойцов клана Гнилобрюхих. Можно убивать как извергов, так и шаманов этого клана.‡Tötet 12 Kämpfer der Staubspeier. Ihr könnt sowohl Raufer als auch Schamanen der Staubspeier töten.‡먼지목도리 싸움꾼 또는 먼지목도리 주술사 12마리를 처치해야 합니다.‡Mata a 12 combatientes Rotapolvo. Puedes matar a aplastadores Rotapolvo o a chamanes Rotapolvo.‡Mata a 12 combatientes Rotapolvo. Puedes matar a aplastadores Rotapolvo o a chamanes Rotapolvo.‡Tuez 12 Combattants crache-poussières. Vous pouvez tuer des Marteleurs ou des Chamans crache-poussières.‡杀死12名火烟食人魔，火烟虐待者或是火烟萨满祭司都成。‡殺死12名火煙部族的戰鬥人員。你可以殺死火煙虐待者或火煙薩滿。',
  }
},
[27881] = {
  {
    'Posto Vigília de Sangue‡Лагерь Кровавого Взора‡Blutwächterposten‡피감시자 거점‡Paso de Mirasangre‡Paso de Mirasangre‡La halte de Guettesang‡血望者营地‡血腥看守者之尖',
    nil,
    'Fale com o Avaliador-mor Tae\'thelan Vigiassangre no Posto Vigília de Sangue, que fica nos Ermos.‡Обратитесь к главному дознавателю Тей\'телану Кровавому Взору в лагере Кровавого Взора, что в Бесплодных землях.‡Sprecht mit dem Obersten Prüfer Tae\'thelan Blutwächter am Blutwächterposten im Ödland.‡황야의 땅, 피감시자 거점에 있는 고위 검사관 태더란 블러드워처와 대화해야 합니다.‡Habla con el alto examinador Tae\'thelan Mirasangre en el Paso de Mirasangre, en las Tierras Inhóspitas.‡Habla con el alto examinador Tae\'thelan Mirasangre en el Paso de Mirasangre, en las Tierras Inhóspitas.‡Parlez au Haut-examinateur Tae\'thelan Guette-le-sang à la Halte de Guettesang, dans les Terres Ingrates.‡跟荒芜之地血望者营地的高阶考察者泰瑟兰·血望者谈一谈。‡到荒蕪之地的血腥看守者之尖和高階審查員泰瑟連·血腥看守者談話。',
  }
},
[27882] = {
  {
    'A questão aqui não é a história, é o poder‡Вопрос не истории, а силы‡Es geht nicht um Geschichte, sondern um Macht‡역사가 아닌 힘에 대한 문제‡No se trata de historia, sino de poder‡No se trata de historia, sino de poder‡Peu importe l\'histoire quand on a le pouvoir‡无关历史，能量而已‡和歷史無關，重要的是力量',
    nil,
    'Obtenha um Cálice Quebrado, um Vaso Empoeirado, um Hieroglifo Terreno e uma Ferramenta Trogg.‡Добудьте разбитую чашу, пыльную вазу, иероглиф земли и орудие троггов.‡Beschafft einen zerbrochenen Kelch, eine staubige Vase, eine irdene Hieroglyphe und ein Troggwerkzeug.‡부서진 성배, 먼지투성이 꽃병, 대지의 성각문양, 트로그 도구를 획득해야 합니다.‡Consigue un cáliz roto, un jarrón polvoriento, un jeroglífico terráneo y una herramienta trogg.‡Consigue un cáliz roto, un jarrón polvoriento, un jeroglífico terráneo y una herramienta trogg.‡Obtenez un Calice cassé, un Vase poussiéreux, un Hiéroglyphe terrestre et un Outil trogg.‡取回破损的圣杯、满是尘土的花瓶、土灵符文碑刻和穴居人工具。‡取得破掉的酒杯、佈滿灰塵的飾瓶和土靈象形文字、穴居怪工具。',
  }
},
[27883] = {
  {
    'O peão do guardião‡Пешка-страж‡Der Bauer des Wächters‡감독관의 졸‡El peón de celador‡El peón de celador‡Le Pion du Gardien‡戒卫的棋卒‡衛兵兵卒',
    nil,
    'Encontre um uso para o Peão do Guardião dentro da Tumba dos Observadores, que fica nos Ermos.‡Выясните, для чего нужна пешка-страж в Гробнице Стражей в Бесплодных землях.‡Findet im Grab der Wächter im Ödland Verwendung für den Bauer des Wächters.‡황야의 땅에 있는 감시자의 무덤에서 감독관의 졸의 용도를 알아내야 합니다.‡Averigua para qué sirve el peón de celador dentro de la Tumba de los Vigías, en las Tierras Inhóspitas.‡Averigua para qué sirve el peón de celador dentro de la Tumba de los Vigías, en las Tierras Inhóspitas.‡Trouvez à quoi sert le Pion du Gardien à l\'intérieur de la Tombe des Gardiens, dans les Terres Ingrates.‡在荒芜之地的观察者陵墓中，找到戒卫的棋卒的用途。‡在荒蕪之地的看守者之墓裡找到衛兵兵卒的使用處。',
  }
},
[27884] = {
  {
    'O peão da sentinela‡Пешка-часовой‡Der Bauer der Schildwache‡파수꾼의 졸‡El peón de centinela‡El peón de centinela‡Le Pion de la Sentinelle‡哨兵的棋卒‡哨兵兵卒',
    nil,
    'Encontre um uso para o Peão da Sentinela dentro da Tumba dos Observadores, que fica nos Ermos.‡Выясните, для чего нужна пешка-часовой в Гробнице Стражей в Бесплодных землях.‡Findet eine Verwendung für den Bauern der Schildwache innerhalb des Tempels des Grabes der Behüter im Ödland.‡황야의 땅에 있는 감시자의 무덤에서 파수꾼의 졸의 용도를 알아내야 합니다.‡Averigua para qué sirve el peón de centinela dentro de la Tumba de los Vigías, en las Tierras Inhóspitas.‡Averigua para qué sirve el peón de centinela dentro de la Tumba de los Vigías, en las Tierras Inhóspitas.‡Trouvez à quoi sert le Pion de la Sentinelle à l\'intérieur de la Tombe des Gardiens, dans les Terres Ingrates.‡在荒芜之地的观察者陵墓中，找到哨兵的棋卒的用途。‡在荒蕪之地的看守者之墓裡找到哨兵兵卒的使用處。',
  }
},
[27885] = {
  {
    'O jogo do guardião‡Игра стражей‡Das Spiel des Wächters‡감독관의 게임‡El juego del celador‡El juego del celador‡Le jeu du Gardien‡戒卫的游戏‡衛兵遊戲',
    nil,
    'Complete o Jogo do Guardião teleportando os Peões do Guardião para posições voltadas para dentro.‡Завершите игру стражей, переместив пешек-стражей так, чтобы они смотрели внутрь квадрата.‡Beendet das Spiel des Wächters, indem Ihr die Bauern des Wächters in eine nach innen gerichtete Position teleportiert.‡감독관의 졸을 모두 안쪽을 바라보게 움직여서 감독관의 게임을 완료해야 합니다.‡Completa el juego del celador teletransportando a los peones del celador a posiciones en las que miren hacia dentro.‡Completa el juego del celador teletransportando a los peones del celador a posiciones en las que miren hacia dentro.‡Gagnez le Jeu du Gardien en téléportant les Pions du gardien dans des positions pointant vers l\'intérieur.‡将戒卫的棋卒传送到面向里边的位置，以完成戒卫的游戏。‡將衛兵兵卒傳送至面朝中心的位置來完成衛兵遊戲 。',
  }
},
[27886] = {
  {
    'O jogo da sentinela‡Игра часовых‡Das Schildwachenspiel‡파수꾼의 게임‡El juego del centinela‡El juego del centinela‡Le jeu de la Sentinelle‡哨兵的游戏‡哨兵遊戲',
    nil,
    'Complete o Jogo da Sentinela conectando as duas estátuas vermelhas.‡Завершите игру часовых, соединив две красные статуэтки.‡Schließt das Spiel der Schildwache ab, indem Ihr die beiden roten Statuen verbindet.‡빨간색 조각상 두 개를 연결해서 파수꾼의 게임을 완료해야 합니다.‡Completa el juego del centinela conectando las dos estatuas rojas.‡Completa el juego del centinela conectando las dos estatuas rojas.‡Gagnez le Jeu de la Sentinelle en reliant les deux Statues rouges.‡连接两座红色雕像，以完成哨兵的游戏。‡連結兩尊紅色雕像來完成哨兵遊戲。',
  }
},
[27887] = {
  {
    'Protetores ancestrais‡Древние защитники‡Uralte Beschützer‡고대 수호자‡Protectores ancestrales‡Protectores ancestrales‡D\'anciens protecteurs‡远古的保卫者‡遠古保衛者',
    nil,
    'Investigue o Guardião e a Sentinela.‡Внимательно осмотрите Стража и Часового.‡Untersucht den Wächter und die Schildwache.‡감독관과 파수꾼을 조사해야 합니다.‡Examina al Celador y al Centinela.‡Examina al Celador y al Centinela.‡Examinez le Gardien et la Sentinelle.‡调查戒卫和哨兵。‡調查衛兵和哨兵。',
  }
},
[27888] = {
  {
    'Fale novamente com Blam‡Возвращение к Бламу‡Zurück zu Blam‡블램에게 돌아가기‡Devolver a Blam‡Devolver a Blam‡Retournez voir Blam‡返回布拉姆身边‡回去找碰啪',
    nil,
    'Leve o Olho dos Observadores para o Dr. Hieronymus Blam na Ruína de Agmundo, que fica nos Ermos.‡Отнесите Око стражей доктору Иерониму Бламу в Удел Эгмонда в Бесплодных землях.‡Bringt das Auge der Behüter zu Dr. Hieronymus Blam bei der Agmondkuppe im Ödland.‡황야의 땅, 아그몬드의 최후에 있는 박사 히에로니무스 블램에게 감시자의 눈을 가져가야 합니다.‡Llévale el Ojo de los vigías al Dr. Hieronymus Blam a El Final de Agmond en las Tierras Inhóspitas.‡Llévale el Ojo de los vigías al Dr. Hieronymus Blam a El Final de Agmond en las Tierras Inhóspitas.‡Apportez l\'Œil des Gardiens au Dr Hieronymus Blam à la Fin d\'Agmond, dans les Terres Ingrates.‡将守护者之眼带回荒芜之地的阿戈莫德的营地，交给耶柔米·布拉姆博士。‡將看守者之眼帶去荒蕪之地的埃格蒙德的營地給海洛馬斯·碰啪博士。',
  }
},
[27889] = {
  {
    'Nova Karrath‡Новый Каргат‡Neu-Kargath‡신 카르가스‡Nuevo Kargath‡Nuevo Kargath‡Nouvelle-Kargath‡新卡加斯‡新卡加斯',
    nil,
    'Leve o Ovo de Dragão Negro Purificado para Rhea, em Nova Karrath, que fica nos Ermos.‡Отнесите очищенное от скверны яйцо черного дракона Реа в Новый Каргат в Бесплодных землях.‡Bringt das geläuterte Schwarzdrachenei zu Rhea in Neu-Kargath im Ödland.‡황야의 땅, 신 카르가스에 있는 레아에게 정화된 검은용 알을 가져가야 합니다.‡Llévale el huevo de dragón Negro purificado a Rhea a Nuevo Kargath, en las Tierras Inhóspitas.‡Llévale el huevo de dragón negro purificado a Rhea a Nuevo Kargath, en las Tierras Inhóspitas.‡Apportez l\'Œuf purifié de dragon noir à Rhea à Nouvelle-Kargath, dans les Terres Ingrates.‡将净化过的黑龙卵交给荒芜之地巨龙峡口的瑞亚。‡將淨化過的黑龍蛋帶到荒蕪之地的新卡加斯交給莉雅。',
  }
},
[27890] = {
  {
    'Os cachorros maus‡Плохие парни‡Die harten Hunde‡나쁜 녀석들‡Los perros malos‡Los perros malos‡Les chiens méchants‡恶狗团‡壞傢伙們',
    nil,
    'Fale com Amakkar em Nova Karrath, que fica nos Ermos.‡Поговорите с Амаккаром в Новом Каргате в Бесплодных землях.‡Sprecht mit Amakkar in Neu-Kargath im Ödland.‡황야의 땅의 신 카르가스에 있는 아마카르와 대화해야 합니다.‡Habla con Amakkar en Nuevo Kargath, en las Tierras Inhóspitas.‡Habla con Amakkar en Nuevo Kargath, en las Tierras Inhóspitas.‡Parlez à Amakkar à Nouvelle-Kargath, dans les Terres Ingrates.‡跟荒芜之地新卡加斯的阿玛卡尔谈一谈。‡在荒蕪之地的新卡加斯同阿瑪卡談話。',
  }
},
[27891] = {
  {
    'Amakkar, o coringa‡Амаккар, мастер на все руки‡Amakkar, der Alleskönner‡팔방미인 아마카르‡Amakkar, el manitas‡Amakkar, el manitas‡Amakkar le touche-à-tout‡全能的阿玛卡尔‡樣樣通的阿瑪卡',
    nil,
    'Use o Golpe no Rim de Amakkar e a Poção de Bolso de Amakkar.‡Испытайте удар Амаккара по почкам и карманное зелье Амаккара.‡Benutzt \'Amakkars Nierenhieb\' und \'Amakkars Taschentrank\'.‡아마카르의 급소 가격과 주머니 물약을 사용해야 합니다.‡Utiliza el Golpe en los riñones de Amakkar y la poción de bolsillo de Amakkar.‡Utiliza el Golpe en los riñones de Amakkar y la poción de bolsillo de Amakkar.‡Utilisez le Coup dans les reins d\'Amakkar et la Potion de poche d\'Amakkar.‡使用阿玛卡尔的肾击和 阿玛卡尔的随身药水。‡使用阿瑪卡的腎擊和阿瑪卡的口袋藥水。',
  }
},
[27892] = {
  {
    'Jurrix, o Atacante‡Джаррикс-истребитель‡Jurrix der Vollstrecker‡공격대장 주릭스‡Jurrix el Ígneo‡Jurrix el Ígneo‡Jurrix le frappeur‡主攻手朱里克斯‡『打擊者』朱瑞克斯',
    nil,
    'Use o Impacto Abrasador de Jurrix e a Distorção Temporal de Jurrix.‡Испытайте огневую вспышку Джаррикса и искажение времени Джаррикса.‡Benutzt \'Jurrix\' Feuerstoß\' und \'Jurrix\' Zeitverschiebung\'.‡주릭스의 불타는 돌풍과 시간 왜곡을 사용해야 합니다.‡Usa la Explosión ígnea de Jurrix y la Distorsión temporal de Jurrix.‡Usa la Explosión ígnea de Jurrix y la Distorsión temporal de Jurrix.‡Utilisez le Trait ardent de Jurrix et la Distortion temporelle de Jurrix.‡使用朱里克斯的火焰冲击和朱里克斯的时间扭曲。‡使用朱瑞克斯的烈焰衝擊和朱瑞克斯的時間扭曲。',
  }
},
[27893] = {
  {
    'Gargal, o beemote‡Гаргал-чудище‡Gargal, das Ungetüm‡거인 가르갈‡Gargal, el Behemoth‡Gargal, el Behemoth‡Gargal, le béhémoth‡大块头加戈尔‡巨獸加戈爾',
    nil,
    'Use a Muralha de Escudos do Gargal e Brado Potente do Gargal.‡Испытайте осадный щит Гаргала и могучий рев Гаргала.‡Benutzt \'Gargals Schildwall\' und \'Gargals mächtiger Ruf\'.‡가르갈의 방패의 벽과 가르갈의 강력한 외침을 사용해야 합니다.‡Usa el Muro de escudo de Gargal y el Grito poderoso de Gargal.‡Usa el Muro de escudo de Gargal y el Grito poderoso de Gargal.‡Utilisez le Pavois de Gargal et le Cri de puissance de Gargal.‡使用加戈尔的盾墙和加戈尔的无畏咆哮。‡使用加戈爾的盾牆和加戈爾的強力怒吼。',
  }
},
[27894] = {
  {
    'A ira de uma Revoada‡Поход на дракона‡Der Zorn eines Drachenschwarms‡용군단의 분노‡La ira del Vuelo‡La ira del Vuelo‡La fureur du vol‡龙群之怒‡龍群之怒',
    nil,
    'Mate Kalaran, o Aniquilador, e 4 Soldados Velonero.‡Одолейте Каларана Уничтожителя и четверых солдат Летящей Тьмы.‡Tötet Kalaran den Vernichter und 4 Soldaten des dunklen Schwarms.‡파멸자 칼라란과 암흑군단 병사 4마리를 처치해야 합니다.‡Mata a Kalaran el Aniquilador y a 4 soldados Huida oscura.‡Mata a Kalaran el Aniquilador y a 4 soldados Huida oscura.‡Tuez Kalaran l\'Annihilateur et 4 Soldats sombrevol.‡杀死歼灭者卡拉然和4个暗翔士兵。‡殺死『殲滅者』卡拉然和4名暗翔士兵。',
  }
},
[27895] = {
  {
    'A caçada continua‡Охота продолжается!‡Die Jagd geht weiter‡끈질긴 추적‡Su caza continúa‡Su caza continúa‡Leur traque continue‡永无止尽的搜寻‡狩獵繼續',
    nil,
    'Vença o General Jirakka, Moldarr e 6 Dragomorfos da Revoada Negra.‡Одолейте генерала Жиракку, Молдарра и 6 черных драконоидов.‡Besiegt General Jirakka, Moldarr und 6 Mitglieder der Drachenbrut des dunklen Schwarms.‡장군 지라카, 몰다르, 암흑군단 화염칼날 6마리를 처치해야 합니다.‡Derrota al general Jirakka, a Moldarr y a 6 dragauros de la Huida oscura.‡Derrota al general Jirakka, a Moldarr y a 6 dragauros de la Huida oscura.‡Terrassez le Général Jirakka, Moldarr et 6 Draconides noirs.‡击败基拉卡将军、莫达尔以及6只黑龙。‡擊敗基拉卡將軍、摩達爾和6名暗翔龍人。',
  }
},
[27896] = {
  {
    'A tristeza e a fúria‡Печаль и гнев‡Das Leid und der Zorn‡슬픔과 분노‡La pena y la ira‡La pena y la ira‡Le chagrin et la fureur‡悲痛与愤怒‡悲傷與狂怒',
    nil,
    'Mate Nyxondra e 12 Filhotes de Nyxondra.‡Убейте Никсондру и 12 ее детенышей.‡Erschlagt Nyxondra und 12 von Nyxondras Brutlingen.‡닉손드라와 닉손드라의 새끼용 12마리를 처치해야 합니다.‡Mata a Nyxondra y a 12 estirpes de Nyxondra.‡Mata a Nyxondra y a 12 estirpes de Nyxondra.‡Tuez Nyxondra et 12 Rejetons de Nyxondra.‡杀死尼希昂卓拉和12条尼希昂卓拉雏龙。‡殺死妮克松德拉和12條妮克松德拉小龍。',
  }
},
[27897] = {
  {
    'O Ninho Escondido‡Потайная кладка‡Das Versteckte Gelege‡숨겨진 손아귀‡La Guarida Oculta‡La Guarida Oculta‡La Couvée cachée‡隐藏的龙巢‡隱秘窩巢',
    nil,
    'Fale com Rhea no Ninho Escondido, que fica nos Ermos.‡Поговорите с Реей у Потайной кладки в Бесплодных землях.‡Sprecht mit Rhea im Versteckten Gelege im Ödland.‡황야의 땅, 숨겨진 손아귀에 있는 레아와 대화해야 합니다.‡Habla con Rhea en la Guarida Oculta, en las Tierras Inhóspitas.‡Habla con Rhea en la Guarida Oculta, en las Tierras Inhóspitas.‡Parlez avec Rhea à la Couvée cachée dans les Terres ingrates.‡与荒芜之地隐藏的龙巢的瑞亚交谈。‡到荒蕪之地的隱秘窩巢和莉雅談話。',
  }
},
[27898] = {
  {
    'O presente de Rheastrasza‡Дар Реастразы‡Rheastraszas Geschenk‡레아스트라자의 선물‡El regalo de Rheastrasza‡El regalo de Rheastrasza‡Le cadeau de Rheastrasza‡瑞亚丝塔萨的礼物‡莉雅史卓莎的禮物',
    nil,
    'Espere enquanto Rhea recupera o ovo do Ninho Escondido.‡Подождите, пока Реа достанет яйцо из Потайной кладки.‡Wartet, während Rhea das Ei aus dem Versteckten Gelege holt.‡레아가 숨겨진 손아귀에서 알을 되찾아올 때까지 기다려야 합니다.‡Espera mientras Rhea recupera el huevo de la Guarida Oculta.‡Espera mientras Rhea recupera el huevo de la Guarida Oculta.‡Patientez pendant que Rhea récupère l\'œuf à la Couvée cachée.‡等待瑞亚从隐藏的龙巢中把蛋拿回来。‡等待莉雅從隱秘窩巢取回龍蛋。',
  }
},
[27899] = {
  {
    'Aquele brilho nos olhos‡Глаза горят, мозг кипит...‡Das Leuchten in seinen Augen‡반짝이던 눈빛‡Ese brillo en sus ojos‡Ese brillo en sus ojos‡Cette lueur dans les yeux‡他眼里的光芒‡他眼中的光芒',
    nil,
    'Fale com Harrison Jones no Obelisco do Sol.‡Поговорите с Харрисоном Джонсом у Обелиска Солнца.‡Sprecht mit Harrison Jones am Obelisk der Sonne.‡해의 방첨탑에 있는 해리슨 존스와 대화해야 합니다.‡Habla con: Harrison Jones. Zona: Obelisco del Sol.‡Habla con: Harrison Jones. Zona: Obelisco del Sol.‡Allez voir Harrison Jones à l\'Obélisque du Soleil.‡跟太阳方尖碑的哈里森·琼斯谈一谈。‡在日陽方尖碑和哈里遜‧瓊斯談話。',
  }
},
[27900] = {
  {
    'Deixe esse cara comigo‡С одним я справлюсь‡Mit dem Kerl werde ich fertig‡이 친구는 내가 맡겠소‡Yo me encargo de este tipo‡Yo me encargo de este tipo‡Laissez-le-moi !‡我得对付这家伙‡我來搞定這傢伙',
    nil,
    'Mate 10 Soldados Aéreos de Schnottz.‡Убейте 10 воздушных пехотинцев Шнотца.‡Tötet 10 Lufteinheiten von Schnottz.‡슈노츠 공중 돌격병 10명을 처치해야 합니다.‡Mata a 10 soldados de aire Schnottz.‡Mata a 10 soldados de aire Schnottz.‡Tuez 10 Troupiers de la force aérienne de Schnottz.‡杀掉10名司克诺兹空降步兵。‡消滅10個舒諾茲空軍裝甲兵。',
  }
},
[27901] = {
  {
    'Eles não sabem o que têm aqui‡Они даже не знают, что это такое‡Sie wissen nicht, was sie hier haben‡똥인지 된장인지도 모르고‡No saben lo que tienen aquí‡No saben lo que tienen aquí‡Ils ne savent pas ce qu\'ils ont‡他们不知道手里拿着什么‡他們不明白他們拿到什麼',
    nil,
    'Crie o Dispositivo de Ativação Titânico.‡Соберите активирующее устройство титанов.‡Baut das Aktivierungsgerät der Titanen zusammen.‡티탄 활성화 장치를 만들어야 합니다.‡Crea el dispositivo de activación titánico.‡Crea el dispositivo de activación titánico.‡Créez le Mécanisme d\'activation des titans.‡制作泰坦激活设备。‡製造泰坦啟動裝置。',
  }
},
[27902] = {
  {
    'A Fonte Clara‡Чистый источник‡Der Reinquell‡맑은샘‡El Manantial‡El Manantial‡La source Pure‡纯粹之泉‡純淨泉水',
    nil,
    'Colete 6 Grânulos de Fonte Clara dos Elementais da Fonte Clara.‡Соберите 6 частиц духов Чистого источника.‡Sammelt 6 Reinquellpartikel von Reinquellelementaren.‡맑은샘 정령으로부터 맑은샘 티끌 6개를 모아야 합니다.‡Reúne 6 motas de Manantial de los elementales de Manantial.‡Reúne 6 motas de Manantial de los elementales de Manantial.‡Récupérez 6 Granules de la source Pure sur des Élémentaires de la source Pure.‡从纯粹之泉元素身上收集6份纯粹之泉微粒。‡在純淨泉水元素收集6個純淨泉水微粒。',
  }
},
[27903] = {
  {
    'Ignição‡Зажигание‡Zündung‡점화‡La llave de contacto‡La llave de contacto‡Contact !‡点火‡點火',
    nil,
    'Recupere a Lente do Sol.‡Раздобудьте линзу солнца.‡Besorgt die Linse der Sonne.‡태양 렌즈를 회수해야 합니다.‡Recupera la lente del Sol.‡Recupera la lente del Sol.‡Retrouvez la Lentille du Soleil.‡拿到烈日之镜。‡取回日陽透鏡。',
  }
},
[27904] = {
  {
    'Sopro enevoado‡Дуновение тумана‡Nebelatem‡안개의 숨결‡Un soplo de bruma‡Un soplo de bruma‡Un souffle de brume‡迷雾的呼吸‡迷霧之息',
    nil,
    'Colete 5 Cristais Fumegantes de Diabretes Fumegantes.‡Добудьте 5 туманных кристаллов туманных греллей.‡Beschafft 5 rauchgraue Kristalle von Nebelgrellen.‡안개 그렐에게서 희뿌연 수정 5개를 모아야 합니다.‡Reúne 5 cristales humeantes de los grells brumosos.‡Reúne 5 cristales humeantes de los grells brumosos.‡Récoltez 5 Cristaux brumeux sur des Grells brumeux.‡从迷雾劣魔身上收集5颗烟尘水晶。‡從迷霧劣魔身上收集6個沒有光澤的水晶。',
  }
},
[27905] = {
  {
    'Artilheiro de cauda!‡Стрелок хвостовой пушки‡Heckschütze!‡후미포 발사!‡¡Armacola!‡¡Armacola!‡Mitrailleur de queue !‡机尾炮手！‡機尾槍手!',
    nil,
    'Use a torreta de cauda para defender o Bombardeiro de Schnottz.‡С помощью хвостовой пушки защищайтесь от бомбистов Шнотца.‡Benutzt das Heckgeschütz, um den Bomber von Schnottz zu verteidigen.‡후미포를 사용하여 슈노츠 폭격기를 방어해야 합니다.‡Usa el armacola para defender al bombardero de Schnottz.‡Usa el armacola para defender al bombardero de Schnottz.‡Utilisez le Canon arrière pour défendre le Bombardier de Schnottz.‡使用追踪炮来保护司克诺兹轰炸机。‡使用機尾槍防禦舒諾茲轟炸機。',
  }
},
[27906] = {
  {
    'Nika Cicatriz-de-sangue‡Ника Алый Шрам‡Neeka Blutnarbe‡니카 블러드스카‡Neeka Marca de Sangre‡Neeka Marca de Sangre‡Neeka Balafre-sanglante‡尼卡·血痕‡尼卡·血痕',
    nil,
    'Fale com Nika Cicatriz-de-sangue no Entroncamento da Lança Lascada.‡Поговорите с Никой Алый Шрам у Развилки Расщепленного Копья.‡Sprecht mit Neeka Blutnarbe an der Splitterspeerkreuzung.‡부러진창 교차로에 있는 니카 블러드스카와 대화해야 합니다.‡Habla con Neeka Marca de Sangre en el Cruce Lanzarrota.‡Habla con Neeka Marca de Sangre en el Cruce Lanzarrota.‡Parlez avec Neeka Balafre-sanglante au Croisement de Lance-brisée‡跟断矛路口的尼卡·血痕谈一谈。‡到斷矛路口與尼卡·血痕談話。',
  }
},
[27907] = {
  {
    'Florrogo‡Молитвоцвет‡Gebetsblume‡기원의 꽃‡Flor de plegaria‡Flor de plegaria‡La chapelette‡祝祷之花‡祈花',
    nil,
    'Colete 10 brotos de Florrogo do Lodaçal Mutante.‡Принесите 10 побегов молитвоцвета из Ползучей трясины.‡Sammelt 10 Zweige der Gebetsblume im Wabersumpf.‡변화의 늪에서 기원의 꽃 10송이를 모아야 합니다.‡Recoge 10 ramos de flor de plegaria del Lodo Traicionero.‡Recoge 10 ramos de flor de plegaria del Lodo Traicionero.‡Récoltez 10 brins de Chapelette dans le Bourbier Changeant.‡从流沙泥潭收集10株祝祷之花。‡到流沙泥潭收集10枝祈花。',
  }
},
[27908] = {
  {
    'Segredos do lodo‡Тайны Ползучей трясины‡Die Geheimnisse des Sumpfes‡늪의 비밀‡Los secretos del lodo‡Los secretos del lodo‡Les secrets du bourbier‡泥潭的秘密‡污泥的秘密',
    nil,
    'Colete 10 amostras de Lodo Revigorado de Globântanos Cambiantes.‡Соберите 10 образцов укрепляющего ила в Ползучей трясине.‡Sammelt 10 Exemplare kräftigen Schlicks von Wabersumpfklumpen.‡변화의 진흙덩어리로부터 생기로운 침적토 10개를 모아야 합니다.‡Recoge 10 muestras de cieno vigorizado de pegotes de lodo traicionero.‡Recoge 10 muestras de cieno vigorizado de pegotes de lodo traicionero.‡Récupérez 10 Échantillons de vase vivifiée sur des Globules de bourbier changeants.‡从移动的潭泥身上收集10份充满活力的淤泥样本。‡到流沙泥潭收集10個充滿活力的淤泥樣本。',
  }
},
[27909] = {
  {
    'A Fonte Clara‡Чистый источник‡Der Reinquell‡맑은샘‡El Manantial‡El Manantial‡La source Pure‡纯粹之泉‡純淨泉水',
    nil,
    'Colete 8 Partículas de Fonte Clara dos Elementais da Fonte Clara.‡Раздобудьте 8 частиц духов Чистого источника.‡Sammelt 8 Reinquellpartikel von Reinquellelementaren.‡맑은샘 정령으로부터 맑은샘 티끌 6개를 모아야 합니다.‡Recoge 8 motas de Manantial de los elementales de Manantial.‡Recoge 8 motas de Manantial de los elementales de Manantial.‡Récupérez 8 Granules de la source Pure sur des Élémentaires de la source Pure.‡从纯粹之泉元素身上收集8份纯粹之泉微粒。‡從純淨泉水元素那裡收集8個純淨泉水微粒。',
  }
},
[27910] = {
  {
    'Arrependimentos derradeiros‡Сожаления об ушедшем‡Späte Reue‡마지막 미련‡El último lamento‡El último lamento‡Derniers regrets‡最后的遗憾‡最後的悔意',
    nil,
    'Extraia a pele do Dente-de-sombra.‡Добудьте шкуру Сумеречного Клыка.‡Besorgt Dämmerfangs Balg.‡그늘송곳니 가죽을 획득해야 합니다.‡Obtén el pellejo de Fauceumbría.‡Obtén el pellejo de Fauceumbría.‡Récupérez la peau de Croc-du-couchant.‡获得暮牙的皮。‡收集暮牙的皮。',
  }
},
[27911] = {
  {
    'O último suspiro‡На последнем издыхании‡Der letzte Atemzug‡최후의 숨결‡Su último aliento‡Su último aliento‡Dans un dernier souffle‡最后一口气‡瀕死之息',
    nil,
    'Testemunhe os últimos momentos de Helgrum.‡Останьтесь рядом с Хелгрумом в его последние минуты.‡Begleitet Helgrums letzte Momente auf Erden.‡헬그럼이 숨을 거두는 순간을 지켜봐야 합니다.‡Presencia los últimos momentos de Helgrum.‡Presencia los últimos momentos de Helgrum.‡Assistez aux derniers instants de Helgrum.‡见证赫格拉姆的最后一刻。‡見證赫格拉姆的最後一刻。',
  }
},
[27912] = {
  {
    'O tesouro dos titãs‡Сокровище титанов‡Der Schatz der Titanen‡티탄의 귀중품‡El tesoro de los titanes‡El tesoro de los titanes‡Le trésor des Titans‡泰坦的宝藏‡泰坦的珍寶',
    nil,
    'Investigue o Tesouro dos Observadores.‡Осмотрите сокровище стражей.‡Untersucht den Schatz der Behüter.‡감시자의 귀중품을 조사해야 합니다.‡Inspecciona el tesoro de los Vigías.‡Inspecciona el tesoro de los Vigías.‡Examinez le Trésor des Gardiens‡调查守护者的宝藏。‡調查看守者的珍寶。',
  }
},
[27913] = {
  {
    'O tesouro dos titãs‡Сокровище титанов‡Der Schatz der Titanen‡티탄의 귀중품‡El tesoro de los titanes‡El tesoro de los titanes‡Le trésor des Titans‡泰坦的宝藏‡泰坦的珍寶',
    nil,
    'Investigue o Tesouro dos Observadores.‡Осмотрите сокровище стражей.‡Untersucht den Schatz der Behüter.‡감시자의 귀중품을 조사해야 합니다.‡Inspecciona el tesoro de los Vigías.‡Inspecciona el tesoro de los Vigías.‡Examinez le Trésor des Gardiens‡调查守护者的宝藏。‡調查看守者的珍寶。',
  }
},
[27914] = {
  {
    'Bênção da revoada verde‡Благословение рода зеленых драконов‡Der Segen des Grünen Drachenschwarms‡녹색용군단의 축복‡La bendición del Vuelo Verde‡La bendición del Vuelo Verde‡La bénédiction du Vol draconique vert‡绿龙军团的祝福‡綠龍軍團的祝福',
    nil,
    'Fale com Lorde Itharius no topo do templo de Atal\'Hakkar.‡Поговорите с лордом Итаром у входа в храм Атал\'Хаккара.‡Sprecht mit Lord Itharius an der Spitze des Tempels von Atal\'Hakkar.‡아탈학카르 신전의 꼭대기에 있는 군주 이타리우스와 대화해야 합니다.‡Habla con Lord Itharius en lo alto del Templo de Atal\'Hakkar.‡Habla con Lord Itharius en lo alto del Templo de Atal\'Hakkar.‡Allez voir le Seigneur Itharius, au sommet du Temple d\'Atal\'Hakkar.‡跟阿塔哈卡神庙顶部的伊萨里奥斯勋爵谈一谈。‡和在阿塔哈卡神廟上的伊薩里奧斯領主談話。',
  }
},
[27915] = {
  {
    'O coração do templo‡Сердце храма‡Das Herz des Tempels‡신전의 심장부‡El corazón del templo‡El corazón del templo‡Le cœur du temple‡神庙之心‡神廟之心',
    nil,
    'Fale novamente com Lorde Itharius dentro do templo de Atal\'Hakkar.‡Обратитесь снова к лорду Итару в храме Атал\'Хаккара.‡Sprecht im Inneren des Tempels von Atal\'Hakkar erneut mit Lord Itharius.‡아탈학카르 신전 안에서 군주 이타리우스와 다시 한 번 대화해야 합니다.‡Habla con Lord Itharius de nuevo dentro del Templo de Atal\'Hakkar.‡Habla con Lord Itharius de nuevo dentro del Templo de Atal\'Hakkar.‡Parlez au Seigneur Itharius, à l\'intérieur du Temple d\'Atal\'Hakkar.‡跟阿塔哈卡神庙里的伊萨里奥斯勋爵谈一谈。‡再次到阿塔哈卡神廟裡與伊薩里奧斯領主談話。',
  }
},
[27916] = {
  {
    'O relatório de Ruag‡Отчет Руага‡Ruags Bericht‡루아그의 보고서‡El informe de Ruag‡El informe de Ruag‡Le rapport de Ruag‡鲁尔格的报告‡盧爾格的報告',
    nil,
    'Entregue o Relatório da Lança Lascada ao Comandante de Expedição Ruag no Pedregal.‡Доставьте рапорт Расщепленного Копья командиру разведотряда Руагу в Каменор.‡Überbringt Zentralenkommandant Ruag in Steinard den Splitterspeerbericht.‡스토나드에 있는 파견사령관 루아그에게 부러진창 보고서를 전달해야 합니다.‡Entrega el informe de Lanzarrota al comandante de envíos Ruag, en Rocal.‡Entrega el informe de Lanzarrota al comandante de envíos Ruag, en Rocal.‡Portez le Rapport de Lance-brisée au Commandant d\'ordonnance Ruag, à Pierrêche.‡将断矛报告交给斯通纳德的分队指挥官鲁尔格。‡將斷矛報告送去斯通納德，交給分隊指揮官盧爾格。',
  }
},
[27917] = {
  {
    'O cheiro do inimigo‡Я чую их за милю‡Erschnüffelt sie‡냄새의 흔적‡Olisqueando‡Olisqueando‡Avoir du flair‡闻风而动‡嗅出他們的所在',
    nil,
    'Mate o Barão Ashbury.‡Убейте барона Эшбери.‡Tötet Baron Ashbury.‡남작 애쉬버리를 처치해야 합니다.‡Mata al barón Ashbury.‡Mata al barón Ashbury.‡Tuez le Baron Ashbury.‡击败灰葬男爵。‡殺死艾胥柏利男爵。',
  }
},
[27918] = {
  {
    'O Refúgio‡Убежище‡Der Sichere Hafen‡피난처‡El Puerto‡El Puerto‡Le havre Boueux‡避难营‡避難營',
    nil,
    'Entregue os Cristais de Draenetista ao Anacoreta Avuun.‡Отнесите кристаллы дренетиста Анахорету Авууну.‡Bringt die Draenethystkristalle zu Anachoret Avuun.‡수도사 아분에게 드레니시스트 수정을 전달해야 합니다.‡Entrega los cristales draenetistas al anacoreta Avuun.‡Entrega los cristales draenetistas al anacoreta Avuun.‡Livrez les Cristaux de draenéthyste à l\'Anachorète Avuun.‡将德莱尼水晶送给学者阿弗恩。‡將德萊尼水晶送去給隱士艾弗恩。',
  }
},
[27919] = {
  {
    'Rumo à Barreira do Inferno‡Вперед, к Выжженным землям!‡Weiter in die Verwüsteten Lande‡저주받은 땅으로‡A las Tierras Devastadas‡A las Tierras Devastadas‡En route pour les terres Foudroyées‡前往诅咒之地‡前往詛咒之地',
    nil,
    'Viaje à Barreira do Inferno e fale com Elomara Cervaforte na Bastilha de Etergarde.‡Отправляйтесь в Выжженные земли и поговорите с Енохой Громовар в крепости Стражей Пустоты.‡Reist in die Verwüsteten Lande und sprecht mit Enohar Donnerbräu in Burg Nethergarde.‡저주받은 땅의 네더가드 요새에 있는 에노하르 썬더브루와 대화해야 합니다,‡Viaja a las Tierras Devastadas y habla con Enohar Cebatruenos en el Castillo de Nethergarde.‡Viaja a las Tierras Devastadas y habla con Enohar Cebatruenos en el Castillo de Nethergarde.‡Voyagez jusqu’aux Terres Foudroyées et allez voir Enohar Tonnebière, à Rempart-du-Néant.‡前往诅咒之地跟守望堡的恩诺哈尔·雷酒谈一谈。‡到詛咒之地的守望堡去跟恩諾哈爾·雷酒談話。',
  }
},
[27920] = {
  {
    'Armado até os dentes‡Вооруженные до зубов‡Bis an die Zähne bewaffnet‡이빨로 무장하여‡Blindado hasta los dientes‡Blindado hasta los dientes‡Armés jusqu\'aux dents‡武装到牙齿‡全副武裝',
    nil,
    'Mate o Barão Silverlaine e o Comandante Floraval.‡Убейте барона Сильверлейна и командира Спрингвейла.‡Tötet Baron Silberlein und Kommandant Grüntal.‡실버레인 남작과 사령관 스프링베일을 처치해야 합니다.‡Mata al barón Filargenta y al comandante Vallefont.‡Mata al barón Filargenta y al comandante Vallefont.‡Tuez le Baron d\'Argelaine et le Commandant Printeval.‡杀死席瓦莱恩男爵和指挥官斯普林瓦尔。‡殺死席瓦萊恩男爵和指揮官斯普林瓦爾。',
  }
},
[27921] = {
  {
    'Lutando com unhas e dentes‡Не на жизнь, а на смерть‡Mit Klauen und Zähnen‡죽기 아니면 까무러치기‡Con uñas y dientes‡Con uñas y dientes‡Se battre bec et ongles‡消灭爪牙‡用爪牙戰鬥',
    nil,
    'Mate o Lorde Walden.‡Убейте лорда Вальдена.‡Tötet Lord Walden.‡월든 경을 처치해야 합니다.‡Mata a Lord Walden.‡Mata a Lord Walden.‡Tuez le Seigneur Walden.‡杀死沃登勋爵。‡殺死瓦爾登領主。',
  }
},
[27922] = {
  {
    'Traidores!‡Предатели!‡Verräter!‡배신자들!‡¡Traidores!‡¡Traidores!‡Traîtres !‡叛徒！‡背叛者!',
    nil,
    'Esconda-se atrás da Planta de Neferset e descubra o Segredo dos Nefersets.‡Спрячьтесь за неферсетским папоротником и выведайте секрет Неферсета.‡Versteckt Euch hinter einem Wedel der Neferset und enthüllt das Geheimnis der Neferset.‡네페르세트 잎사귀 뒤에 숨어 네페르세트의 비밀을 알아내야 합니다.‡Escóndete tras la fronda Neferset y descubre el secreto Neferset.‡Escóndete tras la fronda Neferset y descubre el secreto Neferset.‡Cachez-vous derrière la Feuille de Neferset et dévoilez le Secret de Neferset.‡藏在尼斐塞特之叶后面，揭开尼斐塞特的秘密。‡躲在奈斐賽特之葉後面並揭發奈斐賽特的秘密。',
  }
},
[27923] = {
  {
    'Fumaça nos olhos dos outros é refresco‡Дым, застилающий глаза‡Rauch in ihren Augen‡눈 따가운 연기‡Humo en los ojos‡Humo en los ojos‡De la fumée dans leurs yeux‡熏他们的眼‡用煙燻他們的眼睛',
    nil,
    'Queime Fardos de Feno dentro da Cidade Perdida dos Tol\'vir em Uldum.‡Подожгите стога сена в Затерянном городе Тол\'вире в Ульдуме.‡Verbrennt Heuhaufen in der Verlorenen Stadt der Tol\'vir in Uldum.‡울둠 톨비르의 잃어버린 도시에서 건초 묶음에 불을 붙여야 합니다.‡Quema montones de heno en el interior de la Ciudad Perdida de los Tol\'vir, en Uldum.‡Quema montones de heno en el interior de la Ciudad Perdida de los Tol\'vir, en Uldum.‡Brûlez des Meules de foin dans la Cité perdue des Tol\'vir en Uldum.‡在奥丹姆的托维尔失落之城中烧毁干草堆。‡到奧丹姆的托維爾的失落之城裡頭點燃乾草堆。',
  }
},
[27924] = {
  {
    'O plano de Bino‡План Бадда‡Budds Plan‡버드의 계획‡El plan de Budd‡El plan de Budd‡Le plan de Budd‡巴德的计划‡霸德的計畫',
    nil,
    'Recolha 6 partes de Armaduras de Nerfeset.‡Добудьте 6 частей брони Неферсета.‡Besorgt 6 Rüstungen der Neferset.‡네페르세트 갑옷 6조각을 입수해야 합니다.‡Consigue 6 piezas de armadura Neferset.‡Consigue 6 piezas de armadura Neferset.‡Obtenez 6 pièces d\'Armure de Neferset.‡获得6件尼斐塞特护甲。‡取得6片奈斐賽特護甲。',
  }
},
[27925] = {
  {
    'Efficient Excavations‡"Эффективные раскопки"‡Effiziente Ausgrabungen‡능률 발굴‡Excavaciones fructíferas‡Excavaciones fructíferas‡Des fouilles efficaces‡高效挖掘技巧‡有效率的挖掘行動',
    nil,
    'Bring \'Efficient Excavations\' to Belloc Brightblade in Schnottz\'s Landing.‡Принесите "Эффективные раскопки" Беллоку Сияющему Клинку в лагерь Шнотца.‡Bringt \'Effiziente Ausgrabungen\' zu Bellok Leuchtklinge in Schnottz\' Landeplatz.‡슈노츠 비행기지에 있는 벨록 브라이트블레이드에게 "능률 발굴"을 가져가야 합니다.‡Lleva \'Excavaciones fructíferas\' a Belloc Hoja Brillante en el Embarcadero de Schnottz.‡Lleva \'Excavaciones fructíferas\' a Belloc Hoja Brillante en el Embarcadero de Schnottz.‡Apportez le manuel intitulé « Fouilles efficaces » à Belloc Brillelame à l\'Accostage de Schnottz.‡把《高效挖掘技巧》交给司克诺兹登陆点的贝洛克·辉刃。‡將「有效率的挖掘法」帶去舒諾茲營地給貝洛克‧亮刃。',
  }
},
[27926] = {
  {
    'Hospitalidade do leste‡Восточное гостеприимство‡Gastfreundschaft des Ostens‡만남의 광장‡Hospitalidad oriental‡Hospitalidad oriental‡Une hospitalité orientale‡东方好客‡東方的待客之道',
    nil,
    'Belloc Gumélion quer que você se misture com os convidados no Porto de Schnottz.‡Беллок Сияющий Клинок предлагает вам пообщаться с гостями лагеря Шнотца.‡Bellok Leuchtklinge möchte, dass Ihr Euch unter die Gäste in Schnottz\' Landeplatz mischt.‡벨록 브라이트블레이드가 슈노츠 비행기지에서 손님들과 어울려 달라고 했습니다.‡Belloc Hoja Brillante quiere que te mezcles con los invitados en el Embarcadero de Schnottz.‡Belloc Hoja Brillante quiere que te mezcles con los invitados en el Embarcadero de Schnottz.‡Belloc Brillelame veut que vous rejoigniez les invités présents à l\'Accostage de Schnottz.‡贝洛克·辉刃要你同司克诺兹登陆点的客人们打成一片。‡貝洛克·亮刃要你結識舒諾茲營地的其他賓客。',
  }
},
[27927] = {
  {
    'Até a cicatriz‡Погружение в бездну‡Hinunter zur Narbe‡흉터를 향하여‡A la cicatriz‡A la cicatriz‡À la balafre‡进入灭世者之痕‡碎界者之痕',
    nil,
    'Encontre Theldurin, o Perdido, na Cicatriz do Quebramundo, que fica nos Ermos.‡Отыщите Тельдарина Заблудшего в Разломе разрушителя миров в Бесплодных землях.‡Findet Theldurin den Verirrten nahe der Narbe des Weltenbrechers im Ödland.‡황야의 땅에 있는 세계파괴자의 흉터에서 실성한 텔두린을 찾아야 합니다.‡Encuentra a Theldurin el Perdido en la Cicatriz del Rompemundos, en las Tierras Inhóspitas.‡Encuentra a Theldurin el Perdido en la Cicatriz del Rompemundos, en las Tierras Inhóspitas.‡Trouvez Theldurin l\'Egaré à la Balafre du Brise-monde dans les Terres Ingrates.‡在荒芜之地的灭世者之痕寻找迷失者塞尔杜林。‡到荒蕪之地裡的碎界者之痕找『迷失者』塞爾杜林。',
  }
},
[27928] = {
  {
    'Um favor para o peleiro‡С мехом по жизни‡Feines für den Fellhändler‡모피 전문가의 환심 사기‡Un favor para el camarada peletero‡Un favor para el camarada peletero‡Une faveur pour le fourreur‡皮货商的最爱‡款待毛皮商',
    nil,
    'Colete 5 Pelegos de Coiote do Deserto.‡Раздобудьте 5 шкур пустынного койота.‡Erbeutet 5 Felle eines Wüstenkoyoten.‡사막코요테 모피 5개를 모아야 합니다.‡Reúne 5 pelambres de coyote de desierto.‡Reúne 5 pelambres de coyote de desierto.‡Récupérez 5 Fourrures de coyote du désert.‡收集5张沙漠土狼毛皮‡收集5張沙漠山狗毛皮。',
  }
},
[27929] = {
  {
    'Arraste-os para o inferno‡Сначала сбить, потом прибить‡Holt sie \'runter‡놈들을 끌어내려라‡Hazlos caer‡Hazlos caer‡Mayday ! Mayday !‡拉他们下鸟‡把他們拖下來',
    nil,
    'Use o Gancho Farpado para derrubar e matar 4 Cavalga-grifos de Trondamar.‡Убейте 4 наездников Громтара, предварительно сбросив их на землю с помощью шипастого крюка для плоти.‡Benutzt den gestachelten Fleischerhaken, um 4 Donnermar-Greifenreiter von ihren Reittieren zu holen und tötet sie dann.‡미늘박힌 살덩이고리를 이용해 썬더마 그리핀 기수 4명을 끌어내리고 처치해야 합니다.‡Usa el enganchacarnes con púas para desmontar a 4 jinetes de grifos de Bramal y mátalos.‡Usa el enganchacarnes con púas para desmontar y matar a 4 jinetes de grifos de Bramal.‡Utilisez le Crochet à chair barbelé pour désarçonner et tuer 4 Chevaucheurs de griffons de Tonnemar.‡使用尖利的肉钩击落4名桑德玛尔狮鹫骑手，并将其击败。‡使用倒刺血肉鉤拉落並殺死4名桑德瑪獅鷲騎士。',
  }
},
[27930] = {
  {
    'Devastação‡Сокрушение‡Verwüstung‡유린‡Devastación‡Devastación‡Dévastation‡毁灭‡毀滅',
    nil,
    'Procure Rheastrasza.‡Найдите Реастразу.‡Sucht nach Rheastrasza.‡레아스트라자를 찾아야 합니다.‡Busca a Rheastrasza.‡Busca a Rheastrasza.‡Cherchez Rheastrasza.‡寻找瑞亚丝塔萨。‡搜尋莉雅史卓莎。',
  }
},
[27931] = {
  {
    'Os campos sísmicos‡Грот Обвалов‡Die Bebenden Felder‡전율하는 들판‡Los Campos Convulsos‡Los Campos Convulsos‡Les fonds Tremblants‡地震旷野‡破碎曠野',
    nil,
    'Fale com o Ardósio Movediço nos Campos Sísmicos, que fica no Geodomo.‡Поговорите со Сланцем Плывуном в Гроте Обвалов в Подземье.‡Sprecht mit Schiefer Treibsand auf den Bebenden Feldern in Tiefenheim.‡심원의 영지의 전율하는 들판에 있는 슬레이트 퀵샌드와 대화해야 합니다.‡Habla con Pizarra Arenamovediza en Los Campos Convulsos en Infralar.‡Habla con Pizarra Arenamovediza en Los Campos Convulsos en Infralar.‡Allez voir Ardoise Sable-mouvant aux Fonds Tremblants, dans le Tréfonds.‡与深岩之洲地震旷野的斯雷特·流沙谈一谈。‡在地深之源的破碎曠野和史雷特‧流沙談話。',
  }
},
[27932] = {
  {
    'O machado da mutilação terrena‡Топор раскола земли‡Die Axt der irdischen Trennung‡대지 가름 도끼‡El hacha de hendimiento terrestre‡El hacha de hendimiento terrestre‡La hache de la fracture terrestre‡裂地之斧‡裂地之斧',
    nil,
    'Mate 5 Colossos Esmeralda Mutilados.‡Убейте 5 потрескавшихся изумрудных колоссов.‡Tötet 5 gespaltene Smaragdkolosse.‡작아진 에메랄드 거대괴수 5마리를 처치해야 합니다.‡Asesina a 5 colosos esmeralda hendidos.‡Asesina a 5 colosos esmeralda hendidos.‡Tuez 5 Colosses d’émeraude scindés.‡消灭5名碎裂的翡翠巨人。‡殺死5個碎裂的翡翠巨像。',
  }
},
[27933] = {
  {
    'Minério elemental‡Элементиевая руда‡Elementarerz‡원소 광석‡Mineral elemental‡Mena elemental‡Le minerai élémentaire‡元素矿砂‡源質礦石',
    nil,
    'Colete 6 pepitas de Minério Elemental.‡Соберите 6 кусков элементиевой руды.‡Sammelt 6 Elementarerze.‡원소 광석 6개를 수집해야 합니다.‡Recoge 6 menas elementales.‡Recoge 6 menas elementales.‡Récupérez 6 pépites de Minerai élémentaire.‡收集6份元素矿砂。‡收集6份源質礦石。',
  }
},
[27934] = {
  {
    'Uno com a terra‡Единое целое с землей‡Eins mit der Erde‡대지와 하나 되기‡Uno con el suelo‡Uno con el suelo‡Le lien terrestre‡合二为一‡與大地合而為一',
    nil,
    'Complete o ritual Uno com a Terra.‡Завершите ритуал единения с землей.‡Beendet das \'Eins mit der Erde\'-Ritual.‡대지와 하나 되기 의식을 완료해야 합니다.‡Completa el ritual Uno con el suelo.‡Completa el ritual Uno con el suelo.‡Terminez le Rituel de lien terrestre.‡完成合二为一仪式。‡完成與大地結合的儀式。',
  }
},
[27935] = {
  {
    'Detendo a avalanche‡Победить Лавиниона‡Die Lawine ins Rollen bringen‡아발란치온 처치‡Acaba con la avalancha‡Acaba con la avalancha‡Déclenchez l\'avalanche !‡山崩地裂‡打倒阿瓦蘭奇奧',
    nil,
    'Mate Avalanchion.‡Убейте Лавиниона.‡Tötet Lavinius.‡아발란치온을 처치해야 합니다.‡Asesina a Avalanchion.‡Asesina a Avalanchion.‡Tuez Avalanchion.‡杀死阿瓦兰奇奥。‡殺死阿瓦蘭奇奧。',
  }
},
[27936] = {
  {
    'Detendo a avalanche‡Победить Лавиниона‡Die Lawine ins Rollen bringen‡아발란치온 처치‡Acaba con la avalancha‡Acaba con la avalancha‡Déclenchez l\'avalanche !‡山崩地裂‡打倒阿瓦蘭奇奧',
    nil,
    'Mate Avalanchion.‡Убейте Лавиниона.‡Tötet Lavinius.‡아발란치온을 처치해야 합니다.‡Asesina a Avalanchion.‡Asesina a Avalanchion.‡Tuez Avalanchion.‡杀死阿瓦兰奇奥。‡殺死阿瓦蘭奇奧。',
  }
},
[27937] = {
  {
    'Retorno heroico‡Возвращение героя‡Der Held kehrt zurück‡영웅의 귀환‡El regreso del héroe‡El regreso del héroe‡Le retour du héros‡英雄归来‡英雄歸來',
    nil,
    'Apresente-se perante o Petrarca Rochamanto no Larpétreo, que fica no Geodomo.‡Явитесь к Отцу-Скале Железной Мантии в Каменный очаг, что в Подземье.‡Stellt Euch bei Steinvater Erzmantel in Steinruh in Tiefenheim vor.‡심원의 영지의 돌난로에 있는 바위 아버지 오어맨틀에게 가야 합니다.‡Preséntate ante el Padre Pétreo Mantomena en el Hogar Pétreo en Infralar.‡Preséntate ante el Padre Pétreo Mantomena en el Hogar Pétreo en Infralar.‡Présentez-vous au Père-Roc Mantemine à Âtrepierre, dans le Tréfonds.‡觐见深岩之洲巨石之炉的石父岩幔。‡到地深之源的石爐見石父礦被。',
  }
},
[27938] = {
  {
    'O fragmento central‡Центральный фрагмент‡Das mittlere Fragment‡중간 파편‡El fragmento central‡El fragmento central‡Le second fragment‡中部碎片‡中段碎片',
    nil,
    'Recupere o Fragmento Central do Pilar do Mundo.‡Найдите центральный фрагмент столпа мира.‡Bringt das mittlere Fragment der Weltensäule in Euren Besitz.‡세계 기둥 중간 파편을 회수해야 합니다.‡Recupera el fragmento central del Pilar del Mundo.‡Recupera el fragmento central del Pilar del Mundo.‡Récupérez le Second fragment du pilier du monde.‡拿到世界之柱中部碎片。‡取得世界之柱的中段碎片。',
  }
},
[27939] = {
  {
    'A raposa do deserto‡Пустынная лиса‡Der Wüstenfuchs‡사막여우‡El zorro del desierto‡El zorro del desierto‡Le renard du désert‡沙漠之狐‡沙漠之狐',
    nil,
    'Schnottz quer que você leve a Raposa do Deserto para ele.‡Шнотц желает, чтобы вы раздобыли ему пустынную лису.‡Schnottz will, dass Ihr ihm den Wüstenfuchs bringt.‡슈노츠에게 사막여우를 가져가야 합니다.‡Schnottz quiere que le lleves el zorro del desierto.‡Schnottz quiere que le lleves el zorro del desierto.‡Schnottz veut que vous lui rapportiez le Renard du désert.‡司克诺兹要你把沙漠之狐给他带去。‡舒諾茲要你將沙漠狐帶給他。',
  }
},
[27940] = {
  {
    'Pássaros imundos‡Грязные пташки‡Schmutzige Vögel‡더러운 새‡Sucios pájaros‡Sucios pájaros‡De sales oiseaux‡肮脏的鸟‡骯髒的鳥',
    nil,
    'Você deve matar 8 Abutres Doentes.‡Перебейте 8 больных падальщиков.‡Ihr sollt 8 kranke Geier töten.‡병에 걸린 독수리 8마리를 처치해야 합니다.‡Tienes que asesinar a 8 buitres malsanos.‡Tienes que asesinar a 8 buitres malsanos.‡Vous devez tuer 8 Vautours malades.‡你要杀掉8只染病的兀鹫。‡你必須殺死8隻染病的禿鷹。',
  }
},
[27941] = {
  {
    'Moda utilitária‡Дресс-код‡Modeismus‡패션중심주의‡Moda uniforme‡Moda uniforme‡Uniformode‡时髦主义‡時尚主義',
    nil,
    'Belloc Gumélion quer que você colete 10 Uniformes de Soldados.‡Беллок Сияющий Клинок просит вас собрать 10 комплектов военной формы.‡Bellok Leuchtklinge möchte, dass Ihr 10 Gardistenuniformen aufsammelt.‡돌격병 제복 10벌을 모아야 합니다.‡Belloc Hoja Brillante quiere que reúnas 10 uniformes de soldado.‡Belloc Hoja Brillante quiere que reúnas 10 uniformes de soldado.‡Belloc Brillelame veut que vous récupériez 10 Uniformes de troupier.‡贝洛克·辉刃要你收集10件步兵制服。‡貝洛克·亮刃要你收集10套裝甲兵制服。',
  }
},
[27942] = {
  {
    'Idolatria‡Идолотерапия‡Götzendienst‡우상 숭배‡Idolatría‡Idolatría‡Idolâtrie‡偶像崇拜‡塑像崇拜',
    nil,
    'O Comandante Schnottz quer que você colete 8 Ídolos Bem Preservados.‡Принесите командиру Шнотцу 8 хорошо сохранившихся идолов.‡Kommandant Schnottz möchte, dass Ihr 8 gut erhaltene Götzen einsammelt.‡잘 보존된 우상 8개를 모아야 합니다.‡El comandante Schnottz quiere que reúnas 8 ídolos bien conservados.‡El comandante Schnottz quiere que reúnas 8 ídolos bien conservados.‡Le Commandant Schnottz veut que vous récupériez 8 Idoles en bon état.‡元首司克诺兹要你收集8尊保存完好的神像。‡指揮官舒諾茲要你收集8個保存良好的塑像。',
  }
},
[27943] = {
  {
    'Espíritos enfurecidos‡Разгневанные духи‡Verärgerte Geister‡분노한 정령‡Espíritus iracundos‡Espíritus iracundos‡Des esprits en colère‡愤怒的鬼魂‡動怒的靈魂',
    nil,
    'O Comandante Schnottz quer que você use o C.A.P.L. para coletar 5 Essências Espectrais Furiosas.‡Командир Шнотц велит вам с помощью ЛППУ добыть 5 экстрактов взбешенного призрака.‡Kommandant Schnottz möchte, dass Ihr die L.P.B.K. benutzt und 5 wütende spektrale Essenzen einsammelt.‡특허받은 양자 가속장치 대포를 사용하여 사나운 혼령의 정수 5개를 모아야 합니다.‡El comandante Schnottz quiere que uses el L.P.A.C. para reunir 5 esencias espectrales furiosas.‡El comandante Schnottz quiere que uses el L.P.A.C. para reunir 5 esencias espectrales furiosas.‡Le Commandant Schnottz veut que vous utilisiez le C.A.P.B. pour récupérer 5 Essences spectrales furieuses.‡元首司克诺兹要你用特许质子加速炮收集5份狂怒幽魂精华。‡指揮官舒諾茲要你使用L.P.A.C.收集5個狂怒鬼靈精華。',
  }
},
[27944] = {
  {
    'Terrível contra as aranhas‡Очищение леса‡Ausdünnen der Brut‡거미 퇴치‡Reducir sus efectivos‡Reducir sus efectivos‡Une petite décimation‡削减蜘蛛的数量‡削減蛛群',
    nil,
    'Mate 12 Espreitadoras Lenhanegra em Lenhanegra. A floresta Lenhanegra fica a oeste daqui, do outro lado da ponte, na ilha central.‡Убейте 12 скрытней Мрачного леса. Мрачный лес находится за мостом, к западу отсюда, в центральной части острова.‡Tötet 12 Dunkelwaldlauerer im Finsterwald. Der Finsterwald liegt direkt westlich von hier, jenseits der Brücke auf der mittleren Insel.‡어둠숲에서 어둠숲 은신거미 12마리를 처치해야 합니다. 어둠숲은 다리를 건너 서쪽의 중앙 섬에 있습니다.‡Mata a 12 rondadores Leñoscuro en Leñoscuro. El bosque Leñoscuro se encuentra al oeste de aquí, al otro lado del puente de la isla central.‡Mata a 12 rondadores Leñoscuro en Leñoscuro. El bosque Leñoscuro se encuentra al oeste de aquí, al otro lado del puente de la isla central.‡Tuez 12 Rôdeuses de Sombrebois, au Sombrebois. Cette forêt se trouve à l’ouest, juste après le pont de l’île centrale.‡在黑暗森林杀死12名黑暗森林潜伏者。黑暗森林位于此地以西，穿过岛屿中心的桥梁就到。‡到暗木森林中去殺死12隻暗木蜘蛛。暗木森林就在西邊，越過橋往島嶼中心走。',
  }
},
[27945] = {
  {
    'Diamante preto‡Закрасить черным‡Schwarzmalerei‡검게 물든 심장‡Píntalo de negro‡Píntalo de negro‡Noir c\'est noir‡纯黑的石之心‡烏漆嘛黑',
    nil,
    'Adquira um Coração de Diamante Preto.‡Добудьте черное алмазное сердце.‡Besorgt ein schwarzes Diamantherz.‡검은 다이아몬드 심장을 획득해야 합니다.‡Consigue un corazón de diamante negro.‡Consigue un corazón de diamante negro.‡Obtenez un Cœur de diamant noir.‡取回一块黑钻之心。‡取得黑鑽石之心。',
  }
},
[27946] = {
  {
    'NYI‡NYI‡NYI‡미적용‡NYI‡NYI‡NYI‡NYI‡NYI',
    nil,
    nil,
  }
},
[27947] = {
  {
    'Visão do Crepúsculo‡Видение Сумерек‡Eine Vision des Zwielichts‡황혼의 시야‡Una visión crepuscular‡Una visión crepuscular‡Une vision crépusculaire‡暮光的幻象‡暮光的幻象',
    nil,
    'Localize um Olho do Crepúsculo na Lacuna Negra.‡Найдите Око Сумерек в Черном разломе.‡Spürt ein Auge des Zwielichts in dem Schwarzen Riss auf.‡검은 틈에 있는 황혼의 눈을 찾아야 합니다.‡Encuentra un Ojo del Crepúsculo en la Brecha Negra.‡Encuentra un Ojo del Crepúsculo en la Brecha Negra.‡Trouvez un Œil du Crépuscule dans la Brèche Noire.‡在黑色裂口寻找暮光之眼。‡在黑色裂層內找到一個暮光之眼。',
  }
},
[27948] = {
  {
    'Uma tarefa pegajosa‡Липкая работа‡Eine klebrige Angelegenheit‡끈끈한 임무‡Una tarea pegajosa‡Una tarea pegajosa‡Un boulot gluant‡粘糊糊的任务‡黏答答任務',
    nil,
    'Colete 4 Glândulas de Seda Pegajosa das Prolemadres Lenhanegra. A floresta Lenhanegra fica a oeste daqui, do outro lado da ponte, na ilha central.‡Соберите 4 липких паутинных железы праматерей Мрачного леса. Чтобы попасть в лес, находящийся в центральной части острова, пересеките мост к западу от лагеря.‡Sammelt 4 klebrige Seidendrüsen von Finsterwaldbrutmutterspinnen im Finsterwald. Der Finsterwald liegt westlich von hier, über die Brücke hinweg, auf der zentralen Insel.‡어둠숲에 있는 어둠숲 여왕거미로부터 끈끈한 명주실 분비선 4개를 획득해야 합니다. 어둠숲은 서쪽으로 다리를 건너 중앙 섬에 있습니다.‡Reúne 4 glándulas de seda pegajosas de las madres de linaje Leñoscuro en Leñoscuro. El bosque Leñoscuro está al oeste, al otro lado del puente en la isla central.‡Reúne 4 glándulas de seda pegajosas de las madres de linaje Leñoscuro en Leñoscuro. El bosque Leñoscuro está al oeste, al otro lado del puente en la isla central.‡Récupérez 4 Glandes à soie gluantes sur les Mères des couvées de Sombrebois, au Sombrebois. Ce bois se trouve à l’ouest, juste après le pont de l’île centrale.‡从黑暗森林的黑暗森林蛛母身上收集4个粘性丝囊。黑暗森林位于此地以西，穿过岛屿中心的桥梁就到。‡到暗木森林去從暗木森林育母身上收集4個粘絲腺體。暗木森林就在西邊，越過橋往島嶼中心走。',
  }
},
[27949] = {
  {
    'Os esquecidos‡Позабытые‡Die Vergessenen‡잊어버린 전우‡Los olvidados‡Los olvidados‡Les Oubliés‡被遗忘的灵魂‡遺民',
    nil,
    'Liberte os espíritos de 6 Almas Torturadas na Colina Esquecida. As almas são canalizadas ao se tocar as lápides com as mãos. A Colina Esquecida fica a oeste daqui, depois de Lenhanegra e do Front Incansável.‡Освободите 6 истерзанных душ на Забытом холме. Душу можно высвободить, дотронувшись до могильного камня. Забытый холм расположен к западу отсюда, за Мрачным лесом и Передовой Неупокоенных.‡Schenkt den Geistern von 6 gequälten Seelen die Freiheit am Vergessenen Hügel. Die Seelen können kanalisiert werden, indem Ihr mit den Händen die Grabsteine berührt. Der Vergessene Hügel liegt direkt westlich von hier, vorbei am Finsterwald und der Rastlosen Front.‡잊어버린 언덕에서 고통받는 영혼을 자유롭게 해야 합니다. 묘비에 손을 대면 영혼을 불러낼 수 있습니다. 잊어버린 언덕은 바라딘 주둔지의 서쪽으로 어둠숲과 안식 없는 전초지를 지나면 찾을 수 있습니다.‡Libera los espíritus de 6 almas torturadas en la Colina del Olvido. Puedes canalizar las almas tocando las lápidas directamente con la mano. Las Colinas del Olvido están al oeste de aquí, más allá de Leñoscuro y del Frente Inquieto.‡Libera los espíritus de 6 almas torturadas en la Colina del Olvido. Puedes canalizar las almas tocando las lápidas directamente con la mano. La Colina del Olvido está al oeste de aquí, más allá de Leñoscuro y del Frente Inquieto.‡Libérez l’esprit de 6 âmes torturées à la Colline Oubliée. Pour libérer une âme, il suffit de poser la main directement sur une pierre tombale. La colline est à l’ouest, au-delà de Sombrebois et du Front Sans-Repos.‡在遗忘山丘释放6名被折磨的灵魂。用手直接触摸墓碑，即可引导灵魂。遗忘山丘位于正西方，穿过黑暗森林和不眠前线就是了。‡到遺忘之丘去解放6個受折磨的靈魂。你可以藉由直接觸碰墓碑來引導靈魂。遺忘之丘在西方，就在越過暗木森林與無寧前線之後。',
  }
},
[27950] = {
  {
    'Gluglu!‡Кулдык!‡Gubbel!‡고블스!‡¡Gluber!‡¡Gluber!‡Gloubbels !‡哥培尔！‡咯咯!',
    nil,
    'Schnottz quer que você fale com ele quando você estiver preparada para testemunhar o ritual.‡Шнотц хочет, чтобы вы поговорили с ним, когда будете готовы узреть ритуал.‡Schnottz möchte, dass Ihr ihn ansprecht, wenn Ihr bereit seid, dem Ritual beizuwohnen.‡의식을 참관할 준비가 되면 슈노츠와 대화해야 합니다.‡Schnottz quiere que hables con él cuando estés lista para presenciar el ritual.‡Schnottz quiere que hables con él cuando estés lista para presenciar el ritual.‡Schnottz veut que vous veniez lui parler, une fois que vous serez prête à assister au rituel.‡当你做好见证仪式的准备后就跟元首司克诺兹谈一谈。‡舒諾茲要你在準備好觀看儀式後，和他說話。',
  }
},
[27951] = {
  {
    'Todos devemos nos sacrificar‡Порой приходится чем-то жертвовать‡Wir müssen alle Opfer bringen‡힘에는 희생이 따르는 법‡Todos tenemos que sacrificarnos‡Todos tenemos que sacrificarnos‡Un sacrifice nécessaire‡献祭总是必须的‡我們都要被獻祭',
    nil,
    'Mate 10 Xamãs das Trevas.‡Убейте 10 черных шаманов.‡Tötet 10 Schamanen der Schwärze.‡검은 틈 주술사 10명을 처치해야 합니다.‡Mata a 10 chamanes de lo Oscuro.‡Mata a 10 chamanes de lo Oscuro.‡Tuez 10 Chamans du Noir.‡击败10名漆黑萨满。‡殺死10名黑色薩滿。',
  }
},
[27952] = {
  {
    'Os Exploradores‡Исследователи‡Die Forscher‡탐험가들‡Los exploradores‡Los exploradores‡Les explorateurs‡探险者们‡探險者協會',
    nil,
    'Fale com a Exploradora Mowi no Templo da Terra, que fica no Geodomo.‡Поговорите с исследовательницей Мови в Храме Земли в Подземье.‡Sprecht mit Entdeckerin Mowi im Tempel der Erde in Tiefenheim.‡심원의 영지의 대지의 사원에 있는 탐험가 모위와 대화해야 합니다.‡Habla con la exploradora Mowi en el Templo de la Tierra en Infralar.‡Habla con la exploradora Mowi en el Templo de la Tierra en Infralar.‡Allez voir l\'Exploratrice Mowi au Temple de la Terre, dans le Tréfonds.‡跟深岩之洲大地神殿的探险者莫维谈一谈。‡到地深之源的大地神殿同探險者摩維談話。',
  }
},
[27953] = {
  {
    'O Relicário‡Реликварий‡Die Archäologische Akademie‡성물회‡El Relicario‡El Relicario‡Le reliquaire‡神圣遗物学会‡聖匣守護者',
    nil,
    'Fale com o Avaliador Ruibarbo no Templo da Terra, que fica no Geodomo.‡Поговорите с исследователем Роу в Храме Земли в Подземье.‡Sprecht mit Prüfer Rowe im Tempel der Erde in Tiefenheim.‡심원의 영지의 대지의 사원에 있는 검사관 로우와 대화해야 합니다.‡Habla con el examinador Rowe en el Templo de la Tierra en Infralar.‡Habla con el examinador Rowe en el Templo de la Tierra en Infralar.‡Allez voir l\'Examinateur Rowe au Temple de la Terre, dans le Tréfonds.‡跟深岩之洲大地神殿的考察者罗威谈一谈。‡到地深之源的大地神殿同審查人洛威談話。',
  }
},
[27954] = {
  {
    'O que os olhos veem‡Всевидящее Око‡Im Auge des Betrachters‡눈의 만족‡El truco está en los ojos‡El truco está en los ojos‡Le pouvoir d\'un regard‡洞察之眼‡眼睛',
    nil,
    'Leve o Olho do Crepúsculo para Garona Meiorken na Ravina de Sangue, que fica no Planalto do Crepúsculo.‡Отдайте Око Сумерек Гароне Полуорчихе в Кровавом ущелье на Сумеречном нагорье.‡Bringt das Auge des Zwielichts zu Garona der Halborcin in der Blutschlucht im Schattenhochland.‡황혼의 고원의 피투성이 협곡에 있는 가로나 하프오큰에게 황혼의 눈을 가져가야 합니다.‡Llévale el Ojo del Crepúsculo a Garona Semiorco en Garganta de Sangre, en las Tierras Altas Crepusculares.‡Llévale el Ojo del Crepúsculo a Garona Semiorco en Garganta de Sangre, en las Tierras Altas Crepusculares.‡Rapportez l\'Œil du Crépuscule à Garona Miorque au Goulet Sanglant, dans les Hautes-terres du Crépuscule.‡将暮光之眼交给暮光高地溅血谷地的半兽人迦罗娜。‡到暮光高地的鮮血峽谷將暮光之眼交給迦羅娜·半血。',
  }
},
[27955] = {
  {
    'O olho que tudo vê‡Глаз-шпион‡Ich sehe was, was Ihr nicht seht...‡눈 들여다보기‡Ojo espía‡Ojo espía‡Qui espionne qui ?‡窥视‡眼之間諜',
    nil,
    'Perscrute o Olho do Crepúsculo para Garona.‡Загляните в Око Сумерек.‡Blickt für Garona in das Auge des Zwielichts.‡가로나를 위해 황혼의 눈을 들여다보아야 합니다.‡Mira por el Ojo del Crepúsculo para Garona.‡Mira por el Ojo del Crepúsculo para Garona.‡Regardez dans l\'Œil du Crépuscule pour Garona.‡凝视暮光之眼。‡為迦羅娜仔細看著暮光之眼。',
  }
},
[27956] = {
  {
    'A tarefa do Lanque‡Задача Чурбана‡Lunks Aufgabe‡돌머리의 부탁‡La tarea de Ñoño‡La tarea de Ñoño‡En mission pour Benêt‡隆克的任务‡郎克的任務',
    nil,
    'Colete 15 Volantes de Motor Temperados dos Golens de Guerra Temperados.‡Получите 15 закаленных маховиков из закаленных боевых големов.‡Beschafft 15 gehärtete Schwungräder von ausgehärteten Kriegsgolems.‡단단한 전쟁 골렘으로부터 달궈진 정속바퀴 15개를 획득해야 합니다.‡Consigue 15 volantes templados de gólems de guerra templados.‡Consigue 15 volantes templados de gólems de guerra templados.‡Récupérez 15 Volants trempés sur des Golems de guerre trempés.‡从温和的作战傀儡身上获得15个调节过的飞轮。‡從溫和的戰爭魔像身上收集15個淬火飛輪。',
  }
},
[27957] = {
  {
    'Lanque não mata‡Чурбан не убивать‡Lunk nicht töten‡돌머리는 안 해쳐‡Ñoño no matar‡Ñoño no matar‡Benêt tue pas‡隆克不杀‡郎克不殺生',
    nil,
    nil,
  }
},
[27958] = {
  {
    'Um antídoto adequado‡Правильное противоядие‡Ein anständiges Gegengift‡적절한 해독제‡Un buen antídoto‡Un buen antídoto‡Un antivenin adéquat‡有效抗毒剂‡適當的解毒劑',
    nil,
    'Obtenha 14 amostras de Peçonha de Teia-de-vidro.‡Добудьте 14 порций яда стеклопутого паука.‡Beschafft Euch 14 Proben Glasnetzgift.‡유리그물거미 독액 14개를 채취해야 합니다.‡Consigue 14 muestras de veneno de Cristalderma.‡Consigue 14 muestras de veneno de Cristalderma.‡Procurez-vous 14 doses de Venin d’araignée verrière.‡获得14份晶网毒液的样本。‡取得14個晶網蜘蛛毒囊樣本。',
  }
},
[27959] = {
  {
    'A aventura do Lanque: o montador de aranhas‡Приключения Чурбана: верхом на пауках‡Lunks Abenteuer: Spinnenreiter‡돌머리의 모험‡La aventura de Ñoño: el jinete de arañas‡La aventura de Ñoño: el jinete de arañas‡L’aventure de Benêt : rodéo d’araignées‡隆克的冒险：蜘蛛骑士‡郎克的冒險:蜘蛛騎士',
    nil,
    'Enfraqueça 7 Aranhas Teia-de-vidro para que o Lanque possa montar nelas.‡Добейтесь того, чтобы 7 стеклопутных пауков ослабли и Чурбан смог покататься на них.‡Schwächt 7 Glasnetzspinnen, damit Lunk sie reiten kann.‡돌머리가 타고 돌아다닐 수 있도록 유리그물거미 7마리를 약화시켜야 합니다.‡Debilita a 7 arañas Cristaderma para que Ñoño pueda montar en ellas.‡Debilita a 7 arañas Cristaderma para que Ñoño pueda montar en ellas.‡Affaiblissez 7 Araignées verrières pour que Benêt puisse monter sur leur dos.‡削弱7只晶网蜘蛛以便隆克可以骑上它们。‡削弱7隻晶網蜘蛛好讓郎克騎上牠們。',
  }
},
[27960] = {
  {
    'Quanto menos, melhor‡Чем меньше, тем лучше‡Je weniger, desto besser‡적을수록 좋은 일‡Cuantos menos, mejor‡Cuantos menos, mejor‡Moins il y en a, mieux c’est‡越少越好‡愈少愈好',
    nil,
    'Mate 10 Geólogos ou Vigias dos Ferro Negro.‡Убейте 10 геологов или сторожей из клана Черного Железа.‡Tötet 10 Geologen der Dunkeleisenzwerge oder Wachmänner der Dunkeleisenzwerge.‡검은무쇠 지질학자 또는 보초 10명을 처치해야 합니다.‡Mata a 10 geólogos Hierro Negro o veladores Hierro Negro.‡Mata a 10 geólogos Hierro Negro o veladores Hierro Negro.‡Tuez 10 Géologues ou Veilleurs sombrefers.‡消灭10名黑铁地质学家或黑铁巡逻兵。‡殺死10名黑鐵地質學家或是黑鐵警備兵。',
  }
},
[27961] = {
  {
    'No lugar errado‡Не на своем месте‡Fehl am Platz‡웬 닭들이 이런 곳에...‡Fuera de lugar‡Fuera de lugar‡Les affres du déplacement‡格格不入‡不恰當',
    nil,
    'Salve 8 Frangos das Cinzas.‡Добудьте 8 пепельных цыплят.‡Beschafft Euch 8 Aschehühnchen.‡재투성이 닭 8마리를 획득해야 합니다.‡Consigue 8 pollos de ceniza.‡Consigue 8 pollos de ceniza.‡Obtenez 8 Poulets cendrés.‡获得8只燃灰小鸡。‡帶回8隻灰燼雞。',
  }
},
[27962] = {
  {
    'Uma relíquia desajeitada‡Рокочущие останки‡Vor der Schlucht‡꼴사나운 천둥도마뱀‡Una torpe reliquia‡Una torpe reliquia‡Une relique antédiluvienne‡在峡谷形成之前‡笨重的傳說',
    nil,
    'Obtenha o Chifre Gigante de Margol.‡Добудьте гигантский рог Маргульи.‡Erbeutet Margols gigantisches Horn.‡마르골의 거대한 뿔을 획득해야 합니다.‡Consigue el cuerno gigante de Margol.‡Consigue el cuerno gigante de Margol.‡Obtenez la Corne gigantesque de Margol.‡获得玛尔戈的巨角。‡取得瑪爾戈的巨角。',
  }
},
[27963] = {
  {
    'Um novo mestre... mas quem?‡Новый хозяин… Но кто?‡Ein neuer Meister... nur wer?‡새로운 지도자... 그렇지만 누구?‡Un nuevo amo... ¿pero quién?‡Un nuevo amo... ¿pero quién?‡Un nouveau maître… mais lequel ?‡一个新主人……是谁？‡新主人...誰呀?',
    nil,
    'Obtenha o Memorando dos Ferro Negro com Gravius Lameiro, no Local de Trabalho do Lameiro.‡Найдите Гравиуса Грязнулю на строительной площадке Грязнули и отберите у него докладную записку Черного Железа.‡Beschafft Euch die Dunkeleisennotiz von Gravius Rußschlack bei Rußschlacks Arbeitsstätte.‡검댕가루 작업현장에 있는 그라비우스 그라임실트에게서 검은무쇠 쪽지를 획득해야 합니다.‡Consigue el memorando Hierro Negro de Gravius Limugre en la Excavación de Limugre.‡Consigue el memorando Hierro Negro de Gravius Limugre en la Excavación de Limugre.‡Récupérez le Mémo sombrefer sur le cadavre de Gravius Crasseboue, au Site de fouilles de Crasseboue.‡从煤渣工地的格拉维斯·煤渣手中获得黑铁备忘录。‡到煤渣挖掘場從葛雷維斯‧煤渣身上取得黑鐵備忘錄。',
  }
},
[27964] = {
  {
    'Chefe-escavador Barbatrova‡Главный землекоп Звоноус‡Ausgrabungsboss Krawallschnäuzer‡채석장 두목 딘휘스커‡Jefe de excavación Mostachobulla‡Jefe de excavación Mostachobulla‡Chef des fouilles Boucchantes‡挖掘头目锡须‡挖掘老大喧鬚',
    nil,
    'Mate Escavadores Ferro Negro e Soldados Rasos Ferro Negro no Caldeirão até que o Chefe-escavador Barbatrova apareça. Então, mate o Chefe-escavador Barbatrova e obtenha a Brasa Negra dele.‡Отправляйтесь в Котлован и убивайте землечерпов и пехотинцев из клана Черного Железа до тех пор, пока не появится главный землекоп Звоноус. Затем убейте Звоноуса и заберите у него темный тлеющий уголь.‡Tötet Ausgräber und Fußsoldaten der Dunkeleisenzwerge im Kessel, bis Ausgrabungsboss Krawallschnäuzer erscheint. Dann tötet den Ausgrabungsboss Krawallschnäuzer und bringt seine Dunkelglut an Euch.‡용광로 안에서 채석장 두목 딘휘스커가 나타날 때까지 검은무쇠 발굴인부와 검은무쇠 보병을 처치해야 합니다. 그 후 딘휘스커가 나타나면 그를 처치하고 어두운 잿불을 획득하십시오.‡Mata a excavadores y lacayos Hierro Negro en la Caldera hasta que el Jefe de excavación Mostachobulla aparezca. Luego mata al Jefe de excavación Mostachobulla y consigue su ascua oscura.‡Mata a excavadores y lacayos Hierro Negro en la Caldera hasta que el Jefe de excavación Mostachobulla aparezca. Luego mata al Jefe de excavación Mostachobulla y consigue su ascua oscura.‡Tuez des Excavateurs et des Fantassins sombrefers dans le Chaudron, jusqu’à ce que le Chef des fouilles Boucchantes se montre. Ensuite, tuez-le et récupérez sa Sombre braise.‡杀死大熔炉里的黑铁挖掘者和黑铁步兵，直到挖掘头目锡须现身。然后杀掉挖掘头目锡须，拿到他的黑色烬石。‡在大熔爐殺死黑鐵挖掘者和黑鐵步卒，直到挖掘老大喧鬚出現。然後殺死挖掘老大喧鬚並取得他的黑暗餘燼。',
  }
},
[27965] = {
  {
    'Posto de Tório: a sede da Irmandade‡Лагерь Братства Тория: трон Братства‡Thoriumspitze: Der Sitz der Bruderschaft‡토륨 거점: 토륨 대장조합의 본거지‡Puesto del Torio: la sede de la Hermandad‡Puesto del Torio: la sede de la Hermandad‡La halte du Thorium : le siège de la confrérie‡瑟银哨塔：兄弟会的所在‡瑟銀哨塔:兄弟會之所在',
    nil,
    'Fale com o Feitor Mão-de-graxa no Posto de Tório, que fica na Garganta Abrasadora.‡Отправляйтесь с докладом к надзирателю Скользоруку в лагере Братства Тория, что в Тлеющем ущелье.‡Meldet Euch bei Aufseher Schlickfaust auf der Thoriumspitze in der Sengenden Schlucht.‡이글거리는 협곡의 토륨 거점에 있는 감독관 오일피스트에게 보고해야 합니다.‡Preséntate ante el sobrestante Puñaceite en el Puesto del Torio en la Garganta de Fuego.‡Preséntate ante el sobrestante Puñaceite en el Puesto del Torio en la Garganta de Fuego.‡Présentez-vous au Surveillant Huilepoing à la Halte du Thorium, dans la Gorge des Vents brûlants.‡去找灼热峡谷瑟银哨塔的奥菲斯特。‡到灼熱峽谷的瑟銀哨塔向監督者奧菲斯特回報。',
  }
},
[27966] = {
  {
    'Enterro dos ossos‡Спасение останков‡Bergt die Überreste‡유해 구조‡Recuperando los restos‡Recuperando los restos‡Un seul fémur vous manque...‡回收残骸‡收集肢體',
    nil,
    'Recupere 9 Fêmures Amaldiçoados dos carniçais que vagam na Colina Esquecida, que fica no oeste da ilha, pouco depois do Front Abandonado.‡От вас требуется собрать 9 проклятых бедренных костей вурдалаков, населяющих Забытый холм. Это место расположено на западной стороне острова за Передовой Неупокоенных.‡Ihr müsst 9 verfluchte Oberschenkelknochen von den Ghulen, die auf dem Vergessenen Hügel hausen, einsammeln. Der Vergessene Hügel befindet sich auf der westlichen Seite der Insel, direkt vorbei an der Vergessenen Front.‡잊어버린 언덕에 있는 구울로부터 저주 걸린 다리뼈 9개를 획득해야 합니다. 잊어버린 언덕은 섬 서쪽의 안식 없는 전초지를 지나 남쪽으로 가면 찾을 수 있습니다.‡Tienes que recoger 9 fémures malditos de los necrófagos que habitan la Colina del Olvido. La Colina del Olvido está en la zona oeste de la isla, pasado el Frente del Olvido.‡Tienes que recoger 9 fémures malditos de los necrófagos que habitan la Colina del Olvido. La Colina del Olvido está en la zona oeste de la isla, pasado el Frente del Olvido.‡Collectez 9 Fémurs maudits sur le cadavre des goules qui rôdent sur la Colline Oubliée. La colline se trouve à l’ouest de l’île, juste après le Front Sans-Repos.‡你要从居住在遗忘山丘的食尸鬼那里取回9根被诅咒腿骨。遗忘山丘位于岛屿西侧，穿过遗忘前线就是了。‡你得從居住在遺忘之丘的食屍鬼那裡取回9根受詛咒的腿骨。遺忘之丘在島嶼西方，就在越過無寧前線之後。',
  }
},
[27967] = {
  {
    'Primeiro-tenente Cunha‡Старший лейтенант Коннор‡Oberleutnant Connor‡부관 코너‡Teniente primero Connor‡Teniente primero Connor‡Le lieutenant Connor‡康纳中尉‡科諾爾中尉',
    nil,
    'Encontre e mate o Primeiro-tenente Cunha na Colina Esquecida. A Colina Esquecida fica no extremo oeste da ilha.‡Обнаружьте и убейте старшего лейтенанта Коннора на Забытом холме. Это место расположено в западной стороне острова.‡Findet und tötet Oberleutnant Connor auf dem Vergessenen Hügel. Ihr findet den Vergessenen Hügel auf der westlichen Seite der Insel.‡잊어버린 언덕에서 부관 코너를 찾아서 처치해야 합니다. 잊어버린 언덕은 섬의 가장 서쪽에 있습니다.‡Encuentra y mata al teniente primero Connor en la Colina del Olvido. Encontrarás la Colina del Olvido en el extremo occidental de la isla.‡Encuentra y mata al teniente primero Connor en la Colina del Olvido. Encontrarás la Colina del Olvido en el extremo occidental de la isla.‡Trouvez et tuez le Lieutenant Connor, à la Colline Oubliée. La colline se trouve à l’extrémité ouest de l’île.‡在遗忘山丘找到并杀死康纳中尉。遗忘山丘位于岛屿的极西侧。‡到遺忘之丘找出科諾爾中尉並殺了他。你會在遙遠的島嶼西邊找到遺忘之丘。',
  }
},
[27968] = {
  {
    'A fúria da matilha‡Ярость стаи‡Die Wut des Rudels‡무리의 분노‡La furia de la manada‡La furia de la manada‡La rage de vaincre‡狼群之怒‡狼群的憤怒',
    nil,
    'Mate o Lorde Godfrey.‡Убейте лорда Годфри.‡Tötet Lord Godfrey.‡고드프리 경을 처치해야 합니다.‡Mata a Lord Godfrey.‡Mata a Lord Godfrey.‡Tuez le Seigneur Godfrey.‡杀死高弗雷勋爵。‡殺死高佛雷領主。',
  }
},
[27969] = {
  {
    'Faça alguma coisa útil‡Займись чем-нибудь полезным‡Macht Euch nützlich‡쓸모 있는 사람이 되길‡Haz algo útil‡Haz algo útil‡Rendez-vous utile !‡派上用场‡當個有用的人',
    nil,
    'O Comandante Schnottz quer que você convença 6 Operários Ociosos a trabalhar.‡Командир Шнотц хочет, чтобы вы заставили 6 ленивых работников приняться за дело.‡Kommandant Schnottz möchte, dass Ihr 6 faulenzende Arbeiter davon überzeugt, wieder an die Arbeit zu gehen.‡게으른 일꾼 6명을 설득하여 다시 일터로 돌려보내야 합니다.‡El comandante Schnottz quiere que convenzas a 6 obreros gandules para que vuelvan al trabajo.‡El comandante Schnottz quiere que convenzas a 6 obreros gandules para que vuelvan al trabajo.‡Le Commandant Schnottz veut que vous persuadiez 6 Travailleurs paresseux de se remettre au travail.‡元首司克诺兹要你说服6名懈怠的劳工认真工作。‡指揮官舒諾茲要你說服6個偷懶的苦工回去工作。',
  }
},
[27970] = {
  {
    'Capitão P. Espargosa‡Капитан П. Харрис‡Kapitän P. Harris‡선장 P. 해리스‡Capitán P. Harris‡Capitán P. Harris‡Le capitaine P. Harris‡P·哈里斯船长‡哈利斯船長',
    nil,
    'Você recebeu ordens para matar o Capitão P. Espargosa no Cabo da Má Esperança, que fica a noroeste daqui, seguindo pela costa. Procure os navios naufragados.‡Вас просят убить капитана П. Харриса на мысе Потерянной Надежды. Мыс расположен к северо-западу, если идти вдоль береговой линии. Ищите обломки корабля.‡Ihr habt den Auftrag, Kapitän P. Harris am Kap der Verlorenen Hoffnung zu töten. Das Kap der Verlorenen Hoffnung liegt gleich nordwestlich von hier, die Küste entlang. Haltet einfach Ausschau nach den Schiffswracks.‡잃어버린 희망의 곶에서 선장 P. 해리스를 처치해야 합니다. 잃어버린 희망의 곶은 북서쪽 해안에 있습니다. 그냥 난파선을 찾으면 됩니다.‡Te han encargado que mates al Capitán P. Harris en el Cabo de la Esperanza Perdida. El Cabo de la Esperanza Perdida se encuentra al noroeste de aquí, a lo largo de la costa. Busca los restos de naufragio.‡Te han encargado que mates al Capitán P. Harris en el Cabo de la Esperanza Perdida. El Cabo de la Esperanza Perdida se encuentra al noroeste de aquí, a lo largo de la costa. Busca los restos de naufragio.‡Tuez le Capitaine P. Harris au Cap de l’Espoir perdu. Ce cap se situe au nord-ouest, le long de la côte. Vous saurez que vous êtes arrivée quand vous verrez des épaves.‡杀死失落希望海角的P·哈里斯船长。失落希望海角位于此地以西北的海边，找到船只残骸就是了。‡你接到在逝望角殺死哈利斯船長的任務。你可以在這裡西北邊的海岸旁來找到逝望角。只要搜尋船骸就可以看到了。',
  }
},
[27971] = {
  {
    'O navio dos mortos-vivos‡Раздробить косточки‡Stört ihre vorletzte Ruhe‡언데드 퇴치‡Golpear las jaulas‡Golpear las jaulas‡Qu’ils mordent le sable !‡激怒敌人‡激怒他們',
    nil,
    'O Comandante-de-campo Abreu pediu para você matar 8 Marinheiros Náufragos no Cabo da Má Esperança. O cabo fica a noroeste daqui, na praia.‡Начальник лагеря Брэк поручил вам уничтожить 8 моряков-утопленников на мысе Потерянной Надежды. Мыс расположен к северо-западу, если идти вдоль береговой линии.‡Lagerkommandant Brack hat Euch gebeten, am Kap der Verlorenen Hoffnung 8 schiffbrüchige Seemänner zu töten. Das Kap befindet sich nordwestlich von hier, am Strand.‡주둔지 행정관 브랙이 북서쪽 해안에 있는 잃어버린 희망의 곶에서 난파당한 선원 8명을 처치해 달라고 했습니다.‡El coordinador de avanzada Brack te ha pedido que mates a 8 marineros naufragados en el Cabo de la Esperanza Perdida. El cabo se encuentra al noroeste de aquí, en la playa.‡El coordinador de avanzada Brack te ha pedido que mates a 8 marineros naufragados en el Cabo de la Esperanza Perdida. El cabo se encuentra al noroeste de aquí, en la playa.‡Le coordinateur du camp Brack vous a demandé de tuer 8 Marins naufragés au Cap de l’Espoir perdu. Le cap se situe au nord-ouest d’ici, sur la plage.‡营地协调员巴拉克要你在失落希望海角杀死8名海难水手。失落希望海角位于此地西北的海边。‡營區軍官布拉克要你到逝望角殺死8個海難水手。逝望角就在這裡西北方的海灘。',
  }
},
[27972] = {
  {
    'Levantando o moral‡Поддержание боевого духа‡Stärkung der Moral‡사기 충전‡Elevar la moral‡Elevar la moral‡C’est bon pour le moral‡鼓舞士气‡激勵士氣',
    nil,
    'Você recebeu ordens para recuperar 6 Barris de Rum dos Mares do Sul nos navios naufragados no Cabo da Má Esperança. O cabo fica a norte daqui, seguindo pela costa.‡Вас попросили доставить 6 бочонков южноморского рома с кораблей, затонувших у мыса Потерянной Надежды. Мыс расположен севернее на береговой линии.‡Ihr habt den Auftrag erhalten, 6 Fässer mit Südmeerrum aus den Schiffswracks am Kap der Verlorenen Hoffnung zu beschaffen. Das Kap liegt nördlich von hier, entlang der Küste.‡북서쪽 해안에 있는 잃어버린 희망의 곶에서 남쪽바다 럼주통 6개를 모아야 합니다.‡Te han pedido que recuperes 6 barricas de ron de los Mares del Sur de los barcos naufragados en el Cabo de la Esperanza Perdida. El cabo se encuentra al norte de aquí, a lo largo de la costa.‡Te han pedido que recuperes 6 barricas de ron de los Mares del Sur de los barcos naufragados en el Cabo de la Esperanza Perdida. El cabo se encuentra al norte de aquí, a lo largo de la costa.‡Récupérez 6 Tonneaux de rhum des mers du Sud dans les épaves du Cap de l’Espoir perdu. Le cap se trouve au nord.‡从失落希望海角的船只残骸中取回6桶南海朗姆酒。失落希望海角位于此地以北的海边。‡你被要求要到逝望角去找6桶南海蘭姆酒。這個海角在北方的海岸邊。',
  }
},
[27973] = {
  {
    'Não ande descalço!‡Щепки летят!‡Achtung, Splitter‡유령 조심!‡¡Cuidado con las astillas!‡¡Cuidado con las astillas!‡Attention aux échardes !‡当心鬼魂！‡小心木刺!',
    nil,
    'O Sargento Dias pediu para você recolher 15 feixes de Lenha do Estaleiro no Estaleiro Bonfilho. A lenha pode ser recolhida do chão ou com os fantasmas. O estaleiro fica a noroeste daqui, na costa.‡Сержант Грей хочет, чтобы вы принесли 15 единиц лесоматериалов с Верфи Веллсона. Доски можно отнять у призраков, обитающих на верфи, или поднять с земли. Верфь находится на берегу к северо-западу отсюда.‡Bringt 15 Stücke Schiffsbauholz von Wellsons Werft zu Unteroffizier Grau. Das Holz wird von den Geistern in der Werft bewacht oder liegt frei zugänglich in der Werft verteilt. Die Werft ist an der Küste nordwestlich von hier.‡하사관 그레이가 서쪽 해안에 있는 웰슨 조선소에서 조선소 목재 15개를 가져다 달라고 했습니다. 목재는 조선소 곳곳에 쌓여 있고, 그곳의 유령에게서 얻을 수도 있습니다.‡El sargento Gray te ha pedido que recuperes 15 trozos de madera de astillero del Astillero de Wellson. La madera puede obtenerse de los fantasmas del astillero o tirada en las inmediaciones. El astillero se encuentra al noroeste de aquí, en la costa.‡El sargento Gray te ha pedido que recuperes 15 trozos de madera de astillero del Astillero de Wellson. La madera puede obtenerse de los fantasmas del astillero o tirada en las inmediaciones. El astillero se encuentra al noroeste de aquí, en la costa.‡Ramassez 15 pièces de Bois de coupe au chantier naval de Wellson pour le compte du sergent Gray. Vous trouverez du bois de coupe sur les fantômes qui rôdent dans le chantier naval, ou encore par terre. Le chantier naval se trouve au nord-ouest, sur la côte.‡格雷中士要你从维尔松船坞取回15片船坞木料。维尔松船坞位于此地西北方的海岸上，你可以从那里的鬼魂身上找到木料。‡葛雷中士要求你到維爾森船廠去取回15片船廠木材。你可以從船廠鬼魂的身上取得木材，或是在船廠各處撿到。船廠位於西北方的海岸邊。',
  }
},
[27974] = {
  {
    'Terra nostra‡Это наша земля‡Dies ist unser Land‡우리의 땅‡Esta tierra es nuestra tierra‡Esta tierra es nuestra tierra‡Cette terre nous appartient‡这是我们的土地‡這塊土地是我們的土地',
    nil,
    'Mate o Barão Ashbury.‡Убейте барона Эшбери.‡Tötet Baron Ashbury.‡남작 애쉬버리를 처치해야 합니다.‡Mata al barón Ashbury.‡Mata al barón Ashbury.‡Tuez le Baron Ashbury.‡击败灰葬男爵。‡殺死艾胥柏利男爵。',
  }
},
[27975] = {
  {
    'PROCURA-SE: encarregado Bonfilho‡Разыскивается: начальник верфи Веллсон‡GESUCHT: Vorarbeiter Wellson‡현상 수배: 현장감독 웰슨‡SE BUSCA: Supervisor Wellson‡SE BUSCA: Supervisor Wellson‡AVIS DE RECHERCHE : le contremaître Wellson‡通缉令：工头维尔松‡通緝:工頭維爾森',
    nil,
    'Mate o Encarregado Bonfilho no Estaleiro Bonfilho. O estaleiro fica a noroeste daqui, na costa oeste.‡Вам предстоит прикончить начальника верфи Веллсона. Верфь расположена к северо-западу отсюда, на западном побережье острова.‡Tötet Vorarbeiter Wellson in Wellsons Werft. Die Werft befindet sich nordwestlich von hier an der Westküste.‡웰슨 조선소에서 현장감독 웰슨을 처치해야 합니다. 조선소는 서쪽 해안에 있습니다.‡Mata al supervisor Wellson en el Astillero de Wellson. El astillero se encuentra al noroeste, en la costa oeste.‡Mata al supervisor Wellson en el Astillero de Wellson. El astillero se encuentra al noroeste, en la costa oeste.‡Tuez le Contremaître Wellson au Chantier naval de Wellson. Le chantier naval se trouve au nord-ouest d’ici, sur la côte occidentale.‡杀死维尔松船坞的工头维尔松。维尔松船坞位于此地西北方，就在西部的海岸上。‡到維爾森船廠去殺死工頭維爾森。船廠位於西北方，海岸的西邊。',
  }
},
[27976] = {
  {
    'Malditos dedos gordos‡Будь прокляты эти толстые пальцы‡Verdammt seien diese fetten Finger‡이놈의 손가락‡¡Malditos dedos gordos!‡¡Malditos dedos gordos!‡Maudits gros doigts‡都怪这些胖手指‡詛咒這些肥手指',
    nil,
    'Mate 12 Golens de Guerra Pesados.‡Убейте 12 тяжелых боевых големов.‡Tötet 12 schwere Kriegsgolems.‡육중한 전쟁 골렘 12마리를 처치해야 합니다.‡Mata a 12 gólems de guerra pesados.‡Mata a 12 gólems de guerra pesados.‡Tuez 12 Golems de guerre lourds.‡摧毁15座重型作战傀儡。‡殺死12個重型戰爭魔像。',
  }
},
[27977] = {
  {
    'Reconhecimento básico‡Самое важное‡Aufklärungsausstattung‡정찰의 정석‡Recuperar lo esencial‡Recuperar lo esencial‡Matos essentiel à la reco‡侦查必需品‡不可或缺的工具',
    nil,
    'Encontre e devolva o Alcaraviz de Ferraria e a Luneta do Espia.‡Найдите и верните фурму и подзорную трубу наблюдателя.‡Findet die Schmiedewindform und das Ausguckhandfernrohr und bringt sie zurück.‡가열로 바람구멍과 망꾼의 망원경을 찾아야 합니다.‡Encuentra y devuelve la tobera de herrería y el catalejo.‡Encuentra y devuelve la tobera de herrería y el catalejo.‡Trouvez et restituez la Tuyère de forge et la Longue-vue de guetteur.‡把冶炼鼓风机和侦查员的望远镜找到并带回来。‡找到並歸還冶煉鼓風機和偵察員的望遠鏡。',
  }
},
[27978] = {
  {
    'Caça-fantasmas‡Охота за привидениями‡Geisterjäger‡유령 잡는 얼라이언스‡Cazafantasmas‡Cazafantasmas‡SOS fantômes‡鬼魂毁灭者‡魔鬼剋星',
    nil,
    'Mate 14 fantasmas de qualquer tipo no Mirante do Largo, que fica a nordeste da base.‡Вам нужно убить 14 любых призраков на Дозорном пункте Ларго к северо-востоку от лагеря.‡Tötet 14 beliebige Geister bei Largos Warte, direkt nordöstlich des Basislagers.‡주둔지 북동쪽에 있는 라르고 전망대에서 유령 14마리를 처치해야 합니다.‡Mata a 14 fantasmas de cualquier tipo en el Alto de Largo, justo al noreste del campamento.‡Mata a 14 fantasmas de cualquier tipo en el Alto de Largo, justo al noreste del campamento.‡Tuer 14 fantômes de n’importe quel type au Surplomb de Largo, au nord-est du campement.‡前往营地东北的拉尔戈的瞭望台杀死任意14只鬼魂。‡到營地東北邊的拉爾戈瞰臺去殺死14個鬼魂。',
  }
},
[27979] = {
  {
    'Ministério negro‡Темное министерство‡Dunkle Dienste‡어둠의 대신들‡Ministerio oscuro‡Ministerio oscuro‡Culte occulte‡黑暗议会‡黑暗牧師',
    nil,
    'Obtenha a Esférula de Kiyuubi, a Esférula de Letherio e a Esférula de Finister. Feito isso, combine as três em uma Tripetricina do Crepúsculo.‡Добудьте шар Киюби, шар Летерио и шар Финистра, а затем объедините их в сумеречный триоцит.‡Beschafft Euch die Steinkügelchen von Kiyuubi, Letherio und Fiester. Setzt sie zu einem Zwielichttripetrizin zusammen.‡키유비, 레테리오, 그리고 피니스터의 소형구를 획득한 뒤 그것들을 합쳐 황혼의 삼중석을 만들어야 합니다.‡Consigue la esferilla de Kiyuubi, la esferilla de Letherio y la esferilla de Finister, luego combínalas en una tripeticina Crepuscular.‡Consigue la esferilla de Kiyuubi, la esferilla de Letherio y la esferilla de Finister, luego combínalas en una tripeticina Crepuscular.‡Obtenez la Sphérule de Kiyuubi, celle de Letherio et celle de Finister, puis combinez les trois pour former une Tripetricine du Crépuscule.‡获得奇乌比之球、莱萨里奥之球，以及芬尼斯特之球，将它们组成暮光三色宝珠。‡取得基優比的小球、雷瑟里歐的小球、以及菲尼斯特的小球，然後將它們結合成暮光三體石。',
  }
},
[27980] = {
  {
    'As aranhas têm que morrer‡Пауки должны уйти‡Die Spinnen müssen weg‡거미들은 없어져야만 해‡Las arañas tienen que desaparecer‡Las arañas tienen que desaparecer‡Les araignées doivent disparaître‡必须消灭蜘蛛‡蜘蛛得離開',
    nil,
    'Mate 9 Aranhas de Lava na Garganta Abrasadora.‡Убейте 9 лавовых пауков в Тлеющем ущелье.‡Erschlagt 9 Lavaspinnen in der Sengenden Schlucht.‡이글거리는 협곡에 있는 용암거미 9마리를 처치해야 합니다.‡Mata a 9 arañas de lava en La Garganta de Fuego.‡Mata a 9 arañas de lava en La Garganta de Fuego.‡Tuez 9 Araignées de lave dans la Gorge des Vents brûlants.‡杀死灼热峡谷的15只熔岩蜘蛛。‡在灼熱峽谷裡殺死9隻熔岩蜘蛛。',
  }
},
[27981] = {
  {
    'Um calor que não passa‡Непроходящий жар‡Hitze, die nie vergeht‡뜨거운 불이 필요해‡Calor incesante‡Calor incesante‡Une chaleur accablante‡强火不灭‡不滅之熱',
    nil,
    'Obtenha 10 Frascos da Fornalha Cheios. Você deve usar os Frascos da Fornalha em elementais vivos, dentro da Garganta Abrasadora.‡Соберите 10 наполненных огнеупорных колб. Вы должны наполнять огнеупорные колбы из живых элементалей в Тлеющем ущелье.‡Besorgt 10 gefüllte Ofenflaschen. Ihr müsst die Ofenflaschen bei lebendigen Elementaren in der Sengenden Schlucht benutzen.‡가득 찬 용광로 실험병 10개를 획득해야 합니다. 반드시 이글거리는 협곡 안의 살아 있는 정령들에게 용광로 실험병을 사용해야 합니다.‡Consigue 10 petacas de horno llenas. Tienes que usar las petacas de horno con elementales vivos en Las Garganta de Fuego.‡Consigue 10 petacas de horno llenas. Tienes que usar las petacas de horno con elementales vivos en Las Garganta de Fuego.‡Obtenez 10 Flacons de la fournaise remplis. Pour ce faire, utilisez les Flacons de la fournaise sur des élémentaires vivants de la Gorge des Vents brûlants.‡收集10个充焰锻炉烧瓶。你必须在灼热峡谷对活着的元素身上使用锻炉烧瓶。‡取得10個裝滿的燒瓶。你得將燒瓶使用在灼熱峽谷裡活著的元素身上。',
  }
},
[27982] = {
  {
    'Colares do Crepúsculo‡Сумеречные ожерелья‡Zwielichthalsbänder‡황혼의 목줄‡Colleras Crepusculares‡Colleras Crepusculares‡Les colliers du Crépuscule‡暮光颈环‡暮光項圈',
    nil,
    'Obtenha 20 Colares do Crepúsculo.‡Добудьте 20 сумеречных ожерелий.‡Beschafft 20 Zwielichthalsbänder‡황혼의 목줄 20개를 획득해야 합니다.‡Consigue 20 colleras Crepusculares.‡Consigue 20 colleras Crepusculares.‡Procurez-vous 20 Colliers du Crépuscule.‡收集20个暮光颈环。‡收集20個暮光項圈。',
  }
},
[27983] = {
  {
    'A aventura do Lanque: anõezinhos mal-humorados‡Приключения Чурбана: маленькие злобные дворфы‡Lunks Abenteuer: Launische kleine Zwerge‡돌머리의 모헙: 괴팍한 작은 드워프들‡La aventura de Ñoño: pequeños enanos gruñones‡La aventura de Ñoño: pequeños enanos gruñones‡L’aventure de Benêt : les petits nains grincheux‡隆克的冒险：昏昏欲睡的小矮人‡郎克的冒險:暴躁的小矮人',
    nil,
    'Enfraqueça 7 Vaporistas Ferro Negro para que o Lanque possa ajudá-los a adormecer.‡Добейтесь того, чтобы 7 дворфов из клана Черного Железа ослабли и Чурбан смог их усыпить.‡Schwächt 7 Dampfschmiede der Dunkeleisenzwerge, sodass Lunk ihnen helfen kann, einzuschlafen.‡검은무쇠 증기기술자를 약화시켜 돌머리가 그들을 잠재우도록 해야 합니다.‡Debilita a 7 vapoherreros Hierro Negro para que Ñoño pueda hacerlos dormir.‡Debilita a 7 vapoherreros Hierro Negro para que Ñoño pueda hacerlos dormir.‡Affaiblissez 7 Forge-vapeur sombrefers pour que Benêt puisse les endormir.‡削弱7名黑铁锻造师，以便隆克可以让他们睡着。‡削弱7名黑鐵鍛造師，好讓郎克可以幫忙讓他們睡著。',
  }
},
[27984] = {
  {
    'O conto do Luncardo‡История Лунного Репья‡Distelmonds Geschichte‡룬시슬의 이야기‡La historia de Lunthistle‡La historia de Lunthistle‡Le conte de Chardelune‡月棘的故事‡月棘的傳說',
    nil,
    'Ouça o conto do Zamael.‡Послушайте историю Замеля.‡Lauscht Zamaels Erzählung.‡잠마엘 룬시슬의 이야기를 들어야 합니다.‡Escucha a Zamael.‡Escucha a Zamael.‡Écoutez le récit de Zamael.‡听萨麦尔讲他的故事。‡聽薩麥爾講述他的故事。',
  }
},
[27985] = {
  {
    'Oração a Eluna‡Молитва к Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡El rezo a Elune‡El rezo a Elune‡Prière à Élune‡艾露恩祷言‡伊露恩祈禱文',
    nil,
    'Encontre e leia a Oração a Eluna.‡Найдите и прочитайте молитву к Элуне.‡Findet und lest das Gebet an Elune.‡엘룬 여신에게 올리는 기도문을 찾아야 합니다.‡Encuentra y lee el rezo a Elune.‡Encuentra y lee el rezo a Elune.‡Retrouvez la Prière à Élune et lisez-la.‡找到并阅读艾露恩祷言。‡找到並閱讀伊露恩祈禱文。',
  }
},
[27986] = {
  {
    'No salão do Senhor da Montanha‡У горного владыки‡In den Hallen des Bergfürsten‡산의 제왕의 전당‡En el salón del señor de la montaña‡En el salón del señor de la montaña‡Dans l’antre du seigneur de la montagne‡在山丘领主的大厅里‡在山丘統領的大廳',
    nil,
    'Fale com o Senhor da Montanha Rendan, no Auge Férreo, que fica na Garganta Abrasadora.‡Поговорите с горным владыкой Ренданом на Железной вершине, что в Тлеющем ущелье.‡Sprecht mit Bergfürst Rendan auf dem Eisengipfel in der Sengenden Schlucht.‡이글거리는 협곡의 강철 멧부리에 있는 산의 제왕 렌단과 대화해야 합니다.‡Habla con el señor de la montaña en la Cima de Hierro, en La Garganta de Fuego.‡Habla con el señor de la montaña en la Cima de Hierro, en La Garganta de Fuego.‡Parlez au Seigneur de la montagne Rendan sur le Sommet de Fer, dans la Gorge des Vents brûlants.‡与灼热峡谷铸铁峰的山丘领主伦达恩谈谈。‡在灼熱峽谷的黑鐵峰與山丘統領蘭登交談。',
  }
},
[27987] = {
  {
    'Bala de canhão!‡Пушечное ядро!‡Kanonenkugel!‡포탄이다!‡¡Bola de cañón!‡¡Bola de cañón!‡Boulet de canon !‡炮弹！‡砲彈!',
    nil,
    'Você precisa recolher 4 Pilhas de Balas de Canhão no Mirante do Largo, que fica a nordeste da base. Depois, entregue-as para o Sargento Dias.‡Соберите для сержанта Грея 4 груды пушечных ядер, хранящихся на Дозорном пункте Ларго. Он находится к северо-востоку от лагеря.‡Ihr müsst 4 Stapel Kanonenkugeln aus Largos Warte für Unteroffizier Grau besorgen. Ihr findet Largos Warte nordöstlich des Basislagers.‡바라딘 주둔지 북동쪽에 있는 라르고 전망대에서 포탄 더미 4개를 모아야 합니다.‡Tienes que recuperar 4 montones de bolas de cañón en el Alto de Largo para el sargento Gray. Encontrarás el Alto de Largo al noreste del campamento.‡Tienes que recuperar 4 montones de bolas de cañón en el Alto de Largo para el sargento Gray. Encontrarás el Alto de Largo al noreste del campamento.‡Récupérez 4 Piles de boulets de canon au Surplomb de Largo pour le compte du Sergent Gray. Le surplomb de Largo est situé au nord-est du campement.‡前往拉尔戈的瞭望台，为格雷中士收集4堆炮弹。拉尔戈的瞭望台位于营地东北方。‡你必須幫葛雷中士從拉爾戈瞰臺取回4堆砲彈。你可以在營區東北邊找到拉爾戈瞰臺。',
  }
},
[27988] = {
  {
    'Peste... Peste em todo lugar!‡Чума... Чума повсюду!‡Seuche... Überall Seuche!‡역병... 온통 역병!‡Peste... ¡Peste por todas partes!‡Peste... ¡Peste por todas partes!‡Quand il n\'y en a plus, il y en a encore‡瘟疫……到处都是瘟疫！‡瘟疫...到處都是瘟疫!',
    nil,
    'Mate o Barão Silverlaine e o Comandante Floraval.‡Убейте барона Сильверлейна и командира Спрингвейла.‡Tötet Baron Silberlein und Kommandant Grüntal.‡남작 실버레인과 사령관 스프링베일을 처치해야 합니다.‡Mata al barón Filargenta y al comandante Vallefont.‡Mata al barón Filargenta y al comandante Vallefont.‡Tuez le Baron d\'Argelaine et le Commandant Printeval.‡杀死席瓦莱恩男爵和指挥官斯普林瓦尔。‡殺死席瓦萊恩男爵和指揮官斯普林瓦爾。',
  }
},
[27989] = {
  {
    'Ruumbo quer mel‡Роумбо просит меда‡Ruumbo verlangt Honig‡룸보는 벌꿀을 원하신다‡Ruumbo quiere miel‡Ruumbo quiere miel‡Ruumbo veut du miel !‡卢姆波要蜂蜜‡魯姆波要蜂蜜',
    nil,
    'Colete 12 Glóbulos de Mel de Lenha Morta das colmeias na Vila da Lenha Morta usando o Graveto para Mel de Ruumbo.‡Соберите 10 порций меда Деревни Мертвого Леса из ульев Деревни Мертвого Леса, используя медовую палочку Роумбо.‡Sammelt 10 Honigtropfen der Totenwaldfelle aus den Bienenstöcken im Lager der Totenwaldfelle, indem Ihr Ruumbos Honigstock benutzt.‡마른가지 마을에서 룸보의 꿀막대를 사용해 마른가지 벌꿀 덩어리 10개를 모아야 합니다.‡Recoge 10 pegotes de miel Muertobosque de las colmenas de la Aldea Muertobosque usando el palo de miel de Ruumbo.‡Recoge 10 pegotes de miel Muertobosque de las colmenas de la Aldea Muertobosque usando el palo de miel de Ruumbo.‡Récupérez 10 Boules de miel mort-bois dans les ruches du Village mort-bois en utilisant la Spatule à miel de Ruumbo.‡用卢姆波的蘸蜜棒在死木村里的蜂巢中采集10团死木蜂蜜滴液。‡到死木村對蜂窩使用魯姆波的蜂蜜棒，收集10份死木蜂蜜汁液。',
  }
},
[27990] = {
  {
    'Zona de combate‡Зона боевых действий‡Gefechtszone‡전투 구역‡Zona de batalla‡Zona de batalla‡Guerre éclair !‡战斗地带‡戰區!',
    nil,
    'O Comandante Schnottz quer que você maneje a torreta de um dos tanques de cerco e use-a para derrotar 7 Vigias Decrépitos. Feito isso, apresente-se novamente a ele.‡Командир Шнотц приказывает вам занять место канонира в одном из осадных танков и разобраться с 7 дряхлыми стражами, а затем вернуться к нему.‡Kommandant Schnottz möchte, dass Ihr einen der Belagerungspanzer bemannt und ihn benutzt, um 7 altersschwache Behüter zu besiegen. Meldet Euch danach wieder bei ihm.‡공성 전차 포탑 중 하나를 사용하여 노쇠한 감시자 7명을 처치한 후, 사령관 슈노츠에게 보고해야 합니다.‡El comandante Schnottz quiere que accedas a una de las torretas de sus tanques de asedio y que la uses para derrotar a 7 vigías decrépitos; después preséntate ante él.‡El comandante Schnottz quiere que accedas a una de las torretas de sus tanques de asedio y que la uses para derrotar a 7 vigías decrépitos; después preséntate ante él.‡Le Commandant Schnottz veut que vous dirigiez l\'un des chars d\'assaut à tourelle et que vous l\'utilisiez pour vaincre 7 Guetteurs décrépits, puis que vous reveniez le voir.‡元首司克诺兹要你操纵攻城坦克的一门炮塔，消灭7个破碎的守卫者，然后向他复命。‡指揮官舒諾茲要你使用攻城坦克火砲，擊敗7個破舊的看守者，完成後向他回報。',
  }
},
[27991] = {
  {
    'O mirante é nosso, aha, uhu!‡Освобождение дозорной башни‡Die Rückeroberung der Warte‡전망대 탈환‡Recuperar el Alto‡Recuperar el Alto‡La reprise du surplomb‡夺回拉尔戈的瞭望台‡收復瞰臺',
    nil,
    'O Sargento Dias pediu para você matar o Comandante Largo, no Mirante do Largo. O mirante fica a nordeste da base.‡Сержант Грей поручил вам ликвидировать Командира Ларго на Дозорном пункте Ларго. Это место находится к северо-востоку от лагеря.‡Unteroffizier Grau hat Euch beauftragt, Kommandant Largo in Largos Warte zu töten. Die Warte befindet sich direkt nordöstlich des Basislagers.‡하사관 그레이가 바라딘 주둔지 북동쪽 해안에 있는 라르고 전망대에서 라르고를 처치해 달라고 했습니다.‡El sargento Gray te ha pedido que mates al comandante Largo en el Alto de Largo. El Alto se encuentra al noreste del campamento.‡El sargento Gray te ha pedido que mates al comandante Largo en el Alto de Largo. El Alto se encuentra al noreste del campamento.‡Le Sergent Gray vous a demandé de tuer le commandant Largo, au Surplomb de Largo. Le surplomb se trouve au nord-est du campement.‡格雷中士要你前往拉尔戈的瞭望台杀死指挥官拉尔戈。拉尔戈的瞭望台位于营地的东北方。‡葛雷中士要你到拉爾戈瞰臺去殺死指揮官拉爾戈。瞰臺就在營地的東北邊。',
  }
},
[27992] = {
  {
    'Como funcionam os ímãs?‡Как работают магниты?‡Goblinischer Magnetismus‡자석의 원리‡Imanes, ¿cómo funcionan?‡Imanes, ¿cómo funcionan?‡Les aimants, ça marche comment ?‡磁铁的原理是什么呢？‡磁鐵，要怎麼用?',
    nil,
    'Você foi encarregada de recuperar 7 peças de Sucata da Máquina de Cerco. Use o Coletor de Sucata Magnetizado para encontrar as peças no Front Incansável, que fica a oeste, pouco depois da segunda ponte.‡Вам поручили собрать 7 фрагментов осадных машин. Используйте намагниченный сборщик металлолома на Передовой Неупокоенных, расположенной на западе за вторым мостом.‡Ihr habt die Aufgabe erhalten, 7 Stücke Belagerungsmaschinenschrott zu bergen. Benutzt den magnetisierten Schrottsammler an der Rastlosen Front, um die Schrottteile zu finden. Die Rastlose Front befindet sich im Westen hinter der zweiten Brücke.‡안식 없는 전초지에서 자력 고철 수집기를 사용해서 공성 전차 고철조각 7개를 획득해야 합니다. 바라딘 주둔지에서 서쪽으로 다리 두 개를 건너면 안식 없는 전초지에 도착할 수 있습니다.‡Te han encargado que recuperes 7 piezas de chatarra de máquina de asedio. Usa el recolector de chatarra magnetizado en el Frente Inquieto para encontrar chatarra. El Frente Inquieto se encuentra al oeste, pasado el segundo puente.‡Te han encargado que recuperes 7 piezas de chatarra de máquina de asedio. Usa el recolector de chatarra magnetizado en el Frente Inquieto para encontrar chatarra. El Frente Inquieto se encuentra al oeste, pasado el segundo puente.‡Collectez 7 Débris d’engin de siège. Utilisez le Détecteur de métaux aimanté au Front Sans-Repos pour dénicher les débris. Le front se trouve plein ouest, au-delà du deuxième pont.‡取回7块攻城坦克废料。在不眠前线使用磁性废料收集器寻找废料。不眠前线位于此地正西方，穿过第二座桥梁就到。‡你被賦予找出7片攻城機具碎塊的任務。到無寧前線去利用磁化廢金屬收集器找出碎塊。無寧前線在西方，越過第二座橋的地方。',
  }
},
[27993] = {
  {
    'Leve isso pra eles!‡Задай им перцу!‡Zeigt\'s ihnen!‡본때를 보여줍시다!‡¡Dales su merecido!‡¡Dales su merecido!‡Damnez-leur le pion !‡教训他们！‡讓他們瞧瞧!',
    nil,
    'O Mack quer que você investigue a Tumba de Khartut.‡Мак отправляет вас исследовать гробницу Хартута.‡Mack möchte, dass Ihr das Grab des Khartut untersucht.‡맥이 카르투트의 무덤을 조사해 달라고 했습니다.‡Mack quiere que investigues la Tumba de Khartut.‡Mack quiere que investigues la Tumba de Khartut.‡Mack veut que vous examiniez la Tombe de Khartut.‡马克要你调查卡塔图陵墓。‡麥客要你去調查卡爾吐特之墓。',
  }
},
[27994] = {
  {
    'Ruumbo quer justiça‡Роумбо требует правосудия‡Ruumbo verlangt Gerechtigkeit‡룸보는 정의를 원하신다‡Ruumbo pide justicia‡Ruumbo pide justicia‡Ruumbo réclame justice !‡卢姆波要正义‡魯姆波伸張正義',
    nil,
    'Mate 15 Pelursos Lenha Morta de qualquer tipo.‡Убейте 15 любых фурболгов Мертвого Леса.‡Tötet 15 Furbolgs der Totenwaldfelle jedweder Art.‡종류에 상관없이 마른가지 펄볼그 15마리를 처치해야 합니다.‡Mata a 15 fúrbolgs Muertobosque de cualquier tipo.‡Mata a 15 fúrbolgs Muertobosque de cualquier tipo.‡Tuez 15 Furbolgs mort-bois de n\'importe quel type.‡杀死任意种类的15名死木熊怪。‡殺死任15個死木熊怪。',
  }
},
[27995] = {
  {
    'Dance para Ruumbo!‡Танец для Роумбо!‡Tanzt für Ruumbo!‡룸보를 위해 춤을!‡¡Baila para Ruumbo!‡¡Baila para Ruumbo!‡Dansez pour Ruumbo !‡为卢姆波跳舞！‡為魯姆波跳舞!',
    nil,
    'Faça uma dancinha boba para Ruumbo.‡Исполните для Роумбо глупый танец.‡Tanzt einen albernen Tanz für Ruumbo.‡룸보 앞에서 바보 같은 춤을 춰야 합니다.‡Ejecuta un baile estúpido para Ruumbo.‡Ejecuta un baile estúpido para Ruumbo.‡Faites une danse ridicule pour Ruumbo.‡给卢姆波跳段难看的舞。‡為魯姆波跳蠢蛋舞。',
  }
},
[27996] = {
  {
    'Ordens são para os vivos‡Твое время вышло!‡Befehle sind was für die Lebenden‡생존을 위한 명령‡Las órdenes son para los vivos‡Las órdenes son para los vivos‡Les ordres, c\'est bon pour les vivants‡活人才会听命令‡命令是下給活人的',
    nil,
    'Mate o Lorde Walden.‡Убейте лорда Вальдена.‡Tötet Lord Walden.‡월든 경을 처치해야 합니다.‡Mata a Lord Walden.‡Mata a Lord Walden.‡Tuez le Seigneur Walden.‡杀死沃登勋爵。‡殺死瓦爾登領主。',
  }
},
[27997] = {
  {
    'A corrupção dos Flamejade‡Вред Нефритового Пламени‡Jadefeuerverderbnis‡비취불꽃의 부패‡La corrupción de los Fuego de Jade‡La corrupción de los Fuego de Jade‡La corruption jadefeu‡碧火的堕落‡碧火薩特',
    nil,
    'Mate 12 Sátiros Flamejade ou Devotos Vis Flamejade na Grota Flamejade.‡Убейте 12 сатиров или скверноподданных из племени Нефритового Пламени в Долине Нефритового Пламени.‡Tötet 12 Jadefeuersatyrn oder Jadefeuerteufelsanbeter im Jadefeuertal.‡비취불꽃 숲에서 비취불꽃 사티로스나 비취불꽃 악마추종자 12마리를 처치해야 합니다.‡Mata a 12 sátiros Fuego de Jade o Jurapenas Fuego de Jade en la Cañada Fuego de Jade.‡Mata a 12 sátiros Fuego de Jade o Jurapenas Fuego de Jade en la Cañada Fuego de Jade.‡Tuez 12 Satyres jadefeu ou Gangreliges jadefeu au Vallon des Jadefeu.‡在碧火谷杀死12名碧火萨特或碧火魔仆。‡到碧火谷殺死12個碧火薩特或碧火魔僕。',
  }
},
[27998] = {
  {
    'Doce e impiedosa vingança‡Сладкая, беспощадная месть‡Süße, gnadenlose Rache‡무자비한 복수의 달콤함‡Dulce, despiadada venganza‡Dulce, despiadada venganza‡Une vengeance impitoyable‡甜蜜、无情的复仇‡甜蜜、無情的復仇',
    nil,
    'Mate o Lorde Godfrey.‡Убейте лорда Годфри.‡Tötet Lord Godfrey.‡고드프리 경을 처치해야 합니다.‡Mata a Lord Godfrey.‡Mata a Lord Godfrey.‡Tuez le Seigneur Godfrey.‡杀死高弗雷勋爵。‡殺死高佛雷領主。',
  }
},
[27999] = {
  {
    'O destino dos Doyle‡Судьба Дойлов‡Das Schicksal der Doyles‡도일 가문의 운명‡El fin de los Doyle‡El fin de los Doyle‡Le destin des Doyle‡多伊尔的命运‡道爾一族的命運',
    nil,
    'Dê as notícias do clã Doyle para Iain Barbarruiva no Cemitério de Barbarruiva.‡Вернитесь на Кладбище Огнебородов и сообщите Иэну Огнебороду о судьбе клана Дойлов.‡Kehrt mit den Neuigkeiten über den Klan Doyle zu Iain Feuerbart auf Feuerbarts Friedhof zurück.‡파이어비어드 묘지에 있는 이언 파이어비어드에게 도일 가문에 대한 소식을 전해야 합니다.‡Lleva las noticias del clan Doyle a Iain Barbafuego, en el Cementerio Barbafuego.‡Lleva las noticias del clan Doyle a Iain Barbafuego, en el Cementerio Barbafuego.‡Informez Iain Barbe-en-feu du funeste destin du clan Doyle, au Cimetière de Barbe-en-feu.‡把多伊尔氏族的消息告诉焰须墓地的伊安·焰须。‡到火鬍修道院將道爾氏族的消息告知伊安‧火鬍。',
  }
},
[28000] = {
  {
    'Diabretim foi pro saco‡Сделать невозможное‡Wichteln, einmal anders‡임프라면 가능한 일‡Endiabladamente difícil‡Endiabladamente difícil‡L\'enfer est dans le sac‡能人所不能‡不可能的小鬼',
    nil,
    'Enfraqueça o Diabretim e use o Saco de Diabrete Encantado para capturá-lo.‡Сделайте так, чтобы Бесенок ослаб, а затем поймайте его при помощи заколдованного бесовского мешка.‡Schwächt Impsy und dann benutzt den verzauberten Wichtelsack, um ihn einzufangen.‡임프시를 약하게 만들고 마력 깃든 임프 자루를 사용해 생포해야 합니다.‡Debilita a Diblis y usa el saco de diablillo encantado para capturarlo.‡Debilita a Diblis y usa el saco de diablillo encantado para capturarlo.‡Affaiblissez Démonet et utilisez le Sac à diablotin enchanté pour le capturer.‡削弱伊普斯，用强化伏魔袋将他俘虏。‡削弱伊普斯，並用附魔小鬼背包捉住他。',
  }
},
[28001] = {
  {
    'O dever de um covarde‡Удел труса‡Was einem Feigling zusteht‡겁쟁이의 변명‡El deber de un cobarde‡El deber de un cobarde‡Le salaire de l\'apeuré‡懦夫的理由‡沒有懦夫的空間',
    nil,
    'Fale com Colin Trondamar em Trondamar.‡Идите в Громтар и поговорите с Колином Громтаром.‡Sprecht mit Colin Donnermar in Donnermar.‡썬더마에 있는 콜린 썬더마와 대화해야 합니다.‡Habla con Colin Bramal en Bramal.‡Habla con Colin Bramal en Bramal.‡Allez voir Colin Tonnemar, à Tonnemar.‡跟桑德玛尔的科林·桑德玛尔谈一谈。‡到桑德瑪去和柯林·桑德瑪交談。',
  }
},
[28002] = {
  {
    'Administração de crises‡Антикризисное управление‡Krisenmanagement‡위기 관리‡Gestión de crisis‡Gestión de crisis‡Gestion de crise‡危机管理‡危機處理',
    nil,
    'Belloc Gumélion quer que você tranquilize os convidados no Porto de Schnottz.‡Беллок Сияющий Клинок хочет, чтобы вы успокоили гостей в лагере Шнотца.‡Bellok Leuchtklinge möchte, dass Ihr die Gäste in Schnottz\' Landeplatz beschwichtigt.‡벨록 브라이트블레이드가 슈노츠 비행기지에 있는 손님들을 안심시켜 달라고 했습니다.‡Belloc Hoja Brillante quiere que calmes a los invitados del Embarcadero de Schnottz.‡Belloc Hoja Brillante quiere que calmes a los invitados del Embarcadero de Schnottz.‡Belloc Brillelame veut que vous rassuriez les invités de l\'Accostage de Schnottz.‡贝洛克·辉刃要你打消司克诺兹登陆点的客人们的顾虑。‡貝洛克·亮刃要你安撫舒諾茲營地的賓客。',
  }
},
[28003] = {
  {
    'Procuram-se aventureiros: Cavernas Ígneas‡Требуются герои: Огненная Пропасть‡Abenteurer gesucht: Flammenschlund‡모험가 모집: 성난불길 협곡‡Se busca aventurero: Sima Ígnea‡Se busca aventurero: Sima Ígnea‡On recherche : des aventuriers pour le gouffre de Ragefeu‡征召冒险者：怒焰裂谷‡徵集冒險者:怒焰裂谷',
    nil,
    'Fale com o Guarda Pétreo Kurjack.‡Поговорите с каменным стражем Курджаком.‡Sprecht mit Steingardist Kurjack.‡투사 쿠르잭과 대화해야 합니다.‡Habla con el guardia de piedra Kurjack.‡Habla con el guardia de piedra Kurjack.‡Parlez au Garde de pierre Kurjack.‡与石头守卫库尔加克交谈。‡和石衛士療舉談話。',
  }
},
[28004] = {
  {
    'Procuram-se aventureiros: Minas Mortas‡Требуются герои: Мертвые копи‡Abenteurer gesucht: Die Todesminen‡모험가 모집: 죽음의 폐광‡Se buscan aventureros: Las Minas de la Muerte‡Se buscan aventureros: Las Minas de la Muerte‡On recherche : des aventuriers pour les Mortemines‡征召冒险者：死亡矿井‡徵集冒險者:死亡礦坑',
    nil,
    'Fale com Ragtha.‡Поговорите с Кагтой.‡Sprecht mit Kagtha.‡카그타와 대화해야 합니다.‡Habla con Kagtha.‡Habla con Kagtha.‡Parlez à Kagtha.‡与卡格萨交谈。‡和卡格薩談話。',
  }
},
[28005] = {
  {
    'Procuram-se aventureiros: Minas Mortas‡Требуются герои: Мертвые копи‡Abenteurer gesucht: Die Todesminen‡모험가 모집: 죽음의 폐광‡Se buscan aventureros: Las Minas de la Muerte‡Se buscan aventureros: Las Minas de la Muerte‡On recherche : des aventuriers pour les Mortemines‡征召冒险者：死亡矿井‡徵集冒險者:死亡礦坑',
    nil,
    'Fale com o Tenente Horatio Laine.‡Поговорите с лейтенантом Горацио Лейном.‡Sprecht mit Leutnant Horatio Laine.‡반장 호레이쇼 레인과 대화해야 합니다.‡Habla con el teniente Horatio Laine.‡Habla con el teniente Horatio Laine.‡Parlez au Lieutenant Horatio Laine.‡与霍拉提奥·莱茵中尉交谈。‡和何瑞修·萊恩中尉談話。',
  }
},
[28006] = {
  {
    'Procuram-se aventureiros: Caverna Ululante‡Требуются герои: пещеры Стенаний‡Abenteurer gesucht: Die Höhlen des Wehklagens‡모험가 모집: 통곡의 동굴‡Se buscan aventureros: Cuevas de los Lamentos‡Se buscan aventureros: Cuevas de los Lamentos‡On recherche : des aventuriers pour les cavernes des Lamentations‡征召冒险者：哀嚎洞穴‡徵集冒險者:哀嚎洞穴',
