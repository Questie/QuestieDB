},
[3661] = {
  {
    'Protegidos de Eluna?‡Любимцы Элуны?‡Elunes Lieblinge?‡엘룬의 피조물‡¿Creados por Elune?‡¿Creados por Elune?‡Dans les faveurs d\'Élune ?‡月神之兽？‡月神之獸?',
    nil,
    'Pegue 15 Penas de Coruscante nas Terras Agrestes para Erelas Ambarcéu na Vila de Rut\'theran.‡Собрерите во Внутренних землях 15 перьев диких совухов и отнесите их Эреласу Янтарному Небу в деревню Рут\'теран.‡Sammelt 15 Wildekinfedern aus dem Hinterland für Erelas Himmelsbern in Rut\'theran.‡에렐라스 앰버스카이에게 동부 내륙지에 있는 올빼미야수 깃털 15개를 가져가야 합니다.‡Recoge 15 plumas de lechúcico salvaje de las Tierras del Interior y llévaselas a Erelas Cieloámbar a la Aldea Rut\'theran.‡Recoge 15 plumas de lechúcico salvaje de las Tierras del Interior y llévaselas a Erelas Cieloámbar a la Aldea Rut\'theran.‡Collecter 15 Plumes d\'Indomptable dans les Hinterlands, pour Erelas Ambreciel au village de Rut\'theran.‡为鲁瑟兰村的艾瑞拉斯·琥珀收集15支枭兽羽毛。‡為魯瑟蘭村的艾瑞拉斯·琥珀收集15支梟獸羽毛。',
  }
},
[3681] = {
  {
    '‡Фолиант божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    '‡Разыщите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Sturmwind.‡‡Ve a Ventormenta y habla con Duthorian Rall.‡Ve a Ventormenta y habla con Duthorian Rall.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩-拉尔谈一谈。‡',
  }
},
[3701] = {
  {
    'As fumegantes Ruínas de Thaurissan‡Дымящиеся руины Тауриссана‡Die glimmenden Ruinen von Thaurissan‡불타는 타우릿산의 폐허‡Las humeantes Ruinas de Thaurissan‡Las humeantes Ruinas de Thaurissan‡Les ruines fumantes de Thaurissan‡索瑞森废墟‡索瑞森廢墟',
    nil,
    'Vá até as Ruínas de Thaurissan, nas Estepes Ardentes, e descubra informações sobre as Relíquias de Thaurissan. Fale novamente com a Historiadora Real Arquefilis quando terminar.‡Пойдите в руины Тауриссана в Пылающих степях и добудьте информацию из таурисанских реликвий. Вернитесь к королевскому историку Аркессон.‡Begebt Euch zu den Ruinen von Thaurissan in der Brennenden Steppe und sammelt Informationen über die Relikte von Thaurissan. Kehrt zur königlichen Historikerin Archesonus zurück, wenn Ihr die Informationen besorgt habt.‡불타는 평원, 타우릿산의 폐허에 있는 타우릿산 유물에서 정보를 얻어야 합니다. 정보를 발견하면 왕실사학자 아케소누스에게 가야 합니다.‡Ve a las Ruinas de Thaurissan, en Las Estepas Ardientes, y recopila información sobre los tesoros de Thaurissan. Informa a la historiadora real Archesonus.‡Ve a las Ruinas de Thaurissan, en Las Estepas Ardientes, y recopila información sobre los tesoros de Thaurissan. Informa a la historiadora real Archesonus.‡Aller dans les ruines de Thaurissan, dans les Steppes ardentes. Récupérer des informations sur les Reliques de Thaurissan, puis retourner auprès de l\'Historienne royale Archesonus.‡到燃烧平原的索瑞森废墟中去，从索瑞森遗物上搜集信息。当你收集到足够的信息之后，就回到皇家历史学家阿克瑟努斯那里。‡到燃燒平原的索瑞森廢墟中去，從索瑞森聖物上搜集資訊。當你收集到足夠的資訊之後，就回到皇家歷史學家阿克瑟努斯那裡。',
  }
},
[3702] = {
  {
    '‡Дымящиеся руины Тауриссана‡Die glimmenden Ruinen von Thaurissan‡불타는 타우릿산의 폐허‡Las humeantes Ruinas de Thaurissan‡Las humeantes Ruinas de Thaurissan‡Les ruines fumantes de Thaurissan‡索瑞森废墟‡',
    nil,
    '‡Узнайте от королевского историка Аркессона историю Тауриссана.‡Hört die Erzählung der königlichen Historikerin Archesonus über die Geschichte von Thaurissan.‡왕실사학자 아케소누스가 들려 주는 타우릿산의 역사를 들어야 합니다.‡Escucha a la historiadora real Archesonus relatar la historia de Thaurissan.‡Escucha a la historiadora real Archesonus relatar la historia de Thaurissan.‡Écouter l\'historienne royale Archesonus raconter l\'histoire de Thaurissan.‡听皇家历史学家阿克瑟努斯讲述索瑞森的历史。‡',
  }
},
[3721] = {
  {
    'Um OOX para chamar de meu‡Собственный ККХ‡Ein eigener OOX‡선물로 받은 OOX‡Tu propio OOX‡Tu propio OOX‡Un OOX rien que pour vous‡你自己的OOX‡你自己的OOX',
    nil,
    nil,
  }
},
[3741] = {
  {
    'Colar da Hilária‡Ожерелье Хилари‡Hilarys Halskette‡힐러리의 목걸이‡El collar de Hilary‡El collar de Hilary‡Le collier d\'Hilary‡希拉里的项链‡希拉蕊的項鍊',
    nil,
    'Encontre e devolva o Colar da Hilária na Vila Plácida.‡Найдите ожерелье Хилари и верните его Хилари в Приозерье.‡Sucht Hilarys Halskette und bringt sie Hilary in Seenhain zurück.‡힐러리의 목걸이를 찾아 호숫골에 있는 힐러리에게 가져가야 합니다.‡Encuentra el collar de Hilary y llévaselo a Villa del Lago.‡Encuentra el collar de Hilary y llévaselo a Villa del Lago.‡Trouver le Collier d\'Hilary et le rapporter à Hilary à Comté-du-Lac.‡找到希拉里的项链，将其还给湖畔镇的希拉里。‡找到希拉蕊的項鍊，將其還給湖畔鎮的希拉蕊。',
  }
},
[3761] = {
  {
    'Solo de Un\'Goro‡Земля Ун\'Горо‡Erde von Un\'Goro‡운고로 토양‡Tierra de Un\'Goro‡Tierra de Un\'Goro‡L\'humus d\'Un\'Goro‡安戈洛的泥土‡安戈洛的泥土',
    nil,
    'Leve 20 amostras de Solo de Un\'Goro para Ghede no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Принесите 20 образцов почвы из Кратера Ун\'Горо Геду на Вершину Старейшин Громового Утеса.‡Bringt 20 Erdproben von Un\'Goro zu Ghede auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프에 장로의 봉우리에 있는 게드에게 운고로 토양 20개를 가져가야 합니다.‡Llévale 20 muestras de la tierra de Un\'Goro a Ghede, en el Alto de los Ancestros de Cima del Trueno.‡Llévale 20 muestras de la tierra de Un\'Goro a Ghede, en el Alto de los Ancestros de Cima del Trueno.‡Apporter 20 Échantillons d\'humus d\'Un\'Goro à Ghede, aux Pitons-du-Tonnerre.‡收集20份安戈洛的泥土，把它们交给雷霆崖的格德。‡收集20份安戈洛的泥土，把它們交給雷霆崖長者高地的格德。',
  }
},
[3762] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runentotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Tótem de Runa‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Totem-runique‡协助大德鲁伊‡協助大德魯伊符文圖騰',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Donnerfels mit Erzdruide Hamuul Runentotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l’Archidruide Hamuul Totem-Runique aux Pitons-du-Tonnerre.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談話。',
  }
},
[3763] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스태그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡L\'aide à l\'archidruide Forteramure‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнасе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스태그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l’Archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[3764] = {
  {
    'Solo de Un\'Goro‡Земля Ун\'Горо‡Erde von Un\'Goro‡운고로 흙‡Tierra de Un\'Goro‡Tierra de Un\'Goro‡L\'humus d\'Un\'Goro‡安戈洛的泥土‡安戈洛的泥土',
    nil,
    'Leve 20 amostras do Solo de Un\'Goro para Jenal no Enclave Cenariano, que fica em Darnassus.‡Принесите 20 образцов земли из кратера Ун\'Горо Дженалю в дарнасский анклав Кенария.‡Bringt 20 Erdproben von Un\'Goro zu Jenal in der Enklave des Cenarius in Darnassus.‡다르나서스의 세나리온 자치령에 있는 제날에게 운고로 토양 20개를 가져가야 합니다.‡Lleva 20 muestras de tierra de Un\'Goro Soil a Jenal, en el Enclave Cenarion de Darnassus.‡Lleva 20 muestras de tierra de Un\'Goro Soil a Jenal, en el Enclave Cenarion de Darnassus.‡Apporter 20 échantillons d\'Humus d\'Un\'Goro à Jenal dans l\'Enclave cénarienne à Darnassus.‡收集20份安戈洛的泥土，把它们交给达纳苏斯的耶纳尔。‡收集20份安戈洛的泥土，把它們交給達納蘇斯的耶納爾。',
  }
},
[3765] = {
  {
    'A corrupção estrangeira‡Проблема за морем‡Verderbnis in der Fremde‡먼 곳에 퍼진 타락‡Lejana corrupción‡Lejana corrupción‡La dépravation au loin‡遥远的旅途‡遙遠的旅途',
    nil,
    'Fale com Gershala Umbrurmúrio em Auberdine.‡Отправляйтесь в Аубердин к Гершалу Шепоту Ночи.‡Reist zu Gershala Nachtraunen in Auberdine.‡아우버다인에 있는 게르샬라 나이트위스퍼를 찾아가야 합니다.‡Ve a ver a Gershala Susurro Nocturno en Auberdine.‡Ve a ver a Gershala Susurro Nocturno en Auberdine.‡Aller voir Gershala Murmenuit à Auberdine.‡到奥伯丁的戈沙拉·夜语那儿去。‡到奧伯丁的戈沙拉·夜語那兒去。',
  }
},
[3781] = {
  {
    '‡Изучение рассветницы‡Morgenkornforschung‡‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la fibre d\'aurore‡晨光麦研究‡',
    nil,
    '‡Отнесите расписку верховного друида в получении семян Матренгилу Медвежьей Лапе в дарнасский Анклав Кенария.‡Bringt den Samenkorngutschein des Erzdruiden zu Mathrengyl Bärenfährte in der Enklave des Cenarius von Darnassus.‡‡Lleva el vale para semillas del archidruida a Mathrengyl Garroso al Enclave Cenarion de Darnassus.‡Lleva el vale para semillas del archidruida a Mathrengyl Garroso al Enclave Cenarion de Darnassus.‡Apporter le Bon pour des graines de l\'archidruide à Mathrengyl Pasdelours dans l\'Enclave cénarienne à Darnassus.‡将大德鲁伊的草种购买券交给达纳苏斯城塞纳里奥区的玛斯雷·驭熊者。‡',
  }
},
[3782] = {
  {
    '‡Изучение рассветницы‡Morgenkornforschung‡‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la fibre d\'aurore‡晨光麦研究‡',
    nil,
    '‡Отнесите расписку в получении семян Башане Руническому Тотему в Громовой Утес.‡Bringt den Samenkorngutschein zu Bashana Runentotem in Donnerfels.‡‡Llévale este vale para semillas a Bashana Tótem de Runa en Cima del Trueno.‡Llévale este vale para semillas a Bashana Tótem de Runa en Cima del Trueno.‡Apporter le Bon pour des graines à Bashana Totem-Runique aux Pitons-du-Tonnerre.‡将草种购买券交给雷霆崖的巴珊娜·符文图腾。‡',
  }
},
[3783] = {
  {
    '[DEPRECATED]Are We There, Yeti?‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡[DEPRECATED]Yeti... ¿ya hemos llegado?‡[DEPRECATED]Yeti... ¿ya hemos llegado?‡[PÉRIMÉ]Yéti ? Y es-tu ?‡雪怪计划！‡[DEPRECATED]Are We There, Yeti?',
    nil,
    'Colete 10 Peles Grossas de Yeti para Umi Zombarruga em Visteterna.‡Соберите 10 толстых кусков меха йети для Уми Смехотреп из Круговзора.‡Sammelt 10 dicke Yetifelle für Umi Rumpelkicher in der Ewigen Warte.‡두꺼운 설인 모피 10개를 모아 눈망루 마을에 있는 우미 럼플스니커에게 가져가야 합니다.‡Reúne 10 pelajes de yeti gruesos para Umi Risitas en Vista Eterna.‡Reúne 10 pelajes de yeti gruesos para Umi Risitas en Vista Eterna.‡Récupérez 10 Fourrures épaisses de yéti pour Umi Sarcafroisse, à Long-Guet.‡为永望镇的乌米收集10张厚雪人毛皮。‡為永望鎮的烏米收集10張厚雪人毛皮。',
  }
},
[3784] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runentotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Tótem de Runa‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Totem-runique‡协助大德鲁伊‡協助大德魯伊符文圖騰',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Donnerfels mit Erzdruide Hamuul Runentotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l’Archidruide Hamuul Totem-Runique aux Pitons-du-Tonnerre.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談話。',
  }
},
[3785] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Use o Bornal de Sempre-viva com um pacote de Sementes de Tharlendis e duas amostras de Solo de Un\'Goro para tentar cultivar mudas de grão-matinal.|n|nLeve 10 Grãos-matinais para Mathrengyl Ursivagus em Darnassus.‡При помощи сумы вечного цветения, пакетика семян Тарлендриса и двух порций почвы Ун\'Горо попытайтесь прорастить рассветницу.|n|nПринесите 10 рассветниц Матренгилу Медвежьей Лапе в Дарнас.‡Benutzt einen Immergrünbeutel mit einem Paket Tharlendrissamenkörner sowie zwei Erdproben von Un\'Goro, um Morgenkorn zu kultivieren.|n|nBringt 10 Einheiten Morgenkorn zu Mathrengyl Bärenfährte in Darnassus.‡탈렌드리스 씨앗 꾸러미와 늘푸른 주머니를 운고로 토양 2개에 사용하여 여명초 견본을 재배하십시오.|n|n다르나서스에 있는 마스렌길 베어워커에게 여명초 10개를 가져가야 합니다.‡Utiliza una faltriquera de siempreverde con 1 paquete de semillas de Tharlendris y 2 muestras de tierra de Un\'Goro para intentar cultivar mañagrana. |n|nLleva 10 plantas de mañagrana a Mathrengyl Garroso a Darnassus.‡Utiliza una faltriquera de siempreverde con 1 paquete de semillas de Tharlendris y 2 muestras de tierra de Un\'Goro para intentar cultivar mañagrana. |n|nLleva 10 plantas de mañagrana a Mathrengyl Garroso a Darnassus.‡Utiliser une Sacoche de printemps avec une pochette de graines de Tharlendris et deux échantillons d\'Humus d\'Un\'Goro pour essayer de cultiver des Fibres d\'aurore.|n|nApporter 10 Fibres d\'aurore à Mathrengyl Pasdelours à Darnassus.‡用一个常青袋、一包萨伦迪斯种子以及两份安戈洛的泥土来尝试种植晨光麦。|n|n将10株晨光麦交给达纳苏斯的玛斯雷·驭熊者。‡用一個常青袋、一包薩倫迪斯種子以及兩份安戈洛的泥土來嘗試種植晨光麥。|n|n將10株晨光麥交給達納蘇斯的瑪斯雷·馭熊者。',
  }
},
[3786] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Use o Bornal de Sempre-viva com um pacote de Sementes de Tharlendis e duas amostras de Solo de Un\'Goro para tentar cultivar mudas de grão-matinal.|n|nLeve 10 Grãos-matinais para Bashana Runa Totem no Penhasco do Trovão.‡При помощи сумы вечного цветения, пакетика семян Тарлендриса и двух порций земли Ун\'Горо попытайтесь прорастить рассветницу.|n|nПринесите 10 рассветниц Башане Рунический Тотем в Громовой Утес.‡Benutzt einen Immergrünbeutel mit einem Paket Tharlendrissamenkörner sowie zwei Erdproben von Un\'Goro, um Morgenkorn zu kultivieren.|n|nBringt 10 Einheiten Morgenkorn zu Bashana Runentotem in Donnerfels.‡탈렌드리스 씨앗 꾸러미와 늘푸른 주머니를 운고로 토양 2개에 사용하여 여명초 견본을 재배하십시오.|n|n썬더 블러프에 있는 바샤나 룬토템에게 여명초 10개를 가져가야 합니다.‡Mete en la bolsa de siempreverde un paquete de Tharlendris y dos muestras de tierra de Un\'Goro para cultivar muestras de mañagrana.|n|nLlévale 10 mañagranas a Bashana Runatótem, que está en Cima del Trueno.‡Mete en la faltriquera de siempreverde un paquete de Tharlendris y dos muestras de tierra de Un\'Goro para cultivar muestras de mañagrana.|n|nLlévale 10 mañagranas a Bashana Tótem de Runa, que está en Cima del Trueno.‡Utiliser une Sacoche de printemps avec une pochette de graines de Tharlendris et deux Échantillons d\'humus d\'Un\'Goro pour essayer de cultiver des Fibres d\'aurore.|n|nApporter 10 Fibres d\'aurore à Bashana Totem-runique aux Pitons-du-Tonnerre.‡用一个常青袋、一包萨伦迪斯种子以及两份安戈洛的泥土来尝试种植晨光麦。|n|n将10株晨光麦交给雷霆崖的巴珊娜·符文图腾。‡用一個常青袋、一包薩倫迪斯種子以及兩份安戈洛的泥土來嘗試種植晨光麥。|n|n將10株晨光麥交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[3787] = {
  {
    '‡Просьба друида‡Lebenshands Bitte‡‡La petición de Jonguja‡La petición de Jonguja‡La requête de Gentecime‡奎恩提斯的请求‡奎恩提斯的請求',
    nil,
    '‡Поговорите с Квинтисом Ночным Костром в Крепости Оперенной Луны.‡Sprecht mit Quintis Lebenshand in der Mondfederfeste.‡‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Parler à Quintis Gentecime dans le bastion de Pennelune.‡与羽月要塞的奎恩提斯谈一谈。‡與羽月要塞的奎恩提斯談話。',
  }
},
[3788] = {
  {
    '‡Просьба друида‡Lebenshands Bitte‡‡La petición de Jonguja‡La petición de Jonguja‡La requête de Gentecime‡奎恩提斯的请求‡',
    nil,
    '‡Поговорите с Квинтисом Ночным Костром в Крепости Оперенной Луны.‡Sprecht mit Quintis Lebenshand in der Mondfederfeste.‡‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Parler à Quintis Gentecime dans le bastion de Pennelune.‡与羽月要塞的奎恩提斯谈一谈。‡',
  }
},
[3789] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스태그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡Assister l\'archidruide Forteramure‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнасе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스태그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l’Archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[3790] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스태그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡Assister l\'archidruide Forteramure‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнасе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스태그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l’Archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[3791] = {
  {
    'O mistério do grão-matinal‡Тайна рассветницы‡Das Geheimnis des Morgenkorns‡여명초의 비밀‡El misterio de mañagrana‡El misterio de mañagrana‡Le Mystère des Fibres d\'aurore‡晨光麦的秘密‡晨光麥的秘密',
    nil,
    'Leve 10 Grãos-matinais para Quintis Jonespyre no Domínio de Plumaluna.‡Принесите 10 рассветниц друиду по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Bringt 10 Einheiten Morgenkorn zu Quintis Lebenshand in der Mondfederfeste.‡페더문 요새에 있는 퀸티스 존스파이어에게 여명초 10개를 가져가야 합니다.‡Lleva 10 plantas de mañagrana a Quintis Jonguja al Bastión Plumaluna.‡Lleva 10 plantas de mañagrana a Quintis Jonguja al Bastión Plumaluna.‡Apporter 10 Fibres d\'aurore à Quintis Gentecime au bastion de Pennelune.‡将10株晨光麦交给羽月要塞的奎恩提斯。‡將10株晨光麥交給羽月要塞的奎恩提斯。',
  }
},
[3792] = {
  {
    '‡Рассветница для Крепости Оперенной Луны‡Morgenkorn für die Mondfederfeste‡‡Mañagrana a Bastión Plumaluna‡Mañagrana a Bastión Plumaluna‡De la Fibre d\'aurore au bastion de Pennelune‡羽月要塞的晨光麦‡',
    nil,
    nil,
  }
},
[3801] = {
  {
    'Legado dos Ferro Negro‡Наследие Черного Железа‡Dunkeleisenerbe‡검은무쇠 부족의 유물‡El legado de los Hierro Negro‡El legado de los Hierro Negro‡Héritage Sombrefer‡黑铁的遗产‡黑鐵的遺產',
    nil,
    'Speak with Franclorn Forgewright at Forgewright\'s Tomb in Blackrock Mountain if you are interested in obtaining a key to the city major.‡Чтобы получить ключ от города, поговорите с Франклорном Искусником у гробницы Искусника на Черной горе.‡Sprecht mit Franclorn Schmiedevater bei Schmiedevaters Grabmal im Schwarzfels, wenn Ihr daran interessiert seid, einen Schlüssel für die Hauptstadt zu erhalten.‡도시 주요 지역으로 통하는 열쇠를 얻고 싶다면 검은바위 산의 포지라이트의 무덤에 있는 프랑클론 포지라이트와 대화해야 합니다.‡Habla con Franclorn Forjador en la Tumba de Forjador, en la Montaña Roca Negra, si te interesa obtener una llave de la ciudad.‡Habla con Franclorn Forjador en la Tumba de Forjador, en la Montaña Roca Negra, si te interesa obtener una llave de la ciudad.‡Parler à Franclorn Le Forgebusier à la Tombe du Forgebusier, au Mont Rochenoire, si obtenir une clé de la Cité majeure vous intéresse.‡如果你想要得到进入这座城市主城区的钥匙，就去和黑石山铸铁之墓的弗兰克罗恩·铸铁谈一谈。‡如果你想要得到進入這座城市主城區的鑰匙，就去黑石山的鑄鐵之墓，和弗蘭克羅恩·鑄鐵談話。',
  }
},
[3802] = {
  {
    'Legado dos Ferro Negro‡Наследие Черного Железа‡Dunkeleisenerbe‡검은무쇠 부족의 유물‡El legado de los Hierro Negro‡El legado de los Hierro Negro‡Héritage Sombrefer‡黑铁的遗产‡黑鐵的遺產',
    nil,
    'Mate Fineous Forçanegra e recupere o grande martelo Ferrovil. Leve-o para o Santuário de Thaurissan e coloque-o na estátua de Franclorn Forjífice.|n‡Убейте Финия Темностроя и добудьте великий молот, Железный Друг. Отнесите Железного Друга в святилище Тауриссана и вложите его в руки статуи Франклорна Искусника.‡Erschlagt Fineous Dunkelader und bergt den großen Hammer Eisenhölle. Bringt Eisenhölle zum Schrein von Thaurissan und legt ihn auf die Statue von Franclorn Schmiedevater.‡파이너스 다크바이어를 처치하고 거대한 망치, 무쇠지옥을 회수해야 합니다. 무쇠지옥을 타우릿산의 제단으로 가져가서 프랑클론 포지라이트의 석상에 두어야 합니다.‡Mata a Finoso Virunegro y recupera el gran martillo, Ferrovil. Lleva a Ferrovil al Santuario de Thaurissan y coloca el martillo en la estatua de Franclorn Forjador.|n‡Mata a Finoso Virunegro y recupera el gran martillo, Ferrovil. Lleva a Ferrovil al Santuario de Thaurissan y coloca el martillo en la estatua de Franclorn Forjador.|n‡Tuer Fineous Sombrevire et récupérer le grand marteau, Souillefer. Apporter Souillefer au sanctuaire de Thaurissan et le placer sur la statue de Franclorn Le Forgebusier.‡杀掉弗诺斯·达克维尔并拿回战锤铁胆。把铁胆之锤拿到索瑞森神殿去，将其放在弗兰克罗恩·铸铁的雕像上。‡殺掉弗諾斯·達克維爾並拿回戰錘鐵膽。把鐵膽之錘拿到索瑞森神殿去，將其放在弗蘭克羅恩·鑄鐵的雕像上。',
  }
},
[3803] = {
  {
    '‡Рассветница для Дарнаса‡Morgenkorn nach Darnassus‡‡Mañagrana para Darnassus‡Mañagrana para Darnassus‡De la fibre d\'aurore pour Darnassus‡达纳苏斯的晨光麦‡',
    nil,
    nil,
  }
},
[3804] = {
  {
    '‡Рассветница для Громового Утеса‡Morgenkorn nach Donnerfels‡‡Mañagrana para Cima del Trueno‡Mañagrana para Cima del Trueno‡Des Fibres d\'aurore pour les Pitons-du-Tonnerre‡雷霆崖的晨光麦‡',
