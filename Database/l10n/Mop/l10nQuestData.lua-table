},
[1249] = {
  {
    '‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡',
    nil,
    '‡Перехватите Яна Тапоке до его ухода и вернитесь к Михаилу.‡Schnappt Tapoke Slim Jahn, bevor er entkommt, und kehrt dann zu Mikhail in Menethil zurück.‡‡Vence a Tapoke Jahn antes de que escape y vuelve a ver a Mikhail en Menethil.‡Vence a Tapoke Jahn antes de que escape y vuelve a ver a Mikhail en Menethil.‡Soumettre Tapoke Jahn avant qu\'il ne s\'échappe et ensuite retourner voir Mikhail à Menethil.‡在塔伯克·贾恩逃跑前制服他，然后回米奈希尔港旅店去找米克哈尔。‡',
  }
},
[1250] = {
  {
    '‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡',
    nil,
    '‡Поговорите с Михаилом из Болотины.‡Sprecht mit Mikhail im Sumpfland.‡‡Habla con Mikhail en Los Humedales.‡Habla con Mikhail en Los Humedales.‡Parler à Mikhail dans les Paluns.‡与湿地的米克哈尔谈一谈。‡',
  }
},
[1251] = {
  {
    '[DEPRECATED]The Black Shield‡[DEPRECATED]The Black Shield‡[DEPRECATED] Der schwarze Schild‡검은 방패‡[DEPRECATED]El escudo negro‡‡[PÉRIMÉ]Le bouclier noir‡‡',
    nil,
    'Leve o Escudo de Ferro Enegrecido a Krog, na Aldeia Muralha Verde.‡Прнинесите почерневший железный щит Крогу в Деревню Гиблотопь.‡Bringt den geschwärzten Eisenschild zu Krog in Brackenwall.‡담쟁이 마을에 있는 크로그에게 검은 철제 방패를 가져가야 합니다.‡Lleva el escudo de hierro ennegrecido a Krog al Poblado Murohelecho.‡‡Rapportez le Bouclier en fer noirci à Krog, à Mur-de-Fougères.‡‡',
  }
},
[1252] = {
  {
    '‡‡Leutnant Paval Reethe‡‡[DEPRECATED]Teniente Paval Reethe‡‡[PÉRIMÉ]Le lieutenant Paval Reethe‡[DEPRECATED] 帕瓦尔·雷瑟上尉‡',
    nil,
    '‡Принесите бляху Рита капитану Гаррану Ваймсу в Терамор.‡Bringt Reethes Abzeichen zu Hauptmann Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스에게 리테의 배지를 가져가야 합니다.‡Lleva el distintivo de Reethe al capitán Garran Vimes de Theramore.‡Lleva el distintivo de Reethe al capitán Garran Vimes de Theramore.‡Rapporter le badge de Reethe au capitaine Garran Vimaire à Theramore.‡把雷瑟的徽章拿给塞拉摩的盖兰·维米斯队长。‡',
  }
},
[1253] = {
  {
    '‡‡[DEPRECATED] Der schwarze Schild‡‡[DEPRECATED]El escudo negro‡‡[PÉRIMÉ]Le Bouclier noir‡[DEPRECATED] 黑色盾牌‡',
    nil,
    '‡Принесите почерневший железный щит капитану Гаррану Ваймсу в Терамор.‡Bringt den geschwärzten Eisenschild zu Hauptmann Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스에게 검은 철제 방패를 가져가야 합니다.‡Lleva el escudo de hierro ennegrecido al capitán Garran Vimes a Theramore.‡Lleva el escudo de hierro ennegrecido al capitán Garran Vimes a Theramore.‡Rapportez le Bouclier en fer noirci au capitaine Garran Vimaire à Theramore.‡把被熏黑的铁盾牌交给塞拉摩的盖兰·维米斯队长。‡',
  }
},
[1258] = {
  {
    'Caranguejo não é peixe...‡…с крабами‡...und Käfer‡... 그리고 벌레‡...con tropezones‡...con tropezones‡... Et des bestioles‡还有螃蟹！‡...還有螃蟹',
    nil,
    'Leve 12 Patas Impecáveis de Rastejante a Morgado Severo em Theramore.‡Принесите 12 безупречных крабьих клешней Моргану Штерну в Терамор.‡Bringt 12 makellose Kriecherbeine zu Morgan Stern in Theramore.‡테라모어에 있는 모건 스턴에게 온전한 집게 다리 12개를 가져가야 합니다.‡Lleva 12 patas de reptador prístinas a Morgan Stern a Theramore.‡Lleva 12 patas de reptador prístinas a Morgan Stern a Theramore.‡Apporter 12 Pattes de Clampant en parfait état à Morgan Stern à Theramore.‡给塞拉摩的摩根·斯特恩收集12根新鲜的螃蟹腿。‡收集12隻生鮮的螃蟹腿給塞拉摩的摩根·斯特恩。',
  }
},
[1260] = {
  {
    '[DEPRECATED]Morgan Stern‡[DEPRECATED]Morgan Stern‡Morgan Stern‡[재사용]모건 스턴‡[DEPRECATED]Morgan Stern‡[DEPRECATED]Morgan Stern‡[PÉRIMÉ]Morgan Stern‡[DEPRECATED] 摩根·斯特恩‡[DEPRECATED]Morgan Stern',
    nil,
    'Fale com Morgado Severo em Theramore.‡Поговорите с Морганом Штерном в Тераморе.‡Sprecht mit Morgan Stern in Theramore.‡테라모어에 있는 모건 스턴과 대화해야 합니다.‡Habla con Morgan Stern en Theramore.‡Habla con Morgan Stern en Theramore.‡Parler à Morgan Stern à Theramore.‡和塞拉摩的摩根·斯特恩谈一谈。‡和塞拉摩的摩根·斯特恩談話。',
  }
},
[1261] = {
  {
    'Assim falou Marg‡Марг говорит‡Marg spricht‡말하는 마그‡Las declaraciones de Marg‡Las declaraciones de Marg‡Marg parle‡玛尔格的嘱托‡瑪格的囑託',
    nil,
    'Leve o Pingente Adornado para Nazir na Aldeia Muralha Verde.‡Принесите изукрашенную Подвеску Назиру в Деревню Гиблотопь.‡Bringt den juwelenbesetzten Anhänger zu Nazeer in Brackenwall.‡담쟁이 마을에 있는 나지르 블러드파이크에게 보석 펜던트를 가져가야 합니다.‡Lleva el colgante enjoyado a Nazeer al Poblado Murohelecho.‡Lleva el colgante enjoyado a Nazeer al Poblado Murohelecho.‡Apportez le Pendentif orné à Nazeer à Mur-de-Fougères.‡把宝石坠饰带给蕨墙村的纳泽尔·血矛。‡把寶石墜子交給蕨牆村的納澤爾·血矛。',
  }
},
[1262] = {
  {
    'Apresente-se a Zor‡Сообщение для Зора‡Bei Zor melden‡조르에게 보고하기‡Informa a Zor‡Informa a Zor‡Rapport à Zor‡向佐尔报告‡向佐爾報告',
    nil,
    'Leve o Pingente Adornado para Zor Solárbol em Orgrimmar.‡Отнесите изукрашенную подвеску Зору Одинокому Дереву в Оргриммар.‡Bringt den juwelenbesetzten Anhänger zu Zor Einbaum in Orgrimmar.‡오그리마에 있는 조르 론트리에게 보석 펜던트를 가져가야 합니다.‡Lleva el colgante enjoyado a Zor Árbol Solitario a Orgrimmar.‡Lleva el colgante enjoyado a Zor Árbol Solitario a Orgrimmar.‡Apportez le Pendentif orné à Zor Arbre-solitaire à Orgrimmar.‡把镶宝石饰品带给奥格瑞玛的佐尔·孤树。‡把鑲寶石的墜子帶給奧格瑪的佐爾·孤樹。',
  }
},
[1263] = {
  {
    '‡Сожженная Таверна‡Das brennende Gasthaus <ZU TRATSCH WECHSELN>‡불타는 여관‡La posada quemada <CHANGE TO GOSSIP>‡La posada quemada <CHANGE TO GOSSIP>‡L\'auberge en feu <CHANGE TO GOSSIP>‡燃烧的旅店‡',
