[27566] = {
  {
    '‡Собрание в Запределье‡Eine Versammlung in der Scherbenwelt‡아웃랜드 집결‡Una reunión en Terrallende‡‡Un rassemblement en Outreterre‡外域的聚会‡',
    nil,
    '‡Поговорите с Гаваном Серым Пером у Трона стихий в Награнде.‡Sprecht mit Gavan Graufeder am Thron der Elemente in Nagrand.‡나그란드 정령의 옥좌에 있는 가반 그레이페더와 대화해야 합니다.‡Habla con Gavan Plumagrís en el Trono de los Elementos en Nagrand.‡‡Parlez à Gavan Grise-Plume au Trône des éléments, en Nagrand.‡跟纳格兰元素王座的加文·灰羽谈一谈。‡',
  }
},
[27567] = {
  {
    'Crepúsculo?! Ah, não!‡Культ Сумеречного Молота?! О, нет!‡Schattenhammer?! Nein!‡이곳에 황혼의 망치단이?!‡¡¿Crepúsculo?! ¡No!‡¡¿Crepúsculo?! ¡No!‡Le Crépuscule ?! Non !‡暮光？不行！‡暮光?!不會吧!',
    nil,
    '"Interrogue" a Suprema Interrogadora Gerstahn.‡"Дознайте" правду у верховного дознавателя Герштан.‡"Verhört" Verhörmeisterin Gerstahn.‡대심문관 게르스탄을 "심문"해야 합니다.‡"Interroga" a la alta interrogadora Gerstahn.‡"Interroga" a la alta interrogadora Gerstahn.‡« Interrogez » la Grande interrogatrice Gerstahn.‡“审讯”审讯官格斯塔恩。‡「審問」高階審問者格斯塔恩。',
  }
},
[27568] = {
  {
    'Infiltrados na Cidade de Umbraforja‡Проникновение в Тенегорн‡Schattenschmiede unterwandern‡어둠괴철로 도시 잠입‡Infiltrarse en Ciudad Forjatiniebla‡Infiltrarse en Ciudad Forjatiniebla‡Infiltration dans la ville des Ombreforges‡潜入暗炉城‡滲透影爐城',
