[24804] = {
  {
    'Cheiros estranhos‡Необычные ароматы‡Ungewöhnliche Düfte‡수상한 냄새‡Olores extraños‡Olores extraños‡Des odeurs inhabituelles‡不正常的气味‡香水疑雲',
    nil,
    'Fale com o Inspetor Estrilo Garrafuso em Ventobravo.‡Отчитайтесь перед инспектором Кромсом Гвоздезубом в Штормграде.‡Meldet Euch bei Inspektor Snip Schnappbolz in Sturmwind.‡스톰윈드에 있는 수사반장 스닙 스내글볼트에게 보고해야 합니다.‡Preséntate ante el inspector Snip Tuerceganzúas en Ventormenta.‡Preséntate ante el inspector Snip Tuerceganzúas en Ventormenta.‡Faites votre rapport à l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡向暴风城的探员斯尼普·滑栓报告。‡到暴風城找巡官史尼卜·凸栓回報。',
  }
},
[24805] = {
  {
    'Cheiros estranhos‡Необычные ароматы‡Ungewöhnliche Düfte‡수상한 냄새‡Olores extraños‡Olores extraños‡Des odeurs inhabituelles‡不正常的气味‡香水疑雲',
    nil,
    'Fale com o Detetive Estalo Garrafuso em Orgrimmar.‡Отчитайтесь перед детективом Крямсом Гвоздезубом в Оргриммаре.‡Meldet Euch bei Detektiv Snap Schnappbolz in Orgrimmar.‡오그리마에 있는 명탐정 스냅 스내글볼트에게 보고해야 합니다.‡Preséntate ante el detective Snap Tuerceganzúas en Orgrimmar.‡Preséntate ante el detective Snap Tuerceganzúas en Orgrimmar.‡Faites votre rapport à l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡向奥格瑞玛的侦探斯奈普·滑栓报告。‡到奧格瑪找警探史內卜·凸栓回報。',
  }
},
[24806] = {
  {
    'Mais sorte da próxima vez‡Пусть тебе улыбнется удача – в другой раз!‡Mehr Glück beim nächsten Mal‡꽝, 다음 기회에‡Más suerte la próxima vez‡Más suerte la próxima vez‡Plus de chance la prochaine fois‡祝下次好运‡下次會更好',
