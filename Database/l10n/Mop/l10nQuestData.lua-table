[28027] = {
  {
    'Procuram-se aventureiros: Uldaman‡Требуются герои: Ульдаман‡Abenteurer gesucht: Uldaman‡모험가 모집: 울다만‡Se buscan aventureros: Uldaman‡Se buscan aventureros: Uldaman‡On recherche : des aventuriers pour Uldaman‡征召冒险者：奥达曼‡徵集冒險者:奧達曼',
    nil,
    'Fale com o Prospector-chefe Durdin.‡Поговорите со старшим геологом Дардином.‡Sprecht mit dem Oberausgrabungsleiter Durdin.‡선임 발굴조사단장 더딘과 대화해야 합니다.‡Habla con el prospector jefe Durdin.‡Habla con el prospector jefe Durdin.‡Parlez au Prospecteur en chef Durdin.‡与首席勘探员杜尔林交谈。‡和首席勘察員杜爾丁談話。',
  }
},
[28028] = {
  {
    'Cerco!‡Осада!‡Belagerung!‡포위 공격이다!‡¡Asedio!‡¡Asedio!‡Levez le siège !‡围攻！‡團團包圍!',
    nil,
    'Mate 9 Atiradores Peritos Ferro Negro.‡Убейте 9 стрелков из клана Черного Железа.‡Tötet 9 Schützen der Dunkeleisenzwerge.‡검은무쇠 명사수 9명을 처치해야 합니다.‡Mata a 9 tiradores Hierro Negro.‡Mata a 9 tiradores Hierro Negro.‡Tuez 9 Tireurs d’élite sombrefers.‡杀掉9名黑铁神射手。‡殺死9個黑鐵神射手。',
  }
},
[28029] = {
  {
    'Taca fogo neles!‡Задай им жару!‡Setzt sie in Brand!‡화염 공격!‡¡Préndeles fuego!‡¡Préndeles fuego!‡Allumer le feu !‡点着它们！‡燒掉它們!',
    nil,
    'Use a Tocha da Retribuição nas quatro torres ao redor do Caldeirão.‡При помощи факела воздаяния подожгите четыре башни, окружающие Котлован.‡Benutzt die Fackel der Vergeltung auf den vier Türmen, die den Kessel umgeben.‡용광로를 둘러싼 4개의 경비탑에 응보의 횃불을 사용해야 합니다.‡Usa la antorcha de reprensión en las cuatro torres que hay alrededor la Caldera.‡Usa la antorcha de reprensión en las cuatro torres que hay alrededor la Caldera.‡Utilisez la Torche de vindicte sur les quatre tours encerclant le Chaudron.‡用惩戒火炬点燃大熔炉附近的四座高塔。‡使用懲戒火炬點燃大熔爐周圍的四座塔。',
  }
},
[28030] = {
  {
    'A bala deles é melhor‡Пули у них отменные‡Eine bessere Kugel‡적군의 탄환‡Construyen mejores balas‡Construyen mejores balas‡Eh, mec ! T\'as pas deux cent balles ?‡他们的子弹造得比我们好‡他們的子彈比較好',
    nil,
    'Obtenha 200 Balas de Ferro Negro.‡Соберите 200 пуль Черного Железа.‡Beschafft Euch 200 Dunkeleisenkugeln.‡검은무쇠 탄환 200발을 획득해야 합니다.‡Consigue 200 balas Hierro Negro.‡Consigue 200 balas Hierro Negro.‡Obtenez 200 Balles sombrefers.‡获得200颗黑铁子弹。‡取得200顆黑鐵子彈。',
  }
},
[28031] = {
  {
    'Entrega especial para Pena Tabwa‡Особая посылка для Бривельверпа‡Sonderlieferung für Langnase‡브리블스워프를 위한 특별 배달‡Envío especial para Bridatuer‡Envío especial para Bridatuer‡Une livraison spéciale pour Bravorton‡给布里维普的特别货物‡給布里維普的特別快遞',
    nil,
    'Entregue o Canhão Criogênico de Pico-léguas para Pena Tabwa no Sítio Arqueológico Submerso, que fica em Mil Agulhas.‡Отнесите криопушку "Морозко" Бривельверпу на Затопленные раскопки в Тысяче Игл.‡Liefert die SchrEIS-Kryokanone an Langnase in der Versunkenen Ausgrabungsstätte in Tausend Nadeln.‡버섯구름 봉우리의 가라앉은 발굴현장에 있는 브리블스워프에게 나도꽁꽁 극저온대포를 가져가야 합니다.‡Entrégale el Criocañón E-lado a Bridatuer en la Excavación Sumergida, en Las Mil Agujas.‡Entrégale el Criocañón E-lado a Bridatuer en la Excavación Sumergida, en Las Mil Agujas.‡Livrez le Cryo-canon Gel-glace à Bravorton, au Site de fouilles englouti, dans les Mille pointes.‡将激冻冰弹交给千针石林沉没的挖掘场的布里维普。‡將驚聲尖嘯冷凍火砲帶去千針石林裡沉沒的挖掘場給布里維普。',
  }
},
[28032] = {
  {
    'Os mistérios da moela de fogo‡Тайны пламенной кишки‡Die Geheimnisse des Feuermuskelmagens‡불꽃 모래주머니의 비밀‡Los misterios de las mollejas de fuego‡Los misterios de las mollejas de fuego‡Les mystères du gésier-feu‡火囊的秘密‡火焰胃囊的奧秘',
    nil,
    'Obtenha 6 Moelas de Fogo.‡Добудьте 6 пламенных кишок.‡Sammelt 6 Feuermuskelmägen.‡불꽃 모래주머니 6개를 획득해야 합니다.‡Consigue 6 mollejas de fuego.‡Consigue 6 mollejas de fuego.‡Obtenez 6 Gésiers-feu.‡获得6副火囊。‡收集6個火焰胃囊。',
  }
},
[28033] = {
  {
    'Trapaça‡Обман‡Betrug‡속임수‡Engaño‡Engaño‡Parjure !‡说客‡詐欺',
    nil,
    'Encontre uma forma de convencer o Senhor da Montanha Rendan a se juntar à Irmandade do Tório.‡Найдите способ убедить горного владыку Рендана присоединиться к Братству Тория.‡Findet einen Weg, den Bergfürsten Rendan davon zu überzeugen, sich der Thoriumbruderschaft anzuschließen.‡산의 제왕 렌단이 토륨 대장조합에 합류하도록 설득할 방법을 찾아야 합니다.‡Encuentra la forma de convencer al señor de la montaña Rendan para que se una a la Hermandad del Torio.‡Encuentra la forma de convencer al señor de la montaña Rendan para que se una a la Hermandad del Torio.‡Trouvez le moyen de convaincre le Seigneur de la montagne Rendan de se rallier à la Confrérie du thorium.‡想办法说服山丘领主伦达恩加入瑟银兄弟会。‡找個方法說服山丘統領蘭登加入瑟銀兄弟會。',
  }
},
[28034] = {
  {
    'A aventura do Lanque: o ponto fraco do Rendan‡Приключения Чурбана: слабость Рендана‡Lunks Abenteuer: Rendans Schwäche‡돌머리의 모험: 렌단의 약점‡La aventura de Ñoño: la debilidad de Rendan‡La aventura de Ñoño: la debilidad de Rendan‡L’aventure de Benêt : le péché mignon de Rendan‡隆克的冒险：伦达恩的弱点‡郎克大冒險:蘭登的弱點',
    nil,
    'Fale com três Guardas do Auge Férreo e pergunte se eles querem participar da sua dança.‡Поговорите с тремя стражами Железной вершины и попросите их присоединиться к танцу.‡Sprecht mit drei Eisengipfelwachen und bittet sie, bei Eurem Tanz mitzumachen.‡강철 멧부리 경비병과 대화해 춤추는 것에 합류하도록 요청해야 합니다.‡Habla con tres guardias de Cima de Hierro y pídeles que se unan a tu baile.‡Habla con tres guardias de Cima de Hierro y pídeles que se unan a tu baile.‡Parlez à trois Gardes du sommet de Fer et demandez-leur d’entrer dans la danse.‡与三名铸铁峰守卫交谈，让他们加入你的舞蹈团。‡邀請三個黑鐵峰守衛和你一起跳舞。',
  }
},
[28035] = {
  {
    'O apoio do Senhor da Montanha‡Поддержка горного владыки‡Die Unterstützung des Bergfürsten‡산의 제왕의 원조‡El apoyo del Señor de la montaña‡El apoyo del Señor de la montaña‡Le concours du seigneur de la montagne‡山丘领主的支援‡山大王的協助',
    nil,
    'Reporte o seu sucesso ao Feitor Mão-de-graxa no Posto de Tório, que fica na Garganta Abrasadora.‡Отчитайтесь о вашем успехе надзирателю Скользоруку в лагере Братства Тория в Тлеющем ущелье.‡Berichtet Aufseher Schlickfaust auf der Thoriumsspitze in der Sengenden Schlucht von Eurem Erfolg.‡이글거리는 협곡의 토륨 거점에 있는 감독관 오일피스트에게 렌단을 합류시키는 것에 성공했다고 보고해야 합니다.‡Informa de tu éxito al sobrestante Puñaceite en el Puesto del Torio, en La Garganta de Fuego.‡Informa de tu éxito al sobrestante Puñaceite en el Puesto del Torio, en La Garganta de Fuego.‡Faites part du succès de votre mission au Surveillant Huilepoing à la Halte du Thorium, dans la Gorge des Vents brûlants.‡把你的成功报告给灼热峡谷瑟银哨塔的工头奥菲斯特。‡到灼熱峽谷的瑟銀哨塔，向監督者奧菲斯特報告你的成果。',
  }
},
[28036] = {
  {
    'Procuram-se aventureiros: Zul\'farrak‡Требуются герои: Зул\'Фаррак‡Abenteurer gesucht: Zul\'farrak‡모험가 모집: 줄파락‡Se buscan aventureros: Zul\'Farrak‡Se buscan aventureros: Zul\'Farrak‡On recherche : des aventuriers pour Zul\'farrak‡征召冒险者：祖尔法拉克‡徵集冒險者:祖爾法拉克',
    nil,
    'Fale com Tran\'rek.‡Поговорите с Тран\'реком.‡Sprecht mit Tran\'rek.‡트란렉과 대화해야 합니다.‡Habla con Tran\'rek.‡Habla con Tran\'rek.‡Parlez à Tran\'rek.‡与特兰雷克交谈。‡和特蘭雷克談話。',
  }
},
[28037] = {
  {
    'Procuram-se aventureiros: Zul\'farrak‡Требуются герои: Зул\'Фаррак‡Abenteurer gesucht: Zul\'farrak‡모험가 모집: 줄파락‡Se buscan aventureros: Zul\'Farrak‡Se buscan aventureros: Zul\'Farrak‡On recherche : des aventuriers pour Zul\'farrak‡征召冒险者：祖尔法拉克‡徵集冒險者:祖爾法拉克',
    nil,
    'Fale com Tran\'rek.‡Поговорите с Тран\'реком.‡Sprecht mit Tran\'rek.‡트란렉과 대화해야 합니다.‡Habla con Tran\'rek.‡Habla con Tran\'rek.‡Parlez à Tran\'rek.‡与特兰雷克交谈。‡和特蘭雷克談話。',
  }
},
[28038] = {
  {
    'Sangue sobre o Planalto‡Кровь на нагорье‡Blut im Hochland‡고원의 혈투‡Sangre en las Tierras Altas‡Sangre en las Tierras Altas‡Du sang sur les hautes-terres‡高地的竞技场‡高地的鮮血',
    nil,
    'Fale com Wodin, o Serviçal Troll, no Caldeirão da Carnificina, que fica no Planalto do Crepúsculo.‡Поговорите с троллем-прислужником Водином в Горниле Крови на Сумеречном нагорье.‡Sprecht mit Wodin dem Trolldiener am Schmelztiegel des Gemetzels im Schattenhochland.‡황혼의 고원 대학살의 도가니에 있는 하수인 우딘과 대화해야 합니다.‡Habla con Wodin el sirviente trol en el Crisol de Matanza en las Tierras Altas Crepusculares.‡Habla con Wodin, el sirviente trol, en el Crisol de Matanza en las Tierras Altas Crepusculares.‡Allez voir Wodin le Serviteur-troll au Creuset du carnage, dans les Hautes-terres du Crépuscule.‡跟暮光高地杀戮熔炉竞技场的巨魔仆从伍迪谈一谈。‡到暮光高地的兇殘之爐和『食人妖僕從』烏丁談談。',
  }
},
[28039] = {
  {
    'Procuram-se aventureiros: Maraudon‡Требуются герои: Мародон‡Abenteurer gesucht: Maraudon‡모험가 모집: 마라우돈‡Se buscan aventureros: Maraudon‡Se buscan aventureros: Maraudon‡On recherche : des aventuriers pour Maraudon‡征召冒险者：玛拉顿‡徵集冒險者:瑪拉頓',
    nil,
    'Fale com o Espírito de Zaetar.‡Поговорите с духом Зейтара.‡Sprecht mit Zaetars Geist.‡재타르의 영혼과 대화해야 합니다.‡Habla con el espíritu de Zaetar.‡Habla con el espíritu de Zaetar.‡Parlez à l\'Esprit de Zaetar.‡与扎尔塔的灵魂交谈。‡和札爾塔的靈魂談話。',
  }
},
[28040] = {
  {
    'Procuram-se aventureiros: Maraudon‡Требуются герои: Мародон‡Abenteurer gesucht: Maraudon‡모험가 모집: 마라우돈‡Se buscan aventureros: Maraudon‡Se buscan aventureros: Maraudon‡On recherche : des aventuriers pour Maraudon‡征召冒险者：玛拉顿‡徵集冒險者:瑪拉頓',
    nil,
    'Fale com o Espírito de Zaetar.‡Поговорите с духом Зейтара.‡Sprecht mit Zaetars Geist.‡재타르의 영혼과 대화해야 합니다.‡Habla con el espíritu de Zaetar.‡Habla con el espíritu de Zaetar.‡Parlez à l\'Esprit de Zaetar.‡与扎尔塔的灵魂交谈。‡和札爾塔的靈魂談話。',
  }
},
[28041] = {
  {
    'A isca perfeita‡Наживка для грифона‡Ködern und würgen‡날것 미끼‡Atraer y atrapar‡Atraer y atrapar‡Appâté... Capturé !‡诱饵‡哽死你的誘餌',
    nil,
    'Pegue uma Carcaça Fresca de Grifo.‡Добудьте свежую грифонью тушу.‡Besorgt einen frischen Greifenkadaver.‡방금 죽은 그리핀 시체를 구해야 합니다.‡Consigue un cadáver de grifo fresco.‡Consigue un cadáver de grifo fresco.‡Trouvez une Carcasse de griffon fraîche.‡取得一具新鲜的狮鹫残骸。‡取得新鮮的獅鷲獸屍體。',
  }
},
[28042] = {
  {
    'Entrega especial para Pena Tabwa‡Особая посылка для Бривельверпа‡Sonderlieferung für Langnase‡브리블스워프를 위한 특별 배달‡Envío especial para Bridatuer‡Envío especial para Bridatuer‡Une livraison spéciale pour Bravorton‡给布里维普的特别货物‡給布里維普的特別快遞',
    nil,
    'Entregue o Canhão Criogênico de Pico-léguas para Pena Tabwa no Sítio Arqueológico Submerso, que fica em Mil Agulhas.‡Отнесите криопушку "Морозко" Бривельверпу на Затопленные раскопки в Тысяче Игл.‡Liefert die SchrEIS-Kryokanone an Langnase in der Versunkenen Ausgrabungsstätte in Tausend Nadeln.‡버섯구름 봉우리의 가라앉은 발굴현장에 있는 브리블스워프에게 나도꽁꽁 극저온대포를 가져가야 합니다.‡Entrégale el Criocañón E-lado a Bridatuer en la Excavación Sumergida, en Las Mil Agujas.‡Entrégale el Criocañón E-lado a Bridatuer en la Excavación Sumergida, en Las Mil Agujas.‡Livrez le Cryo-canon Gel-glace à Bravorton, au Site de fouilles englouti, dans les Mille pointes.‡将激冻冰弹交给千针石林沉没的挖掘场的布里维普。‡將驚聲尖嘯冷凍火砲帶去千針石林裡沉沒的挖掘場給布里維普。',
  }
},
[28043] = {
  {
    'Como mutilar seu dragão‡Как искалечить своего дракона‡Drachen quälen leicht gemacht‡용 손봐주기‡Cómo domar a tu dragón‡Cómo domar a tu dragón‡Comment blesser votre dragon‡驯龙记‡如何折磨你的龍',
    nil,
    'Atraia um Draco Preto com uma isca, ataque-o até que fique fraco e cavalgue-o para voltar à Ravina de Sangue.‡Завлеките приманенного черного дракона, бейте его до тех пор, пока он не ослабнет, а затем летите на нем в Кровавое ущелье.‡Lockt einen geköderten Schwarzdrachen an, greift ihn an, bis er geschwächt ist und dann reitet ihn zurück zur Blutschlucht.‡미끼를 문 검은 비룡을 꾀어내 비룡이 약해질 때까지 공격한 후, 비룡을 타고 피투성이 협곡으로 돌아와야 합니다.‡Atrae a un draco negro cebado, atácalo hasta que esté débil, monta en él y vuelve a Garganta de Sangre.‡Atrae a un draco negro cebado, atácalo hasta que esté débil, monta en él y vuelve a Garganta de Sangre. ‡Attirez un Drake noir appâté, attaquez-le de manière à l\'affaiblir, puis montez-le jusqu\'au Goulet Sanglant.‡吸引一只被引诱的黑色幼龙，向它发起攻击直到幼龙进入虚弱状态，然后乘坐它返回溅血谷地。‡用餌引誘一隻上鉤的黑龍，對牠發動攻擊直到牠虛弱無法抵抗，然後騎著牠回到鮮血峽谷。',
  }
},
[28044] = {
  {
    'Toque o intocável‡Дотронуться до недосягаемого‡Das Unberührbare berühren‡만질 수 없는 물건을 만지는 방법‡Toca lo intocable‡Toca lo intocable‡Toucher l\'intouchable‡碰触所未及‡觸摸不可及',
    nil,
    'Use a Poção Sanguefase no Signo de Taecondrius para se deslocar para o éter e procure a Garra de Taecondrius.‡Встаньте на знак Тихондрия, воспользуйтесь межфазовым зельем крови, чтобы перенестись в Пустоту и найти коготь Тихондрия.‡Benutzt den Phasenbluttrank beim Siegelzeichen des Tichondrius, um in den Nether zu wechseln, und sucht nach der Klaue des Tichondrius.‡티콘드리우스의 징표에서 차원피 물약을 사용해 황천으로 위상 이동한 뒤, 티콘드리우스의 발톱을 찾아야 합니다.‡Usa la poción de sangre de fase en el sigilo de Tichondrius para poder entrar en el vacío y buscar la garra de Tichondrius.‡Usa la poción de sangre de fase en el sigilo de Tichondrius para poder entrar en el vacío y buscar la garra de Tichondrius.‡Utilisez la Potion de sang de phase au Cachet de Tichondrius pour pénétrer dans le vide et recherchez la Griffe de Tichondrius.‡在提克迪奥斯的魔印使用相位血气药水变换至虚空相位，寻找提克迪奥斯之爪。‡在提克迪奧斯符印上使用血相藥水，進入虛空尋找提克迪奧斯之爪。',
  }
},
[28045] = {
  {
    'O melhor sabor do mundo!‡Лучший в мире вкус!‡Der beste Geschmack der Welt!‡지상 최고의 맛‡¡El mejor sabor del mundo!‡¡El mejor sabor del mundo!‡Le meilleur parfum du monde !‡世上最棒的味道！‡世界上最棒的口味!',
    nil,
    'Consiga 8 Colheradas de Meleca de Silitídeo.‡Соберите 8 пригоршней слизи силитида.‡Erhaltet 8 Löffel Silithidenglibber.‡실리시드 점액질을 8 숟갈 모아야 합니다.‡Recoge 8 bolas de baba de silítido.‡Recoge 8 bolas de baba de silítido.‡Récupérez 8 Boules de bave silithide.‡收集8铲异种蝎粘液。‡收集8瓢異種蠍黏液。',
  }
},
[28046] = {
  {
    'Feche o caixão‡Завершение работы‡Bringt es zu Ende‡깔끔한 일 처리‡Termina el trabajo‡Termina el trabajo‡Il faut finir le boulot‡收尾工作‡完成工作',
    nil,
    'Mate 5 Soldados Incansáveis de Infantaria no Front Incansável. A frente fica no oeste da ilha, pouco antes da Colina Esquecida.‡От вас требуется уничтожить 5 неупокоенных пехотинцев на Передовой Неупокоенных. Это место расположено на западной стороне острова на подступах к Забытому холму.‡Tötet 5 rastlose Infanteristen an der Rastlosen Front. Ihr findet die Front auf der westlichen Seite der Insel, direkt vor dem Vergessenen Hügel.‡안식 없는 전초지에서 안식 없는 보병 5명을 처치해야 합니다. 안식 없는 전초지는 섬 서쪽, 잊어버린 언덕 북쪽에 있습니다.‡Mata a 5 soldados de la infantería inquieta en El Frente Inquieto. Encontrarás el frente en la zona oeste de la isla, justo antes de la Colina del Olvido.‡Mata a 5 soldados de la infantería inquieta en El Frente Inquieto. Encontrarás el frente en la zona oeste de la isla, justo antes de la Colina del Olvido.‡Tuez 5 Soldats d’infanterie sans repos au Front Sans-Repos. Vous trouverez le front sur la façade ouest de l’île, juste avant la Colline Oubliée.‡在不眠前线杀死5名不眠的步兵。不眠前线位于岛屿西侧，就在遗忘山丘前。‡到無寧前線去殺死5個焦躁的步兵。你可以在島嶼西邊找到這個前線，就在遺忘之丘前方。',
  }
},
[28047] = {
  {
    'Congelando os canos‡Заморозка труб‡Die Rohre einfrieren‡수송관 얼리기‡Congelar las tuberías‡Congelar las tuberías‡Geler les tuyaux‡冰冻管道‡急速冷凍輸送管',
    nil,
    'Use o Canhão Criogênico de Pico-léguas para congelar quatro canos dentro da caverna.‡С помощью криопушки "Морозко" заморозьте 4 трубы в пещере.‡Benutzt die SchrEIS-Kryokanone, um die vier Rohre in der Höhle einzufrieren.‡나도꽁꽁 극저온대포를 사용해 동굴 안에 있는 수송관 4개를 얼려야 합니다.‡Utiliza el Criocañón E-lado para congelar las cuatro tuberías del interior de la cueva.‡Utiliza el Criocañón E-lado para congelar las cuatro tuberías del interior de la cueva.‡Servez-vous du Cryo-canon Gel-glace pour geler les quatre tuyaux à l\'intérieur de la caverne.‡用激冻冰弹冰冻洞里的四处管道。‡用驚聲尖嘯冷凍火砲將四條洞穴外的輸送管急速冷凍。',
  }
},
[28048] = {
  {
    'Não sabe brincar, não desce pra caverna‡Умникам здесь не место‡Der Schwarmaufseher muss entfernt werden‡영리한 녀석 처리‡Hay que acabar con el listo‡Hay que acabar con el listo‡Celui-là est trop malin pour son propre bien‡先干掉聪明的家伙‡狡猾的那個必需離開',
    nil,
    'Mate o Controlador da Colmeia.‡Уничтожьте надсмотрщика улья.‡Töten den Schwarmaufseher.‡조종자 실리시드를 처치해야 합니다.‡Mata al controlador de colmena.‡Mata al controlador de colmena.‡Tuez le Contrôleur de la ruche.‡杀掉虫巢控制者。‡殺死蠍窩的指揮者。',
  }
},
[28049] = {
  {
    'Veja o invisível‡Увидеть невидимое‡Das Unsichtbare sehen‡투명한 걸 보는 방법‡Ver lo invisible‡Ver lo invisible‡Voir l\'invisible‡视见所未见‡看透無形',
    nil,
    'Colete 8 porções de Gosma Amaldiçoada das Ruínas de Constellas.‡Соберите 8 порций слизи проклятых слизнюков в руинах Констелласа.‡Sammelt 8 Einheiten verfluchten Schlamm aus den Ruinen von Constellas.‡콘스텔라스 폐허에 있는 저주받은 수액괴물을 8마리 모아야 합니다.‡Recoge 8 lotes de moco maldito de las Ruinas de Constellas.‡Recoge 8 lotes de moco maldito de las Ruinas de Constellas.‡Récupérez 8 échantillons de Limon maudit des Ruines de Constellas.‡从克斯特拉斯废墟收集8批被诅咒的软泥怪。‡到克斯特拉斯廢墟收集8份受詛軟泥。',
  }
},
[28050] = {
  {
    'Tubarão Adamastor‡Акула Амбал‡Tank, der Haifisch‡상어 탱크‡Tiburón Tanque‡Tiburón Tanque‡Le bac à requins‡巨鲨“坦克”‡鯊魚坦克',
    nil,
    'Você recebeu ordens para matar Adamastor, um tubarão enorme que aterroriza as águas do Cabo da Má Esperança. O cabo fica ao norte, seguindo pela costa.‡Вам поручено убить Амбала, гигантскую акулу, плавающую в водах у мыса Потерянной Надежды. Мыс расположен севернее, если идти вдоль береговой линии.‡Ihr habt den Auftrag erhalten, Tank, einen großen Hai, der die Gewässer um das Kap der Verloren Hoffnung durchpflügt, zu töten. Das Kap kann nördlich von hier gefunden werden, an der nördlichen Küste.‡잃어버린 희망의 곶을 휘젓고 다니는 거대한 상어 탱크를 처치해야 합니다. 잃어버린 희망의 곶은 바라딘 주둔지 북서쪽 해안에 있습니다.‡Te han pedido que mates a Tanque, un gran tiburón que recorre las aguas del Cabo de la Esperanza Perdida. El cabo se encuentra al norte de aquí, a lo largo de la costa norte.‡Te han pedido que mates a Tanque, un gran tiburón que recorre las aguas del Cabo de la Esperanza Perdida. El cabo se encuentra al norte de aquí, a lo largo de la costa norte.‡Tuez Pasquale, l’énorme requin qui sillonne les eaux du Cap de l’Espoir perdu. Le cap se trouve au nord.‡杀死在失落希望海角游弋的巨鲨坦克。失落希望海角位于此地以南的北部海岸线。‡你被賦予殺死坦克的任務。坦克是一隻在逝望角海域逡巡的巨大鯊魚。這個海角位於北方，沿北邊的海岸線走就可以找到。',
  }
},
[28051] = {
  {
    'Todos estão loucos... e mortos... por sorvete!‡Мы положили жизни за мороженое!‡Alle wollen Eiscreme... und finden den Tod!‡내 목숨을 아이스크림에!‡Todo el mundo se muere por un helado…‡Todo el mundo se muere por un helado…‡Glaciers pilés‡我们都吵着要冰激凌……然后就死了！‡我們都為了冰淇淋尖叫...然後死亡!',
    nil,
    'Prenda o gancho do reboque em 10 Empregados Mortos.‡Прицепите буксирный трос к телам 10 погибших рабочих.‡Befestigt den Haken des Abschleppseils an 10 toten Angestellten.‡죽은 인부 10명에게 갈고리를 걸어야 합니다.‡Engancha el cable del remolque a 10 empleados muertos.‡Engancha el cable del remolque a 10 empleados muertos.‡Attacher le câble du remorqueur à 10 Employés morts.‡把拖船的拖钩挂在10名死去的雇员身上。‡將繩索上的鉤子勾住10位死去的工人。',
  }
},
[28052] = {
  {
    'Operação: mexer o caldeirão‡Операция: переполох в Котловане‡Operation: Rührt den Kessel um‡작전명 용광로를 휘저어라‡Operación: remover la caldera‡Operación: remover la caldera‡Opération « Chaudron bouillonnant »‡行动：搅拌大熔炉‡行動:攪拌鍋子',
    nil,
    'Fale com o mestre de voo do Posto de Tório e, então, use as armas da Máquina Voadora da Irmandade para matar Defensores do Caldeirão até que a área esteja segura para entrar.‡Поговорите с распорядителем полетов Братства Тория, а затем воспользуйтесь орудиями ветролета Братства, чтобы убивать защитников Котлована, пока место посадки не станет безопасным.‡Sprecht mit dem Flugmeister der Thoriumsspitze und benutzt dann die Kanonen der Flugmaschine der Bruderschaft, um Kesselverteidiger zu töten, bis der Bereich sicher genug ist, um ihn zu betreten.‡토륨 거점의 비행 조련사와 대화한 후 대장조합 비행기의 기관포를 이용해 안전하게 착륙할 수 있을 때까지 용광로 경비병들을 처치해야 합니다.‡Habla con el maestro de vuelo del Puesto del Torio, luego usa las armas de fuego de la máquina voladora de la hermandad para matar a defensores de la caldera hasta que se pueda entrar en la zona de forma segura.‡Habla con el maestro de vuelo del Puesto del Torio, luego usa las armas de fuego de la máquina voladora de la hermandad para matar a defensores de la caldera hasta que se pueda entrar en la zona de forma segura.‡Parlez au maître de vol de la Halte du Thorium, puis utilisez les canons de la Machine volante de la Confrérie pour tuer des Défenseurs du chaudron jusqu’à ce que la zone soit sécurisée.‡跟瑟银哨塔的飞行管理员谈一谈，然后用兄弟会飞行器的机炮杀掉大熔炉防御者，直到该地区可以安全进入为止。‡和瑟銀哨塔的飛行管理員說話，然後使用兄弟會飛行器上的槍殺死熔爐防衛者，直到可以安全進入。',
  }
},
[28053] = {
  {
    'O Lanque gosta do seu estilo‡Чурбану нравится, что ты делаешь‡Lunk mag Euren Stil‡돌머리는 너 좋아해‡A Ñoño gustar tu estilo‡A Ñoño gustar tu estilo‡Benêt aime bien votre style‡隆克喜欢你的风格‡郎克喜歡你的風格',
    nil,
    nil,
  }
},
[28054] = {
  {
    'Escravidão é uma coisa feia‡Рабство – это плохо‡Reduzierung des Wettbewerbs‡노예를 부리는 건 나쁜 거야‡La esclavitud es mala‡La esclavitud es mala‡L’esclavage, c’est le mal‡奴隶制可不好‡奴隸制度不好',
    nil,
    'Mate 10 Capatazes Ferro Negro ou Feitores Ferro Negro.‡Убейте 10 надсмотрщиков или поработителей из клана Черного Железа.‡Tötet 10 Zuchtmeister der Dunkeleisenzwerge oder Sklavenhändler der Dunkeleisenzwerge.‡검은무쇠 감독관 또는 검은무쇠 노예상인 10명을 처치해야 합니다.‡Mata a 10 capataces Hiero Negro o esclavistas Hierro Negro.‡Mata a 10 capataces Hiero Negro o esclavistas Hierro Negro.‡Tuez 10 Sous-chefs ou Esclavagistes sombrefers.‡杀掉10名黑铁工头或黑铁奴隶贩子。‡殺死10個黑鐵監工或黑鐵奴隸販子。',
  }
},
[28055] = {
  {
    'Doce e horrível liberdade‡Сладкая горечь свободы‡Süße, furchtbare Freiheit‡달콤쌉싸름한 자유‡Dulce y horrible libertad‡Dulce y horrible libertad‡Une liberté qui dérange‡甜蜜、恐怖的自由‡甜蜜、可怕的自由',
    nil,
    'Liberte 12 Trabalhadores Escravos. Se eles resistirem, mate-os.‡Освободите 12 рабов-трудяг. Если они будут сопротивляться, убивайте их.‡Befreit 12 Sklavenarbeiter. Wenn sie sich widersetzen: Tötet sie.‡노예 일꾼 12명을 풀어줘야 합니다. 노예가 저항하면 처치하십시오.‡Libera a 12 trabajadores esclavos. Si se resisten, mátalos.‡Libera a 12 trabajadores esclavos. Si se resisten, mátalos.‡Libérez 12 Esclaves ouvriers. S’ils refusent la liberté que vous leur offrez, tuez-les.‡解救12名奴隶工。如果他们拒绝，就杀掉他们。‡釋放12名奴隸。如果他們抵抗的話，就殺死他們。',
  }
},
[28056] = {
  {
    'Erga-se, Obsidião‡Восстань, Обсидион‡Erhebt Euch, Obsidion‡일어나라, 흑요암이여!‡Álzate, Obsidion‡Álzate, Obsidion‡Lève-toi, Obsidion !‡复活吧，奥比斯顿‡起來吧，奧比斯頓',
    nil,
    'Use o Altar de Suntara e, então, mate Latórico, o Negro, e Obsidião.‡Воспользуйтесь алтарем Сунтары, а затем убейте Латорика Черного и Обсидиона.‡Benutzt den Altar von Suntara und tötet dann Lathoric den Schwarzen und Obsidion.‡선타라의 제단를 이용해 검은 라소릭과 흑요암을 처치해야 합니다.‡Usa el altar de Suntara, luego mata a Lathoric el Negro y a Obsidion.‡Usa el altar de Suntara, luego mata a Lathoric el Negro y a Obsidion.‡Utilisez l’Autel de Suntara, puis massacrez Lathoric le Noir et son golem, Obsidion.‡使用苏塔拉祭坛，然后杀掉黑衣拉索里克和奥比斯顿。‡使用桑塔拉祭壇，然後殺死黑衣拉索里克和奧比斯頓。',
  }
},
[28057] = {
  {
    'Mate-os de sono‡Казнь через лишение сна‡Tötet sie durch Schlafentzug‡수면 방해‡Mátalos privándolos de sueño‡Mátalos privándolos de sueño‡Privez-les de sommeil‡让他们死于睡眠不足‡讓他們失眠!',
    nil,
    'Obtenha 16 Travesseiros de Ferro Negro.‡Добудьте 16 подушек дворфов Черного Железа.‡Beschafft Euch 16 Dunkeleisenkissen.‡검은무쇠 베개 16개를 획득해야 합니다.‡Consigue 16 almohadas Hierro Negro.‡Consigue 16 almohadas Hierro Negro.‡Obtenez 16 Oreillers sombrefers.‡获取16个黑铁枕头。‡取得16個黑鐵枕頭。',
  }
},
[28058] = {
  {
    'Olha o tamanho disso!‡Размер имеет значение‡Wie groß das ist!‡엄청나게 큰 베개!‡¡Mira el tamaño de esto!‡¡Mira el tamaño de esto!‡Mais il est gigantesque !‡瞧它的尺码！‡看看它的個頭!',
    nil,
    'Leve o Travesseiro da Camareira Alma Fada para Evonice Fumarenta, na Garganta Abrasadora.‡Отнесите подушку горничной Крепкие Тиски Эвонис Сажекурке в Тлеющее ущелье.‡Bringt das Kissen von Zimmermädchen Kissenquetscher zu Evonice Rußraucher in der Sengenden Schlucht.‡이글거리는 협곡에 있는 에보니스 수트스모커에게 하녀 필라클렌처의 베개를 가져가야 합니다.‡Lleva la almohada de la ayudante de cámara Pilaprieta a Evonis Fumollín a La Garganta de Fuego.‡Lleva la almohada de la ayudante de cámara Pilaprieta a Evonis Fumollín a La Garganta de Fuego.‡Apportez l\'Oreiller de la Femme de chambre Pincetaie à Evonice Fumesuie, dans la Gorge des Vents brûlants.‡将比拉凯琳的枕头带给灼热峡谷的艾沃奈斯。‡將比拉凱琳的枕頭交給灼熱峽谷的艾沃奈斯。',
  }
},
[28059] = {
  {
    'A retomada do Forte‡Взятие крепости‡Einnahme der Festung‡요새 점령‡Reclamar la fortaleza‡Reclamar la fortaleza‡La reprise du donjon‡占领要塞‡取得城堡',
    nil,
    'Você recebeu ordens para matar o Castelão Farson no Forte Farson, que fica no norte da ilha.‡Вас просят убить начальника крепости Фарсона. Его крепость находится на северной стороне острова.‡Man hat Euch gebeten, Festungslord Farson in der Farsonfestung zu töten. Die Farsonfestung werdet Ihr auf der Nordseite der Insel finden.‡파슨 요새에서 요새 군주 파슨을 처치해야 합니다. 파슨 요새는 섬 북서쪽에 있습니다.‡Te han pedido que mates al señor de la fortaleza Farson en la Fortaleza de Farson. La Fortaleza de Farson se encuentra en la zona norte de la isla.‡Te han pedido que mates al señor de la fortaleza Farson en la Fortaleza de Farson. La Fortaleza de Farson se encuentra en la zona norte de la isla.‡Tuez le Seigneur du donjon Farson, au Bastion de Farson. Ce bastion se trouve au nord de l’île.‡杀死法尔森要塞的要塞领主法尔森。法尔森要塞位于岛屿北端。‡你被賦予到法森堡去殺死堡主法森的任務。你可以在島嶼北方找到法森堡。',
  }
},
[28060] = {
  {
    'Laços retorcidos do crepúsculo‡Запутанные связи Сумрака‡Zwielichtige Zwielichtbande‡꼬여버린 황혼의 매듭‡Retorcidos lazos Crepusculares‡Retorcidos lazos Crepusculares‡Un visiteur crépusculaire‡扭曲的关系‡扭曲的暮光束縛',
    nil,
    'Fale com o Hansel Mão-pesada e ajude-o a atacar o Feitor Maltorius e o Lorde do Crepúsculo Arkkus.‡Поговорите с Ханселом Большеруком и помогите ему напасть на надзирателя Мальтория и сумеречного лорда Арккуса.‡Sprecht mit Hansel Bleihand und helft ihm, Aufseher Maltorius und Zwielichtfürst Arkkus zu bekämpfen.‡한셀 헤비핸드와 대화해 그가 감독관 말토류스와 황혼군주 아르쿠스를 처치하는 것을 도와야 합니다.‡Habla con Hansel Manospesadas y ayúdale a atacar al sobrestante Maltorius y al señor Crepuscular Arkkus.‡Habla con Hansel Manospesadas y ayúdale a atacar al sobrestante Maltorius y al señor Crepuscular Arkkus.‡Parlez à Hansel Lourdemains et aidez-le à massacrer le Surveillant Maltorius et le Seigneur du crépuscule Arkkus.‡跟汉瑟尔·重拳交谈，帮助他攻打工头玛托留斯和暮光领主阿卡库斯。‡與漢瑟爾·重拳交談並幫助他突襲監督者瑪托留斯和暮光領主阿爾庫斯。',
  }
},
[28061] = {
  {
    'Lacaios de Calcinder‡Приспешники Кальциндера‡Calcinders Handlanger‡칼신더의 부하들‡Esbirros de Rescoldo‡Esbirros de Rescoldo‡Les sous-fifres de Calcibraise‡卡尔烬德大公的爪牙‡卡爾希德的爪牙',
    nil,
    'Mate 6 Flamespectros Abrasadores.‡Убейте 6 пламенных призраков.‡Tötet 6 sengende Flammengespenster.‡이글거리는 화염망령 6마리를 처치해야 합니다.‡Mata a 6 espantos de llama abrasadores.‡Mata a 6 espantos de llama abrasadores.‡Tuez 6 Âmes en peine en flammes incendiaires.‡消灭6名灼热烈焰幽魂。‡殺死6隻灼熱火焰怨靈。',
  }
},
[28062] = {
  {
    'De onde ele veio‡Туда, откуда он пришел‡Woher er kam‡칼신더 추방‡De donde vino‡De donde vino‡Qu’il retourne d’où il vient‡送回老家‡從他所來之處',
    nil,
    'Enfraqueça o Arquiduque Calcinder e, então, use a Tripetricina Consagrada para bani-lo.‡Добейтесь того, чтобы эрцгерцог Кальциндер ослаб, а затем воспользуйтесь освященным триоцитом, чтобы изгнать его.‡Schwächt Erzherzog Calcinder und setzt dann den Geweihten Tripetrizin ein, um ihn zu verbannen.‡대공작 칼신더를 약화시킨 뒤에 신성한 삼중석을 사용해 그를 추방해야 합니다.‡Debilita al archiduque Rescoldo, luego usa la tripeticina consagrada para desterrarlo.‡Debilita al archiduque Rescoldo, luego usa la tripeticina consagrada para desterrarlo.‡Affaiblissez l’Archiduc Calcibraise, puis utilisez la Tripetricine consacrée pour le bannir.‡削弱卡尔烬德大公，然后用神圣三色宝珠将其放逐。‡削弱卡爾希德大公，然後使用聖化三體石將他放逐。',
  }
},
[28063] = {
  {
    'Armas recauchutadas‡Забрать все оружие‡Lasst keine Waffen zurück‡무기를 남기지 말라‡Hasta la última arma‡Hasta la última arma‡Ne laissez rien derrière vous‡绝不浪费武器‡別留下武器',
    nil,
    'Obtenha 12 Rifles Enferrujados no Forte Farson, que fica no norte da Península de Tol Barad.‡Вам поручили забрать 12 ржавых винтовок из Крепости Фарсона, расположенной в северной части полуострова Тол Барад.‡Besorgt 12 rostige Gewehre aus Burg Farson auf der Nordseite der Halbinsel von Tol Barad.‡톨 바라드 반도 북쪽에 있는 파슨 요새에서 녹슨 소총 12자루를 모아야 합니다.‡Recoge 12 rifles oxidados en la Fortaleza de Farson en la zona norte de la Península de Tol Barad.‡Recoge 12 rifles oxidados en la Fortaleza de Farson en la zona norte de la Península de Tol Barad.‡Récupérez 12 Carabines rouillées au Bastion de Farson, au nord de la Péninsule de Tol Barad.‡从托尔巴拉德日常区域北端的法尔森要塞取回12支生锈的步枪。‡到托巴拉德半島北方的法森堡取回8隻生鏽的步槍。',
  }
},
[28064] = {
  {
    'Boas-vindas à Irmandade‡Добро пожаловать в Братство‡Willkommen in der Bruderschaft‡토륨 대장조합의 일원‡Bienvenidos a la hermandad‡Bienvenidos a la hermandad‡Bienvenue dans la Confrérie‡欢迎来到兄弟会‡歡迎加入兄弟會',
    nil,
    'Fale com o Feitor Mão-de-graxa no Posto de Tório, que fica na Garganta Abrasadora.‡Отчитайтесь надзирателю Скользоруку в Братстве Тория, что в Тлеющем ущелье.‡Erstattet Aufseher Schlickfaust auf der Thoriumsspitze in der Sengenden Schlucht Bericht.‡이글거리는 협곡의 토륨 거점에 있는 감독관 오일피스트에게 보고해야 합니다.‡Preséntate ante el sobrestante Puñaceite en el Puesto del Torio en la Garganta de Fuego.‡Preséntate ante el sobrestante Puñaceite en el Puesto del Torio en la Garganta de Fuego.‡Retournez voir le Surveillant Huilepoing à la Halte du Thorium, dans la Gorge des Vents brûlants.‡去找灼热峡谷瑟银哨塔的工头奥菲斯特。‡到灼熱峽谷的瑟銀哨塔向監督者奧菲斯特回報。',
  }
},
[28065] = {
  {
    '‡По вражеским тропам‡In ihrer Haut‡파슨 요새 포로 구출‡Ponte en su pellejo durante un tiempo‡‡Une bonne balade en bord de mer‡‡',
    nil,
    '‡Сопроводите заключенного Крепости Фарсона в безопасное место. Данная крепость расположена в северо-западной части острова.‡Bringt einen Gefangenen der Farsonfestung in Sicherheit. Die Festung befindet sich am nordwestlichen Spize der Insel.‡파슨 요새 포로를 안전한 곳으로 호위해야 합니다. 요새는 섬 북서쪽에 있습니다.‡Escolta al prisionero de la Fortaleza de Farson hasta lugar seguro. La fortaleza se encuentra en el extremo norte de la isla.‡‡Escortez un prisonnier du Bastion de Farson jusqu\'en lieu sûr. Le bastion se trouve à l\'extrémité nord-ouest de l\'île.‡‡',
  }
},
[28066] = {
  {
    'Procuram-se aventureiros: o Templo Submerso‡Требуются герои: Затонувший храм‡Abenteurer gesucht: Der Versunkene Tempel‡모험가 모집: 가라앉은 사원‡Se buscan aventureros: El Templo Sumergido‡Se buscan aventureros: El Templo Sumergido‡On recherche : des aventuriers pour le temple Englouti‡征召冒险者：沉没的神庙‡徵集冒險者:沉沒的神廟',
    nil,
    'Fale com Lorde Itharius.‡Обратитесь к лорду Итару.‡Sprecht mit Lord Itharius.‡군주 이타리우스와 대화해야 합니다.‡Habla con Lord Itharius.‡Habla con Lord Itharius.‡Parlez au Seigneur Itharius.‡与伊萨里奥斯勋爵交谈。‡和伊薩里奧斯領主談話。',
  }
},
[28067] = {
  {
    'Procuram-se aventureiros: o Templo Submerso‡Требуются герои: Затонувший храм‡Abenteurer gesucht: Der Versunkene Tempel‡모험가 모집: 가라앉은 사원‡Se buscan aventureros: El Templo Sumergido‡Se buscan aventureros: El Templo Sumergido‡On recherche : des aventuriers pour le temple Englouti‡征召冒险者：沉没的神庙‡徵集冒險者:沉沒的神廟',
    nil,
    'Fale com Lorde Itharius.‡Обратитесь к лорду Итару.‡Sprecht mit Lord Itharius.‡군주 이타리우스와 대화해야 합니다.‡Habla con Lord Itharius.‡Habla con Lord Itharius.‡Parlez au Seigneur Itharius.‡与伊萨里奥斯勋爵交谈。‡和伊薩里奧斯領主談話。',
  }
},
[28068] = {
  {
    'Procura-se aventureiros: Abismo Rocha Negra‡Требуются герои: Глубины Черной горы‡Abenteurer gesucht: Schwarzfelstiefen‡모험가 모집: 검은바위 나락‡Se buscan aventureros: Profundidades de Roca Negra‡Se buscan aventureros: Profundidades de Roca Negra‡On recherche : des aventuriers pour les profondeurs de Rochenoire‡征召冒险者：黑石深渊‡徵集冒險者:黑石深淵',
    nil,
    'Fale com Morgan.‡Поговорите с Морганой.‡Sprecht mit Morgan.‡모건과 대화해야 합니다.‡Habla con Morgan.‡Habla con Morgan.‡Parlez à Morgan.‡与摩根交谈。‡和摩根談話。',
  }
},
[28069] = {
  {
    'Procura-se aventureiros: Abismo Rocha Negra‡Требуются герои: Глубины Черной горы‡Abenteurer gesucht: Schwarzfelstiefen‡모험가 모집: 검은바위 나락‡Se buscan aventureros: Profundidades de Roca Negra‡Se buscan aventureros: Profundidades de Roca Negra‡On recherche : des aventuriers pour les profondeurs de Rochenoire‡征召冒险者：黑石深渊‡徵集冒險者:黑石深淵',
    nil,
    'Fale com o Alto-carrasco Nuzrak.‡Поговорите с верховным палачом Нузраком.‡Sprecht mit Oberhenker Nuzrak.‡대집행자 누즈라크와 대화해야 합니다.‡Habla con el sumo verdugo Nuzrak.‡Habla con el sumo verdugo Nuzrak.‡Parlez au Bourreau suprême Nuzrak.‡与执行官努兹拉克交谈。‡和高階劊子手努茲拉克談話。',
  }
},
[28070] = {
  {
    'Procura-se aventureiros: Pico da Rocha Negra‡Требуются герои: Пик Черной горы‡Abenteurer gesucht: Schwarzfelsspitze‡모험가 모집: 검은바위 첨탑‡Se buscan aventureros: Cumbre de Roca Negra‡Se buscan aventureros: Cumbre de Roca Negra‡On recherche : des aventuriers pour le pic Rochenoire‡征召冒险者：黑石塔‡徵集冒險者:黑石塔',
