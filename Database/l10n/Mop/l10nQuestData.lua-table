[30298] = {
  {
    'Pintando as ruínas de vermelho‡Руины в красном цвете‡Die Ruinen in Blut tränken‡폐허를 붉게 물들이기‡Pintar las ruinas de rojo‡‡Meurtre dans les ruines‡‡',
    nil,
    'Mate 8 mogus nas Ruínas de Guo-Lai. Uma‡Убейте 8 могу на руинах Го-Лай.‡Tötet 8 Mogu in den Guo-Lai-Ruinen.‡구오라이 폐허에서 모구 8명을 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata a 8 mogu en las Ruinas de Guo-Lai.‡‡Tuez 8 Mogu dans les Ruines de Guo-Lai.‡‡',
  }
},
[30299] = {
  {
    'E que não reste pedra sobre pedra!‡Все средства хороши‡Kein Stein auf dem anderen lassen‡깨지지 않는 돌은 없지‡Quedarse de piedra‡‡À pierre fendre‡‡',
    nil,
    'Destrua 6 Estátuas Mogus. Uma‡Разрушьте 6 статуй могу.‡Zerstört 6 Mogustatuen.‡모구 석상 6개를 파괴해야 합니다. 레벨 1 영원꽃 골짜기‡Destruye 6 estatuas mogu.‡‡Détruisez 6 Statues mogu.‡‡',
  }
},
[30300] = {
  {
    'A chave do sucesso‡Ключ к успеху‡Schlüssel zum Erfolg‡‡Dónde están las llaves‡‡La clé du succès‡成功之匙‡',
    nil,
    'Encontre uma Chave da Jaula Shao-Tien e liberte 6 Prisioneiros do Lótus Dourado. Uma‡Найдите ключ от клетки Шао-Тень и освободите 6 пленников Золотого Лотоса. задание.‡Findet den Shao-Tien-Käfigschlüssel und befreit 6 Gefangene des Goldenen Lotus.‡‡Busca una llave de jaula Shao-Tien y libera a 6 prisioneros del Loto Dorado.‡‡Trouvez une Clé de cage shao-tien et libérez 6 Prisonniers du Lotus doré.‡找到韶天囚笼钥匙，释放6名金莲囚犯。‡',
  }
},
[30301] = {
  {
    'Calorosas boas-vindas‡Теплый прием‡Ein warmer Willkommensgruß‡따끈한 환대‡Una cálida bienvenida‡‡Offrir un accueil chaleureux‡‡',
    nil,
    'Queime 6 Tendas Mogus nas Ruínas de Guo-Lai. Uma‡Сожгите 6 палаток могу в руинах Го-Лай.‡Verbrennt 6 Moguzelte in den Guo-Lai-Ruinen.‡구오라이 폐허에서 모구 천막 6개를 태워야 합니다. 레벨 1 영원꽃 골짜기‡Reduce a cenizas 6 tiendas mogu en las Ruinas de Guo-Lai.‡‡Brûlez 6 Tentes mogu dans les Ruines de Guo-Lai.‡‡',
  }
},
[30302] = {
  {
    'A ameaça Impérion‡Опасный империон‡Die Imperion-Bedrohung‡통치자의 위협‡La amenaza imperión‡‡Impérion pour attendre‡‡',
    nil,
    'Mate o Impérion Shao-Tien. Uma‡Убейте империона Шао-Тень.‡Tötet den Shao-Tien-Imperion.‡샤오티엔 통치자를 처치해야 합니다. 레벨 1 영원꽃 골짜기‡Mata al imperión Shao-Tien.‡‡Tuez l’Impérion shao-tien.‡‡',
  }
},
[30303] = {
  {
    'NOT USED‡NOT USED‡NOT USED‡미사용‡NOT USED‡‡INUTILISÉ‡杀死指定的魔古杂种首领（对两个首领使用战士任务）‡',
