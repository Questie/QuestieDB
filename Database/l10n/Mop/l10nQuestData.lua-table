[25486] = {
  {
    'Os Temível Totem estão chegando!‡Клан Зловещего Тотема наступает‡Die Grimmtotem kommen‡그림토템 부족이 온다‡Vienen los Tótem Siniestro‡Vienen los Tótem Siniestro‡Les Totems-sinistres entrent en scène‡恐怖图腾来了‡恐怖圖騰來了',
    nil,
    'Mate 7 Espoliadores Temível Totem.‡Убейте 7 мародеров из клана Зловещего Тотема.‡Tötet 7 Marodeure der Grimmtotem.‡그림토템 약탈자 7마리를 처치해야 합니다.‡Mata 7 maleantes Tótem Siniestro.‡Mata 7 maleantes Tótem Siniestro.‡Tuez 7 Maraudeurs du Totem-sinistre.‡消灭7名恐怖图腾掠夺者。‡殺死7個恐怖圖騰掠奪者。',
  }
},
[25487] = {
  {
    'Os Temível Totem estão chegando!‡Клан Зловещего Тотема наступает‡Die Grimmtotem kommen‡그림토템 부족이 온다‡Vienen los Tótem Siniestro‡Vienen los Tótem Siniestro‡Les Totems-sinistres entrent en scène‡恐怖图腾来了‡恐怖圖騰來了',
    nil,
    'Mate 7 Pilhadores Temível Totem.‡Убейте 7 погромщиков из клана Зловещего Тотема.‡Tötet 7 Plünderer der Grimmtotem.‡그림토템 강탈자 7마리를 처치해야 합니다.‡Mata 7 saqueadores Tótem Siniestro.‡Mata 7 saqueadores Tótem Siniestro.‡Tuez 7 Pilleurs du Totem-sinistre.‡消灭7名恐怖图腾抢劫者。‡殺死7個恐怖圖騰掠取者。',
  }
},
[25488] = {
  {
    'O Barcódromo‡Двое в лодке‡Zwei per Boot‡둘이서 노를 저어라‡Dos a la deriva‡Dos a la deriva‡Combien de marins…‡有船在事半功倍‡同船渡',
    nil,
    'Fale com Xabu Latafuso no Barcódromo do Xabu e do Relé em Mil Agulhas.‡Поговорите с Пшиксом Медноштифом на гоночной барже Пшикса и Поззика в Тысяче Игл.‡Sprecht mit Fizzel Kupferbolz auf Fizzels & Pozziks Turbodampfer in Tausend Nadeln.‡버섯구름 봉우리에 있는 피즐과 포직의 쾌속선의 피즐 브라스볼츠와 대화해야 합니다.‡Habla con Fizzle Pernolatón en el Barcódromo de Fizzle y Pozzik, en Las Mil Agujas.‡Habla con Fizzle Pernolatón en el Barcódromo de Fizzle y Pozzik, en Las Mil Agujas.‡Parlez à Féplouf Zéboulon sur la Péniche de course de Féplouf et Pozzik, dans les Mille pointes.‡同千针石林菲兹尔和普兹克的赛艇平台上的菲兹尔·铜栓交谈。‡到千針石林的菲茲爾與普茲克的高速駁船找菲茲爾·銅栓說話。',
  }
},
[25489] = {
  {
    'O Barcódromo‡Двое в лодке‡Zwei per Boot‡둘이서 노를 저어라‡Dos a la deriva‡Dos a la deriva‡Combien de marins…‡有船在事半功倍‡同船渡',
    nil,
    'Fale com Relé no Barcódromo do Xabu e do Relé em Mil Agulhas‡Поговорите с Поззиком на гоночной барже Пшикса и Поззика в Тысяче Игл.‡Sprecht mit Pozzik auf Fizzels & Pozziks Turbodampfer in Tausend Nadeln.‡버섯구름 봉우리에 있는 피즐과 포직의 쾌속선의 포직과 대화해야 합니다.‡Habla con Pozzik en el Barcódromo de Fizzle y Pozzik, en Las Mil Agujas.‡Habla con Pozzik en el Barcódromo de Fizzle y Pozzik, en Las Mil Agujas.‡Parlez à Pozzik à bord de la Péniche de course de Féplouf et Pozzik, dans les Mille pointes.‡同千针石林菲兹尔和普兹克的赛艇平台上的普兹克交谈。‡到千針石林的瑞茲爾與普茲克的高速駁船和普茲克說話。',
  }
},
[25490] = {
  {
    'Ataque entre cinzas‡Путь по пеплу‡Asche auf ihr Haupt‡잿더미를 헤치고‡Destrozos entre las cenizas‡Destrozos entre las cenizas‡La foi du charbonnier‡杀出一条灰路‡衝破灰燼',
    nil,
    'Mate 8 Carbonizadores.‡Убейте 8 обжигающих.‡Tötet 8 Versenger.‡그을음술사 8마리를 처치해야 합니다.‡Mata a 8 chamuscadores.‡Mata a 8 chamuscadores.‡Tuez 8 Charbonniers.‡杀死8名灼炎使者。‡殺死8個焦炭使者。',
  }
},
[25491] = {
  {
    'Sementes resistentes‡Живучие ростки‡Robuste Saat‡생명의 씨앗‡Semillas duraderas‡Semillas duraderas‡Des graines rustiques‡顽强的生命‡堅忍的種子',
    nil,
    'Colete 10 Mudas de Hyjal de pilhas de Terra Calcinada.‡Соберите 10 хиджальских ростков, лежащих в кучах выжженной земли.‡Sammelt 10 Hyjalsetzlinge aus den Haufen versengter Erde.‡불타버린 흙에서 하이잘 새싹을 10개 수집해야 합니다.‡Reúne 10 esquejes de Hyjal de los montones de suelo agostado.‡Reúne 10 esquejes de Hyjal de los montones de suelo agostado.‡Récoltez 10 Boutures d’Hyjal sur le Sol calciné.‡从焦黑的土壤中收集10株海加尔幼苗。‡從成堆焦黑的土壤收集10株海加爾山幼苗。',
  }
},
[25492] = {
  {
    'Aceiro‡Борьба с огнем‡Feuerschneise‡더 이상의 피해는‡Cortafuegos‡Cortafuegos‡Ignifugation‡防火道‡防火線',
    nil,
    'Mate 10 Irrompedores de Lava.‡Уничтожьте 10 лавовых волноплесков.‡Tötet 10 Lavawoger.‡굽이치는 용암 정령 10마리를 처치해야 합니다.‡Mata a 10 mareas de lava.‡Mata a 10 mareas de lava.‡Tuez 10 Surgisseurs de lave.‡消灭10个熔岩奔腾者。‡消滅10個熔岩奔騰者。',
  }
},
[25493] = {
  {
    'Buchada de cão-magma‡Свежая наживка‡Frische Köder‡신선한 미끼‡Cebo fresco‡Cebo fresco‡Un appât appétissant‡活饵‡鮮餌',
    nil,
    'Recolha 4 Pilhas de Entranhas de Cão-magma.‡Соберите 4 кучи внутренностей гончей Недр.‡Sammelt 4 Kernhundinnereien.‡심장부 사냥개 내장 무더기 4개를 수집해야 합니다.‡Reúne 4 fardos de entrañas de can del Núcleo.‡Reúne 4 fardos de entrañas de can del Núcleo.‡Récoltez 4 tas d’Entrailles de chien du magma.‡获得4堆熔火恶犬的内脏。‡收集4堆熔核犬的腸子。',
  }
},
[25494] = {
  {
    'A coleira dos campeões‡Ошейник чемпиона‡Ein Halsband für einen Champion‡될성부른 투견은 목줄부터 다르다‡Una collera de campeón‡Una collera de campeón‡Un collier de terreur‡冠军项圈‡冠軍的項圈',
    nil,
    'Pegue o Pelego Espinhoso de Basilisco da Matriarca Espinhescama.‡Убейте чешуеспинного матриарха и добудьте шипастую шкуру василиска.‡Besorgt Euch die stachelige Basiliskenhaut von der Dornenschuppenmatriarchin.‡가시비늘 우두머리로부터 가시 바실리스크 가죽을 얻어야 합니다.‡Obtén el pellejo de basilisco con pinchos de la matriarca Escamaespina.‡Obtén el pellejo de basilisco con pinchos de la matriarca Escamaespina.‡Obtenez une Peau de basilic à pointes en tuant la Matriarche épinécaille.‡从脊鳞蜥蜴女王身上获得带刺的蜥蜴皮。‡從脊鱗族母那裡取得帶刺的蜥蜴皮。',
  }
},
[25495] = {
  {
    'Preparação para guerra‡Подготовка к битве‡Vorbereitung auf die Schlacht‡전투 준비‡Preparándose p\'a la batalla‡Preparándose p\'a la batalla‡Préparation au combat‡战争准备‡開戰準備',
    nil,
    'Peça um voo para o Tratador Marnlek até a área de concentração de tropas. Encontre Vol\'jin na ilha a leste do campo de guerra.‡Встретьтесь с Вол\'джином на острове к востоку от военного лагеря. Если вам нужен транспорт, поговорите с укротителем Марнлеком.‡Sprecht mit Tierführer Marnlek, um einen Flug zum Sammelpunkt zu bekommen. Trefft Euch auf der Insel östlich des Kriegslagers mit Vol\'jin.‡조련사 만렉과 대화하고 집결지로 날아가십시오. 전투 야영지 동쪽에 있는 섬에서 볼진을 만나야 합니다.‡Habla con el cuidador Marnlek para volar hasta la zona de escala. Encuéntrate con Vol\'jin en la isla al este del campamento de guerra.‡Habla con el cuidador Marnlek para volar hasta la zona de escala. Encuéntrate con Vol\'jin en la isla al este del campamento de guerra.‡Parlez au Dresseur Marnlek pour obtenir un vol vers la zone de rassemblement. Retrouvez Vol\'jin sur l\'île à l\'est du Camp de guerre.‡同管理员曼雷克交谈，乘蝙蝠飞到集结地去。在战争营地东边的岛屿上与沃金会面。‡和蝙蝠管理員馬恩雷克交談以前往集結區域。在戰爭營地東邊的島上和沃金碰面。',
  }
},
[25496] = {
  {
    'O meu é maior que o seu‡Матч-реванш‡Erbitterter Zweikampf‡복수혈전‡¡Pelea!‡¡Pelea!‡Règlement de comptes au Siège de l\'Élu‡嫌隙之赛‡怨仇對決',
    nil,
    'Desafie Gromm\'ko no Trono dos Escolhidos, em Hyjal.‡Бросьте вызов огру по имени Громм\'ка в Совете Избранных на Хиджале.‡Fordert Gromm\'ko am Sitz der Auserwählten auf dem Hyjal heraus.‡하이잘의 선택받은 자의 보좌에서 그롬코에게 도전해야 합니다.‡Desafía a Gromm\'ko en el Trono de los Elegidos en Hyjal.‡Desafía a Gromm\'ko en el Trono de los Elegidos en Hyjal.‡Défiez Gromm’ko au Siège de l’Élu, à Hyjal.‡挑战海加尔山天选者之座的格罗姆克。‡在海加爾的受選者之座挑戰葛羅姆科。',
  }
},
[25497] = {
  {
    'De volta ao comando‡Снова в седле‡Kopf hoch und Arsch in den Sattel‡또다시 탈것으로‡Otra vez sobre la silla‡Otra vez sobre la silla‡Remis en selle‡重振旗鼓‡重操舊業',
    nil,
    'Use 6 pedaços de Carne de Tartaruga para criar uma Isca de Tubarão.‡Приготовьте из 6 кусков черепашьего мяса наживку для акул.‡Benutzt 6 Stück Schildkrötenfleisch, um einen Haihappen herzustellen.‡거북 고기를 6개 사용하여 상어 미끼를 만들어야 합니다.‡Usa 6 carnes de tortuga para crear cebo de tiburón.‡Usa 6 carnes de tortuga para crear cebo de tiburón.‡Utilisez 6 morceaux de Viande de tortue pour confectionner un Appât à requin.‡使用6块海龟肉制造鲨鱼饵。‡使用6塊海龜肉製作鯊魚餌食。',
  }
},
[25498] = {
  {
    '‡Наживка для акулы‡Haihappen‡상어 미끼‡Cebo de tiburón‡Cebo de tiburón‡Appât à requin‡鲨鱼饵‡鯊魚誘餌',
    nil,
    '‡Бросьте наживку для акулы возле затонувшего якоря, оседлайте акулу и возвращайтесь верхом к Эрунаку.‡Benutzt den Haihappen am versunkenen Anker und reitet dann auf dem Hai zurück zu Erunak.‡‡Usa el cebo de tiburones en el ancla hundida y cabalga el tiburón de vuelta hasta Erunak.‡‡Utilisez l\'Appât à requin à proximité de l\'Ancre Engloutie et revenez auprès d\'Erunak à dos de requin.‡‡',
  }
},
[25499] = {
  {
    'Treino de agilidade: sebo nas canelas!‡Тренировка ловкости: беги со всех ног!‡Beweglichkeitstraining: Rennt wie der Teufel!‡민첩성 훈련: 뒤돌아보지 말고 뛰어라!‡Entrenamiento de agilidad: ¡Corre hasta reventar!‡Entrenamiento de agilidad: ¡Corre hasta reventar!‡Entraînement à l\'agilité : Cours ou crève‡敏捷训练：没命地跑啊！‡敏捷訓練:沒命似地跑!',
    nil,
    'Fuja de um Ódio Ardente na Forja da Súplica por 1 minuto.‡Бегайте от пылающего тренажера в Кузне Мольбы в течение 1 минуты.‡Rennt 1 Minute lang vor dem flammenden Trainer weg. Verlasst die Schmiede der Unterwerfung dabei nicht.‡1분 동안 탄원의 용광로에서 불꽃의 조련사로부터 달아나야 합니다.‡Huye del instructor llameante en el interior de La Forja de las Súplicas durante 1 minuto.‡Huye del instructor llameante en el interior de La Forja de las Súplicas durante 1 minuto.‡Échappez à l’Entraîneur flamboyant pendant 1 minute, tout en restant dans la Forge de la Supplique.‡1分钟内别叫哀求熔炉的炽焰训练师抓住。‡在哀求熔爐逃避熾熱導師1分鐘。',
  }
},
[25500] = {
  {
    '‡Слова, что нужно произнести‡Wortübermittlung‡연설문 전달‡Entrega de palabras‡Entrega de palabras‡Le discours de la libération‡递送演讲稿‡',
    nil,
    '‡Передайте речь капитану Ступу Искражу, который ждет вас в Поселке Сталежара.‡Gebt die Rede Hauptmann Tret Funkdüse bei Stahlrosts Depot.‡‡Dale el discurso al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Dale el discurso al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Apportez le discours au Capitaine Chape Étincetuyère au Dépôt de Grillacier.‡将演讲稿交给钢架补给站的崔德·火钻队长。‡',
  }
},
[25501] = {
  {
    '‡Ученик браконьера‡Wildern für Dummies‡도살로봇 밀렵‡Caza furtiva para principiantes‡‡Le braconnage pour les nuls‡傻瓜偷猎教程‡',
    nil,
    '‡С помощью мясореза соберите "урожай" с 20 трупов стеклошкурых василисков, плетохвостых скорпидов или хромоногих гиен.‡Benutzt den Schlächterbot bei den Kadavern von 20 Glashautbasilisken, Skorpidschwanzpeitschern oder Eiterpfotenhyänen.‡도살로봇을 이용해 유리비늘 바실리스크, 채찍꼬리전갈, 문둥발하이에나를 사냥해 동물 조각 20개를 모아와야 합니다.‡Usa el Robocarnicero con los cadáveres de 20 basiliscos Cristaldermo, colazotes escórpidos o hienas Llagapata.‡‡Utilisez le Robot-boucher sur les cadavres de 20 Basilics peau-de-verre, de Scorpides flagellants, ou d\'Hyènes brûlepattes.‡在20具晶鳞蜥蜴、沙漠鞭尾蝎和疱爪土狼尸体上使用收集机器人。‡',
  }
},
[25502] = {
  {
    'Arando a terra‡Подготовка почвы‡Vorbereitung des Bodens‡흙에 살리라‡Preparando el terreno‡Preparando el terreno‡Préparer le substrat‡准备土壤‡預備土壤',
    nil,
    'Ative e defenda um Totem de Chama.‡Активируйте и защитите огненного стража.‡Aktiviert und verteidigt einen Flammenzauberschutz.‡화염 감시기를 작동시키고 보호해야 합니다.‡Activa y defiende un guardallamas.‡Activa y defiende un guardallamas.‡Activez et défendez une Barrière anti-incendie.‡激活并保护防火结界。‡啟動並防禦火焰結界。',
  }
},
[25503] = {
  {
    'O butim de Pontanegra‡Сокровища Каракулы‡Schwarzflosses Beute‡검은지느러미의 전리품‡El botín de Aleta Negra‡El botín de Aleta Negra‡Le butin d\'Aileron-noir‡黑鳍的赃物‡黑鰭的贓物',
    nil,
    'Você deve matar a orca Pontanegra para recuperar o Mapa de Guelblingle.‡Вам нужно убить косатку Каракулу, чтобы получить карту Жабрингла.‡Tötet den Orca Schwarzflosse, um an Gilblingels Karte zu kommen.‡범고래 검은지느러미를 쓰러뜨리고 길블링글의 지도를 입수해야 합니다.‡Debes matar a la orca Aleta Negra para recuperar el mapa de Gilblingle.‡Debes matar a la orca Aleta Negra para recuperar el mapa de Gilblingle.‡Tuez Aileron-noir, l’épaulard, pour récupérer la Carte de Branchouille.‡杀死黑鳍，取回吉布林格的地图。‡你必須殺死巨鯨黑鰭，以取回吉爾布林果的地圖。',
  }
},
[25504] = {
  {
    'Me faz um favor?‡Сделай одолжение‡Ein kleiner Gefallen?‡내 부탁을 들어줘‡¿Me haces un favor?‡¿Me haces un favor?‡Courrier par grâce spéciale‡帮个忙呗？‡幫我個忙?',
    nil,
    'Entregue a Lista de Peças para Jinqui Peguestiquepuxa no Barcódromo do Xabu e do Relé, que fica em Mil Agulhas.‡Отнесите список запчастей Джинки Дзыньбламбум на гоночной барже Пшикса и Поззика в Тысяче Игл.‡Bringt die Bauteilliste zu Jinky Pfuschelfix auf Fizzels & Pozziks Turbodampfer in Tausend Nadeln.‡버섯구름 봉우리의 피즐과 포직의 쾌속선에 있는 징키 트위즐픽싯에게 부품 목록을 전달해야 합니다.‡Lleva la lista de piezas a Jinky Arreglatodo en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Lleva la lista de piezas a Jinky Arreglatodo en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Apportez la Liste de pièces détachées à Voltij Rafistépingle à bord de la Péniche de course de Féplouf et Pozzik, dans les Mille pointes.‡将部件清单送给千针石林菲兹尔和普兹克的赛艇平台上的金克·铁钩。‡將零件明細送到千針石林的菲茲爾與普茲克的高速駁船，交給金基·推索菲克斯伊特。',
  }
},
[25505] = {
  {
    'Me faz um favor?‡Сделай одолжение‡Ein kleiner Gefallen?‡내 부탁을 들어줘‡¿Me haces un favor?‡¿Me haces un favor?‡Courrier par grâce spéciale‡帮个忙呗？‡幫我個忙?',
    nil,
    'Entregue a Lista de Peças para Razzeric no Barcódromo do Xabu e do Relé, que fica em Mil Agulhas.‡Отнесите список запчастей Раззерику на гоночной барже Пшикса и Поззика в Тысяче Игл.‡Bringt die Bauteilliste zu Razzeric auf Fizzels & Pozziks Turbodampfer in Tausend Nadeln.‡버섯구름 봉우리의 피즐과 포직의 쾌속선에 있는 래저릭에게 부품 목록을 전달해야 합니다.‡Lleva la lista de piezas a Razzeric en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Lleva la lista de piezas a Razzeric en el Barcódromo de Fizzle y Pozzik en Las Mil Agujas.‡Apportez la Liste de pièces détachées à Razzeric à bord de la Péniche de course de Féplouf et Pozzik, dans les Mille pointes.‡将部件清单送给千针石林菲兹尔和普兹克的赛艇平台的拉泽瑞克。‡將零件明細帶去千針石林裡的瑞茲爾與普茲克的高速駁船，交給拉澤瑞克。',
  }
},
[25506] = {
  {
    'Cadeia alimentar marinha‡Морская пищевая цепь‡Abgeseilt‡바다의 먹이사슬‡Cadena alimenticia marina‡Cadena alimenticia marina‡Enchaînement alimentaire‡海洋食物链‡海中食物鏈',
    nil,
    'Encontre um Filhote de Baiacu no Ossário do Roedor e leve-o para o Abismo, próximo aos Currais.‡Разыщите малька иглобрюха во Дворе Костеглода и отнесите его к Бездне возле Загонов.‡Findet einen jungen Kugelfisch auf Nagers Friedhof und bringt ihn zum Abgrund in der Nähe der Pferche.‡질겅이의 뼈무덤에서 새끼 복어를 한 마리 잡아 구속의 손아귀 근처에 있는 심연으로 가져가야 합니다.‡Encuentra una prole resoplona en la Fosa de Bocados y llévala al Abismo cerca de los Rediles de Encierro.‡Encuentra una prole resoplona en la Fosa de Bocados y llévala al Abismo cerca de los Rediles de Encierro.‡Trouvez un Alevin de poisson-globe dans le Cimetière de Carnageoire, et apportez-le à l’Abysse, près des Enclos de détention.‡在虎鲸坟场找到一只河豚幼鱼，将它带往关押所附近的深渊。‡到囓咬骨墳找一隻圓鼓鼓的河豚，將牠帶到繫留場附近的無光深淵。',
  }
},
[25507] = {
  {
    'Cascos do inferno‡Адский панцирь‡Panzerknacker‡지옥의 껍질‡Caparazón del demonio‡Caparazón del demonio‡La carapace de l\'enfer‡地狱甲壳‡地獄殼甲',
    nil,
    'Jogue a Pilha de Vísceras de Cão-magma perto de Nêmesis para distraí-lo e pegue um Pedaço do Casco de Nêmesis.‡Положите гору внутренностей гончей Недр возле Немесиса, чтобы отвлечь его внимание. Затем добудьте фрагмент панциря Немесиса.‡Benutzt die Kernhundinnereien in der Nähe von Nemesis, um ihn abzulenken. Sammelt ein Panzerfragment von Nemesis auf.‡네메시스 근처에서 심장부 사냥개 내장 무더기를 사용하여 그를 교란하십시오. 네메시스 껍질 조각을 획득해야 합니다.‡Usa el montón de entrañas de can del Núcleo cerca de Némesis para distraerlo. Consigue un fragmento de caparazón de Némesis.‡Usa el montón de entrañas de can del Núcleo cerca de Némesis para distraerlo. Consigue un fragmento de caparazón de Némesis.‡Utilisez le Tas de viscères de chien du Magma près de Némésis afin de le distraire. Arrachez-lui un Fragment de sa carapace.‡使用一堆熔火恶犬的内脏吸引涅墨西斯，获取一块涅墨西斯龟壳碎片。‡使用一大堆熔核犬內臟讓涅密希斯分心。然後取得一塊涅密希斯龜殼碎片。',
  }
},
[25508] = {
  {
    '‡‡Eine großartige Idee‡‡Una Brillante Idea‡‡Une idée de génie‡‡',
    nil,
    nil,
  }
},
[25509] = {
  {
    'Treino físico: trabalho forçado‡Физическая подготовка: принудительный труд‡Körperliches Training: Zwangsarbeit‡체력 훈련: 육체 노동‡Entrenamiento físico: Trabajos forzados‡Entrenamiento físico: Trabajos forzados‡Entraînement physique : Travaux forcés‡体能训练：强制劳动‡體能訓練:被迫勞動',
    nil,
    'Quebre 5 Magnetitas do Sussurro Sombrio.‡Разломайте 5 магнитов Зловещего Шепота.‡Baut 5 Flüsterleitsteine ab.‡검은속삭임 자철광 5개를 부수어야 합니다.‡Rompe 5 magnetitas Negro Rumor.‡Rompe 5 magnetitas Negro Rumor.‡Brisez 5 Magnétites du Sombre murmure.‡挖开5处暗语磁石矿。‡敲碎5個暗語磁石。',
  }
},
[25510] = {
  {
    'Fala, Tortolla‡Тортолла заговорил‡Tortolla spricht‡토르톨라, 입을 열다‡Tortolla habla‡Tortolla habla‡La parole de Tortolla‡托尔托拉有话说‡托爾托拉說',
    nil,
    'Encontre com Tortolla, a tartaruga anciã, no Lago Pálido, que fica no Monte Hyjal.‡Отправляйтесь к Тортолле, древнему богу-черепахе, томящемуся в Пепельном озере на горе Хиджал.‡Geht zu Tortolla, dem Schildkrötenahnen, im Aschensee auf dem Hyjal.‡하이잘 산의 잿빛 호수에 있는 거북이 고대정령 토르톨라에게 가야 합니다.‡Ve con Tortolla, el ancestro tortuga, en el Lago Cinéreo en Monte Hyjal.‡Ve con Tortolla, el ancestro tortuga, en el Lago Cinéreo en Monte Hyjal.‡Allez voir Tortolla, l’ancienne tortue, au Lac des Cendres, à Hyjal.‡去找海加尔山暗灰湖的上古龟神托尔托拉。‡前往海加爾山的梣湖找先祖龜神托爾托拉。',
  }
},
[25513] = {
  {
    'Cúpula do Trovão: Briguinha de Ego!‡Громодром: решающая битва!‡Donnerkuppel: Erbitterter Zweikampf‡천둥경기장: 복수혈전!‡Truenódromo: ¡Pelea!‡Truenódromo: ¡Pelea!‡Le dôme du Tonnerre : le règlement de comptes !‡雷霆斗技场：宿敌战！‡雷霆競技場:怨仇對決!',
    nil,
    'Derrote Carlota Tomanota.‡Одержите победу над Мегз Жестекрошшер.‡Besiegt Megs Schredderschreck.‡멕스 드레드슈레더를 처치해야 합니다.‡Derrota a Megs Trituramatic.‡Derrota a Megs Trituramatic.‡Tuez Megs Déchiqueffroi.‡击败梅格斯·碎纸机。‡擊敗梅格斯·驚懼伐木機。',
  }
},
[25514] = {
  {
    'Quebrando os grilhões‡Освобождение от пут‡Die Bande brechen‡굴레를 벗어나‡Romper las cadenas‡Romper las cadenas‡Briser les chaînes‡打破枷锁‡破壞束縛',
    nil,
    'Desarme os dois Bastões de Subjugação que prendem Tortolla.‡Выведите из строя два жезла порабощения, удерживающих Тортоллу.‡Deaktiviert die beiden Ruten der Unterwerfung, die Tortolla binden.‡토르톨라가 묶여 있는 구속의 기둥 2개를 파괴해야 합니다.‡Desactiva las dos varas de subyugación que atan a Tortolla.‡Desactiva las dos varas de subyugación que atan a Tortolla.‡Désactivez les deux Piliers de subjugation qui emprisonnent Tortolla.‡破坏束缚托尔托拉的两根镇压之棒。‡解除束縛托爾托拉的兩個屈從權杖。',
  }
},
[25515] = {
  {
    'Carro-foguete desce pelo buraco‡Погружение в пучину‡In den Tiefen‡심연 깊숙이‡Abajo en las profundidades‡Abajo en las profundidades‡Au fin fond du fond‡深水以下‡潛入水底',
    nil,
    'Consiga 10 Peças de Carro-foguete.‡Раздобудьте 10 деталей болидов.‡Sammelt 10 Raketenwagenteile.‡로켓 자동차 부품 10개를 모아야 합니다.‡Recoge 10 piezas de coche cohete.‡Recoge 10 piezas de coche cohete.‡Retrouvez 10 Pièces de chariot explosif.‡收集10个火箭车零件。‡收集10個火箭車零件。',
  }
},
[25516] = {
  {
    'Carro-foguete desce pelo buraco‡Погружение в пучину‡In den Tiefen‡심연 깊숙이‡Abajo en las profundidades‡Abajo en las profundidades‡Au fin fond du fond‡深水以下‡潛入水底',
    nil,
    'Consiga 10 Peças de Carro-foguete.‡Раздобудьте 10 деталей болидов.‡Sammelt 10 Raketenwagenteile.‡로켓 자동차 부품 10개를 모아야 합니다.‡Recoge 10 piezas de coche cohete.‡Recoge 10 piezas de coche cohete.‡Retrouvez 10 Pièces de chariot explosif.‡收集10个火箭车零件。‡收集10個火箭車零件。',
  }
},
[25517] = {
  {
    'Mais uma briga e outra confusão no bar!‡Драка в баре!‡Schenkenschlägerei!‡주점에서 치고받기!‡¡Pelea de bar!‡¡Pelea de bar!‡Baston de bar !‡酒吧斗殴！‡酒吧鬥毆!',
    nil,
    'Arrume briga no bar!‡Начните драку в баре!‡Provoziert eine Schlägerei in der Schenke!‡주점에서 싸움을 시작해야 합니다!‡¡Empieza una pelea de bar!‡¡Empieza una pelea de bar!‡Déclenchez une baston de bar !‡挑起酒吧斗殴！‡酒吧鬥毆!開打!',
  }
},
[25518] = {
  {
    'Mais uma briga e outra confusão no bar!‡Драка в баре!‡Schenkenschlägerei!‡주점에서 치고받기!‡¡Pelea de bar!‡¡Pelea de bar!‡Baston de bar !‡酒吧斗殴！‡酒吧鬥毆!',
    nil,
    'Arrume briga no bar!‡Начните драку в баре!‡Provoziert eine Schlägerei in der Schenke!‡주점에서 싸움을 시작해야 합니다!‡¡Empieza una pelea de bar!‡¡Empieza una pelea de bar!‡Déclenchez une baston de bar !‡挑起酒吧斗殴！‡酒吧鬥毆!開打!',
  }
},
[25519] = {
  {
    'Os filhos de Tortolla‡Дети Тортоллы‡Abkömmlinge von Tortolla‡토르톨라의 자식들‡Los hijos de Tortolla‡Los hijos de Tortolla‡La progéniture de Tortolla‡托尔托拉之子‡托爾托拉的子嗣',
    nil,
    'Mate 6 Corruptores Profundos que estejam atacando os Ovos de Tortolla no Lago Pálido.‡Убейте 6 осквернителей глубин, нападающих на яйца Тортоллы в Пепельном озере.‡Tötet 6 Tiefe Verderber, die Tortollas Eier im Aschensee angreifen.‡잿빛 호수에서 토르톨라의 알을 공격하는 심연의 타락자 6마리를 처치해야 합니다.‡Asesina a 6 corruptores profundos que están atacando los huevos de Tortolla en el Lago Cinéreo.‡Asesina a 6 corruptores profundos que están atacando los huevos de Tortolla en el Lago Cinéreo.‡Tuez 6 Corrupteurs des profondeurs qui attaquent les œufs de Tortolla, au Lac des Cendres.‡消灭暗灰湖6名正在攻击托尔托拉的蛋的深渊腐蚀者。‡殺死6名在梣湖攻擊托爾托拉的蛋的深淵墮落者。',
  }
},
[25520] = {
  {
    'O despertar de um ancião‡Пробуждение древнего бога‡Ein Ahn erwacht‡고대정령이 깨어나다‡El despertar de un ancestro‡El despertar de un ancestro‡Un ancien s\'éveille‡远古半神的苏醒‡被喚醒的先祖',
    nil,
    'Fale novamente com o Arquidruida Hamuul Runa Totem no Santuário de Malorne, em Hyjal.‡Вернитесь к верховному друиду Хамуулу Руническому Тотему, находящемуся в Святилище Малорна на горе Хиджал.‡Kehrt zu Erzdruide Hamuul Runentotem im Heiligtum von Malorne zurück.‡하이잘의 말로른의 성역에 있는 대드루이드 하뮬 룬토템에게 가야 합니다.‡Vuelve con el archidruida Hamuul Tótem de Runa en el Santuario de Malorne en Hyjal.‡Vuelve con el archidruida Hamuul Tótem de Runa en el Santuario de Malorne en Hyjal.‡Retournez voir l’Archidruide Hamuul Totem-runique au Sanctuaire de Malorne, à Hyjal.‡去找海加尔山玛洛恩庇护所的大德鲁伊哈缪尔·符文图腾。‡回到海加爾山的瑪洛尼聖地找大德魯伊哈繆爾·符文圖騰。',
  }
},
[25521] = {
  {
    'Todo castigo pra goblin é pouco‡Я насчет скорпидов‡Skorpidooh!‡전갈과의 동침‡El escórpido habita en mí‡El escórpido habita en mí‡Des glandes de poison, dare-dare !‡蝎叮虫咬‡我身邊全是蠍子',
    nil,
    'Consiga 6 Aguilhões de Dunagarra dos Escorpídeos Dunagarra.‡Принеси 6 жал барханных скорпидов.‡Sammelt 6 Dünenscherenstachel von Dünenscherenpeitschern.‡모래독침전갈 독침 6개를 모아야 합니다.‡Reúne 6 aguijoneros Garraduna de escórpidos Garraduna.‡Reúne 6 aguijoneros Garraduna de escórpidos Garraduna.‡Récupérez 6 Dards de pincedune sur des Scorpides pincedune.‡从砂爪蝎虫身上收集6根砂爪之刺。‡從沙爪毒蠍身上取得6個沙爪之刺。',
  }
},
[25522] = {
  {
    'Giganpídeo‡Колоссопид‡Gargantapid‡대왕전갈‡Gigancórpido‡Gigancórpido‡Gargantapide‡硬霸蝎‡加根塔皮',
    nil,
    'Consiga a Glândula de Veneno de Giganpídeo.‡Раздобудьте жало Колоссопида.‡Erhaltet Gargantapids Giftdrüse.‡대왕전갈의 독 분비선을 수집해야 합니다.‡Consigue la glándula de veneno de Gigancórpido.‡Consigue la glándula de veneno de Gigancórpido.‡Récupérez la Glande de poison de Gargantapide.‡获得硬霸蝎的剧毒腺体。‡取得加根塔皮之刺。',
  }
},
[25523] = {
  {
    'Como voar nas Terras do Fogo‡Полет по Огненным Просторам‡Fliegen in den Feuerlanden‡불의 땅 위를 날아올라‡Vuelo en las Tierras de Fuego‡Vuelo en las Tierras de Fuego‡Vol à destination des terres de Feu‡飞翔在火焰之地‡在火源之界飛行',
    nil,
    'Pegue uma Lança-de-fogo Crepuscular do cavalete atrás de Farden e equipe-se com ela. Monte em um dos Guardiões de Aviana e voe até a Bandeira de Guarda na plataforma abaixo de você. Clique no botão de Bater Asas para que a sua montaria bata as asas!‡Вооружитесь Огненным копьем Сумеречного Молота, взяв его со стойки позади Фардена. Заберитесь на одного из защитников Авианы и летите к флагу стража, установленному на уступе внизу. Нажмите кнопку "Взмах", чтобы защитник полетел.‡Nehmt Euch eine Zwielichtfeuerlanze aus dem Regal hinter Farden und legt sie an. Steigt auf einen von Avianas Wächtern und fliegt zum Sims unter Euch. Drückt die Taste \'Flattern\', damit Euer Reittier mit den Flügeln schlägt!‡파든의 뒤에 있는 선반에서 황혼의 화염창을 하나 골라 장착하십시오. 아비아나의 수호자 중 하나에 올라탄 다음, 아래 바위 위에 설치된 깃발로 가야 합니다. 날갯짓 버튼을 눌러 탈것의 날개를 퍼덕이십시오!‡Consigue y equipa una flamanza Crepuscular del estante de detrás de Farden. Monta en uno de los guardianes de Aviana y vuela hasta una bandera de guardián en el saliente de abajo. ¡Pulsa el botón Aletear para agitar las alas de tu montura!‡Consigue y equipa una Flamanza Crepuscular del estante de detrás de Farden. Monta en uno de los guardianes de Aviana y vuela hasta una bandera de guardián en el saliente de abajo. ¡Pulsa el botón Aletear para agitar las alas de tu montura! ‡Empoignez une Lance de feu du Crépuscule sur le râtelier derrière Farden. Chevauchez un Gardien d’Aviana et volez jusqu’au Drapeau du gardien sur la corniche en contrebas. Cliquez sur l’icône Battre des ailes pour que votre monture se mette à voler !‡从法登身后的武器架上拿一把暮光火焰长枪并装备之。乘坐艾维娜的守护者，飞往下方的岩架上的守护之旗。按下“拍翼”按钮以控制你的坐骑扇动翅膀！‡在法爾登身後的架子取得並裝配暮光火矛。騎上艾維娜的守護者，要她飛往下方高地的守護者旗幟。按「振翅」鈕讓你的坐騎拍翅膀!',
  }
},
[25524] = {
  {
    'O banheiro submerso‡В отхожем месте‡Im Plumpsklo‡화장실에서‡En la letrina‡En la letrina‡Le noyé récalcitrant‡上厕所‡在廁所裡',
    nil,
    'Consiga um Pé-de-cabra de Pirata e use-o para arrombar a porta do Banheiro Submerso.‡Раздобудьте лом пирата и взломайте дверь полузатопленного туалета.‡Erhaltet ein Piratenbrecheisen und versucht, die Tür des Plumpsklos unter Wasser aufzubrechen.‡해적의 쇠지렛대를 획득하고 쇠지렛대를 사용해 물에 잠긴 화장실 문을 열어야 합니다.‡Consigue una palanqueta de pirata y utilízala para forzar la puerta de la letrina sumergida.‡Consigue una palanqueta de pirata y utilízala para forzar la puerta de la letrina sumergida.‡Obtenez un Pied-de-biche de pirate et utilisez-le pour fracturer la porte des Toilettes submergées.‡拿到海盗的撬棍，用它撬开被淹没的厕所的门。‡取得1根海賊的撬棍並使用它來撬開隱匿的廁所的門。',
  }
},
[25525] = {
  {
    'Primeira leva‡По седлам!‡Die erste Welle‡첫 번째 실전 비행‡Primera oleada‡Primera oleada‡Première vague‡第一波‡第一波',
    nil,
    'Equipe-se com uma Lança-de-fogo Crepuscular e voe no Guardião de Aviana. Mate 10 Cavaleiros do Crepúsculo voando para cima deles. Clique no botão de Bater Asas para que sua montaria bata as asas!‡Вооружитесь Огненным копьем Сумеречного Молота и взлетите на одном из защитников Авианы. Убейте 10 сумеречных всадников, налетев на них. Нажимайте кнопку "Взмах", чтобы лететь.‡Legt eine Zwielichtfeuerlanze an und fliegt auf Avianas Wächter. Tötet 10 Zwielichtritter, indem Ihr in sie hineinfliegt. Drückt die Taste \'Flattern\', damit Euer Reittier mit den Flügeln schlägt!‡황혼의 화염창을 장착하고 아비아나의 수호자를 타십시오. 화염창을 들고 돌진하여 황혼의 대머리수리 기수 10명을 처치해야 합니다. 날갯짓 버튼을 눌러 탈것의 날개를 퍼덕이십시오!‡Equipa una flamanza Crepuscular y vuela en un guardián de Aviana. Mata a 10 jinetes Caballeros Crepusculares volando contra ellos. ¡Pulsa el botón Aletear para agitar las alas de tu montura!‡Equipa una Flamanza Crepuscular y vuela en un guardián de Aviana. Mata a 10 jinetes Caballeros Crepusculares chocando contra ellos. ¡Pulsa el botón Aletear para agitar las alas de tu montura! ‡Empoignez une Lance de feu du Crépuscule et enfourchez un Gardien d’Aviana. Tuez 10 Chevaliers du Crépuscule en les chargeant. Cliquez sur l’icône Battre des ailes pour que votre monture se mette à voler !‡装备一把暮光火焰长枪，乘坐艾维娜的守护者出击。向10个暮光骑士进行冲撞以击落他们。按下“拍翼”按钮以控制你的坐骑扇动翅膀！‡裝配暮光火矛並乘上艾維娜的守護者飛行。衝進敵陣消滅10個暮光騎兵騎士。按「振翅」鈕讓你的坐騎拍翅膀!',
  }
},
[25526] = {
  {
    'O banheiro submerso‡В отхожем месте‡Im Plumpsklo‡화장실에서‡En la letrina‡En la letrina‡Le noyé récalcitrant‡上厕所‡在廁所裡',
    nil,
    'Consiga um Pé-de-cabra de Pirata e use-o para arrombar a porta do Banheiro Submerso.‡Раздобудьте лом пирата и взломайте дверь полузатопленного туалета.‡Erhaltet ein Piratenbrecheisen und versucht, die Tür des Plumpsklos unter Wasser aufzubrechen.‡해적의 쇠지렛대를 획득하고 쇠지렛대를 사용해 물에 잠긴 화장실 문을 열어야 합니다.‡Consigue una palanqueta de pirata y utilízala para forzar la puerta de la letrina sumergida.‡Consigue una palanqueta de pirata y utilízala para forzar la puerta de la letrina sumergida.‡Obtenez un Pied-de-biche de pirate et utilisez-le pour fracturer la porte des Toilettes submergées.‡拿到海盗的撬棍，用它撬开被淹没的厕所的门。‡取得1根海賊的撬棍並使用它來撬開隱匿的廁所的門。',
  }
},
[25527] = {
  {
    '‡‡Ein Ersatztaucherhelm‡‡Escafandra de repuesto‡‡Un casque de plongée de remplacement‡‡',
    nil,
    nil,
  }
