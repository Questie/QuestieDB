[30710] = {
  {
    'Trollando os trolls‡Провоцируя троллей‡Trolle provozieren‡트롤 자극하기‡Provocar a los trols‡‡Provoquer les trolls‡激怒巨魔‡',
    nil,
    'Mate 10 Espreitadores Zandalari e 5 Bagateiros Zandalari. Uma‡Убейте 10 зандарских разведчиков и 5 зандарских колдунов.‡Tötet 10 Pirscher der Zandalari und 5 Hexer der Zandalari.‡Zandalari Stalker 10명과 Zandalari Hexer 5명을 처치해야 합니다. 레벨 1 쿤라이 봉우리‡Mata a 10 acechadores Zandalari y a 5 aojadores Zandalari.‡‡Tuez 10 Traqueurs zandalari et 5 Maléficieurs zandalari.‡击败10个赞达拉追踪者和5个赞达拉妖术师。‡',
  }
},
[30714] = {
  {
    'Demitindo os chefes‡Убить вожаков‡Die Anführer vernichten‡지도자를 물리쳐라‡Acabar con los líderes‡‡Détruire les chefs‡消灭首领‡',
    nil,
    'Mate o Mestre de Espadas Zandalari e o Mago Zandalari. Uma‡Убейте зандаларского мастера клинка и зандаларского мага. это‡Tötet den Klingenmeister der Zandalari und den Magier der Zandalari.‡잔달라 검귀와 잔달라리 마법사를 처치해야 합니다. 레벨 1‡Mata al maestro del acero Zandalari y al mago Zandalari.‡‡Tuez le Maître-lames zandalari et le Mage zandalari.‡击败赞达拉剑圣和赞达拉法师‡',
  }
},
[30715] = {
  {
    'Uma linha contínua‡Несломленная оборона‡Eine ungebrochene Linie‡끈끈한 전우애‡Una línea ininterrumpida‡‡Une lignée intacte‡生死与共‡',
    nil,
    'Leve descanso ao Shado-Mestre Zhiyao, a Liu dos Mil Golpes e a Shiya Lâmina Penetrante. Uma‡Упокойте шадо-мастера Чжияо, Лю Тысячу Ударов и Шию Кипящую Кровь.‡Bettet Shado-Meister Zhiyao, Liu Tausendschlag und Shiya Scharfklinge zur letzten Ruhe.‡음영사부 즈야오, 일수천타의 리우, 스야 볼드블레이드에게 안식을 주어야 합니다. 레벨 20 쿤라이 봉우리‡Concede el descanso al maestro Shado Zhiyao, a Liu de los Mil golpes y a Shiya Hoja Audaz.‡‡Enterrez les dépouilles du Maître-pandashan Zhiyao, de Liu des Mille Poings et de Shiya Vive Lame.‡让影踪派智遥大师、一瞬千击刘刚拳和诗雅·勇剑安息。‡',
  }
},
[30716] = {
  {
    'Em busca da esperança‡В погоне за надеждой‡Der Hoffnung hinterher‡희망 잡기‡Buscar la esperanza‡‡À la poursuite de l’espoir‡追赶希望‡',
    nil,
    'Toque 3 Espíritos da Garça. Uma‡Прикоснитесь к 3 духам Журавля.‡Berührt 3 Geister des Kranichs.‡학의 영혼을 3번 붙잡아야 합니다. 레벨 35 크라사랑 밀림‡Toca a 3 espíritus de la grulla.‡‡Touchez 3 Esprits de la grue.‡触摸3个仙鹤之魂。‡',
  }
},
[30717] = {
  {
    'Dádivas da Grande Garça‡Дары Великого Журавля‡Gaben des Großen Kranichs‡큰학의 선물‡Obsequios de la Gran Grulla‡‡Les dons de la grande Grue‡神鹤的恩赐‡',
    nil,
    'Consiga 10 Dádivas da Grande Garça. Uma‡Соберите 10 даров Великого Журавля.‡Besorgt 10 Gaben des Großen Kranichs.‡큰학의 선물을 10개 모아야 합니다. 레벨 35 크라사랑 밀림‡Consigue 10 obsequios de la Gran Grulla.‡‡Obtenez 10 Dons de la grande Grue.‡获得10个神鹤的恩赐。‡',
  }
},
[30718] = {
  {
    'Discípulos de Chi-Ji‡Ученики Чи-Цзи‡Schüler von Chi-Ji‡츠지의 제자‡Estudiantes de Chi-Ji‡‡Les disciples de Chi Ji‡赤精的弟子们‡',
    nil,
    'Duele com 10 Discípulos de Chi-Ji. Uma‡Сразитесь с 10 учениками Чи-Цзи.‡Duelliert Euch mit 10 Schülern von Chi-Ji.‡츠지의 제자 10명과 대련해야 합니다. 레벨 35 크라사랑 밀림‡Enfréntate a 10 estudiantes de Chi-Ji.‡‡Remportez un duel contre 10 Étudiants de Chi Ji.‡与10个赤精弟子切磋。‡',
  }
},
