[3441] = {
  {
    'Castigo divino‡Божественное воздаяние‡Göttliche Vergeltung‡성스러운 복수‡Castigo divino‡Castigo divino‡Châtiment divin‡神圣的惩戒‡',
    nil,
    'Ouça Velarok Lamicélere contar a história dele.‡Выслушайте Веларока Ветрореза.‡Lasst Velarok Windklinge seine Geschichte erzählen.‡벨라로크 윈드블레이드가 하는 이야기를 들으십시오.‡Escucha a Velarok Espada del Viento.‡Escucha a Kalaran Espada del Viento.‡Écouter le récit de Velarok Lamevent.‡听威拉罗克·温布雷讲述他的故事。‡',
  }
},
[3442] = {
  {
    'A chama perfeita‡Неугасимое пламя‡Die fehlerlose Flamme‡완전무결한 불꽃‡La llama pura‡La llama pura‡La flamme parfaite‡无瑕之焰‡無瑕之焰',
    nil,
    'Colete 4 Corações das Chamas e 4 globos de Óleo de Golem, e leve-os para Velarok Lamicélere.‡Принесите 4 сердца пламени и 4 меры масла големов Велароку Ветрорезу.‡Sammelt 4 Herzen der Flamme und 4 Kugeln Golemöl und bringt die Gegenstände zu Velarok Windklinge.‡화염의 심장 4개와 골렘 기름 4개를 모아 벨라로크 윈드블레이드에게 가져가야 합니다.‡Lleva 4 corazones de llama y 4 globos de aceite gólem a Velarok Espada del Viento.‡Lleva 4 corazones de llama y 4 globos de aceite gólem a Velarok Espada del Viento.‡Réunir 4 Cœurs des flammes et 4 globes d’Huile de golem puis rapporter ces objets à Velarok Lamevent.‡收集4份烈焰之心和4份傀儡之油，然后把这些东西交给威拉罗克·温布雷。‡收集4份烈焰之心和4份魔像之油，然後把這些東西交給維拉若克·溫布雷。',
  }
},
[3443] = {
  {
    'Forjando o bastão‡Древко факела‡Das Schmieden des Schafts‡횃불 자루 만들기‡Forjar el mango‡Forjar el mango‡Forger le manche‡铸造火炬杆‡鑄造火炬桿',
    nil,
    'Leve 8 Punhais de Placas de Tório para Velarok Lamicélere.‡Принесите 8 окованных торием кинжалов Велароку Ветрорезу.‡Bringt 8 mit Thorium beschichtete Dolche zu Velarok Windklinge.‡벨라로크 윈드블레이드에게 토륨 도금 단검 8개를 가져가야 합니다.‡Lleva 8 dagas bañadas en torio a Velarok Espada del Viento.‡Lleva 8 dagas bañadas en torio a Velarok Espada del Viento.‡Apporter 8 Dagues plaquées en thorium à Velarok Lamevent.‡给威拉罗克·温布雷带去8把瑟银匕首。‡帶8把瑟銀匕首給維拉若克‧溫布雷。',
  }
},
[3444] = {
  {
    'O círculo de pedra‡Круглый камень‡Der Steinreif‡돌무리‡El círculo de piedra‡El círculo de piedra‡Le Cercle de pierres‡石环‡石環',
    nil,
    'Busque o Círculo de Pedra na oficina de Marlon Catarrebite em Vila Catraca.‡Заберите круглый камень из мастерской Марвона Клепальщика в Кабестане.‡Holt den Steinreif aus Marvon Nietensuchers Werkstatt in Ratschet.‡톱니항에 있는 마본 리벳시커의 작업장에서 마본의 궤짝에 담긴 아탈라이 돌무리를 회수해야 합니다.‡Recupera el círculo de piedra del taller de Marvon Buscarroblones, en Trinquete.‡Recupera el círculo de piedra del taller de Marvon Buscarroblones, en Trinquete.‡Récupérer le Cercle de pierres à l\'Atelier de Marvon Chercherivet à Cabestan.‡到棘齿城去，从玛尔冯·瑞文斯克的车间里取回石环。‡到棘齒城去，從瑪爾馮·瑞文斯克的工坊裡取回石環。',
  }
},
[3445] = {
  {
    'O Templo Submerso‡Затонувший храм‡Der Versunkene Tempel‡가라앉은 사원‡El Templo Sumergido‡El Templo Sumergido‡Le Temple englouti‡沉没的神庙‡沉沒的神廟',
    nil,
    'Encontre Marlon Catarrebite em Tanaris.‡Найдите Марвона Клепальщика в Танарисе.‡Sucht Marvon Nietensucher in Tanaris.‡타나리스에서 마본 리벳시커를 찾아야 합니다.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Trouver Marvon Chercherivet à Tanaris.‡到塔纳利斯找到玛尔冯·瑞文斯克。‡到塔納利斯尋找瑪爾馮·瑞文斯克。',
  }
},
[3446] = {
  {
    'Nas profundezas‡Во глубине болот‡In die Tiefen‡심연의 늪‡En las profundidades‡En las profundidades‡Dans les profondeurs‡深入神庙‡深入神廟',
    nil,
    'Encontre o Altar de Hakkar no Templo Submerso, que fica no Pântano das Mágoas.‡Найдите алтарь Хаккара в затонувшем храме на Болоте Печали.‡Sucht den Altar von Hakkar im Versunkenen Tempel in den Sümpfen des Elends.‡슬픔의 늪에 있는 가라앉은 사원에서 학카르 제단을 찾아야 합니다.‡Encuentra el Altar de Hakkar en el Templo Sumergido, en el Pantano de las Penas.‡Encuentra el Altar de Hakkar en el Templo Sumergido, en el Pantano de las Penas.‡Trouver l\'Autel d\'Hakkar dans le Temple englouti du marais des Chagrins.‡在悲伤沼泽沉没的神庙中找到哈卡祭坛。‡在悲傷沼澤的沉沒神廟中找到哈卡祭壇。',
  }
},
[3447] = {
  {
    'Segredo do círculo‡Тайна камня‡Das Geheimnis des Kreises‡돌무리의 비밀‡El secreto del círculo‡El secreto del círculo‡Le secret du cercle‡雕像群的秘密‡雕像群的秘密',
    nil,
    'Entre no Templo Submerso e descubra o segredo escondido no círculo de estátuas.‡Отправляйтесь в затонувший храм и узнайте, что скрывается в круге статуй.‡Reist zum Versunkenen Tempel und enthüllt das Geheimnis, das sich in dem Kreis der Statuen verbirgt.‡가라앉은 사원으로 가서 원 모양으로 서 있는 석상들에 감춰진 비밀을 알아내야 합니다.‡Ve al Templo Sumergido y descubre el secreto oculto en el círculo de estatuas.‡Ve al Templo Sumergido y descubre el secreto oculto en el círculo de estatuas.‡Voyager jusqu\'au Temple englouti et découvrir le secret du cercle de statues.‡到沉没的神庙去，揭开雕像群中隐藏的秘密。‡去沉沒的神廟，找出雕像群中隱藏的秘密。',
  }
},
[3448] = {
  {
    'Passando o fardo‡Передача поручения‡Die Bürde weitergeben‡티모르의 협조‡Encargarse de la investigación‡Encargarse de la investigación‡La transmission du fardeau‡委以重任‡委以重任',
    nil,
    'Fale com Timor em Altaforja.‡Поговорите с Тимором в Стальгорне.‡Sprecht mit Magier Tymor in Eisenschmiede.‡아이언포지에 있는 티모르와 대화해야 합니다.‡Habla con Tymor en Forjaz.‡Habla con Tymor en Forjaz.‡Parlez au mage Tymor à Forgefer.‡跟铁炉堡的泰摩尔谈一谈。‡跟鐵爐堡的泰摩爾談話。',
  }
},
[3449] = {
  {
    'Runas arcanas‡Чародейские руны‡Arkane Runen‡비전 룬‡Runas Arcanas‡Runas Arcanas‡Les runes des Arcanes‡奥术符文‡秘法符文',
    nil,
    'Usando o Kit de Desenho, faça decalques da Runa de Beth\'Amara, da Runa de Jin\'yael, da Runa de Markri e da Runa de Sael\'hai antes de ir para a pequena ilha ao largo da península meridional de Azshara e sinalizar para o Piloto Xisto Acendefase buscá-los.‡При помощи готовальни сделайте прорисовки руны Бет\'Амары, руны Джин\'йаэль, руны Маркри и руны Саэл\'Хаи. Отправляйтесь на маленький островок близ южного полуострова Азшары и дайте сигнал пилоту Зиггсу Зажигателю забрать их.‡Verwendet das Abschriftenset, um Abpausbilder von der Rune von Beth\'Amara, der Rune von Jin\'yael, der Rune von Markri und der Rune von Sael\'hai herzustellen, bevor Ihr Euch zu der kleinen Insel vor der südlichen Halbinsel von Azshara aufmacht und dem Piloten Xiggs Luntenzünder signalisiert, dass er sie abholen kann.‡탁본 도구를 사용해 베스아마라 룬, 진야엘 룬, 마크리 룬, 샤엘하이 룬의 탁본을 만든 후, 아즈샤라의 남부 반도에서 조금 떨어진 작은 섬으로 가서 신호를 보내 조종사 시그스 퓨즈라이터가 가지러 오도록 해야 합니다.‡Haz calcos de la Runa de Beth\'Amara, la Runa de Jin\'yael, la Runa de Markri y la Runa de Sael\'hai. Luego ve a la isla frente a la península meridional de Azshara y avisa al piloto Xiggs Botafuego para que recoja los calcos.‡Haz calcos de la Runa de Beth\'Amara, la Runa de Jin\'yael, la Runa de Markri y la Runa de Sael\'hai. Luego ve a la isla frente a la península meridional de Azshara y avisa al piloto Xiggs Botafuego para que recoja los calcos.‡À l\'aide de la Trousse de dessin, effectuer des reproductions de la Rune de Beth\'Amara, de la Rune de Jin\'yael, de la Rune de Markri, de la Rune de Sael\'hai, puis se diriger vers la petite île près de la Péninsule méridionale d\'Azshara et signaler au Pilote Xiggs Allumèche de venir les prendre.‡使用绘图工具包获取贝萨玛拉符文、辛耶尔符文、玛科里符文和塞尔哈符文的拓片，然后前往艾萨拉南部半岛外的小岛，把它们交给驾驶员西格斯·熔光。‡在前往艾薩拉南部半島處的小島之前，使用繪圖工具獲取貝薩瑪拉符文、辛耶爾符文、瑪寇里符文和塞爾哈符文的拓片，然後通知駕駛員希格斯·熔火去拾取這些拓片。',
  }
},
[3450] = {
  {
    '‡Легкая доставка‡Eine einfache Ladung‡간편한 배달 방법‡Un simple envío‡Un simple envío‡Une collecte facile‡简单的接收任务‡',
    nil,
    '‡Поговорите с Зиггсом Зажигателем в Стальгорне.‡Sprecht mit Xiggs Luntenzünder in Eisenschmiede.‡아이언포지에 있는 시그스 퓨즈라이터와 대화해야 합니다.‡Habla con Xiggs Botafuego en Forjaz.‡Habla con Xiggs Botafuego en Forjaz.‡Parlez à Xiggs Allumèche à Forgefer.‡与铁炉堡的希格斯·熔火谈一谈。‡',
  }
},
[3451] = {
  {
    '‡Сигнал "Взять на борт!"‡Signal zum Abholen‡‡Una señal para el envío‡Una señal para el envío‡Signal de la récupération‡信号发射器‡',
    nil,
    '‡Поговорите с Зиггсом Зажигателем в Стальгорне и получите от него сигнальное ружье.‡Sprecht mit Xiggs Luntenzünder in Eisenschmiede und erhaltet von ihm eine Standardleuchtpistole.‡‡Habla con Xiggs Botafuego para que te dé una pistola de bengalas en Forjaz.‡Habla con Xiggs Botafuego para que te dé una pistola de bengalas en Forjaz.‡Parlez à Xiggs Allumèche à Forgefer pour obtenir un Lance-fusée standard.‡与铁炉堡的希格斯·熔火谈一谈，从他那儿获得一支标准型闪光信号枪。‡',
  }
},
[3452] = {
  {
    'O invólucro da chama‡Защита пламени‡Die Ummantelung der Flamme‡‡El soporte para la llama‡El soporte para la llama‡L\'enveloppe de la flamme‡烈焰之盒‡烈焰之盒',
    nil,
    'Encontre e leve um Símbolo de Ragnaros para Velarok Lamicélere.‡Найдите знак Рагнароса и принесите его Каларану Ветрорезу.‡Bringt ein Symbol von Ragnaros zu Velarok Windklinge.‡‡Lleva un Símbolo de Ragnaros a Kalaran Espada del Viento.‡Lleva un Símbolo de Ragnaros a Kalaran Espada del Viento.‡Trouver et apporter un Symbole de Ragnaros à Velarok Lamevent.‡找到一个拉格纳罗斯符记，把它交给威拉罗克·温布雷。‡找到一個拉格納羅斯符記，把它交給維拉若克·溫布雷。',
  }
},
[3453] = {
  {
    '‡Факел воздаяния‡Die Fackel der Vergeltung‡‡La antorcha de reprensión‡La antorcha de reprensión‡La Torche de vindicte‡惩戒火炬‡',
    nil,
    '‡Подождите, пока Каларан Ветрорез закончит факел Воздаяния.‡Wartet bis Kalaran Windklinge die Fackel der Vergeltung vollendet hat.‡‡Espera a que Kalaran Espada del Viento termine la antorcha de reprensión.|n‡Espera a que Kalaran Espada del Viento termine la antorcha de reprensión.|n‡Attendre que Kalaran Lamevent termine la Torche de vindicte.‡等待卡拉然·温布雷完成惩戒火炬。‡',
  }
},
[3454] = {
  {
    '‡Факел воздаяния‡Die Fackel der Vergeltung‡‡La antorcha de reprensión‡La antorcha de reprensión‡La Torche de vindicte‡惩戒火炬‡',
    nil,
    '‡Возьмите факел воздаяния.‡Nehmt die Fackel der Vergeltung.‡‡Coge la antorcha de reprensión.‡Coge la antorcha de reprensión.‡Prendre la Torche de vindicte.‡拿起惩戒火炬。‡',
  }
},
[3461] = {
  {
    '‡Возвращение к Тимору‡Rückkehr zu Magier Tymor‡‡Regresa junto a Tymor‡Regresa junto a Tymor‡Le retour auprès de Tymor‡向法师泰摩尔回复‡',
    nil,
    '‡Принесите Тимору его готовальню назад в Стальгорн.‡Bringt Magier Tymors Abschriftenset zu ihm zurück nach Eisenschmiede.‡‡Devuelve el juego de calco a Tymor, que está en Forjaz.‡Devuelve el juego de calco a Tymor, que está en Forjaz.‡Rapporter la Trousse de dessin du mage Tymor au mage Tymor, à Forgefer.‡到铁炉堡去，将法师泰摩尔的绘图工具包还给他。‡',
  }
},
[3462] = {
  {
    '‡Оруженосец Малтрейк‡Knappe Malzdarr‡수습기사 몰트레이크‡Escudero Maltrake‡Escudero Maltrake‡Ecuyer Maltrake‡侍卫玛特拉克‡侍從瑪特拉克',
    nil,
    '‡Поговорите с оруженосцем Малтрейком.‡Sprecht mit dem Knappen Malzdarr.‡‡Habla con mi enviado, el escudero Maltrake.‡Habla con mi enviado, el escudero Maltrake.‡Parler à l\'écuyer Maltrake.‡与侍卫玛特拉克谈一谈。‡',
  }
},
[3463] = {
  {
    'Taca fogo neles!‡Задай им жару!‡Setzt sie in Brand!‡불 공격!‡¡Préndeles fuego!‡¡Préndeles fuego!‡Allumer le feu !‡烧掉它们！‡燒掉它們!',
    nil,
    'Incendeie as Torres de Sentinela Norte, Sul, Leste e Oeste usando a Tocha da Retribuição dentro de cada prédio. |n‡Подожгите северную, южную, восточную и западную сторожевые башни с помощью факела воздаяния.‡Steckt die Wachpostentürme im Norden, Süden, Osten und Westen in Brand, indem Ihr die Fackel der Vergeltung innerhalb der einzelnen Gebäude benutzt.‡북쪽, 남쪽, 동쪽과 서쪽 감시탑 내부에서 응보의 횃불을 사용해 불을 질러야 합니다.‡Entra en las 4 torres del centinela e incéndialas con la antorcha de reprensión.|n‡Entra en las 4 torres del centinela e incéndialas con la antorcha de reprensión.|n‡Mettre le feu aux Tours de garde nord, sud, est et ouest en utilisant la Torche de vindicte à l\'intérieur de chaque tour.‡使用惩戒火炬点燃北部、南部、东部和西部的哨塔。‡使用懲戒火炬點燃北部、南部、東部和西部的哨塔。',
  }
},
[3481] = {
  {
    '‡Безделушки...‡Plunder...‡‡Abalorios...‡Abalorios...‡Bibelots...‡打开箱子…‡',
    nil,
    '‡Откройте сундук.‡Öffnet die Truhe.‡‡Abre el cofre.‡Abre el cofre.‡Ouvrir le coffre.‡打开箱子。‡',
  }
},
[3482] = {
  {
    '‡<NYI> <TXT> Щербатая черная коробка‡‡[번역 미완성] The Pocked Black Box‡<NYI> <TXT> La caja negra con agujeros‡<NYI> <TXT> La caja negra con agujeros‡‡暂无内容‡',
    nil,
    '‡Отнесите этот ящик Крейвелу.‡Bringt diesen Kasten zu Kravel.‡‡Llévale esta caja a Kravel.‡Llévale esta caja a Kravel.‡Porter la boîte à Kravel.‡‡',
  }
},
[3483] = {
  {
    '‡Сигнал "Взять на борт!"‡Signal zum Abholen‡‡Una señal para el envío‡Una señal para el envío‡Signal de la récupération‡信号发射器‡',
    nil,
    nil,
  }
},
[3501] = {
  {
    'Cada pedacinho conta‡Счет идет на большие числа‡Viel hilft viel‡불완전한 드레니시스트 조각‡Todo cuenta en grandes cantidades‡Todo cuenta en grandes cantidades‡Tout se compte en grandes quantités‡多多益善‡多多益善',
    nil,
    'Leve Fragmentos Imperfeitos de Draenetista para Kum\'isha e ganhe uma recompensa por cada fragmento entregue.|n‡Принесите Кум\'ише несовершенные фрагменты дренетиста и получите награду за каждый из них.‡Bringt Kum\'isha unvollständige Draenethystfragmente und Ihr werdet für jedes, das Ihr bringt, belohnt.‡굼이샤에게 불완전한 드레니시스트 조각을 가져가고, 각 파편에 대해 보상을 받아야 합니다.‡Llévale a Kum\'isha trozos draenetistas imperfectos y te recompensará por cada fragmento entregado.|n‡Llévale a Kum\'isha trozos draenetistas imperfectos y te recompensará por cada fragmento entregado.|n‡Apporter des Fragments imparfaits de draenéthyste à Kum\'isha et toucher une récompense pour chaque fragment rapporté.‡将有瑕疵的德莱尼水晶碎片交给库米沙，你就可以得到相应的回报。‡將有瑕疵的德萊尼水晶碎片交給庫米沙，你就可以得到相應的回報。',
  }
},
[3502] = {
  {
    'O lixo de um draenei...‡Дренейский хлам‡Des einen Draeneis Plunder...‡어느 드레나이의 잡동사니...‡Un trasto de Draenei...‡Un trasto de Draenei...‡Au rebut pour les draeneï…‡德莱尼的垃圾...‡德萊尼的垃圾…',
    nil,
    'Leve Fragmentos Imperfeitos de Draenetista para Kum\'isha. Qualquer monstro da Barreira do Inferno pode estar carregando um fragmento desses.|n‡Принесите Кум\'ише несовершенные фрагменты дренетиста. У любого вида монстров в Выжженных землях могут быть эти фрагменты.‡Bringt Kum\'isha unvollständige Draenethystfragmente. Jede Art von Monster in den Verwüsteten Landen könnte ein Fragment bei sich tragen.‡굼이샤에게 불완전한 드레니시스트 조각을 가져가야 합니다. 저주받은 땅에 있는 야수는 모두 이 조각을 지니고 있을 가능성이 있습니다.‡Llévale a Kum\'isha trozos draenetistas imperfectos. Cualquier forma de monstruo de Las Tierras Devastadas podría llevar uno de estos fragmentos.|n‡Llévale a Kum\'isha trozos draenetistas imperfectos. Cualquier forma de monstruo de Las Tierras Devastadas podría llevar uno de estos fragmentos.|n‡Apportez des Fragments imparfaits de draenéthyste à Kum\'isha. N\'importe quel monstre des Terres Foudroyées peut détenir un fragment.‡将有瑕疵的德莱尼水晶碎片交给库米沙。诅咒之地的任何怪物都有可能携带着这样的碎片。‡將有瑕疵的德萊尼水晶碎片交給庫米沙。詛咒之地的任何怪物都有可能攜帶著這樣的碎片。',
  }
},
[3503] = {
  {
    'Chega de nhenhenhém!‡Встреча с господином‡Treffen mit dem Meister‡사나스의 스승‡Encuentro con el maestro‡Encuentro con el maestro‡Réunion avec le Maître‡见到主人‡見到主人',
    nil,
    nil,
  }
},
[3504] = {
  {
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Entregue a Carta Lacrada para Ag\'tor a Ag\'tor Punho de Sangue, em Azshara.‡Отнесите запечатанное письмо Аг\'тору Кровопалу в Азшару.‡Bringt den versiegelten Brief zu Ag\'tor Blutfaust nach Azshara.‡아즈샤라에 있는 아그토르 블러드피스트에게 아그토르에게 보내는 봉인된 편지를 전해야 합니다.‡Entrega la carta lacrada a Ag\'tor Puñosangre en Azshara.‡Entrega la carta lacrada a Ag\'tor Puñosangre en Azshara.‡Apporter la Lettre scellée à Ag\'tor Poing-de-sang en Azshara.‡把这封给阿格图的密信交给艾萨拉的阿格图·血拳。‡把這封給阿格圖的密信交給艾薩拉的阿格圖·血拳。',
  }
},
[3505] = {
  {
    '[DEPRECATED 4.x] Betrayed‡[DEPRECATED 4.x] Предательница‡Verraten‡배신‡[DEPRECATED 4.x] Traición‡[DEPRECATED 4.x] Traición‡[PÉRIMÉ 4.x]Trahison‡[DEPRECATED 4.x] 叛徒‡[DEPRECATED 4.x] 叛徒',
    nil,
    'Mate 10 Recuperadores Sanguinélficos e 10 Topógrafos Sanguinélficos antes de procurar o acampamento da Maga Rimtori. Quando localizá-lo, procure algo que possa ser importante para ela e possa ser usado para forçá-la a lutar.‡Убейте 10 эльфов крови-землемеров и 10 эльфов крови-геодезистов, потом разыщите лагерь волхва Римтори. В лагере найдите что-нибудь важное для мага, из-за чего она могла бы ринуться в бой.‡Tötet 10 Blutelfeneintreiber und 10 Blutelfenfeldmesser, bevor Ihr Magus Rimtoris Lager sucht. Sobald Ihr es gefunden habt, sucht nach etwas, das für sie von Bedeutung ist und das wir nehmen können, um sie in einen Kampf zu locken.‡블러드 엘프 수색병 10명과 블러드 엘프 감정관 10명을 처치한 후, 학자 림토리의 야영지를 찾아내십시오. 야영지를 찾으면 그녀를 싸움으로 유인하는데 사용할 수 있을 만한 것을 찾아보십시오. 림토리가 중요하게 여기는 것이라야 합니다.‡Mata a 10 reivindicadores y 10 peritos elfos de sangre antes de buscar el campamento de Maga Rimtori. Una vez allí, busca algo que sea importante para ella, algo con lo que provocar un combate.‡Mata a 10 reivindicadores y 10 peritos elfos de sangre antes de buscar el campamento de Maga Rimtori. Una vez allí, busca algo que sea importante para ella, algo con lo que provocar un combate.‡Tuer 10 Vengeurs elfes de sang et 10 Géomètres elfes de sang avant de rechercher le campement du magus Rimtori. Une fois le camp trouvé, chercher quelque chose d\'important pour elle et qui peut être utilisé pour l\'obliger à se battre.‡杀死10个血精灵搜寻者和10个血精灵勘测员，并找到大法师雷姆托里的营地。一旦你发现了营地，就去找到某个对她极为重要的东西，以用于激怒她，让她与你战斗。‡殺死10個血精靈搜尋者和10個血精靈探測員，然後尋找魔導師雷姆托里的營地。一旦你發現了營地，找出某個對她極為重要的東西，以用於激怒她，讓她與你戰鬥。',
  }
},
[3506] = {
  {
    'Traído‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Destrua o cristal de foco arcano preso à Maga Rimtori e mate-a. Depois, leve a Cabeça da Maga Rimtori para Ag\'tor Punho de Sangue em Azshara.‡Уничтожьте кристалл средоточия чар, связанный с волхвом Римтори, затем убейте ее. Отнесите голову Римтори Аг\'тору Кроволапу в Азшаре.‡Zerstört den arkanen Fokussierkristall, der an Magus Rimtori gebunden ist, und tötet sie danach. Bringt dann den Kopf von Magus Rimtori zu Ag\'tor Blutfaust nach Azshara.‡학자 림토리와 연결된 비전 집중의 수정을 파괴하고 그녀를 처치하십시오. 그런 다음 그 증거로 아즈샤라에 있는 아그토르 블러드피스트에게 학자 림토리의 머리카락을 가져가야 합니다.‡Destruye el cristal de enfoque Arcano de Maga Rimtori y entonces mátala. Lleva su cabeza a Ag\'tor Puñosangre a Azshara.‡Destruye el cristal de enfoque Arcano de Maga Rimtori y entonces mátala. Lleva su cabeza a Ag\'tor Puñosangre a Azshara.‡Détruire le Cristal de focalisation des arcanes lié au magus Rimtori et l\'assassiner ensuite. Puis apporter la tête du magus Rimtori à Ag\'tor Poing-de-sang en Azshara.‡摧毁大法师雷姆托里携带的奥术聚焦水晶并杀死她。然后把她的徽记交给艾萨拉的阿格图·血拳。‡摧毀魔導師雷姆托里身上的秘法聚焦水晶並殺死她。然後把她的腦袋交給艾薩拉的阿格圖·血拳。',
  }
},
[3507] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED 4.x] 叛徒‡',
    nil,
    '‡‡‡‡‡‡‡与奥格瑞玛的贝尔戈洛姆·石槌谈一谈。‡',
  }
},
[3508] = {
  {
    '‡Минуя охрану‡Den Zauberschutz brechen‡‡Romper el amuleto‡Romper el amuleto‡Briser l\'Amulette‡破坏结界‡',
    nil,
    '‡Подождите, пока Лорамус завершит заклинание просветления.‡Wartet, bis Loramus den Erleuchtungszauber vollendet hat.‡‡Espera que Loramus acabe el hechizo de ilustración.‡Espera que Loramus acabe el hechizo de ilustración.‡Attendre que Loramus ait achevé le rituel de Lumière.‡等待洛拉姆斯完成启迪法术。‡',
  }
},
[3509] = {
  {
    '‡Имя Зверя‡Der Name der Bestie‡‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡',
    nil,
    '‡Поговорите в Азшаре с лордом Арккоросом. Начните поиски у кромки воды, чтобы найти Храм Арккоран.‡Sprecht mit Lord Arkkoroc in Azshara. Beginnt Eure Suche am Rand des Wassers, um den Tempel von Arkkoran zu finden.‡‡Habla con Lord Arkkoroc en Azshara. Empieza tu búsqueda en la orilla para encontrar el Templo de Arkkoran.‡Habla con Lord Arkkoroc en Azshara. Empieza tu búsqueda en la orilla para encontrar el Templo de Arkkoran.‡Aller voir le seigneur Arkkoroc en Azshara. Commencer la recherche au bord de l\'eau pour trouver le temple d\'Arkkoran.‡与艾萨拉的亚考罗克谈一谈。你应该在海边搜索亚考兰神殿。‡',
  }
},
[3510] = {
  {
    '‡Имя Зверя‡Der Name der Bestie‡‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡',
    nil,
    '‡Убейте Хетайру и принесите окровавленную голову Хетайры, разбитую голову Хетайры и покрытую синяками голову Хетайры лорду Арккоросу.‡Erschlagt Hetaera und bringt den blutigen Kopf Hetaeras, den geschlagenen Kopf Hetaeras und den verwundeten Kopf Hetaeras zu Lord Arkkoroc.‡‡Mata a Hetaera y lleva la cabeza ensangrentada, la cabeza golpeada y la cabeza amoratada a Lord Arkkoroc.‡Mata a Hetaera y lleva la cabeza ensangrentada, la cabeza golpeada y la cabeza amoratada a Lord Arkkoroc.‡Assassiner Hetaera et apporter la Tête ensanglantée d\'Hetaera, la Tête battue d\'Hetaera et la Tête meurtrie d\'Hetaera au seigneur Arkkoroc.‡杀掉赫塔拉，将染血的赫塔拉徽记、破碎的赫塔拉徽记和淤血的赫塔拉徽记交给亚考罗克。‡',
  }
},
[3511] = {
  {
    '‡Имя Зверя‡Der Name der Bestie‡‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡',
    nil,
    '‡Отнесите состав для закалки Лорамусу Многоногу.‡Bringt den Härter zurück zu Loramus Thalipedes.‡‡Llévale el temple a Loramus Thalimedes.|n‡Llévale el temple a Loramus Thalimedes.|n‡Rapporter le durcisseur à Loramus Thalipedes.‡将调剂交给洛拉姆斯·萨里比迪斯。‡',
  }
},
[3512] = {
  {
    'Nas palavras do próprio Erânicos‡Судя по словам Эраникуса...‡Mit Eranikus\' eigenen Worten‡에라니쿠스의 말‡Como diría Eranikus...‡Como diría Eranikus...‡Par les mots d\'Eranikus‡帮助伊兰尼库斯‡幫助伊蘭尼庫斯',
    nil,
    'Viaje até o leste de Hibérnia e fale com Umbranse, o Médium.‡Отправляйтесь в восточную часть Зимних Ключей и поговорите с Умбрансом Ищущим Духов.‡Reist in den östlichen Teil von Winterquell und sprecht mit Umbranse, dem Geistsprecher.‡여명의 설원의 동쪽으로 가서 영매 엄브런스를 만나야 합니다.‡Viaja a la parte este de Cuna del Invierno y habla con Umbranse el Hablaalmas.‡Viaja a la parte este de Cuna del Invierno y habla con Umbranse el Hablaalmas.‡Se rendre dans la partie orientale du Berceau-de-l\'Hiver et aller voir Umbranse l\'implorateur d\'esprits.‡到冬泉谷的东部地区去，与灵语者阿姆布兰希谈一谈。‡到冬泉谷的東部地區去，與『靈語者』昂布蘭希談話。',
  }
},
[3513] = {
  {
    'O pergaminho rúnico‡Свиток с рунами‡Die runenverzierte Rolle‡룬새김 두루마리‡El pergamino rúnico‡El pergamino rúnico‡Le Parchemin runique‡符文卷轴‡符文卷軸',
    nil,
    'Leve o Pergaminho Rúnico até a torre de guarda norte nos Sertões.‡Отнесите свиток с рунами в северную сторожевую башню Степей.‡Bringt die runenverzierte Rolle zum nördlichen Wachturm des Brachlandes.‡불모의 땅의 북쪽 방어탑으로 룬새김 두루마리를 가져가야 합니다.‡Lleva el pergamino rúnico a la torre de vigilancia norte en Los Baldíos.‡Llévale el pergamino rúnico de la torre de vigilancia norte en Los Baldíos.‡Apporter le Parchemin runique à la tour de garde Nord dans les Tarides.‡将符文卷轴带到贫瘠之地的北部警戒塔去。‡將符文卷軸帶到貧瘠之地的北部警戒塔去。',
  }
},
[3514] = {
  {
    'Presença da Horda‡Мощь Орды‡Hordenpräsenz‡호드의 존재‡La presencia de la Horda‡La presencia de la Horda‡Présence de la Horde‡部落的示威‡部落的示威',
    nil,
    'Mate a líder do Retiro do Gadanho, Rynthariel, a Guardiã da Chave.‡Убейте предводительницу Логова Когтя, Ринтариэль Хранительницу Ключей.‡Tötet die Anführerin des Krallenbaus, Rynthariel die Schlüsselmeisterin.‡갈퀴발톱굴의 우두머리인 열쇠지기 린타리엘을 처치해야 합니다.‡Mata a la jefa de El Cubil del Espolón, Rynthariel la Maestra de llaves.‡Mata a la jefa de El Cubil del Espolón, Rynthariel la Maestra de llaves.‡Tuer le chef de l\'Antre des Serres, Rynthariel le Maître des clés.‡杀死猛禽洞穴的领袖琳萨瑞尔。‡殺死猛禽洞穴的領袖琳薩瑞爾。',
  }
},
[3515] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[3517] = {
  {
    'Roubando conhecimento‡Тайненькое знаньице‡Wissen stehlen‡서판 훔치기‡El robo de conocimientos‡El robo de conocimientos‡L\'art du vol‡搜索知识‡偷竊知識',
    nil,
    'Encontre a Tabuleta de Beth\'Amara, a Tabuleta de Jin\'yael, a Tabuleta de Markri e a Tabuleta de Sael\'hai. Depois volte a falar com Jediga, em Azshara.‡Найдите таблички Бет\'Амары, Джин\'яэль, Маркри и Саэль\'Хай и принесите их Джедиге в Азшару.‡Sucht die Schrifttafel von Beth\'Amara, die Schrifttafel von Jin\'yael, die Schrifttafel von Markri und die Schrifttafel von Sael\'hai, bevor Ihr zu Jediga in Azshara zurückkehrt.‡베스아마라 서판, 진야엘 서판, 마크리 서판, 샤엘하이 서판을 찾아 아즈샤라에 있는 제디가에게 가야 합니다.‡Encuentra la tablilla de Beth\'Amara, la tablilla de Jin\'yael, la tablilla de Markri y la tablilla de Sael\'hai antes de volver junto a Jediga en Azshara.‡Encuentra la tablilla de Beth\'Amara, la tablilla de Jin\'yael, la tablilla de Markri y la tablilla de Sael\'hai antes de volver junto a Jediga en Azshara.‡Trouver la Tablette de Beth\'Amara, la Tablette de Jin\'yael, la Tablette de Markri et la Tablette de Sael\'hai puis retourner voir Jediga en Azshara.‡找到贝萨玛拉石板、辛耶尔石板、玛科里石板和塞尔哈石板，把它们交给艾萨拉的杰迪加。‡找到貝薩瑪拉石板、辛耶爾石板、瑪寇里石板和塞爾哈石板，把它們交給艾薩拉的傑迪加。',
  }
},
[3518] = {
  {
    'Entrega para Magatha‡Доставка Магате‡Lieferung an Magatha‡마가타에게 전달‡Entrega a Magatha‡Entrega a Magatha‡Livraison à Magatha‡玛加萨的石版‡瑪加薩的石板',
    nil,
    'Leve a Tabuleta de Beth\'Amara para Magatha no Penhasco do Trovão.‡Отнесите табличку Бет\'Амары Магате в Громовой Утес.‡Bringt die Schrifttafel von Beth\'Amara zu Magatha in Donnerfels.‡썬더 블러프에 있는 마가타에게 베스아마라 서판을 가져가야 합니다.‡Llévale la tablilla de Beth\'Amara a Magatha en Cima del Trueno.‡Llévale la tablilla de Beth\'Amara a Magatha en Cima del Trueno.‡Apportez la Tablette de Beth\'Amara à Magatha aux Pitons-du-Tonnerre.‡将贝萨玛拉石板交给雷霆崖的玛加萨·恐怖图腾。‡將貝薩瑪拉石板交給雷霆崖的瑪加薩·恐怖圖騰。',
  }
},
[3519] = {
  {
    '‡Друг в беде‡Ein Freund in der Not‡도움이 필요한 친구‡Un amigo en apuros‡Un amigo en apuros‡Un ami dans le besoin‡需要帮助的朋友‡',
    nil,
    '‡Поговорите с Диранией Серебряным Сиянием в Тенистой долине.‡Sprecht mit Dirania Silberschein im Laubschattental.‡‡Habla con Dirania Brillargente en Cañada Umbría.‡Habla con Dirania Brillargente en Cañada Umbría.‡Allez Dirania Brillargent, au Sombrevallon.‡与幽影谷的迪兰妮亚·月光谈一谈。‡',
  }
},
[3520] = {
  {
    'Espíritos guinchadores‡Духи крикунов‡Kreischergeister‡계곡천둥매의 영혼‡Los espíritus de los estridadores‡Los espíritus de los estridadores‡Esprits de Hurleurs‡尖啸者的灵魂‡尖嘯者的靈魂',
    nil,
    'Capture os espíritos de 3 guinchadores em Feralas, e depois fale novamente com Yeh\'kinya no Porto de Bondebico.‡Поймайте души трех крикунов из Фераласа и возвращайтесь к Йе\'кинье в Порт Хитрой Шестеренки.‡Fangt die Geister von 3 Kreischern in Feralas ein und kehrt dann zu Yeh\'kinya beim Dampfdruckpier zurück.‡페랄라스에 있는 3마리의 계곡천둥매의 영혼을 모은 후 스팀휘들 항구에 있는 예킨야에게 가야 합니다.‡Captura el espíritu de 3 estridadores en Feralas y después ve a ver a Yeh\'kinya al Puerto Bonvapor.‡Captura el espíritu de 3 estridadores en Feralas y después ve a ver a Yeh\'kinya al Puerto Bonvapor.‡Capturer l\'Esprit de 3 Hurleurs en Féralas, puis retourner voir Yeh\'kinya à Port Gentepression.‡在菲拉斯捕获3个尖啸者的灵魂，然后回到热砂港的叶基亚那里去。‡到菲拉斯捕獲3個尖叫者的靈魂，然後回到熱砂港的葉金亞那裡。',
  }
},
[3521] = {
  {
    'O antídoto de Iverron‡Противоядие для Иверрона‡Iverrons Gegengift‡이베론을 위한 해독제‡El antídoto de Iverron‡El antídoto de Iverron‡L\'antidote d\'Iverron‡埃沃隆的解药‡埃沃隆的解藥',
    nil,
    'Collect 7 Hyacinth Mushrooms, 4 Moonpetal Lilies, and 1 Webwood Ichor.‡[Deprecated] Collect 7 Hyacinth Mushrooms, 4 Moonpetal Lilies, and 1 Webwood Ichor.‡Sammelt 7 Hyazinthpilze, 4 Mondblütenlilien und 1 Waldwebersekret.‡히아신스 버섯 7개, 달봉오리 백합 4개, 나무그물거미 영액 1개를 수집해야 합니다.‡Reúne 7 champiñones jacinto, 4 lirios alunados y 1 icor Tejemadera.‡Reúne 7 champiñones jacinto, 4 lirios alunados y 1 icor Tejemadera.‡Collectez 7 Champignons jacinthe, 4 Lys pétales de lune et 1 Ichor d\'araignée Tissebois.‡收集7朵紫蓝色蘑菇、4朵月牙百合花和一份树林蜘蛛的脓液。‡收集7朵紫藍色蘑菇、4朵月牙百合花和1份樹林蜘蛛的膿液。',
  }
},
[3522] = {
  {
    'O antídoto de Iverron‡Противоядие для Иверрона‡Iverrons Gegengift‡이베론을 위한 해독제‡El antídoto de Iverron‡El antídoto de Iverron‡L\'antidote d\'Iverron‡埃沃隆的解药‡埃沃隆的解藥',
    nil,
    'Leve o Antídoto de Iverron para Iverron antes que o tempo se esgote. Iverron está na caverna ao norte.‡Отнесите противоядие Иверрону, прежде чем оно потеряет свои целебные свойства. Иверрона можно найти около пещеры, что к северу отсюда.‡Bringt Iverrons Gegengift zu Iverron, bevor die Zeit um ist. Ihr findet Iverron bei der Höhle im Norden.‡제한 시간이 지나기 전에 이베론에게 해독제를 가져가야 합니다. 이베론은 북쪽에 있는 동굴 옆에서 찾을 수 있습니다.‡Llévale el antídoto de Iverron a Iverron antes de que se acabe el tiempo. Lo encontrarás junto a la cueva situada al norte.‡Llévale el antídoto de Iverron a Iverron antes de que se acabe el tiempo. Lo encontrarás junto a la cueva situada al norte.‡Apporter l\'Antidote d\'Iverron à Iverron avant que la limite de temps ne soit atteinte. Iverron se trouve près de la grotte, au nord.‡在5分钟内将埃沃隆的解药交给他。你可以北边的洞穴入口外面找到埃沃隆。‡在5分鐘內將埃沃隆的解藥交給他。你可以從在北邊的洞穴旁找到埃沃隆。',
  }
},
[3523] = {
  {
    'O Flagelo do Urzal‡Плеть и Курганы‡Geißel der Hügel‡가시덩굴 구릉의 스컬지‡La plaga de la Zahúrda‡La plaga de la Zahúrda‡Le Fléau des Souilles‡剃刀高地的亡灵天灾‡剃刀高地的天譴軍團',
    nil,
    'Se você concordar em ajudar Belnistrasz, fale novamente com ele e devolva a pedra de juramento que ele lhe deu.‡Если вы хотите помочь Белнистразу, поговорите с ним еще раз и верните ему Камень клятвы, который он дал вам.‡Wenn Ihr Belnistrasz helfen wollt, sprecht noch einmal mit ihm und übergebt ihm den Schwurstein, den er Euch gab.‡벨리스트라즈의 계획을 돕는 것에 동의하면 다시 그와 대화하여 그에게 서약의 돌을 돌려줘야 합니다.‡Si decides ayudar a Belnistrasz, habla con él otra vez y devuélvele la piedra de juramento.‡Si decides ayudar a Belnistrasz, habla con él otra vez y devuélvele la piedra de juramento.‡Pour aider Belnistrasz, lui parler de nouveau et lui rendre la Pierre de voeu qu\'il vous avait donnée.‡如果你同意帮助奔尼斯特拉兹，就再跟他谈谈，并将誓言石还给他。‡要是你願意幫助貝尼斯塔茲，再跟他談談，並將黑曜石還給他。',
  }
},
[3524] = {
  {
    'Deixa a água me levar‡Останки на берегу‡An Land gespült‡해변으로 올라온 바다 생물‡Varado‡Varado‡Échouage‡搁浅的巨兽‡擱淺的巨獸',
    nil,
    'Obtenha Ossos de Criaturas Marinhas da criatura marinha encalhada logo ao sul Auberdine e leve para Gwennyth Bly\'Leggonde em Auberdine.‡Соберите кости морской твари, выброшенной на берег к югу от Аубердина, и принесите их Гвеннид Блай\'Леггонд в Аубердин.‡Sammelt Meereskreaturknochen von der gestrandeten Meereskreatur unmittelbar südlich von Auberdine und kehrt dann mit ihnen zu Gwennyth Bly\'Leggonde nach Auberdine zurück.‡아우버다인 바로 남쪽에 있는 떠내려온 바다 생물에게서 바다 생물 뼈를 회수한 후, 아우버다인에 있는 그웨니스 블리레곤드에게 가져가야 합니다.‡Recoge huesos de la criatura marina varada que está al sur de Auberdine y llévaselos a Gwennyth Bly\'Leggonde a Auberdine.‡Recoge huesos de la criatura marina varada que está al sur de Auberdine y llévaselos a Gwennyth Bly\'Leggonde a Auberdine.‡Récupérer des Os de créature marine sur la créature échouée, au sud d\'Auberdine, puis les apporter à Gwennyth Bly\'Leggonde, à Auberdine.‡从奥伯丁南面的海岸上收集海洋生物的骨头，然后带着骨头向奥伯丁的温尼斯·布莱葛回复。‡在奧伯丁南邊的海岸上尋找擱淺生物的駭骨，然後帶著骨頭回來找奧伯丁的溫尼斯‧布萊葛。',
  }
},
[3525] = {
  {
    'O ídolo nefando‡Уничтожить идола‡Ausschalten des Götzen‡우상 진화‡Extinguir el ídolo‡Extinguir el ídolo‡L\'extinction de l\'idole‡封印神像‡封印塑像',
    nil,
    'Escolte Belnistrasz até o ídolo dos javatuscos no Urzal dos Mortos.|n|nProteja Belnistrasz enquanto ele realiza o ritual para desativar o ídolo.‡Сопроводите Белнистраза к идолу свинобразов в Курганах Иглошкурых. |n|nЗащищайте Белнистраза, пока он будет проводить ритуал, чтобы разрушить идола.‡Begleitet Belnistrasz zum Götzen der Stacheleber in den Hügeln der Klingenhauer.|n|nBeschützt Belnistrasz, während er das Ritual durchführt, um den Götzen auszuschalten.‡가시덩굴 구릉에 있는 가시멧돼지의 우상까지 벨리스트라즈를 호위해야 합니다.|n|n우상을 진화하는 의식을 수행하는 동안 벨리스트라즈를 보호해야 합니다.‡Acompaña a Belnistrasz al ídolo jabaespín en Zahúrda Rajacieno. |n|nProtégelo mientras realiza el ritual para inutilizar el ídolo.‡Acompaña a Belnistrasz al ídolo jabaespín en Zahúrda Rajacieno. |n|nProtégelo mientras realiza el ritual para inutilizar el ídolo.‡Escorter Belnistrasz jusqu\'à l\'Idole des hurans dans les Souilles de Tranchebauge.|n|nProtéger Belnistrasz tandis qu\'il exécute le rituel pour arrêter l\'idole.‡保护奔尼斯特拉兹来到剃刀高地的野猪人神像处。|n|n当他在进行仪式封印神像时保护他。‡護送貝尼斯塔茲來到剃刀高地的野豬人塑像處。|n|n當他在執行儀式封印塑像時保護他。',
  }
},
[3526] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia a Nixx Molapinhão em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Gobliningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Elastirouage dans Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想學習哥布林工程學的知識，就把工程學教材手冊交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3527] = {
  {
    'A profecia de Mosh\'aru‡Пророчество Мошару‡Die Prophezeiung von Mosh\'aru‡모쉬아루의 예언‡La profecía de Mosh\'aru‡La profecía de Mosh\'aru‡La prophétie de Mosh\'aru‡摩沙鲁的预言‡摩沙魯的預言',
    nil,
    'Leve a Primeira e a Segunda Tabuleta Mosh\'Aru para Yeh\'kinya, em Tanaris.‡Принесите первую и вторую таблички Мошару Йе\'кинье в Танарис.‡Bringt die erste und die zweite Schrifttafel von Mosh\'aru zu Yeh\'kinya nach Tanaris.‡타나리스에 있는 예킨야에게 첫번째 모쉬아루 서판과 두번째 모쉬아루 서판을 가져가야 합니다.‡Llévale la primera y segunda tablillas Mosh\'aru a Yeh\'kinya, que está en Tanaris.‡Llévale la primera y segunda tablillas Mosh\'aru a Yeh\'kinya, que está en Tanaris.‡Apportez les Première et Deuxième tablettes Mosh\'Aru à Yeh\'kinya, à Tanaris.‡将第一块和第二块摩沙鲁石板交给塔纳利斯的叶基亚。‡將第一塊和第二塊摩沙魯石板交給塔納利斯的葉基亞。',
  }
},
[3528] = {
  {
    'O deus Hakkar‡Бог Хаккар‡Der Gott Hakkar‡학카르의 화신‡El dios Hakkar‡El dios Hakkar‡Le dieu Hakkar‡神灵哈卡‡神靈哈卡',
    nil,
    'Leve o Ovo de Hakkar Cheio para Yeh\'kinya, em Tanaris.‡Отнесите заполненное яйцо Хаккара Йе\'кинье в Танарис.‡Bringt das gefüllte Ei von Hakkar zu Yeh\'kinya nach Tanaris.‡타나리스에 있는 예킨야에게 충만한 학카르의 알을 가져가야 합니다.‡Llévale el huevo de Hakkar relleno a Yeh\'kinya, que está en Tanaris.‡Llévale el huevo de Hakkar relleno a Yeh\'kinya, que está en Tanaris.‡Apportez l’Œuf d\'Hakkar rempli à Yeh\'kinya dans Tanaris.‡将装满的哈卡之卵交给塔纳利斯的叶基亚。‡將裝滿的哈卡之卵交給塔納利斯的葉基亞。',
  }
},
[3529] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[3541] = {
  {
    'Entrega para Sona\'rima‡Доставка Джес\'римону‡Lieferung an Jes\'rimon‡제스리몬에게 전달‡Entrega a Jes\'rimon‡Entrega a Jes\'rimon‡Livraison pour Jes\'rimon‡杰斯雷蒙的石版‡送貨給傑斯雷蒙',
    nil,
    'Leve a Tabuleta de Jin\'yael para Sona\'rima em Orgrimmar.‡Отнесите табличку Джин\'яэль Джес\'римону в Оргриммар.‡Bringt die Schrifttafel von Jin\'yael zu Jes\'rimon nach Orgrimmar.‡오그리마에 있는 제스리몬에게 진야엘 서판을 가져가야 합니다.‡Envía la tablilla de Jin\'yael a Jes\'rimon en Orgrimmar.‡Envía la tablilla de Jin\'yael a Jes\'rimon en Orgrimmar.‡Apportez la Tablette de Jin\'yael à Jes\'rimon à Orgrimmar.‡将辛耶尔石板交给奥格瑞玛的杰斯雷蒙。‡將辛耶爾石板交給奧格瑪的傑斯雷蒙。',
  }
},
[3542] = {
  {
    'Entrega para Andron Gante‡Доставка Андрону Ганту‡Lieferung an Andron Gant‡안드론 건트에게 전달‡Entrega a Andron Gant‡Entrega a Andron Gant‡Livraison à Andron Gant‡安德隆·甘特的石版‡送貨給安德隆·甘特',
    nil,
    'Leve a Tabuleta de Markri para Andron Gante na Cidade Baixa.‡Отнесите табличку Маркри Андрону Ганту в Подгород.‡Bringt die Schrifttafel von Markri zu Andron Gant nach Unterstadt.‡언더시티에 있는 안드론 건트에게 마크리 서판을 가져가야 합니다.‡Llévale la tablilla de Markri a Andron Gant en Entrañas.‡Llévale la tablilla de Markri a Andron Gant en Entrañas.‡Apportez la Tablette de Markri à Andron Gant à Fossoyeuse.‡将玛科里石板交给幽暗城的安德隆·甘特。‡將瑪寇里石板交給幽暗城的安德隆·甘特。',
  }
},
[3561] = {
  {
    'Entrega para o Arquimago Tauriel‡Доставка верховному магу Ксилему‡Lieferung für Erzmagier Xylem‡대마법사 실렘에게 전달‡Entrega al archimago Xylem‡Entrega al archimago Xylem‡Livraison à l\'archimage Xylem‡大法师克希雷姆的石版‡送貨給大法師克希雷姆',
    nil,
    'Leve a Tabuleta de Sael\'hai para o Arquimago Tauriel em Azshara.‡Отнесите табличку Саэль\'Хай верховному магу Ксилему в Азшару.‡Bringt die Schrifttafel von Sael\'hai zu Erzmagier Xylem in Azshara.‡아즈샤라에 있는 대마법사 실렘에게 샤엘하이 서판을 가져가야 합니다.‡Llévale la tablilla de Sael\'hai al archimago Xylem en Azshara.‡Llévale la tablilla de Sael\'hai al archimago Xylem en Azshara.‡Apportez la Tablette de Sael\'hai à l\'archimage Xylem en Azshara.‡将塞尔哈石板交给艾萨拉的大法师克希雷姆。‡將塞爾哈石板交給艾薩拉的大法師克希雷姆。',
  }
},
[3563] = {
  {
    'O pagamento de Sona\'rima para Jediga‡Плата Джес\'римона Джедиге‡Jes\'rimons Bezahlung für Jediga‡제디가에 대한 제스리몬의 답례‡El pago de Jes\'rimon a Jediga‡El pago de Jes\'rimon a Jediga‡Le paiement de Jes\'rimon à Jediga‡杰斯雷蒙的报酬‡傑斯雷蒙的報酬',
    nil,
    'Entregue o Bilhete de Sona\'rima para Jediga, em Azshara.‡Доставьте записку Джес\'римона Джедиге в Азшару.‡Bringt Jes\'rimons Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 제스리몬의 쪽지를 가져가야 합니다.‡Entrega la nota de Jes\'rimon a Jediga en Azshara.‡Entrega la nota de Jes\'rimon a Jediga en Azshara.‡Apporter la Note de Jes\'rimon à Jediga en Azshara.‡将杰斯雷蒙的便笺交给艾萨拉的杰迪加。‡將傑斯雷蒙的便箋交給艾薩拉的傑迪加。',
  }
},
[3564] = {
  {
    'O pagamento de Andron para Jediga‡Плата Андрона Джедиге‡Androns Bezahlung für Jediga‡제디가에 대한 안드론 건트의 보답‡El pago de Andron a Jediga‡El pago de Andron a Jediga‡Le paiement d\'Andron à Jediga‡安德隆的报酬‡安德隆的報酬',
    nil,
    'Entregue o Bilhete de Andron para Jediga, em Azshara.‡Доставьте записку Андрона Джедиге в Азшару.‡Bringt Androns Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 안드론의 쪽지를 가져가야 합니다.‡Entrega la nota de Andron a Jediga en Azshara.‡Entrega la nota de Andron a Jediga en Azshara.‡Apporter la Note d\'Andron à Jediga en Azshara.‡将安德隆的便笺交给艾萨拉的杰迪加。‡將安德隆的字條交給艾薩拉的傑迪加。',
  }
},
[3565] = {
  {
    'O pagamento de Tauriel para Jediga‡Плата Ксилема Джедиге‡Xylems Bezahlung für Jediga‡제디가에 대한 실렘의 보답‡El pago de Xylem a Jediga‡El pago de Xylem a Jediga‡Le paiement de Xylem à Jediga‡克希雷姆的报酬‡克希雷姆的報酬',
    nil,
    'Entregue o Bilhete de Tauriel para Jediga, em Azshara.‡Доставь записку Ксилема Джедиге в Азшару.‡Bringt Xylems Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 실렘의 쪽지를 가져가야 합니다.‡Entrega la nota de Xylem a Jediga en Azshara.‡Entrega la nota de Xylem a Jediga en Azshara.‡Apporter la Note de Xylem à Jediga en Azshara.‡将克希雷姆的便笺交给艾萨拉的杰迪加。‡將克希雷姆的便箋交給艾薩拉的傑迪加。',
  }
},
[3566] = {
  {
    '‡Восстань, Обсидион!‡Erhebt Euch, Obsidion!‡‡¡Arriba, Obsidion!‡¡Arriba, Obsidion!‡Debout, Obsidion !‡奥比斯顿‡',
    nil,
    '‡Убейте Латорика Черного и Обсидиона и принесите голову Латорика и сердце Обсидиона Ториусу в Стальгорн.‡Tötet Lathoric den Schwarzen und Obsidion. Kehrt zurück zu Thorius nach Eisenschmiede mit dem Kopf von Lathoric dem Schwarzen und dem Herzen von Obsidion.‡[Slay Lathoric the Black and Obsidion, and return to Thorius in Ironforge with the Head of Lathoric the Black and the Heart of Obsidion. ]‡Lleva la cabeza de Lathoric el Negro y el corazón de Obsidion a Torio a Forjaz.‡Lleva la cabeza de Lathoric el Negro y el corazón de Obsidion a Torio a Forjaz.‡Assassiner Lathoric le Noir et Obsidion, puis retourner voir Thorius, à Forgefer, avec la Tête de Lathoric le Noir et le Cœur d\'Obsidion.‡杀死黑衣拉索里克和奥比斯顿，带着黑衣拉索里克的徽记和奥比斯顿的精华回到铁炉堡的索里奥斯那儿。‡',
  }
},
[3567] = {
  {
    '‡Умный в гору не пойдет...‡An die Spitze‡높은 곳‡A la cima‡A la cima‡Au sommet‡登高‡',
    nil,
    nil,
  }
},
[3568] = {
  {
    'Corrupção líquida‡Разносчик порчи‡Verbreitete Verderbnis‡스며드는 타락‡La filtración de la corrupción‡La filtración de la corrupción‡Corruption suintante‡堕落之水‡墮落之水',
    nil,
    'Encha as 4 Ampolas Vazias nas poças ao longo da costa das Ruínas de Eldarath em Azshara. Em seguida, volte a falar com o Químico Arnaldo.‡Наполните все 4 пустых фиала из приливных заводей в руинах Эльдарата и возвращайтесь к химику Карабосу.‡Füllt alle 4 leeren Phiolen an den Gezeitenteichen entlang der Küste der Ruinen von Eldarath in Azshara und kehrt dann zu Chemiker Miesmut zurück.‡아즈샤라에 있는 엘다라스 폐허의 해변을 따라 가면서 4개의 빈 약병에 해일의 구덩이의 물을 모두 채운 후, 연금술사 큘리에게 가야 합니다.‡Llena los 4 viales vacíos en las pozas de las mareas que se encuentran a lo largo de la costa de las Ruinas de Eldarath en Azshara y después ve a ver al químico Cuely.‡Llena los 4 viales vacíos en las pozas de las mareas que se encuentran a lo largo de la costa de las Ruinas de Eldarath en Azshara y después ve a ver al químico Cuely.‡Avant de retourner voir le Chimiste Cuely, remplir les 4 Fioles vides dans les cuvettes de marées le long de la côte des Ruines d\'Eldarath, en Azshara.‡在艾萨拉的埃达拉斯废墟旁的海潮之池中收集4瓶水，然后回到药剂师科雷那儿。‡在艾薩拉的埃達拉斯廢墟旁的海潮之池中收集4瓶水，然後回到藥劑師科雷那兒。',
  }
},
[3569] = {
  {
    '‡Разносчик заразы‡Verbreitete Verderbnis‡스며드는 타락‡La filtración de la corrupción‡La filtración de la corrupción‡Corruption suintante‡堕落之水‡',
    nil,
    '‡Дайте эликсир Карабоса Терсе Песне Ветра в Подгороде.‡Gebt Miesmuts Elixier Thersa Windweise in Unterstadt.‡‡Dale el elixir de Cuely a Thersa Son del Viento, que está en Entrañas.‡Dale el elixir de Cuely a Thersa Son del Viento, que está en Entrañas.‡Donner l\'élixir de Cuely à Thersa Chant-du-vent, à Fossoyeuse.‡将科雷的药剂交给幽暗城的瑟尔萨·风歌。‡',
  }
},
[3570] = {
  {
    '‡Разносчик заразы‡Verbreitete Verderbnis‡스며드는 타락‡La filtración de la corrupción‡La filtración de la corrupción‡Corruption suintante‡堕落之水‡',
    nil,
    nil,
  }
},
[3581] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Speak to Saern Priderunner again to learn the Plainsrunning skill.‡Поговорите с Саерном Гордая Поступь еще раз, чтобы освоить "Бег по равнинам".‡Sprecht noch einmal mit Saern Stolzlauf, um die Fertigkeit des Ebenenlaufens zu erlernen.‡살옌 프라이드러너와 다시 대화해 초원의 질주 기술을 배워야 합니다.‡Vuelve a hablar con Saern Correorgullo para aprender la facultad Correr planicies.‡Habla con Saern Correorgullo otra vez para aprender la habilidad Correr planicies.‡Retourner voir Saern Cours-avec-fierté pour apprendre la compétence de Course dans les plaines.‡再次与赛恩交谈并学习原野疾驰技能。‡再次與賽恩‧傲行者談話來學習原野疾馳技能。',
  }
},
[3601] = {
  {
    'Kam\'arawn é a mãe!‡Оскорбленный Ким\'джаель‡Kim\'jael, fürwahr!‡킴야엘‡¡Kim\'jael, claro!‡¡Kim\'jael, claro!‡Kim\'jael évidemment !‡我就是基姆加尔！‡我就是基姆加爾!',
    nil,
    'Vasculhe o Acampamento Talassiano e encontre os seguintes itens de Kam\'arawn: A Bússola, o Telescópio, o Frango Recheado e a Chinforímpola. Depois, devolva os itens para Kam\'arawn em Azsahra.‡Обыщите Талассийское поселение и найдите компас, прицел, плюшевого цыпленка и центробежный растягиватель Ким\'джаеля. Верните все это Ким\'джаелю в Азшару.‡Durchsucht den thalassischen Stützpunkt nach Kim\'jaels Kompass, Zielfernrohr, ausgestopftem Huhn und Knobelwizz und bringt ihm dann alles nach Azshara zurück.‡탈라시안 주둔지에서 킴야엘의 나침반, 망원경, 박제한 닭, 땅콩까개를 찾은 후, 아즈샤라에 있는 킴야엘에게 돌려줘야 합니다.‡Busca en el Campamento base thalassiano la brújula de Kim\'jael, la mira, el pollo relleno y el cachivache y llévaselo todo a Azshara.‡Busca en el Campamento base thalassiano la brújula de Kim\'jael, la mira, el pollo relleno y el cachivache y llévaselo todo a Azshara.‡Fouiller le Camp de base thalassien pour trouver la Boussole, la Lunette, le Poulet farci et le Wizzlegoober de Kim\'Jael, puis les lui rapporter en Azshara.‡搜索萨拉斯营地，找到基姆加尔的指南针、望远镜、烧鸡和花生，然后把它们交给艾萨拉的基姆加尔。‡搜索薩拉斯營地，尋找基姆加爾的指南針，望遠鏡，燒雞和齒輪，然後將它們交還給艾薩拉的基姆加爾。',
  }
},
[3602] = {
  {
    '‡Азшарит‡Azsharit‡‡Azsharita‡Azsharita‡‡艾萨拉水晶‡',
    nil,
    '‡Найдите в южной Азшаре двадцать кристаллов азшарита. Вы можете использовать Гончих Скверны, которые помогут вам "вынюхивать" местонахождение хорошо сокрытых залежей. |n|nКогда задача будет завершена, возвращайтесь к Лорамусу Многоногу.‡Sammelt 20 kristallisierte Azsharite im südlichen Azshara. Ihr könnt den Teufelshund benutzen, damit er Euch beim \'Erschnüffeln\' der gut versteckten Ablagerungen behilflich ist.|n|nKehrt zu Loramus zurück, sobald Ihr die Aufgabe erfüllt habt.‡‡Recupera 20 azsharitas cristalizadas del sur de Azshara. Puede que encuentres canes manáfagos dispuestos a ayudarte a rastrear la ubicación de los depósitos hábilmente escondidos.|n|nVuelve con Loramus cuando hayas completado la tarea.|n‡Recupera 20 azsharitas cristalizadas del sur de Azshara. Puede que encuentres canes manáfagos dispuestos a ayudarte a rastrear la ubicación de los depósitos hábilmente escondidos.|n|nVuelve con Loramus cuando hayas completado la tarea.|n‡Trouvez 20 Azsharites cristallisées au sud d\'Azshara. Utilisez éventuellement le gangrechien pour « renifler » l\'emplacement où sont intelligemment cachés les dépôts.|n|nRetournez voir Loramus une fois votre tâche accomplie.‡在艾萨拉南部收集20块艾萨拉晶体。你可以使用地狱犬协助寻找一些隐藏的矿脉。|n|n任务完成之后就回到洛拉姆斯那里去。‡',
  }
},
[3621] = {
  {
    'A destruição vil‡Создание отравы Скверны‡Die Herstellung von Teufelsbann‡퇴마 무기 제작‡La formación de Aterravil‡La formación de Aterravil‡La formation du gangreplaie‡武器的铸造‡武器的鑄造',
    nil,
    'Leve o Carregamento para Galvan, o Antigo, na Selva do Espinhaço.‡Отнести груз Гальвану Древнему в Тернистую долину.‡Bringt die Lieferung zu Galvan dem Alten im Schlingendorntal.‡가시덤불 골짜기에 있는 갈반에게 상자를 가져가야 합니다.‡Llévale el envío a Galvan el Antiguo en la Vega de Tuercespina.‡Llévale el envío a Galvan el Antiguo en la Vega de Tuercespina.‡Apporter la cargaison à Galvan l\'Ancien dans la vallée de Strangleronce.‡把货物交给荆棘谷的加尔文。‡把貨物交給荊棘谷的『長者』加爾文。',
  }
},
[3622] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[3625] = {
  {
    '‡Зачарованное азшаритовое оружие, отравленное Скверной‡Verzauberte Azsharitteufelswaffe‡‡Armas Fel en Azsharita encantada‡Armas Fel en Azsharita encantada‡Armes gangrenées en azsharite enchantée‡魔化艾萨拉水晶武器‡',
    nil,
    '‡Подождите, пока Гальван закончит отковывать оружие.‡Wartet, bis Galvan die Waffen fertig geschmiedet hat.‡‡Espera que Galvan acabe de forjar las armas.‡Espera que Galvan acabe de forjar las armas.‡Attendre que Galvan ait fini de forger les armes.‡等待加尔文为你锻造武器。‡',
  }
},
[3626] = {
  {
    'Retorno à Barreira do Inferno‡Возвращение в Выжженные земли‡Rückkehr in die Verwüsteten Lande‡저주받은 땅으로의 귀환‡Regresa a Las Tierras Devastadas‡Regresa a Las Tierras Devastadas‡Retour dans les terres Foudroyées‡返回诅咒之地‡返回詛咒之地',
    nil,
    'Return to the Fallen Hero of the Horde at Splinterspear Junction in Swamp of Sorrows.‡Вернитесь к Павшему герою Орды на Развилку Расщепленного Копья, что на Болоте Печали.‡Kehrt zum Gefallenen Helden der Horde zurück. Zu finden ist er an der Splitterspeerkreuzung in den Sümpfen des Elends.‡슬픔의 늪의 부러진창 교차로에 있는 호드 영웅의 넋에게 가야 합니다.‡Vuelve junto al héroe caído de la Horda en el Cruce Lanzarrota, en el Pantano de las Penas.‡Vuelve junto al héroe caído de la Horda en el Cruce Lanzarrota, en el Pantano de las Penas.‡Retourner voir le Héros de la Horde tombé au combat, au Croisement de Lance-brisée, au Marais des Chagrins.‡回到悲伤沼泽中断矛路口的部落英雄的灵魂那里。‡到悲傷沼澤的斷矛路口找部落英雄的靈魂。',
  }
},
[3627] = {
  {
    'Restaurando o amuleto estilhaçado‡Воссоединить расколотый амулет‡Das zerbrochene Amulett vereinen‡조각난 아뮬렛 재결합‡Juntar pedazos del amuleto‡Juntar pedazos del amuleto‡Réunir les morceaux de l\'amulette brisée‡收集破碎的护符‡收集破碎的護符',
    nil,
    'Mate Grol, o Destruidor, Lady Sevine e o Arquimago Allistarj. De seus corpos, pegue o Amuleto de Grol, o Amuleto de Sevine e o Amuleto de Allistarj.|n|nLembre-se de usar o Armamento Vil de Azsharita Encantada para enfraquecer a tríade, pois só assim eles podem ser derrotados... mas use-o com sabedoria.|n‡Убейте Грола Разрушителя, леди Севину и верховного мага Аллистария. С их трупов заберите Амулет Грола, Амулет Севины и Амулет Аллистария.|n|nПомните о том, что нужно использовать зачарованное азшаритовое оружие, отравленное Скверной, чтобы ослабить троицу! Их нельзя убить иначе – но используйте оружие разумно...‡Tötet Grol den Zerstörer, Lady Sevine und Erzmagier Allistarj. Nehmt das Amulett von Grol, das Amulett von Sevine und das Amulett von Allistarj von ihren Leichen.|n|nDenkt daran, Eure Verzauberte Azsharitteufelswaffe zu BENUTZEN, um die Triade zu schwächen. Auf eine andere Weise können sie nicht getötet werden - aber verwendet sie weise...‡파괴자 그롤, 여군주 세바인, 대마법사 알리스타즈를 처치하고 그들의 시체에서 그롤의 아뮬렛, 세바인의 아뮬렛, 알리스타즈의 아뮬렛을 회수해야 합니다.|n|n마력이 깃든 아즈샤리트 퇴마 무기를 사용하여 3인조의 힘을 약화시켜야 그들을 처치할 수 있다는 것을 명심하십시오. 반드시 현명하게 사용해야 합니다.‡Mata a Grol el Destructor, a Lady Sevine y al archimago Allistarj. De sus cadáveres coge el amuleto de Grol, el amuleto de Sevine y el amuleto de Allistarj.|n|nAcuérdate de USAR tus armas viles de azsharita encantada para debilitar a la tríade. Es la única forma de matarlos, pero úsalas con moderación...|n‡Mata a Grol el Destructor, a Lady Sevine y al archimago Allistarj. De sus cadáveres, despoja el amuleto de Grol, el amuleto de Sevine y el amuleto de Allistarj.|n|nAcuérdate de USAR tus armas viles de azsharita encantada para debilitar a la tríade. Es la única forma de matarlos, pero úsalas con moderación...|n‡Assassiner Grol le Destructeur, dame Sevine et l\'archimage Allistarj. Prendre sur leurs cadavres l\'Amulette de Grol, l\'Amulette de Sevine et l\'Amulette d\'Allistarj.|n|nN\'oubliez pas d\'UTILISER vos armes gangrenées en azsharite enchantée pour affaiblir la triade (ils ne peuvent pas être tués autrement), mais faites-le sagement...‡杀掉毁灭者戈洛尔、瑟温妮，以及大法师奥利斯塔。从他们到尸体上拿到戈洛尔的护符、瑟温妮的护符和奥利斯塔的护符。|n|n记住使用你的魔化艾萨拉水晶武器来削弱他们，否则他们是无法被杀死的——你必须小心谨慎地使用你的武器......‡殺掉『毀滅者』戈洛爾、瑟溫妮女士，以及大法師奧利斯塔。從他們到屍體上拿到戈洛爾的護符、瑟溫妮的護符和奧利斯塔的護符。|n|n記住使用你的附魔艾薩拉水晶魔化武器來削弱他們，否則他們是無法被殺死的─你必須小心謹慎地使用你的武器……',
  }
},
[3628] = {
  {
    '‡Ты – Рах\'лих, демон!‡Ihr seid Rakh\'likh, Dämon‡악마, 네 이름은 라크리크‡Eres Rakh\'likh, demonio‡Eres Rakh\'likh, demonio‡Son nom est Rakh\'likh‡恶魔拉瑟莱克‡',
    nil,
    '‡Уничтожьте Разелиха Осквернителя и вернитесь к Павшему герою Орды с Отрубленным Рогом Осквернителя. Вам также понадобится вернуть Оберег Осквернителя, чтобы Павший герой мог уничтожить его, дабы оберег не попал к тому, кто использует его во зло.‡Vernichtet Razelikh den Entweiher und bringt das abgespaltene Horn des Entweihers zum Gefallenen Helden der Horde. Ihr müsst außerdem den Zauberschutz des Entweihers mit zurückbringen, damit der Gefallene Held ihn zerstören und somit verhindern kann, dass er jemals in die falschen Hände fällt.‡‡Destruye a Razelikh el Rapiñador y llévale el cuerno de Rapiñador cortado al héroe caído de la Horda. También tendrás que devolver el Resguardo del Rapiñador para que el héroe caído pueda destruirlo y así impedir que caiga en las manos equivocadas.|n‡Destruye a Razelikh el Rapiñador y llévale el cuerno de Rapiñador cortado al héroe caído de la Horda. También tendrás que devolver el Resguardo del Rapiñador para que el héroe caído pueda destruirlo y así impedir que caiga en las manos equivocadas.|n‡Détruire Razelikh le Souilleur et apporter la Corne brisée du Souilleur au Héros de la Horde tombé au combat. Rendre aussi l\'Amulette du Souilleur au Héros pour qu\'il puisse la détruire, afin de l\'empêcher de tomber entre de mauvaises mains.‡消灭污染者拉瑟莱克，将污染者之角交给部落英雄的灵魂。另外你还要把污染者防护结界交给他，这样部落英雄的灵魂就可以消灭它，以避免它落入邪恶势力之手。‡',
  }
},
[3629] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Gobliningenieurskunst erlernen wollt, dann bringt das Handbuch der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Elastirouage dans Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想要對哥布林工程學有更多瞭解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3630] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa em Altaforja.‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Tüftlermeister Oberfunks nach Eisenschmiede.‡노움 기계공학에 대해 더 배우고자 한다면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más sobre ingeniería gnoma, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Suprétincelle, à Forgefer.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3631] = {
  {
    'Evocar Corcel Vil‡Призыв коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan nos Sertões.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan im Brachland.‡불모의 땅에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Los Baldíos.‡Habla con Strahad Farsan en Los Baldíos.‡Parlez à Strahad Farsan, dans les Tarides.‡与贫瘠之地棘齿城的斯坦哈德·法尔杉谈一谈。‡與貧瘠之地棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[3632] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa em Altaforja.‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Tüftlermeister Oberfunks nach Eisenschmiede.‡노움 기계공학에 대해 더 알고 싶으면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Suprétincelle, à Forgefer.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3633] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan, que fica em Tanaris.‡Если вы хотите узнать о гоблинском инженерном деле, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск, что в Танарисе.‡Wenn Ihr etwas über die Gobliningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan in Tanaris.‡고블린 기계공학에 대해 더 알고 싶으면 타나리스의 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan, en Tanaris.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan, en Tanaris.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Elastirouage, à Gadgetzan, en Tanaris.‡如果你想要对地精工程学有更多了解，就把工程学教材交给塔纳利斯的加基森的尼克斯·斯普克斯宾。‡如果你想要對哥布林工程學有更多瞭解，就把工程學教材帶到塔納利斯交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3634] = {
  {
    '‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡',
    nil,
    '‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Tüftlermeister Oberfunks nach Eisenschmiede.‡노움 기계공학에 대해 더 배우고자 한다면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Suprétincelle, à Forgefer.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡',
  }
},
[3635] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser aprender mais sobre Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia para Olhatorto Obnótico na Angra do Butim.‡Если вы хотите узнать побольше о гномском инженерном деле, возьмите справочник по инженерным дисциплинам и отнесите его Карлсу Пропеллерзу в Пиратскую Бухту.‡Wenn Ihr mehr über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Glotz Widrikus nach Beutebucht.‡노움 기계공학에 대해 더 알고 싶으면 무법항에 있는 오글소프 오브노티쿠스에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie à Orguignard Odipnoticus à Baie-du-Butin.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给藏宝海湾的奥格索普·奥布诺提斯。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[3636] = {
  {
    'Trazer a luz‡Нести свет‡Das Licht bringen‡빛의 힘‡Trae la Luz‡Trae la Luz‡Apportez la Lumière‡与圣光同在‡與聖光同在',
    nil,
    'O Arcebispo Benedito quer que você mate Amnennar, o Frigífero, no Urzal dos Mortos.‡Убейте Амненнара Хладовея в Курганах Иглошкурых.‡Erzbischof Benedictus will, dass Ihr Amnennar den Kältebringer in den Hügeln der Klingenhauer tötet.‡대주교 베네딕투스가 가시덩굴 구릉에 있는 혹한의 암네나르를 처치해 달라고 했습니다.‡El arzobispo Benedictus quiere que mates a Amnennar el Gélido en Zahúrda Rajacieno.‡El arzobispo Benedictus quiere que mates a Amnennar el Gélido en Zahúrda Rajacieno.‡Tuer Amnennar le Porte-froid, aux Souilles de Tranchebauge, pour l\'Archevêque Benedictus.‡大主教本尼迪塔斯要你去杀死剃刀高地的寒冰之王亚门纳尔。‡大主教本尼迪塔斯要你去殺死剃刀高地的『寒冰使者』亞門納爾。',
  }
},
[3637] = {
  {
    '‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    '‡Если вы хотите узнать побольше о гномском инженерном деле, возьмите справочник по инженерным дисциплинам и отнесите его Карлсу Пропеллерзу в Пиратскую Бухту.‡Wenn Ihr mehr über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Glotz Widrikus nach Beutebucht.‡‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie à Orguignard Odipnoticus à Baie-du-Butin.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给藏宝海湾的奥格索普·奥布诺提斯。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[3638] = {
  {
    '‡Договор о неразглашении‡Der Schwur der Geheimhaltung‡‡La promesa del secreto‡La promesa del secreto‡Le Vœu du secret‡保密协议‡',
    nil,
    '‡Если вы согласны заниматься гоблинским инженерным делом, щелкните правой кнопкой мыши по Договору о неразглашении и еще раз обратитесь к Никсу Шепружину в Прибамбасске.‡Wenn Ihr ein Gobliningenieur werden wollt, dann müsst Ihr auf den Schwur der Geheimhaltung rechtsklicken und erneut mit Nixx Sprossfeder in Gadgetzan sprechen.‡‡Si decides dedicarte a la ingeniería goblin, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Nixx Muellepiñón de Gadgetzan.‡Si decides dedicarte a la ingeniería goblin, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Nixx Muellepiñón de Gadgetzan.‡Pour devenir un Ingénieur gobelin, cliquer avec le bouton droit sur le Vœu de secret et retourner voir une fois encore Nixx Elastirouage dans Gadgetzan.‡如果你同意成为一名地精技师，就右键点击保密协议，然后再次和加基森的尼克斯·斯普克斯宾谈一谈。‡',
  }
},
[3639] = {
  {
    'Mostrando trabalho‡Покажи свою работу‡Zeigt Eure Arbeit‡직접 만든 물건‡Muestra tu trabajo‡Muestra tu trabajo‡Montrez votre travail‡工作成果‡工作成果',
    nil,
    'Traga 20 Bombas Grandes de Ferro, 20 Dinamites Maciças e 5 Ovelhas Explosivas para Nixx Molapinhão em Geringontzan.‡Принесите 20 больших железных бомб, 20 шашек плотного динамита и 5 взрывоопасных овец Никсу Шепружину в Прибамбасск.‡Bringt 20 große Eisenbomben, 20 robuste Dynamitstangen und 5 explosive Schafe zu Nixx Sprossfeder nach Gadgetzan.‡가젯잔에 있는 닉스 스프로켓스프링에게 대형 철제 폭탄 20개, 조밀한 다이너마이트 20개, 그리고 양 폭탄 5개를 가져가야 합니다.‡Llévale 20 bombas grandes de hierro, 20 cartuchos de dinamita sólida y 5 ovejas explosivas a Nixx Muellepiñón de Gadgetzan.‡Llévale 20 bombas grandes de hierro, 20 cartuchos de dinamita sólida y 5 ovejas explosivas a Nixx Muellepiñón de Gadgetzan.‡Apporter 20 Grandes bombes en fer, 20 Dynamites solides et 5 Moutons explosifs à Nixx Elastirouage dans Gadgetzan.‡将20颗重磅铁制炸弹、20颗实心炸弹和5只自爆绵羊交给加基森的尼克斯·斯普克斯宾。‡將20顆重磅鐵製爆裂物、20顆實心火藥和5隻自爆綿羊交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3640] = {
  {
    '‡Договор о неразглашении‡Der Schwur der Geheimhaltung‡‡La promesa del secreto‡La promesa del secreto‡Le Vœu du secret‡保密协议‡',
    nil,
    '‡Щелкните правой кнопкой мыши по Договору о неразглашении и еще раз обратитесь к мехмастеру Замыкальцу в Стальгорне.‡Wenn Ihr ein Gnomeningenieur werden wollt, dann müsst Ihr auf den Schwur der Geheimhaltung rechtsklicken und erneut mit Tüftlermeister Oberfunks in Eisenschmiede sprechen.‡‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con el maestro manitas Sobrechispa en Forjaz.‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con el maestro manitas Sobrechispa en Forjaz.‡Pour devenir un Ingénieur gnome, cliquer avec le bouton droit sur le Vœu de secret et retourner voir une fois encore le maître-artisan Suprétincelle, à Forgefer.‡如果你同意成为一名侏儒技师，就右键点击保密协议，然后再次和铁炉堡的工匠大师欧沃斯巴克谈一谈。‡',
  }
},
[3641] = {
  {
    'Mostre serviço‡Покажи свою работу‡Zeigt Eure Arbeit‡직접 만든 물건‡Muestra tu trabajo‡Muestra tu trabajo‡Montrez votre travail‡工作成果‡工作成果',
    nil,
    'Entregue 6 Tubos de Mithril, uma Mira de Precisão e 2 Bonecos-alvo Avançados para o Mestre-faz-tudo Superchispa, em Altaforja.‡Принесите 6 мифриловых трубок, точный прицел и 2 усовершенствованных манекена-мишени мехмастеру Замыкальцу в Стальгорн.‡Bringt 6 Mithrilrohre, 1 genaues Zielfernrohr und 2 hochentwickelte Zielattrappen zu Tüftlermeister Oberfunks in Eisenschmiede.‡아이언포지에 있는 수석땜장이 오버스파크에게 미스릴관 6개, 정밀한 조준경 1개, 고급 표적 허수아비 2개를 가져가야 합니다.‡Lleva 6 tubos de mitril, una mira de precisión y 2 muñecos-diana avanzados al maestro manitas Sobrechispa a Forjaz.‡Lleva 6 tubos de mitril, una mira de precisión y 2 muñecos-diana avanzados al maestro manitas Sobrechispa a Forjaz.‡Apportez 6 Tubes en mithril, 1 Lunette de précision et 2 Leurres perfectionnés au Maître-bricoleur Suprétincelle, à Forgefer.‡将6根秘银管、1只精确瞄准镜和2个高级假人交给铁炉堡的工匠大师欧沃斯巴克。‡將6根秘銀管、1個精確瞄準鏡和2個高級假人交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3642] = {
  {
    '‡Договор о неразглашении‡Der Schwur der Geheimhaltung‡‡La promesa del secreto‡La promesa del secreto‡Le Vœu du secret‡保密协议‡',
    nil,
    '‡Если вы согласны заниматься гномским инженерным делом, щелкните правой кнопкой мыши по Договору о неразглашении и еще раз обратитесь к Карлсу Пропеллерзу в Пиратской Бухте.‡Wenn Ihr ein Gnomeningenieur werden wollt, dann müsst Ihr auf den Schwur der Geheimhaltung rechtsklicken und erneut mit Glotz Widrikus in Beutebucht sprechen.‡‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Oglethrope Obnoticus en Bahía del Botín.‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Oglethrope Obnoticus en Bahía del Botín.‡Pour devenir un Ingénieur gnome, cliquer avec le bouton droit sur le Vœu de secret et retourner voir une fois encore Oglethrope Odipnoticus à Baie-du-Butin.‡如果你同意成为一名侏儒技师，就右键点击保密协议，然后再次和藏宝海湾的奥格索普·奥布诺提斯谈一谈。‡',
  }
},
[3643] = {
  {
    'Mostre serviço‡Покажи свою работу‡Zeigt Eure Arbeit‡직접 만든 물건‡Muestra tu trabajo‡Muestra tu trabajo‡Montrez votre travail‡工作成果‡工作成果',
    nil,
    'Leve 6 Tubos de Mithril, uma Mira de Precisão e 2 Bonecos-alvo Avançados a Olhatorto Obnótico, na Angra do Butim.‡Принесите 6 мифриловых трубок, точный прицел и 2 усовершенствованных манекена-мишени Карлсу Пропеллерзу в Пиратскую Бухту.‡Bringt 6 Mithrilrohre, 1 genaues Zielfernrohr und 2 hochentwickelte Zielattrappen zu Glotz Widrikus in Beutebucht.‡무법항에 있는 오글소프 오브노티쿠스에게 미스릴관 6개, 정밀한 조준경 1개, 고급 표적 허수아비 2개를 가져가야 합니다.‡Lleva 6 tubos de mitril, 1 mira de precisión y 2 muñecos-diana avanzados a Oglethorpe Obnoticus en la Bahía del Botín.‡Lleva 6 tubos de mitril, 1 mira de precisión y 2 muñecos-diana avanzados a Oglethorpe Obnoticus en la Bahía del Botín.‡Apportez 6 Tubes en mithril, 1 Lunette de précision et 2 Leurres perfectionnés à Orguignard Odipnoticus à Baie-du-Butin.‡将6根秘银管、1只精确瞄准镜和2个高级假人交给藏宝海湾的奥格索普·奥布诺提斯。‡將6根秘銀管、1個精確瞄準鏡和2個高級假人交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[3644] = {
  {
    '‡Продление членского билета‡Mitgliedskarten-Erneuerung‡‡Renovación de la tarjeta de miembro‡Renovación de la tarjeta de miembro‡Le renouvellement de la Carte de membre‡会员卡续费‡',
