[13828] = {
  {
    'Proficiência do combate corpo a corpo‡Мастер ближнего боя‡Den Nahkampf beherrschen‡근접 공격 완전 정복‡Dominio del combate cuerpo a cuerpo‡Dominio del combate cuerpo a cuerpo‡La maîtrise de la mêlée‡近战训练‡精通近戰',
    nil,
    'Equipe-se com uma lança e monte o Corcel Quel\'dorei Abrigado do lado de fora do pavilhão. Fale com Jeran Madeiro, use Estocada 5 vezes em um Alvo Corpo a Corpo e depois fale novamente com o Arcanista Taelis nos Campos do Torneio Argênteo.‡Вооружитесь копьем и оседлайте кель\'дорайского скакуна – он ждет вас снаружи павильона. Поговорите с Джераном Локвудом и отработайте прием "Выпад" 5 раз на манекене для ближнего боя. После этого вернитесь к чародею Таэлису в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf das abgestellte Streitross der Quel\'dorei außerhalb des Pavillons. Sprecht mit Jeran Waldesruh und wendet 5 Mal die Fähigkeit \'Zustoßen\' gegen ein Nahkampfziel an. Kehrt anschließend zu Arkanist Taelis beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 쿠엘도레이 군마에 올라타십시오. 제란 록우드와 이야기를 나누고 근접 표적에 찌르기를 5번 사용한 다음 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 가야 합니다.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver al arcanista Taelis en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver al arcanista Taelis en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Palefroi quel\'dorei à l\'écurie qui se trouve devant le pavillon. Parlez à Jeran Boisclos et utilisez 5 fois le Coup de lance sur une Cible de mêlée. Puis retournez voir l’Arcaniste Taelis dans l’Enceinte du tournoi d’Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的奎尔多雷战马。和耶兰·洛克伍德谈一谈，然后对一个近战目标使用5次刺击。完成训练后回到银色比武场，向奥术师泰利斯复命。‡裝備你的長槍，騎上亭閣外的奎爾多雷戰駒。跟傑倫‧鎖木談談並以戳刺擊中近戰標靶5次，然後回去找銀白聯賽場地的秘法師泰利斯那。',
  }
},
[13829] = {
  {
    'Proficiência de combate corpo a corpo‡Мастер ближнего боя‡Den Nahkampf beherrschen‡근접 공격 완전 정복‡Dominio del combate cuerpo a cuerpo‡Dominio del combate cuerpo a cuerpo‡La maîtrise de la mêlée‡近战训练‡精通近戰',
    nil,
    'Equipe-se com uma lança e monte o Falcostruz dos Fendessol Abrigado do lado de fora do pavilhão. Fale com Jeran Madeiro, use Estocada 5 vezes em um Alvo Corpo a Corpo e depois fale novamente com o Magíster Edien Solinane nos Campos do Torneio Argênteo.‡Вооружитесь копьем и оседлайте крылобега Похитителей Солнца – он ждет вас снаружи павильона. Поговорите с Джераном Локвудом и отработайте прием "Выпад" 5 раз на манекене для ближнего боя. После этого вернитесь к магистру Эдиену Солнечной Низине в шатер Орды на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf den abgestellten Falkenschreiter der Sonnenhäscher außerhalb des Pavillons. Sprecht mit Jeran Waldesruh und wendet 5 Mal die Fähigkeit \'Zustoßen\' auf ein Nahkampfziel an. Kehrt anschließend zu Magister Edien Sonnental beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 선리버 매타조에 올라타십시오. 제란 록우드와 이야기를 나누고 근접 표적에 찌르기를 5번 사용한 다음 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 가야 합니다.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver a Edien Vacuosol en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver a Edien Vacuosol en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Faucon-pérégrin saccage-soleil à l\'écurie qui se trouve devant le pavillon. Parlez à Jeran Boisclos et utilisez 5 fois le Coup de lance sur une Cible de mêlée. Puis retournez voir le Magistère Edien Solcreuse dans l’Enceinte du tournoi d’Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的夺日者陆行鸟。和耶兰·洛克伍德谈一谈，然后对一个近战目标使用5次刺击。完成训练后回到银色比武场，向魔导师埃迪恩·炎谷复命。‡裝備你的長槍，騎上亭閣外的奪日者陸行鷹。跟傑倫·鎖木談談並以戳刺擊中近戰標靶5次，然後回去找銀白聯賽場地的博學者艾狄恩·日谷那。',
  }
},
[13830] = {
  {
    'O Peixe-espectro‡Рыба-призрак‡Der Geisterfisch‡유령물고기‡El espeztro‡El espeztro‡Le poisson-fantôme‡幽灵鱼‡魅影鬼魚',
    nil,
    'Márcia Caniço, em Dalaran, quer que você desvende o mistério do Peixe-espectro Fantasma.‡Раскройте тайну рыбы-призрака по просьбе Марсии Чейз из Даларана.‡Marcia Balzer in Dalaran möchte, dass Ihr hinter das Geheimnis des Phantomgeisterfischs kommt.‡달라란에 있는 마르시아 체이스가 허깨비 유령물고기의 비밀을 알아내 달라고 했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que descubras el misterio del espeztro.‡Marcia Sedal en Ciudad de Dalaran quiere que descubras el misterio del espeztro.‡Marcia Chase, à Dalaran, veut que vous découvriez le mystère du Poisson-fantôme spectral.‡达拉然城中的玛西娅·切斯希望你去揭开幽灵鱼的秘密。‡達拉然的瑪西亞·切斯要你揭開魅影鬼魚的秘密。',
  }
},
[13831] = {
  {
    'Uma prescrição problemática‡Странное предписание‡Besorgniserregende Rezepte‡위험한 독극물‡Una receta perturbadora‡Una receta perturbadora‡Une troublante prescription‡令人不安的处方‡令人擔憂的處方',
    nil,
    'Leve as Anotações do Boticário a Tharnariun Tratárvore em Lor\'danel.‡Доставьте записи аптекаря Тарнариуну Исцелителю Деревьев в Лор\'данел.‡Bringt die Notizen des Apothekers zu Tharnariun Baumwahrer in Lor\'danel.‡로르다넬에 있는 타나리운 트리텐더에게 연금술사의 일지를 전달해야 합니다.‡Lleva las notas del apotecario a Tharnariun Espinarbolado, en Lor\'danel.‡Lleva las notas del apotecario a Tharnariun Espinarbolado, en Lor\'danel.‡Remettez les Notes de l’apothicaire à Tharnariun Soigneflore à Lor’danel.‡将药剂师的记事笺交给洛达内尔的萨纳瑞恩·绿树。‡將藥劑師的筆記帶去洛丹諾給薩納瑞恩·綠樹。',
  }
},
[13832] = {
  {
    'Joia dos esgotos‡Звезда сточных вод‡Perle der Kanalisation‡하수도의 보석‡Joya de las cloacas‡Joya de las cloacas‡Le joyau des égouts‡下水道中的珍宝‡下水道的珠寶',
    nil,
    'Márcia Caniço, em Dalaran, quer que você lhe traga uma Joia Corroída.‡Принесите Марсии Чейз в Даларан ржавое украшение.‡Marcia Balzer in Dalaran möchte, dass Ihr ihr korrodierten Schmuck bringt.‡달라란에 있는 마르시아 체이스가 녹슨 장신구를 가져다 달라고 했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas una joya corroída.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas una joya corroída.‡Marcia Chase, à Dalaran, veut que vous lui apportiez un Bijou corrodé.‡将一块被腐蚀的珠宝交给达拉然城中的玛西娅·切斯。‡達拉然的瑪西亞‧切斯要你帶給她一塊被腐蝕的首飾。',
  }
},
[13833] = {
  {
    'O sangue é forte‡Густая кровь‡Blut ist dicker‡피는 진하다‡La sangre es más espesa‡La sangre es más espesa‡Le sang est plus épais que l\'eau‡血腥的美食‡血濃於水',
    nil,
    'Márcia Caniço, em Dalaran, quer que você lhe traga 5 Farnesins-dente-sangrento.‡Принесите Марсии Чейз в Даларан 5 ужрей-кровопийц.‡Marcia Balzer in Dalaran möchte, dass Ihr ihr 5 Blutzahnfrenzys bringt.‡달라란에 있는 마르시아 체이스가 핏빛이빨 광포어 5마리를 잡아다 달라고 했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 5 peces furia sangradientes.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 5 peces furia sangradientes.‡Marcia Chase, à Dalaran, veut que vous lui apportiez 5 Furies dents-sanglantes.‡将5条恐怖鱼交给达拉然城中的玛西娅·切斯。‡達拉然的瑪西亞‧切斯要你帶給她5尾血牙狂魚。',
  }
},
[13834] = {
  {
    'Delicioso e letal‡Опасный деликатес‡Gefährlich köstlich‡겁나게 맛있는‡Peligrosamente delicioso‡Peligrosamente delicioso‡Dangereusement délicieux...‡危险的美食‡危險的美味',
    nil,
    'Márcia Caniço, em Dalaran, quer que você lhe traga 10 Deimopeixes.‡Принесите Марсии Чейз в Даларан 10 террорелей.‡Marcia Balzer in Dalaran möchte, dass Ihr ihr 10 Schreckensfische bringt.‡달라란에 있는 마르시아 체이스가 공포물고기 10마리를 잡아다 달라고 했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 10 peces de terror.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 10 peces de terror.‡Marcia Chase, à Dalaran, veut que vous lui apportiez 10 Terrochets.‡将10条恐怖鱼交给达拉然城中的玛西娅·切斯。‡達拉然的瑪西亞‧切斯要你帶給她10尾駭魚。',
  }
},
[13835] = {
  {
    'Proficiência em quebra-escudo‡Мастер дальнего боя‡Den Schildbrecherangriff beherrschen‡방패 부수기의 대가‡Dominio de Romper escudo‡Dominio de Romper escudo‡La maîtrise du brise-bouclier‡碎盾训练‡精通破盾',
    nil,
    'Equipe-se com uma lança e monte o Corcel Quel\'dorei Abrigado do lado de fora do pavilhão. Fale com Valis Buscavento, use Quebra-escudo em 2 Alvos à Distância vulneráveis e depois fale novamente com a Batedora Shalíndria nos Campos do Torneio Argênteo.‡Вооружитесь копьем и оседлайте кель\'дорайского скакуна – он ждет вас снаружи павильона. Поговорите с Валисом Ловцом Ветра и отработайте "Удар по щиту" 2 раза на мишени для дальнего боя. После этого вернитесь к разведчице Шалиндрии на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf das abgestellte Streitross der Quel\'dorei außerhalb des Pavillons. Sprecht mit Valis Windhetzer und wendet die Fähigkeit "Schildbrecher" gegen 2 ungeschützte Distanzziele an. Kehrt anschließend zu Späherin Shalyndria beim Argentumturnierplatz zurück.‡창을 장착하고 막사 밖에 있는 길들인 쿠엘도레이 군마에 올라타십시오. 발리스 윈드체이서와 대화하고, 약해진 원거리 표적 2개에 방패 부수기를 사용한 다음 은빛십자군 마상시합 광장에 있는 정찰병 샬린드리아에게 가야 합니다.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.‡Équipez votre lance et montez le Palefroi quel\'dorei à l\'écurie qui se trouve devant le pavillon. Parlez à Valis Chassevent et utilisez le Brise-bouclier sur 2 Cibles à distance vulnérables. Puis retournez voir l’Éclaireur Shalyndria dans l’Enceinte du tournoi d’Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的奎尔多雷战马。和瓦利斯·逐风者谈一谈，然后对两个脆弱的远程目标使用碎盾技能。完成训练后回到银色比武场，向斥候沙琳蒂亚复命。‡裝備你的長槍，騎上亭閣外的奎爾多雷戰駒。跟瓦利斯‧逐風者談談並且對2個脆弱的遠程標靶使用破盾，然後回去找銀白聯賽場地的斥候夏琳卓雅。',
  }
},
[13836] = {
  {
    'Situação desembraçosa!‡Обезручен!‡Arm dran, Arm ab!‡별난 낚시‡¡Desbrazado!‡¡Desbrazado!‡Les bras lui en tombent‡胳膊丢了！‡少了隻胳膊!',
    nil,
    'Olissarra, a Bondosa, em Dalaran, quer que você lhe traga o Braço decepado.‡Принесите откушенную руку Олисарре Доброй в Даларан.‡Olisarra die Gütige in Dalaran möchte, dass Ihr ihr den abgetrennten Arm bringt.‡달라란에 있는 친절한 올리사라가 뜯어진 장갑을 가져다 달라고 했습니다.‡Olisarra la Amable, en Ciudad de Dalaran, quiere que le traigas el brazo arrancado.‡Olisarra la Amable, en Ciudad de Dalaran, quiere que le traigas el brazo arrancado.‡Olisarra la Charitable, à Dalaran, veut que vous lui rapportiez le Bras coupé.‡将断臂交给达拉然城中的善良的欧莉萨拉。‡達拉然的仁慈的歐莉珊拉要你把斷裂的手臂帶給她。',
  }
},
[13837] = {
  {
    'Maestria da investida‡Мастер стремительной атаки‡Den Ansturmangriff beherrschen‡돌진 완전 정복‡Dominio de Cargar‡Dominio de Cargar‡La maîtrise de la charge‡冲锋训练‡精通衝鋒',
    nil,
    'Equipe-se com uma lança e monte o Corcel Quel\'dorei Abrigado do lado de fora do pavilhão. Fale com Rugan Açobucho, use Investida em 2 Alvos de Investida vulneráveis e depois fale novamente com Avareth Ligérion nos Campos do Torneio Argênteo.‡Вооружитесь копьем и оседлайте кель\'дорайского скакуна – он ждет вас снаружи павильона. Поговорите с Раганом Сталебрюхом и отработайте "Рывок" 2 раза на манекене для стремительной атаки. После этого вернитесь к Аварету Молниеносному Удару в шатер Альянса на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf das abgestellte Streitross der Quel\'dorei außerhalb des Pavillons. Sprecht mit Rugan Stahlbauch und wendet die Fähigkeit \'Sturmangriff\' gegen 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Avareth Flinkstoß beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 쿠엘도레이 군마에 올라타십시오. 루간 스틸벨리와 이야기를 나누고, 약해진 돌진 표적에 돌진을 2번 사용한 다음 은빛십자군 마상시합 광장에 있는 아바레스 스위프트스트라이크에게 가야 합니다.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Avareth Golpeveloz en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Avareth Golpeveloz en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Palefroi quel\'dorei à l\'écurie qui se trouve devant le pavillon. Parlez à Rugan Ventracier et Chargez 2 Cibles de charge vulnérables, puis retournez voir Avareth Frappe-rapide dans l’Enceinte du tournoi d’Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的奎尔多雷战马。和卢格安·钢胃谈一谈，然后向两个脆弱的冲锋目标发动冲锋。完成训练后回到银色比武场，向阿瓦雷斯·迅击复命。‡裝備你的長槍，然後在亭閣外的獸欄騎上圈養的奎爾多雷戰駒。去和魯根·鋼腹談談，並且衝撞2個脆弱的衝鋒標靶，然後回來找銀白聯賽場地的阿凡瑞斯·迅擊報告。',
  }
},
[13838] = {
  {
    'Proficiência da perícia Quebra-escudo‡Мастер дальнего боя‡Den Schildbrecherangriff beherrschen‡방패 부수기의 대가‡Dominio de Romper escudo‡Dominio de Romper escudo‡La maîtrise du brise-bouclier‡碎盾训练‡精通破盾',
    nil,
    'Equipe-se com uma lança e monte o Falcostruz dos Fendessol Abrigado do lado de fora do pavilhão. Fale com Valis Buscavento, use Quebra-escudo em 2 Alvos à Distância vulneráveis e depois fale novamente com Galátia Brilhalvo nos Campos do Torneio Argênteo.‡Вооружитесь копьем и оседлайте крылобега Похитителей Солнца – он ждет вас снаружи павильона. Поговорите с Валисом Ловцом Ветра и 2 раза отработайте "Удар по щиту" на мишени для дальнего боя. После этого вернитесь к Галатии Сияющий Рассвет в шатер Орды на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf den abgestellten Falkenschreiter der Sonnenhäscher. Sprecht mit Valis Windhetzer und wendet die Fähigkeit \'Schildbrecher\' gegen 2 ungeschützte Distanzziele an. Kehrt anschließend zu Galathia Morgenglanz beim Argentumturnierplatz zurück.‡창을 장착하고 막사 밖에 있는 길들인 선리버 매타조에 올라타십시오. 발리스 윈드체이서와 대화하고 약해진 원거리 표적 2개에 방패 부수기를 사용한 다음 은빛십자군 마상시합 광장에 있는 갈라시아 브라이트돈에게 가야 합니다.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Faucon-pérégrin saccage-soleil à l\'écurie. Parlez à Valis Chassevent et utilisez le Brise-bouclier sur 2 Cibles à distance vulnérables, puis retournez voir Galathia Brillaube dans l’Enceinte du tournoi d’Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的夺日者陆行鸟。和瓦利斯·逐风者谈一谈，然后对两个脆弱的远程目标使用碎盾技能。完成训练后回到银色比武场，向加拉希亚·晨光复命。‡裝備你的長槍，然後在亭閣外的獸欄騎上圈養的奪日者陸行鷹。去和瓦利斯·逐風者談談，並且衝撞2個脆弱的衝鋒標靶，然後回後找銀白聯賽場地的加拉西雅·明曦報告。',
  }
},
[13839] = {
  {
    'Maestria da Investida‡Мастер стремительной атаки‡Den Ansturmangriff beherrschen‡돌진 완전 정복‡Dominio de Cargar‡Dominio de Cargar‡La maîtrise de la charge‡冲锋训练‡精通衝鋒',
    nil,
    'Equipe-se com uma lança e monte o Falcostruz dos Fendessol Abrigado do lado de fora do pavilhão. Fale com Rugan Açobucho, use Investida em 2 Alvos de Investida vulneráveis e depois fale novamente com Amariel Jurassolar nos Campos do Torneio Argênteo.‡Вооружитесь копьем и оседлайте крылобега Похитителей Солнца – он ждет вас снаружи павильона. Поговорите с Раганом Сталебрюхом и отработайте прием "Рывок" 2 раза на манекене для стремительной атаки. После этого вернитесь к Амариэлю Верному Солнцу в шатер Орды на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf den angebundenen Falkenschreiter der Sonnenhäscher außerhalb des Pavillons. Sprecht mit Rugan Stahlbauch und wendet die Fähigkeit \'Sturmangriff\' gegen 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Amariel Sonnenschwur beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 선리버 매타조에 올라타십시오. 루간 스틸벨리와 이야기를 나누고, 약해진 돌진 표적에 돌진을 2번 사용한 다음 은빛십자군 마상시합 광장에 있는 아마리엘 선스원에게 가야 합니다.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Amariel Jurasol en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Amariel Jurasol en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Faucon-pérégrin saccage-soleil à l\'écurie qui se trouve devant le pavillon. Parlez à Rugan Ventracier et Chargez 2 Cibles de charge vulnérables, puis retournez voir Amariel Ligesol dans l’Enceinte du tournoi d’Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的夺日者陆行鸟。和卢格安·钢胃谈一谈，然后向两个脆弱的冲锋目标发动冲锋。完成训练后回到银色比武场，向阿玛里尔·火盟复命。‡裝備你的長槍，然後在亭閣外的獸欄騎上圈養的奪日者陸行鷹。去和魯根·鋼腹談談，並且衝撞2個脆弱的衝鋒標靶，然後回後找銀白聯賽場地的艾瑪瑞爾·日誓報告。',
  }
},
[13840] = {
  {
    'REUSE‡ПОВТОРНОЕ ИСПОЛЬЗОВАНИЕ‡REUSE‡미사용‡REUSE‡REUSE‡RÉUTILISER‡REUSE‡重複使用',
    nil,
    'Find some Special Chicken Feed and return to your befriended chicken. When you find it, /cheer at it before trying to give it the Special Chicken Feed.‡Найдите цыплячий корм и вернитесь к загадочной курице. Когда найдете курицу, покажите ей, как вы рады ее видеть (эмоция "/рад"), а потом накормите специальным цыплячьим кормом.‡Beschafft Euch etwas Spezialhühnerfutter und kehrt zu dem Huhn zurück, das sich mit Euch angefreundet hat. Wenn Ihr es gefunden habt, dann benutzt erst /cheer, ehe Ihr dem Huhn das Spezialhühnerfutter gebt.‡Find some Special Chicken Feed and return to your befriended chicken. When you find it, /cheer at it before trying to give it the Special Chicken Feed.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Trouver de la Nourriture spéciale pour poulet et l\'apporter à la poule que vous voulez aider. Lorsque vous l\'aurez trouvée, encouragez-la (/acclame) avant d\'essayer de lui donner la Nourriture spéciale pour poulet.‡Find some Special Chicken Feed and return to your befriended chicken. When you find it, /cheer at it before trying to give it the Special Chicken Feed.‡找一些特殊的雞飼料，把它交給友好的小雞。當你找到小雞的時候，在餵食它特殊的雞飼料之前對它做出拍動翅膀的表情。(使用/cheer 命令)',
  }
},
[13841] = {
  {
    'Pedindo desculpas‡Искренние извинения‡Entschuldigungsschreiben für Höllschrei‡사과‡Disculpas‡Disculpas‡Toutes mes confuses‡难辞其咎‡負荊請罪',
    nil,
    'Draaka quer que você leve a carta de explicação dela para Garrosh Grito Infernal em Orgrimmar.‡Драака просит вас передать Гаррошу Адскому Крику объяснительную записку.‡Draaka will, dass Ihr den Brief der Erklärung an Garrosh Höllschrei in Orgrimmar überbringt.‡드라카가 설명이 담긴 편지를 오그리마에 있는 가로쉬 헬스크림에게 전해달라고 했습니다.‡Draaka quiere que lleves su carta de explicaciones a Garrosh Grito Infernal en Orgrimmar.‡Draaka quiere que lleves su carta de explicaciones a Garrosh Grito Infernal en Orgrimmar.‡Draaka vous demande d’apporter sa Lettre d’explication à Garrosh Hurlenfer, à Orgrimmar.‡德娜卡要你把她的解释信交给奥格瑞玛的加尔鲁什·地狱咆哮。‡德拉卡要你帶著她的解釋信函到奧格瑪給卡爾洛斯·地獄吼。',
  }
},
[13842] = {
  {
    'Por um punhado de fogovil‡Искупление‡Der Tod steht ihm gut‡대족장의 용서‡Cabeza de redención‡Cabeza de redención‡Prenez-lui la tête !‡将功赎罪‡用恐怖的腦袋贖罪',
    nil,
    'Fale com Durak na Mina Machadada.‡Поговорите с Дураном в шахте Расщепленного Дерева.‡Sprecht mit Durak in den Splitterholzminen.‡토막나무 광산에 있는 듀락과 대화해야 합니다.‡Habla con Durak en Mina del Hachazo.‡Habla con Durak en Mina del Hachazo.‡Parlez à Durak à la Mine de Bois-Brisé.‡跟碎木矿井的杜莱克谈一谈。‡到碎木礦坑去與杜雷克交談。',
  }
},
[13843] = {
  {
    '‡Комплект для сборки Хламобота‡Das Konstruktionsset: Schrottbot‡‡El equipo de construcción de robot chatarra‡El equipo de construcción de robot chatarra‡Le kit de construction de robot-ferrailleur‡废物贩卖机器人制造器‡廢料機器人組裝包',
    nil,
    '‡Изучите данные панели управления прототипом в библиотеке Изобретателя.‡Benutzt die Prototypenkonsole in der Bibliothek des Erfinders.‡발명가의 도서관에 있는 모형 조작대를 작동시켜야 합니다.‡Interactúa con la consola prototipo en la Biblioteca del Inventor.‡Interactúa con la consola prototipo en la Biblioteca del Inventor.‡Utilisez la Console prototype à la Bibliothèque de l\'inventeur.‡使用创世者的图书馆中的原型机控制台。‡在發明者圖書館中與原型控制臺互動。',
  }
},
[13844] = {
  {
    'O saque de Althalaxx‡Сокровища Алталакса‡Althalaxx plündern‡알살락스의 폐허를 노리는 손‡El saqueo de Althalaxx‡El saqueo de Althalaxx‡Le pillage d\'Althalaxx‡奥萨拉克斯的藏宝‡奧薩拉克斯的戰利品',
    nil,
    'Encontre o Tomo de Nassarin em meio às ruínas de Althalaxx e mate o comandante Renegado Tírio Paçagrado.‡Найдите фолиант Нарассина среди руин Алталакса и убейте предводителя Отрекшихся Тигана Холловея.‡Findet Narassins Foliant in den Ruinen von Althalaxx und tötet Teegan Holloway, den Kommandanten der Verlassenen.‡알살락스의 폐허에서 나라신의 고서를 찾은 다음, 포세이큰 지휘관인 티간 홀로웨이를 처치해야 합니다.‡Localiza el escrito de Narassin entre las ruinas de Althalaxx y mata al comandante Renegado Teegan Holloway.‡Localiza el escrito de Narassin entre las ruinas de Althalaxx y mata al comandante Renegado Teegan Holloway.‡Trouvez le Tome de Narassin parmi les Ruines d\'Althalaxx et tuez le commandant réprouvé Teegan Holloway.‡在奥萨拉克斯之塔废墟里找到纳拉辛的学识之书，并杀掉被遗忘者指挥官提甘·霍拉维。‡在奧薩拉克斯的廢墟間找出納拉辛之書並殺死被遺忘者指揮官提根‧谷道。',
  }
},
[13845] = {
  {
    'Ampola lacrada de veneno‡Запечатанный фиал с ядом‡Versiegelte Giftphiole‡봉인된 독약병‡Vial de veneno sellado‡Vial de veneno sellado‡Une fiole de poison scellée‡密封的毒药瓶‡密封的毒藥瓶',
    nil,
    'Entregue a Ampola Lacrada de Veneno para o Alquimista Cinestra nos Esgotos de Dalaran.‡Принесите запечатанный фиал с ядом алхимику Синесре в Стоки Даларана.‡Bringt die versiegelte Giftphiole zu Alchemist Cinesra in die Kanalisation von Dalaran.‡달라란 하수도에 있는 연금술사 시네스라에게 봉인된 독약병을 가져가야 합니다.‡Llévale el vial de veneno sellado al alquimista Cinesra en las Cloacas de Dalaran.‡Llévale el vial de veneno sellado al alquimista Cinesra en las Cloacas de Dalaran.‡Apportez la Fiole de poison scellée à l’Alchimiste Cinesra, dans les Égouts de Dalaran.‡将密封的毒药瓶交给达拉然下水道的炼金师辛奈斯拉。‡把這個密封的毒藥瓶交給達拉然下水道的鍊金師席尼斯拉。',
  }
},
[13846] = {
  {
    'Contribuindo para a causa‡Вклад в общее дело‡Einen Beitrag leisten‡대의에 기부하라‡Contribuir a la causa‡Contribuir a la causa‡Un don pour la cause‡微薄的贡献‡為理念捐款',
    nil,
    'Fale com o Escudeiro Arturzinho para contribuir com 10 moedas de ouro à causa da Cruzada Argêntea.‡Поговорите с оруженосцем Арти и пожертвуйте 10 золотых на нужды Серебряного Авангарда.‡Sprecht mit Knappe Artie, um einen Beitrag von 10 Gold an den Argentumkreuzzug zu leisten.‡종자 아티와 대화하여 은빛십자군의 대의를 위해 10골드를 기부해야 합니다.‡Habla con el escudero Artie para donar 10 oros a la causa de la Cruzada Argenta.‡Habla con el escudero Artie para donar 10 oros a la causa de la Cruzada Argenta.‡Parlez à l\'Ecuyer Artie pour faire un don de 10 pièces d\'or à la cause de la Croisade d\'Argent.‡与侍从亚迪再次交谈，为银色北伐军的事业捐献10枚金币。‡和侍從亞緹談談並為銀白十字軍的理念捐贈10金。',
  }
},
[13847] = {
  {
    'Nos portões inimigos‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    'O Capitão Josué Rolém, nos Campos do Torneio Argênteo, quer que você mate 15 Soldados Rasos da Ossaguarda, 10 Batedores da Ossaguarda e 3 Tenentes da Ossaguarda.‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию капитана Джозефа Холли из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Hauptmann Joseph Holley beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 대장 조셉 홀리가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡El capitán Joseph Holley en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡El capitán Joseph Holley en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Capitaine Joseph Holley, dans l’enceinte du tournoi d’Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的约瑟夫·霍雷上尉要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡銀白聯賽場地的約瑟夫‧霍雷上尉要你去殺掉15個骨衛步卒、10個骨衛斥候以及3個骨衛中尉。',
  }
},
[13848] = {
  {
    'Mensageiro das más notícias‡Плохие новости‡Überbringer schlechter Nachrichten‡좋지 않은 소식‡Malas noticias‡Malas noticias‡Un oiseau de mauvais augure‡凶讯使者‡捎來壞消息的人',
    nil,
    'Kadrak quer que você fale com o Comandante Presatroz na Praia de Zoram.‡Кадрак просит вас поговорить с командиром Мрачный Клык на Зорамском взморье.‡Kadrak will, dass Ihr mit Kommandant Grimmfang am Zoramstrand sprecht.‡카드라크가 조람 해안에 있는 사령관 그림팽과 대화해 달라고 했습니다.‡Kadrak quiere que hables con el comandante Colminiestro en la Ensenada de Zoram.‡Kadrak quiere que hables con el comandante Colminiestro en la Ensenada de Zoram.‡Kadrak vous a demandé d’aller parler au Commandant Croc-sinistre, sur la Grève de Zoram.‡卡德拉克要你去跟佐拉姆海岸的指挥官恐牙谈一谈。‡卡德拉克要你去佐拉姆海岸與指揮官厲牙談話。',
  }
},
[13849] = {
  {
    'Astranaar em chamas!‡Астранаар в огне!‡Astranaar brennt!‡아스트라나르가 불타오른다!‡¡Astranaar en llamas!‡¡Astranaar en llamas!‡Astranaar brûle !‡阿斯特兰纳在燃烧！‡阿斯特蘭納正在燃燒',
    nil,
    'Apague 15 focos de incêndio.‡Потушите 15 пожаров.‡Löscht 15 Feuer.‡불이 난 곳 15곳을 진압해야 합니다.‡Extingue 15 fuegos.‡Extingue 15 fuegos.‡Éteignez 15 feux.‡扑灭15处大火。‡熄滅15處火勢。',
  }
},
[13850] = {
  {
    'Tolerância tóxica‡Иммунитет к яду‡Gifttoleranz‡독에 대한 내성‡Tolerancia tóxica‡Tolerancia tóxica‡Mithridatisation‡毒药的免疫力‡抗禦毒性',
    nil,
    'Mor\'vek, na Cratera Un\'Goro, disse que se você ficar coberto com o sangue dos Ravassauros Pelenosos 20 vezes, poderá montar um deles sem morrer. Para ter uma chance de ficar envenenado, basta atacar um Ravassauro Pelenoso.‡Мор\'век из Кратера Ун\'Горо утверждает, что вам необходимо 20 раз отравиться кровью ядошкурого равазавра, чтобы выработать иммунитет к яду. Чтобы кровь равазавра попала на вашу кожу, нападите на него.‡Mor\'vek im Krater von Un\'Goro behauptet, dass wenn man 20-mal von dem Blut eines Gifthautravasauriers vergiftet wurde, auf einem reiten könnte, ohne zu sterben. Greift die Saurier an, um vielleicht vergiftet zu werden.‡운고로 분화구에 있는 모르벡이 맹독가죽 라바사우루스 피에 20번 중독되면 탔을 때 죽지 않는다고 말했습니다. 독을 맞도록 맹독가죽 라바사우루스를 공격해야 합니다.‡Según Mor\'vek en el Cráter de Un\'Goro, si te salpica la sangre envenenada de un ravasaurio Pellejo Venenoso 20 veces, podrás montar uno sin morirte. Ataca a los ravasaurios Pellejo Venenoso para que te envenenen.‡Según Mor\'vek en el Cráter de Un\'Goro, si te salpica la sangre envenenada de un ravasaurio Pellejo Venenoso 20 veces, podrás montar uno sin morirte. Ataca a los ravasaurios Pellejo Venenoso para que te envenenen.‡Mor\'vek, dans le cratère d’Un’goro, assure que si vous êtes empoisonné 20 fois par du sang de ravasaure peau-de-venin, vous pouvez en monter sans mourir. Attaquez des Ravasaures peau-de-venin pour avoir une chance d’être empoisonné.‡安戈洛环形山的莫维克说，如果你能被毒皮暴掠龙的血染上20次毒，就可以安全地骑它了。攻击毒皮魔暴龙，有一定几率会中毒。‡安戈洛環形山的莫維克聲稱如果暴露在毒皮暴掠龍的毒血之下達20次後，騎乘毒皮暴掠龍就不會被毒死。攻擊毒皮暴掠龍就有機會中毒。',
  }
},
[13851] = {
  {
    'Nos portões inimigos‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    'Clara Rolacerva, nos Campos do Torneio Argênteo, quer que você mate 15 Soldados Rasos da Ossaguarda, 10 Batedores da Ossaguarda e 3 Tenentes da Ossaguarda.‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Клары Взубногой из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Clara Torkelbräu beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 클라라 텀블브루가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Clara Vueltabirra en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Clara Vueltabirra en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Clara Voltebière, dans l’enceinte du tournoi d’Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的克拉拉·沸酒要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡銀白聯賽場地的卡拉菈‧跌酒要你去殺掉15個骨衛步卒、10個骨衛斥候以及3個骨衛中尉。',
  }
},
[13852] = {
  {
    'Nos portões inimigos‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    'Fliquim Chavefenda, nos Campos do Torneio Argênteo, quer que você mate 15 Soldados Rasos da Ossaguarda, 10 Batedores da Ossaguarda e 3 Tenentes da Ossaguarda.‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Фликля Гайковерта из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Klick Radspanner beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 플리킨 기어스패너가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Flickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Flickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Krante Clépharnaüm, dans l’enceinte du tournoi d’Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的弗林克·扳钳要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡銀白聯賽場地的佛立金‧輪扳要你去殺掉15個骨衛步卒、10個骨衛斥候以及3個骨衛中尉。',
  }
},
[13853] = {
  {
    'Só acaba quando termina‡Возвращение огня‡Das Feuer erwidern‡응사‡Devolver el fuego‡Devolver el fuego‡La riposte‡还击‡開火反擊',
    nil,
    'Use uma Arremessadora de Astranaar para abater 15 Baderneiros do Grito Infernal em suas Mantícoras de Guarda.‡Подстрелите 15 геллионов Адского Крика и их ветрокрылов-наблюдателей с помощью метателя из Астранаара.‡Verwendet eine Schleuder von Astranaar, um 15 von Höllschreis Vandalen und ihre Wachwindreiter abzuschießen.‡아스트라나르 투척기를 사용해 경비 와이번과 헬스크림의 무법자 15명을 처치해야 합니다.‡Utiliza el lanzador de Astranaar para derribar 15 heliones de Grito Infernal y sus jinetes del viento de vigilancia.‡Utiliza el lanzador de Astranaar para derribar 15 heliones de Grito Infernal y sus jinetes del viento de vigilancia.‡Utilisez un Lanceur d\'Astranaar pour abattre 15 Hellions de Hurlenfer et leurs Coursiers du vent de la garde.‡用阿斯特兰纳投刃车击落15名地狱咆哮的恶徒和他们的哨站驭风者。‡使用阿斯特蘭納投擲器射下15名地獄吼的惡徒和他們的守望雙足飛龍。',
  }
},
