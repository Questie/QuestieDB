[29605] = {
  {
    'Irmão contra irmão‡Брат на брата‡Bruder gegen Bruder‡형제 간의 싸움‡Hermano contra hermano‡Hermano contra hermano‡Frère contre frère‡兄弟反目‡兄弟鬩牆',
    nil,
    'Liberte Lakka do cativeiro. Fale novamente com Isfar nos Salões dos Sethekk quando concluir o resgate.‡Освободите из плена Лакку. После этого вернитесь к Исфару, который находится в Сетеккских залах.‡Befreit Lakka aus ihrer Gefangenschaft. Kehrt zu Isfar in den Sethekkhallen zurück, wenn Ihr die Rettung abgeschlossen habt.‡갇혀 있는 라카를 구해낸 뒤 세데크 전당 안에 있는 이스파르에게 가야 합니다.‡Libera a Lakka de su cautiverio. Vuelve con Isfar en el interior de las Salas Sethekk cuando la hayas rescatado.‡Libera a Lakka de su cautiverio. Vuelve con Isfar en el interior de las Salas Sethekk cuando la hayas rescatado.‡Libérez Lakka. Retournez voir Isfar à l’intérieur des Salles des Sethekk lorsque vous aurez réussi à la sauver.‡救出拉卡。完成任务之后，向塞泰克大厅的伊斯法尔复命。‡釋放被囚禁的拉卡。成功解救拉卡之後，回塞司克大廳找伊斯法。',
  }
},
[29606] = {
  {
    'O legado de Terokk‡Наследство Терокка‡Terokks Erbe‡테로크의 유산‡El legado de Terokk‡El legado de Terokk‡L\'héritage de Terokk‡泰罗克的传说‡泰洛克的遺物',
    nil,
    'Entregue a Máscara de Terokk e o Cálamo de Terokk para Isfar nos Salões dos Sethekk.‡Принесите маску Терокка и перо Терокка Исфару, который находится в Сетеккских залах.‡Bringt Terokks Maske und Terokks Federkiel zu Isfar in den Sethekkhallen.‡테로크의 가면과 테로크의 깃창을 세데크 전당 안에 있는 이스파르에게 가져다주어야 합니다.‡Lleva la máscara y la punta de Terokk a Isfar al interior de las Salas Sethekk.‡Lleva la máscara y la punta de Terokk a Isfar al interior de las Salas Sethekk.‡Apportez le Masque de Terokk et la Rémige de Terokk à Isfar à l’intérieur des Salles des Sethekk.‡将泰罗克的面具和泰罗克的羽毛交给塞泰克大厅的伊斯法尔。‡將泰洛克面罩和泰洛克羽毛交給塞司克大廳內的伊斯法。',
  }
},
[29607] = {
  {
    'Olhos de serpente‡Глаза желания‡Augen der Begierde‡욕망의 시선‡Ojos de deseo‡Ojos de deseo‡Les yeux du désir‡欲望之眼‡慾望之眼',
    nil,
    'O Mercador Vijad, nos Salões dos Sethekk, quer que você lhe traga 3 Olhos de Cobalto.‡Делец Вийяд из Сетеккских залов хочет, чтобы вы принесли ему 3 кобальтовых глаза.‡Händler Vijaad in den Sethekkhallen möchte, dass Ihr ihm 3 Kobaltaugen bringt.‡세데크 전당 안에 있는 무역업자 비자드가 코발트 눈 3개를 가져다달라고 부탁했습니다.‡El vendedor Vijad, situado en el interior de las Salas Sethekk, quiere que le lleves 3 ojos de cobalto.‡El vendedor Vijad, situado en el interior de las Salas Sethekk, quiere que le lleves 3 ojos de cobalto.‡Le Camelot Vijaad, à l’intérieur des Salles des Sethekk, vous a demandé de lui apporter 3 Yeux de cobalt.‡塞泰克大厅的商人维嘉德要你给他带去3颗冰蓝之眼。‡塞司克大廳內的商人維傑想要你帶3個巨蛇之眼給他。',
  }
},
[29608] = {
  {
    'Aliados em Dalaran‡Союзники в Даларане‡Verbündete in Dalaran‡달라란의 아군‡Aliados en Dalaran‡Aliados en Dalaran‡Des alliés à Dalaran‡达拉然的盟友‡在達拉然的盟友',
    nil,
    'Aceite uma carona de grifo até Dalaran e fale com Isirami Belvento no Recanto dos Heróis.‡Прилетите на грифоне в Даларан и поговорите с Изирами Попутный Ветер в таверне "Благодарность за отвагу".‡Macht einen Greifenritt nach Dalaran und sprecht mit Isirami Sanftwind im Gasthaus Zum Gefeierten Helden.‡그리핀을 타고 달라란으로 이동해 영웅의 쉼터 여관에 있는 이시라미 페어윈드와 대화해야 합니다.‡Acepta el viaje en grifo a Dalaran y habla con Isirami Eolimpio en La Bienvenida de un Héroe.‡Acepta el viaje en grifo a Dalaran y habla con Isirami Eolimpio en La Bienvenida de un Héroe.‡Acceptez un vol en griffon pour Dalaran et parlez à Isirami Doucebrise à L’échoppe des Héros.‡骑着狮鹫前往达拉然，找到英雄之家的伊丝拉米·轻风并跟她对话。‡搭乘獅鷲獸至達拉然，與「英雄光臨」旅店的伊斯拉米·順風說話。',
  }
},
[29609] = {
  {
    'Amigos em Dalaran‡Друзья в Даларане‡Freunde in Dalaran‡달라란에 있는 친구‡Aliados en Dalaran‡Aliados en Dalaran‡Des amis à Dalaran‡达拉然的朋友‡在達拉然的朋友',
    nil,
    'Aceite a carona para Dalaran oferecida pelo mestre de voo e fale com Uda, a Fera, n\'O Animal Imundo.‡Летите в Даларан и поговорите с Удой Зверюгой в трактире "Грязное животное".‡Lasst Euch vom Flugmeister einen Flug nach Dalaran geben und sprecht mit Uda dem Biest im Rattenloch.‡달라란으로 가는 탈것을 타고 이동해 불결한 야수 여관에 있는 야수 우다와 대화해야 합니다.‡Acepta el viaje a Dalaran del maestro de vuelo y habla con Uda la Bestia en El Animal Roñoso.‡Acepta el viaje a Dalaran del maestro de vuelo y habla con Uda la Bestia en El Animal Roñoso.‡Acceptez un vol pour Dalaran du maître de vol et parlez à Uda la Bête à La Sale Bête.‡从飞行大师处飞往达拉然，并且与“肮脏的野兽”里的兽女乌达谈一谈。‡乘坐飛行管理員的載具至達拉然，然後和下流畜生酒店的『野獸』烏達說話。',
  }
},
[29610] = {
  {
    'Tracking Event: Primeira Chegada do Jogador‡Выслеживание: первое прибытие игрока‡Verfolgungsereignis: Erstes Eintreffen des Spielers‡이벤트 추적: 플레이어 처음 도착‡Evento de seguimiento: primera llegada del jugador‡‡Évènement de suivi : première arrivée du joueur‡追踪事件：玩家首次到达‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[29611] = {
  {
    'A arte da guerra‡Искусство войны‡Die Kunst des Krieges‡전쟁의 기술‡El arte de la guerra‡‡L’art de la guerre‡战争的艺术‡',
    nil,
    'Fale com o General Nazgrim no Castelo Grommash. Uma‡Поговорите с генералом Назгримом в крепости Громмаш.‡Sprecht mit General Nazgrim in der Feste Grommash.‡그롬마쉬 요새에 있는 장군 나즈그림과 대화해야 합니다. 레벨 10 오그리마‡Habla con el general Nazgrim en el Fuerte Grommash.‡‡Parlez au Général Nazgrim à Fort Grommash.‡和格罗玛什要塞的纳兹戈林将军谈一谈。‡',
  }
},
[29612] = {
  {
    'A arte da guerra‡Искусство войны‡Die Kunst des Krieges‡전쟁의 기술‡El arte de la guerra‡‡L’art de la guerre‡战争的艺术‡',
    nil,
    'Fale com o General Nazgrim no Castelo Grommash, que fica em Orgrimmar. Uma‡Поговорите с генералом Назгримом в крепости Громмаш в Оргриммаре.‡Sprecht mit General Nazgrim in der Feste Grommash in Orgrimmar.‡오그리마의 그롬마쉬 요새에 있는 장군 나즈그림과 대화해야 합니다. 레벨 10 오그리마‡Habla con el general Nazgrim en Fuerte Grommash, en Orgrimmar.‡‡Parlez au Général Nazgrim au Fort Grommash, à Orgrimmar.‡去奥格瑞玛的格罗玛什要塞和纳兹戈林将军谈一谈。‡',
  }
},
[29613] = {
  {
    'Um destino condizente‡Бесславный конец‡Ein gerechtes Schicksal‡마땅한 운명‡Un destino justo‡Un destino justo‡Une fin appropriée‡罪有应得‡正當的命運',
    nil,
    'Mate o Senhor da Guerra Kalithresh e fale novamente com a Vigia Jhang dentro da Câmara dos Vapores.‡Убейте полководца Калитреша и возвращайтесь к дозорной Джанг в Паровое подземелье.‡Tötet Kriegsherr Kalithresh und kehrt zu Behüterin Jhang in der Dampfkammer zurück.‡장군 칼리스레쉬를 처치하고 증기 저장고 안에 있는 감시자 쟝에게 가야 합니다.‡Mata al señor de la guerra Kalithresh y vuelve con la vigía Jhang dentro de La Cámara de Vapor.‡Mata al señor de la guerra Kalithresh y vuelve con la vigía Jhang dentro de La Cámara de Vapor.‡Tuez le Seigneur de guerre Kalithresh et retournez voir la Guetteuse Jhang à l’intérieur du Caveau de la Vapeur.‡杀死督军卡利瑟里斯，然后向蒸汽地窖内的观察者杰哈恩复命。‡殺死督軍卡利斯瑞，然後回蒸汽洞窟找看守者詹汗格。',
  }
},
[29614] = {
  {
    'Contenção de danos‡Сдерживание заразы‡Eindämmung ist der Schlüssel‡빠른 처리가 핵심‡La contención es vital‡La contención es vital‡Le confinement est la clé‡遏制是关键‡牽制才是關鍵',
    nil,
    'Mate 3 Senhores do Lodo e 6 Leprosos Presacurva e pegue uma Engrenagem Irradiada do Mecangenheiro Badulak. Em seguida, fale novamente com o Naturalista Mordida na Câmara dos Vapores.‡Убейте 3 властителя болот, 6 лепрогномов из резервуара Кривого Клыка, а также достаньте облученный механизм Анжинера Паропуска, после чего возвращайтесь к натуралисту Кусу в Паровое подземелье.‡Tötet 3 Sumpfoberanführer und 6 Aussätzige des Echsenkessels und erbeutet ein verstrahltes Zahnrad von Robogenieur Dampfhammer. Kehrt dann zu Naturalist Biss zurück.‡수렁대군주 3마리, 오염된 갈퀴송곳니 노움 6명을 처치하고 기계박사 스팀리거에게서 오염된 기어를 획득한 후, 증기 저장고에 있는 식물학자 바이트에게 가야 합니다.‡Mata a 3 señores supremos de ciénaga, 6 parias Colmillo Torcido y obtén un engranaje irradiado del mekigeniero Vaporino. Después, vuelve con el naturalista Mordisco en el interior de La Cámara de Vapor.‡Mata a 3 señores supremos de ciénaga, 6 parias Colmillo Torcido y obtén un engranaje irradiado del mekigeniero Vaporino. Después, vuelve con el naturalista Mordisco en el interior de La Cámara de Vapor.‡Tuez 3 Hauts seigneurs-tourbe, 6 Lépreux de Glisseroc et obtenez un Équipement irradié du Mekgénieur Montevapeur, puis retournez voir le Naturaliste Morsure au Caveau de la Vapeur.‡杀死3个泥沼主宰和6个盘牙麻疯者，并取得机械师斯蒂里格的被辐射过的齿轮，然后向蒸汽地窖的博学者拜特复命。‡殺死3個泥沼主宰、6個盤牙痲瘋者，然後從機電師蒸汽操控者那裡取得一個輻射裝置，然後回蒸汽洞窟找自然學家拜特。',
  }
},
[29615] = {
  {
    'O arauto dos ventos e a ladra das águas‡Призыватель ветра Коготь и водокрад‡Windrufer Klaue und die Wasserdiebin‡바람소환사 클로와 물 도둑‡El clamavientos Zarpa y el ladrón de agua‡El clamavientos Zarpa y el ladrón de agua‡L’implorateur céleste Griffe et le voleur d’eau‡唤风者克劳恩与窃水者‡喚風者卡勞與偷水賊',
    nil,
    'Mate a Hidromante Thespia e fale novamente com o Arauto do Vento Garra na Câmara dos Vapores.‡Убейте гидроманта Теспию и возвращайтесь к призывателю ветра Когтю в Паровое подземелье.‡Tötet Hydromantin Thespia und kehrt zu Windrufer Klaue in der Dampfkammer zurück.‡풍수사 세스피아를 처치하고 증기 저장고 안에 있는 바람소환사 클로에게 가야 합니다.‡Mata a la hidromántica Thespia y vuelve con el clamavientos Zarpa en La Cámara de Vapor.‡Mata a la hidromántica Thespia y vuelve con el clamavientos Zarpa en La Cámara de Vapor.‡Tuez l’Hydromancienne Thespia, puis retournez voir l’Implorateur céleste Griffe à l’intérieur du Caveau de la Vapeur.‡杀死水术师瑟丝比娅，然后向蒸汽地窖里的唤风者克劳恩复命。‡殺死海法師希斯比亞，然後回蒸汽洞窟找喚風者卡勞。',
  }
},
[29616] = {
  {
    'Captura da Câmara dos Vapores‡Штурм Парового подземелья‡Sturm auf die Dampfkammer‡증기 저장고 습격‡Irrupción en La Cámara de Vapor‡Irrupción en La Cámara de Vapor‡Assaut sur le caveau de la Vapeur‡进攻蒸汽地窖‡搶攻蒸汽洞窟',
    nil,
    'Fale com a Vigia Jhang na Câmara dos Vapores.‡Поговорите с дозорной Джанг в Паровом подземелье.‡Sprecht mit Behüterin Jhang in der Dampfkammer.‡증기 저장고에 있는 감시자 쟝과 대화해야 합니다.‡Habla con la vigía Jhang en La Cámara de Vapor.‡Habla con la vigía Jhang en La Cámara de Vapor.‡Parlez à la Guetteuse Jhang au Caveau de la Vapeur.‡和蒸汽地窖里的观察者杰哈恩谈一谈。‡和蒸汽洞窟的看守者詹汗格說話。',
  }
},
[29617] = {
  {
    'Monastério de Tian‡Монастырь Тянь‡Das Tiankloster‡티엔 수도원‡Monasterio Tian‡‡Le monastère de Tian‡天禅院‡',
    nil,
    'Fale com Lin Pata Tenra no Monastério de Tian, na Floresta de Jade. Uma‡Поговорите с Линь Мягкой Лапой, которая находится в монастыре Тянь в Нефритовом лесу.‡Sprecht mit Lin Zartpfote im Tiankloster im Jadewald.‡비취 숲의 티엔 수도원에 있는 린 텐더포우와 대화해야 합니다. 레벨 10 비취 숲‡Habla con Lin Zarpa Blanda en el Monasterio Tian, en El Bosque de Jade.‡‡Parlez à Lin Patte de Velours au Monastère de Tian, dans la Forêt de Jade.‡在翡翠林的天禅院和林·柔掌交谈。‡',
  }
},
[29618] = {
  {
    'O Sumo Ancião‡Верховный старейшина‡Der Hohe Älteste‡대장로‡El gran ancestro‡‡Le grand ancien‡拜会长老‡',
    nil,
    'Fale com o Sumo Ancião Nuvem Branda no Monastério de Tian, que fica na Floresta de Jade. Uma‡Поговорите с верховным старейшиной Дождевой Тучей в монастыре Тянь в Нефритовом лесу.‡Sprecht mit dem Hohen Ältesten Wolkensturz im Tiankloster im Jadewald.‡비취 숲의 티엔 수도원에 있는 대장로 클라우드폴과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el gran ancestro Otoño Nublo en el Monasterio Tian, en El Bosque de Jade.‡‡Parlez au Grand ancien Chute des Nuages au Monastère de Tian, dans la Forêt de Jade.‡和翡翠林里天禅院的云瀑长老谈一谈。‡',
  }
},
[29619] = {
  {
    'Cortesia de visitante‡Учтивый гость‡Ein höflicher Gast‡예의 바른 손님‡Un invitado cortés‡‡Un invité courtois‡谦谦来客‡',
    nil,
    'Colha 8 Laranjas Maduras dos pomares de laranja a sul do Monastério de Tian. Uma‡Соберите 8 спелых апельсинов в апельсиновых рощах к югу от монастыря Тянь. задание.‡Sammelt 8 reife Orangen im Orangenhain südlich des Tianklosters ein.‡티엔 수도원 남쪽의 오렌지 나무에서 잘 익은 오렌지 8개를 모아야 합니다. 레벨 10 비취 숲‡Coge 8 naranjas maduras de los naranjos que hay al sur del Monasterio Tian.‡‡Cueillez 8 Oranges mûres dans les Orangeraies au sud du Monastère de Tian.‡从天禅院南面的橘树上摘下8个成熟的橘子。‡',
  }
},
[29620] = {
  {
    'O grande de banquete‡Пир на весь мир‡Das große Bankett‡대연회‡El gran festín‡‡Le grand banquet‡盛大的宴会‡',
    nil,
    'Fale com o Sumo Ancião Nuvem Branda no salão de banquetes no Monastério de Tian. Uma‡Поговорите с верховным старейшиной Дождевой Тучей, который находится на площадке для пиршества в монастыре Тянь.‡Sprecht mit dem Hohen Ältesten Wolkensturz im Bankettareal im Tiankloster.‡티엔 수도원에 있는 연회장에서 대장로 클라우드폴과 대화해야 합니다. 레벨 10 비취 숲‡Habla con el gran ancestro Otoño Nublo en las Tierras del Festín, en el Monasterio Tian.‡‡Parlez avec le Grand ancien Chute des Nuages dans la Cour du Banquet, au Monastère de Tian.‡和天禅院宴会地中的云瀑长老谈一谈。‡',
  }
},
[29621] = {
  {
    'UNUSED‡UNUSED‡UNUSED‡‡UNUSED‡‡UNUSED‡‡',
    nil,
    'Speak with the four High Elder spirits in Tian Monastery. Uma‡Speak with the four High Elder spirits in Tian Monastery.‡Sprecht mit den Geistern der vier Hohen Ältesten im Tiankloster.‡‡Hablan con los cuatro espíritus de los grandes ancestros en el Monasterio Tian.‡‡Parlez à 4 Esprits de Grands anciens au Monastère de Tian.‡‡',
  }
},
[29622] = {
  {
    'Seu treinamento começa agora‡Обучение начнется немедленно‡Beginn der Ausbildung‡수련의 시작‡Tu entrenamiento comienza ahora‡‡L’apprentissage commence ici‡训练开始‡',
    nil,
    'Fale com o Instrutor Xann no Monastério de Tian, que fica na Floresta de Jade. Uma‡Явитесь к инструктору Сяню, который находится в монастыре Тянь в Нефритовом лесу.‡Meldet Euch bei Ausbilder Xann im Tiankloster im Jadewald.‡비취 숲의 티엔 수도원에 있는 교관 산과 대화해야 합니다. 레벨 10 비취 숲‡Preséntate ante el instructor Xann en el Monasterio Tian, en El Bosque de Jade.‡‡Présentez-vous à l’Instructeur Xann au Monastère de Tian, dans la Forêt de Jade.‡去翡翠林的天禅院向夏教头报告。‡',
  }
},
[29623] = {
  {
    'Perfeição‡Совершенство‡Perfektion‡완벽함‡Perfección‡‡Perfection‡臻于完美‡',
    nil,
    'Pratique dando 12 golpes na Arena de Treinamento do Monastério seguindo o exemplo do líder. Uma‡Следуя примеру учителя, нанесите 12 тренировочных ударов на монастырской арене.‡Führt 12 Übungsschläge in der Ausbildungsarena des Klosters aus, indem Ihr die Beispiele nachahmt.‡수도원 훈련장에서 교관의 지시에 따라 지르기를 12번 연습해야 합니다. 레벨 10 비취 숲‡Realiza 12 golpes de entrenamiento en la arena de entrenamiento del monasterio siguiendo el ejemplo del líder.‡‡Pratiquez 12 Passes d’entraînement au Camp d’entraînement du Monastère en suivant l’exemple du maître.‡按照头领的样子在禅院训练武场做12次击打。‡',
  }
},
[29624] = {
  {
    'Atenção‡Внимание‡Bitte recht aufmerksam‡집중력‡Atención‡‡Attention‡保持专注‡',
    nil,
    'Destrua 2 Sacos de Treinamento. Siga as instruções do Instrutor Xann para saber que sacos atacar. Uma‡Уничтожьте 2 тренировочных мешка, следуя указаниям инструктора Сяня.‡Zerstört 2 Sandsäcke. Folgt den Anweisungen von Ausbilder Xann, um zu entscheiden, welche Säcke angegriffen werden sollen.‡수련용 모래주머니 2개를 파괴해야 합니다. 교관 산의 구령에 따라 모래주머니를 공격해야 합니다.‡Destruye 2 sacos de entrenamiento. Sigue las instrucciones del Instructor Xann para saber qué saco debes atacar.‡‡Détruisez 2 Sacs d’entraînement. Suivez les ordres de l’Instructeur Xann pour savoir quels sacs frapper.‡击破2个训练沙袋。根据夏教头的指示来决定应该攻击哪个沙袋。‡',
  }
},
[29625] = {
  {
    'UNUSED‡UNUSED‡UNUSED‡‡UNUSED‡‡UNUSED‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[29626] = {
  {
    'Jardineiro Wu‡Смотритель У‡Klosterwart Wu‡관리인 우‡Guardés Wu‡‡Le paysagiste Wu‡园丁老吴‡',
    nil,
    'Fale com o Jardineiro Wu no Monastério de Tian, que fica na Floresta de Jade. Uma‡Поговорите со смотрителем У, который находится в монастыре Тянь в Нефритовом лесу.‡Meldet Euch bei Klosterwart Wu im Tiankloster im Jadewald.‡비취 숲의 티엔 수도원에 있는 관리인 우에게 보고해야 합니다. 레벨 10 비취 숲‡Preséntate ante el guardés Wu en el Monasterio Tian, en El Bosque de Jade.‡‡Présentez-vous au Paysagiste Wu au Monastère de Tian, dans la Forêt de Jade.‡去翡翠林的天禅院找园丁老吴报告。‡',
  }
},
[29627] = {
  {
    'Uma arma adequada‡Правильное оружие‡Ein ordentliche Waffe‡적당한 무기‡Un arma adecuada‡‡Une arme convenable‡称手的武器‡',
    nil,
    'Consiga 6 Varas de Ratã nos arredores do mercado do Monastério de Tian.Compre um frasco de Extrato de Nogueira-preta com June Florabranca e 3 Cervejas Tri-amargosas do Mestre Cervejeiro Lei Kanglei.‡Найдите 6 побегов ротанга в окрестностях рынка монастыря Тянь.Купите у Юн Белый Цветок бутылочку черного орехового экстракта.Купите 3 бутыли трижды подгорченного эля у хмелевара Лэй Кан-лэя.‡Besorgt 6 Rattanruten aus der Gegend um den Markt vom Tiankloster.Kauft eine Phiole Schwarznussextrakt von Juni Weißblüte.Kauft 3 dreifach bittere Bräue von Braumeister Lei Kanglei.‡티엔 수도원 주위에서 등나무 가지 6개를 획득해야 합니다.준 화이트블라섬에게서 검은 호두 추출물을 구입해야 합니다.양조사 레이 캉레이에게서 세 배나 쓴 맥주 3병을 구입해야 합니다.‡Consigue 6 tallos de rota en las inmediaciones del mercado, en el Monasterio Tian.Compra un vial con extracto de nuez negra a June Flor Nívea.Compra 3 cervezas agrias triples al maestro cervecero Lei Kanglei.‡‡Obtenez 6 Cannes en rotin dans la zone autour du Marché dans le Monastère de Tian.Achetez une Fiole d’extrait de noix noire à June Fleur Blanche.Achetez 3 Bières à triple houblonnage au Maître brasseur Lei Kanglei.‡去天禅院的市场附近收集6条藤鞭。在琼·白花那里买一瓶黑胡桃木萃取物。从酒仙雷康磊那里买三瓶特苦啤酒。‡',
  }
},
[29628] = {
  {
    'Costas robustas‡Сильная поддержка‡Ein starker Rücken‡튼튼한 등짝‡Una espalda fuerte‡‡Un dos solide‡强壮的后背‡',
    nil,
    'Pegue um Caldeirão Fervente com a Mãe Wu na Floresta de Cera e, depois, entregue ao Jardineiro Wu no Monastério de Tian. Uma‡Возьмите кипящий котел у Матушки У, которая живет в Буковом лесу, затем вернитесь к смотрителю У в монастырь Тянь.‡Holt einen kochenden Kessel von Mutter Wu im Wachsgehölz ab und kehrt dann zu Klosterwart Wu im Tiankloster zurück.‡광나무숲에 있는 대모 우에게서 끓는 가마솥을 획득한 후, 티엔 수도원에 있는 관리인 우에게 돌아와야 합니다.‡Consigue una caldera en ebullición de la madre Wu en el Bosque de Cera y llévasela al guardés Wu, en el Monasterio Tian.‡‡Obtenez un Chaudron bouillant auprès de Mère Wu dans la Forêt de Troènes, puis retournez voir le Paysagiste Wu au Monastère de Tian. Un(e) quête.‡从红烛林吴大妈处拿到沸腾的大锅，再去天禅院找园丁老吴。‡',
  }
},
[29629] = {
  {
    'Mãos firmes‡Твердая рука‡Eine ruhige Hand‡차분한 손길‡Una mano firme‡‡Une main ferme et sûre‡稳健的双手‡',
    nil,
    'Colete 80 frascos de Extrato de Folha-carmim dos arbustos de Folha-carmim na Floresta de Cera. Uma‡Соберите 80 сосудов экстракта краснолиста из гроздьев краснолиста Букового леса.‡Besorgt 80 Phiolen Rötelblattextrakt von den Rötelblattbüscheln im Wachsgehölz.‡광나무숲에 있는 홍조잎 다발에서 홍조잎 추출물 80병을 획득해야 합니다. 레벨 10 비취 숲‡Obtén 80 viales de extracto de ruboroja de las marañas de ruboroja que hay en el Bosque de Cera.‡‡Obtenez 80 fioles d’Extrait de cramoisine sur des Grappes de cramoisine dans la Forêt de Troènes.‡从红烛林中的猩红叶树丛提取出80瓶猩红叶萃取物。‡',
  }
},
[29630] = {
  {
    'Punho pesado‡И тяжелый кулак‡Und eine harte Faust‡무거운 주먹‡Y puños de hierro‡‡Et un poing lourd‡沉重的拳头‡',
    nil,
    'Mate 10 Trapaceiros Lenhaverde na Floresta de Cera. Uma‡Уничтожьте 10 плутов Зеленой Скалы в Буковом лесу.‡Erledigt 10 Grünholztrickster im Wachsgehölz.‡광나무숲에서 푸른숲 요술쟁이 10마리를 처치해야 합니다. 레벨 10 비취 숲‡Acaba con 10 tramposos Monteverde en el Bosque de Cera.‡‡Tuez 10 Entourloupeurs vert-bois dans la Forêt de Troènes.‡杀死10只红烛林中的绿木欺诈者。‡',
  }
},
[29631] = {
  {
    'Brilho, brasa‡Жгучий страх‡Mit Feuereifer‡하얗게 불태웠어‡Brillo ardiente‡‡Peur bleue‡明亮地燃烧‡',
    nil,
    'Mate 6 Tigres da Floresta de Cera. Uma‡Уничтожьте 6 тигров в Буковом лесу.‡Tötet 6 Wachsgehölztiger.‡광나무숲 호랑이 6마리를 처치해야 합니다. 레벨 10 비취 숲‡Mata a 6 tigres del Bosque de Cera.‡‡Tuez 6 Tigres de la Forêt de Troènes.‡杀死6只红烛林老虎。‡',
  }
},
[29632] = {
  {
    'Preparando-se para o combate‡Полная боевая готовность‡Bereit zum Kampf‡전투에 임하는 자세‡Preparándose para la batalla‡‡Entraînement au combat‡战备状态‡',
    nil,
    'Derrote 8 Pupilos de Tian em lutas de treino no Monastério de Tian. Uma‡Победите 8 послушников монастыря Тянь в тренировочных боях в монастыре Тянь.‡Besiegt 8 Schüler von Tian in Übungskämpfen im Tiankloster.‡티엔 수도원에서 티엔 견습생 8명과 대련하여 승리해야 합니다. 레벨 10 비취 숲‡Derrota a 8 alumnos de Tian en combates de entrenamiento en el Monasterio Tian.‡‡Triomphez de 8 Élèves de Tian lors de combats d’entraînement au Monastère de Tian.‡在天禅院的比武中击败8名天禅院新徒。‡',
  }
},
[29633] = {
  {
    'Zhi-zhi, o Habilidoso‡Ловкий Чжи-Чжи‡Der wehrhafte Zhi-Zhi‡민첩한 즈즈‡Zhi-Zhi el Diestro‡‡Zhe Zhe l’agile‡灵巧的齐齐‡',
    nil,
    'Derrote Zhi-Zhi no Monastério de Tian. Uma‡Победите Чжи-Чжи в монастыре Тянь.‡Besiegt Zhi-Zhi im Tiankloster.‡티엔 수도원에서 즈즈를 물리쳐야 합니다. 레벨 10 비취 숲‡Derrota a Zhi-Zhi en el Monasterio Tian.‡‡Triomphez de Zhe Zhe au Monastère de Tian.‡在天禅院击败齐齐。‡',
  }
},
[29634] = {
  {
    'Husshun, o Encarquilhado‡Иссохший Хушунь‡Der uralte Husshun‡현자 후슌‡Husshun el Marchito‡‡Husshun le rabougri‡枯瘦的胡苏安‡',
    nil,
    'Desafie e derrote Husshun no Monastério de Tian. Uma‡Бросьте вызов Хушуню и победите его в монастыре Тянь.‡Fordert Husshun im Tiankloster heraus und besiegt ihn.‡티엔 수도원에서 후슌에게 도전하여 승리해야 합니다. 레벨 10 비취 숲‡Desafía y derrota a Husshun en el Monasterio Tian.‡‡Défiez Husshun et triomphez de lui au Monastère de Tian.‡在天禅院向胡苏安发起挑战并击败他。‡',
  }
},
[29635] = {
  {
    'Xiao, o Comilão‡Обжора Сяо‡Der hungrige Xiao‡식신 샤오‡Xiao el Devorador‡‡Xiao le mangeur‡贪吃的晓‡',
    nil,
    'Desafie e derrote Xiao no Monastério de Tian. Uma‡Бросьте вызов Сяо и победите его в монастыре Тянь.‡Fordert Xiao im Tiankloster heraus und besiegt ihn.‡티엔 수도원에서 샤오에게 도전하고 승리해야 합니다. 레벨 10 비취 숲‡Desafía y vence a Xiao en el Monasterio Tian.‡‡Défiez Xiao et triomphez de lui au Monastère de Tian.‡在天禅院向晓发起挑战并击败他。‡',
  }
},
[29636] = {
  {
    'Um teste de resistência‡Проверка на выносливость‡Ein langer Weg‡인내의 시험‡Una prueba de resistencia‡‡Un test d’endurance‡耐力的试炼‡',
    nil,
    'Fale com a Instrutora Myang no lado oeste do Monastério de Tian. Uma‡Явитесь к инструктору Мян, которая находится в западной части монастыря Тянь.‡Meldet Euch bei Ausbilderin Myang im westlichen Bereich des Tianklosters.‡티엔 수도원의 서쪽에 있는 교관 미앙에게 가야 합니다. 레벨 10 비취 숲‡Preséntate ante la instructora Myang, en el sector oeste del Monasterio Tian.‡‡Présentez-vous à l’Instructrice Myang dans la partie ouest du Monastère de Tian.‡去天禅院的西边找孟教头。‡',
  }
},
[29637] = {
  {
    'O Tumulto‡Суматоха‡Massenschlägerei‡난투극‡El embrollo‡‡Le tohu-bohu‡大乱斗‡',
    nil,
    'Solte os Fogos de Artifício do Monastério no Ringue da Concentração Interior. Depois, sobreviva ao Tumulto por dois minutos. Uma‡Запустите монастырский фейерверк, находясь в Круге Внутреннего Сосредоточения, а затем продержитесь в этой суматохе не менее двух минут.‡Entzündet das Kloster-Feuerwerk im Ring des Inneren Fokus und überlebt die zwei Minuten dauernde Massenschlägerei.‡내면의 집중 투기장에서 수도원 폭죽을 발사하고, 2분 동안 공격을 막아내야 합니다. 레벨 10 비취 숲‡Lanza los fuegos artificiales del monasterio en El Círculo del Enfoque Interno y sobrevive al embrollo durante dos minutos.‡‡Allumez les Feux d’artifice du monastère dans l’Arène de la Focalisation intérieure, puis survivez au Tohu-Bohu pendant deux minutes.‡在制衡之环中点燃禅院烟火，然后在大乱斗中坚持两分钟。‡',
  }
},
[29638] = {
  {
    'UNUSED‡UNUSED‡UNUSED‡‡UNUSED‡‡UNUSED‡‡',
    nil,
    'Report to High Elder Cloudfall at the Banquet Grounds in the Jade Forest. Uma‡Явитесь к Верховному старейшине Дождевой Туче, который находится на площадке для пиршества в Нефритовом лесу.‡Meldet Euch beim Hohen Ältesten Wolkensturz im Bankettareal im Jadewald.‡‡Preséntate ante el gran ancestro Otoño Nublo en las Tierras del Festín, en el Bosque de Jade.‡‡Présentez-vous au Grand ancien Chute des Nuages aux Terres du Banquet, dans la Forêt de Jade.‡‡',
  }
},
[29639] = {
  {
    'Bandeiras ao vento‡С отличием‡Mit Bravour bestanden‡완벽한 마무리‡Matrícula de honor‡‡Haut la main‡流光溢彩‡',
    nil,
    'Fale com o Sumo Ancião Nuvem Branda no Monastério de Tian, que fica na Floresta de Jade. Uma‡Явитесь к Верховному старейшине Дождевой Туче, который находится в монастыре Тянь в Нефритовом лесу.‡Meldet Euch beim Hohen Ältesten Wolkensturz im Tiankloster im Jadewald.‡비취 숲의 연회장에 있는 대장로 클라우드폴에게 보고해야 합니다. 레벨 10 비취 숲‡Preséntate ante el gran ancestro Otoño Nublo en el Monasterio Tian, en El Bosque de Jade.‡‡Présentez-vous au Grand ancien Chute des Nuages au Monastère de Tian, dans la Forêt de Jade.‡去翡翠林的天禅院向云瀑长老报告。‡',
  }
},
[29640] = {
  {
    'Encontre o espião To\'gun‡Найти шпиона То\'гуна!‡Findet Spion To\'gun‡비밀요원 토군 찾기‡Encontrar al espía To\'gun‡Encontrar al espía To\'gun‡Trouver l\'espion To\'gun‡寻找间谍托古恩‡找尋間諜吐剛',
    nil,
    'Encontre o Espião To\'gun no Labirinto Soturno de Auchindoun.‡Найдите шпиона То\'гуна в Темном лабиринте в Аукиндоне.‡Findet Spion To\'gun im Schattenlabyrinth von Auchindoun.‡아킨둔에 있는 어둠의 미궁에서 비밀요원 토군을 찾아야 합니다.‡Localiza al espía To\'gun en el Laberinto de las Sombras, en Auchindoun.‡Localiza al espía To\'gun en el Laberinto de las Sombras, en Auchindoun.‡Trouvez l\'espion To\'gun dans le Labyrinthe des ombres d\'Auchindoun.‡在奥金顿的暗影迷宫中找到间谍托古恩。‡找出奧齊頓的暗影迷宮內間諜吐剛的所在處。',
  }
},
[29641] = {
  {
    'Os dispositivos da alma‡Инструменты души‡Seeleninstrumente‡영혼의 장치‡Los dispositivos de almas‡Los dispositivos de almas‡Les machines à âmes‡灵魂装置‡靈魂儀器',
    nil,
    'Roube 5 Dispositivos da Alma e entregue-os para a Espiã Grik\'tha no Labirinto Soturno de Auchindoun.‡Украдите 5 инструментов душ и принесите их шпиону Грик\'те в Темный лабиринт Аукиндона.‡Stehlt 5 Seeleninstrumente und bringt sie zu Spionin Grik\'tha im Schattenlabyrinth von Auchindoun.‡영혼의 장치 5개를 훔쳐서 아킨둔의 어둠의 미궁 안에 있는 비밀요원 그리크타에게 가져가야 합니다.‡Roba 5 dispositivos de alma y entrégaselos a espía Grik\'tha en el Laberinto de las Sombras de Auchindoun.‡Roba 5 dispositivos de alma y entrégaselos a espía Grik\'tha en el Laberinto de las Sombras de Auchindoun.‡Volez 5 Machines à âmes puis apportez-les à l’Espionne Grik’tha à l’intérieur du Labyrinthe des Ombres, à Auchindoun.‡偷走5台灵魂装置，把它们交给在奥金顿暗影迷宫内的间谍格利克萨。‡偷取5個靈魂儀器，並運送給奧齊頓暗影迷宮內的間諜葛瑞克薩。',
  }
},
[29642] = {
  {
    'Problemas em Auchindoun‡В Аукиндоне неспокойно‡Ärger in Auchindoun‡아킨둔의 문제‡Problemas en Auchindoun‡Problemas en Auchindoun‡Troubles à Auchindoun‡奥金顿的麻烦‡奧齊頓的麻煩',
    nil,
    'Apresente-se ao Comandante de Campo Mahfuun no Labirinto Soturno, em Auchindoun, que fica na Mata Terokkar.‡Отправляйтесь к боевому командиру Мафууну в Темный Лабиринт Аукиндона в Лесу Террокар.‡Meldet Euch bei Feldkommandeur Mahfuun im Schattenlabyrinth in Auchindoun in den Wäldern von Terokkar.‡테로카르 숲, 아킨둔의 어둠의 미궁 입구에 있는 야전사령관 마푼에게 보고해야 합니다.‡Preséntate ante el comandante de operaciones Mahfuun en el Laberinto de las Sombras en Auchindoun, en el Bosque de Terokkar.‡Preséntate ante el comandante de operaciones Mahfuun en el Laberinto de las Sombras en Auchindoun, en el Bosque de Terokkar.‡Présentez-vous au commandant Mahfuun à l’intérieur du Labyrinthe des Ombres à Auchindoun, dans la forêt de Terokkar.‡返回泰罗卡森林向奥金顿暗影迷宫里的战地指挥官玛弗恩报道。‡到泰洛卡森林裡奧齊頓的暗影迷宮內，向戰場元帥瑪赫范報到。',
  }
},
[29643] = {
  {
    'O Códice de Sangue‡Кодекс Крови‡Der Kodex des Blutes‡피의 고서‡El Códice de Sangre‡El Códice de Sangre‡Le codex de sang‡鲜血法典‡血之聖典',
    nil,
    'Leia o Códice de Sangue no Labirinto Soturno de Auchindoun.‡Прочитайте Кодекс Крови в Темном лабиринте в Аукиндоне.‡Lest den Kodex des Blutes im Schattenlabyrinth von Auchindoun.‡아킨둔의 어둠의 미궁에 있는 피의 고서를 읽어야 합니다.‡Lee el Códice de Sangre en el Laberinto de las Sombras en Auchindoun.‡Lee el Códice de Sangre en el Laberinto de las Sombras en Auchindoun.‡Lisez le Codex de sang dans le Labyrinthe des Ombres d\'Auchindoun.‡在奥金顿暗影迷宫内阅读鲜血法典的内容。‡閱讀奧齊頓暗影迷宮裡的血之聖典。',
  }
},
[29644] = {
  {
    'Rumo ao coração do labirinto‡В самом сердце Лабиринта‡In das Herz des Labyrinths‡미궁의 심장부로‡En el corazón del laberinto‡En el corazón del laberinto‡Au cœur du labyrinthe‡深入暗影迷宫‡進入迷宮的中心',
    nil,
    'Destrua Murmúrio e informe o Comandante de Campo Mahfuun no Labirinto Soturno, em Auchindoun.‡Уничтожьте Бормотуна и доложите об этом боевому командиру Мафууну в Темном лабиринте в Аукиндоне.‡Vernichtet Murmur und meldet Euch danach bei Feldkommandeur Mahfuun im Schattenlabyrinth von Auchindoun.‡울림을 없앤 후 아킨둔의 어둠의 미궁 안에 있는 야전사령관 마푼에게 이 사실을 알려야 합니다.‡Destruye a Murmullo e informa al comandante de operaciones Mahfuun, situado en el interior del Laberinto de las Sombras de Auchindoun.‡Destruye a Murmullo e informa al comandante de operaciones Mahfuun, situado en el interior del Laberinto de las Sombras de Auchindoun.‡Détruisez Marmon, puis rendez-vous à l’intérieur du Labyrinthe des Ombres à Auchindoun pour faire un rapport de ce qui s\'est passé au Commandant Mahfuun.‡消灭摩摩尔并通知奥金顿暗影迷宫内的战地指挥官玛弗恩。‡殺掉莫爾墨後，回到奧齊頓的暗影迷宮，通知戰場元帥瑪赫范裡頭發生的事件。',
  }
},
[29645] = {
  {
    'Embaixador Gorjavernus‡Посол Гиблочрев‡Botschafter Höllenschlund‡사자 지옥아귀‡Embajador Faucinferno‡Embajador Faucinferno‡Ambassadeur Gueule-d’enfer‡赫尔默大使‡海爾瑪大使',
    nil,
    'Mate 18 Ritualistas do Conluio e o Embaixador Gorjavernus. Em seguida, fale novamente com o Comandante de Campo Mahfuun no Labirinto Soturno de Auchindoun.‡Убейте 18 кабалистов-ритуалистов и посла Гиблочрева, после чего возвращайтесь к боевому командиру Мафууну в Темный лабиринт Аукиндона.‡Tötet 18 Ritualisten der Kabale und Botschafter Höllenschlund. Kehrt dann zu Feldkommandeur Mahfuun im Schattenlabyrinth von Auchindoun zurück.‡비밀결사단 신도 15명과 사자 지옥아귀를 처치한 뒤에 아킨둔의 어둠의 미궁 안에 있는 야전사령관 마푼에게 가야 합니다.‡Mata a 18 ritualistas de la Cábala y al embajador Faucinferno. Después, vuelve con el comandante de operaciones Mahfuun dentro del Laberinto de las Sombras de Auchindoun.‡Mata a 18 ritualistas de la Cábala y al embajador Faucinferno. Después, vuelve con el comandante de operaciones Mahfuun dentro del Laberinto de las Sombras de Auchindoun.‡Tuez 18 Ritualistes de la Cabale et l’Ambassadeur Gueule-d’enfer, puis retournez auprès du Commandant Mahfunn dans le Laybrinthe des Ombres, à Auchindoun.‡杀死18个秘教仪祭师，以及赫尔默大使，然后向奥金顿暗影迷宫内的战地指挥官玛弗恩复命。‡殺死18個祭儀師和海爾瑪，然後回奧齊頓的暗影迷宮找戰場元帥瑪赫范。',
  }
},
[29646] = {
  {
    'Bandeiras ao vento‡С отличием‡Mit Bravour bestanden‡완벽한 마무리‡Matrícula de honor‡‡Haut la main‡流光溢彩‡',
    nil,
    'Fale com o Sumo Ancião Nuvem Branda na Sala de Banquetes, na Floresta de Jade. Uma‡Поговорите с верховным старейшиной Дождевой Тучей, который находится на площадке для пиршества в Нефритовом лесу.‡Meldet Euch beim Hohen Ältesten Wolkensturz im Bankettareal im Jadewald.‡비취 숲의 연회장에 있는 대장로 클라우드폴에게 보고해야 합니다. 레벨 10 비취 숲‡Preséntate ante el gran ancestro Otoño Nublo en las Tierras del Festín, en El Bosque de Jade.‡‡Présentez-vous au Grand ancien Chute des Nuages à la Cour du Banquet, dans la Forêt de Jade.‡去翡翠林的宴会地向云瀑长老报到。‡',
  }
},
[29647] = {
  {
    'Bandeiras ao vento‡С отличием‡Mit Bravour bestanden‡완벽한 마무리‡Matrícula de honor‡‡Haut la main‡流光溢彩‡',
    nil,
    'Fale com o Sumo Ancião Nuvem Branda na Sala de Banquetes, na Floresta de Jade. Uma‡Поговорите с верховным старейшиной Дождевой Тучей на площадке для пиршества в Нефритовом лесу.‡Meldet Euch beim Hohen Ältesten Wolkensturz im Bankettareal im Jadewald.‡비취 숲의 연회장에 있는 대장로 클라우드폴에게 보고해야 합니다. 레벨 10 비취 숲‡Preséntate ante el gran ancestro Otoño Nublo en las Tierras del Festín, en El Bosque de Jade.‡‡Présentez-vous au Grand ancien Chute des Nuages à la Cour du Banquet, dans la Forêt de Jade.‡去翡翠林的宴会地向云瀑长老报到。‡',
  }
},
[29648] = {
  {
    'UNUSED‡UNUSED‡UNUSED‡‡UNUSED‡‡UNUSED‡‡',
    nil,
    'Uma‡‡‡‡‡‡‡‡',
  }
},
[29649] = {
  {
    'Como salvar uma vida‡Спасение жизни‡Wie man ein Leben rettet‡생명을 구하는 방법‡Cómo salvar una vida‡Cómo salvar una vida‡Comment sauver une vie‡如何拯救一条生命‡如何拯救生命',
    nil,
    'O Batedor Avançado Chagas, nos Salões Despedaçados da Cidadela Fogo do Inferno, quer que você lhe traga uma Brasa Vil.‡Передовой разведчик Чадвик, находящийся в Разрушенных Залах, что в Цитадели Адского Пламени, хочет, чтобы вы принесли ему уголь Скверны.‡Vorhutsspäher Chadwick in den Zerschmetterten Hallen der Höllenfeuerzitadelle möchte, dass Ihr ihm Teufelsglut bringt.‡지옥불 성채, 으스러진 손의 전당에 있는 전위 정찰병 채드윅에게 지옥의 불씨를 가져가야 합니다.‡El explorador táctico Chadwick, de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que le lleves ascuas viles.‡El explorador táctico Chadwick, de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que le lleves ascuas viles.‡L’Éclaireur avancé Chadwick, à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales, vous a demandé de lui apporter une Gangrebraise.‡在地狱火堡垒破碎大厅里的高级斥候卡德维克希望你能帮他带回一份邪能灰烬。‡地獄火堡壘內破碎大廳的先遣斥侯查德威克要你去帶一個魔化餘燼回來。',
  }
},
[29650] = {
  {
    'Brasa vil‡Уголь Скверны‡Teufelsglut‡지옥의 불씨‡Ascuas viles‡Ascuas viles‡La gangrebraise‡邪能灰烬‡魔化餘燼',
    nil,
    'O Guarda Pétreo Stok\'ton, nos Salões Despedaçados da Cidadela Fogo do Inferno, quer que você lhe traga uma Brasa Vil.‡Каменный страж Сток\'тон, находящийся в Разрушенных Залах, что в Цитадели Адского Пламени, хочет, чтобы вы принесли ему уголь Скверны.‡Steingardist Stok\'ton in den Zerschmetterten Hallen der Höllenfeuerzitadelle möchte, dass Ihr ihm Teufelsglut bringt.‡지옥불 성채, 으스러진 손의 전당에 있는 투사 스톡톤에게 지옥의 불씨를 가져가야 합니다.‡El guardia de piedra Stok\'ton, situado en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que le lleves un ascua vil.‡El guardia de piedra Stok\'ton, situado en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que le lleves un ascua vil.‡Le Garde de pierre Stok’ton, à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales, vous a demandé de lui apporter une Gangrebraise.‡在地狱火堡垒破碎大厅里的石头守卫斯托克顿希望你能帮他带回一份邪能灰烬。‡地獄火堡壘內破碎大廳的石衛士史托克頓要你去帶一個魔化餘燼回來。',
  }
},
[29651] = {
  {
    'Homenagem aos moribundos‡Почтить память погибших‡Ehrt die Sterbenden‡죽어가는 자에게 명예를‡Homenaje a los muertos‡Homenaje a los muertos‡Honorer les mourants‡安息‡死者的榮耀',
    nil,
    'Caza\'rez, nos Salões Despedaçados da Cidadela Fogo do Inferno, quer que você mate 4 Legionários da Mão Despedaçada, 2 Centuriões da Mão Despedaçada e 2 Campeões da Mão Despedaçada.‡Убейте 4 легионеров клана Изувеченной Длани, 2 центурионов клана Изувеченной Длани и 2 воителей клана Изувеченной Длани по просьбе Каса\'реса, находящегося в Разрушенных залах Цитадели Адского Пламени.‡Caza\'rez in den Zerschmetterten Hallen der Höllenfeuerzitadelle möchte, dass Ihr 4 Legionäre der Zerschmetterten Hand, 2 Zenturionen der Zerschmetterten Hand und 2 Champions der Zerschmetterten Hand tötet.‡으스러진 손의 군단병 4명, 으스러진 손의 백인대장 2명, 으스러진 손의 용사 2명을 처치해야 합니다.‡Caza\'rez, situado en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que mates a 4 legionarios Mano Destrozada, 2 centuriones Mano Destrozada y 2 campeones Mano Destrozada.‡Caza\'rez, situado en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que mates a 4 legionarios Mano Destrozada, 2 centuriones Mano Destrozada y 2 campeones Mano Destrozada.‡Caza’rez, à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales, vous a demandé de tuer 4 Légionnaires de la Main brisée, 2 Centurions de la Main brisée et 2 Champions de la Main brisée.‡在地狱火堡垒破碎大厅里的卡萨雷兹要你杀死4个碎手军团士兵，2个碎手百夫长和2个碎手勇士。‡地獄火堡壘內破碎大廳的卡沙瑞斯要你殺死4個破碎之手的軍團士兵、2個百夫長和2個勇士。',
  }
},
[29652] = {
  {
    'Um último favor‡Последняя услуга‡Ein letzter Gefallen‡마지막 부탁‡Un último favor‡Un último favor‡Un dernier service‡帮最后一个忙‡最後一個忙',
    nil,
    'Gunny, nos Salões Despedaçados da Cidadela Fogo do Inferno, quer que você mate 4 Legionários da Mão Despedaçada, 2 Centuriões da Mão Despedaçada e 2 Campeões da Mão Despedaçada.‡Убейте 4 легионеров клана Изувеченной Длани, 2 центурионов клана Изувеченной Длани и 2 воителей клана Изувеченной Длани по просьбе Пушкаря, находящегося в Разрушенных залах Цитадели Адского Пламени.‡Gunny in den Zerschmetterten Hallen der Höllenfeuerzitadelle möchte, dass Ihr 4 Legionäre, 2 Zenturionen und 2 Champions der Zerschmetterten Hand tötet.‡으스러진 손의 군단병 4명, 으스러진 손의 백인대장 2명, 으스러진 손의 용사 2명을 처치해야 합니다.‡Pistolete, situado en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que mates a 4 legionarios Mano Destrozada, 2 centuriones Mano Destrozada y 2 campeones Mano Destrozada.‡Pistolete, situado en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal, quiere que mates a 4 legionarios Mano Destrozada, 2 centuriones Mano Destrozada y 2 campeones Mano Destrozada.‡Flingot, à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales, vous demande de tuer 4 Légionnaires de la Main brisée, 2 Centurions de la Main brisée et 2 Champions de la Main brisée.‡在地狱火堡垒破碎大厅里的冈尼要你杀死4个碎手军团士兵，2个碎手百夫长和2个碎手勇士。‡地獄火堡壘內破碎大廳的甘尼要你殺死4個破碎之手的軍團士兵、2個百夫長和2個勇士。',
  }
},
[29653] = {
  {
    'A vontade do Chefe Guerreiro‡Воля Вождя‡Der Wille des Kriegshäuptlings‡대족장의 의지‡La voluntad del Jefe de Guerra‡La voluntad del Jefe de Guerra‡La volonté du Chef de guerre‡酋长的意志‡大酋長的意志',
    nil,
    'Entregue o Punho do Chefe Guerreiro Karrath para o Guarda Pétreo Stok\'ton nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Принесите кулак вождя Каргата каменному стражу Сток\'тону в Разрушенные Залы в Цитадели Адского Пламени,‡Bringt Kriegshäuptling Kargaths Faust zu Steingardist Stok\'ton in den Zerschmetterten Hallen der Höllenfeuerzitadelle.‡지옥불 성채, 으스러진 손의 전당에 있는 투사 스톡톤에게 대족장 카르가스의 주먹을 가져가야 합니다.‡Lleva el puño del Jefe de Guerra Kargath al Guardia de piedra Stok\'ton en Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Lleva el puño del Jefe de Guerra Kargath al Guardia de piedra Stok\'ton en Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Le Garde de pierre Stok’ton à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales, veut que vous lui rapportiez le Poing du chef de guerre Kargath.‡把卡加斯酋长之拳带给在地狱火堡垒破碎大厅里的石头守卫斯托克顿。‡將大酋長卡加斯之手帶回給地獄火堡壘內破碎大廳的石衛士史托克頓。',
  }
},
[29654] = {
  {
    'Virando o jogo‡Новый поворот событий‡Das Schicksal wenden‡전황의 변화‡Girando las tornas‡Girando las tornas‡L\'heure du tournant‡扭转局势‡扭轉劣勢',
    nil,
    'Entregue o Punho do Chefe Guerreiro Karrath para o Batedor Avançado Chagas nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Принесите кулак вождя Каргата передовому разведчику Чадвику в Разрушенные Залы в Цитадели Адского Пламени,‡Bringt Kriegshäuptling Kargaths Faust zu Vorhutsspäher Chadwick in den Zerschmetterten Hallen der Höllenfeuerzitadelle.‡지옥불 성채, 으스러진 손의 전당에 있는 전위 정찰병 채드윅에게 대족장 카르가스의 주먹을 가져가야 합니다.‡Lleva el puño del Jefe de Guerra Kargath al explorador táctico Chadwick al interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Lleva el puño del Jefe de Guerra Kargath al explorador táctico Chadwick al interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Apportez le Poing du chef de guerre Kargath à l’Éclaireur avancé Chadwick à l’intérieur des Salles Brisées, dans la Citadelle des Flammes infernales.‡把卡加斯酋长之拳带给在地狱火堡垒破碎大厅里的高级斥候卡德维克。‡將大酋長卡加斯之手帶回給地獄火堡壘內破碎大廳的先遣斥侯查德威克。',
  }
},
[29655] = {
  {
    'Um tecido muito especial‡Особая ткань‡Ein ganz besonderes Tuch‡매우 특별한 옷‡Una tela muy especial‡Una tela muy especial‡Un tissu très spécial‡特殊的布‡特殊的戰袍',
    nil,
    'Mate o Armipotente O\'mrogg e entregue o manto de guerra dele para o Guarda Pétreo Stok\'ton nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Убейте Омрогга Завоевателя и принесите его боевое облачение каменному стражу Сток\'тону в Разрушенные Залы в Цитадели Адского Пламени,‡Tötet Kriegshetzer O\'mrogg und bringt sein Kriegstuch zu Steingardist Stok\'ton in den Zerschmetterten Hallen der Höllenfeuerzitadelle.‡전쟁인도자 오므로그를 처치하고 오므로그의 전투복을 지옥불 성채, 으스러진 손의 전당에 있는 투사 스톡톤에게 가져가야 합니다.‡Mata al belisario O\'mrogg y lleva su tela de guerra al guardia de piedra Stok\'ton dentro de Las Salas Arrasadas, en la Ciudadela del Fuego Infernal.‡Mata al belisario O\'mrogg y lleva su tela de guerra al guardia de piedra Stok\'ton dentro de Las Salas Arrasadas, en la Ciudadela del Fuego Infernal.‡Tuez le Porteguerre O’mrogg et apportez son Vêtement de guerre au Garde de pierre Stok’ton à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales.‡杀死战争使者沃姆罗格，把他的战袍带给在地狱火堡垒破碎大厅里的石头守卫斯托克顿。‡殺死歐姆拉格並把它的戰袍帶回去給地獄火堡壘內破碎大廳的石衛士史托克頓。',
  }
},
[29656] = {
  {
    'O manto de guerra de O\'mrogg‡Боевое облачение Омрогга‡O\'mroggs Kriegstuch‡오므로그의 전투복‡Tela de guerra de O\'mrogg‡Tela de guerra de O\'mrogg‡Le vêtement de guerre d’O’mrogg‡沃姆罗格的战袍‡歐姆拉格的戰袍',
    nil,
    'Mate o Armipotente O\'mrogg e entregue o manto de guerra dele para o Batedor Avançado Chagas nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Убейте Омрогга Завоевателя и принесите его боевое облачение передовому разведчику Чадвику в Разрушенные Залы в Цитадели Адского Пламени,‡Tötet Kriegshetzer O\'mrogg und bringt sein Kriegstuch zu Vorhutsspäher Chadwick in den Zerschmetterten Hallen der Höllenfeuerzitadelle.‡전쟁인도자 오므로그를 처치하고 지옥불 성채, 으스러진 손의 전당에 있는 전위 정찰병 채드윅에게 오므로그의 전투복을 가져가야 합니다.‡Mata al belisario O\'mrogg y lleva su tela de guerra al explorador táctico Chadwick al interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Mata al belisario O\'mrogg y lleva su tela de guerra al explorador táctico Chadwick al interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Tuez le Porteguerre O’mrogg et apportez son Vêtement de guerre à l’Éclaireur avancé Chadwick à l’intérieur des Salles Brisées de la Citadelle des Flammes infernales.‡杀死战争使者沃姆罗格，把他的战袍带给在地狱火堡垒破碎大厅里的高级斥候卡德维克。‡殺死戰爭使者歐姆拉格並將他的戰袍帶回去給地獄火堡壘內破碎大廳的先遣斥侯查德威克。',
  }
},
[29657] = {
  {
    'Com grandes poderes vêm grandes responsabilidades‡Кому многое дано, с того много и спросится‡Aus großer Kraft folgt große Verantwortung‡크나큰 힘에는 크나큰 책임이 따르는 법‡A gran poder, gran responsabilidad‡A gran poder, gran responsabilidad‡À grand pouvoir, grandes responsabilités‡能力越强，责任越大‡能力越強，責任越重',
    nil,
    'A\'dal quer que você mate o Mecanolorde Capácitus no Mecanar da Bastilha da Tormenta.‡А\'дал попросил вас убить механолорда Конденсарона в Механаре, в Крепости Бурь.‡A\'dal bittet Euch, Mechanolord Kapazitus in der Mechanar der Festung der Stürme zu töten.‡아달이 폭풍우 요새의 메카나르에 있는 기계군주 캐퍼시투스를 처치해 달라고 했습니다.‡A\'dal te ha pedido que mates al mecano-lord Capacitus en El Mechanar de EL Castillo de la Tempestad.‡A\'dal te ha pedido que mates al mecano-lord Capacitus en El Mechanar de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer le Mécano-seigneur Capacitus au Méchanar, au Donjon de la Tempête.‡阿达尔要你前往风暴要塞的能源舰，杀死机械领主卡帕西图斯。‡阿達歐要求你前往風暴要塞的麥克納爾，殺掉機械領主卡帕希特斯。',
  }
},
[29658] = {
  {
    'O Calculista‡Паталеон Вычислитель‡Der Kalkulator‡철두철미한 적‡El Calculador‡El Calculador‡Le Calculateur‡计算者‡操縱者',
    nil,
    'A\'dal quer que você mate Pathaleon, o Calculista, no Mecanar da Bastilha da Tormenta.‡А\'дал попросил вас убить Паталеона Вычислителя в Механаре, в Крепости Бурь.‡A\'dal hat Euch gebeten, Pathaleon den Kalkulator in der Mechanar der Festung der Stürme zu töten.‡아달이 폭풍우 요새의 메카나르에 있는 철두철미한 파탈리온을 처치해 달라고 했습니다.‡A\'dal te ha pedido que mates a Pathaleon el Calculador en El Mechanar del Castillo de la Tempestad.‡A\'dal te ha pedido que mates a Pathaleon el Calculador en El Mechanar de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer Pathaleon le Calculateur au Méchanar, au Donjon de la Tempête.‡阿达尔要你前往风暴要塞的能源舰，杀死计算者帕萨雷恩。‡阿達歐要求你前往風暴要塞的麥克納爾，殺掉操縱者帕薩里歐。',
  }
},
[29659] = {
  {
    'Tesouro perdido‡Потерянное сокровище‡Der verlorene Schatz‡잃어버린 보물‡El tesoro perdido‡El tesoro perdido‡Un trésor perdu‡丢失的宝物‡消失的寶藏',
    nil,
    'A\'dal quer que você recupere a Fúria Ofuscante do Baú da Legião que está no Mecanar da Bastilha da Tormenta.‡Добудьте для А\'дала Ослепляющую ярость со Склада Легиона в Механаре, в Крепости Бурь.‡Beschafft für A\'dal den Blendenden Zorn aus dem Behälter der Legion in der Mechanar der Festung der Stürme.‡아달이 폭풍우 요새의 메카나르에 있는 군단 저장고에서 눈부신 격노를 되찾아 달라고 했습니다.‡Consigue la furia cegadora para A\'dal en el alijo de la Legión de El Mechanar, en el Castillo de la Tempestad.‡Consigue la furia cegadora para A\'dal en el alijo de la Legión de El Mechanar, en el Castillo de la Tempestad.‡A’dal vous demande de récupérer la Fureur aveuglante dans la Cache de la Légion, au Méchanar du Donjon de la Tempête.‡前往风暴要塞的能源舰，为阿达尔拿回军团宝箱中的光耀之怒。‡到風暴要塞的麥克納爾，為阿達歐從軍團貯藏箱取回炫目狂怒。',
  }
},
[29660] = {
  {
    'Jardim Botânico em perigo!‡Спасение Ботаники‡Rettung der Botanika‡신록의 정원 살리기‡Salvar El Invernáculo‡Salvar El Invernáculo‡Il faut sauver la Botanica‡拯救生态船‡拯救波塔尼卡',
    nil,
    'A\'dal quer que você mate o Comandante Sarannis, o Alto-botânico Freywinn e Cardônico, o Mantenedor, no Jardim Botânico da Bastilha da Tormenta.‡А\'дал попросил вас убить командира Саранниса, верховного ботаника Фрейвина и Скалезуба Скорбного в Ботанике, в Крепости Бурь.‡A\'dal möchte, dass Ihr Kommandantin Sarannis, Hochbotaniker Freywinn und Dorngrin den Hüter in der Botanika der Festung der Stürme tötet.‡아달이 폭풍우 요새에 있는 신록의 정원에서 지휘관 새래니스, 고위 식물학자 프레이윈, 감시인 쏜그린을 처치해 달라고 했습니다.‡A\'dal quiere que mates al comandante Sarannis, al gran botánico Freywinn y a Thorngrim el Cuidador en el Invernáculo del Castillo de la Tempestad.‡A\'dal quiere que mates al comandante Sarannis, al gran botánico Freywinn y a Thorngrim el Cuidador en el Invernáculo de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer le Commandant Sarannis, le Grand botaniste Freywinn et Rirépine le Tendre à la Botanica, au Donjon de la Tempête.‡阿达尔希望你能前往风暴要塞的生态船，杀死指挥官萨拉妮丝、高级植物学家弗雷温以及看管者索恩格林。‡阿達歐要求你前往風暴要塞的波塔尼卡，殺掉指揮官薩瑞尼斯、大植物學家費瑞衛恩及『看管者』索古林。',
  }
},
[29661] = {
  {
    'A lição do pelo seco‡Урок сухого меха‡Die Lektion trockenen Fells‡마른 몸의 가르침‡La lección del pelaje seco‡‡La leçon de la fourrure sèche‡戒躁‡',
    nil,
    'Atravesse pelos postes de equilíbrio e toque o sino de treinamento. Uma‡Пройдите по столбам и позвоните в колокол.‡Findet einen Weg über die Balancierpfähle und läutet die Übungsglocke.‡균형대를 건너 수련용 종을 울려야 합니다. 레벨 1 유랑도‡Cruza los postes de equilibrio y tañe la campana de entrenamiento.‡‡Traversez les Mâts d’équilibre et faites sonner la Cloche d’entraînement.‡踩着梅花桩并敲响那口钟。‡',
  }
},
[29662] = {
  {
    'Mais forte que os juncos‡Прочней тростника‡Härter als Schilfrohre‡갈대보다 강하다‡Más fuerte que el junco‡‡Plus fort que le roseau‡比芦苇更硬‡',
    nil,
    'Junte 8 Juncos-chorões Duros. Uma‡Соберите 8 стеблей жесткого тростника.‡Sammelt 8 Stücke hartes Tränenholzschilf.‡단단한 눈물숲 갈대를 8개 모아야 합니다. 레벨 1 유랑도‡Reúne 8 juncos parteleños duros.‡‡Ramassez 8 Roseaux solides en bois-de-larmes.‡收集8棵结实的泪木芦苇。‡',
  }
},
[29663] = {
  {
    'A lição da rocha equilibrada‡Урок равновесия‡Die Lektion des balancierten Steines‡균형 잡힌 바위의 가르침‡La lección de la roca equilibrada‡‡La leçon du rocher en équilibre‡平衡训练‡',
    nil,
    'Derrote 6 Monges Tushui nos postes de equilíbrio. Uma‡Одержите победу над 6 монахами Тушуй на тренировочных столбах.‡Besiegt 6 Mönche der Tushui auf den Balancierpfählen.‡균형대 위에서 투슈이 수도사를 6명 이겨야 합니다. 레벨 1 유랑도‡Derrota a 6 monjes tushui en los postes de equilibrio.‡‡Battez 6 Moines tushui sur les Mâts d’équilibre.‡在梅花桩上击败6名土水派武僧。‡',
  }
},
[29664] = {
  {
    'As chamas do desafiante‡Огни, пробуждающие силу‡Die Flammen des Herausforderers‡도전자의 불꽃‡Las llamas del desafío‡‡Les feux du compétiteur‡挑战者之火‡',
    nil,
    'Acenda sua Tocha do Desafio Apagada no Braseiro da Chama Tremeluzente. Então, use-a para acender os 3 braseiros próximos ao mestre Li Fei.‡Зажгите ваш факел новичка от жаровни с мерцающим пламенем, после чего с его помощью разожгите огонь на 3 жаровнях возле мастера Ли Фэя.‡Entzündet Eure unangezündete Herausfordererfackel am Kohlenbecken der flackernden Flamme und benutzt sie dann, um die 3 Kohlenbecken in der Nähe von Meister Li Fei anzuzünden.‡꺼져가는 불길의 화로에서 불붙지 않은 도전자의 횃불에 불을 붙인 후, 사부 리 페이 근처에 있는 화로 세 개에 불을 지펴야 합니다.‡Enciende tu antorcha de contendiente sin encender en el blandón de llamas chisporroteantes y luego úsala para encender los 3 blandones cerca del maestro Li Fei.‡‡Allumez votre Torche éteinte de compétiteur au Brasero de la flamme vacillante, puis utilisez-la pour allumer les 3 Braseros près de Maître Li Fei.‡用闪焰火盆点燃挑战者火炬，然后用它来点燃李飞大师附近的3个火盆。‡',
  }
},
[29665] = {
  {
    'De mal a pior‡Чем дальше – тем хуже‡Vom Regen in die Traufe‡엎친 데 덮친 격‡De mal en peor‡‡De mal en pis‡越来越糟‡',
    nil,
    'Derrote 8 Atormentadores Escamafunda. Uma‡Убейте 8 глубоководных чешуйчатых мучителей.‡Bezwingt 8 Peiniger der Tiefenschuppen.‡깊은비늘 심문관을 8마리 처치해야 합니다. 레벨 1 유랑도‡Acaba con 8 torturadores Hondescama.‡‡Tuez 8 Tourmenteurs écaille-profonde.‡击败8只深鳞折磨者。‡',
  }
},
[29666] = {
  {
    'A dor do aprendizado‡Сквозь тернии‡Eine knifflige Lektion‡가르침의 아픔‡La picadura del aprendizaje‡‡Un apprentissage douloureux‡吃一蛰，长一智‡',
    nil,
    'Mate 6 Pinças d\'Água. Uma‡Убейте 6 водомерок.‡Tötet 6 Wasserkneifer.‡물집게 소금쟁이를 6마리 처치해야 합니다. 레벨 1 유랑도‡Mata 6 tenazarios acuáticos.‡‡Tuez 6 Pinceurs d’eau.‡杀死6只水钳虫。‡',
  }
},
[29667] = {
  {
    'Cortando o mal pela raiz‡Истребление безнадежных‡Ausdünnung der Herde‡솎아내기‡Selección natural‡Selección natural‡Abattage du troupeau‡肃清生态船‡汰弱扶強',
    nil,
    'A\'dal pediu que você matasse 6 Carnaçoites Transformados, 6 Gritorrores Transformados e 6 Horrores Transformados. Além disso, ele quer que você obtenha a Fronde de Crescimento Rápido do Laj no Jardim Botânico da Bastilha da Tormenta.‡А\'дал попросил вас убить 6 мутантных плотохлестов, 6 мутантных страховизгов и 6 мутантных ужасов, а также достать быстрорастущую ветку Ладжа в Ботанике, в Крепости Бурь.‡A\'dal bittet Euch, 6 mutierte Fleischpeitscher und 6 mutierte Furchtkreischer zu töten und einen schnellentwickelnden Wedel von Laj in der Botanika der Festung der Stürme zu erbeuten.‡아달이 폭풍우 요새에 있는 신록의 정원에서 변이된 살덩이괴물 6마리, 끔찍한 돌연변이 괴물 6마리, 공포의 돌연변이 괴물 6마리를 처치하고, 라즈에게서 고속 진화 잎사귀를 획득해 달라고 했습니다.‡A\'dal te ha pedido que mates a 6 azotadores de carne mutados, 6 chillones de miedo mutados, 6 horrores mutados y que obtengas una fronda de evolución rápida de Laj en El Invernáculo de El Castillo de la Tempestad.‡A\'dal te ha pedido que mates a 6 azotadores de carne mutados, 6 chillones de miedo mutados, 6 horrores mutados y que obtengas una fronda de evolución rápida de Laj en El Invernáculo de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer 6 Flagelleurs de chair en mutation, 6 Hurleurs d’effroi en mutation, 6 Horreurs en mutation, et d’obtenir une Feuille à évolution rapide sur Laj à la Botanica, au Donjon de la Tempête.‡阿达尔要求你杀死6个变异血肉鞭笞者，6个变异恐惧尖啸者，6个变异恐魔，然后从风暴要塞生态船的拉伊身上获得快速进化的叶子。‡阿達歐要求你前往風暴要塞的波塔尼卡，殺掉6隻突變的鞭屍者、6隻突變的恐懼尖嘯者、6隻突變的恐獸，然後取得拉杰身上的飛躍進化藻葉。',
  }
},
[29669] = {
  {
    'Uma tarefa lúgubre‡Нерадостное поручение‡Eine äußerst traurige Aufgabe‡참으로 우울한 임무‡Una tarea aún más dolorosa‡Una tarea aún más dolorosa‡Une bien sombre tâche‡严峻的任务‡最嚴峻的工作',
    nil,
    'A\'dal quer que você mate o Estilhaço Dimensional no Jardim Botânico da Bastilha da Tormenta.‡А\'дал попросил вас убить Узлодревня в Ботанике, в Крепости Бурь.‡A\'dal bittet Euch, Warpzweig in der Botanika in der Festung der Stürme zu töten.‡아달이 폭풍우 요새에 있는 신록의 정원에서 차원의 분리자를 처치해 달라고 했습니다.‡A\'dal te ha pedido que mates al disidente de distorsión en el Invernáculo de El Castillo de la Tempestad.‡A\'dal te ha pedido que mates al disidente de distorsión en el Invernáculo de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer Brise-Dimension à la Botanica, au Donjon de la Tempête.‡阿达尔要你前往风暴要塞，杀死生态船内的迁跃扭木。‡阿達歐要求你前往風暴要塞的波塔尼卡，殺掉扭曲分裂者。',
  }
},
[29670] = {
  {
    'Pancada do Gormal‡Расправа над Гормалом‡Tötet Gormal‡고르말 정복‡Aplasta a Gormal‡‡Démolir Gormal‡以暴制暴‡',
    nil,
    'Mate o Subjugador Gormal no Acampamento Gormal. Uma‡Убейте Поработителя Гормала в лагере Гормал.‡Tötet Unterwerfer Gormal im Lager Gormal.‡고르말 야영지에서 정복자 고르말을 처치해야 합니다. 레벨 10 비취 숲‡Mata al subyugador Gormal en el Campamento Gormal.‡‡Tuez le Subjugateur Gormal au Camp de Gormal.‡击败格玛尔营地的征服者格玛尔。‡',
  }
},
[29671] = {
  {
    '‡Черные топи‡Der Schwarze Morast‡검은늪‡La Ciénaga Negra‡La Ciénaga Negra‡Le Noir Marécage‡黑色沼泽‡黑色沼澤',
    nil,
    '‡Пройдите сквозь Пещеры Времени до Черных топей времен открытия Темного портала и поговорите с Са\'атом.‡Reist durch die Höhlen der Zeit in den Schwarzen Morast während der Öffnung des Dunklen Portals und sprecht mit Sa\'at.‡시간의 동굴을 통해, 어둠의 문이 열리는 검은늪으로 가서 사트와 대화해야 합니다.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Voyagez à travers les Grottes du temps jusqu\'au Noir Marécage pendant l\'ouverture de la Porte des ténèbres et parlez à Sa\'at.‡深入时光之穴，前往正在发生黑暗之门开启这一历史事件的黑色沼泽，与萨艾特谈一谈。‡',
  }
},
[29672] = {
  {
    '‡Открытие Темного портала‡Die Öffnung des Dunklen Portals‡어둠의 문 열기‡La apertura de El Portal Oscuro‡La apertura de El Portal Oscuro‡L\'ouverture de la Porte des ténèbres‡开启黑暗之门‡黑暗之門的開啟',
    nil,
    '‡Защищайте Медива, пока он не откроет Темный портал.|n|nКогда выполните задание, возвращайтесь к Са\'ату в Черные топи.‡Sa\'at im Schwarzen Morast der Höhlen der Zeit möchte, dass Ihr Medivh verteidigt, bis er das Dunkle Portal geöffnet hat.|n|nKehrt zu Sa\'at zurück, wenn Ihr erfolgreich wart.‡시간의 동굴, 검은늪 안에 있는 사트가 어둠의 문이 열릴 때까지 수호자 메디브를 보호하라는 임무를 주었습니다.|n|n임무에 성공하면 사트에게 가야 합니다.‡Sa\'at en la Ciénaga Negra de las Cavernas del Tiempo te ha encargado que defiendas a Medivh hasta que consiga abrir El Portal Oscuro.|n|nVuelve junto a Sa\'at si consigues completar esta tarea.‡Sa\'at en la Ciénaga Negra de las Cavernas del Tiempo te ha encargado que defiendas a Medivh hasta que consiga abrir El Portal Oscuro.|n|nVuelve junto a Sa\'at si consigues completar esta tarea.‡Sa\'at, à l\'intérieur du Noir Marécage des Grottes du temps, vous a demandé de défendre Medivh jusqu\'à ce qu\'il parvienne à ouvrir la Porte des ténèbres.|n|nRetournez voir Sa\'at si vous parvenez à accomplir cette tâche.‡时光之穴黑色沼泽的萨艾特要求你保护麦迪文，直到他成功开启黑暗之门。|n|n任务完成后向萨艾特复命。‡',
  }
},
[29673] = {
  {
    '‡Черные топи‡Der Schwarze Morast‡검은늪‡La Ciénaga Negra‡La Ciénaga Negra‡Le Noir Marécage‡黑色沼泽‡黑色沼澤',
    nil,
    '‡Пройдите сквозь Пещеры Времени до Черных топей времен открытия Темного портала и поговорите с Са\'атом.‡Reist durch die Höhlen der Zeit in den Schwarzen Morast während der Öffnung des Dunklen Portals und sprecht mit Sa\'at.‡시간의 동굴을 통해, 어둠의 문이 열리는 검은늪으로 가서 사트와 대화해야 합니다.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Voyagez à travers les Grottes du temps jusqu\'au Noir Marécage pendant l\'ouverture de la Porte des ténèbres et parlez à Sa\'at.‡深入时光之穴，前往正在发生黑暗之门开启这一历史事件的黑色沼泽，与萨艾特谈一谈。‡',
  }
},
[29674] = {
  {
    'Caos à solta‡Бездонная тьма‡Unbändige Dunkelheit‡속박 풀린 어둠‡Oscuridad desatada‡Oscuridad desatada‡Ténèbres déliées‡自由的黑暗‡無縛黑暗',
    nil,
    'A\'dal quer que você mate Zereketh, o Desatado, em Arcatraz, na Bastilha da Tormenta.‡А\'дал попросил вас убить Зерекета Бездонного в Аркатраце, в Крепости Бурь.‡A\'dal hat Euch gebeten, Zereketh den Unabhängigen in der Arcatraz der Festung der Stürme zu töten.‡아달이 폭풍우 요새의 알카트라즈에 있는 속박 풀린 제레케스를 처치해 달라고 했습니다.‡A\'dal te ha pedido que mates a Zereketh el Desatado en El Arcatraz del Castillo de la Tempestad.‡A\'dal te ha pedido que mates a Zereketh el Desatado en El Arcatraz de El Castillo de la Tempestad.‡A\'dal vous a demandé de tuer Zereketh le Délié dans l\'Arcatraz, au Donjon de la Tempête.‡阿达尔要求你前往风暴要塞，杀死禁魔监狱内自由的瑟雷凯斯。‡阿達歐要求你前往風暴要塞的亞克崔茲，殺掉無約束的希瑞奇斯。',
  }
},
[29675] = {
  {
    'Planos da Legião‡Пока, Даллия‡Zorn und Verdammnis‡소코드라테스와 달리아‡Hasta nunca, Dalliah‡Hasta nunca, Dalliah‡Dalliah-ah-ah-ah-ah‡等着吧达尔莉安‡嘿，達利亞',
    nil,
    'A\'dal quer que você mate o Iráugure Socótrates e Dalliah, a Agoureira, em Arcatraz, na Bastilha da Tormenta.‡А\'дал попросил вас убить Провидца Гнева Соккората и Даллию Глашатая Судьбы в Аркатраце, в Крепости Бурь.‡A\'dal bittet Euch, Zornseher Soccothrates und Dalliah die Verdammnisverkünderin in der Arcatraz der Festung der Stürme zu töten.‡아달이 폭풍우 요새의 알카트라즈에 있는 격노의 점술사 소코드라테스와 파멸의 예언자 달리아를 처치해 달라고 했습니다.‡A\'dal te ha pedido que mates al arúspice de cólera Soccothrates y a Dalliah la Oradora del Sino en El Arcatraz de El Castillo de la Tempestad.‡A\'dal te ha pedido que mates al arúspice de cólera Soccothrates y a Dalliah la Oradora del Sino en El Arcatraz de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer le Scrute-courroux Soccothrates et Dalliah l\'Auspice-Funeste à l’Arcatraz, au Donjon de la Tempête.‡阿达尔要你前往风暴要塞的禁魔监狱，杀死天怒预言者苏克拉底和末日预言者达尔莉安。‡阿達歐要求你前往風暴要塞的亞克崔茲，殺掉怒鐮者索寇斯瑞特與末日預言者達利亞。',
  }
},
[29676] = {
  {
    'Encontrando um velho amigo‡Поиски старого друга‡Einen alten Freund finden‡옛 친구 찾기‡En busca de un viejo amigo‡‡À la recherche d’un vieil ami‡寻找老朋友‡',
    nil,
    'Fale com o Velho Liang no Retiro de Liang, que fica nos Lagos Cantantes. Uma‡Поговорите со стариком Ляном в его пристанище у Поющих прудов.‡Sprecht mit dem alten Liang bei Liangs Refugium an den Singenden Teichen.‡노래하는 웅덩이 옆 리앙의 은거지에 있는 노인 리앙과 대화해야 합니다. 레벨 1 유랑도‡Habla con Liang el Viejo en el Retiro de Liang, en las Pozas Cantarinas.‡‡Parlez au Vieux Liang, à la Retraite de Liang, dans les Bassins Chantants.‡去咏之池和梁家小宅的梁老先生谈一谈。‡',
  }
},
[29677] = {
  {
    'A pérola do sol‡Солнечная жемчужина‡Die Sonnenperle‡태양 진주‡La perla del sol‡‡La perle du soleil‡炎阳珠‡',
    nil,
    'Recupere a Pérola do Sol. Uma‡Достаньте солнечную жемчужину.‡Findet die Sonnenperle.‡태양 진주를 손에 넣어야 합니다. 레벨 1 유랑도‡Encuentra la perla del sol.‡‡Récupérez la Perle du soleil.‡取回炎阳珠。‡',
  }
},
[29678] = {
  {
    'Shu, o espírito da água‡Шу, дух воды‡Shu, der Geist des Wassers‡물의 정령 슈‡Shu, el espíritu del agua‡‡Shu, l’esprit de l’eau‡上古水灵涓流‡',
    nil,
    'Chame Shu, o espírito da água, para brincar. Uma‡Выманите духа воды Шу, чтобы поиграть с ним.‡Überredet Shu, den Geist des Wassers, zu einem Spielchen.‡물의 정령 슈를 꾀어 놀이를 시작해야 합니다. 레벨 1 유랑도‡Anima a Shu, el espíritu del agua, a jugar contigo.‡‡Incitez Shu, l’esprit de l’eau, à venir jouer.‡吸引上古水灵涓流来玩游戏。‡',
  }
},
[29679] = {
  {
    'Um novo amigo‡Новый друг‡Ein neuer Freund‡새 친구‡Un nuevo amigo‡‡Un nouvel ami‡新朋友‡',
    nil,
    'Ande sobre a água e entre em 5 dos Jorros d’Água de Shu. Uma‡Поднимитесь на 5 фонтанов Шу.‡Wasserwandelt in 5 von Shus Wasserfontänen.‡슈의 물기둥이 있는 곳으로 5번 걸어가야 합니다. 레벨 1 유랑도‡Entra en 5 de los chorros de agua de Shu.‡‡Placez-vous dans 5 Jets d’eau de Shu.‡触碰涓流的水流喷涌5次。‡',
  }
},
[29680] = {
  {
    'A fonte de nosso sustento‡Источник жизненной силы‡Unsere Lebensgrundlage‡생계 수단‡Nuestro sustento‡‡La source de notre existence‡生计来源‡',
    nil,
    'Fale com Ji na Fazenda Dai-Lo. Há uma carroça à sua espera perto da estrada para levá-l&lt;o/a&gt; até lá. Uma‡Поговорите с Цзи на крестьянском дворе Дай-Ло. У дороги стоит повозка, готовая вас отвезти.‡Sprecht mit Ji auf dem Dai-Lo-Bauernhof. Ein Karren wartet nahe der Straße, um Euch dorthin zu bringen.‡다이로 농장에 있는 지와 대화해야 합니다. 레벨 1 유랑도‡Habla con Ji en la Granja de Dai-Lo. Cerca de la carretera hay un carro que espera para llevarte hasta allí.‡‡Parlez à Ji à la Ferme Dai-Lo. Un chariot vous attend près de la route pour vous y conduire.‡和大箩农场的季谈一谈。路边的牛车可以带你过去。‡',
  }
},
[29681] = {
  {
    'Fuga implacável‡Брешь в системе безопасности‡Ausbruch aus dem Hochsicherheitstrakt‡심각한 보안 문제‡Fallo de extrema seguridad‡Fallo de extrema seguridad‡Faille de haute sécurité‡监狱失守‡突破安管極限',
    nil,
    'A\'dal quer que você mate o Precursor Skiriss em Arcatraz, na Bastilha da Tormenta.‡А\'дал попросил вас убить предвестника Скайрисса в Аркатраце, в Крепости Бурь.‡A\'dal hat Euch gebeten, Herold Horizontiss in der Arcatraz der Festung der Stürme zu töten.‡아달이 폭풍우 요새의 알카트라즈에 있는 선구자 스키리스를 처치해 달라고 했습니다.‡A\'dal te ha pedido que mates al presagista Cieloriss en El Arcatraz de El Castillo de la Tempestad.‡A\'dal te ha pedido que mates al presagista Cieloriss en El Arcatraz de El Castillo de la Tempestad.‡A’dal vous a demandé de tuer le Messager Cieuriss à l’Arcatraz, au Donjon de la Tempête.‡阿达尔要你前往风暴要塞的禁魔监狱，杀死预言者斯克瑞斯。‡阿達歐要求你前往風暴要塞的亞克崔茲，殺掉先驅者史蓋力司。',
  }
},
[29682] = {
  {
    'Terraço dos Magísteres‡Терраса Магистров‡Terrasse der Magister‡마법학자의 정원‡El Bancal del Magister‡El Bancal del Magister‡La terrasse des Magistères‡魔导师平台‡博學者殿堂',
    nil,
    'O Capitão Theris Aurolar quer que você encontre o Exarca Larethor no Terraço dos Magísteres.‡Капитан Терис Рассветное Пламя хочет, чтобы вы отыскали экзарха Ларетора на Террасе Магистров.‡Hauptmann Theris Morgenheim möchte, dass Ihr Exarch Larethor in der Terrasse der Magister findet.‡대장 테리스 돈하스가 마법학자의 정원에서 총독 라레소르를 찾아 달라고 했습니다.‡El capitán Theris Albahogar quiere que encuentres al exarca Larethor en el interior del Bancal del Magister.‡El capitán Theris Albahogar quiere que encuentres al exarca Larethor en el interior del Bancal del Magister.‡Le Capitaine Theris Âtraurore vous a demandé de retrouver l’Exarque Larethor sur la Terrasse des Magistères.‡瑟里斯·黎明之心希望你找到在魔导师平台的主教拉雷索尔。‡塞里斯·曦爐上尉要你進入博學者殿堂找主教雷索爾。',
  }
},
[29683] = {
  {
    '‡Провидец Провидцев‡Der Seher der Seher‡점술가의 수정구‡El cristal de adivinación del arúspice‡El cristal de adivinación del arúspice‡Clairvoyance pour les Clairvoyants‡占星球‡',
    nil,
    '‡Тирит просит вас использовать шар на балконе Террасы Магистров.‡Tyrith möchte, dass Ihr die Kugel auf dem Balkon in der Terrasse der Magister benutzt.‡티리스가 마법학자의 정원 발코니에서 수정구를 사용해 달라고 했습니다.‡Tyrith quiere que uses el orbe en el balcón del Bancal del Magister.‡Tyrith quiere que uses el orbe en el balcón del Bancal del Magister.‡Tyrith veut que vous utilisiez l\'orbe sur le balcon de la Terrasse des Magistères.‡塔雷斯要求你使用魔导师平台内的阳台上的宝珠。‡',
  }
},
[29684] = {
  {
    'O infiltrado‡Обрыв связи‡Abgerissene Kommunikation‡연락 두절‡Incomunicado‡Incomunicado‡Communications interrompues‡联络中断‡中斷的通訊',
    nil,
    'O Exarca Larethor, no Terraço dos Magísteres, quer que você encontre Tyrith, um elfo sangrento espião.‡Экзарх Ларетор с Террасы Магистров хочет, чтобы вы отыскали Тирита, шпиона эльфов крови.‡Exarch Larethor in der Terrasse der Magister möchte, dass Ihr den Bluelfenspion Tyrith findet.‡마법학자의 정원 안에 있는 총독 라레소르가 블러드 엘프 첩보원인 티리스를 찾아봐 달라고 했습니다.‡El exarca Larethor, situado en el interior del Bancal del Magister, quiere que encuentres a Tyrith, un elfo de sangre espía.‡El exarca Larethor, situado en el interior del Bancal del Magister, quiere que encuentres a Tyrith, un elfo de sangre espía.‡L\'Exarque Larethor, sur la terrasse des Magistères, vous demande de trouver Tyrith, un espion elfe de sang.‡在魔导师平台的主教拉雷索尔希望你能找到血精灵间谍塔雷斯。‡博學者殿堂的主教雷索爾要你找出血精靈間諜提里斯。',
  }
},
[29685] = {
  {
    'Duro de matar‡Страшный противник‡Nicht totzukriegen‡어려운 상대‡Duro de matar‡Duro de matar‡Dur à cuire‡大难不死‡打不死的小強',
    nil,
    'Kalecgos quer que você derrote Kael\'thas no Terraço dos Magísteres. Pegue a cabeça de Kael e apresente-se novamente a Larethor no Terraço dos Magísteres.‡Калесгос попросил вас победить Кель\'таса на Террасе Магистров. Вы должны будете принести Ларетору на Террасе Магистров голову Келя.‡Kalecgos hat Euch damit beauftragt, Kael\'thas in der Terrasse der Magister zu bezwingen. Ihr sollt Euch mit Kaels Kopf bei Larethor in der Terrasse der Magister melden.‡칼렉고스가 마법학자의 정원에 있는 캘타스를 처치해 달라고 했습니다. 캘타스의 머리카락을 가지고 마법학자의 정원 안에 있는 총독 라레소르에게 보고해야 합니다.‡Kalecgos te ha pedido que derrotes a Kael\'thas en el Bancal del Magister. Coge la cabeza de Kael y preséntate ante Larethor en el interior del Bancal del Magister.‡Kalecgos te ha pedido que derrotes a Kael\'thas en el Bancal del Magister. Coge la cabeza de Kael y preséntate ante Larethor en el interior del Bancal del Magister.‡Kalecgos vous a demandé de vaincre Kael’thas sur la Terrasse des Magistères. Vous devez prendre sa tête et faire votre rapport à Larethor sur la Terrasse des Magistères.‡卡雷苟斯希望你击败魔导师平台的凯尔萨斯。你必须带着凯尔萨斯的徽记向魔导师平台的拉雷索尔复命。‡卡雷苟斯要求你擊敗博學者殿堂的凱爾薩斯。你要帶著凱爾薩斯的頭在博學者殿堂裡面向雷索爾回報。',
  }
},
[29686] = {
  {
    'Uma ideia radical‡Радикальный взгляд‡Eine radikale Idee‡끝내 주는 생각‡Una noción radical‡Una noción radical‡Une idée radicale‡激进思维‡根本信念',
    nil,
    'O Exarca Larethor, no Terraço dos Magísteres, quer que você mate Vexallus e obtenha a essência dele.‡Экзарх Ларетор с Террасы Магистров хочет, чтобы вы убили Вексалиуса и добыли его сущность.‡Exarch Larethor auf der Terrasse der Magister bittet Euch, Vexallus zu töten und seine Essenz an Euch zu bringen.‡마법학자의 정원에 있는 총독 라레소르가 벡살루스를 처치하고 그 정수를 가져와달라고 했습니다.‡El exarca Larethor del Bancal del Magister quiere que mates a Vexallus y obtengas su esencia.‡El exarca Larethor del Bancal del Magister quiere que mates a Vexallus y obtengas su esencia.‡L\'Exarque Larethor, sur la terrasse des Magistères, vous demande de tuer Vexallus et de vous procurer son essence.‡魔导师平台的主教拉雷索尔要你杀死维萨鲁斯，获取它的精华。‡博學者殿堂的主教雷索爾要你殺死維克索魯斯，取得它的精華。',
  }
},
[29687] = {
  {
    'Ligações perigosas‡Порочные связи‡Dunkle Allianzen‡뒤틀린 유대 관계‡Pactos maquiavélicos‡Pactos maquiavélicos‡Alliances contre nature‡扭曲的盟友‡邪惡的結合',
    nil,
    'O Exarca Larethor, no Terraço dos Magísteres, quer que você mate Serin Flamicórdio e a Sacerdotisa Delrissa.‡Экзарх Ларетор с Террасы Магистров хочет, чтобы вы убили Селина Огненное Сердце и жрицу Делриссу.‡Exarch Larethor in der Terrasse der Magister möchte, dass Ihr Selin Feuerherz und Priesterin Delrissa tötet.‡마법학자의 정원에 있는 총독 라레소르가 셀린 파이어하트와 여사제 델리사를 처치해 달라고 했습니다.‡El exarca Larethor en el Bancal del Magister quiere que mates a Selin Corazón de Fuego y a la sacerdotisa Delrissa.‡El exarca Larethor en el Bancal del Magister quiere que mates a Selin Corazón de Fuego y a la sacerdotisa Delrissa.‡L\'Exarque Larethor, sur la terrasse des Magistères, vous demande de tuer Selin Cœur-de-Feu et la Prêtresse Delrissa.‡魔导师平台的主教拉雷索尔要你杀死塞林·火心和女祭司德莉希亚。‡博學者殿堂的主教雷索爾要你殺死賽林·炎心與女牧師戴利莎。',
  }
},
[29688] = {
  {
    'Avança a campanha‡Переход в наступление‡Fortführung der Kampagne‡작전 전개‡Adelantar la campaña‡Adelantar la campaña‡La campagne progresse‡再踏征途‡戰況逼近',
    nil,
    'O Caçador Sombrio Ty\'jin quer que você fale com o Guarda Pétreo Stok\'ton nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Темный охотник Туджин приказал вам обратиться к каменному стражу Сток\'тону, который находится в Разрушенных залах в Цитадели Адского Пламени.‡Schattenjäger Ty\'jin hat Euch gebeten, mit Steingardist Stok\'ton in den Zerschmetterten Hallen der Höllenfeuerzitadelle zu sprechen.‡지옥불 성채, 으스러진 손의 전당에 있는 투사 스톡톤과 대화해야 합니다.‡El cazador de las Sombras Ty\'jin te ha pedido que hables con el guardia de piedra Stok\'ton en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡El cazador de las Sombras Ty\'jin te ha pedido que hables con el guardia de piedra Stok\'ton en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Le Chasseur des ombres Ty’jin vous a demandé de parler au Garde de pierre Stok’ton dans les Salles Brisées, dans la Citadelle des Flammes infernales.‡暗影猎手塔金想要你和地狱火城墙破碎大厅内的石头守卫斯托克顿谈一谈。‡影子獵人泰巾要你去和地獄火堡壘內破碎大廳的石衛士史托克頓說話。',
  }
},
[29689] = {
  {
    'Avança a campanha‡Переход в наступление‡Fortführung der Kampagne‡작전 전개‡Adelantar la campaña‡Adelantar la campaña‡La campagne progresse‡再踏征途‡戰況逼近',
    nil,
    'O Comandante-chefe Danath Matatroll quer que você fale com o Batedor Avançado Chagas nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Командир армии Данат Троллебой приказал вам поговорить с главным разведчиком Чадвиком, который находится в Разрушенных залах в Цитадели Адского Пламени.‡Truppenkommandant Danath Trollbann hat Euch gebeten, mit Vorhutsspäher Chadwick in den Zerschmetterten Hallen der Höllenfeuerzitadelle zu sprechen.‡지옥불 성채, 으스러진 손의 전당에 있는 전위 정찰병 채드윅과 대화해야 합니다.‡El comandante en jefe Danath Aterratrols te ha pedido que hables con el explorador táctico Chadwick en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡El comandante en jefe Danath Aterratrols te ha pedido que hables con el explorador táctico Chadwick en el interior de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Le Commandant de corps Danath Trollemort vous a demandé de parler à l’Éclaireur avancé Chadwick dans les salles Brisées, dans la Citadelle des Flammes infernales.‡远征军指挥官达纳斯·托尔贝恩要求你和地狱火城墙破碎大厅内的高级斥候卡德维克谈一谈。‡軍隊指揮官達納斯·托爾貝恩要你去地獄火堡壘的破碎大廳找先遣斥侯查德威克交談。',
  }
},
[29690] = {
  {
    'Brumas adentro‡Сквозь туман‡In den Nebel‡안개 속으로‡Entre la niebla‡‡Dans les brumes‡深入迷雾‡',
    nil,
    'Fale com o General Nazgrim no Punho de Grito Infernal. Uma‡Поговорите с генералом Назгримом на борту "Кулака Адского Крика".‡Sprecht mit General Nazgrim auf Höllschreis Faust.‡헬스크림의 철권호에 있는 장군 나즈그림과 대화해야 합니다. 레벨 10 오그리마‡Habla con el general Nazgrim en el Puño de Grito Infernal.‡‡Parlez au Général Nazgrim au Poing de Hurlenfer.‡和地狱咆哮之拳的纳兹戈林将军谈一谈。‡',
  }
},
[29691] = {
  {
    'Traga-me um canteiro de arbusto!‡Принеси мне клумбу!‡Bringt mir ein Gebüsch!‡내게 핏빛 불상화를!‡¡Tráeme una mata!‡¡Tráeme una mata!‡Rapportez-moi un jardinet !‡我要红色木槿！‡給我木槿花!',
    nil,
    'Colete 5 Hibiscos Sanguíneos e entregue-os a T\'shu no Brejo Oculto.‡Соберите 5 цветков кровавого гибискуса и принесите их Тшу в Нижетопь.‡Sammelt 5 Bluthibisken und kehrt zu T\'shu im Tiefensumpf zurück.‡지하수렁에 있는 트슈에게 핏빛 불상화 5개를 가져가야 합니다.‡Recoge 5 hibiscos sanguinos y entrégaselos a T\'shu en La Sotiénaga.‡Recoge 5 hibiscos sanguinos y entrégaselos a T\'shu en La Sotiénaga.‡Récupérez 5 Hibiscus sanguins et rapportez-les à T’shu dans la Basse-Tourbière.‡收集5朵红色木槿，交给幽暗沼泽的塔苏。‡收集5朵血紅木槿，交給深幽泥沼的塔蘇。',
  }
},
[29692] = {
  {
    'Traga-me outro canteiro de arbusto!‡Принеси мне еще одну клумбу!‡Bringt mir ein weiteres Gebüsch!‡내게 핏빛 불상화를 더!‡¡Tráeme otra mata!‡¡Tráeme otra mata!‡Rapportez-moi un autre jardinet !‡我还要红色木槿！‡再給我木槿花!',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[29693] = {
  {
    'O gume do General‡Топор генерала‡Die Axt des Generals‡장군의 목숨‡El filo del General‡‡La lame du général‡‡',
    nil,
    'Leve o Machado de Nazgrim para o General Nazgrim. Uma‡Отнесите топор Назгрима генералу Назгриму.‡Bringt General Nazgrim seine Axt.‡나즈그림의 도끼를 장군 나즈그림에게 가져가야 합니다. 레벨 10 비취 숲‡Devuelve el hacha de Nazgrim al general Nazgrim.‡‡Rapportez la Hache de Nazgrim au Général Nazgrim.‡‡',
  }
},
[29694] = {
  {
    'Reagrupar!‡Перегруппировка!‡Neu formieren!‡재집결하라!‡¡Reagrupaos!‡‡On se regroupe !‡重组！‡',
    nil,
    'Resgate a Mestressombra Kiryn, Pinno Estalagarra, Shokia e o Sargento Gorrok na Clareira do Mel. Uma‡Спасите Темного мастера Кирин, Риветта Сталехвата, Шокию и сержанта Горрока с Поляны Медовой Росы.‡Rettet Schattenmeisterin Kiryn, Nieti Kuppelplopp, Shokia und Unteroffizier Gorrok aus der Honigtaulichtung.‡꿀이슬 숲에서 그늘지배자 키린, 리벳 클러치팝, 쇼키아, 하사관 고로크를 구출해야 합니다. 레벨 10 비취 숲‡Rescata a la maestra tétrica Kiryn, a Perno Rompemarchas, a Shokia y al sargento Gorrok en el Claro Almíbar.‡‡Secourez la Maîtresse de l’Ombre Kiryn, Rivett Popembraye, Shokia et le Sergent Gorrok dans la Clairière de Rosée-de-Miel.‡从蜜露林地营救出匿踪大师琪麟、利维特·急刹、夏琪亚和格罗克中士。‡',
  }
},
[29695] = {
  {
    'Rastreamento Kiryn‡Выслеживание Кирин‡Kiryn-Verfolgung‡키린 추적‡Kiryn TRACKING‡‡Suivi Kiryn‡琪麟追踪‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[29696] = {
  {
    'Minhas estrelas!‡Мои звездочки!‡Meine Sterne!‡별은 네 가슴에‡¡Mis estrellas!‡‡Mes étoiles !‡‡',
    nil,
    'Recupere 100 Estrelas de Arremesso de Kiryn das mãos dos Duendes da Floresta Encapetados. Uma‡Отнимите 100 метательных звезд Кирин у коварных лесных духов.‡Sammelt 100 von Kiryns Wurfsternen von verschlagenen Waldgeistern.‡약삭빠른 나무 요마에게서 키린의 투척용 별표창 100개를 모아야 합니다. 레벨 10 비취 숲‡Recoge 100 estrellas arrojadizas de Kiryn de los duendes del bosque taimados.‡‡Reprenez 100 Étoiles de lancer de Kiryn des mains des Lutins des bois sournois.‡‡',
  }
},
