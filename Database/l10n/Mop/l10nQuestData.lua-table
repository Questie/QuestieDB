},
[411] = {
  {
    'A volta do Lich pródigo‡Возвращение блудного лича‡Die Rückkehr des abtrünnigen Lichs‡회개한 마술사의 귀환‡El regreso del exánime pródigo‡El regreso del exánime pródigo‡Le retour de la liche prodigue‡巫妖归顺‡巫妖歸順',
    nil,
    'Leve a Gema Etérea para Boanerges Stalactus na Cidade Baixa.‡Отнесите самоцвет Пустоты Бетору Ледострелу в Подгород.‡Bringt den Netheredelstein zu Bethor Eismacht nach Unterstadt.‡언더시티에 있는 베소르 아이스샤드에게 지옥의 보석을 가져가야 합니다.‡Llévale la gema abisal a Bethor Duroyelo en Entrañas.‡Llévale la gema abisal a Bethor Duroyelo en Entrañas.‡Apportez la Gemme du Néant à Bethor Glacéclat à Fossoyeuse.‡将虚空宝石交给幽暗城的比索·埃斯沙德。‡將虛空寶石交給幽暗城的比索·埃斯沙德。',
  }
},
[412] = {
  {
    'Operação remendão‡Операция "Перенаправление"‡Operation Rekombobulationsgerät‡작전명 재결합‡Operación Recombobulación‡Operación Recombobulación‡Opération Recombobulation‡自动净化装置‡整裝待發',
    nil,
    'Entregue 8 Equipamentos Giromecânicos para Razzle Molavivaz.‡Принесите Раззлу Шустрецу 8 гиромеханических шестерней.‡Bringt Razzle Flinkspross 8 gyromechanische Getriebeteile.‡라즐 스프리스프로켓에게 자이로 기어 8개를 가져가야 합니다.‡Lleva 8 engranajes giromecánicos a Razzle Engranágil.‡Lleva 8 engranajes giromecánicos a Razzle Engranágil.‡Apportez 8 Engrenages gyromécaniques à Esbrouf Fulgurouage.‡收集8个多档齿轮，把它们交给卡拉诺斯的拉兹·滑链。‡收集8個協動齒輪，把它們交給卡拉諾斯的拉索·滑鏈。',
  }
},
[413] = {
  {
    'Cerveja Tremeluz‡Мерцающий портер‡Schimmerstarkbier‡아지랑이 스타우트 맥주‡Cerveza negra Brillante‡Cerveza negra Brillante‡La Brune scintillante‡微光酒‡微光酒',
    nil,
    'Entregue o Barril de Cerveja Tremeluz para o Montanhista Cervevada.‡Отнесите бочонок "Мерцающего портера" горному пехотинцу Ячменовару.‡Bringt das Fass mit Schimmerstarkbier zu Gebirgsjäger Gerstenbräu.‡산악경비대 발리브루에게 아지랑이 스타우트 맥주통을 가져가야 합니다.‡Lleva la barrica de cerveza negra Brillante al montaraz Cebadiz.‡Lleva el tonel de cerveza negra Brillante al montaraz Cebadiz.‡Amener le Tonneau de Brune scintillante au Montagnard Brasselorge.‡把这一大桶微光酒交给巡山人维拉特·麦酒。‡把這一大桶微光酒交給巡山人維拉特·麥酒。',
  }
},
[414] = {
  {
    'Cerveja para Kadrell‡Портер для Кэдрелла‡Starkbier für Kadrell‡카드렐에게 맥주 배달하기‡Cerveza negra para Kadrell‡Cerveza negra para Kadrell‡Une bière brune pour Kadrell‡卡德雷尔的酒‡給卡德雷爾的酒',
    nil,
    'Entregue o Barril de Cerveja Tremeluz para o Montanhista Kadrell.‡Отнести бочонок "Мерцающего портера" горному пехотинцу Кэдреллу.‡Bringt das Fässlein mit Schimmerstarkbier zu Gebirgsjäger Kadrell.‡산악경비대 카드렐에게 아지랑이 스타우트 맥주통을 가져가야 합니다.‡Lleva el tonel de cerveza negra Brillante al montaraz Kadrell.‡Lleva el tonel de cerveza negra Brillante al montaraz Kadrell.‡Portez le Fût de Brune scintillante au Montagnard Kadrell.‡把这桶微光酒带给巡山人卡德雷尔。‡把這桶微光酒帶給巡山人卡德雷爾。',
  }
},
[415] = {
  {
    'A nova cerveja do Rejold‡Новое пиво Регольда‡Rejolds neues Gebräu‡레욜트의 새 술‡La nueva bebida de Rejold‡La nueva bebida de Rejold‡La nouvelle cuvée de Rejold‡雷杰德的新酒‡雷傑德的新酒',
    nil,
    'Fale com Rejold Cervevada.‡Поговорите с Регольдом Ячменоваром.‡Sprecht mit Rejold Gerstenbräu.‡레욜트 발리브루와 대화해야 합니다.‡Habla con Rejold Cebadiz.‡Habla con Rejold Cebadiz.‡Parler à Rejold Brasselorge.‡和雷杰德·麦酒谈一谈。‡和雷傑德·麥酒談話。',
  }
},
[416] = {
  {
    'Caça ao rato‡Ловля крыс‡Rattenfang‡코볼트 사냥‡Mata ratas‡Mata ratas‡Chasse au rat‡狗头人的耳朵‡補鼠行動',
    nil,
    'Bring 8 Tunnel Rat Ears to Mountaineer Stormpike in Algaz Station.‡Принесите 8 ушей туннельщиков горному пехотинцу Грозовой Вершине на станцию Альгаз.‡Bringt Gebirgsjäger Sturmlanze an der Station Algaz 8 Tunnelrattenohren.‡알가즈 주둔지에 있는 산악경비대 스톰파이크에게 동굴쥐 귀걸이 8개를 가져가야 합니다.‡Lleva 8 orejas de rata de túnel al montaraz Pico Tormenta a Thelsamar.‡Lleva 8 orejas de rata de túnel al montaraz Pico Tormenta a Thelsamar.‡Apportez 8 Oreilles de Rat des tunnels au Montagnard Foudrepique, au Poste d\'Algaz.‡收集8只坑道鼠的耳朵，把它们带给塞尔萨玛的巡山人卡德雷尔。‡收集12只坑道鼠的耳朵，把它們帶給奧加茲崗哨的巡山人雷矛。',
  }
},
[417] = {
  {
    '‡Месть пилота‡Pilotenrache‡조종사의 복수‡Vengar al piloto‡Vengar al piloto‡La revanche du pilote‡驾驶员的复仇‡',
    nil,
    '‡Убейте Паршивого Когтя.|n|nПринесите его коготь и журнал Хилдельва пилоту Большеногу.‡Tötet Marterklaue.|n|nBringt Pilot Hammerfuß am Südtoraußenposten die räudige Klaue des Bären und Hangflugs Tagebuch.‡‡Mata a Sarnagarra.|n|nLleva su garra sarnosa y el diario de Hildelve al piloto Podomartillo en la Avanzada de la Puerta Sur.‡Mata a Sarnagarra.|n|nLleva su garra sarnosa y el diario de Hildelve al piloto Podomartillo en la Avanzada de la Puerta Sur.‡Tuez Griffe galeuse.|n|nRapportez la griffe à laquelle il doit son nom et le Journal de Hildelve au pilote Martèlepied, à l\'Avant-poste de la Porte sud.‡杀死癞爪。|n|n把它的肮脏的爪子和莫里·铁钻的日记交给驾驶员塞克·锤足。‡',
  }
},
[418] = {
  {
    'Chouriço de Thelsamar‡Телcамарские кровяные колбаски‡Blutwurst aus Thelsamar‡텔사마 선지 소시지‡Morcillas de Thelsamar‡Morcillas de Thelsamar‡Les boudins de Thelsamar‡塞尔萨玛血肠‡塞爾薩瑪血腸',
    nil,
    'Bring 8 pieces of Bear Meat to Vidra Hearthstove in Thelsamar.‡Принесите Видре Жаркий Очаг в Телcамар 8 кусков медвежатины.‡Bringt Vidra Ofenglut in Thelsamar 8 Stück Bärenfleisch.‡텔사마에 있는 비드라 하스스토브가 곰 엉덩잇살 8개를 가져다 달라고 했습니다.‡Lleva 8 trozos de carne de oso a Vidra Hogartufa, en Thelsamar.‡Lleva 8 trozos de carne de oso a Vidra Hogartufa, en Thelsamar.‡Apportez 8 morceaux de Viande d’ours à Vidra Poêlâtre à Thelsamar.‡收集8块熊肉，把它们交给塞尔萨玛的维德拉·壁炉。‡收集8塊熊肉並交給塞爾薩瑪的維德拉‧壁爐。',
  }
},
[419] = {
  {
    '‡Пропавший пилот‡Der vermisste Pilot‡실종된 조종사‡El piloto perdido‡El piloto perdido‡Le pilote perdu‡失踪的驾驶员‡',
    nil,
    '‡Найдите пилота Хилдельва.‡Pilot Hammerfuß am Südtoraußenposten möchte, dass Ihr den Piloten Hügelflug findet.‡‡El piloto Podomartillo, en la Avanzada de la Puerta Sur, quiere que encuentres al piloto Hildelve.‡El piloto Podomartillo, en la Avanzada de la Puerta Sur, quiere que encuentres al piloto Hildelve.‡Le pilote Martèlepied, à l’Avant-poste de la porte Sud, veut que vous retrouviez le pilote Hildelve.‡找到驾驶员莫里·铁钻。‡',
  }
},
[420] = {
  {
    '‡Наблюдения Сенира‡Senirs Beobachtungen‡‡Las observaciones de Senir‡Las observaciones de Senir‡Les observations de Senir‡森内尔的观察站‡',
    nil,
    '‡Доставьте донесение Грелина Сениру Белобороду в Караносе.‡Überbringt Senir Weißbart in Kharanos Grelins Bericht.‡‡Lleva el informe de Grelin a Senir Barbablanca a Kharanos.‡Lleva el informe de Grelin a Senir Barbablanca a Kharanos.‡Apporter le rapport de Grelin à Senir Blanchebarbe à Kharanos.‡把格瑞林的报告交给卡拉诺斯的森内尔·白须。‡',
  }
},
[421] = {
  {
    'Prove seu valor‡Проявить себя‡Wertbeweis‡실력 검증‡Demuestra tu valía‡Demuestra tu valía‡Prouver votre valeur‡证明你的价值‡證明你的價值',
    nil,
    'Dalar Tessalba, do Sepulcro, quer que você mate 5 Grenhalvas Lunafúria.‡Далар Ткач Рассвета из Гробницы хочет, чтобы вы убили 5 белоголовов Лунной Ярости.‡Dalar Morgenweber auf dem Grabmal will, dass Ihr 5 Weißskalps des Mondzorns tötet.‡공동묘지에 있는 달라 돈위버가 달분노 백발전사 5마리를 처치해 달라고 했습니다.‡Dalar Tejealba en El Sepulcro quiere que mates a 5 canosos Furia Lunar.‡Dalar Tejealba en El Sepulcro quiere que mates a 5 canosos Furia Lunar.‡Tuer 5 Poils-blancs Ragelune pour Dalar Tisselaube au Sépulcre.‡瑟伯切尔的达拉尔·道恩维沃尔要求你杀死5只月怒白头狼人。‡瑟伯切爾的達拉爾·織曦者要求你殺死5隻月怒白頭狼人。',
  }
},
[422] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡阿魯高的愚行',
    nil,
    'Recupere o Remédio de Arugal para Dalar Tessalba, do Sepulcro.‡Раздобудьте книгу "Зелье Аругала" и принесите ее Далару Ткачу Рассвета в Гробницу.‡Beschafft Dalar Morgenweber auf dem Grabmal die Arznei des Arugal.‡공동묘지에 있는 달라 돈위버를 위해 아루갈의 치료법을 구해야 합니다.‡Recupera el Remedio de Arugal para Dalar Tejealba, en El Sepulcro.‡Recupera el Remedio de Arugal para Dalar Tejealba, en El Sepulcro.‡Retrouver le Remède d\'Arugal pour Dalar Tisselaube au Sépulcre.‡为瑟伯切尔的达拉尔·道恩维沃尔找回《阿鲁高的拯救》。‡為瑟伯切爾的達拉爾·織曦者找回《阿魯高的拯救》。',
  }
},
[423] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡阿魯高的愚行',
    nil,
    'Leve 6 Grilhões de Glutão e 3 Grilhões Almanegra para Dalar Tessalba, no Sepulcro.‡Принесите Далару Ткачу Рассвета в Гробницу 6 наручей обжор Лунной Ярости и 3 наруча чернозлобов Лунной Ярости.‡Bringt Dalar Morgenweber am Grabmal 6 Nimmersattfesseln und 3 Dunkelseelenfesseln.‡공동묘지에 있는 달라 돈위버에게 광신도의 족쇄 6개와 검은영혼의 족쇄 3개를 가져가야 합니다.‡Lleva 6 grilletes de glotón y 3 grilletes de almanegra a Dalar Tejealba en El Sepulcro.‡Lleva 6 grilletes de glotón y 3 grilletes de almanegra a Dalar Tejealba en El Sepulcro.‡Rapportez 6 Bracelets de Gloutons et 3 Bracelets de Ténébreux à Dalar Tisselaube au Sépulcre.‡给瑟伯切尔的达拉尔·道恩维沃尔带回6副暴食者镣铐和3副魔魂镣铐。‡給瑟伯切爾的達拉爾·織曦者帶回6副暴食者鐐銬和3副黑暗之魂鐐銬。',
  }
},
[424] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡阿魯高的愚行',
    nil,
    'Mate Severo, o Pálido, e leve sua cabeça para Dalar Tessalba no Sepulcro.‡Убейте Мрачнона Белесого и принесите его голову Далару Ткачу Рассвета в Гробницу.‡Tötet Grimson den Blassen und bringt seinen Kopf zu Dalar Morgenweber beim Grabmal.‡은빛갈기 그림슨을 처치하고 그의 해골을 공동묘지에 있는 달라 돈위버에게 가져가야 합니다.‡Mata a Grimson el Pálido y lleva su cabeza a Dalar Tejealba en El Sepulcro.‡Mata a Grimson el Pálido y lleva su cabeza a Dalar Tejealba en El Sepulcro.‡Tuer Grimson le Pâle et rapporter sa tête à Dalar Tisselaube au Sépulcre.‡杀死白毛狼人格瑞姆森，把他的头带给瑟伯切尔的达拉尔·道恩维沃尔。‡殺死蒼白的格瑞姆森，把他的頭帶給瑟伯切爾的達拉爾·織曦者。',
  }
},
[425] = {
  {
    '‡Ивар Нечистый‡Ivar der Verfaulte‡포악한 이바르‡Ivar el Hediondo‡Ivar el Hediondo‡Ivar l\'Infect‡邪恶的伊瓦‡邪惡的伊瓦',
    nil,
    '‡Убейте Ивара Нечистого и принесите его голову Ран Йорик на делянку Ивара.‡Tötet Ivar den Verfaulten und bringt Ivars Kopf zu Rane Yorick auf dem Ivarfeld.‡‡Mata a Ivar el Hediondo y lleva la cabeza de Ivar a Rane Yorick en Los Dominios de Ivar.‡Mata a Ivar el Hediondo y lleva la cabeza de Ivar a Rane Yorick en Los Dominios de Ivar.‡Tuer Ivar l\'Infect et ramener sa tête à Rane Yorick au lopin d\'Ivar.‡杀死邪恶的伊瓦，并将伊瓦的头颅带给伊瓦农庄的兰妮·尤瑞克。‡',
  }
},
[426] = {
  {
    'Os moinhos invadidos‡Нападение на мельницы‡Die überrannte Mühle‡제분소 습격‡La invasión de los molinos‡La invasión de los molinos‡La chute des moulins‡磨坊告急‡磨坊告急',
    nil,
    'Colete 5 Costelas Carcomidas e 3 Crânios Enegrecidos, depois fale novamente com o Necroguarda Dinis em Montalvo.‡Соберите 5 зазубренных ребер и 3 почерневших черепа для стража смерти Диллинджера в Брилле.‡Sammelt 5 schartige Rippen sowie 3 geschwärzte Schädel und kehrt dann zu Todeswache Dillinger nach Brill zurück.‡톱니모양 늑골 5개와 저주받은 해골 3개를 모은 다음 브릴에 있는 죽음경비병 딜링거에게 가야 합니다.‡Recoge 5 costillas con cortes y 3 calaveras ennegrecidas, y después regresa ente el Guardia de la Muerte Dillinger de Rémol.‡Recoge 5 costillas con cortes y 3 calaveras ennegrecidas, y después regresa ente el Guardia de la Muerte Dillinger de Rémol.‡Rassemblez 5 Côtes ébréchées et 3 Crânes noircis et rapportez-les au Nécrogarde Dillinger à Brill.‡收集5根锯齿肋骨和3个焦黑的徽记，然后向布瑞尔的亡灵卫兵迪林格尔回报。‡收集5根凹槽肋骨和3個焦黑的顱骨，然後向布瑞爾的亡靈衛兵迪林格爾回報。',
  }
},
[427] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Im Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano, de Montalvo, quer que você mate 10 Guerreiros Escarlates.‡Убейте 10 воинов из Алого ордена по просьбе вершителя Зуганда.‡Exekutor Zygand von Brill verlangt, dass Ihr 10 Scharlachrote Krieger tötet.‡브릴에 있는 집행관 자이건드가 붉은십자군 전사 10명을 처치해 달라고 했습니다.‡El ejecutor Zygand de Rémol quiere que mates a 10 guerreros Escarlata.‡El ejecutor Zygand de Rémol quiere que mates a 10 guerreros Escarlata.‡L\'Exécuteur Zygand, à Brill, veut que vous tuiez 10 Guerriers écarlates.‡布瑞尔的执行官塞加德要求你杀掉10名血色战士。‡布瑞爾的執行官塞加德要求你去殺掉10名血色十字軍戰士。',
  }
},
[428] = {
  {
    'Sicários perdidos‡Пропавшие стражи смерти‡Die verlorenen Todespirscher‡실종된 죽음추적자‡Los Mortacechadores desaparecidos‡Los Mortacechadores desaparecidos‡Les nécrotraqueurs égarés‡失踪的亡灵哨兵‡失蹤的亡靈哨兵',
    nil,
    'Encontre os Sicários Quintino e Rane Yorick.‡Найдите стражей смерти Квинна Йорика и Ран Йорик.‡Findet die Todespirscher Quinn und Rane Yorick.‡죽음추적자 퀸 요릭과 레인 요릭을 찾아야 합니다.‡Encuentra a los Mortacechadores Quinn y Rane Yorick.‡Encuentra a los Mortacechadores Quinn y Rane Yorick.‡Trouver les Nécrotraqueurs Quinn et Rane Yorick.‡找到亡灵哨兵兰妮·尤瑞克和奎恩·尤瑞克。‡找到亡靈哨兵蘭妮·尤瑞克和奎恩·尤瑞克。',
  }
},
[429] = {
  {
    'Corações selvagens‡Звериные сердца‡Wilde Herzen‡늑대의 심장‡Corazones salvajes‡Corazones salvajes‡Cœurs sauvages‡荒野之心‡荒野之心',
    nil,
    'Junte 6 Corações Descoloridos de Worg e leve-os para o Boticário Renferrel no Sepulcro.‡Соберите 6 обесцвеченных сердец ворга и принесите их аптекарю Ренферрелу в Гробницу.‡Sammelt 6 verfärbte Worgherzen und bringt sie zu Apotheker Renferrel auf dem Grabmal.‡변색된 검은늑대 심장 6개를 모아 공동묘지에 있는 연금술사 렌퍼럴에게 가져가야 합니다.‡Consigue 6 corazones de huargo descoloridos y llévaselos al boticario Renferrel en El Sepulcro.‡Consigue 6 corazones de huargo descoloridos y llévaselos al boticario Renferrel en El Sepulcro.‡Recueillir six Cœurs de worg et les apporter à l\'Apothicaire Renferrel au Sépulcre.‡收集6颗变色的狼心，把它们交给瑟伯切尔的药剂师伦弗利尔。‡收集6顆變色的狼心，把它們交給瑟伯切爾的藥劑師倫弗利爾。',
  }
},
[430] = {
  {
    'Reencontrando Quintino‡Назад к Квинну‡Rückkehr zu Quinn‡퀸에게 돌아가기‡Regresa junto a Quinn‡Regresa junto a Quinn‡Retour vers Quinn‡回到奎恩身旁‡回到奎恩身旁',
    nil,
    'Leve a poção para Quintino Yorick na Plantação do Ivar, ao norte do Sepulcro.‡Отнесите зелье Квинна Квинну Йорику на делянку Ивара, к северу от Гробницы.‡Bringt Quinn Yorick auf dem Ivarfeld, nördlich des Grabmals, Quinns Trank.‡공동묘지 북쪽의 이바르 호박밭에 있는 퀸 요릭에게 퀸의 물약을 가져가야 합니다.‡Lleva la poción de Quinn a Quinn Yorick en Los Dominios de Ivar, al norte de El Sepulcro.‡Lleva la poción de Quinn a Quinn Yorick en Los Dominios de Ivar, al norte de El Sepulcro.‡Apporter le remède à Quinn Yorick au lopin d\'Ivar, au nord du Sépulcre.‡将奎恩的药水带给瑟伯切尔北方伊瓦农场的奎恩·尤瑞克。‡將奎恩的藥水帶給瑟伯切爾北方伊瓦農場的奎恩·尤瑞克。',
  }
},
[431] = {
  {
    '‡Манящие свечи‡Kerze des Heranlockens‡‡Velas de señalización‡Velas de señalización‡Bougies de signal‡诱灵蜡烛‡',
    nil,
    nil,
  }
},
[432] = {
  {
    'Malditos troggs!‡Проклятые трогги!‡Diese verfluchten Troggs!‡저주받을 트로그‡¡Malditos troggs!‡¡Malditos troggs!‡Ces satanés troggs !‡该死的穴居人！‡該死的穴居怪!',
    nil,
    'Mate 8 Batecrânios Pedraqueixo e 8 Quebraossos Pedraqueixo na Pedreira e na Mina de Gol\'Bolar.‡Убейте 8 головоломов из племени Каменной Челюсти и 8 костегрызов из племени Каменной Челюсти в карьере Гол\'Болар.‡Tötet im Steinbruch von Gol\'Bolar und in der Mine 8 Schädelhauer der Felsenkiefertroggs und 8 Knochenknacker der Felsenkiefertroggs.‡골볼라 채석장과 광산에서 바위턱 망치잡이 8마리와 바위턱 뼈다귀싸움꾼 8마리를 처치해야 합니다.‡Mata a 8 aplastacráneos Comepiedras y a 8 cascahuesos Comepiedras en la Cantera de Gol\'Bolar o en la mina.‡Mata a 8 aplastacráneos Comepiedras y a 8 cascahuesos Comepiedras en la Cantera de Gol\'Bolar o en la mina.‡Tuez 8 Brise-crânes mâcherocs et 8 Briseurs d’os mâcherocs à la Carrière de Gol\'Bolar et dans sa mine.‡在古博拉采掘场和矿洞里击败8个石腭击颅者和8个石腭断骨者。‡在古博拉採掘場裡殺死8個石齶擊顱者和8個石齶斷骨者。',
  }
},
[433] = {
  {
    'O funcionário público‡Слуга народа‡Im Dienste des Volkes‡공무 수행‡El servidor público‡El servidor público‡Le serviteur public‡公众之仆‡公僕',
    nil,
    'Distribua as Runas de Retorno para 7 Mineradores Aprisionados na mina da Pedreira Gol\'Bolar.‡Раздайте руны возвращения 7 захваченным шахтерам в карьере Гол\'Болар.‡Verteilt Runen der Rückkehr an 7 gefangene Minenarbeiter in der Gol\'Bolarmine.‡복귀의 룬을 골볼라 채석장에 있는 갇혀 있는 광부 7명에게 나눠줘야 합니다.‡Reparte 7 runas de retorno a los mineros atrapados en la Cantera de Gol\'Bolar.‡Reparte 7 runas de retorno a los mineros atrapados en la Cantera de Gol\'Bolar.‡Distribuez des Runes de retour à 7 Mineurs piégés dans la Mine de la carrière de Gol\'Bolar.‡向古博拉采掘场里的7名被困住的矿工发放回归符文。‡到古博拉採掘場裡去，將返回符文交給7名受困的礦工。',
  }
},
[434] = {
  {
    'O ataque!‡Нападение!‡Der Angriff!‡공격!‡El ataque‡El ataque‡L\'attaque !‡伏击！‡伏擊!',
    nil,
    'Fiquei no jardim até que Lorde Gregor Lescobar e Marzon, a Lâmina Silente conversem. Depois, mate ambos antes de falar novamente com Elling Trias em Ventobravo.‡Спрячьтесь в саду и подслушайте разговор лорда Грегора Лесковара и Марзона Бесшумного Клинка. После этого убейте обоих и возвращайтесь к Иллингу Триасу в Штормград.‡Bleibt im Garten, bis Lord Gregor Lescovar und Marzon die Stille Klinge ihr Gespräch beendet haben. Schaltet sie danach beide aus, bevor Ihr nach Sturmwind zu Elling Trias zurückkehrt.‡그레골 라스코발 경과 소리없는검객 마르존이 대화를 나눌때까지 정원에서 기다려야 합니다. 대화를 들은 후, 이들을 모두 처치하고 스톰윈드에 있는 엘링 트리아스에게 가야 합니다.‡Quédate en el jardín hasta que Lord Gregor Lescovar y Marzon el Filo Silencioso hayan terminado de hablar. A continuación, mátalos antes de volver a reunirte con Elling Trias en Ventormenta.‡Quédate en el jardín hasta que Lord Gregor Lescovar y Marzon el Filo Silencioso hayan terminado de hablar. A continuación, mátalos antes de volver a reunirte con Elling Trias en Ventormenta.‡Rester dans le jardin jusqu\'à ce que le seigneur Gregor Lescovar et Marzon Lame silencieuse aient eu leur conversation. Après, les tuer tous les deux puis retourner voir Elling Trias à Hurlevent.‡等待葛瑞格·莱斯科瓦公爵和沉默之刃马尔松在花园里的对话结束，杀死他们两个，之后向暴风城的提亚斯回报。‡等待葛瑞格·萊斯科瓦領主和『沉默之刃』馬爾松在花園裡的對話結束，殺死他們兩個，之後向暴風城的提亞斯回報。',
  }
},
[435] = {
  {
    '‡Сопровождая Эрланда‡Eskorte für Erland‡엘런드 경호‡Escolta a Erland‡Escolta a Erland‡Une escorte pour Erland‡护送埃兰德‡',
    nil,
    '‡Проводите Эрланда, защищая его от волков, к Ран Йорик.‡Begleitet Erland durch die Wölfe hindurch zu Rane Yorick.‡레인 요릭이 있는 곳까지 늑대들을 물리치고 엘런드를 호위해야 합니다.‡Escolta a Erland a través de los lobos, hasta llegar a Rane Yorick.‡Escolta a Erland a través de los lobos, hasta llegar a Rane Yorick.‡Escorter Erland jusqu\'à Rane Yorick.‡护送亡灵哨兵埃兰德避过群狼，直到他找到兰妮·尤瑞克。‡',
  }
},
[436] = {
  {
    'Sítio de Escavação de Bandaferro‡Раскопки Сталекрута‡Eisenbands Ausgrabungsstätte‡아이언밴드의 발굴현장‡La Excavación de Vetaferro‡La excavación de Vetaferro‡Les fouilles de Baguefer‡铁环挖掘场‡鐵環挖掘場',
    nil,
    'Fale com o Explorador Machadeiro.‡Обратитесь к исследователю Удару Топора.‡Sprecht mit Forscher Todesstreich.‡탐험가 펠휴와 대화해야 합니다.‡Habla con el expedicionario Ceñimal.‡Habla con el explorador Ceñimal.‡Parler à l\'Explorateur Tombebranche.‡和麦格玛尔·落斧谈一谈。‡和麥格瑪爾·落斧談話。',
  }
},
[437] = {
  {
    'Os Campos Estéreis‡Мертвые поля‡Das Todesfeld‡죽음의 농장‡El Campo Muerto‡El Campo Muerto‡Le Champ des morts‡亡者农场‡亡者農場',
    nil,
    'Mate gnolls Putricouro nos Campos Estéreis.|n|nQuando Vergasta aparecer, mate-a.|n|nLeve a Essência de Vergasta para o Alto-executor Hadrec no Sepulcro.‡Убивайте гноллов из стаи Гнилошкуров на Мертвом поле. |n|nКогда появится банши Плеть Ночи, убейте ее. |n|nСущность банши принесите верховному палачу Хадрику в Гробницу.‡Tötet Gnolle der Moderfelle auf dem Todesfeld.|n|nSobald Nachtseele auftaucht, tötet sie ebenfalls.|n|nBringt Nachtseeles Essenz zu Hochexekutor Hadrec beim Grabmal.‡죽음의 농장에서 썩은가죽 놀들을 처치하십시오. 나이트래쉬가 나타나면 그녀를 처치하십시오.|n|n공동묘지에 있는 고위집행관 하드렉에게 나이트래쉬의 정수를 가져가야 합니다.‡Mata gnolls Putrepellejo en El Campo Muerto.|n|nCuando aparezca Latipesadilla, mátala.|n|nLleva la esencia de Latipesadilla al sumo ejecutor Hadrec en El Sepulcro.‡Mata gnolls Putrepellejo en El Campo Muerto.|n|nCuando aparezca Latipesadilla, mátala.|n|nLleva la esencia de Latipesadilla al sumo ejecutor Hadrec en El Sepulcro.‡Tuer des Gnolls poil-putride au Champ des morts.|n|nDétruire Cinglenuit quand elle apparaît.|n|nRapporter son essence au Grand exécuteur Hadrec au Sépulcre.‡清剿亡者农场的腐皮豺狼人。|n|n当奈塔拉什出现时，把她也杀掉。|n|n将奈塔拉什的灵魂带给瑟伯切尔的高级执行官哈德瑞克。‡殺死亡者農場的腐皮豺狼人。|n|n當奈塔拉什出現時，把她也殺了。|n|n將奈塔拉什的靈魂交給瑟伯切爾的高階執行官哈德瑞克。',
  }
},
[438] = {
  {
    'Os Campos Apodrecidos‡Старая переправа‡Die verfallene Fähre‡오래된 나루터‡El Viejo Embarcadero‡El Viejo Embarcadero‡Le bac délabré‡破旧渡口‡破舊渡口',
    nil,
    'Vá aos Campos Apodrecidos.|n|nDescubra o motivo pelo qual o Flagelo está lá.‡Отправляйтесь к старой переправе. |n|nПоищите причину присутствия там сил Плети.‡Geht zur verfallenen Fähre.|n|nSucht nach dem Grund, warum die Geißel dort ist.‡오래된 나루터로 가야 합니다.|n|n그곳에 스컬지가 주둔한 이유를 찾아내십시오.‡Ve a El Viejo Embarcadero.|n|nEncuentra la razón por la que la Plaga está ahí.‡Ve a El Viejo Embarcadero.|n|nEncuentra la razón por la que la Plaga está ahí.‡Aller au Bac délabré.|n|nChercher la raison de la présence du Fléau.‡到破旧渡口去，找到天灾军团占据那里的理由。‡到破舊渡口去，找到天譴軍團佔據那裡的理由。',
  }
},
[439] = {
  {
    'Pistas dos Putricouro‡Необычная находка‡Auf den Spuren der Moderfelle‡썩은가죽 일족의 단서‡Pistas de Putrepellejos‡Pistas de Putrepellejos‡Un indice vers les Poil-putride‡线索‡線索',
    nil,
    'Leve o Anel de Deliah para o Alto-executor Hadrec no Sepulcro.‡Принесите кольцо Делии верховному палачу Хадрику в Гробницу.‡Bringt Deliahs Ring zu Hochexekutor Hadrec beim Grabmal.‡공동묘지에 있는 고위집행관 하드렉에게 델리아의 반지를 가져가야 합니다.‡Lleva el anillo de Deliah al sumo ejecutor Hadrec en El Sepulcro.‡Lleva el anillo de Deliah al sumo ejecutor Hadrec en El Sepulcro.‡Rapporter l\'Anneau de Deliah au Grand exécuteur Hadrec au Sépulcre.‡将黛丽娅的戒指带给瑟伯切尔的高级执行官哈德瑞克。‡將黛麗婭的戒指帶給瑟伯切爾的高階執行官哈德瑞克。',
  }
},
[440] = {
  {
    'O anel gravado‡Кольцо с гравировкой‡Der gravierte Ring‡문자가 새겨진 반지‡El anillo grabado‡El anillo grabado‡L\'anneau ciselé‡黛丽娅的戒指‡黛麗婭的戒指',
    nil,
    'Leve o Anel de Deliah para o Magistrado Sevren em Montalvo.‡Отнесите кольцо Делии мировому судье Севрену в Брилл.‡Bringt Deliahs Ring zu Magistrat Sevren nach Brill.‡브릴에 있는 집정관 세브렌에게 델리아의 반지를 가져가야 합니다.‡Lleva el anillo de Deliah al magistrado Sevren en Rémol.‡Lleva el anillo de Deliah al magistrado Sevren en Rémol.‡Rapporter l\'Anneau de Deliah au Magistrat Sevren à Brill.‡将黛丽娅的戒指带给布瑞尔的执政官塞弗伦。‡將黛麗婭的戒指帶給布瑞爾的執政官塞弗倫。',
  }
},
[441] = {
  {
    'Olavo e a Cidade Baixa‡Роли, который живет в Подгороде‡Raleigh und Unterstadt‡랠리와 언더시티‡Raleigh y Entrañas‡Raleigh y Entrañas‡Raleigh et Fossoyeuse‡拉林夫与幽暗城‡拉林夫與幽暗城',
    nil,
    'Leve o Anel de Deliah para Olavo.‡Отнесите Роли кольцо Делии.‡Bringt Deliahs Ring zu Raleigh.‡랠리에게 델리아의 반지를 가져가야 합니다.‡Lleva el anillo de Deliah a Raleigh.‡Lleva el anillo de Deliah a Raleigh.‡Apporter l\'Anneau de Deliah à Raleigh.‡把黛丽娅的戒指交给拉林夫。‡把黛麗婭的戒指交給拉林夫。',
  }
},
[442] = {
  {
    'Ataque à Ilha de Fenris‡Атака на остров Фенриса‡Sturm auf die Insel Fenris‡펜리스 섬 공격‡Asalto a la Isla de Fenris‡Asalto a la Isla de Fenris‡L\'attaque de l\'île de Fenris‡突袭芬里斯岛‡突襲芬里斯島',
    nil,
    'Leve a Cabeça de Thule para o Alto-executor Hadrec no Sepulcro.‡Принесите верховному палачу Хадрику в Гробницу голову Тула Когтя Ворона.‡Bringt Hochexekutor Hadrec auf dem Grabmal Thules Kopf.‡공동묘지에 있는 고위집행관 하드렉에게 쑤울의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Thule al sumo ejecutor Hadrec en El Sepulcro.‡Lleva la cabeza de Thule al sumo ejecutor Hadrec en El Sepulcro.‡Apportez la Tête de Thule au Grand exécuteur Hadrec au Sépulcre.‡将图勒的徽记带回给瑟伯切尔的高级执行官哈德瑞克。‡將圖勒的頭顱帶回給瑟伯切爾的高階執行官哈德瑞克。',
  }
},
[443] = {
  {
    'Linfa de Putricouro‡Лимфа Гнилошкуров‡Moderfellsekret‡썩은가죽 영액‡Icor de Putrepellejo‡Icor de Putrepellejo‡L\'ichor de Poil-putride‡腐皮豺狼人的脓液‡腐皮豺狼人的膿液',
    nil,
    'Leve 8 garrafas de Linfa de Putricouro para o Boticário Renferrel no Sepulcro.‡Принесите 8 бутылок лимфы Гнилошкуров аптекарю Ренферрелу рядом с Гробницей.‡Bringt 8 Flaschen Moderfellsekret zu Apotheker Renferrel beim Grabmal.‡공동묘지에 있는 연금술사 렌퍼럴에게 썩은가죽 영액 8병을 가져가야 합니다.‡Lleva 8 botellas de icor de Putrepellejo al boticario Renferrel en El Sepulcro.‡Lleva 8 botellas de icor de Putrepellejo al boticario Renferrel en El Sepulcro.‡Rapporter 8 bouteilles d\'Ichor de Poil-putride à l\'apothicaire Renferrel.‡给瑟伯切尔的药剂师伦弗利尔带去8瓶腐皮豺狼人的脓液。‡給瑟伯切爾的藥劑師倫弗利爾帶去8瓶腐皮豺狼人的膿液。',
  }
},
[444] = {
  {
    '‡Происхождение Гнилошкуров‡Die Ursprünge der Moderfelle‡썩은가죽 일족의 기원‡El origen de los Putrepellejos‡El origen de los Putrepellejos‡L\'origine des Poil-putride‡腐皮豺狼人的产生‡',
    nil,
    '‡Отнесите образец лимфы Бетору Ледострелу в Подгород.‡Bringt die Sekretprobe zu Bethor Eismacht nach Unterstadt.‡언더시티에 있는 베소르 아이스샤드에게 영액 견본을 가져가야 합니다.‡Lleva la muestra de icor a Bethor Duroyelo en Entrañas.‡Lleva la muestra de icor a Bethor Duroyelo en Entrañas.‡Apportez l\'Échantillon d\'ichor à Bethor Glacéclat à Fossoyeuse.‡将脓液样本交给幽暗城的比索·埃斯沙德。‡',
  }
},
[445] = {
  {
    'Entrega na Floresta de Pinhaprata‡Доставка в Серебряный бор‡Lieferung in den Silberwald‡은빛소나무 숲으로의 배달‡Entrega a Bosque de Argénteos‡Entrega a Bosque de Argénteos‡Livraison dans la forêt des Pins-Argentés‡给银松森林送信‡給銀松森林送信',
    nil,
    'Take Apothecary Holland\'s findings to Apothecary Renferrel in Silverpine Forest.‡Отнесите находки аптекаря Холланда аптекарю Ренферрелу в Серебряном бору.‡Bringt Apotheker Hollands Erkenntnisse zu Apotheker Renferrel im Silberwald.‡은빛소나무 숲에 있는 연금술사 렌퍼럴에게 초보연금술사 홀랜드의 연구 결과를 가져가야 합니다.‡Llévale los descubrimientos del boticario Holland al boticario Renferrel del Bosque de Argénteos.‡Llévale los descubrimientos del boticario Holland al boticario Renferrel del Bosque de Argénteos.‡Apporter les découvertes de l\'apothicaire Holland à l\'Apothicaire Renferrel dans la forêt des Pins-Argentés.‡将药剂师霍兰德的研究成果交给银松森林的药剂师伦弗利尔。‡將藥劑師霍蘭德的研究成果帶給銀松森林的藥劑師倫弗利爾。',
  }
},
[446] = {
  {
    'Thule Corvinalle‡Тул Коготь Ворона‡Thule Rabenklaue‡까마귀발톱 쑤울‡Thule Corvozarpa‡Thule Corvozarpa‡Thule Serres-de-corbeau‡图勒·鸦爪‡圖勒·鴉爪',
    nil,
    'Leve o Pergaminho de Boanerges para o Boticário Renferrel no Sepulcro de Pinhaprata.‡Отнесите свиток Бетора аптекарю Ренферрелу в Серебряный бор, в Гробницу.‡Bringt Bethors Rolle zu Apotheker Renferrel beim Grabmal im Silberwald.‡은빛소나무 숲 공동묘지에 있는 연금술사 렌퍼럴에게 베소르의 두루마리를 가져가야 합니다.‡Lleva el pergamino de Bethor al boticario Renferrel en El Sepulcro de Argénteos.‡Lleva el pergamino de Bethor al boticario Renferrel en El Sepulcro de Argénteos.‡Porter le parchemin de Bethor à l\'Apothicaire Renferrel au Sépulcre des Pins-Argentés.‡把比索的卷轴交给银松森林中的药剂师伦弗利尔。‡把比索的卷軸交給銀松森林中的藥劑師倫弗利爾。',
  }
},
[447] = {
  {
    'Receita mortal‡Рецептура смерти‡Rezept für den Tod‡죽음의 비법‡Una fórmula mortal‡Una fórmula mortal‡Une recette mortelle‡奇妙的配方‡致命配方',
    nil,
    'Colete 6 Corações de Urso Cinzento e 6 amostras de Sangue de Pateante e leve-os para o Mestre-boticário Faranello na Cidade Baixa.‡Соберите 6 сердец медведя и 6 образцов Летящей крови и принесите их мастеру-аптекарю Фаранеллу в Подгород.‡Sammelt 6 Herzen von ergrauten Bären und 6 Proben Huschendes Blut und bringt diese zu Apothekermeister Faranell nach Unterstadt.‡불곰 심장 6개와 땅거미 점액 6개를 모아 언더시티에 있는 수석 연금술사 파라넬에게 가져가야 합니다.‡Consigue 6 corazones de oso grisáceo y 6 muestras de sangre de celearácnida, y llévaselas al maestro boticario Faranell en Entrañas.‡Consigue 6 corazones de oso grisáceo y 6 muestras de sangre de celerácnida y llévaselas al maestro boticario Faranell en Entrañas.‡Se rendre au Grouillement et y collecter 6 Cœurs de vieil ours et 6 échantillons de Sang du Grouillement, puis les apporter au maître apothicaire Faranell de la Société royale des apothicaires, à Fossoyeuse.‡收集6个灰熊的心脏和6份粘稠的血液样本，并将这些东西送给幽暗城的大药剂师法拉尼尔。‡收集6個灰熊的心臟和6份粘稠的血液樣本，並將這些東西送給幽暗城的藥劑大師法拉尼爾。',
  }
},
[448] = {
  {
    '‡Доложиться Хадрику‡Meldung bei Hadrec‡‡Preséntate ante Hadrec‡Preséntate ante Hadrec‡Un rapport pour Hadrec‡给哈德瑞克的报告‡',
    nil,
    '‡Доложитесь верховному палачу Хадрику в Гробнице.‡Meldet Euch bei Hochexekutor Hadrec auf dem Grabmal.‡‡Preséntate ante el sumo ejecutor Hadrec en El Sepulcro.‡Preséntate ante el sumo ejecutor Hadrec en El Sepulcro.‡Faire un rapport au Grand exécuteur Hadrec au Sépulcre.‡向瑟伯切尔的高级执行官哈德瑞克复命。‡',
  }
},
[449] = {
  {
    '‡Отчет стражей смерти‡Der Bericht der Todespirscher‡‡El informe de los Mortacechadores‡El informe de los Mortacechadores‡Le rapport des nécrotraqueurs‡亡灵哨兵的报告‡',
    nil,
    '‡Отнесите отчет стражей смерти верховному палачу Хадрику в Гробницу.‡Bringt den Todespirscherbericht zu Hochexekutor Hadrec beim Grabmal.‡‡Lleva el informe de los Mortacechadores al sumo ejecutor Hadrec en El Sepulcro.‡Lleva el informe de los Mortacechadores al sumo ejecutor Hadrec en El Sepulcro.‡Apportez le rapport du Nécrotraqueur au Grand exécuteur Hadrec au Sépulcre.‡将亡灵哨兵的报告的报告交给瑟伯切尔的高级执行官哈德瑞克。‡',
  }
},
[450] = {
  {
    'Receita mortal‡Рецептура смерти‡Rezept für den Tod‡죽음의 비법‡Una fórmula mortal‡Una fórmula mortal‡Une recette mortelle‡奇妙的配方‡致命配方',
    nil,
    'Recupere o Diário do Boticário Berardo em Vilarejo Lenhardente e leve-o ao Boticário Renferrel no Sepulcro.‡Найдите в деревне Погребальных Костров записи Берарда и отнесите их в Гробницу аптекарю Ренферрелу.‡Bergt Apotheker Berards Tagebuch aus Lohenscheit und bringt es zu Apotheker Renferrel beim Grabmal.‡장작나무 마을에서 베랄드의 일지를 구해 공동묘지에 있는 연금술사 렌퍼럴에게 가져가야 합니다.‡Recupera el Diario del boticario Berard de la Aldea Piroleña y llévaselo al boticario Renferrel en El Sepulcro.‡Recupera el Diario del boticario Berard de la Aldea Piroleña y llévaselo al boticario Renferrel en El Sepulcro.‡Récupérer le Journal de Berard à l\'Auberge de Bois-du-Bûcher et le rapporter à l\'apothicaire Renferrel au Sépulcre.‡从焚木村的旅店中找到伯纳德的日记，把它交给瑟伯切尔的药剂师伦弗利尔。‡從焚木村的旅店中找到伯納德的日記，把它交給瑟伯切爾的藥劑師倫弗利爾。',
  }
},
[451] = {
  {
    'Receita mortal‡Рецептура смерти‡Rezept für den Tod‡죽음의 비법‡Una fórmula mortal‡Una fórmula mortal‡Une recette mortelle‡奇妙的配方‡致命配方',
    nil,
    'Leve 6 amostras de Musgo de Rastejante do Lago, 6 amostras de Musgo de Sorrateiro do Lago e um Tumor Endurecido para o Mestre-boticário Faranello na Cidade Baixa.‡Принесите 6 образцов мха озерного ползуна, 6 образцов мха озерного тихохода и твердую опухоль мастеру-аптекарю Фаранеллу в Подгород.‡Bringt 6 Proben Seeschleichermoos, 6 Proben Seekrabblermoos und einen verhärteten Tumor zu Apothekermeister Faranell nach Unterstadt.‡호수늪지이끼 6개, 호수덤불이끼 6개, 그리고 굳어진 종양 1개를 언더시티에 있는 수석 연금술사 파라넬에게 가져가야 합니다.‡Lleva 6 muestras de musgo de trepador del Lago, 6 muestras de musgo de vagador del Lago y un tumor endurecido al maestro boticario Faranell en Entrañas.‡Lleva 6 muestras de moho de trepador del Lago, 6 muestras de moho de vagador del Lago y un tumor endurecido al maestro boticario Faranell en Entrañas.‡Apporter 6 échantillons de Mousse de Rampant lacustre, 6 échantillons de Mousse de Furtif lacustre et une Tumeur durcie au Maître apothicaire Faranell à Fossoyeuse.‡收集6份湖岸爬行者苔藓的样本、6份湖岸潜藏者苔藓的样本和1块硬瘤，把它们交给幽暗城的大药剂师法拉尼尔。‡收集6份湖岸蠕行者苔蘚的樣本、6份湖岸潛藏者苔蘚的樣本和1塊硬瘤，把它們交給幽暗城的藥劑大師法拉尼爾。',
  }
},
[452] = {
  {
    'Emboscada de Lenhardente‡Засада в деревне‡Hinterhalt in Lohenscheit‡장작나무 마을 매복‡La emboscada de Aldea Piroleña‡La emboscada de Aldea Piroleña‡Embuscade à Bois-du-Bûcher‡焚木村中的伏击‡焚木村中的伏擊',
    nil,
    'Ajude a Sicária Fabiana a eliminar o Conselho de Lenhardente.‡Помогите стражу смерти Фарлии уничтожить совет деревни Погребальных Костров.‡Helft Todespirscherin Faerleia, den Rat von Lohenscheit zu töten.‡죽음추적자 페를레이아를 도와 장작나무 마을 원로원들을 처치해야 합니다.‡Ayuda al mortacechador Faerleia a destruir al Consejo de Piroleña.‡Ayuda a la mortacechadora Faerleia a destruir al Consejo Piroleña.‡Aider le Nécrotraqueur Faerleia à tuer les membres du Conseil de Bois-du-Bûcher.‡帮助亡灵哨兵费雷亚消灭焚木村议会。‡幫助亡靈哨兵費雷亞消滅焚木村議會。',
  }
},
[453] = {
  {
    'À procura do Vulto Sombrio‡Поиски таинственного незнакомца‡Auf der Suche nach der Schattengestalt‡의문의 남자 찾기‡Encuentra la figura misteriosa‡Encuentra la figura misteriosa‡À la recherche de la silhouette mystérieuse‡搜寻乌鸦岭‡搜尋烏鴉嶺',
    nil,
    'Encontre o Vulto Sombrio. Suas pistas:|n|nEle não é nativo de Vila Sombria.|n|nÉ uma pessoa nervosa e agitada.|n|nEle deixou Vila Sombria e seguiu para o oeste.‡Отыщите незнакомца. Его приметы:|n|nОн родом не из Темнолесья.|n|nОн – нервный тип.|n|nОн сбежал из Темнолесья и двинулся на запад.‡Findet die Schattengestalt. Eure Hinweise:|n|nEr stammt nicht aus Dunkelhain.|n|nEr ist eine nervöse, hektische Person.|n|nEr verließ Dunkelhain und ging nach Westen.‡의문의 남자를 찾아야 합니다. 지금까지 얻은 단서는 다음과 같습니다.|n|n어둠골에서 태어난 사람이 아닙니다.|n|n신경질적이고 신경과민인 사람입니다.|n|n어둠골을 떠나 서쪽으로 갔습니다.‡Encuentra a la figura misteriosa. Las pistas que tienes: |n|nNo es oriundo de Villa Oscura. |n|nEs una persona nerviosa, que se altera fácilmente. |n|nDejó Villa Oscura y se dirigió al oeste.‡Encuentra a la figura misteriosa. Las pistas que tienes: |n|nNo es oriundo de Villa Oscura. |n|nEs una persona nerviosa, que se altera fácilmente. |n|nDejó Villa Oscura y se dirigió al oeste.‡Retrouver la Silhouette mystérieuse. Indices :|n|nIl n\'est pas né à Sombre-Comté.|n|nC\'est un individu nerveux et craintif.|n|nIl a quitté Sombre-Comté pour faire route vers l\'ouest.‡找到那个模糊的人影。你的线索：|n|n他不是夜色镇的本地人。|n|n他是个紧张而敏感的人。|n|n他离开夜色镇往西边去了。‡找到那個模糊的人影。你的線索:|n|n他不是夜色鎮的本地人。|n|n他是個緊張而敏感的人。|n|n他離開夜色鎮往西邊去了。',
  }
},
[454] = {
  {
    '‡После засады‡Nach dem Hinterhalt‡‡Tras la emboscada‡Tras la emboscada‡Après l\'embuscade‡恶战之后‡',
    nil,
    '‡Поговорите с Мираном.‡Sprecht mit Miran.‡‡Habla con Miran.‡Habla con Miran.‡Parler à Miran.‡和米兰谈一谈。‡',
  }
},
[455] = {
  {
    'Sufoco em Algaz‡Альгазская битва‡Der Algaz-Spießrutenlauf‡알가즈의 위기‡El asedio de Algaz‡El asedio de Algaz‡Le défi d\'Algaz‡丹奥加兹告急‡丹奧加茲告急',
    nil,
    'Atravesse Dun Algaz.|n|nMate 8 Batedores Presa do Dragão e 6 Brutos Presa do Dragão.|n|nApresente-se a Valstag Ferroqueixo no Porto de Menethil.‡Пройдите через Дун Альгаз.|n|nУбейте 8 разведчиков из клана Драконьей Пасти и 6 рубак из клана Драконьей Пасти.|n|nОб исполнении доложите Валстагу Сталезубу в Гавани Менетилов.‡Durchquert Dun Algaz.|n|nTötet 8 Späher des Drachenmals und 6 Grunzer des Drachenmals.|n|nMeldet Euch bei Valstag Eisenkiefer im Hafen von Menethil.‡던 알가즈를 가로질러 가야 합니다.|n|n용아귀 정찰병 8명과 용아귀 그런트 6명을 처치해야 합니다.|n|n메네실 항구에 있는 발스탁 아이언조에게 보고하십시오.‡Atraviesa Dun Algaz.|n|nMata 8 exploradores Faucedraco y 6 brutos Faucedraco.|n|nInforma a Valstag Quijahierro del Puerto de Menethil.‡Atraviesa Dun Algaz.|n|nMata 8 exploradores Faucedraco y 6 brutos Faucedraco.|n|nInforma a Valstag Quijahierro de Puerto de Menethil.‡Traverser Dun Algaz.|n|nTuer 8 Eclaireurs Gueules-de-dragon et 6 Grunts Gueules-de-dragon.|n|nFaites votre rapport à Valstag Gueule-de-fer au port de Menethil.‡翻越丹奥加兹。|n|n杀死8个龙喉斥候和6个龙喉步兵。|n|n向米奈希尔港的瓦斯塔格·铁腭报到。‡翻越丹奧加茲。|n|n殺死8個龍喉斥候和6個龍喉蠻兵。|n|n向米奈希爾港的瓦斯塔格·鐵顎報到。',
  }
},
[456] = {
  {
    'O equilíbrio da natureza‡Природное равновесие‡Das Gleichgewicht der Natur‡자연의 균형‡El equilibrio de la naturaleza‡El equilibrio de la naturaleza‡L\'équilibre de la nature‡自然的平衡‡自然的平衡',
    nil,
    'Kill 3 Young Nightsabers and 3 Young Thistle Boars.‡[Deprecated] Kill 3 Young Nightsabers and 3 Young Thistle Boars.‡Tötet 3 junge Nachtsäbler sowie 3 junge Disteleber.‡새끼 밤호랑이 3마리와 새끼 엉겅퀴멧돼지 3마리를 처치해야 합니다.‡Mata a 3 sables de la noche y 3 jabalíes cardo jóvenes.‡Mata a 3 sables de la noche y 3 jabalíes cardo jóvenes.‡Tuez 3 Jeunes sabres-de-nuit et 3 Jeunes sangliers des chardons.‡杀死5只夜刃豹幼崽和4只草刺野猪幼崽。‡殺死3隻小夜刃豹和3隻小草刺野豬。',
  }
},
[457] = {
  {
    'Nature\'s Dues‡Естественное равновесие‡Das Gesetz der Natur‡자연의 대가‡En deuda con la naturaleza‡En deuda con la naturaleza‡Le dû de la nature‡自然的代价‡自然的平衡',
    nil,
    'Kill 6 Mangy Nightsabers and 6 Thistle Boars.‡Убейте 6 облезлых ночных саблезубов и щетинистых вепрей.‡Tötet 6 räudige Nachtsäbler und 6 Disteleber.‡병든 밤호랑이 6마리와 엉겅퀴멧돼지 6마리를 처치해야 합니다.‡Mata a 6 sables de la noche sarnosos y a 6 jabalíes Cardo.‡Mata a 6 sables de la noche sarnosos y a 6 jabalíes Cardo.‡Tuez 6 Sabres-de-nuit galeux et 6 Sangliers des chardons.‡杀死6只癞皮夜刃豹和6只草刺野猪。‡殺死6隻癩皮夜刃豹和6隻草刺野豬。',
  }
},
[458] = {
  {
    'A protetora dos bosques‡Защитница леса‡Die Beschützerin des Waldlandes‡숲의 수호자‡La protectora de los bosques‡La protectora de los bosques‡La protectrice sylvestre‡森林守护者‡森林保衛者',
    nil,
    'Procure a dríade conhecida como Tarindrella.‡Найдите дриаду по имени Тариндрелла.‡Sucht die Dryade, die als Tarindrella bekannt ist.‡타린드렐라라고 알려진 드리아드를 찾아야 합니다.‡Busca a la dríade Tarindrella.‡Busca a la dríade Tarindrella.‡Chercher la dryade connue sous le nom de Tarindrella.‡找到树妖塔琳德拉。‡找到林精塔琳德拉。',
  }
},
[459] = {
  {
    'Demonic Thieves‡Демонические воры‡Dämonische Diebe‡악랄한 도둑‡Ladrones demoníacos‡Ladrones demoníacos‡Les démons voleurs‡恶魔窃贼‡惡魔小偷',
    nil,
    'Recover Dellylah\'s Stolen Beans, Dellylah\'s Stolen Water, and Dellylah\'s Stolen Bags.‡Верните украденные у Деллии бобы, воду и сумки.‡Bringt Dellylahs gestohlene Bohnen, Dellylahs gestohlenes Wasser und Dellylas gestohlene Beutel zurück.‡델리라의 잃어버린 콩, 델리라의 잃어버린 물, 델리라의 잃어버린 자루를 회수해야 합니다.‡Recupera las judías robadas de Dellylah, el agua robada de Dellylah y las bolsas robadas de Dellylah.‡Recupera las judías robadas de Dellylah, el agua robada de Dellylah y las bolsas robadas de Dellylah.‡Récupérez les Haricots volés de Dellylah, l’Eau volée de Dellylah et les Sacs volés de Dellylah.‡夺回德林拉尔被盗的豆子，德林拉尔被盗的水桶和德林拉尔被盗的背包。‡找回德黎菈被偷走的豆子、德黎菈被偷走的水和德黎菈被偷走的袋子。',
  }
},
[460] = {
  {
    'Descanse em pedaços‡В целости и сохранности‡In Stücken begraben‡분리된 몸과 머리‡Descansar en piezas‡Descansar en piezas‡Reposer en... pièces‡支离破碎‡支離破碎',
    nil,
    'Leve a Cabeça de Alaric ao seu túmulo.‡Отнесите голову Аларика на его могилу.‡Bringt Alarics Kopf zu seinem Grab.‡알라리크의 머리를 그의 무덤으로 데려가야 합니다.‡Lleva la cabeza de Alaric a su tumba.‡Lleva la cabeza de Alaric a su tumba.‡Apporter la tête d\'Alaric jusqu\'à sa tombe.‡将奥拉瑞克的徽记带到他的坟墓旁。‡將奧拉瑞克的頭顱帶到他的墳墓旁。',
  }
},
[461] = {
  {
    '‡Замаскированный тайник‡Die versteckte Nische‡비밀 벽감‡El nicho oculto‡El nicho oculto‡L\'alcôve secrète‡密室‡',
    nil,
    '‡Отнесите Аларика к замаскированной нише.‡Bringt Alaric zur versteckten Nische.‡알라리크를 비밀 벽감으로 데려가야 합니다.‡Lleva a Alaric al nicho oculto.‡Lleva a Alaric al nicho oculto.‡Amener Alaric à l\'alcôve secrète.‡将奥拉瑞克带到密室去。‡',
  }
},
[462] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Kill Maruk Wyrmscale|n|nReport to Valstag Ironjaw in Menethil Harbor.‡Убейте Марука Змеиную Чешую|n|nДоложите об этом Валстагу Сталезубу в Гавани Менетилов.‡Tötet Ma\'ruk Wyrmschuppe.|n|nMeldet Euch bei Valstag Eisenkiefer im Hafen von Menethil.‡마루크 웜스케일을 처치해야 합니다.|n|n이후 메네실 항구에 있는 발스탁 아이언조에게 보고해야 합니다.‡Mata a Ma\'ruk Vermiscala.|n|nInforma a Valstag Quijahierro en el Puerto de Menethil.‡Mata a Mar\'uk Vermiscala|n|nHabla con Valstag Quijahierro en el Puerto de Menethil.‡Tuez Ma’ruk Wyrmécaille.|n|nFaites votre rapport à Valstag Gueule-de-fer dans le port de Menethil.‡杀掉马鲁克·龙鳞。|n|n然后向米奈希尔港的瓦斯塔格·铁腭报告。‡殺死馬魯克‧龍鱗|n|n在米奈希爾港向瓦斯塔格‧鐵顎回報。',
  }
},
[463] = {
  {
    'O Verdião‡Страж Природы‡Der Sumpfhüter‡신록수호자‡El Guardaverde‡El Guardaverde‡Le Gardien vert‡绿色守卫者‡綠色守衛者',
    nil,
    'Encontre o Verdião.‡Найдите Стража Природы.‡Findet den Sumpfhüter.‡신록수호자를 찾아야 합니다.‡Encuentra al Guardaverde.‡Encuentra al Guardaverde.‡Trouver le Gardien vert.‡找到绿色守卫者。‡找到綠色守衛者。',
  }
},
[464] = {
  {
    'Estandartes de guerra‡Боевые знамена‡Kriegsflaggen‡전쟁 깃발‡Estandartes de batalla‡Estandartes de batalla‡Bannières de guerre‡龙喉战旗‡龍喉旌旗',
    nil,
    'Leve 8 Estandartes de Guerra Presa do Dragão para o Capitão Punhoforte.‡Принесите 8 боевых знамен клана Драконьей Пасти капитану Крепкому Кулаку.‡Bringt Hauptmann Starkfaust 8 Kriegsflaggen des Drachenmals.‡메네실 항구에 있는 경비대장 스타우트피스트에게 용아귀 전쟁 깃발 8개를 가져가야 합니다.‡Lleva 8 estandartes de guerra Faucedraco al capitán Puñorrecio.‡Lleva 8 estandartes de guerra Faucedraco al capitán Puñorrecio.‡Rapporter 8 Bannières de guerre Gueule-de-dragon au capitaine Rudepoing.‡给斯托菲队长带回8面龙喉战旗。‡給斯托菲隊長帶回8面龍喉旌旗。',
  }
},
[465] = {
  {
    'A artimanha de Nek\'rosh‡Гамбит Нек\'роша‡Nek\'roshs Schachzug‡용아귀 투석기‡La estrategia de Nek\'rosh‡La estrategia de Nek\'rosh‡La manœuvre de Nek\'rosh‡纳克罗什的优势‡納克羅什的優勢',
    nil,
    'Destrua as Catapultas da Presa do Dragão.‡Уничтожьте катапульты Драконьей Пасти.‡Zerstört die Katapulte des Drachenmals.‡용아귀 투석기를 파괴해야 합니다.‡Destruye las catapultas Faucedraco.‡Destruye las catapultas Faucedraco.‡Détruire les Catapultes Gueules-de-dragon.‡摧毁所有的龙喉投石车。‡摧毀所有的龍喉投石車。',
  }
},
[466] = {
  {
    'À procura de incendicita‡Поиски огневита‡Auf der Suche nach Pyrophor‡발연 광석을 찾아서‡Búsqueda de incendicita‡Búsqueda de incendicita‡À la recherche de l\'incendicite‡火岩矿石‡火岩礦石',
    nil,
    'Leve 6 cargas de Minério de Incendicita ao Piloto Marchapedra em Dun Morogh.‡Принесите 6 партий огневитовой руды пилоту Камнекожицу в Дун Морог.‡Bringt 6 Ladungen Pyrophorerz zu Pilot Steinsegel nach Dun Morogh.‡던 모로에 있는 조종사 스톤기어에게 발연 광석 6개를 가져가야 합니다.‡Lleva 6 piezas de mena de incendicita al piloto Roscapiedra de Dun Morogh.‡Lleva 6 piezas de mineral de incendicita al piloto Roscapiedra de Dun Morogh.‡Apporter 6 Chargements d\'Incendicite au Pilote Engrepierre à Dun Morogh.‡给丹莫罗的驾驶员迪恩·石轮带回6份火岩矿石。‡給丹莫洛的駕駛員迪恩·石輪帶回6份火岩礦石。',
  }
},
[467] = {
  {
    'A busca de Marchapedra‡Найдите Камнекожца‡Steinsegels Suche‡스톤기어의 광석‡La búsqueda de los Roscapiedra‡La búsqueda de los Roscapiedra‡La quête d\'Engrepierre‡迪恩·石轮的梦想‡迪恩·石輪的追尋',
    nil,
    'Fale com o Piloto Marchapedra.‡Поговорите с пилотом Камнекожицем.‡Sprecht mit Pilot Steinsegel.‡조종사 스톤기어와 대화해야 합니다.‡Habla con el piloto Roscapiedra.‡Habla con el piloto Roscapiedra.‡Parlez au Pilote Engrepierre.‡和驾驶员迪恩·石轮谈一谈。‡和駕駛員迪恩·石輪談話。',
  }
},
[468] = {
  {
    'Apresente-se ao Montanhista Rochapeixe‡Отчитайтесь перед горным пехотинцем Рокхаром‡Meldung bei Gebirgsjäger Felsgar‡산악경비대 록가르에게 보고‡Preséntate ante el montaraz Piedragar‡Preséntate ante el montaraz Piedragar‡Un rapport pour le Montagnard Rochegar‡向巡山人罗克加报告‡向巡山人羅克加報告',
    nil,
    'Fale com o Montanhista Rochapeixe.‡Поговорите с горным пехотинцем Рокхаром.‡Sprecht mit Gebirgsjäger Felsgar.‡산악경비대 록가르와 대화해야 합니다.‡Habla con el montaraz Piedragar.‡Habla con el montaraz Piedragar.‡Parler au Montagnard Rochegar.‡与巡山人罗克加谈一谈。‡與巡山人羅克加談話。',
  }
},
[469] = {
  {
    'Entrega diária‡Ежедневная доставка‡Tägliche Lieferung‡가죽 배달‡Entrega cotidiana‡Entrega cotidiana‡Livraison quotidienne‡日常供货‡日常供貨',
    nil,
    'Entregue o Pacote de Peles de Crocolisco a Iago Halberque, o curtumeiro, no Porto de Menethil.‡Отнесите стопку кроколисковых шкур кожевнику Джеймсу Халлорану в Гавань Менетилов.‡Liefert das Bündel Krokiliskenhäute bei dem Gerber James Halloran im Hafen von Menethil ab.‡메네실 항구의 무두장이 제임스 할로란에게 악어 껍질 한 묶음을 전달해야 합니다.‡Entrega el fardo de pieles de crocolisco a James Halloran, el curtidor, en Puerto de Menethil.‡Entrega el fardo de pieles de crocolisco a James Halloran, el curtidor, en Puerto de Menethil.‡Apporter le Lot de peaux de crocilisques à James Halloran, le tanneur, au port de Menethil.‡将这捆鳄鱼皮带给米奈希尔港的皮匠詹姆斯·哈洛兰。‡將這捆鱷魚皮帶給米奈希爾港的皮匠詹姆士·哈洛倫。',
  }
},
[470] = {
  {
    'Escavando a Gosma‡Прожорливый слизнюк‡Stochern im Schlamm‡가방 찾기‡Abriéndose paso entre los mocos‡Abriéndose paso entre los mocos‡En creusant dans la vase‡搜寻软泥怪‡搜尋軟泥怪',
    nil,
    'A bolsa de Cida está em uma das gosmas na Tumba dos Barbaférreos. Recupere a bolsa e leve de volta para ela no Porto de Menethil.‡Отнимите сумку Сиды у неизвестного слизнюка возле гробницы Железноборода и верните ее хозяйке в Гавань Менетилов.‡Ein Schlamm bei Eisenbarts Grabmal hat Sidas Tasche. Bergt sie und bringt sie ihr zurück in den Hafen von Menethil.‡아이언비어드의 고분에 돌아다니는 수액괴물 중 하나가 시다의 가방을 갖고 있습니다. 그 가방을 구해 메네실 항구의 시다에게 가져가야 합니다.‡Uno de los mocos de la Tumba de Barbaférrea tiene la Bolsa de Shida, recupérala y devuélvesela en Puerto de Menethil.‡Uno de los mocos de la Tumba de Barbaférrea tiene la Bolsa de Shida, recupérala y devuélvesela en Puerto de Menethil.‡L\'un des limons dans la Tombe de Barbe-de-fer a le sac de Sidonie. Le retrouver et le lui rapporter au port de Menethil.‡铁须之墓中的某只软泥怪身上有塞达的背包，夺回背包，把它送还给米奈希尔港的塞达。‡鐵鬚之墓中的某隻軟泥怪身上有塞達的背包，奪回背包，把它送還給米奈希望港的塞達。',
  }
},
[471] = {
  {
    'Deveres de aprendiz‡Тяжкая судьба помощника‡Lehrlingspflichten‡수습생의 임무‡Deberes de aprendiz‡Deberes de aprendiz‡Les devoirs de l\'apprenti‡学徒的职责‡學徒的職責',
    nil,
    'Colete 6 Peles de Crocolisco Gigante e leve-as para Iago Halberque no Porto de Menethil.‡Принесите 6 шкур гигантских кроколисков Джеймсу Халлорану в Гавань Менетилов.‡Sammelt 6 riesige Krokiliskenhäute und bringt sie zu James Halloran in den Hafen von Menethil.‡거대한 악어 껍질 6장을 모아 메네실 항구의 제임스 할로란에게 가져가야 합니다.‡Reúne 6 pieles de crocolisco gigante y llévaselas a James Halloran en Puerto de Menethil.‡Reúne 6 pieles de crocolisco gigante y llévaselas a James Halloran en Puerto de Menethil.‡Collecter 6 Peaux de crocilisque géant, et les apporter à James Halloran, au port de Menethil.‡为米奈希尔港的詹姆斯·哈洛兰带回6张巨型鳄鱼的皮。‡為米奈希爾港的詹姆士·哈洛倫帶回6張巨型鱷魚的皮。',
  }
},
[472] = {
  {
    'Queda de Dun Modr‡Падение Дун Модра‡Der Fall von Dun Modr‡던 모드르의 함락‡La caída de Dun Modr‡La caída de Dun Modr‡La chute de Dun Modr‡丹莫德的陷落‡丹莫德的陷落',
    nil,
    'Procure Trançalonga perto da cidade de Dun Modr.‡Отыщите Грима Длиннокоса возле Дун Модра.‡Sucht nahe der Stadt von Dun Modr nach Langzopf.‡던 모드르 마을 근처에서 롱브레이드를 찾아야 합니다.‡Busca a Largatrenza junto a la ciudad de Dun Modr.‡Busca a Largatrenza junto a la ciudad de Dun Modr.‡Rechercher Tresse-longue dans les parages de la ville de Dun Modr.‡在丹莫德镇附近寻找坚毅者长须的踪迹。‡在丹莫德鎮附近尋找布萊德·長鬚的蹤跡。',
  }
},
[473] = {
  {
    '‡Доклад капитану Крепкому Кулаку‡Meldung bei Hauptmann Starkfaust‡‡Preséntate ante el capitán Puñorrecio‡Preséntate ante el capitán Puñorrecio‡Un rapport au capitaine Rudepoing‡向斯托菲队长报告‡',
    nil,
    '‡Найдите капитана Крепкого Кулака и поговорите с ним.‡Sprecht mit Hauptmann Starkfaust.‡‡Habla con el capitán Puñorrecio.‡Habla con el capitán Puñorrecio.‡Parler au capitaine Rudepoing.‡与斯托菲队长谈一谈。‡',
  }
},
[474] = {
  {
    'Derrotar Nek\'rosh‡Убить Нек\'роша‡Sieg über Nek\'rosh‡네크로쉬 처치‡Derrota a Nek\'rosh‡Derrota a Nek\'rosh‡Vaincre Nek\'rosh‡击败纳克罗什‡擊敗納克羅什',
    nil,
    'Mate o Chefe Nek\'rosh.|n|nLeve a Cabeça do Nek\'rosh ao Capitão Punhoforte.‡Убейте вождя Нек\'роша.|n|nПринесите голову Нек\'роша капитану Крепкому Кулаку.‡Tötet Häuptling Nek\'rosh.|n|nBringt Nek\'roshs Kopf zu Hauptmann Starkfaust.‡족장 네크로쉬를 처치해야 합니다.|n|n그런 다음 그 증거로 경비대장 스타우트피스트에게 네크로쉬의 머리카락을 가져가야 합니다.‡Mata al cabecilla Nek\'rosh.|n|nLleva la cabeza de Nek\'rosh al capitán Puñorrecio.‡Mata al jefe Nek\'rosh.|n|nLleva la cabeza de Nek\'rosh al capitán Puñorrecio.‡Tuer le Chef Nek\'rosh.|n|nRapporter la tête de Nek\'rosh au capitaine Rudepoing.‡杀掉纳克罗什酋长。|n|n将纳克罗什的徽记交给斯托菲队长。‡殺掉納克羅什酋長。|n|n將納克羅什的頭顱交給斯托菲隊長。',
  }
},
[475] = {
  {
    'Uma leve brisa‡Ветер тревоги‡Ein beunruhigender Wind‡혼란의 바람‡Una brisa problemática‡Una brisa problemática‡Une brise étrange‡烦恼之风‡煩惱之風',
    nil,
    'Encontre Garyol Talvethren no Vilarejo Brisastral.‡Найдите Гэроласа Талветрена в Деревне Звездного Ветра.‡Sucht Gaerolas Talvethren im Dorf Sternenhauch auf.‡별바람 마을에서 게롤라스 탈베드렌을 찾아야 합니다.‡Busca a Gaerolas Talvethren en la Aldea Brisa Estelar.‡Busca a Gaerolas Talvethren en la Aldea Brisa Estelar.‡Chercher Gaerolas Talvethren à Brise-Stellaire.‡去星风村找盖洛拉斯·塔文斯伦。‡在星風村找到蓋洛拉斯·塔文斯倫。',
  }
},
[476] = {
  {
    'Corrupção Masca-pinho‡Порча Кривой Сосны‡Die Verderbnis der Knarzklauen‡나무옹이 일족의 타락‡Corrupción en Tuercepinos‡Corrupción en Tuercepinos‡La corruption des Pins-tordus‡瘤背熊怪的堕落‡瘤背熊怪的墮落',
    nil,
    'Fale com Athridas Mantursino em Dolanaar.‡Вернитесь к Атридасу Медвежьей Шкуре в Доланаар.‡Kehrt zu Athridas Bärenfell in Dolanaar zurück.‡돌라나르에 있는 아스리다스 베어맨틀에게 가야 합니다.‡Ve a ver a Athridas Manto de Oso a Dolanaar.‡Ve a ver a Athridas Manto de Oso a Dolanaar.‡Retournez auprès d’Athridas Mantelours à Dolanaar.‡返回多兰纳尔去见阿斯瑞达斯·熊皮。‡到多蘭納爾找阿斯瑞達斯·熊皮。',
  }
},
[477] = {
  {
    'Cruzando fronteiras‡Пересечение границ‡Grenzübergänge‡마법사의 상자‡Pasa la frontera‡Pasa la frontera‡Frontières‡越境‡越境',
    nil,
    'Recupere o conteúdo de um dos caixotes dos teurgos de Dalaran. Você vai encontrar o Vilarejo Lenhardente ao sul.‡Раздобудьте содержимое одного из сундуков даларанских волшебников. Деревня Погребальных Костров находится на юге.‡Holt den Inhalt einer der Kisten von den Hexern aus Dalaran. Ihr findet Lohenscheit im Süden.‡달라란 마술사의 상자 중 하나의 내용물을 찾아 와야 합니다. 장작나무 마을은 남쪽에서 찾을 수 있습니다.‡Recupera el contenido de una de las cajas de zahoríes de Dalaran. Encontrarás la Aldea Piroleña hacia el sur.‡Recupera el contenido de una de las cajas de zahoríes de Dalaran. Encontrarás la Aldea Piroleña hacia el sur.‡Récupérer le contenu de l\'une des caisses des sorciers de Dalaran. Vous trouverez Bois-du-Bûcher au sud.‡从达拉然法师的木箱中拿出里面的东西。‡從達拉然巫師的木箱中拿出裡面的東西。',
  }
},
[478] = {
  {
    'Mapas e runas‡Карты и руны‡Karten und Runen‡지도와 룬문자 펜던트‡Mapas y runas‡Mapas y runas‡Des cartes et des runes‡地图与符记‡地圖與符記',
    nil,
    'Leve o estranho pingente para o Sacerdote Sombrio Allister, no Sepulcro.‡Отнесите странную подвеску жрецу Тьмы Алистеру в Гробницу.‡Bringt den seltsamen Anhänger zu Schattenpriester Allister in dem Grabmal.‡공동묘지에 있는 어둠의 사제 알리스터에게 룬문자 펜던트를 가져가야 합니다.‡Lleva el extraño colgante al sacerdote de las Sombras Allister en El Sepulcro.‡Lleva el extraño colgante al sacerdote de las Sombras Allister en El Sepulcro.‡Apportez l\'étrange pendentif au prêtre des ombres Allister au Sépulcre.‡将这个奇怪的坠饰交给瑟伯切尔的暗影牧师奥利斯特。‡將這個奇怪的墜飾交給瑟伯切爾的暗影牧師奧利斯特。',
  }
},
[479] = {
  {
    'Investigações de Lenhâmbar‡Расследование в Янтарной мельнице‡Nachforschungen in Mühlenbern‡호박색 농장 조사‡Las investigaciones de Molino Ámbar‡Las investigaciones de Molino Ámbar‡Enquête à Moulin-de-l\'Ambre‡调查安伯米尔‡調查安伯米爾',
    nil,
    'Obtenha 8 Pingentes de Dalaran para o Sacerdote Sombrio Allister, no Sepulcro.‡Добудьте 8 подвесок Даларана и отнесите  жрецу Тьмы Алистеру в Гробницу.‡Beschafft 8 Anhänger aus Dalaran für Schattenpriester Allister beim Grabmal.‡공동묘지의 어둠의 사제 알리스터가 달라란 펜던트 8개를 가져와 달라고 했습니다.‡Consigue 8 colgantes de Dalaran al sacerdote de las Sombras Allister en El Sepulcro.‡Consigue 8 colgantes de Dalaran al sacerdote de las Sombras Allister en El Sepulcro.‡Récupérer 8 Pendentifs de Dalaran pour le prêtre des ombres Allister du Sépulcre.‡为瑟伯切尔的暗影牧师奥利斯特抢到8个达拉然坠饰。‡為瑟伯切爾的暗影牧師奧利斯特搶到8個達拉然墜飾。',
  }
},
[480] = {
  {
    'O tecelão‡Ткач‡Der Wirker‡대마법사의 지팡이‡El Tejedor‡El Tejedor‡Le Tisserand‡法师的头领‡法師的頭領',
    nil,
    'Mate o arquimago de Dalaran, depois leve o cajado dele para o Sacerdote Sombrio Allister, no Sepulcro.‡Убейте даларанского верховного мага, заберите его посох и отнесите жрецу Тьмы Алистеру в Гробницу.‡Tötet den Erzmagier von Dalaran und bringt seinen Stab zu Schattenpriester Allister in dem Grabmal.‡달라란 대마법사 아태릭을 처치하고 그의 지팡이를 공동묘지에 있는 어둠의 사제 알리스터에게 가져가야 합니다.‡Mata al archimago Dalaran, recupera su bastón y llévaselo al sacerdote de las Sombras Allister en El Sepulcro.‡Mata al archimago Dalaran, recupera su bastón y llévaselo al sacerdote de las Sombras Allister en El Sepulcro.‡Tuer l\'archimage de Dalaran, puis récupérer son Bâton pour le prêtre des ombres Allister du Sépulcre.‡杀死达拉然大法师，并把他的法杖交给瑟伯切尔的暗影牧师奥利斯特。‡殺死達拉然大法師，並把他的法杖交給瑟伯切爾的暗影牧師奧利斯特。',
  }
},
[481] = {
  {
    '‡Анализ Далара‡Dalars Analyse‡‡El análisis de Dalar‡El análisis de Dalar‡L\'analyse de Dalar‡达拉尔的推理‡',
    nil,
    '‡Отнесите подвеску рунической надписи Далару Ткачу Рассвета в Гробницу.‡Bringt den mit Runen gravierten Anhänger zu Dalar Morgenweber in dem Grabmal.‡‡Lleva el colgante con runas grabadas a Dalar Tejealba en El Sepulcro.‡Lleva el colgante con runas grabadas a Dalar Tejealba en El Sepulcro.‡Apporter le Pendentif marqué de runes à Dalar Tisselaube au Sépulcre.‡把刻有符文的坠饰交给瑟伯切尔的达拉尔·道恩维沃尔。‡',
  }
},
[482] = {
  {
    '‡Планы Даларана‡Dalaran Absichten‡‡Las intenciones de los Dalaran‡Las intenciones de los Dalaran‡Les intentions de Dalaran‡达拉然的意图‡',
    nil,
    '‡Поговорите с темным жрецом Алистером в Гробнице.‡Sprecht mit dem Schattenpriester Allister in dem Grabmal.‡‡Habla con el sacerdote de las Sombras Allister en El Sepulcro.‡Habla con el sacerdote de las Sombras Allister en El Sepulcro.‡Parler au prêtre des ombres Allister au Sépulcre.‡与瑟伯切尔的暗影牧师奥利斯特谈一谈。‡',
  }
},
[483] = {
  {
    'As relíquias do despertar‡Реликвии Пробуждения‡Die Relikte des Erwachens‡깨움의 의식을 위한 재료‡Las Reliquias del Despertar‡Las Reliquias del Despertar‡Les reliques d\'éveil‡唤醒圣物‡喚醒聖物',
    nil,
    'Recupere as Relíquias do Despertar.‡Добудьте реликвии Пробуждения.‡Bergt die Relikte des Erwachens.‡깨움의 의식을 위한 재료를 구해야 합니다.‡Consigue las Reliquias del Despertar.‡Consigue las Reliquias del Despertar.‡Récupérez les Reliques d\'éveil et rapportez-les à Athridas Mantelours, à Dolanaar.‡找回四件唤醒圣物。‡尋回喚醒聖物。',
  }
},
[484] = {
  {
    'Crocolisco jovem é que dá pele boa‡Шкуры молодых кроколисков‡Häute junger Krokilisken‡새끼 악어 가죽‡Piel de crocolisco joven‡Piel de crocolisco joven‡Les peaux de jeune crocilisque‡小鳄鱼皮‡小鱷魚皮',
    nil,
    'Obtenha 4 Peles de Crocolisco Jovem para Iago Halberque, no Porto de Menethil.‡Принесите 4 шкуры молодых кроколисков Джеймсу Халлорану в Гавань Менетилов.‡Besorgt Euch 4 Häute junger Krokilisken für James Halloran im Hafen von Menethil.‡메네실 항구의 제임스 할로란이 새끼 악어 껍질 4장을 가져와 달라고 했습니다.‡Consigue 4 pieles de crocoliscos jóvenes para James Halloran de Puerto de Menethil.‡Consigue 4 pieles de crocoliscos jóvenes para James Halloran de Puerto de Menethil.‡Collecter 4 Peaux de jeune crocilisque, pour James Halloran, au port de Menethil.‡为米奈希尔港口的詹姆斯·哈洛兰带回4张小鳄鱼皮。‡為米奈希爾港口的詹姆士·哈洛倫帶回4張小鱷魚皮。',
  }
},
[485] = {
  {
    'Encontre OOX-09/HL!‡Найти КПХ-9/HL!‡Sucht OOX-09/HL!‡OOX-09/HL 수색‡¡Encuentra a OOX-09/TI!‡¡Encuentra a OOX-09/TI!‡Trouvez OOX-09/HL !‡找到OOX-09/HL！‡找到OOX-09/HL!',
    nil,
    'Leve o transmissor de emergência até o robô teleguiado de Olhatorto na cabeceira do rio, perto da Rocha Oculta, que fica nas Terras Agrestes.‡Отнесите аварийный маяк к автономному роботу Карлса. Робот находится во Внутренних землях, в устье реки близ Осклизлой скалы.‡Bringt das Notsignal zu Glotz\' Leitroboter an der Quelle des Flusses im Hinterland, in der Nähe vom Lauerfels.‡굼벵이 바위굴 근처, 동부 내륙지의 강이 시작되는 곳에 추락한 오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Lleva el localizador al robot mensajero de Oglethorpe, en el nacimiento del río de las Tierras del Interior, cerca de Roca Oculta.‡Lleva el localizador al robot mensajero de Oglethorpe, en el nacimiento del río de las Tierras del Interior, cerca de Roca Oculta.‡Apportez la balise de détresse jusqu\'au robot guidé d\'Orguignard, en haut de la rivière dans les Hinterlands, près du rocher de l\'Affût.‡把定位器带到奥格索普的母体机器人那里去。|n|n奥格索普的母体机器人位于辛特兰的河水源头，就在隐匿石的附近。‡把定位器帶到奧格索普的母體機器人那裡去。|n|n奧格索普的母體機器人位於辛特蘭的河水源頭，就在隱匿石的附近。',
  }
},
[486] = {
  {
    'Ursal, o Espancador‡Урсал Изверг‡Ursal der Raufer‡투사 우르살‡Ursal el Violento‡Ursal el Violento‡Ursal le Marteleur‡大槌乌萨尔‡『大槌』烏薩爾',
    nil,
    'Mate Ursal, o Espancador.‡Убейте Урсала Изверга.‡Tötet Ursal den Raufer.‡투사 우르살을 처치해야 합니다.‡Mata a Ursal el Violento.‡Mata a Ursal el Violento.‡Tuez Ursal le Marteleur.‡杀掉大槌乌萨尔。‡殺掉『大槌』烏薩爾。',
  }
},
[487] = {
  {
    'A estrada para Darnassus‡Дорога в Дарнас‡Die Straße nach Darnassus‡다르나서스로 가는 길‡El camino a Darnassus‡El camino a Darnassus‡La route de Darnassus‡达纳苏斯之路‡達納蘇斯之路',
    nil,
    'Mate 8 Emboscadores Masca-pinho.‡Убейте 8 душителей из племени Кривой Сосны.‡Erschlagt 8 Wegelagerer der Knarzklauen.‡나무옹이 복병 8마리를 처치해야 합니다.‡Acaba con 8 emboscadores Tuercepinos.‡Acaba con 8 emboscadores Tuercepinos.‡Tuez 8 Embusqués pins-tordus.‡杀掉8个瘤背伏击者。‡殺掉8個瘤背伏擊者。',
  }
},
[488] = {
  {
    'O comando de Zenn‡Просьба Зенна‡Zenns Aufträge‡젠의 부탁‡Las apuestas de Zenn‡Las apuestas de Zenn‡Les commandements de Zenn‡赛恩的要求‡賽恩的要求',
    nil,
    'Consiga 2 Presas de Sabre-da-noite, 2 Penas Estrígidas de Coruja e 2 amostras de Seda de Aranha Lenhateia.‡Достаньте 2 клыка ночного саблезуба, 2 пера островной совы и 2 мотка паутины чащобного тенетника.‡Erhaltet 2 Nachtsäblerfangzähne, 2 Strigideulenfedern und 2 Proben Waldweberspinnenseide.‡밤호랑이 송곳니 2개, 스트리기드 올빼미 깃털 2개, 나무그물거미의 거미줄 2개를 구해야 합니다.‡Consigue 2 colmillos de sable de la noche, 2 plumas de lechuza estrígida y 2 muestras de seda de araña Tejemadera.‡Consigue 2 colmillos de sable de la noche, 2 plumas de lechuza estrígida y 2 muestras de seda de araña Tejemadera.‡Récupérez 2 Crocs de sabre-de-nuit, 2 Plumes de hibou strigide et 2 échantillons de Soie d\'araignée tissebois.‡收集2颗夜刃豹的牙齿、2根巨翼枭的羽毛和2份树林蜘蛛丝。‡給多蘭納爾外面的賽恩‧腐蹄帶去2顆夜刃豹的牙齒、2根巨翼梟的羽毛和2份樹林蜘蛛絲。',
  }
},
[489] = {
  {
    'Consiga redenção!‡Искупление вины‡Sucht Befreiung!‡신뢰 회복!‡¡Búsqueda de redención!‡¡Búsqueda de redención!‡En quête de rédemption !‡寻求救赎！‡尋求救贖!',
    nil,
    'Colete 3 Pinhas Vis.‡Соберите 3 шишки Скверны.‡Sammelt 3 Teufelszapfen.‡악의 열매 3개를 모아야 합니다.‡Recoge 3 bellotas viles.‡Recoge 3 bellotas viles.‡Collectez 3 Gangrenoix.‡收集3个魔锥果。‡收集3個魔錐果。',
  }
},
[490] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Shayla Umbrísia, que está do lado de fora de Darnassus, quer que você lhe traga 20 Presas de Masca-pinho.‡Шейла Ночной Бриз у ворот Дарнаса просит принести ей 20 клыков фурболгов из племени Кривой Сосны.‡Shayla Nachtluft außerhalb von Darnassus möchte, dass Ihr ihr 20 Knarzklauenfangzähne bringt.‡다르나서스밖에 있는 샤일라 나이트브리즈가 나무옹이 송곳니 20개를 가져다 달라고 했습니다.‡Shayla Brisa Nocturna, en las afueras de Darnassus, desea que le traigas 20 colmillos de Tuercepinos.‡Shayla Brisa Nocturna, en las afueras de Darnassus, desea que le traigas 20 colmillos de Tuercepinos.‡Rapporter 20 Crocs de Pins-tordus à Shayla Noctebrise, à l\'extérieur de Darnassus.‡达纳苏斯外的莎依拉·夜风想要你带给她20个瘤背熊怪的牙齿。‡達納蘇斯外的莎依拉·夜風想要你帶給她20個瘤背熊怪的牙齒。',
  }
},
[491] = {
  {
    '‡Жезл для Бетора‡Zauberstab an Bethor‡‡Una varita para Bethor‡Una varita para Bethor‡Une Baguette pour Bethor‡给比索的魔杖‡',
    nil,
    '‡Отнесите Сплетенный жезл Бетору Ледострелу в Квартал Магов Подгорода.‡Bringt den gewebten Zauberstab zu Bethor Eismacht in das Magieviertel von Unterstadt.‡‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Apporter la Baguette tressée à Bethor Glacéclat dans le Quartier de la Magie à Fossoyeuse.‡将狼人魔杖带给幽暗城法师区的比索·埃斯沙德。‡',
  }
},
[492] = {
  {
    '‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une peste nouvelle‡新的瘟疫‡',
    nil,
    '‡Отнесите особый напиток Юхана пленному горному пехотинцу.‡Bringt Johaans Spezialgetränk zum gefangenen Gebirgsjäger.‡‡Llévale la bebida especial de Johaan al montaraz capturado.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Apporter la Boisson spéciale de Johaan au Montagnard captif.‡将乔汉的特制饮料交给被俘虏的巡山人。‡',
  }
},
[493] = {
  {
    'Jornada ao Contraforte de Eira dos Montes‡Путешествие в предгорья Хилсбрада‡Reise in das Vorgebirge des Hügellands‡언덕마루 구릉지로의 여정‡Viaja a Laderas de Trabalomas‡Viaja a Laderas de Trabalomas‡Voyage jusqu\'aux contreforts de Hautebrande‡前往希尔斯布莱德丘陵‡前往希爾斯布萊德丘陵',
    nil,
    'Entregue as descobertas do Boticário Renferrel ao Boticário Lindolfo na cidade de Serraria Tarren, que fica no Contraforte de Eira dos Montes.‡Отнесите находки аптекаря Ренферрела аптекарю Лидону в город Мельница Таррен в предгорьях Хилсбрада.‡Bringt die Funde von Apotheker Renferrel zu Apotheker Lydon nach Tarrens Mühle im Vorgebirge des Hügellands.‡언덕마루 구릉지의 타렌 제분소에 있는 연금술사 라이던에게 렐퍼럴의 연구 결과를 전달해야 합니다.‡Lleva el descubrimiento del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Lleva el descubrimiento del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Livrer les découvertes de l\'Apothicaire Renferrel à l\'Apothicaire Lydon à Moulin-de-Tarren dans les contreforts de Hautebrande.‡将伦弗利尔的研究成果交给希尔斯布莱德山脚下塔伦米尔的药剂师林度恩。‡將倫弗利爾的研究成果交給希爾斯布萊德丘陵塔倫米爾的藥劑師林度恩。',
  }
},
[494] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED] 进攻的时机‡',
    nil,
    '‡‡‡‡‡‡‡到塔伦米尔去，把亡灵哨兵莱什的口信带给高级执行官达萨利亚。‡',
  }
},
[495] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡Corona de Voluntad‡Corona de Voluntad‡La couronne de volonté‡意志之冠‡意志之冠',
    nil,
    'Apresente-se a Melissara, na Serraria Tarren, no Contraforte de Eira dos Montes.‡Поговорите с Мелизарой в Мельнице Таррен в предгорьях Хилсбрада.‡Meldet Euch bei Melisara in Tarrens Mühle im Vorgebirge des Hügellands.‡언덕마루 구릉지의 타렌 제분소에 있는 멜리사라에게 보고해야 합니다.‡Preséntate ante Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Preséntate ante Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Présentez-vous à Melisara, à Moulin-de-Tarren, dans les Contreforts de Hautebrande.‡到希尔斯布莱德丘陵去，向塔伦米尔的梅里萨拉报到。‡到希爾斯布萊德丘陵去，向塔倫米爾的梅里薩拉報到。',
  }
},
[496] = {
  {
    '[DEPRECATED] Elixir of Suffering‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡[DEPRECATED]Elixir de sufrimiento‡[DEPRECATED]Elixir de sufrimiento‡[PÉRIMÉ]L\'élixir de souffrance‡[DEPRECATED] 沉醉之药‡[DEPRECATED] Elixir of Suffering',
    nil,
    'Boticário Lindolfo, de Serraria Tarren, quer 10 Línguas de Urso Cinzento e um pouco de Pus de Rastejante.‡Аптекарь Лидон из Мельницы Таррен попросил принести ему 10 языков серых медведей и немного лимфы паука-охотника.‡Apotheker Lydon aus Tarrens Mühle möchte 10 Graubärzungen und etwas Krabblersekret.‡타렌 제분소에 있는 연금술사 라이던이 회색곰 혀 10개와 이끼거미 수액을 구해다 달라고 했습니다.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡Apporter 10 Langues d\'ours gris et de l\'Ichor de Rampemousse à l\'Apothicaire Lydon à Moulin-de-Tarren.‡塔伦米尔的药剂师林度恩要你去收集10个灰熊的舌头和一些食苔蛛的毒液。‡塔倫米爾的藥劑師林度恩要你去收集10個灰熊的舌頭和一些食苔蛛的毒液。',
  }
},
[497] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Go to Tarren Mill and find out the status of the party sent by Thrall.‡Отправляйтесь на Мельницу Таррен и выясните, что удалось узнать разведотряду Тралла.‡Geht nach Tarrens Mühle und erkundet den Zustand der Truppe, die Thrall geschickt hat.‡타렌 제분소로 가서 스랄의 파견 부대가 어떻게 되었는지 알아내야 합니다.‡Ve a Molino Tarren y descubre qué ha sido del grupo enviado por Thrall.‡Ve al Molino Tarren e investiga cómo está el equipo que envió Thrall.‡Allez à Moulin-de-Tarren et renseignez-vous sur le sort du groupe envoyé par Thrall.‡到塔伦米尔去调查萨尔派出的小分队的状况。‡前往塔倫米爾，查出索爾派遣出的小隊的狀況。',
  }
},
[498] = {
  {
    '[DEPRECATED] The Rescue‡Спасение‡Die Rettung‡포로 구출‡[DEPRECATED]El rescate‡[DEPRECATED]El rescate‡[PÉRIMÉ]Sauvetage‡[DEPRECATED] 拯救行动‡[DEPRECATED] The Rescue',
    nil,
    'Krusk, da Serraria Tarren, precisa que você liberte Drull e Tog\'thar do Forte do Desterro.‡Krusk in Tarren Mill needs you to free Drull and Tog\'thar from Durnholde Keep.‡Krusk in Tarrens Mühle braucht Euch, um Drull und Tog\'thar aus der Burg Durnholde zu befreien.‡타렌 제분소에 있는 크루스크가 던홀드 요새에서 드럴과 토그타르를 구출해 달라고 했습니다.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Selon les ordres de Krusk à Moulin-de-Tarren, libérer Drull et Tog\'thar du donjon de Fort-de-Durn.‡塔伦米尔的克鲁斯克要你把德鲁尔和托格萨从敦霍尔德城堡救出来。‡塔倫米爾的克魯斯克要你把德盧爾和托格薩從敦霍爾德城堡救出來。',
  }
},
[500] = {
  {
    '[DEPRECATED] Crushridge Bounty‡Награда Раздробленного Хребта‡[DEPRECATED] Trümmergratkopfgeld‡산사태 일족 현상금‡[DEPRECATED]La recompensa Aplastacresta‡[DEPRECATED]La recompensa Aplastacresta‡[PÉRIMÉ]La prime Cassecrête‡[DEPRECATED] 破碎岭食人魔‡[DEPRECATED] Crushridge Bounty',
    nil,
    'Reúna 9 Nós dos Dedos Sujos dos Ogros Massacrista nas Montanhas de Alterac. Leve-os para o Delegado Trilharrubra, na Costa Sul.‡Соберите 9 грязных бабок у огров из клана Раздробленного Хребта в Альтеракских горах. Принесите их маршалу Редпату в Южнобережье.‡Sammelt 9 schmutzige Knöchelknochen von Trümmergratogern im Alteracgebirge. Bringt sie zu Marschall Rotpfad in Süderstade.‡알터랙 산맥에 있는 산사태 오우거에게서 더러운 손가락 뼈 9개를 모은 후 남녘해안에 있는 치안대장 레드패스에게 가져가야 합니다.‡Recoge 9 nudillos sucios de ogros Aplastacresta en las Montañas de Alterac. Llévaselos al alguacil Rutagrana a Costasur.‡Recoge 9 nudillos sucios de ogros Aplastacresta en las Montañas de Alterac. Llévaselos al alguacil Rutagrana a Costasur.‡Collecter 9 Articulations sales d\'ogres Cassecrête dans les montagnes d\'Alterac. Les apporter au Maréchal Senterouge à Austrivage.‡从奥特兰克山的破碎岭食人魔身上收集9个肮脏的指节骨，把它们带给南海镇的治安官雷德帕斯。‡從奧特蘭克山的破碎嶺巨魔身上收集9個骯髒的指節骨，把它們帶給南海鎮的治安官雷德帕斯。',
  }
},
[501] = {
  {
    '[DEPRECATED] Elixir of Pain‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡[DEPRECATED]Elixir de dolor‡[DEPRECATED]Elixir de dolor‡[PÉRIMÉ]L\'élixir de douleur‡[DEPRECATED] 镇魂之药‡[DEPRECATED] Elixir of Pain',
    nil,
    'Leve 10 Ampolas de Sangue de Leão da Montanha para o Boticário Lindolfo na Serraria Tarren.‡Принесите 10 сосудов крови горного льва аптекарю Лидону из Мельницы Таррен.‡Bringt 10 Phiolen mit Berglöwenblut zu Apotheker Lydon in Tarrens Mühle.‡타렌 제분소에 있는 연금술사 라이던에게 산사자 피 10병을 가져가야 합니다.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Apporter 10 Fioles de sang de lion des montagnes à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集10瓶山地狮的血液，把它们交给塔伦米尔的药剂师林度恩。‡收集10瓶山地獅的血液，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[502] = {
  {
    '[DEPRECATED] Elixir of Pain‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡[DEPRECATED]Elixir de dolor‡[DEPRECATED]Elixir de dolor‡[PÉRIMÉ]L\'élixir de douleur‡[DEPRECATED] 镇魂之药‡[DEPRECATED] Elixir of Pain',
    nil,
    'Alimente Fido com o Elixir da Dor.‡Напоите Стэнли эликсиром Боли.‡Füttert Stanley mit dem Elixier der Schmerzen.‡스탠리에게 고통의 비약을 먹여야 합니다.‡Dale el elixir de dolor a Stanley.‡Dale el elixir de dolor a Stanley.‡Donner l\'Elixir de douleur à Stanley.‡把痛苦药剂喂给小狗斯坦雷。‡把痛苦藥劑餵給小狗斯坦利。',
  }
},
[503] = {
  {
    '[DEPRECATED] Gol\'dir‡Гол\'дир‡Gol\'dir‡골디르‡[DEPRECATED]Gol\'dir‡[DEPRECATED]Gol\'dir‡[PÉRIMÉ]Gol\'dir‡[DEPRECATED] 高迪尔‡[DEPRECATED] Gol\'dir',
    nil,
    'Liberte Gol\'dir e fale novamente com Krusk na Serraria Tarren.‡Освободите Гол\'дира и возвращайтесь к Круску в Мельницу Таррен.‡Befreit Gol\'dir und kehrt dann zu Krusk in Tarrens Mühle zurück.‡골디르를 구출하여 타렌 제분소에 있는 크루스크에게 가야 합니다.‡Libera a Gol\'dir e informa a Krusk en Molino Tarren.‡Libera a Gol\'dir e informa a Krusk en Molino Tarren.‡Libérer Gol\'dir et retourner voir Krusk à Moulin-de-Tarren.‡救出高迪尔，然后回到塔伦米尔去见克鲁斯克。‡救出高迪爾，然後回到塔倫米爾去見克魯斯克。',
  }
},
[504] = {
  {
    '[DEPRECATED] Crushridge Warmongers‡Наемники клана Раздробленного Хребта‡[DEPRECATED] Kriegstreiber der Trümmergratoger‡산사태 전사‡[DEPRECATED]Belicistas Aplastacresta‡[DEPRECATED]Belicistas Aplastacresta‡[PÉRIMÉ]Les combattants cassecrêtes‡[DEPRECATED] 破碎岭好战者‡[DEPRECATED] Crushridge Warmongers',
    nil,
    'Mate 10 Fomentadores da Guerra Massacrista, depois fale novamente com o Delegado Trilharrubra na Costa Sul.‡Убейте 10 наемников из клана Раздробленного Хребта и возвращайтесь к маршалу Редпату в Южнобережье.‡Erschlagt 10 Kriegstreiber der Trümmergratoger und kehrt dann zu Marschall Rotpfad in Süderstade zurück.‡산사태 전사 10마리를 처치한 다음 남녘해안에 있는 치안대장 레드패스에게 가야 합니다.‡Mata a 10 belicistas Aplastacresta y vuelve a hablar con el alguacil Rutagrana en Costasur.‡Mata a 10 belicistas Aplastacresta y vuelve a hablar con el alguacil Rutagrana en Costasur.‡Tuez 10 Combattants Cassecrête, puis retournez voir le Maréchal Senterouge, à Austrivage.‡杀死10个破碎岭好战者，然后回南海镇向治安官雷德帕斯报告。‡殺死10個破碎嶺好戰者，然後回南海鎮向治安官雷德帕斯報告。',
  }
},
[505] = {
  {
    '[DEPRECATED] Syndicate Assassins‡Убийцы из Синдиката‡[DEPRECATED] Auftragsmörder des Syndikats‡비밀결사대 암살자‡[DEPRECATED]Hermandad de asesinos‡[DEPRECATED]Hermandad de asesinos‡[PÉRIMÉ]Syndicat d\'assassins‡[DEPRECATED] 辛迪加刺客‡[DEPRECATED] Syndicate Assassins',
    nil,
    'Mate 12 Salteadores da Camarilha e 8 Ladrões da Camarilha, depois fale novamente com o Magistrado Henrique Maleb na Costa Sul.‡Убейте 12 преступников и 8 воров Синдиката и возвращайтесь к мировому судье Генри Малебу в Южнобережье.‡Tötet 12 Schleicher des Syndikats und 8 Diebe des Syndikats, kehrt dann zurück zu Magistrat Henry Maleb nach Süderstade.‡비밀결사대 노상강도 12명과 비밀결사대 도둑 8명을 처치한 다음 남녘해안에 있는 집정관 헨리 말레브에게 가야 합니다.‡Mata a 12 asaltantes de caminos y 8 ladrones de la Hermandad e informa al magistrado Henry Maleb en Costasur.‡Mata a 12 asaltantes de caminos y 8 ladrones de la Hermandad e informa al magistrado Henry Maleb en Costasur.‡Tuer 12 Détrousseurs du Syndicat et 8 Larrons du Syndicat puis retourner voir le magistrat Henry Maleb à Austrivage.‡杀死12个辛迪加劫匪和8个辛迪加潜行者，然后回到南海镇向赫尼·马雷布镇长报到。‡殺死12個辛迪加劫匪和8個辛迪加盜賊，然後回到南海鎮向赫尼·馬雷布鎮長報到。',
  }
},
[507] = {
  {
    '[DEPRECATED] Lord Aliden Perenolde‡Лорд Алиден Перенольд‡Lord Aliden Perenolde‡앨리덴 페레놀드 경‡[DEPRECATED]Lord Aliden Perenolde‡[DEPRECATED]Lord Aliden Perenolde‡[PÉRIMÉ]Seigneur Aliden Perenolde‡[DEPRECATED] 奥里登·匹瑞诺德‡[DEPRECATED] Lord Aliden Perenolde',
    nil,
    'Mate Lorde Aliden Perenolde e pergunte à sua concubina, Elysa, sobre o pingente de Taretha.‡Убейте лорда Алидена Перенольда и допросите его любовницу Элайзу насчет ожерелья Тареты.‡Tötet Lord Aliden Perenolde und befragt seine Geliebte Elysa nach Tarethas Anhänger.‡앨리덴 페레놀드 경을 처치하고 그의 부인 엘리사에게 타레사의 펜던트에 대해서 물어봐야 합니다.‡Mata a Lord Aliden Perenolde y pregunta a su querida, Elysa, por el colgante de Taretha.‡Mata a Aliden Perenolde y pregunta a su querida, Elysa, por el colgante de Taretha.‡Tuer le Seigneur Aliden Perenolde et interroger sa maîtresse, Elysa, au sujet du Pendentif de Taretha.‡杀了奥里登·匹瑞诺德领主，并从他的情人艾丽萨身上拿回塔蕾莎的项链。‡殺了奧里登·匹瑞諾德領主，並向他的情人艾麗莎詢問塔蕾莎的項鍊下落。',
  }
},
[508] = {
  {
    '‡Подарок Тареты‡Tarethas Geschenk‡‡[DEPRECATED]Un regalo de Taretha‡‡[PÉRIMÉ]Le cadeau de Taretha‡‡',
    nil,
    '‡Верните ожерелье Тареты Круску в деревню Мельница Таррен, что в Предгорьях Хилсбрада.‡Bringt Tarethas Anhänger zu Krusk nach Tarrens Mühle im Vorgebirge des Hügellands.‡‡Devuélvele el colgante de Taretha a Krusk, que está en el Molino Tarren, en las Laderas de Trabalomas.‡Devuélvele el colgante de Taretha a Krusk, que está en el Molino Tarren, en las Laderas de Trabalomas.‡Rapporter le Pendentif de Taretha à Krusk à Moulin-de-Tarren, aux Contreforts de Hautebrande.‡把塔蕾莎的项链交还给塔伦米尔的克鲁斯克。‡',
  }
},
[509] = {
  {
    '[DEPRECATED] Elixir of Agony‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡[DEPRECATED]Elixir de agonía‡[DEPRECATED]Elixir de agonía‡[PÉRIMÉ]L\'élixir d\'agonie‡[DEPRECATED] 破除天灾‡[DEPRECATED] Elixir of Agony',
    nil,
    'Leve 6 Cogumelos Fuçalama para o Boticário Lindolfo na Serraria Tarren.‡Принесите 6 цветков грязного рыла аптекарю Лидону из Мельницы Таррен.‡Bringt 6 Morastschnauzenkappen zu Apotheker Lydon in Tarrens Mühle.‡타렌 제분소에 있는 연금술사 라이던에게 진흙주둥이꽃 6개를 가져가야 합니다.‡Lleva 6 flores Morrobarro al boticario Lydon de Molino Tarren.‡Lleva 6 flores Morrobarro al boticario Lydon de Molino Tarren.‡Apporter 6 Fleurs de fangemufle à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集6朵泥头花，把它们交给塔伦米尔的药剂师林度恩。‡收集6朵泥頭花，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[510] = {
  {
    '[DEPRECATED] Foreboding Plans‡Зловещие планы‡Furchteinflößende Pläne‡불길한 예감이 드는 계획서‡[DEPRECATED]Documentos de planificación‡[DEPRECATED]Documentos de planificación‡[PÉRIMÉ]Documents d\'annonce d\'attaque‡[DEPRECATED] 预备行动计划‡[DEPRECATED] Foreboding Plans',
    nil,
    'Leve os Planos Agourentos ao Magistrado Maleb na Costa Sul.‡Отнесите зловещие планы мировому судье Южнобережья Малебу.‡Bringt die furchteinflößenden Pläne zu Magistrat Henry Maleb nach Süderstade.‡남녘해안에 있는 집정관 말레브에게 불길한 예감이 드는 계획서를 가져가야 합니다.‡Lleva los documentos de planificación al magistrado Maleb a Costasur.‡Lleva los documentos de planificación al magistrado Maleb a Costasur.‡Apportez les Documents d\'annonce d\'attaque au Magistrat Maleb à Austrivage.‡把预备行动计划带给南海镇的赫尼·马雷布镇长。‡把預備行動計畫帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[511] = {
  {
    '[DEPRECATED] Encrypted Letter‡Зашифрованное письмо‡Verschlüsselter Brief‡암호화된 편지‡[DEPRECATED]Una carta cifrada‡[DEPRECATED]Una carta cifrada‡[PÉRIMÉ]Lettre codée‡[DEPRECATED] 密文信件‡[DEPRECATED] Encrypted Letter',
    nil,
    'Leve a Carta Cifrada para o Historiador Dibbs em Costa Sul.‡Отнесите зашифрованное письмо хранителю мудрости Диббсу в Южнобережье.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Süderstade.‡남녘해안에 있는 현자 딥스에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta cifrada al maestro cultural Dibbs en Costasur.‡Lleva la carta cifrada al maestro cultural Dibbs en Costasur.‡Apportez la Lettre codée au Maître des traditions Dibbs, à Austrivage.‡把密码信交给南海镇的博学者迪布斯。‡把密碼信交給南海鎮的博學大師迪布斯。',
  }
},
[512] = {
  {
    '[DEPRECATED] Noble Deaths‡Благородные смерти‡Tod der Edlen‡지휘부 처치‡[DEPRECATED]Nobles muertes‡[DEPRECATED]Nobles muertes‡[PÉRIMÉ]Nobles morts‡[DEPRECATED] 贵族之死‡[DEPRECATED] Noble Deaths',
    nil,
    'Leve 7 Anéis-sinete de Alterac para o Magistrado Maleb na Costa Sul.‡Принесите 7 альтеракских перстней-печаток мировому судье Малебу в Южнобережье.‡Bringt 7 Alteracsiegelringe zu Magistrat Henry Maleb nach Süderstade.‡남녘해안에 있는 집정관 말레브에게 알터랙 인장 반지 7개를 가져가야 합니다.‡Lleva 7 sellos de Alterac al magistrado Maleb a Costasur.‡Lleva 7 sellos de Alterac al magistrado Maleb a Costasur.‡Apporter 7 Chevalières d\'Alterac au Magistrat Maleb à Austrivage.‡为南海镇的赫尼·马雷布镇长收集7个奥特兰克徽记之戒。‡為南海鎮的赫尼·馬雷布鎮長收集7個奧特蘭克璽戒。',
  }
},
[513] = {
  {
    '[DEPRECATED] Elixir of Agony‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡[DEPRECATED]Elixir de agonía‡[DEPRECATED]Elixir de agonía‡[PÉRIMÉ]L\'élixir d\'agonie‡[DEPRECATED] 破除天灾‡[DEPRECATED] Elixir of Agony',
    nil,
    'Leve o Composto Fuçalama para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите смесь из цветков Грязного Рыла опытному аптекарю Фаранеллу в Подгород.‡Bringt das Morastschnauzengemisch zu Apothekermeister Faranell in Unterstadt.‡언더시티에 있는 수석 연금술사 파라넬에게 진흙주둥이 합성물을 가져가야 합니다.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Apporter la Poudre de fangemufle au maître apothicaire Faranell à Fossoyeuse.‡把泥头花药交给幽暗城的大药剂师法拉尼尔。‡把泥頭花藥交給幽暗城的藥劑大師法拉尼爾。',
  }
},
[514] = {
  {
    '[DEPRECATED] Letter to Stormpike‡Письмо Грозовой Вершине‡Brief an Sturmlanze‡스톰파이크에게 보내는 편지‡[DEPRECATED]Una carta para Pico Tormenta‡[DEPRECATED]Una carta para Pico Tormenta‡[PÉRIMÉ]Le maître des lettres‡[DEPRECATED] 铁炉堡的译码者‡[DEPRECATED] Letter to Stormpike',
    nil,
    'Leve a Carta Habilmente Cifrada para o Prospector Lançatroz em Altaforja.‡Отнесите хитро зашифрованное письмо геологу Грозовой Вершине в Стальгорн.‡Bringt den geschickt verschlüsselten Brief zu Ausgrabungsleiter Sturmlanze nach Eisenschmiede.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta cifrada con ingenio al prospector Pico Tormenta a Forjaz.‡Lleva la carta cifrada con ingenio al prospector Pico Tormenta a Forjaz.‡Apporter la Lettre ingénieusement codée au Prospecteur Foudrepique à Forgefer.‡把密码信带给铁炉堡的勘察员塔伯斯·雷矛。‡把密碼信帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[515] = {
  {
    '[DEPRECATED] Elixir of Agony‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡[DEPRECATED]Elixir de agonía‡[DEPRECATED]Elixir de agonía‡[PÉRIMÉ]L\'élixir d\'agonie‡[DEPRECATED] 破除天灾‡[DEPRECATED] Elixir of Agony',
    nil,
    'Leve a Mistura Fuçalama, uma Poção Forte de Sangue de Troll, 5 Escamas de Espinhadaga e 5 Olhos de Rancapina para o Boticário Lindolfo, na Serraria Tarren.‡Отнесите микстуру грязного рыла, крепкое зелье тролльей крови, 5 чешуек наг из клана Пронзающего Гребня и 5 глаз мурлоков из племени Рваного Плавника аптекарю Лидону в Мельницу Таррен.‡Bringt die Morastschnauzenmixtur, einen starken Trollbluttrank, 5 Säbelflossenschuppen und 5 Fetzenflossenaugen zu Apotheker Lydon nach Tarrens Mühle.‡타렌 제분소에 있는 연금술사 라이던에게 진흙주둥이 혼합물, 강렬한 트롤의 피 비약, 비수가시 비늘 5개, 그리고 너덜지느러미 눈 5개를 가져가야 합니다.‡Lleva la mezcla Morrobarro, una poción de sangre de trol fuerte, 5 escamas Espinadaga y 5 ojos de aleta rasgados al boticario Lydon a Molino Tarren.‡Lleva la mezcla Morrobarro, una poción de sangre de trol fuerte, 5 escamas Espinadaga y 5 ojos de aleta rasgados al boticario Lydon a Molino Tarren.‡Apportez le Brouet de fangemufle, une Potion de sang de troll forte, 5 Écailles de Daguéchine et 5 Yeux d\'Ailerons déchirés à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把泥头花水、1瓶强力巨魔之血药水、5块刺脊纳迦的鳞片和5颗碎鳍鱼人的眼球交给塔伦米尔的药剂师林度恩。‡把泥頭花水、1瓶強力食人妖之血藥水、5塊刺脊納迦的鱗片和5顆碎鰭魚人的眼球交給塔倫米爾的藥劑師林度恩。',
  }
},
[516] = {
  {
    'Cilada de Beren‡Погибель Берена‡Berens List‡베렌의 동굴‡El Desafío de Beren‡El Desafío de Beren‡Le Péril de Beren‡博伦的巢穴‡博倫的巢穴',
    nil,
    'Encontre a Cilada de Beren, mate 6 Mourejantes Corvinalle e 6 Guardiões Corvinalle e depois fale novamente com o Sacerdote Sombrio Allister, no Sepulcro.‡Найдите Погибель Берена, убейте 6 чернорабочих Когтя Ворона и 6 стражей Когтя Ворона, а затем вернитесь в Гробницу к жрецу Тьмы Алистеру.‡Findet zuerst Berens List, tötet 6 Zwangsarbeiter von Rabenklaue sowie 6 Wächter von Rabenklaue und kehrt dann zu Schattenpriester Allister in das Grabmal zurück.‡베렌의 동굴에서 까마귀발톱 노역꾼 6명과 까마귀발톱 수호병 6명을 처치하고 공동묘지에 있는 어둠의 사제 알리스터에게 가야 합니다.‡Encuentra El Desafío de Beren y, a continuación, mata 6 braceros Corvozarpa y 6 guardianes Corvozarpa. Por último, vuelve a ver al sacerdote de las Sombras Allister en El Sepulcro.‡Encuentra El Desafío de Beren y, a continuación, mata 6 esclavos Corvozarpa y 6 guardianes Corvozarpa. Por último, vuelve a ver al sacerdote de las Sombras Allister en El Sepulcro.‡Localiser le Péril de Beren, tuer 6 Manouvriers Serres-de-corbeau et 6 Gardiens Serres-de-corbeau puis retourner voir le prêtre des ombres Allister au Sépulcre.‡找到博伦的巢穴，杀死6名鸦爪苦工和6名鸦爪守护者，然后向瑟伯切尔的暗影牧师奥利斯特汇报。‡找到博倫的巢穴，殺死6名鴉爪苦工和6名鴉爪守護者，然後向瑟伯切爾的暗影牧師奧利斯特彙報。',
  }
},
[517] = {
  {
    '[DEPRECATED] Elixir of Agony‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡[DEPRECATED]Elixir de agonía‡[DEPRECATED]Elixir de agonía‡[PÉRIMÉ]L\'élixir d\'agonie‡[DEPRECATED] 破除天灾‡[DEPRECATED] Elixir of Agony',
    nil,
    'Leve o Barril de Stout do Festeiro para o Boticário Lindolfo na Serraria Tarren.‡Принесите бочонок "Землекопского крепкого" аптекарю Лидону из Мельницы Таррен.‡Bringt ein Fässchen mit Kniegräberstarkbier zu Apotheker Lydon nach Tarrens Mühle.‡타렌 제분소에 있는 연금술사 라이던에게 신디거 스타우트 맥주통을 가져가야 합니다.‡Lleva un barril de cerveza Machacacanillas al boticario Lydon de Molino Tarren.‡Lleva un barril de cerveza Machacacanillas al boticario Lydon de Molino Tarren.‡Apporter un Tonneau de Croquejarret brune à l\'Apothicaire Lydon à Moulin-de-Tarren.‡将一桶矿工烈酒交给塔伦米尔的药剂师林度恩。‡將一桶礦工烈酒交給塔倫米爾的藥劑師林度恩。',
  }
},
[518] = {
  {
    '[DEPRECATED] The Crown of Will‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡[DEPRECATED]Corona de Voluntad‡[DEPRECATED]Corona de Voluntad‡[PÉRIMÉ]La couronne de volonté‡[DEPRECATED] 意志之冠‡[DEPRECATED] The Crown of Will',
    nil,
    'Mate 10 Espancadores Massacristas para Melissara na Serraria Tarren.‡Убейте 10 извергов из клана Раздробленного Хребта по поручению Мелизары из Мельницы Таррен.‡Tötet 10 Raufer der Trümmergratoger für Melisara in Tarrens Mühle.‡타렌 제분소에 있는 멜리사라를 위해 산사태 싸움꾼 10마리를 처치해야 합니다.‡Melisara de Molino Tarren quiere que mates a 10 aplastadores Aplastacresta.‡Melisara de Molino Tarren quiere que mates a 10 aplastadores Aplastacresta.‡Tuer 10 Marteleurs Cassecrête pour Melisara à Moulin-de-Tarren.‡塔伦米尔的梅里萨拉要你去杀掉10个破碎岭虐待者。‡塔倫米爾的梅里薩拉要你去殺掉10個破碎嶺虐待者。',
  }
},
[519] = {
  {
    '[DEPRECATED] The Crown of Will‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡[DEPRECATED]Corona de Voluntad‡[DEPRECATED]Corona de Voluntad‡[PÉRIMÉ]La couronne de volonté‡[DEPRECATED] 意志之冠‡[DEPRECATED] The Crown of Will',
    nil,
    'Mate Targ, Revirestrume e Glommus e leve a cabeça deles para Melissara na Serraria Tarren.‡Убейте Тарга, Навозера и Гломмуса и принесите их головы Мелизаре из Мельницы Таррен.‡Tötet Targ, Muckrake und Glommus und bringt ihre Köpfe zu Melisara nach Tarrens Mühle.‡타르그, 무크라케, 글롬무스를 처치하고 그 증거로 그들의 머리카락을 타렌 제분소에 있는 멜리사라에게 가져가야 합니다.‡Mata a Targ, Rastrazo y Glommus y lleva sus cabezas a Melisara a Molino Tarren.‡Mata a Targ, Rastrazo y Glommus y lleva sus cabezas a Melisara a Molino Tarren.‡Tuer Targ, Fouilleboue et Glommus, puis apporter leurs têtes à Melisara, à Moulin-de-Tarren.‡干掉塔尔格、玛克拉克和戈洛姆斯，把他们的徽记带给塔伦米尔的梅里萨拉。‡幹掉塔爾格、瑪克拉克和戈洛姆斯，把他們的頭帶給塔倫米爾的梅里薩拉。',
  }
},
[520] = {
  {
    '[DEPRECATED] The Crown of Will‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡[DEPRECATED]Corona de Voluntad‡[DEPRECATED]Corona de Voluntad‡[PÉRIMÉ]La couronne de volonté‡[DEPRECATED] 意志之冠‡[DEPRECATED] The Crown of Will',
    nil,
    'Mate Mug\'Thol, e leve a cabeça dele com a Coroa da Vontade para Melissara na Serraria Tarren.‡Убейте Муг\'Тола и принесите его голову и корону воли Мелизаре в Мельницу Таррен.‡Tötet Mug\'Thol und bringt seinen Kopf mit der Krone des Willens zu Melisara nach Tarrens Mühle.‡무그톨을 처치하고 그 증거로 그의 머리카락과 의지의 왕관을 타렌 제분소에 있는 멜리사라에게 가져가야 합니다.‡Mata a Jarra\'thol y lleva su cabeza con la Corona de Voluntad a Melisara a Molino Tarren.‡Mata a Jarra\'thol y lleva su cabeza con la Corona de Voluntad a Melisara a Molino Tarren.‡Tuer Mug\'Thol et présenter sa tête et la Couronne de volonté à Melisara, à Moulin-de-Tarren.‡杀了玛格索尔，带着他的徽记和意志之冠去塔伦米尔见梅里萨拉。‡殺了瑪格索爾，帶著他的腦袋和意志之冠去塔倫米爾見梅里薩拉。',
  }
},
[521] = {
  {
    '[DEPRECATED] The Crown of Will‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡[DEPRECATED]Corona de Voluntad‡[DEPRECATED]Corona de Voluntad‡[PÉRIMÉ]La couronne de volonté‡[DEPRECATED] 意志之冠‡[DEPRECATED] The Crown of Will',
    nil,
    'Entregue a Coroa da Vontade à Sharlindra na Cidade Baixa.‡Отнесите корону Воли Шарлиндре из Подгорода.‡Bringt die Krone des Willens zu Sharlindra in Unterstadt.‡언더시티에 있는 샬린드라에게 의지의 왕관을 가져가야 합니다.‡Ve a Entrañas para entregarle la Corona de la Voluntad a Sharlindra.‡Ve a Entrañas para entregarle la Corona de Voluntad a Sharlindra.‡Remettre la Couronne de volonté à Sharlindra, à Fossoyeuse.‡把意志之冠交给幽暗城的沙琳德拉。‡把意志之冠交給幽暗城的沙琳德拉。',
  }
},
[522] = {
  {
    '‡Контракт убийцы‡Auftragsmördervertrag‡청부업자의 계약서‡[DEPRECATED]Contrato de asesino‡‡[PÉRIMÉ]Contrat de l\'assassin‡[DEPRECATED] 刺客的契约‡',
    nil,
    '‡Отнесите контракт убийцы мировому судье Малебу в Южнобережье.‡Bringt den Auftragsmördervertrag zu Magistrat Maleb nach Süderstade.‡‡Lleva el contrato de asesinato al magistrado Maleb a Costasur.‡Lleva el contrato de asesinato al magistrado Maleb a Costasur.‡Apportez le Contrat de l\'assassin au Magistrat Maleb à Austrivage.‡把刺客的契约带给南海镇的赫尼·马雷布镇长。‡',
  }
},
[523] = {
  {
    '[DEPRECATED] Baron\'s Demise‡Смерть барона‡Ableben des Barons‡바르두스 남작 심판‡[DEPRECATED]Muerte al Barón‡[DEPRECATED]Muerte al Barón‡[PÉRIMÉ]La mort du baron Vardus‡[DEPRECATED] 男爵之死‡[DEPRECATED] Baron\'s Demise',
    nil,
    'Leve a Cabeça do Barão Vardus ao Magistrado Maleb na Costa Sul.‡Принесите голову барона Вардуса мировому судье Малебу в Южнобережье.‡Bringt den Kopf von Baron Vardus zu Magistrat Maleb nach Süderstade.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 남녘해안에 있는 집정관 말레브에게 가져가야 합니다.‡Lleva la cabeza del Barón Vardus al magistrado Maleb a Costasur.‡Lleva la cabeza del Barón Vardus al magistrado Maleb a Costasur.‡Apportez la tête du baron Vardus au Magistrat Maleb à Austrivage.‡把瓦杜斯男爵的徽记带给南海镇的赫尼·马雷布镇长。‡把瓦杜斯男爵的頭帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[525] = {
  {
    'Outros mistérios‡Все больше тайн‡Weitere Geheimnisse‡깊어지는 의문‡Más misterios‡Más misterios‡D\'autres mystères‡更大的谜团‡更大的謎團',
    nil,
    'Entregue a Carta Decifrada para o Magistrado Maleb, em Costa Sul.‡Доставьте расшифрованное письмо мировому судье Южнобережья Малебу.‡Bringt den entschlüsselten Brief zu Magistrat Maleb nach Süderstade.‡남녘해안에 있는 집정관 말레브에게 해독된 편지를 가져가야 합니다.‡Lleva la carta descifrada al magistrado Maleb a Costasur.‡Lleva la carta descifrada al magistrado Maleb a Costasur.‡Apportez la Lettre décodée au Magistrat Maleb, à Austrivage.‡把被破译的信件交给南海镇的赫尼·马雷布镇长。‡把被破譯的信件交給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[526] = {
  {
    'Lingotes da forja de luz‡Слитки светостали‡Lichtschmiedeblöcke‡라이트포지 주괴‡Lingotes Forjaluz‡Lingotes Forjaluz‡Les lingots de sancteforge‡光铸铁锭‡光鑄鐵錠',
    nil,
    'Colete 5 Lingotes da Forja de Luz e fale novamente com Glorin Testaço no Pantanal.‡Найдите 5 слитков светостали и вернитесь к Глорину Стальному Лбу в Болотину.‡Sammelt 5 Lichtschmiedeblöcke und kehrt dann zu Glorin Stahlbraue im Sumpfland zurück.‡라이트포지 주괴 5개를 모은 다음 저습지에 있는 글로린 스틸브라우에게 가야 합니다.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Collecter 5 Lingots de sancteforge, puis retourner voir Glorin Front-d\'acier, dans les Paluns.‡收集5块光铸铁锭，把它们交给湿地的戈罗林·钢眉。‡收集5塊光鑄鐵錠，把它們交給濕地的戈羅林·鋼眉。',
  }
},
[527] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Mate 6 Lavradores de Eira dos Montes, 6 Fazendeiros de Eira dos Montes, o Fazendeiro Raí e o Fazendeiro Pegaz, depois apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте 6 хилсбрадских батраков, 6 хилсбрадских фермеров, фермеров Рея и Гетца и возвращайтесь к Дарталии в Мельницу Таррен.‡Tötet 6 Landarbeiter des Hügellands 6 Bauern des Hügellands, Bauer Ray und Bauer Getz und meldet Euch dann wieder bei Darthalia in Tarrens Mühle.‡언덕마루 농장 일꾼 6명, 언덕마루 농부 6명, 그리고 농부 레이와 농부 게츠를 처치한 다음 타렌 제분소에 있는 다살리아에게 보고해야 합니다.‡Mata a 6 mozos de labranza de Trabalomas y 6 granjeros de Trabalomas, al granjero Ray y al granjero Getz e informa a Darthalia en Molino Tarren.‡Mata a 6 mozos de labranza de Trabalomas y 6 granjeros de Trabalomas, al granjero Ray y al granjero Getz e informa a Darthalia en Molino Tarren.‡Tuer 6 Garçons de ferme, 6 Fermiers, le Fermier Ray et le Fermier Getz, puis retourner voir Darthalia à Moulin-de-Tarren.‡杀掉6个希尔斯布莱德雇农和6个希尔斯布莱德农夫，还有农夫雷恩和农夫盖兹，然后返回塔伦米尔向达萨利亚报告。‡殺掉6個希爾斯布萊德雇農和6個希爾斯布萊德農夫，還有農夫雷恩和農夫蓋茲，然後返回塔倫米爾向達薩利亞報告。',
  }
},
[528] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Mate 15 Camponeses de Eira dos Montes e apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте 15 хилсбрадских крестьян и вернитесь к Дарталии в Мельницу Таррен.‡Tötet 15 Arbeiter des Hügellands und erstattet Bericht bei Darthalia in Tarrens Mühle.‡언덕마루 소작농 15명을 처치한 다음 타렌 제분소에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata a 15 campesinos de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata a 15 campesinos de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer 15 Paysans de Hautebrande et faire votre rapport à Darthalia à Moulin-de-Tarren.‡杀死15个希尔斯布莱德农民，然后回到塔伦米尔向达萨利亚汇报。‡殺死15個希爾斯布萊德農民，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[529] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Mate o Ferreiro Verrintão e 4 Ferreiros Aprendizes de Eira dos Montes.|n|nConfisque um carregamento de ferro e apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте кузнеца Верринтана и 4 хилсбрадских учеников кузнеца.|n|nПринесите партию железа Дарталии в Мельницу Таррен.‡Tötet Schmied Verringtan und 4 Schmiedelehrlinge des Hügellands.|n|nBesorgt eine Eisenlieferung und erstattet Bericht bei Darthalia in Tarrens Mühle.‡대장장이 베링턴과 언덕마루 수습대장장이 4명을 처치해야 합니다.|n|n철괴 상자를 찾은 다음 타렌 제분소에 있는 다살리아에게 돌아와 보고하십시오.‡Mata al herrero Verrintan y a 4 herreros aprendices de Trabalomas.|n|nRecupera un envío de hierro e informa a Darthalia en Molino Tarren.‡Mata al herrero Verringtan y a 4 herreros aprendices de Trabalomas.|n|nRecupera un envío de hierro e informa a Darthalia en Molino Tarren.‡Tuez le Forgeron Verringtan et 4 Apprentis Forgerons de Hautebrande.|n|nRécupérez un Chargement de fer, puis retournez voir Darthalia à Moulin-de-Tarren.‡杀掉铁匠维林坦和4个希尔斯布莱德见习铁匠，并从那里抢回一箱铁材，然后向塔伦米尔的达萨利亚汇报。‡殺掉鐵匠維林坦和4個希爾斯布萊德見習鐵匠，並從那裡搶回一箱鐵材，然後向塔倫米爾的達薩利亞彙報。',
  }
},
[530] = {
  {
    'A vingança do marido‡Месть мужа‡Rache eines Ehemanns‡랠리의 복수‡La venganza de un esposo‡La venganza de un esposo‡La vengeance d\'un mari‡丈夫的复仇‡丈夫的復仇',
    nil,
    'Mate Valfrido Moray.|n|nLeve as mãos dele para Olavo Nascimento na Cidade Baixa.‡Убейте Валдреда Морая.|n|nПринесите его руки Роли Андреану в Подгород.‡Tötet Valdred Moray.|n|nBringt seine Hände zu Raleigh Andrean nach Unterstadt.‡발드레드 모레이를 처치해야 합니다.|n|n그 증거로 언더시티에 있는 랠리 앤드리언에게 발드레드의 장갑을 가져가야 합니다.‡Mata a Valdred Moray.|n|nLlévale sus manos a Raleigh Andrean, que está en Entrañas.‡Mata a Valdred Moray.|n|nLlévale sus manos a Raleigh Andrean, que está en Entrañas.‡Tuer Valdred Moray.|n|nApporter ses mains à Raleigh Andrean à Fossoyeuse.‡杀掉瓦德雷·莫莱。|n|n把他的双手带给幽暗城的拉林夫·安迪恩。‡殺掉瓦德雷·莫萊。|n|n把他的雙手帶給幽暗城的拉林夫·安迪恩。',
  }
},
[531] = {
  {
    '‡Месть Вайрины‡Vyrins Rache‡바이린의 복수‡La venganza de Vyrin‡La venganza de Vyrin‡La vengeance de Vyrin‡维林的报复‡',
    nil,
    '‡Принесите голову Старины Черношкура Вайрине Быстрый Ветер в Приют странников.‡Bringt den Kopf der alten Rußtatze zu Vyrin Flinkwind in die Jagdhütte der Weltenwanderer.‡이 퀘스트는 블리자드에 의해 구식으로 지정되어 더 이상 받거나 완료할 수 없습니다.</b>[Bring Ol\' Sooty\'s head to Vyrin Swiftwind at the Farstrider Lodge.]‡Lleva la cabeza del viejo Tiznado a Vyrin Vientoveloz a la Cabaña del Errante.‡Lleva la cabeza del viejo Tiznado a Vyrin Vientoveloz a la Cabaña del Errante.‡Amener la tête du vieux Noiraud à Vyrin Vent-vif au pavillon des pérégrins.‡把奥尔苏迪的头交给旅行者营地的维林·疾风。‡',
  }
},
[532] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Mate o Magistrado Ardelado e 4 Conselheiros de Eira dos Montes. Destrua a Proclamação de Eira dos Montes. Roube o Livro de Registro de Eira dos Montes. Depois fale novamente com Darthalia na Serraria Tarren.‡Убейте мирового судью Бернсайда, и 4 членов совета Хилсбрада. Уничтожьте хилсбрадское официальное объявление. Украдите регистрационную книгу Хилсбрада. Затем вернитесь к Дарталии в Мельницу Таррен.‡Tötet Magistrat Uferbach und 4 Ratsherren des Hügellands. Zerstört die Proklamation des Hügellands. Stehlt das Stadtverzeichnis des Hügellands. Meldet Euch danach bei Darthalia in Tarrens Mühle.‡집정관 번사이드와 언덕마루 원로 4명을 처치해야 합니다. 언덕마루 선언문을 파괴하고 언덕마루 마을 기록부를 빼내 와야 합니다. 그런 다음 타렌 제분소에 있는 다살리아에게 돌아와 보고하십시오.‡Mata al magistrado Ladoquemado y a 4 consejeros de Trabalomas. Acaba con la Declaración de Trabalomas. Saquea el registro de Trabalomas. Después informa a Darthalia en Molino Tarren.‡Mata al magistrado Ladoquemado y a 4 consejeros de Trabalomas. Acaba con la Declaración de Trabalomas. Saquea el registro de Trabalomas. Después informa a Darthalia en Molino Tarren.‡Tuer le Magistrat Brûle-flanc et 4 Conseillers de Hautebrande. Détruire la Proclamation de Hautebrande. Voler le Registre municipal de Hautebrande. Rendre compte à Darthalia à Moulin-de-Tarren.‡杀掉波恩塞德镇长和4个希尔斯布莱德议员，摧毁《希尔斯布莱德宣言》，偷取希尔斯布莱德城镇文档，然后回到塔伦米尔向达萨利亚汇报。‡殺掉波恩塞德鎮長和4個希爾斯布萊德議員，摧毀《希爾斯布萊德宣言》，偷取希爾斯布萊德城鎮文檔，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[533] = {
  {
    '[DEPRECATED] Infiltration‡Шпионская работа‡Unterwanderung‡침투‡[DEPRECATED]Infiltración‡[DEPRECATED]Infiltración‡[PÉRIMÉ]L\'épée d\'HumbertInfiltration‡[DEPRECATED] 秘密潜入‡[DEPRECATED] Infiltration',
    nil,
    'Obtenha informações sobre o paradeiro de Gol\'dir para Krusk na Serraria Tarren.‡Добудьте сведения о местонахождении Гол\'дира для Круска из Мельницы Таррен.‡Holt Informationen über Gol\'dirs Aufenthaltsort für Krusk in Tarrens Mühle ein.‡타렌 제분소에 있는 크루스크를 위해 골디르가 어디에 있는지 정보를 얻어야 합니다.‡Consigue información sobre el paradero de Gol\'dir\'s e informa a Krusk en Molino Tarren.‡Consigue información sobre el paradero de Gol\'dir\'s e informa a Krusk en Molino Tarren.‡Rapportez des informations sur l\'emplacement de Gol\'dir pour Krusk, à Moulin-de-Tarren.‡把关于高迪尔下落的消息带回来给塔伦米尔的克鲁斯克。‡把關於高迪爾下落的消息帶回來給塔倫米爾的克魯斯克。',
  }
},
[534] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[535] = {
  {
    'Vito‡Валлик‡Valik‡발릭‡Valik‡Valik‡Valik‡仆从瓦里克‡僕從瓦里克',
    nil,
    'Leve um caneco de Stout da Costa Sul para Vito no acampamento da Camarilha.‡Принесите кружку южнобережского портера Валлику в лагерь Синдиката.‡Bringt einen Becher mit Süderstader Starkbier zu Valik in das Lager des Syndikats.‡비밀결사대 야영지에 있는 발릭에게 남녘해안의 스타우트 맥주 한 잔을 가져가야 합니다.‡Llévale 1 jarra de cerveza de Costasur a Valik en el campamento de la Hermandad.‡Llévale 1 jarra de cerveza de Costasur a Valik en el campamento de la Hermandad.‡Apporter une Chope de bière brune d\'Austrivage à Valik, au Camp du Syndicat.‡给辛迪加营地里的瓦里克带去一杯南海镇烈酒。‡給辛迪加營地裡的瓦里克帶去一杯南海鎮烈酒。',
  }
},
[536] = {
  {
    '[DEPRECATED] Down the Coast‡На побережье‡Die Küste entlang‡해안의 위협‡[DEPRECATED]Al lo largo de la costa‡[DEPRECATED]Al lo largo de la costa‡[PÉRIMÉ]Le long de la côte‡[DEPRECATED] 清理海岸‡[DEPRECATED] Down the Coast',
    nil,
    'Mate 10 Caçamarés Rancapinas e 10 Oráculos Rancapinas para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 волноловов из племени Порванного Плавника и 10 оракулов из племени Порванного Плавника по поручению лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Gezeitenjäger der Fetzenflossen und 10 Orakel der Fetzenflossen für Leutnant Farren Orinelle in Süderstade.‡남녘해안에 있는 부관 파렌 오리넬이 너덜지느러미 바다사냥꾼 10마리와 너덜지느러미 점쟁이 10마리를 처치해 달라고 했습니다.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del teniente Farren Orinelle de Costasur.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del teniente Farren Orinelle de Costasur.‡Tuez 10 Chasse-marées et 10 Oracles Aileron déchiré pour le lieutenant Farren Orinelle, à Austrivage.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个碎鳍潮行鱼人和10个碎鳍智者。‡南海鎮的法爾林·奧里涅爾中尉要你去殺掉10個碎鰭獵潮魚人和10個碎鰭神諭者。',
  }
},
[537] = {
  {
    '[DEPRECATED] Dark Council‡Темный совет‡[DEPRECATED] Der Dunkle Rat‡어둠의 의회‡[DEPRECATED]Consejo oscuro‡[DEPRECATED]Consejo oscuro‡[PÉRIMÉ]Le conseil noir‡[DEPRECATED] 黑暗议会‡[DEPRECATED] Dark Council',
    nil,
    'Mate 4 Magos das Sombras Argus.|n|nLeve a Cabeça de Nagaz ao Magistrado na Costa Sul.‡Убейте 4 темных магов Недремлющего Аргуса.|n|nПринесите голову Нагаза мировому судье Южнобережья Малебу.‡Tötet 4 Schattenmagier der Arguswacht.|n|nBringt den Kopf von Nagaz zu Magistrat Maleb nach Süderstade.‡아르거스 재림회 어둠마법사 4명을 처치해야 합니다.|n|n그리고 나가즈를 처치한 증거로 그의 머리카락을 남녘해안에 있는 집정관 헨리 말레브에게 가져가야 합니다.‡Mata a 4 magos oscuros Argus.|n|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Mata a 4 magos de la Sombra Argus.|n|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Tuer 4 Mages de l\'ombre d\'Argus.|n|nApporter la Tête de Nagaz au Magistrat Maleb à Austrivage.‡杀死4个暗影大法师。|n|n把纳伽兹的徽记带给南海镇的马雷布镇长。‡殺死4個阿古斯暗影法師。|n|n把納伽茲的頭帶給南海鎮的馬雷布鎮長。',
  }
},
[538] = {
  {
    'Costa Sul‡Южнобережье‡Süderstade‡남녘해안‡Costasur‡Costasur‡Austrivage‡南海镇‡南海鎮',
    nil,
    'Fale com o Historiador Dibbs em Costa Sul.‡Поговорите с Хранителем мудрости Диббсом в Южнобережье.‡Sprecht mit dem Meister der Lehren Dibbs in Süderstade.‡남녘해안에 있는 현자 딥스와 대화해야 합니다.‡Habla con el maestro cultural Dibbs en Costasur.‡Habla con el maestro cultural Dibbs en Costasur.‡Parler à l\'Erudit Dibbs à Austrivage.‡与南海镇的博学者迪布斯交谈。‡與南海鎮的博學大師迪布斯交談。',
  }
},
[539] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Mate o Encarregado Grilhões e 10 Mineradores de Eira dos Montes, depois apresente-se novamente a Darthalia em Serraria Tarren.‡Убейте штейгера Бондса и 10 хилсбрадских шахтеров и доложите о проделанной работе Дарталии в Мельнице Таррен.‡Tötet Großknecht Bonds sowie 10 Minenarbeiter des Hügellands und erstattet Bericht bei Darthalia in Tarrens Mühle.‡현장감독 본즈와 언덕마루 광부 10명을 처치한 다음 타렌 제분소에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer le Contremaître Bonds et 10 Mineurs de Hautebrande, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡杀死工头邦德斯和10个希尔斯布莱德矿工，然后回到塔伦米尔向达萨利亚汇报。‡殺死工頭邦德斯和10個希爾斯布萊德礦工，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[540] = {
  {
    '[DEPRECATED] Preserving Knowledge‡Сохранение знаний‡Wissen bewahren‡지식 보존‡[DEPRECATED]Proteger el conocimiento‡[DEPRECATED]Proteger el conocimiento‡[PÉRIMÉ]L\'entretien des connaissances‡[DEPRECATED] 保全书籍‡[DEPRECATED] Preserving Knowledge',
    nil,
    'Leve 5 Tomos Recuperados e o Livro de Couro Desgastado contendo o Braço de Gri\'lek para o Historiador Dibbs, em Costa Sul.‡Найдите 5 фолиантов и потертую кожаную книгу, называемую "Рука Гри\'лека", и принесите их хранителю мудрости Диббсу в Южнобережье.‡Bringt 5 geborgene Folianten und das abgenutzte Lederbuch, das \'Der Arm von Gri\'lek\' enthält, zum Meister der Lehren Dibbs nach Süderstade.‡되찾은 학술서 5권과 그리렉의 팔이 들어 있는 낡은 가죽 책을 남녘해안에 있는 현자 딥스에게 가져가야 합니다.‡Lleva 5 escritos recuperados y el libro de cuero gastado que contiene El Arma de Gri\'lek al maestro cultural Dibbs a Costasur.‡Lleva 5 tomos y el libro de piel gastado que contiene El Arma de Gri\'lek al maestro cultural Dibbs a Costasur.‡Apporter 5 Tomes retrouvés, ainsi que le Livre de cuir usé « Le Bras de Gri\'lek » au Maître des traditions Dibbs, à Austrivage.‡把5本失而复得的书籍和包含《格里雷克之臂》的破旧的皮书带给南海镇的博学者迪布斯。‡把5本失而復得的書籍和包含《格里雷克之臂》的破舊的皮書帶給南海鎮的博學大師迪布斯。',
  }
},
[541] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Viaje até Dun Garok e mate 8 Montanhistas, 4 Carabineiros, 2 Sacerdotes e o Capitão Monteferro, depois fale novamente com Darthalia na Serraria Tarren.‡Отправляйтесь в Дун Гарок и убейте 8 горных пехотинцев, 4 стрелков, 2 жрецов и капитана Железную Гору. После возвращайтесь к Дарталии в Мельницу Таррен.‡Begebt Euch nach Dun Garok, tötet 8 Gebirgsjäger, 4 Scharfschützen, 2 Priester sowie Hauptmann Eisenberg und erstattet danach Bericht bei Darthalia in Tarrens Mühle.‡던 가록으로 가서 던 가록 산악경비대 8명, 던 가록 소총병 4명, 던 가록 사제 2명과 부대장 아이언힐을 처치한 다음 타렌 제분소에 있는 다살리아에게 돌아와 보고해야 합니다.‡Ve a Dun Garok y mata a 8 montaraces, 4 fusileros, 2 sacerdotes y al capitán Ferrocolina e informa a Darthalia en Molino Tarren.‡Ve a Dun Garok y mata a 8 montaraces, 4 fusileros, 2 sacerdotes y al capitán Ferrocolina e informa a Darthalia en Molino Tarren.‡Aller à Dun Garok et tuer 8 Montagnards, 4 Fusiliers, 2 Prêtres et le Capitaine Colline-de-fer, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡到丹加洛克去杀掉8个巡山人、4个火枪手、2个牧师，还有达伦·铁山上尉，然后回到塔伦米尔向达萨利亚汇报。‡到丹加洛克去殺掉8個巡山人、4個步槍兵、2個牧師，還有達倫·鐵山上尉，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[542] = {
  {
    '‡‡‡‡[DEPRECATED]Regresa junto a Milton‡‡[PÉRIMÉ]Les livres de Milton‡[DEPRECATED] 向米尔顿回复‡',
    nil,
    '‡‡‡‡Lleva los escritos sobre Alterac a Milton Gavilla a Ventormenta.‡‡Apportez les Tomes d\'Alterac à Milton Sheaf, à Hurlevent.‡把奥特兰克的书籍带给暴风城的米尔顿·西弗。‡',
  }
},
[543] = {
  {
    'A Tiara de Perenolde‡Тиара Перенольда‡Die Tiara von Perenolde‡페레놀드 티아라‡La Tiara Perenolde‡La Tiara Perenolde‡La tiare de Perenolde‡匹瑞诺德王冠‡匹瑞諾德冠冕',
    nil,
    'Recupere a Tiara de Perenolde.‡Найдите тиару Перенольда.‡Erlangt die Tiara von Perenolde zurück.‡페레놀드 티아라를 회수해야 합니다.‡Recupera la Tiara Perenolde.‡Recupera la Tiara Perenolde.‡Récupérez la Tiare de Perenolde.‡取回匹瑞诺德王冠。‡取回匹瑞諾德冠冕。',
  }
},
[544] = {
  {
    '[DEPRECATED] Prison Break In‡Взлом тюрьмы‡Gefängniseinbruch‡감옥 습격‡[DEPRECATED]Colarse en la cárcel‡[DEPRECATED]Colarse en la cárcel‡[PÉRIMÉ]L\'invasion de la prison‡[DEPRECATED] 誓死追赃‡[DEPRECATED] Prison Break In',
    nil,
    'Encontre os traidores e recupere os artefatos, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Найдите предателей и отберите у них артефакты, а потом возвращайтесь к волхву Сиянию Бездны в Мельницу Таррен.‡Findet diese Verräter, sammelt ihre Artefakte ein und kehrt dann zu Magus Leermacht nach Tarrens Mühle zurück.‡배반자들을 찾아내 유물을 되찾은 다음 타렌 제분소에 있는 학자 워딘 보이드글레어에게 가야 합니다.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el magus Vacuamirada en Molino Tarren.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el magus Vacuamirada en Molino Tarren.‡Trouvez les traîtres et récupérez les artéfacts, puis retournez voir le Magus Toisevide à Moulin-de-Tarren.‡找到被遗忘者的叛徒，取回他们偷走的神器，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡找到被遺忘者的叛徒，取回他們偷走的神器，然後回到塔倫米爾去見魔導師沃迪恩·虛無之光。',
  }
},
[545] = {
  {
    '[DEPRECATED] Dalaran Patrols‡Даларанские патрули‡Patrouillen von Dalaran‡달라란 순찰‡[DEPRECATED]Las patrullas de Dalaran‡[DEPRECATED]Las patrullas de Dalaran‡[PÉRIMÉ]Les patrouilles de Dalaran‡[DEPRECATED] 达拉然巡逻队‡[DEPRECATED] Dalaran Patrols',
    nil,
    'Mate 6 Evocadores de Dalaran e 12 Escravos Elementais, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Убейте 6 даларанских призывателей и 12 порабощенных элементалей. Затем возвращайтесь к волхву Сиянию Бездны в Мельницу Таррен.‡Tötet 6 Beschwörer von Dalaran sowie 12 Elementarsklaven und kehrt dann zu Magus Leermacht nach Tarrens Mühle zurück.‡달라란 소환사 6명과 노예 바위 정령 12마리를 처치한 다음 타렌 제분소에 있는 학자 워딘 보이드글레어에게 가야 합니다.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el magus Vacuamirada en Molino Tarren.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el magus Vacuamirada en Molino Tarren.‡Tuer 6 Invocateurs de Dalaran et 12 Élémentaires asservis, puis retourner voir le Magus Toisevide à Moulin-de-Tarren.‡杀掉6个达拉然召唤师和12个元素奴仆，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡殺掉6個達拉然召喚師和12個元素奴僕，然後回到塔倫米爾去見魔導師沃迪恩·虛無之光。',
  }
},
[546] = {
  {
    '[DEPRECATED] Souvenirs of Death‡Сувениры смерти‡Andenken des Todes‡죽음의 전리품‡[DEPRECATED]Recuerdos de muerte‡[DEPRECATED]Recuerdos de muerte‡[PÉRIMÉ]Souvenirs de morts‡[DEPRECATED] 死亡的纪念品‡[DEPRECATED] Souvenirs of Death',
    nil,
    'O Necroguarda Sandoval da Serraria Tarren quer 30 Crânios Humanos de Eira dos Montes.‡Страж смерти Самса из Мельницы Таррен попросил принести 30 человеческих черепов из Хилсбрада.‡Todeswache Samsa aus Tarrens Mühle will 30 menschliche Schädel aus dem Hügelland.‡타렌 제분소에 있는 죽음경비병 삼사가 언덕마루 주민의 해골 30개를 가져다 달라고 했습니다.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 cráneos humanos de Trabalomas.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 calaveras humanas de Trabalomas.‡Le Nécrogarde Samsa du Moulin-de-Tarren veut 30 Crânes d\'humains de Hautebrande.‡塔伦米尔的亡灵卫兵沙穆萨想要30个希尔斯布莱德人类徽记。‡塔倫米爾的亡靈衛兵沙穆薩想要30個希爾斯布萊德人類顱骨。',
  }
},
[547] = {
  {
    '[DEPRECATED] Humbert\'s Sword‡Меч Гумберта‡Humberts Schwert‡험버트의 검‡[DEPRECATED]La espada de Humbert‡[DEPRECATED]La espada de Humbert‡[PÉRIMÉ]L\'épée d\'Humbert‡[DEPRECATED] 亨伯特的长剑‡[DEPRECATED] Humbert\'s Sword',
    nil,
    'Recupere a espada do Necroguarda Humberto em Dun Garok e devolva-a para ele na Serraria Tarren.‡Найдите меч стража смерти Гумберта в Дун Гароке и верните его владельцу в Мельнице Таррен.‡Bringt das Schwert von Todeswache Humbert aus Dun Garok zu ihm nach Tarrens Mühle zurück.‡던 가록에서 죽음경비병 험버트의 검을 되찾아 타렌 제분소로 돌아와 험버트에게 검을 돌려줘야 합니다.‡Recoge la espada del Guardia de la Muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Recoge la espada del Guardia de la Muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Retrouvez l’Épée du Nécrogarde Humbert à Dun Garok, et la lui rapporter à Moulin-de-Tarren.‡从丹加洛克拿回亡灵卫兵亨伯特的长剑，然后回到塔伦米尔把剑还给他。‡從丹加洛克拿回亡靈衛兵亨伯特的長劍，然後回到塔倫米爾把劍還給他。',
  }
},
[549] = {
  {
    '[DEPRECATED] WANTED: Syndicate Personnel‡Разыскиваются: сторонники Синдиката‡GESUCHT: Syndikatspersonal‡비밀결사대원 현상 수배‡[DEPRECATED]SE BUSCA: Personal de la Hermandad‡[DEPRECATED]SE BUSCA: Personal de la Hermandad‡[PÉRIMÉ]ON RECHERCHE : Personnel du Syndicat‡[DEPRECATED] 通缉：辛迪加成员‡[DEPRECATED] WANTED: Syndicate Personnel',
    nil,
    'Mate 10 Ladinos da Camarilha e 10 Vigias da Camarilha. Fale novamente com a Alta-executora Darthalia na Serraria Tarren para receber sua recompensa.‡Убейте 10 разбойников и 10 сторожей из Синдиката и возвращайтесь за наградой к верховной вершительнице Дарталии в Мельницу Таррен.‡Tötet 10 Schurken des Syndikats und 10 Wachmänner des Syndikats. Kehrt danach zu Hochexekutorin Darthalia nach Tarrens Mühle zurück.‡비밀결사대 도적 10명과 비밀결사대 경비병 10명을 처치해야 합니다. 그런 다음 타렌 제분소에 있는 고위집행관 다살리아에게 돌아가 보상금을 받으십시오.‡Mata a 10 pícaros y 10 veladores de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Mata a 10 pícaros y 10 veladores de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Tuez 10 Voleurs et 10 Gardiens du Syndicat, puis allez voir la Grande exécutrice Darthalia à Moulin-de-Tarren pour votre récompense.‡杀死10个辛迪加潜行者和10个辛迪加哨兵，然后回到塔伦米尔向高级执行官达萨利亚报告。‡殺死10個辛迪加盜賊和10個辛迪加哨兵，然後回到塔倫米爾向高階執行官達薩利亞報告。',
  }
},
[550] = {
  {
    '[DEPRECATED] Battle of Hillsbrad‡Битва за Хилсбрад‡Kampf um das Hügelland‡언덕마루 전투‡[DEPRECATED]La batalla de Trabalomas‡[DEPRECATED]La batalla de Trabalomas‡[PÉRIMÉ]La bataille de Hautebrande‡[DEPRECATED] 希尔斯布莱德之战‡[DEPRECATED] Battle of Hillsbrad',
    nil,
    'Take Darthalia\'s Sealed Commendation to Bragor Bloodfist in the Undercity.‡Отнесите запечатанное рекомендательное письмо Дарталии Брагору Кровопалу в Подгород.‡Bringt Darthalias versiegelte Belobigung zu Bragor Blutfaust nach Unterstadt.‡언더시티에 있는 브라고르 블러드피스트에게 다살리아의 봉인된 추천서를 가져가야 합니다.‡Lleva la mención de honor lacrada de Darthalia a Bragor Puñosangre, que está en Entrañas.‡Lleva la mención de honor lacrada de Darthalia a Bragor Puñosangre, que está en Entrañas.‡Apporter la Recommandation portant le sceau de Darthalia à Bragor Poing-de-sang à Fossoyeuse.‡把达萨利亚的奖状交给幽暗城的布拉贡·血拳。‡把達薩利亞的獎狀交給幽暗城的貝拉戈·血拳。',
  }
},
[551] = {
  {
    '‡Заколдованный пергамент‡Das Verhexte Pergament‡마법의 양피지‡[DEPRECATED] El papiro encantado‡‡[PÉRIMÉ]Le Parchemin ensorcelé‡[DEPRECATED] 附有魔法的羊皮纸‡',
    nil,
    '‡Отнесите заколдованный пергамент Хранителю мудрости Диббсу в Южнобережье, что в Предгорьях Хилсбрада.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Süderstade im Vorgebirge des Hügellands.‡‡Lleva el pergamino encantado al maestro cultural Dibbs a Costasur en las Laderas de Trabalomas.‡Lleva el pergamino encantado al maestro cultural Dibbs a Costasur en las Laderas de Trabalomas.‡Apporter le Parchemin ensorcelé à l\'Erudit Dibbs à Austrivage, aux Contreforts de Hautebrande.‡‡',
  }
},
[552] = {
  {
    '[DEPRECATED] Helcular\'s Revenge‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡[DEPRECATED]La venganza de Helcular‡[DEPRECATED]La venganza de Helcular‡[PÉRIMÉ]La vengeance d\'Helcular‡[DEPRECATED] 赫尔库拉的复仇‡[DEPRECATED] Helcular\'s Revenge',
    nil,
    'Recupere o Bastão de Helcolar do Yeti e leve-o de volta para o Noviço Trevando, em Serraria Tarren.‡Отберите у йети жезл Гелькулара и отнесите его новобранцу Тайванду в Мельницу Таррен.‡Holt Helculars Rute von dem Yeti und bringt sie zu Novize Thaivand nach Tarrens Mühle zurück.‡설인에게서 헬쿨라의 마법봉을 되찾아 타렌 제분소에 있는 수련사 사이반드에게 가져가야 합니다.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Reprendre le Bâtonnet d\'Helcular aux yétis et la ramener au novice Thaivand à Moulin-de-Tarren.‡从雪怪手上拿回赫尔库拉的魔棒，把它交给塔伦米尔的学徒塞万德。‡從雪人手上拿回赫爾庫拉的魔棒，把它交給塔倫米爾的學徒塞萬德。',
  }
},
[553] = {
  {
    '[DEPRECATED] Helcular\'s Revenge‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡[DEPRECATED]La venganza de Helcular‡[DEPRECATED]La venganza de Helcular‡[PÉRIMÉ]La vengeance d\'Helcular‡[DEPRECATED] 赫尔库拉的复仇‡[DEPRECATED] Helcular\'s Revenge',
    nil,
    'Carregue o Bastão de Helcolar com os poderes da Chama de Azel, da Chama de Veraz e da Chama de Uzel.|n|nColoque o bastão carregado na tumba de Helcolar, em Costa Sul.‡Зарядите жезл Гелькулара силой пламени Азеля, пламени Вераза и пламени Узеля.|n|nВонзите заряженный жезл в гробницу Гелькулара в Южнобережье.‡Ladet die Rute von Helcular mit der Macht der Flamme von Azel, der Flamme von Veraz und der Flamme von Uzel auf.|n|nStoßt die aufgeladene Rute in Helculars Grab in Süderstade.‡헬쿨라의 마법봉에 아젤의 불꽃, 베라즈의 불꽃, 우젤의 불꽃의 마력을 불어넣어야 합니다.|n|n힘을 불어넣은 마법봉을 남녘해안에 있는 헬쿨라의 무덤으로 가져가야 합니다.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la Llama de Veraz y la Llama de Uzel.|n|nLuego llévala a la tumba de Helcular en Costasur.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la Llama de Veraz y la Llama de Uzel.|n|nLuego llévala a la tumba de Helcular en Costasur.‡Charger le Bâtonnet d\'Helcular des pouvoirs de la Flamme d\'Azel, de la Flamme de Veraz et de la Flamme d\'Uzel.|n|nEnfoncez le Bâtonnet chargé dans la tombe d\'Helcular à Austrivage.‡将埃希尔之焰、沃拉兹之焰和尤基尔之焰的力量注入赫尔库拉的魔棒。|n|n把经过仪式洗礼之后的魔棒带到南海镇的赫尔库拉墓地。‡將埃希爾之焰、沃拉茲之焰和尤基爾之焰的力量注入赫爾庫拉的魔棒。|n|n把經過儀式洗禮之後的魔棒帶到南海鎮的赫爾庫拉墓地。',
  }
},
[554] = {
  {
    '[DEPRECATED] Stormpike\'s Deciphering‡Расшифровщик Грозовая Вершина‡Sturmlanzes Entschlüsselung‡스톰파이크의 판독‡[DEPRECATED] La descodificación de Pico Tormenta‡[DEPRECATED] La descodificación de Pico Tormenta‡[PÉRIMÉ]Les Runes gravées‡[DEPRECATED] 解码高手‡[DEPRECATED] Stormpike\'s Deciphering',
    nil,
    'Leve o Pergaminho Encantado para o Prospector Lançatroz, em Altaforja.‡Отнесите заколдованный пергамент геологу Грозовой Вершине в Стальгорн.‡Bringt das verhexte Pergament zu Ausgrabungsleiter Sturmlanze nach Eisenschmiede.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 마법의 양피지를 가져가야 합니다.‡Lleva el papiro hechizado al prospector Pico Tormenta a Forjaz.‡Lleva el papiro codificado al prospector Pico Tormenta a Forjaz.‡Apporter le Parchemin ensorcelé au Prospecteur Foudrepique à Forgefer.‡把附有魔法的羊皮纸带给铁炉堡的勘察员塔伯斯·雷矛。‡把附有魔法的羊皮紙帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[555] = {
  {
    '[DEPRECATED] Soothing Turtle Bisque‡Нежный черепаховый суп‡Milde Schildkrötensuppe‡독특한 거북이 비스크‡[DEPRECATED]Sopa de tortuga reconfortante‡[DEPRECATED]Sopa de tortuga reconfortante‡[PÉRIMÉ]Bisque de tortue apaisante‡[DEPRECATED] 海龟汤‡[DEPRECATED] Soothing Turtle Bisque',
    nil,
    'Bring 10 pieces of Turtle Meat to Chef Jessen in Southshore.‡Принесите 10 кусков черепашьего мяса шеф-повару Джессену в Южнобережье.‡Bringt 10 Stücke Schildkrötenfleisch zu Küchenchef Jessen nach Süderstade.‡남녘해안에 있는 주방장 예센에게 거북이 고기 10개를 가져가야 합니다.‡Lleva 10 piezas de carne de tortuga y al chef Jessen a Costasur.‡Lleva 10 piezas de carne de tortuga y al chef Jessen a Costasur.‡Apporter 10 morceaux de Viande de tortue au Chef Jessen, à Austrivage.‡给南海镇的厨师杰森带去10块海龟肉。‡給南海鎮的廚師傑森帶去10塊海龜肉。',
  }
},
[556] = {
  {
    '[DEPRECATED] Stone Tokens‡Каменные талисманы‡Steinmarken‡징표의 돌‡[DEPRECATED]Muestras de piedra‡[DEPRECATED]Muestras de piedra‡[PÉRIMÉ]Les Runes gravées‡[DEPRECATED] 石雕‡[DEPRECATED] Stone Tokens',
    nil,
    'Leve 10 Fichas de Pedra Gasta para o Guardião Bel\'varão, na Serraria Tarren.‡Отнесите 10 истертых каменных талисманов хранителю Бел\'варилу из Мельницы Таррен.‡Bringt 10 abgenutzte Steinmarken zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 제분소에 있는 관리인 벨바릴에게 닳아해진 징표의 돌 10개를 가져가야 합니다.‡Lleva 10 muestras de piedra desgastada al vigilante Bel\'varil de Molino Tarren.‡Lleva 10 muestras de piedra desgastada al vigilante Bel\'varil de Molino Tarren.‡Apporter 10 Runes gravées au Gardien Bel\'varil à Moulin-de-Tarren.‡收集10个用旧的石雕，把它们带给塔伦米尔的看守者贝尔杜加。‡收集10個用舊的石雕，把它們帶給塔倫米爾的看守者貝爾杜加。',
  }
},
[557] = {
  {
    '[DEPRECATED] Bracers of Binding‡Сковывающие браслеты‡Armschienen der Bindung‡결속의 팔보호구‡[DEPRECATED]Brazales de vínculo‡[DEPRECATED]Brazales de vínculo‡[PÉRIMÉ]Les brassards de lien‡[DEPRECATED] 地缚护腕‡[DEPRECATED] Bracers of Binding',
    nil,
    'Leve 4 Braçadeiras do Vínculo à Terra para o Guardião Bel\'varão, na Serraria Tarren.‡Принесите 4 браслета земли хранителю Бел\'варилу из Мельницы Таррен.‡Bringt 4 Armschienen der Erdbindung zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 제분소에 있는 관리인 벨바릴에게 대지 결속의 팔보호구 4개를 가져가야 합니다.‡Lleva 4 brazales de Vínculo de Tierra al vigilante Bel\'varil de Molino Tarren.‡Lleva 4 brazales de vínculo de Tierra al vigilante Bel\'varil de Molino Tarren.‡Apporter 4 Brassards de liaison de terre au Gardien Bel\'varil à Moulin-de-Tarren.‡为塔伦米尔的看守者贝瓦里尔收集4个地缚护腕。‡為塔倫米爾的看守者貝瓦里爾收集4個地縛護腕。',
  }
},
[558] = {
  {
    'Autógrafo da Jaina‡Автограф Джайны‡Jainas Autogramm‡제이나의 친필서명‡El autógrafo de Jaina‡El autógrafo de Jaina‡L\'autographe de Jaina‡吉安娜的签名‡珍娜的簽名',
    nil,
    'Vá a Theramore para tentar conseguir o autógrafo da Grã-senhora Jaina Proudmore para o seu protegido.‡Отправляйтесь в Терамор и постарайтесь получить автограф леди Джайны Праудмур для своего подопечного.‡Reist nach Theramore und versucht für Euren Schützling ein Autogramm von Lady Jaina Prachtmeer zu ergattern.‡돌보고 있는 고아를 위해 테라모어로 가서 여군주 제이나 프라우드무어의 친필서명을 받아야 합니다.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Allez à Theramore pour tenter d\'obtenir un autographe de dame Jaina Portvaillant pour votre protégé.‡到塞拉摩去，为你看护的孩子拿到一份吉安娜·普罗德摩尔的亲笔签名。‡到塞拉摩去，為你看護的孩子拿到一份珍娜·普勞德摩爾女士的親筆簽名。',
  }
},
[559] = {
  {
    '[DEPRECATED] Farren\'s Proof‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡[DEPRECATED]La prueba de Farren‡[DEPRECATED]La prueba de Farren‡[PÉRIMÉ]La preuve de Farren‡[DEPRECATED] 法尔林的证据‡[DEPRECATED] Farren\'s Proof',
    nil,
    'Colete 10 Cabeças de Murloc dos murlocs da Praia Ocidental para o Tenente Fárrio Orinelle, que está na Costa Sul.‡Соберите 10 голов мурлоков на Западном побережье по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Sammelt 10 Murlocköpfe von den Murlocs am Weststrand für Leutnant Farren Orinelle in Süderstade.‡남녘해안에 있는 부관 파렌 오리넬에게 서부 해안에서 멀록을 처치하고 멀록 머리 10개를 모아야 합니다.‡Recoge 10 cabezas de múrloc en la Playa del Oeste por orden del teniente Farren Orinelle de Costasur.‡Recoge 10 cabezas de múrloc en la Playa del Oeste por orden del teniente Farren Orinelle de Costasur.‡Récupérez 10 Têtes de murlocs sur les murlocs du Rivage occidental pour le lieutenant Farren Orinelle à Austrivage.‡南海镇的法尔林·奥里涅尔中尉要你从西部海岸的鱼人身上收集10颗鱼人的徽记。‡南海鎮的法爾林·奧里涅爾中尉要你從西部海岸的魚人身上收集10顆魚人的頭顱。',
  }
},
[560] = {
  {
    '[DEPRECATED] Farren\'s Proof‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡[DEPRECATED]La prueba de Farren‡[DEPRECATED]La prueba de Farren‡[PÉRIMÉ]La preuve de Farren‡[DEPRECATED] 法尔林的证据‡[DEPRECATED] Farren\'s Proof',
    nil,
    'Entregue o Saco com Cabeças de Murloc ao Delegado Trilharrubra na Costa Sul.‡Отнесите мешок с головами мурлоков маршалу Редпату в Южнобережье.‡Bringt den Sack mit den Murlocköpfen zu Marschall Rotpfad nach Süderstade.‡남녘해안에 있는 치안대장 레드패스에게 멀록 머리가 든 자루를 전달해야 합니다.‡Entrega las cabezas de múrloc al alguacil Rutagrana de Costasur.‡Entrega las cabezas de múrloc al alguacil Rutagrana de Costasur.‡Livrer le Sac de têtes de murlocs au maréchal Senterouge à Austrivage.‡把一袋鱼人的徽记交给南海镇的治安官雷德帕斯。‡把一袋魚人的頭顱交給南海鎮的治安官雷德帕斯。',
  }
},
[562] = {
  {
    '‡‡‡‡‡‡‡[DEPRECATED] 升官之道‡',
    nil,
    '‡‡‡‡‡‡‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个刺脊滩行者和10个刺脊海妖。‡',
  }
},
[563] = {
  {
    '[DEPRECATED] Reassignment‡Новое назначение‡Versetzungen‡전출‡[DEPRECATED]Nueva asignación‡[DEPRECATED]Nueva asignación‡[PÉRIMÉ]Nouvelle affectation‡[DEPRECATED] 人事调动‡[DEPRECATED] Reassignment',
    nil,
    'Entregue o Relatório de Fárrio para o Major Samuelson na Bastilha Ventobravo.‡Отнесите донесение Фаррена майору Самуэльсону в крепость Штормграда.‡Bringt Farrens Bericht zu Major Samuelson in die Burg Sturmwind.‡스톰윈드 왕궁에 있는 상사 사무엘슨에게 파렌의 보고서를 전달해야 합니다.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Remettre le Rapport de Farren au major Samuelson au Donjon de Hurlevent.‡把法尔林的报告交给暴风要塞里的萨缪尔森少校。‡把法爾林的報告交給暴風要塞裡的山繆森少校。',
  }
},
[564] = {
  {
    '[DEPRECATED] Costly Menace‡Серьезная угроза‡Teure Bedrohung‡크나큰 위협‡[DEPRECATED]Una amenaza costosa‡[DEPRECATED]Una amenaza costosa‡[PÉRIMÉ]Un problème très coûteux‡[DEPRECATED] 损失惨重‡[DEPRECATED] Costly Menace',
    nil,
    'Dario Malavista, da Costa Sul, quer que você mate 8 Leões da Montanha e 10 Leões da Montanha Imponentes.‡Убейте 8 горных львов и 10 крупных горных львов по поручению Даррена Малвея из Южнобережья.‡Darren Malve aus Süderstade will, dass Ihr 8 Berglöwen und 10 bullige Berglöwen tötet.‡남녘해안의 대런 말뷰가 산사자 8마리와 덩치 큰 산사자 10마리를 처치해 달라고 했습니다.‡Darren Malavista de Costasur quiere que mates 8 leones de montaña y 10 leones de montaña descomunales.‡Darren Malavista de Costasur quiere que mates 8 leones de montaña y 10 leones de montaña descomunales.‡Darren Malvew d\'Austrivage veut que vous tuiez 8 Lions des montagnes et 10 Lions des montagnes massifs.‡南海镇的达伦·玛尔维要你杀掉8只山地狮和10只巨型山地狮。‡南海鎮的達倫·瑪爾維要你殺掉8隻山地獅和10隻巨型山地獅。',
  }
},
[565] = {
  {
    '[DEPRECATED] Bartolo\'s Yeti Fur Cloak‡Плащ из меха йети‡Bartolos Yetifellumhang‡바르톨로의 설인 모피 망토‡[DEPRECATED]Capa de piel de yeti de Bartolo‡[DEPRECATED]Capa de piel de yeti de Bartolo‡[PÉRIMÉ]La cape en fourrure de yéti de Bartolo‡[DEPRECATED] 巴图罗的雪人毛皮披风‡[DEPRECATED] Bartolo\'s Yeti Fur Cloak',
    nil,
    'Leve um Rolo de Lã, um Manto do Montanhista, Fio Delicado e 10 chumaços de Pele de Yeti para Bartolo Ginsetti na Costa Sul.‡Принесите Бартоло Джинсетти из Южнобережья рулон шерсти, плащ жителя холмов, тонкую нить и 10 клоков меха йети.‡Bringt Bartolo Ginsetti in Süderstade einen Wollstoffballen, einen Umhang des Hügelwächters, feinen Faden und 10 Haufen Yetifell.‡남녘해안에 있는 바르톨로 진세티에게 양모 두루마리 1개, 산악인의 망토, 가는 실타래, 그리고 설인 모피 10개를 가져가야 합니다.‡Lleva una madeja de lana, una capa de montañero, hilo refinado y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Lleva una madeja de lana, una capa de montañero, hilo refinado y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Apporter à Bartolo Ginsetti d\'Austrivage une Pelote de laine, une Cape d\'homme des collines, du Fil raffiné et 10 Touffes de fourrure de yéti.‡给南海镇的巴图罗·吉塞提找一个毛布卷、一件山地披风、一股细线和10块雪人的毛皮。‡給南海鎮的巴圖羅·吉塞提找一個毛布卷、一件山地披風、一股細線和10塊雪人的毛皮。',
  }
},
[566] = {
  {
    '[DEPRECATED] WANTED: Baron Vardus‡Разыскивается: Барон Вардус‡GESUCHT: Baron Vardus‡바르두스 남작 현상 수배‡[DEPRECATED]SE BUSCA: Barón Vardus‡[DEPRECATED]SE BUSCA: Barón Vardus‡[PÉRIMÉ]ON RECHERCHE : baron Vardus‡[DEPRECATED] 通缉：瓦杜斯男爵‡[DEPRECATED] WANTED: Baron Vardus',
    nil,
    'Mate o Barão Vardus e entregue a cabeça dele para a Alta-executora Darthalia na Serraria Tarren.‡Убейте барона Вардуса и принесите его голову верховной вершительнице Дарталии в Мельницу Таррен.‡Tötet Baron Vardus und bringt seinen Kopf zu Hochexekutorin Darthalia in Tarrens Mühle.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 타렌 제분소에 있는 고위집행관 다살리아에게 가져가야 합니다.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Tuer le baron Vardus et apporter sa tête à la Grande exécutrice Darthalia, à Moulin-de-Tarren.‡杀了瓦杜斯男爵，把他的徽记带给塔伦米尔的高级执行官达萨利亚。‡殺了瓦杜斯男爵，把他的頭帶給塔倫米爾的高階執行官達薩利亞。',
  }
},
[567] = {
  {
    '[DEPRECATED] Dangerous!‡Вооружены и очень опасны!‡Gefährlich!‡위험 인물 수배!‡[DEPRECATED]¡Peligrosos!‡[DEPRECATED]¡Peligrosos!‡[PÉRIMÉ]Dangereux !‡[DEPRECATED] 危险！‡[DEPRECATED] Dangerous!',
    nil,
    'A Alta-executora Darthalia da Serraria Tarren está oferecendo uma recompensa pelas cabeças de Tabelião Horácio Brancorcel, Cidadão Urbano, Minerador Talhatudo e a Fazendeira Kalaba.‡Верховная вершительница Дарталия из Мельницы Таррен назначила награду за убийство клерка Горация Белоконя, гражданина Уилкса, шахтера Хакетта и фермерши Калабы.‡Hochexekutorin Darthalia in Tarrens Mühle hat ein Kopfgeld auf Amtmann Horatio Weißross, Bürger Wilkes, Minenarbeiter Hackett und Bäuerin Kalaba ausgesetzt.‡타렌 제분소의 고위집행관 다살리아가 서기관 호레이스 화이트스티드, 민간인 윌키스, 광부 하켓, 농부 칼라바에 현상금을 걸었습니다.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el funcionario Horracio Corzalbal, el ciudadano Wilkes, el minero Hackett y la granjera Kalaba.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el funcionario Horraceio Corzalbal, el ciudadano Wilkes, el minero Hackett y la granjera Kalaba.‡La Grande exécutrice Darthalia de Moulin-de-Tarren offre une prime pour la mort du Greffier Horrace Blancheval, du Citoyen Wilkes, du Mineur Hackett et de Kalaba la fermière.‡塔伦米尔的高级执行官达萨利亚悬赏通缉书记员赫拉斯·怀特斯蒂德、平民维尔克斯、矿工哈克特和农夫卡拉巴。‡塔倫米爾的高階執行官達薩利亞懸賞通緝書記員赫拉斯·懷特斯蒂德、居民維爾克斯、礦工哈克特和農夫卡拉巴。',
  }
},
[568] = {
  {
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 15 Raptores Batecauda.‡Командир Аггро\'гош из лагеря Гром\'гол поручил вам убить 15 ящеров-кнутохвостов.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 15 Schmetterschwanzraptoren tötet.‡그롬골 주둔지의 사령관 아그로고쉬가 채찍꼬리랩터 15마리를 처치해 달라고 했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 15 Raptors flagellants.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死15只鞭尾迅猛龙。‡格羅姆高營地的指揮官阿格羅戈西要求你殺死15隻鞭尾迅猛龍。',
  }
},
[569] = {
  {
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 10 Brutamontes Ogros e 5 Mandingueiros Ogros.‡Командир Аггро\'гош из лагеря Гром\'гол поручил вам убить 10 огров-громил и 5 огров-знахарей.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 10 Ogerschläger und 5 Ogerhexendoktoren tötet.‡그롬골 주둔지에 있는 사령관 아그로고쉬가 모쉬오그 투사 10명과 모쉬오그 의술사 5명을 처치해 달라고 했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 10 Brutes et 5 Féticheurs ogres.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死10个食人魔蛮兵和5个食人魔巫医。‡格羅姆高營地的指揮官阿格羅戈西要求你殺死10個巨魔蠻卒和5個巨魔巫醫。',
  }
},
[570] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin do Acampamento Grom\'gol quer 8 Garras de Umbragorja e uma Presa Imaculada de Tigresa.‡Предсказатель Мок\'тардин из лагеря Гром\'гол попросил вас принести ему 8 когтей тенебрюхих пантер и безупречный тигриный клык.‡Scharfseher Mok\'thardin im Basislager von Grom\'gol will 8 Schattentatzenkrallen und einen makellosen Tigerinnenfangzahn.‡그롬골 주둔지에 있는 예언자 모크타르딘이 그림자퓨마 발톱 8개와 온전한 암호랑이의 송곳니를 가져다 달라고 했습니다.‡El clarividente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombría y un colmillo de tigresa prístino.‡El clarividente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombría y un colmillo de tigresa prístino.‡Le Long-voyant Mok\'thardin, du Campement Grom\'gol, veut que vous trouviez 8 Griffes de Panthère ombregueule et 1 Croc de tigresse en parfait état.‡格罗姆高营地的先知摩克萨尔丁要求你给他带回8只深喉猎豹的爪子和一颗雌虎的牙齿。‡格羅姆高營地的先知摩克薩爾丁要求你給他帶回8隻深喉獵豹的爪子和一顆雌虎的牙齒。',
  }
},
[571] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve um Tendão de Gorila Velho para o Clarividente Mok\'thardin em Grom\'gol.‡Принесите сухожилие старой гориллы предсказателю Мок\'тардину в лагерь Гром\'гола.‡Bringt die Sehne eines alten Gorillas zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골에 있는 예언자 모크타르딘에게 덩치 큰 고릴라의 힘줄을 가져가야 합니다.‡Lleva un tendón de gorila mayor al clarividente Mok\'thardin en Grom\'gol.‡Lleva un tendón de gorila mayor al clarividente Mok\'thardin en Grom\'gol.‡Apporter un Tendon d\'Ancien gorille de Valbrume au Long-voyant Mok\'thardin, à Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回1根成年大猩猩的肌腱。‡給格羅姆高營地的先知摩克薩爾丁帶回1根成年大猩猩的肌腱。',
  }
},
[572] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve 10 Penas de Espreitador da Selva para o Clarividente Mok\'thardin no Acampamento Grom\'gol.‡Принесите 10 перьев тропических ловцов предсказателю Мок\'тардину в лагерь Гром\'гол.‡Bringt 10 Dschungelpirscherfedern zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골 주둔지에 있는 예언자 모크타르딘에게 줄무늬정글랩터 깃털 10개를 가져가야 합니다.‡Lleva 10 plumas de acechadores de la selva al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Lleva 10 plumas de acechadores de la selva al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Apporter 10 Plumes de Traqueurs de la jungle au Long-voyant Mok\'thardin, au campement Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回10根丛林捕猎者的羽毛。‡給格羅姆高營地的先知摩克薩爾丁帶回10根叢林潛獵者的羽毛。',
  }
},
[573] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin de Grom\'gol precisa de Água da Fonte Abençoada. Ele também quer que você mate 10 Exploradores Nagas.‡Предсказатель Мок\'тардин из лагеря Гром\'гол попросил вас принести ему воду из святого источника. Кроме того, он поручил вам убить 10 наг-исследователей.‡Scharfseher Mok\'thardin von Grom\'gol benötigt Wasser der Heiligen Quelle. Er will auch, dass Ihr 10 Forscher der Naga tötet.‡그롬골에 있는 예언자 모크타르딘이 나가 탐험가 10명을 처치하고 신성한 샘물을 가져다 달라고 했습니다.‡El clarividente Mok\'thardin de Grom\'gol necesita agua de manantial sagrado. También quiere que mates 10 expedicionarios naga.‡El clarividente Mok\'thardin de Grom\'gol necesita agua de manantial sagrado. También quiere que mates 10 expedicionarios naga.‡Le Long-voyant Mok\'thardin de Grom\'gol a besoin d\'Eau de source sacrée. Il veut que vous tuiez aussi 10 Explorateurs nagas.‡格罗姆高营地的先知摩克萨尔丁要你去取回一瓶圣泉之水，同时还要求你杀死10名纳迦探险者。‡格羅姆高營地的先知摩克薩爾丁要你去取回一瓶聖泉之水，同時還要求你殺死10名納迦探險者。',
  }
},
[574] = {
  {
    'Forças especiais‡Особые войска‡Spezialtruppe‡특수 부대‡Fuerzas especiales‡Fuerzas especiales‡Forces spéciales‡特种部队‡特種部隊',
    nil,
    'Mate 10 Tropas de Choque de Kurzen e 6 Encolhedores de Cabeças de Kurzen.|n|nFale com o Tenente Doren no Acampamento dos Rebeldes.‡Убейте 10 коммандос и 6 охотников за головами Курцена.|n|nДоложите об этом лейтенанту Дорену из Лагеря Повстанцев.‡Tötet 10 von Kurzens Kommandosoldaten und 6 von Kurzens Kopfschrumpfer.|n|nErstattet Bericht bei Leutnant Doren im Rebellenlager.‡쿠르젠 특전사 10명과 쿠르젠 심리학자 6명을 처치해야 합니다.|n|n반란군 야영지에 있는 부관 도렌에게 보고하십시오.‡Mata 10 comandos de Kurzen y 6 reductores de cabezas de Kurzen.|n|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Mata 10 comandos de Kurzen y 6 reductores de cabezas de Kurzen.|n|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Tuez 10 Commandos et 6 Réducteurs de têtes de Kurzen.|n|nRendez compte au Lieutenant Doren au Camp rebelle.‡杀掉10名库尔森特种兵和6名库尔森精神医师。|n|n然后向反抗军营地的多伦上尉复命。‡殺掉10名庫爾森特種兵和6名庫爾森精神醫師。|n|n然後向反抗軍營地的多倫中尉覆命。',
  }
},
[575] = {
  {
    'Oferta e demanda‡Спрос и предложение‡Angebot und Nachfrage‡수요와 공급‡La oferta y la demanda‡La oferta y la demanda‡L\'offre et la demande‡供与求‡供與求',
    nil,
    'Leve 2 Peles de Crocolisco Grande do Rio para o Drizzlik na Angra do Butim.‡Принесите 2 большие шкуры речного кроколиска Дриззлику из Пиратской Бухты.‡Bringt 2 große Flusskrokiliskenhäute zu Drizzlik nach Beutebucht.‡무법항에 있는 드리즐릭에게 큰 민물악어 껍질 2장을 가져가야 합니다.‡Lleva 2 pieles de crocoliscos fluviales grandes a Drizzlik en la Bahía del Botín.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Bahía del Botín.‡Apportez 2 Grandes peaux de crocilisque des rivières à Drizzlik, à Baie-du-Butin.‡收集2张淡水鳄的皮，把它们交给藏宝海湾的崔斯里克。‡收集2張淡水鱷的皮，把它們交給藏寶海灣的崔斯里克。',
  }
},
[576] = {
  {
    'Fique de olho‡Смотри в оба‡Ein Auge offen halten‡잃어버린 눈‡¡Ojo!‡¡Ojo!‡Gardez un œil dehors‡海盗的眼睛‡海盜的眼睛',
    nil,
    'Dizzy Caolho da Angra do Butim quer que você recupere seu olho com os Bucaneiros da Vela Sangrenta.‡Диззи Одноглазый из Пиратской Бухты попросил вас отобрать его глаз у пиратов Кровавого Паруса.‡Torkel Einauge in Beutebucht möchte, dass Ihr sein Auge von den Blutsegelbukanieren zurückholt.‡무법항에 있는 애꾸눈 디지가 붉은해적단에게서 그의 눈을 찾아달라고 했습니다.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los Bucaneros Velasangre.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los Bucaneros Velasangre.‡Dizzy le Borgne de Baie-du-Butin veut que vous récupériez son œil chez les boucaniers de la Voile sanglante.‡藏宝海湾的独眼迪兹要求你从血帆海盗那里找回他的眼睛。‡藏寶海灣的獨眼迪茲要求你從血帆海盜那裡找回他的眼睛。',
  }
},
[577] = {
  {
    'Algumas partes faltando‡Немного разнообразия не помешает‡Etwas Zusammenbau benötigt‡무쇠턱악어 껍질‡Hay que ensamblar‡Hay que ensamblar‡La face cachée des bottes‡收集鳄鱼皮‡收集鱷魚皮',
    nil,
    'Leve 5 Peles de Crocolisco Arapuca para Drizzlik na Angra do Butim.‡Отнесите 5 шкур кроколисков-хрустогрызов Дриззлику в Пиратскую Бухту.‡Bringt 5 Schnappkieferkrokiliskenhäute zu Drizzlik nach Beutebucht.‡무법항에 있는 드리즐릭에게 무쇠턱악어 껍질 5장을 가져가야 합니다.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Rapportez 5 Peaux de crocilisque gueule-d\'acier à Drizzlik, à Baie-du-Butin.‡给藏宝海湾的崔斯里克带回5张钳嘴鳄鱼的皮。‡給藏寶海灣的崔斯里克帶回5張鉗嘴鱷魚的皮。',
  }
},
[578] = {
  {
    'A Pedra das Marés‡Камень приливов‡Der Stein der Gezeiten‡해일의 돌‡La piedra de las mareas‡La piedra de las mareas‡La pierre des marées‡海潮之石‡海潮之石',
    nil,
    'Encontre a ilha assombrada para o Barão Rezingada na Angra do Butim.‡По поручению барона Ревилгаза из Пиратской Бухты найдите остров, населенный духами Воды.‡Findet die Spukinsel für Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈를 위해 유령의 섬을 찾아야 합니다.‡Encuentra la isla encantada para el Barón Revilgaz en la Bahía del Botín.‡Encuentra la isla encantada para el Barón Revilgaz en la Bahía del Botín.‡Localiser l\'Ile hantée pour le baron Revilgaz de Baie-du-Butin.‡为藏宝海湾的大财主里维加兹找到闹鬼的岛屿。‡為藏寶海灣的大財主里維加茲找到鬧鬼的島嶼。',
  }
},
[579] = {
  {
    'A Biblioteca de Ventobravo‡Библиотека Штормграда‡Bibliothek von Sturmwind‡스톰윈드 도서관‡La biblioteca de Ventormenta‡La biblioteca de Ventormenta‡La Bibliothèque de Hurlevent‡暴风城图书馆‡暴風城圖書館',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[580] = {
  {
    'O grogue perdido do Aldo Isque‡Потерянный грог Алкача Виски‡Klein Whiskeys verlorener Grog‡위스키 슬림의 잃어버린 술병‡El grog de Whiskey el Delgado‡El grog de Whiskey el Delgado‡La bibine perdue de Whiskey Slim‡威士忌斯利姆的酒‡威士忌·狡黠所遺失的烈酒',
    nil,
    'Aldo Isque, na Angra do Butim, quer que você leve para ele as garrafas de Xerez de Pupellyverbos que ele perdeu.‡Алкач Виски из Пиратской Бухты попросил вас принести ему потерянные бутылки портвейна "Пупелливербос".‡Klein Whiskey in Beutebucht möchte, dass Ihr ihm die Flaschen Pupellyverbos\' Portwein bringt, die er verloren hat.‡무법항에 있는 위스키 슬림이 잃어버린 퍼플리버보스 포트 포도주를 찾아 달라고 했습니다.‡Whiskey el Delgado, en la Bahía del Botín, quiere que le lleves las botellas de oporto Pupellyverbos que perdió.‡Whiskey el Delgado, en la Bahía del Botín, quiere que le lleves las botellas de oporto Pupellyverbos que perdió.‡Whiskey Slim de Baie-du-Butin veut que vous lui rameniez les bouteilles de porto Pupellyverbos qu\'il a perdues.‡藏宝海湾的威士忌斯利姆想要你帮他找回弄丢的紫葡萄酒。‡藏寶海灣的威士忌·狡黠想要你幫他找回弄丟的紫葡萄酒。',
  }
},
[581] = {
  {
    'A caçada ao Yennikan‡Поиски Йеннику‡Die Suche nach Yenniku‡예니쿠 수색‡Caza para Yenniku‡Caza para Yenniku‡La chasse pour Yenniku‡耶尼库的下落‡耶尼庫的下落',
    nil,
    'Leve 9 Presas de Sanguescalpo para Nimboya no Acampamento Grom\'gol.‡Принесите 9 клыков троллей из племени Кровавого Скальпа Нимбойе в лагерь Гром\'гол.‡Bringt 9 Hauer der Blutskalpe zu Nimboya in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 님보야에게 붉은머리의 엄니 9개를 가져가야 합니다.‡Lleva 9 colmillos Sangrapellejo a Nimboya en el Campamento Grom\'gol.‡Lleva 9 colmillos Sangrapellejo a Nimboya en el Campamento Grom\'gol.‡Apporter 9 Défenses de Scalp-rouge à Nimboya au campement Grom\'gol.‡给格罗姆高营地的尼姆布亚带回9根血顶巨魔的獠牙。‡給格羅姆高營地的尼姆布亞帶回9根血頂食人妖的獠牙。',
  }
},
[582] = {
  {
    'Caçando cabeças‡Охота за головами‡Kopfjägerei‡인간사냥꾼‡Caza cabezas‡Caza cabezas‡Les chasseurs de têtes‡狩猎行动‡獵頭行動',
    nil,
    'Leve 20 Cabeças Encolhidas para Nimboya, no Acampamento Grom\'gol.‡Принесите Нимбойе из лагеря Гром\'гол 20 сушеных голов.‡Bringt 20 Schrumpfköpfe zu Nimboya in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 님보야에게 쭈그러든 해골 20개를 가져가야 합니다.‡Lleva 20 cabezas reducidas a Nimboya en el Campamento Grom\'gol.‡Lleva 20 cabezas reducidas a Nimboya en el Campamento Grom\'gol.‡Apporter 20 Têtes réduites à Nimboya au campement Grom\'gol.‡给格罗姆高营地的尼姆布亚带去20个皱缩的徽记。‡給格羅姆高營地的尼姆布亞帶去20個皺縮頭顱。',
  }
},
[583] = {
  {
    'Boas-vindas à selva‡Добро пожаловать в джунгли‡Willkommen im Dschungel‡정글 탐험‡Bienvenido a la jungla‡Bienvenido a la jungla‡Bienvenue dans la jungle‡欢迎来到丛林‡歡迎來到叢林',
    nil,
    'Fale com o Rosarães Guima Jr.‡Поговорите с Хемингом Эрнестуэем-младшим.‡Sucht Hemet Nesingwary Jr. auf und sprecht mit ihm.‡헤멧 네싱워리 2세와 대화해야 합니다.‡Habla con Hemet Nesingwary Jr.‡Habla con Hemet Nesingwary Jr.‡Parler à Hemet Nesingwary Jr.‡与赫米特·奈辛瓦里二世谈一谈。‡與小赫米特‧奈辛瓦里談話。',
  }
},
[584] = {
  {
    'Cabeças do Clã Sanguescalpo‡Головы племени Кровавого Скальпа‡Köpfe des Blutskalpklans‡붉은머리 부족의 머리카락‡Las cabezas de los Sangrapellejo‡Las cabezas de los Sangrapellejo‡Les têtes du clan Scalp-rouge‡血顶徽记‡血頂之顱',
    nil,
    'Leve a Cabeça de Gan\'zulah e a Cabeça de Nezzliok para o caldeirão borbulhante no Acampamento Grom\'gol.‡Принесите головы Ган\'зулы и Неззилока и положите их в бурлящий котел в лагере Гром\'гол.‡Bringt Gan\'zulahs Kopf und Nezzlioks Kopf zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥에 간줄라와 네즐뤼크의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Apporter la Tête de Gan\'zulah et la Tête de Nezzliok dans le Chaudron bouillonnant au campement Grom\'gol.‡将甘祖拉恩的徽记和奈兹里奥克的徽记带回格罗姆高营地，放入冒泡的大锅中。‡將甘祖拉恩的頭顱和奈茲里奧克的頭顱帶回格羅姆高營地，放入冒泡的大鍋中。',
  }
},
[585] = {
  {
    'Falando com Nezzliok‡Разговор с Неззилоком‡Mit Nezzliok sprechen‡네즐뤼크와의 대화‡Hablando con Nezzliok‡Hablando con Nezzliok‡En parlant avec Nezzliok‡奈兹里奥克‡奈茲里奧克',
    nil,
    'Leve um Troféu de Balia\'mah, um Troféu de Ziata\'jai e um Troféu Zul\'Mamwe para o Caldeirão Borbulhante no Acampamento Grom\'gol.‡Принесите в лагерь Гром\'гол трофей из Балиа\'ма, трофей из Зиата\'джаи и трофей из Зул\'Мамве и положите их в бурлящий котел.‡Bringt eine Trophäe von Balia\'mah, eine Trophäe von Ziata\'jai und eine Trophäe von Zul\'Mamwe zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥으로 발리아마 전리품 해골과 지아타자이 전리품 해골, 줄맘웨 전리품 해골을 가져가야 합니다.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Apporter un Trophée de Balia\'mah, un de Ziata\'jai et un de Zul\'Mamwe dans le Chaudron bouillonnant au campement Grom\'gol.‡带回巴里亚曼战利品、赞塔加战利品和祖玛维战利品各一个，把它们放入格罗姆高营地里中的冒泡的大锅里。‡帶回巴里亞曼戰利品、贊塔加戰利品和祖瑪維戰利品各一個，把它們放入格羅姆高營地裡中的冒泡的大鍋裡。',
  }
},
[586] = {
  {
    'Falando com Gan\'zulah‡Разговор с Ган\'зулахом‡Mit Gan\'zulah sprechen‡간줄라와의 대화‡Hablando con Gan\'zulah‡Hablando con Gan\'zulah‡En parlant avec Gan\'zulah‡甘祖拉恩‡甘祖拉恩',
    nil,
    'Mate 8 Caçadores Rachacrânio, 6 Caçadores de Cabeças Rachacrânio e 4 Berserkers Rachacrânio.|n|nLeve a Armadura Quebrada de Ana\'thek para o Caldeirão Borbulhante, que fica no Acampamento Grom\'gol.‡Убейте 8 охотников, 6 охотников за головами и 4 берсерков из племени Дробителей Черепов.|n|nПринесите разбитые доспехи Ана\'тека к бурлящему котлу в лагере Гром\'гол.‡Tötet 8 Jäger der Schädelspalter, 6 Kopfjäger der Schädelspalter und 4 Berserker der Schädelspalter.|n|nBringt die zerbrochene Rüstung von Ana\'thek zum blubbernden Kessel in das Basislager von Grom\'gol.‡백골가루 사냥꾼 8명, 백골가루 인간사냥꾼 6명, 그리고 백골가루 광전사 4명을 처치해야 합니다.|n|n그롬골 주둔지에 있는 끓고 있는 가마솥으로 망가진 아나텍의 갑옷을 가져가야 합니다.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|n|nLleva la armadura de Ana\'thek rota a la caldera en ebullición del Campamento Grom\'gol.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|n|nLleva la armadura de Ana\'thek rota a la caldera en ebullición del Campamento Grom\'gol.‡Tuez 8 Chasseurs, 6 Chasseurs de têtes, et 4 Berserkers du clan Casse-crâne.|n|nApportez l\'Armure brisée d\'Ana\'thek au Chaudron bouillonnant, au Campement Grom\'gol.‡杀死8名劈颅猎人、6名劈颅猎头者和4名劈颅狂战士。|n|n将安纳希克的盔甲碎片放入格罗姆高营地中的冒泡的大锅里。‡殺死8名劈顱獵人、6名劈顱獵頭者和4名劈顱狂戰士。|n|n將安納希克的盔甲碎片放入格羅姆高營地中的冒泡的大鍋裡。',
  }
},
[587] = {
  {
    'Levaram o rapé‡Понюшка табака‡Auf dem Schnupftabak‡코담배를 찾아서‡Tabaco rapé‡Tabaco rapé‡Faire un tabac‡鼻烟‡鼻煙',
    nil,
    'O Dígui, na Angra do Butim, quer que você leve para ele 15 trouxinhas de Rapé.‡Диг из Пиратской Бухты попросил принести ему 15 понюшек табаку.‡Deeg in Beutebucht möchte, dass Ihr ihm 15 Prisen Schnupftabak bringt.‡무법항에 있는 디그가 코담배 15개를 가져다 달라고 했습니다.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 pizcas de tabaco.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 pizcas de tabaco.‡Deeg de Baie-du-Butin veut que vous lui apportiez 15 portions de Tabac à priser.‡藏宝海湾的迪格要求你带给他15份鼻烟。‡藏寶海灣的迪格要求你帶給他15份鼻煙。',
  }
},
[588] = {
  {
    '‡Судьба Йеннику‡Yennikus Schicksal‡‡El destino de Yenniku‡El destino de Yenniku‡Le sort de Yenniku‡耶尼库的命运‡',
    nil,
    '‡Поговорите с Кин\'вилаем.‡Sprecht mit Kin\'weelay.‡이 퀘스트는 블리자드에 의해 구식으로 지정되어 더 이상 받거나 완료할 수 없습니다.</b>[Speak with Kin\'weelay.]<h2 class="heading-size-3">서술</h2>[<Nezzliok speaks.>|n|nYou have appeased myself and my chief, so I will tell you that which you seek to discover...|n|nYoung Yenniku is lost to his clan.|n|nHe was taken by the witchdoctor Zanzil the Outcast. Now Zanzil controls him, body and soul, and only the most potent magic could set him free.|n|nA magic that you do not have, $C.|n|nPerhaps your Darkspear allies can offer a hope of Yenniku\'s salvation. But that, I doubt.]<h2 class="heading-size-3"><a href="javascript:;" class="disclosure-off" onclick="return WH.disclose(WH.ge(\'lknlksndgg-completion\'), this)">완료</a></h2>Zanzil the Outcast??|n|nIf Yenniku is held by that troll, a vile and powerful witchdoctor, then I fear that only a faint hope remains. &nbsp;Faint. &nbsp;And tiny as the smallest insect.|n|nBut still, it is hope.<h2 class="heading-size-3">획득</h2>퀘스트 완료 시 보상:<ul><li>‡Habla con Kin\'weelay.‡Habla con Kin\'weelay.‡Parler à Kin\'weelay.‡与肯维雷谈一谈。‡',
  }
},
[589] = {
  {
    'Os cristais cantantes‡Поющие кристаллы‡Die singenden Kristalle‡고동치는 푸른 수정‡Los cristales canto‡Los cristales canto‡Les cristaux chantants‡歌唱水晶‡歌唱水晶',
    nil,
    'Leve 3 Estilhaços Azuis Pulsantes para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 3 пульсирующих синих осколка Кин\'вилаю в лагерь Гром\'гол.‡Bringt 3 pulsierende blaue Splitter zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 고동치는 푸른 수정 3개를 가져가야 합니다.‡Lleva 3 fragmentos azules pulsantes a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 3 fragmentos azul pulsante a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 3 Éclats vibrants bleus à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回3块蓝色波光碎片。‡給格羅姆高營地的肯維雷帶回3塊藍色波光裂片。',
  }
},
[590] = {
  {
    '‡Выгодная сделка‡Ein Schurkenhandel‡도적의 거래‡Un trato de pícaro‡Un trato de pícaro‡Un marché de voleur‡潜行者的交易‡',
    nil,
    '‡Одержите победу в схватке с Кальвином Монтеччи в Могильнике.‡Besiegt Calvin Montague in Todesend.‡이 퀘스트는 블리자드에 의해 구식으로 지정되어 더 이상 받거나 완료할 수 없습니다.</b>[Defeat Calvin Montague in Deathknell.]‡Derrota a Calvin Montesco en Camposanto.‡Derrota a Calvin Montesco en Camposanto.‡Battre Calvin Montague au Glas.‡打败丧钟镇的卡尔文·蒙泰古。‡',
  }
},
[591] = {
  {
    'O Olho da Mente‡Око разума‡Das Gedankenauge‡마음의 눈‡El Ojo de la mente‡El Ojo de la mente‡La vue de l\'esprit‡心灵之眼‡心靈之眼',
    nil,
    'Leve o Olho da Mente para Kin\'weelay, no Acampamento Grom\'gol.‡Отнесите око разума Кинвилаю в лагерь Гром\'гол.‡Bringt das Gedankenauge zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 마음의 눈을 가져가야 합니다.‡Lleva el Ojo de la mente a Kin\'weelay en el Campamento Grom\'gol.‡Lleva el Ojo de la mente a Kin\'weelay en el Campamento Grom\'gol.‡Apportez la Vue de l\'esprit à Kin\'weelay au Campement Grom\'gol.‡将心灵之眼交给格罗姆高营地里的肯维雷。‡將心靈之眼交給格羅姆高營地裡的肯維雷。',
  }
},
[592] = {
  {
    'Salvando Yennikan‡Спасение Йеннику‡Yennikus Rettung‡예니쿠 구출‡Salvar a Yenniku‡Salvar a Yenniku‡Il faut sauver Yenniku‡拯救耶尼库‡拯救耶尼庫',
    nil,
    'Leve a Joia de Alma Plena para Nimboya.‡Отнесите Нимбойе наполненный самоцвет Души.‡Bringt den gefüllten Seelenedelstein zu Nimboya.‡님보야에게 충만한 영혼의 보석을 가져가야 합니다.‡Lleva la gema de alma llena a Nimboya.‡Lleva la gema de alma llena a Nimboya.‡Apportez la Gemme d\'âme remplie à Nimboya.‡将装满的灵魂宝石交给尼姆布亚。‡將裝滿的靈魂寶石交給尼姆布亞。',
  }
},
[593] = {
  {
    '‡Наполнение самоцвета Души‡Den Seelenedelstein füllen‡‡Gema de alma‡Gema de alma‡Une âme pour la gemme‡灵魂宝石‡',
    nil,
    nil,
  }
},
[594] = {
  {
    'Mensagem na garrafa‡Послание в бутылке‡Flaschenpost‡쪽지가 든 병‡Mensaje en una botella‡Mensaje en una botella‡Message dans une bouteille‡瓶中信‡瓶中信',
    nil,
    'Encontre o autor da mensagem na garrafa.‡Отыщите автора послания в бутылке.‡Findet den Schreiber dieser Flaschenpost.‡쪽지가 든 병의 장본인을 찾아야 합니다.‡Encuentra al autor del mensaje en la botella.‡Encuentra al autor del mensaje en la botella.‡Trouver la main qui a écrit ce message lancé à la mer dans une bouteille.‡找到瓶中信的作者。‡找到瓶中信的作者。',
  }
},
[595] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Imediato Crazz quer que você cheque a enseada ao norte da Angra do Butim.‡Первый помощник Кразз попросил вас осмотреть залив на севере от Пиратской Бухты.‡Erster Maat Krazz will, dass Ihr die Bucht nördlich von Beutebucht überprüft.‡일등항해사 크래즈가 무법항 북쪽의 작은 만을 조사해 달라고 했습니다.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡Le Second Crazz veut que vous contrôliez la crique au nord de Baie-du-Butin.‡大副克拉兹要求你去侦察一下藏宝海湾北边的海滩。‡大副克拉茲要求你去偵察一下藏寶海灣北邊的海灘。',
  }
},
[596] = {
  {
    'Colares de osso ensanguentado‡Ожерелье кровавых костей‡Blutige Knochenhalskette‡피묻은 뼈목걸이‡Collares de huesos sangrientos‡Collares de huesos sangrientos‡Les Colliers d\'os ensanglantés‡染血的白骨项链‡染血的白骨項鍊',
    nil,
    'Leve 25 Colares de Osso Ensanguentado para Kin\'weelay no Acampamento Grom\'gol.‡Принесите Кин\'вилаю 25 ожерелий кровавых костей в лагерь Гром\'гол.‡Bringt 25 blutige Knochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 피묻은 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os ensanglantés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串染血的白骨项链。‡給格羅姆高營地的肯維雷帶回25串染血的白骨項鍊。',
  }
},
[597] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate suas descobertas ao Imediato Crazz na Angra do Butim.‡Отнесите находку первому помощнику Краззу в Пиратскую Бухту.‡Berichtet dem Ersten Maat Krazz in Beutebucht von Euren Funden.‡무법항에 있는 일등항해사 크래즈에게 조사 결과를 보고해야 합니다.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Rendre compte de vos découvertes au Second Crazz à Baie-du-Butin.‡将你的发现报告给藏宝海湾的大副克拉兹。‡將你的發現報告給藏寶海灣的大副克拉茲。',
  }
},
[598] = {
  {
    'Colar de Osso Partido‡Ожерелье расколотых костей‡Spaltknochenhalskette‡부서진 뼈목걸이‡Collar de hueso partido‡Collar de hueso partido‡Collier d\'os brisés‡裂骨项链‡裂骨項鍊',
    nil,
    'Leve 25 Colares de Osso Partido para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 25 ожерелий расколотых костей Кин\'вилаю в лагерь Гром\'гол.‡Bringt 25 Spaltknochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 부서진 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de hueso partido a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de hueso partidos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os brisés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串裂骨项链。‡給格羅姆高營地的肯維雷帶回25串裂骨項鍊。',
  }
},
[599] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate ao Mestre de Frota Chifre do Mar o ataque planejado pelos Vela Sangrenta.‡Сообщите о запланированном нападении Кровавого Паруса командиру флота Морскому Рогу.‡Erstattet Flottenmeister Seehorn Bericht über den geplanten Angriff der Blutsegelbukaniere.‡함장 시혼에게 붉은해적단의 공격 계획을 보고해야 합니다.‡Informa del ataque planeado de los Velasangre al maestro de flota Cuernomarino.‡Informa del ataque planeado de los Velasangre al maestro de flota Cuernomarino.‡Rendre compte de l\'attaque que prépare la Voile sanglante à l\'amiral Corne-de-Mer.‡把血帆海盗的计划报告给舰队指挥官海角。‡把血帆海盜的計畫報告給艦隊指揮官卡拉·海角。',
  }
},
[600] = {
  {
    'Mineração da Empreendimentos S.A.‡Рудник Торговой Компании‡Venture Company-Bergbau‡투자개발회사 채광‡La minería de Ventura y Cía.‡La minería de Ventura y Cía.‡Les mines de la KapitalRisk‡风险投资公司‡風險投資公司的採礦行為',
    nil,
    'Leve 10 Cristais Azuis Canoros para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской Бухты 10 синих Поющих кристаллов.‡Bringt 10 singende blaue Kristalle zu Crank Zischelbub nach Beutebucht.‡무법항에 있는 크랭크 피즐버브에게 노래하는 파란 수정 10개를 가져가야 합니다.‡Lleva 10 cristales canto azules a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 10 cristales canto azules a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 10 Cristaux bleus chantants à Grincheux Bullévente, à Baie-du-Butin.‡给藏宝海湾的克兰克·菲兹巴布带回10块蓝色歌唱水晶。‡給藏寶海灣的克蘭克·菲茲巴布帶回10塊藍色歌唱水晶。',
  }
},
[601] = {
  {
    'Elementais da água‡Элементали воды‡Wasserelementare‡물의 정령‡Elementales de agua‡Elementales de agua‡Les élémentaires d\'eau‡水元素‡水元素',
    nil,
    'Consiga 6 Braçadeiras de Elementais da Água para o Barão Rezingada na Angra do Butim.‡Принесите барону Ревилгазу в Пиратскую Бухту 6 браслетов элементалей воды.‡Holt 6 Wasserelementararmschienen für Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈가 물의정령 족쇄 6개를 모아 달라고 했습니다.‡Consigue 6 brazales de elemental de agua para el Barón Revilgaz en la Bahía del Botín.‡Consigue 6 brazales de elementales de agua para el Barón Revilgaz en la Bahía del Botín.‡Récupérez 6 Bracelets d\'élémentaire d\'eau pour le Baron Revilgaz à Baie-du-Butin.‡为藏宝海湾的大财主里维加兹收集6个水元素护腕。‡為藏寶海灣的大財主里維加茲收集6個水元素護腕。',
  }
},
[602] = {
  {
    'Análise mágica‡Магический анализ‡Magische Analyse‡마법 분석‡Análisis mágico‡Análisis mágico‡L\'analyse magique‡魔法分析‡魔法分析',
    nil,
    'Bring the water elemental bracers to Archmage Ansirem Runeweaver in Dalaran Crater.‡Отнесите браслеты элементалей воды верховному магу Ансарему Руноплету в Даларан.‡Bringt die Wasserelementararmschienen zu Erzmagier Ansirem Runenweber am Dalarankrater.‡달라란 구덩이에 있는 대마법사 앤자이럼 룬위버에게 물의정령 족쇄가 든 가방을 가져가야 합니다.‡Lleva los brazales de elementales de agua al archimago Ansirem Tejerruna en el Cráter de Dalaran.‡Lleva los brazales de elementales de agua al archimago Ansirem Tejerruna en el Cráter de Dalaran.‡Apportez les Bracelets d’élémentaires d\'eau à l\'Archimage Ansirem Tisserune, au Cratère de Dalaran.‡将水元素护腕交给达拉然巨坑的大法师安斯雷姆·鲁因。‡將水元素護腕交給達拉然陷坑的大法師安斯雷姆·織符者。',
  }
},
[603] = {
  {
    'Chave de Ansirem‡Ключ Ансарема‡Ansirems Schlüssel‡앤자이럼의 열쇠‡Llave de Ansirem‡Llave de Ansirem‡La Clé d\'Ansirem‡安斯雷姆的钥匙‡安斯雷姆的鑰匙',
    nil,
    'Fale com Fátia na Angra do Butim.‡Поговорите с Кателиной в Пиратской Бухте.‡Sprecht mit Catelyn in Beutebucht.‡무법항에 있는 케이틀린과 대화해야 합니다.‡Habla con Catelyn en la Bahía del Botín.‡Habla con Catelyn en la Bahía del Botín.‡Parler à Catelyn à Baie-du-Butin.‡与藏宝海湾的凯特琳谈一谈。‡與藏寶海灣的凱特琳談話。',
  }
},
[604] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Mestre de Frota Chifre do Mar na Angra do Butim quer que você mate 10 Espadachins da Vela Sangrenta e traga de volta as Cartas de Navegação da Vela Sangrenta e as Ordens da Vela Sangrenta.‡Командир флота Морской Рог из Пиратской Бухты попросил вас убить 10 сорвиголов из шайки Кровавого Паруса и принести ему карты и приказы Кровавого Паруса.‡Flottenmeister Seehorn in Beutebucht will, dass Ihr 10 Schwadroneure der Blutsegelbukaniere tötet und die Blutsegelkarten sowie die Blutsegelbefehle zurückbringt.‡무법항에 있는 함장 시혼이 붉은해적단 칼잡이 10명을 처치하고 붉은해적단 해도와 붉은해적단 명령서를 가지고 와 달라고 했습니다.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates 10 espadachines Velasangre y le lleves las cartas de navegación y las órdenes de los Velasangre.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates 10 espadachines Velasangre y le lleves las cartas de navegación y las órdenes de los Velasangre.‡L\'amiral Corne-de-Mer à Baie-du-Butin veut que vous tuiez 10 Bretteurs de la Voile sanglante et que vous rapportiez les Cartes de la Voile sanglante et les Ordres de la Voile sanglante.‡藏宝海岸的舰队指挥官海角要求你杀死10名血帆流氓并将血帆海图和血帆计划书带回去。‡藏寶海岸的艦隊指揮官卡拉·海角要求你殺死10名血帆劍客並將血帆海圖和血帆計畫書帶回去。',
  }
},
[605] = {
  {
    'Estilhaços azuis cantantes‡Осколки Поющих кристаллов‡Singende blaue Splitter‡노래하는 수정 조각‡Fragmentos de cristales canto azules‡Fragmentos de cristales canto azules‡Les éclats bleus chantants‡歌唱水晶碎片‡藍色歌唱水晶裂片',
    nil,
    'Leve 10 Estilhaços de Cristal Cantante para Cranque Mirrabolha.‡Принесите Шиззи Пуззыриксу 10 осколков Поющих кристаллов.‡Bringt 10 singende Kristallsplitter zu Crank Zischelbub.‡크랭크 피즐버브에게 노래하는 수정 조각 10개를 가져가야 합니다.‡Lleva 10 fragmentos de cristales canto a Loquillo Pinchabujas.‡Lleva 10 fragmentos de cristales canto a Loquillo Pinchabujas.‡Apportez 10 Éclats de cristal chantant à Grincheux Bullévente.‡为克兰克·菲兹巴布收集10块歌唱水晶碎片。‡為克蘭克·菲茲巴布收集10塊歌唱水晶裂片。',
  }
},
[606] = {
  {
    'Fazendo o Sacode tremer‡Напугать Трусишку‡Zitterhand Angst einjagen‡겁쟁이‡Asusta al Trémulo‡Asusta al Trémulo‡Effrayer Philippe le Chancelant‡吓唬病鬼‡嚇唬病鬼',
    nil,
    'Leve 5 Miúdos de Gorila do Vale da Névoa para "Phillipe "Sacode" na Angra do Butim.‡Отнесите 5 потрохов горилл из Мглистой долины Филиппу "Трусишке"  в Пиратскую Бухту.‡Bringt 5 Nebeltalinnereien zu "Zitterhand" Phillipe nach Beutebucht.‡무법항에 있는 겁쟁이 필립에게 안개계곡고릴라 내장 5개를 가져가야 합니다.‡Lleva 5 menudillos de Velo de Bruma a Phillipe el "Trémulo" en la Bahía del Botín.‡Lleva 5 menudillos de Velo de Bruma a Phillipe el "Trémulo" en la Bahía del Botín.‡Apportez 5 Abats de Valbrume à Phillippe le Chancelant à Baie-du-Butin.‡给藏宝海湾的"病鬼"菲利普带回5块薄雾谷猩猩的内脏。‡給藏寶海灣的『病鬼』菲力浦帶回5塊迷霧谷猩猩的內臟。',
  }
},
[607] = {
  {
    '‡Возвращение к Маккинли‡Rückkehr zu MacKinley‡맥킨리에게 돌아가기‡Regresa junto a MacKinley‡Regresa junto a MacKinley‡De retour chez MacKinley‡向马克基雷回报‡',
    nil,
    '‡Отнесите плату Трусишки "Морскому волку" Маккинли в Пиратской бухте.‡Bringt Zitterhands Bezahlung zu "Seewolf" MacKinley.‡이 퀘스트는 블리자드에 의해 구식으로 지정되어 더 이상 받거나 완료할 수 없습니다.</b>\'바다늑대\' 맥킨리에게 겁쟁이 필립의 빚진 돈을 가져가야 합니다.‡Lleva el pago del Trémulo a "Lobo de Mar" MacKinley.‡Lleva el pago del Trémulo a "Lobo de Mar" MacKinley.‡Apportez le Paiement de Philippe le Chancelant à MacKinley « Loup des mers ».‡将菲利浦的还款交给“海狼”马克基雷。‡',
  }
},
[608] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Mestre de Frota Chifre do Mar em Angra do Butim quer que você mate o Capitão Tranquiláguas, o Capitão Querena e o Mestre de Frota Firalião.‡Командир флота Морской Рог из Пиратской Бухты попросил вас убить капитана Штиллеца, капитана Кильвателя и командира флота Фираллона.‡Flottenmeister Seehorn in Beutebucht will, dass Ihr Kapitän Stillwasser, Käpt\'n Kielhol und Flottenmeister Firallon tötet.‡무법항에 있는 함장 시혼이 선장 스틸워터, 선장 킬홀과 함장 피랠론을 암살해 달라고 했습니다.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates al capitán Aguasmansas, al capitán Sinquilla y al maestro de flota Firallon.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates al capitán Aguasmansas, al capitán Sinquilla y al maestro de flota Firallon.‡L’Amiral Corne-de-Mer de Baie-du-Butin veut que vous tuiez le Capitaine Eau-Plate, le Capitaine Soulaquille et l’Amiral Firallon.‡藏宝海湾的舰队指挥官卡拉-海角要求你杀死血帆海盗的斯蒂沃特船长，尼哈鲁船长和舰队指挥官菲尔拉伦。‡藏寶海灣的艦隊指揮官卡拉·海角要求你殺死血帆海盜的斯蒂沃特船長，尼哈魯船長和艦隊指揮官菲爾拉倫。',
  }
},
[609] = {
  {
    'Vodu devido‡Должники вуду‡Voodooschulden‡빚 돌려받기‡El vudú debido‡El vudú debido‡Gages vaudou‡讨债行动‡討債行動',
    nil,
    'Leve o Pé-de-clava do Maury, a Luneta Dourada de Janjão e o Anel Enorme do Chucky para MacKinley "Lobo do Mar" na Angra do Butim.‡Принесите деревянную ногу Моури, золотую подзорную трубу Джон-Джона и огромное кольцо Чаки "Морскому волку" Маккинли в Пиратскую Бухту.‡Bringt Maurys Klumpfuß, Jon-Jons goldenes Handfernrohr und Chuckys gewaltigen Ring zu "Seewolf" MacKinley in Beutebucht.‡무법항에 있는 "바다늑대" 맥킨리에게 마우리의 의족, 존존의 황금 망원경과 처키의 큰 반지를 가져가야 합니다.‡Lleva la pata de palo de Maury, el catalejo dorado de Jon-Jon y el anillo enorme de Chucky a "Lobo de Mar" MacKinley en la Bahía del Botín.‡Lleva la pata de palo de Maury, el catalejo dorado de Jon-Jon y el anillo enorme de Chucky a "Lobo de Mar" MacKinley en la Bahía del Botín.‡Apporter le Pied bot de Maury, la Longue-vue dorée de Jon-Jon, et le Grand anneau de Chucky à MacKinley "Loup des mers" à Baie-du-Butin.‡给藏宝海湾的"海狼"马克基雷带回玛雷的畸形足、乔乔的金色望远镜和苏克的巨型戒指。‡給藏寶海灣的『海狼』麥克基雷帶回瑪雷的木腳、喬喬的金色望遠鏡和蘇克的巨型戒指。',
  }
},
[610] = {
  {
    'Duncan "Bonitão"‡"Красавчик" Дункан‡Schönling Duncan‡"꽃미남" 던컨‡"El Guapo" Duncan‡"El Guapo" Duncan‡Duncan « le Beau garçon »‡帅小伙子邓肯‡『漂亮男孩』鄧肯',
    nil,
    'Recupere a adaga de Fátia com Duncan "Bonitão".‡Отберите кинжал Кателины у "Красавчика" Дункана.‡Holt Catelyns Dolch von "Schönling" Duncan.‡"꽃미남" 던컨에게서 케이틀린의 단검을 구해야 합니다.‡Consigue la daga de Catelyn de "El Guapo" Duncan.‡Consigue la daga de Catelyn de "El Guapo" Duncan.‡Récupérer la Dague de Catelyn auprès de Duncan « le Beau garçon ».‡从"帅小伙子"邓肯那里夺回凯特琳的匕首。‡從『漂亮男孩』鄧肯那裡奪回凱特琳的匕首。',
  }
},
[611] = {
  {
    'A maldição das marés‡Проклятье приливов‡Der Fluch der Gezeiten‡해일의 저주‡La maldición de las mareas‡La maldición de las mareas‡La malédiction des marées‡海潮的诅咒‡海潮的詛咒',
    nil,
    'Destrua o Altar das Marés com a Lâmina de Fátia, mate Gazban e leve a Pedra das Marés e a Lâmina de Fátia para o Barão Rezingada.‡Уничтожьте Алтарь Приливов при помощи меча Кателины, убейте Газбана и принесите Камень Приливов и меч Кателины барону Ревилгазу.‡Zerstört den Altar der Gezeiten mit Catelyns Klinge, tötet Gazban und bringt dann den Stein der Gezeiten sowie Catelyns Klinge zurück zu Baron Revilgaz.‡케이틀린의 검으로 해일의 제단을 파괴한 다음 가즈반을 처치하고 해일의 돌과 케이틀린의 검을 남작 레빌가즈에게 가져가야 합니다.‡Destruye el Altar de las Mareas con la daga de Catelyn, mata a Gazban y lleva la Piedra de las Mareas y la daga de Catelyn al Barón Revilgaz.‡Destruye el Altar de las Mareas con la daga de Catelyn, mata a Gazban y lleva la Piedra de las Mareas y la daga de Catelyn al Barón Revilgaz.‡Détruire l\'Autel des Marées avec la Lame de Catelyn, tuer Gazban et rapporter la Pierre des Marées et la Lame de Catelyn au baron Revilgaz.‡用凯特琳的匕首摧毁海潮祭坛，然后杀死加兹班，将海潮之石带给大财主里维加兹。‡用凱特琳之刃摧毀海潮祭壇，然後殺死加茲班，將海潮之石帶給大財主里維加茲。',
  }
},
[613] = {
  {
    'Abrindo o pé do Maury‡Вскрыть ногу Моури‡Maurys Fuß aufbrechen‡마우리의 의족 열기‡Abrir la pata de Maury‡Abrir la pata de Maury‡Le pied-bot de Maury‡玛雷的腿‡打開瑪雷的木腳',
    nil,
    'Leve a Chave de Maury para MacKinley "Lobo do Mar" na Angra do Butim.‡Принесите "Морскому Волку" Маккинли из Пиратской Бухты ключ Моури.‡Bringt Maurys Schlüssel zu "Seewolf" MacKinley in Beutebucht.‡무법항에 있는 "바다늑대" 맥킨리에게 마우리의 열쇠를 가져가야 합니다.‡Lleva la llave de Maury a "Lobo de Mar" Mackinley en la Bahía del Botín.‡Lleva la llave de Maury a "Lobo de Mar" Mackinley en la Bahía del Botín.‡Apportez la Clé de Maury à MacKinley « Loup des mers » à Baie-du-Butin.‡把玛雷的钥匙带给藏宝海湾的"海狼"马克基雷。‡把瑪雷的鑰匙帶給藏寶海灣的『海狼』麥克基雷。',
  }
},
[614] = {
  {
    '‡Сундук капитана‡Die Truhe des Kapitäns‡선장의 상자‡El cofre del Capitán‡El cofre del Capitán‡Le coffre du capitaine‡船长的箱子‡隊長的箱子',
    nil,
    '‡Верните Гекельберри Смоттсу из Пиратской Бухты его сундук.‡Bringt Smotts\' Truhe zu Hecklebury Smotts nach Beutebucht.‡이 퀘스트는 블리자드에 의해 구식으로 지정되어 더 이상 받거나 완료할 수 없습니다.</b>무법항에 있는 허클베리 스모츠에게 스모츠의 상자를 가져가야 합니다.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Apportez son Coffre au capitaine Hecklebury Smotts à Baie-du-Butin.‡将斯莫特的箱子交给藏宝海湾的海克拜瑞·斯莫特。‡',
  }
},
[615] = {
  {
    '‡Капитанская сабля‡Der Entersäbel des Kapitäns‡‡El alfanje del Capitán‡El alfanje del Capitán‡Le sabre du capitaine Smotts‡船长的弯刀‡',
    nil,
    '‡Поговорите с Салагой.‡Sprecht mit Knirpsens.‡이 퀘스트는 블리자드에 의해 구식으로 지정되어 더 이상 받거나 완료할 수 없습니다.</b>[Speak with Sprogger.]<h2 class="heading-size-3">서술</h2>[After I lost my first ship to those giants, I bought another. Named Smotts\' Revenge, I filled it with supplies and crew, and set out to find the villains. I found them, but...they beat me. They smashed Smotts\' Revenge, killed my second crew and set me on another lifeboat.|n|nThis time another of the giants, Negolash, stole my cutlass.|n|nFace Negolash and bring me my cutlass!|n|nSpeak with Sprogger. He was my cook on the Smotts\' Revenge, and survived the last attack. He can help you find the giant.]<h2 class="heading-size-3">획득</h2>퀘스트 완료 시 보상:<ul><li>‡Habla con Tardo.‡Habla con Tardo.‡Parler à Bizutard.‡与斯普罗格谈一谈。‡',
  }
},
[616] = {
  {
    '‡Остров духов‡Die Spukinsel‡유령의 섬‡La isla fantasma‡La isla fantasma‡L\'île hantée‡幽灵岛‡',
    nil,
    '‡Поговорите с бароном Ревилгазом в Пиратской Бухте.‡Sprecht mit Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈와 대화해야 합니다.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Parler au Baron Revilgaz, à Baie-du-Butin.‡与藏宝海湾的大财主里维加兹谈一谈。‡',
  }
},
[617] = {
  {
    'Akiris aos montes‡Вязанка акириса‡Bündelweise Akiris‡아키리스 묶음‡Fardo de cañas akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡一捆海蛇草',
    nil,
    'Leve 10 Feixes de Junco de Akiris para o Corsário Bloads na Angra do Butim.‡Принесите каперу Блоудсу из Пиратской Бухты 10 вязанок акириса.‡Bringt 10 Stängel Akirisschilfrohr zu Freibeuter Plust nach Beutebucht.‡무법항에 있는 선원 블로즈에게 아키리스 갈대 묶음 10개를 가져가야 합니다.‡Consigue 10 fardos de cañas akiris para el corsario Bloads en Bahía del Botín.‡Consigue 10 fajos de junco akiris para el corsario Bloads en Bahía del Botín.‡Apporter 10 Roseaux akiris au Corsaire Bloads à Baie-du-Butin.‡给藏宝海湾的海盗布劳兹带回10根海蛇草。‡給藏寶海灣的私掠者布勞茲帶回10捆海蛇草。',
  }
},
[618] = {
  {
    '‡Бой с Неголашем‡Negolash entgegentreten‡‡Enfréntate a Negolash‡Enfréntate a Negolash‡Face à Negolash‡挑战奈古拉什‡',
    nil,
    '‡Отнесите 10 жареных крылышек канюка и 5 бутылок экзотического вина в спасательную шлюпку капитана Смоттса.|n|nУбейте Неголаша и отнесите абордажную саблю Смоттса хозяину в Тернистую долину.‡Bringt 10 gegrillte Bussardflügel und 5 Flaschen Dschungelrankenwein zu Käpt\'n Smotts Rettungsboot.|n|nTötet Negolash und bringt Smotts\' Entersäbel zu Kapitän Smotts ins Schlingendorntal.‡‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.|n|nMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.|n|nMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Apporter 10 Ailes de busard grillées et 5 bouteilles de Vin de Junglevigne dans le Canot de sauvetage du capitaine Smotts.|n|nTuer Negolash, et apporter le Sabre d\'abordage de Smotts au capitaine Smotts, à Strangleronce.‡将10块烧烤秃鹰翅膀和5瓶密林葡萄酒带到斯莫特船长的救生艇上去。|n|n然后杀死奈古拉什，将斯莫特的弯刀交给荆棘谷的斯莫特船长。‡',
  }
},
[619] = {
  {
    '‡Приманка для Неголаша‡Negolash anlocken‡‡La tentación de Negolash‡La tentación de Negolash‡Allécher Negolash‡引诱奈古拉什‡',
    nil,
    nil,
  }
},
[620] = {
  {
    '‡Кушак с монограммой‡Die Schärpe mit Monogramm‡이니셜이 새겨진 머리띠‡La banda con monograma‡La banda con monograma‡L\'écharpe à monogramme‡刺着字母的腰带‡',
    nil,
    '‡Верните кушак с монограммой владельцу.‡Bringt die Schärpe mit Monogramm zu ihrem Besitzer zurück.‡이니셜이 새겨진 머리띠를 주인에게 돌려줘야 합니다.‡Devuelve la banda con monograma a su propietario.‡Devuelve la banda con monograma a su propietario.‡Rendre l\'Echarpe à monogramme à son propriétaire.‡将刺着字母的腰带还给他的主人。‡',
  }
},
[621] = {
  {
    'O segredo de Zanzil‡Тайна Занзила‡Zanzils Geheimnis‡잔질의 비법‡El secreto de Zanzil‡El secreto de Zanzil‡Le secret de Zanzil‡赞吉尔的秘密‡贊吉爾的秘密',
    nil,
    'Leve 12 amostras do Preparado de Zanzil para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской Бухты 12 образцов смеси Занзила.‡Bringt 12 Proben von Zanzils Mixtur zu Crank Zischelbub nach Beutebucht.‡무법항에 있는 크랭크 피즐버브에게 잔질의 혼합물 12개를 가져가야 합니다.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 12 Échantillons de Mixture de Zanzil à Grincheux Bullévente à Baie-du-Butin.‡收集12份赞吉尔的药剂，把它们交给藏宝海湾的克兰克·菲兹巴布。‡收集12份贊吉爾的藥劑，把它們交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[622] = {
  {
    '‡Возвращение к капралу Калебу‡Kehrt zu Korporal Kaleb zurück‡하사관 칼레브에게 돌아가기‡Regresa junto al cabo Kaleb‡Regresa junto al cabo Kaleb‡La cocotte du caporal Kaleb‡向卡雷布下士回报‡',
    nil,
    '‡Отнесите целый горшок Крейвела капралу Калебу в Лагерь повстанцев.‡Bringt Krazeks reparierten Topf zu Korporal Kaleb im Rebellenlager.‡‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Apporter la Cocotte réparée de Krazek au caporal Kaleb, au Camp rebelle.‡将修理过的烹调锅交给叛军营地的卡雷布下士。‡',
  }
},
[623] = {
  {
    'Akiris aos montes‡Вязанка акириса‡Bündelweise Akiris‡아키리스 묶음‡Fardo de cañas akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡一捆海蛇草',
    nil,
    'Leve um Feixe de Junco de Akiris para o Corsário Groy, em Theramore.‡Принесите вязанку акириса каперу Грою в Терамор.‡Bringt ein Bündel Akirisschilfrohr zu Freibeuter Groy nach Theramore.‡테라모어 섬에 있는 선원 그로이에게 아키리스 갈대 한 묶음을 가져가야 합니다.‡Lleva un fardo de cañas akiris al corsario Groy, en Theramore.‡Lleva un fajo de juncos akiris al corsario Groy, en Theramore.‡Apportez un Fagot de roseaux akiris au corsaire Groy à Theramore.‡给塞拉摩的海盗格罗伊带去一束海蛇草。‡給塞拉摩的私掠者格羅伊帶去一束海蛇草。',
  }
},
[624] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道謎題!',
  }
},
[625] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道謎題!',
  }
},
[626] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道謎題!',
  }
},
[627] = {
  {
    'Um favor para Krazek‡Просьба Кразека‡Gefallen für Krazek‡크라젝의 부탁‡Un favor a Krazek‡Un favor a Krazek‡Un service pour Krazek‡克拉兹克的要求‡克拉茲克的要求',
    nil,
    'Leve 4 cargas de Minério de Pedra-sangrenta Inferior para Krazek, na Angra do Butim.‡Принесите 4 партии бедной кровавой руды Кразеку в Пиратскую Бухту.‡Bringt 4 Ladungen geringes Blutsteinerz zu Krazek nach Beutebucht.‡무법항에 있는 크라젝에게 하급 혈석 광물 4개를 가져가야 합니다.‡Lleva 4 fajos de mena de sangrita inferior a Krazek en la Bahía del Botín.‡Lleva 4 fajos de mena de sangrita inferior a Krazek en la Bahía del Botín.‡Apporter 4 chargements de Minerai de pierre de sang inférieur à Krazek à Baie-du-Butin.‡给藏宝海岸的克拉兹克带去4块次级血石矿。‡給藏寶海岸的克拉茲克帶去4塊次級血石礦。',
  }
},
[628] = {
  {
    'Excelsior‡Эксельзиор‡Exzelsior‡엑셀시어‡Borceguí‡Borceguí‡L\'Excelsior de chez Drizzlik‡刨花皮靴‡刨花皮靴',
    nil,
    'Traga uma Pele de Crocolisco Ancião para Drizzlik, na Angra do Butim.‡Принесите Дриззлику из Пиратской Бухты шкуру старого солоноводного кроколиска.‡Bringt die Haut eines alten Krokilisken zu Drizzlik nach Beutebucht.‡무법항에 있는 드리즐릭에게 덩치 큰 악어 껍질을 가져가야 합니다.‡Lleva una piel de crocolisco viejo a Drizzlik en la Bahía del Botín.‡Lleva una piel de crocolisco mayor a Drizzlik en la Bahía del Botín.‡Apporter une Peau d\'ancien crocilisque à Drizzlik, à Baie-du-Butin.‡给藏宝海湾的崔斯里克带回1张老鳄鱼的皮。‡帶1張老海鱷的皮給藏寶海灣的崔斯里克。',
  }
},
[629] = {
  {
    'O Arrecife Torpe‡Коварный риф‡Das Finstere Riff‡썩은내 산호초‡El Arrecife Mortal‡El Arrecife Mortal‡Le récif infâme‡暗礁海‡暗礁海',
    nil,
    'Leve um Estilhaço de Tabuleta para Kin\'weelay, no Acampamento Grom\'gol.‡Принесите осколок таблички Кин\'вилаю в лагерь Гром\'гол.‡Bringt 1 Schrifttafelsplitter zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 서판 조각을 가져가야 합니다.‡Lleva un fragmento de tablilla a Kin\'weelay en el Campamento Grom\'gol.‡Lleva un fragmento de tablilla a Kin\'weelay en el Campamento Grom\'gol.‡Apporter un Fragment de tablette à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地里的肯维雷带回一块石板碎片。‡給格羅姆高營地裡的肯維雷帶回一塊石板裂片。',
  }
},
[630] = {
  {
    '‡Послание в бутылке‡Flaschenpost‡쪽지가 든 병‡Mensaje en una botella‡Mensaje en una botella‡Message dans une bouteille‡瓶中信‡瓶中信',
    nil,
    '‡Убейте Короля Муклу, возвращайтесь с ключом к принцессе Пубе и освободите ее.‡Erschlagt König Mukla und kehrt mit dem Schlüssel zu Prinzessin Poobah zurück, um sie zu befreien.‡‡Mata al rey Mukla y vuelve a por la princesa Poobah con la llave para liberarla.‡Mata al rey Mukla y vuelve a por la princesa Poobah con la llave para liberarla.‡Tuez le roi Mukla, et revenez auprès de la princesse Poobah avec la clé afin de la libérer.‡杀死穆克拉并带着钥匙回去救出普巴尔公主。‡',
  }
},
[631] = {
  {
    'Ponte Thandol‡Мост Тандола‡Der Thandolübergang‡탄돌 교각‡El Puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Rhag Garmason quer que você encontre o velho Ferratranca.‡Найдите Ржавого Засова для Рага Гармасона.‡Rhag Garmason will, dass Ihr den alten Rostlocke findet.‡라그 가마슨이 러스트로크를 찾아 달라고 했습니다.‡Rhag Garmason quiere que localices a Herrumbra.‡Rhag Garmason quiere que localices a Herrumbra.‡Rhag Garmaçon veut que vous retrouviez le vieux Bouclerouille.‡拉格·加玛森要求你找到老伊本瑟。‡拉格·加瑪森要求你找到老伊本瑟。',
  }
},
[632] = {
  {
    'Ponte Thandol‡Мост Тандола‡Der Thandolübergang‡탄돌 교각‡El Puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Report back to Rhag Garmason at Dun Modir in Wetlands and show him the parchment you found on Rustlocke\'s corpse.‡Принесите печальное известие Рагу Гармасону в Дун Модр в Болотину и отдайте ему пергамент, найденный возле трупа Ржавого Засова.‡Meldet Euch bei Rhag Garmason in Dun Modr im Sumpfland zurück und zeigt ihm das Pergament, das Ihr bei Rostlockes Leichnam gefunden habt.‡저습지의 던 모르드에 있는 라그 가마슨에게 돌아가서 러스트로크의 시체에서 발견한 양피지 문서를 보여 줘야 합니다.‡Vuelve a informar a Rhag Garmason en Dun Modr, en Los Humedales, y enséñale el papiro que encontraste en el cadáver de Herrumbra.‡Vuelve a informar a Rhag Garmason en Dun Modr, en Los Humedales, y enséñale el papiro que encontraste en el cadáver de Herrumbra.‡Présentez-vous à Rhag Garmaçon à Dun Modir, dans les Paluns et montrez-lui le parchemin que vous avez trouvé sur le corps de Bouclerouille.‡向湿地中丹莫德的拉格·加玛森回报，并将你在伊本瑟尸体上找到的羊皮纸交给他看看。‡到溼地的丹莫德向拉格·加瑪森回報，並將你在伊本瑟屍體上找到的羊皮紙交給他看看。',
  }
},
[633] = {
  {
    'Ponte Thandol‡Мост Тандола‡Der Thandolübergang‡탄돌 교각‡El Puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Destrua a Caixa de Explosivos.‡Уничтожьте взрывчатку.‡Zerstört den Sprengstoffbehälter.‡탄돌 교각 건너편에 있는 폭발물을 찾아서 파괴해야 합니다.‡Destruye el cajón de explosivos.‡Destruye el cajón de explosivos.‡Détruire la cache d\'explosifs.‡摧毁堆积的炸药。‡摧毀堆積的爆裂物。',
  }
},
[634] = {
  {
    'Súplica à Aliança‡Просьба о помощи‡Hilfegesuch an die Allianz‡얼라이언스에 지원 요청‡Petición a la Alianza‡Petición a la Alianza‡L\'appel à l\'Alliance‡请求援助‡向聯盟求援',
    nil,
    'Seek out Captain Nials at Refuge Pointe in Arathi Highlands.‡Найдите капитана Ниалс в Опорном пункте на Нагорье Арати.‡Macht Hauptmann Nials bei der Zuflucht im Arathihochland ausfindig.‡아라시 고원의 임시 주둔지에 있는 부대장 나이얼스를 찾아야 합니다.‡Busca a la capitana Nials en el Refugio de la Zaga, en las Tierras Altas de Arathi.‡Busca a la capitana Nials en el Refugio de la Zaga, en las Tierras Altas de Arathi.‡Chercher le capitaine Nials au Refuge de l\'Ornière, dans les Hautes-terres Arathies.‡去阿拉希高地避难谷地找到尼艾丝队长。‡到阿拉希高地的避難谷地找尋尼艾絲隊長。',
  }
},
[635] = {
  {
    'Um cristal nas montanhas‡Горный кристалл‡Kristall in den Bergen‡산 속의 수정‡Cristal en las montañas‡Cristal en las montañas‡Le cristal dans les montagnes‡山中的水晶‡山中的水晶',
    nil,
    'Encontre o cristal da sua visão.‡Найдите кристалл из видения.‡Findet den Kristall aus Eurer Vision.‡환영에서 보았던 수정을 찾아야 합니다.‡Encuentra el cristal de tu visión.‡Encuentra el cristal de tu visión.‡Trouver le cristal de votre vision.‡找到你在幻觉中看到的那块水晶。‡找到你在幻象中看到的那塊水晶。',
  }
},
[636] = {
  {
    '‡Легенды Земли <NYI>‡Legenden der Erde <NYI>‡대지의 전설‡Leyendas de la tierra <NYI>‡Leyendas de la tierra <NYI>‡Légendes de la terre <NYI>‡大地公主的传说‡',
    nil,
    '‡Найдите кристаллы Мизраэль.‡Findet die Splitter von Myzrael.‡‡Encuentra los Fragmentos de Myzrael.‡Encuentra los Fragmentos de Myzrael.‡Trouver les Éclats de Myzrael.‡找到密斯莱尔水晶碎块。‡',
  }
},
[637] = {
  {
    'Carta de Sully Balof‡Письмо Салли Баллу‡Sully Balloos Brief‡설리 발루의 편지‡La carta de Sully Balloo‡La carta de Sully Balloo‡Lettre de Sully Balloo‡苏利·巴鲁的信‡蘇利·巴魯的信',
    nil,
    'Entregue a Carta de Sully Balof a Sara Balof.‡Отнесите письмо Салли Балу Саре Балу.‡Bringt Sully Balloos Brief zu Sara Balloo.‡설리 발루의 편지를 사라 발루에게 전해야 합니다.‡Entrégale la carta de Sully Balloo a Sara Balloo.‡Entrégale la carta de Sully Balloo a Sara Balloo.‡Donner la Lettre de Sully Balloo à Sara Balloo.‡把苏利·巴鲁的信交给铁炉堡的萨拉·巴鲁。‡把蘇利·巴魯的信交給鐵爐堡的薩拉·巴魯。',
  }
},
[638] = {
  {
    'Matatroll‡Троллебой‡Trollbann‡트롤베인‡Aterratrols‡Aterratrols‡Trollemort‡巨魔之敌‡食人妖之敵',
    nil,
    'Viaje até Ruína do Martelo, no Planalto Arathi, e fale com Zengu.‡Отправляйтесь в Павший Молот и поговорите с Зенгу.‡Reist nach Hammerfall im Arathihochland und sprecht mit Zengu.‡아라시 고원의 망치 주둔지로 가서 젠구와 대화해야 합니다.‡Viaja a Sentencia en las Tierras Altas de Arathi y habla con Zengu.‡Viaja a Sentencia en las Tierras Altas de Arathi y habla con Zengu.‡Aller au Trépas-d\'Orgrim dans les hautes-terres Arathies et parler à Zengu.‡前往阿拉希高地的落锤镇，与森谷谈一谈。‡前往阿拉希高地的落錘鎮，與森谷談話。',
  }
},
[639] = {
  {
    'Signo de Strom‡Печать Cтрома‡Siegelzeichen von Strom‡스트롬의 인장‡El sigilo de Strom‡El sigilo de Strom‡Le cachet de Strom‡激流堡符印‡激流堡符印',
    nil,
    'Obtenha o Signo de Strom para Zengu, em Ruína do Martelo.‡Добудьте печать Строма для Зенгу в Павшем Молоте.‡Holt das Siegelzeichen von Strom für Zengu in Hammerfall.‡망치 주둔지에 있는 젠구에게 스트롬의 인장을 가져가야 합니다.‡Consigue el sigilo de Strom para Zengu en Sentencia.‡Consigue el sigilo de Strom para Zengu en Sentencia.‡Trouver le Cachet de Strom pour Zengu au Trépas-d\'Orgrim.‡帮落锤村的森古拿回激流堡符印。‡幫落錘村的森古拿回激流堡符印。',
  }
},
[640] = {
  {
    'O signo partido‡Сломанная печать‡Das zerbrochene Siegel‡깨진 인장‡El sigilo roto‡El sigilo roto‡Le cachet qui fut brisé‡破碎的符印‡破碎的符印',
    nil,
    'Recupere os 5 Fragmentos de Signo dos defensores de Stromgarde e leve para Tor\'gan, em Ruína do Martelo.‡Добудьте у защитников Стромгарда 5 фрагментов печати, принесите их Тор\'гану в Павший Молот.‡Holt die 5 Siegelfragmente von den Verteidigern in Stromgarde und bringt sie zu Tor\'gan in Hammerfall.‡스트롬가드의 수호병들에게서 인장 조각 5개를 빼앗아 망치 주둔지에 있는 토건에게 가져가야 합니다.‡Recupera los 5 trozos de sigilo de los defensores de Stromgarde y llévaselos a Tor\'gan en Sentencia.‡Recupera los 5 trozos de sigilo de los defensores de Stromgarde y llévaselos a Tor\'gan en Sentencia.‡Reprendre les 5 Fragments de cachet aux défenseurs de Stromgarde, puis les apporter à Tor\'gan au Trépas-d\'Orgrim.‡从激流堡的守卫者那里取回5块符印碎片，把它们交给落锤村的托尔甘。‡從激流堡的防衛者那裡取回5塊符印碎片，把它們交給落錘村的托爾甘。',
  }
},
[641] = {
  {
    '‡Печать Торадина‡Siegelzeichen des Thoradin‡소라딘의 인장‡Sigilo de Thoradin‡Sigilo de Thoradin‡Cachet de Thoradin‡索拉丁符印‡索拉丁符印',
    nil,
    '‡Принесите восстановленную печать Торадина Зенгу в Павший Молот.‡Bringt das wiederhergestellte Siegelzeichen von Thoradin zu Zengu in Hammerfall.‡‡Llévale el sigilo de Thoradin restaurado a Zengu en Sentencia.‡Llévale el sigilo de Thoradin restaurado a Zengu en Sentencia.‡Apportez le Cachet de Thoradin reconstitué à Zengu, au Trépas-d\'Orgrim.‡把修复的索拉丁符印交给落锤村的森古。‡',
  }
},
[642] = {
  {
    'A princesa aprisionada‡Плененная принцесса‡Die gefangene Prinzessin‡함정에 빠진 공주‡La princesa encerrada‡La princesa encerrada‡La princesse emprisonnée‡被困的公主‡受困的公主',
    nil,
    'Colete 12 Grânulos of Myzrael, depois leve-os até os Fragmentos Iridescentes, em Garganta Seca.‡Соберите 12 крупиц мощи Мизраэль и принесите их к радужным осколкам в Теснине Сухоусов.‡Sammelt 12 Körner von Myzrael und bringt sie zu den regenbogenfarbenen Splittern in der Schlucht der Trockenstoppel.‡미즈라엘의 결정 파편을 12개 모아서 마른수염 골짜기에 있는 오색 결정에 가져가야 합니다.‡Recolecta 12 motas de Myzrael y llévalas a los fragmentos iridiscentes en el Cañón Mostacho Seco.‡Recolecta 12 motas de Myzrael y llévalas a los fragmentos iridiscentes en el Cañón Mostacho Seco.‡Collecter 12 Poussières de Myzrael, puis les répandre sur les Éclats iridescents, dans la gorge des Sèches-moustaches.‡收集密斯莱尔之尘。|n|n把它们放在枯须峡谷中的虹光水晶碎块上。‡收集密斯賴爾之塵。|n|n把它們放在枯鬚峽谷中的虹光水晶裂片上。',
  }
},
[643] = {
  {
    'Signo de Arathor‡Печать Аратора‡Siegelzeichen von Arathor‡아라소르의 인장‡El sigilo de Arathor‡El sigilo de Arathor‡Le cachet d\'Arathor‡阿拉索符印‡阿拉索符印',
    nil,
    'Recupere o Signo de Arathor e leve de volta a Zengu, em Ruína do Martelo.‡Добудьте печать Аратора и принесите ее Зенгу в Павший Молот.‡Holt das Siegelzeichen von Arathor und bringt es Zengu in Hammerfall.‡아라소르의 인장을 찾은 후 망치 주둔지에 있는 젠구에게 가져가야 합니다.‡Recupera el sigilo de Arathor y llévaselo a Zengu en Sentencia.‡Recupera el sigilo de Arathor y llévaselo a Zengu en Sentencia.‡Retrouver le Cachet d\'Arathor et l\'apporter à Zengu, au Trépas-d\'Ogrim.‡取回阿拉索符印，把它交给落锤村的森古。‡取回阿拉索符印，把它交給落錘村的森古。',
  }
},
[644] = {
  {
    'Signo de Matatroll‡Печать Троллебоя‡Siegelzeichen von Trollbann‡트롤베인의 인장‡El sigilo de Aterratrols‡El sigilo de Aterratrols‡Le cachet de Trollemort‡托尔贝恩符印‡托爾貝恩符印',
    nil,
    'Mate o Príncipe Galen Matatroll e leve o Signo de Matatroll para Zengu, na Ruína do Martelo.‡Убейте принца Галена Троллебоя и принесите печать Троллебоя Зенгу в Павший Молот.‡Tötet Prinz Galen Trollbann und bringt das Siegelzeichen von Trollbann zu Zengu in Hammerfall.‡왕자 갈렌 트롤베인을 처치하고 망치 주둔지에 있는 젠구에게 트롤베인의 인장을 가져가야 합니다.‡Mata al príncipe Galen Aterratrols y llévale el sigilo de Aterratrols a Zengu en Sentencia.‡Mata al príncipe Galen Aterratrols y llévale el sigilo de Aterratrols a Zengu en Sentencia.‡Tuez le Prince Galen Trollemort et apportez le Cachet de Trollemort à Zengu, au Trépas-d\'Ogrim.‡杀掉加林·托尔贝恩王子，把托尔贝恩符印带给落锤村的森古。‡殺掉加林·托爾貝恩王子，把托爾貝恩符印帶給落錘村的森古。',
  }
},
[645] = {
  {
    'Trol\'kalar‡Трол\'калар‡Trol\'kalar‡트롤칼라‡Trol\'kalar‡Trol\'kalar‡Trol\'kalar‡托卡拉尔‡托卡拉爾',
    nil,
    'Recupere Trol\'kalar de dentro da tumba de Matatroll, em Stromgarde.‡Достаньте Трол\'калар из могилы Троллебоя в Стромгарде.‡Holt Trol\'kalar aus Trollbanns Grabmal in Stromgarde.‡스트롬가드에 있는 트롤베인의 무덤에서 트롤칼라를 회수해야 합니다.‡Recupera la espada Trol\'kalar de la Tumba de Aterratrols en Stromgarde.‡Recupera la espada Trol\'kalar de la Tumba de Aterratrols en Stromgarde.‡Retirer Trol\'kalar de la tombe de Trollemort à Stromgarde.‡从激流堡的托尔贝恩墓室中取回托卡拉尔剑。‡從激流堡的托爾貝恩墓室中取回托卡拉爾劍。',
  }
},
[646] = {
  {
    'Trol\'kalar‡Трол\'калар‡Trol\'kalar‡트롤칼라‡Trol\'kalar‡Trol\'kalar‡Trol\'kalar‡托卡拉尔‡托卡拉爾',
    nil,
    'Leve Trol\'kalar para Zengu, na Ruína do Martelo.‡Отнесите меч Трол\'калар Зенгу в Павший Молот.‡Bringt Trol\'kalar zu Zengu nach Hammerfall.‡망치 주둔지에 있는 젠구에게 트롤칼라를 가져가야 합니다.‡Entrega Trol\'kalar a Zengu en Sentencia.‡Entrega Trol\'kalar a Zengu en Sentencia.‡Apporter Trol\'kalar à Zengu au Trépas-d\'Orgrim.‡把托卡拉尔剑交给落锤村的森古。‡把托卡拉爾劍交給落錘村的森古。',
  }
},
[647] = {
  {
    'Pinga de Mackreel‡Самогон Маккрила‡MacKreels Fusel‡맥크릴의 밀주‡Licor de luna de Mackreel‡Licor de luna de Mackreel‡Le tord-boyaux de MacKreel‡马克里尔的月光酒‡麥克里爾的月光酒',
    nil,
    'Leve a Pinga de Mackreel para o Mestre-cervejeiro Podrágua na Costa Sul.‡Отнесите самогон Маккрила мастеру-пивовару Бочкопузу в Южнобережье.‡Bringt MacKreels Fusel zu Braumeister Bilger nach Süderstade.‡남녘해안에 있는 양조업자 빌저에게 맥크릴의 밀주를 가져가야 합니다.‡Llévale el licor de luna de MacKreel al maestro cervecero Bilger de Costasur.‡Llévale el licor de luna de MacKreel al maestro cervecero Bilger de Costasur.‡Apporter le Tord-boyaux de MacKreel au brasseur Sentine à Austrivage.‡把马克里尔的月光酒交给南海镇的布鲁米·比格尔。‡把麥克里爾的月光酒交給南海鎮的布魯米·比格爾。',
  }
},
[648] = {
  {
    'Resgate OOX-17/TN!‡Спасти КПХ-17/TN!‡Rettet OOX-17/TN!‡OOX-17/TN 구출‡¡Rescatar a OOX-17/TN!‡¡Rescatar a OOX-17/TN!‡À la rescousse de OOX-17/TN !‡拯救OOX-17/TN！‡拯救OOX-17/TN!',
    nil,
    'Escolte o OOX-17/TN e apresente-se ao Olhatorto Obnótico na Angra do Butim.‡Сопроводите КПХ-17/TN в безопасное место, затем сообщите об этом Карлсу Пропеллерзу в Пиратской Бухте.‡Bringt OOX-17/TN in Sicherheit und meldet Euch dann bei Glotz Widrikus in Beutebucht.‡OOX-17/TN을 안전하게 호위하고 나서 무법항에 있는 오글소프 오브노티쿠스에게 가서 보고해야 합니다.‡Escolta a OOX-17/TN para que llegue sano y salvo y después preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escolta a OOX-17/TN para que llegue sano y salvo y después preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escortez OOX-17/TN jusqu\'à ce qu\'il soit en sécurité, puis rendez compte à Orguignard Odipnoticus à Baie-du-Butin.‡安全护送OOX-17/TN到达目的地，然后向藏宝海湾的奥格索普·奥布诺提斯报告。‡護送OOX-17/TN到安全地點，然後向藏寶海灣的奧格索普·奧布諾提斯回報。',
  }
},
[649] = {
  {
    '‡За медовухой‡Weinbergung‡리플 회수‡Recupera el calimocho‡Recupera el calimocho‡La récupération de Houle‡寻找蜜酒‡',
    nil,
    '‡Поговорите с Мальтоном Дрофферсом в Оргриммаре.‡Sprecht mit Malton Droffers in Orgrimmar.‡오그리마에 있는 말톤 드로퍼스와 대화해야 합니다.‡Habla con Malton Droffers en Orgrimmar.‡Habla con Malton Droffers en Orgrimmar.‡Parler à Malton Droffers à Orgrimmar.‡和奥格瑞玛的玛尔顿·杜佛斯谈一谈。‡',
  }
},
[650] = {
  {
    'Recuperando suco gami‡За медовухой‡Bergung der Welle‡리플 회수‡Recupera el calimocho‡Recupera el calimocho‡La récupération de Houle‡寻找蜜酒‡尋找蜜酒',
    nil,
    'Fale com Gilveradin Buscassol. O acampamento dele fica nas Terras Agrestes.‡Поговорите с Гилверадином Ловчим Солнца во Внутренних землях.‡Sprecht mit Gilveradin Sonnenjäger; sein Lager befindet sich im Hinterland.‡동부 내륙지의 야영지에 있는 길버라딘 선체이서와 대화해야 합니다.‡Habla con Gilveradin Cazasol; su campamento está en las Tierras del Interior.‡Habla con Gilveradin Cazasol; su campamento está en las Tierras del Interior.‡Parler à Gilveradin Courresoleil. Son camp se situe dans les Hinterlands.‡和基沃拉丁·猎日者谈一谈，他的营地就在辛特兰区域。‡和基沃拉丁·追日者談一談，他的營地就在辛特蘭區域。',
  }
},
[651] = {
  {
    'Pedras de união‡Связывающие камни‡Steine der Bindung‡마법진의 돌‡Piedras de Vínculo‡Piedras de Vínculo‡Les pierres de lien‡禁锢之石‡禁錮之石',
    nil,
    'Consiga a Chave Ardente, a Chave Troante e a Chave Trovejante nas Pedras da União Ocidental, da União Oriental e de União Exterior.|n|nLeve-as até a Pedra da União Interna.‡Добудьте огненный ключ, резной ключ и громовой ключ с западного связывающего камня, восточного связывающего камня и внешнего связывающего камня.|n|nОтнесите ключи к внутреннему связывающему камню.‡Holt den brennenden Schlüssel, den Wappenschlüssel und den donnernden Schlüssel vom Stein der westlichen Bindung, dem Stein der östlichen Bindung und dem Stein der äußeren Bindung.|n|nBringt sie zum Stein der inneren Bindung.‡서부 봉인석, 동부 봉인석, 외부 봉인석에서 각각 불타는 열쇠, 용마루장식 열쇠, 천둥 열쇠를 구해야 합니다.|n|n세 개의 열쇠를 내부 봉인석으로 가져가야 합니다.‡Reúne la llave ardiente, la llave blasonada y la llave del trueno de la Piedra de Vínculo Occidental, la Piedra de Vínculo Este y la Piedra de Vínculo Exterior.|n|nLlévalas a la Piedra de Vínculo Interior.‡Reúne la llave ardiente, la llave blasonada y la llave del trueno de la Piedra de Vínculo Occidental, la Piedra de Vínculo Este y la Piedra de Vínculo Exterior.|n|nLlévalas a la Piedra de Vínculo Interior.‡Collecter la Clé ardente, la Clé armoriée et la Clé de tonnerre aux lieux suivants : la Pierre de lien occidentale, la Pierre de lien orientale et la Pierre de lien extérieure.|n|nLes apporter à la Pierre de lien intérieure.‡从西禁锢之石、东禁锢之石和外禁锢之石中搜集烈焰钥匙、海浪钥匙和雷霆钥匙。|n|n把它们带到内禁锢之石处。‡從西禁錮之石、東禁錮之石和外禁錮之石中搜集烈焰鑰匙、海浪鑰匙和雷霆鑰匙。|n|n把它們帶到內禁錮之石處。',
  }
},
[652] = {
  {
    'Quebrando a pedra-chave‡Разбить краеугольный камень‡Den Hauptstein zerbrechen‡쐐기돌 깨기‡Desbloquear la piedra angular‡Desbloquear la piedra angular‡La Pierre cruciale‡打开钥匙之石‡打開鑰匙之石',
    nil,
    'Encontre e mate Fozruk. Leve o Bastão de Ordem para a Pedra-chave, no Planalto Arathi.‡Найдите и убейте Фозрука. Принесите Жезл Порядка к краеугольному камню на Нагорье Арати.‡Findet und tötet Fozruk. Bringt die Rute der Ordnung zum Hauptstein im Arathihochland.‡포즈루크를 찾아 처치해야 합니다. 아라시 고원에 있는 쐐기돌에 질서의 마법봉을 가져가야 합니다.‡Encuentra a Fozruk y mátalo. Lleva la vara del Orden a la piedra angular en las Tierras Altas de Arathi.‡Encuentra a Fozruk y mátalo. Lleva la vara del Orden a la piedra angular en las Tierras Altas de Arathi.‡Trouver et tuer Fozruk. Apporter le Bâtonnet de l\'ordre à la Pierre cruciale dans les hautes-terres Arathies.‡找到并杀死弗兹鲁克，然后把秩序魔棒带到阿拉希高地的钥匙之石旁。‡找到並殺死弗茲魯克，然後把秩序魔棒帶到阿拉希高地的鑰匙之石旁。',
  }
},
[653] = {
  {
    '‡Союзники Мизраэль‡Myzraels Verbündete‡‡Aliados de Myzrael‡Aliados de Myzrael‡Les alliés de Myzrael‡密斯莱尔的盟友‡',
    nil,
    '‡Поговорите с Герриком Костохватом в Заброшенном гроте в Стальгорне.‡Sprecht mit Gerrig Knochengriff im Düsteren Viertel von Eisenschmiede.‡‡Habla con Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Habla con Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Parler à Gerrig Poigne-d\'os, dans la Caverne Lugubre de Forgefer.‡和铁炉堡的葛利·硬骨谈一谈。‡',
  }
},
[654] = {
  {
    '‡Полевые испытания в Танарисе‡Tanaris-Feldproben‡‡Recogida de muestras en Tanaris‡Recogida de muestras en Tanaris‡Les échantillons du désert de Tanaris‡塔纳利斯的样本‡',
    nil,
    '‡Добудьте приемлемые образцы тканей 8 василисков, 8 гиен и 8 скорпионов. Отнесите набор для проведения испытаний главному инженеру Чепухастеру в Прибамбасск до окончания действия источника энергии.‡Sammelt ungetestete Proben von 8 Basilisken, 8 Hyänen und 8 Skorpionen. Bringt das Testset zurück nach Gadgetzan zu Chefingenieur Bilgenritzel, bevor die Kraftquelle erschöpft ist.‡‡Consigue muestras no estudiadas de 8 basiliscos, 8 hienas y 8 escorpiones. Devuélvele el equipo de estudio al ingeniero jefe Pasaquillas, en Gadgetzan, antes de que se agote la fuente de energía.‡Consigue muestras no estudiadas de 8 basiliscos, 8 hienas y 8 escorpiones. Devuélvele el equipo de estudio al ingeniero jefe Pasaquillas, en Gadgetzan, antes de que se agote la fuente de energía.‡Acquérir des Echantillons non testés de 8 basilics, 8 hyènes et 8 scorpions. Rapporter la Trousse d\'analyse de terrain à l\'Ingénieur en chef Vizisanie à Gadgetzan avant que la source d\'énergie ne s\'épuise.‡收集8份蜥蜴样本、8份土狼样本和8份蝎子样本，然后在能量源耗尽之前把野外实验工具包还给加基森的首席工程师比格维兹。‡',
  }
},
[655] = {
  {
    '‡Павший Молот‡‡망치 주둔지‡Sentencia‡Sentencia‡Trépas-d\'Orgrim‡落锤镇‡落錘鎮',
    nil,
    '‡Поговорите с Тор\'ганом в Павшем Молоте.‡Sprecht mit Tor\'gan in Hammerfall.‡‡Habla con Tor\'gan en Sentencia.‡Habla con Tor\'gan en Sentencia.‡Parler à Tor\'gan au Trépas-d\'Orgrim.‡和落锤村的托尔甘交谈。‡',
  }
},
[656] = {
  {
    'Evocação da Princesa‡Призыв принцессы‡Beschwören der Prinzessin‡공주 소환‡Invocar a la princesa‡Invocar a la princesa‡L\'invocation de la Princesse‡召唤大地公主‡召喚大地公主',
    nil,
    'Vá até os Estilhaços de Myzrael, evoque-a e derrote-a.|n|nColete os Grilhões Sobrenaturais e vincule aos Estilhaços de Myzrael.‡Отправляйтесь к кристаллам Мизраэль, призовите принцессу и победите ее.|n|nЗаберите ее мистические оковы и присоедините их к кристаллам.‡Geht zu den Splittern von Myzrael, beschwört und besiegt sie.|n|nSammelt ihre geisterhaften Fesseln, und bindet diese an die Splitter von Myzrael.‡미즈라엘의 결정으로 가서 그녀를 소환한 후에 처치해야 합니다.|n|n기괴한 족쇄를 주워서 다시 미즈라엘의 결정에 봉인해야 합니다.‡Ve a los fragmentos de Myzrael, invócala y derrótala.|n|nRecolecta sus grilletes de Eldritch y pónselos a los fragmentos de Myzrael.‡Ve a los fragmentos de Myzrael, invócala y derrótala.|n|nRecolecta sus grilletes de Eldritch y pónselos a los fragmentos de Myzrael.‡Aller aux Éclats de Myzrael, l\'invoquer et la battre.|n|nPrendre ses Chaînes indicibles et les attacher aux Éclats de Myzrael.‡到密斯莱尔水晶碎块去召唤她，然后打败她。|n|n搜出她身上的怪异镣铐，将其和密斯莱尔水晶碎块缚在一起。‡到密斯賴爾水晶裂片去召喚她，然後打敗她。|n|n搜出她身上的怪異鐐銬，將其和密斯賴爾水晶裂片縛在一起。',
  }
},
[657] = {
  {
    '‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡',
    nil,
    '‡Поговорите с Кинелори на Ферме Го\'Шека, что на нагорье Арати.‡Sprecht mit Kinelory in der Nähe von Go\'Sheks Hof im Arathihochland.‡‡Habla con Kinelory cerca de la Granja Go\'shek, en las Tierras Altas de Arathi.‡Habla con Kinelory cerca de la Granja Go\'shek, en las Tierras Altas de Arathi.‡Parler à Kinelory près de la Ferme de Go\'Shek, dans les Hautes-terres Arathies.‡和阿拉希高地中格沙克农场附近的基恩洛谈一谈。‡',
  }
},
[658] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫?',
    nil,
    'Encontre a Mensageira Renegada e leve a Pasta Lacrada dela para Quae nas redondezas da Fazenda Go\'Shek.‡Найдите Отрекшегося-курьера и принесите обнаруженную у него запечатанную папку Кви близ фермы Го\'Шека.‡Findet den Kurier der Verlassenen und bringt den versiegelten Ordner zu Quae in der Nähe von Go\'Sheks Hof.‡포세이큰 급사를 찾아서 봉인된 서류를 고셰크 농장 근처에 있는 쿠에에게 가져가야 합니다.‡Encuentra a la mensajera Renegada y lleva su carpeta sellada a Quae cerca de la Granja Go\'shek.‡Encuentra a la mensajera Renegada y lleva su carpeta sellada a Quae cerca de la Granja Go\'shek.‡Trouver la Messagère des Réprouvés et ramener ses documents scellés à Quae près de la Ferme de Go\'shek.‡找到被遗忘者信使，把她的密封的信件交给格沙克农场里的奎艾。‡找到被遺忘者信差，把她的密封的信件交給格沙克農場裡的奎艾。',
  }
},
[659] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫?',
    nil,
    'Encontre Quae e Kinelory nas redondezas da Fazenda Go\'Shek, no Planalto Arathi.‡Найдите Кви и Кинелори у фермы Го\'Шека на Нагорье Арати.‡Findet Quae und Kinelory in der Nähe von Go\'Sheks Hof im Arathihochland.‡아라시 고원에 있는 고셰크 농장 근처에서 쿠에와 키넬로리를 찾아야 합니다.‡Encuentra a Quae y a Kinelory cerca de la Granja Go\'shek en las Tierras Altas de Arathi.‡Encuentra a Quae y a Kinelory cerca de la Granja Go\'shek en las Tierras Altas de Arathi.‡Trouver Quae et Kinelory près de la Ferme de Go\'shek dans les hautes-terres Arathies.‡到阿拉希高地上的格沙克农场附近找到奎艾和基恩洛。‡到阿拉希高地上的格沙克農場附近找到奎艾和基恩洛。',
  }
},
[660] = {
  {
    '‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡',
    nil,
    '‡Защищайте Кинелори, пока она не вернется к Кви.‡Beschützt Kinelory, bis sie zu Quae zurückkehrt.‡쿠에에게 돌아갈 때까지 키넬로리를 보호해야 합니다.‡Protege a Kinelory hasta que haya regresado con Quae.‡Protege a Kinelory hasta que haya regresado con Quae.‡Protéger Kinelory jusqu\'à ce qu\'elle rejoigne Quae.‡保护基恩洛，直到她回到奎艾身边。‡',
  }
},
[661] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫?',
    nil,
    'Find Phin Odelic at Southshore in Hillsbrad Foothills.‡Найдите Фина Оделика в Южнобережье, что в Предгорье Хилсбрада.‡Findet Phin Odelic in Süderstade im Vorgebirge des Hügellands.‡언덕마루 구릉지의 남녘해안에 있는 핀 오델릭을 찾아야 합니다.‡Encuentra a Phin Odelic en Costasur, en las Laderas de Trabalomas.‡Encuentra a Phin Odelic en Costasur, en las Laderas de Trabalomas.‡Retrouver Phin Odelic à Austrivage, aux Contreforts de Hautebrande.‡到希尔斯布莱德丘陵的南海镇去找到费恩·奥德利克。‡到希爾斯布萊德丘陵的南海鎮找費恩·奧德利克。',
  }
},
[662] = {
  {
    '‡Поиски на глубине‡Tiefsee-Bergung‡‡Rescate en alta mar‡Rescate en alta mar‡Sauvetage en haute mer‡深海打捞‡',
    nil,
    '‡Первый помощник Нилзликс хочет, чтобы вы достали карты и судовые журналы кораблей "Девичья Блажь" и "Дух Серебряного бора".‡Der erste Maat Nilzlix will, dass Ihr die Karten und Logbücher von der TOLLEN MINNA und der SILBERGEIST zurückholt.‡‡El contramaestre Nizlix quiere que recuperes los cuadernos de bitácora y las cartas de navegación de El Capricho y del Espíritu de argénteos.‡El contramaestre Nizlix quiere que recuperes los cuadernos de bitácora y las cartas de navegación de El Capricho y del Espíritu de argénteos.‡Le lieutenant Nilzlix veut que vous récupériez les Cartes et les Journaux de bord de la « Folie de la vierge » et de « L\'Esprit des Pins-Argentés ».‡大副尼兹利克斯让你从处女号和银松之魂号中取回航海图和航海日志。‡',
  }
},
[663] = {
  {
    '‡Эй, там!‡Land in Sicht!‡육지다!‡¡Tierra a vista!‡¡Tierra a vista!‡Terre !‡法迪尔海湾‡發現陸地!',
    nil,
    '‡Поговорите с капитаном О\'Брином в бухте Фальдира, что на нагорье Арати.‡Sprecht mit Kapitän O\'Breen in der Faldirbucht im Arathihochland.‡‡Habla con el capitán O\'Breen en la Cala de Faldir, en las Tierras Altas de Arathi.‡Habla con el capitán O\'Breen en la Cala de Faldir, en las Tierras Altas de Arathi.‡Parler au capitaine O\'Breen dans la Crique de Faldir, dans les Hautes-terres Arathies.‡和法迪尔海湾的奥布里船长交谈。‡',
  }
},
[664] = {
  {
    '‡Затонувшие печали‡Ertrunkene Trauer‡비통한 마음‡Ahogar las penas‡Ahogar las penas‡Chagrin noyé‡船长的复仇‡',
    nil,
    '‡Капитан Стальные Нервы из бухты Фальдира хочет, чтобы вы убили 10 налетчиков и 3 колдуний из клана Пронзающего Гребня.‡Kapitän Stahlmagen in der Faldirbucht will, dass Ihr 10 Räuber der Säbelflossen und 3 Zauberinnen der Säbelflossen tötet.‡팔디르의 만에 있는 선장 스틸구트가 비수가시 침략자 10마리와 비수가시 여마법사 3마리를 처치해 달라고 했습니다.‡El capitán Tripacero de Cala de Faldir quiere que mates a 10 asaltantes Espinadaga y a 3 hechiceras Espinadaga.‡El capitán Tripacero de Cala de Faldir quiere que mates a 10 asaltantes Espinadaga y a 3 hechiceras Espinadaga.‡Le capitaine Tripacier de la crique de Faldir veut que vous tuiez 10 Écumeurs daguéchines et 3 Sorcières daguéchines.‡法迪尔海湾的斯迪加特船长要你去杀掉10个刺脊袭击者和3个刺脊巫师。‡',
  }
},
[665] = {
  {
    '‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    '‡Проводите профессора Физзлторпа в пещеру и обратно.‡Begleitet Professor Prasseltrop zur Höhle und zurück.‡학자 피즐솔프가 동굴에 들어갔다 나올 수 있도록 호위해야 합니다.‡Escolta al profesor Fiseltor hasta la cueva y a su regreso.‡Escolta al profesor Fiseltor hasta la cueva y a su regreso.‡Escorter le professeur Phloppenthrope à la grotte et revenir.‡护送菲兹索普教授到洞穴里去并平安返回。‡',
  }
},
[666] = {
  {
    '‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    '‡Доктор Драксельмер в бухте Фальдира хочет, чтобы вы собрали 10 эльфийских самоцветов и вернули ему очки Ловца сокровищ, когда закончите.‡Doktor Drechselknacks in der Faldirbucht will, dass Ihr 10 Elfenedelsteine einsammelt und die Edelsteinjagdschutzbrille zurückgebt, sobald Ihr fertig seid.‡팔디르의 만에 있는 발명가 드랙슬게이지가 엘프의 보석 10개를 주워 오고 이 일을 끝낸 후 보물찾기 고글을 돌려 달라고 했습니다.‡El doctor Draxlegauge de la Cala de Faldir quiere que reúnas 10 gemas de elfo y le devuelvas las gafas de caza de gemas cuando hayas acabado.‡El doctor Draxlegauge de la Cala de Faldir quiere que reúnas 10 gemas de elfo y le devuelvas las gafas de caza de gemas cuando hayas acabado.‡Le docteur Draunessieu, à la crique de Faldir, veut que vous rapportiez 10 Gemmes elfiques et que vous rapportiez ensuite les Lunettes de chasse aux gemmes.‡法迪尔海湾的德拉克里格博士要你去收集10块精灵宝石并在完成任务后归还寻宝潜水镜。‡',
  }
},
[667] = {
  {
    '‡Смерть со дна морского‡Tod von unten‡나가의 공격‡Muerte desde abajo‡Muerte desde abajo‡La mort venue d\'en bas‡水下伏兵‡',
    nil,
    '‡Защитите Мураша О\'Брина во время атаки наг.‡Beschützt Wank O\'Breen während des Angriffs.‡나가의 공격으로부터 셰익스 오브린을 보호해야 합니다.‡Protege a Temblores O\'Breen durante el ataque.‡Protege a Temblores O\'Breen durante el ataque.‡Protéger Shakes O\'Breen lors de l\'attaque.‡在纳迦的攻击中保护沙克斯·奥布里。‡',
  }
},
[668] = {
  {
    '‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    '‡Отнесите эльфийские самоцветы капитану О\'Брину в бухту Фальдира, что на нагорье Арати.‡Bringt die Elfenedelsteine zu Kapitän O\'Breen in die Faldirbucht im Arathihochland.‡‡Llévale las gemas de elfo al capitán O\'Breen a la Cala de Faldir, en las Tierras Altas de Arathi.‡Llévale las gemas de elfo al capitán O\'Breen a la Cala de Faldir, en las Tierras Altas de Arathi.‡Apporter les Gemmes elfiques au Capitaine O\'Breen à la Crique de Faldir, dans les Hautes-terres Arathies.‡把精灵宝石交给奥布里船长。‡',
  }
},
[669] = {
  {
    'Tesouro submerso‡Затонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'Take the Sample Elven Gem to Fleet Master Seahorn at Booty Bay in Stranglethorn Vale.‡Доставьте образец эльфийского самоцвета командиру флота Морскому Рогу в Пиратскую Бухту, что в Тернистой долине.‡Bringt die Probe zu Flottenmeister Seehorn nach Beutebucht im Schlingendorntal.‡가시덤불 골짜기의 무법항에 있는 시혼 함장에게 엘프의 보석 표본을 가져가야 합니다.‡Llévale una muestra de gema de elfo al maestro de flota Cuernomarino a Bahía del Botín, en la Vega de Tuercespina.‡Llévale una muestra de gema de elfo al maestro de flota Cuernomarino a Bahía del Botín, en la Vega de Tuercespina.‡Prenez l\'Échantillon de gemme elfique et apportez-le à l’Amiral Corne-de-Mer à Baie-du-Butin, dans la Vallée de Strangleronce.‡把精灵宝石样本交给荆棘谷藏宝海湾的舰队指挥官卡拉·海角。‡前往荊棘谷，把精靈寶石樣本交給藏寶海灣的艦隊指揮官卡拉·海角。',
  }
},
[670] = {
  {
    'Tesouro submerso‡Затонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'Deliver Seahorn\'s Letter to Shakes O\'Breen at Faldir\'s Cove in Arathi Highlands.‡Отвезите письмо Морского Рога Мурашу О\'Брину в Бухту Фальдира, что на Нагорье Арати.‡Bringt Seehorns Brief zu Kapitän O\'Breen in die Faldirbucht im Arathihochland.‡아라시 고원의 팔디르의 만에 있는 셰익스 오브린에게 시혼의 봉인된 편지를 전달해야 합니다.‡Llévale la carta de Cuernomarino a Temblores O\'Breen a la Cala de Faldir, en las Tierras Altas de Arathi.‡Llévale la carta de Cuernomarino a Temblores O\'Breen a la Cala de Faldir, en las Tierras Altas de Arathi.‡Remettre la Lettre de Corne-de-mer à Shakes O\'Breen à la Crique de Faldir, dans les hautes-terres Arathies.‡把海角船长的密信送给阿拉希高地中法迪尔海湾的沙克斯·奥布里。‡到阿拉希高地的法迪爾海灣，把海角船長的密信送給沙克斯·奧布里。',
  }
},
[671] = {
  {
    'Magias torpes‡Зловещая магия‡Elende Magien‡사악한 마법‡Magia demoníaca‡Magia demoníaca‡Magies immondes‡邪恶的魔法‡邪惡的魔法',
    nil,
    'Obtenha 10 Amuletos de Pedra-sangrenta e entregue-os a Tor\'gan em Ruína do Martelo.‡Принесите Тор\'гану в Павший Молот 10 амулетов из кровавого камня.‡Holt 10 Blutsteinamulette für Tor\'gan in Hammerfall.‡망치 주둔지에 있는 토건을 위해 혈석 아뮬렛 10개를 모아야 합니다.‡Consigue 10 amuletos de sangrita para Tor\'gan en Sentencia.‡Consigue 10 amuletos de sangrita para Tor\'gan en Sentencia.‡Apporter 10 Amulettes de pierre de sang à Tor\'gan au Trépas-d\'Orgrim.‡帮落锤村的托尔甘找10枚血石护符。‡幫落錘村的托爾甘找10枚血石護符。',
  }
},
[672] = {
  {
    'Espíritos elevados‡Вызов духов‡Stimmungsaufheller‡되살아나는 영혼‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡振奮精神',
    nil,
    'Consiga 10 Olhos de Raptores do Planalto matando os Andarilhos do Planalto ou os Espancadores do Planalto e entregue a Tor\'gan em Ruína do Martelo.‡Соберите 10 глаз нагорных ящеров с нагорных долгоногов и твердозубов и принесите их Тор\'гану в Павший Молот.‡Bringt 10 Hochlandraptorenaugen von Hochlandschreitern und Hochlandhauern zu Tor\'gan in Hammerfall.‡줄무늬 고원랩터와 외뿔 고원랩터에게서 고원랩터 눈 10개를 모아 망치 주둔지에 있는 토건에게 가져가야 합니다.‡Consigue 10 ojos de raptor de las Tierras Altas de los zancudos y de los descarnadores de las Tierras Altas para Tor\'gan en Sentencia.‡Consigue 10 ojos de raptor de las Tierras Altas de los zancudos y de los descarnadores de las Tierras Altas para Tor\'gan en Sentencia.‡Récupérer 10 Yeux de raptors des hautes-terres sur les Arpenteurs des hautes-terres et les Vandales des hautes-terres pour Tor\'gan au Trépas-d\'Orgrim.‡从高地阔步龙和高地长尾龙身上取得10个高地迅猛龙的眼球，把它们交给落锤村的托尔甘。‡從高地闊步龍和高地長尾龍身上取得10個高地迅猛龍的眼睛，把它們交給落錘村的托爾甘。',
  }
},
[673] = {
  {
    'Magias torpes‡Зловещая магия‡Elende Magien‡사악한 마법‡Magia demoníaca‡Magia demoníaca‡Magies immondes‡邪恶的魔法‡邪惡的魔法',
    nil,
    'Obtenha a Pedra-sangrenta de Marez Capucho e entregue-a a Tor\'gan na Ruína do Martelo.‡Добудьте сферу кровавого камня у чернокнижницы Марез Клобук и принесите ее Тор\'гану в Павший Молот.‡Bergt Marez Schattenkuttes Blutsteinkugel und bringt sie zu Tor\'gan in Hammerfall.‡마레즈 코울의 더럽혀진 혈석 수정구를 빼앗아 망치 주둔지에 있는 토건에게 가져가야 합니다.‡Recupera el orbe de sangrita de Marez Cogulla y llévaselo a Tor\'gan en Sentencia.‡Recupera el orbe de sangrita de Marez Cogulla y llévaselo a Tor\'gan en Sentencia.‡Trouver l\'Orbe de pierre de sang de Marez Capuche et l\'apporter à Tor\'gan au Trépas-d\'Orgrim.‡取回玛雷兹·考尔的血石宝珠，把它交给落锤村的托尔甘。‡取回瑪雷茲·考爾的血石寶珠，把它交給落錘村的托爾甘。',
  }
},
[674] = {
  {
    'Espíritos elevados‡Вызов духов‡Mut machen‡되살아나는 영혼‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡振奮精神',
    nil,
    'Give the Raptor Talon Amulet to Gor\'mul at Hammerfall in Arathi Highlands.‡Отдайте амулет из когтя ящера Гор\'мулю. Его можно найти в Павшем Молоте, что на Нагорье Арати.‡Gebt das Raptorkrallenamulett an Gor\'mul in Hammerfall im Arathihochland.‡아라시 고원의 망치 주둔지에 있는 고르멀에게 랩터 발톱 아뮬렛을 전달해야 합니다.‡Dale el amuleto de garfa de raptor a Gor\'mul en Sentencia, en las Tierras Altas de Arathi.‡Dale el amuleto de garfa de raptor a Gor\'mul en Sentencia, en las Tierras Altas de Arathi.‡Donner l\'Amulette de griffe de raptor à Gor\'mul à Trépas-d\'Orgrim, dans les Hautes-terres Arathies.‡把迅猛龙利爪护符交给阿拉希高地落锤镇的戈穆尔。‡到阿拉希高地的落錘鎮，把迅猛龍利爪護符交給戈莫爾。',
  }
},
[675] = {
  {
    '‡Вызов духов‡Mut machen‡기운 북돋기‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡',
    nil,
    '‡Поговорите с Тор\'ганом в Павшем Молоте, что на нагорье Арати.‡Sprecht mit Tor\'gan in Hammerfall im Arathihochland.‡‡Habla con Tor\'gan en Sentencia, en las Tierras Altas de Arathi.‡Habla con Tor\'gan en Sentencia, en las Tierras Altas de Arathi.‡Parler à Tor\'gan au Trépas-d\'Orgrim, dans les Hautes-terres Arathies.‡和托尔甘谈一谈。‡',
  }
},
[676] = {
  {
    'O Martelo pode ruir‡Да падет молот‡Der Hammer kann fallen‡망치 주둔지 함락 위기‡La Sentencia‡La Sentencia‡Menace sur le Trépas-d\'Orgrim‡落锤之战‡落錘之戰',
    nil,
    'Mate 8 Ogros Punho de Pedra e 10 Impositores Punho de Pedra. Depois apresente-se a Drum Fel no posto avançado Ruína do Martelo, no Planalto Arathi.‡Убейте 8 огров и 10 головорезов из клана Тяжелого Кулака, затем найдите Драма Желчного в Павшем Молоте на нагорье Арати.‡Tötet 8 Oger der Felsfäuste und 10 Vollstrecker der Felsfäuste und sucht dann Drum Teufel im Außenposten von Hammerfall im Arathihochland auf.‡돌주먹 오우거 8마리와 돌주먹 집행자 10마리를 처치한 다음 아라시 고원의 망치 주둔지로 가서 드럼 펠을 찾아야 합니다.‡Mata a 8 ogros y 10 déspotas Puño de Roca; luego ve a ver a Bombo Vil a la avanzada de Sentencia, en las Tierras Altas de Arathi.‡Mata a 8 ogros y 10 déspotas Puño de Roca; luego ve a ver a Bombo Vil a la avanzada de Sentencia, en las Tierras Altas de Arathi.‡Tuer 8 Ogres Rochepoing et 10 Massacreurs Rochepoing, puis retrouver Drum Lagangrène à l\'avant-poste du Trépas-d\'Ogrim sur les hautes-terres Arathies.‡杀掉8个石拳食人魔和10个石拳执行者，然后去阿拉希高地的落锤村哨所找杜拉姆法尔。‡殺掉8個石拳巨魔和10個石拳執行者，然後去阿拉希高地的落錘村哨所找杜拉姆法爾。',
  }
},
[677] = {
  {
    'Chamado às armas‡Призыв к оружию‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡Appel aux armes‡短兵相接‡短兵相接',
    nil,
    'Mate 10 Arremessadores Cascasseca, 10 Caçadores de Cabeças Cascasseca e 8 Mandingueiros Cascasseca. Depois, fale novamente com Drum Fel no posto avançado Ruína do Martelo.‡Убейте 10 метателей топоров, 10 охотников за головами и 8 знахарей из племени Сухокожих, а затем возвращайтесь к Драму Желчному на заставу Павшего Молота.‡Erschlagt 10 Axtwerfer der Bleichborken, 10 Kopfjäger und 8 Hexendoktoren und kehrt zu Drum Teufel im Außenposten von Hammerfall zurück.‡마른나무껍질 도끼투척병 10명과 인간사냥꾼 10명, 의술사 8명을 처치하고 망치 주둔지 전초기지에 있는 드럼 펠에게 가야 합니다.‡Mata a 10 lanzahachas Secacorteza, 10 rebanacabezas y 8 médicos brujos y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Mata a 10 lanzahachas Secacorteza, 10 rebanacabezas y 8 médicos brujos y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Tuer 10 Lanceurs de haches fanécorces, 10 Chasseurs de tête et 8 Féticheurs, puis retourner voir Drum Lagangrène à l\'avant-poste du Trépas-d\'Orgrim.‡杀死10名枯木掷斧者、10名枯木猎头者和8个枯木巫医，然后回到落锤村哨所的杜拉姆法尔那里。‡殺死10名枯木擲斧者、10名枯木獵頭者和8個枯木巫醫，然後回到落錘村哨所的杜拉姆法爾那裡。',
  }
},
[678] = {
  {
    'Chamado às armas‡Призыв к оружию‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡Appel aux armes‡短兵相接‡短兵相接',
    nil,
    'Mate 10 Brutamontes Punho de Pedra e 4 Magi Punho de Pedra. Depois, fale novamente com Drum Fel no posto avançado Ruína do Martelo.‡Убейте 10 громил и 4 магов из клана Тяжелого Кулака, затем возвращайтесь к Драму Желчному на заставу Павшего Молота.‡Tötet 10 Schläger der Felsfäuste und 4 Magi der Felsfäuste und sucht dann Drum Teufel im Außenposten von Hammerfall auf.‡돌주먹 투사 10마리와 돌주먹 사제 4마리를 처치한 다음 망치 주둔지 전초기지에 있는 드럼 펠에게 가야 합니다.‡Mata a 10 toscos Puño de Roca y 4 magi Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Mata a 10 toscos Puño de Roca y 4 magi Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Tuez 10 Brutes rochepoings et 4 Magi rochepoings, puis retournez voir Drum Lagangrène à l\'Avant-poste du Trépas-d\'Orgrim.‡杀死10个石拳蛮兵和4个石拳法师，然后向落锤村哨所的杜拉姆法尔复命。‡殺死10個石拳蠻卒和4個石拳法師，然後向落錘村哨所的杜拉姆法爾覆命。',
  }
},
[679] = {
  {
    'Chamado às armas‡Призыв к оружию‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡Appel aux armes‡短兵相接‡短兵相接',
    nil,
    'Mate 7 Xamãs Punho de Pedra e 3 Senhores dos Punho de Pedra e fale novamente com Drum Fel no posto avançado Ruína do Martelo.‡Убейте 7 шаманов и 3 вождей из клана Тяжелого Кулака и возвращайтесь к Драму Желчному на заставу Павшего Молота.‡Tötet 7 Schamanen der Felsfäuste und 3 Lords der Felsfäuste und kehrt zu Drum Teufel im Außenposten von Hammerfall im Arathihochland zurück.‡돌주먹 주술사 7마리와 돌주먹 우두머리 3마리를 처치한 다음 망치 주둔지 전초기지에 있는 드럼 펠에게 가야 합니다.‡Mata a 7 chamanes Puño de Roca y a 3 señores Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Mata a 7 chamanes Puño de Roca y a 3 señores Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Tuer 7 Chamans rochepoings et 3 Seigneurs rochepoings puis revenir voir Drum Lagangrène à l\'avant-poste du Trépas-d\'Orgrim.‡杀死7个石拳萨满祭司和3个石拳领主，然后向落锤村哨所的杜拉姆法尔复命。‡殺死7個石拳薩滿和3個石拳領主，然後向落錘村哨所的杜拉姆法爾覆命。',
  }
},
[680] = {
  {
    'A ameaça real‡Настоящая угроза‡Die echte Bedrohung‡거대한 위협‡Una auténtica amenaza‡Una auténtica amenaza‡La réelle menace‡真正的威胁‡真正的威脅',
    nil,
    'Mate Or\'Kalar e leve a cabeça dele para Korin Fel no posto avançado Ruína do Martelo.‡Убейте Ор\'Калара и принесите его голову Корин Желчной на заставу Павшего Молота.‡Erschlagt Or\'Kalar und bringt seinen Kopf zu Korin Teufel in den Außenposten von Hammerfall.‡오르칼라를 처치하고 그 증거로 그의 머리카락을 망치 주둔지 전초기지에 있는 코린 펠에게 가져가야 합니다.‡Mata a Or\'Kalar y lleva su cabeza a Korin Vil en la avanzada de Sentencia.‡Mata a Or\'Kalar y lleva su cabeza a Korin Vil en la avanzada de Sentencia.‡Tuer Or\'Kalar et apporter sa Tête à Korin Lagangrène à l\'avant-poste du Trépas-d\'Orgrim.‡杀死奥卡拉尔，将他的徽记带给落锤村哨所的科林法尔。‡殺死奧卡拉爾，將他的頭顱帶給落錘村哨所的科林法爾。',
  }
},
[681] = {
  {
    'Casa Grande do Norte‡Северное поместье‡Nordhof‡북부습곡 장원‡Mansión Redilnorte‡Mansión Redilnorte‡Le manoir de Nordclos‡诺斯弗德农场‡諾斯弗德農場',
    nil,
    'Mate 10 Bandoleiros da Camarilha e 6 Mercenários da Camarilha.|n|nDepois, fale novamente com a Capitã Nélia na Ponta do Refúgio.‡Убейте 10 проходимцев и 6 наемников из Синдиката.|n|nЗатем вернитесь к капитану Ниалс в Опорном пункте.‡Tötet 10 Straßenräuber des Syndikats und 6 Söldner des Syndikats.|n|nKehrt zu Hauptmann Nials bei der Zuflucht zurück.‡비밀결사대 강도 10명과 비밀결사대 용병 6명을 처치해야 합니다.|n|n임시 주둔지에 있는 부대장 나이얼스에게 돌아가십시오.‡Mata a 10 bandoleros de la Hermandad y 6 mercenarios de la Hermandad.|n|nVuelve junto a la capitana Nials en el Refugio de la Zaga.‡Mata a 10 bandoleros de la Hermandad y 6 mercenarios de la Hermandad.|n|nVuelve junto a la capitana Nials en el Refugio de la Zaga.‡Tuer 10 Malandrins du Syndicat et 6 Mercenaires du Syndicat.|n|nRetourner ensuite auprès du capitaine Nials au refuge de l\'Ornière.‡杀掉6个辛迪加雇佣兵和10个辛迪加路霸，然后回到避难谷地去向尼艾丝队长复命。‡殺掉6個辛迪加雇傭兵和10個辛迪加路霸，然後回到避難谷地去向尼艾絲隊長覆命。',
  }
},
[682] = {
  {
    'Insígnias de Stromgarde‡Знаки Стромгарда‡Abzeichen von Stromgarde‡스트롬가드 휘장‡Distintivos de Stromgarde‡Distintivos de Stromgarde‡Les écussons de Stromgarde‡激流堡徽章‡激流堡徽章',
    nil,
    'Entregue 7 Insígnias de Stromgarde para a Capitã Nélia na Ponta do Refúgio.‡Принесите 7 знаков Стромгарда капитану Ниалс в Опорный пункт.‡Bringt 7 Abzeichen von Stromgarde zu Hauptmann Nials bei der Zuflucht.‡임시 주둔지에 있는 부대장 나이얼스에게 스트롬가드 휘장 7개를 가져가야 합니다.‡Llévale 7 distintivos de Stromgarde a la capitana Nials en el Refugio de la Zaga.‡Llévale 7 distintivos de Stromgarde a la capitana Nials en el Refugio de la Zaga.‡Rapporter 7 Ecussons de Stromgarde au capitaine Nials au Refuge de l\'Ornière.‡把7枚激流堡徽章交给位于避难谷地的尼艾丝队长。‡把7個激流堡徽章交給位於避難谷地的尼艾絲隊長。',
  }
},
[683] = {
  {
    '‡Мольба Сары Баллу‡Sara Balloos Hilfegesuch‡사라 발루의 탄원서‡Petición de Sara Balloo‡Petición de Sara Balloo‡Requête de Sara Balloo‡萨拉·巴鲁的请求‡薩拉·巴魯的請求',
    nil,
    '‡Отнесите прошение Сары Баллу королю Магни Бронзобороду в Стальгорн.‡Bringt Sara Balloos Notiz zu König Magni Bronzebart von Eisenschmiede.‡‡Lleva la nota de Sara Balloo al rey Magni Barbabronce de Forjaz.‡Lleva la nota de Sara Balloo al rey Magni Barbabronce de Forjaz.‡Remettre la lettre de Sara Balloo au roi Magni Barbe-de-bronze à Forgefer.‡把萨拉·巴鲁的便笺交给铁炉堡的国王麦格尼·铜须。‡',
  }
},
[684] = {
  {
    'Procura-se: Marez Capucho‡Разыскивается: Марез Клобук‡GESUCHT: Marez Schattenkutte‡마레즈 코울 현상 수배!‡Se busca: Marez Cogulla‡Se busca: Marez Cogulla‡On recherche : Marez Capuche‡通缉：玛雷兹·考尔‡通緝:瑪雷茲·考爾',
    nil,
    'Entregue a Cabeça de Marez para a Capitã Nélia na Ponta do Refúgio.‡Принесите капитану Ниалс в Опорный пункт голову Марез.‡Bringt Marez\' Kopf zu Hauptmann Nials bei der Zuflucht.‡마레즈를 처치하고 그 증거로 그녀의 머리카락을 임시 주둔지에 있는 부대장 나이얼스에게 가져가야 합니다.‡Llévale la cabeza de Marez a la capitana Nials en el Refugio de la Zaga.‡Llévale la cabeza de Marez a la capitana Nials en el Refugio de la Zaga.‡Apporter la tête de Marez au capitaine Nials, au Refuge de l\'Ornière.‡把玛雷兹的徽记交给避难谷地的尼艾丝队长。‡把瑪雷茲的頭顱交給避難谷地的尼艾絲隊長。',
  }
},
[685] = {
  {
    'Procura-se: Otto e Falcocrista‡Разыскивается: Отто и лорд Соколиный Шлем‡GESUCHT: Falkenstein und Otto‡오토와 팰컨크레스트 현상 수배!‡Se busca: Otto y Lord Falconcrest‡Se busca: Otto y Lord Falconcrest‡On recherche : Otto et Lépervier‡通缉：奥图和法库雷斯特‡通緝:奧圖和法庫雷斯特',
    nil,
    'Entregue a Cabeça de Otto e a Cabeça de Falcocrista para a Capitã Nélia na Ponta do Refúgio.‡Принесите головы Отто и лорда Соколиного Шлема капитану Ниалс в Опорный пункт.‡Bringt Ottos und Falkensteins Köpfe zu Hauptmann Nials bei der Zuflucht.‡오토와 팰컨크레스트를 처치하고 그 증거로 머리카락을 임시 주둔지에 있는 부대장 나이얼스에게 가져가야 합니다.‡Llévale la cabeza de Otto y la de Cresta del Halcón a la capitana Nials en el Refugio de la Zaga.‡Llévale la cabeza de Otto y la de Lord Falconcrest a la capitana Nials en el Refugio de la Zaga.‡Apporter les Têtes de Lépervier et d\'Otto au capitaine Nials au Refuge de l\'Ornière.‡把法库雷斯特和奥图的徽记交给避难谷地的尼艾丝队长。‡把法庫雷斯特和奧圖的頭顱交給避難谷地的尼艾絲隊長。',
  }
},
[686] = {
  {
    'Homenagem real‡Королевские почести‡Ehrerbietung von einem König‡왕의 하사품‡Un homenaje real‡Un homenaje real‡Hommage royal‡国王的礼物‡國王的禮物',
    nil,
    'O Rei Magni Barbabronze quer que você fale com o Grão-alvanel Orcarmeyer.‡Поговорите с главным каменотесом Мраморщиком.‡König Magni Bronzebart will, dass Ihr mit Großsteinmetz Marmorstein sprecht.‡마그니 브론즈비어드 국왕이 대석공 마블스텐과 대화해 달라고 했습니다.‡El rey Magni Barbabronce quiere que hables con el gran mampostero Marmolez.‡El rey Magni Barbabronce quiere que hables con el gran mampostero Marmolez.‡Le roi Magni Barbe-de-bronze veut que vous parliez avec le maître-maçon Marbresten.‡国王麦格尼·铜须让你去和大石匠玛布勒斯坦谈一谈。‡國王麥格尼·銅鬚讓你去和大石匠瑪布勒斯坦談話。',
  }
},
[687] = {
  {
    'Theldurin, o Perdido‡Тельдарин Заблудший‡Theldurin der Verirrte‡실성한 텔두린‡Theldurin el Perdido‡Theldurin el Perdido‡Theldurin l\'Egaré‡迷失者塞尔杜林‡『迷失者』塞爾杜林',
    nil,
    'Encontre Theldurin, o Perdido.‡Найдите Тельдарина Заблудшего.‡Findet Theldurin den Verirrten.‡실성한 텔두린을 찾아야 합니다.‡Encuentra a Theldurin el Perdido.‡Encuentra a Theldurin el Perdido.‡Trouver Theldurin l\'Egaré.‡找到迷失者塞尔杜林。‡找到『迷失者』塞爾杜林。',
  }
},
[688] = {
  {
    '‡Союзники Мизраэль‡Myzraels Verbündete‡‡Aliados de Myzrael‡Aliados de Myzrael‡Les alliés de Myzrael‡密斯莱尔的盟友‡',
    nil,
    '‡Поговорите с Заруком в Павшем Молоте, что на нагорье Арати.‡Sprecht mit Zaruk in Hammerfall im Arathihochland.‡‡Habla con Zaruk en Sentencia, en las Tierras Altas de Arathi.‡Habla con Zaruk en Sentencia, en las Tierras Altas de Arathi.‡Parler à Zaruk au Trépas-d\'Orgrim, dans les Hautes-terres Arathies.‡和落锤村的萨鲁克谈一谈。‡',
  }
},
[689] = {
  {
    'Homenagem real‡Королевские почести‡Ehrerbietung von einem König‡왕의 하사품‡Un homenaje real‡Un homenaje real‡Hommage royal‡国王的礼物‡國王的禮物',
    nil,
    'O Grão-alvanel Oscarmeyer, de Altaforja, quer que você lhe traga 5 pedras de Granito de Alterac.‡Принесите главному каменотесу Стальгорна Мраморщику 5 кусков альтеракского гранита.‡Großsteinmetz Marmorstein aus Eisenschmiede will 5 Stücke Alteracgranit.‡아이언포지의 대석공 마블스텐이 알터랙 화강암 5개를 가져다 달라고 했습니다.‡El gran mampostero Marmolez de Forjaz quiere 5 piezas de granito de Alterac.‡El gran mampostero Marmolez de Forjaz quiere 5 piezas de granito de Alterac.‡Le Maître-maçon Marbresten de Forgefer veut 5 Morceaux de Granit d\'Alterac.‡铁炉堡的大石匠玛布勒斯坦要5块奥特兰克花岗岩。‡鐵爐堡的大石匠瑪布勒斯坦要5塊奧特蘭克花崗岩。',
  }
},
[690] = {
  {
    'O pedido de Malin‡Просьба Малина‡Malins Gesuch‡말린의 요청‡Una petición de Malin‡Una petición de Malin‡La demande de Malin‡马林的要求‡馬林的要求',
    nil,
    'Procure Rodapeh na Ponta do Refúgio, no Planalto Arathi.‡Найдите Скуэрто в Опорном пункте на Нагорье Арати.‡Sucht Skuerto bei der Zuflucht im Arathihochland auf.‡아라시 고원의 임시 주둔지에서 스쿼토를 찾아야 합니다.‡Encuentra a Skuerto en el Refugio de la Zaga, en las Tierras Altas de Arathi.‡Encuentra a Skuerto en el Refugio de la Zaga, en las Tierras Altas de Arathi.‡Trouver Skuerto au Refuge de l\'Ornière dans les hautes-terres Arathies.‡找到位于阿拉希高地上的避难谷地中的斯奎尔图。‡找到位於阿拉希高地上的避難谷地中的斯奎爾圖。',
  }
},
[691] = {
  {
    'Isto vale ouro‡На вес золота‡Sein Gewicht in Gold‡마법 재료 구하기‡Valer su peso en oro‡Valer su peso en oro‡Valoir son poids en or‡证明实力‡證明實力',
    nil,
    'Obtenha 10 Presas de Cascasseca, 4 Bolsas Medicinais de Cascasseca e uma Faca de Caçador Sombrio para o Aprendiz Kraiten, que aguarda na Ponta do Refúgio.‡Найдите 10 клыков троллей из племени Сухокожих, 4 лекарских сумки племени Сухокожих и нож темного охотника и принесите их ученику Крайтену в Опорном пункте.‡Sucht für Lehrling Kryten bei der Zuflucht 10 Hauer der Bleichborken, 4 Medizinbeutel der Bleichborken und 1 Schattenjägermesser.‡임시 주둔지에 있는 수습마법사 크리텐에게 마른나무껍질 엄니 10개, 마른나무껍질 약초 주머니 4개, 어둠사냥꾼 나이프 1개를 가져가야 합니다.‡Encuentra 10 colmillos Secacorteza, 4 faltriqueras de medicinas Secacorteza y un cuchillo de cazador de las Sombras para el aprendiz Kryten en el Refugio de la Zaga.‡Encuentra 10 colmillos Secacorteza, 4 bolsas de medicina Secacorteza y un cuchillo de cazador de las Sombras para el aprendiz Kryten en el Refugio de la Zaga.‡Trouver 10 Défenses de Fânécorce, 4 Bourses-médecine Fânécorce et un Couteau de chasseur des ombres pour l\'Apprenti Kryten au Refuge de l\'Ornière.‡帮避难谷地中的学徒克里汀收集10个枯木巨魔的獠牙，4只枯木巨魔的医药包和1把暗影猎手的小刀。‡幫避難谷地中的學徒克里汀收集10個枯木食人妖的獠牙，4個枯木食人妖的醫藥包和1把暗影獵手的小刀。',
  }
},
[692] = {
  {
    '‡Утраченные фрагменты‡Die verlorenen Fragmente‡‡Los trozos perdidos‡Los trozos perdidos‡Les fragments perdus‡遗失的卷轴碎片‡',
    nil,
    '‡Принесите рваный, мятый и обожженный фрагменты свитка Тельдарину Заблудшему.‡Bringt Theldurin dem Verirrten das zerrissene Rollenfragment, das zerknüllte Rollenfragment und das angesengte Rollenfragment.‡‡Lleva el trozo de pergamino roto, el trozo de pergamino arrugado y el trozo de pergamino chamuscado a Theldurin el Perdido.‡Lleva el trozo de pergamino roto, el trozo de pergamino arrugado y el trozo de pergamino chamuscado a Theldurin el Perdido.‡Apportez le Fragment de Parchemin déchiré, le Fragment de Parchemin fripé et le Fragment de Parchemin noirci à Theldurin l\'Egaré.‡把破损的卷轴碎片、弄皱的卷轴碎片和烧焦的卷轴碎片带给迷失者塞尔杜林。‡',
  }
},
[693] = {
  {
    'Entre a varinha e a espada‡Оружие получше кулаков‡Zauberstab gegen Faust‡마법 지팡이 회수‡Empuñar la varita‡Empuñar la varita‡La baguette au poing‡特雷莱恩的符咒魔杖‡特雷萊恩的符咒魔杖',
    nil,
    'Encontre a Varinha de Evocação de Trelane e entregue-a a Rodapeh, na Ponta do Refúgio.‡Найдите заклинательный жезл Трелана и верните его Скуэрто в Опорный пункт.‡Sucht Trelanes Zauberstab der Herbeirufung und bringt ihn Skuerto bei der Zuflucht.‡트렐레인의 마법지팡이를 찾아 임시 주둔지에 있는 스쿼토에게 가져가야 합니다.‡Encuentra la varita de invocación de Trelane y llévasela a Skuerto en el Refugio de la Zaga.‡Encuentra la varita de evocación de Trelane y llévasela a Skuerto en el Refugio de la Zaga.‡Trouvez la Baguette d\'invocation de Trelane et revenez voir Skuerto, au Refuge de l\'Ornière.‡帮避难谷地的斯奎尔图找到特雷莱恩的符咒魔杖，并把它带回来。‡幫避難谷地的斯奎爾圖找到特雷萊恩的符咒魔杖，並把它帶回來。',
  }
},
[694] = {
  {
    '‡Оборона Трелана‡Trelanes Verteidigung‡트렐레인의 방어 장치‡Las defensas de Trelane‡Las defensas de Trelane‡Les défenses de Trelane‡特雷莱恩的防御‡',
    nil,
    '‡Найдите лазурный агат и принесите его ученику Кретьену в Опорный пункт.‡Sucht einen azurblauen Achat und bringt ihn Lehrling Kryten bei der Zuflucht.‡푸른색 마노를 찾아서 임시 주둔지에 있는 수습마법사 크리텐에게 가져가야 합니다.‡Encuentra un ágata azur y llévasela al aprendiz Kryten en el Refugio de la Zaga.‡Encuentra un ágata azur y llévasela al aprendiz Kryten en el Refugio de la Zaga.‡Trouver une Agate d\'azur et la porter à l\'Apprenti Kryten au Refuge de l\'Ornière.‡找到一块碧蓝玛瑙石，把它交给避难谷地处的学徒克里汀。‡',
  }
},
[695] = {
  {
    '‡Чары ученика‡Des Lehrlings Verzauberung‡‡Un encantamiento de aprendiz‡Un encantamiento de aprendiz‡Enchantement d\'Apprenti‡学徒的魔法‡',
    nil,
    '‡Поговорите со Скуэрто в Опорном пункте, что на нагорье Арати.‡Sprecht mit Skuerto in der Zuflucht im Arathihochland.‡‡Habla con Skuerto en el Refugio de la Zaga, en la Cuenca de Arathi.‡Habla con Skuerto en el Refugio de la Zaga, en la Cuenca de Arathi.‡Parlez à Skuerto au Refuge de l\'Ornière, dans les Hautes-terres Arathies.‡和斯奎尔图谈一谈。‡',
  }
},
[696] = {
  {
    'Ataque à torre‡Атака на башню‡Angriff auf den Turm‡탑 공격‡Ataque a la torre‡Ataque a la torre‡Attaque sur la tour‡进攻高塔‡進攻高塔',
    nil,
    'Encontre o Filactério de Trelane, o Orbe de Trelane e a Ágata-de-fogo de Trelane e entregue-os a Rodapeh na Ponta do Refúgio.‡Найдите талисман, сферу и угольный агат Трелана и принесите их Скуэрто в Опорный пункт.‡Sucht Trelanes Phylakterium, Trelanes Kugel und Trelanes Glutachat und bringt ihn Skuerto bei der Zuflucht.‡트렐레인의 부적, 트렐레인의 수정구, 트렐레인의 잿불 마노를 찾아 임시 주둔지에 있는 스쿼토에게 가져가야 합니다.‡Encuentra la filacteria de Trelane, el orbe de Trelane y el ágata de ascuas de Trelane, y llévaselo todo a Skuerto en el Refugio de la Zaga.‡Encuentra la filacteria de Trelane, el orbe de Trelane y el ágata de ascuas de Trelane, y llévaselo todo a Skuerto en el Refugio de la Zaga.‡Trouver le Phylactère de Trelane, l\'Orbe de Trelane et l\'Agathe de braise de Trelane. Les rapporter à Skuerto au Refuge de l\'Ornière.‡找到特雷莱恩的护符匣、特雷莱恩的宝珠和特雷莱恩的黑玛瑙，把它们交给避难谷地的斯奎尔图。‡找到特雷萊恩的骨匣、特雷萊恩的寶珠和特雷萊恩的黑瑪瑙，把它們交給避難谷地的斯奎爾圖。',
  }
},
[697] = {
  {
    'O pedido de Malin‡Просьба Малина‡Malins Gesuch‡말린의 의뢰‡Una petición de Malin‡Una petición de Malin‡La demande de Malin‡马林的要求‡馬林的要求',
    nil,
    'Leve a Carta Lacrada para o Arquimago Malin, no Distrito dos Magos de Ventobravo.‡Отвезите запечатанное письмо верховному магу Малину в Квартал Магов Штормграда.‡Bringt dem Erzmagier Malin im Magierviertel von Sturmwind den versiegelten Brief.‡스톰윈드의 마법사 지구에 있는 대마법사 말린에게 보내는 봉인된 편지를 전달해야 합니다.‡Lleva la carta lacrada al archimago Malin en el Barrio de los Magos de Ventormenta.‡Lleva la carta lacrada al archimago Malin en el Barrio de los Magos de Ventormenta.‡Porter la Lettre scellée à l\'archimage Malin dans le Quartier des Mages de Hurlevent.‡将给大法师马林的信交给暴风城法师区里的大法师马林。‡將給大法師馬林的信交給暴風城法師區裡的大法師馬林。',
  }
},
[698] = {
  {
    '[DEPRECATED]Lack of Surplus‡Нехватка ресурсов‡Mangelnde Reserven‡보급품 보충‡[DEPRECATED]Falta de suministros‡[DEPRECATED]Falta de suministros‡[PÉRIMÉ]Petit bonus du soir‡[DEPRECATED] 缺乏补给‡[DEPRECATED]Lack of Surplus',
    nil,
    'Leve 8 Ancas Não Tratadas de Dentesserra para Tok\'Kar no Pântano das Mágoas.‡Принесите Ток\'Кару в Болотах Печали 8 сырых боков острозубых кроколисков.‡Bringt Tok\'Kar in den Sümpfen des Elends 8 Stück unverarbeitete Sägezahnflanken.‡슬픔의 늪에 있는 톡카르에게 신선한 톱니악어 고기 8개를 가져가야 합니다.‡Lleva 8 costillares de Denteserra sin preparar a Tok\'Kar en el Pantano de las Penas.‡Lleva 8 costillares de Denteserra sin preparar a Tok\'Kar en el Pantano de las Penas.‡Apporter 8 Flancs de Dents-de-scie non préparés à Tok\'Kar dans le marais des Chagrins.‡给悲伤沼泽的托克卡尔带去8块新鲜的盐齿鳄鱼肉。‡給悲傷沼澤的托克卡爾帶去8塊新鮮的尖齒鱷魚肉。',
  }
},
[699] = {
  {
    '[DEPRECATED]Lack of Surplus‡‡Mangelnde Reserven‡‡‡‡‡[DEPRECATED] 缺乏补给‡[DEPRECATED]Lack of Surplus',
    nil,
    'Leve 6 Garras de Tartalisca Dentesserra para Tok\'Kar, no Pântano das Mágoas.‡‡Bringt Tok\'Kar in den Sümpfen des Elends 6 Sägezahnschnapperklauen.‡‡‡‡‡给悲伤沼泽的托克卡尔带去6只盐齿钳嘴鳄的爪子。‡給悲傷沼澤的托克卡爾帶去6隻尖齒鉗嘴鱷的爪子。',
  }
},
[700] = {
  {
    '‡Королевские почести‡Ehrerbietung von einem König‡왕의 하사품‡Un homenaje real‡Un homenaje real‡Hommage royal‡国王的礼物‡',
    nil,
    '‡Доставьте известие королю Магни Бронзобороду.‡Erstattet Meldung an König Magni Bronzebart.‡‡Preséntate ante el rey Magni Barbabronce.‡Preséntate ante el rey Magni Barbabronce.‡Rendre compte au Roi Magni Barbe-de-bronze.‡向铁炉堡的国王麦格尼·铜须汇报。‡',
  }
},
[701] = {
  {
    'A astúcia dos raptores‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡迅猛龍的狡詐',
    nil,
    'Consiga 12 Corações de Raptores dos Fareja-carne do Planalto para Tor\'gan.‡Добудьте для Тор\'гана 12 сердец ящера, вырвав их у плотоглотов нагорья.‡Besorgt für Tor\'gan 12 Raptorherzen von Hochlandfleischpirschern.‡식인 고원랩터에게서 랩터 심장 12개를 모아 토건에게 가져가야 합니다.‡Consigue 12 corazones de raptor de los acechacarnes de las Tierras Altas para Tor\'gan.‡Consigue 12 corazones de raptor de los acechacarnes de las Tierras Altas para Tor\'gan.‡Récupérer 12 Cœurs de raptor provenant de Charognards des hautes-terres pour Tor\'gan.‡从高地猎兽龙身上获取12颗迅猛龙的心脏，把它们交给托尔甘。‡從高地獵獸龍身上獲取12顆迅猛龍的心臟，把它們交給托爾甘。',
  }
},
[702] = {
  {
    '‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡',
    nil,
    '‡Отдайте сферу Тор\'гана Гор\'мулю. Его можно найти в Павшем Молоте, что на нагорье Арати.‡Gebt Gor\'mul Tor\'gans Kugel in Hammerfall im Arathihochland.‡‡Dale el orbe de Tor\'gan a Gor\'mul. Está en Sentencia, en las Tierras Altas de Arathi.‡Dale el orbe de Tor\'gan a Gor\'mul. Está en Sentencia, en las Tierras Altas de Arathi.‡Donner l\'Orbe de Tor\'gan à Gor\'mul au Trépas-d\'Orgrim, dans les Hautes-terres Arathies.‡把托尔甘的宝珠交给戈穆尔。‡',
  }
},
[703] = {
  {
    'Churrasquinho de urubu‡Жареные крылышки канюка‡Gegrillte Bussardflügel‡대머리수리 날개 구이‡Alas de águila ratonera a la parrilla‡Alas de águila ratonera a la parrilla‡Ailes de busard grillées‡烧烤秃鹰翅膀‡燒烤禿鷲翅膀',
    nil,
    'Leve 4 Asas de Urubu para Bertolezo.‡Принесите 4 крылышка канюка Ригглфаззу.‡Bringt Riggelfuzz 4 Bussardflügel.‡리글퍼즈에게 대머리수리 날개 4개를 가져가야 합니다.‡Llévale 4 alas de águila ratonera a Aparejez.‡Llévale 4 alas de águila ratonera a Aparejez.‡Apporter 4 Ailes de busard à Rigglefuzz.‡给里格弗兹带去4只秃鹫的翅膀。‡給里格弗茲帶去4只禿鷲的翅膀。',
  }
},
[704] = {
  {
    '‡Судьба Эгмонда‡Agmonds Schicksal‡아그몬드의 운명‡El sino de Agmond‡El sino de Agmond‡Le destin d\'Agmond‡阿戈莫德的命运‡',
    nil,
    '‡Принесите 4 резные каменные урны геологу Сталекруту в Лок Модан.‡Bringt Ausgrabungsleiter Eisenband am Loch Modan 4 verzierte Steinurnen.‡모단 호수에 있는 발굴조사단장 아이언밴드에게 돌조각 단지 4개를 가져가야 합니다.‡Llévale 4 urnas de piedra labrada al prospector Vetaferro en Loch Modan.‡Llévale 4 urnas de piedra labrada al prospector Vetaferro en Loch Modan.‡Apporter 4 Urnes de pierre gravées au Prospecteur Baguefer au Loch Modan.‡收集4个雕纹石罐，把它们交给洛克莫丹的勘察员基恩萨·铁环。‡',
  }
},
[705] = {
  {
    'Pescando pérolas‡В поисках жемчуга‡Perlentauchen‡진주잡이‡La pesca de perlas‡La pesca de perlas‡Pêche aux perles‡潜水采珍珠‡潛水採珍珠',
    nil,
    'Leve 9 Pérolas Azuis para Bertolezo, nos Ermos.‡Принесите 9 синих жемчужин Ригглфаззу в Бесплодные земли.‡Bringt Riggelfuzz im Ödland 9 blaue Perlen.‡황야의 땅에 있는 리글퍼즈에게 푸른 진주 9개를 가져가야 합니다.‡Llévale 9 perlas azules a Aparejez en las Tierras Inhóspitas.‡Llévale 9 perlas azules a Aparejez en las Tierras Inhóspitas.‡Apporter 9 Perles bleues à Rigglefuzz dans les Terres ingrates.‡收集9枚蓝珍珠，把它们交给荒芜之地的里格弗兹。‡收集9枚藍珍珠，把它們交給荒蕪之地的里格弗茲。',
  }
},
[706] = {
  {
    'Encantamentos de Labareda Abrasadora‡Чары яркого пламени‡Feuerverzauberungen‡이글거리는 불꽃의 부적‡Encantamientos Llamarada ígnea‡Encantamientos Llamarada ígnea‡Enchantements d\'éclats flamboyants‡黑龙之火‡黑龍之火',
    nil,
    'Consiga um Coração de Draco Preto para Sigrun Derrubaferro.‡Принесите сердце черного дракона Сигруну Рудотесу.‡Besorgt Sigrun Eisenhieb ein Schwarzdrachenherz.‡시그런 아이언휴가 검은 비룡의 심장을 구해 달라고 했습니다.‡Consigue 1 corazón de draco negro para Sigrun Extracero.‡Consigue 1 corazón de draco negro para Sigrun Extracero.‡Récupérer un Cœur de drake noir pour Sigrun Taillefer.‡为西格鲁·铁斧拿到一颗黑色幼龙之心。‡為西格魯·鐵斧拿到一顆黑龍之心。',
  }
},
[707] = {
  {
    'Bandaferro quer você!‡Вы нужны Сталекруту!‡Eisenband sucht Euch!‡아이언밴드의 호출‡¡Vetaferro te necesita!‡¡Vetaferro te necesita!‡Baguefer a besoin de vous !‡铁环挖掘场需要你！‡鐵環挖掘場需要你!',
    nil,
    'Fale com o Prospector Bandaferro, no Sítio de Escavação de Bandaferro, em Loch Modan.‡Поговорите с геологом Сталекрутом на раскопках Сталекрута близ озера Лок.‡Sprecht auf Eisenbands Ausgrabungsstätte am Loch Modan mit Ausgrabungsleiter Eisenband.‡모단 호수에 있는 아이언밴드의 발굴현장에서 발굴조사단장 아이언밴드와 대화해야 합니다.‡Habla con el prospector Vetaferro en la Excavación de Vetaferro en Loch Modan.‡Habla con el prospector Vetaferro en la Excavación de Vetaferro en Loch Modan.‡Parler au Prospecteur Baguefer, sur le Site de fouilles de Loch Modan.‡和洛克莫丹铁环挖掘场的勘察员基恩萨·铁环谈一谈。‡和洛克莫丹鐵環挖掘場的勘察員基恩薩·鐵環談話。',
  }
},
[708] = {
  {
    '‡Черный ящик‡Der Flugschreiber‡블랙박스‡La caja negra‡La caja negra‡La boîte noire‡黑盒子‡',
    nil,
    '‡Отнесите заржавевший черный ящик в оружейную Стальгорна.‡Bringt den zerfressenen Flugschreiber in die Halle der Waffen in Eisenschmiede.‡녹슨 블랙박스를 아이언포지에 있는 전투의 전당으로 가져가야 합니다.‡Lleva la caja negra corroída a la Sala de Armas de Forjaz.‡Lleva la caja negra corroída a la Sala de Armas de Forjaz.‡Apporter la Boîte noire corrodée à la Salle d\'armes, à Forgefer.‡把遗失的货物交给军需官朗格尔斯。‡',
  }
},
[709] = {
  {
    'A solução para o fim‡Лекарство от судьбы‡Lösung der Verdammnis‡멸망의 해결책‡La solución a la maldición‡La solución a la maldición‡La solution à la malédiction‡化解灾难‡化解災難',
    nil,
    'Leve a Tabuleta de Ryun\'eh para Theldurin, o Perdido.‡Принесите табличку Рьюн\'эха Тельдарину Заблудшему.‡Bringt Theldurin dem Verirrten die Schrifttafel von Ryun\'eh.‡실성한 텔두린에게 류네의 서판을 가져가야 합니다.‡Llévale la tablilla de Ryun\'eh a Theldurin el Perdido.‡Llévale la tablilla de Ryun\'eh a Theldurin el Perdido.‡Apportez la Tablette de Ryun\'eh à Theldurin l\'Egaré.‡把雷乌纳石板带给迷失者塞尔杜林。‡把雷烏納石板帶給『迷失者』塞爾杜林。',
  }
},
[710] = {
  {
    'Um estudo dos elementos: rocha‡Изучение стихий: Камень‡Element-Studie: Fels‡바위의 정령 연구‡Estudio de los elementos: roca‡Estudio de los elementos: roca‡Étude des éléments : la roche‡研究石元素‡研究石元素',
    nil,
    'Encontre 10 Estilhaços Pequenos de Pedra e leve-os para Lotwil Viriato, nos Ermos.‡Соберите 10 маленьких осколков камня и принесите Лотвилю Вериатусу в Бесплодные земли.‡Sucht 10 kleine Felssplitter und bringt sie Lotwil Veriatus im Ödland.‡황야의 땅에 있는 로트윌 베리아투스에게 작은 돌조각 10개를 가져가야 합니다.‡Encuentra 10 fragmentos de piedra pequeños y llévaselos a Lotwil Veriatus en las Tierras Inhóspitas.‡Encuentra 10 fragmentos de piedra pequeños y llévaselos a Lotwil Veriatus en las Tierras Inhóspitas.‡Trouver 10 Petits éclats de pierre et les apporter à Lotwil Veriatus dans les Terres ingrates.‡收集10块小石头碎块，把它们交给荒芜之地的鲁特维尔·沃拉图斯。‡收集10塊小石頭裂片，把它們交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[711] = {
  {
    'Um estudo dos elementos: rocha‡Изучение стихий: Камень‡Element-Studie: Fels‡바위의 정령 연구‡Estudio de los elementos: roca‡Estudio de los elementos: roca‡Étude des éléments : la roche‡研究石元素‡研究石元素',
    nil,
    'Leve 3 Lajes Grandes para Lotwil Viriato, nos Ermos.‡Принесите 3 больших куска камня Лотвилю Вериатусу в Бесплодные земли.‡Bringt Lotwil Veriatus im Ödland 3 große Steinplatten.‡황야의 땅에 있는 로트윌 베리아투스에게 큰 돌조각 3개를 가져가야 합니다.‡Llévale 3 losas de piedra grandes a Lotwil Veriatus en las Tierras Inhóspitas.‡Llévale 3 losas de piedra grandes a Lotwil Veriatus en las Tierras Inhóspitas.‡Apporter 3 Grands blocs de pierre à Lotwil Veriatus dans les Terres ingrates.‡收集3块大石片，把它们交给荒芜之地的鲁特维尔·沃拉图斯。‡收集3塊大石片，把它們交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[712] = {
  {
    'Um estudo dos elementos: rocha‡Изучение стихий: Камень‡Element-Studie: Fels‡바위의 정령 연구‡Estudio de los elementos: roca‡Estudio de los elementos: roca‡Étude des éléments : la roche‡研究石元素‡研究石元素',
    nil,
    'Leve 5 Braçadeiras de Liga de Pedra para Lotwil Viriato, nos Ermos.‡Принесите 5 браслетов камня Лотвилю Вериатусу в Бесплодные земли.‡Bringt Lotwil Veriatus im Ödland 5 Armschienen der Steinbindung.‡황야의 땅에 있는 로트윌 베리아투스에게 바위 결속의 팔보호구 5개를 가져가야 합니다.‡Llévale 5 brazales de vínculo de roca a Lotwil Veriatus en las Tierras Inhóspitas.‡Llévale 5 brazales de vínculo de roca a Lotwil Veriatus en las Tierras Inhóspitas.‡Apporter 5 Brassards de liaison de pierre à Lotwil Veriatus dans les Terres ingrates.‡收集5个石缚护腕，把它们交给荒芜之地的鲁特维尔·沃拉图斯。‡收集5個石縛護腕，把它們交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[713] = {
  {
    'Cuca fresca‡Охлаждение горячих голов‡Kühlaufsätze setzen sich durch‡최고의 냉각제‡Mantener la cabeza fría‡Mantener la cabeza fría‡La tête froide l\'emporte toujours‡至关重要的冷却剂‡至關重要的冷卻劑',
    nil,
    'Encontre Óleo Gélido e leve para Lotwil Viriato, nos Ermos.‡Найдите масло льда и принесите его Лотвилю Вериатусу в Бесплодные земли.‡Sucht Frostöl und bringt es Lotwil Veriatus im Ödland.‡황야의 땅에 있는 로트윌 베리아투스에게 냉기 기름을 가져가야 합니다.‡Encuentra aceite de Escarcha y llévaselo a Lotwil Veriatus en las Tierras Inhóspitas.‡Encuentra aceite de Escarcha y llévaselo a Lotwil Veriatus en las Tierras Inhóspitas.‡Trouver de l\'Huile glaciale et la porter à Lotwil Veriatus dans les Terres ingrates.‡找到冰霜之油，把它交给荒芜之地的鲁特维尔·沃拉图斯。‡找到冰霜之油，把它交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[714] = {
  {
    '‡Гиро...чего?‡Gyro... Was?‡‡Un giro... ¿Qué?‡Un giro... ¿Qué?‡Un gyro... quoi ?‡发条式什么什么仪‡發條式什麼什麼儀',
    nil,
    '‡Принесите гирохронатом Лотвилю Вериатусу в Бесплодные земли.‡Bringt Lotwil Veriatus im Ödland einen Gyrochronatom.‡‡Llévale 1 girocronátomo a Lotwil Veriatus en las Tierras Inhóspitas.‡Llévale 1 girocronátomo a Lotwil Veriatus en las Tierras Inhóspitas.‡Apporter un Gyrochronatome à Lotwil Veriatus dans les Terres ingrates.‡给荒芜之地的鲁特维尔·沃拉图斯带去一个发条式同步协调陀螺仪。‡給荒蕪之地的魯特維爾·沃拉圖斯帶去一個發條式同步協調陀螺儀。',
  }
},
[715] = {
  {
    '‡Жидкий камень‡Flüssigstein‡‡Piedra líquida‡Piedra líquida‡Pierre liquide‡卢希恩的药水‡',
    nil,
    '‡Принесите зелье простой невидимости и лечебное зелье Люсьену Подай-Ключ в Бесплодные земли.‡Bringt Lucien Knobelzang im Ödland einen Heiltrank und einen geringen Unsichtbarkeitstrank.‡‡Llévale 1 poción de sanación y 1 poción de invisibilidad inferior a Lucien Borlallave en las Tierras Inhóspitas.‡Llévale 1 poción de sanación y 1 poción de invisibilidad inferior a Lucien Borlallave en las Tierras Inhóspitas.‡Apporter une Potion d\'invisibilité inférieure et une Potion de soins à Lucien Torsaclef dans les Terres ingrates.‡为荒芜之地的卢希恩·枪穗找到一瓶次级隐形药水和一瓶治疗药水。‡',
  }
},
[716] = {
  {
    'Pedra é mais resistente que tecido‡Камень – лучшая одежка!‡Stein ist besser als Stoff‡돌로 만든 보호구‡Es mejor la piedra que la tela‡Es mejor la piedra que la tela‡Mieux est la pierre que le tissu‡有备无患‡有備無患',
    nil,
    'Leve algumas Braçadeiras Decoradas de Bronze para Lucien Tacachave, nos Ermos.‡Принесите украшенные узором бронзовые наручи Люсьену Подай-Ключ в Бесплодные земли.‡Bringt Lucien Knobelzang im Ödland ein Paar gemusterte bronzene Armschienen.‡황야의 땅에 있는 루시앙 토슬렌치에게 청동 무늬 팔보호구를 가져가야 합니다.‡Llévale unos brazales de bronce estampados a Lucien Borlallave en las Tierras Inhóspitas.‡Llévale unos brazales de bronce estampados a Lucien Borlallave en las Tierras Inhóspitas.‡Apportez des Brassards guillochés en bronze à Lucien Torsaclef dans les Terres ingrates.‡给荒芜之地的卢希恩·枪穗带去一些青铜花纹护腕。‡給荒蕪之地的盧希恩·槍穗帶去一些青銅花紋護腕。',
  }
},
[717] = {
  {
    '‡Дрожь земли‡Erdbeben‡대지의 진동‡Terremotos‡Terremotos‡Tremblement de terre‡大地的震颤‡',
    nil,
    '‡С помощью знака земли активируйте алмазный, опаловый и аметистовый столпы и извлеките рунные камни. |n|nПоместите рунные камни на печать земли и освободите драконов Чернохлыста и Гематуса. |n|nУбейте драконов и принесите Гареку наручники Чернохлыста, цепи Гематуса и знак земли.‡Benutzt das Zeichen der Erde, um die Amethyst-, Opal- und Diamantsäulen zu aktivieren und die Runensteine zu holen.|n|nLegt die Runensteine auf das Siegel der Erde, um Schattenbringer und Hematus zu befreien.|n|nTötet sie und bringt dann Garek Schattenbringers Bindung, Hematus\' Ketten und das Zeichen der Erde.‡대지의 봉인을 사용하여 자수정, 오팔, 다이아몬드의 기둥을 작동시켜 마법석을 획득해야 합니다.|n|n마법석들을 대지의 봉인에 놓아 블랙래쉬와 헤마투스의 봉인을 해제해야 합니다.|n|n풀려 난 블랙래쉬와 헤마투스를 처치하고 가렉에게 블랙래쉬의 굴레, 헤마투스의 굴레와 대지의 봉인을 가져가야 합니다.‡Usa el Signo de la Tierra para activar los pilares de amatista, de ópalo y de diamante y así obtener las piedras rúnicas.|n|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Latigoscuro y a Hematus.|n|nMátalos y llévale a Garek las ataduras de Latigoscuro, las cadenas de Hematus y el Signo de la Tierra.‡Usa el Signo de la Tierra para activar los pilares de amatista, de ópalo y de diamante y así obtener las piedras rúnicas.|n|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Latigoscuro y a Hematus.|n|nMátalos y llévale a Garek las ataduras de Latigoscuro, las cadenas de Hematus y el Signo de la Tierra.‡Utiliser le Signe de la Terre pour activer les Piliers d\'Améthyste, d\'Opale et de Diamant, et obtenir les Pierres runiques.|n|nPlacer les Pierres runiques dans le Sceau de la Terre pour libérer Cinglenoir et Hematus.|n|nLes tuer, puis rapporter les Liens de Cinglenoir, les Entraves de Hematus et le Signe de la Terre à Garek.‡用大地印章激活钻石柱、玛瑙石柱和紫水晶石柱并拿到三颗符石。|n|n把符石放在大地封印上，释放黑龙布莱克拉什和赫玛图斯。|n|n杀了这两条黑龙，把布莱克拉什的锁链、赫玛图斯的锁链和大地印章交给加瑞克。‡',
  }
},
[718] = {
  {
    'Miragens‡Миражи‡Illusionen‡신기루‡Espejismos‡Espejismos‡Mirages‡饥肠辘辘‡饑腸轆轆',
    nil,
    'Recupere o Caixote de Suprimentos para Sigrun Derrubaferro.‡Верните ящик с припасами Сигруну Рудотесу.‡Holt die Nachschubkiste für Sigrun Eisenhieb.‡시그런 아이언휴를 위해 보급품 상자를 되찾아야 합니다.‡Recupera el cajón de suministros para Sigrun Extracero.‡Recupera el cajón de suministros para Sigrun Extracero.‡Retrouver la Caisse de fournitures pour Sigrun Taillefer.‡帮西格鲁·铁斧找回补给箱。‡幫西格魯·鐵斧找回補給木箱。',
  }
},
[719] = {
  {
    '‡Дворф и его инструменты‡Ein Zwerg und sein Werkzeug‡행운의 곡괭이‡Un enano y sus herramientas‡Un enano y sus herramientas‡Un nain et ses outils‡矮人的工具‡',
    nil,
    '‡Найдите счастливую кирку Ржанца и верните ее геологу Ржанцу к югу от карьера Тяжелоступа.‡Sucht Roggendols Glückshacke und bringt sie Ausgrabungsleiter Roggendol in der Hammerzehs Grabungsstätte.‡라이돌의 행운의 곡괭이를 찾아 해머토의 발굴현장의 남쪽에 있는 발굴조사단장 라이돌에게 가져가야 합니다.‡Encuentra el pico de la suerte de Ryedol y llévaselo al prospector Ryedol al sur de la excavación de Piemartillo.‡Encuentra el pico de la suerte de Ryedol y llévaselo al prospector Ryedol al sur de la excavación de Piemartillo.‡Trouver le Piolet porte-bonheur de Ryedol et le rapporter au Prospecteur Ryedol au sud du site de fouilles de Martèlorteil.‡找到雷杜尔的好运锄，把它交给铁趾挖掘场南边的勘察员雷杜尔。‡',
  }
},
[720] = {
  {
    '‡Предвестник надежды‡Ein Hoffnungsschimmer‡희망의 전조‡Un signo de esperanza‡Un signo de esperanza‡Un signe d\'espoir‡一线希望‡',
    nil,
    '‡Найдите геолога Ржанца и сообщите, что Грез Тяжелоступ жив.‡Sucht Ausgrabungsleiter Roggendol und teilt ihm mit, dass Hammerzeh Grez noch am Leben ist.‡발굴조사단장 라이돌을 찾아 해머토 그레즈가 살아 있다는 사실을 알려야 합니다.‡Localiza al prospector Ryedol y dile que Grez Piemartillo está vivo.‡Localiza al prospector Ryedol y dile que Grez Piemartillo está vivo.‡Trouver le Prospecteur Ryedol et lui dire que Martèlorteil Grez est en vie.‡找到勘察员雷杜尔，告诉他铁趾格雷兹还活着。‡',
  }
},
[721] = {
  {
    'Um sinal de esperança‡Предвестник надежды‡Ein Hoffnungsschimmer‡희망의 전조‡Un signo de esperanza‡Un signo de esperanza‡Un signe d\'espoir‡一线希望‡一線希望',
    nil,
    'Encontre Grez Pé-de-malho em Uldaman.‡Найдите Греза Тяжелоступа в Ульдамане.‡Sucht in Uldaman nach Hammerzeh Grez.‡울다만에서 해머토 그레즈를 찾아야 합니다.‡Encuentra a Grez Piemartillo en Uldaman.‡Encuentra a Grez Piemartillo en Uldaman.‡Trouver Martèlorteil Grez à Uldaman.‡在奥达曼找到铁趾格雷兹。‡在奧達曼找到鐵趾格雷茲。',
  }
},
[722] = {
  {
    '‡Амулет тайн‡Amulett der Geheimnisse‡‡El amuleto de los secretos‡El amuleto de los secretos‡L\'amulette des secrets‡铁趾的护符‡',
    nil,
    '‡Найдите амулет Тяжелоступа и верните его ему в Ульдаман.‡Sucht Hammerzehs Amulett und bringt es ihm nach Uldaman.‡‡Encuentra el amuleto de Piemartillo y llévaselo a Uldaman.‡Encuentra el amuleto de Piemartillo y llévaselo a Uldaman.‡Trouver l\'Amulette de Martèlorteil et la lui rapporter à Uldaman.‡找到铁趾的护符，把它交给奥达曼的铁趾。‡',
  }
},
[723] = {
  {
    '‡Клятва верности‡Ein Funken Hoffnung‡‡Tener fe en el porvenir‡Tener fe en el porvenir‡Espérance en la foi‡铁趾的遗愿‡',
    nil,
    '‡Отнесите амулет Тяжелоступа геологу Ржанцу в Бесплодные земли.‡Bringt Ausgrabungsleiter Roggendol im Ödland Hammerzehs Amulett.‡‡Llévale el amuleto de Piemartillo al prospector Ryedol en las Tierras Inhóspitas.‡Llévale el amuleto de Piemartillo al prospector Ryedol en las Tierras Inhóspitas.‡Porter l\'Amulette de Martèlorteil au Prospecteur Ryedol dans les Terres ingrates.‡把铁趾的护符交给荒芜之地的勘察员雷杜恩。‡',
  }
},
[724] = {
  {
    '‡Клятва верности‡Ein Funken Hoffnung‡‡Tener fe en el porvenir‡Tener fe en el porvenir‡Espérance en la foi‡铁趾的遗愿‡',
    nil,
    '‡Отнесите амулет Тяжелоступа историку Карнику в Стальгорне.‡Bringt Historiker Karnik in Eisenschmiede Hammerzehs Amulett.‡‡Llévale el amuleto de Piemartillo a Karnik el Historiador en Forjaz.‡Llévale el amuleto de Piemartillo a Karnik el Historiador en Forjaz.‡Apporter l\'Amulette de Martèlorteil à l\'Historien Karnik à Forgefer.‡把铁趾的护符交给铁炉堡的史学家卡尼克。‡',
  }
},
[725] = {
  {
    '‡Слухи об угрозе‡Kunde über die Bedrohung breitet sich aus‡‡Advertir de la amenaza‡Advertir de la amenaza‡Avertir de la menace‡亡者的警告‡',
    nil,
    '‡Найдите советника Белграма и отдайте ему записку.‡Sucht Berater Belgrum und gebt ihm die Notiz.‡‡Encuentra al consejero Belgrum y dale su nota.‡Encuentra al consejero Belgrum y dale su nota.‡Trouvez le Conseiller Belgrum et donnez-lui la Note.‡找到顾问贝尔格拉姆，把便笺交给他。‡',
  }
},
[726] = {
  {
    '‡Слухи об угрозе‡Kunde über die Bedrohung breitet sich aus‡‡Advertir de la amenaza‡Advertir de la amenaza‡Avertir de la menace‡亡者的警告‡',
    nil,
    '‡Поговорите с историком Карником.‡Sprecht mit Historiker Karnik.‡‡Habla con Karnik el Historiador.‡Habla con Karnik el Historiador.‡Parler à l\'Historien Karnik.‡和史学家卡尼克谈一谈。‡',
  }
},
[727] = {
  {
    '‡В Стальгорн за книгой Йагина‡Auf nach Eisenschmiede zu \'Yagyins Zusammenstellung\'‡‡Ir a Forjaz a buscar el "Compendio" de Yagyin‡Ir a Forjaz a buscar el "Compendio" de Yagyin‡L\'Abrégé de Yagyin à Forgefer‡远赴铁炉堡‡',
    nil,
    '‡Отнесите печать Молота Геррику Костохвату в Заброшенный грот в Стальгорн.‡Gebt Gerrig Knochengriff im Düsteren Viertel von Eisenschmiede das Siegelzeichen des Hammers.‡‡Dale el sigilo del Martillo a Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Dale el sigilo del Martillo a Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Donner le Cachet du Marteau à Gerrig Poigne-d\'os, dans la Caverne Lugubre de Forgefer.‡把战锤印章交给铁炉堡的葛利·硬骨。‡',
  }
},
[728] = {
  {
    'Em busca do compêndio de Yagyin na Cidade Baixa‡В Подгород за книгой Йагина‡Auf nach Unterstadt zu \'Yagyins Zusammenstellung\'‡야그인의 법전을 찾아서‡Ir a Entrañas a buscar el "Compendio" de Yagyin‡Ir a Entrañas a buscar el "Compendio" de Yagyin‡L\'Abrégé de Yagyin à Fossoyeuse‡远赴幽暗城‡遠赴幽暗城',
    nil,
    'Leve o Signo do Martelo ao Guardião Bel\'dugur na Cidade Baixa.‡Отнесите печать Молота хранителю Бел\'дугуру в Подгород.‡Bringt dem Bewahrer Bel\'dugur in Unterstadt das Siegelzeichen des Hammers.‡언더시티에 있는 관리인 벨두거에게 해머의 인장을 가져가야 합니다.‡Llévale el sigilo del Martillo al guardián Bel\'dugur en Entrañas.‡Llévale el sigilo del Martillo al vigilante Bel\'dugur en Entrañas.‡Apportez le Cachet du Marteau au Gardien Bel\'dugur à Fossoyeuse.‡把战锤印章交给幽暗城的看守者贝尔杜加。‡把戰錘印章交給幽暗城的看守者貝爾杜加。',
  }
},
[729] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Vá para o sul e veja como está o Prospector Trilheiro.‡Отправляйтесь на юг, найдите геолога Сомнамбулера и узнайте, как у него дела.‡Reist nach Süden und seht nach Ausgrabungsleiter Wirrbart.‡남쪽으로 가서 발굴조사단장 렘트래블의 상태를 확인해야 합니다.‡Viaja al sur y asegúrate de que el prospector Tripirrem está bien.‡Viaja al sur y asegúrate de que el prospector Tripirrem está bien.‡Aller vers le sud et vérifier l\'état de santé du Prospecteur Songerrance.‡到南边去一趟，看看勘察员雷姆塔维尔现在处境如何。‡到南邊去一趟，看看勘察員雷姆塔維爾現在處境如何。',
  }
},
[730] = {
  {
    'Problemas na Costa Negra?‡Неприятности на Темных берегах?‡Ärger in Dunkelküste?‡어둠해안에 생긴 문제‡¿Problemas en Costa Oscura?‡¿Problemas en Costa Oscura?‡Des problèmes à Sombrivage ?‡黑海岸的麻烦事‡黑海岸的麻煩事',
    nil,
    'Vá até Auberdine e procure sinais da equipe de escavação enânica.‡Отправьтесь в Аубердин и найдите следы дворфийской изыскательской группы.‡Reist nach Auberdine und sucht nach Hinweisen auf das Zwergenausgrabungsteam.‡아우버다인으로 가서 드워프 발굴단의 흔적을 찾아야 합니다.‡Viaja a Auberdine y busca rastros del equipo de excavación enano.‡Viaja a Auberdine y busca rastros del equipo de excavación enano.‡Aller à Auberdine et chercher des indices sur les nains de l\'équipe de fouilles.‡到奥伯丁去寻找矮人挖掘队的线索。‡到奧伯丁去尋找矮人挖掘隊的線索。',
  }
},
[731] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Proteja o Prospector Trilheiro enquanto ele procura o fóssil misterioso, depois fale novamente com a Arqueóloga Hollee em Auberdine.‡Защищайте геолога Сомнамбулера, пока он ищет таинственную окаменелость, а затем вернитесь к археологу Холли в Аубердин.‡Beschützt Ausgrabungsleiter Wirrbart, während er nach dem rätselhaften Fossil sucht, und kehrt dann zur Archäologin Hollee in Auberdine zurück.‡신비로운 화석을 찾는 동안 발굴조사단장 렘트래블을 경호한 후 아우버다인에 있는 고고학자 호올리에게 가야 합니다.‡Protege al prospector Tripirrem mientras busca el fósil misterioso. Luego vuelve a Auberdine y busca a la arqueóloga Hollee.‡Protege al prospector Tripirrem mientras busca el fósil misterioso. Luego vuelve a Auberdine y busca a la arqueóloga Hollee.‡Protéger le Prospecteur Songerrance pendant qu\'il recherche le mystérieux fossile, puis revenir voir l\'Archéologue Hollee à Auberdine.‡在勘察员雷姆塔维尔搜寻神秘化石的时候保护他，然后回到奥伯丁的考古学家霍莉那里。‡在勘察員雷姆塔維爾搜尋神秘化石的時候保護他，然後回到奧伯丁的考古學家霍莉那裡。',
  }
},
[732] = {
  {
    '‡Дрожь земли‡Erdbeben‡대지의 진동‡Terremotos‡Terremotos‡Tremblement de terre‡大地的震颤‡',
    nil,
    '‡Принесите знак земли Гареку.‡Beschafft für Garek das Zeichen der Erde.‡‡Recupera el Signo de la Tierra para Garek.‡Recupera el Signo de la Tierra para Garek.‡Retrouver le Signe de la Terre pour Garek.‡帮加瑞克取回大地印章。‡',
  }
},
[733] = {
  {
    '‡Помогите кто чем может!‡Schnorrerei‡자재 모으기‡¡A gorronear!‡¡A gorronear!‡Demandes variées‡搜集行动‡',
    nil,
    '‡Принесите 7 кусков металлолома Сигруну.‡Bringt Sigrun 7 Teile Metallschrott.‡시그런에게 금속 조각 7개를 가져가야 합니다.‡Consigue 7 restos de armadura para Sigrun.‡Consigue 7 restos de armadura para Sigrun.‡Collecter 7 Morceaux de ferraille pour Sigrun.‡帮西格鲁收集7块金属碎片。‡',
  }
},
[734] = {
  {
    '‡Сложная задача‡Das wird schwierig‡‡Lo tienes crudo‡Lo tienes crudo‡Grandes difficultés‡不祥的感觉‡',
    nil,
    '‡Поговорите с Люсьеном Подай-Ключ в Бесплодных землях.‡Sprecht im Ödland mit Lucien Knobelzang.‡‡Habla con Lucien Borlallave en las Tierras Inhóspitas.‡Habla con Lucien Borlallave en las Tierras Inhóspitas.‡Parler à Lucien Torsaclef dans les Terres ingrates.‡和荒芜之地的卢希恩·枪穗谈一谈。‡',
  }
},
[735] = {
  {
    'A estrela, a mão e o coração‡Звезда, Рука и Сердце‡Der Stern, die Hand und das Herz‡별, 손, 그리고 심장‡La Estrella, la Mano y el Corazón‡La Estrella, la Mano y el Corazón‡L\'étoile, la main et le cœur‡星，手，心‡星，手，心',
    nil,
    'Leve os itens do Bilhete de Agarrosso para ele em Altaforja.‡Доставьте предметы, перечисленные в записке Костохвата, Геррику Костохвату в Стальгорн.‡Bringt Gerrig Knochengriff in Eisenschmiede die Gegenstände in Knochengriffs Notiz.‡아이언포지의 쓸쓸한 뒷골목에 있는 게릭 본그립에게 본그립의 노트에 적힌 물건들을 가져가야 합니다.‡Devuelve los objetos de la nota de Gerrig Agarrahueso a Forjaz.‡Devuelve los objetos de la lista a Gerrig Agarrahueso a Forjaz.‡Rapporter les Objets écrits sur le mot de Poigne-d\'os à Gerrig Poigne-d\'os dans Forgefer.‡找齐葛利·硬骨的便笺上列出的东西，然后把它们交给铁炉堡的葛利·硬骨。‡找齊葛利·硬骨的便箋上列出的東西，然後把它們交給鐵爐堡的葛利·硬骨。',
  }
},
[736] = {
  {
    'A estrela, a mão e o coração‡Звезда, Рука и Сердце‡Der Stern, die Hand und das Herz‡별, 손, 그리고 심장‡La Estrella, la Mano y el Corazón‡La Estrella, la Mano y el Corazón‡L\'étoile, la main et le cœur‡星，手，心‡星，手，心',
    nil,
    'Leve os itens do Bilhete de Bel\'dugur para o Guardião Bel\'dugur na Cidade Baixa.‡Прочитайте записку Бел\'дугура. Принесите перечисленные в записке предметы Бел\'дугуру в  Подгород.‡Bringt dem Bewahrer Bel\'dugur in Unterstadt die Gegenstände von Bel\'dugurs Notiz.‡언더시티에 있는 벨두거에게 벨두거의 노트에 적힌 물건들을 가져가야 합니다.‡Llévale los objetos que aparecen en la nota de Bel\'dugur al vigilante Bel\'dugur de Entrañas.‡Llévale los objetos que aparecen en la nota de Bel\'dugur al vigilante Bel\'dugur de Entrañas.‡Apportez les objets de la liste de Bel\'dugur au Gardien Bel\'dugur à Fossoyeuse.‡把贝尔杜加的便笺上列出的东西带给幽暗城的看守者贝尔杜加。‡把貝爾杜加的便箋上列出的東西帶給幽暗城的看守者貝爾杜加。',
  }
},
[737] = {
  {
    'Conhecimento proibido‡Запретное знание‡Verbotenes Wissen‡‡El saber prohibido‡El saber prohibido‡Le savoir perdu‡禁断的知识‡禁斷的知識',
    nil,
    'Leve o Compêndio de Yagyin para Theldurin.‡Отнесите книгу Йагина Тельдарину.‡Bringt Theldurin \'Yagyins Zusammenstellung\'.‡‡Llévale el compendio de Yagyin a Theldurin.‡Llévale el compendio de Yagyin a Theldurin.‡Apportez l\'Abrégé de Yagyin à Theldurin.‡把雅格因的笔记交给塞尔杜林。‡把雅格因的筆記交給塞爾杜林。',
  }
},
[738] = {
  {
    'Encontre Agmundo‡Найти Эгмонда‡Sucht Agmond‡아그몬드 찾기‡Encontrar a Agmond‡Encontrar a Agmond‡Trouver Agmond‡寻找阿戈莫德‡尋找埃格蒙德',
    nil,
    'Encontre Agmundo.‡Найдите Эгмонда.‡Sucht Agmond.‡아그몬드를 찾아야 합니다.‡Encuentra a Agmond.‡Encuentra a Agmond.‡Trouver Agmond.‡找到阿戈莫德。‡找到埃格蒙德。',
  }
},
[739] = {
  {
    'Murdaloc‡Мурдалок‡Murdaloc‡멀달록‡Murdaloc‡Murdaloc‡Murdaloc‡莫达洛克‡莫達洛克',
    nil,
    'Mate Murdaloc, o assassino de Agmundo.|n|nMate 12 Quebraossos da Abóbada de Pedra.|n|nApresente-se ao Prospector Bandaferro em Loch Modan.‡Уничтожьте убийцу Эгмонда, Мурдалока. |n|nУбейте 12 костегрызов из племени Каменного Свода. |n|nСообщите геологу Сталекруту в Лок Модане обо всем, что произошло.‡Tötet Agmonds Mörder Murdaloc.|n|nTötet 12 Knochenknacker der Steingrufttroggs.|n|nErstattet Ausgrabungsleiter Eisenband am Loch Modan Bericht.‡아그몬드를 살해한 멀달록을 처치해야 합니다.|n|n바위동굴 뼈다귀싸움꾼 12마리를 처치해야 합니다.|n|n그 후 모단 호수에 있는 발굴조사단장 아이언밴드에게 보고하십시오.‡Mata al asesino de Agmond, Murdaloc.|n|nMata a 12 Cascahuesos Grutacanto.|n|nPreséntate ante el prospector Vetaferro en Loch Modan.‡Mata al asesino de Agmond, Murdaloc.|n|nMata a 12 Cascahuesos Petracripta.|n|nPreséntate ante el prospector Vetaferro en Loch Modan.‡Tuer l\'assassin d\'Agmond : Murdaloc.|n|nTuer 12 Briseurs d\'os Cavepierre.|n|nEt revenir voir le Prospecteur Baguefer au Loch Modan.‡干掉杀害阿戈莫德的凶手：莫达洛克。|n|n顺便杀掉12个石窟断骨者。|n|n然后向洛克莫丹的勘察员基恩萨·铁环报告。‡幹掉殺害埃格蒙德的兇手:莫達洛克。|n|n順便殺掉12個石窟斷骨者。|n|n然後向洛克莫丹的勘察員基恩薩·鐵環報告。',
  }
},
[741] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Leve o fóssil misterioso ao Arqueólogo-chefe Suiçagris em Darnassus.‡Отвезите таинственную окаменелость главному археологу Седоусу в Дарнас.‡Bringt dem Chefarchäologen Grauflaum in Darnassus das rätselhafte Fossil.‡다르나서스에 있는 수석고고학자 그레이위스커에게 신비로운 화석을 가져가야 합니다.‡Ve a Darnassus y entrega el fósil misterioso al arqueólogo jefe Mostachogris.‡Ve a Darnassus y entrega el fósil misterioso al arqueólogo jefe Mostachogris.‡Apporter le Mystérieux fossile au Chef archéologue Grisemoustache, à Darnassus.‡把神秘的化石交给达纳苏斯的首席考古学家杜瑟·灰胡。‡把神秘的化石交給達納蘇斯的首席考古學家杜瑟·灰鬚。',
  }
},
[742] = {
  {
    'A caçada do Vale Gris‡Большая охота‡Die Jagd im Eschental‡잿빛 골짜기 사냥 대회‡La Caza de Vallefresno‡La Caza de Vallefresno‡La Chasse d\'Orneval‡灰谷狩猎‡梣谷狩獵',
    nil,
    'Fale com Senani Coração Trovejante no Posto Machadada, que fica no Vale Gris.‡Поговорите с Сенани Громовое Сердце на заставе Расщепленного Дерева в Ясеневом лесу.‡Sprecht mit Senani Donnerherz im Splitterholzposten im Eschental.‡잿빛 골짜기의 토막나무 주둔지에 있는 세나니 썬더하트와 대화해야 합니다.‡Habla con Senani Corazón Atronador en Puesto del Hachazo, en Vallefresno.‡Habla con Senani Corazón Atronador en Puesto del Hachazo, en Vallefresno.‡Parler à Senani Cœur-de-tonnerre, au Poste de Bois-Brisé, en Orneval.‡与灰谷碎木哨岗的塞娜尼·雷心谈一谈。‡與梣谷碎木崗哨的塞娜尼·雷心談話。',
  }
},
[743] = {
  {
    'Perigos das Ventofúria‡Соседство со стаей Неистовства Ветра‡Windfuriengefahr‡성난바람 하피의 위협‡Las Viento Furioso son un peligro‡Las Viento Furioso son un peligro‡Le danger des Furies-des-vents‡风怒鹰身人‡風怒鷹身人',
    nil,
    'Leve 8 Garras de Ventofúria para Ruul Garra da Águia na Aldeia Casco Sangrento.‡Принесите 8 когтей гарпий из стаи Ярости Ветра Руулу Орлиному Когтю в деревню Кровавого Копыта.‡Bringt Ruul Adlerklaue im Dorf der Bluthufe 8 Windfurienkrallen.‡블러드후프 마을에 있는 루울 이글탈론에게 성난바람 하피의 갈퀴발톱 8개를 가져가야 합니다.‡Lleva 8 garfas de Viento Furioso a Ruul Garra de Águila al Poblado Pezuña de Sangre.‡Lleva 8 garfas de Viento Furioso a Ruul Garra de Águila al Poblado Pezuña de Sangre.‡Apporter 8 Serres de Furie-des-vents à Ruul Serre-d\'aigle, à Sabot-de-sang.‡给血蹄村的卢尔·鹰爪带回8只风怒鹰身人的爪子。‡給血蹄村的盧爾·鷹爪帶回8隻風怒鷹身人的爪子。',
  }
},
[744] = {
  {
    'Os preparativos da cerimônia‡Подготовка к церемонии‡Vorbereitungen auf die Zeremonie‡의식을 위한 준비‡Preparación para la ceremonia‡Preparación para la ceremonia‡Préparation à la cérémonie‡准备典礼‡準備典禮',
    nil,
    'Colete 6 Penas Lazúli e 6 Penas Bronze.‡Добудьте 6 лазурных перьев и 6 бронзовых перьев.‡Sammelt 6 azurblaue und 6 bronzene Federn.‡하늘색 깃털 6개와 청동색 깃털 6개를 모아야 합니다.‡Consigue 6 plumas azur y 6 de bronce.‡Consigue 6 plumas azur y 6 de bronce.‡Collectez 6 Plumes d\'azur et 6 Plumes de bronze.‡收集6根碧蓝色的羽毛和6根古铜色的羽毛。‡收集6根蒼藍色的羽毛和6根古銅色的羽毛。',
  }
},
[745] = {
  {
    'Dividindo a terra‡Недобрые соседи‡Gemeinsame Nutzung des Landes‡대지의 공유‡Compartir la tierra‡Compartir la tierra‡Partager la terre‡土地之争‡土地之爭',
    nil,
    'Mate 10 Coureiros Jubalba, 8 Esfoladores Jubalba, e 5 Larápios Jubalba, então fale novamente com Baine Casco Sangrento na Aldeia Casco Sangrento.‡Убейте 10 дубильщиков, 8 шкуродеров и 5 браконьеров из стаи Бледногривов и возвращайтесь к Бейну Кровавому Копыту в деревню Кровавого Копыта.‡Tötet 10 Gerber der Bleichmähnen, 8 Kürschner der Bleichmähnen und 5 Wilderer der Bleichmähnen und kehrt dann zu Baine Bluthuf ins Dorf der Bluthufe zurück.‡회색갈기 무두장이 10마리와 회색갈기 가죽장이 8마리, 회색갈기 밀렵꾼 5마리를 처치한 다음 블러드후프 마을에 있는 바인 블러드후프에게 가야 합니다.‡Mata a 10 peleteros, 8 desolladores y 5 furtivos Crines Pálidos y vuelve al Poblado Pezuña de Sangre para hablar con Baine Pezuña de Sangre.‡Mata a 10 curtidores, 8 desolladores y 5 furtivos Crines Pálidas y vuelve al Poblado Pezuña de Sangre para hablar con Baine Pezuña de Sangre.‡Tuez 10 Tanneurs crins-pâles, 8 Ecorcheurs crins-pâles et 5 Braconniers crins-pâles, puis retournez voir Baine Sabot-de-Sang, à Sabot-de-Sang.‡杀死10个白鬃制革工、8个白鬃剥皮工和5个白鬃偷猎者，然后回到血蹄村向贝恩·血蹄复命。‡殺死10個白鬃製革工、8個白鬃剝皮工和5個白鬃偷獵者，然後回到血蹄村向貝恩·血蹄覆命。',
  }
},
[746] = {
  {
    'Escavação enânica‡Дворфийские делишки‡Zwergenbuddelei‡드워프 발굴지‡Una excavación de los enanos‡Una excavación de los enanos‡Les fouilles des nains‡矮人的挖掘场‡矮人的挖掘場',
    nil,
    'Recolha 5 Picaretas do Prospector.|n|nEm uma forja, esmague as Picaretas do Prospector para criar Ferramentas Quebradas.|n|nLeve 5 Ferramentas Quebradas para Baine Casco Sangrento na Aldeia Casco Sangrento.‡Соберите 5 кирок геолога.|n|nСломайте их в кузнице. |n|nОтнесите 5 сломанных инструментов Бейну Кровавому Копыту в деревню Кровавого Копыта.‡Sammelt 5 Ausgrabungsleiterhacken ein.|n|nZerschlagt die Ausgrabungsleiterhacken in einer Schmiede, um zerbrochene Werkzeuge zu erhalten.|n|nBringt Baine Bluthuf im Dorf der Bluthufe 5 zerbrochene Werkzeuge.‡발굴조사단장의 곡괭이 5개를 모아야 합니다.|n|n가열로에서 발굴조사단장의 곡괭이를 부러진 곡괭이로 만들어야 합니다.|n|n블러드후프 마을에 있는 바인 블러드후프에게 부러진 곡괭이 5개를 가져가야 합니다.‡Recoge 5 picos de prospector. |n|nBusca una forja para destrozar los picos. |n|nLleva 5 herramientas rotas a Baine Pezuña de Sangre al Poblado Pezuña de Sangre.‡Recoge 5 picos de prospector. |n|nBusca una forja para destrozar los picos. |n|nLleva 5 trozos de herramienta rota a Baine Pezuña de Sangre al Poblado Pezuña de Sangre.‡Collectez 5 Piolets de prospecteur.|n|nÀ la forge, brisez les Piolets de prospecteur pour obtenir des Outils cassés.|n|nRapportez 5 Outils cassés à Baine Sabot-de-Sang, à Sabot-de-Sang.‡收集5个勘察员的锄头。|n|n在铁匠铺砸碎这些勘察员的锄头。|n|n把5件损坏的工具交给血蹄村的贝恩·血蹄。‡收集5個勘察員的十字鎬。|n|n在熔爐砸爛這些勘察員的十字鎬以製造損壞的工具。|n|n將5個損壞的工具交給血蹄村的貝恩·血蹄。',
  }
},
[747] = {
  {
    'A caçada começa‡Охота начинается‡Die Jagd beginnt‡사냥의 시작‡Empieza la caza‡Empieza la caza‡La chasse commence‡开始狩猎‡開始狩獵',
    nil,
    'Grull Vento do Falcão na Aldeia Narache quer que você lhe traga 7 Penas de Pinote e 7 pedaços de Carne de Pinote.‡Принесите 7 перьев равнинных долгоногов и 7 кусков мяса равнинных долгоногов Груллу Соколиному Ветру в Лагерь Нараче.‡Grull Falkenwind im Camp Narache möchte, dass Ihr ihm 7 Ebenenschreiterfedern und 7 Stücke Ebenenschreiterfleisch bringt.‡나라체 야영지에 있는 그룰 호크윈드가 초원타조 깃털 7개와 초원타조 고기 7덩이를 가져다 달라고 했습니다.‡Grull Viento de Halcón quiere que le lleves 7 plumas y 7 piezas de carne de zancudo de llanura al Campamento Narache.‡Grull Viento de Halcón quiere que le lleves 7 plumas y 7 piezas de carne de zancudo de llanura al Campamento Narache.‡Grull Vent-du-faucon, du Camp Narache, voudrait que vous lui apportiez 7 Plumes de trotteurs des plaines et 7 morceaux de Viande de trotteur des plaines.‡纳拉其营地的格鲁尔·鹰风要求你带给他7片平原陆行鸟的羽毛和7块平原陆行鸟肉。‡納拉其營地的格盧爾·鷹風要求你帶給他7根平原陸行鳥的羽毛和7塊平原陸行鳥肉。',
  }
},
[748] = {
  {
    'Água venenosa‡Отравленная вода‡Vergiftetes Wasser‡오염된 우물‡Pozos envenenados‡Pozos envenenados‡L\'eau empoisonnée‡毒水‡毒水',
    nil,
    'Leve 6 Patas de Lobos-da-pradaria e 4 Garras de Pinotes para Mull Chifre Troante em Casco Sangrento.‡Принесите 6 лап волков прерий и 4 когтя равнинного долгонога Муллу Громовому Рогу в деревню Кровавого Копыта.‡Bringt Mull Donnerhorn im Dorf der Bluthufe 6 Präriewolftatzen und 4 Ebenenschreiterkrallen.‡블러드후프에 있는 멀 썬더혼에게 초원늑대 앞발 6개와 초원타조 갈퀴발톱 4개를 가져가야 합니다.‡Lleva 6 garras de lobo de pradera y 4 garfas de zancudo de llanura a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Lleva 6 zarpas de lobo de pradera y 4 garfas de zancudo de llanura a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Apporter 6 Pattes de loup des prairies et 4 Serres de trotteur des plaines à Mull Corne-Tonnerre à Sabot-de-Sang.‡收集6只草原狼的爪子和4只平原陆行鸟的爪子，把它们交给血蹄村的穆尔·雷角。‡收集6隻草原狼的爪子和4隻平原陸行鳥的爪子，把它們交給血蹄村的莫爾·雷角。',
  }
},
[749] = {
  {
    'A caravana devastada‡Разграбленный караван‡Die Überfallene Karawane‡습격당한 짐마차 행렬‡La Caravana Devastada‡La Caravana Devastada‡La caravane dévastée‡被破坏的货车‡被破壞的貨車',
    nil,
    'Morin Espreita Nuvem quer que você examine o conteúdo de uma caixa de suprimentos na Caravana Devastada.‡Морин Ловец Облаков попросил вас изучить содержимое ящиков с припасами в разграбленном караване.‡Morin Wolkenpirscher möchte, dass Ihr den Inhalt einer Nachschubkiste der Überfallenen Karawane untersucht.‡모린 클라우드스토커가 습격당한 짐마차 행렬에 실려 있는 보급품 상자의 내용물을 확인해 달라고 했습니다.‡Morin Acechanubes quiere que registres las cajas de la Caravana Devastada.‡Morin Acechanubes quiere que registres las cajas de la Caravana Devastada.‡Examiner le contenu d\'une caisse de provisions à la caravane dévastée, pour Morin Traqueur-de-nuage.‡摩林·云行者要你去查看被破坏的货车附近的储备箱里有什么东西。‡摩林·雲巡者要你去查看被破壞的貨車附近的補給木箱裡有什麼東西。',
  }
},
[750] = {
  {
    'A caçada continua‡Охота продолжается‡Die Jagd geht weiter‡계속되는 사냥‡La caza sigue‡La caza sigue‡La chasse continue‡继续狩猎‡繼續狩獵',
    nil,
    'Grull Vento do Falcão na Aldeia Narache quer que você lhe traga 10 Pelagens de Puma da Montanha.‡Принесите 10 шкур горных пум Груллу Соколиному Ветру.‡Grull Falkenwind im Camp Narache möchte, dass Ihr ihm 10 Bergpumapelze bringt.‡나라체 야영지의 그룰 호크윈드가 산지퓨마 모피 10필을 가져다 달라고 했습니다.‡Grull Viento de Halcón quiere que le lleves 10 pelambres de puma montés al Campamento Narache.‡Grull Viento de Halcón quiere que le lleves 10 pelambres de puma montés al Campamento Narache.‡Grull Vent-du-faucon, du Camp Narache, voudrait que vous lui apportiez 10 Peaux de puma des montagnes.‡纳拉其营地的格鲁尔·鹰风要求你带给他10张山狮皮。‡納拉其營地的格盧爾·鷹風要求你帶給他10張山獅皮。',
  }
},
[751] = {
  {
    'A caravana devastada‡Разграбленный караван‡Die Überfallene Karawane‡습격당한 짐마차 행렬‡La Caravana Devastada‡La Caravana Devastada‡La caravane dévastée‡被破坏的货车‡被破壞的貨車',
    nil,
    'Entregue os Documentos da Empreendimentos S.A. para Morin Espreita Nuvem perto da Aldeia Casco Sangrento.‡Отнесите бумаги Торговой Компании Морину Ловцу Облаков, которого можно найти неподалеку от деревни Кровавого Копыта.‡Bringt Morin Wolkenpirscher in der Nähe des Dorfs der Bluthufe die Dokumente der Venture Company.‡블러드후프 마을 근처에 있는 모린 클라우드스토커에게 투자개발회사의 문서를 가져가야 합니다.‡Lleva los documentos de Ventura y Cía. a Morin Acechanubes cerca del Poblado Pezuña de Sangre.‡Lleva los documentos de Ventura y Cía. a Morin Acechanubes cerca del Poblado Pezuña de Sangre.‡Rapporter les Documents de la KapitalRisk à Morin Traqueur-de-Nuage, à côté de Sabot-de-Sang.‡把风险投资公司文件交给血蹄村附近的摩林·云行者。‡把風險投資公司文件交給血蹄村附近的摩林‧雲巡者。',
  }
},
[752] = {
  {
    'Uma humilde tarefa‡ Скромная просьба‡Eine bescheidene Bitte‡작은 부탁‡Una humilde contribución‡Una humilde contribución‡Une humble contribution‡一件琐事‡一件瑣事',
    nil,
    'Chefe Vento do Falcão quer que você procure a mãe dele perto do poço a sudeste da Aldeia Narache.‡Поищите матушку вождя Соколиный Ветер у источника к юго-востоку от Лагеря Нараче.‡Häuptling Falkenwind möchte, dass Ihr seine Mutter beim Brunnen südöstlich vom Camp Narache sucht.‡족장 호크윈드가 나라체 야영지 남동쪽에 있는 우물 근처에서 그의 어머니를 찾아봐 달라고 했습니다.‡El Jefe Viento de Halcón quiere que vayas a buscar a su madre cerca del pozo que hay al sureste del Campamento Narache.‡El Jefe Viento de Halcón quiere que vayas a buscar a su madre cerca del pozo que hay al sureste del Campamento Narache.‡Partir chercher la mère du Chef Vent-du-faucon, près du puits, au sud-est de Camp Narache.‡鹰风酋长要求你去纳拉其营地东南方的水井处寻找他的母亲。‡鷹風酋長要求你去納拉其營地東南方的水井處尋找他的母親。',
  }
},
[753] = {
  {
    'Uma humilde tarefa‡Скромная просьба‡Eine bescheidene Bitte‡작은 부탁‡Una humilde contribución‡Una humilde contribución‡Une humble contribution‡一件琐事‡一件瑣事',
    nil,
    'Pegue uma Jarra d\'Água do poço.|n|nLeve a Jarra para o Chefe Vento do Falcão na Aldeia Narache, que fica a noroeste do poço.‡Наберите кувшин воды из колодца.|n|nОтнесите кувшин вождю Соколиному Ветру в Лагерь Нараче, который находится к северо-западу от источника.‡Holt eine Wasserkanne vom Brunnen.|n|nBringt die Kanne zu Häuptling Falkenwind im Camp Narache, das nordwestlich des Brunnens liegt.‡우물에 있는 물병을 집어서 우물에서 북서쪽에 있는 나라체 야영지의 족장 호크윈드에게 가져가야 합니다.‡Llena una jarra de agua en el pozo.|n|nLlévasela al Jefe Vientaguilar al Campamento Narache, que está al noroeste del pozo.‡Llena un cántaro de agua en el pozo. |n|nLlévaselo al Jefe Viento de Halcón al Campamento Narache, que está al noroeste del pozo.‡Prendre une Cruche d\'eau du puits.|n|nApporter la cruche au Chef Vent-du-faucon au Camp Narache, qui se trouve au nord-ouest du puits.‡在井边拿一只水罐。|n|n把它带给纳拉其营地里的鹰风酋长。‡在井邊拿一隻水罐。|n|n把它帶給納拉其營地裡的鷹風酋長。',
  }
},
[754] = {
  {
    'A purificação de Casco Invernal‡Очищение колодца Заиндевевшего Копыта‡Winterhufsäuberung‡윈터후프 정화‡La purificación de Pezuña Invernal‡La purificación de Pezuña Invernal‡La purification de Sabot-d\'hiver‡净化冰蹄之井‡淨化冬蹄之井',
    nil,
    'Use o Totem de Purificação Casco Invernal no Poço Casco Invernal, então fale novamente com Mull Chifre Troante.‡Очистите колодец Заиндевевшего Копыта с помощью тотема очищения и возвращайтесь к Муллу Громовому Рогу.‡Benutzt das Läuterungstotem der Winterhufe beim Brunnen der Winterhufe und kehrt dann zu Mull Donnerhorn zurück.‡윈터후프 우물에서 윈터후프 정화 토템을 사용한 후 멀 썬더혼에게 가야 합니다.‡Usa el tótem de limpieza en el Pozo Pezuña Invernal y ve a ver a Mull Tronacuerno.‡Usa el tótem de limpieza en el Pozo Pezuña Invernal y ve a ver a Mull Tronacuerno.‡Utiliser le Totem de purification de Sabot-d\'hiver au puits Sabot-d\'hiver, puis retourner voir Mull Corne-tonnerre.‡用冰蹄之井净化图腾为冰蹄之井完成净化，然后回来见穆尔·雷角。‡用冬蹄之井淨化圖騰為冬蹄之井完成淨化，然後回來見莫爾·雷角。',
  }
},
[755] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les rites de la Terre-mère‡大地之母仪祭‡大地之母祭儀',
    nil,
    'Vá ao Vidente Grislíngua que mora nas colinas ao sul da Aldeia Narache.‡Отправьтесь к провидцу Серой Пасти, который живет к югу от Лагеря Нараче.‡Begebt Euch zu Seher Grauzunge, der in den Hügeln direkt südlich von Camp Narache lebt.‡나라체 야영지 정남쪽에 있는 언덕에 사는 예언자 그레이텅을 찾아가야 합니다.‡Ve a ver al vidente Lenguagris, que vive en las colinas al sur del Campamento Narache.‡Ve a ver al vidente Lenguagris, que vive en las colinas al sur del Campamento Narache.‡Aller voir le voyant Langue-grise qui vit dans les collines au sud de Camp Narache.‡找到居住在纳拉其营地正南方山中的灰舌先知。‡找到居住在納拉其營地正南方山中的灰舌先知。',
  }
},
[756] = {
  {
    'Totem de Chifre Troante‡Тотем Громового Рога‡Totem der Donnerhörner‡썬더혼 토템‡El tótem de Tronacuerno‡El tótem de Tronacuerno‡Le totem de Corne-tonnerre‡雷角图腾‡雷角圖騰',
    nil,
    'Leve 6 Garras de Espreitador e 6 Garras de Puma para Mull Chifre Troante.‡Принесите 6 когтей охотников прерий и 6 когтей пум плоскогорья Муллу Громовому Рогу.‡Bringt Mull Donnerhorn 6 Pirscherklauen und 6 Pumaklauen.‡멀 썬더혼에게 긴발톱 초원늑대 발톱 6개와 평원퓨마 발톱 6개를 가져가야 합니다.‡Lleva 6 garras de acechador y 6 garras de puma a Mull Tronacuerno.‡Lleva 6 garras de acechador y 6 garras de puma a Mull Tronacuerno.‡Rapporter 6 Griffes de Traqueur et 6 Griffes de puma à Mull Corne-tonnerre.‡收集6个草原捕食者的爪子和6个平原狮的爪子，把它们带给穆尔·雷角。‡收集6個草原捕食者的爪子和6個平原獅的爪子，把它們帶給莫爾·雷角。',
  }
},
[757] = {
  {
    'Rito de força‡Обряд силы‡Ritus der Kraft‡힘의 의식‡Rito de la fuerza‡Rito de la fuerza‡Le rite de force‡力量仪祭‡力量祭儀',
    nil,
    'Kill Bristlebacks in Brambleblade Ravine and bring 12 Bristleback Belts to Chief Hawkwind in Camp Narache.‡Убивайте дыбогривов в Ежевичной лощине и принесите 12 их поясов вождю Соколиному Ветру в Лагерь Нараче.‡Tötet die Borstennacken in der Dornrankenklamm und bringt Häuptling Falkenwind im Camp Narache 12 Gürtel der Borstennacken.‡칼날가시 협곡에 있는 뾰족털 일족을 처치하고 나라체 야영지에 있는 족장 호크윈드에게 뾰족털 허리띠 12개를 가져가야 합니다.‡Mata a varios Erizapúas en el Barranco Cortazarza y lleva 12 cinturones Erizapúas al Jefe Viento de Halcón al Campamento Narache.‡Mata a varios Erizapúas en el Barranco Cortazarza y lleva 12 cinturones Erizapúas al Jefe Viento de Halcón al Campamento Narache.‡Tuer des Dos-hirsutes dans le Ravin de Roncelame et apporter 12 Ceintures de Dos-hirsute au chef Vent-du-faucon au camp Narache.‡杀掉刺刃峡谷的刺背野猪人并带回12条刺背腰带，把它们交给纳拉其营地的鹰风酋长。‡殺掉刺刃峽谷的刺背野豬人並帶回12條刺背腰帶，把它們交給納拉其營地的鷹風酋長。',
  }
},
[758] = {
  {
    'Purificação de Chifre Troante‡Очищение колодца Громового Рога‡Donnerhornsäuberung‡썬더혼 정화‡La purificación de Tronacuerno‡La purificación de Tronacuerno‡La purification de Corne-tonnerre‡净化雷角之井‡淨化雷角之井',
    nil,
    'Use o Totem de Purificação Chifre Troante no Poço Chifre Troante, então fale novamente com Mull.‡Очистите колодец Громового Рога на севере от деревни с помощью тотема очищения и возвращайтесь к Муллу Громовому Рогу.‡Benutzt das Läuterungstotem der Donnerhörner beim Brunnen der Donnerhörner und kehrt dann zu Mull zurück.‡썬더혼 우물에서 썬더혼 정화 토템을 사용한 다음 멀 썬더혼에게 가야 합니다.‡Usa el tótem de limpieza en el Pozo Tronacuerno y ve a ver a Mull Tronacuerno.‡Usa el tótem de limpieza en el Pozo Tronacuerno y ve a ver a Mull Tronacuerno.‡Utilisez le Totem de purification de Corne-tonnerre au puits Corne-tonnerre, puis retournez voir Mull.‡在雷角之井使用雷角之井净化图腾，然后回来见穆尔。‡在雷角之井使用雷角之井淨化圖騰，然後回來見莫爾。',
  }
},
[759] = {
  {
    'Totem de Juba Agreste‡Тотем Буйногривых‡Totem der Wildmähnen‡와일드메인 토템‡El tótem Bravacrín‡El tótem Ferocrín‡Le totem de Crin-sauvage‡蛮鬃图腾‡蠻鬃圖騰',
    nil,
    'Leve 8 Dentes de Lobos-da-pradaria alfas para Mull Chifre Troante na Aldeia Casco Sangrento.‡Отнесите 8 зубов могучего волка прерий Муллу Громовому Рогу в деревню Кровавого Копыта.‡Bringt Mull Donnerhorn im Dorf der Bluthufe 8 Präriealphazähne.‡블러드후프 마을에 있는 멀 썬더혼에게 우두머리 초원늑대 이빨 8개를 가져가야 합니다.‡Lleva 8 dientes de alfa de pradera a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Lleva 8 dientes de alfa de pradera a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Apporter 8 Dents de loup alpha des prairies à Mull Corne-Tonnerre, à Sabot-de-Sang.‡收集8颗草原狼前锋的牙齿，把它们交给血蹄村的穆尔·雷角。‡收集8顆草原狼前鋒的牙齒，把它們交給血蹄村的莫爾·雷角。',
  }
},
[760] = {
  {
    'Purificação de Juba Agreste‡Очищение колодца Буйногривых‡Wildmähnensäuberung‡와일드메인 정화‡La purificación de Bravacrín‡La purificación de Ferocrín‡La purification de Crin-sauvage‡净化蛮鬃之井‡淨化蠻鬃之井',
    nil,
    'Use the Wildmane Cleansing Totem at the Wildmane Water Well.‡Очистите колодец Буйногривых с помощью тотема очищения колодца Буйногривых.‡Benutzt das Läuterungstotem der Wildmähnen beim Brunnen der Wildmähnen.‡와일드메인 우물에서 와일드메인 정화 토템을 사용해야 합니다.‡Usa el tótem de limpieza Ferocrín en el Pozo Ferocrín.‡Usa el tótem de limpieza Ferocrín en el Pozo Ferocrín.‡Utiliser le Totem de purification de Crin-sauvage au puits Crin-sauvage.‡在蛮鬃之井使用蛮鬃之井净化图腾，然后回来见穆尔·雷角。‡在蠻鬃之井使用蠻鬃之井淨化圖騰，然後回來見莫爾·雷角。',
  }
},
[761] = {
  {
    'Caçada ao rapineiro‡Охота на перепелятников‡Sturzfliegerjagd‡검독수리 사냥‡La caza de los aguilones‡La caza de los aguilones‡Chasse aux rapaces‡猎捕猛鹫‡獵捕猛鷲',
    nil,
    'Leve 8 Troféus de Cálamo de Rapineiro para Harken Totem do Vento na Aldeia Casco Sangrento.‡Принесите 8 трофейных перьев перепелятника Харкену Тотему Ветра в деревне Кровавого Копыта.‡Bringt Harken Windtotem im Dorf der Bluthufe 8 Trophäensturzfliegerkiele.‡블러드후프 마을에 있는 하큰 윈드토템에게 검독수리 깃털 8개를 가져가야 합니다.‡Lleva 8 péñolas trofeo de aguilón a Harken Tótem de Viento al Poblado Pezuña de Sangre.‡Lleva 8 péñolas trofeo de aguilón a Harken Tótem de Viento al Poblado Pezuña de Sangre.‡Apporter 8 Trophées de plumes de Rapace à Harken Totem-de-vent, à Sabot-de-Sang.‡收集8根猛鹫的羽毛，把它们带给血蹄村的哈肯·风之图腾。‡收集8根猛鷲的羽毛，把它們帶給血蹄村的哈肯·風之圖騰。',
  }
},
[762] = {
  {
    '‡Посланник зла‡Ein Botschafter des Bösen‡악의 사자‡Un embajador del mal‡Un embajador del mal‡Un ambassadeur du mal‡邪恶的使者‡邪惡的使者',
    nil,
    '‡Убейте посла Инфернуса в Крепости Ангор и принесите доказательство его смерти советнику Белграму в Стальгорн.‡Tötet den Botschafter Infernus in der Festung Angor und bringt Berater Belgrum in Eisenschmiede einen Beweis, der bestätigt, dass der Botschafter tot ist.‡고통의 요새에 있는 사자 인페르누스를 처치하고 아이언포지에 있는 조언자 벨그룸에게 그의 죽음에 대한 증거를 가져가야 합니다.‡Mata al embajador Infernus en la Fortaleza de Angor y llévale la prueba de su muerte al consejero Belgrum en Forjaz.‡Mata al embajador Infernus en la Fortaleza de Angor y llévale la prueba de su muerte al consejero Belgrum en Forjaz.‡Tuer l\'Ambassadeur Infernus dans la Forteresse d\'Angor et apporter la preuve de sa mort au Conseiller Belgrum à Forgefer.‡杀死苦痛堡垒中的因弗努斯大使，把证明他已死亡的信物交给铁炉堡的顾问贝尔格拉姆。‡殺死苦痛堡壘中的因弗努斯大使，把證明他已死亡的信物交給鐵爐堡的顧問貝爾格拉姆。',
  }
},
[763] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les rites de la Terre-mère‡大地之母仪祭‡大地之母祭儀',
    nil,
    'Leve o Totem do Vento do Falcão para Baine Casco Sangrento, na Aldeia Casco Sangrento. Siga a estrada que sai da Aldeia Narache.‡Отнесите тотем Соколиного Ветра Бейну Кровавому Копыту в деревню Кровавого Копыта. Следуйте по дороге из Лагеря Нараче.‡Bringt Baine Bluthuf im Dorf der Bluthufe Falkenwinds Totem. Folgt der Straße, die aus dem Camp Narache herausführt.‡블러드후프 마을에 있는 바인 블러드후프에게 호크윈드의 토템을 가져가야 합니다. 나라체 야영지 외곽의 길을 따라가십시오.‡Lleva el tótem de Vientaguilar a Baine Pezuña de Sangre al Poblado Pezuña de Sangre. Sigue el camino que sale del Campamento Narache.‡Lleva el tótem de Alalcón a Baine Pezuña de Sangre al Poblado Pezuña de Sangre. Sigue el camino que sale del Campamento Narache.‡Apporter le Totem de Vent-du-faucon à Baine Sabot-de-Sang à Sabot-de-Sang. Suivre la route hors du camp Narache.‡顺着离开纳拉其营地的路将鹰风图腾带给血蹄村的贝恩·血蹄。‡順著離開納拉其營地的路將鷹風圖騰帶給血蹄村的貝恩·血蹄。',
  }
},
[764] = {
  {
    'Empreendimentos S.A.‡Торговая Компания‡Die Venture Company‡투자개발회사‡Los Ventura y Cía.‡Los Ventura y Cía.‡La KapitalRisk‡风险投资公司‡風險投資公司',
    nil,
    'Mate 14 Trabalhadores da Empreendimentos S.A. e 6 Supervisores da Empreendimentos S.A. para Morin Espreita Nuvem na Aldeia Casco Sangrento.‡Убейте 14 рабочих Торговой Компании и 6 бригадиров Торговой Компании по поручению Морина Ловца Облаков из деревни Кровавого Копыта.‡Tötet für Morin Wolkenpirscher in der Nähe des Dorfs der Bluthufe 14 Tagelöhner der Venture Co. und 6 Vorsteher der Venture Co.‡블러드후프 마을에 있는 모린 클라우드스토커를 위해 투자개발회사 노역꾼 14명과 투자개발회사 현장감독 6명을 처치해야 합니다.‡Mata a 14 trabajadores de Ventura y Cía. y a 6 supervisores de Ventura y Cía. para Morin Acechanubes en Poblado Pezuña de Sangre.‡Mata a 14 trabajadores de Ventura y Cía. y a 6 supervisores de Ventura y Cía. para Morin Acechanubes en Poblado Pezuña de Sangre.‡Tuer 14 Travailleurs de la KapitalRisk et 6 Superviseurs de la KapitalRisk pour Morin Traqueur-de-Nuage de Sabot-de-Sang.‡血蹄村的摩林·云行者要你去杀死14个风险投资公司工人和6个风险投资公司主官。‡血蹄村的摩林·雲巡者要你去殺死14個風險投資公司工人和6個風險投資公司主官。',
  }
},
[765] = {
  {
    'Supervisor Geringonça‡Бригадир Шумовик‡Vorsteher Zischelspross‡감독관 피즈스프로켓‡Supervisor Saltatuercas‡Supervisor Saltatuercas‡Le superviseur Vibrouage‡菲兹普罗克主管‡菲茲普羅克主管',
    nil,
    'Mate o Supervisor Geringonça e leve sua prancheta para Morin Espreita Nuvem na Aldeia Casco Sangrento.‡Убейте бригадира Шумовика и принесите его планшет Морину Ловцу Облаков в деревню Кровавого Копыта.‡Tötet Vorsteher Zischelspross und bringt Morin Wolkenpirscher in der Nähe des Dorfs der Bluthufe dessen Klemmbrett.‡감독관 피즈스프로켓을 처치하고 블러드후프 마을의 모린 클라우드스토커에게 피즈스프로켓의 서류철을 가져가야 합니다.‡Mata al supervisor Saltatuercas y lleva su sujetapapeles a Morin Acechanubes al Poblado Pezuña de Sangre.‡Mata al supervisor Saltatuercas y lleva su sujetapapeles a Morin Acechanubes al Poblado Pezuña de Sangre.‡Tuer le Superviseur Vibrouage et rapporter son Écritoire à Morin Traqueur-de-Nuage, à Sabot-de-Sang.‡杀掉菲兹普罗克主管，把他的笔记板带给血蹄村的摩林·云行者。‡殺掉菲茲普羅克主管，把他的筆記板帶給血蹄村的摩林·雲巡者。',
  }
},
[766] = {
  {
    'Mazzranache‡Маззранач‡Mazzranach‡마즈라나체‡Mazzranache‡Mazzranache‡Mazzranache‡马兹拉纳其‡馬茲拉納其',
    nil,
    'Leve um Coração de Lobo-da-pradaria, um Fêmur de Puma das Estepes, uma Escama de Pinote e uma Moela de Rapineiro para Maur Clamachuva na Aldeia Casco Sangrento.‡Принесите сердце койота, бедренную кость пумы плоскогорья, чешую долгонога и потроха перепелятника Мауру Заклинателю Дождя в деревню Кровавого Копыта.‡Bringt Maur Regenrufer im Dorf der Bluthufe ein Herz eines Präriewolfs, einen Knochen eines Flachlandpumas, eine Schuppe eines Ebenenschreiters und einen Muskelmagen eines Sturzfliegers.‡블러드후프 마을에 있는 마우르 레인콜러에게 초원늑대 심장, 평원퓨마 다리뼈, 초원타조 비늘과 검독수리 내장을 가져가야 합니다.‡Lleva un corazón de lobo de pradera, un fémur de puma de las estepas, una escama de zancudo de llanura y una molleja de aguilón a Maur Clamalluvias en el Poblado Pezuña de Sangre.‡Lleva un corazón de lobo de pradera, un fémur de puma de las estepas, una escama de zancudo de llanura y una molleja de aguilón a Maur Clamalluvias en el Poblado Pezuña de Sangre.‡Apporter un Cœur de loup des plaines, un Fémur de puma des basses plaines, une Ecaille de trotteur des plaines et un Gésier de rapace à Maur Mande-Pluie, à Sabot-de-Sang.‡收集草原狼的心脏、平原狮的腿骨、平原陆行鸟的鳞片和猛鹫的胃各一份，把它们交给血蹄村的茂尔·祈雨。‡收集草原狼的心臟、平原獅的腿骨、平原陸行鳥的鱗片和猛鷲的胃各一份，把它們交給血蹄村的茂爾·祈雨。',
  }
},
[767] = {
  {
    'Rito de Visão‡Обряд прозрения‡Ritus der Vision‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le rite de vision‡幻象仪祭‡',
    nil,
    'Fale com Zarlman Duas Luas na Aldeia Casco Sangrento.‡Поговорите с Зарельманом Две Луны в деревне Кровавого Копыта.‡Sprecht im Dorf der Bluthufe mit Zarlman Zwillingsmond.‡블러드후프 마을에 있는 잘만 투문과 대화해야 합니다.‡Habla con Zarlman Dos Lunas en el Poblado Pezuña de Sangre.‡Habla con Zarlman Dos Lunas en el Poblado Pezuña de Sangre.‡Parler à Zarlman Deux-Lunes, à Sabot-de-Sang.‡和血蹄村的扎尔曼·双月谈一谈。‡',
  }
},
[768] = {
  {
    'Em busca de couro‡Добывание шкур‡Leder sammeln‡가죽 수집‡Recolecta cuero‡Recolecta cuero‡La chasse aux peaux‡收集皮革‡收集皮革',
    nil,
    'Leve 12 peças de Couro Leve a Veren Passo Alto, no Penhasco do Trovão.‡Принесите 12 кусков тонкой кожи Верену Долгоногу в Громовой Утес.‡Bringt Veren Weitschreiter in Donnerfels 12 Stücke leichtes Leder.‡썬더 블러프에 있는 베렌 톨스트라이더에게 얇은 가죽 12개를 가져가야 합니다.‡Llévale 12 pieles de cuero ligero a Veren Zancaalta a Cima del Trueno.‡Llévale 12 pieles de cuero ligero a Veren Zancaalta a Cima del Trueno.‡Apporter 12 pièces de Cuir léger à Veren Haut-Trotteur, aux Pitons-du-Tonnerre.‡收集12块轻皮，把它们交给雷霆崖的维尔伦·陆行者。‡收集12塊輕皮，把它們交給雷霆崖的維爾倫·陸行者。',
  }
},
[769] = {
  {
    'Bolsa de Pelego de Kodo‡Сумка из шкуры кодо‡Kodobalgtasche‡코도 가죽 가방‡Bolsa de pellejo de kodo‡Bolsa de pellejo de kodo‡Sac en cuir de kodo‡科多兽皮包‡科多獸皮包',
    nil,
    'Leve 4 Couros Leves e 4 Fios Grossos a Veren Passo Alto no Penhasco do Trovão.‡Принесите 4 куска легкой кожи и 4 мотка грубой нити Верену Высокому Страннику в Громовой Утес.‡Bringt Veren Weitschreiter in Donnerfels 4 Einheiten leichtes Leder und 4 grobe Fäden.‡썬더 블러프에 있는 베렌 톨스트라이더에게 얇은 가죽 4개와 굵은 실타래 4개를 가져가야 합니다.‡Llévale 4 pellejos de cuero ligero y 4 hilos burdos a Veren Zancaalta a Cima del Trueno.‡Llévale 4 pellejos de cuero ligero y 4 hilos gruesos a Veren Zancaalta a Cima del Trueno.‡Apportez 4 pièces de Cuir léger et 4 Bobines de fil grossier à Veren Haut-trotteur, aux Pitons-du-Tonnerre.‡给雷霆崖的维尔伦·陆行者带去4块轻皮和4份粗线。‡給雷霆崖的維爾倫·陸行者帶去4塊輕皮和4條粗線。',
  }
},
[770] = {
  {
    'O manto marcado por demônios‡Поцарапанный демоном плащ‡Der Dämonennarbenumhang‡악마의 흔적이 남은 가죽망토‡La capa del demonio marcado‡La capa del demonio marcado‡La cape griffée par les démons‡恶魔之伤‡惡魔之傷',
    nil,
    'Encontre alguém que saiba do Uivo Fantasma.‡Отыщите кого-нибудь, кто слышал о Призрачном Вое.‡Sucht jemanden, der etwas über Geistheuler weiß.‡유령울음늑대에 대해 아는 이를 찾아야 합니다.‡Busca a alguien que conozca a Aullido Fantasma.‡Busca a alguien que conozca a Aullido Fantasma.‡Trouver quelqu\'un qui puisse vous en apprendre davantage au sujet du Hurleur fantomatique.‡去打听打听谁听说过鬼嚎。‡去打聽打聽誰聽說過鬼嚎。',
  }
},
[771] = {
  {
    'Rito de visão‡Обряд прозрения‡Ritus der Vision‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le rite de vision‡幻象仪祭‡幻象祭儀',
    nil,
    'Colha 2 Pedras de Poço e 2 Pinhâmbar e leve-as para Zarlman Duas Luas na Aldeia Casco Sangrento.‡Принесите 2 камня, лежащих у источника, и 2 янтарных семени Зарельману Две Луны в деревню Кровавого Копыта.‡Sammelt 2 Quellsteine und 2 Bernsteinkörner und bringt sie Zarlman Zwillingsmond ins Dorf der Bluthufe.‡우물돌 2개와 대지열매 2개를 모아 블러드후프 마을에 있는 잘만 투문에게 가져가야 합니다.‡Lleva 2 piedras de pozo y 2 bellotas ámbar a Zarlman Dos Lunas al Poblado Pezuña de Sangre.‡Lleva 2 piedras de pozo y 2 bellotas ámbar a Zarlman Dos Lunas al Poblado Pezuña de Sangre.‡Collecter 2 Pierres de puits et 2 Pommes de pin et les rapporter à Zarlman Deux-Lunes, à Sabot-de-Sang.‡收集2块水井石和2个琥珀颗粒，把它们带给血蹄村的扎尔曼-双月。‡收集2塊水井石和2個琥珀顆粒，把它們帶給血蹄村的札爾曼·雙月。',
  }
},
[772] = {
  {
    'Rito de visão‡Обряд прозрения‡Ritus der Vision‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le Rite de vision‡幻象仪祭‡幻象祭儀',
    nil,
    'Beba a Água dos Videntes em frente à fogueira tribal na Aldeia Casco Sangrento e siga a visão quando ela aparecer.‡Выпейте воду Провидцев перед костром племени в деревне Кровавого Копыта и следуйте за видением.‡Trinkt vor dem Stammesfeuer im Dorf der Bluthufe das Wasser der Seher und folgt der Vision, sobald sie erscheint.‡블러드후프 마을에 있는 부족의 불 앞에서 현자의 물을 마시고 나타나는 예언을 따라가야 합니다.‡Bebe el Agua de los Videntes frente a la hoguera tribal del Poblado Pezuña de Sangre y sigue a la visión cuando aparezca.‡Bebe el Agua de los Videntes frente a la hoguera tribal del Poblado Pezuña de Sangre y sigue a la visión cuando aparezca.‡Consommer l\'Eau des Prophètes devant le feu tribal à Sabot-de-Sang et suivre la vision quand elle apparaîtra.‡在血蹄村的部族之火前将先知之水喝下，当幻象出现之后跟随它。‡在血蹄村的部族之火前將先知之水喝下，當幻象出現之後跟隨它。',
  }
},
[773] = {
  {
    'Rito de sabedoria‡Обряд мудрости‡Ritus der Weisheit‡지혜의 의식‡Rito de la Sabiduría‡Rito de la Sabiduría‡Le rite de sagesse‡智慧仪祭‡智慧祭儀',
    nil,
    'Siga para o Rochedo Vermelho, a leste do Penhasco do Trovão, e procure o Espírito Ancestral.‡Отправляйтесь в Красные Скалы на востоке от Громового Утеса и поговорите с духом предков.‡Reist von Donnerfels gen Osten zu den Teufelsfelsen und sprecht mit dem Geist der Ahnen.‡썬더 블러프 동쪽에 있는 붉은 바위 언덕으로 가서 고대의 영혼과 대화해야 합니다.‡Ve a Roca Roja, al este de Cima del Trueno, y busca al espíritu ancestral.‡Ve a Roca Roja, al este de Cima del Trueno, y busca al espíritu ancestral.‡Voyager aux Rochers rouges, à l\'est des Pitons-du-Tonnerre et parler à l\'Esprit ancestral.‡到雷霆崖东边的赤色石去和先祖之魂谈一谈。‡到雷霆崖東邊的赤色石去和先祖之魂談話。',
  }
},
[774] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[775] = {
  {
    'Siga para o Penhasco do Trovão‡Путешествие в Громовой Утес‡Reise nach Donnerfels‡썬더 블러프로의 여정‡Viaje a Cima del Trueno‡Viaje a Cima del Trueno‡Un voyage aux Pitons-du-Tonnerre‡雷霆崖之旅‡雷霆崖之旅',
    nil,
    'Fale com Caerne Casco Sangrento no Penhasco do Trovão.‡Поговорите с Кэрном Кровавым Копытом в Громовом Утесе.‡Sprecht in Donnerfels mit Cairne Bluthuf.‡썬더 블러프에 있는 케른 블러드후프와 대화해야 합니다.‡Habla con Cairne Pezuña de Sangre en Cima del Trueno.‡Habla con Cairne Pezuña de Sangre en Cima del Trueno.‡Parler à Cairne Sabot-de-Sang aux Pitons-du-Tonnerre.‡和雷霆崖的凯恩·血蹄谈一谈。‡和雷霆崖的凱恩·血蹄談話。',
  }
},
[776] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les rites de la Terre-mère‡大地之母仪祭‡大地之母祭儀',
    nil,
    'Caerne Casco Sangrento, no Penhasco do Trovão, quer que você leve para ele o Chifre de Arra\'chea.‡Кэрн Кровавое Копыто из Громового Утеса попросил принести ему рог Арра\'чеи.‡Cairne Bluthuf in Donnerfels möchte, dass Ihr ihm das Horn von Arra\'chea bringt.‡썬더 블러프에 있는 케른 블러드후프가 알라치아의 뿔을 가져다 달라고 했습니다.‡Cairne Pezuña de Sangre de Cima del Trueno quiere que le lleves el cuerno de Arra\'chea.‡Cairne Pezuña de Sangre de Cima del Trueno quiere que le lleves el cuerno de Arra\'chea.‡Apporter la Corne d\'Arra\'chea à Cairne Sabot-de-Sang, aux Pitons-du-Tonnerre.‡雷霆崖的凯恩·血蹄要你将阿兰其亚的角带给他。‡雷霆崖的凱恩·血蹄要你將阿蘭其亞的角帶給他。',
  }
},
[777] = {
  {
    '‡Сложная задача‡Das wird schwierig‡‡Lo tienes crudo‡Lo tienes crudo‡Grandes difficultés‡不祥的感觉‡',
    nil,
    '‡Принесите зубец #5 Лотвилу Вериатусу.‡Bringt Lotwil Veriatus ein Zahnrad Nr. 5.‡‡Llévale un piñón del n.º 5 a Lotwil Veriatus.‡Llévale un piñón del n.º 5 a Lotwil Veriatus.‡Apporter le Rouage N°5 à Lotwil Veriatus.‡把5号齿轮交给鲁特维尔·沃拉图斯。‡',
  }
},
[778] = {
  {
    '‡Сложная задача‡Das wird schwierig‡‡Lo tienes crudo‡Lo tienes crudo‡Grandes difficultés‡不祥的感觉‡',
    nil,
    '‡Победите Стража Фам\'ретора и верните оковы Стихий Лотвила Лотвилу Вериатусу.‡Besiegt den Wächter der Fam\'retor und bringt Lotwils Fesseln der Elementarbindung zu Lotwil Veriatus zurück.‡‡Derrota al guardián Fam\'retor y devuélvele los grilletes de vínculo elemental a Lotwil Veriatus.‡Derrota al guardián Fam\'retor y devuélvele los grilletes de vínculo elemental a Lotwil Veriatus.‡Vaincre le Gardien Fam\'retor et rapporter les Entraves de lien élémentaire de Lotwil à Lotwil Veriatus.‡击败法姆雷托守护者，并将鲁特维尔的元素禁锢镣铐交还给鲁特维尔。‡',
  }
},
[779] = {
  {
    '‡Печать Земли‡Siegel der Erde‡‡El Sello de la Tierra‡El Sello de la Tierra‡Sceau de la Terre‡大地封印‡',
    nil,
    nil,
  }
},
[780] = {
  {
    'Os javaliços‡Боевые вепри‡Die Kampfeber‡전투멧돼지‡Los jabaguerreros‡Los jabaguerreros‡Les sangliers de guerre apprivoisés‡斗猪‡鬥豬',
    nil,
    'Grull Vento do Falcão, na Aldeia Narache, quer que você mate Javaliços e leve para ele 8 Focinhos de Javaliço e 8 Flancos de Javaliço.‡Принесите 8 боков и 8 рыл боевых вепрей Груллу Соколиному Ветру.‡Grull Falkenwind im Camp Narache möchte, dass Ihr für ihn Kampfeber tötet und ihm 8 Kampfeberschnauzen und 8 Kampfeberflanken bringt.‡나라체 야영지에 있는 그룰 호크윈드가 전투멧돼지를 처치하고 전투멧돼지 주둥이 8개와 전투멧돼지 갈빗살 8점을 가져다 달라고 했습니다.‡Grull Viento de Halcón quiere que le lleves 8 hocicos y 8 costillares de jabaguerrero al Campamento Narache.‡Grull Viento de Halcón quiere que le lleves 8 hocicos y 8 costillares de jabaguerrero al Campamento Narache.‡Grull Vent-du-faucon, du Camp Narache, voudrait que vous tuiez des sangliers de guerre, et que vous rapportiez 8 Groins de sanglier de guerre et 8 Flanchets de sanglier de guerre.‡纳拉其营地的格鲁尔·鹰风要求你去干掉斗猪，并带给他8块斗猪头和8块斗猪肋排。‡納拉其營地的格盧爾·鷹風要求你去幹掉鬥豬，並帶給他8塊鬥豬頭和8塊鬥豬肋排。',
  }
},
[781] = {
  {
    '‡Нападение на Лагерь Нараче‡Angriff auf Camp Narache‡‡Ataque al Campamento Narache‡Ataque al Campamento Narache‡L\'attaque du camp Narache‡纳拉其营地的危机‡',
    nil,
    '‡Отнесите план нападения племени Дыбогривов вождю Соколиному Ветру в Лагерь Нараче.‡Bringt die Angriffspläne der Borstennacken zu Häuptling Falkenwind in Camp Narache.‡‡Lleva los planes de ataque Erizapúas al jefe Viento de Halcón al Campamento Narache.‡Lleva los planes de ataque Erizapúas al jefe Viento de Halcón al Campamento Narache.‡Apportez les Plans d\'attaque des Dos-hirsutes au chef Vent-du-faucon, au camp Narache.‡将刺背野猪人的进攻计划交给纳拉其营地的鹰风酋长。‡',
  }
},
[782] = {
  {
    'Alianças rompidas‡Разорванные союзы‡Zerbrochene Allianzen‡깨어진 동맹‡Alianzas rotas‡Alianzas rotas‡Alliances rompues‡破碎的联盟‡破碎的聯盟',
    nil,
    'Mate o Chefe Tho\'grun e leve o Signo da Terra para Gorn, em Karrath.‡Убейте главаря То\'груна и принесите знак земли Горну в Каргат.‡Tötet Boss Tho\'grun und bringt Gorn in Kargath das Zeichen der Erde.‡우두머리 토그룬을 처치하고 카르가스에 있는 고른에게 대지의 봉인을 가져가야 합니다.‡Mata al jefe Tho\'grun y llévale el Signo de la Tierra a Gorn en Kargath.‡Mata al jefe Tho\'grun y llévale el Signo de la Tierra a Gorn en Kargath.‡Tuer Boss Tho\'grun et rapporter le Signe de la Terre à Gorn, à Kargath.‡杀掉索格伦，把大地印章交给卡加斯的高恩。‡殺掉索葛蘭，把大地印章交給卡加斯的高恩。',
  }
},
[783] = {
  {
    '[DEPRECATED] A Threat Within‡Внутренняя угроза‡Die Bedrohung von innen‡내부의 위협‡[DEPRECATED] Una amenaza del interior‡Una amenaza interna‡[PÉRIMÉ]Menace intérieure‡身边的危机‡[DEPRECATED] A Threat Within',
    nil,
    'Fale com o Major Belmonte.‡Поговорите с маршалом Макбрайдом.‡Sprecht mit Marschall McBride.‡치안대장 맥브라이드와 대화해야 합니다.‡Habla con el alguacil McBride.‡Habla con el alguacil McBride.‡Parlez au Maréchal McBride.‡与治安官玛克布莱德谈一谈。‡與治安官瑪克布萊德談話。',
  }
},
[784] = {
  {
    'Aniquile os invasores‡Бей предателей!‡Vernichtet die Verräter‡배신자 처단‡Vencer a los traidores‡Vencer a los traidores‡Vaincre les traîtres‡背信弃义的人类‡背信棄義的人類',
    nil,
    'Mate 10 Marinheiros de Kul Tiraz, 8 Fuzileiros de Kul Tiraz e o Tenente Bento. Depois, fale novamente com Gar\'Thok no Monte Navalha.‡Убейте 10 моряков Кул-Тираса, 8 стражей бухты Кул-Тираса и лейтенанта Бенедикта и возвращайтесь к Га\'Току на Колючий Холм.‡Tötet 10 Matrosen von Kul Tiras, 8 Marinesoldaten von Kul Tiras sowie Leutnant Benedict und kehrt dann zu Gar\'Thok in Klingenhügel zurück.‡쿨 티라스 선원 10명과 쿨 티라스 해병 8명, 그리고 부대장 베네딕트를 처치한 다음 칼바위 언덕에 있는 가르톡에게 가야 합니다.‡Mata a 10 navegantes Kul Tiras, 8 marineros Kul Tiras y al teniente Benedict. Luego vuelve a buscar a Gar\'Thok a Cerrotajo.‡Mata a 10 navegantes Kul Tiras, 8 marineros Kul Tiras y al teniente Benedict. Luego vuelve a buscar a Gar\'Thok a Cerrotajo.‡Tuer 10 Marins de Kul Tiras, 8 Soldats de marine de Kul Tiras et le Lieutenant Benedict, puis retourner voir Gar\'Thok à Tranchecolline.‡杀死10个库尔提拉斯水手和8个库尔提拉斯水兵，再把本尼迪克上尉干掉，然后回剃刀岭向加索克复命。‡殺死10個庫爾提拉斯水手和8個庫爾提拉斯水兵，再把本尼迪克上尉幹掉，然後回剃刀嶺向加索克復命。',
  }
},
[785] = {
  {
    '‡Стратегический союз‡Eine strategische Allianz‡전략적 동맹‡Una alianza estratégica‡Una alianza estratégica‡Alliance stratégique‡协助盟友‡',
    nil,
    '‡Разыщите Лара Ночного Клыка на западной окраине деревни Сен\'джин.‡Sucht Lar Lauerzahn an der Westflanke von Sen\'jin auf.‡‡Busca a Lar Colmillo Acechador en el flanco oeste del Poblado Sen\'jin.‡Busca a Lar Colmillo Acechador en el flanco oeste del Poblado Sen\'jin.‡Chercher Lar Fouinebroche sur le flanc ouest du village de Sen\'jin.‡‡',
  }
},
[786] = {
  {
    'Frustrando o ataque dos Kolkar‡Предотвращение агрессии племени Колкар‡Vereitelung der Kolkaraggression‡콜카르 침략 저지‡Frustrar los planes kolkar‡Frustrar los planes kolkar‡Déjouer l\'agression des Kolkar‡科卡尔半人马的进攻‡科卡爾半人馬的進攻',
    nil,
    'Larri Presador, junto à Aldeia Sen\'jin, quer que você destrua 3 Planos de Ataque, que estão no Penedo de Kolkar.‡Лар Ночной Клык из деревни Сен\'джин хочет, чтобы вы уничтожили 3 плана нападения, которые хранятся в лагере кентавров, что на Утесе Колкар.‡Lar Lauerzahn außerhalb von Sen\'jin möchte, dass Ihr die 3 Sets der Angriffspläne zerstört, die innerhalb der Kolkarklippe verwahrt werden.‡센진 마을 외곽에 있는 라르 프라울터스크가 콜카르 바윗골에 있는 3개의 공격 계획서를 없애 달라고 했습니다.‡Lar Colmillo Acechador, de las afueras del Poblado Sen\'jin, quiere que destruyas los 3 planes de ataque de Risco Kolkar.‡Lar Colmillo Acechador, de las afueras del Poblado Sen\'jin, quiere que destruyas los 3 planes de ataque de Risco Kolkar.‡Détruire 3 Jeux de Plans d\'attaque dans la combe des Kolkar, pour Lar Fouinebroche à l\'extérieur du village de Sen\'jin.‡在森金村外面的拉尔·猎齿要求你粉碎科卡尔峭壁内的三份进攻计划。‡在森金村外面的拉爾·獵齒要求你粉碎科卡爾峭壁內的三份進攻計畫。',
  }
},
[787] = {
  {
    '‡Новая Орда‡Die neue Horde‡새로운 호드‡La nueva Horda‡La nueva Horda‡La nouvelle Horde‡新的部落‡新的部落',
    nil,
    '‡Зайти в Логово к Горнеку.‡Meldet Euch bei Gornek beim Höhlenbau.‡동굴 막사에 있는 고르넥에게 보고해야 합니다.‡Preséntate ante Gornek en El Cubil.‡Preséntate ante Gornek en El Cubil.‡Faites un rapport à Gornek, dans l\'Antre.‡与高内克谈一谈。卡尔图克在你的地图上标出了他的位置，并告诉你高内克居住在西边的大兽穴中。‡',
  }
},
[788] = {
  {
    'Dentes cortantes‡Кабаньи клыки‡Erste Erfahrungen‡몸 풀기‡Dientes afilados‡Dientes afilados‡La dent tranchante‡小试身手‡小試身手',
    nil,
    'Kill 8 Mottled Boars then return to Gornek at the Den.‡Убейте 8 пятнистых вепрей и вернитесь в Логово к Горнеку.‡Tötet 8 scheckige Eber und kehrt dann zu Gornek beim Höhlenbau zurück.‡점박이멧돼지 8마리를 처치한 다음 동굴 막사에 있는 고르넥에게 가야 합니다.‡Mata a 8 jabalíes jaspeados y vuelve con Gornek en El Cubil.‡Mata a 8 jabalíes jaspeados y vuelve con Gornek en El Cubil.‡Tuez 8 Sangliers tachetés, puis retournez voir Gornek, dans l’Antre.‡杀掉8只杂斑野猪，然后向大兽穴里的高内克报告。‡殺掉8隻雜斑野豬，然後向大獸穴裡的高內克報告。',
  }
},
[789] = {
  {
    'A ferroada do escorpídeo‡Жала скорпидов‡Stich des Skorpiden‡전갈의 독침‡Aguijón de escórpido‡Aguijón de escórpido‡L\'aiguillon du scorpide‡工蝎的尾巴‡工蠍的尾巴',
    nil,
    'Get 8 Scorpid Worker Tails for Gornek in the Den.‡Добудьте 8 хвостов рабочих скорпидов и принесите их в Логово Горнеку.‡Bringt 8 Skorpidarbeiterschwänze zu Gornek im Höhlenbau.‡동굴 막사에 있는 고르넥을 위해 일꾼전갈 꼬리 8개를 모아야 합니다.‡Consigue 8 colas de escórpidos obreros para Gornek en El Cubil.‡Consigue 8 colas de escórpidos obreros para Gornek en El Cubil.‡Apporter 8 Queues de scorpides ouvriers à Gornek, dans l’Antre.‡给大兽穴中的高内克带回8根工蝎的尾巴。‡把8根工蠍的尾巴帶給大獸穴中的高內克。',
  }
},
[790] = {
  {
    'Sarkoth‡Саркот‡Sarkoth‡사르코스‡Sarkoth‡Sarkoth‡Sarkoth‡萨科斯‡薩科斯',
    nil,
    'Mate Sarkoth e leve a garra dele para Hana\'zua.‡Убейте Саркота и принесите его коготь Хана\'зуа.‡Tötet Sarkoth und bringt seine Klaue zu Hana\'zua.‡사르코스를 처치하고 그의 발톱을 하나주아에게 가져가야 합니다.‡Mata a Sarkoth y llévale su zarpa a Hana\'zua.‡Mata a Sarkoth y llévale su zarpa a Hana\'zua.‡Tuez Sarkoth et rapportez sa pince à Hana\'zua.‡杀死萨科斯并将它的爪子带回去交给哈纳祖。‡殺死薩科斯並將它的爪子帶回去交給哈納祖。',
  }
},
[791] = {
  {
    'Carregue suas tralhas‡Больше сумок – больше добычи!‡Akzeptiert Euer Schicksal‡보급품 조달‡Asume tu responsabilidad‡Asume tu responsabilidad‡Assumer ses responsabilités‡新的背包‡新的背包',
    nil,
    'Férrano Escarnecenho na torre de vigia do Monte Navalha quer 8 Retalhos de Lona.‡Принесите 8 лоскутов холста Фурлу Хмурому Лбу, стоящему на сторожевой башне рядом с Колючим Холмом.‡Furl Hohnbraue im Wachturm von Klingenhügel möchte 8 Segeltuchreste haben.‡칼바위 언덕 감시탑에 있는 펄 스콘브라우가 캔버스 천조각 8개를 가져다 달라고 했습니다.‡Furl Ceñosprecio de la Atalaya de Cerrotajo quiere 8 retales de retal.‡Furl Ceñosprecio de la Atalaya de Cerrotajo quiere 8 retales.‡Apporter 8 Morceaux de canevas à Furl Morguefront, dans la tour de guet de Tranchecolline.‡剃刀岭了望塔中的弗恩·凝眉想要8块帆布脚料。‡剃刀嶺瞭望塔中的弗恩·凝眉想要8塊帆布腳料。',
  }
},
[792] = {
  {
    'Familiares torpes‡Злобные фамилиары‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Kill 8 Vile Familiars.|n|nReturn to Zureetha Fargaze outside the Den.‡Убейте 8 злобных фамилиаров и вернитесь к Зурите Востроглазой, которая ждет вас у Логова.‡Tötet 8 üble Familiare.|n|nKehrt dann zu Zureetha Fernblick beim Höhlenbau zurück.‡악마의 하수인 8마리를 처치해야 합니다.|n|n임무를 완수한 뒤 동굴 막사 바깥에 있는 주리타 파게이즈에게 가야 합니다.‡Mata a 8 familiares viles.|n|nVuelve con Zureetha Vistalonga a las puertas de El Cubil.‡Mata a 8 familiares viles.|n|nVuelve con Zureetha Vistalonga a las puertas de El Cubil.‡Tuez 8 Vils quasits.|n|nRetournez voir Zureetha Mireloin, à l’extérieur de l’Antre.‡杀死8只邪灵劣魔，然后向大兽穴外的祖雷萨复命。‡殺死8隻邪靈劣魔。|n|n然後向大獸穴外的祖雷薩·遠凝回報。',
  }
},
[793] = {
  {
    'Alianças rompidas‡Разорванные союзы‡Zerbrochene Allianzen‡깨어진 동맹‡Alianzas rotas‡Alianzas rotas‡Alliances rompues‡破碎的联盟‡破碎的聯盟',
    nil,
    'Use o Signo da Terra para ativar os Pilares de Diamante, Opala e Ametista, e pegue as Pedras Rúnicas.|n|nColoque as pedras rúnicas no Selo da Terra para libertar Neraçoite e Hematus.|n|nMate-os e entregue as Braçadeiras de Neraçoite, os Grilhões de Hematus e o Signo da Terra para Gorn.‡С помощью знака земли активируйте алмазный, опаловый и аметистовый столпы и извлеките рунные камни. |n|nПоместите рунные камни на печать земли и освободите драконов Чернохлыста и Гематуса. |n|nУбейте драконов и принесите Горну наручники Чернохлыста, цепи Гематуса и знак земли.‡Benutzt das Zeichen der Erde, um die Säulen aus Diamant, Opal und Amethyst zu aktivieren und die Runensteine zu holen.|n|nLegt die Runensteine auf das Siegel der Erde, um Schattenbringer und Hematus zu befreien.|n|nTötet sie und bringt dann Gorn Schattenbringers Bindung, Hematus\' Ketten und das Zeichen der Erde.‡대지의 봉인을 사용하여 다이아몬드, 오팔, 자수정의 기둥을 작동시켜 마법석을 획득해야 합니다.|n|n마법석을 대지의 봉인에 놓아 블랙래쉬와 헤마투스의 봉인을 풀어줘야 합니다.|n|n블랙래쉬와 헤마투스를 처치하고 고른에게 블랙래쉬의 굴레, 헤마투스의 굴레와 대지의 봉인을 가져가야 합니다.‡Usa el Signo de la Tierra para activar el Pilar de diamante, el de ópalo y el de amatista y así obtener las piedras rúnicas.|n|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Latigoscuro y a Hematus.|n|nMátalos y llévale a Gorn las ataduras de Latigoscuro, las cadenas de Hematus y el Signo de la Tierra.‡Usa el Signo de la Tierra para activar el Pilar de diamante, el de ópalo y el de amatista y así obtener las piedras rúnicas.|n|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Latigoscuro y a Hematus.|n|nMátalos y llévale a Gorn las ataduras de Latigoscuro, las cadenas de Hematus y el Signo de la Tierra.‡Utiliser le Signe de la Terre pour activer les Piliers de diamant, d\'opale et d\'améthyste, et obtenir les Pierres runiques.|n|nPlacer les Pierres runiques dans le Sceau de la Terre pour libérer Cinglenoir et Hematus.|n|nLes exécuter et rapporter les Liens de Cinglenoir, les Entraves d\'Hematus et le Signe de la Terre à Gorn.‡用大地印章激活钻石柱、玛瑙石柱和紫水晶石柱并拿到三颗符石。|n|n把符石放在大地封印上，释放黑龙布莱克拉什和赫玛图斯。|n|n杀了这两条黑龙，把黑龙布莱克拉什的锁链、赫玛图斯的锁链和大地印章交给高恩。‡用大地徽印啟動鑽石柱、蛋白石柱和紫水晶石柱並拿到三顆符石。|n|n把符石放在大地封印上，釋放黑龍布萊克拉席和赫瑪圖斯。|n|n殺了這兩條黑龍，把黑龍布萊克拉席的鎖鍊、赫瑪圖斯的鎖鍊和大地徽印交給高恩。',
  }
},
[794] = {
  {
    'Medalhão da Lâmina Ardente‡Медальон клана Пылающего Клинка‡Medaillon der Brennenden Klinge‡불타는 칼날단 메달‡El medallón del Filo Ardiente‡El medallón del Filo Ardiente‡Le médaillon de la Lame ardente‡火刃奖章‡燃刃勳章',
    nil,
    'Leve o Medalhão da Lâmina Ardente para Zureta Vista-longa em frente ao Covil.‡Принесите медальон клана Пылающего Клинка Зурите Востроглазой, стоящей у Логова.‡Bringt Zureetha Fernblick beim Höhlenbau das Medaillon der Brennenden Klinge.‡동굴 막사 외부에 있는 주리타 파게이즈에게 불타는 칼날단 메달을 가져가야 합니다.‡Lleva el medallón del Filo Ardiente a Zureetha Vistalonga, a las puertas de El Cubil.‡Lleva el medallón del Filo Ardiente a Zureetha Vistalonga, a las puertas de El Cubil.‡Apportez le Médaillon de la Lame ardente à Zureetha Mireloin, à l\'extérieur de l\'Antre.‡给大兽穴外的祖雷萨带回火刃奖章。‡幫大獸穴外的祖雷薩·遠凝帶回燃刃勳章。',
  }
},
