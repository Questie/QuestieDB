},
[32866] = {
  {
    'Coletando informações - Rastreamento Zaela‡Сбор разведданных – слежка за Зелой‡Gathering Intelligence - Zaela Tracking‡정보 수집하기 - 젤라 추적‡Gathering Intelligence - Zaela Tracking‡‡Gathering Intelligence - Zaela Tracking‡Gathering Intelligence - Zaela Tracking‡',
    nil,
    '‡‡‡‡Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre actualizado al último parche (11.1.7).‡‡‡‡',
  }
},
[32867] = {
  {
    'Vol\'jin dos Lançanegra‡Вол\'джин из племени Черного Копья‡Vol\'jin von den Dunkelspeeren‡검은창 부족의 볼진‡Vol\'jin de los Lanza Negra‡‡Vol’jin des Sombrelances‡‡',
    nil,
    'Ouça Ki\'ta Flechatusca. Uma‡Выслушайте Ки\'ту Стрелоклыка. это‡Hört Ki\'ta Pfeilzahn zu.‡키타 애로우터스크의 이야기를 들어야 합니다. 레벨 1‡Escucha a Ki\'ta Flechacerada.‡‡Écoutez Ki’ta Brocheflèche.‡‡',
  }
},
[32868] = {
  {
    'Feras das fábulas – Livro II‡Звери из легенд, книга II‡Fabelhafte Wesen, Buch II‡전설의 야수 2권‡Las bestias de las fábulas II‡‡Créatures des mythes et légendes : volume II‡《寓言之兽》第二册‡',
    nil,
    'Derrote Yi Boa Sorte, Casco Cinzento e o Rastejante Xi\'a. Uma‡Победите Счастливчика И, Серое копытце и Быстролапого Кся. это‡Besiegt Glückspilz Yi, Grauhuf und Huscher Xi\'a.‡복스러운 이, 회색발굽, 소금쟁이 시아를 쓰러뜨려야 합니다. 레벨 1‡Derrota a Yi el Afortunado, Pezuñagrís y Arácnida Xi\'a.‡‡Gagnez un combat contre Yi la Chance, Sabot-Gris et le Glisseur Xi’a.‡击败幸运的小艺、灰蹄和飞掠者溪雅。‡',
  }
},
[32869] = {
  {
    'Feras das fábulas – Livro III‡Звери из легенд, книга III‡Fabelhafte Wesen, Buch III‡전설의 야수 3권‡Las bestias de las fábulas III‡‡Créatures des mythes et légendes : volume III‡《寓言之兽》第三册‡',
    nil,
    'Derrote Naum-Naum, Ti\'un, o Vagante, e Espinogorja. Uma‡Победите Но-Но, Ти\'уна Странника и Кровоспина. это‡Besiegt No-No, Ti\'un den Wanderer und Blutstachel.‡노노, 방랑자 티운, 피가시를 쓰러뜨려야 합니다. 레벨 1‡Derrota a No-No, Ti\'un el Vagabundo y Puasangre.‡‡Gagnez un combat contre No-No, Ti’un l’Explorateur et Tripépine.‡击败诺诺、云游者啼乌和血刺。‡',
  }
},
[32870] = {
  {
    'Preparando-se para atacar‡Подготовка к удару‡Angriffsvorbereitung‡공격 준비‡Preparando el golpe‡‡Se préparer à frapper‡准备出击‡',
    nil,
    'Fale novamente com Wrathion na Taberna nas Nuvens, que fica na Escadaria Oculta. Uma‡Вернитесь к Гневиону в таверну "В туманах" на Сокрытой лестнице. это‡Kehrt zu Furorion in der Taverne im Nebel an der Verhüllten Treppe zurück.‡장막의 계단, 안개 속의 주점에 있는 래시온에게 가야 합니다. 레벨 35‡Reúnete con Wrathion en la Taberna de la Niebla, en La Escalera Velada.‡‡Retournez voir Irion à la Taverne dans les Brumes, à l’Escalier Dérobé.‡回雾纱栈道的迷雾酒肆找拉希奥。‡',
  }
},
[32871] = {
  {
    'Vol\'jin dos Lançanegra‡Вол\'джин из племени Черного Копья‡Vol\'jin von den Dunkelspeeren‡‡Vol\'jin de los Lanza Negra‡‡Vol’jin des Sombrelances‡暗矛部族的沃金‡',
    nil,
    'Acompanhe Zen\'tabra até Vol\'jin. Uma‡Идите к Вол\'джину с Зен\'таброй. это‡Begleitet Zen\'tabra zu Vol\'jin.‡‡Acompaña a Zen\'tabra hasta Vol\'jin.‡‡Accompagnez Zen’tabra jusqu’à Vol’jin.‡陪岑塔布拉去找沃金。‡',
  }
},
[32872] = {
  {
    'Campo de Batalha: Sertões‡Поле битвы: Степи‡Schlachtfeld: Brachland‡전쟁터: 불모의 땅‡Campo de batalla: Los Baldíos‡‡Champ de bataille : les Tarides‡战场：贫瘠之地‡',
    nil,
    nil,
  }
},
[32890] = {
  {
    'INDICADOR - Tutorial Caravana‡FLAG – Caravan Tutorial‡FLAG - Caravan Tutorial‡플래그 - 마차 튜토리얼‡FLAG - Caravan Tutorial‡‡FLAG - Caravan Tutorial‡FLAG - Caravan Tutorial‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[32891] = {
  {
    'INDICADOR - Tutorial Comandante‡FLAG – Commander Tutorial‡FLAG - Commander Tutorial‡플래그 - 지휘관 튜토리얼‡FLAG - Commander Tutorial‡‡FLAG - Commander Tutorial‡FLAG - Commander Tutorial‡',
    nil,
    'Ermo do Medo de‡‡‡공포의 황무지‡‡‡‡‡',
  }
},
[32892] = {
  {
    'A guerra se aproxima‡Грядет война‡Krieg zieht auf‡전쟁의 전조‡La guerra se avecina‡‡Guerre annoncée‡大战在即‡',
    nil,
    'Fale com o Andarilho Das Lendas Cho.‡Поговорите с хранителем истории Чо.‡Sprecht mit Lehrensucher Cho.‡전승지기 초와 대화해야 합니다.‡Habla con el eremita Cho. Una Misión. Otorga  como recompensa. Añadido en World of Warcraft: Mists of Pandaria. Siempre al día con el parche más reciente.‡‡Parlez au Chroniqueur Cho.‡与游学者周卓交谈。‡',
  }
},
[32895] = {
  {
    'A estrada da guerra‡Путь к войне‡Rebellion!‡전쟁의 길‡El camino hacia la guerra‡‡Sur le chemin de la guerre‡战争之路‡',
    nil,
    'Fale com Ki\'ta Flechatusca no Monte Navalha, em Durotar.‡Поговорите с Ки\'той Стрелоклыком в Колючем Холме, что в Дуротаре.‡Sprecht mit Ki\'ta Pfeilzahn nordwestlich von Klingenhügel in Durotar.‡듀로타의 칼바위 언덕에 있는 키타 애로우터스크와 대화해야 합니다.‡Habla con Ki\'ta Flechacerada en Cerrotajo, en Durotar.‡‡Parlez à Ki’ta Brocheflèche à Tranchecolline, en Durotar.‡在杜隆塔尔的剃刀岭与基塔·箭牙交谈。‡',
  }
},
[32896] = {
  {
    'A estrada da guerra‡Путь к войне‡Rebellion!‡The Road to War‡El camino hacia la guerra‡‡Sur le chemin de la guerre‡‡',
    nil,
    'Fale com Ki\'ta Flechatusca no Monte Navalha, em Durotar.‡Поговорите с Ки\'той Стрелоклыком в Колючем Холме, что в Дуротаре.‡Sprecht mit Ki\'ta Pfeilzahn nordwestlich von Klingenhügel in Durotar.‡Speak to Ki\'ta Arrowtusk at Razor Hill in Durotar.‡Habla con Ki\'ta Flechacerada en Cerrotajo, en Durotar.‡‡Parlez à Ki’ta Brocheflèche à Tranchecolline, en Durotar.‡‡',
  }
},
[32897] = {
  {
    'LFGDungeons - Mists - Scenario - Heroic Daily - 1st/Nth‡LFGDungeons - Mists - Scenario - Heroic Daily - 1st/Nth‡LFGDungeons - Mists - Scenario - Heroic Daily - 1st/Nth‡LFGDungeons - Mists - Scenario - Heroic Daily - 1st/Nth‡Gesta seleccionada diaria‡‡LFGDungeons - Mists - Scenario - Heroic Daily - 1st/Nth‡日常选择场景战役‡',
