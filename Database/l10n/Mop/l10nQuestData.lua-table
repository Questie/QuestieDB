},
[27327] = {
  {
    'Chefes dos Temível Totem: O chefe dos chefes‡Вожди Зловещего Тотема: верховный вождь‡Häuptlinge der Grimmtotem: Der Häuptling aller Häuptlinge‡그림토템 부족의 족장: 족장 중의 족장‡Jefes Tótem Siniestro: el jefe de jefes‡Jefes Tótem Siniestro: el jefe de jefes‡Les chefs du Totem-sinistre : le chef des chefs‡恐怖图腾酋长：酋长之首‡恐怖圖騰的酋長:酋長中的酋長',
    nil,
    'Mate Arnak Temível Totem.‡Расправьтесь с Арнаком Зловещим Тотемом.‡Tötet Arnak Grimmtotem.‡아르낙 그림토템을 처치해야 합니다.‡Mata a Arnak Tótem Siniestro.‡Mata a Arnak Tótem Siniestro.‡Tuez Arnak Totem-sinistre.‡杀死阿纳克·恐怖图腾。‡殺死阿納克‧恐怖圖騰。',
  }
},
[27328] = {
  {
    'Chefes dos Temível Totem: O chefe dos chefes‡Вожди Зловещего Тотема: верховный вождь‡Häuptlinge der Grimmtotem: Der Häuptling aller Häuptlinge‡그림토템 부족의 족장: 족장 중의 족장‡Jefes Tótem Siniestro: el jefe de jefes‡Jefes Tótem Siniestro: el jefe de jefes‡Les chefs du Totem-sinistre : le chef des chefs‡恐怖图腾酋长：酋长之首‡恐怖圖騰的酋長:酋長中的酋長',
    nil,
    'Mate Arnak Temível Totem.‡Расправьтесь с Арнаком Зловещим Тотемом.‡Tötet Arnak Grimmtotem.‡아르낙 그림토템을 처치해야 합니다.‡Mata a Arnak Tótem Siniestro.‡Mata a Arnak Tótem Siniestro.‡Tuez Arnak Totem-sinistre.‡杀死阿纳克·恐怖图腾。‡殺死阿納克‧恐怖圖騰。',
  }
},
[27329] = {
  {
    'Evocando a serpente‡Призыв змея‡Die Windnatter entfernen‡천둥매 불러오기‡Invocar a la serpiente‡Invocar a la serpiente‡Invoquer le serpent‡打草惊蛇‡召喚風蛇',
    nil,
    'Derrote Arikara.‡Одолейте Арикару.‡Bezwingt Arikara.‡아리카라를 쓰러뜨려야 합니다.‡Derrota a Arikara.‡Derrota a Arikara.‡Vaincre Arikara.‡打败阿利卡拉。‡擊敗阿利卡拉。',
  }
},
[27330] = {
  {
    'Evocando a serpente‡Призыв змея‡Die Windnatter entfernen‡천둥매 불러오기‡Invocar a la serpiente‡Invocar a la serpiente‡Invoquer le serpent‡打草惊蛇‡召喚風蛇',
    nil,
    'Derrote Arikara.‡Одолейте Арикару.‡Bezwingt Arikara.‡아리카라를 쓰러뜨려야 합니다.‡Derrota a Arikara.‡Derrota a Arikara.‡Vaincre Arikara.‡打败阿利卡拉。‡擊敗阿利卡拉。',
  }
},
[27331] = {
  {
    'O chamado do vidente‡Зов ясновидицы‡Der Ruf der Seherin‡예언자의 부름‡La llamada de la vidente‡‡L\'appel du voyant‡先知的召唤‡先知的請求',
    nil,
    'Fale com a Vidente Liwatha no Vale da Sabedoria, em Orgrimmar.‡Поговорите с Ясновидицей Ливатхой на Аллее Мудрости Оргриммара.‡Sprecht mit Seherin Liwatha im Tal der Weisheit in Orgrimmar.‡오그리마 지혜의 골짜기에 있는 예언자 리와타와 대화해야 합니다.‡Habla con la vidente Liwatha en el Valle de la Sabiduría de Orgrimmar.‡‡Allez voir la Voyante Liwatha dans la Vallée de la Sagesse d\'Orgrimmar.‡跟奥格瑞玛智慧谷的先知利瓦萨谈一谈。‡到奧格瑪的智慧谷去與先知利瓦薩交談。',
  }
},
[27332] = {
  {
    'Em busca do andarilho das sombras‡Встреча с крадущимся в тени‡Sucht den Schattenläufer auf‡암흑방랑자의 부름‡Busca al caminasombras‡Busca al caminasombras‡Trouvez le marcheur des ombres‡寻找暗影行者‡尋找暗影行者',
    nil,
    'Fale com o Andarilho das Sombras Zuru no Vale dos Espíritos, em Orgrimmar.‡Поговорите с крадущимся в тени Зуру на Аллее Духов Оргриммара.‡Sprecht mit Schattenläufer Zuru im Tal der Geister in Orgrimmar.‡오그리마 정기의 골짜기에 있는 암흑방랑자 주루와 대화해야 합니다.‡Habla con el caminasombras Zuru, en el Valle de los Espíritus de Orgrimmar.‡Habla con el caminasombras Zuru, en el Valle de los Espíritus de Orgrimmar.‡Parlez au marcheur des ombres Zuru dans la Vallée des Esprits, à Orgrimmar.‡跟奥格瑞玛精神谷的暗影行者祖鲁谈一谈。‡到奧格瑪的精神谷去與暗影行者祖魯交談。',
  }
},
[27333] = {
  {
    'Perdendo terreno‡Теряя силы‡Haltlos‡전세 악화‡Perdiendo terreno‡Perdiendo terreno‡Il faut reprendre l’offensive‡失地‡節節敗退',
    nil,
    'Mate 12 Rebeldes Worgens.‡Уничтожьте 12 воргенов-повстанцев.‡Tötet 12 Rebellen der Worgen.‡늑대인간 반란군 12명을 처치해야 합니다.‡Mata a 12 rebeldes huargen.‡Mata a 12 rebeldes huargen.‡Tuez 12 Rebelles worgens.‡杀死12名狼人抵抗军战士。‡殺死12名狼人反抗軍。',
  }
},
[27334] = {
  {
    'Clériga das trevas Cecille‡Темный священник Сесиль‡Dunkle Klerikerin Cecille‡어둠의 사제 세실‡La clériga oscura Cecille‡La clériga oscura Cecille‡Le sombre clerc Cecille‡黑暗牧师塞希莉‡黑暗教士瑟希爾',
    nil,
    'Fale com a Clériga das Trevas Cecille no Castelo Grommash, que fica no Vale da Força, em Orgrimmar.‡Поговорите с темным священником Сесиль в крепости Громмаш, которая находится на Аллее Силы Оргриммара.‡Sprecht mit der dunklen Klerikerin Cecille in Feste Grommash im Tal der Stärke in Orgrimmar.‡오그리마 힘의 골짜기에 있는 그롬마쉬 요새에서 어둠의 사제 세실과 대화해야 합니다.‡Habla con la clériga oscura Cecille en Fuerte Grommash, en el Valle de la Fuerza de Orgrimmar.‡Habla con la clériga oscura Cecille en Fuerte Grommash, en el Valle de la Fuerza de Orgrimmar.‡Parlez au Sombre clerc Cecille au Fort Grommash, dans la Vallée de la Force, à Orgrimmar.‡进入奥格瑞玛力量谷的格罗玛什要塞，跟黑暗牧师塞希莉谈一谈。‡到奧格瑪的力量谷中的葛羅瑪許堡，去與黑暗教士瑟希爾交談。',
  }
},
[27335] = {
  {
    'Jornada para Orgrimmar‡Путешествие в Оргриммар‡Reise nach Orgrimmar‡오그리마로의 여행‡Viaje a Orgrimmar‡Viaje a Orgrimmar‡Voyage à Orgrimmar‡奥格瑞玛之旅‡前往奧格瑪',
    nil,
    'Fale com Tyelis no Castelo Grommash, que fica no Vale da Força em Orgrimmar.‡Поговорите с Тайлисом в крепости Громмаш на Аллее Силы Оргриммара.‡Sprecht mit Tyelis in Feste Grommash im Tal der Stärke in Orgrimmar.‡오그리마 힘의 골짜기에 있는 그롬마쉬 요새에서 티엘리스와 대화해야 합니다.‡Habla con Tyelis en Fuerte Grommash, en el Valle de la Fuerza de Orgrimmar.‡Habla con Tyelis en Fuerte Grommash, en el Valle de la Fuerza de Orgrimmar.‡Parlez à Tyelis au Fort Grommash dans la Vallée de la Force, à Orgrimmar.‡跟奥格瑞玛力量谷的提耶利斯谈一谈。‡到奧格瑪的力量谷中的葛羅瑪許堡，去與泰利斯交談。',
  }
},
[27336] = {
  {
    'A arma dos Temível Totem‡Оружие Зловещего Тотема‡Die Waffe der Grimmtotem‡그림토템 무기‡El arma Tótem Siniestro‡El arma Tótem Siniestro‡L\'arme des Totems-sinistres‡恐怖图腾的武器‡恐怖圖騰武器',
    nil,
    'Use o Totem Capturado para fincá-lo no chão e mate 10 Crocoliscos Secâmoros Mosqueados ou Secâmoros Gorjadaga perto do totem para testar seus efeitos.‡Установите на земле захваченный тотем и убейте рядом с ним 10 крапчатых кроколисков-грязекупов или грязекупов-острозубов, чтобы исследовать свойства тотема.‡Platziert das erbeutete Totem auf dem Boden und tötet 10 scheckige Staubsuhlerkrokilisken oder Staubsuhlerdolchrachenen, um den Effekt des Totems zu testen.‡노획한 토템을 바닥에 꽂고 그 근처에 있는 얼룩무늬 늪지악어나 비수송곳니 늪지악어 10마리를 처치하여 그 효과를 시험해야 합니다.‡Usa el tótem capturado para colocarlo en el suelo y después mata a 10 crocoliscos secorrones jaspeados o faucedagas secorrones cerca del tótem para probar sus efectos.‡Usa el tótem capturado para colocarlo en el suelo y después mata a 10 crocoliscos secorrones jaspeados o faucedagas secorrones cerca del tótem para probar sus efectos.‡Utilisez le Totem capturé en le plaçant au sol afin de tuer 10 Crocilisques tachetés Sèchefange ou Crocs-lames Sèchefange.‡将被捕获的图腾插在地上，在其附近杀死10头尘泥杂斑鳄鱼或尘泥利齿鳄鱼以测试其效应。‡使用找來的圖騰來將它設置在地面，然後殺死10隻塵泥雜斑鱷魚或塵泥利齒鱷魚來測試它的效果。',
  }
},
[27337] = {
  {
    'Uma arma apropriada‡Достойное оружие‡Eine passende Waffe‡적절한 무기‡Un arma adecuada‡Un arma adecuada‡Une arme adéquate‡称心如意的武器‡合適的武器',
    nil,
    'Vá à Bastilha da Presa Negra e recupere a Espada da Família Silverlaine do Barão Silverlaine, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка, добудьте у барона Сильверлейна меч семьи Сильверлейнов, а также 5 слитков лунной стали и 5 жил нежити.‡Reist zu Burg Schattenfang und erhaltet das Schwert der Familie Silberlein von Baron Silberlein, 5 Kisten Mondstahlbarren und 5 ewige Sehnen.‡그림자송곳니 성채에서 실버레인 가문의 검, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén la espada de la familia Filargenta del barón Filargenta, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén la espada de la familia Filargenta del barón Filargenta, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez l\'Épée de la famille d\'Argelaine sur le Baron d\'Argelaine, 5 caisses de Lingots d\'acier lunaire et 5 Tendons impérissables.‡进入影牙城堡，从席瓦莱恩男爵那里夺得席瓦莱恩家族佩剑，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡取得席瓦萊恩男爵的席瓦萊恩家傳長劍，5箱月鋼錠，和5條不死肌腱。',
  }
},
[27338] = {
  {
    'Guris ao mar‡Наши парни на берегу‡Unsere Jungs an der Küste‡해변의 병사들‡Nuestros chicos en la orilla‡Nuestros chicos en la orilla‡Nos gars sur la côte‡海滩上的水兵‡海岸邊的夥伴',
    nil,
    'Apresente-se ao Tenente Henri na Costa do Crepúsculo, que fica no Planalto do Crepúsculo.‡Отправляйтесь на Сумеречный берег на Сумеречном нагорье и поговорите с лейтенантом Эмри.‡Meldet Euch bei Leutnant Emry in Zwielichtufer im Schattenhochland.‡황혼의 고원의 황혼 해안에 있는 부관 엠리에게 보고해야 합니다.‡Preséntate ante el teniente Emry en las Orillas Crepusculares, en las Tierras Altas Crepusculares.‡Preséntate ante el teniente Emry en las Orillas Crepusculares, en las Tierras Altas Crepusculares.‡Allez vous présenter au Lieutenant Emry, sur le Rivage du Crépuscule, dans les Hautes-terres du Crépuscule.‡向暮光高地暮光海滩的海军上尉埃姆利报到。‡到暮光高地的暮光海岸向艾姆里中尉回報。',
  }
},
[27339] = {
  {
    'O ladrão de reagentes‡Подмена реактива‡Der Reagenziendieb‡약재 도둑‡El ladrón de componentes‡El ladrón de componentes‡Le voleur de composants‡沼泽中的毒药‡試劑小偷',
    nil,
    'Colete 6 ampolas de Peçonha do Pântano das Rastejantes Presanegra ou das Retalhadoras Nóxias.‡Добудьте 6 флаконов болотного яда у темноклыких ползунов и пагубных живорезов.‡Sammelt 6 Phiolen Marschengift von Dunkelzahnkrabblern oder giftigen Schreddern.‡검은송곳니 땅거미나 송곳니 맹독천둥매에게서 습지대 독 6병을 모아야 합니다.‡Reúne 6 viales de veneno de marisma de trepadores Colmiumbrío o de machacadores nocivos.‡Reúne 6 viales de veneno de marisma de trepadores Colmilo umbrío o de machacadores nocivos.‡Récupérez 6 fioles de Venin des marais de Rampants sombrecroc ou de Déchiqueteurs nocifs.‡从暗牙爬行者或毒性切割者身上收集6瓶沼泽毒药。‡從暗牙蠕行者或毒性切割者身上收集到6瓶沼澤毒液。',
  }
},
[27340] = {
  {
    'Os saqueadores de Chifrebravo‡Налетчики Дикого Рога‡Räuber des Grollhornpostens‡공포뿔 침략자‡Asaltantes del Puesto Cuernoatroz‡Asaltantes del Puesto Cuernoatroz‡Les écumeurs navrecorne‡恐角袭击者‡恐角劫掠者',
    nil,
    'Mate 12 Temível Totem no Posto Chifrebravo.‡Убейте 12 тауренов из клана Зловещего Тотема с заставы Дикого Рога.‡Tötet 12 Grimmtotem in Grollhornposten.‡공포뿔 거점에 있는 그림토템 부족 12명을 처치해야 합니다.‡Mata a 12 Tótem Siniestro en el Puesto Cuernoatroz.‡Mata a 12 Tótem Siniestro en el Puesto Cuernoatroz.‡Tuez 12 Totems-sinistres au poste de Navrecorne.‡在恐角岗哨消灭12名恐怖图腾。‡殺死12個恐角崗哨的恐怖圖騰敵人。',
  }
},
[27341] = {
  {
    'A patrulha da orla‡Разведка на побережье‡Späht den Strand aus‡해변 정찰‡Explorando la costa‡Explorando la costa‡Reconnaissance de la plage‡侦查海滩‡巡邏海岸',
    nil,
    'Patrulhe o Ponto de Controle da Cabeça de Praia na Costa do Crepúsculo. Você não precisa tomá-lo, mas, se assim o fizer, seu lado terá vantagem de combate e você será sinalizada para JxJ.‡Проведите разведку на Сумеречном берегу в окрестностях контрольного пункта берегового плацдарма. Вам не нужно его захватывать, но если вы это сделаете, то ваша сторона получит преимущество в бою, а вы перейдете в режим PvP.‡Späht den Brückenkopfkontrollpunkt in Zwielichtufer aus. Ihr müsst den Kontrollpunkt nicht einnehmen. Wenn Ihr ihn einnehmt, wird Eure Seite jedoch Vorteile im Kampf haben und Ihr werdet für PvP gekennzeichnet.‡황혼 해안에 있는 상륙 거점 제어 지점을 정찰해야 합니다. 상륙 거점 제어 지점을 꼭 점령할 필요는 없습니다. 하지만 이곳을 점령하면 얼라이언스 플레이어가 강화 효과를 받으며, 당신은 전투 상태가 됩니다.‡Explora el punto de control de punta de playa en la Orilla Crepuscular. No tienes que capturarlo, pero el hacerlo le dará a tu bando ventaja en combate y te pondrá la marca JcJ.‡Explora el punto de control de punta de playa en la Orilla Crepuscular. No tienes que capturarlo, pero el hacerlo le dará a tu bando ventaja en combate y te pondrá la marca JcJ.‡Effectuez une reconnaissance du Point de contrôle de la Tête de pont du rivage du Crépuscule. Il n\'est pas indispensable de le capturer, mais cela ferait bénéficier votre camp d\'un avantage au combat et activerait votre marqueur JcJ.‡侦查暮光海滩的滩头控制点。你不必占领控制点，但是成功占领的话，你会被标记为开启PvP状态，且你所在的营地可以获得作战优势。‡到暮光海岸的灘頭控制點進行偵查。你不用搶下它，但是這樣做將會為你的那一方帶來戰鬥的優勢，同時讓你轉為PvP模式。',
  }
},
[27342] = {
  {
    'Com o tempo, tudo será revelado.‡Со временем все раскроется‡Die Zeit löst alle Rätsel‡시간이 지나면 모두 드러나리라‡Todo se revelará, en su momento‡Todo se revelará, en su momento‡La cueillette, la guerre et la vérité‡迟早，一切都会清楚的‡時間將揭露一切',
    nil,
    'Colete 6 Acônitos.‡Собрать 6 растений аконита.‡Sammelt 6 Wolfsbann.‡늑대잡이 6개를 모아야 합니다.‡Recoge 6 aterralobos.‡Recoge 6 aterralobos.‡Cueillez 6 Aconits.‡采集6份破狼草。‡收集6份禍狼根。',
  }
},
[27343] = {
  {
    'A mão da Luz‡Длань Света‡Die Hand des Lichts‡빛의 손길‡La mano de la Luz‡La mano de la Luz‡La main de la Lumière‡圣光之手‡聖光之手',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира Спрингвейла, 5 ящиков слитков лунной стали и 5 жил нежити.‡Reist nach Burg Schattenfang und findet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Kisten Mondstahlbarren und 5 ewige Sehnen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 cajones de lingotes de acero de lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 cajones de lingotes de acero de lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 caisses de Lingots d\'acier lunaire et 5 Tendons impérissables.‡进入影牙城堡，从指挥官斯普林瓦尔那里夺得指挥官的神圣符记，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡取得指揮官斯普林瓦爾的指揮官的聖徽、5箱月鋼錠和5條不滅肌腱。',
  }
},
[27344] = {
  {
    'Uma recompensa merecida‡Заслуженная награда‡Eine wohlverdiente Belohnung‡합당한 보상‡Una recompensa bien merecida‡Una recompensa bien merecida‡Une récompense bien méritée‡应得的奖励‡應得的獎賞',
    nil,
    'Vá à Bastilha da Presa Negra e consiga a Mira de Cristal de Godfrey do Lorde Godfrey, 5 feixes de Lunalenha e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте хрустальный прицел Годфри, 5 вязанок осененного луной дерева и 5 жил нежити.‡Reist nach Burg Schattenfang und erhaltet Godfreys Kristallzielfernrohr von Lord Godfrey, 5 Bündel mondbestrahltes Holz und 5 ewige Sehnen.‡그림자송곳니 성채에서 고드프리의 수정 조준경, 달빛 깃든 나무 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén la mira de cristal de Godfrey, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén la mira de cristal de Godfrey, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez la Lunette en cristal de Godfrey, 5 fagots de Bois de Frôlelune et 5 Tendons impérissables.‡进入影牙城堡，获得高弗雷的水晶瞄准镜，还有5捆月触之木和5束不死肌腱。‡到影牙城堡取得賈佛雷的水晶望遠鏡、5捆月觸之木和5條不滅肌腱。',
  }
},
[27345] = {
  {
    'O D.C.R.‡ПУО‡Das K.d.V.‡포세이큰 통신 단말기‡El D.C.R.‡El D.C.R.‡L’A.C.R.‡死亡通讯器‡被遺忘者通訊裝置',
    nil,
    'Recupere o Dispositivo de Comunicação dos Renegados.‡Разыщите переговорное устройство Отрекшихся.‡Findet die Kommunikationsvorrichtung der Verlassenen.‡포세이큰 통신 단말기를 회수해야 합니다.‡Recupera el dispositivo de comunicación de los Renegados.‡Recupera el dispositivo de comunicación de los Renegados.‡Récupérez l’Appareil de communication réprouvé.‡找到被遗忘者的通讯装置。‡取回被遺忘者通訊裝置。',
  }
},
[27346] = {
  {
    'O zepelim caído‡Крушение дирижабля‡Der Zeppelinabsturz‡비행선 추락‡El accidente del zepelín‡El accidente del zepelín‡L\'épave du zeppelin‡坠毁的飞艇‡飛艇失事',
    nil,
    'Fale com Moxie Gradacelha nos Destroços de Beezil.‡Поговорите с Мокси Сталегриль на месте крушения дирижабля Бизила.‡Sprecht mit Moxie Stahlgrill bei Beezils Wrack.‡비질의 추락지에 있는 목시 스틸그릴과 대화해야 합니다.‡Habla con Moxie Soplete en el lugar del Siniestro de Beezil.‡Habla con Moxie Soplete en el lugar del Siniestro de Beezil.‡Parlez à Moxie Grilledacier à l\'Épave de Beezil.‡跟比吉尔的飞艇残骸的莫希·斯蒂格里谈一谈。‡跟比吉爾的飛艇殘骸的莫克希·鋼格談話。',
  }
},
[27347] = {
  {
    'Prevenção contra corrosão‡Профилактика коррозии‡Korrosionsschutz‡부식 방지‡Prevención de la corrosión‡Prevención de la corrosión‡Prévention de la corrosion‡阻止腐蚀‡預防腐蝕',
    nil,
    'Moxie Gradacelha quer que você dissolva 10 gosmas e que fale novamente com ela nos Destroços de Beezil.‡Мокси Сталегриль хочет, чтобы вы уничтожили 10 слизнюков и доложили ей о выполнении задания на месте крушения дирижабля Бизила.‡Moxie Stahlgrill möchte, dass Ihr 10 Schlamme auflöst und Euch dann bei Beezils Wrack bei ihr meldet.‡수액괴물 10마리를 녹여 처치한 후 비질의 추락지에 있는 목시 스틸그릴에게 보고해야 합니다.‡Moxie Soplete quiere que disuelvas 10 mocos y que vuelvas junto a ella al Siniestro de Beezil.‡Moxie Soplete quiere que disuelvas 10 mocos y que vuelvas junto a ella al Siniestro de Beezil.‡Dissolvez 10 limons avant de retourner voir Moxie Grilledacier, à l\'Épave de Beezil.‡莫希·斯蒂格里希望你去溶解10只软泥怪，然后回到比吉尔的飞艇残骸旁向她复命。‡莫克希·鋼格要你溶解10個軟泥怪然後回到比吉爾的飛艇殘骸向她回報。',
  }
},
[27348] = {
  {
    'O asseguramento da carga!‡Защитить груз!‡Bergt die Fracht!‡화물을 확보하라!‡¡Asegura el cargamento!‡¡Asegura el cargamento!‡Sauvez la cargaison !‡回收货物！‡收回貨物!',
    nil,
    'Moxie Gradacelha, nos Destroços de Beezil, quer que você resgate 8 peças da Carga do Zepelim.‡Мокси Сталегриль попросила вас собрать 8 контейнеров груза с дирижабля и принести ей на место крушения Бизиля.‡Moxie Stahlgrill bei Beezils Wrack möchte, dass Ihr 8 Teile der Zeppelinfracht bergt.‡비질의 추락지에 있는 목시 스틸그릴이 비행선 화물 8개를 가져다 달라고 했습니다.‡Moxie Soplete en el Siniestro de Beezil quiere que recuperes 8 trozos de cargamento del zepelín.‡Moxie Soplete en el Siniestro de Beezil quiere que recuperes 8 trozos de cargamento del zepelín.‡Retrouvez 8 morceaux de Cargaison du zeppelin, à l\'Épave de Beezil.‡比吉尔的飞艇残骸处的莫希·斯蒂格里要你找回8件飞艇上的货物。‡比吉爾的飛艇殘骸的莫克希·鋼格要你取得8個飛艇貨物。',
  }
},
[27349] = {
  {
    'Interrupção de comunicações: Posto Mirante do Medo‡Разрыв связи: Зловещая застава‡Kommunikationsabbruch: Außenposten von Schreckenswacht‡통신 두절: 공포망루 전초기지‡Comunicación entrante: Avanzada Velaspanto‡Comunicación entrante: Avanzada Velaspanto‡Le Guet-de-l’Effroi ne répond plus‡联络中断：恐惧之卫哨所‡失去通訊:恐懼守望前哨站',
    nil,
    'Investigue o Posto Mirante do Medo.‡Обследуйте Зловещую заставу.‡Erkundet den Außenposten von Schreckenswacht.‡공포망루 전초기지를 조사해야 합니다.‡Investiga la Avanzada Velaspanto.‡Investiga la Avanzada Velaspanto.‡Menez une reconnaissance à l’Avant-poste du Guet-de-l’Effroi.‡调查恐惧之卫哨所。‡調查守哨站。',
  }
},
[27350] = {
  {
    'Interrupção de comunicações: Guarda de Rutsak‡Перебои со связью: Сторожка Рутсака‡Kommunikationsabbruch: Rutsaks Wacht‡통신 두절: 루트삭의 경비소‡Comunicación entrante: Guardia de Rutsak‡Comunicación entrante: Guardia de Rutsak‡La garde de Rutsak ne répond plus‡联络中断：拉特萨克营地‡失去通訊:路特沙克之衛',
    nil,
    'Encontre o Capitão Rutsak na Guarda de Rutsak, que fica nas Ruínas de Guilnéas.‡Найдите капитана Рутсака в Сторожке Рутсака в руинах Гилнеаса.‡Findet Hauptmann Rutsak in Rutsaks Wacht in den Ruinen von Gilneas.‡길니아스 폐허에 있는 루트삭의 경비소에서 경비대장 루트삭을 찾아야 합니다.‡Busca al Capitán Rutsak en Guardia de Rutsak en las Ruinas de Gilneas.‡Busca al Capitán Rutsak en Guardia de Rutsak en las Ruinas de Gilneas.‡Trouvez le Capitaine Rutsak à la Garde de Rutsak, dans les Ruines de Gilnéas.‡去找吉尔尼斯废墟拉特萨克营地的拉特萨克队长。‡在吉爾尼斯廢墟的路特沙克之衛找到路特沙克隊長。',
  }
},
[27351] = {
  {
    'Uma real recompensa real‡Королевская награда‡Eine königliche Belohnung‡국왕의 보상‡Una recompensa real‡Una recompensa real‡Une récompense royale‡皇家的奖励‡皇家的獎賞',
    nil,
    'Vá à Bastilha da Presa Negra e consiga a Pedra de Amolar do Comandante Floraval, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте точило командира Спрингвейла, 5 слитков лунной стали и 5 жил нежити.‡Reist zu Burg Schattenfang und erhaltet Grüntals Wetzstein von Kommandant Grüntal, 5 Kisten Mondstahlbarren und 5 ewige Sehnen.‡그림자송곳니 성채에서 스프링베일의 숫돌, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén la piedra de afilar del comandante Vallefont, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén la piedra de afilar del comandante Vallefont, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez la Pierre à aiguiser de Printeval sur le Commandant Printeval, 5 caisses de Lingots d\'acier lunaire et 5 Tendons impérissables.‡进入影牙城堡，从指挥官斯普林瓦尔那里夺得斯普林瓦尔的磨刀石，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡取得指揮官斯普林瓦爾身上的普林瓦爾的磨刀石，5箱月鋼錠，和5條不死肌腱。',
  }
},
[27352] = {
  {
    'Ouro líquido‡Жидкое золото‡Flüssiges Gold‡수금‡Oro líquido‡Oro líquido‡De l\'or liquide‡液体黄金‡液體黃金',
    nil,
    'Encontre uma ampola de Água Benta de Stratholme.‡Найдите сосуд со святой водой Стратхольма.‡Findet eine Phiole mit Weihwasser von Stratholme.‡스트라솔름 성수를 한 병 찾아야 합니다.‡Encuentra un vial de agua bendita de Stratholme.‡Encuentra un vial de agua bendita de Stratholme.‡Trouvez une fiole d\'Eau sacrée de Stratholme.‡找到一瓶斯坦索姆圣水。‡找出1瓶斯坦索姆聖水。',
  }
},
[27353] = {
  {
    'Bênção dos elementos‡Благословение стихий‡Segen der Elemente‡원소의 축복‡Bendiciones de los elementos‡Bendiciones de los elementos‡La bénédiction des éléments‡元素的祝福‡元素的祝福',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Talismã de Walden, o Livro das Almas Perdidas e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте талисман Вальдена, книгу Потерянных Душ и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet den Waldens Talisman, das Buch der verlorenen Seelen und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 월든의 부적, 잃어버린 영혼의 서, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el dije de Lord Walden, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el dije de Lord Walden, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Talisman de Walden, le Livre des âmes perdues et 5 Essences fantomatiques.‡进入影牙城堡，夺取沃登的护符，还有迷失灵魂之书和5份幽灵精华。‡到影牙城堡取得瓦爾登的咒符，失落靈魂之書，和5件鬼魅精華。',
  }
},
[27354] = {
  {
    'O domínio do poder arcano‡Постижение тайной магии‡Beherrschung des Arkanen‡비전 숙달‡Dominando lo Arcano‡Dominando lo Arcano‡La maîtrise des Arcanes‡领悟奥术‡精通秘法',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Cristal Encantado de Silverlaine do Barão Silverlaine, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте зачарованный кристалл Сильверлейна у барона Сильверлейна, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erlangt Silberleins verzauberten Kristall von Baron Silberlein, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채로 가서 실버레인의 마력 깃든 수정, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el cristal encantado Filargenta del barón Filargenta, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el cristal encantado Filargenta del barón Filargenta, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Cristal enchanté d\'Argelaine sur le Baron d\'Argelaine, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡进入影牙城堡，从席瓦莱恩男爵那里夺得席瓦莱恩魔化水晶，并收集5捆月触之木和5个幽灵精华。‡到影牙城堡取得席瓦萊恩男爵的附魔水晶、5捆月觸之木和5件鬼魅精華。',
  }
},
[27355] = {
  {
    'Bênção para os fortes‡Уважение силы‡Ein Segen für die Mächtigen‡힘을 위한 혜택‡Un presente para los poderosos‡Un presente para los poderosos‡La reconnaissance des puissants‡皇室的恩赐‡給強者的恩惠',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Orbe Tenebroso do Lorde Godfrey, o Livro das Almas Perdidas e 5 Essências Fantasmagóricas.‡Отправляйтесь к крепость Темного Клыка и добудьте зловещее око, книгу Потерянных Душ и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet die Finstere Kugel von Lord Godfrey, das Buch der verlorenen Seelen und 5 geisterhafte Essenzen.‡그림자송곳니 성채로 가서 고드프리 경의 음침한 보주, 잃어버린 영혼의 서, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el orbe tenebroso de Lord Godfrey, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el orbe tenebroso de Lord Godfrey, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez l\'Orbe ténébreux sur le seigneur Godfrey, le Livre des âmes perdues et 5 Essences fantomatiques.‡进入影牙城堡，从高弗雷勋爵那里夺得晦暗之球，还有迷失灵魂之书和5份幽灵精华。‡到影牙城堡取得高佛雷領主手握的陰暗寶珠，失落靈魂之書，和5件鬼魅精華。',
  }
},
[27356] = {
  {
    'O futuro do Círculo‡Будущее Круга‡Die Zukunft des Zirkels‡의회의 미래‡El futuro del círculo‡El futuro del círculo‡L\'avenir du Cercle‡议会的未来‡議會的未來',
    nil,
    'Vá à Bastilha da Presa Negra e consiga os Elixires de Walden do Lorde Walden, 5 feixes de Lunalenha e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте эликсиры Вальдена, 5 связок осененного луной дерева и 5 жил нежити.‡Reist nach Burg Schattenfang und erhaltet Waldens Elixire von Lord Walden, 5 Bündel mondbestrahltes Holz und 5 ewige Sehnen.‡그림자송곳니 성채에서 월든의 비약, 달빛 깃든 나무 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén los elixires de Walden, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén los elixires de Walden, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez les Élixirs de Walden sur le Seigneur Walden, 5 fagots de Bois de Frôlelune et 5 Tendons impérissables.‡进入影牙城堡，从沃登勋爵那里夺取沃登的药剂，还有5捆月触之木和5束不死肌腱。‡到影牙城堡取得瓦爾登領主的藥劑、5捆月觸之木和5條不滅肌腱。',
  }
},
[27357] = {
  {
    'A noiva cativa‡Невеста поневоле‡Die gefangene Braut‡납치된 신부‡La novia cautiva‡La novia cautiva‡La fiancée captive‡压寨夫人‡被俘虜的新娘',
    nil,
    'Fale com Lakota Cantéolo no Pináculo da Nuvem Negra, que fica em Mil Agulhas.‡Поговорите с Лакотой Песней Ветра на Пике Темного Облака в Тысяче Игл.‡Sprecht mit Lakota Windweise in Düsterwolkengipfel in Tausend Nadeln.‡버섯구름 봉우리의 먹구름 봉우리에 있는 라코타 윈드송과 대화해야 합니다.‡Habla con Lakota Son del Viento en la Cumbre de la Nube Negra, en Las Mil Agujas.‡Habla con Lakota Son del Viento en la Cumbre de la Nube Negra, en Las Mil Agujas.‡Parlez à Lakota Chant-du-vent à la Cime de Noir-Nuage.‡跟千针石林黑云峰的拉克塔·风歌谈一谈。‡在千針石林的暗雲峰與拉克塔‧風歌交談。',
  }
},
[27358] = {
  {
    'A noiva cativa‡Невеста поневоле‡Die gefangene Braut‡납치된 신부‡La novia cautiva‡La novia cautiva‡La fiancée captive‡压寨夫人‡被俘虜的新娘',
    nil,
    'Fale com Lakota Cantéolo no Pináculo da Nuvem Negra, que fica em Mil Agulhas.‡Поговорите с Лакотой Песней Ветра на Пике Темного Облака в Тысяче Игл.‡Sprecht mit Lakota Windweise in Düsterwolkengipfel in Tausend Nadeln.‡버섯구름 봉우리의 먹구름 봉우리에 있는 라코타 윈드송과 대화해야 합니다.‡Habla con Lakota Son del Viento en la Cumbre de la Nube Negra, en Las Mil Agujas.‡Habla con Lakota Son del Viento en la Cumbre de la Nube Negra, en Las Mil Agujas.‡Parlez à Lakota Chant-du-vent à la Cime de Noir-Nuage.‡跟千针石林黑云峰的拉克塔·风歌谈一谈。‡在千針石林的暗雲峰與拉克塔‧風歌交談。',
  }
},
[27359] = {
  {
    'Reforços argênteos‡Алое подкрепление‡Verstärkung der Argentumdämmerung‡은빛 증원군‡Refuerzos Argenta‡Refuerzos Argenta‡Des renforts de la Croisade d\'argent‡银色援兵‡銀白援兵',
    nil,
    'Colete 4 Essências de Banshee.‡Раздобудьте 4 сущности банши.‡Erhaltet 4 Essenzen einer Banshee.‡밴시의 정수를 4개 모아야 합니다.‡Obtén 4 esencias de alma en pena.‡Obtén 4 esencias de alma en pena.‡Obtenez 4 Essences de banshee.‡获取4份女妖精华。‡取得4個女妖精華。',
  }
},
[27360] = {
  {
    'Vingue nossos soldados‡Месть за наших‡Rache für unsere Soldaten‡병사들을 위한 복수‡Vengar a nuestros soldados‡Vengar a nuestros soldados‡Mais où est donc passée la septième légion ?‡为我们的士兵们复仇‡為我們的士兵報仇',
    nil,
    'Mate 10 Tripulantes de Submarino da 7ª Legião.‡Уничтожьте 10 подводников 7-го легиона.‡Tötet 10 Unterseebootmatrosen der 7. Legion.‡7군단 잠수요원 10명을 처치해야 합니다.‡Mata a 10 submarinistas de la Séptima Legión.‡Mata a 10 submarinistas de la Séptima Legión.‡Tuez 10 Sous-mariniers de la 7e Légion.‡杀死10名第七军团潜水员。‡殺死10名第七軍團潛水艇船員。',
  }
},
[27361] = {
  {
    'Protegido pela Luz‡Избранник Света‡Vom Licht begünstigt‡빛의 호의‡Los favoritos de la Luz‡Los favoritos de la Luz‡Dans les faveurs de la Lumière‡圣光的眷顾‡聖光的照護',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира у командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 구해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27362] = {
  {
    'Protegido de Eluna‡Избранник Элуны‡Elunes Liebling‡엘룬의 호의‡Los favoritos de Elune‡Los favoritos de Elune‡Dans les faveurs d’Élune‡艾露恩的眷顾‡伊露恩的照護',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира у командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27363] = {
  {
    '‡Талантливый молодой хирург‡Vielversprechend für den Chirurgenberuf‡특출난 초보 치유사‡Cirujanos jóvenes y prometedores‡‡Un apprenti chirurgien prometteur‡崭露头角的医师‡前途光明的年輕外科醫生',
    nil,
    '‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира у командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27364] = {
  {
    'A mando de quem?‡По чьему приказу?‡Auf wessen Befehl?‡누구 명령으로?‡¿Quién lo ordena?‡¿Quién lo ordena?‡Mais quels sont leurs ordres ?‡谁下的令？‡誰的命令?',
    nil,
    'Encontre as Ordens do Alto Comando.‡Добудьте приказы верховного командования.‡Findet die Befehle des Oberkommandos.‡총사령관의 명령서를 회수해야 합니다.‡Recupera las órdenes del Alto Mando.‡Recupera las órdenes del Alto Mando.‡Trouvez les Ordres du haut commandement.‡获得高级指挥官的命令。‡在司令部找出相關的命令文件。',
  }
},
[27365] = {
  {
    'Uma arma apropriada‡Достойное оружие‡Eine passende Waffe‡적절한 무기‡Un arma adecuada‡Un arma adecuada‡Une arme adéquate‡合适的武器‡合適的武器',
    nil,
    'Vá à Bastilha da Presa Negra e recupere a Espada da Família Silverlaine do Barão Silverlaine, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка, добудьте у барона Сильверлейна меч семьи Сильверлейнов, а также 5 слитков лунной стали и 5 жил нежити.‡Reist zu Burg Schattenfang und erhaltet das Schwert der Familie Silberlein vom Baron, 5 Kisten Mondstahlbarren und 5 ewige Sehnen.‡그림자송곳니 성채에서 실버레인 가문의 검, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén la espada de la familia Filargenta del barón Filargenta, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén la espada de la familia Filargenta del barón Filargenta, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez l\'Épée de la famille d\'Argelaine sur le Baron d\'Argelaine, 5 caisses de Lingots d\'acier lunaire et 5 Tendons impérissables.‡进入影牙城堡，从席瓦莱恩男爵那里夺得席瓦莱恩家族佩剑，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡取得席瓦萊恩男爵的席瓦萊恩家傳長劍，5箱月鋼錠，和5條不死肌腱。',
  }
},
[27366] = {
  {
    'Apego à terra‡Захват земель‡Landerschließung‡내 땅이야‡Conquista‡Conquista‡Prise de terre‡夺取海滩‡搶地',
    nil,
    'Mate 12 Fuzileiros Mordacha na Costa do Crepúsculo, que fica no Planalto do Crepúsculo.‡Убейте 12 закаленных стражей на Сумеречном берегу на Сумеречном нагорье.‡Tötet 12 Marinesoldaten der Axtbeißer am Zwielichtufer im Schattenhochland.‡황혼의 고원의 황혼 해안에 있는 도끼이빨 해병 12명을 처치해야 합니다.‡Mata a 12 marinos Muerdehacha en las Orillas Crepusculares, en las Tierras Altas Crepusculares.‡Mata a 12 marinos Muerdehacha en las Orillas Crepusculares, en las Tierras Altas Crepusculares.‡Tuez 12 Soldats de marine hache-crocs sur le Rivage du Crépuscule, dans les Hautes-terres du Crépuscule.‡在暮光高地的暮光海滩干掉12名斧咬陆战队员。‡到暮光高地的暮光海岸殺死12位斧咬水兵。',
  }
},
[27367] = {
  {
    'Gidwin Fitáurea‡Гидвин Златокос‡Gidwin Goldzopf‡기드윈 골드브레이즈‡Gidwin Trenzadorada‡Gidwin Trenzadorada‡Gidwin Nattes-d’Or‡吉德文·金须‡基德溫‧金辮',
    nil,
    'Encontre Gidwin Fitáurea nas Terras Pestilentas Orientais.‡Найдите Гидвина Златокоса в Восточных Чумных землях.‡Findet Gidwin Goldzopf in den Östlichen Pestländern.‡동부 역병지대에서 기드윈 골드브레이즈를 찾아야 합니다.‡Encuentra a Gidwin Trenzadorada en las Tierras de la Peste del Este.‡Encuentra a Gidwin Trenzadorada en las Tierras de la Peste del Este.‡Trouvez Gidwin Nattes-d’Or dans les Maleterres de l\'Est.‡去找东瘟疫之地的吉德文·金须。‡到東瘟疫之地找基德溫‧金辮。',
  }
},
[27368] = {
  {
    'Recém-preso‡В сети‡Nur eingehüllt‡딱 갇혔어요‡Enredado‡Enredado‡Légèrement englué‡缚手缚脚‡只是被打包了而已',
    nil,
    'Obtenha 8 frascos de Bile de Cripta de nerubianos no Túnel Terrorteia.‡Наберите 8 сосудов кишечной слизи нерубов в Туннеле Ужаса.‡Erhaltet 8 Phiolen Kryptengalle von den Nerubern im Schreckenstunnel.‡공포의 거미굴에 있는 네루비안에게서 지하 담즙 8병을 입수해야 합니다.‡Consigue 8 viales de bilis de cripta de los nerubianos en el Túnel Terroarácnido.‡Consigue 8 viales de bilis de cripta de los nerubianos en el Túnel Terroarácnido.‡Récupérez 8 fioles de Bile de la crypte sur des Nérubiens, dans le Tunnel de Tisse-terreur.‡从恶蛛隧道中的蛛魔身上收集8瓶地穴蛛魔胆汁。‡到惡蛛隧道去，從奈幽蛛怪的身上取得8瓶墓穴膽汁。',
  }
},
[27369] = {
  {
    'Azeitando a roda‡Не подмажешь – не поедешь‡Das Rad schmieren‡뇌물 바치기‡Engrasando la rueda‡Engrasando la rueda‡Graisser les roues‡讨好之举‡給輪子上油',
    nil,
    'Colete 10 Sinos da Banshee da margem do Rio Thondroril.‡Соберите 10 колокольчиков банши на берегу реки Тондрорил.‡Pflückt 10 Bansheeglocken vom Ufer des Thondroril.‡톤드로릴 강가에서 귀곡령 종꽃 10송이를 캐야 합니다.‡Saquea 10 corolas de alma en pena en la ribera del Río Thondroril.‡Saquea 10 corolas de alma en pena en la ribera del Río Thondroril.‡Ramassez 10 Clochettes de banshee le long des rives de la Thondroril.‡在索多里尔河沿岸采集10朵女妖之铃。‡從索多里爾河河岸搜刮10個女妖之鈴。',
  }
},
[27370] = {
  {
    'Tarenar Golpessol‡Таренар Удар Солнца‡Tarenar Sonnenhieb‡타레나 선스트라이크‡Tarenar Golpe Solar‡Tarenar Golpe Solar‡Tarenar Frappesoleil‡塔伦纳·射日者‡塔瑞納爾‧日擊',
    nil,
    'Encontre Tarenar Golpessol no Degrau da Morte, que fica nas Terras Pestilentas Orientais.‡Найдите Таренара Удар Солнца в Ступенях Смерти в Восточных Чумных землях.‡Findet Tarenar Sonnenhieb an der Treppe des Schnitters in den Östlichen Pestländern.‡동부 역병지대 죽음의 발자취에서 타레나 선스트라이크를 찾아야 합니다.‡Encuentra a Tarenar Golpe Solar en la Grada de la Muerte en las Tierras de la Peste del Este.‡Encuentra a Tarenar Golpe Solar en la Grada de la Muerte en las Tierras de la Peste del Este.‡Trouvez Tarenar Frappesoleil au Pas de la mort, dans les Maleterres de l\'Est.‡去找东瘟疫之地死亡小径的塔伦纳·射日者。‡到東瘟疫之地的死亡足音去找塔瑞納爾‧日擊。',
  }
},
[27371] = {
  {
    'O que faço de melhor‡Мои таланты‡Was ich am besten kann‡가장 잘하는 일‡Lo que mejor sé hacer‡Lo que mejor sé hacer‡Ce que je fais le mieux‡我最擅长的事‡我最會幹的事',
    nil,
    'Mate 5 Aberrações do Degrau da Morte no Degrau da Morte, que fica nas Terras Pestilentas Orientais.‡Уничтожьте 5 зомби в Ступенях Смерти, что в Восточных Чумных землях.‡Tötet 5 Missgeburten der Treppe des Schnitters an der Treppe des Schnitters in den Östlichen Pestländern.‡동부 역병지대의 사신의 발자국에서 죽음의 발자취 괴생명체 5마리를 처치해야 합니다.‡Mata a 5 deformidades Pasomuerte en la Grada de la Muerte en las Tierras de la Peste del Este.‡Mata a 5 deformidades Pasomuerte en la Grada de la Muerte en las Tierras de la Peste del Este.‡Tuez 5 Difformités du Pas de la mort au Pas de la mort, dans les Maleterres de l\'Est.‡在东瘟疫之地的死亡小径杀死5只死亡小径畸形怪。‡在東瘟疫之地的死亡足音殺死5個死亡足音畸形體。',
  }
},
[27372] = {
  {
    'Um presente para Fiona‡Подарок для Фионы‡Ein Geschenk für Fiona‡피오나에게 줄 선물‡Un regalo para Fiona‡Un regalo para Fiona‡Un cadeau pour Fiona‡给菲奥拉的礼物‡給菲歐娜的禮物',
    nil,
    'Obtenha 10 amostras de Sangue de Cão Pestilento.‡Соберите 10 образцов крови чумных псов.‡Erhaltet 10 Proben des Bluts eines Seuchenhundes.‡역병사냥개 피 견본 10개를 입수해야 합니다.‡Consigue 10 muestras de sangre de can de peste.‡Consigue 10 muestras de sangre de can de peste.‡Obtenez 10 Échantillons de Sang de chien pestiféré.‡收集10份天灾犬之血。‡取得10份瘟疫犬血液。',
  }
},
[27373] = {
  {
    'Adiante, rumo à Capela Esperança da Luz‡Вперед, к часовне Последней Надежды!‡Auf zur Kapelle des Hoffnungsvollen Lichts‡희망의 빛 예배당으로!‡Adelante, hacia la Capilla de la Esperanza de la Luz‡Adelante, hacia la Capilla de la Esperanza de la Luz‡Vers la chapelle de l\'Espoir de Lumière‡前往圣光之愿礼拜堂‡繼續向聖光之願禮拜堂前進',
    nil,
    'Suba à bordo da Caravana da Fiona no Rio Thondroril, que fica nas Terras Pestilentas Orientais.‡Присоединяйтесь к каравану Фионы у реки Тондрорил в Восточных Чумных землях.‡Steigt auf Fionas Karawanenwagen am Thondroril in den Östlichen Pestländern.‡동부 역병지대 톤드로릴 강에서 피오나의 짐마차에 탑승해야 합니다.‡Sube a la caravana de Fiona en el Río Thondroril en las Tierras de la Peste del Este.‡Sube a la caravana de Fiona en el Río Thondroril en las Tierras de la Peste del Este.‡Montez dans la Caravane de Fiona près de la Thondroril, dans les Maleterres de l\'Est.‡在东瘟疫之地的索多里尔河搭乘菲奥拉的马车。‡在東瘟疫之地的索多里爾河登上菲歐娜的馬車。',
  }
},
[27374] = {
  {
    'Ventre da Loucura‡Бездна безумия‡Der Schlund des Wahnsinns‡광기의 구렁텅이‡Las Fauces de la Locura‡Las Fauces de la Locura‡L\'antre de la folie‡疯狂之喉‡瘋狂之口',
    nil,
    'Fale com o Arauto da Terra Torunscar no Círculo dos Elementos.‡Поговорите с Заклинателем земли Торунскаром в Круге Стихий.‡Sprecht am Kreis der Elemente mit Erdenrufer Torunskar.‡정령의 너른땅에 있는 대지술사 토룬스카와 대화해야 합니다.‡Habla con el clamatierras Torunscar en el Círculo de los Elementos.‡Habla con el clamatierras Torunscar en el Círculo de los Elementos.‡Allez voir l\'Implorateur de la terre Torunscar au Cercle des éléments.‡跟元素法阵的唤地者托伦斯卡谈一谈。‡到元素之環找喚地者托倫斯卡。',
  }
},
[27375] = {
  {
    'A ferida aberta‡Кровоточащая рана‡Die Schwärende Wunde‡피 흘리는 대지‡La herida sollozante‡La herida sollozante‡La plaie purulente‡流脓的伤口‡流血的傷口',
    nil,
    'Fale com o Arauto da Terra Torunscar no Círculo dos Elementos.‡Поговорите с Заклинателем земли Торунскаром в Круге Стихий.‡Sprecht mit Erdenrufer Torunskar am Kreis der Elemente.‡정령의 너른땅에 있는 대지술사 토룬스카와 대화해야 합니다.‡Habla con el clamatierras Torunscar en el Círculo de los Elementos.‡Habla con el clamatierras Torunscar en el Círculo de los Elementos.‡Allez voir l\'Implorateur de la terre Torunscar au Cercle des éléments.‡跟元素法阵的唤地者托伦斯卡谈一谈。‡到元素之環去和喚地者托倫斯卡交談。',
  }
},
[27376] = {
  {
    'Nas entranhas de Iso\'rath‡Пасть Изо\'рата‡Das Maul von Iso\'rath‡이소라스의 입‡Las fauces de Iso\'rath‡Las fauces de Iso\'rath‡La gueule d\'Iso\'rath‡厄索拉斯之喉‡土靈之翼',
    nil,
    'Monte num grifo para se juntar ao ataque a Iso\'rath.‡Садитесь на грифона и присоединяйтесь к атаке на Изо\'рата.‡Steigt auf einen Greifen, um dem Angriff auf Iso\'rath beizutreten.‡그리핀에 올라타 이소라스 공격에 참여해야 합니다.‡Monta en un grifo para unirte al ataque contra Iso\'rath.‡Monta en un grifo para unirte al ataque contra Iso\'rath.‡Prenez un griffon pour vous joindre au combat contre Iso\'rath.‡骑一头狮鹫加入对厄索拉斯的进攻。‡乘上獅鷲獸，加入對伊索拉斯的突襲行動。',
  }
},
[27377] = {
  {
    'Devorados‡Пожиратель‡Verschlungen‡야수의 뱃속‡Devorado‡Devorado‡Dévorés‡消化‡吞噬',
    nil,
    'Proteja a Arauto da Terra Yevaa e a si mesma das defesas corporais de Iso\'rath.‡Защитите себя и заклинательницу земли Еву от атак Изо\'рата.‡Schützt Euch und Erdenruferin Yevaa vor Iso\'raths körperlicher Verteidigung.‡대지술사 예바와 자기 자신을 이소라스의 자가 방어 활동에서 보호해야 합니다.‡Defiéndete a ti y a la clamatierras Yevaa de las defensas corporales de Iso\'rath.‡Defiéndete a ti y a la clamatierras Yevaa de las defensas corporales de Iso\'rath.‡Défendez l\'Imploratrice de la terre Yevaa et vous-même contre les défenses corporelles d\'Iso\'rath.‡保护你和唤地者耶法免受厄索拉斯防御机制的伤害。‡保護自己和喚地者伊瓦不被伊索拉斯身體的防禦機制所消滅。',
  }
},
[27378] = {
  {
    'O Quebramundo‡Разрушитель миров‡Der Weltenbrecher‡세계파괴자‡El Rompemundos‡El Rompemundos‡Le Brise-monde‡灭世者‡碎界者',
    nil,
    'Derrote Asa da Morte, o Aspecto da Morte.‡Победите Смертокрыла, Аспекта смерти.‡Bezwingt Todesschwinge, den Aspekt des Todes.‡죽음의 위상, 데스윙을 쓰러뜨려야 합니다.‡Derrota a Alamuerte, el Aspecto de la Muerte.‡Derrota a Alamuerte, el Aspecto de la Muerte.‡Tuez Aile de mort, l\'Aspect de la mort.‡打败死亡的化身，死亡之翼。‡擊敗死亡化身:死亡之翼。',
  }
},
[27379] = {
  {
    'Os horrores de Iso\'rath‡Ужас Изо\'рата‡Die Schrecken des Iso\'rath‡이소라스의 공포‡Los terrores de Iso\'rath‡Los terrores de Iso\'rath‡Les terreurs d\'Iso\'rath‡厄索拉斯的恐怖‡伊索拉斯的恐怖',
    nil,
    'Resgate Hargoth Flamaturva, o Reparador da Terra Duarn, a Tempestária Jalara e a Tempestária Mylra.|n|nRetorne para a segurança de um xamã se as defesas de Iso\'rath estiverem consumindo você.‡Спасите Харгота Бледное Пламя, целителя земли Дуарна, буревестницу Джалару и буревестницу Милру.|n|nВозвращайтесь под защиту ауры шамана, если Изо\'рат начнет вас переваривать.‡Rettet Hargoth Trübflamm, Erdheiler Duarn, Sturmruferin Jalara und Sturmruferin Mylra.|n|nKehrt in den Schutz der anderen Schamanen zurück, wenn Iso\'raths Verteidigung Euch zusetzt.‡하고스 딤블레이즈, 대지치유사 두아른, 폭풍소환사 잘라라, 폭풍소환사 마일라를 구출해야 합니다.|n|n이소라스의 소화액에 소화될 것 같으면 주술사들이 만든 보호막 안에 들어가십시오.‡Rescata a Hargoth Llamatenue, al ensalmador de la tierra Duarn, a la clamatormentas Jalara y a la clamatormentas Mylra.|n|nPonte a salvo con los otros chamanes si las defensas de Iso\'rath empiezan a devorarte.‡Rescata a Hargoth Llamatenue, al ensalmador de la tierra Duarn, a la clamatormentas Jalara y a la clamatormentas Mylra.|n|nPonte a salvo con los otros chamanes si las defensas de Iso\'rath empiezan a devorarte.‡Sauvez Hargoth Frêle-brasier, le Soigneterre Duarn et les Mande-foudres Jalara et Mylra.|n|nRetournez vous abriter auprès des autres chamans si les défenses d\'Iso\'rath commencent à vous dévorer.‡营救哈尔格斯·黯刃、大地治愈者达鲁、风暴召唤者贾拉娜，以及风暴召唤者米尔拉。|n|n如果厄索拉斯要将你消化掉了，就到其他萨满那里寻求庇护。‡救出哈苟斯‧黯光、大地治癒者杜亞恩、風暴召喚者賈菈菈、以及風暴召喚者米爾拉。|n|n如果伊索拉斯的防禦開始吞噬你，回到其他薩滿所製造的安全區域。',
  }
},
[27380] = {
  {
    'Onirodinia‡Кошмар‡Alptraum‡이소라스의 악몽‡Pesadilla‡Pesadilla‡Le cauchemar‡噩梦‡夢魘',
    nil,
    'Destrua o Cérebro de Iso\'rath.‡Уничтожьте мозг Изо\'рата.‡Zerstört Iso\'raths Gehirn.‡이소라스의 뇌를 파괴해야 합니다.‡Destruye el cerebro de Iso\'rath.‡Destruye el cerebro de Iso\'rath.‡Détruisez le Cerveau d\'Iso\'rath.‡摧毁厄索拉斯之脑。‡摧毀伊索拉斯之腦。',
  }
},
[27381] = {
  {
    'Companheiros de viagem‡Попутчики‡Reisegefährten‡길동무‡Compañeros de viaje‡Compañeros de viaje‡Compagnons de voyage‡旅伴‡旅伴',
    nil,
    'Encontre alguém na Torre da Coroa que queira se juntar à sua caravana.‡Найдите в Башне королевской стражи того, кто захочет присоединиться к вашему каравану.‡Findet jemanden am Turm der Kronenwache, der sich Eurer Reisegruppe anschließen möchte.‡산마루 경비탑에서 함께 여행할 사람을 찾아야 합니다.‡Encuentra a alguien en la Torre de la Corona que quiera unirse a la caravana.‡Encuentra a alguien en la Torre de la Corona que quiera unirse a la caravana.‡Trouvez quelqu\'un à la Tour de garde de la Couronne qui acceptera de rejoindre votre caravane.‡在皇冠哨塔找到愿意与你们同行的人。‡在皇冠哨塔找個人加入你們的車隊。',
  }
},
[27382] = {
  {
    'Estradas tortuosas‡Плохие дороги‡Verseuchte Straßen‡거친 길‡Caminos difíciles‡Caminos difíciles‡Chemins difficiles‡危险的道路‡艱苦的路',
    nil,
    'Mate 13 Quirópragos ao longo do caminho para a Torre Escudo da Luz.‡Убейте 13 чумных нетопырей на тропе, ведущей в Башню Защиты Света.‡Tötet 13 Seuchenfledermäuse entlang des Wegs zum Lichtschildturm.‡빛의 방패 경비탑으로 가는 길에서 역병박쥐 13마리를 처치해야 합니다.‡Mata a 13 murcipestes a lo largo del sendero que lleva a la Torre del Escudo de la Luz.‡Mata a 13 murcipestes a lo largo del sendero que lleva a la Torre del Escudo de la Luz.‡Tuez 13 Chauves-souris pestiférées le long du chemin menant à la Tour du bouclier de la Lumière.‡在通向圣光之盾哨塔的道路旁消灭13只天灾蝙蝠。‡沿著通往光盾哨塔的路殺死13隻瘟疫蝙蝠。',
  }
},
[27383] = {
  {
    'Pequena Pâmela‡Малышка Памела‡Klein-Pamela‡꼬마 파멜라‡La pequeña Pamela‡La pequeña Pamela‡La petite Pamela‡小帕米拉‡小帕米拉',
    nil,
    'Encontre Pâmela Trilharrubra na Vila das Flechas.‡Найдите Памелу Редпат в Дарроушире.‡Sucht in Darroheim nach Pamela Rotpfad.‡다로우골에 있는 파멜라 레드패스를 찾아야 합니다.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Retrouvez Pamela Senterouge à Comté-de-Darrow.‡在达隆郡找到帕米拉·雷德帕斯。‡到達隆郡找尋帕米拉·雷德帕斯。',
  }
},
[27384] = {
  {
    'A boneca de Pâmela‡Кукла Памелы‡Pamelas Puppe‡파멜라의 인형‡La muñeca de Pamela‡La muñeca de Pamela‡La poupée de Pamela‡帕米拉的洋娃娃‡帕米拉的洋娃娃',
    nil,
    'Encontre a boneca de Pâmela.‡Найдите куклу Памелы.‡Sucht Pamelas Puppe.‡파멜라의 인형을 찾아야 합니다.‡Encuentra la muñeca de Pamela.‡Encuentra la muñeca de Pamela.‡Trouvez la Poupée de Pamela.‡找到帕米拉的洋娃娃。‡找到帕米拉的洋娃娃。',
  }
},
[27385] = {
  {
    'Tio Carlin‡Дядюшка Карлин‡Onkel Carlin‡카를린 삼촌‡Tío Carlin‡Tío Carlin‡Oncle Carlin‡卡林叔叔‡卡林叔叔',
    nil,
    'Fale novamente com Carlin Trilharrubra na Torre da Coroa, que fica nas Terras Pestilentas Orientais.‡Вернитесь к Карлину Редпату к башне Королевской Стражи в Восточных Чумных землях.‡Kehrt zu Carlin Rotpfad am Turm der Kronenwache in den Östlichen Pestländern zurück.‡동부 역병지대의 산마루 경비탑에 있는 카를린 레드패스에게 가야 합니다.‡Vuelve con Carlin Rutagrana en la Torre de la Corona en las Tierras de la Peste del Este.‡Vuelve con Carlin Rutagrana en la Torre de la Corona en las Tierras de la Peste del Este.‡Retournez voir Carlin Senterouge à la Tour de garde de la Couronne, dans les Maleterres de l\'Est.‡去东瘟疫之地的皇冠哨塔找到卡林·雷德帕斯。‡到東瘟疫之地的皇冠哨塔找卡林·雷德帕斯。',
  }
},
[27386] = {
  {
    'Uma historiadora estranha‡Странный историк‡Ein seltsamer Historiker‡이상한 역사가‡Una extraña historiadora‡Una extraña historiadora‡Une étrange historienne‡古怪的历史学家‡古怪的歷史學家',
    nil,
    'Leve a Lâmina de Caça do Josefo para a Crona.‡Отнесите охотничий клинок Джозефа Хроми.‡Bringt Josephs Jagdklinge zu Chromie.‡조셉의 사냥 칼날을 크로미에게 가져가야 합니다.‡Lleva la hoja de cazar de Joseph a Cromi.‡Lleva la hoja de cazar de Joseph a Cromi.‡Apportez la Lame de chasse de Joseph à Chromie.‡把约瑟夫的猎刀交给克罗米。‡將約瑟夫的獵刀帶去給克羅米。',
  }
},
[27387] = {
  {
    'Vilões da Vila das Flechas‡Негодяи Дарроушира‡Bösewichte von Darroheim‡다로우골의 악당들‡Los villanos de Villa Darrow‡Los villanos de Villa Darrow‡Les vilains de Comté-de-Darrow‡达隆郡的恶魔‡達隆郡的惡魔',
    nil,
    'Leve o Crânio de Horgus e a Espada Estilhaçada de Marduk para a Crona, na Torre da Coroa, que fica nas Terras Pestilentas Orientais.‡Принесите череп Хоргуса и сломанный меч Мардука Хроми в Башню королевской стражи в Восточных Чумных землях.‡Bringt den Schädel von Horgus und das zertrümmerte Schwert von Marduk zu Chromie am Turm der Kronenwache in den Östlichen Pestländern.‡동부 역병지대의 산마루 경비탑에 있는 크로미에게 호르구스의 해골과 부러진 마르두크의 검을 가져가야 합니다.‡Lleva el cráneo de Horgus y la espada destrozada de Marduk a Cromi en la Torre de la Corona en las Tierras de la Peste del Este.‡Lleva el cráneo de Horgus y la espada destrozada de Marduk a Cromi en la Torre de la Corona en las Tierras de la Peste del Este.‡Apportez le Crâne d\'Horgus et l’Épée brisée de Marduk à Chromie, à la Tour de garde de la Couronne, dans les Maleterres de l\'Est.‡将霍古斯的徽记和马杜克的破碎之剑交给东瘟疫之地皇冠哨塔的克罗米。‡將霍古斯的顱骨和馬杜克的破碎之劍帶去東瘟疫之地的皇冠哨塔，交給克羅米。',
  }
},
[27388] = {
  {
    'Heróis da Vila das Flechas‡Герои Дарроушира‡Helden von Darroheim‡다로우골의 영웅들‡Los héroes de Villa Darrow‡Los héroes de Villa Darrow‡Les héros de Comté-de-Darrow‡达隆郡的英雄‡達隆郡的英雄',
    nil,
    'Obtenha os Anais Estendidos da Vila das Flechas com o Carlin Trilharrubra, e obtenha o Incunábulo de Davil e o Escudo de Trilharrubra no Sítio dos Marris.‡Добудьте дополненные анналы Дарроушира у Карлин Редпат и заберите в поместье Маррисов манускрипт Дейвила и щит Редпата.‡Erhaltet die Erweiterten Annalen von Darroheim von Carlin Rotpfad sowie Davils Buchband und Rotpfads Schild in Marris\' Siedlung.‡카를린 레드패스에게 확장된 다로우골 연대기를 얻어야 합니다. 그리고 매리스 농장에서 다빌의 성서와 레드패스의 방패를 가져가야 합니다.‡Consigue las Crónicas ampliadas de Villa Darrow de Carlin Rutagrana. Y consigue el Tratado de Davil y el escudo de Rutagrana en la Hacienda de Marris.‡Consigue las Crónicas ampliadas de Villa Darrow de Carlin Rutagrana. Y consigue el Tratado de Davil y el escudo de Rutagrana en la Hacienda de Marris.‡Demandez les Annales complètes de Comté-de-Darrow à Carlin Senterouge et récupérez le Libram de Davil et le Bouclier de Senterouge à la Ferme des Marris.‡从卡林·雷德帕斯那里获取达隆郡全史，然后在玛瑞斯农场收集达维的圣契和雷德帕斯之盾。‡從卡林·雷德帕斯身上取得達隆郡全史，然後到瑪瑞斯農場去取得達維的聖契和雷德帕斯之盾。',
  }
},
[27389] = {
  {
    'Espoliadores da Vila das Flechas‡Мародеры Дарроушира‡Marodeure von Darroheim‡다로우골의 약탈자들‡Los merodeadores de Villa Darrow‡Los merodeadores de Villa Darrow‡Les maraudeurs de Comté-de-Darrow‡达隆郡的掠夺者‡達隆郡的掠奪者',
    nil,
    'Leve 5 Crânios Ressonantes para a Crona na Torre da Coroa, que fica nas Terras Pestilentas Orientais.‡Принесите 5 резонирующих черепов Хроми в Башню королевской стражи в Восточных Чумных землях.‡Bringt 5 widerhallende Schädel zu Chromie am Turm der Kronenwache in den Östlichen Pestländern.‡동부 역병지대의 산마루 경비탑에 있는 크로미에게 공명하는 해골 5개를 가져가야 합니다.‡Lleva 5 calaveras resonadoras a Cromi en la Torre de la Corona en las Tierras de la Peste del Este.‡Lleva 5 calaveras resonadoras a Cromi en la Torre de la Corona en las Tierras de la Peste del Este.‡Apportez 5 Crânes résonnants à Chromie à la Tour de garde de la Couronne, dans les Maleterres de l\'Est.‡把5个共鸣徽记交给东瘟疫之地皇冠哨塔的克罗米。‡將5個共鳴顱骨帶回東瘟疫之地的皇冠哨塔給克羅米。',
  }
},
[27390] = {
  {
    'A batalha pela Vila das Flechas‡Битва при Дарроушире‡Die Schlacht um Darroheim‡다로우골 전투‡La Batalla de Villa Darrow‡La Batalla de Villa Darrow‡La bataille de Comté-de-Darrow‡达隆郡的战斗‡達隆郡的戰鬥',
    nil,
    'Coloque o Saco de Relíquias na praça da Vila das Sombras.|n|nImpeça que Davil Luminoso morra antes de Horgus.|n|nImpeça que o Capitão Trilharrubra morra antes que Trilharrubra, o Corrompido, surja.|n|nDerrote Trilharrubra, o Corrompido.|n|nFale com o espírito de Josefo Trilharrubra quando ele aparecer na praça.‡Положите сверток с реликвиями на городскую площадь Дарроушира.|n|nНе дайте Дейвилу Яркосвету умереть, пока не погибнет Хоргус.|n|nНе дайте умереть капитану Редпату, пока он не превратится в Редпата Оскверненного.|n|nУбейте Редпата Оскверненного.|n|nПоговорите с духом Джозефа Редпата, когда он появится на городской площади.‡Legt das Reliktbündel auf den Marktplatz von Darroheim.|n|nVerhindert Davil Lichterscheins Tod, bis Horgus stirbt.|n|nVerhindert Hauptmann Rotpfads Tod, bis Rotpfad der Verderbte erscheint.|n|nBesiegt Rotpfad den Verderbten.|n|nSprecht mit dem Geist von Joseph Rotpfad, sobald er auf dem Marktplatz erscheint.‡다로우골 마을 광장에 유물 더미를 가져다 놓아야 합니다.|n|n호르구스보다 다빌 라이트파이어가 먼저 죽지 않도록 다빌을 보호해야 합니다.|n|n타락한 레드패스가 나타나기 전까지 경비대장 레드패스가 죽지 않도록 보호해야 합니다.|n|n타락한 레드패스가 나타나면 처치해야 합니다.|n|n마을 광장에 조셉 레드패스의 영혼이 나타나면 그와 대화해야 합니다.‡Coloca el fardo de reliquias en la plaza de Villa Darrow.|n|nImpide que Davil Fuegoluz muera antes que Horgus.|n|nImpide que el capitán Rutagrana muera hasta que aparezca Rutagrana el Corrompido.|n|nDerrota a Rutagrana el Corrompido.|n|nHabla con el espíritu de Joseph Rutagrana cuando aparezca en la Plaza de la Ciudad.‡Coloca el fardo de reliquias en la plaza de Villa Darrow.|n|nImpide que Davil Fuegoluz muera antes que Horgus.|n|nImpide que el capitán Rutagrana muera hasta que aparezca Rutagrana el Corrompido.|n|nDerrota a Rutagrana el Corrompido.|n|nHabla con el espíritu de Joseph Rutagrana cuando aparezca en la Plaza de la Ciudad.‡Placez l\'Ensemble de reliques sur la place centrale de Comté-de-Darrow.|n|nEmpêchez la mort de Davil Lumefeu jusqu’à la mort de Horgus.|n|nEmpêchez la mort du capitaine Senterouge, jusqu’à ce que Senterouge le Corrompu apparaisse.|n|nSortez vainqueur du combat contre Senterouge le Corrompu.|n|nParlez à l’esprit de Joseph Senterouge quand il apparaîtra sur la place centrale.‡将遗物包裹放在达隆郡的广场中。|n|n在霍古斯死亡之前，达维必须存活。|n|n在雷德帕斯队长堕落之前保证他存活。|n|n击败堕落的雷德帕斯。|n|n当约瑟夫·雷德帕斯出现在广场中时，与他的灵魂进行交谈。‡將聖物包裹放在達隆郡的廣場中。|n|n在霍古斯死亡之前，達維必須存活。|n|n在墮落的雷德帕斯現身之前確保雷德帕斯隊長存活。|n|n擊敗墮落的雷德帕斯。|n|n當約瑟夫‧雷德帕斯出現在廣場中時，與他的靈魂進行交談。',
  }
},
[27391] = {
  {
    'Tesouros escondidos‡Спрятанные сокровища‡Versteckte Schätze‡숨겨진 보물‡Tesoros ocultos‡Tesoros ocultos‡Trésors cachés‡隐藏的宝藏‡隱藏的寶藏',
    nil,
    'Leve a Chave de Josefo ao Baú do Josefo.‡Отнесите ключ Джозефа к сундуку Джозефа.‡Bringt Josephs Schlüssel zu Josephs Truhe.‡조셉의 상자가 있는 곳으로 조셉의 열쇠를 가져가야 합니다.‡Lleva la llave de Joseph al cofre de Joseph.‡Lleva la llave de Joseph al cofre de Joseph.‡Utilisez la Clé de Joseph sur le Coffre de Joseph.‡用约瑟夫的钥匙打开约瑟夫的箱子。‡用約瑟夫的鑰匙打開約瑟夫的箱子。',
  }
},
[27392] = {
  {
    'Eu não deveria te contar isso‡Я не должна тебе этого говорить‡Ich soll Euch das eigentlich nicht verraten‡이건 비밀인데요...‡No debería decirte esto‡No debería decirte esto‡Je ne devrais pas vous dire ça‡我不该告诉你这个‡我不該告訴你這些',
    nil,
    'Obtenha a Lâmina de Caça do Josefo do Caçador Solitário nas Terras Pestilentas Orientais.‡Заберите охотничий клинок Джозефа у Одинокого охотника в Восточных Чумных землях.‡Erhaltet Josephs Jagdklinge von dem Einsamen Jäger in den Östlichen Pestländern.‡동부 역병지대의 고독한 사냥꾼에게서 조셉의 사냥 칼날을 입수해야 합니다.‡Consigue la hoja de cazar de Joseph del cazador solitario en las Tierras de la Peste del Este.‡Consigue la hoja de cazar de Joseph del cazador solitario en las Tierras de la Peste del Este.‡Récupérez la Lame de chasse de Joseph chez le Chasseur solitaire, dans les Maleterres de l\'Est.‡从东瘟疫之地的孤独的猎手身上获得约瑟夫的猎刀。‡到東瘟疫之地從孤魂獵食者身上取得約瑟夫的獵刀。',
  }
},
[27393] = {
  {
    'O chamado da espada‡Зов клинка‡Der Ruf der Klinge‡칼날의 부름‡La llamada de la hoja‡La llamada de la hoja‡L’appel de la lame‡利刃的召唤‡劍之呼喚',
    nil,
    'Investigue o campo de batalha na extremidade sul das Ruínas de Vashj\'ir.‡Исследуйте поле битвы на южной окраине Руин Вайш\'ира.‡Untersucht das Schlachtfeld am südlichen Ende der Ruinen von Vashj\'ir.‡바쉬르 폐허의 남쪽 끝자락에 있는 격전지를 조사해야 합니다.‡Investiga el lugar de la batalla en el extremo sur de las Ruinas de Vashj\'ir.‡Investiga el lugar de la batalla en el extremo sur de las Ruinas de Vashj\'ir.‡Examinez le champ de bataille à l’extrémité sud des Ruines de Vashj’ir.‡调查瓦丝琪尔废墟南端的战斗现场。‡調查瓦許伊爾南端的戰爭遺址。',
  }
},
[27394] = {
  {
    'O chamado da espada‡Зов клинка‡Der Ruf der Klinge‡칼날의 부름‡La llamada de la hoja‡La llamada de la hoja‡L’appel de la lame‡利刃的召唤‡劍之呼喚',
    nil,
    'Investigue o campo de batalha na extremidade sul das Ruínas de Vashj\'ir.‡Исследуйте поле битвы на южной окраине Руин Вайш\'ира.‡Untersucht das Schlachtfeld am südlichen Ende der Ruinen von Vashj\'ir.‡바쉬르 폐허의 남쪽 끝자락에 있는 격전지를 조사해야 합니다.‡Investiga el lugar de la batalla en el extremo sur de las Ruinas de Vashj\'ir.‡Investiga el lugar de la batalla en el extremo sur de las Ruinas de Vashj\'ir.‡Examinez le champ de bataille à l’extrémité sud des Ruines de Vashj’ir.‡调查瓦丝琪尔废墟南端的战斗现场。‡調查瓦許伊爾南端的戰爭遺址。',
  }
},
[27395] = {
  {
    'A verdadeira arma de um atirador‡Оружие стрелка‡Die Waffe eines Schützen‡저격수의 무기‡El arma de los tiradores‡El arma de los tiradores‡Une arme de fin tireur‡射手的武器‡神射手的武器',
    nil,
    'Vá à Bastilha da Presa Negra e consiga a Mira de Cristal de Godfrey, 5 feixes de Lunalenha e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте хрустальный прицел Годфри, 5 связок осененного луной дерева и 5 жил нежити.‡Reist nach Burg Schattenfang und erhaltet Godfreys Kristallzielfernrohr, 5 Bündel mondbestrahltes Holz und 5 ewige Sehnen‡그림자송곳니 성채에서 고드프리의 수정 조준경, 달빛 깃든 나무 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén la mira de cristal de Godfrey, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén la mira de cristal de Godfrey, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez la Lunette en cristal de Godfrey, 5 fagots de Bois de Frôlelune et 5 Tendons impérissables.‡进入影牙城堡，获得高弗雷的水晶瞄准镜，还有5捆月触之木和5束不死肌腱。‡到影牙城堡去，並取得高佛雷領主的水晶透鏡、5捆月觸之木、以及5條不滅肌腱。',
  }
},
[27396] = {
  {
    'Lâmina da Mão Despedaçada‡Клинок Изувеченной Длани‡Klinge der Zerschmetterten Hand‡으스러진 손의 검‡La espada de la Mano Destrozada‡La hoja de la Mano Destrozada‡La lame de la Main brisée‡碎手之刃‡破碎之手劍刃',
    nil,
    'Vá à Bastilha da Presa Negra e consiga a Pedra de Amolar de Floraval do Comandante Floraval, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте точило командира Спрингвейла, 5 слитков лунной стали и 5 жил нежити.‡Reist nach Burg Schattenfang und erhaltet Grüntals Wetzstein von Kommandant Grüntal, 5 Kisten Mondstahlbarren und 5 ewige Sehnen.‡그림자송곳니 성채에서 스프링베일의 숫돌, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén la piedra de afilar del comandante Vallefont, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén la piedra de afilar del comandante Vallefont, 5 cajones de lingotes de acero lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez la Pierre à aiguiser de Printeval sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Tendons impérissables.‡进入影牙城堡，从指挥官斯普林瓦尔那里夺得斯普林瓦尔的磨刀石，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡取得指揮官斯普林瓦爾身上的斯普林瓦爾的磨刀石，5箱月鋼錠，和5條不死肌腱。',
  }
},
[27397] = {
  {
    'A tarefa de Romanesca‡Поручение Сновидицы‡Die Aufgabe eines Traumsuchers‡드림시커의 임무‡La tarea de Buscasueños‡La tarea de Buscasueños‡La tâche de Cherche-rêve‡逐梦者的任务‡尋夢者的任務',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Talismã de Walden do Lorde Walden, o Livro das Almas Perdidas e 5 Essências Fantasmagóricas.‡Ступайте в крепость Темного Клыка и добудьте талисман Вальдена, книгу Потерянных Душ и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet den Talisman des Wolfmeisters von Wolfmeister Nandos, das Buch der verlorenen Seelen und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 월든의 부적, 잃어버린 영혼의 서, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el dije de Lord Walden, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el dije de Lord Walden, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Talisman de Walden sur le Seigneur Walden, le Livre des âmes perdues et 5 Essences fantomatiques.‡进入影牙城堡，从沃登勋爵那里夺取沃登的护符，还有迷失灵魂之书和5份幽灵精华。‡到影牙城堡取得瓦爾登領主身上的瓦爾登的咒符，失落靈魂之書，和5件鬼魅精華。',
  }
},
[27398] = {
  {
    'Ganhamos a batalha, mas não a guerra‡Битва выиграна, но война продолжается‡Die Schlacht ist gewonnen, der Krieg geht weiter‡전투는 이겼으나, 전쟁은 계속된다‡La batalla está ganada, la guerra continúa‡La batalla está ganada, la guerra continúa‡La bataille est gagnée, la guerre continue‡战斗已胜，战争未停‡戰役告捷，戰爭待續',
    nil,
    'Fale com Naraat, a Voz da Terra, no Santuário Oriental da Terra, em Ventobravo.‡Поговорите с Нараатом Говорящим с Землей в Восточном Святилище Земли в Штормграде.‡Sprecht mit Erdsprecher Naraat am Östlichen Erdschrein in Sturmwind.‡스톰윈드의 동부 대지제단에 있는 대지예언자 나라트와 대화해야 합니다.‡Habla con Naraat el Hablatierra en El Santuario de la Tierra del Este en la Ciudad de Ventormenta.‡Habla con Naraat el Hablatierra en El Santuario de la Tierra del Este en la Ciudad de Ventormenta.‡Allez voir Naraat le Parleterre au Sanctuaire Terrestre de l’Est, à Hurlevent.‡与暴风城东部大地神殿的地语者纳拉特交谈。‡到暴風城的東大地神殿找語地者納拉亞特說話。',
  }
},
[27399] = {
  {
    'Ganhamos a batalha, mas a guerra continua‡Битва выиграна, но война продолжается‡Die Schlacht ist gewonnen, der Krieg geht weiter‡전투는 이겼으나, 전쟁은 계속된다‡La batalla está ganada, la guerra continúa‡La batalla está ganada, la guerra continúa‡La bataille est gagnée, la guerre continue‡战斗已胜，战争未停‡戰役告捷，戰爭待續',
    nil,
    'Fale com o Clarividente Krogar, no Santuário Ocidental da Terra, que fica em Orgrimmar.‡Поговорите с предсказателем Крогаром в Западном Святилище Земли в Оргриммаре.‡Sprecht mit Scharfseher Krogar am Westlichen Erdschrein in Orgrimmar.‡오그리마의 서부 대지제단에 있는 선견자 크로가와 대화해야 합니다.‡Habla con el clarividente Krogar en El Santuario de la Tierra del Oeste en Orgrimmar.‡Habla con el clarividente Krogar en El Santuario de la Tierra del Oeste en Orgrimmar.‡Allez voir le Long-voyant Krogar au Sanctuaire Terrestre de l’Ouest, à Orgrimmar.‡与奥格瑞玛西部大地神殿的先知克洛伽交谈。‡去奧格瑪的西大地神殿找先知克洛加爾說話。',
  }
},
[27400] = {
  {
    'O domínio do poder arcano‡Постижение тайной магии‡Beherrschung des Arkanen‡비전 숙달‡Dominando lo Arcano‡Dominando lo Arcano‡La maîtrise des Arcanes‡掌握奥术‡精通秘法',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Cristal Encantado de Silverlaine do Barão Silverlaine, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте зачарованный кристалл Сильверлейна у барона Сильверлейна, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erlangt Silberleins verzauberten Kristall von Baron Silberlein, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 실버레인의 마력 깃든 수정, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el cristal encantado Filargenta del barón Filargenta, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el cristal encantado Filargenta del barón Filargenta, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Cristal enchanté d\'Argelaine sur le Baron d\'Argelaine, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡席瓦莱恩男爵处收集席瓦莱恩魔化水晶，还有5捆月触之木和5份幽灵精华。‡到影牙城堡去取得席瓦萊恩的附魔水晶、5捆月觸之木、以及5份鬼魅精華。',
  }
},
[27401] = {
  {
    'O que nos traz o dia de amanhã‡Что день грядущий нам готовит‡Was uns morgen erwartet‡내일이 찾아오면‡Lo que trae el mañana‡Lo que trae el mañana‡Qui sait ce qui nous attend ?‡明天的希望‡明日吉凶難測',
    nil,
    'Use o Telescópio da 7ª Legião para Vasculhar o Cais.‡Осмотрите гавань при помощи подзорной трубы 7-го легиона.‡Benutzt das Teleskop der 7. Legion, um den Hafen auszuspähen.‡7군단 망원경을 사용하여 항구를 정찰해야 합니다.‡Utiliza el telescopio de la Séptima Legión para reconocer el puerto.‡Utiliza el telescopio de la Séptima Legión para reconocer el puerto.‡Utilisez le Télescope de la 7e Légion pour examiner le Port.‡使用第七军团望远镜侦查港口。‡使用第七軍團望遠鏡偵查港口。',
  }
},
[27402] = {
  {
    'Prova de poder‡Знак силы‡Zeichen der Macht‡능력의 징표‡Una muestra de poder‡Una muestra de poder‡La marque de la puissance‡力量的证明‡力量的象徵',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Orbe Tenebroso do Lorde Godfrey, o Livro das Almas Perdidas e 5 Essências Fantasmagóricas.‡Отправляйтесь к крепость Темного Клыка и добудьте у лорда Годфри зловещее око, а также книгу Потерянных Душ и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet die Finstere Kugel von Lord Godfrey, das Buch der verlorenen Seelen und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 고드프리 경의 음침한 보주, 잃어버린 영혼의 서, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el orbe tenebroso de Lord Godfrey, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el orbe tenebroso de Lord Godfrey, el Libro de las Almas Perdidas y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez l\'Orbe ténébreux sur le Seigneur Godfrey, le Livre des âmes perdues et 5 Essences fantomatiques.‡进入影牙城堡，从高弗雷勋爵那里夺得晦暗之球，还有迷失灵魂之书和5份幽灵精华。‡到影牙城堡取得高佛雷領主手握的陰暗寶珠，失落靈魂之書，和5件鬼魅精華。',
  }
},
[27403] = {
  {
    'Um verdadeiro Andarilho do Sol‡Истинный служитель солнца‡Ein echter Sonnenwandler‡진정한 태양길잡이‡Un verdadero caminasol‡Un verdadero caminasol‡Un véritable marche-soleil‡真正的烈日行者‡真正的日行者',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира Спрингвейла, 5 ящиков слитков лунной стали и 5 жил нежити.‡Reist nach Burg Schattenfang und findet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Kisten Mondstahlbarren, und 5 ewige Sehnen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 cajones de lingotes de acero de lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 cajones de lingotes de acero de lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 caisses de Lingots d\'acier lunaire et 5 Tendons impérissables.‡进入影牙城堡，从指挥官斯普林瓦尔那里夺得指挥官的神圣符记，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡去，從指揮官斯普林瓦爾身上取得指揮官的聖徽、5箱月鋼錠、以及5條不滅肌腱。',
  }
},
[27404] = {
  {
    'O futuro do Círculo‡Будущее Круга‡Die Zukunft des Zirkels‡의회의 미래‡El futuro del Círculo‡El futuro del Círculo‡L\'avenir du Cercle‡议会的未来‡議會的未來',
    nil,
    'Vá à Bastilha da Presa Negra e consiga os Elixires de Walden de Lorde Walden, 5 feixes de Lunalenha e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте эликсиры Вальдена, 5 вязанок осененного луной дерева и 5 жил нежити.‡Reist nach Burg Schattenfang und erhaltet Waldens Elixiere von Lord Walden, 5 Bündel mondbestrahltes Holz und 5 ewige Sehnen.‡그림자송곳니 성채에서 월든의 비약, 달빛 깃든 나무 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén los elixires de Walden, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén los elixires de Walden, 5 paquetes de madera Lunadón y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez les Élixirs de Walden sur le Seigneur Walden, 5 fagots de Bois de Frôlelune et 5 Tendons impérissables.‡进入影牙城堡，从沃登勋爵那里夺取沃登的药剂，还有5捆月触之木和5束不死肌腱。‡到影牙城堡去，並從瓦爾登領主身上取得瓦爾登的藥劑，5捆月觸之木，以及5條不滅肌腱。',
  }
},
[27405] = {
  {
    'Recuar!‡Назад!‡Rückzug!‡후퇴하라!‡¡Retrocede!‡¡Retrocede!‡Retraite !‡撤退！‡撤退!',
    nil,
    'Encontre o Comandante Sicário Belmonte na Vila da Pedra Incandescente, que fica nas Ruínas de Guilnéas.‡Найдите командира стражей смерти Бельмонта в Деревне Тлеющего Угля в руинах Гилнеаса.‡Findet Todespirscherkommandant Belmont in Glutstein in den Ruinen von Gilneas.‡길니아스 폐허의 잿불석 마을에서 죽음추적자 사령관 벨몬트를 찾아야 합니다.‡Busca al comandante mortacechador Belmont en la Aldea Piedra Ígnea en las Ruinas de Gilneas.‡Busca al comandante mortacechador Belmont en la Aldea Piedra Ígnea en las Ruinas de Gilneas.‡Trouvez le Commandant nécrotraqueur Belmont à Pierrebraise, dans les Ruines de Gilnéas.‡去找吉尔尼斯废墟烬石村的死亡猎手指挥官贝尔蒙特。‡在吉爾尼斯廢墟的燼石村找到亡靈哨兵指揮官貝爾蒙特。',
  }
},
[27406] = {
  {
    'Um homem chamado Godfrey‡Человек по имени Годфри‡Ein Mann namens Godfrey‡고드프리라는 이름의 사람‡Un hombre llamado Godfrey‡Un hombre llamado Godfrey‡Un homme nommé Godfrey‡一个名叫高弗雷的人‡名叫高佛雷的男人',
    nil,
    'Encontre o cadáver de Lorde Vincent Godfrey.‡Найдите останки лорда Винсента Годфри.‡Findet die Leiche von Lord Vincent Godfrey.‡빈센트 고드프리 경의 시체를 찾아야 합니다.‡Encuentra el cadáver de Lord Vincent Godfrey.‡Encuentra el cadáver de Lord Vincent Godfrey.‡Trouvez le Cadavre du seigneur Vincent Godfrey.‡找到文森特·高弗雷勋爵的遗体。‡找到文森·高佛雷領主的屍體。',
  }
},
[27407] = {
  {
    'Penas de Dinossangue‡Перья Кровавой Топи‡Blutsumpffedern‡붉은늪지랩터 깃털‡Plumas Cienorrojo‡Plumas Cienorrojo‡Les plumes de Rougefange‡血沼羽毛‡血沼羽毛',
    nil,
    'Colete 5 Penas de Dinossangue dos Raptores Dinossangue.‡Добудьте 5 перьев Кровавой Топи у ящеров Кровавой Топи.‡Sammelt 5 Blutsumpffedern von Blutsumpfraptoren.‡붉은늪지랩터에게서 붉은늪지랩터 깃털 5개를 모아야 합니다.‡Reúne 5 plumas Cienorrojo de raptores Cienorrojo.‡Reúne 5 plumas Cienorrojo de raptores Cienorrojo.‡Récupérez 5 Plumes de Raptors de Rougefange.‡从血沼迅猛龙身上采集5片血沼羽毛。‡從血沼迅猛龍身上收集到5根血沼羽毛。',
  }
},
[27408] = {
  {
    'O estandarte de Pedramalho‡Знамя Каменного Молота‡Das Banner der Steinbrecher‡돌망치 깃발‡El estandarte de los Quebrantarrocas‡El estandarte de los Quebrantarrocas‡La bannière des Cognepierres‡石槌战旗‡石槌旌旗',
    nil,
    'Recupere o Estandarte de Pedramalho do Antro das Chamas.‡Принесите из Огненного логова знамя Каменного Молота.‡Beschafft das Banner der Steinbrecher aus Flammenbau.‡화염의 둥지에 있는 돌망치 깃발을 되찾아야 합니다.‡Recupera el estandarte Quebrantarrocas del interior del Cubil de la Llama.‡Recupera el estandarte Quebrantarrocas del interior del Cubil de la Llama.‡Récupérez la Bannière cognepierre dans l\'Antre des flammes.‡到火岩洞穴里夺取石槌战旗。‡從火焰洞穴之中取得石槌旌旗。',
  }
},
[27409] = {
  {
    'A essência da inimizade‡Сущность вражды‡Die Essenz der Feindschaft‡증오의 정수‡La esencia de la animadversión‡La esencia de la animadversión‡L\'essence de l\'ennemi‡憎恨的精华‡敵意的精華',
    nil,
    'Leve 10 Essências de Draconiano Negro para Brogg em Coroa de Barro.‡Принесите 10 сущностей черного дракона Броггу в Шестермуть.‡Bringt 10 Essenzen eines schwarzen Drachkin zu Brogg in Morastwinkel.‡검은용혈족 정수 10개를 진흙톱니 거점에 있는 브록에게 가져가야 합니다.‡Llévale 10 esencias de dragonante negro a Brogg a Piñón de Barro.‡Llévale 10 esencias de dragonante negro a Brogg a Piñón de Barro.‡Apportez 10 Essences de draconien noir à Brogg à Bourbe-à-brac.‡将10份黑龙精华交给泥链镇的布洛格。‡帶10個黑龍精華給泥鏈營地的布洛葛。',
  }
},
[27410] = {
  {
    'Os espíritos do Acampamento dos Pedramalho‡Духи в руинах деревни Каменного Молота‡Geister der Festung der Steinbrecher‡돌망치 폐허의 영혼‡Espíritus del Bastión Quebrantarrocas‡Espíritus del Bastión Quebrantarrocas‡Les esprits du bastion Cognepierre‡石槌之魂‡吸引石槌之靈',
    nil,
    'Dê o descanso a 10 Espíritos de Pedramalho nas Ruínas Pedramalho.‡Упокойте 10 духов Каменного Молота в руинах деревни Каменного Молота.‡Gebt 10 Geistern der Steinbrecher bei den Ruinen der Steinbrecher ihre letzte Ruhe.‡돌망치 폐허에 있는 10명의 돌망치 영혼에 안식을 찾아줘야 합니다.‡Otorga el descanso a 10 espíritus Quebrantarrocas en las Ruinas Quebrantarrocas.‡Otorga el descanso a 10 espíritus Quebrantarrocas en las Ruinas Quebrantarrocas.‡Apportez le repos à 10 Esprits cognepierres dans les Ruines cognepierres.‡在石槌废墟让10个石槌之魂得到安息。‡在石槌廢墟讓10個石槌之靈安息。',
  }
},
[27411] = {
  {
    'O desafio à Revoada Negra‡Бросить вызов Черному дракону‡Herausforderung für den schwarzen Drachenschwarm‡검은용군단에 도전‡Reta al Vuelo Negro‡Reta al Vuelo Negro‡Un défi au Vol noir‡挑战黑龙军团‡挑戰黑龍軍團',
    nil,
    'Posicione o Estandarte de Pedramalho perto da entrada do Covil da Onyxia e enfrente todos que responderem ao desafio.‡Установите знамя Каменного Молота у входа в логово Ониксии и одолейте всех, кто примет этот вызов.‡Platziert das Banner der Steinbrecher am Eingang zu Onyxias Hort und besiegt alle, die reagieren.‡돌망치 깃발을 오닉시아의 둥지 입구에 꽂고, 오닉시아가 어떻게 반응하는지 확인한 다음 이에 응수하는 자를 처치해야 합니다.‡Coloca el estandarte Quebrantarrocas cerca de la entrada de la Guarida de Onyxia y derrota a todo el que responda.‡Coloca el estandarte Quebrantarrocas cerca de la entrada de la Guarida de Onyxia y derrota a todo el que responda.‡Plantez la Bannière cognepierre près de l’entrée du Repaire d\'Onyxia et affrontez tous ceux qui se manifestent.‡将石槌战旗插在奥妮克希亚的巢穴入口附近，击败回应的人。‡把石槌旌旗插在奧妮克希亞的巢穴的入口並擊敗所有回應的人。',
  }
},
[27412] = {
  {
    'PROCURA-SE: Garra Sanguinária, o Voraz‡РАЗЫСКИВАЕТСЯ: Кровокоготь Ненасытный‡GESUCHT: Schlächterklaue der Gefräßige‡현상 수배: 포악한 피발톱‡SE BUSCA: Garrasangrienta el Voraz‡SE BUSCA: Garrasangrienta el Voraz‡ON RECHERCHE : Griffétripe le Vorace‡悬赏：贪婪的血爪‡懸賞:貪婪的血爪',
    nil,
    'Mate Garra Sanguinária, o Voraz, e apresente-se a Drazzit Pingajunta em Coroa de Barro.‡Уничтожьте Кровокогтя Ненасытного и сообщите об этом Драззиту Кранотеку, который находится в Шестермути.‡Tötet Schlächterklaue den Gefräßigen und meldet Euch bei Drazzit Tropfhahn in Morastwinkel.‡포악한 피발톱을 처치하고 진흙톱니 거점에 있는 드라짓 드립밸브에게 보고해야 합니다.‡Mata a Garrasangrienta el Voraz y preséntate ante Drazzit Gotera en Piñón de Barro.‡Mata a Garrasangrienta el Voraz y preséntate ante Drazzit Gotera en Piñón de Barro.‡Tuez Griffétripe le Vorace et présentez-vous à Drazzit Suintevalve à Bourbe-à-brac.‡杀死贪婪的血爪，然后向泥链镇的德拉兹特·迪普瓦尔复命。‡殺死貪婪的血爪並且向泥鏈營地的德拉席特·滴栓回報。',
  }
},
[27413] = {
  {
    'Erva da serpe‡Тяни змею за хвост!‡Entwindet den Drachen‡용에 달린 꼬리도 약에 쓰려니...‡Atrapa a un dragón por la cola‡Atrapa a un dragón por la cola‡Tirer le dragon par la queue‡龙尾草‡抓住龍的尾巴',
    nil,
    'Colete 8 Rabos-de-serpe na Draconumbra ou no Pântano da Serpe.‡Соберите в Земле Драконов или в Драконьих топях 8 стеблей змейкиного хвоста.‡Sammelt 8 Stängel der Drachenwinde in Drachendüster oder in Drachensumpf.‡용의 늪이나 용의 둥지에서 용꼬리 줄기 8개를 모아야 합니다.‡Reúne 8 tallos de cola de vermis en El Pantano del Dragón o en la Ciénaga de Fuego.‡Reúne 8 tallos de cola de vermis en El Pantano del Dragón o en la Ciénaga de Fuego.‡Récupérez 8 tiges de Queue de wyrm dans le Cloaque aux dragons ou la Tourbière du Ver.‡从黑龙谷或巨龙沼泽收集8根龙尾草。‡在黑龍谷或巨龍泥沼收集到8根龍尾草的莖。',
  }
},
[27414] = {
  {
    'Identificando a ninhada‡Поиск источника‡Die Brut identifizieren‡근원 추적‡Identifica a los cachorros‡Identifica a los cachorros‡L\'identification de la portée‡龙族的源头‡群龍之首',
    nil,
    'Draz\'Zilb, na Aldeia Muralha Verde, quer que você traga 7 Línguas Calcinantes e 7 Corações Calcinantes.‡Принесите Драз\'Зилбу в деревню Гиблотопь 7 огненных языков и 7 пылающих сердец.‡Draz\'Zilb in Brackenwall möchte, dass Ihr ihm 7 sengende Zungen und 7 sengende Herzen bringt.‡담쟁이 마을에 있는 드자리블이 화염 혓바닥 7개와 화염 심장 7개를 가져다 달라고 했습니다.‡Draz\'Zilb del Poblado Murohelecho quiere que le lleves 7 lenguas abrasadoras y 7 corazones abrasadores.‡Draz\'Zilb del Poblado Murohelecho quiere que le lleves 7 lenguas abrasadoras y 7 corazones abrasadores.‡Apportez 7 Langues d\'incendiaire et 7 Cœurs d\'incendiaire à Draz\'Zilb, à Mur-de-Fougères.‡蕨墙村的德拉兹辛比要你给他带7条灼热之舌和7颗灼热之心。‡蕨牆村的德拉茲辛比要你給他找7條灼熱之舌和7顆灼熱之心。',
  }
},
[27415] = {
  {
    'A linhagem de Onyxia‡Выводок Ониксии‡Die Brut von Onyxia‡오닉시아 일당‡El linaje de Onyxia‡El linaje de Onyxia‡La couvée d\'Onyxia‡奥妮克希亚的血脉‡奧妮克希亞的血脈',
    nil,
    'Destrua 5 Ovos de Onyxia.‡Разбейте 5 яиц Ониксии.‡Zerstört 5 Eier von Onyxia.‡오닉시아의 알 5개를 파괴해야 합니다.‡Destruye 5 huevos de Onyxia.‡Destruye 5 huevos de Onyxia.‡Détruisez 5 Œufs d\'Onyxia.‡摧毁5枚奥妮克希亚的蛋。‡毀掉5枚奧妮克希亞的蛋。',
  }
},
[27416] = {
  {
    'A linhagem de Onyxia‡Выводок Ониксии‡Die Brut von Onyxia‡오닉시아 일당‡El linaje de Onyxia‡El linaje de Onyxia‡La couvée d\'Onyxia‡奥妮克希亚的血脉‡奧妮克希亞的血脈',
    nil,
    'Fale com o Lorde Supremo Mok\'Morokk na Aldeia Muralha Verde.‡Поговорите с властителем Мок\'Морокком в деревне Гиблотопь.‡Sprecht mit Oberanführer Mok\'Morokk in Brackenwall.‡담쟁이 마을에 있는 대군주 모크모로크와 대화해야 합니다.‡Habla con el señor supremo Mok\'Morokk en el Poblado Murohelecho.‡Habla con el señor supremo Mok\'Morokk en el Poblado Murohelecho.‡Parlez au seigneur Mok\'Morokk à Mur-de-Fougères.‡跟蕨墙村的莫格穆洛克大王谈一谈。‡和蕨牆村的莫格穆洛克主宰談話。',
  }
},
[27417] = {
  {
    'A linhagem de Onyxia‡Выводок Ониксии‡Die Brut von Onyxia‡오닉시아 일당‡El linaje de Onyxia‡El linaje de Onyxia‡La couvée d\'Onyxia‡奥妮克希亚的血脉‡奧妮克希亞的血脈',
    nil,
    'Fale com Draz\'Zilb na Aldeia Muralha Verde.‡Поговорите с Драз\'Зилбом в деревне Гиблотопь.‡Sprecht mit Draz\'Zilb in Brackenwall.‡담쟁이 마을에 있는 드자리블과 대화해야 합니다.‡Ve al Poblado Murohelecho y habla con Draz\'Zilb.‡Ve al Poblado Murohelecho y habla con Draz\'Zilb.‡Parlez à Draz\'Zilb à Mur-de-Fougères.‡跟蕨墙村的德拉兹辛比谈一谈。‡和蕨牆村的德拉茲辛比談話。',
  }
},
[27418] = {
  {
    'Desafie o lorde supremo Mok\'Morokk‡Битва с властителем Мок\'Морокка‡Fordert Oberanführer Mok\'Morokk heraus‡대군주 모크모로크에게 도전‡Desafía al señor supremo Mok\'Morokk‡Desafía al señor supremo Mok\'Morokk‡Défier le seigneur Mok\'Morokk‡挑战莫格穆洛克大王‡挑戰莫格穆洛克主宰',
    nil,
    'Derrote Mok\'Morokk e leve a notícia para Draz\'Zilb na Aldeia Muralha Verde.‡Победите Мок\'Морокка и сообщите об этом Драз\'Зилбу в деревне Гиблотопь.‡Besiegt Mok\'Morokk und erstattet Draz\'Zilb in Brackenwall Bericht.‡모크모로크에게 이긴 후 담쟁이 마을에 있는 드자리블에게 이 소식을 보고해야 합니다.‡Derrota a Mok\'Morokk y ve al Poblado Murohelecho a informar a Draz\'Zilb.‡Derrota a Mok\'Morokk y ve al Poblado Murohelecho a informar a Draz\'Zilb.‡Affrontez Mok\'Morokk et informez Draz’Zilb, à Mur-de-Fougères, de votre victoire.‡打败莫格穆洛克，将消息报告给蕨墙村的德拉兹辛比。‡打敗莫格穆洛克，再把消息帶給蕨牆村的德拉茲辛比。',
  }
},
[27419] = {
  {
    'O exército dos dragões negros‡Армия черных драконов‡Armee des schwarzen Großdrachen‡검은용군단‡El ejército de los dragones negros‡El ejército de los dragones Negros‡L\'armée des dragons noirs‡黑龙军团‡黑龍軍團',
    nil,
    'Tharg, na Aldeia Muralha Verde, quer que você mate 10 Batedores Flamigrenha, 10 Caudas Cinza Flamigrenha e 5 Escamortes Flamigrenha.‡Тхарг из деревни Гиблотопь хочет, чтобы вы уничтожили 10 огнегривых разведчиков, 10 огнегривых пеплохвостов и 5 огнегривых чешуйчатых губителей.‡Tharg in Brackenwall möchte, dass Ihr 10 Späher der Feuermähnen, 10 Aschenschweife der Feuermähnen und 5 Bannschuppen der Feuermähnen tötet.‡담쟁이 마을의 타르그가 화염갈기혈족 정찰병 10마리, 화염갈기혈족 잿불꼬리 10마리, 화염갈기혈족 맹독전사 5마리를 해치워 달라고 했습니다.‡Tharg en el Poblado Murohelecho quiere que mates a 10 exploradores Pirocabello, 10 ceniazotes Pirocabello y 5 horrocrustos Pirocabello.‡Tharg en el Poblado Murohelecho quiere que mates a 10 exploradores Pirocabello, 10 ceniazotes Pirocabello y 5 horrocrustos Pirocabello.‡Tuez 10 Éclaireurs crins-de-feu, 10 Queues-cendrées crins-de-feu et 5 Plaiedécailles crins-de-feu.‡蕨墙村的萨尔格要你去杀掉10个火鬃斥候，10个火鬃灰尾龙人和5个火鬃守卫。‡蕨牆村的薩爾格要你去殺掉10個火鬃斥候，10個火鬃灰尾龍裔和5個火鬃逆鱗守衛。',
  }
},
[27420] = {
  {
    'Adiando o inevitável‡Отсрочка неизбежного‡Das Unvermeidliche hinauszögern‡회복의 첫걸음‡Posponiendo lo inevitable‡Posponiendo lo inevitable‡Repousser l\'inéluctable‡延缓灾难‡拖延不可避免的毀滅',
    nil,
    'Obtenha as Runas de Controle de Sectários Sombrios e Umbramantes e então, use a Partícula Sobrecarregada neles para destruir 3 Disseminadores da Peste.‡Добудьте у темных адептов и темных магов руны управления, а затем с помощью избыточно заряженной частицы уничтожьте 3 разносчиков чумы.‡Erhaltet Kontrollrunen von den dunklen Kultisten und Schattenmagiern und benutzt das überladene Partikel, um 3 Seuchenverbeiter zu zerstören.‡암흑의 수행사제와 어둠마법사에게서 제어 룬을 획득한 후, 과충전된 티끌을 이 룬에 사용하여 역병 연무기 3대를 파괴해야 합니다.‡Consigue runas de control de los cultores y magos oscuros, luego usa la mota sobrecargada con ellas para destruir 3 diseminadores de peste.‡Consigue runas de control de los cultores y magos oscuros, luego usa la mota sobrecargada con ellas para destruir 3 diseminadores de peste.‡Récupérez des Runes de contrôle sur des Sectateurs des ténèbres et des Ombremages, puis utilisez-les avec le Granule surchargé pour détruire 3 Disséminateurs de peste.‡从黑暗教徒和暗影法师手中夺取控制符文，然后对它们使用过载魔尘，摧毁3台瘟疫传播器。‡從黑暗教徒與暗影法師身上取得控制符文，然後在符文上使用超載微粒以摧毀3具瘟疫散佈裝置。',
  }
},
[27421] = {
  {
    'Em meio à morte, vida‡Жизнь среди смерти‡Mitten im Tod ist Leben‡죽음 속 생명‡Vida en medio de la muerte‡Vida en medio de la muerte‡La vie au milieu de la mort‡死亡中的新生‡死亡中的生命',
    nil,
    'Plante as sementes de Rayne no centro de cada uma das três necrópoles do Vale Fungi.‡Посадите семена Райны в центре каждого из трех зиккуратов Грибной долины.‡Pflanzt Raynes Samenkörner in den Zentren der drei Ziggurats im Fungustal.‡곰팡이 계곡에 있는 지구라트 세 곳의 가운데에서 레인 씨앗을 사용해야 합니다.‡Usa las semillas de Rayne en el centro de los tres zigurats en la Cuenca Fungal.‡Usa las semillas de Rayne en el centro de los tres zigurats en la Cuenca Fungal.‡Utilisez les Graines de Rayne au centre des 3 Ziggourats de la Vallée des Fongus.‡在蘑菇谷的三座通灵塔的中心区域使用莱茵的种子。‡到蘑菇谷的三個通靈塔中央使用瑞恩的種子。',
  }
},
[27422] = {
  {
    'Uma cidade sob cerco‡Осажденный город‡Eine Stadt unter Belagerung‡포위된 도시‡Una ciudad bajo asedio‡Una ciudad bajo asedio‡Une ville assiégée‡兵临城下‡圍城',
    nil,
    'Fale com o Caravaneiro Esmagapedra.‡Поговорите с караванщиком Камнетесом.‡Sprecht mit Rottenkommandant Steinberster.‡짐노새 주인 스톤브루저와 대화해야 합니다.‡Habla con el maestro de manada Mazadura.‡Habla con el maestro de manada Mazadura.‡Allez voir le Maître-fourrier Navrepierre.‡跟马队管理者布鲁斯·石锤谈一谈。‡與軍需籌備官石漢交談。',
  }
},
[27423] = {
  {
    'Resistir é inútil‡Сопротивление бесполезно‡Widerstand ist zwecklos‡헛된 저항‡La resistencia es fútil‡La resistencia es fútil‡Toute résistance serait futile‡抵抗是徒劳的‡抵抗是沒用的',
    nil,
    'Mate 20 Combatentes Worgens.‡Уничтожьте 20 боевых воргенов.‡Tötet 20 Kämpfer der Worgen.‡늑대인간 전투원 20명을 처치해야 합니다.‡Mata 20 combatientes huargen.‡Mata 20 combatientes huargen.‡Tuez 20 Combattants worgens.‡杀死20名狼人战士。‡殺死20名狼人戰鬥員。',
  }
},
[27424] = {
  {
    'As preocupações do lorde supremo‡О чем думает владыка Мок\'Морокк‡Oberanführer Mok\'Morokks Sorgen‡대군주 모크모로크의 근심‡Las pertenencias del señor supremo Mok\'Morokk‡Las pertenencias del señor supremo Mok\'Morokk‡Les soucis du Seigneur Mok\'Morokk‡莫格穆洛克的任务‡莫格穆洛克主宰的煩惱',
    nil,
    'Pegue a Beberagem, o Rapé e o Cofre de Mok\'Morokk no Pântano Vadeoso.‡Раздобудьте в Пылевых топях грог, понюшку табаку и сундук владыки Мок\'Морокка.‡Holt Oberanführer Mok\'Morokks Grog, Mok\'Morokks Schnupftabak und Mok\'Morokks Geldkassette aus Düstermarschen.‡먼지진흙 습지대에서 대군주 모크모로크의 그로그주, 코담배통, 금고를 모아야 합니다.‡Reúne el grog, el barril de tabaco y la caja fuerte del señor supremo Mok\'Morokk en el Marjal Revolcafango.‡Reúne el grog, el barril de tabaco y la caja fuerte del señor supremo Mok\'Morokk en el Marjal Revolcafango.‡Récupérez le tafia, le tabac à priser et le coffre du seigneur Mok\'Morokk dans le marécage d\'Âprefange.‡从尘泥沼泽拿回莫格穆洛克大王的烈酒、鼻烟和保险箱。‡收集莫格穆洛克主宰的烈酒、鼻煙，還有保險箱。',
  }
},
[27425] = {
  {
    'Uma conexão temível‡Мрачные выводы‡Der entscheidende Grimmweis‡불길한 관계‡Una relación nefasta‡Una relación nefasta‡Un lien sinistre‡恐怖的联系‡一個恐懼的關聯',
    nil,
    'Apresente-se ao Capitão Dario, no Ponto Norte.‡Доложитесь капитану Дариллу в Северной башне.‡Berichtet Hauptmann Darill in Nordwacht.‡북부 경비탑에 있는 대장 다릴에게 보고해야 합니다.‡Preséntate ante el capitán Darill en la Torre de la Punta Norte.‡Preséntate ante el capitán Darill en la Torre de la Punta Norte.‡Présentez-vous au capitaine Darill à la Halte nord.‡向北点哨塔的达利尔上尉报告。‡向北點哨塔的達利爾上尉回報。',
  }
},
[27426] = {
  {
    'A confirmação das suspeitas‡Подтвержденные подозрения‡Bestätigung des Verdachts‡의혹 확인‡Confirma la sospecha‡Confirma la sospecha‡Confirmer les soupçons‡寻找证据‡確認嫌疑',
    nil,
    'Colete 4 Bilhetes dos Temível Totem dos Anciãos Temível Totem e junte-os para formar os Planos de Batalha dos Temível Totem.‡Найти 4 записки племени Зловещий Тотем у старейшин и сложить из них боевой план племени Зловещий Тотем.‡Erlangt 4 Notizen der Grimmtotem von den Ältesten der Grimmtotem. Setzt die Teile zusammen, um die Schlachtpläne der Grimmtotem zu sehen.‡그림토템 장로들에게서 그림토템 쪽지 4개를 모으고 하나로 합쳐 그림토템 전투 계획서를 만들어야 합니다.‡Reúne 4 notas de Tótem Siniestro de los ancianos Tótem Siniestro y combínalas para obtener el plan de batalla de Tótem Siniestro.‡Reúne 4 notas de Tótem Siniestro de los ancianos Tótem Siniestro y combínalas para obtener el plan de batalla de Tótem Siniestro.‡Récupérez 4 Notes des Totems-sinistres chez leurs Anciens et assemblez-les pour former le Plan de bataille complet des Totems-sinistres.‡从恐怖图腾长者身上收集4份恐怖图腾便笺，将它们组合成恐怖图腾作战计划。‡從恐怖圖騰長者那裡收集4份恐怖圖騰的註記，並合成完整的恐怖圖騰的作戰計畫。',
  }
},
[27427] = {
  {
    'As armas dos Temível Totem‡Оружие клана Зловещего Тотема‡Waffen der Grimmtotem‡그림토템 부족의 무기‡Las armas de los Tótem Siniestro‡Las armas de los Tótem Siniestro‡Les armes des Totems-sinistres‡恐怖图腾的军备‡恐怖圖騰的武裝',
    nil,
    'O Capitão Dario, na Torre Norte, quer você lhe leve 7 Armamentos dos Casco Negro.‡По просьбе капитана Дарилла из Северной башни принесите ему 7 предметов вооружения из деревни Черного Копыта.‡Hauptmann Darill in Nordwacht möchte, dass Ihr ihm 7 Waffen der Schwarzhufe bringt.‡북부 경비탑에 있는 대장 다릴에게 블랙후프 병기 7개를 가져가야 합니다.‡El capitán Darill, de la Torre de la Punta Norte, quiere que le traigas 7 armamentos Pezuñanegra.‡El capitán Darill, de la Torre de la Punta Norte, quiere que le traigas 7 armamentos Pezuñanegra.‡Ramenez 7 Armes de Sabot-Noir au capitaine Darill, de la Tour de la halte nord.‡北点哨塔的达利尔上尉希望你能交给他7件黑蹄军备。‡北點哨塔的達利爾上尉帶給他7件黑蹄武裝。',
  }
},
[27428] = {
  {
    'A ajuda de Tabetha‡Помощь Табеты‡Tabethas Unterstützung‡타베사의 도움‡La ayuda de Tabetha‡La ayuda de Tabetha‡L\'aide de Tabetha‡塔贝萨的协助‡塔貝薩的協助',
    nil,
    'Fale com Tabetha em sua fazenda.‡Поговорите с Табетой в ее доме.‡Sprecht mit Tabetha auf ihrem Hof.‡타베사의 농장에서 그녀와 대화해야 합니다.‡Habla con Tabetha en su granja.‡Habla con Tabetha en su granja.‡Parlez à Tabetha dans sa ferme.‡与塔贝萨农场的塔贝萨谈一谈。‡和塔貝薩在她的農場談談。',
  }
},
[27429] = {
  {
    'Ateie fogo ao Posto Chifrebravo!‡Уничтожение заставы Дикого Рога‡Brennt den Grollhornposten nieder!‡공포뿔 거점을 파괴하라!‡¡Arrasa el Puesto Cuernoatroz!‡¡Arrasa el Puesto Cuernoatroz!‡Rasez le poste de Navrecorne !‡烧毁恐角岗哨！‡夷平恐角崗哨!',
    nil,
    'Use a Tocha de Tabetha para incendiar a Tenda Norte, a Tenda Leste e a Tenda Nordeste no Posto Chifrebravo.‡Факелом Табеты подожгите северный, восточный и северо-восточный шатры на заставе Дикого Рога.‡Benutzt Tabethas Fackel, um das nördliche Zelt, das östliche Zelt und das nordöstliche Zelt am Grollhornposten in Flammen zu setzen.‡타베사의 횃불을 사용해 공포뿔 거점에 있는 북쪽 천막, 동쪽 천막, 북동쪽 천막을 불태워야 합니다.‡Usa la antorcha de Tabetha para quemar la tienda norte, la tienda este y la tienda noreste en el Puesto Cuernoatroz.‡Usa la antorcha de Tabetha para quemar la tienda norte, la tienda este y la tienda noreste en el Puesto Cuernoatroz.‡Utilisez la Torche de Tabetha pour brûler la Tente nord, la Tente est et la Tente nord-est du Poste de Navrecorne.‡使用塔贝萨的火炬烧毁恐角岗哨的北部帐篷、东部帐篷和东北部帐篷。‡使用塔貝薩的火炬燒毀恐角崗哨的北方帳篷、東方帳篷和東北方帳篷。',
  }
},
[27430] = {
  {
    'Seja feita justiça pelos Hyal‡Справедливая месть за Хьялей‡Gerechtigkeit im Namen der Familie Hyal‡하이얄을 위한 정의‡Justicia para los Hyal‡Justicia para los Hyal‡Justice pour les Hyal‡为海厄尔一家复仇‡為海爾家族討回公道',
    nil,
    'Fale com o Capitão Garrido Valente na Cidadela do Esteio, que fica em Theramore.‡Поговорите с капитаном Гарраном Ваймсом в Цитадели в Тераморе.‡Sprecht mit Hauptmann Garran Mumm bei der Wehrzitadelle in Theramore.‡테라모어의 거점 요새에 있는 사령관 개런 바임스와 대화해야 합니다.‡Habla con el capitán Garran Vimes que se encuentra en la Ciudadela Garrida de Theramore.‡Habla con el capitán Garran Vimes que se encuentra en la Ciudadela Garrida de Theramore.‡Parlez au Capitaine Garran Vimaire à la citadelle de Theramore.‡与塞拉摩城堡中的的盖兰·维米斯队长谈一谈。‡和塞拉摩堡壘的蓋蘭·維米斯上尉談談。',
  }
},
[27431] = {
  {
    'Ajustando o equilíbrio‡Чуток подтолкнуть...‡Aus dem Gleichgewicht gebracht‡무너진 균형‡Rompiendo el equilibrio‡Rompiendo el equilibrio‡Un équilibre précaire‡调整平衡‡使平衡傾斜',
    nil,
    'Fale com Harrison Jones na Câmara das Estrelas.‡Поговорите с Харрисоном Джонсом в Зале Звезд.‡Sprecht mit Harrison Jones in der Kammer der Sterne.‡별의 방에 있는 해리슨 존스와 대화해야 합니다.‡Habla con Harrison Jones en la Cámara de las Estrellas.‡Habla con Harrison Jones en la Cámara de las Estrellas.‡Allez voir Harrison Jones à la Chambre des Étoiles.‡与群星之厅的哈里森·琼斯谈谈。‡在眾星之間和哈里遜·瓊斯談話。',
  }
},
[27432] = {
  {
    'Zaeldarr, o Proscrito‡Зельдарр Изгой‡Zaeldarr der Ausgestoßene‡추방자 잴다르‡Zaeldarr el Marginado‡Zaeldarr el Marginado‡Zaeldarr le Banni‡流亡者塞达尔‡『流亡者』塞達爾',
    nil,
    'Obtenha a Cabeça de Zaeldarr, o Proscrito.‡Убейте Зельдарра Изгоя и заберите его голову.‡Besorgt Zaeldarrs Kopf von Zaeldarr dem Ausgestoßenen.‡추방자 잴다르를 처치하고 그 증거로 머리카락을 입수해야 합니다.‡Consigue la cabeza de Zaeldarr de Zaeldarr el Marginado.‡Consigue la cabeza de Zaeldarr de Zaeldarr el Marginado.‡Rapportez la Tête de Zaeldarr prise sur Zaeldarr le Banni.‡从流亡者塞达尔那里夺取塞达尔的徽记。‡從『流亡者』塞達爾身上取得塞達爾的頭顱。',
  }
},
[27433] = {
  {
    'Desmantelamento‡Крошшероктомия‡Schredderektomie‡벌목기 절제술‡Trituradoractomía‡Trituradoractomía‡Déchiqueteurectomie‡伐木机切除术‡伐木機手術',
    nil,
    'Destrua Retalhadores com Lâminas de Diamante para coletar 5 Peças de Retalhadores Danificados.‡Уничтожайте крошшеры с алмазными лезвиями, чтобы собрать 5 изношенных деталей крошшера.‡Zerstört Diamantenklingenschredder, um 5 misshandelte Schredderteile zu erlangen.‡다이아몬드톱니 벌목기를 파괴하고 엉망진창인 벌목기 부품 5개를 모아야 합니다.‡Destruye trituradoras con hoja de diamante para conseguir 5 piezas de repuesto ajadas.‡Destruye trituradoras con hoja de diamante para conseguir 5 piezas de repuesto ajadas.‡Détruisez des Déchiqueteurs lame-de-diamant et récupérez 5 Pièces de déchiqueteur maltraité.‡摧毁钻石刀片切割机，收集5块损毁的伐木机零件。‡破壞鑽石刀刃伐木機並收集5個損壞的伐木機零件。',
  }
},
[27434] = {
  {
    'O caminho do adepto‡Путь адепта‡Der Pfad der Adepten‡숙련자의 길‡El camino del adepto‡El camino del adepto‡La voie de l\'adepte‡资深之道‡菁英之路',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 caixas de Lingotes de Lunaço e 5 Tendões Imortais.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира Спрингвейла, 5 слитков лунной стали и 5 жил нежити.‡Reist nach Burg Schattenfang und findet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Kisten Mondstahlbarren, und 5 ewige Sehnen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛강철 주괴 5개, 불멸의 힘줄 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 cajones de lingotes de acero de lunar y 5 tendones inextinguibles.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 cajones de lingotes de acero de lunar y 5 tendones inextinguibles.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 caisses de Lingots d\'acier lunaire et 5 Tendons impérissables.‡进入影牙城堡，从指挥官斯普林瓦尔那里夺得指挥官的神圣符记，还有5箱月钢锭和5束不死肌腱。‡到影牙城堡去，從指揮官斯普林瓦爾身上取得指揮官的聖徽、5箱月鋼錠、以及5條不滅肌腱。',
  }
},
[27435] = {
  {
    'O cajado do vidente‡Посох ясновидца‡Der Stab eines Sehers‡현자의 지팡이‡El bastón de vidente‡El bastón de vidente‡Un bâton de voyant‡先知之杖‡先知法杖',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27436] = {
  {
    'A tarefa do andarilho das sombras‡Поручение крадущегося в тени‡Die Aufgabe des Schattenläufers‡암흑방랑자의 임무‡La tarea del caminasombras‡La tarea del caminasombras‡La tâche du marcheur des ombres‡暗影行者的任务‡暗影行者的任務',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27437] = {
  {
    'A ordem da clériga das trevas‡Приказ темного священника‡Die Aufforderung des dunklen Klerikers‡어둠의 사제의 명령‡La orden de la clériga oscura‡La orden de la clériga oscura‡Les ordres du sombre clerc‡黑暗牧师的邀请‡黑暗教士的命令',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира у командира Спрингвейла, 5 вязанок осененного луной дерева и 5 образцов призрачной субстанции.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27438] = {
  {
    'A grande fuga‡Великое возвращение‡Die große Flucht‡최후의 탈출‡La Gran Evasión‡La Gran Evasión‡La grande évasion‡胜利大逃亡‡大逃亡',
    nil,
    'Fuja das Ruínas de Guilnéas com Artura e o cadáver de Lorde Godfrey.‡Покиньте руины Гилнеаса вместе с Артурой и телом лорда Годфри.‡Flieht aus den Ruinen von Gilneas mit Arthura und der Leiche von Lord Godfrey.‡길니아스 폐허에서 아투라와 함께 고드프리 경의 시체를 갖고 탈출해야 합니다.‡Escapa de las Ruinas de Gilneas con Arthura y el cadáver de Lord Godfrey.‡Escapa de las Ruinas de Gilneas con Arthura y el cadáver de Lord Godfrey.‡Échappez-vous des Ruines de Gilnéas avec Arthura, en emportant le cadavre du Seigneur Godfrey.‡带着阿尔苏拉和高弗雷勋爵的遗体逃离吉尔尼斯废墟。‡帶著高佛雷領主的屍體和阿爾蘇拉一起逃離吉爾尼斯廢墟。',
  }
},
[27439] = {
  {
    'Cajado da Luz‡Посох Света‡Stab des Lichts‡빛의 지팡이‡El bastón de la Luz‡El bastón de la Luz‡Le bâton de la Lumière‡圣光之杖‡聖光之杖',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира у командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und erhaltet das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27440] = {
  {
    'Trolls, ogros, orcs... ai, ai...‡Ничего себе – тролли, огры и орки!‡Trolls, Oger und Orcs, oh weh!‡트롤, 오우거, 오크까지... 맙소사!‡Trols, ogros y orcos, ¡madre mía!‡Trols, ogros y orcos, ¡madre mía!‡Des trolls, des ogres et des orcs, rien que ça !‡巨魔，食人魔，还有兽人。天哪！‡食人妖、巨魔，還有獸人。救人喔!',
    nil,
    'Mate o Senhor da Guerra Voone, o Grão-lorde Omokk e o Lorde Supremo Wyrmthalak.‡Убейте воеводу Вуна, вождя Омокка и властителя Змейталака.‡Tötet Kriegsmeister Voone, Hochlord Omokk und Oberanführer Wyrmthalak.‡대장군 부네, 대영주 오모크, 대군주 웜타라크를 처치해야 합니다.‡Mata al maestro de guerra Voone, al alto señor Omokk, y al señor supremo Wymthalak.‡Mata al maestro de guerra Voone, al alto señor Omokk y al señor supremo Vermiothalak. ‡Tuez le Maître de guerre Voone, le Généralissime Omokk et le Seigneur Wyrmthalak.‡杀死指挥官沃恩、欧莫克大王和维姆萨拉克。‡殺死戰爭指揮官沃恩、歐莫克大王和維姆薩拉克主宰。',
  }
},
[27441] = {
  {
    'O cajado do vidente‡Посох ясновидца‡Der Stab eines Sehers‡현자의 지팡이‡El bastón de vidente‡El bastón de vidente‡Un bâton de voyant‡先知之杖‡先知法杖',
    nil,
    'Vá à Bastilha da Presa Negra e consiga o Símbolo Sagrado do Comandante do Comandante Floraval, 5 feixes de Lunalenha e 5 Essências Fantasmagóricas.‡Отправляйтесь в крепость Темного Клыка и добудьте святой символ командира Спрингвейла, 5 вязанок осененного луной дерева и 5 призрачных субстанций.‡Reist nach Burg Schattenfang und besorgt Euch das heilige Symbol des Kommandanten von Kommandant Grüntal, 5 Bündel mondbestrahltes Holz und 5 geisterhafte Essenzen.‡그림자송곳니 성채에서 사령관의 신성한 징표, 달빛 깃든 나무 5개, 유령의 정수 5개를 획득해야 합니다.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Ve al Castillo de Colmillo Oscuro y obtén el símbolo sagrado de Comandante del comandante Vallefont, 5 paquetes de madera Lunadón y 5 esencias fantasmales.‡Rendez-vous au Donjon d\'Ombrecroc et récupérez le Symbole sacré de commandant sur le Commandant Printeval, 5 fagots de Bois de Frôlelune et 5 Essences fantomatiques.‡去影牙城堡指挥官斯普林瓦尔处收集指挥官的神圣符记，还有5捆月触之木和5份幽灵精华。‡到影牙城堡取得指揮官斯普林瓦爾身上的指揮官聖徽，5綑月觸之木，和5件鬼魅精華。',
  }
},
[27442] = {
  {
    'As muitas frentes de batalha‡По всем фронтам‡Der Krieg hat viele Fronten‡전쟁은 곳곳에서 벌어진다‡La guerra tiene muchos frentes‡La guerra tiene muchos frentes‡La guerre sur plusieurs fronts‡多线作战‡多線戰爭',
    nil,
    'Fale com o Clarividente Krogar, no Santuário Ocidental da Terra, que fica em Orgrimmar.‡Переговори с предсказателем Крогаром в Западном святилище Земли в Оргриммаре.‡Sprecht mit Scharfseher Krogar am Westlichen Erdschrein in Orgrimmar.‡오그리마의 서부 대지제단에 있는 선견자 크로가와 대화해야 합니다.‡Habla con el clarividente Krogar en El Santuario de la Tierra del Oeste en Orgrimmar.‡Habla con el clarividente Krogar en El Santuario de la Tierra del Oeste en Orgrimmar.‡Allez voir le Long-voyant Krogar au Sanctuaire Terrestre de l’Ouest, à Orgrimmar.‡与奥格瑞玛西部大地神殿的先知克洛伽交谈。‡去奧格瑪的西大地神殿找先知克洛加爾說話。',
  }
},
[27443] = {
  {
    'As muitas frentes de batalha‡По всем фронтам‡Der Krieg hat viele Fronten‡전쟁은 곳곳에서 벌어진다‡La guerra tiene muchos frentes‡La guerra tiene muchos frentes‡La guerre sur plusieurs fronts‡多线作战‡多線戰爭',
    nil,
    'Fale com Oraterra Naraat no Santuário Oriental da Terra, que fica em Ventobravo.‡Поговорите с Нараатом Говорящим с Землей в Восточном святилище Земли в Штормграде.‡Sprecht mit Erdsprecher Naraat am Östlichen Erdschrein in Sturmwind.‡스톰윈드의 동부 대지제단에 있는 대지예언자 나라트와 대화해야 합니다.‡Habla con el hablatierra Naraat en El Santuario de la Tierra del Este en la Ciudad de Ventormenta.‡Habla con el hablatierra Naraat en El Santuario de la Tierra del Este en la Ciudad de Ventormenta.‡Allez voir Naraat le Parleterre au Sanctuaire Terrestre de l’Est, à Hurlevent.‡与暴风城东部大地神殿的地语者纳拉特交谈。‡到暴風城的東大地神殿去和語地者納拉亞特交談。',
  }
},
[27444] = {
  {
    'O falso Chefe Guerreiro‡Лжевождь‡Der falsche Kriegshäuptling‡가짜 대족장‡El falso Jefe de Guerra‡El falso Jefe de Guerra‡Le faux chef de guerre‡伪酋长‡假大酋長',
    nil,
    'Mate o Chefe Guerreiro Laceral Mão Negra.‡Ликвидируйте вождя Ренда Чернорука.‡Tötet Kriegshäuptling Rend Schwarzfaust.‡대족장 렌드 블랙핸드를 처치해야 합니다.‡Mata al jefe de guerra Rend Puño Negro.‡Mata al jefe de guerra Rend Puño Negro.‡Tuez le Chef de guerre Rend Main-noire.‡杀死雷德·黑手酋长。‡殺死大酋長雷德·黑手。',
  }
},
[27445] = {
  {
    'General Drakkisath, o braço direito de Nefarian‡Генерал Драккисат, правая рука Нефариана‡General Drakkisath, Nefarians rechte Hand‡네파리안의 심복, 사령관 드라키사스‡General Drakkisath, mano de Nefarian‡General Drakkisath, mano de Nefarian‡Le général Drakkisath, bras droit de Nefarian‡达基萨斯将军‡達基薩斯將軍，奈法利安的左右手',
    nil,
    'Mate o General Drakkisath.‡Убейте генерала Драккисата.‡Tötet General Drakkisath.‡사령관 드라키사스를 처치해야 합니다.‡Mata al general Drakkisath.‡Mata al general Drakkisath.‡Tuez le Général Drakkisath.‡杀死达基萨斯将军。‡殺死達基薩斯將軍。',
  }
},
[27446] = {
  {
    'O chamado de Tanaris‡Танарис вызывает‡Tanaris ruft‡타나리스에서 온 요청‡La llamada de Tanaris‡La llamada de Tanaris‡L\'appel de Tanaris‡塔纳利斯在召唤‡塔納利斯的呼喚',
    nil,
    'Fale com Kelsey Fagulhaço em Geringontzan, que fica em Tanaris.‡Поговорите с Келси Стализвон в Прибамбасске.‡Sprecht mit Kelsey Stahlfunken in Gadgetzan in Tanaris.‡타나리스의 가젯잔에 있는 켈시 스틸스파크와 대화해야 합니다.‡Habla con Kelsey Chispacero en Gadgetzan en Tanaris.‡Habla con Kelsey Chispacero en Gadgetzan en Tanaris.‡Parlez à Kelsey Étinçacier, à Gadgetzan en Tanaris.‡跟塔纳利斯加基森的凯尔希·钢烁谈一谈。‡到塔納利斯的加基森找凱爾希‧鋼火說話。',
  }
},
[27447] = {
  {
    'O chamado de Tanaris‡Танарис вызывает‡Tanaris ruft‡타나리스에서 온 요청‡La llamada de Tanaris‡La llamada de Tanaris‡L\'appel de Tanaris‡塔纳利斯在召唤‡塔納利斯的呼喚',
    nil,
    'Fale com Carlota Tomanota em Geringontzan, que fica em Tanaris.‡Поговорите с Мегз Жестекрошшер в Прибамбасске.‡Sprecht mit Megs Schredderschreck in Gadgetzan in Tanaris.‡타나리스의 가젯잔에 있는 멕스 드레드슈레더와 대화해야 합니다.‡Habla con Megs Trituramatic en Gadgetzan en Tanaris.‡Habla con Megs Trituramatic en Gadgetzan en Tanaris.‡Parlez à Megs Déchiqueffroi, à Gadgetzan en Tanaris.‡跟塔纳利斯加基森的梅格斯·碎纸机谈一谈。‡到塔納利斯的加基森找梅格斯‧驚懼伐木機說話。',
  }
},
[27448] = {
  {
    'A jornada continua‡Путешествие продолжается‡Die Reise geht weiter‡계속되는 여행‡El camino continúa‡El camino continúa‡Le périple continue‡继续旅行‡旅程繼續',
    nil,
    'Embarque na Caravana da Fiona quando você estiver pronto para seguir para a próxima torre.‡Займите место в караване Фионы, как только будете готовы отправиться к следующей башне.‡Steigt auf Fionas Karawanenwagen, wenn Ihr bereit seid, um zum nächsten Turm aufzubrechen.‡다음 탑으로 이동할 준비가 되면 피오나의 짐마차에 탑승해야 합니다.‡Monta en la caravana de Fiona cuando estés listo para ir a la siguiente torre.‡Monta en la caravana de Fiona cuando estés listo para ir a la siguiente torre.‡Montez dans la Caravane de Fiona quand vous serez prêt à vous rendre à la prochaine tour.‡等你准备前往下一座哨塔时，就登上菲奥拉的马车。‡等你準備好要前往下個哨塔時，登上菲歐娜的馬車。',
  }
},
[27449] = {
  {
    'Honra e força‡Честь и сила‡Ehre und Stärke‡명예와 힘‡Honor y fortaleza‡Honor y fortaleza‡Honneur et force‡荣耀与力量‡榮譽與力量',
    nil,
    'Passe no teste de força de Vex\'tul.‡Пройдите испытание силы Векс\'тула.‡Besteht Vex\'tuls Stärketest.‡벡스툴이 제시하는 힘의 시험을 통과해야 합니다.‡Pasa la prueba de fortaleza de Vex\'tul.‡Pasa la prueba de fortaleza de Vex\'tul.‡Réussissez l\'épreuve de force de Vex\'tul.‡通过维克斯图的力量试炼。‡通過維克斯圖爾的力量測試。',
  }
},
[27450] = {
  {
    'O apreço de Frederick por peixes‡Фредерик, любитель рыбы‡Fredericks Vorliebe für Fisch‡프레더릭의 생선 생각‡El capricho marino de Frederick‡El capricho marino de Frederick‡Frederick aime le poisson‡弗雷德里克的海鲜梦‡弗德瑞克的魚之幻想曲',
    nil,
    'Obtenha 8 Baiacus Empesteados, 8 Caramujões de Infectis e 8 Caranguejos-aranha de Infectis da Fenda Infectis.‡Добудьте 8 чумных иглобрюхов, 8 зараженных ползецов и 8 зараженных бегунов из Чумного оврага.‡Erhaltet 8 Pestkugelfische, 8 Infektkriecher und 8 Infektkrabbler aus der Infektnarbe.‡오염의 흉터 밑바닥에서 역병 복어 8마리, 오염성 달팽이 8마리, 오염성 게 8마리를 입수해야 합니다.‡Consigue 8 aventadores de peste, 8 medidores purulentos y 8 hundidores purulentos en La Cicatriz Purulenta.‡Consigue 8 aventadores de peste, 8 medidores purulentos y 8 hundidores purulentos en La Cicatriz Purulenta.‡Récupérez 8 Poissons-globes de la peste, 8 Longards infectieux et 8 Carapateurs infectieux dans la Balafre infecte.‡在魔刃之痕收集8条疫病河豚、8只痕湖蜗牛和8只痕湖凿孔蟹。‡從魔刃之痕抓到8隻瘟疫河豚，8隻魔刃蝸牛，8隻魔刃急奔者。',
  }
},
[27451] = {
  {
    'Matar com propósito‡Убийство во благо‡Töten zu einem bestimmten Zweck‡이유 있는 살육‡Matar con un propósito‡Matar con un propósito‡Tuer pour la bonne cause‡杀戮的理由‡殺戮的理由',
    nil,
    'Viaje para o Cruzamento de Corin, ao sul, e mate membros do Flagelo que habitam a cidade. Colete 7 pedaços de Putrefação Viva. Use o Almofariz e Pilão para moer a Putrefação Viva, de maneira a transformá-la em Putrefação Coagulada.‡Отправляйтесь в Перекресток Корина на юге и расправьтесь с воинами Плети. Соберите 7 кусков живой гнили. Воспользуйтесь ступкой и пестиком, чтобы перемолоть живую гниль в сгущенную гниль.‡Reist zu Corins Kreuzung im Süden und tötet die Geißelsoldaten, die dort hausen. Sammelt 7 Stück lebendige Fäulnis. Zerstoßt die lebendige Fäulnis mit Mörser und Stößel zu geronnener Fäulnis.‡남쪽의 코린 삼거리로 가서 마을 안의 스컬지를 처치하고 살아있는 부패물 7개를 모아야 합니다. 그리고 막자 사발로 살아있는 부패물을 갈아서 응고된 부패물을 만들어야 합니다.‡Viaja hasta el Cruce de Corin, hacia el sur, y masacra a los miembros de la Plaga que habitan en esa ciudad. Reúne 7 muestras de putrefacción viva. Usa mortero y majadero para moler la putrefacción viva y convertirla en putrefacción coagulada.‡Viaja hasta el Cruce de Corin, hacia el sur, y masacra a los miembros de la Plaga que habitan en esa ciudad. Reúne 7 muestras de putrefacción viva. Usa mortero y majadero para moler la putrefacción viva y convertirla en putrefacción coagulada.‡Voyagez jusqu\'à la Croisée de Corin au sud et tuez les créatures du Fléau qui occupent la ville. Récupérez 7 morceaux de Pourriture vivante. Utilisez le Mortier et le Pilon pour transformer la Pourriture vivante en Pourriture coagulée.‡前往南方的考林路口，消灭聚居在镇上的天灾亡灵。收集7份生命腐质，然后使用研钵和捣杵，把生命腐质磨成凝固腐质。‡到南邊的考林路口去屠殺鎮裡的天譴軍團。收集7塊生命腐質，使用研缽和搗杵將其研磨成凝固腐質。',
  }
},
[27452] = {
  {
    'Traje Sombrio‡Темные одеяния‡Dunkle Gewänder‡어둠의 의복‡Atuendo oscuro‡Atuendo oscuro‡L\'emprise ténébreuse‡黑暗之衣‡黑暗裝束',
    nil,
    'Obtenha um Capuz de Sectário da Morte e Vestes de Sectário da Morte de sectários no Cruzamento de Corin.‡Добудьте головной убор сектанта Смерти и одеяния сектанта Смерти у сектантов в Перекрестке Корина.‡Erhaltet die Kopfbedeckung eines Todeskultisten und die Roben eines Todeskultisten von Kultisten in Corins Kreuzung.‡코린 삼거리에 있는 이교도들에게서 죽음의 이교도 쓰개와 죽음의 이교도 로브를 입수해야 합니다.‡Consigue un cubrecabezas de cultor de la Muerte y togas de cultor de la Muerte de los cultores en el interior del Cruce de Corin.‡Consigue un cubrecabezas de cultor de la Muerte y togas de cultor de la Muerte de los cultores en el interior del Cruce de Corin.‡Récupérez un Capuchon de sectateur de la mort et une Robe de sectateur de la mort, à la Croisée de Corin.‡从考林路口的教徒身上夺取死亡教徒的头饰和死亡教徒的长袍。‡從考林路口的教徒那裡拿到死亡教徒頭帽和死亡教徒長袍。',
  }
},
[27453] = {
  {
    'Catalisação‡Катализатор‡Katalysmus‡촉매‡Catálisis‡Catálisis‡Catalyse‡催化剂‡催化',
    nil,
    'Use o Frasco de Betina nos elementais vivos dentro do Lago Mereldar para obter 8 Agentes Pestilentos Líquidos Ativos.‡Возьмите склянки Бетины и получите 8 активных жидких вирусов чумы у живых элементалей озера Мерельдар.‡Verwendet Betinas Fläschchen gegen lebende Elementare im Mereldarsee, um 8 flüssige Seuchenwirkstoffe zu erhalten.‡메렐다르 호수의 살아있는 정령들에게 베티나의 플라스크를 사용하여, 활성화된 액체 역병 촉매제 8개를 채취해야 합니다.‡Usa los frascos de Betina con los elementales vivos en el interior del Lago Mereldar para obtener 8 agentes de peste líquidos activos.‡Usa los frascos de Betina con los elementales vivos en el interior del Lago Mereldar para obtener 8 agentes de peste líquidos activos.‡Utilisez les Flacons de Bettina sur des Élémentaires du Lac Mereldar pour obtenir 8 Agents de peste liquides actifs.‡对米雷达尔湖里的水元素使用贝蒂娜的药剂瓶，收集8瓶活性液态疫病药剂。‡將貝蒂娜的燒瓶用在米雷達爾湖的元素生物身上，取得8瓶液體瘟疫活性劑。',
  }
},
[27454] = {
  {
    'Só uma gota no balde‡Капля в море‡Nur ein Tropfen im Eimer‡새발의 피‡Tan solo una gotita‡Tan solo una gotita‡Une petite goutte dans la marmite‡只需一滴‡只要加入一滴滴',
    nil,
    'Use o seu Disfarce de Sectário da Morte para entrar no Campo-base dos Sectários da Morte e então, coloque a mistura da Betina no Caldeirão de Praga de Mereldar.‡Используйте маскировку под сектанта Смерти, проберитесь в лагерь сектантов Смерти, а затем добавьте смесь Бетины в Мерельдарский чумной котел.‡Benutzt Eure Todeskultistenverkleidung, um das Basislager der Todeskultisten zu betreten und fügt Betinas Mischung dem Mereldar Seuchenkessel zu.‡죽음의 이교도 변장을 사용하고 죽음의 이교도 주둔지에 침입해야 합니다. 그리고 베티나의 혼합물을 메렐다르 역병 가마솥에 넣어야 합니다.‡Usa tu disfraz de cultor de la Muerte para entrar en el Campamento Cultor de la Muerte y después pon la mezcla de Betina en la caldera de peste de Mereldar.‡Usa tu disfraz de cultor de la Muerte para entrar en el Campamento Cultor de la Muerte y después pon la mezcla de Betina en la caldera de peste de Mereldar.‡Utilisez votre Déguisement de sectateur de la mort pour entrer dans le Campement du Sectateur de la mort, puis versez la potion de Betina dans le Chaudron de peste de Mereldar.‡穿上死亡教徒的伪装，进入死亡教徒营地，然后将贝蒂娜的溶液倒入米雷达尔天灾之锅。‡用你的死亡教徒偽裝進入死亡教徒營地，把貝蒂娜的混合試劑放進米雷達爾瘟疫大鍋。',
  }
},
[27455] = {
  {
    'Garotos são só garotos‡Ох уж эти мальчики‡Jungs bleiben Jungs‡남자들은 다 그래‡Los tíos son así‡Los tíos son así‡Ah, les garçons…‡本性难移的大男孩‡男兒本色',
    nil,
    'Encontre Gidwin Fitáurea na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Найдите Гидвина Златокоса в часовне Последней Надежды в Восточных Чумных землях.‡Findet Gidwin Goldzopf vor der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대 희망의 빛 예배당에 있는 기드윈 골드브레이즈를 찾아야 합니다.‡Encuentra a Gidwin Trenzadorada en la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este.‡Encuentra a Gidwin Trenzadorada en la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este.‡Trouvez Gidwin Nattes-d’Or à la Chapelle de l’Espoir de Lumière, dans les Maleterres de l\'Est.‡在东瘟疫之地的圣光之愿礼拜堂找到吉德文·金须。‡在東瘟疫之地的聖光之願禮拜堂找出基德溫·金辮。',
  }
},
[27456] = {
  {
    'Carniçaria dos carniceiros‡Личинокос‡Nicht auf leeren Maden‡먹을거리 모으기‡Cazando gusanos‡Cazando gusanos‡Un ver, ça va…‡收集虫肉‡收集一些蟲(蟲們)',
    nil,
    'Procure os Vermes Carniceiros e os Devoradores de Carniça da região. Mate-os e colete 15 Nacos de Carne de Verme Carniceiro.‡Убивайте личинок-падальщиков и пожирателей. Соберите 15 кусков мяса червя-трупоеда.‡Sucht in der Umgebung nach Aaslarven und Aasverschlingern. Tötet sie und bringt 15 Scheiben Aaswurmfleisch an Euch.‡예배당 주변에서 청소부구더기와 걸신들린 청소부구더기를 찾아 처치하고 청소부구더기 고기덩어리 15개를 모아야 합니다.‡Busca las larvas y devoradores carroñeros de la zona. Mátalos y recoge 15 trozos de carne de gusano carroñero.‡Busca las larvas y devoradores carroñeros de la zona. Mátalos y recoge 15 trozos de carne de gusano carroñero.‡Cherchez des Larves et des Dévoreurs putrides dans la région. Tuez-les, et récupérez 15 morceaux de Chair de ver putride.‡在东瘟疫之地寻找腐肉虫和腐肉吞噬者，杀死它们，收集15份食腐虫肉块。‡找出軍團裡的腐肉蟲和吞噬者。殺了牠們，並採收15塊食腐蟲肉塊。',
  }
},
[27457] = {
  {
    'Uma aliança oportuna‡Случайный попутчик‡Eine Gelegenheitsallianz‡적절한 연합‡Una alianza oportuna‡Una alianza oportuna‡Une alliance opportune‡及时的联盟‡結盟好時機',
    nil,
    'Fale com a Fiona na Torre da Muralha Leste, que fica nas Terras Pestilentas Orientais.‡Поговорите с Фионой в Восточной башне в Восточных Чумных землях.‡Meldet Euch bei Fiona am Ostwallturm in den Östlichen Pestländern.‡동부 역병지대의 동부방벽 경비탑에서 피오나와 만나야 합니다.‡Reúnete con Fiona en la Torre de la Muralla del Este en las Tierras de la Peste del Este.‡Reúnete con Fiona en la Torre de la Muralla del Este en las Tierras de la Peste del Este.‡Retrouvez Fiona à la Tour du Mur d\'Est, dans les Maleterres de l\'Est.‡去找东瘟疫之地东墙哨塔的菲奥拉。‡到東瘟疫之地的東牆之塔和菲歐娜一起報到。',
  }
},
[27458] = {
  {
    'Leandro e o curativo‡Дымок и бинты‡Smokey und der Verband‡스모키와 붕대‡Smokey y la venda‡Smokey y la venda‡Smokey et le bandage‡烟鬼和绷带‡煙鬼和繃帶',
    nil,
    'Obtenha as Vestes do Carranca de Estêvão Carranca no Engenho Assombrado.‡Зайдите на лесопилку Бровача и возьмите перевязь Бровача у Стивена Бровача.‡Besorgt Braumanns Wickel von Stephan Braumann in Braumanns Mühle.‡브라우만 제분소의 스티븐 브라우만에게서 브라우만의 붕대를 입수해야 합니다.‡Consigue las envolturas de Cejifrente de Stephen Cejifrente en el Molino Cejifrente.‡Consigue las envolturas de Cejifrente de Stephen Cejifrente en el Molino Cejifrente.‡Récupérez le Linceul de Browman sur Stephen Browman, à la Scierie de Browman.‡从布洛米尔的史蒂芬·布劳曼那里获得布劳曼的包裹物。‡從布洛曼磨坊的史蒂芬·布洛曼身上拿到布洛曼的裹布。',
  }
},
[27459] = {
  {
    'A Irmandade da Luz‡Братство Света‡Die Bruderschaft des Lichts‡빛의 결사단‡La Hermandad de la Luz‡La Hermandad de la Luz‡La Fraternité de la Lumière‡圣光兄弟会‡聖光兄弟會',
    nil,
    'Apresente-se à Arquimaga Ângela Santoro na Manopla de Tyr, que fica nas Terras Pestilentas Orientais.‡Явитесь с докладом к верховному магу Анжеле Досантос в Длань Тира в Восточных Чумных землях.‡Meldet Euch bei Erzmagierin Angela Dosantos in Tyrs Hand in den Östlichen Pestländern.‡동부 역병지대 티르의 손 수도원에 있는 대마법사 안젤라 도산토스에게 보고해야 합니다.‡Preséntate ante la archimaga Angela Dosantos en la Mano de Tyr en las Tierras de la Peste del Este.‡Preséntate ante la archimaga Angela Dosantos en la Mano de Tyr en las Tierras de la Peste del Este.‡Allez voir l\'Archimage Angela Dosantos à la Main de Tyr, dans les Maleterres de l\'Est.‡去找东瘟疫之地提尔之手的大法师安吉拉·杜萨图斯。‡到東瘟疫之地的提爾之手找大法師安琪拉·多桑杜。',
  }
},
[27460] = {
  {
    'Aterrissagem suave‡Мягкая посадка‡Sanfte Landung‡연착륙‡Aterrizaje suave‡Aterrizaje suave‡Atterrissage en douceur‡软着陆‡輕緩著陸',
    nil,
    'Mate quaisquer 10 criaturas da Cruzada Escarlate dentro da Manopla de Tyr.‡Убейте 10 любых представителей Алого ордена в Длани Тира.‡Tötet 10 beliebige Anhänger des Scharlachroten Kreuzzugs in Tyrs Hand.‡티르의 손 수도원 안에 있는 붉은십자군 10명을 처치해야 합니다.‡Mata a 10 criaturas de la Cruzada Escarlata en la Mano de Tyr.‡Mata a 10 criaturas de la Cruzada Escarlata en la Mano de Tyr.‡Tuez 10 Créatures de la Croisade écarlate, dans la Main de Tyr.‡在提尔之手杀死任意10个血色十字军生物。‡在提爾之手殺死10名血色十字軍。',
  }
},
[27461] = {
  {
    'Para tomar a abadia‡Штурм аббатства‡Die Abtei einnehmen‡수도회당 탈환‡Tomar la abadía‡Tomar la abadía‡Prendre l\'abbaye‡拿下修道院‡攻下修道院',
    nil,
    'Apresente-se ao Comandante Eligor Alvorada do lado de fora da abadia da Manopla de Tyr, que fica nas Terras Pestilentas Orientais.‡Явитесь с докладом к командиру Элигору Вестнику Рассвета к аббатству Длани Тира в Восточных Чумных землях.‡Meldet Euch bei Kommandant Eligor Morgenbringer außerhalb der Abtei in Tyrs Hand in den Östlichen Pestländern.‡동부 역병지대 티르의 손 수도원 서쪽에 있는 수도회당 입구에서 사령관 엘리고르 돈브링어에게 보고해야 합니다.‡Preséntate ante el comandante Eligor Albar en el exterior de la abadía en la Mano de Tyr en las Tierras de la Peste del Este.‡Preséntate ante el comandante Eligor Albar en el exterior de la abadía en la Mano de Tyr en las Tierras de la Peste del Este.‡Allez voir le Commandant de la croisade Eligor Portelaube à l\'extérieur de l\'abbaye de la Main de Tyr, dans les Maleterres de l\'Est.‡去找东瘟疫之地提尔之手修道院外的指挥官埃里戈尔·黎明使者。‡到東瘟疫之地的提爾之手修道院外找十字軍指揮官艾利格·黎明使者。',
  }
},
[27462] = {
  {
    'Para tomar o quartel‡Штурм казармы‡Die Kaserne einnehmen‡병영 탈환‡Hacerse con el cuartel‡Hacerse con el cuartel‡Prendre la caserne‡拿下兵营‡攻下兵營',
    nil,
    'Apresente-se ao Comandante Cruzado Korfax na frente do Quartel na Manopla de Tyr, que fica nas Terras Pestilentas Orientais.‡Явитесь с докладом к командиру рыцарей Корфаксу к казарме Длани Тира в Восточных Чумных землях.‡Meldet Euch bei Kreuzzugskommandant Korfax vor der Kaserne in Tyrs Hand in den Östlichen Pestländern.‡동부 역병지대 티르의 손 수도원에 있는 병영 앞에서 십자군 사령관 코팩스에게 보고해야 합니다.‡Preséntate ante el Comandante de Cruzada Korfax delante del cuartel en la Mano de Tyr en las Tierras de la Peste del Este.‡Preséntate ante el Comandante de Cruzada Korfax delante del cuartel en la Mano de Tyr en las Tierras de la Peste del Este.‡Allez voir le Commandant de la croisade Korfax devant la Caserne à la Main de Tyr, dans les Maleterres de l\'Est.‡去找东瘟疫之地提尔之手兵营前面的指挥官科尔法克斯。‡到東瘟疫之地的提爾之手兵營前找十字軍指揮官柯菲斯。',
  }
},
[27463] = {
  {
    'Um sonho de menino‡Мечта детства‡Ein Kindheitstraum‡어린 시절의 꿈‡Un sueño de infancia‡Un sueño de infancia‡Un rêve d\'enfant‡儿时的梦想‡青少年的夢想',
    nil,
    'Fale com o Lorde Maximiliano Tyrosus dentro da Capela Esperança da Luz.‡Зайдите в часовню Последней Надежды и поговорите с лордом Максвеллом Тироссом.‡Sprecht mit Lord Maxwell Tyrosus in der Kapelle des Hoffnungsvollen Lichts.‡희망의 빛 예배당 안에서 맥스웰 티로서스 경과 대화해야 합니다.‡Habla con Lord Maxwell Neófitus en el interior de la Capilla de la Esperanza de la Luz.‡Habla con Lord Maxwell Neófitus en el interior de la Capilla de la Esperanza de la Luz.‡Parlez au Seigneur Maxwell Tyrosus dans la Chapelle de l\'Espoir de Lumière.‡与圣光之愿礼拜堂里的玛克斯韦尔·泰罗索斯男爵交谈。‡到聖光之願禮拜堂裡和麥斯威爾·泰羅索斯領主談話。',
  }
},
[27464] = {
  {
    'Chamado argênteo: o teste da cripta‡Серебряный зов: испытание в склепе‡Argentumruf: Die Prüfung der Gruft‡은빛십자군의 부름: 납골당의 시험‡Llamada Argenta: La prueba de la cripta‡Llamada Argenta: La prueba de la cripta‡L\'appel d\'Argent : les épreuves de la crypte‡银色召唤：墓穴的试炼‡銀白召喚:地穴試煉',
    nil,
    'Entre na Cripta atrás da Capela Esperança da Luz, leia o Pergaminho Argênteo e complete o teste.‡Войдите в склеп за часовней Последней Надежды, прочитайте Серебряный свиток, а затем пройдите испытание.‡Betretet die Gruft hinter der Kapelle des Hoffnungsvollen Lichts, lest aus der Argentumschriftrolle und schließt die Prüfung ab.‡희망의 빛 예배당 뒤쪽의 납골당으로 들어가서 은빛 여명회 두루마리를 읽은 후, 시험을 통과해야 합니다.‡Entra en la cripta que se encuentra tras la Capilla de la Esperanza de la Luz, lee el pergamino Argenta y completa su prueba.‡Entra en la cripta que se encuentra tras la Capilla de la Esperanza de la Luz, lee el pergamino Argenta y completa su prueba.‡Entrez dans la Crypte derrière la Chapelle de l\'Espoir de Lumière, lisez le Parchemin d\'Argent, puis réussissez l\'épreuve.‡进入圣光之愿礼拜堂后面的墓穴，阅读银白卷轴，然后完成他的试炼。‡進入聖光之願禮拜堂後面的地穴，閱讀銀白卷軸，然後完成他的測試。',
  }
},
[27465] = {
  {
    'Chamado argênteo: a Clareira Nociva‡Серебряный зов: Ядовитая поляна‡Argentumruf: Das Giftige Tal‡은빛십자군의 부름: 맹독의 숲‡Llamada Argenta: El Claro Ponzoñoso‡Llamada Argenta: El Claro Ponzoñoso‡L\'appel d\'Argent : la clairière Nocive‡银色召唤：剧毒林地‡銀白召喚:劇毒林地',
    nil,
    'Mate 16 Membros do Flagelo e 8 Sectários dentro do Engenho Assombrado e da Clareira Nociva. Volte à Capela Esperança da Luz se o Tarenar ou o Gidwin for morto.‡Убейте 16 воинов Плети и 8 сектантов на лесопилке Бровача и Ядовитой поляне. Если Таренар или Гидвин погибнут, возвращайтесь в часовню Последней Надежды.‡Tötet 16 Angehörige der Geißel und 8 Kultisten in Braumanns Mühle und dem Giftigen Tal. Kehrt zur Kapelle des Hoffnungsvollen Lichts zurück, wenn Tarenar oder Gidwin getötet werden.‡브라우만 제분소와 맹독의 숲 안에서 스컬지 16마리와 이교도 8명을 처치해야 합니다. 기드윈이나 타레나가 사망하면 희망의 빛 예배당으로 가야 합니다.‡Mata a 16 miembros de la Plaga y a 8 cultores en el interior del Molino Cejifrente y en El Claro Ponzoñoso. Vuelve a la Capilla de la Esperanza de la Luz si Tarenar o Gidwin son asesinados.‡Mata a 16 miembros de la Plaga y a 8 cultores en el interior del Molino Cejifrente y en El Claro Ponzoñoso. Vuelve a la Capilla de la Esperanza de la Luz si Tarenar o Gidwin son asesinados.‡Tuez 16 créatures du Fléau et 8 Sectateurs dans la Scierie de Browman et la Clairière Nocive. Retournez à la Chapelle de l\'Espoir de Lumière si Tarenar ou Gidwin est tué.‡在布洛米尔和剧毒林地杀死16个天灾和8个教徒。如果塔伦纳或吉德文被杀的话，就返回圣光之愿礼拜堂。‡在布洛曼磨坊和劇毒林地消滅16個天譴生物和8個死亡教徒。要是塔瑞納爾或基德溫被殺了就到聖光之願禮拜堂去。',
  }
},
[27466] = {
  {
    'Chamado argênteo: o Vilarejo do Norte‡Серебряный зов: Северный Дол‡Argentumruf: Nordtal‡은빛십자군의 부름: 노스데일‡Llamada Argenta: Vallenorte‡Llamada Argenta: Vallenorte‡L\'appel d\'Argent : Valnord‡银色召唤：北谷‡銀白召喚:北谷',
    nil,
    'Fale com a Fiona na Torre da Muralha Leste, que fica nas Terras Pestilentas Orientais.‡Поговорите с Фионой в Восточной башне в Восточных Чумных землях.‡Sprecht mit Fiona am Ostwallturm in den Östlichen Pestländern.‡동부 역병지대의 동부방벽 경비탑에 있는 피오나와 대화해야 합니다.‡Habla con Fiona en la Torre de la Muralla del Este en las Tierras de la Peste del Este.‡Habla con Fiona en la Torre de la Muralla del Este en las Tierras de la Peste del Este.‡Parlez à Fiona à la Tour du Mur d\'Est, dans les Maleterres de l\'Est.‡与东瘟疫之地东墙哨塔的菲奥拉交谈。‡到東瘟疫之地的東牆之塔和菲歐娜談談。',
  }
},
[27467] = {
  {
    'Lâminas enterradas‡Похоронные клинки‡Vergrabene Klingen‡영원한 안식을‡Hojas enterradas‡Hojas enterradas‡Les lames fatales‡光触之刃‡埋入刀刃',
    nil,
    'Enterre as Lâminas Tocadas pela Luz nos corpos de 10 Soldados do Flagelo Mortos.‡Воткните осененные Светом клинки в тела десяти убитых штурмовиков Плети.‡Stoßt die lichtberührten Klingen in die Leichen von 10 getöteten Reitersoldaten der Geißel.‡빛이 깃든 칼날을 살해된 스컬지 돌격병 10명의 시체에 찔러넣어야 합니다.‡Entierra las hojas tocadas por la Luz en los cuerpos de 10 soldados de caballería de la Plaga asesinados.‡Entierra las hojas tocadas por la Luz en los cuerpos de 10 soldados de caballería de la Plaga asesinados.‡Enfoncez les Lames touchées par la Lumière dans les corps de 10 Troupiers du Fléau tués.‡将光触之刃插进10个被杀死的天灾士兵的尸体中。‡將聖光之觸刀刃埋入10個死掉的天譴裝甲兵屍體裡。',
  }
},
[27468] = {
  {
    'Cercando o Tanque de Cerco‡Спасение осадного танка‡Rettung des Belagerungspanzers‡공성 전차 구출‡Rescatar el tanque de asedio‡Rescatar el tanque de asedio‡À la rescousse des chars‡修理攻城坦克‡搶救攻城坦克',
    nil,
    'Fale com um Comandante de Tanque de Cerco que esteja em cima de um Tanque de Cerco de Beiralta. Defenda o tanque enquanto os engenheiros fazem reparos.‡Поговорите с командиром осадного танка, который стоит на своем подбитом осадном танке Высокого берега. Защищайте танк, пока инженеры его ремонтируют.‡Sprecht mit einem Belagerungspanzerkommandanten auf einem kaputten Belagerungspanzer von Hochstade. Verteidigt den Panzer, während die Ingenieure Reparaturen vornehmen.‡움직이지 못하는 높은 둑 공성 전차 꼭대기에 서 있는 공성 전차 부대장과 대화해야 합니다. 기술자들이 전차를 수리하는 동안 전차를 보호하십시오.‡Habla con el comandante de tanques de asedio que está encima de un tanque de asedio de Bancalto destartalado. Defiende el tanque mientras los ingenieros lo reparan.‡Habla con el comandante de tanques de asedio que está encima de un tanque de asedio Bancalto destartalado. Defiende el tanque mientras los ingenieros lo reparan. ‡Allez voir un Commandant de char de siège, que vous trouverez sur son char de siège hors d\'usage de Hauterive. Défendez le char pendant que les ingénieurs le réparent.‡跟站在受损的滩头堡攻城坦克上的攻城坦克指挥官谈一谈。确保工程技师在修理坦克期间不受干扰。‡在損壞的高岸堡攻城坦克上和攻城坦克指揮官說話。當工程師進行維修時，保護好坦克。',
  }
},
[27469] = {
  {
    'Amigos do outro lado‡Друзья на другой стороне‡Freunde auf der anderen Seite‡반대 편의 친구‡Amigos del otro lado‡Amigos del otro lado‡Des alliés de l\'autre côté‡另一侧的朋友‡敵對陣營的朋友',
    nil,
    'Encontre Acrídeo.‡Разыщите Акрайда.‡Findet Acride.‡아크라이드를 찾아야 합니다.‡Encuentra a Acride.‡Encuentra a Acride.‡Trouvez Acride.‡找到阿克莱德。‡找到阿克萊德。',
  }
},
[27470] = {
  {
    'Aliado em potencial‡Потенциальный союзник‡Ein möglicher Verbündeter‡잠재적 아군‡Un posible aliado‡Un posible aliado‡Un allié potentiel‡潜在的盟友‡潛在的盟友',
    nil,
    'Encontre Acrídeo.‡Разыщите Акрайда.‡Findet Acride.‡아크라이드를 찾아야 합니다.‡Encuentra a Acride.‡Encuentra a Acride.‡Trouvez Acride.‡找到阿克莱德。‡找到阿克萊德。',
  }
},
[27471] = {
  {
    'Anomalia Rocha Negra‡Странный орк Черной горы‡Schwarzfelsanomalie‡검은바위 변형물‡Anomalía Roca Negra‡Anomalía Roca Negra‡Une anomalie au pic Rochenoire‡黑石山的怪事‡異常的黑石獸人',
    nil,
    'Encontre Acrídeo.‡Разыщите Акрайда.‡Findet Acride.‡아크라이드를 찾아야 합니다.‡Encuentra a Acride.‡Encuentra a Acride.‡Trouvez Acride.‡找到阿克莱德。‡找到阿克萊德。',
  }
},
[27472] = {
  {
    'Erga-se, Godfrey‡Восстань, Годфри‡Erwacht, Godfrey‡일어나라, 고드프리‡Levántate, Godfrey‡Levántate, Godfrey‡Godfrey, lève-toi et marche !‡复活吧，高弗雷‡起來吧，高佛雷',
    nil,
    'Fique junto da Grande Dama Sylvana Correventos enquanto ela oficia a iniciação de Lorde Godfrey e seus homens.‡Встаньте рядом с леди Сильваной Ветрокрылой во время оживления лорда Годфри и его людей.‡Bleibt bei Fürstin Sylvanas Windläufer, während sie Lord Godfrey und seine Männer aufnimmt.‡여군주 실바나스 윈드러너의 곁에서 고드프리 경과 부하들이 되살아나는 모습을 지켜봐야 합니다.‡Permanece junto a Lady Sylvanas Brisaveloz mientras inicia a Lord Godfrey y a sus hombres.‡Permanece junto a Lady Sylvanas Brisaveloz mientras inicia a Lord Godfrey y a sus hombres.‡Restez aux côtés de Dame Sylvanas Coursevent tandis qu’elle initie le Seigneur Godfrey et ses hommes.‡在希尔瓦娜斯·风行者接纳高弗雷勋爵和他的人时站在她身边。‡站在希瓦娜斯·風行者女士的身旁，看著她進行儀式來復活高佛雷領主和他的戰士。',
  }
},
[27473] = {
  {
    '‡Новости из Стальгорна‡Was wackelt in Eisenschmiede?‡휘청이는 아이언포지‡¿Qué ocurre en Forjaz?‡‡Forgefer en galère‡动荡的铁炉堡‡',
    nil,
    '‡Поговорите с буревестницей Милрой в Стальгорне.‡Sprecht mit Sturmruferin Mylra in Eisenschmiede.‡아이언포지에 있는 폭풍소환사 마일라와 대화해야 합니다.‡Habla con la clamatormentas Mylra en Forjaz.‡‡Allez voir la Mande-foudre Mylra à Forgefer.‡跟铁炉堡的风暴召唤者米尔拉谈一谈。‡',
  }
},
[27474] = {
  {
    'Rompendo a barreira‡Убрать барьер‡Die Barriere durchbrechen‡보호막 파괴‡Rompiendo la barrera‡Rompiendo la barrera‡La poche dimensionnelle‡突破屏障‡打破屏障',
    nil,
    'Encontre o Códice de Lenhâmbar‡Найдите кодекс Янтарной мельницы.‡Findet den Kodex von Mühlenbern.‡호박색 농장 고서를 찾아야 합니다.‡Encuentra el códice de Molino de Ámbar.‡Encuentra el códice de Molino de Ámbar.‡Trouvez le Codex de Moulin-de-l\'Ambre.‡找到安伯米尔圣典。‡找到安伯米爾聖典。',
  }
},
[27475] = {
  {
    'Servos obstinados‡Упорные защитники‡Unnachgiebige Diener‡항복하지 않는 시종‡Servidores implacables‡Servidores implacables‡Élémentaires et inflexibles‡不屈的仆从‡頑固的僕從',
    nil,
    'Colete 6 Núcleos dos Servos.‡Добудьте 6 ядер элементалей-служителей.‡Bergt 6 Dienerkerne.‡시종의 핵 6개를 회수해야 합니다.‡Consigue 6 núcleos de servidores.‡Consigue 6 núcleos de servidores.‡Emparez-vous de 6 Noyaux de serviteurs.‡获取6颗仆从之核。‡取回6個僕從之核。',
  }
},
[27476] = {
  {
    'Dalar Tessalba‡Далар Ткач Рассвета‡Dalar Morgenweber‡달라 돈위버‡Dalar Tejealba‡Dalar Tejealba‡Les talents de Dalar Tisselaube‡达拉尔·道恩维沃尔‡達拉爾·織曦者',
    nil,
    'Leve o Códice de Lenhâmbar para Dalar Tessalba no Sepulcro, que fica na Floresta de Pinhaprata.‡Отнесите кодекс Янтарной мельницы Далару Ткачу Рассвета в Гробницу в Серебряном бору.‡Liefert den Kodex von Mühlenbern bei Dalar Morgenweber am Grabmal im Silberwald ab.‡호박색 농장 고서를 은빛소나무 숲의 공동묘지에 있는 달라 돈위버에게 가져가야 합니다.‡Entrega el códice de Molino de Ámbar a Dalar Tejealba en El Sepulcro, en el Bosque de Argénteos.‡Entrega el códice de Molino de Ámbar a Dalar Tejealba en El Sepulcro, en el Bosque de Argénteos.‡Apportez le Codex de Moulin-de-l’Ambre à Dalar Tisselaube, au Sépulcre, dans la Forêt des Pins-Argentés.‡把安伯米尔圣典交给银松森林瑟伯切尔的达拉尔·道恩维沃尔。‡把安伯米爾聖典帶去銀松森林的瑟伯切爾給達拉爾·織曦者。',
  }
},
[27477] = {
  {
    'O corpulento‡Огромный червь‡Der Korpulente‡뚱뚱보 괴물‡El corpulento‡El corpulento‡Le corpulent‡肥胖的巨虫‡肥仔',
    nil,
    'Encontre o Brocassangre nos ermos do norte das Terras Pestilentas e destrua-o.‡Идите в северные пустоши Восточных Чумных земель, найдите там Мерзкослиза и убейте.‡Findet Blutschlinger im nördlichen Ödland der Östlichen Pestländer und vernichtet ihn.‡동부 역병지대의 북부 불모지에서 피고름구더기를 찾아 처치해야 합니다.‡Encuentra a Borelgore en las planicies del norte en las Tierras de la Peste del Este y acaba con él.‡Encuentra a Borelgore en las planicies del norte en las Tierras de la Peste del Este y acaba con él.‡Trouvez Creusechair, au nord des Maleterres de l’Est et détruisez-le.‡在东瘟疫之地的北部荒野中找到淤血虫，并消灭它。‡在東瘟疫之地的北方荒原找到淤血蟲並殺死牠。',
  }
},
[27478] = {
  {
    'Relios, o Guardião de Relíquias‡Хранитель реликвий Релиос‡Relios, Bewahrer der Relikte‡유물 수호자 렐리오스‡Relios el Vigilante de Reliquias‡Relios el Vigilante de Reliquias‡Relios, le gardien de la relique‡圣物守护者莱利斯‡聖物守衛者瑞利歐斯',
    nil,
    'Encontre um Anel-sinete de Arquimago de Dalaran.‡Разыщите перстень-печатку верховного мага Даларана.‡Findet einen Siegelring eines Erzmagiers aus Dalaran.‡달라란 대마법사의 인장 반지를 찾아야 합니다.‡Encuentra un sello de archimago de Dalaran.‡Encuentra un sello de archimago de Dalaran.‡Trouvez une Chevalière d\'archimage de Dalaran.‡找到达拉然大法师的图章指环。‡找到一顆達拉然大法師的璽戒',
  }
},
[27479] = {
  {
    'Indignação íntegra‡Праведный гнев‡Rechtschaffene Empörung‡타당한 분노‡Indignación justificada‡Indignación justificada‡Une indignation justifiée‡正义之怒‡正義的憤慨',
    nil,
    'Obtenha 30 Olhos de Esfolamusgo de trolls Esfolamusgo em Zul\'Mashar.‡Идите в Зул\'Машар и наберите 30 глаз троллей из племени Моходеров.‡Erbeutet 30 Moosschinderaugen von Moosschindertrollen in Zul\'Mashar.‡줄마샤르의 이끼껍질 트롤에게서 이끼껍질 눈썹 30개를 모아야 합니다.‡Consigue 30 ojos de Fustamusgo de trols Fustamusgo en Zul\'Mashar.‡Consigue 30 ojos de Fustamusgo de trols Fustamusgo en Zul\'Mashar.‡Récupérez 30 Yeux d\'Écorchemousse sur des Trolls écorchemousses à Zul\'Mashar.‡从祖玛沙尔的烂苔巨魔身上获得30份烂苔巨魔的魔精。‡到祖爾瑪夏從爛苔食人妖身上取得30個爛苔之眼。',
  }
},
[27480] = {
  {
    'As energias do meridiano‡Подземная энергия‡Ley-Energien‡지맥의 힘‡Energía Ley‡Energía Ley‡Énergie tellurique‡地脉能量‡啟動能量',
    nil,
    'Colete 8 Remanentes Arcanos.‡Найдите 8 сгустков тайной магии.‡Findet 8 arkane Überbleibsel.‡비전 잔여물 8개를 회수해야 합니다.‡Recupera 8 remanentes arcanos.‡Recupera 8 remanentes arcanos.‡Trouvez 8 Vestiges des arcanes.‡获得8份奥术残渣。‡找到8枚秘法殘餘。',
  }
},
[27481] = {
  {
    'Fora do zigurate‡Прочь из зиккурата!‡Aus dem Ziggurat‡지구라트 밖으로‡Fuera del zigurat‡Fuera del zigurat‡Hors de la ziggourat‡金字塔之上‡通靈塔外',
    nil,
    'Obtenha o Corpo do Senhor da Guerra Thresh\'jin.‡Добудьте тело полководца Молот\'джина.‡Erbeutet den Leichnam von Kriegsherr Thresh\'jin.‡장군 트레쉬진의 유해를 입수해야 합니다.‡Consigue el cadáver del Señor de la Guerra Thresh\'jin.‡Consigue el cadáver del Señor de la Guerra Thresh\'jin.‡Récupérez le Corps du seigneur de guerre Thresh\'jin.‡得到督军塔雷金之躯。‡取得督軍塔雷什森的屍體。',
  }
},
[27482] = {
  {
    'Chamas adentro‡В самое пекло‡Hinein in die Flammen‡화염 속으로‡En las llamas‡En las llamas‡Dans les flammes‡进入火焰‡烈焰之中',
    nil,
    'Quando você estiver pronto para se despedir de Vex\'tul, jogue o corpo do Senhor da Guerra Thresh\'jin na fogueira no topo do zigurate de Zul\'Mashar.‡Когда вы будете готовы расстаться с Векс\'тулом, бросьте тело полководца Молот\'джина в огонь, горящий на вершине зиккурата Зул\'Машара.‡Werft den Leichnam des Kriegsherrn Thresh\'jin in das Feuer oben auf Zul\'Mashars Ziggurat, wenn Ihr bereit seid, Euch von Vex\'tul zu trennen.‡벡스툴과 작별할 준비가 되면, 줄마샤르의 지구라트 꼭대기에 있는 화톳불에 장군 트레쉬진의 유해를 던져넣어야 합니다.‡Cuando estés preparado para separarte de Vex\'tul, lanza el cadáver del Señor de la Guerra Thresh\'jin a la hoguera que hay en lo alto del zugurat de Zul\'Mashar.‡Cuando estés preparado para separarte de Vex\'tul, lanza el cadáver del Señor de la Guerra Thresh\'jin a la hoguera que hay en lo alto del zugurat de Zul\'Mashar.‡Quand vous serez prêt à vous séparer de Vex\'tul, lancez le corps du Seigneur de guerre Thresh\'jin dans le Feu de joie, en haut de la Ziggourat de Zul\'Mashar.‡你准备好和维克斯图离别的话，就把督军塔雷金之躯扔到祖玛沙尔神塔顶部的篝火里去。‡當你準備好要和維克斯圖爾分開的時候，將督軍塔雷什森的屍體丟到祖爾瑪夏通靈塔頂的大火堆之中。',
  }
},
[27483] = {
  {
    'Vingança prática‡Практичная месть‡Praktische Rache‡실용적인 복수‡Venganza práctica‡Venganza práctica‡La vengeance est un plat qui se mange quand l’occasion fait le larron‡实用主义的复仇‡實際的復仇',
    nil,
    'Mate 12 humanos de Dalaran.‡Убейте 12 любых людей из Даларана.‡Tötet 12 beliebige Menschen aus Dalaran.‡달라란의 인간 12명을 처치해야 합니다.‡Mata a 12 humanos de Dalaran.‡Mata a 12 humanos de Dalaran.‡Tuez 12 humains de Dalaran.‡杀死12名达拉然人类。‡殺死12名達拉然的人類。',
  }
},
[27484] = {
  {
    'Apenas um pode entrar‡Войти сможет только один‡Es darf nur einer eintreten‡오직 하나만이 들어가리라‡Solo uno puede entrar‡Solo uno puede entrar‡C’est encore pour vous !‡只有一个人能进‡只有一個能進去',
    nil,
    'Leve o Anel-sinete de Arquimago de Dalaran para a Grande Dama Sylvana Correventos na Linha de Frente dos Renegados, que fica na Floresta de Pinhaprata.‡Возвращайтесь на Передовую Отрекшихся в Серебряном бору и отдайте Сильване Ветрокрылой перстень-печатку верховного архимага Даларана.‡Bringt den Siegelring eines Erzmagiers aus Dalaran zu Fürstin Sylvanas Windläufer an der Frontlinie der Verlassenen im Silberwald zurück.‡달라란 대마법사의 인장 반지를 은빛소나무 숲의 포세이큰 전초지에 있는 여군주 실바나스 윈드러너에게 가져가야 합니다.‡Llévale el sello del archimago Dalaran a Lady Sylvanas Brisaveloz en el Frente Renegado en el Bosque de Argénteos.‡Llévale el sello del archimago Dalaran a Lady Sylvanas Brisaveloz en el Frente Renegado en el Bosque de Argénteos.‡Apportez la Chevalière d’archimage de Dalaran à Dame Sylvanas Coursevent, sur le Front des Réprouvés, dans la Forêt des Pins-Argentés.‡把达拉然大法师的图章指环交给银松森林被遗忘者先锋军的希尔瓦娜斯·风行者。‡將達拉然大法師的璽戒帶去銀松森林的被遺忘者戰事前線，交給希瓦娜斯·風行者女士。',
  }
},
[27485] = {
  {
    'Recepção calorosa‡Теплый прием‡Ein herzliches Willkommen‡따뜻한 환영‡Una cálida bienvenida‡Una cálida bienvenida‡Un accueil chaleureux‡热烈欢迎‡熱烈歡迎',
    nil,
    'Encontre com Lirastrasza no Rubro Reduto.‡Отправляйтесь на Гранатовый редут и поговорите с Лирастразой.‡Trefft Euch mit Lirastrasza im Zinnoberrefugium.‡주홍빛 보루에 있는 리라스트라자를 만나야 합니다.‡Reúnete con Lirastrasza en el Reducto Bermellón.‡Reúnete con Lirastrasza en el Reducto Bermellón.‡Allez voir Lirastrasza à la Redoute Vermillon.‡去找朱红庇护所的莉拉斯塔萨。‡到朱紅壁壘和麗菈史卓莎會面。',
  }
},
[27486] = {
  {
    'Recepção calorosa‡Теплый прием‡Ein herzliches Willkommen‡따뜻한 환영‡Una cálida bienvenida‡Una cálida bienvenida‡Un accueil chaleureux‡热烈欢迎‡熱烈歡迎',
    nil,
    'Encontre com Lirastrasza no Rubro Reduto.‡Отправляйтесь на Гранатовый редут и поговорите с Лирастразой.‡Trefft Euch mit Lirastrasza im Zinnoberrefugium.‡주홍빛 보루에 있는 리라스트라자를 만나야 합니다.‡Reúnete con Lirastrasza en el Reducto Bermellón.‡Reúnete con Lirastrasza en el Reducto Bermellón.‡Allez voir Lirastrasza à la Redoute Vermillon.‡去找朱红庇护所的莉拉斯塔萨。‡到朱紅壁壘與麗菈史卓莎碰面。',
  }
},
[27487] = {
  {
    'Ix\'lar, o Infralorde‡Икс\'лар Владыка Подземелий‡Ix\'lar der Unterfürst‡지하군주 익스라‡Ix\'lar el Infraseñor‡Ix\'lar el Infraseñor‡Ix\'lar, le Seigneur-du-dessous‡冥界领主埃克斯拉尔‡地底領主伊克斯拉爾',
    nil,
    'Mate Ix\'lar, o Infralorde, e 10 lacaios dele.‡Убейте Икс\'лара Владыку Подземелий и 10 его приспешников.‡Tötet Ix\'lar den Unterfürsten und 10 seiner Diener.‡지하군주 익스라와 그의 하수인 10명을 처치해야 합니다.‡Mata a Ix\'lar el Infraseñor y a 10 de sus esbirros.‡Mata a Ix\'lar el Infraseñor y a 10 de sus esbirros.‡Tuez Ix\'lar le Seigneur-du-dessous et 10 de ses serviteurs.‡击败冥界领主埃克斯拉尔和他的10个爪牙。‡殺死地底領主伊克斯拉爾和它的10個爪牙。',
  }
},
[27488] = {
  {
    'Impaciência‡Нетерпение‡Ungeduld‡조급함‡Impaciencia‡Impaciencia‡Impatience‡急躁‡沒耐性',
    nil,
    'Procure por Gidwin Fitáurea no Vilarejo do Norte.‡Найдите Гидвина Златокоса в Северном Доле.‡Sucht nach Gidwin Goldzopf in Nordtal.‡노스데일에서 기드윈 골드브레이즈를 찾아야 합니다.‡Busca a Gidwin Trenzadorada en Vallenorte.‡Busca a Gidwin Trenzadorada en Vallenorte.‡Cherchez Gidwin Nattes-d’Or à Valnord.‡在北谷里寻找吉德文·金须。‡在北谷找到基德溫·金辮。',
  }
},
[27489] = {
  {
    'A culpa é minha e de mais ninguém‡Это моя вина‡Ich allein bin schuld‡원망할 사람은 하나 뿐‡La culpa es toda mía‡La culpa es toda mía‡Nul autre que moi n\'est à blâmer‡全都怪我‡責無旁貸',
    nil,
    'Embarque na Caravana da Fiona e siga para a Torre do Passo Norte.‡Присоединяйтесь к каравану Фионы и отправляйтесь в башню Северного перевала.‡Steigt in Fionas Karawanenwagen und fahrt zum Nordpassturm.‡피오나의 짐마차를 타고 북부관문 경비탑으로 가야 합니다.‡Monta en la caravana de Fiona y conduce hasta la Torre del Paso del Norte.‡Monta en la caravana de Fiona y conduce hasta la Torre del Paso del Norte.‡Montez dans la Caravane de Fiona et voyagez jusqu\'à la Tour du Col du Nord.‡跳上菲奥拉的马车，前往北地哨塔。‡進入菲歐娜的馬車然後前往北地哨塔。',
  }
},
[27490] = {
  {
    'Aviso aos viajantes‡Высадка ШРУ‡Den SI:7 absetzen‡SI:7 호위‡Llevar al IV:7‡Llevar al IV:7‡Largage pour le SI:7‡空降军情七处‡護送軍情七處',
    nil,
    'Consiga um esquadrão de Desordeiros Martelo Feroz com Angus Montecalmo e escolte-os até o local de desembarque no Portão do Crepúsculo.‡Попросите грифонов Громового Молота у Ангуса Тихой Горы и сопроводите агентов ШРУ к точке высадки у Сумеречных врат.‡Holt bei Angus Stillberg eine Truppe der Wildhammervandalen ab und begleitet sie zum Landepunkt am Schattentor.‡앵거스 스틸마운틴과 이야기해 와일드해머 무법자 편대를 만난 뒤, 황혼 관문 안의 낙하지점까지 호위해야 합니다.‡Consigue un escuadrón de heliones Martillo Salvaje de Angus Sierrafirme y luego escóltalo hasta el punto de aterrizaje en la Puerta Crepuscular.‡Consigue un escuadrón de heliones Martillo Salvaje de Angus Sierrafirme y luego escóltalo hasta el punto de aterrizaje en la Puerta Crepuscular.‡Allez voir Angus Mont-placide pour qu\'il vous assigne une escouade d\'Hellions marteaux-hardis et escortez-les jusqu\'au point de largage, à la Porte du Crépuscule.‡从安古斯·巍山那里接收一支蛮锤恶徒小队，护送他们前往暮光之门里的空降点。‡從安古斯·靜山那裡領得一支蠻錘惡徒小隊，然後護送他們到達暮光之門的目的地。',
  }
},
[27491] = {
  {
    'Quem quer Kor\'kron?‡Высадка кор\'кронов‡Die Kor\'kron absetzen‡코르크론 호위‡Llevar a los Kor\'kron‡Llevar a los Kor\'kron‡Largage de Kor\'krons‡空降库卡隆‡護送柯爾克隆',
    nil,
    'Consiga um esquadrilha de Mantícoras Cachamorras com Zep\'apuddo e escolte-a até o local de desembarque no Portão do Crepúsculo.‡Возьмите у Джона-Джона Холодца отряд ветрокрылов Тукмака и сопроводите их к точке высадки на Сумеречных вратах.‡Holt bei Jon-Jon Glibberhals eine Truppe der Schmetterschlagwindreiter ab und begleitet sie zum Landepunkt am Schattentor.‡존존 젤리넥과 이야기해 박살의 땅 와이번 편대를 만난 뒤, 황혼 관문 안의 낙하지점까지 호위해야 합니다.‡Consigue un escuadrón de jinetes del viento Machacolpe de Jon-Jon Cuellodúctil y luego escóltalo hasta el punto de aterrizaje en la Puerta Crepuscular.‡Consigue un escuadrón de jinetes del viento Machacolpe de Jon-Jon Cuellodúctil y luego escóltalo hasta el punto de aterrizaje en la Puerta Crepuscular.‡Allez voir Jon-Jon Cou-en-coton pour qu\'il vous assigne une escouade de Coursiers du vent de Frakass et escortez-les jusqu\'au point de largage, à la Porte du Crépuscule.‡从乔乔·黏脖那里接收一支碎击驭风者小队，护送他们前往暮光之门里的空降点。‡從喬喬·膠頸那裡領得一支碎擊之地雙足飛龍小隊，然後護送他們到達暮光之門的目的地。',
  }
},
[27492] = {
  {
    'Sobre ogros e gorjalas‡Огры и эттины‡Oger und Ettins‡오우거와 거인‡Ogros y ettins‡Ogros y ettins‡Des ogres et des ettins‡食人魔和双头魔‡巨魔與雙頭巨人',
    nil,
    'Mate 10 Ogros ou Gorjalas no Portão do Crepúsculo.‡Убейте 10 огров или эттинов у Сумеречных врат.‡Tötet 10 Oger oder Ettins am Schattentor.‡황혼 관문에서 오우거나 거인을 10마리 처치해야 합니다.‡Mata a 10 ogros o ettins en la Puerta Crepuscular.‡Mata a 10 ogros o ettins en la Puerta Crepuscular.‡Tuez 10 Ogres ou Ettins à la Porte du Crépuscule.‡在暮光之门杀死10个食人魔和双头魔。‡在暮光之門殺死10個巨魔或雙頭巨人。',
  }
},
[27493] = {
  {
    'Sobre ogros e gorjalas‡Огры и эттины‡Oger und Ettins‡오우거와 거인‡Ogros y ettins‡Ogros y ettins‡Des ogres et des ettins‡食人魔和双头魔‡巨魔與雙頭巨人',
    nil,
    'Mate 10 Ogros do clã Olho de Sangue ou Gorjalas no Portão do Crepúsculo.‡Убейте 10 огров или эттинов из клана Кровавого Глаза у Сумеречных врат.‡Tötet 10 Oger oder Ettins des Blutaugenklans am Schattentor.‡황혼 관문에서 붉은눈 오우거나 거인을 10마리 처치해야 합니다.‡Mata a 10 ogros del clan Ojosangre o ettins en la Puerta Crepuscular.‡Mata a 10 ogros del clan Ojosangre o ettins en la Puerta Crepuscular.‡Tuez 10 Ogres ou Ettins du clan Œil-sanglant à la Porte du Crépuscule.‡在暮光之门杀死10个食人魔和双头魔。‡在暮光之門殺死10個血眼部族巨魔或雙頭巨人。',
  }
},
[27494] = {
  {
    'A fé move o Montanha‡Двигая горы‡Berge versetzen‡태산을 움직여라‡Mueve la Montaña‡Mueve la Montaña‡Une montagne à déplacer‡移山‡移山',
    nil,
    'Detone os Explosivos Escondidos para atrair Britacrânios, o Montanha, para longe do Portão do Crepúsculo.‡Взорвите спрятанную взрывчатку, чтобы выманить Дробителя Черепов Горобраза из Сумеречных врат.‡Zündet die versteckten Sprengsätze, um Schädelberster den Berg vom Schattentor wegzulocken.‡숨겨진 폭발물을 터트려 태산 해골분쇄자를 황혼 관문에서 꾀어내야 합니다.‡Detona los explosivos ocultos para atraer a Trituracráneos la Montaña y alejarlo de la Puerta Crepuscular.‡Detona los explosivos ocultos para atraer a Trituracráneos la Montaña y alejarlo de la Puerta Crepuscular.‡Faites sauter les Explosifs dissimulés pour attirer Brise-tête la Montagne loin de la Porte du Crépuscule.‡引爆隐藏的炸药，将碎颅者魔山从暮光之门引开。‡引爆隱蔽的爆裂物來引誘『高山』碎顱者離開城塞大門。',
  }
},
[27495] = {
  {
    'A fé move o Montanha‡Двигая горы‡Berge versetzen‡태산을 움직여라‡Mueve la Montaña‡Mueve la Montaña‡Une montagne à déplacer‡移山‡移山',
    nil,
    'Detone os Explosivos Escondidos para atrair Britacrânios, o Montanha, para longe do Portão do Crepúsculo.‡Взорвите спрятанную взрывчатку, чтобы выманить Дробителя Черепов Горобраза из Сумеречных врат.‡Zündet die versteckten Sprengsätze, um Schädelberster den Berg vom Schattentor wegzulocken.‡숨겨진 폭발물을 터트려 태산 해골분쇄자를 황혼 관문에서 꾀어내야 합니다.‡Detona los explosivos ocultos para atraer a Trituracráneos la Montaña y alejarlo de la Puerta Crepuscular.‡Detona los explosivos ocultos para atraer a Trituracráneos la Montaña y alejarlo de la Puerta Crepuscular.‡Faites sauter les Explosifs dissimulés pour attirer Brise-tête la Montagne loin de la Porte du Crépuscule.‡引爆隐藏的炸药，将碎颅者魔山从暮光之门引开。‡引爆隱蔽的爆裂物來引誘『高山』碎顱者離開城塞大門。',
  }
},
[27496] = {
  {
    'Sinal de alerta‡Работа для артиллеристов‡Holt die Artillerie!‡포격 신호 보내기‡Que venga la artillería‡Que venga la artillería‡L\'artillerie à la rescousse‡呼叫炮火‡呼叫砲擊火焰',
    nil,
    'Use o Sinalizador de Artilharia para mirar os edifícios ao norte, nordeste, sudoeste e sul do Portão do Crepúsculo.‡С помощью артиллерийской сигнальной ракеты отметьте северное, северо-восточное, юго-западное и южное здание Сумеречных врат.‡Benutzt die Artillerieleuchtpistole, um das nördliche, das nordöstliche, das südwestliche und das südliche Gebäude am Schattentor als Ziel zu markieren.‡포수 신호탄을 사용해 황혼 관문 북쪽, 북동쪽, 남서쪽, 남쪽 건물을 표시해야 합니다.‡Usa la bengala de artillería para señalar los edificios Norte, Noreste, Suroeste y Sur de la Puerta Crepuscular.‡Usa la bengala de artillería para señalar los edificios Norte, Noreste, Suroeste y Sur de la Puerta Crepuscular.‡Utilisez la Fusée d\'artillerie pour indiquer la position des bâtiments nord, nord-est, sud-ouest et sud de la Porte du Crépuscule.‡在暮光之门里使用炮火信号弹标记北部、东北部、西南部和南部的建筑物。‡使用砲擊導引信號將暮光之門內的北部、東北部、西南部和南部建築設置為目標。',
  }
},
[27497] = {
  {
    'Sinal de alerta‡Работа для артиллеристов‡Holt die Artillerie!‡포격 신호 보내기‡Que venga la artillería‡Que venga la artillería‡L\'artillerie à la rescousse‡呼叫炮火‡呼叫砲擊火焰',
    nil,
    'Use o Sinalizador de Artilharia para mirar os edifícios ao norte, nordeste, sudoeste e sul do Portão do Crepúsculo.‡С помощью артиллерийской сигнальной ракеты отметьте северное, северо-восточное, юго-западное и южное здание Сумеречных врат.‡Benutzt die Artillerieleuchtpistole, um das nördliche, das nordöstliche, das südwestliche und das südliche Gebäude beim Schattentor als Ziel zu markieren.‡포수 신호탄을 사용해 황혼 관문 북쪽, 북동쪽, 남서쪽, 남쪽 건물을 표시해야 합니다.‡Usa la bengala de artillería para señalar los edificios Norte, Noreste, Suroeste y Sur de la Puerta Crepuscular.‡Usa la bengala de artillería para señalar los edificios Norte, Noreste, Suroeste y Sur de la Puerta Crepuscular.‡Utilisez la Fusée d\'artillerie pour indiquer la position des bâtiments nord, nord-est, sud-ouest et sud de la Porte du Crépuscule.‡在暮光之门里使用炮火信号弹标记南部、西南部、东北部和东部的建筑物。‡使用砲擊導引信號將城塞大門的北部、東北部、西南部和南部建築設置為目標。',
  }
},
[27498] = {
  {
    'O sinal para o ataque‡Сигнал к атаке‡Befehlt den Angriff‡공격 신호 보내기‡Haz la señal para atacar‡Haz la señal para atacar‡Le signal de l\'assaut‡发出攻击信号‡攻擊信號',
    nil,
    'Use o Sinalizador de Ataque no topo de uma das torres no Portão do Crepúsculo.‡Подайте сигнал к атаке с вершины одной из башен Сумеречных врат.‡Benutzt das Angriffssignal auf einem der Türme beim Schattentor.‡황혼 관문에 있는 탑 중 하나에 올라가 공격 신호를 보내야 합니다.‡Usa la señal de ataque desde lo alto de una de las torres en la Puerta Crepuscular.‡Usa la señal de ataque desde lo alto de una de las torres en la Puerta Crepuscular.‡Utilisez le Signal d\'attaque du sommet de l\'une des tours de la Porte du Crépuscule.‡到暮光之门中的某座哨塔顶部去，发出攻击信号。‡在暮光之門其中一座塔的頂端使用攻擊信號。',
  }
},
[27499] = {
  {
    'O sinal para o ataque‡Сигнал к атаке‡Befehlt den Angriff‡공격 신호 보내기‡Haz la señal para atacar‡Haz la señal para atacar‡Le signal de l\'assaut‡发出攻击信号‡攻擊信號',
    nil,
    'Use o Sinalizador de Ataque no topo de uma das torres no Portão do Crepúsculo.‡Подайте сигнал к атаке с вершины одной из башен Сумеречных врат.‡Benutzt das Angriffssignal auf einem der Türme beim Schattentor.‡황혼 관문에 있는 탑 중 하나에 올라가 공격 신호를 보내야 합니다.‡Usa la señal de ataque desde lo alto de una de las torres en la Puerta Crepuscular.‡Usa la señal de ataque desde lo alto de una de las torres en la Puerta Crepuscular.‡Utilisez le Signal d\'attaque du sommet de l\'une des tours de la Porte du Crépuscule.‡到暮光之门中的某座哨塔顶部去，发出攻击信号。‡在暮光之門其中一座塔的頂端使用攻擊信號。',
  }
},
[27500] = {
  {
    'Quatro cabeças e um funeral‡Без головы хорошо, а с четырьмя – лучше‡Vier Köpfe sind besser als keiner‡더러워도 없는 것보단 낫다‡Cuatro cabezas es mejor que ninguna‡Cuatro cabezas es mejor que ninguna‡Quatre têtes valent mieux qu\'aucune‡四个总比没有好‡四顆腦袋總比沒有好',
    nil,
    'Colete as quatro cabeças de Za\'brox  e Beeble\'phod.‡Добудьте четыре головы За\'брокса и Библи\'фода.‡Sammelt die vier Köpfe von Za\'brox und Beeble\'phod.‡자브록스와 비블포드의 머리카락 네 타래를 모아야 합니다.‡Consigue las cuatro cabezas de Za\'brox y Beeble\'phod.‡Consigue las cuatro cabezas de Za\'brox y Beeble\'phod.‡Tranchez les quatre têtes de Za\'brox et de Beeble\'phod et récupérez-les.‡收集扎布鲁克斯和毕布伏德的四枚徽记。‡收集札布羅克斯和嗶啵馮德的四顆頭。',
  }
},
[27501] = {
  {
    'Quatro cabeças e um funeral‡Без головы хорошо, а с четырьмя – лучше‡Vier Köpfe sind besser als keiner‡더러워도 없는 것보단 낫다‡Cuatro cabezas es mejor que ninguna‡Cuatro cabezas es mejor que ninguna‡Quatre têtes valent mieux qu\'aucune‡四个总比没有好‡四顆腦袋總比沒有好',
    nil,
    'Colete as quatro cabeças de Za\'brox  e Beeble\'phod.‡Добудьте четыре головы За\'брокса и Библи\'фода.‡Sammelt die vier Köpfe von Za\'brox und Beeble\'phod.‡자브록스와 비블포드의 머리카락 네 타래를 모아야 합니다.‡Consigue las cuatro cabezas de Za\'brox y Beeble\'phod.‡Consigue las cuatro cabezas de Za\'brox y Beeble\'phod.‡Tranchez les quatre têtes de Za\'brox et de Beeble\'phod et récupérez-les.‡收集扎布鲁克斯和毕布伏德的四枚徽记。‡收集札布羅克斯和嗶啵馮德的四顆頭。',
  }
},
[27502] = {
  {
    'A caminho da Cidadela‡Штурм крепости‡Hinauf zur Zitadelle‡성채 꼭대기로‡Hacia la ciudadela‡Hacia la ciudadela‡À la citadelle !‡前往暮光堡垒‡城塞之上',
    nil,
    'Fale com o Comandante do Esquadrão AVIN e escolte a tropa.‡Поговорите с командиром отряда ШРУ, а затем сопровождайте отряд ШРУ.‡Sprecht mit dem Truppenkommandanten des SI:7 und begleitet dann die Truppe des SI:7.‡SI:7 분대 지휘관과 대화해 SI:7 분대를 호위해야 합니다.‡Habla con el comandante de escuadrón del IV:7 y luego escolta al escuadrón del IV:7.‡Habla con el comandante de escuadrón de la IV:7 y luego escolta al escuadrón de la IV:7.‡Allez voir le Commandant d\'escouade du SI:7, puis escortez l\'escouade du SI:7.‡跟军情七处战队指挥官谈一谈，然后护送军情七处战队。‡和軍情七處小隊指揮官談話，然後護送軍情七處小隊。',
  }
},
[27503] = {
  {
    'A caminho da Cidadela‡Штурм крепости‡Hinauf zur Zitadelle‡성채 꼭대기로‡Hacia la ciudadela‡Hacia la ciudadela‡À la citadelle !‡前往暮光堡垒‡城塞之上',
    nil,
    'Fale com o Comandante do Esquadrão Kor\'kron e escolte o esquadrão.‡Поговорите с кор\'кронским командиром взвода, а затем сопровождайте отряд кор\'кронов.‡Sprecht mit dem Truppenkommandanten der Kor\'kron und begleitet dann die Truppe der Kor\'kron.‡코르크론 분대 지휘관과 대화해 코르크론 분대를 호위해야 합니다.‡Habla con el comandante de escuadrón Kor\'kron y luego escolta al escuadrón Kor\'kron.‡Habla con el comandante de escuadrón Kor\'kron y luego escolta al escuadrón Kor\'kron.‡Allez voir le Commandant d\'escouade kor\'kron, puis escortez l\'escouade de Kor\'krons.‡跟库卡隆战队指挥官谈一谈，然后护送库卡隆战队。‡和柯爾克隆小隊指揮官談話，然後護送柯爾克隆小隊。',
  }
},
[27504] = {
  {
    'Os dragões também sangram‡Драконам тоже больно‡Sogar Drachen bluten‡용들도 피를 흘린다‡Hasta los dragones sangran‡Hasta los dragones sangran‡Même les dragons saignent‡止住巨龙之血‡即使是龍也會流血',
    nil,
    'Fale com Velastrasza no Rubro Reduto.‡Отправляйтесь на Гранатовый редут и поговорите с Веластразой.‡Sprecht mit Velastrasza im Zinnoberrefugium.‡주홍빛 보루에 있는 벨라스트라자와 대화해야 합니다.‡Habla con Velastrasza en el interior del Reducto Bermellón.‡Habla con Velastrasza en el interior del Reducto Bermellón.‡Allez voir Velastrasza à la Redoute Vermillon.‡跟朱红庇护所的瓦莱斯塔萨谈一谈。‡到朱紅壁壘裡去和維菈史卓莎交談。',
  }
},
[27505] = {
  {
    'Reparos dragônicos‡Исцеление драконов‡Heilung auf Drachenart‡용혈족의 치료‡Curar dragones‡Curar dragones‡L\'infirmerie des dragons‡治疗龙伤‡治療龍人',
    nil,
    'Salvaguarde 5 Reparadores Rubros enquanto cuidam dos dragões feridos.‡Охраняйте 5 гранатовых целителей, пока они лечат раненых драконов.‡Beschützt 5 zinnoberrote Heiler, während sie verwundete Drachen heilen.‡부상당한 용을 치료하는 주홍빛 치유사 5마리를 보호해야 합니다.‡Protege a 5 ensalmadores Bermellón mientras sanan dragones heridos.‡Protege a 5 ensalmadores Bermellón mientras sanan dragones heridos.‡Protégez 5 Soigneurs de Vermillon pendant qu\'ils s\'occupent des dragons blessés.‡保护5名治疗受伤巨龙的朱红治疗者。‡在5個朱紅治癒者治療受傷的龍時，保護他們。',
  }
},
[27506] = {
  {
    'Vida após a morte‡Круговорот жизни и смерти‡Leben aus dem Tod‡죽음과 새로운 생명‡Vida de la muerte‡Vida de la muerte‡La vie après la mort‡起死回生‡死亡中的新生',
    nil,
    'Plante Sementes Rubi nos corpos de 6 draconianos no Rubro Reduto.‡Посадите рубиновые семена в тела 6 драконов на Гранатовом редуте.‡Pflanzt Rubinsamen in die Leichname von 6 Drachkin im Zinnoberrefugium.‡주홍빛 보루에서 용족의 시체 6개에 루비 씨앗을 심어야 합니다.‡Planta semillas de rubí en los cadáveres de 6 dragonantes en el Reducto Bermellón.‡Planta semillas de rubí en los cadáveres de 6 dragonantes en el Reducto Bermellón.‡Plantez des Graines de rubis près des cadavres de 6 Draconiens à la Redoute Vermillon.‡将红宝石之种种在朱红庇护所的6具龙族尸体上。‡在朱紅壁壘中將晶紅種子種在6具龍的屍體上。',
  }
},
[27507] = {
  {
    'Transgressores do Crepúsculo‡Сумерки сгущаются‡Die Ausbreitung des Zwielichts‡밀려오는 황혼‡Crepúsculo invasor‡Crepúsculo invasor‡L\'approche du crépuscule‡入侵的暮光‡侵略暮光',
    nil,
    'Mate 12 Invasores do Crepúsculo no Rubro Reduto.‡Убейте 12 сумеречных драконов – захватчиков на Гранатовом редуте.‡Tötet 12 Zwielichteindringlinge im Zinnoberrefugium.‡주홍빛 보루에서 황혼의 용족 12마리를 처치해야 합니다.‡Mata a 12 invasores Crepusculares en el Reducto Bermellón.‡Mata a 12 invasores Crepusculares en el Reducto Bermellón.‡Tuez 12 Envahisseurs du Crépuscule à la Redoute Vermillon.‡在朱红庇护所杀死12名暮光入侵者。‡到朱紅壁壘裡去殺死12個暮光入侵者。',
  }
},
[27508] = {
  {
    'Longe do ninho‡Далеко от гнезда‡Weit weg vom Nest‡둥지를 떠난 알‡Lejos del nido‡Lejos del nido‡Loin du nid‡远离巢穴‡遠離巢穴',
    nil,
    'Recupere 6 Ovos Vermelhos.‡Соберите 6 гранатовых яиц.‡Holt 6 Zinnobereier zurück.‡주홍빛 알 6개를 되찾아야 합니다.‡Recupera 6 huevos Bermellón.‡Recupera 6 huevos Bermellón.‡Récupérez 6 Œufs de Vermillon.‡拿回6枚朱红之卵。‡找回6顆朱紅龍蛋。',
  }
},
[27509] = {
  {
    'Falha de defesa‡Брешь в обороне‡Verteidigungslücke‡방어선에 생긴 틈‡Brecha en las defensas‡Una brecha en las defensas‡Une brèche dans les défenses‡防线上的突破口‡防禦的缺口',
    nil,
    'Encontre a origem do Martelo do Crepúsculo no Rubro Reduto e destrua-a.‡Выясните, как Сумеречный Молот проник на Гранатовый редут, и уничтожьте проход.‡Findet die Quelle des Schattenhammers im Zinnoberrefugium und vernichtet sie.‡황혼의 망치단이 주홍빛 보루 침입에 이용한 수단을 찾아 파괴해야 합니다.‡Encuentra la causa de la presencia del Martillo Crepuscular en el Reducto Bermellón y destrúyela.‡Encuentra la causa de la presencia del Martillo Crepuscular en el Reducto Bermellón y destrúyela.‡Trouvez la source de la présence du Marteau du crépuscule à l\'intérieur de la Redoute Vermillon et détruisez-la.‡找到朱红庇护所里暮光之锤的入口，将其摧毁。‡到朱紅壁壘中找出暮光之錘入侵的地點，並摧毀它。',
  }
},
[27510] = {
  {
    'Lobo em pele de urso‡Волк в медвежьей шкуре‡Ein Wolf im Bärenpelz‡곰의 탈을 쓴 늑대‡Un lobo con piel de oso‡Un lobo con piel de oso‡Des loups, des ours et... des phoques‡披着熊皮的狼‡披著熊皮的狼',
    nil,
    'Mate 10 Ursos Inconspícuos.‡Убейте 10 подозрительных медведей.‡Tötet 10 unauffällige Bären.‡눈에 띄지 않는 곰 10마리를 처치해야 합니다.‡Mata a 10 falsos osos.‡Mata a 10 falsos osos.‡Tuez 10 Ours discrets.‡杀死10头低调的熊。‡殺死10隻不起眼的熊。',
  }
},
[27511] = {
  {
    'A emoção da descoberta‡Дрожь предвкушения‡Spannende Entdeckungen‡발견의 기쁨‡La emoción del descubrimiento‡La emoción del descubrimiento‡Le frisson de la découverte‡发现的快感‡發現的興奮',
    nil,
    'Explore a Câmara das Estrelas.‡Исследуйте Зал Звезд.‡Erforscht die Kammer der Sterne.‡별의 방을 조사해야 합니다.‡Explora la Cámara de las Estrellas.‡Explora la Cámara de las Estrellas.‡Explorez la Chambre des Étoiles.‡探索群星之厅。‡哈里遜‧瓊斯希望你搜索眾星之間。',
  }
},
[27512] = {
  {
    'Guerrilha transdimensional: Capítulo I‡Война между измерениями: Глава I‡Dimensionsübergreifender Krieg: Kapitel I‡차원 전쟁: 1장‡Guerra transdimensional: Capítulo I‡Guerra transdimensional: Capítulo I‡Le raid transdimensionnel : première phase‡超次元战争：第一章‡超次元之戰:第一章',
    nil,
    'Encontre o Portal Dimensional de Lenhâmbar.‡Разыщите портал в другое измерение в Янтарной мельнице.‡Findet das Dimensionsportal von Mühlenbern.‡호박색 농장 공간 차원문을 찾아야 합니다.‡Encuentra el portal dimensional de Molino de Ámbar.‡Encuentra el portal dimensional de Molino de Ámbar.‡Trouvez le Portail dimensionnel de Moulin-de-l’Ambre.‡找到安伯米尔次元传送门。‡找出安伯米爾的次元傳送門。',
  }
},
[27513] = {
  {
    'Guerrilha transdimensional: Capítulo II‡Война Миров: Глава II‡Dimensionsübergreifender Krieg: Kapitel II‡차원 전쟁: 2장‡Guerra transdimensional: Capítulo II‡Guerra transdimensional: Capítulo II‡Le raid transdimensionnel : deuxième phase‡超次元战争：第二章‡超次元之戰:第二章',
    nil,
    'Mate 20 magos de Lenhâmbar.‡Уничтожьте 20 магов Янтарной мельницы.‡Tötet 20 Magier von Mühlenbern.‡호박색 농장 마법사 20명을 처치해야 합니다.‡Mata a 20 magos de Molino de Ámbar.‡Mata a 20 magos de Molino de Ámbar.‡Tuez 20 Mages de Moulin-de-l’Ambre.‡杀死20名安伯米尔法师。‡殺死20名安伯米爾法師。',
  }
},
[27514] = {
  {
    'Cai cai, anão!‡Птица подбита! Птица подбита!‡Vogel am Boden! Vogel am Boden!‡새가 떨어졌다! 새가 떨어졌다!‡¡Pájaro caído! ¡Pájaro caído!‡¡Pájaro caído! ¡Pájaro caído!‡Griffon à terre ! Griffon à terre !‡狮鹫坠落！狮鹫坠落！‡飛鳥失事!',
    nil,
    'Localize Thordun Golpemalho, um cavalga-grifo dos Martelo Feroz caído na Costa do Crepúsculo, que fica no Planalto do Crepúsculo.‡Найдите Тордуна Размаха Топора, сбитого всадника на грифоне Громового Молота, на Сумеречном берегу, что на Сумеречном нагорье.‡Findet den abgestürzten Greifenreiter der Wildhämmer Thordun Hammerschlag am Zwielichtufer im Schattenhochland.‡황혼의 고원의 황혼 해안에서 추락한 와일드해머 그리핀 기수, 토르둔 해머블로를 찾아야 합니다.‡Encuentra a Thordun Golpemartillo, un jinete de grifos Martillo Salvaje derribado, en las Orillas Crepusculares, en las Tierras Altas Crepusculares.‡Encuentra a Thordun Golpemartillo, un jinete de grifos Martillo Salvaje derribado, en las Orillas Crepusculares, en las Tierras Altas Crepusculares.‡Localisez Thordun Coup-de-Marteau, un chevaucheur de griffon Marteau-hardi blessé au Rivage du Crépuscule, dans les Hautes-terres du Crépuscule.‡在暮光高地的暮光海滩上寻找坠地的蛮锤狮鹫骑士索尔顿·锤击。‡到暮光高地的暮光海岸尋找被擊落的蠻錘獅鷲獸騎士，索爾登·錘擊。',
  }
},
[27515] = {
  {
    'Raízes profundas‡Корешки ей помогут‡Die Wurzel alles Guten‡뿌리가 필요해‡La raíces la curarán‡La raíces la curarán‡En quête de racines‡臭根的价值‡有根就夠了',
    nil,
    'Pegue 8 Raízes Espinhacas na Costa do Crepúsculo.‡Соберите 8 шипастых смердокорней на Сумеречном берегу.‡Sammelt 8 Stück dorniger Stinkwurz am Zwielichtufer.‡황혼 해안에서 가시 악취뿌리 8개를 모아야 합니다.‡Reúne 8 pesteraíces espinosas de las Orillas Crepusculares.‡Reúne 8 pesteraíces espinosas de las Orillas Crepusculares.‡Arrachez 8 Racines de fétidelle épineuse au Rivage du Crépuscule.‡在暮光海滩收集8条带刺的臭根。‡到暮光海岸收集8個帶刺臭根。',
  }
},
[27516] = {
  {
    'Voar, voar... subir, subir...‡Крылья над Высоким берегом‡Auf Schwingen nach Hochstade‡훨훨 날아 높은 둑까지‡Alas sobre Bancalto‡Alas sobre Bancalto‡Des griffons dans le ciel de Hauterive‡飞向滩头堡‡高岸之翼',
    nil,
    'Fale com Thordun Golpemalho e voe de volta para Beiralta.‡Поговорите с Тордуном Размахом Топора и полетите вместе с ним на Высокий берег.‡Sprecht mit Thordun Hammerschlag und fliegt gemeinsam nach Hochstade!‡토르둔 해머블로와 대화해 높은 둑까지 함께 날아가야 합니다.‡Habla con Thordun Golpemartillo y volad juntos de vuelta a Bancalto.‡Habla con Thordun Golpemartillo y volad juntos de vuelta a Bancalto.‡Parlez à Thordun Coup-de-Marteau et revenez avec lui à Hauterive à dos de griffon.‡跟索尔顿·锤击谈一谈，跟他一起飞回滩头堡。‡和索爾登‧錘擊說話並一起飛回高岸堡。',
  }
},
[27517] = {
  {
    'Prepare-se‡Будь готов ко всему‡Seid vorbereitet‡준비가 필요해‡Prepárate‡Prepárate‡Une mission dans vos cordes‡做好准备‡準備好',
    nil,
    'Colete 6 Pedaços de Corda.‡Соберите 6 обрывков веревки.‡Sammelt 6 Stücke Seil.‡밧줄 조각 6개를 모아야 합니다.‡Reúne 6 trozos de cuerda.‡Reúne 6 trozos de cuerda.‡Récupérez 6 Bouts de corde.‡收集6根断绳。‡收集六段繩索。',
  }
},
[27518] = {
  {
    'Guerrilha transdimensional: Capítulo III‡Война Миров: Глава III‡Dimensionsübergreifender Krieg: Kapitel III‡차원 전쟁: 3장‡Guerra transdimensional: Capítulo III‡Guerra transdimensional: Capítulo III‡Le raid transdimensionnel : troisième phase‡超次元战争：第三章‡超次元之戰:第三章',
    nil,
    'Sobrecarregue o Arquimago Ataeric com poder arcano para derrubar o Escudo Transdimensional.‡Обрушьте поток тайной магии на верховного мага Атэрика, чтобы сокрушить межпространственный щит.‡Überladet Erzmagier Ataeric mit arkaner Macht, um den transdimensionalen Schild auszuschalten.‡대마법사 아태릭을 과도한 비전 마력에 노출시켜 차원의 방패를 파괴해야 합니다.‡Sobrecarga al archimago Ataeric con poder Arcano para destruir el escudo transdimensional.‡Sobrecarga al archimago Ataeric con poder Arcano para destruir el escudo transdimensional.‡Submergez l’Archimage Ataeric de puissance arcanique pour détruire le Bouclier transdimensionnel.‡用奥术力量让大法师阿塔瑞克过载，消除超次元魔法盾。‡讓大法師阿塔瑞克負載過大的秘法能量，以解除超次元護盾。',
  }
},
[27519] = {
  {
    'Sob as areias sufocantes‡Под зыбучими песками‡Unter dem erstickenden Sand‡숨 막히는 모래 아래‡Bajo arenas asfixiantes‡Bajo arenas asfixiantes‡Sous le sable exactement‡在窒息的沙子下‡窒人之沙',
    nil,
    'Resgate 8 Sobreviventes de Orsis.‡Спасите 8 выживших горожан Орсиса.‡Rettet 8 Überlebende von Orsis.‡오르시스 생존자 8명을 구출해야 합니다.‡Rescata a 8 supervivientes de Orsis.‡Rescata a 8 supervivientes de Orsis.‡Sauvez 8 Survivants d\'Orsis.‡营救8名奥西斯幸存者‡拯救8個奧爾希斯生還者。',
  }
},
[27520] = {
  {
    'Lacaios de Al\'Akir‡Слуги Ал\'акира‡Al\'Akirs Diener‡알아키르의 후예‡Esbirros de Al\'Akir‡Esbirros de Al\'Akir‡Les sbires d\'Al\'Akir‡奥拉基尔的爪牙‡奧拉基爾的爪牙',
    nil,
    'Mate 6 Rebentos de Al\'Akir.‡Убейте 6 потомков Ал\'акира.‡Tötet 6 Abkömmlinge von Al\'Akir.‡알아키르의 후예 6명을 처치해야 합니다.‡Mata a 6 sucesores de Al\'Akir.‡Mata a 6 sucesores de Al\'Akir.‡Tuez 6 Scions d\'Al\'Akir.‡杀死6个奥拉基尔的子嗣。‡消滅6個奧拉基爾的爪牙。',
  }
},
[27521] = {
  {
    'Colmeia ignóbil de escória e vilania‡Проклятое гнездо мерзавцев и негодяев‡Elender Hort des Abschaums und der Boshaftigkeit‡쓰레기와 악당의 비참한 둥지‡Desdichada colmena de escoria y villanía‡Desdichada colmena de escoria y villanía‡Le terrible repaire de la vermine et de la vilenie‡邪恶之巢‡鄙惡者巢穴',
    nil,
    'Mate 9 Ignóbeis no Abrigo Quel\'Lithien, que fica nas Terras Pestilentas Orientais.‡Убейте 9 презренных в сторожке Кель\'Литиен в Восточных Чумных землях.‡Tötet 9 Getriebene nahe der Jagdhütte von Quel\'Lithien in den Östlichen Pestländern.‡동부 역병지대의 쿠엘리시엔 오두막에서 타락자 9명을 처치해야 합니다.‡Mata a 9 desdichados en el Refugio Quel\'lithien en las Tierras de la Peste del Este.‡Mata a 9 desdichados en el Refugio Quel\'lithien en las Tierras de la Peste del Este.‡Tuez 9 Déshérités au Gîte de Quel\'lithien, dans les Maleterres de l\'Est.‡在东瘟疫之地的奎尔林斯小屋杀死9名失心者。‡在東瘟疫之地的奎爾林斯小屋殺死9個鄙惡者。',
  }
},
[27522] = {
  {
    'Faça eles falarem‡Выбей из них дурь‡Prügelstrafe‡극단적인 심문 방법‡Sácaselo a golpes‡Sácaselo a golpes‡Leur faire lâcher le morceau‡不打不成招‡給他們點教訓',
    nil,
    'Espanque ao menos 6 Engenheiros de Cerco do Flagelo para descobrir detalhes a respeito da localização do Gidwin e do captor dele.‡Избейте не менее 6 инженеров Плети, чтобы выяснить, кто похитил Гидвина и где он сейчас находится.‡Schlagt mindestens 6 Belagerungsingenieure der Geißel nieder, um an Informationen über Gidwins Verbleib und seinen Entführer zu gelangen.‡스컬지 공성 기술병을 적어도 6명 이상 혼쭐을 내주고 기드윈의 위치와 기드윈을 잡아간 자에 대한 정보를 알아내야 합니다.‡Golpea al menos a 6 ingenieros de asedio de la Plaga para averiguar detalles del paradero de Gidwin y su captor.‡Golpea al menos a 6 ingenieros de asedio de la Plaga para averiguar detalles del paradero de Gidwin y su captor.‡Tabassez au moins 6 Ingénieurs de machines de siège du Fléau pour obtenir des informations sur la position de Gidwin et son ravisseur.‡殴打至少6名天灾攻城技师，找出吉德文的下落，并搞清楚是谁抓了他。‡打敗6名天譴攻城工程師以獲得基德溫的所在地，以及挾持他的人。',
  }
},
[27523] = {
  {
    'Ah, Quiroscuro, como vos odeio...‡Проклятый Тенекрыл‡Dämmerschwinge, oh, wie ich Euch hasse...‡혐오스러운 그늘날개‡Alaocaso, cómo te odio...‡Alaocaso, cómo te odio...‡Crépuscaile, oh comme je te hais !‡天杀的暗翼蝠‡暗翼蝠，我多麼痛恨你',
    nil,
    'Obtenha um Tufo de Pele de Quiroscuro.‡Добудьте полоску меха Тенекрыла.‡Beschafft einen Fellflicken von Dämmerschwinge.‡그늘날개 모피 조각을 입수해야 합니다.‡Consigue un parche de pelaje de Alaocaso.‡Consigue un parche de pelaje de Alaocaso.‡Récupérez une Touffe de fourrure de Crépuscaile.‡获取一块暗翼蝠的毛皮。‡取得暗翼蝠的毛皮。',
  }
},
[27524] = {
  {
    'Fúria cega‡Слепая ярость‡Blinde Wut‡맹목적인 분노‡Furia ciega‡Furia ciega‡Furie aveugle‡盲目的愤怒‡盲目的憤怒',
    nil,
    'Encontre Tarenar Golpessol dentro do Bosque Pestilento, que fica nas Terras Pestilentas Orientais.‡Найдите Таренара Удар Солнца в Чумном лесу в Восточных Чумных землях.‡Findet Tarenar Sonnenhieb im Pestwald in den Östlichen Pestländern.‡동부 역병지대의 역병숲 안에서 타레나 선스트라이크를 찾아야 합니다.‡Encuentra a Tarenar Golpe Solar en el interior del Bosque de la Peste en las Tierras de la Peste del Este.‡Encuentra a Tarenar Golpe Solar en el interior del Bosque de la Peste en las Tierras de la Peste del Este.‡Trouvez Tarenar Frappesoleil dans Pestebois, dans les Maleterres de l\'Est.‡在东瘟疫之地的病木林中找到塔伦纳·射日者。‡在東瘟疫之地的病木林內找到塔瑞納爾·日擊。',
  }
},
[27525] = {
  {
    'Guardiões de Stratholme‡Стражи Стратхольма‡Wächter von Stratholme‡스트라솔름의 수호자‡Guardianes de Stratholme‡Guardianes de Stratholme‡Les gardiens de Stratholme‡斯坦索姆的守护者‡斯坦索姆守護者',
    nil,
    'Mate Omasum Casco Podre e Karthis Umbruniel.‡Убейте Омасума Гнилое Копыто и Картиса Темную Руну.‡Tötet Omasum Pesthuf und Karthis Dunkelrune.‡오마줌 블라이트후프와 카티스 다크룬을 처치해야 합니다.‡Mata a Omasum Pezuñainfecta y a Karthis Runaoscura.‡Mata a Omasum Pezuñainfecta y a Karthis Runaoscura.‡Tuez Omasum Sabot-de-Chancre et Karthis Sombrerune.‡杀死奥玛苏·凋蹄和卡尔西斯·暗符。‡殺死歐瑪桑‧荒蹄和卡爾力斯‧暗符。',
  }
},
[27526] = {
  {
    'Revelação do destino do Gidwin‡Судьба Гидвина‡Gidwins Schicksal enthüllt‡기드윈의 운명‡El destino de Gidwin desvelado‡El destino de Gidwin desvelado‡La découverte du sort de Gidwin‡营救吉德文‡基德溫的命運揭示',
    nil,
    'Procure Gidwin Fitáurea dentro do matadouro no centro do Bosque Pestilento.‡Найдите Гидвина Златокоса в здании бойни в центральной части Чумного леса.‡Sucht nach Gidwin Goldzopf im Schlachthaus im Zentrum des Pestwalds.‡역병숲 중심의 도살장 안에서 기드윈 골드브레이즈를 찾아야 합니다.‡Busca a Gidwin Trenzadorada en el interior del matadero en el centro del Bosque de la Peste.‡Busca a Gidwin Trenzadorada en el interior del matadero en el centro del Bosque de la Peste.‡Cherchez Gidwin Nattes-d’Or dans l\'Abattoir, au centre de Pestebois.‡在病木林中心的屠宰房中寻找吉德文·金须的踪迹。‡在病木林中央的屠宰房內找到基德溫·金辮。',
  }
},
[27527] = {
  {
    'O fim da jornada‡Конец пути‡Ende der Reise‡여행의 끝‡El final del viaje‡El final del viaje‡La fin du voyage‡旅途的终点‡旅途之末',
    nil,
    'Fale com a Fiona na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Поговорите с Фионой в часовне Последней Надежды в Восточных Чумных землях.‡Sprecht mit Fiona an der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대 희망의 빛 예배당에서 피오나와 대화해야 합니다.‡Habla con Fiona en la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este.‡Habla con Fiona en la Capilla de la Esperanza de la Luz en las Tierras de la Peste del Este.‡Parlez à Fiona à la Chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'Est.‡与东瘟疫之地圣光之愿礼拜堂的菲奥拉交谈。‡到東瘟疫之地的聖光之願禮拜堂和菲歐娜談談。',
  }
},
[27528] = {
  {
    'Massa Flagelada‡Жуткая масса‡Geißelmasse‡스컬지 덩어리‡Masa apestada‡Masa apestada‡Masse flaellée‡天灾之躯‡天譴之眾',
    nil,
    'Mate 8 Golens Socados e então, use a Tocha do Cruzado nos corpos deles.‡Убейте 8 перегруженных големов, а затем подожгите их факелом рыцаря.‡Tötet 8 überladene Golems und steckt ihre Kadaver mit der Fackel des Kreuzfahrers in Brand.‡속이 꽉 찬 골렘 8마리를 처치한 후, 그 시체에 성전사의 횃불을 사용해야 합니다.‡Mata a 8 gólems embutidos, luego usa la antorcha de cruzado con sus cuerpos.‡Mata a 8 gólems embutidos, luego usa la antorcha de cruzado con sus cuerpos.‡Tuez 8 Golems surdéveloppés, puis utilisez la Torche de Croisé sur leur cadavres.‡杀死8个肥胖的傀儡，然后对它们的尸体使用十字军的火把。‡殺死8個塞滿的魔像，然後用十字軍的火炬點燃他們的屍體。',
  }
},
[27529] = {
  {
    'Defensores da Vila das Flechas‡Защитники Дарроушира‡Verteidiger von Darroheim‡다로우골의 병사들‡Los defensores de Villa Darrow‡Los defensores de Villa Darrow‡Les défenseurs de Comté-de-Darrow‡达隆郡的守卫者‡達隆郡的防衛者',
    nil,
    'Liberte 8 Espíritos da Vila das Flechas dos corpos de Carniçais Canibais e, então, fale com eles.‡Освободите 8 духов Дарроушира из тел каннибалов-вурдалаков, а затем поговорите с ними.‡Befreit 8 Darroheimgeister aus den Körpern der Menschenfresserghule und sprecht mit ihnen.‡식인 구울의 시체에서 다로우골 영혼 8명을 해방시키고, 그 영혼과 대화해야 합니다.‡Libera a 8 espíritus de Villa Darrow de los cuerpos de necrófagos caníbales y después habla con ellos.‡Libera a 8 espíritus de Villa Darrow de los cuerpos de necrófagos caníbales y después habla con ellos.‡Libérez 8 Esprits de Comté-de-Darrow captifs dans les corps des goules cannibales, puis parlez-leur.‡从吃人的食尸鬼的尸体上释放8名达隆郡居民的灵魂，然后同他们交谈。‡從吃人的食屍鬼的屍體中拯救8個達隆郡居民的靈魂，然後和他們談談。',
  }
},
[27530] = {
  {
    'As bestas de carne‡Трупозвери‡Die Kadaverbestien‡시체 괴물‡Las bestias cadáver‡Las bestias cadáver‡Les bêtes-cadavres‡血肉巨兽‡屍獸',
    nil,
    'Destrua os cascos de três Bestas de Carne colocando três ou mais Fontes de Luz Argênteas perto delas. Você não pode criar Fontes de Luz Argênteas em combate e você não pode colocá-las a menos de dez metros uma da outra.‡Уничтожьте тела трех трупозверей, поставив рядом с ними три или более серебряных оберегов колодца Света. Обереги нельзя ставить во время боя, а расстояние между ними должно быть не менее десяти ярдов.‡Zerstört die Hüllen dreier Kadaverbestien, indem Ihr drei oder mehr Argentumlichtbrunnen neben ihnen platziert. Ihr könnt die Argentumlichtbrunnen nicht im Kampf platzieren und nicht weniger als zehn Meter voneinander entfernt.‡세 개 이상의 은빛 빛샘을 시체 괴물 옆에 설치하여 세 괴물의 몸통을 파괴해야 합니다. 전투 중에는 빛샘을 설치할 수 없으며, 각 빛샘의 거리는 10미터 이상 떨어져야 합니다.‡Destruye la masa de tres bestias cadáver colocando tres o más pozos de Luz Argenta cerca de ellas. No puedes colocar pozos de Luz mientras estás en combate, y no puedes colocarlos a menos de diez metros uno de otro.‡Destruye la masa de tres bestias cadáver colocando tres o más pozos de Luz Argenta cerca de ellas. No puedes colocar pozos de Luz mientras estás en combate, y no puedes colocarlos a menos de diez metros uno de otro.‡Détruisez les carcasses de 3 Bêtes-cadavres en plaçant au moins 3 Puits de lumière d\'Argent près d\'eux. Vous ne pouvez pas placer de Puits de lumière d\'Argent en combattant et vous ne pouvez pas les placer à moins de 10 mètres les uns des autres.‡将三枚银色光明之泉咒符放在血肉巨兽身边，摧毁它们的躯体。你无法在战斗中放置银色光明之泉咒符，它们之间相互间隔也不得小于十码。‡在巨大的3個屍獸旁置放3個或更多的銀白光束泉來將其摧毀。你無法在戰鬥中啟動銀白光束泉，在十碼以內不能置放兩個以上的光束泉。',
  }
},
[27531] = {
  {
    'Pesquisa contra a peste‡Борьба с чумой‡Seuchenabwehrforschung‡역병 차단을 위한 연구‡Investigación contra la peste‡Investigación contra la peste‡Le contre-agent de la peste‡反瘟疫研究‡反瘟疫研究',
    nil,
    'Obtenha 20 Frutapodres, 5 Braços Decepados e 1 pilha de Raspas do Pé do Gigante de Carne.‡Соберите 20 ягод гниленики, 5 бестелесных рук и 1 кучу струганных пяток мясистого великана.‡Beschafft 20 Faulbeeren, 5 abgetrennte Arme und 1 Stapel Fußabschabung eines Fleischgiganten.‡썩은딸기 20개, 분리된 팔 5개, 살덩이 거인 발 각질 더미 1개를 입수해야 합니다.‡Consigue 20 bayas podridas, 5 brazos incorpóreos y 1 montón de sobras de pie de gigante de carne.‡Consigue 20 bayas podridas, 5 brazos incorpóreos y 1 montón de sobras de pie de gigante de carne.‡Récupérez 20 Pourrielles, 5 Bras désincarnés et 1 tas de Raclures de pied de géant de chair.‡收集20颗腐莓、5条脱离躯体的手臂，以及1堆血肉巨人的足屑。‡取得20顆腐莓、5個沒有實體的手臂以及1堆血肉巨人腳皮屑。',
  }
},
[27532] = {
  {
    'Torre do Bosque Pestilento‡Башня Чумного леса‡Der Pestwaldturm‡역병숲 경비탑‡La Torre del Bosque de la Peste‡La Torre del Bosque de la Peste‡La tour de Pestebois‡病木林哨塔‡病木林哨塔',
    nil,
    'Leve o Pacote do Sinalto ao Boticário Argênteo Judkins na Torre do Bosque Pestilento, que fica nas Terras Pestilentas Orientais.‡Отнесите посылку Аргуса Путеводного аптекарю Юдкинсу в башню Чумного леса в Восточных Чумных землях.‡Bringt Leuchtfeuers Paket zu Erzapotheker Judkins beim Pestwaldturm in den Östlichen Pestländern.‡동부 역병지대 역병숲 경비탑에 있는 은빛 연금술사 저드킨스에게 하이비컨의 꾸러미를 가져가야 합니다.‡Llévale el paquete de Altofaro al Boticario Argenta Judkins a la Torre del Bosque de la Peste en las Tierras de la Peste del Este.‡Llévale el paquete de Altofaro al Boticario Argenta Judkins a la Torre del Bosque de la Peste en las Tierras de la Peste del Este.‡Apportez le Paquet de Nobleguide à l\'Apothicaire d\'Argent Judkins à la Tour de Pestebois, dans les Maleterres de l\'Est.‡将海毕肯的包裹交给东瘟疫之地病木林哨塔的银色药剂师杰德金斯。‡到東瘟疫之地的病木林哨塔將海畢肯的包裏送給銀白藥劑師朱德金斯。',
  }
},
[27533] = {
  {
    'Uma sina pior do que o matadouro‡Хуже, чем попасть на прилавок к мяснику‡Ein Schicksal schlimmer als der Schlachter‡도살장보다 끔찍한 운명‡Un destino peor que la matanza‡Un destino peor que la matanza‡Un sort pire que l\'abattoir‡猪的悲惨命运‡比屠殺更慘的命運',
    nil,
    'Mate 9 Suínos Pestilentos.‡Убейте 9 чумных кабанов.‡Tötet 9 verseuchte Schweine.‡역병 걸린 멧돼지 9마리를 처치해야 합니다.‡Mata a 9 puercos apestados.‡Mata a 9 puercos apestados.‡Tuez 9 Pourceaux pestiférés.‡杀死9只天灾野猪。‡殺死9隻染疫野豬。',
  }
},
[27534] = {
  {
    'Livro-caixa do Augustus‡Книга рецептов Августа‡Augustus\' Quittungsbuch‡아우구스투스의 회계장부‡Libro de entradas de Augustus‡Libro de entradas de Augustus‡Le livre de compte d\'Augustus‡奥古斯图斯的收据册‡奧古斯圖斯的帳本',
    nil,
    'Pegue o Livro-caixa do Augustus da estalagem na Várzea do Medo.‡Найдите книгу рецептов Августа Помешанного в таверне в Долине Ужаса.‡Beschafft Euch Augustus\' Quittungsbuch aus dem Gasthaus im Schreckenstal.‡테러데일 여관에서 아우구스투스의 회계장부를 입수해야 합니다.‡Coge el libro de entradas de Augustus en la posada de Valle del Terror.‡Coge el libro de entradas de Augustus en la posada de Valle del Terror.‡Trouvez le Livre de compte d\'Augustus à l\'Auberge, au Val-terreur.‡在恐惧谷的旅店里找到奥古斯图斯的收据册。‡到恐懼谷的旅館拿取奧古斯圖斯的帳本。',
  }
},
[27535] = {
  {
    'Só uns parafusos a menos‡Совсем чуть-чуть порчи‡Ein bisschen meschugge‡아주 약간 정신이 나간 사람‡Solo un poco agraciado‡Solo un poco agraciado‡Juste un peu dérangé‡受到一点小小的感动‡只是有點瘋癲',
    nil,
    'Fale com Augustus, o Pirado, na Várzea do Medo.‡Идите в Долину Ужаса и поговорите с Августом Помешанным.‡Sprecht mit Augustus dem Meschuggenen im Schreckenstal.‡테러데일의 정신나간 아우구스투스와 대화해야 합니다.‡Habla con Augustus el Agraciado en el Valle del Terror.‡Habla con Augustus el Agraciado en el Valle del Terror.‡Parlez à Augustus le Touché, à Val-Terreur.‡跟恐惧谷被感动的奥古斯图斯谈一谈。‡到恐懼谷和奧古斯圖斯談談。',
  }
},
[27536] = {
  {
    'Praticamente inofensiva‡Абсолютно безопасно‡Größtenteils harmlos‡거의 안전한...‡Prácticamente inofensivas‡Prácticamente inofensivas‡Globalement inoffensif‡基本无害‡大多無害',
    nil,
    'Colete 8 Minas Terrestres Desarmadas na Penumbra das Mágoas, a leste do Brejo do Goblin.‡Соберите 8 незаряженных наземных мин в Горемраке к востоку от Веслотопи.‡Sammelt 8 entschärfte Landminen im Sorgendunkel östlich von Kraulsumpf.‡수렁진흙탕의 동쪽에 있는 슬픔의 그늘에서 해제한 지뢰 8개를 모아야 합니다.‡Recoge 8 minas terrestres desarmadas de las Tinieblas de las Penas al este de Chapaleos.‡Recoge 8 minas terrestres desarmadas de las Tinieblas de las Penas al este de Chapaleos.‡Récupérez 8 Mines désamorcées à Noirchagrin, à l\'est de Brasse-Tourbe.‡从沼桨镇东边的忧伤湿地找到8个被偷走的地雷。‡在沼槳東方的憂傷濕地收集8個未啟動的地雷。',
  }
},
[27537] = {
  {
    'Fecha-se um portal, abrem-se outros‡Любой портал в Шторм‡Wer Elementare sät, wird Sturm ernten‡궁여지책‡Cualquier portal en medio de la tormenta‡Cualquier portal en medio de la tormenta‡Un portail dans la tempête‡风暴中的传送门‡暴風中的傳送門',
    nil,
    'Mate Elementais de Água Turva para coletar 5 Núcleos do Redemoinho.‡Убивайте илистых элементалей воды, пока не соберете 5 сердцевин водоворота.‡Tötet matschige Wasserelementare, um 5 Strudelkerne zu sammeln.‡진흙 묻은 물의 정령을 처치하고 기포 핵 5개를 구해야 합니다.‡Mata a elementales de agua embarrados para coger 5 núcleos de tolvanera.‡Mata a elementales de agua embarrados para coger 5 núcleos de tolvanera.‡Tuez des Élémentaires d\'eau boueux pour récupérer 5 Cœurs du tourbillon.‡杀死泥浆水元素，收集5个漩涡之核。‡殺死泥濘水元素取得5個渦流核。',
  }
},
[27538] = {
  {
    'O cataplasma perfeito‡Идеальная припарка‡Der perfekte Verband‡완벽한 깁스 재료‡La cataplasma perfecta‡La cataplasma perfecta‡Le meilleur des cataplasmes‡完美的泥敷剂‡完美藥膏',
    nil,
    'Colete 10 porções de Lama do Rio Verrall.‡Соберите 10 порций ила из Вералла.‡Sammelt 10 Haufen Verrallschlamm.‡베랄 강 진흙 10덩이를 모아야 합니다.‡Recoge 10 montones de mugre del Río Verrall.‡Recoge 10 montones de mugre del Río Verrall.‡Allez chercher 10 tas de Boue de la Verralle.‡收集10堆瓦拉尔河淤泥。‡收集10堆維羅河的污泥。',
  }
},
[27539] = {
  {
    'Adicione-os à pilha‡Бросай их в кучу!‡Werft sie auf den Haufen‡해골 수집가‡Añádelas al montón‡Añádelas al montón‡Rajoutez-les sur la pile‡把它们堆起来‡丟進顱骨堆',
    nil,
    'Obtenha 16 Caveiras Fedorentas de Magos Amaldiçoados e Soldados do Flagelo no Bosque Pestilento.‡Идите в Чумной лес и добудьте 16 вонючих черепов, убивая проклятых магов и солдат Плети.‡Beschafft 16 stinkende Schädel von verfluchten Magiern und Soldaten der Geißel im Pestwald.‡역병숲에서 저주받은 마법사와 스컬지 병사를 처치하고 냄새나는 해골 16개를 입수해야 합니다.‡Consigue 16 calaveras apestosas de magos malditos y soldados de la Plaga en el Bosque de la Peste.‡Consigue 16 calaveras apestosas de magos malditos y soldados de la Plaga en el Bosque de la Peste.‡Récupérez 16 Crânes puants de Mages maudits et de Soldats du Fléau à Pestebois.‡从病木林的诅咒法师和天灾士兵身上收集16件破烂的装备。‡在病木林內從被詛咒的法師和天譴士兵身上收集16個惡臭顱骨。',
  }
},
[27540] = {
  {
    '‡Громовой Молот‡Die Wildhämmer‡와일드해머‡Los Martillo Salvaje‡‡Les Marteaux-hardis‡蛮锤萨满祭司‡',
    nil,
    '‡Поговорите с Гаваном Серым Пером в крепости Штормграда.‡Sprecht mit Gavan Graufeder auf Burg Sturmwind.‡스톰윈드 왕궁에 있는 가반 그레이페더와 대화해야 합니다.‡Habla con Gavan Plumagrís en el Castillo de Ventormenta.‡‡Allez voir Gavan Grise-Plume au Donjon de Hurlevent.‡跟暴风要塞的加文·灰羽谈一谈。‡',
  }
},
[27541] = {
  {
    'Lições do passado‡Благоразумный подход‡Lektionen der Vergangenheit‡과거의 교훈‡Lecciones del pasado‡Lecciones del pasado‡Les leçons du passé‡前车之鉴‡學習過去',
    nil,
    'Obtenha os Óculos Quebrados.‡Найдите разбитые очки.‡Erhaltet die zerbrochene Brille.‡부서진 안경을 획득해야 합니다.‡Coge las gafas rotas.‡Coge las gafas rotas.‡Prenez les Lunettes cassées.‡获得6个损坏的护目镜。‡從舒諾茲海員偵查兵身上取得壞掉的眼鏡。',
  }
},
[27542] = {
  {
    'Conquistando a frente de batalha‡Контрудар‡An die Front‡최후의 진군‡Tomando el frente‡Tomando el frente‡Sur le front‡上前线‡奪取戰線',
    nil,
    nil,
  }
},
[27543] = {
  {
    '[TEMP PH] What We Have Done‡[TEMP PH] What We Have Done‡Was wir getan haben‡[임시] 우리가 이룩한 일‡[TEMP PH] Lo que hemos hecho‡[TEMP PH] Lo que hemos hecho‡Ce que nous avons accompli‡[TEMP PH] What We Have Done‡[TEMP PH] What We Have Done',
    nil,
    nil,
  }
},
[27544] = {
  {
    'Tenacidade cenariana‡Упрямые друиды‡Cenarische Hartnäckigkeit‡불굴의 세나리온‡La tenacidad Cenarion‡La tenacidad Cenarion‡La ténacité cénarienne‡塞纳里奥议会的坚持‡堅毅的塞納里奧議會',
    nil,
    'Fale com Rayne próxima da entrada do Vale Fungi.‡Поговорите с Райн в начале Грибной долины.‡Sprecht mit Rayne nahe des Eingangs zum Fungustal.‡곰팡이 계곡 입구 근처에 있는 레인과 대화해야 합니다.‡Habla con Rayne cerca de la entrada de la Cuenca Fungal.‡Habla con Rayne cerca de la entrada de la Cuenca Fungal.‡Parlez à Rayne près de l\'entrée de la Vallée des Fongus.‡与蘑菇谷入口附近的莱茵谈谈。‡到蘑菇谷的入口處附近與瑞恩交談。',
  }
},
[27545] = {
  {
    'O caminho está livre‡Путь открыт‡Der Weg ist geöffnet‡길이 열렸다‡El camino está libre‡El camino está libre‡La voie est libre‡通道‡道路敞開',
    nil,
    'Fale com Kurdran Martelo Feroz em Beiralta, que fica no Planalto do Crepúsculo.‡Поговорите с Курдраном Громовым Молотом на Высоком берегу на Сумеречном нагорье.‡Sprecht mit Kurdran Wildhammer in Hochstade im Schattenhochland.‡황혼의 고원의 높은 둑에 있는 쿠르드란 와일드해머와 대화해야 합니다.‡Habla con Kurdran Martillo Salvaje en Bancalto, en las Tierras Altas Crepusculares.‡Habla con Kurdran Martillo Salvaje en Bancalto, en las Tierras Altas Crepusculares.‡Allez voir Kurdran Marteau-Hardi à Hauterive, dans les Hautes-terres du Crépuscule.‡跟暮光高地滩头堡的库德兰·蛮锤谈一谈。‡到暮光高地的高岸堡找庫德蘭‧蠻錘說話。',
  }
},
[27546] = {
  {
    'Fale com o Capitão Nascimento‡Поговорить с капитаном Антоном‡Sprecht mit Hauptmann Anton‡안톤 대장과 대화‡Habla con el capitán Anton‡Habla con el capitán Anton‡L’entretien avec le capitaine Anton‡跟安顿上尉交谈‡和安東上尉談話',
    nil,
    'Fale com o Capitão Nascimento na Bastilha Ventobravo.‡Поговорите с капитаном Антоном в крепости Штормграда.‡Sprecht mit Hauptmann Anton in Burg Sturmwind.‡스톰윈드 왕궁에 있는 대장 안톤과 대화해야 합니다.‡Habla con el capitán Anton en el Castillo de Ventormenta.‡Habla con el capitán Anton en el Castillo de Ventormenta.‡Allez voir le Capitaine Anton au Donjon de Hurlevent.‡跟暴风要塞的安顿上尉谈一谈。‡到暴風要塞和安東上尉談話。',
  }
},
[27547] = {
  {
    'Uma missão sem importância‡Пустяки‡Folgenlos‡하찮은 임무‡Sin importancia‡Sin importancia‡Un incident mineur‡无关紧要‡無足輕重',
    nil,
    'Resgate 8 Soldados Covardes.‡Спасите 8 дрожащих бойцов.‡Rettet 8 kauernde Soldaten.‡겁먹은 병사 8명을 구출해야 합니다.‡Rescata a 8 soldados asustados.‡Rescata a 8 soldados asustados.‡Secourez 8 Troupiers tremblants.‡营救8名畏缩的步兵。‡救出8名畏縮的裝甲兵。',
  }
},
[27548] = {
  {
    'Lições de medo‡Урок страха‡Lehrstunden in Angst‡무시무시한 교훈‡Lecciones sobre el miedo‡Lecciones sobre el miedo‡Une leçon de terreur‡领略恐惧‡恐懼的課程',
    nil,
    'Mate 12 Batedores da 7ª Legião‡Убейте 12 разведчиков 7-го легиона.‡Tötet 12 Späher der 7. Legion.‡7군단 정찰병 12명을 처치해야 합니다.‡Mata a 12 exploradores de la Séptima Legión.‡Mata a 12 exploradores de la Séptima Legión.‡Tuez 12 Éclaireurs de la 7e Légion.‡杀死12名第七军团斥候。‡殺死12名第七軍團斥侯。',
  }
},
[27549] = {
  {
    'Pela luz das estrelas‡Звездный свет‡Bei Sternenlicht‡별빛을 바라보며‡Por la luz de las estrellas‡Por la luz de las estrellas‡Un peu plus près des étoiles‡在星光下‡在眾星散發光芒時',
    nil,
    'Colete 7 Luzes Estelares Suspensas.‡Соберите 7 порций взвеси звездного света.‡Sammelt 7 schwebende Sternenlichter.‡떠 있는 별빛 7개를 모아야 합니다.‡Reúne 7 luces estelares suspendidas.‡Reúne 7 luces estelares suspendidas.‡Récupérez 7 Lumières stellaires suspendues.‡收集7份悬浮星光。‡在眾星之間裡收集7個懸浮星光。',
  }
},
[27550] = {
  {
    'A queda de Lenhardente‡Гибель Погребальных Костров‡Lohenscheits Fall‡장작나무 마을의 몰락‡La caída de Piroleña‡La caída de Piroleña‡La chute de Bois-du-Bûcher‡焚木的焚毁‡焚木村的傾頹',
    nil,
    'Use o Feixe de Tochas para queimar a Prefeitura de Lenhardente, a Taberna de Lenhardente e a Capela de Lenhardente.‡Используйте охапку факелов, чтобы поджечь ратушу, таверну и часовню Погребальных Костров.‡Benutzt das Bündel Fackeln, um das Rathaus von Lohenscheit, das Gasthaus von Lohenscheit und die Kapelle von Lohenscheit niederzubrennen.‡횃불 다발을 사용하여 장작나무 마을회관과 장작나무 여관, 장작나무 예배당을 불태워야 합니다.‡Usa el haz de antorchas para prender fuego al concejo Piroleña, a la posada Piroleña y a la capilla Piroleña.‡Usa el haz de antorchas para prender fuego al concejo Piroleña, a la posada Piroleña y a la capilla Piroleña.‡Utilisez le Paquet de torches pour incendier l’Hôtel de ville, l’Auberge et la Chapelle de Bois-du-Bûcher.‡使用火把点燃焚木城镇大厅、焚木旅店以及焚木礼拜堂。‡使用一捆火炬來點燃焚木市政廳、焚木旅店以及焚木禮拜堂。',
  }
},
[27551] = {
