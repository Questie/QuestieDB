[33110] = {
  {
    'O usurpador‡Узурпатор‡‡‡‡‡‡‡',
    nil,
    'Reivindique sua recompensa por depor Garrosh Grito Infernal do cargo de Chefe Guerreiro da Horda. Uma‡Получите свою награду за свержение Гарроша Адского Крика, бывшего вождя Орды.‡‡‡‡‡‡‡',
  }
},
