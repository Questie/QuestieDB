  }
},
[905] = {
  {
    'No covil dos raptores‡В логово ящера‡In die Höhle des Raptors‡랩터 둥지로‡En la guarida del raptor‡En la guarida del raptor‡Dans l\'antre du raptor‡在迅猛龙的巢穴里‡進入迅猛龍圍欄',
    nil,
    'Mate raptores Helióscamo e colete suas penas. Use as penas em 3 Ninhos de Helióscamo.‡Поохотьтесь на яркочешуйчатых ящеров и соберите с них перья. Положите их в 3 гнезда яркочешуйчатых ящеров.‡Tötet Sonnenschuppenraptoren und nehmt ihre Federn mit. Benutzt die Federn bei den drei Sonnenschuppennestern.‡해비늘랩터를 처치해 깃털을 모은 후 해비늘랩터 둥지 3곳에 깃털을 올려놓아야 합니다.‡Mata a raptores Solescama y recoge sus plumas. Usa estas plumas en los 3 nidos de Solescama.‡Mata a raptores Solescama y recoge sus plumas. Después usa las plumas en los 3 nidos de Solescama.‡Tuez des Raptors solécailles et récupérez leurs plumes. Déposez-les dans les 3 Nids de Solécaille.‡杀死赤鳞迅猛龙，收集它们的羽毛。在3处赤鳞之巢上使用羽毛。‡殺死日鱗迅猛龍並收集牠們的羽毛。把這些羽毛放在3個日鱗巢穴裡。',
  }
},
[906] = {
  {
    'Traição intestina‡Предатель в наших рядах‡Verräter in den eigenen Reihen‡내부의 배반자‡Traidores‡Traidores‡Une trahison de l\'intérieur‡内奸‡內奸',
    nil,
    'Leve o Crânio de Lok para Thork na Encruzilhada, que fica nos Sertões.‡Отнесите череп Лока Тхорку на Перекресток.‡Bringt Loks Schädel zu Thork beim Wegekreuz im Brachland.‡불모의 땅, 십자로에 있는 톨크에게 로크의 해골을 가져가야 합니다.‡Llévale la calavera de Lok a Thork en El Cruce, en Los Baldíos.‡Llévale la calavera de Lok a Thork en El Cruce, en Los Baldíos.‡Apporter le Crâne de Lok à Thork à la Croisée des Tarides.‡把洛克·奥克班恩的徽记交给十字路口的索克。‡把洛克·奧克班恩的顱骨交給十字路口的索克。',
  }
},
[907] = {
  {
    'Lagartos trovejantes enfurecidos‡Разъяренные рокочущие ящерицы‡Wütende Donnerechsen‡분노한 천둥도마뱀‡Los truenagartos iracundos‡Los truenagartos iracundos‡Les lézards-tonnerre enragés‡被激怒的雷霆蜥蜴‡被激怒的雷霆蜥蜴',
    nil,
    'Leve 3 unidades de Sangue de Lagarto Trovejante para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отнесите 3 порции крови рокочущей ящерицы Джорну Искателю Неба в Лагерь Таурахо.‡Bringt das Blut von 3 Donnerechsen ins Camp Taurajo zu Jorn Himmelsdeuter.‡천둥도마뱀 피 3개를 모아 타우라조 야영지에 있는 조른 스카이시어에게 가져가야 합니다.‡Llévale 3 unidades de sangre de truenagarto a Jorn Vidente del Cielo en el Campamento Taurajo.‡Llévale 3 unidades de sangre de truenagarto a Jorn Vidente del Cielo en el Campamento Taurajo.‡Apporter 3 doses de Sang de lézard-tonnerre à Jorn Oeil-des-cieux, au Camp Taurajo.‡收集3瓶雷霆蜥蜴的血液，把它们交给陶拉祖营地的乔恩·星眼。‡收集3瓶雷霆蜥蜴的血液，把它們交給陶拉祖營地的喬恩·星眼。',
  }
},
[908] = {
  {
    '‡Среди руин‡Inmitten der Ruinen‡폐허 사이로‡Entre ruinas‡Entre ruinas‡Parmi les ruines‡废墟之间‡',
    nil,
    '‡Принесите глубинный сердечник Дже\'неу Санкри в форт Зорам\'гар в Ясеневый лес.‡Bringt den Tiefenkern zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 심연의 핵을 가져가야 합니다.‡Llévale el núcleo de las profundidades a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el núcleo de las profundidades a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apportez le Noyau de la Brasse à Je\'neu Sancrea, à l\'Avant-poste de Zoram\'gar, en Orneval.‡把深渊之核交给灰谷佐拉姆加前哨站里的耶努萨克雷。‡',
  }
},
[909] = {
  {
    '‡Барон Акванис‡‡군주 아쿠아니스‡‡‡‡阿奎尼斯男爵‡阿奎尼斯男爵',
    nil,
    '‡Принесите странную водяную сферу Дже\'неу Санкри в форт Зорам\'гар в Ясеневом лесу.‡Bringt die seltsame Wasserkugel zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡‡Llévale el extraño globo de agua a Je\'neu Sancrea en las Cavernas de Brazanegra.‡Llévale el extraño globo de agua a Je\'neu Sancrea en las Cavernas de Brazanegra.‡Apportez le Globe d\'eau étrange à Je\'neu Sancrea, dans les Profondeurs de Brassenoire.‡把奇怪的水球交给灰谷佐拉姆加前哨站的耶努萨克雷。‡',
  }
},
[910] = {
  {
    'Lá nas docas‡В порту‡Unten an den Docks‡바다가 보고파요‡Un paseo por los embarcaderos‡Un paseo por los embarcaderos‡Un tour sur les quais‡降帆靠港‡降帆靠港',
    nil,
    'Leve seu protegido às docas da Vila Catraca, que fica nos Sertões.‡Отведите своего подопечного в порт Кабестана в Степях.‡Bringt Euren Schützling zu den Docks von Ratschet im Brachland.‡돌보고 있는 고아를 불모의 땅에 있는 톱니항까지 데려가야 합니다.‡Lleva a tu pupilo a los embarcaderos de Trinquete en Los Baldíos.‡Lleva a tu pupilo a los embarcaderos de Trinquete en Los Baldíos.‡Emmenez votre protégé sur les quais de Cabestan, dans les Tarides.‡带着你看护的孤儿去贫瘠之地的棘齿城码头。‡帶著你看護的孤兒去貧瘠之地的棘齒城碼頭。',
  }
},
[911] = {
  {
    'O portal da fronteira‡Врата пограничья‡Das Tor zur Grenze‡최전선으로 가는 관문‡El acceso a la frontera‡El acceso a la frontera‡L\'accès vers la frontière‡前线之门‡前線之門',
    nil,
    'Leve seu protegido até a Paliçada Mor\'shan, que fica ao norte dos Sertões, um pouco antes da entrada do Vale Gris.‡Отведите своего подопечного к Заставе Мор\'шан в северной части Степей на границе с Ясеневым лесом.‡Begleitet Euren Schützling zum Schutzwall von Mor\'shan im nördlichen Teil des Brachlands, kurz bevor man das Eschental betritt.‡북부 불모의 땅에서 잿빛 골짜기로 들어가기 직전에 있는 몰샨의 망루까지 돌보고 있는 고아를 데려가야 합니다.‡Lleva a tu pupilo a La Empalizada de Mor\'shan en la zona norte de Los Baldíos, antes de la entrada a Vallefresno.‡Lleva a tu pupilo a La Empalizada de Mor\'shan en la zona norte de Los Baldíos, antes de la entrada a Vallefresno.‡Emmenez votre protégé au Rempart de Mor\'shan dans la région nord des Tarides, juste à l\'entrée d\'Orneval.‡带着你看护的孤儿去贫瘠之地北部的莫尔杉壁垒，它就在靠近灰谷入口的地方。‡帶著你看護的孤兒去貧瘠之地北部的莫爾杉壁壘，它就在靠近梣谷入口的地方。',
  }
},
[912] = {
  {
    '‡Маска троггов из племени Камнедробов‡Splittersteintroggverkleidung‡‡Disfrazado de trogg Rompecantos‡Disfrazado de trogg Rompecantos‡Le costume de trogg Brisepierre‡‡',
    nil,
    nil,
  }
},
[913] = {
  {
    'O grito do Falcotrom‡Крик грозового змея‡Der Ruf des Donnerfalken‡천둥매의 울음 소리‡El chillido del halcón trueno‡El chillido del halcón trueno‡Le cri du faucon-tonnerre‡雷鹰的嘶鸣‡雷鷹的嘶鳴',
    nil,
    'Encontre e mate um falcotrom, depois leve as asas dele para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отыщите и убейте грозового змея. Принесите его крылья Джорну Заклинателю Небес в Лагерь Таурахо.‡Sucht und erschlagt einen Donnerfalken und bringt Jorn Himmelsdeuter in Camp Taurajo seine Flügel.‡천둥매를 찾아 처치하고 천둥매 날개를 타우라조 야영지에 있는 조른 스카이시어에게 가져가야 합니다.‡Encuentra 1 halcón trueno, mátalo y llévale sus alas a Jorn Vidente del Cielo en el Campamento Taurajo.‡Encuentra 1 halcón trueno, mátalo y llévale sus alas a Jorn Vidente del Cielo en el Campamento Taurajo.‡Trouver et tuer un faucon-tonnerre, et rapporter ses ailes à Jorn Oeil-des-cieux, au Camp Taurajo.‡找到一只雷鹰，杀掉它，然后把它的翅膀交给陶拉祖营地的乔恩·星眼。‡找到一隻雷鷹，殺掉它，然後把它的翅膀交給陶拉祖營地的喬恩·星眼。',
  }
},
[914] = {
  {
    'Líderes da Presa‡Повелители Змей‡Anführer der Giftzähne‡송곳니의 드루이드 우두머리‡Líderes del Colmillo‡Líderes del Colmillo‡Les druides du Croc‡尖牙德鲁伊‡尖牙德魯伊',
    nil,
    'Leve as Gemas de Cobrahn, Sucurina, Pítias e Serpentis para Nara Juba Agreste no Penhasco do Trovão.‡Принесите камни Кобрана, Анакондры, Пифаса и Серпентиса Наре Буйногривой, на Громовой Утес.‡Bringt die Edelsteine von Kobrahn, Anacondra, Pythas und Serpentis nach Donnerfels zu Nara Wildmähne.‡코브란, 아나콘드라, 피타스, 서펜티스의 보석을 모아 썬더 블러프에 있는 나라 와일드메인에게 가져가야 합니다.‡Lleva las gemas de Cobrahn, Anacondra, Pythas y Serpentis a Nara Ferocrín en Cima del Trueno.‡Lleva las gemas de Cobrahn, Anacondra, Pythas y Serpentis a Nara Ferocrín en Cima del Trueno.‡Apportez les Gemmes de Cobrahn, d\'Anacondra, de Pythas et de Serpentis à Nara Crin-Sauvage aux Pitons-du-Tonnerre.‡将考布莱恩宝石、安娜科德拉宝石、皮萨斯宝石和瑟芬迪斯宝石交给雷霆崖的纳拉·蛮鬃。‡將考布萊恩寶石、安娜科德拉寶石、皮薩斯寶石和瑟芬迪斯寶石交給雷霆崖的納拉·蠻鬃。',
  }
},
[915] = {
  {
    '‡Женщинам – цветы, детям – ...‡Lecker Eis‡아이스크림! 아이스크림!‡¡Quiero un heladooooo!‡¡Quiero un heladooooo!‡Je veux une glaaaaace !‡草莓冰激凌‡',
    nil,
    '‡Купите своему подопечному клубничное мороженое. Кажется, мальчик предпочитает мороженое Тигуля и Форора.‡Besorgt für Euren Schützling etwas Erdbeereis. Der Kleine scheint die Marke \'Tigules und Forors Eiscreme\' zu bevorzugen.‡‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Allez chercher de la glace à la fraise pour votre protégé. Le gamin semble préférer la marque de glace Aguilor & Dagharn.‡为你看护的孩子买一些草莓冰激凌。这个孩子似乎最喜欢"提古勒"牌的草莓冰激凌。‡',
  }
},
[916] = {
  {
    'Webwood Corruption‡Оскверненные пауки‡Verderbnis der Waldweber‡타락한 나무그물거미‡Corrupción Tejemadera‡Corrupción Tejemadera‡La corruption des Tissebois‡被腐蚀的蜘蛛‡樹林的腐敗',
    nil,
    'Kill 12 Webwood Spiders.‡[Deprecated] Kill 12 Webwood Spiders.‡Tötet 12 Waldweberspinnen.‡나무그물거미 12마리를 처치해야 합니다.‡Mata 12 arañas Tejemadera.‡Mata 12 arañas Tejemadera.‡Tuez 12 Araignées tissebois.‡杀死12只树林蜘蛛。‡殺死12隻樹林蜘蛛。',
  }
},
[917] = {
  {
    'Ovo de Lenhateia‡Яйцо чащобного тенетника‡Waldweberei‡나무그물거미의 알‡Huevo de Tejemadera‡Huevo de Tejemadera‡L\'œuf d\'araignée Tissebois‡树林蜘蛛的卵‡樹林蜘蛛的卵',
    nil,
    'Retrieve a Webwood Egg.‡Добудьте яйцо чащобного тенетника.‡Erhaltet ein Waldweberei.‡나무그물거미알을 구해야 합니다.‡Consigue un huevo Tejemadera.‡Consigue un huevo Tejemadera.‡Apportez un Œuf d\'araignée Tissebois à Dirania Brillargent, près d\'Aldrassil.‡找到一枚树林蜘蛛的卵。‡取得一顆樹林蜘蛛的卵。',
  }
},
[918] = {
  {
    'Sementes de muscoide‡Саженцы древесника‡Bäumlingssamenkörner‡나무괴물 씨앗‡Semillas de Brezomadera‡Semillas de Brezomadera‡Les graines de sylvain‡林精的种子‡樹精的種子',
    nil,
    'Consiga 6 Sementes de Muscoide.‡Принесите 6 саженцев древесников.‡Erhaltet 6 Bäumlingssamenkörner.‡나무괴물 씨앗 6개를 모아야 합니다.‡Recoge 6 semillas de Brezomadera.‡Recoge 6 semillas de Brezomadera.‡Récoltez 6 Graines de sylvain.‡收集6粒林精的种子。‡取得6顆樹精的種子。',
  }
},
[919] = {
  {
    'Brotos de muscoide‡Ростки древесника‡Bäumlingssprosse‡나무괴물 씨눈‡Brotes de Brezomadera‡Brotes de Brezomadera‡Les pousses de sylvain‡林精的新芽‡樹精的新芽',
    nil,
    'Colete 10 Brotos de Muscoide.‡Принесите 10 ростков древесника.‡Sammelt 10 Bäumlingssprosse.‡나무괴물 씨눈 10개를 모아야 합니다.‡Reúne 10 brotes de Brezomadera.‡Reúne 10 brotes de Brezomadera.‡Collectez 10 Pousses de sylvain.‡收集10个林精的新芽。‡收集10個樹精的新芽。',
  }
},
[920] = {
  {
    'O chamado de Tenaron‡Зов Тенарона‡Tenarons Einladung‡테나론의 부름‡Las invocaciones de Tenaron‡Las invocaciones de Tenaron‡Les appels de Tenaron‡特纳隆的召唤‡特納隆的召喚',
    nil,
    'Fale com Tenaron Fortagarras no topo de Aldrassil, em Umbravale.‡Поговорите с Тенароном Хваткой Бури. Он ждет вас на вершине Альдрассила в Тенистой долине.‡Sprecht im Laubschattental über den Dächern von Aldrassil mit Tenaron Sturmgewalt.‡그늘 협곡, 알드랏실 꼭대기에 있는 테나론 스톰그립과 대화해야 합니다.‡Habla con Tenaron Tormentagarre en Aldrassil, en Cañada Umbría.‡Habla con Tenaron Tormentagarre en Aldrassil, en Cañada Umbría.‡Parler à Tenaron Poignorage au sommet d\'Aldrassil à Sombrevallon.‡与奥达希尔顶部的特纳隆·雷拳交谈。‡與幽影谷內奧達希爾頂部的特納隆·雷拳交談。',
  }
},
[921] = {
  {
    'Teldrassil: Crown of Azeroth‡Телдрассил: венец Азерота‡Teldrassil: Krone von Azeroth‡텔드랏실: 아제로스의 왕관‡Teldrassil: La corona de Azeroth‡Teldrassil: La corona de Azeroth‡Teldrassil : la couronne d\'Azeroth‡泰达希尔：艾泽拉斯之冠‡泰達希爾:艾澤拉斯之冠',
    nil,
    'Fill the Crystal Phial.‡Наполните хрустальный фиал водой.‡Füllt die Kristallphiole.‡수정 용기에 물을 채워야 합니다.‡Llena la ampolla de cristal.‡Llena la ampolla de cristal.‡Remplissez la Fiole de cristal.‡装满水晶瓶。‡裝滿水晶之瓶。',
  }
},
[922] = {
  {
    'Rellian Spiraverde‡Релиан Зеленый Костер‡Rellian Grünwipfel‡렐리안 그린스파이어‡Rellian Verdeguja‡Rellian Verdeguja‡Rellian Vertecime‡雷利亚·绿树‡雷利亞·綠樹',
    nil,
    'Leve uma Semente de Muscoide para Rellian Spiraverde no Casebre Olho-d\'água.‡Принесите саженец древесника Релиану Зеленому Костру в Родниковый шалаш.‡Bringt Rellian Grünwipfel bei der Hütte am Quell ein Bäumlingssamenkorn.‡생명의 오두막에 있는 렐리안 그린스파이어에게 나무괴물 씨앗을 가져가야 합니다.‡Llévale 1 semilla de Brezomadera a Rellian Verdeguja, en el Cobertizo Primigenio.‡Llévale 1 semilla de Brezomadera a Rellian Verdeguja, en el Cobertizo Primigenio.‡Apporter une Graine de sylvain à Rellian Vertecime au Taudis d\'Aigue-vive.‡给清泉小屋的雷利亚·绿树带去一粒林精的种子。‡給湧泉屋舍的雷利亞·綠樹帶去一顆樹精的種子。',
  }
},
[923] = {
  {
    'Tumores musguentos‡Мшистые опухоли‡Moosartige Tumore‡이끼 낀 종양‡Tumores musgosos‡Tumores musgosos‡Les tumeurs moussues‡青苔之瘤‡青苔之瘤',
    nil,
    'Consiga 5 Tumores Musguentos.‡Соберите 5 мшистых опухолей.‡Erhaltet 5 moosartige Tumore.‡이끼 낀 종양 5개를 모아야 합니다.‡Consigue 5 tumores musgosos.‡Consigue 5 tumores musgosos.‡Récupérez 5 Tumeurs moussues.‡收集5个青苔之瘤。‡取回5個青苔之瘤。',
  }
},
[924] = {
  {
    'A Semente Demoníaca‡Демоново семя‡Die Dämonensaat‡악마의 씨앗‡La Semilla del Demonio‡La Semilla del Demonio‡La Graine démoniaque‡恶魔之种‡惡魔之種',
    nil,
    'Pegue uma Pedra do Poder Defeituosa. Leve-a ao Altar de Fogo antes que ela expire e fale novamente com Ak\'Zeloth.‡Возьмите треснувший камень силы, возложите его на алтарь Огня до окончания его действия и возвращайтесь к Ак\'Зелоту.‡Nehmt einen fehlerhaften Kraftstein. Bringt ihn zum Altar des Feuers, bevor dessen Wirkung erlischt, und kehrt dann zu Ak\'Zeloth zurück.‡우선 혼란의 마법석을 손에 넣으십시오. 마법석의 힘이 다하기 전에 불의 제단에 가져다 놓은 후 아크젤로스에게 가야 합니다.‡Coge 1 piedra de energía con imperfecciones. Llévala al Altar de Fuego antes de que caduque la piedra y vuelve entonces junto a Ak\'Zeloth.‡Coge 1 piedra de energía imperfecta. Llévala al Altar de Fuego antes de que su energía desaparezca y vuelve junto a Ak\'Zeloth.‡Prendre une Pierre de puissance imparfaite. L\'apporter à l\'autel de feu avant que le pouvoir de la pierre n\'expire, puis revenir à Ak\'Zeloth.‡取一块有瑕疵的能量石。在能量石失去魔法之前把它带到火焰祭坛去，然后向雅克塞罗斯复命。‡取一塊有瑕疵的能量石。在能量石失去魔法之前把它帶到火焰祭壇去，然後向雅克塞羅斯覆命。',
  }
},
[925] = {
  {
    '‡Отпечаток копыта Кэрна‡Cairnes Hufabdruck‡케른의 발굽도장‡Marca de la pezuña de Cairne‡Marca de la pezuña de Cairne‡Empreinte de sabot de Cairne‡凯恩的蹄印‡凱恩的蹄印',
    nil,
    '‡Отправляйтесь в Громовой Утес и постарайтесь получить отпечаток копыта Кэрна Кровавого Копыта для своего подопечного.‡Reist nach Donnerfels und versucht für Euren Schützling einen Hufabdruck von Cairne Bluthuf zu ergattern.‡‡Viaja a Cima del Trueno para intentar conseguir las huellas de pezuñas de Cairne Pezuña de Sangre para tu pupilo.‡Viaja a Cima del Trueno para intentar conseguir las huellas de pezuñas de Cairne Pezuña de Sangre para tu pupilo.‡Allez aux Pitons-du-Tonnerre pour tenter d\'obtenir l\'empreinte de sabot de Cairne pour votre protégé.‡到雷霆崖去，为你看护的孩子拿到一份凯恩·血蹄的蹄印。‡',
  }
},
[926] = {
  {
    '‡Треснувший камень силы‡Fehlerhafter Kraftstein‡혼란의 마법석‡Piedra de energía con imperfecciones‡Piedra de energía con imperfecciones‡Pierre de puissance imparfaite‡有瑕疵的能量石‡有瑕疵的能量石',
    nil,
    nil,
  }
},
[927] = {
  {
    'O coração enroscado em musgo‡Сердце, поросшее мхом‡Das moosumschlungene Herz‡이끼로 덮인 심장‡El corazón musgoso‡El corazón musgoso‡Le cœur moussu‡布满苔藓的心脏‡佈滿苔蘚的心臟',
    nil,
    'Leve o Coração Enroscado em Musgo para Denalan no Lago Al\'Ameth.‡Принесите поросшее мхом сердце Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee das moosumschlungene Herz.‡이끼로 덮인 심장을 알아메스 호수에 있는 데날란에게 가져가야 합니다.‡Llévale el corazón musgoso a Denalan, que está en el Lago Al\'Ameth.‡Llévale el corazón musgoso a Denalan, que está en el Lago Al\'Ameth.‡Apportez le Cœur moussu à Denalan au lac Al\'Ameth.‡将布满苔藓的心脏交给奥拉密斯湖畔的德纳兰。‡將佈滿苔蘚的心臟交給奧拉密斯湖畔的德納蘭。',
  }
},
[928] = {
  {
    '‡Тельдрассил: утраченное знание‡Teldrassil: Gebt das Wissen weiter‡텔드랏실: 의식의 통과‡Teldrassil: La transmisión del conocimiento‡‡Teldrassil : transmettre la conscience‡泰达希尔：传递信息‡',
    nil,
    '‡Отнесите частично наполненный сосуд Коритрасу Лунному Гневу в Доланаар.‡Bringt Corithras Mondzorn in Dolanaar das teilweise gefüllte Gefäß.‡돌라나르에 있는 코리드라스 문레이지에게 반쯤 찬 유리병을 가져가야 합니다.‡Lleva la vasija casi llena a Corithras Furia Lunar a Dolanaar.‡Lleva la vasija casi llena a Corithras Furia Lunar a Dolanaar.‡Apportez le Récipient à moitié rempli à Corithras Ragelune à Dolanaar.‡将装着半瓶水的瓶子交给多兰纳尔的科瑞萨斯·月怒。‡',
  }
},
[929] = {
  {
    'Teldrassil: A rejeição dos Aspectos‡Тельдрассил: отрицание Аспектов‡Teldrassil: Die Verweigerung der Aspekte‡텔드랏실: 위상들의 거부‡Teldrassil: La negativa de los Aspectos‡Teldrassil: La negativa de los Aspectos‡Teldrassil : le rejet des Aspects‡泰达希尔：巨龙的取舍‡泰達希爾:大自然的回絕',
    nil,
    'Encha o Frasco de Jade.‡Наполните нефритовый фиал.‡Füllt die Jadephiole.‡비취 약병에 달샘의 물을 가득 채워야 합니다.‡Llena la ampolla de jade.‡Llena la ampolla de jade.‡Remplissez la Flasque de jade.‡用月亮井的水装满翡翠瓶。‡裝滿翡翠之瓶。',
  }
},
[930] = {
  {
    'A fruta brilhante‡Светящийся плод‡Die leuchtende Frucht‡빛나는 과일‡El fruto resplandeciente‡El fruto resplandeciente‡Le fruit luminescent‡发光的水果‡發光的水果',
    nil,
    'Leve a Fruta Brilhante para Denalan no Lago Al\'Ameth.‡Принесите светящийся плод Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee die leuchtende Frucht.‡알아메스 호수에 있는 데날란에게 빛나는 과일을 가져가야 합니다.‡Llévale el fruto resplandeciente a Denalan, que está en el Lago Al\'Ameth.‡Llévale el fruto resplandeciente a Denalan, que está en el Lago Al\'Ameth.‡Apportez le Fruit luminescent à Denalan au Lac Al\'Ameth.‡把这颗发光的水果交给奥拉密斯湖的德纳兰。‡把這顆發光的水果交給奧拉密斯湖的德納蘭。',
  }
},
[931] = {
  {
    'A fronde cintilante‡Мерцающий росток‡Der schimmernde Wedel‡희미하게 빛나는 잎‡Fronda fulgurante‡Fronda fulgurante‡Les racines chatoyantes‡发光的树叶‡發光的樹葉',
    nil,
    'Leve uma Fronde Cintilante para Denalan. Ele normalmente se encontra no Lago Al\'Ameth, mas ocasionalmente viaja para o Casebre Olho-d\'água.‡Принесите мерцающий росток Деналану. Обычно его можно найти на берегу озера Аль\'Амет, но иногда он перемещается к Родниковому шалашу.‡Bringt Denalan einen der schimmernden Wedel. Er hält sich meistens am Al\'Amethsee auf, reist aber manchmal zur Hütte am Quell.‡데날란에게 희미하게 빛나는 잎을 가져가야 합니다. 데날란은 보통 알아메스 호수에 있지만, 가끔 생명의 오두막으로 가기도 합니다.‡Llévale una fronda fulgurante a Denalan. Normalmente está en el Lago Al\'Amethm, pero a veces viaja hasta el Cobertizo Primigenio.‡Llévale una fronda fulgurante a Denalan. Normalmente está en el Lago Al\'Amethm, pero a veces viaja hasta el Cobertizo Primigenio.‡Apporter les Racines chatoyantes à Denalan. Il se trouve généralement au Lac Al\'Ameth, mais il se rend parfois au Taudis d\'Aigue-vive.‡给德纳兰带去一片发光的树叶。他通常住在奥拉密斯湖畔，但有时也会前往清泉小屋。‡給德納蘭帶去1片發光的樹葉。他通常位於奧拉密斯湖，但有時候會旅行到湧泉屋舍。',
  }
},
[932] = {
  {
    'Aversão pervertida‡Извращенная ненависть‡Krankhafter Hass‡뒤틀린 증오‡Odio enraizado‡Odio enraizado‡Haine folle‡扭曲的仇恨‡扭曲的仇恨',
    nil,
    'Consiga a cabeça do Senhor Málinus.‡Добудьте голову лорда Меленаса.‡Erhaltet den Kopf von Lord Melenas.‡제왕 멜레나스의 머리띠를 회수해야 합니다.‡Consigue la cabeza de Lord Melenas.‡Consigue la cabeza de Lord Melenas.‡Récupérez la Tête du Seigneur Melenas.‡获得迈雷纳斯的徽记。‡取得邁雷納斯領主的頭顱。',
  }
},
[933] = {
  {
    'Teldrassil: A aurora iminente‡Тельдрассил: начало рассвета‡Teldrassil: Der Anbruch des Tages‡텔드랏실: 다가오는 새벽‡Teldrassil: El alba del mañana‡Teldrassil: El alba del mañana‡Teldrassil : l\'aube se lève‡泰达希尔：黎明将至‡泰達希爾:黎明將至',
    nil,
    'Encha o Frasco de Turmalina.‡Наполните турмалиновый фиал.‡Füllt die Turmalinphiole.‡전기석 약병에 달샘의 물을 채워야 합니다.‡Llena la ampolla de turmalina.‡Llena la ampolla de turmalina.‡Remplissez la Flasque de tourmaline.‡用月亮井的水装满红玉瓶。‡裝滿紅玉之瓶。',
  }
},
[934] = {
  {
    '‡Венец Земли‡Teldrassil: Die Bürde der Kaldorei‡‡Teldrassil: La corona de Azeroth‡Teldrassil: La corona de Azeroth‡Teldrassil : la couronne d\'Azeroth‡大地之冠‡',
    nil,
    '‡Наполните аметистовый фиал и принесит его Коритрасу Лунному Гневу в Доланаар.‡Füllt die Amethystphiole.‡자수정 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de amatista y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Llena la ampolla de amatista y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Remplir la Flasque d\'améthyste et la rapporter à Corithras Ragelune à Dolanaar.‡用月亮井的水装满紫水晶瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡',
  }
},
[935] = {
  {
    'As águas de Teldrassil‡Воды Тельдрассила‡Die Wasser von Teldrassil‡텔드랏실의 물‡Las aguas de Teldrassil‡Las aguas de Teldrassil‡Les eaux de Teldrassil‡泰达希尔之水‡泰達希爾之水',
    nil,
    'Leve o Recipiente Cheio para Corithras Lunafúria na encruzilhada em frente a Darnassus.‡Отнесите наполненный сосуд Коритрасу Лунному Гневу на перекресток перед Дарнасом.‡Bringt das gefüllte Gefäß zu Corithras Mondzorn an der Kreuzung vor Darnassus.‡다르나서스 정면의 교차로에 있는 코리드라스 문레이지에게 가득 찬 유리병을 가져가야 합니다.‡Llévale la vasija llena a Corithras Furia Lunar en el cruce que hay enfrente de Darnassus.‡Llévale la vasija llena a Corithras Furia Lunar en el cruce que hay enfrente de Darnassus.‡Apportez le Récipient rempli à Corithras Ragelune, au croisement devant Darnassus.‡将装满月亮井水的瓶子交给达纳苏斯外面岔路口处的科瑞萨斯·月怒。‡將裝滿月井水的瓶子帶去達納蘇斯前方岔路給科瑞薩斯·月怒。',
  }
},
[936] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runentotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Tótem de Runa‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Totem-runique‡协助大德鲁伊‡協助大德魯伊符文圖騰',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Donnerfels mit Erzdruide Hamuul Runentotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l’Archidruide Hamuul Totem-Runique aux Pitons-du-Tonnerre.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談話。',
  }
},
[937] = {
  {
    'A Clareira Encantada‡Зачарованная поляна‡Die verzauberte Lichtung‡마법의 터‡El claro encantado‡El claro encantado‡La clairière enchantée‡神谕林地‡神諭林地',
    nil,
    'Consiga 6 Cintos Penassangue.‡Соберите 6 поясов Кровавых перьев.‡Erhaltet 6 Blutfedergürtel.‡붉은깃털 허리띠 6개를 모아야 합니다.‡Consigue 6 cinturones Sangrepluma.‡Consigue 6 cinturones Sangrepluma.‡Récupérez 6 Ceintures plumesang.‡收集6条血羽腰带。‡收集6條血羽腰帶，把它們交給神諭林地裡的哨兵阿瑞尼亞‧裂雲。',
  }
},
[938] = {
  {
    'Bruma‡Туманна‡Nebel‡미스트‡Niebla‡Niebla‡Brume‡密斯特‡密斯特',
    nil,
    'Escolte Bruma para a Sentinela Arynia Rasganimbus no poço lunar, perto da Árvore dos Oráculos.‡Проводите Туманну к Стражу Арании Проблеску Солнца к лунному колодцу близ Древа-оракула.‡Begleitet Nebel zur Schildwache Arynia Wolkenbruch beim Mondbrunnen in der Nähe des Orakelbaums.‡신탁의 나무 근처의 달샘에 있는 파수꾼 아리니아 클라우즈브레이크에게 미스트를 데려가야 합니다.‡Lleva a Niebla ante la centinela Arynia Quiebranubes que se encuentra en la Poza de la Luna situada cerca del Árbol del Oráculo.‡Lleva a Niebla ante la centinela Arynia Quiebranubes que se encuentra en la Poza de la Luna situada cerca del Árbol del Oráculo.‡Escorter Brume vers la Sentinelle Arynia Eclairciel au puits de lune, près de l\'arbre-oracle.‡护送密斯特去神谕之树附近的月亮井旁找哨兵阿瑞尼亚·碎云。‡護送密斯特去神諭之樹附近的月井旁找哨兵阿瑞尼亞‧碎雲。',
  }
},
[939] = {
  {
    '‡Флейта Ксаварика‡[DEPRECATED] Flöte des Xavaric‡사바릭의 플룻‡[DEPRECATED]La Flauta de Xavaric‡‡[PÉRIMÉ]La flûte de Xavaric‡萨瓦里克长笛‡',
    nil,
    '‡Принесите флейту Ксаварика и 5 образцов уз скверны Нефритового Пламени Эридане Грусти Ветра в южную часть Оскверненного леса.‡Bringt die Flöte von Xavaric und 5 Jadefeuerteufelsbinder zu Eridan Blauwind im südlichen Teil des Teufelswalds.‡‡Lleva la Flauta de Xavaric y 5 muestras de lazo vil de fuego de jade a Eridan Vientoazul al Frondavil meridional.‡Lleva la Flauta de Xavaric y 5 muestras de lazo vil de fuego de jade a Eridan Vientoazul al Frondavil meridional.‡Apportez la Flûte de Xavaric et 5 échantillons de Lien maudit Jadefeu à Eridan Ventebleu, dans le sud de Gangrebois.‡将萨瓦里克长笛和5个碧火魔符交给费伍德森林南部的艾瑞丹·蓝风。‡',
  }
},
[940] = {
  {
    '‡Тельдрассил‡‡텔드랏실‡‡‡‡泰达希尔‡泰達希爾',
    nil,
    '‡Передайте отчет Древа-оракула верховному друиду Фэндралу Оленьему Шлему в Дарнас.‡Überbringt dem Erzdruiden Fandral Hirschhaupt in Darnassus den Bericht des Orakelbaums.‡‡Llévale el informe del Árbol del Oráculo al archidruida Fandral Corzocelada de Darnassus.‡Llévale el informe del Árbol del Oráculo al archidruida Fandral Corzocelada de Darnassus.‡Remettre le rapport de l\'arbre-oracle à l\'archidruide Fandral Forteramure à Darnassus.‡把神谕之树的报告交给达纳苏斯的大德鲁伊范达尔·鹿盔。‡',
  }
},
[941] = {
  {
    'Plantando coração‡Сердце-семя‡Das Einpflanzen des Herzens‡오염된 심장 심기‡Plantar el corazón‡Plantar el corazón‡Une belle plante‡培养精华‡培養心臟',
    nil,
    'Plante o Coração Maculado na Sementeira do Denalan.‡Посадите запятнанное сердце в кадку Деналана.‡Pflanzt das besudelte Herz in Denalans Blumentopf ein.‡데날란의 화분에 오염된 심장을 심어야 합니다.‡Coloca el corazón máculo en la maceta de Denalan.‡Coloca el corazón máculo en la maceta de Denalan.‡Planter le Cœur corrompu dans le Pot de Denalan.‡把被污染的精华放到德纳兰的培养槽里。‡把受污染的心臟放到德納蘭的培養槽裡。',
  }
},
[942] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Leve o fóssil misterioso ao Arqueólogo Pançacheia no Porto de Menethil.‡Отвезите таинственную окаменелость археологу Бутылопузу в Гавань Менетилов.‡Bringt das rätselhafte Fossil zum Archäologen Magenbitter im Hafen von Menethil.‡메네실 항구에 있는 고고학자 플라곤구트에게 신비로운 화석을 가져가야 합니다.‡Lleva el fósil misterioso al arqueólogo Gargavino al Puerto de Menethil.‡Lleva el fósil misterioso al arqueólogo Gargavino al Puerto de Menethil.‡Apporter le mystérieux Fossile à l\'Archéologue Outrepanse au port de Menethil.‡把神秘的化石交给米奈希尔港的考古学家弗拉冈特。‡把神秘的化石交給米奈希爾港的考古學家弗拉岡特。',
  }
},
[943] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Arqueólogo Pançacheia, no Porto de Menethil, quer que você traga a Pedra de Relu e o Fóssil do Pançacheia para ele.‡Археолог Бутылопуз в Гавани Менетилов хочет, чтобы вы принесли ему камень Релу и окаменелость Бутылопуза.‡Der Archäologe Magenbitter im Hafen von Menethil möchte, dass Ihr ihm den Stein von Relu und Magenbitters Fossil bringt.‡메네실 항구에 있는 고고학자 플라곤구트가 렐루의 돌과 플라곤구트의 화석을 가져다 달라고 했습니다.‡El arqueólogo Gargavino, del Puerto de Menethil, quiere que le lleves la Piedra de Relu y el fósil de Gargavino.‡El arqueólogo Gargavino, del Puerto de Menethil, quiere que le lleves la Piedra de Relu y el fósil de Gargavino.‡L\'archéologue Outrepanse au port de Menethil veut que vous lui apportiez la Pierre de Relu et le Fossile d\'Outrepanse.‡米奈希尔港的考古学家弗拉冈特要你把雷鲁之石带给他。‡米奈希爾港的考古學家弗拉岡特要你把雷魯之石帶給他。',
  }
},
[944] = {
  {
    'Glaive do Mestre‡Меч Властителя‡Die Meistergleve‡지배자의 고대검‡La Espada del Maestro‡La Espada del Maestro‡Le Glaive du Maître‡主宰之剑‡主宰之劍',
    nil,
    'Reúna informações, depois use o Frasco de Vidência para criar uma Bacia de Vidência. Use a bacia para falar com Onu.‡Соберите информацию, а затем используйте фиал виденья для создания гадальной чаши. С помощью чаши поговорите с Ону.‡Tragt Informationen zusammen und benutzt dann die Wahrsagephiole, um eine Wahrsageschale zu erschaffen. Benutzt die Schale, um mit Onu zu sprechen.‡정보를 수집한 다음 수정점의 유리병을 사용하여 수정점 그릇을 만들어서 오누와 대화해야 합니다.‡Reúne información y luego utiliza una ampolla de adivinación para crear un cuenco de visión. Utiliza el cuenco para hablar con Onus.‡Reúne información y luego utiliza una ampolla de adivinación para crear un cuenco de visión. Utiliza el cuenco para hablar con Onus.‡Trouvez des informations, puis utilisez la Flasque de divination pour créer une Coupe de divination. Utilisez la coupe pour parler à Onu.‡收集信息，然后使用占卜之水创造出一个占卜之碗，并利用这个碗和安努通话。‡收集資訊，然後使用占卜之瓶創造出一個占卜之碗，並利用這個碗和安努通話。',
  }
},
[945] = {
  {
    'A fuga de Therylune‡Спасение Терилун‡Therylunes Flucht‡테리루네의 탈출‡La fuga de Therylune‡La fuga de Therylune‡L\'évasion de Therylune‡护送瑟瑞露尼‡護送瑟瑞露尼',
    nil,
    'Help Therylune escape, then tell Therysil at the Shrine of Aessina that her sister is safe.‡Помогите Терилун спастись, а потом сообщите Тересиль у святилища Эссины, что ее сестра в безопасности.‡Verhelft Therylune zur Flucht und teilt dann Therysil beim Schrein von Aessina mit, dass ihre Schwester in Sicherheit ist.‡테리루네의 탈출을 도운 다음 아에시나의 제단에 있는 테리실에게 그녀가 무사하다는 사실을 알려야 합니다.‡Ayuda a escapar a Therylune y luego dile a Therysil, en el Santuario de Aessina, que su hermana está a salvo.‡Ayuda a escapar a Therylune y luego dile a Therysil, en el Santuario de Aessina, que su hermana está a salvo.‡Aider Therylune à s\'échapper, puis dire à Therysil au Sanctuaire d\'Aessina que sa sœur est saine et sauve.‡帮助瑟瑞露尼逃跑，然后告诉在艾森娜神殿的瑟瑞希尔，她的妹妹目前很安全。‡幫助瑟瑞露尼逃跑，然後告訴在艾森娜神殿的瑟瑞希爾，她的妹妹目前很安全。',
  }
},
[946] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[947] = {
  {
    'Cogumelos da caverna‡Пещерные грибы‡Höhlenpilze‡동굴 버섯‡La cueva de las setas‡La cueva de las setas‡La caverne aux champignons‡洞中的蘑菇‡洞中的蘑菇',
    nil,
    'Leve 5 Galhos de Piolho e 1 Cogumelo-cicuta para Barithras Sombraluna, em Auberdine.‡Принесите 5 ножек струпника и 1 мертвянку Баритасу Лунному Сумраку в Аубердин.‡Bringt Barithras Mondschatten in Auberdine 5 Schorfstänglinge und 1 Todeskappe.‡아우버다인에 있는 바리스라스 문셰이드에게 껄껄이그물버섯 5개와 알광대버섯 1개를 가져가야 합니다.‡Lleva 5 boletos rudos y 1 oronja verde a Barithras Sombra Lunar a Auberdine.‡Lleva 5 boletos rudos y 1 oronja verde a Barithras Sombra Lunar a Auberdine.‡Apporter 5 Pédoncules d\'Amanite et 1 Amanite phalloïde à Barithras Lunombrage à Auberdine.‡收集5个粗柄蘑菇和1个毒帽蘑菇，把它们交给奥伯丁的巴瑞萨斯·月影。‡收集5個粗柄蘑菇和1個毒帽蘑菇，把它們交給奧伯丁的巴瑞薩斯‧月影。',
  }
},
[948] = {
  {
    'Onu‡Ону‡Onu‡오누‡Onus‡Onus‡Onu‡安努‡安努',
    nil,
    'Fale com Onu no Bosque dos Ancientes.‡Поговорите с Ону в Роще Древних.‡Sprecht im Hain der Uralten mit Onu.‡고대정령의 숲에서 오누와 대화해야 합니다.‡Ve al Páramo de los Ancianos y habla con Onus.‡Ve al Páramo de los Ancianos y habla con Onus.‡Parler à Onu au Bosquet des Anciens.‡和古树之林的安努谈一谈。‡和古樹之林的安努談話。',
  }
},
[949] = {
  {
    '‡Лагерь Сумеречного Молота‡Das Lager des Schattenhammers‡‡El campamento del Martillo Crepuscular‡El campamento del Martillo Crepuscular‡Le camp du Marteau du crépuscule‡暮光之锤的营地‡',
    nil,
    '‡Найдите подсказку в лагере клана Сумеречного Молота, расположенном у Меча Властителя.‡Sucht im Lager des Schattenhammers in der Meistergleve nach einem Hinweis.‡‡Encuentra una pista en el campamento del Martillo Crepuscular en La Espada del Maestro.‡Encuentra una pista en el campamento del Martillo Crepuscular en La Espada del Maestro.‡Trouver un indice au Camp du Marteau du crépuscule au Glaive du maître.‡到位于主宰之剑的暮光之锤营地去寻找线索。‡',
  }
},
[950] = {
  {
    '‡Возвращение к Ону‡Rückkehr zu Onu‡‡Regresa junto a Onus‡Regresa junto a Onus‡Retourner voir Onu‡向安努回复‡',
    nil,
    '‡Принесите Ону лист с безумными письменами.‡Bringt Onu das irrsinnige Gekritzel, das Ihr gefunden habt.‡‡Lleva a Onus los garabatos incomprensibles que has encontrado.‡Lleva a Onus los garabatos incomprensibles que has encontrado.‡Apportez les Gribouillages déments à Onu.‡把令人发狂的书页交给安努。‡',
  }
},
[951] = {
  {
    'Relíquias de Mathistra‡Реликвии Матистры‡Relikte von Mathystra‡마시스트라의 유물‡Las reliquias de Mathystra‡Las reliquias de Mathystra‡Les Reliques de Mathystra‡玛塞斯特拉遗物‡瑪塞斯特拉聖物',
    nil,
    'Leve 6 Relíquias de Mathistra para Onu no Bosque dos Ancientes.‡Принесите Ону в Рощу Древних 6 реликвий Матистры.‡Bringt 6 Relikte von Mathystra zu Onu in den Hain der Uralten.‡고대정령의 숲에 있는 오누에게 마시스트라 유물 6개를 가져가야 합니다.‡Lleva 6 reliquias de Mathystra a Onus al Páramo de los Ancianos.‡Lleva 6 reliquias de Mathystra a Onus al Páramo de los Ancianos.‡Apportez 6 Reliques de Mathystra à Onu, au Bosquet des Anciens.‡收集6个黑暗深渊遗物，把它们交给古树之林的安努。‡收集6個黑暗深淵聖物，把它們交給古樹之林的安努。',
  }
},
[952] = {
  {
    'Bosque dos Ancientes‡Роща Древних‡Der Hain der Uralten‡고대정령의 숲‡El Páramo de los Ancianos‡El Páramo de los Ancianos‡Bosquet des Anciens‡古树之林‡古樹之林',
    nil,
    'Entregue a mensagem de Fandral para Onu no Bosque dos Ancientes, que fica na Costa Negra, ao sul de Auberdine.‡Доставьте письмо Фэндрала Ону в Рощу Древних на Темные берега к югу от Аубердина.‡Bringt Fandrals Nachricht zu Onu in den Hain der Uralten in Dunkelküste, südlich von Auberdine.‡아우버다인의 남쪽, 어둠해안에 있는 고대정령의 숲에 있는 오누에게 판드랄의 전갈을 전해야 합니다.‡Entrégale el mensaje de Fandral a Onus en el Páramo de los Ancianos en Costa Oscura, al sur de Auberdine.‡Entrégale el mensaje de Fandral a Onus en el Páramo de los Ancianos en Costa Oscura, al sur de Auberdine.‡Livrer le message de Fandral à Onu au Bosquet des Anciens, à Sombrivage, au sud d\'Auberdine.‡把范达尔的信交给黑海岸古树之林里的安努。‡把范達爾的信交給黑海岸古樹之林裡的安努。',
  }
},
[953] = {
  {
    'A queda de Ameth\'Aran‡Падение Амет\'Арана‡Der Untergang von Ameth\'Aran‡아메스아란의 멸망‡La caída de Ameth\'Aran‡La caída de Ameth\'Aran‡La Chute d\'Ameth\'Aran‡亚米萨兰的毁灭‡亞米薩蘭的毀滅',
    nil,
    'Estude as tabuletas que contam sobre Ameth\'Aran e sua queda, depois fale novamente com a Sentinela Tysha Lamiluna na Costa Negra.‡Изучите таблички, рассказывающие об Амет\'Аране и его падении, а затем возвращайтесь к часовому Тише Лунный Клинок, находящейся на Темных берегах.‡Studiert die Schrifttafeln, die von Ameth\'Aran und ihrem Untergang erzählen, und kehrt dann zur Schildwache Tysha Mondklinge in Dunkelküste zurück.‡멸망한 아메스아란의 역사가 기록되어 있는 서판의 내용을 알아낸 다음 어둠해안에 있는 파수꾼 티샤 문블레이드에게 가야 합니다.‡Estudia las tablillas que hablan de Ameth\'Aran y de su caída y reúnete con la centinela Tysha Filoluna en Costa Oscura.‡Estudia las tablillas que hablan de Ameth\'Aran y de su caída y reúnete con la centinela Tysha Filoluna en Costa Oscura.‡Étudier les tablettes qui parlent d\'Ameth\'Aran et de sa chute, puis retourner voir la Sentinelle Tysha Lamelune à Sombrivage.‡研究刻有亚米萨兰的故事及其被毁经过的石碑，然后回到黑海岸的哨兵坦莎·月刃那里。‡研究刻有亞米薩蘭的故事及其被毀經過的石碑，然後回到黑海岸的哨兵坦莎‧月刃那裡。',
  }
},
[954] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Encontre a fonte da estranha aura azul nas ruínas de Bashal\'Aran.‡Найдите источник странного синего свечения в руинах Башал\'Арана.‡Sucht in den Ruinen von Bashal\'Aran nach der Quelle der seltsamen blauen Aura.‡바샬아란의 폐허에 감도는 이상한 푸른 기운의 근원을 찾아야 합니다.‡Encuentra la fuente de la extraña aura azul en las Ruinas de Bashal\'Aran.‡Encuentra la fuente de la extraña aura azul en las Ruinas de Bashal\'Aran.‡Trouver la source de l\'aura bleue dans les Ruines de Bashal\'Aran.‡到巴莎兰废墟去找到奇怪蓝光的源头。‡到巴莎蘭廢墟尋找奇怪藍光的源頭。',
  }
},
[955] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Consiga 8 Brinco de Capeta para Astérion em Bashal\'Aran.‡Соберите 8 сережек греллей для Астериона в Башал\'Аране.‡Beschafft für Asterion in Bashal\'Aran 8 Grellohrringe.‡바샬아란에 있는 아스테리온이 그렐족 귀걸이 8개를 모아 달라고 했습니다.‡Consigue 8 pendientes grell y llévaselos a Asterion a Bashal\'Aran.‡Consigue 8 pendientes de grell y llévaselos a Asterion a Bashal\'Aran.‡Acquérir 8 Boucles d\'oreilles de grell pour Asterion à Bashal\'Aran.‡帮巴莎兰的阿斯特利安收集8只劣魔耳环。‡幫巴莎蘭的阿斯特利安收集8只劣魔耳環。',
  }
},
[956] = {
  {
    '‡Башал\'Аран‡‡바샬아란‡‡‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    '‡Добудьте древнюю печать из лунного камня и принесите ее Астериону в Башал\'Аран.‡Beschafft das alte Mondsteinsiegel und bringt es Asterion in Bashal\'Aran.‡고대 월장석 봉인을 찾아 바샬아란에 있는 아스테리온에게 가져가야 합니다.‡Consigue el sello de piedra lunar antiguo y llévaselo a Asterion a Bashal\'Aran.‡Consigue el sello de piedra lunar antiguo y llévaselo a Asterion a Bashal\'Aran.‡Obtenir l\'Ancien sceau de pierre de lune et l\'apporter à Asterion à Bashal\'Aran.‡获取远古月亮石封印，把它交给巴莎兰的阿斯特利安。‡',
  }
},
[957] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Destrua o Selo Antigo de Pedra-da-lua na chama ancestral em Ameth\'Aran, depois fale novamente com Astérion em Bashal\'Aran.‡Уничтожьте древнюю печать из лунного камня у древнего пламени в Амет\'Аране, затем вернитесь к Астериону в Башал\'Аран.‡Zerstört das alte Mondsteinsiegel in der uralten Flamme in Ameth\'Aran und kehrt dann zu Asterion in Bashal\'Aran zurück.‡아메스아란에 있는 고대의 불꽃으로 고대 월장석 봉인을 파괴한 다음 바샬아란에 있는 아스테리온에게 가야 합니다.‡Destruye el sello de piedra lunar antiguo en la antigua llama de Ameth\'Aran y vuelve a reunirte con Asterion en Bashal\'Aran.‡Destruye el sello de piedra lunar antiguo en la antigua llama de Ameth\'Aran y vuelve a reunirte con Asterion en Bashal\'Aran.‡Détruire l\'Ancien sceau de pierre de lune à la flamme antique qui se trouve dans Ameth\'Aran, puis retourner voir Asterion à Bashal\'Aran.‡用亚米萨兰废墟中的远古火焰摧毁远古月亮石封印，然后回到巴莎兰的阿斯特利安那里。‡用亞米薩蘭廢墟中的遠古火焰摧毀遠古月亮石封印，然後回到巴莎蘭的阿斯特利安那裡。',
  }
},
[958] = {
  {
    'Ferramentas dos Altaneiros‡Инструменты высокорожденных‡Werkzeuge der Hochgeborenen‡명가의 도구‡Las herramientas de los Altonato‡Las herramientas de los Altonato‡Les outils des Bien-nés‡上层精灵的工具‡精靈貴族的工具',
    nil,
    'Resgate 7 Relíquias dos Altaneiros para Trovejius Tecevento, em Auberdine.‡Добудьте 7 реликвий высокорожденных для Тандриса Ветропряда в Аубердине.‡Sucht sieben Hochgeborenenrelikte und bringt sie Thundris Windwirker in Auberdine.‡아우버다인에 있는 툰드리스 윈드위버를 위해 명가의 유물 7개를 구해야 합니다.‡Reúne 7 reliquias de Altonato y llévaselas a Thundris Tejevientos a Auberdine.‡Reúne 7 reliquias de los Altonato y llévaselas a Thundris Tejevientos a Auberdine.‡Retrouver 7 Reliques de Bien-né pour Thundris Tissevent à Auberdine.‡帮奥伯丁的桑迪斯·织风取回7个上层精灵的遗物。‡幫奧伯丁的桑迪斯‧織風取回7個精靈貴族的聖物。',
  }
},
[959] = {
  {
    'Encrencas nas docas‡Неприятности в порту‡Ärger auf den Docks‡99년 묵은 포도주‡¡A por la botella!‡¡A por la botella!‡Fuite de porto aux docks‡港口的麻烦‡港口的麻煩',
    nil,
    'O Operador de Grua Mafuá, em Vila Catraca, quer que você recupere a garrafa de Xerez de 99 Anos com Maluc Insano, que se refugiou na Caverna Ululante.‡Оператор крана Биггльфузз из Кабестана попросил вас отнять бутылку портвейна 99-летней выдержки у Безумного Магглиша, который прячется в Пещерах Стенаний.‡Kranführer Moppelfuzz in Ratschet möchte, dass Ihr Zausel dem Verrückten, der sich in den Höhlen des Wehklagens versteckt, die Flasche mit 99 Jahre altem Portwein wieder abnehmt.‡톱니항에 있는 기중기 기사 비글퍼즈가 통곡의 동굴에 숨어 있는 광기의 매글리시에게서 99년 숙성된 포트 포도주를 되찾아 달라고 했습니다.‡El operador de grúa Pelardo de Trinquete quiere que le consigas una botella de Oporto con 99 años de antigüedad de Loco Magglish, que se esconde en las Cuevas de los Lamentos.‡El operador de grúa Pelardo de Trinquete quiere que le consigas una botella de Oporto con 99 años de antigüedad de Loco Magglish, que se esconde en las Cuevas de los Lamentos.‡Le grutier Bigglefuzz de Cabestan veut que vous repreniez la bouteille de Porto de 99 ans d\'âge à Magglish le Dingue, qui se cache dans les Cavernes des Lamentations.‡棘齿城的起重机操作员比戈弗兹让你从疯狂的马格利什那儿取回一瓶99年波尔多陈酿，疯狂的马格利什就藏在哀嚎洞穴里。‡棘齒城的起重機操作員比戈弗茲讓你從瘋狂的馬格利什那兒取回一瓶99年波爾多陳釀，瘋狂的馬格利什就藏在哀嚎洞穴裡。',
  }
},
[960] = {
  {
    '‡Размышление Ону‡Onu meditiert‡‡Onus lo está meditando‡Onus lo está meditando‡Onu réfléchit‡正在冥想的安努‡',
    nil,
    nil,
  }
},
[961] = {
  {
    '‡Размышление Ону‡Onu meditiert‡‡Onus lo está meditando‡Onus lo está meditando‡Onu réfléchit‡正在冥想的安努‡',
    nil,
    nil,
  }
},
[962] = {
  {
    'Ofídeas‡Змеецвет‡Schlangenflaum‡불뱀꽃‡Reptilia‡Reptilia‡Fleur de serpent‡毒蛇花‡毒蛇花',
    nil,
    'A Boticária Zaqueia, no Penhasco do Trovão, quer que você colete 10 Ofídeas.‡Аптекарь Зама из Громового Утеса просит вас принести ей 10 змеецветов.‡Die Apothekerin Zamah in Donnerfels möchte, dass Ihr zehn Schlangenflaum für sie sammelt.‡썬더 블러프에 있는 연금술사 자마가 불뱀꽃 10개를 모아 달라고 했습니다.‡La boticaria Zamah de Cima del Trueno quiere que recojas 10 reptilias.‡La boticaria Zamah de Cima del Trueno quiere que recojas 10 reptilias.‡L\'Apothicaire Zamah des Pitons-du-Tonnerre veut que vous récoltiez 10 Fleurs de serpent.‡为雷霆崖的药剂师扎玛收集10朵毒蛇花。‡為雷霆崖的藥劑師札瑪收集10朵毒蛇花。',
  }
},
[963] = {
  {
    'Amor eterno‡Во имя вечной любви‡In ewiger Liebe‡영원한 사랑‡Un amor eterno‡Un amor eterno‡Un amour éternel‡永志不渝‡永志不渝',
    nil,
    'Liberte o espírito de Anaya Correalba e leve seu pingente para Cerellean Garralva em Auberdine.‡Освободите дух Анайи Вестницы Зари и принесите ее подвеску Кириллиану Белому Когтю в Аубердин.‡Befreit den Geist von Anaya Dämmerflucht und bringt ihren Anhänger zu Cerellean Weißklaue in Auberdine.‡아나야 돈러너의 영혼을 자유롭게 한 다음 그녀의 펜던트를 아우버다인에 있는 세렐리안 화이트클로에게 가져가야 합니다.‡Libera el espíritu de Anaia Correalba y lleva su colgante a Cerellean Zarpablanca a Auberdine.‡Libera el espíritu de Anaia Correalba y lleva su colgante a Cerellean Zarpablanca a Auberdine.‡Libérer l\'esprit d\'Anaya Coursaurore et rapporter son pendentif à Cerellean Blanchegriffe à Auberdine.‡释放安娜雅·晨路的灵魂，把她的坠饰交给奥伯丁的塞瑞利恩·白爪。‡釋放安娜雅·曦奔的靈魂，把她的墜飾交給奧伯丁的塞瑞利恩·白爪。',
  }
},
[964] = {
  {
    'Fragmentos de Ossos‡Фрагменты скелетов‡Skelettfragmente‡뼛조각‡Trozos esqueléticos‡Trozos esqueléticos‡Fragments de squelette‡骸骨碎片‡骷髏碎片',
    nil,
    'Leve 15 Fragmentos de Ossos para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите 15 фрагментов скелетов аптекарю Дитерсу в Бастион в Западных Чумных землях.‡Bringt 15 Skelettfragmente zu Apotheker Zitters am Bollwerk in Tirisfal.‡서부 역병지대의 보루에 있는 연금술사 디더스에게 뼛조각 15개를 가져가야 합니다.‡Lleva 15 trozos esqueléticos al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva 15 trozos esqueléticos al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter 15 Fragments de squelette à l\'Apothicaire Dithers à la Barricade, dans les Maleterres de l\'Ouest.‡将15块骸骨碎片交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡',
  }
},
[965] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Encontre Balthule Umbrataque perto da Torre de Althalaxx, que fica na Costa Negra.‡Найдите Балтула Удар Тени возле башни Алталакса на Темных берегах.‡Sucht Balthule Schattenhieb in der Nähe des Turms von Althalaxx in Dunkelküste.‡어둠해안에 있는 알살락스의 탑 근처에서 발툴 섀도스트라이크를 찾아야 합니다.‡Encuentra a Balthule Tenebroso cerca de La Torre de Althalaxx en Costa Oscura.‡Encuentra a Balthule Tenebroso cerca de La Torre de Althalaxx en Costa Oscura.‡Trouver Balthule Frappelombre près de la Tour d\'Althalaxx à Sombrivage.‡在黑海岸的奥萨拉克斯之塔附近找到巴苏尔·影击。‡在黑海岸的奧薩拉克斯之塔附近找到巴蘇爾·影擊。',
  }
},
[966] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Colete 4 Pergaminhos Gastos para Balthule Umbrataque, perto da Torre de Althalaxx.‡Соберите 4 свитка истрепанного пергамента для Балтула Удара Тени возле башни Алталакса.‡Sammelt 4 abgenutzte Pergamentfetzen für Balthule Schattenhieb in der Nähe des Turms von Althalaxx.‡알살락스의 탑 근처에 있는 발툴 섀도스트라이크를 위해 낡은 양피지 문서 4개를 모아야 합니다.‡Reúne 4 papiros desgastados para Balthule Golpesombra acerca de La Torre de Althalaxx.‡Reúne 4 papiros desgastados para Balthule Golpesombra acerca de La Torre de Althalaxx.‡Collecter 4 Parchemins passés pour Balthule Frappelombre près de la Tour d\'Althalaxx.‡在奥萨拉克斯之塔附近帮巴苏尔·影击收集4块破旧的羊皮纸。‡在奧薩拉克斯之塔附近幫巴蘇爾‧影擊收集4塊破舊的羊皮紙。',
  }
},
[967] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Entregue a carta de Balthule a Dinis, o Purificador, na Floresta do Vale Gris.‡Доставьте письмо Балтула Делгрену Очистителю в Ясеневый лес.‡Überbringt Delgren dem Läuterer im Eschental Balthules Brief.‡잿빛 골짜기에 있는 수호자 델그렌에게 발툴의 편지를 전해야 합니다.‡Entrega la carta de Balthule a Delgren el Purificador que está en el Bosque de Vallefresno.‡Entrega la carta de Balthule a Delgren el Purificador que está en el Bosque de Vallefresno.‡Remettre la Lettre de Balthule à Delgren le Purificateur dans la forêt d\'Orneval.‡把巴苏尔的信送给灰谷森林中的净化者德尔格伦。‡把巴蘇爾的信送給梣谷森林中的『淨化者』德爾葛蘭。',
  }
},
[968] = {
  {
    'Os Poderes de Baixo‡"Подземные Силы"‡Die Macht in der Tiefe‡힘의 저편‡Los Poderes Subyacentes‡Los Poderes Subyacentes‡Les puissances d\'en bas‡深渊之神‡深淵之神',
    nil,
    'Leve o Livro: Os Poderes de Baixo para Gerrig Agarrosso na Caverna Esquecida, em Altaforja.‡Принесите книгу "Подземные Силы" Геррику Костохвату в Заброшенный грот в Стальгорне.‡Bringt das Buch: \'Die Macht in der Tiefe\' zu Gerrig Knochengriff im Düsteren Viertel in Eisenschmiede.‡아이언포지에 있는 게릭 본그립에게 \'힘의 저편\'이라는 책을 가져가야 합니다.‡Lleva el libro Los Poderes Subyacentes a Gerrig Agarrahueso a La Caverna Abandonada, en Forjaz.‡Lleva el libro Los Poderes Subyacentes a Gerrig Agarrahueso a La Caverna Abandonada, en Forjaz.‡Apportez le Livre : Les puissances d\'en bas à Gerrig Poigne-d\'os, dans la Caverne Lugubre de Forgefer.‡把《深渊之神》交给铁炉堡的葛利·硬骨。‡把《深淵之神》交給鐵爐堡荒棄的洞穴中的葛利·硬骨。',
  }
},
[969] = {
  {
    '[DEPRECATED]Luck Be With You‡Да пребудет с тобой удача!‡Das Glück sei mit Euch‡행운이 함께하기를‡[DEPRECATED]Que la suerte sea contigo‡[DEPRECATED]Que la suerte sea contigo‡[PÉRIMÉ]Que la chance soit avec vous‡祝你好运‡[DEPRECATED]Luck Be With You',
    nil,
    'Colete 4 Lascas de Friomalho para Mandingueira Mau\'ari, em Visteterna.‡Соберите 4 кристалла великанов Ледяного Молота для знахарки Мау\'ари из Круговзора.‡Sammelt 4 Frosthagelsplitter für die Hexendoktorin Mau\'ari in der Ewigen Warte.‡눈망루 마을의 의술사 마우아리에게 서리망치거인조각 4개를 가져가야 합니다.‡Recoge 4 esquirlas de Machacahielo para la médica bruja Mau\'ari de Vista Eterna.‡Recoge 4 esquirlas de Machacahielo para la médica bruja Mau\'ari de Vista Eterna.‡Collecter 4 Éclats cognegivre pour la féticheuse Mau\'ari à Long-Guet.‡收集4块霜槌碎片，把它们交给永望镇的巫医玛艾里。‡收集4塊霜槌裂片，把它們交給永望鎮的巫醫瑪艾里。',
  }
},
[970] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Colete uma Gema Anímica Faiscante e fale novamente com Dinis, o Purificador, no Entreposto de Maestra.‡Добудьте светящийся самоцвет Души и вернитесь к Делгрену Очистителю на заставу Мейстры.‡Beschafft einen leuchtenden Seelenedelstein und bringt ihn Delgren dem Läuterer in Maestras Posten.‡빛나는 영혼의 보석을 모아 마에스트라 주둔지에 있는 수호자 델그렌에게 가져가야 합니다.‡Reúne una gema de alma resplandeciente y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Reúne una gema de alma resplandeciente y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Trouver une Gemme d\'âme luminescente et la rapporter à Delgren le Purificateur au poste de Maestra.‡收集一枚发光的灵魂宝石，并把它交给梅伊瑟娜岗哨的净化者德尔格伦。‡搜集一枚發光的靈魂寶石，並把它交給邁斯特拉崗哨的『淨化者』德爾葛蘭。',
  }
},
[971] = {
  {
    'Conhecimento nas Profundezas‡Знание в пучине‡Wissen in der Tiefe‡심연의 지식‡Conocimiento en las Cavernas‡Conocimiento en las Cavernas‡La connaissance des profondeurs‡深渊中的知识‡深淵中的知識',
    nil,
    'Bring the Lorgalis Manuscript to Sentinel-trainee Issara at the Blackfathom Camp.‡Принесите манускрипт Лоргалиса курсанту-часовому Иссаре в лагерь у Непроглядной Пучины.‡Bringt das \'Manuskript von Lorgalis\' zu Schildwachenschülerin Issara zum Stützpunkt an der Grotte.‡검은심연 야영지에 있는 파수꾼 훈련생 이사라에게 로르갈리스 초본을 가져가야 합니다.‡Lleva el manuscrito de Lorgalis a la centinela practicante Issara que está en el Campamento Brazanegra.‡Lleva el manuscrito de Lorgalis a la centinela practicante Issara que está en el Campamento Brazanegra.‡Apportez le Manuscrit de Lorgalis à l’Apprentie sentinelle Issara, au Camp de Brassenoire.‡把洛迦里斯手稿交给黑渊营地的受训哨兵伊莎娜。‡將洛迦里斯手稿帶去黑澗營地給哨兵受訓員伊薩拉。',
  }
},
[972] = {
  {
    '‡Сапта воды‡Wassersapta‡물의 정기‡Sapta de agua‡Sapta de agua‡Sapta d\'eau‡水之灵契‡水之靈契',
    nil,
    nil,
  }
},
[973] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Leve o Tomo de Ilkrud Magthrull para Dinis, o Purificador, no Entreposto de Maestra.‡Принесите фолиант Илкруда Магтрулла Делгрену Очистителю на заставу Мейстры.‡Bringt Delgren dem Läuterer in Maestras Posten Ilkrud Magskluves Folianten.‡마에스트라 주둔지에 있는 수호자 델그렌에게 일크루드 마그스룰의 마법책을 가져가야 합니다.‡Llévale el escrito de Ilkrud Magthrull a Delgren el Purificador en la Atalaya de Maestra.‡Llévale el Libro de Ilkrud Magthrull a Delgren el Purificador en la Atalaya de Maestra.‡Apporter le Tome d\'Ilkrud Magthrull à Delgren le Purificateur au Poste de Maestra.‡把伊克鲁德·玛格苏尔之书交给梅伊瑟娜岗哨的净化者德尔格伦。‡把伊克魯德·瑪格蘇爾之書交給邁斯特拉崗哨的『淨化者』德爾葛蘭。',
  }
},
[974] = {
  {
    'Morno... morno... quente!‡Найти источник‡Die Quelle finden‡앗! 뜨거!‡Busca la fuente‡Busca la fuente‡À la recherche de la source‡究根问底‡究根問底',
    nil,
    'Gualter, na Cratera Un\'Goro, quer que você encontre a área mais quente do Pico Penacho de Fogo.|n|nAo se deparar com um ponto de calor, clique com o botão direito no termômetro para medir a temperatura. Procure até encontrar o mais quente de todos.‡Выясните, где находится точка самой высокой температуры на Вулкане Огненного Венца, по просьбе Кракла из Кратера Ун\'Горо. |n|nДля измерения температуры щелкните по термометру правой кнопкой мыши. Проверяйте все горячие точки, пока не будет обнаружена точка с самой высокой температурой.‡Krakle im Krater von Un\'Goro möchte, dass Ihr den heißesten Bereich des Feuersäulengrats findet.|n|nImmer, wenn Ihr eine heiße Stelle findet, klickt Ihr das Thermometer mit der rechten Maustaste an, um die Temperatur zu überprüfen. Sucht, bis Ihr die heißeste Stelle gefunden habt.‡운고로 분화구에 있는 크래클이 불기둥 마루에서 가장 뜨거운 자리를 찾아 달라고 했습니다.|n|n뜨거운 열점을 찾을 때마다 온도계측장치를 오른쪽 클릭해 온도를 재십시오. 가장 뜨거운 열점을 찾을 때까지 계속 재야 합니다.‡Krakle, en el Cráter de Un\'Goro, quiere que encuentres la zona más caliente de la Cresta del Penacho en Llamas.|n|nSiempre que des con un punto caliente, pulsa con el botón derecho sobre el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el punto más caliente.‡Krakle, en el Cráter de Un\'Goro, quiere que encuentres la zona más caliente de la Cresta del Penacho en Llamas.|n|nSiempre que des con un punto caliente, pulsa con el botón derecho sobre el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el punto más caliente.‡Krakle, au cratère d\'Un\'Goro, vous demande de découvrir la zone la plus chaude de la crête de la Fournaise.|n|nQuand vous trouvez une zone de chaleur, cliquez avec le bouton droit de la souris sur le thermomètre afin de prendre la température. Continuez vos recherches jusqu\'à avoir trouvé la zone la plus chaude.‡安戈洛尔环形山的克拉兰克要你去找到火羽山中温度最高的地方。|n|n当你找到一个看上去很热的地方时，就右键点击温度计来测量当地的温度。不断尝试，直到你找到温度最高的地方。‡安戈洛環形山的克拉蘭克要你去找到火羽山中溫度最高的地方。|n|n當你找到一個看起來很熱的地方時，就右鍵點擊溫度計來測量當地的溫度。不斷嘗試，直到你找到溫度最高的地方。',
  }
},
[976] = {
  {
    'Suprimentos para Auberdine‡Поставка для Аубердина‡Nachschub für Auberdine‡아우버다인으로의 보급품‡Suministros a Auberdine‡Suministros a Auberdine‡De l\'approvisionnement pour Auberdine‡奥伯丁的补给品‡奧伯丁的補給品',
    nil,
    'Fale com Dinis, o Purificador, no Entreposto de Maestra, após escoltar Firo pela Floresta do Vale Gris.‡Поговорите с Делгреном Очистителем на заставе Мейстры после того, как проводите Фиро через Ясеневый лес.‡Sprecht mit Delgren dem Läuterer bei Maestras Posten, nachdem Ihr Feero sicher durch das Eschental geführt habt.‡피이로가 안전하게 잿빛 골짜기를 통과하도록 경호한 뒤 마에스트라 주둔지에 있는 수호자 델그렌과 대화해야 합니다.‡Habla con Delgren el Purificador en la Atalaya de Maestra después ayudar a Feero a cruzar el Bosque de Vallefresno y dejarlo a buen recaudo.‡Habla con Delgren el Purificador en la Atalaya de Maestra después ayudar a Feero a cruzar el Bosque de Vallefresno y dejarlo a buen recaudo.‡Parler à Delgren le Purificateur, au Poste de Maestra, après avoir escorté Feero à travers la Forêt d\'Orneval.‡护送费罗·艾隆汉安全地穿越灰谷森林，然后和梅伊瑟娜岗哨的净化者德尔格伦谈一谈。‡護送費羅·艾隆漢安全地穿越梣谷森林，再與邁斯特拉崗哨的『淨化者』德爾葛蘭談話。',
  }
},
[977] = {
  {
    '[DEPRECATED]Are We There, Yeti?‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡[DEPRECATED]Yeti... ¿ya hemos llegado?‡[DEPRECATED]Yeti... ¿ya hemos llegado?‡[PÉRIMÉ]Yéti ? Y es-tu ?‡雪怪计划！‡[DEPRECATED]Are We There, Yeti?',
    nil,
    'Colete 2 Chifres Impolutos de Yeti para Umi Zombarruga em Visteterna.‡Добудьте 2 безупречных рога Йети для Уми Смехотреп из Круговзора.‡Sammelt 2 makellose Yetihörner für Umi Rumpelkicher in der Ewigen Warte.‡눈망루 마을에 있는 우미 럼플스니커에게 온전한 설인 뿔 2개를 가져가야 합니다.‡Reúne 2 cuernos prístinos de yeti para Umi Risitas en Vista Eterna.‡Reúne 2 cuernos prístinos de yeti para Umi Risitas en Vista Eterna.‡Collecter 2 Cornes de yéti en parfait état pour Umi Sarcafroisse, à Long-Guet.‡为永望镇的乌米收集2支完美的雪人角。‡為永望鎮的烏米收集2支完美的雪人角。',
  }
},
[978] = {
  {
    'Coruscantes Lunamarca‡Осененные луной дикие совухи‡Mondbestrahltes Wildekin‡달빛의 올빼미야수‡Lechúcico Lunadón‡Lechúcico Lunadón‡Les Indomptables lunaires‡月光羽毛‡月光羽毛',
    nil,
    'Colete 10 Penas Lunamarca de Hibérnia, depois fale novamente com Erelas Ambarcéu, na Vila de Rut\'theran.‡Соберите в Зимних Ключах 10 осененных луной перьев и принесите их Эреласу Янтарному Небу в деревню Рут\'теран.‡Sammelt 10 mondbestrahlte Federn aus Winterquell und kehrt dann zu Erelas Himmelsbern in Rut\'theran zurück.‡여명의 설원에서 달빛 깃든 깃털을 10개 모아서 루테란 마을의 에렐라스 엠버스카이에게 가져가야 합니다.‡Recoge 10 plumas Lunadón de Cuna del Invierno y regresa con Erelas Cieloámbar en Aldea Rut\'theran.‡Recoge 10 plumas Lunadón de Cuna del Invierno y regresa con Erelas Cieloámbar en Aldea Rut\'theran.‡Récupérez 10 Plumes de Chouettard lunaire au Berceau-de-l\'Hiver, puis retournez voir Erelas Ambreciel, à Rut\'theran.‡从冬泉谷收集10片月光羽毛，然后将它们带给鲁瑟兰村的艾瑞拉斯·琥珀。‡從冬泉谷收集10片月光羽毛，然後將它們帶給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[979] = {
  {
    'Encontrando Ranshalla‡В поисках Раншаллы‡Ranshalla suchen‡란샬라 찾기‡Encuentra a Ranshalla‡Encuentra a Ranshalla‡Trouver Ranshalla‡兰莎尔拉‡蘭莎爾拉',
    nil,
    'Encontre Ranshalla em Hibérnia oriental.‡Найдите Раншаллу в восточной части Зимних Ключей.‡Sucht nach Ranshalla im östlichen Winterquell.‡여명의 설원 동부에 있는 란샬라를 찾아야 합니다.‡Encuentra a Ranshalla en la zona oriental de Cuna del Invierno.‡Encuentra a Ranshalla en la zona oriental de Cuna del Invierno.‡Trouver Ranshalla dans l\'est du Berceau-de-l\'Hiver.‡在冬泉谷找到兰莎尔拉。‡在冬泉谷找到蘭莎爾拉。',
  }
},
[980] = {
  {
    'As novas fontes‡Новые источники‡Die neuen Quellen‡새로운 온천‡Nuevos manantiales‡Nuevos manantiales‡Les nouvelles sources‡新的泉水‡新的泉水',
    nil,
    'Vá a Hibérnia e fale com Bruna Covaneve.‡Отправьтесь в Зимние Ключи и побеседуйте с Доновой Снегонорой.‡Reist nach Winterquell und sprecht mit Donova Schneeweh.‡여명의 설원으로 가서 도노바 스노우덴과 대화해야 합니다.‡Viaja hasta Cuna del Invierno y habla con Donova Cubilnevado.‡Viaja hasta Cuna del Invierno y habla con Donova Cubilnevado.‡Voyager jusqu\'au Berceau-de-l\'Hiver et parler à Donova Antreneige.‡到冬泉谷去和多诺瓦·雪山谈一谈。‡到冬泉谷去和多諾瓦·雪山談話。',
  }
},
[981] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Fale com Dinis, o Purificador, no Entreposto de Maestra.‡Поговорите с Делгреном Очистителем на Заставе Мейстры.‡Sprecht mit Delgren dem Läuterer in Maestras Posten.‡마에스트라 주둔지에 있는 수호자 델그렌과 대화해야 합니다.‡Habla con Delgren el Purificador en la Atalaya de Maestra.‡Habla con Delgren el Purificador en la Atalaya de Maestra.‡Aller voir Delgren le Purificateur au Poste de Maestra.‡和梅伊瑟娜岗哨的净化者德尔格伦谈一谈。‡和邁斯特拉崗哨的『淨化者』德爾葛蘭談話。',
  }
},
[982] = {
  {
    'Nas profundezas do mar‡Безбрежное море, глубокий океан‡Tiefer Ozean, weites Meer‡깊고 푸른 바다‡Profundo océano, mar inmenso‡Profundo océano, mar inmenso‡Océan profond, mer immense‡深不可测的海洋‡深不可測的海洋',
    nil,
    'Recupere o Baú do Aurora de Prata e o Baú do Véu das Brumas para Gorbold Manácero em Auberdine. Os dois itens podem ser encontrados nos destroços dos navios, a norte da vila.‡Добудьте сейф "Серебряной Зари" и сейф "Туманной Пелены" для Горбольда Стальной Руки в Аубердине. Оба предмета можно найти в останках потерпевших крушение кораблей к северу от деревни.‡Beschafft die Schließkassette der Silbermorgen und die Schließkassette der Nebelschleier für Gorbold Stahlhand in Auberdine. Beide Gegenstände findet Ihr an Bord der Schiffswracks nördlich des Dorfes.‡아우버다인에 있는 골볼트 스틸핸드를 위해 은빛 새벽호의 금고와 안개 장막호의 금고를 회수해야 합니다. 모두 마을의 북쪽에 있는 난파선에서 찾을 수 있을 것입니다.‡Recupera el arcón de Amanecer de plata y el arcón del Halo de Bruma para Gorbold Mano de Acero de Auberdine. Ambos objetos deberían estar en los cascos de los navíos naufragados al norte de la aldea.‡Recupera el arcón del Amanecer de Plata y la caja fuerte del Halo de Bruma para Gorbold Mano de Acero de Auberdine. Ambos objetos deberían estar en los cascos de los navíos naufragados al norte de la aldea.‡Récupérer le Coffret de l\'Aube argentée et le Coffret du Voile de brume, pour Gorbold Main-d\'acier, à Auberdine. Ces deux objets se trouvent à bord des épaves des navires respectifs, au nord du village.‡找到银色清晨号的保险箱和迷雾之纱号的保险箱，把它们交给奥伯丁的高尔博德·钢手。你可以在村庄北部遇难的船只里找到这两只箱子。‡找到銀色清晨號的帶鎖箱和迷霧之紗號的帶鎖箱，把它們交給奧伯丁的高爾博多‧鋼手。你可以在村莊北部遇難的船隻裡找到這兩隻帶鎖箱。',
  }
},
[983] = {
  {
    'Caixazorra 827‡Жужжалка 827‡Dröhnkiste 827‡윙윙상자 827‡La caja mecánica 827‡La caja mecánica 827‡Bigobox 827‡传声盒827号‡傳聲盒827號',
    nil,
    'Colete 6 Patas de Rastejante e coloque-as na Caixazorra 827.‡Добудьте 6 ножек крабов и поместите их в Жужжалку 827.‡Sammelt 6 Kriecherbeine und baut sie in Dröhnkiste 827 ein.‡집게다리 6개를 모아 윙윙상자 827에 넣어야 합니다.‡Reúne 6 patas de reptador y colócalas en la caja mecánica 827.‡Reúne 6 patas de reptador y colócalas en la caja mecánica 827.‡Réunir 6 Pattes de clampants et les mettre dans la Bigobox 827.‡收集6只蟹腿，把它们放进传声盒827号。‡收集6隻蟹腿，把它們放進傳聲盒827號。',
  }
},
[984] = {
  {
    'Uma grande ameaça?‡Насколько велика угроза?‡Wie groß ist die Bedrohung?‡거대한 위협‡La extensión de la amenaza‡La extensión de la amenaza‡Quelle est l\'ampleur de la menace ?‡熊怪的威胁‡熊怪的威脅',
    nil,
    'Encontre um acampamento de pelursos corrompidos na Costa Negra e fale novamente com Terenthis em Auberdine.‡Найдите оскверненный лагерь фурболгов на Темных берегах и вернитесь к Терентису в Аубердин.‡Sucht in Dunkelküste nach einem verderbten Furbolglager und kehrt dann zu Terenthis in Auberdine zurück.‡어둠해안에서 오염된 펄볼그 야영지를 찾은 다음 아우버다인에 있는 테렌디스에게 가야 합니다.‡Encuentra el campamento de fúrbolgs corruptos en Costa Oscura, vuelve a Auberdine y busca a Terenthis.‡Encuentra el campamento de fúrbolgs corruptos en Costa Oscura, vuelve a Auberdine y busca a Terenthis.‡Trouver un camp de furbolgs corrompus à Sombrivage et retourner voir Terenthis dans Auberdine.‡在黑海岸找到一处堕落熊怪的营地，然后向奥伯丁的特伦希斯报告。‡在黑海岸找到一處墮落熊怪的營地，然後向奧伯丁的特倫希斯報告。',
  }
},
[985] = {
  {
    'Uma grande ameaça‡Насколько велика угроза?‡Wie groß ist die Bedrohung?‡거대한 위협‡La extensión de la amenaza‡La extensión de la amenaza‡Quelle est l\'ampleur de la menace ?‡熊怪的威胁‡熊怪的威脅',
    nil,
    'Mate 8 Desbravadores Bosquenero e 5 Vozes-do-vento, depois fale novamente com Terenthis, em Auberdine.‡Убейте 8 землепроходцев и 5 заклинателей ветра из племени Чернолесья, а затем вернитесь к Терентису в Аубердин.‡Tötet 8 Pfadfinder der Schwarzfelle und 5 Windsprecher und kehrt dann zu Terenthis in Auberdine zurück.‡검은나무 길잡이 8마리와 풍수사 5마리를 처치한 다음 아우버다인에 있는 테렌디스에게 가야 합니다.‡Mata a 5 soplavientos y a 8 abrecaminos Bosque Negro y vuelve a Auberdine a buscar a Terenthis.‡Mata a 5 soplavientos y a 8 abrecaminos Bosque Negro y vuelve a Auberdine a buscar a Terenthis.‡Tuer 8 Guides et 5 Messagers du vent Noirbois puis retourner voir Terenthis à Auberdine.‡杀掉8个黑木探路者和5个黑木风语者，然后回到奥伯丁向特伦希斯汇报。‡殺掉8個黑木探路者和5個黑木風語者，然後回到奧伯丁向特倫希斯彙報。',
  }
},
[986] = {
  {
    'Um mestre perdido‡Пропавший хозяин‡Ein verirrter Meister‡사라진 주인‡El maestro perdido‡El maestro perdido‡Un maître perdu‡失踪的主人‡丟失的主人',
    nil,
    'Encontre 5 Pelagens de Espreitaluna Finas e leve-as para Terenthis, em Auberdine.‡Найдите 5 прекрасных шкур лунопарда и принесите их Терентису в Аубердин.‡Sucht 5 feine Mondpirscherpelze und bringt sie Terenthis in Auberdine.‡고급 달표범 모피 5필을 찾아 아우버다인에 있는 테렌디스에게 가져가야 합니다.‡Encuentra 5 pelambres de Acechalunas refinadas y llévaselas a Terenthis a Auberdine.‡Encuentra 5 pelambres de Acechalunas refinadas y llévaselas a Terenthis a Auberdine.‡Trouver 5 Belles peaux de traquelune et les apporter à Terenthis, à Auberdine.‡收集5张优质月夜猛虎毛皮，把它们交给奥伯丁的特伦希斯。‡收集5張優質月夜猛虎毛皮，把它們交給奧伯丁的特倫希斯。',
  }
},
