[2078] = {
  {
    '‡Месть Гиромачта‡Gyromasts Rache‡‡La venganza de Gyromast‡La venganza de Gyromast‡La vengeance de Gyromast‡基尔卡克的报复‡',
    nil,
    '‡Найдите первого помощника Гелхака, Бешенатора 4100, и отведите его к Гелхаку.‡Sucht Gelkaks Ersten Maat, den Dreschonator 4100, und führt ihn zu Gelkak zurück.‡‡Encuentra el Trillomajareitor 4100, el contramaestre de Gelkak, y condúcelo hasta él.‡Encuentra el Trillomajareitor 4100, el contramaestre de Gelkak, y condúcelo hasta él.‡Trouvez le Second de Gelkak, le Destructomembreur 4100, et ramenez-le à Gelkak.‡找到基尔卡克的大副——机械打手4100型，把他带到基尔卡克那里。‡',
  }
},
[2098] = {
  {
    'Uma mão para Giramastro‡Помощь Гиромачту‡Gyromasts Rettung‡자이로마스트의 수색‡La búsqueda de Gyromast‡La búsqueda de Gyromast‡La recherche de Gyromast‡基尔卡克的钥匙‡基爾卡克的鑰匙復原',
    nil,
    'Encontre e devolva as três partes da Chave de Gelkak para Gelkak Giramastro.‡Отыщите три фрагмента ключа и отнесите их Гелхаку Гиромачту.‡Sucht die drei Stücke von Gelkaks Schlüssel und bringt sie Gelkak Gyromast.‡겔카크의 열쇠 조각 3개를 찾아 겔카크 자이로마스트에게 가져가야 합니다.‡Encuentra y devuelve los tres fragmentos de la llave de Gelkak Gyromast.‡Encuentra y devuelve los tres fragmentos de la llave de Gelkak Gyromast.‡Trouver et rapporter les 3 Morceaux de la clé de Gelkak à Gelkak Gyromast.‡找到基尔卡可钥匙的3段碎片，把它们交给基尔卡克·旋杆。‡找到基爾卡可鑰匙的3段碎片，把它們交給基爾卡克‧旋杆。',
  }
},
[2118] = {
  {
    'Terras pestilentas‡Зачумленные земли‡Verseuchtes Land‡역병에 걸린 땅‡Tierras apestadas‡Tierras apestadas‡Terres malades‡瘟疫蔓延‡瘟疫蔓延',
    nil,
    'Capture um ursocardo raivoso e traga de volta para Tharnariun.|n|nSe não conseguir capturar um ursocardo raivoso e perder a armadilha, fale novamente com Tharnariun Tratárvore e solicite outra.‡Поймайте бешеного колючешерстного медведя отведите его Тарнариуну.|n|nЕсли вам не удастся поймать зверя и вы потеряете ловушку, вернитесь к Тарнариуну Целителю Деревьев и попросите у него еще одну.‡Fangt einen lebenden tollwütigen Distelbären und bringt ihn zu Tharnariun.|n|nSolltet Ihr keinen tollwütigen Distelbären fangen können und Eure Falle verlieren, dann kehrt zu Tharnariun Baumwahrer zurück und bittet um eine neue Falle.‡광포한 엉겅퀴곰을 생포해 타나리운에게 데려가야 합니다.|n|n광포한 엉겅퀴곰을 생포하는 데 실패하고 덫을 잃으면, 타나리운 트리텐더에게 돌아가 다른 덫을 받아야만 합니다.‡Captura un oso cardo rabioso vivo y llévaselo a Tharnariun. |n|nSi no consigues capturar un oso cardo rabioso y pierdes la trampa, pídele otra a Tharnariun Espinarbolado.‡Captura un oso cardo rabioso vivo y llévaselo a Tharnariun. |n|nSi no consigues capturar un oso cardo rabioso y pierdes la trampa, pídele otra a Tharnariun Espinarbolado.‡Capturer vivant un Ours des chardons enragé, puis le ramener à Tharnariun.‡活捉一只狂暴蓟熊，把它带到萨纳瑞恩那里。‡你帶回染病的薊熊了嗎，Bomdiyada?|n|n萬一陷阱失敗了也不用著急─薩納瑞恩的希望是永遠不會破滅的。如果你需要一個新的陷阱，請先放棄你的任務，然後再回來向我報告。',
  }
},
[2138] = {
  {
    'Purificação dos infectados‡Избавление от заразы‡Ausrottung der Infizierten‡병든 엉겅퀴곰 처치‡La limpieza de la infección‡La limpieza de la infección‡Nettoyage de l\'infection‡清除疫病‡清除疫疾',
    nil,
    'Purifique a floresta matando 20 Ursocardos Raivosos e fale novamente com Tharnariun Tratárvore na Costa Negra.‡Очистите лес от 20 бешеных колючешерстных медведей и возвращайтесь к Тарнариуну Исцелителю Деревьев на Темный Берег.‡Befreit den Wald von 20 tollwütigen Distelbären und kehrt dann zu Tharnariun Baumwahrer in Dunkelküste zurück.‡숲에서 광포한 엉겅퀴곰 20마리를 처치한 후 어둠해안에 있는 타나리운 트리텐더에게 가야 합니다.‡Libra al bosque de 20 osos Cardo rabiosos y ve a buscar a Tharnariun Espinarbolado a Costa Oscura.‡Libra al bosque de 20 Osos Cardo rabiosos y ve a buscar a Tharnariun Espinarbolado a Costa Oscura.‡Débarrasser la forêt de 20 Ours des chardons enragés et retourner voir Tharnariun Soigneflore, à Sombrivage.‡到森林里去杀掉20头狂暴蓟熊。‡到森林裡去殺掉20隻狂暴薊熊。',
  }
},
[2139] = {
  {
    'Esperança de Tharnariun‡Надежда Тарнариуна‡Tharnariuns Hoffnung‡타나리운의 희망‡La esperanza de Tharnariun‡La esperanza de Tharnariun‡Espoir de Tharnariun‡萨纳瑞恩的希望‡薩納瑞恩的希望',
    nil,
    'Encontre e mate a Matriarca do Covil.‡Найдите и убейте мать-медведицу.‡Sucht und tötet die Höhlenmutter.‡우두머리 엉겅퀴곰을 찾아서 처치해야 합니다.‡Encuentra a la madre del cubil y mátala.‡Encuentra a la madre del cubil y mátala.‡Trouver et tuer la Mère de la tanière.‡找到雌蓟熊，然后杀掉它。‡找到雌薊熊，然後殺掉它。',
  }
},
[2158] = {
  {
    'Repouso e relaxamento‡Отдых и покой‡Ruhe und Entspannung‡평안과 휴식‡Descanso y relajación‡Descanso y relajación‡Repos et détente‡休息和放松‡休息和放鬆',
    nil,
    'Fale com o Estalajadeiro Fábio na Estalagem do Leão Orgulhoso.‡Побеседуйте с Фарли, хозяином "Гордости льва".‡Sprecht im Gasthaus "Zur Höhle des Löwen" mit Gastwirt Farley.‡사자무리 여관에 있는 여관주인 팔레이와 대화해야 합니다.‡Habla con el tabernero Farley de la Posada Orgullo de León.‡Habla con el tabernero Farley de la Posada Orgullo de León.‡Parler à l\'aubergiste Farley, à l\'auberge de la Fierté du lion.‡和狮王之傲旅店的旅店老板法雷谈一谈。‡和獅王之傲旅店的旅店老闆法雷談話。',
  }
},
[2159] = {
  {
    'Entrega para Dolanaar‡Посылка в Доланаар‡Lieferung für Dolanaar‡돌라나르로의 배달‡Paquete de Dolanaar‡Paquete de Dolanaar‡Livraison à Dolanaar‡多兰纳尔的货物‡多蘭納爾的貨物',
    nil,
    'Leve a Entrega para Dolanaar para o Estalajadeiro Keldamyr.‡Отнесите посылку хозяину таверны Кельдамиру в Доланааре.‡Bringt die Lieferung für Dolanaar zu Gastwirt Keldamyr.‡여관주인 켈다미르에게 돌라나르 배달물을 가져가야 합니다.‡Llévale el paquete de Dolanaar al tabernero Keldamyr.‡Llévale el paquete de Dolanaar al tabernero Keldamyr.‡Apportez la Livraison de Dolanaar à l\'aubergiste Keldamyr.‡把药草送到旅店老板凯达米尔手中。‡把藥草送到旅店老闆凱達米爾手中。',
  }
},
[2160] = {
  {
    'Suprimentos para Tannok‡Припасы для Таннока‡Vorräte für Tannok‡탄노크에게 보급품 전달‡Suministros para Tannok‡Suministros para Tannok‡Des provisions pour Tannok‡塔诺克的补给品‡塔諾克的補給品',
    nil,
    'Entregue um Caixote com Provisões para Estalagem a Tannok Marrãogélido, em Kharanos.‡Отнесите ящик с припасами хозяину таверны Танноку Молоту Стужи в Караносе.‡Bringt die Kiste mit Gasthausvorräten zu Tannok Frosthammer in Kharanos.‡카라노스에 있는 탄노크 프로스트해머에게 여관 보급품 상자를 전해야 합니다.‡Lleva a Kharanos el cajón de suministros del mesón y entrégaselo a Tannok Martilloescarcha.‡Lleva a Kharanos el cajón de suministros del mesón y entrégaselo a Tannok Martilloescarcha.‡Livrer la Caisse de ravitaillement à l\'auberge de Tannok Martel-de-givre à Kharanos.‡给卡拉诺斯的塔诺克·霜锤带去一箱旅店补给品。‡把旅店補給木箱帶給卡拉諾斯的塔諾克·霜錘。',
  }
},
[2161] = {
  {
    'O fardo de um peão‡Ноша батрака‡Die Bürde eines Peons‡일꾼의 짐‡Un cargamento de peón‡Un cargamento de peón‡Un fardeau de péon‡苦工的重担‡苦工的重擔',
    nil,
    'Leve o Fardo de Ulkor para o Estalajadeiro Grosk no Monte Navalha.‡Отнесите сумку Укора хозяину таверны Гроску в Колючий Холм.‡Bringt Ukors Bürde zu Gastwirt Grosk in Klingenhügel.‡칼바위 언덕에 있는 여관주인 그로스크에게 우코르의 짐을 가져가야 합니다.‡Lleva la carga de Ukor al tabernero Grosk a Cerrotajo.‡Lleva la carga de Ukor al tabernero Grosk a Cerrotajo.‡Apportez le Fardeau d\'Ukor à l\'aubergiste Grosk à Tranchecolline.‡把乌克尔的货物交给剃刀岭的旅店老板格罗斯克。‡把烏克爾的貨物帶給剃刀嶺的旅館主人格羅斯克。',
  }
},
[2178] = {
  {
    'Moa a quem moer‡Спокойная жизнь долгоногов‡Schreitereintopf‡간단한 타조 요리‡Guiso de zancudo‡Guiso de zancudo‡Brouet de trotteur‡炖陆行鸟‡燉陸行鳥',
    nil,
    'Leve 5 porções de Carne de Moa para Alanndária Noturcanto, em Auberdine.‡Принесите 5 кусков мяса долгонога Аландариан Песне Ночи в Аубердин.‡Bringt 5 Stücke Schreiterfleisch zu Alanndarian Nachtweise in Auberdine.‡아우버다인에 있는 알란다리안 나이트송에게 타조 고기 5개를 가져가야 합니다.‡Llévale 5 piezas de carne de zancudo a Alanndarian Arrullanoche a Auberdine.‡Llévale 5 piezas de carne de zancudo a Alanndarian Arrullanoche a Auberdine.‡Apporter 5 morceaux de Viande de trotteur à Alanndarian Chantenuit, à Auberdine.‡给急弯河的奥兰达利亚·夜歌带回5块陆行鸟肉。‡給急彎河的奧蘭達利亞‧夜歌帶回5塊陸行鳥肉。',
  }
},
[2198] = {
  {
    'O colar estilhaçado‡Рассыпавшееся ожерелье‡Die zerrissene Halskette‡부서진 목걸이‡El collar hecho añicos‡El collar hecho añicos‡Le collier brisé‡破碎的项链‡破碎的項鍊',
    nil,
    'Procure o criador original do colar estilhaçado para saber sobre seu valor potencial.‡Найдите создателя ожерелья, чтобы узнать, чего оно стоит.‡Sucht nach dem Erschaffer der zerrissenen Halskette, um etwas über ihren möglichen Wert zu erfahren.‡부서진 목걸이의 잠재적 가치를 알아내기 위해 원 제작자를 찾아야 합니다.‡Busca al creador del collar hecho añicos y descubre para qué sirve.‡Busca al creador del collar hecho añicos y descubre para qué sirve.‡Chercher celui qui a fabriqué le Collier brisé pour découvrir sa valeur potentielle.‡找到破碎的项链的来源，从而了解其潜在的价值。‡找到破碎的項鍊的來源，從而瞭解其潛在的價值。',
  }
},
[2199] = {
  {
    'Aí tem truta!‡Мудрость за деньги‡Lehren haben ihren Preis‡정보의 대가‡Esa información tiene un precio‡Esa información tiene un precio‡Le Prix de la Connaissance‡昂贵的知识‡昂貴的知識',
    nil,
    'Leve cinco barras de prata para Didiê Du Mocó em Altaforja.‡Принесите пять серебряных слитков Талвашу дель Кисселю в Стальгорн.‡Bringt fünf Silberbarren zu Talvash del Kissel in Eisenschmiede.‡아이언포지에 있는 탈바쉬 델 키젤에게 은괴 5개를 가져가야 합니다.‡Lleva 5 lingotes de plata a Talvash del Kissel a Forjaz.‡Lleva 5 lingotes de plata a Talvash del Kissel a Forjaz.‡Apporter 5 Barres d\'Argent à Talvash del Kissel, à Forgefer.‡给铁炉堡的塔瓦斯德·基瑟尔带去五块银锭。‡給鐵爐堡的塔瓦斯德·基瑟爾帶去五塊銀錠。',
  }
},
[2200] = {
  {
    'De volta a Uldaman‡Назад в Ульдаман‡Rückkehr nach Uldaman‡울다만으로 돌아가기‡El regreso a Uldaman‡El regreso a Uldaman‡Retour à Uldaman‡回到奥达曼‡回到奧達曼',
    nil,
    'Procure pistas sobre disposição atual do colar de Didiê dentro de Uldaman. O paladino morto que ele mencionou foi a última pessoa a portá-lo.‡Выясните, где именно в Ульдамане находится ожерелье Талваша. Убитый паладин, о котором он упоминал, был последним владельцем этого ожерелья.‡Sucht in Uldaman nach Hinweisen auf den momentanen Zustand von Talvashs Halskette. Der getötete Paladin, den Talvash erwähnte, hatte die Kette zuletzt.‡울다만 안에서 탈바쉬의 목걸이의 행방에 대한 단서를 찾아야 합니다. 탈바쉬가 말했던 성기사가 그 단서를 가진 최후의 인물일 것입니다.‡Busca pistas sobre el paradero del collar de Talvash en Uldaman. Dijo que un paladín muerto fue su último dueño.‡Busca pistas sobre el paradero del collar de Talvash en Uldaman. Dijo que un paladín muerto fue su último dueño.‡Chercher des indices sur le Collier de Talvash à Uldaman. Le paladin dont il a parlé est la dernière personne à l\'avoir porté.‡去奥达曼寻找塔瓦斯的魔法项链，被杀的圣骑士是最后一个拿着它的人。‡去奧達曼尋找塔瓦斯的魔法項鍊，被殺的聖騎士是最後一個拿著它的人。',
  }
},
[2201] = {
  {
    'Encontre as gemas‡Время собирать камни‡Suche nach den Edelsteinen‡보석 찾기‡Encuentra las gemas‡Encuentra las gemas‡Trouver les gemmes‡寻找宝石‡尋找寶石',
    nil,
    'Encontre o rubi, a safira e o topázio que foram espalhados por toda Uldaman. Uma vez adquiridos, entre em contato com Didiê Du Mocó remotamente, usando o Frasco de Vidência que ele lhe deu.|n|nDe acordo com o diário...|n* O rubi está escondido em uma área barricada de Umbraforja.|n* O topázio está escondido numa urna em uma das áreas dos troggs, perto dos anões da Aliança.|n|n* A safira foi reivindicada por Grimlok, o líder dos troggs.‡Найдите рубин, сапфир, и топаз, которые спрятаны в разных местах Ульдамана. Когда найдете, свяжитесь с Талвашем дель Кисселем, используя фиал Видения, который он предоставил.|n|nИз дневника вы узнали следующее:|n*Рубин укрыт в забаррикадированном Тенегорне.|n*Топаз спрятан в урне в одной из областей, занятых троггами, недалеко от расположения дворфов Альянса.|n|n*Сапфир присвоил себе Гримлок, лидер троггов.‡Findet den Rubin, den Saphir und den Topas, die in ganz Uldaman verstreut sind. Wenn Ihr sie habt, wendet Euch aus der Ferne an Talvash del Kissel, indem Ihr die Wahrsagephiole nutzt, die er Euch zuvor gegeben hat.|n|nAus dem Tagebuch, wisst Ihr...|n* Der Rubin wurde in einer Bastion der Zwerge der Schattenschmiede versteckt.|n* Der Topas steckt in einer Urne in einem der Trogggebiete, in der Nähe einiger Zwerge der Allianz.|n|n* Der Saphir wurde von Grimlok, dem Anführer der Troggs, mitgenommen.‡울다만에 흩어져 있는 루비, 사파이어, 토파즈를 찾아야 합니다. 모두 찾으면 탈바쉬가 준 수정점 유리병을 사용하여 그에게 연락해야 합니다.|n|n일지에 의하면... |n*루비는 어둠괴철로 드워프들이 있는 지역에 숨겨져 있습니다.|n*토파즈는 얼라이언스 드워프들이 있는 곳 근처에 트로그 지역에 있는 항아리 중 하나에 숨겨져 있습니다.|n|n*사파이어는 트로그 대장인 그림로크가 가지고 있습니다.‡Encuentra el rubí, el zafiro y el topacio que están desperdigados por Uldaman. Cuando los tengas, contacta con Talvash del Kissel mediante la ampolla de adivinación que él te dio.|n|nA través del diario, sabes que...|n*El rubí está escondido en una zona de Forjatiniebla con barricadas.|n*El topacio permanece oculto en una urna en una de las zonas de los troggs, cerca de algunos enanos de la Alianza.|n|n*El zafiro obra en poder de Grimlok, el líder de los troggs, según él mismo afirma.‡Encuentra el rubí, el zafiro y el topacio que están desperdigados por Uldaman. Cuando los tengas, contacta con Talvash del Kissel mediante la ampolla de adivinación que él te dio.|n|nA través del diario, sabes que...|n*El rubí está escondido en una zona de Forjatiniebla con barricadas.|n*El topacio permanece oculto en una urna en una de las zonas de los troggs, cerca de algunos enanos de la Alianza.|n|n*El zafiro obra en poder de Grimlok, el líder de los troggs, según él mismo afirma.‡Trouvez le rubis, le saphir et la topaze qui sont éparpillés à travers Uldaman. Une fois que vous les aurez, contactez Talvash del Kissel en utilisant la Fiole de divination qu\'il vous a donnée précédemment.|n|nC\'est dans le journal, vous savez...|n* Le rubis a été caché dans une zone barricadée des Ombreforge.|n* La topaze a été dissimulée dans une urne, dans l\'une des zones trogg, pas très loin de nains de Alliance.|n* Le saphir est en possession du chef trogg, Grimelok.‡在奥达曼寻找红宝石、蓝宝石和黄宝石的下落。找到它们之后，通过塔瓦斯德给你的占卜之瓶和他进行联系。‡在奧達曼尋找紅寶石、藍寶石和黃寶石的下落。找到它們之後，通過塔瓦斯德給你的占卜之瓶和他進行聯繫。|n|n從日記上的線索來看，你可以知道…|n*紅寶石被存放的地方有一群暗爐矮人看守著。|n*黃寶石被藏匿在穴居怪住所的一個甕裡，那附近有一些聯盟矮人。|n|n*穴居怪的領袖格瑞姆洛克已經把藍寶石占為己有。',
  }
},
[2202] = {
  {
    'Busca pelos reagentes de Uldaman‡В Ульдаман за реактивом‡Reagenzsuche in Uldaman‡울다만에서 재료 찾기‡Componentes de Uldaman‡Componentes de Uldaman‡Rechercher les composants à Uldaman‡奥达曼的蘑菇‡奧達曼的蘑菇',
    nil,
    'Leve 12 Campânulas de Fungo Magenta para Jarkal Limuno em Karrath.‡Принести 12 грибов-малиновиков Джаркалу Замшелому Клыку в Каргат.‡Bringt 12 Magentafunguskappen nach Kargath zu Jarkal Moosblut.‡카르가스에 있는 자칼 모스멜드에게 자홍버섯 12개를 가져가야 합니다.‡Llévale 12 setas magenta a Jarkal Musgofusión en Kargath.‡Llévale 12 setas magenta a Jarkal Musgofusión en Kargath.‡Apporter 12 Champignons magenta à Jarkal Fondemousse à Kargath.‡收集12颗紫色蘑菇，把它们交给卡加斯的加卡尔。‡收集12顆紫色蘑菇，把它們交給卡加斯的加卡爾。',
  }
},
[2203] = {
  {
    '‡Пробежка по Бесплодным землям-2‡Reagenziensuche im Ödland II‡황야의 땅에서 재료 찾기 II‡Componentes de Tierras Inhóspitas II‡Componentes de Tierras Inhóspitas II‡Les réactifs des Terres ingrates II‡荒芜之地的材料 II‡',
    nil,
    '‡Наполните пустые волшебные сосуды кровью опаленных драконов-стражей в Бесплодных землях и принесите их Джаркалу Замшелому Клыку в Каргат.‡Benutzt die leeren thaumaturgischen Gefäße bei versengten Wächtergroßdrachen im Ödland. Wenn Ihr sie gefüllt habt, bringt sie zu Jarkal Moosblut in Kargath.‡‡Usa las vasijas de taumaturgia vacías con los dragones guardianes agostados de las Tierras Inhóspitas. Cuando las hayas llenado, llévaselas a Jarkal Musgofusión en Kargath.‡Usa las vasijas de taumaturgia vacías con los dragones guardianes agostados de las Tierras Inhóspitas. Cuando las hayas llenado, llévaselas a Jarkal Musgofusión en Kargath.‡Utiliser les 3 Récipients thaumaturgiques vides sur des dragons gardiens des terres brûlées dans les Terres ingrates. Une fois remplis, les rapporter à Jarkal Fondemousse à Kargath.‡用空的魔瓶吸收荒芜之地的烈焰守护者的血液。装满所有瓶子之后，把它们交给卡加斯的加卡尔。‡',
  }
},
[2204] = {
  {
    'Restaurando o colar‡Восстановление ожерелье‡Restaurierung der Halskette‡목걸이 복원‡Restaurar el collar‡Restaurar el collar‡Réparer le collier‡修复项链‡修復項鍊',
    nil,
    'Obtenha uma fonte de energia do constructo mais poderoso que você encontrar em Uldaman e entregue-a a Didiê Du Mocó em Altaforja.‡Добудьте источник энергии из самого мощного волшебного создания, которое найдете в Ульдамане и доставьте его Талвашу дель Кисселю в Стальгорн.‡Besorgt Euch eine Kraftquelle vom mächtigsten Konstrukt, das Ihr in Uldaman finden könnt, und liefert sie bei Talvash del Kissel in Eisenschmiede ab.‡울다만에서 가장 강력한 피조물을 찾아 부서진 목걸이의 마력원천을 획득한 다음, 아이언포지에 있는 탈바쉬 델 키젤에게 목걸이와 함께 가져가야 합니다.‡Obtén una fuente de energía del ensamblaje más poderoso que encuentres en Uldaman, y entrégasela a Talvash del Kissel en Forjaz.‡Obtén una fuente de energía del ensamblaje más poderoso que encuentres en Uldaman, y entrégasela a Talvash del Kissel en Forjaz.‡Obtenir une Source d\'énergie de la construction la plus puissante que vous pouvez trouver à Uldaman, puis la remettre à Talvash del Kissel à Forgefer.‡从奥达曼最强大的石人身上获得能量源，然后将其交给铁炉堡的塔瓦斯德。‡從奧達曼最強大的石人身上獲得能量源，然後將其交給鐵爐堡的塔瓦斯德。',
  }
},
[2205] = {
  {
    'Em busca da AVIN‡Выход на ШРУ‡Aufsuchen des SI: 7‡SI: 7 찾기‡Busca el IV:7‡Busca el IV:7‡Chercher le SI:7‡军情七处‡尋找軍情七處',
    nil,
    'Entregue o pacote de Anabela Cabreira para o mestre Mathias Shaw nos Quartel de Ventobravo.‡Доставьте пакет от Керина Сильвиуса мастеру Матиасу Шоу в казармы Штормграда.‡Liefert Keryn Sylvius\' Päckchen an Meister Mathias Shaw in der Kaserne von Sturmwind.‡스톰윈드 병영에 있는 단장 마티아스 쇼에게 소포를 가져가야 합니다.‡Entrega el paquete de Keryn Sylvius al maestro Mathias Shaw que está en el Cuartel de Ventormenta.‡Entrega el paquete de Keryn Sylvius al maestro Mathias Shaw que está en el Cuartel de Ventormenta.‡Remettre le colis de Keryn Sylvius à maître Mathias Shaw à la Caserne de Hurlevent.‡把科瑞恩·塞尔留斯的包裹带给暴风城兵营的马迪亚斯·肖尔。‡把科瑞恩·塞爾留斯的包裹帶給暴風城兵營的馬迪亞斯·肖爾。',
  }
},
[2206] = {
  {
    'O punguista‡Держи-хватай!‡Schneller Eingriff‡선적 일정 입수‡El robo‡El robo‡Effraction‡连偷带抢‡連偷帶搶',
    nil,
    'Encontre o Mestre de Doca, pegue o Horário de Embarque e entregue-o para o Mestre Mathias Shaw.‡Найдите портового начальника и добудьте расписание поставок для мастера Матиаса Шоу.‡Sucht den Dockmeister der Defias und beschafft den Lieferzeitplan für Meister Mathias Shaw.‡부두주임에게서 선적 일정표를 입수해 단장 마티아스 쇼에게 가져가야 합니다.‡Encuentra al maestro de embarcadero y recupera el calendario de envíos para el maestro Mathias Shaw.|n‡Encuentra al maestro de embarcadero y recupera el calendario de envíos para el maestro Mathias Shaw.|n‡Trouver l\'Intendant des docks et récupérer le Programme d\'embarquement, pour le compte de maître Mathias Shaw.‡找到码头主管，从他那里为马迪亚斯·肖尔拿到迪菲亚船运时间表。‡找到碼頭主管，為馬迪亞斯·肖爾拿到船運時間表。',
  }
},
[2218] = {
  {
    'Estrada para a salvação‡Путь к спасению‡Straße der Rettung‡구원의 길‡El camino hacia la salvación‡El camino hacia la salvación‡La voie du salut‡救赎之路‡救贖之路',
    nil,
    'Fale com Hulfdan Barbanegra em Altaforja.‡Поговорите с Хальфданом Чернобородом в Стальгорне.‡Sprecht mit Hulfdan Schwarzbart in Eisenschmiede.‡아이언포지에 있는 훌프단 블랙비어드와 대화해야 합니다.‡Ve a Forjaz y habla con Hulfdan Barbanegra.‡Ve a Forjaz y habla con Hulfdan Barbanegra.‡Parler à Hulfdan Barbe-noire à Forgefer.‡和铁炉堡的霍夫丹·黑须谈一谈。‡和鐵爐堡的霍夫丹·黑鬚談話。',
  }
},
[2238] = {
  {
    'Simples subterfúgio‡Простая уловка‡Einfache List‡순진한 핑계‡Un simple subterfugio‡Un simple subterfugio‡Simple subterfuge‡国王的财宝‡國王的財寶',
    nil,
    'Encontre Onin MacHammar em Gnomeregan.‡Найдите Онина Макмолота возле Гномрегана.‡Sucht Onin MacHammar bei Gnomeregan.‡놈리건에서 오닌 맥해머를 찾아야 합니다.‡Encuentra a Onin MacHammar cerca de Gnomeregan.‡Encuentra a Onin MacHammar cerca de Gnomeregan.‡Trouver Onin MacHammar à Gnomeregan.‡在诺莫瑞根附近找到奥宁·雨锤。‡在諾姆瑞根附近找到奧寧·雨錘。',
  }
},
[2239] = {
  {
    'Relatório de Onin‡Донесение Онина‡Onins Bericht‡오닌의 보고서‡El informe de Onin‡El informe de Onin‡Rapport d\'Onin‡奥宁的报告‡奧寧的報告',
    nil,
    'Leve o relatório de Onin para Hulfdan em Altaforja.‡Доставьте донесение Онина Хальфдану в Стальгорн.‡Bringt Onins Bericht zu Hulfdan in Eisenschmiede.‡아이언포지에 있는 훌프단에게 오닌의 보고서를 가져가야 합니다.‡Lleva el informe de Onin a Hulfdan a Forjaz.‡Lleva el informe de Onin a Hulfdan a Forjaz.‡Porter le rapport d\'Onin à Hulfdan à Forgefer.‡把奥宁的报告交给铁炉堡的霍夫丹。‡把奧寧的報告交給鐵爐堡的霍夫丹。',
  }
},
[2240] = {
  {
    'A câmara oculta‡Потайной чертог‡Die geheime Kammer‡비밀 석실‡La cámara oculta‡La cámara oculta‡La chambre secrète‡密室‡密室',
    nil,
    'Leia o Diário de Baelog, explore a câmara oculta, depois fale com o Prospector Lançatroz.‡Прочитайте журнал Балеога, исследуйте, потайной чертог и потом доложите об увиденном геологу Грозовой Вершине.‡Lest Baelogs Tagebuch, erforscht die geheime Kammer und erstattet dann Ausgrabungsleiter Sturmlanze Bericht.‡밸로그의 일지를 읽고 비밀 석실을 조사한 후 발굴조사단장 스톰파이크에게 보고해야 합니다.‡Lee el diario de Baelog, inspecciona la cámara oculta y ve a informar al prospector Pico Tormenta.‡Lee el diario de Baelog, inspecciona la cámara oculta y ve a informar al prospector Pico Tormenta.‡Lire le journal de Baelog, explorer la Chambre secrète, puis rendre compte au Prospecteur Foudrepique.‡阅读巴尔洛戈的日记，探索密室，然后向铁炉堡的勘察员塔伯斯·雷矛汇报。‡閱讀巴爾洛戈的日記，探索密室，然後向鐵爐堡的勘察員塔伯斯·雷矛彙報。',
  }
},
[2241] = {
  {
    'Amor só dura em liberdade‡Катись, яблочко...‡Der Apfel fällt‡짝사랑‡Cuando cae la manzana‡Cuando cae la manzana‡Pomme d\'amour‡詹诺克的花‡詹諾克的花',
    nil,
    'Leve a flor de Jannok para Syurna em Darnassus.‡Отнесите розу Джаннока Сиарне в Дарнас.‡Bringt Jannoks Rose zu Syurna in Darnassus.‡다르나서스에 있는 시우르나에게 잔노크의 장미를 가져가야 합니다.‡Llévale la rosa de Jannok a Syurna, que está en Darnassus.‡Llévale la rosa de Jannok a Syurna, que está en Darnassus.‡Porter la Rose de Jannok à Syurna à Darnassus.‡把詹诺克的玫瑰带给达纳苏斯的塞尤娜。‡把詹諾克的玫瑰帶給達納蘇斯的塞尤娜。',
  }
},
[2242] = {
  {
    'O destino chama‡Зов судьбы‡Das Schicksal ruft‡운명의 부름‡La llamada del destino‡La llamada del destino‡L\'appel du destin‡命运的召唤‡',
    nil,
    'Encontre Sethir, o Antigo, e leve qualquer pista a respeito de Syurna.|n‡Найдите Сетира Древнего и принесите все, что сумеете найти, Сиарне.‡Sucht Sethir den Uralten und bringt alle Hinweise, die Ihr finden könnt, zu Syurna.‡고대정령 세시르를 찾아 시우르나에게 가져갈 만한 어떤 단서든지 찾아와야 합니다.‡Encuentra a Sethir el Ancestro y ve a contarle todo lo que descubras a Syurna.|n‡Encuentra a Sethir el Ancestro y ve a contarle todo lo que descubras a Syurna.|n‡Trouver Sethir l\'Ancien et rapporter tout indice découvert à Syurna.‡找到远古的塞希尔，带回任何你可能发现的线索。‡',
  }
},
[2258] = {
  {
    'Busca pelos reagentes dos Ermos‡Пробежка по Бесплодным землям‡Reagenziensuche im Ödland‡황야의 땅에서 재료 찾기‡Componentes de Tierras Inhóspitas‡Componentes de Tierras Inhóspitas‡Les réactifs des Terres ingrates‡荒芜之地的试剂‡荒蕪之地的試劑',
    nil,
    'Leve 5 Moelas de Urubu, 10 Presas de Coiote do Rochedo e 5 Estilhaços de Elemental da Rocha para Jarkal Limuno em Karrath, Ermos.‡Принесите 5 вторых желудков канюка, 10 клыков скального койота и 5 осколков каменных элементалей Джаркалу Смешанному Лишайнику в Каргат.‡Bringt Jarkal Moosblut in Kargath im Ödland 5 Bussardmuskelmägen, 10 Klippenkojotenfangzähne und 5 Felselementarsplitter.‡황야의 땅에서 자칼 모스멜드에게 대머리수리 모래주머니 5개, 바위산코요테 송곳니 10개, 바위 정령 파편 5개를 가져가야 합니다.‡Llévale 5 mollejas de águila ratonera, 10 colmillos de coyote del risco y 5 fragmentos de elemental de roca a Jarkal Musgofusión en Kargath, en las Tierras Inhóspitas.‡Llévale 5 mollejas de águila ratonera, 10 colmillos de coyote del risco y 5 fragmentos de elemental de roca a Jarkal Musgofusión en Kargath, en las Tierras Inhóspitas.‡Apporter 5 Gésiers de busard, 10 Crocs de coyote des rochers et 5 Fragments d\'élémentaire de roche à Jarkal Fondemousse, à Kargath, dans les Terres ingrates.‡前往荒芜之地取回加卡尔需要的试剂，然后回到卡加斯把试剂交给他。‡將5個禿鷲的胃囊，10顆峭壁山狗的牙齒，還有5個石元素的裂片交給荒蕪之地，卡加斯的加卡爾。',
  }
},
[2259] = {
  {
    '‡Эрион Шепот Тени‡Erion Schattenflüsterer‡에리온 셰이드위스퍼‡Erion Sombrusurro‡Erion Sombrusurro‡Erion Murmombre‡艾瑞安·影语‡艾里安·影語',
    nil,
    '‡Встретьтесь в Дарнасе с Эрионом Шепотом Тени.‡Kontaktiert Erion Schattenflüsterer in Darnassus.‡‡Localiza a Erion Sombrusurro en Darnassus.|n‡Localiza a Erion Sombrusurro en Darnassus.|n‡Contacter Erion Murmombre à Darnassus.‡与达那苏斯的艾瑞安·影语取得联系。‡',
  }
},
[2260] = {
  {
    '‡Директива Эриона‡Erions Befehl‡‡La orden de Erion‡La orden de Erion‡L\'ordre d\'Erion‡艾瑞安的命令‡',
    nil,
    '‡Отправляйтесь в Штормград и посоветуйтесь с Рензиком Ножом.‡Reist nach Sturmwind und meldet Euch bei Renzik "Das Messer".‡‡Viaja a la Ciudad de Ventormenta y habla con Renzik "Chafarote".‡Viaja a la Ciudad de Ventormenta y habla con Renzik "Chafarote".‡Voyager vers Hurlevent pour y demander conseil à Renzik « le Kriss ».‡到暴风城去找到“剃刀”雷吉克。‡',
  }
},
[2278] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Fale com o vigia de pedra e descubra quais são os segredos da história antiga que ele guarda. Após aprender os segredos históricos, ative os Discos de Norgannon.‡Поговорите с каменным стражем и запомните все, что он расскажем вам. Когда он закончит свой пересказ событий древности, активируйте диски Норганнона.‡Sprecht mit dem Steinbehüter und findet heraus, welche uralten Lehren er aufbewahrt. Sobald Ihr alles erfahren habt, was er weiß, aktiviert die Scheiben von Norgannon.‡바위감시자와 대화하고 그가 알고 있는 고대의 지식을 배워야 합니다. 지식을 배운 후에는 노르간논의 원반을 가동해야 합니다.‡Habla con el vigía de piedra y descubre qué conocimiento antiguo alberga. Cuando hayas adquirido el conocimiento que te ofrece, activa los Discos de Norgannon.‡Habla con el vigía de piedra y descubre qué conocimiento antiguo alberga. Cuando hayas adquirido el conocimiento que te ofrece, activa los Discos de Norgannon.‡Parlez au Gardien des pierres pour connaître le Savoir qu\'il défend. Une fois découvert ce qu\'ils peuvent offrir, activez les Disques de Norgannon.‡和石头守护者交谈，从他那里了解更多古代的知识。一旦你了解到了所有的内容之后就激活诺甘农圆盘。‡和石之看守者者交談，從他那裡瞭解更多古代的知識。一旦你瞭解到了所有的內容之後就啟動諾甘農圓盤。',
  }
},
[2279] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve a versão em miniatura dos Discos de Norgannon para a Liga dos Exploradores em Altaforja.‡Отнесите миниатюрную копию дисков Норганнона в Лигу исследователей в Стальгорне.‡Bringt die Miniaturausgabe der Scheiben von Norgannon zur Forscherliga nach Eisenschmiede.‡아이언포지에 있는 탐험가 연맹에 노르간논의 소형 백금 원반을 가져가야 합니다.‡Lleva la reproducción en miniatura de los Discos de Norgannon a la Liga de Expedicionarios de Forjaz.‡Lleva la reproducción en miniatura de los Discos de Norgannon a la Liga de Expedicionarios de Forjaz.‡Apporter la version miniature des Disques de Norgannon à la Ligue des Explorateurs à Forgefer.‡把迷你版的诺甘农圆盘带到铁炉堡的探险者协会去。‡把迷你版的諾甘農圓盤帶到鐵爐堡的探險者協會去。',
  }
},
[2280] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve a versão em miniatura dos Discos de Norgannon para alguém que tenha grande interesse por eles.‡Отнесите миниатюрную копию дисков Норганнона тому, кому это будет весьма интересно.‡Bringt die Miniaturausgabe der Scheiben von Norgannon zu jemandem, der sich brennend dafür interessiert.‡원반에 매우 관심이 있는 누군가에게 노르간논의 소형 원반을 가져가야 합니다.‡Lleva la reproducción en miniatura de los Discos de Norgannon a alguien que esté muy interesado.‡Lleva la reproducción en miniatura de los Discos de Norgannon a alguien que esté muy interesado.‡Apporter la version miniature des Disques de Norgannon à une personne qui serait très intéressée par cet objet.‡把迷你版的诺甘农圆盘交给雷霆崖的某位对它感兴趣的人手中。‡把迷你版的諾甘農圓盤帶給某個對它們很有興趣的人。',
  }
},
[2281] = {
  {
    'Encontro em Cristarrubra‡Встречи в Красногорье‡Rendezvous im Rotkammgebirge‡붉은마루 집결‡Cita en Crestagrana‡Cita en Crestagrana‡Le Rendez-vous des Carmines‡赤脊山的联络员‡赤脊山的聯絡員',
    nil,
    'Venture forth to Lakeshire in the Redridge Mountains and speak with Lucius.‡Пойдите к Приозерью в Красногорье и поговорите с Люцием.‡Geht nach Seenhain im Rotkammgebirge und sprecht mit Lucius.‡붉은마루 산맥의 호숫골로 가서 루시우스와 대화해야 합니다.‡Adéntrate en Villa del Lago, en las Montañas Crestagrana, y habla con Lucius.‡Adéntrate en Villa del Lago, en las Montañas Crestagrana, y habla con Lucius.‡S\'aventurer vers Comté-du-Lac dans les Carmines et parler à Lucius.‡到赤脊山的湖畔镇去和卢修斯谈一谈。‡到赤脊山的湖畔鎮與盧修斯交談。',
  }
},
[2282] = {
  {
    'Serraria Alther‡Лесопилка Альтера‡Althers Mühle‡앨더의 제재소‡Molino de Alther‡Molino de Alther‡La scierie d\'Alther‡奥瑟尔伐木场‡奧瑟爾伐木場',
    nil,
    'Abra o Baú do Lucius, recupere o Símbolo de Ladroagem e devolva-o ao Lucius na Vila Plácida.‡Откройте сундук Люция, достаньте руну воровства и вернитесь к Люцию в Приозерье.‡Öffnet Lucius\' Schließkassette, nehmt die Marke der Diebeskunst heraus und bringt sie zu Lucius nach Seenhain.‡루시우스의 금고를 열고 도적의 징표를 회수한 다음 호숫골에 있는 루시우스에게 가져가야 합니다.‡Abre el arcón de Lucius y llévale la muestra de robo a Villa del Lago.‡Abre la caja fuerte de Lucius y llévale la muestra de robo a Villa del Lago.‡Ouvrez le Coffret de Lucius, récupérez le Gage de voleur et rapportez-le à Lucius, à Comté-du-Lac.‡打开卢修斯的箱子，拿到收集技能证明物，然后把它归还给湖畔镇的卢修斯。‡打開盧修斯的帶鎖箱，拿到偷竊技能證明物，然後把它歸還給湖畔鎮的盧修斯。',
  }
},
[2283] = {
  {
    'O resgate do colar‡Пропавшее ожерелье‡Wiederbeschaffung der Halskette‡목걸이 회수‡La recuperación del collar‡La recuperación del collar‡Réparer le Collier‡搜寻项链‡搜尋項鍊',
    nil,
    'Procure um colar valioso na escavação de Uldaman e leve-o para Dran Droffers em Orgrimmar. O colar pode estar danificado.‡Найдите на раскопках Ульдамана драгоценное ожерелье (возможно, поврежденное) и принесите его в Оргриммар Драну Дрофферсу.‡Sucht in der Grabungsstätte von Uldaman nach einer wertvollen Halskette und bringt sie nach Orgrimmar zu Dran Droffers. Die Halskette ist vielleicht beschädigt.‡울다만 발굴현장에서 값진 목걸이를 찾아 오그리마에 있는 드란 드로퍼스에게 가져가야 합니다. 목걸이는 파손된 것이라도 괜찮습니다.‡Busca el collar en la excavación de Uldaman y llévaselo a Dran Droffers a Orgrimmar. Puede que el collar esté estropeado.‡Busca el collar en la excavación de Uldaman y llévaselo a Dran Droffers a Orgrimmar. Puede que el collar esté estropeado.‡Rechercher dans l\'excavation d\'Uldaman un Collier de prix et le rapporter à Dran Droffers à Orgrimmar. Ce Collier peut être endommagé.‡在奥达曼挖掘场中寻找一条珍贵的项链，然后将其交给奥格瑞玛的德兰·杜佛斯。项链有可能已经损坏。‡在奧達曼挖掘場中尋找一條珍貴的項鍊，然後將其交給奧格瑪的德蘭·杜佛斯。項鍊有可能已經損壞。',
  }
},
[2284] = {
  {
    'O resgate do colar 2 – A missão‡Пропавшее ожерелье, этап 2‡Wiederbeschaffung der Halskette, Teil 2‡목걸이 회수 - 2차 시도‡La recuperación del collar, 2ª parte‡La recuperación del collar, 2ª parte‡Réparer le Collier, deuxième prise‡搜寻项链，再来一次‡搜尋項鍊，再來一次',
    nil,
    'Encontre uma pista do paradeiro das gemas nas profundezas de Uldaman.‡Разыщите ключ к местонахождению самоцветов в глубинах Ульдамана.‡Sucht in den Tiefen von Uldaman nach einem Hinweis auf den Verbleib der Edelsteine.‡울다만 깊은 곳에서 보석의 행방에 대한 단서를 찾아야 합니다.‡Busca pistas sobre el paradero de las gemas en las profundidades de Uldaman.‡Busca pistas sobre el paradero de las gemas en las profundidades de Uldaman.‡Trouver, dans les profondeurs d\'Uldaman, des indices sur la localisation des Gemmes.‡在奥达曼里找寻宝石的线索。‡在奧達曼裡找尋寶石的線索。',
  }
},
[2298] = {
  {
    'Aperto régio‡Королевская облава‡Königliche Erpressung‡왕의 철저한 수색‡Una regia sacudida‡Una regia sacudida‡Extorsion royale‡国王的搜查‡國王的搜查',
    nil,
    'Viaje para Ventobravo e procure Renzik, "O Bicudo".‡Отправляйтесь в Штормград и найдите Рензика Ножа.‡Reist nach Sturmwind und sucht Renzik "Das Messer" auf.‡스톰윈드로 가서 칼잡이 렌직을 찾아야 합니다.‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Aller à Hurlevent et chercher Renzik « le Kriss ».‡到暴风城里去找到"剃刀"雷吉克。‡到暴風城去找到『剃刃』雷吉克。',
  }
},
[2299] = {
  {
    'Ao Hulfdan!‡К Хальфдану!‡Auf Hulfdan!‡훌프단에게로!‡¡Ve a hablar con Hulfdan!‡¡Ve a hablar con Hulfdan!‡Cap sur Hulfdan !‡去找霍夫丹！‡',
    nil,
    'Vá até Altaforja e fale com Hulfdan Barbanegra.‡Отправляйтесь в Стальгорн и поговорите с Хальфданом Чернобородом.‡Reist nach Eisenschmiede und sprecht mit Hulfdan Schwarzbart.‡아이언포지로 가서 훌프단 블랙비어드와 대화해야 합니다.‡Viaja a Forjaz y habla con Hulfdan Barbanegra.‡Viaja a Forjaz y habla con Hulfdan Barbanegra.‡Se rendre à Forgefer et parler à Hulfdan Barbe-noire.‡到铁炉堡去和霍夫丹·黑须谈一谈。‡',
  }
},
[2300] = {
  {
    nil,
    nil,
    '‡Отправляйтесь в Штормград и разыщите Рензика Ножа.‡Reist nach Sturmwind und sucht Renzik "Das Messer" auf.‡‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Allez à Hurlevent et cherchez Renzik « le Kriss ».‡到暴风城去找到“剃刀”雷吉克。‡',
  }
},
[2318] = {
  {
    'Traduzindo o diário‡Трудности перевода‡Übersetzung des Tagebuchs‡일지 번역‡La traducción del diario‡La traducción del diario‡La traduction du Journal‡翻译日记‡翻譯日記',
    nil,
    'Encontre alguém que consiga traduzir o diário do paladino. O local mais próximo que pode ter alguém que o faça é Karrath, nos Ermos.‡Найдите кого-нибудь, кто сможет перевести для вас дневник паладина. Ближайший к вам такой умелец, скорее всего, найдется в Каргате, форпосте в Бесплодных землях.‡Sucht jemanden, der das Tagebuch des Paladins übersetzen kann. Der nächstgelegene Ort, wo Ihr so jemanden finden könntet, ist Kargath im Ödland.‡성기사의 일지를 번역할 수 있는 이를 찾아야 합니다. 그런 자가 있을만한 가장 가까운 곳은 황야의 땅에 있는 카르가스입니다.‡Encuentra a alguien que pueda traducir el diario del paladín. El lugar más cercano en el que podrás encontrar a alguien es Kargath, en las Tierras Inhóspitas.‡Encuentra a alguien que pueda traducir el diario del paladín. El lugar más cercano en el que podrás encontrar a alguien es Kargath, en las Tierras Inhóspitas.‡Trouver quelqu\'un qui puisse traduire le journal du paladin. L\'endroit le plus proche est Kargath, dans les Terres ingrates.‡在荒芜之地的卡加斯哨所里寻找一个可以帮你翻译圣骑士日记的人。‡在荒蕪之地的卡加斯哨所裡尋找一個可以幫你翻譯聖騎士日記的人。',
  }
},
[2338] = {
  {
    '‡Трудности перевода‡Übersetzung des Tagebuchs‡‡La traducción del diario‡La traducción del diario‡La traduction du Journal‡翻译日记‡',
    nil,
    '‡Одолжите ожерелье Джаркалу. Взамен он переведет дневник.‡Leiht Jarkal die Halskette. Im Gegenzug wird er das Tagebuch für Euch übersetzen.‡‡Préstale el collar a Jarkal. A cambio, te traducirá el diario.‡Préstale el collar a Jarkal. A cambio, te traducirá el diario.‡Laisser Jarkal emprunter le Collier en échange de la traduction du Journal.‡将项链借给加卡尔。作为交换，他将帮你翻译日记。‡',
  }
},
[2339] = {
  {
    'Encontre as Gemas e a Fonte de Energia‡Найти самоцветы и источник энергии‡Findet die Edelsteine und die Kraftquelle‡보석과 마력원천 찾기‡Encuentra las gemas y la fuente de alimentación‡Encuentra las gemas y la fuente de alimentación‡Trouver les gemmes et la source d\'énergie‡寻找宝贝‡尋找寶貝',
    nil,
    'Recupere todas as três gemas e uma fonte de energia para o colar de Uldaman e leve-as para Jarkal Limuno, em Karrath. Jarkal acredita que uma fonte de energia pode ser encontrada no constructo mais forte presente em Uldaman.|n|nDe acordo com o diário:|n* O rubi está escondido em uma área de Umbraforja protegida por barreiras.|n* O topázio está escondido numa urna em uma das áreas dos troggs, perto de alguns anões da Aliança.|n* A safira foi reclamada por Grimlok, o líder dos troggs.‡Добудьте все три самоцвета и источник энергии для ожерелья из Ульдамана и принесите их Джаркалу Замшелому Клыку в Каргат. Джаркал считает, что источник энергии можно найти у самой сильной твари в Ульдамане. |n|nИз дневника следует... |n* Рубин спрятан на огражденной завалами территории Тенегорна. |n*Топаз спрятан в урне на территорях троггов под боком у дворфов Альянса.|n*Сапфир забрал Гримлок, старейшина троггов.‡Beschafft in Uldaman alle drei Edelsteine sowie eine Kraftquelle für die Halskette und bringt sie anschließend zu Jarkal Moosblut nach Kargath. Jarkal glaubt, dass sich eine Kraftquelle vielleicht im stärksten Konstrukt in Uldaman findet.|n|nAus dem Tagebuch, wisst Ihr...|n* Der Rubin wurde in einer Bastion der Zwerge der Schattenschmiede versteckt.|n* Der Topas steckt in einer Urne in einem der Trogggebiete, in der Nähe einiger Zwerge der Allianz.|n* Der Saphir wurde von Grimlok, dem Anführer der Troggs, mitgenommen.‡울다만에서 목걸이에 필요한 보석 3개와 마력원천을 회수한 후 카르가스에 있는 자칼 모스멜드에게 가져가야 합니다. 자칼의 말에 의하면 울다만에서 가장 강한 피조물을 처치하면 마력원천을 얻을 수 있다고 합니다.|n|n일지의 내용을 보니 루비는 어둠괴철로 방어진에 숨겨져 있습니다.|n|n토파즈는 얼라이언스 드워프 근처에 있는 트로그 구역 중 하나에 있는 항아리에 숨겨져 있습니다.|n|n사파이어는 트로그의 우두머리인 그림로크가 가지고 있습니다.|n|n마력원천은 울다만에서 가장 강한 피조물을 처치하면 얻을 수 있습니다.‡Recupera las 3 gemas y una fuente de energía para el collar de Uldaman y llévalo todo a Jarkal Musgofusión en Kargath. Jarkal cree que es posible que la fuente de energía más poderosa se halle en un ensamblaje de Uldaman.|n|nPor el diario sabes...|n* Que han ocultado el rubí en una zona cerrada con barricadas en Forjatiniebla.|n* Que el topacio se ha ocultado en una urna en un área trogg, cerca de los enanos de la Alianza.|n* Que Grimlok, el jefe trogg, se ha quedado con el zafiro.‡Recupera las 3 gemas y una fuente de energía para el collar de Uldaman y llévalo todo a Jarkal Musgofusión en Kargath. Jarkal cree que es posible que la fuente de energía más poderosa se halle en un ensamblaje de Uldaman.|n|nPor el diario sabes...|n* Que han ocultado el rubí en una zona cerrada con barricadas en Forjatiniebla.|n* Que el topacio se ha ocultado en una urna en un área trogg, cerca de los enanos de la Alianza.|n* Que Grimlok, el jefe trogg, se ha quedado con el zafiro.‡Récupérer, dans Uldaman, les trois gemmes et une source d\'énergie pour le collier, puis les rapporter à Jarkal Fondemousse, à Kargath. Jarkal pense que vous pouvez trouver une source d\'énergie sur la machine la plus puissante d\'Uldaman.|n|nC\'est dans le journal, vous savez...|n* Le rubis a été caché dans une zone barricadée des Ombreforge.|n* La topaze a été dissimulée dans une urne, dans l\'une des zones trogg, pas très loin de nains de Alliance.|n* Le saphir est possession du chef trogg, Grimelok.‡从奥达曼找回项链上的所有三块宝石和能量源，然后把它们交给卡加斯的加卡尔。|n|n红宝石被藏在暗影矮人层层设防的地区。|n|n黄宝石藏在穴居人活动地区的一个瓮中。|n|n蓝宝石在格瑞姆洛克手中，他是穴居人的领袖。|n|n能量源可能在奥达曼的某个最强生物的手中。‡從奧達曼找回項鍊上的所有三塊寶石和能量源，然後把它們交給卡加斯的加卡爾。|n|n紅寶石被藏在暗影矮人層層設防的地區。|n|n黃寶石藏在穴居怪活動地區的一個甕中。|n|n藍寶石在格瑞姆洛克手中，他是穴居怪的領袖。|n|n能量源可能在奧達曼的某個最強生物的手中。',
  }
},
[2340] = {
  {
    '‡Принести самоцветы‡Ablieferung der Edelsteine‡‡Entregar las gemas‡Entregar las gemas‡Livrer les Gemmes‡交付宝石‡',
    nil,
    '‡Доставьте ожерелье и драгоценности Драну Дрофферсу в Оргриммар.‡Liefert die Halskette und die geborgenen Edelsteine bei Dran Droffers in Orgrimmar ab.‡‡Entrégale el collar y la gema recuperados a Dran Droffers en Orgrimmar.‡Entrégale el collar y la gema recuperados a Dran Droffers en Orgrimmar.‡Apporter les Gemmes et le Collier récupérés à Dran Droffers, à Orgrimmar.‡把项链和宝石送到奥格瑞玛的德兰·杜佛斯那里。‡',
  }
},
[2341] = {
  {
    '‡Пропавшее ожерелье, этап 3‡Wiederbeschaffung der Halskette, Teil 3‡‡La recuperación del collar, 3ª parte‡La recuperación del collar, 3ª parte‡Réparer le collier, troisième prise‡项链任务的终结 (地下城)‡',
    nil,
    '‡Навестите Джаркала Замшелого Клыка в Каргате.‡Besucht Jarkal Moosblut in Kargath, um festzustellen, ob er Erfolg gehabt hat.‡‡Habla con Jarkal Musgofusión en Kargath.‡Habla con Jarkal Musgofusión en Kargath.‡Rendre visite à Jarkal Fondemousse à Kargath pour constater (ou non) son succès.‡去卡加斯看看加卡尔是否成功了。‡',
  }
},
[2342] = {
  {
    'Tesouros recuperados‡Возвращенные сокровища‡Wiederbeschaffte Schätze‡보물 되찾기‡Los tesoros reclamados‡Los tesoros reclamados‡Des Trésors à recouvrer‡寻找宝物‡尋回寶物',
    nil,
    'Pegue o tesouro de Patrício Garreta no baú de sua família, que está no Saguão Sul de Uldaman, e entregue a ele na Cidade Baixa.‡Принесите Патрику Гарретту в Подгород фамильное сокровище из сундука в Южном зале Ульдамана.‡Holt Patrick Garretts Familienschatz aus der Truhe der Familie in der Südlichen Bankenhalle von Uldaman und bringt diesen zu ihm nach Unterstadt.‡울다만의 남쪽 대전당에 있는 궤짝에서 가레트가의 보물을 찾아 언더시티에 있는 그에게 가져가야 합니다.‡Coge el tesoro de la familia de Patrick Garrett del cofre de su familia que se encuentra en la Sala Comunal Sur de Uldaman y llévasela a él a Entrañas.‡Saca el tesoro de la familia de Patrick Garrett del cofre de su familia que se encuentra en la Sala Comunal Sur de Uldaman y llévasela a él a Entrañas.‡Rapporter à Patrick Garrett, à Fossoyeuse, son Trésor de famille, qui se trouve dans le Coffre de famille dans les communs du sud d\'Uldaman.‡从奥达曼南部大厅的箱子中找到加勒特的家族宝藏，然后把它交给幽暗城的帕特里克·加瑞特。‡從奧達曼南部大廳的箱子中找到加勒特的家族寶藏，然後把它交給幽暗城的派翠克·加瑞特。',
  }
},
[2358] = {
  {
    'Chifres de Nez\'Ra‡Рога Незры‡Hörner von Nez\'ra‡네즈라의 뿔‡Cuernos de Nez\'ra‡Cuernos de Nez\'ra‡Cornes de Nez\'ra‡奈兹拉之角‡奈茲拉之角',
    nil,
    'Return the Horns of Nez\'ra to Arantir in Lakeshire.‡Верните рога Незры Арантиру в Приозерье.‡Bringt die Hörner von Nez\'ra zu Arantir nach Seenhain.‡호숫골에 있는 아란티르에게 네즈라의 뿔을 돌려줘야 합니다.‡Lleva los Cuernos de Nez\'ra a Arantir a Villa del Lago.‡Lleva los Cuernos de Nez\'ra a Arantir a Villa del Lago.‡Rapporter les Cornes de Nez\'ra à Arantir, à Comté-du-Lac.‡帮助湖畔镇的阿兰提尔找回奈兹拉之角。‡將奈茲拉之角交給湖畔鎮的阿蘭提爾。',
  }
},
[2359] = {
  {
    'Torre do Filipe‡Башня Клейвена‡Klavens Turm‡클라벤의 탑‡La torre de Klaven‡La torre de Klaven‡La tour de Klaven‡克拉文之塔‡克拉文之塔',
    nil,
    'Roube a chave, entre na Torre Défias e descubra o que tem dentro do Baú da Floresta do Crepúsculo. Leve todas as informações que coletar para Mathias Shaw em Ventobravo. Consulte o Diário de Marta se quiser mais detalhes sobre a torre.|n‡Добудьте ключ от башни Братства Справедливости, проберитесь в башню и выясните, каково содержимое сундука из Сумеречного леса. Отнесите найденные вещи Матиасу Шоу в Штормград. Почитайте дневник Кирнен, чтобы больше узнать о башне.‡Stehlt den Turmschlüssel der Defias, brecht in den Turm der Defias ein und stellt fest, was sich in der Dämmerwaldtruhe befindet. Bringt Mathias Shaw in Sturmwind dann alle Informationen über das, was Ihr herausgefunden habt. Lest Kearnens Tagebuch, um neue Erkenntnisse über den Turm zu erlangen.‡데피아즈단 탑 열쇠를 훔쳐 데피아즈단 탑으로 숨어들어 간 후, 그늘숲 궤짝에 무엇이 들어 있는지 밝혀내야 합니다. 알아낸 모든 정보를 스톰윈드에 있는 마티아스 쇼에게 알려줘야 합니다. 켈넌의 보고서을 읽고 탑에 대한 정보를 얻으십시오.‡Roba la Llave de la Torre Defias, entra en la Torre Defias y descubre qué contiene el Cofre del Bosque del Ocaso. Lleva toda la información que encuentres a Mathias Shaw de Ventormenta. Lee el diario de Kearnen para saber cómo acceder a la torre.‡Roba la Llave de la Torre Defias, entra en la Torre Defias y descubre qué contiene el Cofre del Bosque del Ocaso. Lleva toda la información que encuentres a Mathias Shaw de Ventormenta. Lee el diario de Kearnen para saber cómo acceder a la torre.|n‡Volez la Clé de la Tour défias, pénétrez dans la Tour et trouvez ce que contient le Coffre du bois de la Pénombre. Rapportez les informations à Mathias Shaw à Hurlevent. Lisez le journal de Kearnen pour savoir ce qui se passe dans la tour.‡偷取迪菲亚塔楼钥匙，进入迪菲亚塔楼，看看暮色森林的箱子里到底有什么东西，然后向暴风城的马迪亚斯·肖尔汇报。‡偷取迪菲亞塔樓鑰匙，進入迪菲亞塔樓，看看暮色森林的箱子裡到底有什麼東西，然後向暴風城的馬迪亞斯·肖爾彙報。',
  }
},
[2360] = {
  {
    'Mathias e os Défias‡Матиас и Братство Справедливости‡Mathias und die Defias‡마티아스와 데피아즈단‡Mathias y los Defias‡Mathias y los Defias‡Mathias et les Défias‡马迪亚斯和迪菲亚潜行者‡馬迪亞斯和迪菲亞',
    nil,
    'Viaje para Cerro Oeste e encontre a Agente Marta Hari para receber instruções.‡Найдите агента Кеарнен в Западном Крае и поговорите с ней.‡Reist nach Westfall und sucht Agentin Kearnen. Sie wird Euch Bericht erstatten.‡서부 몰락지대로 가서 첩보원 켈넌을 찾아 보고를 받아야 합니다.‡Ve a los Páramos de Poniente y encuentra a la agente Kearnen para dar parte.‡Ve a los Páramos de Poniente y encuentra a la agente Kearnen para dar parte.‡Se rendre dans la marche de l\'Ouest et trouver l\'Agent Kearnen pour un débriefing.‡去西部荒野和密探吉尔妮谈一谈。‡去西部荒野和密探吉爾妮談話。',
  }
},
[2361] = {
  {
    '‡Восстановление ожерелья‡Restaurierung der Halskette‡목걸이 복원‡Restaurar el collar‡Restaurar el collar‡Réparer le collier‡修复项链‡修復項鍊',
    nil,
    nil,
  }
},
[2378] = {
  {
    'Encontre a Mão Despedaçada‡Поиски Изувеченной Длани‡Suche nach der Zerschmetterten Hand‡으스러진 손의 일원을 찾아서‡Encuentra a los Mano Destrozada‡Encuentra a los Mano Destrozada‡Trouver la Main brisée‡寻找碎手氏族‡尋找破碎之手氏族',
    nil,
    'Vá até Orgrimmar e fale com Shenthul no Antro das Sombras.|n‡Отправляйтесь в Оргриммар и поговорите с Шентулом в Расселине Теней.‡Reist nach Orgrimmar und sprecht an der Kluft der Schatten mit Shenthul.‡오그리마로 가서 어둠의 틈에 있는 셴툴과 대화해야 합니다.‡Viaja a Orgrimmar y habla con Shenthul, que estará en el Circo de las Sombras.|n‡Viaja a Orgrimmar y habla con Shenthul, que estará en el Circo de las Sombras.|n‡Voyager vers Orgrimmar pour y parler à Shenthul, dans la Faille de l\'Ombre.‡前往奥格瑞玛，和暗影裂口那的申苏尔谈一谈。‡前往奧格瑪，和暗影裂口那的申蘇爾談話。',
  }
},
[2379] = {
  {
    'Zando\'zan‡Зандо\'зан‡Zando\'zan‡잔도잔‡Zando\'zan‡Zando\'zan‡Zando\'zan‡赞杜沙‡贊杜沙',
    nil,
    'Fale com Zando\'zan no Antro das Sombras.‡Поговорите с Зандо\'заном в Расселине Теней.‡Sprecht an der Kluft der Schatten mit Zando\'zan.‡어둠의 틈에 있는 잔도잔과 대화해야 합니다.‡Habla con Zando\'zan en el Circo de las Sombras.‡Habla con Zando\'zan en el Circo de las Sombras.‡Parler à Zando\'zan à la Faille de l\'Ombre.‡与暗影裂口的赞杜沙谈一谈。‡與暗影裂口的贊杜沙談話。',
  }
},
[2380] = {
  {
    '‡В Оргриммар!‡Nach Orgrimmar!‡‡Ve a Orgrimmar‡Ve a Orgrimmar‡Cap sur Orgrimmar !‡向奥格瑞玛进发！‡',
    nil,
    '‡Поговорите с Шентулом в расселине Теней в Оргриммаре.‡Sprecht an der Kluft der Schatten in Orgrimmar mit Shenthul.‡‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Shenthul.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Shenthul.‡S\'adresser à Shenthul à la Faille de l\'Ombre à Orgrimmar.‡在奥格瑞玛城中的暗影裂口和申苏尔谈谈。‡',
  }
},
[2381] = {
  {
    'Saqueando os saqueadores‡Грабь награбленное‡Das Ausplündern der Plünderer‡약탈자 약탈하기‡Saquear a los saqueadores‡Saquear a los saqueadores‡Piller les pilleurs‡抢劫海盗‡搶劫海盜',
    nil,
    'Leve o Tesouro dos Mares do Sul para Wrenix, o Ignóbil, na Vila Catraca. Não se esqueça de pegar um B.E.C.A. e as Ferramentas de Ladrões no Aparato Mercadotrônico do Wrenix. Você precisará desses dois itens para cumprir a missão.|n|nCaso seja atacado por papagaios nada amigáveis, use o B.E.C.A!|n|n‡Принесите Рениксу Презренному из Кабестана сокровище Южного моря. Не забудьте взять из гизмотронного аппарата Реникса ХОЧУ и отмычки. Они понадобятся для выполнения задания.|n|nЕсли на вас нападут необычайно враждебные попугаи, воспользуйтесь ХОЧУ!‡Bringt den Schatz der Südmeerfreibeuter zu Wrenix dem Jämmerlichen in Ratschet. Vergesst nicht, einen R.C.V.K. und Diebeswerkzeug von Wrenix\' Elektrodingsda-Apparat zu bringen. Ihr werdet diese Dinge brauchen, um Eure Mission zu beenden.|n|nWenn Ihr von ungewöhnlich feindlichen Papageien angegriffen werdet, benutzt Euren R.C.V.K.!‡톱니항에 있는 비운의 레닉스에게 남쪽바다 보물을 가져가야 합니다. 레닉스의 기계장치에서 E.C.A.C.와 도둑 도구를 얻는 것도 잊지 마십시오. 임무를 완수하려면 이 두 가지가 모두 필요합니다.|n|n유별나게 공격적인 앵무새와 맞서면 E.C.A.C.를 사용하십시오!‡Llévale el tesoro de los Mares del Sur a Desdio el Desdichado en Trinquete. No olvides conseguir una G.E.A.Q. y herramientas de ladrón del aparato Gizmotrónico de Wrenix. Necesitarás todo eso para completar tu misión.|n|nSi te atacaran unos loros anormalmente agresivos, ¡usa la G.E.A.Q.!‡Llévale el tesoro de los Mares del Sur a Desdio el Desdichado en Trinquete. No olvides conseguir una G.E.A.Q. y herramientas de ladrones del aparato Gizmotrónico de Wrenix. Necesitarás todo eso para completar tu misión.|n|nSi te atacaran unos loros anormalmente agresivos, ¡usa la G.E.A.Q.!|n|n‡Rapporter le Trésor des mers du Sud à Wrenix le Misérable à Cabestan. Ne pas oublier d\'obtenir un B.G.A.C. et des Outils de voleur de l\'Appareil bidulotronique de Wrenix. Ces deux éléments sont nécessaires pour accomplir la mission.|n|nEn cas d\'attaque par des perroquets particulièrement hostiles, utiliser le B.G.A.C.!‡把南海宝藏带回给棘齿城的卑鄙的维尼克斯。不要忘了从维尼克斯的机械设备中拿取一份大饼干和潜行者工具，你的任务需要使用这两件东西。|n|n如果你被任何奇怪的鹦鹉攻击，就对它使用大饼干！‡把南海寶藏帶回給棘齒城的卑鄙的維尼克斯。不要忘了從維尼克斯的機械設備中拿取一份大餅乾和盜賊工具，你的任務需要使用這兩件東西。|n|n如果你被任何奇怪的鸚鵡攻擊，就對它使用大餅乾!',
  }
},
[2382] = {
  {
    'Wrenix da Vila Catraca‡Реникс из Кабестана‡Wrenix aus Ratschet‡톱니항의 레닉스‡Desdio de Trinquete‡Desdio de Trinquete‡Wrenix de Cabestan‡棘齿城的维尼克斯‡棘齒城的維尼克斯',
    nil,
    'Travel to Ratchet in the Barrens and speak with Wrenix the Wretched.‡Поговорите с Рениксом Презренным в Кабестане, что в Степях.‡Reist nach Ratschet im Brachland und sprecht mit Wrenix dem Jämmerlichen.‡불모의 땅에 있는 톱니항으로 가서 비운의 레닉스와 대화해야 합니다.‡Ve a Trinquete, en Los Baldíos, y habla con Desdio el Desdichado.‡Ve a Trinquete, en Los Baldíos, y habla con Desdio el Desdichado.‡Aller jusqu\'à Cabestan dans les Tarides pour parler à Wrenix le Misérable.‡到贫瘠之地的棘齿城去，与卑鄙的维尼克斯谈一谈。‡到貧瘠之地的棘齒城去，與卑鄙的維尼克斯談話。',
  }
},
[2383] = {
  {
    'Pergaminho simples‡Записка на пергаменте‡Einfaches Pergament‡간결한 양피지‡Papiro simple‡Papiro simple‡Parchemin simple‡简易羊皮纸‡簡易羊皮紙',
    nil,
    'Leia o Pergaminho Simples e fale com Frang no Vale das Provações.‡Прочтите пергамент и поговорите с Франгом в долине Испытаний.‡Lest das einfache Pergament und sprecht mit Frang im Tal der Prüfungen.‡간결한 양피지를 읽고 시험의 골짜기에 있는 프랑과 대화해야 합니다.‡Lee el papiro simple y habla con Frang en el Valle de los Retos.‡Lee el Pergamino simple y habla con Frang en el Valle de los Retos.‡Lire le Parchemin simple, et parler à Frang, dans la Vallée des Épreuves.‡阅读简易羊皮纸，然后和试炼谷的弗朗恩谈一谈。‡閱讀簡易羊皮紙，然後和試煉谷的弗郎恩談話。',
  }
},
[2398] = {
  {
    'Os anões perdidos‡Потерянные дворфы‡Die verschollenen Zwerge‡길 잃은 드워프‡Los enanos desaparecidos‡Los enanos desaparecidos‡Les nains perdus‡失踪的矮人‡失蹤的矮人',
    nil,
    'Encontre Baelog em Uldaman.‡Найдите Бейлога в Ульдамане.‡Sucht in Uldaman nach Baelog.‡울다만에서 밸로그를 찾아야 합니다.‡Encuentra a Baelog en Uldaman.‡Encuentra a Baelog en Uldaman.‡Trouver Baelog dans Uldaman.‡在奥达曼找到巴尔洛戈。‡在奧達曼找到巴爾洛戈。',
  }
},
[2399] = {
  {
    'As frondes desenvolvidas‡Росток папоротника‡Die sprießenden Wedel‡싹튼 잎‡Flora en brote‡Flora en brote‡Les racines ont poussé‡发芽的树叶‡發芽的樹葉',
    nil,
    nil,
  }
},
[2418] = {
  {
    'Pedras de energia‡Силовые камни‡Kraftsteine‡마법석‡Las piedras de energía‡Las piedras de energía‡Les pierres de puissance‡能量石‡能量石',
    nil,
    'Leve 8 Pedras de Energia de Dêntrio e 8 Pedras de Energia de An\'Alleum para Bertolezo nos Ermos.‡Принесите 8 дентриевых силовых камней и 8 энелиевых силовых камней Ригглфаззу в Бесплодные земли.‡Bringt Riggelfuzz im Ödland 8 Kraftsteine aus Dentrium und 8 Kraftsteine aus An\'Alleum.‡황야의 땅에 있는 리글퍼즈에게 덴트리움 마법석 8개와 안알레움 마법석 8개를 가져가야 합니다.‡Llévale 8 piedras de energía de dentrio y 8 piedras de energía An\'Alleum a Aparejez en las Tierras Inhóspitas.‡Llévale 8 piedras de energía de dentrio y 8 piedras de energía de An\'Alleum a Aparejez en las Tierras Inhóspitas.‡Apporter 8 Pierres de puissance Dentrium et 8 Pierres de puissance An\'Alleum à Rigglefuzz dans les Terres ingrates.‡给荒芜之地的里格弗兹带去8块德提亚姆能量石和8块安纳洛姆能量石。‡給荒蕪之地的里格弗茲帶去8塊德提亞姆能量石和8塊安納洛姆能量石。',
  }
},
[2438] = {
  {
    'O apanhador de sonhos de esmeralda‡Изумрудный ловец снов‡Der smaragdgrüne Traumfänger‡에메랄드 꿈흡입기‡El atrapasueños esmeralda‡El atrapasueños esmeralda‡Le Capturêve d\'émeraude‡翡翠摄梦符‡翡翠攝夢符',
    nil,
    'Recupere o Apanhador de Sonhos de Esmeralda.‡Добудьте изумрудного ловца снов.‡Bringt den smaragdgrünen Traumfänger an Euch.‡에메랄드 꿈흡입기를 회수해야 합니다.‡Consigue el atrapasueños esmeralda.‡Consigue el atrapasueños esmeralda.‡Récupérez le Capturêve d\'émeraude.‡获得翡翠摄梦符。‡取得翡翠攝夢符。',
  }
},
[2439] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve o vale-recompensa para Dinita Itamanto no Cofre de Altaforja.‡Отнесите наградной сертификат Дините Каменной Мантии в хранилище Стальгорна.‡Bringt Euren Belohnungsgutschein zu Dinita Zasterstein im Tresor von Eisenschmiede.‡아이언포지 은행에 있는 디니타 스톤맨틀에게 사례 보증 서류를 가져가야 합니다.‡Lleva tu vale de recompensa a Dinita Mantopétreo, que está en las Arcas de Forjaz.‡Lleva tu vale de recompensa a Dinita Mantopétreo, que está en las Arcas de Forjaz.‡Apporter le Bon de récompense à Dinita Mantepierre à la Chambre forte de Forgefer.‡把你的报酬凭证交给铁炉堡银行的丁尼塔·石衣。‡把你的報酬憑證交給鐵爐堡銀行的丁尼塔·石衣。',
  }
},
[2440] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve o vale-recompensa à Bena Casco Invernal no Penhasco do Trovão.‡Отнесите наградной сертификат Бене Заиндевевшее Копыто в Громовой Утес.‡Bringt den Belohnungsgutschein zu Bena Winterhuf nach Donnerfels.‡썬더 블러프에 있는 베나 윈터후프에게 사례 보증 서류를 가져가야 합니다.‡Llévale este vale de recompensa a Bena Pezuña Invernal, que está en Cima del Trueno.‡Llévale este vale de recompensa a Bena Pezuña Invernal, que está en Cima del Trueno.‡Apporter le Bon de récompense à Bena Sabot-d’Hiver aux Pitons-du-Tonnerre.‡把报酬凭证交给雷霆崖的本娜·冰蹄。‡把報酬憑證交給雷霆崖的貝娜·冬蹄。',
  }
},
[2458] = {
  {
    'Missão secreta‡Надежное прикрытие‡Undercover‡잠입‡Agente encubierto‡Agente encubierto‡Sous le couvert de la nuit‡卧底密探‡臥底密探',
    nil,
    'Vá à Torre da Empreendimentos S.A., ao norte do Charco de Lodo, e entre em contato com o agente secreto da Mão Despedaçada, o Capataz Arruela.|n|nQuando a torre estiver à vista, use o Sinalizador para anunciar sua chegada ao Capataz Arruela. Dispare DUAS vezes, depois aproxime-se do Capataz e faça a /continencia dos Mão Despedaçada.|n|nEstas ações devem ser executadas na ordem correta, já que Arruela vai atacar e eliminar qualquer pessoa que não reconheça.‡Отыщите башню Торговой компании к северу от Нефтяного болота и вступите в контакт с тайным агентом Изувеченной Длани, надсмотрщиком Физзулом.|n|nВозле башни выстрелите из сигнального ружья ДВА раза, потом подойдите к надсмотрщику Физзулу и продемонстрируйте приветствие Изувеченной Длани (команда /честь).|n|nВсе нужно делать строго по порядку – Физзул убивает всех, кто кажется ему подозрительным.‡Reist zum Turm der Venture Company nördlich des Schlickmoores und kontaktiert dort den Agenten der Zerschmetterten Hand, Zuchtmeister Fitzel.|n|nSobald der Turm in Sichtweite ist, verwendet die Leuchtfeuerwaffe, um Zuchtmeister Fitzel Eure Ankunft anzuzeigen. Feuert ZWEI Leuchtfeuergeschosse ab, nähert Euch dann Zuchtmeister Fitzel und zeigt den Gruß der Zerschmetterten Hand.|n|nEs ist wichtig, dass Ihr diese Aktionen in der richtigen Reihenfolge durchführt, da Fitzel jede Person, die er nicht erkennt, angreift und eliminiert.‡진흙 늪 북쪽에 있는 투자개발회사 탑으로 가서 으스러진 손의 비밀 요원인 감독관 피줄과 접촉해야 합니다.|n|n탑이 보이면 신호용 권총을 사용해 감독관 피줄에게 당신이 도착했음을 알리십시오. 신호탄은 2번 발사해야 하며, 그 후 감독관 피줄에게 다가가 으스러진 손 /경례를 해야 합니다.|n|n피줄은 자기가 모르는 자는 무조건 처치하려 들기 때문에 정확한 순서대로 수행해야 합니다.‡Ve a la torre de Ventura y Cía., al norte de El Fangal, y localiza al capataz Fizzule, el agente de Mano Destrozada. |n|nCuando veas la torre, usa la pistola de bengalas para avisar de tu llegada al capataz Fizzule. Lanza 2 bengalas y acércate al capataz para darle el /saludo de los Mano Destrozada. |n|nTienes que hacerlo en este orden, porque Fizzule te matará si no te reconoce.‡Ve a la torre de Ventura y Cía., al norte de El Fangal, y localiza al capataz Fizzule, el agente de Mano Destrozada. |n|nCuando veas la torre, usa la pistola de bengalas para avisar de tu llegada al capataz Fizzule. Lanza 2 bengalas y acércate al capataz para darle el /saludo de los Mano Destrozada. |n|nTienes que hacerlo en este orden, porque Fizzule te matará si no te reconoce.‡Aller à la tour de la KapitalRisk, au nord de la Videfange, et contacter l\'agent secret de la Main brisée, le sous-chef Fizzule.|n|nUne fois la tour en vue, utiliser le lance-fusées pour se signaler au sous-chef Fizzule. Tirer DEUX fusées, puis s\'approcher du sous-chef Fizzule et faire le Salut brisé (/salut).|n|nRespecter l\'ordre de ces actions, car Fizzule attaque et tue toute personne qu\'il ne peut pas identifier.‡到淤泥沼泽北边的风险投资公司塔楼去，联系碎手氏族的卧底费苏勒。|n|n看到塔楼之后，用信号枪发射信号，向工头费苏勒示意你已经到达。发出两个闪光信号，然后使用碎手军礼和工头费苏勒接头。|n|n注意，这些步骤必须依次进行，因为费苏勒会攻击并干掉任何他无法识别的人。‡到淤泥沼澤北邊的風險投資公司塔樓去，聯繫破碎之手氏族的臥底監工費蘇勒。|n|n看到塔樓之後，用信號槍發射信號，向監工費蘇勒示意你已經到達。發出兩個閃光信號，然後使用破碎之手軍禮和監工費蘇勒接頭。|n|n注意，這些步驟必須依次進行，因為費蘇勒會攻擊並幹掉任何他無法識別的人。',
  }
},
[2459] = {
  {
    'Ferócitas, o Comedor de Sonhos‡Фероситас Пожиратель Снов‡Ferocitas der Traumfresser‡꿈을 먹어치우는 페로시타스‡Ferocitas el Comesueños‡Ferocitas el Comesueños‡Ferocitas le Mangeur de rêves‡噬梦者菲罗斯塔‡『食夢者』菲羅斯塔',
    nil,
    'Mate 7 Místicos Masca-pinho e encontre a joia roubada.‡Убейте 7 мистиков из племени Кривой Сосны и найдите пропавший самоцвет.‡Tötet 7 Mystiker der Knarzklauen und findet das verlorene Juwel.‡나무옹이 비술사 7명을 처치하고 잃어버린 보석을 찾아야 합니다.‡Mata a 7 místicos Tuercepinos y encuentra la joya perdida.‡Mata a 7 místicos Tuercepinos y encuentra la joya perdida.‡Tuez 7 Mystiques pins-tordus et retrouvez le Bijou disparu.‡消灭7个瘤背秘法师，并找到遗失的珠宝。‡殺掉7個瘤背秘術使，並找到遺失的珠寶。',
  }
},
[2460] = {
  {
    'A saudação dos Mão Despedaçada‡Приветствие Изувеченной Длани‡Der Gruß der Zerschmetterten Hand‡으스러진 손 경례‡El saludo de los Mano Destrozada‡El saludo de los Mano Destrozada‡Le Salut brisé‡碎手军礼‡碎手軍禮',
    nil,
    'Faça a Continência dos Mãos Despedaçada para Shenthul.‡Повторите приветствие Изувеченной Длани вслед за Шентулом.‡Führt Shenthul gegenüber den Gruß der Zerschmetterten Hand aus.‡셴툴에게 으스러진 손 /경례를 해야 합니다.‡Da el saludo de los Mano Destrozada a Shenthul.‡Da el saludo de los Mano Destrozada a Shenthul.‡Faire le Salut brisé à Shenthul.‡对着申苏尔练习碎手军礼。‡對著申蘇爾練習碎手軍禮。',
  }
},
[2478] = {
  {
    'Missão: possível, mas não provável‡Миссия: выполнима, но с трудом‡Mission: möglich, aber nicht sehr wahrscheinlich‡미션 임파서블: 잘하면 가능‡Misión: Posible, pero no probable‡Misión: Posible, pero no probable‡Mission : Possible mais non probable‡基本不可能的任务‡基本不可能的任務',
    nil,
    'Roube a Chave da Torre do Capataz Biela e, em seguida, mate 2 Peões Mutantes da Empreendimentos S.A., 2 Patrulheiros da Empreendimentos S.A. e 2 Vigias da Empreendimentos S.A.|n|nArranque a cabeça do Capataz-chefe Gallywix, arrombe o cofre dele e roube o Esconderijo do Preparado Adulterado do Zanzil. Leve-o junto com a cabeça para Shenthul em Orgrimmar para receber mais instruções.|n‡Украдите ключ от башни у штейгера Силиксиза, убейте двух мертвяков-мутантов Торговой Компании, двух патрульных Торговой Компании и двух смотрителей Торговой Компании.|n|nЛиквидируйте старшего мастера Галливикса, взломайте замок на его сейфе и украдите запас измененной смеси Занзила. Отнесите запас смеси и голову Галливикса Шентулу в Оргриммар и получите следующие указания.‡Stehlt Silixiz\' Turmschlüssel von Großknecht Silixiz. Tötet dann 2 mutierte Drohnen der Venture Co., 2 Patrouillen der Venture Co. und 2 Ausgucker der Venture Co.|n|nEliminiert den obersten Großknecht Gallywix und nehmt seinen Kopf. Knackt dann das Schloss von Gallywix\' Schließkassette und stehlt den Behälter mit Zanzils veränderter Mixtur. Bringt den Behälter und Gallywix\' Kopf zu Shenthul nach Orgrimmar; er wird Euch weitere Anweisungen geben.‡현장감독 실릭시즈에게서 실릭시즈의 탑 열쇠를 훔쳐낸 다음, 돌연변이 투자개발회사 일꾼 2명과 투자개발회사 순찰대원 2명, 그리고 투자개발회사 망꾼 2명을 처치해야 합니다.|n|n총감독 갤리윅스를 암살하고 그의 머리카락을 손에 넣은 후, 갤리윅스의 금고를 열고 잔질의 변화된 혼합물을 훔쳐야 합니다. 그 혼합물과 갤리윅스의 머리카락을 오그리마에 있는 셴툴에게 가져다주고 다음 지시를 받으십시오.‡Roba la llave de la torre del supervisor Silixiz, mata a 2 zánganos mutados de Ventura y Cía., 2 patrullas de Ventura y Cía. y 2 oteadores de Ventura y Cía.|n|nAsesina al Gran Supervisor Puzik Gallywix y quédate con su cabeza, fuerza la cerradura del arcón de Gallywix y roba la carretilla de mezcla de Zanzil modificada que allí está oculta. Lleva el alijo y la cabeza de Gallywix a Shenthul en Orgrimmar; él te dará más instrucciones.‡Roba la llave de la torre del supervisor Silixiz, mata a 2 zánganos mutados de Ventura y Cía., 2 patrullas de Ventura y Cía. y 2 oteadores de Ventura y Cía.|n|nAsesina al gran supervisor Puzik Gallywix y quédate con su cabeza, fuerza la cerradura del arcón de Gallywix y roba la mezcla de Zanzil modificada que allí está oculta. Lleva el alijo y la cabeza de Gallywix a Shenthul en Orgrimmar, él te dará más instrucciones.|n‡Voler la Clé de la tour de Silixiz au Contremaître Silixiz, puis tuer deux Pantins mutants de la KapitalRisk, deux Patrouilleurs de la KapitalRisk, et deux Sentinelles de la KapitalRisk.|n|nAssassiner le Grand contremaître Bisbiwix et prendre sa tête. Ouvrir le coffre de Bisbiwix et y voler la Mixture altérée de Zanzil. Apporter la Mixture et la tête de Bisbiwix à Shenthul à Orgrimmar, et attendre de nouvelles instructions.‡从工头希里克斯那里偷出希里克斯的塔楼钥匙，进入塔楼，然后杀掉两个变异风险投资公司工人、两个风险投资公司巡逻员、两个风险投资公司看守。|n|n杀掉大工头普兹克·加里维克斯，取得他的徽记，然后打开加里维克斯的箱子，拿走赞吉尔的改良药剂。将药剂和加里维克斯的徽记交给奥格瑞玛的申苏尔，等候进一步的指示。‡從工頭希里克斯那裡偷出希里克斯的塔樓鑰匙，進入塔樓，然後殺掉兩個變異風險投資公司閒工、兩個風險投資公司巡邏員、兩個風險投資公司看守。|n|n殺掉大工頭普茲克·加里維克斯，取了他的首級，然後打開加里維克斯的帶鎖箱，拿走贊吉爾的改良藥劑。將藥劑和加里維克斯的頭顱交給奧格瑪的申蘇爾，等候進一步的指示。',
  }
},
[2479] = {
  {
    'A ajuda de Hinoto‡Помощь Хинотта‡Hinotts Hilfe‡히노트의 도움‡La ayuda de Hinott‡La ayuda de Hinott‡L\'aide d\'Hinott‡希诺特的帮助‡希諾特的幫助',
    nil,
    'Vá até a Serraria Tarren, que fica no Contraforte de Eira dos Montes, e entregue a Amostra do Preparado de Zanzil a Serguei Hinoto.|n|nPara chegar à Serraria Tarren, pegue o Zepelim até a Cidade Baixa e siga a estrada em direção ao sul além de Pinhaprata, rumo à Eira dos Montes. É só seguir as placas!|n|n‡Отправляйтесь в Мельницу Таррен в предгорьях Хилсбрада и доставьте образчик смеси Занзила Сержу Хинотту.|n|nСядьте на дирижабль, идущий до Подгорода, и летите вдоль дороги на юг, через Серебряный бор в сторону Хилсбрада. Следите за знаками.‡Reist nach Tarrens Mühle im Vorgebirge des Hügellands und liefert die Probe von Zanzils Mixtur bei Serge Hinott ab.|n|nUm nach Tarrens Mühle zu kommen, müsst Ihr den Zeppelin nach Unterstadt nehmen und dann auf der Straße nach Süden durch den Silberwald in Richtung Hügellandhof reisen. Folgt den Schildern!‡언덕마루 구릉지의 타렌 제분소로 가서 서지 히노트에게 잔질의 혼합물 견본을 전해야 합니다.|n|n타렌 제분소로 가려면 먼저 비행선을 타고 언더시티로 가야 합니다. 도착하면 남쪽 길을 따라 은빛소나무 숲을 지나 언덕마루 쪽으로 가야 합니다. 표지판을 따라 가십시오!‡Ve a Molino Tarren, en Laderas de Trabalomas, para entregar la muestra de la mezcla de Zanzil a Serge Hinott. |n|nPara ir, coge el zepelín a Entrañas y sigue el camino hacia el sur por el Bosque de Argénteos. ¡Sigue las indicaciones!‡Ve a Molino Tarren, en Laderas de Trabalomas, para entregar la muestra de Zanzil a Serge Hinott. |n|nPara llegar a Molino Tarren, sube al zepelín que va a Entrañas y sigue el camino hacia el sur por el Bosque de Argénteos hacia Trabalomas. ¡Sigue las indicaciones!|n|n‡Aller à Moulin-de-Tarren dans les contreforts de Hautebrande et livrer l\'Échantillon de la mixture de Zanzil à Serge Hinott.|n|nPour rejoindre Moulin-de-Tarren, prenez le zeppelin à Fossoyeuse et suivez la route du sud, à travers les Pins-Argentés et vers Hautebrande. Suivez les panneaux !‡到希尔斯布莱德丘陵的塔伦米尔去，把赞吉尔的药剂样品交给瑟尔格·希诺特。|n|n要去塔伦米尔，可以搭乘飞艇到幽暗城，然后沿着大路向南穿过银松森林，直到希尔斯布莱德丘陵。跟着路标走！‡到希爾斯布萊德丘陵的塔倫米爾去，把贊吉爾的藥劑樣品交給瑟爾格·希諾特。|n|n要去塔倫米爾，可以搭乘飛艇到幽暗城，然後沿著大路向南穿過銀松森林，直到希爾斯布萊德丘陵。跟著路標走!',
  }
},
[2480] = {
  {
    '‡Помощь Хинотта‡Hinotts Hilfe‡‡La ayuda de Hinott‡La ayuda de Hinott‡L\'aide d\'Hinott‡希诺特的帮助‡',
    nil,
    '‡Дождитесь, пока Серж Хинотт доделает лекарство.‡Wartet auf Serge Hinott, um das Heilmittel fertig zu stellen.‡‡Espera a que Serge Hinott te cure.‡Espera a que Serge Hinott te cure.‡Attendre Serge Hinott pour achever le remède.‡等待瑟尔格·希诺特完成解药。‡',
  }
},
[2498] = {
  {
    'Fale com Denalan‡Возвращение к Деналану‡Rückkehr zu Denalan‡데날란에게 돌아가기‡Regresa junto a Denalan‡Regresa junto a Denalan‡Retour vers Denalan‡向德纳兰回报‡向德納蘭回報',
    nil,
    'Rellian Spiraverde quer que você fale com Denalan, no Lago Al\'Ameth.‡Релиан Зеленый Костер хочет, чтобы вы поговорили с Деналаном у озера Аль\'Амет.‡Rellian Grünwipfel möchte, dass Ihr am Al\'Amethsee mit Denalan sprecht.‡렐리안 그린스파이어가 알아메스 호수에 있는 데날란과 대화해 달라고 했습니다.‡Rellian Verdeguja quiere que hables con Denalan, que está en el Lago Al\'Ameth.‡Rellian Verdeguja quiere que hables con Denalan, que está en el Lago Al\'Ameth.‡Rellian Vertecime vous demande d\'aller parler à Denalan au lac Al\'Ameth.‡雷利亚·绿树要你和奥拉密斯湖的德纳兰谈一谈。‡雷利亞·綠樹要你和奧拉密斯湖的德納蘭談一談。',
  }
},
[2499] = {
  {
    'Carrancarvalho‡Дубохмур‡Grimmeiche‡오크나무괴물‡Roblegüello‡Roblegüello‡Froncechêne‡奥肯斯古尔‡奧肯斯古爾',
    nil,
    'Consiga o Tumor Gigantesco do Carrancarvalho.‡Снимите гигантскую опухоль с Дубохмура.‡Erhaltet den riesengroßen Tumor von Grimmeiche.‡오크나무괴물에게서 거대한 종양을 모아야 합니다.‡Hazte con el tumor gigantesco de Roblegüello.‡Hazte con el tumor gigantesco de Roblegüello.‡Ôtez la Tumeur gargantuesque de Froncechêne.‡获得奥肯斯古尔身上的巨大的瘤。‡從奧肯斯古爾那裡取得巨大的瘤。',
  }
},
[2500] = {
  {
    'Busca pelos reagentes dos Ermos‡Пробежка по Бесплодным землям‡Reagenziensuche im Ödland‡황야의 땅에서 재료 찾기‡Componentes de Tierras Inhóspitas‡Componentes de Tierras Inhóspitas‡Les réactifs des Terres ingrates‡荒芜之地的材料‡荒蕪之地的試劑',
    nil,
    'Consiga os reagentes dos Ermos de que Ghak Toquecura precisa, então fale novamente com ele em Thelsamar.‡Добудьте в Бесплодных землях реагенты для Гхака Целителя и отнесите их ему в Телcамар.‡Beschafft die Reagenzien, die Ghak Heilsegen aus dem Ödland braucht, und bringt sie ihm nach Thelsamar.‡황야의 땅에서 필요한 재료를 구한 후 텔사마에 있는 가크 힐터치에게 가야 합니다.‡Ve a las Tierras Inhóspitas a buscar los ingredientes que te ha pedido Ghak Sanadón y llévaselos a Thelsamar.‡Ve a las Tierras Inhóspitas a buscar los ingredientes que te ha pedido Ghak Sanadón y llévaselos a Thelsamar.‡Aller chercher les réactifs dont Ghak Touchesoins a besoin dans les Terres ingrates, puis les lui rapporter à Thelsamar.‡从荒芜之地拿到加克所需的材料，然后回到塞尔萨玛去见他。‡從荒蕪之地拿到加克所需的材料，然後回到塞爾薩瑪去見他。',
  }
},
[2501] = {
  {
    '‡Пробежка по Бесплодным землям-2‡Reagenziensuche im Ödland II‡황야의 땅에서 재료 찾기 II‡Componentes de Tierras Inhóspitas II‡Componentes de Tierras Inhóspitas II‡Les réactifs des Terres ingrates II‡荒芜之地的材料 II‡',
    nil,
    '‡Наполните пустые волшебные сосуды кровью опаленных драконов-стражей в Бесплодных землях и принесите их Гхаку Целителю в Телcамар.‡Benutzt die leeren thaumaturgischen Gefäße bei versengten Wächtergroßdrachen im Ödland. Wenn Ihr sie gefüllt habt, bringt sie zu Ghak Heilsegen in Thelsamar.‡‡Usa las vasijas de taumaturgia en los dragones guardianes agostados de las Tierras Inhóspitas. Llévaselas a Ghak Sanadón a Thelsamar.‡Usa las vasijas de taumaturgia en los dragones guardianes agostados de las Tierras Inhóspitas. Llévaselas a Ghak Sanadón a Thelsamar.‡Utiliser les Récipients thaumaturgiques vides sur des dragons gardiens des terres brûlées dans les Terres ingrates. Une fois remplis, les rapporter à Ghak Touchesoins à Thelsamar.‡在荒芜之地的守护火龙身上使用空的魔瓶。将这些容器都盛满之后，把它们交给塞尔萨玛的加克。‡',
  }
},
[2518] = {
  {
    'Lágrima da Lua‡Слезы Луны‡Tränen des Mondes‡달의 눈물‡Las lágrimas de la Luna‡Las lágrimas de la Luna‡Les larmes de la Lune‡月神的泪水‡月神的淚水',
    nil,
    'Consiga as Fiandeiras Prateadas da Dama Sathrah‡Добудьте серебристые паутинные железы леди Сатры.‡Erhaltet Lady Sathrahs silbrige Spinndrüsen.‡여왕거미 사스라의 은빛 돌기를 입수해야 합니다.‡Recupera las hileras de plata de Lady Sathrah.‡Recupera las hileras de plata de Lady Sathrah.‡Récupérez les Filières d’argent de Dame Sathrah.‡获得萨丝拉的银色丝囊。‡取得薩絲拉的銀色絲囊。',
  }
},
[2519] = {
  {
    '‡Храм Луны‡Der Tempel des Mondes‡달의 신전‡El templo de la Luna‡El templo de la Luna‡Le temple de la Lune‡月神殿‡',
    nil,
    '‡Сестра Аквинна хочет, чтобы вы поговорили со жрицей А\'муурой из Храма Луны.‡Schwester Aquinne möchte, dass Ihr im Tempel des Mondes mit Priesterin A\'moora sprecht.‡수녀 아퀴네가 달의 신전에 있는 여사제 아무라와 대화해 달라고 했습니다.‡La hermana Aquinne quiere que hables con la sacerdotisa A\'moora en el Templo de la Luna.‡La hermana Aquinne quiere que hables con la sacerdotisa A\'moora en el Templo de la Luna.‡Sœur Aquinne veut que vous parliez à la prêtresse A\'moora, au Temple de la Lune.‡艾奎恩妮让你和月神殿的女祭司艾茉拉谈一谈。‡',
  }
},
[2520] = {
  {
    '‡Жертвоприношение Сатры‡Sathrahs Opferung‡사스라의 제물‡Sacrificio de Sathrah‡Sacrificio de Sathrah‡Sacrifice de Sathrah‡萨丝拉的祭品‡薩絲拉的祭品',
    nil,
    '‡Жрица А\'муура просит вас положить серебристые паутинные железы леди Сатры у фонтана в храме и затем вернуться к ней.‡Priesterin A\'moora möchte, dass Ihr Lady Sathrahs silbrige Spinndrüsen am Brunnen innerhalb des Tempels ablegt und dann zu ihr zurückkehrt.‡‡La sacerdotisa A\'moora quiere que coloques las hileras de plata de Lady Sathrah en la fuente que hay en el interior del templo, y que después vayas a verla de nuevo.‡La sacerdotisa A\'moora quiere que coloques las hileras de plata de Lady Sathrah en la fuente que hay en el interior del templo, y que después vayas a verla de nuevo.‡La prêtresse A\'moora vous demande de placer les Filières d\'argent de dame Sathrah dans la fontaine à l\'intérieur du temple, puis de retourner la voir.‡女祭司艾茉拉让你将萨丝拉的银色丝囊放在大殿的喷泉处，然后回去见她。‡',
  }
},
[2521] = {
  {
    'A serviço de Kum\'isha‡Служба для Кум\'иши‡Ein Dienst für Kum\'isha‡굼이샤의 지시‡Al servicio de Kum\'isha‡Al servicio de Kum\'isha‡Au service de Kum\'isha‡为库米沙效力‡為庫米沙效力',
    nil,
    'Em suas jornadas pela Barreira do Inferno, caso encontre uma esfera de draenetista impecável, leve-a de volta para Kum\'isha, o Colecionador.|n|nAtenção, essa pedra é um dos cristais mais raros de toda Azeroth. Qualquer criatura nestas terras poderia ter em seu poder uma esfera de draenetista impecável.|n|nVocê será recompensado por cada esfera de draenetista impecável que conseguir.‡Если в своем путешествии по Выжженным землям вы найдете безупречную сферу из дренетиста, отнесите ее Кум\'ише Коллекционеру. |n|nБудьте внимательны – этот камень – один из самых редких кристаллов во всем Азероте. Любое существо в этих землях может владеть безупречной сферой из дренетиста. |n|nВы будете вознаграждены за каждую безупречную сферу из дренетиста, которую доставите Кум-ише.‡Falls Ihr auf Euren Reisen durch die Verwüsteten Lande je auf eine fehlerlose Draenethystsphäre stoßen solltet, bringt sie zu Kum\'isha dem Sammler.|n|nDoch seid gewarnt. Der Edelstein ist einer der rarsten Kristalle von ganz Azeroth. Jedes Wesen in diesem Land könnte eine fehlerlose Draenethystsphäre bei sich haben.|n|nIhr erhaltet eine Belohnung für jede fehlerlose Draenethystsphäre, die Ihr beschaffen könnt.‡저주받은 땅을 돌아다니다가 완전무결한 드레니시스트 구슬을 발견하면 수집가 굼이샤에게 가져가야 합니다.|n|n이 보석은 아제로스를 통틀어 가장 희귀한 수정 중 하나로써 이곳 생물들이 지니고 있을 가능성도 있습니다.|n|n완전무결한 드레니시스트 구슬을 수집해 갈 때마다 각각에 대해 보상을 받게 됩니다.‡En tus viajes por Las Tierras Devastadas, si te encontraras con una esfera draenetista perfecta, llévasela a Kum\'isha el Coleccionista.|n|nTen cuidado, esta gema es uno de los cristales más raros de todo Azeroth. Cualquier criatura de estas tierras podría tener una.|n|nSe te recompensará por cada esfera draenetista perfecta que consigas.‡En tus viajes por Las Tierras Devastadas, si te encontraras con una esfera draenetista perfecta, llévasela a Kum\'isha el Coleccionista.|n|nTen cuidado, esta gema es uno de los cristales más raros de todo Azeroth. Cualquier criatura de estas tierras podría tener una.|n|nSe te recompensará por cada esfera draenetista perfecta que consigas.‡Si vous trouvez une sphère de draenéthyste sans défaut au hasard des voyages dans les terres Foudroyées, apportez-la à Kum\'isha le Collecteur.|n|nCette gemme, l\'une des plus rares de tout Azeroth, peut être détenue par n\'importe qui dans le pays.|n|nUne récompense sera donnée pour chaque sphère de draenéthyste sans défaut trouvée et rapportée.‡在你探索诅咒之地的旅程中，如果碰巧发现了无瑕的德莱尼水晶球，就把它交给收藏家库米沙。|n|n你要知道，这种宝石是整个艾泽拉斯最珍稀的水晶。诅咒之地上的任何一种生物都有可能带着一颗无瑕的德莱尼水晶球。|n|n每找到一颗，你都会得到相应的酬劳。‡在你探索詛咒之地的旅程中，如果碰巧發現了無瑕的德萊尼水晶球，就把它交給『收藏家』庫米沙。|n|n你要知道，這種寶石是整個艾澤拉斯最珍稀的水晶。詛咒之地上的任何一種生物都有可能帶著一顆無瑕的德萊尼水晶球。|n|n每找到一顆，你都會得到相應的酬勞。',
  }
},
[2522] = {
  {
    'Empreitadas do Kum\'isha‡Для коллекции Кум\'иши‡Kum\'ishas Bemühungen‡굼이샤의 노력‡Los esfuerzos de Kum\'isha‡Los esfuerzos de Kum\'isha‡Les efforts de Kum\'isha‡库米沙的努力‡庫米沙的努力',
    nil,
    'Encontre e entregue uma Esfera de Draenetista Impecável para Kum\'isha, o Colecionador.‡Найдите безупречную сферу из дренетиста и верните ее Кум\'ише Коллекционеру.‡Findet eine fehlerlose Draenethystsphäre und bringt sie Kum\'isha dem Sammler.‡완전무결한 드레니시스트 구슬을 찾아서 수집가 굼이샤에게 가져가야 합니다.‡Encuentra una esfera draenetista perfecta y llévasela a Kum\'isha el Coleccionista.‡Encuentra una esfera draenetista perfecta y llévasela a Kum\'isha el Coleccionista.‡Trouvez une Sphère de draenéthyste sans défaut, et apportez-la à Kum\'isha le Collecteur.‡找到一颗无瑕的德莱尼水晶球，把它交给收藏家库米沙。‡找到一顆無瑕的德萊尼水晶球，把它交給『收藏家』庫米沙。',
  }
},
[2523] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Requisitos:‡Требования:‡Anforderungen:‡요구 조건:‡Requisitos:‡Requisitos:‡Conditions :‡‡需要：',
  }
},
[2541] = {
  {
    'O druida adormecido‡Спящий друид‡Der schlafende Druide‡잠자는 드루이드‡El druida durmiente‡El druida durmiente‡Le druide endormi‡沉睡的德鲁伊‡沉睡的德魯伊',
    nil,
    'Traga o Patuá Vodu de Xamã para Oben Patafúria na Gruta de Ban\'ethil.‡Принесите шаманский оберег вуду Обену Яростному Когтю в обитель Бен\'этиль.‡Bringt einen Voodooglücksbringer des Schamanen zu Oben Zornklaue in den Grabhügel von Ban\'ethil.‡바네실 지하굴에 있는 오벤 레이지클로에게 부두교 주술사 부적을 가져가야 합니다.‡Llévale un talismán de vudú chamán a Oben Garrafuria al Túmulo de Ban\'ethil.‡Llévale un talismán de vudú chamán a Oben Garrafuria al Túmulo de Ban\'ethil.‡Rapporter un Charme vaudou de chaman à Oben Grifferage dans le Refuge des saisons de Ban\'ethil.‡将一个萨满巫毒符咒交给班尼希尔兽穴的奥本·怒爪。‡將一個薩滿巫毒符咒交給班奈希爾獸穴的奧本·怒爪。',
  }
},
[2561] = {
  {
    'Druida da Garra‡Друид-медведь‡Druide der Klaue‡발톱의 드루이드‡El druida de la Zarpa‡El druida de la Zarpa‡Le druide de la Griffe‡利爪德鲁伊‡利爪德魯伊',
    nil,
    'Mate o corpo sem alma de Oben Patafúria. Em seguida, use o Patuá Vodu.‡Уничтожьте лишенное души тело Обена Яростного Когтя, а затем воспользуйтесь оберегом вуду.‡Tötet den seelenlosen Körper von Oben Zornklaue und benutzt dann den Voodooglücksbringer.‡영혼이 없는 오벤 레이지클로의 육체를 처치하고 그 시체에 부두교 부적을 사용해야 합니다.‡Mata el cuerpo desalmado de Oben Garrafuria y después utiliza el talismán vudú.‡Mata el cuerpo desalmado de Oben Garrafuria y después utiliza el talismán vudú.‡Tuez le corps privé d’âme d’Oben Grifferage, puis utilisez le Charme vaudou.‡杀掉奥本·怒爪的失去灵魂的躯体，然后对其使用巫毒咒符。‡奧本·怒爪要求你去殺掉他那失去靈魂的身體，然後對其屍體使用巫毒符咒。',
  }
},
[2581] = {
  {
    'Mandíbulas de rasgarrindo‡Челюсти гиены-хохотуна‡Kicherfangunterkiefer‡칼송곳니하이에나 턱‡Papadas de hiena risitas‡Papadas de hiena risitas‡Joues de Raillecroc‡弯牙土狼的颚骨‡彎牙土狼的顎骨',
    nil,
    'Traga três Mandíbulas de Rasgarrindo, dois Pulmões de Javali Destroçados e uma Tenaz de Escórpode para o Mago Sangrento Drazial.‡Принесите три челюсти гиены, два обожженных легких вепря и клешню скорпока магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Kicherfangunterkiefer, 2 feuerverbrannte Eberlungen und 1 Skorpokzange.‡혈법사 드라지알에게 칼송곳니하이에나 턱 3개, 손상된 멧돼지 허파 2개, 스콜포크 집게발 1개를 가져가야 합니다.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Apportez 3 Joues de Raillecroc, 2 Poumons de sanglier éclatés et 1 Pince de scorpok au Mage de sang Drazial.‡收集3个弯牙土狼的颚骨、2片诅咒之地的野猪肺和1个厚甲蝎螯，把它们交给血法师德拉吉亚。‡收集3個彎牙土狼的顎骨、2片詛咒之地的野豬肺和1個厚甲蠍螯，把它們交給血法師德拉吉亞。',
  }
},
[2582] = {
  {
    'Fúria das Eras‡Ярость веков‡Wut der Zeiten‡시대의 분노‡Ira de las Eras‡Ira de las Eras‡La colère des âges‡远古之怒‡遠古之怒',
    nil,
    'Leve três Mandíbulas de Rasgarrindo, dois Pulmões de Javali Destroçados e uma Tenaz de Escórpode para o Mago Sangrento Drazial.‡Принесите три челюсти гиены, два обожженных легких вепря и клешню скорпока магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Kicherfangunterkiefer, 2 feuerverbrannte Eberlungen und 1 Skorpokzange.‡혈법사 드라지알에게 칼송곳니하이에나 턱 3개, 손상된 멧돼지 허파 2개, 스콜포크 집게발 1개를 가져가야 합니다.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Apportez 3 Joues de Raillecroc, 2 Poumons de sanglier éclatés et 1 Pince de scorpok au Mage de sang Drazial.‡收集3个弯牙土狼的颚骨、2片诅咒之地的野猪肺和1个厚甲蝎螯，把它们交给血法师德拉吉亚。‡收集3個彎牙土狼的顎骨、2片詛咒之地的野豬肺和1個厚甲蠍螯，把它們交給血法師德拉吉亞。',
  }
},
[2583] = {
  {
    'A vitalidade dos javalis‡Жизненная сила вепря‡Lebenskraft des Ebers‡멧돼지의 생명력‡La vitalidad del jabalí‡La vitalidad del jabalí‡La vitalité du sanglier‡野猪的活力‡野豬的活力',
    nil,
    'Leve 3 Pulmões de Javali Destroçado, 2 Tenazes de Escórpode e 1 Cérebro de Basilisco para o Mago Sangrento Drazial.|n‡Принесите три обожженных легких вепря, две клешни скорпока и мозг василиска магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 feuerverbrannte Eberlungen, 2 Skorpokzangen und 1 Basiliskengehirn.‡혈법사 드라지알에게 손상된 멧돼지 허파 3개, 스콜포크 집게발 2개, 바실리스크 뇌 1개를 가져가야 합니다.‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.|n‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.|n‡Apportez 3 Poumons de sanglier éclatés, 2 Pinces de scorpok et 1 Cerveau de basilic au Mage de sang Drazial.‡收集3片诅咒之地的野猪肺、2个厚甲蝎螯和1颗石化蜥蜴的大脑，把它们交给血法师德拉吉亚。‡收集3片詛咒之地的野豬肺、2個厚甲蠍螯和1顆石化蜥蜴的大腦，把它們交給血法師德拉吉亞。',
  }
},
[2584] = {
  {
    '‡Дух вепря‡Geist des Ebers‡‡El espíritu del jabalí‡El espíritu del jabalí‡L\'esprit du sanglier‡野猪之魂‡野豬之靈',
    nil,
    '‡Принесите три обожженных легких вепря, две клешни скорпока и один мозг василиска волшебнику крови Дразиалу.‡Bringt Blutmagier Drazial 3 feuerverbrannte Eberlungen, 2 Skorpokzangen und 1 Basiliskengehirn.‡혈법사 드라지알에게 손상된 멧돼지 허파 3개, 스콜포크 집게발 2개, 바실리스크 뇌 1개를 가져가야 합니다.‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.|n‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.|n‡Apportez 3 Poumons de sanglier éclatés, 2 Pinces de scorpok et 1 Cerveau de basilic au Mage de sang Drazial.‡收集3片诅咒之地的野猪肺、2个厚甲蝎螯和1颗石化蜥蜴的大脑，把它们交给血法师德拉吉亚。‡收集3片詛咒之地的野豬肺、2個厚甲蠍螯和1顆石化蜥蜴的大腦，把它們交給血法師德拉吉亞。',
  }
},
[2585] = {
  {
    'Ataque decisivo‡Решительный удар‡Der Entscheidungsschlag‡민첩한 스콜포크‡El golpe decisivo‡El golpe decisivo‡Le coup décisif‡决定性的打击‡決定性的打擊',
    nil,
    'Leve 3 Tenazes de Escórpode, 2 Moelas de Abutre e 1 Pulmão de Javali Destroçado para o Mago Sangrento Drazial.|n‡Принесите три клешни скорпока, две порции потрохов стервятника и обожженное легкое вепря магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Skorpokzangen, 2 Geiermuskelmägen und 1 feuerverbrannte Eberlunge.‡혈법사 드라지알에게 스콜포크 집게발 3개, 독수리 모래주머니 2개, 손상된 멧돼지 허파 1개를 가져가야 합니다.‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.|n‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.|n‡Apportez 3 Pinces de scorpok, 2 Gésiers de vautour et 1 Poumon de sanglier éclaté au mage de sang Drazial.‡收集3个厚甲蝎螯、2个秃鹫的砂囊和1片诅咒之地的野猪肺，把它们血法师德拉吉亚。‡收集3個厚甲蠍螯、2個禿鷹的砂囊和1片詛咒之地的野豬肺，把它們血法師德拉吉亞。',
  }
},
[2586] = {
  {
    '‡Скорпоковая соль‡Salz der Skorpok‡‡La sal del Scorpok‡La sal del Scorpok‡Le sel de scorpok‡厚甲蝎盐‡',
    nil,
    '‡Принесите три клешни скорпока, две единицы потрохов стервятника и одно обожженное легкое вепря волшебнику крови Дразиалу.‡Bringt Blutmagier Drazial 3 Skorpokzangen, 2 Geiermuskelmägen und 1 feuerverbrannte Eberlunge.‡혈법사 드라지알에게 스콜포크 집게발 3개, 독수리 모래주머니 2개, 손상된 멧돼지 허파 1개를 가져가야 합니다.‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.|n‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.|n‡Apportez 3 Pinces de scorpok, 2 Gésiers de vautour et 1 Poumon de sanglier éclaté au mage de sang Drazial.‡收集3个厚甲蝎螯、2个秃鹫的砂囊和1片诅咒之地的野猪肺，把它们血法师德拉吉亚。‡',
  }
},
[2601] = {
  {
    'A mordida do basilisco‡Укус василиска‡Der Biss des Basilisken‡바실리스크의 내장‡El bocado de basilisco‡El bocado de basilisco‡La morsure du basilic‡石化蜥蜴的大脑‡石化蜥蜴的大腦',
    nil,
    'Leve 10 Cérebros de Basilisco e 2 Moelas de Abutre para a Maga Sangrenta Lynnore.|n‡Принесите десять мозгов василиска и потроха двух стервятников волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Basiliskengehirne und 2 Geiermuskelmägen.‡혈법사 린노어에게 바실리스크 뇌 10개와 독수리 모래주머니 2개를 가져가야 합니다.‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.|n‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.|n‡Apportez 10 Cerveaux de basilic et 2 Gésiers de vautour au Mage de sang Lynnore.‡收集10颗石化蜥蜴的大脑和2个秃鹫的砂囊，把它们交给血法师莱诺雷。‡收集10顆石化蜥蜴的大腦和2個禿鷹的砂囊，把它們交給血法師萊諾雷。',
  }
},
[2602] = {
  {
    '‡Непогрешимый разум‡Unfehlbare Gedanken‡‡La mente infalible‡La mente infalible‡Un esprit infaillible‡清晰的思想‡',
    nil,
    '‡Принесите десять мозгов василиска и потроха двух стервятников волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Basiliskengehirne und 2 Geiermuskelmägen.‡혈법사 린노어에게 바실리스크 뇌 10개와 독수리 모래주머니 2개를 가져가야 합니다.‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.|n‡Apportez 10 Cerveaux de basilic et 2 Gésiers de vautour au Mage de sang Lynnore.‡收集10颗石化蜥蜴的大脑和2个秃鹫的砂囊，把它们交给血法师莱诺雷。‡',
  }
},
[2603] = {
  {
    'O vigor do abutre‡Стойкость стервятника‡Lebensenergie des Geiers‡독수리의 면역력‡El vigor del buitre‡El vigor del buitre‡La vigueur du vautour‡秃鹫的活力‡禿鷹的活力',
    nil,
    'Leve 10 Moelas de Abutre e 2 Mandíbulas de Rasgarrindo para a Maga Sangrenta Lynnore.|n‡Принесите потроха десяти стервятников и две челюсти гиены волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Geiermuskelmägen und 2 Kicherfangunterkiefer.‡혈법사 린노어에게 독수리 모래주머니 10개와 칼송곳니하이에나 턱 2개를 가져가야 합니다.‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.|n‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.|n‡Apportez 10 Gésiers de vautour et 2 Joues de Raillecroc au Mage de sang Lynnore.‡收集10个秃鹫的砂囊和2块弯牙土狼的颚骨，把它们交给血法师莱诺雷。‡收集10個禿鷹的砂囊和2塊彎牙土狼的顎骨，把它們交給血法師萊諾雷。',
  }
},
[2604] = {
  {
    '‡Духовное господство‡Geistige Beherrschung‡‡Dominación espiritual‡Dominación espiritual‡Domination spirituelle‡精神矍铄‡',
    nil,
    '‡Принесите потроха десяти стервятников и две челюсти гиены волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Geiermuskelmägen und 2 Kicherfangunterkiefer.‡혈법사 린노어에게 독수리 모래주머니 10개와 칼송곳니하이에나 턱 2개를 가져가야 합니다.‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.|n‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.|n‡Apportez 10 Gésiers de vautour et 2 Joues de Raillecroc au Mage de sang Lynnore.‡收集10个秃鹫的砂囊和2块弯牙土狼的颚骨，把它们交给血法师莱诺雷。‡',
  }
},
[2605] = {
  {
    'O goblin sedento‡Жаждущий гоблин‡Der durstige Goblin‡목마른 고블린‡El goblin sediento‡El goblin sediento‡Le gobelin assoiffé‡口渴的地精‡口渴的哥布林',
    nil,
    'Colete uma Glândula de Orvalho Cheia e leve para Marin Nublacuca em Geringontzan.‡Добудьте насыщенную влагой железу и принесите ее Синю Гогельмогелю в Прибамбасск.‡Beschafft Euch eine gefüllte Taudrüse und bringt sie nach Gadgetzan zu Marin Noggenfogger.‡가득 찬 이슬샘을 모아 가젯잔에 있는 마린 노겐포저에게 가져가야 합니다.‡Consigue una glándula cargada de rocío y llévasela a Marin Tragonublo a Gadgetzan.‡Consigue una glándula cargada de rocío y llévasela a Marin Tragonublo a Gadgetzan.‡Trouver une Glande à rosée remplie et l\'apporter à Marin Brouillecaboche à Gadgetzan.‡找到1个饱满的露水腺，把它交给加基森的马林·诺格弗格。‡找到1個飽滿的露水腺，把它交給加基森的馬林·諾格弗格。',
  }
},
[2606] = {
  {
    'Gosto não se discute‡Хороший вкус‡Dem guten Geschmacke‡맛의 달인‡Un buen sabor‡Un buen sabor‡De bon goût‡好味道‡好味道',
    nil,
    'Marin Nublacuca quer que você fale com Sguisha em Geringontzan.‡Поговорите с Поливалкой в Прибамбасске по поручению Синя Гогельмогеля.‡Marin Noggenfogger möchte, dass Ihr in Gadgetzan mit Sprinkel sprecht.‡마린 노겐포저가 가젯잔에 있는 스프링클과 대화해 달라고 했습니다.‡Marin Tragonublo quiere que hables con Roxio en Gadgetzan.‡Marin Tragonublo quiere que hables con Roxio en Gadgetzan.‡Marin Brouillecaboche vous demande d\'aller voir Saupoudr à Gadgetzan.‡马林·诺格弗格让你与加基森的斯普琳科谈一谈。‡馬林·諾格弗格讓你與加基森的斯普琳科談話。',
  }
},
[2607] = {
  {
    'O toque de Zanzil‡Прикосновение Занзила‡Die Berührung von Zanzil‡잔질의 손길‡Toque de Zanzil‡Toque de Zanzil‡Le toucher de Zanzil‡赞吉尔之触‡贊吉爾之觸',
    nil,
    'Fale com o Doutor Mixilpixil no porão do Quartel.‡Поговорите с Доком Миксиль-Пиксилем в подвале казарм.‡Sprecht im Keller der Kaserne mit Dok Mixilpixil.‡병영 지하실에 있는 닥 믹실픽실과 대화해야 합니다.‡Habla con Doc Mixilpixil en el sótano de los Cuarteles.‡Habla con Doc Mixilpixil en el sótano de los Cuarteles.‡Aller voir le docteur Mixilpixil dans la Cave de la caserne.‡到兵营的地窖里去和道克·米希匹克斯谈一谈。‡到兵營的地窖裡去和道克·米希匹克斯談話。',
  }
},
[2608] = {
  {
    '‡Прикосновение Занзила‡Die Berührung von Zanzil‡‡Toque de Zanzil‡Toque de Zanzil‡Le toucher de Zanzil‡赞吉尔之触‡',
    nil,
    '‡Лягте на землю (действие /lay) для осмотра Доком Миксиль-Пиксилем – он не сможет подобрать лекарство, пока не найдет причину болезни.‡Ihr solltet Euch /hinlegen, damit Dok Mixilpixil Euch untersuchen kann. Denn wie soll er ein Heilmittel finden, wenn er die Ursache nicht finden kann?‡‡Túmbate para que te examine Doc Mixilpixil. ¿Cómo va a encontrar la cura si no encuentra la causa?|n‡Túmbate para que te examine Doc Mixilpixil. ¿Cómo va a encontrar la cura si no encuentra la causa?|n‡S\'allonger (/coucher) pour être $Gexaminé:examinée; par le Docteur Mixilpixil. Comment peut-il trouver le remède s\'il ne peut pas trouver la cause ?‡用/lay指令躺下，接受道克·米希匹克斯的治疗。如果他找不到病因，就找不到治疗的方法。‡',
  }
},
[2609] = {
  {
    'O toque de Zanzil‡Прикосновение Занзила‡Die Berührung von Zanzil‡잔질의 손길‡Toque de Zanzil‡Toque de Zanzil‡Le toucher de Zanzil‡赞吉尔之触‡贊吉爾之觸',
    nil,
    'Leve para o Doutor Mixilpixil um pacote de Flores Silvestres Simples, uma Ampola Chumbada, um Tubo de Bronze e uma Bobina de Seda Chartreuse Leve. "Ite" nenhuma se cura sozinha, meu jovem. ‡Принесите Доку Миксиль-Пиксилю один букетик простых полевых цветов, одну освинцованную колбу, одну бронзовую трубку и одну катушку светлого зеленовато-желтого шелка. Чтотит, знаете ли, сам собой не проходит.‡Bringt Dok Mixilpixil 1 Bündel einfache Wildblumen, 1 verbleite Phiole, 1 Bronzeröhre und 1 Rolle blassgelben Seidenfaden. So eine \'Itis\' heilt sich nicht von selbst, junger Herr.‡닥 믹실픽실에게 수수한 야생화, 가연 약병 1개, 청동관 1개, 그리고 밝은 황록색 비단 실타래 1개를 가져가야 합니다. \'그것\'은 저절로 낫지 않는 병인 것 같습니다.‡Lleva a Doc Mixilpixil un ramo de flores silvestres simples, un vial emplomado, un tubo de bronce y una bobina de hilo de seda verde pistacho. La \'itis\' no se cura sola, jovencito.‡Lleva a Doc Mixilpixil un ramo de flores silvestres simples, un vial emplomado, un tubo de bronce y una bobina de hilo de seda verde pistacho. La \'itis\' no se cura sola, jovencito.‡Apporter au docteur Mixilpixil une Brassée de Fleurs sauvages simples, une Fiole plombée, un Tube en Bronze et une Bobine de Fil de soie chartreuse. Le itis ne guérit pas tout seul.‡给道克·米希匹克斯带去一束普通野花、一只铅瓶，一根青铜管，最后还要一卷淡绿色丝线。伊提斯综合症可不会不治而愈，年轻的小姐。‡給道克·米希匹克斯帶去一束普通野花、一隻鉛瓶，一根青銅管，最後還要一卷淡綠色絲線。伊提斯綜合症可不會不治而愈，年輕的先生。',
  }
},
[2621] = {
  {
    'O desonrado‡Опозоренный‡Der Entehrte‡명예를 잃은 자‡El deshonrado‡El deshonrado‡Le déshonoré‡悔恨的战士‡悔恨的戰士',
    nil,
    'Speak to Dispatch Commander Ruag at Stonard in Swamp of Sorrows.‡Поговорите с командиром разведотряда Руагом в Каменоре, что в Болоте Печали.‡Sprecht in Steinard in den Sümpfen des Elends mit Zentralenkommandant Ruag.‡슬픔의 늪의 스토나드에 있는 파견사령관 루아그와 대화해야 합니다.‡Habla con el comandante de envíos Ruag en Rocal, en el Pantano de las Penas.‡Habla con el comandante de envíos Ruag en Rocal, en el Pantano de las Penas.‡Aller voir le commandant d\'ordonnance Ruag dans Pierrêche, au Marais des Chagrins.‡与悲伤沼泽中斯通纳德的分队指挥官鲁尔格谈一谈。‡到悲傷沼澤的斯通納德與分隊指揮官盧爾格談話。',
  }
},
[2622] = {
  {
    '‡Пропавшие приказы‡Die fehlenden Befehle‡‡Las órdenes perdidas‡Las órdenes perdidas‡Les ordres disparus‡丢失的命令‡',
    nil,
    '‡Поговорите с Бенгором в Каменоре, что в Болоте Печали.‡Sprecht mit Bengor in Steinard in den Sümpfen des Elends.‡‡Habla con Bengor en Rocal, en el Pantano de las Penas.‡Habla con Bengor en Rocal, en el Pantano de las Penas.‡Aller voir Bengor dans Pierrêche, au Marais des Chagrins.‡与悲伤沼泽中斯通纳德的本戈尔谈一谈。‡',
  }
},
[2623] = {
  {
    'O falastrão do pantanal‡Болотный говорун‡Der Sumpfredner‡수다쟁이 늪지 멀록‡La Voz del pantano‡La voz del pantano‡Le Parleur des marécages‡沼泽空谈者‡沼澤空談者',
    nil,
    'Recupere as Ordens do Chefe Guerreiro e devolva-as ao Herói Caído da Horda.‡Заберите приказы вождя и верните их павшему герою Орды.‡Beschafft die Befehle des Kriegshäuptlings wieder und gebt sie dem gefallenen Helden der Horde zurück.‡대족장의 명령서를 회수해 호드 영웅의 넋에게 가져가야 합니다.‡Recupera las órdenes del Jefe de Guerra y vuelve junto al héroe caído de la Horda.‡Recupera las órdenes del Jefe de Guerra y vuelve junto al héroe caído de la Horda.‡Retrouver les Ordres du Chef de guerre et les rendre au Héros de la Horde tombé au combat.‡取回酋长的命令，把它们还给部落英雄的灵魂。‡取回大酋長的命令，把它們還給部落英雄的靈魂。',
  }
},
[2641] = {
  {
    'O Ingrediente Secreto de Sguisha‡Маленький секрет Поливалки‡Sprinkels Geheimzutat‡스프링클의 비밀 재료‡El ingrediente secreto de Roxio‡El ingrediente secreto de Roxio‡L\'ingrédient secret de Saupoudr‡斯普琳科的秘密佐料‡斯普琳科的秘密佐料',
    nil,
    'Sguisha, em Geringontzan, quer que você colete um Tragão Violeta e fale novamente com ela.‡Найдите фиалковый траган и вернитесь к Поливалке в Прибамбасск.‡Sprinkel in Gadgetzan möchte, dass Ihr einen violetten Tragan sucht und ihr bringt.‡가젯잔에 있는 스프링클이 제비수염버섯을 하나 구해 가지고 와 달라고 했습니다.‡Roxio de Gadgetzan quiere que consigas un tragano violeta y se lo lleves.‡Roxio de Gadgetzan quiere que consigas un tragano violeta y se lo lleves.‡Saupoudr, de Gadgetzan, vous demande de cueillir un Tragan pourpre et de le lui apporter.‡加基森的斯普琳科要你去给她找到一颗紫色水生菇。‡加基森的斯普琳科要你去給她找到一顆紫色水生菇。',
  }
},
[2661] = {
  {
    '‡Посылка для Синя‡Lieferung für Marin‡‡Un envío para Marin‡Un envío para Marin‡Livraison pour Marin‡给马林的粉末‡',
    nil,
    '‡Отнесите фиалковый порошок Синю Гогельмогелю в Прибамбасск.‡Sprinkel möchte, dass Ihr das violette Pulver nach Gadgetzan zu Marin Noggenfogger bringt.‡‡Roxio quiere que le lleves las partículas violeta a Marin Tragonublo a Gadgetzan.‡Roxio quiere que le lleves las partículas violeta a Marin Tragonublo a Gadgetzan.‡Saupoudr vous demande d\'apporter la Poudre violette à Marin Brouillecaboche à Gadgetzan.‡斯普琳科让你把紫色粉末交给加基森的马林·诺格弗格。‡',
  }
},
[2662] = {
  {
    '‡Эликсир Гогельмогеля‡Noggenfoggers Elixier‡노겐포저의 비약‡Elixir de Tragonublo‡Elixir de Tragonublo‡Elixir Brouillecaboche‡诺格弗格药剂‡諾格弗格藥劑',
    nil,
    '‡Синь Гогельмогель хочет поговорить с вами после завершения работы над эликсиром.‡Marin Noggenfogger möchte, dass Ihr ihn nochmals ansprecht, wenn er sein Elixier fertiggestellt hat.‡‡Marin Tragonublo quiere que hables con él cuando acabe de preparar el elixir.‡Marin Tragonublo quiere que hables con él cuando acabe de preparar el elixir.‡Retourner voir Marin Brouillecaboche une fois qu\'il aura créé son élixir.‡马林·诺格弗格让你在他制成药剂之后再去找他。‡',
  }
},
[2681] = {
  {
    'As pedras que nos unem‡Камни, что связывают нас‡Die Steine, die uns binden‡속박의 돌‡Las piedras que nos vinculan‡Las piedras que nos vinculan‡Les pierres qui nous lient‡禁锢我们的石头‡禁錮我們的石頭',
    nil,
    'Liberte nove Serviçais de Razelikh, três Serviçais de Sevine, três Serviçais de Allistarj e três Serviçais de Grol, depois fale novamente com o Herói Caído. Você precisa estar sempre próximO das pedras ou o processo fracassará.‡Освободите девять слуг Разелиха, трех слуг Севины, трех слуг Аллистария и трех слуг Грола. Когда ваша задача будет выполнена, возвращайтесь к павшему герою. Вы должны оставаться поблизости от камней, иначе процесс не будет завершен.‡Befreit 9 Diener von Razelikh, 3 Diener von Sevine, 3 Diener von Allistarj und 3 Diener von Grol. Kehrt zum gefallenen Helden zurück, sobald Ihr die Aufgabe erfüllt habt. Ihr müsst nahe bei den Steinen bleiben, sonst habt Ihr keinen Erfolg.‡라젤리크의 하수인 9명, 세바인의 하수인 3명, 알리스타즈의 하수인 3명, 그롤의 하수인 3명을 해방시킨 후, 호드 영웅의 넋에게 가야 합니다. 돌 가까이 있지 않으면 임무에 실패하게 됩니다.‡Libera a 9 sirvientes de Razelikh, 3 sirvientes de Sevine, 3 sirvientes de Allistarj y 3 sirvientes de Grol. Vuelve junto al Héroe Caído cuando hayas acabado la tarea. Debes permanecer cerca de las piedras o el proceso no funcionará.‡Libera a 9 sirvientes de Razelikh, 3 sirvientes de Sevine, 3 sirvientes de Allistarj y 3 sirvientes de Grol. Vuelve junto al Héroe Caído cuando hayas acabado la tarea. Debes permanecer cerca de las piedras o el proceso no funcionará.‡Libérer 9 Serviteurs de Razelikh, 3 Serviteurs de Sevine, 3 Serviteurs d\'Allistarj et 3 Serviteurs de Grol. Retourner voir le Héros de la Horde tombé au combat une fois la tâche terminée. Il faut rester à proximité des pierres ou le processus échouera.‡解救九个拉瑟莱克的仆从、三个瑟温妮的仆从、三个奥利斯塔的仆从和三个戈洛尔的仆从。完成任务后，回到部落英雄的灵魂这里。‡解救九個拉瑟萊克的僕從、三個瑟溫妮的僕從、三個奧利斯塔的僕從和三個戈洛爾的僕從。完成任務後，回到部落英雄的靈魂這裡。',
  }
},
[2701] = {
  {
    '‡Герои древних времен‡Helden der Vergangenheit‡‡Los héroes de los antiguos‡Los héroes de los antiguos‡Les héros des Anciens‡古代英雄‡',
    nil,
    '‡Откройте шкатулку и возьмите награду.‡Öffnet die Truhe und nehmt Euch Eure Belohnung.‡‡Abre el cofre y reclama tu recompensa.‡Abre el cofre y reclama tu recompensa.‡Ouvrir le coffre et prendre la récompense.‡打开箱子，取走你的酬劳。‡',
  }
},
[2702] = {
  {
    '‡Герои древних времен‡Helden der Vergangenheit‡‡Los héroes de los antiguos‡Los héroes de los antiguos‡Les héros des Anciens‡古代英雄‡',
    nil,
    '‡Поговорите с капралом Тундом Треснувшее Копыто.‡Sprecht mit Korporal Thund Spalthuf.‡‡Habla con el cabo Thund Pezuña Quebrada.‡Habla con el cabo Thund Pezuña Quebrada.‡Aller voir le caporal Thund Sabot-fendu.‡和桑德·裂蹄谈一谈。‡',
  }
},
[2721] = {
  {
    'Kirith‡Кирит‡Kirith‡키리스‡‡‡Kirith‡基利斯‡基利斯',
    nil,
    'Descubra que fim levou o Tenente Kirith.‡Узнайте, что стало с лейтенантом Киритом.‡Findet heraus, was aus Leutnant Kirith geworden ist.‡부관 키리스가 어떻게 되었는지 알아봐야 합니다.‡Averigua qué le ha ocurrido al teniente Kirith.‡Averigua qué le ha ocurrido al teniente Kirith.‡Découvrir ce qui est arrivé au Lieutenant Kirith.‡找到基利斯的下落。‡找到基利斯中尉的下落。',
  }
},
[2741] = {
  {
    '‡Супер Яйц-О-Матик‡Der Super-Ei-o-Mat‡고성능 자동부화기‡El Superhuevomático‡El Superhuevomático‡Le Super-Oeuf-O-Matic‡超级测蛋器‡',
    nil,
    nil,
  }
},
[2742] = {
  {
    '‡Рин\'джи в ловушке‡Rin\'ji steckt in der Falle!‡갇혀 있는 린지‡¡Capturaron a Rin\'ji!‡¡Capturaron a Rin\'ji!‡Rin\'ji est pris au piège !‡林吉被困住了！‡',
    nil,
    '‡Выведите Рин\'джи из Сторожки Кель\'Данил, а потом найдите то, что он спрятал в Отвесных скалах, на востоке.‡Eskortiert Rin\'ji aus der Jagdhütte von Quel\'Danil heraus und findet dann das, was er bei den Aussichtsklippen im Osten versteckt hat.‡린지를 호위해 쿠엘다닐 오두막을 빠져나간 후 그가 동쪽 전망대 절벽에 숨겨두었다는 비밀 물건을 찾아야 합니다.‡Ayuda a Rin\'ji a salir de la Avanzada Quel\'Danil y encuentra su secreto oculto en los Acantilados Dominantes.‡Ayuda a Rin\'ji a salir de la Avanzada Quel\'Danil y encuentra su secreto oculto en los Acantilados Dominantes.‡Escorter Rin\'ji hors du Gîte de Quel\'Danil, puis découvrir son secret caché sur les Hauts-Surplombs, à l\'est.‡护送林吉逃出奎尔丹尼小屋，然后在望海崖找到他藏起来的东西。‡',
  }
},
[2743] = {
  {
    '‡Покров Тьмы‡Der Mantel der Dunkelheit‡‡La cubierta de la Oscuridad‡La cubierta de la Oscuridad‡Le couvert de l\'obscurité‡黑暗笼罩‡',
    nil,
    '‡Вернитесь к павшему герою Орды со своими находками.‡Kehrt mit Euren neuen Erkenntnissen zum gefallenen Helden der Horde zurück.‡‡Vuelve junto al héroe caído de la Horda con tus hallazgos.‡Vuelve junto al héroe caído de la Horda con tus hallazgos.‡Retourner voir le Héros de la Horde tombé au combat avec ces découvertes.‡回去见部落英雄的灵魂，将你的发现告诉他。‡',
  }
},
[2744] = {
  {
    'O caçador de demônios‡Охотник на демонов‡Der Dämonenjäger‡악마사냥꾼‡El cazademonios‡El cazademonios‡Le chasseur de démons‡恶魔猎手‡惡魔獵人',
    nil,
    'Fale com Loramus Talípedes em Azshara.‡Поговорите в Азшаре с Лорамом Многоногом.‡Sprecht mit Loramus Thalipedes in Azshara.‡아즈샤라에 있는 로라무스 탈리페데스와 대화해야 합니다.‡Habla con Loramus Thalimedes en Azshara.‡Habla con Loramus Thalimedes en Azshara.‡Aller voir Loramus Thalipedes en Azshara.‡与艾萨拉的洛拉姆斯·萨里比迪斯谈一谈。‡與艾薩拉的洛拉姆斯·薩里比迪斯談話。',
  }
},
[2745] = {
  {
    'Infiltrando-se no castelo‡Проникновение в крепость‡Eindringen ins Schloss‡성 잠입‡Infíltrate en el castillo‡Infíltrate en el castillo‡En infiltrant le château‡潜入城堡‡潛入城堡',
    nil,
    'Fale com Tyrion no Castelo Ventobravo.‡Поговорите с Тирионом в крепости Штормграда.‡Sprecht in Schloss Sturmwind mit Tyrion.‡스톰윈드 성에 있는 티리온과 대화해야 합니다.‡Habla con Tyrion en el Castillo de Ventormenta.‡Habla con Tyrion en el Castillo de Ventormenta.‡Allez voir Tyrion au Château de Hurlevent.‡与暴风城堡的泰里恩谈一谈。‡與暴風城堡的泰里恩談話。',
  }
},
[2746] = {
  {
    'Itens de alguma consequência‡Все по порядку‡Nicht unwichtige Gegenstände‡변장에 필요한 물건‡Objetos importantes‡Objetos importantes‡Des objets d\'une certaine importance‡必备物品‡必備物品',
    nil,
    'Leve 3 Sedas e 2 Maçãs Frescas da Clara para Tyrion em Ventobravo.‡Принесите Тириону в Штормград 3 отреза шелка и 2 свежих яблока Клары.‡Bringt 3 Stück Seidenstoff und 2 frische Äpfel von Clara nach Sturmwind zu Tyrion.‡스톰윈드에 있는 티리온에게 비단 옷감 3개와 클라라의 싱싱한 사과 2개를 가져가야 합니다.‡Lleva 3 paños de seda y 2 manzanas frescas de Clara a Tyrion en Ventormenta.‡Lleva 3 paños de seda y 2 manzanas frescas de Clara a Tyrion en Ventormenta.‡Apporter 3 Etoffes de soie et 2 Pommes fraîches de Clara à Tyrion à Hurlevent.‡将3块丝绸和2只克拉拉的新鲜苹果交给暴风城的泰里恩。‡將3塊絲綢和2顆克拉拉的新鮮蘋果交給暴風城的泰里恩。',
  }
},
[2747] = {
  {
    '‡Необычное яйцо‡Ein außergewöhnliches Ei‡‡Un huevo muy especial‡Un huevo muy especial‡Un œuf extraordinaire‡特别的蛋‡',
