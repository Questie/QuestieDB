[13740] = {
  {
    'Surge um campeão‡Рождение героя‡Aufstieg eines Champions‡용사 등극‡Se alza un Campeón‡Se alza un Campeón‡La naissance d\'un champion‡冠军诞生‡一位勇士的出現',
    nil,
    'Fale com a Justicar Mariel Veras nos Campos do Torneio Argênteo.‡Поговорите с вершительницей правосудия Мариэль Чистосердечной на Ристалище Серебряного турнира.‡Sprecht mit Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트와 대화해야 합니다.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Parlez à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的裁决者玛蕾尔·图哈特谈一谈。‡跟銀白聯賽場地的審判者瑪瑞爾·真心談談。',
  }
},
[13741] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Lana Fortemalho nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Лане Твердомолот в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Lana Starkhammer beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 라나 스타우트해머에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Lana Martillotenaz en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Lana Martillotenaz en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Lana Rudemartel dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的兰娜·硬锤。‡取得灰木古劍，並帶給銀白聯賽場地的菈娜‧頑錘。',
  }
},
[13742] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Lana Fortemalho nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Лане Твердомолот в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Lana Starkhammer beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 라나 스타우트해머에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Lana Martillotenaz en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Lana Martillotenaz en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的兰娜·硬锤。‡將德拉克瑪之刃帶給銀白聯賽場地的菈娜·頑錘。',
  }
},
[13743] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Lana Fortemalho, nos Campos do Torneio Argênteo, quer que você leve o Gume Austrino a ela.‡Лана Твердомолот из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Lana Starkhammer beim Argentumturnierplatz möchte, dass Ihr ihr die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 라나 스타우트해머가 겨울 칼날을 가져다 달라고 했습니다.‡Lana Martillotenaz en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Lana Martillotenaz en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的兰娜·硬锤。‡銀白聯賽場地的菈娜‧頑錘要你把凜冬之鋒帶給她。',
  }
},
[13744] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Rolo Tirocerto, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию Ролло Меткострела из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Rollo Immertreff beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 롤로 슈어샷이 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Rolo Tiro Acertado en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Rolo Tiro Acertado en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Rollo Coup-sûr, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的鲁洛·强击要你消灭10名被转化的英雄。‡銀白聯賽場地的羅洛‧穩擊要你殺死10名轉化的英雄。',
  }
},
[13745] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Clara Rolacerva nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите три знака искателя славы Кларе Взубногой в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Clara Torkelbräu beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 클라라 텀블브루에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Clara Vueltabirra en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Clara Vueltabirra en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Clara voltebière, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的克拉拉·沸酒。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的卡拉菈·跌酒。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13746] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Ambrósio Chisparafuso nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Амброзу Искрокруту в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Ambrose Bolzenfunk beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的安布罗斯·雷钉。‡取得灰木古劍，並帶給銀白聯賽場地的安布羅斯‧拴炫。',
  }
},
[13747] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Ambrósio Chisparafuso nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Амброзу Искрокруту в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Ambrose Bolzenfunk beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的阿姆布罗斯·电光。‡將德拉克瑪之刃帶給銀白聯賽場地的安布羅斯·拴炫。',
  }
},
[13748] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Ambrósio Chisparafuso, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Амброз Искрокрут из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Ambrose Bolzenfunk beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크가 겨울 칼날을 가져다 달라고 했습니다.‡Ambrose Chisparrayo en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Ambrose Chisparrayo en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的安布罗斯·雷钉。‡銀白聯賽場地的安布羅斯‧拴炫要你把凜冬之鋒帶給他。',
  }
},
[13749] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Tiquim Chavefenda, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 воинов Плети в Ледяной Короне по заданию Тикля Гайковерта из Павильона Серебряного союза на Ристалище Серебряного турнира. Вы можете найти их в любой части Ледяной Короны, за исключением Бомбардировки.‡Klack Radspanner beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 티킨 기어스패너가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Tickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Tickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Koche Clépharnaüm, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的提克·扳钳要你消灭10名被转化的英雄。‡銀白聯賽場地的提金‧輪扳要你殺死10名轉化的英雄。',
  }
},
[13750] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Fliquim Chavefenda.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите три знака искателя славы Фликлю Гайковерту в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Klick Radspanner beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 플리킨 기어스패너에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Flickin Trazagranaje en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Flickin Trazagranaje en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Krante Clépharnaüm, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的弗林克·扳钳。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的佛立金·輪扳。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13751] = {
  {
    'Não conte a ninguém!‡Никому не говори!‡Schweigt still wie ein Grab!‡일급 비밀!‡¡No se lo digas a nadie!‡¡No se lo digas a nadie!‡Ne le dis à personne !‡谁都别告诉！‡別告訴任何人!',
    nil,
    'Draaka, no Posto Machadada, quer que você leve o Bilhete Escrito Apressadamente para Durak.‡Драака с Заставы Расщепленного Дерева просит вас отнести торопливо написанную записку Дурану.‡Draaka im Splitterholzposten möchte, dass ihr die hastig geschriebene Notiz an Durak überbringt.‡토막나무 주둔지에 있는 드라카가 듀락에게 휘갈겨 쓴 쪽지를 전해달라고 했습니다.‡Draaka de El Hachazo quiere que le lleves la nota escrita con prisas a Durak.‡Draaka de El Hachazo quiere que le lleves la nota escrita con prisas a Durak.‡Draaka, à Bois-Brisé, vous demande d\'apporter la Note écrite à la hâte à Durak.‡碎木岗哨的德娜卡要你把匆忙书写的字条带给杜莱克。‡碎木崗哨的德拉卡要你帶著匆忙寫下的便箋去給杜雷克。',
  }
},
[13752] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Colossos nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Колосусу в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Kolosos beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 콜로소스에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Colosos en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Colosos en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Colossos, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的科鲁索斯。‡取得灰木古劍，並帶給銀白聯賽場地的克羅索斯。',
  }
},
[13753] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Colossos nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Колосусу в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Kolosos beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 콜로소스에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Colosos en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Colosos en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Colossos, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的科鲁索斯。‡將德拉克瑪之刃帶給銀白聯賽場地的克羅索斯。',
  }
},
[13754] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Colossos, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Колосус из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Kolosos beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 콜로소스가 겨울 칼날을 가져다 달라고 했습니다.‡Colosos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Colosos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Colossos, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的科鲁索斯。‡銀白聯賽場地的克羅索斯要你把凜冬之鋒帶給他。',
  }
},
[13755] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Saandos, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию Саандоса из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Saandos beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 산도스가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Saandos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Saandos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Saandos, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的萨安度斯要你消灭10名被转化的英雄。‡銀白聯賽場地的山鐸士要你殺死10名轉化的英雄。',
  }
},
[13756] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Ranii.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите три знака искателя славы Рании в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Ranii beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 라니에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Ranii en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Ranii en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Ranii, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的兰妮。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的蘭妮。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13757] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Jaeline Ortocanto nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Джейлин Закатной Песне а шатер Альянса на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Jaelyne Abendlied beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 제일린 이븐송에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的亚琳·永歌。‡取得灰木古劍，並帶給銀白聯賽場地的潔琳‧晚歌。',
  }
},
[13758] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Jaeline Ortocanto nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Джейлин Закатной Песне в шатер Альянса на Ристалище Серебряного турнира.‡Bringt Jaelyne Abendlied beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 제일린 이븐송에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的亚琳·永歌。‡取得灰木古劍，並帶給銀白聯賽場地的艾瑞西雅·曦詠。',
  }
},
[13759] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Jaeline Ortocanto, nos Campos do Torneio Argênteo, quer que você leve o Gume Austrino a ela.‡Джейлин Закатная Песня из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести ей Клинок Зимы.‡Jaelyne Abendlied beim Argentumturnierplatz möchte, dass Ihr ihr die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 제일린 이븐송이 겨울 칼날을 가져다 달라고 했습니다.‡Jaelyne Unicanto en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Jaelyne Unicanto en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的亚琳·永歌。‡銀白聯賽場地的潔琳‧晚歌要你把凜冬之鋒帶給她。',
  }
},
[13760] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Illestria Cantalâmina, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев в Ледяной Короне по заданию Иллестрии Певицы Клинка из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Illestria Klingensänger beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 일레스트리아 블레이드싱어가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Illestria Rugefilo en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Illestria Rugefilo en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Illestria Chantelame, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的伊蕾丝蒂亚·刃歌要你消灭10名被转化的英雄。‡銀白聯賽場地的依蕾絲崔亞‧刃詠要你殺死10名轉化的英雄。',
  }
},
[13761] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Airae Mirestela.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите три знака искателя славы Айре Устремленной к Звездам в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Airae Sternensucher beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 아이래 스타시커에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Airae Buscaestelar en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Airae Buscaestelar en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Airae Cherchétoile, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的艾莱·觅星。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的愛芮·星尋者。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13762] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Mokra, o Esmaga-crânios, nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Мокре Дробителю Черепов в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Mokra dem Schädelberster beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的碎颅者莫克拉。‡取得灰木古劍，並帶給銀白聯賽場地的『碎顱者』莫克拉。',
  }
},
[13763] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Mokra, o Esmaga-crânios, nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Мокре Дробителю Черепов в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Mokra dem Schädelberster beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的碎颅者莫克拉。‡將德拉克瑪之刃帶給銀白聯賽場地的『碎顱者』莫克拉。',
  }
},
[13764] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Mokra, o Esmaga-crânios, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Мокра Дробитель Черепов из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Mokra der Schädelberster beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라가 겨울 칼날을 가져다 달라고 했습니다.‡Mokra el Trituracráneos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Mokra el Trituracráneos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的碎颅者莫克拉。‡銀白聯賽場地的『碎顱者』莫克拉要你把凜冬之鋒帶給他。',
  }
},
[13765] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Aquinos, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев в Ледяной Короне по заданию Акиноса из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Akinos beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 아키노스가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Akinos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Akinos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Akinos, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的埃基诺斯要你消灭10名被转化的英雄。‡銀白聯賽場地的阿奇諾斯要你殺死10名轉化的英雄。',
  }
},
[13766] = {
  {
    'Botando o galho dentro‡Именем природы‡Verschlossene Tore‡합당한 폐쇄‡El cierre es algo natural‡El cierre es algo natural‡Il faut qu’une porte soit ouverte ou fermée !‡自然关闭‡結束是自然的事',
    nil,
    'Use o Galho do Nodoso para fechar 10 Portais Demoníacos.‡Закройте 10 врат демонов с помощью ветви Кривокрона.‡Schließt mit Knorres Zweig 10 Dämonentore.‡나알의 나뭇가지를 사용해 악마의 문 10개를 닫아야 합니다.‡Utiliza la rama de Gnarl para cerrar 10 puertas demoníacas.‡Utiliza la rama de Gnarl para cerrar 10 puertas demoníacas.‡Noueux, du Camp de bûcherons Chanteguerre, vous a demandé d’utiliser le Rameau de Noueux pour fermer 10 Portes démoniaques.‡使用纳亚尔的树枝关闭10座恶魔之门。‡使用樹瘤的粗枝關閉10座惡魔之門。',
  }
},
[13767] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Móra Manaworg nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Принесите три знака искателя славы Море Сестре Воргов в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Morah Worgschwester beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 모라 워그시스터에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Morah Hermana de Huargos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso a Morah Hermana de Huargos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant à Morah Sœur-worg, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡将三枚勇士的印记交给银色比武场的茉拉·狼女。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的莫菈‧座狼姊妹。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13768] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Zul\'tore nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Зул\'тору в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Zul\'tore beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 줄토어에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Zul\'tore en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Zul\'tore en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的祖尔托。‡取得灰木古劍，並帶給銀白聯賽場地的祖爾拓。',
  }
},
[13769] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Zul\'tore nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Зул\'тору в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Zul\'tore beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 줄토어에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Zul\'tore en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Zul\'tore en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的祖尔托。‡將德拉克瑪之刃帶給銀白聯賽場地的祖爾拓。',
  }
},
[13770] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Zul\'tore, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Зул\'тор из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Zul\'tore beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 줄토어가 겨울 칼날을 가져다 달라고 했습니다.‡Zul\'tore en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Zul\'tore en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Zul\'tore, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的祖尔托。‡銀白聯賽場地的祖爾拓要你把凜冬之鋒帶給他。',
  }
},
[13771] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'O Caçador Sombrio Mezil-kree, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию темного охотника Мезил-Кри из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Schattenjäger Mezil-kree beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 어둠사냥꾼 메질크리가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡El cazador de las Sombras Mezil-kree en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡El cazador de las Sombras Mezil-kree en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Le Chasseur des ombres Mezil-kree, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的暗影猎手梅兹克雷要你消灭10名被转化的英雄。‡銀白聯賽場地的暗影獵手梅齊克里要你殺死10名轉化的英雄。',
  }
},
[13772] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Gahju nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Принесите три знака искателя славы Гаджу в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Gahju beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 가쥬에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Gahju en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso a Gahju en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant à Gahju, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡将三枚勇士的印记交给银色比武场的加尔祖。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的嘎尤。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13773] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Runok Juba Agreste nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Руноку Буйногривому в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Runok Wildmähne beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 루노크 와일드메인에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Runok Ferocrín en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Runok Ferocrín en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给带给银色比武场的鲁诺克·蛮鬃。‡取得灰木古劍，並帶給銀白聯賽場地的魯諾克·蠻鬃。',
  }
},
[13774] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Runok Juba Agreste nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Руноку Буйногривому в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Runok Wildmähne beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 루노크 와일드메인에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Runok Ferocrín en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Runok Ferocrín en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的鲁诺克·蛮鬃。‡將德拉克瑪之刃帶給銀白聯賽場地的魯諾克·蠻鬃。',
  }
},
[13775] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Runok Juba Agreste, nos Campos do Torneio Argênteo, quer que você lhe traga Gume Austrino.‡Рунок Буйногривый из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Runok Wildmähne beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 루노크 와일드메인이 겨울 칼날을 가져다 달라고 했습니다.‡Runok Ferocrín en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Runok Ferocrín en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的鲁诺克·蛮鬃。‡銀白聯賽場地的魯諾克·蠻鬃要你把凜冬之鋒帶給他。',
  }
},
[13776] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Dern Totem da Fúria, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию Дерна Тотема Ярости из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Dern Zorntotem beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 던 레이지토템이 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Dern Tótem de Ira en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Dern Tótem de Ira en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Dern Totem-de-rage, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的德恩·暴怒图腾要你消灭10名被转化的英雄。‡銀白聯賽場地的德恩·狂暴圖騰要你殺死10名轉化的英雄。',
  }
},
[13777] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Anka Casco Afiado nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Принесите три знака искателя славы Анке Точеное Копыто в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Anka Klauenhuf beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 안카 클로후프에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Anka Garrapezuña en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso a Anka Garrapezuña en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant à Anka Sabot-griffu, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡将三枚勇士的印记交给银色比武场的安卡·爪蹄。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的安卡‧爪蹄。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13778] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a ao Sicário Viscerae nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его стражу смерти Визери в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Todespirscher Visceri beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 죽음추적자 비세리에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al mortacechador Visceri en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al mortacechador Visceri en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给带给银色比武场的死亡猎手维瑟里。‡取得灰木古劍，並帶給銀白聯賽場地的亡靈哨兵威瑟瑞。',
  }
},
[13779] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar ao Sicário Viscerae nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Стражу смерти Визери на Ристалище Серебряного турнира.‡Bringt Todespirscher Visceri beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 죽음추적자 비세리에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar al mortacechador Visceri en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar al mortacechador Visceri en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的死亡猎手维瑟里。‡將德拉克瑪之刃帶給銀白聯賽場地的亡靈哨兵威瑟瑞。',
  }
},
[13780] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'O Sicário Viscerae, nos Campos do Torneio Argênteo, quer que você lhe traga o Gume Austrino.‡Страж смерти Визери из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Todespirscher Visceri beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 죽음추적자 비세리가 겨울 칼날을 가져다 달라고 했습니다.‡El mortacechador Visceri en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡El mortacechador Visceri en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Le Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的死亡猎手维瑟里。‡銀白聯賽場地的亡靈哨兵威瑟瑞要你把凜冬之鋒帶給他。',
  }
},
[13781] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Sarah Chalke, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию Сары Чолк из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Sarah Chalke beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 사라 초크가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Sarah Chalke en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sarah Chalke en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sarah Chalke, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的莎拉·查尔克要你消灭10名被转化的英雄。‡銀白聯賽場地的薩拉·喬克要你殺死10名轉化的英雄。',
  }
},
[13782] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente ao Tratador Dretch nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Принесите три знака искателя славы дрессировщику Дречу в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Tierführer Dretch beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 조련사 드레치에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso al cuidador Dretch en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso al cuidador Dretch en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant au Dresseur Dretch, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡将三枚勇士的印记交给银色比武场的马夫德雷奇。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的管理者德瑞齊。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13783] = {
  {
    'Uma espada digna de um campeão‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    'Recupere a Espada Fraxínea e leve-a a Erasséa Cantalva nos Campos do Torneio Argênteo.‡Раздобудьте меч Ясеневого озера и принесите его Эрессее Певице Рассвета в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Eressea Morgensänger beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 에레시아 돈싱어에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Eressea Cantoalba en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Eressea Cantoalba en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Eressea Chantelaube dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的伊蕾希亚·晨歌。‡取得灰木古劍，並帶給銀白聯賽場地的艾瑞西雅·曦詠。',
  }
},
[13784] = {
  {
    'Uma arma de valor‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    'Leve a Lâmina de Drak\'Mar a Erasséa Cantalva nos Campos do Torneio Argênteo.‡Принесите меч Драк\'Мара Эрессее Певице Рассвета в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Eressea Morgensänger beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 에레시아 돈싱어에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Eressea Cantoalba en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Eressea Cantoalba en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的伊蕾希亚·晨歌。‡將德拉克瑪之刃帶給銀白聯賽場地的艾瑞西雅·曦詠。',
  }
},
[13785] = {
  {
    'Limiar do Inverno‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    'Erasséa Cantalva, nos Campos do Torneio Argênteo, quer que você leve o Gume Austrino a ela.‡Эрессея Певица Рассвета из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Eressea Morgensänger beim Argentumturnierplatz möchte, dass Ihr ihr Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 에레시아 돈싱어가 겨울 칼날을 가져다 달라고 했습니다.‡Eressea Cantoalba en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡Eressea Cantoalba en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的伊蕾希亚·晨歌。‡銀白聯賽場地的艾瑞西雅·曦詠要你把凜冬之鋒帶給她。',
  }
},
[13786] = {
  {
    'Treinamento de campo de um valente‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    'Catiel Arrebol, nos Campos do Torneio Argênteo, quer que você mate 10 Heróis Convertidos.‡Убейте 10 обращенных героев по заданию Кетиэля Солнечного Копья из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Kethiel Sonnenlanze beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 케시엘 선랜스가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Kethiel Lanzasol en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Kethiel Lanzasol en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Kethiel Lance-solaire, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的克希尔·炎枪要你消灭10名被转化的英雄。‡銀白聯賽場地的凱希爾·日槍要你殺死10名轉化的英雄。',
  }
},
[13787] = {
  {
    'A grande escaramuça‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    'Leve 3 Marcas do Valente a Anira Thuron.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите три знака искателя славы Анире Турон в Павильон Похитителей Солнца на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Aneera Thuron beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 아니라 투론에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Aneera Thuron en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Aneera Thuron en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Aneera Thuron, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的安妮拉·索隆。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶3個驍士印記交給銀白聯賽場地的安妮拉‧修倫。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13788] = {
  {
    'A ameaça vem de cima‡Атака с воздуха‡Bedrohung von oben‡위로부터의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    'Croque Flagelicida, no Torneio Argênteo, quer que você mate Gargagelo e 3 Bombardeiros Sectários.‡Крок Гроза Плети с Ристалища Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов-сектантов.‡Crok Geißelbann beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡은빛십자군 마상시합 광장에 있는 크록 스컬지베인이 서리아귀와 이교도 폭격수 3명을 처치해 달라고 했습니다.‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Plaie-du-Fléau, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡银色比武场的科罗克·斩亡者要你消灭3名诅咒教派投弹手，并击败冰喉。‡銀白聯賽的克羅科·天譴剋星要你擊敗寒冽之喉和3個教徒投彈手。',
  }
},
[13789] = {
  {
    'Contra-ataque o contra-atacante‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    'Cellian Raiadiem, nos Campos do Torneio Argênteo, quer que você mate 15 membros da Seita dos Malditos. Você pode matar os integrantes da Seita dos Malditos em qualquer parte da Coroa de Gelo.‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Селлиана Первого Луча из Серебряного павильона на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны.‡Cellian Tagesanbruch beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Anhänger des Kults der Verdammten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 셀리안 데이브레이크가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar a miembros del Culto de los Malditos en cualquier parte de Corona de Hielo.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar a miembros del Culto de los Malditos en cualquier parte de Corona de Hielo.‡Cellian Bonmatin, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez les tuer partout dans la Couronne de glace.‡银色比武场的塞利安·碎日要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭这些诅咒教派的成员。‡銀白聯賽場地的瑟利安·破曉要你殺死15名詛咒神教的成員。你可以在寒冰皇冠任何一個地方殺死神教成員。',
  }
},
[13790] = {
  {
    'Entre campeões‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions…‡冠军的比武‡勇士們',
    nil,
    'Leve 4 Marcas do Campeão a Luuri nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите 4 знака чемпиона Луури в павильон Серебряного союза на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне.‡Bringt 4 Male des Champions zu Luuri beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 루리에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.|n‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.|n‡Apportez 4 Marques de champion à Luuri, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡将四枚冠军的印记交给银色比武场的鲁莉。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶4個勇士印記交給銀白聯賽場地的露莉。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13791] = {
  {
    'Contra-ataque o contra-atacante‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    'Zor\'be, o Dessangrador, nos Campos do Torneio Argênteo, quer que você mate 15 integrantes da Seita dos Malditos. Você pode matar os integrantes da Seita dos Malditos em qualquer parte da Coroa de Gelo.‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Зор\'бе Кровопускателя с Ристалища Серебряного турнира. Вы можете действовать в любой области Ледяной Короны.‡Zor\'be der Blutvergießer beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Kultisten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 피를 부르는 조르베가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be le Saigneur, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez tuer des sectateurs partout dans la Couronne de glace.‡银色比武场的放血者佐尔比要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭那些异教徒。‡銀白聯賽場地的『放血者』佐爾必要你殺死15名詛咒神教的成員。你可以在寒冰皇冠任何一個地方殺死神教成員。',
  }
},
[13792] = {
  {
    'O Andassombras‡Бредущий Тенью‡Der Schattenwandler‡그늘을 걷는 자‡El Corresombras‡El Corresombras‡Le Marchombre‡影行者‡影行者',
    nil,
    'Fale com Gaivan Andassombras, que está andando do lado de fora da entrada do Retiro de Dor\'Danil, no Vale Gris.‡Поговорите с Гайваном Бредущим Тенью. Его можно найти где-то рядом со входом в Обитель Дор\'Данил, что в Ясеневом лесу.‡Sprecht mit Gaivan Schattenwandler, der vor dem Eingang zum Grabhügel von Dor\'Danil im Eschental wandelt.‡잿빛 골짜기의 도르다닐 지하굴 입구로 걸어가고 있는 가이반 셰이드워커와 대화해야 합니다.‡Habla con Gaivan Corresombras en el exterior de la entrada del Túmulo de Dor\'Danil en Vallefresno.‡Habla con Gaivan Corresombras en el exterior de la entrada del Túmulo de Dor\'Danil en Vallefresno.‡Parlez à Gaivan Marchombre, il fait les cent pas à l\'extérieur de l\'entrée du Refuge des saisons de Dor\'danil en Orneval.‡跟灰谷朵丹尼尔兽穴入口外的盖凡·影行者谈一谈。‡在梣谷的朵丹尼爾獸穴入口外和蓋凡·影行者談話。',
  }
},
[13793] = {
  {
    'Entre campeões‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions...‡冠军的比武‡勇士們',
    nil,
    'Leve 4 Marcas do Campeão a Illyrie Cadenoctis nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão do Pacto de Prata.‡Принесите 4 знака чемпиона Иллирии Приходу Тьмы на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне Серебряного союза.‡Bringt 4 Male des Champions zu Illyrie Nachtlauer beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 일라이리 나이트폴에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.‡Apportez 4 Marques de champion à Illyrie Tombenuit, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡将四枚冠军的印记交给银色比武场的伊尔蕾·夜幕。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡帶4個勇士印記交給銀白聯賽場地的伊黎芮‧夜暮。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或白銀誓盟亭閣的長槍架再拿一把。',
  }
},
[13794] = {
  {
    'Eadric, o Puro‡Эдрик Чистый‡Eadric der Reine‡성기사 에드릭‡Eadric el Puro‡Eadric el Puro‡Eadric le Pur‡纯洁者耶德瑞克‡『純淨者』埃卓克',
    nil,
    'Fale com Eadric, o Puro, nos Campos do Torneio Argênteo.‡Поговорите с Эдриком Чистым из Серебряного павильона на Ристалище Серебряного турнира.‡Sprecht mit Eadric dem Reinen beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 성기사 에드릭과 대화해야 합니다.‡Habla con Eadric el Puro en los Campos del Torneo Argenta.‡Habla con Eadric el Puro en los Campos del Torneo Argenta.‡Parlez à Eadric le Pur, dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的纯洁者耶德瑞克谈一谈。‡跟銀白聯賽場地的『純淨者』埃卓克談一談。',
  }
},
[13795] = {
  {
    'O Flagelicida‡Гроза Плети‡Der Geißelbann‡크록 스컬지베인‡El Finiquiplaga‡El Finiquiplaga‡Le Plaie-du-Fléau‡科罗克·斩亡者‡天譴剋星',
    nil,
    'Fale com Croque Flagelicida nos Campos do Torneio Argênteo.‡Поговорите с Кроком Грозой Плети в северной стороне Ристалище Серебряного турнира.‡Sprecht mit Crok Geißelbann beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 크록 스컬지베인과 대화해야 합니다.‡Habla con Crok Finiquiplaga en los Campos del Torneo Argenta.‡Habla con Crok Finiquiplaga en los Campos del Torneo Argenta.‡Parlez à Crok Plaie-du-Fléau, dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的科罗克·斩亡者谈一谈。‡跟銀白聯賽場地的克羅科·天譴剋星談一談。',
  }
},
[13796] = {
  {
    'O Coração da Floresta‡Сердце леса‡Das Herz des Waldes‡숲의 심장‡El corazón del bosque‡El corazón del bosque‡Le cœur de la forêt‡森林之心‡森林之心',
    nil,
    'Consiga o Coração da Floresta.‡Добудьте Сердце Леса.‡Beschafft das Herz des Waldes.‡숲의 심장을 획득해야 합니다.‡Obtén el corazón del bosque.‡Obtén el corazón del bosque.‡Récupérez le Cœur de la forêt.‡获得森林之心。‡取得森林之心。',
  }
},
[13797] = {
  {
    'Trabalho sujo‡Грязные делишки‡Gemeinheiten‡추악한 행동‡Trabajos sucios‡Trabajos sucios‡Des tâches ingrates‡肮脏的种子‡下流的招數',
    nil,
    'Revire as pilhas de Cascalho Fresco para achar 10 Pedaços de Minério.‡Осмотрите кучки свежих обломков и найдите 10 кусков руды.‡Durchsucht die Haufen frischen Gerölls, um 10 Erzklumpen zu finden.‡방금 조각난 막돌을 살펴서 광석 덩어리 10개를 찾아야 합니다.‡Rebusca en las pilas de restos frescos para encontrar 10 trozos de mena.‡Rebusca en las pilas de restos frescos para encontrar 10 trozos de mena.‡Fouillez les piles de Débris récents pour trouver 10 Morceaux de minerai.‡搜索新近挖掘的石块堆并找到10大块矿石。‡搜尋一堆剛落下的礫石，並找出10個礦石塊。',
  }
},
[13798] = {
  {
    'Chuva de destruição‡Огненный ливень‡Regen der Zerstörung‡파괴의 비‡Lluvia de destrucción‡Lluvia de destrucción‡La pluie de destruction‡毁灭之雨‡毀滅之雨',
    nil,
    'Usando o Minério Amaldiçoado para marcar os alvos para Draaka, você deve matar 30 Elfos Noturnos e 5 Ancientes Enraivecidos.|n|nFale com Durak para renovar seu disfarce de Diabrete.‡Бросайте проклятую руду с башен Заставы Расщепленного Дерева, чтобы обозначить цели Драаке. Убейте таким образом 30 бойцов ночных эльфов и 5 гневных древней.|n|nЕсли вам надо заново принять облик беса, обратитесь к Дурану.‡Nutzt das verfluchte Erz, um Ziele für Draaka zu markieren. Ihr müsst 30 Nachtelfentruppen und 5 tobende Urtume töten.|n|nSprecht mit Durak, um die Wichtelverkleidung aufzufrischen.‡저주받은 광석으로 드라카의 표적을 표시해 나이트 엘프 병사 30명과 분노한 고대정령 5명을 처치해야 합니다.|n|n임프로 다시 위장하려면 듀락과 대화하십시오.‡Usa la mena detestable para marcar los objetivos para Draaka. De esta forma, tienes que matar a 30 soldados elfos de la noche y 5 ancianos enfurecidos.|n|nHabla con Durak para que te vuelva a poner el disfraz de diablillo.‡Usa la mena detestable para marcar los objetivos para Draaka. De esta forma, tienes que matar a 30 soldados elfos de la noche y 5 ancianos enfurecidos.|n|nHabla con Durak para que te vuelva a poner el disfraz de diablillo.‡Utilisez le Minerai maudit afin de marquer des cibles pour Draaka. Vous devez vaincre 30 Elfes de la nuit et 5 Anciens déchaînés de cette manière.|n|nParlez à Durak pour obtenir à nouveau un Déguisement de diablotin.‡使用被诅咒的矿石为德娜卡制导，目标是杀死30名暗夜精灵部队以及5棵暴怒的古树。|n|n跟杜莱克交谈以重新获得小鬼伪装。‡使用厄運礦石來為德拉卡標記目標，你要殺死30個夜精靈部隊和5個盛怒的古樹。|n|n和杜雷克交談以再次獲得小鬼偽裝。',
  }
},
[13799] = {
  {
    'Where Are My Keys?‡Where Are My Keys?‡Wo sind meine Schlüssel?‡Where Are My Keys?‡¿Dónde tengo las llaves?‡¿Dónde tengo las llaves?‡Où sont mes clés ?‡Where Are My Keys?‡我的鑰匙呢?',
    nil,
    'Dr. Fingers wants you to kill his evil clone, Evil Fingers, and retrieve his keys.‡Dr. Fingers wants you to kill his evil clone, Evil Fingers, and retrieve his keys.‡Dr. Finger möchte, dass Ihr seinen bösen Zwilling, Bösfinger, tötet und ihm seine Schlüssel abnehmt.‡Dr. Fingers wants you to kill his evil clone, Evil Fingers, and retrieve his keys.‡El Dr. Dedos quiere que mates a su clon maligno, Dedos Malvados, y le devuelvas sus llaves.‡El Dr. Dedos quiere que mates a su clon maligno, Dedos Malvados, y le devuelvas sus llaves.‡Le Dr Pogne veut que vous trouviez son jumeau maléfique, Doigt Moniak et que vous lui repreniez ses clés.‡Dr. Fingers wants you to kill his evil clone, Evil Fingers, and retrieve his keys.‡芬格醫生希望你殺了他的邪惡複製人，邪惡芬格，並取回他的鑰匙。',
  }
},
[13800] = {
  {
    '‡‡Holt meine Schlüssel!‡‡‡‡Trouvez mes clés !‡‡',
    nil,
    '‡‡Findet die Schlüssel von Dr. Finger.‡‡‡‡Trouvez les Clés du Dr Pogne.‡‡',
  }
},
[13801] = {
  {
    'A quem vou chamar?‡Голоса мертвых эльфов‡Geisterelfen‡나이트 엘프 망령‡Elfos muertos vivientes‡Elfos muertos vivientes‡La nuit des elfes morts-vivants‡死精灵上路‡行走的死精靈',
    nil,
    'Destrua 15 fantasmas noctiélficos de qualquer tipo no Retiro de Dor\'Danil.‡Уничтожьте 15 любых призраков ночных эльфов в Обители Дор\'Данил.‡Vernichtet 15 beliebige Nachtelfengeister in den Grabhügeln von Dor’Danil.‡도르다닐 지하굴에 있는 나이트 엘프 망령 15명을 처치해야 합니다.‡Acaba con 15 elfos de la noche fantasmas cualesquiera en El Túmulo de Dor\'danil.‡Acaba con 15 elfos de la noche fantasmas cualesquiera en El Túmulo de Dor\'danil.‡Tuer 15 Elfes de la nuit fantomatiques de n\'importe quelle variété au Refuge des saisons de Dor’danil.‡消灭朵丹尼尔兽穴的任意15只暗夜精灵鬼魂。‡在朵丹尼爾獸穴殺死15隻夜精靈鬼魂。',
  }
},
[13802] = {
  {
    'The Goblin with Two Brains‡The Goblin with Two Brains‡Der Goblin mit zwei Gehirnen‡The Goblin with Two Brains‡El goblin de los dos cerebros‡El goblin de los dos cerebros‡Le gobelin aux deux cerveaux‡The Goblin with Two Brains‡有著雙腦的哥布林',
    nil,
    'Bring a Slobberfang Murloc Brain Stem to Professor Flozz along the coast.‡Bring a Slobberfang Murloc Brain Stem to Professor Flozz along the coast.‡Bringt das Stammhirn eines Sabberzahnmurlocs zu Professor Flozz an der Küste.‡Bring a Slobberfang Murloc Brain Stem to Professor Flozz along the coast.‡Llévale un bulbo raquídeo de múrloc Babacolmillo al profesor Flozz, en la costa.‡Llévale un bulbo raquídeo de múrloc Babacolmillo al profesor Flozz, en la costa.‡Apportez un Tronc cérébral de murloc crocbaveux au Professeur Flozz qui se trouve le long de la côte.‡Bring a Slobberfang Murloc Brain Stem to Professor Flozz along the coast.‡將一個涎牙魚人腦幹帶去海岸給弗洛茲教授。',
  }
},
[13803] = {
  {
    'Sangue dos fracos‡Кровь слабых‡Das Blut der Schwachen‡약자의 피‡La sangre de los débiles‡La sangre de los débiles‡Le sang des faibles‡弱者的血‡弱者的血液',
    nil,
    'Kadrak quer que você leve o Machado Ensanguentado para Durak no Posto Machadada.‡Кадрак просит вас принести окровавленный топор Дурану на Заставу Расщепленного Дерева.‡Kadrak will, dass Ihr die blutbesudelte Axt zu Durak im Splitterholzposten bringt.‡카드라크가 피에 젖은 도끼를 토막나무 주둔지에 있는 듀락에게 가져다 달라고 했습니다.‡Kadrak de El Hachazo quiere que le lleves el hacha empapada de sangre a Durak en el Puesto del Hachazo.‡Kadrak de El Hachazo quiere que le lleves el hacha empapada de sangre a Durak en el Puesto del Hachazo.‡Kadrak vous demande d’apporter la Hache imprégnée de sang à Durak, au poste de Bois-Brisé.‡卡德拉克要你把浸血战斧带给碎木岗哨的杜莱克。‡卡德拉克要你把浸血之斧帶去碎木崗哨給杜雷克。',
  }
},
[13804] = {
  {
    '‡‡Wie man ein Fischding fängt‡‡Pescar algo que se parece a un pez‡‡Attrapper une chose-poisson‡‡',
    nil,
    '‡‡Stellt die Falle auf und benutzt die Fernbedienung, um einen lebenden Sabberzahnmurloc zu fangen. Bringt die gefüllte Falle zu Professor Flozz zurück.‡‡Coloca una trampa y utiliza el mando para capturar un múrloc Babacolmillo vivo. Devuelve la trampa llena al profesor Flozz.‡‡Placez un piège et utilisez la télécommande pour capturer un Murloc crocbaveux vivant. Rapportez le piège rempli au Professeur Flozz.‡‡',
  }
},
[13805] = {
  {
    'Destrua o coração deles!‡Пронзи их сердце!‡Mitten ins Herz!‡숲의 심장 공격!‡¡Atraviésales el corazón!‡¡Atraviésales el corazón!‡Transpercez leur cœur !‡刺穿他们的心！‡刺穿他們的心臟!',
    nil,
    'Durak quer que você use o Sangue Maculado dos Kaldorei no Coração da Floresta.‡Дуран хочет, чтобы вы окропили Сердце Леса оскверненной калдорайской кровью.‡Durak will, dass Ihr das besudelte Blut der Kaldorei auf das Herz des Waldes anwendet.‡듀락이 타락한 칼도레이의 피를 숲의 심장에 사용해달라고 했습니다.‡Durak quiere que utilices la sangre de los Kaldorei mácula sobre el corazón del bosque.‡Durak quiere que utilices la sangre de los Kaldorei mácula sobre el corazón del bosque.‡Durak vous demande d\'utiliser le Sang corrompu des Kaldorei sur le Cœur de la forêt.‡杜莱克要你在森林之心上使用被污染的卡多雷之血。‡杜雷克要你把受污染的卡多雷之血用在森林之心上。',
  }
},
[13806] = {
  {
    '‡Демоническое задание‡Dämonendienst‡악마의 의무‡Responsabilidad de demonio‡‡Les faunes et la flore‡恶魔使命‡',
    nil,
    '‡Локе Окарр с Заставы Расщепленного Дерева просит вас закрыть 12 порталов сатиров в Сатирнааре и Ксавиане.‡Locke Okarr im Splitterholzposten will, dass Ihr 12 Satyrportale in Satyrnaar und Xavian schließt.‡토막나무 주둔지에 있는 록케 오카르가 사티르나르와 사비안 지역에서 사티로스 차원문 12개를 닫아달라고 했습니다.‡Locke Okarr, de El Hachazo, quiere que cierres 12 portales de sátiro en Satyrnaar y Xavian.‡‡Locke Okarr, de Bois-Brisé, vous a demandé de fermer 12 Portails des satyres, à Satyrnaar et à Xavian.‡碎木的洛克·奥卡尔要你关闭萨提纳尔和萨维亚的12座萨特传送门。‡',
  }
},
[13807] = {
  {
    '‡FLAG: Приглашение на турнир‡Kennzeichnung: Turniereinladung‡마상시합 초대장‡Invitación al Torneo‡Invitación al Torneo‡FLAG : invitation au tournoi‡‡',
    nil,
    nil,
  }
},
[13808] = {
  {
    'Missão improvável‡Миссия немыслима‡In geheimer Mission‡비현실적인 임무‡Misión improbable‡Misión improbable‡Mission improbable‡不可能是真的任务‡不大可能的任務',
    nil,
    'Kadrak quer que você use o Pó Sinalizador Secreto no Braseiro Fumegante em frente a Satyrnaar.‡Кадрак просит вас распылить секретный порошок вызова над тлеющей жаровне в Сатирнааре.‡Kadrak will, dass Ihr das Geheimsignalpulver in die schwelende Kohlenpfanne gegenüber von Satyrnaar schüttet.‡카드라크가 비밀 신호 가루를 사티르나르 맞은편에 있는 이글거리는 화로에 뿌려달라고 했습니다.‡Kadrak quiere que eches los polvos de santo y seña sobre el blandón humeante al otro lado de Satyrnaar.‡Kadrak quiere que eches los polvos de santo y seña sobre el blandón humeante al otro lado de Satyrnaar.‡Kadrak vous demande de répandre la Poudre du signal secret sur le Brasero fumant depuis Satyrnaar.‡卡德拉克要你在萨提纳尔对面的闷烧火盆里使用秘密信号粉末。‡卡德拉克希望你在越過薩提納爾的地方將秘密信號粉末用在悶燒的火盆上。',
  }
},
[13809] = {
  {
    'A ameaça vem de cima‡Атака с воздуха‡Bedrohung von oben‡위로부터의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    'Eadric, o Puro, no Torneio Argênteo, quer que você derrote Gargagelo e 3 Bombardeiros Sectários.‡Эдрик Чистый из Серебряного павильона на Ристалище Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов-сектантов.‡Eadric der Reine beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡은빛십자군 마상시합 광장에 있는 성기사 에드릭이 서리아귀와 이교도 폭격수 3명을 처치해 달라고 했습니다.‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric le Pur, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡银色比武场的纯洁者耶德瑞克要你消灭3名诅咒教派投弹手，并击败冰喉。‡銀白聯賽的『純淨者』埃卓克要你擊敗寒冽之喉和3個教徒投彈手。',
  }
},
[13810] = {
  {
    'Contra-ataque o contra-atacante‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    'Cellian Raiadiem, nos Campos do Torneio Argênteo, quer que você mate 15 integrantes da Seita dos Malditos. Você pode matar os integrantes da Seita dos Malditos em qualquer parte da Coroa de Gelo.‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Селлиана Первого Луча из Серебряного павильона на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны.‡Cellian Tagesanbruch beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Kultisten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 셀리안 데이브레이크가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Cellian Bonmatin, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez tuer des sectateurs partout dans la Couronne de glace.‡银色比武场的塞利安·碎日要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭这些诅咒教派的成员。‡銀白聯賽場地的瑟利安·破曉要你殺死15名詛咒神教的成員。你可以在寒冰皇冠任何一個地方殺死神教成員。',
  }
},
[13811] = {
  {
    'Entre campeões‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions…‡冠军的比武‡勇士們',
    nil,
    'Leve 4 Marcas do Campeão a Luuri nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Принесите 4 знака чемпиона Луури в павильон Серебряного союза на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне Похитителей Солнца.‡Bringt 4 Male des Champions zu Luuri beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 루리에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Apportez 4 Marques de champion à Luuri, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡将四枚冠军的印记交给银色比武场的鲁莉。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡帶4個勇士印記交給銀白聯賽場地的露莉。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13812] = {
  {
    'A ameaça vem de cima‡Атака с воздуха‡Bedrohung von oben‡위로부터의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    'Croque Flagelicida, no Torneio Argênteo, quer que você mate Gargagelo e 3 Bombardeiros Sectários.‡Крок Гроза Плети с Ристалища Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов-сектантов.‡Crok Geißelbann beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡은빛십자군 마상시합 광장에 있는 크록 스컬지베인이 서리아귀와 이교도 폭격수 3명을 처치해 달라고 했습니다.‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Plaie-du-Fléau, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡银色比武场的科罗克·斩亡者要你消灭3名诅咒教派投弹手，并击败冰喉。‡銀白聯賽的克羅科·天譴剋星要你擊敗寒冽之喉和3個教徒投彈手。',
  }
},
[13813] = {
  {
    'Contra-ataque o contra-atacante‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    'Zor\'be, o Dessangrador, nos Campos do Torneio Argênteo, quer que você mate 15 integrantes da Seita dos Malditos. Você pode matar os integrantes da Seita dos Malditos em qualquer parte da Coroa de Gelo.‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Зор\'бе Кровопускателя с Ристалища Серебряного турнира. Вы можете действовать в любой области Ледяной Короны.‡Zor\'be der Blutvergießer beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Kultisten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 피를 부르는 조르베가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be le Saigneur, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez tuer des sectateurs partout dans la Couronne de glace.‡银色比武场的放血者佐尔比要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭那些异教徒。‡銀白聯賽場地的『放血者』佐爾必要你殺死15名詛咒神教的成員。你可以在寒冰皇冠任何一個地方殺死神教成員。',
  }
},
[13814] = {
  {
    'Entre campeões‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions…‡冠军的比武‡勇士們',
    nil,
    'Leve 4 Marcas do Campeão a Illyrie Cadenoctis nos Campos do Torneio Argênteo.|n|nCaso perca a lança, é possível obter outra em qualquer Cavalete de Lanças próximo aos estábulos ou no Pavilhão Fendessol.‡Принесите 4 знака чемпиона Иллирии Приходу Тьмы на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне Похитителей Солнца.‡Bringt 4 Male des Champions zu Illyrie Nachtlauer beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 일라이리 나이트폴에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Apportez 4 Marques de champion à Illyrie Tombenuit, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡将四枚冠军的印记交给银色比武场的伊尔蕾·夜幕。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡帶4個勇士印記交給銀白聯賽場地的伊黎芮‧夜暮。|n|n如果你弄丟了長槍，你可以從任何一個靠近獸欄或奪日者亭閣的長槍架再拿一把。',
  }
},
[13815] = {
  {
    'Distração é a solução‡Лесоруб‡Stümpfe machen‡교란 작전‡Dejando tocones‡Dejando tocones‡De quel bois on se chauffe‡伐木‡殘枝餘幹',
    nil,
    'Krokk quer que você use o Machado Machadada para derrubar os Carvalhos do Vale Gris no Acampamento de Lenhadores Brado Guerreiro.|n|nSe você perder o Pó Sinalizador Secreto, fale com Kadrak no Posto Machadada.‡Крокк хочет, чтобы вы отправились на лесозаготовки Песни Войны и срубили там несколько дубов Ясеневого леса топором Расщепленного Дерева.|n|nЕсли вы вдруг потеряете секретный порошок вызова, поговорите с Кадраком на Заставе Расщепленного Дерева.‡Krokk will, dass Ihr mit der Splitterholzaxt die Eichen des Eschentals im Holzfällerlager des Kriegshymnenklans fällt.|n|nFalls Ihr das Geheimsignalpulver verliert, sprecht mit Kadrak im Splitterholzposten.‡크로크가 토막나무 도끼를 이용해 전쟁노래 벌목기지에 있는 잿빛 골짜기 떡갈나무를 쓰러트려달라고 했습니다.|n|n비밀 신호 가루를 잊어버리면 토막나무 주둔지에 있는 카드라크와 대화해야 합니다.‡Krokk quiere que utilices el Hacha del Hachazo para talar robles de Vallefresno en el Aserradero Grito de Guerra.|n|nSi pierdes los polvos de santo y seña, habla con Kadrak en El Hachazo.‡Krokk quiere que utilices el Hacha del Hachazo para talar robles de Vallefresno en el Aserradero Grito de Guerra.|n|nSi pierdes los polvos de santo y seña, habla con Kadrak en El Hachazo.‡Krokk vous a demandé d’utiliser la Hache de Bois-Brisé pour abattre les Chênes d’Orneval du Camp de bûcherons Chanteguerre.|n|nSi vous perdez votre Poudre du signal secret, adressez-vous à Kadrak, à Bois-Brisé.‡科罗克要你使用碎木伐木斧砍倒战歌伐木营地的灰谷橡树。然后去闷烧火盆找他。|n|n要是你丢失了秘密信号粉末，就跟碎木的科罗克谈一谈。‡柯洛克要你在戰歌伐木營地使用碎木斧，砍倒梣谷橡樹。|n|n如果你失去了你的秘密信號粉末，與碎木崗哨的卡德拉克再次交談。',
  }
},
[13816] = {
  {
    'Modo Heroico: O Planetário Celestial‡Священный планетарий (героич.)‡Heroisch: Das Himmlische Planetarium‡영웅: 별자리 투영관‡Heroico: El Planetario Celestial‡Heroico: El Planetario Celestial‡Héroïque : le planétarium céleste‡英雄：天文台‡英雄:星穹渾天儀',
    nil,
    'A Prospectora Loren no Archivum em Ulduar quer que você localize a entrada do Planetário Celestial.‡Найдите Священный планетарий по заданию геолога Лорен из Архива в Ульдуаре.‡Ausgrabungsleiterin Loren im Archivum möchte, dass Ihr den Eingang zum Himmlischen Planetarium findet.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 별자리 투영관의 입구를 찾아 달라고 했습니다.‡El prospector Loren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡El prospector Loren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé de trouver l\'entrée du Planétarium céleste.‡奥杜尔档案馆中的勘探员罗尔伦要你找到天文台的入口。‡奧杜亞大資料庫的勘察員洛倫要你找到通往星穹渾天儀的入口。',
  }
},
[13817] = {
  {
    'Modo Heroico: Disco de Dados do Archivum‡Диск доступа к Архиву (героич.)‡Heroisch: Datenscheibe des Archivums‡영웅: 고대 기록관 자료 원반‡Heroico: Disco de datos de El Archivum‡Heroico: Disco de datos de El Archivum‡Héroïque : le disque de données de l\'Archivum‡英雄：档案馆数据圆盘‡英雄:大資料庫資料圓盤',
    nil,
    'Leve o Disco de Dados do Archivum ao Console do Archivum em Ulduar.‡Отнесите диск доступа к Архиву к панели управления Архивом в Ульдуаре.‡Bringt die Datenscheibe des Archivums zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 고대 기록관 자료 원반을 가져가야 합니다.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Apportez le Disque de données de l\'Archivum à la Console de l\'Archivum dans Ulduar.‡将档案馆数据圆盘带到奥杜尔的档案馆控制台前。‡將大資料庫資料圓盤帶到奧杜亞的大資料庫控制臺。',
  }
},
[13818] = {
  {
    'Modo Heroico: Algalon‡Алгалон (героич.)‡Heroisch: Algalon‡영웅: 알갈론‡Heroico: Algalon‡Heroico: Algalon‡Héroïque : Algalon‡英雄：奥尔加隆‡英雄:艾爾加隆',
    nil,
    'Leve os Signos dos Vigilantes ao Console do Archivum em Ulduar.‡Принесите печати хранителей к панели управления Архивом в Ульдуаре.‡Bringt die Siegel der Wächter zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 감시자의 인장 묶음을 가져가야 합니다.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Apportez les Cachets des guetteurs à la Console de l\'Archivum d\'Ulduar.‡将守护者的徽记带到奥杜尔的档案馆控制台前。‡將看守者符印帶給奧杜亞的大資料庫控制臺。',
  }
},
[13819] = {
  {
    'Modo Heroico: Tudo está bem quando termina bem‡Все хорошо, что хорошо кончается (героич.)‡Heroisch: Ende gut, alles gut‡영웅: 끝이 좋으면 다 좋다‡Heroico: Bien está lo que bien acaba‡Heroico: Bien está lo que bien acaba‡Héroïque : tout est bien qui finit bien‡英雄：结果好，一切都好‡英雄:情況良好，完美收場',
    nil,
    'Leve o Código de Resposta Alfa para Rhonin em Dalaran.‡Доставьте код отклика "Альфа" Ронину в Даларан.‡Überbringt Rhonin in Dalaran den Antwortcode Alpha.‡응답 코드 알파를 달라란에 있는 로닌에게 가져가야 합니다.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Apportez le Code-réponse Alpha à Rhonin, à Dalaran.‡将回复代码阿尔法交给达拉然的罗宁。‡將回覆代碼Α帶給達拉然的羅甯。',
  }
},
[13820] = {
  {
    'Os irmãos Estourapino‡Семья Рвизасовов‡Die Gebrüder Sprengbolz‡블라스트볼트 형제‡Los hermanos Cargarrayo‡Los hermanos Cargarrayo‡Les frères Boumboulon‡布拉斯波兄弟‡爆栓兄弟',
    nil,
    'Fale com Juntatudo Estourapino nos Campos do Torneio Argênteo.‡Поговорите с Беззлом Рвизасовом на Ристалище Серебряного турнира.‡Sprecht mit Stumpi Sprengbolz am Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 베즐 블라스트볼트와 대화해야 합니다.‡Habla con Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Habla con Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Parlez à Gaspi Boumboulon dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的贝兹尔·布拉斯波谈一谈。‡跟銀白聯賽競技場的貝索·爆栓談談。',
  }
},
[13821] = {
  {
    'Modo Heroico: Signo de Freya‡Печать Фрейи (героич.)‡Heroisch: Freyas Siegel‡영웅: 프레이야의 인장‡Heroico: El sigilo de Freya‡Heroico: El sigilo de Freya‡Héroïque : le cachet de Freya‡英雄：弗蕾亚的徽记‡英雄:芙蕾雅的符印',
    nil,
    'A Prospectora Loren no Archivum em Ulduar quer que você se apodere do Signo de Freya.|n|nPara obter mais informações sobre como conseguir o Signo de Freya, consulte o Console do Archivum.‡Добудьте печать Фрейи по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiterin Loren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Freyas Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Freyas Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 프레이야의 인장을 가져와 달라고 했습니다.|n|n프레이야의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Freya.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将弗蕾亚的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得弗蕾亚的徽记。‡奧杜亞大資料庫的勘察員洛倫要你取得芙蕾雅的符印。|n|n想知道更多關於如何取得芙蕾雅的符印，請詢問大資料庫控制臺。',
  }
},
[13822] = {
  {
    'Modo Heroico: Signo de Hodir‡Печать Ходира (героич.)‡Heroisch: Hodirs Siegel‡영웅: 호디르의 인장‡Heroico: El sigilo de Hodir‡Heroico: El sigilo de Hodir‡Héroïque : le cachet de Hodir‡英雄：霍迪尔的徽记‡英雄:霍迪爾的符印',
    nil,
    'A Prospectora Loren no Archivum em Ulduar quer que você se apodere do Signo de Hodir.|n|nPara obter mais informações sobre como conseguir o Signo de Hodir, consulte o Console do Archivum.‡Добудьте печать Ходира по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiterin Loren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Hodirs Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Hodirs Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 호디르의 인장을 가져와 달라고 했습니다.|n|n호디르의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Hodir.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将霍迪尔的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得霍迪尔的徽记。‡奧杜亞大資料庫的勘察員洛倫要你取得霍迪爾的符印。|n|n想知道更多關於如何取得霍迪爾的符印，請詢問大資料庫控制臺。',
  }
},
[13823] = {
  {
    'Modo Heroico: Signo de Thorim‡Печать Торима (героич.)‡Heroisch: Thorims Siegel‡영웅: 토림의 인장‡Heroico: El sigilo de Thorim‡Heroico: El sigilo de Thorim‡Héroïque : le cachet de Thorim‡英雄：托里姆的徽记‡英雄:索林姆的符印',
    nil,
    'A Prospectora Loren no Archivum em Ulduar quer que você se apodere do Signo de Thorim.|n|nPara obter mais informações sobre como conseguir o Signo de Thorim, consulte o Console do Archivum.‡Добудьте печать Торима по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiterin Loren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Thorims Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Thorims Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 토림의 인장을 가져와 달라고 했습니다.|n|n토림의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Thorim.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将托里姆的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得托里姆的徽记。‡奧杜亞大資料庫的勘察員洛倫要你取得索林姆的符印。|n|n想知道更多關於如何取得索林姆的符印，請詢問大資料庫控制臺。',
  }
},
[13824] = {
  {
    'Modo Heroico: Signo de Mimiron‡Печать Мимирона (героич.)‡Heroisch: Mimirons Siegel‡영웅: 미미론의 인장‡Heroico: El sigilo de Mimiron‡Heroico: El sigilo de Mimiron‡Héroïque : le cachet de Mimiron‡英雄：米米尔隆的徽记‡英雄:彌米倫的符印',
    nil,
    'A Prospectora Loren no Archivum de Ulduar quer que você se apodere do Signo de Mimiron.|n|nPara obter mais informações sobre como conseguir o Signo de Mimiron, consulte o Console do Archivum.‡Добудьте печать Мимирона по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Mimirons Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Mimirons Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 미미론의 인장을 가져와 달라고 했습니다.|n|n미미론의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d’Ulduar, vous a demandé d\'obtenir le Cachet de Mimiron.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将米米尔隆的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得米米尔隆的徽记。‡奧杜亞大資料庫的勘察員洛倫要你取得彌米倫的符印。|n|n想知道更多關於如何取得彌米倫的符印，請詢問大資料庫控制臺。',
  }
},
