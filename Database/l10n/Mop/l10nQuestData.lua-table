[11788] = {
  {
    'Pra esquerda solta, pra direita aperta‡Смерть роботам!‡Eine Schraube lockern‡왼쪽은 풀고, 오른쪽은 조이고‡Dando media vuelta... Otra vuelta más‡Dando media vuelta... Otra vuelta más‡Savez-vous planter les clous ?‡左膀右臂‡左轉鬆，右轉緊',
    nil,
    'Desmonte Clanq, ED-210, Max Blasto e O Triturador, depois fale novamente com Jinqui Porcassolta na Pista de Pouso do Biela.‡Уничтожьте Шатунишку, ЕД-210, Макса Шмякса и Шлифовальщика, затем вернитесь к Джинки Гайковорот на взлетную полосу Выкрутеня.‡Nehmt Twonkie, ED-210, Max Kawummso und den Zermalmer auseinander und meldet Euch anschließend bei Jinky Flügelirre.‡트웡키, ED-210, 맥스 블라스토, 완벽분쇄기를 파괴한 다음 피즈크랭크 비행장에 있는 징키 윙넛에게 보고해야 합니다.‡Desmonta a Twonky, ED-210, Max Blasto y El Moledor y vuelve para informar a Jinky Alatuerca en la Pista de Aterrizaje de Palanqueta.‡Desmonta a Twonky, ED-210, Max Blasto y El Moledor y vuelve para informar a Jinky Alatuerca en la Pista de Aterrizaje de Palanqueta.‡Désactivez Twonky, ED-210, Max Blasto et Le Broyeur, puis retournez voir Voltij Lazimuté à la Piste d\'atterrissage de Spumelevier.‡摧毁托奇、ED-210、麦克斯·布拉斯托和研磨者，然后返回菲兹兰克机场向金吉·温纳特复命。‡拆除噹機、ED-210、極限爆衝和研磨者，然後向嘶軸簡易機場的金基·翼果回報。',
  }
},
[11789] = {
  {
    'Um soldado em apuros‡Солдат в беде‡Ein Soldat in Not‡도움이 필요한 병사‡Un soldado en apuros‡Un soldado en apuros‡Un soldat dans le besoin‡急需帮助的士兵‡需要幫助的士兵',
    nil,
    'Socorrista Antonioni, do lado de fora da Bastilha Valentia, quer que você vá até o interior do Rompe-procelas e recupere o Antipeçonha do Antonioni de uma caixa de Suprimentos de Primeiros Socorros.‡По просьбе медика Хауторна, находящегося за стенами Крепости Отваги, спуститесь в трюм "Рассекателя туч" и принесите противоядие Хауторна из ящика со средствами оказания первой помощи.‡Sanitäter Hagedorn außerhalb der Valianzfeste möchte, dass Ihr Euch ins Innere des Laderaums der Sturmbrecher begebt und Hagedorns Gegengift aus einer Kiste mit Vorräten für Erste Hilfe beschafft.‡용맹의 성채 밖에 있는 의무병 호쏜이 폭풍파괴자호 창고에 있는 구급약품 상자에서 호쏜의 해독제를 가져다 달라고 했습니다.‡El médico Espino, a las afueras de la Fortaleza Denuedo, quiere que te adentres en la bodega de El Rompetormentas y recuperes el contraveneno de Espino de un cajón de suministros de primeros auxilios.‡El médico Espino, a las afueras de la Fortaleza Denuedo, quiere que te adentres en la bodega de El Rompetormentas y recuperes el contraveneno de Espino de un cajón de suministros de primeros auxilios.‡Le docteur Aubépin, à l’extérieur du donjon de la Bravoure, veut que vous montiez dans le Brise-tempête et que vous récupériez l’Anti-venin d’Aubépin dans une caisse de Fournitures de secourisme.‡无畏要塞外的医师哈索恩要你到斩雷号的货舱里去找到急救物资箱，然后带一份哈索恩的解毒剂回来。‡驍勇要塞外的醫護兵赫索恩要你進入風暴破碎者的停靠處，從一箱急救補給中找到赫索恩的抗毒劑。',
  }
},
[11790] = {
  {
    'Sectários entre nós‡Сектанты среди нас‡Kultisten unter uns‡내부의 이교도‡Cultores entre nosotros‡Cultores entre nosotros‡Des sectateurs parmi nous‡隐藏的诅咒教徒‡教徒內奸',
    nil,
    'Fale com Capitão "Canhoto" Velabaixa acima do Rompe-procelas, na Bastilha Valentia.‡Поговорите с капитаном "Левшой" Люггером на "Рассекателе туч" в Крепости Отваги.‡Sprecht mit Kapitän "Linksdatsch" Gaffelsegel an Deck der Sturmbrecher in der Valianzfeste.‡용맹의 성채에 정박한 폭풍파괴자호 갑판에 있는 선장 "왼손잡이" 러그세일과 대화해야 합니다.‡Habla con el capitán "Zurdo" Vela al Tercio a bordo de El Rompetormentas en la Fortaleza Denuedo.‡Habla con el capitán "Zurdo" Vela al Tercio a bordo de El Rompetormentas en la Fortaleza Denuedo.‡Parlez au Capitaine Lougres « le Gaucher » sur le Brise-tempête au Donjon de la Bravoure.‡与无畏要塞内的斩雷号战舰上的“左撇子”鲁格塞尔船长谈一谈。‡『左撇子』縱帆船長談談，他就在驍勇要塞的風暴破碎者上。',
  }
},
[11791] = {
  {
    'Avisem Arlos‡Сообщить Арлосу‡Benachrichtigt Arlos‡알로스에게 통보‡Informa a Arlos‡Informa a Arlos‡Avertir Arlos‡通知阿洛斯‡通知阿爾洛斯',
    nil,
    'Fale com o General Arlos dentro da Fortaleza Interior, na Bastilha Valentia.‡Поговорите с генералом Арлосом во Внутренней крепости Отваги.‡Sprecht mit General Arlos im inneren Bereich der Valianzfeste.‡용맹의 성채의 내부 성채에 있는 장군 알로스와 대화해야 합니다.‡Habla con el general Arlos dentro del cuartel en la Fortaleza Denuedo.‡Habla con el general Arlos dentro del cuartel en la Fortaleza Denuedo.‡Parlez au Général Arlos dans le Bastion intérieur au Donjon de la Bravoure.‡与无畏要塞的中心城堡里的阿洛斯将军谈一谈。‡和阿爾洛斯將軍談談，他在驍勇要塞的內堡之中。',
  }
},
[11792] = {
  {
    'Inimigos da Luz‡Враги света‡Feinde des Lichts‡빛에 대적하는 자들‡Enemigos de la Luz‡Enemigos de la Luz‡Les ennemis de la Lumière‡圣光的敌人‡聖光的敵人',
    nil,
    'O Emissário Vurenn quer que você lute contra Necrólitos Sectários perto de Algures, ao norte da Bastilha Valentia, e recupere o Comunicado do Sectário deles.‡По заданию предвестника Вуренна сразитесь с сектантами-некролитами возле Далечья к северу от Крепости Отваги и добудьте сектантское воззвание.‡Herold Vurenn möchte, dass Ihr die Kultisten der Nekrolyten in der Nähe von Fernhain gen Norden der Valianzfeste bekämpft und ihnen das Kommuniqué der Kultisten abnehmt.‡선구자 부렌이 용맹의 성채 북쪽에 있는 아득골 근방에서 이교도 강령사들을 처치하고 이교도 성명서를 가져다 달라고 했습니다.‡El presagista Vurenn quiere que luches contra los cultores necrólitos cerca de Lindeallá al norte de la Fortaleza Denuedo y les arrebates el comunicado de cultor.‡El presagista Vurenn quiere que luches contra los cultores necrólitos cerca de Lindeallá al norte de la Fortaleza Denuedo y les arrebates el comunicado de cultor.‡Le Messager Vurenn vous demande d\'aller combattre les Sectateurs nécrolytes près de Comté-lointaine au nord du Donjon de la Bravoure et de récupérer le Communiqué des sectateurs.‡先驱者乌尔雷要你到无畏要塞北方的致远郡去寻找诅咒教徒通灵师，并从他们手上夺取诅咒教徒公报。‡先驅者瓦銳恩要你去挑戰驍勇要塞的北邊，遠郡附近的教徒通靈師，並從他們身上取得教徒公報。',
  }
},
[11793] = {
  {
    'Mais investigações‡Дальнейшее расследование‡Weitere Ermittlungen‡추가 조사‡Más investigación‡Más investigación‡Approfondir l\'enquête‡继续调查‡進一步的調查',
    nil,
    'Leve o Comunicado do Sectário para a Vindicante Yaala, dentro da estalagem na Bastilha Valentia.‡Отнесите сектантское воззвание воздаятелю Яаале в таверну в Крепости Отваги.‡Bringt das Kommuniqué der Kultisten zu Verteidigerin Yaala im Gasthaus der Valianzfeste.‡이교도 성명서를 용맹의 성채 여관 안에 있는 구원자 야알라에게 가져가야 합니다.‡Lleva el comunicado de cultor a la vindicadora Yaala dentro de la posada en la Fortaleza Denuedo.‡Lleva el comunicado de cultor a la vindicadora Yaala dentro de la posada en la Fortaleza Denuedo.‡Apportez le Communiqué des sectateurs au Redresseur de torts Yaala à l\'auberge du Donjon de la Bravoure.‡将诅咒教徒公报交给无畏要塞旅店内的守备官雅拉。‡帶著教徒公報給驍勇要塞旅館裡的復仇者亞拉。',
  }
},
[11794] = {
  {
    'A caçada começou‡Охота началась!‡Die Jagd ist eröffnet‡사냥 시작‡La veda está abierta‡La veda está abierta‡La chasse est ouverte‡猎杀行动‡獵殺開始',
    nil,
    'Vindicante Yaala quer que você use o Óculus do Exorcista em três diferentes locais na Bastilha Valentia para desmascarar e derrotar membros da Seita dos Malditos.‡Используйте око экзорциста в трех указанных местах Крепости Отваги, чтобы обнаружить и уничтожить последователей Культа Проклятых по просьбе воздаятеля Яаала.‡Verteidigerin Yaala möchte, dass Ihr das Okular des Exorzisten an den drei genannten Orten in der Valianzfeste einsetzt, um die Mitglieder des Kults der Verdammten zu enttarnen und zu töten.‡구원자 야알라가 용맹의 성채 안의 서로 다른 세 지점에서 퇴마사의 눈을 사용해, 저주받은 자들의 교단에 속한 이교도를 찾아 처치해 달라고 했습니다.‡La vindicadora Yaala quiere que uses el óculo del exorcista en tres puntos diferentes de la Fortaleza Denuedo para descubrir y derrotar a los miembros del Culto de los Malditos.‡La vindicadora Yaala quiere que uses el óculo del exorcista en tres puntos diferentes de la Fortaleza Denuedo para descubrir y derrotar a los miembros del Culto de los Malditos.‡Le Redresseur de torts Yaala vous demande d\'utiliser l\'Oculus de l\'Exorciste dans trois endroits du Donjon de la Bravoure pour percer à jour et abattre des membres du Culte des damnés.‡守备官雅拉要你前往无畏要塞的三个地点使用驱魔师的透镜，找出并击败诅咒教派的成员。‡復仇者亞拉要你在驍勇要塞的三個地點使用驅魔師之目找到詛咒神教的成員並擊敗他們。',
  }
},
[11795] = {
  {
    'Protocolo de emergência: Seção 8.2, parágrafo C‡"Действия в чрезвычайных ситуациях": раздел 8.2, параграф 3‡Notfallprotokoll: Sektion 8,2. Absatz C‡비상시 행동강령: 8.2항 3절‡Protocolo de emergencia: sección 8.2, párrafo C‡Protocolo de emergencia: sección 8.2, párrafo C‡Protocole d\'urgence : section 8.2, paragraphe C‡紧急情况守则：第8章，第2节，第3段‡緊急狀況協定:章節8.2，段落C',
    nil,
    'Recupere 6 Insígnias de Piloto do Biela dos corpos dos Pilotos de Reconhecimento do Biela e volte a falar com Renê Fuzuê, nos Poços Escaldantes.‡Снимите 6 значков пилота станции Выкрутеня с тел пилотов-разведчиков станции Выкрутеня и верните их Игги "Штопору" Шестероверту, который находится у Жгучих Прудов.‡Beschafft 6 Insignien eines Piloten von Kurbelzisch von den Leichnamen der Aufklärungspiloten von Kurbelzisch und bringt sie zurück zu Iggy "Trudelflug" Zinkenwechsel bei den Siedenden Teichen.‡피즈크랭크 정찰대 조종사의 시체에서 피즈크랭크 조종사의 계급장 6개를 회수하여, 끓어오르는 웅덩이에 있는 "곡예사" 이기 코그토글에게 전달해야 합니다.‡Recupera 6 insignias de piloto de Palanqueta de los cuerpos de los pilotos de reconocimiento de Palanqueta y devuélveselas a Iggy "Barrena" Conmutador en Las Pozas Escaldantes.‡Recupera 6 insignias de piloto de Palanqueta de los cuerpos de los pilotos de reconocimiento de Palanqueta y devuélveselas a Iggy "Barrena" Conmutador en Las Pozas Escaldantes.‡Récupérez 6 Insignes de pilote de Spumelevier sur les corps des Pilotes de reconnaissance de Spumelevier et rapportez-les à Iggy « la Vrille » Virouage, dans les Bassins Brûlants.‡在菲兹兰克侦察机飞行员的尸体上找到6枚菲兹兰克飞行员徽章，把它们交给滚烫熔池的“尾旋”伊吉·齿钉。‡從嘶軸偵查駕駛員的屍體上取得6個嘶軸駕駛員徽記，將徽記帶回沸水之池交給『尾旋』艾基·榫栓。',
  }
},
[11796] = {
  {
    'Protocolo de emergência: Seção 8.2, parágrafo D‡"Действия в чрезвычайных ситуациях": раздел 8.2, параграф 4‡Notfallprotokoll: Sektion 8,2. Paragraph D‡비상시 행동강령: 8.2항 4절‡Protocolo de emergencia: sección 8.2, párrafo D‡Protocolo de emergencia: sección 8.2, párrafo D‡Protocole d\'urgence : section 8.2, paragraphe D‡紧急情况守则：第8章，第2节，第4段‡緊急狀況協定:章節8.2，段落D',
    nil,
    'Renê Fuzuê quer que você inutilize os Destroços do Leste, os Destroços do Sul e os Destroços do Noroeste.‡Уничтожьте обломки на восточном месте крушения, южном месте крушения и северо-западном месте крушения по просьбе Игги "Штопора" Шестероверта.‡Iggy "Trudelflug" Zinkenwechsel möchte, dass Ihr die Wracks im Osten, Süden und Nordwesten beseitigt.‡"곡예사" 이기 코그토글이 동쪽 잔해, 남쪽 잔해, 북서쪽 잔해를 처리해 달라고 했습니다.‡Iggy "Barrena" Conmutador quiere que hundas unos restos al este, unos restos al sur y unos restos al noroeste.‡Iggy "Barrena" Conmutador quiere que hundas unos restos al este, unos restos al sur y unos restos al noroeste.‡Iggy « la Vrille » Virouage, dans les Bassins Brûlants, vous demande de détruire l\'Épave à l\'est, l\'Épave au sud et l\'Épave au nord-ouest.‡“尾旋”伊吉·齿钉要求你将东部残骸、一处南部残骸和一处西北部残骸彻底毁坏。‡『尾旋』艾基·榫栓要你去破壞東邊的殘骸，南邊的殘骸，以及西北邊的殘骸。',
  }
},
[11797] = {
  {
    'O cerco‡Осада‡Die Belagerung‡요새 공격‡El asedio‡El asedio‡Le siège‡虫临城下‡圍攻',
    nil,
    'Sargento Martelmonte quer que você mate 6 Rastejantes da Cripta, nas Areias de Nasam, fora da Bastilha Valentia.‡По заданию сержанта Молотогора убейте 6 некрорахнидов-ползунов в песках Назама за стенами Крепости Отваги.‡Unteroffizier Hammerberg möchte, dass Ihr 6 Gruftkriecher auf den Sanden von Nasam außerhalb der Valianzfeste tötet.‡하사관 해머힐이 용맹의 성채 밖에 있는 나삼의 갯벌에서 갈퀴발 지하마귀 6마리를 처치해 달라고 했습니다.‡El sargento Colinamartillo quiere que mates 6 reptadores de cripta en las Arenas de Nasam, a las afueras de la Fortaleza Denuedo.‡El sargento Colinamartillo quiere que mates 6 reptadores de cripta en las Arenas de Nasam, a las afueras de la Fortaleza Denuedo.‡Le sergent Martèlemont vous demande de tuer 6 Rampants des cryptes dans les Sables de Nasam à l\'extérieur du donjon de la Bravoure.‡哈默希尔中士要你到无畏要塞外的纳萨姆沙地去杀死6个地穴爬行者。‡錘丘中士要你去驍勇要塞外的納森沙地殺了6個地穴爬行者。',
  }
},
[11798] = {
  {
    'O Engrenochefe‡Механизатор‡Der Ritzelmeister‡톱니반장‡El maestro de palancas‡El maestro de palancas‡Le maître des rouages‡机甲专家麦卡佐德‡齒輪大師',
    nil,
    'Investigue o Manual do Engrenochefe e traga a Cabeça do Mecanozod para Biela Velotroll.‡Изучите Руководство механизатора и принесите голову Механозода Выкрутеню Разгоняйло.‡Untersucht das Handbuch des Ritzelmeisters und bringt Mechazods Kopf zu Kurbelzisch Vollgas zurück.‡톱니반장의 교본을 조사하고 메카조드의 머리를 피즈크랭크 풀스로틀에게 가져가야 합니다.‡Busca el manual del maestro de palancas y vuelve con la cabeza de Mecazod junto a Palanqueta Todogás.‡Busca el manual del maestro de palancas y vuelve con la cabeza de Mecazod junto a Palanqueta Todogás.‡Trouvez le Manuel du Maître des rouages Mécazod puis rapportez sa tête à Spumelevier Pleingaz.‡研究机甲专家的手册，并将麦卡佐德的徽记交给菲兹兰克·铁阀。‡研究齒輪大師的手冊，並且帶著梅卡佐德的頭回去向嘶軸·滿閥報告。',
  }
},
[11799] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡¡Profana este fuego!‡Désacralisez ce feu !‡亵渎这团火焰！‡褻瀆這些火焰!',
    nil,
    nil,
  }
},
[11800] = {
  {
