[6384] = {
  -- Item
  '‡Стильная синяя рубашка‡Modisches blaues Hemd‡세련된 파란색 셔츠‡Camisa azul con estilo‡Camisa azul con estilo‡Chemise bleue d\'apparat‡漂亮的蓝衬衣‡時髦藍襯衣',
  nil,
  nil,
  { -- Quest
    'Carona para Orgrimmar‡Дорога до Оргриммара‡Flug nach Orgrimmar‡오그리마로 날아가기‡Un viaje a Orgrimmar‡Un viaje a Orgrimmar‡Trajet vers Orgrimmar‡飞往奥格瑞玛‡飛往奧格瑞瑪',
    nil,
    'Pegue uma mantícora para a Orgrimmar com o mestre de mantícoras Devrak, depois leve as Carnes de Zargh para Orgrimmar.‡Оплатите полет в Оргриммар укротителю ветрокрылов Девраку и, оказавшись в Оргриммаре, отнесите мясные продукты Зарга Гришке.‡Bucht einen Windreiter nach Orgrimmar bei Windreitermeister Devrak und bringt dann Zarghs Fleisch zu Gryshka in Orgrimmar.‡와이번 조련사 데브락에게 요금을 치르고 오그리마까지 가서 자르그의 고기를 그리쉬카에게 배달해야 합니다.‡Cómprale un jinete del viento al maestro de jinetes del viento Devrak y llévale entonces la carne de Zargh a Gryshka en Orgrimmar.‡Cómprale un jinete del viento al maestro de jinetes del viento Burok y llévale entonces la carne de Grimtak a Gryshka en Orgrimmar.‡Acheter un voyage pour Orgrimmar, auprès du Maître des Cavaliers célestes, Devrak, puis apporter la Chair de Zargh à Gryshka, à Orgrimmar.‡从双足飞龙管理员迪弗拉克那里租一只驭风者飞往奥格瑞玛，然后将扎尔夫的肉品交给奥格瑞玛的格雷什卡。‡從雙足飛龍管理員迪弗拉克那裏租壹只馭風者飛往奧格瑞瑪，然後將紮爾夫的肉品交給奧格瑞瑪的格雷什卡。',
  }
},
[6385] = {
  -- Item
  '‡Стильная зеленая рубашка‡Modisches grünes Hemd‡세련된 녹색 셔츠‡Camisa verde con estilo‡Camisa verde con estilo‡Chemise verte d\'apparat‡漂亮的绿衬衣‡時髦綠襯衣',
  nil,
  nil,
  { -- Quest
    'Doraso, o mestre de mantícoras‡Укротитель ветрокрылов Дорас‡Doras der Windreitermeister‡와이번 조련사 도라스‡Doras, maestro de jinetes del viento‡Doras, maestro de jinetes del viento‡Doras le Maître des Cavaliers célestes‡双足飞龙管理员多拉斯‡雙足飛龍管理員多拉斯',
    nil,
    'Entregue a Carta de Gryshka para Doraso em Orgrimmar.‡Отнесите письмо Гришки Дорасу из Оргриммара.‡Bringt Gryshkas Brief zu Doras in Orgrimmar.‡그리쉬카의 편지를 오그리마에 있는 도라스에게 가져가야 합니다.‡Llévale la carta de Gryshka a Doras en Orgrimmar.‡Llévale la carta de Gryshka a Doras en Orgrimmar.‡Apporter la Lettre de Gryshka à Doras, à Orgrimmar.‡将格雷什卡的信交给奥格瑞玛的多拉斯。‡將格雷什卡的信交給奧格瑞瑪的多拉斯。',
  }
},
[6386] = {
  -- Item
  '‡Мерцающие кольчужные набедренники‡Gleißende Panzerbeinschützer‡희미하게 빛나는 쇠사슬 다리보호구‡Musleras de malla de luz trémula‡Musleras de malla de luz trémula‡Garde-jambes en mailles rougeoyantes‡微光锁甲腿甲‡微光鎖甲腿甲',
  { -- Npc
    'Guarda de Zanzil‡Оберег Занзила‡Zauberschutz von Zanzil‡잔질의 수호물‡Guardia de Zanzil‡Guardia de Zanzil‡Garde de Zanzil‡赞吉尔结界‡贊吉爾結界',
    nil,
  },
  nil,
  { -- Quest
    'Retorno à Encruzilhada.‡Возвращение на Перекресток‡Kehrt nach Crossroads zurück‡크로스로드로 돌아가기‡El regreso a El Cruce‡El regreso a El Cruce‡Retour à la Croisée‡返回十字路口‡返回十字路口',
    nil,
    'Pegue uma mantícora para a Encruzilhada com o mestre de mantícoras Doraso e leve a Carta de Gryshka para Zargh, na Encruzilhada.‡Оплатите перелет в Перекресток укротителю ветрокрылов Доресу и, оказавшись на месте, передайте письмо Гришки Заргху из Перекрестка.‡Bucht einen Windreiter nach Crossroads bei Windreitermeister Doras und bringt dann Gryshkas Brief zu Zargh in Crossroads.‡와이번 조련사 도라스에게 요금을 치르고 크로스로드까지 간 다음 그리쉬카의 편지를 자르그에게 전달해야 합니다.‡Cómprale un jinete del viento para El Cruce al maestro de jinetes del viento Doras y llévale entonces la carta de Gryshka a Zargh a en El Cruce.‡Cómprale un jinete del viento para El Cruce al maestro de jinetes del viento Doras y llévale entonces la carta de Gryshka a Zargh en El Cruce.‡Acheter un voyage pour la Croisée auprès du Maître des Cavalier célestes, Doras, puis apporter la Lettre de Gryshka à Zargh, à la Croisée.‡从驭风者管理员多拉斯那里雇一只驭风者前往十字路口，然后将格雷什卡的信交给十字路口的扎尔夫。‡從馭風者管理員多拉斯那裏雇壹只馭風者前往十字路口，然後將格雷什卡的信交給十字路口的紮爾夫。',
  }
},
[6387] = {
  -- Item
  '‡Мерцающие кольчужные наручи‡Gleißende Panzerarmschienen‡희미하게 빛나는 쇠사슬 팔보호구‡Brazales de malla de luz trémula‡Brazales de malla de luz trémula‡Brassards en mailles rougeoyantes‡微光锁甲护腕‡微光鎖甲護腕',
  { -- Npc
    'Dranh‡Дранх‡Dranh‡드라안‡Dranh‡Dranh‡Dranh‡德拉恩‡德拉恩',
    'Esfolador‡Мастер снятия шкур‡Kürschner‡전문 무두장이‡Desollador‡Desollador‡Dépeceur‡剥皮师‡剝皮訓練師',
  },
  nil,
  { -- Quest
    'Alunos brilhantes‡Награды ученикам‡Ehrenstudenten‡명예의 곡괭이‡Estudiantes de honor‡Estudiantes de honor‡L\'honneur des étudiants‡荣誉学员‡榮譽學員',
    nil,
    'Leve a Lista de Brock para Thorgrum Borrelson, em Thelsamar.‡Отнесите список Брока Торгруму Боррелсону в Телcамаре.‡Bringt Brocks Liste zu Thorgrum Borrelson in Thelsamar.‡브록의 목록을 텔사마에 있는 토르그룸 보렐손에게 가져가야 합니다.‡Lleva la lista de Brock a Thorgrum Borrelson a Thelsamar.‡Llévale la lista de Brocks a Thorgrum Borrelson en Thelsamar.‡Apportez la Liste de Brock à Thorgrum Borrelson à Thelsamar.‡将布洛克的名单交给塞尔萨玛的索格拉姆·伯雷森。‡將布洛克的名單交給塞爾薩瑪的索格拉姆·伯雷森。',
  }
},
[6388] = {
  -- Item
  '‡Мерцающее кольчужное наплечье‡Gleißende Panzerschulterstücke‡희미하게 빛나는 쇠사슬 어깨갑옷‡Espaldares de malla de luz trémula‡Espaldares de malla de luz trémula‡Espauliers en mailles rougeoyantes‡微光锁甲肩铠‡微光鎖甲肩鎧',
  { -- Npc
    'Esqueleto Zanzil‡Зомби Занзила‡Skelett von Zanzil‡잔질 해골 병사‡Esquéleto Zanzil‡Esquéleto Zanzil‡Squelette Zanzil‡赞吉尔骷髅‡贊吉爾骷髏',
    nil,
  },
  nil,
  { -- Quest
    'Grif Trovino‡Грит Турден‡Gryth Thurden‡그리스 서든‡Gryth Thurden‡Gryth Thurden‡Gryth Thurden‡格莱斯·瑟登‡格萊斯·瑟登',
    nil,
    'Entregue as Picaretas Honorárias para Grif Trovino em Altaforja.‡Отнесите почетные кирки Гриту Турдену в Стальгорне.‡Bringt die Ehrenhacken zu Gryth Thurden in Ironforge.‡명예의 곡괭이를 들고 아이언포지에 있는 그리스 서든에게 가야합니다.‡Lleva los picos honorarios a Gryth Thurden en Forjaz.‡Lleva los picos honorarios a Gryth Thurden en Forjaz.‡Apportez les Pioches d\'honneur à Gryth Thurden à Ironforge.‡将荣誉锄交给铁炉堡的格莱斯·瑟登。‡將榮譽鋤交給鐵爐堡的格萊斯·瑟登。',
  }
},
[6389] = {
  -- Item
  '‡Мерцающий кольчужный капюшон‡Gleißende Panzerhelmkappe‡희미하게 빛나는 쇠사슬 코이프‡Almófar de malla de luz trémula‡Almófar de malla de luz trémula‡Camail en mailles rougeoyantes‡微光锁甲罩帽‡微光鎖甲頭巾',
  { -- Npc
    'Necroguarda Rodrigo‡Страж смерти Подриг‡Todeswache Podrig‡죽음의경비병 포드리그‡Guardia de la Muerte Podrig‡Guardia de la Muerte Podrig‡Garde noir Podrig‡亡灵卫兵博迪瑞格‡亡靈衛兵博迪瑞格',
    nil,
  },
  nil,
  { -- Quest
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Solte os Cupins das Terras Pestilentas na Serraria de Beiranorte, depois retorne com o Barril de Cupins das Terras Pestilentas até Nataniel Dumah, no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Выпустите термитов с Чумных земель на лесопилке Северного Кряжа и возвращайтесь к Натаниэлю Дамаху в Лагерь Промозглого Ветра в Западные Чумные земли.‡Befreit die Pestländer-Termiten im Sägewerk von Northridge, dann kehrt mit dem Fass Pestländer-Termiten zu Nathaniel Dumah im Chillwind-Posten in den westlichen Pestländern zurück.‡북마루 벌목지에 역병지대 흰개미를 놓아준 다음 역병지대 흰개미 통을 가지고 서부 역병지대 서리바람 야영지에 있는 너대니얼 두마에게 돌아가야 합니다.‡Libera las termitas de las Tierras de la Peste en la Serrería Crestanorte y luego vuelve con el barril de termitas a las Tierras de la Peste del Oeste y busca a Nathaniel Dumah en el Campamento del Orvallo.‡Libera las termitas de las Tierras de la Peste en el Aserradero Crestanorte y luego vuelve con la barrica de termitas de las Tierras de la Peste a Nathaniel Dumah en el Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Libérez les Termites des Maleterres dans la scierie de la Crête du nord, puis retournez voir Nathaniel Dumah, au camp du Noroît, dans les Maleterres de l\'ouest, avec le Tonneau de Termites des Maleterres.‡使用北山伐木场里的铁棍放出那里的瘟疫白蚁，然后向西瘟疫之地冰风岗的纳萨尼尔·杜马报告。‡使用北山伐木場裏的鐵棍放出那裏的瘟疫白蟻，然後向西瘟疫之地冰風崗的納薩尼爾·杜馬報告。',
  }
},
[6390] = {
  -- Item
  '‡Выкройка: стильная синяя рубашка‡Muster: Modisches blaues Hemd‡도안: 세련된 파란색 셔츠‡Patrón: camisa azul con estilo‡Patrón: camisa azul con estilo‡Patron : Chemise bleue d\'apparat‡图样：漂亮的蓝衬衣‡圖樣:時髦藍襯衣',
  { -- Npc
    'Ulag, o Cutelo‡Улаг Колун‡Ulag der Spalter‡학살자 울라그‡Ulag el Cuchillero‡Ulag el Cuchillero‡Ulag le Fendeur‡切割者奥拉格‡『斬擊者』奧拉格',
    nil,
  },
  nil,
  { -- Quest
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Solte os Cupins das Terras Pestilentas na Serraria de Beiranorte, depois retorne com o Barril de Cupins das Terras Pestilentas até Guel Levine, no Baluarte, que fica nas Clareiras de Tirisfal.‡Выпустите термитов с Проклятых земель на лесопилке Северного Кряжа и возвращайтесь к Микки Левину в Бастион в Тирисфальских лесах.‡Befreit die Pestländer-Termiten im Sägewerk von Northridge, dann kehrt mit dem Fass Pestländer-Termiten zu Mickey Levine im Bollwerk in Tirisfal zurück.‡북마루 벌목지에 역병지대 흰개미를 놓아준 다음 역병지대 흰개미 통을 가지고 트리스팔 숲 보루에 있는 미키 레빈에게 돌아가야 합니다.‡Libera las termitas de las Tierras de la Peste en el Aserradero Crestanorte y luego vuelve con la barrica de termitas de las Tierras de la Peste a Mickey Levine en El Baluarte en los Claros de Tirisfal.‡Libera las termitas de las Tierras de la Peste en el Aserradero Crestanorte y luego vuelve con la barrica de termitas de las Tierras de la Peste a Mickey Levine en El Baluarte en los Claros de Tirisfal.‡Libérez les Termites des Maleterres dans la scierie de la Crête du nord, puis retournez voir Mickey Levine, à la Barricade, dans les Clairières de Tirisfal, avec le Tonneau de Termites des Maleterres.‡使用北山伐木场里的铁棍放出那里的瘟疫白蚁，然后向提瑞斯法林地亡灵壁垒的米克·莱文报告。‡使用北山伐木場裏的鐵棍放出那裏的瘟疫白蟻，然後向提瑞斯法林地亡靈壁壘的米克·萊文報告。',
  }
},
[6391] = {
  -- Item
  '‡Выкройка: стильная зеленая рубашка‡Muster: Modisches grünes Hemd‡도안: 세련된 녹색 셔츠‡Patrón: camisa verde con estilo‡Patrón: camisa verde con estilo‡Patron : Chemise verte d\'apparat‡图样：漂亮的绿衬衣‡圖樣:時髦綠襯衣',
  { -- Npc
    'Guerreiro do Hangar‡Воин зоны‡Bastionskrieger‡저항군 전사‡Guerrero Negador‡Guerrero Negador‡Guerrier du Hangar‡躲起来的战士‡躲起來的戰士',
    nil,
  },
  nil,
  { -- Quest
    'Carona para Altaforja‡Полет в Стальгорн‡Flug nach Ironforge‡아이언포지로 날아가기‡Vuela a Forjaz‡Vuela a Forjaz‡Voyage vers Ironforge‡飞往铁炉堡‡飛往鐵爐堡',
    nil,
    'Compre um voo de grifo para Altaforja do mestre de grifos Thorgrum Borrelson. Chegando lá, entregue a Lista de Brock para Golnir Topadão.‡Заплатите укротителю грифонов Торгруму Боррелсону, долетите на грифоне до Стальгорна и отдайте список Брока Голниру Твердопалу.‡Bucht einen Greifen nach Ironforge von Greifenmeister Thorgrum Borrelson, dann bringt Brocks Liste zu Golnir Bouldertoe in Ironforge.‡그리핀 조련사 토르그룸 보랠손에게 요금을 내고 아이언포지까지 간 다음 브록의 목록을 골니르 보울더토에게 가져가야 합니다.‡Contrata un vuelo en grifo a Forjaz con el maestro de grifos Thorgrum Borrelson para llevar la lista de Brock a Golnir Dedorroca.‡Contrata un vuelo en grifo a Forjaz con el maestro de grifos Thorgrum Borrelson y llévale la lista de Brock a Golnir Dedorroca, en Forjaz.‡Acheter un billet de gryphon pour Ironforge, auprès du Maître des gryphons, Thorgrum Borrelson, puis apporter la Liste de Brock à Golnir Bouldertoe, à Ironforge.‡从狮鹫管理员索格拉姆·伯雷森那里租一只狮鹫飞往铁炉堡，然后将布洛克的名单交给铁炉堡的高尼尔·石趾。‡從獅鷲管理員索格拉姆·伯雷森那裏租壹只獅鷲飛往鐵爐堡，然後將布洛克的名單交給鐵爐堡的高尼爾·石趾。',
  }
},
[6392] = {
  -- Item
  '‡Пояс Аругала‡Gürtel von Arugal‡아루갈의 허리띠‡Cinturón de Arugal‡Cinturón de Arugal‡Ceinture d\'Arugal‡阿鲁高的腰带‡阿魯高的腰帶',
  { -- Npc
    'Médico do Hangar‡Медик зоны‡Bastionssanitäter‡저항군 의무병‡Médico Negador‡Médico Negador‡Infirmier du Hangar‡躲起来的医师‡躲起來的醫師',
    nil,
  },
  nil,
  { -- Quest
    'Fale novamente com Brock‡Возвращение к Броку‡Rückkehr zu Brock‡브록에게 돌아가기‡Vuelve con Brock‡Regresa con Brock‡Retourner vers Brock‡向布洛克回复‡向布洛克回復',
    nil,
    'Compre um voo de grifo para Thelsamar do mestre de grifos Grif Trovino. Chegando lá, entregue as Picaretas Honorárias para Brock Buscapedra.‡Заплатите укротителю грифонов Гриту Турдену, долетите на грифоне до Телcамара и отдайте почетные кирки Броку Камнекопу.‡Bucht einen Greifen nach Thelsamar bei Greifenmeister Gryth Thurden, dann bringt die Ehrenhacken zu Brock Stoneseeker in Thelsamar.‡그리핀 조련사 그리스 서든에게 요금을 치르고 텔사마로 간 다음 명예의 곡괭이를 브록 스톤시커에게 배달해야 합니다.‡Contrata un vuelo en grifo a Thelsamar con el maestro de grifos Gryth Thurden para llevar los picos honoríficos a Brock Buscapiedras.‡Contrata un vuelo en grifo a Thelsamar con el maestro de grifos Gryth Thurden para llevar los picos honorarios a Brock Buscapiedras en Thelsamar.‡Acheter un billet de gryphon pour Thelsamar, auprès du Maître des gyphons Gryth Thurden, puis apporter les Pioches d\'honneur à Brock Stoneseeker, à Thelsamar.‡从狮鹫管理员格莱斯·瑟登那里租用一头飞往塞尔萨玛的狮鹫，然后将荣誉锄交给塞尔萨玛的布洛克·寻石者。‡從獅鷲管理員格萊斯·瑟登那裏租用壹頭飛往塞爾薩瑪的獅鷲，然後將榮譽鋤交給塞爾薩瑪的布洛克·尋石者。',
  }
},
[6393] = {
