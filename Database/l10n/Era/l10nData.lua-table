  nil,
  nil
},
[6061] = {
  -- Item
  '‡Серокаменные наручи‡Grausteinarmschienen‡회암석 팔보호구‡Brazales de piedra gris‡Brazales de piedra gris‡Brassards grisepierre‡玄武岩护腕‡玄武岩護腕',
  nil,
  nil,
  { -- Quest
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Pinote Adulto. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Yaw Crina Cortante na Aldeia Casco Sangrento.‡Приручите взрослого равнинного долгонога при помощи хлыста приручения. Потренируйтесь и верните хлыст Йо Колкой Гриве в Деревне Кровавого Копыта.‡Benutzt die Zähmrute, um einen ausgewachsenen Ebenenschreiter zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Yaw Sharpmane in Bloodhoof.‡조련용 막대를 사용해 다자란 초원타조를 길들이고 기술을 연습한 후 블러드후프 마을에 있는 요 샤프메인에게 조련용 막대를 돌려줘야 합니다.‡Usa la fusta de domador para domar un zancudo de llanura adulto. Practica un poco y devuélvele la fusta a Yaw Trampa en el Poblado Pezuña de Sangre.‡Usa la fusta de doma para domar un zancudo de llanura adulto. Practica un poco y devuélvele la fusta a Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Utiliser le Bâtonnet de domptage pour dompter un trotteur des plaines adulte. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Yaw Sharpmane, au village Bloodhoof.‡使用驯兽棒驯服成年陆行鸟。练习你的技能，然后将驯兽棒还给血蹄村的雅文·刺鬃。‡使用馴獸棒馴服成年陸行鳥。練習妳的技能，然後將馴獸棒還給血蹄村的雅文·刺鬃。',
  }
},
[6062] = {
  -- Item
  '‡Тяжелые шнуровые наручи‡Schwere Cordarmschienen‡골진 두꺼운 팔보호구‡Brazales de cordón pesados‡Brazales de cordón pesados‡Brassards de corde épaisse‡粗绳护腕‡粗繩腕索',
  nil,
  nil,
  { -- Quest
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Mosquetusco Hediondo. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Thotar no Monte Navalha.‡Приручите лютого пятнистого вепря с помощью хлыста приручения. Потренируйтесь, потом верните хлыст приручения Тотару в Колючем Холме.‡Benutzt die Zähmrute, um einen scheckigen Terroreber zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Thotar in Klingenhügel.‡조련용 막대를 사용해 사나운 점박이멧돼지를 길들여야 합니다. 기술을 연습한 후 칼바위 언덕에 있는 소타르에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de domador para domar un jabalí salvaje jaspeado. Practica un poco y devuélvele la fusta a Thotar en Cerrotajo.‡Usa la fusta de doma para domar un jabalí jaspeado temible. Practica un poco y devuélvele la fusta a Thotar en Cerrotajo.‡Utiliser le Bâtonnet de domptage pour dompter un sanglier tacheté redoutable. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Thotar de Tranchecolline.‡使用驯兽棒驯服可怕的杂斑野猪。练习你的技能，然后将驯兽棒还给剃刀岭的索塔尔。‡使用馴獸棒馴服可怕的雜斑野豬。練習妳的技能，然後將馴獸棒還給剃刀嶺的索塔爾。',
  }
},
[6063] = {
  -- Item
  '‡Рукавицы Холодной стали‡Kaltstahlstulpen‡차가운 강철 건틀릿‡Guanteletes de acero frío‡Guanteletes de acero frío‡Gantelets d\'acier glacé‡钢质护手‡鋼質護手',
  nil,
  nil,
  { -- Quest
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Tocaieira Lenhateia. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Dazalar em Dolanaar.‡С помощью хлыста приручения приручите чащобного тенетника. Поупражняйтесь, затем верните хлыст приручения Дазалару в Доланаар.‡Benutzt die Zähmrute, um einen Waldweberlauerer zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Dazalar in Dolanaar.‡조련용 막대를 사용해 나무그물 늑대거미를 길들여야 합니다. 기술을 연습한 후 돌라나르에 있는 다잘라에게 조련용 막대를 돌려주어야 합니다.‡Utiliza la fusta de domador para domar a un rondador Tejemadera. Practica tus habilidades y después devuélvele la fusta de domador a Dazalar, que está en Dolanaar.‡Utiliza la fusta de doma para domar a un rondador Tejemadera. Practica tus habilidades y después devuélvele la fusta de doma a Dazalar, que está en Dolanaar.‡Utiliser le Bâtonnet de domptage pour dompter une Rôdeuse Tissebois. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Dazalar, à Dolanaar.‡使用驯兽棒驯服树林潜伏者。练习你的技能，然后将驯兽棒还给多兰纳尔的达扎拉。‡使用馴獸棒馴服樹林潛伏者。練習妳的技能，然後將馴獸棒還給多蘭納爾的達紮拉。',
  }
},
[6064] = {
  -- Item
  '‡Миниатюрные платиновые диски‡Miniaturplatinscheiben‡소형 백금 원반‡Discos de platino en miniatura‡Discos de platino en miniatura‡Disques de platine miniatures‡迷你白金圆盘‡迷你白金圓盤',
  nil,
  nil,
  { -- Quest
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Rochetusco Grande. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Grif Selvacuore em Kharanos.‡Приручите большого скального вепря с помощью хлыста приручения. Потренируйтесь со своим новым питомцем, а затем верните хлыст приручения Грифу Дикому Сердцу в Каранос.‡Benutzt die Zähmrute, um einen großen Klippeneber zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Grif Wildheart in Kharanos.‡조련용 막대를 사용해 큰 멧돼지를 길들여야 합니다. 기술을 연습한 후 카라노스에 있는 그리프 와일드하트에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de doma para domar a un jabalí del risco grande. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Usa la fusta de doma para domar a un jabalí del risco grande. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Utiliser le Bâtonnet de domptage pour dompter un Grand sanglier des rochers. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Grif Wildheart, à Kharanos.‡使用驯兽棒驯服大型峭壁野猪。练习你的技能，然后将驯兽棒还给卡拉诺斯的格瑞夫。‡使用馴獸棒馴服大型峭壁野豬。練習妳的技能，然後將馴獸棒還給卡拉諾斯的格瑞夫。',
  }
},
[6065] = {
  -- Item
  'Ensaios de Hadggar sobre Convergência Dimensional‡Рассуждения Кадгара о пространственной сходимости‡Khadgars Abhandlungen über dimensionale Konvergenz‡차원의 집합점에 대한 카드가의 평론‡Ensayos de Khadgar sobre convergencia dimensional‡Ensayos de Khadgar sobre convergencia dimensional‡Essais de Khadgar sur la convergence dimensionnelle‡卡德加的空间收敛研究笔记‡卡德加的空間收斂研究筆記',
  nil,
  nil,
  { -- Quest
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Fale com Yaw Crina Cortante na Aldeia Casco Sangrento.‡Поговорите с Йо Колкой Гривой в Деревне Кровавого Копыта.‡Sprecht mit Yaw Sharpmane in Bloodhoof.‡블러드후프 마을에 있는 요 샤프메인과 대화해야 합니다.‡Habla con Yaw Trampa en el Poblado Pezuña de Sangre.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre, en Mulgore.‡Parler à Yaw Sharpmane, au village Bloodhoof.‡与血蹄村的雅文·刺鬃谈一谈。‡與血蹄村的雅文·刺鬃談壹談。',
  }
},
