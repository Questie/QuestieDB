[5648] = {
  -- Item
  '‡‡‡마법서: 냉기 갑옷 III‡‡‡‡‡秘典:霜甲術 III',
  { -- Npc
    'Lança-sombras Zangareia‡Темный чародей из племени Песчаной Бури‡Schattenzauberer der Sandfury‡성난모래부족 흑마술사‡Taumaturgo umbrío Furiarena‡Taumaturgo umbrío Furiarena‡Exhalombre Sandfury‡沙怒暗影法师‡沙怒暗影施法者',
    nil,
  },
  nil,
  { -- Quest
    'Vestes da espiritualidade‡Одеяния духовности‡Gewänder der Spiritualität‡신비한 주술의 로브‡Prendas de espiritualidad‡Prendas de espiritualidad‡Vêtements de la spiritualité‡灵魂之衣‡靈魂之衣',
    nil,
    'Encontre a Bruta Kor\'ja e cure suas feridas usando Cura Inferior (Grau 2). Depois disso, conceda a ela Palavra de Poder: Fortitude e fale novamente com Tai\'jin no Monte Navalha.‡Найдите рубаку Кор\'жу и исцелите ее раны, пользуясь Малым исцелением (уровень 2). Затем скажите ей Слово силы: Стойкость – и вернитесь к Тай\'джин в Колючий Холм.‡Findet die Grunzerin Kor\'ja und heilt ihre Wunden mit Hilfe von \'Geringes Heilen\' (Rang 2). Belegt sie danach mit \'Machtwort: Seelenstärke\' und kehrt dann zu Tai\'jin in Klingenhügel zurück.‡그런트 코르자를 찾아 2레벨의 하급 치유를 사용해 부상을 치유한 후, 신의 권능:인내를 부여하고 칼바위 언덕에 있는 타이진에게 돌아가십시오.‡Encuentra al bruto Kor\'ja y cura sus heridas usando la Curación inferior (Rango 2). Después, concédele Palabra de Poder: Entereza y vuelve a Cerrotajo a hablar con Tai\'jin.‡Encuentra a la bruta Kor\'ja y cura sus heridas usando la Sanación inferior (Rango 2). Después, concédele Palabra de Poder: Entereza y vuelve a Cerrotajo a hablar con Tai\'jin.‡Trouver le grunt Kor\'ja et la guérir de ses blessures en utilisant Soins inférieurs (Rang 2). Lui accorder ensuite le Mot de pouvoir : Robustesse, puis retourner voir Tai\'jin, sur Tranchecolline.‡找到步兵科雅，用次级治疗术（等级 2）治疗她，然后为她加上真言术：韧，最后向剃刀岭的泰金复命。‡找到步兵科雅，用次級治療術（等級 2）治療她，然後為她加上真言術：韌，最後向剃刀嶺的泰金復命。',
  }
},
[5649] = {
  -- Item
  '‡‡‡마법서: 눈보라‡‡‡‡‡秘典:暴風雪',
  { -- Npc
    'Bebe-sangue Zangareia‡Кровопийца из племени Песчаной Бури‡Bluttrinker der Sandfury‡성난모래부족 혈투사‡Bebesangre Furiarena‡Bebesangre Furiarena‡Buveur de sang Sandfury‡沙怒饮血者‡沙怒飲血者',
    nil,
  },
  nil,
  { -- Quest
    'Em favor da espiritualidade‡В пользу духовности‡Der Spiritualität geneigt‡숭고한 정신의 추종자‡Al servicio de la espiritualidad‡Al servicio de la espiritualidad‡Au service de la spiritualité‡部族的传统‡部族的傳統',
    nil,
    'Fale com Tai\'jin em Durotar.‡Поговорите с Тай\'джин в Дуротаре.‡Sprecht mit Tai\'jin in Durotar.‡듀로타에 있는 타이진과 대화하십시오.‡Ve a Durotar y habla con Tai\'jin.‡Ve a Durotar y habla con Tai\'jin.‡Parler à Tai\'jin en Durotar.‡与杜隆塔尔的泰金谈一谈。‡與杜隆塔爾的泰金談壹談。',
  }
},
[5650] = {
  -- Item
  '‡‡‡마법서: 음료 창조 III‡‡‡‡‡秘典:造水術 III',
  { -- Npc
    'Mandingueiro Zangareia‡Знахарь из клана Песчаной Бури‡Hexendoktor der Sandfury‡성난모래부족 의술사‡Médico brujo Furiarena‡Médico brujo Furiarena‡Sorcier-docteur Sandfury‡沙怒巫医‡沙怒巫醫',
    nil,
  },
  nil,
  { -- Quest
    'Vestes da escuridão‡Одеяния Тьмы‡Gewänder der Dunkelheit‡어둠의 로브‡Las prendas de la Oscuridad‡Las prendas de la Oscuridad‡Vêtements des ténèbres‡黑暗之衣‡黑暗之衣',
    nil,
    'Encontre o Necroguarda Querêncio e cure suas feridas usando Cura Inferior (Grau 2). Depois disso, conceda a ele Palavra de Poder: Fortitude e fale novamente com Clérigo das Trevas Beryl em Montalvo.‡Найдите стража смерти Кела и вылечите его раны заклинанием "Малое Исцеление" (ранг 2). После этого прочтите над ним "Слово Силы: Стойкость", а затем вернитесь к темному священнику Берилу в Брилл.‡Findet die Todeswache Kel und heilt seine Wunden mit Hilfe von \'Geringes Heilen\' (Rang 2). Belegt ihn danach mit \'Machtwort: Seelenstärke\' und kehrt zum dunklen Kleriker Beryl in Brill zurück.‡죽음의경비병 켈을 찾아 2레벨의 하급 치유를 사용해 부상을 치유한 후, 신의 권능: 인내를 부여하고 브릴에 있는 어둠의사제 베릴에게 돌아가야 합니다.‡Encuentra al guardia de la muerte Kel y cura sus heridas utilizando un hechizo de Curación inferior (Rango 2). A continuación, concédele la Palabra de poder: entereza, y después ve a ver de nuevo al clérigo oscuro Beryl a Rémol.‡Encuentra al Guardia de la Muerte Kel y cura sus heridas utilizando un hechizo de Sanación inferior (Rango 2). A continuación, concédele la Palabra de poder: entereza, y después ve a ver de nuevo al clérigo oscuro Beryl a Rémol.‡Trouver le Garde noir Kel et le guérir de ses blessures en utilisant Soins inférieurs (Rang 2). Lui accorder ensuite le Mot de pouvoir : Robustesse, puis retourner voir le sombre clerc Beryl, à Brill.‡找到亡灵士兵科尔并使用次级治疗术（等级 2）来治疗他。然后对他施放真言术：韧，最后向布瑞尔的黑暗牧师贝里尔复命。‡找到亡靈士兵科爾並使用次級治療術（等級 2）來治療他。然後對他施放真言術：韌，最後向布瑞爾的黑暗牧師貝裏爾復命。',
  }
},
