[947] = {
  nil,
  { -- Npc
    'Rohh, o Taciturno‡Рохх Молчаливый‡Rohh der Schweigsame‡암살자 로‡Rohh el Silencioso‡Rohh el Silencioso‡Rohh le silencieux‡沉默的罗恩‡沉默的羅恩',
