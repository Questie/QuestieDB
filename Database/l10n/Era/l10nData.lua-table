[9664] = {
  -- Item
  '‡Шлем часового‡Schildwachenschutz‡파수꾼의 머리보호구‡Guarda de centinela‡Guarda de centinela‡Casque de sentinelle‡卫戍头盔‡衛戍頭盔',
  nil,
  nil,
  { -- Quest
    'Novos postos avançados‡Новые форпосты‡Mehr Befestigungen‡새로운 전초기지 건설‡Nuevas avanzadas‡Nuevas avanzadas‡Fonder de nouveaux avant-postes‡建立新据点‡建立新據點',
    nil,
    'Capture a Torre da Coroa, a Torre da Muralha Leste, a Torre do Passo Norte e a Torre do Bosque Pestilento, nas Terras Pestilentas Orientais, depois fale novamente com o Emissário Barbabranca, na Capela Esperança da Luz.‡Захватите башню Королевской Стражи, Восточную башню, Башню Северного перевала и башню Проклятого леса в Восточных Чумных землях и вернитесь к посланнику Белобороду в Часовню Последней Надежды.‡Erobert den Turm der Kronenwache, den Ostwallturm, den Nordpassturm und den Pestwaldturm in den östlichen Pestländern. Kehrt anschließend zum Abgesandten Whitebeard bei der Kapelle des hoffnungsvollen Lichts zurück.‡동부 역병지대에 있는 산마루 경비탑, 동부방벽 경비탑, 북부관문 경비탑, 그리고 역병의 숲 경비탑을 점령한 다음 희망의 빛 예배당에 있는 사절 화이트비어드에게 돌아가야 합니다.‡Captura la Torre de la Guardia de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Barbablanca en la Capilla de la Esperanza de la Luz.‡Captura la Torre de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Barbablanca en la Capilla de la Esperanza de la Luz.‡Capturez la Tour de la garde de la couronne, la Tour du Mur d’est, la Tour du Col du nord et la Tour de Pestebois dans les Maleterres de l’est. Revenez ensuite voir l’émissaire Whitebeard à la Chapelle de l’Espoir de Lumière.‡夺取东瘟疫之地的皇冠哨塔、东墙哨塔、北地哨塔和病木林哨塔，然后向圣光之愿礼拜堂的白须大使复命。‡奪取東瘟疫之地的皇冠哨塔、東墻哨塔、北地哨塔和病木林哨塔，然後向聖光之願禮拜堂的白須大使復命。',
  }
},
[9665] = {
  -- Item
  '‡Перчатки Крылогребня‡Flügelwappenhandschuhe‡날개깃 장갑‡Guantes Crestala‡Guantes Crestala‡Gants du cimier ailé‡羽冠手套‡羽冠手套',
  nil,
  nil,
  { -- Quest
    'Reforçando nossas defesas‡Укрепим оборону‡Verstärkung der Verteidigung‡방어선 강화‡Fortalecimiento de nuestras defensas‡Fortalecimiento de nuestras defensas‡Renforcer nos défenses‡加强防御‡加強防禦',
    nil,
    'Capture a Torre da Coroa, a Torre da Muralha Leste, a Torre do Passo Norte e a Torre do Bosque Pestilento, nas Terras Pestilentas Orientais, depois fale novamente com o Emissário Gormok, na Capela Esperança da Luz.‡Захватите башню Королевской Стражи, Восточную башню, Башню Северного перевала и башню Проклятого леса в Восточных Чумных землях и возвращайтесь к посланнику Гормоку в Часовню Последней Надежды.‡Erobert den Turm der Kronenwache, den Ostwallturm, den Nordpassturm und den Pestwaldturm in den östlichen Pestländern. Kehrt anschließend zum Abgesandten Gormok bei der Kapelle des hoffnungsvollen Lichts zurück.‡동부 역병지대에 있는 산마루 경비탑, 동부방벽 경비탑, 북부관문 경비탑, 그리고 역병의 숲 경비탑을 점령한 다음 희망의 빛 예배당에 있는 사절 고르목에게 돌아가십시오.‡Captura la Torre de la Guardia de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Gormok en la Capilla de la Esperanza de la Luz.‡Captura la Torre de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Gormok en la Capilla de la Esperanza de la Luz.‡Capturez la Tour de la garde de la couronne, la Tour du Mur d’est, la Tour du Col du nord et la Tour de Pestebois dans les Maleterres de l’est. Revenez ensuite voir l’émissaire Gormok à la Chapelle de l’Espoir de Lumière.‡夺取东瘟疫之地的皇冠哨塔、东墙哨塔、北地哨塔和病木林哨塔，然后向圣光之愿礼拜堂的高莫克大使复命。‡奪取東瘟疫之地的皇冠哨塔、東墻哨塔、北地哨塔和病木林哨塔，然後向聖光之願禮拜堂的高莫克大使復命。',
  }
},
