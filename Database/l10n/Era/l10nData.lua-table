  nil,
  { -- Npc
    'Andarilho Errante da Floresta‡Бродячий лесной древень‡Wandernder Waldgänger‡떠도는 나무정령‡Caminabosques deambulante‡Caminabosques deambulante‡Marcheur des bois errant‡森林漫游者‡森林漫遊者',
