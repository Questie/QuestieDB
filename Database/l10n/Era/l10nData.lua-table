[5201] = {
  -- Item
  '‡Углекаменный посох‡Glutsteinstab‡붉은 석탄 지팡이‡Bastón de Piedra Ígnea‡Bastón de Piedra Ígnea‡Bâton pierrebraise‡火石法杖‡火石法杖',
  nil,
  nil,
  { -- Quest
    'Invasão dos Invernosos‡Вторжение племени Зимней Спячки‡Eindringlinge der Winterfelle‡눈사태일족의 침략‡Intrusión Nevada‡Intrusión Nevada‡L\'incursion des Tombe-hiver‡冬泉熊怪的侵扰‡冬泉熊怪的侵擾',
    nil,
    'Ripárion Glaciares quer que você mate 5 Xamãs Invernosos e 5 Ursinos Invernosos.‡По заданию Риверна Холодного Ветра убейте 5 шаманов и 5 ведмедей из клана Зимней Спячки.‡Rivern Frostwind möchte, dass Ihr 5 Schamanen der Winterfelle und 5 Ursa der Winterfelle erschlagt.‡리베른 프로스트윈드가 눈사태일족 주술사 5마리와 눈사태일족 펄볼그 5마리를 처치하도록 요청했습니다.‡Rivern Ventogélido quiere que mates 5 chamanes Nevada y 5 ursas Nevada.‡Rivern Ventogélido quiere que mates 5 chamanes Nevada y 5 ursas Nevada.‡Rivern Frostwind veut que vous tuiez 5 Chamans Tombe-hiver et 5 Ursas Tombe-hiver.‡雷沃·霜翼要你去杀死5个冬泉萨满祭司和5个冬泉巨熊怪。‡雷沃·霜翼要妳去殺死5個冬泉薩滿祭司和5個冬泉巨熊怪。',
  }
},
[5202] = {
  -- Item
  '‡Верхняя рубашка корсара‡Korsarenüberhemd‡해적의 셔츠‡Sobrecamisa de corsario‡Sobrecamisa de corsario‡Casaque de corsaire‡海盗的罩衫‡海盜的罩衫',
  { -- Npc
    'Alvo de Arqueiros‡Мишень для лучников‡Zielscheibe‡궁술 표적‡Objetivo de tiro con arco‡Objetivo de tiro con arco‡Cible d\'archer‡箭靶‡箭靶',
    nil,
  },
  nil,
  { -- Quest
    'Uma estranha chave vermelha‡Странный красный ключ‡Ein merkwürdiger roter Schlüssel‡이상한 붉은 열쇠‡Una extraña llave roja‡Una extraña llave roja‡Une étrange clé rouge‡奇怪的红钥匙‡奇怪的紅鑰匙',
    nil,
    'Procure em Jaedenar o que pode ser aberto pela Chave Vermelho Sangue.‡Обыщите Джеденар и найдите замок, который открывается странным красным ключом.‡Durchsucht Jaedenar, um herauszufinden, wofür der blutrote Schlüssel verwendet wird.‡자에데나르를 뒤져 이 붉은 열쇠의 용도를 알아내야 합니다.‡Recorre Jaedenar y descubre para qué se utiliza la llave roja de sangre.‡Recorre Jaedenar y descubre para qué se utiliza la llave roja de sangre.‡Chercher dans Jaedenar à quoi sert la Clé rouge sang.‡搜寻加德纳尔，找出血红钥匙的用途。‡搜尋加德納爾，找出血紅鑰匙的用途。',
  }
},
[5203] = {
  -- Item
  'Garra de Predador das Estepes‡Коготь хищника плоскогорья‡Flachlandstreunerklauen‡굶주린 평원퓨마 발톱‡Garra de merodeador de las estepas‡Garra de merodeador de las estepas‡Griffe de Rôdeur des basses plaines‡平原徘徊者的爪子‡平原徘徊者的爪子',
  nil,
  nil,
  { -- Quest
    'Resgate de Jaedenar‡Спасение из Джеденара‡Rettung aus Jaedenar‡자에데나르 탈출‡El rescate en Jaedenar‡Rescate de Jaedenar‡Sauvetage à Jaedenar‡逃出加德纳尔‡逃出加德納爾',
    nil,
    'Escolte Arko\'narin até onde Forjaleve e o equipamento dela estão, e então a proteja enquanto escapam da Fortaleza do Concílio das Sombras. Depois, procure Jessir Lunarco em Selva Maleva para informá-la sobre o que houve com os amigos dela.‡Сопроводите Арко\'нарин туда, где лежат меч Светлая Сталь и снаряжение Арконарин, и защитите ее при побеге из Оплота Теней. Потом разыщите Джессиру Лунную Радугу в Оскверненном лесу и расскажите ей, что случилось с ее друзьями.‡Bringt Arko\'narin dorthin, wo Lightforge und ihre Ausrüstung aufbewahrt werden, und beschützt sie dann bei eurer Flucht aus der Schattenfeste. Sucht danach Jessir Moonbow im Teufelswald auf und lasst sie wissen, was mit ihren Freunden geschehen ist.‡아르코나린을 그녀의 방어구와 라이트포지가 있는 곳까지 호위해 간 후, 함께 어둠의 요새에서 빠져나가야 합니다. 그런 다음, 악령의 숲에 있는 제시 문보우를 찾아가 그녀의 친구들에게 무슨 일이 있었는지 알려 주어야 합니다.‡Escolta a Arko\'narin hasta el lugar en el que están Forjaluz y su equipo y protégela en la huida de la Guarida Sombría. Después, busca a Jessir Arcolunar en Frondavil para contarle lo que les ha ocurrido a sus amigos.‡Escolta a Arko\'narin hasta el lugar en el que están Forjaluz y su equipo y protégela en la huida de la Guarida Sombría. Después, busca a Jessir Arcolunar en Frondavil para contarle lo que les ha ocurrido a sus amigos.‡Escorter Arko\'narin à l’endroit où Lightforge et son équipement sont détenus, puis la protéger lors de l’évasion du Fort des ombres. Ensuite, aller trouver Jessir Moonbow dans Gangrebois pour lui apprendre ce qui est arrivé à ses amis.‡护送亚科纳琳到莱弗治和她的装备所在的地方，然后保护她逃离暗影堡。之后，在费伍德森林找杰希尔·月弓，并告诉她刚才发生的事情。‡護送亞科納琳到萊弗治和她的裝備所在的地方，然後保護她逃離暗影堡。之後，在費伍德森林找傑希爾·月弓，並告訴她剛才發生的事情。',
  }
},
[5204] = {
  -- Item
  'Cinto Plumassangue‡Пояс Кровавых перьев‡Blutfedergürtel‡붉은깃털일족 허리띠‡Cinturón Sangrepluma‡Cinturón Sangrepluma‡Ceinture plumesang‡血羽腰带‡血羽腰帶',
  { -- Npc
    'Boticária Zilda‡Аптекарь Зинг‡Apothekerin Zinge‡연금술사 진게‡Boticaria Zinge‡Boticaria Zinge‡Apothicaire Zinge‡药剂师金格‡藥劑師金格',
    'Real Sociedade de Boticários‡Королевское фармацевтическое общество‡Königliche Apothekervereinigung‡왕립 연금술 학회‡Sociedad Real de Boticarios‡Sociedad Real de Boticarios‡Société royale des apothicaires‡皇家药剂师学会‡皇家藥劑師學會',
  },
  nil,
  { -- Quest
    'Retaliação da Luz‡Воздаяние Света‡Vergeltung des Lichts‡정의의 복수‡La reprensión de la Luz‡Reprensión de la Luz‡Le châtiment de la Lumière‡光明的惩戒‡光明的懲戒',
    nil,
    'Volte a Jaedenar e mate o súcubo Rakaiah antes de encontrar os Restos Mortais de Trey Forjaleve.‡Вернитесь в Джеденар и убейте суккуба Ракайю, затем отыщите останки Трея Светогорна.‡Kehrt nach Jaedenar zurück und tötet den Sukkubus Rakaiah, bevor Ihr die Überreste von Trey Lightforge sucht.‡자에데나르로 돌아가 서큐버스 라카이아를 처치한 후, 트레이 라이트포지의 유해를 찾아와야 합니다.‡Vuelve a Jaedenar y mata al súcubo Rakaiah antes de encontrar los Restos de Trey Forjaluz.‡Vuelve a Jaedenar y mata al súcubo Rakaiah antes de encontrar los Restos de Trey Forjaluz.‡Revenir à Jaedenar et tuer la succube Rakaiah avant de trouver le Cadavre de Trey Lightforge.‡回到加德纳尔杀了魅魔拉凯雅，然后找到特雷·莱弗治的残骸。‡回到加德納爾殺了魅魔拉凱雅，然後找到特雷·萊弗治的殘骸。',
  }
},
