  nil,
  { -- Quest
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Entregue o Soro da Verdade do Faustino para Sicário Zaqueu no Refúgio dos Mendigos.‡Отдайте сыворотку правды Фаустина стражу смерти Зредусу в Приюте Бродяги.‡Gebt Faustins Wahrheitsserum dem Todespirscher Zraedus im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 죽음의추적자 즈레더스에게 파우스틴의 진실의 물약을 가져가야 합니다.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Remettre le Sérum de vérité de Faustin au traqueur noir Zraedus au Repaire des mendiants.‡把法奥斯丁的真言药水交给乞丐鬼屋的亡灵哨兵莱度斯。‡把法奧斯丁的真言藥水交給乞丐鬼屋的亡靈哨兵萊度斯。',
  }
},
[1389] = {
  -- Item
  '‡Молот кобольдского горняка‡Bergbauschlaghammer eines Kobolds‡코볼트의 채광용 돌망치‡Marra de minería de kóbold‡Marra de minería de kóbold‡Massette de mine kobold‡狗头人的大锤‡狗頭人的大錘',
  nil,
  nil,
  { -- Quest
    'Cristais de draenetista‡Кристаллы дренейского аметиста‡Draenethystkristalle‡드레니시스트 수정‡Cristales draenetistas‡Cristales draenetistas‡Les cristaux de draenéthyste‡德莱尼水晶‡德萊尼水晶',
    nil,
    'Leve 6 Cristais de Draenetista para Magtoor no Pântano das Mágoas.‡Принесите 6 кристаллов дренейского аметиста Магтуру в Убежище в Болоте Печали.‡Bringt 6 Draenethystkristalle zu Magtoor im sicheren Hafen in den Sümpfen des Elends.‡슬픔의 늪의 피난처에 있는 막투르에게 드레니시스트 수정 6개를 가져가야 합니다.‡Llévale 6 cristales draenetistas a Magtoor que está en El Malecón del Pantano de las Penas.‡Llévale 6 cristales draenetistas a Magtoor que está en El Puerto del Pantano de las Penas.‡Apporter 6 Cristaux de draenéthyste à Magtoor au Havre boueux du marais des Chagrins.‡给悲伤沼泽避难营地里的玛格图尔带去6块德莱尼水晶。‡給悲傷沼澤避難營地裏的瑪格圖爾帶去6塊德萊尼水晶。',
  }
},
[1391] = {
  -- Item
  '‡Посох мистика из стаи Речной Лапы‡Mystikerstab der Flusspfoten‡칼퀴발일족 비술사 지팡이‡Bastón místico Zarparrío‡Bastón místico Zarparrío‡Bâton mystique rivepatte‡河爪秘法杖‡河爪秘法杖',
  nil,
  nil,
  { -- Quest
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Leve a Cerveja de Zaerdus para Infiltrador Marksen no Pedregal.‡Отнесите бражку Зредуса секретному агенту Марксену в Каменор.‡Bringt Zraedus\' Bräu zu Spitzel Marksen in Stonard.‡스토나드에 있는 첩보원 마크슨에게 즈레더스의 맥주를 가져가야 합니다.‡Lleva el brebaje de Zraedus al infiltrador Marksen a Rocal.‡Lleva el brebaje de Zraedus al infiltrado Marksen a Rocal.‡Apporter la Bière de Zraedus à l\'Infiltrateur Marksen à Stonard.‡把莱度斯的酒带给斯通纳德的间谍玛克森。‡把萊度斯的酒帶給斯通納德的間諜瑪克森。',
