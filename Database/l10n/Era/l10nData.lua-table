[5081] = {
  -- Item
  '‡Сумка из шкуры кодо‡Kodobalgtasche‡코도 가죽 자루‡Bolsa de pellejo de kodo‡Bolsa de pellejo de kodo‡Sac en cuir de kodo‡科多兽皮包‡科多獸皮包',
  { -- Npc
    'Carlo Rivera‡Коннор Риверс‡Connor Rivers‡코너 리버즈‡Connor Ríos‡Connor Ríos‡Connor Rivers‡科诺尔·瑞沃斯‡科諾爾·瑞沃斯',
    'Chef Aprendiz‡Ученик повара‡Kochlehrling‡수습 요리사‡Aprendiz chef‡Aprendiz chef‡Apprenti cuisinier‡见习厨师‡見習廚師',
  },
  nil,
  { -- Quest
    'A missão de Maxwell‡Миссия Максвелла‡Maxwells Mission‡맥스웰의 임무‡La misión de Maxwell‡La misión de Maxwell‡Mission de Maxwell‡麦克斯韦尔的任务‡麥克斯韋爾的任務',
    nil,
    'Vá para o Pico da Rocha Negra e mate o Senhor da Guerra Voone, o Grão-lorde Omokk e o Lorde Supremo Wyrmthalak. Fale novamente com o Oficial Maxwell quando terminar o trabalho.‡Отправляйтесь на пик Черной горы и устраните воеводу Вуна, вождя Омокка и повелителя Змейталака. По выполнении задания вернитесь к маршалу Максвеллу.‡Reist zur Blackrockspitze und schaltet Kriegsmeister Voone, Hochlord Omokk und Oberanführer Wyrmthalak aus. Kehrt zu Marshal Maxwell zurück, wenn Eure Aufgabe erledigt ist.‡검은바위 첨탑으로 가서 대장군 부네와 대군주 오모크, 그리고 요새의 대군주 웜타라크를 처치해야 합니다. 임무를 완수하면 맥스웰 치안 대장에게 돌아가십시오.‡Viaja a la Cumbre de Roca Negra y destruye al maestro de guerra Voone, al alto señor Omokk y al Señor Supremo Vermiothalak. Vuelve junto al alguacil Maxwell cuando hayas acabado tu trabajo.‡Viaja a la Cumbre de Roca Negra y acaba con el maestro de guerra Voone, el alto señor Omokk y el señor supremo Vermiothalak.‡Se rendre au Pic Blackrock et tuer le maître de guerre Voone, le généralissime Omokk, et le seigneur Wyrmthalak. Retourner auprès du maréchal Maxwell quand la tâche a été accomplie.‡到黑石塔去消灭指挥官沃恩、欧莫克大王和维姆萨拉克。完成任务之后回到麦克斯韦尔元帅处复命。‡到黑石塔去消滅指揮官沃恩、歐莫克大王和維姆薩拉克。完成任務之後回到麥克斯韋爾元帥處復命。',
  }
},
[5082] = {
  -- Item
  '‡Тонкая кожа кодо‡Dünnes Kodoleder\'Dünn\' ist ein relativer Begriff...‡얇은 코도 가죽‡Cuero fino de kodo‡Cuero fino de kodo‡Cuir fin de kodo‡薄科多兽皮‡薄科多獸皮',
  { -- Npc
    'Vincent Hyal‡Винсент Хьял‡Vincent Hyal‡빈센트 하이얄‡Vincent Hyal‡Vincent Hyal‡Vincent Hyal‡文森特·海厄尔‡文森·海爾',
    nil,
  },
  nil,
  { -- Quest
    'A ameaça dos Invernosos‡Угроза со стороны Зимней Спячки‡Bedrohung durch die Winterfelle‡눈사태일족의 위협‡La amenaza de los Nevada‡La amenaza de los Nevada‡La menace des Tombe-hiver‡冬泉熊怪的威胁‡冬泉熊怪的威脅',
    nil,
    'Bruna Covaneve, de Hibérnia, quer que você mate 8 Desbravadores Invernosos, 8 Vigias do Covil dos Invernosos e 8 Totêmicos Invernosos.‡По просьбе Доновы Снегоноры из Зимних Ключей убейте 8 землепроходцев, 8 дозорных и 8 тотемистов из племени Зимней Спячки.‡Donova Snowden in Winterspring möchte, dass Ihr 8 Pfadfinder der Winterfelle, 8 Höhlenbehüter der Winterfelle und 8 Totemiker der Winterfelle erledigt.‡여명의 설원에 있는 도노바 스노우덴이 눈사태일족 길잡이 8마리, 눈사태일족 보초 8마리, 눈사태일족 토템술사 8마리를 처치해달라고 요청했습니다.‡Donova Cubilnevado de Cuna del Invierno quiere que mates 8 abrecaminos Nevada, 8 Vigilantes del cubil Nevada y 8 totémicos Nevada.‡Donova Cubilnevado de Cuna del Invierno quiere que mates 8 abrecaminos Nevada, 8 vigías del cubil Nevada y 8 totémicos Nevada.‡Donova Snowden du Berceau-de-l\'Hiver veut que vous tuiez 8 Guides, 8 Protecteurs et 8 Totémiques de la tribu Tombe-hiver.‡冬泉谷的多诺瓦·雪山要你去杀死8个冬泉探路者、8个冬泉巢穴守卫和8个冬泉图腾师。‡冬泉谷的多諾瓦·雪山要妳去殺死8個冬泉探路者、8個冬泉巢穴守衛和8個冬泉圖騰師。',
  }
},
[5083] = {
  -- Item
  '‡Выкройка: сумка из шкуры кодо‡Muster: Kodobalgtasche‡도안: 코도 가죽 가방‡Patrón: bolsa de pellejo de kodo‡Patrón: bolsa de pellejo de kodo‡Patron : Sac en cuir de kodo‡图样：科多兽皮包‡圖樣:科多獸皮包',
  { -- Npc
    'Tabelião Lendry‡Клерк Лендри‡Amtmann Lendry‡서기관 렌드리‡Dependiente Lendry‡Secretario Lendry‡Greffier Lendry‡书记员伦德瑞‡書記員倫德瑞',
    nil,
  },
  nil,
  { -- Quest
    'Aguardente Invernosa‡Огненная вода племени Зимней Спячки‡Feuerwasser der Winterfelle‡눈사태일족 화주‡Piroagua Nevada‡Aguardiente Nevada‡L\'eau de feu de Tombe-hiver‡冬泉火酒‡冬泉火酒',
    nil,
    'Leve o Frasco Vazio de Aguardente para Bruna Covaneve em Hibérnia.‡Принесите Донове Снегоноре пустую флягу из-под огненной воды.‡Bringt das leere Feuerwasserfläschchen zu Donova Snowden in Winterspring.‡여명의 설원에 있는 도노바 스노우덴에게 빈 화주 시험관을 갖다주어야 합니다.‡Lleva el Frasco vacío de piroagua a Donova Cubilnevado de Cuna del Invierno.‡Lleva el frasco vacío de aguardiente a Donova Cubilnevado de Cuna del Invierno.‡Apporter le Flacon d\'eau de feu vide à Donova Snowden du Berceau-de-l\'Hiver.‡将空的火酒瓶交给冬泉谷的多诺瓦·雪山。‡將空的火酒瓶交給冬泉谷的多諾瓦·雪山。',
  }
},
[5084] = {
  -- Item
  'Cabeça do Barão Longacosta‡Голова Барона Дольноберега‡Baron Küstenschippers Kopf‡롱쇼어 남작의 머리카락‡Cabeza del barón Longavera‡Cabeza del capitán Garvey‡Tête du baron de Longrivage‡巴隆·朗绍尔的头颅‡巴隆·朗紹爾的頭顱',
  { -- Npc
    '‡‡‡‡‡‡‡‡鐵爐堡的齊恩',
    nil,
  },
  nil,
  { -- Quest
    'Cedendo à corrupção‡Поддавшиеся порче‡Der Verderbnis erliegen‡타락에 빠지다‡Sucumbir a la corrupción‡Sucumbir a la corrupción‡Corrompu‡堕落熊怪‡墮落熊怪',
    nil,
    'Investigue o acampamento dos pelursos Lenha Morta na parte norte de Selva Maleva para encontrar alguma pista.‡Исследуйте поселение фурболгов из племени Мертвого Леса в северной части Оскверненного леса в поисках ключа к разгадке.‡Durchsucht das Furbolglager der Totenwaldfelle im nördlichen Teil des Teufelswalds nach einem Hinweis.‡악령의 숲 북부에 있는 마른가지일족 펄볼그 야영지에서 단서를 찾아야 합니다.‡Busca una pista en el campamento fúrbolg Muertobosque en el norte de Frondavil.‡Busca una pista en el campamento fúrbolg Muertobosque en el norte de Frondavil.‡Chercher un indice dans le camp des furbolgs Mort-bois, dans le nord de Gangrebois.‡搜寻费伍德森林北部的死木熊怪的营帐，继续寻找线索。‡搜尋費伍德森林北部的死木熊怪的營帳，繼續尋找線索。',
  }
},
[5085] = {
  -- Item
  'Presa de Javatusco Costagulha‡Клык дыбогривого свинобраза‡Stacheleberhauer der Borstennacken‡뾰족털 가시멧돼지 어금니‡Colmillo de jabaespín erizapúas‡Colmillo de jabaespín‡Défense de huran Dos-hirsute‡刺背野猪人的獠牙‡刺背野豬人的獠牙',
  { -- Npc
    'Guarda do Pontal de Vigília‡Караульный Сторожевого поста‡Wache der Späherwacht‡감시초소 경비병‡Guardia del Punto Argos‡Guardia del Punto Argos‡Garde de la halte de la Vigie‡警戒哨岗卫兵‡警戒崗哨衛兵',
    nil,
  },
  nil,
  { -- Quest
    'Meleca misteriosa‡Таинственная слизь‡Geheimnisvoller Glibber‡신비한 액체‡Baba misteriosa‡Baba misteriosa‡Gelée mystère‡神秘的粘液‡神秘的粘液',
    nil,
    'Informe Bruna Covaneve sobre as suas descobertas.‡Вернитесь к Донове и сообщите ей о своих находках.‡Berichtet Donova Snowden von Euren Entdeckungen.‡발견한 사실을 도노바 스노우덴에게 알려야 합니다.‡Informa sobre tus descubrimientos a Donova Cubilnevado.‡Informa sobre tus descubrimientos a Donova Cubilnevado.‡Aller faire un rapport de vos trouvailles à Donova Snowden.‡将你的发现报告给多诺瓦·雪山。‡將妳的發現報告給多諾瓦·雪山。',
  }
},
[5086] = {
  -- Item
  'Cascos de Zevra‡Копыта жевры‡Zhevra-Hufe‡얼룩말 발굽‡Pezuñas de zhebra‡Pezuñas de zhebra‡Sabots de zhévra‡斑马蹄‡角斑馬蹄',
  { -- Npc
    'Capitão do Pontal de Vigília‡Капитан Сторожевого поста‡Captain der Späherwacht‡감시초소 경비대장‡Capitán del Punto Argos‡Capitán del Punto Argos‡Capitaine de la halte de la Vigie‡警戒哨岗上尉‡衛摩爾上尉',
    nil,
  },
  nil,
  { -- Quest
    'Horrores tóxicos‡Ядовитый Ужас‡Toxinschrecken‡맹독 정령‡Horrores tóxicos‡Horrores tóxicos‡Horreurs toxiques‡剧毒之水‡劇毒之水',
    nil,
    'Colha 3 Gotinhas de Horror Tóxico para Bruna Covaneve em Hibérnia.‡Соберите 3 капли ядовитого ужаса и принесите их Донове Снегоноре в Зимние Ключи.‡Sammelt 3 Toxinschrecken-Tröpfchen für Donova Snowden in Winterspring.‡여명의 설원에 있는 도노바 스노우덴에게 맹독 정령 수액 3개를 갖다주어야 합니다.‡Recoge 3 gotitas horror tóxico para Donova Cubilnevado de Cuna del Invierno.‡Recoge 3 gotitas de horror tóxico para Donova Cubilnevado de Cuna del Invierno.‡Récolter 3 Gouttelettes d\'Horreur toxique pour Donova Snowden au Berceau-de-l\'Hiver.‡为冬泉谷的多诺瓦·雪山收集3份剧毒水滴。‡為冬泉谷的多諾瓦·雪山收集3份劇毒水滴。',
  }
},
[5087] = {
  -- Item
  'Bico de Pinote‡Клюв долгонога‡Ebenenschreiter-Schnabel‡초원타조 부리‡Pico de zancudo de llanura‡Pico de zancudo de llanura‡Bec de trotteur des plaines‡陆行鸟的喙‡陸行鳥的喙',
  { -- Npc
    'Do\'gol‡До\'гол‡Do\'gol‡도골‡Do\'gol‡Do\'gol‡Do\'gol‡杜高尔‡杜高爾',
    nil,
  },
  nil,
  { -- Quest
    'Mensageiros Invernosos‡Гонцы Зимней Спячки‡Läufer der Winterfelle‡눈사태일족 정찰꾼‡Corredores Nevada‡Corredores Nevada‡Les messagers des Tombe-hiver‡冬泉信使‡冬泉信使',
    nil,
    'Encontre os Mensageiros Invernosos e impeça-os de entregar o carregamento à Aldeia dos Invernosos.‡Найдите гонцов из племени Зимней Спячки и не позвольте им донести их груз до их деревни.‡Sucht die Läufer der Winterfelle und hindert sie daran, ihre Lieferung zum Lager der Winterfelle zu bringen.‡눈사태일족 정찰꾼들을 찾아 눈사태일족 마을로 물건을 전달하는 것을 막아야 합니다.‡Encuentra a los corredores Nevada y detenlos antes de que entreguen su cargamento en Poblado Nevada.‡Encuentra a los corredores Nevada y detenlos antes de que entreguen su cargamento en Poblado Nevada.‡Trouver les Messagers Tombe-hiver et les empêcher de livrer leur cargaison au village Tombe-hiver.‡找到冬泉信使，阻止他们向冬泉村运送物品。‡找到冬泉信使，阻止他們向冬泉村運送物品。',
  }
},
[5088] = {
  -- Item
  'Manual de Operação do Console de Controle‡Руководство пользователя панели управления‡Steuerkonsolen-Bedienungsanleitung‡제어장치 조작설명서‡Manual de instrucciones de la consola de control‡Manual de instrucciones de la consola de control‡Manuel de la console de contrôle‡控制台操作手册‡控制臺操作手冊',
  { -- Npc
    'Falgran Hastil‡Фальгран Гастил‡Falgran Hastil‡팰그런 해스틸‡Falgran Hastil‡Falgran Hastil‡Falgran Hastil‡法格兰·哈斯迪尔‡法格蘭·哈斯迪爾',
