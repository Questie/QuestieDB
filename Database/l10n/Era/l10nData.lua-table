[5901] = {
  nil,
  { -- Npc
    'Islen Vidente da Água‡Ислен Заклинатель Воды‡Islen Waterseer‡이슬렌 워터시어‡Islen Vident\'aqua‡Islen Vidente del Agua‡Islen Waterseer‡水之先知伊斯伦‡水之先知伊斯倫',
    nil,
  },
  nil,
  { -- Quest
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Use a Jarra de Cupins Vazia nos Cupinzeiros que há nas Terras Pestilentas Orientais. Após conseguir 100 Cupins das Terras Pestilentas, fale novamente com Guel Levine no Baluarte, nas Clareiras de Tirisfal.‡Возьмите пустую банку для термитов и отправляйтесь к большим термитникам в Восточных Чумных землях. Наберите 100 термитов Восточных Чумных земель и возвращайтесь к Микки Левину в Бастион в Тирисфальских лесах.‡Wendet den leeren Termitenkrug auf die Termitenhügel in den östlichen Pestländern an. Sobald Ihr 100 Pestland-Termiten gesammelt habt, kehrt zu Mickey Levine am Bollwerk in Tirisfal zurück.‡동부 역병지대의 흰개미집으로 가서 빈 흰개미 병을 사용하십시오. 역병지대 흰개미 100마리를 모아서 티리스팔 숲의 보루에 있는 미키 레빈에게 돌아가야 합니다.‡Utiliza la Jarra de termitas vacía en los Montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Mickey Levine, que está en El Baluarte, en Claros de Tirisfal.‡Utiliza el tarro de termitas vacío en los montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Mickey Levine, que está en El Baluarte, en Claros de Tirisfal.‡Utiliser le Pot de Termites vide sur la Termitière, dans les Maleterres de l’est. Après avoir récupéré 100 Termites des Maleterres, retourner voir Mickey Levine, à la Barricade, dans les Clairières de Tirisfal.‡在东瘟疫之地的蚁丘上使用空的白蚁瓶。当你收集了100只瘟疫白蚁之后，就回到提瑞斯法林地的亡灵壁垒去找米克·莱文。‡在東瘟疫之地的蟻丘上使用空的白蟻瓶。當妳收集了100只瘟疫白蟻之後，就回到提瑞斯法林地的亡靈壁壘去找米克·萊文。',
  }
},
[5902] = {
  nil,
  { -- Npc
    'Manifestação Menor do Ar‡Низшее воплощение воздуха‡Schwache Luftmanifestation‡하급 바람의 현신‡Manifestación de aire menor‡Manifestación de aire menor‡Manifestation d\'air mineure‡空气之魂‡小型空氣之靈體',
    nil,
  },
  nil,
  { -- Quest
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Encontre um lugar apropriado para pôr o Barril de Cupins das Terras Pestilentas no centro da Serraria de Beiranorte, que fica nas Terras Pestilentas Ocidentais.‡Найдите подходящее место на лесопилке Северного Кряжа в Западных Чумных землях и оставьте там бочонок термитов из Чумных земель.‡Sucht Euch einen geeigneten Ort in der Mitte des Northridge-Sägewerks in den Westlichen Pestländern, um das Fass mit den Pestland-Termiten abzustellen.‡서부 역병지대의 북마루 벌목지 중앙에 적당한 장소를 찾아 역병지대 흰개미 통을 놓아야 합니다.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Trouver un endroit judicieux, au centre de la scierie de la Crête du nord, dans les Maleterres de l’ouest, pour placer le Tonneau de Termites des Maleterres.‡到西瘟疫之地的北山伐木场去找个合适的地方，在那里放下一桶瘟疫白蚁。‡到西瘟疫之地的北山伐木場去找個合適的地方，在那裏放下壹桶瘟疫白蟻。',
  }
},
[5903] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡納克斯‧血怒',
    '‡‡‡‡‡‡‡‡魚人寶寶兌換商人',
  },
  nil,
  { -- Quest
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Use a Jarra de Cupins Vazia nos Cupinzeiros que há nas Terras Pestilentas Orientais. Após conseguir 100 Cupins das Terras Pestilentas, fale novamente com Nataniel Dumah no Acampamento Ventogelante, em Terras Pestilentas Ocidentais.‡Возьмите пустую банку для термитов и отправляйтесь к большим термитникам в Восточных Чумных землях. Наберите 100 термитов Восточных Чумных земель и возвращайтесь к Натаниэлю Дамаху в Лагерь Промозглого Ветра в Восточные Чумные земли.‡Wendet den leeren Termitenkrug auf die Termitenhügel in den Östlichen Pestländern an. Sobald Ihr 100 Pestland-Termiten gesammelt habt, kehrt zu Nathaniel Dumah am Chillwindposten in den Westlichen Pestländern zurück.‡동부 역병지대에 있는 흰개미집으로 가서 빈 흰개미 병을 사용해야 합니다. 역병지대 흰개미 100마리를 모아 서부 역병지대의 서리바람 야영지에 있는 너대니얼 두마에게 돌아가야 합니다.‡Utiliza la Jarra de termitas vacía en los Montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Nathaniel Dumah al Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Utiliza el tarro de termitas vacío en los montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Nathaniel Dumah al Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Utiliser le Pot de Termites vide sur la Termitière, dans les Maleterres de l’est. Après avoir récupéré 100 Termites des Maleterres, retourner voir Nathaniel Dumah, au camp du Noroît, dans les Maleterres de l’ouest.‡在东瘟疫之地的蚁丘上使用空的白蚁瓶。当你收集了100只瘟疫白蚁之后，就回到西瘟疫之地的冰风岗去找纳萨尼尔·杜马。‡在東瘟疫之地的蟻丘上使用空的白蟻瓶。當妳收集了100只瘟疫白蟻之後，就回到西瘟疫之地的冰風崗去找納薩尼爾·杜馬。',
  }
},
