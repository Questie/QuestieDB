[491] = {
  nil,
  { -- Npc
    'Intendente Ludovico‡Интендант Льюис‡Rüstmeister Lewis‡병참장교 루이스‡Intendente Lewis‡Intendente Lewis‡Intendant Lewis‡军需官刘易斯‡軍需官路易斯',
    'Intendente‡Интендант‡Rüstmeister‡병참 장교‡Intendente‡Intendente‡Intendant‡军需官‡軍需官',
  },
  nil,
  { -- Quest
    'Uma boa varinha para Boanerges‡Жезл для Бетора‡Zauberstab an Bethor‡베소르에게 전할 마법봉‡Una varita para Bethor‡Una varita para Bethor‡Une Baguette pour Bethor‡给比索的魔杖‡給比索的魔杖',
    nil,
    'Leve a Varinha Entretecida para Boanerges Stalactus, no Distrito da Magia da Cidade Baixa.‡Отнесите Сплетенный жезл Бетору Ледострелу в Квартал Магов Подгорода.‡Bringt den gewebten Zauberstab zu Bethor Iceshard in das Magieviertel von Undercity.‡언더시티의 마법 지구에 있는 베소르 아이스샤드에게 결합된 마법봉을 가져가야 합니다.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Apporter le Bâton tressé à Bethor Iceshard dans le Quartier de la magie à Undercity.‡将狼人魔杖带给幽暗城法师区的比索·埃斯沙德。‡將狼人魔杖帶給幽暗城法師區的比索·埃斯沙德。',
  }
},
[492] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Uma nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'Leve a Bebida Especial do Joaquino para o Montanhista Capturado.‡Отнесите особый напиток Юхана пленному горному пехотинцу.‡Bringt Johaans Spezialgetränk zum gefangenen Gebirgsjäger.‡산악경비대 포로에게 요한의 특별조제약을 전해줘야 합니다.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Apporter la Boisson spéciale de Johaan au Montagnard captif.‡将乔汉的特制饮料交给被俘虏的巡山人。‡將喬漢的特制飲料交給被俘虜的巡山人。',
  }
},
[493] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Jornada ao Contraforte de Eira dos Montes‡Путешествие в предгорья Хилсбрада‡Reise in das Vorgebirge von Hillsbrad‡힐스브래드 구릉지로의 여정‡Viaja a Laderas de Trabalomas‡Viaja a Laderas de Trabalomas‡Voyage jusqu’aux contreforts d\'Hillsbrad‡前往希尔斯布莱德丘陵‡前往希爾斯布萊德丘陵',
    nil,
    'Entregue as descobertas do Boticário Renferrel ao Boticário Lindolfo na cidade de Serraria Tarren, que fica no Contraforte de Eira dos Montes.‡Отнесите находки аптекаря Ренферрела аптекарю Лидону в деревню Мельница Таррен в предгорьях Хилсбрада.‡Bringt die Funde von Apotheker Renferrel zu Apotheker Lydon nach Tarrens Mühle im Vorgebirge von Hillsbrad.‡힐스브래드 구릉지의 타렌 밀농장에 있는 연금술사 라이던에게 렐퍼럴의 연구 결과를 가져가야 합니다.‡Lleva los descubrimientos del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Lleva el descubrimiento del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Livrer les découvertes de l\'Apothicaire Renferrel à l\'Apothicaire Lydon à Moulin-de-Tarren dans les contreforts d\'Hillsbrad.‡将伦弗利尔的研究成果交给希尔斯布莱德山脚下塔伦米尔的药剂师林度恩。‡將倫弗利爾的研究成果交給希爾斯布萊德山腳下塔倫米爾的藥劑師林度恩。',
  }
},
[494] = {
  nil,
  { -- Npc
    'Vigia Bukouris‡Дозорный Бакурис‡Behüterin Bukouris‡순찰대원 부코우리스‡Vigía Bukouris‡Vigía Bukouris‡Gardienne Bukouris‡守夜人布克瑞斯‡守夜人布克瑞斯',
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
  },
  nil,
  { -- Quest
    'Hora de atacar‡Время нанести удар‡Zeit zum Zuschlagen‡공격 개시‡El momento de atacar‡El momento de atacar‡Prêts à frapper‡进攻的时机‡進攻的時機',
    nil,
    'Viaje até Serraria Tarren para entregar a mensagem do Sicário Açoute para a Alta-executora Darthalia.‡Отправляйтесь в Мельницу Таррен и доставьте послание стража смерти Леш верховному палачу Дарталии.‡Reist nach Tarrens Mühle, um die Nachricht von Todespirscherin Lesh an Hochexekutorin Darthalia zu überbringen.‡타렌 밀농장으로 가서 고위집행관 다살리아에게 죽음의추적자 레시의 전갈을 전해야 합니다.‡Ve a Molino Tarren para llevar el mensaje del mortacechador Lesh a la suma ejecutora Darthalia.‡Ve a Molino Tarren para llevar el mensaje de la mortacechadora Lesh a la suma ejecutora Darthalia.‡Se rendre à Moulin-de-Tarren et délivrer le message du Traqueur noir Lesh à la Grande Exécutrice Darthalia.‡到塔伦米尔去，把亡灵哨兵莱什的口信带给高级执行官达萨利亚。‡到塔倫米爾去，把亡靈哨兵萊什的口信帶給高級執行官達薩利亞。',
  }
},
[495] = {
  nil,
  { -- Npc
    'Vigia Cascais‡Дозорный Кифэр‡Behüterin Keefer‡순찰대원 키퍼‡Vigía Keefer‡Vigía Keefer‡Gardienne Keefer‡守夜人基佛‡守夜人基佛',
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
  },
  nil,
  { -- Quest
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡La Corona de la Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意誌之冠',
    nil,
    'Apresente-se a Melissara, na Serraria Tarren, no Contraforte de Eira dos Montes.‡Поговорите с Мелизарой в Мельнице Таррен в предгорьях Хилсбрада.‡Meldet Euch bei Melisara in Tarrens Mühle im Vorgebirge von Hillsbrad.‡힐스브래드 구릉지의 타렌 밀농장에 있는 멜리사라에게 보고해야 합니다.‡Informa a Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Preséntate ante Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Faire un rapport à Melisara à Moulin-de-Tarren dans les Contreforts d\'Hillsbrad.‡到希尔斯布莱德丘陵去，向塔伦米尔的梅里萨拉报到。‡到希爾斯布萊德丘陵去，向塔倫米爾的梅裏薩拉報到。',
  }
},
[496] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Elixir do sofrimento‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡Elixir del sufrimiento‡Elixir de sufrimiento‡L\'élixir de souffrance‡受难药剂‡受難藥劑',
    nil,
    'Boticário Lindolfo, de Serraria Tarren, quer 10 Línguas de Urso Cinzento e um pouco de Pus de Rastejante.‡Аптекарь Лидон с мельницы Таррен попросил принести ему 10 языков серых медведей и немного лимфы паука-охотника.‡Apotheker Lydon aus Tarrens Mühle möchte 10 Graubärzungen und etwas Krabblersekret.‡타렌 밀농장에 있는 연금술사 라이던이 회색곰 혀 10개와 이끼거미 수액을 구해다 달라고 부탁했습니다.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡Apporter 10 Langues d\'ours gris et de l\'Ichor de Rampant à l\'Apothicaire Lydon à Moulin-de-Tarren.‡塔伦米尔的药剂师林度恩要你去收集10个灰熊的舌头和一些食苔蛛的毒液。‡塔倫米爾的藥劑師林度恩要妳去收集10個灰熊的舌頭和壹些食苔蛛的毒液。',
  }
},
[498] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O resgate‡Спасение‡Die Rettung‡포로 구출‡El rescate‡El rescate‡Sauvetage‡拯救行动‡拯救行動',
    nil,
    'Krusk, da Serraria Tarren, precisa que você liberte Drull e Tog\'thar do Forte do Desterro.‡Освободите Друлла и Тог\'тара по поручению Круска с мельницы Таррен.‡Krusk in Tarrens Mühle braucht Euch, um Drull und Tog\'thar aus der Burg Durnholde zu befreien.‡타렌 밀농장에 있는 크루스크가 던홀드 요새에서 드럴과 토그타르를 구출해 달라고 부탁했습니다.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Selon les ordres de Krusk à Moulin-de-Tarren, libérer Drull et Tog\'thar du Donjon de Durnholde.‡塔伦米尔的克鲁斯克要你把德鲁尔和托格萨从敦霍尔德城堡救出来。‡塔倫米爾的克魯斯克要妳把德魯爾和托格薩從敦霍爾德城堡救出來。',
  }
},
[499] = {
  nil,
  { -- Npc
    'Vigia Paige‡Дозорный Пейдж‡Behüterin Paige‡순찰대원 페이지‡Vigía Paige‡Vigía Paige‡Gardienne Paige‡守夜人派格‡守夜人派格',
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwächterin‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
  },
  nil,
  { -- Quest
    'Elixir do Sofrimento‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡Elixir del sufrimiento‡Elixir de sufrimiento‡L\'élixir de souffrance‡受难药剂‡受難藥劑',
    nil,
    'Dê o Elixir do Sofrimento a Umpi.‡Дайте Ампи эликсир Страдания.‡Gebt Umpi das Elixier des Leidens‡개구리 움피에게 괴로움의 비약을 먹여야 합니다.‡Dale el elixir del sufrimiento a Umpi.‡Dale el elixir de sufrimiento a Umpi.‡Donner l\'Elixir de souffrance à Umpi.‡把受难药剂交给乌比。‡把受難藥劑交給烏比。',
  }
},
[500] = {
  nil,
  { -- Npc
    'Batedor Pata Molhada‡Разведчик из стаи Речной Лапы‡Späher der Flusspfoten‡갈퀴발일족 정찰병‡Explorador Zarparrío‡Explorador Zarparrío‡Eclaireur Rivepatte‡河爪斥候‡河爪斥候',
    nil,
  },
  nil,
  { -- Quest
    'Caça de Massacrista‡Награда Раздробленного Хребта‡Crushridge-Kopfgeld‡산사태일족 현상금‡La recompensa Aplastacresta‡Recompensa Aplastacresta‡La prime Cassecrête‡破碎岭食人魔‡破碎嶺食人魔',
    nil,
    'Reúna 9 Nós dos Dedos Sujos dos Ogros Massacrista nas Montanhas de Alterac. Leve-os para o Delegado Trilharrubra, na Costa Sul.‡Соберите 9 грязных бабок у огров из клана Раздробленного Хребта в Альтеракских горах. Принесите их маршалу Крассену в Южнобережье.‡Sammelt 9 schmutzige Knöchelknochen von Crushridge-Ogern im Alteracgebirge. Bringt sie zu Marshal Redpath in Southshore.‡알터랙 산맥에 있는 산사태 오우거에게서 더러운 손가락 뼈 9개를 모은 후 사우스쇼어에 있는 치안대장 레드패스에게 가져가야 합니다.‡Recoge 9 huesos sucios de orcos Aplastacresta en las Montañas de Alterac. LLévaselos al mariscal Rutagrana a Costasur.‡Recoge 9 nudillos sucios de ogros Aplastacresta en las Montañas de Alterac. Llévaselos al alguacil Rutagrana a Costasur.‡Collecter 9 Articulations sales d\'ogres Cassecrête dans les montagnes d\'Alterac. Les apporter au maréchal Redpath à Southshore.‡从奥特兰克山的破碎岭食人魔身上收集9个肮脏的指节骨，把它们带给南海镇的治安官雷德帕斯。‡從奧特蘭克山的破碎嶺食人魔身上收集9個骯臟的指節骨，把它們帶給南海鎮的治安官雷德帕斯。',
  }
},
[501] = {
  nil,
  { -- Npc
    'Herborista Pata Molhada‡Травник стаи Речной Лапы‡Kräuterkundiger der Flusspfoten‡갈퀴발일족 약초채집꾼‡Herborista Zarparrío‡Herborista Zarparrío‡Herboriste Rivepatte‡河爪草药师‡河爪草藥師',
    nil,
  },
  nil,
  { -- Quest
    'Elixir da dor‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡Elixir de dolor‡Elixir de dolor‡L\'élixir de douleur‡痛苦药剂‡痛苦藥劑',
    nil,
    'Leve 10 Ampolas de Sangue de Leão da Montanha para o Boticário Lindolfo na Serraria Tarren.‡Принесите 10 сосудов крови горного льва аптекарю Лидону с мельницы Таррен.‡Bringt 10 Phiolen mit Berglöwenblut zu Apotheker Lydon in Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 산사자 피 10병을 가져가야 합니다.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Apporter 10 Fioles de sang de lion des montagnes à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集10瓶山地狮的血液，把它们交给塔伦米尔的药剂师林度恩。‡收集10瓶山地獅的血液，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[502] = {
  nil,
  { -- Npc
    'Benny Blaanco‡Вит Карлеон‡Benny Blaanco‡베니 블란코‡Benny Blaanco‡Benny Blaanco‡Benny Blaanco‡本尼·布兰科‡本尼·布蘭科',
    nil,
  },
  nil,
  { -- Quest
    'Elixir da dor‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡Elixir del dolor‡Elixir de dolor‡L\'élixir de douleur‡痛苦药剂‡痛苦藥劑',
    nil,
    'Alimente Fido com o Elixir da Dor.‡Напоите Стэнли эликсиром Боли.‡Füttert Stanley mit dem Elixier der Schmerzen.‡스탠리에게 고통의 비약을 먹여야 합니다.‡Dale el elixir del dolor a Stanley.‡Dale el elixir de dolor a Stanley.‡Donner l’Elixir de douleur à Stanley.‡把痛苦药剂喂给小狗斯坦雷。‡把痛苦藥劑餵給小狗斯坦雷。',
  }
},
[503] = {
  nil,
  { -- Npc
    'Lorde Malathrom‡Лорд Малатром‡Lord Malathrom‡군주 말라스롬‡Lord Malathrom‡Lord Malathrom‡Seigneur Malathrom‡玛拉索姆公爵‡瑪拉索姆領主',
