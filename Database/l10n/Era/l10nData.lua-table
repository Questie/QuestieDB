},
[8409] = {
  -- Item
  '‡Выкройка: ночные наплечники‡Muster: Schultern des Nachtschleichers‡도안: 밤하늘 어깨보호구‡Patrón: sobrehombros Nochefugaz‡Patrón: sobrehombros Nochefugaz‡Patron : Epaulières de la nuit‡图样：夜色护肩‡圖樣:夜景護肩',
  { -- Npc
    'Mestre de Caravanas Tset‡Караванщик Тсет‡Karawanenmeister Tset‡순례자 티셋‡Maestro de caravana Tset‡Maestro de caravana Tset‡Maître-caravanier Tset‡商队主人提塞特‡商隊主人提塞特',
    nil,
  },
  nil,
  { -- Quest
    'Barris arruinados‡Поломанные бочки‡Verdorbenes Bier‡엉망이 된 양조통‡Los barriles dañados‡Los barriles dañados‡Des tonneaux gâtés‡恶臭的鸡蛋‡惡臭的雞蛋',
    nil,
    'Fale novamente com a Invoca-trevas Yanka no Festival do Homem de Palha, nas Clareiras de Tirisfal.‡Вернитесь к Янке Зовущей Тьму на фестиваль Плетеного человека на Тирисфальских лугах.‡Kehrt zur Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡티리스팔 숲의 밀짚인형 축제에 있는 암흑의 소환사 얀카에게 돌아가야 합니다.‡Ve a ver de nuevo a Llamasombra Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Ve a ver de nuevo a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Retournez voir la sombre imploratrice Yanka à la Fête de l\'homme d\'osier dans les clairières de Tirisfal.‡向提瑞斯法林地的黑暗召唤者雅恩卡复命。‡向提瑞斯法林地的黑暗召喚者雅恩卡復命。',
  }
},
[8410] = {
  -- Item
  '‡С.И.Л.А.‡‡근육 촉진제‡IFRDHR‡IFRDHR‡‡土狼兴奋剂‡土狼興奮劑',
  nil,
  nil,
  { -- Quest
    'Mestre dos elementos‡Покорение стихий‡Elementarbeherrschung‡원소에 대한 깨달음‡Maestría elemental‡Maestría elemental‡La maîtrise des éléments‡元素掌握‡元素掌握',
    nil,
    'Colete uma amostra de ar, fogo, terra e água para Bath\'rah, o Vigia dos Ventos.‡Соберите образцы воздуха, огня, земли и воды по поручению Бат\'ры Ветростража.‡Bath\'rah der Windbehüter möchte, dass Ihr jeweils eine Probe Luft, Feuer, Erde und Wasser für ihn sammelt.‡물, 불, 대지, 바람의 샘플을 수집하여 바람의감시자 바스라에게 가져가야 합니다.‡Recoge una muestra de aire, fuego, tierra y agua para Bath\'rah el Vigía del viento.‡Recoge una muestra de aire, fuego, tierra y agua para Bath\'rah el Vigía del viento.‡Rassembler un échantillon d\'air, de feu, de terre et d\'eau pour Bath\'rah la Vigie des Vents.‡为捕风者巴斯拉收集一份空气样本、一份火元素样本、一份土元素样本和一份水元素样本。‡為捕風者巴斯拉收集壹份空氣樣本、壹份火元素樣本、壹份土元素樣本和壹份水元素樣本。',
  }
},
[8411] = {
  -- Item
  '‡Коктейль "Легкое дыхание"‡Lungensaftcocktail‡허파즙 칵테일‡Cóctel de zumo de pulmón‡Cóctel de zumo de pulmón‡Cocktail de jus de poumon‡肺片鸡尾酒‡肺汁調酒',
  nil,
  nil,
  { -- Quest
    'Dominando os elementos‡Покорение Стихий‡Die Beherrschung der Elemente‡원소에 대한 깨달음‡ominar los elementos‡Dominar los elementos‡Maîtriser les éléments‡控制元素‡控制元素',
    nil,
    'Leve os elementos terra, ar, fogo e água para Bath\'rah, o Vigia dos Ventos.‡Принесите стихии Земли, Воздуха, Огня и Воды Бат\'ре Ветростражу.‡Bringt Bath\'rah dem Windbehüter die Elemente Erde, Luft, Feuer und Wasser.‡바람의감시자 바스라에게 바람, 불, 대지, 물의 원소를 가져가야 합니다.‡Lleva los elementos tierra, aire, fuego y agua a Bath\'rah el Vigía del viento.‡Lleva los elementos tierra, aire, fuego y agua a Bath\'rah el Vigía del viento.‡Apportez les éléments terre, air, feu et eau à Bath\'rah la Vigie des vents.‡将土元素、空气元素、火元素和水元素交给捕风者巴斯拉。‡將土元素、空氣元素、火元素和水元素交給捕風者巴斯拉。',
  }
},
[8412] = {
  -- Item
  '‡Настойка Скорпока‡Gemahlene Skorpokinhaltsstoffprobe‡스콜포크 가루약‡Polvo de scorpok machacado‡Polvo de scorpok machacado‡Poudre de scorpok terrestre‡厚甲蝎药粉‡厚甲蠍藥粉',
  nil,
  nil,
  { -- Quest
    'Totem de espírito‡Тотем духов‡Geistertotem‡정기의 토템‡ótem de espíritu‡Tótem de espíritu‡Le totem des esprits‡灵魂图腾‡靈魂圖騰',
    nil,
    'Leve as partes para Bath\'rah, o Vigia dos Ventos, fazer o totem de espírito.‡Принесите части тотема Духа Бат\'ре Ветростражу.‡Bringt Bath\'rah dem Windbehüter die Komponenten für das Geistertotem.‡바람의감시자 바스라에게 정기의 토템을 만드는데 필요한 재료들을 가져가야 합니다.‡Lleva lo necesario para el tótem del espíritu a Bath\'rah el Vigía del viento.‡Lleva lo necesario para el tótem del espíritu a Bath\'rah el Vigía del viento.‡Apportez les différents morceaux du Totem des esprits à Bath’rah la Vigie des Vents.‡将灵魂图腾所需的材料交给捕风者巴斯拉。‡將靈魂圖騰所需的材料交給捕風者巴斯拉。',
  }
},
[8413] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O Vodu‡Вуду‡Die Macht des Voodoos‡부두교 마법‡Vudú‡Vudú‡Vaudou !‡巫毒羽毛‡巫毒羽毛',
    nil,
    'Leve as Penas Vodu para Bath\'rah, o Vigia dos Ventos.‡Принесите вудуистские перья Бат\'ре Ветростражу.‡Bringt Bath\'rah dem Windbehüter die Voodoofedern.‡바람의감시자 바스라에게 부두 깃털들을 가져가야 합니다.‡Lleva las plumas vudú a Bath\'rah el Vigía del viento.‡Lleva las plumas vudú a Bath\'rah el Vigía del viento.‡Apporter les Plumes vaudou à Bath\'rah la Vigie des vents.‡将巫毒羽毛交给捕风者巴斯拉。‡將巫毒羽毛交給捕風者巴斯拉。',
  }
},
[8414] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Dissipando o mal‡Борьба со злом‡Austreibung des Bösen‡악마 퇴치‡Expulsión de los demonios‡Expulsión de los demonios‡La dissipation du mal‡驱散邪恶‡驅散邪惡',
    nil,
    'Colete 20 Pedras do Flagelo do Lacaio e leve-as ao Sumo Sacerdote Thel\'danis nas Terras Pestilentas Ocidentais.‡Принесите 20 камней Плети приспешников верховному жрецу Тель\'данису в Западные Чумные земли.‡Sammelt 20 Geißelsteine des Dieners und bringt sie zu Hohepriester Thel\'danis in den westlichen Pestländern.‡서부 역병지대에 있는 대사제 텔다니스에게 앞잡이의 스컬지석 20개를 모아 가져가야 합니다.‡Recoge 20 piedras de la Plaga del esbirro y entrégaselas al sumo sacerdote Thel\'danis en las Tierras de la Peste del Oeste.‡Recoge 20 piedras de la Plaga del esbirro y entrégaselas al sumo sacerdote Thel\'danis en las Tierras de la Peste del Oeste.‡Récupérez 20 Pierres du Fléau des serviteurs et apportez-les au grand prêtre Thel\'danis dans les Maleterres de l\'ouest.‡收集20个爪牙的天灾石，并将它们交给西瘟疫之地的高阶牧师赛尔丹尼斯。‡收集20個爪牙的天災石，並將它們交給西瘟疫之地的高階牧師賽爾丹尼斯。',
  }
},
[8415] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Morro do Ventogelante‡Берег Промозглого Ветра‡Chillwindspitze‡서리바람 거점으로‡Campamento del Orvallo‡Alto del Orvallo‡La pointe du Noroît‡冰风岗‡冰風崗',
    nil,
    'Fale com o Comandante Ashlam Punhobom no Morro do Ventogelante.‡Обратитесь к командиру Ашламу Отважному Кулаку на берегу Промозглого Ветра.‡Sprecht mit Kommandanten Ashlam Valorfist an der Chillwindspitze.‡서리바람 거점에 있는 사령관 아쉬람 발러피스트와 대화해야 합니다.‡Habla con el comandante Ashlam Puñovalor en el Campamento del Orvallo.‡Habla con el comandante Ashlam Puñovalor en Alto del Orvallo.‡Parler au commandant Ashlam Vaillepoing au Camp du Noroît.‡与冰风岗的指挥官阿什拉姆·瓦罗菲斯特谈一谈。‡與冰風崗的指揮官阿什拉姆·瓦羅菲斯特談壹談。',
  }
},
[8416] = {
  nil,
  { -- Npc
    'Félix Reclamofuso‡Феликс Ремонтуар‡Felix Whindlebolt‡펠릭스 윈들볼트‡Félix Rayaullido‡Félix Rayaullido‡Felix Whindlebolt‡菲利克斯‡菲利克斯',
    nil,
  },
  nil,
  { -- Quest
    'Pedras do Flagelo inertes‡Бездействующие камни Плети‡Gereinigte Geißelsteine‡마력을 잃은 스컬지석‡Piedras inertes de la Plaga‡Piedras de la Plaga inertes‡Pierres du Fléau inertes‡惰性天灾石‡惰性天災石',
    nil,
    'Leve a Pedra do Flagelo Inerte ao Comandante Ashlam Punhobom no Morro do Ventogelante.‡Отнесите бездействующий камень командиру Асламу Отважному Кулаку на Берег Промозглого Ветра.‡Bringt den gereinigten Geißelstein zu Kommandant Ashlan Valorfist an der Chillwindspitze.‡서리바람 거점에 있는 사령관 아쉬람 발러피스트에게 마력을 잃은 스컬지석을 가져가야 합니다.‡Lleva la Piedra inerte de la Plaga al comandante Ashlam Puñovalor en el Alto del Orvallo.‡Lleva la piedra de la Plaga inerte al comandante Ashlam Puñovalor en el Alto del Orvallo.‡Apportez la Pierre du Fléau inerte au commandant Ashlam Vaillepoing à la pointe du Noroît.‡将惰性天灾石交给冰风岗的指挥官阿什拉姆·瓦罗菲斯特。‡將惰性天災石交給冰風崗的指揮官阿什拉姆·瓦羅菲斯特。',
  }
},
[8417] = {
  nil,
  { -- Npc
    'Arqueólogo Moribundo‡Умирающий археолог‡Sterbender Archäologe‡죽어가는 고고학자‡Arqueólogo moribundo‡Arqueólogo moribundo‡Archéologue mourant‡濒死的考古学家‡瀕死的考古學家',
    nil,
  },
  nil,
  { -- Quest
    'Um espírito atormentado‡Неупокоенный дух‡Ein geplagter Geist‡영혼이 된 영웅의 고통‡Un espíritu afligido‡Un espíritu afligido‡Un esprit troublé‡困扰的灵魂‡困擾的靈魂',
    nil,
    'Fale com o Herói Caído da Horda na entrada da Barreira do Inferno.‡Поговорите с павшим героем Орды у входа в Выжженные земли.‡Sprecht mit dem gefallenen Helden der Horde am Eingang zu den verwüsteten Landen.‡저주받은 땅의 입구에 있는 호드 영웅의 넋과 대화해야 합니다.‡Habla con el Héroe Caído de la Horda en la entrada de Las Tierras Devastadas.‡Habla con el héroe caído de la Horda en la entrada de Las Tierras Devastadas.‡Parlez au Héros de la Horde tombé au combat, à l\'entrée des Terres Foudroyées.‡到诅咒之地的入口去，与部落英雄的灵魂谈一谈。‡到詛咒之地的入口去，與部落英雄的靈魂談壹談。',
  }
},
[8418] = {
  nil,
  { -- Npc
    'Falla Vento Sábio‡Фолла Ветер Мудрости‡Falla Sagewind‡팔라 세이지윈드‡Fala Ventsalvia‡Fala Viento Sabio‡Falla Sagewind‡菲拉·古风‡菲拉·古風',
    nil,
  },
  nil,
  { -- Quest
    'Forjando o megalito‡Создание камня силы‡Erschaffung des Steins der Macht‡퇴마석 만들기‡La forja de la piedra de poderío‡La forja de la piedra de poderío‡Forger la pierre de pouvoir‡铸造力量之石‡鑄造力量之石',
    nil,
    'Leve as Penas Vodu para Ashlam Punhobom.‡Принесите вудуистские перья Ашламу Отважному Кулаку.‡Bringt die Voodoofedern zu Ashlam Valorfist.‡아쉬람 발러피스트에게 황색 부두 깃털, 청색 부두 깃털, 녹색 부두 깃털을 각 2개씩 가져가야 합니다.‡Obtén plumas vudú ámbar, azules y verdes de los trols del Templo Sumergido.‡Llévale las plumas vudú a Ashlam Puñovalor.‡Apportez des Plumes vaudou ambres, bleues et vertes.‡前往沉没的神庙，从巨魔守护者们身上取得巫毒羽毛，然后把它们交给阿什拉姆·瓦罗菲斯特。‡前往沈沒的神廟，從巨魔守護者們身上取得巫毒羽毛，然後把它們交給阿什拉姆·瓦羅菲斯特。',
  }
},
[8419] = {
  nil,
  { -- Npc
    'Idólatra do Crepúsculo‡Идолопоклонница из культа Сумеречного Молота‡Twilight-Götzendiener‡황혼의망치단 우상숭배자‡Idólatra Crepuscular‡Idólatra Crepuscular‡Idolâtre du crépuscule‡暮光崇拜者‡暮光崇拜者',
    nil,
  },
  nil,
  { -- Quest
    'Pedido de diabrete‡Просьба беса‡Die Bitte eines Wichtels‡임프의 부탁‡Pedido de un diablillo‡Pedido de un diablillo‡La demande d\'un diablotin‡小鬼的要求‡小鬼的要求',
    nil,
    'Leve um pedaço de Tecido Vil para Diabretim, em Selva Maleva.‡Отнесите Бесенку из Оскверненного леса отрез ткани Скверны.‡Bringt ein Stück Teufelsstoff zu Impsy im Teufelswald.‡악령의 숲에 있는 임프시에게 지옥 옷감을 한 장 가져가야 합니다.‡Lleva una pieza de tela de inferi a Diblis en Frondavil.‡Lleva un retal de tela vil a Diblis a Frondavil.‡Apportez un morceau de Gangrétoffe à Démonet à Gangrebois.‡将一块恶魔布交给费伍德森林的伊普斯。‡將壹塊惡魔布交給費伍德森林的伊普斯。',
  }
},
[8420] = {
  nil,
  { -- Npc
    'Kam\'arawn‡Ким\'джаель‡Kim\'jael‡킴야엘‡Kim\'jael‡Kim\'jael‡Kim\'jael‡基姆加尔‡基姆加爾',
    nil,
  },
  nil,
  { -- Quest
    'Quente e pinicante‡Пробирает!‡Heiß und brennend‡뜨거운 소유욕‡Caliente y picante‡Caliente y picante‡Chaud et piquant‡灼热的疼痛‡灼熱的疼痛',
    nil,
    'Leve um pedaço de Tecido Vil para Diabretim, em Selva Maleva.‡Принесите отрез ткани Скверны Бесенку в Оскверненный лес.‡Bringt ein Stück Teufelsstoff zu Impsy im Teufelswald.‡악령의 숲에 있는 임프시에게 지옥 옷감을 한 장 가져가야 합니다.‡Lleva un retal de tela de inferi a Diblis a Frondavil.‡Lleva un retal de tela vil a Diblis a Frondavil.‡Apportez un morceau de gangrétoffe à Démonet à Gangrebois.‡将一块恶魔布交给费伍德森林的伊普斯。‡將壹塊惡魔布交給費伍德森林的伊普斯。',
  }
},
[8421] = {
  nil,
  { -- Npc
    'Dório‡Дориус‡Dorius‡도리우스‡Dorius‡Dorius‡Dorius‡杜瑞奥斯‡杜瑞奧斯',
    nil,
  },
  nil,
  { -- Quest
    'O enchimento errado‡Бросовый материал‡Das richtige Zeug‡인형 재료‡La mercancía equivocada‡La mercancía equivocada‡L\'anti-étoffe des héros‡奇怪的材料‡奇怪的材料',
    nil,
    'Leve 10 pedaços de Madeira Podre e 4 Essências de Peçonha para Diabretim em Selva Maleva.‡Принесите 10 кусков гнилой древесины и 4 порции экстракта ядовитой крови Бесенку в Оскверненный лес.‡Bringt 10 Stück faules Holz und 4 Blutgiftessenzen zu Impsy im Teufelswald.‡악령의 숲에 있는 임프시에게 썩은 나무 10개와 피멍울 정수 4개를 가져가야 합니다.‡Lleva 10 maderas putrefactas y 4 esencias de veneno a Diblis a Frondavil.‡Lleva 10 maderas putrefactas y 4 esencias de veneno a Diblis a Frondavil.‡Apporter 10 morceaux de Bois pourri et 4 Essences de Vénéneuse à Démonet, en Gangrebois.‡将10块腐烂的木头和4个血毒精华交给费伍德森林的伊普斯。‡將10塊腐爛的木頭和4個血毒精華交給費伍德森林的伊普斯。',
  }
},
[8422] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Penas de troll‡Тролли Пера‡Federn von Trollen‡트롤의 깃털‡Plumas de trol‡Plumas de trol‡Les trolls d\'un même plumage…‡巨魔的羽毛‡巨魔的羽毛',
    nil,
    'Leve um total de 6 Penas Vodu dos trolls do templo submerso.‡Принесите 6 вудуистских перьев троллей из затонувшего храма.‡Bringt 6 Voodoofedern von den Trollen aus dem versunkenen Tempel.‡가라앉은 사원에 있는 트롤의 부두 깃털 6개를 가져가야 합니다.‡Reúne un total de 6 plumas vudú en el Templo Sumergido.‡Reúne un total de 6 plumas vudú en el Templo Sumergido.‡Apporter 6 Plumes vaudou des trolls du Temple englouti.‡到沉没的神庙去，从巨魔们身上获得6支巫毒羽毛。‡到沈沒的神廟去，從巨魔們身上獲得6支巫毒羽毛。',
  }
},
[8423] = {
  -- Item
  '‡Эликсир мозгового штурма‡Zerebralkortexverbund‡대뇌 피질 혼합물‡Compuesto de córtex cerebral‡Compuesto de córtex cerebral‡Potion de cortex cérébral‡脑皮层混合饮料‡腦皮層混合飲料',
  nil,
  nil,
  { -- Quest
    'Parentesco guerreiro‡Воинское испытание‡Kriegerverwandtschaft‡전사의 일족‡Parentesco guerrero‡Parentesco guerrero‡Fraternité entre guerriers‡战士的血脉‡戰士的血脈',
    nil,
    'Mate 7 Javiltuscos na Barreira do Inferno e fale novamente com o Herói Caído da Horda.‡Убейте 7 Зловепрей в Выжженных землях и вернитесь к павшему герою Орды.‡Tötet 7 Hölleneber in den verwüsteten Landen und kehrt zu dem gefallenen Helden der Horde zurück.‡저주받은 땅에 있는 지옥멧돼지 7마리를 처치하고 호드 영웅의 넋에게 돌아가야 합니다.‡Mata a 7 jabinfernos de Las Tierras Devastadas y vuelve junto al héroe caído de la Horda.‡Mata a 7 jabinfernos de Las Tierras Devastadas y vuelve junto al héroe caído de la Horda.‡Tuez 7 Sangliers infernaux dans les Terres Foudroyées, et revenez voir le Héros de la Horde tombé au combat.‡杀死7头地狱野猪，然后回到部落英雄的灵魂那儿。‡殺死7頭地獄野豬，然後回到部落英雄的靈魂那兒。',
  }
},
[8424] = {
  -- Item
  '‡Зелье из потрошков‡Muskelmagenkaugummi‡모래주머니 껌‡Chicle de mollejas‡Chicle de mollejas‡Gomme de gésier‡砂囊口香糖‡砂囊口香糖',
  nil,
  nil,
  { -- Quest
    'Guerra aos devotos da sombra‡Война против Приверженцев Тени‡Krieg den Schattenanbetern‡어둠의혈맹과의 전쟁‡La guerra contra los Sombra Jurada‡La guerra contra los Sombra Jurada‡La guerre contre les liges d\'ombre‡魔誓者之战‡魔誓者之戰',
    nil,
    'Mate os Devotos da Sombra na Barreira do Inferno e fale novamente com o Herói Caído da Horda.‡Убейте Приверженцев Тени в Выжженных землях и вернитесь к павшему герою Орды.‡Merzt die Schattenanbeter in den verwüsteten Landen aus und kehrt zum gefallenen Helden der Horde zurück.‡저주받은 땅에서 어둠의혈맹 숙련사제, 이교도, 암살단원을 각 20명씩 해치우고 호드 영웅의 넋에게 돌아가야 합니다.‡Acaba con los Sombra Jurada en las Tierras Devastadas y regresa junto al Héroe Caído de la Horda.‡Acaba con los Sombra Jurada en Las Tierras Devastadas y regresa junto al héroe caído de la Horda.‡Tuez les Liges d\'ombre dans les Terres Foudroyées et revenez voir le Héros de la Horde tombé au combat.‡杀死诅咒之地的魔誓者，然后回到部落英雄的灵魂那儿。‡殺死詛咒之地的魔誓者，然後回到部落英雄的靈魂那兒。',
  }
},
[8425] = {
  -- Item
  '‡Помет попугая‡Papageienmist‡새똥‡Restos de loro‡Restos de loro‡Fiente de perroquet‡鹦鹉羽毛‡鸚鵡羽毛',
  nil,
  nil,
  { -- Quest
    'Penas Vodu‡Вудуистские перья‡Voodoofedern‡부두 깃털‡Plumas Vudú‡Plumas Vudú‡Plumes vaudou‡巫毒羽毛‡巫毒羽毛',
    nil,
    'Leve as Penas Vodu dos trolls do Templo Submerso para o Herói Caído da Horda.‡Принесите вудуистские перья павшему герою Орды, забрав их у троллей в Затонувшем Храме.‡Bringt die Voodoofedern der Trolle im versunkenen Tempel zu dem gefallenen Helden der Horde.‡호드 영웅의 넋에게 가라앉은 사원에 있는 트롤들에게서 황색 부두 깃털, 청색 부두 깃털, 녹색 부두 깃털을 빼앗아 각 2개씩 가져가야 합니다.‡Llévale las plumas vudú de los trols del Templo Sumergido al Héroe Caído de la Horda.‡Llévale las plumas vudú de los trols del Templo Sumergido al héroe caído de la Horda.‡Apportez les Plumes vaudou des trolls du Temple englouti au Héros de la Horde tombé au combat.‡将你从沉没的神庙的巨魔身上得到的巫毒羽毛交给部落英雄的灵魂。‡將妳從沈沒的神廟的巨魔身上得到的巫毒羽毛交給部落英雄的靈魂。',
  }
},
[8426] = {
  -- Item
  '‡Большое растрепанное перо‡Große gesträubte Feder‡헝클어진 큰 깃털‡Pluma erizada grande‡Pluma erizada grande‡Grande plume ébouriffée‡褶皱的大羽毛‡褶皺的大羽毛',
  nil,
  nil,
  { -- Quest
    'Batalha da Ravina Brado Guerreiro‡Битва за Ущелье Песни Войны‡Schlacht der Warsongschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Warsong‡峡谷中的战斗‡峽谷中的戰鬥',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Warsongschlucht zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d’honneur du goulet des Warsong à l’un des porteguerres de la Horde, devant les champs de bataille.‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡將3枚戰歌榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
