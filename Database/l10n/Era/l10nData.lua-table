[1653] = {
  nil,
  { -- Npc
    'Mago Ancião da Vela Sangrenta‡Старший волхв из шайки Кровавого Паруса‡Hochmagus der Blutsegelbukaniere‡붉은해적단 장로‡Magus viejo Velasangre‡Magus viejo Velasangre‡Ancien magus de la Voile sanglante‡血帆大法师‡血帆魔導師',
    nil,
  },
  -- Object
  '‡Серебряный бор‡Silberwald‡은빛소나무 숲‡Argénteos‡Argénteos‡Forêt des Pins-Argentés‡银松森林‡銀松森林',
  { -- Quest
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Fale com Jardel Calmafonte em Altaforja.‡Поговорите с Джорданом Стилвеллом в Стальгорне.‡Sprecht mit Jordan Stilwell in Ironforge.‡아이언포지에 있는 조던 스틸웰과 대화해야 합니다.‡Habla con Jordan Fontana en Forjaz.‡Habla con Jordan Fontana en Forjaz.‡Parler à Jordan Stilwell à Ironforge‡去和铁炉堡的乔丹·斯迪威尔谈一谈。‡去和鐵爐堡的喬丹·斯迪威爾談壹談。',
  }
},
[1654] = {
  nil,
  { -- Npc
    'Gregor Agamand‡Грегор Агамонд‡Gregor Agamand‡그레고르 아가만드‡Gregor Agamand‡Gregor Agamand‡Gregor Agamand‡格里高·阿加曼德‡格里高·阿加曼德',
    nil,
  },
  -- Object
  '‡Серебряный бор‡Silberwald‡은빛소나무 숲‡Argénteos‡Argénteos‡Forêt des Pins-Argentés‡银松森林‡銀松森林',
  { -- Quest
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Usando as Anotações do Jardel sobre Armas, encontre Madeira de Carvalho de Pedralva, o Carregamento de Minério Refinado do Bailor, o Martelo de Ferreiro de Jardel e uma Gema Kor. Depois, entregue tudo a Jardel Calmafonte em Altaforja.‡Возьмите список Джордана, добудьте немного древесины белокаменного дуба, партию очищенной руды Бэйлора, кузнечный молот Джордана и самоцвет Кора и отдайте их Джордану Стилвеллу в Стальгорне.‡Sucht mit Jordans Waffennotizen etwas Weißsteineichenholz, Bailors aufbereitete Erzlieferung, Jordans Schmiedehammer und einen Kor-Edelstein und bringt alles zusammen zu Jordan Stilwell in Ironforge.‡조던의 쪽지를 참고해 흰돌참나무 재목, 조던의 제련된 광석 상자, 조던의 대장장이 망치, 그리고 코르석을 찾아 아이언포지에 있는 조던 스틸웰에게 가져가야 합니다.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siquiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siguiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Utiliser les Notes sur les armes de Jordan, trouver du Bois de chêne de blanchepierre, la Cargaison de Minerai raffiné de Bailor, le Marteau de forge de Jordan et une Gemme de Kor, puis revenir voir Jordan Stilwell à Ironforge.‡按照乔丹的武器材料单上的说明去寻找一些白石橡木、精炼矿石、乔丹的铁锤和一块科尔宝石，然后回到铁炉堡去见乔丹·斯迪威尔。‡按照喬丹的武器材料單上的說明去尋找壹些白石橡木、精煉礦石、喬丹的鐵錘和壹塊科爾寶石，然後回到鐵爐堡去見喬丹·斯迪威爾。',
  }
},
[1655] = {
  nil,
  { -- Npc
    'Nissa Agamand‡Нисса Агамонд‡Nissa Agamand‡니사 아가만드‡Nissa Agamand‡Nissa Agamand‡Nissa Agamand‡妮萨·阿加曼德‡妮薩·阿加曼德',
    nil,
  },
  -- Object
  '‡Монастырь‡Kloster‡수도원‡Monasterio‡Monasterio‡Monastère‡修道院‡修道院',
  { -- Quest
    'Carregamento de minério do Bailor‡Партия руды Балора‡Bailors Erzlieferung‡조던의 광석 상자‡Envío de minerales de Bailor‡Envío de mena de Bailor‡Cargaison de minerai de Bailor‡白洛尔的矿石‡白洛爾的礦石',
    nil,
    'Leve o Carregamento de Minério do Jardel até Bailor Manopedra, em Loch Modan.‡Доставьте партию руды для Джордана Балору Крепкоруку к озеру Лок Модан.‡Bringt Jordans Erzlieferung zu Bailor Stonehand am Loch Modan.‡모단 호수에 있는 베일러 스톤핸드에게 조던의 광석 상자를 가져가야 합니다.‡Lleva el envío de Jordan a Bailor Manopétrea a Loch Modan.‡Lleva el envío de Jordan a Bailor Petramano a Loch Modan.‡Apporter la Cargaison de minerai de Jordan à Bailor Stonehand au Loch Modan.‡把乔丹的矿石带给洛克莫丹的白洛尔·石手。‡把喬丹的礦石帶給洛克莫丹的白洛爾·石手。',
  }
},
[1656] = {
  -- Item
  '‡Переведенное письмо‡Übersetzter Brief‡번역된 편지‡Carta traducida‡Carta traducida‡Lettre traduite‡翻译好的信件‡翻譯好的信件',
  { -- Npc
    'Timóteo Agamand‡Турман Агамонд‡Thurman Agamand‡투르만 아가만드‡Thurman Agamand‡Thurman Agamand‡Thurman Agamand‡萨尔曼·阿加曼德‡薩爾曼·阿加曼德',
    nil,
  },
  -- Object
  '‡Чумные земли‡Pestländer‡역병지대‡Tierras de la Peste‡Tierras de la Peste‡Maleterres‡瘟疫之地‡瘟疫之地',
  { -- Quest
    'Serviço pela metade‡Незаконченное задание‡Eine unvollendete Aufgabe‡완수하지 못한 임무‡Una tarea por terminar‡Una tarea por terminar‡Une tâche inachevée‡未完的任务‡未完的任務',
    nil,
    'Leve a Trouxa de Peles para o Estalajadeiro Kauth na Aldeia Casco Sangrento.‡Отнесите сверток мехов хозяину таверны Кауту в Деревню Кровавого Копыта.‡Bringt das Bündel Felle zu Gastwirt Kauth in Bloodhoof.‡블러드후프 마을에 있는 여관주인 카우스에게 모피 묶음을 가져가야 합니다.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Livrer le Ballot de fourrures à l\'aubergiste Kauth au village Bloodhoof.‡将一捆毛皮带给血蹄村的旅店老板考乌斯。‡將壹捆毛皮帶給血蹄村的旅店老板考烏斯。',
  }
},
[1657] = {
  -- Item
  '‡‡‡법전: 부활 II‡‡‡‡‡聖典:復活術 II',
  { -- Npc
    'Delmiro Agamand‡Девлин Агамонд‡Devlin Agamand‡데블린 아가만드‡Devlin Agamand‡Devlin Agamand‡Devlin Agamand‡代弗林·阿加曼德‡代弗林·阿加曼德',
    nil,
  },
  -- Object
  '‡Монастырь‡Kloster‡수도원‡Monasterio‡Monasterio‡Monastère‡修道院‡修道院',
  { -- Quest
    'Fedor na Costa Sul‡Чем пахнет в Южнобережье‡Die Verpestung von Southshore‡사우스쇼어에 구린내 폭탄 투하‡Apesta Costasur‡Apesta Costasur‡Empuantir Southshore‡臭气熏天的南海镇‡臭氣熏天的南海鎮',
    nil,
    'Atire três Bombas Fedidas dos Renegados no coração da Costa Sul, em Eira dos Montes, e fale novamente com a Invoca-trevas Yanka no Festival do Homem de Palha, nas Clareiras de Tirisfal.‡Бросить три бомбы-вонючки Отрекшихся в центр Южнобережья в Хилсбраде и вернитесь к Янке Зовущей Тьму на фестиваль Плетеного человека на Тирисфальских лугах.‡Werft drei Stinkbomben der Verlassenen ins Herz von Southshore in Hillsbrad und kehrt zu Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡힐스브래드에 있는 사우스쇼어 한가운데에 3개의 포세이큰 구린내 폭탄을 던진 후, 티리스팔 숲의 밀짚인형 축제가 열리는 곳에 있는 암흑의 소환사 얀카에게 돌아가야 합니다.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a Llamasombra Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lancer trois Boules puantes des Réprouvés au milieu de Southshore en Hillsbrad, puis revenez voir la sombre imploratrice Yanka à la Fête de l’homme d’osier, aux Clairières de Tirisfal.‡将三颗亡灵臭气弹放置在希尔斯布莱德丘陵的南海镇中心，完成任务之后回到提瑞斯法林地的黑暗召唤者雅恩卡那里。‡將三顆亡靈臭氣彈放置在希爾斯布萊德丘陵的南海鎮中心，完成任務之後回到提瑞斯法林地的黑暗召喚者雅恩卡那裏。',
  }
},
[1658] = {
  -- Item
  '‡‡‡법전: 어둠의 권능: 고통 IV‡‡‡‡‡聖典:暗言術:痛 IV',
