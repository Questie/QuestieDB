  nil,
  { -- Quest
    'Alianças rompidas‡Разорванные союзы‡Zerbrochene Allianzen‡깨어진 동맹‡Alianzas rotas‡Alianzas rotas‡Alliances rompues‡破碎的联盟‡破碎的聯盟',
    nil,
    'Mate o Chefe Tho\'grun e leve o Signo da Terra para Gorn, em Karrath.‡Убейте главаря То\'груна и принесите знак Земли Горну в Каргат.‡Tötet Tho\'grun und bringt Gorn in Kargath das Zeichen der Erde.‡우두머리 토그룬을 처치하고 카르가스에 있는 고른에게 대지의 봉인을 가져가야 합니다.‡Mata al jefe Tho\'grun y llévale el Signo de la Tierra a Gorn en Kargath.‡Mata al jefe Tho\'grun y llévale el Signo de la Tierra a Gorn en Kargath.‡Tuer Boss Tho\'grun et rapporter le Signe de la Terre à Gorn, à Kargath.‡杀掉索格伦，把大地印章交给卡加斯的高恩。‡殺掉索格倫，把大地印章交給卡加斯的高恩。',
  }
},
[783] = {
