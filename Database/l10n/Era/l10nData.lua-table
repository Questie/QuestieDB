  nil,
  { -- Quest
    'Importador Willix‡Импортер Вилликс‡Willix der Importeur‡수입업자 윌릭스‡Willix el Importador‡Willix el Importador‡Willix l’Importateur‡进口商威利克斯‡進口商威利克斯',
    nil,
    'Escolte o Importador Willix para fora do Urzal dos Tuscos.‡Сопроводите Вилликса из Лабиринтов Иглошкурых.‡Führt Willix den Importeur aus dem Kral von Razorfen hinaus.‡수입업자 윌릭스를 호위해 가시덩굴 우리에서 나가야 합니다.‡Ayuda a Willix el Importador a salir de Horado Rajacieno.‡Escolta a Willix el Importador hasta que salga del Horado Rajacieno.‡Escorter Willix l\'Importateur hors du Kraal de Tranchebauge.‡护送进口商威利克斯逃出剃刀沼泽。‡護送進口商威利克斯逃出剃刀沼澤。',
  }
},
[1145] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Leve o Bilhete Selado de Korran para Belgrom Pedramalho em Orgrimmar.‡Отнесите запечатанную записку Коррана Белгрому Каменной Булаве в Оргриммар.‡Stellt Korrans versiegelte Notiz Belgrom Rockmaul in Orgrimmar zu.‡오그리마에 있는 벨그롬 록마울에게 코란의 봉인된 쪽지를 전해야 합니다.‡Entrégale la nota sellada de Korran a Belgrom Destrozarroca en Orgrimmar.‡Entrégale la nota lacrada de Korran a Belgrom Destrozarroca en Orgrimmar.‡Remettre la Note scellée de Korran à Belgrom Rockmaul à Orgrimmar.‡把科兰的密信交给奥格瑞玛的贝尔戈洛姆·石槌。‡把科蘭的密信交給奧格瑞瑪的貝爾戈洛姆·石槌。',
  }
},
[1146] = {
  -- Item
  '‡‡‡성서: 부활‡‡‡‡‡聖契:復活術',
  { -- Npc
    'Vharr‡Вхарр‡Vharr‡바르‡Vharr‡Vharr‡Vharr‡维哈尔‡維哈爾',
    'Armaria Superior‡Опытный оружейник‡Überragender Waffenschmied‡고급 무기제작자‡Forjador de armas superior‡Forjador de armas superior‡Excellent fabricant d\'armes‡高级铸剑师‡高級鑄劍師',
  },
  nil,
  { -- Quest
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Leve o Bilhete Selado de Belgrom para Moktar Krin em Mil Agulhas.‡Доставьте запечатанное письмо Белгрома Моктару Крину в Тысячу Игл.‡Stellt Belgroms versiegelte Notiz Moktar Krin in Tausend Nadeln zu.‡버섯구름 봉우리에 있는 목타르 크린에게 벨그롬의 봉인된 쪽지를 전해야 합니다.‡Entrégale la nota sellada de Belgrom a Moktar Krin en Las Mil Agujas.‡Entrégale la nota lacrada de Belgrom a Moktar Krin en Las Mil Agujas.‡Apporter la Note scellée de Belgrom à Moktar Krin aux Mille pointes.‡把贝尔戈洛姆的密信交给千针石林的摩克塔·克林。‡把貝爾戈洛姆的密信交給千針石林的摩克塔·克林。',
  }
},
[1147] = {
  nil,
  { -- Npc
    'Hragran‡Храгран‡Hragran‡라그란‡Hragran‡Hragran‡Hragran‡哈格兰‡哈格蘭',
    'Armaduras de Tecido e Couro‡Торговец тканевыми и кожаными доспехами‡Tuch- und Lederrüstungshändler‡천 및 가죽 방어구 상인‡Mercader de armaduras de tela y cuero‡Mercader de armaduras de tela y cuero‡Marchand d\'armures en étoffe & en cuir‡布甲和皮甲商人‡布甲和皮甲商人',
  },
  nil,
  { -- Quest
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Mate 5 Farejadores Silitídeos, 5 Zangões Silitídeos da Colmeia e 5 Invasores Silitídeos, depois fale novamente com Moktar Krin em Mil Agulhas.‡Убейте 5 силитидов-искателей, 5 силитидов-трутней и 5 силитидов-захватчиков, а потом вернитесь к Моктару Крину в Тысячу Игл.‡Tötet 5 Silithidsucher, 5 Silithidschwarmdrohnen sowie 5 Silithideindringlinge und kehrt zu Moktar Krin in Tausend Nadeln zurück.‡탐색꾼 실리시드 5마리, 일꾼 실리시드 5마리, 병정 실리시드 5마리를 처치하고 버섯구름 봉우리에 있는 목타르 크린에게 돌아가야 합니다.‡Mata a 5 buscadores silítidos, 5 zánganos de la Colmena silítida y 5 invasores silítidos, y después ve a ver de nuevo a Moktar Krin a Las Mil Agujas.‡Mata a 5 buscadores silítidos, 5 zánganos de colmena silítidos y 5 invasores silítidos, y después ve a ver de nuevo a Moktar Krin a Las Mil Agujas.‡Tuer 5 Chercheurs silithides, 5 Bourdons silithides et 5 Envahisseurs silithides, puis retourner voir Moktar Krin aux Mille pointes.‡杀掉5只异种搜寻者、5只异种筑巢蝎和5只异种侵略者，然后向千针石林的摩克塔·克林复命。‡殺掉5只異種搜尋者、5只異種築巢蠍和5只異種侵略者，然後向千針石林的摩克塔·克林復命。',
  }
},
[1148] = {
  nil,
  { -- Npc
    'Nerrist‡Неррист‡Nerrist‡네리스트‡Nerrist‡Nerrist‡Nerrist‡耐里斯特‡耐里斯特',
    'Mercadorias‡Хозяйственные товары‡Handwerkswaren‡직업용품 상인‡Objetos comerciables‡Objetos comerciables‡Fournitures d\'artisanat‡商人‡商人',
  },
  nil,
  { -- Quest
    'Pedaços do enxame‡Части роя‡Teile des Schwarms‡실리시드 등껍질‡Pedazos del enjambre‡Pedazos del enjambre‡Des parties de l\'essaim‡虫群的样本‡蟲群的樣本',
    nil,
    'Leve 1 Coração de Silitídeo, 5 Garras de Silitídeo e 3 Carapaças Intactas de Silitídeo para Korran na Encruzilhada.‡Добудьте 1 сердце, 5 шпор и 3 целых силитидских панциря для Коррана из Перекрестка.‡Bringt 1 Silithidenherz, 5 Silithidenkrallen und 3 intakte Silithidenknochenpanzer zu Korran in Crossroads.‡크로스로드에 있는 코란에게 실리시드의 심장 1개, 실리시드의 갈퀴발톱 5개, 온전한 실리시드의 등껍질 3개를 가져가야 합니다.‡Llévale 1 corazón de silítido, 5 espolones de silítido y 3 caparazones intactos de silítido a Korran, que está en El Cruce.‡Llévale 1 corazón de silítido, 5 garfas de silítido y 3 caparazones de silítido intactos a Korran, que está en El Cruce.‡Apporter 1 Coeur de silithide, 5 Serres de silithide et 3 Carapaces de silithide intactes à Korran, à la Croisée.‡收集1颗异种蝎的心脏、5只异种蝎的爪子和3个完整的异种蝎壳，把它们和你手中的这个破碎的异种蝎壳一起交给十字路口的科兰。‡收集1顆異種蠍的心臟、5只異種蠍的爪子和3個完整的異種蠍殼，把它們和妳手中的這個破碎的異種蠍殼壹起交給十字路口的科蘭。',
  }
},
[1149] = {
  -- Item
  '‡‡‡성서: 힘의 문장 II‡‡‡‡‡聖契:力量聖印 II',
  { -- Npc
    'Uthok‡Утхок‡Uthok‡우톡‡Uthok‡Uthok‡Uthok‡尤索克‡尤索克',
    'Suprimentos Sortidos‡Сто мелочей‡Gemischtwaren‡일용품 상인‡Suministros generales‡Suministros generales‡Fournitures générales‡杂货供应商‡雜貨供應商',
