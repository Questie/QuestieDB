  nil,
  { -- Quest
    'A busca continua‡Поиски продолжаются‡Die Suche geht weiter‡계속되는 수색‡La búsqueda continúa‡La búsqueda continúa‡La recherche continue‡继续搜寻‡繼續搜尋',
    nil,
    'Procure a Estatueta de Menethil.‡Найдите статуэтку Менетила.‡Sucht nach der Menethil-Statuette.‡메네실 조각상을 찾아야 합니다.‡Busca la Estatuilla de Menethil.‡Busca la Estatuilla de Menethil.‡Rechercher la Statuette de Menethil.‡搜索米奈希尔雕塑。‡搜索米奈希爾雕塑。',
  }
},
[285] = {
  -- Item
  '‡Малый чешуйчатый панцирь‡Schuppenpanzerweste‡미늘사슬 조끼‡Jubón de malla de escamas‡Jubón de malla de escamas‡Haubergeon d\'écailles‡鳞甲外衣‡鱗甲外衣',
  { -- Npc
    'Murloc‡Мурлок‡Murloc‡멀록‡Múrloc‡Múrloc‡Murloc‡鱼人‡魚人',
    nil,
  },
  nil,
  { -- Quest
    'Vasculhe mais cabanas‡Поиски в поселениях мурлоков‡Suche in weiteren Hütten‡다른 소굴 수색‡Inspecciona más casuchas‡Inspecciona más casuchas‡À la recherche d\'autres taudis‡搜寻雕像‡搜尋雕像',
    nil,
    'Continue vasculhando as cabanas dos Murlocs em busca da Estatueta de Menethil.‡Продолжите поиски статуэтки Менетила в поселении мурлоков.‡Sucht weiter in den Hütten der Murlocs nach der Menethil-Statuette.‡멀록 소굴에서 메네실 조각상을 계속 찾아봐야 합니다.‡Sigue buscando la Estatuilla de Menethil en las casuchas de los murlocs.‡Sigue buscando la Estatuilla de Menethil en las casuchas de los múrlocs.‡Continuer à fouiller les taudis des murlocs pour retrouver la Statuette de Menethil.‡继续在鱼人村落中搜寻米奈希尔雕像的踪迹。‡繼續在魚人村落中搜尋米奈希爾雕像的蹤跡。',
  }
},
[286] = {
  -- Item
  '‡Чешуйчатые штаны‡Schuppenpanzerhose‡미늘사슬 바지‡Pantalones de malla de escamas‡Pantalones de malla de escamas‡Pantalon en écailles‡鳞甲短裤‡鱗甲便褲',
  { -- Npc
    '‡‡‡‡‡‡‡‡老不死的基爾',
    nil,
  },
  nil,
  { -- Quest
    'Devolva a estatueta‡Возвращение статуэтки‡Rückgabe der Statuette‡조각상 돌려주기‡Devuelve la Estatuilla‡Devuelve la Estatuilla‡Rapporter la statuette‡归还雕像‡歸還雕像',
    nil,
    'Entregue a Estatueta de Menethil para Carlos Borba.‡Верните статуэтку Менетила Карлу Борану.‡Bringt Karl Boran die Menethil-Statuette.‡칼 보란에게 메네실 조각상을 가져가야 합니다.‡Lleva la Estatuilla de Menethil a Karl Boran.‡Llevále la estatuilla de Menethil a Karl Boran.‡Apporter la Statuette de Menethil à Karl Boran.‡将米奈希尔雕像还给卡尔·波兰。‡將米奈希爾雕像還給卡爾·波蘭。',
  }
},
[287] = {
  -- Item
  '‡Чешуйчатые сапоги‡Schuppenpanzerstiefel‡미늘사슬 장화‡Botas de malla de escamas‡Botas de malla de escamas‡Bottes en écailles‡鳞甲战靴‡鱗甲長靴',
  nil,
  -- Object
  'Registros do Contador Herodes‡Записи букмекера Герода‡Buchhalter Herods Aufzeichnungen‡사서 헤로드의 기록‡Documentos de Bookie Herod‡Documentos del corredor Herod‡Archives d\'Herod la Paperasse‡书呆子赫罗德的档案‡書呆子赫洛德的檔案',
  { -- Quest
    'A Fortaleza Jubafria‡Форт Мерзлогривов‡Höhle der Frostmane‡서리갈기 소굴‡Poblado Peloescarcha‡Poblado Peloescarcha‡Le repaire des Frostmane‡霜鬃巨魔要塞‡霜鬃巨魔要塞',
    nil,
    'Percorra a Fortaleza Jubafria e mate 5 Caçadores de Cabeças Jubafria a pedido de Senir Barbabranca em Kharanos.‡Обследуйте форт Мерзлогривов и убейте 5 охотников за головами из племени Мерзлогривов по просьбе Сенира Белоборода из Караноса.‡Erforscht die Höhle der Frostmane und tötet 5 Kopfjäger der Frostmane für Senir Whitebeard in Kharanos.‡서리갈기 소굴을 찾아 서리갈기부족 인간사냥꾼 5마리를 처치한 후 카라노스에 있는 세니르 화이트비어드에게 돌아와야 합니다.‡Explora el Poblado Peloescarcha y mata a 5 rebanacabezas Peloescarcha para Senir Barbablanca de Kharanos.‡Explora el Poblado Peloescarcha y mata a 5 rebanacabezas Peloescarcha para Senir Barbablanca de Kharanos.‡Explorer le repaire des Frostmane et tuer 5 Chasseurs de tête Frostmane pour Senir Whitebeard à Kharanos.‡侦查霜鬃巨魔要塞，替卡拉诺斯的森内尔·白须杀掉5个霜鬃猎头者。‡偵查霜鬃巨魔要塞，替卡拉諾斯的森內爾·白須殺掉5個霜鬃獵頭者。',
  }
},
[288] = {
  nil,
  { -- Npc
    'Medrisco‡Трясунчик‡Jitters‡지터스‡Altero‡Alterio‡La Tremblotte‡基特斯‡基特斯',
    nil,
  },
  -- Object
  'Cofre do Contador Herodes‡Сейф букмекера Герода‡Buchhalter Herods Geldkassette‡사서 헤로드의 금고‡Caja fuerte de Bookie Herod‡Caja fuerte del corredor Herod‡Coffre-fort d\'Herod la Paperasse‡书呆子赫罗德的保险箱‡書呆子赫洛德的保險箱',
  { -- Quest
    'A terceira frota‡Третья флотилия‡Die Dritte Flotte‡제 3함대‡La Tercera Flota‡La Tercera Flota‡La IIIe flotte‡第三舰队‡第三艦隊',
    nil,
    'Compre uma Jarra de Hidromel para o Primeiro Oficial Simonez.‡Купите первому помощнику Фитсиммонсу кружку медовухи.‡Spendiert dem ersten Maat Fitzsimmons einen Krug Met.‡일등항해사 피츠시몬즈에게 벌꿀술을 한 병 사 줘야 합니다.‡Compra un cántaro de hidromiel para el primer oficial Fistimos.‡Compra un cántaro de hidromiel para el contramaestre Fistimos.‡Acheter une Cruche d\'hydromel pour le Premier Officier Fitzsimmons.‡为大副菲兹莫斯买一份壶装蜜酒。‡為大副菲茲莫斯買壹份壺裝蜜酒。',
  }
},
[289] = {
  nil,
  { -- Npc
    'Abercrombie‡Аберкромби‡Calvinius‡에이버크롬비‡Abercrombie‡Abercrombie‡Abercrombie‡亚伯克隆比‡亞伯克隆比',
    'O Eremita‡Отшельник‡Der Einsiedler‡은둔자‡El ermitaño‡El ermitaño‡L\'ermite‡隐士‡隱士',
  },
  nil,
  { -- Quest
    'A tripulação amaldiçoada‡Проклятая команда‡Die verfluchte Crew‡저주받은 선원‡La tripulación maldita‡La tripulación maldita‡L\'équipage maudit‡被诅咒的船员‡被詛咒的船員',
    nil,
    'Mate 13 Marinheiros Amaldiçoados, 5 Fuzileiros Amaldiçoados e o Primeiro Oficial Expedito. Leve a Caixa de Rapé do Expedito para o Primeiro Oficial Simonez no Porto de Menethil.‡Убейте 13 проклятых матросов, 5 проклятых стражей бухты и первого помощника Снеллига. Принесите табакерку Снеллига первому помощнику Фитсиммонсу в Гавань Менетилов.‡Vernichtet 13 verfluchte Seeleute, 5 verfluchte Matrosen und den ersten Maat Snellig. Bringt Snelligs Schnupftabakdose zum ersten Maat Fitzsimmons im Hafen von Menethil.‡저주받은 선원 13명, 저주받은 해병 5명, 그리고 일등항해사 스넬리그를 처치해야 합니다. 메네실 항구에 있는 일등항해사 피츠시몬즈에게 스넬리그의 연초상자를 가져가야 합니다.‡Mata 13 marineros malditos, 5 marinos malditos y al primer oficial Esnelim. Lleva la caja de tabaco de Enelim al primer oficial Fistimos en Puerto de Menethil.‡Mata 13 marineros malditos, 5 marinos malditos y al contramaestre Snellig. Lleva la tabaquera de Snellig al contramaestre Fistimos en Puerto de Menethil.‡Tuer 13 Marins maudits, 5 Soldats de marine maudits et le Premier Officier Snellig. Rapporter la Tabatière de Snellig au Premier Officier Fitzsimmons au port de Menethil.‡杀死13个被诅咒的水手、5个被诅咒的水兵和大副斯涅利格。把斯涅利格的鼻烟盒交给米奈希尔的大副菲兹莫斯。‡殺死13個被詛咒的水手、5個被詛咒的水兵和大副斯涅利格。把斯涅利格的鼻煙盒交給米奈希爾的大副菲茲莫斯。',
  }
},
[290] = {
  nil,
  nil,
  -- Object
  'Guarda-roupas do Taturana‡Платяной шкаф Хмуроброва‡Furlbrows Kleiderschrank‡펄브로우의 옷장‡Guardarropa de Furlbrow‡Guardarropa de Cejade‡Penderie de Furlbrow‡法布隆的柜子‡法布隆的櫃子',
  { -- Quest
    'O fim da maldição‡Очищение‡Brechen des Fluchs‡저주 풀기‡Purga de la maldición‡Purga de la maldición‡Levée de la malédiction‡解除诅咒‡解除詛咒',
    nil,
    'Obtenha a Chave do Cofre do Intrépido do Capitão Halyndor.|nUse a chave para abrir o Cofre Trancado do Intrépido.‡Возьмите ключ от сейфа на "Отважном" у капитана Халиндора.|nОткройте сейф на "Отважном".‡Besorgt den Geldkassettenschlüssel der INTREPID von Kapitän Halyndor.|nVerwendet den Schlüssel, um die Geldkassette der INTREPID zu öffnen.‡할린도르 선장을 처치한 후 인트레피드호의 금고 열쇠를 손에 넣어야 합니다.|n그 열쇠를 사용하여 인트레피드호의 잠긴 금고를 열어야 합니다.‡Obtén la caja de la caja fuerte de El intrépido del capitán Halyndor.|nUtiliza la llave para abrir la caja fuerte de El intrépido.‡Obtén la llave de la caja fuerte de El Intrépido del capitán Halyndor.|nUtiliza la llave para abrir la caja fuerte de El Intrépido.‡Obtenir du capitaine Halyndor la Clé du coffre-fort de "l\'Intrépide".|nUtiliser la clé pour ouvrir le Coffre verrouillé de l\'Intrépide.‡从哈林多尔船长那里拿到无畏号的保险箱钥匙。|n用钥匙打开无畏号上的保险箱。‡從哈林多爾船長那裏拿到無畏號的保險箱鑰匙。|n用鑰匙打開無畏號上的保險箱。',
  }
},
[291] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Os relatórios‡Донесения‡Die Berichte‡보고‡Los informes‡Los informes‡Les rapports‡森内尔的报告‡森內爾的報告',
    nil,
    'Entregue o relatório de Senir ao Senador Barin Itarrubra em Altaforja.‡Отнесите донесение Сенира сенатору Бэрину Краснокамню в Стальгорн.‡Überbringt Senator Barin Redstone in Ironforge Senirs Bericht.‡아이언포지에 있는 원로원의원 바린 레드스톤에게 세니르의 보고서를 전달해야 합니다.‡Entrega el informe de Senir al senador Barin Rocarroja de Forjaz.‡Entrega el informe de Senir al senador Barin Rocarroja de Forjaz.‡Livrer le rapport de Senir au Sénateur Barin Redstone à Ironforge.‡把森内尔的报告交给铁炉堡的参议员巴林·红石。‡把森內爾的報告交給鐵爐堡的參議員巴林·紅石。',
  }
},
[292] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Olho de Paleth‡Око Палета‡Das Auge von Paleth‡팔레스의 눈‡El ojo de Paleth‡El ojo de Paleth‡L\'Oeil de Paleth‡帕雷斯之眼‡帕雷斯之眼',
    nil,
    'Leve o Olho Maldito de Paleth para Glorin Testaço.‡Отнесите проклятое Око Палета Глорину Стальному Лбу.‡Bringt Glorin Steelbrow das verfluchte Auge von Paleth.‡글로린 스틸브로우에게 팔레스의 저주받은 눈을 가져가야 합니다.‡Lleva el Ojo maldito de Paleth a Glorin Frenteacerada.‡Llévale el ojo maldito de Paleth a Glorin Frenteacerada.‡Apporter l\'Oeil maudit de Paleth à Glorin Steelbrow.‡把被诅咒的帕雷斯之眼交给戈罗林·钢眉。‡把被詛咒的帕雷斯之眼交給戈羅林·鋼眉。',
  }
},
[293] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A purificação do olho‡Проклятое Око‡Die Reinigung des Auges‡팔레스의 눈 정화‡Limpieza del ojo‡Limpieza del ojo‡Purifier l\'Oeil‡净化帕雷斯之眼‡凈化帕雷斯之眼',
    nil,
    'Leve o Olho Maldito de Paleth para o Arcebispo Benedictus. Benedictus se encontra na Catedral da Luz, na cidade de Ventobravo.‡Отнесите Око Палета архиепископу Бенедикту. Его можно найти в Соборе Света в Штормграде.‡Bringt Erzbischof Benedictus das verfluchte Auge von Paleth. Ihr findet Benedictus in der Kathedrale des Lichts, in der Stadt Stormwind.‡대주교 베네딕투스에게 팔레스의 저주받은 눈을 가져가야 합니다. 베네딕투스는 스톰윈드의 빛의 대성당에 있습니다.‡Lleva el Ojo maldito de Paleth al arzobispo Benedictus. Benedictus se encuentra en la Catedral de la Luz, en la ciudad de Ventormenta.‡Lleva el Ojo maldito de Paleth al arzobispo Benedictus. Benedictus se encuentra en la Catedral de la Luz, en la ciudad de Ventormenta.‡Apporter l\'Oeil maudit de Paleth à l\'archevêque Benedictus, à la cathédrale de la Lumière de la ville de Stormwind.‡把被诅咒的帕雷斯之眼交给大主教本尼迪塔斯，他就在暴风城的光明大教堂里。‡把被詛咒的帕雷斯之眼交給大主教本尼迪塔斯，他就在暴風城的光明大教堂裏。',
  }
},
[294] = {
  nil,
  { -- Npc
    'Delegado Fadigas‡Маршал Хаггард‡Marshal Haggard‡치안대장 해거드‡Alguacil Haggard‡Mariscal Haggard‡Maréchal Haggard‡治安官哈迦德‡治安官哈迦德',
    nil,
  },
  nil,
  { -- Quest
    'A revanche de Ormer‡Месть Ормера‡Ormers Rache‡오머의 복수‡La venganza de Ormer‡La venganza de Ormer‡La vengeance d\'Ormer‡奥莫尔的复仇‡奧莫爾的復仇',
    nil,
    'Ormer Trançaferro, no Sítio de Escavação Whelgar, quer que você mate 10 Guinchadores Mosqueados e 10 Raptores Mosqueados.‡Убейте 10 крапчатых ящеров и 10 крапчатых крикунов.‡Ormer Ironbraid von der Whelgars Ausgrabungsstätte möchte, dass Ihr 10 scheckige Kreischer und 10 scheckige Raptoren tötet.‡웰가르의 발굴현장에 있는 오머 아이언브레이드가 긴송곳니 줄무늬랩터 10마리와 줄무늬랩터 10마리를 처치해 달라고 부탁했습니다.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates 10 estridadores jaspeados y 10 raptores jaspeados.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates 10 estridadores jaspeados y 10 raptores jaspeados.‡Sur ordre d\'Ormer Ironbraid à l\'Excavation de Whelgar, tuer 10 Hurleurs tachetés et 10 Raptors tachetés.‡维尔加挖掘场的奥莫尔·铁衣要求你杀死10只杂斑迅猛龙和10只杂斑尖啸龙。‡維爾加挖掘場的奧莫爾·鐵衣要求妳殺死10只雜斑迅猛龍和10只雜斑尖嘯龍。',
  }
},
[295] = {
  nil,
  { -- Npc
    'Estalajadeiro Fábio‡Хозяин таверны Фарли‡Gastwirt Farley‡여관주인 팔레이‡Tabernero Farley‡Tabernero Farley‡Aubergiste Farley‡旅店老板法雷‡旅店老闆法雷',
    'Hospedagem‡Хозяин таверны‡Gastwirt‡여관주인‡Tabernero‡Tabernero‡Aubergiste‡旅店老板‡旅店老闆',
  },
  nil,
  { -- Quest
    'A revanche de Ormer‡Месть Ормера‡Ormers Rache‡오머의 복수‡La venganza de Ormer‡La venganza de Ormer‡La vengeance d\'Ormer‡奥莫尔的复仇‡奧莫爾的復仇',
    nil,
    'Ormer Trançaferro quer que você mate 10 Garrafoices Mosqueados e 10 Rasgaqueixos Mosqueados, depois fale novamente com ele no Sítio de Escavação Whelgar.‡Убейте 10 крапчатых смертехватов и 10 крапчатых острозубов. Вернитесь к Ормеру Сталеплету на раскоп Вельгара.‡Ormer Ironbraid möchte, dass Ihr 10 scheckige Sensenklauen- und 10 scheckige Scharfzahnraptoren tötet und dann zu ihm zu Whelgars Ausgrabungsstätte zurückkommt.‡웰가르의 발굴현장에 있는 오머 아이언브레이드가 갈퀴발톱 줄무늬랩터 10마리, 무쇠턱 줄무늬랩터 10마리를 처치해 달라고 부탁했습니다.‡Ormer Trenzaferro quiere que mates 10 raptores segadores jaspeados y 10 raptores tajobuches jaspeados y que vuelvas a verle en la Excavación de Whelgar.‡Ormer Trenzaferro quiere que mates 10 raptores segadores jaspeados y 10 raptores tajobuches jaspeados y que vuelvas a verle en la Excavación de Whelgar.‡Tuer 10 Faucheurs tachetés et 10 Tranchegueules tachetés pour Ormer Ironbraid, puis aller le voir à l\'excavation de Whelgar.‡奥莫尔·铁衣要求你杀死10只杂斑刺喉龙和10只杂斑锯齿龙，然后回到维尔加挖掘场向他复命。‡奧莫爾·鐵衣要求妳殺死10只雜斑刺喉龍和10只雜斑鋸齒龍，然後回到維爾加挖掘場向他復命。',
  }
},
[296] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A revanche de Ormer‡Месть Ормера‡Ormers Rache‡오머의 복수‡La venganza de Ormer‡La venganza de Ormer‡La vengeance d\'Ormer‡奥莫尔的复仇‡奧莫爾的復仇',
    nil,
    'Ormer Trançaferro, no Sítio de Escavação Whelgar, quer que você mate o Sarilodonte e leve uma de suas garras até ele depois que tiver cumprido a tarefa.‡Убейте Зарлозуба и принесите Ормеру Сталеплету один из когтей чудовища.‡Ormer Ironbraid von der Whelgars Ausgrabungsstätte möchte, dass Ihr Sarlatan tötet und mit einer seiner Krallen zu ihm zurückkehrt, sobald Ihr die Aufgabe erledigt habt.‡웰가르의 발굴현장에 있는 오머 아이언브레이드가 살투스를 처치한 후 발톱을 가져다 달라고 부탁했습니다.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates a Sarldente y que le lleves una de sus garras cuando completes la tarea.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates a Sarldente y que le lleves una de sus garfas cuando completes la tarea.‡Sur ordre d\'Ormer Ironbraid, de l\'Excavation de Whelgar, tuer Grondecroc et revenir avec l\'une de ses serres une fois la tâche accomplie.‡维尔加挖掘场的奥莫尔·铁衣要求你杀死萨尔图斯，并在任务完成之后带着它的一只爪子向他复命。‡維爾加挖掘場的奧莫爾·鐵衣要求妳殺死薩爾圖斯，並在任務完成之後帶著它的壹只爪子向他復命。',
  }
},
[297] = {
  nil,
  { -- Npc
    'Zelador Folsom‡Управляющий Фольсом‡Verwalter Folsom‡관리인 폴좀‡Custodio Folsom‡Custodio Folsom‡Conservateur Folsom‡管理员弗索姆‡管理員弗索姆',
    nil,
  },
  nil,
  { -- Quest
    'Juntando ídolos‡Сбор идолов‡Götzen sammeln‡조각상 모으기‡Recoger ídolos‡Recoger ídolos‡Réunir les idoles‡收集石像‡收集石像',
    nil,
    'Leve 8 Ídolos Esculpidos em Pedra para Magmar Machadeiro.‡Принесите Магмару Рудоколу 8 резных каменных идолов.‡Bringt Magmar Fellhew 8 verzierte Steingötzen.‡마그마 펠휴에게 돌 조각상 8개를 가져가야 합니다.‡Lleva 8 ídolos de piedra tallada a Magmar Tallavil.‡Llévale 8 ídolos de piedra grabados a Magmar Ceñimal.‡Apporter 8 Idoles de pierre sculptée à Magmar Fellhew.‡收集8个小石像，把它们交给麦格玛尔·落斧。‡收集8個小石像，把它們交給麥格瑪爾·落斧。',
  }
},
[298] = {
  nil,
  nil,
  -- Object
  '‡Телcамар‡‡텔사마‡‡Thelsamar‡‡塞尔萨玛‡塞爾薩瑪',
  { -- Quest
    'Relatório de progresso da escavação‡Отчет о ходе раскопок‡Bericht über den Fortschritt der Ausgrabungen‡발굴 상황 보고서‡Un informe sobre el avance de la excavación‡Un informe sobre el avance de la excavación‡Compte rendu d\'avancement des fouilles‡挖掘进度报告‡挖掘進度報告',
    nil,
    'Entregue o Relatório de Progresso de Bandaferro para Jern Elmocorno em Thelsamar.‡Отнесите отчет о ходе работ Джерну Шлеморогу в Телcамар.‡Bringt Ironbands Fortschrittsbericht zu Jern Hornhelm in Thelsamar.‡텔사마의 예른 혼헬름에게 아이언밴드의 상황 보고서를 가져가야 합니다.‡Lleva el informe de Vetaferro a Jern Cornamenta a Thelsamar.‡Lleva el informe de Vetaferro a Jern Cornamenta a Thelsamar.‡Apporter le Compte rendu d\'avancement d\'Ironband à Jern Hornhelm à Thelsamar.‡把铁环挖掘场的进度报告带给塞尔萨玛的吉恩·角盔。‡把鐵環挖掘場的進度報告帶給塞爾薩瑪的吉恩·角盔。',
  }
},
[299] = {
  nil,
  { -- Npc
    'Lobo Jovem‡Молодой волк‡Junger Wolf‡새끼 늑대‡Lobo joven‡Lobo joven‡Jeune loup‡幼狼‡幼狼',
    nil,
  },
  -- Object
  '‡Тлеющее ущелье‡Sengende Schlucht‡이글거리는 협곡‡La Garganta de Fuego‡La Garganta de Fuego‡Gorge des Vents brûlants‡灼热峡谷‡灼熱峽谷',
  { -- Quest
    'Desvendando o passado‡Тайны прошлого‡Enthüllung der Vergangenheit‡드러난 과거‡Desvelando el pasado‡Desvelando el pasado‡Découverte du passé‡发现历史‡發現歷史',
    nil,
    'O Prospector Whelgar quer que você revire o sítio de escavação em busca dos 4 fragmentos perdidos da tabuleta: Ados, Modr, Golm e Neru.‡Обыщите раскопки и найдите четыре недостающих фрагмента скрижали: Адос, Модр, Голм и Неру. Принесите их геологу Вельгару.‡Ausgrabungsleiter Whelgar wünscht, dass Ihr die Ausgrabungsstätte nach den 4 fehlenden Tafel-Fragmenten durchkämmt, Ados, Modr, Golm und Neru.‡발굴조사단장 웰가르가 발굴현장을 정리하고 사라진 아도스 조각, 모드르 조각, 골름 조각, 네루 조각을 가져다 달라고 부탁했습니다.‡El prospector Whelgar quiere que te adentres en la excavación en busca de los 4 fragmentos de tablilla perdidos: Ados, Modr, Golm y Neru.‡El prospector Whelgar quiere que te adentres en la excavación en busca de los 4 fragmentos de tablilla perdidos: Ados, Modr, Golm y Neru.‡À la demande du prospecteur Whelgar, parcourir l\'Excavation à la recherche des 4 fragments de tablette : Ados, Modr, Golm et Neru.‡勘察员维尔加要求你在挖掘场中搜索4块石板的碎片，它们是阿度斯碎片、莫德尔碎片、高尔姆碎片和奈尔鲁碎片。‡勘察員維爾加要求妳在挖掘場中搜索4塊石板的碎片，它們是阿度斯碎片、莫德爾碎片、高爾姆碎片和奈爾魯碎片。',
  }
},
[300] = {
  nil,
  { -- Npc
    'Zzarc\' Vul‡Ззарк\'Вул‡Zzarc\'Vul‡짜르크불‡Zzarc\' Vul‡Zzarc\' Vul‡Zzarc\' Vul‡扎克乌尔‡札克烏爾',
