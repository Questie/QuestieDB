[8120] = {
  -- Item
  '‡Геральдический плащ‡Heraldischer Umhang‡문장 망토‡Capa heráldica‡Capa heráldica‡Cape héraldique‡纹章披风‡紋章披風',
  { -- Npc
    'Abominação Sul\'lithuz‡Сул\'итуз-поганище‡Monstrosität von Sul\'lithuz‡흉포한 술리투즈‡Abominación Sul\'lithuz‡Abominación Sul\'lithuz‡Abomination Sul\'lithuz‡苏利萨斯憎恶‡蘇利薩斯憎惡',
    nil,
  },
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰！',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Нападите на рудник, лесопилку, кузницу и стойла в Низине Арати и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe und kehrt dann zu Todesmeister Dwire in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l’écurie du bassin d’Arathi, puis revenez voir le Maître noir Dwire, au Trépas-d’Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦洞、伐木場、鐵匠鋪和獸欄，然後向落錘鎮的屠殺者杜維爾復命。',
  }
},
[8121] = {
  -- Item
  '‡Геральдические перчатки‡Heraldische Handschuhe‡문장 장갑‡Guantes heráldicos‡Guantes heráldicos‡Gants héraldiques‡纹章手套‡紋章手套',
  { -- Npc
    'Jaxxil Fagulhas‡Джаксиль Искрец‡Jaxxil Sparks‡작실 스팍스‡Jaxxil Chispaz‡Jaxxil Chispaz‡Jaxxil Sparks‡加克希尔·斯巴克斯‡加克希爾·斯巴克斯',
    'Fogos de Artifício do Festival‡Продавец праздничных фейерверков‡Feiertagsfeuerwerkverkäufer‡폭죽 상인‡Vendedor de cohetes pirotécnicos para fiestas‡Vendedor de cohetes pirotécnicos para fiestas‡Vendeur de feux d\'artifice‡假日焰火商‡節日煙火商',
  },
  nil,
  { -- Quest
    'Tome quatro bases‡Захват четырех баз‡Erobert vier Stützpunkte‡거점 네 곳 점령‡Toma el control de cuatro bases‡Toma el control de cuatro bases‡Prendre quatre bases‡夺取四座基地‡奪取四座基地',
    nil,
    'Controle quatro bases ao mesmo tempo na Bacia Arathi. Depois, fale novamente com a Senhora da Morte Dwire, na Ruína do Martelo.‡Удерживайте одновременно четыре базы в Низине Арати, а затем возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Haltet vier Stützpunkte zurselben Zeit im Arathibecken und kehrt danach zu Todesmeister Dwire nach Hammerfall zurück.‡아라시 분지로 가서 네 곳의 거점을 동시에 확보하는 임무를 완수한 다음 망치 주둔지에 있는 죽음의경비대장 드와이어에게 가야 합니다.‡Toma el control de cuatro bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Toma el control de cuatro bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Contrôlez quatre bases du bassin d\'Arathi simultanément, puis revenez voir le Maître noir Dwire, au Trépas-d’Orgrim.‡同时占据阿拉希盆地中的四座基地，然后向落锤镇的屠杀者杜维尔复命。‡同時占據阿拉希盆地中的四座基地，然後向落錘鎮的屠殺者杜維爾復命。',
  }
},
[8122] = {
  -- Item
  '‡Геральдический головной убор‡Heraldisches Kopfstück‡문장 투구‡Celada heráldica‡Celada heráldica‡Chapel héraldique‡纹章头饰‡紋章首盔',
  { -- Npc
    'Kizzak Fagulhas‡Киззак Искрец‡Kizzak Sparks‡키자크 스팍스‡Kizzak Chispaz‡Kizzak Chispaz‡Kizzak Sparks‡基沙克·斯巴克斯‡基沙克·斯巴克斯',
    'Fogos de Artifício do Festival‡Продавец праздничных фейерверков‡Feiertagsfeuerwerkverkäufer‡폭죽 상인‡Vendedor de cohetes pirotécnicos para fiestas‡Vendedor de cohetes pirotécnicos para fiestas‡Vendeur de feux d\'artifice‡假日焰火商‡節日煙火商',
  },
  nil,
  { -- Quest
    'Tome cinco bases‡Занять пять баз‡Erobert fünf Stützpunkte‡거점 다섯 곳 점령‡Toma el control de cinco bases‡Toma el control de cinco bases‡Prendre cinq bases‡夺取五座基地‡',
    nil,
    'Controle cinco bases na Bacia Arathi ao mesmo tempo. Depois, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите и удерживайте все пять баз в Низине Арати, затем возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Haltet fünf Stützpunkte zurselben Zeit im Arathibecken und kehrt danach zu Todesmeister Dwire nach Hammerfall zurück.‡아라시 분지로 가서 다섯 곳의 거점을 동시에 확보하는 임무를 완수한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Toma el control de cinco bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Toma el control de cinco bases al mismo tiempo en la Cuenca de Arathi y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Contrôlez 5 bases du Bassin Arathi simultanément, puis revenez voir le Maître de la mort Dwire, au Trépas-d’Orgrim.‡同时占据阿拉希盆地中的五座基地，然后向落锤镇的屠杀者杜维尔复命。‡',
  }
},
[8123] = {
  -- Item
  '‡Геральдические поножи‡Heraldische Gamaschen‡문장 다리보호구‡Leotardos heráldicos‡Leotardos heráldicos‡Jambières héraldiques‡纹章护腿‡紋章護腿',
  { -- Npc
    'Rickle Farejouro‡Рикль Златочах‡Rickle Goldgrubber‡릭클 골드그러버‡Rickle Limpiaoro‡Rickle Limpiaoro‡Rickle Goldgrubber‡掘金者里克‡掘金者里克',
    'Caixa do Banco‡Банкир‡Bankier‡은행원‡Banquero‡Banquero‡Banquier‡银行职员‡銀行職員',
  },
  nil,
  { -- Quest
    'Quebra da rota de suprimentos de Arathor‡Перекрыть линии поставок Аратора‡Zerschlagt die Versorgungslinien Arathors‡아라소르 보급선 끊기‡Córtale el suministro a la Liga de Arathor‡Córtale el suministro a la Liga de Arathor‡Couper les voies de ravitaillement d\'Arathor‡切断阿拉索补给线‡切斷阿拉索補給線',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com o Sicário Mortis na Ruína do Martelo.‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡아라시 분지 전투를 승리로 이끌고 아라시 보급품 상자를 구해 해머폴에 있는 죽음의추적자 몰티스에게 가져가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au Traqueur noir Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡進入阿拉希盆地，獲得壹箱阿拉希資源箱，然後將它交給落錘鎮的亡靈哨兵莫提斯。',
  }
},
[8124] = {
  -- Item
  '‡Геральдический наплеч‡Heroldische Schiftung‡문장 어깨갑옷‡Bufas heráldicas‡Bufas heráldicas‡Spallières héraldiques‡纹章肩甲‡紋章肩甲',
  { -- Npc
    'Qizzik‡Квиззик‡Qizzik‡퀴직크‡Qizzik‡Qizzik‡Qizzik‡奇兹克‡奇茲克',
    'Caixa do Banco‡Банкир‡Bankier‡은행원‡Banquero‡Banquero‡Banquier‡银行职员‡銀行職員',
  },
  nil,
  { -- Quest
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au nécrotraqueur Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡',
  }
},
