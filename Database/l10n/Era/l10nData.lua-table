[535] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Vito‡Валлик‡Valik‡발릭‡Valik‡Valik‡Valik‡仆从瓦里克‡仆從瓦裏克',
    nil,
    'Leve um caneco de Stout da Costa Sul para Vito no acampamento da Camarilha.‡Принесите кружку эля из Южнобережья Вэллику в лагерь Синдиката.‡Bringt einen Becher mit Southshore-Starkbier zu Valik in das Lager des Syndikats.‡비밀결사대 야영지에 있는 발릭에게 사우스쇼어의 스타우트 맥주 한 잔을 가져가야 합니다.‡Llévale 1 jarra de cerveza Costasur a Valik en el campamento de la Hermandad.‡Llévale 1 jarra de cerveza de Costasur a Valik en el campamento de la Hermandad.‡Apporter une Chope de bière de Southshore à Valik, au Camp du Syndicat.‡给辛迪加营地里的瓦里克带去一杯南海镇烈酒。‡給辛迪加營地裏的瓦裏克帶去壹杯南海鎮烈酒。',
  }
},
[536] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Desceu pro mar‡На побережье‡Die Küste entlang‡해안의 위협‡Al lo largo de la costa‡En la costa‡Le long de la côte‡清理海岸‡清理海岸',
    nil,
    'Mate 10 Caçamarés Rancapinas e 10 Oráculos Rancapinas para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 волноловов из племени Порванного Плавника и 10 оракулов из племени Порванного Плавника по поручению лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Gezeitenjäger der Fetzenflossen und 10 Orakel der Fetzenflossen für Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬이 너덜지느러미멀록 바다사냥꾼 10마리와 너덜지느러미멀록 점쟁이 10마리를 처치해달라고 부탁했습니다.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del general Farren Orinelle de Costasur.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del teniente Farren Orinelle de Costasur.‡Tuer 10 Chasse-marées et 10 Oracles Aileron déchiré pour le lieutenant Farren Orinelle à Southshore.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个碎鳍潮行鱼人和10个碎鳍智者。‡南海鎮的法爾林·奧裏涅爾中尉要妳去殺掉10個碎鰭潮行魚人和10個碎鰭智者。',
  }
},
[537] = {
  -- Item
  '‡Тусклая чешуя бешенки‡Glanzlose Frenzyschuppe‡무딘 프렌지 비늘‡Escama frenesí mate‡Escama frenesí mate‡Ecaille de Furie terne‡灰暗的狂鱼鳞片‡灰暗的狂魚鱗片',
  nil,
  nil,
  { -- Quest
    'Concílio sombrio‡Темный совет‡Der Dunkle Rat‡어둠의 의회‡Consejo oscuro‡Consejo oscuro‡Le conseil noir‡黑暗议会‡黑暗議會',
    nil,
    'Mate 4 Magos das Sombras Argus.|nLeve a Cabeça de Nagaz ao Magistrado na Costa Sul.‡Убейте 4 темных магов Недремлющего Аргуса.|nПринесите голову Нагаза мировому судье Южнобережья Малебу.‡Tötet 4 Schattenmagier der Arguswacht.|nBringt den Kopf von Nagaz zu Magistrat Maleb nach Southshore.‡아르거스 재림회 어둠마법사 4명을 처치해야 합니다.|n그리고 나가즈를 처치한 증거로 그의 머리카락을 사우스쇼어에 있는 집정관 헨리 말레브에게 가야 합니다.‡Mata a 4 magos de la Sombra Argus.|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Mata a 4 magos de la Sombra Argus.|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Tuer 4 Mages de l\'ombre d\'Argus.|nApporter la Tête de Nagaz au Magistrat Maleb à Southshore.‡杀死4个暗影大法师。|n把纳伽兹的头带给南海镇的马雷布镇长。‡殺死4個暗影大法師。|n把納伽茲的頭帶給南海鎮的馬雷布鎮長。',
  }
},
[538] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Costa Sul‡Южнобережье‡Southshore‡사우스쇼어‡Costasur‡Costasur‡Southshore‡南海镇‡南海鎮',
    nil,
    'Fale com o Historiador Dibbs em Costa Sul.‡Поговорите с Хранителем мудрости Диббсом в Южнобережье.‡Sprecht mit dem Meister der Lehren Dibbs in Southshore.‡사우스쇼어에 있는 현자 딥스와 대화해야 합니다.‡Habla con el maestro del Conocimiento Dibbs en Costasur.‡Habla con el maestro cultural Dibbs en Costasur.‡Parler à l\'Erudit Dibbs à Southshore.‡与南海镇的博学者迪布斯交谈。‡與南海鎮的博學者迪布斯交談。',
  }
},
[539] = {
  nil,
  { -- Npc
    'Veneracna Pigmeia‡Карликовый ядовитый кругопряд‡Zwerggiftweberspinne‡새끼 그물독거미‡Telarácnida venenosa pigmea‡Telarácnida venenosa pigmea‡Araignée Tisse-venin pygmée‡小型结网毒蜘蛛‡小型結網毒蜘蛛',
    nil,
  },
  nil,
  { -- Quest
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Encarregado Grilhões e 10 Mineradores de Eira dos Montes, depois apresente-se novamente a Darthalia em Serraria Tarren.‡Убейте штейгера Бондса и 10 хилсбрадских шахтеров и доложите о проделанной работе Дарталии на мельнице Таррен.‡Tötet Großknecht Bonds sowie 10 Minenarbeiter von Hillsbrad und erstattet Bericht bei Darthalia in Tarrens Mühle.‡현장감독 본즈와 힐스브래드 광부 10명을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer le Contremaître Bonds et 10 Mineurs d\'Hillsbrad, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡杀死工头邦德斯和10个希尔斯布莱德矿工，然后回到塔伦米尔向达萨利亚汇报。‡殺死工頭邦德斯和10個希爾斯布萊德礦工，然後回到塔倫米爾向達薩利亞匯報。',
  }
},
[540] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O conhecimento precisa ser preservado‡Сохранение знаний‡Wissen bewahren‡지식 보존‡Proteger el conocimiento‡Proteger el conocimiento‡L\'entretien des connaissances‡保全书籍‡保全書籍',
    nil,
    'Leve 5 Tomos Recuperados e o Livro de Couro Desgastado contendo o Braço de Gri\'lek para o Historiador Dibbs, em Costa Sul.‡Найдите 5 фолиантов и потертую кожаную книгу, называемую "Рука Гри\'лека", и принесите их хранителю мудрости Диббсу в Южнобережье.‡Bringt 5 geborgene Folianten und das abgenutzte Lederbuch, das \'Der Arm von Gri\'lek\' enthält, zum Meister der Lehren Dibbs nach Southshore.‡되찾은 학술서 5권과 그리렉의 팔이 들어 있는 낡은 가죽 책을 사우스쇼어에 있는 현자 딥스에게 가져가야 합니다.‡Lleva 5 tomos y el libro de piel gastado que contiene El Arma de Gri\'lek al maestro del Conocimiento Dibbs a Costasur.‡Lleva 5 tomos y el libro de piel gastado que contiene El Arma de Gri\'lek al maestro cultural Dibbs a Costasur.‡Apporter 5 Tomes retrouvés, ainsi que le Livre de cuir usé « Le Bras de Gri\'lek » au Maître des traditions Dibbs, à Southshore.‡把5本失而复得的书籍和包含《格里雷克之臂》的破旧的皮书带给南海镇的博学者迪布斯。‡把5本失而復得的書籍和包含《格裏雷克之臂》的破舊的皮書帶給南海鎮的博學者迪布斯。',
  }
},
[541] = {
  nil,
  { -- Npc
    'Grifo de Montaria‡Ездовой грифон‡Reitgreif‡길들인 그리핀‡Grifo de montar‡Grifo de montar‡Gryphon‡狮鹫‡獅鷲獸',
    nil,
  },
  nil,
  { -- Quest
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Viaje até Dun Garok é mate 10 Montanhistas, 8 Carabineiros, 4 Sacerdotes e o Capitão Monteferro, depois apresente-se novamente a Darthalia na Serraria Tarren.‡Отправляйтесь в Дун Гарок и убейте 10 горных пехотинцев, 8 стрелков, 4 жрецов и капитана Железную Гору. После возвращайтесь к Дарталии на мельницу Таррен.‡Begebt Euch nach Dun Garok, tötet 10 Gebirgsjäger, 8 Scharfschützen, 4 Priester sowie Captain Eisenberg und erstattet danach Bericht bei Darthalia in Tarrens Mühle.‡던 가록으로 가서 던 가록 산악경비대 10명, 던 가록 소총병 8명, 던 가록 사제 4명과 부대장 아이언힐을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Ve a Dun Garok y mata a 10 montaraces, 8 fusileros, 4 sacerdotes y al capitán Ferrocolina e informa a Darthalia en Molino Tarren.‡Viaja a Dun Garok y mata 10 montaraces, 8 fusileros, 4 sacerdotes y al capitán Ferrocolina y vuelve a ver a Darthalia en Molino Tarren.‡Aller à Dun Garok et tuer 10 Montagnards, 8 Fusiliers, 4 Prêtres et le Capitaine Ironhill, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡到丹加洛克去杀掉10个巡山人、8个火枪手、4个牧师，还有达伦·铁山上尉，然后回到塔伦米尔向达萨利亚汇报。‡到丹加洛克去殺掉10個巡山人、8個火槍手、4個牧師，還有達倫·鐵山上尉，然後回到塔倫米爾向達薩利亞匯報。',
  }
},
[542] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡深林的卡利菲克斯',
    '‡‡‡‡‡‡‡‡德魯伊訓練師',
  },
  nil,
  { -- Quest
    'Fale novamente com Milton‡Возвращение к Милтону‡Rückkehr zu Milton‡밀턴에게 돌아가기‡Vuelve con Milton‡Regreso a Milton‡Les livres de Milton‡向米尔顿回复‡向米爾頓回復',
    nil,
    'Leve os Tomos de Alterac para Milton Resma, em Ventobravo.‡Отнесите фолианты Альтерака Милтону Снопу в Штормград.‡Bringt die Folianten von Alterac zu Milton Sheaf nach Stormwind.‡스톰윈드에 있는 밀턴 시프에게 알터랙의 학술서를 가져가야 합니다.‡Lleva los Tomos de Alterac a Milton Gavilla a Ventormenta.‡Lleva los Tomos de Alterac a Milton Gavilla a Ventormenta.‡Apporter les Tomes d\'Alterac à Milton Sheaf à Stormwind.‡把奥特兰克的书籍带给暴风城的米尔顿·西弗。‡把奧特蘭克的書籍帶給暴風城的米爾頓·西弗。',
  }
},
[543] = {
  nil,
  { -- Npc
    'Nalesette Frenesias‡Налезетта Буйный Нрав‡Nalesette Wildbringer‡날레세트 와일드브링어‡Nalesette Asilvestra‡Nalesette Asilvestra‡Nalesette Wildbringer‡纳雷塞特‡納雷塞特',
    'Adestramento‡Дрессировщица‡Tierausbilderin‡야수 조련사‡Instructora de mascotas‡Instructora de mascotas‡Maître des familiers‡宠物训练师‡寵物訓練師',
  },
  nil,
  { -- Quest
    'A Tiara de Perenolde‡Тиара Перенольда‡Die Perenolde-Tiara‡페레놀드 티아라‡La Tiara Perenolde‡La Tiara Perenolde‡La tiare de Perenolde‡匹瑞诺德王冠‡匹瑞諾德王冠',
    nil,
    'Leve a Tiara de Perenolde para o Conde Capistrano de Espargosa, em Ventobravo.‡Доставьте тиару Перенольда Ремингтону Риджвеллу в Штормград.‡Bringt die Perenolde-Tiara zu Remington Ridgewell nach Stormwind.‡스톰윈드에 있는 레밍턴 리지웰에게 페레놀드 티아라를 가져가야 합니다.‡Lleva la Tiara Perenolde a Remington Crestabuena en Ventormenta.‡Llévale la Tiara Perenolde a Remington Bonacresta en Ventormenta.‡Apporter la Tiare de Perenolde à Remington Ridgewell, à Stormwind.‡将匹瑞诺德王冠带给暴风城的雷明顿·瑞治维尔。‡將匹瑞諾德王冠帶給暴風城的雷明頓·瑞治維爾。',
  }
},
[544] = {
  nil,
  { -- Npc
    'Reptante Murloc‡Мурлок-следопыт‡Murlocnachtkriecher‡멀록 기습꾼‡Reptanoches múrloc‡Reptanoches múrloc‡Marcheur de l\'ombre murloc‡鱼人夜行者‡魚人夜行者',
    nil,
  },
  nil,
  { -- Quest
    'Invasão da prisão‡Взлом тюрьмы‡Gefängnis-Einbruch‡감옥 습격‡Colarse en la cárcel‡Colarse en la cárcel‡L\'invasion de la prison‡入室偷窃‡入室偷竊',
    nil,
    'Encontre os traidores e recupere os artefatos, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Найдите предателей и отберите у них артефакты, а потом возвращайтесь к волхву Сиянью Бездны в Мельницу Таррен.‡Findet diese Verräter, sammelt ihre Artefakte ein und kehrt dann zu Magus Voidglare nach Tarrens Mühle zurück.‡배반자들을 찾아내 유물을 되찾은 다음 타렌 밀농장에 있는 학자 워딘 보이드글레어에게 돌아가야 합니다.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el mago Vacuamirada en Molino Tarren.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el magus Vacuamirada en Molino Tarren.‡Trouver les traîtres et récupérer les artefacts, puis retourner voir le magus Voidglare à Moulin-de-Tarren.‡找到被遗忘者的叛徒，取回他们偷走的神器，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡找到被遺忘者的叛徒，取回他們偷走的神器，然後回到塔倫米爾去見大法師沃迪恩·伍德格萊爾。',
  }
},
[545] = {
  nil,
  { -- Npc
    'Chamaré Murloc‡Мурлок-волномут‡Murlocgezeitenrufer‡멀록 파도술사‡Llamamareas múrloc‡Llamamareas múrloc‡Maître des flots murloc‡鱼人招潮者‡魚人招潮者',
    nil,
  },
  nil,
  { -- Quest
    'Patrulhas de Dalaran‡Даларанские патрули‡Patrouillen von Dalaran‡달라란 순찰‡Las patrullas de Dalaran‡Las patrullas de Dalaran‡Les patrouilles de Dalaran‡达拉然巡逻队‡達拉然巡邏隊',
    nil,
    'Mate 6 Evocadores de Dalaran e 12 Escravos Elementais, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Убейте 6 даларанских призывателей и 12 порабощенных элементалей. Затем возвращайтесь к волхву Сиянью Бездны на мельницу Таррен.‡Tötet 6 Beschwörer von Dalaran sowie 12 Elementarsklaven und kehrt dann zu Magus Voidglare nach Tarrens Mühle zurück.‡달라란 소환사 6명과 노예 바위 정령 12마리를 처치한 다음 타렌 밀농장에 있는 학자 워딘 보이드글레어에게 돌아가야 합니다.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el mago Vacuamirada en Molino Tarren.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el magus Vacuamirada en Molino Tarren.‡Tuer 6 Invocateurs de Dalaran et 12 Esclaves élémentaires, puis retourner voir le magus Voidglare à Moulin-de-Tarren.‡杀掉6个达拉然召唤师和12个元素奴仆，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡殺掉6個達拉然召喚師和12個元素奴仆，然後回到塔倫米爾去見大法師沃迪恩·伍德格萊爾。',
  }
},
[546] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Lembrancinhas da morte‡Сувениры смерти‡Andenken des Todes‡죽음의 전리품‡Recuerdos de muerte‡Recuerdos de muerte‡Souvenirs de morts‡死亡的纪念品‡死亡的紀念品',
    nil,
    'O Necroguarda Sandoval da Serraria Tarren quer 30 Crânios Humanos de Eira dos Montes.‡Страж смерти Самса с мельницы Таррен попросил принести 30 человеческих черепов Хилсбрада.‡Todeswache Samsa aus Tarrens Mühle will 30 menschliche Schädel aus Hillsbrad.‡타렌 밀농장에 있는 죽음의경비병 삼사가 힐스브래드 주민의 해골 30개를 가져다 달라고 부탁했습니다.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 calaveras humanas de Trabalomas.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 calaveras humanas de Trabalomas.‡Le Garde noir Samsa du Moulin-de-Tarren veut 30 Crânes d\'humains d\'Hillsbrad.‡塔伦米尔的亡灵卫兵沙穆萨想要30个希尔斯布莱德人类颅骨。‡塔倫米爾的亡靈衛兵沙穆薩想要30個希爾斯布萊德人類顱骨。',
  }
},
[547] = {
  nil,
  { -- Npc
    'Grande Goretusco‡Большой жутевепрь‡Großer Geiferzahn‡큰 뿔엄니멧돼지‡Gran dentosangre‡Gran dentosangre‡Grand Broche-tripes‡巨型血牙野猪‡巨型血牙野豬',
    nil,
  },
  nil,
  { -- Quest
    'Espada do Humberto‡Меч Гумберта‡Humberts Schwert‡험버트의 검‡La espada de Humbert‡La espada de Humbert‡Epée d\'Humbert‡亨伯特的长剑‡亨伯特的長劍',
    nil,
    'Recupere a espada do Necroguarda Humberto em Dun Garok e devolva-a para ele na Serraria Tarren.‡Найдите меч стража смерти Гумберта в Дун Гароке и верните его владельцу на мельнице Таррен.‡Bringt das Schwert von Todeswache Humbert aus Dun Garok zu ihm nach Tarrens Mühle zurück.‡던 가록에서 죽음의경비병 험버트의 검을 되찾아 타렌 밀농장으로 돌아와 험버트에게 검을 돌려줘야 합니다.‡Recoge la espada del guardia de la muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Recoge la espada del Guardia de la Muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Retrouver l\'Epée du Garde noir Humbert et la lui retourner à Moulin-de-Tarren.‡从丹加洛克拿回亡灵卫兵亨伯特的长剑，然后回到塔伦米尔把剑还给他。‡從丹加洛克拿回亡靈衛兵亨伯特的長劍，然後回到塔倫米爾把劍還給他。',
  }
},
[548] = {
  nil,
  { -- Npc
    'Chamaré Murloc Pequeno‡Низший мурлок-волномут‡Schwacher Murlocgezeitenrufer‡멀록 술사‡Llamamareas menor múrloc‡Llamamareas menor múrloc‡Maître des flots murloc mineur‡鱼人小招潮者‡魚人小招潮者',
    nil,
