  nil,
  { -- Quest
    'Contendo a ameaça‡Устранение угрозы‡Die Auswahl der Bedrohung‡위협 제거‡Matanza selectiva‡Matanza selectiva‡Diminution de la menace‡解除威胁‡解除威脅',
    nil,
    'Leve o Crânio de Dal Sangarra para Raene Correlobos em Astranaar.‡Принесите череп Дала Жилотяга Раэне Волкопас в Астранаар.‡Bringt Raene Wolfrunner in Astranaar Dal Blutklaues Schädel.‡아스트라나르에 있는 레이네 울프러너에게 달 블러드클로의 해골을 가져가야 합니다.‡Llévale la calavera de Dal Zarpasangrante a Raene Correlobo en Astranaar.‡Llévale la calavera de Dal Zarpasangrante a Raene Correlobo en Astranaar.‡Apporter le Crâne de Dal Griffesang à Raene Wolfrunner à Astranaar.‡把达尔·血爪的颅骨交给阿斯特兰纳的莱恩·狼行者。‡把達爾·血爪的顱骨交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1055] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡獵夢者',
    nil,
  },
  nil,
  { -- Quest
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Fale novamente com Shael\'dryn no poço lunar.‡Вернитесь к Шаэлдрин у лунного колодца.‡Kehrt zu Shael\'dryn beim Mondbrunnen zurück.‡달샘에 있는 셸드린에게 돌아가십시오.‡Vuelve junto a Shael\'dryn en la poza de la luna.‡Vuelve junto a Shael\'dryn en la Poza de la Luna.‡Retourner voir Shael\'dryn au puits de lune.‡回到月亮井旁的莎尔蒂恩那里。‡回到月亮井旁的莎爾蒂恩那裏。',
  }
},
[1056] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡翡翠哨兵',
    nil,
  },
  nil,
  { -- Quest
    'A jornada para o Morro das Torres de Pedra‡Путешествие к Пику Каменного Когтя‡Reise zum Steinkrallengipfel‡돌발톱 봉우리로의 여정‡Viaje a Cima del Espolón‡Viaje a Cima del Espolón‡Voyage au pic des Serres-Rocheuses‡石爪峰之旅‡石爪峰之旅',
    nil,
    'Vá até o Guardião Albagorm no Morro das Torres de Pedra.‡Отправляйтесь к хранителю Албагорму на Пик Каменного Когтя.‡Reist zu Bewahrer Albagorm auf dem Steinkrallengipfel.‡돌발톱 봉우리에 있는 수호자 알바고름을 찾아가십시오.‡Ve junto al vigilante Albagorm en la Cima del Espolón.‡Ve junto al vigilante Albagorm en la Cima del Espolón.‡Voyager pour aller voir le Gardien Albagorm au pic des Serres-Rocheuses.‡拜访石爪峰的看守者奥巴格姆。‡拜訪石爪峰的看守者奧巴格姆。',
  }
},
[1057] = {
  -- Item
  '‡‡‡서판: 복원 III‡‡‡‡‡石板:復原術 III',
  { -- Npc
    'Guarda-ossos Presa do Dragão‡Костостраж из клана Драконьей Пасти‡Knochenwärter der Dragonmaw‡용아귀부족 해골감시자‡Guardahuesos Faucedraco‡Guardahuesos Faucedraco‡Gardien Dragonmaw‡龙喉白骨守卫‡龍喉骸骨守衛',
    nil,
  },
  nil,
  { -- Quest
    'Reivindicando o Vale Carbonizado‡Возвращение Обугленной долины‡Die Rückeroberung des verbrannten Tals‡잿더미 계곡 복원‡La reconquista de La Vega Carbonizada‡La reconquista de La Vega Carbonizada‡À la reconquête du Val calciné‡夺回焦炭谷‡奪回焦炭谷',
    nil,
    'O Guardião Albagorm, no Morro das Torres de Pedra, quer que você mate 7 Harpias Furissangue, 7 Emboscadoras Furissangue e 7 Plumerrantes Furissangue.‡Хранитель Албагорм с Пика Каменного Когтя просит вас убить 7 гарпий, 7 душительниц, 7 душегубок и 7 бродяжниц из стаи Кровавой Ярости.‡Bewahrer Albagorm auf dem Steinkrallengipfel möchte, dass Ihr 7 Harpyien der Blutfurien, 7 Wegelagerinnen der Blutfurien, 7 Töterinnen der Blutfurien und 7 Wildfedern der Blutfurien erschlagt.‡돌발톱 봉우리에 있는 수호자 알바고름이 혈폭풍하피 7마리, 혈폭풍일족 복병 7마리, 혈폭풍일족 암살자 7마리, 그리고 혈폭풍일족 약탈자 7마리를 처치해 달라고 부탁했습니다.‡El vigilante Albagorm en la Cima del Espolón quiere que mates 7 arpías Furia Sangrienta, 7 emboscadores Furia Sangrienta, 7 cazadores Furia Sangrienta y 7 Plumapícaros Furia Sangrienta.‡El vigilante Albagorm en la Cima del Espolón quiere que mates a 7 arpías Furia Sangrienta, a 7 emboscadoras Furia Sangrienta, a 7 destripadoras Furia Sangrienta y a 7 malaplumas Furia Sangrienta.‡Le Gardien Albagorm du pic des Serres-Rocheuses veut que vous tuiez 7 Harpies, 7 Embusqués, 7 Tueuses et 7 Volplumes Rougefuries.‡石爪峰的守护者奥巴格姆要求你杀死7个血怒鹰身人、7个血怒伏击者、7个血怒杀戮者和7个血怒游荡者。‡石爪峰的守護者奧巴格姆要求妳殺死7個血怒鷹身人、7個血怒伏擊者、7個血怒殺戮者和7個血怒遊蕩者。',
  }
},
[1058] = {
  -- Item
  '‡‡‡서판: 번개 화살 III‡‡‡‡‡石板:閃電箭 III',
  nil,
  nil,
  { -- Quest
    'A magia florestal de Jin\'Zil‡Лесная магия Джин\'Зила‡Jin\'Zils Waldmagie‡진질의 숲의 마법‡Magia del bosque de Jin\'Zil‡Magia del bosque de Jin\'Zil‡Magie de la forêt de Jin\'Zil‡金吉尔的森林魔法‡金吉爾的森林魔法',
    nil,
    'O Mandingueiro Jin\'Zil, em Malaka\'jin, quer 5 porções de Seiva das Torres de Pedra, 5 Bigodes de Felino do Crepúsculo, 30 Olhos de Corcel e uma Escama de Dragão Encantado.‡Знахарь Джин\'Зил из Малака\'джина требует принести 5 порций слизи Каменного когтя, 5 сумеречных усиков, 30 глаз бегового оленя и чешуйку волшебного дракончика.‡Hexendoktor Jin\'Zil in Malaka\'jin möchte 5 Portionen Steinkrallensaft, 5 Schnurrhaare eines Mondlichtläufers, 30 Renner-Augen und die Schuppe eines Siechdrachen.‡말라카진에 있는 의술사 진질이 돌발톱 수액 5개, 황혼의 수염 5개, 순록의 눈 30개와 마룡 비늘 1개를 가져다 달라고 부탁했습니다.‡El médico brujo Jin\'Zil en Malaka\'jin quiere 5 porciones de savia Espolón, 5 mostachias Crepusculares, 30 ojos de corcel y una escama de dragón Fey.‡El médico brujo Jin\'Zil en Malaka\'jin quiere 5 porciones de savia del Espolón, 5 mostachos Crepusculares, 30 ojos de trotadores y una escama de dragón hada.‡Le sorcier-docteur Jin\'Zil à Malaka\'jin veut 5 doses de Sève des Serres-Rocheuses, 5 Moustaches crépusculaires, 30 Yeux de coursier et une Ecaille de dragon-faë.‡玛拉卡金的巫医金吉尔需要5瓶石爪苔液、5根夜行虎须、30颗巨角鹿的眼球和1块灵龙的鳞片。‡瑪拉卡金的巫醫金吉爾需要5瓶石爪苔液、5根夜行虎須、30顆巨角鹿的眼球和1塊靈龍的鱗片。',
  }
},
[1059] = {
  nil,
  { -- Npc
    'Ana\'thek, o Cruel‡Анатек Жестокий‡Ana\'thek der Grausame‡학살자 아나텍‡Ana\'thek el Cruel‡Ana\'thek el Cruel‡Ana\'thek le Cruel‡残忍的安纳希克‡殘忍的安納希克',
    'Chefe Rachacrânio‡Вождь клана Дробителей Черепов‡Häuptling der Skullsplitter‡백골가루 부족장‡Jefe Machacacráneos‡Jefe Machacacráneos‡Chef des Skullsplitter‡碎颅酋长‡劈顱酋長',
  },
  nil,
  { -- Quest
    'Reivindicando o Vale Carbonizado‡Возвращение Горелой Долины‡Die Rückeroberung des verbrannten Tals‡잿더미 계곡 복원‡La reconquista de La Vega Carbonizada‡La reconquista de La Vega Carbonizada‡À la reconquête du Val calciné‡夺回焦炭谷‡奪回焦炭谷',
    nil,
    'Viaje até Falfindel Trilhemas na fronteira entre Mil Agulhas e Feralas.‡Отправляйтесь к Фалфиндеру Хранителю Дорог, живущему на границе Тысячи Игл и Фераласа.‡Reist zu Falfindel Waywarder an der Grenze zwischen Tausend Nadeln und Feralas.‡버섯구름 봉우리와 페랄라스의 경계에 있는 팔핀델 웨이워더를 찾아가야 합니다.‡Ve a ver al Díscolo Falfindel en la frontera entre Las Mil Agujas y Feralas.‡Ve a ver al Díscolo Falfindel en la frontera entre Las Mil Agujas y Feralas.‡Trouver Falfindel Waywarder à la frontière entre les Mille pointes et Feralas.‡在千针石林与菲拉斯的边境上找到法芬德尔。‡在千針石林與菲拉斯的邊境上找到法芬德爾。',
  }
},
[1060] = {
  nil,
  { -- Npc
    'Mogh, o Eterno‡Могх Неумирающий‡Mogh der Unsterbliche‡불사신 모그‡Mogh el Eterno‡Mogh el Eterno‡Mogh l\'Immortel‡死灵莫格‡不死的莫格',
    'Mandingueiro do Clã Rachacrânio‡Знахарь клана Дробителей Черепов‡Hexendoktor der Skullsplitter‡백골가루부족 의술사‡Médico brujo del clan Machacacráneos‡Médico brujo del clan Machacacráneos‡Sorcier-docteur du clan Skullsplitter‡碎颅部族巫医‡劈顱氏族巫醫',
  },
  nil,
  { -- Quest
    'Uma carta para Jin\'Zil‡Письмо Джин\'Зилу‡Brief an Jin\'Zil‡진질에게 보내는 편지‡Una carta para Jin\'Zil‡Carta para Jin\'Zil‡Lettre à Jin\'Zil‡写给金吉尔的信‡寫給金吉爾的信',
    nil,
    'Entregue a carta de Darsok a Jin\'Zil em sua caverna em Malaka\'jin, nas Torres de Pedra.‡Отнесите письмо Дарсока Джин\'Зилу в пещеру Малака\'джин в Когтистых горах.‡Überbringt Jin\'Zil in seiner Höhle im Steinkrallengebirge Darsoks Brief.‡돌발톱 산맥의 동굴에서 야영을 하는 진질에게 달소크의 편지를 전달하십시오.‡Entrégale la carta de Darsok a Jin\'Zil en su cueva de Malaka\'jin, en Espolón.‡Entrégale la carta de Darsok a Jin\'Zil en su cueva de Malaka\'jin, en Espolón.‡Remettre la lettre de Darsok à Jin\'Zil dans sa caverne des Serres-Rocheuses.‡把达索克的亲笔信交给金吉尔，他住在石爪山的洞穴中。‡把達索克的親筆信交給金吉爾，他住在石爪山的洞穴中。',
  }
},
[1061] = {
  -- Item
  '‡‡‡서판: 독 무효화 II‡‡‡‡‡石板:消毒術 II',
  { -- Npc
    'Gan\'zulah‡Ган\'зулах‡Gan\'zulah‡간줄라‡Gan\'zulah‡Gan\'zulah‡Gan\'zulah‡甘祖拉恩‡甘祖拉恩',
    'Chefe Sanguescalpo‡Вождь племени Кровавого Скальпа‡Häuptling der Bloodscalp‡붉은머리부족장‡Jefe Sangrapellejo‡Jefe Sangrapellejo‡Chef des Bloodscalp‡血顶酋长‡血頂酋長',
  },
  nil,
  { -- Quest
    'Os espíritos das Torres de Pedra‡Духи Каменного Когтя‡Die Geister des Steinkrallengebirges‡돌발톱 산맥의 정령‡Los espíritus del Espolón‡Los espíritus del Espolón‡Les esprits des Serres-Rocheuses‡石爪之灵‡石爪之靈',
    nil,
    'Fale com Seereth Quebra-pedra na Cordilheira das Torres de Pedra.‡Поговорите с Сирит Камнелом в Когтистых горах.‡Sprecht im Steinkrallengebirge mit Seereth Stonebreak.‡돌발톱 산맥에 있는 시리스 스톤브레이크와 대화하십시오.‡Habla con Seereth Rompepedras en Sierra Espolón.‡Habla con Seereth Petrajada en Sierra Espolón.‡Parler à Seereth Stonebreak dans les Serres-Rocheuses.‡找到石爪山的希雷斯·碎石并和她谈一谈。‡找到石爪山的希雷斯·碎石並和她談壹談。',
  }
},
[1062] = {
  nil,
  { -- Npc
    'Nezzliok, o Ríspido‡Неззилок Зловещий‡Nezzliok der Düstere‡공포의 네즐뤼크‡Nezzliok el Feroz‡Nezzliok el Temible ‡Nezzliok le Redoutable‡可怕的奈兹里奥克‡可怕的奈茲里奧克',
    'Mandingueiro do Clã Sanguescalpo‡Знахарь племени Кровавого Скальпа‡Hexendoktor der Bloodscalp‡붉은머리부족 의술사‡Médico brujo del clan Sangrapellejo‡Médico brujo del clan Sangrapellejo‡Sorcier-docteur du clan Bloodscalp‡血顶部族巫医‡血頂氏族巫醫',
  },
  nil,
  { -- Quest
    'Invasores goblins‡Вторжение гоблинов‡Goblin-Eindringlinge‡고블린 침략자‡Los invasores goblin‡Los invasores goblin‡Les invasions gobelines‡地精侵略者‡地精侵略者',
    nil,
    'Mate 15 Madeireiros da Empreendimentos S.A. e, então, fale novamente com Seereth Quebra-pedra na fronteira entre as Torres de Pedra e os Sertões.‡Убейте 15 лесорубов Торговой компании, затем вернитесь к Сирет Камнелом на границу Каменного Когтя и Степей.‡Tötet 15 Holzfäller der Venture Co. und kehrt dann zu Seereth Stonebreak an der Grenze des Steinkrallengebirges und dem Brachland zurück.‡투자개발회사 나무꾼 15명을 처치한 다음 돌발톱 산맥과 불모의 땅의 경계에 있는 시리스 스톤브레이크에게 돌아가십시오.‡Mata 15 leñeros de Ventura y Cía. y vuelve a ver a Seereth Rompepedras, en la frontera entre Espolón y Los Baldíos.‡Mata a 15 leñadores de Ventura y Cía. y vuelve a ver a Seereth Petrajada, en la frontera entre Espolón y Los Baldíos.‡Tuer 15 Déboiseurs de la KapitalRisk, puis retourner auprès de Seereth Stonebreak à la frontière des Serres-Rocheuses et des Tarides.‡杀死15个风险投资公司樵夫，然后向石爪山与贫瘠之地交界处的希雷斯·碎石复命。‡殺死15個風險投資公司樵夫，然後向石爪山與貧瘠之地交界處的希雷斯·碎石復命。',
  }
},
[1063] = {
