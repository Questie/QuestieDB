[7401] = {
  nil,
  { -- Npc
    'Refugiado Draenei‡Дреней-беженец‡Flüchtling der Draenei‡드레나이 피난민‡Refugiado draenei‡Refugiado draenei‡Réfugié draeneï‡德莱尼难民‡德萊尼難民',
    nil,
  },
  nil,
  { -- Quest
    'PROCURAM-SE: anões!‡РАЗЫСКИВАЮТСЯ: дворфы!‡GESUCHT: Zwerge!‡현상 수배: 드워프!‡SE BUSCA: ¡enanos!‡Se buscan: ¡ENANOS!‡ON RECHERCHE : des Nains !‡通缉：矮人！‡懸賞:矮人!',
    nil,
    'Você recebeu a missão de matar jogadores Anões inimigos no Vale Alterac.|nMate um Anão e arranque sua espinha. Leve a Espinha de Anão para a Sargento Yazra Rosnassangue na Bastilha Lobo do Gelo.‡Ваша задача – убивать дворфов в Альтеракской долине.|nУбейте дворфа и вырвите ему хребет. Отнесите хребет дворфа сержанту Язре Кровавый Рык в крепость Северного Волка.‡Ihr wurdet damit beauftragt, alle feindlichen Zwergenspieler im Alteractal zu töten.|nTötet einen Zwerg und schneidet ihm sein Rückgrat heraus. Bringt anschließend das Zwergenrückgrat zu Unteroffizierin Yazra Murrblut in Burg Frostwolf.‡알터랙 계곡에서 얼라이언스 진영의 드워프 플레이어를 쓰러뜨리라는 임무를 받았습니다.|n드워프를 처치하고 서리늑대 요새에 있는 하사관 야즈라 블러드스날에게 드워프 해골을 가져가야 합니다.‡Se te asignado la tarea de matar a los jugadores enanos en el Valle de Alterac.|nMata a un enano y sácale la espina dorsal. Llévasela al sargento Yazra Gruñido Sangriento en el Bastión Lobo Gélido.‡Se te asignado la tarea de matar a los jugadores enanos en el Valle de Alterac.|nMata a un enano y sácale la espina dorsal. Llévasela al sargento Yazra Gruñido Sangriento en el Bastión Lobo Gélido.‡Vous avez été <chargé/chargée> de tuer les personnages nains présents dans la vallée d’Alterac.|nTuez des Nains et arrachez-leur la colonne vertébrale. Apportez les Colonnes vertébrales de Nains au sergent Yazra Gronde-Sang au donjon Loup-de-givre.‡你被指派去杀死奥特兰克山谷中的矮人玩家。|n|n杀掉一个矮人，然后把矮人的脊椎交给霜狼要塞的亚斯拉·血矛。‡',
  }
},
[7402] = {
  nil,
  { -- Npc
    'Totem Calcinante VI‡Опаляющий тотем VI‡Totem der Verbrennung VI‡불타는 토템 VI‡Tótem abrasador VI‡Tótem abrasador VI‡Totem incendiaire VI‡灼热图腾 VI‡灼熱圖騰 VI',
    nil,
  },
  nil,
  { -- Quest
    'PROCURAM-SE: orcs!‡Разыскиваются: ОРКИ!‡GESUCHT: ORCS!‡현상 수배: 오크!‡Se buscan: ¡ORCOS!‡Se buscan: ¡ORCOS!‡On recherche : ORCS !‡通缉：兽人！‡通緝：獸人！',
    nil,
    'Você recebeu a missão de matar jogadores orcs inimigos no Vale Alterac.|nMate um orc e leve um Dente de Orc para o Cabo Noreg Lançatroz em Dun Baldar.‡Ваше задание – убивать орков в Альтеракской долине.|nУбейте орка и доставьте зуб орка капралу Норгу Грозовой Вершине в Дун Болдар.‡Ihr wurdet damit beauftragt, alle feindlichen orcischen Spieler im Alteractal zu töten.|nTötet einen Orc und bringt seinen Zahn zurück zu Korporal Noreg Sturmlanze in Dun Baldar.‡알터랙 계곡에 있는 호드 진영의 오크 플레이어를 쓰러뜨리라는 임무를 받았습니다.|n오크를 처치하고 던 발다르에 있는 하사관 노레그 스톰파이크에게 오크 엄니를 가져가야 합니다.‡Se te asignado la tarea de matar a los jugadores orcos en el Valle de Alterac.|nMata a un orco y llévale un colmillo de la víctima al cabo Noreg Pico Tormenta en Dun Baldar.‡Se te asignado la tarea de matar a los jugadores orcos en el Valle de Alterac.|nMata a un orco y llévale un colmillo de la víctima al cabo Noreg Pico Tormenta en Dun Baldar.‡Vous avez été chargé de tuer les personnages orcs présents dans la Vallée d’Alterac.|nTuez un orc et remettez les Dents d’orc au caporal Noreg Foudrepique à Dun Baldar.‡你被指派去杀死奥特兰克山谷中的兽人玩家。|n杀掉一个兽人，然后把兽人的獠牙交给丹巴达尔的诺雷格·雷矛中尉。‡妳被指派去殺死奧特蘭克山谷中的獸人玩家。|n殺掉壹個獸人，然後把獸人的獠牙交給丹巴達爾的諾雷格·雷矛中尉。',
  }
},
