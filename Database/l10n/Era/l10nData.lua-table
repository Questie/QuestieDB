  nil,
  { -- Quest
    'A família Carevino‡Семья Карвин‡Die Familie Carevin‡카레빈 일가‡La familia Carevin‡La familia Carevin‡La famille Carevin‡卡尔文家族‡卡爾文家族',
    nil,
    'Fale com João Carevino na Vila Sombria.‡Поговорите с Джонатаном Карвином в Темнолесье.‡Sprecht mit Jonathan Carevin in Dunkelhain.‡다크샤이어에 있는 조나단 카레빈과 대화해야 합니다.‡Habla con Jonathan Carevin en Villa Oscura.‡Habla con Jonathan Carevin en Villa Oscura.‡Aller voir Jonathan Carevin à Darkshire.‡去和夜色镇的乔纳森·卡尔文谈谈。‡去和夜色鎮的喬納森·卡爾文談談。',
  }
},
[1043] = {
  nil,
  { -- Npc
    'Dragonete Perdido‡Потерянный дракончик‡Verirrter Welpe‡길잃은 새끼용‡Cría perdida‡Cría perdida‡Dragonnet égaré‡迷路的雏龙‡迷路的幼龍',
    nil,
  },
  nil,
  { -- Quest
    'A foice de Eluna‡Коса Элуны‡Die Sense von Elune‡엘룬의 낫‡La Guadaña de Elune‡La Guadaña de Elune‡La Faux d\'Elune‡月神的镰刀‡月神的鐮刀',
    nil,
    'Procure sinais da Foice de Eluna, e depois fale novamente com João Carevino na Vila Sombria.‡Отыщите признаки местонахождения Косы Элуны и вернитесь к Джонатану Карвину в Темнолесье.‡Sucht nach Hinweisen auf die Sense von Elune und kehrt dann zu Jonathan Carevin in Dunkelhain zurück.‡엘룬의 낫의 흔적을 찾은 다음 다크샤이어에 있는 조나단 카레빈에게 돌아가야 합니다.‡Busca signos de la Guadaña de Elune y regresa a Villa Oscura, con Jonathan Carevin.‡Busca signos de la Guadaña de Elune y regresa a Villa Oscura, con Jonathan Carevin.‡Chercher les signes de la Faux d\'Elune puis retourner voir Jonathan Carevin à Darkshire.‡去找关于月神镰刀的消息，然后回到夜色镇见乔纳森·卡尔文。‡去找關於月神鐮刀的消息，然後回到夜色鎮見喬納森·卡爾文。',
  }
},
[1044] = {
  nil,
  { -- Npc
    'Dragonete Espirrafogo‡Огнедышащий дракончик‡Flammenschnaubender Welpe‡불뿜는 새끼용‡Cría escupefuego‡Cría escupefuego‡Dragonnet crache-flammes‡喷火雏龙‡噴火幼龍',
    nil,
  },
  nil,
  { -- Quest
    'Perguntas esclarecidas‡Полученные ответы‡Beantwortete Fragen‡해결된 의문‡La respuesta a las preguntas‡La respuesta a las preguntas‡Réponses aux questions‡回复珊蒂斯‡回復珊蒂斯',
    nil,
    'Fale novamente com Thyn\'tel Tecelâmina em Darnassus.‡Вернитесь к Тин\'тель Танцу Клинка в Дарнасс.‡Kehrt nach Darnassus zu Thyn\'tel Bladeweaver zurück.‡다르나서스에 있는 신텔 블레이드위버에게 돌아가야 합니다.‡Regresa a Darnassus y habla con Thyn\'tel Tejespada.‡Regresa a Darnassus y habla con Thyn\'tel Tejespada.‡Retourner vers Thyn\'tel Bladeweaver à Darnassus.‡回到达纳苏斯去见珊蒂斯·羽月。‡回到達納蘇斯去見珊蒂斯·羽月。',
  }
},
[1045] = {
  nil,
  { -- Npc
    'Dragomorfo Vermelho‡Красный драконид‡Rotdrachenbrut‡붉은용혈족‡Dragauro rojo‡Dragauro rojo‡Draconide rouge‡红色龙人‡紅色龍裔',
    nil,
  },
  nil,
  { -- Quest
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Mate Ran Dente Sangrento e 4 Guardas Dente Sangrento e fale novamente com Krolg perto do Lago Mistral.‡Убейте Рэна Кровавого Клыка, 4 кровозубых стражей и вернитесь к Кролгу у озера Мистраль.‡Tötet Ran Blutreißer sowie 4 Wachen von Blutreißer und kehrt dann zu Krolg in der Nähe des Mystralsees zurück.‡랜 블러드투스와 붉은송곳니 경비병 4명을 처치하고 미스트랄 호수 근처에 있는 크롤그에게 돌아가십시오.‡Mata a Ran Sangradientes y 4 guardias Sangradientes. Después regresa con Krolg cerca del Lago Mystral.‡Mata a Ran Sangradientes y 4 guardias Sangradientes y regresa con Krolg cerca del Lago Mystral.‡Tuer Ran Dent-rouge et 4 Gardes de Dent-rouge, puis retourner voir Krolg près du lac Mystral.‡杀死兰恩·血牙和4个血牙保镖，然后向密斯特拉湖附近的克罗格复命。‡殺死蘭恩·血牙和4個血牙保鏢，然後向密斯特拉湖附近的克羅格復命。',
  }
},
[1046] = {
  nil,
  { -- Npc
    'Draconoide Vermelho‡Красная драконида‡Roter Wyrmkin‡붉은고룡족‡Vermis rojo‡Vermis rojo‡Wyrmide rouge‡红色龙族‡紅色龍人',
    nil,
  },
  nil,
  { -- Quest
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Leve o Crânio de Ran Dente Sangrento e o Bastão de Transformação de Dartol para Raene Correlobos em Astranaar.‡Принесите череп Рэна Кровавого Клыка и жезл Преображения Дартола Раэне Волкопас в Астранаар.‡Bringt Raene Wolfrunner in Astranaar Ran Blutreißers Schädel und Dartols Rute der Transformation.‡아스트라나르에 있는 레이네 울프러너에게 랜 블러드투스의 해골과 다르톨의 변신마법봉을 가져가야 합니다.‡Llévale la calavera de Ran Dentesangre y la vara de la Transformación de Dartol a Raene Correlobo en Astranaar.‡Lleva calavera de Ran Sangradientes y la vara de transformación de Dartol a Raene Correlobo en Astranaar.‡Apporter le Crâne de Ran Dent-rouge et le Bâtonnet de transformation de Dartol à Raene Wolfrunner à Astranaar.‡把兰恩·血牙的颅骨和达图尔的变形魔棒交给阿斯特兰纳的莱恩·狼行者。‡把蘭恩·血牙的顱骨和達圖爾的變形魔棒交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1047] = {
  nil,
  { -- Npc
    'Escamorte Vermelha‡Красный чешуйчатый губитель‡Rote Bannschuppe‡붉은용혈족 맹독전사‡Horrocrusto rojo‡Horrocrusto rojo‡Plaiedécaille rouge‡红色刃鳞龙人‡紅色逆鱗龍人',
    nil,
  },
  nil,
  { -- Quest
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Обратитесь в дарнасский анклав Кенария к верховному друиду Фэндралу Оленьему Шлему по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Staghelm über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대한 얘기를 나눠야 합니다.‡Ve a Darnassus, al Enclave Cenarion y habla con el archidruida Fandral Corzocelada sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Fandral Staghelm, dans l\'Enclave cénarienne, à Darnassus. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納裏奧區的大德魯範達爾·鹿盔談壹談關於議會號召聯盟成員探索卡利姆多大陸的事情。',
  }
},
[1048] = {
  -- Item
  '‡‡‡서판: 번개 보호막 II‡‡‡‡‡石板:閃電之盾 II',
  { -- Npc
    'Tenente Escamorte‡Лейтенант чешуйчатых губителей‡Bannschuppenlieutenant‡비늘맹독혈족 부관‡Teniente Horrocrusto‡Teniente Horrocrusto‡Lieutenant Plaiedécaille‡刃鳞龙人副官‡逆鱗龍人副官',
    nil,
  },
  nil,
  { -- Quest
    'Adentrando o Monastério Escarlate‡В монастырь Алого ордена‡In das Scharlachrote Kloster‡붉은십자군 수도원으로‡En el Monasterio Escarlata‡En el Monasterio Escarlata‡Au monastère écarlate‡深入血色修道院‡深入血色修道院',
    nil,
    'Mate a Alta-inquisidora Cristalba, o Comandante Escarlate Mograine, Herodes, o Campeão Escarlate e o Mestre de Matilha Lobato, depois volte a falar com Varimatras na Cidade Baixa.‡Убейте Верховного инквизитора Вайтмейн, командира Могрейна из Алого ордена, воителя Герода из Алого ордена и псаря Локси. Затем возвращайтесь к Вариматрасу в Подгород.‡Tötet Hochinquisitor Whitemane, den Scharlachroten Kommandant Mograine, Herod, den Scharlachroten Helden sowie den Hundemeister Loksey und meldet Euch dann wieder bei Varimathras in Undercity.‡종교재판관 화이트메인, 붉은십자군 사령관 모그레인, 붉은십자군 용사 헤로드와 사냥개조련사 록시를 처치한 후 언더시티에 있는 바리마트라스에게 돌아가 보고해야 합니다.‡Mata a la alta inquisidora Melenablanca, al comandante Escarlata Mograine, a Herod el campeón Escarlata y al domador de jaurías Loksey, y después ve a ver de nuevo a Varimathras a Entrañas.‡Mata a la alta inquisidora Melenablanca, al comandante Escarlata Mograine, a Herod el Campeón Escarlata y al maestro de canes Loksey, y después ve a ver de nuevo a Varimathras a Entrañas.‡Tuer le grand inquisiteur Whitemane, le commandant Mograine de la Croisade, le champion Herod et le maître-chien Loksey, et retourner faire son rapport à Varimathras à Undercity.‡杀掉大检察官怀特迈恩、血色十字军指挥官莫格莱尼、血色十字军勇士赫洛德和驯犬者洛克希，然后向幽暗城的瓦里玛萨斯回报。‡殺掉大檢察官懷特邁恩、血色十字軍指揮官莫格萊尼、血色十字軍勇士赫洛德和馴犬者洛克希，然後向幽暗城的瓦裏瑪薩斯回報。',
  }
},
[1049] = {
  -- Item
  '‡‡‡서판: 정화‡‡‡‡‡石板:淨化術',
  { -- Npc
    'Draconoide Temerário‡Драконида Огненного Клейма‡Feuerbrandwyrmkin‡고룡족 선봉대원‡Verminte Pirotigma‡Verminte Pirotigma‡Wyrmide de braise‡烈焰龙族‡烈焰龍人',
    nil,
  },
  nil,
  { -- Quest
    'O Compêndio dos Caídos‡"Компендиум павших"‡Kompendium der Gefallenen‡타락의 개요‡El Compendio de los Caídos‡El Compendio de los Caídos‡Compendium des Déchus‡堕落者纲要‡墮落者綱要',
    nil,
    'Recupere o Compêndio dos Caídos no Monastério nas Clareiras de Tirisfal e volte a falar com o Sábio Devoto da Verdade no Penhasco do Trovão.‡Добудьте "Компендиум павших" из монастыря в Тирисфальских лесах и возвращайтесь к Ведуну Искателю Истины в Громовой Утес.‡Holt das \'Kompendium der Gefallenen\' aus dem Kloster in Tirisfal und bringt es zu Sage Truthseeker in Thunder Bluff.‡티리스팔 숲의 붉은십자군 수도원에서 타락의 개요를 찾아 썬더 블러프에 있는 현자 트루스시커에게 가져가야 합니다.‡Recupera el Compendio de los Caídos del Monasterio que se encuentra en los Claros de Tirisfal y regresa ante Sabio Buscaverdad, que está en Cima del Trueno.‡Recupera el Compendio de los Caídos del Monasterio que se encuentra en los Claros de Tirisfal y regresa ante Sabio Buscador de la Verdad, que está en Cima del Trueno.‡Trouver le « Compendium des Déchus » au Monastère dans les Clairières de Tirisfal et retourner voir le Sage Truthseeker à Thunder Bluff.‡从血色修道院里找到《堕落者纲要》，把它交给雷霆崖的圣者图希克。‡從血色修道院裏找到《墮落者綱要》，把它交給雷霆崖的聖者圖希克。',
  }
},
[1050] = {
  nil,
  { -- Npc
    'Guarda Real Escamorte‡Чешуйчатый королевский стражник‡Bannschuppenkönigswache‡비늘맹독혈족 근위병‡Guardia Real Horrocrusto‡Guardia Real Horrocrusto‡Garde royal Plaiedécaille‡刃鳞皇家卫士‡逆鱗皇家衛士',
    nil,
  },
  nil,
  { -- Quest
    'Mitologia dos Titãs‡"Мифология Титанов"‡Mythologie der Titanen‡티탄 신화‡Mitología de los Titanes‡Mitología de los titanes‡Mythologie des Titans‡泰坦神话‡泰坦神話',
    nil,
    'Recupere o livro Mitologia dos Titãs no Monastério e leve-o para a Bibliotecária Maé Palidopó em Altaforja.‡Добудьте "Мифологию Титанов" из монастыря и принесите ее библиотекарю Мае Белокожке в Стальгорн.‡Holt die \'Mythologie der Titanen\' aus dem Kloster und bringt die der Bibliothekarin Mae Paledust in Ironforge.‡수도원에서 티탄 신화라는 책을 찾아 아이언포지에 있는 사서 메이 페일더스트에게 가져가야 합니다.‡Coge Mitología de los Titanes en el monasterio y llévaselo a la bibliotecaria Mae Palipolvo a Forjaz.‡Coge Mitología de los titanes en el monasterio y llévaselo a la bibliotecaria Mae Palipolvo a Forjaz.‡Reprendre « la Mythologie des Titans » au Monastère et le rapporter au Bibliothécaire Mae Paledust à Ironforge.‡从修道院拿回《泰坦神话》，把它交给铁炉堡的图书馆员麦伊·苍尘。‡從修道院拿回《泰坦神話》，把它交給鐵爐堡的圖書館員麥伊·蒼塵。',
  }
},
[1051] = {
  nil,
  { -- Npc
    'Anão Ferro Negro‡Дворф из клана Черного Железа‡Dunkeleisenzwerg‡검은무쇠단 드워프‡Enano Hierro Negro‡Enano Hierro Negro‡Nain Sombrefer‡黑铁矮人‡黑鐵矮人',
    nil,
  },
  nil,
  { -- Quest
    'A vingança de Vorrel‡Месть Воррела‡Vorrels Rache‡보렐의 복수‡La venganza de Vorrel‡La venganza de Vorrel‡La vengeance de Vorrel‡沃瑞尔的复仇‡沃瑞爾的復仇',
    nil,
    'Leve a aliança de Vorrel Sentripaz para Mônica Sentripaz na Serraria Tarren.‡Верните обручальное кольцо Воррела Сенгутца Монике Сенгутц в Мельнице Таррен.‡Bringt Monika Sengutz in Tarrens Mühle den Ehering von Vorrel Sengutz.‡타렌 밀농장에 있는 모니카 센구츠에게 보렐의 결혼반지를 가져가야 합니다.‡Lleva la alianza de Vorrel Sengutz a Monika Sengutz de Molino Tarren.‡Lleva la alianza de Vorrel Sengutz a Monika Sengutz de Molino Tarren.‡Rapporter l\'anneau de mariage de Vorrel Sengutz à Monica Sengutz à Moulin-de-Tarren.‡把沃瑞尔·森加斯的结婚戒指还给塔伦米尔的莫尼卡·森古特斯。‡把沃瑞爾·森加斯的結婚戒指還給塔倫米爾的莫尼卡·森古特斯。',
  }
},
[1052] = {
  -- Item
  '‡‡‡서판: 정령 갑옷 II‡‡‡‡‡石板:幽魂甲 II',
  { -- Npc
    'Sabotador Ferro Negro‡Саботажник из клана Черного Железа‡Saboteur der Dunkeleisenzwerge‡검은무쇠단 투사‡Saboteador Hierro Negro‡Saboteador Hierro Negro‡Saboteur Sombrefer‡黑铁破坏者‡黑鐵破壞者',
    nil,
