[7562] = {
  nil,
  { -- Npc
    'Cobra Marrom‡Бурая змейка‡Braune Natter‡갈색나무뱀‡Víbora marrón‡Víbora marrón‡Serpent brun‡棕色蟒蛇‡棕色蟒蛇',
    nil,
  },
  nil,
  { -- Quest
    'Mor\'zul Trazangre‡Мор\'зул Кровопуск‡Mor\'zul Bloodbringer‡모르줄 블러드브링어‡Mor\'zul Sangredoble‡Mor\'zul Sangredoble‡Mor\'zul Bloodbringer‡莫苏尔·召血者‡莫蘇爾·召血者',
    nil,
    'Fale com Mor\'zul Trazangre nas Estepes Ardentes.‡Поговорите с Мор\'зулом Кровопуском в Пылающих степях.‡Sprecht mit Mor\'zul Bloodbringer in der brennenden Steppe.‡불타는 평원에 있는 모르줄 블러드브링어와 대화하십시오.‡Habla con Mor\'zul Sangredoble en las Estepas Ardientes.‡Habla con Mor\'zul Sangredoble en el Altar de la Tempestad en Las Estepas Ardientes.‡Parler à Mor\'zul Bloodbringer dans les Steppes ardentes.‡与燃烧平原的莫苏尔·召血者谈一谈。‡與燃燒平原的莫蘇爾·召血者談壹談。',
  }
},
[7563] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡藍鱗蛇',
    nil,
  },
  nil,
  { -- Quest
    'Raiva de Sangue‡Ярость крови‡Kochendes Blut‡피의 광란‡La ira de sangre‡La ira de sangre‡Rage de sang‡血之狂暴‡血之狂暴',
    nil,
    'Leve 30 garrafas de Sangue de Fera em Fúria para Mor\'zul Trazangre nas Estepes Ardentes.‡Принесите 30 бутылок крови яростных зверей Мор\'зулу Кровопуску в Пылающие степи.‡Mor\'zul Bloodbringer in der brennenden Steppe möchte, dass Ihr ihm 30 Flaschen mit dem Blut der tobenden Bestien bringt.‡불타는 평원에 있는 모르줄 블러드브링어에게 흉포한 올빼미야수의 피 30병을 가져가야 합니다.‡Llévale 30 botellas de sangre de bestia embravecida a Mor\'zul Sangredoble en Las Estepas Ardientes.‡Llévale 30 botellas de sangre de bestia embravecida a Mor\'zul Sangredoble en Las Estepas Ardientes.‡Apporter 30 bouteilles de Sang de bêtes enragées à Mor\'zul Bloodbringer dans les Steppes ardentes.‡把30瓶狂暴野兽的血交给燃烧平原的莫苏尔·召血者。‡把30瓶狂暴野獸的血交給燃燒平原的莫蘇爾·召血者。',
  }
},
[7564] = {
  nil,
  { -- Npc
    'Marin Nublacuca‡Синь Гогельмогель‡Marin Noggenfogger‡마린 노겐포저‡Marin Tragonublo‡Marin Tragonublo‡Marin Noggenfogger‡马林·诺格弗格‡馬林·諾格弗格',
    nil,
