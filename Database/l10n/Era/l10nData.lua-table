  nil,
  { -- Quest
    'Vilania das Profundezas‡Жестокость Черных Глубин‡Blackfathom-Schurkerei‡검은심연의 음모‡La vileza de Brazanegra‡La vileza de Brazanegra‡L\'infamie de Brassenoire‡黑暗深渊中的邪恶‡黑暗深淵中的邪惡',
    nil,
    'Leve a cabeça do Senhor do Crepúsculo Kelris para Bashana Runa Totem, no Penhasco do Trovão.‡Принесите голову Повелителя сумрака Келриса Башане Руническому Тотему в Громовой Утес.‡Bringt den Kopf des Twilight-Lords Kelris zu Bashana Runetotem in Thunder Bluff.‡황혼의 군주 켈리스를 처치하고 그 증거로 그의 머리카락을 썬더 블러프에 있는 바샤나 룬토템에게 가져가야 합니다.‡Llévale la cabeza del Señor Crepuscular Kelris a Bashana Runatótem en Cima del Trueno.‡Llévale la cabeza del señor crepuscular Kelris a Bashana Tótem de Runa en Cima del Trueno.‡Apporter la tête du Seigneur du crépuscule Kelris à Bashana Runetotem, à Thunder Bluff.‡把梦游者克尔里斯的头颅交给雷霆崖的巴珊娜·符文图腾。‡把夢遊者克爾裏斯的頭顱交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[6562] = {
  -- Item
  '‡Мерцающие сапоги‡Schimmernde Stiefel‡미명 장화‡Botas fulgurantes‡Botas fulgurantes‡Bottes chatoyantes‡幻光战靴‡幻光長靴',
  nil,
  nil,
  { -- Quest
    'Problemas nas Profundezas‡Угроза из Глубин‡Ärger in der Tiefe‡검은심연의 나락으로...‡Problemas en las profundidades‡Problemas en las profundidades‡Problèmes dans les profondeurs‡帮助耶努萨克雷‡幫助耶努薩克雷',
    nil,
    'Fale com Je\'neu Sancrea no Vale Gris.‡Поговорите с Дже\'неу Санкри в Ясеневом лесу.‡Sprecht in Ashenvale mit Je\'neu Sancrea.‡잿빛 골짜기에 있는 제네우 생크리와 대화하십시오.‡Habla con Je\'neu Sancrea en Vallefresno.‡Habla con Je\'neu Sancrea en Vallefresno.‡Parler à Je\'neu Sancrea, à Ashenvale.‡与灰谷的耶努萨克雷谈一谈。‡與灰谷的耶努薩克雷談壹談。',
  }
},
[6563] = {
  -- Item
  '‡Мерцающие наручи‡Schimmernde Armschienen‡미명 팔보호구‡Brazales fulgurantes‡Brazales fulgurantes‡Brassards chatoyants‡幻光护腕‡幻光護腕',
  nil,
  nil,
  { -- Quest
    'A essência de Aku\'mai‡Сущность Аку\'май‡Die Essenz von Aku\'mai‡아쿠마이의 정수‡La esencia de Aku\'Mai‡La esencia de Aku\'Mai‡L\'Essence d\'Aku\'Mai‡阿库麦尔水晶‡阿庫麥爾水晶',
    nil,
    'Entregue 20 Safiras de Aku\'Mai a Je\'neu Sancrea no Vale Gris.‡Принесите 20 сапфиров Аку\'май Дже\'неу Санкри в Ясеневый лес.‡Bringt 20 Saphire von Aku\'mai zu Je\'neu Sancrea nach Ashenvale.‡잿빛 골짜기에 있는 제네우 생크리에게 아쿠마이의 사파이어 20개를 가져가야 합니다.‡Llévale 20 zafiros de Aku\'Mai a Je\'neu Sancrea en Vallefresno.‡Llévale 20 zafiros de Aku\'Mai a Je\'neu Sancrea en Vallefresno.‡Apporter 20 Saphirs d\'Aku\'Mai à Je\'neu Sancrea, à Ashenvale.‡收集20颗阿库麦尔蓝宝石，把它们交给灰谷的耶努萨克雷。‡收集20顆阿庫麥爾藍寶石，把它們交給灰谷的耶努薩克雷。',
  }
},
[6564] = {
  -- Item
  '‡Сверкающий плащ‡Schimmernder Umhang‡미명 망토‡Capa fulgurante‡Capa fulgurante‡Cape chatoyante‡幻光披风‡幻光披風',
  nil,
  nil,
  { -- Quest
    'Lealdade aos Deuses Antigos‡Верность Древним богам‡Treue zu den Alten Göttern‡고대 신들에 대한 충성‡Lealtad a los dioses antiguos‡Lealtad a los dioses antiguos‡Allégeance aux Dieux très anciens‡上古之神的仆从‡上古之神的仆從',
    nil,
    'Leve o Bilhete Úmido para Je\'neu Sancrea, no Vale Gris.‡Принесите отсыревшую записку Дже\'неу Санкри в Ясеневый лес.‡Bringt die durchfeuchtete Notiz zu Je\'neu Sancrea nach Ashenvale.‡축축한 메모를 잿빛 골짜기의 제네우 생크리에게 가져가십시오.‡Llévale la nota humedecida a Je\'neu Sancrea en Vallefresno.‡Llévale la nota mojada a Je\'neu Sancrea en Vallefresno.‡Apporter la Note humide à Je\'neu Sancrea, à Ashenvale.‡把潮湿的便笺交给灰谷的耶努萨克雷。‡把潮濕的便箋交給灰谷的耶努薩克雷。',
  }
},
[6565] = {
  -- Item
  '‡Мерцающие перчатки‡Schimmernde Handschuhe‡미명 장갑‡Guantes fulgurantes‡Guantes fulgurantes‡Gants chatoyants‡幻光手套‡幻光手套',
  nil,
  nil,
  { -- Quest
    'Lealdade aos Deuses Antigos‡Верность Древним богам‡Treue zu den Alten Göttern‡고대 신들에 대한 충성‡Lealtad a los dioses antiguos‡Lealtad a los dioses antiguos‡Allégeance aux Dieux très anciens‡上古之神的仆从‡上古之神的仆從',
    nil,
    'Mate Lorgus Jett nas Profundezas Negras e depois fale novamente com Je\'neu Sancrea no Vale Gris.‡Убейте Лоргуса Джетта в Непроглядной Пучине и вернитесь к Дже\'неу Санкри в Ясеневый лес.‡Tötet Lorgus Jett in der Blackfathom-Tiefe und kehrt dann zu Je\'neu Sancrea nach Ashenvale zurück.‡검은심연의 나락에 있는 로구스 제트를 처치한 후 잿빛 골짜기의 제네우 생크리에게 돌아가십시오.‡Mata a Lorgus Jett en las Cavernas de Brazanegra y vuelve junto a Je\'neu Sancrea en Vallefresno.‡Mata a Lorgus Jett en las Cavernas de Brazanegra y vuelve con Je\'neu Sancrea en Vallefresno.‡Tuer Lorgus Jett, dans les Profondeurs de Brassenoire et retourner voir Je\'neu Sancrea, à Ashenvale.‡杀掉黑暗深渊里的洛古斯·杰特，然后向灰谷的耶努萨克雷复命。‡殺掉黑暗深淵裏的洛古斯·傑特，然後向灰谷的耶努薩克雷復命。',
  }
},
[6566] = {
  -- Item
  '‡Мерцающий нарамник‡Schimmernde Amicia‡미명 아미스‡Amito fulgurante‡Amito fulgurante‡Amict chatoyant‡幻光披肩‡幻光襯肩',
  { -- Npc
    'Estela Galina‡Эстелла Джендри‡Estelle Gendry‡에스텔 젠드리‡Estelle Gendry‡Estelle Gendry‡Estelle Gendry‡艾斯特蕾·根德瑞‡艾斯特蕾·根德瑞',
    nil,
  },
  nil,
  { -- Quest
    'O que o vento carrega‡Что принес ветер‡Was der Wind erzählt‡바람이 전해 온 소식‡Lo que trae el viento‡Lo que trae el viento‡Ce que le vent apporte‡风吹来的消息‡風吹來的消息',
    nil,
    'Ouça Thrall.‡Выслушайте Тралла.‡Hört Thrall zu.‡스랄의 이야기를 들어야 합니다.‡Escucha a Thrall.‡Escucha a Thrall.‡Écouter Thrall.‡听萨尔讲话。‡聽薩爾講話。',
  }
},
[6567] = {
  -- Item
  '‡Мерцающая броня‡Schimmernde Rüstung‡미명 갑옷‡Armadura fulgurante‡Armadura fulgurante‡Armure chatoyante‡幻光护甲‡幻光護甲',
  { -- Npc
    'Ghok\'kah‡Гхок\'ка‡Ghok\'kah‡그호카‡Ghok\'kah‡Ghok\'kah‡Ghok\'kah‡格鲁克卡恩‡格魯克卡恩',
    'Suprimentos de Alfaiataria‡Товары для портных‡Schneiderbedarf‡재봉용품 상인‡Suministros de sastrería‡Suministros de sastrería‡Fournitures de tailleur‡裁缝供应商‡裁縫供應商',
  },
  nil,
  { -- Quest
    'O campeão da Horda‡Защитник Орды‡Der Champion der Horde‡호드의 용사‡El Campeón de la Horda‡El Campeón de la Horda‡Le Champion de la Horde‡部落的勇士‡部落的勇士',
    nil,
    'Procure Rexxar. O Chefe Guerreiro <o/a> instruiu quanto ao paradeiro dele. Procure nos caminhos de Desolação, entre a Cordilheira das Torres de Pedra e Feralas.‡Найдите Рексара. Вождь сказал, что он бродит в Пустошах, по дороге, что ведет из Когтичтых гор в Фералас.‡Sucht Rexxar auf. Der Kriegshäuptling hat Euch erklärt, wo Ihr ihn finden könnt. Sucht die Wege von Desolace zwischen dem Steinkrallengebirge und Feralas ab.‡렉사르를 찾아야 합니다. 그의 행방은 대족장이 설명해 주었습니다. 돌발톱 산맥과 페랄라스 사이에 있는 잊혀진 땅의 길에서 찾아 보십시오.‡Busca a Rexxar. El jefe de guerra te ha indicado dónde encontrarlo. Recorre los caminos de Desolace, entre la Sierra Espolón y Feralas.‡Busca a Rexxar. El jefe de guerra te ha indicado dónde encontrarlo. Recorre los caminos de Desolace, entre la Sierra Espolón y Feralas.‡Chercher Rexxar. Le Chef de guerre vous a dit où il était. Chercher sur les chemins de Désolace, entre les Serres-Rocheuses et Feralas.‡按照酋长的指示找到雷克萨。他在石爪山和菲拉斯之间的凄凉之地游荡。‡按照酋長的指示找到雷克薩。他在石爪山和菲拉斯之間的淒涼之地遊蕩。',
  }
},
[6568] = {
  -- Item
  '‡Мерцающие брюки‡Schimmernde Beinkleider‡미명 바지‡Calzas fulgurantes‡Calzas fulgurantes‡Chausses chatoyantes‡幻光短裤‡幻光長褲',
  { -- Npc
    'Linhagulha‡Визглик‡Vizzklick‡비즈클릭‡Vizzklick‡Vizzklick‡Vizzklick‡维兹格里克‡維茲格里克',
    'Suprimentos de Alfaiataria‡Товары для портных‡Schneiderbedarf‡재봉용품 상인‡Suministros de sastrería‡Suministros de sastrería‡Fournitures de tailleur‡裁缝供应商‡裁縫供應商',
  },
  nil,
  { -- Quest
    'O testamento de Rexxar‡Завет Рексара‡Nachricht von Rexxar‡렉사르의 유언‡El testamento de Rexxar‡El testimonio de Rexxar‡Le testament de Rexxar‡雷克萨的证明‡雷克薩的證明',
    nil,
    'Leve o Testamento de Rexxar para Myranda, a Bruxa Velha, nas Terras Pestilentas Ocidentais.‡Доставьте письмо Рексара Миранде Колдунье в Западные Чумные земли.‡Überbringt Myranda der Vettel in den westlichen Pestländern Rexxars Nachricht.‡서부 역병지대에 있는 노파 미란다에게 렉사르의 유서를 전달해야 합니다.‡Entrega el testamento de Rexxar a Myranda la Fada. Está en las Tierras de la Peste del Oeste.‡Entrégale el testimonio de Rexxar a Myranda la Fada en las Tierras de la Peste del Oeste.‡Apporter le Testament de Rexxar à Myranda la Mégère, dans les Maleterres de l’ouest.‡把雷克萨的证明交给西瘟疫之地的巫女麦兰达。‡把雷克薩的證明交給西瘟疫之地的巫女麥蘭達。',
  }
},
[6569] = {
  -- Item
  '‡Мерцающее одеяние‡Schimmernde Robe‡미명 로브‡Toga fulgurante‡Toga fulgurante‡Robe chatoyante‡幻光长袍‡幻光長袍',
  { -- Npc
    'Gnoarn‡Гноарн‡Gnoarn‡노아른‡Gnoarn‡Gnoarn‡Gnoarn‡诺恩‡諾恩',
    nil,
  },
  nil,
  { -- Quest
    'Ilusões ópticas‡Иллюзии Ока‡Oculus-Illusionen‡눈동자의 환영‡Ilusiones oculares‡Ilusiones oculares‡Illusions d\'Occulus‡黑龙幻象‡黑龍幻象',
    nil,
    'Vá para o Pico da Rocha Negra e colete 20 Olhos de Dragomorfo Preto. Fale novamente com Myranda, a Bruxa Velha, depois que tiver terminado a tarefa.‡Отправляйтесь на пик Черной горы и добудьте 20 глаз черных драконидов. По выполнении задания вернитесь к Миранде Колдунье.‡Reist zur Blackrockspitze und sammelt 20 schwarze Drachenbrutaugen. Kehrt zu Myranda der Vettel zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 첨탑으로 가서 검은 용혈족의 눈동자 20개를 모아서 노파 미란다에게 돌아가야 합니다.‡Viaja a la Cumbre de Roca Negra y recoge 20 ojos de dragauro negro. Cuando hayas terminado tu tarea regresa con Myranda la Fada.‡Viaja a la Cumbre de Roca Negra y recoge 20 ojos de dragauro negro. Cuando hayas terminado tu tarea regresa con Myranda la Fada.‡Aller au Pic Blackrock et collecter 20 Yeux de draconide noir. Retourner voir Myranda la Mégère, quand la tâche sera terminée.‡到黑石塔去收集20颗黑色龙人的眼球，完成任务之后回到巫女麦兰达那里。‡到黑石塔去收集20顆黑色龍人的眼球，完成任務之後回到巫女麥蘭達那裏。',
  }
},
[6570] = {
  -- Item
  '‡Мерцающий кушак‡Schimmernde Schärpe‡미명 장식띠‡Fajín fulgurante‡Fajín fulgurante‡Echarpe chatoyante‡幻光腰带‡幻光束帶',
  { -- Npc
    'Fernão Thatros‡Фенвик Татрос‡Fenwick Thatros‡펜윅 타트로스‡Fenwick Thatros‡Fenwick Thatros‡Fenwick Thatros‡芬维克·萨托斯‡芬維克·薩托斯',
    nil,
  },
  nil,
  { -- Quest
    'Ardeluta‡Огнебор‡Aschenschwinge‡엠버스트라이프‡Brasaliza‡Brasaliza‡Brandeguerre‡埃博斯塔夫‡埃博斯塔夫',
    nil,
    'Vá até o Pântano da Serpe, no Pântano Vadeoso, e procure o Covil de Ardeluta. Quando estiver lá, use o Amuleto de Subversão Dracônica e fale com Ardeluta.‡Отправляйтесь в Драконьи топи в Пылевых топях и найдите Логово Огнебора. Оказавшись внутри, наденьте амулет Обмана драконов и поговорите с Огнебором.‡Reist zum Drachensumpf in den Marschen von Dustwallow und begebt Euch in Aschenschwinges Bau. Sobald Ihr darin seid, tragt das Amulett der drachischen Subversion und sprecht mit Aschenschwinge.‡먼지진흙 습지대에 있는 용의 둥지로 가서 엠버스트라이프의 굴을 찾아야 합니다. 안으로 들어가서 용족 파멸의 아뮬렛을 착용하고 엠버스트라이프와 대화해야 합니다.‡Viaja a la Ciénaga de Fuego del Marjal Revolcafango y busca El Cubil de Brasaliza. Cuando estés dentro ponte el Amuleto de Subversión Dracónica y habla con Brasaliza.|n‡Viaja a la Ciénaga de Fuego del Marjal Revolcafango y busca El Cubil de Brasaliza. Cuando estés dentro ponte el Amuleto de Subversión Dracónica y habla con Brasaliza.‡Aller à la tourbière du Ver, dans le marécage d\'Âprefange, et chercher la tanière de Brandeguerre. Une fois à l’intérieur, porter l’Amulette de subversion draconique, et parler à Brandeguerre.‡到尘泥沼泽中的巨龙沼泽去，找到埃博斯塔夫的洞穴。进入洞穴之后戴上龙形护符，然后跟埃博斯塔夫交谈。‡到塵泥沼澤中的巨龍沼澤去，找到埃博斯塔夫的洞穴。進入洞穴之後戴上龍形護符，然後跟埃博斯塔夫交談。',
  }
},
[6571] = {
  -- Item
  '‡Кулачный щит лазутчика‡Späherrundschild‡정찰용 버클러‡Rodela de exploración‡Rodela de exploración‡Targe de l\'éclaireur‡斥候圆盾‡斥候圓盾',
  { -- Npc
    'Forma de Felino (Druida Elfo Noturno)‡Облик кошки (ночной эльф-друид)‡Katzengestalt (Nachtelfendruide)‡표범 (나이트 엘프 드루이드)‡Forma felina (elfo de la noche druida)‡Forma felina (elfo de la noche druida)‡Forme de félin (druide elfe de la nuit)‡Cat Form (Night Elf Druid)‡獵豹形態 (夜精靈德魯伊)',
    '‡Ночной эльф-друид‡Nachtelfischer Druide‡나이트 엘프 드루이드‡Elfo de la noche druida‡Elfo de la noche druida‡Druide elfe de la nuit‡暗夜精灵德鲁伊‡夜精靈德魯伊',
  },
  nil,
  { -- Quest
    'Suprimentos do Brado Guerreiro‡Поставка для Песни Войны‡Warsongnachschub‡전쟁노래부족 보급품‡Suministros Grito de Guerra‡Suministros Grito de Guerra‡Fournitures Warsong‡战歌氏族的补给品‡戰歌氏族的補給品',
    nil,
    'Colete os seguintes Suprimentos do Brado Guerreiro: Lâminas Serrilhadas dos Brado Guerreiro, Corda para Transportar Toras, Óleo dos Brado Guerreiro e Carregamento de Machados dos Brado Guerreiro para Locke Okarr no Posto Machadada.‡Соберите полностью поставку Песни Войны: лезвия для пил, веревку для бревен, масло и партию топоров Песни Войны для Локе Окарра на заставе Расщепленного Древа.‡Tragt den Warsongnachschub zusammen: Warsongsägeblätter, Holzfäller-Seil, Warsongöl und die Warsongaxtlieferung für Locke Okarr im Splintertreeposten.‡토막나무 주둔지의 록케 오카르를 위해 전쟁노래부족 보급품을 모아 오십시오. 전쟁노래부족 톱날, 전쟁노래부족 도끼 상자, 전쟁노래부족 기름, 그리고 벌목용 밧줄을 가져와야 합니다.‡Reúne los suministros Grito de Guerra: las hojas de sierra Grito de Guerra, cabo de troncos, aceite de los Grito de Guerra y el envío de hachas de los Grito de Guerra para Locke Okarr en el Puesto del Hachazo.‡Reúne los suministros Grito de Guerra: las espadas dentadas Grito de Guerra, cuerda, aceite Grito de Guerra y el envío de hachas de los Grito de Guerra para Locke Okarr en el Puesto del Hachazo.‡Collecter les Fournitures Warsong : Lames du clan Warsong, Huile Warsong, et la Cargaison de Haches Warsong ayant pour destinataire Locke Okarr, au Poste de Bois-brisé.‡收集战歌氏族的补给品：战歌锯条、伐木绳、战歌之油，还有一箱战歌之斧。‡收集戰歌氏族的補給品：戰歌鋸條、伐木繩、戰歌之油，還有壹箱戰歌之斧。',
  }
},
[6572] = {
  -- Item
  '‡Щит поборника‡Verteidigungsstarker Schild‡수호자 방패‡Escudo defensor‡Escudo defensor‡Bouclier de défenseur‡防御者之盾‡防衛者之盾',
  { -- Npc
    'Forma de Felino (Druida Tauren)‡Облик кошки (таурен-друид)‡Katzengestalt (Taurendruide)‡표범 (타우렌 드루이드)‡Forma felina (tauren druida)‡Forma felina (tauren druida)‡Forme de félin (druide tauren)‡Cat Form (Tauren Druid)‡獵豹形態 (牛頭人德魯伊)',
    '‡Таурен-друид‡Taurischer Druide‡타우렌 드루이드‡Tauren druida‡Tauren druida‡Druide tauren‡牛头人德鲁伊‡牛頭人德魯伊',
