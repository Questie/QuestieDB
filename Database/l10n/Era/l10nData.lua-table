[647] = {
  -- Item
  '‡Судьба‡Schicksal‡명운검‡Destino‡Destino‡Destinée‡命运‡命運',
  { -- Npc
    'Capitão Peleverde‡Капитан Зеленямс‡Captain Greenskin‡선장 그린스킨‡Capitán Verdetez‡Capitán Verdetez‡Capitaine Vertepeau‡绿皮队长‡綠皮隊長',
