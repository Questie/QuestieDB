[4501] = {
  nil,
  { -- Npc
    'Draz\'Zilb‡Драз\'Зилб‡Draz\'Zilb‡드라즈질브‡Draz\'Zilb‡Draz\'Zilb‡Draz\'Zilb‡德拉兹辛比‡德拉茲辛比',
    nil,
  },
  nil,
  { -- Quest
    'Cuidado com os pterrordaxes‡Осторожно, злой жутедактиль‡Vorsicht, Pterrordax!‡테러닥스 주의‡Cuidado con los pterrordáctilos‡Cuidado con los pterrordáctilos‡Attention aux pterreurdactyles‡当心翼手龙‡當心翼手龍',
    nil,
    'Mate 10 Pterrordaxes e 15 Pterrordaxes Frenéticos, então fale com Espraga Froque no Refúgio do Marshal.‡Убейте 10 жутедактилей и 15 бесноватых жутедактилей, затем поговорите со Мучей Кусора в Укрытии Маршалла.‡Tötet 10 Pterrordax und 15 rasende Pterrordax und sprecht dann mit Spraggle Frock in Marshals Zuflucht.‡테러닥스 10마리와 광포한 테러닥스 15마리를 처치한 후 마샬의 야영지에 있는 스프래글 프록과 대화해야 합니다.‡Mata a 10 Pterrordáctilos y a 15 Pterrordáctilos dementes. Cuando lo hayas hecho habla con Spraggle Habitus en el Refugio de Marshal.‡Mata a 10 pterrordáctilos y 15 pterrordáctilos demenciados, y habla con Spraggle Frock en Refugio de Marshal.‡Tuer 10 Pterreurdactyles et 15 Pterreurdactyles frénétiques, puis parler à Spraggle Frock, au refuge des Marshal.‡杀掉10只翼手龙和15只狂怒的翼手龙，然后向马绍尔营地的斯普拉格·弗劳克报告。‡殺掉10只翼手龍和15只狂怒的翼手龍，然後向馬紹爾營地的斯普拉格·弗勞克報告。',
  }
},
[4502] = {
  -- Item
  'Amostra de Gema Élfica‡Образец эльфийского самоцвета‡Elfen-Edelsteinmuster‡엘프의 보석 표본‡Muestra de gema élfica‡Muestra de gema élfica‡Echantillon de gemme elfique‡精灵宝石样本‡精靈寶石樣本',
  { -- Npc
    'Tharg‡Тхарг‡Tharg‡타르그‡Tharg‡Tharg‡Tharg‡萨尔格‡薩爾格',
    nil,
  },
  nil,
  { -- Quest
    'Atividade vulcânica‡Вулканическая активность‡Vulkanische Aktivität‡화산 활동‡Actividad volcánica‡Actividad volcánica‡Activité volcanique‡火山的活动‡火山的活動',
    nil,
    'Colete 9 amostras das Cinzas de Un\'Goro dos elementais de fogo ao redor do vulcão da Cratera Un\'Goro, e leve-as para Fanny Quito, em Vila Catraca.‡Добудьте 9 образцов пепла Ун\'Горо из элементалей огня, что водятся вокруг вулкана в Кратере Ун\'Горо, и доставьте их Лив Быстрочин в Кабестан.‡Sammelt 9 Proben Un\'Goro-Asche von den Feuerelementare am Vulkan im Un\'Goro Krater ein und bringt die Proben zu Liv Rizzlefix in Ratchet.‡운고로 분화구의 화산 주위에 있는 불의 정령에게서 운고로 재 견본 9개를 모아 톱니항에 있는 리브 리즐픽스에게 가져가야 합니다.‡Lleva 9 muestras de ceniza de los elementales de fuego del Cráter de Un\'Goro a Liv Rizzlefix a Trinquete.‡Lleva 9 muestras de ceniza de los elementales de fuego del Cráter de Un\'Goro a Liv Rizzlefix a Trinquete.‡Collecter 9 Echantillons de cendre Un\'Goro sur les Elémentaires de brûlure qui se trouvent autour du volcan, dans le Cratère d\'Un\'Goro, puis les apporter à Liv Rizzlefix, à Ratchet.‡到安戈洛环形山的火山中去，从那里的元素身上收集9份安戈洛灰烬，把它们交给棘齿城的莉芙·雷兹菲克斯。‡到安戈洛環形山的火山中去，從那裏的元素身上收集9份安戈洛灰燼，把它們交給棘齒城的莉芙·雷茲菲克斯。',
  }
},
[4503] = {
  -- Item
  'Presa de Cascasseca‡Клык тролля из клана Сухокожих‡Hauer der Witherbark‡마른나무껍질부족 어금니‡Colmillo Secacorteza‡Colmillo Secacorteza‡Défense de Witherbark‡枯木巨魔的獠牙‡枯木食人妖的獠牙',
  { -- Npc
    'Esmagabarro Pé-sujo‡Дробильщик Грязноног‡Mudcrush Durtfeet‡머드크러쉬 더트피트‡Fangolpe Piesucio‡Fangolpe Piesucio‡Pilebou Piessale‡马德克拉什‡碎泥·杜特非',
    nil,
  },
  nil,
  { -- Quest
    'O Chislo quer voar!‡Крылолет Шиззла‡Shizzles Flieger‡쉬즐의 비행선‡El aparato volador de Shizzle‡El aparato volador de Shizzle‡La machine volante de Shizzle‡希兹尔的的飞行器‡希茲爾的的飛行器',
    nil,
    'Colete 8 Escamas de Dimetrodonte Palmado e 8 Escamas de Pterrordax Palmado para Chislo no Refúgio do Marshal.‡Принесите 8 чешуй перепончатого деметродона 8 чешуй перепончатого жутедактиля Шиззлу в Укрытие Маршалла.‡Sammelt 8 eingesponnene Dimetrodon-Schuppen und 8 eingesponnene Pterrordax-Schuppen für Shizzle in Marshals Zuflucht.‡마샬의 야영지에 있는 쉬즐에게 갈퀴 달린 디메트로돈 비늘 8개와 갈퀴 달린 테러닥스 비늘 8개를 가져가야 합니다.‡Recoge 8 escamas membranosas de diemetradón y 8 escamas membranosas de Pterrordáctilo para Shizzle, en el Refugio de Marshal.‡Recoge 8 escamas de diemetradón palmeadas y 8 escamas de pterrordáctilo palmeadas para Shizzle, en el Refugio de Marshal.‡Apporter 8 Ecailles étoilées de dimeurtrodon et 8 Ecailles étoilées de pterreurdactyles à Shizzle, au refuge des Marshal.‡为马绍尔营地的希兹尔收集8块精细的双帆龙鳞片和8块精细的翼手龙鳞片。‡為馬紹爾營地的希茲爾收集8塊精細的雙帆龍鱗片和8塊精細的翼手龍鱗片。',
  }
},
[4504] = {
  -- Item
  '‡Плащ дворфийского стражника‡Zwergenwachenumhang‡드워프 경비병 망토‡Capa de guardia enano‡Capa de guardia enano‡Cape de garde nain‡矮人卫兵披风‡矮人衛兵披風',
  { -- Npc
    'Bocarragelo‡Ледочрев‡Frostrachen‡서리갈기 설인‡Faucehielo‡Faucehielo‡Gueule-glacée‡霜喉雪人‡霜喉雪人',
    nil,
  },
  nil,
  { -- Quest
    'Supergrudento‡Суперлипучка‡Superkleber‡초강력 접착제‡Superpegajoso‡Superpegajoso‡Ultra collant‡极度粘稠的沥青‡極度粘稠的瀝青',
    nil,
    'Colete 12 amostras de Piche Supergrudento para Tran\'rek em Geringontzan.‡Отнесите 12 образцов сверхлипкой смолы Тран\'реку в Прибамбасск.‡Sammelt 12 Proben superklebrigen Teer für Tran\'rek in Gadgetzan.‡매우 끈적거리는 타르 12개를 모아 가젯잔에 있는 트란렉에게 갖다 주어야 합니다.‡Reúne 12 muestras de alquitrán superpegajoso para Tran\'rek de Gadgetzan.‡Reúne 12 muestras de alquitrán muy pegajoso para Tran\'rek de Gadgetzan.‡Collecter 12 échantillons de Goudron ultra collant pour Tran\'rek, à Gadgetzan.‡帮加基森的特兰雷克收集12块极度粘稠的沥青。‡幫加基森的特蘭雷克收集12塊極度粘稠的瀝青。',
  }
},
[4505] = {
  -- Item
  '‡Трясинные брюки‡Sumpflandbeinkleider‡안개구름 바지‡Calzas Tierra pantanosa‡Calzas Tierra pantanosa‡Chausses des marécages‡沼泽长裤‡沼澤長褲',
  { -- Npc
    'Marujo Vela Sangrenta‡Матрос из шайки Кровавого Паруса‡Deckmatrose der Blutsegelbukaniere‡붉은해적단 갑판원‡Grumete Velasangre‡Grumete Velasangre‡Matelot de la Voile sanglante‡血帆桨手‡血帆槳手',
    nil,
  },
  nil,
  { -- Quest
    'Poço da Corrupção‡Источник порчи‡Brunnen der Verderbnis‡오염된 달샘‡El pozo de la corrupción‡Pozo de corrupción‡Puits de la corruption‡腐化之井‡腐化之井',
    nil,
    'Colete uma amostra de água corrompida do poço lunar dos Sátiros Flamejade e leve-a para Winna Perícon no Posto Peçonha.‡Принесите образец оскверненной воды из лунного колодца сатиров Нефритового Пламени Винне Хеззард на Заставу Отравленной Крови.‡Beschafft eine Probe verderbten Wassers vom Mondbrunnen der Jadefeuersatyrn und bringt sie zu Winna Hazzard am Blutgiftposten.‡비취불꽃의 사티로스가 지키는 달샘에서 오염된 물 견본을 채취하여 피멍울 초소에 있는 위나 해저드에게 가져가야 합니다.‡Recoge una muestra de agua corrupta de la Poza de la Luna de los sátiros Fuego de Jade y llévasela a Winna Hazzard al Puesto del Veneno.‡Recoge una muestra de agua corrupta de la Poza de la Luna de los sátiros Fuego de Jade y llévasela a Winna Riessgo al Puesto del Veneno.‡Collecter un échantillon d’eau corrompue dans le Puits de lune des satyres Jadefeu, puis le rapporter à Winna Hazzard, au Poste de la Vénéneuse.‡从碧火萨特的月亮井中收集一份被腐化的水的样本，把它交给血毒哨所的温娜·哈萨德。‡從碧火薩特的月亮井中收集壹份被腐化的水的樣本，把它交給血毒哨所的溫娜·哈薩德。',
  }
},
[4506] = {
  -- Item
  'Insígnia de Stromgarde‡Знак Стромгарда‡Abzeichen von Stromgarde‡스트롬가드 휘장‡Distintivo de Stromgarde‡Distintivo de Stromgarde‡Insigne de Stromgarde‡激流堡徽章‡激流堡徽章',
  { -- Npc
    'Grumete Vela Sangrenta‡Юнга из шайки Кровавого Паруса‡Deckhelfer der Blutsegelbukaniere‡붉은해적단 선원‡Bisoño Velasangre‡Bisoño Velasangre‡Mousse de la Voile sanglante‡血帆水兵‡血帆水兵',
    nil,
  },
  nil,
  { -- Quest
    'Dentes-de-sabre corrompidos‡Зараженные саблезубы‡Verderbte Säbler‡오염된 고양이‡Dientes de sable corruptos‡Sables corruptos‡Sabres corrompus‡被腐蚀的猫‡被腐蝕的貓',
    nil,
    'Leve o gatinho de Winna para o poço lunar corrompido, solte-o e depois o leve de volta para Winna.|nQuando retornar, clique no gato para deixá-lo com Winna.‡Отнесите котенка Винны к оскверненному лунному колодцу, выпустите его, затем снова принесите Винне.|nКак только вернетесь к Винне, щелкните мышкой по котенку, чтобы выпустить его.‡Bringt Winnas Kätzchen zum verderbten Mondbrunnen, lasst es dort frei und bringt es dann wieder zu Winna zurück.|nSobald Ihr wieder bei Winna seid, klickt auf die Katze, um sie Winna zu übergeben.‡위나의 고양이를 오염된 달샘으로 데려가서 풀어 준 다음 위나에게 다시 데려가야 합니다.|n위나에게로 데려간 후 클릭하면 위나에게 돌아갈 것입니다.‡Lleva el gatito de Winna a la poza de la luna corrupta, libéralo allí y luego llévaselo a Winna.|nCuando hayas vuelto con Winna, haz clic en el felino para dárselo.‡Lleva el gatito de Winna a la poza de la luna corrupta, libéralo y llévaselo de nuevo a Winna.|nHaz clic en el gato para liberarlo y devolvérselo a Winna cuando estés cerca de ella.‡Amener le chaton de Winna au Puits de lune corrompu, le relâcher, puis le rapporter à Winna.|nUne fois de retour auprès de Winna, cliquer sur le chat pour le lui rendre.‡把温娜的小猫带到堕落的月亮井旁边，把猫放出来，然后把它还给温娜。|n当你回到温娜那里之后，点击猫就可以将它还给温娜。‡把溫娜的小貓帶到墮落的月亮井旁邊，把貓放出來，然後把它還給溫娜。|n當妳回到溫娜那裏之後，點擊貓就可以將它還給溫娜。',
  }
},
[4507] = {
  -- Item
  '‡Щит воина бездны‡Grubenkämpferschild‡투사의 방패‡Escudo de luchador de fosa‡Escudo de luchador de fosa‡Bouclier du combattant des abîmes‡斗士之盾‡鬥士之盾',
  { -- Npc
    'Daisy‡Дейзи‡Daisy‡데이지‡Daisy‡Daisy‡Daisy‡黛西‡黛西',
    'Race Starter Girl‡Девушка с гоночным флагом‡Rennstartermädchen‡경주 도우미‡Chica que anuncia el inicio de una carrera‡Chica que anuncia el inicio de una carrera‡Fille au départ de la course‡赛车女郎‡賽車女郎',
  },
  nil,
  { -- Quest
    'O peão captura a rainha‡Пешка берет королеву‡Bauer schlägt Dame‡여왕의 뇌‡El señuelo atrapa a la reina‡El señuelo atrapa a la reina‡Le pion prend la reine‡捕捉皇后‡捕捉皇後',
    nil,
    'Derrote a Rainha da Colmeia Gorishi assim que ela for atraída.|nLeve o Cérebro da Rainha Gorishi para o Alquimista Almofarrista em Geringontzan.‡Призовите и сразите матку улья Гориши.|nПринесите мозг матки Гориши алхимику Пестычинсу в Прибамбасск.‡Besiegt die Schwarmkönigin der Gorishi, sobald sie erscheint.|nBringt das Gehirn der Schwarmkönigin zu Alchimist Pestlezugg nach Gadgetzan.‡여왕 고리쉬를 불러내 처치해야 합니다.|n가젯잔에 있는 연금술사 페슬저그에게 여왕 고리쉬 뇌를 가져가야 합니다.‡Derrota a la reina de la colmena Gorishi cuando hayas conseguido que salga al exterior.|nLlévale el cerebro de la reina Gorishi al alquimista Morterozugg de Gadgetzan.‡Derrota a la reina de la colmena Gorishi cuando hayas conseguido que salga al exterior.|nLlévale el cerebro de la reina Gorishi al alquimista Morterozugg de Gadgetzan.‡Invoquer la Reine gorishi et la vaincre.|nApporter le Cerveau de reine gorishi à l’alchimiste Pestlezugg, à Gadgetzan.‡召唤格里什皇后，然后击败她。|n把格里什皇后的大脑交给加基森的炼金师匹斯特苏格。‡召喚格裏什皇後，然後擊敗她。|n把格裏什皇後的大腦交給加基森的煉金師匹斯特蘇格。',
  }
},
[4508] = {
  -- Item
  '‡Броня кровавого оттенка‡Blutverschmierte Rüstung‡붉은 갑옷‡Armadura tintada de sangre‡Armadura tintada de sangre‡Armure souillée de sang‡血斑护甲‡血斑護甲',
  { -- Npc
    'Importador Willix‡Импортер Вилликс‡Willix der Importeur‡수입업자 윌릭스‡Willix el Importador‡Willix el Importador‡Willix l’Importateur‡进口商威利克斯‡進口商威利克斯',
    nil,
  },
  nil,
  { -- Quest
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡臨危不懼',
    nil,
    'Leve o Relatório de Un\'Goro do Almofarrista para Gracinha Forçânima em Darnassus.‡Отнесите отчет Пестычинса о ситуации в Ун\'Горо Грацине Силе Духа в Дарнасс.‡Bringt Pestlezuggs Un\'Goro-Bericht zu Gracina Spiritmight in Darnassus.‡다르나서스에 있는 그라시나 스피릿마이트에게 페슬저그의 운고로 보고서를 가져가야 합니다.‡Llévale el informe de Morterozugg de Un\'Goro a Gracina Poderespíritu, que está en Darnassus.‡Llévale el informe de Un\'Goro de Morterozugg a Gracina Poderespíritu, que está en Darnassus.‡Apporter le Rapport de Pestlezugg sur Un\'Goro à Gracina Spiritmight, à Darnassus.‡把匹斯特苏格的安戈洛报告交给达纳苏斯的格拉希娜·灵风。‡把匹斯特蘇格的安戈洛報告交給達納蘇斯的格拉希娜·靈風。',
  }
},
