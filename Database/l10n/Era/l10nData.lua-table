},
[136] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders Versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Encontre o baú do Capitão Albernaz e procure a próxima pista dentro dele.‡Найдите сундучок капитана Сандерса и поищите в нем следующую подсказку.‡Findet Käpt\'n Sanders Schließkiste und durchsucht sie, um den nächsten Hinweis zu erhalten.‡샌더 선장의 사물함에서 다음 단서를 찾아야 합니다.‡Encuentra el baúl del capitán Sanders y busca la siguiente pista.‡Encuentra el baúl del capitán Sanders y busca la siguiente pista.‡Trouver le Coffre du capitaine Sanders. Le fouiller pour trouver l\'indice suivant.‡找到杉德尔船长的手提箱，在箱子中寻找下一条线索。‡找到杉德爾船長的手提箱，在箱子中尋找下壹條線索。',
  }
},
[138] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Encontre o velho barril perto da chaminé em ruínas e procure a próxima pista dentro dele.‡Найдите старую бочку рядом с разрушенным очагом и поищите в ней следующий ключ.‡Findet das alte Fass in der Nähe des verfallenen Kamins und durchsucht es nach Eurem nächsten Hinweis.‡다음 단서를 얻기 위해 굴뚝 잔해 근처에서 낡은 통을 찾아야 합니다.‡Busca el viejo barril junto a la chimenea en ruinas y busca la siguiente pista.‡Busca el viejo barril junto a la chimenea en ruinas y busca la siguiente pista.‡Trouver le Tonneau à côté des cheminées en ruine. Le fouiller pour trouver l\'indice suivant.‡找到废弃烟囱旁的老木桶，在桶里寻找下一条线索。‡找到廢棄煙囪旁的老木桶，在桶裏尋找下壹條線索。',
  }
},
[139] = {
  -- Item
  '‡Штаны буяна‡Muskelprotzhose‡견습투사용 바지‡Pantalones de camorrista‡Pantalones de camorrista‡Pantalon de bagarreur‡打斗者短裤‡打鬥者便褲',
  nil,
  nil,
  { -- Quest
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders Versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Procure a próxima pista dentro do garrafão vazio perto do moinho de vento.‡Найдите следующую подсказку в пустом кувшине, найденном рядом с ветряной мельницей.‡Durchsucht den leeren Henkelkrug neben der Windmühle nach dem nächsten Hinweis.‡다음 단서를 찾기 위해 풍차 옆에 있는 빈 단지를 살펴봐야 합니다.‡Busca la jarra vacía junto al molino de viento para encontrar la siguiente pista.‡Busca la jarra vacía junto al molino de viento para encontrar la siguiente pista.‡Chercher la Cruche vide à côté du moulin à vent pour trouver le prochain indice.‡在风车旁的一个空水罐里寻找下一条线索。‡在風車旁的壹個空水罐裏尋找下壹條線索。',
  }
},
[140] = {
  -- Item
  '‡Сапоги буяна‡Muskelprotzstiefel‡견습투사용 장화‡Botas de camorrista‡Botas de camorrista‡Bottes de bagarreur‡打斗者之靴‡打鬥者的靴子',
  nil,
  nil,
  { -- Quest
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders Versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Encontre o baú do Capitão Albernaz e abra-o para receber sua recompensa.‡Установите местонахождение сундука капитана Сандерса и откройте его.‡Findet Käpt\'n Sanders Truhe und öffnet sie. Darin befindet sich Eure Belohnung.‡보물을 얻기 위해 샌더 선장의 보물 상자를 찾아 열어야 합니다.‡Localiza la arqueta del capitán Sanders y ábrela para obtener tu recompensa.‡Localiza la arqueta del capitán Sanders y ábrela para obtener tu recompensa.‡Localiser le Coffre au trésor du capitaine Sanders et prendre votre récompense.‡找到杉德尔船长的箱子并打开它，取得你的奖励。‡找到杉德爾船長的箱子並打開它，取得妳的獎勵。',
  }
},
[141] = {
  -- Item
  '‡‡‡OLDBrawler\'s Belt‡‡‡‡‡',
  nil,
  nil,
  { -- Quest
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Leve o Relatório do Shaw para Miguel Mantoforte no Cerro Oeste.‡Передайте документ, написанный Шоу, Гриану Камнегриву в Западный Край.‡Bringt Shaws Bericht nach Westfall zu Gryan Stoutmantle.‡서부 몰락지대의 그라이언 스타우트맨틀에게 쇼의 보고서를 가져가야 합니다.‡Lleva el informe de Shaw a Gryan Mantorrecio de los Páramos de Poniente.‡Lleva el informe de Shaw a Gryan Mantorrecio de los Páramos de Poniente.‡Apporter le Rapport de Shaw à Gryan Stoutmantle, dans la marche de l\'Ouest.‡将肖尔的报告交给西部荒野的格里安·斯托曼。‡將肖爾的報告交給西部荒野的格裏安·斯托曼。',
  }
},
[142] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Rastreie o Mensageiro Défias no Cerro Oeste e leve sua mensagem para Mantoforte.‡Выследите вестника из Братства Справедливости в Западном Крае и принесите отнятое у него сообщение Гриану Камнегриву.‡Spürt den Boten der Defias in Westfall auf und bringt die Nachricht, die er bei sich hat, zu Stoutmantle.‡서부 몰락지대에서 데피아즈단 전령을 추적하여 그가 전하려던 전갈을 스타우트맨틀에게 전해야 합니다.‡Localiza al mensajero Defias de los Páramos de Poniente y lleva su mensaje a Mantorrecio.‡Localiza al mensajero Defias de los Páramos de Poniente y lleva su mensaje a Mantorrecio.‡Traquer le Messager défias dans la marche de l\'Ouest et apporter les documents qu\'il transporte à Stoutmantle.‡追捕西部荒野的迪菲亚信使，并将他身上携带着的信件交给斯托曼。‡追捕西部荒野的迪菲亞信使，並將他身上攜帶著的信件交給斯托曼。',
  }
},
[143] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Mensagem para Cerro Oeste‡Гонец в Западный Край‡Botschaft nach Westfall‡서부 몰락지대로의 전갈‡Mensajero a Páramos de Poniente‡Mensajero a los Páramos de Poniente‡Un message pour la marche de l\'Ouest‡送往西部荒野的信‡送往西部荒野的信',
    nil,
    'O Magistrado Salomão quer que você leve a súplica dele a Miguel Mantoforte em Cerro Oeste.‡Отнесите просьбу о помощи Гриану Камнегриву в Западный Край.‡Magistrat Solomon möchte, dass Ihr sein Hilfegesuch nach Westfall zu Gryan Stoutmantle bringt.‡집정관 솔로몬이 서부 몰락지대에 있는 그라이언 스타우트맨틀에게 자신이 직접 작성한 탄원서를 전달해 달라고 부탁했습니다.‡El magistrado Solomon quiere que lleves su petición a Gryan Mantorrecio a Páramos de Poniente.‡El magistrado Solomon quiere que lleves su petición a Gryan Mantorrecio a los Páramos de Poniente.‡Le Magistrat Solomon veut que vous portiez sa Demande d\'aide à Gryan Stoutmantle dans la marche de l\'Ouest.‡所罗门镇长要求你给西部荒野的格里安·斯托曼送一封信。‡所羅門鎮長要求妳給西部荒野的格裏安·斯托曼送壹封信。',
  }
},
[144] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Mensagem para Cerro Oeste‡Гонец в Западный Край‡Botschaft nach Westfall‡서부 몰락지대로의 전갈‡Mensajero a Villa Oscura‡Mensajero a los Páramos de Poniente‡Un message pour la marche de l\'Ouest‡送往西部荒野的信‡送往西部荒野的信',
    nil,
    'Fale novamente com o Magistrado Salomão e relate a resposta de Miguel Mantoforte.‡Вернитесь к чиновнику Соломону с ответом Гриана Камнегрива.‡Kehrt mit Gryan Stoutmantles Antwort zu Magistrat Solomon zurück.‡그라이언 스타우트맨틀의 답장을 가지고 집정관 솔로몬에게 돌아가십시오.‡Lleva la respuesta de Gryan Mantorrecio al magistrado Solomon.‡Lleva la respuesta de Gryan Mantorrecio al magistrado Solomon.‡Retourner voir le Magistrat Solomon avec la Réponse de Stoutmantle.‡将格里安·斯托曼的回信带给所罗门镇长。‡將格裏安·斯托曼的回信帶給所羅門鎮長。',
  }
},
[145] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Mensagem para Vila Sombria‡Гонец в Темнолесье‡Botschaft nach Dunkelhain‡다크샤이어로의 전갈‡Mensajero a Villa Oscura‡Mensajero a Villa Oscura‡Un message pour Darkshire‡送往夜色镇的信‡送往夜色鎮的信',
    nil,
    'O Magistrado Salomão quer que você entregue uma carta ao senhor Ebanez na Vila Sombria.‡Отнесите письмо лорду Чернодреву в Темнолесье.‡Magistrat Solomon möchte, dass Ihr einen Brief zu Lord Ebonlocke nach Dunkelhain bringt.‡집정관 솔로몬이 다크샤이어에 있는 이본로크 경에게 탄원서를 전달해 달라고 부탁했습니다.‡El magistrado Solomon quiere que lleves una carta a Lord Ebonlocke a Villa Oscura.‡El magistrado Solomon quiere que lleves una carta a Lord Cerranegro a Villa Oscura.‡Le magistrat Solomon veut que vous apportiez une lettre au seigneur Ebonlocke de Darkshire.‡所罗门镇长要求你给夜色镇的艾尔罗·埃伯洛克公爵送一封信。‡所羅門鎮長要求妳給夜色鎮的艾爾羅·埃伯洛克公爵送壹封信。',
  }
},
[146] = {
  -- Item
  '‡‡‡OLDRugged Trapper\'s Belt‡‡‡‡‡',
  nil,
  nil,
  { -- Quest
    'Mensagem para Vila Sombria‡Гонец в Темнолесье‡Botschaft nach Dunkelhain‡다크샤이어로의 전갈‡Mensajero a Villa Oscura‡Mensajero a Villa Oscura‡Un message pour Darkshire‡送往夜色镇的信‡送往夜色鎮的信',
    nil,
    'Fale novamente com o Magistrado Salomão e relate a resposta do senhor Ebanez.‡Вернитесь к мировому судье Соломону с ответом лорда Элло Чернодрева.‡Kehrt mit Lord Ebonlockes Antwortschreiben zu Magistrat Solomon zurück.‡이본로크 경의 답장을 가지고 집정관 솔로몬에게 돌아가야 합니다.‡Lleva la respuesta de Lord Cerranegro al magistrado Solomon.‡Lleva la respuesta de Lord Cerranegro al magistrado Solomon.‡Retourner voir le Magistrat Solomon avec la Lettre en réponse du Seigneur Ebonlocke.‡将埃伯洛克公爵的回信带给所罗门镇长。‡將埃伯洛克公爵的回信帶給所羅門鎮長。',
  }
},
[147] = {
  -- Item
  '‡Рваные штаны зверолова‡Unverwüstliche Fallenstellerhose‡주름진 사냥꾼용 바지‡Pantalones de trampero bastos‡Pantalones de trampero bastos‡Pantalon robuste de trappeur‡皱褶捕兽者短裤‡粗厚捕獸者便褲',
  nil,
  nil,
  { -- Quest
    'Perseguição implacável‡Охота на человека‡Menschenjagd‡징세관 수사‡La persecución‡La persecución‡Chasse à l\'homme‡猎杀收货人‡獵殺收貨人',
    nil,
    'Encontre e mate "o Coletor". Depois, entregue o Anel do Coletor para o Delegado Durão.‡Найдите и убейте Вымогателя, а затем принесите его кольцо маршалу Дугхану.‡Findet den "Sammler" und tötet ihn, dann kehrt mit dem Ring des Sammlers zu Marshal Dughan zurück.‡징세관을 찾아서 처치한 다음 징세관의 반지를 가지고 치안대장 더그한에게 돌아가야 합니다.‡Encuentra y mata al Coleccionista y vuelve junto al alguacil Dughan con la sortija de coleccionista.‡Encuentra y mata al Coleccionista y vuelve junto al alguacil Dughan con el anillo del coleccionista.‡Trouver et tuer le "Collecteur" puis rapporter son Anneau au maréchal Dughan.‡找到“收货人”并将他杀掉，然后带着收货人的戒指回来见治安官杜汉。‡找到“收貨人”並將他殺掉，然後帶著收貨人的戒指回來見治安官杜漢。',
  }
},
[148] = {
  -- Item
  '‡Рваная рубашка зверолова‡Unverwüstliches Fallenstellerhemd‡주름진 사냥꾼용 셔츠‡Camisa de trampero basta‡Camisa de trampero basta‡Chemise robuste de trappeur‡皱褶捕兽者衬衣‡粗厚捕獸者襯衣',
  nil,
  nil,
  { -- Quest
    'Suprimentos da Vila Sombria‡Припасы из Темнолесья‡Lieferung aus Dunkelhain‡다크샤이어로부터의 보급품‡Suministros de Villa Oscura‡Suministros de Villa Oscura‡Fournitures en provenance de Darkshire‡来自夜色镇的货物‡來自夜色鎮的貨物',
    nil,
    'Fale com Madame Eva.‡Поговорите с мадам Евой.‡Sprecht mit Madame Eva.‡에바 부인과 대화해야 합니다.‡Habla con Lady Eva.‡Habla con Lady Eva.‡S’adresser à Madame Eva.‡去和伊瓦夫人谈一谈。‡去和伊瓦夫人談壹談。',
  }
},
[149] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Linha de Cabelo de Fantasma‡Прядь призрачных волос‡Geisterhaarfaden‡유령의 머리 가닥‡Hilo de pelo de fantasma‡Hilo de cabello de fantasma‡Mèche de cheveux fantômes‡幽灵的发丝‡幽靈的發絲',
    nil,
    'Leve o Pente Espectral para a Maria Cega.‡Отнесите Слепой Мэри призрачный гребень.‡Bringt der blinden Mary den spektralen Kamm.‡눈 먼 매리에게 유령의 빗을 가져가야 합니다.‡Lleva el peine espectral a Mary la Ciega.‡Lleva el peine espectral a Mary la Ciega.‡Apporter le Peigne spectral à Marie l\'Aveugle.‡把鬼梳带给盲眼玛丽。‡把鬼梳帶給盲眼瑪麗。',
  }
},
[150] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Caçadores de murlocs‡Мурлоки-браконьеры‡Murlocwilderer‡침입자 멀록‡Cazadores furtivos‡Cazadores furtivos‡Les braconniers murlocs‡鱼人偷猎者‡魚人偷獵者',
    nil,
    'Leve 8 Barbatanas de Murloc para o Mestre de Doca Baren em Vila Plácida.‡Принесите 8 плавников мурлоков портовому начальнику Барену в Приозерье.‡Bringt 8 Murlocflossen nach Seenhain zu Dockmeister Baren.‡레이크샤이어에 있는 항구주임 바렌에게 멀록 지느러미 8개를 가져가야 합니다.‡Lleva 8 ancas múrloc al maestro de embarcadero Baren a Villa del Lago.‡Lleva 8 aletas múrloc al maestro de embarcadero Baren a Villa del Lago.‡Apporter 8 Ailerons de murloc au Chef des docks Baren à Lakeshire‡给湖畔镇的码头管理员巴伦带回8片鱼人的鳍。‡給湖畔鎮的碼頭管理員巴倫帶回8片魚人的鰭。',
  }
},
[151] = {
  nil,
  { -- Npc
    'Brog Atolão‡Брог Мясорук‡Brog Hamfist‡브로그 햄피스트‡Brog Patosar‡Brog Patosar‡Brog Hamfist‡布洛葛·哈姆菲斯特‡布洛葛·哈姆菲斯特',
    'Suprimentos Sortidos‡Сто мелочей‡Gemischtwaren‡일용품 상인‡Suministros generales‡Suministros generales‡Fournitures générales‡杂货供应商‡雜貨供應商',
  },
  nil,
  { -- Quest
    'Pobre Velha Brancurinha‡Бедная старая Савраска‡Die arme Graumähne‡늙은말 블랑쉬‡La pobre y vieja Blanchy‡La pobre y vieja Blanchy‡Pauvre Vieille Blanchy !‡老马布兰契‡老馬布蘭契',
    nil,
    'Vera Taturana quer que você leve 8 Punhados de Aveia para ela em Cerro Oeste.‡Принесите 8 горстей овса Верне Хмуробров.‡Verna Furlbrow in Westfall möchte, dass Ihr ihr 8 Hände voll Hafer bringt.‡서부 몰락지대의 베르나 펄브로우가 귀리 한 줌 8개를 가져다 달라고 부탁했습니다.‡Verna Furlbrow de los Páramos de Poniente quiere que le lleves 8 puñados de avena.‡Verna Cejade de los Páramos de Poniente quiere que le lleves 8 puñados de avena.‡Verna Furlbrow de la marche de l\'Ouest veut que vous lui apportiez 8 Poignées d\'avoine.‡西部荒野的弗娜·法布隆要求你带给她8捧燕麦。‡西部荒野的弗娜·法布隆要求妳帶給她8捧燕麥。',
  }
},
[152] = {
  -- Item
  '‡‡‡OLDPrimitive Leather Belt‡‡‡‡‡',
  { -- Npc
    'Irmão Dânio‡Брат Даниль‡Bruder Danil‡수사 다닐‡Hermano Danil‡Hermano Danil‡Frère Danil‡丹尼尔修士‡丹尼爾修士',
    'Suprimentos Sortidos‡Сто мелочей‡Gemischtwaren‡일용품 상인‡Suministros generales‡Suministros generales‡Fournitures générales‡杂货供应商‡雜貨供應商',
  },
  nil,
  { -- Quest
    'Há perigo na costa‡Зачистка побережья‡Ärger an der Küste‡남아 있는 위험‡Hay moros en la costa‡Hay moros en la costa‡La côte n\'est pas sûre‡清理海岸‡清理海岸',
    nil,
    'Mate 7 Caçamarés, 7 Guerreiros, 7 Oráculos e 7 Correcostas e fale novamente om o Capitão Calvino no Farol de Cerro Oeste.‡Убейте 7 волноловов, 7 воинов, 7 оракулов и 7 береговиков-мурлоков и вернитесь к капитану Грейсону на Маяк в Западном Крае.‡Tötet 7 Gezeitenjäger, 7 Krieger, 7 Orakel sowie 7 Küstenläufer und kehrt dann zu Captain Grayson beim Leuchtturm von Westfall zurück.‡멀록 바다사냥꾼 7마리, 멀록 전사 7마리, 멀록 점쟁이 7마리, 멀록 길잡이 7마리를 처치하고 서부 몰락지대 등대에 있는 그레이슨 선장에게 돌아가야 합니다.‡Mata 7 cazamareas, 7 guerreros, 7 oráculos y 7 correcostas y vuelve con el capitán Grisillo en el Faro de los Páramos de Poniente.‡Mata 7 cazamareas, 7 guerreros, 7 oráculos y 7 correcostas y vuelve con el capitán Grisillo en el Faro de Poniente.‡Tuer 7 Chasse-marées, 7 Guerriers, 7 Oracles et 7 Cours-la-côte, puis retourner voir le capitaine Grayson au Phare de l\'Ouest.‡杀死7只鱼人潮行者、7只鱼人战士、7只鱼人智者，还有7只鱼人滩行者，然后向西部荒野灯塔中的葛瑞森船长复命。‡殺死7只魚人潮行者、7只魚人戰士、7只魚人智者，還有7只魚人灘行者，然後向西部荒野燈塔中的葛瑞森船長復命。',
  }
},
[153] = {
  -- Item
  '‡Примитивный килт‡Primitiver Kilt‡구식 킬트‡Falda primitiva‡Falda primitiva‡Kilt primitif‡粗糙的褶裙‡粗糙的褶裙',
