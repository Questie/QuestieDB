[8897] = {
  -- Item
  '‡‡‡마법서: 화염계 수호 V‡‡‡‡‡秘典:防護火焰結界 V',
  { -- Npc
    'Artesão da Forja da Perdição‡Ремесленник из клана Кузни Рока‡Schicksalsträchtiger Handwerker‡파멸괴철로단 땜장이‡Artesano de la Forja Maldita‡Artesano de la Forja Maldita‡Artisan Forge-ruine‡厄炉工匠‡末日之爐工匠',
    nil,
  },
  nil,
  { -- Quest
    'Querida Colara‡Дорогая моя Колара‡Liebste Colara‡친애하는 콜라라‡Queridísima Colara:‡Queridísima Colara:‡Très chère Colara,‡亲爱的科兰拉‡親愛的科蘭拉',
    nil,
    'Entregue o Bilhete Cuidadosamente Escrito do Tenente Heldric para Colara Dean em frente ao banco de Ventobravo.‡Отнесите тщательно продуманную записку лейтенанта Хельдрика Коларе Дин, обитающей поблизости от банка в Штормграде.‡Bringt Lieutenant Heldrics sorgfältig verfasste Notiz zu Colara Dean außerhalb der Bank von Stormwind.‡부관 조크린 헬드릭의 정성들여 쓴 쪽지를 스톰윈드 은행 밖에 있는 콜라라 딘에게 전해줘야 합니다.‡Entrega la carta del general Heldric a Colara Dean, que está junto al banco de Ventormenta.‡Entrega la carta del general Heldric a Colara Dean, que está junto al banco de Ventormenta.‡Apporter la Note soigneusement calligraphiée du lieutenant Heldric à Colara Dean, devant la banque de Stormwind.‡将亨德瑞克中尉精心书写的信件交给暴风城银行外面的科兰拉·迪恩。‡將亨德瑞克中尉精心書寫的信件交給暴風城銀行外面的科蘭拉·迪恩。',
  }
},
[8898] = {
  -- Item
  '‡‡‡마법서: 신비한 폭발 IV‡‡‡‡‡秘典:魔爆術 IV',
  { -- Npc
    'Marechal Furiadastra‡Маршал из клана Ярости Горна‡Marshal der Zorneshämmer‡성난모루단 치안대장‡Alguacil Yunque Colérico‡Alguacil Yunque Colérico‡Maréchal Ragenclume‡铁怒队长‡鐵怒隊長',
    nil,
  },
  nil,
  { -- Quest
    'Querida Colara‡Дорогая моя Колара‡Liebste Colara‡친애하는 콜라라‡Queridísima Colara:‡Queridísima Colara:‡Très chère Colara,‡亲爱的科兰拉‡親愛的科蘭拉',
    nil,
    'Entregue a Carta Vincada para Colara Dean em frente ao banco de Ventobravo.‡Отнесите смятое письмо Коларе Дин, обитающей поблизости от банка в Штормграде.‡Bringt den zerknitterten Brief zu Colara Dean außerhalb der Bank in Stormwind.‡스톰윈드 은행 밖에 있는 콜라라 딘에게 반으로 접힌 편지를 전달해야 합니다.‡Entrega la carta arrugada a Colara Dean, que está junto al banco de Ventormenta.‡Entrega la carta arrugada a Colara Dean, que está junto al banco de Ventormenta.‡Apporter la Lettre froissée à Colara Dean, devant la banque de Stormwind.‡将皱褶的信件交给暴风城银行外面的科兰拉·迪恩。‡將皺褶的信件交給暴風城銀行外面的科蘭拉·迪恩。',
  }
},
[8899] = {
  -- Item
  '‡‡‡마법서: 불태우기 IV‡‡‡‡‡秘典:灼燒 IV',
  { -- Npc
    'Soldado de Cavalaria da Forja da Perdição‡Драгун из клана Кузни Рока‡Schicksalsträchtiger Dragoner‡파멸괴철로단 용기병‡Deagolo de la Forja Maldita‡Deagolo de la Forja Maldita‡Dragon Forge-ruine‡厄炉龙骑兵‡末日之爐龍騎兵',
    nil,
  },
  nil,
  { -- Quest
    'Querida Colara‡Дорогая моя Колара‡Liebste Colara‡친애하는 콜라라‡Queridísima Colara:‡Queridísima Colara:‡Très chère Colara,‡亲爱的科兰拉‡親愛的科蘭拉',
    nil,
    'Entregue a Carta Imaculada para Colara Dean, que está em frente ao banco de Ventobravo.‡Отнесите безукоризненное письмо Коларе Дин, обитающей поблизости от банка в Штормграде.‡Bringt den makellosen Brief zu Colara Dean außerhalb der Bank von Stormwind.‡스톰윈드 은행 밖에 있는 콜라라 딘에게 깔끔한 장식의 편지를 전해야 합니다.‡Entrega la carta impoluta a Colara Dean, que está junto al banco de Ventormenta.‡Entrega la carta impoluta a Colara Dean, que está junto al banco de Ventormenta.‡Apporter la Lettre immaculée à Colara Dean, devant la banque à Stormwind.‡将精美的信件交给暴风城银行外面的科兰拉·迪恩。‡將精美的信件交給暴風城銀行外面的科蘭拉·迪恩。',
  }
},
[8900] = {
  -- Item
  '‡‡‡서적: 휘감는 뿌리 IV‡‡‡‡‡書卷:糾纏根鬚 IV',
  { -- Npc
    'Arcaneiro da Forja da Perdição‡Кузнец-волшебник из клана Кузни Рока‡Schicksalsträchtiger Arkanaschmied‡파멸괴철로단 신비의대장장이‡Herrero arcano de la Forja Maldita‡Herrero arcano de la Forja Maldita‡Forgeron des arcanes Forge-ruine‡厄炉魔匠‡末日之爐魔匠',
    nil,
  },
  nil,
  { -- Quest
    'Querida Helena‡Дорогая моя Эления‡Liebste Elenia‡친애하는 엘레니아에게‡Queridísima Elenia:‡Queridísima Elenia:‡Très chère Elenia,‡亲爱的艾琳娜‡親愛的艾琳娜',
    nil,
    'Entregue o Bilhete Levemente Vincado para Helena Raiol perto do banco da Cidade Baixa.‡Отнесите слегка помятую записку Элении Хайдон, обитающей поблизости от банка в Подгороде.‡Bringt die leicht zerknitterte Notiz zu Elenia Haydon nahe der Bank in Undercity.‡언더시티의 은행 근처에 있는 엘레니아 헤이돈에게 살짝 접힌 쪽지를 전해야 합니다.‡Entrega la nota arrugada a Elenia Haydon, que está cerca del banco en Entrañas.‡Entrega la nota arrugada a Elenia Haydon, que está cerca del banco en Entrañas.‡Apporter la Note légèrement froissée à Elenia Haydon, près de la banque d\'Undercity.‡将轻折的信件交给幽暗城银行附近的艾琳娜·海东。‡將輕折的信件交給幽暗城銀行附近的艾琳娜·海東。',
  }
},
