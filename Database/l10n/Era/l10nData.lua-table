[4361] = {
  -- Item
  '‡Медная труба‡Kupferrohr‡구리관‡Tubo de cobre doblado‡Tubo de cobre doblado‡Tube en cuivre tordu‡铜管‡銅管',
  { -- Npc
    'Moralodo Lamapina‡Грязекоп из племени Болотного Плавника‡Matschkrabbler der Schlammflossen‡진흙아가미멀록 땅꾼‡Habitabosta Ancalodo‡Habitabosta Ancalodo‡Marche-boue Aileron boueux‡黑鳍泥浆鱼人‡沼鰭泥漿魚人',
    nil,
  },
  nil,
  { -- Quest
    'Informante das más notícias‡Недобрые вести‡Der Überbringer schlechter Botschaften...‡나쁜 소식 전달‡Portador de malas noticias‡Portador de malas noticias‡Le porteur des mauvaises nouvelles‡糟糕的消息‡糟糕的消息',
    nil,
    'Volte a Altaforja e dê as más notícias ao Rei Magni Barbabronze.‡Вернитесь в Стальгорн и сообщите нехорошие новости королю Магни Бронзобороду.‡Kehrt nach Ironforge zurück und überbringt König Magni Bronzebeard die schlechten Nachrichten.‡아이언포지로 돌아가 국왕 마그니 브론즈비어드에게 이 나쁜 소식을 전해야 합니다.‡Regresa a Forjaz y dale las malas noticias al rey Magni Barbabronce.‡Regresa a Forjaz y dale las malas noticias al rey Magni Barbabronce.‡Retourner à Ironforge et apporter la mauvaise nouvelle au Roi Magni Bronzebeard.‡回到铁炉堡，把这个坏消息带给国王麦格尼·铜须。‡回到鐵爐堡，把這個壞消息帶給國王麥格尼·銅須。',
  }
},
[4362] = {
  -- Item
  '‡Грубый огнестрел‡Raues Schießeisen‡조잡한 붐스틱‡Bocarda férrea‡Bocarda férrea‡Espingole grossière‡劣质火枪‡劣質火槍',
  { -- Npc
    'Correcosta Lamapina‡Береговик из племени Болотного Плавника‡Küstenläufer der Schlammflossen‡진흙아가미멀록 길잡이‡Correcostas Mirefín‡Correcostas Ancalodo‡Cours-la-côte Aileron boueux‡黑鳍滩行鱼人‡沼鰭灘行魚人',
    nil,
  },
  nil,
  { -- Quest
    'O destino do reino‡Судьба королевства‡Das Schicksal des Königreichs‡왕국의 운명‡El destino del reino‡El destino del reino‡Le destin du Royaume‡王国的命运‡王國的命運',
    nil,
    'Volte ao Abismo Rocha Negra e resgate a Princesa Moira Barbabronze das garras malignas do Imperador Dagran Thaurissan.‡Вернитесь в Глубины Черной горы и освободите принцессу Мойру Бронзобород от злобного императора Даграна Тауриссана.‡Kehrt in die Blackrocktiefen zurück und rettet Prinzessin Moira Bronzebeard aus den Fängen des bösen Imperators Dagran Thaurissan.‡검은바위 나락으로 돌아가 제왕 다그란 타우릿산의 사악한 손아귀에서 공주 모이라 브론즈비어드를 구출해야 합니다.‡Vuelve a las Profundidades de Roca Negra y rescata a la princesa Moira Barbabronce de las garras del emperador Dragan Thaurissan.‡Vuelve a las Profundidades de Roca Negra y rescata a la princesa Moira Barbabronce de las garras del emperador Dragan Thaurissan.‡Retourner dans les Profondeurs de Blackrock et secourir la Princesse Moira Bronzebeard, prisonnière de l\'Empereur Dagran Thaurissan.‡回到黑石深渊，从达格兰·索瑞森大帝的魔掌中救出铁炉堡公主茉艾拉·铜须。‡回到黑石深淵，從達格蘭·索瑞森大帝的魔掌中救出鐵爐堡公主茉艾拉·銅須。',
  }
},
[4363] = {
  -- Item
  'Modulador de Cobre‡Медный регулятор‡Kupfermodulator‡구리 변조기‡Modulador de cobre‡Modulador de cobre‡Modulateur en cuivre‡铜质调节器‡銅質調節器',
  { -- Npc
    'Oráculo Lamapina‡Оракул из племени Болотного Плавника‡Orakel der Schlammflossen‡진흙아가미멀록 점쟁이‡Oráculo Ancalodo‡Oráculo Ancalodo‡Oracle Aileron boueux‡黑鳍智者‡沼鰭神諭者',
    nil,
