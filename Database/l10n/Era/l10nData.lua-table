  nil,
  nil,
  { -- Quest
    'Um favor para Krazek‡Просьба Кразека‡Gefallen für Krazek‡크라젝의 부탁‡Un favor a Krazek‡Un favor a Krazek‡Un service pour Krazek‡克拉兹克的要求‡克拉茲克的要求',
    nil,
    'Leve 4 cargas de Minério de Pedra-sangrenta Inferior para Krazek, na Angra do Butim.‡Принесите 4 партии бедной кровавой руды Кразеку в Пиратскую бухту.‡Bringt 4 Ladungen geringes Blutsteinerz zu Krazek nach Booty Bay.‡무법항에 있는 크라젝에게 저급 혈석 광물 4개를 가져가야 합니다.‡Lleva 4 fajos de mineral de sangrita inferior a Krazek en la Bahía del Botín.‡Lleva 4 fajos de mena de sangrita inferior a Krazek en la Bahía del Botín.‡Apporter 4 chargements de Minerai de pierre de sang inférieur à Krazek à Baie-du-Butin.‡给藏宝海岸的克拉兹克带去4块次级血石矿。‡給藏寶海岸的克拉茲克帶去4塊次級血石礦。',
  }
},
[628] = {
  nil,
  { -- Npc
    'Assolador Negro‡Черный опустошитель‡Schwarzer Verheerer‡검은약탈자늑대‡Devastador negro‡Devastador negro‡Ravageur noir‡黑色破坏者‡黑色劫毀者',
