  nil,
  { -- Quest
    'Mensagem na garrafa‡Послание в бутылке‡Flaschenpost‡쪽지가 든 병‡Mensaje en una botella‡Mensaje en una botella‡Message dans une bouteille‡瓶中信‡瓶中信',
    nil,
    'Encontre o autor da mensagem na garrafa.‡Отыщите автора послания в бутылке.‡Findet den Schreiber dieser Flaschenpost.‡쪽지가 든 병의 장본인을 찾아야 합니다.‡Encuentra al autor del mensaje en la botella.‡Encuentra al autor del mensaje en la botella.‡Trouver la main qui a écrit ce message lancé à la mer dans une bouteille.‡找到瓶中信的作者。‡找到瓶中信的作者。',
  }
},
[595] = {
  nil,
  { -- Npc
    'Caçador Sanguescalpo‡Охотник из племени Кровавого Скальпа‡Jäger der Bloodscalp‡붉은머리부족 사냥꾼‡Cazador Cabellesangre‡Cazador Sangrapellejo‡Chasseur Bloodscalp‡血顶猎人‡血頂獵人',
    nil,
  },
  nil,
  { -- Quest
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Imediato Crazz quer que você cheque a enseada ao norte da Angra do Butim.‡Первый помощник Кразз попросил вас осмотреть залив на севере от Пиратской бухты.‡Erster Maat Crazz will, dass Ihr die Bucht nördlich von Booty Bay überprüft.‡일등항해사 크래즈가 무법항 북쪽의 작은 만을 조사해 달라고 부탁했습니다.‡El primer oficial Crazz quiere que eches un vistazo a la cueva norte de la Bahía del Botín.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡Le Premier Officier Crazz veut que vous contrôliez la crique au nord de Baie-du-Butin.‡大副克拉兹要求你去侦察一下藏宝海湾北边的海滩。‡大副克拉茲要求妳去偵察壹下藏寶海灣北邊的海灘。',
  }
},
[596] = {
  nil,
  { -- Npc
    'Nobre Reprogramado‡Зомбированный дворянин‡Manipulierter Adliger‡세뇌당한 귀족‡Noble aducido‡Noble aducido‡Noble manipulé‡被洗脑的贵族‡被洗腦的貴族',
    nil,
  },
  nil,
  { -- Quest
    'Colares de osso ensanguentado‡Ожерелье кровавых костей‡Blutige Knochenhalskette‡피묻은 뼈목걸이‡Collares de huesos sangrientos‡Collares de huesos sangrientos‡Les Colliers d\'os ensanglantés‡染血的白骨项链‡染血的白骨項鏈',
    nil,
    'Leve 25 Colares de Osso Ensanguentado para Kin\'weelay no Acampamento Grom\'gol.‡Принесите Кин\'вилаю 25 ожерелий Кровавых костей в лагерь Гром\'гол.‡Bringt 25 blutige Knochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 피묻은 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os ensanglantés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串染血的白骨项链。‡給格羅姆高營地的肯維雷帶回25串染血的白骨項鏈。',
  }
},
[597] = {
  nil,
  { -- Npc
    'Berserker Sanguescalpo‡Берсерк из племени Кровавого Скальпа‡Berserker der Bloodscalp‡붉은머리부족 광전사‡Rabioso Cabellesangre‡Rabioso Sangrapellejo‡Berserker Bloodscalp‡血顶狂战士‡血頂狂戰士',
    nil,
  },
  nil,
  { -- Quest
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate suas descobertas ao Imediato Crazz na Angra do Butim.‡Отнесите находку первому помощнику Краззу в Пиратскую бухту.‡Berichtet dem ersten Maat Crazz in Booty Bay von Euren Funden.‡무법항에 있는 일등항해사 크래즈에게 조사 결과를 보고해야 합니다.‡Informa sobre tus descubrimientos al primer oficial Crazz en la Bahía del Botín.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Rendre compte de vos découvertes au Premier Officier Crazz à Baie-du-Butin.‡将你的发现报告给藏宝海湾的大副克拉兹。‡將妳的發現報告給藏寶海灣的大副克拉茲。',
  }
},
[598] = {
  nil,
  { -- Npc
    'Minerador Défias‡Шахтер из Братства Справедливости‡Minenarbeiter der Defias‡데피아즈단 광부‡Minero Defias‡Minero Defias‡Mineur défias‡迪菲亚矿工‡迪菲亞礦工',
    nil,
