[3912] = {
  -- Item
  '‡Самоцвет Души‡Seelenedelstein‡영혼의 보석‡Gema de alma‡Gema de alma‡Gemme d\'âme‡灵魂宝石‡靈魂寶石',
  { -- Npc
    'Totem da Garra de Pedra III‡Тотем каменного когтя III‡Totem der Steinklaue III‡돌발톱 토템 III‡Tótem Garrapetra‡Tótem Garrapetra‡Totem de Griffes de pierre III‡石爪图腾 III‡石爪圖騰 III',
    nil,
  },
  -- Object
  '‡Яркий костер‡Loderndes Feuer‡선명한 불꽃‡Fuego llameante‡Fuego llameante‡Feu brûlant‡炽热的火焰‡熾熱的火焰',
  { -- Quest
    'Encontro na sepultura‡Встречаемся на кладбище‡Treffen am Grab‡무덤에서의 만남‡Encuentro en la tumba‡Encuentro en la tumba‡Rendez-vous à la tombe‡墓地相见‡墓地相見',
    nil,
    'Vá até o cemitério perto de Geringontzan e use o Elixir Videre. Siga as outras instruções de Bruna para achar Gaeriyan.‡Отправляйтесь на кладбище на окраине Прибамбасска и выпейте там эликсир Видере. Далее, следуя инструкциям Доновы, найдите Гаэриана.‡Geht zum Friedhof außerhalb von Gadgetzan und benutzt dort das Videre-Elixier. Befolgt Donovas übrige Anweisungen, um Gaeriyan zu finden.‡가젯잔 밖에 있는 무덤으로 가서 앞날의 비약을 사용하십시오. 도노바의 지시에 따라 개리얀을 찾아야 합니다.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Se rendre au cimetière au-dehors de Gadgetzan et boire l\'élixir de Videre. Suivre le reste des instructions de Donova pour trouver Gaeriyan.‡在加基森镇外的墓地中使用视灵药剂，然后按照多诺瓦的指示找到加里杨。‡在加基森鎮外的墓地中使用視靈藥劑，然後按照多諾瓦的指示找到加裏楊。',
  }
},
[3913] = {
  -- Item
  '‡Наполненный самоцвет Души‡Gefüllter Seelenedelstein‡충만한 영혼의 보석‡Gema de alma llena‡Gema de alma llena‡Gemme d\'âme capturée‡装满的灵魂宝石‡裝滿的靈魂寶石',
  { -- Npc
    'Totem da Garra de Pedra IV‡Тотем каменного когтя IV‡Totem der Steinklaue IV‡돌발톱 토템 IV‡Tótem Garrapetra‡Tótem Garrapetra‡Totem de Griffes de pierre IV‡石爪图腾 IV‡石爪圖騰 IV',
    nil,
  },
  -- Object
  '‡Яркий костер‡Loderndes Feuer‡선명한 불꽃‡Fuego llameante‡Fuego llameante‡Feu brûlant‡炽热的火焰‡熾熱的火焰',
  { -- Quest
    'A sepultura‡Замогильная история‡Grabesstille‡무덤의 상태‡Una situación mortal‡Una situación mortal‡Une situation grave‡寻找墓碑‡尋找墓碑',
    nil,
    'Ressuscite, depois procure a lápida que Gaeriyan disse para você encontrar.‡Воскресните, найдите могильный камень, о котором говорил Гаэриан.‡Wenn Ihr auferstanden seid, sucht nach dem Grabstein, von dem Gaeriyan Euch erzählt hat.‡부활한 후, 개리얀이 말한 묘비를 찾아야 합니다.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Ressusciter, puis rechercher la pierre tombale que Gaeriyan vous a demandé de trouver.‡复活，然后寻找加里杨让你去找的那块墓碑。‡復活，然後尋找加裏楊讓妳去找的那塊墓碑。',
  }
},
[3914] = {
  -- Item
  '‡Заплечный мешок подмастерья‡Gesellenrucksack‡장인의 배낭‡Mochila de oficial‡Mochila de oficial‡Sac à dos de compagnon‡旅者背包‡旅者背包',
  { -- Npc
    'Rethilgore‡Ретилгор‡Rethilgore‡레실고어‡Rethilgore‡Rethilgore‡Rethilgore‡雷希戈尔‡雷希戈爾',
    'O Carcereiro‡Страж подвала‡Der Zellenbewahrer‡문지기‡El guardián de la celda‡El guardián de la celda‡Le gardien de la cellule‡牢房看守‡牢房看守',
