  nil,
  { -- Npc
    'Patrício Garreta‡Патрик Гарретт‡Patrick Garrett‡패트릭 가레트‡Patrick Garrett‡Patrick Garrett‡Patrick Garrett‡帕特里克·加瑞特‡派翠克·加勒特',
    nil,
