[301] = {
  nil,
  nil,
  -- Object
  '‡Болотина‡Das Sumpfland‡저습지‡Los Humedales‡Los Humedales‡Les Paluns‡湿地‡濕地',
  { -- Quest
    'Apresente-se a Altaforja‡Отчет в Стальгорн‡Meldung in Ironforge‡아이언포지에 보고‡Informe a Forjaz‡Informe a Forjaz‡Rapport à Ironforge‡向铁炉堡报告‡向鐵爐堡報告',
    nil,
    'Entregue o Relatório de Progresso de Bandaferro para o Prospector Lançatroz.‡Отнесите отчет Сталекрута о ходе работ геологу Грозовой Вершине.‡Bringt Ironbands Fortschrittsbericht zu Ausgrabungsleiter Stormpike.‡발굴조사단장 스톰파이크에게 아이언밴드의 상황 보고서를 가져가야 합니다.‡Lleva el informe de Vetaferro al prospector Pico Tormenta.‡Lleva el informe de Vetaferro al prospector Pico Tormenta.‡Porter le Compte rendu d\'avancement d\'Ironband au Prospecteur Stormpike.‡把铁环挖掘场的进度报告交给勘察员塔伯斯·雷矛。‡把鐵環挖掘場的進度報告交給勘察員塔伯斯·雷矛。',
  }
},
[302] = {
  nil,
  { -- Npc
    'Maria Cega‡Слепая Мэри‡Die blinde Mary‡눈 먼 매리‡Mary la Ciega‡Mary la Ciega‡Marie l\'aveugle‡盲眼玛丽‡盲眼瑪麗',
    nil,
  },
  -- Object
  '‡Дун Морог‡‡던 모로‡‡Dun Morogh‡‡丹莫罗‡丹莫洛',
  { -- Quest
    'Pólvora para Bandaferro‡Порох для Сталекрута‡Pulver für Ironband‡아이언밴드에게 화약 지원‡Pólvora para Vetaferro‡Pólvora para Vetaferro‡De l\'explosif pour Ironband‡铁环的火药‡鐵環的火藥',
    nil,
    'Fale com Jern Elmocorno em Thelsamar.‡Поговорите с Джерном Шлеморогом в Телcамаре.‡Sprecht in Thelsamar mit Jern Hornhelm.‡텔사마의 예른 혼헬름과 대화하십시오.‡Habla con Jern Cornamenta en Thelsamar.‡Habla con Jern Cornamenta en Thelsamar.‡Parler à Jern Hornhelm à Thelsamar.‡和塞尔萨玛的吉恩·角盔谈一谈。‡和塞爾薩瑪的吉恩·角盔談壹談。',
  }
},
[303] = {
  nil,
  nil,
  -- Object
  '‡Дун Морог‡‡던 모로‡‡Dun Morogh‡‡丹莫罗‡丹莫洛',
  { -- Quest
    'A guerra dos Ferro Negro‡Война с Черным Железом‡Der Dunkeleisenkrieg‡검은무쇠단과의 전투‡La guerra contra los Hierro Negro‡La guerra contra los Hierro Negro‡La guerre contre les Sombrefer‡黑铁战争‡黑鐵戰爭',
    nil,
    'Rocio Garmason, de Dun Modr, quer que você mate 15 Anões Ferro Negro, 5 Escavadores Ferro Negro, 5 Sabotadores Ferro Negro e 5 Demolidores Ferro Negro.‡Мотли Каменщик в Дун Модре просит вас убить 15 дворфов, 5 проходчиков, 5 саботажников и 5 подрывников из клана Черного Железа.‡Motley Garmason in Dun Modr möchte, dass Ihr 15 Dunkeleisenzwerge, 5 Tunnelgräber der Dunkeleisenzwerge, 5 Saboteure der Dunkeleisenzwerge und 5 Demolierer der Dunkeleisenzwerge tötet.‡던 모드르의 모틀리 가마슨이 검은무쇠단 드워프 15명, 검은무쇠단 채굴꾼 5명, 검은무쇠단 투사 5명, 검은무쇠단 폭파병 5명을 처치해 달라고 부탁했습니다.‡Motley Garmason de Dun Modr quiere que mates 15 enanos Hierro Negro, 5 tuneladores Hierro Negro, 5 saboteadores Hierro Negro y 5 demoledores Hierro Negro.‡Motley Garmason de Dun Modr quiere que mates 15 enanos Hierro Negro, 5 tuneladores Hierro Negro, 5 saboteadores Hierro Negro y 5 demoledores Hierro Negro.‡Sur ordre de Motley Garmason à Dun Modr, tuer 15 nains Sombrefer : 5 Tunneliers Sombrefer, 5 Saboteurs Sombrefer et 5 Démolisseurs Sombrefer.‡丹莫德的莫特雷·加玛森要求你杀死15名黑铁矮人、5名黑铁隧道工、5名黑铁破坏者和5名黑铁爆破手。‡丹莫德的莫特雷·加瑪森要求妳殺死15名黑鐵矮人、5名黑鐵隧道工、5名黑鐵破壞者和5名黑鐵爆破手。',
  }
},
[304] = {
  nil,
  { -- Npc
    'Riding Horse (Felsteed)‡Конь Скверны‡Reitpferd (Teufelsross)‡길들인 말 (지옥마)‡Caballo de montar (Corcel vil)‡Caballo de montar (Corcel vil)‡Palefroi corrompu‡骑乘用马（梦魇）‡騎乘用馬(惡魔戰馬)',
    nil,
  },
  -- Object
  '‡Болотина‡Das Sumpfland‡저습지‡Los Humedales‡Los Humedales‡Les Paluns‡湿地‡濕地',
  { -- Quest
    'Uma tarefa cruel‡Мрачное поручение‡Eine grausige Aufgabe‡위험한 임무‡Una misión hedionda‡Una misión hedionda‡Une tâche sinistre‡艰巨的任务‡艱巨的任務',
    nil,
    'Mate Balgaras, o Asqueroso e leve a orelha dele para Trançalonga, o Austero, que está do lado de fora de Dun Modr.‡Убейте Балгараса Нечистого и принесите его ухо Гриму Длинной Косе в Дун Модр.‡Tötet Balgaras den Niederträchtigen und bringt Longbraid dem Grimmigen vor Dun Modr sein Ohr.‡불한당 발가라스를 처치하고 그의 귀걸이를 던 모드르 외곽에 있는 결의의 롱브레이드에게 가져가야 합니다.‡Mata a Balgaras el Hediondo y lleva su oreja a Largatrenza el Nefasto a las afueras de Dun Modr.‡Mata a Balgaras el Hediondo y lleva su oreja a Largatrenza el Nefasto a las afueras de Dun Modr.‡Tuer Balgaras le Crasseux et rapporter son oreille à Longbraid le Macabre à Dun Modr.‡杀死邪恶的巴尔加拉斯，把他的耳朵带给丹莫德外的布莱德·长须。‡殺死邪惡的巴爾加拉斯，把他的耳朵帶給丹莫德外的布萊德·長須。',
  }
},
[305] = {
  nil,
  { -- Npc
    'Riding Horse (White Stallion)‡Белый ездовой конь‡Reitpferd (Schimmel)‡길들인 백마‡Caballo de montar (Semental nevado)‡Caballo de montar (Semental nevado)‡Cheval (étalon blanc)‡骑乘用马（白色）‡騎乘用馬(白色)',
    nil,
