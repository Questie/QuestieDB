[8166] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰！',
    nil,
    'Ataque a mina, a serraria, a ferraria, a fazenda e então fale com o Marechal-de-campo Oslight na Ponta do Refúgio.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Onslight in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가십시오.‡Ataca la mina, la serrería, la herrería y la granja y vuelve entonces junto al alguacil de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦洞、伐木場、鐵匠鋪和農場，然後向避難谷地的奧斯萊特元帥復命。',
  }
},
[8167] = {
  -- Item
  '‡Черепаший панцирь‡Schildkrötenschuppe‡거북 등딱지‡Escama de tortuga‡Escama de tortuga‡Ecaille de tortue‡龟壳‡龜殼',
  nil,
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰！',
    nil,
    'Ataque a mina, a serraria, a ferraria, a fazenda e então fale com o Marechal-de-campo Oslight na Ponta do Refúgio.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Onslight in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가십시오.‡Ataca la mina, la serrería, la herrería y la granja y vuelve entonces junto al alguacil de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦洞、伐木場、鐵匠鋪和農場，然後向避難谷地的奧斯萊特元帥復命。',
  }
},
[8168] = {
  -- Item
  '‡Гагатовое черное перо‡Pechschwarze Feder‡새까만 깃털‡Pluma negro azabache‡Pluma negro azabache‡Plume noire‡乌黑的羽毛‡烏黑的羽毛',
  nil,
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Ataque a mina, a serraria, a ferraria, a fazenda e então fale com o Marechal-de-campo Oslight na Ponta do Refúgio.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Onslight in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가십시오.‡Ataca la mina, la serrería, la herrería y la granja y vuelve entonces junto al alguacil de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦坑、伐木場、鐵匠舖和農場，然後向避難谷地的奧斯萊特元帥覆命。',
  }
},
[8169] = {
  -- Item
  '‡Плотная шкура‡Dicker Balg‡두꺼운 통가죽‡Pellejo grueso‡Pellejo grueso‡Peau épaisse‡厚毛皮‡厚毛皮',
  nil,
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰！',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe und kehrt dann zu Todesmeister Dwire in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Ataca la mina de la Cuenca de Arathi, la serrería, la herrería y el establo y vuelve entonces junto al maestro de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l’écurie du bassin d’Arathi, puis revenez voir le Maître noir Dwire, au Trépas-d’Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦洞、伐木場、鐵匠鋪和獸欄，然後向落錘鎮的屠殺者杜維爾復命。',
  }
},
[8170] = {
  -- Item
  'Couro Rústico‡Грубая кожа‡Unverwüstliches Leder‡튼튼한 가죽‡Cuero basto‡Cuero basto‡Cuir robuste‡硬甲皮‡硬甲皮',
  nil,
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰！',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Нападите на рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe und kehrt dann zu Todesmeister Dwire in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Ataca la mina de la Cuenca de Arathi, la serrería, la herrería y el establo y vuelve entonces junto al maestro de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l’écurie du bassin d’Arathi, puis revenez voir le Maître noir Dwire, au Trépas-d’Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦洞、伐木場、鐵匠鋪和獸欄，然後向落錘鎮的屠殺者杜維爾復命。',
  }
},
[8171] = {
  -- Item
  '‡Грубая шкура‡Unverwüstlicher Balg‡거친 통가죽‡Pellejo basto‡Pellejo basto‡Peau robuste‡硬甲毛皮‡硬甲毛皮',
  nil,
  nil,
  { -- Quest
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰！',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите в Низине Арати рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe und kehrt dann zu Todesmeister Dwire in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Ataca la mina de la Cuenca de Arathi, la serrería, la herrería y el establo y vuelve entonces junto al maestro de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l’écurie du bassin d’Arathi, puis revenez voir le Maître noir Dwire, au Trépas-d’Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦洞、伐木場、鐵匠鋪和獸欄，然後向落錘鎮的屠殺者杜維爾復命。',
  }
},
