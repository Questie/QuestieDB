},
[4512] = {
  -- Item
  'Olho de Raptor do Planalto‡Глаз ящера нагорья‡Hochlandraptorauge‡고원 랩터 눈‡Ojo de raptor de las Tierras Altas‡Ojo de raptor de las Tierras Altas‡Oeil de raptor des hautes-terres‡高地迅猛龙的眼球‡高地迅猛龍的眼球',
  { -- Npc
    'Agam\'ar Pútrido‡Гниющий вурдалак‡Faulender Agam\'ar‡썩어가는 아가마르‡Agam\'ar putrefacto‡Agam\'ar putrefacto‡Agam\'ar décrépi‡腐烂的阿迦玛‡腐爛的阿迦瑪',
    nil,
  },
  nil,
  { -- Quest
    'Gosmologia‡Долгий путь слизнюка‡Brühschleimer auf Abwegen‡수액괴물 견본 수집‡Un largo camino para unas babosas‡Un largo camino para unas babosas‡Un grand périple pour une petite gelée‡远方的软泥怪‡遠方的軟泥怪',
    nil,
    'Entregue 6 Jarras de Gosma Amaldiçoada Cheias e 6 Jarras de Gosma Maculada Cheias para Laris Vagarroda em Altaforja.‡Принесите 6 банок с проклятыми слизнюками и 6 банок с нечистыми слизнюками Ларису Обалдую в Стальгорн.‡Bringt 6 mit verfluchten Brühschlammern gefüllte Behälter und 6 mit besudelten Brühschlammern gefüllte Behälter zu Laris Geardawdle in Ironforge.‡아이언포지에 있는 라리스 기어더들에게 가득찬 저주받은 수액괴물 병 6개와 가득찬 부패한 수액괴물 병 6개를 가져가야 합니다.‡Consigue 6 jarros llenos de moco maldito y 6 jarros llenos de moco corrupto pra Laris Cadenapartida en Forjaz.‡Consigue 6 jarros llenos de moco maldito y 6 jarros llenos de moco corrupto para Laris Mecaparra en Forjaz.‡Apporter 6 Pots de Limons maudits remplis et 6 Pots de Limons corrompus remplis à Laris Geardawdle, à Ironforge.‡将6瓶被诅咒的软泥怪样本和6瓶被污染的软泥怪样本交给铁炉堡的拉里斯·空轮。‡將6瓶被詛咒的軟泥怪樣本和6瓶被汙染的軟泥怪樣本交給鐵爐堡的拉裏斯·空輪。',
  }
},
[4513] = {
  -- Item
  'Coração de Raptor‡Сердце ящера‡Raptorherz‡랩터 심장‡Corazón de raptor‡Corazón de raptor‡Coeur de raptor‡迅猛龙的心脏‡迅猛龍的心臟',
  nil,
  nil,
  { -- Quest
    'Gosmologia‡Долгий путь слизнюка‡Brühschleimer auf Abwegen‡수액괴물 견본 수집‡Un largo camino para unas babosas‡Un largo camino para unas babosas‡Un grand périple pour une petite Gelée‡远方的软泥怪‡遠方的軟泥怪',
    nil,
    'Leve 10 Jarras Cheias de Amostra Pura para Laris Vagarroda em Altaforja.|nCaso você não consiga encontrar as gosmas puras, peça mais pistas para o Laris.‡Принесите 10 банок с чистыми образцами Ларису Обалдую в Стальгорн.|nЕсли будет трудно их найти, возможно, стоит попытаться добиться от Лариса подсказки.‡Bringt 10 mit reinen Proben gefüllte Krüge zu Laris Geardawdle in Ironforge.|nFalls Ihr Probleme habt, fündig zu werden, dann kann Laris Euch vielleicht noch den einen oder anderen Hinweis geben.‡아이언포지에 있는 라리스 기어더들에게 가득찬 순수한 견본 병10개를 가져가야 합니다.|n찾기 어려우면 라리스에게서 단서를 더 얻어 보십시오.‡Lleva 10 tarros de muestra pura a Laris Cadenartida a Forjaz.|nSi no los encuentras, habla con Laris.‡Lleva 10 tarros de muestra pura a Laris Mecaparra a Forjaz.|nSi no los encuentras, habla con Laris.‡Apporter 10 Pots remplis d\'échantillon pur à Laris Geardawdle, à Ironforge.|nSi vous éprouvez des difficultés à les trouver, allez voir Laris pour obtenir plus d’indices.‡将10个纯净样本瓶交给铁炉堡的拉里斯·空轮。|n如果你无法找到它们的话，不妨到拉里斯那里去再打听一些线索。‡將10個純凈樣本瓶交給鐵爐堡的拉裏斯·空輪。|n如果妳無法找到它們的話，不妨到拉裏斯那裏去再打聽壹些線索。',
  }
},
