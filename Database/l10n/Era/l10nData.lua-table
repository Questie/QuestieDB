[1524] = {
  -- Item
  'Presa Rachacrânio‡Клык тролля из клана Дробителей Черепов‡Hauer der Skullsplitter‡백골가루부족 어금니‡Colmillo Machacacráneos‡Colmillo Machacacráneos‡Défense de Skullsplitter‡劈颅巨魔的獠牙‡劈顱食人妖的獠牙',
  nil,
