[9366] = {
  -- Item
  '‡Золотые чешуйчатые рукавицы‡Goldene Schuppenstulpen‡황금 미늘 건틀릿‡Guanteletes de escamas doradas‡Guanteletes de escamas doradas‡Gantelets en écailles dorées‡金鳞护手‡金鱗護手',
