  nil,
  { -- Quest
    'O nome da fera‡Имя Зверя‡Der Name der Bestie‡악마의 이름‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡惡魔之名',
    nil,
    'Leve a têmpera para Loramus Talípedes.‡Отнесите состав для закалки Лорамусу Многоногу.‡Bringt den Härter zurück zu Loramus Thalipedes.‡헤타에라의 피를 로라무스 탈리뻬데스에게 가져가야 합니다.‡Llévale el temple a Loramus Thalimedes.|n‡Llévale el temple a Loramus Thalimedes.‡Rapporter le durcisseur à Loramus Thalipedes.‡将调剂交给洛拉姆斯·萨里比迪斯。‡將調劑交給洛拉姆斯·薩裏比迪斯。',
  }
},
[3512] = {
  nil,
  { -- Npc
    'Jaiminho‡Джимми‡Jimmy‡백이‡Jimmy‡Jimmy‡Jimmy‡吉米‡吉米',
    nil,
  },
  nil,
  { -- Quest
    'Nas palavras do próprio Erânicos‡Судя по словам Эраникуса...‡Mit Eranikus\' eigenen Worten‡에라니쿠스의 말‡Como diría  Eranikus…‡Como diría Eranikus...‡Par les mots d\'Eranikus‡帮助伊兰尼库斯‡幫助伊蘭尼庫斯',
    nil,
    'Viaje até o leste de Hibérnia e fale com Umbranse, o Médium.‡Отправляйтесь в восточную часть Зимних Ключей и поговорите с Умбрансом Ищущим Духов.‡Reist in den östlichen Teil von Winterspring und sprecht mit Umbranse, dem Geistsprecher.‡여명의 설원의 동쪽으로 가서 영매 엄브런스를 만나야 합니다.‡Viaja a la parte este de Cuna del Invierno y habla con Umbranse el Contacto Espiritual.‡Viaja a la parte este de Cuna del Invierno y habla con Umbranse el Hablaalmas.‡Se rendre dans la partie orientale du Berceau-de-l\'Hiver et aller voir Umbranse l\'implorateur d\'esprit.‡到冬泉谷的东部地区去，与灵语者阿姆布兰希谈一谈。‡到冬泉谷的東部地區去，與靈語者阿姆布蘭希談壹談。',
  }
},
[3513] = {
  nil,
  { -- Npc
    'Srta. Leda‡Мисс Данна‡Miss Danna‡다나‡Doña Danna‡Doña Danna‡Mademoiselle Danna‡丹娜小姐‡丹娜小姐',
    'Tia da Escola‡Школьная учительница‡Schulmeisterin‡학교 선생님‡Maestra de escuela‡Maestra de escuela‡Maîtresse d\'école‡女教师‡女教師',
  },
  nil,
  { -- Quest
    'O pergaminho rúnico‡Свиток с рунами‡Die runenverzierte Rolle‡룬문자 두루마리‡El pergamino rúnico‡El pergamino rúnico‡Le Parchemin runique‡符文卷轴‡符文卷軸',
    nil,
    'Leve o Pergaminho Rúnico até a torre de guarda norte nos Sertões.‡Отнесите свиток с рунами в северную сторожевую башню Степей.‡Bringt die runenverzierte Rolle zum nördlichen Wachturm des Brachlandes.‡불모의 땅의 북쪽 방어탑으로 룬문자 두루마리를 가지고 가야 합니다.‡Llévale el pergamino rúnico de la torre de vigilancia norte en Los Baldíos.‡Llévale el pergamino rúnico de la torre de vigilancia norte en Los Baldíos.‡Apporter le Parchemin runique à la tour de garde Nord dans les Tarides.‡将符文卷轴带到贫瘠之地的北部警戒塔去。‡將符文卷軸帶到貧瘠之地的北部警戒塔去。',
  }
},
