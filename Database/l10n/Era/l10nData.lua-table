[8331] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Aurel Folháurea‡Аурель Золотой Лист‡Aurel Goldleaf‡오렐 골드리프‡Aurel Hojaurea‡Aurel Hojaurea‡Aurel Feuilledor‡奥蕾尔·金叶‡奧蕾爾·金葉',
    nil,
    'Fale com Aurel Folháurea no Forte Cenariano.‡Поговорите с Аурель Золотой Лист в крепости Кенария.‡Sprecht mit Aurel Goldleaf auf Burg Cenarius.‡세나리온 요새에 있는 오렐 골드리프와 얘기해야 합니다.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥要塞的奥蕾尔·金叶谈一谈。‡與塞納裏奧要塞的奧蕾爾·金葉談壹談。',
  }
},
[8332] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Duques do Conselho‡Герцоги Совета‡Fürsten des Rates‡심연의 군주‡Duques del Consejo‡Los Duques del Consejo‡Les ducs du Conseil‡议会的公爵‡議會的公爵',
    nil,
    'Leve 1 Estilhaço Brilhante Grande e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 1 большой сияющий осколок и 3 талисмана Бездны.‡Bringt Aurel Goldleaf auf Burg Cenarius 1 großen glänzenden Splitter und 3 abyssische Wappen.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 1개, 심연의 문장 3개를 가져다 주어야 합니다.‡Lleva 1 fragmento grande brillante y 3 emblemas Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 1 fragmento luminoso grande y 3 blasones Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 1 Grand éclat brillant et 3 Blasons abyssaux à Aurel Goldleaf, au Fort cénarien.‡把1个大块魔光碎片和3顶深渊纹章交给塞纳利奥要塞的奥蕾尔·金叶。‡把1個大塊魔光碎片和3頂深淵紋章交給塞納利奧要塞的奧蕾爾·金葉。',
  }
},
