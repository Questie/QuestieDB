  nil,
  { -- Quest
    'Castigo divino‡Божественное воздаяние‡Göttliche Vergeltung‡성스러운 복수‡Castigo divino‡Castigo divino‡Châtiment divin‡神圣的惩戒‡神聖的懲戒',
    nil,
    'Ouça Kalaran Finalâmina contar a história dele.‡Выслушайте Каларана Ветрореза.‡Lasst Kalaran Windblade seine Geschichte erzählen.‡칼라란 윈드블레이드가 하는 이야기를 들으십시오.‡Escucha a Kalaran Espada del Viento.‡Escucha a Kalaran Espada del Viento.‡Écouter le récit de Kalaran Windblade.‡听卡拉然·温布雷讲述他的故事。‡聽卡拉然·溫布雷講述他的故事。',
  }
},
[3442] = {
  -- Item
  '‡Кушак ученика‡Lehrlingsschärpe‡수습생 장식띠‡Fajín de aprendiz‡Fajín de aprendiz‡Echarpe d\'apprenti‡学徒腰带‡學徒束帶',
  { -- Npc
    'Cobogó‡Пароклапан‡Sputtervalve‡스퍼터밸브‡Petardol‡Petardol‡Sputtervalve‡斯布特瓦夫‡斯布特瓦夫',
    'Sindicato dos Faz-tudo‡Союз ремонтников‡Tüftlerverband‡땜장이 조합‡Gremio de manitas‡Gremio de manitas‡Syndicat des artisans‡工匠协会‡技工協會',
  },
  nil,
  { -- Quest
    'A chama perfeita‡Неугасимое пламя‡Die fehlerlose Flamme‡완전무결한 불꽃‡La llama pura‡La llama pura‡La flamme parfaite‡无瑕之焰‡無瑕之焰',
    nil,
    'Colete 4 Corações das Chamas e 4 globos de Óleo de Golem, e leve-os para Kalaran Finalâmina.‡Принести 4 сердца пламени и 4 меры масла големов Каларану Ветрорезу.‡Sammelt 4 Herzen der Flamme und 4 Kugeln Golemöl und bringt die Gegenstände zu Kalaran Windblade.‡화염의 심장 4개와 골렘 기름 4개를 모아 칼라란 윈드블레이드에게 가져가야 합니다.‡Lleva 4 corazones de llama y 4 globos de aceite gólem a Kalaran Espada del Viento.‡Lleva 4 corazones de llama y 4 globos de aceite gólem a Kalaran Espada del Viento.‡Réunir 4 Cœurs des flammes et 4 globes d\'Huile de golem puis rapporter ces objets à Kalaran Windblade.‡收集4份烈焰之心和4份傀儡之油，然后把这些东西交给卡拉然·温布雷。‡收集4份烈焰之心和4份傀儡之油，然後把這些東西交給卡拉然·溫布雷。',
  }
},
[3443] = {
  -- Item
  '‡Парадный томагавк‡Zeremonieller Tomahawk‡의식의 토마호크‡Tomahawk ceremonial‡Tomahawk ceremonial‡Tomahawk de cérémonie‡典礼轻斧‡儀式輕斧',
  { -- Npc
    'Grude‡Грязнуля‡Grub‡그럽‡Larva‡Larva‡Boustiff\'‡格拉布‡格拉布',
    nil,
  },
  nil,
  { -- Quest
    'Forjando o bastão‡Древко факела‡Das Schmieden des Schafts‡횃불 자루 만들기‡Forjar el mango‡Forjar el mango‡Forger le manche‡铸造火炬杆‡鑄造火炬桿',
    nil,
    'Leve 8 Punhais de Placas de Tório para Kalaran Finalâmina.‡Принесите 8 окованных торием кинжалов Каларану Ветрорезу.‡Bringt 8 mit Thorium beschichtete Dolche zu Kalaran Windblade.‡칼라란 윈드블레이드에게 토륨 도금 단검 8개를 가져가야 합니다.‡Lleva 8 dagas chapadas en torio a Kalaran Espada del Viento.‡Lleva 8 dagas bañadas en torio a Kalaran Espada del Viento.‡Apporter 8 Dagues plaquées en thorium à Kalaran Windblade.‡给卡拉然带去8把瑟银匕首。‡給卡拉然帶去8把瑟銀匕首。',
  }
},
[3444] = {
  -- Item
  '‡Жилет Румпеля‡Tillers Weste‡농사꾼 조끼‡Jubón de vástago‡Jubón de vástago‡Gilet de laboureur‡提勒的外衣‡提勒的外衣',
  { -- Npc
    'Ratoupeira‡Пещерная крыса‡Grubenratte‡들쥐‡Rata de madriguera‡Rata de madriguera‡Rat fouisseur‡掘地鼠‡掘地鼠',
    nil,
  },
  nil,
  { -- Quest
    'O círculo de pedra‡Круглый камень‡Der runde Stein‡돌무리‡El Círculo de Piedras‡El círculo de piedra‡Le Cercle de pierres‡石环‡石環',
    nil,
    'Busque o Círculo de Pedra na oficina de Marlon Catarrebite em Vila Catraca.‡Заберите круглый камень из мастерской Марвона Клепальщика в Кабестане.‡Holt den runden Stein aus Marvon Rivetseekers Werkstatt in Ratchet.‡톱니항에 있는 마본 리벳시커의 작업장에서 마본의 궤짝에 담긴 아탈라이 돌무리를 회수해야 합니다.‡Recupera el Círculo de Piedras del taller de Marvon Buscarroblones, en Trinquete.‡Recupera el círculo de piedra del taller de Marvon Buscarroblones, en Trinquete.‡Récupérer le Cercle de pierres à l\'Atelier de Marvon Rivetseeker à Ratchet.‡到棘齿城去，从玛尔冯·瑞文斯克的车间里取回石环。‡到棘齒城去，從瑪爾馮·瑞文斯克的車間裏取回石環。',
  }
},
[3445] = {
  -- Item
  '‡Парадный нож‡Zeremonielles Messer‡의식의 단도‡Cuchillo ceremonial‡Cuchillo ceremonial‡Couteau de cérémonie‡典礼小刀‡儀式小刀',
  { -- Npc
    'Supervisor Rancatraca‡Бригадир Зубовиззл‡Vorsteher Lugwizzle‡관리자 러그위즐‡Supervisor Lugwizzle‡Supervisor Palarrastre‡Superviseur Lugwizzle‡鲁格维兹主管‡魯格維茲主管',
    nil,
  },
  nil,
  { -- Quest
    'O Templo Submerso‡Затонувший храм‡Der versunkene Tempel‡가라앉은 사원‡El Templo Sumergido‡El Templo Sumergido‡Le Temple englouti‡沉没的神庙‡沈沒的神廟',
    nil,
    'Encontre Marlon Catarrebite em Tanaris.‡Найдите Марвона Клепальщика в Танарисе.‡Sucht Marvon Rivetseeker in Tanaris.‡타나리스에서 마본 리벳시커를 찾아야 합니다.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Trouver Marvon Rivetseeker à Tanaris.‡到塔纳利斯找到玛尔冯·瑞文斯克。‡到塔納利斯找到瑪爾馮·瑞文斯克。',
  }
},
[3446] = {
  -- Item
  '‡Посох Темнолесья‡Dunkelholzstab‡흑단 지팡이‡Bastón Leñoscuro‡Bastón Leñoscuro‡Bâton de sombrebois‡暗木法杖‡暗木法杖',
  { -- Npc
    'Cáliper Porcatraca‡Мебок Миззрикс‡Mebok Mizzyrix‡메보크 미지릭스‡Mebok Mizzyrix‡Mebok Mizzyrix‡Mebok Mizzyrix‡麦伯克·米希瑞克斯‡麥伯克·米希瑞克斯',
    nil,
  },
  nil,
  { -- Quest
    'Nas profundezas‡Во глубине болот‡In die Tiefen‡심연의 늪‡En las profundidades‡En las profundidades‡Dans les profondeurs‡深入神庙‡深入神廟',
    nil,
    'Encontre o Altar de Hakkar no Templo Submerso, que fica no Pântano das Mágoas.‡Найдите алтарь Хаккара в затонувшем храме на Болоте Печали.‡Sucht den Altar von Hakkar im Versunkenen Tempel in den Sümpfen des Elends.‡슬픔의 늪에 있는 가라앉은 사원에서 학카르 제단을 찾아야 합니다.‡Encuentra el Altar de Hakkar en el Templo Sumergido, en el Pantano de las Penas.‡Encuentra el Altar de Hakkar en el Templo Sumergido, en el Pantano de las Penas.‡Trouver l\'Autel d\'Hakkar dans le Temple englouti du marais des Chagrins.‡在悲伤沼泽沉没的神庙中找到哈卡祭坛。‡在悲傷沼澤沈沒的神廟中找到哈卡祭壇。',
  }
},
[3447] = {
  -- Item
  '‡Сапоги могильного вора‡Gruftwandlerstiefel‡묘지기의 장화‡Botas de caminacriptas‡Botas de caminacriptas‡Bottes du marcheur des cryptes‡墓穴行者之靴‡墓穴行者之靴',
  { -- Npc
    'Pawe Corre com a Névoa‡Пава Вестница Туманов‡Pawe Mistrunner‡포위 미스트러너‡Paue Correbruma‡Paue Correbruma‡Pawe Mistrunner‡帕维·迷雾行者‡帕維·迷霧行者',
    nil,
  },
  nil,
  { -- Quest
    'Segredo do círculo‡Тайна камня‡Das Geheimnis des Kreises‡돌무리의 비밀‡El secreto del círculo‡El secreto del círculo‡Le secret du cercle‡雕像群的秘密‡雕像群的秘密',
    nil,
    'Entre no Templo Submerso e descubra o segredo escondido no círculo de estátuas.‡Отправляйтесь в затонувший храм и узнайте, что скрывается в круге статуй.‡Reist zum Versunkenen Tempel und enthüllt das Geheimnis, das sich in dem Kreis der Statuen verbirgt.‡가라앉은 사원으로 가서 원 모양으로 서 있는 석상들에 감춰진 비밀을 알아내야 합니다.‡Ve al Templo Sumergido y descubre el secreto oculto en el círculo de estatuas.‡Ve al Templo Sumergido y descubre el secreto oculto en el círculo de estatuas.‡Voyager jusqu\'au Temple englouti et découvrir le secret du cercle de statues.‡到沉没的神庙去，揭开雕像群中隐藏的秘密。‡到沈沒的神廟去，揭開雕像群中隱藏的秘密。',
  }
},
[3448] = {
  -- Item
  '‡Корень сенджины‡Sengginwurzel‡삼인 뿌리‡Raíz de senggin‡Raíz de senggin‡Racine de Senggin‡塞金之根‡塞金之根',
  { -- Npc
    'Tonga Runa Totem‡Тонга Рунический Тотем‡Tonga Runetotem‡통가 룬토템‡Tonga Tótem de Runa‡Tonga Tótem de Runa‡Tonga Runetotem‡图加·符文图腾‡圖加·符文圖騰',
    nil,
  },
  nil,
  { -- Quest
    'Passando o fardo‡Передача поручения‡Die Bürde weitergeben‡티모르의 협조‡Encargarse de la investigación‡Encargarse de la investigación‡La transmission du fardeau‡委以重任‡委以重任',
    nil,
    'Fale com Timor em Altaforja.‡Поговорите с Тимором в Стальгорне.‡Sprecht mit Magier Tymor in Ironforge.‡아이언포지에 있는 티모르와 대화하십시오.‡Habla con Tymor en Forjaz.‡Habla con Tymor en Forjaz.‡Parler au mage Tymor à Ironforge.‡跟铁炉堡的泰摩尔谈一谈。‡跟鐵爐堡的泰摩爾談壹談。',
