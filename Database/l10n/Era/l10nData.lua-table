[7781] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O Senhor dos Rocha Negra‡Владыка Черной горы‡Der Herrscher von Blackrock‡검은바위부족의 군주‡Señor de Roca Negra‡Señor de Roca Negra‡Le seigneur de Blackrock‡黑石之王‡黑石之王',
    nil,
    'Leve a Cabeça de Nefarian para o Grão-lorde Bolvar Fordragon, em Ventobravo.‡Отнесите голову Нефариана Верховному лорду Болвару Фордрагону в Штормград.‡Bringt Hochlord Bolvar Fordragon in Stormwind den Kopf von Nefarian.‡스톰윈드에 있는 대영주 볼바르 폴드라곤에게 네파리안의 머리를 가져가야 합니다.‡Llévale la cabeza de Nefarian al alto señor Bolvar Fordragón en Ventormenta.‡Llévale la cabeza de Nefarian al alto señor Bolvar Fordragón en Ventormenta.‡Apporter la Tête de Nefarian au généralissime Bolvar Fordragon à Stormwind.‡将奈法利安的头颅交给暴风城的伯瓦尔·弗塔根公爵。‡將奈法利安的頭顱交給暴風城的伯瓦爾·弗塔根公爵。',
  }
},
[7782] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O Senhor dos Rocha Negra‡Владыка Черной горы‡Der Herrscher von Blackrock‡검은바위부족의 군주‡Señor de Roca Negra‡Señor de Roca Negra‡Le seigneur de Rochenoire‡黑石之王‡黑石之王',
    nil,
    'Vá até o Vale dos Heróis, em Ventobravo, e fale com o Marechal de Campo Afrasiabi.‡Поговорите с фельдмаршалом Афрасиаби в Аллее Героев рядом со Штормградом.‡Reist in nach Stormwind in das Tal der Helden und sprecht mit Feldmarschall Afrasiabi.‡스톰윈드에 있는 영웅의 계곡으로 가서 야전사령관 아프라샤비와 대화하십시오.‡Vete al Valle de los Héroes, en la Ciudad de Ventormenta, y habla con el mariscal de campo Afrasiabi.‡Vete al Valle de los Héroes, en la Ciudad de Ventormenta, y habla con el mariscal de campo Petraponte.‡Allez à la vallée des Héros de Hurlevent et parlez au grand maréchal Afrasiabi.‡回到暴风城的英雄谷，与艾法希比元帅谈一谈。‡回到暴風城的英雄谷，與艾法希比元帥談壹談。',
  }
},
[7783] = {
  nil,
  { -- Npc
    'Loramus Talípedes‡Лорамус Многоног‡Loramus Thalipedes‡로라무스 탈리뻬데스‡Loramus Thalipedes‡Loramus Thalimedes‡Loramus Thalipedes‡洛拉姆斯·萨里比迪斯‡洛拉姆斯·薩里比迪斯',
    nil,
  },
  nil,
  { -- Quest
    'O senhor dos Rocha Negra‡Владыка Черной горы‡Der Herrscher von Blackrock‡검은바위부족의 군주‡Señor de Roca Negra‡Señor de Roca Negra‡Le seigneur de Blackrock‡黑石之王‡黑石之王',
    nil,
    'Leve a Cabeça de Nefarian para Thrall, em Orgrimmar.‡Отнесите голову Нефариана Траллу в Оргриммар.‡Bringt Thrall in Orgrimmar den Kopf von Nefarian.‡오그리마에 있는 스랄에게 네파리안의 머리을 가져가야 합니다.‡Llévale la cabeza de Nefarian a Thrall en Orgrimmar.‡Llévale la cabeza de Nefarian a Thrall en Orgrimmar.‡Apportez la Tête de Nefarian à Thrall à Orgrimmar.‡将奈法利安的头颅交给奥格瑞玛的萨尔。‡將奈法利安的頭顱交給奧格瑞瑪的薩爾。',
  }
},
[7784] = {
  nil,
  { -- Npc
    'Robô Teleguiado OOX-17/TN‡Самонаводящийся робот КПХ-17/TN‡Leitroboter OOX-17/TN‡유도 로봇 OOX-17/TN‡Robot mensajero OOX-17/TN‡Robot mensajero OOX-17/TN‡Robot guidé OOX-17/TN‡自动导航机器人OOX-17/TN‡自動導航機器人OOX-17/TN',
    nil,
  },
  nil,
  { -- Quest
    'O senhor dos Rocha Negra‡Владыка Черной горы‡Der Herrscher von Blackrock‡검은바위부족의 군주‡Señor de Roca Negra‡Señor de Roca Negra‡Le seigneur de Blackrock‡黑石之王‡黑石之王',
    nil,
    'Fale com o Lorde Supremo Saurfang em Orgrimmar. Ele espera por você no Vale da Força.‡Поговори с верховным воеводой Саурфангом. Он ждет тебя на аллее Силы в Оргриммаре.‡Sprecht mit Hochfürst Saurfang in Orgrimmar. Er wartet im Tal der Stärke auf Euch.‡오그리마에 있는 대군주 사울팽과 대화하십시오. 힘의 골짜기에서 당신을 기다리고 있습니다.‡Habla con el Señor Supremo Colmilloturbio en Orgrimmar. Te espera en el Valle de la Fuerza.‡Habla con el señor supremo Colmillosauro en Orgrimmar. Te espera en el Valle de la Fuerza.‡Parlez au Haut seigneur Saurfang à Orgrimmar. Il vous attend dans la vallée de la Force.‡和奥格瑞玛的萨鲁法尔大王谈谈。他在力量谷等你。‡和奧格瑞瑪的薩魯法爾大王談談。他在力量谷等妳。',
  }
},
[7785] = {
  nil,
  { -- Npc
    'Guarda de Zum\'rah‡Оберег Зум-Раха‡Zauberschutz von Zum\'rah‡줌라의 수호물‡Guarda de Zum\'rah‡Guarda de Zum\'rah‡Garde de Zum\'rah‡祖穆拉恩结界‡祖穆拉恩結界',
    nil,
  },
  nil,
  { -- Quest
    'Examine o casulo‡Сосуд Возрождения‡Untersuchung des Gefäßes‡결정 조사‡Examina la vasija‡Examina la vasija‡Examiner le Calice‡复生之瓶‡復生之瓶',
    nil,
    'Examine o Casulo de Renascimento e entregue-o para o Grão-lorde Dimitriano.‡Изучите Сосуд Возрождения и вернитесь к верховному лорду Демитриану.‡Untersucht das Gefäß der Wiedergeburt und bringt es zu Hochlord Demitrian.‡환생의 관을 조사한 후, 대영주 데미트리안에게 가져다주십시오.‡Examina la vasija de renacer y devuélvesela al alto señor Demitrian.‡Examina la vasija de renacer y devuélvesela al alto señor Demitrian.‡Examiner le Calice de la renaissance et le rapporter au généralissime Demitrian.‡查看复生之瓶，然后回到德米提恩那里去。‡查看復生之瓶，然後回到德米提恩那裏去。',
  }
},
[7786] = {
  -- Item
  '‡Головокол‡Kopfspalter‡분골의 도끼‡Partecabezas‡Partecabezas‡Fend-la-tête‡劈头斧‡劈頭斧',
  { -- Npc
    'Esqueleto de Zum\'rah‡Скелет Зум-Раха‡Skelett von Zum\'rah‡줌라의 해골‡Esqueleto de Zum\'rah‡Esqueleto de Zum\'rah‡Squelette de Zum\'rah‡祖穆拉恩骷髅‡祖穆拉恩骷髏',
    nil,
  },
  nil,
  { -- Quest
    'Trovejardus, o Perseguidor dos Ventos‡Громораан Ветроносец‡Donneraan der Windsucher‡바람추적자 썬더란‡Thunderaan el Hijo del Viento‡Thunderaan el Hijo del Viento‡Thunderaan le Cherchevent‡逐风者桑德兰‡逐風者桑德蘭',
    nil,
    'Para libertar Trovejardus, o Perseguidor dos Ventos, de sua prisão, você deve entregar as metades direita e esquerda dos Grilhões do Perseguidor dos Ventos, 10 Barras de Elemêntio Encantadas e a Essência do Senhor do Fogo para o Grão-lorde Dimitriano em Silithus.‡Чтобы освободить Громораана Ветроносца из тюрьмы, отнесите правый и левый наручник Ветроносца, 10 слитков элементия и сущность Повелителя огня верховному лорду Демитриану.‡Um Donneraan den Windsucher aus seiner Gefangenschaft zu befreien, müsst Ihr Hochlord Demitrian die rechten und linken Hälften der Fesseln des Windsuchers, 10 Elementiumbarren und die Essenz des Feuerfürsten bringen.‡바람추적자 썬더란을 감옥에서 해방시키려면 실리더스에 있는 대영주 데미트리안에게 바람추적자의 족쇄의 오른쪽 조각과 왼쪽 조각, 엘레멘티움 주괴 10개, 그리고 불의 군주의 정수를 가져가야 합니다.‡Para liberar a Thunderaan el Hijo del Viento de su cárcel, debes entregarle al alto señor Demitrian en Silithus la mitad izquierda y la derecha de las ataduras del Hijo del Viento, 10 barras de elementium y la esencia del Señor del Fuego.‡Para liberar a Thunderaan el Hijo del Viento de su cárcel, debes entregarle al alto señor Demitrian en Silithus la mitad izquierda y la derecha del vínculo del Hijo del Viento, 10 barras de elementium encantado y la esencia del Señor del Fuego.‡Pour libérer Thunderaan le Cherchevent de sa prison, vous devez présenter au généralissime Demetrian les moitiés droite et gauche des Liens du Cherchevent, 10 barres d\'élémentium, et l\'Essence du Seigneur du feu.‡如果你想要把逐风者桑德兰从监牢里释放出来，你就必须找到左右两块逐风者禁锢之颅，10块源质锭，以及火焰之王的精华，把它们交给德米提恩。‡如果妳想要把逐風者桑德蘭從監牢裏釋放出來，妳就必須找到左右兩塊逐風者禁錮之顱，10塊源質錠，以及火焰之王的精華，把它們交給德米提恩。',
  }
},
[7787] = {
  -- Item
  '‡Ослепительная охрана‡Prächtiger Wächter‡빛나는 수호버클러‡Guardián rutilante‡Guardián rutilante‡Gardien resplendissant‡光辉盾牌‡光輝盾牌',
  { -- Npc
    'Escravo Zangareia‡Раб из племени Песчаной Бури‡Sklave der Sandfury‡성난모래부족 노예‡Esclavo Furiarena‡Esclavo Furiarena‡Esclave Sandfury‡沙怒奴隶‡沙怒奴隸',
    nil,
  },
  nil,
  { -- Quest
    'Erga-se, Tormentária!‡Громовая ярость‡Donnerzorn erwache!‡일어나라, 우레폭풍이여!‡¡Arriba, Trueno Furioso!‡¡Arriba, Trueno Furioso!‡Éveille-toi, Lame-tonnerre !‡觉醒吧，雷霆之怒！‡覺醒吧，雷霆之怒！',
    nil,
    'Entregue a Lâmina Latente Beijada pelo Vento para o Grão-lorde Dimitriano.‡Отдайте Дремлющий клинок Игривого Ветра верховному лорду Демитриану.‡Präsentiert Hochlord Demitrian die vom Wind berührte, schlummernde Klinge.‡잠들어 있는 바람의 성검을 대영주 데미트리안 앞에 내 놓아야 합니다.‡Lleva la hoja besada por el viento durmiente al alto señor Demitrian.‡Lleva la hoja besada por el viento durmiente al alto señor Demitrian.‡Présenter la Lame du baiser du vent dormante au généralissime Demitrian.‡把风吻之刃交给德米提恩。‡把風吻之刃交給德米提恩。',
  }
},
[7788] = {
  nil,
  { -- Npc
    'Labutador Zangareia‡Чернорабочий из племени Песчаной Бури‡Zwangsarbeiter der Sandfury‡성난모래부족 노역꾼‡Bracero Furiarena‡Bracero Furiarena‡Manoeuvre Sandfury‡沙怒苦工‡沙怒苦工',
    nil,
  },
  nil,
  { -- Quest
    'Aniquile os invasores!‡Долой захватчиков!‡Besiegt die Eindringlinge!‡침략자 처단!‡¡Expulsa al invasor!‡¡Expulsa al invasor!‡Triomphez des envahisseurs !‡击败入侵者！‡擊敗入侵者！',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Horda, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue à Sentinela Cantálgures no Bosque Asa de Prata.‡Войдите в Ущелье Песни Войны, одержите победу над Ордой, получите почетный знак Ущелья Песни Войны и вернитесь с ним к часовому Дальной Песне в рощу Среброкрылых.‡Betretet die Warsongschlucht und besiegt die Streitkräfte der Horde. Verdient Euch ein Ehrenabzeichen der Warsongschlucht und kehrt zur Schildwache Farsong am Hain der Silverwing zurück.‡전쟁노래 협곡으로 들어가 호드를 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 은빛날개 숲에 있는 파수꾼 파송에게 돌아가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de honor de Grito de Guerra y vuelve con la centinela Cantolongo en el Claro Ala de la Plata.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entrez dans le goulet des Warsong, triomphez de la Horde et gagnez une Marque d\'honneur du goulet des Warsong. Puis revenez voir la sentinelle Farsong au bosquet d\'Aile-argent.‡进入战歌峡谷抵御部落小队的攻击，获得一枚银翼功勋奖章，然后向银翼树林中的哨兵艾蒂亚·轻歌回复。‡進入戰歌峽谷抵禦部落小隊的攻擊，獲得壹枚銀翼功勛獎章，然後向銀翼樹林中的哨兵艾蒂亞·輕歌回復。',
  }
},
[7789] = {
  nil,
  { -- Npc
    'Cretino Zangareia‡Глупец из племени Песчаной Бури‡Schwachkopf der Sandfury‡성난모래부족 정신병자‡Cretino Furiarena‡Cretino Furiarena‡Crétin Sandfury‡沙怒智障者‡沙怒愚者',
    nil,
  },
  nil,
  { -- Quest
    'Domine os usurpadores da Asa de Prata‡Громи захватчиков-Среброкрылых!‡Bezwingt die Eindringlinge der Silverwing‡은빛날개 분쟁 진압‡Acaba con los usurpadores Ala de Plata‡Acaba con los usurpadores Ala de Plata‡Écrasez les usurpateurs d\'Aile-argent‡镇压银翼部队‡鎮壓銀翼部隊',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Aliança, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue ao Capitão Estilhaça-crânio no Campo-base Mor\'shan.‡Войдите в Ущелье Песни Войны, одержите победу над Альянсом, получите почетный знак ущелья Песни Войны и вернитесь с ним к капитану Лободробу в лагерь Мор\'шан.‡Betretet die Warsongschlucht und besiegt die Streitkräfte der Allianz. Erwerbt ein Ehrenabzeichen der Warsongschlucht und kehrt anschließend zu Captain Shatterskull im Mor\'shan-Stützpunkt zurück.‡전쟁노래 협곡으로 진입하여 얼라이언스 진영을 무찌르고 전쟁노래 협곡 명예 훈장을 얻으십시오. 몰샨 주둔지에 있는 부대장 쉐터스컬에게 가져가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de honor de Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entrez dans le goulet des Warsong, triomphez de l\'Alliance et obtenez une Marque d\'honneur du goulet des Warsong. Puis revenez voir le capitaine Shatterskull au campement de Mor\'shan.‡进入战歌峡谷击败联盟小队，获得一枚战歌荣誉奖章，然后向莫尔杉营地的沙塔尔·碎颅复命。‡進入戰歌峽谷擊敗聯盟小隊，獲得壹枚戰歌榮譽獎章，然後向莫爾杉營地的沙塔爾·碎顱復命。',
  }
},
