[8795] = {
  -- Item
  '‡‡‡서적: 휘감는 뿌리 VI‡‡‡‡‡書卷:糾纏根鬚 VI',
  nil,
  nil,
  { -- Quest
    'A Aliança precisa de você!‡Альянсу нужна твоя помощь!‡Die Allianz braucht Euch!‡얼라이언스 지원자 모집!‡¡La Alianza te necesita!‡¡La Alianza te necesita!‡L\'Alliance a besoin de votre aide !‡联盟需要你的帮助！‡聯盟需要妳的幫助！',
    nil,
    'Fale com o Marechal-de-campo Nevado na Ala Militar de Altaforja.‡Поговорите с фельдмаршалом Снежной Лавиной, который находится в Военном дворе Стальгорна.‡Sprecht mit Feldmarschall Snowfall im Militärviertel von Ironforge.‡아이언포지의 군사 지구에 있는 야전사령관 스노우폴과 대화하십시오.‡Habla con el alguacil de campo Nevanur en La Sala Militar de Forjaz.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Parler au grand maréchal Snowfall dans la Garde militaire d’Ironforge.‡和铁炉堡军事区的大元帅斯诺·落雪谈一谈。‡和鐵爐堡軍事區的大元帥斯諾·落雪談壹談。',
  }
},
[8796] = {
  -- Item
  '‡‡‡서적: 달빛 섬광 X‡‡‡‡‡書卷:月火術 X',
  nil,
  nil,
  { -- Quest
    'A Aliança precisa de você!‡Альянсу нужна твоя помощь!‡Die Allianz braucht Euch!‡얼라이언스 지원자 모집!‡¡La Alianza te necesita!‡¡La Alianza te necesita!‡L\'Alliance a besoin de votre aide !‡联盟需要你的帮助！‡聯盟需要妳的幫助！',
    nil,
    'Fale com o Marechal-de-campo Nevado na Ala Militar de Altaforja.‡Поговорите с фельдмаршалом Снежной Лавиной, который находится на Военном дворе Стальгорна.‡Sprecht mit Feldmarschall Snowfall im Militärviertel von Ironforge.‡아이언포지의 군사 지구에 있는 야전사령관 스노우폴과 대화하십시오.‡Habla con el alguacil de campo Nevanur en La Sala Militar de Forjaz.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Parler au grand maréchal Snowfall dans la Garde militaire d’Ironforge.‡和铁炉堡军事区的大元帅斯诺·落雪谈一谈。‡和鐵爐堡軍事區的大元帥斯諾·落雪談壹談。',
