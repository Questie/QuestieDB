  nil,
  { -- Quest
    'Entrega para Sona\'rima‡Доставка Джес\'римону‡Lieferung an Jes\'rimon‡제스리몬에게 전달‡Entrega a Jes\'rimon‡Entrega a Jes\'rimon‡Livraison pour Jes\'rimon‡杰斯雷蒙的石版‡傑斯雷蒙的石版',
    nil,
    'Leve a Tabuleta de Jin\'yael para Sona\'rima em Orgrimmar.‡Отнесите табличку Джин\'яэль Джес\'римону в Оргриммар.‡Bringt die Schrifttafel von Jin\'yael zu Jes\'rimon nach Orgrimmar.‡오그리마에 있는 제스리몬에게 진야엘 서판을 가져가야 합니다.‡Envía la tablilla de Jin\'yael a Jes\'rimon en Orgrimmar.‡Envía la tablilla de Jin\'yael a Jes\'rimon en Orgrimmar.‡Apporter la Tablette de Jin\'yael à Jes\'rimon dans Orgrimmar.‡将辛耶尔石板交给奥格瑞玛的杰斯雷蒙。‡將辛耶爾石板交給奧格瑞瑪的傑斯雷蒙。',
  }
},
[3542] = {
  -- Item
  '‡‡‡‡‡‡‡‡灰色毛皮D02型長靴',
  { -- Npc
    'Jacinto Lânido‡Джейсин Ланида‡Jaysin Lanyda‡제이신 라니다‡Jaysin Lanyda‡Jaysin Lanyda‡Jaysin Lanyda‡杰森·兰达‡傑森·蘭達',
    'Venenos e Reagentes‡Яды и реагенты‡Gifte und Reagenzien‡독극물 재료 상인‡Venenos y componentes‡Venenos y componentes‡Poisons & composants‡毒药和材料‡毒藥和施法材料',
  },
