[8275] = {
  -- Item
  '‡Эбеновый кулачный щит‡Ebenholzrundschild‡흑단고리 버클러‡Rodela Fuerte ébano‡Rodela Fuerte ébano‡Targe de Fort-Ebène‡乌木圆盾‡烏木圓盾',
  nil,
  nil,
  { -- Quest
    'A retomada de Silithus‡Отвоевание Силитуса‡Die Rückeroberung von Silithus‡실리더스 탈환‡La reconquista de Silithus‡La reconquista de Silithus‡La reconquête de Silithus‡夺回希利苏斯‡奪回希利蘇斯',
    nil,
    'Apresente-se à Arauto do Vento Chifre Altivo no Forte Cenariano, em Silithus.‡Поговорите с призывательницей ветров Гордый Рог в крепости Кенария.‡Sprecht mit Windruferin Proudhorn auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼과 대화해야 합니다.‡Habla con Astaorgullo Clamavientos en el Fuerte Cenarion, en Silithus.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Parler à l\'imploratrice céleste Proudhorn au Fort cénarien, en Silithus.‡与希利苏斯塞纳里奥要塞的唤风者梅恩·长角谈一谈。‡與希利蘇斯塞納裏奧要塞的喚風者梅恩·長角談壹談。',
  }
},
[8276] = {
