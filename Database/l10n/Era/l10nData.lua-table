  nil,
  { -- Quest
    'Ponte Thandol‡Мост Тандола‡Der Thandol-Übergang‡탄돌 교각‡El puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Destrua a Caixa de Explosivos.‡Уничтожьте взрывчатку.‡Zerstört den Sprengstoffbehälter‡탄돌 교각 건너편에 있는 폭발물을 찾아서 파괴해야 합니다.‡Destruye el cajón de explosivos.‡Destruye el cajón de explosivos.‡Détruire la cache d\'explosifs.‡摧毁堆积的炸药。‡摧毀堆積的炸藥。',
  }
},
