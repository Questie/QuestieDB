  nil,
  nil,
  { -- Quest
    'Alvafunda, o Ancião‡Старейшина Рассветень‡Urahne Morndeep‡장로 문딥‡Alborhondo el Ancestro‡Alborhondo el Ancestro‡L\'Ancien Morndeep‡黎明长者‡黎明長者',
