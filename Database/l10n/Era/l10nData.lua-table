[8856] = {
  -- Item
  '‡‡‡마법서: 얼음 화살 VIII‡‡‡‡‡秘典:寒冰箭 VIII',
  { -- Npc
    'Robô-Espião de Tyrion‡Робот-шпион Тириона‡Tyrions Spionagebot‡티리온의 첩보로봇‡Robot espía de Tyrion‡Robot espía de Tyrion‡Robot espion de Tyrion‡泰里恩的间谍机器人‡泰里恩的間諜機器人',
    nil,
  },
  nil,
  { -- Quest
    'Kits de sobrevivência no deserto‡Неприкосновенный запас‡Wüstenüberlebenspaket‡사막 긴급구호 물자‡Un kit de supervivencia en el desierto‡Material de supervivencia en el desierto‡Survivre dans le désert‡沙漠生存包‡沙漠生存包',
    nil,
    'Leve 4 Globos de Água, 4 Antipeçonhas Poderosos e 4 Salmões Assados para Calandrath na estalagem do Forte Cenariano, em Silithus.‡Принесите 4 сферы воды, 4 мощных противоядия и 4 запеченных лосося Каландрате в таверну в крепости Кенария в Силитусе.‡Bringt 4 Kugeln des Wassers, 4 mächtige Gegengifte und 4 gebackene Lachse zu Calandrath in der Taverne von Burg Cenarius in Silithus.‡실리더스의 세나리온 요새 여관에 있는 캘랜드라스에게 물의 보주, 강력한 해독제, 훈제 연어를 각각 4개씩 가져가야 합니다.‡Lleva 4 globos de agua, 4 antídotos potentes y 4 salmones al horno a Calandrath, que está en la posada del Fuerte Cenarion, en Silithus.‡Lleva 4 globos de agua, 4 contravenenos potentes y 4 salmones al horno a Calandrath, que está en la posada del Fuerte Cenarion, en Silithus.‡Ramener 4 Globes d’eau, 4 Anti-venins puissants et 4 Pains de saumon à Calandrath, à l’auberge du Fort cénarien en Silithus.‡把4份纯水之球、4份特效抗毒药剂和4份烤鲑鱼交给希利苏斯塞纳里奥要塞的卡兰德拉斯。‡把4份純水之球、4份特效抗毒藥劑和4份烤鮭魚交給希利蘇斯塞納裏奧要塞的卡蘭德拉斯。',
  }
},
[8857] = {
  -- Item
  '‡‡‡마법서: 눈보라 IV‡‡‡‡‡秘典:暴風雪 IV',
  nil,
  nil,
  { -- Quest
    'Segredos dos colossos: Ashi‡Тайны колосса – Аши‡Geheimnisse des Kolosses - Ashi‡거대괴수의 비밀 - 아쉬‡Los secretos de los Colosos: Ashi‡Los secretos de los Colosos: Ashi‡Les secrets du Colosse - Ashi‡亚什巨甲虫的秘密‡亞什巨甲蟲的秘密',
    nil,
    'Leve a Carapaça do Colosso de Ashi a Olhatorto Obnótico na Angra do Butim.‡Отнесите фрагмент панциря колосса Аши Карлсу Пропеллерзу в Пиратскую бухту.‡Bringt das Fragment vom Koloss des Ashischwarms zu Oglethorpe Obnoticus in Booty Bay.‡무법항에 있는 오글소프 오브노티쿠스에게 아쉬 거대괴수의 껍질을 가져가야 합니다.‡Lleva la coraza del coloso de Ashi a Oglethorpe Obnoticus a Bahía del Botín.|n‡Lleva la coraza del coloso de Ashi a Oglethorpe Obnoticus a Bahía del Botín.‡Remettre la Carcasse du colosse d\'Ashi à Oglethorpe Obnoticus, à Baie-du-Butin.‡把亚什巨甲虫的獠牙交给藏宝海湾的奥格索普·奥布诺提斯。‡把亞什巨甲蟲的獠牙交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[8858] = {
  -- Item
  '‡‡‡마법서: 마나 보호막 IV‡‡‡‡‡秘典:法力護盾 IV',
  nil,
  nil,
  { -- Quest
    'Segredos dos colossos: Régia‡Тайны колосса – Регал‡Geheimnisse des Kolosses - Regal‡거대괴수의 비밀 - 레갈‡Los secretos de los Colosos: Regal‡Los secretos de los Colosos: Regal‡Les secrets du Colosse - Regal‡雷戈巨甲虫的秘密‡雷戈巨甲蟲的秘密',
    nil,
    'Leve a Carapaça do Colosso de Régia ao Feitor Mão-de-graxa na Garganta Abrasadora.‡Отнесите фрагмент панциря колосса Регала надзирателю Скользоруку в Тлеющем ущелье.‡Bringt das Fragment vom Koloss des Regalschwarms zu Aufseher Oilfist in die sengenden Schlucht.‡이글거리는 협곡에 있는 감독관 오일피스트에게 레갈 거대괴수의 껍질을 가져가야 합니다.‡Lleva la coraza del coloso de Regal al sobrestante Puñaceite a La Garganta de Fuego.|n‡Lleva la coraza del coloso de Regal al sobrestante Puñaceite a La Garganta de Fuego.‡Apporter la Carcasse du colosse de Regal au surveillant Oilfist, dans la gorge des Vents brûlants.‡把雷戈巨甲虫的獠牙交给灼热峡谷的工头奥菲斯特。‡把雷戈巨甲蟲的獠牙交給灼熱峽谷的工頭奧菲斯特。',
  }
},
[8859] = {
  -- Item
  '‡‡‡마법서: 화염 작열 VI‡‡‡‡‡秘典:炎爆術 VI',
  nil,
  nil,
  { -- Quest
    'Segredos dos colossos: Zora‡Тайны колосса – Зора‡Geheimnisse des Kolosses - Zora‡거대괴수의 비밀 - 조라‡Los secretos de los Colosos: Zora‡Los secretos de los Colosos: Zora‡Les secrets du Colosse - Zora‡佐拉巨甲虫的秘密‡佐拉巨甲蟲的秘密',
    nil,
    'Leve a Carapaça do Colosso de Zora ao Lorde Maximiliano Tyrosus na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите фрагмент панциря колосса Зоры лорду Максвеллу Тироссу в Часовню Последней Надежды в Восточных Чумных землях.‡Bringt das Fragment vom Koloss des Zoraschwarms zu Lord Maxwell Tyrosus an der Kapelle des hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 맥스웰 티로서스 경에게 조라 거대괴수의 껍질을 가져가야 합니다.‡Lleva la coraza del coloso de Zora a Lord Maxwell Neófitus a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.|n‡Lleva la coraza del coloso de Zora a Lord Maxwell Neófitus a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apporter la Carcasse du colosse de Zora au seigneur Maxwell Tyrosus, à la chapelle de l’Espoir de lumière, dans les Maleterres de l’est.‡把佐拉巨甲虫的獠牙交给东瘟疫之地圣光之愿礼拜堂的玛克斯韦尔·泰罗索斯男爵。‡把佐拉巨甲蟲的獠牙交給東瘟疫之地聖光之願禮拜堂的瑪克斯韋爾·泰羅索斯男爵。',
  }
},
[8860] = {
  -- Item
  '‡‡‡마법서: 화염구 IX‡‡‡‡‡秘典:火球術 IX',
  nil,
  nil,
  { -- Quest
    'Festa de fim de ano!‡Отмечаем Новый Год!‡Neujahrsfeier!‡신년맞이 축하행사!‡¡Las fiestas de Año Nuevo!‡¡Las fiestas de Año Nuevo!‡Les fêtes du Nouvel an !‡庆祝新年！‡慶祝新年！',
    nil,
    'Entregue o Suprimento do Bosque Defumado para a Estalajadeira Cristine em Ventobravo.‡Отнесите припасы Пастбищ Дымного Леса хозяйке таверны Аллисон в Штормград.‡Bringt die Vorräte von Kokelwälder zu Gastwirtin Allison in Stormwind.‡스톰윈드에 있는 여관주인 앨리슨에게 굴뚝나무 보급품을 가져가야 합니다.‡Lleva la comida de Pastos de Bosquehumeante a la posadera Allison de Ventormenta.‡Lleva la comida de Pastos de Bosquehumeante a la tabernera Allison de Ventormenta.‡Apporter les marchandises des Gourmandises Fumebois à l\'aubergiste Allison, à Stormwind.‡将烟林补给品交给暴风城的旅店老板奥里森。‡將煙林補給品交給暴風城的旅店老板奧裏森。',
  }
},
[8861] = {
  -- Item
  '‡‡‡마법서: 마나석 창조 III‡‡‡‡‡秘典:製造法術寶石 III',
  nil,
  nil,
  { -- Quest
    'Festa de fim de ano!‡Отмечаем Новый Год!‡Neujahrsfeier!‡신년맞이 축하행사!‡¡Las fiestas de Año Nuevo!‡¡Las fiestas de Año Nuevo!‡Les fêtes du Nouvel An !‡庆祝新年！‡慶祝新年！',
    nil,
    'Entregue o Suprimento do Bosque Defumado para a Estalajadeira Pala no Penhasco do Trovão.‡Отнесите припасы Пастбищ Дымного Леса хозяйке таверны Пале в Громовой Утес.‡Bringt die Vorräte von Kokelwälder zu Gastwirtin Pala in Thunder Bluff.‡썬더 블러프에 있는 여관주인 팔라에게 굴뚝나무 보급품을 가져가야 합니다.‡Lleva la comida de Pastos de Bosquehumeante a la tabernera Pala de Cima del Trueno.‡Lleva la comida de Pastos de Bosquehumeante a la tabernera Pala de Cima del Trueno.‡Apportez les Marchandises des Gourmandises Fumebois à l\'Aubergiste Pala, aux Pitons-du-Tonnerre.‡将烟林补给品交给雷霆崖的旅店老板帕拉。‡將煙林補給品交給雷霆崖的旅店老板帕拉。',
  }
},
