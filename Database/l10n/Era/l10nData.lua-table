[391] = {
  nil,
  { -- Npc
    'Velho Olho-turvo‡Старый Мрачноглаз‡Old Murk-Eye‡늙은 거먹눈 멀록‡Viejo Ojosombrío‡Viejo Ojosombrío‡Vieux Troubloeil‡老瞎眼‡老瞎眼',
    nil,
  },
  nil,
  { -- Quest
    'Rebelião no Cárcere‡Бунтовщики в тюрьме‡Aufstand im Verlies‡감옥 폭동‡El motín de las Mazmorras‡El motín de Las Mazmorras‡Les Emeutes de la Prison‡监狱暴动‡監獄暴動',
    nil,
    'Mate Basílio Taborda e leve a cabeça dele para o Carcereiro-chefe Thelágua no Cárcere.‡Убейте Базиля Тредда и принесите его голову Телвотеру в тюрьму Штормграда.‡Tötet Bazil Thredd und bringt seinen Kopf mit zurück zu Aufseher Thelwater im Verlies.‡바질 스레드를 처치하고 그 증거로 그의 머리카락을 감옥에 있는 교도소장 델워터에게 가져가야 합니다.‡Mata a Bazil Thredd y lleva su cabeza al alcaide Thelagua en las Mazmorras.‡Mata a Bazil Thredd y lleva su cabeza al celador Thelagua en las Mazmorras.‡Tuer Bazil Thredd et ramener sa tête au Gardien Thelwater à la Prison.‡杀死巴基尔·斯瑞德，把他的头带给监狱的典狱官塞尔沃特。‡殺死巴基爾·斯瑞德，把他的頭帶給監獄的典獄官塞爾沃特。',
  }
},
[392] = {
  nil,
  { -- Npc
    'Capitão Calvino‡Капитан Грейсон‡Captain Grayson‡선장 그레이슨‡Capitán Grisillo‡Capitán Grisillo‡Capitaine Grayson‡葛瑞森船长‡葛瑞森船長',
    nil,
  },
  nil,
  { -- Quest
    'Visitante suspeito‡Таинственный посетитель‡Der seltsame Besucher‡수상한 면회인‡Extraño visitante‡Extraño visitante‡Un curieux visiteur‡好奇的访客‡好奇的訪客',
    nil,
    'Leve a Descrição da Visita do Taborda Lacrada para Baros Aleixo em Ventobravo.‡Отнесите запечатанное описание посетителя Тредда Баросу Алекстону в Штормград.‡Bringt die versiegelte Beschreibung von Thredds Besucher nach Stormwind zu Baros Alexston.‡스톰윈드에 있는 바로스 알렉스턴에게 스레드의 방문객에 대한 봉인된 인상서를 전해줘야 합니다.‡Lleva la descripción sellada del visitante de Thredd al Baros Alexton en Ventormenta.‡Lleva la descripción del visitante de Thredd lacrada a Baros Alexston en Ventormenta.‡Apporter la description du visiteur de Thredd à Baros Alexston à Stormwind.‡将神秘访客的资料交给暴风城的巴隆斯·阿历克斯顿。‡將神秘訪客的資料交給暴風城的巴隆斯·阿歷克斯頓。',
  }
},
[393] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡被馴服的狼',
    nil,
  },
  nil,
  { -- Quest
    'Sombra do passado‡Тень прошлого‡Schatten der Vergangenheit‡과거의 그림자‡Sombras del pasado‡Sombras del pasado‡Les Ombres du Passé‡往日的阴影‡往日的陰影',
    nil,
    'Leve a Descrição da Visita do Taborda Lacrada para o Mestre Mathias Shaw em Ventobravo.‡Отнесите запечатанное описание посетителя Тредда Матиасу Шоу в Штормград.‡Bringt die versiegelte Beschreibung von Thredds Besucher nach Stormwind zu Meister Mathias Shaw.‡스톰윈드에 있는 단장 마티아스 쇼에게 스레드의 방문객에 대한 봉인된 인상서를 전해줘야 합니다.‡Lleva la descripción sellada del visitante de Thredd al maestro Mathias Shaw en Ventormenta.‡Lleva la descripción del visitante de Thredd lacrada al maestro Mathias Shaw en Ventormenta.‡Apporter la Description scellée du visiteur de Thredd au Maître Mathias Shaw à Stormwind.‡与旧城区的马迪亚斯·肖尔谈一谈。‡與舊城區的馬迪亞斯·肖爾談壹談。',
  }
},
[394] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A cabeça da fera‡Голова чудовища‡Der Kopf des Ganzen‡잔인한 자의 최후‡La cabeza de la bestia‡La cabeza de la bestia‡La tête de la bête‡禽兽的首级‡禽獸的首級',
    nil,
    'Fale com Mathias Shaw em Ventobravo.‡Поговорите с Матиасом Шоу в Штормграде.‡Sprecht mit Mathias Shaw in Stormwind.‡스톰윈드에 있는 마티아스 쇼와 대화해야 합니다.‡Habla con Mathias Shaw en Ventormenta.‡Habla con Mathias Shaw en Ventormenta.‡Parler à Mathias Shaw, à Stormwind.‡去见暴风城旧城区的马迪亚斯·肖尔。‡去見暴風城舊城區的馬迪亞斯·肖爾。',
  }
},
[395] = {
  nil,
  { -- Npc
    'Markos‡Маркус‡Markus‡마커스‡Markus‡Markus‡Markus‡玛库斯‡瑪庫斯',
    nil,
  },
  nil,
  { -- Quest
    'Fim da irmandade‡Гибель братства‡Das Ende der Bruderschaft‡데피아즈단의 종말‡El fin de la Hermandad‡El fin de la Hermandad‡La fin de la Confrérie‡兄弟会的灭亡‡兄弟會的滅亡',
    nil,
    'Fale com Baros Aleixo em Ventobravo.‡Поговорите с Баросом Алекстоном в Штормграде.‡Sprecht mit Baros Alexston in Stormwind.‡스톰윈드에 있는 바로스 알렉스턴과 대화하십시오.‡Habla con Baros Alexton en Ventormenta.‡Habla con Baros Alexston en Ventormenta.‡Parler à Baros Alexston à Stormwind.‡与暴风城的巴隆斯·阿历克斯顿谈一谈。‡與暴風城的巴隆斯·阿歷克斯頓談壹談。',
  }
},
[396] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Uma audiência com o rei‡Аудиенция у короля‡Eine Audienz beim König‡국왕 알현‡Una audiencia con el Rey‡Una audiencia con el Rey‡Une audience avec le roi‡觐见国王‡覲見國王',
    nil,
    'Entregue o Relatório sobre a Irmandade Défias de Baros Aleixo ao Rei Varian Wrynn na Bastilha Ventobravo.‡Доставьте доклад Бароса Алекстона из Братства Справедливости королю Вариану Ринну в Крепость Штормграда.‡Liefert Baros Alexstons Bericht über die Bruderschaft der Defias bei König Varian Wrynn in der Burg Stormwind ab.‡스톰윈드 왕궁으로 가서 국왕 바리안 린에게 올릴 알렉스턴의 데피아즈단에 대한 보고서를 전달해야 합니다.‡Lleva el informe de Baros Alexston sobre la Hermandad Defias al rey Varian Wrynn en el Castillo de Ventormenta.‡Lleva el informe de Baros Alexston sobre la Hermandad Defias al rey Varian Wrynn en el Castillo de Ventormenta.‡Apporter le rapport de Baros Alexston sur la Confrérie Défias au Roi Varian Wrynn au Donjon de Stormwind.‡将有关迪菲亚兄弟会的报告送给暴风要塞里的国王瓦里安·乌瑞恩。‡將有關迪菲亞兄弟會的報告送給暴風要塞裏的國王瓦裏安·烏瑞恩。',
  }
},
[397] = {
  nil,
  { -- Npc
    'Morganth‡Моргант‡Morganth‡모건스‡Morganth‡Morganth‡Morganth‡莫甘斯‡莫甘斯',
    nil,
  },
  nil,
  { -- Quest
    'Atendimento nota 10‡За достойную службу‡Ihr habt uns gut gedient‡수고의 대가‡Nos has hecho un gran servicio‡Nos has hecho un gran servicio‡Vous nous avez bien servi‡干得好‡幹得好',
    nil,
    'Fale com Pingo, o lacaio de Malvino da Garra Preta, para receber sua recompensa.‡Поговорите с Згги, слугой Зардета Черного Когтя, чтобы получить награду.‡Sprecht mit Zggi, dem Diener von Zardeth von den Blackclaw, um Eure Belohnung zu erhalten.‡검은발톱 자데스의 하인인 즈기와 대화하여 보상을 받으십시오.‡Habla con Zggi, el sirviente de Zardeth de los Zarpanegra, para pedir tu recompensa.‡Habla con Zggi, el sirviente de Zardeth de los Zarpanegra, para pedir tu recompensa.‡Aller demander votre récompense en parlant à Zggi, le serviteur de Zardeth de Black Claw.‡去找黑爪加尔德斯的仆人兹吉谈一谈，并向他索要你的酬劳。‡去找黑爪加爾德斯的仆人茲吉談壹談，並向他索要妳的酬勞。',
  }
},
[398] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Procura-se: Olho de Verme‡Разыскивается: Червеглаз‡GESUCHT: Madenauge‡구더기눈 현상수배‡Se busca: Ojo de gusano‡Se busca: Ojo de cresa‡On recherche : Œil-de-ver‡悬赏：蛆眼‡懸賞：蛆眼',
    nil,
    'Mate e leve a pata de Olho de Verme para o Executor Zigano em Montalvo para receber a recompensa.‡Убейте Червеглаза и отнесите палачу Зуганду в Брилл его лапу.‡Tötet Madenauge und kehrt dann mit seiner Tatze zu Exekutor Zygand nach Brill zurück, um eine Belohnung zu erhalten.‡구더기눈을 처치한 후 브릴에 있는 집행관 자이건드에게 돌아가 구더기눈의 앞발을 증거로 제출하고 보상을 받으십시오.‡Mata a Ojo de gusano y llévale su garra al ejecutor Zygand de Rémol para obtener una recompensa.‡Mata a Ojo de cresa y llévale su garra al ejecutor Zygand de Rémol para obtener una recompensa.‡Tuer Œil-de-ver et rapporter ses griffes à l\'Exécuteur Zygand pour toucher la récompense.‡杀死蛆眼，并将他的爪子交给布瑞尔的执行官塞加德以换取酬劳。‡殺死蛆眼，並將他的爪子交給布瑞爾的執行官塞加德以換取酬勞。',
  }
},
[399] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Origens humildes‡Скромные дары прошлого‡Ein bescheidener Anfang‡초라한 시작‡Principios humildes‡Principios humildes‡Débuts modestes‡童年的记忆‡童年的記憶',
    nil,
    'Vá até a casa de Baros Aleixo em Cerro Oeste e procure sua bússola, então a entregue para ele na Praça da Catedral de Ventobravo.‡Обыщите дом Бароса Алекстона в Западном Крае, найдите компас и вернитесь на Соборную площадь Штормграда.‡Begebt Euch zu Baros Alexstons Haus in Westfall und sucht nach seinem Kompass. Übergebt ihm diesen dann am Kathedralenplatz von Stormwind.‡서부 몰락지대에 있는 바로스 알렉스턴의 집으로 가서 나침반을 찾은 다음 스톰윈드의 대성당 광장에 있는 바로스 알렉스턴에게 가져가야 합니다.‡Ve a la casa de Baros Alexston en Páramos del Poniente y busca su brújula. A continuación, llévasela al Distrito de la Catedral, en Ventormenta.‡Ve a la casa de Baros Alexston en los Páramos de Poniente y busca su brújula. A continuación, llévasela al Distrito de la Catedral, en Ventormenta.‡Aller à la maison de Baros Alexston dans la marche de l\'Ouest pour chercher sa boussole et lui rapporter à la place de la Cathédrale de Stormwind.‡到巴隆斯·阿历克斯顿在西部荒野的房子里去找到他的指南针，并将它带回暴风城的教堂广场交给他。‡到巴隆斯·阿歷克斯頓在西部荒野的房子裏去找到他的指南針，並將它帶回暴風城的教堂廣場交給他。',
  }
},
[400] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ferramentas para Gradaço‡Инструменты для Сталежара‡Werkzeuge für Steelgrill‡스틸그릴이 주문한 공구‡Herramientas para Brasacerada‡Herramientas para Brasacerada‡Des outils pour Steelgrill‡贝尔丁的工具‡貝爾丁的工具',
    nil,
    'Entregue as Ferramentas do Gradaço para Beldin Gradaço.‡Доставьте инструменты Белдину Сталежару.‡Liefert Beldin Steelgrill seine Werkzeuge.‡벨딘 스틸그릴에게 스틸그릴의 공구를 배달해야 합니다.‡Entrega las herramientas de Brasacerada a Beldin Brasacerada.‡Entrega las herramientas de Brasacerada a Beldin Brasacerada.‡Rapporter les outils de SteelGrill à Beldin Steelgrill.‡把贝尔丁的工具交给贝尔丁·钢架。‡把貝爾丁的工具交給貝爾丁·鋼架。',
  }
},
[401] = {
