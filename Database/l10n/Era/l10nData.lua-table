  nil,
  nil
},
[549] = {
  nil,
  nil,
  nil,
  { -- Quest
    'PROCURA-SE: integrantes da Camarilha‡РАЗЫСКИВАЮТСЯ: сторонники Синдиката‡GESUCHT: Syndikatspersonal‡비밀결사대원 현상수배‡SE BUSCA: Personal de la Hermandad‡SE BUSCA: Personal de la Hermandad‡ON RECHERCHE : Personnel du Syndicat‡通缉：辛迪加成员‡通緝：辛迪加成員',
    nil,
    'Mate 10 Ladinos da Camarilha e 10 Vigias da Camarilha. Fale novamente com a Alta-executora Darthalia na Serraria Tarren para receber sua recompensa.‡Убейте 10 разбойников и 10 сторожей Синдиката и возвращайтесь за наградой к верховному палачу Дарталии в Мельницу Таррен.‡Tötet 10 Schurken des Syndikats und 10 Wachmänner des Syndikats. Kehrt danach zu Hochexekutorin Darthalia nach Tarrens Mühle zurück.‡비밀결사대 도적 10명과 비밀결사대 경비병 10명을 처치해야 합니다. 그런 다음 타렌 밀농장에 있는 고위집행관 다살리아에게 돌아가 보상금을 받으십시오.‡Mata a 10 pícaros y 10 vigilantes de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Mata a 10 pícaros y 10 veladores de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Tuer 10 Voleurs et 10 Gardiens du Syndicat, puis aller voir la Grande Exécutrice Darthalia à Moulin-de-Tarren pour votre récompense.‡杀死10个辛迪加潜行者和10个辛迪加哨兵，然后回到塔伦米尔向高级执行官达萨利亚报告。‡殺死10個辛迪加潛行者和10個辛迪加哨兵，然後回到塔倫米爾向高級執行官達薩利亞報告。',
  }
},
[550] = {
  nil,
  { -- Npc
    'Mensageiro Défias‡Вестник из Братства Справедливости‡Bote der Defias‡데피아즈단 전령‡Mensajero Defias‡Mensajero Defias‡Messager défias‡迪菲亚信使‡迪菲亞信差',
    nil,
  },
  nil,
  { -- Quest
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Leve a Comenda Lacrada de Darthalia para Varimatras, na Cidade Baixa.‡Отнесите запечатанное рекомендательное письмо Дарталии Вариматрасу в Подгород.‡Bringt Darthalias versiegelte Belobigung zu Varimathras nach Undercity.‡언더시티에 있는 바리마트라스에게 다살리아의 봉인된 추천서를 가져가야 합니다.‡Lleva la mención de honor lacrada de Darthalia a Varimathras en Entrañas.‡Lleva la mención de honor lacrada de Darthalia a Varimathras en Entrañas.‡Apporter la Recommandation scellée à Varimathras à Undercity.‡把达萨利亚的奖状交给幽暗城的瓦里玛萨斯。‡把達薩利亞的獎狀交給幽暗城的瓦裏瑪薩斯。',
  }
},
[551] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Pergaminho encantado‡Заколдованный пергамент‡Das Verhexte Pergament‡마법의 양피지‡El pergamino encantado‡El papiro encantado‡Le Parchemin ensorcelé‡附有魔法的羊皮纸‡附有魔法的羊皮紙',
    nil,
    'Leve o Pergaminho Encantado para o Historiador Dibbs, em Costa Sul.‡Отнесите заколдованный пергамент Хранителю мудрости Диббсу в Южнобережье.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Southshore.‡사우스쇼어에 있는 현자 딥스에게 마법의 양피지를 가져가야 합니다.‡Lleva el pergamino encantado al maestro del Conocimiento Dibbs en Costasur.‡Llévale el papiro hechizado al maestro cultural Dibbs en Costasur.‡Apporter le Parchemin ensorcelé à l\'Erudit Dibbs à Southshore.‡将这张附有魔法的羊皮纸带给南海镇的博学者迪布斯。‡將這張附有魔法的羊皮紙帶給南海鎮的博學者迪布斯。',
  }
},
[552] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Uma vingança para Helcolar‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡La venganza de Helcular‡La venganza de Helcular‡La vengeance d\'Helcular‡赫尔库拉的复仇‡赫爾庫拉的復仇',
    nil,
    'Recupere o Bastão de Helcolar do Yeti e leve-o de volta para o Noviço Trevando, em Serraria Tarren.‡Отберите у йети жезл Гелькулара и отнесите его новобранцу Тайлванду на мельницу Таррен.‡Holt Helculars Rute von dem Yeti und bringt sie zu Novize Thaivand nach Tarrens Mühle zurück.‡설인에게서 헬쿨라의 마법봉을 되찾아 타렌 밀농장에 있는 수련사 사이반드에게 가져가야 합니다.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Reprendre le Bâtonnet d\'Helcular aux yétis et la ramener au novice Thaivand à Moulin-de-Tarren.‡从雪怪手上拿回赫尔库拉的魔棒，把它交给塔伦米尔的学徒塞万德。‡從雪怪手上拿回赫爾庫拉的魔棒，把它交給塔倫米爾的學徒塞萬德。',
  }
},
[553] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Uma vingança para Helcolar‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡La venganza de Helcular‡La venganza de Helcular‡La vengeance d\'Helcular‡赫尔库拉的复仇‡赫爾庫拉的復仇',
    nil,
    'Carregue o Bastão de Helcolar com os poderes da Chama de Azel, da Chama de Veraz e da Chama de Uzel.|nColoque o bastão carregado na tumba de Helcolar, em Costa Sul.‡Зарядите Гелькуларов жезл силой пламени Азеля, пламени Вераза и пламени Узеля.|nВонзите заряженный жезл в гробницу Гелькулара в Южнобережье.‡Ladet die Rute von Helcular mit der Macht der Flamme von Azel, der Flamme von Veraz und der Flamme von Uzel auf.|nStoßt die aufgeladene Rute in Helculars Grab in Southshore.‡헬쿨라의 마법봉에 아젤의 불꽃, 베라즈의 불꽃, 우젤의 불꽃의 마력을 불어넣어야 합니다.|n힘을 불어넣은 마법봉을 사우스쇼어에 있는 헬쿨라의 무덤으로 가져가야 합니다.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la LLama de Veraz y la Llama de Uzel.|nLuego llévala a la tumba de Helcular en Costasur.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la Llama de Veraz y la Llama de Uzel.|nLuego llévala a la tumba de Helcular en Costasur.‡Charger le Bâtonnet d\'Helcular des pouvoirs de la Flamme d\'Azel, de la Flamme de Veraz et de la Flamme d\'Uzel.|nEnfoncez le Bâtonnet chargé dans la tombe d\'Helcular à Southshore.‡将埃希尔之焰、沃拉兹之焰和尤基尔之焰的力量注入赫尔库拉的魔棒。|n把经过仪式洗礼之后的魔棒带到南海镇的赫尔库拉墓地。‡將埃希爾之焰、沃拉茲之焰和尤基爾之焰的力量註入赫爾庫拉的魔棒。|n把經過儀式洗禮之後的魔棒帶到南海鎮的赫爾庫拉墓地。',
  }
},
[554] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Decifração de Lançatroz‡Расшифровщик Грозовая Вершина‡Stormpikes Entschlüsselung‡스톰파이크의 판독‡La descodificación de Pico Tormenta‡La descodificación de Pico Tormenta‡Stormpike décode‡解码高手‡解碼高手',
    nil,
    'Leve o Pergaminho Encantado para o Prospector Lançatroz, em Altaforja.‡Отнесите заколдованный пергамент геологу Грозовой Вершине в Стальгорн.‡Bringt das verhexte Pergament zu Ausgrabungsleiter Stormpike nach Ironforge.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 마법의 양피지를 가져가야 합니다.‡Lleva el pergamino codificado al prospector Pico Tormenta a Forjaz.‡Lleva el papiro codificado al prospector Pico Tormenta a Forjaz.‡Apporter le Parchemin ensorcelé au Prospecteur Stormpike à Ironforge.‡把附有魔法的羊皮纸带给铁炉堡的勘察员塔伯斯·雷矛。‡把附有魔法的羊皮紙帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[555] = {
  -- Item
  '‡Грубые перья стервятника‡Raue Geierfedern‡빳빳한 독수리 깃털‡Plumas de buitre férreas‡Plumas de buitre férreas‡Plumes de vautour‡劣质秃鹫羽毛‡劣質禿鷹羽毛',
  nil,
  nil,
  { -- Quest
    'Caldo reconfortante de tartaruga‡Нежный черепаховый суп‡Milde Schildkrötensuppe‡독특한 거북이 비스크‡Sopa de tortuga calmante‡Sopa de tortuga reconfortante‡Bisque de tortue apaisante‡海龟汤‡海龜湯',
    nil,
    'Leve 10 peças de Carne de Tartaruga e alguns Temperos Reconfortantes para o Mestre-cuca Jessé, em Costa Sul.‡Принесите 10 кусков черепашьего мяса и немного смягчающих пряностей шеф-повару Джессену в Южнобережье.‡Bringt 10 Stücke Schildkrötenfleisch und einige feine Gewürze zu Küchenchef Jessen nach Southshore.‡사우스쇼어에 있는 주방장 예센에게 거북이 고기 10개와 독특한 양념을 가져가야 합니다.‡Lleva 10 piezas de carne de tortuga y especias calmantes al chef Jessen a Costasur.‡Llévale 10 piezas de carne de tortuga y algunas especias calmantes al chef Jessen en Costasur.‡Apporter 10 morceaux de Viande de tortue et des Epices apaisantes au Chef Jessen à Southshore.‡给南海镇的厨师杰森带去10块海龟肉和一些舒心草。‡給南海鎮的廚師傑森帶去10塊海龜肉和壹些舒心草。',
  }
},
[556] = {
  -- Item
  '‡Клюв канюка‡Bussardschnabel‡대머리수리 부리‡Pico de águila ratonera‡Pico de águila ratonera‡Bec de busard‡秃鹫的喙‡禿鷲的喙',
  nil,
  nil,
  { -- Quest
    'Fichas de pedra‡Каменные талисманы‡Steinmarken‡징표의 돌‡Muestras de piedra‡Muestras de piedra‡Les Runes gravées‡石雕‡石雕',
    nil,
    'Leve 10 Fichas de Pedra Gasta para o Guardião Bel\'varão, na Serraria Tarren.‡Отнесите 10 истертых каменных талисманов хранителю Бел\'варилу с мельницы Таррен.‡Bringt 10 abgenutzte Steinmarken zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 밀농장에 있는 관리인 벨바릴에게 닳아해진 징표의 돌 10개를 가져가야 합니다.‡Lleva 10 muestras de piedra gastada al guardián Bel’varil de Molino Tarren.‡Lleva 10 muestras de piedra desgastada al vigilante Bel’varil de Molino Tarren.‡Apporter 10 Runes gravées au Conservateur Bel\'varil à Moulin-de-Tarren.‡收集10个用旧的石雕，把它们带给塔伦米尔的看守者贝尔杜加。‡收集10個用舊的石雕，把它們帶給塔倫米爾的看守者貝爾杜加。',
  }
},
[557] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Braçadeiras da vinculação‡Сковывающие браслеты‡Armschienen der Bindung‡결속의 팔보호구‡Brazales de vínculo‡Brazales de vínculo‡Les Bracelets de liaison‡地缚护腕‡地縛護腕',
    nil,
    'Leve 4 Braçadeiras do Vínculo à Terra para o Guardião Bel\'varão, na Serraria Tarren.‡Принесите 4 браслета Земли хранителю Бел\'варилу с мельницы Таррен.‡Bringt 4 Armschienen der Erdbindung zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 밀농장에 있는 관리인 벨바릴에게 대지 결속의 팔보호구 4개를 가져가야 합니다.‡Lleva 4 brazales de vínculo con la Tierra al guardián Bel’varil de Molino Tarren.‡Lleva 4 brazales de vínculo de Tierra al vigilante Bel’varil de Molino Tarren.‡Apporter 4 Brassards de liaison de terre au Conservateur Bel\'varil à Moulin-de-Tarren.‡为塔伦米尔的看守者贝瓦里尔收集4个地缚护腕。‡為塔倫米爾的看守者貝瓦裏爾收集4個地縛護腕。',
  }
},
[558] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Autógrafo da Jaina‡Автограф Джайны‡Jainas Autogramm‡제이나의 사인‡El autógrafo de Jaina‡El autógrafo de Jaina‡L\'autographe de Jaina‡吉安娜的签名‡珍娜的簽名',
    nil,
    'Vá a Theramore para tentar conseguir o autógrafo da Grã-senhora Jaina Proudmore para o seu protegido.‡Отправляйтесь в Терамор и постарайтесь получить автограф Джайны Праудмур для своего подопечного.‡Reist nach Theramore und versucht für Euren Schützling ein Autogramm von Lady Jaina Proudmoore zu ergattern.‡돌보고 있는 고아를 위해 테라모어로 가서 여군주 제이나 프라우드모어의 사인을 받아야 합니다.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Allez à Theramore pour tenter d\'obtenir un autographe de dame Jaina Portvaillant pour votre protégé.‡到塞拉摩去，为你看护的孩子拿到一份吉安娜·普罗德摩尔的亲笔签名。‡',
  }
},
[559] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Colete 10 Cabeças de Murloc dos murlocs da Praia Ocidental para o Tenente Fárrio Orinelle, que está na Costa Sul.‡Соберите 10 голов мурлоков на Западном побережье по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Sammelt 10 Murlocköpfe von den Murlocs am Weststrand für Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬에게 서부 해안에서 멀록을 처치하고 멀록 머리 10개를 모아야 합니다.‡Recoge 10 cabezas de murloc en la Playa del Oeste por orden del general Farren Orinelle de Costasur.‡Recoge 10 cabezas de múrloc en la Playa del Oeste por orden del teniente Farren Orinelle de Costasur.‡Collecter 10 Têtes de murlocs sur les murlocs du Rivage occidental pour le lieutenant Farren Orinelle à Southshore.‡南海镇的法尔林·奥里涅尔中尉要你从西部海岸的鱼人身上收集10颗鱼人的头颅。‡南海鎮的法爾林·奧裏涅爾中尉要妳從西部海岸的魚人身上收集10顆魚人的頭顱。',
  }
},
[560] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Entregue o Saco com Cabeças de Murloc ao Delegado Trilharrubra na Costa Sul.‡Отнесите мешок с головами мурлоков маршалу Крассену в Южнобережье.‡Bringt den Sack mit den Murlocköpfen zu Marshal Redpath nach Southshore.‡사우스쇼어에 있는 치안대장 레드패스에게 멀록 머리가 든 자루를 전달해야 합니다.‡Entrega las cabezas de murloc al mariscal Rutagrana de Costasur.‡Entrega las cabezas de múrloc al alguacil Rutagrana de Costasur.‡Livrer le Sac de têtes de murlocs au maréchal Redpath à Southshore.‡把一袋鱼人的头颅交给南海镇的治安官雷德帕斯。‡把壹袋魚人的頭顱交給南海鎮的治安官雷德帕斯。',
  }
},
[561] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Fale com o Tenente Fárrio Orinelle na Costa Sul.‡Поговорите с лейтенантом Фарреном Оринелем из Южнобережья.‡Sprecht mit Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬과 대화해야 합니다.‡Habla con el general Farren Orinelle en Costasur.‡Habla con el teniente Farren Orinelle en Costasur.‡Parler au Lieutenant Farren Orinelle à Southshore.‡和南海镇的法尔林·奥里涅尔中尉谈一谈。‡和南海鎮的法爾林·奧裏涅爾中尉談壹談。',
  }
},
[562] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ventobravo, avante!‡Ха, Штормград!‡Stormwind Ho!‡아, 스톰윈드!‡Cambio de destino‡Cambio de destino‡Stormwind me voilà‡升官之道‡升官之道',
    nil,
    'Mate 10 Caça-costas Espinhadaga e 10 Sirenas Espinhadaga para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 береговых охотников и 10 сирен из клана Пронзающего Гребня по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Küstenjäger der Säbelflossen und 10 Sirenen der Säbelflossen für Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬을 위해 비수가시일족 바다사냥꾼 10마리와 비수가시일족 세이렌 10마리를 처치해야 합니다.‡Mata a 10 cazacostas y 10 sirenas Dagaespinazo por orden del general Farren Orinelle de Costasur.‡Mata a 10 cazacostas y 10 sirenas Espinadaga por orden del teniente Farren Orinelle de Costasur.‡Tuer 10 Chasseurs du Rivage et 10 Sirènes Daguéchine pour le lieutenant Farren à Southshore.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个刺脊滩行者和10个刺脊海妖。‡南海鎮的法爾林·奧裏涅爾中尉要妳去殺掉10個刺脊灘行者和10個刺脊海妖。',
  }
},
[563] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Transferência‡Новое назначение‡Versetzungen‡전출‡Nueva asignación‡Nueva asignación‡Nouvelle affectation‡人事调动‡人事調動',
    nil,
    'Entregue o Relatório de Fárrio para o Major Samuelson na Bastilha Ventobravo.‡Отнесите донесение Фаррена майору Самуэльсону в Крепость Штормграда.‡Bringt Farrens Bericht zu Major Samuelson in die Burg Stormwind.‡스톰윈드 왕궁에 있는 상사 사무엘슨에게 파렌의 보고서를 전달해야 합니다.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Remettre le Rapport de Farren au major Samuelson au Donjon de Stormwind.‡把法尔林的报告交给暴风要塞里的萨缪尔森少校。‡把法爾林的報告交給暴風要塞裏的薩繆爾森少校。',
  }
},
[564] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡狗頭人奴隸',
    nil,
  },
  nil,
  { -- Quest
    'Ameaça cara‡Серьезная угроза‡Teure Bedrohung‡크나큰 위협‡Una amenaza costosa‡Una amenaza costosa‡Un problème très coûteux‡损失惨重‡損失慘重',
    nil,
    'Dario Malavista, da Costa Sul, quer que você mate 8 Leões da Montanha e 10 Leões da Montanha Imponentes.‡Убейте 8 горных львов и 10 крупных горных львов по поручению Даррена Малвея из Южнобережья.‡Darren Malvew aus Southshore will, dass Ihr 8 Berglöwen und 10 titanische Berglöwen tötet.‡사우스쇼어의 다렌 말뷰가 산사자 8마리와 덩치큰 산사자 10마리를 처치해 달라고 부탁했습니다.‡Darren Malvew de Costasur quiere que mates 8 pumas y 10 pumas gigantes.‡Darren Malavista de Costasur quiere que mates 8 leones de montaña y 10 leones de montaña descomunales.‡Darren Malvew de Southshore veut que vous tuiez 8 Lions des montagnes et 10 Lions des montagnes massifs.‡南海镇的达伦·玛尔维要你杀掉8只山地狮和10只巨型山地狮。‡南海鎮的達倫·瑪爾維要妳殺掉8只山地獅和10只巨型山地獅。',
  }
},
[565] = {
  nil,
  { -- Npc
    'Lobo Hediondo Raivoso‡Бешеный лютый волк‡Tollwütiger Terrorwolf‡광포한 그늘숲늑대‡Lobo temible rabioso‡Lobo temible rabioso‡Loup redoutable enragé‡疯狂的恐狼‡瘋狂的恐狼',
    nil,
  },
  nil,
  { -- Quest
    'Manto de Pele de Yeti do Bartolo‡Плащ из меха йети‡Bartolos Yetifellumhang‡바르톨로의 설인 모피 망토‡Capa de piel de yeti de Bartolo‡Capa de piel de yeti de Bartolo‡La cape en fourrure de yéti de Bartolo‡巴图罗的雪人毛皮披风‡巴圖羅的雪人毛皮披風',
    nil,
    'Leve um Rolo de Lã, um Manto do Montanhista, Fio Delicado e 10 chumaços de Pele de Yeti para Bartolo Ginsetti na Costa Sul.‡Принесите Бартоло Джинсетти из Южнобережья рулон шерсти, плащ жителя холмов, тонкую нить и 10 клоков меха йети.‡Bringt Bartolo Ginsetti in Southshore einen Wollstoffballen, einen Umhang des Hügelwächters, feinen Faden und 10 Haufen Yetifell.‡사우스쇼어에 있는 바르톨로 진세티에게 양모 두루마리 1개, 산악인의 망토, 가는 실타래, 그리고 설인 모피 10개를 가져가야 합니다.‡LLeva una bala de lana, una capa de montañero, hilo de alta calidad y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Lleva una madeja de lana, una capa de montañero, hilo refinado y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Apporter à Bartolo Ginsetti de Southshore une Pelote de laine, une Cape d\'homme des collines, du Fil fin et 10 Touffes de fourrure de yéti.‡给南海镇的巴图罗·吉塞提找一个毛布卷、一件山地披风、一股细线和10块雪人的毛皮。‡給南海鎮的巴圖羅·吉塞提找壹個毛布卷、壹件山地披風、壹股細線和10塊雪人的毛皮。',
  }
},
[566] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡維雷克斯',
    nil,
  },
  nil,
  { -- Quest
    'PROCURA-SE: Barão Vardus‡РАЗЫСКИВАЕТСЯ: Барон Вардус‡GESUCHT: Baron Vardus‡바르두스 남작 현상수배‡SE BUSCA: Barón Vardus‡SE BUSCA: Barón Vardus‡ON RECHERCHE : baron Vardus‡通缉：瓦杜斯男爵‡通緝：瓦杜斯男爵',
    nil,
    'Mate o Barão Vardus e entregue a cabeça dele para a Alta-executora Darthalia na Serraria Tarren.‡Убейте барона Вардуса и принесите его голову верховному палачу Дарталии на мельницу Таррен.‡Tötet Baron Vardus und bringt seinen Kopf zu Hochexekutorin Darthalia in Tarrens Mühle.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 타렌 밀농장에 있는 고위집행관 다살리아에게 가져가야 합니다.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Tuer le baron Vardus et apporter sa tête à la Grande Exécutrice Darthalia, au Moulin-de-Tarren.‡杀了瓦杜斯男爵，把他的头带给塔伦米尔的高级执行官达萨利亚。‡殺了瓦杜斯男爵，把他的頭帶給塔倫米爾的高級執行官達薩利亞。',
  }
},
[567] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡黑爪',
    nil,
  },
  nil,
  { -- Quest
    'Perigo!‡Вооружены и очень опасны!‡Gefährlich!‡위험 인물 수배!‡¡Atención!‡¡Atención!‡Dangereux !‡危险！‡危險！',
    nil,
    'A Alta-executora Darthalia da Serraria Tarren está oferecendo uma recompensa pelas cabeças de Tabelião Horácio Brancorcel, Cidadão Urbano, Minerador Talhatudo e a Fazendeira Kalaba.‡Верховный палач Дарталия с мельницы Таррен назначила награду за убийство клерка Горация Белоконя, гражданина Уилкса, шахтера Хакетта и фермерши Калабы.‡Hochexekutorin Darthalia in Tarrens Mühle hat ein Kopfgeld auf Amtmann Horrace Whitesteed, Bürger Wilkes, Minenarbeiter Hackett und Bäuerin Kalaba ausgesetzt.‡타렌 밀농장의 고위집행관 다살리아가 서기관 호레이스 화이트스티드, 민간인 윌키스, 광부 하켓, 농부 칼라바에 현상금을 걸었습니다.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el secretario Horrace Corzalbal, el ciudadano Wilkes, el minero Hackett y el granjero Kalaba.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el funcionario Horraceio Corzalbal, el ciudadano Wilkes, el minero Hackett y la granjera Kalaba.‡La Grande Exécutrice Darthalia de Moulin-de-Tarren offre une prime pour la mort du Commis Horrace Whitesteed, du Citoyen Wilkes, du Mineur Hackett et de Kalaba la fermière.‡塔伦米尔的高级执行官达萨利亚悬赏通缉书记员赫拉斯·怀特斯蒂德、平民维尔克斯、矿工哈克特和农夫卡拉巴。‡塔倫米爾的高級執行官達薩利亞懸賞通緝書記員赫拉斯·懷特斯蒂德、平民維爾克斯、礦工哈克特和農夫卡拉巴。',
  }
},
[568] = {
  nil,
  { -- Npc
    'Guerreiro Umbrapele‡Воин из стаи Темношкуров‡Krieger der Schattenfelle‡잿빛가죽일족 전사‡Guerrero Pielsombra‡Guerrero Pielsombra‡Guerrier Sombrepoil‡暗皮战士‡影皮戰士',
    nil,
  },
  nil,
  { -- Quest
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 15 Raptores Batecauda.‡Командир Агро\'гош из лагеря Гром\'гол поручил вам убить 15 ящеров-кнутохвостов.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 15 Schmetterschwanzraptoren tötet.‡그롬골 주둔지의 사령관 아그로고쉬가 채찍꼬리랩터 15마리를 처치해 달라고 부탁했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 15 Raptors flagellants.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死15只鞭尾迅猛龙。‡格羅姆高營地的指揮官阿格羅戈什要求妳殺死15只鞭尾迅猛龍。',
  }
},
[569] = {
  nil,
  { -- Npc
    'Reclusa Verde‡Зеленый паук-отшельник‡Grüner Eremit‡녹색그늘거미‡Ermitaña verde‡Ermitaña verde‡Solitaire verte‡绿色独行蛛‡綠色獨行蛛',
    nil,
  },
  nil,
  { -- Quest
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 10 Brutamontes Ogros e 5 Mandingueiros Ogros.‡Командир Агро\'гош из лагеря Гром\'гол поручил вам убить 10 огров-громил и 5 огров-знахарей.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 10 Ogerschläger und 5 Ogerhexendoktoren tötet.‡그롬골 주둔지에 있는 사령관 아그로고쉬가 모쉬오그일족 투사 10명과 모쉬오그일족 의술사 5명을 처치해 달라고 부탁했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 10 Brutes et 5 Sorciers ogres.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死10个食人魔蛮兵和5个食人魔巫医。‡格羅姆高營地的指揮官阿格羅戈什要求妳殺死10個食人魔蠻兵和5個食人魔巫醫。',
  }
},
[570] = {
  nil,
  { -- Npc
    'Devora-Cérebros‡Мозгоед‡Hirnfresser‡걸신들린 시체‡Comesesos‡Comesesos‡Mangeur de cervelle‡食脑者‡食腦者',
    nil,
  },
  nil,
  { -- Quest
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin do Acampamento Grom\'gol quer 8 Garras de Umbragorja e uma Presa Imaculada de Tigresa.‡Провозвестник Мок\'тардин из лагеря Гром\'гол попросил вас принести ему 8 когтей тенебрюхих пантер и безупречный тигриный клык.‡Scharfseher Mok\'thardin im Basislager von Grom\'gol will 8 Schattentatzenkrallen und einen makellosen Tigerinnenfangzahn.‡그롬골 기지에 있는 예언자 모크타르딘이 그림자퓨마 발톱 8개와 온전한 암호랑이의 송곳니를 가져다 달라고 부탁했습니다.‡El vidente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombrías y un colmillo de tigresa inmaculado.‡El clarividente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombría y un colmillo de tigresa prístino.‡Le prophète Mok\'thardin du campement Grom\'gol veut que vous trouviez 8 Griffes de panthère Ombregueule et 1 Croc de tigresse en parfait état.‡格罗姆高营地的先知摩克萨尔丁要求你给他带回8只深喉猎豹的爪子和一颗雌虎的牙齿。‡格羅姆高營地的先知摩克薩爾丁要求妳給他帶回8只深喉獵豹的爪子和壹顆雌虎的牙齒。',
  }
},
[571] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve um Tendão de Gorila Velho para o Clarividente Mok\'thardin em Grom\'gol.‡Принесите сухожилие старой гориллы провозвестнику Мок\'тардину в лагерь Гром\'гола.‡Bringt die Sehne eines alten Gorillas zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골에 있는 예언자 모크타르딘에게 덩치큰 고릴라의 힘줄을 가져가야 합니다.‡Lleva un tendón de gorila maduro al vidente Mok\'thardin en Grom\'gol.‡Lleva un tendón de gorila mayor al clarividente Mok\'thardin en Grom\'gol.‡Apporter un Tendon d\'Ancien gorille de Valbrume au Prophète Mok\'thardin à Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回1根成年大猩猩的肌腱。‡給格羅姆高營地的先知摩克薩爾丁帶回1根成年大猩猩的肌腱。',
  }
},
[572] = {
  nil,
  { -- Npc
    'Leprithus‡Лепритус‡Leprithus‡레프리투스‡Leprithus‡Leprithus‡Leprithus‡莱布里萨斯‡萊普利瑟斯',
    nil,
  },
  nil,
  { -- Quest
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve 10 Penas de Espreitador da Selva para o Clarividente Mok\'thardin no Acampamento Grom\'gol.‡Принесите 10 перьев тропических ловцов провозвестнику Мок\'тардину в лагерь Гром\'гол.‡Bringt 10 Dschungelpirscherfedern zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골 주둔지에 있는 예언자 모크타르딘에게 줄무늬정글랩터 깃털 10개를 가져가야 합니다.‡Lleva 10 plumas de acechadores de la jungla al vidente Mok\'thardin en el Campamento Grom\'gol.‡Lleva 10 plumas de acechadores de la selva al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Amener 10 Plumes de Traqueurs de la jungle au Prophète Mok\'thardin au campement Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回10根丛林捕猎者的羽毛。‡給格羅姆高營地的先知摩克薩爾丁帶回10根叢林捕獵者的羽毛。',
  }
},
[573] = {
  nil,
  { -- Npc
    'Ceifador de Inimigos 4000‡Врагорез-4‡Feindschnitter 4000‡전투 절단기 4000‡Siegaenemigos 4000‡Siegaenemigos 4000‡Découpeur 4000‡死神4000型‡死神4000型',
    nil,
  },
  nil,
  { -- Quest
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin de Grom\'gol precisa de Água da Fonte Abençoada. Ele também quer que você mate 10 Exploradores Nagas.‡Провозвестник Мок\'тардин из лагеря Гром\'гол попросил вас принести ему воду Святого источника. Кроме того, он поручил вам убить 10 наг-исследователей.‡Scharfseher Mok\'thardin von Grom\'gol benötigt Wasser der Heiligen Quelle. Er will auch, dass Ihr 10 Forscher der Naga tötet.‡그롬골에 있는 예언자 모크타르딘에게 신성한 샘물을 가져가야 하며 나가 탐험가 10명을 처치해야 합니다.‡El vidente Mok\'thardin de Grom\'gol necesita agua sagrada de manantial. También quiere que mates 10 exploradores naga.‡El clarividente Mok\'thardin de Grom\'gol necesita agua de manantial sagrado. También quiere que mates 10 expedicionarios naga.‡Le Prophète Mok\'thardin de Grom\'gol a besoin d\'Eau de source sacrée. Il veut que vous tuiez aussi 10 Explorateurs nagas.‡格罗姆高营地的先知摩克萨尔丁要你去取回一瓶圣泉之水，同时还要求你杀死10名纳迦探险者。‡格羅姆高營地的先知摩克薩爾丁要妳去取回壹瓶聖泉之水，同時還要求妳殺死10名納迦探險者。',
  }
},
[574] = {
  nil,
  { -- Npc
    'Naraxis‡Нараксис‡Naraxis‡나락시스‡Naraxis‡Naraxis‡Naraxis‡纳拉克西斯‡納拉克西斯',
    nil,
  },
  nil,
  { -- Quest
    'Forças especiais‡Особые войска‡Spezialtruppe‡특수 부대‡Fuerzas especiales‡Fuerzas especiales‡Forces spéciales‡特种部队‡特種部隊',
    nil,
    'Mate 10 Tropas de Choque de Kurzen e 6 Encolhedores de Cabeças de Kurzen.|nFale com o Tenente Doren no Acampamento dos Rebeldes.‡Убейте 10 диверсантов и 6 охотников за головами Курцена.|nДоложите об этом лейтенанту Дорену в Лагере повстанцев.‡Tötet 10 von Kurzens Kommandosoldaten und 6 von Kurzens Kopfschrumpfer.|nErstattet Bericht bei Lieutenant Doren im Rebellenlager.‡쿠르젠 특전사 10명과 쿠르젠 심리학자 6명을 처치해야 합니다.|n반란군 야영지에 있는 부관 도렌에게 보고하십시오.‡Mata 10 comandos Kurzen y 6 reductores de cabezas Kurzen.|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Mata 10 comandos de Kurzen y 6 reductores de cabezas de Kurzen.|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Tuer 10 Commandos et 6 Réducteurs de têtes de Kurzen. Rendre compte au Lieutenant Doren au Camp rebelle.‡杀掉10名库尔森特种兵和6名库尔森精神医师。|n然后向反抗军营地的多伦上尉复命。‡殺掉10名庫爾森特種兵和6名庫爾森精神醫師。|n然後向反抗軍營地的多倫上尉復命。',
  }
},
[575] = {
  nil,
  { -- Npc
    'Elemental do Fogo‡Элементаль огня‡Feuerelementar‡불의 정령‡Elemental de fuego‡Elemental de fuego‡Elémentaire de feu‡火元素‡火元素',
    nil,
  },
  nil,
  { -- Quest
    'Oferta e demanda‡Спрос и предложение‡Angebot und Nachfrage‡민물 악어 가죽‡La oferta y la demanda‡La oferta y la demanda‡L\'offre et la demande‡供与求‡供與求',
    nil,
    'Leve 2 Peles de Crocolisco Grande do Rio para o Drizzlik na Angra do Butim.‡Принесите 2 шкуры большого речного кроколиска Дриззлику из Пиратской бухты.‡Bringt 2 große Flusskrokiliskenhäute zu Drizzlik nach Booty Bay.‡무법항에 있는 드리즐릭에게 민물 악어 가죽 2개를 가져가야 합니다.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Bahía del Botín.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Bahía del Botín.‡Apporter 2 Grandes peaux de crocilisque des rivières à Drizzlik, à Baie-du-Butin.‡收集2张淡水鳄的皮，把它们交给藏宝海湾的崔斯里克。‡收集2張淡水鱷的皮，把它們交給藏寶海灣的崔斯裏克。',
  }
},
[576] = {
  nil,
  { -- Npc
    'Vigia Ladimore‡Дозорный Ладимор‡Behüterin Ladimore‡순찰대원 래디모어‡Vigía Ladimor‡Vigía Ladimor‡Gardienne Ladimore‡守夜人拉迪摩尔‡守夜人拉迪摩爾',
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
  },
  nil,
  { -- Quest
    'Fique de olho‡Смотри в оба‡Ein Auge offen halten‡잃어버린 눈‡¡Ojo!‡¡Ojo!‡Gardez un œil dehors‡海盗的眼睛‡海盜的眼睛',
    nil,
    'Dizzy Caolho da Angra do Butim quer que você recupere seu olho com os Bucaneiros da Vela Sangrenta.‡Диззи Одноглазый из Пиратской бухты попросил вас отобрать его глаз у пиратов Кровавого Паруса.‡Dizzy One-Eye in Booty Bay möchte, dass Ihr sein Auge von den Blutsegelbukanieren zurückholt.‡무법항에 있는 애꾸눈 디지가 붉은해적단에게서 그의 눈을 찾아달라고 부탁했습니다.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los bucaneros Velasangre.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los Bucaneros Velasangre.‡Dizzy le Borgne de Baie-du-Butin veut que vous récupériez son œil chez les boucaniers de la Voile sanglante.‡藏宝海湾的独眼迪兹要求你从血帆海盗那里找回他的眼睛。‡藏寶海灣的獨眼迪茲要求妳從血帆海盜那裏找回他的眼睛。',
  }
},
[577] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Algumas partes faltando‡Добыча шкур‡Etwas Zusammenbau benötigt‡무쇠턱 악어 가죽‡Hay que ensamblar‡Hay que ensamblar‡Un peu d\'assemblage est nécessaire‡收集鳄鱼皮‡收集鱷魚皮',
    nil,
    'Leve 5 Peles de Crocolisco Arapuca para Drizzlik na Angra do Butim.‡Отнесите 5 шкур кроколисков-хрустогрызов Дриззлику в Пиратскую бухту.‡Bringt 5 Schnappkieferkrokiliskenhäute zu Drizzlik nach Booty Bay.‡무법항에 있는 드리즐릭에게 무쇠턱 악어 가죽 5개를 가져가야 합니다.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Apporter 5 Peaux de Gueule d\'acier à Drizzlik, à Baie-du-Butin.‡给藏宝海湾的崔斯里克带回5张钳嘴鳄鱼的皮。‡給藏寶海灣的崔斯裏克帶回5張鉗嘴鱷魚的皮。',
  }
},
[578] = {
  nil,
  { -- Npc
    'Batedor Murloc‡Мурлок-разведчик‡Murlocspäher‡멀록 정찰병‡Explorador múrloc‡Explorador múrloc‡Eclaireur murloc‡鱼人斥候‡魚人斥候',
    nil,
