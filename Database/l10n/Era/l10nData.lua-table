[109] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡白色龍裔',
    nil,
  },
  -- Object
  '‡Западный Край‡‡서부 몰락지대‡Páramos de Poniente‡Páramos de Poniente‡Marche de l\'Ouest‡西部荒野‡西部荒野',
  { -- Quest
    'Fale com Miguel Mantoforte‡Доклад Гриану Камнегриву‡Meldung bei Gryan Stoutmantle‡그라이언 스타우트맨틀에게 보고‡Habla con Gryan Mantorrecio‡Habla con Gryan Mantorrecio‡Aller voir Gryan Stoutmantle‡向格里安·斯托曼报到‡向格裏安·斯托曼報到',
    nil,
    'Fale com Miguel Mantoforte. Ele costuma ficar na torre de pedras do Morro da Sentinela, perto da estrada central do Cerro Oeste.‡Поговорите с Грианом Камнегривом. Обычно его можно найти в башне, что на Сторожевом холме, у дороги, в самом сердце Западного Края.‡Sprecht mit Gryan Stoutmantle. Normalerweise findet man ihn im Steinturm auf der Späherkuppe, ein kleines Stückchen von der Straße weg, mitten in Westfall.‡그라이언 스타우트맨틀과 대화해야 합니다. 서부 몰락지대의 중심부에서 길을 약간 벗어난 곳에 있는 감시의 언덕 돌탑으로 가면 그를 만날 수 있습니다.‡Habla con Gryan Mantorrecio. Puedes encontrarlo en la torre de piedra de la Colina del Centinela, saliendo de la carretera que cruza los Páramos de Poniente.‡Habla con Gryan Mantorrecio. Puedes encontrarlo en la torre de piedra de la Colina del Centinela, saliendo de la carretera que cruza los Páramos de Poniente.‡Parler à Gryan Stoutmantle. Il se trouve à la Tour de pierre sur la Colline des sentinelles, près la route au centre de la marche de l\'Ouest.‡去和格里安·斯托曼谈一谈，他一般就在哨兵岭的石塔旁，这座石塔位于西部荒野中部地区的路边。‡去和格裏安·斯托曼談壹談，他壹般就在哨兵嶺的石塔旁，這座石塔位於西部荒野中部地區的路邊。',
  }
},
