  nil,
  { -- Quest
    'Irmão Paxeco‡Брат Пакстон‡Bruder Paxton‡수사 팩스턴‡Hermano Paxton‡Hermano Paxton‡Frère Paxton‡帕克斯顿修士‡帕克斯頓修士',
    nil,
    'Fale com o Irmão Paxeco na Abadia de Vila Norte.‡Поговорите с братом Пакстоном из Аббатства Североземья.‡Sprecht mit Bruder Paxton in der Abtei von Nordhain.‡노스샤이어 수도원에 있는 수사 팩스턴과 대화해야 합니다.‡Habla con el hermano Paxton en la Abadía de Villanorte.‡Habla con el hermano Paxton en la Abadía de Villanorte.‡Parler au frère Paxton, à l\'Abbaye du Northshire.‡与北郡修道院的帕克斯顿修士谈一谈。‡與北郡修道院的帕克斯頓修士談壹談。',
  }
},
[345] = {
  nil,
  { -- Npc
    'Ronquifuça‡Грубобрюх‡Stopfwanst‡서리먹보‡Panzallena‡Panzallena‡Fouailleventre‡贝利格拉布‡貝利格拉布',
    nil,
  },
  nil,
  { -- Quest
    'Estoque de tinta‡Запас чернил‡Tinten-Zutaten‡잉크 공급‡Suministros de tinta‡Suministros de tinta‡Provisions d\'encre‡墨水短缺‡墨水短缺',
    nil,
    'Fale com o Encarregado Oslow em Vila Plácida e peça-lhe Minério de Ferro Retibano.‡Поговорите со штейгером Ослоу из Озер и расспросите его о ретбанской руде.‡Sprecht mit Großknecht Oslow in Seenhain und fragt ihn nach Rethbaneisenerz.‡레이크샤이어에 있는 현장감독 오슬로우와 대화하여 레스밴 철광석을 달라고 부탁해야 합니다.‡Habla con el supervisor Oslow en Villa del Lago y pregúntale sobre el mineral de hierro de Rethban.‡Habla con el supervisor Olento en Villa del Lago y pregúntale sobre el mineral de hierro de Rethban.‡Aller voir le contremaître Oslow de Lakeshire et lui demander du minerai de rethban.‡与湖畔镇的工头奥斯洛交谈，并向他要一些瑞斯班矿石。‡與湖畔鎮的工頭奧斯洛交談，並向他要壹些瑞斯班礦石。',
  }
},
[346] = {
  nil,
  { -- Npc
    'Taberneiro Daniel‡Кабатчик Дэниэлс‡Barkeeper Daniels‡바텐더 대니얼스‡Posadero Daniels‡Posadero Daniels‡Tavernier Daniels‡酒吧老板丹尼尔‡酒吧老闆丹尼爾',
    nil,
  },
  nil,
  { -- Quest
    'De novo com Kristoff‡Возвращение к Кристофу‡Rückkehr zu Kristoff‡수사 크리스포트에게로‡Vuelve con Kristoff‡Regresa junto a Kristoff‡Retourner voir Frère Kristoff‡克里斯托弗的书‡克裏斯托弗的書',
    nil,
    'Fale novamente com Irmão Kristoff na Praça da Catedral. Dê a ele o livro Fadigas do Ferro.‡Вернитесь к брату Кристофу на Соборную площадь. Отдайте ему книгу "Как закалялось железо".‡Kehrt zu Bruder Kristoff auf den Kathedralenplatz zurück. Gebt ihm das Buch: "Belastbarkeit von Eisen".‡대성당 광장에 있는 수사 크리스토프에게 돌아가서 \'철강의 중요성\'을 전달해야 합니다.‡Vuelve a hablar con el hermano Kristoff en la Plaza de la Catedral. Entrégale el libro La tensión del hierro.‡Vuelve a hablar con el hermano Kristoff en la Plaza de la Catedral. Entrégale el libro La tensión del hierro.‡Retourner voir Frère Kristoff sur la Place de la Cathédrale. Lui donner le livre « les Tensions du fer ».‡回到教堂广场，将《金属的延展性》交给克里斯托弗修士。‡回到教堂廣場，將《金屬的延展性》交給克裏斯托弗修士。',
  }
},
[347] = {
  nil,
  { -- Npc
    'Grislo Meiajuba‡Седынь Полушкур‡Grizzle Halfmane‡그리즐 하프메인‡Osco Mediamelena‡Osco Mediamelena‡Grizzle Halfmane‡格里兹尔‡格里茲爾·半鬃',
    'Mestre de Batalha do Vale Alterac‡Военачальник Альтеракской долины‡Kampfmeister des Alteractals‡알터랙 계곡 전투모병관‡Maestro de batalla del Valle de Alterac‡Maestro de batalla del Valle de Alterac‡Maître de guerre de la vallée d\'Alterac‡奥特兰克山谷军官‡奧特蘭克山谷戰場軍官',
  },
  nil,
  { -- Quest
    'Minério Retibano‡Ретбанская руда‡Rethbanerz‡레스밴 광석‡Mineral de Rethban‡La mena de Rethban‡Minerai de rethban‡瑞斯班矿石‡瑞斯班礦石',
    nil,
    'Colete 5 porções de Minério Retibano e leve-as para o Irmão Paxeco na biblioteca de Vila Norte.‡Добудьте 5 кусков ретбанской руды и принесите их брату Пакстону в библиотеку Североземского аббатства.‡Sammelt 5 Fuhren Rethbanerz und bringt sie Bruder Paxton in der Bibliothek von Nordhain.‡레스밴 광석 5개를 모아서 노스샤이어 도서관에 있는 수사 팩스턴에게 가져가야 합니다.‡Reúne 5 montones de mineral de hierro de Rethban y llévaselos al hermano Paxton en la biblioteca de Villanorte.‡Reúne 5 montones de mineral de hierro de Rethban y llévaselos al hermano Paxton en la biblioteca de Villanorte.‡Réunir 5 charges de Minerai de rethban et les apporter à Frère Paxton à la bibliothèque du Northshire.‡收集5袋瑞斯班矿石，把它们带给北郡图书馆的帕克斯顿修士。‡收集5袋瑞斯班礦石，把它們帶給北郡圖書館的帕克斯頓修士。',
  }
},
[348] = {
  nil,
  { -- Npc
    'Zenha Lucardo‡Зем Ливард‡Zem Leeward‡젬 리워드‡Zem Leeward‡Zem Leeward‡Zem Leeward‡泽姆·里瓦尔德‡澤姆·里瓦爾德',
    nil,
