[8469] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Contas para Salfa‡Бусы для Сальфы‡Perlen für Salfa‡살파에게 정기의 구슬 가져다주기‡Cuentas para Salfa‡Cuentas para Salfa‡Des perles pour Salfa‡给萨尔法的珠串‡給薩爾法的珠串',
    nil,
    '‡‡Bringt die Geisterperlen, die Ihr findet, zu Salsa.‡‡‡‡‡‡',
  }
},
[8470] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Totem ritual de Lenha Morta‡Ритуальный тотем Мертвого Леса‡Ritualtotem der Totenwaldfelle‡마른가지일족 의식의 토템‡El tótem ritual de los Muertobosque‡El tótem de ritual Muertobosque‡Le totem rituel des Mort-bois‡死木仪祭图腾‡死木儀祭圖騰',
    nil,
    'Leve o Totem Ritual de Lenha Morta para dentro do Domínio dos Presamatos e veja se um dos pelursos dali tem alguma utilidade para o artefato. Os Presamatos não lhe dirigirão a palavra a não ser que você tenha alcançado, no mínimo, a reputação de <tolerado/tolerada> entre eles.‡Отнесите ритуальный тотем Мертвого Леса в Крепость Древобрюхов и посмотрите, не пригодится ли этот предмет кому из тамошних фурболгов. Фурболги Крепости Древобрюхов не станут говорить с вами – разве что их отношение к вам нейтральное или лучше.‡Bringt das Ritualtotem in die Holzschlundfeste und findet heraus, ob einer der dortigen Furbolgs eine Verwendung für diesen Gegenstand hat. Die Furlbolgs der Holzschlundfeste werden solange nicht mit Euch sprechen, bis Euer Ruf bei ihnen neutral oder höher ist.‡나무구렁 요새 안으로 마른가지일족 의식의 토템을 가지고 가서 그 용도를 알아낼 수 있는 펄볼그를 찾아야 합니다. 중립적 이상의 평판을 받아야만 나무구렁일족과 대화할 수 있습니다.‡Lleva el tótem ritual Muertobosque al interior del Bastión de los Fauces de Madera. A ver si alguno de los furbolgs que hay en él sabe dar uso al objeto. Los Fauces de Madera no hablarán contigo si no tienes un nivel de reputación neutral o superior con ellos.‡Lleva el tótem de ritual Muertobosque al interior del Bastión Fauces de Madera. A ver si alguno de los fúrbolgs que hay en él sabe dar uso al objeto. Los Fauces de Madera no hablarán contigo si no tienes un nivel de reputación neutral o superior con ellos.‡Amener le Totem rituel mort-bois à l’intérieur du repaire des Grumegueules et voir si l’un des furbolgs qui s’y trouvent est capable d’en faire quelque chose. Les Grumegueules ne vous adresseront pas la parole s’ils ne sont pas Neutres à votre égard, au minimum.‡把死木仪祭图腾拿到木喉要塞去，看看是否有熊怪想要研究一下它。只有当你在木喉要塞的声望达到中立或者更高级别的时候，木喉要塞的熊怪才会和你说话。‡把死木儀祭圖騰拿到木喉要塞去，看看是否有熊怪想要研究壹下它。只有當妳在木喉要塞的聲望達到中立或者更高級別的時候，木喉要塞的熊怪才會和妳說話。',
  }
},
[8471] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Totem Ritual Invernoso‡Ритуальный тотем Зимней Спячки‡Ritualtotem der Winterfelle‡눈사태일족 의식의 토템‡Tótem ritual Nevada‡Tótem de ritual Nevada‡Le totem rituel des Tombe-hiver‡冬泉仪祭图腾‡冬泉儀祭圖騰',
    nil,
    'Leve o Totem Ritual Invernoso para dentro do Domínio dos Presamatos e veja se um dos pelursos dali tem alguma utilidade para o artefato. Os Presamatos não lhe dirigirão a palavra a não ser que você tenha alcançado, no mínimo, a reputação de <tolerado/tolerada> entre eles.‡Отнесите ритуальный тотем Зимней Спячки в берлогу Древобрюхов и отдайте его фурболгу, который им заинтересуется. Никто из племени Древобрюхов не заговорит с вами, пока вы не завоюете себе среди них достойную репутацию.‡Bringt das Ritualtotem in die Holzschlundfeste und findet heraus, ob einer der dortigen Furbolgs eine Verwendung für diesen Gegenstand hat. Die Furlbolgs der Holzschlundfeste werden solange nicht mit Euch sprechen, bis Euer Ruf bei ihnen neutral oder höher ist.‡나무구렁 요새 안으로 가서 눈사태일족 의식의 토템의 용도를 알아낼 수 있는 펄볼그를 찾아야 합니다. 중립적 이상의 평판을 받아야만 나무구렁일족과 대화할 수 있습니다.‡Lleva el tótem ritual Nevada al Bastión de los Fauces de Madera y averigua si alguno de los furbolgs sabe de su utilidad. Los Fauces de Madera no hablarán contigo si tu reputación con ellos no es como mínimo de neutral.‡Lleva el tótem de ritual Nevada al Bastión Fauces de Madera y averigua si alguno de los fúrbolgs sabe de su utilidad. Los Fauces de Madera no hablarán contigo si tu reputación con ellos no es como mínimo de neutral.‡Emportez le totem rituel Tombe-hiver au Repaire des Grumegueules et voyez si l’un des furbolgs lui trouve une utilisation. Les Grumegueules ne vous parleront pas si vous n’avez pas à leur égard une réputation Neutre au minimum.‡把冬泉仪祭图腾拿到木喉要塞去，看看是否有熊怪想要研究一下它。只有当你在木喉要塞的声望达到中立或者更高级别的时候，木喉要塞的熊怪才会和你说话。‡把冬泉儀祭圖騰拿到木喉要塞去，看看是否有熊怪想要研究壹下它。只有當妳在木喉要塞的聲望達到中立或者更高級別的時候，木喉要塞的熊怪才會和妳說話。',
  }
},
