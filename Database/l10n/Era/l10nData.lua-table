  nil,
  { -- Quest
    'Invasão de gnolls‡Вторжение гноллов‡Eindringende Gnolle‡놀 침략자‡Gnolls invasores‡Gnolls invasores‡Des gnolls encombrants‡豺狼人的入侵‡豺狼人的入侵',
    nil,
    'Fale com o Subdelegado David.‡Поговорите с заместителем судьи Фелдоном.‡Erstattet Deputy Feldon Bericht.‡부관 펠던에게 보고해야 합니다.‡Preséntate ante el ayudante Feldon.‡Preséntate ante el ayudante de alguacil Feldon.‡Informer l’Adjoint Feldon.‡找到菲尔顿副队长。‡找到菲爾頓副隊長。',
  }
},
[245] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ameaças de oito patas‡Восьминогая угроза‡Gefahr auf acht Beinen‡거미의 위협‡Las amenazas de ocho patas‡Las amenazas de ocho patas‡Les plaies à huit pattes‡蜘蛛的威胁‡蜘蛛的威脅',
    nil,
    'Mate 15 Veneracnas Pigmeias, e depois apresente-se novamente ao Vigia Gouveia na Floresta do Crepúsculo.‡Убейте 15 карликовых ядовитых кругопрядов и доложите об этом дозорному Додсу в Сумеречном лесу.‡Erledigt 15 Zwerggiftweberspinnen und meldet Euch dann wieder bei Behüter Dodds im Dämmerwald.‡새끼 그물독거미 15마리를 처치한 후 그늘숲에 있는 순찰대원 도즈에게 보고해야 합니다.‡Mata a 15 telarácnidas pigmeovenenosas y vuelve al Bosque del Ocaso a informar al vigilante Dodds.‡Mata a 15 telarácnidas pigmeovenenosas y vuelve al Bosque del Ocaso a informar al vigía Dodds.‡Tuer 15 Araignées Tisse-venin pygmées, puis rendre compte à la Sentinelle Dodds au bois de la Pénombre.‡守夜人道茨要你杀15只小型结网毒蜘蛛。‡守夜人道茨要妳殺15只小型結網毒蜘蛛。',
  }
},
[246] = {
  nil,
  { -- Npc
    '"Titia" Berenice Campedra‡"Тетушка" Бернис Стоунфилд‡Tantchen Bernice Stonefield‡보모 버니스 스톤필드‡"Tía" Bernice Pedregosa‡"Tita" Bernice Pedregosa‡"Tatie" Bernice Stonefield‡波尼斯·斯通菲尔德姑妈‡波尼斯·斯通菲爾德姑媽',
    nil,
  },
  nil,
  { -- Quest
    'Avaliando a ameaça‡Подсчет врагов‡Einschätzung der Gefahr‡탐색전‡Evaluar la amenaza‡Evaluar la amenaza‡L\'appréciation du danger‡审时度势‡審時度勢',
    nil,
    'Mate 10 Mestiços de Cristarrubra e 6 Caçadores Ilegais de Cristarrubra, e então apresente-se novamente ao Subdelegado David em Vila Plácida.‡Убейте 10 полукровок из стаи Красногорья и 6 браконьеров из стаи Красногорья и сообщить об этом заместителю судьи Фелдону в Приозерье.‡Tötet 10 Bastarde der Rotkammgnolle und 6 Wilderer der Rotkammgnolle und meldet Euch anschließend wieder bei Deputy Feldon in Seenhain.‡붉은마루일족 싸움꾼 10마리, 붉은마루일족 밀렵꾼 6마리를 처치하고 레이크샤이어에 있는 부관 펠던에게 돌아가 보고해야 합니다.‡Mata a 10 bastardos y 6 furtivos Crestagrana e informa al ayudante Feldon en Villa del Lago.‡Mata a 10 bastardos y 6 furtivos Crestagrana e informa al ayudante de alguacil Feldon en Villa del Lago.‡Tuer 10 Bâtards des Carmines et 6 Braconniers des Carmines, et aller faire un rapport à l’Adjoint Feldon à Lakeshire.‡杀死10个混血赤脊山豺狼人和6个赤脊山偷猎者，然后向湖畔镇的菲尔顿副队长复命。‡殺死10個混血赤脊山豺狼人和6個赤脊山偷獵者，然後向湖畔鎮的菲爾頓副隊長復命。',
  }
},
[247] = {
