[4001] = {
  -- Item
  '‡Переплетенные кольчужные сапоги‡Doppelverbundkettenstiefel‡격자 사슬 장화‡Botas de anillas superpuestas‡Botas de anillas superpuestas‡Bottes en anneaux doubliers‡脱环的链甲战靴‡脫環鍊甲長靴',
  { -- Npc
    'Ratatúnel de Cortavento‡Туннельщик из племени Ветрорезов‡Tunnelratte der Scherwindmine‡칼바람 코볼트‡Rata de túnel Cortaviento‡Rata de túnel Cortaviento‡Rat des tunnels des Cisailles‡风剪坑道鼠‡風剪坑道鼠',
    nil,
  },
  nil,
  { -- Quest
    'O que está acontecendo?‡Что происходит?‡Was ist los?‡사태 파악‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡出了什麽事？',
    nil,
    'Fale com Kharan Feromalho para obter informações sobre o sequestro da Princesa Moira Barbabronze. Leve as informações para Thrall em Orgrimmar.|nGor\'shak mencionou que Kharan estava preso em uma cela próxima.‡Поговорите с дворфом по имени Каран Могучий Молот и соберите информацию о похищении принцессы Мойры Бронзобород. Передайте информацию Траллу в Оргриммар.|nКарана держат в темнице напротив.‡Sprecht mit Kharan Mighthammer und sammelt Informationen über die Entführung von Prinzessin Moira Bronzebeard. Bringt diese Informationen dann zu Thrall nach Orgrimmar.|nIhr erinnert Euch, dass Gor\'shak gesagt hat, Kharan werde in einer Zelle in seiner Nähe festgehalten.‡카란 마이트해머와 대화하여 공주 모이라 브론즈비어드의 납치에 대한 정보를 모은 후, 그 정보를 오그리마에 있는 스랄에게 가져가야 합니다.|n고르샤크가 카란이 근처 감방에 갇혀 있다고 말했던 것이 기억납니다.‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar. Recuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.|n‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar.|nRecuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.‡Parler à Kharan Mighthammer et obtenir autant de renseignements que possible sur l\'enlèvement de la princesse Moira Bronzebeard. Apporter ces renseignements à Thrall à Orgrimmar.|nGor\'shak a dit que Kharan était détenu dans une cellule proche.‡与卡兰·巨锤谈一谈，收集关于绑架公主铁炉堡公主茉艾拉·铜须这一事件的情报。将情报反馈给奥格瑞玛城里的萨尔。|n哥沙克提到过卡兰被关在附近的某个牢房中。‡與卡蘭·巨錘談壹談，收集關於綁架公主鐵爐堡公主茉艾拉·銅須這壹事件的情報。將情報反饋給奧格瑞瑪城裏的薩爾。|n哥沙克提到過卡蘭被關在附近的某個牢房中。',
  }
},
[4002] = {
  -- Item
  '‡Переплетенные кольчужные наручи‡Doppelverbundkettenarmschienen‡격자 사슬 팔보호구‡Brazales de anillas superpuestas‡Brazales de anillas superpuestas‡Brassards en anneaux doubliers‡脱环的链甲护腕‡脫環鍊甲護腕',
  { -- Npc
    'Talhador de Cortavento‡Камнерез из племени Ветрорезов‡Steinfräser der Scherwindmine‡칼바람일족 석공‡Cortapiedras Cortaviento‡Cortapiedras Cortaviento‡Tailleur de pierre des Cisailles‡风剪凿石者‡風剪鑿石者',
    nil,
  },
  nil,
  { -- Quest
    'Os Reinos do Leste‡Восточные королевства‡Das östliche Königreich‡동부 왕국‡Los Reinos del Este‡Los Reinos del Este‡Les Royaumes de l\'est‡东部王国‡東部王國',
    nil,
    'Fale com Thrall se estiver <preparado/preparada> para assumir a missão que ele planejou.‡Поговорите с Траллом.‡Sprecht mit Thrall, wenn Ihr bereit seid, die von ihm geplante Mission zu übernehmen.‡스랄이 계획한 임무를 맡을 준비가 되었으면 스랄과 다시 한번 대화하십시오.‡Si aceptas la misión, habla con Thrall.‡Si aceptas la misión, habla con Thrall.‡Parler à Thrall si vous êtes <prêt/prête> à vous charger de la mission qu\'il a prévue.‡如果你准备好要接受萨尔所安排的任务，就去找他谈一谈。‡如果妳準備好要接受薩爾所安排的任務，就去找他談壹談。',
  }
},
[4003] = {
  -- Item
  '‡Переплетенный кольчужный плащ‡Doppelverbundkettenumhang‡격자 사슬 망토‡Capa de anillas superpuestas‡Capa de anillas superpuestas‡Cape en anneaux doubliers‡脱环的链甲披风‡脫環鍊甲披風',
  { -- Npc
    'Geomante de Cortavento‡Геомант из племени Ветрорезов‡Geomant der Scherwindmine‡칼바람일족 흙점쟁이‡Geomántico Cortaviento‡Geomántico Cortaviento‡Géomancien des Cisailles‡风剪地占师‡風剪地卜師',
    nil,
  },
  nil,
  { -- Quest
    'O resgate real‡Спасение принцессы‡Die königliche Rettung‡공주 구출‡El rescate real‡El rescate real‡Un sauvetage royal‡拯救公主‡拯救公主',
    nil,
    'Mate o Imperador Dagran Thaurissan e liberte a Princesa Moira Barbabronze do feitiço maligno.‡Убейте императора Даграна Тауриссана и освободите принцессу Мойру Бронзобород от его черного заклятия.‡Tötet Imperator Dagran Thaurissan und befreit Prinzessin Moira Bronzebeard von seinem bösen Zauber.‡제왕 다그란 타우릿산을 처치하고 그의 사악한 마법에서 공주 모이라 브론즈비어드를 해방시켜야 합니다.‡Mata al emperador Dagran Thaurissan para liberar a la princesa Barbabronce del hechizo.‡Mata al emperador Dagran Thaurissan para liberar a la princesa Moira Barbabronce del hechizo.‡Tuer l\'Empereur Thaurissan et libérer la princesse Moira Bronzebeard de son sort maléfique.‡杀掉达格兰·索瑞森大帝，然后将铁炉堡公主茉艾拉·铜须从他的邪恶诅咒中拯救出来。‡殺掉達格蘭·索瑞森大帝，然後將鐵爐堡公主茉艾拉·銅須從他的邪惡詛咒中拯救出來。',
  }
},
