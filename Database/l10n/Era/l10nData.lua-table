[7721] = {
  -- Item
  '‡Рука праведности‡Hand der Rechtschaffenheit‡정의의 망치‡Mano de Rectitud‡Mano de Rectitud‡Main de la droiture‡公正之手‡公正之手',
  nil,
  nil,
  { -- Quest
    'Bota dez aí, chefia!‡Энергия для уменьшения‡Treibstoff fürs Schrumpfen‡변환을 위한 연료‡Combustible para el Ultra-reductor‡Combustible para el Ultra-reductor‡Du carburant pour la zappette‡压缩器的动力‡壓縮器的動力',
    nil,
    'Colete 10 Âmagos dos Elementais de Água dos Elementais do Mar e dos Borrifos do Mar ao longo da Costa Esquecida de Feralas, e leve-os para Zorbin Cegasvista, próximo às docas.‡Соберите 10 ядер элементалей воды, убивая морских элементалей и морских валов на Забытом берегу в Фераласе, и принесите их Зорбину Дребезгуну, который находится неподалеку от порта.‡Sammelt 10 Wasserelementarkerne von den Meereselementaren und Meeresschauern entlang der Vergessenen Küste von Feralas und bringt sie zurück zu Zorbin Fandazzle in der Nähe des dortigen Docks.‡페랄라스의 잊혀진 해안에 있는 바다 정령과 바다 물보라 정령에게서 물의 정령 핵 10개를 모아 부두 근처에 있는 조브린 팬대즐에게 가져가야 합니다.‡Reúne 10 núcleos de elemental de agua de los elementales marinos y los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Ventipnotizador, que está cerca del embarcadero.‡Reúne 10 núcleos de elemental de agua de los elementales marinos y de los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Hipnoviento, que está cerca del embarcadero.‡Récupérez 10 Noyaux élémentaires d\'eau sur les Elémentaires marins et les Embruns le long de la Côte oubliée de Feralas, et rapportez-les à Zorbin Fandazzle, près du quai là-bas.‡从菲拉斯被遗忘的海岸那里的海元素和巨型海元素身上获取10块水元素核心，把它们交给码头附近的索尔宾·范达瑟。‡從菲拉斯被遺忘的海岸那裏的海元素和巨型海元素身上獲取10塊水元素核心，把它們交給碼頭附近的索爾賓·範達瑟。',
  }
},
[7722] = {
  -- Item
  '‡Амулет Тройного союза‡Triunenamulett‡삼위일체의 아뮬렛‡Amuleto Triune‡Amuleto Triune‡Amulette de Triune‡圣使护符‡聖使護符',
  nil,
  nil,
  { -- Quest
    'Segue o fluxo‡Какой еще плавень?‡Was zum Fluxus?!‡불꽃 융해촉진제?‡La receta del fluido ardiente‡¿Qué pasa con el flujo?‡Le Flux embrasé‡绝密配方！‡絕密配方！',
    nil,
    'Em algum lugar do Fosso de Lava do Caldeirão você encontra as Instruções Secretas: Fluxo Ígneo que o Feitor Maltorius roubou. Encontre as instruções e devolva-as ao Mestre Ferreiro Queimatar na Garganta Abrasadora.‡Верните секретные документы по изготовлению огненного плавня, украденные надзирателем Мальториусом. Инспектор скорее всего находится в Шлаковой Яме в Котле. Документы верните мастеру-кузнецу Гориврату в Тлеющем ущелье.‡Irgendwo in der Schlackengrube des Kessels findet Ihr die geheimen Pläne des Feurigen Fluxus, die der Aufseher Maltorius stahl. Findet diese Pläne und bringt sie zurück zu Meisterschmied Burninate in der sengenden Schlucht.‡용광로의 잿가루 채석장 어딘가에 감독관 말토류스가 훔친 비밀조제법: 불꽃 융해촉진제가 있을 것입니다. 이 조제법을 찾아서 이글거리는 협곡에 있는 수석대장장이 버니네이트에게 가져가야 합니다.‡Busca la receta de fluido ardiente robada por el vigía Maltorius en la La Fosa de la Escoria de La Caldera. Llévasela al maestro herrero Cremación a La Garganta de Fuego.‡Busca los diseños secretos: flujo ígneo robados por el sobrestante Maltorius en La Fosa de la Escoria de La Caldera. Llévaselos al herrero maestro Burninate a La Garganta de Fuego.‡Quelque part dans la Fosse aux scories du Chaudron, vous trouverez les Plans secrets : Flux embrasé dérobés par le surveillant Maltorius. Trouvez ces plans et rapportez-les au Maître forgeron Burninate dans la gorge des Vents brûlants.‡在大熔炉的熔渣之池中的某个地方，你可以找到工头玛托留斯偷走的秘密设计图：炽热助熔剂。找到这些设计图，把它们还给灼热峡谷的大铁匠博恩奈特。‡在大熔爐的熔渣之池中的某個地方，妳可以找到工頭瑪托留斯偷走的秘密設計圖：熾熱助熔劑。找到這些設計圖，把它們還給灼熱峽谷的大鐵匠博恩奈特。',
  }
},
[7723] = {
  -- Item
  '‡Мощь Могрейна‡Mograines Macht‡모그레인의 철퇴‡Poderío de Mograine‡Poderío de Mograine‡Puissance de Mograine‡莫格莱尼的力量‡莫格萊尼的力量',
  nil,
  nil,
  { -- Quest
    'Malditos dedos gordos‡Отекшие пальцы‡Verdammt seien diese fetten Finger‡두꺼운 손가락의 슬픔‡¡Malditos dedos gordos!‡¡Malditos dedos gordos!‡Maudits gros doigts‡该死的手指头！‡該死的手指頭！',
    nil,
    'Hansel Mão-pesada quer que você mate 20 Golens de Guerra Pesados.|nOs Golens de Guerra Pesados perambulam pelas áreas em torno do Caldeirão, na Garganta Abrasadora. Quando tiver matado a quantidade necessária, fale novamente com Hansel na Garganta Abrasadora.‡По поручению Хансела Большерука убейте 20 тяжелых боевых големов, которых можно найти в землях, окружающих Котел в Тлеющем ущелье. По выполнении задания вернитесь к Ханселу.‡Hansel Heavyhands möchte, dass Ihr 20 Schwere Kriegsgolems tötet.|nDie Schweren Kriegsgolems wandern in der Gegend um den Kessel in der sengenden Schlucht herum. Sobald Ihr genug getötet habt, kehrt zu Hansel zurück.‡이글거리는 협곡의 용광로 주변을 돌아다니는 육중한 전투골렘 20마리를 처치하고 임무를 완수하면 이글거리는 협곡에 있는 한셀 헤비핸드에게 돌아가야 합니다.‡Hansel Manospesadas quiere que mates 20 golems de guerra pesados.|nSuelen estar cerca de La Caldera en La Garganta de Fuego. Después ve a ver a Hansel.‡Hansel Manospesadas quiere que mates 20 gólems de guerra pesados.|nSuelen estar cerca de La Caldera en La Garganta de Fuego. Después ve a ver a Hansel a La Garganta de Fuego.‡Hansel Heavyhands veut que vous tuiez 20 Golems de guerre lourds.|nLes golems de guerre lourds errent dans les régions qui entourent le Chaudron dans la Gorge des Vents brûlants. Quand vous en aurez tué assez, revenez voir Hansel dans la Gorge des Vents brûlants.‡汉瑟尔·重拳让你杀掉20个重型作战傀儡。|n重型作战傀儡就在灼热峡谷的大熔炉附近。当你杀死足够多的傀儡后，就回去找汉瑟尔·重拳。‡漢瑟爾·重拳讓妳殺掉20個重型作戰傀儡。|n重型作戰傀儡就在灼熱峽谷的大熔爐附近。當妳殺死足夠多的傀儡後，就回去找漢瑟爾·重拳。',
  }
},
[7724] = {
  -- Item
  '‡Рукавицы Божественности‡Stulpen der Offenbarung‡천상의 건틀릿‡Guanteletes de divinidad‡Guanteletes de divinidad‡Gantelets de divinité‡神圣护手‡神聖護手',
  { -- Npc
    'Topógrafo Sênior Secamolha‡Старший геодезист Рудознатец‡Leitender Feldmesser Fizzledowser‡선임측량사 피즐도저‡Perito jefe Picoflojo‡Perito jefe Picoflojo‡Grand Géomètre Fizzledowser‡高级勘探员菲兹杜瑟‡高級勘探員菲茲杜瑟',
    'Cia. Águas de Geringontzan‡Компания "Воды Прибамбасска"‡Gadgetzan Water Co.‡가젯잔 수자원개발회사‡Compañía de aguas de Gadgetzan‡Compañía de aguas de Gadgetzan‡Co. des Eaux Gadgetzan‡加基森水业公司‡加基森水業公司',
  },
  nil,
  { -- Quest
    'Toco cru pegando fogo‡Огненная угроза‡Feurige Bedrohung!‡뒤꽁무니에서 불을 뿜는 거미‡Amenaza abrasadora‡Amenaza abrasadora‡Une menace incandescente‡熔岩蜘蛛的威胁！‡熔巖蜘蛛的威脅！',
    nil,
    'Hansel Mão-pesada quer que você mate 20 Grandes Aranhas de Lava na Garganta Abrasadora. Você pode encontrá-las nos platôs e poços de lava do local.|nDepois de matar as Grandes Aranhas de Lava, fale novamente com Hansel Mão-pesada na Garganta Abrasadora.‡По указанию Хансела Большерука убейте 20 больших лавовых пауков в Тлеющем ущелье. Пауки водятся на вулканических плато и в озерах лавы в Тлеющем ущелье.|nкогда убьете достаточно пауков, вернитесь к Ханселу.‡Hansel Heavyhands möchte, dass Ihr 20 große Lavaspinnen in der sengenden Schlucht tötet.|nDie großen Lavaspinnen findet Ihr auf den Plateaus und in den Lavabecken der segenden Schlucht. Sobald Ihr genug getötet habt, kehrt zu Hansel zurück.‡이글거리는 협곡의 고원과 용암 지대에서 서식하는 거대한 용암거미 20마리를 처치한 후, 이글거리는 협곡에 있는 한셀 헤비핸드에게 돌아가야 합니다.‡Hansel Manospesadas quiere que mates 20 lavarañas mayores en La Garganta de Fuego. Las encontrarás en los estanques de lava.|nDespués ve a ver a Hansel Manospesadas.‡Hansel Manospesadas quiere que mates 20 arañas de lava superiores en La Garganta de Fuego. Las encontrarás en las mesetas y los estanques de lava de La Garganta de Fuego.|nCuando hayas matado suficientes arañas de lava superiores ve a ver a Hansel Manospesadas a La Garganta de Fuego.‡Hansel Heavyhands veut que vous tuiez 20 Grandes araignées de lave dans la gorge des Vents brûlants. Vous pouvez trouver les Grandes araignées de lave dans les plateaux et les mares de lave de la gorge des Vents brûlants.|nRevenez voir Hansel dans la gorge des Vents brûlants quand vous aurez tué assez de Grandes araignées de lave.‡汉瑟尔·重拳要你杀死灼热峡谷中的20只巨型熔岩蜘蛛。你可以在灼热峡谷的高地和熔岩池里找到巨型熔岩蜘蛛。|n当你杀死足够的巨型熔岩蜘蛛之后，回到汉瑟尔·重拳那里复命。‡漢瑟爾·重拳要妳殺死灼熱峽谷中的20只巨型熔巖蜘蛛。妳可以在灼熱峽谷的高地和熔巖池裏找到巨型熔巖蜘蛛。|n當妳殺死足夠的巨型熔巖蜘蛛之後，回到漢瑟爾·重拳那裏復命。',
  }
},
[7725] = {
  nil,
  { -- Npc
    'Saqueador dos Temível Totem‡Налетчик из племени Зловещего Тотема‡Räuber der Grimmtotem‡그림토템부족 침략자‡Asaltante Tótem Siniestro‡Asaltante Tótem Siniestro‡Ecumeur du Totem sinistre‡恐怖图腾袭击者‡恐怖圖騰劫掠者',
    nil,
  },
  nil,
  { -- Quest
    'Querida, encolhi mais gigantes‡Новая ликвидация великанов‡Und wieder unter den geschrumpften Riesen‡잔류물 수집‡Encoge más gigantes‡Encoge más gigantes‡Le retour des géants rétrécis‡更多被缩小的巨人！‡更多被縮小的巨人！',
    nil,
    'Use o Ultra-encolhedor de Zorbin para deixar qualquer tipo de gigante de Feralas com um tamanho mais compacto e manejável. Colete 10 Resíduos de Miniaturização encontrados nos gigantes encolhidos e leve para Zorbin Cegasvista, que fica nas docas da Costa Esquecida, em Feralas.‡Используйте ультрасжиматель Зорбина, чтобы уменьшить великанов любого вида, каких вы найдете в Фераласе. Принесите 10 остатков миниатюризации этих великанов Зорбину Дребезгуну в порт Забытого берега в Фераласе.‡Benutzt Zorbins Super-Schrumpfer, um jegliche Art von Riesen in Feralas in eine handlichere Form zu schrumpfen. Bringt 10 Schrumpf-Überreste, die auf den kleineren handlicheren Riesen liegen zu Zorbin Fandazzle am Dock der Vergessenen Küste in Feralas.‡페랄라스에서 눈에 띄는 아무 거인에게나 조브린의 형상축소기를 사용해 좀 더 다루기 쉬운 형태로 변환하십시오. 페랄라스의 잊혀진 해안 부두에 있는 조브린 팬대즐에게 이 변형된 거인들에게서 얻을 수 있는 축소화 잔류물 10개를 가져가야 합니다.‡Utiliza el Ultra-reductor de Zorbin para encoger a cualquier gigante que encuentres en Feralas a un tamaño más manejable. Lleva 10 residuos de miniaturización encontrados en las versiones encogidas de los gigantes a Zorbin Ventipnotizador, al embarcadero de La Costa Olvidada de Feralas.‡Utiliza el Ultra-reductor de Zorbin para encoger a cualquier gigante que encuentres en Feralas a un tamaño más manejable. Lleva 10 residuos de miniaturización encontrados en las versiones encogidas de los gigantes a Zorbin Hipnoviento, al embarcadero de La Costa Olvidada de Feralas.‡Utilisez l\'Ultra-réducteur de Zorbin sur des géants de n\'importe quel type en Feralas afin les rendre plus faciles à gérer. Apportez 10 Résidus de miniaturisation que vous trouverez sur les versions rétrécies des géants à Zorbin Fandazzle aux docks de la Côte oubliée en Feralas.‡使用索尔宾的超级压缩器来缩小菲拉斯的任意种类的巨人，将他们缩小到更容易控制的体积。从缩小过的巨人身上收集10份微缩残渣，把它们交给菲拉斯被遗忘的海岸码头的索尔宾·范达瑟。‡使用索爾賓的超級壓縮器來縮小菲拉斯的任意種類的巨人，將他們縮小到更容易控制的體積。從縮小過的巨人身上收集10份微縮殘渣，把它們交給菲拉斯被遺忘的海岸碼頭的索爾賓·範達瑟。',
  }
},
[7726] = {
  -- Item
  '‡Эгида командира из Алого ордена‡Aegis des Scharlachroten Kommandanten‡붉은십자군 사령관의 아이기스‡Égida del Comandante Escarlata‡Égida del Comandante Escarlata‡Egide du commandant écarlate‡血色指挥官之盾‡血色指揮官聖禦盾',
  { -- Npc
    'Naturalista Temível Totem‡Натуралист племени Зловещего Тотема‡Naturalist der Grimmtotem‡그림토템부족 식물학자‡Naturalista Tótem Siniestro‡Naturalista Tótem Siniestro‡Naturaliste du Totem sinistre‡恐怖图腾博学者‡恐怖圖騰自然學家',
    nil,
  },
  nil,
  { -- Quest
    'Completa o tanque, chefia!‡Новая энергия для уменьшения‡Neuer Treibstoff fürs Schrumpfen‡연료 재충전‡Más combustible para el Ultra-reductor‡Más combustible para el Ultra-reductor‡Encore du carburant pour la zappette‡补充动力‡補充動力',
    nil,
    'Colete 6 Âmagos dos Elementais de Água dos Elementais do Mar e dos Borrifos do Mar ao longo da Costa Esquecida de Feralas e leve-os para Zorbin Cegasvista, próximo às docas.‡Соберите 6 ядер элементалей воды, убивая морских элементалей и морских валов на Забытом берегу в Фераласе, и принесите их Зорбину Дребезгуну, который находится неподалеку от порта.‡Sammelt 6 Wasserelementarkerne von den Meereselementaren und Meeresschauern entlang der Vergessenen Küste von Feralas und bringt sie zurück zu Zorbin Fandazzle in der Nähe des dortigen Docks.‡페랄라스의 잊혀진 해안에 있는 바다 정령과 바다 물보라 정령에게서 물의 정령 핵 6개를 모아 부두 근처에 있는 조브린 팬대즐에게 가져가야 합니다.‡Reúne 6 núcleos de elemental de agua de los elementales marinos y los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Ventipnotizador, que está cerca del embarcadero.‡Reúne 6 núcleos de elemental de agua de los elementales marinos y los rocíos marinos que hay en La Costa Olvidada de Feralas, y llévaselos a Zorbin Hipnoviento, que está cerca del embarcadero.‡Récupérez 6 Noyaux élémentaires d\'eau sur les Elémentaires marins et les Embruns le long de la Côte oubliée de Feralas, et rapportez-les à Zorbin Fandazzle, près du quai.‡从菲拉斯被遗忘的海岸那里的海元素和巨型海元素身上获取6块水元素核心，把它们交给码头附近的索尔宾·范达瑟。‡從菲拉斯被遺忘的海岸那裏的海元素和巨型海元素身上獲取6塊水元素核心，把它們交給碼頭附近的索爾賓·範達瑟。',
  }
},
[7727] = {
  -- Item
  '‡Наплечье стражника‡Wachmannschulterstücke‡경비원의 어깨갑옷‡Espaldares de velador‡Espaldares de velador‡Espauliers de veilleur‡守卫肩铠‡守衛肩鎧',
  { -- Npc
    'Xamã Temível Totem‡Шаман племени Зловещего Тотема‡Schamane der Grimmtotem‡그림토템부족 주술사‡Chamán Tótem Siniestro‡Chamán Tótem Siniestro‡Chaman du Totem sinistre‡恐怖图腾萨满祭司‡恐怖圖騰薩滿',
    nil,
  },
  nil,
  { -- Quest
    'Incendossauro? É de comer?‡Пламезавры? Ну и название...‡Incendosaurier? Was-auch-immer-Saurier?‡인센도사우루스라니 무슨...‡¿Incendosaurio? Loqueseasaurio más bien‡¿Incendosaurio? Loqueseasaurio más bien‡Incendosaures ? N\'importosaures, plutôt‡熏火龙‡熏火龍',
    nil,
    'Hansel Mão-pesada quer que você mate 20 Incendossauros.|nEles ocupam as poças dentro do Fosso de Lava. O Fosso de Lava fica no Caldeirão da Garganta Abrasadora.|nDepois de matar os Incendossauros, fale novamente com Hansel Mão-pesada na Garganta Abrasadora.‡По поручению Хансела Большерука убейте 20 пламезавров, обитающих в озерах лавы в Шлаковой Яме - это часть Котла в Тлеющем ущелье.|nПо выполнении задания вернитесь к Ханселу в Тлеющее ущелье.‡Hansel Heavyhands möchte, dass Ihr 20 Incendosaurier tötet.|nDie Incendosaurier haben sich in den Lavabecken der Schlackengrube eingenistet. Ihr findet die Schlackengrube im Kessel der segenden Schlucht.|nSobald Ihr genug Incendosaurier getötet habt, kehrt zu Hansel Heavyhands in der sengenden Schlucht zurück.‡용광로에 있는 잿가루 채석장 안의 용암 지대를 점령하고 있는 인센도사우루스 20마리를 처치한 후, 이글거리는 협곡에 있는 한셀 헤비핸드에게 돌아가야 합니다.‡Hansel Manospesadas quiere que mates 20 incendosaurios.|nSuelen estar en los estanques de lava de La Fosa de la Escoria. Está en La Caldera de La Garganta de Fuego.|nDespués ve a ver a Hansel Manospesadas.‡Hansel Manospesadas quiere que mates 20 incendosaurios.|nSuelen estar en los estanques de lava de La Fosa de la Escoria. La Fosa de la Escoria está en La Caldera de La Garganta de Fuego.|nCuando hayas matado suficientes incendosaurios ve a ver a Hansel Manospesadas a La Garganta de Fuego.‡Hansel Heavyhands veut que vous tuiez 20 Incendosaures.|nOn peut les trouver dans les bassins de lave de la Fosse aux scories, qui occupe une partie du Chaudron de la gorge des Vents brûlants.|nRetournez voir Hansel Heavyhands dans la gorge des Vents brûlants lorsque vous aurez tué suffisamment d’Incendosaures.‡汉瑟尔·重拳让你去杀掉20个熏火龙。|n熏火龙侵占了熔渣之池中的那些岩浆池。熔渣之池就在灼热峡谷的大熔炉中。|n当你杀死足够数量的熏火龙后，就回去找汉瑟尔·重拳。‡漢瑟爾·重拳讓妳去殺掉20個熏火龍。|n熏火龍侵占了熔渣之池中的那些巖漿池。熔渣之池就在灼熱峽谷的大熔爐中。|n當妳殺死足夠數量的熏火龍後，就回去找漢瑟爾·重拳。',
  }
},
[7728] = {
  -- Item
  '‡Одеяния обманщика‡Täuscherroben‡현혹의 로브‡Togas de cautivador‡Togas de cautivador‡Robe de tromperie‡欺诈者长袍‡欺詐者長袍',
  { -- Npc
    'Kirith, o Maldito‡Кирит Проклятый‡Kirith der Verdammte‡저주받은 키리스‡Kirith el Maldito‡Kirith el Maldito‡Kirith le Damné‡被诅咒的基利斯‡被詛咒的基利斯',
    nil,
  },
  nil,
  { -- Quest
    'OBJETOS ROUBADOS: Alcaraviz de Ferraria e Luneta do Espia‡УКРАДЕНО: фурма и подзорная труба наблюдателя‡GESTOHLEN: Schmiedewindform und ein Ausguck-Handfernrohr‡도난품: 가열로 바람구멍 및 감시병의 망원경‡OBJETOS ROBADOS: Tobera y espejo espía‡OBJETOS ROBADOS: Tobera y catalejo‡OBJETS VOLES : Tuyère et longue-vue‡被盗：鼓风机和望远镜‡被盜：鼓風機和望遠鏡',
    nil,
    'Encontre e devolva o Alcaraviz de Ferraria e a Luneta do Espia ao Capataz Scrange na Garganta Abrasadora.|nA única informação que você tem sobre esses itens é a seguinte: com certeza foram roubados por anões Ferro Negro. O Alcaraviz de Ferraria é uma ferramenta usada por ferreiros e a Luneta do Espia é um aparelho de monitoramento inestimável para vigias.‡Найдите и верните фурму и подзорную трубу наблюдателя надсмотрщику Скренджу в Тлеющем ущелье. Единственная известная информация: вещи были украдены дворфами Черного Железа. Подзорная труба является бесценным прибором для наблюдения, а фурма – незаменимым кузнечным инструментом.‡Sucht die Schmiedewindform und das Ausguck-Handfernrohr. Bringt diese Gegenstände zu Zuchtmeister Scrange in der sengenden Schlucht.|nDie einzigen Informationen die Ihr habt sind: Die Schmiedewindform is ein SCHMIEDEwerkzeug welches von SCHMIEDEN verwendet wird und das Ausguck-Handfernrohr ist ein unverzichtbares Werkzeug für SPÄHPOSTEN.‡이글거리는 협곡에 있는 작업반장 스크랜지에게 가열로 바람구멍과 감시병의 망원경을 찾아 가져가야 합니다.|n이 물건들에 대해 가지고 있는 유일한 정보는 다음과 같습니다.|n검은무쇠단 드워프들이 훔쳐간 것이 분명합니다.|n가열로 바람구멍은 대장장이들이 사용하는 대장 도구입니다.|n감시병의 망원경은 감시병들에게 값으로 따질 수 없을 만큼 중요한 감시 도구입니다.‡Encuentra la tobera y el espejo espía y llévaselos al capataz Scrange a La Garganta de Fuego.|nLo único que sabes es que fueron robados por enanos Hierro Negro. La tobera es una herramienta de herrero y el espejo es un instrumento muy valioso para los vigías.‡Encuentra la tobera y el catalejo y llévaselos al capataz Scrange a La Garganta de Fuego.|nLo único que sabes es que fueron robados por enanos Hierro Negro. La tobera es una herramienta de herrero y el catalejo es un instrumento muy valioso para los oteadores.‡Trouvez la Tuyère de forge et la Longue-vue du guetteur et rapportez-les au sous-chef Scrange dans la gorge des Vents brûlants.|nLes seules informations dont vous disposez sur ces objets sont les suivantes : ils ont été dérobés par les nains Sombrefer, la Tuyère de forge est un outil utilisé par les forgerons et la Longue-vue du guetteur est un outil de surveillance inestimable pour les guetteurs.‡找到冶炼鼓风机和侦查员的望远镜，把它们还给灼热峡谷的监工斯克兰格。|n你所知道的关于这些物品的惟一信息是：它们肯定是被黑铁矮人偷走的。冶炼鼓风机是铁匠用的锻造工具，侦查员的望远镜是侦查员所需的侦查工具。‡找到冶煉鼓風機和偵查員的望遠鏡，把它們還給灼熱峽谷的監工斯克蘭格。|n妳所知道的關於這些物品的惟壹信息是：它們肯定是被黑鐵矮人偷走的。冶煉鼓風機是鐵匠用的鍛造工具，偵查員的望遠鏡是偵查員所需的偵查工具。',
  }
},
[7729] = {
  -- Item
  '‡Мушкет Честерфолла‡Chesterfallmuskete‡체스터폴 머스킷총‡Mosquete Chesterfall‡Mosquete Chesterfall‡Mousquet Chasse-peau‡穿胸步枪‡穿胸步槍',
  { -- Npc
    'Espírito de Kirith‡Дух Кирита‡Geist von Kirith‡키리스의 영혼‡Espíritu de Kirith‡Espíritu de Kirith‡Esprit de Kirith‡基利斯的灵魂‡基利斯之靈',
    nil,
  },
  nil,
  { -- Quest
    'TEMOS VAGAS: desbancando a concorrência‡ВАКАНСИЯ: устранитель конкурентов‡STELLE ZU VERGEBEN: Erledige die Konkurrenz‡구인광고: 경쟁 선별‡OPORTUNIDAD LABORAL: Acabar con la competencia‡OPORTUNIDAD LABORAL: Acabar con la competencia‡OFFRE D\'EMPLOI : Réduire la concurrence‡工作机会：肃清竞争对手‡工作機會：肅清競爭對手',
    nil,
    'Mate 15 Capatazes Ferro Negro e 15 Feitores Ferro Negro. Depois, fale novamente com Capataz Scrange, na Garganta Abrasadora.‡Убейте 15 надсмотрщиков и 15 поработителей из клана Черного Железа. По выполнении задания вернитесь к десятнику Скренджу в Тлеющее ущелье.‡Tötet 15 Zuchtmeister der Dunkeleisenzwerge und 15 Sklavenhändler der Dunkeleisenzwerge. Kehrt zu Zuchtmeister Scrange zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은무쇠단 감독관 15명과 검은무쇠단 노예상인 15명을 처치하고 임무를 완수한 후, 이글거리는 협곡에 있는 작업반장 스크랜지에게 돌아가야 합니다.‡Mata a 15 capataces y 15 esclavistas Hierro Negro y ve a ver al capataz Scrange a La Garganta de Fuego.‡Mata a 15 Capataces y 15 esclavistas Hierro Negro y ve a ver al capataz Scrange a La Garganta de Fuego.‡Tuez 15 Sous-chefs Sombrefer et 15 Esclavagistes Sombrefer. Revenez voir le sous-chef Scrange dans la gorge des Vents brûlants quand vous aurez accompli cette tâche.‡杀死15个黑铁工头和15个黑铁奴隶贩子。完成任务之后就回去找监工斯克兰格。‡殺死15個黑鐵工頭和15個黑鐵奴隸販子。完成任務之後就回去找監工斯克蘭格。',
  }
},
[7730] = {
  -- Item
  '‡Кобальтовый крушитель‡Kobaltzermalmer‡코발트 분쇄기‡Triturador de cobalto‡Triturador de cobalto‡Ecraseur de cobalt‡钴蓝粉碎者‡鈷藍粉碎者',
  { -- Npc
    'Bruto das Torres de Pedra‡Рубака Когтистых гор‡Grunzer des Steinkrallengebirges‡돌발톱 그런트‡Bruto Espolón‡Bruto Espolón‡Grunt des Serres-Rocheuses‡石爪山步兵‡石爪山蠻兵',
