[5301] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A arte de forjar armaduras‡Искусство школы Брони‡Die Kunst des Rüstungsschmiedes‡방어구제작자의 길‡El arte del forjador de armaduras‡El arte del forjador de armaduras‡L\'art de l\'armurier‡铸造护甲的艺术‡鑄造護甲的藝術',
    nil,
    'Para virar Ferreir<o/a> de Armaduras, você vai ter que forjar os seguintes itens e levá-los para Okothos: quatro Elmos Ornados de Mithril, duas Botas Ornadas de Mithril e um Peitoral Ornado de Mithril.‡Чтобы присоединиться к школе Брони, изготовьте и отдайте Окотосу 4 изысканных мифриловых шлема, 2 пары изысканных мифриловых сапог и 1 изысканную мифриловую кирасу.‡Um Rüstungsschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Okothos bringen: 4 verschnörkelte Mithrilhelme, 2 verschnörkelte Mithrilstiefel, 1 verschnörkelte Mithrilbrustplatte.‡방어구제작자가 되려면 화려한 미스릴 투구 4개, 화려한 미스릴 장화 2켤레, 화려한 미스릴 흉갑 1벌을 만들어 오코토스에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Okothos: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Okothos: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Pour devenir un fabricant d\'armures, il faut fabriquer les éléments suivants puis les apporter à Okothos : 4 Heaumes ornés en mithril, 2 Bottes ornées en mithril, 1 Cuirasse ornée en mithril.‡要想成为一名护甲铸造师的话，你必须将下列物品交给奥克索斯：4顶精制秘银头盔、2双精制秘银战靴和1副精制秘银胸甲。‡要想成為壹名護甲鑄造師的話，妳必須將下列物品交給奧克索斯：4頂精制秘銀頭盔、2雙精制秘銀戰靴和1副精制秘銀胸甲。',
  }
},
[5302] = {
  -- Item
  '‡Кобальтовый кулачный щит‡Kobaltblauer Rundschild‡코발트 버클러‡Rodela de cobalto‡Rodela de cobalto‡Targe en cobalt‡生命之环‡深藍圓盾',
  nil,
  nil,
  { -- Quest
    'O caminho do armeiro‡Путь оружейника‡Der Weg des Waffenschmieds...‡무기제작자의 길‡El arte del forjador de armas‡El arte del forjador de armas‡La voie du Forgeron d\'armes‡武器铸造师之道‡武器鑄造師之道',
    nil,
    'Para se tornar <um Armeiro/uma Armeira>, você precisa fazer os seguintes itens e levá-los para Borgosh: 4 Espadas Largas de Lunaço, 4 Machados Sólidos de Ferro, 2 Machados Pesados de Mithril e 2 Grandes Maças Pretas.‡Изготовьте и отдайте Боргошу 4 палаша лунной стали, 4 массивных железных топора, 2 тяжелых мифриловых топора и 2 больших черных палицы.‡Um Waffenschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Borgosh bringen: 4 Mondstahlbreitschwerter, 4 massive Eisenäxte, 2 schwere Mithriläxte und 2 große schwarze Streitkolben.‡무기제작자가 되려면 달의 강철 브로드소드 4자루, 큰 철제 도끼 2자루, 견고한 미스릴 도끼 2자루, 검은 대형 철퇴 2자루를 만들어 보르고쉬에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armas tienes que fabricar lo siguiente y llevárselo a Borgosh: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.|n‡Para convertirte en <forjador/forjadora> de armas tienes que fabricar lo siguiente y llevárselo a Borgosh: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.‡Pour devenir un Fabricant d\'armes, vous devez fabriquer les éléments suivants et les rapporter à Borgosh : 4 Epées d\'acier lunaire, 4 Gigantesques haches en fer, 2 Haches en mithril lourd, et 2 Grandes masses noires.‡要想成为一名武器铸造师的话，你必须将下列物品交给伯古什：4把月钢宽剑、4把巨型铁斧、2把秘银重斧和2把巨型黑色锤。‡要想成為壹名武器鑄造師的話，妳必須將下列物品交給伯古什：4把月鋼寬劍、4把巨型鐵斧、2把秘銀重斧和2把巨型黑色錘。',
  }
},
[5304] = {
  nil,
  { -- Npc
    'Cervalado Esfiapluma‡Крылень с обтрепанными перьями‡Fransenfederflügler‡날개발굽 공작날개 히포그리프‡Alacervo Plumavieja‡Alacervo Plumavieja‡Cerf ailé Aigreplume‡乱羽翼鹿‡亂羽翼鹿',
    nil,
  },
  nil,
  nil
},
[5305] = {
  nil,
  { -- Npc
    'Arrojacéu Esfiapluma‡Блеклоперый крыловоин‡Fransenfederhimmelsstürmer‡갈퀴발톱 공작날개 히포그리프‡Tormento Rozapluma‡Asaltacielo Plumavieja‡Tempêtueux Aigreplume‡乱羽鸣天者‡亂羽鳴天者',
    nil,
  },
  nil,
  { -- Quest
    'Doce serenidade‡Секрет безмятежности‡Süße Beschaulichkeit‡진홍십자군 작업복‡Dulce serenidad‡Dulce serenidad‡Douce sérénité‡甜美的平静‡甜美的平靜',
    nil,
    'Vá para Stratholme e mate o Forjador de Martelos Carmesim. Recolha o Avental do Forjador de Martelos Carmesim e leve-o para Lilith.‡Отправляйтесь в Стратхольм и убейте Молотобойца из Багрового легиона. Возьмите его фартук и возвращайтесь к Лилит.‡Begebt Euch nach Stratholme und tötet den purpurroten Hammerschmied. Nehmt die Schürze des purpurroten Hammerschmiedes und kehrt zu Lilith zurück.‡스트라솔름으로 가서 진홍십자군 대장장이를 처치하고 진홍십자군 대장장이의 작업복을 가지고 릴리스에게 돌아가야 합니다.‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.|n‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.‡Aller jusqu’à Stratholme et tuer le Forgeur de marteaux cramoisi. Récupérer son Tablier et le ramener à Lilith.‡到斯坦索姆去杀死红衣铸锤师。将红衣铸锤师的围裙交给莉莉丝。‡到斯坦索姆去殺死紅衣鑄錘師。將紅衣鑄錘師的圍裙交給莉莉絲。',
  }
},
[5306] = {
  -- Item
  '‡Посох укротителя ветрокрылов‡Windreiterstab‡바람기수의 지팡이‡Bastón de jinete del viento‡Bastón de jinete del viento‡Bâton du coursier du vent‡御风法杖‡雙足飛龍法杖',
  { -- Npc
    'Patriarca Esfiapluma‡Блеклоперый патриарх‡Fransenfederpatriarch‡우두머리 공작날개 히포그리프‡Patriarca Rozapluma‡Patriarca Plumavieja‡Patriarche Aigreplume‡乱羽角鹰雄兽‡亂羽角鷹族王',
    nil,
  },
  nil,
  { -- Quest
    'A litofídia da caçadora sombria‡Змеекамень Пленяющей Духов‡Schlangenstein der Schattenjägerin‡어둠사냥꾼의 뱀돌‡Piedra Serpiente de la Cazadora de las Sombras‡Piedra culebra de la cazadora de las Sombras‡Pierre du serpent de la chasseresse des ombres‡沃什加斯的菊石‡沃什加斯的菊石',
    nil,
    'Vá para o Pico da Rocha Negra e mate a Caçadora Sombria Vosh\'gajin. Recolha a Litofídia de Vosh\'gajin e fale novamente com Kilram.‡Отправляйтесь на Пик Черной горы, убейте Темную охотницу Вос\'гаджин. Заберите у нее змеекамень и принесите Килраму.‡Begebt Euch zur Blackrockspitze und erschlagt Schattenjägerin Vosh\'gajin. Holt Vosh\'gajins Schlangenstein und kehrt zu Kilram zurück.‡검은바위 첨탑으로 가서 어둠사냥꾼 보쉬가진을 처치하고 보쉬가진의 뱀돌을 킬램에게 갖다주어야 합니다.‡Viaja a la Cumbre de Roca Negra y mata a la cazadora de las Sombras Vosh\'gajin. Recupera la piedra serpiente de Vosh\'gajin y vuelve con Kilram.‡Viaja a la Cumbre de Roca Negra y mata a la cazadora de las Sombras Vosh\'gajin. Recupera la piedra culebra de Vosh\'gajin y vuelve con Kilram.‡Aller jusqu’au Pic Blackrock et abattre la chasseresse des ombres Vosh\'gajin. Récupérer la Pierre du serpent de Vosh\'gajin et la ramener à Kilram.‡到黑石塔去杀死暗影猎手沃什加斯，将沃什加斯的菊石交给基尔拉姆。‡到黑石塔去殺死暗影獵手沃什加斯，將沃什加斯的菊石交給基爾拉姆。',
  }
},
[5307] = {
  nil,
  { -- Npc
    'Guinchador do Vale‡Дольный крикун‡Talkreischer‡계곡천둥매‡Estridador del valle‡Estridador del valle‡Hurleur des vallées‡山谷尖啸者‡山谷尖嘯者',
    nil,
  },
  nil,
  { -- Quest
    'Corrupção‡Порча‡Verderbnis‡부패의 검‡Corrupción‡Corrupción‡Corruption‡腐蚀‡腐蝕',
    nil,
    'Encontre o Cuteleiro da Guarda Negra em Stratholme e destrua-o. Recolha a Insígnia da Guarda Negra e fale novamente com Seril Flagelicida.‡Найдите в Стартхольме оружейника Черной Стражи и уничтожьте его. Возьмите его Знак Черной Стражи и принесите Сирилу Плетебою.‡Findet den Schwertschmied der schwarzen Wache in Stratholme und vernichtet ihn. Holt die Insignien der schwarzen Wache und kehrt zu Seril Scourgebane zurück.‡스트라솔름에서 검은호위대 검제작자를 찾아 그를 처치하고 검은호위대 휘장을 회수한 후, 세릴 스컬지베인에게 갖다주어야 합니다.‡Encuentra al armero Guardia Negra en Stratholme y acaba con él. Recupera la Insignia de La Guardia Negra y regresa con Seril Finiquiplaga.‡Encuentra al armero Guardia Negra en Stratholme y acaba con él. Recupera la Insignia de La Guardia Negra y regresa con Seril Finiquiplaga.‡Trouver le Fabricant d\'épées de la Garde noire à Stratholme et le tuer. Récupérer l’Insigne de la Garde noire et retourner auprès de Seril Scourgebane.‡在斯坦索姆找到黑衣守卫铸剑师，然后杀死他。将黑色卫士徽记交给亡灵杀手瑟里尔。‡在斯坦索姆找到黑衣守衛鑄劍師，然後殺死他。將黑色衛士徽記交給亡靈殺手瑟裏爾。',
  }
},
