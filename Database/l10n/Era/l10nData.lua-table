[74] = {
  nil,
  { -- Npc
    'Torren Ácero‡Курран Сталль‡Kurran Steele‡쿠란 스틸‡Kurran Aceralia‡Kurran Aceralia‡Kurran Steele‡库兰·斯蒂利‡庫蘭·斯蒂利',
    'Armaduras de Tecido e Couro‡Торговец тканевыми и кожаными доспехами‡Tuch- und Lederrüstungshändler‡천 및 가죽 방어구 상인‡Mercader de armaduras de tela y cuero‡Mercader de armaduras de tela y cuero‡Marchand d\'armures en étoffe & en cuir‡布甲和皮甲商人‡布甲和皮甲商人',
  },
  nil,
  { -- Quest
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'A Página de Diário Rasgada que você descobriu lhe dá a próxima pista.‡Отнесите страницу из дневника маршалу Хаггарду.‡Die zerrissene Tagebuchseite, die Ihr gefunden habt, gibt Euch den nächsten Hinweis.‡발견한 찢어진 일지 페이지에 다음 단서가 들어 있습니다.‡La página arrancada del diario que descubriste es tu siguiente pista.‡La página arrancada del diario que descubriste es tu siguiente pista.‡La Page de journal déchirée que vous avez découverte est votre deuxième indice.‡你找到的这张被撕破的日记书页给你提供了又一个线索。‡妳找到的這張被撕破的日記書頁給妳提供了又壹個線索。',
  }
},
[75] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'O Delegado Fadigas quer que você procure a Página de Diário Esmaecida no baú no andar de cima.‡Найдите в сундуке на втором этаже выцветшую страницу с записями.‡Marshal Haggard möchte, dass Ihr in der Kiste oben nach der verblassten Tagebuchseite sucht.‡치안대장 해거드가 위층의 상자에서 색 바랜 일지 페이지를 가져와 달라고 부탁했습니다.‡El alguacil Haggard quiere que busques la página del diario descolorida en el cofre que hay arriba.‡El mariscal Haggard quiere que busques la página del diario descolorida en el cofre que hay arriba.‡Le maréchal Haggard veut que vous alliez chercher la Vieille page de journal dans le coffre à l\'étage.‡治安官哈迦德要你从楼上的箱子里找出一张褪色的日记书页。‡治安官哈迦德要妳從樓上的箱子裏找出壹張褪色的日記書頁。',
  }
},
[76] = {
  nil,
  nil,
  -- Object
  'Jarra Vazia‡Пустой кувшин‡Ein leerer Krug‡빈 단지‡Una jarra vacía‡Un tarro vacío‡Une jarre vide‡空瓶子‡空瓶子',
  { -- Quest
    'A Mina de Jaspe‡Яшмовая шахта‡Die Jaspismine‡석영 광산‡La Cantera de Jaspe‡La Cantera de Jaspe‡La mine de Jasperlode‡玉石矿洞‡玉石礦洞',
    nil,
    'Explore a Mina de Jaspe e, depois, fale com o Delegado Durão em Vila d\'Ouro.‡Обследуйте Яшмовую шахту и вернитесь с докладом в Златоземье к маршалу Дугхану.‡Erforscht die Jaspismine und kehrt dann nach Goldhain zu Marshal Dughan zurück, um ihm Bericht zu erstatten.‡석영 광산을 탐색한 후 골드샤이어에 있는 치안대장 더그한에게 보고해야 합니다.‡Explora la Cantera de Jaspe y vuelve a informar al alguacil Dughan a Villadorada.‡Explora la Cantera de Jaspe y vuelve a informar al alguacil Dughan a Villadorada.‡Explorer la Mine de Jasperlode, puis faites votre rapport au maréchal Dughan de Goldshire.‡查看玉石矿洞，然后回到闪金镇去向治安官杜汉报告。‡查看玉石礦洞，然後回到閃金鎮去向治安官杜漢報告。',
  }
},
[77] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Pega a joça!‡Грязное дело‡Eine schwierige Situation‡까다로운 임무‡Una situación peliaguda‡Una situación peliaguda‡Une situation délicate‡收集蜜糖‡收集蜜糖',
    nil,
    'Recupere 10 garrafas de Suco Gami das Terras Agrestes dos caixotes localizados na base abandonada da Horda na Rocha Oculta.‡Найдите заброшенную базу Орды на Осклизлой скале и заберите из ящиков 10 бутылок "Медовой зыби из Внутренних земель".‡Holt 10 Flaschen Hinterland-Honigwelle aus den Kisten, die sich rund um den verlassenen Stützpunkt der Horde in Skulk Rock befinden.‡굼벵이 바위굴의 버려진 호드 기지 근처에서 상자에 든 동부내륙지 벌꿀 리플 10병을 회수해야 합니다.‡Recoge 10 botellas de calimocho de miel de las Tierras del Interior de las cajas de la base abandonada de la Horda en Roca Oculta.‡Recoge 10 botellas de calimocho dulce de las Tierras del Interior de las cajas de la base abandonada de la Horda en Roca Oculta.‡Récupérer 10 bouteilles de Houle au miel des Hinterlands dans des caisses se trouvant aux environs de la base abandonnée de la Horde, au rocher de l\'Affût.‡从隐匿石一带被部落废弃的基地中的箱子里找到10瓶辛特兰蜜糖。‡從隱匿石壹帶被部落廢棄的基地中的箱子裏找到10瓶辛特蘭蜜糖。',
  }
},
[78] = {
  nil,
  { -- Npc
    'Janos Punhoforte‡Янош Камнекост‡Janos Hammerknuckle‡야노스 해머너클‡Janos Nudillomartillo‡Janos Nudillomartillo‡Janos Hammerknuckle‡亚努斯·哈默纳克‡亞努斯·哈默納克',
    'Armaria‡Оружейник‡Waffenschmied‡무기제작자‡Forjador de armas‡Forjador de armas‡Fabricant d\'armes‡武器锻造师‡武器鑄造師',
