[8983] = {
  -- Item
  '‡‡‡법전: 순간 치유 IV‡‡‡‡‡聖典:快速治療 IV',
  { -- Npc
    'Lorde Golem Argelmach‡Повелитель големов Аргелмах‡Golemlord Argelmach‡골렘 군주 아젤마크‡Señor Gólem Argelmach‡Señor Gólem Argelmach‡Seigneur golem Argelmach‡傀儡统帅阿格曼奇‡魔像領主阿格曼奇',
    nil,
  },
  nil,
  { -- Quest
    'Em busca da fonte‡Поиск источника‡Verfolgung der Spur‡향기의 근원 추적‡Rastrear la fuente‡Rastrear la fuente‡Remonter à la source‡追查货源‡追查貨源',
    nil,
    'Fale com Mara Reinoso na loja de alfaiataria no Distrito dos Magos da Cidade Baixa.‡Поговорите с Марой Ренник в портновской лавке в Квартале Магов.‡Sprecht mit Mara Rennick bei der Schneiderei im Magierviertel von Undercity.‡언더시티 마법 지구에 있는 재봉 용품점으로 가서 마라 레닉과 대화해야 합니다.‡Habla con Mara Rennick en la sastrería del Barrio de los Magos de Entrañas.‡Habla con Mara Rennick en la sastrería del Barrio de los Magos de Entrañas.‡Parlez à Mara Rennick, à la boutique du tailleur du Quartier de la Magie de Fossoyeuse.‡与幽暗城法师区裁缝店里的玛拉·雷尼克谈一谈。‡與幽暗城法師區裁縫店裏的瑪拉·雷尼克談壹談。',
  }
},
[8984] = {
  -- Item
  '‡Смертельный яд III‡Tödliches Gift III‡맹독 III‡Veneno mortal‡Veneno mortal‡Poison mortel‡致命药膏‡致命毒藥 III',
  nil,
  nil,
  { -- Quest
    'A verdade sobre as fragrâncias‡Источник обнаружен‡Lüftung des Geheimnisses‡밝혀진 향기의 근원‡El descubrimiento de la fuente‡El descubrimiento de la fuente‡La source est découverte !‡水落石出‡水落石出',
    nil,
    'Encontre o Boticário Adalberto Lorran no Contraforte de Eira dos Montes, para além da Mansão de Corvoforte.‡Найдите аптекаря Стаффрона Лерента в предгорьях Хиллсбрада за поместьем Черный Ворон.‡Findet Apotheker Staffron Lerent hinter dem Ravenholdt-Anwesen im Vorgebirge von Hillsbrad.‡라벤홀트 장원을 지나 힐스브래드 산기슭에 있는 스태프론 리런트를 찾아가야 합니다.‡Encuentra al boticario Staffron Lerent en las Laderas de Trabalomas, pasada la Mansión Ravenholdt.‡Encuentra al boticario Staffron Lerent en las Laderas de Trabalomas, pasada la Mansión Ravenholdt.‡Trouver l’apothicaire Staffron Lerent dans les contreforts de Hautebrande, au-delà du manoir de Ravenholdt.‡到希尔斯布莱德丘陵去，在拉文霍德庄园后面找到药剂师斯塔弗隆·雷伦特。‡到希爾斯布萊德丘陵去，在拉文霍德莊園後面找到藥劑師斯塔弗隆·雷倫特。',
  }
},
[8985] = {
  -- Item
  '‡Смертельный яд IV‡Tödliches Gift IV‡맹독 IV‡Veneno mortal‡Veneno mortal‡Poison mortel‡致命药膏‡致命毒藥 IV',
  nil,
  nil,
  { -- Quest
    'Mais componentes importantes‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡또 다른 중요한 요소‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡更多重要的材料',
    nil,
    'Obtenha uma Relíquia do Vilarejo Brisastral e leve-a para Bodley na Montanha Rocha Negra.‡Найдите реликвию Деревни Звездного Ветра и принести ее Бодли в Черную гору.‡Bringt Bodley in der Blackrockspitze ein Relikt von Starbreeze.‡별바람 마을 유물을 구한 후 검은바위 산에 있는 보들리에게 가져가야 합니다.‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Relique de Brise-Stellaire et rapportez-la à Bodley, à l’intérieur du Mont Rochenoire.‡收集一个星风村遗物，把它交给黑石山的伯德雷。‡取得星風村聖物，再回到黑石山找布德利。',
  }
},
[8986] = {
  -- Item
  '‡‡‡법전: 언데드 속박 II‡‡‡‡‡聖典:束縛不死生物 II',
  nil,
  nil,
  { -- Quest
    'Mais componentes importantes‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡또 다른 중요한 요소‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡更多重要的材料',
    nil,
    'Obtenha Restos Mortais Druídicos e os leve para Bodley na Montanha Rocha Negra.‡Найдите останки друидов и принести их Бодли в Черную гору.‡Bringt Bodley im Blackrock einige Druidenüberreste.‡드루이드의 유골을 구한 후 검은바위 산에 있는 보들리에게 가져가야 합니다.‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous des Restes druidiques et rapportez-les à Bodley, à l’intérieur du mont Rochenoire.‡收集德鲁伊的遗骸，把它们交给黑石山的伯德雷。‡取得德魯伊的遺體，再回到黑石山找布德利。',
  }
},
[8987] = {
  -- Item
  '‡‡‡법전: 빛의 보호 II‡‡‡‡‡聖典:神聖防護 II',
  nil,
  nil,
  { -- Quest
    'Mais componentes importantes‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡또 다른 중요한 요소‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡更多重要的材料',
    nil,
    'Obtenha uma Espada Brilhante do Fanatismo e leve-a para Bodley na Montanha Rocha Negra.‡Добудьте бриллиантовый меч фанатизма и принесите его Бодли в Черную гору.‡Bringt Bodley im Blackrock ein gleißendes Schwert des Zeloten.‡번쩍이는 열광의 검을 구해 검은바위 산에 있는 보들리에게 가져가야 합니다.‡Consigue una espada brillante de integrismo y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Épée brillante de fanatisme, puis rapportez-la à Bodley, à l’intérieur du mont Rochenoire.‡找到一把狂热光芒之剑，把它交给黑石山的伯德雷。‡取得光亮的狂熱之劍，再回到黑石山找布德利。',
  }
},
[8988] = {
  -- Item
  '‡‡‡법전: 마나 연소 III‡‡‡‡‡聖典:法力燃燒 III',
  nil,
  nil,
  { -- Quest
    'Mais componentes importantes‡Еще одна важная составляющая заклинания‡Mehr Komponenten von großer Wichtigkeit‡또 다른 중요한 요소‡Más componentes importantes‡Más componentes importantes‡D\'autres composants importants‡更多重要的材料‡更多重要的材料',
    nil,
    'Obtenha Cinzas de Alma Banida e leve-as para Bodley, dentro da Montanha Rocha Negra.‡Добыть пепел душ Изгнанников и принести его Бодли в Черную гору.‡Bringt Bodley im Blackrock etwas Seelenasche der Verbannten.‡추방된 자의 영혼재를 구한 후 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Prélevez des Cendres d’âme de banni, puis retournez voir Bodley à l’intérieur du mont Rochenoire.‡拿到放逐者的灵魂灰烬，把它交给黑石山的伯德雷。‡取得流放者的靈魂灰燼，再回到黑石山找布德利。',
  }
},
[8989] = {
  -- Item
  '‡‡‡법전: 소실 IV‡‡‡‡‡聖典:漸隱術 IV',
  nil,
  nil,
  { -- Quest
    'A parte direita do amuleto do lorde Valthalak‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 오른쪽 조각‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的右瓣‡瓦薩拉克領主護符的右半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Mor Casco Gris e então mate-o. Fale novamente com Bodley na Montanha Rocha Negra, com o Amuleto do Lorde Valthalak restaurado e o Braseiro de Sinalização.‡Вызвать дух Мора Серого Копыта с помощью жаровни Призыва, прикончить его и забрать недостающую часть амулета Лорда Вальтхалака. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Mor Grayhoof zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Blackrock zurück.‡부름의 화로를 사용하여 모그 그레이후프의 영혼을 소환한 후 처치하십시오. 완성된 군주 발타라크의 아뮬렛과 부름의 화로를 가지고 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Mor Ruciapezuña y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Mor Pezuña Gris y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l’esprit de Mor Sabot-gris, puis tuez-le. Ensuite, retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l’Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤出莫尔·灰蹄的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克公爵的饰品还给黑石山里的伯德雷。‡使用召喚火盆召喚莫爾·灰蹄的靈魂並殺了他。帶著重新組合的瓦薩拉克領主的護符和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8990] = {
  -- Item
  '‡‡‡법전: 정신 분열 VI‡‡‡‡‡聖典:心靈震爆 VI',
  nil,
  nil,
  { -- Quest
    'A parte direita do amuleto do Lorde Valthalak‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 오른쪽 조각‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的右瓣‡瓦薩拉克領主護符的右半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Isalien e então mate-a Fale novamente com Bodley dentro da Montanha Rocha Negra. Leve o Amuleto do Lorde Valthalak recombinado e o Braseiro de Sinalização.‡С помощью жаровни Призыва вызвать дух Изалиен и убить ее. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Isalien zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Blackrock zurück.‡부름의 화로를 사용하여 이살리엔의 영혼을 소환한 후 처치하십시오. 완성된 군주 발타라크의 아뮬렛과 부름의 화로를 가지고 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l’esprit d’Isalien, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l’Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤出伊萨莉恩的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克公爵的饰品还给伯德雷。‡使用召喚火盆召喚依薩利恩的靈魂並殺了她。帶著重新組合的瓦薩拉克領主護符和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8991] = {
  -- Item
  '‡‡‡법전: 내면의 열정 IV‡‡‡‡‡聖典:心靈之火 IV',
  nil,
  nil,
  { -- Quest
    'A parte direita do amuleto do Lorde Valthalak‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 오른쪽 조각‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的右瓣‡瓦薩拉克領主護符的右半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar os espíritos de Jil e Soeiro e então mate os dois. Fale novamente com Bodley na Montanha Rocha Negra, com o Amuleto do Lorde Valthalak restaurado e o Braseiro de Sinalização.‡Вызвать духов Джариен и Сотоса с помощью жаровни Призыва и убить их обоих. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um die Geister von Jarien und Sothos zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Blackrock zurück.‡부름의 화로를 사용하여 자리엔과 소노스의 영혼을 소환한 후 처치하십시오. 완성된 군주 발타라크의 아뮬렛과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer Jarien et Sothos, puis tuez-les. Retournez voir Bodley, à l\'intérieur du mont Blackrock, avec l’Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤出亚雷恩和索托斯的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克公爵的饰品还给黑石山的伯德雷。‡使用召喚火盆召喚賈林和索索斯並殺了他們。帶著重新組合的瓦薩拉克領主護符和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8992] = {
  -- Item
  '‡‡‡법전: 영혼의 절규 III‡‡‡‡‡聖典:心靈尖嘯 III',
  nil,
  nil,
  { -- Quest
    'A parte direita do amuleto do Lorde Valthalak‡Правая часть амулета Лорда Вальтхалака‡Das rechte Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 오른쪽 조각‡La parte derecha del amuleto de Lord Valthalak‡La parte derecha del amuleto de Lord Valthalak‡Le morceau droit de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的右瓣‡瓦薩拉克領主護符的右半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Kormok e então mate-o. Fale novamente com Bodley na Montanha Rocha Negra, com o Amuleto do Lorde Valthalak restaurado e o Braseiro de Sinalização.‡С помощью жаровни Призыва вызвать дух Кормока и убить его. Вернуться к Бодли в Черную гору, отдать ему восстановленный амулет и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Kormok zu beschwören und zu vernichten. Kehrt dann mit Lord Valthalaks zusammengesetzten Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Blackrock zurück.‡부름의 화로를 사용하여 코르모크의 영혼을 소환한 후 처치하십시오. 완성된 군주 발타라크의 아뮬렛과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con el amuleto de Lord Valthalak recompuesto y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l’esprit de Kormok, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec l’Amulette du seigneur Valthalak reconstituée et le Brasero de signal.‡使用召唤火盆召唤出库尔莫克的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克公爵的饰品还给黑石山的伯德雷。‡使用召喚火盆召喚科爾莫克的靈魂並殺了他。帶著重新組合的瓦薩拉克領主護符和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8993] = {
  -- Item
  '‡‡‡법전: 어둠의 보호 II‡‡‡‡‡聖典:暗影防護 II',
  nil,
  nil,
  { -- Quest
    'Entrega de presentes‡Подношение даров‡Geschenkübergabe‡선물 증정‡Ofrecer regalos‡Ofrecer regalos‡Faire des cadeaux‡赠送礼品‡贈送禮品',
    nil,
    nil,
  }
},
[8994] = {
  -- Item
  '‡‡‡법전: 어둠의 권능: 고통 VI‡‡‡‡‡聖典:暗言術:痛 VI',
  nil,
  nil,
  { -- Quest
    'Preparativos finais‡Последние приготовления‡Letzte Vorbereitungen‡마지막 준비‡Últimos preparativos‡Últimos preparativos‡Derniers préparatifs‡最后的准备‡最後的準備',
    nil,
    'Colete 40 Braceletes de Rocha Negra e consiga um Frasco de Poder Supremo. Leve tudo para Bodley, dentro da Montanha Rocha Negra.‡Соберите 40 наручей Черной горы и разыщите склянку Великой силы. Отнесите все это Бодли в Черную Скалу.‡Bringt Bodley im Blackrock 40 Blackrockarmschienen und ein Fläschchen mit oberster Macht.‡검은바위 팔보호구 40개와 강력한 마력의 영약을 구한 후, 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Reúne 40 brazales Roca Negra y consigue un frasco de poder supremo. Llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Reúne 40 brazales Roca Negra y consigue un frasco de poder supremo. Llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Collectez 40 Brassards rochenoire et un Flacon de pouvoir suprême. Ensuite, retournez voir Bodley au mont Rochenoire.‡从黑石塔的兽人那儿收集40副黑石护腕，把它们和一瓶超级能量合剂一起交给黑石山的伯德雷。‡收集40個黑石護腕和1份超級能量精鍊藥劑。把它們帶給黑石山上的布德利。',
  }
},
[8995] = {
  -- Item
  '‡‡‡법전: 빛의 권능: 보호막 VII‡‡‡‡‡聖典:聖言術:盾 VII',
  nil,
  nil,
  { -- Quest
    'Mea culpa, Lorde Valthalak‡Mea Culpa, Лорд Вальтхалак‡Mea Culpa, Lord Valthalak‡군주 발타라크여, 내 탓이오.‡Mea Culpa, Lord Valthalak‡Mea Culpa, Lord Valthalak‡Mea culpa, seigneur Valthalak‡瓦塔拉克公爵‡認錯，瓦薩拉克領主',
    nil,
    'Use o Braseiro de Sinalização para evocar o Lorde Valthalak. Acabe com ele e use o Amuleto do Lorde Valthalak no cadáver. Em seguida, devolva o Amuleto do Lorde Valthalak ao Espírito de Lorde Valthalak.‡Вызвать Лорда Вальтхалака с помощью жаровни Призыва. Убить его и использовать амулет. Потом вернуть амулет духу Вальтхалака.‡Benutzt das Räuchergefäß der Beschwörung, um Lord Valthalak zu beschwören. Macht ihn unschädlich und benutzt dann Lord Valthalaks Amulett bei seiner Leiche. Danach werdet Ihr dem Geist von Lord Valthalak sein Amulett zurückgeben müssen.‡부름의 화로를 사용하여 군주 발타라크를 소환하십시오. 군주 발타라크를 해치우고 그의 시체에 군주 발타라크의 아뮬렛을 사용한 후, 군주 발타라크의 영혼에게 군주 발타라크의 아뮬렛을 돌려줘야 합니다.‡Usa el Blandón de Invocación para invocar a Lord Valthalak. Despáchalo y usa el amuleto de Lord Valthalak sobre el cadáver. Después devuélvele el amuleto de Lord Valthalak al espíritu de Lord Valthalak.‡Usa el Blandón de Invocación para invocar a Lord Valthalak. Despáchalo y usa el amuleto de Lord Valthalak sobre el cadáver. Después devuélvele el amuleto de Lord Valthalak al espíritu de Lord Valthalak.‡Utilisez le Brasero de signal pour invoquer le seigneur Valthalak. Tuez-le, puis utilisez l’Amulette du seigneur Valthalak sur le corps. Ensuite, rendez l’amulette à l’Esprit du seigneur Valthalak.‡在比斯巨兽的房间里使用召唤火盆，召唤瓦塔拉克公爵。杀死他，对尸体使用瓦塔拉克的饰品。然后将瓦塔拉克的饰品还给瓦塔拉克公爵之魂。‡用召喚火盆召喚出瓦薩拉克領主。殺了他，在他的屍體上使用瓦薩拉克的護符。然後，將瓦薩拉克領主護符還給瓦薩拉克領主之靈。',
  }
},
[8996] = {
  -- Item
  '‡‡‡법전: 부활 III‡‡‡‡‡聖典:復活術 III',
  { -- Npc
    'Lacaio Emissário do Caos‡Прислужник-демон Бездны‡Leerwandlerdiener‡하급 보이드워커‡Esbirro abisario‡Esbirro abisario‡Sbire marcheur du Vide‡虚空行者‡虛無行者爪牙',
    nil,
  },
  nil,
  { -- Quest
    'Fale novamente com Bodley‡Возвращение к Бодли‡Rückkehr zu Bodley‡보들리에게 돌아가기‡Regresa junto a Bodley‡Regresa junto a Bodley‡Retourner voir Bodley‡向伯德雷回复‡回到布德利那裡',
    nil,
    'Fale novamente com Bodley na Montanha Rocha Negra e dê a ele o Braseiro de Sinalização.‡Вернитесь к Бодли в Черную гору и отдайте ему жаровню Призыва.‡Bringt das Räuchergefäß der Beschwörung zurück zu Bodley im Blackrock.‡검은바위 산 안에 있는 보들리에게 돌아가서 부름의 화로를 돌려줘야 합니다.‡Vuelve junto a Bodley en el interior de la Montaña Roca Negra y dale el Blandón de Señalización.‡Vuelve junto a Bodley en el interior de la Montaña Roca Negra y dale el Blandón de Señalización.‡Retournez voir Bodley à l\'intérieur du mont Rochenoire et donnez-lui le Brasero de signal.‡回到黑石山的伯德雷那里去，把召唤火盆交给他。‡回到黑石山的布德利那裡並將召喚火盆交給他。',
  }
},
[8997] = {
  -- Item
  '‡‡‡법전: 정신 지배 II‡‡‡‡‡聖典:精神控制 II',
  { -- Npc
    'Gershala Umbrurmúrio‡Гершал Шепот Ночи‡Gershala Nightwhisper‡게르샬라 나이트위스퍼‡Gershala Noctusurro‡Gershala Susurro Nocturno‡Gershala Nightwhisper‡戈沙拉·夜语‡戈沙拉·夜語',
    nil,
  },
  nil,
  { -- Quest
    'De volta ao começo‡Круг замкнулся‡Zurück zum Anfang‡다시 출발점으로‡Regreso al principio‡Regreso al principio‡Retour au commencement‡回到起点‡回到原點',
    nil,
    'Fale com Deliana na Sala do Trono em Altaforja.‡Поговорите с Делианой в Высоком троне в Стальгорне.‡Sprecht mit Deliana am Hohen Sitz von Ironforge.‡아이언포지의 왕좌에 있는 델리아나와 대화해야 합니다.‡Habla con Deliana en El Trono en Forjaz.‡Habla con Deliana en El Trono en Forjaz.‡Parlez à Deliana au Haut Siège d\'Ironforge.‡跟铁炉堡王座大厅内的德莉亚娜谈一谈。‡回到鐵爐堡的王座廳和德莉娜談談。',
  }
},
[8998] = {
  -- Item
  '‡‡‡법전: 마음의 눈 II‡‡‡‡‡聖典:心靈幻象 II',
  nil,
  nil,
  { -- Quest
    'De volta ao começo‡Круг замкнулся‡Zurück zum Anfang‡다시 출발점으로‡Regreso al principio‡Regreso al principio‡Retour au commencement‡回到起点‡回到原點',
    nil,
    'Fale com Mokvar no Castelo Grommash, que fica no Vale da Sabedoria, em Orgrimmar.‡Поговорите с Мокваром в крепости Громмаш в Аллее Мудрости в Оргриммаре.‡Sprecht mit Mokvar in der Feste Grommash im Tal der Weisheit von Orgrimmar.‡오그리마 지혜의 골짜기의 그롬마쉬 요새로 가서 모크바르와 대화하십시오.‡Habla con Mokvar en el Fuerte Grommash en el Valle de los Espíritus de Orgrimmar.‡Habla con Mokvar en el Fuerte Grommash en el Valle de los Espíritus de Orgrimmar.‡Parlez à Mokvar au Fort Grommash, dans la Vallée de la Sagesse d\'Orgrimmar.‡跟位于奥格瑞玛智慧谷里的莫克瓦尔谈一谈。‡回到奧格瑪智慧谷在葛羅瑪許堡中找莫克瓦談談。',
  }
},
[8999] = {
  -- Item
  '‡‡‡법전: 순간 치유 V‡‡‡‡‡聖典:快速治療 V',
  nil,
  nil,
  { -- Quest
    'Deixando o melhor para o final‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡은혜의 보답‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    'Dê a Deliana seu Capucho do Coração Selvagem e seu Colete do Coração Selvagem.‡Отдайте Делиане клобук и жилет Буйного Сердца.‡Gebt Deliana Eure Kutte des Wildherzens und Eure Weste des Wildherzens.‡델리아나에게 자연의정수 두건과 자연의정수 조끼를 주십시오.‡Dale a Deliana tu capucha y tu jubón Corazón Salvaje.‡Dale a Deliana tu capucha y tu jubón Corazón Salvaje.‡Donnez votre Coiffe du Coeur-sauvage et votre Gilet du Coeur-sauvage à Deliana.‡将你的野性之心兜帽与野性之心外衣交给德莉亚娜。‡將你的野性之心風帽和野性之心外衣交給德莉娜。',
  }
},
