[6844] = {
  -- Item
  'Sangue Ardente‡Горящая кровь‡Brennendes Blut‡불타는 혈액‡Sangre ardiente‡Sangre ardiente‡Sang ardent‡燃烧之血‡燃燒之血',
  nil,
  nil,
  { -- Quest
    'Umbero, o arquivista‡Умбер, архивариус‡Umber, Archivar‡기록관 움버‡Umber, el archivista‡Umber, el archivista‡Umber, Archiviste‡档案管理员阿姆伯尔‡檔案管理員阿姆伯爾',
    nil,
    'Leve o Objeto Silitídeo Incrustado para Umbero, arquivista do Círculo Cenariano, na vila de Refúgio Noturno, na Clareira da Lua.‡Отнесите покрытый коркой предмет Умберу – архивариусу Круга Кенария – в деревню Ночная Гавань, что в Лунной поляне.‡Bringt das verkrustete Silithidenobjekt zu Umber, dem Archivar des Zirkels des Cenarius, ins Dorf Nighthaven in Moonglade.‡달의 숲의 나이트헤이븐 마을에 있는 세나리온 의회의 기록관, 움버에게 딱딱한 실리시드 조각을 가져가야 합니다.‡Lleva el objeto recubierto de silítido a Umber, el archivista del Círculo Cenarion, en la aldea de Amparo de la Noche, en el Claro de la Luna.‡Lleva el objeto silítido taraceado a Umber, el archivista del Círculo Cenarion, en la aldea de Amparo de la Noche, en el Claro de la Luna.‡Apporter l’Objet silithide incrusté à Umber, l’archiviste du Cercle cénarien, au village de Havrenuit, à Reflet-de-Lune.‡将异种蝎粘液包裹的物体交给月光林地永夜港的阿姆伯尔，他是塞纳里奥议会的档案管理员。‡將異種蠍粘液包裹的物體交給月光林地永夜港的阿姆伯爾，他是塞納裏奧議會的檔案管理員。',
  }
},
[6845] = {
  -- Item
  'Pedra Ardente‡Горящий камень‡Brennender Fels‡불타는 보석‡Roca ardiente‡Roca ardiente‡Roc ardent‡燃烧之石‡燃燒之石',
  nil,
  nil,
  { -- Quest
    'Desvendando segredos do passado‡Раскрытие древних секретов‡Enthüllung von Geheimnissen der Vergangenheit‡과거의 비밀 밝히기‡El descubrimiento de los secretos del pasado‡Desvelar los secretos del pasado‡Les secrets du passé‡发现过去的秘密‡發現過去的秘密',
    nil,
    'Fale com Ravine Saturna no vilarejo de Refúgio Noturno, na Clareira da Lua.‡Поговорите с Рабином Сатурной в деревне Ночная Гавань в Лунной поляне.‡Sprecht mit Rabine Saturna im Dorf Nighthaven in Moonglade.‡달의 숲의 나이트헤이븐에 있는 라빈 사투르나와 대화해야 합니다.‡Habla con el rabino Saturna en el poblado Amparo de la Noche, en Claro de la Luna.‡Habla con Rabine Saturna en el poblado Amparo de la Noche, en Claro de la Luna.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。‡與月光林地永夜港的拉比恩·薩圖納談壹談。',
  }
},
