  nil,
  { -- Quest
    'Guarda-pernas Andassonho‡Набедренники сновидца‡Beinschützer des Traumwandlers‡꿈의감시자 다리갑옷‡Las musleras Caminasueños‡Las musleras Caminasueños‡Les garde-jambes de marcherêve‡梦游者腿甲‡夢行者腿甲',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Guarda-pernas Andassonho se você levar para ela: 1 Guarda-pernas Profanados, 20 Restos de Couro, 8 Pelegos Rústicos Curados e 1 Cristal do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать набедренники сновидца, если вы принесете ей следующее: 1 испоганенные набедренники, 20 обрывков кожи, 8 обработанных грубых шкур и 1 кристалл-источник.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch Beinschützer des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 Paar entweihte Beinschützer, 20 kampfzerschlissene Lederstücke, 8 geschmeidige unverwüstliche Bälge und 1 Nexuskristall.‡동부 역병지대의 희망의 빛 예배당에 있는 레이네에게 더럽혀진 다리보호대 1개, 닳아해진 가죽 조각 20개, 거친 경화 가죽 8개, 마력의 결정체 1개를 가져가면 꿈의감시자 다리갑옷을 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras Caminasueños si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de cuero, 8 pellejos bastos curtidos y 1 cristal nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas musleras Caminasueños si le llevas lo siguiente: 1 par de musleras profanadas, 20 restos de cuero, 8 pellejos bastos curtidos y 1 cristal nexo.‡Rayne, à la chapelle de l’Espoir de Lumière dans les Maleterres de l’Est, vous confectionnera des garde-jambes de marcherêve si vous lui apportez les choses suivantes : 1 paire de Garde-jambes désacralisés, 20 Débris d’armure en cuir, 8 Peaux robustes traitées et 1 Cristal de nexus.‡如果你将1件被玷污的腿甲、20块皮甲碎片、8个熟化毛皮和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一件梦游者腿甲。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者腿甲，只要你將下列物品帶給他:1對被褻瀆的腿甲，20個受戰爭破壞的皮甲碎塊，8塊熟化毛皮和1個聯結水晶。',
  }
},
[9088] = {
  -- Item
  '‡"Дар Артаса"‡Arthas\' Gabe‡아서스의 선물‡Ofrenda de Arthas‡Ofrenda de Arthas‡Don d\'Arthas‡阿尔萨斯的礼物‡阿薩斯的禮物',
  nil,
  nil,
  { -- Quest
    'Bacinete Andassonho‡Головной убор сновидца‡Kopfstück des Traumwandlers‡꿈의감시자 투구‡La celada Caminasueños‡La celada Caminasueños‡Le chapel de marcherêve‡梦游者头饰‡夢行者首盔',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você um Bacinete Andassonho se você levar para ela: 1 Bacinete Profanado, 15 Restos de Couro, 6 Pelegos Rústicos Curados e 2 Cristais do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать головной убор сновидца, если вы принесете ей следующее: 1 испоганенный головной убор, 15 обрывков кожи, 6 обработанных грубых шкур и 2 кристалла-источника.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch ein Kopfstück des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihtes Kopfstück, 15 kampfzerschlissene Lederstücke, 6 geschmeidige unverwüstliche Bälge und 2 Nexuskristalle.‡동부 역병지대의 희망의 빛 예배당에 있는 레이네에게 더럽혀진 면갑 1개, 닳아해진 가죽 조각 15개, 거친 경화 가죽 6개, 마력의 결정체 2개를 가져가면 꿈의감시자 투구를 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una celada Caminasueños si le llevas lo siguiente: 1 celada profanada, 15 restos de cuero, 6 pellejos bastos curtidos y 2 cristales nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará una celada Caminasueños si le llevas lo siguiente: 1 celada profanada, 15 restos de cuero, 6 pellejos bastos curtidos y 2 cristales nexo.‡Rayne, à la chapelle de l’Espoir de Lumière dans les Maleterres de l’Est, vous confectionnera un chapel de marcherêve si vous lui apportez les choses suivantes : 1 Couvre-chef désacralisé, 15 Débris d’armure en cuir, 6 Peaux robustes traitées et 2 Cristaux de nexus.‡如果你将1件被玷污的头饰、15块皮甲碎片、6个熟化毛皮和2块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一件梦游者头饰。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者首盔，只要你將下列物品帶給他:1個被褻瀆的首盔，15個受戰爭破壞的皮甲碎塊，6塊熟化毛皮和2個聯結水晶。',
  }
},
[9089] = {
  -- Item
  '‡‡‡서판: 냉기 충격 II‡‡‡‡‡石板:冰霜震擊 II',
  nil,
  nil,
  { -- Quest
    'Espaldares Andassonho‡Наплеч сновидца‡Schiftung des Traumwandlers‡꿈의감시자 어깨갑옷‡Las bufas Caminasueños‡Las bufas Caminasueños‡Les spallières de marcherêve‡梦游者肩饰‡夢行者肩甲',
    nil,
    'Rayne, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, fará para você Espaldares Andassonho se você levar para ela: 1 par de Espaldares Profanados, 12 Restos de Couro, 5 Pelegos Rústicos Curados e 1 Cristal do Nexus.‡Райн из Часовни Последней Надежды в Восточных Чумных землях готова создать наплеч сновидца, если вы принесете ей следующее: 1 испоганенный наплеч, 12 обрывков кожи, 5 обработанных грубых шкур и 1 кристалл-источник.‡Rayne bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird für Euch eine Schiftung des Traumwandlers anfertigen, wenn Ihr ihm folgende Gegenstände bringt: 1 entweihte Schiftung, 12 kampfzerschlissene Lederstücke, 5 geschmeidige unverwüstliche Bälge und 1 Nexuskristall.‡동부 역병지대의 희망의 빛 예배당에 있는 레이네에게 더럽혀진 어깨보호대 1개, 닳아해진 가죽 조각 12개, 거친 경화 가죽 5개, 마력의 결정체 1개를 가져가면 꿈의감시자 어깨갑옷을 만들어 줄 것입니다.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas Caminasueños si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de cuero, 5 pellejos bastos curtidos y 1 cristal nexo.‡Rayne de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, te hará unas bufas Caminasueños si le llevas lo siguiente: 1 par de bufas profanadas, 12 restos de cuero, 5 pellejos bastos curtidos y 1 cristal nexo.‡Rayne, à la chapelle de l’Espoir de Lumière dans les Maleterres de l’Est, vous confectionnera des spallières de marcherêve si vous lui apportez les choses suivantes : 1 paire de Spallières désacralisées, 12 Débris d’armure en cuir, 5 Peaux robustes traitées et 1 Cristal de nexus.‡如果你将1副被玷污的肩饰、12块皮甲碎片、5个熟化毛皮和1块连结水晶交给东瘟疫之地圣光之愿礼拜堂的莱茵，他会为你制作一副梦游者肩饰。‡東瘟疫之地聖光之願禮拜堂的瑞恩將為你製作夢行者肩甲，只要你將下列物品帶給他:1對被褻瀆的肩甲，12個受戰爭破壞的皮甲碎塊，5塊熟化毛皮和1個聯結水晶。',
  }
},
[9090] = {
