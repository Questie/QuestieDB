[584] = {
  nil,
  { -- Npc
    'Kazon‡Казон‡Kazon‡카존‡Kazon‡Kazon‡Kazon‡卡松‡卡松',
    nil,
  },
  nil,
  { -- Quest
    'Cabeças do Clã Sanguescalpo‡Головы племени Кровавого Скальпа‡Köpfe des Bloodscalpklans‡붉은머리부족의 머리카락‡Las cabezas de los Sangrapellejo‡Las cabezas de los Sangrapellejo‡Les têtes du clan Bloodscalp‡血顶之颅‡血頂之顱',
    nil,
    'Leve a Cabeça de Gan\'zulah e a Cabeça de Nezzliok para o caldeirão borbulhante no Acampamento Grom\'gol.‡Принесите головы Ган\'зулаха и Неззилока и положите их в бурлящий котел в лагере Гром\'гол.‡Bringt Gan\'zulahs Kopf und Nezzlioks Kopf zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥에 간줄라와 네즐뤼크의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Apporter la Tête de Gan\'zulah et la Tête de Nezzliok dans le Chaudron bouillonnant au campement Grom\'gol.‡将甘祖拉恩的头颅和奈兹里奥克的头颅带回格罗姆高营地，放入冒泡的大锅中。‡將甘祖拉恩的頭顱和奈茲裏奧克的頭顱帶回格羅姆高營地，放入冒泡的大鍋中。',
  }
},
[585] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Falando com Nezzliok‡Разговор с Неззилоком‡Mit Nezzliok sprechen‡네즐뤼크와의 대화‡Hablando con Nezzliok‡Hablando con Nezzliok‡En parlant avec Nezzliok‡奈兹里奥克‡奈茲裏奧克',
    nil,
    'Leve um Troféu de Balia\'mah, um Troféu de Ziata\'jai e um Troféu Zul\'Mamwe para o Caldeirão Borbulhante no Acampamento Grom\'gol.‡Принесите в лагерь Гром\'гол трофей из Балиа\'ма, трофей из Зиата\'джаи и трофей из Зулмамбве и положите их в бурлящий котел.‡Bringt eine Balia\'mah-Trophäe, eine Ziata\'jai-Trophäe und eine Zul\'Mamwe-Trophäe zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥으로 발리아마 전리품 해골과 지아타자이 전리품 해골, 줄맘웨 전리품 해골을 가져가야 합니다.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Apporter un Trophée de Balia\'mah, un de Ziata\'jai et un de Zul\'Mamwe dans le Chaudron bouillonnant au campement Grom\'gol.‡带回巴里亚曼战利品、赞塔加战利品和祖玛维战利品各一个，把它们放入格罗姆高营地里中的冒泡的大锅里。‡帶回巴裏亞曼戰利品、贊塔加戰利品和祖瑪維戰利品各壹個，把它們放入格羅姆高營地裏中的冒泡的大鍋裏。',
  }
},
[586] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Falando com Gan\'zulah‡Разговор с Ган\'зулахом‡Mit Gan\'zulah sprechen‡간줄라와의 대화‡Hablando con Gan\'zulah‡Hablando con Gan\'zulah‡En parlant avec Gan\'zulah‡甘祖拉恩‡甘祖拉恩',
    nil,
    'Mate 8 Caçadores Rachacrânio, 6 Caçadores de Cabeças Rachacrânio e 4 Berserkers Rachacrânio.|nLeve a Armadura Quebrada de Ana\'thek para o Caldeirão Borbulhante, que fica no Acampamento Grom\'gol.‡Убейте 8 охотников, 6 охотников за головами и 4 берсерков из клана Дробителей ЧЕрепов.|nПринесите разбитую броню Анатека к бурлящему котлу в лагере Гром\'гол.‡Tötet 8 Jäger der Skullsplitter, 6 Kopfjäger der Skullsplitter und 4 Berserker der Skullsplitter.|nBringt die zerbrochene Rüstung von Ana\'thek zum blubbernden Kessel in das Basislager von Grom\'gol.‡백골가루부족 사냥꾼 8명, 백골가루부족 인간사냥꾼 6명, 그리고 백골가루부족 광전사 4명을 처치해야 합니다.|n그롬골 주둔지에 있는 끓고 있는 가마솥으로 망가진 아나텍의 갑옷을 가져가야 합니다.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|nLleva la armadura despedazada de Ana\'thek a la caldera en ebullición del Campamento Grom\'gol.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|nLleva la armadura de Ana\'thek rota a la caldera en ebullición del Campamento Grom\'gol.‡Tuer 8 Chasseurs, 6 Chasseurs de têtes, et 4 Berserkers du clan Skullsplitter.|nApporter l\'Armure brisée d\'Ana\'thek au Chaudron bouillonnant au campement Grom\'gol.‡杀死8名劈颅猎人、6名劈颅猎头者和4名劈颅狂战士。|n将安纳希克的盔甲碎片放入格罗姆高营地中的冒泡的大锅里。‡殺死8名劈顱獵人、6名劈顱獵頭者和4名劈顱狂戰士。|n將安納希克的盔甲碎片放入格羅姆高營地中的冒泡的大鍋裏。',
  }
},
[587] = {
  nil,
  { -- Npc
    'Guerreiro Sanguescalpo‡Воин из племени Кровавого Скальпа‡Krieger der Bloodscalp‡붉은머리부족 전사‡Guerrero Cabellesangre‡Guerrero Sangrapellejo‡Guerrier Bloodscalp‡血顶战士‡血頂戰士',
    nil,
  },
  nil,
  { -- Quest
    'Levaram o rapé‡Понюшка табака‡Auf dem Schnupftabak‡코담배를 찾아서‡Tabaco rapé‡Tabaco rapé‡Faire un tabac‡鼻烟‡鼻煙',
    nil,
    'O Dígui, na Angra do Butim, quer que você leve para ele 15 trouxinhas de Rapé.‡Диг из Пиратской бухты попросил принести ему 15 понюшек табаку.‡Deeg in Booty Bay möchte, dass Ihr ihm 15 Teile Schnupftabak bringt.‡무법항에 있는 디그가 코담배 15개를 가져다 달라고 부탁했습니다.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 unidades de tabaco.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 pizcas de tabaco.‡Deeg de Baie-du-Butin veut que vous lui apportiez 15 portions de Tabac à priser.‡藏宝海湾的迪格要求你带给他15份鼻烟。‡藏寶海灣的迪格要求妳帶給他15份鼻煙。',
  }
},
[588] = {
  nil,
  { -- Npc
    'Batedor Sanguescalpo‡Разведчик из племени Кровавого Скальпа‡Späher der Bloodscalp‡붉은머리부족 정찰병‡Explorador Cabellesangre‡Explorador Sangrapellejo‡Eclaireur Bloodscalp‡血顶斥候‡血頂斥候',
    nil,
  },
  nil,
  { -- Quest
    'O destino de Yennikan‡Судьба Йеннику‡Yennikus Schicksal‡예니쿠의 생사 확인‡El destino de Yenniku‡El destino de Yenniku‡Le sort de Yenniku‡耶尼库的命运‡耶尼庫的命運',
    nil,
    'Fale com Kin\'weelay.‡Поговорите с Кин\'вилаем.‡Sprecht mit Kin\'weelay.‡킨윌레이와 대화해야 합니다.‡Habla con Kin\'weelay.‡Habla con Kin\'weelay.‡Parler à Kin\'weelay.‡与肯维雷谈一谈。‡與肯維雷談壹談。',
  }
},
[589] = {
  nil,
  { -- Npc
    'Pilhador Défias‡Погромщик из Братства Справедливости‡Plünderer der Defias‡데피아즈단 강탈자‡Saqueador Defias‡Saqueador Defias‡Pilleur défias‡迪菲亚抢劫者‡迪菲亞掠取者',
    nil,
  },
  nil,
  { -- Quest
    'Os cristais cantantes‡Поющие кристаллы‡Die singenden Kristalle‡고동치는 푸른 수정‡Los cristales canto‡Los cristales canto‡Les Eclats vibrants‡歌唱水晶‡歌唱水晶',
    nil,
    'Leve 3 Estilhaços Azuis Pulsantes para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 3 пульсирующих синих осколка Кин\'вилаю в лагерь Гром\'гол.‡Bringt 3 pulsierende blaue Splitter zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 고동치는 푸른 수정 3개를 가져가야 합니다.‡Lleva 3 fragmentos azul intenso a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 3 fragmentos azul pulsante a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 3 Eclats vibrants bleus à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回3块蓝色波光碎片。‡給格羅姆高營地的肯維雷帶回3塊藍色波光碎片。',
  }
},
[590] = {
  nil,
  { -- Npc
    'Gatuno Défias‡Мошенник из Братства Справедливости‡Ausplünderer der Defias‡데피아즈단 약탈자‡Despojador Defias‡Despojador Defias‡Pillard défias‡迪菲亚强夺者‡迪菲亞強奪者',
    nil,
  },
  nil,
  { -- Quest
    'Palavra de ladino‡Выгодная сделка‡Ein Schurkenhandel‡도적의 거래‡Un trato de pícaro‡Un trato de pícaro‡Un marché de voleur‡潜行者的交易‡潛行者的交易',
    nil,
    'Derrote Calvino Murão em Plangemortis.‡Одержите победу в схватке с Кальвином Монтеччи в Могильнике.‡Besiegt Calvin Montague in Deathknell.‡데스넬에 있는 캘빈 몬태그와 싸워서 이겨야 합니다.‡Derrota a Calvin Montague en Camposanto.‡Derrota a Calvin Montesco en Camposanto.‡Battre Calvin Montague au Glas.‡打败丧钟镇的卡尔文·蒙泰古。‡打敗喪鐘鎮的卡爾文·蒙泰古。',
  }
},
[591] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O Olho da Mente‡Око Разума‡Das Gedankenauge‡마음의 눈‡El Ojo de la Mente‡El Ojo de la mente‡La Vue de l\'Esprit‡心灵之眼‡心靈之眼',
    nil,
    'Leve o Olho da Mente para Kin\'weelay, no Acampamento Grom\'gol.‡Отнесите Око Разума Кинвилаю в лагерь Гром\'гол.‡Bringt das Gedankenauge zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 마음의 눈을 가져가야 합니다.‡Lleva el Ojo de la Mente a Kin\'weelay en el Campamento Grom\'gol.‡Lleva el Ojo de la mente a Kin\'weelay en el Campamento Grom\'gol.‡Apporter la Vue de l\'Esprit à Kin\'weelay au Campement Grom\'gol.‡将心灵之眼交给格罗姆高营地里的肯维雷。‡將心靈之眼交給格羅姆高營地裏的肯維雷。',
  }
},
[592] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Salvando Yennikan‡Спасение Йеннику‡Yennikus Rettung‡예니쿠 구출‡Salvar a Yenniku‡Salvar a Yenniku‡Il faut sauver Yenniku‡拯救耶尼库‡拯救耶尼庫',
    nil,
    'Leve a Joia de Alma Plena para Nimboya.‡Отнесите Нимбойе наполненный самоцвет Души.‡Bringt den gefüllten Seelenedelstein zu Nimboya.‡님보야에게 충만한 영혼의 보석을 가져가야 합니다.‡Lleva la gema de alma llena a Nimboya.‡Lleva la gema de alma llena a Nimboya.‡Apporter la Gemme d\'âme remplie à Nimboya.‡将装满的灵魂宝石交给尼姆布亚。‡將裝滿的靈魂寶石交給尼姆布亞。',
  }
},
[593] = {
