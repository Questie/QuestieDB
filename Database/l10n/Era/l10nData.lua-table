  nil,
  nil
},
[6132] = {
  -- Item
  '‡‡‡성서: 지혜의 문장‡‡‡‡‡聖契:智慧聖印',
  { -- Npc
    'Servidor do Urzal‡Служитель племени Иглошкурых‡Bediensteter von Razorfen‡가시덩굴일족 하수인‡Servidor de Rajacieno‡Servidor de Rajacieno‡Serviteur de Tranchebauge‡剃刀沼泽仆从‡剃刀沼澤僕從',
    nil,
  },
  nil,
  { -- Quest
    'Me tira daqui!‡Вытащи меня отсюда!‡Holt mich hier raus!‡멜릿자 브림버즐 구출 작전‡¡Sácame de aquí!‡¡Sácame de aquí!‡Faites-moi sortir de là !‡救我出去！‡救我出去！',
    nil,
    'Escolte Melizza Zumbidorla e depois fale com Guido Zumbidorla no Cemitério dos Kodos, na Desolação.‡Проводите Мелиццу Жужжалит в лагерь у Кладбища кодо в Пустошах. Поговорите с Хормицем Жужжалитом.‡Eskortiert Melizza Brimbuzzle und sprecht anschließend mit Hornizz Brimbuzzle beim Kodofriedhdof Desolace.‡멜릿자 브림버즐을 호위한 후, 잊혀진 땅의 코도 무덤에 있는 호르니즈 브림버즐과 대화해야 합니다.‡Escolta a Melizza Zumbala y luego ve a Desolace, al Cementerio de Kodos y habla con Hornizz Zumbala.‡Escolta a Melizza Zumbala, y luego habla con Hornizz Zumbala en el Cementerio de Kodos en Desolace.‡Escorter Melizza Brimbuzzle, puis parler à Hornizz Brimbuzzle au cimetière des Kodos en Désolace.‡护送梅丽萨，然后与科多兽坟场的霍恩尼兹谈一谈。‡護送梅麗薩，然後與科多獸墳場的霍恩尼茲談壹談。',
  }
},
[6133] = {
  -- Item
  '‡‡‡성서: 분노의 문장‡‡‡‡‡聖契:憤怒聖印',
  { -- Npc
    'Vulto de Elura‡Тень Элуры‡Eluras Schemen‡엘루라의 유령‡Sombra de Elura‡Sombra de Elura‡Ombre d\'Elura‡艾鲁拉的阴影‡艾魯拉的陰影',
    nil,
  },
  nil,
  { -- Quest
    'A mando do lorde patrulheiro‡Охота на cледопытов‡Das Ersuchen des Waldläuferlords‡순찰대장의 명령‡La orden del Señor de exploradores‡La orden del Señor forestal‡L\'ordre du seigneur forestier‡游侠之王的命令‡遊俠之王的命令',
    nil,
    'Vá à fronteira norte das Terras Pestilentas Orientais e recupere os Arquivos de Quel\'Thalas em algum lugar do Abrigo Quel\'Lithien.|nVocê também precisa matar 8 Patrulheiros, 8 Trilheiros e 8 Mateiros.‡Отправляйтесь в северные пределы Восточных Чумных земель и заполучите реестр Кель\'Таласа. Документ находится где-то в Сторожке Кель\'Литиен.|nТакже убейте 8 следопытов, 8 разведчиц дорог и 8 лесников.‡Begebt Euch zur nördlichsten Grenze der Östlichen Pestländer und bringt die Quel\'Thalas-Registratur zurück. Der Gegenstand befindet sich irgendwo in der Quel\'Lithien-Lodge.|nAußerdem müsst Ihr 8 Waldläufer, 8 Pfadschreiter und 8 Waldarbeiter töten.‡동부 역병지대의 북쪽 경계로 이동하여 쿠엘탈라스 기록부를 찾아야 합니다. 기록부는 쿠엘리시엔 오두막 어딘가에 있습니다.|n순찰자 8명, 길잡이 8명, 수렵꾼 8명을 해치워야 합니다.‡Viaja a la frontera norte de las Tierras de la Peste del Este y recupera el Registro de Quel\'Thalas. Se encuentra en algún lugar del Refugio Quel\'Lithien.|nTambién tienes que matar a 8 exploradores, 8 zancaminos y 8 Leñantros.‡Viaja a la frontera norte de las Tierras de la Peste del Este y recupera el Registro de Quel\'Thalas. Se encuentra en algún lugar del Refugio Quel\'Lithien.|nTambién tienes que matar a 8 forestales, 8 zancaminos y 8 leñadores.‡Aller vers la frontière nord des Maleterres de l’est et récupérer le Registre de Quel\'Thalas. L’objet se trouve quelque part dans le gîte de Quel\'Lithien.|nTuer également 8 Forestiers, 8 Eclaireurs et 8 Bûcherons.‡到东瘟疫之地的北方边界去找回奎尔萨拉斯名册，这件物品在奎尔林斯小屋的某处。|n另外你还必须杀掉8个游侠、8个巡路者和8个护林者。‡到東瘟疫之地的北方邊界去找回奎爾薩拉斯名冊，這件物品在奎爾林斯小屋的某處。|n另外妳還必須殺掉8個遊俠、8個巡路者和8個護林者。',
  }
},
[6134] = {
  -- Item
  '‡Простая мантия‡Primitiver Mantel‡구식 어깨보호대‡Cubretorso primitivo‡Cubretorso primitivo‡Mantelet primitif‡粗糙的衬肩‡粗糙的披肩',
  { -- Npc
    'Lorde Arkkoroc‡Лорд Арккорос‡Lord Arkkoroc‡제왕 아크코로크‡Lord Arkkoroc‡Lord Arkkoroc‡Seigneur Arkkoroc‡亚考罗克‡亞考羅克領主',
    nil,
  },
  nil,
  { -- Quest
    'Vá catar fantasmoplasma!‡Сбор эктоплазмы‡Geisterplasmasuche‡유령의 플라스마 모으기‡La caza de ectoplamas‡La caza de ectoplasmas‡Chasse à l\'ectoplasme‡幽灵电浆‡幽靈電漿',
    nil,
    'Leve 8 Fantasmoplasmas e o Caixote de Ímãs Fantasmais para Guido Zumbidorla na Desolação.‡Принесите 8 единиц эктоплазмы и ящик призрачных магнитов Хормицу Жужжалиту в Пустоши.‡Bringt 8 Einheiten Geisterplasma und die Kiste mit den Geistermagneten zu Hornizz Brimbuzzle in Desolace.‡잊혀진 땅의 호르니즈 브림버즐에게 유령의 플라스마 8개와 유령 유인기 상자를 가져가야 합니다.‡Lleva 8 ectoplasmas y la caja de imanes fantasmales a Hornizz Zumbala a Desolace.‡Llévale 8 ectoplasmas y el cajón de imanes fantasmales a Hornizz Zumbala en Desolace.‡Apporter 8 Fantôm-o-plasmes et la Caisse d\'aimants fantômes à Hornizz Brimbuzzle, en Désolace.‡把幽灵磁铁箱和8份幽灵电浆交给凄凉之地的霍恩尼兹。‡把幽靈磁鐵箱和8份幽靈電漿交給淒涼之地的霍恩尼茲。',
  }
},
[6135] = {
  -- Item
  '‡Примитивный килт‡Primitiver Kilt‡구식 킬트‡Falda primitiva‡Falda primitiva‡Kilt primitif‡粗糙的褶裙‡粗糙的褶裙',
  { -- Npc
    'Estalador Arkkoran‡Аркоранский трещот‡Arkkoranklacker‡딸깍이 아크코란마크루라‡Pinzador Arkkoran‡Pinzador Arkkoran‡Claqueur Arkkoran‡亚考兰响钳龙虾人‡亞考蘭響鉗龍蝦人',
    nil,
  },
  nil,
  { -- Quest
    'Ah, Quiroscuro, como vos odeio...‡Проклятый Тенекрыл‡Dämmerschwinge, oh, wie ich Euch hasse...‡혐오스런 그늘날개‡Alatardecer, cómo te odio…‡Alaocaso, cómo te odio...‡Crépuscaile, oh comme je te hais !‡暗翼蝠‡暗翼蝠',
    nil,
    'Encontre Quiroscuro e mate-o. Do cadáver, extraia um Tufo de Pele de Quiroscuro e leve para Nathanos Arauto da Praga.|nDizem que Quiroscuro vaga pelo campo ao norte do Sítio dos Marris.‡Выследите Тенекрыла и убейте его. Принесите полоску меха Тенекрыла Натаносу Гнилостеню.|nГоворят, Тенекрыл рыщет в землях к северу от имения Марриса.‡Sucht Dämmerschwinge und tötet ihn. Nehmt ein Büschel vom Fell Dämmerschwinges und bringt es zu Nathanos Blightcaller.|nMan sagt, dass Dämmerschwinge nördlich von hier durch das Land streift.‡마리스 농장 북부의 변두리를 배회하고 있는 그늘날개를 찾아 해치워야 합니다. 시체에서 그늘날개 모피 조각을 찾아 나타노스 브라이트콜러에게 가져가야 합니다.‡Encuentra a Alatardecer y mátalo. Recoge un parche de piel de Alatardecer de su cadáver y llévaselo a Nathanos Clamorinfecto.|nSe dice que Alatardecer vaga por el campo, al norte de la Hacienda de Marris.‡Encuentra a Alaocaso y mátalo. Recoge un parche de pelaje de Alaocaso de su cadáver y llévaselo a Nathanos Clamañublo.|nSe dice que Alaocaso vaga por el campo, al norte de la Hacienda de Marris.‡Trouver Crépuscaile et la tuer. Récupérer une Touffe de fourrure de Crépuscaile sur son cadavre, puis l’apporter à Nathanos le Flétrisseur.|nIl paraît que Crépuscaile hante les terres qui se trouvent au nord de la ferme des Marris.‡找到暗翼蝠并杀掉它。从尸体上取下一块暗翼蝠的皮，并把它交给纳萨诺斯·凋零者。|n据说暗翼蝠游荡在玛瑞斯农场北面的荒原上。‡找到暗翼蝠並殺掉它。從屍體上取下壹塊暗翼蝠的皮，並把它交給納薩諾斯·雕零者。|n據說暗翼蝠遊蕩在瑪瑞斯農場北面的荒原上。',
  }
},
[6136] = {
  -- Item
  '‡Рубашка головореза‡Rohlingshemd‡좀도둑 셔츠‡Camisa de matón‡Camisa de matón‡Chemise de nervi‡刺客衬衣‡刺客襯衣',
  { -- Npc
    'Moralodo Arkkoran‡Аркоранский грязекоп‡Arkkoranmatschkrabbler‡아크코란멀록 땅꾼‡Habitabosta Arkkoran‡Habitabosta Arkkoran‡Habitant du bourbier Arkkoran‡亚考兰泥浆鱼人‡亞考蘭泥漿魚人',
    nil,
  },
  nil,
  { -- Quest
    'O corpulento‡Огромный червь‡Der Korpulente‡뚱뚱보 괴물‡El corpulento‡El corpulento‡Le corpulent‡肥大的食腐虫‡肥大的食腐蟲',
    nil,
    'Encontre Brocassangre nos ermos do norte das Terras Pestilentas e destrua-o. Fale novamente com Nathanos Arauto da Praga quando tiver cumprido a missão.‡Найдите и уничтожьте Мерзкослиза в северных пустошах Восточных Чумных земель. Возвращайтесь к Натаносу Гнилостеню по выполнению задания.‡Sucht in den nördlichen Wüsten der Östlichen Pestländer nach Blutschlinger und vernichtet ihn. Kehrt zu Nathanos Blightcaller zurück, sobald Ihr diese Mission erledigt habt.‡동부 역병지대 북부 불모지에서 피고름구더기를 찾아 물리친 후 나타노스 블라이트콜러에게 돌아가야 합니다.‡Encuentra a Borelgore en las planicies del norte de las Tierras de la Peste del Este y destrúyelo. Vuelve junto a Nathanos Clamorinfecto cuando hayas cumplido la misión.‡Encuentra a Borelgore en las planicies del norte de las Tierras de la Peste del Este y destrúyelo. Vuelve junto a Nathanos Clamañublo cuando hayas cumplido la misión.‡Trouver Creusechair, dans les terres au nord des Maleterres de l’est, et le tuer. Retourner voir Nathanos le Flétrisseur quand la mission sera terminée.‡找到东瘟疫之地北方荒原中的淤血虫并消灭它。任务完成之后，向纳萨诺斯·凋零者复命。‡找到東瘟疫之地北方荒原中的淤血蟲並消滅它。任務完成之後，向納薩諾斯·雕零者復命。',
  }
},
