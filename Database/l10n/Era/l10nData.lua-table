  nil,
  { -- Quest
    'Em busca do templo‡В поисках Храма‡Auf der Suche nach dem Tempel‡신전을 찾아서‡En búsqueda del templo‡En búsqueda del templo‡À la recherche du temple‡调查神庙‡調查神廟',
    nil,
    'Brohann Barrilga, em Ventobravo, quer que você saia à procura do Templo de Atal\'Hakkar.‡Найдите Храм Атал\'Хаккара и сообщите о его местонахождении Брохану Бочкопузу из Штормграда.‡Brohann Caskbelly in Stormwind möchte, dass Ihr den Tempel von Atal\'Hakkar sucht.‡스톰윈드에 있는 브로한 캐스크벨리가 아탈학카르 신전을 찾아 달라고 부탁했습니다.‡Brohann Barriliga, en Ventormenta, quiere que busques el Templo de Atal\'Hakkar.‡Brohann Barriliga, en Ventormenta, quiere que busques El Templo de Atal\'Hakkar.‡Brohann Caskbelly à Stormwind veut que vous recherchiez le temple d\'Atal\'Hakkar.‡暴风城的布罗哈恩·铁桶要求你去找到阿塔哈卡神庙。‡暴風城的布羅哈恩·鐵桶要求妳去找到阿塔哈卡神廟。',
  }
},
[1449] = {
