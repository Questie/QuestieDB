[6341] = {
  -- Item
  '‡Зловещий светильник‡Unheimliche Stalllaterne‡으스스한 마구간 등불‡Lámpara de establo siniestra‡Lámpara de establo siniestra‡Lanterne d\'écurie sinistre‡怪异的马厩灯笼‡怪異的馬廄燈籠',
  nil,
  nil,
  { -- Quest
    'O butim de Teldrassil‡Изобилие Тельдрассила‡Die Arten von Teldrassil‡텔드랏실의 물고기‡La prodigalidad de Teldrassil‡A Darnassus‡Le don de Teldrassil‡泰达希尔的渔业‡泰達希爾的漁業',
    nil,
    'Leve a Coleção de Nessa para Vesprystus.‡Отнесите коллекцию Нессы к Веспристу.‡Bringt Nessas Sammlung zu Vesprystus.‡네사의 수집물을 베스프리스투스에게 가져가야 합니다.‡Lleva la colección de Nessa a Vesprystus.‡Habla con Fidelio para comprar un vuelo a Darnassus. Después, lleva el libro de recetas de Dolanaar a la hermana Aquinne en Darnassus.‡Apporter la Collection de Nessa à Vesprystus.‡将尼莎的货物交给维斯派塔斯。‡將尼莎的貨物交給維斯派塔斯。',
  }
},
[6342] = {
  -- Item
  '‡Формула чар для нагрудника - мана I‡Formel: Brust - Schwaches Mana‡주문식: 가슴보호구 마법부여 - 최하급 마나‡Fórmula: encantar pechera: maná menor‡Fórmula: encantar pechera: maná menor‡Formule : Enchantement de plastron (Mana mineur)‡公式：附魔胸甲 - 初级法力‡公式:附魔胸甲 - 初級法力',
  nil,
  nil,
  { -- Quest
    'Voo para Auberdine‡Полет в Аубердин‡Flug nach Auberdine‡아우버다인으로의 비행‡Vuela a Auberdine‡Vuela a Auberdine‡Vol vers Auberdine‡飞往奥伯丁‡飛往奧伯丁',
    nil,
    'Viaje de hipogrifo para Auberdine com o mestre de hipogrifos Vesprystus, depois leve a Coleção de Nessa para Laird.‡Совершите полет в Аубердин на гиппогрифе укротителя Весприста и отнесите коллекцию Нессы Лайрду.‡Bucht bei Hippogryphenmeister Vesprystus einen Hippogryphen nach Auberdine und bringt dann Nessas Sammlung zu Laird.‡히포그리프 조련사 베스프리스투스를 통해 아우버다인까지 날아간 다음 네사의 수집물을 레어드에게 전해줘야 합니다.‡Consigue un hipogrifo del maestro de hipogrifos Vesprystus, viaja a Auberdine y lleva la colección de Nessa a Laird.‡Consigue un hipogrifo del maestro de hipogrifos Vesprystus, viaja a Auberdine y lleva la colección de Nessa a Laird.‡Prenez un hippogryphe vers Auberdine chez le maître des hippogryphes Vesprystus, puis apportez la Collection de Nessa à Laird.‡从角鹰兽管理员维斯派塔斯那里租用一只角鹰兽飞到奥伯丁，然后将尼莎的货物交给莱尔德。‡從角鷹獸管理員維斯派塔斯那裏租用壹只角鷹獸飛到奧伯丁，然後將尼莎的貨物交給萊爾德。',
  }
},
[6343] = {
  -- Item
  '‡‡‡주문식: 가슴보호구 임시 마법부여 - 정신력‡‡‡‡‡公式:浸魔胸甲 - 精神',
  nil,
  nil,
  { -- Quest
    'Resposta para Nessa‡Возвращение к Нессе‡Rückkehr zu Nessa‡네사에게 돌아가기‡Vuelve con Nessa‡Regresa junto con Nyoma‡Retourner à Nessa‡飞回泰达希尔‡飛回泰達希爾',
    nil,
    'Leve a Resposta de Laird para Nessa Cantonegro.‡Принесите ответ Лайрда Нессе Песне Теней.‡Bringt Lairds Antwort zu Nessa Shadowsong.‡레어드의 답장을 네사 섀도송에게 전달해야 합니다.‡Lleva la respuesta de Laird a Nessa Cantosombrío.‡Habla con Leora para alquilar un hipogrifo y regresar a Dolanaar. Cuando llegues, entrégale la nota de la hermana Aquinne a Nyoma.‡Réponse de Laird à Nessa Shadowsong.‡将莱尔德的回信交给尼莎·影歌。‡將萊爾德的回信交給尼莎·影歌。',
  }
},
