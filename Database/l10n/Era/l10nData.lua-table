  nil,
  nil,
  { -- Quest
    'Braço abençoado‡Достойное оружие‡Gesegnete Waffe‡신성한 무기‡Brazo bendito‡Brazo bendito‡Béni soit ce bras‡格瑞曼德·艾尔默‡格瑞曼德·艾爾默',
    nil,
    'Leve o Caixote de Lingotes de Forja de Luz para Grimand Elmore em Ventobravo.‡Отнесите сундук со слитками светлостали Гриманду Элмору в Штормград.‡Bringt Grimand Elmore in Stormwind die Kiste mit Lichtschmiedeblöcken.‡스톰윈드에 있는 그리만트 엘모어에게 라이트포지 주괴가 든 상자를 가져가야 합니다.‡Lleva el cajón de lingotes Forjaluz a Grimand Elmore en Ventormenta.‡Lleva el cajón de lingotes Forjaluz a Grimand Elmore en Ventormenta.‡Apporter la Caisse de lingots de sancteforge à Grimand Elmore, à Stormwind.‡将这箱光铸铁锭交给格瑞曼德·艾尔默。‡將這箱光鑄鐵錠交給格瑞曼德·艾爾默。',
  }
},
[323] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Prova de valor‡Доказательство силы‡Bewährungsprobe‡영웅의 진가‡Prueba de valor‡Pon a prueba tu valor‡Prouver votre valeur‡证明你的实力‡證明妳的實力',
    nil,
    'Mate 15 Saqueadores Descarnados, 3 Curandeiros Descarnados e 3 Guardadores Descarnados, e depois fale novamente com Noel.‡Убейте 15 скелетов-налетчиков, 3 скелетов-лекарей и 3 скелетов-хранителей и вернитесь к Свену.‡Vernichtet 15 Skeletträuber, 3 Skelettheiler sowie 3 Skelettwärter und kehrt danach zu Sven zurück.‡해골 약탈자 15마리, 해골 치료사 3마리, 해골 문지기 3마리를 처치한 다음 스벤에게 돌아가야 합니다.‡Mata a 15 asaltantes esqueléticos, 3 sanadores esqueléticos y 3 guardas esqueléticos y vuelve a donde Sven.‡Mata a 15 asaltantes esqueléticos, 3 sanadores esqueléticos y 3 depositarios esqueléticos y vuelve a donde Sven.‡Tuer 15 Ecumeurs squelettes, 3 Soigneurs squelettes et 3 Gardiens squelettes puis retourner voir Sven.‡杀掉15个骷髅袭击者、3个骷髅医师和3个骷髅看守，然后回来见斯温。‡殺掉15個骷髏襲擊者、3個骷髏醫師和3個骷髏看守，然後回來見斯溫。',
  }
},
[324] = {
  nil,
  nil,
  -- Object
  'Veio de Tório Escasso‡Малая ториевая жила‡Kleines Thoriumvorkommen‡작은 토륨 광맥‡Filón pequeño de torio‡Filón pequeño de torio‡Petit filon de thorium‡瑟银矿脉‡瑟銀礦脈',
  { -- Quest
    'Os lingotes perdidos‡Утерянные слитки‡Die verlorenen Blöcke‡사라진 주괴‡Los lingotes perdidos‡Los lingotes perdidos‡Les lingots perdus‡丢失的铁锭‡丟失的鐵錠',
    nil,
    'Colete 5 Lingotes da Forja de Luz e fale novamente com Glorin Testaço no Pantanal.‡Соберите 5 слитков светлостали и вернитесь к Глорину Стальному Лбу в Болотину.‡Sammelt 5 Lichtschmiedeblöcke und kehrt dann zu Glorin Steelbrow im Sumpfland zurück.‡라이트포지 주괴 5개를 모은 다음 저습지에 있는 글로린 스틸브로우에게 돌아가야 합니다.‡Reúne 5 lingotes Forjaluz y vuelve con Glorin Frenteacerada en Los Humedales.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Collecter 5 Lingots de sancteforge puis retourner voir Glorin Steelbrow, dans les Paluns.‡收集5块光铸铁锭，把它们交给湿地的戈罗林·钢眉。‡收集5塊光鑄鐵錠，把它們交給濕地的戈羅林·鋼眉。',
  }
},
