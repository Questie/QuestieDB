[1358] = {
  -- Item
  '‡Ключ к сокровищу Сандера‡Ein Hinweis auf Käpt\'n Sanders Schatz‡샌더의 보물에 대한 단서‡Una pista del tesoro de Sander‡Una pista del tesoro de Sander‡Un indice menant au trésor de Sanders‡杉德尔宝藏的线索‡桑德爾寶藏的線索',
  { -- Npc
    'Minerador Grothor‡Шахтер Гротор‡Minenarbeiter Grothor‡광부 그로토르‡Minero Grothor‡Minero Grothor‡Mineur Grothor‡矿工格隆索‡礦工格隆索',
    nil,
  },
  nil,
  { -- Quest
    'Uma amostra para Hermógenes‡Образец для Хелбрима‡Probe für Helbrim‡헬브림에게 가져갈 견본‡Muestra para Helbrim‡Muestra para Helbrim‡Un échantillon pour Helbrim‡给赫布瑞姆的样本‡給赫布瑞姆的樣本',
    nil,
    'Leve a Amostra de Coração de Lobo para Boticário Hermógenes nos Sertões.‡Принесите препарат сердца волка аптекарю Хелбриму в Степи.‡Bringt die Wolfherzprobe zu Apotheker Helbrim ins Brachland.‡불모의 땅에 있는 연금술사 헬브림에게 늑대 심장 견본을 가져가야 합니다.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Apporter l\'échantillon de coeur de loup à l\'Apothicaire Helbrim dans les Tarides.‡把一箱蜘蛛毒带给贫瘠之地的药剂师赫布瑞姆。‡把壹箱蜘蛛毒帶給貧瘠之地的藥劑師赫布瑞姆。',
  }
},
[1359] = {
  -- Item
  '‡Перчатки Львиного следа‡Mit Löwen bedruckte Handschuhe‡사자무늬 장갑‡Guantes con estampado de león‡Guantes con estampado de león‡Gants marqués d\'un lion‡狮纹手套‡獅紋手套',
  nil,
  nil,
  { -- Quest
    'Entrega para Zilda‡Посылка для Зинг‡Zinges Lieferung‡진게의 소포‡Una entrega de Zinge‡Una entrega de Zinge‡Une livraison pour Zinge‡给金格的货物‡給金格的貨物',
    nil,
    'Leve a Amostras de Coração de Lobo para Boticária Zilda na Cidade Baixa.‡Отнесите препараты сердца волка аптекарю Зинг в Подгород.‡Bringt die Wolfherzproben zu Apothekerin Zinge nach Undercity.‡언더시티에 있는 연금술사 진게에게 늑대 심장 견본을 가져가야 합니다.‡Lleva las muestras de corazón de lobo al boticario Zinge en Entrañas.‡Lleva las muestras de corazón de lobo a la boticaria Zinge en Entrañas.‡Apporter les Echantillons de coeurs de loups à l\'apothicaire Zinge à Undercity.‡将狼心样本交给幽暗城的药剂师金格。‡將狼心樣本交給幽暗城的藥劑師金格。',
  }
},
[1360] = {
  -- Item
  '‡Плетеные перчатки Штормграда‡Sturmwindkettenpanzerhandschuhe‡스톰윈드 사슬 장갑‡Guantes de anillas de Ventormenta‡Guantes de anillas de Ventormenta‡Gantelets de Hurlevent en mailles‡暴风城链甲手套‡暴風城鍊甲手套',
  { -- Npc
    'Minerador Grumnal‡Шахтер Грамнал‡Minenarbeiter Grumnal‡광부 그룸날‡Minero Grumnal‡Minero Grumnal‡Mineur Grumnal‡矿工格鲁纳尔‡礦工格魯納爾',
    nil,
  },
  nil,
  { -- Quest
    'Tesouros recuperados‡Возвращенное сокровище‡Wiederbeschaffte Schätze‡보물 찾기‡Los tesoros reclamados‡Los tesoros reclamados‡Des Trésors à recouvrer‡失而复得‡失而復得',
    nil,
    'Pegue a posse querida de Krom Braçoforte em seu baú no Saguão Norte de Uldaman e leve-a para ele na Altaforja.‡Достаньте сокровище Крома Крепкорука из сундука в северном зале Ульдамана и принесите ему в Стальгорн.‡Holt Krom Stoutarms wertvollen Besitz aus seiner Truhe in der nördlichen Bankenhalle von Uldaman und bringt den Schatz zu ihm nach Ironforge.‡울다만의 북쪽 대전당에 있는 궤짝에서 크롬 스타우트암의 보물을 찾아서 아이언포지에 있는 크롬 스타우트암에게 가져다주어야 합니다.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Récupérer les biens de Krom Stoutarm dans son coffre dans le hall commun nord d\'Uldaman et les lui rapporter à Ironforge.‡到奥达曼的北部大厅去找到克罗姆·粗臂的箱子，从里面拿出他的宝贵财产，然后回到铁炉堡把东西交给他。‡到奧達曼的北部大廳去找到克羅姆·粗臂的箱子，從裏面拿出他的寶貴財產，然後回到鐵爐堡把東西交給他。',
  }
},
[1361] = {
  -- Item
  '‡Еще один ключ к сокровищу Сандерса.‡Ein weiterer Hinweis auf Käpt\'n Sanders Schatz‡샌더의 보물에 대한 또 다른 단서‡Otra pista del tesoro de Sander‡Otra pista del tesoro de Sander‡Un autre indice menant au trésor de Sanders‡杉德尔宝藏的另一个线索‡桑德爾寶藏的另一個線索',
  nil,
  nil,
  { -- Quest
    'Regthar Portões-da-morte‡Регтар Врата Смерти‡Regthar Deathgate‡렉타르 데스게이트‡Regthar Portamorta‡Regthar Portamorta‡Regthar Deathgate‡雷戈萨·死门‡雷戈薩·死門',
    nil,
    'Fale com Regthar Portões-da-morte.‡Поговорите с Регтаром Врата Смерти.‡Sprecht mit Regthar Deathgate.‡렉타르 데스게이트와 대화해야 합니다.‡Habla con Regthar Portamorta.‡Habla con Regthar Portamorta.‡Discuter avec Regthar Deathgate.‡和雷戈萨·死门谈一谈。‡和雷戈薩·死門談壹談。',
  }
},
[1362] = {
  -- Item
  '‡Последний ключ к сокровищу Сандерса.‡Letzter Hinweis auf Käpt\'n Sanders Schatz‡샌더의 보물에 대한 최후의 단서‡Pista final del tesoro de Sander‡Pista final del tesoro de Sander‡Le dernier indice menant au trésor de Sanders‡杉德尔宝藏的最终线索‡桑德爾寶藏的最終線索',
  { -- Npc
    'Gothor Brumn‡Готор Брюм‡Gothor Brumn‡고더 브럼‡Gothor Brumn‡Gothor Brumn‡Gothor Brumn‡高索·布鲁姆‡高索·布魯姆',
    'Armoraria‡Бронник‡Rüstungsschmied‡방어구제작자‡Armero‡Armero‡Armurier‡护甲商‡護甲商',
  },
  nil,
  { -- Quest
    'Os Kolkar de Desolação‡Кентавры Пустошей‡Die Kolkar von Desolace‡잊혀진 땅의 콜카르‡Los Kolkar de Desolace‡Los Kolkar de Desolace‡Les Kolkar de Désolace‡凄凉之地的科卡尔部族‡淒涼之地的科卡爾部族',
    nil,
    'Fale com o Felgur Doiscortes no Entreposto do Espírito que Anda, em Desolação.‡Найдите на Заставе Скитающихся Духов в Пустошах Фелгура Бью-Двоих и поговорите с ним.‡Sprecht mit Felgur Twocuts beim Geistwandlerposten in Desolace.‡잊혀진 땅의 침묵의 초소에 있는 펠굴 투커츠와 대화해야 합니다.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Discuter avec Felgur Twocuts au poste de Rôdeur-fantôme en Désolace.‡和凄凉之地幽灵岗哨的费古尔·双刃谈一谈。‡和淒涼之地幽靈崗哨的費古爾·雙刃談壹談。',
  }
},
[1363] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Fale com o Acólito Dellis em Ventobravo.‡Поговорите с послушником Деллисом в Штормграде.‡Sprecht mit Akolyt Dellis in Stormwind.‡스톰윈드에 있는 수행사제 델리스와 대화해야 합니다.‡Habla con el acólito Dellis en Ventormenta.‡Habla con el acólito Dellis en Ventormenta.‡Parler à l\'acolyte Dellis à Stormwind.‡与暴风城里的助手迪利斯谈一谈。‡與暴風城裏的助手迪利斯談壹談。',
  }
},
[1364] = {
  -- Item
  '‡Рваный кожаный жилет‡Struppige Lederweste‡너덜너덜한 가죽 조끼‡Jubón de cuero harapiento‡Jubón de cuero harapiento‡Gilet rapiécé en cuir‡粗糙的皮外衣‡粗糙的皮外衣',
  { -- Npc
    'Balgaras, o Asqueroso‡Балгорас Нечистый‡Balgaras der Niederträchtige‡불한당 발가라스‡Balgaras el Hediondo‡Balgaras el Hediondo‡Balgaras le Crasseux‡邪恶的巴尔加拉斯‡邪惡的巴爾加拉斯',
    nil,
  },
  nil,
  { -- Quest
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Recupere os Ensaios de Hadggar sobre Convergência Dimensional e entregue-os para Vigia Mahar Ba, na Bastilha de Etergarde.‡Верните "Рассуждения Кадгара о пространственной сходимости" и доставьте сочинение дозорному Махару Ба в Крепость Стражей Пустоты.‡Rettet Khadgars \'Abhandlungen über dimensionale Konvergenz\' und bringt sie zu Behüter Mahar Ba in der Burg Nethergarde.‡차원의 집합점에 대한 카드가의 평론을 찾아 네더가드 요새에 있는 감시자 마할 바에게 전해야 합니다.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Retrouver les Essais de Khadgar sur la convergence dimensionnelle et les porter au Gardien Mahar Ba au Rempart-du-Néant.‡夺回《卡德加的空间收敛研究笔记》，将它送给守望堡的看守者马哈尔巴。‡奪回《卡德加的空間收斂研究筆記》，將它送給守望堡的看守者馬哈爾巴。',
  }
},
[1365] = {
  nil,
  { -- Npc
    'Goli Krumn‡Голи Крамн‡Goli Krumn‡골리 크룸‡Goli Krumn‡Goli Krumn‡Goli Krumn‡高里·克拉姆‡高里·克拉姆',
    nil,
  },
  nil,
  { -- Quest
    'Khan Dez\'hepah‡Вождь Дез\'хеп‡Khan Dez\'hepah‡칸 데즈헤파‡Khan Dez\'hepah‡Khan Dez\'hepah‡Khan Dez\'hepah‡戴兹帕可汗‡戴茲帕可汗',
    nil,
    'Leve a Cabeça de Khan Dez\'hepah para Felgur Doiscortes na Desolação.‡Принесиет Фелгуру Бью-Двоих голову вождя Дез\'хепа.‡Bringt Khan Dez\'hepahs Kopf zu Felgur Twocuts in Desolace.‡칸 데즈헤파를 처치하고 그 증거로 그의 머리카락을 잊혀진 땅에 있는 펠굴 투커츠에게 가져가야 합니다.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Rapporter la Tête du khan Dez\'hepah à Felgur Twocuts en Désolace.‡把戴兹帕可汗的头颅交给凄凉之地的费古尔·双刃。‡把戴茲帕可汗的頭顱交給淒涼之地的費古爾·雙刃。',
  }
},
[1366] = {
  -- Item
  '‡Рваные кожаные штаны‡Struppige Lederhose‡너덜너덜한 가죽 바지‡Pantalones de cuero harapiento‡Pantalones de cuero harapiento‡Pantalon rapiécé en cuir‡粗糙的皮短裤‡粗糙的皮便褲',
  { -- Npc
    'Adam‡Адам‡Adam‡아담‡Adam‡Adam‡Adam‡亚当‡亞當',
    nil,
  },
  nil,
  { -- Quest
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Felgur Doiscortes em Desolação.‡Принесите в Пустоши 15 ушей кентавров и отдайте Фелгуру Бью-Двоих.‡Bringt 15 Zentaurenohren zu Felgur Twocuts in Desolace.‡잊혀진 땅의 펠굴 투커츠에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Apporter 15 Oreilles de centaure à Felgur Twocuts, en Désolace.‡收集15只半人马的耳朵，把它们交给凄凉之地的费古尔·双刃。‡收集15只半人馬的耳朵，把它們交給淒涼之地的費古爾·雙刃。',
  }
},
[1367] = {
  -- Item
  '‡Рваные кожаные сапоги‡Struppige Lederstiefel‡너덜너덜한 가죽 장화‡Botas de cuero harapiento‡Botas de cuero harapiento‡Bottes rapiécées en cuir‡粗糙的皮靴‡粗糙的皮靴',
  { -- Npc
    'Gui‡Билли‡Billy‡빌리‡Billy‡Billy‡Billy‡比利‡比利',
    nil,
  },
  nil,
  { -- Quest
    'Aliança com os Magram‡Союз с племенем Маграм‡Allianz mit den Magram‡마그람 동맹‡La alianza con los Magram‡La alianza con los Magram‡L\'alliance avec les Magram‡玛格拉姆部族‡瑪格拉姆部族',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게서 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux envers vous, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆部族建立良好的關系，然後和瓦魯格談壹談。',
  }
},
[1368] = {
  -- Item
  '‡Рваные кожаные перчатки‡Struppige Lederhandschuhe‡너덜너덜한 가죽 장갑‡Guantes de cuero harapiento‡Guantes de cuero harapiento‡Gants rapiécés en cuir‡粗糙的皮手套‡粗糙的皮手套',
  { -- Npc
    'Justino‡Джастин‡Justin‡저스틴‡Justin‡Justin‡Justin‡贾斯廷‡賈斯廷',
    nil,
  },
  nil,
  { -- Quest
    'Aliança com os Gelkis‡Союз с племенем Гелкис‡Allianz mit den Gelkis‡겔키스 동맹‡La alianza con los Gelkis‡La alianza con los Gelkis‡L\'alliance avec les Gelkis‡吉尔吉斯部族‡吉爾吉斯部族',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut Euch einen Ruf als freundliche Person bei den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게서 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Faire en sorte que les Gelkis deviennent Amicaux envers vous, puis aller parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯部族建立良好的關系，然後和智者烏泰克談壹談。',
  }
},
[1369] = {
  -- Item
  '‡Рваный кожаный пояс‡Struppiger Ledergürtel‡너덜너덜한 가죽 허리띠‡Cinturón de cuero harapiento‡Cinturón de cuero harapiento‡Ceinture rapiécée en cuir‡粗糙的皮带‡粗糙的皮帶',
  nil,
  nil,
  { -- Quest
    'Lágrimas partidas‡Россыпи Слез‡Zerbrochene Tränen‡눈물의 파편‡Lágrimas rotas‡Lágrimas rotas‡Larmes brisées‡破碎之泪‡破碎之淚',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Lágrimas Partidas para Warug na Aldeia Magram.‡Для поддержания отношений с племенем Маграм принесите 3 кристалла Россыпи Слез Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt 3 zerbrochene Tränen zu Warug im Dorf Magram.‡마그람에게 우호적인 평판을 유지하면서 마그람 마을에 있는 와루그에게 눈물의 파편 3개를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Maintenir votre réputation auprès des Magram et ramener 3 Larmes brisées à Warug au village des Magram.‡继续和玛格拉姆部族保持良好的关系，把3块破碎之泪交给玛格拉姆村庄的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關系，把3塊破碎之淚交給瑪格拉姆村莊的瓦魯格。',
  }
},
[1370] = {
  -- Item
  '‡Рваные кожаные наручи‡Struppige Lederarmschienen‡너덜너덜한 가죽 팔보호구‡Brazales de cuero harapiento‡Brazales de cuero harapiento‡Brassards rapiécés en cuir‡粗糙的皮护腕‡粗糙的皮護腕',
  { -- Npc
    'Breno‡Брэндон‡Brandon‡브랜든‡Brandon‡Brandon‡Brandon‡布兰顿‡布蘭頓',
    nil,
  },
  nil,
  { -- Quest
    'Assalto à dispensa‡Похищение припасов‡Diebstahl von Vorräten‡보급품 훔치기‡¡A robar provisiones!‡¡A robar provisiones!‡Voleur de viande‡偷取物资‡偷取物資',
    nil,
    'Entregue 6 sacos de Carne Mal Desidratada para Uthek, a Sábia, na Aldeia Gelkis.‡Принесите 6 мешков недосушенного мяса в деревню Гелкис и отдайте Уте Мудрой.‡Bringt 6 Taschen primitiv getrocknetes Fleisch zu Uthek der Weisen im Dorf Gelkis.‡겔키스 마을에 있는 현자 우텍에게 말린 고기 6개를 가져가야 합니다.‡Lleva 6 bolsas de Crudely Dried Meat a Uthek la Sabia al Poblado Gelkis.‡Lleva 6 bolsas de carne secada de forma rudimentaria a Uthek la Sabia al Poblado Gelkis.‡Rapporter 6 Sacs de viande grossièrement séchée à Uthek la Sage au village des Gelkis.‡把6包粗制干肉交给吉尔吉斯村的智者乌泰克。‡把6包粗制幹肉交給吉爾吉斯村的智者烏泰克。',
  }
},
[1371] = {
  nil,
  { -- Npc
    'Roman‡Роман‡Roman‡로만‡Roman‡Roman‡Roman‡罗曼‡羅曼',
    nil,
  },
  nil,
  { -- Quest
    'Engenhoca para Warug‡Игрушка для Варуга‡Gizmo für Warug‡와루그의 물건‡Un cacharro para Warug‡Un cacharro para Warug‡Un Bidule pour Warug‡瓦鲁格的玩具‡瓦魯格的玩具',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Bonecos-alvo Avançado para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите усовершенствованный манекен-мишень Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt eine hochentwickelte Zielattrappe zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 고급 표적 허수아비를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzada a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzado a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram et rapporter un Leurre perfectionné à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，给玛格拉姆村的瓦鲁格找到一个高级假人。‡繼續和瑪格拉姆部族保持良好的關系，給瑪格拉姆村的瓦魯格找到壹個高級假人。',
  }
},
[1372] = {
  -- Item
  '‡Рваный плащ‡Struppiger Umhang‡너덜너덜한 망토‡Capa harapienta‡Capa harapienta‡Cape déchirée‡粗糙的皮质披风‡粗糙的皮質披風',
  nil,
  nil,
  { -- Quest
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Fale com Boticário Faustino no Refúgio dos Mendigos.‡Поговорите с аптекарем Фаустином в Приюте Бродяги.‡Sprecht mit Apotheker Faustin im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 연금술사 파우스틴과 대화해야 합니다.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Parler à l’Apothicaire Faustin, au Repaire des mendiants.‡到乞丐鬼屋去和药剂师法奥斯丁谈一谈。‡到乞丐鬼屋去和藥劑師法奧斯丁談壹談。',
  }
},
[1373] = {
  nil,
  { -- Npc
    'Jarven Cervaforte‡Ярвен Громовар‡Jarven Donnerbräu‡야벤 썬더브루‡Javen Cebatruenos‡Javen Cebatruenos‡Jarven Thunderbrew‡加文·雷酒‡加文·雷酒',
    nil,
  },
  nil,
  { -- Quest
    'Ongekan‡Онгеку‡Ongeku‡온게쿠‡Ongeku‡Ongeku‡Ongeku‡盎格库尔‡盎格庫爾',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue um Estilhaço de Draenetista para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите осколок дренейского аметиста Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt einen Draenethystsplitter zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 드레니시스트 파편 하나를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento de draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento de draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis et rapporter un Eclat de draenéthyste à Uthek la Sage au village des Gelkis, en Désolace.‡继续和吉尔吉斯部族保持良好的关系，并把德莱尼水晶碎片交给凄凉之地吉尔吉斯村的智者乌泰克。‡繼續和吉爾吉斯部族保持良好的關系，並把德萊尼水晶碎片交給淒涼之地吉爾吉斯村的智者烏泰克。',
  }
},
[1374] = {
  -- Item
  '‡Изношенные ботинки‡Ausgefranste Schuhe‡너덜너덜한 신발‡Zapatos deshilachados‡Zapatos deshilachados‡Chaussures râpées‡磨损的鞋‡磨損的輕鞋',
  { -- Npc
    'Rejold Cervevada‡Регольд Ячменовар‡Rejold Gerstenbräu‡레욜트 발리브루‡Rejold Cebadiz‡Rejold Cebadiz‡Rejold Barleybrew‡雷杰德·麦酒‡雷傑德·麥酒',
    nil,
