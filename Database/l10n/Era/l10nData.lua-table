  { -- Quest
    'Simples subterfúgio‡Простая уловка‡Einfache List‡순진한 핑계‡Un simple subterfugio‡Un simple subterfugio‡Simple subterfuge‡国王的财宝‡國王的財寶',
    nil,
    'Encontre Onin MacHammar em Gnomeregan.‡Найдите Онина Макмолота в Гномрегане.‡Sucht Onin MacHammar bei Gnomeregan.‡놈리건에서 오닌 맥해머를 찾아야 합니다.‡Encuentra a Onin MacHammar cerca de Gnomeregan.‡Encuentra a Onin MacHammar cerca de Gnomeregan.‡Trouver Onin MacHammar à Gnomeregan.‡在诺莫瑞根附近找到奥宁·雨锤。‡在諾莫瑞根附近找到奧寧·雨錘。',
  }
},
[2239] = {
  -- Item
  'O Anel do Coletor‡Кольцо Вымогателя‡Der Ring des Sammlers‡징세관의 반지‡El anillo del coleccionista‡El anillo del coleccionista‡Anneau du Collecteur‡收货人的戒指‡收貨人的戒指',
  { -- Npc
    'Drull‡Друлл‡Drull‡드럴‡Drull‡Drull‡Drull‡德鲁尔‡德盧爾',
    nil,
  },
  nil,
  { -- Quest
    'Relatório de Onin‡Донесение Онина‡Onins Bericht‡오닌의 보고서‡El informe de Onin‡El informe de Onin‡Rapport d\'Onin‡奥宁的报告‡奧寧的報告',
    nil,
    'Leve o relatório de Onin para Hulfdan em Altaforja.‡Доставьте донесение Онина Хальфдану в Стальгорн.‡Bringt Onins Bericht zu Hulfdan in Ironforge.‡아이언포지에 있는 훌프단에게 오닌의 보고서를 가져가야 합니다.‡Lleva el informe de Onin a Hulfdan a Forjaz.‡Lleva el informe de Onin a Hulfdan a Forjaz.‡Porter le rapport d\'Onin à Hulfdan à Ironforge.‡把奥宁的报告交给铁炉堡的霍夫丹。‡把奧寧的報告交給鐵爐堡的霍夫丹。',
  }
},
[2240] = {
  -- Item
  '‡Рваная накидка‡Unverwüstliches Cape‡주름진 단망토‡Manteo basto‡Manteo basto‡Cape robuste‡皱褶斗篷‡粗厚斗篷',
  { -- Npc
    'Salteador da Camarilha‡Преступник Синдиката‡Schleicher des Syndikats‡비밀결사대 노상강도‡Asaltante de caminos del Sindicato‡Asaltante de caminos de la Hermandad‡Détrousseur du Syndicat‡辛迪加劫匪‡辛迪加劫匪',
    nil,
  },
  nil,
  { -- Quest
    'A câmara oculta‡Потайной чертог‡Die geheime Kammer‡비밀 석실‡La cámara oculta‡La cámara oculta‡La Chambre secrète‡密室‡密室',
    nil,
    'Leia o Diário de Baelog, explore a câmara oculta, depois fale com o Prospector Lançatroz.‡Прочитайте журнал Бейлога, исследуйте, потайной чертог и потом доложите об увиденном геологу Грозовой Вершине.‡Lest Baelogs Tagebuch, erforscht die geheime Kammer und erstattet dann Ausgrabungsleiter Stormpike Bericht.‡밸로그의 일지를 읽고 비밀 석실을 조사한 후 발굴조사단장 스톰파이크에게 보고해야 합니다.‡Lee el diario de Baelog, inspecciona la cámara oculta y ve a informar al prospector Pico Tormenta.‡Lee el diario de Baelog, inspecciona la cámara oculta y ve a informar al prospector Pico Tormenta.‡Lire le journal de Baelog, explorer la Chambre secrète, puis rendre compte au Prospecteur Stormpike.‡阅读巴尔洛戈的日记，探索密室，然后向铁炉堡的勘察员塔伯斯·雷矛汇报。‡閱讀巴爾洛戈的日記，探索密室，然後向鐵爐堡的勘察員塔伯斯·雷矛匯報。',
  }
},
[2241] = {
  -- Item
  '‡Накидка десперадо‡Desperadocape‡무법자 단망토‡Manteo de forajido‡Manteo de forajido‡Cape de desperado‡亡命者斗篷‡亡命者斗篷',
  { -- Npc
    'Ladrão da Camarilha‡Вор Синдиката‡Dieb des Syndikats‡비밀결사대 도둑‡Ladrón del Sindicato‡Ladrón de la Hermandad‡Larron du Syndicat‡辛迪加窃贼‡辛迪加竊賊',
    nil,
  },
  nil,
  { -- Quest
    'Amor só dura em liberdade‡Катись, яблочко...‡Der Apfel fällt‡짝사랑‡Cuando cae la manzana‡Cuando cae la manzana‡Pomme d\'amour‡詹诺克的花‡詹諾克的花',
    nil,
    'Leve a flor de Jannok para Syurna em Darnassus.‡Отнесите розу Джаннока Сиарне в Дарнасс.‡Bringt Jannoks Rose zu Syurna in Darnassus.‡다르나서스에 있는 시우르나에게 잔노크의 장미를 가져가야 합니다.‡Llévale la rosa de Jannok a Syurna, que está en Darnassus.‡Llévale la rosa de Jannok a Syurna, que está en Darnassus.‡Porter la fleur de Jannok à Syurna à Darnassus.‡把詹诺克的玫瑰带给达纳苏斯的塞尤娜。‡把詹諾克的玫瑰帶給達納蘇斯的塞尤娜。',
  }
},
[2242] = {
  nil,
  { -- Npc
    'Espião da Camarilha‡Шпион Синдиката‡Spion des Syndikats‡비밀결사대 염탐꾼‡Espía del Sindicato‡Espía de la Hermandad‡Espion du Syndicat‡辛迪加间谍‡辛迪加間諜',
    nil,
  },
  nil,
  { -- Quest
    'O destino chama‡Зов судьбы‡Das Schicksal ruft‡운명의 부름‡La llamada del destino‡La llamada del destino‡L\'appel du destin‡命运的召唤‡命運的召喚',
    nil,
    'Encontre Sethir, o Antigo, e leve qualquer pista a respeito de Syurna.‡Найдите Сетира Древнего и принесите все, что сумеете найти, Сиарне.‡Sucht Sethir den Uralten und bringt alle Hinweise, die Ihr finden könnt, zu Syurna.‡고대정령 세시르를 찾아 시우르나에게 가져갈 만한 어떤 단서든지 찾아와야 합니다.‡Encuentra a Sethir el Ancestro y ve a contarle todo lo que descubras a Syurna.‡Encuentra a Sethir el Ancestro y ve a contarle todo lo que descubras a Syurna.‡Trouver Sethir l’Ancien et rapporter tout indice découvert à Syurna.‡找到远古的塞希尔，带回任何你可能发现的线索。‡找到遠古的塞希爾，帶回任何妳可能發現的線索。',
  }
},
