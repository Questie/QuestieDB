  nil,
  { -- Quest
    'Bandanas vermelhas de couro‡Красные кожаные банданы‡Rote Lederkopftücher‡붉은 가죽 복면‡Pañuelos rojos de cuero‡Pañuelos rojos de cuero‡Les masques en cuir rouge‡红色皮质面罩‡紅色皮質面罩',
    nil,
    'Leve 15 Bandanas Vermelhas de Couro para o Batedor Galiaan no Morro da Sentinela.‡Принесите разведчику Галиану на Сторожевой холм 15 красных кожаных бандан.‡Bringt 15 rote Lederkopftücher auf die Späherkuppe zu Späher Galiaan.‡감시의 언덕의 정찰병 갈리안에게 붉은 가죽 복면 15개를 가져가야 합니다.‡Lleva 15 pañuelos de cuero rojo al explorador Galiaan en la Colina del Centinela.‡Lleva 15 pañuelos de cuero rojo al explorador Galiaan en la Colina del Centinela.‡Apporter 15 Masques en cuir rouge à l\'éclaireur Galiaan à la Colline des sentinelles.‡给哨兵岭的哨兵加里安带回15条红色皮质面罩。‡給哨兵嶺的哨兵加裏安帶回15條紅色皮質面罩。',
  }
},
[154] = {
  -- Item
  '‡Простая мантия‡Primitiver Mantel‡구식 어깨보호대‡Cubretorso primitivo‡Cubretorso primitivo‡Mantelet primitif‡粗糙的衬肩‡粗糙的披肩',
  { -- Npc
    'Ripa-carne Maior‡Большой шкуродер‡Großer Fleischreißer‡거대한 식인독수리‡Desgarrador mayor‡Desgarrador mayor‡Grand déchireur‡大碎尸鸟‡大碎屍鳥',
    nil,
  },
  nil,
  { -- Quest
    'Devolva o pente‡Гребень для Эвы‡Rückkehr mit dem Kamm‡유령의 빗 돌려주기‡Devuelve el peine‡Devuelve el peine‡Rendre le peigne‡归还梳子‡歸還梳子',
    nil,
    'Devolva o Pente de Fantasma para Madame Eva na Vila Sombria.‡Верните гребень для призрачных волос мадам Еве в Темнолесье.‡Bringt den Geisterhaarkamm zu Madame Eva nach Dunkelhain.‡다크샤이어의 에바 부인에게 유령의 머리빗을 다시 가져가야 합니다.‡Lleva el peine de fantasma a Lady Eva a Villa Oscura.‡Lleva el peine de fantasma a Lady Eva a Villa Oscura.‡Rapporter le Peigne spectral à Madame Eva à Darkshire.‡把幽灵的梳子拿回去交给夜色镇的伊瓦夫人。‡把幽靈的梳子拿回去交給夜色鎮的伊瓦夫人。',
  }
},
[155] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Escolte o Traidor Défias ao esconderijo secreto da Irmandade Défias. Quando o Traidor Défias mostrar onde VanCleef e seus comparsas estão escondidos, retorne a Miguel Mantoforte com a informação.‡Сопроводите предателя к тайному убежищу Братства Справедливости. Когда он покажет, где прячутся ван Клиф и его люди, вернитесь к Гриану Камнегриву.‡Eskortiert den Verräter der Defias zum Geheimversteck der Defiasbruderschaft. Sobald der Verräter der Defias Euch gezeigt hat, wo sich van Cleef und seine Männer aufhalten, kehrt Ihr mit der Information zu Gryan Stoutmantle zurück.‡데피아즈단의 비밀 은신처까지 데피아즈단 변절자를 호위해 가야 합니다. 데피아즈단의 변절자가 밴클리프와 그의 동료가 숨어 있는 곳까지 안내한 이후에 그라이언 스타우트맨틀에게 돌아가 그 위치를 알려야 합니다.‡Escolta al Traidor de los Defias a la ladronera secreta de la Hermandad Defias. Cuando el Traidor de los Defias te enseñe dónde se esconden VanCleef y sus hombres, regresa con Gryan Mantorrecio con toda la información.‡Escolta al Traidor de los Defias a la ladronera secreta de la Hermandad Defias. Cuando el Traidor de los Defias te enseñe dónde se esconden VanCleef y sus hombres, regresa con Gryan Mantorrecio con toda la información.‡Escortez le Traître défias jusqu\'à la cache secrète de la Confrérie défias. Lorsque vous saurez où se cachent VanCleef et ses hommes, rapportez l\'information à Gryan Stoutmantle.‡护送迪菲亚叛徒前往迪菲亚兄弟会的秘密藏身处。迪菲亚叛徒把你带到范克里夫和他的手下的巢穴之后，尽快回去向格里安·斯托曼汇报相关信息。‡護送迪菲亞叛徒前往迪菲亞兄弟會的秘密藏身處。迪菲亞叛徒把妳帶到範克裏夫和他的手下的巢穴之後，盡快回去向格裏安·斯托曼匯報相關信息。',
  }
},
[156] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Coleta de flores do mal‡Сбор цветков гнили‡Das Sammeln von Faulblüten‡시든 꽃 모으기‡Busca flores podridas‡Busca flores podridas‡Cueillette de Racines pourries‡收集腐败之花‡收集腐敗之花',
    nil,
    'Colete 8 Flores do Mal e entregue-as ao Taberneiro Oseias em Vila Sombria.‡Соберите 8 цветков гнили и отнесите их хозяину таверны Смиттсу.‡Sammelt 8 Faulblüten und bringt sie nach Dunkelhain zu Schankwart Smitts.‡시든 꽃 8송이를 모아 다크샤이어의 선술집주인 스미츠에게 가져가야 합니다.‡Recoge 8 flores podridas y llévaselas al tabernero Smitts a Villa Oscura.‡Recoge 8 flores podridas y llévaselas al tabernero Smitts a Villa Oscura.‡Rapporter 8 Racines pourries à Smitts l\'aubergiste de Darkshire.‡收集8个腐败之花，交给夜色镇的旅店店主斯密茨。‡收集8個腐敗之花，交給夜色鎮的旅店店主斯密茨。',
  }
},
[157] = {
  nil,
  { -- Npc
    'Goretusco‡Жутеклык‡Geiferzahn‡뿔엄니멧돼지‡Dentosangre‡Dentosangre‡Broche-tripes‡血牙野猪‡血牙野豬',
    nil,
  },
  nil,
  { -- Quest
    'Entregue a linha‡Доставка ниток‡Abliefern des Fadens‡머리 가닥 전달‡Devolver el pelo‡Devolver el pelo‡Apporter la mèche‡幽灵的发丝‡幽靈的發絲',
    nil,
    'Leve a Linha de Cabelo de Fantasma para Abercrombie na cabana dele, que fica ao norte do Cemitério de Monte Corvo.‡Принесите нить из призрачных волос в хижину на севере от кладбища Вороньего холма и отдайте ее Аберкромби.‡Bringt Calvinius den Geisterhaarfaden in seine Hütte nördlich des Friedhofs von Rabenflucht.‡까마귀 언덕 묘지 북쪽의 통나무집에 있는 에이버크롬비에게 유령의 머리 가닥을 가져가야 합니다.‡Lleva el hilo de pelo de fantasma a Abercrombie, a su choza al norte del Cementerio del Cerro del Cuervo.‡Lleva el hilo de cabello de fantasma a Abercrombie, a su choza al norte del Cementerio del Cerro del Cuervo.‡Apporter la Mèche de cheveux fantômes à Abercrombie, dans sa cabane, au nord du cimetière de Colline-aux-Corbeaux.‡把幽灵的发丝交给亚伯克隆比，他住在乌鸦岭墓地北边的房子里。‡把幽靈的發絲交給亞伯克隆比，他住在烏鴉嶺墓地北邊的房子裏。',
  }
},
[158] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Suco de zumbi‡Сок зомби‡Zombiesaft‡좀비 독주‡Zumo de zombi‡Zumo de zombi‡Suc de zombie‡僵尸‡僵屍',
    nil,
    'Fale com o Taberneiro Oseias.‡Поговорите с хозяином таверны Смиттсом.‡Sprecht mit Schankwart Smitts.‡선술집주인 스미츠와 대화해야 합니다.‡Havla con el tabernero Smitts.‡Habla con el tabernero Smitts.‡S’adresser à Smitts l\'aubergiste.‡去和旅店店主斯密茨谈一谈。‡去和旅店店主斯密茨談壹談。',
  }
},
[159] = {
  -- Item
  'Água Refrescante da Fonte‡Освежающая ключевая вода‡Erfrischendes Quellwasser‡맑은 샘물‡Agua de manantial refrescante‡Agua de manantial refrescante‡Eau de source‡清凉的泉水‡清涼的泉水',
  nil,
  nil,
  { -- Quest
    'Alguém pediu um suco?‡Доставка сока‡Saftlieferung‡좀비 독주 배달‡Entrega de zumo‡Entrega de zumo‡Livrer le Suc‡僵尸酒‡僵屍酒',
    nil,
    'Leve o Suco de Zumbi para o Abercrombie na cabana dele.‡Отнесите сок зомби в хижину Аберкромби.‡Bringt Calvinius den Zombiesaft in seine Hütte.‡통나무집에 있는 에이버크롬비에게 좀비 독주를 가져가야 합니다.‡Lleva el zumo de zombi a Abercrombie a su choza.‡Lleva el zumo de zombi a Abercrombie a su choza.‡Apporter le Suc de Zombie à Abercrombie, dans sa cabane.‡把僵尸酒交给乌鸦岭墓地北方小屋里的亚伯克隆比。‡把僵屍酒交給烏鴉嶺墓地北方小屋裏的亞伯克隆比。',
  }
},
[160] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Carta ao prefeito‡Записка для мэра‡Ein Brief für den Bürgermeister‡시장에게 보내는 편지‡Nota para el alcalde‡Nota para el alcalde‡Une lettre pour le Maire‡给镇长的信‡給鎮長的信',
    nil,
    'Entregue a Carta para Malaquias Ebanez, Prefeito de Vila Sombria, a pedido de Abercrombie.‡Отнесите письмо Аберкромби Элло Чернодреву, мэру Темнолесья.‡Bringt Calvinius\' Brief zu Ello Ebonlocke, dem Bürgermeister von Dunkelhain.‡다크샤이어의 시장 엘로 이본로크 경에게 엘로에게 보내는 편지를 전해야 합니다.‡Lleva la carta de Abercrombie a Ello Cerranegro, el alcalde de Villa Oscura.‡Lleva la carta de Abercrombie a Ello Cerranegro, el alcalde de Villa Oscura.‡Apporter la Lettre d\'Abercrombie à Ello Ebonlocke, Maire de Darkshire.‡把亚伯克隆比的信交给夜色镇的艾尔罗·埃伯洛克镇长。‡把亞伯克隆比的信交給夜色鎮的艾爾羅·埃伯洛克鎮長。',
  }
},
[161] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'O Engenheiro-chefe Vedaçude quer que você leve o pó com cheiro estranho para Ashlan Risadura, o perito em explosivos, em Dun Modr.‡Отнесите странно пахнущий порошок в Дун Модр Ашлану Камнехмылу, специалисту по взрывчатым веществам.‡Chefingenieur Hinderweir möchte, dass Ihr das sonderbar riechende Pulver nach Dun Modr zu Ashlan Stonesmirk, dem Sprengstoffexperten, bringt.‡선임기술자 힌더바이르가 이상한 향기의 가루를 던 모드르에 있는 폭파 전문가 애실런 스톤스머크에게 전달해 달라고 부탁했습니다.‡El ingeniero jefe Hinderweir quiere que lleves las partículas con olor extraño a Ashlan Risapétrea, el experto en explosivos en Dun Modr.‡El ingeniero jefe Hinderweir quiere que lleves las partículas con olor extraño a Ashlan Risapétrea, el experto en explosivos en Dun Modr.‡L\'Ingénieur en chef Hinderweir veut que vous apportiez cette étrange poudre à Stonesmirk l\'Artificier à Dun Modr.‡主工程师辛德维尔七世要你把怪味粉末交给丹莫德的炸药专家阿什兰·暗石。‡主工程師辛德維爾七世要妳把怪味粉末交給丹莫德的炸藥專家阿什蘭·暗石。',
  }
},
[162] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A ascensão dos silitídeos‡Возвышение силитидов‡Aufstieg der Silithid‡실리시드의 출현‡La sublevación de los silítidos‡La sublevación de los silítidos‡L\'ascension des silithides‡异种蝎的威胁‡異種蠍的威脅',
    nil,
    'Leve o Relatório de Análise de Insetos para Gracinha Forçânima em Darnassus.‡Отнесите отчет о наблюдении за насекомыми Грацине Силе Духа в Дарнасс.‡Bringt den Insektenanalysebericht nach Darnassus zu Gracina Spiritmight.‡다르나서스에 있는 그라시나 스피릿마이트에게 곤충 분석 보고서를 가져가야 합니다.‡Dirígete a Darnassus y entrégale el informe del análisis del insecto a Gracina Poderespíritu.‡Dirígete a Darnassus y entrégale el informe del análisis del insecto a Gracina Poderespíritu.‡Apporter le Rapport d\'analyse des insectes à Gracina Spiritmight à Darnassus.‡把报告带给达纳苏斯的格拉希娜·灵风。‡把報告帶給達納蘇斯的格拉希娜·靈風。',
  }
},
[163] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Monte Corvo‡Вороний холм‡Rabenflucht‡까마귀 언덕‡Cerro del Cuervo‡Cerro del Cuervo‡Colline-aux-Corbeaux‡乌鸦岭‡烏鴉嶺',
    nil,
    'Descubra o que está assombrando o Monte Corvo.‡Выясните, кто поселился на Вороньем холме.‡Findet heraus, was in Rabenflucht umgeht.‡까마귀 언덕에 출몰하는 것이 무엇인지 확인해야 합니다.‡Averigua qué está acechando Cerro del Cuervo.‡Averigua qué está acechando Cerro del Cuervo.‡Découvrir ce qui hante Colline-aux-Corbeaux.‡查出是什么东西在乌鸦岭神出鬼没。‡查出是什麽東西在烏鴉嶺神出鬼沒。',
  }
},
[164] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Entrega para Noel‡Припасы для Свена‡Lieferung an Sven‡스벤에게 보급품 전달‡Entrega a Sven‡Entrega a Sven‡Livraison à Sven‡斯温的货物‡斯溫的貨物',
    nil,
    'Entregue os suprimentos a Noel.‡Отнесите Свену припасы.‡Liefert die Vorräte an Sven.‡스벤에게 보급품을 가져가야 합니다.‡Entrega los suministros a Sven.‡Entrega los suministros a Sven.‡Ravitailler Sven.‡把补给物资带给斯温。‡把補給物資帶給斯溫。',
  }
},
[165] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O eremita‡Отшельник‡Der Einsiedler‡은둔자‡El ermitaño‡El ermitaño‡L\'ermite‡隐士‡隱士',
    nil,
    'Confira se o velho que vive na choupana perto do cemitério do Monte Corvo está bem.‡Навестите старика в хижине рядом с кладбищем Вороньего холма.‡Schaut in der Nähe des Friedhofs von Rabenflucht nach dem alten Mann in der Hütte.‡까마귀 언덕 묘지 근처 통나무집에 있는 노인이 잘 있는지 확인해야 합니다.‡Ve a ver cómo está el anciano de la choza que hay cerca del Cementerio del Cerro del Cuervo.‡Ve a ver cómo está el anciano de la choza que hay cerca del Cementerio del Cerro del Cuervo.‡Aller voir le vieil homme dans sa cabane près du cimetière de Colline-aux-Corbeaux.‡去乌鸦岭墓地附近的小屋查看老人的情况。‡去烏鴉嶺墓地附近的小屋查看老人的情況。',
  }
},
[166] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Mate Edwin VanCleef e leve a cabeça dele para Miguel Mantoforte.‡Убейте Эдвина ван Клифа и принесите его голову Гриану Камнегриву.‡Tötet Edwin van Cleef und bringt seinen Kopf zu Gryan Stoutmantle.‡에드윈 밴클리프를 처치하고 그 증거로 그의 가면을 그라이언 스타우트맨틀에게 가져가야 합니다.‡Mata a Edwin VanCleef y lleva su cabeza a Gryan Mantorrecio.‡Mata a Edwin VanCleef y lleva su cabeza a Gryan Mantorrecio.‡Tuer Edwin VanCleef et apporter sa Tête à Gryan Stoutmantle.‡杀死艾德温·范克里夫，把他的头交给格里安·斯托曼。‡殺死艾德溫·範克裏夫，把他的頭交給格裏安·斯托曼。',
  }
},
[167] = {
  nil,
  { -- Npc
    'Morthan Linguacupra‡Моран Медношпунт‡Morhan Coppertongue‡모한 카퍼텅‡Morhan Cobrilengua‡Morhan Cobrilengua‡Morhan Coppertongue‡摩汉·铜喉‡摩漢·銅喉',
    'Ferreiro‡Металлург‡Metallschmied‡갑옷 상인‡Forjador de metales‡Forjador de metales‡Forgeron‡铁匠‡鐵匠',
  },
  -- Object
  '‡Ящик Аберкромби‡Calvinius\' Kiste‡애버크롬비의 상자‡Cajón de Abercrombie‡Cajón de Abercrombie‡Caisse d\'Abercrombie‡亚伯克隆比的箱子‡亞伯克隆比的木箱',
  { -- Quest
    'Meu irmão...‡О, брат мой...‡Oh Bruder...‡형제여...‡Oh hermano. . .‡Oh, hermano...‡Adieu mon frère…‡我的兄弟……‡我的兄弟……',
    nil,
    'Leve a Insígnia da Liga dos Exploradores do Encarregado Urtigão para Wilder Urtigão em Ventobravo.‡Принесите значок Лиги Исследователей, принадлежавший штейгеру Чертополоху в Штормград.‡Bringt Großknecht Thistlenettles Forscherliga-Abzeichen nach Stormwind zu Wilder Thistlenettle.‡스톰윈드에 있는 빌더 시슬네틀에게 시슬네틀의 배지를 가져가야 합니다.‡Lleva la insignia de la Liga de Exploradores del supervisor Cardortiga a Wilder Cardortiga, en Ventormenta.‡Lleva la insignia de la Liga de Expedicionarios del supervisor Cardortiga a Wilder Cardortiga, en Ventormenta.‡Apporter l\'Insigne de la Ligue des Explorateurs du contremaître Crispechardon à Wilder Crispechardon à Stormwind.‡将工头希斯耐特的探险者协会徽章交给暴风城的维尔德·蓟草。‡將工頭希斯耐特的探險者協會徽章交給暴風城的維爾德·薊草。',
  }
},
[168] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Lembranças dos que se foram‡Сбор воспоминаний‡Die Suche nach Andenken‡기억을 더듬어...‡La recolección de Tarjetas del Sindicato Minero‡Recolección de recuerdos‡À la recherche de Cartes du Syndicat des Mineurs‡收集记忆‡收集記憶',
    nil,
    'Recupere 4 Carteiras do Sindicato dos Mineradores e leve-as para Wilder Urtigão em Ventobravo.‡Добудьте 4 карточки Союза шахтеров и верните их Дикому Чертополохху в Штормград.‡Beschafft 4 Gewerkschaftsausweise und bringt sie nach Stormwind zu Wilder Thistlenettle.‡스톰윈드에 있는 빌더 시슬네틀에게 광부 조합의 명함 4장을 가져가야 합니다.‡Recupera 4 Tarjetas del Sindicato Minero y llévaselas a Wilder Cardortiga, en Ventormenta.‡Recupera 4 Tarjetas del Sindicato Minero y llévaselas a Wilder Cardortiga, en Ventormenta.‡Récupérer 4 Cartes du Syndicat des mineurs et les apporter à Wilder Crispechardon à Stormwind.‡给暴风城的维尔德·蓟草带回4张矿业工会会员卡。‡給暴風城的維爾德·薊草帶回4張礦業工會會員卡。',
  }
},
[169] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Procura-se: Gath\'Ilzogg‡Розыск: Гат\'Илзогг‡GESUCHT: Gath\'Ilzogg‡가스일조그 현상수배‡Se busca: Gath\'Ilzogg‡Se busca: Gath\'Ilzogg‡On recherche : Gath\'Ilzogg‡通缉：加塞尔佐格‡通緝：加塞爾佐格',
    nil,
    'Mate Gath\'Ilzogg e leve a cabeça dele para o Magistrado Salomão na Vila Plácida para receber a recompensa.‡Убейте Гат\'Илзогга и принесите его голову мировому судье Соломону в Приозерье.‡Erledigt Gath\'llzogg und bringt seinen Kopf zu Magistrat Solomon in Seenhain, um die Belohnung zu erhalten.‡가스일조그를 처치하고 그 증거로 그의 머리카락을 레이크샤이어에 있는 집정관 솔로몬에게 가져가십시오. 보상을 받을 수 있을 것입니다.‡Mata a Gath\'Ilzogg y lleva su cabeza al magistrado Solomon a Villa del Lago para recibir tu recompensa.‡Mata a Gath\'Ilzogg y lleva su cabeza al magistrado Solomon a Villa del Lago para recibir tu recompensa.‡Tuer Gath\'Ilzogg et apporter sa Tête au magistrat Solomon de Lakeshire pour toucher la récompense.‡杀死加塞尔佐格并把他的头颅割下，向湖畔镇的所罗门镇长复命。‡殺死加塞爾佐格並把他的頭顱割下，向湖畔鎮的所羅門鎮長復命。',
  }
},
[170] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Uma nova ameaça‡Новая угроза‡Eine neue Bedrohung‡새로운 위협‡Una nueva amenaza‡Una nueva amenaza‡Une nouvelle menace‡新的威胁‡新的威脅',
    nil,
    'Balir Gelomarra quer que você mate 6 Troggs Pedraqueixo e 6 Troggs Pedraqueixo Parrudos.‡Убейте 6 троггов из племени Каменной Челюсти и 6 сильных троггов из племени Каменной Челюсти.‡Balir Frosthammer möchte, dass Ihr 6 Troggs der Felsenkiefer und 6 bullige Troggs der Felsenkiefer tötet.‡발리르 프로스트해머가 바위턱트로그 6마리와 힘센 바위턱트로그 6마리를 처치해 달라고 부탁했습니다.‡Balir Martilloescarcha quiere que mates a 6 troggs Comepiedras y a 6 troggs Comepiedras fornidos.‡Balir Martilloescarcha quiere que mates a 6 troggs Comepiedras y a 6 troggs Comepiedras fornidos.‡Balir Frosthammer veut que vous tuiez 6 Troggs Mâcheroc et 6 Troggs Mâcheroc forcenés.‡巴尔林·霜锤让你去杀死6个石腭穴居人和6个壮实的石腭怪。‡巴爾林·霜錘讓妳去殺死6個石腭穴居人和6個壯實的石腭怪。',
  }
},
[171] = {
  nil,
  { -- Npc
    'Murloc Guerreiro‡Мурлок-воин‡Murlockrieger‡멀록 전사‡Guerrero múrloc‡Guerrero múrloc‡Guerrier murloc‡鱼人战士‡魚人戰士',
    nil,
  },
  nil,
  { -- Quest
    'Um protegido da Aliança‡Опекун Альянса‡Tageseltern der Allianz‡얼라이언스 보육원‡Alcaide de la Alianza‡Alcaide de la Alianza‡Un surveillant de l\'Alliance‡联盟孤儿的看护者‡聯盟孤兒的看護者',
    nil,
    'Compre um Cavalete para Espada de Espuma de Crango Tiratampa e leve seu protegido de volta ao orfanato de Ventobravo. Basta falar com a Matriarca Ananéri no Distrito da Catedral.‡Проводите своего подопечного в приют Штормграда, вернув свисток ребенка-сироты попечительнице сирот Найтингейл в Храмовый квартал.‡Bringt Euren Schützling in das Waisenhaus von Stormwind zurück, indem Ihr die Pfeife des menschlichen Waisenkindes an Waisenmatrone Nightingale im Kathedralenviertel übergebt.‡대성당 광장에 있는 보육원 원장님 나이팅게일에게 인간 고아 호루라기를 건네주면서 아이를 스톰윈드 보육원에 다시 데려가야 합니다.‡Compra un expositor para espadas de gomaespuma a Chichón Perinola y después habla con la supervisora de huérfanos Ruiseñor en el Distrito de la Catedral para llevar a tu pupilo de vuelta al orfanato de Ventormenta.‡Compra un expositor para espadas de gomaespuma a Chichón Perinola y después habla con la supervisora de huérfanos Ruiseñor en el Distrito de la Catedral para llevar a tu pupilo de vuelta al orfanato de Ventormenta.‡Achetez un Râtelier d’épées en mousse à Foltiff Tremblhoupette. Puis ramenez votre protégé à l’orphelinat de Hurlevent, en parlant à la directrice de l’orphelinat, Rossignol, dans le Quartier de la Cathédrale.‡回到暴风城的教堂区，把人类孤儿哨交还给孤儿院的孤儿监护员奈丁加尔。‡從克拉格·搖塞那裏購買泡沫塑料劍架，然後將妳的孤兒送回暴風城孤兒院，同教堂區的孤兒監護員奈丁加爾交談，送妳的孤兒回家。',
  }
},
[172] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Semana das Crianças‡Детская неделя‡Die Kinderwoche‡어린이 주간‡Semana de los Niños‡Semana de los Niños‡La Semaine des enfants‡儿童周‡兒童周',
    nil,
    'Use o Apito de Órfão Orc para conversar com a criança de quem você vai cuidar durante a Semana da Criança.‡Используйте свисток орка-сироты. Присматривайте за сиротой в течение всей Детской недели.‡Benutzt die Pfeife des orcischen Waisenkindes um während der Kinderwoche mit Eurem Schützling zu sprechen.‡오크 고아 호루라기를 사용해 어린이 주간에 돌볼 아이와 대화하십시오.‡Usa el silbato de huérfano orco para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Usa el silbato de huérfano orco para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Utiliser le sifflet d\'orphelin orc pour parler à l\'enfant que vous protégez durant la Semaine des enfants.‡使用兽人孤儿哨与你即将在儿童周期间照顾的孩子进行对话。‡使用獸人孤兒哨與妳即將在兒童周期間照顧的孩子進行對話。',
  }
},
[173] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Worgens na floresta‡Воргены в лесу‡Worgs in den Wäldern‡숲 속의 늑대인간‡Ferocanis en el bosque‡Huargen en el bosque‡Worgens dans les bois‡森林里的狼人‡森林裏的狼人',
    nil,
    'Mate 6 worgens Tece-sombras Nocturnos para Petrônio na Vila Sombria.‡Калор из Темнолесья просит вас убить 6 тенеткачей Ночной Погибели.‡Tötet für Calor aus Dunkelhain 6 Schattenwirker der Nachtheuler.‡다크샤이어의 칼로를 위해 파멸의어둠일족 흑마술사 6마리를 처치해야 합니다.‡Mata a 6 ferocanis Tejesombras nocturno para Calor de Villa Oscura.‡Mata a 6 huargen Tejesombras Penumbría para Calor de Villa Oscura.‡Tuer 6 worgens Tisseurs d\'ombre Plaie-de-nuit pour Calor de Darkshire.‡为夜色镇的卡洛尔杀掉6个夜行织影狼人。‡為夜色鎮的卡洛爾殺掉6個夜行織影狼人。',
  }
},
[174] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Vitório Prismado, da Vila Sombria, quer que você lhe providencie um tubo de bronze.‡Принесите Виктору Призм\'Антрасу бронзовую трубку.‡Viktori Prism\'Antras aus Dunkelhain möchte, dass Ihr ihm eine Bronzeröhre bringt.‡다크샤이어의 빅토리 프리즘안트라스가 청동관을 가져다 달라고 부탁했습니다.‡Viktori Prism\'Antras de Villa Oscura quiere que le lleves un tubo de bronce.‡Viktori Prism\'Antras de Villa Oscura quiere que le lleves un tubo de bronce.‡Viktori Prism\'Antras de Darkshire veut que vous lui apportiez un Tube en bronze.‡夜色镇的维克托·安特拉斯要你给他找一根青铜管。‡夜色鎮的維克托·安特拉斯要妳給他找壹根青銅管。',
  }
},
[175] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Encontre Maria e convença-a a fornecer uma superfície refletora para o projeto de Vitório.‡Найдите Мэри и уговорите ее пожертвовать зеркало для проекта Виктора.‡Findet Mary und überredet sie, einen Gegenstand mit reflektierender Oberfläche zu Viktoris Projekt beizusteuern.‡매리를 찾아 빅토리의 작업에 사용할 반사면을 빌려 와야 합니다.‡Localiza a Mary y convéncela de que te dé una superficie reflectora para el proyecto de Viktori.‡Localiza a Mary y convéncela de que te dé una superficie reflectora para el proyecto de Viktori.‡Trouver Marie et la persuader de prêter une surface réfléchissante pour le projet de Viktori.‡找到玛丽，说服她借给你一个反光镜，用于维克托的计划。‡找到瑪麗，說服她借給妳壹個反光鏡，用於維克托的計劃。',
  }
},
[176] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Procura-se: "Hogger"‡Разыскивается: "Дробитель"‡GESUCHT: "Hogger"‡들창코 현상수배‡Se busca: Hogger‡Se busca: Hogger‡On recherche : "Lardeur"‡通缉：霍格‡通緝：霍格',
    nil,
    'Mate o gnoll Hogger e leve sua Enorme Garra de Gnoll para o Delegado Durão.‡Убейте Дробителя и принесите маршалу Дугхану большой коготь гнолла.‡Erschlagt den Gnoll Hogger und bringt seine gewaltige Gnoll-Klaue zu Marshal Dughan.‡들창코라는 놀을 처치하고 치안대장 더그한에게 그 놀의 큰 발톱을 가져가야 합니다.‡Mata al gnoll Hogger y trae su enorme garra gnoll al alguacil Dughan.‡Mata al gnoll Hogger y llévale su garra de gnoll enorme al alguacil Dughan.‡Liquider le gnoll Lardeur et apporter sa Grande griffe au maréchal Dughan.‡杀死豺狼人霍格，把他那巨大的豺狼人爪带给治安官杜汉。‡殺死豺狼人霍格，把他那巨大的豺狼人爪帶給治安官杜漢。',
  }
},
[177] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Recupere o Espelho de Maria do Carniçal Insano e entregue-o a Vitório na Vila Sombria.‡Заберите зеркало Слепой Мэри у Невменяемого Вурдалака и отдайте его Виктору в Темнолесье.‡Nehmt dem irrsinnigen Ghul den Handspiegel der blinden Mary ab und gebt ihn Viktori in Dunkelhain.‡광기어린 구울에게서 매리의 거울을 찾아 다크샤이어에 빅토리 프리즘안트라스에게 가져가야 합니다.‡Quita el espejo de Mary la Ciega al necrófago demente y llévaselo a Viktori a Villa Oscura.‡Quita el espejo de Mary la Ciega al necrófago demente y llévaselo a Viktori a Villa Oscura.‡Prendre le miroir de Marie l\'Aveugle à la Goule folle et l’apporter à Viktori de Darkshire.‡从疯狂的食尸鬼那里拿回盲眼玛丽的眼镜，把它交给夜色镇的维克托。‡從瘋狂的食屍鬼那裏拿回盲眼瑪麗的眼鏡，把它交給夜色鎮的維克托。',
  }
},
[178] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A resposta de Teócrito‡Поручение Теокрита‡Wiederbeschaffung für Theocritus‡테오크리투스의 역공‡Theocritus recupera el colgante‡Theocritus recupera el colgante‡Theocritus récupère son Pendentif‡塞欧克瑞图斯的坠饰‡塞歐克瑞圖斯的墜飾',
    nil,
    'Leve o Pingente Umbrapele Esmaecido para Teócrito, o Mago.‡Принесите выцветшую подвеску Темношкуров верховному магу Теокриту.‡Bringt den verblassten Schattenfellanhänger zu Theocritus, dem Magier.‡마법사 테오크리투스에게 잿빛가죽 놀의 빛바랜 펜던트를 가져가야 합니다.‡Lleva el colgante Pielsombra descolorido a Theocritus el mago.‡Lleva el colgante Pielsombra descolorido a Theocritus el mago.‡Apporter l\'Ancien pendentif sombrepoil à Theocritus le Mage.‡将不再发光的暗皮坠饰带给法师塞欧克瑞图斯。‡將不再發光的暗皮墜飾帶給法師塞歐克瑞圖斯。',
  }
},
[179] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Provedores enânicos‡Дворфские экипировщики‡Zwergenausstatter‡드워프 장갑‡Los enanos modistos‡Los enanos modistos‡Tailleur chez les nains‡矮人的交易‡矮人的交易',
    nil,
    'Sten Braçoforte quer 8 pedaços de Carne Dura de Lobo.‡Принесите Стену Крепкоруку 8 кусков жесткого волчьего мяса.‡Sten Stoutarm hätte gern 8 Stücke zähes Wolfsfleisch.‡스텐 스타우트암이 질긴 늑대 고기 8조각을 구해 달라고 부탁했습니다.‡Sten Brazorrecio quiere 8 piezas de carne dura de lobo.‡Sten Brazorrecio quiere 8 piezas de carne de lobo dura.‡Sten Stoutarm voudrait 8 Morceaux de Viande de loup coriace.‡斯登·粗臂想要8块硬狼肉。‡斯登·粗臂想要8塊硬狼肉。',
  }
},
[180] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Procura-se: Tenente Mordente‡Разыскивается: лейтенант Фангор‡GESUCHT: Lieutenant Fangor‡부대장 붉은송곳니 현상수배‡Se busca: teniente Fangore‡Se busca: Teniente Fangore‡On recherche : lieutenant Fangore‡通缉：范高雷中尉‡通緝：範高雷中尉',
    nil,
    'Mate o Tenente Mordente e leve a pata dele para o Magistrado Salomão em Vila Plácida.‡Убейте лейтенанта Фангора и принесите его лапу мировому судье Соломону в Приозерье.‡Tötet Lieutenant Fangor und kehrt mit seiner Tatze zu Magistrat Solomon nach Seenhain zurück.‡부대장 붉은송곳니를 처치한 후 그의 앞발을 가지고 레이크샤이어의 집정관 솔로몬에게 돌아가야 합니다.‡Mata al teniente Fangore y lleva su zarpa al magistrado Solomon a Villa del Lago.‡Mata al teniente Fangore y lleva su zarpa al magistrado Solomon a Villa del Lago.‡Tuer le lieutenant Fangore et rapporter sa patte au magistrat Solomon de Lakeshire.‡杀死范高雷并将他的手掌割下，向湖畔镇的所罗门镇长复命。‡殺死範高雷並將他的手掌割下，向湖畔鎮的所羅門鎮長復命。',
  }
},
[181] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ora (direis) ouvir estrelas‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Encontre Zzarc\'Vul no morro ôgrico ao sul da Floresta do Crepúsculo, pegue com ele o monóculo e leve para Vitório na Vila Sombria.‡Отыщите Ззарк\'Вула в кургане на юге Сумеречного леса и принесите его монокль Виктору в Темнолесье.‡Findet Zzarc\'Vul im südlichen Ogerhort des Dämmerwalds und bringt sein Monokel zu Viktori nach Dunkelhain.‡그늘숲 남쪽의 오우거 언덕에서 짜르크불을 찾아 오우거의 외눈안경을 다크샤이어에 있는 빅토리에게 가져와야 합니다.‡Localiza a Zzarc\'Vul en el montículo meridional del Bosque del Ocaso y llévale su monóculo a Viktori a Villa Oscura.‡Localiza a Zzarc\'Vul en el montículo meridional del Bosque del Ocaso y llévale su monóculo a Viktori a Villa Oscura.‡Localiser Zzarc\'Vul dans le tertre des ogres au sud du bois de la Pénombre et rapporter son Monocle à Viktori de Darkshire.‡在暮色森林南部的食人魔土丘上找到扎克乌尔，把他的单片眼镜带回夜色镇交给维克托。‡在暮色森林南部的食人魔土丘上找到紮克烏爾，把他的單片眼鏡帶回夜色鎮交給維克托。',
  }
},
[182] = {
  -- Item
  'Cabeça do Garrick‡Голова Гаррика‡Garricks Kopf‡게릭의 가면‡Cabeza de Garrick‡Cabeza de Garrick‡Tête de Garrick‡加瑞克的头颅‡加瑞克的頭顱',
  nil,
  nil,
  { -- Quest
    'A caverna dos trolls‡Пещера троллей‡Die Trollhöhle‡트롤 동굴‡La cueva de los trols‡La cueva de los trols‡La caverne des trolls‡巨魔洞穴‡巨魔洞穴',
    nil,
    'Grolin Barbabranca quer que você mate 14 Jovens Trolls Jubafria.‡Убейте 14 троллей-подростков из племени Мерзлогривов.‡Grelin Whitebeard möchte, dass Ihr 14 Trollwelpen der Frostmane tötet.‡그렐린 화이트비어드가 어린 서리갈기트롤 14마리를 처치해 달라고 부탁했습니다.‡Grelin Barbablanca quiere que mates a 14 crías de trol Peloescarcha.‡Grelin Barbablanca quiere que mates a 10 crías de trol Peloescarcha.‡Grelin Whitebeard aimerait que vous tuiez 14 Jeunes trolls Frostmane.‡格瑞林·白须要你去杀掉14个霜鬃巨魔幼崽。‡格瑞林·白須要妳去殺掉14個霜鬃巨魔幼崽。',
  }
},
[183] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Caçando javali‡Охотник на вепрей‡Der Eberjäger‡멧돼지 사냥‡Cazador de jabalíes‡Cazador de jabalíes‡Chasseur de sangliers‡猎杀野猪‡獵殺野豬',
    nil,
    'Talin Olhobom quer que você mate 12 Rochetuscos Pequenos.‡Убейте 12 малых скальных вепрей по просьбе Талина Остроглаза.‡Talin Keeneye möchte, dass Ihr 12 kleine Klippeneber tötet.‡탈린 킨아이가 작은 멧돼지 12마리를 처치해 달라고 부탁했습니다.‡Talin Ojoagudo quiere que mates a 12 jabalíes del risco pequeños.‡Talin Ojo Ávido quiere que mates a 12 jabalíes del risco pequeños.‡Talin Keeneye aimerait que vous tuiez 12 Petits sangliers des rochers.‡塔林·锐眼让你去杀掉12只小型峭壁野猪。‡塔林·銳眼讓妳去殺掉12只小型峭壁野豬。',
  }
},
[184] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Escritura do Taturana‡Документ Хмуроброва‡Furlbrows Urkunde‡펄브로우의 땅문서‡La escritura de Furlbrow‡Las escrituras de Cejade‡Titre de propriété de Furlbrow‡法布隆的地契‡法布隆的地契',
    nil,
    'Leve a Escritura do Taturana para o Fazendeiro Taturana.‡Доставьте фермеру Хмуроброву документ на ферму.‡Bringt Furlbrows Besitzurkunde zu Bauer Furlbrow.‡농부 펄브로우에게 펄브로우의 땅문서를 가져가야 합니다.‡Lleva al granjero Furlbrow su escritura.‡Lleva las escrituras de Cejade al granjero Cejade.‡Rapporter son titre de propriété au Fermier Furlbrow.‡把法布隆的地契交给农夫法布隆。‡把法布隆的地契交給農夫法布隆。',
  }
},
[185] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Domina el tigre‡Domina el tigre‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate 10 Tigres-do-espinhaço Jovens.‡Ажек Руак из экспедиции Эрнестуэя попросила вас убить 10 молодых тигров Тернистой долины.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr 10 junge Schlingendorntiger tötet.‡네싱워리 원정대의 아제크 루아크가 새끼 가시덤불 호랑이 10마리를 처치해 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres jóvenes de Tuercespina.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres jóvenes de Tuercespina.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous chassiez 10 Jeunes tigres de Strangleronce.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死10只荆棘谷猛虎幼崽。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死10只荊棘谷猛虎幼崽。',
  }
},
[186] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Maestría en tigres‡Maestría en tigres‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate 10 Tigres-do-Espinhaço.‡Ажек Руак из экспедиции Эрнестуэя попросила вас убить 10 тигров Тернистой долины.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr 10 Schlingendorntiger tötet.‡네싱워리 원정대의 아제크 루아크가 가시덤불 호랑이 10마리를 처치해 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres de Tuercespina.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres de Tuercespina.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous chassiez 10 Tigres de Strangleronce.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死10只荆棘谷猛虎。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死10只荊棘谷猛虎。',
  }
},
[187] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Domina el tigre‡Domina el tigre‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate 10 Tigres-do-espinhaço Anciãos.‡Ажек Руак из экспедиции Эрнестуэя попросила вас убить 10 старых тигров Тернистой долины.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr 10 alte Schlingendorntiger tötet.‡네싱워리 원정대의 아제크 루아크가 덩치큰 가시덤불 호랑이 10마리를 처치해 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary, quiere que mates 10 tigres de Tuercespina mayores.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres de Tuercespina mayores.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous chassiez 10 Anciens tigres de Strangleronce.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死10只老年荆棘谷猛虎。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死10只老年荊棘谷猛虎。',
  }
},
[188] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Domina el tigre‡Domina el tigre‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate Sin\'Dall e lhe traga a pata dela.‡Ажек Руак из экспедиции Эрнестуэя просит вас убить Син\'Далл и принеси ее лапу.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr Sin\'Dall tötet und mit ihrer Tatze zurückkehrt.‡네싱워리 원정대의 아제크 루아크가 신달을 처치하고 그 앞발을 가져다 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates a Sin\'Dall y vuelvas con su zarpa.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates a Sin\'Dall y le lleves su pata.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous tuiez Sin’Dall et que vous rapportiez sa Patte.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死辛达尔并带回它的爪子。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死辛達爾並帶回它的爪子。',
  }
},
[189] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Orelhas de Sanguescalpo‡Уши троллей Кровавого Скальпа‡Ohren der Bloodscalp‡붉은머리부족의 귀‡Orejas de Sangrapellejo‡Orejas de Sangrapellejo‡Oreilles de Bloodscalp‡血顶巨魔的耳朵‡血頂巨魔的耳朵',
    nil,
    'Consiga 15 Orelhas de Sanguescalpo e entregue-as a Kebok na Angra do Butim.‡Добудьте 15 ушей троллей из племени Кровавого Скальпа и принесите их Кебоку в Пиратскую бухту.‡Verschafft Euch 15 Ohren der Bloodscalp und bringt sie Kebok in Booty Bay.‡붉은머리부족의 귀 15개를 모아 무법항에 있는 케복에게 가져가야 합니다.‡Consigue 15 orejas Sangrapellejo y llévaselas a Kebok en la Bahía del Botín.‡Consigue 15 orejas Sangrapellejo y llévaselas a Kebok en la Bahía del Botín.‡Obtenir 15 Oreilles de trolls Bloodscalp et les apporter à Kebok, à Baie-du-Butin.‡给藏宝海湾的科博克带回15只血顶巨魔的耳朵。‡給藏寶海灣的科博克帶回15只血頂巨魔的耳朵。',
  }
},
[190] = {
  nil,
  { -- Npc
    'Dálvaro João‡Дермот Джонс‡Dermot Johns‡더모트 존스‡Dermot Johns‡Dermot Johns‡Dermot Johns‡德尔莫特·约翰斯‡德爾莫特·約翰斯',
    'Armaduras de Tecido e Couro‡Торговец тканевыми и кожаными доспехами‡Tuch- und Lederrüstungshändler‡천 및 가죽 방어구 상인‡Mercader de armaduras de tela y cuero‡Mercader de armaduras de tela y cuero‡Marchand d\'armures en étoffe & en cuir‡布甲和皮甲商人‡布甲和皮甲商人',
