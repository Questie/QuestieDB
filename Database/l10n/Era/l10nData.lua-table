  nil,
  { -- Quest
    'A astúcia dos raptores‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡迅猛龍的狡詐',
    nil,
    'Entregue o Orbe de Tor\'gan para Gor\'mul.‡Отдайте Гор\'мулю сферу Тор\'гана.‡Gebt Gor\'mul Tor\'gans Kugel.‡고르멀에게 토건의 수정구를 전달해야 합니다.‡Dale el orbe de Tor\'gan a Gor\'mul.‡Entrégale el orbe de Tor\'gan a Gor\'mul.‡Donner l\'Orbe de Tor\'gan à Gor\'mul.‡把托尔甘的宝珠交给戈穆尔。‡把托爾甘的寶珠交給戈穆爾。',
  }
},
[703] = {
  nil,
  { -- Npc
    'Tenente Mordente‡Лейтенант Фангор‡Lieutenant Fangor‡부대장 붉은송곳니‡Teniente Fangore‡Teniente Fangore‡Lieutenant Fangore‡范高雷中尉‡范高雷中尉',
