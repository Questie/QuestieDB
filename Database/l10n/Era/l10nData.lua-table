  { -- Npc
    'Truk Barbalouca‡Трук Косматая Борода‡Truk Wildbeard‡트루크 와일드비어드‡Truk Semperámbar‡Truk Semperámbar‡Truk Wildbeard‡特鲁克·蛮鬃‡特魯克·蠻鬃',
    'Garçom‡Бармен‡Schankkellner‡바텐더‡Camarero‡Camarero‡Tavernier‡调酒师‡酒保',
  },
  nil,
  { -- Quest
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡魔化金線血袍',
    nil,
    'Fale com Menara Nihila, nos Sertões.‡Возвращайтесь к Менаре Расщепительнице Бездны в Степи.‡Kehrt zu Menara Voidrender im Brachland zurück.‡불모의 땅에 있는 미네라 보이드렌더에게 돌아가십시오.‡Regresa junto a Menara Nadiz en Los Baldíos.‡Regresa junto a Menara Nadiz en Los Baldíos.‡Retourner voir Menara Voidrender dans les Tarides.‡回到贫瘠之地的梅纳拉·沃伦德那里。‡回到貧瘠之地的梅納拉·沃倫德那裏。',
  }
},
[4783] = {
  -- Item
  '‡Тотем Ястребиного Ветра‡Falkenwinds Totem‡호크윈드의 토템‡Tótem de Viento de Halcón‡Tótem de Viento de Halcón‡Totem de Vent-du-faucon‡鹰风图腾‡鷹風圖騰',
  { -- Npc
    'Vigilalva Selgorm‡Рассветный дозорный Селгорм‡Dämmerungsbehüter Selgorm‡새벽감시자 셀고름‡Selgorm Guardalbas‡Vigía del Alba Selgorm‡Veilleur de l\'aube Selgorm‡哨兵塞尔高姆‡哨兵塞爾高姆',
    'Aurora Argêntea‡Серебряный Рассвет‡Die Argentumdämmerung‡은빛 여명회‡El Alba Argenta‡El Alba Argenta‡L\'Aube d\'argent‡银色黎明‡銀色黎明',
  },
  nil,
  { -- Quest
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡魔化金線血袍',
    nil,
    'Leve 10 Ampolas de Sangue de Furiódio e 1 Pedra Infernal Menor para Menara Nihila, nos Sertões.‡Принесите 10 фиалов крови сатира из племени Ярой Ненависти и 1 простой камень Преисподней в Степи, Менаре Менара Расщепительнице Бездны.‡Bringt Menara Voidrender im Brachland 10 Phiolen Zornsäerblut und 1 geringen Höllenstein.‡불모의 땅에 있는 미네라 보이드렌더에게 서릿발분노의 사티로스 피 10병과 하급 지옥정령석 1개를 가져가야 합니다.‡Llévale 10 viales de sangre Odio Feroz y 1 piedra Infernal inferior a Menara Nadiz en Los Baldíos.‡Llévale 10 viales de sangre Odio Feroz y 1 piedra Infernal inferior a Menara Nadiz en Los Baldíos.‡Apporter 10 Fioles de sang de Fielfurie et 1 Pierre infernale inférieure à Menara Voidrender dans les Tarides.‡将10瓶怨怒萨特之血和1块次级地狱火石交给贫瘠之地的梅纳拉·沃伦德。‡將10瓶怨怒薩特之血和1塊次級地獄火石交給貧瘠之地的梅納拉·沃倫德。',
  }
},
[4784] = {
  -- Item
  '‡Безжизненный камень‡Lebloser Stein‡정기가 사라진 돌‡Piedra inerte‡Piedra inerte‡Pierre morte‡冰冷的石头‡冰冷的石頭',
  { -- Npc
    'Guarda Argênteo Manados‡Страж Манадос из ордена Серебряного Рассвета‡Argentumwache Manados‡은빛경비병 마나도스‡Guardia Argenta Manados‡Guardia Argenta Manados‡Garde d\'argent Manados‡银月守卫玛纳杜斯‡銀色黎明守衛瑪納杜斯',
    'Aurora Argêntea‡Серебряный Рассвет‡Die Argentumdämmerung‡은빛 여명회‡El Alba Argenta‡El Alba Argenta‡L\'Aube d\'argent‡银色黎明‡銀色黎明',
  },
  nil,
  { -- Quest
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡魔化金線血袍',
    nil,
    'Leve Fio de Ouro de Qualidade, 2 Carvões Fumegantes e um Estilhaço de Alma para Menara Nihila, nos Sertões.‡Принесите Менаре Расщепительнице Бездны в Степи нить из чистого золота, 2 тлеющих угля и осколок души.‡Bringt Menara Voidrender im Brachland Goldgarn, 2 glimmende Kohlen und einen Seelensplitter.‡불모의 땅에 있는 미네라 보이드렌더에게 고급 금빛 실타래와 이글거리는 석탄 2개, 그리고 영혼의 조각 1개를 가져가야 합니다.‡Llévale unos hilos finos de oro, 2 trozos de ascuas humeantes y 1 fragmento de alma a Menara Nadiz en Los Baldíos.‡Llévale unos hilos finos de oro, 2 trozos de ascuas humeantes y 1 fragmento de alma a Menara Nadiz en Los Baldíos.‡Apporter du Fil d\'or fin, 2 Charbons ardents et un Fragment d\'âme à Menara Voidrender dans les Tarides.‡将一些优质金线、2块闷烧煤和一块灵魂碎片交给贫瘠之地的梅纳拉·沃伦德。‡將壹些優質金線、2塊悶燒煤和壹塊靈魂碎片交給貧瘠之地的梅納拉·沃倫德。',
  }
},
