[9120] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A queda de Kel\'Thuzad‡Падение Кел\'Тузада‡Der Niedergang Kel\'Thuzads‡켈투자드의 죽음‡La caída de Kel\'Thuzad‡La caída de Kel\'Thuzad‡La chute de Kel\'Thuzad‡克尔苏加德的末日‡克爾蘇加德的末日',
    nil,
    'Leve o Filactério de Kel\'Thuzad para a Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите талисман Кел\'Тузада в Часовню Последней Надежды в Восточных Чумных землях.‡Bringt Kel\'Thuzads Phylakterium zu der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대에 있는 희망의 빛 예배당에 켈투자드의 성물함을 가져가야 합니다.‡Lleva la filacteria de Kel\'Thuzad a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la filacteria de Kel\'Thuzad a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le Phylactère de Kel’Thuzad à la chapelle de l’Espoir de Lumière dans les Maleterres de l’est.‡将克尔苏加德的护符匣带往东瘟疫之地圣光之愿礼拜堂。‡將克爾蘇加德的護符匣帶往東瘟疫之地聖光之願禮拜堂。',
  }
},
[9121] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A cidadela medonha: Naxxramas‡Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡La ciudadela del terror: Naxxramas‡La ciudadela del terror: Naxxramas‡Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡恐怖之城，納克薩瑪斯',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 5 Cristais Arcanos, 2 Cristais do Nexus, 1 Orbe da Retidão e 60 peças de ouro. Você tem que ser Honrad<o/a> pela Aurora Argêntea.‡Верховный маг Анджела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова наложить на вас заклинание чародейского покрова за 5 чародейских кристаллов, 2 кристалла-источника, 1 сферу Праведности и 60 золотых. Вы должны заслужить уважительное отношение Серебряного Рассвета.‡Erzmagierin Angela Dosantos bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 5 Arkankristalle, 2 Nexuskristalle, 1 rechtschaffene Kugel und 60 Goldstücke. Euer Ruf bei der Argentumdämmerung muss außerdem wohlwollend sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 신비한 수정 5개, 마력의 결정체 2개, 정의의 보주 1개, 60골드를 가져다달라고 부탁했습니다. 또한 은빛 여명회의 평판이 우호적이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 cristales Arcanos, 2 cristales nexo, 1 orbe recto y 60 piezas de oro. También tienes que ser Honorable con El Alba Argenta.|n‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 5 cristales Arcanos, 2 cristales nexo, 1 orbe recto y 60 piezas de oro. También tienes que ser Honorable con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est veut 5 Cristaux des arcanes, 2 Cristaux de nexus, 1 Orbe de piété et 60 pièces d\'or. Vous devez aussi être <Honoré/Honorée> auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯需要5块奥术水晶、2块连结水晶、1个正义宝珠和60金币。你在银色黎明中的声望必须达到尊敬。‡東瘟疫之地聖光之願禮拜堂的大法師安吉拉·杜薩圖斯需要5塊奧術水晶、2塊連結水晶、1個正義寶珠和60金幣。妳在銀色黎明中的聲望必須達到尊敬。',
  }
},
[9122] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A cidadela medonha: Naxxramas‡Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡La ciudadela del terror: Naxxramas‡La ciudadela del terror: Naxxramas‡Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡恐怖之城，納克薩瑪斯',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 2 Cristais Arcanos, 1 Cristal do Nexus e 30 peças de ouro. Você tem que ser Reverenciad<o/a> pela Aurora Argêntea.‡Верховный маг Анджела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова наложить на вас заклинание чародейского покрова за 2 чародейских кристалла, 1 кристалл-источник и 30 золотых. Вы должны заслужить почтительное отношение Серебряного Рассвета.‡Erzmagierin Angela Dosantos bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 2 Arkankristalle, 1 Nexuskristall und 30 Goldstücke. Euer Ruf bei der Argentumdämmerung muss außerdem respektvoll sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 신비한 수정 2개, 마력의 결정체 1개, 30골드를 가져다 달라고 부탁했습니다. 또한 은빛 여명회의 평판이 매우 우호적이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 2 cristales Arcanos, 1 cristal nexo y 30 piezas de oro. También tienes que ser Venerado con El Alba Argenta.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 2 cristales Arcanos, 1 cristal nexo y 30 piezas de oro. También tienes que ser Venerado con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est veut 2 Cristaux des arcanes, 1 Cristal de nexus et 30 pièces d\'or. Vous devez aussi être <Révéré/Révérée> auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯需要2块奥术水晶、1块连结水晶和30金币。你在银色黎明中的声望必须达到崇敬。‡東瘟疫之地聖光之願禮拜堂的大法師安吉拉·杜薩圖斯需要2塊奧術水晶、1塊連結水晶和30金幣。妳在銀色黎明中的聲望必須達到崇敬。',
  }
},
[9123] = {
  -- Item
  '‡‡‡서판: 번개 화살 VI‡‡‡‡‡石板:閃電箭 VI',
  nil,
  nil,
  { -- Quest
    'A cidadela medonha: Naxxramas‡Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡La ciudadela del terror: Naxxramas‡La ciudadela del terror: Naxxramas‡Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡恐怖之城，納克薩瑪斯',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, dará a você a Ocultação Arcana sem nenhum custo. Você tem que ser Exaltad<o/a> pela Aurora Argêntea.‡Верховный маг Анджела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова бесплатно наложить на вас заклинание чародейского покрова. Сначала добейтесь того, чтобы вас превозносили в Серебряном Рассвете.‡Erzmagierin Angela Dosantos bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern wird Euch die arkane Tarnung kostenfrei gewähren. Euer Ruf bei der Argentumdämmerung muss ehrfürchtig sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 비전 은신 마법으로 낙스라마스로 들어갈 수 있도록 해 줄 것입니다. 은빛 여명회의 평판이 확고한 동맹이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est vous accordera gratuitement l\'Occultation arcanique. Vous devez être <Exalté/Exaltée> auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯会免费为你施放奥术遮罩的咒语。你在银色黎明中的声望必须达到崇拜。‡東瘟疫之地聖光之願禮拜堂的大法師安吉拉·杜薩圖斯會免費為妳施放奧術遮罩的咒語。妳在銀色黎明中的聲望必須達到崇拜。',
  }
},
[9124] = {
  -- Item
  '‡‡‡서판: 번개 충격 II‡‡‡‡‡石板:閃電震擊 II',
  nil,
  nil,
  { -- Quest
    'A armadura do criptalante não se faz sozinha...‡Доспехи расхитителя гробниц на дороге не валяются...‡Was man für Gruftpirscherrüstung braucht...‡지하추적자 갑옷‡La armadura de acechacriptas no se hace sola...‡La armadura de acechacriptas no se hace sola...‡L\'armure de traqueur des cryptes ne se fabrique pas toute seule‡地穴追猎者护甲的材料……‡地穴追獵者護甲的材料……',
    nil,
    'O Guarda-caça Leopold, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 30 Pedaços de Carnífice da Cripta.‡Принесите 30 конечностей и панцирей некрорахнидов Охотнику Леопольду в Часовню Последней Надежды в Восточные Чумные земли.‡Jäger Leopold bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 30 Teile einer Gruftsatanskreatur.‡동부 역병지대, 희망의 빛 예배당에 있는 사냥꾼 레오폴드가 지하마귀 발톱 30개를 가져다 달라고 부탁했습니다.‡El montero Leopold, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de maligno de cripta.‡El montero Leopold, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de maligno de cripta.‡Le veneur Leopold, à la chapelle de l’Espoir de Lumière dans les Maleterres de l’est, veut que vous lui apportiez 30 Morceaux de démon des cryptes.‡东瘟疫之地圣光之愿礼拜堂的猎手雷奥普德要30份地穴魔的碎块。‡東瘟疫之地聖光之願禮拜堂的獵手雷奧普德要30份地穴魔的碎塊。',
  }
},
[9125] = {
  -- Item
  '‡‡‡서판: 은총의 토템‡‡‡‡‡石板:風之優雅圖騰',
  nil,
  nil,
  { -- Quest
    'Pedaços de Carnífice da Cripta‡Конечности и панцири некрорахнидов‡Teile einer Gruftbestie‡지하마귀 발톱‡Trozos de maligno de cripta‡Trozos de maligno de cripta‡Des morceaux de démon des cryptes‡地穴魔的碎块‡地穴魔的碎塊',
    nil,
    nil,
  }
},
[9126] = {
  -- Item
  '‡‡‡서판: 불꽃의 토템 II‡‡‡‡‡石板:火舌圖騰 II',
  nil,
  nil,
  { -- Quest
    'Matéria-prima de Ceifa-ossos‡Копи костяной косы‡Knochensensenjagd‡해골사신을 위한 발굴‡Excavaciones para la armadura Segahuesos‡Excavaciones para la armadura Segahuesos‡Des morceaux pour la faucheuse d\'os‡骨镰的材料‡骨鐮的材料',
    nil,
    'Rohan, o Assassino, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 30 Fragmentos de Osso.‡Принесите 30 обломков костей Рогану Убийце в Часовню Последней Надежды в Восточные Чумные земли.‡Rohan der Assassine bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 30 Knochenfragmente.‡동부 역병지대, 희망의 빛 예배당에 있는 암살자 로한이 해골 조각 30개를 가져다 달라고 부탁했습니다.‡Rohan el Asesino, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 fragmentos de hueso.‡Rohan el Asesino, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 trozos de huesos.‡Rohan l’assassin, à la chapelle de l’Espoir de Lumière dans les Maleterres de l’est, veut 30 Fragments d’os.‡东瘟疫之地圣光之愿礼拜堂的杀手洛汉要30块白骨碎片。‡東瘟疫之地聖光之願禮拜堂的殺手洛漢要30塊白骨碎片。',
  }
},
[9127] = {
  -- Item
  '‡‡‡서판: 화염 저항 토템 II‡‡‡‡‡石板:抗火圖騰 II',
  nil,
  nil,
  { -- Quest
    'Fragmentos de Osso‡Обломки костей‡Knochenfragmente‡해골 조각‡Trozos de hueso‡Trozos de hueso‡Des fragments d\'os‡白骨碎片‡白骨碎片',
    nil,
    '‡‡‡나를 돕는 자가 해골 조각을 아무리 많이 가지고 와도 얼마든지 받아줄 수 있소. 남는 해골 조각이 있으면 가지고 오시오. 보상으로 또 다른 휘장을 줄 테니까!‡‡‡‡‡',
  }
},
[9128] = {
  -- Item
  '‡‡‡서판: 불꽃 회오리 토템 IV‡‡‡‡‡石板:火焰新星圖騰 IV',
  nil,
  nil,
  { -- Quest
    'A equação elemental‡Уравнение стихий‡Die Elementargleichung‡정령의 정수‡La ecuación elemental‡La ecuación elemental‡L\'équation élémentaire‡元素交易‡元素交易',
    nil,
    'A Arquimaga Ângela Santoro, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais, quer 30 Núcleo dos Elementos.‡Принесите 30 средоточий стихий верховному магу Анджеле Досантос в Часовню Последней Надежды в Восточные Чумные земли.‡Erzmagierin Angela Dosantos bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 30 Kerne der Elemente.‡동부 역병지대, 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 정령의 정수 30개를 가져다 달라고 합니다.‡La archimaga Ángela Dosantos, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 núcleos de elementos.|n‡La archimaga Ángela Dosantos, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 núcleos de elementos.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est veut 30 Noyaux des éléments.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯要30个元素之核。‡東瘟疫之地聖光之願禮拜堂的大法師安吉拉·杜薩圖斯要30個元素之核。',
  }
},
[9129] = {
  -- Item
  '‡‡‡서판: 대지의 무기 IV‡‡‡‡‡石板:石化武器 IV',
  nil,
  nil,
  { -- Quest
    'Núcleo dos Elementos‡Средоточие стихий‡Kern der Elemente‡정령의 정수‡Núcleo de elementos‡Núcleo de elementos‡Le noyau des éléments‡元素之核‡元素之核',
    nil,
    '‡‡‡사실은 정령의 정수로 얼음불꽃 의복을 만들어요. 낙스라마스에서 싸우는 마법사들이 입는 물건이죠. 당신 같은 분들이 없다면 우리는 이번 전쟁에서 분명 패배하고 말 거예요.nn그러니 정령의 정수를 되도록 많이 가져다주세요. 그 답례로 휘장을 더 드리겠어요.‡‡‡‡‡',
  }
},
[9131] = {
  -- Item
  '‡‡‡서판: 돌가죽 토템 V‡‡‡‡‡石板:石甲圖騰 V',
  nil,
  nil,
  { -- Quest
    'Vinculando a Couraçada‡Броня дредноута‡Bindung des Schreckenspanzers‡무쌍의 전투장비를 엮을 재료‡Armar la acorator‡Armar la acorator‡Armer un cuirassier‡无畏护甲的材料‡無畏護甲的材料',
    nil,
    'Korfax, lotado na Capela Esperança da Luz, nas Terras Pestilentas Orientais, quer 30 Sucatas de Ferro Negro.‡Принесите 30 пластин черного железа Корфаксу в Часовню Последней Надежды в Восточные Чумные земли.‡Korfax bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 30 Dunkeleisenfragmente.‡동부 역병지대, 희망의 빛 예배당에 있는 코팩스가 검은무쇠 조각 30개를 가져다 달라고 부탁했습니다.‡Korfax, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 fragmentos de hierro negro.‡Korfax, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 fragmentos de hierro negro.‡Korfax, de la chapelle de l’Espoir de Lumière dans les Maleterres de l’est, veut 30 Morceaux de sombre fer.‡东瘟疫之地圣光之愿礼拜堂的科尔法克斯需要30块黑铁碎片。‡東瘟疫之地聖光之願禮拜堂的科爾法克斯需要30塊黑鐵碎片。',
  }
},
[9132] = {
  -- Item
  '‡‡‡서판: 용암 작열 VI‡‡‡‡‡石板:熔岩爆裂 VI',
  nil,
  nil,
  { -- Quest
    'Sucata de Ferro Negro‡Лом черного железа‡Dunkeleisenfragmente‡검은무쇠 조각‡Fragmentos de hierro negro‡Fragmentos de hierro negro‡Des morceaux de sombrefer‡黑铁碎片‡黑鐵碎片',
    nil,
    '‡‡‡검은무쇠 조각을 한아름 가지고 올 때마다 휘장을 하나씩 주겠소. 많으면 많을수록 좋지. 자, 이 도끼 맛을 보고 싶지 않거든 썩 눈앞에서 사라지시오!‡‡‡‡‡',
  }
},
[9136] = {
  -- Item
  '‡‡‡서판: 마나 토템 III‡‡‡‡‡石板:法力之泉圖騰 III',
  { -- Npc
    'Sha\'ni Altapresa‡Ша\'ни Гордый Клык‡Sha\'ni Proudtusk‡샤니 프라우드터스크‡Sha\'ni Colminilludo‡Sha\'ni Colmillo Orgulloso‡Sha\'ni Proudtusk‡沙妮·长齿‡沙妮·長齒',
    nil,
  },
  nil,
  { -- Quest
    'Flora selvagem‡Дикая флора‡Wildpflanzen‡야생 잎사귀‡Flora salvaje‡Flora salvaje‡La flore sauvage‡蛮荒之叶‡蠻荒之葉',
    nil,
    'Rayne, baseada na Capela Esperança da Luz, nas Terras Pestilentas Orientais, quer 30 Frondes Selvagens.‡Принесите 30 диких ростков Райн в Часовню Последней Надежды в Восточные Чумные земли.‡Rayne bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern möchte 30 Wildwedel.‡동부 역병지대, 희망의 빛 예배당에 있는 레이네가 야생 잎사귀 30개를 가져다 달라고 부탁했습니다.‡Rayne, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 hojas salvajes.‡Rayne, de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, quiere 30 hojas salvajes.‡Rayne de la chapelle de l’Espoir de Lumière dans les Maleterres de l’est veut 30 Palmes sauvages.‡东瘟疫之地圣光之愿礼拜堂的莱茵需要30片蛮荒之叶。‡東瘟疫之地聖光之願禮拜堂的萊茵需要30片蠻荒之葉。',
  }
},
