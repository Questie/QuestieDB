[786] = {
  nil,
  { -- Npc
    'Grolin Barbabranca‡Грелин Белобород‡Grelin Whitebeard‡그렐린 화이트비어드‡Grelin Barbablanca‡Grelin Barbablanca‡Grelin Whitebeard‡格瑞林·白须‡格瑞林·白鬚',
