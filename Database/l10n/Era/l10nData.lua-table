[780] = {
  -- Item
  'Barbatana Rasgada de Murloc‡Рваный плавник мурлока‡Zerrissene Murlocflosse‡찢어진 멀록 지느러미‡Aletas de múrloc rotas‡Aletas de múrloc rotas‡Aileron de murloc déchiré‡破损的鱼人鳞片‡破損的魚人鱗片',
  { -- Npc
    'Místico Rachacrânio‡Мистик из племени Дробителей Черепов‡Mystiker der Skullsplitter‡백골가루부족 비술사‡Místico Machacacráneos‡Místico Machacacráneos‡Mystique Skullsplitter‡劈颅秘法师‡劈顱秘法師',
    nil,
