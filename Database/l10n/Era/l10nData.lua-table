[6150] = {
  -- Item
  '‡Истрепанный узелок‡Ein ausgefranster Knoten‡너덜너덜한 매듭‡Un nudo deshilachado‡Un nudo deshilachado‡Nœud en tissu râpé‡绳结‡繩結',
