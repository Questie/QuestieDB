  },
  nil,
  { -- Quest
    'Infestação Zukk\'ash‡Вторжение улья Цуккаш‡Zukk\'ash-Plage‡주크애쉬 출몰‡Infestación de Zukk\'ash‡Infestación de Zukk\'ash‡Infestation de Zukk\'ash‡祖卡什的入侵‡祖卡什的入侵',
    nil,
    'Traga 20 Carapaças de Zukk\'ash para Hadoken Passo Veloz na Aldeia Mojache, que fica em Feralas.‡Принесите 20 панцирей Цуккаш Хадокену Быстрому Страннику в Лагерь Мохаче в Фераласе.‡Bringt Hadoken Swiftstrider im Camp Mojache in Feralas 20 Zukk\'ashknochenpanzer.‡페랄라스의 모자케 야영지에 있는 아도겐 스위프트스트라이더에게 주크애쉬 등껍질 20개를 가져가야 합니다.‡Lleva 20 caparazones de Zukk\'ash a Hadoken Zancoveloz al Campamento Mojache de Feralas.‡Lleva 20 caparazones Zukk\'ash a Hadoken Zanco Veloz al Campamento Mojache en Feralas.‡Rapportez 20 Carapaces de Zukk\'ash à Hadoken Swiftstrider au Camp Mojache en Feralas.‡把20块祖卡什虫壳交给菲拉斯莫沙彻营地的哈杜肯·迅蹄。‡把20塊祖卡什蟲殼交給菲拉斯莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[7731] = {
  -- Item
  '‡Талисман призрачного осколка‡Geistsplittertalisman‡영석 부적‡Dije de fragmento fantasmal‡Dije de fragmento fantasmal‡Talisman d\'éclat fantôme‡鬼魅碎片护符‡鬼魂裂片護符',
  { -- Npc
    'Estalajadeira Jayka‡Хозяйка таверны Джайка‡Gastwirt Jayka‡여관주인 자이카‡Tabernero Jayka‡Tabernera Jayka‡Aubergiste Jayka‡旅店老板杰卡‡旅店老闆傑卡',
    'Hospedagem‡Хозяйка таверны‡Gastwirt‡여관주인‡Tabernero‡Tabernera‡Aubergiste‡旅店老板‡旅店老闆',
  },
  nil,
  { -- Quest
    'Cravaçoite‡Жалохвост‡Zornstachel‡채찍쐐기‡Aguijolatigador‡Latigador con aguijón‡Fouet-cuisant‡毒刺鞭笞者‡毒刺鞭笞者',
    nil,
    'Derrote Cravaçoite na Profundeza Atormentada, leve as glândulas para Hadoken Passo Veloz na Aldeia Mojache, que fica em Feralas.‡Убейте жалохвоста в Гудящей Бездне и принести железы ядохлеста Хадокену Быстрому Страннику в Лагерь Мохаче в Фераласе.‡Besiegt Zornstachel in der verwundenen Tiefe und bringt seine Drüsen zu Hadoken Swiftstrider im Camp Mojache in Feralas zurück.‡고통의 구덩이에서 채찍쐐기를 물리치고 페랄라스의 모자케 야영지에 있는 아도겐 스위프트스트라이더에게 분비선을 가져가야 합니다.‡Derrota a Aguijolatigador en Las Entrañas Retorcidas y lleva sus glándulas a Hadoken Zancoveloz al Campamento Mojache de Feralas.‡Derrota al latigador con aguijón en Las Galerías Retorcidas y lleva sus glándulas a Hadoken Zanco Veloz al Campamento Mojache en Feralas.‡Battez Fouet-cuisant dans le Gouffre grouillant et rapportez ses glandes à Hadoken Swiftstrider au Camp Mojache en Feralas.‡击败痛苦深渊中的毒刺鞭笞者，把它的腺体交给菲拉斯莫沙彻营地的哈杜肯·迅蹄。‡擊敗痛苦深淵中的毒刺鞭笞者，把它的腺體交給菲拉斯莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[7732] = {
  nil,
  { -- Npc
    'Inseto‡Баг‡Täuschkäfer‡복제 버그‡Chinche engañosa‡Chinche engañosa‡Blatte mécanique‡复制虫‡複製蟲',
    nil,
  },
  nil,
  { -- Quest
    'O relatório dos Zukk\'ash‡Донесение об улье Цуккаш‡Bericht über die Zukk\'ash‡주크애쉬 보고서‡El informe Zukk\'ash‡El informe Zukk\'ash‡Le rapport sur les Zukk\'ash‡祖卡什报告‡祖卡什報告',
    nil,
    'Entregue o Relatório sobre Zukk\'ash da Aldeia Mojache para Zilzibin Tamborleiro. Ele fica no Bazar de Orgrimmar.‡Доставьте отчет о нашествии насекомых-Цуккаш на Лагерь Мохаче Зилзибину Барабанному Бою, который проживает на Волоке в Оргриммаре.‡Bringt den Bericht über die Zukk\'ash aus Camp Mojache zu Zilzibin Drumlore. Er wohnt in der Gasse von Orgrimmar.‡오그리마 골목길에 사는 질지빈 드럼로어에게 모자케 야영지 주크애쉬 보고서를 전달해야 합니다.‡Entrega a Zilzibin Tambor Sabio el informe del campamento Mojache Zukk\'ash. Reside en La Calle Mayor de Orgrimmar.‡Entrega a Zilzibin Tambor Sabio el informe del campamento Mojache Zukk\'ash. Reside en La Calle Mayor de Orgrimmar.‡Apportez le rapport sur les Zukk\'ash du Camp Mojache à Zilzibin Drumlore. Il réside à la Herse d\'Orgrimmar‡把莫沙彻营地祖卡什报告交给奥格瑞玛暗巷区的基尔兹宾·鼓眼。‡把莫沙徹營地祖卡什報告交給奧格瑞瑪暗巷區的基爾茲賓·鼓眼。',
  }
},
