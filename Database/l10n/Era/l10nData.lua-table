[871] = {
  -- Item
  '‡Топор шквала‡Wirbelwindaxt‡질풍의 도끼‡Hacha aluvión‡Hacha aluvión‡Hache-rafale‡风暴战斧‡風暴戰斧',
  { -- Npc
    'Guerreiro Escama Salgada‡Воин племени Соленой Чешуи‡Krieger der Salzschuppen‡소금비늘멀록 전사‡Guerrero Escama de Sal‡Guerrero Escama de Sal‡Guerrier Selécaille‡盐鳞战士‡鹽鱗戰士',
    nil,
