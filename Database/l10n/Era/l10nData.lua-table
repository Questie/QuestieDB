[3881] = {
  nil,
  { -- Npc
    'Grimtak‡Гримтак‡Grimtak‡그림탁‡Grimtak‡Grimtak‡Grimtak‡格瑞姆塔克‡格瑞姆塔克',
    'Açougue‡Мясник‡Metzger‡푸줏간 주인‡Carnicero‡Carnicero‡Boucher‡屠夫‡屠夫',
  },
  -- Object
  '‡Яркий костер‡Loderndes Feuer‡선명한 불꽃‡Fuego llameante‡Fuego llameante‡Feu brûlant‡炽热的火焰‡熾熱的火焰',
  { -- Quest
    'A salvação da expedição‡Спасение экспедиции‡Rettungsexpedition‡원정대 구조‡Expedición Salvación‡Salvar a la expedición‡Le sauvetage de l\'expédition‡抢救物资‡搶救物資',
    nil,
    'Leve um Caixote de Comestíveis e o Equipamento de Pesquisa para Williden Marshal in Cratera Un\'Goro.‡Принесите ящик с провизией и исследовательское оборудование Виллидену Маршалу в Кратер Ун\'Горо.‡Bringt eine Kiste mit Nahrungsmitteln und Forscherausrüstung zu Williden Marshal im Un\'Goro Krater.‡운고로 분화구에 있는 윌리덴 마샬에게 식량 상자와 탐사 장비를 가져가야 합니다.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Apporter une Caisse de nourriture et de l\'Equipement de recherche à Williden Marshal dans le Cratère d\'Un\'Goro.‡将食物箱和研究设备交给安戈洛环形山的威利德·马绍尔。‡將食物箱和研究設備交給安戈洛環形山的威利德·馬紹爾。',
  }
},
[3882] = {
  -- Item
  '‡Перо канюка‡Bussardfeder‡대머리수리 깃털‡Pluma de águila ratonera‡Pluma de águila ratonera‡Plume de busard‡秃鹫的羽毛‡禿鷲的羽毛',
  { -- Npc
    'Zlagk‡Зляк‡Zlagk‡즐락크‡Zlagk‡Zlagk‡Zlagk‡兹拉克‡茲拉克',
    'Açougue‡Мясник‡Metzger‡푸줏간 주인‡Carnicero‡Carnicero‡Boucher‡屠夫‡屠夫',
  },
  -- Object
  '‡Яркий костер‡Loderndes Feuer‡선명한 불꽃‡Fuego llameante‡Fuego llameante‡Feu brûlant‡炽热的火焰‡熾熱的火焰',
  { -- Quest
    'Osso duro de roer‡Игра в кости‡Knochenklappern‡뼈 수집‡Choca esos huesos‡Choca esos huesos‡Faites rouler les os‡挖骨头‡挖骨頭',
    nil,
    'Leve 8 Ossos de Dinossauro para Chispa Minanilo na Cratera Un\'Goro.‡Принесите 8 костей динозавра Искру Пустокопу в Кратер Ун\'Горо.‡Bringt 8 Dinosaurierknochen zu Spark Nilminer im Un\'Goro Krater.‡운고로 분화구에 있는 스파크 닐마이너에게 공룡 뼈 8개를 가져가야 합니다.‡Lleva 8 huesos de dinosaurio a Chispik Nilminer en el Cráter de Un\'Goro.‡Lleva 8 huesos de dinosaurio a Chispik Minamal en el Cráter de Un\'Goro.‡Apporter 8 Os de dinosaure à Spark Nilminer, au cratère d\'Un\'Goro.‡将8根恐龙骨头交给安戈洛环形山的斯巴克·尼米尔。‡將8根恐龍骨頭交給安戈洛環形山的斯巴克·尼米爾。',
  }
},
[3883] = {
  nil,
  { -- Npc
    'Moodan Grão Solar‡Модан Солнечный Колос‡Moodan Sungrain‡무단 선그레인‡Moodan Granosol‡Moodan Granosol‡Moodan Sungrain‡穆恩丹·秋谷‡穆恩丹·秋谷',
    'Padeiro‡Пекарь‡Bäcker‡빵 상인‡Panadero‡Panadero‡Boulanger‡面包师‡麵包師',
  },
  -- Object
  '‡Яркий костер‡Loderndes Feuer‡선명한 불꽃‡Fuego llameante‡Fuego llameante‡Feu brûlant‡炽热的火焰‡熾熱的火焰',
  { -- Quest
    'Ecologia forânea‡Экология чужих‡Eine fremdartige Ökologie‡외래 생태계‡Ecología alienígena‡Ecología alienígena‡Ecologie étrangère‡异型的生态‡異型的生態',
    nil,
    'Use a Ampola de Amostra para coletar uma Amostra de Parede de Colmeia de uma das incubadoras Gorishi na Cratera Un\'Goro. Procure as câmaras com larvas.|nLeve a Amostra de Parede de Colmeia para Hol\'anyee Marshal na Cratera Un\'Goro.‡Воспользуйтесь фиалом для образцов, чтобы взять образец материала стены улья из одного из инкубаторов Гориши в Кратере Ун\'Горо. Ищите в ульях комнаты со свисающими гроздьями личинок.|nПринесите образец материала стены улья Холании Маршал в Кратер Ун\'Горо.‡Verwendet die Kratzphiole, um damit eine Schwarmbauwandprobe von einer der Schwarmbrutstätten der Gorishi im Un\'Goro Krater zu holen. Sucht nach den Kammern mit der hängenden Larvenbrut.|nBringt die Schwarmbauwandprobe zu Hol\'anyee Marshal im Un\'Goro Krater.‡운고로 분화구에 있는 고리쉬 부화장에서 채집 약병을 사용해 고리쉬집 벽면 견본을 채취하십시오. 유충알이 매달려 있는 방을 찾아야 합니다.|n운고로 분화구에 있는 홀라니에 마샬에게 고리쉬집 벽면 견본을 가져가야 합니다.‡Utiliza el vial raspador para recoger una Muestra de pared de la colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|nLleva la Muestra de pared de la colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliza el vial de raspadura para recoger una Muestra de pared de colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|nLleva la Muestra de pared de colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliser la Fiole de raclement pour récolter un Echantillon de paroi de la ruche dans une des nurseries de la ruche Gorishi, à l’intérieur du cratère d\'Un\'Goro. Chercher les chambres qui contiennent des larves suspendues.|nApporter l’Echantillon de paroi de la ruche à Hol\'anyee Marshal dans le cratère d\'Un\'Goro.‡使用采集瓶从安戈洛环形山的某个格里什虫巢的孵化室中收集一份巢穴侧壁的样本，在有悬挂着的虫卵的房间里收集样本。|n将虫穴内壁样本交给安戈洛环形山的霍莱伊·马绍尔。‡使用采集瓶從安戈洛環形山的某個格裏什蟲巢的孵化室中收集壹份巢穴側壁的樣本，在有懸掛著的蟲卵的房間裏收集樣本。|n將蟲穴內壁樣本交給安戈洛環形山的霍萊伊·馬紹爾。',
  }
},
[3884] = {
  nil,
  { -- Npc
    'Jhauna Ventos d\'Aveia‡Джауна Свирель Ветра‡Jhawna Oatwind‡쟈우나 오트윈드‡Jhawna Viento de Avena‡Jhawna Viento de Avena‡Jhawna Oatwind‡加纳·麦风‡加納·麥風',
    'Padeiro‡Пекарь‡Bäckerin‡빵 상인‡Panadera‡Panadera‡Boulanger‡面包师‡麵包師',
  },
  -- Object
  '‡Яркий костер‡Loderndes Feuer‡선명한 불꽃‡Fuego llameante‡Fuego llameante‡Feu brûlant‡炽热的火焰‡熾熱的火焰',
  { -- Quest
    'Diário de Williden‡Дневник Вилидена‡Willidens Tagebuch‡윌리덴의 일지‡Diario de Williden‡Diario de Williden‡Le journal de Williden‡威利德的日记‡威利德的日記',
    nil,
    'Devolva o diário a Williden Marshal na Cratera Un\'Goro.‡Верните дневник Виллидену Маршалу, который находится где-то в Кратере Ун\'Горо.‡Bringt das Tagebuch zu Williden Marshal zurück. Er befindet sich irgendwo im Un\'Goro Krater.‡운고로 분화구 어딘가에 있는 윌리덴 마샬에게 일지를 돌려줘야 합니다.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Rapporter le Journal à Williden Marshal quelque part dans le Cratère d\'Un\'Goro.‡将日记还给安戈洛环形山中的威利德·马绍尔。‡將日記還給安戈洛環形山中的威利德·馬紹爾。',
  }
},
