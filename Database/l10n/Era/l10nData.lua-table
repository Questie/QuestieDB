[776] = {
  -- Item
  '‡Вендетта‡Blutrache‡복수의 단검‡‡‡‡仇杀‡仇殺',
  nil,
  nil,
  { -- Quest
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les Rites de la Terre-mère‡大地之母仪祭‡大地之母儀祭',
    nil,
    'Caerne Casco Sangrento, no Penhasco do Trovão, quer que você leve para ele o Chifre de Arra\'chea.‡Кэрн Кровавый Рог из Громового Утеса попросил принести ему рог Арра\'чеи.‡Cairne Bloodhoof in Thunder Bluff möchte, dass Ihr ihm das Horn von Arra\'chea bringt.‡썬더 블러프에 있는 케른 블러드후프가 알라치아의 뿔을 가져다 달라고 부탁했습니다.‡Cairne Pezuña de Sangre de Cima del Trueno quiere que le lleves el cuerno de Arra\'chea.‡Cairne Pezuña de Sangre de Cima del Trueno quiere que le lleves el cuerno de Arra\'chea.‡Apporter la Corne d\'Arra\'chea à Cairne Bloodhoof, à Thunder Bluff‡雷霆崖的凯恩·血蹄要你将阿兰其亚的角带给他。‡雷霆崖的凱恩·血蹄要妳將阿蘭其亞的角帶給他。',
  }
},
[777] = {
