[86] = {
  nil,
  nil,
  -- Object
  '‡Элвиннский лес‡Der Wald von Elwynn‡엘윈 숲‡Bosque de Elwynn‡Bosque de Elwynn‡Forêt d\'Elwynn‡艾尔文森林‡艾爾文森林',
  { -- Quest
    'Juntando a fome...‡Пирог для Билли‡Pastete für Billy‡빌리를 위한 파이‡Un pastel para Billy‡Un pastel para Billy‡Une tourte pour Billy‡比利的馅饼‡比利的餡餅',
    nil,
    'Leve 4 Nacos de Carne de Javali Macia para a "Titia" Berenice Campedra na Fazenda dos Campedra.‡Принесите 4 куска кабаньего мяса на ферму Стоунфилд и отдайте тетушке Бернис.‡Bringt 4 Brocken Eberfleisch zu Tantchen Bernice Stonefield auf den Hof der Stonefields.‡스톤필드 농장에 있는 보모 버니스 스톤필드에게 멧돼지 고기 4개를 가져가야 합니다.‡Lleva 4 trozos de carne de jabalí a la tía Bernice Pedregosa a La Granja Pedregosa.‡Lleva 4 trozos de carne de jabalí a la tía Bernice Pedregosa en la Granja Pedregosa.‡Apporter 4 morceaux de Viande de sanglier à Tatie Bernice Stonefield à la ferme des Stonefield.‡给斯通菲尔德农场的波尼斯·斯通菲尔德带去4块野猪肉。‡給斯通菲爾德農場的波尼斯·斯通菲爾德帶去4塊野豬肉。',
  }
},
[87] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡森林食人妖狂戰士',
