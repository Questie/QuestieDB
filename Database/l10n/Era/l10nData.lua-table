[407] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Campos de mágoa‡Поля горя‡Felder des Kummers‡오염된 농장‡Campos de pena‡Campos de pena‡Les Champs du Chagrin‡悲伤之地‡悲傷之地',
    nil,
    'Leve a Abóbora Inoculada para o Zelote Escarlate Capturado que esta sendo mantido no porão da Taberna Nó da Forca.‡Отнесите отравленную тыкву пленному ревнителю из Алого ордена, которого держат в погребе таверны "Петля Висельника".‡Bringt den getränkten Kürbis zum gefangenen Scharlachroten Zeloten, der im Keller der Taverne Zur Galgenschlinge gefangen gehalten wird.‡사로잡힌 붉은십자군 광신도에게 줄무늬 호박을 가져다주십시오. 갤로우 선술집 지하실에 갇혀 있습니다.‡Llévale la calabaza envenenada al integrista Escarlata capturado que está encerrado en el sótano del Mesón La Horca.‡Llévale la calabaza envenenada al zelote Escarlata capturado que está encerrado en el sótano del Mesón La Horca.‡Donner la citrouille enchantée au Zélote écarlate capturé qui est gardé dans le cellier de la taverne des Pendus.‡将斑纹南瓜带给被关在恐惧之末旅店地下室中的血色十字军俘虏。‡將斑紋南瓜帶給被關在恐懼之末旅店地下室中的血色十字軍俘虜。',
  }
},
[408] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A cripta da família‡Семейный склеп‡Die Familiengruft‡아가만드가 납골당‡La Cripta de la Familia‡La Cripta de la Familia‡La Crypte Familiale‡家族墓穴‡家族墓穴',
    nil,
    'Mate 8 Ancestrais Ululantes e 8 Ancestrais Apodrecidos.|nMate o Capitão Dargol, e leve seu crânio para o Magistrado Sevren em Montalvo.‡Убейте 8 стенающих предков и 8 гниющих предков.|nУбейте капитана Даргола и принесите его череп мировому судье Севрену в Брилл.‡Tötet 8 Klagende Vorfahren und 8 Faulende Vorfahren.|nTötet Captain Dargol und bringt seinen Schädel zu Magistrat Sevren nach Brill.‡울부짖는 아가만드 망령 8마리와 썩어가는 아가만드 시체 8마리를 처치해야 합니다.|n대장 다르골을 처치하고 그의 해골을 브릴에 있는 집정관 세브렌에게 가져가야 합니다.‡Mata a 8 ancestros de los Lamentos y a 8 ancianos putrefactos.|nMata al capitán Dargol y llévale su calavera al magistrado Sevren de Rémol.‡Mata a 8 ancestros gemebundos y a 8 ancestros en podredumbre.|nMata al capitán Dargol y llévale su calavera al magistrado Sevren de Rémol.‡Tuer 8 Spectres ancestraux et 8 Ancêtres pourrissants.|nTuer le capitaine Dargol et ramener son crâne au magistrat Sevren à Brill.‡杀死8个哀嚎的鬼魂和8个腐烂的古尸。|n消灭达高尔队长，并将他的颅骨交给布瑞尔的执政官塞弗伦。‡殺死8個哀嚎的鬼魂和8個腐爛的古屍。|n消滅達高爾隊長，並將他的顱骨交給布瑞爾的執政官塞弗倫。',
  }
},
[409] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Prova de lealdade‡Доказательство преданности‡Treuebeweis‡동맹의 증거‡Prueba de lealtad‡Prueba de lealtad‡Prouver l\'allégeance‡证明忠诚‡證明忠誠',
    nil,
    'Obtenha uma Vela de Sinalização.|nEvoque e mate Lillith Nefara.|nFale novamente com Tertuliano em sua ilha.‡Возьмите манящую свечу.|nВызовите Лилит Нефару и убейте ее.|nВернитесь на остров к Гюнтеру.‡Beschafft Euch eine Kerze des Heranlockens.|nBeschwört Lillith Nefara und tötet sie.|nKehrt zu Gunther auf seiner Insel zurück.‡부름의 양초를 얻어야 합니다.|n릴리스 네파라를 소환하여 처치해야 합니다.|n그 후에 섬에 있는 군터에게 돌아가도록 하십시오.‡Coge una vela de señalización.|nDespierta a Lillith Nefala y mátala.|nVuelve a ver a Gunther a su isla.‡Coge una vela de señalización.|nDespierta a Lillith Nefala y mátala.|nVuelve a ver a Gunther a su isla.‡Obtenir une Bougie de signal.|nInvoquer Lillith Nefara et la tuer.|nRetourner voir Gunther sur son île.‡拿上一根诱灵蜡烛。|n召唤出莉莉丝·奈法拉并杀死她。|n然后向岛上的冈瑟尔回报。‡拿上壹根誘靈蠟燭。|n召喚出莉莉絲·奈法拉並殺死她。|n然後向島上的岡瑟爾回報。',
  }
},
