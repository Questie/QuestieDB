[274] = {
  nil,
  { -- Npc
    'Taberneiro Ramos‡Кабатчик Ханн‡Barkeeper Hann‡바텐더 한‡Posadero Hann‡Posadero Hann‡Hann le tavernier‡酒吧老板汉恩‡酒吧老闆漢恩',
    'Garçom‡Бармен‡Schankkellner‡바텐더‡Camarero‡Camarero‡Tavernier‡调酒师‡酒保',
  },
  nil,
  { -- Quest
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'Ashlan Risadura quer que você fale novamente com o Engenheiro-chefe Vedaçude e avise-o sobre a nova descoberta.‡Сообщите главному инженеру Камнехмылу о нейтрализующем коллоиде.‡Ashlan Stonesmirk möchte, dass Ihr zum Chefingenieur Hinderweir zurückkehrt und ihn von der neuen Entdeckung in Kenntnis setzt.‡애실런 스톤스머크가 선임기술자 힌더바이르에게 돌아가 새로 발견한 사실을 알려 줄 것을 부탁했습니다.‡Ashlan Risapétrea quiere que regreses con el ingeniero jefe Hinderweir y le informes sobre el nuevo descubrimiento.‡Ashlan Risapétrea quiere que regreses con el ingeniero jefe Hinderweir y le informes sobre el nuevo descubrimiento.‡Sur ordre d\'Ashlan Stonesmirk, retourner voir l\'Ingénieur en chef Hinderweir pour l\'informer de la nouvelle découverte.‡阿什兰·暗石要你回去见主工程师辛德维尔七世，把有关这种炸药的新发现告诉他。‡阿什蘭·暗石要妳回去見主工程師辛德維爾七世，把有關這種炸藥的新發現告訴他。',
  }
},
[275] = {
  nil,
  { -- Npc
    'Pernando Fessoa‡Саш Пушинк‡Whit Wantmal‡휘트 완트몰‡Whit Wantmal‡Whit Wantmal‡Whit Wantmal‡维特·沃特玛‡維特·沃特瑪',
    nil,
  },
  nil,
  { -- Quest
    'Pústulas na terra‡Нарывы на теле земли‡Schwärendes Land‡대지의 상처‡Ampollas en la tierra‡Ampollas en la tierra‡Fièvre sur le pays‡大地上的脓疱‡大地上的膿皰',
    nil,
    'Mate 12 Rastejantes do Pântano, depois fale novamente com Rethiel, o Verdião no Pantanal.‡Убейте 12 трясинных ползунов и вернитесь к Ретилю Стражу Природы в Болотину.‡Tötet 12 Moorkrabbler und kehrt dann zu Rethiel dem Sumpfhüter im Sumpfland zurück.‡수렁이끼괴물 12마리를 처치한 다음 저습지에 있는 신록의수호자 레시엘에게 돌아가야 합니다.‡Mata 12 Trepadores del cubil y regresa con Rethiel el Guardaverde en Los Humedales.‡Mata a 12 trepadores del pantano y regresa con Rethiel el Guardaverde en Los Humedales.‡Tuer 12 Rampants des tourbières, puis retourner voir Rethiel, le Gouverneur vert, dans les Paluns.‡杀死12只沼泽爬行者，然后向湿地的绿色守卫者雷希耶尔复命。‡殺死12只沼澤爬行者，然後向濕地的綠色守衛者雷希耶爾復命。',
  }
},
[276] = {
  nil,
  { -- Npc
    'Vitório Prismado‡Виктор Призм’Антрас‡Viktori Prism\'Antras‡빅토리 프리즘안트라스‡Viktori Prism\'Antras‡Viktori Prism\'Antras‡Viktori Prism\'Antras‡维克托·安特拉斯‡維克托·安特拉斯',
