[4449] = {
  -- Item
  '‡Клык Нараксиса‡Naraxis\' Fangzahn‡나락시스의 송곳니‡Colmillo de Naraxis‡Colmillo de Naraxis‡Croc de Naraxis‡纳拉克西斯的牙齿‡納拉克西斯的牙齒',
  { -- Npc
    '‡‡‡‡‡‡‡‡克拉索·滑鏈',
    '‡‡‡‡‡‡‡‡地精獎券商',
  },
  nil,
  { -- Quest
    'Calça arriada!‡Попался!‡Eingesperrt!‡화장실에 갇힌 사람‡Atrapado‡Atrapado‡Piégé !‡被锁起来的矮人‡被鎖起來的矮人',
    nil,
    'Mate 8 Geólogos Ferro Negro e leve 15 pedaços de Seda para a pessoa que está trancada na casinha na Garganta Abrasadora.‡Убейте 8 геологов из клана Черного Железа и принесите 15 отрезов шелка тому, кто заперт в отхожем месте в Тлеющем ущелье.‡Tötet 8 Geologen der Dunkeleisenzwerge und bringt der Person, die im Plumpsklo in der sengenden Schlucht eingesperrt ist, 15 Stücke Seidenstoff.‡검은무쇠단 지질학자 8명을 처치하고 이글거리는 협곡의 화장실에 갇힌 사람에게 비단 옷감 15개를 가져가야 합니다.‡Mata a 8 geólogos Hierro Negro y lleva 15 piezas de seda a la persona encerrada en los baños de La Garganta de Fuego.‡Mata a 8 geólogos Hierro Negro y lleva 15 paños de seda a la persona encerrada en las letrinas de La Garganta de Fuego.‡Tuer 8 Géologues Sombrefer et rapporter 15 morceaux d’Etoffe de soie à la personne enfermée de les toilettes de la gorge des Vents brûlants.‡杀掉8个黑铁地质学家，并将15块丝绸交给灼热峡谷里那个被锁在厕所中的矮人。‡殺掉8個黑鐵地質學家，並將15塊絲綢交給灼熱峽谷裏那個被鎖在廁所中的矮人。',
  }
},
[4450] = {
  -- Item
  'Fragmento de Signo‡Фрагмент печати‡Siegelzeichenfragment‡인장 조각‡Trozo de sigilo‡Trozo de sigilo‡Fragment de glyphe‡符印碎片‡符印碎片',
  { -- Npc
    '‡‡‡‡‡‡‡‡魯格菲斯',
    '‡‡‡‡‡‡‡‡哥布林獎券商',
  },
  nil,
  { -- Quest
    'Livro-Caixa de Tanaris‡Учетная книга из Танариса‡Geschäftsbuch aus Tanaris‡타나리스의 장부‡El libro de contabilidad de Tanaris‡El libro de contabilidad de Tanaris‡Grand livre de Tanaris‡塔纳利斯的账本‡塔納利斯的賬本',
    nil,
    'Pegue a cópia do Livro-Caixa de Rugov A. Massoaço e encontre os itens listados antes de ir falar com ele em Tanaris.‡Возьмите учетную книгу Кринкеля Сталлинна и найдите все перечисленные в ней вещи. Затем отнесите их и книгу Кринкелю Сталлинну в Танарис.‡Nehmt die Abschrift von Goodsteels Geschäftsbuch und beschafft Euch dann die darin aufgeführten Gegenstände, ehe Ihr Krinkle Goodsteel in Tanaris aufsucht.‡굿스틸 장부를 가지고 거기에 적힌 물건들을 다 모은 다음 타나리스에 있는 크린클 굿스틸을 찾아가야 합니다.‡Coge el libro de contabilidad de Buenacero y busca los objetos de la lista antes de ir a verlo a Tanaris.‡Coge el libro de contabilidad de Buenacero y busca los objetos de la lista antes de ir a verlo a Tanaris.‡Prendre la copie du Livre de Goodsteel, puis collecter les objets qui y sont listés avant d’aller voir Krinkle Goodsteel, à Tanaris.‡把古德斯迪尔的账本和上面所列的物品交给塔纳利斯的克林科·古德斯迪尔。‡把古德斯迪爾的賬本和上面所列的物品交給塔納利斯的克林科·古德斯迪爾。',
  }
},
[4451] = {
  nil,
  { -- Npc
    'Auld Agulha de Pedra‡Ольд Каменное Копье‡Auld Stonespire‡아울드 스톤스파이어‡Auld Picopiedra‡Auld Picopiedra‡Stonespire le Vieil‡奥尔德·石塔‡奧爾德·石塔',
