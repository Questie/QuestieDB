[2278] = {
  -- Item
  '‡Эполеты лесного следопыта‡Schulterklappen des Fährtenlesers‡숲 순찰자의 견장‡Cubrehombros de rastreador de bosque‡Cubrehombros de rastreador de bosque‡Epaulettes de pisteur sylvestre‡森林追踪者护肩‡森林追蹤者肩冑',
  { -- Npc
    'Melissara‡Мелизара‡Melisara‡멜리사라‡Melisara‡Melisara‡Melisara‡梅里萨拉‡梅里薩拉',
    nil,
  },
  nil,
  { -- Quest
    'Os discos de platina‡Платиновые Диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Fale com o vigia de pedra e descubra quais são os segredos da história antiga que ele guarda. Após aprender os segredos históricos, ative os Discos de Norgannon.‡Поговорите с каменным Стражем и запомните все, что он передаст вам. Когда он закончит свой пересказ событий древности, активируйте диски Норганнона.‡Sprecht mit dem Steinbehüter und findet heraus, welche uralten Lehren er aufbewahrt. Sobald Ihr alles erfahren habt, was er weiß, aktiviert die Scheiben von Norgannon.‡바위감시자와 대화하고 그가 알고 있는 고대의 지식을 배우십시오. 지식을 배운 후에는 노르간논의 원반을 가동하십시오.‡Habla con el guardapiedras y descubre qué conocimiento antiguo alberga. Cuando hayas adquirido el conocimiento que te ofrece, activa los Discos de Norgannon.‡Habla con el vigía de piedra y descubre qué conocimiento antiguo alberga. Cuando hayas adquirido el conocimiento que te ofrece, activa los Discos de Norgannon.‡Parler au Gardien des pierres pour connaître le Savoir qu\'il défend. Une fois découvert ce qu\'ils peuvent offrir, activer les Disques de Norgannon.‡和石头守护者交谈，从他那里了解更多古代的知识。一旦你了解到了所有的内容之后就激活诺甘农圆盘。‡和石頭守護者交談，從他那裏了解更多古代的知識。壹旦妳了解到了所有的內容之後就激活諾甘農圓盤。',
  }
},
[2279] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡聯盟衛兵',
    nil,
  },
  nil,
  { -- Quest
    'Os discos de platina‡Платиновые Диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve a versão em miniatura dos Discos de Norgannon para a Liga dos Exploradores em Altaforja.‡Отнесите миниатюрную копию дисков Норганнона в Лигу Исследователей в Стальгорне.‡Bringt die Miniaturausgabe der Scheiben von Norgannon zur Forscherliga nach Ironforge.‡아이언포지에 있는 탐험가 연맹에 노르간논의 소형 백금 원반을 가져가야 합니다.‡Lleva la reproducción en miniatura de los Discos de Norgannon a la Liga de Expedicionarios de Forjaz.‡Lleva la reproducción en miniatura de los Discos de Norgannon a la Liga de Expedicionarios de Forjaz.‡Apporter la version miniature des Disques de Norgannon à la Ligue des Explorateurs à Ironforge.‡把迷你版的诺甘农圆盘带到铁炉堡的探险者协会去。‡把迷妳版的諾甘農圓盤帶到鐵爐堡的探險者協會去。',
  }
},
[2280] = {
  -- Item
  '‡Трость Кэма‡Kams Wanderstecken‡캄의 지팡이‡Cachava de Kam‡Cachava de Kam‡Canne de marche de Kam‡黑铁手杖‡黑鐵手杖',
  { -- Npc
    '‡‡‡‡‡‡‡‡部落衛兵',
    nil,
  },
  nil,
  { -- Quest
    'Os discos de platina‡Платиновые Диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve a versão em miniatura dos Discos de Norgannon para algum dos sábios no Penhasco do Trovão.‡Отнесите миниатюрную копию дисков Норганнона кому-то из мудрецов с Громового Утеса.‡Bringt die Miniaturausgabe der Scheiben von Norgannon zu einem der Weisen von Thunder Bluff.‡썬더 블러프에 있는 현자 중 하나에게 노르간논의 소형 원반을 가져가야 합니다.‡Lleva la versión de miniatura de los discos de Norgannon a uno de los sabios en Cima del Trueno.‡Lleva la versión de miniatura de los discos de Norgannon a uno de los sabios en Cima del Trueno.‡Apporter la version miniature des Disques de Norgannon à l\'un des Sages de Thunder Bluff.‡把迷你版的诺甘农圆盘带到雷霆崖的贤者那里。‡把迷妳版的諾甘農圓盤帶到雷霆崖的賢者那裏。',
  }
},
[2281] = {
  -- Item
  '‡Кремниевый топор Родентии‡Rodentiafeuersteinaxt‡동굴쥐 돌도끼‡Hacha de sílex Rodentia‡Hacha de sílex Rodentia‡Hache rodentienne en silex‡鼠类石斧‡鼠類石斧',
  { -- Npc
    '‡‡‡‡‡‡‡‡拜里斯·霜刺',
    '‡‡‡‡‡‡‡‡靈魂醫者',
  },
  nil,
  { -- Quest
    'Encontro em Cristarrubra‡Встречи в Красногорье‡Rendezvous im Rotkammgebirge‡붉은마루 집결‡Cita en Crestagrana‡Cita en Crestagrana‡Le Rendez-vous des Carmines‡赤脊山的联络员‡赤脊山的聯絡員',
    nil,
    'Vá até a Vila Plácida, nas Montanhas Cristarrubra, e fale com Lucius.‡Пойдите к Приозерью в Красногорье и поговорите с Люцием.‡Geht nach Seenhain im Rotkammgebirge und sprecht mit Lucius.‡붉은마루 산맥의 레이크샤이어로 가서 루시우스와 대화해야 합니다.‡Adéntrate en Villa del Lago, en las Montañas Crestagrana, y habla con Lucius.‡Adéntrate en Villa del Lago, en las Montañas Crestagrana, y habla con Lucius.‡S\'aventurer vers Lakeshire dans les Carmines et parler à Lucius.‡到赤脊山的湖畔镇去和卢修斯谈一谈。‡到赤脊山的湖畔鎮去和盧修斯談壹談。',
  }
},
[2282] = {
  -- Item
  '‡Короткий меч Родентии‡Rodentiakurzschwert‡동굴쥐 쇼트소드‡Espada corta Rodentia‡Espada corta Rodentia‡Epée courte rodentienne‡鼠类短剑‡鼠類短劍',
  nil,
  nil,
  { -- Quest
    'Serraria Alther‡Лесопилка Альтера‡Althers Mühle‡앨더의 제재소‡Molino de Alther‡Molino de Alther‡La scierie d\'Alther‡奥瑟尔伐木场‡奧瑟爾伐木場',
    nil,
    'Abra o Baú do Lucius, recupere o Símbolo de Ladroagem e devolva-o ao Lucius na Vila Plácida.‡Откройте сундук Люция, достаньте Руну Воровства и вернитесь к Люцию в Приозерье.‡Öffnet Lucius\' Schließkassette, nehmt die Marke der Diebeskunst heraus und bringt sie zu Lucius nach Seenhain.‡루시우스의 금고를 열고 도적의 징표를 회수한 다음 레이크샤이어에 있는 루시우스에게 가져가야 합니다.‡Abre la caja fuerte de Lucius y llévale la muestra de robo a Villa del Lago.‡Abre la caja fuerte de Lucius y llévale la muestra de robo a Villa del Lago.‡Ouvrir le Coffret de Lucius, récupérer le Gage de voleur et le rapporter à Lucius à Lakeshire.‡打开卢修斯的箱子，拿到偷窃技能证明物，然后把它归还给湖畔镇的卢修斯。‡打開盧修斯的箱子，拿到偷竊技能證明物，然後把它歸還給湖畔鎮的盧修斯。',
  }
},
[2283] = {
  -- Item
  '‡Крысиный матерчатый пояс‡Rattenstoffgürtel‡동굴쥐 헝겊 허리띠‡Cinturón de paño de rata‡Cinturón de paño de rata‡Ceinture en poil de rat‡坑道鼠腰带‡坑道鼠腰帶',
  { -- Npc
    'Regente de Corvinalle‡Регент Когтя Ворона‡Regent von Rabenklaue‡까마귀발톱 섭정‡Regente Corvozarpa‡Regente Corvozarpa‡Régent Ravenclaw‡鸦爪摄政者‡鴉爪攝政者',
