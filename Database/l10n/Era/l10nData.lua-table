[3451] = {
  -- Item
  '‡Зелье света в ночи‡Nachtschimmergebräu‡야광 물약‡Brebaje Resplandor nocturno‡Brebaje Resplandor nocturno‡Décoction de lueur nocturne‡夜光之药‡夜光之藥',
  { -- Npc
    'Piloto Manivela‡Пилот Зизгаг‡Pilot Wizzlecrank‡조종사 위즐크랭크‡Piloto Rabiaire‡Piloto Rabiaire‡Pilote Wizzlecrank‡驾驶员维兹克兰克‡駕駛員維茲克蘭克',
    nil,
  },
  nil,
  { -- Quest
    'Me chama que eu vou!‡Сигнал "Взять на борт!"‡Signal zum Abholen‡배달 신호‡Una señal para el envío‡Una señal para el envío‡Signal de la récupération‡信号发射器‡信號發射器',
    nil,
    'Fale com Xisto Acendefase e consiga uma Pistola Sinalizadora Modelo Padrão com ele em Altaforja.‡Поговорите с Хиггсом Зажигателем в Стальгорне и получите от него сигнальное ружье.‡Sprecht mit Xiggs Fuselighter in Ironforge und erhaltet von ihm eine Standardausrüstung-Leuchtfeuerwaffe.‡아이언포지에서 시그스 퓨즈라이터와 대화하고 그에게서 기본지급품 신호탄을 받아야 합니다.‡Habla con Xiggs Luzfusil para que te dé una pistola de bengalas en Forjaz.‡Habla con Xiggs Botafuego para que te dé una pistola de bengalas en Forjaz.‡Parler à Xiggs Fuselighter à Ironforge et en obtenir un Lance-fusée standard.‡与铁炉堡的希格斯·熔火谈一谈，从他那儿获得一支标准型闪光信号枪。‡與鐵爐堡的希格斯·熔火談壹談，從他那兒獲得壹支標準型閃光信號槍。',
  }
},
[3452] = {
