[248] = {
  nil,
  { -- Npc
    'Vovó Campedra‡Бабуля Стоунфилд‡Oma Stonefield‡스톤필드 할머니‡Abuela Pedregosa‡Abuela Pedregosa‡Mamie Stonefield‡米莱德·斯通菲尔德‡斯通菲爾德老奶奶',
    nil,
  },
  nil,
  { -- Quest
    'Vendo além‡Пронизывающий взор‡Weitere Beobachtungen‡자세한 조사‡Ver más allá‡Ver más allá‡En regardant plus loin‡监视‡監視',
    nil,
    'Suba ao topo da torre de vigia intacta ao lado da Bastilha Mirante de Pedra.|nEncontre um recipiente adequado para colocar o Glifo de Azora.‡Поднимитесь на уцелевшую башню рядом с крепостью Каменной Стражи.|nОтыщите подходящее место и спрячьте там амулет Азоры.‡Steigt in den unversehrten Wachturm neben der Burg Steinwacht hinauf.|nFindet einen passenden Behälter für die Glyphe von Azora und legt diese dort ab.‡돌망루 요새 옆에 있는 감시탑에 올라가야 합니다.|n그곳에서 아조라의 조각상을 넣어 두기에 적합한 용기를 찾아야 합니다.‡Sube a la atalaya intacta que hay junto al Fuerte de Petravista.|nEncuentra un objeto en el que esconder el Glifo de Azora.‡Trepa la torre de vigilancia intacta junto a Fuerte de Petravista.|nEncuentra un contenador apropriado para colocar el Glifo de Azora.‡Monter au sommet de la Tour de garde intacte près du Donjon de Guet-de-pierre, puis trouver dans quoi placer le Glyphe d\'Azora.‡爬上石堡要塞一旁的哨塔。|n为阿祖拉的铭文饰品找一个合适的容器。‡爬上石堡要塞壹旁的哨塔。|n為阿祖拉的銘文飾品找壹個合適的容器。',
  }
},
[249] = {
  nil,
  nil,
  -- Object
  '‡Ящик с провизией‡Kiste mit Lebensmitteln‡식량 상자‡Cajón de comestibles‡Cajón de comestibles‡Caisse de nourriture‡食物箱‡食物木箱',
  { -- Quest
    'Morganth‡Моргант‡Morganth‡모건스‡Morganth‡Morganth‡Morganth‡莫甘斯‡莫甘斯',
    nil,
    'Derrote Morgan.|nLeve o Pingente das Sombras dele para Teócrito na Torre de Azora, na Floresta de Elwynn.‡Победите Морганта.|nПринесите его подвеску Тени Теокриту в башню Азоры в Элвиннском лесу.‡Besiegt Morganth.|nBringt seinen Schattenanhänger zu Theocritus am Turm von Azora im Wald von Elwynn.‡모건스를 처치하십시오.|n엘윈 숲의 아조라의 탑에 있는 테오크리투스에게 그림자 펜던트를 가져가야 합니다.‡Derrota a Morganth.|nLleva el colgante de la Sombra a Theocritus a la Torre de Azora, en el Bosque de Elwynn.‡Derrota a Morganth.|nLleva el colgante de las Sombras a Theocritus a la Torre de Azora, en el Bosque de Elwynn.‡Tuer Morganth, puis rapporter son Pendentif des ombres à Théocritus, à la Tour d\'Azora dans la forêt d\'Elwynn.‡击败莫甘斯。|n将他的阴影坠饰带给塞欧克瑞图斯，他就在艾尔文森林内的阿祖拉之塔中。‡擊敗莫甘斯。|n將他的陰影墜飾帶給塞歐克瑞圖斯，他就在艾爾文森林內的阿祖拉之塔中。',
  }
},
[250] = {
  nil,
  { -- Npc
    'Pai Madruga‡Папаша Маклюр‡Paps Maclure‡파 맥클루어‡Pa Maclure‡Pa Maclure‡Pa Maclure‡马科伦老爹‡馬科倫老爹',
    nil,
  },
  nil,
  { -- Quest
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'Investigue a área próxima à rampa leste do Dique e dê ao Engenheiro-chefe Vedaçude uma pista que possa indicar o que os Anões Ferro Negro estão tramando.‡Осмотрите область вокруг восточной части Дамбы и отыщите для главного инженера Плотины улику, указывающую на замыслы дворфов Черного Железа.‡Untersucht den Bereich um die östliche Dammrampe und bringt Chefingenieur Hinderweir einen Hinweis, der Auskunft darüber geben könnte, was die Dunkeleisenzwerge vorhaben.‡댐의 동쪽 사면 근처를 정찰하고 검은무쇠단 드워프의 음모를 밝힐만한 단서를 찾아 선임기술자 힌더바이르에게 가져가야 합니다.‡Investiga los alrededores de la rampa este de la Presa y lleva al ingeniero jefe Hinderweir alguna pista sobre lo que traman los Hierro Negro.‡Investiga los alrededores de la rampa este de la Presa y lleva al ingeniero jefe Hinderweir alguna pista sobre lo que traman los Hierro Negro.‡Enquêter près de la rampe est du barrage et rapporter à l\'ingénieur en chef Hinderweir un indice qui permettrait de deviner les intentions des nains Sombrefer.‡查看水坝东边斜坡附近的区域，调查一下黑铁矮人准备做什么，然后把线索带给主工程师辛德维尔七世．‡查看水壩東邊斜坡附近的區域，調查壹下黑鐵矮人準備做什麽，然後把線索帶給主工程師辛德維爾七世．',
  }
},
[251] = {
  nil,
  { -- Npc
    'Mabel Madruga‡Мейбелл Маклюр‡Maybell Maclure‡메이벨 맥클루어‡Maybell Maclure‡Maybell Maclure‡Maybell Maclure‡梅贝尔·马科伦‡梅貝爾·馬科倫',
    nil,
  },
  -- Object
  '‡Исследовательское оборудование‡Forscherausrüstung‡탐사 장비‡Equipo de investigación‡Equipo de investigación‡Equipement de recherche‡研究设备‡研究設備',
  { -- Quest
    'Tradução da carta de Abercrombie‡Перевод записки Аберкромби‡Übersetzung von Calvinius\' Notiz‡에이버크롬비의 편지 번역‡Traduce la nota de Abercrombie‡Traduce la nota de Abercrombie‡La traduction de la lettre d\'Abercrombie‡翻译亚伯克隆比的信‡翻譯亞伯克隆比的信',
    nil,
    'Leve a Carta para Malaquias até Sirra Von\'Indi.‡Отнесите письмо, адресованное Элло, Шире Фон-Инди.‡Bringt den Brief an Ello zu Sirra Von\'Indi.‡시라 본인디에게 엘로에게 보내는 편지를 가져가야 합니다.‡Lleva la carta de Ello a Sirra Von\'Indi.‡Lleva la carta de Ello a Sirra Von\'Indi.‡Apporter la lettre à Ello, à Sirra Von\'Indi.‡把写给艾尔罗的信拿给希拉·沃宁迪。‡把寫給艾爾羅的信拿給希拉·沃寧迪。',
  }
},
[252] = {
  nil,
  { -- Npc
    'Tomasino Campedra‡Томми Джо Стоунфилд‡Tommy Joe Stonefield‡토미 조 스톤필드‡Tommy Joe Pedregosa‡Tommy Joe Pedregosa‡Tommy Joe Stonefield‡托米·乔·斯通菲尔德‡湯米·喬·斯通菲爾德',
    nil,
  },
  nil,
  { -- Quest
    'Tradução para Malaquias‡Перевод для Элло‡Übersetzung für Ello‡엘로 이본로크 경에게 편지 전달‡Una traducción para Ello‡Una traducción para Ello‡La traduction pour Ello‡翻译好的信件‡翻譯好的信件',
    nil,
    'Leve a Carta Traduzida para Lorde Malaquias Ebanez.‡Отнесите переведенное письмо лорду Элло Чернодреву.‡Bringt Lord Ello Ebonlocke den übersetzten Brief.‡엘로 이본로크 경에게 번역된 편지를 가져가야 합니다.‡Lleva la carta traducida a Lord Ello Cerranegro.‡Lleva la carta traducida a Lord Ello Cerranegro.‡Remettre la lettre traduite au seigneur Ello Ebonlocke.‡把翻好的信带给艾尔罗·埃伯洛克公爵。‡把翻好的信帶給艾爾羅·埃伯洛克公爵。',
  }
},
[253] = {
  nil,
  { -- Npc
    'Durval Pilão‡Вильям Пест‡William Pestle‡윌리엄 페슬‡William Mortero‡William Mortero‡William Pestle‡威廉·匹斯特‡威廉·匹斯特',
    nil,
  },
  nil,
  { -- Quest
    'A noiva do Embalsamador‡Невеста Бальзамировщика‡Braut des Einbalsamierers‡장의사의 신부‡La novia del embalsamador‡La novia del embalsamador‡La fiancée de l\'Embaumeur‡藏尸者的妻子‡藏屍者的妻子',
    nil,
    'Encontre o túmulo de Elisa. Retire dela o Coração do Embalsamador, então fale novamente com Malaquias Ebanez.‡Отыщите могилу Элизы. Извлеките из нее сердце Бальзамировщика и вернитесь к Элло Чернодреву.‡Findet Elizas Grab. Beschafft das Herz des Einbalsamierers, das sie in sich trägt, und kehrt zu Ello Ebonlocke zurück.‡엘리자의 무덤을 찾아 그녀의 몸에서 장의사의 심장을 찾아 엘로 이본로크 경에게 가져가야 합니다.‡Encuentra la tumba de Eliza. Quítale el corazón del embalsamador y luego vuelve a Ello Cerranegro.‡Encuentra la tumba de Eliza. Quítale el corazón del embalsamador y luego vuelve a Ello Cerranegro.‡Trouver la tombe d\'Eliza, retrouver le cœur de l\'Embaumeur, puis retourner voir Ello Ebonlocke.‡找到伊莉莎的坟墓，从她的身上取回藏尸者的心脏，把它交给艾尔罗·埃伯洛克。‡找到伊莉莎的墳墓，從她的身上取回藏屍者的心臟，把它交給艾爾羅·埃伯洛克。',
  }
},
[254] = {
  nil,
  nil,
  -- Object
  '‡Разыскивается: Чок\'сул‡GESUCHT: Baron Küstenschipper‡현상 수배: 초크술‡SE BUSCA: Chok\'sul‡SE BUSCA: Chok\'sul‡ON RECHERCHE : Chok\'sul‡祖玛维颅骨堆‡',
  { -- Quest
    'Escavando a terra‡Копание земли‡Graben in der Erde‡무덤 파기‡Escavar la tierra‡Excavar la tierra‡En creusant la terre‡掘墓‡掘墓',
    nil,
