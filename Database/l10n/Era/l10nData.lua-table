[5923] = {
  nil,
  { -- Npc
    'Totem Antiveneno‡Тотем противоядия‡Totem der Giftreinigung‡독 정화 토템‡Tótem de limpieza contraveneno‡Tótem de limpieza contraveneno‡Totem de Purification du poison‡清毒图腾‡清毒圖騰',
