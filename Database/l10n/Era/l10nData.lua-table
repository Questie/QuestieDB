[3501] = {
  nil,
  { -- Npc
    'Guarda da Horda‡Ордынский стражник‡Wache der Horde‡호드 경비병‡Guardia de la Horda‡Guardia de la Horda‡Garde de la Horde‡部落卫兵‡部落衛兵',
    nil,
  },
  nil,
  { -- Quest
    'Cada pedacinho conta‡Счет идет на большие числа‡Im Dutzend besser‡불완전한 드레니시스트 조각‡Todo cuenta en grandes cantidades‡Todo cuenta en grandes cantidades‡Tout se compte en grandes quantités‡多多益善‡多多益善',
    nil,
    'Leve Fragmentos Imperfeitos de Draenetista para Kum\'isha e ganhe uma recompensa por cada fragmento entregue.‡Принесите Кум-ише несовершенные фрагменты дренейского аметиста и получите награду за каждый из них.‡Bringt Kum\'isha unvollständige Draenethystfragmente und Ihr werdet für jedes, das Ihr bringt, belohnt.‡굼이샤에게 불완전한 드레니시스트 조각을 가져다주고 각 파편에 대해 보상을 받으십시오.‡Llévale a Kum\'isha fragmentos de draenetista imperfecta y te recompensará por cada fragmento entregado.‡Llévale a Kum\'isha trozos draenetistas imperfectos y te recompensará por cada fragmento entregado.‡Apporter des Fragments imparfaits de draenéthyste à Kum\'isha et toucher une récompense pour chaque fragment rapporté.‡将有瑕疵的德莱尼水晶碎片交给库米沙，你就可以得到相应的回报。‡將有瑕疵的德萊尼水晶碎片交給庫米沙，妳就可以得到相應的回報。',
  }
},
[3502] = {
  -- Item
  'Cogumelos Fuçalama‡Цветок Грязного Рыла‡Morastschnauzenkappen‡진흙주둥이꽃‡Flores Morrobarro‡Flores de Morrobarro‡Fleurs de fangemufle‡泥头花‡泥頭花',
  { -- Npc
    'Bordoeiro de Vila Catraca‡Кабестанский костолом‡Haudrauf von Ratchet‡톱니항 투사‡Truhán de Trinquete‡Truhán de Trinquete‡Cogneur de Ratchet‡棘齿城卫兵‡棘齒城衛兵',
    nil,
  },
  nil,
  { -- Quest
    'O lixo de um draenei...‡Дренейский хлам...‡Des einen Draeneis Plunder...‡어느 드레나이의 잡동사니...‡Un trasto de Draenei…‡Un trasto de Draenei...‡Au rebut pour les draeneï‡德莱尼的垃圾…‡德萊尼的垃圾…',
    nil,
    'Leve Fragmentos Imperfeitos de Draenetista para Kum\'isha. Qualquer monstro da Barreira do Inferno pode estar carregando um fragmento desses.‡Принесите Кум-ише несовершенные фрагменты дренейского аметиста. У любого вида монстров в Выжженных землях могут быть эти фрагменты.‡Bringt Kum\'isha unvollständige Draenethystfragmente. Jede Art von Monster in den verwüsteten Landen könnte ein Fragment bei sich tragen.‡굼이샤에게 불완전한 드레니시스트 조각을 가져가십시오. 그 조각은 저주받은 땅에 있는 모든 야수가 지니고 있을 수도 있습니다.‡Llévale a Kum\'isha fragmentos de draenetista imperfecta. Cualquier forma de monstruo de Las Tierras Devastadas podría llevar uno de estos fragmentos.‡Llévale a Kum\'isha trozos draenetistas imperfectos. Cualquier forma de monstruo de Las Tierras Devastadas podría llevar uno de estos fragmentos.‡Apporter des Fragments imparfaits de draenéthyste à Kum\'isha. N\'importe quel monstres des Terres foudroyées peut détenir un fragment.‡将有瑕疵的德莱尼水晶碎片交给库米沙。诅咒之地的任何怪物都有可能携带着这样的碎片。‡將有瑕疵的德萊尼水晶碎片交給庫米沙。詛咒之地的任何怪物都有可能攜帶著這樣的碎片。',
  }
},
[3503] = {
  nil,
  { -- Npc
    'Protetor Silitídeo‡Заступник-силитид‡Silithidbeschützer‡병정 실리시드‡Protector silítido‡Protector silítido‡Protecteur silithide‡异种护卫者‡異種保衛者',
