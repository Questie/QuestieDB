  nil,
  { -- Quest
    'A jornada para Serraria Tarren‡Путешествие на Мельницу Таррен‡Reise nach Tarrens Mühle‡타렌 밀농장으로의 모험‡Viaja a Molino Tarren‡Viaje a Molino Tarren‡Un voyage vers Moulin-de-Tarren‡塔伦米尔之旅‡塔倫米爾之旅',
    nil,
    'Leve o Bilhete de Zaqueia para o Boticário Lindolfo na Serraria Tarren.‡Принесите записку Замы аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle Zamahs Notiz.‡타렌 밀농장에 있는 연금술사 라이던에게 자마의 쪽지를 가져가야 합니다.‡Entrégale la nota de Zamah al boticario Lydon, que está en Molino Tarren.‡Entrégale la nota de Zamah al boticario Lydon, que está en Molino Tarren.‡Apporter la Note de Zamah à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把扎玛的信带给塔伦米尔的林度恩。‡把紮瑪的信帶給塔倫米爾的林度恩。',
  }
},
[1066] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡雜斑鋸齒龍',
    '‡‡‡‡‡‡‡‡UNUSED',
