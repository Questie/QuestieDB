},
[2760] = {
  -- Item
  '‡Набор для шитья Тармена‡Thurmans Nähkästchen‡투르만의 바느질 도구‡Costurero de Thurman‡Costurero de Thurman‡Trousse de couture de Thurman‡萨尔曼的针线包‡薩爾曼的針線包',
  { -- Npc
    'Exilado em Chamas‡Пылающий изгой‡Brennender Verbannter‡떠도는 불의 정령‡Exiliado ardiente‡Exiliado ardiente‡Exilé ardent‡烈焰流放者‡烈焰流放者',
    nil,
  },
  nil,
  { -- Quest
    'A Ordem do Mithril‡Орден Мифрила‡Der Mithrilorden‡미스릴 대장조합‡El pedido de mitril‡La Orden del mitril‡L\'Ordre du mithril‡秘银会‡秘銀會',
    nil,
    'Fale com Galvan, o Antigo, na Selva do Espinhaço.‡Поговорите с Гальваном Древним в Тернистой долине.‡Sprecht mit Galvan dem Alten im Schlingendorntal.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반과 대화해야 합니다.‡Habla con Galvan el Ancestro en la Vega de Tuercespina.‡Habla con Galvan el Antiguo en la Vega de Tuercespina.‡Aller voir Galvan l\'Ancien dans la vallée de Strangleronce.‡和荆棘谷的加尔文谈一谈。‡和荊棘谷的加爾文談壹談。',
  }
},
[2761] = {
  nil,
  { -- Npc
    'Exilado Vagalhante‡Морской изгой‡Schäumender Verbannter‡떠도는 물의 정령‡Éxilu coronador‡Éxilu coronador‡Exilé grimpeur‡水浪流放者‡水浪流放者',
    nil,
  },
  nil,
  { -- Quest
    'Fundido e desfundido‡Плавим, не плавим, плавим, не плавим…‡Hier verhütten, da verhütten‡대장기술과 채광‡Funde o no funde‡Funde o no funde‡Ça fond, ça ne fond pas‡铁匠必修课‡鐵匠必修課',
    nil,
    'Leve 40 Barras de Mithril e 40 Barras de Ferro para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок железных слитков Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 40 Eisenbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴와 철 주괴를 각각 40개씩 가져가야 합니다.‡Lleva cuarenta lingotes de mitril y cuarenta lingotes de veraplata a Galvan el Ancestro en Tuercespina.‡Lleva cuarenta barras de mitril y cuarenta barras de hierro a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 40 Barres de fer à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和40块铁锭交给荆棘谷的加尔文。‡將40塊秘銀錠和40塊鐵錠交給荊棘谷的加爾文。',
  }
},
[2762] = {
  nil,
  { -- Npc
    'Exilado Trovejante‡Грохочущий изгнанник‡Donnernder Verbannter‡떠도는 천둥 정령‡Exiliado tronador‡Exiliado tronador‡Exilé foudroyant‡雷霆流放者‡雷霆流放者',
    nil,
  },
  nil,
  { -- Quest
    'O grande embuste prateado‡Обманное серебро‡Der große silberne Betrüger‡훌륭한 가짜배기 은‡La veraplata no es verídica‡La veraplata no es verídica‡Le vif-argent n’est pas de l\'argent‡白花花的银子‡白花花的銀子',
    nil,
    'Leve 40 Barras de Mithril e 5 Barras de Veraprata para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок слитков истинного серебра Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 5 Echtsilberbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 진은 주괴 5개를 가져가야 합니다.‡Lleva cuarenta lingotes de mitril y cinco lingotes de veraplata a Galvan el Ancestro en Tuercespina.‡Lleva cuarenta barras de mitril y cinco barras de veraplata a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 5 Barres de vrai-argent à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和5块真银锭交给荆棘谷的加尔文。‡將40塊秘銀錠和5塊真銀錠交給荊棘谷的加爾文。',
  }
},
[2763] = {
