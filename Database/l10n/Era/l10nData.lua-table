[4861] = {
  -- Item
  '‡Гладкий оперенный мундир‡Schicke gefiederte Tunika‡손질된 깃털 튜닉‡Guerrera de plumas impoluta‡Guerrera de plumas impoluta‡Tunique en plumes lustrées‡羽毛外套‡羽毛外套',
  { -- Npc
    'Morcego Corvoide‡Крылан-охотник‡Würgerfledermaus‡무덤박쥐‡Alcaudociélago‡Alcaudociélago‡Chauve-souris hurlante‡利齿蝙蝠‡利齒蝙蝠',
    nil,
  },
  nil,
  { -- Quest
    'Coruscante enfurecido‡Разъяренные дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre o acampamento destruído e os suprimentos de Jaron Moldapedra na parte sul de Hibérnia.‡Найдите разоренный лагерь Джерона Гранильщика и его припасы на юге Зимних Ключей.‡Findet Jaron Stoneshapers ruiniertes Lager samt dessen Vorräte im südlichen Winterspring.‡여명의 설원 남부 지역에서 야론 스톤셰이퍼의 야영지를 찾아서 부서진 보급품 상자를 되찾아 와야 합니다.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiser le camp démoli et les fournitures de Jaron Stoneshaper, au sud du Berceau-de-l\'Hiver.‡在冬泉谷的南部寻找加隆·石矛的被破坏的营帐，以及他的补给物资。‡在冬泉谷的南部尋找加隆·石矛的被破壞的營帳，以及他的補給物資。',
  }
},
[4862] = {
  -- Item
  'Cauda de Escorpídeo Operário‡Хвост рабочего скорпида‡Skorpidarbeiterschwanz‡일꾼전갈 꼬리‡Cola de escórpido obrero‡Cola de escórpido obrero‡Queue de scorpide ouvrier‡工蝎的尾巴‡工蠍的尾巴',
  { -- Npc
    '‡‡‡‡‡‡‡‡瘋狂的利齒蝙蝠',
    nil,
  },
  nil,
  { -- Quest
    'Nojento!‡Товар на любителя‡Be-Öh-Es-Eh‡더러운 거미알‡Bestia amaestrada‡Bestia amaestrada‡Mauvais‡蜘蛛卵‡蜘蛛卵',
    nil,
    'Vá para o Pico da Rocha Negra e colete 15 Ovos de Aranha do Pináculo para Kibler.|nPelo nome, é de se pensar que eles fiquem perto das aranhas.‡Отправьтесь на пик Черной горы и принесите Киблеру 15 яиц скального паука.|nСудя по всему, яйца надо искать недалеко от пауков.‡Reist zur Blackrockspitze und sammelt 15 Spitzenspinnen-Eier für Kibler.|nLogischerweise müsstet Ihr diese Eier in der Nähe von Spinnen finden.‡검은바위 첨탑으로 가서 키블러를 위해 첨탑 거미알 15개를 수집해야 합니다.|n들리는 소문으로는 그 알들은 거미들이 서식하는 근처에서 찾을 수 있다고 합니다.‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|nYo diría que se pueden encontrar estos huevos cerca de arañas.‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|nYo diría que se pueden encontrar estos huevos cerca de arañas.‡Aller au Pic Blackrock et ramasser 15 Oeuf d\'araignée du pic pour Kibler.|nCes oeufs peuvent être trouvés à proximité des araignées.‡到黑石塔去为基布雷尔收集15枚尖塔蜘蛛卵。|n听说那些蜘蛛周围有许多这样的卵。‡到黑石塔去為基布雷爾收集15枚尖塔蜘蛛卵。|n聽說那些蜘蛛周圍有許多這樣的卵。',
  }
},
[4863] = {
  -- Item
  'Ferramentas Gnômicas‡Инструменты гномов‡Gnomen-Werkzeuge‡노움 공구‡Herramientas gnómicas‡Herramientas gnómicas‡Outils gnomes‡侏儒的工具‡地精的工具',
  { -- Npc
    'Basilisco Jadespinho‡Нефритовый василиск‡Jaderückenbasilisk‡비취돌기 바실리스크‡Basilisco Dorsaljade‡Basilisco Dorsaljade‡Basilic Jadéchine‡玉脊蜥蜴‡玉脊蜥蜴',
    nil,
  },
  nil,
  { -- Quest
    'Coruscante enfurecido‡Разъяренные дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre a carroça destruída de Jaron Moldapedra.‡Найдите опрокинутый фургон Джерона Гранильщика.‡Sucht Jaron Stoneshapers zerstörten Wagen.‡야론 스톤셰이퍼의 부서진 마차를 찾아야 합니다.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Trouver le chariot saccagé de Jaron Stoneshaper.‡找到加隆·石矛的马车。‡找到加隆·石矛的馬車。',
  }
},
[4864] = {
  -- Item
  'Crânio de Minshina‡Череп Миншины‡Minshinas Schädel‡민시나의 해골‡Calavera de Minshina‡Calavera de Minshina‡Crâne de Minshina‡明希纳的颅骨‡明希納的顱骨',
  nil,
  nil,
  { -- Quest
    'Coruscante enfurecido‡Разъяренные дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Pegue os Suprimentos do Jaron na neve, depois encontre o coruscante que roubou o amuleto de que Jaron falou.|nEntregue os Suprimentos do Jaron e o Amuleto de Penas Azuis para Jaron Moldapedra na cabana, em Hibérnia.‡Подберите припасы Джерона из снега, и найдите дикого совуха, похитившего амулет, о котором говорил Джерон.|nПринесите припасы и ожерелье миних перьев Джерону Гранильщику в его дом в Зимних Ключах.‡Klaubt Jarons Vorräte aus dem Schnee und sucht dann die Wildekin, die das Amulett gestohlen haben, von dem Jaron gesprochen hatte.|nBringt Jaron Stoneshaper in der Lodge in Winterspring dessen Vorräte und das blaugefiederte Amulett.‡눈 속에서 야론의 보급품을 회수한 다음, 야론이 찾는 아뮬렛을 훔친 올빼미야수들을 찾아야 합니다.|n여명의 설원, 별똥별 마을에 있는 야론 스톤셰이퍼에게 야론의 보급품과 푸른 깃털달린 아뮬렛을 갖다주어야 합니다.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico que robó el amuleto del que te habló Jaron.|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico salvaje que robó el amuleto del que te habló Jaron.|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Ramasser les Fournitures de Jaron dans la neige, puis trouver l\'Indomptable qui a volé l\'amulette dont Jaron a parlé.|nRapporter les fournitures de Jaron et l\'Amulette de la plume bleue à Jaron Stoneshaper au pavillon, dans le Berceau-de-l\'Hiver.‡从雪地中拾起加隆的补给物资，然后寻找盗取加隆所说的护符的枭兽。|n将加隆的补给物资和蓝色羽毛护符交给冬泉谷的加隆·石矛。‡從雪地中拾起加隆的補給物資，然後尋找盜取加隆所說的護符的梟獸。|n將加隆的補給物資和藍色羽毛護符交給冬泉谷的加隆·石矛。',
  }
},
[4865] = {
  -- Item
  '‡Испорченный мех‡Verdorbener Pelz‡손상된 모피‡Pelambre estropeada‡Pelambre estropeada‡Peau détruite‡破烂的皮毛‡破爛的毛皮',
  nil,
  nil,
  { -- Quest
    'Selva da serpente‡Змеиная дикость‡Wilde Schlange‡뱀의 복수‡Venganza‡Venganza‡Serpent sauvage‡狂热之蛇‡狂熱之蛇',
    nil,
    'Relate suas descobertas a Motega Barba de Fogo.‡Расскажите о найденном Мотеге Огненной Гриве.‡Berichtet Motega Firemane von Euren Entdeckungen.‡발견한 사실을 모테가 파이어메인에게 보고해야 합니다.‡Cuéntale a Motega Pirocabello lo que has descubierto.‡Infórmale de tus hallazagos a Motega Pirocabello.‡Faire un rapport de vos trouvailles à Motega Firemane.‡向莫特加·火鬃汇报你的发现。‡向莫特加·火鬃匯報妳的發現。',
  }
},
[4866] = {
  -- Item
  'Cabeça do Zalazane‡Голова Залазана‡Zalazanes Kopf‡잘라제인의 머리카락‡Cabeza de Zalazane‡Cabeza de Zalazane‡Tête de Zalazane‡扎拉赞恩的头颅‡札拉贊恩的頭顱',
  nil,
  nil,
  { -- Quest
    'Leite materno‡Материнское молоко‡Muttermilch‡여왕 거미의 독‡La leche de la madre‡La leche de la madre‡Le lait matriarcal‡蛛后的乳汁‡蛛後的乳汁',
    nil,
    'No coração do Pico da Rocha Negra você vai encontrar a Mãe Queimateia. Chame a atenção dela e deixe-a envenenar você. É bem provável que você precise matá-la também. Fale novamente com João Roto depois que for envenenad<o/a> para que ele possa "ordenhar" você.‡Найдите в самом сердце пика Черной горы мать Дымную Паутину. Сражайтесь с ней, пока она не введет вам свой яд. Скорее всего ее также придется убить. Когда яд будет в вас, вернитесь к Джону-Оборванцу, чтобы он смог добыть яд.‡Ihr findet Mutter Glimmernetz im Herzen der Blackrockspitze. Kämpft mit ihr und bringt sie dazu, Euch zu vergiften. Es kann gut sein, dass Ihr sie sogar töten müsst. Kehrt zum struppigen John zurück, sobald Ihr vergiftet seid, damit er Euch \'melken\' kann.‡검은바위 첨탑 중심부에서 여왕 불그물거미를 찾을 수 있습니다. 여왕 불그물거미를 공격하거나 접근하여 그 독에 중독되어야 합니다. 독에 걸릴 확률을 높이기 위해서는 거미를 죽여야 할 수도 있습니다. 중독되면 털보 존에게 돌아가서 그가 그 독을 추출하게 해야 합니다.‡En el corazón de la Cumbre de Roca Negra encontrarás a Madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡En el corazón de la Cumbre de Roca Negra encontrarás a la madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡Vous trouverez la Matriarche Couveuse au coeur du pic Blackrock. Attaquez-la et poussez-la à vous empoisonner. Vous devrez sans doute la tuer. Une fois <empoisonné/empoisonnée>, trouvez John le Loqueteux afin qu\'il puisse prélever un échantillon.‡你可以在黑石塔的中心地带找到烟网蛛后。与她战斗，让她在你体内注入毒汁。如果你有能力的话，就杀死她吧。当你中毒之后，回到狼狈不堪的约翰那儿，他会从你的身体里抽取这些“蛛后的乳汁”。‡妳可以在黑石塔的中心地帶找到煙網蛛後。與她戰鬥，讓她在妳體內註入毒汁。如果妳有能力的話，就殺死她吧。當妳中毒之後，回到狼狽不堪的約翰那兒，他會從妳的身體裏抽取這些“蛛後的乳汁”。',
  }
},
[4867] = {
  -- Item
  '‡Сломанная нога скорпида‡Gebrochenes Skorpidbein‡부러진 전갈 다리‡Pata de escórpido rota‡Pata de escórpido rota‡Patte de scorpide brisée‡折断的蝎腿‡折斷的蠍腿',
  nil,
  nil,
  { -- Quest
    'Urok Uivo-da-ruína‡Аррок Смертный Вопль‡Urok Schreckensbote‡우로크 둠하울‡Urok Aullasino‡Urok Aullasino‡Urok Hurleruine‡乌洛克‡烏洛克',
    nil,
    'Leia o Pergaminho do Warosh. Traga o Mojo do Warosh para Warosh.‡Прочитайте записку Вароша. Принесите Варошу его амулет.‡Lest Waroshs Rolle. Bringt Waroshs Mojo zu Warosh.‡와로쉬의 두루마리를 읽어야 합니다. 와로쉬에게 그의 부적을 가져가야 합니다.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lire le Parchemin de Warosh. Apporter le Mojo de Warosh à Warosh.‡阅读瓦罗什的卷轴。将瓦罗什的蟑螂交给他。‡閱讀瓦羅什的卷軸。將瓦羅什的蟑螂交給他。',
  }
},
