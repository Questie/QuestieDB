    nil,
  }
},
[8297] = {
  -- Item
  '‡Плащ путника‡Umhang des Reisenden‡여행자 망토‡Capa de viajero‡Capa de viajero‡Cape de voyageur‡旅行者披风‡旅人披風',
  { -- Npc
    'Magronos, o Inflexível‡Магронос Неуступчивый‡Magronos der Unerschütterliche‡고집불통 마그로노스‡Magronos el Implacable‡Magronos el Implacable‡Magronos l\'Inflexible‡顽强的玛古诺斯‡不屈的瑪古諾斯',
    nil,
  },
  nil,
  { -- Quest
    'Recursos da Bacia Arathi!‡Ресурсы Низины Арати‡Die Ressourcen des Arathibeckens‡아라시 분지 자원!‡Los recursos de la Cuenca de Arathi‡Los recursos de la Cuenca de Arathi‡Les ressources du bassin d\'Arathi‡阿拉希盆地的资源！‡阿拉希盆地的資源！',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com a Sargento Martina na Ponta do Refúgio.‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Макчисту в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Sergeant Maclear in der Zuflucht.‡아라시 분지의 전투를 승리로 이끌고 아라시 보급품 상자를 가지고 임시 주둔지에 있는 하사관 매클리어에게 돌아가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一只阿拉希资源箱，然后向避难谷地的玛克里尔中士复命。‡獲得阿拉希盆地戰鬥的勝利，獲取壹只阿拉希資源箱，然後向避難谷地的瑪克裏爾中士復命。',
  }
},
[8298] = {
  -- Item
  '‡Перчатки путника‡Handschuhe des Reisenden‡여행자 장갑‡Guantes de viajero‡Guantes de viajero‡Gants de voyageur‡旅行者手套‡旅人手套',
  { -- Npc
    'Akubar, o Vidente‡Провидец Акубар‡Akubar der Seher‡현자 아쿠바르‡Akubar el Vidente‡Akubar el Vidente‡Akubar le Prophète‡先知阿库巴尔‡『先知』阿庫巴爾',
    nil,
  },
  nil,
  { -- Quest
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Макчисту в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Unteroffizier Maclear in der Zuflucht.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一个阿拉希资源木箱，然后向避难谷地的玛克里尔中士覆命。‡',
  }
},
[8299] = {
  -- Item
  '‡Шлем путника‡Helm des Reisenden‡여행자 투구‡Yelmo de viajero‡Yelmo de viajero‡Casque de voyageur‡旅行者头盔‡旅人頭盔',
  { -- Npc
    'Láquila‡Злобоклюй‡Fledderschnabel‡재앙의 검은발톱‡Escupetripas‡Escupetripas‡Ecorchebile‡斯比弗雷尔‡斯比弗雷爾',
    nil,
  },
  nil,
  { -- Quest
    'Quebra da rota de suprimentos de Arathor‡Перекрыть линии поставок Аратора‡Zerschlagt die Versorgungslinien Arathors‡아라소르 보급선 끊기‡Córtale el suministro a la Liga de Arathor‡Córtale el suministro a la Liga de Arathor‡Couper les voies de ravitaillement d\'Arathor‡切断阿拉索补给线‡切斷阿拉索補給線',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com o Sicário Mortis na Ruína do Martelo.‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡아라시 분지 전투를 승리로 이끌고 아라시 보급품 상자를 구해 해머폴에 있는 죽음의추적자 몰티스에게 가져가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au Traqueur noir Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡進入阿拉希盆地，獲得壹箱阿拉希資源箱，然後將它交給落錘鎮的亡靈哨兵莫提斯。',
  }
},
[8300] = {
  -- Item
  '‡Поножи путника‡Gamaschen des Reisenden‡여행자 다리보호구‡Leotardos de viajero‡Leotardos de viajero‡Jambières de voyageur‡旅行者护腿‡旅人護腿',
  { -- Npc
    'Rasgarga‡Разор‡Verheerer‡부라퀴‡Devastatia‡Devastatia‡Ravage‡毁灭‡劫掠',
    nil,
  },
  nil,
  { -- Quest
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au nécrotraqueur Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡',
  }
},
[8301] = {
  -- Item
  '‡Наплеч путника‡Schiftung des Reisenden‡여행자 어깨갑옷‡Bufas de viajero‡Bufas de viajero‡Spallières de voyageur‡旅行者肩甲‡旅人肩甲',
  { -- Npc
    'Clack, o Aniquilador‡Щелкун Разоритель‡Clack der Häscher‡칼날집게발 딸깍이‡Clack el Atracador‡Clack el Atracador‡Clack le Ravageur‡掠夺者科拉克‡『搶奪者』科拉克',
    nil,
  },
  nil,
  { -- Quest
    'O caminho do íntegros‡Путь правых‡Der Pfad des Gerechten‡정의의 길‡El buen camino‡El camino del honrado‡Le Chemin des Justes‡正义之路‡正義之路',
    nil,
    'Colete 200 Fragmentos de Carapaça Silitídea e fale novamente com Baristolth.‡Принесите Баристолфу 200 фрагментов силитидских панцирей.‡Kehrt zu Baristolth zurück, sobald Ihr 200 Silithidenknochenpanzerfragmente gesammelt habt.‡실리시드 등껍질 조각 200개를 모아 바리스톨스에게 가져가야 합니다.‡Lleva 200 fragmentos de caparazón de silítido a Baristolth.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Récupérez 200 Fragments de carapaces de silithides et retournez voir Baristolth.‡为流沙守望者巴里斯托尔斯收集200块异种蝎壳碎片。‡希利蘇斯塞納裏奧要塞的流沙守望者巴裏斯托爾斯想要妳殺死亞什蟲巢、佐拉蟲巢和雷戈蟲巢中的異種蟲類。從死去的蟲子屍體上收集異種蠍殼碎片。當妳收集到200塊異種蠍殼碎片時，回到巴裏斯托爾斯那兒去。|n作為壹名諾茲多姆的特使，只有妳和妳的副官可以從異種蟲類的屍體上拾取異種蠍殼碎片。請註意保持妳的包裹空間足夠多。',
  }
},
[8302] = {
  -- Item
  '‡Наручи героя‡Heldenarmschienen‡영웅의 팔보호구‡Brazales de héroe‡Brazales de héroe‡Brassards de héros‡英雄护腕‡英雄護腕',
  { -- Npc
    'Olho da Morte‡Смертеглаз‡Todesauge‡죽음의 눈‡Ojo de la Muerte‡Ojo de la Muerte‡Oeil-de-mort‡死眼‡死眼',
    nil,
  },
  nil,
  { -- Quest
    'A mão do íntegro‡Рука Правого‡Die Hand der Gerechtigkeit‡정의의 손길‡Una buena mano‡La mano del honrado‡La Main des Justes‡正义之手‡正義之手',
    nil,
    'Colete 200 Fragmentos de Carapaça Silitídea e fale novamente com Baristolth.‡Принесите Баристолфу 200 фрагментов силитидских панцирей.‡Kehrt zu Baristolth zurück, sobald Ihr 200 Silithidenknochenpanzerfragmente gesammelt habt.‡실리시드 등껍질 조각 200개를 모아 바리스톨스에게 가져가야 합니다.‡Lleva 200 fragmentos de caparazón de silítido a Baristolth.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Récupérez 200 Fragments de carapaces de silithides et retournez voir Baristolth.‡为流沙守望者巴里斯托尔斯收集200块异种蝎壳碎片。‡為流沙守望者巴里斯托爾斯收集200塊異種蠍殼碎片。',
  }
},
[8303] = {
  -- Item
  '‡Кираса героя‡Heldenbrustplatte‡영웅의 흉갑‡Coraza de héroe‡Coraza de héroe‡Cuirasse de héros‡英雄胸甲‡英雄胸甲',
  { -- Npc
    'Grunhido‡Хрюггер‡Suhlaman‡꿀꿀이‡Gruñón‡Gruñón‡Grunter‡格朗特‡格朗特',
    nil,
  },
  nil,
  { -- Quest
    'Anacronos‡Анахронос‡Anachronos‡아나크로노스‡Anacronos‡Anacronos‡Anachronos‡阿纳克洛斯‡阿納克洛斯',
    nil,
    'Encontre Anacronos nas Cavernas do Tempo, em Tanaris.‡Отыщите Анахроноса в Пещерах Времени в Танарисе.‡Sucht nach Anachronos bei den Höhlen der Zeit in Tanaris.‡타나리스의 시간의 동굴에 있는 아나크로노스를 찾아가야 합니다.‡Busca a Anacronos en las Cavernas del Tiempo de Tanaris.‡Busca a Anacronos en las Cavernas del Tiempo de Tanaris.‡Chercher Anachronos dans les Grottes du temps à Tanaris.‡到塔纳利斯的时光之穴去寻找阿纳克洛斯。‡到塔納利斯的時光之穴去尋找阿納克洛斯。',
  }
},
[8304] = {
  -- Item
  '‡Накидка героя‡Heldencape‡영웅의 단망토‡Manteo de héroe‡Manteo de héroe‡Cape de héros‡英雄斗篷‡英雄斗篷',
  { -- Npc
    'Skárnio‡Бесстрашный‡Mutreich‡드레드스콘‡Desdeñamiedos‡Desdeñamiedos‡Dériseffroi‡德雷斯克恩‡德雷斯克恩',
    nil,
  },
  nil,
  { -- Quest
    'Querida Natália‡Дражайшая Наталиа‡Liebste Natalia‡사랑하는 여군주 나탈리아‡Queridísima Natalia‡Queridísima Natalia‡Chère Natalia‡亲爱的纳塔莉亚‡親愛的納塔莉亞',
    nil,
    'O Comandante Mar\'alith, no Forte Cenariano, em Silithus, quer que você interrogue os ocupantes do Acampamento Barbabronze. Ele fica diretamente ao sul do Forte Cenariano.|nUma vez obtidas as informações solicitadas, fale novamente com o Comandante Mar\'alith.‡Допросите обитателей лагеря Бронзоборода по поручению командира Мар\'алита из крепости Кенария. Этот лагерь находится южнее крепости Кенария.|nСобрав необходимые сведения, вернитесь к командиру Мар\'алиту.‡Kommandant Mar\'alith auf Burg Cenarius in Silithus möchte, dass Ihr die Bewohner von Bronzebeards Lager befragt. Das Lager befindet sich südlich von Burg Cenarius.|nKehrt zu Kommandant Mar\'alith zurück, wenn Ihr die benötigten Informationen gesammelt habt.‡실리더스의 세나리온 요새에 있는 지휘관 마랄리스가 브론즈비어드 야영지에 있는 드워프들에게 부인의 행방을 조사해봐 달라고 부탁했습니다.|n브론즈비어드 야영지는 세나리온 요새의 남쪽에 있습니다.|n정보를 수집한 후 지휘관 마랄리스에게 돌아가야 합니다.‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que interrogues a los habitantes del campamento Barbabronce, que está al sur del fuerte.|nCuando consigas la información ve a ver al comandante Mar\'alith.‡Interroga a Frankal y a Rutgar en el Campamento Barbabronce acerca del paradero de Natalia Mar\'alith.‡Le commandant Mar’alith, du Fort cénarien en Silithus, veut que vous interrogiez les habitants du Campement de Bronzebeard, qui se trouve au sud du Fort cénarien.|nLorsque vous aurez réuni les informations demandées, retournez voir le commandant Mar’alith.‡希利苏斯塞纳里奥要塞的指挥官玛尔利斯想要你询问铜须营地的矮人。你可以在塞纳里奥要塞以南找到铜须营地。|n一旦你收集到有用的信息，就回到指挥官玛尔利斯那儿。‡希利蘇斯塞納裏奧要塞的指揮官瑪爾利斯想要妳詢問銅須營地的矮人。妳可以在塞納裏奧要塞以南找到銅須營地。|n壹旦妳收集到有用的信息，就回到指揮官瑪爾利斯那兒。',
  }
},
[8305] = {
  -- Item
  '‡Рукавицы героя‡Heldenstulpen‡영웅의 건틀릿‡Guanteletes de héroe‡Guanteletes de héroe‡Gantelets de héros‡英雄护手‡英雄護手',
  { -- Npc
    'Kixxel‡Киккль‡Kixxle‡킥슬‡Kixxle‡Kixxle‡Kixxle‡吉克斯勒‡吉克斯勒',
    'Poções e Ervas‡Зелья и травы‡Tränke und Kräuter‡연금술용품 상인‡Pociones y hierbas‡Pociones y hierbas‡Potions & herbes‡药剂和草药‡藥劑和草藥',
  },
  nil,
  { -- Quest
    'Relembranças longínquas‡Давно забытые воспоминания‡Lang Vergessenes‡잊혀진 오랜 기억‡Recuerdos olvidados‡Recuerdos olvidados‡Des souvenirs oubliés depuis longtemps‡久远的记忆‡久遠的記憶',
    nil,
    'Localize a Lágrima Cristalina em Silithus, e contemple suas profundezas.‡Отыщите в Силитусе хрустальную слезу и загляните в ее глубины.‡Sucht die Kristallträne und blickt in ihr Innerstes.‡실리더스에서 눈물의 결정의 위치를 찾아 그 안을 응시하십시오.‡Encuentra la lágrima cristalina en Silithus y mira en sus profundidades.‡Encuentra la lágrima cristalina en Silithus y mira en sus profundidades.‡Trouvez la Larme cristalline, en Silithus, et contemplez ses profondeurs.‡找到希利苏斯的水晶之泪，并凝视它。‡希利蘇斯時光之穴的阿納克洛斯想要妳前往位於希利蘇斯南部沙漠的甲蟲之臺。|n當妳學習完畢後再回到他那兒去。',
  }
},
[8306] = {
  -- Item
  '‡Пояс героя‡Heldengürtel‡영웅의 허리띠‡Cinturón de héroe‡Cinturón de héroe‡Ceinture de héros‡英雄腰带‡英雄腰帶',
  { -- Npc
    'Barrão‡Дунх‡Duhng‡둔그‡Duhng‡Duhng‡Duhng‡杜恩格‡杜恩格',
    'Cozinheiro‡Повар‡Koch‡전문 요리사‡Cocinero‡Cocinero‡Cuisinier‡厨师‡廚師',
  },
  nil,
  { -- Quest
    'No ventre da loucura‡В бездне безумия‡Der Schlund des Wahnsinns‡광란의 하이브레갈로‡En las fauces de la locura‡En las fauces de la locura‡L\'antre de la folie‡深入疯狂之口‡深入瘋狂之口',
    nil,
    'O Comandante Mar\'alith do Forte Cenariano em Silithus quer que você encontre Natália. A informação que conseguiu aponta para Colme\'Régia, ao sul, como sendo a área em que você encontrará a Senhora Natália Mar\'alith.|nNão se esqueça de falar com os anões no acampamento do Barbabronze antes de se aventurar na colmeia. Eles podem ter algum trabalho e conselhos para você.|nE, <name>, lembre-se das palavras do Comandante: "Faça o que for necessário..."‡Найдите возлюбленную командира Мар\'алита из крепости Кенария в Силитусе. По имеющим сведениям, госпожу Наталию Мар\'алит можно найти в улье Регал.|nПрежде чем отправляться в улей, не забудьте поговорить с гномами из лагеря Бронзоборода. Они могут дать пару советов и подкинуть дополнительную работу.|nСледует помнить слова командира: "Сделай, что должно..."‡Kommandant Mar\'alith auf Burg Cenarius in Silithus möchte, dass Ihr seine geliebte Natalia wiederfindet. Die von Euch gesammelten Informationen deuten darauf hin, dass Ihr sie im Bau des Regalschwarms im Süden finden könntet.|nSprecht noch einmal mit den Zwergen in Bronzebeards Lager, bevor Ihr Euch in den Schwarmbau begebt. Ihr Wissen könnte sich als hilfreich erweisen und sicherlich, haben sie noch einige Aufgaben für Euch.|nUnd <Name>, denkt an die Worte des Kommandanten: "Tut, was Ihr tun müsst..."‡실리더스의 세나리온 요새에 있는 지휘관 마랄리스가 여군주 나탈리아를 찾아 달라고 부탁했습니다. 수집된 정보에 의하면 남쪽에 있는 하이브레갈에서 여군주 나탈리아 마랄리스를 찾을 수 있을 겁니다.|n곤충 집에 들어가기 전에 브론즈비어드 야영지에 있는 드워프들을 찾아가야 합니다. 드워프들이 조언과 함께 다른 일을 줄 것입니다.|n마지막으로 마랄리스가 했던 말 "그대가 해야 할 일을 하라."를 기억해야 합니다.‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que encuentres a su amada Natalia. Parece que podría estar en Colmen\'Regal, hacia el sur.|nNo olvides ir a ver a los enanos del campamento Barbabronce antes de ir a la colmena; puede que tengan otras tareas o consejos que darte.|nY recuerda lo que dijo el comandante: "Haz lo que tengas que hacer."‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que encuentres a su amada Natalia. Parece que podría estar en Colmen\'Regal, hacia el sur.|nNo olvides ir a ver a los enanos del campamento Barbabronce antes de ir a la colmena; puede que tengan otras tareas o consejos que darte.|nY, <nombre>, recuerda lo que dijo el comandante: "Haz lo que tengas que hacer."‡Le commandant Mar\'alith au Fort cénarien en Silithus veut que vous retrouviez sa bien-aimée, Natalia. Selon les informations que vous avez réunies, la Ruche\'Regal au sud serait l\'endroit où vous pourriez trouver dame Natalia Mar\'alith.|nN\'oubliez pas de rendre visite aux nains au camp de Bronzebeard avant de vous aventurer dans la ruche. Ils ont peut-être d\'autres tâches à vous confier et des conseils pour vous.|nEt <nom>, souvenez-vous des mots du commandant : "Faites votre devoir..."‡希利苏斯塞纳里奥要塞的指挥官玛尔利斯想要你找到他心爱的纳塔莉亚。你收集到的信息表明纳塔莉亚·玛尔利斯可能在南面的雷戈虫巢。|n在你赶往虫巢之前，记得去铜须营地拜访一下那儿的矮人，他们或许会给你提些建议。|n<name>，记住指挥官的话：做你应该做的……‡希利蘇斯塞納裏奧要塞的指揮官瑪爾利斯想要妳找到他心愛的納塔莉亞。妳收集到的信息表明納塔莉亞·瑪爾利斯可能在南面的雷戈蟲巢。|n在妳趕往蟲巢之前，記得去銅須營地拜訪壹下那兒的矮人，他們或許會給妳提些建議。|n<name>，記住指揮官的話：做妳應該做的……',
  }
},
[8307] = {
  -- Item
  '‡Сапоги героя‡Heldenstiefel‡영웅의 장화‡Botas de héroe‡Botas de héroe‡Bottes de héros‡英雄战靴‡英雄的靴子',
  { -- Npc
    'Tarban Grão do Fogo‡Тарбан Домашний Очаг‡Tarban Hearthgrain‡타반 하트그레인‡Tarban Granogar‡Tarban Granogar‡Tarban Hearthgrain‡塔班·熟麦‡塔班·熟麥',
    'Padeiro‡Пекарь‡Bäcker‡빵 상인‡Panadero‡Panadero‡Boulanger‡面包师‡麵包師',
  },
  nil,
  { -- Quest
    'Receita do deserto‡Блюдо из червей‡Wüstenrezept‡사막의 조리법‡Receta del desierto‡Receta del desierto‡Recette du désert‡沙漠食谱‡沙漠食譜',
    nil,
    'Procure informações sobre como cozinhar Carne de Verme da Areia no acampamento do Martelo do Crepúsculo, a oeste do Forte Cenariano.‡Поищите в лагере Сумеречного Молота на западе от крепости Кенария сведения о приготовлении мяса песчаных червей.‡Haltet beim Lager der Twilight-Hammer westlich von Burg Cenarius nach Informationen zum Zubereiten von Sandwurmfleisch Ausschau.‡세나리온 요새 서쪽에 있는 황혼의망치단 주둔지로 가서 미늘벌레 고기 조리법에 대한 정보를 알아내야 합니다.‡Busca información sobre cómo cocinar carne de gusano de arena en el Campamento del Martillo Crepuscular, al oeste del Fuerte Cenarion.‡Busca información sobre cómo cocinar carne de gusano de arena en el Campamento del Martillo Crepuscular, al oeste del Fuerte Cenarion.‡Cherchez des informations sur la façon de cuisiner la Chair de ver de sable, au camp du Marteau du crépuscule à l\'ouest du Fort cénarien.‡前往塞纳里奥要塞以西的暮光之锤营地，调查沙虫的烹饪方法。‡前往塞納裏奧要塞以西的暮光之錘營地，調查沙蟲的烹飪方法。',
  }
},
[8308] = {
  -- Item
  '‡Повязка героя‡Heldenband‡영웅의 머리끈‡Banda de héroe‡Banda de héroe‡Bandeau de héros‡风暴罩盔‡風暴罩盔',
  { -- Npc
    'Alenndaar Lapidus‡Алендаар Лаподаар‡Alenndaar Lapidaar‡알렌다르 라피다르‡Alenndaar Lapidaar‡Alenndaar Lapidaar‡Alenndaar Lapidaar‡奥林达尔·石鹿‡奧林達爾·石鹿',
    'Treinamento de Caçadores‡Наставник охотников‡Jägerlehrer‡상급 사냥꾼‡Instructor de cazadores‡Instructor de cazadores‡Maître des chasseurs‡猎人训练师‡獵人訓練師',
  },
  nil,
  { -- Quest
    'A carta perdida de Brann Barbabronze‡Потерянное письмо Бранна Бронзоборода‡Der verlorene Brief von Brann Bronzebeard‡브란 브론즈비어드의 잃어버린 편지‡La carta perdida de Brann Barbabronce‡La carta perdida de Brann Barbabronce‡La lettre perdue de Brann Bronzebeard‡布莱恩·铜须的信‡布萊恩·銅須的信',
    nil,
    'Leve a Carta de Brann Barbabronze para o Acampamento do Barbabronze na região sul de Silithus.‡Отнесите письмо Бранна Бронзоборода в лагерь Бронзоборода в южной части Силитуса.‡Liefert Brann Bronzebeards verlorenen Brief in Bronzebeards Lager im südlichen Silithus ab.‡실리더스 남쪽에 있는 브론즈비어드 야영지에 브란 브론즈비어드의 잃어버린 편지를 가져가야 합니다.‡Lleva la carta de Brann Barbabronce al campamento Barbabronce al sur de Silithus.‡Lleva la carta de Brann Barbabronce al campamento Barbabronce al sur de Silithus.‡Apporter la Lettre de Brann Bronzebeard au Campement de Bronzebeard dans le sud de Silithus.‡将布莱恩·铜须的信件带往希利苏斯南部的铜须营地。‡將布萊恩·銅須的信件帶往希利蘇斯南部的銅須營地。',
  }
},
[8309] = {
  -- Item
  '‡Поножи героя‡Heldengamaschen‡영웅의 다리보호구‡Leotardos de héroe‡Leotardos de héroe‡Jambières de héros‡英雄护腿‡英雄護腿',
  { -- Npc
    'Carlo de Aureliis‡Карло Аврелий‡Carlo Aurelius‡칼로 아우렐리우스‡Carlo Aurelius‡Carlo Aurelius‡Carlo Aurelius‡卡尔鲁·奥瑞留斯‡卡爾魯·奧瑞留斯',
    'Assassino‡Убийца‡Auftragsmörder‡암살단‡Asesino‡Asesino‡Assassin‡刺客‡刺客',
  },
  nil,
  { -- Quest
    'À procura de glifos‡Поиски рун‡Glyphenjagd‡상형 문자 추적‡Los grabados de los glifos‡Los grabados de los glifos‡À la poursuite des glyphes‡追查雕文‡追查雕文',
    nil,
    'Rutgar Formaglifo, no Acampamento Barbabronze, em Silithus, quer que você vá a Colme\'Ashi, Colme\'Zora e Colme\'Régia e decalque os Cristais Entalhados de Glifos em cada colmeia.|nUse o Kit de Transcrição do Geólogo para tirar um decalque razoável dos glifos antigos. Fale novamente com Rutgar Formaglifo quando terminar a tarefa.‡Рутгар Знакописец из лагеря Бронзеборода в Силитусе просит отправиться в улья Аши, Зора и Регал и сделать оттиски со всех покрытых письменами кристаллов.|nЧтобы сделать приличные копии древних рун, можно воспользоваться копирующим устройством геолога. По выполнении задания вернуться к Рутгару Знакописцу.‡Rutgar Glyphshaper in Bronzebeards Lager in Silithus möchte, dass Ihr in den Bau des Ashischwarms, Bau des Zoraschwarms und Bau des Regalschwarms eindringt und dort Abpausbilder von den glyphenverzierten Kristallen anfertigt.|nBenutzt das Abschriftenset für Geologen, um Abpausbilder der uralten Glyphen herzustellen. Kehrt nach Abschluss der Aufgabe zu Rutgar Glyphshaper zurück.‡실리더스의 브론즈비어드 야영지에 루트거 글립쉐이퍼가 하이브아쉬, 하이브조라, 하이브레갈로 가서 각 곤충 집에 있는 문자가 새겨진 수정의 상형 문자 탁본을 구해 달라고 부탁했습니다.|n지질학자의 탁본 도구를 사용하여 고대 상형 문자의 탁본을 만든 후 루트거 글립쉐이퍼에게 돌아가야 합니다.‡Rutgar Glifoforma del campamento Barbabronce en Silithus quiere que vayas a Colmen\'Ashi, Colmen\'Regal y Colmen\'Zora y calques cristales en cada colmena.|nUsa el juego de calco para copiar los glifos antiguos. Vuelve a ver a Rutgar cuando hayas terminado la tarea.‡Utiliza el estuche de transcripción de geólogo para obtener un calco de Colmen\'Regal del cristal con inscripciones de Colmen\'Regal.‡Rutgar Glyphshaper, du campement de Bronzebeard en Silithus, veut que vous entriez dans Ruche’Ashi, Ruche’Zora et Ruche’Regal et que vous récupériez des reproductions des Cristaux ornés de glyphes dans chaque ruche.|nUtilisez la Trousse de transcription du géologue pour obtenir une copie correcte de ces glyphes antiques. Lorsque vous aurez terminé, retournez voir Rutgar Glyphshaper.‡希利苏斯铜须营地的鲁特加尔·雕石想要你前往亚什虫巢、佐拉虫巢和雷戈虫巢，从虫巢中的雕文水晶上取下拓文。|n使用地质学家的抄录工具包获取古老雕文的摹本。完成任务后回到鲁特加尔·雕石那儿。‡希利蘇斯銅須營地的魯特加爾·雕石想要妳前往亞什蟲巢、佐拉蟲巢和雷戈蟲巢，從蟲巢中的雕文水晶上取下拓文。|n使用地質學家的抄錄工具包獲取古老雕文的摹本。完成任務後回到魯特加爾·雕石那兒。',
  }
},
[8310] = {
  -- Item
  '‡Наплечье героя‡Heldenschulterstücke‡영웅의 어깨갑옷‡Espaldares de héroe‡Espaldares de héroe‡Espauliers de héros‡英雄肩铠‡英雄肩鎧',
  { -- Npc
    'Vigia Wollpert‡Дозорный Воллперт‡Behüter Wollpert‡순찰대원 볼퍼트‡Vigía Wollpert‡Vigía Wollpert‡Gardien Wollpert‡守夜人沃博尔特‡守夜人沃博爾特',
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
  },
  nil,
  { -- Quest
    'Quebrando o código‡Расшифровка‡Knackt den Kode‡상형 문자 판독‡Descifrar el código‡Descifrar el código‡Déchiffrer le code‡破译密码‡破譯密碼',
    nil,
    'Frankal Pontepedra, no Acampamento Barbabronze, em Silithus, quer que você obtenha um Cérebro de Silitídeo de Colme\'Zora, um Cérebro de Silitídeo de Colme\'Ashi e um Cérebro de Silitídeo de Colme\'Régia. Fale novamente com Frankal quando tiver concluído a tarefa.‡Добудьте для Франкала Каменного Моста из лагеря Бронзоборода в Силитусе мозг силитидов из ульев Зора, Аши и Регал. По выполнении задания вернитесь к Франкалу.‡Frankal Stonebridge in Bronzebeards Lager möchte, dass Ihr ihm jeweils ein Silithidengehirn des Zoraschwarms, Ashischwarms und des Regalschwarms bringt. Kehrt nach der Erfüllung Eurer Aufgabe zu Frankal zurück.‡실리더스의 브론즈비어드 야영지에 있는 프랭칼 스톤브리지가 하이브조라 실리시드 뇌, 하이브아쉬 실리시드 뇌, 하이브레갈 실리시드 뇌를 가져가야 합니다.‡Frankal Petraponte del campamento Barbabronce en Silithus quiere que le lleves 1 cerebro de silítido de Colmen\'Zora, 1 de Colmen\'Ashi y 1 de Colmen\'Regal. Vuelve a ver a Frankal cuando hayas terminado la tarea.‡Obtén un cerebro silítido de Colmen\'Regal de cualquier silítido de Colmen\'Regal.‡Obtenez un Cerveau de silithide intact provenant de la Ruche’Regal. N’importe quel silithide de cette ruche fera l’affaire.‡希利苏斯铜须营地的弗兰卡·石桥想让你取回一个亚什异种虫脑、一个佐拉异种虫脑和一个雷戈异种虫脑。完成任务后回到弗兰卡那儿。‡希利蘇斯銅須營地的弗蘭卡·石橋想讓妳取回壹個亞什異種蟲腦、壹個佐拉異種蟲腦和壹個雷戈異種蟲腦。完成任務後回到弗蘭卡那兒。',
  }
},
[8311] = {
  -- Item
  '‡Алебастровые латные тяжелые наручи‡Alabasterplattenunterarmschienen‡무쇠 판금 완갑‡Avambrazos de placas de alabastro‡Avambrazos de placas de alabastro‡Protège-bras d\'albâtre en plaques‡鬼魂臂铠‡雪白鎧甲臂鎧',
  { -- Npc
    'Verme de Visgo‡Склизкая личинка‡Schleimmade‡진흙구더기‡Cresa de baba‡Cresa de baba‡Gelée urticante‡巨蛆‡巨蛆',
    nil,
  },
  nil,
  { -- Quest
    'Gostosuras da Noturnália para Jacinto!‡Тыквовинские вкусности для Джеспера!‡Schlotternachtssüßigkeiten für Jesper!‡제스퍼를 위해 할로윈 축제 사탕 모으기!‡Golosinas de Halloween para Jesper‡Golosinas de Halloween para Jesper‡Des bonbons de la Sanssaint pour Jesper !‡耶斯帕尔的万圣节糖果！‡耶斯帕爾的萬聖節糖果！',
    nil,
    'Fale com os estalajadeiros de Ventobravo, Altaforja e Darnassus, e também com Didiê Du Mocó, em Altaforja. Pague as prendas que eles pedirem em troca de gostosuras.|nLeve um Marzipã de Darnassus, uma Jujuba de Gnomeregan, um Nougat de Ventobravo e uma Balinha de Altaforja para Jacinto, que está no Orfanato de Ventobravo.‡Поговорите с хозяевами таверн в Штормграде, Стальгорне и Дарнассе, а также с Талвашом де Кисселем в Стальгорне. Выполните то, что они потребуют за предлагамые ими сладости.|nВернитесь к Джесперу в сиротский приют Штормграда и принесите ему марципан из Дарнасса, леденец из Гномрегана, нугу из Штормграда и конфету из Стальгорна.‡Sprecht mit den Gastwirten in Stormwind, Ironforge und Darnassus, sowie mit Talvash del Kissel in Ironforge. Führt ihnen vor, nach was sie im Gegenzug für die Süßigkeiten verlangen.|nKehrt zu Jesper ins Waisenhaus von Stormwind mit einem Marzipan aus Darnassus, einer Kaugummikugel aus Gnomeregan, Nugat aus Stormwind und einem Pfefferminzbonbon aus Ironforge zurück.‡스톰윈드, 아이언포지, 다르나서스의 여관 주인들, 그리고 아이언포지에 있는 탈바쉬 델 키젤과 얘기해 보십시오. 그들이 원하는 행동을 보여 주면 상으로 사탕을 받을 수 있습니다.|n스톰윈드 보육원의 제스퍼에게 스톰윈드 초코바, 놈리건 젤리, 아이언포지 박하사탕, 다르나서스 양갱을 가지고 돌아가야 합니다.‡Habla con los taberneros de Ventormenta, Forjaz y Darnassus, así como con Talvash del Kissel en Forjaz. Realiza los trucos que te pidan a cambio de tratos.|nVuelve a ver a Jesper en el orfanato de Ventormenta con un mazapán de Darnassus, una gominola de Gnomeregan un almendrado de Ventormenta y una menta de Forjaz.‡Habla con los taberneros de Ventormenta, Forjaz y Darnassus, así como con Talvash del Kissel en Forjaz. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|nVuelve a ver a Jesper frente a Ventormenta con un mazapán de Darnassus, una gominola de Gnomeregan, un almendrado de Ventormenta y una menta de Forjaz.‡Parler aux aubergistes de Stormwind, d\'Ironforge, de Darnassus, et à Talvash del Kissel à Ironforge. Accomplissez les blagues qu\'ils vous demanderont de faire en échange de bonbons.|nRetournez voir Jesper à l\'orphelinat de Stormwind avec un Massepain de Darnassus, une Boule de gomme de Gnomeregan, du Nougat de Stormwind et un Bonbon à la menthe d\'Ironforge.‡与暴风城、铁炉堡和达纳苏斯的旅店老板以及铁炉堡的塔瓦斯德·基瑟尔谈一谈。按照他们的要求做出动作，并获得他们的礼物。|n把达纳苏斯水果糖、诺莫瑞根橡皮糖、暴风城杏仁糖和铁炉堡薄荷糖交给暴风城孤儿院的耶斯帕尔。‡與暴風城、鐵爐堡和達納蘇斯的旅店老板以及鐵爐堡的塔瓦斯德·基瑟爾談壹談。按照他們的要求做出動作，並獲得他們的禮物。|n把達納蘇斯水果糖、諾莫瑞根橡皮糖、暴風城杏仁糖和鐵爐堡薄荷糖交給暴風城孤兒院的耶斯帕爾。',
  }
},
[8312] = {
  -- Item
  '‡Алебастровая кираса‡Alabasterbrustplatte‡무쇠 판금 흉갑‡Coraza de alabastro‡Coraza de alabastro‡Cuirasse d\'albâtre‡鬼魂板甲护胸‡雪白鎧甲胸甲',
  nil,
  nil,
  { -- Quest
    'Gostosuras de Noturnália para Assustosa!‡Тыквовинские вкусности для Мальца!‡Schlotternachtssüßigkeiten für Spoops!‡스풉스를 위해 할로윈 축제 사탕 모으기!‡Golosinas de Halloween para Pupas‡Golosinas de Halloween para Pupas‡Des bonbons de la Sanssaint pour Spoops !‡斯波普斯的万圣节糖果！‡斯波普斯的萬聖節糖果！',
    nil,
    'Fale com os estalajadeiros de Orgrimmar, da Cidade Baixa e do Penhasco do Trovão, e também com Kali Remik, na Aldeia Sen\'jin. Pague as prendas que eles pedirem e receba doces como recompensa.|nLeve um Marzipã do Penhasco do Trovão, uma Jujuba Lançanegra, um Nougat de Orgrimmar e uma Balinha da Cidade Baixa para Assustosa, no Orfanato de Orgrimmar.‡Поговорите с хозяевами таверн в Оргриммаре, Подгороде и Громовом Утесе и с Кали Ремик из деревни Сен\'джин. Выполните то, что они потребуют за предлагамые ими сладости.|nВернитесь к Мальцу в сиротский приют Оргриммара и принесите ей марципан Громового Утеса, леденец племени Черного Копья, нугу из Оргриммара и конфету Подгорода.‡Sprecht mit den Gastwirten in Orgrimmar, Undercity und Thunder Bluff, sowie mit Kali Remik in Sen\'jin. Führt ihnen vor, nach was sie im Gegenzug für die Süßigkeiten verlangen.|nKehrt zu Spoops ins Waisenhaus von Orgrimmar mit einem Marzipan aus Thunder Bluff, einer Kaugummikugel der Darkspear, Nugat aus Orgrimmar und einem Pfefferminzbonbon aus Undercity zurück.‡오그리마, 언더시티, 썬더 블러프의 여관 주인들, 그리고 센진 마을에 있는 칼리 레믹과 얘기해 보십시오. 그들이 원하는 행동을 보여 주면 사탕을 받을 수 있습니다.|n오그리마 보육원에 있는 스풉스에게 썬더 블러프 양갱, 검은창 젤리, 오그리마 초코바, 언더시티 박하사탕을 가지고 돌아가야 합니다.‡Habla con los taberneros de Orgrimmar, Entrañas y Cima del Trueno, y también con Kali Remik en Poblado Sen\'jin. Realiza los trucos que te piden a cambio de las golosinas que ofrecen. Vuelve a ver a Pupas en el Orfanato de Orgrimar con un mazapán de Cima del Trueno, una gominola Lanza Negra, un almendrado de Orgrimmar y una menta de Entrañas.‡Habla con los taberneros de Orgrimmar, Entrañas y Cima del Trueno y con Kali Remik en el Valle de los Espíritus de Orgrimmar. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|nVuelve a ver a Pupas en las Ruinas de Lordaeron con un mazapán de Cima del Trueno, una gominola de Lanza Negra, un almendrado de Orgrimmar y una menta de Entrañas.‡Parler aux aubergistes d\'Orgrimmar, d\'Undercity, de Thunder Bluff, et à Kali Remik au village de Sen\'jin. Accomplissez les blagues qu\'ils vous demanderont de faire en échange de bonbons.|nRetournez voir Spoops à l\'orphelinat d\'Orgrimmar avec un Massepain de Thunder Bluff, une Boule de gomme de Darkspear, du Nougat d\'Orgrimmar et un Bonbon à la menthe d\'Undercity.‡与奥格瑞玛、幽暗城和雷霆崖的旅店老板以及森金村的卡利·雷米克谈一谈。按照他们的要求做出动作，并获得他们的礼物。|n把雷霆崖奶糖、暗矛橡皮糖、奥格瑞玛软糖和幽暗城薄荷糖交给奥格瑞玛孤儿院的斯波普斯。‡與奧格瑞瑪、幽暗城和雷霆崖的旅店老板以及森金村的卡利·雷米克談壹談。按照他們的要求做出動作，並獲得他們的禮物。|n把雷霆崖奶糖、暗矛橡皮糖、奧格瑞瑪軟糖和幽暗城薄荷糖交給奧格瑞瑪孤兒院的斯波普斯。',
  }
},
[8313] = {
  -- Item
  '‡Кулачный щит героя‡Heldenrundschild‡영웅의 버클러‡Rodela de héroe‡Rodela de héroe‡Targe de héros‡英雄圆盾‡英雄圓盾',
  nil,
  nil,
  { -- Quest
    'Compartilhando o conhecimento‡Наделение знаниями‡Geteiltes Wissen‡지식 공유‡Compartir el conocimiento‡Compartir el conocimiento‡Partager la connaissance‡分享知识‡分享知識',
    nil,
    'Leve a Página Rasgada de Receita para Calandrath na estalagem do Forte Cenariano.‡Принесите вырванную страницу с рецептом Каландрате в таверну крепости Кенария.‡Bringt die ausgerissene Rezeptseite zu Calandrath ins Gasthaus der Burg Cenarius.‡세나리온 요새 여관에 있는 캘랜드라스에게 찢어낸 조리법 페이지를 가져다 줘야 합니다.‡Lleva la Página de receta rasgada a Calandrath en la taberna del Fuerte Cenarion.‡Lleva la página de receta rota a Calandrath en la taberna del Fuerte Cenarion.‡Apportez la Page de recette déchirée à Calandrath, à l’auberge du Fort cénarien.‡将破碎的食谱交给塞纳里奥要塞旅店中的卡兰德拉斯。‡將破碎的食譜交給塞納裏奧要塞旅店中的卡蘭德拉斯。',
  }
},
[8314] = {
  -- Item
  '‡Алебастровые латные рукавицы‡Alabasterplattenstulpen‡무쇠 판금 건틀릿‡Guanteletes de placas de alabastro‡Guanteletes de placas de alabastro‡Gantelets d\'albâtre en plaques‡雪花板甲护手‡雪白鎧甲護手',
  nil,
  nil,
  { -- Quest
    'Desvendando o mistério‡Разгадка тайны‡Des Rätsels Lösung‡밝혀지는 비밀‡Desentrañar el misterio‡Desentrañar el misterio‡Dévoiler le mystère‡揭开秘密‡揭開秘密',
    nil,
    'Rutgar Formaglifo, no Acampamento Barbabronze, quer que você entregue o Prisma de Cristal com Glifos para a Geóloga Matarriso no Forte Cenariano, que fica em Silithus.‡Рутгар Знакописец из лагеря Бронзоборода в Силитусе просит вас отнести покрытую письменами хрустальную призму геологу Ехидной в крепость Кенария.‡Rutgar Glyphshaper in Bronzebeards Lager möchte, dass Ihr Geologin Larksbane auf Burg Cenarius in Silithus das glyphenverzierte Kristallprisma bringt.‡브론즈비어드 야영지에 있는 루트거 글립쉐이퍼가 실리더스의 세나리온 요새에 있는 지질학자 락스베인에게 문자가 새겨진 수정 프리즘을 가져가 달라고 부탁했습니다.‡Rutgar Glifoforma del campamento Barbabronce quiere que lleves el prisma cristalino con glifos a la geóloga Trotuina al Fuerte Cenarion de Silithus.‡Entrégale el prisma de cristal con inscripciones a la geóloga Trotuina en el Fuerte Cenarion de Silithus.‡Rutgar Glyphshaper, du campement de Bronzebeard, veut que vous remettiez le Prisme cristallin orné de glyphes à la géologue Larksbane, au Fort cénarien en Silithus.‡铜须营地的鲁特加尔·雕石想让你将雕文水晶棱柱交给希利苏斯塞纳里奥要塞的地质学家拉克斯班。‡銅須營地的魯特加爾·雕石想讓妳將雕文水晶棱柱交給希利蘇斯塞納裏奧要塞的地質學家拉克斯班。',
  }
},
[8315] = {
  -- Item
  '‡Алебастровый латный ремень‡Alabasterplattengurt‡무쇠 판금 벨트‡Faja de placas de alabastro‡Faja de placas de alabastro‡Ceinturon d\'albâtre en plaques‡雪花板甲束带‡雪白鎧甲束腰',
  nil,
  nil,
  { -- Quest
    'O chamado‡Зов‡Die Anrufung‡소환‡La llamada‡La llamada‡L\'appel‡召唤‡召喚',
    nil,
    'Geóloga Larksbane, no Forte Cenariano em Silithus, quer que você pegue o Mecanismo de Destrancamento de Cristal do Emissário Qiraji.|nVocê foi instruído a levar os Glifos de Evocação até os Ossos de Grakkarond ao sul do Forte Cenariano e desenhá-los na areia. Caso o Emissário Qiraji apareça, mate-o e recupere o Mecanismo de Destrancamento de Cristal. Fale novamente com a Geóloga Matarriso caso tenha sucesso.|nReúna uma tropa para esta missão, <name>!‡Геолог Ехидная из крепости Кенария просит добыть открыватель кристаллов у киражского посланника.|nВам следует отнести письмена зова к Костям Граккаронда, на юг от крепости Кенария, и нарисовать их на песке. Если появится киражский посланник, убейте его и заберите открыватель кристаллов. При успехе вернитесь к геологу Ехидной.|nДля выполнения задания понадобится целая армия!‡Geologin Larksbane auf Burg Cenarius in Silithus möchte, dass Ihr ihr den Kristallentriegelungsmechanismus vom Abgesandten der Qiraji beschafft.|nNehmt die Glyphen der Anrufung, begebt Euch zu den Knochen von Grakkarond südlich von Burg Cenarius und zeichnet sie dort in den Sand. Sollte der Abgesandte der Qiraji erscheinen, tötet ihn und nehmt den Kristallentriegelungsmechanismus an Euch. Kehrt anschließend zu Geologin Larksbane zurück.|nFür diese Aufgabe werdet Ihr eine kleine Armee benötigen, <Name>!‡실리더스의 세나리온 요새에 있는 지질학자 락스베인이 퀴라지 밀사에게서 수정 해독 장치를 되찾아 달라고 부탁했습니다.|n세나리온 요새 남쪽에 있는 그락카론드의 무덤에 부름의 상형 문자를 가지고 간 후 사막에서 대군주를 소환해야 합니다. 퀴라지 밀사가 나타나면 밀사를 해치우고 수정 해독 장치를 회수한 후 지질학자 락스베인에게 돌아가야 합니다.|n이 일을 완료하려면 군대를 소집해야 합니다!‡La Geóloga Trotuina del Fuerte Cenarion de Silithus quiere que consigas el mecanismo de desbloqueo de los cristales del emisario Qiraji.|nTienes que llevar los glifos a Huesos de Grakkarond, al sur del Fuerte Cenarion, y dibujarlos en la arena. Si aparece el emisario Qiraji, mátalo y coge el mecanismo de desbloqueo de los cristales. Si lo consigues, ve a ver a la geóloga Trotuina.|n¡Lleva un ejército contigo, <nombre>!‡La Geóloga Trotuina del Fuerte Cenarion de Silithus quiere que consigas el mecanismo de desbloqueo de los cristales del emisario qiraji.|nTienes que llevar los glifos a Huesos de Grakkarond, al sur del Fuerte Cenarion, y dibujarlos en la arena. Si aparece el emisario qiraji, mátalo y coge el mecanismo de desbloqueo de los cristales. Si lo consigues, ve a ver a la geóloga Trotuina.|n¡Lleva un ejército contigo, <nombre>!‡La géologue Larksbane, au Fort cénarien en Silithus, veut que vous récupériez le Mécanisme de déverrouillage du cristal sur le Maître des clés.|nElle vous a demandé de vous rendre près des Restes de Grakkarond, au sud du Fort cénarien, et d’y dessiner les glyphes d\'appel dans le sable. Si le Maître des clés apparaît, tuez-le et récupérez le Mécanisme de déverrouillage du cristal. Ensuite, si vous avez réussi, retournez voir la géologue Larksbane.|nElle vous a conseillé d’emmener une armée, <nom>.‡希利苏斯塞纳里奥要塞的地质学家拉克斯班想让你从其拉虫人使者那里取回水晶分解装置。|n你已经奉命将召唤雕文带往塞纳里奥要塞以南的格拉卡洛之骨处，将它们从沙中引出。一旦其拉虫人使者露面，就杀死它，获得水晶分解装置。成功之后回到地质学家拉克斯班那儿去。|n你必须召集一支强大的军队来完成这项任务，<name>！‡希利蘇斯塞納裏奧要塞的地質學家拉克斯班想讓妳從其拉蟲人使者那裏取回水晶分解裝置。|n妳已經奉命將召喚雕文帶往塞納裏奧要塞以南的格拉卡洛之骨處，將它們從沙中引出。壹旦其拉蟲人使者露面，就殺死它，獲得水晶分解裝置。成功之後回到地質學家拉克斯班那兒去。|n妳必須召集壹支強大的軍隊來完成這項任務，<name>！',
  }
},
