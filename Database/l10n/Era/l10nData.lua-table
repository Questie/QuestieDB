[7666] = {
  -- Item
  'Colar Estilhaçado‡Поврежденное ожерелье‡Zerrissene Halskette‡부서진 목걸이‡Collar destrozado‡Collar destrozado‡Collier brisé‡破碎的项链‡破碎的項鍊',
  { -- Npc
