[5] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A barriga roncante de Medrisco‡Урчащий живот Трясунчика‡Jitters\' knurrender Magen‡굶주린 지터스‡La hambruna de Gato‡La hambruna de Alterio‡L\'estomac qui gargouille‡饥肠辘辘的基特斯‡饑腸轆轆的基特斯',
    nil,
    'Fale com o Chef Goroba.‡Поговорите с шеф-поваром Груалем.‡Sprecht mit Küchenchef Grual.‡주방장 그루얼과 대화해야 합니다.‡Habla con el Chef Grual.‡Habla con el Chef Grual.‡Parler au chef Grual.‡和厨师格鲁奥谈一谈。‡和廚師格魯奧談壹談。',
  }
},
[6] = {
  nil,
  { -- Npc
    'Kobold Daninho‡Кобольд-вредитель‡Koboldgezücht‡코볼트 졸개‡Alimaña kóbold‡Alimaña kóbold‡Vermine kobold‡狗头人歹徒‡狗頭人歹徒',
    nil,
  },
  nil,
  { -- Quest
    'Recompensa por Garrick Patatenra‡Награда за голову Гаррика Тихокрада‡Kopfgeld auf Garrick Padfoot‡개릭 패드풋 현상금‡La recompensa por Garrick Piesuaves‡La recompensa por Garrick Piesuaves‡La prime pour Garrick Padfoot‡加瑞克·帕德弗特的赏金‡加瑞克·帕德弗特的賞金',
    nil,
    'Mate Garrick Patatenra e leve a cabeça dele para o Cabo Vilém na Abadia de Vila Norte.‡Убейте Гаррика Тихокрада и принесите его голову заместителю судьи Виллему в Аббатство Североземья.‡Tötet Garrick Padfoot und bringt seinen Kopf zu Deputy Willem in der Nähe der Abtei von Nordhain.‡개릭 패드풋을 처치한 후 그 증거로 개릭의 가면을 노스샤이어 수도원 근처에 있는 부관 윌렘에게로 가져가야 합니다.‡Mata a Garrick Piesuaves y lleva su cabeza al ayudante Willem a la Abadía de Villanorte.‡Mata a Garrick Piesuaves y lleva su cabeza al ayudante de alguacil Willem a la Abadía de Villanorte.‡Tuer Garrick Padfoot et rapporter sa tête à l\'Adjoint Willem de l\'Abbaye du Northshire.‡杀死加瑞克·帕德弗特，带着他的头到北郡修道院去找维里副队长。‡殺死加瑞克·帕德弗特，帶著他的頭到北郡修道院去找維裏副隊長。',
  }
},
[7] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Limpeza no acampamento dos kobolds‡Нападение на лагерь кобольдов‡Säuberung im Koboldlager‡코볼트 소탕‡La limpieza del campamento kóbold‡La limpieza del campamento kóbold‡Nettoyer le camp des kobolds‡剿灭狗头人‡剿滅狗頭人',
    nil,
    'Mate 10 Kobolds Daninhos, depois fale novamente com o Major Belmonte.‡Уничтожьте 10 кобольдов-вредителей. Вернитесь к маршалу Макбрайду.‡Tötet 10 von dem Koboldgezücht und kehrt dann zu Marshal McBride zurück.‡코볼트 졸개 10마리를 처치한 다음 치안대장 맥브라이드에게 돌아가야 합니다.‡Mata 10 alimañas kobold y ve a hablar con el alguacil McBride.‡Mata 10 alimañas kóbold y regresa con el alguacil McBride.‡Tuer 10 Vermines kobold, puis revenir voir le maréchal McBride.‡杀死10只狗头人歹徒，然后向治安官玛克布莱德复命。‡殺死10只狗頭人歹徒，然後向治安官瑪克布萊德復命。',
  }
},
[8] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Palavra de ladino‡Выгодная сделка‡Ein Schurkenhandel‡도적의 거래‡Un trato de pícaro‡Un trato de pícaro‡Un marché de voleur‡潜行者的交易‡潛行者的交易',
    nil,
    'Entregue a Carta Comum à Estalajadeira Geni nas Clareiras de Tirisfal.‡Доставьте ненадписанное письмо Ренни – хозяйке таверны в Тирисфальских лесах.‡Liefert den unscheinbaren Brief bei Gastwirtin Renee in Tirisfal ab.‡티리스팔 숲에 있는 여관주인 리니에게 평범한 편지를 가져가야 합니다.‡Lleva la carta anodina a Claros de Tirisfal y entrégasela a la tabernera Renee.‡Lleva la carta anodina a Claros de Tirisfal y entrégasela a la tabernera Renee.‡Livrer une Lettre à Renée dans les Clairières de Tirisfal.‡把笔迹潦草的信件送给布瑞尔的旅店老板瑞尼。‡把筆跡潦草的信件送給布瑞爾的旅店老板瑞尼。',
  }
},
[9] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Campos mortais‡Поля смерти‡Tod auf den Feldern‡죽음의 땅‡Campos de la muerte‡Campos de la muerte‡Les champs de mort‡清理荒野‡清理荒野',
    nil,
    'O Fazendeiro Saldanha quer que você mate 20 Guarda-colheitas.‡Убейте 20 дозорных полей по просьбе фермера Сальдена.‡Bauer Saldean möchte, dass Ihr 20 Erntebehüter tötet.‡농부 살딘이 허수아비골렘 보초 20마리를 처치해 달라고 부탁했습니다.‡El granjero Saldean quiere que mates 20 Vigilantes de la cosecha.‡El granjero Saldean quiere que mates a 20 vigías de la cosecha.‡Le Fermier Saldean veut que vous tuiez 20 Gardiens des moissons.‡农夫萨丁要求你破坏掉20台看守傀儡。‡農夫薩丁要求妳破壞掉20臺看守傀儡。',
  }
},
[10] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Um sonho de voltar vivo pra cidade‡Спасение Холстомера‡Die Erlösung von Scrimshank‡슈섕크 탈출‡La redención de Patagolpe‡La redención de Patagolpe‡La rédemption de Scrimshank‡谢申克的救赎‡謝申克的救贖',
    nil,
    'Descubra qual foi a sina do Topógrafo Júnior Caranduru, e leve ele ou seus equipamentos de topografia para o Topógrafo Sênior Secamolha, em Geringontzan.‡Узнайте, что стало с младшим геодезистом Холстомером и приведите его или верните его оборудование старшему геодезисту Рудознатцу в Прибамбасск.‡Erforscht das Schicksal von Unterfeldmesser Scrimshank und bringt entweder ihn oder seine Feldmesserausrüstung nach Gadgetzan zum Leitenden Feldmesser Fizzledowser.‡후임측량사 슈섕크가 어떻게 되었는지 알아보고 가젯잔에 있는 선임측량사 피즐도저에게 데려오거나 그의 측량 장비라도 찾아서 가져가야 합니다.‡Descubre qué le ha ocurrido al perito adjunto Patagolpe y llévalo a él o su equipo de análisis ante el perito jefe Picoflojo, que está en Gadgetzan.‡Descubre qué le ha ocurrido al perito adjunto Patagolpe y llévalo a él o su equipo de análisis ante el perito jefe Picoflojo, en Gadgetzan.‡Découvrir ce qu\'est devenu le géomètre Scrimshank, et rapporter son équipement topographique au grand géomètre Fizzledowser à Gadgetzan.‡寻找初级勘探员谢申克的下落，把他或者他的勘探设备交给加基森的高级勘探员菲兹杜瑟。‡尋找初級勘探員謝申克的下落，把他或者他的勘探設備交給加基森的高級勘探員菲茲杜瑟。',
  }
},
[11] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Caçando gnolls‡Награда за гноллов из стаи Речной Лапы‡Kopfgeld auf die Flusspfotengnolle‡갈퀴발 놀 현상금‡Recompensas por los gnolls Zarparrío‡Recompensas por los gnolls Zarparrío‡Prime pour les gnolls Rivepatte‡悬赏河爪豺狼人‡懸賞河爪豺狼人',
    nil,
    'Leve 8 Braçadeiras Pintadas dos Gnolls para o Delegado Ranieri no Quartel.‡Принесите 8 раскрашенных поручей гноллов в казармы заместителю судьи Рейнеру.‡Bringt Deputy Rainer in der Kaserne 8 bemalte Gnoll-Armbinden.‡병영에 있는 부관 레이너에게 놀의 화려한 완장 8개를 가져가야 합니다.‡Lleva 8 brazaletes gnoll violáceos al ayudante del alguacil Rainer al Cuartel.‡Lleva 8 bandas gnoll pintadas al ayudante de alguacil Rainer al Cuartel.‡Apporter 8 Brassards peints de gnolls à l\'Adjoint Rainer à la Caserne.‡给兵营的瑞尼尔副队长带去8个彩色豺狼人臂章。‡給兵營的瑞尼爾副隊長帶去8個彩色豺狼人臂章。',
  }
},
[12] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Milícia do Povo‡Народное ополчение‡Die Volksmiliz‡백성의 민병대‡Las Milicias del Pueblo‡La Milicia Popular‡La milice du peuple‡西部荒野人民军‡西部荒野人民軍',
    nil,
    'Miguel Mantoforte quer que você mate 15 Coureadores Défias e 15 Contrabandistas Défias, e fale novamente com ele no Morro da Sentinela.‡Убейте 15 звероловов и 15 контрабандистов из Братства Справедливости и вернитесь к Гриану Камнегриву.‡Gryan Stoutmantle möchte, dass Ihr 15 Fallensteller der Defias und 15 Schmuggler der Defias tötet und zu ihm auf die Späherkuppe zurückkehrt.‡그라이언 스타우트맨틀이 데피아즈단 덫사냥꾼 15명과 데피아즈단 밀수업자 15명을 처치하고 감시의 언덕으로 돌아오라고 지시했습니다.‡Gryan Mantorrecio quiere que mates 15 tramperos Defias y 15 contrabandistas Defias. Cuando lo hayas hecho vuelve a verle en la Colina del Centinela.‡Gryan Mantorrecio quiere que mates a 15 tramperos Defias y a 15 contrabandistas Defias. Cuando lo hayas hecho vuelve a verle en la Colina del Centinela.‡Tuer 15 Trappeurs défias et 15 Contrebandiers défias pour Gryan Stoutmantle, puis retourner le voir sur la Colline des sentinelles.‡哨兵岭的格里安·斯托曼要求你消灭15名迪菲亚捕兽者和15名迪菲亚走私者，然后回去向他报告。‡哨兵嶺的格裏安·斯托曼要求妳消滅15名迪菲亞捕獸者和15名迪菲亞走私者，然後回去向他報告。',
  }
},
[13] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Milícia do Povo‡Народное ополчение‡Die Volksmiliz‡백성의 민병대‡Las Milicias del Pueblo‡La Milicia Popular‡La milice du peuple‡西部荒野人民军‡西部荒野人民軍',
    nil,
    'Miguel Mantoforte quer que você mate 15 Pilhadores Défias e 15 Gatunos Défias, e fale novamente com ele no Morro da Sentinela.‡Убейте 15 погромщиков и 15 мошенников из Братства Справедливости и вернитесь к Гриану Камнегриву на Сторожевой холм.‡Gryan Stoutmantle möchte, dass Ihr 15 Plünderer der Defias und 15 Ausplünderer der Defias tötet und zu ihm auf die Späherkuppe zurückkehrt.‡그라이언 스타우트맨틀이 데피아즈단 강탈자 15명과 데피아즈단 약탈자 15명을 처치하고 감시의 언덕으로 돌아오라고 지시했습니다.‡Gryan Mantorrecio quiere que mates 15 saqueadores Defias y 15 despojadores Defias. Cuando lo hayas hecho vuelve a verle en la Colina del Centinela.‡Gryan Mantorrecio quiere que mates a 15 saqueadores Defias y a 15 despojadores Defias. Cuando lo hayas hecho vuelve a verle en la Colina del Centinela.‡Tuer 15 Pilleurs défias et 15 Pillards défias pour Gryan Stoutmantle, puis retourner le voir sur la Colline des sentinelles.‡哨兵岭的格里安·斯托曼要求你消灭15名迪菲亚抢劫者和15名迪菲亚强夺者，然后回去向他报告。‡哨兵嶺的格裏安·斯托曼要求妳消滅15名迪菲亞搶劫者和15名迪菲亞強奪者，然後回去向他報告。',
  }
},
[14] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Milícia do Povo‡Народное ополчение‡Die Volksmiliz‡백성의 민병대‡Las Milicias del Pueblo‡La Milicia Popular‡La milice du peuple‡西部荒野人民军‡西部荒野人民軍',
    nil,
    'Miguel Mantoforte quer que você mate 15 Bandoleiros Défias, 5 Tocaiantes Défias e 5 Rufiões Défias, e fale novamente com ele no Morro da Sentinela.‡Убейте 15 разбойников, 5 налетчиков и 5 кастетчиков из Братства Справедливости. Вернитесь к Гриану Камнегриву на Сторожевой Холм.‡Gryan Stoutmantle möchte, dass Ihr 15 Straßenräuber der Defias, 5 Pfadpirscher der Defias und 5 Knöchelhauer der Defias tötet und zu ihm auf die Späherkuppe zurückkehrt.‡그라이언 스타우트맨틀이 데피아즈단 노상강도 15명과 데피아즈단 정찰병 5명과 데피아즈단 복면강도 5명을 처치하고 감시의 언덕으로 돌아오라고 지시했습니다.‡Gryan Mantorrecio quiere que mates 15 bandoleros Defias y 5 acechacaminos Defias. Cuando lo hayas hecho vuelve a verle en la Colina del Centinela.‡Gryan Mantorrecio quiere que mates a 15 bandoleros Defias, a 5 acechacaminos Defias y a 5 nudillos Defias. Cuando lo hayas hecho vuelve a verle en la Colina del Centinela.‡Tuer 15 Malandrins défias, 5 Eclaireurs défias et 5 Truands défias pour Gryan Stoutmantle, puis retourner le voir sur la Colline des sentinelles.‡哨兵岭的格里安·斯托曼要求你消灭15个迪菲亚路霸、5个迪菲亚巡路者和5个迪菲亚拳匪，然后回去向他报告。‡哨兵嶺的格裏安·斯托曼要求妳消滅15個迪菲亞路霸、5個迪菲亞巡路者和5個迪菲亞拳匪，然後回去向他報告。',
  }
},
[15] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Investigue a Serra do Eco‡Разведка в руднике Горного эха‡Überprüfung der Echokammmine‡메아리 광산 조사‡Investiga la Mina del Eco‡Investiga la Mina del Eco‡Enquête sur la crête aux échos‡回音山调查行动‡回音山調查行動',
    nil,
    'Mate 10 Trabalhadores Kobolds e fale novamente com o Major Belmonte.‡Уничтожьте 10 кобольдов-рабочих и вернитесь к маршалу Макбрайду.‡Tötet 10 Koboldtagelöhner und erstattet dann Marshal McBride Euren Bericht.‡코볼트 잡역부 10마리를 처치한 다음 치안대장 맥브라이드에게 돌아와 보고해야 합니다.‡Mata a 10 trabajadores kóbold y preséntate ante el alguacil McBride.‡Mata a 10 trabajadores kóbold y preséntate ante el alguacil McBride.‡Tuer 10 Ouvriers kobolds, puis revenir faire son rapport au maréchal McBride.‡杀死10只狗头人劳工，然后向治安官玛克布莱德复命。‡殺死10只狗頭人勞工，然後向治安官瑪克布萊德復命。',
  }
},
