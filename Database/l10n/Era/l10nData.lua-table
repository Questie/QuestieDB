  nil,
  { -- Quest
    'Teste de resistência‡Испытание выносливости‡Test der Belastbarkeit‡인내의 시험‡Prueba de resistencia‡Prueba de resistencia‡L’épreuve de l’Endurance‡耐力的试炼‡耐力的試煉',
    nil,
    'Leve a Garra da Grenka para Dorn Espreitaprados em Mil Agulhas.‡Принесите коготь Гренки Дорну Вольному Ловчему в Тысячу Игл.‡Bringt Grenkas Klaue zu Dorn Plainstalker in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커에게 그렌카의 발톱을 가져가야 합니다.‡Llévale la garra de Grenka a Dorn Acechaprados, que está en Las Mil Agujas.‡Llévale la garra de Grenka a Dorn Acechallanos, que está en Las Mil Agujas.‡Apporter la Griffe de Grenka au traqueur des plaines Dorn, aux Mille pointes.‡把格林卡的爪子交给千针石林的多恩·平原行者。‡把格林卡的爪子交給千針石林的多恩·平原行者。',
  }
},
[1151] = {
  -- Item
  '‡‡‡성서: 성스러운 빛 III‡‡‡‡‡聖契:聖光術 III',
  { -- Npc
    'Crocolisco de Água Salgada‡Морской кроколиск‡Salzwasserkrokilisk‡바다악어‡Crocolisco Aguasalada‡Crocolisco Aguasalada‡Crocilisque marin‡海鳄‡海鱷',
    nil,
  },
  nil,
  { -- Quest
    'Teste de força‡Испытание силы‡Test der Kraft‡용기의 시험‡Prueba de fuerza‡Prueba de fuerza‡L\'épreuve de la Force‡力量的试炼‡力量的試煉',
    nil,
    'Leve os Fragmentos de Rok\'Alim para Dorn Espreitaprados em Mil Agulhas.‡Принесите фрагменты Рок\'Алима Дорну Вольному Ловчему в Тысячу Игл.‡Bringt Fragmente von Rok\'Alim zu Dorn Plainstalker in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커에게 로크알림의 파편을 가져가야 합니다.‡Llévale fragmentos de Rok\'Alim a Dorn Acechaprados, que está en Las Mil Agujas.‡Llévale fragmentos de Rok\'Alim a Dorn Acechallanos, que está en Las Mil Agujas.‡Apporter des Fragments de Rok\'Alim au traqueur des plaines Dorn dans les Mille pointes.‡把罗卡里姆的碎片交给千针石林的多恩·平原行者。‡把羅卡裏姆的碎片交給千針石林的多恩·平原行者。',
  }
},
[1152] = {
  nil,
  { -- Npc
    'Crocolisco Arapuca‡Кроколиск-хрустогрыз‡Schnappkieferkrokilisk‡무쇠턱 악어‡Crocolisco Quijaforte‡Crocolisco Quijaforte‡Crocilisque Gueule d\'acier‡钳嘴鳄鱼‡鉗嘴鱷魚',
    nil,
  },
  nil,
  { -- Quest
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Encontre Braug Espírito Turvo perto da entrada do Túnel Garracava, na Cordilheira das Torres de Pedra.‡Найдите Брауга Тусклый Дух возле входа в Туннель Когтя в Когтистых горах.‡Sucht Braug Dimspirit in der Nähe des Eingangs zum Steinkrallenpfad im Steinkrallengebirge.‡돌발톱 산맥에 있는 돌발톱 토굴길 입구 근처에서 브라우그 딤스피릿을 찾아야 합니다.‡Encuentra a Braug Espiritoscuro cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Encuentra a Braug Espíritu Tenue cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Trouver Braug Dimspirit près de l’entrée de la Perce des Serres dans les Serres-Rocheuses.‡找到连接石爪山和灰谷的石爪小径里的布劳格·幽魂。‡找到連接石爪山和灰谷的石爪小徑裏的布勞格·幽魂。',
  }
},
[1153] = {
  nil,
  { -- Npc
    'Torren Queixorreto‡Торрен Квадратная Челюсть‡Torren Squarejaw‡토렌 스퀘어조‡Torren Mandicuadrada‡Torren Mandicuadrada‡Torren Squarejaw‡托瑞恩·方颔‡托瑞恩·方頷',
    'Liga dos Exploradores‡Лига Исследователей‡Forscherliga‡탐험가 연맹‡Liga de Expedicionarios‡Liga de Expedicionarios‡Ligue des explorateurs‡探险者协会‡探險者協會',
  },
  nil,
  { -- Quest
    'Uma nova amostra de minério‡Образец новой руды‡Eine neue Erzprobe‡새로운 광석 견본‡Una nueva muestra de mineral‡Una nueva muestra de mineral‡Un nouveau minerai‡新的矿石样本‡新的礦石樣本',
    nil,
    'Obtenha uma Amostra Não Refinada de Minério de um Escavador Britanapa ou de um Topógrafo e leve para Trapista Forjaço no Acampamento Taurajo, que fica nos Sertões.‡Отберите неочищенный образец руды у землекопа или геодезиста из племени Камнерылов и принесите его Таттернаку Стальному Горну в Лагерь Таурахо в Степях.‡Sucht eine unbearbeitete Erzprobe bei einem Buddler oder Feldmesser der Bruchschnauzen und bringt sie zu Tatternack Steelforge im Camp Taurajo im Brachland.‡자갈주둥이일족 채굴꾼이나 흙점쟁이가 가지고 있는 정제하지 않은 광석 견본을 찾아 불모의 땅, 타우라조 야영지에 있는 테터낵 스틸포지에게 가져가야 합니다.‡Arrebátale una muestra de mineral no refinado a un cavador o a un perito Gravamorro y llévasela a Tatternack Forjacero al Campamento Taurajo de Los Baldíos.‡Arrebátale una muestra bruta de mena a un cavador o a un perito Gravamorro y llévasela a Jironack Forjacero al Campamento Taurajo de Los Baldíos.‡Trouver un échantillon de minerai brut sur un Mineur ou un Géomètre Mufle-de-gravier et l’apporter à Tatternack Steelforge, à Camp Taurajo dans les Tarides.‡从砂齿掘地工或砂齿勘探员那里找一块未精炼的矿石样本，把它交给陶拉祖营地的塔特纳克·钢炉。‡從砂齒掘地工或砂齒勘探員那裏找壹塊未精煉的礦石樣本，把它交給陶拉祖營地的塔特納克·鋼爐。',
  }
},
