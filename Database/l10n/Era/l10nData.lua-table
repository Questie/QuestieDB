[7905] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Feira de Negraluna‡Ярмарка Новолуния‡Der Dunkelmond-Jahrmarkt‡다크문 축제‡La Feria de la Luna Negra‡La Feria de la Luna Negra‡La foire de Sombrelune‡暗月马戏团‡暗月馬戲團',
    nil,
    'Entregue o Vale-ingresso para Gelvas Portassuja na Feira de Negraluna.‡Передайте сертификат на призовой купон Гельвасу Угольному Шлюзу на ярмарке Новолуния.‡Bringt den Gutschein zu Gelvas Grimgate, der sich innerhalb des Dunkelmond-Jahrmarkts aufhält.‡다크문 축제가 열리고 있는 장소로 가서 겔바스 그림게이트에게 무료 상품 교환권을 제출해야 합니다.‡Entrega el vale de entrada gratuita a Gelvas Roñoso en la Feria de la Luna Negra.‡Entrega el vale de entrada gratuita a Gelvas Roñoso en la Feria de la Luna Negra.‡Donnez le Coupon pour des bons gratuits à Gelvas Grimgate, qui se trouve dans la foire de Sombrelune.‡到暗月马戏团的场地里去，将免费券交给吉瓦斯·格里加特。‡到暗月馬戲團的場地裏去，將免費券交給吉瓦斯·格裏加特。',
  }
},
