[261] = {
  nil,
  { -- Npc
    'Guarda Tomás‡Стражник Томас‡Wache Thomas‡경비병 토마스‡Guardia Thomas‡Guardia Thomas‡Garde Thomas‡卫兵托马斯‡衛兵湯瑪斯',
    nil,
  },
  -- Object
  'Caixote Danificado‡Поврежденный ящик‡Beschädigte Kiste‡부서진 상자‡Cajón dañado‡Cajón dañado‡Caisse endommagée‡破损的箱子‡破損的木箱',
  { -- Quest
    'No caminho Escarlate‡Путями Алого ордена‡Auf dem Scharlachroten Pfad‡붉은십자군의 길‡El sendero Escarlata‡El sendero Escarlata‡Sur le chemin écarlate‡血色之路‡血色之路',
    nil,
    'Destrua 30 Assoladores Mortos-vivos, depois fale novamente com o Irmão Anton no Posto do Nijel.‡Убейте 30 опустошителей-отрекшихся и вернитесь к брату Антону на Высоте Найджела.‡Vernichtet 30 untote Verheerer und kehrt dann zu Bruder Anton auf die Nijelspitze zurück.‡언데드 약탈자 30마리를 처치한 후 나이젤의 야영지에 있는 수사 안톤에게 돌아가야 합니다.‡Destruye 30 devastadores no-muertos y luego ve a buscar al hermano Antón a Punta de Nijel.‡Aniquila 30 devastadores no-muertos y luego ve a buscar al hermano Anton a Punta de Nijel.‡Détruire 30 Ravageurs morts-vivants, puis retourner voir Frère Anton, à la Combe de Nijel.‡杀掉30个亡灵劫掠者，然后向尼耶尔前哨站的安东修士复命。‡殺掉30個亡靈劫掠者，然後向尼耶爾前哨站的安東修士復命。',
  }
},
[262] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O vulto sombrio‡Таинственный незнакомец‡Die Schattengestalt‡의문의 남자‡La figura en las sombras‡La figura en las sombras‡L\'obscure silhouette‡模糊的人影‡模糊的人影',
    nil,
    'Leve o livro que encontrou na fazenda de Noel e mostre-o aos cidadãos da Vila Sombria.‡Отнесите книгу, обнаруженную на ферме Свена, в Темнолесье и покажите ее горожанам.‡Nehmt das Buch, das Ihr auf Svens Hof gefunden habt, und zeigt es den Einwohnern von Dunkelhain.‡다크샤이어의 마을 주민들에게 스벤의 농장에서 발견한 책을 보여 줘야 합니다.‡Llévate el libro que encontraste en la granja de Sven a Villa Oscura y enséñaselo a sus habitantes.‡Llévate el libro que encontraste en la granja de Sven a Villa Oscura y enséñaselo a sus habitantes.‡Montrer le livre que vous avez trouvé à la ferme de Sven aux habitants de Darkshire.‡带着你从斯温的农场找到的书，把它拿给夜色镇上的人看看。‡帶著妳從斯溫的農場找到的書，把它拿給夜色鎮上的人看看。',
  }
},
[263] = {
  nil,
  { -- Npc
    'Lorde Malaquias Ebanez‡Лорд Элло Чернодрев‡Lord Ello Ebonlocke‡엘로 이본로크 경‡Lord Ello Cerranegro‡Lord Ello Cerranegro‡Seigneur Ello Ebonlocke‡艾尔罗·埃伯洛克公爵‡艾爾羅·埃伯洛克領主',
    'Prefeito de Vila Sombria‡Мэр Темнолесья‡Bürgermeister von Dunkelhain‡다크샤이어 시장‡Alcalde de Villa Oscura‡Alcalde de Villa Oscura‡Maire de Darkshire‡夜色镇的镇长‡夜色鎮的鎮長',
  },
  -- Object
  'Suprimentos de Kurzen‡Припасы Курцена‡Kurzens Vorräte‡쿠르젠 보급품‡Suministros Kurzen‡Suministros Kurzen‡Ravitaillements de Kurzen‡库尔森补给品‡庫爾森補給品',
  { -- Quest
    'Em defesa das terras do Rei‡Защита королевских земель‡Verteidigung der Länder des Königs‡왕국 수호‡En defensa de las tierras del rey‡En defensa de las tierras del rey‡À la défense des terres du roi‡保卫国王的领土‡保衛國王的領土',
    nil,
    'Montanhista Batemuro na torre de vigia sul quer que você mate 10 Xamãs Lascapedra and 10 Quebraossos Lascapedra.‡Горный пехотинец Стенолом просит вас убить 10 шаманов из племени Камнедробов и 10 костегрызов из племени Камнедробов.‡Gebirgsjäger Wallbang im südlichen Wachturm möchte, dass Ihr 10 Schamanen der Splittersteintroggs und 10 Knochenknacker der Splittersteintroggs tötet.‡남쪽 경비탑의 산악경비대 월뱅이 가루바위일족 주술사 10명과 가루바위일족 뼈다귀싸움꾼 10명을 처치해 달라고 부탁했습니다.‡El montaraz Pedernal, de la torre de vigilancia sur, quiere que mates a 10 chamanes y 10 quebrantahuesos Rompecantos.‡Montaraz Muroplof en la torre de vigilancia sur quiere que mates 10 chamanes Rompecantos y 10 cascahuesos Rompecantos.‡Le Montagnard Wallbang de la Tour de garde méridionale veut que vous tuiez 10 Chamans et 10 Briseurs d\'Os Brisepierre.‡南部警戒塔的巡山人沃尔班要你杀掉10个碎石怪萨满祭司和10个碎石怪断骨者。‡南部警戒塔的巡山人沃爾班要妳殺掉10個碎石怪薩滿祭司和10個碎石怪斷骨者。',
  }
},
[264] = {
  nil,
  { -- Npc
    'Comandante Aldora Ebanez‡Командир Алтея Чернодрев‡Kommandantin Althea Ebonlocke‡사령관 알시아 이본로크‡Comandante Althea Cerranegro‡Comandante Althea Cerranegro‡Commandant Althea Ebonlocke‡指挥官阿尔泰娅·埃伯洛克‡指揮官奧爾希雅·埃伯洛克',
    'Líder da Vigília Noturna‡Глава Ночного дозора‡Anführerin der Nachtwache‡어둠의 순찰대 사령관‡Líder de La Guardia Nocturna‡Líder de La Guardia Nocturna‡Chef des Veilleurs‡守夜人指挥官‡守夜人指揮官',
  },
  -- Object
  'Suprimentos de Kurzen‡Припасы Курцена‡Kurzens Vorräte‡쿠르젠 보급품‡Suministros Kurzen‡Suministros Kurzen‡Ravitaillements de Kurzen‡库尔森补给品‡庫爾森補給品',
  { -- Quest
    'Até que a morte nos separe‡Покуда смерть не разлучит нас‡Bis dass der Tod uns scheidet‡영원한 이별‡Hasta que la muerte nos separe‡Hasta que la muerte nos separe‡Jusqu\'à ce que la mort nous sépare‡至死方休‡至死方休',
    nil,
    'Coloque o Pingente da Clarice no Túmulo de Yuriv em Pinhaprata.‡Положите подвеску Кларисы на могилу Юрива в Серебролесье.‡Legt Clarices Anhänger auf Yurivs Grab in Silberwald.‡은빛소나무 숲에 있는 유리브의 무덤에 클라리스의 펜던트를 가져다 놓아야 합니다.‡Coloca el colgante de Clarice sobre la tumba de Yuriv en Argénteos.‡Coloca el colgante de Clarice sobre la tumba de Yuriv en Argénteos.‡Placer le pendentif de Clarice sur la tombe de Yuriv, dans la forêt des Pins argentés.‡把克拉莉斯的坠饰放在银松森林尤瑞夫的坟墓上。‡把克拉莉斯的墜飾放在銀松森林尤瑞夫的墳墓上。',
  }
},
[265] = {
  nil,
  { -- Npc
    'Madame Eva‡Мадам Ева‡Madame Eva‡에바 부인‡Lady Eva‡Lady Eva‡Madame Eva‡伊瓦夫人‡艾娃夫人',
    nil,
  },
  nil,
  { -- Quest
    'A busca sombria continua‡Продолжение поисков незнакомца‡Die Schattensuche geht weiter‡계속되는 조사‡La búsqueda de la figura continúa‡La búsqueda de la figura continúa‡L\'obscure recherche se poursuit‡继续搜寻‡繼續搜尋',
    nil,
    'Tente encontrar outras pistas sobre o vulto sombrio entre os aldeões.‡Поговорите с горожанами о таинственном незнакомце.‡Überprüft, ob andere Einwohner Hinweise auf die schattenhafte Gestalt haben.‡다른 마을 주민에게서 의문의 남자에 대한 정보를 알아봐야 합니다.‡Averigua si otros habitantes tienen pistas sobre la figura misteriosa.‡Averigua si otros habitantes tienen pistas sobre la figura misteriosa.‡Voir si d\'autres habitants ont des indices concernant l\'obscure silhouette.‡看看其他的镇民有没有关于模糊的人影的线索。‡看看其他的鎮民有沒有關於模糊的人影的線索。',
  }
},
[266] = {
  nil,
  { -- Npc
    'Wiley, o Negro‡Вилли Черный‡Wiley der Schwarze‡악당 와일리‡Wiley el Negro‡Wiley el Negro‡Wiley le noir‡黑衣威利‡黑衣威利',
    nil,
  },
  nil,
  { -- Quest
    'Perguntas na estalagem‡Расспросы в таверне‡Nachforschungen im Gasthaus‡여관에서의 조사‡Busqueda en la posada‡Preguntas en la posada‡Une enquête à l\'auberge‡调查旅店‡調查旅店',
    nil,
    'Procure pistas sobre o vulto sombrio na estalagem‡Найдите в таверне улики, связанные с таинственным незнакомцем.‡Sucht im Gasthaus nach Hinweisen auf die schattenhafte Gestalt.‡여관에서 의문의 남자에 대한 정보를 얻으십시오.‡Busca pistas sobre la figura misteriosa en la posada.‡Busca pistas sobre la figura misteriosa en la posada.‡Chercher à l\'auberge des indices concernant l\'obscure silhouette.‡到旅店去查一查关于模糊人影的线索。‡到旅店去查壹查關於模糊人影的線索。',
  }
},
[267] = {
  nil,
  { -- Npc
    'Tabelião Azambuja‡Клерк Далтри‡Amtmann Daltry‡서기관 달트리‡Secretario Daltry‡Secretario Daltry‡Greffier Daltry‡书记员达尔塔‡書記員達爾塔',
