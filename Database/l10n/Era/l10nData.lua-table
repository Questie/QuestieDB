},
[255] = {
  nil,
  { -- Npc
    'Geraldo Amanho‡Джерард Румпель‡Gerard Tiller‡제라드 틸러‡Gerard Tiller‡Gerard Tiller‡Gerard Tiller‡葛拉德·提勒‡葛拉德·提勒',
    nil,
  },
  nil,
  { -- Quest
    'Mercenários‡Наемники‡Söldner‡용병‡Mercenarios‡Mercenarios‡Mercenaires‡雇佣兵‡雇傭兵',
    nil,
    'O Magistrado Grã-narina de Thelsamar contratou você para matar 4 Ogros Mo\'grosh, 4 Brutamontes Mo\'grosh e 4 Impositores Mo\'grosh.‡Мировой судья Тупонос просит вас убить 4 огров из клана Мо\'грош, 4 громил из клана Мо\'грош и 4 головорезов из клана Мо\'грош.‡Magistrat Bluntnose aus Thelsamar hat Euch angeheuert, um 4 Oger der Mo\'grosh, 4 Schläger der Mo\'grosh und 4 Vollstrecker der Mo\'grosh zu töten.‡텔사마의 집정관 블런트노즈가 모그로쉬 오우거 4마리, 모그로쉬일족 투사 4마리와 모그로쉬일족 집행자 4마리를 처치하기 위해 당신을 고용했습니다.‡El magistrado Romonariz de Thelsamar te ha contratado para matar a 4 ogros, 4 brutos y 4 gorilas Mo\'grosh.‡El magistrado Narizroma de Thelsamar te ha contratado para matar 4 ogros Mo\'grosh, 4 brutos Mo\'grosh y 4 déspotas Mo\'grosh.‡Le magistrat Bluntnose de Thelsamar vous a <embauché/embauchée> pour tuer 4 Ogres, 4 Brutes et 4 Massacreurs Mo\'grosh.‡塞尔萨玛的镇长埃罗恩·钝鼻雇你去杀掉4个莫格罗什食人魔、4个莫格罗什蛮兵和4个莫格罗什执行者。‡塞爾薩瑪的鎮長埃羅恩·鈍鼻雇妳去殺掉4個莫格羅什食人魔、4個莫格羅什蠻兵和4個莫格羅什執行者。',
  }
},
[256] = {
  nil,
  nil,
  -- Object
  'PROCURA-SE‡РАЗЫСКИВАЕТСЯ‡GESUCHT‡현상수배!‡SE BUSCA‡¡Se busca!‡ON RECHERCHE‡通缉‡通緝',
  { -- Quest
    'PROCURA-SE: Chok\'sul‡Разыскивается: Чок\'сул‡GESUCHT: Chok\'sul‡초크술 현상수배‡SE BUSCAN: Chok\'sul‡SE BUSCA: Chok\'sul‡ON RECHERCHE : Chok\'sul‡通缉令：卓克苏尔‡通緝令：卓克蘇爾',
    nil,
    'Mate Chok\'sul e entregue a cabeça para o Magistrado Grã-narina, em Thelsamar.‡Убейте Чок\'сула и принесите его голову чиновнику Тупоносу в Телcамар.‡Tötet Chok\'sul und bringt Magistrat Bluntnose seinen Kopf.‡초크술을 처치하고 그 증거로 그의 머리카락을 텔사마의 집정관 블런트노즈에게 가져가야 합니다.‡Mata a Chok\'sul y lleva su cabeza al magistrado Romonariz a Thelsamar.‡Mata a Chok\'sul y lleva su cabeza al magistrado Narizroma a Thelsamar.‡Tuer Chok\'sul et rapporter sa tête au Magistrat Bluntnose de Thelsamar.‡杀了卓克苏尔，把他的头颅带给塞尔萨玛的镇长埃罗恩·钝鼻。‡殺了卓克蘇爾，把他的頭顱帶給塞爾薩瑪的鎮長埃羅恩·鈍鼻。',
  }
},
[257] = {
  nil,
  { -- Npc
    'Trabalhador Kobold‡Кобольд-рабочий‡Koboldtagelöhner‡코볼트 잡역부‡Trabajador kóbold‡Trabajador kóbold‡Ouvrier kobold‡狗头人劳工‡狗頭人勞工',
    nil,
  },
  -- Object
  'Barril Suspeito‡Подозрительная бочка‡Verdächtiges Fass‡수상한 통‡Barril sospechoso‡Barrica sospechosa‡Tonneau suspect‡可疑的桶‡可疑的桶子',
  { -- Quest
    'Modéstia de Caçador‡Похвальба охотника‡Das Prahlen eines Jägers‡사냥꾼의 허세‡La fanfarronada de un cazador‡La fanfarronada de un cazador‡La fanfaronnade d\'un chasseur‡自豪的猎人‡自豪的獵人',
    nil,
    'Mate 6 Urubus Montanheses e fale novamente com Dário, o Novato, no Pavilhão dos Andarilhos, dentro de 15 minutos.‡Убейте 6 горных канюков и вернитесь к Дэрилу Юному в Приют странников. На выполнение задания отводится 15 минут.‡Tötet 6 Bergbussarde und kehrt innerhalb von 15 Minuten zu Daryl dem Jüngling in die Weitschreiter-Lodge zurück.‡산악대머리수리 6마리를 처치한 후 순찰자의 오두막에 있는 풋내기 다릴에게 15분 안에 돌아와야 합니다.‡Mata 6 águilas ratoneras montesas y regresa a la Cabaña del Errante con Daryl el Jovenzuelo en menos de 15 minutos.‡Mata 6 águilas ratoneras montesas y regresa a la Cabaña del Errante con Daryl el Jovenzuelo en menos de 15 minutos.‡Tuer 6 Busards des montagnes et retourner auprès de Daryl le Jeune au pavillon des pérégrins en moins de 15 minutes.‡杀死6只山鹫，然后回到旅行者营地见年轻的达瑞尔，时限为15分钟。‡殺死6只山鷲，然後回到旅行者營地見年輕的達瑞爾，時限為15分鐘。',
  }
},
[258] = {
  nil,
  { -- Npc
    'Josué Madruga‡Джошуа Маклюр‡Joshua Maclure‡조슈아 맥클루어‡Joshua Maclure‡Joshua Maclure‡Joshua Maclure‡乔舒·马科伦‡喬舒·馬科倫',
    'Vinheiro‡Виноторговец‡Weinhändler‡포도주 양조업자‡Vendedor de vinos‡Vendedor de vinos‡Vigneron‡葡萄酒商‡葡萄酒商',
  },
  nil,
  { -- Quest
    'Desafio de caçador‡Вызов охотнику‡Die Herausforderung eines Jägers‡사냥꾼의 도전‡El reto de un cazador‡El reto de un cazador‡Le défi d\'un chasseur‡猎人的挑战‡獵人的挑戰',
    nil,
    'Mate 5 Javalis Montanheses Anciãos e fale novamente com Dário, o Novato, no Pavilhão dos Andarilhos, dentro de 12 minutos.‡Убейте 5 старых горных вепрей и вернитесь к Дэрилу Юному в Приют странников. На выполнение задания отводится 12 минут.‡Tötet 5 alte Bergeber und kehrt innerhalb von 12 Minuten zu Daryl dem Jüngling in die Weitschreiter-Lodge zurück.‡덩치큰 산돼지 5마리를 처치한 후 순찰자의 오두막에 있는 풋내기 다릴에게 12분 내에 돌아와야 합니다.‡Mata 5 jabalís monteses mayores y ve a ver a Daryl el Jovenzuelo a la Cabaña del Errante en menos de 12 minutos.‡Mata 5 jabalíes monteses mayores y regresa a la Cabaña del Errante con Daryl el Jovenzuelo en menos de 12 minutos.‡Tuer 5 Anciens sangliers des montagnes et retourner auprès de Daryl le Jeune au pavillon des pérégrins en 12 minutes.‡杀掉5只老山猪，然后回到旅行者营地去见年轻的达瑞尔，时限为12分钟。‡殺掉5只老山豬，然後回到旅行者營地去見年輕的達瑞爾，時限為12分鐘。',
  }
},
