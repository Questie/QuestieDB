[3821] = {
  -- Item
  '‡Златошип‡Golddorn‡황금가시‡Espina de oro‡Espina de oro‡Dorépine‡金棘草‡金棘草',
  { -- Npc
    'Tocaieira Cardagreste‡Воронковый паук Дикого Терна‡Wilddornlauerer‡찔레가시 늑대거미‡Rondador Espinaferal‡Rondador Espinaferal‡Rôdeuse Ronce-sauvage‡野棘潜伏者‡野棘潛伏者',
    nil,
  },
  nil,
  { -- Quest
    'Rochedo Malhorrendo‡Скала Молота Ужаса‡Schreckensfels‡우레망치 바위굴‡Roca Machacamiedo‡Roca Machacamiedo‡Le Rocher des Cognepeurs‡巨槌石‡巨槌石',
    nil,
    'Explore as Estepes Ardentes e descubra o que aconteceu com Sha\'ni Altapresa.‡Отправляйтесь в Пылающие степи и выясните, что сталось с Ша\'ни Гордым Клыком.‡Begebt Euch in die brennende Steppe und findet heraus, was aus Sha\'ni Proudtusk geworden ist.‡불타는 평원으로 가서 샤니 프라우드터스크에게 무슨 일이 있었는지 확인해야 합니다.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colminilludo.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colmillo Orgulloso.‡S\'aventurer dans les Steppes ardentes et découvrir ce qu\'il est advenu de Sha\'ni Proudtusk.‡到燃烧平原去找到沙妮·长齿。‡到燃燒平原去找到沙妮·長齒。',
  }
},
[3822] = {
  -- Item
  '‡Рунический Черный клинок‡Runenverzierte Dunkelklinge‡룬문자 암흑검‡Hoja oscura rúnica‡Hoja oscura rúnica‡Sombrelame runique‡黑暗符文剑‡符文之黑刃',
  nil,
  nil,
  { -- Quest
    'Krom\'Grul‡Кром\'Грул‡Krom\'Grul‡크롬그룰‡Krom\'Grul‡Krom\'Grul‡Krom\'Grul‡克罗格鲁尔‡克羅格魯爾',
    nil,
    'Recupere a Argola Nasal de Sha\'ni de Krom\'Grul e leve-a para Thal\'trak em Karrath. Procure nas várias cavernas e minas do Rochedo Malhorrendo.‡Заберите ноздревое кольцо Ша\'ни у Кром\'Грула и верните его Тал\'траку из Каргата. Обыщите различные пещеры и рудники скалы Молота Ужаса.‡Holt Sha\'nis Nasenring von Krom\'Grul zurück und bringt ihn zu Thal\'trak in Kargath. Durchsucht die verschiedenen Höhlen und Minen im Schreckensfels.‡크롬그룰에게서 샤니의 코걸이를 찾아 카르가스에 있는 탈트라크에게 가져가야 합니다. 우레망치 바위굴에 있는 여러 광산과 동굴을 찾아봐야 합니다.‡Recupera la alianza de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.‡Recupera el aro de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.‡Récupérer l’Anneau de nez de Sha\'ni sur Krom\'Grul, et le rapporter à Thal\'trak, à Kargath. Fouiller les différentes grottes et mines du Rocher des Cognepeurs.‡从克罗格鲁尔手中拿回沙妮的鼻环，把它还给卡加斯的萨特拉克。搜寻巨槌石的每一处山洞和矿井。‡從克羅格魯爾手中拿回沙妮的鼻環，把它還給卡加斯的薩特拉克。搜尋巨槌石的每壹處山洞和礦井。',
  }
},
[3823] = {
  -- Item
  '‡Зелье простой невидимости‡Geringer Unsichtbarkeitstrank‡하급 투명 물약‡Poción de invisibilidad inferior‡Poción de invisibilidad inferior‡Potion d\'invisibilité inférieure‡次级隐形药水‡次級隱形藥水',
  { -- Npc
    'Corredor Patalmas‡Светлолапый бегун‡Geisterpfotenläufer‡유령발늑대‡Corredor Fangarra‡Corredor Fangarra‡Coureur Patte-fantôme‡幽爪奔跑者‡幽爪奔跑者',
    nil,
  },
  nil,
  { -- Quest
    'Extinção dos Pirobuchos‡Угасание Огненного Чрева‡Die Feuermagenoger auslöschen‡불자루 오우거 처치‡El exterminio de los Ardentrañas‡El exterminio de los Pirontraña‡Exterminer les Brûlentrailles‡消灭火腹食人魔‡消滅火腹食人魔',
    nil,
    'Mate 15 Ogros-magos Pirobucho, 7 Ogros Pirobucho e 7 Brutamontes Ogros Pirobucho e fale novamente com Oralius quando terminar.‡Убейте 15 огров-магов, 7 огров и 7 громил из клана Огненного Чрева. По выполнении задания вернитесь к Орелиусу.‡Tötet 15 Ogermagier der Feuermägen, 7 Oger der Feuermägen sowie 7 Schläger der Feuermägen und kehrt zu Oralius zurück, wenn Ihr fertig seid.‡불자루일족 오우거마법사 15마리, 불자루 오우거 7마리, 불자루일족 투사 7마리를 처치한 후 랄리우스에게 돌아가야 합니다.‡Mata a 15 ogros magos Pirontraña, 7 ogros Pirontraña y 7 ogros brutos Pirontraña y vuelve junto a Oralius cuando hayas acabado.‡Mata a 15 magos ogros Pirontraña, 7 ogros Pirontraña y 7 ogros toscos Pirontraña.‡Tuer 15 Ogres-mages Brûlentrailles, 7 Ogres Brûlentrailles et 7 Brutes Brûlentrailles, puis retourner voir Oralius.‡杀掉15个火腹食人魔法师、7个火腹食人魔和7个火腹蛮兵，完成任务之后向奥拉留斯报告。‡殺掉15個火腹食人魔法師、7個火腹食人魔和7個火腹蠻兵，完成任務之後向奧拉留斯報告。',
  }
},
[3824] = {
  -- Item
  '‡Масло Тьмы‡Schattenöl‡암흑 오일‡Aceite de las Sombras‡Aceite de las Sombras‡Huile des ténèbres‡暗影之油‡暗影之油',
  { -- Npc
    'Patalmas Uivador‡Светлолапый ревун‡Geisterpfotenheuler‡긴울음 유령발늑대‡Aullador Fangarra‡Aullador Fangarra‡Hurleur Patte-fantôme‡幽爪嗥叫者‡幽爪嗥叫者',
    nil,
  },
  nil,
  { -- Quest
    'Gor\'tesh, o lorde dos brutamontes‡Гор\'теш Жестокий‡Gor\'tesh der Schläger-Lord‡포악한 군주 고르테쉬‡Gor\'tesh, el Señor bruto‡Gor\'tesh, el Señor de los toscos‡Le seigneur-brute Gor\'tesh‡蛮王戈泰什‡蠻王戈泰什',
    nil,
    'Encontre Gor\'tesh em algum lugar a oeste do Rochedo Malhorrendo. Mate Gor\'tesh e depois leve a Cabeça Decepada do Gor\'tesh de volta a Oralius nas Estepes Ardentes.‡Найдите Гор\'теша на западе от скалы Молота Ужаса. Убейте Гор\'теша и отнесите его голову Орелиусу в Пылающие степи.‡Sucht Gor\'tesh irgendwo im Westen des Schreckensfelsens. Tötet Gor\'tesh und bringt dann seinen abgehackten Kopf zu Oralius in der brennenden Steppe zurück.‡우레망치 바위굴의 서쪽 어딘가에서 고르테쉬를 찾아 처치하고 고르테쉬의 가면을 얻어 불타는 평원에 있는 랄리우스에게 가져가야 합니다.‡Encuentra a Gor\'tesh, en el algún lugar al oeste de la Roca Machacamiedo. Mata a Gor\'tesh y llévale entonces la cabeza cortada de Gor\'tesh a Oralius en Las Estepas Ardientes.‡Recoge la cabeza cortada de Gor\'tesh.‡Trouver Gor\'tesh, quelque part à l’ouest du rocher des Cognepeurs. Le tuer et rapporter la Tête coupée de Gor\'tesh à Oralius, dans les Steppes ardentes.‡找到戈泰什，他应该在巨槌石西面的某处。杀掉戈泰什并把他的头颅交给燃烧平原的奥拉留斯。‡找到戈泰什，他應該在巨槌石西面的某處。殺掉戈泰什並把他的頭顱交給燃燒平原的奧拉留斯。',
  }
},
[3825] = {
  -- Item
  '‡Эликсир стойкости‡Elixier der Seelenstärke‡인내의 비약‡Elixir de entereza‡Elixir de entereza‡Elixir de robustesse‡坚韧药剂‡堅韌藥劑',
  { -- Npc
    'Patalmas Alfa‡Светлолапый вожак‡Geisterpfotenalpha‡우두머리 유령발늑대‡Alfa Fangarra‡Alfa Fangarra‡Alpha Patte-fantôme‡幽爪前锋‡幽爪前鋒',
    nil,
  },
  -- Object
  '‡‡‡‡‡Ascuas ardientes‡‡‡',
  { -- Quest
    'A festa da cabeça cortada‡Голова огра на палочке = вечеринка‡Ogerkopf auf einem Pfahl = Party‡창에 꽂은 오우거 가면‡Una cabeza ogro empalada = FIESTA‡Una cabeza ogro empalada = FIESTA‡Une tête d\'ogre au bout d\'une pique = une fête‡枭首示众‡梟首示眾',
    nil,
    'Pegue a Cabeça Decepada do Gor\'Tesh e coloque no topo do Rochedo Malhorrendo. Procure um montinho de terra macia para espetar a estaca.‡Отнесите голову Гор\'теша на вершину скалы Молота Ужаса. Поищите кучу рыхлой земли и воткните в нее пику.‡Nehmt Gor\'teshs abgehackten Kopf und platziert ihn auf dem Gipfel des Schreckensfelsens. Sucht nach einem weichen Erdhügel, um den Pfahl aufzustellen.‡고르테쉬의 가면을 가지고 가서 우레망치 바위굴의 꼭대기에 꽂아야 합니다. 창을 꽂을 부드러운 흙으로 덮인 고분을 찾도록 하십시오.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Prendre la Tête coupée de Gor\'tesh et la placer au sommet du Rocher des Cognepeurs. Chercher un monticule de terre meuble pour planter la pique.‡把戈泰什的头颅放在巨槌石的山顶上。找一块软土堆把串着头颅的长矛插上去就可以了。‡把戈泰什的頭顱放在巨槌石的山頂上。找壹塊軟土堆把串著頭顱的長矛插上去就可以了。',
  }
},
