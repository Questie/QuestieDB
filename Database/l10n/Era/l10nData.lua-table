  nil,
  { -- Quest
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve o Composto Fuçalama para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите состав Грязного Рыла мастеру-аптекарю Фаранеллу в Подгород.‡Bringt das Morastschnauzengemisch zu Meisterapotheker Faranell in Undercity.‡언더시티에 있는 수석 연금술사 파라넬에게 진흙주둥이 합성물을 가져가야 합니다.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Apporter la Poudre de fangemufle au Maître Apothicaire Faranell à Undercity.‡把泥头花药交给幽暗城的大药剂师法拉尼尔。‡把泥頭花藥交給幽暗城的大藥劑師法拉尼爾。',
  }
},
[514] = {
  nil,
  { -- Npc
    'Ferreiro Argus‡Кузнец Аргус‡Schmied Argus‡대장장이 아거스‡Herrero Argus‡Herrero Argus‡Argus le forgeron‡铁匠阿古斯‡鐵匠阿格斯',
    'Ferreiro Profissional‡Подмастерье кузнеца‡Schmiedekunstgeselle‡수습 대장장이‡Oficial herrero‡Oficial herrero‡Forgeron - Compagnon‡初级铁匠‡鍛造訓練師',
  },
  nil,
  { -- Quest
    'Uma carta para Lançatroz‡Письмо Грозовой Вершине‡Brief an Stormpike‡스톰파이크에게 보내는 편지‡Una carta para Pico Tormenta‡Carta a Pico Tormenta‡Le maître des lettres‡铁炉堡的译码者‡鐵爐堡的譯碼者',
    nil,
    'Leve a Carta Habilmente Cifrada para o Prospector Lançatroz em Altaforja.‡Отнесите хитро зашифрованное письмо геологу Грозовой Вершине в Стальгорн.‡Bringt den geschickt verschlüsselten Brief zu Ausgrabungsleiter Stormpike nach Ironforge.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta muy bien cifrada al prospector Pico Tormenta a Forjaz.‡Lleva la carta cifrada con ingenio al prospector Pico Tormenta a Forjaz.‡Apporter la Lettre ingénieusement codée au Prospecteur Stormpike à Ironforge.‡把密码信带给铁炉堡的勘察员塔伯斯·雷矛。‡把密碼信帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[515] = {
  nil,
  { -- Npc
    'Murloc Saqueador‡Мурлок-налетчик‡Murlocräuber‡멀록 약탈꾼‡Asaltante múrloc‡Asaltante múrloc‡Ecumeur murloc‡鱼人袭击者‡魚人劫掠者',
    nil,
  },
  nil,
  { -- Quest
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve a Mistura Fuçalama, uma Poção Forte de Sangue de Troll, 5 Escamas de Espinhadaga e 5 Olhos de Rancapina para o Boticário Lindolfo, na Serraria Tarren.‡Отнесите микстуру Грязного Рыла, крепкое зелье тролльей крови, 5 чешуек нагов из клана Пронзающего Гребня и 5 глаз мурлоков из клана Рваный Плавник аптекарю Лидону в Мельницу Таррен.‡Bringt die Morastschnauzenmixtur, einen starken Trollbluttrank, 5 Säbelflossenschuppen und 5 Fetzenflossenaugen zu Apotheker Lydon nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 진흙주둥이 혼합물, 강한 재생의 물약, 비수가시일족의 비늘 5개, 그리고 너덜지느러미일족의 눈 5개를 가져가야 합니다.‡Lleva la mezcla de morrobarro, una poción fuerte de sangre de trol, 5 escamas de dagaespinazo y 5 ojos de rompeanca al boticario Lydon a Molino Tarren.‡Lleva la mezcla Morrobarro, una poción de sangre de trol fuerte, 5 escamas Espinadaga y 5 ojos de aleta rasgados al boticario Lydon a Molino Tarren.‡Apporter le Brouet de fangemufle, une Potion de sang de troll forte, 5 Ecailles de Daguéchine et 5 Yeux d\'Ailerons déchirés à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把泥头花水、1瓶强力巨魔之血药水、5块刺脊纳迦的鳞片和5颗碎鳍鱼人的眼球交给塔伦米尔的药剂师林度恩。‡把泥頭花水、1瓶強力巨魔之血藥水、5塊刺脊納迦的鱗片和5顆碎鰭魚人的眼球交給塔倫米爾的藥劑師林度恩。',
  }
},
[516] = {
