  nil,
  { -- Quest
    'Suprimentos dos Ferrofundo‡Припасы Железного рудника‡Irondeep-Vorräte‡깊은무쇠 광산 보급품‡Suministros de Ferrohondo‡Suministros de Ferrohondo‡Fournitures de Gouffrefer‡深铁矿洞的补给‡深鐵礦洞的補給',
    nil,
    'Leve 10 Suprimentos de Ferrofundo para o Intendente da Aliança em Dun Baldar.‡Принесите 10 припасов Железного рудника интенданту Альянса в Дун Болдар.‡Bringt 10 Irondeep-Vorräte zum Rüstmeister der Allianz in Dun Baldar.‡던 발다르에 있는 얼라이언스 병참장교에게 깊은무쇠 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 cajas de suministros de Ferrohondo al intendente de la Alianza en Dun Baldar.‡Lleva 10 suministros de Ferrohondo al intendente de la Alianza en Dun Baldar.‡Apporter 10 Fournitures de Gouffrefer à l’Intendant de l\'Alliance de Dun Baldar.‡把10份深铁矿洞补给品交给丹巴达尔的联盟军需官。‡把10份深鐵礦洞補給品交給丹巴達爾的聯盟軍需官。',
  }
},
