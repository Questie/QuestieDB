[5801] = {
  -- Item
  'Guano de Morcego‡Гуано летучей мыши Лабиринтов‡Kral-Guano‡가시덩굴 조분석‡Guano del Horado‡Guano del Horado‡Guano du kraal‡沼泽蝙蝠的粪便‡沼澤蝙蝠的糞便',
  nil,
  nil,
  { -- Quest
    'A forja do Pico Penacho de Fogo‡Кузня Пламенного хребта‡Feuerfeder geschmiedet‡불기둥 용광로‡La forja del Penacho en Llamas‡La forja del Penacho en Llamas‡Forgée dans la Fournaise‡火羽山‡火羽山',
    nil,
    'Leve o Molde de Chave-mestra e 2 Barras de Tório para o topo do Pico Penacho de Fogo, na Cratera Un\'Goro. Use o Molde de Chave-mestra no lago de lava para forjar a Chave-mestra Inacabada.|nLeve a Chave-mestra Inacabada para o Alquimista Arvignon no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Отнесите форму для отливки отмычек и 2 ториевых слитка на вершину Вулкана Огненного Венца в Кратере Ун\'Горо. Окуните форму для отливки отмычки в озеро лавы. Получится недоделанная отмычка.|nОтнесите недоделанную отмычку алхимику Арбингтону на Берег Промозглого Ветра в Западные Чумные земли.‡Bringt die Skelettschlüsselform und 2 Barren Thorium zur Spitze des Feuerfedergrats im Un\'Goro Krater. Benutzt die Skelettschlüsselform am Lavasee, um den unvollendeten Skelettschlüssel zu schmieden.|nBringt den unvollendeten Skelettschlüssel dann zum Alchimisten Arbington an der Chillwindspitze in den Westlichen Pestländern.‡운고로 분화구에 있는 불기둥 마루의 꼭대기로 해골 열쇠 거푸집과 토륨 주괴 2개를 가져가야 합니다. 용암의 강에서 해골 열쇠 거푸집을 이용해서 불완전한 해골 열쇠를 만들어야 합니다.|n불완전한 해골 열쇠를 서부 역병지대의 서리바람 거점에 있는 연금술사 알빙턴에게 가져가야 합니다.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto incompleta.|nLlévale la llave esqueleto incompleta al alquimista Arbington al Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.|nLlévale la llave esqueleto sin terminar al alquimista Arbington al Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Emporter le Moule de Clé squelette et 2 Barres de thorium au sommet de la crête de la Fournaise dans le cratère d’Un\'Goro. Utiliser le Moule de Clé squelette au lac de lave pour forger la Clé squelette inachevée.|nApporter la Clé squelette inachevée à l’alchimiste Arbington à la pointe du Noroît, dans les Maleterres de l’ouest.‡把骷髅钥匙模具和2块瑟银锭带到安戈洛尔环形山地区的火羽山顶部。在熔岩湖旁使用骷髅钥匙模具，铸造出一把未完工的骷髅钥匙。|n把未完工的骷髅钥匙交给西瘟疫之地冰风岗的化学家阿尔比顿。‡把骷髏鑰匙模具和2塊瑟銀錠帶到安戈洛爾環形山地區的火羽山頂部。在熔巖湖旁使用骷髏鑰匙模具，鑄造出壹把未完工的骷髏鑰匙。|n把未完工的骷髏鑰匙交給西瘟疫之地冰風崗的化學家阿爾比頓。',
  }
},
[5802] = {
  -- Item
  '‡Хрупкие детали машины‡Empfindliche Autoteile‡정밀한 부품‡Piezas de coches delicadas‡Piezas de coches delicadas‡Pièces de chariot fragiles‡精密赛车零件‡精密賽車零件',
  nil,
  nil,
  { -- Quest
    'A forja do Pico Penacho de Fogo‡Кузня Пламенного хребта‡Feuerfeder geschmiedet‡불기둥 용광로‡La forja del Penacho en Llamas‡La forja del Penacho en Llamas‡Forgée dans la Fournaise‡火羽山‡火羽山',
    nil,
    'Leve o Molde de Chave-mestra e 2 Barras de Tório para o topo do Pico Penacho de Fogo, na Cratera Un\'Goro. Use o Molde de Chave-mestra no lago de lava para forjar a Chave-mestra Inacabada.|nLeve a Chave-mestra Inacabada para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Отнесите форму для отливки отмычек и 2 ториевых слитка на вершину Вулкана Огненного Венца в Кратере Ун\'Горо. Окуните форму для отливки отмычки в озеро лавы. Получится недоделанная отмычка.|nОтнесите недоделанную отмычку аптекарю Дитерсу в Бастион, что в Западных Чумных землях.‡Bringt die Skelettschlüsselform und 2 Barren Thorium zur Spitze des Feuerfedergrats im Un\'Goro Krater. Benutzt die Skelettschlüsselform am Lavasee, um den unvollendeten Skelettschlüssel zu schmieden.|nBringt den unvollendeten Skelettschlüssel zu Apotheker Dithers im Bollwerk, Westliche Pestländer.‡운고로 분화구에 있는 불기둥 마루 꼭대기로 해골 열쇠 거푸집과 토륨 주괴 2개를 가져가야 합니다. 용암의 강에서 해골 열쇠 거푸집으로 불완전한 해골 열쇠를 만들어야 합니다.|n불완전한 해골 열쇠를 서부 역병지대의 보루에 있는 연금술사 디더스에게 가져가야 합니다.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.|nLlévale la llave esqueleto sin terminar al boticario Dithers a El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.|nLlévale la llave esqueleto sin terminar al boticario Dithers a El Baluarte, en las Tierras de la Peste del Oeste.‡Prendre le moule de la Clé squelette et deux barres de thorium au sommet de la crête de la Fournaise dans le cratère d\'Un\'Goro. Se servir du moule de la Clé squelette pour forger la Clé squelette inachevée.|nApporter la Clé squelette inachevée à l\'Apothicaire Dithers à la Barricade, Maleterres de l\'Ouest.‡把骷髅钥匙模具和2块瑟银锭带到安戈洛尔环形山地区的火羽山顶部。在熔岩湖旁使用骷髅钥匙模具，铸造出一把未完工的骷髅钥匙。|n把未完工的骷髅钥匙交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡把骷髏鑰匙模具和2塊瑟銀錠帶到安戈洛爾環形山地區的火羽山頂部。在熔巖湖旁使用骷髏鑰匙模具，鑄造出壹把未完工的骷髏鑰匙。|n把未完工的骷髏鑰匙交給西瘟疫之地亡靈壁壘的藥劑師迪瑟斯。',
  }
},
[5803] = {
  -- Item
  'Partícula de Pó Onírico‡Щепотка сонной пыли‡Körnchen Traumstaub‡꿈가루 한줌‡Pizca de polvo onírico‡Pizca de polvo onírico‡Grain de poussière de rêve‡梦境之尘‡幻夢之塵微粒',
  nil,
  nil,
  { -- Quest
    'O escaravelho de Araj‡Скарабей Араджи‡Arajs Skarabäus‡아라즈의 스카라베‡El escarabajo de Araj‡El escarabeo de Araj‡Le Scarabée d\'Araj‡阿拉基的圣甲虫‡阿拉基的聖甲蟲',
    nil,
    'Destrua Araj, o Evocador e leve o Escaravelho de Araj para o Alquimista Arvignon no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Убейте Аража Призывателя отнесите его скарабея алхимику Арбингтону на Берег Промозглого Ветра, что в Западных Чумных землях.‡Zerstört Araj den Beschwörer und bringt Arajs Skarabäus zum Alchimisten Arbington an der Chillwindspitze in den westlichen Pestländern.‡소환사 아라즈를 처치하고 아라즈의 스카라베를 서부 역병지대의 서리바람 거점에 있는 연금술사 알빙턴에게 돌아가야 합니다.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al alquimista Arbington en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al alquimista Arbington en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Vaincre Araj l\'Invocateur et apporter le Scarabée d\'Araj à l’alchimiste Arbington à la pointe du Noroît, dans les Maleterres de l’ouest.‡杀掉召唤者阿拉基，并将阿拉基的圣甲虫交给西瘟疫之地冰风岗的化学家阿尔比顿。‡殺掉召喚者阿拉基，並將阿拉基的聖甲蟲交給西瘟疫之地冰風崗的化學家阿爾比頓。',
  }
},
[5804] = {
  -- Item
  'Rumores Goblínicos‡Гоблинские сплетни‡Goblin-Gerüchte‡고블린의 소문‡Rumores goblin‡Rumores goblin‡Rumeurs gobelines‡地精的谣言‡哥布林的謠言',
  nil,
  nil,
  { -- Quest
    'O escaravelho de Araj‡Скарабей Араджи‡Arajs Skarabäus‡아라즈의 스카라베‡El escarabeo de Araj‡El escarabeo de Araj‡Le Scarabée d\'Araj‡阿拉基的圣甲虫‡阿拉基的聖甲蟲',
    nil,
    'Destrua Araj, o Evocador e leve o Escaravelho de Araj para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Убейте Аража Призывателя и отнесите его скарабея аптекарю Дитерсу в Бастион, что в Западных Чумных землях.‡Vernichtet Araj den Beschwörer und bringt Arajs Skarabäus zum Apotheker Dithers im Bollwerk, in den westlichen Pestländern.‡소환사 아라즈를 처치하고 아라즈의 스카라베를 서부 역병지대에 보루에 있는 연금술사 디더스에게 돌아가야 합니다.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Vaincre Araj l\'Invocateur et apporter le Scarabée d\'Araj à l’apothicaire Dithers à la Barricade, dans les Maleterres de l’ouest.‡杀掉召唤者阿拉基，并将阿拉基的圣甲虫交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡殺掉召喚者阿拉基，並將阿拉基的聖甲蟲交給西瘟疫之地亡靈壁壘的藥劑師迪瑟斯。',
  }
},
[5805] = {
