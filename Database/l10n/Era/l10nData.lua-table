[2518] = {
  nil,
  { -- Npc
    'Montanhista Swarth‡Горный пехотинец Смуглок‡Gebirgsjäger Swarth‡산악경비대 스와르트‡Montaraz Iraz‡Montaraz Iraz‡Montagnard Swarth‡巡山人斯瓦尔斯‡巡山人斯瓦爾斯',
    nil,
  },
  nil,
  { -- Quest
    'Lágrima da Lua‡Слезы Луны‡Tränen des Mondes‡달의 눈물‡Las lagrimas de la Luna‡Las lágrimas de la Luna‡Les larmes de la Lune‡月神的泪水‡月神的淚水',
    nil,
    'A Sacerdotisa A\'mura no Templo da Lua, em Darnassus, quer que você lhe traga as Fiandeiras Prateadas de Lady Sathrah.‡Жрица А\'моора из дарнасского храма Луны хочет, чтобы вы принесли ей серебряные паутинные железы леди Сатры.‡Priesterin A\'moora vom Tempel des Mondes in Darnassus möchte, dass Ihr ihr Lady Sathrahs silbrige Spinndrüsen bringt.‡다르나서스의 달의 신전에 있는 여사제 아무라가 여왕거미 사스라의 은빛 돌기를 가져다 달라고 부탁했습니다.‡La sacerdotisa A\'moora del Templo de la Luna de Darnassus quiere que le lleves las hilanderas plateadas de Lady Sathrah.‡La sacerdotisa A\'moora del Templo de la Luna quiere que lleves las hileras de plata de Lady Sathrah.‡Apporter les Filières d\'argent de dame Sathrah à la prêtresse A\'moora, au temple de la Lune, à Darnassus.‡达纳苏斯月神殿的女祭司艾茉拉让你把萨丝拉的银色丝囊交给她。‡達納蘇斯月神殿的女祭司艾茉拉讓妳把薩絲拉的銀色絲囊交給她。',
  }
},
[2519] = {
  -- Item
  '‡Тяжелый патрон‡Schweres Geschoss‡중형 탄환‡Perdigón pesado‡Perdigón pesado‡Balle lourde‡重弹丸‡重彈丸',
  { -- Npc
    'Kin\'weelay‡Кин\'вилай‡Kin\'weelay‡킨윌레이‡Kin\'weelay‡Kin\'weelay‡Kin\'weelay‡肯维雷‡肯維雷',
    nil,
  },
  nil,
  { -- Quest
    'O Templo da Lua‡Храм Луны‡Der Tempel des Mondes‡달의 신전‡El templo de la Luna‡El templo de la Luna‡Le Temple de la Lune‡月神殿‡月神殿',
    nil,
    'Irmã Aquinne quer que você fale com a Sacerdotisa A\'mura no Templo da Lua.‡Сестра Аквинна хочет, чтобы вы поговорили со жрицей А\'моорой из Храма Луны.‡Schwester Aquinne möchte, dass Ihr im Tempel des Mondes mit Priesterin A\'moora sprecht.‡수녀 아퀴네가 달의 신전에 있는 여사제 아무라와 대화할 것을 부탁했습니다.‡La hermana Aquinne quiere que hables con la sacerdotisa A\'moora en el Templo de la Luna.‡La hermana Aquinne quiere que hables con la sacerdotisa A\'moora en el Templo de la Luna.‡Sœur Aquinne veut que vous parliez à la prêtresse A\'moora, au temple de la Lune.‡艾奎恩妮让你和月神殿的女祭司艾茉拉谈一谈。‡艾奎恩妮讓妳和月神殿的女祭司艾茉拉談壹談。',
  }
},
