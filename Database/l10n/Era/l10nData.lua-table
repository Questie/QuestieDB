[3625] = {
  -- Item
  'Cabeça do Nek\'rosh‡Голова Некроша‡Nek\'roshs Kopf‡네크로쉬의 머리카락‡Cabeza de Nek\'rosh‡Cabeza de Nek\'rosh‡Tête de Nek\'rosh‡纳克罗什的头颅‡納克羅什的頭顱',
  { -- Npc
    'Rarck‡Рерк‡Rarck‡라륵크‡Rarck‡Rarck‡Rarck‡拉尔克‡拉爾克',
    'Mercadorias Diversas‡Потребительские товары‡Gemischtwaren‡일용품 상인‡Víveres‡Víveres‡Fournitures générales‡杂货商‡雜貨商',
  },
  nil,
  { -- Quest
    'Armamento vil de aszharita encantada‡Зачарованное азшаритовое оружие, отравленное Скверной‡Verzauberte Azsharit-Teufelswaffe‡마력이 깃든 아즈샤리트 퇴마 무기‡Armas Fel en Azsharita encantada‡Armas Fel en Azsharita encantada‡Armes Fel en Azsharite enchantée‡魔化艾萨拉水晶武器‡魔化艾薩拉水晶武器',
    nil,
    'Aguarde enquanto Galvan termina de forjar o armamento.‡Подождите, пока Гальван закончит отковывать оружие.‡Wartet, bis Galvan die Waffen fertig geschmiedet hat.‡갈반이 무기를 다 만들 때까지 기다려야 합니다.‡Espera que Galvan acabe de forjar las armas.‡Espera que Galvan acabe de forjar las armas.‡Attendre que Galvan ait fini de forger les armes.‡等待加尔文为你锻造武器。‡等待加爾文為妳鍛造武器。',
  }
},
[3626] = {
  -- Item
  'Cabeça do Barão Vardus‡Голова барона Вардуса‡Kopf von Baron Vardus‡바르두스 남작의 머리카락‡Cabeza del Barón Vardus‡Cabeza del Barón Vardus‡Tête du baron Vardus‡瓦杜斯男爵的头颅‡瓦杜斯男爵的頭顱',
  { -- Npc
    'Jerusa Lamego‡Дженн Лангстон‡Jenn Langston‡젠 랭스턴‡Jenn Langston‡Jenn Langston‡Jenn Langston‡吉恩·朗斯顿‡吉恩·朗斯頓',
    nil,
  },
  nil,
  { -- Quest
    'Retorno à Barreira do Inferno‡Возвращение в Выжженные земли‡Rückkehr in die verwüsteten Lande‡저주받은 땅으로의 귀환‡El regreso a Las Tierras Devastadas‡Regresa a Las Tierras Devastadas‡Retour aux Terres foudroyées‡返回诅咒之地‡返回詛咒之地',
    nil,
    'Fale novamente com o Herói Caído da Horda.‡Вернитесь к Павшему герою Орды.‡Kehrt zum Gefallenen Helden der Horde zurück.‡호드 영웅의 넋에게 돌아가야 합니다.‡Vuelve junto al Héroe Caído de la Horda.‡Vuelve junto al héroe caído de la Horda en el Cruce Lanzarrota, en el Pantano de las Penas.‡Retourner voir le Héros déchu de la Horde.‡回到部落英雄的灵魂那里。‡回到部落英雄的靈魂那裏。',
  }
},
[3627] = {
  -- Item
  'Presa de Ragash‡Клык Вагаша‡Fangzahn von Vagash‡바가쉬의 송곳니‡Colmillo de Vagash‡Colmillo de Vagash‡Croc de Vagash‡瓦加什的牙齿‡瓦加什的牙齒',
  { -- Npc
    'Érico Loreno‡Эрих Лохан‡Erich Lohan‡에리히 로한‡Erich Lohan‡Erich Lohan‡Erich Lohan‡埃瑞克·洛汉‡埃瑞許·洛漢',
    nil,
  },
  nil,
  { -- Quest
    'Restaurando o amuleto estilhaçado‡Воссоединить расколотый амулет‡Das zerbrochene Amulett vereinen‡조각난 아뮬렛 재결합‡Juntar pedazos del amuleto‡Juntar pedazos del amuleto‡Réunir les morceaux de l\'Amulette brisée.‡收集破碎的护符‡收集破碎的護符',
    nil,
    'Mate Grol, o Destruidor, Lady Sevine e o Arquimago Allistarj. De seus corpos, pegue o Amuleto de Grol, o Amuleto de Sevine e o Amuleto de Allistarj.|nLembre-se de usar o Armamento Vil de Azsharita Encantada para enfraquecer a tríade, pois só assim eles podem ser derrotados... mas use-o com sabedoria.‡Убейте Грола Разрушителя, леди Севину и верховного мага Аллистария. С их трупов заберите Амулет Грола, Амулет Севины и Амулет Аллистария.|nПомните о том, что нужно использовать зачарованное азшаритовое оружие, отравленное Скверной, чтобы ослабить троицу! Их нельзя убить иначе – но используйте оружие разумно...‡Tötet Grol den Zerstörer, Lady Sevine und Erzmagier Allistarj. Nehmt das Amulett von Grol, das Amulett von Sevine und das Amulett von Allistarj von ihren Leichen.|nDenkt daran, Eure Verzauberte Azsharit-Teufelswaffe zu BENUTZEN, um die Triade zu schwächen. Auf eine andere Weise können sie nicht getötet werden - aber verwendet sie weise ...‡파괴자 그롤, 여군주 세바인, 대마법사 알리스타즈를 해치우고 그들의 시체에서 그롤의 아뮬렛, 세바인의 아뮬렛, 알리스타즈의 아뮬렛을 회수해야 합니다.|n마력이 깃든 아즈샤리트 퇴마 무기를 사용하여 3인조의 힘을 약화시켜야 그들을 처치할 수 있다는 것을 명심하십시오. 반드시 현명하게 사용해야 합니다.‡Mata a Grol el Destructor, a Lady Sevine y al archimago Allistarj. De sus cadáveres coge el amuleto de Grol, el amuleto de Sevine y el amuleto de Allistarj.|nAcuérdate de USAR tus armas viles de azsharita encantada para debilitar a la tríade. Es la única forma de matarlos, pero úsalas con moderación...|n‡Mata a Grol el Destructor, a Lady Sevine y al archimago Allistarj. De sus cadáveres coge el amuleto de Grol, el amuleto de Sevine y el amuleto de Allistarj.|nAcuérdate de USAR tus armas viles de azsharita encantada para debilitar a la tríade. Es la única forma de matarlos, pero úsalas con moderación...‡Assassiner Grol le Destructeur, dame Sevine et l\'archimage Allistarj. Prendre sur leurs cadavres l\'Amulette de Grol, l\'Amulette de Sevine et l\'Amulette d\'Allistarj.|nUTILISER les armes Fel en Azsharite enchantée pour affaiblir la triade (ils ne peuvent pas être tués autrement), mais les utiliser sagement...‡杀掉毁灭者戈洛尔、瑟温妮，以及大法师奥利斯塔。从他们到尸体上拿到戈洛尔的护符、瑟温妮的护符和奥利斯塔的护符。|n记住使用你的魔化艾萨拉水晶武器来削弱他们，否则他们是无法被杀死的——你必须小心谨慎地使用你的武器……‡殺掉毀滅者戈洛爾、瑟溫妮，以及大法師奧利斯塔。從他們到屍體上拿到戈洛爾的護符、瑟溫妮的護符和奧利斯塔的護符。|n記住使用妳的魔化艾薩拉水晶武器來削弱他們，否則他們是無法被殺死的——妳必須小心謹慎地使用妳的武器……',
  }
},
[3628] = {
  -- Item
  'Mão de Flávio Lúcio‡Рука Декстрена Варда‡Hand von Dextren Ward‡덱스트렌 워드의 장갑‡Mano de Dextren Ward‡Mano de Dextren Ward‡Main de Dextren Ward‡迪克斯特·瓦德的手掌‡迪克斯特·瓦德的手掌',
  { -- Npc
    'Estêvão Loreno‡Стивен Лохан‡Steven Lohan‡스티븐 로한‡Steven Lohan‡Steven Lohan‡Steven Lohan‡史蒂文·洛汉‡史蒂文·洛漢',
    '‡Хозяйка таверны‡Gastwirtin‡여관주인‡Tabernero‡Tabernero‡Aubergiste‡旅店老板‡旅店老闆',
  },
  nil,
  { -- Quest
    'Você é Rakh\'likh, demônio‡Ты – Рах\'лих, демон!‡Ihr seid Rakh\'likh, Dämon‡악마 라크리크와의 대결‡Eres Rakh\'likh, demonio‡Eres Rakh\'likh, demonio‡Vous êtes Rakh\'likh, démon‡恶魔拉瑟莱克‡惡魔拉瑟萊克',
    nil,
    'Destrua Razelikh, o Profanador, e leve o Chifre Decepado de Profanador para o Herói Caído da Horda. Você também terá que devolver a Proteção do Profanador para que o Herói Caído a destrua, impedindo-a de cair em mãos erradas.‡Уничтожьте Разелиха Осквернителя и вернитесь к Павшему герою Орды с Отрубленным Рогом Осквернителя. Вам также понадобится вернуть Оберег Осквернителя, чтобы Павший герой мог уничтожить его, дабы оберег не попал к тому, кто использует его во зло.‡Vernichtet Razelikh den Entweiher und bringt das abgespaltene Horn des Entweihers zum Gefallenen Helden der Horde. Ihr müsst außerdem den Zauberschutz des Entweihers mit zurückbringen, damit der Gefallene Held ihn zerstören und somit verhindern kann, dass er jemals in die falschen Hände fällt.‡파멸자 라젤리크를 해치우고 파멸자의 부러진 뿔을 호드 영웅의 넋에게 가져가야 합니다. 파멸자의 수호물도 호드 영웅의 넋에게 돌려주어 파괴하도록 해야 합니다. 그래야 사악한 자들의 손에 들어가는 것을 막을 수 있습니다.‡Destruye a Razelikh el Rapiñador y llévale el cuerno cercenado del Rapiñador al Héroe Caído de la Horda. También tendrás que devolver el protector del Rapiñador para que el Héroe Caído pueda destruirlo y así impedir que caiga en las manos equivocadas.‡Destruye a Razelikh el Rapiñador y llévale el cuerno de Rapiñador cortado al héroe caído de la Horda. También tendrás que devolver el Resguardo del Rapiñador para que el héroe caído pueda destruirlo y así impedir que caiga en las manos equivocadas.‡Détruire Razelikh le Souilleur et apporter la Corne brisée du Souilleur au Héros déchu de la Horde. Rendre aussi l\'Amulette du Souilleur au Héros Déchu pour qu\'il puisse la détruire, afin de l\'empêcher de tomber dans de mauvaises mains.‡消灭污染者拉瑟莱克，将污染者之角交给部落英雄的灵魂。另外你还要把污染者防护结界交给他，这样部落英雄的灵魂就可以消灭它，以避免它落入邪恶势力之手。‡消滅汙染者拉瑟萊克，將汙染者之角交給部落英雄的靈魂。另外妳還要把汙染者防護結界交給他，這樣部落英雄的靈魂就可以消滅它，以避免它落入邪惡勢力之手。',
  }
},
[3629] = {
  -- Item
  'Anel da Família Brumanto‡Фамильное кольцо Мисмантла‡Ring der Familie Mistmantle‡미스트맨틀 가문의 반지‡Anillo de la familia Mantoniebla‡Anillo de la familia Mantoniebla‡Chevalière des Mistmantle‡密斯特曼托家族戒指‡密斯特曼托家族戒指',
  { -- Npc
    'Davi Lamego‡Давид Лангстон‡David Langston‡데이비드 랭스턴‡David Langston‡David Langston‡David Langston‡大卫·朗斯顿‡大衛·朗斯頓',
    nil,
  },
  nil,
  { -- Quest
    'Engenharia goblínica‡Гоблинское инженерное дело‡Goblin-Ingenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡地精工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите узнать больше о гоблинском инженерном деле, отнесите справочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Goblin-Ingenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunst-Disziplinen zu Nixx Sprocketspring nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más sobre ingeniería gnoma, lleva el Manual de disciplinas de ingeniería a Nixx Muellepiñón en Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Pour en apprendre davantage sur l\'Ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Sprocketspring dans Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果妳想要對地精工程學有更多了解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3630] = {
  -- Item
  'Cabeça de Targorr‡Голова Таргорра‡Targorrs Kopf‡타고르의 머리카락‡Cabeza de Targorr‡Cabeza de Targorr‡Tête de Targorr‡塔格尔的头颅‡塔高爾的頭顱',
  { -- Npc
    'Espiríleo Anormal‡Загадочный крылозмей‡Deviatwinder‡돌연변이 뱀꼬리천둥매‡Volutador descarriado‡Volutador descarriado‡Embobineur déviant‡变异曲蛇‡變異曲蛇',
    nil,
  },
  nil,
  { -- Quest
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomen-Ingenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡侏儒工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa em Altaforja.‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomen-Ingenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunst-Disziplinen zu Tüftlermeister Overspark nach Ironforge.‡노움 기계공학에 대해 더 배우고자 한다면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más sobre ingeniería gnoma, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Overspark, à Ironforge.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果妳想要對侏儒工程學有更多了解，就把工程學教材交給鐵爐堡的工匠大師歐沃斯巴克。',
  }
},
[3631] = {
  -- Item
  'Presa de Ronquifuça‡Клык кабана Грубобрюха‡Stopfwansts Hauer‡서리먹보의 어금니‡Colmillo de Panzallena‡Colmillo de Panzallena‡Défense de Fouailleventre‡贝利格拉布的獠牙‡貝利格拉布的獠牙',
  { -- Npc
    'Cravaçoite Anormal‡Загадочный жалохлест‡Deviatdornenpeitscher‡돌연변이 독침천둥매‡Latigador con aguijón descarriado‡Latigador con aguijón descarriado‡Aiguillonneur déviant‡变异刺鞭蛇‡變異刺鞭蛇',
    nil,
  },
  nil,
  { -- Quest
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un malignoecus‡Invoca un corcel vil‡Invoquer un Palefroi corrompu‡召唤地狱战马‡召喚地獄戰馬',
    nil,
    'Fale com Strahad Farsan nos Sertões.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan im Brachland.‡불모의 땅에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Los Baldíos.‡Habla con Strahad Farsan en Los Baldíos.‡Parler à Strahad Farsan, dans les Tarides.‡与贫瘠之地棘齿城的斯坦哈德·法尔杉谈一谈。‡與貧瘠之地棘齒城的斯坦哈德·法爾杉談壹談。',
  }
},
[3632] = {
  -- Item
  'Pata de Mordente‡Лапа Фангора‡Fangors Tatze‡붉은송곳니의 앞발‡Pata de Fangore‡Pata de Fangore‡Patte de Fangore‡范高雷的爪子‡范高雷的爪子',
  { -- Npc
    'Rastejante Anormal‡Загадочный ползун‡Deviatkrabbler‡돌연변이 줄무늬랩터‡Trepador descarriado‡Trepador descarriado‡Rampant déviant‡变异爬行者‡變異爬行者',
    nil,
  },
  nil,
  { -- Quest
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomen-Ingenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡侏儒工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa em Altaforja.‡Возьмите Справочник по инженерным дисциплинам и отнесите его мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomen-Ingenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunst-Disziplinen zu Tüftlermeister Overspark nach Ironforge.‡노움 기계공학에 대해 더 알고 싶으면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre el tema, llévale el Manual de disciplinas de ingeniería aI maestro manitas Sobrechispa a Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Overspark, à Ironforge.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果妳想要對侏儒工程學有更多了解，就把工程學教材交給鐵爐堡的工匠大師歐沃斯巴克。',
  }
},
[3633] = {
  -- Item
  'Cabeça de Gath\'Ilzogg‡Голова Гат\'Илзогга‡Garth\'Ilzoggs Kopf‡가스일조그의 머리카락‡Cabeza de Gath\'Ilzogg‡Cabeza de Gath\'Ilzogg‡Tête de Gath\'Ilzogg‡加塞尔佐格的头颅‡加塞爾佐格的頭顱',
  { -- Npc
    'Matador Anormal‡Загадочный душегуб‡Deviattöter‡돌연변이 식인랩터‡Destripador descarriado‡Destripador descarriado‡Tueur déviant‡变异屠戮者‡變異屠戮者',
    nil,
  },
  nil,
  { -- Quest
    'Engenharia goblínica‡Гоблинское инженерное дело‡Goblin-Ingenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡地精工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите узнать о гоблинском инженерном деле, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Goblin-Ingenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunst-Disziplinen zu Nixx Sprocketspring nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más cosas sobre la ingeniería de los goblins, lleva el Manual de disciplinas de ingeniería a Nixx Muellepiñón en Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan, en Tanaris.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Sprocketspring, à Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果妳想要對地精工程學有更多了解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
