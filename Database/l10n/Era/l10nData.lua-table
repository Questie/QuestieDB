  nil,
  { -- Quest
    'Trol\'kalar‡Трол\'калар‡Trol\'kalar‡트롤칼라‡Trol\'kalar‡Trol\'kalar‡Trol\'kalar‡托卡拉尔‡托卡拉爾',
    nil,
    'Recupere Trol\'kalar de dentro da tumba de Matatroll, em Stromgarde.‡Достаньте Трол\'калар из могилы Троллебоя в Стромгарде.‡Holt Trol\'kalar aus Trollbanes Grabmal in Stromgarde.‡스트롬가드에 있는 트롤베인의 무덤에서 트롤칼라를 가지고 와야 합니다.‡Recupera la espada Trol\'kalar de la Tumba de Aterratrols en Stromgarde.‡Recupera la espada Trol\'kalar de la Tumba de Aterratrols en Stromgarde.‡Retirer Trol\'kalar de la tombe de Trollbane à Stromgarde.‡从激流堡的托尔贝恩墓室中取回托卡拉尔剑。‡從激流堡的托爾貝恩墓室中取回托卡拉爾劍。',
  }
},
[646] = {
  nil,
  { -- Npc
    'Sr. Castiga‡Мистер Каюк‡Mr. Smite‡미스터 스마이트‡Don Mamporro‡Don Mamporro‡M. Smite‡重拳先生‡重拳先生',
    'Imediato do Navio‡Первый помощник капитана‡Der Erste Maat‡일등항해사‡El contramaestre del barco‡El contramaestre del barco‡Le premier officier du navire‡船上的大副‡船上的大副',
