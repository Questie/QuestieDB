[5092] = {
  -- Item
  'Varinha de Crinavalha Carbonizada‡Обгоревший жезл Иглогривых‡Verkohlter Grimmhauerzauberstab‡서슬갈기일족의 불타는 마법봉‡Varita Crines de Acero carbonizada‡Varita Crines de Acero carbonizada‡Baguette Tranchecrin carbonisée‡烧焦的钢鬃魔杖‡燒焦的鋼鬃魔杖',
  { -- Npc
    'Guarda Lana‡Стражник Лана‡Wache Lana‡경비병 라나‡Guardia Lana‡Guardia Lana‡Garde Lana‡卫兵拉娜‡衛兵拉娜',
    nil,
  },
  nil,
  { -- Quest
    'Abrindo caminho‡Зачистка территории‡Den Weg räumen‡통로 확보‡Despejando el camino‡Despejar el camino‡Nettoyer le passage‡扫清道路‡掃清道路',
    nil,
    'Mate 10 Esfoladores Descarnados e 10 Carniçais Salivantes na Colina do Pesar.|nFale novamente com o Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Убейте 10 скелетов-свежевателей и 10 слюнявых вурдалаков на холме Печали.|nВернитесь к командиру Ашламу Отважному Кулаку в лагерь Промозглого Ветра в Западных Чумных землях.‡Tötet 10 Skelettschinder und 10 sabbernde Ghuls in Sorrow Hill.|nKehrt zu Kommandant Ashlam Valorfist an der Chillwindspitze, Westliche Pestländer, zurück.‡슬픔의 언덕에 있는 해골 타작꾼 10마리와 걸신들린 구울 10마리를 처치해야 합니다.|n그런 다음 서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 돌아가십시오.‡Mata 10 despellejadores esqueléticos y 10 necrófagos esclavizantes en la Colina de las Penas.|nVuelve con el comandante Ashlam Puñovalor en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Mata 10 despellejadores esqueléticos y 10 necrófagos esclavizantes en la Colina de las Penas.|nVuelve con el comandante Ashlam Puñovalor en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Tuer 10 Ecorcheurs Squelettes et 10 Goules écumantes sur la Colline des chagrins.|nRetourner auprès du commandant Ashlam Valorfist au camp du Noroît, dans les Maleterres de l’ouest.‡杀掉悔恨岭中的10个骷髅剥皮者和10个被奴役的食尸鬼。|n然后向西瘟疫之地冰风岗的指挥官阿什拉姆·瓦罗菲斯特复命。‡殺掉悔恨嶺中的10個骷髏剝皮者和10個被奴役的食屍鬼。|n然後向西瘟疫之地冰風崗的指揮官阿什拉姆·瓦羅菲斯特復命。',
  }
},
[5093] = {
