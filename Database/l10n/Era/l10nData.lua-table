[5926] = {
  nil,
  { -- Npc
    'Totem de Resistência ao Gelo‡Тотем сопротивления льду‡Totem des Frostwiderstands‡냉기 저항 토템‡Tótem de resistencia a la escarcha‡Tótem de resistencia a la escarcha‡Totem de résistance au Givre‡抗寒图腾‡抗寒圖騰',
