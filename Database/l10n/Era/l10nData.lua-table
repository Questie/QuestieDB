[309] = {
  nil,
  { -- Npc
    '‡‡‡‡‡‡‡‡羅爾夫的屍體',
    nil,
  },
  -- Object
  '‡Старая Наковальня‡Ambossar‡앤빌마‡Yunquemar‡Yunquemar‡Courbenclume‡安威玛尔‡安威瑪',
  { -- Quest
    'Em defesa do carregamento‡Охрана груза‡Beschützen der Fracht‡화약 운반‡Proteger el envío‡Proteger el envío‡Protection de la cargaison‡护送货物‡護送貨物',
    nil,
    'Garanta que Miran e o carregamento cheguem ao sítio de escavação, depois informe ao Prospector Bandaferro.‡Убедитесь, что Миран и его груз добрались до раскопа, и сообщите об этом геологу Сталекруту.‡Stellt sicher, dass sowohl Miran als auch seine Warenlieferung sicher an der Ausgrabungsstätte ankommen und setzt dann Ausgrabungsleiter Ironband davon in Kenntnis.‡미란이 발굴 지역까지 무사히 도착할 수 있도록 경호하고 발굴조사단장 아이언밴드에게 가십시오.‡Asegúrate de que Miran y la pólvora llegan a la excavación y luego informa al prospector Vetaferro.‡Asegúrate de que Miran y el cargamento lleguen al sitio de excavación; luego infórmale al Prospector Vetaferro.‡S\'assurer que Miran et la cargaison parviennent au Site de fouilles puis en informer le Prospecteur Ironband.‡确保把米兰和货物送到挖掘场，然后通知勘察员基恩萨·铁环。‡確保把米蘭和貨物送到挖掘場，然後通知勘察員基恩薩·鐵環。',
  }
},
[310] = {
  nil,
  nil,
  -- Object
  '‡Стальгорн‡Eisenschmiede‡아이언포지‡Forjaz‡Forjaz‡Forgefer‡铁炉堡‡鐵爐堡',
  { -- Quest
    'A guerra das cervejas‡Злейшие соперники‡Bittere Rivalen‡숙명의 경쟁자‡Cerveza rivales‡Rivales acérrimos‡Bières rivales‡针锋相对‡針鋒相對',
    nil,
    'Troque um barril de Cerveja do Trovão por um barril de Grogue Cervevada no porão da Destilaria Cervaforte, que fica em Kharanos.‡Замените один бочонок громового эля бочонком жгучего пива Ячменоваров в подвале "Громоварки" в Караносе.‡Vertauscht im Keller der Brauerei Donnerbräu in Kharanos ein Fass Donnerbier mit einem Fass Gerstenbräu.‡카라노스에 있는 썬더브루 양조장의 지하실로 가서 썬더 에일 맥주통을 발리브루 스칼더 맥주통으로 바꿔 놓아야 합니다.‡Ve al sótano de la Destilería Cebatruenos de Kharanos y sustituye un barril de cerveza del Trueno con uno de brebaje de Cebadiz.‡Ve al sótano de la Destilería Cebatruenos de Kharanos y sustituye un barril de cerveza del Trueno con uno de brebaje de Cebadiz.‡Aller au sous-sol de la distillerie Thunderbrew à Kharanos et remplacer un Tonneau de Thunder Ale par un Tonneau de Barleybrew Scalder.‡到卡拉诺斯的雷酒酿造厂酒窖里去，把一桶雷霆啤酒换成热麦酒。‡到卡拉諾斯的雷酒釀造廠酒窖裏去，把壹桶雷霆啤酒換成熱麥酒。',
  }
},
[311] = {
  nil,
  { -- Npc
    'Noel Figueira‡Свен Йорген‡Sven Yorgen‡스벤 요르겐‡Sven Yorgen‡Sven Yorgen‡Sven Yorgen‡斯温·约根‡斯溫·猶根',
    nil,
  },
  -- Object
  '‡Лок Модан‡‡모단 호수‡‡Loch Modan‡‡洛克莫丹‡洛克莫丹',
  { -- Quest
    'Fale novamente com Marleth‡Возвращение к Марлетте‡Rückkehr zu Marleth‡말레스에게 돌아가기‡Vuleve con Marleth‡Regresa junto a Marleth‡Retour chez Marleth‡向马莱斯回报‡向馬萊斯回報',
    nil,
    'Entregue o barril de Cerveja do Trovão para Marleth Cervevada na Aldeia da Cevada.‡Принесите бочонок громового эля Марлетте Ячменовар в Поселок Пивоваров.‡Bringt Marleth Gerstenbräu in Brewnall das Fass mit Donnerbier.‡브루날 마을에 있는 말레스 발리브루에게 썬더 에일 맥주통을 가져다주어야 합니다.‡Lleva el barril de cerveza del Trueno a Marleth Cebadiz a Las Birras.‡Lleva el barril de cerveza del Trueno a Marleth Cebadiz a Las Birras.‡Apporter le Tonneau de Thunder Ale à Marleth Barleybrew au Village de Brassetout.‡把雷霆麦酒交给烈酒村的马莱斯·麦酒。‡把雷霆麥酒交給烈酒村的馬萊斯·麥酒。',
  }
},
[312] = {
  nil,
  nil,
  -- Object
  '‡Каранос‡‡카라노스‡‡Kharanos‡‡卡拉诺斯‡卡拉諾斯',
  { -- Quest
    'Por baixo da carne-seca‡Ограбление тайника Тундры Макгранна‡Tundra MacGranns gestohlene Vorräte‡툰드라 맥그란의 고기 상자‡La reserva robada de Tundra MacGrann‡La reserva robada de Tundra MacGrann‡La réserve volée de Tundra MacGrann‡马克格拉恩的干肉‡馬克格拉恩的幹肉',
    nil,
    'Pegue de volta a carne-seca do Tundra MacGrann do armário de carnes roubado, na caverna do Velho Barbafria.‡Добудьте из пещеры Старого Ледоборода вяленое мясо из краденого ларя Тундры Макгранна.‡Holt Tundra MacGranns Trockenfleisch aus dem gestohlenen Fleisch-Spind in der Höhle von Eisbart dem Alten.‡늙은 얼음수염의 동굴에 있는 잃어버린 고기 상자에서 툰드라 맥그란의 말린 고기를 되찾아 와야 합니다.‡Ve a la cueva del Viejo Barbahielo y recupera la carne seca de Tundra MacGrann de la caja fuerte robada.‡Ve a la cueva del Viejo Barbahielo y recupera la carne seca de Tundra MacGrann de la caja fuerte robada.‡Récupérer la caisse de viande séchée de Tundra MacGrann dans la Caverne du Vieux Barbeglace.‡从冰须的洞穴里拿回装有马克格拉恩的干肉的储藏柜。‡從冰須的洞穴裏拿回裝有馬克格拉恩的幹肉的儲藏櫃。',
  }
},
[313] = {
  nil,
  { -- Npc
    'Teócrito‡Теокрит‡Theocritus‡테오크리투스‡Theocritus‡Theocritus‡Theocritus‡塞欧克瑞图斯‡塞歐克瑞圖斯',
    'Mago da Torre Azora‡Маг башни Азоры‡Magier des Turms von Azora‡아조라 탑의 마법사‡Mago de la Torre de Azora‡Mago de la Torre de Azora‡Mage de la tour d\'Azora‡阿祖拉之塔的法师‡阿祖拉之塔的法師',
  },
  -- Object
  '‡Старая Наковальня‡Ambossar‡앤빌마‡Yunquemar‡Yunquemar‡Courbenclume‡安威玛尔‡安威瑪',
  { -- Quest
    'O Covil Cinzento‡Серая берлога‡Der altgediente Bau‡은빛 동굴‡El Cubil Pardo‡El Cubil Pardo‡L\'antre Gris‡灰色洞穴‡灰色洞穴',
    nil,
    'Colete 8 Crinas de Wendigo e leve-as para Piloto Marchapedra.‡Принесите 8 грив вендиго пилоту Камнекожцу.‡Sammelt 8 Wendigomähnen und bringt sie Pilot Stonegear.‡웬디고 갈기 8개를 모아 조종사 스톤기어에게 가져다주어야 합니다.‡Reúne 8 crines de wendigo y llévaselas al piloto Roscapiedra.‡Recoge 8 crines de wendigo y llévaselas al piloto Roscapiedra.‡Réunir 8 Peaux de Wendigo et les apporter au Pilote Stonegear.‡收集8束雪怪的鬃毛，把它们交给驾驶员迪恩·石轮。‡收集8束雪怪的鬃毛，把它們交給駕駛員迪恩·石輪。',
  }
},
[314] = {
  nil,
  { -- Npc
    'Elisa‡Элиза‡Eliza‡엘리자‡Eliza‡Eliza‡Eliza‡伊莉莎‡伊莉莎',
    'Noiva do Embalsamador‡Невеста Бальзамировщика‡Braut des Einbalsamierers‡장의사의 신부‡Novia del embalsamador‡Novia del embalsamador‡La fiancée de l\'Embaumeur‡藏尸者的妻子‡藏屍者的妻子',
  },
  -- Object
  '‡Стальгорн‡Eisenschmiede‡아이언포지‡Forjaz‡Forjaz‡Forgefer‡铁炉堡‡鐵爐堡',
  { -- Quest
    'Amarre sua cabra pois Ragash está solto‡Защита стада‡Die Herde beschützen‡가축 보호‡La protección del rebaño‡La protección del rebaño‡Protection du troupeau‡保护牲畜‡保護牲畜',
    nil,
    'Rudra Ambarmanso quer que você mate Ragash e leve sua presa para ela no rancho dos carneiros.‡Убейте Вагаша и принесите его клык Рудре Янтарлен на Бараний выгон.‡Rudra Amberstill möchte, dass Ihr Vagash erschlagt und einen seiner Fangzähne zu ihr auf die Widder-Ranch bringt.‡루드라 앰버스틸이 바가쉬를 처치한 후 산양 농장으로 바가쉬의 송곳니를 가지고 오라고 부탁했습니다.‡Rudra Semperámbar quiere que mates a Vagash y le lleves su colmillo a la granja de carneros.‡Rudra Semperámbar quiere que mates a Vagash y le lleves su colmillo a la granja de carneros.‡Sur demande de Rudra Amberstill, tuer Vagash et rapporter un de ses crocs à la ferme des Amberstill.‡山羊农场的鲁德拉·冻石要你杀了瓦加什，并且把它的牙齿给她带回去。‡山羊農場的魯德拉·凍石要妳殺了瓦加什，並且把它的牙齒給她帶回去。',
  }
},
[315] = {
  nil,
  { -- Npc
    'Galvão Brumanto‡Сталван Мистмантл‡Stalvan Mistmantle‡스탈반 미스트맨틀‡Stalvan Mantoniebla‡Stalvan Mantoniebla‡Stalvan Mistmantle‡斯塔文·密斯特曼托‡斯塔文·密斯特曼托',
    nil,
