  nil,
  { -- Quest
    'Preparado de Zanzil e Cerveja Escura do Tonto‡Смесь Занзила и "Дурацкое Крепкое"‡Zanzils Mixtur und Fools Starkbier‡잔질의 혼합물과 멍텅구리 스타우트 맥주‡La mezcla y cerveza de tontos de Zanzil‡La mezcla de Zanzil y la cerveza de tontos‡La bière du sot‡赞吉尔的药剂和蠢人酒‡贊吉爾的藥劑和蠢人酒',
    nil,
    'Leve a Cerveja Escura do Tonto para Kravel no Salar Cintilante.‡Отнесите "Дурацкое Крепкое" Крейвелу на Мерцающую равнину.‡Bringt Fools Starkbier zu Kravel in der schimmernden Ebene zurück.‡소금 평원의 크레이블에게 멍텅구리 스타우트 맥주를 가지고 돌아가야 합니다.‡Llévale la cerveza de tontos a Kravel, que está en El Desierto de Sal.‡Regrésale la cerveza de tontos a Kravel en el Desierto de Sal.‡Rapporter la Bière du sot à Kravel, aux Salines.‡把蠢人酒交给克拉维尔。‡把蠢人酒交給克拉維爾。',
  }
},
[1120] = {
  nil,
  { -- Npc
    'Troll Jubafria‡Тролль из племени Мерзлогривов‡Troll der Frostmane‡서리갈기트롤‡Trol Peloescarcha‡Trol Peloescarcha‡Troll Frostmane‡霜鬃巨魔‡霜鬃食人妖',
    nil,
  },
  nil,
  { -- Quest
    'Deixe os gnomos bêbados‡Напоить гномов‡Die Gnome betrunken machen‡노움 취하게 하기‡Emborrachar a los gnomos‡Emborrachar a los gnomos‡Saoulez les gnomes‡灌醉侏儒‡灌醉侏儒',
    nil,
    'Leve a Cerveja Escura do Tonto para o Chefe dos Boxes Gnomo.‡Отнесите "Дурацкое Крепкое" начальнику гномского гаража.‡Bringt Fools Starkbier zum Gnomen-Boxenboss.‡노움 정비주임에게 멍텅구리 스타우트 맥주를 가져가야 합니다.‡Llévale la cerveza de tontos al jefe técnico de los gnomos.‡Lleva la cerveza de tontos al encargado de foso gnomo.‡Apporter la bière du Sot au Chef-mécanicien gnome.‡把蠢人酒带给侏儒车队老板。‡把蠢人酒帶給侏儒車隊老板。',
  }
},
[1121] = {
  -- Item
  '‡Рысьи лапы‡Füße des Luchses‡스라소니 장화‡Patas de lince‡Patas de lince‡Pattes du Lynx‡山猫之靴‡山貓之足',
  { -- Npc
    'Marchaneve Jubafria‡Снегоброд из племени Мерзлогривов‡Schneeschreiter der Frostmane‡서리갈기부족 길잡이‡Zancanieve Peloescarcha‡Zancanieve Peloescarcha‡Marche-neige Frostmane‡霜鬃雪行者‡霜鬃雪行者',
    nil,
  },
  nil,
  { -- Quest
    'Deixe os goblins bêbados‡Напоить гоблинов‡Die Goblins betrunken machen‡고블린 취하게 하기‡Emborrachar a los goblin‡Emborrachar a los goblins‡Saoulez les gobelins‡灌醉地精‡灌醉地精',
    nil,
    'Leve a Cerveja Escura do Tonto para o Chefe dos Boxes Goblin.‡Отнесите "Дурацкое Крепкое" начальнику гоблинского гаража.‡Bringt Fools Starkbier zum Goblin-Boxenboss.‡고블린 정비주임에게 멍텅구리 스타우트 맥주를 가져가야 합니다.‡Llévale la cerveza de tontos al jefe técnico de los goblins.‡Lleva la cerveza de tontos al encargado de foso goblin.‡Apporter la bière du sot au Chef-mécanicien gobelin.‡把蠢人酒交给地精车队老板。‡把蠢人酒交給地精車隊老板。',
  }
},
[1122] = {
  nil,
  { -- Npc
    'Esfolador Jubafria‡Шкуродер из племени Мерзлогривов‡Balgabzieher der Frostmane‡서리갈기부족 무두장이‡Desollador Peloescarcha‡Desollador Peloescarcha‡Ecorcheur Frostmane‡霜鬃剥皮者‡霜鬃剝皮者',
    nil,
  },
  nil,
  { -- Quest
    'Fale novamente com Mirrabolha‡Возвращение к Пуззыриксу‡Meldet Euch bei Fizzlebub‡피즐버브에게 돌아가기‡Volver a informar a Pinchabujas,‡Volver a informar a Pinchabujas‡Le compte rendu à Fizzlebub‡向菲兹巴布报告‡向菲茲巴布報告',
    nil,
    'Leve o relatório sobre a Cerveja Escura do Tonto para Cranque Mirrabolha na Angra do Butim.‡Отнесите отчет о "Дурацком Крепком" Шиззи Пуззыриксу в Пиратскую бухту.‡Bringt den Bericht über Fools Starkbier zu Crank Fizzlebub in Booty Bay.‡무법항에 있는 크랭크 피즐버브에게 멍텅구리 스타우트 보고서를 가져가야 합니다.‡Llévale la cerveza de tontos a Loquillo Pinchabujas, que está en Bahía del Botín.‡Lleva el informe de cerveza de tontos a Loquillo Pinchabujas en Bahía del Botín.‡Apporter le Rapport sur la Bière du sot à Crank Fizzlebub à Baie-du-Butin.‡把蠢人酒试验报告交给藏宝海湾的克兰克·菲兹巴布。‡把蠢人酒試驗報告交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1123] = {
  nil,
  { -- Npc
    'Caçador de Cabeças Jubafria‡Охотник за головами из племени Мерзлогривов‡Kopfjäger der Frostmane‡서리갈기부족 인간사냥꾼‡Rebanacabezas Peloescarcha‡Rebanacabezas Peloescarcha‡Chasseur de têtes Frostmane‡霜鬃猎头者‡霜鬃獵頭者',
    nil,
  },
  nil,
  { -- Quest
    'Ravine Saturna‡Рабин Сатурна‡Rabine Saturna‡라빈 사투르나‡Rabine Saturna‡Rabine Saturna‡Rabine Saturna‡拉比恩·萨图纳‡拉比恩·薩圖納',
    nil,
    'Fale com Ravine Saturna no Refúgio Noturno, que fica na Clareira da Lua. A Clareira da Lua fica entre a Selva Maleva e Hibérnia, uma estrada que sai do Domínio dos Presamatos leva até lá.‡Поговорите с Рабином Сатурной в селении Ночная Гавань на Лунной поляне. Лунная поляна находится между Оскверненным лесом и Зимними Ключами, туда можно добраться по дороге, идущей от крепости Древобрюхов.‡Sprecht mit Rabine Saturna im Dorf Nighthaven in Moonglade. Moonglade liegt zwischen dem Teufelswald und Winterspring, und Ihr erreicht es über den Pfad, der aus der Holzschlundfeste herausführt.‡달의 숲의 나이트헤이븐에 있는 라빈 사투르나와 대화해야 합니다. 달의 숲은 악령의 숲과 여명의 설원 사이에 있으며 나무구렁 요새에서 나가는 길을 통해 갈 수 있습니다.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión de los Fauces de Madera.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión Fauces de Madera.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune. Reflet-de-Lune se trouve entre Gangrebois et le Berceau-de-l\'Hiver. Le chemin qui y mène traverse le Repaire des Grumegueules.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。月光林地在费伍德森林和冬泉谷之间，可以从木喉要塞中的一条通道抵达那里。‡與月光林地永夜港的拉比恩·薩圖納談壹談。月光林地在費伍德森林和冬泉谷之間，可以從木喉要塞中的壹條通道抵達那裏。',
  }
},
[1124] = {
  nil,
  { -- Npc
    'Lança-sombras Jubafria‡Темный чародей племени Мерзлогривов‡Schattenzauberer der Frostmane‡서리갈기부족 흑마술사‡Nigromante Peloescarcha‡Nigromante Peloescarcha‡Exhalombre Frostmane‡霜鬃暗法师‡霜鬃暗影施法者',
    nil,
  },
  nil,
  { -- Quest
    'Terras Devastadas‡Пустошь‡Einöde‡황무지‡Páramo‡Páramo‡La dévastation‡废土‡廢土',
    nil,
    'Mostre a Carta de Ravine para Layo Golpestela perto do Repouso dos Valorosos, o cemitério de Silithus.‡Поговорите с Лайо Зведным Всполохом близ кладбища Покой Доблестных в Силитусе и покажите ему письмо Рабина.‡Sprecht in der Nähe des Friedhofs Heldenwacht in Silithus mit Layo Starstrike und zeigt ihm Rabines Brief.‡실리더스의 묘지인 용사의 안식처 근처에 있는 라요 스타스트라이크를 찾아가 라빈의 편지를 보여주어야 합니다.‡Enséñale la carta del rabino a Layo Estrella cerca del cementerio de Sosiego del Valor en Silithus.‡Enséñale la carta de Rabine a Layo Golpe Estelar cerca del cementerio de Sosiego del Valor en Silithus.‡Parler à Layo Starstrike, à proximité du Repos des vaillants de Silithus, et lui montrer la Lettre de Rabine.‡在希利苏斯的勇士之墓附近找莱耶·星击谈谈，把拉比恩的信交给他。‡在希利蘇斯的勇士之墓附近找萊耶·星擊談談，把拉比恩的信交給他。',
  }
},
[1125] = {
  nil,
  { -- Npc
    'Rochetusco‡Скальный вепрь‡Klippeneber‡멧돼지‡Jabalí del risco‡Jabalí del risco‡Sanglier des rochers‡峭壁野猪‡峭壁野豬',
    nil,
  },
  nil,
  { -- Quest
    'Os espíritos de Vento Sul‡Духи Южного Ветра‡Die Geister vom Südwindposten‡마파람의 영혼‡Los espíritus de Viento del Sur‡Los espíritus de Viento del Sur‡Les esprits de Sudevent‡南风村的灵魂‡南風村的靈魂',
    nil,
    'Liberte os espíritos de 8 Druidas Torturados e 8 Sentinelas Torturadas na Vila do Vento Sul, depois fale novamente com Layo Golpestela no Repouso dos Valorosos, o cemitério de Silithus.‡Освободите в деревне Южного Ветра души 8 истерзанных друидов и 8 истерзанных часовых и вернитесь к Лайо Звездному Всполоху на кладбище Силитуса, Покой Доблестных.‡Befreit die Geister von 8 gequälten Druiden und 8 gequälten Schildwachen beim Südwindposten und kehrt dann zu Layo Starstrike auf den Friedhof Heldenwacht in Silithus zurück.‡마파람 마을에서 고통받는 드루이드 8명과 고통받는 파수꾼 8명의 영혼을 해방한 후, 실리더스, 용사의 안식처 묘지에 있는 라요 스타스트라이크에게 돌아가야 합니다.‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturadas en la Aldea del Viento del Sur. A continuación, reúnete con Layo Estrella en el cementerio de Sosiego del Valor en Silithus.‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturados en la Aldea del Viento del Sur. A continuación, reúnete con Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Libérer l’esprit de 8 Druides torturés et de 8 Sentinelles torturées, dans le village de Sudevent, puis revenir voir Layo Starstrike, au cimetière du Repos des Vaillants de Silithus.‡在南风村释放8个被折磨的德鲁伊和8个被折磨的哨兵的灵魂，然后向希利苏斯勇士之墓的莱耶·星击复命。‡在南風村釋放8個被折磨的德魯伊和8個被折磨的哨兵的靈魂，然後向希利蘇斯勇士之墓的萊耶·星擊復命。',
  }
},
[1126] = {
  nil,
  { -- Npc
    'Rochetusco Grande‡Большой скальный вепрь‡Großer Klippeneber‡큰 멧돼지‡Grande jabalí del risco‡Grande jabalí del risco‡Grand sanglier des rochers‡大峭壁野猪‡大峭壁野豬',
    nil,
  },
  nil,
  { -- Quest
    'A colmeia da torre‡Улей в башне‡Schwarmbau im Turm‡탑 속 소굴‡Una colmena en la torre‡Una colmena en la torre‡Une ruche dans la tour‡塔中之巢‡塔中之巢',
    nil,
    'Escale a torre da Vila do Vento Sul e descubra um jeito de despertar a colmeia. Leve tudo de estranho que encontrar durante a missão para Layo Golpestela no Repouso dos Valorosos, o cemitério de Silithus.‡Осмотрите башню деревни Южного Ветра и отыщите способ разворошить улей. Принесите все необычное, что попадется при выполнении задания Лайо Звездному Всполоху на кладбище Силитуса, Покой Доблестных.‡Besteigt den Turm beim Südwindposten und findet eine Möglichkeit, den Schwarmbau der Silithiden aufzuscheuchen. Bringt alles Ungewöhnliche, das Ihr dabei entdeckt, zu Layo Starstrike auf den Friedhof Heldenwacht in Silithus.‡마파람 마을에 있는 탑 위로 올라가 실리시드 소굴을 들쑤셔 놓을 방법을 찾아야 합니다. 그러는 가운데 뭔가 알아낸 것이 있으면 실리더스의 용사의 안식처 묘지에 있는 라요 스타스트라이크에게 보고해야 합니다.‡Sube a la torre de la Aldea del Viento del Sur y encuentra la forma de agitar la colmena de silítidos para que entre en actividad. Recoge cualquier cosa extraña que encuentres y llévasela a Layo Estrella en el cementerio de Sosiego del Valor en Silithus.‡Sube a la torre de la Aldea del Viento del Sur y encuentra la forma de agitar la colmena de silítidos para que entre en actividad. Recoge cualquier cosa extraña que encuentres y llévasela a Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Escalader la Tour du village de Sudevent, et trouver un moyen de mettre la ruche des silithides en activité. Toute chose inhabituelle doit être rapportée à Layo Starstrike, au cimetière du Repos des vaillants de Silithus.‡爬上南风村的塔，找寻激活异种蝎群的方法。把任何你认为不寻常的东西交给希利苏斯勇士之墓的莱耶·星击。‡爬上南風村的塔，找尋激活異種蠍群的方法。把任何妳認為不尋常的東西交給希利蘇斯勇士之墓的萊耶·星擊。',
  }
},
[1127] = {
  -- Item
  '‡Взрывпакет‡Blitzstrahlbündel‡섬광탄 다발‡Carga cegadora‡Carga cegadora‡Sac de poudre noire‡火弹‡火彈',
  { -- Npc
    'Rochetusco Ancião‡Старый скальный вепрь‡Alter Klippeneber‡덩치큰 멧돼지‡Jabalí del risco mayor‡Jabalí del risco mayor‡Ancien sanglier des rochers‡老峭壁野猪‡老峭壁野豬',
    nil,
  },
  nil,
  { -- Quest
    'Cerveja Escura do Tonto‡"Дурацкое Крепкое"‡Fools Starkbier‡멍텅구리 스타우트 맥주‡Cerveza de tontos‡Cerveza de tontos‡Bière du sot‡蠢人酒‡蠢人酒',
    nil,
