  nil,
  { -- Quest
    'A caixa preta‡Черный ящик‡Der Flugschreiber‡블랙박스‡La caja negra‡La caja negra‡La boîte noire‡黑盒子‡黑盒子',
    nil,
    'Leve a Caixa Preta Corroída para o Salão das Armas de Altaforja.‡Отнесите заржавевший черный ящик в оружейную Стальгорна.‡Bringt den zerfressenen Flugschreiber in die Halle der Waffen in Ironforge.‡녹슨 블랙박스를 아이언포지에 있는 전투의 전당으로 가져가야 합니다.‡Lleva la caja negra corroída a la Sala de Armas de Forjaz.‡Lleva la caja negra corroída a la Sala de Armas de Forjaz.‡Apporter la Boîte noire corrodée au Hall des armes, à Ironforge.‡把这个黑盒子带到铁炉堡的军事大厅去。‡把這個黑盒子帶到鐵爐堡的軍事大廳去。',
  }
},
[709] = {
  nil,
  { -- Npc
    'Fomentador de Guerra Mosh\'Ogg‡Солдат-наемник из клана Мош\'Огг‡Kriegstreiber der Mosh\'Ogg‡모쉬오그일족 전사‡Belicista Mosh\'Ogg‡Belicista Mosh\'Ogg‡Combattant Mosh\'Ogg‡莫什奥格好战者‡莫什奧格好戰者',
