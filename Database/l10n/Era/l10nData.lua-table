  }
},
[3504] = {
  nil,
  { -- Npc
    'Gil‡Гил‡Gil‡길‡Gil‡Gil‡Gil‡吉尔‡吉爾',
    nil,
  },
  nil,
  { -- Quest
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Entregue a Carta Lacrada para Ag\'tor a Ag\'tor Punho de Sangue, em Azshara.‡Отнесите запечатанное письмо Аг\'тору Кровопалу в Азшару.‡Bringt den versiegelten Brief zu Ag\'tor Bloodfist nach Azshara.‡아즈샤라에 있는 아그토르 블러드피스트에게 아그토르에게 보내는 봉인된 편지를 전해야 합니다.‡Entrega la carta sellada a Ag\'tor Puñosangre en Azshara.‡Entrega la carta lacrada a Ag\'tor Puñosangre en Azshara.‡Apporter la Lettre Scellée à Ag\'tor Bloodfist dans Azshara.‡把这封给阿格图的密信交给艾萨拉的阿格图·血拳。‡把這封給阿格圖的密信交給艾薩拉的阿格圖·血拳。',
  }
},
[3505] = {
  -- Item
  'Anel-sinete de Alterac‡Альтеракский перстень-печатка‡Alteracsiegelring‡알터랙 인장 반지‡Sello de Alterac‡Sello de Alterac‡Chevalière d\'Alterac‡奥特兰克徽记之戒‡奧特蘭克璽戒',
  { -- Npc
    'Patty Malagueta‡Пат‡Pat‡줄리‡Pat‡Pat‡Pat‡帕特‡派特',
    nil,
  },
  nil,
  { -- Quest
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Mate 10 Recuperadores Sanguinélficos e 10 Topógrafos Sanguinélficos antes de procurar o acampamento da Maga Rimtori. Quando localizá-lo, procure algo que possa ser importante para ela e possa ser usado para forçá-la a lutar.‡Убейте 10 эльфов крови-землемеров и 10 эльфов крови-геодезистов, потом разыщите лагерь волхва Римтори. В лагере найдите что-нибудь важное для мага, из-за чего она могла бы ринуться в бой.‡Tötet 10 Blutelf-Wiederbeschaffer und 10 Blutelf-Feldmesser, bevor Ihr Magus Rimtoris Lager sucht. Sobald Ihr es gefunden habt, sucht nach etwas, das für sie von Bedeutung ist und das wir nehmen können, um sie in einen Kampf zu locken.‡블러드 엘프 수색꾼 10명과 블러드 엘프 감정관 10명을 처치한 후, 학자 림토리의 야영지를 찾아내십시오. 야영지를 찾으면 그녀를 싸움으로 유인하는데 사용할 수 있을 만한 것을 찾아보십시오. 림토리가 중요하게 여기는 것이라야 합니다.‡Mata a 10 reivindicadores y 10 agrimensores elfos de sangre antes de buscar el campamento de Magus Rimtori. Una vez allí, busca algo que sea importante para ella, algo con lo que provocar un combate.‡Mata a 10 reivindicadores y 10 peritos elfos de sangre antes de buscar el campamento de Maga Rimtori. Una vez allí, busca algo que sea importante para ella, algo con lo que provocar un combate.‡Tuer 10 Vengeurs elfes de sang et 10 Géomètres elfes de sang avant de rechercher le campement du magus Rimtori. Une fois le camp trouvé, chercher quelque chose d\'important pour elle et qui peut être utilisé pour l\'obliger à se battre.‡杀死10个血精灵搜寻者和10个血精灵勘测员，并找到大法师雷姆托里的营地。一旦你发现了营地，就去找到某个对她极为重要的东西，以用于激怒她，让她与你战斗。‡殺死10個血精靈搜尋者和10個血精靈勘測員，並找到大法師雷姆托裏的營地。壹旦妳發現了營地，就去找到某個對她極為重要的東西，以用於激怒她，讓她與妳戰鬥。',
  }
},
[3506] = {
  -- Item
  '‡Смесь из цветков Грязного Рыла‡Morastschnauzengemisch‡진흙주둥이 합성물‡Compuesto Morrobarro‡Compuesto Morrobarro‡Poudre de fangemufle‡泥头花药‡泥頭花藥',
  nil,
  nil,
  { -- Quest
    'Traído‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Destrua o cristal de foco arcano preso à Maga Rimtori e mate-a. Depois, leve a Cabeça da Maga Rimtori para Ag\'tor Punho de Sangue em Azshara.‡Уничтожьте кристалл средоточия чар, связанный с волхвом Римтори, затем убейте ее. Отнесите голову Римтори Аг\'тору Кроволапу в Азшаре.‡Zerstört den arkanen Fokussierkristall, der an Magus Rimtori gebunden ist, und tötet sie danach. Bringt dann den Kopf von Magus Rimtori zu Ag\'tor Bloodfist nach Azshara.‡학자 림토리와 연결된 비전 집중의 수정을 파괴하고 그녀를 처치하십시오. 그런 다음 그 증거로 아즈샤라에 있는 아그토르 블러드피스트에게 학자 림토리의 머리카락을 가져가야 합니다.‡Destruye el cristal de enfoque arcano de Magus Rimtori y entonces mátala. Lleva su cabeza a Ag\'tor Puñosangre a Azshara.‡Destruye el cristal de enfoque Arcano de Maga Rimtori y entonces mátala. Lleva su cabeza a Ag\'tor Puñosangre a Azshara.‡Détruire le Cristal de focalisation des arcanes lié au magus Rimtori et l\'assassiner ensuite. Puis apporter la tête du magus Rimtori à Ag\'tor Bloodfist dans Azshara.‡摧毁大法师雷姆托里携带的奥术聚焦水晶并杀死她。然后把她的脑袋交给艾萨拉的阿格图·血拳。‡摧毀大法師雷姆托裏攜帶的奧術聚焦水晶並殺死她。然後把她的腦袋交給艾薩拉的阿格圖·血拳。',
  }
},
[3507] = {
  nil,
  { -- Npc
    'Nanda‡Анди‡Andi‡알렉시스‡Andi‡Andi‡Andi‡安蒂‡安蒂',
    nil,
  },
  nil,
  { -- Quest
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Fale com Belgrom Pedramalho em Orgrimmar.‡Поговорите с Белгромом Каменной Буловой в Оргриммаре.‡Sprecht mit Belgrom Rockmaul in Orgrimmar.‡오그리마에 있는 벨그롬 록마울과 대화하십시오.‡Habla con Belgrom Destrozaroca en Orgrimmar.‡Habla con Belgrom Destrozarroca en Orgrimmar.‡Aller voir Belgrom Rockmaul dans Orgrimmar.‡与奥格瑞玛的贝尔戈洛姆·石槌谈一谈。‡與奧格瑞瑪的貝爾戈洛姆·石槌談壹談。',
  }
},
[3508] = {
  -- Item
  'Mistura Fuçalama‡Микстура Грязного Рыла‡Morastschnauzenmixtur‡진흙주둥이 혼합물‡Mezcla Morrobarro‡Mezcla Morrobarro‡Brouet de fangemufle‡泥头花水‡泥頭花水',
  { -- Npc
    'Miguel‡Мики‡Mikey‡혁이‡Mikey‡Mikey‡Mikey‡米奇‡米奇',
    nil,
  },
  nil,
  { -- Quest
    'Quebrando a proteção‡Минуя охрану‡Den Zauberschutz brechen‡보호막 파괴‡Romper el amuleto‡Romper el amuleto‡Briser l\'Amulette‡破坏结界‡破壞結界',
    nil,
    'Espere Loramus para completar o feitiço de iluminação.‡Подождите, пока Лорамус завершит заклинание просветления.‡Wartet, bis Loramus den Erleuchtungszauber vollendet hat.‡로라무스가 깨우침의 마법을 마칠 때까지 기다려야 합니다.‡Espera que Loramus acabe el hechizo de ilustración.‡Espera que Loramus acabe el hechizo de ilustración.‡Attendre que Loramus ait achevé le rituel de Lumière.‡等待洛拉姆斯完成启迪法术。‡等待洛拉姆斯完成啟迪法術。',
  }
},
[3509] = {
  -- Item
  'Escama de Espinhadaga‡Чешуя наги Пронзающего Гребня‡Säbelflossenschuppe‡비수가시일족의 비늘‡Escama Espinadaga‡Escama Espinadaga‡Ecaille de Daguéchine‡刺脊纳迦的鳞片‡刺脊納迦的鱗片',
  { -- Npc
    'Geoff‡Джефф‡Geoff‡구스‡Geoff‡Geoff‡Geoff‡杰奥夫‡傑奧夫',
    nil,
  },
  nil,
  { -- Quest
    'O nome da fera‡Имя Зверя‡Der Name der Bestie‡악마의 이름‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡惡魔之名',
    nil,
    'Fale com o Lorde Arkkoroc em Azshara. comece sua busca na beira da água para encontrar o Templo de Arkkoran.‡Поговорите в Азшаре с лордом Арккоросом. Начните поиски у кромки воды, чтобы найти Храм Арккоран.‡Sprecht mit Lord Arkkoroc in Azshara. Beginnt Eure Suche am Rand des Wassers, um den Tempel von Arkkoran zu finden.‡아즈샤라에 있는 제왕 아크코로크와 대화해야 합니다. 아크코란의 신전을 찾으려면 물가부터 조사해 보십시오.‡Habla con Lord Arkkoroc en Azshara. Empieza tu búsqueda en la orilla para encontrar el Templo de Arkkoran.‡Habla con Lord Arkkoroc en Azshara. Empieza tu búsqueda en la orilla para encontrar el Templo de Arkkoran.‡Aller voir le seigneur Arkkoroc dans Azshara. Commencer la recherche au bord de l\'eau pour trouver le temple d\'Arkkoran.‡与艾萨拉的亚考罗克谈一谈。你应该在海边搜索亚考兰神殿。‡與艾薩拉的亞考羅克談壹談。妳應該在海邊搜索亞考蘭神殿。',
  }
},
[3510] = {
  -- Item
  'Olho de Rancapina‡Глаз мурлока из клана Рваный Плавник‡Fetzenflossenauge‡너덜지느러미일족의 눈‡Ojo de aleta rasgado‡Ojo de aleta rasgado‡Oeil d\'Aileron déchiré‡碎鳍鱼人的眼球‡碎鰭魚人的眼球',
  { -- Npc
    'Toninho‡Твайн‡Twain‡아티‡Oposti‡Oposti‡Twain‡图恩‡圖恩',
    nil,
  },
  nil,
  { -- Quest
    'O nome da fera‡Имя Зверя‡Der Name der Bestie‡악마의 이름‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡惡魔之名',
    nil,
    'Mate Hetaera e leve a Cabeça Ensanguentada de Hetaera, a Cabeça Arrebentada de Hetaera e a Cabeça Ferida de Hetaera para o Lorde Arkkoroc.‡Убейте Хетайру и принесите окровавленную голову Хетайры, разбитую голову Хетайры и покрытую синяками голову Хетайры лорду Аккоросу.‡Erschlagt Hetäre und bringt den blutigen Hetärenkopf, den geschlagenen Hetärenkopf und den verwundeten Hetärenkopf zu Lord Arkkoroc.‡헤타에라를 물리치고 헤타에라의 훼손된 머리, 헤타에라의 피묻은 머리, 헤타에라의 으깨진 머리를 제왕 아크코로크에게 가지고 가야 합니다.‡Mata a Hetaera y lleva la cabeza ensangrentada, la cabeza golpeada y la cabeza amoratada a Lord Arkkoroc.‡Mata a Hetaera y lleva la cabeza ensangrentada, la cabeza golpeada y la cabeza amoratada a Lord Arkkoroc.‡Assassiner Hetaera et apporter la Tête ensanglantée d\'Hetaera, la Tête battue d\'Hetaera et la Tête meurtrie d\'Hetaera au seigneur Arkkoroc.‡杀掉赫塔拉，将染血的赫塔拉头颅、破碎的赫塔拉头颅和淤血的赫塔拉头颅交给亚考罗克。‡殺掉赫塔拉，將染血的赫塔拉頭顱、破碎的赫塔拉頭顱和淤血的赫塔拉頭顱交給亞考羅克。',
  }
},
[3511] = {
  -- Item
  '‡Плащ народного ополчения‡Volksmilizumhang‡백성의 민병대 망토‡Capa de La Milicia Popular‡Capa de La Milicia Popular‡Cape de la milice du peuple‡人民军披风‡人民軍披風',
  { -- Npc
    'Estêvão‡Стивен‡Steven‡주노‡Steven‡Steven‡Steven‡斯蒂文‡斯蒂文',
