  nil,
  { -- Quest
    'Miragens‡Миражи‡Illusionen‡신기루‡Espejismos‡Espejismos‡Mirages‡饥肠辘辘‡饑腸轆轆',
    nil,
    'Recupere o Caixote de Suprimentos para Sigrun Derrubaferro.‡Верните ящик с припасами Сигруну Рудотесу.‡Holt die Nachschubkiste für Sigrun Ironhew.‡시그런 아이언휴를 위해 보급 상자를 찾아야 합니다.‡Recupera el cajón de provisiones para Sigrun Extracero.‡Recupera el cajón de suministros para Sigrun Extracero.‡Retrouver la Caisse de fournitures pour Sigrun Ironhew.‡帮西格鲁·铁斧找回补给箱。‡幫西格魯·鐵斧找回補給箱。',
  }
},
[719] = {
  -- Item
  '‡Перчатки охотника на кроликов‡Handschuhe des Hasenjägers‡토끼 사육사 장갑‡Guantes de cuidador de conejos‡Guantes de cuidador de conejos‡Gants d\'éleveur de lapins‡驯兔手套‡馴兔手套',
  nil,
  nil,
  { -- Quest
    'Um anão e suas ferramentas‡Дворф и его инструменты‡Ein Zwerg und sein Werkzeug‡행운의 곡괭이‡Un enanos y sus herramientas‡Un enano y sus herramientas‡Un nain et ses outils‡矮人的工具‡矮人的工具',
    nil,
    'Ache a Picareta da Sorte de Ryedol e devolva ao Prospector Ryedol, ao sul do Sítio de Escavação de Pé-de-malho.‡Найдите счастливую кирку Ржанеца и верните ее геологу Ржанецу к югу от карьера Тяжелоступа.‡Sucht Ryedols Glückshacke und bringt sie Ausgrabungsleiter Ryedol in der Hammertoe-Grabungsstätte.‡라이돌의 행운의 곡괭이를 찾아 해머토의 발굴현장의 남쪽에 있는 발굴조사단장 라이돌에게 되돌려주어야 합니다.‡Encuentra el pico de la suerte de Ryedol y llévaselo al prospector Ryedol al sur de la excavación Piemartillo.‡Encuentra el pico de la suerte de Ryedol y llévaselo al prospector Ryedol al sur de la excavación de Piemartillo.‡Trouver le Piolet de chance de Ryedol et le rapporter au Prospecteur Ryedol au sud du site de fouilles de Hammertoe.‡找到雷杜尔的好运锄，把它交给铁趾挖掘场南边的勘察员雷杜尔。‡找到雷杜爾的好運鋤，把它交給鐵趾挖掘場南邊的勘察員雷杜爾。',
  }
},
[720] = {
  -- Item
  '‡Перчатки буяна‡Muskelprotzhandschuhe‡투사의 장갑‡Guantes de camorrista‡Guantes de camorrista‡Gants de bagarreur‡争战手套‡打鬥手套',
  nil,
  nil,
  { -- Quest
    'Um sinal de esperança‡Предвестник надежды‡Ein Hoffnungsschimmer‡희망의 전조‡Un signo de esperanza‡Un signo de esperanza‡Un signe d\'espoir‡一线希望‡壹線希望',
    nil,
    'Encontre o Prospector Ryedol e avise que Grez Pé-de-malho está vivo.‡Найдите геолога Ржанеца и сообщите, что Грез Тяжелоступ жив.‡Sucht Ausgrabungsleiter Ryedol und teilt ihm mit, dass Hammertoe Grez noch am Leben ist.‡발굴조사단장 라이돌을 찾아 해머토 그레즈가 살아 있다는 사실을 알려야 합니다.‡Localiza al prospector Ryedol y dile que Grez Dedomaza está vivo.‡Localiza al prospector Ryedol y dile que Grez Piemartillo está vivo.‡Trouver le Prospecteur Ryedol et lui dire que Hammertoe Grez est en vie.‡找到勘察员雷杜尔，告诉他铁趾格雷兹还活着。‡找到勘察員雷杜爾，告訴他鐵趾格雷茲還活著。',
  }
},
[721] = {
  nil,
  { -- Npc
    'Coelho‡Кролик‡Hase‡토끼‡Conejo‡Conejo‡Lapin‡兔子‡兔子',
    nil,
  },
  nil,
  { -- Quest
    'Um sinal de esperança‡Предвестник надежды‡Ein Hoffnungsschimmer‡희망의 전조‡Un signo de esperanza‡Un signo de esperanza‡Un signe d\'espoir‡一线希望‡壹線希望',
    nil,
    'Encontre Grez Pé-de-malho em Uldaman.‡Найдите Греза Тяжелоступа в Ульдамане.‡Sucht in Uldaman nach Hammertoe Grez.‡울다만에서 해머토 그레즈를 찾아야 합니다.‡Encuentra a Grez Dedomaza en Uldaman.‡Encuentra a Grez Piemartillo en Uldaman.‡Trouver Hammertoe Grez à Uldaman.‡在奥达曼找到铁趾格雷兹。‡在奧達曼找到鐵趾格雷茲。',
  }
},
[722] = {
  nil,
  nil,
  nil,
  { -- Quest
    'O amuleto dos segredos‡Амулет тайн‡Amulett der Geheimnisse‡비밀의 아뮬렛‡El amuleto de los secretos‡El amuleto de los secretos‡L\'amulette des secrets‡铁趾的护符‡鐵趾的護符',
    nil,
    'Encontre o Amuleto do Pé-de-malho e o devolva a Grez, em Uldaman.‡Найдите амулет Тяжелоступа и верните его ему в Ульдаман.‡Sucht Hammertoes Amulett und bringt es ihm nach Uldaman.‡해머토의 아뮬렛을 찾아 울다만에 있는 해머토에게 가져가야 합니다.‡Encuentra el amuleto de Piemartillo y llévaselo a Uldaman.‡Encuentra el amuleto de Piemartillo y llévaselo a Uldaman.‡Trouver l\'Amulette de Hammertoe et lui rapporter à Uldaman.‡找到铁趾的护符，把它交给奥达曼的铁趾。‡找到鐵趾的護符，把它交給奧達曼的鐵趾。',
  }
},
[723] = {
  -- Item
  'Fígado de Goretusco‡Печень жутеклыка‡Geiferzahnleber‡뿔엄니멧돼지 간‡Hígado de Dentosangre‡Hígado de Dentosangre‡Foie de Broche-tripes‡血牙野猪的肝‡血牙野豬的肝',
  { -- Npc
    'Açougueiro Mosh\'Ogg‡Палач Мош\'Огг‡Schlächter der Mosh\'Ogg‡모쉬오그일족 도살꾼‡Carnicero Mosh\'Ogg‡Carnicero Mosh\'Ogg‡Boucher Mosh\'Ogg‡莫什奥格屠夫‡莫什奧格屠夫',
    nil,
  },
  nil,
  { -- Quest
    'Prospector da fé‡Клятва верности‡Ein Funken Hoffnung‡돈독한 믿음‡Tener fe en el porvenir‡Tener fe en el porvenir‡Espérance en la foi‡铁趾的遗愿‡鐵趾的遺願',
    nil,
    'Leve o Amuleto do Pé-de-malho para o Prospector Ryedol nos Ermos.‡Отнесите амулет Тяжелоступа геологу Ржанецу в Бесплодные земли.‡Bringt Ausgrabungsleiter Ryedol im Ödland Hammertoes Amulett.‡황야의 땅에 있는 발굴조사단장 라이돌에게 해머토의 아뮬렛을 가져가야 합니다.‡Llévale el amuleto de Piemartillo al prospector Ryedol en las Tierras Inhóspitas.‡Llévale el amuleto de Piemartillo al prospector Ryedol en las Tierras Inhóspitas.‡Porter l\'Amulette de Hammertoe au Prospecteur Ryedol dans les Terres ingrates.‡把铁趾的护符交给荒芜之地的勘察员雷杜恩。‡把鐵趾的護符交給荒蕪之地的勘察員雷杜恩。',
  }
},
[724] = {
  -- Item
  '‡Пирожок из печени кровоклыка‡Pastete aus Geiferzahnleber‡뿔엄니멧돼지 간 파이‡Pastel de hígado de Dentosangre‡Pastel de hígado de Dentosangre‡Tourte au foie de broche-tripes‡猪肝馅饼‡豬肝餡餅',
  { -- Npc
    'Trogg Pedraqueixo Parrudo‡Сильный трогг из племени Каменной Челюсти‡Bulliger Trogg der Felsenkiefer‡힘센 바위턱트로그‡Trogg Comepiedras fornido‡Trogg Comepiedras fornido‡Trogg Mâcheroc forcené‡壮实的石腭怪‡壯實的石齶怪',
    nil,
  },
  nil,
  { -- Quest
    'Prospector da fé‡Клятва верности‡Ein Funken Hoffnung‡돈독한 믿음‡Tener fe en el porvenir‡Tener fe en el porvenir‡Espérance en la foi‡铁趾的遗愿‡鐵趾的遺願',
    nil,
    'Leve o Amuleto do Pé-de-malho para o Historiador Karnik, em Altaforja.‡Отнесите амулет Тяжелоступа историку Карнику в Стальгорне.‡Bringt Historiker Karnik in Ironforge Hammertoes Amulett.‡아이언포지에 있는 역사학자 카르닉에게 해머토의 아뮬렛을 가져가야 합니다.‡Llévale el amuleto de Piemartillo a Karnik el Historiador en Forjaz.‡Llévale el amuleto de Piemartillo a Karnik el Historiador en Forjaz.‡Apporter l\'Amulette de Hammertoe à l\'historien Karnik à Ironforge.‡把铁趾的护符交给铁炉堡的史学家卡尼克。‡把鐵趾的護符交給鐵爐堡的史學家卡尼克。',
  }
},
[725] = {
  -- Item
  'Pata de Gnoll‡Лапа гнолла‡Gnolltatze‡놀의 앞발‡Garra gnoll‡Garra gnoll‡Patte de gnoll‡豺狼人的爪子‡豺狼人的爪子',
  nil,
  nil,
  { -- Quest
    'A notícia de uma ameaça‡Слухи об угрозе‡Kunde über die Bedrohung breitet sich aus‡위협의 경고‡Advertir de la amenaza‡Advertir de la amenaza‡Avertir de la menace‡亡者的警告‡亡者的警告',
    nil,
    'Encontre o Conselheiro Belgrum e entregue o bilhete.‡Найдите советника Белграма и отдайте ему записку.‡Sucht Berater Belgrum und gebt ihm die Notiz.‡조언자 벨그룸을 찾아 봉인된 쪽지를 전해야 합니다.‡Encuentra al consejero Belgrum y dale su nota.‡Encuentra al consejero Belgrum y dale su nota.‡Trouver le Conseiller Belgrum et lui donner la Note.‡找到顾问贝尔格拉姆，把便笺交给他。‡找到顧問貝爾格拉姆，把便箋交給他。',
  }
},
[726] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A notícia de uma ameaça‡Слухи об угрозе‡Kunde über die Bedrohung breitet sich aus‡위협의 경고‡Advertir de la amenaza‡Advertir de la amenaza‡Avertir de la menace‡亡者的警告‡亡者的警告',
    nil,
    'Fale com o Historiador Karnik.‡Поговорите с историком Карником.‡Sprecht mit Historiker Karnik.‡역사학자 카르닉과 대화해야 합니다.‡Habla con Karnik el Historiador.‡Habla con Karnik el Historiador.‡Parler à l\'Historien Karnik.‡和史学家卡尼克谈一谈。‡和史學家卡尼克談壹談。',
  }
},
[727] = {
  -- Item
  '‡Зубчатый короткий меч‡Schartiges Kurzschwert‡톱니모양 쇼트소드‡Espada corta despuntada‡Espada corta despuntada‡Epée courte ébréchée‡卷刃的短剑‡卷刃的短劍',
  { -- Npc
    'Montanhista de Altaforja‡Горный пехотинец Стальгорна‡Gebirgsjäger von Ironforge‡아이언포지 산악경비대‡Montaraz de Forjaz‡Montaraz de Forjaz‡Montagnard d\'Ironforge‡铁炉堡巡山人‡鐵爐堡巡山人',
    nil,
  },
  nil,
  { -- Quest
    'Em busca do Compêndio de Yagyin em Altaforja‡В Стальгорн за книгой Йагина‡Auf nach Ironforge zu \'Yagyins Zusammenstellung\'‡야그인의 법전을 찾아서‡Ir a Forjaz a buscar el "Compendio" de Yagyin‡Ir a Forjaz a buscar el "Compendio" de Yagyin‡Aller à Ironforge chercher le « Sommaire de Yagyin »‡远赴铁炉堡‡遠赴鐵爐堡',
    nil,
    'Dê o Signo do Martelo a Gerrig Agarrosso na Caverna Esquecida de Altaforja.‡Отнесите печать Молота Геррику Костохвату в Заброшенный грот в Стальгорн.‡Gebt Gerrig Bonegrip im düsteren Viertel von Ironforge das Siegelzeichen des Hammers.‡아이언포지의 쓸쓸한 뒷골목에 있는 게릭 본그립에게 해머의 인장을 가져가야 합니다.‡Dale el sigilo del martillo a Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Dale el sigilo del Martillo a Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Donner le Glyphe du Marteau à Gerrig Bonegrip, dans la caverne lugubre d’Ironforge.‡把战锤印章交给铁炉堡的葛利·硬骨。‡把戰錘印章交給鐵爐堡的葛利·硬骨。',
  }
},
[728] = {
  -- Item
  '‡Рецепт: похлебка Западного Края‡Rezept: Westfalleintopf‡조리법: 서부정통 스튜‡Receta: estofado de los Páramos de Poniente‡Receta: estofado de los Páramos de Poniente‡Recette : Ragoût de la marche de l\'Ouest‡食谱：杂味炖肉‡食譜:西部荒野燉肉',
  { -- Npc
    'Bhag\'thera‡Баг\'тира‡Bhag\'thera‡바그테라‡Bhag\'thera‡Bhag\'thera‡Bhag\'thera‡巴尔瑟拉‡巴爾瑟拉',
    nil,
  },
  nil,
  { -- Quest
    'Em busca do compêndio de Yagyin na Cidade Baixa‡В Подгород за книгой Йагина‡Auf nach Undercity zu \'Yagyins Zusammenstellung\'‡야그인의 법전을 찾아서‡Ir a Entrañas a buscar el "Compendio" de Yagyin‡Ir a Entrañas a buscar el "Compendio" de Yagyin‡Pour le « Sommaire de Yagyin »‡远赴幽暗城‡遠赴幽暗城',
    nil,
    'Leve o Signo do Martelo ao Guardião Bel\'dugur na Cidade Baixa.‡Отнесите печать Молота хранителю Бел\'дугуру в Подгород.‡Bringt dem Bewahrer Bel\'dugur in Undercity das Siegelzeichen des Hammers.‡언더시티에 있는 관리인 벨두거에게 해머의 인장을 가져가야 합니다.‡Llévale el sigilo del martillo al guardián Bel\'dugur en Entrañas.‡Llévale el sigilo del Martillo al vigilante Bel\'dugur en Entrañas.‡Apporter le Glyphe du Marteau au Gardien Bel\'dugur à Undercity.‡把战锤印章交给幽暗城的看守者贝尔杜加。‡把戰錘印章交給幽暗城的看守者貝爾杜加。',
  }
},
[729] = {
  -- Item
  'Acém de Abutre‡Жилистое мясо стервятника‡Sehniges Geierfleisch‡식인독수리 고기‡Carne fibrosa de buitre‡Carne fibrosa de buitre‡Viande filandreuse de vautour‡秃鹫肉条‡禿鷹肉條',
  { -- Npc
    'Sin\'Dall‡Син\'Далл‡Sin\'Dall‡신달‡Sin\'Dall‡Sin\'Dall‡Sin\'Dall‡辛达尔‡辛達爾',
