  nil,
  { -- Quest
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve a Pele de Demônio Esfolada a Maurin Rachaosso na Desolação.‡Отнесите рваную демонскую кожу Майрину Костолому в Пустоши.‡Bringt die geschundene Dämonenhaut nach Desolace zu Maurin Bonesplitter.‡잊혀진 땅에 있는 마우린 본스플리터에게 악마의 가죽을 가져다주십시오.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Apporter une Peau de démon écorché à Maurin Bonesplitter en Désolace.‡把恶魔之皮拿给凄凉之地的玛乌林·碎骨看看。‡把惡魔之皮拿給淒涼之地的瑪烏林·碎骨看看。',
  }
},
[1481] = {
  -- Item
  '‡Лютый Коготь‡Grimmklaue‡심연의 발톱‡Zarpadura‡Zarpadura‡Griffe-sinistre‡冷酷之爪‡冷酷之爪',
  { -- Npc
    'Bartô Aquamare‡Барт Приливень‡Bart Tidewater‡바트 타이드워터‡Bart Mareaqua‡Bart Mareaqua‡Bart Tidewater‡巴特·泰德沃特‡巴特·泰德沃特',
    'Capitão da Virtude da Donzela‡Капитан "Девичьей Чести"‡Kapitän der TUGENDHAFTEN MAID‡메이든즈 버튜호 선장‡Capitán del Virtud de la Doncella‡Capitán del Virtud de la Doncella‡Capitaine de la Jeune vierge‡处女号的船长‡處女號的船長',
  },
  nil,
  { -- Quest
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Escalpo de Assombrante para Maurin Rachaosso na Desolação.‡Принесите скальп тенелова Маурину Костолому в Пустошах.‡Bringt Maurin Bonesplitter in Desolace einen Schattenpirscherskalp.‡잊혀진 땅에 있는 마우린 본스플리터에게 그림자추적자 머릿가죽을 가져가야 합니다.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Apporter un Scalp de Traqueur des ténèbres à Maurin Bonesplitter en Désolace.‡给凄凉之地的玛乌林·碎骨带回一张巡影者的头皮。‡給淒涼之地的瑪烏林·碎骨帶回壹張巡影者的頭皮。',
  }
},
