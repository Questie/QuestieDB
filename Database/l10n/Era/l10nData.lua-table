[6582] = {
  -- Item
  '‡Сапоги лазутчика‡Späherstiefel‡정찰용 장화‡Botas de exploración‡Botas de exploración‡Bottes de l\'éclaireur‡斥候战靴‡斥候長靴',
  { -- Npc
    'Mamãe Zavas‡Матка Завас‡Gelegemutter Zavas‡여왕 자바스‡Madrezarpa Zavas‡Madrezarpa Zavas‡Matriarche Zavas‡萨瓦丝女王‡薩瓦絲女王',
    nil,
  },
  nil,
  { -- Quest
    'O teste dos crânios: Áugure‡Черепа: Провидец‡Die Prüfung der Schädel, Scryer‡해골 시험 - 스크라이어‡La prueba de las calaveras, Arúspice‡La prueba de los cráneos, Arúspice‡L\'épreuve des crânes, Clairvoyant‡龙骨试炼，斯克利尔‡龍骨試煉，斯克利爾',
    nil,
    'Encontre e mate o Áugure, o draco da Revoada Dragônica Azul. Arranque a cabeça do draco morto e leve-a para Ardeluta.|nVocê sabe que o Áugure se encontra em Hibérnia.‡Найдите в Зимних Ключах избранного бойца синих дракона по имени Провидец и убейте его. С его черепом вернитесь к Огнебору.‡Ihr müsst Scryer, den Champion der blauen Großdrachen, finden und ihn töten. Schlagt seinem Kadaver den Schädel ab und bringt ihn zu Aschenschwinge.|nIhr wisst, dass Scryer in Winterspring zu finden ist.‡여명의 설원에서 찾을 수 있는 푸른용군단의 용사 스크라이어를 찾아 처치해야 합니다. 그의 시체에서 해골을 수습해서 엠버스트라이프에게 돌아가야 합니다.‡Debes encontrar a Arúspice, el campeón draco del Vuelo Azul y matarlo. Separa su calavera de su cuerpo y llévasela a Brasaliza.|nSabes que puedes encontrar a Arúspice en Cuna del Invierno.‡Debes encontrar a Arúspice, el Campeón draco del Vuelo Azul y matarlo. Separa su cráneo de su cuerpo y llévaselo a Brasaliza.|nSabes que puedes encontrar a Arúspice en Cuna del Invierno.‡Vous devez trouver Clairvoyant, le drake champion du Vol bleu, et le tuer. Arracher son crâne à son cadavre, et le rapporter à Brandeguerre.|nClairvoyant se trouve au Berceau-de-l\'Hiver.‡找到蓝龙斯克利尔并杀掉他。从他的身上取下他的颅骨，然后将其交给埃博斯塔夫。|n你可以在冬泉谷找到斯克利尔。‡找到藍龍斯克利爾並殺掉他。從他的身上取下他的顱骨，然後將其交給埃博斯塔夫。|n妳可以在冬泉谷找到斯克利爾。',
  }
},
[6583] = {
  -- Item
  '‡Наручи лазутчика‡Späherarmschienen‡정찰용 팔보호구‡Brazales de exploración‡Brazales de exploración‡Brassards de l\'éclaireur‡斥候护腕‡斥候護腕',
  { -- Npc
    'Grufo‡Графф‡Gruff‡그러프‡Gruff‡Gruff‡Gruff‡格鲁夫‡格魯夫',
    nil,
  },
  nil,
  { -- Quest
    'O teste dos crânios: Somnus‡Черепа: Сомнус‡Die Prüfung der Schädel, Somnus‡해골 시험 - 솜누스‡La prueba de las calaveras, Somnus‡La prueba de los cráneos, Somnus‡L\'épreuve des crânes, Somnus‡龙骨试炼，索姆努斯‡龍骨試煉，索姆努斯',
    nil,
    'Destrua Somnus, o draco campeão da Revoada Verde. Pegue seu crânio e leve-o para Ardeluta.‡Убейте вожака зеленых драконов Сомнуса и вернитесь с его черепом к Огнебору.‡Vernichtet den Drachenchampion des grünen Drachenschwarms, Somnus. Nehmt seinen Schädel und bringt ihn zu Aschenschwinge zurück.‡녹색용군단의 우두머리 솜누스를 처치한 후 그의 해골을 수습해서 엠버스트라이프에게 돌아가야 합니다.‡Destruye al campeón draco del Vuelo Verde, Somnus. Lleva su calavera a Brasaliza.‡Destruye al Campeón del Vuelo Verde, Somnus. Lleva su cráneo a Brasaliza.‡Détruire le Champion drake du Vol vert, Somnus. Arracher son crâne à son cadavre, puis le rapporter à Brandeguerre.‡杀掉绿龙索姆努斯，把他的颅骨交给埃博斯塔夫。‡殺掉綠龍索姆努斯，把他的顱骨交給埃博斯塔夫。',
  }
},
[6584] = {
  -- Item
  '‡Мундир лазутчика‡Spähertunika‡정찰용 튜닉‡Guerrera de exploración‡Guerrera de exploración‡Tunique de l\'éclaireur‡斥候外套‡斥候外套',
  { -- Npc
    'Rei Mosh‡Король Мош‡König Mosh‡폭군 모쉬‡Rey Mosh‡Rey Mosh‡Roi Mosh‡暴龙之王摩什‡暴龍之王摩什',
    nil,
  },
  nil,
  { -- Quest
    'O teste dos crânios: Chronalis‡Черепа: Хроналис‡Die Prüfung der Schädel, Chronalis‡해골 시험 - 크로날리스‡La prueba de los cráneos, Chronalis‡La prueba de los cráneos, Chronalis‡L\'épreuve des crânes, Chronalis‡龙骨试炼，克鲁纳里斯‡龍骨試煉，克魯納裏斯',
    nil,
    'Guardando as Cavernas do Tempo no Deserto de Tanaris, encontra-se Chronalis, filho de Nozdormu. Destrua-o e leve seu crânio para Ardeluta.‡Убейте Хроналиса, охраняющего Пещеры Времени в Пустыне Танарис и вернитесь с его черепом к Огнебору.‡Chronalis, ein Kind Nozdormus, bewacht die Höhlen der Zeit in der Tanariswüste. Vernichtet ihn und bringt seinen Schädel zu Aschenschwinge.‡노즈도르무의 자손인 크로날리스가 타나리스 사막에 있는 시간의 동굴을 지키고 있습니다. 그를 처치한 후 그의 해골을 엠버스트라이프에게 가져가야 합니다.‡Chronalis, hijo de Nozdormu, custodia las Cavernas del Tiempo en el Desierto de Tanaris. Destrúyelo y lleva su cráneo a Brasaliza.‡Chronalis, hijo de Nozdormu, custodia las Cavernas del Tiempo en el Desierto de Tanaris. Destrúyelo y lleva su cráneo a Brasaliza.‡Chronalis, enfant de Nozdormu, garde les Grottes du temps, dans le Désert de Tanaris. Tuez-le et rapportez son crâne à Brandeguerre.‡诺兹多姆的孩子克鲁纳里斯在塔纳利斯沙漠守卫着时光之穴。杀了他，把他的颅骨交给埃博斯塔夫。‡諾茲多姆的孩子克魯納裏斯在塔納利斯沙漠守衛著時光之穴。殺了他，把他的顱骨交給埃博斯塔夫。',
  }
},
[6585] = {
  -- Item
  '‡Плащ лазутчика‡Späherumhang‡정찰용 망토‡Capa de exploración‡Capa de exploración‡Cape de l\'éclaireur‡斥候披风‡斥探披風',
  { -- Npc
    'Uhk\'loc‡Ак\'лок‡Uhk\'loc‡우크로크‡Uhk\'loc‡Uhk\'loc‡Uhk\'loc‡乌卡洛克‡烏卡洛克',
    nil,
  },
  nil,
  { -- Quest
    'O teste dos crânios: Axtroz‡Черепа: Акстроз‡Die Prüfung der Schädel, Axtroz‡해골 시험 - 악트로즈‡La prueba de las calaveras, Axtroz‡La prueba de los cráneos, Axtroz‡L\'épreuve des crânes, Axtroz‡龙骨试炼，埃克托兹‡龍骨試煉，埃克托茲',
    nil,
    'Vá para Grim Batol e encontre Axtroz, o draco campeão da Revoada Vermelha. Destrua-o e arranque sua cabeça. Leve o crânio para Ardeluta.‡Отправьтесь в Грим Батол и убейте Акстроза, избранного бойца красных драконов. Принесите его череп Огнебору.‡Begebt Euch nach Grim Batol und spürt Axtroz auf, den Drachenchampion des Roten Drachenschwarms. Vernichtet ihn und nehmt seinen Schädel. Bringt den Schädel zu Aschenschwinge zurück.‡그림 바톨로 가서 붉은용군단의 우두머리 악트로즈를 찾아 그를 처치한 다음 그의 해골을 수습하여 엠버스트라이프에게 돌아가야 합니다.‡Viaja a Grim Batol y encuentra a Axtroz, el campeón draco del Vuelo Rojo. Destrúyelo y hazte con su calavera. Llévasela a Brasaliza.‡Viaja a Grim Batol y encuentra a Axtroz, el Campeón del Vuelo Rojo. Destrúyelo y hazte con su cráneo. Llévaselo a Brasaliza.‡Aller à Grim Batol et traquer Axtroz, le Champion drake du Vol rouge. Le tuer et arracher son crâne, puis l’apporter à Brandeguerre.‡到格瑞姆巴托去杀掉红龙埃克托兹，把他的颅骨交给埃博斯塔夫。‡到格瑞姆巴托去殺掉紅龍埃克托茲，把他的顱骨交給埃博斯塔夫。',
  }
},
