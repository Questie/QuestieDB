  nil,
  { -- Quest
    'O lago está para peixe‡Продажа рыбы‡Fischhandel‡물고기 매매‡Pescado a la venta‡Pescado a la venta‡Criée aux poissons‡卖鱼‡賣魚',
    nil,
    'Leve 10 Peixes-lua Malhados para o Mestre de Doca Baren na Vila Plácida.‡Принесите 10 тушек пятнистой рыбы-луны портовому начальнику Барену в Приозерье.‡Bringt 10 gefleckte Sonnenfische nach Seenhain zu Dockmeister Baren.‡레이크샤이어에 있는 항구주임 바렌에게 점박이 개복치 10마리를 가져가야 합니다.‡Lleva 10 peces luna moteados al maestro de embarcadero Baren a Villa del Lago.‡Lleva 10 peces luna moteados al maestro de embarcadero Baren a Villa del Lago.‡Rapporter 10 Poissons-lunes au Chef des docks Baren à Lakeshire.‡给湖畔镇的码头管理员巴伦带去10条斑点太阳鱼。‡給湖畔鎮的碼頭管理員巴倫帶去10條斑點太陽魚。',
  }
},
[128] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Recompensa pelos Rocha Negra‡Награда за головы орков Черной горы‡Kopfgeld auf die Blackrocks‡검은바위부족 현상금‡La recompensa de Roca Negra‡La recompensa de Roca Negra‡La prime Blackrock‡悬赏：黑石氏族‡懸賞：黑石氏族',
    nil,
    'Mate 15 Campeões Rocha Negra e o Guarda Howe vai recompensar você na Vila Plácida.‡Убейте 15 воителей из клана Черной горы.‡Tötet 15 Helden der Blackrock, dann erhaltet Ihr von Wache Howe aus Seenhain eine Belohnung.‡검은바위부족 용사 15명을 처치하십시오. 그러면 레이크샤이어의 경비병 하우가 보상을 해줄 것입니다.‡Mata a 15 campeones Roca Negra y el guardia Howe te recompensará en Villa del Lago.‡Mata a 15 campeones Roca Negra y el guardia Howe te recompensará en Villa del Lago.‡Tuez 15 Champions Blackrock et le garde Howe de Lakeshire vous récompensera.‡杀死15名黑石勇士，并向湖畔镇的卫兵豪维复命。‡殺死15名黑石勇士，並向湖畔鎮的衛兵豪維復命。',
  }
},
[129] = {
  -- Item
  '‡Рваные сапоги зверолова‡Unverwüstliche Fallenstellerstiefel‡주름진 사냥꾼용 장화‡Botas de trampero bastas‡Botas de trampero bastas‡Bottes robustes de trappeur‡皱褶捕兽者之靴‡粗厚捕獸者的靴子',
  nil,
  nil,
  { -- Quest
    'Almoço grátis‡Бесплатный обед‡Ein geschenktes Mittagessen‡공짜 점심‡Una comida gratis‡Una comida gratis‡Un repas gratuit‡免费的午餐‡免費的午餐',
    nil,
    'Leve o Almoço do Florestan para o Guarda Florestan. Ele patrulha a estrada que leva à Vila Sombria.‡Отнесите обед стражнику Паркеру. Он патрулирует дорогу, ведущую в Темнолесье.‡Bringt Parkers Mittagessen zu Wache Parker. Er ist auf der Straße nach Dunkelhain auf Patrouille.‡다크샤이어로 가는 도로를 순찰하고 있는 경비병 파커의 도시락을 가져가야 합니다.‡Llévale su comida al guardia Parker. Está de patrulla en el camino a Villa Oscura.‡Llévale su comida al guardia Parker. Está de patrulla en el camino a Villa Oscura.‡Apporter son déjeuner au Garde Parker. Il patrouille sur la route qui mène au Darkshire.‡将卫兵帕克的午餐带给他，他就在通向夜色镇的路上巡逻。‡將衛兵帕克的午餐帶給他，他就在通向夜色鎮的路上巡邏。',
  }
},
[130] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Visita à herborista‡Визит к травнице‡Besuch im Kräuterladen‡약초채집가 방문‡Una visita al herborista‡Una visita al herborista‡Une visite chez l\'herboriste‡寻访草药师‡尋訪草藥師',
    nil,
    'Falar com a Herborista de Cristarrubra, Martie Jainrose.‡Поговорите с травницей Красногорья Марти Джайнроз.‡Sprecht mit der Kräuterkundigen des Rotkammgebirges, Martie Jainrose.‡붉은마루 산맥 약초채집가, 마티 제인로즈와 대화하십시오.‡Habla con Martie Jainrose, la herborista de Crestagrana.‡Habla con Martie Jainrose, la herborista de Crestagrana.‡Parler à Martie Jainrose, l\'Herboriste des Carmines.‡找到草药师玛蒂·詹罗斯，和她谈一谈。‡找到草藥師瑪蒂·詹羅斯，和她談壹談。',
  }
},
[131] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Narcisos para entrega‡Доставка нарциссов‡Narzissen für eine Dame‡나팔수선화 배달‡Un ramo de narcisos‡Un ramo de narcisos‡Bouquet de jonquilles‡水仙诉衷情‡水仙訴衷情',
    nil,
    'Dê para Darcy o Buquê de Narcisos.‡Отнесите Дарси букет нарциссов.‡Gebt Darcy den Narzissenstrauß.‡달시에게 나팔수선화 꽃다발을 주어야 합니다.‡Dale el ramo de narcisos a Darcy.‡Dale el ramo de narcisos a Darcy.‡Donner à Darcy le bouquet de jonquilles.‡将水仙花送给达希。‡將水仙花送給達希。',
  }
},
[132] = {
  nil,
  nil,
  nil,
  { -- Quest
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Leve o Bilhete do Wiley para Miguel Mantoforte no Cerro Oeste.‡Отнесите записку Вилли Гриану Камнегриву в Западный Край.‡Bringt Wileys Nachricht nach Westfall zu Gryan Stoutmantle.‡서부 몰락지대에 있는 그라이언 스타우트맨틀에게 와일리의 쪽지를 전달해야 합니다.‡Lleva la Nota de Wiley a Gryan Mantorrecio en los Páramos de Poniente.‡Lleva la Nota de Wiley a Gryan Mantorrecio en los Páramos de Poniente.‡Apporter la Note de Wiley à Gryan Stoutmantle, dans la marche de l\'Ouest‡将威利的便笺交给西部荒野的格里安·斯托曼。‡將威利的便箋交給西部荒野的格裏安·斯托曼。',
  }
},
[133] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Boneco de carniçal‡Фигурка вурдалака‡Ein Ghulbildnis‡구울 허수아비‡Un espantapájaros para necrófagos‡Un espantapájaros para necrófagos‡L\'épouvantail à goules‡食尸鬼假人‡食屍鬼假人',
    nil,
    'Colete 7 Costelas de Carniçal e leve-as para Abercrombie na cabana dele.‡Добудьте 7 ребер вурдалаков и принесите их в хижину Аберкромби.‡Sammelt 7 Ghulrippen und bringt sie zu Calvinius in seiner Hütte.‡구울 해골 7개를 모아 통나무집에 있는 에이버크롬비에게 가져가야 합니다.‡Reúne 7 costillas de necrófago y llévaselas a Abercrombie a su cabaña.‡Reúne 7 costillas de necrófago y llévaselas a Abercrombie a su cabaña.‡Trouver 7 Côtes de goule. Les apporter à Abercrombie dans sa cabane.‡收集7个食尸鬼的肋骨，然后把它们交给亚伯克隆比。‡收集7個食屍鬼的肋骨，然後把它們交給亞伯克隆比。',
  }
},
[134] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Ogros ladrões‡Нападение огров‡Ogerdiebe‡오우거 도적 떼‡Ladrones ogros‡Ladrones ogros‡Les ogres voleurs‡食人魔潜行者‡食人魔潛行者',
    nil,
    'Devolva o Caixote do Abercrombie para o Abercrombie.‡Вернуть ящик Аберкромби владельцу.‡Bringt Calvinius\' Kiste zu Calvinius.‡에이버크롬비에게 에이버크롬비의 상자를 되찾아 주어야 합니다.‡Devuelve a Abercrombie la caja de Abercrombie.‡Devuelve a Abercrombie el cajón de Abercrombie.‡Rapporter sa caisse à Abercrombie.‡把亚伯克隆比的箱子拿回来交给他。‡把亞伯克隆比的箱子拿回來交給他。',
  }
},
[135] = {
