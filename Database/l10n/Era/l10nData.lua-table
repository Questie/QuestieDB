[5761] = {
  -- Item
  '‡Деревянный молот Старой Наковальни‡Ambossarvorschlaghammer‡앤빌마 해머‡Almádena Yunquemar‡Almádena Yunquemar‡Merlin de Courbenclume‡安威玛尔战锤‡安威瑪戰錘',
  { -- Npc
    'Trôpego Anormal‡Загадочный шаркун‡Deviatschlurfer‡돌연변이 늪괴물‡Arrastrado descarriado‡Arrastrapiés descarriado‡Glacial déviant‡变异蹒跚者‡變異蹣跚者',
    nil,
  },
  nil,
  { -- Quest
    'Mate a besta‡Убить тварь‡Vernichtung der Bestie‡야수 처단‡Matar a la bestia‡Matar a la bestia‡Tuer la bête‡饥饿者塔拉加曼‡饑餓者塔拉加曼',
    nil,
    'Entre nas Cavernas Ígneas e mate Taragaman, o Famélico, depois leve o coração dele para Neeru Cortafogo em Orgrimmar.‡Спуститесь в Огненную пропасть, убейте Тарагамана Ненасытного и принесите его сердце Нииру Огненному Клинку в Оргриммаре.‡Begebt Euch in den Ragefireabgrund und erschlagt Taragaman den Hungerleider. Bringt anschließend dessen Herz zu Neeru Fireblade nach Orgrimmar.‡성난불길 협곡으로 가서 욕망의 타라가만을 제거한 다음 그의 심장을 오그리마에 있는 네루 파이어블레이드에게 가져가야 합니다.‡Ve a la Sima Ígnea, mata a Taragaman el Hambriento y llévale su corazón a Neeru Hojafuego a Orgrimmar.‡Ve a la Sima Ígnea, mata a Taragaman el Hambriento y llévale su corazón a Neeru Hojafuego a Orgrimmar.‡Pénétrer dans le Gouffre de Ragefeu et tuer Taragaman l\'Affameur, puis rapporter son coeur à Neeru Fireblade à Orgrimmar.‡进入怒焰裂谷，杀死饥饿者塔拉加曼，然后把他的心脏交给奥格瑞玛的尼尔鲁·火刃。‡進入怒焰裂谷，殺死饑餓者塔拉加曼，然後把他的心臟交給奧格瑞瑪的尼爾魯·火刃。',
  }
},
[5762] = {
  -- Item
  '‡Красная льняная сумка‡Rote Leinentasche‡빨간 리넨 가방‡Bolsa de lino roja‡Bolsa de lino roja‡Sac rouge en lin‡红色亚麻包‡紅色亞麻包',
  { -- Npc
    'Caninana Anormal‡Загадочная болотная гадюка‡Deviatmokassinschlange‡돌연변이 늪살무사‡Mocasiero descarriado‡Mocasiero descarriado‡Mocassin d\'eau déviant‡弱毒飞蛇‡弱毒飛蛇',
    nil,
  },
  nil,
  { -- Quest
    'Rosarães Guima‡Хеминг Эрнестуэй‡Hemet Nesingwary‡헤멧 네싱워리‡Hemet Decautela‡Hemet Nesingwary‡Hemet Nesingwary‡赫米特·奈辛瓦里‡赫米特·奈辛瓦裏',
    nil,
    'Leve o Caixote de Kravel para Rosarães Guima na Selva do Espinhaço.‡Отнесите ящик Крейвела Хемингу Эрнестуэю в Тернистую долину.‡Bringt Kravels Kiste zu Hemet Nesingwary ins Schlingendorntal.‡가시덤불 골짜기에 있는 헤멧 네싱워리에게 크레이블의 상자를 가져가야 합니다.‡Llévale la caja de Kravel a Hemet Decautela, que está en Tuercespina.‡Lleva el cajón de Kravel a Hemet Nesingwary en Tuercespina.‡Apporter la Caisse de Kravel à Hemet Nesingwary, à Strangleronce.‡将克拉维尔的箱子送到荆棘谷的赫米特·奈辛瓦里那里。‡將克拉維爾的箱子送到荊棘谷的赫米特·奈辛瓦裏那裏。',
  }
},
