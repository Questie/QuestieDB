  nil,
  { -- Quest
    'Entrega para Lançatroz‡Посылка для Грозовой Вершины‡Stormpikes Lieferung‡스톰파이크에게 소포 배달‡Una entrega a Pico Tormenta‡Una entrega a Pico Tormenta‡Livraison pour Stormpike‡雷矛的包裹‡雷矛的包裹',
    nil,
    'Entregue o Pacote para Lançatroz para o Montanhista Lançatroz em Loch Modan.‡Доставьте посылку горному пехотинцу Грозовой Вершине в Лок Модан.‡Bringt das Päckchen für Stormpike zu Gebirgsjäger Stormpike am Loch Modan.‡모단 호수에 있는 산악경비대 스톰파이크에게 스톰파이크의 소포를 배달해야 합니다.‡Entrega el paquete Pico Tormenta al montaraz Pico Tormenta en Loch Modan.‡Entrega el paquete Pico Tormenta al montaraz Pico Tormenta en Loch Modan.‡Livrer le Paquet au montagnard Stormpike au Loch Modan.‡把给卡尔·雷矛的包裹交给洛克莫丹北部哨塔里的巡山人卡尔·雷矛。‡把給卡爾·雷矛的包裹交給洛克莫丹北部哨塔裏的巡山人卡爾·雷矛。',
  }
},
[354] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Mortes na família‡Смерти в семье‡Todesfälle in der Familie‡가문의 몰살‡Muertes en la familia‡Muertes en la familia‡Morts dans la Famille‡阿加曼德家族‡阿加曼德家族',
    nil,
    'Obtenha os Restos Mortais de Gregor, os Restos Mortais de Nissa, os Restos Mortais de Timóteo para Eurico Palhares em Montalvo.‡Принесите останки Грегора, останки Ниссы и останки Турмана Колману Фартингу в Брилл.‡Bringt Coleman Farthing in Brill Gregors Überreste, Nissas Überreste und Thurmans Überreste.‡브릴에 있는 콜만 파딩에게 그레고르의 유골, 니사의 유해, 투르만의 유골을 가져가야 합니다.‡Llévale los restos de Gregor, los restos de Nissa y los restos de Thurman a Coleman Lontananza, que está en Rémol.‡Llévale los restos de Gregor, los restos de Nissa y los restos de Thurman a Coleman Farthing, que está en Rémol.‡Rapporter les restes de Gregor, de Nissa et de Thurman à Coleman Farthing, à Brill.‡把格里高的遗骸、妮萨的残骸和萨尔曼的遗骸交给布瑞尔的库勒曼·法席恩。‡把格裏高的遺骸、妮薩的殘骸和薩爾曼的遺骸交給布瑞爾的庫勒曼·法席恩。',
  }
},
[355] = {
  nil,
  nil,
  nil,
  { -- Quest
    'Fale com Sevren‡Разговор с Севреном‡Gespräch mit Sevren‡세브렌과의 대화‡Habla con Sevren‡Habla con Sevren‡Parler à Sevren‡与塞弗伦交谈‡與塞弗倫交談',
    nil,
    'Fale com o Magistrado Sevren em Montalvo.‡Поговорите с мировым судьей Севреном в Брилле.‡Sprecht mit Magistrat Sevren in Brill.‡브릴에 있는 집정관 세브렌과 대화해야 합니다.‡Habla con el magistrado Sevren de Rémol.‡Habla con el magistrado Sevren de Rémol.‡Parler au magistrat Sevren à Brill.‡与布瑞尔的执政官塞弗伦谈一谈。‡與布瑞爾的執政官塞弗倫談壹談。',
  }
},
[356] = {
  nil,
  { -- Npc
    'Riding Wolf (Black)‡Черный волк‡Reitwolf (Schwarz)‡길들인 검은색 늑대‡Lobo de montar (negro)‡Lobo de montar (negro)‡Loup (noir)‡骑乘用狼（黑色）‡騎乘座狼(黑色)',
    nil,
