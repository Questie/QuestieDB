[8673] = {
  nil,
  { -- Npc
    'Leiloeiro Bendotado‡Аукционер Скаботун‡Auktionator Thathung‡경매인 타퉁‡Subastador Thathung‡Subastador Thathung‡Commissaire-priseur Thathung‡拍卖师萨苏恩‡拍賣師薩蘇恩',
