  nil,
  { -- Quest
    'O melhor pupilo de Galvan‡Лучший ученик Гальвана‡Galvans bester Schüler‡갈반의 수제자‡El mejor alumno de Galvan‡El mejor alumno de Galvan‡Le meilleur disciple de Galvan‡加尔文的得意门生‡加爾文的得意門生',
    nil,
    'Fale com Trenton Lumartelo em Geringontzan.‡Поговорите с Трентоном Молотом Света из Прибамбасска.‡Sprecht in Gadgetzan mit Trenton Lighthammer.‡가젯잔에 있는 트렌튼 라이트해머와 대화해야 합니다.‡Habla con Trenton Mazaligera en Gadgetzan.‡Habla con Trenton Mazaligera en Gadgetzan, en Tanaris.‡Parler à Trenton Lighthammer à Gadgetzan.‡和加基森的特伦顿·轻锤谈一谈。‡和加基森的特倫頓·輕錘談壹談。',
  }
},
[2765] = {
