[999] = {
  nil,
  { -- Npc
    'Vigia Royce‡Дозорный Ройс‡Behüterin Royce‡순찰대원 로이스‡Vigía Royce‡Vigía Royce‡Gardienne Royce‡守夜人罗伊斯‡守夜人羅伊斯',
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡La Guardia Nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
  },
  nil,
