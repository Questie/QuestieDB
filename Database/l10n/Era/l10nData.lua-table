[6281] = {
  -- Item
  'Crânio de Range-ossos‡Череп гремучего скелета‡Schädel eines klappernden Skeletts‡덜그럭거리는 해골‡Calavera armadósea‡Calavera armadósea‡Crâne de Cliquethorax‡断骨骷髅的颅骨‡斷骨骷髏的顱骨',
  nil,
  nil,
  { -- Quest
    'Siga para Ventobravo‡Продолжение пути в Штормград‡Weiter nach Stormwind‡스톰윈드로 이동‡Prosigue hasta Ventormenta‡Prosigue hasta Ventormenta‡Continuer vers Stormwind‡赶赴暴风城‡趕赴暴風城',
    nil,
    'Compre uma passagem de grifo do mestre de grifos Thor, e leve o Bilhete do Ludovico para Larso Norde na loja Imunidade Limitada, que fica na Cidade Velha, em Ventobravo.‡Оплатите укротителю грифонов Тору полет до Штормграда и принесите записку Льюиса Озрику Штрангу в магазинчик "Ограниченная неуязвимость", расположенный в районе Старого города.‡Bucht einen Greifenritt bei Greifenmeister Thor, dann bringt Lewis\' Notiz zu Osric Strang, im Laden Begrenzte Immunität, in Stormwind.‡그리핀 조련사 토르에게 요금을 지급하고 그리핀을 탄 다음 루이스의 쪽지를 스톰윈드에 있는 오스릭 스트랑에게 가져가야 합니다. 오스릭은 스톰윈드의 구 시가지에 있는 품질보증 갑옷 상점에 있습니다.‡Cómprale al maestro de grifos Thor un vuelo en grifo y lleva la Nota de Lewis a Osric Strang, en la tienda Inmunidad Limitada, en el Casco Antiguo de Ventormenta.‡Cómprale al maestro de grifos Thor un vuelo en grifo y lleva la Nota de Lewis a Osric Strang, en la tienda Inmunidad Limitada, en el Casco Antiguo de Ventormenta.‡Achetez un voyage en gryphon à Thor, Maître des gryphons, puis apportez la Note de Lewis à Osric Strang au magasin “Immunité limitée”, dans la vieille ville de Stormwind.‡从狮鹫管理员索尔那里租用一头狮鹫，然后把刘易斯的便笺交给暴风城的奥斯瑞克·斯图恩。‡從獅鷲管理員索爾那裏租用壹頭獅鷲，然後把劉易斯的便箋交給暴風城的奧斯瑞克·斯圖恩。',
  }
},
[6282] = {
  -- Item
  '‡Священные погребальные брюки‡Heilige Begräbnisbeinkleider‡성지의 바지‡Calzas de entierro sacro‡Calzas de entierro sacro‡Chausses de rituel funéraire‡神圣的葬礼长裤‡神聖的葬禮長褲',
  nil,
  nil,
  { -- Quest
    'Harpias ameaçadoras‡Угроза со стороны гарпий‡Harpyien drohen‡하피의 위협‡La ameneza de la arpías‡La amenaza de las arpías‡La menace des harpies‡鹰身人的威胁‡鷹身人的威脅',
    nil,
    'Maggran Ata Terra, no Retiro Rocha do Sol, quer que você mate 7 Hapias Furissague, 7 Emboscadoras Furissangue, 7 Matadoras Furissangue e 7 Plumerrantes Furissangue.‡Землепряд Маггран из Приюта у Солнечного Камня просит вас убить 7 гарпий, 7 душительниц, 7 душегубок и 7 бродяжниц из стаи Кровавой Ярости.‡Maggran Earthbinder in Sonnenfels möchte, dass Ihr 7 Harpyien der Blutfurien, 7 Wegelagerinnen der Blutfurien, 7 Töterinnen der Blutfurien und 7 Wildfedern der Blutfurien erschlagt.‡해바위 야영지에 있는 마그그랜 어스바인더가 혈폭풍일족 하피, 복병, 암살자, 약탈자를 각각 7마리씩 처치해달라고 부탁했습니다.‡Maggran Ligaterra en el Refugio Roca del Sol quiere que mates 7 arpías Furia Sangrienta, 7 emboscadores Furia Sangrienta, 7 cazadores Furia Sangrienta y 7 Plumapícaros Furia Sangrienta.‡Maggran Vinculador Terrestre, en el Refugio Roca del Sol, quiere que mates 7 arpías Furia Sangrienta, 7 emboscadoras Furia Sangrienta, 7 destripadoras Furia Sangrienta y 7 malaplumas Furia Sangrienta.‡Maggran Earthbinder de la retraite de Roche-Soleil veut que vous anéantissiez sept Harpies, sept Embusquées, sept Tueuses et sept Volplumes Rougefuries.‡烈日石居的马格兰要你去杀掉7个血怒鹰身人、7个血怒伏击者、7个血怒杀戮者和7个血怒游荡者。‡烈日石居的馬格蘭要妳去殺掉7個血怒鷹身人、7個血怒伏擊者、7個血怒殺戮者和7個血怒遊蕩者。',
  }
},
[6283] = {
  -- Item
  'O Livro de Ur‡Книга Ура‡Das Buch von Ur‡우르의 책‡El libro de Ur‡El libro de Ur‡Le Livre d\'Ur‡乌尔之书‡烏爾之書',
  nil,
  nil,
  { -- Quest
    'O sangue das Furissangue‡Предводительница клана Кровавой Ярости‡Blutfuriengeschlecht‡혈폭풍일족의 혈통‡El linaje Furia Sangrienta‡El linaje Furia Sangrienta‡La lignée Rougefurie‡血怒一族‡血怒壹族',
    nil,
    'Maggram, no Retiro Rocha do Sol, quer que você mate a Estripadora Furissangue e traga os restos mortais dela como prova de seu feito.‡Маггран из Приюта у Солнечного Камня просит убить Потрошительницу из стаи Кровавой Ярости и принести ему ее останки в доказательство того, что она мертва.‡Maggran in Sonnenfels möchte, dass Ihr die Zerfetzerin der Blutfurien beseitigt und ihre sterblichen Überreste als Beweis für Eure Tat mitbringt.‡해바위 야영지에 있는 마그그랜 어스바인더가 혈폭풍일족 갈퀴발톱을 처치하고 그 증거로 그녀의 유해를 가져오라고 부탁했습니다.‡Maggran, en el Refugio Roca del Sol, quiere que mates a la Destripadora Furia Sangrienta y le lleves sus restos como prueba de tu hazaña.‡Maggran, en el Refugio Roca del Sol, quiere que mates a la desgarradora Furia Sangrienta y le lleves sus restos como prueba de tu hazaña.‡Maggran, à la Retraite de Roche-Soleil, vous demande de détruire la Déchiqueteuse Rougefurie et de rapporter son corps comme preuve de votre exploit.‡烈日石居的马格兰要你去杀掉血怒撕裂者，然后把她的遗体带回来作为证据。‡烈日石居的馬格蘭要妳去殺掉血怒撕裂者，然後把她的遺體帶回來作為證據。',
  }
},
[6284] = {
  -- Item
  '‡Руны Призыва‡Runen der Beschwörung‡소환의 룬‡Runas de Invocación‡Runas de Invocación‡Runes d\'invocation‡召唤符文‡召喚符文',
  nil,
  nil,
  { -- Quest
    'Aracnofobia‡Арахнофобия‡Arachnophobie‡거미의 공포‡Aracnofobia‡Aracnofobia‡Arachnophobie‡贝瑟莱斯‡貝瑟萊斯',
    nil,
    'Mate Besseleth e leve a Presa de Besseleth a Maggran no Retiro Rocha do Sol.‡Убейте Бесселет и принесите клык Бесселет Магграну в Приют у Солнечного Камня.‡Tötet Besseleth und bringt Besseleths Fangzahn zu Maggran in Sonnenfels.‡베스셀레스를 처치하고 그 증거로 베스셀레스의 송곳니를 들고 해바위 야영지의 마그그랜에게 가져가야 합니다.‡Mata a Besseleth y lleva el colmillo de Besseleth a Maggran en el Refugio Roca del Sol.‡Mata a Besseleth y lleva el colmillo de Besseleth a Maggran en el Refugio Roca del Sol.‡Tuer Besseleth, et apporter le Croc de Besseleth à Maggran, dans la Retraite de Roche-Soleil.‡杀掉贝瑟莱斯，然后把贝瑟莱斯的牙齿交给烈日石居的马格兰。‡殺掉貝瑟萊斯，然後把貝瑟萊斯的牙齒交給烈日石居的馬格蘭。',
  }
},
[6285] = {
  -- Item
  'Grimório de Egalin‡Гримуар Эгалина‡Egalins Zauberfoliant‡에갈린의 흑마법서‡Grimorio Egalin‡Grimorio Egalin‡Grimoire d\'Egalin‡埃加林的魔典‡埃加林的魔典',
  nil,
  nil,
  { -- Quest
    'Entrega para Ludovico‡Возвращение к Льюису‡Zurück zu Lewis‡루이스에게 돌아가기‡Regresa con Lewis‡Regresa junto a Lewis‡Aller voir Lewis‡返回西部荒野‡返回西部荒野',
    nil,
    'Compre uma passagem para o Morro da Sentinela do mestre de grifos Dungar Tragolongo. Em seguida, leve o Caixote de Larso para Ludovico, no Morro da Sentinela.‡Оплатите укротителю грифонов Дунгару Долгопиву полет до Сторожевого холма, а затем отнесите ящик Озрика Льюису.‡Bucht einen Greifenritt zur Späherkuppe bei Greifenmeister Dungar Longdrink, dann bringt Osrics Kiste zu Lewis an der Späherkuppe.‡그리핀 조련사 덩가 롱드링크에게 요금을 지급하고 감시의 언덕으로 가는 그리핀을 탄 다음 오스릭의 상자를 감시의 언덕에 있는 루이스에게 가져가야 합니다.‡Compra un vuelo en grifo hasta la Colina del Centinela al maestro de grifos Dungar Tragolargo y lleva el Cajón de Osric a Lewis de la Colina del Centinela.‡Compra un vuelo en grifo hasta la Colina del Centinela al maestro de grifos Dungar Tragolargo y lleva el cajón de Osric a Lewis de la Colina del Centinela.‡Achetez un voyage en gryphon pour la Colline des sentinelles à Dungar Longdrink, Maître des gryphons, puis apportez la Caisse d\'Olric à Lewis à la Colline des sentinelles.‡从狮鹫管理员杜加尔·朗德瑞克那里租用一头狮鹫飞到哨兵岭，然后将奥斯瑞克的箱子交给哨兵岭的刘易斯。‡從獅鷲管理員杜加爾·朗德瑞克那裏租用壹頭獅鷲飛到哨兵嶺，然後將奧斯瑞克的箱子交給哨兵嶺的劉易斯。',
  }
},
