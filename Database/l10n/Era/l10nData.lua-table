[594] = {
  nil,
  { -- Npc
    'Assecla Défias‡Подручный из Братства Справедливости‡Handlanger der Defias‡데피아즈단 심복‡Esbirro Defias‡Esbirro Defias‡Malfrat défias‡迪菲亚匪徒‡迪菲亞匪徒',
