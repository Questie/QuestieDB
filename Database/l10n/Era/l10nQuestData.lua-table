[1791] = {
  {
    'O vigia dos ventos‡Ветростраж‡Der Windbehüter‡바람의감시자‡El Cazavientos‡El Vigía del viento‡La Vigie des vents‡捕风者‡捕風者',
    nil,
    'Fale com Bath\'rah, o Vigia dos Ventos.‡Поговорите с Бат\'ра Ветростражем.‡Sprecht mit Bath\'rah dem Windbehüter.‡바람의감시자 바스라와 대화하십시오.‡Habla con Bath\'rah el Cazavientos.‡Habla con Bath\'rah el Vigía del viento.‡Parler à Bath\'rah la Vigie des vents.‡和捕风者巴斯拉谈一谈。‡和捕風者巴斯拉談壹談。',
  }
},
[1792] = {
