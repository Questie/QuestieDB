[8883] = {
  {
    'Valadar Stelacanto‡Валадар Звездная Песня‡Valadar Starsong‡발라다르 스타송‡Valadar Cantoestelar‡Valadar Cantoestelar‡Valadar Chantétoile‡瓦拉达尔·星歌‡瓦拉達爾·星歌',
    nil,
    'Use o Convite do Festival da Lua na luz da lua para ir à Clareira da Lua. Ao chegar, fale com Valadar Stelacanto no Refúgio Noturno.‡Отправляйтесь в Лунную поляну при помощи приглашения на Лунный фестиваль. Прибыв на место, поговорите с Валадаром Звездной Песней в деревне Ночная Гавань.‡Verwendet die Mondfesteinladung im Mondlicht und reist somit nach Moonglade. Sprecht nach Eurer Ankunft in Nighthaven mit Valadar Starsong.‡달빛 안에서 달의 축제 초대장을 사용하여 달의 숲으로 이동하십시오. 도착하면 나이트헤이븐에 있는 발라다르 스타송과 대화하십시오.‡Utiliza tu Invitación al Festival Lunar en la Luz de Luna y viaja al Claro de la Luna. Cuando llegues, habla con Valadar Cantoestelar en Amparo de la Noche.‡Utiliza tu Invitación al Festival Lunar en la Luz de Luna y viaja al Claro de la Luna. Cuando llegues, habla con Valadar Cantoestelar en Amparo de la Noche.‡Utilisez votre Invitation à la fête lunaire dans la lumière lunaire pour vous rendre à Reflet-de-Lune. À votre arrivée, parlez à Valadar Chantétoile.‡在月光中使用你的春节邀请函前往月光林地，抵达之后与永夜港的瓦拉达尔·星歌谈一谈。‡在月光中使用妳的春節邀請函前往月光林地，抵達之後與永夜港的瓦拉達爾·星歌談壹談。',
  }
},
[8893] = {
  {
    'O super ovomático‡Супер Яйц-О-Матик‡Der Super-Ei-O-Mat‡고성능 자동부화기‡El Superhuevomático‡El Superhuevomático‡Le Super-Oeuf-O-Matic‡超级测蛋器‡超級測蛋器',
    nil,
    nil,
  }
},
[8897] = {
  {
    'Querida Colara‡Дорогая моя Колара‡Liebste Colara‡친애하는 콜라라‡Queridísima Colara:‡Queridísima Colara:‡Très chère Colara,‡亲爱的科兰拉‡親愛的科蘭拉',
    nil,
    'Entregue o Bilhete Cuidadosamente Escrito do Tenente Heldric para Colara Dean em frente ao banco de Ventobravo.‡Отнесите тщательно продуманную записку лейтенанта Хельдрика Коларе Дин, обитающей поблизости от банка в Штормграде.‡Bringt Lieutenant Heldrics sorgfältig verfasste Notiz zu Colara Dean außerhalb der Bank von Stormwind.‡부관 조크린 헬드릭의 정성들여 쓴 쪽지를 스톰윈드 은행 밖에 있는 콜라라 딘에게 전해줘야 합니다.‡Entrega la carta del general Heldric a Colara Dean, que está junto al banco de Ventormenta.‡Entrega la carta del general Heldric a Colara Dean, que está junto al banco de Ventormenta.‡Apporter la Note soigneusement calligraphiée du lieutenant Heldric à Colara Dean, devant la banque de Stormwind.‡将亨德瑞克中尉精心书写的信件交给暴风城银行外面的科兰拉·迪恩。‡將亨德瑞克中尉精心書寫的信件交給暴風城銀行外面的科蘭拉·迪恩。',
  }
},
[8898] = {
  {
    'Querida Colara‡Дорогая моя Колара‡Liebste Colara‡친애하는 콜라라‡Queridísima Colara:‡Queridísima Colara:‡Très chère Colara,‡亲爱的科兰拉‡親愛的科蘭拉',
    nil,
    'Entregue a Carta Vincada para Colara Dean em frente ao banco de Ventobravo.‡Отнесите смятое письмо Коларе Дин, обитающей поблизости от банка в Штормграде.‡Bringt den zerknitterten Brief zu Colara Dean außerhalb der Bank in Stormwind.‡스톰윈드 은행 밖에 있는 콜라라 딘에게 반으로 접힌 편지를 전달해야 합니다.‡Entrega la carta arrugada a Colara Dean, que está junto al banco de Ventormenta.‡Entrega la carta arrugada a Colara Dean, que está junto al banco de Ventormenta.‡Apporter la Lettre froissée à Colara Dean, devant la banque de Stormwind.‡将皱褶的信件交给暴风城银行外面的科兰拉·迪恩。‡將皺褶的信件交給暴風城銀行外面的科蘭拉·迪恩。',
  }
},
[8899] = {
  {
    'Querida Colara‡Дорогая моя Колара‡Liebste Colara‡친애하는 콜라라‡Queridísima Colara:‡Queridísima Colara:‡Très chère Colara,‡亲爱的科兰拉‡親愛的科蘭拉',
    nil,
    'Entregue a Carta Imaculada para Colara Dean, que está em frente ao banco de Ventobravo.‡Отнесите безукоризненное письмо Коларе Дин, обитающей поблизости от банка в Штормграде.‡Bringt den makellosen Brief zu Colara Dean außerhalb der Bank von Stormwind.‡스톰윈드 은행 밖에 있는 콜라라 딘에게 깔끔한 장식의 편지를 전해야 합니다.‡Entrega la carta impoluta a Colara Dean, que está junto al banco de Ventormenta.‡Entrega la carta impoluta a Colara Dean, que está junto al banco de Ventormenta.‡Apporter la Lettre immaculée à Colara Dean, devant la banque à Stormwind.‡将精美的信件交给暴风城银行外面的科兰拉·迪恩。‡將精美的信件交給暴風城銀行外面的科蘭拉·迪恩。',
  }
},
[8900] = {
  {
    'Querida Helena‡Дорогая моя Эления‡Liebste Elenia‡친애하는 엘레니아에게‡Queridísima Elenia:‡Queridísima Elenia:‡Très chère Elenia,‡亲爱的艾琳娜‡親愛的艾琳娜',
    nil,
    'Entregue o Bilhete Levemente Vincado para Helena Raiol perto do banco da Cidade Baixa.‡Отнесите слегка помятую записку Элении Хайдон, обитающей поблизости от банка в Подгороде.‡Bringt die leicht zerknitterte Notiz zu Elenia Haydon nahe der Bank in Undercity.‡언더시티의 은행 근처에 있는 엘레니아 헤이돈에게 살짝 접힌 쪽지를 전해야 합니다.‡Entrega la nota arrugada a Elenia Haydon, que está cerca del banco en Entrañas.‡Entrega la nota arrugada a Elenia Haydon, que está cerca del banco en Entrañas.‡Apporter la Note légèrement froissée à Elenia Haydon, près de la banque d\'Undercity.‡将轻折的信件交给幽暗城银行附近的艾琳娜·海东。‡將輕折的信件交給幽暗城銀行附近的艾琳娜·海東。',
  }
},
[8901] = {
  {
    'Querida Helena‡Дорогая моя Эления‡Liebste Elenia‡친애하는 엘레니아에게‡Queridísima Elenia:‡Queridísima Elenia:‡Très chère Elenia,‡亲爱的艾琳娜‡親愛的艾琳娜',
    nil,
    'Entregue a Carta Cuidadosamente Escrita para Helena Raiol perto do banco na Cidade Baixa.‡Отнесите тщательно продуманное письмо Элении Хайдон, обитающей поблизости от банка в Подгороде.‡Bringt den sorgfältig verfassten Brief zu Elenia Haydon nahe der Bank in Undercity.‡언더시티의 은행 근처에 있는 엘레니아 헤이돈에게 정성들여 쓴 편지를 전해야 합니다.‡Entrega la carta muy bien escrita a Elenia Haydon, que está cerca del banco en Entrañas.‡Entrega la carta muy bien escrita a Elenia Haydon, que está cerca del banco en Entrañas.‡Apporter la Lettre écrite avec soin à Elenia Haydon, près de la banque d\'Undercity.‡将精心书写的信件交给幽暗城银行附近的艾琳娜·海东。‡將精心書寫的信件交給幽暗城銀行附近的艾琳娜·海東。',
  }
},
[8902] = {
  {
    'Querida Helena‡Дорогая моя Эления‡Liebste Elenia‡친애하는 엘레니아에게‡Queridísima Elenia:‡Queridísima Elenia:‡Très chère Elenia,‡亲爱的艾琳娜‡親愛的艾琳娜',
    nil,
    'Entregue a Carta Escrita com Amor para Helena Raiol, que está perto do banco da Cidade Baixa.‡Отнесите письмо, написанное с любовью, Элении Хайдон, обитающей поблизости от банка в Подгороде.‡Bringt den liebevoll verfassten Brief zu Elenia Haydon nahe der Bank in Undercity.‡언더시티의 은행 근처에 있는 엘레니아 헤이돈에게 사랑이 담긴 편지를 전해야 합니다.‡Entrega la carta de amor a Elenia Haydon, que está cerca del banco en Entrañas.‡Entrega la carta de amor a Elenia Haydon, que está cerca del banco en Entrañas.‡Apporter la Lettre pleine d\'amour à Elenia Haydon, près de la banque d’Undercity.‡将充满感情的信件交给幽暗城银行附近的艾琳娜·海东。‡將充滿感情的信件交給幽暗城銀行附近的艾琳娜·海東。',
  }
},
[8903] = {
  {
    'Paixonite aguda‡Опасная любовь‡Gefährliche Liebschaft‡위험한 사랑‡Amor peligroso‡Amor peligroso‡Les périls de l\'amour‡危险的爱情‡危險的愛情',
    nil,
    'Pegue um Cartão do Guarda de Ventobravo e entregue-o para Aristeu Motta em Ventobravo.‡Возьмите открытку штормградского стражника и отдайте ее Аристану Моттару в Штормграде.‡Besorgt die Karte einer Wache von Stormwind und bringt sie zu Aristan Mottar in Stormwind.‡스톰윈드 경비병의 카드를 스톰윈드에 있는 아리스탄 모탈에게 가져가야 합니다.‡Lleva una tarjeta de guardia de Ventormenta a Aristan Mottar a Ventormenta.‡Consigue una tarjeta de guardia de Ventormenta y llévasela a Aristan Mottar a Ventormenta.‡Obtenez une Carte de garde de Stormwind et ramenez-là à Aristan Mottar, à Stormwind.‡弄到一张暴风城卫兵的卡片，并把它交给暴风城的阿瑞斯坦·莫塔。‡弄到壹張暴風城衛兵的卡片，並把它交給暴風城的阿瑞斯坦·莫塔。',
  }
},
[8904] = {
  {
    'Paixonite aguda‡Опасная любовь‡Gefährliche Liebschaft‡사랑이라는 위험한 병‡Amor peligroso‡Amor peligroso‡Les périls de l\'amour‡危险的爱情‡危險的愛情',
    nil,
    'Pegue um Cartão Mofado do Guardião e entregue-o para Félix Amado na Cidade Baixa.‡Возьмите заплесневелую открытку стража и отнесите ее Фенстаду Аргайлу в Подгороде.‡Besorgt eine modrige Karte des Wächters und bringt sie zu Fenstad Argyle in Undercity.‡언더시티 수호병의 곰팡이 슨 카드를 구해서 언더시티의 펜스타드 아가일에게 가져가야 합니다.‡LLeva una tarjeta mohosa de guardián a Fenstad Argyle a Entrañas.‡Lleva una tarjeta mohosa de guardián a Fenstad Argyle a Entrañas.‡Obtenez une Carte de garde moisie et rapportez-la à Fenstad Argyle, à Fossoyeuse.‡弄到一张发臭的卡片，并把它交给幽暗城的芬斯塔·艾吉勒。‡弄到壹張發臭的卡片，並把它交給幽暗城的芬斯塔·艾吉勒。',
  }
},
[8905] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Consiga 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braçadeiras do Coração Selvagem e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних Ключей и 20 золотых монет и отдайте их вместе с наручами Буйного Сердца Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Armschienen des Wildherzens zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 자연의정수 팔보호구를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales Corazón Salvaje a Deliana a Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales Corazón Salvaje a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Brassards du Coeur-sauvage à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币以及一副野性之心护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣以及壹副野性之心護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8906] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Consiga 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braceletes do Espreitador de Feras e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних ключей и 20 золотых и отдайте их вместе с наручниками Загонщика Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Bestienjägerbindungen zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 야수추적자 손목띠를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 juego de ataduras de acechabestias a Deliana a Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales de acechabestias a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Manchettes de bestiaire à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副野兽追猎者护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副野獸追獵者護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8907] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braceletes do Magíster e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних Ключей и 20 золотых монет и отдайте их вместе с наручниками Магистра Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Bindungen des Magisters zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 원소술사 손목띠를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 juego de ataduras de magister a Deliana a Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales de magister a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Bracelets de magistère à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副博学者腕轮交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副博學者腕輪交給鐵爐堡的德莉亞娜。',
  }
},
[8908] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braçadeiras da Forja de Luz e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних ключей и 20 золотых и отдайте их вместе с наручами светлой стали Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Armschienen des Lichts zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 성전사 팔보호구를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales Forjaluz a Deliana a Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales Forjaluz a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Brassards de Sancteforge à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副光铸护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副光鑄護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8909] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, 1 par de Braçadeiras do Devoto e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних ключей и 20 золотых и отдайте их вместе с наручами Преданности Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Armschienen des Gläubigen zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 기원의 팔보호구를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales de devoto a Deliana a Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales de devoto a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Brassards de dévot à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副虔诚护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副虔誠護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8910] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Consiga 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braçadeiras da Arte Sombria e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних Ключей и 20 золотых монет и отдайте их вместе с наручами Незаметности Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Armschienen der Schattenkunst zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 어둠추적자 팔보호구를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales arte sombrío a Deliana a Forjaz.|n‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales arte sombrío a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Bracelets Sombreruse à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副迅影护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副迅影護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8911] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Consiga 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braçadeiras de Brumedo e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних Ключей и 20 золотых монет и отдайте их вместе с наручами Багрового Тумана Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Armschienen der Furcht zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 공포의안개 팔보호구를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales calígine a Deliana a Forjaz.|n‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales calígine a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Brassards de Brume-funeste à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副鬼雾护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副鬼霧護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8912] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Sangue de Hibérnia, 20 peças de ouro, um par de Braçadeiras do Valor e leve para Deliana, em Altaforja.‡Добудьте 15 порций крови животных Зимних Ключей и 20 золотых монет и отдайте их вместе с наручами Доблести Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterspring und bringt sie zusammen mit 20 Gold und einem Paar Armschienen der Ehre zu Deliana in Ironforge.‡여명의 설원 혈액 견본 15개와 20골드, 용맹의 팔보호구를 가지고 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales de valor a Deliana a Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de brazales de valor a Deliana a Forjaz.‡Procurez-vous 15 Echantillons de sang du Berceau-de-l\'hiver et 20 pièces d’or, et apportez-les avec une paire de Brassards de vaillance à Deliana à Ironforge.‡将15份冬泉谷血样、20枚金币，以及一副勇气护腕交给铁炉堡的德莉亚娜。‡將15份冬泉谷血樣、20枚金幣，以及壹副勇氣護腕交給鐵爐堡的德莉亞娜。',
  }
},
[8913] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Peçonha de Silithus, 20 peças de ouro, um par de Braçadeiras do Coração Selvagem e leve para Mokvar, em Orgrimmar.‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручами Буйного Сердца Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Armschienen des Wildherzens zu Mokvar in Orgrimmar zurück.‡오그리마에 있는 모크바르에게 실리시드 독 견본 15개와 20골드를 자연의정수 팔보호구 1개와 함께 가져가야 합니다.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales Corazón Salvaje a Mokvar a Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales Corazón Salvaje a Mokvar a Orgrimmar.‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d’or, et apportez-les avec une paire de Brassards du Coeur-sauvage à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副野性之心护腕交给奥格瑞玛的莫克瓦尔。‡將15份希利蘇斯毒液樣品、20枚金幣以及壹副野性之心護腕交給奧格瑞瑪的莫克瓦爾。',
  }
},
[8914] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Peçonha de Silithus, 20 peças de ouro, um par de Braceletes do Espreitador de Feras e leve para Mokvar, em Orgrimmar.‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручниками Загонщика Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Bestienjägerbindungen zu Mokvar in Orgrimmar zurück.‡오그리마에 있는 모크바르에게 실리시드 독 견본 15개와 20골드를 야수추적자 손목띠 1개와 함께 가져가야 합니다.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 juego de ataduras de acechabestias a Mokvar a Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales de acechabestias a Mokvar a Orgrimmar.‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d’or, et apportez-les avec une paire de Manchettes de bestiaire à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副野兽追猎者护腕交给奥格瑞玛的莫克瓦尔。‡將15份希利蘇斯毒液樣品、20枚金幣以及壹副野獸追獵者護腕交給奧格瑞瑪的莫克瓦爾。',
  }
},
[8915] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Peçonha de Silithus, 20 peças de ouro, um par de Braceletes do Magíster e leve para Mokvar, em Orgrimmar.‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручниками Магистра Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Bindungen des Magisters zu Mokvar in Orgrimmar zurück.‡오그리마에 있는 모크바르에게 실리시드 독 견본 15개와 20골드를 원소술사 손목띠 1개와 함께 가져가야 합니다.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales Magister a Mokvar a Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales de magister a Mokvar a Orgrimmar.‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d’or, et apportez-les avec une paire de Bracelets de magistère à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副博学者腕轮交给奥格瑞玛的莫克瓦尔。‡將15份希利蘇斯毒液樣品、20枚金幣以及壹副博學者腕輪交給奧格瑞瑪的莫克瓦爾。',
  }
},
[8916] = {
  {
    'Uma proposta honesta‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡熱心的建議',
    nil,
    'Adquira 15 Amostras de Peçonha de Silithus, 20 peças de ouro, um par de Braçadeiras do Devoto e leve para Mokvar, em Orgrimmar.‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручами Преданности Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Armschienen des Gläubigen zu Mokvar in Orgrimmar zurück.‡오그리마에 있는 모크바르에게 실리시드 독 견본 15개와 20골드를 기원의 팔보호구 1개와 함께 가져가야 합니다.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales Devoción a Mokvar a Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales de devoto a Mokvar a Orgrimmar.‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d’or, et apportez-les avec une paire de Brassards de dévot à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副虔诚护腕交给奥格瑞玛的莫克瓦尔。‡將15份希利蘇斯毒液樣品、20枚金幣以及壹副虔誠護腕交給奧格瑞瑪的莫克瓦爾。',
