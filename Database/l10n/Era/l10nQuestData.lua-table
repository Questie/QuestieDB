[4487] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un malignoecus‡Invoca un corcel vil‡Invoquer un Palefroi corrompu‡召唤地狱战马‡召喚地獄戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Ratchet.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談壹談。',
  }
},
[4488] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un malignoecus‡Invoca un corcel vil‡Invoquer un Palefroi corrompu‡召唤地狱战马‡召喚地獄戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Ratchet.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談壹談。',
  }
},
[4489] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un malignoecus‡Invoca un corcel vil‡Invoquer un Palefroi corrompu‡召唤地狱战马‡召喚地獄戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Ratchet.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談壹談。',
