},
[1880] = {
  {
    'Treconitor magostático‡Маг-тастический гизмонитор‡Magitastischer Gizmonitor‡마법사의 기억장치‡Trastónitor maguitronic‡Trastónitor maguitronic‡Le Bidulotron de youplala‡法师文档存储器‡法師文檔存儲器',
    nil,
    'Devolva o Treconitor Magostático a Bink.‡Верните Бинк маг-тастический гизмонитор.‡Bringt Bink ihren magitastischen Gizmonitor.‡빙크에게 마법사의 기억장치를 가져가야 합니다.‡Llévale a Bink su trastónitor maguitrónic.‡Llévale a Bink su trastónitor maguitrónic.‡Rapporter à Bink son Bidulotron de Youplala.‡帮彬克找回她的法师文档存储器。‡幫彬克找回她的法師文檔存儲器。',
  }
},
[1881] = {
  {
    'Fale com Anastácia Cordato‡Разговор с Анастасией‡Gespräch mit Anastasia‡아나스타샤와의 대화‡Habla con Anastasia‡Habla con Anastasia‡Parler à Anastasia‡安娜斯塔西娅‡安娜斯塔西婭',
    nil,
    'Fale com Anastácia Cordato.‡Поговорите с Анастасией Хартвелл.‡Sprecht mit Anastasia Hartwell.‡아나스타샤 하트웰과 대화하십시오.‡Habla con Anastasia Pozovenado.‡Habla con Anastasia Hartwell.‡Aller voir Anastasia Hartwell.‡和安娜斯塔西娅·哈特威尔谈一谈。‡和安娜斯塔西婭·哈特威爾談壹談。',
  }
},
[1882] = {
  {
    'A Fazenda dos Balnir‡Ферма Балнира‡Balnirs Bauernhof‡발니르 농장‡La Hacienda Balnir‡La Hacienda Balnir‡La ferme des Balnir‡巴尼尔农场‡巴尼爾農場',
    nil,
    'Traga Bocas-de-Leão de Balnir para Anastácia Cordato no Distrito dos Magos da Cidade Baixa.‡Принесите львиный зев Бальнира Анастасии Хартвелл в Магический Квартал Подгорода.‡Bringt Balnir-Löwenmäulchen zu Anastasia Hartwell im Magierviertel von Undercity.‡언더시티의 마법 지구에 있는 아나스타샤 하트웰에게 발니르 금어초를 가져가야 합니다.‡Lleva las Bocas de dragón de Balnir a Anastasia Pozovenado en el Barrio de los Magos de Entrañas.‡Lleva las Bocas de dragón de Balnir a Anastasia Hartwell en el Barrio de los Magos de Entrañas.‡Apporter des Gueules-de-loup du jardin des Balnir à Anastasia Hartwell dans le Quartier de la magie d\'Undercity.‡将巴尼尔金鱼草交给幽暗城法师区的安娜斯塔西娅·哈特威尔。‡將巴尼爾金魚草交給幽暗城法師區的安娜斯塔西婭·哈特威爾。',
  }
},
[1883] = {
  {
    'Fale com Un\'Thuwa‡Разговор с Ун\'Тувой‡Gespräch mit Un\'thuwa‡운투와와의 대화‡Habla con Un\'thuwa‡Habla con Un\'thuwa‡Parler à Un\'thuwa‡安苏瓦‡安蘇瓦',
