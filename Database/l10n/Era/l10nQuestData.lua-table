},
[464] = {
  {
    'Estandartes de guerra‡Боевые знамена‡Kriegsflaggen‡전쟁 깃발‡Estandartes de batalla‡Estandartes de batalla‡Bannières de guerre‡龙喉战旗‡龍喉戰旗',
    nil,
    'Leve 8 Estandartes de Guerra Presa do Dragão para o Capitão Punhoforte.‡Принесите 8 боевых знамен клана Драконьей Пасти капитану Крепкому Кулаку.‡Bringt Captain Stoutfist 8 Kriegsflaggen der Dragonmaw.‡메네실 항구에 있는 경비대장 스타우트피스트에게 용아귀부족 전쟁 깃발 8개를 가져가야 합니다.‡Lleva 8 estandartes de guerra Faucedraco al capitán Puñorrecio.‡Lleva 8 estandartes de guerra Faucedraco al capitán Puñorrecio.‡Rapporter 8 Bannières de guerre Dragonmaw au capitaine Stoutfist.‡给斯托菲队长带回8面龙喉战旗。‡給斯托菲隊長帶回8面龍喉戰旗。',
  }
},
[465] = {
  {
    'A artimanha de Nek\'rosh‡Гамбит Нек\'роша‡Nek\'roshs Schachzug‡용아귀부족 투석기‡La estrategia de Nek\'rosh‡La estrategia de Nek\'rosh‡La manœuvre de Nek\'rosh‡纳克罗什的优势‡納克羅什的優勢',
    nil,
    'Destrua as Catapultas da Presa do Dragão.‡Уничтожьте катапульты Драконьей Пасти.‡Zerstört die Katapulte der Dragonmaw.‡용아귀부족 투석기를 파괴해야 합니다.‡Destruye las catapultas Faucedraco.‡Destruye las catapultas Faucedraco.‡Détruire les Catapultes Dragonmaw.‡摧毁所有的龙喉投石车。‡摧毀所有的龍喉投石車。',
  }
},
[466] = {
  {
    'À procura de incendicita‡Поиски огневита‡Auf der Suche nach Pyrophor‡발연 광석을 찾아서‡Búsqueda de incendicita‡Búsqueda de incendicita‡À la recherche de l\'incendicite‡火岩矿石‡火巖礦石',
    nil,
    'Leve 6 cargas de Minério de Incendicita ao Piloto Marchapedra em Dun Morogh.‡Принесите 6 партий огневитовой руды пилоту Камнекожицу в Дун Морог.‡Bringt 6 Ladungen Pyrophorerz zu Pilot Stonegear nach Dun Morogh.‡던 모로에 있는 조종사 스톤기어에게 발연 광석 6개를 가져가야 합니다.‡Lleva 6 piezas de mineral de incendicita al piloto Roscapiedra de Dun Morogh.‡Lleva 6 piezas de mineral de incendicita al piloto Roscapiedra de Dun Morogh.‡Apporter 6 Chargements d’Incendicite au Pilote Stonegear à Dun Morogh.‡给丹莫罗的驾驶员迪恩·石轮带回6份火岩矿石。‡給丹莫羅的駕駛員迪恩·石輪帶回6份火巖礦石。',
  }
},
[467] = {
  {
    'A busca de Marchapedra‡Найдите Камнекожца‡Stonegears Suche‡스톤기어의 광석‡La búsqueda de los Roscapiedra‡La búsqueda de los Roscapiedra‡La quête de Stonegear‡迪恩·石轮的梦想‡迪恩·石輪的夢想',
    nil,
    'Fale com o Piloto Marchapedra.‡Поговорите с пилотом Камнекожицем.‡Sprecht mit Pilot Stonegear.‡조종사 스톤기어와 대화하십시오.‡Habla con el piloto Roscapiedra.‡Habla con el piloto Roscapiedra.‡Parler au Pilote Stonegear.‡和驾驶员迪恩·石轮谈一谈。‡和駕駛員迪恩·石輪談壹談。',
  }
},
[468] = {
  {
    'Apresente-se ao Montanhista Rochapeixe‡Отчитайтесь перед горным пехотинцем Рокхаром.‡Meldung bei Gebirgsjäger Rockgar‡산악경비대 록가르에게 보고‡Preséntate ante el montaraz Rockgar‡Preséntate ante el montaraz Piedragar‡Un rapport pour le Montagnard Rockgar‡向巡山人罗克加报告‡向巡山人羅克加報告',
    nil,
    'Fale com o Montanhista Rochapeixe.‡Поговорите с горным пехотинцем Рокхаром.‡Sprecht mit Gebirgsjäger Rockgar.‡산악경비대 록가르와 대화해야 합니다.‡Habla con el montaraz Rockgar.‡Habla con el montaraz Piedragar.‡Parler au Montagnard Rockgar.‡与巡山人罗克加谈一谈。‡與巡山人羅克加談壹談。',
  }
},
[469] = {
  {
    'Entrega diária‡Ежедневная доставка‡Tägliche Lieferung‡가죽 배달‡Entrega cotidiana‡Entrega cotidiana‡Livraison quotidienne‡日常供货‡日常供貨',
    nil,
    'Entregue o Pacote de Peles de Crocolisco a Iago Halberque, o curtumeiro, no Porto de Menethil.‡Отнесите стопку кроколисковых шкур кожевнику Джеймсу Халлорану в Гавань Менетилов.‡Liefert das Bündel Krokiliskenhäute bei dem Gerber James Halloran im Hafen von Menethil ab.‡메네실 항구의 무두장이 제임스 할로란에게 악어 가죽 한 묶음을 전달해야 합니다.‡Entrega el fardo de pieles de crocolisco a James Halloran, el peletero, en Puerto de Menethil.‡Entrega el fardo de pieles de crocolisco a James Halloran, el curtidor, en Puerto de Menethil.‡Apporter le Lot de peaux de crocilisques à James Halloran, le tanneur, au port de Menethil.‡将这捆鳄鱼皮带给米奈希尔港的皮匠詹姆斯·哈洛兰。‡將這捆鱷魚皮帶給米奈希爾港的皮匠詹姆斯·哈洛蘭。',
  }
},
[470] = {
  {
    'Escavando a Gosma‡Прожорливый слизнюк‡Stochern im Brühschlamm‡가방 찾기‡Abriéndose paso entre los mocos‡Abriéndose paso entre los mocos‡En creusant dans la vase‡搜寻软泥怪‡搜尋軟泥怪',
    nil,
    'A bolsa de Cida está em uma das gosmas na Tumba dos Barbaférreos. Recupere a bolsa e leve de volta para ela no Porto de Menethil.‡Отнимите сумку Сиды у неизвестного слизнюка возле гробницы Железноборода и верните ее хозяйке в Гавань Менетилов.‡Einer der Brühschlammer bei Ironbeards Grabmal hat Sidas Tasche. Bergt sie und bringt sie ihr zurück in den Hafen von Menethil.‡아이언비어드 고분에 돌아다니는 수액괴물 중 하나가 시다의 가방을 갖고 있습니다. 그 가방을 찾아 메네실 항구의 시다에게 가져가야 합니다.‡Uno de los mocos de la Tumba de Barbaférrea tiene la Bolsa de Shida, recupérala y devuélvesela en Puerto de Menethil.‡Uno de los mocos de la Tumba de Barbaférrea tiene la Bolsa de Shida, recupérala y devuélvesela en Puerto de Menethil.‡L\'un des Limons dans le Tombeau d\'Ironbeard a le sac de Sidonie. Le retrouver et le lui rapporter au Port de Menethil.‡铁须之墓中的某只软泥怪身上有塞达的背包，夺回背包，把它送还给米奈希望港的塞达。‡鐵須之墓中的某只軟泥怪身上有塞達的背包，奪回背包，把它送還給米奈希望港的塞達。',
  }
},
[471] = {
  {
    'Deveres de aprendiz‡Тяжкая судьба помощника‡Lehrlingspflichten‡수습생의 임무‡Deberes de aprendiz‡Deberes de aprendiz‡Les devoirs de l\'apprenti‡学徒的职责‡學徒的職責',
    nil,
    'Colete 6 Peles de Crocolisco Gigante e leve-as para Iago Halberque no Porto de Menethil.‡Принесите 6 шкур гигантских кроколисков Джеймсу Халлорану в Гавань Менетилов.‡Sammelt 6 riesige Krokiliskenhäute und bringt sie zu James Halloran in den Hafen von Menethil.‡거대한 악어 가죽 6개를 모아 메네실 항구의 제임스 할로란에게 가져가야 합니다.‡Reúne 6 pieles de crocolisco gigante y llévaselas a James Halloran en Puerto de Menethil.‡Reúne 6 pieles de crocolisco gigante y llévaselas a James Halloran en Puerto de Menethil.‡Collecter 6 Peaux de crocilisque géant, et les apporter à James Halloran, au port de Menethil.‡为米奈希尔港的詹姆斯·哈洛兰带回6张巨型鳄鱼的皮。‡為米奈希爾港的詹姆斯·哈洛蘭帶回6張巨型鱷魚的皮。',
  }
},
[472] = {
  {
    'Queda de Dun Modr‡Падение Дун Модра‡Der Fall von Dun Modr‡던 모드르의 함락‡La caída de Dun Modr‡La caída de Dun Modr‡La chute de Dun Modr‡丹莫德的陷落‡丹莫德的陷落',
    nil,
    'Procure Trançalonga perto da cidade de Dun Modr.‡Отыщите Грима Длинную Косу возле Дун Модра.‡Sucht nahe der Stadt von Dun Modr nach Longbraid.‡던 모드르 마을 근처에서 롱브레이드를 찾아야 합니다.‡Busca a Largatrenza junto a la ciudad de Dun Modr.‡Busca a Largatrenza junto a la ciudad de Dun Modr.‡Rechercher Longbraid dans les parages du village de Dun Modr.‡在丹莫德镇附近寻找布莱德·长须的踪迹。‡在丹莫德鎮附近尋找布萊德·長須的蹤跡。',
  }
},
[473] = {
  {
    'Apresente-se ao Capitão Punhoforte‡Доклад капитану Крепкому Кулаку‡Meldung bei Captain Stoutfist‡경비대장 스타우트피스트에게 보고‡Preséntate ante el capitán Puñorrecio‡Preséntate ante el capitán Puñorrecio‡Un rapport au capitaine Stoutfist‡向斯托菲队长报告‡向斯托菲隊長報告',
    nil,
    'Fale com o Capitão Punhoforte.‡Найдите капитана Крепкого Кулака и поговорите с ним.‡Sprecht mit Captain Stoutfist.‡경비대장 스타우트피스트와 대화해야 합니다.‡Habla con el capitán Puñorrecio.‡Habla con el capitán Puñorrecio.‡Parler au capitaine Stoutfist.‡与斯托菲队长谈一谈。‡與斯托菲隊長談壹談。',
  }
},
[474] = {
  {
    'Derrotar Nek\'rosh‡Убить Нек\'роша‡Sieg über Nek\'rosh‡네크로쉬 처치‡Derrota a Nek\'rosh‡Derrota a Nek\'rosh‡Vaincre Nek\'rosh‡击败纳克罗什‡擊敗納克羅什',
    nil,
    'Mate o Chefe Nek\'rosh.|nLeve a Cabeça do Nek\'rosh ao Capitão Punhoforte.‡Убейте вождя Нек\'роша.|nПринесите голову Нек\'роша капитану Крепкому Кулаку.‡Tötet Häuptling Nek\'rosh.|nBringt Nek\'roshs Kopf zu Captain Stoutfist.‡족장 네크로쉬를 처치해야 합니다.|n그런 다음 그 증거로 경비대장 스타우트피스트에게 네크로쉬의 머리카락을 가져가야 합니다.‡Mata al jefe Nek\'rosh.|nLleva la cabeza de Nek\'rosh al capitán Puñorrecio.‡Mata al jefe Nek\'rosh.|nLleva la cabeza de Nek\'rosh al capitán Puñorrecio.‡Tuer le Chef Nek\'rosh|nRapporter la tête de Nek\'rosh au capitaine Stoutfist.‡杀掉纳克罗什酋长。|n将纳克罗什的头颅交给斯托菲队长。‡殺掉納克羅什酋長。|n將納克羅什的頭顱交給斯托菲隊長。',
  }
},
[475] = {
  {
    'Uma leve brisa‡Ветер тревоги‡Ein beunruhigender Wind‡혼란의 바람‡Una brisa problemática‡Una brisa problemática‡Une brise étrange‡烦恼之风‡煩惱之風',
    nil,
    'Encontre Garyol Talvethren no Vilarejo Brisastral.‡Найдите Гароласа Талветрена в Деревне Звездного Ветра.‡Sucht Gaerolas Talvethren im Dorf Starbreeze auf.‡별바람 마을에서 게롤라스 탈베드렌을 찾아야 합니다.‡Busca a Gaerolas Talvethren en la Aldea Brisa Estelar.‡Busca a Gaerolas Talvethren en la Aldea Brisa Estelar.‡Chercher Gaerolas Talvethren au village de Brise-stellaire.‡在星风村找到盖洛拉斯·塔文斯伦。‡在星風村找到蓋洛拉斯·塔文斯倫。',
  }
},
[476] = {
  {
    'Corrupção Masca-pinho‡Порча Кривой Сосны‡Die Verderbnis der Knarzklauen‡나무옹이일족의 타락‡Corrupción en Tuercepinos‡Corrupción en Tuercepinos‡La corruption des Pins-tordus‡瘤背熊怪的堕落‡瘤背熊怪的墮落',
    nil,
    'Fale com Athridas Mantursino em Dolanaar.‡Вернитесь к Атридасу Медвежьей Шкуре в Доланаар.‡Kehrt zu Athridas Bearmantle nach Dolanaar zurück.‡돌라나르에 있는 아스리다스 베어맨틀에게 돌아가십시오.‡Ve a ver a Athridas Manturso a Dolanaar.‡Ve a ver a Athridas Manto de Oso a Dolanaar.‡Retourner auprès d\'Athridas Bearmantle à Dolanaar.‡返回多兰纳尔去见阿斯瑞达斯·熊皮。‡返回多蘭納爾去見阿斯瑞達斯·熊皮。',
  }
},
[477] = {
  {
    'Cruzando fronteiras‡Пересечение границ‡Grenzübergänge‡마법사의 상자‡Pasa la frontera‡Pasa la frontera‡Frontières‡越境‡越境',
    nil,
    'Recupere o conteúdo de um dos caixotes dos teurgos de Dalaran. Você vai encontrar o Vilarejo Lenhardente ao sul.‡Раздобудьте содержимое одного из сундуков даларанских волшебников. Деревня Погребальных Костров находится на юге.‡Holt den Inhalt einer der Kisten von den Hexern aus Dalaran. Ihr findet Pyrewood im Süden.‡달라란 마술사의 상자 중 하나의 내용물을 찾아 와야 합니다. 장작나무 마을은 남쪽에서 찾을 수 있습니다.‡Recupera el contenido de una de las cajas de zahoríes de Dalaran. Encontrarás la Aldea Piroleña hacia el sur.‡Recupera el contenido de una de las cajas de zahoríes de Dalaran. Encontrarás la Aldea Piroleña hacia el sur.‡Récupérer le contenu de l’une des caisses des Sorciers de Dalaran. Vous trouverez Bois-du-Bûcher au sud.‡从达拉然法师的木箱中拿出里面的东西。‡從達拉然法師的木箱中拿出裏面的東西。',
  }
},
[478] = {
  {
    'Mapas e runas‡Карты и руны‡Karten und Runen‡지도와 룬문자 펜던트‡Mapas y runas‡Mapas y runas‡Des cartes et des runes‡地图与符记‡地圖與符記',
    nil,
    'Leve o estranho pingente para o Sacerdote Sombrio Allister, no Sepulcro.‡Отнесите странную подвеску жрецу Тьмы Алистеру в Гробницу.‡Bringt den seltsamen Anhänger zu Schattenpriester Allister in dem Grabmal.‡공동묘지에 있는 어둠의사제 알리스터에게 룬문자 펜던트를 가져가야 합니다.‡Lleva el extraño colgante al sacerdote de las Sombras Allister en El Sepulcro.‡Lleva el extraño colgante al sacerdote de las Sombras Allister en El Sepulcro.‡Apporter l\'étrange pendentif au prêtre des ombres Allister au Sépulcre.‡将这个奇怪的坠饰交给瑟伯切尔的暗影牧师奥利斯特。‡將這個奇怪的墜飾交給瑟伯切爾的暗影牧師奧利斯特。',
  }
},
[479] = {
  {
    'Investigações de Lenhâmbar‡Расследование в Янтарной Мельнице‡Ambermill-Nachforschungen‡앰버밀 조사‡Las investigaciones de Molino Ámbar‡Las investigaciones de Molino Ámbar‡Enquête à Moulin-de-l\'Ambre‡调查安伯米尔‡調查安伯米爾',
    nil,
    'Obtenha 8 Pingentes de Dalaran para o Sacerdote Sombrio Allister, no Sepulcro.‡Добудьте 8 подвесок Даларана и отнесите жрецу Тьмы Алистеру в Гробницу.‡Beschafft 8 Anhänger aus Dalaran für Schattenpriester Allister beim Grabmal.‡공동묘지의 어둠의사제 알리스터를 위해 달라란 펜던트 8개를 모야아 합니다.‡Consigue 8 colgantes de Dalaran al sacerdote de las Sombras Allister en El Sepulcro.‡Consigue 8 colgantes de Dalaran al sacerdote de las Sombras Allister en El Sepulcro.‡Récupérer 8 Pendentifs de Dalaran pour le prêtre des ombres Allister du Sépulcre.‡为瑟伯切尔的暗影牧师奥利斯特抢到8个达拉然坠饰。‡為瑟伯切爾的暗影牧師奧利斯特搶到8個達拉然墜飾。',
  }
},
[480] = {
  {
    'O tecelão‡Ткач‡Der Wirker‡대마법사의 지팡이‡El Tejedor‡El Tejedor‡Le Tisserand‡法师的头领‡法師的頭領',
    nil,
    'Mate o arquimago de Dalaran, depois leve o cajado dele para o Sacerdote Sombrio Allister, no Sepulcro.‡Убейте даларанского верховного мага, заберите его посох и отнесите жрецу Тьмы Алистеру в Гробницу.‡Tötet den Erzmagier von Dalaran und bringt seinen Stab zu Schattenpriester Allister in dem Grabmal.‡달라란 대마법사 아테릭을 처치하고 그의 지팡이를 공동묘지에 있는 어둠의사제 알리스터에게 가져가야 합니다.‡Mata al archimago Dalaran, recupera su bastón y llévaselo al sacerdote de las Sombras Allister en El Sepulcro.‡Mata al archimago Dalaran, recupera su bastón y llévaselo al sacerdote de las Sombras Allister en El Sepulcro.‡Tuer l\'archimage de Dalaran, puis récupérer son Bâton pour le prêtre des ombres Allister du Sépulcre.‡杀死达拉然大法师，并把他的法杖交给瑟伯切尔的暗影牧师奥利斯特。‡殺死達拉然大法師，並把他的法杖交給瑟伯切爾的暗影牧師奧利斯特。',
  }
},
[481] = {
  {
    'Análise de Dalar‡Анализ Далара‡Dalars Analyse‡달라의 분석‡El análisis de Dalar‡El análisis de Dalar‡L\'analyse de Dalar‡达拉尔的推理‡達拉爾的推理',
    nil,
    'Leve o pingente inscrito em runas para Dalar Tessalba, no Sepulcro.‡Отнесите подвеску рунной надписи Далару Ткачу Рассвета в Гробницу.‡Bringt den mit Runen gravierten Anhänger zu Dalar Dawnweaver in dem Grabmal.‡공동묘지에 있는 달라 던위버에게 룬문자 펜던트를 가져가야 합니다.‡Lleva el colgante con runas grabadas a Dalar Tejalba en El Sepulcro.‡Lleva el colgante con runas grabadas a Dalar Tejealba en El Sepulcro.‡Apporter le Pendentif marqué de runes à Dalar Dawnweaver au Sépulcre.‡把刻有符文的坠饰交给瑟伯切尔的达拉尔·道恩维沃尔。‡把刻有符文的墜飾交給瑟伯切爾的達拉爾·道恩維沃爾。',
  }
},
[482] = {
  {
    'As intenções de Dalaran‡Планы Даларана‡Dalaran Absichten‡달라란의 의도‡Las intenciones de los Dalaran‡Las intenciones de los Dalaran‡Les intentions de Dalaran‡达拉然的意图‡達拉然的意圖',
    nil,
    'Fale com o Sacerdote Sombrio Allister, no Sepulcro.‡Поговорите с жрецом Тьмы Алистером в Гробнице.‡Sprecht mit dem Schattenpriester Allister in dem Grabmal.‡공동묘지에 있는 어둠의사제 알리스터와 대화해야 합니다.‡Habla con el sacerdote de las Sombras en El Sepulcro.‡Habla con el sacerdote de las Sombras Allister en El Sepulcro.‡Parler au prêtre des ombres Allister au Sépulcre.‡与瑟伯切尔的暗影牧师奥利斯特谈一谈。‡與瑟伯切爾的暗影牧師奧利斯特談壹談。',
  }
},
[483] = {
  {
    'As relíquias do despertar‡Реликвии Пробуждения‡Die Relikte des Erwachens‡깨움의 의식을 위한 재료‡Las Reliquias del Despertar‡Las Reliquias del Despertar‡Les Reliques d\'éveil‡唤醒圣物‡喚醒聖物',
    nil,
    'Recupere as Relíquias do Despertar e leve para Athridas Mantursino, em Dolanaar.‡Добудьте реликвии Пробуждения и принесите их Атридасу Медвежьей Шкуре в Доланаар.‡Bringt die Relikte des Erwachens zu Athridas Bearmantle nach Dolanaar.‡드루이드들을 깨우는 의식에 필요한 재료를 찾아 돌라나르에 있는 아스리다스 베어맨틀에게 가져가야 합니다.‡Consigue las Reliquias del Despertar y llévaselas a Athridas Manturso a Dolanaar.‡Recupera las Reliquias del Despertar y llévaselas a Athridas Manto de Oso en Dolanaar.‡Récupérer les Reliques d\'éveil et les rapporter à Athridas Bearmantle à Dolanaar.‡寻回四件唤醒圣物,把它们带给多兰纳尔的阿斯瑞达斯·熊皮。‡尋回四件喚醒聖物,把它們帶給多蘭納爾的阿斯瑞達斯·熊皮。',
  }
},
[484] = {
  {
    'Crocolisco jovem é que dá pele boa‡Шкуры молодых кроколисков‡Häute junger Krokilisken‡새끼 악어 가죽‡Piel de crocolisco joven‡Piel de crocolisco joven‡Les peaux de jeune crocilisque‡小鳄鱼皮‡小鱷魚皮',
    nil,
    'Obtenha 4 Peles de Crocolisco Jovem para Iago Halberque, no Porto de Menethil.‡Принесите 4 шкуры молодых кроколисков Джеймсу Халлорану в Гавань Менетилов.‡Besorgt Euch 4 Häute junger Krokilisken für James Halloran im Hafen von Menethil.‡메네실 항구의 제임스 할로란에게 새끼 악어 가죽 4개를 가져가야 합니다.‡Consigue 4 pieles de cría de crocolisco para James Halloran de Puerto de Menethil.‡Consigue 4 pieles de crocoliscos jóvenes para James Halloran de Puerto de Menethil.‡Collecter 4 Peaux de jeune crocilisque, pour James Halloran, au port de Menethil.‡为米奈希尔港口的詹姆斯·哈洛兰带回4张小鳄鱼皮。‡為米奈希爾港口的詹姆斯·哈洛蘭帶回4張小鱷魚皮。',
  }
},
[485] = {
  {
    'Encontre OOX-09/HL!‡Найти КПХ-9/HL!‡Sucht OOX-09/HL!‡OOX-09/HL 수색‡¡Encuentra a OOX-09/HL!‡¡Encuentra a OOX-09/TI!‡Trouver OOX-09/HL !‡找到OOX-09/HL！‡找到OOX-09/HL！',
    nil,
    'Leve o transmissor de emergência até o robô teleguiado de Olhatorto na cabeceira do rio, perto da Rocha Oculta, que fica nas Terras Agrestes.‡Отнесите аварийный маяк к автономному роботу Карлса. Робот находится во Внутренних землях, в устье реки близ Осклизлой скалы.‡Bringt das Notsignal zu Oglethorpes Leitroboter an der Quelle des Flusses im Hinterland, nahe Skulk Rock.‡해골 바위굴 근처, 동부 내륙지의 강이 시작되는 곳에 추락한 오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Lleva el localizador al robot mensajero de Oglethorpe, que está en el nacimiento del río de las Tierras del Interior, cerca de Roca Oculta.‡Lleva el localizador al robot mensajero de Oglethorpe, en el nacimiento del río de las Tierras del Interior, cerca de Roca Oculta.‡Apporter la balise de détresse jusqu\'au robot guidé d\'Oglethorpe en haut de la rivière dans les Hinterlands, près du rocher de l\'Affût.‡把定位器带到奥格索普的母体机器人那里去。|n奥格索普的母体机器人位于辛特兰的河水源头，就在藏身石的附近。‡把定位器帶到奧格索普的母體機器人那裏去。|n奧格索普的母體機器人位於辛特蘭的河水源頭，就在藏身石的附近。',
  }
},
[486] = {
  {
    'Ursal, o Espancador‡Урсал Изверг‡Ursal der Raufer‡투사 우르살‡Ursal el Violento‡Ursal el Violento‡Ursal le Mutileur‡大槌乌萨尔‡大槌烏薩爾',
    nil,
    'Mate Ursal, o Espancador, e fale novamente com Athridas Mantursino, em Dolanaar.‡Убейте Урсала Изверга и возвращайтесь к Атридасу Медвежьей Шкуре в Доланаар.‡Tötet Ursal den Raufer und kehrt zu Athridas Bearmantle nach Dolanaar zurück.‡투사 우르살을 처치한 다음 돌라나르에 있는 아스리다스 베어맨틀에게 돌아가십시오.‡Mata a Ursal el Violento y ve a ver de nuevo a Athridas Manturso a Dolanaar.‡Mata a Ursal el Violento y regresa con Athridas Manto de Oso en Dolanaar.‡Tuer Ursal le Mutileur et retourner voir Athridas Bearmantle à Dolanaar.‡杀掉大槌乌萨尔，然后回到多兰纳尔的阿斯瑞达斯·熊皮那里。‡殺掉大槌烏薩爾，然後回到多蘭納爾的阿斯瑞達斯·熊皮那裏。',
  }
},
[487] = {
  {
    'A estrada para Darnassus‡Дорога в Дарнасс‡Die Straße nach Darnassus‡다르나서스에 이르는 길‡El camino a Darnassus‡El camino a Darnassus‡La route de Darnassus‡达纳苏斯之路‡達納蘇斯之路',
    nil,
    'Mate 6 Emboscadores Masca-pinho e fale novamente com a Sentinela Amara Noctívaga fora de Dolanaar.‡Убейте 6 душителей из племени Кривой Сосны и найдите часового Амару Ночную Странницу возле Доланаара.‡Erschlagt 6 Wegelagerer der Knarzklauen und kehrt zu Schildwache Amara Nightwalker außerhalb Dolanaars zurück.‡나무옹이일족 복병 6마리를 처치한 다음 돌라나르 외곽에 있는 파수꾼 아마라 나이트워커에게 돌아가십시오.‡Acaba con 6 emboscadores Tuercepinos y después ve a ver de nuevo a Amara Andanoche a las afueras de Dolanaar.‡Mata 6 emboscadores Tuercepinos y regresa con la centinela Amara Noctámbula en las afueras de Dolanaar.‡Tuer 6 Embusqués Pins-tordus et retourner voir la Sentinelle Amara Nightwalker à l\'extérieur de Dolanaar.‡杀掉6个瘤背伏击者，然后向多兰纳尔城外的哨兵阿玛拉·夜行者报告。‡殺掉6個瘤背伏擊者，然後向多蘭納爾城外的哨兵阿瑪拉·夜行者報告。',
  }
},
[488] = {
  {
    'O comando de Zenn‡Просьба Зенна‡Zenns Aufträge‡젠의 부탁‡Las apuestas de Zenn‡Las apuestas de Zenn‡Les commandements de Zenn‡赛恩的要求‡賽恩的要求',
    nil,
    'Leve para Zenn Cascovil, fora de Dolanaar, 3 Presas de Sabre-da-noite, 3 Penas Estrígidas de Coruja e 3 amostras de Seda de Aranha Lenhateia.‡Принесите Зенну Грязному Копыту, стоящему недалеко от Доланаара, 3 клыка ночного саблезуба, 3 пера островной совы и 3 мотка паутины чащобного тенетника.‡Bringt Zenn Foulhoof außerhalb von Dolanaar 3 Nachtsäblerfangzähne, 3 Strigideulenfedern und 3 Streifen Waldweberspinnenseide.‡돌라나르 외곽에 있는 젠 파울후프에게 흑호 송곳니 3개, 스트리기드 올빼미 깃털 3개, 그리고 나무그물 늑대거미의 거미줄 3개를 가져가야 합니다.‡Llévale a Zenn Nauseapezuña a las afueras de Dolanaar 3 colmillos de sable de la noche, 3 plumas de lechuza estrígida y 3 muestras de seda de araña Tejemadera.‡Llévale a Zenn Nauseapezuña afuera de Dolanaar 3 colmillos de sable de la noche, 3 plumas de lechuza estrígida y 3 muestras de seda de araña Tejemadera.‡Rapporter 3 Crocs de sabre-de-nuit, 3 Plumes de Hibou Strigid et 3 Echantillons de Soie d\'araignée Tissebois à Zenn Foulhoof à l\'extérieur de Dolanaar.‡给多兰纳尔外面的赛恩·腐蹄带去3颗夜刃豹的牙齿、3根巨翼枭的羽毛和3份树林蜘蛛丝。‡給多蘭納爾外面的賽恩·腐蹄帶去3顆夜刃豹的牙齒、3根巨翼梟的羽毛和3份樹林蜘蛛絲。',
  }
},
[489] = {
  {
    'Consiga redenção!‡Искупление вины‡Sucht Befreiung!‡신뢰의 회복‡¡Búsqueda de redención!‡¡Búsqueda de redención!‡En quête de rédemption !‡寻求救赎！‡尋求救贖！',
    nil,
    'Colete 3 Pinhas Vis e entregue-as para Zenn Cascovil, fora de Dolanaar.‡Соберите 3 шишки Скверны и отдайте их Зенну Грязному Копыту близ Доланаара.‡Sammelt 3 Teufelszapfen und gebt sie Zenn Foulhoof außerhalb von Dolanaar.‡악의 열매 3개를 모아 돌라나르 외곽에 있는 젠 파울후프에게 가져다주어야 합니다.‡Recoge 3 bellotas viles y entrégaselas a Zenn Nauseapezuña en las afueras de Dolanaar.‡Recoge 3 bellotas viles y entrégaselas a Zenn Nauseapezuña en las afueras de Dolanaar.‡Collecter 3 Gangrenoix et les offrir à Zenn Foulhoof à l\'extérieur de Dolanaar.‡收集3个魔锥果，把它们给在多兰纳尔外面的赛恩·腐蹄。‡收集3個魔錐果，把它們給在多蘭納爾外面的賽恩·腐蹄。',
  }
},
[490] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    '‡‡‡‡‡Shayla Brisa Nocturna, en las afueras de Darnassus, desea que le traigas 20 colmillos de Tuercepinos.‡‡‡',
  }
},
[491] = {
  {
    'Uma boa varinha para Boanerges‡Жезл для Бетора‡Zauberstab an Bethor‡베소르에게 전할 마법봉‡Una varita para Bethor‡Una varita para Bethor‡Une Baguette pour Bethor‡给比索的魔杖‡給比索的魔杖',
    nil,
    'Leve a Varinha Entretecida para Boanerges Stalactus, no Distrito da Magia da Cidade Baixa.‡Отнесите Сплетенный жезл Бетору Ледострелу в Квартал Магов Подгорода.‡Bringt den gewebten Zauberstab zu Bethor Iceshard in das Magieviertel von Undercity.‡언더시티의 마법 지구에 있는 베소르 아이스샤드에게 결합된 마법봉을 가져가야 합니다.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Apporter le Bâton tressé à Bethor Iceshard dans le Quartier de la magie à Undercity.‡将狼人魔杖带给幽暗城法师区的比索·埃斯沙德。‡將狼人魔杖帶給幽暗城法師區的比索·埃斯沙德。',
  }
},
[492] = {
  {
    'Uma nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'Leve a Bebida Especial do Joaquino para o Montanhista Capturado.‡Отнесите особый напиток Юхана пленному горному пехотинцу.‡Bringt Johaans Spezialgetränk zum gefangenen Gebirgsjäger.‡산악경비대 포로에게 요한의 특별조제약을 전해줘야 합니다.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Apporter la Boisson spéciale de Johaan au Montagnard captif.‡将乔汉的特制饮料交给被俘虏的巡山人。‡將喬漢的特制飲料交給被俘虜的巡山人。',
  }
},
[493] = {
  {
    'Jornada ao Contraforte de Eira dos Montes‡Путешествие в предгорья Хилсбрада‡Reise in das Vorgebirge von Hillsbrad‡힐스브래드 구릉지로의 여정‡Viaja a Laderas de Trabalomas‡Viaja a Laderas de Trabalomas‡Voyage jusqu’aux contreforts d\'Hillsbrad‡前往希尔斯布莱德丘陵‡前往希爾斯布萊德丘陵',
    nil,
    'Entregue as descobertas do Boticário Renferrel ao Boticário Lindolfo na cidade de Serraria Tarren, que fica no Contraforte de Eira dos Montes.‡Отнесите находки аптекаря Ренферрела аптекарю Лидону в деревню Мельница Таррен в предгорьях Хилсбрада.‡Bringt die Funde von Apotheker Renferrel zu Apotheker Lydon nach Tarrens Mühle im Vorgebirge von Hillsbrad.‡힐스브래드 구릉지의 타렌 밀농장에 있는 연금술사 라이던에게 렐퍼럴의 연구 결과를 가져가야 합니다.‡Lleva los descubrimientos del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Lleva el descubrimiento del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Livrer les découvertes de l\'Apothicaire Renferrel à l\'Apothicaire Lydon à Moulin-de-Tarren dans les contreforts d\'Hillsbrad.‡将伦弗利尔的研究成果交给希尔斯布莱德山脚下塔伦米尔的药剂师林度恩。‡將倫弗利爾的研究成果交給希爾斯布萊德山腳下塔倫米爾的藥劑師林度恩。',
  }
},
[494] = {
  {
    'Hora de atacar‡Время нанести удар‡Zeit zum Zuschlagen‡공격 개시‡El momento de atacar‡El momento de atacar‡Prêts à frapper‡进攻的时机‡進攻的時機',
    nil,
    'Viaje até Serraria Tarren para entregar a mensagem do Sicário Açoute para a Alta-executora Darthalia.‡Отправляйтесь в Мельницу Таррен и доставьте послание стража смерти Леш верховному палачу Дарталии.‡Reist nach Tarrens Mühle, um die Nachricht von Todespirscherin Lesh an Hochexekutorin Darthalia zu überbringen.‡타렌 밀농장으로 가서 고위집행관 다살리아에게 죽음의추적자 레시의 전갈을 전해야 합니다.‡Ve a Molino Tarren para llevar el mensaje del mortacechador Lesh a la suma ejecutora Darthalia.‡Ve a Molino Tarren para llevar el mensaje de la mortacechadora Lesh a la suma ejecutora Darthalia.‡Se rendre à Moulin-de-Tarren et délivrer le message du Traqueur noir Lesh à la Grande Exécutrice Darthalia.‡到塔伦米尔去，把亡灵哨兵莱什的口信带给高级执行官达萨利亚。‡到塔倫米爾去，把亡靈哨兵萊什的口信帶給高級執行官達薩利亞。',
  }
},
[495] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡La Corona de la Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意誌之冠',
    nil,
    'Apresente-se a Melissara, na Serraria Tarren, no Contraforte de Eira dos Montes.‡Поговорите с Мелизарой в Мельнице Таррен в предгорьях Хилсбрада.‡Meldet Euch bei Melisara in Tarrens Mühle im Vorgebirge von Hillsbrad.‡힐스브래드 구릉지의 타렌 밀농장에 있는 멜리사라에게 보고해야 합니다.‡Informa a Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Preséntate ante Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Faire un rapport à Melisara à Moulin-de-Tarren dans les Contreforts d\'Hillsbrad.‡到希尔斯布莱德丘陵去，向塔伦米尔的梅里萨拉报到。‡到希爾斯布萊德丘陵去，向塔倫米爾的梅裏薩拉報到。',
  }
},
[496] = {
  {
    'Elixir do sofrimento‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡Elixir del sufrimiento‡Elixir de sufrimiento‡L\'élixir de souffrance‡受难药剂‡受難藥劑',
    nil,
    'Boticário Lindolfo, de Serraria Tarren, quer 10 Línguas de Urso Cinzento e um pouco de Pus de Rastejante.‡Аптекарь Лидон с мельницы Таррен попросил принести ему 10 языков серых медведей и немного лимфы паука-охотника.‡Apotheker Lydon aus Tarrens Mühle möchte 10 Graubärzungen und etwas Krabblersekret.‡타렌 밀농장에 있는 연금술사 라이던이 회색곰 혀 10개와 이끼거미 수액을 구해다 달라고 부탁했습니다.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡Apporter 10 Langues d\'ours gris et de l\'Ichor de Rampant à l\'Apothicaire Lydon à Moulin-de-Tarren.‡塔伦米尔的药剂师林度恩要你去收集10个灰熊的舌头和一些食苔蛛的毒液。‡塔倫米爾的藥劑師林度恩要妳去收集10個灰熊的舌頭和壹些食苔蛛的毒液。',
  }
},
[498] = {
  {
    'O resgate‡Спасение‡Die Rettung‡포로 구출‡El rescate‡El rescate‡Sauvetage‡拯救行动‡拯救行動',
    nil,
    'Krusk, da Serraria Tarren, precisa que você liberte Drull e Tog\'thar do Forte do Desterro.‡Освободите Друлла и Тог\'тара по поручению Круска с мельницы Таррен.‡Krusk in Tarrens Mühle braucht Euch, um Drull und Tog\'thar aus der Burg Durnholde zu befreien.‡타렌 밀농장에 있는 크루스크가 던홀드 요새에서 드럴과 토그타르를 구출해 달라고 부탁했습니다.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Selon les ordres de Krusk à Moulin-de-Tarren, libérer Drull et Tog\'thar du Donjon de Durnholde.‡塔伦米尔的克鲁斯克要你把德鲁尔和托格萨从敦霍尔德城堡救出来。‡塔倫米爾的克魯斯克要妳把德魯爾和托格薩從敦霍爾德城堡救出來。',
  }
},
[499] = {
  {
    'Elixir do Sofrimento‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡Elixir del sufrimiento‡Elixir de sufrimiento‡L\'élixir de souffrance‡受难药剂‡受難藥劑',
    nil,
    'Dê o Elixir do Sofrimento a Umpi.‡Дайте Ампи эликсир Страдания.‡Gebt Umpi das Elixier des Leidens‡개구리 움피에게 괴로움의 비약을 먹여야 합니다.‡Dale el elixir del sufrimiento a Umpi.‡Dale el elixir de sufrimiento a Umpi.‡Donner l\'Elixir de souffrance à Umpi.‡把受难药剂交给乌比。‡把受難藥劑交給烏比。',
  }
},
[500] = {
  {
    'Caça de Massacrista‡Награда Раздробленного Хребта‡Crushridge-Kopfgeld‡산사태일족 현상금‡La recompensa Aplastacresta‡Recompensa Aplastacresta‡La prime Cassecrête‡破碎岭食人魔‡破碎嶺食人魔',
    nil,
    'Reúna 9 Nós dos Dedos Sujos dos Ogros Massacrista nas Montanhas de Alterac. Leve-os para o Delegado Trilharrubra, na Costa Sul.‡Соберите 9 грязных бабок у огров из клана Раздробленного Хребта в Альтеракских горах. Принесите их маршалу Крассену в Южнобережье.‡Sammelt 9 schmutzige Knöchelknochen von Crushridge-Ogern im Alteracgebirge. Bringt sie zu Marshal Redpath in Southshore.‡알터랙 산맥에 있는 산사태 오우거에게서 더러운 손가락 뼈 9개를 모은 후 사우스쇼어에 있는 치안대장 레드패스에게 가져가야 합니다.‡Recoge 9 huesos sucios de orcos Aplastacresta en las Montañas de Alterac. LLévaselos al mariscal Rutagrana a Costasur.‡Recoge 9 nudillos sucios de ogros Aplastacresta en las Montañas de Alterac. Llévaselos al alguacil Rutagrana a Costasur.‡Collecter 9 Articulations sales d\'ogres Cassecrête dans les montagnes d\'Alterac. Les apporter au maréchal Redpath à Southshore.‡从奥特兰克山的破碎岭食人魔身上收集9个肮脏的指节骨，把它们带给南海镇的治安官雷德帕斯。‡從奧特蘭克山的破碎嶺食人魔身上收集9個骯臟的指節骨，把它們帶給南海鎮的治安官雷德帕斯。',
  }
},
[501] = {
  {
    'Elixir da dor‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡Elixir de dolor‡Elixir de dolor‡L\'élixir de douleur‡痛苦药剂‡痛苦藥劑',
    nil,
    'Leve 10 Ampolas de Sangue de Leão da Montanha para o Boticário Lindolfo na Serraria Tarren.‡Принесите 10 сосудов крови горного льва аптекарю Лидону с мельницы Таррен.‡Bringt 10 Phiolen mit Berglöwenblut zu Apotheker Lydon in Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 산사자 피 10병을 가져가야 합니다.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Apporter 10 Fioles de sang de lion des montagnes à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集10瓶山地狮的血液，把它们交给塔伦米尔的药剂师林度恩。‡收集10瓶山地獅的血液，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[502] = {
  {
    'Elixir da dor‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡Elixir del dolor‡Elixir de dolor‡L\'élixir de douleur‡痛苦药剂‡痛苦藥劑',
    nil,
    'Alimente Fido com o Elixir da Dor.‡Напоите Стэнли эликсиром Боли.‡Füttert Stanley mit dem Elixier der Schmerzen.‡스탠리에게 고통의 비약을 먹여야 합니다.‡Dale el elixir del dolor a Stanley.‡Dale el elixir de dolor a Stanley.‡Donner l’Elixir de douleur à Stanley.‡把痛苦药剂喂给小狗斯坦雷。‡把痛苦藥劑餵給小狗斯坦雷。',
  }
},
[503] = {
  {
    'Gol\'dir‡Гол\'дир‡Gol\'dir‡골디르‡Gol\'dir‡Gol\'dir‡Gol\'dir‡高迪尔‡高迪爾',
    nil,
    'Liberte Gol\'dir e fale novamente com Krusk na Serraria Tarren.‡Освободите Гол\'дира и возвращайтесь к Круску в Мельницу Таррен.‡Befreit Gol\'dir und kehrt dann zu Krusk in Tarrens Mühle zurück.‡골디르를 구출하여 타렌 밀농장에 있는 크루스크에게 돌아가야 합니다.‡Libera a Gol\'dir e informa a Krusk en Molino Tarren.‡Libera a Gol\'dir e informa a Krusk en Molino Tarren.‡Libérer Gol\'dir et retourner voir Krusk à Moulin-de-Tarren.‡救出高迪尔，然后回到塔伦米尔去见克鲁斯克。‡救出高迪爾，然後回到塔倫米爾去見克魯斯克。',
  }
},
[504] = {
  {
    'Fomentadores da Guerra Massacrista‡Наемники клана Раздробленного Хребта‡Crushridge-Kriegstreiber‡산사태일족 전사‡Belicistas Aplastacresta‡Belicistas Aplastacresta‡Les Combattants Cassecrête‡破碎岭好战者‡破碎嶺好戰者',
    nil,
    'Mate 15 Fomentadores da Guerra Massacrista, depois fale novamente com o Delegado Trilharrubra na Costa Sul.‡Убейте 15 солдат-наемников из клана Раздробленного Хребта и возвращайтесь к маршалу Редпату в Южнобережье.‡Erschlagt 15 Crushridge-Kriegstreiber und kehrt dann zu Marshal Redpath in Southshore zurück.‡산사태일족 전사 15마리를 처치한 다음 사우스쇼어에 있는 치안대장 레드패스에게 돌아가십시오.‡Mata a 15 belicistas Aplastacresta y vuelve a hablar con el mariscal Rutagrana en Costasur.‡Mata 15 belicistas aplastacresta y regresa con el alguacil Rutagrana en Costasur.‡Tuer 15 Combattants Cassecrête, puis retourner voir le maréchal Redpath à Southshore.‡杀死15个破碎岭好战者，然后回南海镇向治安官雷德帕斯报告。‡殺死15個破碎嶺好戰者，然後回南海鎮向治安官雷德帕斯報告。',
  }
},
[505] = {
  {
    'Assassinos da Camarilha‡Убийцы из Синдиката‡Auftragsmörder des Syndikats‡비밀결사대 암살자‡Hermandad de asesinos‡Asesinos de la Hermandad‡Syndicat d\'assassins‡辛迪加刺客‡辛迪加刺客',
    nil,
    'Mate 12 Salteadores da Camarilha e 8 Ladrões da Camarilha, depois fale novamente com o Magistrado Henrique Maleb na Costa Sul.‡Убейте 12 преступников и 8 воров Синдиката и возвращайтесь к чиновнику Генри Малебу в Южнобережье.‡Tötet 12 Schleicher des Syndikats und 8 Diebe des Syndikats, kehrt dann zurück zu Magistrat Henry Maleb nach Southshore.‡비밀결사대 노상강도 12명과 비밀결사대 도둑 8명을 처치한 다음 사우스쇼어에 있는 집정관 헨리 말레브에게 돌아가야 합니다.‡Mata a 12 asaltantes de caminos y 8 ladrones de la Hermandad e informa al magistrado Henry Maleb en Costasur.‡Mata a 12 asaltantes de caminos y 8 ladrones de la Hermandad e informa al magistrado Henry Maleb en Costasur.‡Tuer 12 Détrousseurs du Syndicat et 8 Larrons du Syndicat puis retourner voir le magistrat Henry Maleb à Southshore.‡杀死12个辛迪加劫匪和8个辛迪加潜行者，然后回到南海镇向赫尼·马雷布镇长报到。‡殺死12個辛迪加劫匪和8個辛迪加潛行者，然後回到南海鎮向赫尼·馬雷布鎮長報到。',
  }
},
[506] = {
  {
    'O legado de Pantanegro‡Наследие Блэкмура‡Blackmoores Vermächtnis‡블랙무어의 유산‡El legado de Lodonegro‡El legado de Lodonegro‡L\'héritage de Blackmoore‡布莱克摩尔的余孽‡布萊克摩爾的余孽',
    nil,
    'Leve as informações reunidas por Gol\'dir para Krusk na Serraria Tarren.‡Отнесите собранные Гол\'диром сведения Круску на мельницу Таррен.‡Bringt die von Gol\'dir gesammelten Informationen zu Krusk in Tarrens Mühle.‡타렌 밀농장에 있는 크루스크에게 골디르가 수집한 정보를 전해야 합니다.‡Lleva la información recopilada por Gol\'dir a Krusk a Molino Tarren.‡Lleva la información recopilada por Gol\'dir a Krusk a Molino Tarren.‡Transmettre l\'information recueillie par Gol\'dir à Krusk à Moulin-de-Tarren.‡把高迪尔收集的消息带给塔伦米尔的克鲁斯克。‡把高迪爾收集的消息帶給塔倫米爾的克魯斯克。',
  }
},
[507] = {
  {
    'Lorde Aliden Perenolde‡Лорд Алиден Перенольд‡Lord Aliden Perenolde‡앨리덴 페레놀드 경‡Lord Aliden Perenolde‡Lord Aliden Perenolde‡Seigneur Aliden Perenolde‡奥里登·匹瑞诺德‡奧裏登·匹瑞諾德',
    nil,
    'Mate Lorde Aliden Perenolde e pergunte à sua concubina, Elysa, sobre o pingente de Taretha.‡Убейте лорда Алидена Перенольда и допросите его любовницу Элизу насчет ожерелья Тареты.‡Tötet Lord Aliden Perenolde und befragt seine Geliebte Elysa nach Tarethas Anhänger.‡앨리덴 페레놀드 경을 처치하고 그의 부인 엘리사에게서 타레사의 펜던트에 대해서 물어봐야 합니다.‡Mata a Aliden Perenolde y pregunta a su querida, Elysa, por el colgante de Taretha.‡Mata a Aliden Perenolde y pregunta a su querida, Elysa, por el colgante de Taretha.‡Tuer le seigneur Aliden Perenolde et interroger sa maîtresse, Elysa, au sujet du pendentif de Taretha.‡杀了奥里登·匹瑞诺德领主，并从他的情人艾丽萨身上拿回塔蕾莎的项链。‡殺了奧裏登·匹瑞諾德領主，並從他的情人艾麗薩身上拿回塔蕾莎的項鏈。',
  }
},
[508] = {
  {
    'O presente de Taretha‡Подарок Тареты‡Tarethas Geschenk‡타레사의 선물‡Un regalo de Taretha‡El obsequio de Taretha‡Le cadeau de Taretha‡塔蕾莎的礼物‡塔蕾莎的禮物',
    nil,
    'Devolva o pingente de Taretha a Krusk na Serraria Tarren.‡Верните ожерелье Тареты Круску в деревню Мельница Таррен.‡Bringt Tarethas Anhänger zu Krusk nach Tarrens Mühle.‡타렌 밀농장에 있는 크루스크에게 타레사의 펜던트를 돌려줘야 합니다.‡Devuélvele el colgante de Taretha a Krusk Molino Tarren.‡Devuelve el colgante de Taretha a Krusk en Molino Tarren.‡Rapporter le Pendentif de Taretha à Krusk à Moulin-de-Tarren.‡把塔蕾莎的项链交还给塔伦米尔的克鲁斯克。‡把塔蕾莎的項鏈交還給塔倫米爾的克魯斯克。',
  }
},
[509] = {
  {
    'Elixir da Agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve 6 Cogumelos Fuçalama para o Boticário Lindolfo na Serraria Tarren.‡Принесите 6 цветков Грязного Рыла аптекарю Лидону с мельницы Таррен.‡Bringt 6 Morastschnauzenkappen zu Apotheker Lydon in Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 진흙주둥이꽃 6개를 가져가야 합니다.‡Lleva 6 flores de morrobarro al boticario Lydon de Molino Tarren.‡Lleva 6 flores Morrobarro al boticario Lydon de Molino Tarren.‡Apporter 6 Fleurs de fangemufle à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集6朵泥头花，把它们交给塔伦米尔的药剂师林度恩。‡收集6朵泥頭花，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[510] = {
  {
    'Planos agourentos‡Зловещие планы‡Furchteinflößende Pläne‡불길한 예감이 드는 계획서‡Documentos de planificación‡Documentos de planificación‡Documents d\'annonce d\'attaque‡预备行动计划‡預備行動計劃',
    nil,
    'Leve os Planos Agourentos ao Magistrado Maleb na Costa Sul.‡Отнесите зловещие планы чиновнику Южнобережья Малебу.‡Bringt die furchteinflößenden Pläne zu Magistrat Henry Maleb nach Southshore.‡사우스쇼어에 있는 집정관 말레브에게 불길한 예감이 드는 계획서를 가져가야 합니다.‡Lleva los documentos de planificación al magistrado Maleb a Costasur.‡Lleva los documentos de planificación al magistrado Maleb a Costasur.‡Apporter les Documents d\'annonce d\'attaque au Magistrat Maleb à Southshore.‡把预备行动计划带给南海镇的赫尼·马雷布镇长。‡把預備行動計劃帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[511] = {
  {
    'Carta cifrada‡Зашифрованное письмо‡Verschlüsselter Brief‡암호화된 편지‡Una carta cifrada‡Una carta cifrada‡Lettre codée‡密文信件‡密文信件',
    nil,
    'Leve a Carta Cifrada para o Historiador Dibbs em Costa Sul.‡Отнесите зашифрованное письмо хранителю мудрости Диббсу в Южнобережье.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Southshore.‡사우스쇼어에 있는 현자 딥스에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta cifrada al maestro del Conocimiento Dibbs en Costasur.‡Lleva la carta cifrada al maestro cultural Dibbs en Costasur.‡Apporter la Lettre codée au Maître des traditions Dibbs, à Southshore.‡把密码信交给南海镇的博学者迪布斯。‡把密碼信交給南海鎮的博學者迪布斯。',
  }
},
[512] = {
  {
    'Mortes nobres‡Благородные смерти‡Tod der Edlen‡지휘부 처치‡Nobles muertes‡Muertes nobles‡Nobles morts‡贵族之死‡貴族之死',
    nil,
    'Leve 7 Anéis-sinete de Alterac para o Magistrado Maleb na Costa Sul.‡Принесите 7 альтеракских перстней-печаток чиновнику Малебу в Южнобережье.‡Bringt 7 Alteracsiegelringe zu Magistrat Henry Maleb nach Southshore.‡사우스쇼어에 있는 집정관 말레브에게 알터랙 인장 반지 7개를 가져가야 합니다.‡Lleva 7 anillos con sello de Alterac al magistrado Maleb a Costasur.‡Lleva 7 sellos de Alterac al magistrado Maleb a Costasur.‡Apporter 7 Chevalières d\'Alterac au Magistrat Maleb à Southshore.‡为南海镇的赫尼·马雷布镇长收集7个奥特兰克徽记之戒。‡為南海鎮的赫尼·馬雷布鎮長收集7個奧特蘭克徽記之戒。',
  }
},
[513] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve o Composto Fuçalama para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите состав Грязного Рыла мастеру-аптекарю Фаранеллу в Подгород.‡Bringt das Morastschnauzengemisch zu Meisterapotheker Faranell in Undercity.‡언더시티에 있는 수석 연금술사 파라넬에게 진흙주둥이 합성물을 가져가야 합니다.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Apporter la Poudre de fangemufle au Maître Apothicaire Faranell à Undercity.‡把泥头花药交给幽暗城的大药剂师法拉尼尔。‡把泥頭花藥交給幽暗城的大藥劑師法拉尼爾。',
  }
},
[514] = {
  {
    'Uma carta para Lançatroz‡Письмо Грозовой Вершине‡Brief an Stormpike‡스톰파이크에게 보내는 편지‡Una carta para Pico Tormenta‡Carta a Pico Tormenta‡Le maître des lettres‡铁炉堡的译码者‡鐵爐堡的譯碼者',
    nil,
    'Leve a Carta Habilmente Cifrada para o Prospector Lançatroz em Altaforja.‡Отнесите хитро зашифрованное письмо геологу Грозовой Вершине в Стальгорн.‡Bringt den geschickt verschlüsselten Brief zu Ausgrabungsleiter Stormpike nach Ironforge.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta muy bien cifrada al prospector Pico Tormenta a Forjaz.‡Lleva la carta cifrada con ingenio al prospector Pico Tormenta a Forjaz.‡Apporter la Lettre ingénieusement codée au Prospecteur Stormpike à Ironforge.‡把密码信带给铁炉堡的勘察员塔伯斯·雷矛。‡把密碼信帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[515] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve a Mistura Fuçalama, uma Poção Forte de Sangue de Troll, 5 Escamas de Espinhadaga e 5 Olhos de Rancapina para o Boticário Lindolfo, na Serraria Tarren.‡Отнесите микстуру Грязного Рыла, крепкое зелье тролльей крови, 5 чешуек нагов из клана Пронзающего Гребня и 5 глаз мурлоков из клана Рваный Плавник аптекарю Лидону в Мельницу Таррен.‡Bringt die Morastschnauzenmixtur, einen starken Trollbluttrank, 5 Säbelflossenschuppen und 5 Fetzenflossenaugen zu Apotheker Lydon nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 진흙주둥이 혼합물, 강한 재생의 물약, 비수가시일족의 비늘 5개, 그리고 너덜지느러미일족의 눈 5개를 가져가야 합니다.‡Lleva la mezcla de morrobarro, una poción fuerte de sangre de trol, 5 escamas de dagaespinazo y 5 ojos de rompeanca al boticario Lydon a Molino Tarren.‡Lleva la mezcla Morrobarro, una poción de sangre de trol fuerte, 5 escamas Espinadaga y 5 ojos de aleta rasgados al boticario Lydon a Molino Tarren.‡Apporter le Brouet de fangemufle, une Potion de sang de troll forte, 5 Ecailles de Daguéchine et 5 Yeux d\'Ailerons déchirés à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把泥头花水、1瓶强力巨魔之血药水、5块刺脊纳迦的鳞片和5颗碎鳍鱼人的眼球交给塔伦米尔的药剂师林度恩。‡把泥頭花水、1瓶強力巨魔之血藥水、5塊刺脊納迦的鱗片和5顆碎鰭魚人的眼球交給塔倫米爾的藥劑師林度恩。',
  }
},
[516] = {
  {
    'Cilada de Beren‡Погибель Берена‡Beren\'s Peril‡베렌의 동굴‡El Desafío de Beren‡El Desafío de Beren‡Le Péril de Beren‡博伦的巢穴‡博倫的巢穴',
    nil,
    'Encontre a Cilada de Beren, mate 6 Mourejantes Corvinalle e 6 Guardiões Corvinalle e depois fale novamente com o Sacerdote Sombrio Allister, no Sepulcro.‡Найдите Погибель Берена, убейте 6 чернорабочих Когтя Ворона и 6 стражей Когтя Ворона, а затем вернитесь в Гробницу к жрецу Тьмы Алистеру.‡Findet zuerst Beren\'s Peril, tötet 6 Zwangsarbeiter von Rabenklaue sowie 6 Wächter von Rabenklaue und kehrt dann zu Schattenpriester Allister in das Grabmal zurück.‡베렌의 동굴에서 까마귀발톱 노역꾼 6명과 까마귀발톱 수호병 6명을 처치하고 공동묘지에 있는 어둠의사제 알리스터에게 돌아가야 합니다.‡Encuentra El Desafío de Beren y, a continuación, mata 6 esclavos Corvozarpa y 6 guardianes Corvozarpa. Por último, vuelve a ver al sacerdote de las Sombras Allister en El Sepulcro.‡Encuentra El Desafío de Beren y, a continuación, mata 6 esclavos Corvozarpa y 6 guardianes Corvozarpa. Por último, vuelve a ver al sacerdote de las Sombras Allister en El Sepulcro.‡Localiser le Péril de Beren, tuer 6 Manouvriers Ravenclaw et 6 Gardiens Ravenclaw puis retourner voir le prêtre des ombres Allister au Sépulcre.‡找到博伦的巢穴，杀死6名鸦爪苦工和6名鸦爪守护者，然后向瑟伯切尔的暗影牧师奥利斯特汇报。‡找到博倫的巢穴，殺死6名鴉爪苦工和6名鴉爪守護者，然後向瑟伯切爾的暗影牧師奧利斯特匯報。',
  }
},
[517] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve o Barril de Stout do Festeiro para o Boticário Lindolfo na Serraria Tarren.‡Принесите бочонок "Землекопского крепкого" аптекарю Лидону с мельницы Таррен.‡Bringt ein Fässchen mit Shindigger-Starkbier zu Apotheker Lydon nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 신디거 스타우트 맥주통을 가져가야 합니다.‡Lleva un barril de cerveza Machacacanillas al boticario Lydon de Molino Tarren.‡Lleva un barril de cerveza Machacacanillas al boticario Lydon de Molino Tarren.‡Apporter un baril de Bière Shindigger à l\'Apothicaire Lydon à Moulin-de-Tarren.‡将一桶矿工烈酒交给塔伦米尔的药剂师林度恩。‡將壹桶礦工烈酒交給塔倫米爾的藥劑師林度恩。',
  }
},
[518] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡Corona de la Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意誌之冠',
    nil,
    'Mate 14 Espancadores Massacristas para Melissara na Serraria Tarren.‡Убейте 14 извергов из клана Раздробленного Хребта по поручению Мелизары с мельницы Таррен.‡Tötet 14 Crushridge-Raufer für Melisara in Tarrens Mühle.‡타렌 밀농장에 있는 멜리사라를 위해 산사태일족 싸움꾼 14마리를 처치해야 합니다.‡Melisara de Molino Tarren quiere que mates a 14 destructores Aplastacresta.‡Mata 14 aplastadores Aplastacresta para Melisara en Molino Tarren.‡Tuer 14 Mutilateurs Cassecrête pour Melisara à Moulin-de-Tarren.‡塔伦米尔的梅里萨拉要你去杀掉14个破碎岭虐待者。‡塔倫米爾的梅裏薩拉要妳去殺掉14個破碎嶺虐待者。',
  }
},
[519] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡Corona de la Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意誌之冠',
    nil,
    'Mate Targ, Revirestrume e Glommus e leve a cabeça deles para Melissara na Serraria Tarren.‡Убейте Тарга, Навозера и Гломмуса и принесите их головы Мелизаре с мельницы Таррен.‡Tötet Targ, Muckrake und Glommus und bringt ihre Köpfe zu Melisara nach Tarrens Mühle.‡타르그, 무크라케, 글롬무스를 처치하고 그 증거로 그들의 머리카락을 타렌 밀농장에 있는 멜리사라에게 가져가야 합니다.‡Mata a Targ, Muckrake y Glommus y lleva sus cabezas a Melisara a Molino Tarren.‡Mata a Targ, Rastrazo y Glommus y lleva sus cabezas a Melisara a Molino Tarren.‡Tuer Targ, Fouilleboue et Glommus, puis apporter leurs têtes à Melisara à Moulin-de-Tarren.‡干掉塔尔格、玛克拉克和戈洛姆斯，把他们的头带给塔伦米尔的梅里萨拉。‡幹掉塔爾格、瑪克拉克和戈洛姆斯，把他們的頭帶給塔倫米爾的梅裏薩拉。',
  }
},
[520] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡Corona de la Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意誌之冠',
    nil,
    'Mate Mug\'Thol, e leve a cabeça dele com a Coroa da Vontade para Melissara na Serraria Tarren.‡Убейте Муг\'Тола и принесите его голову и корону Воли Мелизаре на мельницу Таррен.‡Tötet Mug\'Thol und bringt seinen Kopf mit der Krone des Willens zu Melisara nach Tarrens Mühle.‡무그톨을 처치하고 그 증거로 그의 머리카락과 의지의 왕관을 타렌 밀농장에 있는 멜리사라에게 가져가야 합니다.‡Mata a Mug’Thol y lleva su cabeza con la Corona de la Voluntad a Melisara a Molino Tarren.‡Mata a Jarra\'thol y lleva su cabeza con la Corona de Voluntad a Melisara a Molino Tarren.‡Tuer Mug\'Thol et présenter sa tête et la Couronne de Volonté à Melisara, à Moulin-de-Tarren.‡杀了玛格索尔，带着他的脑袋和意志之冠去塔伦米尔见梅里萨拉。‡殺了瑪格索爾，帶著他的腦袋和意誌之冠去塔倫米爾見梅裏薩拉。',
  }
},
[521] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡Corona de la Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意誌之冠',
    nil,
    'Entregue a Coroa da Vontade à Sharlindra na Cidade Baixa.‡Отнесите корону Воли Шарлиндре из Подгорода.‡Bringt die Krone des Willens zu Sharlindra in Undercity.‡언더시티에 있는 샬린드라에게 의지의 왕관을 가져가야 합니다.‡Ve a Entrañas para entregarle la Corona de la Voluntad a Sharlindra.‡Ve a Entrañas para entregarle la Corona de Voluntad a Sharlindra.‡Remettre la Couronne de Volonté à Sharlindra, à Undercity.‡把意志之冠交给幽暗城的沙琳德拉。‡把意誌之冠交給幽暗城的沙琳德拉。',
  }
},
[522] = {
  {
    'Contrato do assassino‡Контракт убийцы‡Auftragsmördervertrag‡청부업자의 계약서‡Contrato de asesino‡Contrato de asesino‡Contrat de l\'assassin‡刺客的契约‡刺客的契約',
    nil,
    'Leve o Contrato do Assassino ao Magistrado Maleb, na Costa Sul.‡Отнесите контракт убийцы чиновнику Малебу в Южнобережье.‡Bringt den Auftragsmörder-Vertrag zu Magistrat Maleb nach Southshore.‡사우스쇼어에 있는 집정관 말레브에게 청부업자의 계약서를 가져가야 합니다.‡Lleva el contrato de asesinato al magistrado Maleb a Costasur.‡Lleva el contrato de asesinato al magistrado Maleb a Costasur.‡Apporter le Contrat de l\'assassin au Magistrat Maleb à Southshore.‡把刺客的契约带给南海镇的赫尼·马雷布镇长。‡把刺客的契約帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[523] = {
  {
    'A morte do Barão‡Смерть барона‡Ableben des Barons‡바르두스 남작 심판‡Muerte al Barón‡La muerte del barón‡La mort du baron Vardus‡男爵之死‡男爵之死',
    nil,
    'Leve a Cabeça do Barão Vardus ao Magistrado Maleb na Costa Sul.‡Принесите голову барона Вардуса чиновнику Малебу в Южнобережье.‡Bringt den Kopf von Baron Vardus zu Magistrat Maleb nach Southshore.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 사우스쇼어에 있는 집정관 말레브에게 가져가야 합니다.‡Lleva la cabeza del Barón Vardus al magistrado Maleb a Costasur.‡Lleva la cabeza del Barón Vardus al magistrado Maleb a Costasur.‡Apporter la tête du baron Vardus au Magistrat Maleb à Southshore.‡把瓦杜斯男爵的头带给南海镇的赫尼·马雷布镇长。‡把瓦杜斯男爵的頭帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[524] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Coloque o Barril Estragado no tapete para os fazendeiros capturados.‡Поставьте гниющий бочонок на ковер для плененных фермеров.‡Stellt das besudelte Fässchen auf den Teppich für die gefangenen Bauern.‡오염된 맥주통을 사로잡힌 농부들이 있는 방의 양탄자 위에 가져다 놓아야 합니다.‡Coloca el barril contaminado en la alfombra para los granjeros.‡Coloca el barril contaminado en la alfombra para los granjeros.‡Placer le Baril infecté sur le tapis pour les fermiers détenus comme otages.‡把被污染的酒桶放在被俘农夫房间的地毯上。‡把被汙染的酒桶放在被俘農夫房間的地毯上。',
  }
},
[525] = {
  {
    'Outros mistérios‡Все больше тайн‡Weitere Geheimnisse‡깊어지는 의문‡Más misterios‡Más misterios‡D\'autres mystères‡更大的谜团‡更大的謎團',
    nil,
    'Entregue a Carta Decifrada para o Magistrado Maleb, em Costa Sul.‡Доставьте расшифрованное письмо чиновнику магистрата Южнобережья Малебу.‡Bringt den entschlüsselten Brief zu Magistrat Maleb nach Southshore.‡사우스쇼어에 있는 집정관 말레브에게 해독된 편지를 가져가야 합니다.‡Lleva la carta descifrada al magistrado Maleb a Costasur.‡Lleva la carta descifrada al magistrado Maleb a Costasur.‡Apporter la Lettre décodée au Magistrat Maleb, à Southshore.‡把被破译的信件交给南海镇的赫尼·马雷布镇长。‡把被破譯的信件交給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[526] = {
  {
    'Lingotes da forja de luz‡Слитки светлостали‡Lichtschmiedeblöcke‡라이트포지 주괴‡Lingotes Forjaluz‡Lingotes Forjaluz‡Les lingots de sancteforge‡光铸铁锭‡光鑄鐵錠',
    nil,
    'Colete 5 Lingotes da Forja de Luz e fale novamente com Glorin Testaço no Pantanal.‡Найдите 5 слитков светлостали и вернитесь к Глорину Стальному Лбу в Болотину.‡Sammelt 5 Lichtschmiedeblöcke und kehrt dann zu Glorin Steelbrow im Sumpfland zurück.‡라이트포지 주괴 5개를 모은 다음 저습지에 있는 글로린 스틸브로우에게 돌아가야 합니다.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Collecter 5 Lingots de sancteforge, puis retourner voir Glorin Steelbrow, dans les Paluns.‡收集5块光铸铁锭，把它们交给湿地的戈罗林·钢眉。‡收集5塊光鑄鐵錠，把它們交給濕地的戈羅林·鋼眉。',
  }
},
[527] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate 6 Lavradores de Eira dos Montes, 6 Fazendeiros de Eira dos Montes, o Fazendeiro Raí e o Fazendeiro Pegaz, depois apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте 6 хилсбрадских батраков, 6 хилсбрадских фермеров, фермеров Рея и Гетца и возвращайтесь к Дарталии на мельницу Таррен.‡Tötet 6 Landarbeiter von Hillsbrad, 6 Bauern von Hillsbrad, Bauer Ray und Bauer Getz und meldet Euch dann wieder bei Darthalia in Tarrens Mühle.‡힐스브래드 농노 6명, 힐스브래드 농부 6명, 그리고 농부 레이와 농부 게츠를 처치한 다음 타렌 밀농장에 있는 다살리아에게 보고해야 합니다.‡Mata a 6 mozos de labranza de Trabalomas y 6 granjeros de Trabalomas, al granjero Ray y al granjero Getz e informa a Darthalia en Molino Tarren.‡Mata a 6 mozos de labranza de Trabalomas y 6 granjeros de Trabalomas, al granjero Ray y al granjero Getz e informa a Darthalia en Molino Tarren.‡Tuer 6 Garçons de ferme, 6 Fermiers, le Fermier Ray et le Fermier Getz, puis retourner voir Darthalia à Moulin-de-Tarren.‡杀掉6个希尔斯布莱德雇农和6个希尔斯布莱德农夫，还有农夫雷恩和农夫盖兹，然后返回塔伦米尔向达萨利亚报告。‡殺掉6個希爾斯布萊德雇農和6個希爾斯布萊德農夫，還有農夫雷恩和農夫蓋茲，然後返回塔倫米爾向達薩利亞報告。',
  }
},
[528] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate 15 Camponeses de Eira dos Montes e apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте 15 хилсбрадских крестьян и вернитесь к Дарталии на мельницу Таррен.‡Tötet 15 Arbeiter von Hillsbrad und erstattet Bericht bei Darthalia in Tarrens Mühle.‡힐스브래드 소작농 15명을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata a 15 campesinos de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata a 15 campesinos de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer 15 Paysans d\'Hillsbrad et faire votre rapport à Darthalia à Moulin-de-Tarren.‡杀死15个希尔斯布莱德农民，然后回到塔伦米尔向达萨利亚汇报。‡殺死15個希爾斯布萊德農民，然後回到塔倫米爾向達薩利亞匯報。',
  }
},
[529] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Ferreiro Verrintão e 4 Ferreiros Aprendizes de Eira dos Montes.|nConfisque um carregamento de ferro e apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте кузнеца Верринтана и 4 хилсбрадских учеников кузнеца.|nПринести партию железа Дарталии на мельницу Таррен.‡Tötet Schmied Verringtan und 4 Schmiedelehrlinge von Hillsbrad.|nBesorgt eine Eisenlieferung und erstattet Bericht bei Darthalia in Tarrens Mühle.‡대장장이 베링턴과 힐스브래드 견습대장장이 4명을 처치해야 합니다.|n철괴 상자를 찾은 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고하십시오.‡Mata al herrero Verringtan y a 4 aprendices de herrero de Trabalomas.|nRecupera un cargamento de hierro e informa a Darthalia en Molino Tarren.‡Mata al herrero Verringtan y a 4 herreros aprendices de Trabalomas.|nRecupera un envío de hierro e informa a Darthalia en Molino Tarren.‡Tuer le Forgeron Verringtan et 4 Apprentis Forgerons d\'Hillsbrad.|nRécupérer un Chargement de fer, puis retourner voir Darthalia à Moulin-de-Tarren.‡杀掉铁匠维林坦和4个希尔斯布莱德见习铁匠，并从那里抢回一箱铁材，然后向塔伦米尔的达萨利亚汇报。‡殺掉鐵匠維林坦和4個希爾斯布萊德見習鐵匠，並從那裏搶回壹箱鐵材，然後向塔倫米爾的達薩利亞匯報。',
  }
},
[530] = {
  {
    'A vingança do marido‡Месть мужа‡Rache eines Ehemanns‡랠리의 복수‡La venganza de un esposo‡La venganza de un esposo‡La vengeance d\'un mari‡丈夫的复仇‡丈夫的復仇',
    nil,
    'Mate Valfrido Moray.|nLeve as mãos dele para Olavo Nascimento na Cidade Baixa.‡Убейте Валдреда Морая.|nПринесите его руки Роли Андреану в Подгород.‡Tötet Valdred Moray.|nBringt seine Hände zu Raleigh Andrean nach Undercity.‡발드레드 모레이를 처치해야 합니다.|n그 증거로 언더시티에 있는 랠리 앤드리언에게 발드레드의 장갑을 가져가야 합니다.‡Mata a Valdred Moray.|nLlévale sus manos a Raleigh Andrean, que está en Entrañas.‡Mata a Valdred Moray.|nLlévale sus manos a Raleigh Andrean, que está en Entrañas.‡Tuer Valdred Moray.|nApporter ses mains à Raleigh Andrean à Undercity.‡杀掉瓦德雷·莫莱。|n把他的双手带给幽暗城的拉林夫·安迪恩。‡殺掉瓦德雷·莫萊。|n把他的雙手帶給幽暗城的拉林夫·安迪恩。',
  }
},
[531] = {
  {
    'A vingança de Vyrin‡Месть Вайрины‡Vyrins Rache‡바이린의 복수‡La venganza de Vyrin‡La venganza de Vyrin‡La vengeance de Vyrin‡维林的报复‡維林的報復',
    nil,
    'Entregue a Cabeça do Velho Fumaça para Vyrin Velozvento no Pavilhão dos Andarilhos.‡Принесите голову Старины Черношкура Вайрине Быстрый Ветер в Приют странников.‡Bringt Old Sootys Kopf zu Vyrin Swiftwind in die Weitschreiter-Lodge.‡순찰자의 오두막에 있는 바이린 스위프트윈드에게 늙은곰 수티의 머리를 가져가야 합니다.‡Lleva la cabeza de Ol\' Sooty a Vyrin Vientoveloz a la Cabaña del Errante.‡Lleva la cabeza del viejo Tiznado a Vyrin Vientoveloz a la Cabaña del Errante.‡Amener la tête du vieux Noiraud à Vyrin Swiftwind au pavillon des pérégrins.‡把奥尔苏迪的头交给旅行者营地的维林·疾风。‡把奧爾蘇迪的頭交給旅行者營地的維林·疾風。',
  }
},
[532] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Magistrado Ardelado e 5 Conselheiros de Eira dos Montes. Destrua a Proclamação de Eira dos Montes. Roube o Livro de Registro de Eira dos Montes. Depois apresente-se de volta a Darthalia na Serraria Tarren.‡Убейте мирового судью Бернсайда и 5 членов совета Хилсбрада. Уничтожьте Хилсбрадское официальное объявление. Украдите регистрационную книгу Хилсбрада. Возвращайтесь к Дарталии на мельницу Таррен.‡Tötet Magistrat Burnside und 5 Ratsherren von Hillsbrad. Zerstört die Proklamation von Hillsbrad. Stehlt das Stadtregister von Hillsbrad. Meldet Euch danach bei Darthalia in Tarrens Mühle.‡집정관 번사이드와 힐스브래드 원로 5명을 처치해야 합니다. 힐스브래드 선언문을 파괴하고 힐스브래드 마을의 기록부를 빼내 와야 합니다. 그런 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고하십시오.‡Mata al magistrado Ladoquemao y a 5 concejales de Trabalomas. Destruye la Declaración de Trabalomas. Saquea el registro civil. Después informa a Darthalia en Molino Tarren.‡Mata al magistrado Ladoquemado y 5 consejeros de Trabalomas. Destruye la Proclamación de Trabalomas. Roba el registro de Trabalomas. Luego preséntate ante Darthalia en Molino Tarren.‡Tuer le Magistrat Burnside et 5 Conseillers d\'Hillsbrad. Détruire la Proclamation d\'Hillsbrad. Voler le Registre municipal d\'Hillsbrad. Rendre compte à Darthalia à Moulin-de-Tarren.‡杀掉波恩塞德镇长和5个希尔斯布莱德议员，摧毁《希尔斯布莱德宣言》，偷取希尔斯布莱德城镇文档，然后回到塔伦米尔向达萨利亚汇报。‡殺掉波恩塞德鎮長和5個希爾斯布萊德議員，摧毀《希爾斯布萊德宣言》，偷取希爾斯布萊德城鎮文檔，然後回到塔倫米爾向達薩利亞匯報。',
  }
},
[533] = {
  {
    'Infiltração‡Шпионская работа‡Unterwanderung‡침투‡Infiltración‡Infiltración‡Infiltration‡秘密潜入‡秘密潛入',
    nil,
    'Obtenha informações sobre o paradeiro de Gol\'dir para Krusk na Serraria Tarren.‡Добудьте сведения о местонахождении Гол\'дира для Круска с мельницы Таррен.‡Holt Informationen über Gol\'dirs Aufenthaltsort für Krusk in Tarrens Mühle ein.‡타렌 밀농장에 있는 크루스크를 위해 골디르가 어디에 있는지 정보를 찾아야 합니다.‡Consigue información sobre el paradero de Gol\'dir\'s e informa a Krusk en Molino Tarren.‡Consigue información sobre el paradero de Gol\'dir\'s e informa a Krusk en Molino Tarren.‡Rapporter des informations sur la localisation de Gol\'dir pour Krusk, à Moulin-de-Tarren.‡把关于高迪尔下落的消息带回来给塔伦米尔的克鲁斯克。‡把關於高迪爾下落的消息帶回來給塔倫米爾的克魯斯克。',
  }
},
[535] = {
  {
    'Vito‡Валлик‡Valik‡발릭‡Valik‡Valik‡Valik‡仆从瓦里克‡仆從瓦裏克',
    nil,
    'Leve um caneco de Stout da Costa Sul para Vito no acampamento da Camarilha.‡Принесите кружку эля из Южнобережья Вэллику в лагерь Синдиката.‡Bringt einen Becher mit Southshore-Starkbier zu Valik in das Lager des Syndikats.‡비밀결사대 야영지에 있는 발릭에게 사우스쇼어의 스타우트 맥주 한 잔을 가져가야 합니다.‡Llévale 1 jarra de cerveza Costasur a Valik en el campamento de la Hermandad.‡Llévale 1 jarra de cerveza de Costasur a Valik en el campamento de la Hermandad.‡Apporter une Chope de bière de Southshore à Valik, au Camp du Syndicat.‡给辛迪加营地里的瓦里克带去一杯南海镇烈酒。‡給辛迪加營地裏的瓦裏克帶去壹杯南海鎮烈酒。',
  }
},
[536] = {
  {
    'Desceu pro mar‡На побережье‡Die Küste entlang‡해안의 위협‡Al lo largo de la costa‡En la costa‡Le long de la côte‡清理海岸‡清理海岸',
    nil,
    'Mate 10 Caçamarés Rancapinas e 10 Oráculos Rancapinas para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 волноловов из племени Порванного Плавника и 10 оракулов из племени Порванного Плавника по поручению лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Gezeitenjäger der Fetzenflossen und 10 Orakel der Fetzenflossen für Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬이 너덜지느러미멀록 바다사냥꾼 10마리와 너덜지느러미멀록 점쟁이 10마리를 처치해달라고 부탁했습니다.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del general Farren Orinelle de Costasur.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del teniente Farren Orinelle de Costasur.‡Tuer 10 Chasse-marées et 10 Oracles Aileron déchiré pour le lieutenant Farren Orinelle à Southshore.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个碎鳍潮行鱼人和10个碎鳍智者。‡南海鎮的法爾林·奧裏涅爾中尉要妳去殺掉10個碎鰭潮行魚人和10個碎鰭智者。',
  }
},
[537] = {
  {
    'Concílio sombrio‡Темный совет‡Der Dunkle Rat‡어둠의 의회‡Consejo oscuro‡Consejo oscuro‡Le conseil noir‡黑暗议会‡黑暗議會',
    nil,
    'Mate 4 Magos das Sombras Argus.|nLeve a Cabeça de Nagaz ao Magistrado na Costa Sul.‡Убейте 4 темных магов Недремлющего Аргуса.|nПринесите голову Нагаза мировому судье Южнобережья Малебу.‡Tötet 4 Schattenmagier der Arguswacht.|nBringt den Kopf von Nagaz zu Magistrat Maleb nach Southshore.‡아르거스 재림회 어둠마법사 4명을 처치해야 합니다.|n그리고 나가즈를 처치한 증거로 그의 머리카락을 사우스쇼어에 있는 집정관 헨리 말레브에게 가야 합니다.‡Mata a 4 magos de la Sombra Argus.|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Mata a 4 magos de la Sombra Argus.|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Tuer 4 Mages de l\'ombre d\'Argus.|nApporter la Tête de Nagaz au Magistrat Maleb à Southshore.‡杀死4个暗影大法师。|n把纳伽兹的头带给南海镇的马雷布镇长。‡殺死4個暗影大法師。|n把納伽茲的頭帶給南海鎮的馬雷布鎮長。',
  }
},
[538] = {
  {
    'Costa Sul‡Южнобережье‡Southshore‡사우스쇼어‡Costasur‡Costasur‡Southshore‡南海镇‡南海鎮',
    nil,
    'Fale com o Historiador Dibbs em Costa Sul.‡Поговорите с Хранителем мудрости Диббсом в Южнобережье.‡Sprecht mit dem Meister der Lehren Dibbs in Southshore.‡사우스쇼어에 있는 현자 딥스와 대화해야 합니다.‡Habla con el maestro del Conocimiento Dibbs en Costasur.‡Habla con el maestro cultural Dibbs en Costasur.‡Parler à l\'Erudit Dibbs à Southshore.‡与南海镇的博学者迪布斯交谈。‡與南海鎮的博學者迪布斯交談。',
  }
},
[539] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Encarregado Grilhões e 10 Mineradores de Eira dos Montes, depois apresente-se novamente a Darthalia em Serraria Tarren.‡Убейте штейгера Бондса и 10 хилсбрадских шахтеров и доложите о проделанной работе Дарталии на мельнице Таррен.‡Tötet Großknecht Bonds sowie 10 Minenarbeiter von Hillsbrad und erstattet Bericht bei Darthalia in Tarrens Mühle.‡현장감독 본즈와 힐스브래드 광부 10명을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer le Contremaître Bonds et 10 Mineurs d\'Hillsbrad, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡杀死工头邦德斯和10个希尔斯布莱德矿工，然后回到塔伦米尔向达萨利亚汇报。‡殺死工頭邦德斯和10個希爾斯布萊德礦工，然後回到塔倫米爾向達薩利亞匯報。',
  }
},
[540] = {
  {
    'O conhecimento precisa ser preservado‡Сохранение знаний‡Wissen bewahren‡지식 보존‡Proteger el conocimiento‡Proteger el conocimiento‡L\'entretien des connaissances‡保全书籍‡保全書籍',
    nil,
    'Leve 5 Tomos Recuperados e o Livro de Couro Desgastado contendo o Braço de Gri\'lek para o Historiador Dibbs, em Costa Sul.‡Найдите 5 фолиантов и потертую кожаную книгу, называемую "Рука Гри\'лека", и принесите их хранителю мудрости Диббсу в Южнобережье.‡Bringt 5 geborgene Folianten und das abgenutzte Lederbuch, das \'Der Arm von Gri\'lek\' enthält, zum Meister der Lehren Dibbs nach Southshore.‡되찾은 학술서 5권과 그리렉의 팔이 들어 있는 낡은 가죽 책을 사우스쇼어에 있는 현자 딥스에게 가져가야 합니다.‡Lleva 5 tomos y el libro de piel gastado que contiene El Arma de Gri\'lek al maestro del Conocimiento Dibbs a Costasur.‡Lleva 5 tomos y el libro de piel gastado que contiene El Arma de Gri\'lek al maestro cultural Dibbs a Costasur.‡Apporter 5 Tomes retrouvés, ainsi que le Livre de cuir usé « Le Bras de Gri\'lek » au Maître des traditions Dibbs, à Southshore.‡把5本失而复得的书籍和包含《格里雷克之臂》的破旧的皮书带给南海镇的博学者迪布斯。‡把5本失而復得的書籍和包含《格裏雷克之臂》的破舊的皮書帶給南海鎮的博學者迪布斯。',
  }
},
[541] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Viaje até Dun Garok é mate 10 Montanhistas, 8 Carabineiros, 4 Sacerdotes e o Capitão Monteferro, depois apresente-se novamente a Darthalia na Serraria Tarren.‡Отправляйтесь в Дун Гарок и убейте 10 горных пехотинцев, 8 стрелков, 4 жрецов и капитана Железную Гору. После возвращайтесь к Дарталии на мельницу Таррен.‡Begebt Euch nach Dun Garok, tötet 10 Gebirgsjäger, 8 Scharfschützen, 4 Priester sowie Captain Eisenberg und erstattet danach Bericht bei Darthalia in Tarrens Mühle.‡던 가록으로 가서 던 가록 산악경비대 10명, 던 가록 소총병 8명, 던 가록 사제 4명과 부대장 아이언힐을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Ve a Dun Garok y mata a 10 montaraces, 8 fusileros, 4 sacerdotes y al capitán Ferrocolina e informa a Darthalia en Molino Tarren.‡Viaja a Dun Garok y mata 10 montaraces, 8 fusileros, 4 sacerdotes y al capitán Ferrocolina y vuelve a ver a Darthalia en Molino Tarren.‡Aller à Dun Garok et tuer 10 Montagnards, 8 Fusiliers, 4 Prêtres et le Capitaine Ironhill, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡到丹加洛克去杀掉10个巡山人、8个火枪手、4个牧师，还有达伦·铁山上尉，然后回到塔伦米尔向达萨利亚汇报。‡到丹加洛克去殺掉10個巡山人、8個火槍手、4個牧師，還有達倫·鐵山上尉，然後回到塔倫米爾向達薩利亞匯報。',
  }
},
[542] = {
  {
    'Fale novamente com Milton‡Возвращение к Милтону‡Rückkehr zu Milton‡밀턴에게 돌아가기‡Vuelve con Milton‡Regreso a Milton‡Les livres de Milton‡向米尔顿回复‡向米爾頓回復',
    nil,
    'Leve os Tomos de Alterac para Milton Resma, em Ventobravo.‡Отнесите фолианты Альтерака Милтону Снопу в Штормград.‡Bringt die Folianten von Alterac zu Milton Sheaf nach Stormwind.‡스톰윈드에 있는 밀턴 시프에게 알터랙의 학술서를 가져가야 합니다.‡Lleva los Tomos de Alterac a Milton Gavilla a Ventormenta.‡Lleva los Tomos de Alterac a Milton Gavilla a Ventormenta.‡Apporter les Tomes d\'Alterac à Milton Sheaf à Stormwind.‡把奥特兰克的书籍带给暴风城的米尔顿·西弗。‡把奧特蘭克的書籍帶給暴風城的米爾頓·西弗。',
  }
},
[543] = {
  {
    'A Tiara de Perenolde‡Тиара Перенольда‡Die Perenolde-Tiara‡페레놀드 티아라‡La Tiara Perenolde‡La Tiara Perenolde‡La tiare de Perenolde‡匹瑞诺德王冠‡匹瑞諾德王冠',
    nil,
    'Leve a Tiara de Perenolde para o Conde Capistrano de Espargosa, em Ventobravo.‡Доставьте тиару Перенольда Ремингтону Риджвеллу в Штормград.‡Bringt die Perenolde-Tiara zu Remington Ridgewell nach Stormwind.‡스톰윈드에 있는 레밍턴 리지웰에게 페레놀드 티아라를 가져가야 합니다.‡Lleva la Tiara Perenolde a Remington Crestabuena en Ventormenta.‡Llévale la Tiara Perenolde a Remington Bonacresta en Ventormenta.‡Apporter la Tiare de Perenolde à Remington Ridgewell, à Stormwind.‡将匹瑞诺德王冠带给暴风城的雷明顿·瑞治维尔。‡將匹瑞諾德王冠帶給暴風城的雷明頓·瑞治維爾。',
  }
},
[544] = {
  {
    'Invasão da prisão‡Взлом тюрьмы‡Gefängnis-Einbruch‡감옥 습격‡Colarse en la cárcel‡Colarse en la cárcel‡L\'invasion de la prison‡入室偷窃‡入室偷竊',
    nil,
    'Encontre os traidores e recupere os artefatos, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Найдите предателей и отберите у них артефакты, а потом возвращайтесь к волхву Сиянью Бездны в Мельницу Таррен.‡Findet diese Verräter, sammelt ihre Artefakte ein und kehrt dann zu Magus Voidglare nach Tarrens Mühle zurück.‡배반자들을 찾아내 유물을 되찾은 다음 타렌 밀농장에 있는 학자 워딘 보이드글레어에게 돌아가야 합니다.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el mago Vacuamirada en Molino Tarren.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el magus Vacuamirada en Molino Tarren.‡Trouver les traîtres et récupérer les artefacts, puis retourner voir le magus Voidglare à Moulin-de-Tarren.‡找到被遗忘者的叛徒，取回他们偷走的神器，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡找到被遺忘者的叛徒，取回他們偷走的神器，然後回到塔倫米爾去見大法師沃迪恩·伍德格萊爾。',
  }
},
[545] = {
  {
    'Patrulhas de Dalaran‡Даларанские патрули‡Patrouillen von Dalaran‡달라란 순찰‡Las patrullas de Dalaran‡Las patrullas de Dalaran‡Les patrouilles de Dalaran‡达拉然巡逻队‡達拉然巡邏隊',
    nil,
    'Mate 6 Evocadores de Dalaran e 12 Escravos Elementais, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Убейте 6 даларанских призывателей и 12 порабощенных элементалей. Затем возвращайтесь к волхву Сиянью Бездны на мельницу Таррен.‡Tötet 6 Beschwörer von Dalaran sowie 12 Elementarsklaven und kehrt dann zu Magus Voidglare nach Tarrens Mühle zurück.‡달라란 소환사 6명과 노예 바위 정령 12마리를 처치한 다음 타렌 밀농장에 있는 학자 워딘 보이드글레어에게 돌아가야 합니다.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el mago Vacuamirada en Molino Tarren.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el magus Vacuamirada en Molino Tarren.‡Tuer 6 Invocateurs de Dalaran et 12 Esclaves élémentaires, puis retourner voir le magus Voidglare à Moulin-de-Tarren.‡杀掉6个达拉然召唤师和12个元素奴仆，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡殺掉6個達拉然召喚師和12個元素奴仆，然後回到塔倫米爾去見大法師沃迪恩·伍德格萊爾。',
  }
},
[546] = {
  {
    'Lembrancinhas da morte‡Сувениры смерти‡Andenken des Todes‡죽음의 전리품‡Recuerdos de muerte‡Recuerdos de muerte‡Souvenirs de morts‡死亡的纪念品‡死亡的紀念品',
    nil,
    'O Necroguarda Sandoval da Serraria Tarren quer 30 Crânios Humanos de Eira dos Montes.‡Страж смерти Самса с мельницы Таррен попросил принести 30 человеческих черепов Хилсбрада.‡Todeswache Samsa aus Tarrens Mühle will 30 menschliche Schädel aus Hillsbrad.‡타렌 밀농장에 있는 죽음의경비병 삼사가 힐스브래드 주민의 해골 30개를 가져다 달라고 부탁했습니다.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 calaveras humanas de Trabalomas.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 calaveras humanas de Trabalomas.‡Le Garde noir Samsa du Moulin-de-Tarren veut 30 Crânes d\'humains d\'Hillsbrad.‡塔伦米尔的亡灵卫兵沙穆萨想要30个希尔斯布莱德人类颅骨。‡塔倫米爾的亡靈衛兵沙穆薩想要30個希爾斯布萊德人類顱骨。',
  }
},
[547] = {
  {
    'Espada do Humberto‡Меч Гумберта‡Humberts Schwert‡험버트의 검‡La espada de Humbert‡La espada de Humbert‡Epée d\'Humbert‡亨伯特的长剑‡亨伯特的長劍',
    nil,
    'Recupere a espada do Necroguarda Humberto em Dun Garok e devolva-a para ele na Serraria Tarren.‡Найдите меч стража смерти Гумберта в Дун Гароке и верните его владельцу на мельнице Таррен.‡Bringt das Schwert von Todeswache Humbert aus Dun Garok zu ihm nach Tarrens Mühle zurück.‡던 가록에서 죽음의경비병 험버트의 검을 되찾아 타렌 밀농장으로 돌아와 험버트에게 검을 돌려줘야 합니다.‡Recoge la espada del guardia de la muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Recoge la espada del Guardia de la Muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Retrouver l\'Epée du Garde noir Humbert et la lui retourner à Moulin-de-Tarren.‡从丹加洛克拿回亡灵卫兵亨伯特的长剑，然后回到塔伦米尔把剑还给他。‡從丹加洛克拿回亡靈衛兵亨伯特的長劍，然後回到塔倫米爾把劍還給他。',
  }
},
[549] = {
  {
    'PROCURA-SE: integrantes da Camarilha‡РАЗЫСКИВАЮТСЯ: сторонники Синдиката‡GESUCHT: Syndikatspersonal‡비밀결사대원 현상수배‡SE BUSCA: Personal de la Hermandad‡SE BUSCA: Personal de la Hermandad‡ON RECHERCHE : Personnel du Syndicat‡通缉：辛迪加成员‡通緝：辛迪加成員',
    nil,
    'Mate 10 Ladinos da Camarilha e 10 Vigias da Camarilha. Fale novamente com a Alta-executora Darthalia na Serraria Tarren para receber sua recompensa.‡Убейте 10 разбойников и 10 сторожей Синдиката и возвращайтесь за наградой к верховному палачу Дарталии в Мельницу Таррен.‡Tötet 10 Schurken des Syndikats und 10 Wachmänner des Syndikats. Kehrt danach zu Hochexekutorin Darthalia nach Tarrens Mühle zurück.‡비밀결사대 도적 10명과 비밀결사대 경비병 10명을 처치해야 합니다. 그런 다음 타렌 밀농장에 있는 고위집행관 다살리아에게 돌아가 보상금을 받으십시오.‡Mata a 10 pícaros y 10 vigilantes de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Mata a 10 pícaros y 10 veladores de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Tuer 10 Voleurs et 10 Gardiens du Syndicat, puis aller voir la Grande Exécutrice Darthalia à Moulin-de-Tarren pour votre récompense.‡杀死10个辛迪加潜行者和10个辛迪加哨兵，然后回到塔伦米尔向高级执行官达萨利亚报告。‡殺死10個辛迪加潛行者和10個辛迪加哨兵，然後回到塔倫米爾向高級執行官達薩利亞報告。',
  }
},
[550] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um Hillsbrad‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Leve a Comenda Lacrada de Darthalia para Varimatras, na Cidade Baixa.‡Отнесите запечатанное рекомендательное письмо Дарталии Вариматрасу в Подгород.‡Bringt Darthalias versiegelte Belobigung zu Varimathras nach Undercity.‡언더시티에 있는 바리마트라스에게 다살리아의 봉인된 추천서를 가져가야 합니다.‡Lleva la mención de honor lacrada de Darthalia a Varimathras en Entrañas.‡Lleva la mención de honor lacrada de Darthalia a Varimathras en Entrañas.‡Apporter la Recommandation scellée à Varimathras à Undercity.‡把达萨利亚的奖状交给幽暗城的瓦里玛萨斯。‡把達薩利亞的獎狀交給幽暗城的瓦裏瑪薩斯。',
  }
},
[551] = {
  {
    'Pergaminho encantado‡Заколдованный пергамент‡Das Verhexte Pergament‡마법의 양피지‡El pergamino encantado‡El papiro encantado‡Le Parchemin ensorcelé‡附有魔法的羊皮纸‡附有魔法的羊皮紙',
    nil,
    'Leve o Pergaminho Encantado para o Historiador Dibbs, em Costa Sul.‡Отнесите заколдованный пергамент Хранителю мудрости Диббсу в Южнобережье.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Southshore.‡사우스쇼어에 있는 현자 딥스에게 마법의 양피지를 가져가야 합니다.‡Lleva el pergamino encantado al maestro del Conocimiento Dibbs en Costasur.‡Llévale el papiro hechizado al maestro cultural Dibbs en Costasur.‡Apporter le Parchemin ensorcelé à l\'Erudit Dibbs à Southshore.‡将这张附有魔法的羊皮纸带给南海镇的博学者迪布斯。‡將這張附有魔法的羊皮紙帶給南海鎮的博學者迪布斯。',
  }
},
[552] = {
  {
    'Uma vingança para Helcolar‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡La venganza de Helcular‡La venganza de Helcular‡La vengeance d\'Helcular‡赫尔库拉的复仇‡赫爾庫拉的復仇',
    nil,
    'Recupere o Bastão de Helcolar do Yeti e leve-o de volta para o Noviço Trevando, em Serraria Tarren.‡Отберите у йети жезл Гелькулара и отнесите его новобранцу Тайлванду на мельницу Таррен.‡Holt Helculars Rute von dem Yeti und bringt sie zu Novize Thaivand nach Tarrens Mühle zurück.‡설인에게서 헬쿨라의 마법봉을 되찾아 타렌 밀농장에 있는 수련사 사이반드에게 가져가야 합니다.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Reprendre le Bâtonnet d\'Helcular aux yétis et la ramener au novice Thaivand à Moulin-de-Tarren.‡从雪怪手上拿回赫尔库拉的魔棒，把它交给塔伦米尔的学徒塞万德。‡從雪怪手上拿回赫爾庫拉的魔棒，把它交給塔倫米爾的學徒塞萬德。',
  }
},
[553] = {
  {
    'Uma vingança para Helcolar‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡La venganza de Helcular‡La venganza de Helcular‡La vengeance d\'Helcular‡赫尔库拉的复仇‡赫爾庫拉的復仇',
    nil,
    'Carregue o Bastão de Helcolar com os poderes da Chama de Azel, da Chama de Veraz e da Chama de Uzel.|nColoque o bastão carregado na tumba de Helcolar, em Costa Sul.‡Зарядите Гелькуларов жезл силой пламени Азеля, пламени Вераза и пламени Узеля.|nВонзите заряженный жезл в гробницу Гелькулара в Южнобережье.‡Ladet die Rute von Helcular mit der Macht der Flamme von Azel, der Flamme von Veraz und der Flamme von Uzel auf.|nStoßt die aufgeladene Rute in Helculars Grab in Southshore.‡헬쿨라의 마법봉에 아젤의 불꽃, 베라즈의 불꽃, 우젤의 불꽃의 마력을 불어넣어야 합니다.|n힘을 불어넣은 마법봉을 사우스쇼어에 있는 헬쿨라의 무덤으로 가져가야 합니다.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la LLama de Veraz y la Llama de Uzel.|nLuego llévala a la tumba de Helcular en Costasur.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la Llama de Veraz y la Llama de Uzel.|nLuego llévala a la tumba de Helcular en Costasur.‡Charger le Bâtonnet d\'Helcular des pouvoirs de la Flamme d\'Azel, de la Flamme de Veraz et de la Flamme d\'Uzel.|nEnfoncez le Bâtonnet chargé dans la tombe d\'Helcular à Southshore.‡将埃希尔之焰、沃拉兹之焰和尤基尔之焰的力量注入赫尔库拉的魔棒。|n把经过仪式洗礼之后的魔棒带到南海镇的赫尔库拉墓地。‡將埃希爾之焰、沃拉茲之焰和尤基爾之焰的力量註入赫爾庫拉的魔棒。|n把經過儀式洗禮之後的魔棒帶到南海鎮的赫爾庫拉墓地。',
  }
},
[554] = {
  {
    'Decifração de Lançatroz‡Расшифровщик Грозовая Вершина‡Stormpikes Entschlüsselung‡스톰파이크의 판독‡La descodificación de Pico Tormenta‡La descodificación de Pico Tormenta‡Stormpike décode‡解码高手‡解碼高手',
    nil,
    'Leve o Pergaminho Encantado para o Prospector Lançatroz, em Altaforja.‡Отнесите заколдованный пергамент геологу Грозовой Вершине в Стальгорн.‡Bringt das verhexte Pergament zu Ausgrabungsleiter Stormpike nach Ironforge.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 마법의 양피지를 가져가야 합니다.‡Lleva el pergamino codificado al prospector Pico Tormenta a Forjaz.‡Lleva el papiro codificado al prospector Pico Tormenta a Forjaz.‡Apporter le Parchemin ensorcelé au Prospecteur Stormpike à Ironforge.‡把附有魔法的羊皮纸带给铁炉堡的勘察员塔伯斯·雷矛。‡把附有魔法的羊皮紙帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[555] = {
  {
    'Caldo reconfortante de tartaruga‡Нежный черепаховый суп‡Milde Schildkrötensuppe‡독특한 거북이 비스크‡Sopa de tortuga calmante‡Sopa de tortuga reconfortante‡Bisque de tortue apaisante‡海龟汤‡海龜湯',
    nil,
    'Leve 10 peças de Carne de Tartaruga e alguns Temperos Reconfortantes para o Mestre-cuca Jessé, em Costa Sul.‡Принесите 10 кусков черепашьего мяса и немного смягчающих пряностей шеф-повару Джессену в Южнобережье.‡Bringt 10 Stücke Schildkrötenfleisch und einige feine Gewürze zu Küchenchef Jessen nach Southshore.‡사우스쇼어에 있는 주방장 예센에게 거북이 고기 10개와 독특한 양념을 가져가야 합니다.‡Lleva 10 piezas de carne de tortuga y especias calmantes al chef Jessen a Costasur.‡Llévale 10 piezas de carne de tortuga y algunas especias calmantes al chef Jessen en Costasur.‡Apporter 10 morceaux de Viande de tortue et des Epices apaisantes au Chef Jessen à Southshore.‡给南海镇的厨师杰森带去10块海龟肉和一些舒心草。‡給南海鎮的廚師傑森帶去10塊海龜肉和壹些舒心草。',
  }
},
[556] = {
  {
    'Fichas de pedra‡Каменные талисманы‡Steinmarken‡징표의 돌‡Muestras de piedra‡Muestras de piedra‡Les Runes gravées‡石雕‡石雕',
    nil,
    'Leve 10 Fichas de Pedra Gasta para o Guardião Bel\'varão, na Serraria Tarren.‡Отнесите 10 истертых каменных талисманов хранителю Бел\'варилу с мельницы Таррен.‡Bringt 10 abgenutzte Steinmarken zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 밀농장에 있는 관리인 벨바릴에게 닳아해진 징표의 돌 10개를 가져가야 합니다.‡Lleva 10 muestras de piedra gastada al guardián Bel’varil de Molino Tarren.‡Lleva 10 muestras de piedra desgastada al vigilante Bel’varil de Molino Tarren.‡Apporter 10 Runes gravées au Conservateur Bel\'varil à Moulin-de-Tarren.‡收集10个用旧的石雕，把它们带给塔伦米尔的看守者贝尔杜加。‡收集10個用舊的石雕，把它們帶給塔倫米爾的看守者貝爾杜加。',
  }
},
[557] = {
  {
    'Braçadeiras da vinculação‡Сковывающие браслеты‡Armschienen der Bindung‡결속의 팔보호구‡Brazales de vínculo‡Brazales de vínculo‡Les Bracelets de liaison‡地缚护腕‡地縛護腕',
    nil,
    'Leve 4 Braçadeiras do Vínculo à Terra para o Guardião Bel\'varão, na Serraria Tarren.‡Принесите 4 браслета Земли хранителю Бел\'варилу с мельницы Таррен.‡Bringt 4 Armschienen der Erdbindung zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 밀농장에 있는 관리인 벨바릴에게 대지 결속의 팔보호구 4개를 가져가야 합니다.‡Lleva 4 brazales de vínculo con la Tierra al guardián Bel’varil de Molino Tarren.‡Lleva 4 brazales de vínculo de Tierra al vigilante Bel’varil de Molino Tarren.‡Apporter 4 Brassards de liaison de terre au Conservateur Bel\'varil à Moulin-de-Tarren.‡为塔伦米尔的看守者贝瓦里尔收集4个地缚护腕。‡為塔倫米爾的看守者貝瓦裏爾收集4個地縛護腕。',
  }
},
[558] = {
  {
    'Autógrafo da Jaina‡Автограф Джайны‡Jainas Autogramm‡제이나의 사인‡El autógrafo de Jaina‡El autógrafo de Jaina‡L\'autographe de Jaina‡吉安娜的签名‡珍娜的簽名',
    nil,
    'Vá a Theramore para tentar conseguir o autógrafo da Grã-senhora Jaina Proudmore para o seu protegido.‡Отправляйтесь в Терамор и постарайтесь получить автограф Джайны Праудмур для своего подопечного.‡Reist nach Theramore und versucht für Euren Schützling ein Autogramm von Lady Jaina Proudmoore zu ergattern.‡돌보고 있는 고아를 위해 테라모어로 가서 여군주 제이나 프라우드모어의 사인을 받아야 합니다.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Allez à Theramore pour tenter d\'obtenir un autographe de dame Jaina Portvaillant pour votre protégé.‡到塞拉摩去，为你看护的孩子拿到一份吉安娜·普罗德摩尔的亲笔签名。‡',
  }
},
[559] = {
  {
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Colete 10 Cabeças de Murloc dos murlocs da Praia Ocidental para o Tenente Fárrio Orinelle, que está na Costa Sul.‡Соберите 10 голов мурлоков на Западном побережье по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Sammelt 10 Murlocköpfe von den Murlocs am Weststrand für Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬에게 서부 해안에서 멀록을 처치하고 멀록 머리 10개를 모아야 합니다.‡Recoge 10 cabezas de murloc en la Playa del Oeste por orden del general Farren Orinelle de Costasur.‡Recoge 10 cabezas de múrloc en la Playa del Oeste por orden del teniente Farren Orinelle de Costasur.‡Collecter 10 Têtes de murlocs sur les murlocs du Rivage occidental pour le lieutenant Farren Orinelle à Southshore.‡南海镇的法尔林·奥里涅尔中尉要你从西部海岸的鱼人身上收集10颗鱼人的头颅。‡南海鎮的法爾林·奧裏涅爾中尉要妳從西部海岸的魚人身上收集10顆魚人的頭顱。',
  }
},
[560] = {
  {
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Entregue o Saco com Cabeças de Murloc ao Delegado Trilharrubra na Costa Sul.‡Отнесите мешок с головами мурлоков маршалу Крассену в Южнобережье.‡Bringt den Sack mit den Murlocköpfen zu Marshal Redpath nach Southshore.‡사우스쇼어에 있는 치안대장 레드패스에게 멀록 머리가 든 자루를 전달해야 합니다.‡Entrega las cabezas de murloc al mariscal Rutagrana de Costasur.‡Entrega las cabezas de múrloc al alguacil Rutagrana de Costasur.‡Livrer le Sac de têtes de murlocs au maréchal Redpath à Southshore.‡把一袋鱼人的头颅交给南海镇的治安官雷德帕斯。‡把壹袋魚人的頭顱交給南海鎮的治安官雷德帕斯。',
  }
},
[561] = {
  {
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Fale com o Tenente Fárrio Orinelle na Costa Sul.‡Поговорите с лейтенантом Фарреном Оринелем из Южнобережья.‡Sprecht mit Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬과 대화해야 합니다.‡Habla con el general Farren Orinelle en Costasur.‡Habla con el teniente Farren Orinelle en Costasur.‡Parler au Lieutenant Farren Orinelle à Southshore.‡和南海镇的法尔林·奥里涅尔中尉谈一谈。‡和南海鎮的法爾林·奧裏涅爾中尉談壹談。',
  }
},
[562] = {
  {
    'Ventobravo, avante!‡Ха, Штормград!‡Stormwind Ho!‡아, 스톰윈드!‡Cambio de destino‡Cambio de destino‡Stormwind me voilà‡升官之道‡升官之道',
    nil,
    'Mate 10 Caça-costas Espinhadaga e 10 Sirenas Espinhadaga para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 береговых охотников и 10 сирен из клана Пронзающего Гребня по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Küstenjäger der Säbelflossen und 10 Sirenen der Säbelflossen für Lieutenant Farren Orinelle in Southshore.‡사우스쇼어에 있는 부관 파렌 오리넬을 위해 비수가시일족 바다사냥꾼 10마리와 비수가시일족 세이렌 10마리를 처치해야 합니다.‡Mata a 10 cazacostas y 10 sirenas Dagaespinazo por orden del general Farren Orinelle de Costasur.‡Mata a 10 cazacostas y 10 sirenas Espinadaga por orden del teniente Farren Orinelle de Costasur.‡Tuer 10 Chasseurs du Rivage et 10 Sirènes Daguéchine pour le lieutenant Farren à Southshore.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个刺脊滩行者和10个刺脊海妖。‡南海鎮的法爾林·奧裏涅爾中尉要妳去殺掉10個刺脊灘行者和10個刺脊海妖。',
  }
},
[563] = {
  {
    'Transferência‡Новое назначение‡Versetzungen‡전출‡Nueva asignación‡Nueva asignación‡Nouvelle affectation‡人事调动‡人事調動',
    nil,
    'Entregue o Relatório de Fárrio para o Major Samuelson na Bastilha Ventobravo.‡Отнесите донесение Фаррена майору Самуэльсону в Крепость Штормграда.‡Bringt Farrens Bericht zu Major Samuelson in die Burg Stormwind.‡스톰윈드 왕궁에 있는 상사 사무엘슨에게 파렌의 보고서를 전달해야 합니다.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Remettre le Rapport de Farren au major Samuelson au Donjon de Stormwind.‡把法尔林的报告交给暴风要塞里的萨缪尔森少校。‡把法爾林的報告交給暴風要塞裏的薩繆爾森少校。',
  }
},
[564] = {
  {
    'Ameaça cara‡Серьезная угроза‡Teure Bedrohung‡크나큰 위협‡Una amenaza costosa‡Una amenaza costosa‡Un problème très coûteux‡损失惨重‡損失慘重',
    nil,
    'Dario Malavista, da Costa Sul, quer que você mate 8 Leões da Montanha e 10 Leões da Montanha Imponentes.‡Убейте 8 горных львов и 10 крупных горных львов по поручению Даррена Малвея из Южнобережья.‡Darren Malvew aus Southshore will, dass Ihr 8 Berglöwen und 10 titanische Berglöwen tötet.‡사우스쇼어의 다렌 말뷰가 산사자 8마리와 덩치큰 산사자 10마리를 처치해 달라고 부탁했습니다.‡Darren Malvew de Costasur quiere que mates 8 pumas y 10 pumas gigantes.‡Darren Malavista de Costasur quiere que mates 8 leones de montaña y 10 leones de montaña descomunales.‡Darren Malvew de Southshore veut que vous tuiez 8 Lions des montagnes et 10 Lions des montagnes massifs.‡南海镇的达伦·玛尔维要你杀掉8只山地狮和10只巨型山地狮。‡南海鎮的達倫·瑪爾維要妳殺掉8只山地獅和10只巨型山地獅。',
  }
},
[565] = {
  {
    'Manto de Pele de Yeti do Bartolo‡Плащ из меха йети‡Bartolos Yetifellumhang‡바르톨로의 설인 모피 망토‡Capa de piel de yeti de Bartolo‡Capa de piel de yeti de Bartolo‡La cape en fourrure de yéti de Bartolo‡巴图罗的雪人毛皮披风‡巴圖羅的雪人毛皮披風',
    nil,
    'Leve um Rolo de Lã, um Manto do Montanhista, Fio Delicado e 10 chumaços de Pele de Yeti para Bartolo Ginsetti na Costa Sul.‡Принесите Бартоло Джинсетти из Южнобережья рулон шерсти, плащ жителя холмов, тонкую нить и 10 клоков меха йети.‡Bringt Bartolo Ginsetti in Southshore einen Wollstoffballen, einen Umhang des Hügelwächters, feinen Faden und 10 Haufen Yetifell.‡사우스쇼어에 있는 바르톨로 진세티에게 양모 두루마리 1개, 산악인의 망토, 가는 실타래, 그리고 설인 모피 10개를 가져가야 합니다.‡LLeva una bala de lana, una capa de montañero, hilo de alta calidad y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Lleva una madeja de lana, una capa de montañero, hilo refinado y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Apporter à Bartolo Ginsetti de Southshore une Pelote de laine, une Cape d\'homme des collines, du Fil fin et 10 Touffes de fourrure de yéti.‡给南海镇的巴图罗·吉塞提找一个毛布卷、一件山地披风、一股细线和10块雪人的毛皮。‡給南海鎮的巴圖羅·吉塞提找壹個毛布卷、壹件山地披風、壹股細線和10塊雪人的毛皮。',
  }
},
[566] = {
  {
    'PROCURA-SE: Barão Vardus‡РАЗЫСКИВАЕТСЯ: Барон Вардус‡GESUCHT: Baron Vardus‡바르두스 남작 현상수배‡SE BUSCA: Barón Vardus‡SE BUSCA: Barón Vardus‡ON RECHERCHE : baron Vardus‡通缉：瓦杜斯男爵‡通緝：瓦杜斯男爵',
    nil,
    'Mate o Barão Vardus e entregue a cabeça dele para a Alta-executora Darthalia na Serraria Tarren.‡Убейте барона Вардуса и принесите его голову верховному палачу Дарталии на мельницу Таррен.‡Tötet Baron Vardus und bringt seinen Kopf zu Hochexekutorin Darthalia in Tarrens Mühle.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 타렌 밀농장에 있는 고위집행관 다살리아에게 가져가야 합니다.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Tuer le baron Vardus et apporter sa tête à la Grande Exécutrice Darthalia, au Moulin-de-Tarren.‡杀了瓦杜斯男爵，把他的头带给塔伦米尔的高级执行官达萨利亚。‡殺了瓦杜斯男爵，把他的頭帶給塔倫米爾的高級執行官達薩利亞。',
  }
},
[567] = {
  {
    'Perigo!‡Вооружены и очень опасны!‡Gefährlich!‡위험 인물 수배!‡¡Atención!‡¡Atención!‡Dangereux !‡危险！‡危險！',
    nil,
    'A Alta-executora Darthalia da Serraria Tarren está oferecendo uma recompensa pelas cabeças de Tabelião Horácio Brancorcel, Cidadão Urbano, Minerador Talhatudo e a Fazendeira Kalaba.‡Верховный палач Дарталия с мельницы Таррен назначила награду за убийство клерка Горация Белоконя, гражданина Уилкса, шахтера Хакетта и фермерши Калабы.‡Hochexekutorin Darthalia in Tarrens Mühle hat ein Kopfgeld auf Amtmann Horrace Whitesteed, Bürger Wilkes, Minenarbeiter Hackett und Bäuerin Kalaba ausgesetzt.‡타렌 밀농장의 고위집행관 다살리아가 서기관 호레이스 화이트스티드, 민간인 윌키스, 광부 하켓, 농부 칼라바에 현상금을 걸었습니다.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el secretario Horrace Corzalbal, el ciudadano Wilkes, el minero Hackett y el granjero Kalaba.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el funcionario Horraceio Corzalbal, el ciudadano Wilkes, el minero Hackett y la granjera Kalaba.‡La Grande Exécutrice Darthalia de Moulin-de-Tarren offre une prime pour la mort du Commis Horrace Whitesteed, du Citoyen Wilkes, du Mineur Hackett et de Kalaba la fermière.‡塔伦米尔的高级执行官达萨利亚悬赏通缉书记员赫拉斯·怀特斯蒂德、平民维尔克斯、矿工哈克特和农夫卡拉巴。‡塔倫米爾的高級執行官達薩利亞懸賞通緝書記員赫拉斯·懷特斯蒂德、平民維爾克斯、礦工哈克特和農夫卡拉巴。',
  }
},
[568] = {
  {
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 15 Raptores Batecauda.‡Командир Агро\'гош из лагеря Гром\'гол поручил вам убить 15 ящеров-кнутохвостов.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 15 Schmetterschwanzraptoren tötet.‡그롬골 주둔지의 사령관 아그로고쉬가 채찍꼬리랩터 15마리를 처치해 달라고 부탁했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 15 Raptors flagellants.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死15只鞭尾迅猛龙。‡格羅姆高營地的指揮官阿格羅戈什要求妳殺死15只鞭尾迅猛龍。',
  }
},
[569] = {
  {
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 10 Brutamontes Ogros e 5 Mandingueiros Ogros.‡Командир Агро\'гош из лагеря Гром\'гол поручил вам убить 10 огров-громил и 5 огров-знахарей.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 10 Ogerschläger und 5 Ogerhexendoktoren tötet.‡그롬골 주둔지에 있는 사령관 아그로고쉬가 모쉬오그일족 투사 10명과 모쉬오그일족 의술사 5명을 처치해 달라고 부탁했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 10 Brutes et 5 Sorciers ogres.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死10个食人魔蛮兵和5个食人魔巫医。‡格羅姆高營地的指揮官阿格羅戈什要求妳殺死10個食人魔蠻兵和5個食人魔巫醫。',
  }
},
[570] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin do Acampamento Grom\'gol quer 8 Garras de Umbragorja e uma Presa Imaculada de Tigresa.‡Провозвестник Мок\'тардин из лагеря Гром\'гол попросил вас принести ему 8 когтей тенебрюхих пантер и безупречный тигриный клык.‡Scharfseher Mok\'thardin im Basislager von Grom\'gol will 8 Schattentatzenkrallen und einen makellosen Tigerinnenfangzahn.‡그롬골 기지에 있는 예언자 모크타르딘이 그림자퓨마 발톱 8개와 온전한 암호랑이의 송곳니를 가져다 달라고 부탁했습니다.‡El vidente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombrías y un colmillo de tigresa inmaculado.‡El clarividente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombría y un colmillo de tigresa prístino.‡Le prophète Mok\'thardin du campement Grom\'gol veut que vous trouviez 8 Griffes de panthère Ombregueule et 1 Croc de tigresse en parfait état.‡格罗姆高营地的先知摩克萨尔丁要求你给他带回8只深喉猎豹的爪子和一颗雌虎的牙齿。‡格羅姆高營地的先知摩克薩爾丁要求妳給他帶回8只深喉獵豹的爪子和壹顆雌虎的牙齒。',
  }
},
[571] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve um Tendão de Gorila Velho para o Clarividente Mok\'thardin em Grom\'gol.‡Принесите сухожилие старой гориллы провозвестнику Мок\'тардину в лагерь Гром\'гола.‡Bringt die Sehne eines alten Gorillas zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골에 있는 예언자 모크타르딘에게 덩치큰 고릴라의 힘줄을 가져가야 합니다.‡Lleva un tendón de gorila maduro al vidente Mok\'thardin en Grom\'gol.‡Lleva un tendón de gorila mayor al clarividente Mok\'thardin en Grom\'gol.‡Apporter un Tendon d\'Ancien gorille de Valbrume au Prophète Mok\'thardin à Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回1根成年大猩猩的肌腱。‡給格羅姆高營地的先知摩克薩爾丁帶回1根成年大猩猩的肌腱。',
  }
},
[572] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve 10 Penas de Espreitador da Selva para o Clarividente Mok\'thardin no Acampamento Grom\'gol.‡Принесите 10 перьев тропических ловцов провозвестнику Мок\'тардину в лагерь Гром\'гол.‡Bringt 10 Dschungelpirscherfedern zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골 주둔지에 있는 예언자 모크타르딘에게 줄무늬정글랩터 깃털 10개를 가져가야 합니다.‡Lleva 10 plumas de acechadores de la jungla al vidente Mok\'thardin en el Campamento Grom\'gol.‡Lleva 10 plumas de acechadores de la selva al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Amener 10 Plumes de Traqueurs de la jungle au Prophète Mok\'thardin au campement Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回10根丛林捕猎者的羽毛。‡給格羅姆高營地的先知摩克薩爾丁帶回10根叢林捕獵者的羽毛。',
  }
},
[573] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin de Grom\'gol precisa de Água da Fonte Abençoada. Ele também quer que você mate 10 Exploradores Nagas.‡Провозвестник Мок\'тардин из лагеря Гром\'гол попросил вас принести ему воду Святого источника. Кроме того, он поручил вам убить 10 наг-исследователей.‡Scharfseher Mok\'thardin von Grom\'gol benötigt Wasser der Heiligen Quelle. Er will auch, dass Ihr 10 Forscher der Naga tötet.‡그롬골에 있는 예언자 모크타르딘에게 신성한 샘물을 가져가야 하며 나가 탐험가 10명을 처치해야 합니다.‡El vidente Mok\'thardin de Grom\'gol necesita agua sagrada de manantial. También quiere que mates 10 exploradores naga.‡El clarividente Mok\'thardin de Grom\'gol necesita agua de manantial sagrado. También quiere que mates 10 expedicionarios naga.‡Le Prophète Mok\'thardin de Grom\'gol a besoin d\'Eau de source sacrée. Il veut que vous tuiez aussi 10 Explorateurs nagas.‡格罗姆高营地的先知摩克萨尔丁要你去取回一瓶圣泉之水，同时还要求你杀死10名纳迦探险者。‡格羅姆高營地的先知摩克薩爾丁要妳去取回壹瓶聖泉之水，同時還要求妳殺死10名納迦探險者。',
  }
},
[574] = {
  {
    'Forças especiais‡Особые войска‡Spezialtruppe‡특수 부대‡Fuerzas especiales‡Fuerzas especiales‡Forces spéciales‡特种部队‡特種部隊',
    nil,
    'Mate 10 Tropas de Choque de Kurzen e 6 Encolhedores de Cabeças de Kurzen.|nFale com o Tenente Doren no Acampamento dos Rebeldes.‡Убейте 10 диверсантов и 6 охотников за головами Курцена.|nДоложите об этом лейтенанту Дорену в Лагере повстанцев.‡Tötet 10 von Kurzens Kommandosoldaten und 6 von Kurzens Kopfschrumpfer.|nErstattet Bericht bei Lieutenant Doren im Rebellenlager.‡쿠르젠 특전사 10명과 쿠르젠 심리학자 6명을 처치해야 합니다.|n반란군 야영지에 있는 부관 도렌에게 보고하십시오.‡Mata 10 comandos Kurzen y 6 reductores de cabezas Kurzen.|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Mata 10 comandos de Kurzen y 6 reductores de cabezas de Kurzen.|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Tuer 10 Commandos et 6 Réducteurs de têtes de Kurzen. Rendre compte au Lieutenant Doren au Camp rebelle.‡杀掉10名库尔森特种兵和6名库尔森精神医师。|n然后向反抗军营地的多伦上尉复命。‡殺掉10名庫爾森特種兵和6名庫爾森精神醫師。|n然後向反抗軍營地的多倫上尉復命。',
  }
},
[575] = {
  {
    'Oferta e demanda‡Спрос и предложение‡Angebot und Nachfrage‡민물 악어 가죽‡La oferta y la demanda‡La oferta y la demanda‡L\'offre et la demande‡供与求‡供與求',
    nil,
    'Leve 2 Peles de Crocolisco Grande do Rio para o Drizzlik na Angra do Butim.‡Принесите 2 шкуры большого речного кроколиска Дриззлику из Пиратской бухты.‡Bringt 2 große Flusskrokiliskenhäute zu Drizzlik nach Booty Bay.‡무법항에 있는 드리즐릭에게 민물 악어 가죽 2개를 가져가야 합니다.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Bahía del Botín.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Bahía del Botín.‡Apporter 2 Grandes peaux de crocilisque des rivières à Drizzlik, à Baie-du-Butin.‡收集2张淡水鳄的皮，把它们交给藏宝海湾的崔斯里克。‡收集2張淡水鱷的皮，把它們交給藏寶海灣的崔斯裏克。',
  }
},
[576] = {
  {
    'Fique de olho‡Смотри в оба‡Ein Auge offen halten‡잃어버린 눈‡¡Ojo!‡¡Ojo!‡Gardez un œil dehors‡海盗的眼睛‡海盜的眼睛',
    nil,
    'Dizzy Caolho da Angra do Butim quer que você recupere seu olho com os Bucaneiros da Vela Sangrenta.‡Диззи Одноглазый из Пиратской бухты попросил вас отобрать его глаз у пиратов Кровавого Паруса.‡Dizzy One-Eye in Booty Bay möchte, dass Ihr sein Auge von den Blutsegelbukanieren zurückholt.‡무법항에 있는 애꾸눈 디지가 붉은해적단에게서 그의 눈을 찾아달라고 부탁했습니다.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los bucaneros Velasangre.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los Bucaneros Velasangre.‡Dizzy le Borgne de Baie-du-Butin veut que vous récupériez son œil chez les boucaniers de la Voile sanglante.‡藏宝海湾的独眼迪兹要求你从血帆海盗那里找回他的眼睛。‡藏寶海灣的獨眼迪茲要求妳從血帆海盜那裏找回他的眼睛。',
  }
},
[577] = {
  {
    'Algumas partes faltando‡Добыча шкур‡Etwas Zusammenbau benötigt‡무쇠턱 악어 가죽‡Hay que ensamblar‡Hay que ensamblar‡Un peu d\'assemblage est nécessaire‡收集鳄鱼皮‡收集鱷魚皮',
    nil,
    'Leve 5 Peles de Crocolisco Arapuca para Drizzlik na Angra do Butim.‡Отнесите 5 шкур кроколисков-хрустогрызов Дриззлику в Пиратскую бухту.‡Bringt 5 Schnappkieferkrokiliskenhäute zu Drizzlik nach Booty Bay.‡무법항에 있는 드리즐릭에게 무쇠턱 악어 가죽 5개를 가져가야 합니다.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Apporter 5 Peaux de Gueule d\'acier à Drizzlik, à Baie-du-Butin.‡给藏宝海湾的崔斯里克带回5张钳嘴鳄鱼的皮。‡給藏寶海灣的崔斯裏克帶回5張鉗嘴鱷魚的皮。',
  }
},
[578] = {
  {
    'A Pedra das Marés‡Камень приливов‡Der Stein der Gezeiten‡해일의 돌‡La piedra de las mareas‡La piedra de las mareas‡La Pierre des marées‡海潮之石‡海潮之石',
    nil,
    'Encontre a ilha assombrada para o Barão Rezingada na Angra do Butim.‡По поручению барона Ревилгаза из Пиратской бухты найдите остров, населенный духами Воды.‡Findet die Spukinsel für Baron Revilgaz in Booty Bay.‡무법항에 있는 남작 레빌가즈를 위해 유령의 섬을 찾아야 합니다.‡Encuentra la isla encantada para el Barón Revilgaz en la Bahía del Botín.‡Encuentra la isla encantada para el Barón Revilgaz en la Bahía del Botín.‡Localiser l\'Ile hantée pour le baron Revilgaz de Baie-du-Butin.‡为藏宝海湾的大财主里维加兹找到闹鬼的岛屿。‡為藏寶海灣的大財主裏維加茲找到鬧鬼的島嶼。',
  }
},
[579] = {
  {
    'A Biblioteca de Ventobravo‡Библиотека Штормграда‡Bibliothek von Stormwind‡스톰윈드 도서관‡La biblioteca de Ventormenta‡La biblioteca de Ventormenta‡La Bibliothèque de Stormwind‡暴风城图书馆‡暴風城圖書館',
    nil,
    nil,
  }
},
[580] = {
  {
    'O grogue perdido do Aldo Isque‡Потерянный грог Алкача Виски‡Whiskey Slim\'s verlorener Grog‡위스키 슬림의 잃어버린 술병‡El grog de Whiskey Slim‡El grog de Whiskey el Delgado‡La bibine perdue de Whiskey Slim‡威士忌斯利姆的酒‡威士忌斯利姆的酒',
    nil,
    'Aldo Isque, na Angra do Butim, quer que você leve para ele as garrafas de Xerez de Pupellyverbos que ele perdeu.‡Алкач Виски из Пиратской бухты попросил вас принести ему потерянные бутылки портвейна "Пупелливербос".‡Whiskey Slim in Booty Bay möchte, dass Ihr ihm die Flaschen Pupellyverbos-Portwein bringt, die er verloren hat.‡무법항에 있는 위스키 슬림이 잃어버린 퍼플리버보스 포트 와인을 찾아 달라고 부탁했습니다.‡Whiskey Delgado, en la Bahía del Botín, quiere que le lleves las botellas de oporto Pupellyverbos que perdió.‡Whiskey el Delgado, en la Bahía del Botín, quiere que le lleves las botellas de oporto Pupellyverbos que perdió.‡Whiskey Slim de Baie-du-Butin veut que vous lui rameniez les bouteilles de porto Pupellyverbos qu\'il a perdues.‡藏宝海湾的威士忌斯利姆想要你帮他找回弄丢的紫葡萄酒。‡藏寶海灣的威士忌斯利姆想要妳幫他找回弄丟的紫葡萄酒。',
  }
},
[581] = {
  {
    'A caçada ao Yennikan‡Поиски Йеннику‡Die Suche nach Yenniku‡예니쿠 수색‡Caza para Yenniku‡Caza para Yenniku‡La chasse pour Yenniku‡耶尼库的下落‡耶尼庫的下落',
    nil,
    'Leve 9 Presas de Sanguescalpo para Nimboya no Acampamento Grom\'gol.‡Принесите 9 клыков тролля из клана Кровавого Скальпа Нимбойе в лагерь Гром\'гол.‡Bringt 9 Hauer der Bloodscalp zu Nimboya in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 님보야에게 붉은머리부족의 어금니 9개를 가져가야 합니다.‡Lleva 9 colmillos Sangrapellejo a Nimboya en el Campamento Grom\'gol.‡Lleva 9 colmillos Sangrapellejo a Nimboya en el Campamento Grom\'gol.‡Amener 9 Défenses de Bloodscalp à Nimboya au campement Grom\'gol.‡给格罗姆高营地的尼姆布亚带回9根血顶巨魔的獠牙。‡給格羅姆高營地的尼姆布亞帶回9根血頂巨魔的獠牙。',
  }
},
[582] = {
  {
    'Caçando cabeças‡Охота за головами‡Kopfjägerei‡인간사냥꾼‡Caza cabezas‡Caza cabezas‡La chasse aux têtes‡猎头行动‡獵頭行動',
    nil,
    'Leve 20 Cabeças Encolhidas para Nimboya, no Acampamento Grom\'gol.‡Принесите Нимбойе из лагеря Гром\'гол 20 сушеных голов.‡Bringt 20 Schrumpfköpfe zu Nimboya in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 님보야에게 쭈그러든 해골 20개를 가져가야 합니다.‡Lleva 20 cabezas reducidas a Nimboya en el Campamento Grom\'gol.‡Lleva 20 cabezas reducidas a Nimboya en el Campamento Grom\'gol.‡Apporter 20 Têtes réduites à Nimboya au campement Grom\'gol.‡给格罗姆高营地的尼姆布亚带去20个皱缩的头颅。‡給格羅姆高營地的尼姆布亞帶去20個皺縮的頭顱。',
  }
},
[583] = {
  {
    'Boas-vindas à selva‡Добро пожаловать в джунгли‡Willkommen im Dschungel‡정글 탐험‡Bienvenido a la jungla‡Bienvenido a la jungla‡Bienvenue dans la jungle‡欢迎来到丛林‡歡迎來到叢林',
    nil,
    'Fale com o Rosarães Guima.‡Поговорите с Хемингом Эрнестуэем.‡Sprecht mit Hemet Nesingwary.‡헤멧 네싱워리와 대화해야 합니다.‡Habla con Hemet Nesingwary.‡Habla con Hemet Nesingwary.‡Parler à Hemet Nesingwary.‡与赫米特·奈辛瓦里谈一谈。‡與赫米特·奈辛瓦裏談壹談。',
  }
},
[584] = {
  {
    'Cabeças do Clã Sanguescalpo‡Головы племени Кровавого Скальпа‡Köpfe des Bloodscalpklans‡붉은머리부족의 머리카락‡Las cabezas de los Sangrapellejo‡Las cabezas de los Sangrapellejo‡Les têtes du clan Bloodscalp‡血顶之颅‡血頂之顱',
    nil,
    'Leve a Cabeça de Gan\'zulah e a Cabeça de Nezzliok para o caldeirão borbulhante no Acampamento Grom\'gol.‡Принесите головы Ган\'зулаха и Неззилока и положите их в бурлящий котел в лагере Гром\'гол.‡Bringt Gan\'zulahs Kopf und Nezzlioks Kopf zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥에 간줄라와 네즐뤼크의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Apporter la Tête de Gan\'zulah et la Tête de Nezzliok dans le Chaudron bouillonnant au campement Grom\'gol.‡将甘祖拉恩的头颅和奈兹里奥克的头颅带回格罗姆高营地，放入冒泡的大锅中。‡將甘祖拉恩的頭顱和奈茲裏奧克的頭顱帶回格羅姆高營地，放入冒泡的大鍋中。',
  }
},
[585] = {
  {
    'Falando com Nezzliok‡Разговор с Неззилоком‡Mit Nezzliok sprechen‡네즐뤼크와의 대화‡Hablando con Nezzliok‡Hablando con Nezzliok‡En parlant avec Nezzliok‡奈兹里奥克‡奈茲裏奧克',
    nil,
    'Leve um Troféu de Balia\'mah, um Troféu de Ziata\'jai e um Troféu Zul\'Mamwe para o Caldeirão Borbulhante no Acampamento Grom\'gol.‡Принесите в лагерь Гром\'гол трофей из Балиа\'ма, трофей из Зиата\'джаи и трофей из Зулмамбве и положите их в бурлящий котел.‡Bringt eine Balia\'mah-Trophäe, eine Ziata\'jai-Trophäe und eine Zul\'Mamwe-Trophäe zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥으로 발리아마 전리품 해골과 지아타자이 전리품 해골, 줄맘웨 전리품 해골을 가져가야 합니다.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Apporter un Trophée de Balia\'mah, un de Ziata\'jai et un de Zul\'Mamwe dans le Chaudron bouillonnant au campement Grom\'gol.‡带回巴里亚曼战利品、赞塔加战利品和祖玛维战利品各一个，把它们放入格罗姆高营地里中的冒泡的大锅里。‡帶回巴裏亞曼戰利品、贊塔加戰利品和祖瑪維戰利品各壹個，把它們放入格羅姆高營地裏中的冒泡的大鍋裏。',
  }
},
[586] = {
  {
    'Falando com Gan\'zulah‡Разговор с Ган\'зулахом‡Mit Gan\'zulah sprechen‡간줄라와의 대화‡Hablando con Gan\'zulah‡Hablando con Gan\'zulah‡En parlant avec Gan\'zulah‡甘祖拉恩‡甘祖拉恩',
    nil,
    'Mate 8 Caçadores Rachacrânio, 6 Caçadores de Cabeças Rachacrânio e 4 Berserkers Rachacrânio.|nLeve a Armadura Quebrada de Ana\'thek para o Caldeirão Borbulhante, que fica no Acampamento Grom\'gol.‡Убейте 8 охотников, 6 охотников за головами и 4 берсерков из клана Дробителей ЧЕрепов.|nПринесите разбитую броню Анатека к бурлящему котлу в лагере Гром\'гол.‡Tötet 8 Jäger der Skullsplitter, 6 Kopfjäger der Skullsplitter und 4 Berserker der Skullsplitter.|nBringt die zerbrochene Rüstung von Ana\'thek zum blubbernden Kessel in das Basislager von Grom\'gol.‡백골가루부족 사냥꾼 8명, 백골가루부족 인간사냥꾼 6명, 그리고 백골가루부족 광전사 4명을 처치해야 합니다.|n그롬골 주둔지에 있는 끓고 있는 가마솥으로 망가진 아나텍의 갑옷을 가져가야 합니다.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|nLleva la armadura despedazada de Ana\'thek a la caldera en ebullición del Campamento Grom\'gol.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|nLleva la armadura de Ana\'thek rota a la caldera en ebullición del Campamento Grom\'gol.‡Tuer 8 Chasseurs, 6 Chasseurs de têtes, et 4 Berserkers du clan Skullsplitter.|nApporter l\'Armure brisée d\'Ana\'thek au Chaudron bouillonnant au campement Grom\'gol.‡杀死8名劈颅猎人、6名劈颅猎头者和4名劈颅狂战士。|n将安纳希克的盔甲碎片放入格罗姆高营地中的冒泡的大锅里。‡殺死8名劈顱獵人、6名劈顱獵頭者和4名劈顱狂戰士。|n將安納希克的盔甲碎片放入格羅姆高營地中的冒泡的大鍋裏。',
  }
},
[587] = {
  {
    'Levaram o rapé‡Понюшка табака‡Auf dem Schnupftabak‡코담배를 찾아서‡Tabaco rapé‡Tabaco rapé‡Faire un tabac‡鼻烟‡鼻煙',
    nil,
    'O Dígui, na Angra do Butim, quer que você leve para ele 15 trouxinhas de Rapé.‡Диг из Пиратской бухты попросил принести ему 15 понюшек табаку.‡Deeg in Booty Bay möchte, dass Ihr ihm 15 Teile Schnupftabak bringt.‡무법항에 있는 디그가 코담배 15개를 가져다 달라고 부탁했습니다.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 unidades de tabaco.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 pizcas de tabaco.‡Deeg de Baie-du-Butin veut que vous lui apportiez 15 portions de Tabac à priser.‡藏宝海湾的迪格要求你带给他15份鼻烟。‡藏寶海灣的迪格要求妳帶給他15份鼻煙。',
  }
},
[588] = {
  {
    'O destino de Yennikan‡Судьба Йеннику‡Yennikus Schicksal‡예니쿠의 생사 확인‡El destino de Yenniku‡El destino de Yenniku‡Le sort de Yenniku‡耶尼库的命运‡耶尼庫的命運',
    nil,
    'Fale com Kin\'weelay.‡Поговорите с Кин\'вилаем.‡Sprecht mit Kin\'weelay.‡킨윌레이와 대화해야 합니다.‡Habla con Kin\'weelay.‡Habla con Kin\'weelay.‡Parler à Kin\'weelay.‡与肯维雷谈一谈。‡與肯維雷談壹談。',
  }
},
[589] = {
  {
    'Os cristais cantantes‡Поющие кристаллы‡Die singenden Kristalle‡고동치는 푸른 수정‡Los cristales canto‡Los cristales canto‡Les Eclats vibrants‡歌唱水晶‡歌唱水晶',
    nil,
    'Leve 3 Estilhaços Azuis Pulsantes para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 3 пульсирующих синих осколка Кин\'вилаю в лагерь Гром\'гол.‡Bringt 3 pulsierende blaue Splitter zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 고동치는 푸른 수정 3개를 가져가야 합니다.‡Lleva 3 fragmentos azul intenso a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 3 fragmentos azul pulsante a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 3 Eclats vibrants bleus à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回3块蓝色波光碎片。‡給格羅姆高營地的肯維雷帶回3塊藍色波光碎片。',
  }
},
[590] = {
  {
    'Palavra de ladino‡Выгодная сделка‡Ein Schurkenhandel‡도적의 거래‡Un trato de pícaro‡Un trato de pícaro‡Un marché de voleur‡潜行者的交易‡潛行者的交易',
    nil,
    'Derrote Calvino Murão em Plangemortis.‡Одержите победу в схватке с Кальвином Монтеччи в Могильнике.‡Besiegt Calvin Montague in Deathknell.‡데스넬에 있는 캘빈 몬태그와 싸워서 이겨야 합니다.‡Derrota a Calvin Montague en Camposanto.‡Derrota a Calvin Montesco en Camposanto.‡Battre Calvin Montague au Glas.‡打败丧钟镇的卡尔文·蒙泰古。‡打敗喪鐘鎮的卡爾文·蒙泰古。',
  }
},
[591] = {
  {
    'O Olho da Mente‡Око Разума‡Das Gedankenauge‡마음의 눈‡El Ojo de la Mente‡El Ojo de la mente‡La Vue de l\'Esprit‡心灵之眼‡心靈之眼',
    nil,
    'Leve o Olho da Mente para Kin\'weelay, no Acampamento Grom\'gol.‡Отнесите Око Разума Кинвилаю в лагерь Гром\'гол.‡Bringt das Gedankenauge zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 마음의 눈을 가져가야 합니다.‡Lleva el Ojo de la Mente a Kin\'weelay en el Campamento Grom\'gol.‡Lleva el Ojo de la mente a Kin\'weelay en el Campamento Grom\'gol.‡Apporter la Vue de l\'Esprit à Kin\'weelay au Campement Grom\'gol.‡将心灵之眼交给格罗姆高营地里的肯维雷。‡將心靈之眼交給格羅姆高營地裏的肯維雷。',
  }
},
[592] = {
  {
    'Salvando Yennikan‡Спасение Йеннику‡Yennikus Rettung‡예니쿠 구출‡Salvar a Yenniku‡Salvar a Yenniku‡Il faut sauver Yenniku‡拯救耶尼库‡拯救耶尼庫',
    nil,
    'Leve a Joia de Alma Plena para Nimboya.‡Отнесите Нимбойе наполненный самоцвет Души.‡Bringt den gefüllten Seelenedelstein zu Nimboya.‡님보야에게 충만한 영혼의 보석을 가져가야 합니다.‡Lleva la gema de alma llena a Nimboya.‡Lleva la gema de alma llena a Nimboya.‡Apporter la Gemme d\'âme remplie à Nimboya.‡将装满的灵魂宝石交给尼姆布亚。‡將裝滿的靈魂寶石交給尼姆布亞。',
  }
},
[593] = {
  {
    'Enchendo a Gema Anímica‡Наполнение самоцвета Души‡Den Seelenedelstein füllen‡영혼의 보석 채우기‡Gema de alma‡Gema de alma‡Une âme pour la Gemme‡灵魂宝石‡靈魂寶石',
    nil,
    nil,
  }
},
[594] = {
  {
    'Mensagem na garrafa‡Послание в бутылке‡Flaschenpost‡쪽지가 든 병‡Mensaje en una botella‡Mensaje en una botella‡Message dans une bouteille‡瓶中信‡瓶中信',
    nil,
    'Encontre o autor da mensagem na garrafa.‡Отыщите автора послания в бутылке.‡Findet den Schreiber dieser Flaschenpost.‡쪽지가 든 병의 장본인을 찾아야 합니다.‡Encuentra al autor del mensaje en la botella.‡Encuentra al autor del mensaje en la botella.‡Trouver la main qui a écrit ce message lancé à la mer dans une bouteille.‡找到瓶中信的作者。‡找到瓶中信的作者。',
  }
},
[595] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Imediato Crazz quer que você cheque a enseada ao norte da Angra do Butim.‡Первый помощник Кразз попросил вас осмотреть залив на севере от Пиратской бухты.‡Erster Maat Crazz will, dass Ihr die Bucht nördlich von Booty Bay überprüft.‡일등항해사 크래즈가 무법항 북쪽의 작은 만을 조사해 달라고 부탁했습니다.‡El primer oficial Crazz quiere que eches un vistazo a la cueva norte de la Bahía del Botín.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡Le Premier Officier Crazz veut que vous contrôliez la crique au nord de Baie-du-Butin.‡大副克拉兹要求你去侦察一下藏宝海湾北边的海滩。‡大副克拉茲要求妳去偵察壹下藏寶海灣北邊的海灘。',
  }
},
[596] = {
  {
    'Colares de osso ensanguentado‡Ожерелье кровавых костей‡Blutige Knochenhalskette‡피묻은 뼈목걸이‡Collares de huesos sangrientos‡Collares de huesos sangrientos‡Les Colliers d\'os ensanglantés‡染血的白骨项链‡染血的白骨項鏈',
    nil,
    'Leve 25 Colares de Osso Ensanguentado para Kin\'weelay no Acampamento Grom\'gol.‡Принесите Кин\'вилаю 25 ожерелий Кровавых костей в лагерь Гром\'гол.‡Bringt 25 blutige Knochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 피묻은 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os ensanglantés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串染血的白骨项链。‡給格羅姆高營地的肯維雷帶回25串染血的白骨項鏈。',
  }
},
[597] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate suas descobertas ao Imediato Crazz na Angra do Butim.‡Отнесите находку первому помощнику Краззу в Пиратскую бухту.‡Berichtet dem ersten Maat Crazz in Booty Bay von Euren Funden.‡무법항에 있는 일등항해사 크래즈에게 조사 결과를 보고해야 합니다.‡Informa sobre tus descubrimientos al primer oficial Crazz en la Bahía del Botín.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Rendre compte de vos découvertes au Premier Officier Crazz à Baie-du-Butin.‡将你的发现报告给藏宝海湾的大副克拉兹。‡將妳的發現報告給藏寶海灣的大副克拉茲。',
  }
},
[598] = {
  {
    'Colar de Osso Partido‡Ожерелье расколотых костей‡Spaltknochenhalskette‡부서진 뼈목걸이‡Collares de huesos partidos‡Collar de hueso partido‡Collier d\'os brisés‡裂骨项链‡裂骨項鏈',
    nil,
    'Leve 25 Colares de Osso Partido para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 25 ожерелий Расколотых костей Кин\'вилаю в лагерь Гром\'гол.‡Bringt 25 Spaltknochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 부서진 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de huesos partidos a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de hueso partidos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os brisés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串裂骨项链。‡給格羅姆高營地的肯維雷帶回25串裂骨項鏈。',
  }
},
[599] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate ao Mestre de Frota Chifre do Mar o ataque planejado pelos Vela Sangrenta.‡Сообщите о запланированном нападении Кровавого Паруса командиру флота Морскому Рогу.‡Erstattet Flottenmeister Seehorn Bericht über den geplanten Angriff der Blutsegelbukaniere.‡함장 시혼에게 붉은해적단의 공격 계획을 보고해야 합니다.‡Informa del ataque planeado de los Velasangre al maestro de flota Cuernomarino.‡Informa del ataque planeado de los Velasangre al maestro de flota Cuernomarino.‡Rendre compte de l\'attaque que prépare la Voile sanglante à l\'amiral Seahorn.‡把血帆海盗的计划报告给舰队指挥官卡拉·海角。‡把血帆海盜的計劃報告給艦隊指揮官卡拉·海角。',
  }
},
[600] = {
  {
    'Mineração da Empreendimentos S.A.‡Рудник Торговой Компании‡Venture Company-Bergbau‡투자개발회사 채광‡La minería de Ventura y Cía.‡La minería de Ventura y Cía.‡La mauvaise mine de la KapitalRisk‡风险投资公司‡風險投資公司',
    nil,
    'Leve 10 Cristais Azuis Canoros para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской бухты 10 синих Поющих кристаллов.‡Bringt 10 singende blaue Kristalle zu Crank Fizzlebub nach Booty Bay.‡무법항에 있는 크랭크 피즐버브에게 노래하는 파란 수정 10개를 가져가야 합니다.‡Lleva 10 cristales canto azules a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 10 cristales canto azules a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 10 Cristaux bleus chantants à Crank Fizzlebub, à Baie-du-Butin.‡给藏宝海湾的克兰克·菲兹巴布带回10块蓝色歌唱水晶。‡給藏寶海灣的克蘭克·菲茲巴布帶回10塊藍色歌唱水晶。',
  }
},
[601] = {
  {
    'Elementais da água‡Элементали воды‡Wasserelementare‡물의 정령‡Elementales de agua‡Elementales de agua‡Les élémentaires d\'eau‡水元素‡水元素',
    nil,
    'Consiga 6 Braçadeiras de Elementais da Água para o Barão Rezingada na Angra do Butim.‡Принесите барону Ревилгазу в Пиратскую бухту 6 браслетов элементалей воды.‡Holt 6 Wasserelementararmschienen für Baron Revilgaz in Booty Bay.‡무법항에 있는 남작 레빌가즈를 위해 물의정령 족쇄 6개를 가져와야 합니다.‡Consigue 6 brazales de elementales de agua para el Barón Revilgaz en la Bahía del Botín.‡Consigue 6 brazales de elementales de agua para el Barón Revilgaz en la Bahía del Botín.‡Acquérir 6 Bracelets d\'élémentaires d\'eau pour le baron Revilgaz à Baie-du-Butin.‡为藏宝海湾的大财主里维加兹收集6个水元素护腕。‡為藏寶海灣的大財主裏維加茲收集6個水元素護腕。',
  }
},
[602] = {
  {
    'Análise mágica‡Магический анализ‡Magische Analyse‡마법 분석‡Análisis mágico‡Análisis mágico‡Analyse magique‡魔法分析‡魔法分析',
    nil,
    'Leve as braçadeiras de elementais da água ao Arquimago Ansirem Tecerrunas em Dalaran.‡Отнесите браслеты элементалей воды верховному магу Ансарему Руноплету в Даларан.‡Bringt die Wasserelementararmschienen nach Dalaran zu Erzmagier Ansirem Runeweaver.‡달라란에 있는 마법사에게 물의정령 족쇄가 든 가방을 가져가야 합니다.‡Lleva los brazales de elementales de agua al archimago Ansirem Tejepista en Dalaran.‡Llévale los brazales de elemental de agua al archimago Ansirem Tejerruna en Dalaran.‡Apporter les Bracelets d’élémentaire d\'eau à l\'archimage Ansirem Runeweaver à Dalaran.‡将水元素护腕交给达拉然的大法师安斯雷姆·鲁因维沃尔。‡將水元素護腕交給達拉然的大法師安斯雷姆·魯因維沃爾。',
  }
},
[603] = {
  {
    'Chave de Ansirem‡Ключ Ансарема‡Ansirems Schlüssel‡앤자이럼의 열쇠‡Llave de Ansirem‡Llave de Ansirem‡La Clé d\'Ansirem‡安斯雷姆的钥匙‡安斯雷姆的鑰匙',
    nil,
    'Fale com Fátia na Angra do Butim.‡Поговорите с Кателиной в Пиратской бухте.‡Sprecht mit Catelyn in Booty Bay.‡무법항에 있는 케이틀린과 대화해야 합니다.‡Habla con Catelyn en la Bahía del Botín.‡Habla con Catelyn en la Bahía del Botín.‡Parler à Catelyn à Baie-du-Butin.‡与藏宝海湾的凯特琳谈一谈。‡與藏寶海灣的凱特琳談壹談。',
  }
},
[604] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Mestre de Frota Chifre do Mar na Angra do Butim quer que você mate 10 Espadachins da Vela Sangrenta e traga de volta as Cartas de Navegação da Vela Sangrenta e as Ordens da Vela Sangrenta.‡Командир флота Морской Рог попросил вас убить 10 висельников из шайки Кровавого Паруса и принести ему карты и приказы Кровавого Паруса.‡Flottenmeister Seehorn in Booty Bay will, dass Ihr 10 Schwadroneure der Blutsegelbukaniere tötet und die Blutsegelkarten sowie die Blutsegelbefehle zurückbringt.‡무법항에 있는 함장 시혼이 붉은해적단 칼잡이 10명을 처치하고 붉은해적단의 해도와 붉은해적단의 명령서를 가지고 와 달라고 부탁했습니다.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates 10 aventureros Velasangre y le lleves las cartas de navegación y las órdenes Velasangre.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates 10 espadachines Velasangre y le lleves las cartas de navegación y las órdenes de los Velasangre.‡L\'amiral Seahorn à Baie-du-Butin veut que vous tuiez 10 Bretteurs de la Voile sanglante et que vous rapportiez les Cartes de la Voile sanglante et les Ordres de la Voile sanglante.‡藏宝海岸的舰队指挥官卡拉·海角要求你杀死10名血帆流氓并将血帆海图和血帆计划书带回去。‡藏寶海岸的艦隊指揮官卡拉·海角要求妳殺死10名血帆流氓並將血帆海圖和血帆計劃書帶回去。',
  }
},
[605] = {
  {
    'Estilhaços azuis cantantes‡Осколки Поющих кристаллов‡Singende blaue Splitter‡노래하는 수정 조각‡Fragmentos de cristales canto azules‡Fragmentos de cristales canto azules‡Les éclats bleus chantants‡歌唱水晶碎片‡歌唱水晶碎片',
    nil,
    'Leve 10 Estilhaços de Cristal Cantante para Cranque Mirrabolha.‡Принесите Шиззи Пуззыриксу 10 осколков Поющих кристаллов.‡Bringt 10 singende Kristallsplitter zu Crank Fizzlebub.‡크랭크 피즐버브에게 노래하는 수정 조각 10개를 가져가야 합니다.‡Lleva 10 fragmentos de cristales canto a Loquillo Pinchabujas.‡Lleva 10 fragmentos de cristales canto a Loquillo Pinchabujas.‡Apporter 10 Eclats de cristal chantant à Crank Fizzlebub.‡为克兰克·菲兹巴布收集10块歌唱水晶碎片。‡為克蘭克·菲茲巴布收集10塊歌唱水晶碎片。',
  }
},
[606] = {
  {
    'Fazendo o Sacode tremer‡Напугать трусишку‡Zitterhand Angst einjagen‡겁쟁이‡Asusta a Trémulo‡Asusta al Trémulo‡Effrayer Philippe le Chancelant‡吓唬病鬼‡嚇唬病鬼',
    nil,
    'Leve 5 Miúdos de Gorila do Vale da Névoa para "Phillipe "Sacode" na Angra do Butim.‡Отнесите 5 потрохов горилл из Мглистой долины Филиппу "Трусишке" в Пиратскую Бухту.‡Bringt 5 Nebeltalinnereien zu "Zitterhand" Phillipe nach Booty Bay.‡무법항에 있는 겁쟁이 필립에게 안개계곡고릴라 내장 5개를 가져가야 합니다.‡Lleva 5 menudillos de gorila del Valle Velo de Bruma al "Trémulo" Phillipe en la Bahía del Botín.‡Lleva 5 menudillos de Velo de Bruma a Phillipe el "Trémulo" en la Bahía del Botín.‡Apporter 5 Abats de Valbrume à Phillippe le Chancelant à Baie-du-Butin.‡给藏宝海湾的“病鬼”菲利普带回5块迷雾谷猩猩的内脏。‡給藏寶海灣的“病鬼”菲利普帶回5塊迷霧谷猩猩的內臟。',
  }
},
[607] = {
  {
    'Fale novamente com MacKinley‡Возвращение к МакКинли‡Rückkehr zu MacKinley‡맥킨리에게 돌아가기‡Vuelve con MacKinley‡Regresa junto a MacKinley‡De retour chez MacKinley‡向马克基雷回报‡向馬克基雷回報',
    nil,
    'Leve o Pagamento do Sacode para MacKinley "Lobo do Mar"‡Отнесите плату Трусишки "Морскому волку" Маккинли‡Bringt Zitterhands Bezahlung zu "Seewolf" MacKinley.‡\'바다늑대\' 맥킨리에게 겁쟁이 필립의 빚진 돈을 가져가야 합니다.‡"Lleva el pago de Trémulo a "Lobo de Mar" MacKinley".‡Lleva el pago del Trémulo a MacKinley "Lobo de Mar".‡Apporter le Paiement de Philippe le Chancelant à MacKinley "Loup des mers".‡将菲利浦的还款交给“海狼”马克基雷。‡將菲利浦的還款交給“海狼”馬克基雷。',
  }
},
[608] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Mestre de Frota Chifre do Mar em Angra do Butim quer que você mate o Capitão Tranquiláguas, o Capitão Querena e o Mestre de Frota Firalião.‡Командир флота Морской Рог попросил вас убить капитана Штиллеца, капитана Кильвателя и командира флота Фираллона.‡Flottenmeister Seehorn in Booty Bay will, dass Ihr Kapitän Stillwasser, Käpt\'n Kielhol und Flottenmeister Firallon tötet.‡무법항에 있는 함장 시혼이 선장 스틸워터, 선장 킬하울과 함장 피랠론을 암살해 달라고 부탁했습니다.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates al capitán Aguasmansas, al capitán Sinquilla y al maestro de flota Firallon.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates al capitán Aguasmansas, al capitán Sinquilla y al maestro de flota Firallon.‡L\'amiral Seahorn de Baie-du-Butin veut que vous tuiez le capitaine Stillwater, le capitaine Keelhaul et l\'amiral Firallon.‡藏宝海湾的舰队指挥官卡拉·海角要求你杀死血帆海盗的斯蒂沃特船长，尼哈鲁船长和舰队指挥官菲尔拉伦。‡藏寶海灣的艦隊指揮官卡拉·海角要求妳殺死血帆海盜的斯蒂沃特船長，尼哈魯船長和艦隊指揮官菲爾拉倫。',
  }
},
[609] = {
  {
    'Vodu devido‡Должники вуду‡Voodooschulden‡빚 돌려받기‡El vudú debido‡El vudú debido‡Gages vaudou‡讨债行动‡討債行動',
    nil,
    'Leve o Pé-de-clava do Maury, a Luneta Dourada de Janjão e o Anel Enorme do Chucky para MacKinley "Lobo do Mar" na Angra do Butim.‡Принесите деревянную ногу Моури, золотую подзорную трубу Джон-Джона и огромное кольцо Чаки "Морскому волку" Маккинли в Пиратскую бухту.‡Bringt Maurys Klumpfuß, Jon-Jons goldenes Handfernrohr und Chuckys gewaltigen Ring zu "Seewolf" MacKinley in Booty Bay.‡무법항에 있는 "바다늑대" 맥킨리에게 마우리의 의족, 존존의 황금 망원경과 처키의 큰 반지를 가져가야 합니다.‡Lleva el Pie Deforme de Maury, el catalejo dorado de Jon-Jon y el anillo enorme de Chucky a "Lobo de Mar" MacKinley en la Bahía del Botín.‡Lleva la pata de palo de Maury, el catalejo dorado de Jon-Jon y el anillo enorme de Chucky a "Lobo de Mar" MacKinley en la Bahía del Botín.‡Apporter le Fléau de Maury, la Longue-vue dorée de Jon-Jon, et le Grand anneau de Chucky à MacKinley "Loup des mers" à Baie-du-Butin.‡给藏宝海湾的“海狼”马克基雷带回玛雷的畸形足、乔乔的金色望远镜和苏克的巨型戒指。‡給藏寶海灣的“海狼”馬克基雷帶回瑪雷的畸形足、喬喬的金色望遠鏡和蘇克的巨型戒指。',
  }
},
[610] = {
  {
    'Duncan "Bonitão"‡"Красавчик" Дункан‡Schönling Duncan‡"꽃미남" 던컨‡"El Guapo" Duncan"‡El Guapo" Duncan‡Duncan "le Beau garçon"‡帅小伙子邓肯‡帥小夥子鄧肯',
    nil,
    'Recupere a adaga de Fátia com Duncan "Bonitão".‡Отберите меч Кателины у "Красавчика" Дункана.‡Holt Catelyns Dolch von "Schönling" Duncan.‡"꽃미남" 던컨에게서 케이틀린의 단검을 되찾아야 합니다.‡Consigue la daga de Catelyn de "El Guapo" Duncan.‡Consigue la daga de Catelyn de "El Guapo" Duncan.‡Récupérer la Dague de Catelyn auprès de Duncan le "Beau garçon".‡从“帅小伙子”邓肯那里夺回凯特琳的匕首。‡從“帥小夥子”鄧肯那裏奪回凱特琳的匕首。',
  }
},
[611] = {
  {
    'A maldição das marés‡Проклятье приливов‡Der Fluch der Gezeiten‡해일의 저주‡La maldición de las mareas‡La maldición de las mareas‡La malédiction des marées‡海潮的诅咒‡海潮的詛咒',
    nil,
    'Destrua o Altar das Marés com a Lâmina de Fátia, mate Gazban e leve a Pedra das Marés e a Lâmina de Fátia para o Barão Rezingada.‡Уничтожьте Алтарь Приливов при помощи меча Кателины, убейте Газбана и принесите Камень Приливов и меч Кателины барону Ревилгазу.‡Zerstört den Altar der Gezeiten mit Catelyns Klinge, tötet Gazban und bringt dann den Stein der Gezeiten sowie Catelyns Klinge zurück zu Baron Revilgaz.‡케이틀린의 검으로 해일의 제단을 파괴한 다음 가즈반을 처치하고 해일의 돌과 케이틀린의 검을 남작 레빌가즈에게 가져가야 합니다.‡Destruye el Altar de las Mareas con la daga de Catelyn, mata a Gazban y lleva la Piedra de las Mareas y la daga de Catelyn al Barón Revilgaz.‡Destruye el Altar de las Mareas con la daga de Catelyn, mata a Gazban y lleva la Piedra de las Mareas y la daga de Catelyn al Barón Revilgaz.‡Détruire l’Autel des Marées avec la Lame de Catelyn, tuer Gazban et rapporter la Pierre des Marées et la Lame de Catelyn au baron Revilgaz.‡用凯特琳的匕首摧毁海潮祭坛，然后杀死加兹班，将海潮之石带给大财主里维加兹。‡用凱特琳的匕首摧毀海潮祭壇，然後殺死加茲班，將海潮之石帶給大財主裏維加茲。',
  }
},
[613] = {
  {
    'Abrindo o pé do Maury‡Вскрыть ногу Моури‡Maurys Fuß aufbrechen‡마우리의 의족 열기‡El pie roto de Maury‡Abrir la pata de Maury‡Le pied-bot de Maury‡玛雷的腿‡瑪雷的腿',
    nil,
    'Leve a Chave de Maury para MacKinley "Lobo do Mar" na Angra do Butim.‡Принесите "Морскому Волку" Маккинли из Пиратской бухты ключ Моури.‡Bringt Maurys Schlüssel zu "Seewolf" MacKinley in Booty Bay.‡무법항에 있는 "바다늑대" 맥킨리에게 마우리의 열쇠를 가져가야 합니다.‡Lleva la llave de Maury a "Lobo de Mar" Mackinley en la Bahía del Botín.‡Lleva la llave de Maury a "Lobo de Mar" Mackinley en la Bahía del Botín.‡Apporter la Clé de Maury à MacKinley "Loup des mers" à Baie-du-Butin.‡把玛雷的钥匙带给藏宝海湾的“海狼”马克基雷。‡把瑪雷的鑰匙帶給藏寶海灣的“海狼”馬克基雷。',
  }
},
[614] = {
  {
    'O baú do capitão‡Сундук капитана‡Die Truhe des Kapitäns‡선장의 상자‡El cofre del capitán‡El cofre del Capitán‡Le coffre du capitaine‡船长的箱子‡船長的箱子',
    nil,
    'Leve o Baú do Smotts para Hacklebury Smotts na Angra do Butim.‡Верните Гекельберри Шмотту из Пиратской бухты его сундук.‡Bringt Smotts\' Truhe zu Hecklebury Smotts nach Booty Bay.‡무법항에 있는 허클베리 스모츠에게 스모츠의 상자를 가져가야 합니다.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Apporter le Coffre au capitaine Hecklebury Smotts à Baie-du-Butin.‡将斯莫特的箱子交给藏宝海湾的海克拜瑞·斯莫特。‡將斯莫特的箱子交給藏寶海灣的海克拜瑞·斯莫特。',
  }
},
[615] = {
  {
    'O alfanje do capitão‡Капитанская сабля‡Der Entersäbel des Kapitäns‡선장의 커틀라스‡El aflanje del capitán‡El alfanje del Capitán‡Le sabre du capitaine Smott‡船长的弯刀‡船長的彎刀',
    nil,
    'Fale com Zero.‡Поговорите с Салагой.‡Sprecht mit Sprogger.‡스프로거와 대화해야 합니다.‡Habla con Sprogger.‡Habla con Tardo.‡Parler à Sprogger.‡与斯普罗格谈一谈。‡與斯普羅格談壹談。',
  }
},
[616] = {
  {
    'A ilha assombrada‡Остров духов‡Die Spukinsel‡유령의 섬‡La isla fantasma‡La isla fantasma‡L\'île hantée‡幽灵岛‡幽靈島',
    nil,
    'Fale com o Barão Rezingada na Angra do Butim.‡Поговорите с бароном Ревилгазом в Пиратской бухте.‡Sprecht mit Baron Revilgaz in Booty Bay.‡무법항에 있는 남작 레빌가즈와 대화해야 합니다.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Parler au baron Revilgaz, à Baie-du-Butin.‡与藏宝海湾的大财主里维加兹谈一谈。‡與藏寶海灣的大財主裏維加茲談壹談。',
  }
},
[617] = {
  {
    'Akiris aos montes‡Кипы акириса‡Bündelweise Akiris‡아키리스 묶음‡Tallos de juncos akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡壹捆海蛇草',
    nil,
    'Leve 10 Feixes de Junco de Akiris para o Corsário Bloads na Angra do Butim.‡Принесите каперу Блоудсу из Пиратской бухты 10 свертков со стеблями акириса.‡Bringt 10 Stängel Akirisschilfrohr zu Freibeuter Bloads nach Booty Bay.‡무법항에 있는 선원 블로즈에게 아키리스 갈대 묶음 10개를 가져가야 합니다.‡Consigue 10 fajos de junco akiris para el corsario Bloads en Bahía del Botín.‡Consigue 10 fajos de junco akiris para el corsario Bloads en Bahía del Botín.‡Apporter 10 Tas de roseaux akiris au corsaire Bloads à Baie-du-Butin.‡给藏宝海湾的海盗布劳兹带回10根海蛇草。‡給藏寶海灣的海盜布勞茲帶回10根海蛇草。',
  }
},
[618] = {
  {
    'Confrontando Negolash‡Бой с Неголашем‡Negolash entgegentreten‡네골라쉬와의 대적‡Enfréntate a Negolash‡Enfréntate a Negolash‡Face à Negolash‡挑战奈古拉什‡挑戰奈古拉什',
    nil,
    'Leve 10 Asas de Urubu Grelhadas e 5 garrafas de Vinho Selvavinha até o bote salva-vidas do Capitão Smotts.|nMate Negolash e leve o Alfanje de Smotts para o Capitão Smotts na Selva do Espinhaço.‡Отнесите 10 жареных крылышек канюка и 5 бутылок экзотического вина в спасательную шлюпку капитана Смоттса.|nУбейте Неголаша и отнесите абордажную саблю Смоттса хозяину в Тернистую долину.‡Bringt 10 gegrillte Bussardflügel und 5 Flaschen Dschungelrankenwein zu Käpt\'n Smotts Rettungsboot.|nTötet Negolash und bringt Smotts\' Entersäbel zu Captain Smotts ins Schlingendorntal.‡선장 스모츠의 구명정에 대머리수리 날개 구이 10개와 밀림포도나무 와인 5병을 가져가야 합니다.|n네골라쉬를 처치하고 가시덤불 골짜기에 있는 선장 스모츠에게 스모츠의 커틀라스를 가져가십시오.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.|nMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.|nMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Apporter 10 Ailes de busard grillées et 5 bouteilles de Vin de Junglevine dans le Canot de sauvetage du capitaine Smotts.|nTuer Negolash, et apporter le Coutelas de Smotts au capitaine Smotts, à Strangleronce.‡将10块烧烤秃鹰翅膀和5瓶密林葡萄酒带到斯莫特船长的救生艇上去。|n然后杀死奈古拉什，将斯莫特的弯刀交给荆棘谷的斯莫特船长。‡將10塊燒烤禿鷹翅膀和5瓶密林葡萄酒帶到斯莫特船長的救生艇上去。|n然後殺死奈古拉什，將斯莫特的彎刀交給荊棘谷的斯莫特船長。',
  }
},
[619] = {
  {
    'A sedução de Negolash‡Приманка для Неголаша‡Negolash anlocken‡네골라쉬 유인‡La tentación de Negolash‡La tentación de Negolash‡Allécher Negolash‡引诱奈古拉什‡引誘奈古拉什',
    nil,
    nil,
  }
},
[621] = {
  {
    'O segredo de Zanzil‡Тайна Занзила‡Zanzils Geheimnis‡잔질의 비법‡El secreto de Zanzil‡El secreto de Zanzil‡Le secret de Zanzil‡赞吉尔的秘密‡贊吉爾的秘密',
    nil,
    'Leve 12 amostras do Preparado de Zanzil para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской бухты 12 образцов смеси Занзила.‡Bringt 12 Proben von Zanzils Mixtur zu Crank Fizzlebub nach Booty Bay.‡무법항에 있는 크랭크 피즐버브에게 잔질의 혼합물 12개를 가져가야 합니다.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 12 Echantillons de Mixture de Zanzil à Crank Fizzlebub à Baie-du-Butin.‡收集12份赞吉尔的药剂，把它们交给藏宝海湾的克兰克·菲兹巴布。‡收集12份贊吉爾的藥劑，把它們交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[622] = {
  {
    'Fale novamente com o Cabo Kaleb‡Возвращение к капралу Калебу.‡Rückkehr zu Corporal Kaleb‡하사관 칼레브에게 돌아가기‡Vuelve con el cabo Kaleb‡Regresa junto al cabo Kaleb‡La cocotte du caporal Kaleb‡向卡雷布下士回报‡向卡雷布下士回報',
    nil,
    'Leve a Caçarola Melhorada do Krazek para o Cabo Kaleb no Acampamento dos Rebeldes.‡Отнесите целый горшок Крейвела капралу Калебу в Лагерь повстанцев.‡Bringt Krazeks reparierten Topf zu Corporal Kaleb im Rebellenlager.‡반란군 야영지에 있는 하사관 칼레브에게 크라젝의 수리된 냄비를 가져가야 합니다.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Apporter la Cocotte réparée de Krazek au caporal Kaleb, au Camp rebelle.‡将修理过的烹调锅交给叛军营地的卡雷布下士。‡將修理過的烹調鍋交給叛軍營地的卡雷布下士。',
  }
},
[623] = {
  {
    'Akiris aos montes‡Кипы акириса‡Bündelweise Akiris‡아키리스 묶음‡Tallos de juncos akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡壹捆海蛇草',
    nil,
    'Leve um Feixe de Junco de Akiris para o Corsário Groy, em Theramore.‡Принесите сверток со стеблями акириса каперу Грою в Терамор.‡Bringt ein Bündel Akirisschilfrohr zu Freibeuter Groy nach Theramore.‡테라모어 섬에 있는 선원 그로이에게 아키리스 갈대 한 묶음을 가져가야 합니다.‡Lleva un fajo de juncos akiris al corsario Groy, en Theramore.‡Lleva un fajo de juncos akiris al corsario Groy, en Theramore.‡Apporter un Fagot de Roseaux akiris au corsaire Groy à Theramore.‡给塞拉摩的水手格罗伊带去一束海蛇草。‡給塞拉摩的水手格羅伊帶去壹束海蛇草。',
  }
},
[624] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道迷題！',
  }
},
[625] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道迷題！',
  }
},
[626] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道迷題！',
  }
},
[627] = {
  {
    'Um favor para Krazek‡Просьба Кразека‡Gefallen für Krazek‡크라젝의 부탁‡Un favor a Krazek‡Un favor a Krazek‡Un service pour Krazek‡克拉兹克的要求‡克拉茲克的要求',
    nil,
    'Leve 4 cargas de Minério de Pedra-sangrenta Inferior para Krazek, na Angra do Butim.‡Принесите 4 партии бедной кровавой руды Кразеку в Пиратскую бухту.‡Bringt 4 Ladungen geringes Blutsteinerz zu Krazek nach Booty Bay.‡무법항에 있는 크라젝에게 저급 혈석 광물 4개를 가져가야 합니다.‡Lleva 4 fajos de mineral de sangrita inferior a Krazek en la Bahía del Botín.‡Lleva 4 fajos de mena de sangrita inferior a Krazek en la Bahía del Botín.‡Apporter 4 chargements de Minerai de pierre de sang inférieur à Krazek à Baie-du-Butin.‡给藏宝海岸的克拉兹克带去4块次级血石矿。‡給藏寶海岸的克拉茲克帶去4塊次級血石礦。',
  }
},
[628] = {
  {
    'Excelsior‡Эксельзиор‡Exzelsior‡덩치큰 바다악어 가죽‡Borceguí‡Borceguí‡L’Excelsior de chez Drizzlik‡刨花皮靴‡刨花皮靴',
    nil,
    'Traga uma Pele de Crocolisco Ancião para Drizzlik, na Angra do Butim.‡Принесите Дриззлику из Пиратской бухты шкуру большого морского кроколиска.‡Bringt die Haut eines alten Krokilisken zu Drizzlik nach Booty Bay.‡무법항에 있는 드리즐릭에게 덩치큰 바다악어 가죽을 가져가야 합니다.‡Lleva una piel de crocolisco maduro a Drizzlik en la Bahía del Botín.‡Lleva una piel de crocolisco mayor a Drizzlik en la Bahía del Botín.‡Apporter une Peau d\'ancien crocilisque à Drizzlik, à Baie-du-Butin.‡给藏宝海湾的崔斯里克带回1张老鳄鱼的皮。‡給藏寶海灣的崔斯裏克帶回1張老鱷魚的皮。',
  }
},
[629] = {
  {
    'O Arrecife Torpe‡Коварный риф‡Das finstere Riff‡썩은내 산호초‡El Arrecife Mortal‡El Arrecife Mortal‡Le Récif infâme‡暗礁海‡暗礁海',
    nil,
    'Leve um Estilhaço de Tabuleta para Kin\'weelay, no Acampamento Grom\'gol.‡Принесите осколок таблички Кин\'вилаю в лагерь Гром\'гол.‡Bringt 1 Schrifttafel-Splitter zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 서판 조각을 가져가야 합니다.‡Lleva un fragmento de tablilla a Kin\'weelay en el Campamento Grom\'gol.‡Lleva un fragmento de tablilla a Kin\'weelay en el Campamento Grom\'gol.‡Apporter un Fragment de tablette à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地里的肯维雷带回一块石板碎片。‡給格羅姆高營地裏的肯維雷帶回壹塊石板碎片。',
  }
},
[630] = {
  {
    'Mensagem na garrafa‡Послание в бутылке‡Flaschenpost‡쪽지가 든 병‡Mensaje en una botella‡Mensaje en una botella‡Message dans une bouteille‡瓶中信‡瓶中信',
    nil,
    'Mate o Rei Mukla e fale novamente com a Princesa Manda-chuva com a Chave para libertá-la.‡Убейте Короля Муклу, возвращайтесь с ключом к принцессе Пубе и освободите ее.‡Erschlagt König Mukla und kehrt mit dem Schlüssel zu Prinzessin Poobah zurück, um sie zu befreien.‡밀림의왕 무클라를 처치하고 공주 푸바에게 열쇠를 가져가 그녀를 구해야 합니다.‡Mata al rey Mukla y vuelve a por la princesa Poobah con la llave para liberarla.‡Mata al rey Mukla y vuelve a por la princesa Poobah con la llave para liberarla.‡Tuer le roi Mukla, trouver la clé et libérer la princesse Poobah.‡杀死穆克拉并带着钥匙回去救出普巴尔公主。‡殺死穆克拉並帶著鑰匙回去救出普巴爾公主。',
  }
},
[631] = {
  {
    'Ponte Thandol‡Мост Тандола‡Der Thandol-Übergang‡탄돌 교각‡El puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Rhag Garmason quer que você encontre o velho Ferratranca.‡Найдите Ржавого Засова.‡Rhag Garmason will, dass Ihr Ol\' Rustlocke findet.‡라그 가마슨이 러스트로크를 찾아 달라고 부탁했습니다.‡Rhag Garmason quiere que localices a Herrumbra.‡Rhag Garmason quiere que localices a Herrumbra.‡Rhag Garmason veut que vous retrouviez le vieux Rustlocke.‡拉格·加玛森要求你找到老伊本瑟。‡拉格·加瑪森要求妳找到老伊本瑟。',
  }
},
[632] = {
  {
    'Ponte Thandol‡Мост Тандола‡Der Thandol-Übergang‡탄돌 교각‡El puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Apresente-se novamente a Rhag Garmason e mostre a ele o pergaminho encontrado ao lado do cadáver de Ferratranca.‡Принесите печальное известие Рагу Каменщику и отдайте ему пергамент, найденный возле трупа Ржавого Засова.‡Meldet Euch bei Rhag Garmason zurück und zeigt ihm das Pergament, das Ihr bei Rustlockes Leichnam gefunden habt.‡라그 가마슨에게 돌아가서 러스트로크의 시체에서 발견한 양피지 문서를 보여 줘야 합니다.‡Vuelve a informar a Rhag Garmason y enséñale el pergamino que encontraste en el cadáver de Herrumbra.‡Preséntate ante Rhag Garmason y muéstrale el papiro que encontraste en el cadáver de Herrumbra.‡Rendre compte à Rhag Garmason et lui montrer le parchemin que vous avez trouvé sur le corps de Rustlocke.‡向拉格·加玛森回报，并将你在伊本瑟尸体上找到的羊皮纸交给他看看。‡向拉格·加瑪森回報，並將妳在伊本瑟屍體上找到的羊皮紙交給他看看。',
  }
},
[633] = {
  {
    'Ponte Thandol‡Мост Тандола‡Der Thandol-Übergang‡탄돌 교각‡El puente Thandol‡El Puente Thandol‡Le viaduc de Thandol‡萨多尔大桥‡薩多爾大橋',
    nil,
    'Destrua a Caixa de Explosivos.‡Уничтожьте взрывчатку.‡Zerstört den Sprengstoffbehälter‡탄돌 교각 건너편에 있는 폭발물을 찾아서 파괴해야 합니다.‡Destruye el cajón de explosivos.‡Destruye el cajón de explosivos.‡Détruire la cache d\'explosifs.‡摧毁堆积的炸药。‡摧毀堆積的炸藥。',
  }
},
[634] = {
  {
    'Súplica à Aliança‡Просьба о помощи‡Hilfegesuch an die Allianz‡얼라이언스에 지원 요청‡Petición a la Alianza‡Petición a la Alianza‡L\'appel à l\'Alliance‡请求援助‡請求援助',
    nil,
    'Procure a Capitã Nélia, em Ponta do Refúgio.‡Найдите капитана Ниалс в Опорном пункте.‡Macht Captain Nials bei der Zuflucht ausfindig.‡아라시 고원의 임시 주둔지에 있는 부대장 나이얼스를 찾아야 합니다.‡Busca al capitán Nials en el Refugio de la Zaga.‡Busca a la capitana Nials en el Refugio de la Zaga.‡Chercher le capitaine Nials au Refuge de l\'Ornière.‡去避难谷地找到尼艾丝队长。‡去避難谷地找到尼艾絲隊長。',
  }
},
[635] = {
  {
    'Um cristal nas montanhas‡Горный кристалл‡Kristall in den Bergen‡산 속의 수정‡Cristal en las montañas‡Cristal en las montañas‡Le cristal dans les montagnes‡山中的水晶‡山中的水晶',
    nil,
    'Encontre o cristal da sua visão.‡Найдите кристалл из видения.‡Findet den Kristall aus Eurer Vision.‡환영에서 보았던 수정을 찾아야 합니다.‡Encuentra el cristal de tu visión.‡Encuentra el cristal de tu visión.‡Trouver le cristal de votre vision.‡找到你在幻觉中看到的那块水晶。‡找到妳在幻覺中看到的那塊水晶。',
  }
},
[636] = {
  {
    '‡Легенды Земли‡Legenden der Erde‡Legends of the Earth <NYI>‡Las Leyendas de la Tierra‡Leyendas de la tierra‡Légendes de la Terre‡大地公主的传说‡Legends of the Earth <NYI>',
    nil,
    '‡Найдите кристаллы Мизраэль.‡Findet die Splitter von Myzrael.‡미즈라엘의 결정을 찾아야 합니다.‡Encuentra los Fragmentos de Myzrael.‡Encuentra los Fragmentos de Myzrael.‡Trouver les Éclats de Myzrael.‡找到密斯莱尔水晶碎块。‡找到密斯賴爾水晶裂片。',
  }
},
[637] = {
  {
    'Carta de Sully Balof‡Письмо Салли Балу‡Sully Balloos Brief‡설리 발루의 편지‡La carta de Sully Balloo‡La carta de Sully Balloo‡Lettre de Sully Balloo‡苏利·巴鲁的信‡蘇利·巴魯的信',
    nil,
    'Entregue a Carta de Sully Balof a Sara Balof.‡Отнесите письмо Салли Баллу Саре Баллу.‡Bringt Sully Balloos Brief zu Sara Balloo.‡설리 발루의 편지를 사라 발루에게 전해 주십시오.‡Entrégale la carta de Sully Balloo a Sara Balloo.‡Entrégale la carta de Sully Balloo a Sara Balloo.‡Donner la Lettre de Sully Balloo à Sara Balloo.‡把苏利·巴鲁的信交给铁炉堡的萨拉·巴鲁。‡把蘇利·巴魯的信交給鐵爐堡的薩拉·巴魯。',
  }
},
[638] = {
  {
    'Matatroll‡Троллебой‡Trollbane‡트롤베인‡Aterratrols‡Aterratrols‡Trollbane‡巨魔之敌‡巨魔之敵',
    nil,
    'Viaje até Ruína do Martelo, no Planalto Arathi, e fale com Zengu.‡Отправляйтесь в Павший Молот и поговорите с Зенгу.‡Reist nach Hammerfall im Arathihochland und sprecht mit Zengu.‡아라시 고원의 해머폴로 가서 젠구와 대화해야 합니다.‡Viaja a Sentencia en las Tierras Altas de Arathi y habla con Zengu.‡Viaja a Sentencia en las Tierras Altas de Arathi y habla con Zengu.‡Aller au Trépas-d\'Orgrim dans les hautes-terres d\'Arathi et parler à Zengu.‡前往阿拉希高地的落锤镇，与森谷谈一谈。‡前往阿拉希高地的落錘鎮，與森谷談壹談。',
  }
},
[639] = {
  {
    'Signo de Strom‡Печать Штрома‡Siegelzeichen von Strom‡스트롬의 인장‡El sigilo de Strom‡El sigilo de Strom‡Glyphe de Strom‡激流堡符印‡激流堡符印',
    nil,
    'Obtenha o Signo de Strom para Zengu, em Ruína do Martelo.‡Добудьте печать Штрома для Зенгу в Павшем Молоте.‡Holt das Siegelzeichen von Strom für Zengu in Hammerfall.‡해머폴에 있는 젠구에게 스트롬의 인장을 가져가야 합니다.‡Consigue el sigilo de Strom para Zengu en Sentencia.‡Consigue el sigilo de Strom para Zengu en Sentencia.‡Trouver le Glyphe de Strom pour Zengu au Trépas-d\'Orgrim.‡帮落锤村的森古拿回激流堡符印。‡幫落錘村的森古拿回激流堡符印。',
  }
},
[640] = {
  {
    'O signo partido‡Сломанная печать‡Das zerbrochene Siegelzeichen‡깨진 인장‡El sigilo roto‡El sigilo roto‡Le Glyphe qui fut brisé‡破碎的符印‡破碎的符印',
    nil,
    'Recupere os 11 Fragmentos de Signo dos defensores de Stromgarde e leve para Tor\'gan, em Ruína do Martelo.‡Добудьте у защитников Стромгарда 11 фрагментов печати и принесите их Тор\'гану в Павший Молот.‡Holt die 11 Siegelzeichen-Fragmente von den Verteidigern in Stromgarde und bringt sie zu Tor\'gan in Hammerfall.‡스트롬가드의 수호병들에게서 인장 조각 11개를 빼앗아 해머폴에 있는 토건에게 가져가야 합니다.‡Recupera los 11 fragmentos de sigilo de los defensores de Stromgarde y llévaselos a Tor\'gan en Sentencia.‡Recupera los 11 trozos de sigilo de los defensores de Stromgarde y llévaselos a Tor\'gan en Sentencia.‡Reprendre les 11 Fragments de Glyphe aux défenseurs de Stromgarde, puis les apporter à Tor\'gan au Trépas-d\'Orgrim.‡从激流堡的守卫者那里取回11块符印碎片，把它们交给落锤村的托尔甘。‡從激流堡的守衛者那裏取回11塊符印碎片，把它們交給落錘村的托爾甘。',
  }
},
[641] = {
  {
    'Signo de Thoradin‡Печать Торадина‡Siegelzeichen des Thoradin‡소라딘의 인장‡El sigilo de Thoradin‡El sigilo de Thoradin‡Glyphe de Thoradin‡索拉丁符印‡索拉丁符印',
    nil,
    'Leve o Signo de Thoradin restaurado para Zengu, na Ruína do Martelo.‡Принесите восстановленную печать Торадина Зенгу в Павший Молот.‡Bringt das wiederhergestellte Siegelzeichen von Thoradin zu Zengu in Hammerfall.‡해머폴에 있는 젠구에게 소라딘의 인장을 가져가야 합니다.‡Llévale el sigilo de Thoradin restaurado a Zengu en Sentencia.‡Llévale el sigilo de Thoradin restaurado a Zengu en Sentencia.‡Apporter le Glyphe de Thoradin reconstitué à Zengu, au Trépas-d\'Orgrim.‡把修复的索拉丁符印交给落锤村的森古。‡把修復的索拉丁符印交給落錘村的森古。',
  }
},
[642] = {
  {
    'A princesa aprisionada‡Пойманная принцесса‡Die gefangene Prinzessin‡함정에 빠진 공주‡La princesa secuestrada‡La princesa encerrada‡La Princesse emprisonnée‡被困的公主‡被困的公主',
    nil,
    'Colete 12 Grânulos of Myzrael, depois leve-os até os Fragmentos Iridescentes, em Garganta Seca.‡Соберите 12 крупиц Мощи Мизраэли и принесите их к радужным осколкам в Теснине Сухоусов.‡Sammelt 12 Körner von Myzrael und bringt sie zu den regenbogenfarbenen Splittern in der Schlucht der Trockenstoppel.‡미즈라엘의 결정 파편을 12개 모아서 마른수염 골짜기에 있는 오색 결정에 가져가야 합니다.‡Recolecta 12 motas de Myzrael y llévalas a los fragmentos iridiscentes en el Cañón Mostacho Seco.‡Recolecta 12 motas de Myzrael y llévalas a los fragmentos iridiscentes en el Cañón Mostacho Seco.‡Collecter 12 Poussières de Myzrael, puis les répandre sur les Eclats iridescents, à la gorge des Sèches-moustaches.‡收集密斯莱尔之尘。|n把它们放在枯须峡谷中的虹光水晶碎块上。‡收集密斯萊爾之塵。|n把它們放在枯須峽谷中的虹光水晶碎塊上。',
  }
},
[643] = {
  {
    'Signo de Arathor‡Печать Аратора‡Siegelzeichen von Arathor‡아라소르의 인장‡El sigilo de Arathor‡El sigilo de Arathor‡Glyphe d\'Arathor‡阿拉索符印‡阿拉索符印',
    nil,
    'Recupere o Signo de Arathor e leve de volta a Zengu, em Ruína do Martelo.‡Добудьте Печать Аратора и принесите ее Зенгу в Павший Молот.‡Holt das Siegelzeichen von Arathor und bringt es Zengu in Hammerfall.‡아라소르의 인장을 찾은 후 해머폴에 있는 젠구에게 돌아가야 합니다.‡Recupera el sigilo de Arathor y llévaselo a Zengu en Sentencia.‡Recupera el sigilo de Arathor y llévaselo a Zengu en Sentencia.‡Retrouver le Glyphe d\'Arathor et l\'apporter à Zengu, au Trépas-d\'Ogrim.‡取回阿拉索符印，把它交给落锤村的森古。‡取回阿拉索符印，把它交給落錘村的森古。',
  }
},
[644] = {
  {
    'Signo de Matatroll‡Печать Троллебоя‡Siegelzeichen von Trollbane‡트롤베인의 인장‡El sigilo de Aterratrols‡El sigilo de Aterratrols‡Glyphe de Trollbane‡托尔贝恩符印‡托爾貝恩符印',
    nil,
    'Mate o Príncipe Galen Matatroll e leve o Signo de Matatroll para Zengu, na Ruína do Martelo.‡Убейте принца Галена Троллебоя и принесите печать Троллебоя Зенгу в Павший Молот.‡Tötet Prinz Galen Trollbane und bringt das Siegelzeichen von Trollbane zu Zengu in Hammerfall.‡왕자 갈렌 트롤베인을 처치하고 해머폴에 있는 젠구에게 트롤베인의 인장을 가져가야 합니다.‡Mata al Príncipe Galen Aterratrols y llévale el sigilo de Aterratrols a Zengu en Sentencia.‡Mata al príncipe Galen Aterratrols y llévale el sigilo de Aterratrols a Zengu en Sentencia.‡Tuer le prince Galen Trollbane et apporter le Glyphe de Trollbane à Zengu, au Trépas-d\'Ogrim.‡杀掉加林·托尔贝恩王子，把托尔贝恩符印带给落锤村的森古。‡殺掉加林·托爾貝恩王子，把托爾貝恩符印帶給落錘村的森古。',
  }
},
[645] = {
  {
    'Trol\'kalar‡Трол\'калар‡Trol\'kalar‡트롤칼라‡Trol\'kalar‡Trol\'kalar‡Trol\'kalar‡托卡拉尔‡托卡拉爾',
    nil,
    'Recupere Trol\'kalar de dentro da tumba de Matatroll, em Stromgarde.‡Достаньте Трол\'калар из могилы Троллебоя в Стромгарде.‡Holt Trol\'kalar aus Trollbanes Grabmal in Stromgarde.‡스트롬가드에 있는 트롤베인의 무덤에서 트롤칼라를 가지고 와야 합니다.‡Recupera la espada Trol\'kalar de la Tumba de Aterratrols en Stromgarde.‡Recupera la espada Trol\'kalar de la Tumba de Aterratrols en Stromgarde.‡Retirer Trol\'kalar de la tombe de Trollbane à Stromgarde.‡从激流堡的托尔贝恩墓室中取回托卡拉尔剑。‡從激流堡的托爾貝恩墓室中取回托卡拉爾劍。',
  }
},
[646] = {
  {
    'Trol\'kalar‡Трол\'калар‡Trol\'kalar‡트롤칼라‡Trol\'kalar‡Trol\'kalar‡Trol\'kalar‡托卡拉尔‡托卡拉爾',
    nil,
    'Leve Trol\'kalar para Zengu, na Ruína do Martelo.‡Отнесите меч Трол\'калар Зенгу в Павший Молот.‡Bringt Trol\'kalar zu Zengu nach Hammerfall.‡해머폴에 있는 젠구에게 트롤칼라를 가져가야 합니다.‡Entrega Trol\'kalar a Zengu en Sentencia.‡Entrega Trol\'kalar a Zengu en Sentencia.‡Apporter Trol\'kalar à Zengu au Trépas-d\'Orgrim.‡把托卡拉尔剑交给落锤村的森古。‡把托卡拉爾劍交給落錘村的森古。',
  }
},
[647] = {
  {
    'Pinga de Mackreel‡Самогон Маккрила‡MacKreels Fusel‡맥크릴의 위스키‡Licor de Luna de Mackreel‡Licor de luna de Mackreel‡Le tord-boyaux de MacKreel‡马克里尔的月光酒‡馬克裏爾的月光酒',
    nil,
    'Leve a Pinga de Mackreel para o Mestre-cervejeiro Podrágua na Costa Sul.‡Отнесите самогон Маккрила мастеру-пивовару Бочкопузу в Южнобережье.‡Bringt MacKreels Fusel zu Braumeister Bilger nach Southshore.‡사우스쇼어에 있는 양조업자 빌저에게 맥크릴의 위스키를 가져가야 합니다.‡Llévale el licor de luna de MacKreel al maestro cervecero Bilger de Costasur.‡Llévale el licor de luna de MacKreel al maestro cervecero Bilger de Costasur.‡Apporter le Tord-boyaux de MacKreel au brasseur Bilger à Southshore.‡把马克里尔的月光酒交给南海镇的布鲁米·比格尔。‡把馬克裏爾的月光酒交給南海鎮的布魯米·比格爾。',
  }
},
[648] = {
  {
    'Resgate OOX-17/TN!‡Спасти КПХ-17/TN!‡Rettet OOX-17/TN!‡OOX-17/TN 구출‡¡Rescatar a OOX-17/TN!‡¡Rescatar a OOX-17/TN!‡À la rescousse de OOX-17/TN !‡拯救OOX-17/TN！‡拯救OOX-17/TN！',
    nil,
    'Escolte o OOX-17/TN até Porto de Bondebico e apresente-se ao Olhatorto Obnótico, na Angra do Butim.‡Сопроводите КПХ-17/TN в Порт Картеля, затем сообщить об этом Карлсу Пропеллерзу в Пиратской бухте.‡Eskortiert OOX-17/TN nach Steamwheedle und meldet Euch dann bei Oglethorpe Obnoticus in Booty Bay.‡OOX-17/TN을 스팀휘들 항구까지 호위해 간 후, 무법항에 있는 오글소프 오브노티쿠스에게 보고하십시오.‡Lleva a OOX-17/TN hasta el Puerto Bonvapor y después informa a Oglethorpe Obnoticus, que está en Bahía del Botín.‡Escolta a OOX-17/TN a Puerto Bonvapor y después preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escorter OOX-17/TN jusqu\'à Port Gentepression, puis rendre compte à Oglethorpe Obnoticus à Baie-du-Butin.‡将OOX-17/TN护送到热砂港，然后向藏宝海湾的奥格索普·奥布诺提斯报告。‡將OOX-17/TN護送到熱砂港，然後向藏寶海灣的奧格索普·奧布諾提斯報告。',
  }
},
[649] = {
  {
    'Recuperando suco gami‡За медовухой‡Bergung der Welle‡리플 회수‡Recupera el calimocho‡Recupera el calimocho‡La récupération de Houle‡寻找蜜酒‡尋找蜜酒',
    nil,
    'Fale com Malton Droffers em Orgrimmar.‡Поговорите с Мальтоном Дрофферсом в Оргриммаре.‡Sprecht mit Malton Droffers in Orgrimmar.‡오그리마에 있는 말톤 드로퍼스와 대화하십시오.‡Habla con Malton Droffers en Orgrimmar.‡Habla con Malton Droffers en Orgrimmar.‡Parler à Malton Droffers à Orgrimmar.‡和奥格瑞玛的玛尔顿·杜佛斯谈一谈。‡和奧格瑞瑪的瑪爾頓·杜佛斯談壹談。',
  }
},
[650] = {
  {
    'Recuperando suco gami‡За медовухой‡Bergung der Welle‡리플 회수‡Recupera el calimocho‡Recupera el calimocho‡La récupération de Houle‡寻找蜜酒‡尋找蜜酒',
    nil,
    'Fale com Gilveradin Buscassol. O acampamento dele fica nas Terras Agrestes.‡Поговорите с Гилверадином Ловчим Солнца во Внутренних землях.‡Sprecht mit Gilveradin Sunchaser; sein Lager befindet sich im Hinterland.‡길버라딘 선체이서와 대화하십시오. 그의 야영지는 동부 내륙지에 있습니다.‡Habla con Gilveradin Cazasol; su campamento está en las Tierras del Interior.‡Habla con Gilveradin Cazasol; su campamento está en las Tierras del Interior.‡Parler à Gilveradin Sunchaser. Son camp se situe dans les Hinterlands.‡和基沃拉丁·猎日者谈一谈，他的营地就在辛特兰区域。‡和基沃拉丁·獵日者談壹談，他的營地就在辛特蘭區域。',
  }
},
[651] = {
  {
    'Pedras de união‡Связывающие камни‡Steine der Bindung‡마법진의 돌‡Piedras de vínculo‡Piedras de Vínculo‡Les pierres de lien‡禁锢之石‡禁錮之石',
    nil,
    'Consiga a Chave Ardente, a Chave Troante e a Chave Trovejante nas Pedras da União Ocidental, da União Oriental e de União Exterior.|nLeve-as até a Pedra da União Interna.‡Добудьте огненный ключ, резной ключ и громовой ключ с западного связывающего камня, восточного связывающего камня и внешнего связывающего камня.|nОтнесите ключи к внутреннему связывающему камню.‡Holt den brennenden Schlüssel, den Wappenschlüssel und den donnernden Schlüssel vom Stein der westlichen Bindung, dem Stein der östlichen Bindung und dem Stein der äußeren Bindung.‡서부 봉인석, 동부 봉인석, 외부 봉인석에서 각각 불타는 열쇠, 용마루장식 열쇠, 천둥 열쇠를 구해야 합니다.|n세 개의 열쇠를 내부 봉인석으로 가져가야 합니다.‡Reúne la llave ardiente, la llave del emblema y la llave tronadora de la Piedra de Vínculo Occidental, la Piedra de Vínculo Oriental y la Piedra de Vínculo Exterior.|nLlévalas a la Piedra de Vínculo Interior.‡Reúne la llave ardiente, la llave blasonada y la llave del trueno de la Piedra de Vínculo Occidental, la Piedra de Vínculo Este y la Piedra de Vínculo Exterior.|nLlévalas a la Piedra de Vínculo Interior.‡Collecter la Clé ardente, la Clé armoriée et la Clé de tonnerre aux lieux suivants : la Pierre de lien occidentale, la Pierre de lien orientale et la Pierre de lien extérieure.|nLes apporter à la Pierre de lien intérieure.‡从西禁锢之石、东禁锢之石和外禁锢之石中搜集烈焰钥匙、海浪钥匙和雷霆钥匙。|n把它们带到内禁锢之石处。‡從西禁錮之石、東禁錮之石和外禁錮之石中搜集烈焰鑰匙、海浪鑰匙和雷霆鑰匙。|n把它們帶到內禁錮之石處。',
  }
},
[652] = {
  {
    'Quebrando a pedra-chave‡Разбить ключ-камень‡Den Hauptstein zerbrechen‡쐐기돌 깨기‡Desbloquear la piedra angular‡Desbloquear la piedra angular‡La Pierre cruciale‡打开钥匙之石‡打開鑰匙之石',
    nil,
    'Encontre e mate Fozruk. Leve o Bastão de Ordem para a Pedra-chave, no Planalto Arathi.‡Найдите и убейте Фозрука. Принесите Жезл Порядка к ключ-камню на нагорье Арати.‡Findet und tötet Fozruk. Bringt die Rute der Ordnung zum Hauptstein im Arathihochland.‡포즈루크를 찾아 처치해야 합니다. 아라시 고원에 있는 쐐기돌에 질서의 마법봉을 가져가야 합니다.‡Encuentra a Fozruk y mátalo. Lleva la Vara del Orden a la piedra angular en las Tierras Altas de Arathi.‡Encuentra a Fozruk y mátalo. Lleva la vara del Orden a la piedra angular en las Tierras Altas de Arathi.‡Trouver et tuer Fozruk. Apporter le Bâtonnet de l\'ordre à la Pierre cruciale dans les hautes-terres d\'Arathi.‡找到并杀死弗兹鲁克，然后把秩序魔棒带到阿拉希高地的钥匙之石旁。‡找到並殺死弗茲魯克，然後把秩序魔棒帶到阿拉希高地的鑰匙之石旁。',
  }
},
[653] = {
  {
    'Aliados de Myzrael‡Союзники Мизраэли‡Myzraels Verbündete‡미즈라엘의 친구들‡Aliados de Myzrael‡Aliados de Myzrael‡Les alliés de Myzrael‡密斯莱尔的盟友‡密斯萊爾的盟友',
    nil,
    'Fale com Gerrig Agarrosso na Caverna Esquecida de Altaforja.‡Поговорите с Герриком Костохватом в Заброшенном гроте в Стальгорне.‡Sprecht mit Gerrig Bonegrip im düsteren Viertel von Ironforge.‡아이언포지의 쓸쓸한 뒷골목에 있는 게릭 본그립과 대화해야 합니다.‡Habla con Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Habla con Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Parler à Gerrig Bonegrip, dans la caverne lugubre d’Ironforge.‡和铁炉堡的葛利·硬骨谈一谈。‡和鐵爐堡的葛利·硬骨談壹談。',
  }
},
[654] = {
  {
    'Amostras de campo de Tanaris‡Полевые испытания в Танарисе‡Tanaris-Feldproben‡타나리스 현장 견본 수집‡Recogida de muestras en Tanaris‡Recogida de muestras en Tanaris‡Les échantillons du désert de Tanaris‡塔纳利斯的样本‡塔納利斯的樣本',
    nil,
    'Obtenha amostras aceitáveis de 8 basiliscos, 8 hienas e 8 escorpiões. Leve o kit de teste de volta ao Engenheiro-chefe Silvadágua, em Geringontzan, antes que a fonte de energia se esgote.‡Добудьте приемлемые образцы тканей 8 василисков, 8 гиен и 8 скорпионов. Отнесите набор для проведения испытаний главному инженеру Чепухастеру в Прибамбасск до окончания действия источника энергии.‡Sammelt akzeptable Proben von 8 Basilisken, 8 Hyänen und 8 Skorpionen. Bringt das Testset zurück nach Gadgetzan zu Chefingenieur Bilgewhizzle, bevor die Kraftquelle erschöpft ist.‡타나리스 사막에 사는 바실리스크, 하이에나. 전갈에게서 쓸만한 바실리스크 견본, 쓸만한 하이에나 견본, 쓸만한 전갈 견본을 각 8개씩 구해야 합니다. 동력원이 다 떨어지기 전에 가젯잔에 있는 선임기술자 빌지위즐에게 분석 도구를 가져가야 합니다.‡Consigue muestras aceptables de 8 basiliscos, 8 hienas y 8 escorpiones. Devuélvele el equipo de estudio al ingeniero jefe Silvaina, que está en Gadgetzan, antes de que se agote la fuente de energía.‡Consigue muestras aceptables de 8 basiliscos, 8 hienas y 8 escorpiones. Llévale el equipo de prueba al ingeniero jefe Pasaquillas en Gadgetzan antes de que se agote la fuente de energía.‡Acquérir des spécimens acceptables pour 8 basilics, 8 hyènes et 8 scorpions. Rapporter la Trousse d\'analyse de terrain à l\'Ingénieur en chef Bilgewhizzle à Gadgetzan avant que la source d\'énergie ne s\'épuise.‡收集8份蜥蜴样本、8份土狼样本和8份蝎子样本，然后在能量源耗尽之前把野外实验工具包还给加基森的安全主管吉罗姆·比格维兹。‡收集8份蜥蜴樣本、8份土狼樣本和8份蠍子樣本，然後在能量源耗盡之前把野外實驗工具包還給加基森的安全主管吉羅姆·比格維茲。',
  }
},
[655] = {
  {
    'Ruína do Martelo‡Павший Молот‡Hammerfall‡해머폴‡Sentencia‡Sentencia‡Trépas-d\'Orgrim‡落锤镇‡落錘鎮',
    nil,
    'Fale com Tor\'gan em Ruína do Martelo.‡Поговорите с Тор\'ганом в Павшем Молоте.‡Sprecht mit Tor\'gan in Hammerfall.‡해머폴에 있는 토건과 대화해야 합니다.‡Habla con Tor\'gan en Sentencia.‡Habla con Tor\'gan en Sentencia.‡Parler à Tor\'gan au Trépas-d\'Orgrim.‡和落锤村的托尔甘交谈。‡和落錘村的托爾甘交談。',
  }
},
[656] = {
  {
    'Evocação da Princesa‡Призыв принцессы‡Beschwören der Prinzessin‡공주 소환‡Invocar a la princesa‡Invocar a la princesa‡L\'invocation de la Princesse‡召唤大地公主‡召喚大地公主',
    nil,
    'Vá até os Estilhaços de Myzrael, evoque-a e derrote-a.|nColete os Grilhões Sobrenaturais e vincule aos Estilhaços de Myzrael.‡Отправляйтесь к кристаллам Мизраэли, вызовите принцессу и победите ее.|nЗаберите ее мистические оковы и присоедините их к кристаллам.‡Geht zu den Splittern von Myzrael, beschwört und besiegt sie.|nSammelt ihre geisterhaften Fesseln, und bindet diese an die Splitter von Myzrael.‡미즈라엘의 결정으로 가서 그녀를 소환한 후에 처치해야 합니다.|n기괴한 족쇄를 주워서 다시 미즈라엘의 결정에 봉인해야 합니다.‡Ve a los fragmentos de Myzrael, invócala y derrótala.|nRecolecta sus grilletes de Eldritch y pónselos a los fragmentos de Myzrael.‡Ve a los fragmentos de Myzrael, invócala y derrótala.|nRecolecta sus grilletes de Eldritch y pónselos a los fragmentos de Myzrael.‡Aller aux Eclats de Myzrael, l\'invoquer et la battre.|nPrendre ses Chaînes indicibles et les attacher aux Eclats de Myzrael.‡到密斯莱尔水晶碎块去召唤她，然后打败她。|n搜出她身上的怪异镣铐，将其和密斯莱尔水晶碎块缚在一起。‡到密斯萊爾水晶碎塊去召喚她，然後打敗她。|n搜出她身上的怪異鐐銬，將其和密斯萊爾水晶碎塊縛在壹起。',
  }
},
[657] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫？',
    nil,
    'Fale com Kinelory.‡Поговорите с Кинелори.‡Sprecht mit Kinelory.‡키넬로리와 대화해야 합니다.‡Habla con Kinelory.‡Habla con Kinelory.‡Parler à Kinelory.‡和基恩洛谈一谈。‡和基恩洛談壹談。',
  }
},
[658] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫？',
    nil,
    'Encontre a Mensageira Renegada e leve a Pasta Lacrada dela para Quae nas redondezas da Fazenda Go\'Shek.‡Найдите Отрекшегося-курьера и принесите обнаруженную у него запечатанную папку Кви близ фермы Го\'Шека.‡Findet den Kurier der Verlassenen und bringt den versiegelten Ordner zu Quae in der Nähe von Go\'Sheks Hof.‡포세이큰 급사를 찾아서 봉인된 서류를 고셰크 농장 근처에 있는 쿠에에게 가져가야 합니다.‡Encuentra a la mensajera Renegada y lleva su cartera sellada a Quae cerca de la Granja Go\'shek.‡Encuentra a la mensajera Renegada y lleva su carpeta sellada a Quae cerca de la Granja Go\'shek.‡Trouver la Messagère des Réprouvés et ramener ses documents scellés à Quae près de la Ferme des Go\'shek.‡找到被遗忘者信使，把她的密封的信件交给格沙克农场里的奎艾。‡找到被遺忘者信使，把她的密封的信件交給格沙克農場裏的奎艾。',
  }
},
[659] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫？',
    nil,
    'Encontre Quae e Kinelory nas redondezas da Fazenda Go\'Shek, no Planalto Arathi.‡Найдите Кви и Кинелори у фермы Го\'Шека на Нагорье Арати.‡Findet Quae und Kinelory in der Nähe von Go\'Sheks Hof im Arathihochland.‡아라시 고원에 있는 고셰크 농장 근처에서 쿠에와 키넬로리를 찾아야 합니다.‡Encuentra a Quae y a Kinelory cerca de la Granja Go\'shek en las Tierras Altas de Arathi.‡Encuentra a Quae y a Kinelory cerca de la Granja Go\'shek en las Tierras Altas de Arathi.‡Trouver Quae et Kinelory près de la Ferme des Go\'shek dans les hautes-terres d\'Arathi.‡到阿拉希高地上的格沙克农场附近找到奎艾和基恩洛。‡到阿拉希高地上的格沙克農場附近找到奎艾和基恩洛。',
  }
},
[660] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫？',
    nil,
    'Proteja Kinelory até que ela volte para Quae.‡Защищайте Кинелори, пока она не вернется к Кви.‡Beschützt Kinelory bis sie zu Quae zurückkehrt.‡키넬로리가 쿠에에게 돌아갈 때까지 보호해야 합니다.‡Protege a Kinelory hasta que haya regresado con Quae.‡Protege a Kinelory hasta que haya regresado con Quae.‡Protéger Kinelory jusqu\'à ce qu\'elle rejoigne Quae.‡保护基恩洛，直到她回到奎艾身边。‡保護基恩洛，直到她回到奎艾身邊。',
  }
},
[661] = {
  {
    'Sinais de uma nova peste?‡Новая чума зарождается?‡Hinweise auf eine neue Seuche?‡새로운 역병의 징조?‡Sospechas de una nueva Peste‡Sospechas de una nueva Peste‡Les indices d\'une Peste nouvelle ?‡新的瘟疫？‡新的瘟疫？',
    nil,
    'Encontre Phin Odelic na Costa Sul.‡Найдите Фина Оделика в Южнобережье.‡Findet Phin Odelic in Southshore.‡사우스쇼어에 있는 핀 오델릭을 찾아가야 합니다.‡Encuentra a Phin Odelic en Costasur.‡Encuentra a Phin Odelic en Costasur.‡Retrouver Phin Odelic à Southshore.‡到南海镇去找到费恩·奥德利克。‡到南海鎮去找到費恩·奧德利克。',
  }
},
[662] = {
  {
    'Resgate no mar profundo‡Поиски на глубине‡Tiefsee-Bergung‡심해의 인양 작업‡Rescate en alta mar‡Rescate en alta mar‡Sauvetage en haute mer‡深海打捞‡深海打撈',
    nil,
    'O Primeiro Oficial Nadaliso quer que você recupere as Cartas Náuticas e Diários de Bordo do Extravagância da Donzela e do Espírito de Pinhaprata.‡Первый помощник Нилзликс хочет, чтобы вы достали карты и судовые журналы кораблей "Девичья Блажь" и "Дух Серебряного бора".‡Der erste Maat Nilzlix will, dass Ihr die Karten und Logbücher von der TOLLEN MINNA und der SILBERGEIST zurückholt.‡일등항해사 닐즐릭스가 메이든즈 폴리호와 실버파인 스피릿호에서 해도와 항해일지를 찾아 달라고 부탁했습니다.‡El primer oficial Nizlix quiere que recuperes los cuadernos de bitácora y las cartas de navegación de El capricho y del Espíritu de argénteos.‡El contramaestre Nizlix quiere que recuperes los cuadernos de bitácora y las cartas de navegación de El Capricho y del Espíritu de argénteos.‡Le lieutenant Nilzlix veut que vous récupériez les Cartes et les Journaux de bord de la « Folie de la vierge » et de « L\'Esprit des Pins argentés ».‡大副尼兹利克斯让你从处女号和银松之魂号中取回航海图和航海日志。‡大副尼茲利克斯讓妳從處女號和銀松之魂號中取回航海圖和航海日誌。',
  }
},
[663] = {
  {
    'Terra à vista!‡Эй, там!‡Land Ho!‡육지다!‡¡Tierra a vista!‡¡Tierra a vista!‡Terre !‡法迪尔海湾‡法迪爾海灣',
    nil,
    'Fale com o Capitão Nabrava na Enseada de Faldir.‡Поговорите с капитаном О\'Брином в бухте Фальдира.‡Sprecht mit Kapitän O\'Breen in der Faldirbucht.‡팔디르의 만에 있는 선장 오브린과 대화해야 합니다.‡Habla con el capitán O\'Breen en la Cala de Faldir.‡Habla con el capitán O\'Breen en la Cala de Faldir.‡Parler au capitaine O\'Breen à la Crique de Faldir.‡和法迪尔海湾的奥布里船长交谈。‡和法迪爾海灣的奧布裏船長交談。',
  }
},
[664] = {
  {
    'Afogando as mágoas‡Затонувшие печали‡Ertrunkene Trauer‡비통한 마음‡Ahogar las penas‡Ahogar las penas‡Chagrin noyé‡船长的复仇‡船長的復仇',
    nil,
    'O Capitão Tripaço, na Enseada de Faldir, quer que você mate 10 Saqueadores Espinhadaga e 3 Feiticeiras Espinhadaga.‡Капитан Стальные Нервы из бухты Фальдира хочет, чтобы вы убили 10 налетчиков и 3 колдуний из клана Пронзающего Гребня.‡Captain Steelgut in der Faldirbucht will, dass Ihr 10 Räuber der Säbelflossen und 3 Zauberhexerinnen der Säbelflossen tötet.‡팔디르의 만에 있는 선장 스틸구트가 비수가시일족 침략자 10마리와 비수가시일족 여마법사 3마리를 처치해 달라고 부탁했습니다.‡El capitán Tripacero de Cala de Faldir quiere que mates a 10 asaltantes Espinadaga y a 3 hechiceras Espinadaga.‡El capitán Tripacero de Cala de Faldir quiere que mates a 10 asaltantes Espinadaga y a 3 hechiceras Espinadaga.‡Le capitaine Steelgut de la crique de Faldir veut que vous tuiez 10 Ecumeurs Daguéchine et 3 Sorcières Daguéchine.‡法迪尔海湾的斯迪加特船长要你去杀掉10个刺脊袭击者和3个刺脊巫师。‡法迪爾海灣的斯迪加特船長要妳去殺掉10個刺脊襲擊者和3個刺脊巫師。',
  }
},
[665] = {
  {
    'Tesouro submerso‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'Escolte o Professor Bruzundanga até a caverna e retorne com ele.‡Проводите профессора Физзлторпа в пещеру и обратно.‡Begleitet Professor Phizzlethorpe zur Höhle und zurück.‡학자 피즐솔프가 동굴에 들어갔다 나올 수 있도록 호위해야 합니다.‡Escolta al profesor Fiseltor hasta la cueva y a su regreso.‡Escolta al profesor Fiseltor hasta la cueva y a su regreso.‡Escorter le professeur Phizzlethorpe à la grotte et revenir.‡护送菲兹索普教授到洞穴里去并平安返回。‡護送菲茲索普教授到洞穴裏去並平安返回。',
  }
},
[666] = {
  {
    'Tesouro submerso‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'O Doutor Medeixo na Enseada de Faldir quer que você consiga 10 Gemas Élficas e devolva os Óculos para Caçar Gemas quando tiver terminado.‡Доктор Драксельмер в бухте Фальдира хочет, чтобы вы собрали 10 эльфийских самоцветов и вернули ему очки Ловца сокровищ, когда закончите.‡Doktor Draxlegauge in der Faldirbucht will, dass Ihr 10 Elfen-Edelsteine einsammelt und die Edelsteinjagdschutzbrille zurückgebt, sobald Ihr fertig seid.‡팔디르의 만에 있는 발명가 드랙슬게이지가 엘프의 보석 10개를 주워 오고 이 일을 끝낸 후 보물찾기 고글을 돌려 달라고 부탁했습니다.‡El doctor Draxlegauge de la Cala de Faldir quiere que reúnas 10 gemas de elfo y le devuelvas las gafas de caza de gemas cuando hayas acabado.‡El doctor Draxlegauge de la Cala de Faldir quiere que reúnas 10 gemas de elfo y le devuelvas las gafas de caza de gemas cuando hayas acabado.‡Le docteur Draxlegauge, à la crique de Faldir, veut que vous rapportiez 10 Gemmes elfiques et que vous rapportiez ensuite les Lunettes de chasse aux gemmes.‡法迪尔海湾的德拉克里格博士要你去收集10块精灵宝石并在完成任务后归还寻宝潜水镜。‡法迪爾海灣的德拉克裏格博士要妳去收集10塊精靈寶石並在完成任務後歸還尋寶潛水鏡。',
  }
},
[667] = {
  {
    'A morte vem das profundezas‡Смерть со дна морского‡Tod von unten‡나가의 공격‡La muerte viene de las profundidades‡Muerte desde abajo‡La mort venue d\'en-bas‡水下伏兵‡水下伏兵',
    nil,
    'Proteja Juanka Nabrava durante o ataque.‡Защитите Мураша О\'Брина во время атаки наг.‡Beschützt Shakes O\'Breen während des Angriffs.‡나가의 공격으로부터 셰익스 오브린을 보호해야 합니다.‡Protege a Temblores O\'Breen durante el ataque.‡Protege a Temblores O\'Breen durante el ataque.‡Protéger Shakes O\'Breen lors de l\'attaque.‡在纳迦的攻击中保护沙克斯·奥布里。‡在納迦的攻擊中保護沙克斯·奧布裏。',
  }
},
[668] = {
  {
    'Tesouro submerso‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'Leve as Gemas Élficas para o Capitão Juanka Nabrava.‡Отнесите эльфийские самоцветы капитану О\'Брину.‡Bringt die Elfen-Edelsteine zu Kapitän O\'Breen.‡선장 오브린에게 엘프의 보석을 가져가야 합니다.‡Llévale las gemas de elfo al capitán O\'Breen.‡Llévale las gemas élficas al capitán O\'Breen.‡Apporter les Gemmes elfique au capitaine O\'Breen.‡把精灵宝石交给奥布里船长。‡把精靈寶石交給奧布裏船長。',
  }
},
[669] = {
  {
    'Tesouro submerso‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'Leve a Amostra de Gema Élfica para o Mestre de Frota Chifre do Mar na Angra do Butim.‡Доставьте образец эльфийского самоцвета командиру флота Морскому Рогу в Пиратскую бухту.‡Bringt die Probe zu Flottenmeister Seehorn nach Booty Bay.‡무법항에 있는 시혼 함장에게 엘프의 보석 표본을 가져가야 합니다.‡Llévale una muestra de gema de elfo al maestro de flota Cuernomarino en Bahía del Botín.‡Llévale la muestra de gema élfica al maestro de flota Cuernomarino en Bahía del Botín.‡Prendre l\'échantillon de Gemme elfique et l\'apporter à l\'amiral Seahorn à Baie-du-Butin.‡把精灵宝石样本交给藏宝海湾的舰队指挥官卡拉·海角。‡把精靈寶石樣本交給藏寶海灣的艦隊指揮官卡拉·海角。',
  }
},
[670] = {
  {
    'Tesouro submerso‡Утонувшее сокровище‡Versunkener Schatz‡가라앉은 보물‡El tesoro sumergido‡El tesoro sumergido‡Le trésor englouti‡水下宝藏‡水下寶藏',
    nil,
    'Entregue a carta de Chifre do Mar a Juanka Nabrava na costa do Planalto Arathi.‡Отвезите письмо Морского Рога Мурашу О\'Брину на нагорье Арати.‡Bringt Seehorns Brief zu Kapitän O\'Breen im Arathihochland.‡아라시 고원에 있는 셰익스 오브린에게 시혼의 봉인된 편지를 전달해야 합니다.‡Llévale la carta de Cuernomarino a Temblores O\'Breen en las Tierras Altas de Arathi.‡Entrégale la carta de Cuernomarino a Temblores O\'Breen en Tierras Altas de Arathi.‡Remettre la Lettre de Seahorn à Shakes O\'Breen dans les hautes-terres d\'Arathi.‡把海角船长的密信送给阿拉希高地的沙克斯·奥布里。‡把海角船長的密信送給阿拉希高地的沙克斯·奧布裏。',
  }
},
[671] = {
  {
    'Magias torpes‡Зловещая магия‡Elende Magien‡사악한 마법‡Magia demoníaca‡Magia demoníaca‡Magies immondes‡邪恶的魔法‡邪惡的魔法',
    nil,
    'Obtenha 10 Amuletos de Pedra-sangrenta e entregue-os a Tor\'gan em Ruína do Martelo.‡Принесите Тор\'гану в Павший Молот 10 амулетов из кровавого камня.‡Holt 10 Blutsteinamulette für Tor\'gan in Hammerfall.‡해머폴에 있는 토건에게 혈석 아뮬렛 10개를 가져가야 합니다.‡Consigue 10 amuletos de sangrita para Tor\'gan en Sentencia.‡Consigue 10 amuletos de sangrita para Tor\'gan en Sentencia.‡Apporter 10 Amulettes de Pierre de sang à Tor\'gan au Trépas-d\'Orgrim.‡帮落锤村的托尔甘找10枚血石护符。‡幫落錘村的托爾甘找10枚血石護符。',
  }
},
[672] = {
  {
    'Espíritos elevados‡Вызов духов‡Mut machen‡되살아나는 영혼‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡振奮精神',
    nil,
    'Consiga 10 Olhos de Raptores do Planalto matando os Andarilhos do Planalto ou os Espancadores do Planalto e entregue a Tor\'gan em Ruína do Martelo.‡Соберите 10 глаз ящеров нагорья с долгоногов и твердозубов нагорья, принесите их Тор\'гану в Павший Молот.‡Bringt 10 Hochlandraptorenaugen von Hochlandschreitern und Hochlandhauern zu Tor\'gan in Hammerfall.‡줄무늬 고원랩터와 외뿔 고원랩터에게서 고원 랩터 눈 10개를 구해 해머폴에 있는 토건에게 가져가야 합니다.‡Consigue 10 ojos de raptor de las Tierras Altas de los zancudos y de los vándalos de las Tierras Altas para Tor\'gan en Sentencia.‡Consigue 10 ojos de raptor de las Tierras Altas de los zancudos y de los descarnadores de las Tierras Altas para Tor\'gan en Sentencia.‡Récupérer 10 Yeux de raptors des plateaux sur les Arpenteurs des hautes-terres et les Vandales des hautes-terres pour Tor\'gan au Trépas-d\'Orgrim.‡从高地阔步龙和高地长尾龙身上取得10个高地迅猛龙的眼球，把它们交给落锤村的托尔甘。‡從高地闊步龍和高地長尾龍身上取得10個高地迅猛龍的眼球，把它們交給落錘村的托爾甘。',
  }
},
[673] = {
  {
    'Magias torpes‡Зловещая магия‡Elende Magien‡사악한 마법‡Magia demoníaca‡Magia demoníaca‡Magies immondes‡邪恶的魔法‡邪惡的魔法',
    nil,
    'Obtenha a Pedra-sangrenta de Marez Capucho e entregue-a a Tor\'gan na Ruína do Martelo.‡Добудьте сферу кровавого камня у чернокнижницы Марез Клобук и принесите ее Тор\'гану в Павший Молот.‡Bergt Marez Cowls Blutsteinkugel und bringt sie zu Tor\'gan in Hammerfall.‡마레즈 코울의 더럽혀진 혈석 수정구를 빼앗아 해머폴에 있는 토건에게 가져가야 합니다.‡Recupera el orbe de sangrita de Marez Cowl y llévaselo a Tor\'gan en Sentencia.‡Recupera el orbe de sangrita de Marez Cogulla y llévaselo a Tor\'gan en Sentencia.‡Trouver l’Orbe de Pierre de sang de Marez Cowl et l’apporter à Tor\'gan au Trépas-d\'Orgrim.‡取回玛雷兹·考尔的血石宝珠，把它交给落锤村的托尔甘。‡取回瑪雷茲·考爾的血石寶珠，把它交給落錘村的托爾甘。',
  }
},
[674] = {
  {
    'Espíritos elevados‡Вызов духов‡Mut machen‡되살아나는 영혼‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡振奮精神',
    nil,
    'Entregue o Amuleto de Garra de Raptor a Gor\'mul.‡Отдайте Гор\'мулю амулет из когтя ящера.‡Gebt das Raptorkrallen-Amulett an Gor\'mul.‡고르멀에게 랩터 발톱 아뮬렛을 전달해야 합니다.‡Dale el amuleto de espolón de raptor a Gor\'mul.‡Entrégale el amuleto de garfa de raptor a Gor\'mul.‡Donner l\'Amulette de griffe de raptor à Gor\'mul.‡把迅猛龙利爪护符交给戈穆尔。‡把迅猛龍利爪護符交給戈穆爾。',
  }
},
[675] = {
  {
    'Espíritos elevados‡Вызов духов‡Mut machen‡되살아나는 영혼‡El despertar de los espíritus‡El despertar de los espíritus‡L\'éveil de l\'esprit‡振奋精神‡振奮精神',
    nil,
    'Fale com Tor\'gan.‡Поговорите с Тор\'ганом.‡Sprecht mit Tor\'gan.‡토건과 대화해야 합니다.‡Habla con Tor\'gan.‡Habla con Tor\'gan.‡Parler à Tor\'gan.‡和托尔甘谈一谈。‡和托爾甘談壹談。',
  }
},
[676] = {
  {
    'O Martelo pode ruir‡Да падет молот‡Der Hammer kann fallen‡해머폴 함락 위기‡La Sentencia‡La Sentencia‡Menace sur le Trépas-d\'Orgrim‡落锤之战‡落錘之戰',
    nil,
    'Mate 8 Ogros Punho de Pedra e 10 Impositores Punho de Pedra. Depois apresente-se a Drum Fel no posto avançado Ruína do Martelo, no Planalto Arathi.‡Убейте 8 огров из клана Тяжелого Кулака и 10 головорезов из клана Тяжелого Кулака, затем найдите Друма Скверного в Павший Молот на нагорье Арати.‡Tötet 8 Oger der Felsfäuste und 10 Vollstrecker der Felsfäuste und sucht dann Drum Fel im Außenposten von Hammerfall im Arathihochland auf.‡돌주먹 오우거 8마리와 돌주먹일족 집행자 10마리를 처치한 다음 아라시 고원의 해머폴로 가서 드럼 펠을 찾아야 합니다.‡Mata a 8 ogros y 10 gorilas Puño de Roca; luego ve a ver a Bombo Vil a la avanzada de Sentencia, en las Tierras Altas de Arathi.‡Mata a 8 ogros y 10 déspotas Puño de Roca; luego ve a ver a Bombo Vil a la avanzada de Sentencia, en las Tierras Altas de Arathi.‡Tuer 8 Ogres Rochepoings et 10 Massacreurs Rochepoings, puis retrouver Drum Fel à l\'avant-poste du Trépas-d\'Ogrim sur les hautes-terres d\'Arathi.‡杀掉8个石拳食人魔和10个石拳执行者，然后去阿拉希高地的落锤村哨所找杜拉姆法尔。‡殺掉8個石拳食人魔和10個石拳執行者，然後去阿拉希高地的落錘村哨所找杜拉姆法爾。',
  }
},
[677] = {
  {
    'Chamado às armas‡К оружию!‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡L\'appel du combat‡短兵相接‡短兵相接',
    nil,
    'Mate 10 Arremessadores Cascasseca, 10 Caçadores de Cabeças Cascasseca e 8 Mandingueiros Cascasseca. Depois, fale novamente com Drum Fel no posto avançado Ruína do Martelo.‡Убейте 10 метателей топоров из племени Сухокожих, 10 охотников за головами из племени Сухокожих и 8 знахарей племени Сухокожих, а затем возвращайтесь к Драму Желчному на заставу Павшего Молота.‡Erschlagt 10 Axtwerfer der Witherbark, 10 Kopfjäger und 8 Hexendoktoren und kehrt zu Drum Fel im Außenposten von Hammerfall zurück.‡마른나무껍질부족 도끼투척병 10명과 인간사냥꾼 10명, 의술사 8명을 처치하고 해머폴 전초기지에 있는 드럼 펠에게 돌아가야 합니다.‡Mata a 10 lanzahachas Secacortezas, 10 cazadores de cabezas y 8 médicos brujas y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Mata a 10 lanzahachas Secacorteza, 10 rebanacabezas y 8 médicos brujos y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Tuer 10 Lanceurs de haches Witherbark, 10 Chasseurs de tête et 8 Sorciers-docteurs, puis retourner voir Drum Fel à l\'avant-poste du Trépas-d\'Orgrim.‡杀死10名枯木掷斧者、10名枯木猎头者和8个枯木巫医，然后回到落锤村哨所的杜拉姆法尔那里。‡殺死10名枯木擲斧者、10名枯木獵頭者和8個枯木巫醫，然後回到落錘村哨所的杜拉姆法爾那裏。',
  }
},
[678] = {
  {
    'Chamado às armas‡К оружию!‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡L\'appel du combat‡短兵相接‡短兵相接',
    nil,
    'Mate 10 Brutamontes Punho de Pedra e 4 Magi Punho de Pedra. Depois, fale novamente com Drum Fel no posto avançado Ruína do Martelo.‡Убейте 10 громил и 4 магов из клана Тяжелого Кулака, затем возвращайтесь к Драму Желчному на заставу Павшего Молота.‡Tötet 10 Schläger der Felsfäuste und 4 Magi der Felsfäuste und sucht dann Drum Fel im Außenposten von Hammerfall auf.‡돌주먹일족 투사 10마리와 돌주먹일족 사제 4마리를 처치한 다음 해머폴 전초 기지에 있는 드럼 펠에게 돌아가야 합니다.‡Mata a 10 toscos Puño de Roca y 4 magos Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Mata a 10 toscos Puño de Roca y 4 magi Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Tuer 10 Brutes Rochepoings et 4 Magi Rochepoings, puis retourner voir Drum Fel à l\'avant-poste du Trépas-d\'Orgrim.‡杀死10个石拳蛮兵和4个石拳法师，然后向落锤村哨所的杜拉姆法尔复命。‡殺死10個石拳蠻兵和4個石拳法師，然後向落錘村哨所的杜拉姆法爾復命。',
  }
},
[679] = {
  {
    'Chamado às armas‡К оружию!‡Zu den Waffen‡전장으로‡Un llamamiento a las armas‡Un llamamiento a las armas‡L\'appel du combat‡短兵相接‡短兵相接',
    nil,
    'Mate 15 Xamãs Punho de Pedra e 10 Senhores dos Punho de Pedra e fale novamente com Drum Fel no posto avançado Ruína do Martelo.‡Убейте 15 шаманов клана Тяжелого Кулака и 3 вождей клана Тяжелого Кулака, а затем возвращайтесь к Драму Желчному на заставу Павшего Молота.‡Tötet 15 Schamanen der Felsfäuste und 10 Lords der Felsfäuste und kehrt zu Drum Fel im Außenposten von Hammerfall im Arathihochland zurück.‡돌주먹일족 주술사 15마리와 돌주먹일족 우두머리 10마리를 처치한 다음 해머폴 전초 기지에 있는 드럼 펠에게 돌아가야 합니다.‡Mata a 10 chamanes Puño de Roca y 15 señores Puño de Roca y vuelve junto a Bombo Vil en la avanzada de Sentencia.‡Mata a 15 chamanes Puño de Roca y 10 señores Puño de Roca y regresa con Bombo Vil en la avanzada de Sentencia.‡Tuer 15 Chamans Rochepoings et 10 Seigneurs Rochepoings et revenir voir Drum Fel à l\'avant-poste du Trépas-d\'Orgrim.‡杀死15个石拳萨满祭司和10个石拳领主，然后向落锤村哨所的杜拉姆法尔复命。‡殺死15個石拳薩滿祭司和10個石拳領主，然後向落錘村哨所的杜拉姆法爾復命。',
  }
},
[680] = {
  {
    'A ameaça real‡Настоящая угроза‡Die echte Bedrohung‡거대한 위협‡Una auténtica amenaza‡Una auténtica amenaza‡La réelle menace‡真正的威胁‡真正的威脅',
    nil,
    'Mate Or\'Kalar e leve a cabeça dele para Korin Fel no posto avançado Ruína do Martelo.‡Убейте Ор\'Калара и принесите его голову Корин Желчной на заставу Павшего Молота.‡Erschlagt Or\'Kalar und bringt seinen Kopf zu Korin Fel in den Außenposten von Hammerfall.‡오르칼라를 처치하고 그 증거로 그의 머리카락을 해머폴 전초 기지에 있는 코린 펠에게 가져가야 합니다.‡Mata a Or\'Kalar y lleva su cabeza a Korin Fel en la avanzada de Sentencia.‡Mata a Or\'Kalar y lleva su cabeza a Korin Vil en la avanzada de Sentencia.‡Tuer Or\'Kalar et apporter sa Tête à Korin Fel à l\'avant-poste du Trépas-d\'Orgrim.‡杀死奥卡拉尔，将他的头颅带给落锤村哨所的科林法尔。‡殺死奧卡拉爾，將他的頭顱帶給落錘村哨所的科林法爾。',
  }
},
[681] = {
  {
    'Casa Grande do Norte‡Северное поместье‡Northfold-Anwesen‡북부습곡 장원‡Mansión Redilnorte‡Mansión Redilnorte‡Le manoir de Nordclos‡诺斯弗德农场‡諾斯弗德農場',
    nil,
    'Mate 10 Bandoleiros da Camarilha e 6 Mercenários da Camarilha.|nDepois, fale novamente com a Capitã Nélia na Ponta do Refúgio.‡Убейте 10 проходимцев из Синдиката и 6 наемников Синдиката.|nЗатем вернитесь к капитану Ниалс в Опорном пункте.‡Tötet 10 Straßenräuber des Syndikats und 6 Söldner des Syndikats.|nKehrt zu Captain Nials bei der Zuflucht zurück.‡비밀결사대 강도 10명과 비밀결사대 용병 6명을 처치해야 합니다.|n임시 주둔지에 있는 부대장 나이얼스에게 돌아가십시오.‡Mata a 10 bandoleros de la Hermandad y 6 mercenarios de la Hermandad.|nVuelve junto a la capitana Nials en el Refugio de la Zaga.‡Mata a 10 bandoleros de la Hermandad y 6 mercenarios de la Hermandad.|nVuelve junto a la capitana Nials en el Refugio de la Zaga.‡Tuer 10 Malandrins du Syndicat et 6 Mercenaires du Syndicat.|nRetourner ensuite alors le capitaine Nials au refuge de l\'Ornière.‡杀掉6个辛迪加雇佣兵和10个辛迪加路霸，然后回到避难谷地去向尼艾丝队长复命。‡殺掉6個辛迪加雇傭兵和10個辛迪加路霸，然後回到避難谷地去向尼艾絲隊長復命。',
  }
},
[682] = {
  {
    'Insígnias de Stromgarde‡Знаки Стромгарда‡Abzeichen von Stromgarde‡스트롬가드 휘장‡Insignias de Stromgarde‡Distintivos de Stromgarde‡Les insignes de Stromgarde‡激流堡徽章‡激流堡徽章',
    nil,
    'Entregue Insígnias de Stromgarde para a Capitã Nélia na Ponta do Refúgio.‡Принесите знаки Стромгарда Капитану Ниалс в Опорный пункт.‡Bringt Abzeichen von Stromgarde zu Captain Nials bei der Zuflucht.‡임시 주둔지에 있는 부대장 나이얼스에게 스트롬가드 휘장 15개를 가져가야 합니다.‡Llévale las insignias de Stromgarde al capitán Nials en el Refugio de la Zaga.‡Lleva distintivos de Stromgarde a la capitana Nials en Refugio de la Zaga.‡Rapporter les Insignes de Stromgarde au capitaine Nials au Refuge de l\'Ornière.‡把激流堡徽章交给位于避难谷地的尼艾丝队长。‡把激流堡徽章交給位於避難谷地的尼艾絲隊長。',
  }
},
[683] = {
  {
    'Apelo de Sara Caxias‡Просьба Сары Балу‡Sara Balloos Hilfegesuch‡사라 발루의 탄원서‡Un favor a Sara Balloo‡La petición de Sara Balloo‡Requête de Sara Balloo‡萨拉·巴鲁的请求‡薩拉·巴魯的請求',
    nil,
    'Entregue o bilhete de Sara Caxias para o Rei Magni Barbabronze, em Altaforja.‡Отнесите прошение Сары Баллу королю Магни Бронзобороду в Стальгорн.‡Bringt Sara Balloos Notiz zu König Magni Bronzebeard von Ironforge.‡아이언포지에 있는 마그니 브론즈비어드 국왕에게 사라 발루의 탄원서를 전달해야 합니다.‡Lleva la nota de Sara Balloo al rey Magni Barbabronce de Forjaz.‡Lleva la nota de Sara Balloo al rey Magni Barbabronce de Forjaz.‡Remettre la lettre de Sara Balloo au roi Magni Bronzebeard à Ironforge.‡把萨拉·巴鲁的便笺交给铁炉堡的国王麦格尼·铜须。‡把薩拉·巴魯的便箋交給鐵爐堡的國王麥格尼·銅須。',
  }
},
[684] = {
  {
    'Procura-se: Marez Capucho‡Разыскивается: Марез Клобук‡GESUCHT: Marez Cowl‡마레즈 코울 현상수배!‡Se busca: Marez Cowl‡Se busca: Marez Cogulla‡On recherche : Marez Cowl‡通缉：玛雷兹·考尔‡通緝：瑪雷茲·考爾',
    nil,
    'Entregue a Cabeça de Marez para a Capitã Nélia na Ponta do Refúgio.‡Принесите капитану Ниалс в Опорный пункт голову Марез.‡Bringt Marez\' Kopf zu Captain Nials bei der Zuflucht.‡마레즈를 처치하고 그 증거로 그녀의 머리카락을 임시 주둔지에 있는 부대장 나이얼스에게 가져가야 합니다.‡Llévale la cabeza de Marez al capitán Nials en el Refugio de la Zaga.‡Llévale la cabeza de Marez a la capitana Nials en el Refugio de la Zaga.‡Apporter la tête de Marez au capitaine Nials, au Refuge de l\'Ornière.‡把玛雷兹的头颅交给避难谷地的尼艾丝队长。‡把瑪雷茲的頭顱交給避難谷地的尼艾絲隊長。',
  }
},
[685] = {
  {
    'Procura-se: Otto e Falcocrista‡Разыскивается: Отто и лорд Соколиный Шлем‡GESUCHT: Falkenstein und Otto‡오토와 팰컨크레스트 현상수배!‡Se busca: Otto y Lord Cresta de Halcón‡Se busca: Otto y Lord Falconcrest‡On recherche : Falconcrest et Otto‡通缉：奥图和法库雷斯特‡通緝：奧圖和法庫雷斯特',
    nil,
    'Entregue a Cabeça de Otto e a Cabeça de Falcocrista para a Capitã Nélia na Ponta do Refúgio.‡Принесите головы Отто и лорда Фалконкреста капитану Ниалс в Опорный пункт.‡Bringt Ottos und Falkensteins Köpfe zu Captain Nials bei der Zuflucht.‡오토와 팰컨크레스트를 처치하고 그 증거로 머리카락을 임시 주둔지에 있는 부대장 나이얼스에게 가져가야 합니다.‡Llévale la cabeza de Otto y la de Cresta de Halcón al capitán Nials en el Refugio de la Zaga.‡Llévale la cabeza de Otto y la de Lord Falconcrest a la capitana Nials en el Refugio de la Zaga.‡Apporter les Têtes de Falconcrest et d\'Otto au capitaine Nials au Refuge de l\'Ornière.‡把法库雷斯特和奥图的头颅交给避难谷地的尼艾丝队长。‡把法庫雷斯特和奧圖的頭顱交給避難谷地的尼艾絲隊長。',
  }
},
[686] = {
  {
    'Homenagem real‡Королевские почести‡Ehrerbietung von einem König‡왕의 하사품‡Un homenaje real‡Un homenaje real‡Hommage royal‡国王的礼物‡國王的禮物',
    nil,
    'O Rei Magni Barbabronze quer que você fale com o Grão-alvanel Orcarmeyer.‡Поговорите с главным каменотесом Мраморщиком.‡König Magni Bronzebeard will, dass Ihr mit Großsteinmetz Marblesten sprecht.‡마그니 브론즈비어드 국왕이 대석공 마블스텐과 대화하라고 명령했습니다.‡El rey Magni Barbabronce quiere que hables con el Gran maestro Mablesten.‡El rey Magni Barbabronce quiere que hables con el gran mampostero Marmolez.‡Le roi Magni Bronzebeard veut que vous parliez avec le maître-maçon Marblesten.‡国王麦格尼·铜须让你去和大石匠玛布勒斯坦谈一谈。‡國王麥格尼·銅須讓妳去和大石匠瑪布勒斯坦談壹談。',
  }
},
[687] = {
  {
    'Theldurin, o Perdido‡Тельдарин Заблудший‡Theldurin der Verirrte‡실성한 텔두린‡Theldurin, el perdido‡Theldurin el Perdido‡Theldurin l’Egaré‡迷失者塞尔杜林‡迷失者塞爾杜林',
    nil,
    'Encontre Theldurin, o Perdido.‡Найдите Тельдарина Заблудшего.‡Findet Theldurin den Verirrten.‡실성한 텔두린을 찾아야 합니다.‡Encuentra a Theldurin el Perdido.‡Encuentra a Theldurin el Perdido.‡Trouver Theldurin l\'Egaré.‡找到迷失者塞尔杜林。‡找到迷失者塞爾杜林。',
  }
},
[688] = {
  {
    'Aliados de Myzrael‡Союзники Мизраэли‡Myzraels Verbündete‡미즈라엘의 친구들‡Aliados de Myzrael‡Aliados de Myzrael‡Les alliés de Myzrael‡密斯莱尔的盟友‡密斯萊爾的盟友',
    nil,
    'Fale com Zaruk em Ruína do Martelo.‡Поговорите с Заруком в Павшем Молоте.‡Sprecht mit Zaruk in Hammerfall.‡해머폴에 있는 자루크와 대화해야 합니다.‡Habla con Zaruk en Sentencia.‡Habla con Zaruk en Sentencia.‡Parler à Zaruk au Trépas-d\'Orgrim.‡和落锤村的萨鲁克谈一谈。‡和落錘村的薩魯克談壹談。',
  }
},
[689] = {
  {
    'Homenagem real‡Королевские почести‡Ehrerbietung von einem König‡왕의 하사품‡Un homenaje real‡Un homenaje real‡Hommage royal‡国王的礼物‡國王的禮物',
    nil,
    'O Grão-alvanel Oscarmeyer, de Altaforja, quer que você lhe traga 5 pedras de Granito de Alterac.‡Принесите главному каменотесу Стальгорна Мраморщику 5 кусков альтеракского гранита.‡Großsteinmetz Marblesten aus Ironforge will 5 Stücke Alteracgranit.‡아이언포지의 대석공 마블스텐이 알터랙 화강암 5개를 가져다 달라고 부탁했습니다.‡El Gran maestro Mablesten de Forjaz quiere 5 piezas de granito de Alterac.‡El gran mampostero Marmolez de Forjaz quiere 5 piezas de granito de Alterac.‡Le Maître Maçon Marblesten d\'Ironforge veut 5 Morceaux de Granit d\'Alterac.‡铁炉堡的大石匠玛布勒斯坦要5块奥特兰克花岗岩。‡鐵爐堡的大石匠瑪布勒斯坦要5塊奧特蘭克花崗巖。',
  }
},
[690] = {
  {
    'O pedido de Malin‡Просьба Малина‡Malins Gesuch‡멀린의 요청‡Una petición de Malin‡Una petición de Malin‡La demande de Malin‡马林的要求‡馬林的要求',
    nil,
    'Procure Rodapeh na Ponta do Refúgio, no Planalto Arathi.‡Найдите Скуэрто в Опорном пункте на нагорье Арати.‡Sucht Skuerto bei der Zuflucht im Arathihochland auf.‡아라시 고원의 임시 주둔지에서 스쿼토를 찾아야 합니다.‡Encuentra a Skuerto en el Refugio de la Zaga, en las Tierras Altas de Arathi.‡Encuentra a Skuerto en el Refugio de la Zaga, en las Tierras Altas de Arathi.‡Trouver Skuerto au Refuge de l\'Ornière dans les hautes-terres d\'Arathi.‡找到位于阿拉希高地上的避难谷地中的斯奎尔图。‡找到位於阿拉希高地上的避難谷地中的斯奎爾圖。',
  }
},
[691] = {
  {
    'Isto vale ouro‡На вес золота‡Das Gewicht in Gold wert‡마법 재료 구하기‡Valer su peso en oro‡Valer su peso en oro‡Valoir son poids en or‡证明实力‡證明實力',
    nil,
    'Obtenha 10 Presas de Cascasseca, 4 Bolsas Medicinais de Cascasseca e uma Faca de Caçador Sombrio para o Aprendiz Kraiten, que aguarda na Ponta do Refúgio.‡Найдите 10 клыков троллей клана Сухокожих, 4 лекарских сумки клана Сухокожих и нож Темного охотника и принесите их ученику Кретьену в Опорном пункте.‡Sucht für Lehrling Kryten bei der Zuflucht 10 Hauer der Witherbark, 4 Medizinbeutel der Witherbark und 1 Schattenjägermesser.‡임시 주둔지에 있는 견습마법사 크리텐에게 마른나무껍질부족 어금니 10개, 마른나무껍질부족 약초 주머니 4개, 어둠사냥꾼 나이프 1개를 가져가야 합니다.‡Encuentra 10 colmillos Secacorteza, 4 bolsas de medicina Secacorteza y una navaja de cazador de las Sombras para el aprendiz Kryten en el Refugio de la Zaga.‡Encuentra 10 colmillos Secacorteza, 4 bolsas de medicina Secacorteza y un cuchillo de cazador de las Sombras para el aprendiz Kryten en el Refugio de la Zaga.‡Trouver 10 Défenses de Witherbark, 4 Bourses-médecine Witherbark et un Couteau de Chasseur d\'ombre pour l\'Apprenti Kryten au Refuge de l\'Ornière.‡帮避难谷地中的学徒克里汀收集10个枯木巨魔的獠牙，4只枯木巨魔的医药包和1把暗影猎手的小刀。‡幫避難谷地中的學徒克裏汀收集10個枯木巨魔的獠牙，4只枯木巨魔的醫藥包和1把暗影獵手的小刀。',
  }
},
[692] = {
  {
    'Os fragmentos perdidos‡Утраченные фрагменты‡Die verlorenen Fragmente‡잃어버린 조각‡Los fragmentos perdidos‡Los trozos perdidos‡Les fragments perdus‡遗失的卷轴碎片‡遺失的卷軸碎片',
    nil,
    'Leve o Fragmento de Pergaminho Rasgado, o Fragmento de Pergaminho Amassado e o Fragmento de Pergaminho Chamuscado para Theldurin, o Perdido.‡Принесите рваный, мятый и обожженный фрагменты свитка Тэльдруину Потерянному.‡Bringt Theldurin dem Verirrten das zerrissene Rollenfragment, das zerknüllte Rollenfragment und das angesengte Rollenfragment.‡실성한 텔두린에게 찢어진 두루마리 조각, 구겨진 두루마리 조각, 그을린 두루마리 조각을 가져가야 합니다.‡Lleva el fragmento de pergamino rasgado, el fragmento de pergamino arrugado y el fragmento de pergamino chamuscado a Theldurin el Perdido.‡Lleva el trozo de pergamino roto, el trozo de pergamino arrugado y el trozo de pergamino chamuscado a Theldurin el Perdido.‡Apporter le Fragment de Parchemin déchiré, le Fragment de Parchemin fripé et le Fragment de Parchemin noirci à Theldurin l\'Egaré.‡把破损的卷轴碎片、弄皱的卷轴碎片和烧焦的卷轴碎片带给迷失者塞尔杜林。‡把破損的卷軸碎片、弄皺的卷軸碎片和燒焦的卷軸碎片帶給迷失者塞爾杜林。',
  }
},
[693] = {
  {
    'Entre a varinha e a espada‡Оружие получше кулаков‡Zauberstab gegen Faust‡마법 지팡이 회수‡Empuñar la varita‡Empuñar la varita‡La baguette au poing‡特雷莱恩的符咒魔杖‡特雷萊恩的符咒魔杖',
    nil,
    'Encontre a Varinha de Evocação de Trelane e entregue-a a Rodapeh, na Ponta do Refúgio.‡Найдите заклинательный жезл Трелана и верните его Скуэрто в Опорный пункт.‡Sucht Trelanes Zauberstab der Herbeirufung und bringt ihn Skuerto bei der Zuflucht.‡트렐레인의 마법지팡이를 찾아 임시 주둔지에 있는 스쿼토에게 가져가야 합니다.‡Encuentra la varita de evocación de Trelane y llévasela a Skuerto en el Refugio de la Zaga.‡Encuentra la varita de evocación de Trelane y llévasela a Skuerto en el Refugio de la Zaga.‡Trouver la Baguette d\'invocation de Trelane et revenir voir Skuerto au Refuge de l\'Ornière.‡帮避难谷地的斯奎尔图找到特雷莱恩的符咒魔杖，并把它带回来。‡幫避難谷地的斯奎爾圖找到特雷萊恩的符咒魔杖，並把它帶回來。',
  }
},
[694] = {
  {
    'As defesas de Trelane‡Оборона Трелана‡Trelanes Verteidigung‡트렐레인의 방어 장치‡Las defensas de Trelane‡Las defensas de Trelane‡Les défenses de Trelane‡特雷莱恩的防御‡特雷萊恩的防禦',
    nil,
    'Consiga uma Ágata Lazúli e entregue-a ao Aprendiz Kraiten, na Ponta do Refúgio.‡Найдите лазурный агат и принесите его ученику Кретьену в Опорный пункт.‡Sucht einen azurblauen Achat und bringt ihn Lehrling Kryten bei der Zuflucht.‡푸른색 마노를 찾아서 임시 주둔지에 있는 견습마법사 크리텐에게 가져가야 합니다.‡Encuentra un ágata azur y llévasela al aprendiz Kryten en el Refugio de la Zaga.‡Encuentra un ágata azur y llévasela al aprendiz Kryten en el Refugio de la Zaga.‡Trouver une Agate d\'azur et la porter à l\'Apprenti Kryten au Refuge de l\'Ornière.‡找到一块碧蓝玛瑙石，把它交给避难谷地处的学徒克里汀。‡找到壹塊碧藍瑪瑙石，把它交給避難谷地處的學徒克裏汀。',
  }
},
[695] = {
  {
    'O encantamento de um aprendiz‡Чары ученика‡Des Lehrlings Verzauberung‡수습생의 마법‡Un encantamiento de aprendiz‡Un encantamiento de aprendiz‡Enchantement d\'Apprenti‡学徒的魔法‡學徒的魔法',
    nil,
    'Fale com Rodapeh.‡Поговорите со Скуэрто.‡Sprecht mit Skuerto.‡스쿼토와 대화해야 합니다.‡Habla con Skuerto.‡Habla con Skuerto.‡Parler à Skuerto.‡和斯奎尔图谈一谈。‡和斯奎爾圖談壹談。',
  }
},
[696] = {
  {
    'Ataque à torre‡Атака на башню‡Angriff auf den Turm‡탑 공격‡Ataque a la torre‡Ataque a la torre‡Attaque sur la tour‡进攻高塔‡進攻高塔',
    nil,
    'Encontre o Filactério de Trelane, o Orbe de Trelane e a Ágata-de-fogo de Trelane e entregue-os a Rodapeh na Ponta do Refúgio.‡Найдите талисман, сферу и угольный агат Трелана и принесите их Скуэрто в Опорный пункт.‡Sucht Trelanes Phylakterium, Trelanes Kugel und Trelanes Glutachat und bringt ihn Skuerto bei der Zuflucht.‡트렐레인의 부적, 트렐레인의 수정구, 트렐레인의 붉은 마노를 찾아 임시 주둔지에 있는 스쿼토에게 가져가야 합니다.‡Encuentra la filacteria de Trelane, el orbe de Trelane y el ágata ámbar de Trelane, y llévaselo todo a Skuerto en el Refugio de la Zaga.‡Encuentra la filacteria de Trelane, el orbe de Trelane y el ágata de ascuas de Trelane, y llévaselo todo a Skuerto en el Refugio de la Zaga.‡Trouver le Phylactère de Trelane, l\'Orbe de Trelane et l\'Agathe d\'ambre de Trelane. Les rapporter à Skuerto au Refuge de l\'Ornière.‡找到特雷莱恩的护符匣、特雷莱恩的宝珠和特雷莱恩的黑玛瑙，把它们交给避难谷地的斯奎尔图。‡找到特雷萊恩的護符匣、特雷萊恩的寶珠和特雷萊恩的黑瑪瑙，把它們交給避難谷地的斯奎爾圖。',
  }
},
[697] = {
  {
    'O pedido de Malin‡Просьба Малина‡Malins Gesuch‡멀린의 의뢰‡Una petición de Malin‡Una petición de Malin‡La demande de Malin‡马林的要求‡馬林的要求',
    nil,
    'Leve a Carta Lacrada para o Arquimago Malin, no Distrito dos Magos de Ventobravo.‡Отвезите запечатанное письмо верховному магу Малину в Квартал магов Штормграда.‡Bringt dem Erzmagier Malin im Magierviertel von Stormwind den versiegelten Brief.‡스톰윈드의 마법사 지구에 있는 대마법사 멀린에게 보내는 봉인된 편지를 전달해 주어야 합니다.‡Lleva la carta sellada al archimago Malin en el Barrio de los Magos de Ventormenta.‡Lleva la carta lacrada al archimago Malin en el Barrio de los Magos de Ventormenta.‡Porter la Lettre scellée à l\'archimage Malin dans le quartier des mages de Stormwind.‡将给大法师马林的信交给暴风城法师区里的大法师马林。‡將給大法師馬林的信交給暴風城法師區裏的大法師馬林。',
  }
},
[698] = {
  {
    'Falta de suprimentos‡Нехватка ресурсов‡Mangelnde Reserven‡보급품 보충‡Falta de suministros‡Falta de suministros‡Petit bonus du soir‡缺乏补给‡缺乏補給',
    nil,
    'Leve 8 Ancas Não Tratadas de Dentesserra para Tok\'Kar no Pântano das Mágoas.‡Принесите Ток\'Кару в Болотах Печали 8 сырых боков острозубых кроколисков.‡Bringt Tok\'Kar in den Sümpfen des Elends 8 Stück unverarbeitete Sägezahnflanken.‡슬픔의 늪에 있는 톡카르에게 신선한 톱니악어 고기 8개를 가져가야 합니다.‡Lleva 8 costillas de denteserra sin preparar a Tok\'Kar en el Pantano de las Penas.‡Lleva 8 costillares de Denteserra sin preparar a Tok\'Kar en el Pantano de las Penas.‡Apporter 8 Flancs de Dents-de-scie non préparés à Tok\'Kar dans le marais des Chagrins.‡给悲伤沼泽的托克卡尔带去8块新鲜的盐齿鳄鱼肉。‡給悲傷沼澤的托克卡爾帶去8塊新鮮的鹽齒鱷魚肉。',
  }
},
[699] = {
  {
    'Falta de suprimentos‡Нехватка ресурсов‡Mangelnde Reserven‡보급품 보충‡Falta de suministros‡Falta de suministros‡Petit bonus du soir‡缺乏补给‡缺乏補給',
    nil,
    'Leve 6 Garras de Tartalisca Dentesserra para Tok\'Kar, no Pântano das Mágoas.‡Принесите 6 когтей острозубого крепкохвата Ток\'Кару на Болота Печали.‡Bringt Tok\'Kar in den Sümpfen des Elends 6 Sägezahnschnapperklauen.‡슬픔의 늪에 있는 톡카르에게 무쇠턱 톱니악어 발톱 6개를 가져가야 합니다.‡Lleva 6 garras de sacudidores Denteserra a Tok\'Kar en el Pantano de las Penas.‡Lleva 6 garras de sacudidores Denteserra a Tok\'Kar en el Pantano de las Penas.‡Apporter 6 Griffes de Mordeurs Dents-de-scie à Tok\'Kar dans le marais des Chagrins.‡给悲伤沼泽的托克卡尔带去6只盐齿钳嘴鳄的爪子。‡給悲傷沼澤的托克卡爾帶去6只鹽齒鉗嘴鱷的爪子。',
  }
},
[700] = {
  {
    'Homenagem real‡Королевские почести‡Ehrerbietung von einem König‡왕의 하사품‡Un homenaje real‡Un homenaje real‡Hommage royal‡国王的礼物‡國王的禮物',
    nil,
    'Apresente-se ao Rei Magni Barbabronze.‡Доставьте известие королю Магни Бронзобороду.‡Erstattet Meldung an König Magni Bronzebeard.‡마그니 브론즈비어드 국왕에게 보고해야 합니다.‡Informa al rey Magni Barbabronce.‡Preséntate ante el rey Magni Barbabronce.‡Rendre compte au Roi Magni Bronzebeard.‡向铁炉堡的国王麦格尼·铜须汇报。‡向鐵爐堡的國王麥格尼·銅須匯報。',
  }
},
[701] = {
  {
    'A astúcia dos raptores‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡迅猛龍的狡詐',
    nil,
    'Consiga 12 Corações de Raptores dos Fareja-carne do Planalto para Tor\'gan.‡Добудьте для Тор\'гана 12 сердец ящера, вырвав их у плотоглотов нагорья.‡Besorgt für Tor\'gan 12 Raptorherzen von Hochlandfleischpirschern.‡식인 고원랩터에게서 랩터 심장 12개를 얻어 토건에게 가져가야 합니다.‡Consigue 12 corazones de raptor de los acechacarnes de las Tierras Altas para Tor\'gan.‡Consigue 12 corazones de raptor de los acechacarnes de las Tierras Altas para Tor\'gan.‡Récupérer 12 Cœurs de raptor provenant de Charognards des hautes-terres pour Tor\'gan.‡从高地猎兽龙身上获取12颗迅猛龙的心脏，把它们交给托尔甘。‡從高地獵獸龍身上獲取12顆迅猛龍的心臟，把它們交給托爾甘。',
  }
},
[702] = {
  {
    'A astúcia dos raptores‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡迅猛龍的狡詐',
    nil,
    'Entregue o Orbe de Tor\'gan para Gor\'mul.‡Отдайте Гор\'мулю сферу Тор\'гана.‡Gebt Gor\'mul Tor\'gans Kugel.‡고르멀에게 토건의 수정구를 전달해야 합니다.‡Dale el orbe de Tor\'gan a Gor\'mul.‡Entrégale el orbe de Tor\'gan a Gor\'mul.‡Donner l\'Orbe de Tor\'gan à Gor\'mul.‡把托尔甘的宝珠交给戈穆尔。‡把托爾甘的寶珠交給戈穆爾。',
  }
},
[703] = {
  {
    'Churrasquinho de urubu‡Жареные крылышки канюка‡Gegrillte Bussardflügel‡대머리수리 날개 구이‡Alas de águila ratonera a la parrilla‡Alas de águila ratonera a la parrilla‡Ailes de busard grillées‡烧烤秃鹰翅膀‡燒烤禿鷹翅膀',
    nil,
    'Leve 4 Asas de Urubu para Bertolezo.‡Принесите 4 крылышка канюка Ригглфаззу.‡Bringt Rigglefuzz 4 Bussardflügel.‡리글퍼즈에게 대머리수리 날개 4개를 가져가야 합니다.‡Llévale 4 alas de águila ratonera a Aparejez.‡Llévale 4 alas de águila ratonera a Aparejez.‡Apporter 4 Ailes de busard à Rigglefuzz.‡给里格弗兹带去4只秃鹫的翅膀。‡給裏格弗茲帶去4只禿鷲的翅膀。',
  }
},
[704] = {
  {
    'O destino de Agmundo‡Судьба Эгмонда‡Agmonds Schicksal‡아그몬드의 운명‡El sino de Agmond‡El sino de Agmond‡Le destin d\'Agmond‡阿戈莫德的命运‡阿戈莫德的命運',
    nil,
    'Leve 4 Urnas de Pedra com Gravuras para o Prospector Bandaferro, em Loch Modan.‡Принесите 4 резные каменные урны геологу Сталекруту в Лок Модан.‡Bringt Ausgrabungsleiter Ironband am Loch Modan 4 verzierte Steinurnen.‡모단 호수에 있는 발굴조사단장 아이언밴드에게 돌조각 단지 4개를 가져가야 합니다.‡Llévale 4 urnas de piedra labrada al prospector Vetaferro en Loch Modan.‡Llévale 4 urnas de piedra labrada al prospector Vetaferro en Loch Modan.‡Apporter 4 Urnes de pierre gravées au Prospecteur Ironband au Loch Modan.‡收集4个雕纹石罐，把它们交给洛克莫丹的勘察员基恩萨·铁环。‡收集4個雕紋石罐，把它們交給洛克莫丹的勘察員基恩薩·鐵環。',
  }
},
[705] = {
  {
    'Pescando pérolas‡В поисках жемчуга‡Perlentauchen‡진주잡이‡La pesca de perlas‡La pesca de perlas‡Pêche aux perles‡潜水采珍珠‡潛水采珍珠',
    nil,
    'Leve 9 Pérolas Azuis para Bertolezo, nos Ermos.‡Принесите 9 синих жемчужин Ригглфаззу в Бесплодные земли.‡Bringt Rigglefuzz im Ödland 9 blaue Perlen.‡황야의 땅에 있는 리글퍼즈에게 푸른 진주 9개를 가져가야 합니다.‡Llévale 9 perlas azules a Aparejez en las Tierras Inhóspitas.‡Llévale 9 perlas azules a Aparejez en las Tierras Inhóspitas.‡Apporter 9 Perles bleues à Rigglefuzz dans les Terres ingrates.‡收集9枚蓝珍珠，把它们交给荒芜之地的里格弗兹。‡收集9枚藍珍珠，把它們交給荒蕪之地的裏格弗茲。',
  }
},
[706] = {
  {
    'Encantamentos de Labareda Abrasadora‡Чары яркого пламени‡Feuerverzauberungen‡이글거리는 불꽃의 부적‡Encantamientos de fuego abrasador‡Encantamientos Llamarada ígnea‡Enchantement flamboyant éclatant‡黑龙之火‡黑龍之火',
    nil,
    'Consiga um Coração de Draco Preto para Sigrun Derrubaferro.‡Принесите сердце черного дракона Сигруну Рудотесу.‡Besorgt Sigrun Ironhew ein Schwarzdrachenherz.‡시그런 아이언휴를 위해 레슬로 협곡에 있는 새끼 비룡에게서 검은 비룡의 심장을 구해야 합니다.‡Consigue 1 corazón de dragón negro para Sigrun Extracero.‡Consigue 1 corazón de draco negro para Sigrun Extracero.‡Récupérer un Cœur de drake noir pour Sigrun Ironhew.‡为西格鲁·铁斧拿到一颗黑色幼龙之心。‡為西格魯·鐵斧拿到壹顆黑色幼龍之心。',
  }
},
[707] = {
  {
    'Bandaferro quer você!‡Вы нужны Сталекруту!‡Ironband sucht Euch!‡아이언밴드의 호출‡¡Vetaferro te necesita!‡¡Vetaferro te necesita!‡Ironband a besoin de vous !‡铁环挖掘场需要你！‡鐵環挖掘場需要妳！',
    nil,
    'Fale com o Prospector Bandaferro, no Sítio de Escavação de Bandaferro, em Loch Modan.‡Поговорите с геологом Сталекрутом на раскопках Сталекрута близ озера Лок.‡Sprecht auf Ironbands Ausgrabungsstätte am Loch Modan mit Ausgrabungsleiter Ironband.‡모단 호수에 있는 아이언밴드의 발굴현장에서 발굴조사단장 아이언밴드와 대화하십시오.‡Habla con el prospector Vetaferro en su excavación de Loch Modan.‡Habla con el prospector Vetaferro en la Excavación de Vetaferro en Loch Modan.‡Parler au Prospecteur Ironband, sur le Site de fouilles de Loch Modan.‡和洛克莫丹铁环挖掘场的勘察员基恩萨·铁环谈一谈。‡和洛克莫丹鐵環挖掘場的勘察員基恩薩·鐵環談壹談。',
  }
},
[708] = {
  {
    'A caixa preta‡Черный ящик‡Der Flugschreiber‡블랙박스‡La caja negra‡La caja negra‡La boîte noire‡黑盒子‡黑盒子',
    nil,
    'Leve a Caixa Preta Corroída para o Salão das Armas de Altaforja.‡Отнесите заржавевший черный ящик в оружейную Стальгорна.‡Bringt den zerfressenen Flugschreiber in die Halle der Waffen in Ironforge.‡녹슨 블랙박스를 아이언포지에 있는 전투의 전당으로 가져가야 합니다.‡Lleva la caja negra corroída a la Sala de Armas de Forjaz.‡Lleva la caja negra corroída a la Sala de Armas de Forjaz.‡Apporter la Boîte noire corrodée au Hall des armes, à Ironforge.‡把这个黑盒子带到铁炉堡的军事大厅去。‡把這個黑盒子帶到鐵爐堡的軍事大廳去。',
  }
},
[709] = {
  {
    'A solução para o fim‡Лекарство от судьбы‡Lösung der Verdammnis‡멸망의 해결책‡La solución a la maldición‡La solución a la maldición‡La solution à la malédiction‡化解灾难‡化解災難',
    nil,
    'Leve a Tabuleta de Ryun\'eh para Theldurin, o Perdido.‡Принесите табличку Рьюн\'эха Тельдарину Заблудшему.‡Bringt Theldurin dem Verirrten die Schrifttafel von Ryun\'eh.‡실성한 텔두린에게 류네의 서판을 가져가야 합니다.‡Llévale la tablilla de Ryun\'eh a Theldurin el Perdido.‡Llévale la tablilla de Ryun\'eh a Theldurin el Perdido.‡Rapporter la Tablette de Ryun\'eh à Theldurin l\'Egaré.‡把雷乌纳石板带给迷失者塞尔杜林。‡把雷烏納石板帶給迷失者塞爾杜林。',
  }
},
[710] = {
  {
    'Um estudo dos elementos: rocha‡Изучение стихий: Камень‡Element-Studie: Fels‡바위의 정령 연구‡Estudio de los elementos: roca‡Estudio de los elementos: roca‡Étude des éléments : la roche‡研究石元素‡研究石元素',
    nil,
    'Encontre 10 Estilhaços Pequenos de Pedra e leve-os para Lotwil Viriato, nos Ermos.‡Соберите 10 маленьких осколков камня и принесите Лотвилю Вериатусу в Бесплодные земли.‡Sucht 10 kleine Felssplitter und bringt sie Lotwil Veriatus im Ödland.‡황야의 땅에 있는 로크윌 베리아투스에게 작은 돌조각 10개를 가져가야 합니다.‡Encuentra 10 fragmentos de piedra pequeños y llévaselos a Lotwil Veriatus en las Tierras Inhóspitas.‡Encuentra 10 fragmentos de piedra pequeños y llévaselos a Lotwil Veriatus en las Tierras Inhóspitas.‡Trouver 10 Petits Eclats de Pierre et les porter à Lotwil Veriatus dans les Terres ingrates.‡收集10块小石头碎块，把它们交给荒芜之地的鲁特维尔·沃拉图斯。‡收集10塊小石頭碎塊，把它們交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[711] = {
  {
    'Um estudo dos elementos: rocha‡Изучение стихий: Камень‡Element-Studie: Fels‡바위의 정령 연구‡Estudio de los elementos: roca‡Estudio de los elementos: roca‡Étude des éléments : la roche‡研究石元素‡研究石元素',
    nil,
    'Leve 3 Lajes Grandes para Lotwil Viriato, nos Ermos.‡Принесите 3 больших куска камня Лотвилю Вериатусу в Бесплодные земли.‡Bringt Lotwil Veriatus im Ödland 3 große Steinplatten.‡황야의 땅에 있는 로트윌 베리아투스에게 큰 돌조각 3개를 가져가야 합니다.‡Llévale 3 losas de piedra grandes a Lotwil Veriatus en las Tierras Inhóspitas.‡Llévale 3 losas de piedra grandes a Lotwil Veriatus en las Tierras Inhóspitas.‡Apporter 3 Grands blocs de pierre à Lotwil Veriatus dans les Terres ingrates.‡收集3块大石片，把它们交给荒芜之地的鲁特维尔·沃拉图斯。‡收集3塊大石片，把它們交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[712] = {
  {
    'Um estudo dos elementos: rocha‡Изучение стихий: Камень‡Element-Studie: Fels‡바위의 정령 연구‡Estudio de los elementos: roca‡Estudio de los elementos: roca‡Étude des éléments : la roche‡研究石元素‡研究石元素',
    nil,
    'Leve 5 Braçadeiras de Liga de Pedra para Lotwil Viriato, nos Ermos.‡Принесите 5 браслетов Камня Лотвилю Вериатусу в Бесплодные земли.‡Bringt Lotwil Veriatus im Ödland 5 Armschienen der Steinbindung.‡황야의 땅에 있는 로트윌 베리아투스에게 바위 결속의 팔보호구 5개를 가져가야 합니다.‡Llévale 5 brazales de vínculo de roca a Lotwil Veriatus en las Tierras Inhóspitas.‡Llévale 5 brazales de vínculo de roca a Lotwil Veriatus en las Tierras Inhóspitas.‡Apporter 5 Brassards de liaison de pierre à Lotwil Veriatus dans les Terres ingrates.‡收集5个石缚护腕，把它们交给荒芜之地的鲁特维尔·沃拉图斯。‡收集5個石縛護腕，把它們交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[713] = {
  {
    'Cuca fresca‡Охлаждение горячих голов‡Kühlaufsätze setzen sich durch‡최고의 냉각제‡Mantener la cabeza fría‡Mantener la cabeza fría‡La tête froide l\'emporte toujours‡至关重要的冷却剂‡至關重要的冷卻劑',
    nil,
    'Encontre Óleo Gélido e leve para Lotwil Viriato, nos Ermos.‡Найдите масло льда и принесите его Лотвилю Вериатусу в Бесплодные земли.‡Sucht Frostöl und bringt es Lotwil Veriatus im Ödland.‡황야의 땅에 있는 로트윌 베리아투스에게 냉기 오일을 가져가야 합니다.‡Encuentra aceite de escarcha y llévaselo a Lotwil Veriatus en las Tierras Inhóspitas.‡Encuentra aceite de Escarcha y llévaselo a Lotwil Veriatus en las Tierras Inhóspitas.‡Trouver de l\'Huile glaciale et la porter à Lotwil Veriatus dans les Terres ingrates.‡找到冰霜之油，把它交给荒芜之地的鲁特维尔·沃拉图斯。‡找到冰霜之油，把它交給荒蕪之地的魯特維爾·沃拉圖斯。',
  }
},
[714] = {
  {
    'Girosc... é o quê?‡Гиро...чего?‡Gyro... Was?‡태엽...장치?‡Un giro... ¿Qué?‡Un giro... ¿Qué?‡Un Gyro... quoi ?‡发条式什么什么仪‡發條式什麽什麽儀',
    nil,
    'Leve um Giroscronatom para Lotwil Viriato, nos Ermos.‡Принесите гирохронатом Лотвилю Вериатусу в Бесплодные земли.‡Bringt Lotwil Veriatus im Ödland einen Gyrochronatom.‡황야의 땅에 있는 로트윌 베리아투스에게 태엽장치를 가져가야 합니다.‡Llévale 1 girocronátomo a Lotwil Veriatus en las Tierras Inhóspitas.‡Llévale 1 girocronátomo a Lotwil Veriatus en las Tierras Inhóspitas.‡Apporter un Gyrochronatome à Lotwil Veriatus dans les Terres ingrates.‡给荒芜之地的鲁特维尔·沃拉图斯带去一个发条式同步协调陀螺仪。‡給荒蕪之地的魯特維爾·沃拉圖斯帶去壹個發條式同步協調陀螺儀。',
  }
},
[715] = {
  {
    'Pedra líquida‡Жидкий камень‡Flüssigstein‡액체 돌‡Piedra líquida‡Piedra líquida‡Pierre liquide‡卢希恩的药水‡盧希恩的藥水',
    nil,
    'Leve uma Poção de Cura e uma Poção Inferior de Invisibilidade para Lucien Tacachave, nos Ermos.‡Принесите зелье простой невидимости и лечебное зелье Люсьену Подай-Ключ в Бесплодные земли.‡Bringt Lucien Tosselwrench im Ödland einen Heiltrank und einen geringen Unsichtbarkeitstrank.‡황야의 땅에 있는 루시앙 토셀렌치에게 치유 물약과 하급 투명 물약을 가져가야 합니다.‡Llévale 1 poción de curación y 1 poción inferior de invisibilidad inferior a Lucien Tosselramienta en las Tierras Inhóspitas.‡Llévale 1 poción de sanación y 1 poción de invisibilidad inferior a Lucien Borlallave en las Tierras Inhóspitas.‡Apporter une Potion d\'invisibilité inférieure et une Potion de soins à Lucien Tosselwrench dans les Terres ingrates.‡为荒芜之地的卢希恩·枪穗找到一瓶次级隐形药水和一瓶治疗药水。‡為荒蕪之地的盧希恩·槍穗找到壹瓶次級隱形藥水和壹瓶治療藥水。',
  }
},
[716] = {
  {
    'Pedra é mais resistente que tecido‡Камень – лучшая одежка!‡Stein ist besser als Stoff‡돌로 만든 보호구‡Es mejor la piedra que la tela‡Es mejor la piedra que la tela‡Mieux est la pierre que le tissu‡有备无患‡有備無患',
    nil,
    'Leve algumas Braçadeiras Decoradas de Bronze para Lucien Tacachave, nos Ermos.‡Принесите украшенные узором бронзовые наручи Люсьену Подай-Ключ в Бесплодные земли.‡Bringt Lucien Tosselwrench im Ödland einige gemusterte bronzene Armschienen.‡황야의 땅에 있는 루시앙 토셀렌치에게 청동 무늬 팔보호구를 가져가야 합니다.‡Llévale unos brazales de bronce grabados a Lucien Tosselramienta en las Tierras Inhóspitas.‡Llévale unos brazales de bronce estampados a Lucien Borlallave en las Tierras Inhóspitas.‡Apporter des Brassards guillochés en bronze à Lucien Tosselwrench dans les Terres ingrates.‡给荒芜之地的卢希恩·枪穗带去一些青铜花纹护腕。‡給荒蕪之地的盧希恩·槍穗帶去壹些青銅花紋護腕。',
  }
},
[717] = {
  {
    'Tremores da Terra‡Дрожь земли‡Erdbeben‡대지의 진동‡Terremotos‡Terremotos‡Tremblement de terre‡大地的震颤‡大地的震顫',
    nil,
    'Use o Signo da Terra para ativar os Pilares de Ametista, Opala e Diamante, e obter as Pedras Rúnicas.|nPonha as pedras rúnicas no Selo da Terra para libertar Neraçoite e Hematus.|nMate-os e entregue as Braçadeiras de Neraçoite, os Grilhões de Hematus e o Signo da Terra para Garek.‡С помощью знака Земли активируйте алмазный, опаловый и аметистовый столпы и извлеките рунные камни.|nПоместите рунные камни на печать Земли и освободите драконов Бича Тьмы и Гематуса.|nУбейте драконов и принесите Гареку наручники Чернохлыста, цепи Гематуса и Знак Земли.‡Benutzt das Zeichen der Erde, um die Amethyst-, Opal- und Diamantsäulen zu aktivieren und die Runensteine zu holen.|nLegt die Runensteine auf das Siegel der Erde, um Schattenbringer und Hematus zu befreien.|nTötet sie und bringt dann Garek Schattenbringers Bindung, Hematus\' Ketten und das Zeichen der Erde.‡대지의 봉인을 사용하여 자수정, 오팔, 다이아몬드의 기둥을 작동시켜 마법석을 모아야 합니다.|n마법석들을 대지의 봉인에 놓아 블랙래쉬와 헤마투스의 봉인을 해제해야 합니다.|n풀려 난 블랙래쉬와 헤마투스를 처치하고 가렉에게 블랙래쉬의 굴레, 헤마투스의 굴레와 대지의 봉인을 가져가야 합니다.‡Usa el Signo de la Tierra para activar el Pilar de Amatista, el de Ópalo y el de Diamante y así obtener las piedras rúnicas.|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Cinchoscura y a Hematus.|nMátalos y llévale a Garek las ataduras de Cinchoscura, las cadenas de Hematus y el Signo de la Tierra.‡Usa el Signo de la Tierra para activar los pilares de amatista, de ópalo y de diamante y así obtener las piedras rúnicas.|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Latigoscuro y a Hematus.|nMátalos y llévale a Garek las ataduras de Latigoscuro, las cadenas de Hematus y el Signo de la Tierra.‡Utiliser le Signe de la Terre pour activer les Piliers d\'Améthyste, d\'Opale et de Diamant, et obtenir les Pierres runiques.|nPlacer les Pierres runiques dans le Sceau de la Terre pour libérer Cinglenoir et Hematus.|nLes tuer, puis rapporter les Liens de Cinglenoir, les Entraves de Hematus et le Signe de la Terre à Garek.‡用大地印章激活钻石柱、玛瑙石柱和紫水晶石柱并拿到三颗符石。|n把符石放在大地封印上，释放黑龙布莱克拉什和赫玛图斯。|n杀了这两条黑龙，把布莱克拉什的锁链、赫玛图斯的锁链和大地印章交给加瑞克。‡用大地印章激活鉆石柱、瑪瑙石柱和紫水晶石柱並拿到三顆符石。|n把符石放在大地封印上，釋放黑龍布萊克拉什和赫瑪圖斯。|n殺了這兩條黑龍，把布萊克拉什的鎖鏈、赫瑪圖斯的鎖鏈和大地印章交給加瑞克。',
  }
},
[718] = {
  {
    'Miragens‡Миражи‡Illusionen‡신기루‡Espejismos‡Espejismos‡Mirages‡饥肠辘辘‡饑腸轆轆',
    nil,
    'Recupere o Caixote de Suprimentos para Sigrun Derrubaferro.‡Верните ящик с припасами Сигруну Рудотесу.‡Holt die Nachschubkiste für Sigrun Ironhew.‡시그런 아이언휴를 위해 보급 상자를 찾아야 합니다.‡Recupera el cajón de provisiones para Sigrun Extracero.‡Recupera el cajón de suministros para Sigrun Extracero.‡Retrouver la Caisse de fournitures pour Sigrun Ironhew.‡帮西格鲁·铁斧找回补给箱。‡幫西格魯·鐵斧找回補給箱。',
  }
},
[719] = {
  {
    'Um anão e suas ferramentas‡Дворф и его инструменты‡Ein Zwerg und sein Werkzeug‡행운의 곡괭이‡Un enanos y sus herramientas‡Un enano y sus herramientas‡Un nain et ses outils‡矮人的工具‡矮人的工具',
    nil,
    'Ache a Picareta da Sorte de Ryedol e devolva ao Prospector Ryedol, ao sul do Sítio de Escavação de Pé-de-malho.‡Найдите счастливую кирку Ржанеца и верните ее геологу Ржанецу к югу от карьера Тяжелоступа.‡Sucht Ryedols Glückshacke und bringt sie Ausgrabungsleiter Ryedol in der Hammertoe-Grabungsstätte.‡라이돌의 행운의 곡괭이를 찾아 해머토의 발굴현장의 남쪽에 있는 발굴조사단장 라이돌에게 되돌려주어야 합니다.‡Encuentra el pico de la suerte de Ryedol y llévaselo al prospector Ryedol al sur de la excavación Piemartillo.‡Encuentra el pico de la suerte de Ryedol y llévaselo al prospector Ryedol al sur de la excavación de Piemartillo.‡Trouver le Piolet de chance de Ryedol et le rapporter au Prospecteur Ryedol au sud du site de fouilles de Hammertoe.‡找到雷杜尔的好运锄，把它交给铁趾挖掘场南边的勘察员雷杜尔。‡找到雷杜爾的好運鋤，把它交給鐵趾挖掘場南邊的勘察員雷杜爾。',
  }
},
[720] = {
  {
    'Um sinal de esperança‡Предвестник надежды‡Ein Hoffnungsschimmer‡희망의 전조‡Un signo de esperanza‡Un signo de esperanza‡Un signe d\'espoir‡一线希望‡壹線希望',
    nil,
    'Encontre o Prospector Ryedol e avise que Grez Pé-de-malho está vivo.‡Найдите геолога Ржанеца и сообщите, что Грез Тяжелоступ жив.‡Sucht Ausgrabungsleiter Ryedol und teilt ihm mit, dass Hammertoe Grez noch am Leben ist.‡발굴조사단장 라이돌을 찾아 해머토 그레즈가 살아 있다는 사실을 알려야 합니다.‡Localiza al prospector Ryedol y dile que Grez Dedomaza está vivo.‡Localiza al prospector Ryedol y dile que Grez Piemartillo está vivo.‡Trouver le Prospecteur Ryedol et lui dire que Hammertoe Grez est en vie.‡找到勘察员雷杜尔，告诉他铁趾格雷兹还活着。‡找到勘察員雷杜爾，告訴他鐵趾格雷茲還活著。',
  }
},
[721] = {
  {
    'Um sinal de esperança‡Предвестник надежды‡Ein Hoffnungsschimmer‡희망의 전조‡Un signo de esperanza‡Un signo de esperanza‡Un signe d\'espoir‡一线希望‡壹線希望',
    nil,
    'Encontre Grez Pé-de-malho em Uldaman.‡Найдите Греза Тяжелоступа в Ульдамане.‡Sucht in Uldaman nach Hammertoe Grez.‡울다만에서 해머토 그레즈를 찾아야 합니다.‡Encuentra a Grez Dedomaza en Uldaman.‡Encuentra a Grez Piemartillo en Uldaman.‡Trouver Hammertoe Grez à Uldaman.‡在奥达曼找到铁趾格雷兹。‡在奧達曼找到鐵趾格雷茲。',
  }
},
[722] = {
  {
    'O amuleto dos segredos‡Амулет тайн‡Amulett der Geheimnisse‡비밀의 아뮬렛‡El amuleto de los secretos‡El amuleto de los secretos‡L\'amulette des secrets‡铁趾的护符‡鐵趾的護符',
    nil,
    'Encontre o Amuleto do Pé-de-malho e o devolva a Grez, em Uldaman.‡Найдите амулет Тяжелоступа и верните его ему в Ульдаман.‡Sucht Hammertoes Amulett und bringt es ihm nach Uldaman.‡해머토의 아뮬렛을 찾아 울다만에 있는 해머토에게 가져가야 합니다.‡Encuentra el amuleto de Piemartillo y llévaselo a Uldaman.‡Encuentra el amuleto de Piemartillo y llévaselo a Uldaman.‡Trouver l\'Amulette de Hammertoe et lui rapporter à Uldaman.‡找到铁趾的护符，把它交给奥达曼的铁趾。‡找到鐵趾的護符，把它交給奧達曼的鐵趾。',
  }
},
[723] = {
  {
    'Prospector da fé‡Клятва верности‡Ein Funken Hoffnung‡돈독한 믿음‡Tener fe en el porvenir‡Tener fe en el porvenir‡Espérance en la foi‡铁趾的遗愿‡鐵趾的遺願',
    nil,
    'Leve o Amuleto do Pé-de-malho para o Prospector Ryedol nos Ermos.‡Отнесите амулет Тяжелоступа геологу Ржанецу в Бесплодные земли.‡Bringt Ausgrabungsleiter Ryedol im Ödland Hammertoes Amulett.‡황야의 땅에 있는 발굴조사단장 라이돌에게 해머토의 아뮬렛을 가져가야 합니다.‡Llévale el amuleto de Piemartillo al prospector Ryedol en las Tierras Inhóspitas.‡Llévale el amuleto de Piemartillo al prospector Ryedol en las Tierras Inhóspitas.‡Porter l\'Amulette de Hammertoe au Prospecteur Ryedol dans les Terres ingrates.‡把铁趾的护符交给荒芜之地的勘察员雷杜恩。‡把鐵趾的護符交給荒蕪之地的勘察員雷杜恩。',
  }
},
[724] = {
  {
    'Prospector da fé‡Клятва верности‡Ein Funken Hoffnung‡돈독한 믿음‡Tener fe en el porvenir‡Tener fe en el porvenir‡Espérance en la foi‡铁趾的遗愿‡鐵趾的遺願',
    nil,
    'Leve o Amuleto do Pé-de-malho para o Historiador Karnik, em Altaforja.‡Отнесите амулет Тяжелоступа историку Карнику в Стальгорне.‡Bringt Historiker Karnik in Ironforge Hammertoes Amulett.‡아이언포지에 있는 역사학자 카르닉에게 해머토의 아뮬렛을 가져가야 합니다.‡Llévale el amuleto de Piemartillo a Karnik el Historiador en Forjaz.‡Llévale el amuleto de Piemartillo a Karnik el Historiador en Forjaz.‡Apporter l\'Amulette de Hammertoe à l\'historien Karnik à Ironforge.‡把铁趾的护符交给铁炉堡的史学家卡尼克。‡把鐵趾的護符交給鐵爐堡的史學家卡尼克。',
  }
},
[725] = {
  {
    'A notícia de uma ameaça‡Слухи об угрозе‡Kunde über die Bedrohung breitet sich aus‡위협의 경고‡Advertir de la amenaza‡Advertir de la amenaza‡Avertir de la menace‡亡者的警告‡亡者的警告',
    nil,
    'Encontre o Conselheiro Belgrum e entregue o bilhete.‡Найдите советника Белграма и отдайте ему записку.‡Sucht Berater Belgrum und gebt ihm die Notiz.‡조언자 벨그룸을 찾아 봉인된 쪽지를 전해야 합니다.‡Encuentra al consejero Belgrum y dale su nota.‡Encuentra al consejero Belgrum y dale su nota.‡Trouver le Conseiller Belgrum et lui donner la Note.‡找到顾问贝尔格拉姆，把便笺交给他。‡找到顧問貝爾格拉姆，把便箋交給他。',
  }
},
[726] = {
  {
    'A notícia de uma ameaça‡Слухи об угрозе‡Kunde über die Bedrohung breitet sich aus‡위협의 경고‡Advertir de la amenaza‡Advertir de la amenaza‡Avertir de la menace‡亡者的警告‡亡者的警告',
    nil,
    'Fale com o Historiador Karnik.‡Поговорите с историком Карником.‡Sprecht mit Historiker Karnik.‡역사학자 카르닉과 대화해야 합니다.‡Habla con Karnik el Historiador.‡Habla con Karnik el Historiador.‡Parler à l\'Historien Karnik.‡和史学家卡尼克谈一谈。‡和史學家卡尼克談壹談。',
  }
},
[727] = {
  {
    'Em busca do Compêndio de Yagyin em Altaforja‡В Стальгорн за книгой Йагина‡Auf nach Ironforge zu \'Yagyins Zusammenstellung\'‡야그인의 법전을 찾아서‡Ir a Forjaz a buscar el "Compendio" de Yagyin‡Ir a Forjaz a buscar el "Compendio" de Yagyin‡Aller à Ironforge chercher le « Sommaire de Yagyin »‡远赴铁炉堡‡遠赴鐵爐堡',
    nil,
    'Dê o Signo do Martelo a Gerrig Agarrosso na Caverna Esquecida de Altaforja.‡Отнесите печать Молота Геррику Костохвату в Заброшенный грот в Стальгорн.‡Gebt Gerrig Bonegrip im düsteren Viertel von Ironforge das Siegelzeichen des Hammers.‡아이언포지의 쓸쓸한 뒷골목에 있는 게릭 본그립에게 해머의 인장을 가져가야 합니다.‡Dale el sigilo del martillo a Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Dale el sigilo del Martillo a Gerrig Agarrahueso en La Caverna Abandonada de Forjaz.‡Donner le Glyphe du Marteau à Gerrig Bonegrip, dans la caverne lugubre d’Ironforge.‡把战锤印章交给铁炉堡的葛利·硬骨。‡把戰錘印章交給鐵爐堡的葛利·硬骨。',
  }
},
[728] = {
  {
    'Em busca do compêndio de Yagyin na Cidade Baixa‡В Подгород за книгой Йагина‡Auf nach Undercity zu \'Yagyins Zusammenstellung\'‡야그인의 법전을 찾아서‡Ir a Entrañas a buscar el "Compendio" de Yagyin‡Ir a Entrañas a buscar el "Compendio" de Yagyin‡Pour le « Sommaire de Yagyin »‡远赴幽暗城‡遠赴幽暗城',
    nil,
    'Leve o Signo do Martelo ao Guardião Bel\'dugur na Cidade Baixa.‡Отнесите печать Молота хранителю Бел\'дугуру в Подгород.‡Bringt dem Bewahrer Bel\'dugur in Undercity das Siegelzeichen des Hammers.‡언더시티에 있는 관리인 벨두거에게 해머의 인장을 가져가야 합니다.‡Llévale el sigilo del martillo al guardián Bel\'dugur en Entrañas.‡Llévale el sigilo del Martillo al vigilante Bel\'dugur en Entrañas.‡Apporter le Glyphe du Marteau au Gardien Bel\'dugur à Undercity.‡把战锤印章交给幽暗城的看守者贝尔杜加。‡把戰錘印章交給幽暗城的看守者貝爾杜加。',
  }
},
[729] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Vá para o sul e veja como está o Prospector Trilheiro.‡Отправляйтесь на юг, найдите геолога Сомнамбулера и узнайте, как у него дела.‡Reist nach Süden und seht nach Ausgrabungsleiter Remtravel.‡남쪽으로 가서 발굴조사단장 렘트레블의 상태를 확인해야 합니다.‡Viaja al sur y asegúrate de que el prospector Tripirrem está bien.‡Viaja al sur y asegúrate de que el prospector Tripirrem está bien.‡Aller vers le sud et vérifier l\'état de santé du Prospecteur Remtravel.‡到南边去一趟，看看勘察员雷姆塔维尔现在处境如何。‡到南邊去壹趟，看看勘察員雷姆塔維爾現在處境如何。',
  }
},
[730] = {
  {
    'Problemas na Costa Negra?‡Неприятности на Темных берегах?‡Ärger in Dunkelküste?‡어둠의 해안에 생긴 문제‡¿Problemas en Costa Oscura?‡¿Problemas en Costa Oscura?‡Des problèmes à Sombrivage ?‡黑海岸的麻烦事‡黑海岸的麻煩事',
    nil,
    'Vá até Auberdine e procure sinais da equipe de escavação enânica.‡Отправьтесь в Аубердин и найдите следы дворфской изыскательской группы.‡Reist nach Auberdine und sucht nach Hinweisen auf das Zwergenausgrabungsteam.‡아우버다인으로 가서 드워프 발굴단의 흔적을 찾아야 합니다.‡Viaja a Auberdine y busca rastros del equipo de excavación enano.‡Viaja a Auberdine y busca rastros del equipo de excavación enano.‡Aller à Auberdine et chercher des indices sur les nains de l\'équipe de fouilles.‡到奥伯丁去寻找矮人挖掘队的线索。‡到奧伯丁去尋找矮人挖掘隊的線索。',
  }
},
[731] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Proteja o Prospector Trilheiro enquanto ele procura o fóssil misterioso, depois fale novamente com a Arqueóloga Hollee em Auberdine.‡Защищайте геолога Сомнамбулера, пока он ищет таинственную окаменелость, а затем вернитесь к археологу Холли в Аубердин.‡Beschützt Ausgrabungsleiter Remtravel, während er nach dem rätselhaften Fossil sucht, und kehrt dann zur Archäologin Hollee in Auberdine zurück.‡신비로운 화석을 찾는 동안 발굴조사단장 렘트레블을 경호한 후 아우버다인에 있는 고고학자 호올리에게 돌아가십시오.‡Protege al prospector Tripirrem mientras busca el fósil misterioso. Luego vuelve a Auberdine y busca al arqueólogo Hollee.‡Protege al prospector Tripirrem mientras busca el fósil misterioso. Luego vuelve a Auberdine y busca a la arqueóloga Hollee.‡Protéger le Prospecteur Remtravel pendant qu\'il recherche le mystérieux fossile, puis revenir voir l\'Archéologue Hollee à Auberdine.‡在勘察员雷姆塔维尔搜寻神秘化石的时候保护他，然后回到奥伯丁的考古学家霍莉那里。‡在勘察員雷姆塔維爾搜尋神秘化石的時候保護他，然後回到奧伯丁的考古學家霍莉那裏。',
  }
},
[732] = {
  {
    'Tremores da Terra‡Дрожь земли‡Erdbeben‡대지의 진동‡Terremotos‡Terremotos‡Tremblement de terre‡大地的震颤‡大地的震顫',
    nil,
    'Recupere o Signo da Terra para Garek.‡Принесите знак Земли Гареку.‡Beschafft für Garek das Zeichen der Erde.‡가렉을 위해 대지의 봉인을 찾아 와야 합니다.‡Recupera el Signo de la Tierra para Garek.‡Recupera el Signo de la Tierra para Garek.‡Retrouver le Signe de la Terre pour Garek.‡帮加瑞克取回大地印章。‡幫加瑞克取回大地印章。',
  }
},
[733] = {
  {
    'Fuçando‡Помогите кто чем может!‡Schnorrerei‡자재 모으기‡¡A gorronear!‡¡A gorronear!‡Demandes variées‡搜集行动‡搜集行動',
    nil,
    'Leve 7 pedaços de Sucata para Sigrun.‡Принесите 7 кусков металлолома Сигруну.‡Bringt Sigrun 7 Teile Metallschrott.‡시그런에게 금속 조각 7개를 가져가야 합니다.‡Consigue 7 piezas de restos de armadura para Sigrun.‡Consigue 7 trocitos de armadura para Sigrun.‡Collecter 7 Morceaux de métal pour Sigrun.‡帮西格鲁收集7块金属碎片。‡幫西格魯收集7塊金屬碎片。',
  }
},
[734] = {
  {
    'Isso vai ser difícil!‡Сложная задача‡Das wird schwierig‡불길한 예감‡Lo tienes crudo‡Lo tienes crudo‡Grandes difficultés‡不祥的感觉‡不祥的感覺',
    nil,
    'Fale com Lucien Tacachave nos Ermos.‡Поговорите с Люсьеном Подай-Ключ в Бесплодных землях.‡Sprecht im Ödland mit Lucien Tosselwrench.‡황야의 땅에 있는 루시앙 토셀렌치와 대화해야 합니다.‡Habla con Lucien Tosselramienta en las Tierras Inhóspitas.‡Habla con Lucien Borlallave en las Tierras Inhóspitas.‡Parler à Lucien Tosselwrench dans les Terres ingrates.‡和荒芜之地的卢希恩·枪穗谈一谈。‡和荒蕪之地的盧希恩·槍穗談壹談。',
  }
},
[735] = {
  {
    'A estrela, a mão e o coração‡Звезда, Длань и Сердце‡Der Stern, die Hand und das Herz‡별, 손, 그리고 심장‡La Estrella, la Mano y el Corazón‡La Estrella, la Mano y el Corazón‡L\'étoile, la main et le cœur‡星，手，心‡星，手，心',
    nil,
    'Leve os itens do Bilhete de Agarrosso para ele em Altaforja.‡Доставьте предметы, перечисленные в записке Костохвата, Геррику Костохвату в Стальгорн.‡Bringt Gerrig Bonegrip in Ironforge die Gegenstände in Bonegrips Notiz.‡아이언포지, 쓸쓸한 뒷골목에 있는 게릭 본그립에게 본그립의 노트에 적힌 물건들을 가져가야 합니다.‡Devuelve los objetos de la lista a Gerrig Agarrahueso a Forjaz.‡Devuelve los objetos de la lista a Gerrig Agarrahueso a Forjaz.‡Rapporter les Objets écrits sur le mot de Bonegrip à Gerrig Bonegrip dans Ironforge.‡找齐葛利·硬骨的便笺上列出的东西，然后把它们交给铁炉堡的葛利·硬骨。‡找齊葛利·硬骨的便箋上列出的東西，然後把它們交給鐵爐堡的葛利·硬骨。',
  }
},
[736] = {
  {
    'A estrela, a mão e o coração‡Звезда, Рука и Сердце‡Der Stern, die Hand und das Herz‡별, 손, 그리고 심장‡La Estrella, la Mano y el Corazón‡La Estrella, la Mano y el Corazón‡L\'étoile, la main et le cœur‡星，手，心‡星，手，心',
    nil,
    'Leve os itens do Bilhete de Bel\'dugur para o Guardião Bel\'dugur na Cidade Baixa.‡Прочитайте записку Бел\'дугура. Принесите перечисленные в записке предметы Бел\'дугуру в Подгород.‡Bringt dem Bewahrer Bel\'dugur in Undercity die Gegenstände von Bel\'dugurs Notiz.‡언더시티에 있는 벨두거에게 벨두거의 노트에 적힌 물건들을 가져가야 합니다.‡Llévale los objetos que aparecen en la nota de Bel\'dugur al vigilante Bel\'dugur de Entrañas.‡Llévale los objetos que aparecen en la nota de Bel\'dugur al vigilante Bel\'dugur de Entrañas.‡Apporter les objets de la liste de Bel\'dugur au Gardien Bel\'dugur à Undercity.‡把贝尔杜加的便笺上列出的东西带给幽暗城的看守者贝尔杜加。‡把貝爾杜加的便箋上列出的東西帶給幽暗城的看守者貝爾杜加。',
  }
},
[737] = {
  {
    'Conhecimento proibido‡Запретное знание‡Verbotenes Wissen‡금지된 지식‡El saber prohibido‡El saber prohibido‡Le savoir perdu‡禁断的知识‡禁斷的知識',
    nil,
    'Leve o Compêndio de Yagyin para Theldurin.‡Отнесите книгу Йагина Тэльдруину.‡Bringt Theldurin \'Yagyins Zusammenstellung\'.‡텔두린에게 야그인의 법전을 가져가야 합니다.‡Llévale el compendio de Yagyin a Theldurin.‡Llévale el compendio de Yagyin a Theldurin.‡Porter le « Sommaire de Yagyin » à Theldurin.‡把雅格因的笔记交给塞尔杜林。‡把雅格因的筆記交給塞爾杜林。',
  }
},
[738] = {
  {
    'Encontre Agmundo‡Найти Эгмонда‡Sucht Agmond‡아그몬드 찾기‡Encontrar a Agmond‡Encontrar a Agmond‡Trouver Agmond‡寻找阿戈莫德‡尋找阿戈莫德',
    nil,
    'Encontre Agmundo.‡Найдите Эгмонда.‡Sucht Agmond.‡아그몬드를 찾아야 합니다.‡Encuentra a Agmond.‡Encuentra a Agmond.‡Trouver Agmond.‡找到阿戈莫德。‡找到阿戈莫德。',
  }
},
[739] = {
  {
    'Murdaloc‡Мурдалок‡Murdaloc‡멀달록‡Murdaloc‡Murdaloc‡Murdaloc‡莫达洛克‡莫達洛克',
    nil,
    'Mate Murdaloc, o assassino de Agmundo.|nMate 12 Quebraossos da Abóbada de Pedra.|nApresente-se ao Prospector Bandaferro em Loch Modan.‡Уничтожьте убийцу Эгмонда, Мурдалока.|nУбейте 12 костегрызов из племени Каменного Свода.|nСообщите геологу Сталекруту в Лок Модане обо всем, что произошло.‡Tötet Agmonds Mörder Murdaloc.|nTötet 12 Knochenknacker der Steingrufttroggs.|nErstattet Ausgrabungsleiter Ironband am Loch Modan Bericht.‡아그몬드를 살해한 멀달록을 처치해야 합니다.|n바위동굴일족 뼈다귀싸움꾼 12마리를 처치해야 합니다.|n그 후 모단 호수에 있는 발굴조사단장 아이언밴드에게 보고하십시오.‡Mata al asesino de Agmond, Murdaloc.|nMata a 12 partehuesos Petracripta.|nPreséntate ante el prospector Vetaferro en Loch Modan.‡Mata al asesino de Agmond, Murdaloc.|nMata a 12 Cascahuesos Petracripta.|nPreséntate ante el prospector Vetaferro en Loch Modan.‡Tuer l\'assassin d\'Agmond : Murdaloc.|nTuer 12 Briseurs d’os Cavepierre.|nEt revenir voir le Prospecteur Ironband au Loch Modan.‡干掉杀害阿戈莫德的凶手：莫达洛克。|n顺便杀掉12个石窟断骨者。|n然后向洛克莫丹的勘察员基恩萨·铁环报告。‡幹掉殺害阿戈莫德的兇手：莫達洛克。|n順便殺掉12個石窟斷骨者。|n然後向洛克莫丹的勘察員基恩薩·鐵環報告。',
  }
},
[741] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Leve o fóssil misterioso ao Arqueólogo-chefe Suiçagris em Darnassus.‡Отвезите таинственную окаменелость главному археологу Седоусу в Дарнасс.‡Bringt dem Chefarchäologen Greywhisker in Darnassus das rätselhafte Fossil.‡다르나서스에 있는 수석고고학자 그레이위스커에게 신비로운 화석을 가져가야 합니다.‡Ve a Darnassus y entrega el fósil misterioso al arqueólogo jefe Mostachogris.‡Ve a Darnassus y entrega el fósil misterioso al arqueólogo jefe Mostachogris.‡Apporter le Mystérieux fossile au Chef archéologue Greywhisker, à Darnassus.‡把神秘的化石交给达纳苏斯的首席考古学家杜瑟·灰须。‡把神秘的化石交給達納蘇斯的首席考古學家杜瑟·灰須。',
  }
},
[742] = {
  {
    'A caçada do Vale Gris‡Большая охота‡Die Jagd in Ashenvale‡잿빛 골짜기 사냥 대회‡La Caza de Vallefresno‡La Caza de Vallefresno‡La Chasse d\'Ashenvale‡灰谷狩猎‡灰谷狩獵',
    nil,
    'Fale com Senani Coração Trovejante no Posto Machadada, que fica no Vale Gris.‡Поговорите с Сенани Громосерд на заставе Расщепленного Древа в Ясеневом лесу.‡Sprecht mit Seneni Thunderheart im Splintertreeposten in Ashenvale.‡잿빛 골짜기의 토막나무 주둔지에 있는 세나니 썬더하트를 만나야 합니다.‡Habla con Senani Truenozón en Puesto del Hachazo, en Vallefresno.‡Habla con Senani Corazón Atronador en Puesto del Hachazo, en Vallefresno.‡Parler à Senani Thunderheart, au Poste de Bois-brisé, à Ashenvale.‡与灰谷碎木哨岗的塞娜尼·雷心谈一谈。‡與灰谷碎木哨崗的塞娜尼·雷心談壹談。',
  }
},
[743] = {
  {
    'Perigos das Ventofúria‡Опасности Ярости Ветра‡Windfuriengefahr‡성난바람하피의 위협‡Las Viento Furioso son un peligro‡Las Viento Furioso son un peligro‡Le danger des Furies-des-vents‡风怒鹰身人‡風怒鷹身人',
    nil,
    'Leve 8 Garras de Ventofúria para Ruul Garra da Águia na Aldeia Casco Sangrento.‡Принесите 8 когтей гарпий из стаи Ярости Ветра Руулу Орлиному Когтю в деревню Кровавого Копыта.‡Bringt Ruul Eagletalon in Bloodhoof 8 Windfurienkrallen.‡블러드후프 마을에 있는 루울 이글탈론에게 성난바람하피의 갈퀴발톱 8개를 가져가야 합니다.‡Lleva 8 espolones de Viento Furioso a Ruul Garraguilar al Poblado Pezuña de Sangre.‡Lleva 8 garfas de Viento Furioso a Ruul Garra de Águila al Poblado Pezuña de Sangre.‡Apporter 8 Serres de Furie-des-vents à Ruul Eagletalon, au village Bloodhoof.‡给血蹄村的卢尔·鹰爪带回8只风怒鹰身人的爪子。‡給血蹄村的盧爾·鷹爪帶回8只風怒鷹身人的爪子。',
  }
},
[744] = {
  {
    'Os preparativos da cerimônia‡Подготовка к церемонии‡Vorbereitungen auf die Zeremonie‡의식을 위한 준비‡Preparación para la ceremonia‡Preparación para la ceremonia‡Préparation à la cérémonie‡准备典礼‡準備典禮',
    nil,
    'Reúna 6 Penas Lazúli e 6 Penas Bronze, e leve-as para Eyahn Garra de Águia no Penhasco do Trovão.‡Добудьте 6 лазурных перьев и 6 бронзовых перьев, и принесите их Эйану Орлиному Когтю в Громовой утес.‡Sammelt 6 azurblaue und 6 bronzene Federn und bringt sie Eyahn Eagletalon in Thunder Bluff.‡하늘색 깃털 6개와 청동색 깃털 6개를 모아 썬더 블러프에 있는 이얀 이글탈론에게 가져가야 합니다.‡Consigue 6 plumas azur y 6 de bronce, y llévaselas a Eyahn Garraguilar a Cima del Trueno.‡Consigue 6 plumas azur y 6 de bronce, y llévaselas a Eyahn Garra de Águila en Cima del Trueno.‡Collecter 6 Plumes d\'azur et 6 Plumes de bronze et les rapporter à Eyahn Eagletalon à Thunder Bluff.‡收集6根碧蓝色的羽毛和6根古铜色的羽毛，把它们交给雷霆崖的伊恩·鹰爪。‡收集6根碧藍色的羽毛和6根古銅色的羽毛，把它們交給雷霆崖的伊恩·鷹爪。',
  }
},
[745] = {
  {
    'Dividindo a terra‡Недобрые соседи‡Gemeinsame Nutzung des Landes‡대지의 공유‡Compartir la tierra‡Compartir la tierra‡Partager la terre‡土地之争‡土地之爭',
    nil,
    'Mate 10 Coureiros Jubalba, 8 Esfoladores Jubalba, e 5 Larápios Jubalba, então fale novamente com Baine Casco Sangrento na Aldeia Casco Sangrento.‡Убейте 10 дубильщиков, 8 шкуродеров и 5 браконьеров из стаи Блеклогривов и возвращайтесь к Бейну Кровавому Копыту в деревню Кровавого Копыта.‡Tötet 10 Gerber der Bleichmähnen, 8 Kürschner der Bleichmähnen und 5 Wilderer der Bleichmähnen und kehrt dann zu Baine Bloodhoof in Bloodhoof zurück.‡회색갈기일족 무두장이 10마리와 회색갈기일족 가죽장이 8마리, 회색갈기일족 밀렵꾼 5마리를 처치한 다음 블러드후프 마을에 있는 바인 블러드후프에게 돌아가십시오.‡Mata a 10 peleteros, 8 desolladores y 5 furtivos Crines Pálidos y vuelve al Poblado Pezuña de Sangre para hablar con Baine Pezuña de Sangre.‡Mata a 10 curtidores, 8 desolladores y 5 furtivos Crines Pálidas y vuelve al Poblado Pezuña de Sangre para hablar con Baine Pezuña de Sangre.‡Tuer 10 Tanneurs crins-pâles, 8 Ecorcheurs crins-pâles et 5 Braconniers crins-pâles, puis retourner voir Baine Bloodhoof, au village Bloodhoof.‡杀死10个白鬃制革工、8个白鬃剥皮工和5个白鬃偷猎者，然后回到血蹄村向贝恩·血蹄复命。‡殺死10個白鬃制革工、8個白鬃剝皮工和5個白鬃偷獵者，然後回到血蹄村向貝恩·血蹄復命。',
  }
},
[746] = {
  {
    'Escavação enânica‡Дворфийские делишки‡Zwergen-Buddelei‡드워프 발굴지‡Una excavación de los enanos‡Una excavación de los enanos‡Les fouilles des nains‡矮人的挖掘场‡矮人的挖掘場',
    nil,
    'Recolha 5 Picaretas do Prospector.|nEm uma forja, esmague as Picaretas do Prospector para criar Ferramentas Quebradas.|nLeve 5 Ferramentas Quebradas para Baine Casco Sangrento na Aldeia Casco Sangrento.‡Соберите 5 кирок геолога.|nСломайте их в кузнице.|nОтнесите 5 сломанных инструментов Бейну Кровавому Копыту в деревню Кровавого Копыта.‡Sammelt 5 Ausgrabungsleiterhacken ein.|nZerschlagt die Ausgrabungsleiterhacken in einer Schmiede, um zerbrochene Werkzeuge zu erhalten.|nBringt Baine Bloodhoof in Bloodhoof 5 zerbrochene Werkzeuge.‡발굴조사단장의 곡괭이 5개를 모아야 합니다.|n가열로에서 발굴조사단장의 곡괭이를 부러진 곡괭이로 만들어야 합니다.|n블러드후프 마을에 있는 바인 블러드후프에게 부러진 곡괭이 5개를 가져가야 합니다.‡Recoge 5 picos de prospector.|nBusca una forja para destrozar los picos.|nLleva 5 trozos de herramienta rota a Baine Pezuña de Sangre al Poblado Pezuña de Sangre.‡Recoge 5 picos de prospector.|nBusca una forja para destrozar los picos.|nLleva 5 trozos de herramienta rota a Baine Pezuña de Sangre al Poblado Pezuña de Sangre.‡Collecter 5 Piolets de prospecteur.|nÀ la forge, brisez les Piolets du prospecteur pour obtenir des Outils cassés.|nRapporter 5 Outils cassés à Baine Bloodhoof, au village Bloodhoof.‡收集5个勘察员的锄头。|n在铁匠铺砸碎这些勘察员的锄头。|n把5件损坏的工具交给血蹄村的贝恩·血蹄。‡收集5個勘察員的鋤頭。|n在鐵匠鋪砸碎這些勘察員的鋤頭。|n把5件損壞的工具交給血蹄村的貝恩·血蹄。',
  }
},
[747] = {
  {
    'A caçada começa‡Охота начинается‡Die Jagd beginnt‡사냥의 시작‡Empieza la caza‡Empieza la caza‡La chasse commence‡开始狩猎‡開始狩獵',
    nil,
    'Grull Vento do Falcão na Aldeia Narache quer que você lhe traga 7 Penas de Pinote e 7 pedaços de Carne de Pinote.‡Принесите 7 перьев равнинных долгоногов и 7 кусков мяса равнинных долгоногов Груллу Соколиному Ветру.‡Grull Hawkwind im Camp Narache möchte, dass Ihr ihm 7 Ebenenschreiterfedern und 7 Stücke Ebenenschreiterfleisch bringt.‡나라체 야영지에 있는 그룰 호크윈드가 초원타조 깃털 7개와 초원타조 고기 7덩이를 가져다 달라고 부탁했습니다.‡Grull Alalcón quiere que le lleves 7 plumas y 7 piezas de carne de zancudo de llanura al Campamento Narache.‡Grull Viento de Halcón quiere que le lleves 7 plumas y 7 piezas de carne de zancudo de llanura al Campamento Narache.‡Grull Hawkwind, à Camp Narache voudrait que vous lui apportiez 7 Plumes de trotteurs des plaines et 7 morceaux de Viande de trotteur des plaines.‡纳拉其营地的格鲁尔·鹰风要求你带给他7片平原陆行鸟的羽毛和7块平原陆行鸟肉。‡納拉其營地的格魯爾·鷹風要求妳帶給他7片平原陸行鳥的羽毛和7塊平原陸行鳥肉。',
  }
},
[748] = {
  {
    'Água venenosa‡Отравленная вода‡Vergiftetes Wasser‡오염된 우물‡Pozos envenenados‡Pozos envenenados‡Eau empoisonnée‡毒水‡毒水',
    nil,
    'Leve 6 Patas de Lobos-da-pradaria e 4 Garras de Pinotes para Mull Chifre Troante em Casco Sangrento.‡Принесите 6 лап койотов и 4 когтя равнинного долгонога Муллу Громовому Рогу в деревню Кровавого Копыта.‡Bringt Mull Thunderhorn in Bloodhoof 6 Präriewolftatzen und 4 Ebenenschreiterkrallen.‡블러드후프에 있는 멀 썬더혼에게 초원늑대 앞발 6개와 초원타조 갈퀴발톱 4개를 가져가야 합니다.‡Lleva 6 zarpas de lobo de pradera y 4 espolones de zancudo de llanura a Mull Astatrueno al Poblado Pezuña de Sangre.‡Lleva 6 zarpas de lobo de pradera y 4 garfas de zancudo de llanura a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Apporter 6 Pattes de loup des prairies et 4 Serres de trotteur des plaines à Mull Thunderhorn à Bloodhoof.‡收集6只草原狼的爪子和4只平原陆行鸟的爪子，把它们交给血蹄村的穆尔·雷角。‡收集6只草原狼的爪子和4只平原陸行鳥的爪子，把它們交給血蹄村的穆爾·雷角。',
  }
},
[749] = {
  {
    'A caravana devastada‡Разграбленный караван‡Die überfallene Karawane‡습격당한 짐마차 행렬‡La caravana devastada‡La Caravana Devastada‡La Caravane dévastée‡被破坏的货车‡被破壞的貨車',
    nil,
    'Morin Espreita Nuvem quer que você examine o conteúdo de uma caixa de suprimentos na Caravana Devastada.‡Морин Ловец Облаков попросил вас изучить содержимое ящиков с припасами в разграбленном караване.‡Morin Cloudstalker möchte, dass Ihr den Inhalt einer Nachschubkiste der überfallenen Karawane untersucht.‡모린 클라우드스토커가 습격당한 짐마차 행렬에 실려 있는 보급상자의 내용물을 확인해 달라고 부탁했습니다.‡Morin Acechanubes quiere que registres las cajas de la caravana quemada.‡Morin Acechanubes quiere que registres las cajas de la Caravana Devastada.‡Examiner le contenu d\'une caisse de provisions à la caravane dévastée, pour Morin Cloudstalker.‡摩林·云行者要你去查看被破坏的货车附近的储备箱里有什么东西。‡摩林·雲行者要妳去查看被破壞的貨車附近的儲備箱裏有什麽東西。',
  }
},
[750] = {
  {
    'A caçada continua‡Охота продолжается‡Die Jagd geht weiter‡계속되는 사냥‡La caza sigue‡La caza sigue‡La chasse continue‡继续狩猎‡繼續狩獵',
    nil,
    'Grull Vento do Falcão na Aldeia Narache quer que você lhe traga 10 Pelagens de Puma da Montanha.‡Принесите 10 шкур горных пум Груллу Соколиному Ветру.‡Grull Hawkwind im Camp Narache möchte, dass Ihr ihm 10 Bergpumapelze bringt.‡나라체 야영지의 그룰 호크윈드가 산지퓨마 모피 10필을 가져다 달라고 부탁했습니다.‡Grull Alalcón quiere que le lleves 10 pieles de puma montés al Campamento Narache.‡Grull Viento de Halcón quiere que le lleves 10 pelambres de puma montés al Campamento Narache.‡Grull Hawkwind, à Camp Narache, voudrait que vous lui apportiez 10 Peaux de puma des montagnes.‡纳拉其营地的格鲁尔·鹰风要求你带给他10张山狮皮。‡納拉其營地的格魯爾·鷹風要求妳帶給他10張山獅皮。',
  }
},
[751] = {
  {
    'A caravana devastada‡Разграбленный караван‡Die überfallene Karawane‡습격당한 짐마차 행렬‡La caravana devastada‡La Caravana Devastada‡La Caravane dévastée‡被破坏的货车‡被破壞的貨車',
    nil,
    'Entregue os Documentos da Empreendimentos S.A. para Morin Espreita Nuvem perto da Aldeia Casco Sangrento.‡Отнесите бумаги Торговой компании Морину Ловцу Облаков, которого можно найти неподалеку от Деревни Кровавого Копыта.‡Bringt Morin Cloudstalker in der Nähe von Bloodhoof die Dokumente der Venture Company.‡블러드후프 마을 근처에 있는 모린 클라우드스토커에게 투자개발회사의 문서를 가져가야 합니다.‡Lleva los documentos de Ventura y Cía. a Morin Acechanubes cerca del Poblado Pezuña de Sangre.‡Lleva los documentos de Ventura y Cía. a Morin Acechanubes cerca del Poblado Pezuña de Sangre.‡Rapporter les Documents de la KapitalRisk à Morin Cloudstalker, à côté du village Bloodhoof.‡把风险投资公司文件交给血蹄村附近的摩林·云行者。‡把風險投資公司文件交給血蹄村附近的摩林·雲行者。',
  }
},
[752] = {
  {
    'Uma humilde tarefa‡Скромная просьба‡Eine bescheidene Bitte‡작은 부탁‡Una humilde contribución‡Una humilde contribución‡Une humble contribution‡一件琐事‡壹件瑣事',
    nil,
    'Chefe Vento do Falcão quer que você procure a mãe dele perto do poço a sudeste da Aldeia Narache.‡Поищите матушку вождя Соколиный Ветер у источника к юго-востоку от Лагеря Нараче.‡Häuptling Hawkwind möchte, dass Ihr seine Mutter beim Brunnen südöstlich vom Camp Narache sucht.‡족장 호크윈드가 나라체 야영지 남동쪽에 있는 우물 근처에서 그의 어머니를 찾아봐 달라고 부탁했습니다.‡El Jefe Viento de Halcón quiere que vayas a buscar a su madre cerca del pozo que hay al sureste del Campamento Narache.‡El Jefe Viento de Halcón quiere que vayas a buscar a su madre cerca del pozo que hay al sureste del Campamento Narache.‡Partir chercher la mère du Chef Hawkwind, près du puits, au sud-est de Camp Narache.‡鹰风酋长要求你去纳拉其营地东南方的水井处寻找他的母亲。‡鷹風酋長要求妳去納拉其營地東南方的水井處尋找他的母親。',
  }
},
[753] = {
  {
    'Uma humilde tarefa‡Скромная просьба‡Eine bescheidene Bitte‡작은 부탁‡Una humilde contribución‡Una humilde contribución‡Une humble contribution‡一件琐事‡壹件瑣事',
    nil,
    'Pegue uma Jarra d\'Água do poço.|nLeve a Jarra para o Chefe Vento do Falcão na Aldeia Narache, que fica a noroeste do poço.‡Наберите кувшин воды из колодца.|nОтнесите кувшин вождю Соколиному Ветру в Лагерь Нараче, который находится к северо-западу от источника.‡Holt eine Wasserkanne vom Wasserbrunnen.|nBringt die Kanne Häuptling Hawkwind im Camp Narache, das nordwestlich des Wasserbrunnens liegt.‡우물에 있는 물병을 집어서 우물에서 북서쪽에 있는 나라체 야영지의 족장 호크윈드에게 가져가야 합니다.‡Llena un cántaro de agua en el pozo.|nLlévaselo al Jefe Viento de Halcón al Campamento Narache, que está al noroeste del pozo.‡Llena un cántaro de agua en el pozo.|nLlévaselo al Jefe Viento de Halcón al Campamento Narache, que está al noroeste del pozo.‡Prendre une Cruche d\'eau du puits.|nApporter la cruche au Chef Hawkwind, à Camp Narache, au nord-ouest du puits.‡在井边拿一只水罐。|n把它带给纳拉其营地里的鹰风酋长。‡在井邊拿壹只水罐。|n把它帶給納拉其營地裏的鷹風酋長。',
  }
},
[754] = {
  {
    'A purificação de Casco Invernal‡Очищение колодца Заиндевевшего Копыта‡Säuberung von Winterhoof‡윈터후프 정화‡La purificación de Pezuña Invernal‡La purificación de Pezuña Invernal‡Purification de Winterhoof‡净化冰蹄之井‡凈化冰蹄之井',
    nil,
    'Use o Totem de Purificação Casco Invernal no Poço Casco Invernal, então fale novamente com Mull Chifre Troante.‡Очистите колодец Заиндевевшего Копыта с помощью тотема очищения и возвращайтесь к Муллу Громовому Рогу.‡Benutzt das Säuberungstotem von Winterhoof beim Wasserbrunnen von Winterhoof und kehrt dann zu Mull Thunderhorn zurück.‡윈터후프 우물에서 윈터후프 정화의 토템상을 사용한 후 멀 썬더혼에게 돌아가야 합니다.‡Usa el tótem purificador en el Pozo de agua Pezuña Invernal y ve a ver a Mull Astatrueno.‡Usa el tótem de limpieza en el Pozo Pezuña Invernal y ve a ver a Mull Tronacuerno.‡Utiliser le Totem de purification de Winterhoof au puits Winterhoof, puis retourner voir Mull Thunderhorn.‡用冰蹄之井净化图腾为冰蹄之井完成净化，然后回来见穆尔·雷角。‡用冰蹄之井凈化圖騰為冰蹄之井完成凈化，然後回來見穆爾·雷角。',
  }
},
[755] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les Rites de la Terre-mère‡大地之母仪祭‡大地之母儀祭',
    nil,
    'Vá ao Vidente Grislíngua que mora nas colinas ao sul da Aldeia Narache.‡Отправьтесь к провидцу Серой Пасти, который живет на юге от Лагеря Нараче.‡Begebt Euch zu Seher Graytongue, der in den Hügeln direkt südlich des Lagers Narache lebt.‡나라체 야영지 정남쪽에 있는 언덕에 사는 예언자 그레이텅을 찾아가야 합니다.‡Ve a ver al profeta Lenguagris, que vive en las colinas al sur del Campamento Narache.‡Ve a ver al vidente Lenguagris, que vive en las colinas al sur del Campamento Narache.‡Aller voir le Prophète Graytongue qui vit dans les collines au sud de Camp Narache.‡找到居住在纳拉其营地正南方山中的灰舌先知。‡找到居住在納拉其營地正南方山中的灰舌先知。',
  }
},
[756] = {
  {
    'Totem de Chifre Troante‡Тотем Громового Рога‡Thunderhorn-Totem‡썬더혼 토템상‡El tótem de Tronacuerno‡El tótem de Tronacuerno‡Le Totem de Thunderhorn‡雷角图腾‡雷角圖騰',
    nil,
    'Leve 6 Garras de Espreitador e 6 Garras de Puma para Mull Chifre Troante.‡Принесите 6 когтей охотников прерий и 6 когтей пум плоскогорья Муллу Громовому Рогу.‡Bringt Mull Thunderhorn 6 Pirscherklauen und 6 Pumaklauen.‡멀 썬더혼에게 긴발톱 초원늑대 발톱 6개와 평원퓨마 발톱 6개를 가져가야 합니다.‡Lleva 6 garras de acechador y 6 garras de puma a Mull Astatrueno.‡Lleva 6 garras de acechador y 6 garras de puma a Mull Tronacuerno.‡Rapporter 6 Griffes de Traqueur et 6 Griffes de puma à Mull Thunderhorn.‡收集6个草原捕食者的爪子和6个平原狮的爪子，把它们带给穆尔·雷角。‡收集6個草原捕食者的爪子和6個平原獅的爪子，把它們帶給穆爾·雷角。',
  }
},
[757] = {
  {
    'Rito de força‡Обряд Силы‡Ritus der Kraft‡힘의 의식‡Rito de la fuerza‡Rito de la fuerza‡Le Rite de force‡力量仪祭‡力量儀祭',
    nil,
    'Mate alguns Costagulha na Ravina da Lâmina Espinhenta e leve 12 Cintos de Costagulha para o Chefe Vento do Falcão na Aldeia Narache.‡Убивайте дыбогривов в Ежевичной лощине и принесите 12 их поясов вождю Соколиному Ветру в Лагерь Нараче.‡Tötet die Borstennacken in der Dornrankenklamm und bringt Häuptling Hawkwind im Camp Narache 12 Gürtel der Borstennacken.‡칼날가시 협곡에 있는 뾰족털일족들을 처치하고 나라체 야영지에 있는 족장 호크윈드에게 뾰족털일족 허리띠 12개를 가져가야 합니다.‡Mata Erizapúas en Barranco Cortazarza y lleva 12 de sus cinturones al Jefe Vientaguilar al Campamento Narache.‡Mata a varios Erizapúas en el Barranco Cortazarza y lleva 12 cinturones Erizapúas al Jefe Viento de Halcón al Campamento Narache.‡Tuer des Dos-hirsute dans le Ravin de Roncelame et apporter 12 Ceintures de Dos-hirsute au chef Hawkwind au camp Narache.‡杀掉刺刃峡谷的刺背野猪人并带回12条刺背腰带，把它们交给纳拉其营地的鹰风酋长。‡殺掉刺刃峽谷的刺背野豬人並帶回12條刺背腰帶，把它們交給納拉其營地的鷹風酋長。',
  }
},
[758] = {
  {
    'Purificação de Chifre Troante‡Очищение колодца Громового Рога‡Säuberung von Thunderhorn‡썬더혼 정화‡La purificación de Tronacuerno‡La purificación de Tronacuerno‡Purification de Thunderhorn‡净化雷角之井‡凈化雷角之井',
    nil,
    'Use o Totem de Purificação Chifre Troante no Poço Chifre Troante, então fale novamente com Mull.‡Очистите колодец Громового Рога на севере от деревни с помощью тотема очищения и возвращайтесь к Муллу Громовому Рогу.‡Benutzt dasSäuberungstotem von Thunderhorn beim Wasserbrunnen von Thunderhorn und kehrt dann zu Mull zurück.‡썬더혼 우물에서 썬더혼 정화의 토템상을 사용하십시오. 그런 다음 멀 썬더혼에게 돌아가야 합니다.‡Usa el tótem de limpieza en el Pozo Tronacuerno y ve a ver a Mull Tronacuerno.‡Usa el tótem de limpieza en el Pozo Tronacuerno y ve a ver a Mull Tronacuerno.‡Utilisez le Totem de purification de Thunderhorn au puits Thunderhorn, puis retournez voir Mull.‡在雷角之井使用雷角之井净化图腾，然后回来见穆尔。‡在雷角之井使用雷角之井凈化圖騰，然後回來見穆爾。',
  }
},
[759] = {
  {
    'Totem de Juba Agreste‡Тотем Буйногривых‡Wildmane-Totem‡와일드메인 토템상‡El tótem Ferocrín‡El tótem Ferocrín‡Le Totem de Wildmane‡蛮鬃图腾‡蠻鬃圖騰',
    nil,
    'Leve 8 Dentes de Lobos-da-pradaria alfas para Mull Chifre Troante na Aldeia Casco Sangrento.‡Отнесите 8 зубов могучего волка прерий Муллу Громовому Рогу в Деревню Кровавого Копыта.‡Bringt Mull Thunderhorn in Bloodhoof 8 Präriealphazähne.‡블러드후프 마을에 있는 멀 썬더혼에게 우두머리 초원늑대 이빨 8개를 가져가야 합니다.‡Lleva 8 dientes de alfa de pradera a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Lleva 8 dientes de alfa de pradera a Mull Tronacuerno al Poblado Pezuña de Sangre.‡Apporter 8 Dents de loup alpha des prairies à Mull Thunderhorn, au village Bloodhoof.‡收集8颗草原狼前锋的牙齿，把它们交给血蹄村的穆尔·雷角。‡收集8顆草原狼前鋒的牙齒，把它們交給血蹄村的穆爾·雷角。',
  }
},
[760] = {
  {
    'Purificação de Juba Agreste‡Очищение колодца Буйногривых‡Säuberung von Wildmane‡와일드메인 정화‡La purificación de Bravacrín‡La purificación de Ferocrín‡Purification de Wildmane‡净化蛮鬃之井‡凈化蠻鬃之井',
    nil,
    'Use o Totem de Purificação Juba Agreste no Poço Juba Agreste, então fale novamente com Mull Chifre Troante.‡Очистите колодец Буйногривых с помощью тотема очищения и возвращайтесь к Муллу Громовому Рогу.‡Benutzt das Säuberungstotem von Wildmane beim Wasserbrunnen von Wildmane und kehrt dann zu Mull Thunderhorn zurück.‡와일드메인 우물에서 와일드메인 정화의 토템상을 사용한 다음 멀 썬더혼에게 돌아가야 합니다.‡Usa el tótem purificador en el Pozo Bravacrín y ve a ver a Mull Astatrueno.‡Usa el tótem de limpieza Ferocrín en el Pozo Ferocrín y ve a ver a Mull Tronacuerno.‡Utiliser le Totem de purification de Wildmane au puits Wildmane, puis retournez voir Mull Thunderhorn.‡在蛮鬃之井使用蛮鬃之井净化图腾，然后回来见穆尔·雷角。‡在蠻鬃之井使用蠻鬃之井凈化圖騰，然後回來見穆爾·雷角。',
  }
},
[761] = {
  {
    'Caçada ao rapineiro‡Охота на перепелятников‡Sturzfliegerjagd‡검독수리 사냥‡La caza de los aguilones‡La caza de los aguilones‡Chasse aux Rapaces‡猎捕猛鹫‡獵捕猛鷲',
    nil,
    'Leve 8 Troféus de Cálamo de Rapineiro para Harken Totem do Vento na Aldeia Casco Sangrento.‡Принесите 8 трофейных перьев перепелятника Харкену Тотему Ветра в Деревне Кровавого Копыта.‡Bringt Harken Windtotem in Bloodhoof 8 Trophäen-Sturzfliegerkiele.‡블러드후프 마을에 있는 하큰 윈드토템에게 검독수리 깃털 8개를 가져가야 합니다.‡Lleva 8 plumas trofeo de aguilón a Harken Vientótem al Poblado Pezuña de Sangre.‡Lleva 8 péñolas trofeo de aguilón a Harken Tótem de Viento al Poblado Pezuña de Sangre.‡Apporter 8 Trophées de plumes de Rapace à Harken Windtotem, au village Bloodhoof.‡收集8根猛鹫的羽毛，把它们带给血蹄村的哈肯·风之图腾。‡收集8根猛鷲的羽毛，把它們帶給血蹄村的哈肯·風之圖騰。',
  }
},
[762] = {
  {
    'Um embaixador do mal‡Посланник зла‡Ein Botschafter des Bösen‡악의 사자‡Un embajador de mal‡Un embajador del mal‡Un ambassadeur du mal‡邪恶的使者‡邪惡的使者',
    nil,
    'Mate o Embaixador Infernus na Fortaleza Angor e leve a prova de sua morte para o Conselheiro Belgrum em Altaforja.‡Убейте посла Инфернуса в Крепости Ангор и принесите доказательство его смерти советнику Белграму в Стальгорн.‡Tötet den Botschafter Infernus in der Festung Angor und bringt Berater Belgrum in Ironforge einen Beweis seines Tod.‡고통의 요새에 있는 사자 인페르누스를 처치하고 아이언포지에 있는 조언자 벨그룸에게 그의 죽음에 대한 증거를 가져가야 합니다.‡Mata al embajador Infernus en la Fortaleza de Angor llévale la prueba de su muerte al consejero Belgrum en Forjaz.‡Mata al embajador Infernus en la Fortaleza de Angor y llévale la prueba de su muerte al consejero Belgrum en Forjaz.‡Tuer l\'Ambassadeur Infernus, à la Forteresse d\'Angor, et apporter la preuve de sa mort au Conseiller Belgrum à Ironforge.‡杀死苦痛堡垒中的因弗努斯大使，把证明他已死亡的信物交给铁炉堡的顾问贝尔格拉姆。‡殺死苦痛堡壘中的因弗努斯大使，把證明他已死亡的信物交給鐵爐堡的顧問貝爾格拉姆。',
  }
},
[763] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les Rites de la Terre-mère‡大地之母仪祭‡大地之母儀祭',
    nil,
    'Leve o Totem do Vento do Falcão para Baine Casco Sangrento, na Aldeia Casco Sangrento. Siga a estrada que sai da Aldeia Narache.‡Отнесите тотем Соколиного Ветра Бейну Кровавому Копыту в Деревню Кровавого Копыта. Следуйте по дороге из Лагеря Нараче.‡Bringt Baine Bloodhoof in Bloodhoof Hawkwinds Totem. Folgt der Straße, die aus dem Camp Narache herausführt.‡블러드후프 마을에 있는 바인 블러드후프에게 호크윈드의 토템을 가져가야 합니다. 나라체 야영지 외곽의 길을 따라가십시오.‡Lleva el tótem de Alalcón a Baine Pezuña de Sangre al Poblado Pezuña de Sangre. Sigue el camino que sale del Campamento Narache.‡Lleva el tótem de Alalcón a Baine Pezuña de Sangre al Poblado Pezuña de Sangre. Sigue el camino que sale del Campamento Narache.‡Apporter le Totem de Hawkwind à Baine Bloodhoof au village Bloodhoof. Suivre la route hors du camp Narache.‡顺着离开纳拉其营地的路将鹰风图腾带给血蹄村的贝恩·血蹄。‡順著離開納拉其營地的路將鷹風圖騰帶給血蹄村的貝恩·血蹄。',
  }
},
[764] = {
  {
    'Empreendimentos S.A.‡Торговая компания‡Die Venture Company‡투자개발회사‡Los Ventura y Cía.‡Los Ventura y Cía.‡La KapitalRisk‡风险投资公司‡風險投資公司',
    nil,
    'Mate 14 Trabalhadores da Empreendimentos S.A. e 6 Supervisores da Empreendimentos S.A. para Morin Espreita Nuvem na Aldeia Casco Sangrento.‡Убейте 14 рабочих Торговой компании и 6 бригадиров Торговой компании по поручению Морина Ловца Облаков из Деревни Кровавого Копыта.‡Tötet für Morin Cloudstalker in der Nähe von Bloodhoof 14 Tagelöhner der Venture Co. und 6 Vorsteher der Venture Co.‡블러드후프 마을에 있는 모린 클라우드스토커를 위해 투자개발회사 노역꾼 14명과 투자개발회사 현장감독 6명을 처치해야 합니다.‡Mata a 14 trabajadores de Ventura y Cía. y a 6 supervisores de Ventura y Cía. para Morin Acechanubes en Poblado Pezuña de Sangre.‡Mata a 14 trabajadores de Ventura y Cía. y a 6 supervisores de Ventura y Cía. para Morin Acechanubes en Poblado Pezuña de Sangre.‡Tuer 14 Travailleurs de la KapitalRisk et 6 Superviseurs de la KapitalRisk pour Morin Cloudstalker du village Bloodhoof.‡血蹄村的摩林·云行者要你去杀死14个风险投资公司工人和6个风险投资公司主官。‡血蹄村的摩林·雲行者要妳去殺死14個風險投資公司工人和6個風險投資公司主官。',
  }
},
[765] = {
  {
    'Supervisor Geringonça‡Бригадир Шумовик‡Vorsteher Fizsprocket‡감독관 피즈스프로켓‡Supervisor Fizsprocket‡Supervisor Saltatuercas‡Superviseur Fizsprocket‡菲兹普罗克主管‡菲茲普羅克主管',
    nil,
    'Mate o Supervisor Geringonça e leve sua prancheta para Morin Espreita Nuvem na Aldeia Casco Sangrento.‡Убейте бригадира Шумовика и принесите его планшет Морину Ловцу Облаков в Деревню Кровавого Копыта.‡Tötet Vorsteher Fizsprocket und bringt Morin Cloudstalker in der Nähe von Bloodhoof dessen Klemmbrett.‡감독관 피즈스프로켓을 처치하고 블러드후프 마을의 모린 클라우드스토커에게 피즈스프로켓의 서류철을 가져가야 합니다.‡Mata al supervisor Fizsprocket y lleva su sujetapapeles a Morin Acechanubes al Poblado Pezuña de Sangre.‡Mata al supervisor Saltatuercas y lleva su sujetapapeles a Morin Acechanubes al Poblado Pezuña de Sangre.‡Tuer le Superviseur Fizsprocket et rapporter son Ecritoire à Morin Cloudstalker, au village Bloodhoof.‡杀掉菲兹普罗克主管，把他的笔记板带给血蹄村的摩林·云行者。‡殺掉菲茲普羅克主管，把他的筆記板帶給血蹄村的摩林·雲行者。',
  }
},
[766] = {
  {
    'Mazzranache‡Маззранач‡Mazzranache‡마즈라나체‡Mazzranache‡Mazzranache‡Mazzranache‡马兹拉纳其‡馬茲拉納其',
    nil,
    'Leve um Coração de Lobo-da-pradaria, um Fêmur de Puma das Estepes, uma Escama de Pinote e uma Moela de Rapineiro para Maur Clamachuva na Aldeia Casco Sangrento.‡Принесите сердце койота, бедренную кость пумы плоскогорья, чешую долгонога и потроха перепелятника Мауру Заклинателю Дождя в деревню Кровавого Копыта.‡Bringt Maur Raincaller in Bloodhoof ein Herz eines Präriewolfs, einen Knochen eines Flachlandpumas, eine Schuppe eines Ebenenschreiters und einen Muskelmagen eines Sturzfliegers.‡블러드후프 마을에 있는 마우르 레인콜러에게 초원늑대 심장, 평원퓨마 다리뼈, 초원타조 비늘과 검독수리 내장을 가져가야 합니다.‡Lleva 1 corazón de lobo de pradera, 1 fémur de puma de las estepas, escamas de zancudo de llanura y molleja de aguilón a Maur Clamalluvias al Poblado Pezuña de Sangre.‡Lleva un corazón de lobo de pradera, un fémur de puma de las estepas, una escama de zancudo de llanura y una molleja de aguilón a Maur Clamalluvias en el Poblado Pezuña de Sangre.‡Apporter un Coeur de loup des plaines, un Fémur de puma des basses plaines, une Ecaille de trotteur des plaines et un Gésier de rapace à Maur Raincaller, au village Bloodhoof.‡收集草原狼的心脏、平原狮的腿骨、平原陆行鸟的鳞片和猛鹫的胃各一份，把它们交给血蹄村的茂尔·祈雨。‡收集草原狼的心臟、平原獅的腿骨、平原陸行鳥的鱗片和猛鷲的胃各壹份，把它們交給血蹄村的茂爾·祈雨。',
  }
},
[767] = {
  {
    'Rito de Visão‡Обряд прозрения‡Ritus der Sicht‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le Rite de vision‡幻象仪祭‡幻象儀祭',
    nil,
    'Fale com Zarlman Duas Luas na Aldeia Casco Sangrento.‡Поговорите с Зарельманом Две Луны в Деревне Кровавого Копыта.‡Sprecht in Bloodhoof mit Zarlman Two-Moons.‡블러드후프 마을에 있는 잘만 투문과 대화해야 합니다.‡Habla con Zarlman Dos Lunas en el Poblado Pezuña de Sangre.‡Habla con Zarlman Dos Lunas en el Poblado Pezuña de Sangre.‡Parler à Zarlman Deux-Lunes, au village Bloodhoof.‡和血蹄村的扎尔曼·双月谈一谈。‡和血蹄村的紮爾曼·雙月談壹談。',
  }
},
[768] = {
  {
    'Em busca de couro‡Добывание шкур‡Leder sammeln‡가죽 수집‡Recolecta cuero‡Recolecta cuero‡La chasse aux peaux‡收集皮革‡收集皮革',
    nil,
    'Leve 12 peças de Couro Leve a Veren Passo Alto, no Penhasco do Trovão.‡Принесите 12 кусков тонкой кожи Верену Долгоногу в Громовой Утес.‡Bringt Veren Tallstrider in Thunder Bluff 12 Stücke leichtes Leder.‡썬더 블러프에 있는 베렌 톨스트라이더에게 얇은 가죽 12개를 가져가야 합니다.‡Llévale 12 pieles de cuero ligero a Veren Zancaalta a Cima del Trueno.‡Llévale 12 pieles de cuero ligero a Veren Zancaalta a Cima del Trueno.‡Apporter 12 pièces de Cuir léger à Veren Tallstrider, à Thunder Bluff.‡收集12块轻皮，把它们交给雷霆崖的维尔伦·陆行者。‡收集12塊輕皮，把它們交給雷霆崖的維爾倫·陸行者。',
  }
},
[769] = {
  {
    'Bolsa de Pelego de Kodo‡Сумка из шкуры кодо‡Kodobalgtasche‡코도 가죽 자루‡Bolsa de pellejo de kodo‡Bolsa de pellejo de kodo‡Sac en peau de kodo‡科多兽皮包‡科多獸皮包',
    nil,
    'Leve 4 Couros Leves e 4 Fios Grossos a Veren Passo Alto no Penhasco do Trovão.‡Принесите 4 куска легкой кожи и 4 мотка грубой нити Верену Высокому Страннику в Громовой Утес.‡Bringt Veren Tallstrider in Thunder Bluff 4 Einheiten leichtes Leder und 4 grobe Fäden.‡썬더 블러프에 있는 베렌 톨스트라이더에게 얇은 가죽 4개와 굵은 실타래 4개를 가져가야 합니다.‡Llévale 4 pellejos de cuero ligero y 4 hilos gruesos a Veren Zancaalta a Cima del Trueno.‡Llévale 4 pellejos de cuero ligero y 4 hilos gruesos a Veren Zancaalta a Cima del Trueno.‡Apporter 4 pièces de Cuir léger et 4 Bobines de fil grossier à Veren Tallstrider, à Thunder Bluff.‡给雷霆崖的维尔伦·陆行者带去4块轻皮和4份粗线。‡給雷霆崖的維爾倫·陸行者帶去4塊輕皮和4份粗線。',
  }
},
[770] = {
  {
    'O manto marcado por demônios‡Поцарапанный демоном плащ‡Der Dämonennarbenumhang‡악마의 흔적이 남은 가죽망토‡La capa del demonio marcado‡La capa del demonio marcado‡La Cape de démon balafrée‡恶魔之伤‡惡魔之傷',
    nil,
    'Encontre alguém que saiba do Uivo Fantasma.‡Отыщите кого-нибудь, кто слышал о Призрачном Вое.‡Sucht jemanden, der etwas über Geistheuler weiß.‡유령울음늑대에 대해 아는 이를 찾아야 합니다.‡Busca a alguien que conozca a Aullido Fantasma.‡Busca a alguien que conozca a Aullido Fantasma.‡Trouver quelqu\'un qui puisse vous en apprendre davantage au sujet du Hurleur fantomatique.‡去打听打听谁听说过鬼嚎。‡去打聽打聽誰聽說過鬼嚎。',
  }
},
[771] = {
  {
    'Rito de visão‡Обряд прозрения‡Ritus der Sicht‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le Rite de vision‡幻象仪祭‡幻象儀祭',
    nil,
    'Colha 2 Pedras de Poço e 2 Pinhâmbar e leve-as para Zarlman Duas Luas na Aldeia Casco Sangrento.‡Принесите 2 камня у источника и 2 янтарных семени Зарельману Две Луны в Деревню Кровавого Копыта.‡Sammelt 2 Quellsteine und 2 Bernsteinkörner und bringt sie Zarlman Two-Moons in Bloodhoof.‡우물돌 2개와 대지열매 2개를 모아 블러드후프 마을에 있는 잘만 투문에게 가져가야 합니다.‡Lleva 2 piedras de pozo y 2 bellotas ámbar a Zarlman Dos Lunas al Poblado Pezuña de Sangre.‡Lleva 2 piedras de pozo y 2 bellotas ámbar a Zarlman Dos Lunas al Poblado Pezuña de Sangre.‡Collecter 2 Pierres de puits et 2 Pommes de pin et les rapporter à Zarlman Deux-Lunes, au village Bloodhoof.‡收集2块水井石和2个琥珀颗粒，把它们带给血蹄村的扎尔曼·双月。‡收集2塊水井石和2個琥珀顆粒，把它們帶給血蹄村的紮爾曼·雙月。',
  }
},
[772] = {
  {
    'Rito de visão‡Обряд прозрения‡Ritus der Sicht‡예언의 의식‡Rito de la Visión‡Rito de la Visión‡Le Rite de vision‡幻象仪祭‡幻象儀祭',
    nil,
    'Beba a Água dos Videntes em frente à fogueira tribal na Aldeia Casco Sangrento e siga a visão quando ela aparecer.‡Выпейте воду Провидцев перед костром племени в Деревне Кровавого Копыта и следуйте за видением.‡Trinkt vor dem Stammesfeuer in Bloodhoof das Wasser der Seher und folgt der Vision, sobald sie erscheint.‡블러드후프 마을에 있는 부족의 불 앞에서 예언의 물을 마시고 나타나는 예언을 따라가야 합니다.‡Bebe el Agua de los Visionarios frente a la hoguera tribal del Poblado Pezuña de Sangre y sigue a la visión cuando aparezca.‡Bebe el Agua de los Videntes frente a la hoguera tribal del Poblado Pezuña de Sangre y sigue a la visión cuando aparezca.‡Consommer l\'Eau des Prophètes devant le feu tribal, au village Bloodhoof et suivre la vision quand elle apparaîtra.‡在血蹄村的部族之火前将先知之水喝下，当幻象出现之后跟随它。‡在血蹄村的部族之火前將先知之水喝下，當幻象出現之後跟隨它。',
  }
},
[773] = {
  {
    'Rito de sabedoria‡Обряд мудрости‡Ritus der Weisheit‡지혜의 의식‡Rito de la Sabiduría‡Rito de la Sabiduría‡Le Rite de sagesse‡智慧仪祭‡智慧儀祭',
    nil,
    'Siga para o Rochedo Vermelho, a leste do Penhasco do Trovão, e procure o Espírito Ancestral.‡Отправляйтесь в Красные Скалы на востоке от Громового Утеса и поговорите с духом предков.‡Reist von Thunder Bluff gen Osten zu den Teufelsfelsen und sprecht mit dem Vorfahrengeist.‡썬더 블러프 동쪽에 있는 붉은 바위 언덕으로 가서 고대의 영혼과 대화해야 합니다.‡Ve a Roca Roja, al este de Cima del Trueno, y busca al espíritu ancestral.‡Ve a Roca Roja, al este de Cima del Trueno, y busca al espíritu ancestral.‡Voyager aux Rochers rouges, à l\'est de Thunder Bluff et parler à Esprit ancestral.‡到雷霆崖东边的赤色石去和先祖之魂谈一谈。‡到雷霆崖東邊的赤色石去和先祖之魂談壹談。',
  }
},
[774] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    nil,
  }
},
[775] = {
  {
    'Siga para o Penhasco do Trovão‡Путешествие в Громовой Утес‡Reise nach Thunder Bluff‡썬더 블러프로의 여정‡Viaje a Cima del Trueno‡Viaje a Cima del Trueno‡Voyage à Thunder Bluff‡雷霆崖之旅‡雷霆崖之旅',
    nil,
    'Fale com Caerne Casco Sangrento no Penhasco do Trovão.‡Поговорите с Кэрном Кровавым Копытом в Громовом Утесе.‡Sprecht in Thunder Bluff mit Cairne Bloodhoof.‡썬더 블러프에 있는 케른 블러드후프와 대화해야 합니다.‡Habla con Cairne Pezuña de Sangre en Cima del Trueno.‡Habla con Cairne Pezuña de Sangre en Cima del Trueno.‡Parler à Cairne Bloodhoof à Thunder Bluff.‡和雷霆崖的凯恩·血蹄谈一谈。‡和雷霆崖的凱恩·血蹄談壹談。',
  }
},
[776] = {
  {
    'Ritos da Mãe Terra‡Обряды Матери-Земли‡Riten der Erdenmutter‡대지모신의 의식‡Los ritos de la Madre Tierra‡Los ritos de la Madre Tierra‡Les Rites de la Terre-mère‡大地之母仪祭‡大地之母儀祭',
    nil,
    'Caerne Casco Sangrento, no Penhasco do Trovão, quer que você leve para ele o Chifre de Arra\'chea.‡Кэрн Кровавый Рог из Громового Утеса попросил принести ему рог Арра\'чеи.‡Cairne Bloodhoof in Thunder Bluff möchte, dass Ihr ihm das Horn von Arra\'chea bringt.‡썬더 블러프에 있는 케른 블러드후프가 알라치아의 뿔을 가져다 달라고 부탁했습니다.‡Cairne Pezuña de Sangre de Cima del Trueno quiere que le lleves el cuerno de Arra\'chea.‡Cairne Pezuña de Sangre de Cima del Trueno quiere que le lleves el cuerno de Arra\'chea.‡Apporter la Corne d\'Arra\'chea à Cairne Bloodhoof, à Thunder Bluff‡雷霆崖的凯恩·血蹄要你将阿兰其亚的角带给他。‡雷霆崖的凱恩·血蹄要妳將阿蘭其亞的角帶給他。',
  }
},
[777] = {
  {
    'Isso vai ser difícil!‡Сложная задача‡Das wird schwierig‡불길한 예감‡Lo tienes crudo‡Lo tienes crudo‡Grandes difficultés‡不祥的感觉‡不祥的感覺',
    nil,
    'Leve a Engrenagem Nº 5 para Lotwil Viriato.‡Принесите зубец #5 Лотвилу Вериатусу.‡Bringt Lotwil Veriatus ein Zahnrad Nr. 5.‡로트윌 베리아투스에게 5번 기어를 가져가야 합니다.‡Llévale un piñón del n.º 5 a Lotwil Veriatus.‡Llévale un piñón del n.º 5 a Lotwil Veriatus.‡Apporter le Rouage N°5 à Lotwil Veriatus.‡把5号齿轮交给鲁特维尔·沃拉图斯。‡把5號齒輪交給魯特維爾·沃拉圖斯。',
  }
},
[778] = {
  {
    'Isso vai ser difícil!‡Сложная задача‡Das wird schwierig‡불길한 예감‡Lo tienes crudo‡Lo tienes crudo‡Ça promet d\'être dur‡不祥的感觉‡不祥的感覺',
    nil,
    'Derrote o Guardião Fam\'retor e devolva os Grilhões de Laço Elemental do Lotwil para Lotwil Viriato.‡Победите Стража Фам\'ретора и верните оковы Стихий Лотвила Лотвилу Вериатусу.‡Besiegt den Fam\'retor-Wächter und bringt Lotwils Fesseln der Elementarbindung zu Lotwil Veriatus zurück.‡팜레터 수호정령을 물리치고 로트윌 베리아투스에게 로트윌의 정령 봉인 족쇄를 되찾아 가야 합니다.‡Derrota al guardián Fam\'retor y devuélvele los grilletes de vínculo elemental a Lotwil Veriatus.‡Derrota al guardián Fam\'retor y devuélvele los grilletes de vínculo elemental a Lotwil Veriatus.‡Vaincre le Gardien Fam\'retor et rapporter les entraves des élémentaires de Lotwil à Lotwil Veriatus.‡击败法姆雷托守护者，并将鲁特维尔的元素禁锢镣铐交还给鲁特维尔。‡擊敗法姆雷托守護者，並將魯特維爾的元素禁錮鐐銬交還給魯特維爾。',
  }
},
[779] = {
  {
    'O Selo da Terra‡Печать Земли‡Siegel der Erde‡대지의 봉인‡El Sello de la Tierra‡El Sello de la Tierra‡Sceau de la Terre‡大地封印‡大地封印',
    nil,
    nil,
  }
},
[780] = {
  {
    'Os javaliços‡Боевые вепри‡Die Kampfeber‡전투멧돼지‡Los jabaguerreros‡Los jabaguerreros‡Les sangliers de guerre apprivoisés‡斗猪‡鬥豬',
    nil,
    'Grull Vento do Falcão, na Aldeia Narache, quer que você mate Javaliços e leve para ele 8 Focinhos de Javaliço e 8 Flancos de Javaliço.‡Принесите 8 боков и 8 рыл боевых вепрей Груллу Соколиному Ветру.‡Grull Hawkwind im Camp Narache möchte, dass Ihr für ihn Kampfeber tötet und ihm 8 Kampfeberschnauzen und 8 Kampfeberflanken bringt.‡나라체 야영지에 있는 그룰 호크윈드가 전투멧돼지를 처치하고 전투멧돼지 주둥이 8개와 전투멧돼지 갈비살 8점을 가져다 달라고 부탁했습니다.‡Grull Viento de Halcón quiere que le lleves 8 hocicos y 8 costillares de jabaguerrero al Campamento Narache.‡Grull Viento de Halcón quiere que le lleves 8 hocicos y 8 costillares de jabaguerrero al Campamento Narache.‡Grull Hawkwind, à Camp Narache, voudrait que vous tuiez des sangliers de guerre, et que vous rapportiez 8 Groins de sanglier de guerre et 8 Flancs de sanglier de guerre.‡纳拉其营地的格鲁尔·鹰风要求你去干掉斗猪，并带给他4块斗猪头和4块斗猪肋排。‡納拉其營地的格魯爾·鷹風要求妳去幹掉鬥豬，並帶給他4塊鬥豬頭和4塊鬥豬肋排。',
  }
},
[781] = {
  {
    'Aldeia Narache sob ataque‡Нападение на Лагерь Нараче‡Angriff auf Camp Narache‡나라체 야영지에 대한 공격‡Ataque al Campamento Narache‡Ataque al Campamento Narache‡L\'attaque du Camp Narache‡纳拉其营地的危机‡納拉其營地的危機',
    nil,
    'Leve o Plano de Ataque dos Costagulha para o Chefe Vento do Falcão, na Aldeia Narache.‡Отнесите план нападения племени Дыбогривов вождю Соколиному Ветру в Лагерь Нараче.‡Bringt Häuptling Hawkwind im Camp Narache die Angriffspläne der Borstennacken.‡나라체 야영지에 있는 족장 호크윈드에게 뾰족털일족의 작전도를 가져가야 합니다.‡Lleva los planes de ataque Erizapúas al jefe Viento de Halcón al Campamento Narache.‡Lleva los planes de ataque Erizapúas al jefe Viento de Halcón al Campamento Narache.‡Apporter les Plans d\'attaque Dos-hirsute au chef Hawkwind, au camp Narache.‡将刺背野猪人的进攻计划交给纳拉其营地的鹰风酋长。‡將刺背野豬人的進攻計劃交給納拉其營地的鷹風酋長。',
  }
},
[782] = {
  {
    'Alianças rompidas‡Разорванные союзы‡Zerbrochene Allianzen‡깨어진 동맹‡Alianzas rotas‡Alianzas rotas‡Alliances rompues‡破碎的联盟‡破碎的聯盟',
    nil,
    'Mate o Chefe Tho\'grun e leve o Signo da Terra para Gorn, em Karrath.‡Убейте главаря То\'груна и принесите знак Земли Горну в Каргат.‡Tötet Tho\'grun und bringt Gorn in Kargath das Zeichen der Erde.‡우두머리 토그룬을 처치하고 카르가스에 있는 고른에게 대지의 봉인을 가져가야 합니다.‡Mata al jefe Tho\'grun y llévale el Signo de la Tierra a Gorn en Kargath.‡Mata al jefe Tho\'grun y llévale el Signo de la Tierra a Gorn en Kargath.‡Tuer Boss Tho\'grun et rapporter le Signe de la Terre à Gorn, à Kargath.‡杀掉索格伦，把大地印章交给卡加斯的高恩。‡殺掉索格倫，把大地印章交給卡加斯的高恩。',
  }
},
[783] = {
  {
    'A ameaça interna‡Внутренняя угроза‡Die Bedrohung von innen‡내부의 위협‡Una amenaza del interior‡Una amenaza interna‡Menace intérieure‡身边的危机‡身邊的危機',
    nil,
    'Fale com o Major Belmonte.‡Поговорите с маршалом Макбрайдом.‡Sprecht mit Marshal McBride.‡치안대장 맥브라이드와 대화해야 합니다.‡Habla con el alguacil McBride.‡Habla con el alguacil McBride.‡Parler au maréchal McBride.‡与治安官玛克布莱德谈一谈。‡與治安官瑪克布萊德談壹談。',
  }
},
[784] = {
  {
    'Aniquile os invasores‡Бей предателей!‡Vernichtet die Verräter‡배신자 처단‡Vencer a los traidores‡Vencer a los traidores‡Vaincre les traîtres‡背信弃义的人类‡背信棄義的人類',
    nil,
    'Mate 10 Marinheiros de Kul Tiraz, 8 Fuzileiros de Kul Tiraz e o Tenente Bento. Depois, fale novamente com Gar\'Thok no Monte Navalha.‡Убейте 10 моряков Кул-Тираса, 8 стражей бухты Кул-Тираса и лейтенанта Бенедикта и возвращайтесь к Га\'Току на Колючий Холм.‡Tötet 10 Matrosen von Kul Tiras, 8 Marinesoldaten von Kul Tiras sowie Lieutenant Benedict und kehrt dann zu Gar\'Thok in Klingenhügel zurück.‡쿨 티라스 선원 10명과 쿨 티라스 해병 8명, 그리고 부대장 베네딕트를 처치한 다음 칼바위 언덕에 있는 가르톡에게 돌아가십시오.‡Mata a 10 navegantes Kul Tiras, 8 marineros Kul Tiras y al teniente Benedicto. Luego vuelve a buscar a Gar\'Thok a Cerrotajo.‡Mata a 10 navegantes Kul Tiras, 8 marineros Kul Tiras y al teniente Benedict. Luego vuelve a buscar a Gar\'Thok a Cerrotajo.‡Tuer 10 Marins de Kul Tiras, 8 Soldats de marine de Kul Tiras et le Lieutenant Benedict, puis retourner voir Gar\'Thok à Tranchecolline.‡杀死10个库尔提拉斯水手和8个库尔提拉斯水兵，再把本尼迪克上尉干掉，然后回剃刀岭向加索克复命。‡殺死10個庫爾提拉斯水手和8個庫爾提拉斯水兵，再把本尼迪克上尉幹掉，然後回剃刀嶺向加索克復命。',
  }
},
[786] = {
  {
    'Frustrando o ataque dos Kolkar‡Предотвращение агрессии племени Колкар‡Vereitelung der Kolkaraggression‡콜카르일족 침략 저지‡Frustrar la los planes kolkar‡Frustrar los planes kolkar‡Déjouer l\'agression des Kolkar‡科卡尔半人马的进攻‡科卡爾半人馬的進攻',
    nil,
    'Larri Presador, junto à Aldeia Sen\'jin, quer que você destrua 3 Planos de Ataque, que estão no Penedo de Kolkar.‡Лар Ночной Клык из деревни Сен\'джин хочет, чтобы вы уничтожили 3 плана нападения, которые хранятся в лагере кентавров, что в Утесе Колкара.‡Lar Prowltusk außerhalb von Sen\'jin möchte, dass Ihr die 3 Sets der Angriffspläne zerstört, die innerhalb der Kolkarklippe verwahrt werden.‡센진 마을 외곽에 있는 라르 프라울터스크가 콜카르 바윗골에 있는 3개의 공격 계획서를 없애 달라고 부탁했습니다.‡Lar Prowltusk, de las afueras del Poblado Sen\'jin, quiere que destruyas los 3 planes de ataque de Risco Kolkar.‡Lar Colmillo Acechador, de las afueras del Poblado Sen\'jin, quiere que destruyas los 3 planes de ataque de Risco Kolkar.‡Détruire 3 Jeux de Plans d\'attaque dans la combe des Kolkar, pour Lar Prowltusk à l\'extérieur du village de Sen\'jin.‡在森金村外面的拉尔·猎齿要求你粉碎科卡尔峭壁内的三份进攻计划。‡在森金村外面的拉爾·獵齒要求妳粉碎科卡爾峭壁內的三份進攻計劃。',
  }
},
[787] = {
  {
    'A nova Horda‡Новая Орда‡Die neue Horde‡호드 신병‡La nueva Horda‡La nueva Horda‡La nouvelle Horde‡新的部落‡新的部落',
    nil,
    'Apresente-se a Gornek, no Covil.‡Зайти в Логово к Горнеку.‡Meldet Euch bei Gornek beim Höhlenbau.‡동굴 막사에 있는 고르넥과 대화하십시오.‡Preséntate ante Gornek en El Cubil.‡Preséntate ante Gornek en El Cubil.‡Faites un rapport à Gornek, dans l\'Antre‡向大兽穴里的高内克报到。‡向大獸穴裏的高內克報到。',
  }
},
[788] = {
  {
    'Dentes cortantes‡Кабаньи клыки‡Scharfe Zähne‡몸 풀기‡Dientes afilados‡Dientes afilados‡La dent tranchante‡小试身手‡小試身手',
    nil,
    'Mate 10 Mosquetuscos, depois fale novamente com Gornek no Covil.‡Убейте 10 пятнистых вепрей и вернитесь в Логово к Горнеку.‡Tötet 10 scheckige Eber und kehrt dann zu Gornek beim Höhlenbau zurück.‡점박이멧돼지 10마리를 처치한 다음 동굴 막사에 있는 고르넥에게 돌아가십시오.‡Mata a 10 jabalíes jaspeados y vuelve con Gornek en El Cubil.‡Mata a 10 jabalíes jaspeados y vuelve con Gornek en El Cubil.‡Tuer 10 Sangliers tachetés, puis retourner voir Gornek, dans l’Antre.‡杀掉10只杂斑野猪，然后向大兽穴里的高内克报告。‡殺掉10只雜斑野豬，然後向大獸穴裏的高內克報告。',
  }
},
[789] = {
  {
    'A ferroada do escorpídeo‡Жала скорпидов‡Stich des Skorpiden‡전갈의 독침‡Aguijón de escórpido‡Aguijón de escórpido‡L\'aiguillon du scorpide‡工蝎的尾巴‡工蠍的尾巴',
    nil,
    'Leve 10 Caudas de Escorpídeo Operário a Gornek, no Covil.‡Добудьте 10 хвостов рабочих скорпидов и принесите их в Логово Горнеку.‡Bringt 10 Skorpidarbeiterschwänze zu Gornek im Höhlenbau.‡동굴 막사에 있는 고르넥을 위해 일꾼전갈 꼬리 10개를 모아야 합니다.‡Consigue 10 colas de trabajador escórpido para Gornek en El Cubil.‡Consigue 10 colas de escórpido obrero para Gornek en el Cubil.‡Apporter 10 Queues de scorpides ouvriers à Gornek, dans l’Antre.‡给大兽穴中的高内克带回10根工蝎的尾巴。‡給大獸穴中的高內克帶回10根工蠍的尾巴。',
  }
},
[790] = {
  {
    'Sarkoth‡Саркот‡Sarkoth‡사르코스‡Sarkoth‡Sarkoth‡Sarkoth‡萨科斯‡薩科斯',
    nil,
    'Mate Sarkoth e leve a garra dele para Hana\'zua.‡Убейте Саркота и принесите его коготь Хана\'зуа.‡Tötet Sarkoth und bringt seine Klaue zu Hana\'zua.‡사르코스를 처치하고 그의 발톱을 하나주아에게 가져가야 합니다.‡Mata a Sarkoth y llévale su zarpa a Hana\'zua.‡Mata a Sarkoth y llévale su zarpa a Hana\'zua.‡Tuer Sarkoth et rapporter sa pince à Hana\'zua.‡杀死萨科斯并将它的爪子带回去交给哈纳祖。‡殺死薩科斯並將它的爪子帶回去交給哈納祖。',
  }
},
[791] = {
  {
    'Carregue suas tralhas‡Больше сумок – больше добычи!‡Akzeptiert Euer Schicksal‡보급품 조달‡Asume tu responsabilidad‡Asume tu responsabilidad‡Assumer ses responsabilités‡新的背包‡新的背包',
    nil,
    'Férrano Escarnecenho na torre de vigia do Monte Navalha quer 8 Retalhos de Lona.‡Принесите 8 лоскутов холста Фурлу Хмурому Лбу, стоящему на сторожевой башне рядом с Колючим Холмом.‡Furl Scornbrow im Wachturm von Klingenhügel möchte 8 Segeltuchreste haben.‡칼바위 언덕 감시탑에 있는 펄 스콘브로우가 캔버스 천조각 8개를 가져다 달라고 부탁했습니다.‡Furl Ceñosprecio de la atalaya de Cerrotajo quiere 8 retales.‡Furl Ceñosprecio de la Atalaya de Cerrotajo quiere 8 retales.‡Apporter 8 Morceaux de canevas à Furl Scornbrow, dans la la tour de guet de Tranchecolline.‡剃刀岭了望塔中的弗恩·凝眉想要8块帆布脚料。‡剃刀嶺了望塔中的弗恩·凝眉想要8塊帆布腳料。',
  }
},
[792] = {
  {
    'Familiares torpes‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Mate 12 Familiares torpes.|nFale novamente com Zureta Vista-longa em frente ao Covil.‡Убейте 12 злобных фамильяров и вернитесь к Зурите Востроглазой, которая ждет вас у Логова.‡Tötet 12 üble Familiare.|nKehrt dann zu Zureetha Fargaze beim Höhlenbau zurück.‡악마의 하수인 12마리를 처치해야 합니다.|n임무를 완수한 뒤 동굴 막사 바깥에 있는 주리타 파게이즈에게 돌아가십시오.‡Mata a 12 familiares viles.|nVuelve con Zureetha Vistalonga a las puertas de El Cubil.‡Mata a 12 familiares viles.|nRegresa con Zureetha Vistalonga fuera de El Cubil.‡Tuer 12 Vils quasits.|nRetourner voir Zureetha Fargaze, à l’extérieur de l’Antre.‡杀死12只邪灵劣魔，然后向大兽穴外的祖雷萨复命。‡殺死12只邪靈劣魔，然後向大獸穴外的祖雷薩復命。',
  }
},
[793] = {
  {
    'Alianças rompidas‡Разорванные союзы‡Zerbrochene Allianzen‡깨어진 동맹‡Alianzas rotas‡Alianzas rotas‡Alliances rompues‡破碎的联盟‡破碎的聯盟',
    nil,
    'Use o Signo da Terra para ativar os Pilares de Diamante, Opala e Ametista, e pegue as Pedras Rúnicas.|nColoque as pedras rúnicas no Selo da Terra para libertar Neraçoite e Hematus.|nMate-os e entregue as Braçadeiras de Neraçoite, os Grilhões de Hematus e o Signo da Terra para Gorn.‡С помощью знака Земли активируйте алмазный, опаловый и аметистовый столпы и извлеките рунные камни.|nПоместите рунные камни на печать Земли и освободите драконов Бича Тьмы и Гематуса.|nУбейте драконов и принесите Горну наручники Чернохлыста, цепи Гематуса и Знак Земли.‡Benutzt das Zeichen der Erde, um die Säulen aus Diamant, Opal und Amethyst zu aktivieren und die Runensteine zu holen.|nLegt die Runensteine auf das Siegel der Erde, um Schattenbringer und Hematus zu befreien.|nTötet sie und bringt dann Gorn Schattenbringers Bindung, Hematus\' Ketten und das Zeichen der Erde.‡대지의 봉인을 사용하여 다이아몬드, 오팔, 자수정의 기둥을 작동시켜 마법석을 모아야 합니다.|n마법석을 대지의 봉인에 놓아 블랙래쉬와 헤마투스의 봉인을 풀어줘야 합니다.|n블랙래쉬와 헤마투스를 처치하고 고른에게 블랙래쉬의 굴레, 헤마투스의 굴레와 대지의 봉인을 가져가야 합니다.‡Usa el Signo de la Tierra para activar el Pilar de Diamante, el de Ópalo y el de Amatista y así obtener las piedras rúnicas.|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Cinchoscura y a Hematus.|nMátalos y llévale a Gorn las ataduras de Cinchoscura, las cadenas de Hematus y el Signo de la Tierra.‡Usa el Signo de la Tierra para activar el Pilar de diamante, el de ópalo y el de amatista y así obtener las piedras rúnicas.|nColoca las piedras rúnicas en el Sello de la Tierra para liberar a Latigoscuro y a Hematus.|nMátalos y llévale a Gorn las ataduras de Latigoscuro, las cadenas de Hematus y el Signo de la Tierra.‡Utiliser le Signe de la Terre pour activer les Piliers de diamant, d\'opale et d\'améthyste, et obtenir les Pierres runiques.|nPlacer les Pierres runiques dans le Sceau de la Terre pour libérer Cinglenoir et Hematus.|nLes exécuter et rapporter les Liens de Cinglenoir, les Entraves d\'Hematus et le Signe de la Terre à Gorn.‡用大地印章激活钻石柱、玛瑙石柱和紫水晶石柱并拿到三颗符石。|n把符石放在大地封印上，释放黑龙布莱克拉什和赫玛图斯。|n杀了这两条黑龙，把黑龙布莱克拉什的锁链、赫玛图斯的锁链和大地印章交给高恩。‡用大地印章激活鉆石柱、瑪瑙石柱和紫水晶石柱並拿到三顆符石。|n把符石放在大地封印上，釋放黑龍布萊克拉什和赫瑪圖斯。|n殺了這兩條黑龍，把黑龍布萊克拉什的鎖鏈、赫瑪圖斯的鎖鏈和大地印章交給高恩。',
  }
},
[794] = {
  {
    'Medalhão da Lâmina Ardente‡Медальон Пылающего Клинка‡Medaillon der Burning Blade‡불타는칼날단 메달‡El medallón del Filo Ardiente‡El medallón del Filo Ardiente‡Le médaillon de la Lame ardente‡火刃奖章‡火刃獎章',
    nil,
    'Leve o Medalhão da Lâmina Ardente para Zureta Vista-longa em frente ao Covil.‡Принесите медальон Пылающего Клинка Зурите Востроглазой, стоящей у Логова.‡Bringt Zureetha Fargaze beim Höhlenbau das Medaillon der Burning Blade.‡동굴 막사 외부에 있는 주리타 파게이즈에게 불타는칼날단 메달을 가져가야 합니다.‡Lleva el Medallón del Filo Ardiente a Zureetha Vistalonga, a las puertas de El Cubil.‡Lleva el medallón del Filo Ardiente a Zureetha Vistalonga, a las puertas de El Cubil.‡Rapporter le Médaillon de la Lame ardente à Zureetha Fargaze, à l\'extérieur de l\'Antre.‡给大兽穴外的祖雷萨带回火刃奖章。‡給大獸穴外的祖雷薩帶回火刃獎章。',
  }
},
