[5210] = {
  {
    'Irmão Carlin‡Брат Карлин‡Bruder Carlin‡카를린 레드패스‡Carlin, el hermano de Joseph‡Carlin, el hermano de Joseph‡Frère Carlin‡卡林·雷德帕斯‡卡林·雷德帕斯',
    nil,
    'Leve os Anais Estendidos da Vila das Flechas para Carlin Trilharrubra nas Terras Pestilentas Orientais.‡Отнесите дополненные Анналы Дарроушира Карлину Редпату в Восточные Чумные земли.‡Bringt die erweiterten \'Annalen von Darrowshire\' zu Carlin Redpath in den Östlichen Pestländern.‡동부 역병지대에 있는 카를린 레드패스에게 확장된 다로우샤이어 연대기를 가져가야 합니다.‡Lleva las Crónicas ampliadas de Villa Darrow a Carlin Rutagrana a las Tierras de la Peste del Este.‡Lleva las Crónicas ampliadas de Villa Darrow a Carlin Rutagrana a las Tierras de la Peste del Este.‡Apporter les Annales complètes de Darrowshire à Carlin Redpath dans les Maleterres de l’est.‡将《达隆镇全史》交给东瘟疫之地的卡林·雷德帕斯。‡將《達隆鎮全史》交給東瘟疫之地的卡林·雷德帕斯。',
  }
},
[5211] = {
  {
    'Defensores da Vila das Flechas‡Защитники Дарроушира‡Verteidiger von Darrowshire‡다로우샤이어의 병사들‡Los defensores de Villa Darrow‡Los defensores de Villa Darrow‡Défenseurs de Darrowshire‡达隆郡的保卫者‡達隆郡的保衛者',
    nil,
    'Liberte 15 Espíritos da Vila das Flechas e fale novamente com Carlin Trilharrubra.‡Освободите 15 духов Дарроушира и возвращайтесь к Карлину Редпату.‡Befreit 15 Geister von Darrowshire und kehrt dann zu Carlin Redpath zurück.‡15명의 다로우샤이어 주민들의 원혼을 자유롭게 하고 카를린 레드패스에게 돌아가야 합니다.‡Libera a 15 espíritus de Villa Darrow y vuelve con Carlin Rutagrana.‡Libera a 15 espíritus de Villa Darrow y vuelve con Carlin Rutagrana.‡Libérer 15 Esprits de Darrowshire et retourner auprès de Carlin Redpath.‡释放15个达隆郡居民的灵魂，然后返回卡林·雷德帕斯身边。‡釋放15個達隆郡居民的靈魂，然後返回卡林·雷德帕斯身邊。',
  }
},
[5212] = {
  {
    'A carne não mente‡Плоть не лжет‡Das Fleisch lügt nicht‡거짓말하지 않는 육체‡La carne no miente‡La carne no miente‡La chair ne ment pas‡血肉不会撒谎‡血肉不會撒謊',
    nil,
    'Recupere 20 Amostras de Carne Infectada de Stratholme e leve-as para Betina Bigozinco. Você desconfia que qualquer criatura em Stratholme poderia ter essa amostra de carne.‡Принесите 20 препаратов чумной плоти из Стратхольма Бетине Биггльцинк. Предположительно, любая тварь из Стратхольма сойдет за препарат.‡Sammelt 20 verseuchte Fleischproben in Stratholme und bringt sie zu Betina Bigglezink zurück. Ihr vermutet, dass Ihr besagte Fleischproben bei jeder Kreatur in Stratholme finden könnt.‡스트라솔름에서 20개의 역병걸린 살덩어리 견본을 베티나 비글징크에게 가져다주어야 합니다. 스트라솔름의 어떤 생물에서든 살덩어리 견본을 구할 수 있을 것 같습니다.‡Consigue 20 muestras de carne apestadas de Stratholme y llévaselas a Betina Bigglezink. Tienes la sospecha de que podrás obtener ese tipo de carne de cualquier criatura de Stratholme.‡Consigue 20 muestras de carne apestadas de Stratholme y llévaselas a Betina Bigglezink. Tienes la sospecha de que podrás obtener ese tipo de carne de cualquier criatura de Stratholme.‡Récupérer 20 Echantillons de chair pestiférée à Stratholme puis les rapporter à Betina Bigglezink. Vous pensez que toutes les créatures de Stratholme possèdent de tels échantillons de chair.‡从斯坦索姆找回20个瘟疫肉块，并把它们交给贝蒂娜·比格辛克。你觉得斯坦索姆中的生灵都不大可能长着肉……‡從斯坦索姆找回20個瘟疫肉塊，並把它們交給貝蒂娜·比格辛克。妳覺得斯坦索姆中的生靈都不大可能長著肉……',
  }
},
[5213] = {
  {
    'O agente ativo‡Вирус чумы‡Der aktive Wirkstoff‡활성 역병 인자‡El agente activo‡El agente activo‡L\'agent actif‡活跃的探子‡活躍的探子',
    nil,
    'Vá para Stratholme e vasculhe os zigurates. Encontre novos Dados do Flagelo e leve-os para Betina Bigozinco.‡Отправляйтесь в Стратхольм и исследуйте зиккураты. Доставьте сведения о Плети Бетине Биггльцинк.‡Reist nach Stratholme und durchsucht die Ziggurats. Sucht neue Geißeldaten und bringt sie zu Betina Bigglezink zurück.‡스트라솔름으로 가서 지구라트를 조사해야 합니다. 스컬지 자료를 찾아 베티나 비글징크에게 돌아가야 합니다.‡Viaja a Stratholme y busca los zigurats. Encuentra información sobre la Plaga y llévasela a Betina Bigglezink.|n‡Viaja a Stratholme y busca los zigurats. Encuentra información sobre la Plaga y llévasela a Betina Bigglezink.‡Se rendre jusqu’à Stratholme et fouiller les ziggourats. Trouver et ramener de nouvelles informations sur le Fléau à Betina Bigglezink.‡到斯坦索姆去探索那里的通灵塔。找到新的天灾军团档案，把它交给贝蒂娜·比格辛克。‡到斯坦索姆去探索那裏的通靈塔。找到新的天災軍團檔案，把它交給貝蒂娜·比格辛克。',
  }
},
[5214] = {
  {
    'O grande Ezra Carranca‡Великий Эзра Гримм‡Der große Ezra Grimm‡위대한 에즈라 그림‡El gran Ezra Grimm‡El gran Ezra Grimm‡Le grand Ezra Grimm‡了不起的艾兹拉·格里姆‡弗拉斯·希亞比',
    nil,
    'Encontre a tabacaria de Ezra Carranca em Stratholme e recolha uma caixa do Tabaco da Lata do Carranca. Fale novamente com Leandro Leonardo depois que tiver terminado o serviço.‡Найдите табачную лавку Эзры Гримма в Стратхольме, отыщите в ней коробку отличного табака Эзры Гримма и принесите ее Дымку ЛаРу.‡Sucht Ezra Grimms Raucherladen in Stratholme und bergt einen Kasten von Grimms Tollem Tabak. Kehrt zu Smokey LaRue zurück, wenn Eure Aufgabe erledigt ist.‡스트라솔름에서 에즈라 그림의 최고급 담배를 회수하여 스모키 라루에게 가져가야 합니다.‡Encuentra la Tienda de humo de Ezra Grimm en Stratholme y recupera una caja del tabaco de calidad de Grimm. Cuando lo hayas hecho, vuelve con Smokey LaRue.‡Encuentra la Tienda de humo de Ezra Grimm en Stratholme y recupera una caja del tabaco de calidad de Grimm. Cuando lo hayas hecho, vuelve con Smokey LaRue.‡Trouver le magasin de tabac d’Ezra Grimm à Stratholme et récupérer une boîte de Tabac d’Ezra. Retourner auprès de Smokey LaRue quand ce sera fait.‡找到艾兹拉·格里姆在斯坦索姆的烟草店，并从中找回一盒格里姆的优质香烟，把它交给烟鬼拉鲁恩。‡找到弗拉斯·希亞比在斯坦索姆的煙草店，並從中找回壹盒希亞比的煙草，把它交給煙鬼拉魯恩。',
  }
},
[5215] = {
  {
    'Os caldeirões do Flagelo‡Котлы Плети‡Die Geißelkessel‡스컬지 가마솥‡Las calderas de la Plaga‡Las calderas de la Plaga‡Les chaudrons du Fléau‡瘟疫之锅‡瘟疫之鍋',
    nil,
    'Fale com a Alta-sacerdotisa Donélia no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с верховной жрицей Макдонелл на Берегу Промозглого Ветра в Западных Чумных землях.‡Sprecht mit der Hohepriesterin MacDonnell an der Chillwindspitze, Westliche Pestländer.‡서부 역병지대의 서리바람 거점에 있는 대여사제 맥도널과 대화해야 합니다.‡Habla con la suma sacerdotisa MacDonnell en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Habla con la suma sacerdotisa MacDonnell en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Parler à la grande prêtresse MacDonnell à la pointe du Noroît, dans les Maleterres de l’ouest.‡与西瘟疫之地冰风岗的高阶牧师玛多妮尔谈一谈。‡與西瘟疫之地冰風崗的高階牧師瑪多妮爾談壹談。',
  }
},
[5216] = {
  {
    'Alvo: Campo Pedravil‡Цель: поле Джанис‡Ziel: Teufelssteinfeld‡목표: 펠스톤 농장‡Objetivo: Campo de Piedra Mácula‡Objetivo: Campo de Piedramácula‡Cible : le Champ de Felstone‡目标：费尔斯通农场‡目標：費爾斯通農場',
    nil,
    'Vá ao Campo Pedravil nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá. Ele pode ter uma chave que dê acesso ao caldeirão. Você precisa estar com a Garrafa do Campo Pedravil Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на поле Джанис в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Джанис.‡Geht zum Teufelssteinfeld im den Westlichen Pestländern. Sucht nach dem dortigen Kessellord und besiegt ihn. Er könnte einen Schlüssel haben, der den Zugang zu dem Kessel ermöglicht. Ihr müsst die leere Flasche: Teufelssteinfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 펠스톤 농장으로 가서 그곳에 있는 가마솥군주를 찾아 물리치십시오. 가마솥군주가 가마솥으로 통하는 열쇠를 지니고 있을 수도 있습니다. 빈 펠스톤 농장 병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Campo de Piedra Mácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedra Mácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Campo de Piedramácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedramácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Champ de Felstone dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve. Il aura peut-être une clé qui permet d’accéder au chaudron. Il faut se munir de la Bouteille d\'échantillon du Champ de Felstone vide pour pouvoir prélever un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的费尔斯通农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带费尔斯通农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的費爾斯通農場去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶費爾斯通農場的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5217] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Chillwind-Lager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風崗',
    nil,
    'Leve a Garrafa do Campo Pedravil Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с поля Джанис верховной жрице Макдонелл в Лагерь Промозглого Ветра, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Teufelssteinfeld zur Hohepriesterin MacDonnell an der Chillwindspitze, Westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 펠스톤 농장 병을 가져가야 합니다.‡Lleva la Botella rellena del Campo de Piedra Mácula a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la Botella rellena del Campo de Piedramácula a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter une Bouteille du Champ de Felstone remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l’ouest.‡把费尔斯通农场的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把費爾斯通農場的樣本瓶交給西瘟疫之地冰風崗的高階牧師瑪多妮爾。',
  }
},
[5218] = {
  {
    'Caldeirão do Campo Pedravil‡Котел поля Джанис‡Der Kessel des Teufelssteinfelds‡펠스톤 농장 가마솥‡El caldero del Campo de Piedra Mácula‡La caldera del Campo de Piedramácula‡Le Chaudron du champ de Felstone‡费尔斯通农场的瘟疫之锅‡費爾斯通農場的瘟疫之鍋',
    nil,
    nil,
  }
},
[5219] = {
  {
    'Alvo: Lágrimas de Dalson‡Цель: Слезы Далсона‡Ziel: Dalsons Tränenfeld‡목표: 달슨의 눈물‡Objetivo: Llanto de Dalson‡Objetivo: Llanto de Dalson‡Cible : les Larmes de Dalson‡目标：达尔松之泪‡目標：達爾松之淚',
    nil,
    'Vá a Lágrimas de Dalson nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa das Lágrimas de Dalson Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Слезы Далсона в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Слез Далсона.‡Begebt Euch zu Dalsons Tränenfeld in den Westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Dalsons Tränenfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 달슨의 눈물로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 지닌 열쇠를 사용해 가마솥에 접근하십시오. 반드시 달슨의 눈물 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre aux Larmes de Dalson dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, puis utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille des larmes de Dalson vide pour pouvoir prendre un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的达尔松之泪去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带达尔松之泪的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的達爾松之淚去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶達爾松之淚的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5220] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Chillwind-Lager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風崗',
    nil,
    'Leve a Garrafa das Lágrimas de Dalson Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с поля Слез Далсона верховной жрице Макдонелл в Лагерь Промозглого Ветра, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Dalsons Tränenfeld zur Hohepriesterin MacDonnell an der Chillwindspitze, Westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 달슨의 눈물 혼합물을 가져가야 합니다.‡Lleva la Botella rellena del Llanto de Dalson a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la botella del Llanto de Dalson llena a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille des Larmes de Dalson remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l’ouest.‡把达尔松之泪的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把達爾松之淚的樣本瓶交給西瘟疫之地冰風崗的高階牧師瑪多妮爾。',
  }
},
[5221] = {
  {
    'Caldeirão das Lágrimas de Dalson‡Котел Слез Далсона‡Der Kessel von Dalsons Tränenfeld‡달슨의 눈물 가마솥‡El caldero del Llanto de Dalson‡La caldera del Llanto de Dalson‡Chaudron des Larmes de Dalson‡达尔松之泪的瘟疫之锅‡達爾松之淚的瘟疫之鍋',
    nil,
    nil,
  }
},
[5222] = {
  {
    'Alvo: Antro Repelente‡Цель: Удел Страданий‡Ziel: Das trostlose Feld‡목표: 고통의 흉가‡Objetivo: El Tormento‡Objetivo: El Tormento‡Cible : le Repaire putride‡目标：嚎哭鬼屋‡目標：嚎哭鬼屋',
    nil,
    'Vá ao Antro Repelente nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa do Antro Repelente Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Удел Страданий в Западных Чумных землях. Найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с Удела Страданий.‡Begebt Euch zum trostlosen Feld in den Westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Das trostlose Feld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 고통의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 고통의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Repaire putride dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille vide du Repaire putride pour pouvoir récupérer un échantillon des poisons à l’intérieur du chaudron.‡到西瘟疫之地的嚎哭鬼屋去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带嚎哭鬼屋的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的嚎哭鬼屋去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶嚎哭鬼屋的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5223] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Chillwind-Lager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風崗',
    nil,
    'Leve a Garrafa do Antro Repelente Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с Призрачной фермы верховной жрице Макдонелл в Лагерь Промозглого Ветра, в Западные Чумные земли.‡Bringt die gefüllte Flasche: Das trostlose Feld zur Hohepriesterin MacDonnell an der Chillwindspitze, Westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 고통의 흉가 혼합물을 가져가야 합니다.‡Lleva la Botella rellena de El Tormento a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la Botella llena de El Tormento a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille du Repaire putride remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l’ouest.‡把嚎哭鬼屋的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把嚎哭鬼屋的樣本瓶交給西瘟疫之地冰風崗的高階牧師瑪多妮爾。',
  }
},
[5224] = {
  {
    'Caldeirão do Antro Repelente‡Котел Призрачной фермы‡Der Kessel des trostlosen Felds‡고통의 흉가 가마솥‡El caldero de El Tormento‡La caldera de El Tormento‡Le Chaudron du Repaire putride‡嚎哭鬼屋的瘟疫之锅‡嚎哭鬼屋的瘟疫之鍋',
    nil,
    nil,
  }
},
[5225] = {
  {
    'Alvo: Aridez de Garrão‡Цель: пустошь Гаррона‡Ziel: Gahrrons Trauerfeld‡목표: 가론의 흉가‡Objetivo: Gangrena de Gahrron‡Objetivo: Gangrena de Gahrron‡Cible : la Flétrissure de Gahrron‡目标：盖罗恩农场‡目標：蓋羅恩農場',
    nil,
    'Vá a Aridez de Garrão nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa da Aridez de Garrão Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на пустошь Гаррона в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с путоши Гаррона.‡Begebt Euch zu Gahrrons Trauerfeld in den Westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Gahrrons Trauerfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 가론의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 가론의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre à la Flétrissure de Gahrron dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille vide de la Flétrissure de Gahrron pour pouvoir récupérer un échantillon des poisons à l’intérieur du chaudron.‡到西瘟疫之地的盖罗恩农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带盖罗恩农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的蓋羅恩農場去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶蓋羅恩農場的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5226] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Chillwind-Lager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風崗',
    nil,
    'Leve a Garrafa da Aridez de Garrão Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с пустоши Гаррона высшей жрице Макдонелл в Лагерь Промозглого Ветра, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Gahrrons Trauerfeld zur Hohepriesterin MacDonnell an der Chillwindspitze, Westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 가론의 흉가 혼합물을 가져가야 합니다.‡Lleva la Botella rellena de la Gangrena de Gahrron a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la botella llena de la Gangrena de Gahrron a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille de la Flétrissure de Gahrron remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l’ouest.‡把盖罗恩农场的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把蓋羅恩農場的樣本瓶交給西瘟疫之地冰風崗的高階牧師瑪多妮爾。',
  }
},
[5227] = {
  {
    'Caldeirão da Aridez de Garrão‡Котел пустоши Гаррона‡Der Kessel von Gahrrons Trauerfeld‡가론의 흉가 가마솥‡El caldero de la Gangrena de Gahrron‡La caldera de la Gangrena de Gahrron‡Chaudron de la Flétrissure de Gahrron‡盖罗恩农场的瘟疫之锅‡蓋羅恩農場的瘟疫之鍋',
    nil,
    nil,
  }
},
[5228] = {
  {
    'Os caldeirões do Flagelo‡Котлы Плети‡Die Geißelkessel‡스컬지 가마솥‡Los calderos de la Plaga‡Las calderas de la Plaga‡Les chaudrons du Fléau‡瘟疫之锅‡瘟疫之鍋',
    nil,
    'Fale com a Sacerdotisa Sombria Vandis, em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Поговорите со жрицей Тьмы Вандис в Бастионе, что в Западных Чумных землях.‡Sprecht mit der Schattenpriesterin Vandis am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스와 대화해야 합니다.‡Habla con la sacerdotisa de las Sombras Vandis en el Baluarte, en las Tierras de la Peste del Oeste.‡Habla con la sacerdotisa de las Sombras Vandis en el Baluarte, en las Tierras de la Peste del Oeste.‡Parler à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡与西瘟疫之地亡灵壁垒的暗影牧师范蒂丝谈一谈。‡與西瘟疫之地亡靈壁壘的暗影牧師範蒂絲談壹談。',
  }
},
[5229] = {
  {
    'Alvo: Campo Pedravil‡Цель: поле Джанис‡Ziel: Teufelssteinfeld‡목표: 펠스톤 농장‡Objetivo: Campo de Piedra Mácula‡Objetivo: Campo de Piedramácula‡Cible : le Champ de Felstone‡目标：费尔斯通农场‡目標：費爾斯通農場',
    nil,
    'Vá ao Campo Pedravil nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá. Ele pode ter uma chave que dê acesso ao caldeirão. Você precisa estar com a Garrafa do Campo Pedravil Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на поле Джанис в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Джанис.‡Geht zum Teufelssteinfeld im den Westlichen Pestländern. Sucht nach dem dortigen Kessellord und besiegt ihn. Er könnte einen Schlüssel haben, der den Zugang zu dem Kessel ermöglicht. Ihr müsst die leere Flasche: Teufelssteinfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 펠스톤 농장으로 가서 그곳에 있는 가마솥군주를 찾아 물리치십시오. 가마솥군주가 가마솥으로 통하는 열쇠를 지니고 있을 수 있습니다. 반드시 빈 펠스톤 농장 병을 가지고 가서 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Campo de Piedra Mácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedra Mácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Campo de Piedramácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedramácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Champ de Felstone, dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve. Il aura peut-être une clé qui permet d’accéder au chaudron. Il faut se munir de la Bouteille d\'échantillon du Champ de Felstone vide pour pouvoir prélever un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的费尔斯通农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带费尔斯通农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的費爾斯通農場去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶費爾斯通農場的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5230] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa do Campo Pedravil Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с поля Джанис жрице Тьмы Вандис в Бастион, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Teufelssteinfeld zur Schattenpriesterin Vandis am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 펠스톤 농장 병을 가져가야 합니다.‡Lleva la Botella rellena del Campo de Piedra Mácula a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la Botella rellena del Campo de Piedramácula a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille du Champ de Felstone remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把费尔斯通农场的样本瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把費爾斯通農場的樣本瓶交給西瘟疫之地亡靈壁壘的暗影牧師範蒂絲。',
  }
},
[5231] = {
  {
    'Alvo: Lágrimas de Dalson‡Цель: Слезы Далсона‡Ziel: Dalsons Tränenfeld‡목표: 달슨의 눈물‡Objetivo: Lamento de Dalson‡Objetivo: Llanto de Dalson‡Cible : les Larmes de Dalson‡目标：达尔松之泪‡目標：達爾松之淚',
    nil,
    'Vá a Lágrimas de Dalson nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa das Lágrimas de Dalson Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Слезы Далсона в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Слез Далсона.‡Begebt Euch zu Dalsons Tränenfeld in den Westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Dalsons Tränenfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 달슨의 눈물로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 달슨의 눈물 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre aux Larmes de Dalson dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, puis utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille des larmes de Dalson vide pour pouvoir prendre un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的达尔松之泪去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带达尔松之泪的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的達爾松之淚去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶達爾松之淚的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5232] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa das Lágrimas de Dalson Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с поля Слез Далсона жрице Тьмы Вандис в Бастион в Западных Чумных землях.‡Bringt die gefüllte Flasche: Dalsons Tränenfeld zur Schattenpriesterin Vandis am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 달슨의 눈물 혼합물을 가져가야 합니다.‡Lleva la Botella rellena del Llanto de Dalson a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la botella del Llanto de Dalson llena a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille des Larmes de Dalson remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把装满的达尔松眼泪之瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把裝滿的達爾松眼淚之瓶交給西瘟疫之地亡靈壁壘的暗影牧師範蒂絲。',
  }
},
[5233] = {
  {
    'Alvo: Antro Repelente‡Цель: Призрачная ферма‡Ziel: Das trostlose Feld‡목표: 고통의 흉가‡Objetivo: El Tormento‡Objetivo: El Tormento‡Cible : le Repaire putride‡目标：嚎哭鬼屋‡目標：嚎哭鬼屋',
    nil,
    'Vá ao Antro Repelente nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa do Antro Repelente Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Удел Страданий в Западных Чумных землях. Найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с Удела Страданий.‡Begebt Euch zum trostlosen Feld in den Westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Das trostlose Feld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 고통의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 고통의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Repaire putride dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille vide du Repaire putride pour pouvoir récupérer un échantillon des poisons à l’intérieur du chaudron.‡到西瘟疫之地的嚎哭鬼屋去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带嚎哭鬼屋的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的嚎哭鬼屋去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶嚎哭鬼屋的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5234] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa do Antro Repelente Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с Призрачной фермы жрице Тьмы Вандис в Бастион, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Das trostlose Feld zur Schattenpriesterin Vandis am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 고통의 흉가 혼합물을 가져가야 합니다.‡Lleva la Botella rellena de El Tormento a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la Botella llena de El Tormento a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Ramener la Bouteille du Repaire putride remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把嚎哭鬼屋的样本瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把嚎哭鬼屋的樣本瓶交給西瘟疫之地亡靈壁壘的暗影牧師範蒂絲。',
  }
},
[5235] = {
  {
    'Alvo: Aridez de Garrão‡Цель: пустошь Гаррона‡Ziel: Gahrrons Trauerfeld‡목표: 가론의 흉가‡Objetivo: Gangrena de Gahrron‡Objetivo: Gangrena de Gahrron‡Cible : la Flétrissure de Gahrron‡目标：盖罗恩农场‡目標：蓋羅恩農場',
    nil,
    'Vá a Aridez de Garrão nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa da Aridez de Garrão Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на пустошь Гаррона в Западных Чумных землях, найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с путоши Гаррона.‡Begebt Euch zu Gahrrons Trauerfeld in den Westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Gahrrons Trauerfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 가론의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 가론의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre à la Flétrissure de Gahrron dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille vide de la Flétrissure de Gahrron pour pouvoir récupérer un échantillon des poisons à l’intérieur du chaudron.‡到西瘟疫之地的盖罗恩农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带盖罗恩农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的蓋羅恩農場去，找到並擊敗那裏的護鍋者，用它的鑰匙打開瘟疫之鍋。妳必須隨身攜帶蓋羅恩農場的空瓶來采集瘟疫之鍋中的毒藥樣本。',
  }
},
[5236] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa da Aridez de Garrão Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с пустоши Гаррона жрице Тьмы Вандис в Бастион в Западных Чумных землях.‡Bringt die gefüllte Flasche: Gahrrons Trauerfeld zur Schattenpriesterin Vandis am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 가론의 흉가 혼합물을 가져가야 합니다.‡Lleva la Botella rellena de la Gangrena de Gahrron a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la botella llena de la Gangrena de Gahrron a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille de la Flétrissure de Gahrron remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把盖罗恩农场的样本瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把蓋羅恩農場的樣本瓶交給西瘟疫之地亡靈壁壘的暗影牧師範蒂絲。',
  }
},
[5237] = {
  {
    'Missão cumprida!‡Задание выполнено!‡Mission erfüllt!‡임무 완료!‡¡Misión cumplida!‡¡Misión cumplida!‡Mission accomplie !‡任务完成！‡任務完成！',
    nil,
    nil,
  }
},
[5238] = {
  {
    'Missão cumprida!‡Задание выполнено!‡Mission erfüllt!‡임무 완료!‡¡Misión cumplida!‡¡Misión cumplida!‡Mission accomplie !‡任务完成！‡任務完成！',
