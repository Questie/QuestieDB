[8866] = {
  {
    'Barbabronze, o Ancião‡Старейшина Бронзобород‡Urahne Bronzebeard‡장로 브론즈비어드‡Barbabronce el Ancestro‡Barbabronce el Ancestro‡L\'Ancien Bronzebeard‡铜须长者‡銅須長者',
