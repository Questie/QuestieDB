[7666] = {
  {
    'De volta ao Grande Ossário‡Возвращение в Главный склеп‡Erneut im großen Ossuarium‡다시 대형 납골당으로‡El regreso a El Gran Osario‡El regreso a El Gran Osario‡Retour au Grand ossuaire‡重回尸骨储藏所‡重回屍骨儲藏所',
    nil,
    nil,
  }
},
[7667] = {
  {
    'Ajuda material‡Существенная помощь‡Materielle Unterstützung‡물질적인 부탁‡Asistencia material‡Asistencia material‡Assistance matérielle‡收集材料‡收集材料',
    nil,
    'Se você tiver interesse em ajudar Sagorne Monta Crista, no Vale da Sabedoria de Orgrimmar, leve para ele um Diamante Azerotiano e um Diamante Preto Límpido.‡Принесите Сагорну Гребнестраннику в Аллею Мудрости в Оргриммаре азеротский алмаз и безупречный черный алмаз.‡Wenn Ihr Sagorne Crestrider im Tal der Weisheit von Orgrimmar helfen wollt, so bringt ihm einen azerothianischen und einen makellosen schwarzen Diamanten.‡오그리마, 지혜의 골짜기에 있는 사고른 크레스트스트라이더의 일을 도우려면 그에게 아제로스 다이아몬드와 온전한 검은 다이아몬드를 가져가야 합니다.‡Si te interesa ayudar a Sagorne Montacresta, llévale 1 diamante de Azeroth y 1 diamante negro prístino al Valle de la Sabiduría, en Orgrimmar.‡Si te interesa ayudar a Sagorne Montacresta, llévale 1 diamante de Azeroth y 1 diamante negro prístino al Valle de la Sabiduría, en Orgrimmar.‡Si vous voulez aider Sagorne Crestrider de la vallée de la Sagesse d\'Orgrimmar, apportez-lui un Diamant d’Azeroth et un Diamant noir en parfait état.‡如果你愿意帮助奥格瑞玛智慧谷的萨格尼，就将一块艾泽拉斯钻石和一块原始黑钻石交给他。‡如果妳願意幫助奧格瑞瑪智慧谷的薩格尼，就將壹塊艾澤拉斯鉆石和壹塊原始黑鉆石交給他。',
  }
},
[7668] = {
  {
    'A ameaça de Noctilatrus‡Угроза Темного Губителя‡Die Bedrohung durch Schattensichel‡다크리버의 위협‡La amenaza de Atracoscuro‡La amenaza de Atracoscuro‡La menace de Ravassombre‡达克雷尔的威胁‡達克雷爾的威脅',
    nil,
    'Use o Cristal Divinatório no coração do porão do Grande Ossário, em Scolomântia. Isso invocará espíritos que você precisará enfrentar. A derrota dos espíritos evocará o Cavaleiro da Morte Noctilatrus. Derrote-o.|nLeve a Cabeça de Noctilatrus para Sagorne Monta Crista, no Vale da Sabedoria, em Orgrimmar.‡Используйте кристальный предсказатель в Главном склепе в Некроситете. Сразитесь с духами. Когда появится Темный Терзатель, убейте его.|nПринесите голову Темного Терзателя Сагорну Гривастому Страннику в Аллею Мудрости Оргриммара.‡Wendet das Orakel der Anrufung inmitten des Kellergewölbes des großen Ossuariums in Scholomance an. Ihr werdet damit Geister herbeirufen, die es zu bekämpfen gilt. Nach Vernichtung dieser Geister wird der Todesritter Schattensichel auftauchen; besiegt ihn.|nBringt Schattensichels Kopf zu Sagorne Creststrider im Tal der Weisheit in Orgrimmar.‡스칼로맨스에 있는 대형 납골당 지하의 중앙으로 가서 예언의 탐지기를 사용하십시오. 그러면 유령들이 나타날 것입니다. 그들을 해치우십시오. 그리고 곧이어 나타날 죽음의 기사 다크리버를 해치워야 합니다.|n그런 다음 그 증거로 오그리마, 지혜의 골짜기에 있는 사고른 크레스트스트라이더에게 다크리버의 머리카락을 가져가야 합니다.‡Usa el augurador que se encuentra en el corazón del sótano de El Gran Osario en Scholomance. Al hacerlo se presentarán los espíritus a los que tienes que enfrentarte. La derrota de estos espíritus invoca al Caballero de la Muerte Atracoscuro, derrótalo.|nLlévale la cabeza de Atracoscuro a Sagorne Montacresta en el Valle de la Sabiduría, en Orgrimmar.‡Usa el cristal de adivinación en el corazón del sótano de El Gran Osario en Scholomance. Al hacerlo se presentarán los espíritus a los que tienes que enfrentarte. La derrota de estos espíritus invoca al caballero de la Muerte Atracoscuro, derrótalo.|nLlévale la cabeza de Atracoscuro a Sagorne Zanca Cresta en el Valle de la Sabiduría, en Orgrimmar.‡Servez-vous du Clairvoyant au centre du sous-sol du Grand ossuaire de la Scholomance. Cela attirera des esprits que vous devrez combattre. Les vaincre fera apparaître le Chevalier de la mort Ravassombre. Tuez-le.|nRamenez la Tête de Ravassombre à Sagorne Crestrider de la vallée de la Sagesse, à Orgrimmar.‡在通灵学院的尸骨储藏所地下室中心使用预言水晶球，这样将会召来一些灵魂，你必须与它们交战。将这些灵魂击败，死亡骑士达克雷尔就会出现。|n击败达克雷尔，将他的头颅交给奥格瑞玛智慧谷的萨格尼。‡在通靈學院的屍骨儲藏所地下室中心使用預言水晶球，這樣將會召來壹些靈魂，妳必須與它們交戰。將這些靈魂擊敗，死亡騎士達克雷爾就會出現。|n擊敗達克雷爾，將他的頭顱交給奧格瑞瑪智慧谷的薩格尼。',
  }
},
[7669] = {
  {
    'De volta ao Grande Ossário‡Снова в Главный склеп‡Erneut im großen Ossuarium‡다시 대형 납골당으로...‡El regreso a El Gran Osario‡El regreso a El Gran Osario‡Retour au Grand ossuaire‡重回尸骨储藏所‡重回屍骨儲藏所',
    nil,
    nil,
  }
},
[7670] = {
  {
    'Lorde Grayson Quebrassombra‡Лорд Грейсон Тенелом‡Lord Grayson Shadowbreaker‡그레이슨 섀도브레이커 경‡Lord Grisillo Quiebrasombras‡Lord Grisillo Quiebrasombras‡Le seigneur Grayson Shadowbreaker‡格雷森·沙东布瑞克公爵‡格雷森·沙東布瑞克公爵',
    nil,
    'Fale com o Lorde Grayson Quebrassombra no Distrito da Catedral de Ventobravo.‡Поговорите с лордом Грейсоном Тенеломом в Храмовом квартале Штормграда.‡Sprecht mit Lord Grayson Shadowbreaker im Kathedralenviertel von Stormwind.‡스톰윈드의 대성당 광장에 있는 그레이슨 섀도브레이커 경과 대화해야 합니다.‡Habla con Lord Grayson Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Habla con Lord Grisillo Quiebrasombras en el Distrito de la Catedral de Ventormenta.‡Parler au seigneur Grayson Shadowbreaker dans le Quartier de la cathédrale de Stormwind.‡与暴风城教堂区的格雷森·沙东布瑞克公爵谈一谈。‡與暴風城教堂區的格雷森·沙東布瑞克公爵談壹談。',
  }
},
[7671] = {
  {
