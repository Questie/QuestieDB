},
[6721] = {
  {
    'O caminho do caçador‡Путь Охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Fale com Dazalar em Dolanaar.‡Поговорите в Доланааре с Дазаларом.‡Sprecht mit Dazalar in Dolanaar.‡돌라나르에 있는 다잘라와 대화하십시오.‡Habla con Dazalar en Dolanaar.‡Habla con Dazalar en Dolanaar, en Teldrassil.‡Parler à Dazalar, à Dolanaar.‡与多兰纳尔的达扎拉谈一谈。‡與多蘭納爾的達紮拉談壹談。',
  }
},
[6722] = {
  {
    'O caminho do caçador‡Путь Охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Fale com Dazalar em Dolanaar.‡Поговорите в Доланааре с Дазаларом.‡Sprecht mit Dazalar in Dolanaar.‡돌라나르에 있는 다잘라와 대화하십시오.‡Habla con Dazalar en Dolanaar.‡Habla con Dazalar en Dolanaar, en Teldrassil.‡Parler à Dazalar, à Dolanaar.‡与多兰纳尔的达扎拉谈一谈。‡與多蘭納爾的達紮拉談壹談。',
  }
},
[6741] = {
  {
    'Mais espólios!‡Больше добычи!‡Mehr Beute!‡추가 전리품!‡¡Más botines!‡¡Más botines!‡Plus de butin !‡取之于敌‡取之於敵',
