[1258] = {
  {
    'Caranguejo não é peixe...‡…и жуки.‡...und Käfer‡... 그리고 벌레‡... con tropezones‡...con tropezones‡... Et des bestioles‡还有螃蟹！‡還有螃蟹！',
    nil,
    'Leve 12 Patas Impecáveis de Rastejante a Morgado Severo em Theramore.‡Принесите 12 безупречных крабьих клешней Моргану Штерну в Терамор.‡Bringt 12 makellose Kriecherbeine zu Morgan Stern in Theramore.‡테라모어에 있는 모건 스턴에게 온전한 집게 다리 12개를 가져가야 합니다.‡Lleva 12 patas de reptador prístinas a Morgan Stern a Theramore.‡Lleva 12 patas de reptador prístinas a Morgan Stern a Theramore.‡Apporter 12 Pattes de Clampant en parfait état à Morgan Stern à Theramore.‡给塞拉摩的摩根·斯特恩收集12根新鲜的螃蟹腿。‡給塞拉摩的摩根·斯特恩收集12根新鮮的螃蟹腿。',
  }
},
[1259] = {
  {
    'Tenente Paval Reethe‡Лейтенант Павал Рит‡Lieutenant Paval Reethe‡부관 파발 리테‡Teniente Paval Reethe‡Teniente Paval Reethe‡Le lieutenant Paval Reethe‡帕瓦尔·雷瑟上尉‡帕瓦爾·雷瑟上尉',
    nil,
    'Descubra mais sobre Reethe consultando o Auxiliar Tesoran em Theramore.‡Поговорите о Рите с адъютантом Тезораном в Тераморе.‡Findet bei Adjudant Tesoran in Theramore mehr über Reethe heraus.‡테라모어에 있는 부관 테소렌으로부터 리테에 대해 알아내야 합니다.‡Averigua más sobre Reethe hablando con el ayudante Tesoran de Theramore.‡Averigua más sobre Reethe hablando con el ayudante Tesoran en Theramore.‡Trouver plus de renseignements sur Paval Reethe auprès de l\'adjudant Tesoran à Theramore.‡从塞拉摩的泰索兰副官那儿找出更多关于雷瑟的消息。‡從塞拉摩的泰索蘭副官那兒找出更多關於雷瑟的消息。',
  }
},
[1260] = {
