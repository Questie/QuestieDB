[1100] = {
  {
    'Diário do Monocelha‡Дневник Хмурня‡Lonebrows Tagebuch‡론브로우의 일지‡El diario de Henrig Soliceja‡El diario de Soliceja‡Journal de Lonebrow‡亨里格的日记‡亨裏格的日記',
    nil,
    'Leia o Diário de Henrig Monocelha.‡Прочитайте дневник Хенрига Хмурня.‡Lest Henrig Lonebrows Tagebuch.‡헨리그 론브로우의 일지를 읽으십시오.‡Lee el diario de Henrig Soliceja.‡Lee el diario de Henrig Soliceja.‡Lire le Journal de Henrig Lonebrow.‡阅读亨里格·独眉的日记。‡閱讀亨裏格·獨眉的日記。',
  }
},
[1101] = {
  {
    'A bruxa má do Urzal‡Хозяйка Лабиринтов‡Die Greisin des Krals‡가시덩굴 우리의 대모‡La bruja del Horado‡La bruja del Horado‡La mégère du Kraal‡卡尔加·刺肋‡卡爾加·刺肋',
    nil,
    'Leve o Medalhão da Talhaflanco para Falfindel Trilhemas em Thalanaar.‡Принесите медальон Чарлги Остробок Фалфиндеру Хранителю Путей в Таланааре.‡Bringt Falfindel Waywarder in Thalanaar Razorflanks Medaillon.‡탈라나르에 있는 팔핀델 웨이워더에게 차를가의 메달을 가져가야 합니다.‡Llévale el medallón de Filonavaja a Díscolo Falfildel de Thalanaar.‡Llévale el medallón de Filonavaja a Díscolo Falfindel de Thalanaar.‡Apporter le Médaillon de Trancheflanc à Falfindel Waywarder à Thalanaar.‡把卡尔加·刺肋的徽章交给萨兰纳尔的法芬德尔。‡把卡爾加·刺肋的徽章交給薩蘭納爾的法芬德爾。',
  }
},
[1102] = {
  {
    'Um destino vingativo‡Отмщение грядет!‡Ein schreckliches Schicksal‡운명의 복수‡Un destino vengador‡Un destino vengador‡Un destin funeste‡奥尔德的报复‡奧爾德的報復',
    nil,
    'Leve o Coração da Talhaflanco para Auld Agulha de Pedra no Penhasco do Trovão.‡Принесите сердце Чарлги Остробок Ольду Каменному Копью в Громовой Утес.‡Bringt Auld Stonespire in Thunder Bluff Razorflanks Herz.‡썬더 블러프에 있는 아울드 스톤스파이어에게 차를가의 심장을 가져가야 합니다.‡Llévale el corazón de Filonavaja a Auld Picopiedra, que está en Cima del Trueno.‡Llévale el corazón de Filonavaja a Auld Picopiedra, que está en Cima del Trueno.‡Apporter le Cœur de Trancheflanc à Stonespire le Vieil, à Thunder Bluff.‡把卡尔加·刺肋的心脏交给雷霆崖的奥尔德·石塔。‡把卡爾加·刺肋的心臟交給雷霆崖的奧爾德·石塔。',
  }
},
[1103] = {
  {
    'O clamor da Água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve uma Sapta da Água para Tiev Borduno na Floresta de Pinhaprata se não tiver conseguido falar com a Manifestação Menor da Água.‡Принесите Тьеву Мордуну, который находится в Серебряном бору, сапту воды, если вам не удалось поговорить с низшим воплощением воды.‡Bringt Tiev Mordune im Silberwald ein Wassersapta, wenn Ihr nicht mit der schwachen Wassermanifestation gesprochen habt.‡하급 물의 현신과 대화하지 못했으면 은빛소나무 숲에 있는 티에브 모르둔에게 물의 정기를 가져다주어야 합니다.‡Llévale una sapta de agua a Tiev Mordune en el Bosque de Argénteos si no consigues hablar con la manifestación de agua menor.‡Llévale una sapta de agua a Tiev Mordune en el Bosque de Argénteos si no consigues hablar con la manifestación de agua menor.‡Apporter un sapta d\'eau à Tiev Mordune dans la forêt des Pins argentés, si vous n\'arrivez pas à parler à la Manifestation d\'eau mineure.‡如果你没能与水之魂交谈，就给银松森林的提夫·摩杜恩再拿去一瓶水之灵契。‡如果妳沒能與水之魂交談，就給銀松森林的提夫·摩杜恩再拿去壹瓶水之靈契。',
  }
},
[1104] = {
  {
    'Peçonha do salar‡Яд Соляных равнин‡Salziges Gift‡소금기 있는 전갈 독‡Veneno de escórpidos salados‡Veneno de El Desierto de Sal‡Le venin acide des salines‡含盐的蝎毒‡含鹽的蠍毒',
    nil,
    'Leve 6 Peçonhas Salgadas de Escorpídeo para Xabu Latafuso no Salar Cintilante.‡Принесите 6 порций соленого яда скорпида Пшиксу Медноштифу на Мерцающую равнину.‡Bringt Fizzle Brassbolts in der schimmernden Ebene 6 Einheiten salziges Skorpidgift.‡소금 평원에 있는 피즐 브라스볼츠에게 소금기 있는 전갈 독 6개를 가져가야 합니다.‡Llévale 6 glándulas de veneno de escórpidos salados a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale 6 glándulas de veneno de escórpidos salados a Fizzle Pernolatón, que está en El Desierto de Sal.‡Apportez 6 doses de Venin de scorpide acide à Fizzle Brassbolts, dans les Salines.‡为闪光平原的菲兹尔·铜栓带去6份含盐的蝎毒。‡為閃光平原的菲茲爾·銅栓帶去6份含鹽的蠍毒。',
  }
},
[1105] = {
  {
    'Cascos endurecidos‡Крепкие панцири‡Gehärtete Schalen‡단단한 등껍질‡Caparazones endurecidos‡Caparazones endurecidos‡Les carapaces durcies‡硬化龟壳‡硬化龜殼',
    nil,
    'Leve 9 Cascos Endurecidos de Tartaruga para Capu Latafuso no Salar Cintilante.‡Принесите 9 крепких черепашьих панцирей Виззлу Медноштифу на Мерцающую равнину.‡Bringt Wizzle Brassbolts in der schimmernden Ebene 9 gehärtete Schildkrötenpanzer.‡소금 평원에 있는 위즐 브라스볼츠에게 단단한 거북 등껍질 9개를 가져가야 합니다.‡Llévale 9 caparazones de tortuga endurecidos a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale 9 caparazones de tortuga endurecidos a Wizzle Pernolatón, que está en El Desierto de Sal.‡Apporter 9 Carapaces de tortue durcies à Wizzle Brassbolts dans les Salines.‡收集9块硬化龟壳，把它们交给闪光平原的维兹尔·铜栓。‡收集9塊硬化龜殼，把它們交給閃光平原的維茲爾·銅栓。',
  }
},
[1106] = {
  {
    'Martek, o Exilado‡Мартек Изгой‡Martek der Verbannte‡망명자 마르텍‡Martek el Exiliado‡Martek el Exiliado‡Martek l\'Exilé‡流放者马特克‡流放者馬特克',
    nil,
    'Entregue a carta do Xabu para Martek, o Exilado, nos Ermos.‡Отнесите письмо Пшикса Мартеку Изгою в Бесплодные земли.‡Bringt Martek dem Verbannten im Ödland Fizzles Brief.‡황야의 땅에 있는 망명자 마르텍에게 피즐의 편지를 가져가야 합니다.‡Llévale la carta de Fizzle Pernolatón a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Llévale la carta de Fizzle Pernolatón a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Apporter la Lettre de Fizzle à Martek l\'Exilé dans les Terres ingrates.‡把菲兹尔·铜栓的信带给荒芜之地的流放者马特克。‡把菲茲爾·銅栓的信帶給荒蕪之地的流放者馬特克。',
  }
},
[1107] = {
  {
    'Barbatanas de cauda incrustada‡Средство против трения‡Verkrustete Schwanzflossen‡딱딱한 꼬리지느러미‡Aletas dorsales escamadas‡Aletas dorsales taraceadas‡Les nageoires incrustées‡坚硬的尾鳍‡堅硬的尾鰭',
    nil,
    'Leve 10 Barbatanas de Cauda Incrustada para Capu Latafuso no Salar Cintilante.‡Принесите 10 соленых хвостовых плавников Виззлу Медноштифту на Мерцающую равнину.‡Bringt Fizzle Brassbolts in der schimmernden Ebene 10 verkrustete Schwanzflossen.‡소금 평원에 있는 위즐 브라스볼츠에게 딱딱한 꼬리지느러미 10개를 가져가야 합니다.‡Llévale 10 aletas dorsales escamadas a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale 10 aletas dorsales taraceadas a Wizzle Pernolatón, que está en El Desierto de Sal.‡Apporter 10 Nageoires incrustées à Wizzle Brassbolts dans les Salines.‡给闪光平原上的瑞兹尔·铜栓带去10片坚硬的尾鳍。‡給閃光平原上的瑞茲爾·銅栓帶去10片堅硬的尾鰭。',
  }
},
[1108] = {
  {
    'Indúrio‡Индарилий‡Indurium‡인듀리움 광석‡Indurio‡Indurio‡Indurium‡精铁碎片‡精鐵碎片',
    nil,
    'Leve 10 Lâminas de Indúrio para Martek, o Exilado, nos Ermos.‡Принесите 10 пластин индарилия Мартеку Изгою в Бесплодные земли.‡Bringt Martek dem Verbannten im Ödland 10 Induriumspäne.‡황야의 땅에 있는 망명자 마르텍에게 인듀리움 조각 10개를 가져가야 합니다.‡Llévale 10 láminas de indurio a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Llévale 10 láminas de indurio a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Apporter 10 Flocons d\'indurium à Martek l\'Exilé dans les Terres ingrates.‡收集10块精铁碎片，把它们交给荒芜之地的流放者马特克。‡收集10塊精鐵碎片，把它們交給荒蕪之地的流放者馬特克。',
  }
},
[1109] = {
  {
    'Matéria orguânica‡Груды гуано‡Go, Go, Guano!‡조분석을 나에게!‡Guano del Horado‡Guano del Horado‡Corvée de guano‡蝙蝠的粪便‡蝙蝠的糞便',
    nil,
    'Leve 1 porção de Guano de Morcego para o Mestre-boticário Faranello na Cidade Baixa.‡Принесите 1 кучку гуано летучей мыши Лабиринтов мастеру-аптекарю Фаранеллу в Подгород.‡Bringt dem Apothekermeister Faranell in Undercity 1 Häufchen Kral-Guano.‡언더시티에 있는 수석 연금술사 파라넬에게 가시덩굴 조분석을 가져가야 합니다.‡Llévale una pila de guano del Horado al maestro boticario Faranell de Entrañas.‡Llévale una pila de guano del Horado al maestro boticario Faranell en Entrañas.‡Apporter 1 tas de Guano du kraal au Maître Apothicaire Faranell à Undercity.‡帮幽暗城的大药剂师法拉尼尔带回一堆沼泽蝙蝠的粪便。‡幫幽暗城的大藥劑師法拉尼爾帶回壹堆沼澤蝙蝠的糞便。',
  }
},
[1110] = {
  {
    'Peças de carro-foguete‡Обломки болидов‡Raketenwagenteile‡로켓 자동차 부품‡Piezas de coches cohete‡Las piezas de coche cohete‡Pièces de chariot explosif‡火箭车零件‡火箭車零件',
    nil,
    'Leve 30 Peças de Carro-foguete para Kravel Barbakarvão no Salar Cintilante.‡Принестие 30 деталей болида Крейвелу Углебраду на Мерцающую равнину.‡Bringt 30 Raketenwagenteile zu Kravel Koalbeard in der schimmernden Ebene.‡소금 평원의 크레이블 콜비어드에게 로켓 자동차 부품 30개를 가져가야 합니다.‡Llévale 30 piezas de coche cohete a Kravel Karbarbán, que está en El Desierto de Sal.‡Llévale 30 piezas de coche cohete a Kravel Karbarbán, que está en El Desierto de Sal.‡Apporter 30 Pièces de Chariot explosif à Kravel Koalbeard des Salines.‡收集30个火箭车零件，把它们交给闪光平原的克拉维尔·浓须。‡收集30個火箭車零件，把它們交給閃光平原的克拉維爾·濃須。',
  }
},
[1111] = {
  {
    'Mestre Portuário Caruncho‡Управляющий пристанью Головокружилкинc‡Werftmeister Dizzywig‡부두주임 디지위그‡Maestro de los muelles Vertipeluca‡Maestro de muelles Vertipeluca‡Maître des quais Dizzywig‡码头管理员迪兹维格‡碼頭管理員迪茲維格',
    nil,
    'Leve a Encomenda de Peças de Kravel para o Mestre Portuário Caruncho na Vila Catraca.‡Отнесите заказ на детали Крейвела управляющему пристанью Головокружилкинcу в Кабестан.‡Bringt Kravels Teile-Bestellung zu Werftmeister Dizzywig in Ratchet.‡톱니항에 있는 부두주임 디지위그에게 크레이블의 부품주문서를 가져가야 합니다.‡Llévale el pedido de piezas de Kravel al maestro de los muelles Vertipeluca, que está en Trinquete.‡Lleva el pedido de piezas de Kravel al Maestro de muelles Vertipeluca en Trinquete.‡Apporter la Commande de Kravel au Maître des quais Dizzywig à Ratchet.‡把克拉维尔的零件订单交给棘齿城的码头管理员迪兹维格。‡把克拉維爾的零件訂單交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[1112] = {
  {
    'Peças para Kravel‡Детали для Крейвела‡Teile für Kravel‡크레이블의 부품‡Las piezas de Kravel‡Las piezas de Kravel‡Les pièces détachées de Kravel‡给克拉维尔的零件‡給克拉維爾的零件',
    nil,
    'Leve as Peças de Kravel para Kravel Barbakarvão no Salar Cintilante.‡Отнесите Крейвелу Углебраду его детали на Мерцающую равнину.‡Bringt Kravels Teile zu Kravel Koalbeard in der schimmernden Ebene.‡소금 평원에 있는 크레이블 콜비어드에게 크레이블의 부품을 가져가야 합니다.‡Llévale las piezas de Kravel a Kravel Karbarbán, que está en El Desierto de Sal.‡Lleva las piezas de Kravel a Kravel Karbarbán en el Desierto de Sal.‡Apporter les Pièces détachées de Kravel à Kravel Koalbeard dans les Salines.‡把克拉维尔的零件交给闪光平原的克拉维尔·浓须。‡把克拉維爾的零件交給閃光平原的克拉維爾·濃須。',
  }
},
[1113] = {
  {
    'Corações do fanatismo‡Сердца Доблести‡Herzen des Eifers‡열정의 증거‡Corazones de fervor‡Corazones de fanatismo‡Des cœurs zélés‡狂热之心‡狂熱之心',
    nil,
    'O Mestre-boticário Faranello, da Cidade Baixa, quer 20 Corações do Fanatismo.‡Мастер-аптекарь Фаранелл из Подгорода просит принести ему 20 сердец Доблести.‡Apothekermeister Faranell in Undercity möchte 20 Herzen des Eifers.‡언더시티에 있는 수석 연금술사 파라넬에게 열정의 증거 20개를 가져가야 합니다.‡El maestro boticario Faranell de Entrañas quiere 20 corazones de fervor.‡El maestro boticario Faranell de Entrañas quiere 20 corazones de fanatismo.‡Le maître apothicaire Faranell, à Undercity, veut 20 Cœurs zélés.‡幽暗城的大药剂师法拉尼尔需要20颗狂热之心。‡幽暗城的大藥劑師法拉尼爾需要20顆狂熱之心。',
  }
},
[1114] = {
  {
    'Entrega para os gnomos‡Заказ гномов‡Lieferung für die Gnome‡노움에게 배달‡Un envío para los gnomos‡Un envío para los gnomos‡Une livraison pour les gnomes‡侏儒的货物‡侏儒的貨物',
    nil,
    'Leve as Peças Frágeis de Carro para Xabu Latafuso no Salar Cintilante.‡Отнесите хрупкие детали машины Пшиксу Медноштифу на Мерцающую равнину.‡Bringt die empfindlichen Autoteile zu Fizzle Brassbolts.‡소금 평원에 있는 피즐 브라스볼츠에게 정밀한 부품을 가져가야 합니다.‡Llévale las piezas de coche frágiles a Fizzle Pernolatón, que está en El Desierto de Sal.‡Llévale las piezas de coche delicadas a Fizzle Pernolatón, que está en El Desierto de Sal.‡Apporter les Pièces de chariot fragiles à Fizzle Brassbolts dans les Salines.‡把精密赛车零件交给菲兹尔·铜栓。‡把精密賽車零件交給菲茲爾·銅栓。',
  }
},
[1115] = {
  {
    'O boateiro‡Сплетник‡Der Gerüchteverbreiter‡소문을 퍼뜨리는 자‡Rumores‡Rumores‡Le marchand de rumeurs‡车手的传闻‡車手的傳聞',
    nil,
    'Fale com Krazek na Angra do Butim.‡Поговорите с Кразеком в Пиратской бухте.‡Sprecht mit Krazek in Booty Bay.‡무법항에 있는 크라젝과 대화하십시오.‡Habla con Krazek en Bahía del Botín.‡Habla con Krazek en Bahía del Botín.‡Parler à Krazek à Baie-du-Butin.‡和藏宝海湾的克拉兹克谈一谈。‡和藏寶海灣的克拉茲克談壹談。',
  }
},
[1116] = {
  {
    'Pó onírico no pantanal‡Сонная пыль в болоте‡Traumstaub im Sumpf‡습지의 꿈가루‡Polvo de sueño en el pantano‡Polvo onírico en el pantano‡De la Poussière de rêve dans les marécages‡梦境之尘‡夢境之塵',
    nil,
    'Leve 10 Partículas de Pó Onírico para Krazek na Angra do Butim. O Pó Onírico é coletado dos dragonetes no Pântano das Mágoas.‡Принесите 10 щепоток сонной пыли Кразеку в Пиратскую бухту. Сонную пыль можно собрать с дракончиков на Болоте Печали.‡Bringt 10 Körnchen Traumstaub zu Krazek in Booty Bay.‡무법항에 있는 크라젝에게 꿈가루 10줌을 가져가야 합니다. 꿈가루는 슬픔의 늪에 있는 용들에게서 얻을 수 있습니다.‡Llévale 10 pizcas de polvo de sueño a Krazek a Bahía del Botín. El polvo de sueño se obtiene de las crías de dragón que habitan en el Pantano de las Penas.‡Llévale 10 pizcas de polvo onírico a Krazek a Bahía del Botín. El polvo onírico se obtiene de las crías de dragón que habitan en el Pantano de las Penas.‡Apporter 10 Grains de Poussière de rêve à Krazek à Baie-du-Butin. La Poussière de rêve se récupère sur les dragonnets du marais des Chagrins.‡为藏宝海湾的克拉兹克收集10份梦境之尘。‡為藏寶海灣的克拉茲克收集10份夢境之塵。',
  }
},
[1117] = {
  {
    'Rumores para Kravel‡Сплетни для Крейвела‡Gerüchte für Kravel‡크레이블을 위한 소문‡Rumores para Kravel‡Rumores para Kravel‡Des rumeurs pour Kravel‡地精的谣言‡地精的謠言',
    nil,
    'Leve os Rumores Goblínicos para Kravel Barbakarvão no Salar Cintilante.‡Отнесите письмо с гоблинскими сплетнями Крейвелу Углебраду на Мерцающую равнину.‡Bringt die Goblin-Gerüchte zu Kravel Koalbeard in der schimmernden Ebene.‡소금 평원에 있는 크레이블 콜비어드에게 고블린의 소문을 가져가야 합니다.‡Llévale los rumores del goblin a Kravel Karbarbán, que está en El Desierto de Sal.‡Lleva los rumores goblin a Kravel Karbarbán en El Desierto de Sal.‡Apporter les Rumeurs gobelines à Kravel Koalbeard dans les Salines.‡把地精的谣言带给闪光平原的克拉维尔·浓须。‡把地精的謠言帶給閃光平原的克拉維爾·濃須。',
  }
},
[1118] = {
  {
    'De volta à Angra do Butim‡Назад в Пиратскую бухту‡Zurück nach Booty Bay‡무법항으로의 귀환‡De vuelta a Bahía del Botín‡De vuelta a Bahía del Botín‡Retour à Baie-du-Butin‡返回藏宝海湾‡返回藏寶海灣',
    nil,
    'Leve o Plano de Kravel para Cranque Mirrabolha na Angra do Butim.‡Отнесите план Крейвела Шиззи Пуззыриксу в Пиратскую бухту.‡Bringt Kravels Plan zu Crank Fizzlebub in Booty Bay.‡피즐버브에게 보내는 편지를 무법항에 있는 크랭크 피즐버브에게 가져가야 합니다.‡Llévale el plan de Kravel a Loquillo Pinchabujas, que está en Bahía del Botín.‡Lleva el esquema de Kravel a Loquillo Pinchabujas en Bahía del Botín.‡Apporter le Plan de Kravel à Crank Fizzlebub à Baie-du-Butin.‡把克拉维尔的计划书交给藏宝海湾的克兰克·菲兹巴布。‡把克拉維爾的計劃書交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1119] = {
  {
    'Preparado de Zanzil e Cerveja Escura do Tonto‡Смесь Занзила и "Дурацкое Крепкое"‡Zanzils Mixtur und Fools Starkbier‡잔질의 혼합물과 멍텅구리 스타우트 맥주‡La mezcla y cerveza de tontos de Zanzil‡La mezcla de Zanzil y la cerveza de tontos‡La bière du sot‡赞吉尔的药剂和蠢人酒‡贊吉爾的藥劑和蠢人酒',
    nil,
    'Leve a Cerveja Escura do Tonto para Kravel no Salar Cintilante.‡Отнесите "Дурацкое Крепкое" Крейвелу на Мерцающую равнину.‡Bringt Fools Starkbier zu Kravel in der schimmernden Ebene zurück.‡소금 평원의 크레이블에게 멍텅구리 스타우트 맥주를 가지고 돌아가야 합니다.‡Llévale la cerveza de tontos a Kravel, que está en El Desierto de Sal.‡Regrésale la cerveza de tontos a Kravel en el Desierto de Sal.‡Rapporter la Bière du sot à Kravel, aux Salines.‡把蠢人酒交给克拉维尔。‡把蠢人酒交給克拉維爾。',
  }
},
[1120] = {
  {
    'Deixe os gnomos bêbados‡Напоить гномов‡Die Gnome betrunken machen‡노움 취하게 하기‡Emborrachar a los gnomos‡Emborrachar a los gnomos‡Saoulez les gnomes‡灌醉侏儒‡灌醉侏儒',
    nil,
    'Leve a Cerveja Escura do Tonto para o Chefe dos Boxes Gnomo.‡Отнесите "Дурацкое Крепкое" начальнику гномского гаража.‡Bringt Fools Starkbier zum Gnomen-Boxenboss.‡노움 정비주임에게 멍텅구리 스타우트 맥주를 가져가야 합니다.‡Llévale la cerveza de tontos al jefe técnico de los gnomos.‡Lleva la cerveza de tontos al encargado de foso gnomo.‡Apporter la bière du Sot au Chef-mécanicien gnome.‡把蠢人酒带给侏儒车队老板。‡把蠢人酒帶給侏儒車隊老板。',
  }
},
[1121] = {
  {
    'Deixe os goblins bêbados‡Напоить гоблинов‡Die Goblins betrunken machen‡고블린 취하게 하기‡Emborrachar a los goblin‡Emborrachar a los goblins‡Saoulez les gobelins‡灌醉地精‡灌醉地精',
    nil,
    'Leve a Cerveja Escura do Tonto para o Chefe dos Boxes Goblin.‡Отнесите "Дурацкое Крепкое" начальнику гоблинского гаража.‡Bringt Fools Starkbier zum Goblin-Boxenboss.‡고블린 정비주임에게 멍텅구리 스타우트 맥주를 가져가야 합니다.‡Llévale la cerveza de tontos al jefe técnico de los goblins.‡Lleva la cerveza de tontos al encargado de foso goblin.‡Apporter la bière du sot au Chef-mécanicien gobelin.‡把蠢人酒交给地精车队老板。‡把蠢人酒交給地精車隊老板。',
  }
},
[1122] = {
  {
    'Fale novamente com Mirrabolha‡Возвращение к Пуззыриксу‡Meldet Euch bei Fizzlebub‡피즐버브에게 돌아가기‡Volver a informar a Pinchabujas,‡Volver a informar a Pinchabujas‡Le compte rendu à Fizzlebub‡向菲兹巴布报告‡向菲茲巴布報告',
    nil,
    'Leve o relatório sobre a Cerveja Escura do Tonto para Cranque Mirrabolha na Angra do Butim.‡Отнесите отчет о "Дурацком Крепком" Шиззи Пуззыриксу в Пиратскую бухту.‡Bringt den Bericht über Fools Starkbier zu Crank Fizzlebub in Booty Bay.‡무법항에 있는 크랭크 피즐버브에게 멍텅구리 스타우트 보고서를 가져가야 합니다.‡Llévale la cerveza de tontos a Loquillo Pinchabujas, que está en Bahía del Botín.‡Lleva el informe de cerveza de tontos a Loquillo Pinchabujas en Bahía del Botín.‡Apporter le Rapport sur la Bière du sot à Crank Fizzlebub à Baie-du-Butin.‡把蠢人酒试验报告交给藏宝海湾的克兰克·菲兹巴布。‡把蠢人酒試驗報告交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1123] = {
  {
    'Ravine Saturna‡Рабин Сатурна‡Rabine Saturna‡라빈 사투르나‡Rabine Saturna‡Rabine Saturna‡Rabine Saturna‡拉比恩·萨图纳‡拉比恩·薩圖納',
    nil,
    'Fale com Ravine Saturna no Refúgio Noturno, que fica na Clareira da Lua. A Clareira da Lua fica entre a Selva Maleva e Hibérnia, uma estrada que sai do Domínio dos Presamatos leva até lá.‡Поговорите с Рабином Сатурной в селении Ночная Гавань на Лунной поляне. Лунная поляна находится между Оскверненным лесом и Зимними Ключами, туда можно добраться по дороге, идущей от крепости Древобрюхов.‡Sprecht mit Rabine Saturna im Dorf Nighthaven in Moonglade. Moonglade liegt zwischen dem Teufelswald und Winterspring, und Ihr erreicht es über den Pfad, der aus der Holzschlundfeste herausführt.‡달의 숲의 나이트헤이븐에 있는 라빈 사투르나와 대화해야 합니다. 달의 숲은 악령의 숲과 여명의 설원 사이에 있으며 나무구렁 요새에서 나가는 길을 통해 갈 수 있습니다.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión de los Fauces de Madera.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión Fauces de Madera.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune. Reflet-de-Lune se trouve entre Gangrebois et le Berceau-de-l\'Hiver. Le chemin qui y mène traverse le Repaire des Grumegueules.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。月光林地在费伍德森林和冬泉谷之间，可以从木喉要塞中的一条通道抵达那里。‡與月光林地永夜港的拉比恩·薩圖納談壹談。月光林地在費伍德森林和冬泉谷之間，可以從木喉要塞中的壹條通道抵達那裏。',
  }
},
[1124] = {
  {
    'Terras Devastadas‡Пустошь‡Einöde‡황무지‡Páramo‡Páramo‡La dévastation‡废土‡廢土',
    nil,
    'Mostre a Carta de Ravine para Layo Golpestela perto do Repouso dos Valorosos, o cemitério de Silithus.‡Поговорите с Лайо Зведным Всполохом близ кладбища Покой Доблестных в Силитусе и покажите ему письмо Рабина.‡Sprecht in der Nähe des Friedhofs Heldenwacht in Silithus mit Layo Starstrike und zeigt ihm Rabines Brief.‡실리더스의 묘지인 용사의 안식처 근처에 있는 라요 스타스트라이크를 찾아가 라빈의 편지를 보여주어야 합니다.‡Enséñale la carta del rabino a Layo Estrella cerca del cementerio de Sosiego del Valor en Silithus.‡Enséñale la carta de Rabine a Layo Golpe Estelar cerca del cementerio de Sosiego del Valor en Silithus.‡Parler à Layo Starstrike, à proximité du Repos des vaillants de Silithus, et lui montrer la Lettre de Rabine.‡在希利苏斯的勇士之墓附近找莱耶·星击谈谈，把拉比恩的信交给他。‡在希利蘇斯的勇士之墓附近找萊耶·星擊談談，把拉比恩的信交給他。',
  }
},
[1125] = {
  {
    'Os espíritos de Vento Sul‡Духи Южного Ветра‡Die Geister vom Südwindposten‡마파람의 영혼‡Los espíritus de Viento del Sur‡Los espíritus de Viento del Sur‡Les esprits de Sudevent‡南风村的灵魂‡南風村的靈魂',
    nil,
    'Liberte os espíritos de 8 Druidas Torturados e 8 Sentinelas Torturadas na Vila do Vento Sul, depois fale novamente com Layo Golpestela no Repouso dos Valorosos, o cemitério de Silithus.‡Освободите в деревне Южного Ветра души 8 истерзанных друидов и 8 истерзанных часовых и вернитесь к Лайо Звездному Всполоху на кладбище Силитуса, Покой Доблестных.‡Befreit die Geister von 8 gequälten Druiden und 8 gequälten Schildwachen beim Südwindposten und kehrt dann zu Layo Starstrike auf den Friedhof Heldenwacht in Silithus zurück.‡마파람 마을에서 고통받는 드루이드 8명과 고통받는 파수꾼 8명의 영혼을 해방한 후, 실리더스, 용사의 안식처 묘지에 있는 라요 스타스트라이크에게 돌아가야 합니다.‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturadas en la Aldea del Viento del Sur. A continuación, reúnete con Layo Estrella en el cementerio de Sosiego del Valor en Silithus.‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturados en la Aldea del Viento del Sur. A continuación, reúnete con Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Libérer l’esprit de 8 Druides torturés et de 8 Sentinelles torturées, dans le village de Sudevent, puis revenir voir Layo Starstrike, au cimetière du Repos des Vaillants de Silithus.‡在南风村释放8个被折磨的德鲁伊和8个被折磨的哨兵的灵魂，然后向希利苏斯勇士之墓的莱耶·星击复命。‡在南風村釋放8個被折磨的德魯伊和8個被折磨的哨兵的靈魂，然後向希利蘇斯勇士之墓的萊耶·星擊復命。',
  }
},
[1126] = {
  {
    'A colmeia da torre‡Улей в башне‡Schwarmbau im Turm‡탑 속 소굴‡Una colmena en la torre‡Una colmena en la torre‡Une ruche dans la tour‡塔中之巢‡塔中之巢',
    nil,
    'Escale a torre da Vila do Vento Sul e descubra um jeito de despertar a colmeia. Leve tudo de estranho que encontrar durante a missão para Layo Golpestela no Repouso dos Valorosos, o cemitério de Silithus.‡Осмотрите башню деревни Южного Ветра и отыщите способ разворошить улей. Принесите все необычное, что попадется при выполнении задания Лайо Звездному Всполоху на кладбище Силитуса, Покой Доблестных.‡Besteigt den Turm beim Südwindposten und findet eine Möglichkeit, den Schwarmbau der Silithiden aufzuscheuchen. Bringt alles Ungewöhnliche, das Ihr dabei entdeckt, zu Layo Starstrike auf den Friedhof Heldenwacht in Silithus.‡마파람 마을에 있는 탑 위로 올라가 실리시드 소굴을 들쑤셔 놓을 방법을 찾아야 합니다. 그러는 가운데 뭔가 알아낸 것이 있으면 실리더스의 용사의 안식처 묘지에 있는 라요 스타스트라이크에게 보고해야 합니다.‡Sube a la torre de la Aldea del Viento del Sur y encuentra la forma de agitar la colmena de silítidos para que entre en actividad. Recoge cualquier cosa extraña que encuentres y llévasela a Layo Estrella en el cementerio de Sosiego del Valor en Silithus.‡Sube a la torre de la Aldea del Viento del Sur y encuentra la forma de agitar la colmena de silítidos para que entre en actividad. Recoge cualquier cosa extraña que encuentres y llévasela a Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Escalader la Tour du village de Sudevent, et trouver un moyen de mettre la ruche des silithides en activité. Toute chose inhabituelle doit être rapportée à Layo Starstrike, au cimetière du Repos des vaillants de Silithus.‡爬上南风村的塔，找寻激活异种蝎群的方法。把任何你认为不寻常的东西交给希利苏斯勇士之墓的莱耶·星击。‡爬上南風村的塔，找尋激活異種蠍群的方法。把任何妳認為不尋常的東西交給希利蘇斯勇士之墓的萊耶·星擊。',
  }
},
[1127] = {
  {
    'Cerveja Escura do Tonto‡"Дурацкое Крепкое"‡Fools Starkbier‡멍텅구리 스타우트 맥주‡Cerveza de tontos‡Cerveza de tontos‡Bière du sot‡蠢人酒‡蠢人酒',
    nil,
    'Leve 12 Preparados de Zanzil para Cranque Mirrabolha na Angra do Butim.‡Принесите 12 порций смеси Занзила Шиззи Пуззыриксу в Пиратскую бухту.‡Bringt 12 von Zanzils Mixturen zu Crank Fizzlebub in Booty Bay.‡무법항에 있는 크랭크 피즐버브에게 잔질의 혼합물 12개를 가져가야 합니다.‡Llévale 12 mezclas de Zanzil a Loquillo Pinchabujas, que está en Bahía del Botín.‡Llévale 12 mezclas de Zanzil a Loquillo Pinchabujas, que está en Bahía del Botín.‡Apporter 12 Mixtures de Zanzil à Crank Fizzlebub à Baie-du-Butin.‡收集12份赞吉尔的药剂，把它们交给藏宝海湾的克兰克·菲兹巴布。‡收集12份贊吉爾的藥劑，把它們交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1130] = {
  {
    'Melor mandou lembranças‡Весть от Мелора‡Melor schickt Kunde‡멜로르의 전갈‡Melor Pezuñapétrea‡Melor manda saludos‡Melor envoie un message‡梅洛的关注‡梅洛的關註',
    nil,
    'Fale com Melor Casco de Pedra no Penhasco do Trovão.‡Поговорите с Мелором Каменным Копытом в Громовом Утесе.‡Sprecht mit Melor Stonehoof in Thunder Bluff.‡썬더 블러프에 있는 멜로르 스톤후프와 대화하십시오.‡Habla con Melor Pezuñapétrea en Cima del Trueno.‡Habla con Melor Pezuña Pétrea en Cima del Trueno.‡Parler à Melor Stonehoof à Thunder Bluff.‡和雷霆崖的梅洛·石蹄交谈。‡和雷霆崖的梅洛·石蹄交談。',
  }
},
[1131] = {
  {
    'Estalaço‡Сталезуб‡Stahlbiss‡무쇠이빨 하이에나‡Metaleador‡Metaleador‡Broie-l\'acier‡钢齿土狼‡鋼齒土狼',
    nil,
    'Leve a Costela do Estalaço para Melor Casco de Pedra no Penhasco do Trovão.‡Принесите ребро Сталезуба Мелору Каменному Копыту в Громовой Утес.‡Bringt Stahlbiss\' Rippe zu Melor Stonehoof in Thunder Bluff.‡썬더 블러프의 멜로르 스톤후프에게 무쇠이빨 하이에나의 갈비뼈를 가져가야 합니다.‡Llévale la costilla de Metaleador a Melor Pezuñapétrea, que está en Cima del Trueno.‡Llévale la costilla de Metaleador a Melor Pezuña Pétrea, que está en Cima del Trueno.‡Apportez 1 Côte de Broie-l\'acier à Melor Stonehoof à Thunder Bluff.‡把钢齿土狼的肋骨带给雷霆崖的梅洛。‡把鋼齒土狼的肋骨帶給雷霆崖的梅洛。',
  }
},
[1132] = {
  {
    'Fiora Longorelhas‡Фиора Длинноушка‡Fiora Longears‡피오라 롱이어즈‡Fiora Orejona‡Fiora Orejona‡Fiora Longears‡菲欧拉·长耳‡菲歐拉·長耳',
    nil,
    'Fale com Fiora Longorelhas em Theramore.‡Поговорите с Фиорой Длинноушкой в Тераморе.‡Sprecht mit Fiora Longears in Theramore.‡테라모어에 있는 피오라 롱이어즈와 대화해야 합니다.‡Habla con Fiora Orejona en Theramore.‡Habla con Fiora Orejona en Theramore.‡S\'adresser à Fiora Longears à Theramore.‡和塞拉摩的菲欧拉·长耳谈一谈。‡和塞拉摩的菲歐拉·長耳談壹談。',
  }
},
[1133] = {
  {
    'Jornada para Astranaar‡Путешествие в Астранаар‡Reise nach Astranaar‡아스트라나르로의 여정‡Viaje a Astranaar‡Viaje a Astranaar‡Le voyage vers Astranaar‡通往阿斯特兰纳的旅途‡通往阿斯特蘭納的旅途',
    nil,
    'Fale com Shindrell Fogofugaz em Astranaar.‡Поговорите с Шиндрелл Огненный Всполох в Астранааре.‡Sprecht mit Shindrell Swiftfire in Astranaar.‡아스트라나르에 있는 신드렐 스위프트파이어와 대화하십시오.‡Habla con Shindrell Fuegoveloz en Astranaar.‡Habla con Shindrell Fuegoveloz en Astranaar.‡Parler à Shindrell Switfire à Astranaar.‡到阿斯特兰纳去和辛德瑞尔·速火谈谈。‡到阿斯特蘭納去和辛德瑞爾·速火談談。',
  }
},
[1134] = {
  {
    'Os asaltivas das Torres de Pedra‡Гордокрылы Каменного Когтя‡Prachtschwingen des Steinkrallengebirges‡돌발톱 산맥의 사자날개‡Alaorgullo del Esploón‡Alaorgullo del Espolón‡Les Ailes-fières des Serres-Rocheuses‡石爪山的双足飞龙‡石爪山的雙足飛龍',
    nil,
    'Leve 12 Vesículas de Peçonha de Asaltiva para Shindrell Fogofugaz em Astranaar.‡Принесите 12 ядовитых желез славнокрыла Шиндрелл Огненный Всполох в Астранаар.‡Bringt 12 Prachtschwingengiftbeutel zu Shindrell Swiftfire in Astranaar.‡아스트라나르에 있는 신드렐 스위프트파이어에게 사자날개 와이번 독주머니 12개를 가져가야 합니다.‡Lleva 12 sacos de veneno de alaorgullo a Shindrell Fuegoveloz en Astranaar.‡Lleva 12 sacos de veneno de alaorgullo a Shindrell Fuegoveloz en Astranaar.‡Apporter 12 Glandes de venin d\'Aile-fière à Shindrell Swiftfire à Astranaar.‡收集12个巨翼双足飞龙的毒囊，并把它们交给阿斯特兰纳的辛德瑞尔·速火。‡收集12個巨翼雙足飛龍的毒囊，並把它們交給阿斯特蘭納的辛德瑞爾·速火。',
  }
},
[1135] = {
  {
    'Veneno de Alcândora‡Яд из Скального гнездовья‡Steilhanggift‡마루둥지 와이번의 독‡Glándulas de veneno de Nido Alto‡Glándulas de veneno de Nido Alto‡Le venin de Haut-perchoir‡风巢双足飞龙的毒囊‡風巢雙足飛龍的毒囊',
    nil,
    'Leve 10 Vesículas de Peçonha de Alcândora para Fiora Longorelhas em Theramore.‡Принесите из Скального гнездовья 10 ядовитых желез для Фиоры Длинноушки в Терамор.‡Bringt 10 Steilhanggiftbeutel zu Fiora Longears in Theramore.‡테라모어에 있는 피오라 롱이어즈에게 마루둥지 와이번 독주머니 10개를 가져가야 합니다.‡Llévale 10 glándulas de veneno de Nido Alto a Fiora Orejona, que está en Theramore.‡Llévale 10 glándulas de veneno de Nido Alto a Fiora Orejona, que está en Theramore.‡Apporter 10 Glandes à venin de Haut-perchoir à Fiora Longears à Theramore.‡收集10个风巢双足飞龙的毒囊，把它们带给塞拉摩的菲欧拉·长耳。‡收集10個風巢雙足飛龍的毒囊，把它們帶給塞拉摩的菲歐拉·長耳。',
  }
},
[1136] = {
  {
    'Bocarragelo‡Ледочрев‡Frostrachen‡서리갈기 설인‡Faucehielo‡Faucehielo‡Gueule-glacée‡霜喉雪人‡霜喉雪人',
    nil,
    'Leve a Juba de Bocarragelo para Melor Casco de Pedra no Penhasco do Trovão.‡Принесите гриву Ледочрева Мелору Каменному Копыту в Громовой Утес.‡Bringt Frostrachens Mähne zu Melor Stonehoof in Thunder Bluff.‡썬더 블러프에 있는 멜로르 스톤후프에게 서리갈기 설인의 갈기를 가져가야 합니다.‡Lleva la melena de Faucehielo a Melor Pezuñapétrea en Cima del Trueno.‡Lleva la crin de Faucehielo a Melor Pezuña Pétrea en Cima del Trueno.‡Rapporter la Crinière de Gueule-glacée à Melor Stonehoof à Thunder Bluff.‡把霜喉雪人的鬃毛带给雷霆崖的梅洛·石蹄。‡把霜喉雪人的鬃毛帶給雷霆崖的梅洛·石蹄。',
  }
},
[1137] = {
  {
    'Um bizu para o xabu‡Новости для Пшикса‡Neuigkeiten für Fizzle‡피즐에게 전할 소식‡Noticias para Fizzle‡Noticias para Fizzle‡Des nouvelles pour Fizzle‡回复菲兹尔‡回復菲茲爾',
    nil,
    'Fale com Xabu Latafuso no Salar Cintilante.‡Поговорите с Пшиксом Медноштифтом на Мерцающей равнине.‡Sprecht mit Fizzle Brassbolts in der schimmernden Ebene.‡소금 평원에 있는 피즐 브라스볼츠와 대화하십시오.‡Habla con Fizzle Pernolatón en El Desierto de Sal.‡Habla con Fizzle Pernolatón en El Desierto de Sal.‡Parler à Fizzle Brassbolts dans les Salines.‡和闪光平原的菲兹尔·铜栓谈一谈。‡和閃光平原的菲茲爾·銅栓談壹談。',
  }
},
[1138] = {
  {
    'Frutos do mar‡Дары моря‡Meeresfrüchte‡바다의 열매‡Rico marisco‡Rico marisco‡Fruit de la mer‡海中的水果‡海中的水果',
    nil,
    'Recolha 6 Pedaços Delicados de Caranguejo para Gubber Blump em Auberdine.‡Соберите 6 кусочков отличного крабьего мяса для Груббера Блумпа в Аубердине.‡Sammelt 6 feine Krebsbrocken für Gubber Blump in Auberdine.‡맛좋은 게살 6개를 모아서 아우버다인에 있는 구버 블럼프에게 가져가야 합니다.‡Reúne 6 trozos de cangrejo de gran calidad para Gubber Blump de Auberdine.‡Reúne 6 trozos de cangrejo de gran calidad para Gubber Blump de Auberdine.‡Collecter 6 morceaux de Belle chair de crabe pour Gubber Blump, à Auberdine.‡收集6块优质蟹肉，把它们交给奥伯丁的古博·布拉普。‡收集6塊優質蟹肉，把它們交給奧伯丁的古博·布拉普。',
  }
},
[1139] = {
  {
    'As tabuletas perdidas da vontade‡Утерянные таблички Воли‡Die verlorene Tafel des Willens‡잃어버린 결의의 서판‡Las tablillas perdidas de Voluntad‡Las tablillas perdidas de Voluntad‡La tablette de volonté‡意志石板‡意誌石板',
    nil,
    'Encontre a Tabuleta da Vontade e leve-a para o Conselheiro Belgrum em Altaforja.‡Найдите табличку Воли и принесите ее советнику Белграму в Стальгорн.‡Sucht die Tafel des Willens und bringt sie zu Berater Belgrum in Ironforge.‡결의의 서판을 찾아 아이언포지에 있는 조언자 벨그룸에게 가져가야 합니다.‡Encuentra la tablilla de Voluntad y llévasela al consejero Belgrum en Forjaz.‡Encuentra la tablilla de Voluntad y llévasela al consejero Belgrum en Forjaz.‡Trouver la Tablette de Volonté et la rapporter au Conseiller Belgrum à Ironforge.‡找到意志石板，把它们交给铁炉堡的顾问贝尔格拉姆。‡找到意誌石板，把它們交給鐵爐堡的顧問貝爾格拉姆。',
  }
},
[1140] = {
  {
    'A torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Liberte a alma dos Altaneiros na Trilha da Noite e em Satyrnaar, depois fale novamente com Dinis, o Purificador, no Entreposto de Maestra.‡Освободите заточенные души высокорожденных на Ночной поляне и Сатирнааре, затем вернитесь к Делгрену Очистителю на заставу Мейстры.‡Befreit die Hochgeborenenseelen in Night Run und Satyrnaar und kehrt zu Delgren dem Läuterer in Maestras Posten zurück.‡어둠의 터와 사티로스나르에 갇혀 있는 명가의 영혼들을 구출하고 마에스트라 주둔지에 있는 수호자 델그렌에게 돌아가십시오.‡Libera las almas de los Altonato atrapadas en la Senda de la Noche y en Satyrnaar y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Libera las almas de los Altonato atrapadas en la Senda de la Noche y en Satyrnaar y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Libérer les Âmes de Bien-nés captives au défilé de la Nuit et à Satyrnaar, puis retourner voir Delgren le Purificateur au poste de Maestra.‡在夜道谷和萨提纳尔找到被禁锢的上层精灵的灵魂，释放它们，然后回到迈斯特拉岗哨的净化者德尔格伦那里。‡在夜道谷和薩提納爾找到被禁錮的上層精靈的靈魂，釋放它們，然後回到邁斯特拉崗哨的凈化者德爾格倫那裏。',
  }
},
[1141] = {
  {
    'Vara de canoeiro, prefere pescar‡Семья и рыболовная удочка‡Die Familie und die Angel‡블럼프가의 낚싯대‡La familia y la caña de pescar‡La familia y la caña de pescar‡La famille à la canne à pêche‡钓鱼世家‡釣魚世家',
    nil,
    'Pesque 6 Garoupas da Costa Negra para Gubber Blump em Auberdine.‡Поймайте 6 окуней Темного Берега для Груббера Блумпа в Аубердине.‡Fangt 6 Dunkelküstenbarsche für Gubber Blump in Auberdine.‡어둠의해안 농어 6마리를 잡아서 아우버다인에 있는 구버 블럼프에게 가져가야 합니다.‡Pesca 6 meros de Costa Oscura para Gubber Blump de Auberdine.‡Pesca 6 meros de Costa Oscura para Gubber Blump de Auberdine.‡Attraper 6 Mérous de Sombrivage pour Gubber Blump, à Auberdine.‡为奥伯丁的古博·布拉普抓6条黑海岸石斑鱼。‡為奧伯丁的古博·布拉普抓6條黑海岸石斑魚。',
  }
},
[1142] = {
  {
    'A mortalidade se esvanece‡Последнее желание‡Die Sterblichkeit schwindet‡꺼져가는 생명의 불씨‡Decaída mortal‡Decaída mortal‡Le déclin et la mort‡临终遗言‡臨終遺言',
    nil,
    'Encontre e devolva o Pingente de Treshala para Treshala Corregofulvo em Darnassus.‡Найдите подвеску Трешалы и верните ее Трешале Бурый Ручей в Дарнасс.‡Sucht und bringt Treshalas Anhänger zu Treshala Fallowbrook in Darnassus.‡트레샬라의 펜던트를 찾아 다르나서스에 있는 트레샬라 팰로우브룩에게 돌려주어야 합니다.‡Encuentra el colgante de Treshala Arroyobarbecho y llévaselo a Darnassus.‡Encuentra el colgante de Treshala Arroyobarbecho y llévaselo a Darnassus.‡Trouver et rapporter le Pendentif de Treshala à Treshala Fallowbrook à Darnassus.‡将塔莎拉的坠饰带给达纳苏斯的塔莎拉·静水。‡將塔莎拉的墜飾帶給達納蘇斯的塔莎拉·靜水。',
  }
},
[1143] = {
  {
    'A torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Mate Athrikus Narassin e leve a cabeça dele para Balthule Umbrataque perto da Torre de Althalaxx.‡Убейте Атрикуса Нарассина и принесите его голову Балтулу Удару Тени у башни Алталакса.‡Tötet Athrikus Narassin und bringt seinen Kopf zu Balthule Shadowstrike nahe des Turms von Althalaxx.‡애스리쿠스 나라신을 처치한 다음, 그 증거로 그의 머리 장식을 알살락스의 탑 근처에 있는 발툴 섀도스트라이크에게 가져가야 합니다.‡Mata a Athrikus Narassin y lleva su cabeza a Balthule Golpesombra que está cerca de La torre de Althalaxx.‡Mata a Athrikus Narassin y lleva su cabeza a Balthule Golpesombra que está cerca de La torre de Althalaxx.‡Tuer Athrikus Narassin et apporter sa Tête à Balthule Shadowstrike près de la Tour d\'Althalaxx.‡杀掉埃瑟里克斯·纳拉辛，把他的项上人头交给奥萨拉克斯之塔附近的巴苏尔·影击。‡殺掉埃瑟裏克斯·納拉辛，把他的項上人頭交給奧薩拉克斯之塔附近的巴蘇爾·影擊。',
  }
},
[1144] = {
  {
    'Importador Willix‡Импортер Вилликс‡Willix der Importeur‡수입업자 윌릭스‡Willix el Importador‡Willix el Importador‡Willix l’Importateur‡进口商威利克斯‡進口商威利克斯',
    nil,
    'Escolte o Importador Willix para fora do Urzal dos Tuscos.‡Сопроводите Вилликса из Лабиринтов Иглошкурых.‡Führt Willix den Importeur aus dem Kral von Razorfen hinaus.‡수입업자 윌릭스를 호위해 가시덩굴 우리에서 나가야 합니다.‡Ayuda a Willix el Importador a salir de Horado Rajacieno.‡Escolta a Willix el Importador hasta que salga del Horado Rajacieno.‡Escorter Willix l\'Importateur hors du Kraal de Tranchebauge.‡护送进口商威利克斯逃出剃刀沼泽。‡護送進口商威利克斯逃出剃刀沼澤。',
  }
},
[1145] = {
  {
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Leve o Bilhete Selado de Korran para Belgrom Pedramalho em Orgrimmar.‡Отнесите запечатанную записку Коррана Белгрому Каменной Булаве в Оргриммар.‡Stellt Korrans versiegelte Notiz Belgrom Rockmaul in Orgrimmar zu.‡오그리마에 있는 벨그롬 록마울에게 코란의 봉인된 쪽지를 전해야 합니다.‡Entrégale la nota sellada de Korran a Belgrom Destrozarroca en Orgrimmar.‡Entrégale la nota lacrada de Korran a Belgrom Destrozarroca en Orgrimmar.‡Remettre la Note scellée de Korran à Belgrom Rockmaul à Orgrimmar.‡把科兰的密信交给奥格瑞玛的贝尔戈洛姆·石槌。‡把科蘭的密信交給奧格瑞瑪的貝爾戈洛姆·石槌。',
  }
},
[1146] = {
  {
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Leve o Bilhete Selado de Belgrom para Moktar Krin em Mil Agulhas.‡Доставьте запечатанное письмо Белгрома Моктару Крину в Тысячу Игл.‡Stellt Belgroms versiegelte Notiz Moktar Krin in Tausend Nadeln zu.‡버섯구름 봉우리에 있는 목타르 크린에게 벨그롬의 봉인된 쪽지를 전해야 합니다.‡Entrégale la nota sellada de Belgrom a Moktar Krin en Las Mil Agujas.‡Entrégale la nota lacrada de Belgrom a Moktar Krin en Las Mil Agujas.‡Apporter la Note scellée de Belgrom à Moktar Krin aux Mille pointes.‡把贝尔戈洛姆的密信交给千针石林的摩克塔·克林。‡把貝爾戈洛姆的密信交給千針石林的摩克塔·克林。',
  }
},
[1147] = {
  {
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Mate 5 Farejadores Silitídeos, 5 Zangões Silitídeos da Colmeia e 5 Invasores Silitídeos, depois fale novamente com Moktar Krin em Mil Agulhas.‡Убейте 5 силитидов-искателей, 5 силитидов-трутней и 5 силитидов-захватчиков, а потом вернитесь к Моктару Крину в Тысячу Игл.‡Tötet 5 Silithidsucher, 5 Silithidschwarmdrohnen sowie 5 Silithideindringlinge und kehrt zu Moktar Krin in Tausend Nadeln zurück.‡탐색꾼 실리시드 5마리, 일꾼 실리시드 5마리, 병정 실리시드 5마리를 처치하고 버섯구름 봉우리에 있는 목타르 크린에게 돌아가야 합니다.‡Mata a 5 buscadores silítidos, 5 zánganos de la Colmena silítida y 5 invasores silítidos, y después ve a ver de nuevo a Moktar Krin a Las Mil Agujas.‡Mata a 5 buscadores silítidos, 5 zánganos de colmena silítidos y 5 invasores silítidos, y después ve a ver de nuevo a Moktar Krin a Las Mil Agujas.‡Tuer 5 Chercheurs silithides, 5 Bourdons silithides et 5 Envahisseurs silithides, puis retourner voir Moktar Krin aux Mille pointes.‡杀掉5只异种搜寻者、5只异种筑巢蝎和5只异种侵略者，然后向千针石林的摩克塔·克林复命。‡殺掉5只異種搜尋者、5只異種築巢蠍和5只異種侵略者，然後向千針石林的摩克塔·克林復命。',
  }
},
[1148] = {
  {
    'Pedaços do enxame‡Части роя‡Teile des Schwarms‡실리시드 등껍질‡Pedazos del enjambre‡Pedazos del enjambre‡Des parties de l\'essaim‡虫群的样本‡蟲群的樣本',
    nil,
    'Leve 1 Coração de Silitídeo, 5 Garras de Silitídeo e 3 Carapaças Intactas de Silitídeo para Korran na Encruzilhada.‡Добудьте 1 сердце, 5 шпор и 3 целых силитидских панциря для Коррана из Перекрестка.‡Bringt 1 Silithidenherz, 5 Silithidenkrallen und 3 intakte Silithidenknochenpanzer zu Korran in Crossroads.‡크로스로드에 있는 코란에게 실리시드의 심장 1개, 실리시드의 갈퀴발톱 5개, 온전한 실리시드의 등껍질 3개를 가져가야 합니다.‡Llévale 1 corazón de silítido, 5 espolones de silítido y 3 caparazones intactos de silítido a Korran, que está en El Cruce.‡Llévale 1 corazón de silítido, 5 garfas de silítido y 3 caparazones de silítido intactos a Korran, que está en El Cruce.‡Apporter 1 Coeur de silithide, 5 Serres de silithide et 3 Carapaces de silithide intactes à Korran, à la Croisée.‡收集1颗异种蝎的心脏、5只异种蝎的爪子和3个完整的异种蝎壳，把它们和你手中的这个破碎的异种蝎壳一起交给十字路口的科兰。‡收集1顆異種蠍的心臟、5只異種蠍的爪子和3個完整的異種蠍殼，把它們和妳手中的這個破碎的異種蠍殼壹起交給十字路口的科蘭。',
  }
},
[1149] = {
  {
    'Teste da Fé‡Испытание веры‡Test des Glaubens‡믿음의 시험‡Prueba de fe‡Prueba de fe‡L\'épreuve de la Foi‡信仰的试炼‡信仰的試煉',
    nil,
    'Se tiver fé, pule lá de cima das tábuas, no topo de Mil Agulhas.‡Если ваша вера сильна, прыгните с досок над Тысячью Игл.‡Wenn Ihr festen Glaubens seid, dann springt von den Planken über Tausend Nadeln.‡믿음이 있다면 버섯구름 봉우리가 내려다보이는 높은 곳에서 판자 아래로 뛰어내리십시오.‡Si tienes fe, salta desde las tablas que dominan Las Mil Agujas.‡Si tienes fe, salta desde las tablas que dominan Las Mil Agujas.‡Si vous avez la Foi, sautez des planches qui dominent les Mille pointes.‡如果你有坚定的信仰，就从那个可以俯瞰千针石林的木板跳下去。‡如果妳有堅定的信仰，就從那個可以俯瞰千針石林的木板跳下去。',
  }
},
[1150] = {
  {
    'Teste de resistência‡Испытание выносливости‡Test der Belastbarkeit‡인내의 시험‡Prueba de resistencia‡Prueba de resistencia‡L’épreuve de l’Endurance‡耐力的试炼‡耐力的試煉',
    nil,
    'Leve a Garra da Grenka para Dorn Espreitaprados em Mil Agulhas.‡Принесите коготь Гренки Дорну Вольному Ловчему в Тысячу Игл.‡Bringt Grenkas Klaue zu Dorn Plainstalker in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커에게 그렌카의 발톱을 가져가야 합니다.‡Llévale la garra de Grenka a Dorn Acechaprados, que está en Las Mil Agujas.‡Llévale la garra de Grenka a Dorn Acechallanos, que está en Las Mil Agujas.‡Apporter la Griffe de Grenka au traqueur des plaines Dorn, aux Mille pointes.‡把格林卡的爪子交给千针石林的多恩·平原行者。‡把格林卡的爪子交給千針石林的多恩·平原行者。',
  }
},
[1151] = {
  {
    'Teste de força‡Испытание силы‡Test der Kraft‡용기의 시험‡Prueba de fuerza‡Prueba de fuerza‡L\'épreuve de la Force‡力量的试炼‡力量的試煉',
    nil,
    'Leve os Fragmentos de Rok\'Alim para Dorn Espreitaprados em Mil Agulhas.‡Принесите фрагменты Рок\'Алима Дорну Вольному Ловчему в Тысячу Игл.‡Bringt Fragmente von Rok\'Alim zu Dorn Plainstalker in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커에게 로크알림의 파편을 가져가야 합니다.‡Llévale fragmentos de Rok\'Alim a Dorn Acechaprados, que está en Las Mil Agujas.‡Llévale fragmentos de Rok\'Alim a Dorn Acechallanos, que está en Las Mil Agujas.‡Apporter des Fragments de Rok\'Alim au traqueur des plaines Dorn dans les Mille pointes.‡把罗卡里姆的碎片交给千针石林的多恩·平原行者。‡把羅卡裏姆的碎片交給千針石林的多恩·平原行者。',
  }
},
[1152] = {
  {
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Encontre Braug Espírito Turvo perto da entrada do Túnel Garracava, na Cordilheira das Torres de Pedra.‡Найдите Брауга Тусклый Дух возле входа в Туннель Когтя в Когтистых горах.‡Sucht Braug Dimspirit in der Nähe des Eingangs zum Steinkrallenpfad im Steinkrallengebirge.‡돌발톱 산맥에 있는 돌발톱 토굴길 입구 근처에서 브라우그 딤스피릿을 찾아야 합니다.‡Encuentra a Braug Espiritoscuro cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Encuentra a Braug Espíritu Tenue cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Trouver Braug Dimspirit près de l’entrée de la Perce des Serres dans les Serres-Rocheuses.‡找到连接石爪山和灰谷的石爪小径里的布劳格·幽魂。‡找到連接石爪山和灰谷的石爪小徑裏的布勞格·幽魂。',
  }
},
[1153] = {
  {
    'Uma nova amostra de minério‡Образец новой руды‡Eine neue Erzprobe‡새로운 광석 견본‡Una nueva muestra de mineral‡Una nueva muestra de mineral‡Un nouveau minerai‡新的矿石样本‡新的礦石樣本',
    nil,
    'Obtenha uma Amostra Não Refinada de Minério de um Escavador Britanapa ou de um Topógrafo e leve para Trapista Forjaço no Acampamento Taurajo, que fica nos Sertões.‡Отберите неочищенный образец руды у землекопа или геодезиста из племени Камнерылов и принесите его Таттернаку Стальному Горну в Лагерь Таурахо в Степях.‡Sucht eine unbearbeitete Erzprobe bei einem Buddler oder Feldmesser der Bruchschnauzen und bringt sie zu Tatternack Steelforge im Camp Taurajo im Brachland.‡자갈주둥이일족 채굴꾼이나 흙점쟁이가 가지고 있는 정제하지 않은 광석 견본을 찾아 불모의 땅, 타우라조 야영지에 있는 테터낵 스틸포지에게 가져가야 합니다.‡Arrebátale una muestra de mineral no refinado a un cavador o a un perito Gravamorro y llévasela a Tatternack Forjacero al Campamento Taurajo de Los Baldíos.‡Arrebátale una muestra bruta de mena a un cavador o a un perito Gravamorro y llévasela a Jironack Forjacero al Campamento Taurajo de Los Baldíos.‡Trouver un échantillon de minerai brut sur un Mineur ou un Géomètre Mufle-de-gravier et l’apporter à Tatternack Steelforge, à Camp Taurajo dans les Tarides.‡从砂齿掘地工或砂齿勘探员那里找一块未精炼的矿石样本，把它交给陶拉祖营地的塔特纳克·钢炉。‡從砂齒掘地工或砂齒勘探員那裏找壹塊未精煉的礦石樣本，把它交給陶拉祖營地的塔特納克·鋼爐。',
  }
},
[1154] = {
  {
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Encontre o Legado dos Aspectos e leve-o para Braug Espírito Turvo perto da entrada do Túnel Garracava, na Cordilheira das Torres de Pedra.‡Найдите книгу "Наследие Аспектов" и вернитесь к Браугу Тусклому Духу ко входу в Туннель Когтя.‡Sucht das \'Vermächtnis der Aspekte\' und bringt es zu Braug Dimspirit in der Nähe des Eingangs zum Steinkrallenpfad im Steinkrallengebirge zurück.‡고대의 유산을 찾아 돌발톱 산맥에 있는 돌발톱 토굴길 입구 근처에서 브라우그 딤스피릿에게 가져가야 합니다.‡Encuentra el Legado de los Aspectos y devuélveselo a Braug Espiritoscuro que se encuentra cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Encuentra el Legado de los Aspectos y devuélveselo a Braug Espíritu Tenue que se encuentra cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Trouver l’Héritage des Aspects et l’apporter à Braug Dimspirit, à côté de l’entrée de la Perce des Serres, dans les Serres-Rocheuses.‡找到《巨龙的遗产》，把它还给位于灰谷和石爪山之间的石爪小径里的布劳格·幽魂。‡找到《巨龍的遺產》，把它還給位於灰谷和石爪山之間的石爪小徑裏的布勞格·幽魂。',
  }
},
