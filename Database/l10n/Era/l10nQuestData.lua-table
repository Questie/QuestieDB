},
[1181] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblin-Sponsoring‡고블린 후원‡Patrocinio goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡地精贊助商',
    nil,
    'Fale com o Barão Rezingada na Angra do Butim.‡Поговорите с бароном Ревилгазом в Пиратской бухте.‡Sprecht mit Baron Revilgaz in Booty Bay.‡무법항에 있는 남작 레빌가즈와 대화하십시오.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Parler au baron Revilgaz à Baie-du-Butin.‡与藏宝海湾的大财主里维加兹谈一谈。‡與藏寶海灣的大財主裏維加茲談壹談。',
  }
},
[1182] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblin-Sponsoring‡고블린 후원‡Apoyo al goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡地精贊助商',
    nil,
    'Leve os Esquemas do Regulador de Combustível para o Barão Rezingada na Angra do Butim.‡Принесите чертежи топливного регулятора барону Ревилгазу из Пиратской бухты.‡Bringt die Treibstoffreglerblaupausen zu Baron Revilgaz in Booty Bay.‡무법항에 있는 남작 레빌가즈에게 연료조절장치 설계도를 가져가야 합니다.‡Lleva los planos del regulador de combustible al Barón Revilgaz en la Bahía del Botín.‡Lleva los planos de regulador de combustible al Barón Revilgaz en la Bahía del Botín.‡Apporter les Plans du régulateur de fuel au baron Revilgaz à Baie-du-Butin.‡将燃料调节器的蓝图交给藏宝海湾的大财主里维加兹。‡將燃料調節器的藍圖交給藏寶海灣的大財主裏維加茲。',
  }
},
[1183] = {
  {
    'Patrocínio goblínico‡Гоблинская поддержка‡Goblin-Sponsoring‡고블린 후원‡Apoyo al goblin‡Patrocinio goblin‡Mécénat gobelin‡地精赞助商‡地精贊助商',
    nil,
    'Leve os Esquemas do Regulador de Combustível para Relé no Salar Cintilante.‡Отнесите чертежи топливного регулятора Поззику на Мерцающую равнину.‡Bringt die Blaupausen der Treibstoffeinspritzpumpe zu Pozzik in der schimmernden Ebene.‡소금 평원에 있는 포직에게 연료조절장치 설계도를 전해야 합니다.‡Entrega los planos del regulador de combustible a Pozzik en El Desierto de Sal.‡Entrega los planos de regulador de combustible a Pozzik en El Desierto de Sal.‡Apporter les Plans du Régulateur de carburant à Pozzik dans les Salines.‡把燃料调节器的蓝图带给闪光平原的普兹克。‡把燃料調節器的藍圖帶給閃光平原的普茲克。',
  }
},
[1184] = {
  {
    'Pedaços do enxame‡Части роя‡Teile des Schwarms‡실리시드 등껍질‡Pedazos del enjambre‡Pedazos del enjambre‡Des parties de l\'Essaim‡虫群的消息‡蟲群的消息',
    nil,
    'Fale novamente com Belgrom Pedramalho em Orgrimmar.‡Вернитесь к Белгрому Каменной Булаве в Оргриммар.‡Kehrt zu Belgrom Rockmaul in Orgrimmar zurück.‡오그리마에 있는 벨그롬 록마울에게 돌아가십시오.‡Ve a ver de nuevo a Belgrom Destrozarroca a Orgrimmar.‡Ve a ver de nuevo a Belgrom Destrozarroca a Orgrimmar.‡Retour à Orgrimmar pour voir Belgrom Rockmaul.‡回到奥格瑞玛的贝尔戈洛姆·石槌那儿。‡回到奧格瑞瑪的貝爾戈洛姆·石槌那兒。',
  }
},
[1185] = {
  {
    'Sob a carapaça de quitina...‡А под хитином было...‡Unter dem Chitin war...‡껍질 속에 담긴 비밀‡Debajo de la quitina había…‡Debajo de la quitina había...‡Sous la chitine...‡壳中的东西…‡殼中的東西…',
