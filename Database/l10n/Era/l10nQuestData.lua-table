[9415] = {
  {
    'Apresente-se ao Marechal Murazul‡Маршал Синяя Синестен‡Meldung bei Marschall Bluewall‡치안대장 블루월에게 보고‡Preséntate ante el alguacil Murazul‡Preséntate ante el alguacil Murazul‡Se présenter au maréchal Bluewall‡向布鲁沃尔元帅报告‡向布魯沃爾元帥報告',
    nil,
    'Fale com Marechal Murazul no acampamento da Aliança, perto da Colme\'Zora.‡Поговорите с маршалом Синестеном в лагере Альянса возле Улья Зора.‡Sprecht mit Marschall Bluewall beim Lager der Allianz in der Nähe des Zoraschwarmbaus.‡하이브조라 근처의 얼라이언스 야영지에 있는 치안대장 블루월과 대화해야 합니다.‡Habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Parlez au maréchal Bluewall au campement de l’Alliance, près de Ruche’Zora.‡与佐拉虫巢附近联盟营地的布鲁沃尔元帅谈一谈。‡與佐拉蟲巢附近聯盟營地的布魯沃爾元帥談壹談。',
  }
},
[9416] = {
  {
    'Apresente-se à General Kyríala‡Генерал Кирика‡Meldung bei General Kirika‡사령관 키리카에게 보고‡Preséntate ante el general Kirika‡Preséntate ante el general Kirika‡Se présenter au général Kirika‡向吉里卡将军报到‡向吉裏卡將軍報到',
    nil,
    'Fale com a General Kyríala no acampamento da Horda, perto da Colme\'Régia.‡Поговорите с генералом Кирикой в лагере Орды рядом с Ульем Регал.‡Sprecht mit General Kirika beim Lager der Horde in der Nähe des Regalschwarmbaus.‡하이브레갈 근처의 호드 야영지에 있는 사령관 키리카와 대화해야 합니다.‡Habla con el general Kirika en el campamento de la Horda cerca de Colmen\'Regal.‡Habla con el general Kirika en el campamento de la Horda cerca de Colmen\'Regal.‡Parlez au général Kirika au campement de la Horde, près de Ruche’Regal.‡与雷戈虫巢附近部落营地的吉里卡将军谈一谈。‡與雷戈蟲巢附近部落營地的吉裏卡將軍談壹談。',
  }
},
[9419] = {
  {
    'Limpeza do deserto‡Истощение пустыни‡Durchkämmen der Wüste‡사막 탐색‡Peinando el desierto‡Peinando el desierto‡Passer le désert au peigne fin‡横扫沙漠‡橫掃沙漠',
    nil,
    'Encontre e leve a Silitista até o Extrator de Silitista, então fale com o Marechal Murazul no acampamento da Aliança perto da Colme\'Zora.‡Найдите и принесите силитист к экстрактору силитистов и поговорите с маршалом Синестеном в лагере Альянса возле Улья Зора.‡Findet Silithyst, bringt es zum Silithystextraktor und sprecht anschließend mit Marschall Bluewall beim Lager der Allianz in der Nähe des Zoraschwarmbaus.‡실리시스트를 찾아서 실리시스트 추출기로 가져간 후, 하이브조라 근처 얼라이언스 주둔지에 있는 치안대장 블루월과 대화해야 합니다.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Trouver de la Silithyste et la livrer à l’ Extracteur de silithyste, puis parler au maréchal Bluewall au campement de l\'Alliance près de Ruche\'Zora.‡找到一份水晶尘，将其送到水晶尘萃取器那里，然后向佐拉虫巢外联盟营地的布鲁沃尔元帅复命。‡找到壹份水晶塵，將其送到水晶塵萃取器那裏，然後向佐拉蟲巢外聯盟營地的布魯沃爾元帥復命。',
  }
},
[9422] = {
  {
    'Limpeza do deserto‡Истощение пустыни‡Durchkämmen der Wüste‡사막 탐색‡Peinando el desierto‡Peinando el desierto‡Passer le désert au peigne fin‡横扫沙漠‡橫掃沙漠',
    nil,
    'Encontre e leve a Silitista até o Extrator de Silitista, então fale com a General Kyríala, no acampamento da Horda perto da Colme\'Régia.‡Найдите и принесите силитист к экстрактору силитистов и поговорите с генералом Кирикой в лагере Орды возле Улья Регал.‡Findet Silithyst, bringt es zum Silithystextraktor und sprecht anschließend mit General Kirika beim Lager der Horde in der Nähe des Regalschwarmbaus.‡실리시스트를 찾아서 실리시스트 추출기로 운반한 후, 하이브레갈 근처의 호드 야영지에 있는 사령관 키리카와 대화해야 합니다.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el general Kirika en el campamento de la horda cerca de Colmen\'Regal.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el general Kirika en el campamento de la horda cerca de Colmen\'Regal.‡Trouver de la Silithyste et la livrer à un Extracteur de silithyste, puis parler au général Kirika au campement de la Horde près de Ruche’Regal.‡找到一份水晶尘，将其送到水晶尘萃取器那里，然后向雷戈虫巢外部落营地的吉里卡将军复命。‡找到壹份水晶塵，將其送到水晶塵萃取器那裏，然後向雷戈蟲巢外部落營地的吉裏卡將軍復命。',
  }
},
