[6081] = {
  {
    'Treinando a fera‡Обучение зверя‡Die Ausbildung des Tiers‡야수 길들이기‡Entrenar a la bestia‡Domesticar la bestia‡Entraîner la bête‡训练野兽‡訓練野獸',
    nil,
    'Fale com Ormak Tiroatroz em Orgrimmar.‡Поговорите с Ормаком Лютострелом в Оргриммаре.‡Sprecht mit Ormak Grimshot in Orgrimmar.‡오그리마에 있는 오르막 그림샷과 대화하십시오.‡Habla con Ormak Tirosiniestro en Orgrimmar.‡Habla con Ormak Tirosiniestro en Orgrimmar.‡Adressez-vous à Orkmar Grimshot à Orgrimmar.‡与奥格瑞玛的奥玛克谈一谈。‡與奧格瑞瑪的奧瑪克談壹談。',
  }
},
[6082] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Escorpídeo Encouraçado. Pratique sua habilidade e depois fale novamente com Thotar no Monte Navalha.‡Приручите бронескорпа с помощью хлыста приручения. Потренируйтесь, потом вернитесь к Тотару в Колючем Холме.‡Benutzt die Zähmrute, um einen gepanzerten Skorpid zu zähmen. Übt Eure Fertigkeiten und kehrt zu Thotar in Klingenhügel zurück.‡조련용 막대를 사용해 등껍질전갈을 길들여야 합니다. 기술을 연습한 후 칼바위 언덕에 있는 소타르에게 돌아가십시오.‡Usa la fusta de domador para domar un escórpido acorazado. Practica un poco y devuélvele la fusta de domador a Thotar en Cerrotajo.‡Usa la fusta de doma para domar un escórpido acorazado. Practica un poco y devuélvele la fusta de doma a Thotar en Cerrotajo.‡Domptez un Scorpide blindé à l\'aide du Bâtonnet de domptage. Entraînez-vous puis retournez voir Thotar à Tranchecolline.‡使用驯兽棒驯服硬甲蝎。练习你的技能，然后将驯兽棒还给剃刀岭的索塔尔。‡使用馴獸棒馴服硬甲蠍。練習妳的技能，然後將馴獸棒還給剃刀嶺的索塔爾。',
  }
},
[6083] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Surfatisco. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Thotar no Monte Navalha.‡Приручите приливного краба с помощью хлыста приручения. Потренируйтесь, потом верните хлыст приручения Тотару в Колючем Холме.‡Benutzt die Zähmrute, um einen Brandungskriecher zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Thotar in Klingenhügel.‡조련용 막대를 사용해 붉은톱니게를 길들여야 합니다. 기술을 연습한 후 칼바위 언덕에 있는 소타르에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de domador para domar un correspuma. Practica un poco y devuélvele la fusta de domador a Thotar en Cerrotajo.‡Usa la fusta de doma para domar un reptador de espuma. Practica un poco y devuélvele la fusta de doma a Thotar en Cerrotajo.‡Utiliser le Bâtonnet de domptage pour dompter un Clampant de l\'écume. S’entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Thotar, à Tranchecolline.‡使用驯兽棒驯服海浪蟹。练习你的技能，然后将驯兽棒还给剃刀岭的索塔尔。‡使用馴獸棒馴服海浪蟹。練習妳的技能，然後將馴獸棒還給剃刀嶺的索塔爾。',
  }
},
[6084] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Leopardo da Neve. Pratique sua habilidade e depois fale novamente com Grif Selvacuore em Kharanos.‡Приручите снежного леопарда с помощью хлыста приручения. Потренируйтесь со своим новым питомцем, а затем верните хлыст приручения Грифу Дикому Сердцу в Каранос.‡Benutzt die Zähmrute, um einen Schneeleoparden zu zähmen. Übt Eure Fertigkeiten und kehrt dann zu Grif Wildheart in Kharanos zurück.‡조련용 막대를 사용해 눈표범을 길들여야 합니다. 기술을 연습한 후 카라노스에 있는 그리프 와일드하트에게 돌아가십시오.‡Usa la fusta de domador para domar un leopardo de las nieves. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Usa la fusta de doma para domar un leopardo de las nieves. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Domptez un Léopard des neiges à l\'aide du Bâtonnet de domptage. Entraînez-vous puis retournez voir Grif Wildheart à Kharanos.‡使用驯兽棒驯服雪豹。练习你的技能，然后将驯兽棒还给卡拉诺斯的格瑞夫。‡使用馴獸棒馴服雪豹。練習妳的技能，然後將馴獸棒還給卡拉諾斯的格瑞夫。',
  }
},
[6085] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Urso Garra de Gelo. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Grif Selvacuore em Kharanos.‡Приручите медведя-ледолапа с помощью хлыста приручения. Потренируйтесь со своим новым питомцем, а затем верните хлыст приручения Грифу Дикому Сердцу в Каранос.‡Benutzt die Zähmrute, um einen Eisklauenbären zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Grif Wildheart in Kharanos.‡조련용 막대를 사용해 얼음발톱흰곰을 길들여야 합니다. 기술을 연습한 후 카라노스에 있는 그리프 와일드하트에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de domador para domar un oso zarpahelada. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Usa la fusta de doma para domar un oso zarpahelada. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Domptez un ours Griffeglace à l\'aide du Bâtonnet de domptage. Entraînez-vous puis retournez voir Grif Wildheart à Kharanos.‡使用驯服兽棒驯服一头冰爪熊。练习你的技能，然后将驯兽棒还给卡拉诺斯的格瑞夫。‡使用馴服獸棒馴服壹頭冰爪熊。練習妳的技能，然後將馴獸棒還給卡拉諾斯的格瑞夫。',
  }
},
[6086] = {
  {
    'Treinando a fera‡Обучение зверя‡Die Ausbildung des Tiers‡야수 길들이기‡Entrenar a la bestia‡Domesticar la bestia‡Entraîner la bête‡训练野兽‡訓練野獸',
    nil,
    'Fale com Bélia Granitrondo em Altaforja.‡Поговорите в с Белией Громовым Гранитом в Стальгорне.‡Sprecht mit Belia Thundergranite in Ironforge.‡아이언포지에 있는 빌리아 썬더그래니트와 대화하십시오.‡Habla con Belia Tronagranito en Forjaz.‡Habla con Belia Tronagranito en Forjaz.‡Adressez-vous à Belia Thundergranite à Ironforge.‡与铁炉堡的贝莉亚·雷岩谈一谈。‡與鐵爐堡的貝莉亞·雷巖談壹談。',
  }
},
[6087] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Espreitador-da-pradaria. Pratique sua habilidade e depois devolva o Bastão a Yaw Crina Cortante na Aldeia Casco Sangrento.‡Приручите охотника прерий при помощи хлыста приручения. Потренируйтесь и верните хлыст Йо Колкой Гриве в Деревне Кровавого Копыта.‡Benutzt die Zähmrute, um einen Präriepirscher zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Yaw Sharpmane in Bloodhoof.‡조련용 막대를 사용해 긴발톱 초원늑대를 길들이고 기술을 연습한 후 블러드후프 마을에 있는 요 샤프메인에게 조련용 막대를 돌려줘야 합니다.‡Usa la fusta de domador para domar un acechador de pradera. Practica un poco y devuélvele la fusta a Yaw Trampa en el Poblado Pezuña de Sangre.‡Usa la fusta de doma para domar un acechador de pradera. Practica un poco y devuélvele la fusta a Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Utiliser le Bâtonnet de domptage pour dompter un Traqueur des prairies. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Yaw Sharpmane, au village Bloodhoof.‡使用驯兽棒驯服一只草原捕食者。练习你的技能，然后将驯兽棒还给血蹄村的雅文·刺鬃。‡使用馴獸棒馴服壹只草原捕食者。練習妳的技能，然後將馴獸棒還給血蹄村的雅文·刺鬃。',
  }
},
[6088] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Rapineiro. Pratique sua habilidade e depois devolva o Bastão a Yaw Crina Cortante na Aldeia Casco Sangrento.‡Приручите перепелятника при помощи хлыста приручения. Потренируйтесь и верните хлыст Йо Колкой Гриве в Деревне Кровавого Копыта.‡Benutzt die Zähmrute, um einen Sturzflieger zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Yaw Sharpmane in Bloodhoof.‡조련용 막대를 사용해 검독수리를 길들이고 기술을 연습한 후 블러드후프 마을에 있는 요 샤프메인에게 조련용 막대를 돌려줘야 합니다.‡Usa la fusta de domador para domar un aguilón. Practica un poco y devuélvele la fusta a Yaw Trampa en el Poblado Pezuña de Sangre.‡Usa la fusta de doma para domar un aguilón. Practica un poco y devuélvele la fusta a Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Utiliser le Bâtonnet de domptage pour dompter un Rapace. S’entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Yaw Sharpmane, au village Bloodhoof.‡使用驯兽棒驯服一只猛鹫。练习你的技能，然后将驯服法杖交还给血蹄村的雅文·刺鬃。‡使用馴獸棒馴服壹只猛鷲。練習妳的技能，然後將馴服法杖交還給血蹄村的雅文·刺鬃。',
  }
},
[6089] = {
  {
    'Treinando a fera‡Обучение зверя‡Die Ausbildung des Tiers‡야수 길들이기‡Entrenar a la bestia‡Domesticar la bestia‡Entraîner la bête‡训练野兽‡訓練野獸',
    nil,
    'Fale com Holto Chifre Troante no Platô dos Caçadores, que fica no Penhasco do Trovão.‡Поговорите с Хольтом Громовым Рогом в Громовом Утесе.‡Sprecht mit Holt Thunderhorn auf der Anhöhe der Jäger in Thunder Bluff.‡썬더 블러프의 수렵의 봉우리에 있는 홀트 썬더혼과 대화해야 합니다.‡Habla con Holt Astatrueno en el Alto de los Cazadores, en Cima del Trueno.‡Habla con Holt Tronacuerno en el Alto de los Cazadores, en Cima del Trueno.‡Parler à Holt Thunderhorn, sur la Cime des Chasseurs, à Thunder Bluff.‡与雷霆崖猎人高地的浩特·雷角谈一谈。‡與雷霆崖獵人高地的浩特·雷角談壹談。',
  }
},
[6101] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Espreitador Sabre-da-noite. Treine sua perícia, e depois devolva o Bastão de Adestramento a Dazalar em Dolanaar.‡С помощью хлыста приручения приручите ночного саблезуба-охотника. Поупражняйтесь, затем верните хлыст приручения Дазалару в Доланаар.‡Benutzt die Zähmerrute, um einen pirschenden Nachtsäbler zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Dazalar in Dolanaar.‡조련용 막대를 사용해 긴발톱 흑호를 길들여야 합니다. 기술을 연습한 후 돌라나르에 있는 다잘라에게 조련용 막대를 돌려주어야 합니다.‡Utiliza la fusta de domador para domar a un acechador sable de la noche. Practica tus habilidades y después devuélvele la fusta de domador a Dazalar, que está en Dolanaar.‡Utiliza la fusta de doma para domar a un acechador sable de la noche. Practica tus habilidades y después devuélvele la fusta de doma a Dazalar, que está en Dolanaar.‡Utiliser le Bâtonnet de domptage pour dompter un Rôdeur sabre-de-nuit. S’entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Dazalar, à Dolanaar.‡使用驯兽棒驯服一只夜刃捕食者。练习你的技能，然后将驯兽棒还给多兰纳尔的达扎拉。‡使用馴獸棒馴服壹只夜刃捕食者。練習妳的技能，然後將馴獸棒還給多蘭納爾的達紮拉。',
  }
},
[6102] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Guinchadora Estrígida. Treine sua perícia, e depois devolva o Bastão de Adestramento a Dazalar em Dolanaar.‡С помощью хлыста приручите совиного крикуна. Поупражняйтесь, затем верните хлыст приручения Дазалару в Доланаар.‡Benutzt die Zähmrute, um einen Strigidkreischer zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Dazalar in Dolanaar.‡조련용 막대를 사용해 비명소리 스트리기드 올빼미를 길들여야 합니다. 기술을 연습한 후 돌라나르에 있는 다잘라에게 조련용 막대를 돌려주어야 합니다.‡Utiliza la fusta de domador para domar a un estridador estrígido. Practica tus habilidades y después devuélvele la fusta de domador a Dazalar, que está en Dolanaar.‡Utiliza la fusta de doma para domar a un estridador estrígido. Practica tus habilidades y después devuélvele la fusta de doma a Dazalar, que está en Dolanaar.‡Utiliser le Bâtonnet de domptage pour dompter un Hurleur Strigid. S’entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Dazalar, à Dolanaar.‡使用驯兽棒驯服一只巨翼恶枭。练习你的技能，然后将驯兽棒还给多兰纳尔的达扎拉。‡使用馴獸棒馴服壹只巨翼惡梟。練習妳的技能，然後將馴獸棒還給多蘭納爾的達紮拉。',
  }
},
[6103] = {
  {
    'Treinando a fera‡Обучение зверя‡Die Ausbildung des Tiers‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Entraîner la bête‡训练野兽‡訓練野獸',
    nil,
    'Fale com Jocasta no Enclave Cenariano, que fica em Darnassus.‡Поговорите с Иокастой в анклаве Кенария в Дарнассе.‡Sprecht mit Jocaste in der Enklave des Cenarius in Darnassus.‡다르나서스의 세나리온 자치령에서 조카스테와 대화하십시오.‡Habla con Jocaste en el Enclave Cenarion de Darnassus.‡Habla con Jocaste en el Enclave Cenarion de Darnassus.‡Parler à Jocaste, à l\'enclave cénarienne de Darnassus.‡与达纳苏斯塞纳里奥区的祖卡斯特谈一谈。‡與達納蘇斯塞納裏奧區的祖卡斯特談壹談。',
  }
},
[6121] = {
  {
    'Novas lições‡Новый урок‡Neue Lektionen‡새로운 가르침‡Nuevas lecciones‡Nuevas lecciones‡Nouvelles leçons‡新的课程‡新的課程',
    nil,
    'Vá à Clareira da Lua e fale com Dendrite Stellardor no vilarejo de Refúgio Noturno.‡Отправляйтесь в Лунную поляну и поговорите с Дендритом Блеском Звезд в селении Ночная Гавань.‡Reist nach Moonglade und sprecht mit Dendrite Starblaze im Dorf Nighthaven.‡달의 숲으로 가서 나이트헤이븐 마을에 있는 덴드리트 스타블레이즈와 대화해야 합니다.‡Viaja a Claro de la Luna, al poblado Amparo de la Noche, y habla con Dendrita Rafagaestelar.‡Viaja a Claro de la Luna, al poblado Amparo de la Noche, y habla con Dendrita Rafagaestelar.‡Aller à Reflet-de-Lune, et parler à Dendrite Starblaze, au village de Havrenuit.‡到月光林地去，与永夜港的德迪利特·星焰谈一谈。‡到月光林地去，與永夜港的德迪利特·星焰談壹談。',
  }
},
[6122] = {
  {
    'A fonte principal‡Основной источник‡Die eigentliche Ursache‡오염된 수원‡La fuente del envenenamiento‡La fuente del envenenamiento‡Le principe originel‡毒水之源‡毒水之源',
    nil,
    'Use o Coletor Vazio das Quedas de Fontescarpa para coletar uma amostra de água da entrada da caverna da cachoeira.|nEntregue o Coletor Cheio das Quedas de Fontescarpa para Alanndária Noturcanto em Auberdine, na Costa Negra.‡Используйте пустую колбу для взятия пробы воды из устья пещеры у водопада Скалистый.|nДоставьте наполненную колбу Аландариан Песне Ночи в Аубердин, на Темный Берег.‡Benutzt das leere Gefäß bei Cliffspring Falls und nehmt eine Wasserprobe vom Höhleneingang bei den Wasserfällen.|nBringt das gefüllte Gefäß von Cliffspring Falls zu Alanndarian Nightsong nach Auberdine in Dunkelküste.‡빈 절벽 폭포 견본병을 이용해 폭포 옆에 있는 동굴 입구에서 물을 채취해야 합니다.|n물을 다 채우면, 아우버다인, 어둠의 해안에 있는 알란다리안 나이트송에게 가득 찬 절벽 폭포 견본병을 갖다주어야 합니다.‡Recoge agua de Salto de Fonroca a la entrada de la cueva.|nEntrégale la muestra llena de Salto de Fonroca a Alanndarian Arrullanoche; en Auberdine, en Costa Oscura.‡Recoge agua de Salto de Fonroca a la entrada de la cueva.|nEntrégale la muestra llena de Salto de Fonroca a Alanndarian Arrullanoche; en Auberdine, en Costa Oscura.‡Utiliser une Fiole d\'échantillon des Chutes de la Bondissante vide pour collecter un échantillon d’eau, à l’entrée de la grotte, à proximité des Chutes.|nApporter la Fiole d\'échantillon des Chutes de la Bondissante remplie à Alanndarian Nightsong, à Auberdine, dans Sombrivage.‡使用空的峭壁之泉取样器在瀑布洞口获得水样。|n将盛满的峭壁之泉取样器送到黑海岸奥伯丁的奥兰达利亚·夜歌那里。‡使用空的峭壁之泉取樣器在瀑布洞口獲得水樣。|n將盛滿的峭壁之泉取樣器送到黑海岸奧伯丁的奧蘭達利亞·夜歌那裏。',
  }
},
[6123] = {
  {
    'Colhendo a cura‡Сбор лекарственных ингредиентов‡Das Heilmittel sammeln‡약재 모으기‡Reunir los ingredientes del remedio‡Reunir los ingredientes del remedio‡Rassembler les ingrédients du remède‡收集解药‡收集解藥',
    nil,
    'Leve 5 Raízes-telúricas e 12 Fungos Lunares para Alanndária Noturcanto em Auberdine para que ela possa preparar o bálsamo curativo.‡Принесите 5 корешков землекорня и 12 лунных грибов Аландариан Песне Ночи в Аубердине, чтобы она могла сделать целительную мазь.‡Bringt 5 Erdwurzeln und 12 Lunarfungi zu Alanndarian Nightsong in Auberdine, damit sie eine Heilsalbe machen kann.‡아우버다인의 알란다리안 나이트송이 치료제를 만들 수 있도록 뱀뿌리 5개와 달버섯 12개를 가져다 주어야 합니다.‡Lleva 5 raíces de tierra y 12 hongos lunares a Alanndarian Arrullanoche a Auberdine, para que pueda preparar un bálsamo curativo.‡Lleva 5 raíces de tierra y 12 hongos lunares a Alanndarian Arrullanoche a Auberdine, para que pueda preparar un bálsamo curativo.‡Apporter 5 Terrestrines et 12 Champignons lunaires à Alanndarian Nightsong, à Auberdine ; elle pourra ainsi commencer à préparer son remède.‡收集5个地根草和12个月亮菇，把它们交给奥伯丁的奥兰达利亚·夜歌，这样她就可以制作解药了。‡收集5個地根草和12個月亮菇，把它們交給奧伯丁的奧蘭達利亞·夜歌，這樣她就可以制作解藥了。',
  }
},
[6124] = {
  {
    'Curando os doentes‡Исцеление больных‡Heilung der Kranken‡병든 사슴 치유‡Curar la dolencia‡Curar la dolencia‡Soigner la maladie‡消除疾病‡消除疾病',
    nil,
    'Use o Bálsamo Curativo para Animais em 10 Cervos Adoentados espalhados pela Costa Negra. Isso deve curá-los. Cervos Adoentados foram avistados da região ao sul do Rio Fontescarpa, seguindo até a área ao norte de Auberdine, até a Costa Negra meridional, na fronteira do Vale Gris.‡Нанесите мазь исцеления животных на 10 больных оленей, обитающих на Темном Берегу, – это должно их исцелить. По слухам, ареал обитания больных оленей – южнее реки Скалистой и севернее Аубердина, а далее – по всей области, вплоть до южных границ Темного Берега, где начинается Ясеневый лес.‡Benutzt die Tier-Heilsalbe bei 10 kranken Wildtieren rund um Dunkelküste. Das müsste sie heilen. Es wurde berichtet, dass krankes Wild südlich des Cliffspring, im Norden von Auberdine und bis hinunter in die südlichen Regionen von Dunkelküste, wo Ashenvale beginnt, aufgetaucht ist.‡어둠의 해안에 퍼져 있는 병든 사슴 10 마리에게 잘 듣는 동물 연고를 발라 치료해야 합니다. 병든 사슴은 폭포수 강 남부에서 아우버다인 북부까지 퍼져 있으며 잿빛 골짜기가 시작되는 어둠의 해안 남부까지 넘나든다고 합니다.‡Utiliza el bálsamo curativo para animales en los 10 ciervos enfermos que hay en Costa Oscura; el bálsamo debería curarlos. Se han avistado ciervos enfermos desde el sur del Río Fonroca hasta el norte de Auberdine y por toda la zona que lleva hasta el sur de Costa Oscura, donde empieza Vallefresno.‡Utiliza el bálsamo curativo para animales en los 10 ciervos enfermos que hay en Costa Oscura; el bálsamo debería curarlos. Se han avistado ciervos enfermos desde el sur del Río Fonroca hasta el norte de Auberdine y por toda la zona que lleva hasta el sur de Costa Oscura, donde empieza Vallefresno.‡Utiliser le Remède pour animaux sur 10 Daims malades qui se trouvent dans Sombrivage ; ceci les soignera. Les Daims malades ont été aperçus d’abord entre le sud de la rivière Bondissante et le nord d’Auberdine ; on en trouve également tout au sud de Sombrivage, à la frontière d’Ashenvale.‡对黑海岸的10头生病的鹿使用动物医疗药膏，以此来治疗它们。从壁泉河到奥伯丁，直到最南端靠近灰谷的地区都有生病的鹿出没。‡對黑海岸的10頭生病的鹿使用動物醫療藥膏，以此來治療它們。從壁泉河到奧伯丁，直到最南端靠近灰谷的地區都有生病的鹿出沒。',
  }
},
[6125] = {
  {
    'O poder sobre os venenos‡Власть над ядом‡Macht über Gift‡독을 다스리는 능력‡Poder contra el veneno‡Poder contra el veneno‡Pouvoir contre le poison‡解毒之术‡解毒之術',
    nil,
    'Fale novamente com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Вернитесь к Матренгилу Медвежьей Лапе в анклав Кенария в Дарнассе.‡Kehrt zu Mathrengyl Bearwalker in der Enklave des Cenarius in Darnassus zurück.‡다르나서스, 세나리온 자치령에 있는 마스렌길 베어워커에게 돌아가야 합니다.‡Vuelve a Darnassus para hablar con Mathrengyl Garroso en el Enclave Cenarion.‡Vuelve a Darnassus para hablar con Mathrengyl Garroso en el Enclave Cenarion.‡Retourner voir Mathrengyl Bearwalker, dans l’Enclave cénarienne, à Darnassus.‡回到达纳苏斯塞纳里奥区的玛斯雷·驭熊者那里。‡回到達納蘇斯塞納裏奧區的瑪斯雷·馭熊者那裏。',
  }
},
[6126] = {
  {
    'Novas lições‡Новый урок‡Neue Lektionen‡새로운 가르침‡Nuevas lecciones‡Nuevas lecciones‡Nouvelles leçons‡新的课程‡新的課程',
    nil,
    'Vá à Clareira da Lua e fale com Dendrite Stellardor no vilarejo de Refúgio Noturno.‡Отправляйтесь в Лунную поляну и поговорите с Дендритом Блеском Звезд в селении Ночная Гавань.‡Reist nach Moonglade und sprecht mit Dendrite Starblaze im Dorf Nighthaven.‡달의 숲으로 가서 나이트헤이븐 마을에 있는 덴드리트 스타블레이즈와 대화해야 합니다.‡Viaja a Claro de la Luna, al poblado Amparo de la Noche, y habla con Dendrite Rafagaestelar.‡Viaja a Claro de la Luna, al poblado Amparo de la Noche, y habla con Dendrita Rafagaestelar.‡Aller à Reflet-de-Lune, et parler à Dendrite Starblaze, au village de Havrenuit.‡到月光林地去，与永夜港的德迪利特·星焰谈一谈。‡到月光林地去，與永夜港的德迪利特·星焰談壹談。',
  }
},
[6127] = {
  {
    'A fonte principal‡Основной источник‡Die eigentliche Ursache‡오염된 수원‡La fuente del envenenamiento‡La fuente del envenenamiento‡Le principe originel‡毒水之源‡毒水之源',
    nil,
    'Use o Coletor Vazio do Morro de Brumedo para obter uma amostra de água de um lago no topo do morro.|nEntregue o Coletor Cheio do Morro de Brumedo a Tonga Runa Totem na Encruzilhada, nos Sertões.‡Используйте пустой пробоотборник Вершины Багрового Тумана для отбора воды из озера на вершине.|nДоставьте наполненный пробоотборник Вершины Багрового Тумана Тонге Руническому Тотему в Перекресток, что в Степях.‡Benutzt die leere Glutnebelgipfelprobe beim Glutnebelgipfel und nehmt eine Wasserprobe vom Teich auf der Spitze des Gipfels.|nBringt das gefüllte Behältnis vom Glutnebelgipfel zu Tonga Runetotem in Crossroads im Brachland.‡빈 공포의 안개봉우리 견본병을 봉우리 정상까지 가지고 가서 꼭대기 물웅덩이의 물을 채취해야 합니다.|n가득 찬 공포의 안개봉우리 견본병을 불모의 땅, 크로스로드에 있는 통가 룬토템에게 갖다주어야 합니다.‡Recoge agua de Cima Calígine en el estanque de la cima.|nLuego llévasela a Tonga Tótem Rúnico a El Cruce, en Los Baldíos.‡Usa el muestrario de Cima Calígine vacío para recoger una muestra de agua de uno de los estanques de la cima.|nLuego llévale el muestrario de Cima Calígine lleno a Tonga Tótem de Runa a El Cruce, en Los Baldíos.‡Utiliser la Fiole d\'échantillon vide du Pic de Brume-funeste pour collecter un échantillon de l’eau d’un bassin, au sommet du Pic de Brume-funeste.|nApporter ensuite la Fiole d\'échantillon remplie à Tonga Runetotem, à la Croisée, dans les Tarides.‡使用空的鬼雾峰取样器在山顶取水样。|n将盛满的鬼雾峰取样器送到贫瘠之地十字路口的图加·符文图腾那里。‡使用空的鬼霧峰取樣器在山頂取水樣。|n將盛滿的鬼霧峰取樣器送到貧瘠之地十字路口的圖加·符文圖騰那裏。',
  }
},
[6128] = {
  {
    'Colhendo a cura‡Создание лекарства‡Das Heilmittel sammeln‡약재 모으기‡Reunir los ingredientes del remedio‡Reunir los ingredientes del remedio‡Rassembler les ingrédients du remède‡收集解药‡收集解藥',
    nil,
    'Leve 5 Raízes-telúricas e 5 Chifres de Kodo para Tonga Runa Totem na Encruzilhada para que ele possa preparar um bálsamo curativo.‡Принесите 5 корешков землекорня и 5 рогов кодо Тонге Руническому Тотему в Перекресток, и он сделает целебную мазь.‡Bringt 5 Erdwurzeln und 5 Kodohörner zu Tonga Runetotem in Crossroads, damit er eine Heilsalbe machen kann.‡크로스로드의 통가 룬토템이 치료제를 만들 수 있도록 뱀뿌리 5개와 코도 뿔 5개를 갖다주어야 합니다.‡Llévale 5 raíces de tierra y 5 cuernos de kodo a Tonga Runatótem en El Cruce para que pueda confeccionar un bálsamo curativo.‡Llévale 5 raíces de tierra y 5 cuernos de kodo a Tonga Tótem de Runa en El Cruce para que pueda confeccionar un bálsamo curativo.‡Apporter 5 Terrestrines et 5 Cornes de kodo à Tonga Runetotem, à la Croisée, pour qu\'il puisse préparer un baume curatif.‡收集5个地根草和5个科多兽角，把它们交给十字路口的图加·符文图腾，这样他就可以制作解药了。‡收集5個地根草和5個科多獸角，把它們交給十字路口的圖加·符文圖騰，這樣他就可以制作解藥了。',
  }
},
[6129] = {
  {
    'Curando os doentes‡Исцеление больных‡Heilung der Kranken‡병든 가젤 치유‡Curar la dolencia‡Curar la dolencia‡Soigner la maladie‡消除疾病‡消除疾病',
    nil,
    'Use o Bálsamo Curativo para Animais em 10 Gazelas Doentes espalhadas pelo norte dos Sertões. Isso deve curá-las. Gazelas Doentes foram avistadas por toda parte a norte da estrada leste-oeste, que atravessa a Encruzilhada.‡Нанесите мазь исцеления животных на 10 больных газелей, обитающих в северной части Степей, – это должно их вылечить. По слухам, больные газели живут севернее дороги, проходящей через Перекресток с востока на запад.‡Benutzt die heilende Tiersalbe bei 10 kränklichen Gazellen im nördlichen Teil des Brachlandes. Das müsste sie heilen. Kränkliche Gazellen wurden überall nördlich der Ost-West-Straße durch Crossroads gesehen.‡불모의 땅 북부에 퍼져 있는 병든 가젤 10마리를 찾아 잘 듣는 동물 연고를 발라서 치료해야 합니다. 병든 가젤은 크로스로드를 동서로 가로지르는 길의 북쪽에 있다고 합니다.‡Usa el bálsamo animal curativo sobre las 10 gacelas enfermas que se encuentran en la parte norte de Los Baldíos; así se curarán. Hemos recibido informes según los cuales se han avistado gacelas enfermas por la carretera que va de este a oeste en El Cruce.‡Usa el bálsamo animal curativo sobre las 10 gacelas enfermas que se encuentran en la parte norte de Los Baldíos; así se curarán. Hemos recibido informes según los cuales se han avistado gacelas enfermas por la carretera que va de este a oeste en El Cruce.‡Utiliser le Remède pour animaux sur 10 Gazelles malades qui se trouvent dans la partie nord des Tarides ; ceci les soignera. Les Gazelles malades ont été vues au nord de la route orientée est-ouest qui traverse la Croisée.‡对贫瘠之地北部的10只生病的瞪羚使用动物医疗药膏，以此来治疗它们。在穿过十字路口的那条东西走向的大路北面到处都是生病的蹬羚。‡對貧瘠之地北部的10只生病的瞪羚使用動物醫療藥膏，以此來治療它們。在穿過十字路口的那條東西走向的大路北面到處都是生病的蹬羚。',
  }
},
[6130] = {
  {
    'O poder sobre os venenos‡Власть над ядом‡Macht über Gift‡독을 다스리는 능력‡Poder contra el veneno‡Poder contra el veneno‡Pouvoir contre le poison‡解毒之术‡解毒之術',
    nil,
    'Fale novamente com Turak Runa Totem no Platô dos Anciãos, no Penhasco do Trovão.‡Вернитесь к Тюраку Руническому Тотему на Вершину Старейшин в Громовой Утес.‡Kehrt zu Turak Runetotem auf der Anhöhe der Ältesten in Thunder Bluff zurück.‡썬더 블러프 장로의 봉우리에 있는 투락 룬토템에게 돌아가야 합니다.‡Vuelve a Cima del Trueno para hablar con Turak Tótem Rúnico en Alto de los Ancestros.‡Vuelve a Cima del Trueno para hablar con Turak Tótem de Runa en Alto de los Ancestros.‡Retourner voir Turak Runetotem, sur la Cime des Anciens, à Thunder Bluff.‡回到雷霆崖长者高地的图拉克·符文图腾那里。‡回到雷霆崖長者高地的圖拉克·符文圖騰那裏。',
  }
},
[6132] = {
  {
    'Me tira daqui!‡Вытащи меня отсюда!‡Holt mich hier raus!‡멜릿자 브림버즐 구출 작전‡¡Sácame de aquí!‡¡Sácame de aquí!‡Faites-moi sortir de là !‡救我出去！‡救我出去！',
    nil,
    'Escolte Melizza Zumbidorla e depois fale com Guido Zumbidorla no Cemitério dos Kodos, na Desolação.‡Проводите Мелиццу Жужжалит в лагерь у Кладбища кодо в Пустошах. Поговорите с Хормицем Жужжалитом.‡Eskortiert Melizza Brimbuzzle und sprecht anschließend mit Hornizz Brimbuzzle beim Kodofriedhdof Desolace.‡멜릿자 브림버즐을 호위한 후, 잊혀진 땅의 코도 무덤에 있는 호르니즈 브림버즐과 대화해야 합니다.‡Escolta a Melizza Zumbala y luego ve a Desolace, al Cementerio de Kodos y habla con Hornizz Zumbala.‡Escolta a Melizza Zumbala, y luego habla con Hornizz Zumbala en el Cementerio de Kodos en Desolace.‡Escorter Melizza Brimbuzzle, puis parler à Hornizz Brimbuzzle au cimetière des Kodos en Désolace.‡护送梅丽萨，然后与科多兽坟场的霍恩尼兹谈一谈。‡護送梅麗薩，然後與科多獸墳場的霍恩尼茲談壹談。',
  }
},
[6133] = {
  {
    'A mando do lorde patrulheiro‡Охота на cледопытов‡Das Ersuchen des Waldläuferlords‡순찰대장의 명령‡La orden del Señor de exploradores‡La orden del Señor forestal‡L\'ordre du seigneur forestier‡游侠之王的命令‡遊俠之王的命令',
    nil,
    'Vá à fronteira norte das Terras Pestilentas Orientais e recupere os Arquivos de Quel\'Thalas em algum lugar do Abrigo Quel\'Lithien.|nVocê também precisa matar 8 Patrulheiros, 8 Trilheiros e 8 Mateiros.‡Отправляйтесь в северные пределы Восточных Чумных земель и заполучите реестр Кель\'Таласа. Документ находится где-то в Сторожке Кель\'Литиен.|nТакже убейте 8 следопытов, 8 разведчиц дорог и 8 лесников.‡Begebt Euch zur nördlichsten Grenze der Östlichen Pestländer und bringt die Quel\'Thalas-Registratur zurück. Der Gegenstand befindet sich irgendwo in der Quel\'Lithien-Lodge.|nAußerdem müsst Ihr 8 Waldläufer, 8 Pfadschreiter und 8 Waldarbeiter töten.‡동부 역병지대의 북쪽 경계로 이동하여 쿠엘탈라스 기록부를 찾아야 합니다. 기록부는 쿠엘리시엔 오두막 어딘가에 있습니다.|n순찰자 8명, 길잡이 8명, 수렵꾼 8명을 해치워야 합니다.‡Viaja a la frontera norte de las Tierras de la Peste del Este y recupera el Registro de Quel\'Thalas. Se encuentra en algún lugar del Refugio Quel\'Lithien.|nTambién tienes que matar a 8 exploradores, 8 zancaminos y 8 Leñantros.‡Viaja a la frontera norte de las Tierras de la Peste del Este y recupera el Registro de Quel\'Thalas. Se encuentra en algún lugar del Refugio Quel\'Lithien.|nTambién tienes que matar a 8 forestales, 8 zancaminos y 8 leñadores.‡Aller vers la frontière nord des Maleterres de l’est et récupérer le Registre de Quel\'Thalas. L’objet se trouve quelque part dans le gîte de Quel\'Lithien.|nTuer également 8 Forestiers, 8 Eclaireurs et 8 Bûcherons.‡到东瘟疫之地的北方边界去找回奎尔萨拉斯名册，这件物品在奎尔林斯小屋的某处。|n另外你还必须杀掉8个游侠、8个巡路者和8个护林者。‡到東瘟疫之地的北方邊界去找回奎爾薩拉斯名冊，這件物品在奎爾林斯小屋的某處。|n另外妳還必須殺掉8個遊俠、8個巡路者和8個護林者。',
  }
},
[6134] = {
  {
    'Vá catar fantasmoplasma!‡Сбор эктоплазмы‡Geisterplasmasuche‡유령의 플라스마 모으기‡La caza de ectoplamas‡La caza de ectoplasmas‡Chasse à l\'ectoplasme‡幽灵电浆‡幽靈電漿',
    nil,
    'Leve 8 Fantasmoplasmas e o Caixote de Ímãs Fantasmais para Guido Zumbidorla na Desolação.‡Принесите 8 единиц эктоплазмы и ящик призрачных магнитов Хормицу Жужжалиту в Пустоши.‡Bringt 8 Einheiten Geisterplasma und die Kiste mit den Geistermagneten zu Hornizz Brimbuzzle in Desolace.‡잊혀진 땅의 호르니즈 브림버즐에게 유령의 플라스마 8개와 유령 유인기 상자를 가져가야 합니다.‡Lleva 8 ectoplasmas y la caja de imanes fantasmales a Hornizz Zumbala a Desolace.‡Llévale 8 ectoplasmas y el cajón de imanes fantasmales a Hornizz Zumbala en Desolace.‡Apporter 8 Fantôm-o-plasmes et la Caisse d\'aimants fantômes à Hornizz Brimbuzzle, en Désolace.‡把幽灵磁铁箱和8份幽灵电浆交给凄凉之地的霍恩尼兹。‡把幽靈磁鐵箱和8份幽靈電漿交給淒涼之地的霍恩尼茲。',
  }
},
[6135] = {
  {
    'Ah, Quiroscuro, como vos odeio...‡Проклятый Тенекрыл‡Dämmerschwinge, oh, wie ich Euch hasse...‡혐오스런 그늘날개‡Alatardecer, cómo te odio…‡Alaocaso, cómo te odio...‡Crépuscaile, oh comme je te hais !‡暗翼蝠‡暗翼蝠',
    nil,
    'Encontre Quiroscuro e mate-o. Do cadáver, extraia um Tufo de Pele de Quiroscuro e leve para Nathanos Arauto da Praga.|nDizem que Quiroscuro vaga pelo campo ao norte do Sítio dos Marris.‡Выследите Тенекрыла и убейте его. Принесите полоску меха Тенекрыла Натаносу Гнилостеню.|nГоворят, Тенекрыл рыщет в землях к северу от имения Марриса.‡Sucht Dämmerschwinge und tötet ihn. Nehmt ein Büschel vom Fell Dämmerschwinges und bringt es zu Nathanos Blightcaller.|nMan sagt, dass Dämmerschwinge nördlich von hier durch das Land streift.‡마리스 농장 북부의 변두리를 배회하고 있는 그늘날개를 찾아 해치워야 합니다. 시체에서 그늘날개 모피 조각을 찾아 나타노스 브라이트콜러에게 가져가야 합니다.‡Encuentra a Alatardecer y mátalo. Recoge un parche de piel de Alatardecer de su cadáver y llévaselo a Nathanos Clamorinfecto.|nSe dice que Alatardecer vaga por el campo, al norte de la Hacienda de Marris.‡Encuentra a Alaocaso y mátalo. Recoge un parche de pelaje de Alaocaso de su cadáver y llévaselo a Nathanos Clamañublo.|nSe dice que Alaocaso vaga por el campo, al norte de la Hacienda de Marris.‡Trouver Crépuscaile et la tuer. Récupérer une Touffe de fourrure de Crépuscaile sur son cadavre, puis l’apporter à Nathanos le Flétrisseur.|nIl paraît que Crépuscaile hante les terres qui se trouvent au nord de la ferme des Marris.‡找到暗翼蝠并杀掉它。从尸体上取下一块暗翼蝠的皮，并把它交给纳萨诺斯·凋零者。|n据说暗翼蝠游荡在玛瑞斯农场北面的荒原上。‡找到暗翼蝠並殺掉它。從屍體上取下壹塊暗翼蝠的皮，並把它交給納薩諾斯·雕零者。|n據說暗翼蝠遊蕩在瑪瑞斯農場北面的荒原上。',
  }
},
[6136] = {
  {
    'O corpulento‡Огромный червь‡Der Korpulente‡뚱뚱보 괴물‡El corpulento‡El corpulento‡Le corpulent‡肥大的食腐虫‡肥大的食腐蟲',
    nil,
    'Encontre Brocassangre nos ermos do norte das Terras Pestilentas e destrua-o. Fale novamente com Nathanos Arauto da Praga quando tiver cumprido a missão.‡Найдите и уничтожьте Мерзкослиза в северных пустошах Восточных Чумных земель. Возвращайтесь к Натаносу Гнилостеню по выполнению задания.‡Sucht in den nördlichen Wüsten der Östlichen Pestländer nach Blutschlinger und vernichtet ihn. Kehrt zu Nathanos Blightcaller zurück, sobald Ihr diese Mission erledigt habt.‡동부 역병지대 북부 불모지에서 피고름구더기를 찾아 물리친 후 나타노스 블라이트콜러에게 돌아가야 합니다.‡Encuentra a Borelgore en las planicies del norte de las Tierras de la Peste del Este y destrúyelo. Vuelve junto a Nathanos Clamorinfecto cuando hayas cumplido la misión.‡Encuentra a Borelgore en las planicies del norte de las Tierras de la Peste del Este y destrúyelo. Vuelve junto a Nathanos Clamañublo cuando hayas cumplido la misión.‡Trouver Creusechair, dans les terres au nord des Maleterres de l’est, et le tuer. Retourner voir Nathanos le Flétrisseur quand la mission sera terminée.‡找到东瘟疫之地北方荒原中的淤血虫并消灭它。任务完成之后，向纳萨诺斯·凋零者复命。‡找到東瘟疫之地北方荒原中的淤血蟲並消滅它。任務完成之後，向納薩諾斯·雕零者復命。',
  }
},
[6141] = {
  {
    'Irmão Anton‡Брат Антон‡Bruder Anton‡수사 안톤‡Hermano Antón‡Hermano Anton‡Frère Anton‡安东修士‡安東修士',
    nil,
    'Fale com o Irmão Anton na Desolação.‡Найдите в Пустошах брата Антона и поговорите с ним.‡Sprecht mit Bruder Anton in Desolace.‡잊혀진 땅에 있는 수사 안톤과 대화해야 합니다.‡Habla con el hermano Antón en Desolace.‡Habla con el hermano Anton en Desolace.‡Adressez-vous au frère Anton, en Désolace.‡与凄凉之地的安东修士谈一谈。‡與淒涼之地的安東修士談壹談。',
  }
},
[6142] = {
  {
    'Boa isca‡Наживка из моллюска‡Muschelköder‡조개 미끼‡Almejas‡Almejas‡Des praires comme appât‡蚌肉鱼饵‡蚌肉魚餌',
    nil,
    'Encontre 10 nacos de Carne de Marisco de Casca Mole e entregue-os para Mai\'Lahii na Aldeia Pescassombra.‡Найдите 10 кусочков мяса мягкокожего моллюска и принесите Май\'Лахии в Деревню Ночных Охотников.‡Sucht 10 Teile Fleisch der weichschaligen Muschel und bringt sie zu Mai\'Lahii im Dorf Shadowprey.‡연갑 조갯살 10개를 찾은 후, 그늘수렵 마을에 있는 마이라힐에게 가져가야 합니다.‡Encuentra 10 piezas de carne de almeja blanda y llévaselas a Mai\'Lahii a la Aldea Cazasombras.‡Encuentra 10 piezas de carne de almeja blanda y llévaselas a Mai\'Lahii a la Aldea Cazasombras.‡Trouver 10 morceaux de Chair de praire et les apporter à Mai\'Lahii, à Proie-de-l\'Ombre.‡找到10块软壳蚌肉，把它们交给葬影村的麦拉斯。‡找到10塊軟殼蚌肉，把它們交給葬影村的麥拉斯。',
  }
},
[6143] = {
  {
    'Camarão que dorme a onda leva‡Смерть земноводным!‡Andere Fische zu grillen‡나가 퇴치‡Otros pescados para freír‡Otros pescados para freír‡D\'autres poissons à frire‡另一种鱼‡另壹種魚',
    nil,
    'Mate 7 Mirmidões Sibilâmina, 7 Nagas Sibilâmina e 5 Feiticeiras Sibilâmina. Em seguida, fale com Drulzeger, na Aldeia Pescassombra, em Desolação.‡Убейте 7 мирмидонов, 7 наг и 5 колдуний из клана Скользящего Плавника, а затем вернитесь в деревню Сумеречной Охоты и поговорите с Друлзегаром.‡Tötet 7 Myrmidonen der Zackenkämme, 7 Naga der Zackenkämme und 5 Zauberhexerinnen der Zackenkämme, dann sprecht in Desolace mit Drulzegar in Shadowprey.‡뱀갈퀴일족 미르미돈 7마리, 뱀갈퀴일족 나가 7마리, 뱀갈퀴일족 여마법사 5마리를 처치한 후, 잊혀진 땅의 그늘수렵 마을에 있는 드룰제가르와 대화해야 합니다.‡Mata a 7 mirmidones Filozante, 7 nagas Filozante y 5 hechiceras Filozante y luego ve a Cazasombras, en Desolace, a hablar con Drulzegar.‡Mata a 7 mirmidones Filozante, 7 nagas Filozante y 5 hechiceras Filozante y luego ve a Cazasombras, en Desolace, a hablar con Drulzegar.‡Tuer 7 Myrmidons Ondulame, 7 Nagas Ondulame et 5 Sorcières Ondulame, puis parler à Drulzegar, à Proie-de-l\'Ombre, en Désolace.‡杀死7个滑刃侍从、7个滑刃纳迦，以及5个滑刃巫师，然后与葬影村的杜泽加尔谈谈。‡殺死7個滑刃侍從、7個滑刃納迦，以及5個滑刃巫師，然後與葬影村的杜澤加爾談談。',
  }
},
[6144] = {
  {
    'Chamado ao comando‡Приказ по армии‡Der Befehl‡지휘 임무‡La llamada del teniente‡La llamada del teniente‡L\'appel du commandement‡上级的命令‡上級的命令',
    nil,
    'Vá à Cidade Baixa e fale com Varimatras.‡Отправляйтесь в Подгород и предстаньте перед Вериматасом.‡Reist in die Undercity und sprecht mit Varimathras.‡언더시티로 가서 바리마트라스와 대화해야 합니다.‡Ve a Entrañas y habla con Varimathras.‡Viaja a Entrañas y habla con Varimathras.‡Aller à Undercity et parler à Varimathras.‡到幽暗城去与瓦里玛萨斯谈一谈。‡到幽暗城去與瓦裏瑪薩斯談壹談。',
  }
},
[6145] = {
  {
    'O mensageiro carmesim‡Курьер из Багрового Легиона‡Der Purpurrote Kurier‡진홍십자군 급사‡El mensajero carmesí‡El mensajero carmesí‡Le messager cramoisi‡红衣信使‡紅衣信使',
    nil,
    'Volte às Terras Pestilentas Orientais e rastreie o Mensageiro Carmesim. Mate o mensageiro e obtenha as Ordens do Grão-cruzado.|nLeve-as para Nathanos Arauto da Praga para obter suas próximas instruções.‡Возвращайтесь в Восточные Чумные земли и выследите курьера из Багрового Легиона. Убейте его и заберите приказ верховного рыцаря.|nЗа дальнейшими указаниями обращайтесь к Натаносу Гнилостеню.‡Kehrt in die östlichen Pestländer zurück und spürt den Purpurroten Kurier auf. Tötet den Kurier und schnappt Euch den Befehl des obersten Kreuzzüglers.|nBringt den Befehl zu Nathanos Blightcaller und wartet auf weitere Anweisungen.‡동부 역병지대로 돌아가 진홍십자군 급사를 추적해야 합니다. 급사를 처치하고 십자군 사령관의 명령서를 회수해야 합니다.|n이 명령서를 나타노스 블라이트콜러에게 가져다주고 다음 지시를 받으십시오.‡Vuelve a las Tierras de la Peste del Este y encuentra al mensajero carmesí. Mata al mensajero y recupera la Orden del Gran Cruzado.|nLleva el documento a Nathanos Clamorinfecto y espera sus instrucciones.‡Vuelve a las Tierras de la Peste del Este y encuentra al mensajero carmesí. Mata al mensajero y recupera la Orden del Gran Cruzado.|nLleva el documento a Nathanos Clamañublo y espera sus instrucciones.‡Retourner dans les Maleterres de l’est et traquer le Messager cramoisi, le tuer et récupérer les Ordres du Grand Croisé.|nApporter les Ordres à Nathanos le Flétrisseur pour obtenir des instructions supplémentaires.‡返回东瘟疫之地，找到并杀死红衣信使，拿到大十字军的命令。|n把命令交给纳萨诺斯·凋零者，并等待进一步的指示。‡返回東瘟疫之地，找到並殺死紅衣信使，拿到大十字軍的命令。|n把命令交給納薩諾斯·雕零者，並等待進壹步的指示。',
  }
},
[6146] = {
  {
    'O ardil de Nathanos‡Уловка Натаноса‡Nathanos\' List‡나타노스의 책략‡La estratagema de Nathanos‡La estratagema de Nathanos‡La ruse de Nathanos‡纳萨诺斯的计谋‡納薩諾斯的計謀',
    nil,
    'Vá à Manopla de Tyr, a sudeste do Sítio dos Marris. Quando chegar lá, coma um pedaço da Maçã Podre. Com o disfarce da Cruzada Escarlate, entregue as Ordens do Grão-cruzado ao Lorde Cruzado Valdelmar.‡Отправляйтесь в Длань Тира к юго-востоку от Поместья Маррисов. Прибыв в город, откусите от гнилого яблока. Под личиной рыцаря Алого ордена доставьте приказ верховного рыцаря лорду-рыцарю Вальдермару.‡Reist nach Tyrs Hand, südöstlich der Siedlung Marris. Dort angekommen beißt in den faulen Apfel. In der Verkleidung des Scharlachroten Kreuzzugs überbringt Ihr Lord Valdelmar den Befehl des obersten Kreuzzüglers.‡마리스 농장 남동쪽에 있는 티르의 손 수도원으로 간 다음, 그곳에서 썩은 사과를 한 입 먹어야 합니다. 붉은십자군의 모습을 한 채로 십자군군주 발델마르에게 십자군 사령관의 명령서를 가져가야 합니다.‡Viaja a Mano de Tyr, al sureste de la Hacienda de Marris. Una vez allí, da un mordisco a la manzana podrida. Entrega la Orden del Gran Cruzado al Señor Cruzado Valdemar con la protección de la forma de La Cruzada Escarlata.‡Viaja a Mano de Tyr, al sureste de la Hacienda de Marris. Una vez allí, da un mordisco a la manzana podrida. Entrega la Orden del Gran Cruzado al señor cruzado Valdemar con la protección de la forma de la Cruzada Escarlata.‡Aller à la Main de Tyr, au sud-est de la ferme des Marris. Une fois sur place, mordre dans la Pomme pourrie. Profiter d’avoir revêtu l’apparence d’un membre de la Croisade écarlate pour apporter les Ordres du Grand Croisé au Grand maître Valdelmar.‡到玛瑞斯农场东南方的提尔之手去，抵达那里之后就咬一口烂苹果。在血色十字军伪装的掩护下，把大十字军的命令交给十字军领主瓦德玛尔。‡到瑪瑞斯農場東南方的提爾之手去，抵達那裏之後就咬壹口爛蘋果。在血色十字軍偽裝的掩護下，把大十字軍的命令交給十字軍領主瓦德瑪爾。',
  }
},
[6147] = {
  {
    'Retorno a Nathanos‡Назад к Натаносу‡Kehrt zu Nathanos zurück.‡나타노스에게 돌아가기‡Regresa junto a Nathanos‡Regresa junto a Nathanos‡Retourner voir Nathanos‡向纳萨诺斯复命‡向納薩諾斯復命',
    nil,
    'Fale novamente com Nathanos Arauto da Praga para repassar a ele as novas informações.‡Возвращайтесь к Натаносу и отчитайтесь о выполнении задания.‡Kehrt mit der neuen Information zu Nathanos Blightcaller zurück.‡이 새로운 정보를 가지고 나타노스 블라이트콜러에게 돌아가야 합니다.‡Vuelve con Nathanos Clamañublo con la nueva información.|n‡Vuelve con Nathanos Clamañublo con la nueva información.‡Retourner voir Nathanos le Flétrisseur avec la nouvelle information.‡带着新情报返回纳萨诺斯·凋零者那里。‡帶著新情報返回納薩諾斯·雕零者那裏。',
  }
},
[6148] = {
  {
    'Demétria, o Oráculo Escarlate‡Алый Оракул Деметрия‡Das Scharlachrote Orakel Demetria‡붉은십자군 예언자, 데메트리아‡El Oráculo Escarlata, Demetria‡El Oráculo Escarlata, Demetria‡L\'Oracle écarlate, Demetria‡血色十字军圣者，德米提雅‡血色十字軍聖者，德米提雅',
    nil,
    'A Cruzada Escarlate está em marcha. Em algum ponto da estrada da Manopla de Tyr para Stratholme estará o Oráculo, Demétria, e a comitiva dela. Encontre-a e mate-a. Fale novamente com Nathanos Arauto da Praga se tiver sucesso.‡Алый орден сейчас в пути. Найдите Оракула Деметрию и ее свиту на дороге от Длани Тира в Стратхольм. Убейте Оракула и возвращайтесь к Натаносу Гнилостеню.‡Der Scharlachrote Kreuzzug ist unterwegs. Irgendwo auf der Straße von Tyrs Hand nach Stratholme findet Ihr das Orakel Demetria und ihr Gefolge. Jagt sie und tötet sie. Kehrt zu Nathanos Blightcaller zurück, wenn Ihr erfolgreich wart.‡붉은십자군 예언가가 이동하고 있습니다. 티르의 손 수도원에서 스트라솔름으로 가는 길 어딘가에서 예언가인 데메트리아와 그녀의 호위병들을 찾을 수 있을 것입니다. 그녀를 추적해서 처치하고 성공하면 나타노스 블라이트콜러에게 돌아가야 합니다.‡La Cruzada Escarlata se está moviendo. En algún lugar, a lo largo del camino que va de Mano de Tyr a Stratholme, encontrarás al Oráculo, Demetria, con su escolta. Da caza a Demetria y mátala. Vuelve junto a Nathanos Clamorinfecto si tienes éxito.‡La Cruzada Escarlata se está moviendo. En algún lugar, a lo largo del camino que va de Mano de Tyr a Stratholme, encontrarás al Oráculo, Demetria, con su escolta. Da caza a Demetria y mátala. Vuelve junto a Nathanos Clamañublo si tienes éxito.‡La Croisade écarlate fait mouvement. Quelque part le long de la route, entre la Main de Tyr et Stratholm, vous trouverez l’Oracle Demetria et sa fratrie. La tuer et retourner voir Nathanos le Flétrisseur.‡血色十字军正在从提尔之手到斯坦索姆的路上巡逻，你可以在巡逻队中找到圣者德米提雅和她的随从，找到并杀死她。如果你成功了，就回到纳萨诺斯·凋零者那里去复命。‡血色十字軍正在從提爾之手到斯坦索姆的路上巡邏，妳可以在巡邏隊中找到聖者德米提雅和她的隨從，找到並殺死她。如果妳成功了，就回到納薩諾斯·雕零者那裏去復命。',
  }
},
[6161] = {
  {
    'O tesouro de Rodovalho!‡Сокровища Ракмора‡Nehmt Rackmores Schatz!‡랙모어의 보물을 찾아라!‡La búsqueda del tesoro de Masatormento‡La búsqueda del tesoro de Masatormento‡Revendiquer le trésor de Rackmore !‡拉克摩尔的财宝！‡拉克摩爾的財寶！',
    nil,
    'Encontre a Chave Prateada de Rodovalho e a Chave Dourada de Rodovalho. Encontre e abra o Baú de Rodovalho.‡Найдите серебряный и золотой ключи Ракмора, а затем разыщите и отоприте сундук Ракмора.‡Sucht Rackmores Silberschlüssel. Sucht Rackmores Goldschlüssel. Sucht und öffnet Rackmores Truhe.‡랙모어의 은열쇠와 랙모어의 황금열쇠를 찾아 랙모어의 궤짝을 열어야 합니다.‡Encuentra la Rackmore\'s Silver Key. Encuentra la Rackmore\'s Golden Key. Encuentra y abre el cofre de Masatormento.‡Encuentra la llave de plata de Masatormento. Encuentra la llave de oro de Masatormento. Encuentra y abre el cofre de Masatormento.‡Trouver la Clé d\'argent de Rackmore. Trouver la Clé d\'or de Rackmore. Trouver et ouvrir le Coffre de Rackmore.‡找到拉克摩尔的银钥匙和金钥匙。找到并打开拉克摩尔的箱子。‡找到拉克摩爾的銀鑰匙和金鑰匙。找到並打開拉克摩爾的箱子。',
  }
},
[6162] = {
  {
    'A última batalha de um marido‡Последняя битва супруга‡Eines Ehemanns letzter Kampf‡남편의 마지막 전투‡La última batalla de un esposo‡La última batalla de un esposo‡La dernière bataille d\'un mari‡最后一战‡最後壹戰',
    nil,
    'Mate o Suserano Ror e leve a garra dele para Dreka\'Sur no Posto Peçonha, na Selva Maleva.‡Убейте властителя Рора и принесите его коготь Дрейка\'Сур на заставу Отравленной Крови в Оскверненном лесу.‡Tötet Oberanführer Ror und bringt seine Klaue zu Dreka\'Sur beim Blutgiftposten im Teufelswald.‡대군주 로르를 처치하고 그의 발톱을 악령의 숲, 피멍울 초소에 있는 드레카술에게 가져가야 합니다.‡Mata al Señor Supremo Ror y lleva su zarpa a Dreka\'Sur al Puesto del Veneno de Frondavil.‡Mata al señor supremo Ror y lleva su garra a Dreka\'Sur al Puesto del Veneno de Frondavil.‡Tuer le Seigneur Ror et apporter sa Griffe à Dreka\'Sur, au Poste de la Vénéneuse, en Gangrebois.‡杀死主宰洛尔，把他的爪子交给费伍德森林血毒岗哨的德雷卡苏。‡殺死主宰洛爾，把他的爪子交給費伍德森林血毒崗哨的德雷卡蘇。',
  }
},
[6163] = {
  {
    'Ramstein‡Рамштейн‡Ramstein‡람스타인‡Ramstein‡Ramstein‡Ramstein‡吞咽者拉姆斯登‡吞咽者拉姆斯登',
    nil,
    'Vá a Stratholme e mate Ramstein, o Devorador. Leve a cabeça dele como souvenir para Nathanos.‡Отправляйтесь в Стратхольм и убейте Рамштайна Ненасытного. Принесите его голову Натаносу в качестве сувенира.‡Reist nach Stratholme und tötet Ramstein den Würger. Bringt seinen Kopf als Souvenir zu Nathanos.‡스트라솔름으로 가서 먹보 람스타인을 처치하고 그 증거로 그의 머리카락을 나타노스에게 가져가야 합니다.‡Viaja a Stratholme y mata a Ramstein el Empachador. Coge su cabeza y llévasela como souvenir a Nathanos.‡Viaja a Stratholme y mata a Ramstein el Empachador. Coge su cabeza y llévasela como souvenir a Nathanos.‡Aller à Stratholme et tuer Ramstein Grandgosier. Prendre sa tête, et l’apporter à Nathanos.‡到斯坦索姆去，杀掉吞咽者拉姆斯登。把他的头颅交给纳萨诺斯。‡到斯坦索姆去，殺掉吞咽者拉姆斯登。把他的頭顱交給納薩諾斯。',
  }
},
[6164] = {
  {
    'O livro-caixa do Augustus‡Книга рецептов Августа‡Augustus\' Rezeptbuch‡아우구스투스의 회계장부‡Libro de entradas de Augustus‡Libro de entradas de Augustus‡Le livre de compte d\'Augustus‡奥古斯图斯的收据册‡奧古斯圖斯的收據冊',
    nil,
    'Leve o Livro-caixa do Augustus para Augustus, o Pirado, na Várzea do Medo.‡Принесите Августу Помешанному в Долину Ужаса его книгу рецептов.‡Bringt Augustus\' Quittungsbuch zu Augustus dem Meschuggenen im Schreckenstal.‡테러데일에 있는 정신나간 아우구스투스에게 아우구스투스의 회계장부를 가져가야 합니다.‡Lleva el libro de entradas de Augustus a Augustus el Agraciado a Valle del Terror.‡Lleva el libro de entradas de Augustus a Augustus el Agraciado en Valle del Terror.‡Apporter le Livre de compte d\'Augustus à Augustus le Touché à Val-Terreur.‡把奥古斯图斯的收据册交给恶蛛隧道中的被感动的奥古斯图斯。‡把奧古斯圖斯的收據冊交給惡蛛隧道中的被感動的奧古斯圖斯。',
  }
},
[6165] = {
  {
    '‡‡‡‡‡<NYI> <TXT> Archmage Timolain\'s Remains‡‡‡',
    nil,
    nil,
  }
},
[6181] = {
  {
    'Mensagem rápida‡Срочное сообщение‡Eine eilige Nachricht‡긴급 전갈‡Mensajero a toda prisa‡Mensajero a toda prisa‡Un message rapide‡快递消息‡快遞消息',
    nil,
    'Mostre o Bilhete do Ludovico a Thor, o mestre de grifos.‡Отнесите записку Льюиса укротителю грифонов Тору.‡Bringt Lewis\' Notiz zu Thor dem Greifenmeister.‡루이스의 쪽지를 가지고 그리핀 조련사 토르에게 가야 합니다.‡Lleva la Nota de Lewis a Thor, el maestro de grifos.‡Lleva la Nota de Lewis a Thor, el maestro de grifos.‡Apporter la Note de Lewis à Thor, le Maître des gryphons.‡将刘易斯的便笺交给狮鹫管理员索尔。‡將劉易斯的便箋交給獅鷲管理員索爾。',
  }
},
[6182] = {
  {
    'O primeiro e último‡Первый и последний‡Der Erste und Letzte‡처음이자 마지막 순찰대장‡El primero y el último‡El primero y el último‡Le premier et le dernier‡第一个和最后一个‡第壹個和最後壹個',
    nil,
    'Fale com Mathias Shaw na Cidade Velha de Ventobravo. Ele mora no Quartel.‡Поговорите с Матиасом Шоу в Старом Городе в Штормграде. Матиас находится в казармах.‡Sprecht mit Meister Mathias Shaw in der Altstadt von Stormwind. Er wohnt in der Kaserne.‡스톰윈드 구 시가지의 병영에 있는 단장 마티아스 쇼와 대화해야 합니다.‡Habla con Mathias Shaw en el Casco Antiguo, en Ventormenta. Vive en los Cuarteles.‡Habla con Mathias Shaw en el Casco Antiguo, en Ventormenta. Vive en los Cuarteles.‡Parler à Mathias Shaw, dans la vieille ville de Stormwind. Il se trouve dans la caserne.‡与暴风城的马迪亚斯·肖尔谈一谈，他住在旧城区的兵营里。‡與暴風城的馬迪亞斯·肖爾談壹談，他住在舊城區的兵營裏。',
  }
},
[6183] = {
  {
    'Em honra aos mortos‡Почитание мертвых‡Ehret die Toten‡망자에 대한 예의‡Honrar a los muertos‡Honra a los muertos‡Honorer la mort‡逝者的荣耀‡逝者的榮耀',
    nil,
    'Fale com Mathias Shaw novamente se desejar aceitar esta tarefa.‡Еще раз поговорите с Матиасом Шоу, если хотите принять его задание.‡Sprecht wieder mit Mathias Shaw, wenn Ihr seine Aufgabe annehmen wollt.‡이 임무를 수락하려면 마티아스 쇼와 다시 대화해야 합니다.‡Vuelve a hablar con Mathias Shaw si quieres aceptar esta misión.‡Vuelve a hablar con Mathias Shaw si quieres aceptar esta misión.‡Reparlez à Mathias Shaw, quand vous aurez décidé d’accepter son travail.‡如果你愿意接这个任务，就再和马迪亚斯·肖尔谈一谈。‡如果妳願意接這個任務，就再和馬迪亞斯·肖爾談壹談。',
  }
},
[6184] = {
  {
    'Flint Umbramais‡Флинт Тенемор‡Flint Shadowmore‡플린트 섀도모어‡Flint Sombramás‡Flint Sombramás‡Flint Shadowmore‡弗林特·沙多摩尔‡弗林特·沙多摩爾',
    nil,
    'Vá até o Acampamento Ventogelante, nas Terras Pestilentas Ocidentais, e encontre seu contato, Flint Umbramais.‡Отправляйтесь в Лагерь Промозглого Ветра в Западных Чумных землях и найдите Флинта Тенемора.‡Reist zur Chillwindspitze in den Westlichen Pestländern und trefft Euren Kontaktmann Flint Shadowmore.‡서부 역병지대에 있는 서리바람 야영지로 가서 연락원인 플린트 섀도모어를 만나야 합니다.‡Vete al Campamento del Orvallo en las Tierras de la Peste del Oeste y reúnete con tu contacto, Flint Sombramás.‡Vete al Campamento del Orvallo en las Tierras de la Peste del Oeste y reúnete con tu contacto, Flint Sombramás.‡Allez au camp du Noroît, dans les Maleterres de l’ouest, et rencontrez votre contact, Flint Shadowmore.‡到西瘟疫之地的冰风岗去跟弗林特·沙多摩尔会面。‡到西瘟疫之地的冰風崗去跟弗林特·沙多摩爾會面。',
  }
},
[6185] = {
  {
    'As Pestes do Leste‡Чума на востоке‡Die östlichen Pestländer‡동부 역병지대 정찰‡Las pestes del este‡Las pestes del este‡Les Maleterres de l\'Est‡东部的瘟疫‡東部的瘟疫',
    nil,
    'Vasculhe as Terras Pestilentas Orientais em busca de pistas sobre o "Arauto da Praga" e os agentes da AVIN desaparecidos. Ser encontrar alguma Insígnia da AVIN, leve de volta para Flint Umbramais, no Acampamento Ventogelante.‡Поищите в Восточных Чумных землях сведения про некоего Гнилостеня и пропавших агентов ШРУ. Если удастся найти знаки отличия ШРУ, отнесите их Флинту Тенемору в Лагерь Промозглого Ветра.‡Sucht in den östlichen Pestländern nach Hinweisen auf den \'Blightcaller\' und die vermissten SI:7-Agenten. Wenn Ihr SI:7-Insignien findet, bringt sie zu Flint Shadowmore an der Chillwindspitze.‡동부 역병지대에서 "블라이트콜러"와 실종된 SI:7 요원들에 대한 단서를 찾아야 합니다. SI:7 배지를 찾게 되면 서리바람 야영지에 있는 플린트 섀도모어에게 가져가야 합니다.‡Explora las Tierras de la Peste del Este en busca de pistas sobre el "Clamorinfecto" y los agentes perdidos del IS:7. Si encuentras alguna insignia del IS:7 llévasela a Flint Sombramás en el Campamento del Orvallo.‡Explora las Tierras de la Peste del Este en busca de pistas sobre el "Clamañublo" y los agentes perdidos del IV:7. Si encuentras alguna insignia del IV:7 llévasela a Flint Sombramás en el Campamento del Orvallo.‡Fouillez les Maleterres de l’est pour trouver des indices relatifs au "Flétrisseur" et aux agents du SI:7 portés disparus. Si vous trouvez un quelconque Insigne du SI:7, rapportez-le à Flint Shadowmore, au camp du Noroît.‡搜寻东瘟疫之地，寻找“凋零者”的线索以及失踪的军情七处密探。如果你找到任何军情七处徽章，就把它们交给冰风岗的弗林特·沙多摩尔。‡搜尋東瘟疫之地，尋找“雕零者”的線索以及失蹤的軍情七處密探。如果妳找到任何軍情七處徽章，就把它們交給冰風崗的弗林特·沙多摩爾。',
  }
},
[6186] = {
  {
    'A ascensão do Arauto da Praga‡Пришествие Гнилостеня‡Der Blightcaller kommt‡블라이트콜러의 정체‡El regreso de Clamorinfecto‡El regreso de Clamañublo‡La venue du Flétrisseur‡凋零者‡雕零者',
    nil,
    'Retorne a Ventobravo e informe o Grão-lorde Bolvar Fordragon sobre o destino de Nathanos Marris.‡Возвращайтесь в Штормград и сообщите верховному лорду Болвару Фордрагону о судьбе Натаноса Марриса.‡Kehrt nach Stormwind zurück und informiert Hochlord Bolvar Fordragon über das Schicksal von Nathanos Marris.‡스톰윈드로 대영주 볼바르 폴드라곤을 찾아가 나타노스 매리스의 운명에 대한 소식을 전해야 합니다.‡Regresa a Ventormenta e informa al alto señor Bolvar Fordragon sobre el destino de Nathanos Marris.‡Regresa a Ventormenta e informa al alto señor Bolvar Fordragón sobre el destino de Nathanos Marris.‡Retourner à Stormwind et informer le généralissime Bolvar Fordragon du destin de Nathanos Marris.‡回到暴风城，将纳萨诺斯·玛瑞斯的下落报告给伯瓦尔·弗塔根公爵。‡回到暴風城，將納薩諾斯·瑪瑞斯的下落報告給伯瓦爾·弗塔根公爵。',
  }
},
[6187] = {
  {
    'A restauração da ordem‡Порядок должен быть восстановлен‡Ordnung muss wieder hergestellt werden‡질서 회복‡Restaurar el orden‡Restaurar el orden‡L\'ordre doit être rétabli‡重铸秩序‡重鑄秩序',
    nil,
    'Reúna um exército e siga até as Terras Pestilentas Orientais. Lance um ataque maciço contra Nathanos Arauto da Praga e qualquer lixo da Horda que tente protegê-lo.|nMantenha-se sempre alerta, <name>. Os membros da Horda vão defender o lorde patrulheiro com as próprias vidas.‡Соберите войско и отправляйтесь в Восточные Чумные земли. Проведите полномасштабную атаку на Натаноса Гнилостеня и любых воинов Орды, которые могут попытаться его защитить.|nБудьте осторожны, потому что Орда всеми силами будет защищать бывшего предводителя следопытов.‡Stellt eine Armee auf und reist zu den östlichen Pestländern. Beginnt einen gnadenlosen Angriff auf Nathanos Blightcaller und jeden Abschaum der Horde, der ihn beschützen mag.|nBewahrt einen klaren Kopf, <Name>. Die Horde wird den Waldläuferlord mit dem Leben verteidigen.‡군대를 동원해 동부 역병지대로 가서 나타노스 블라이트콜러 및 그를 보호하려는 호드와 전면전을 벌이십시오.|n호드는 죽을 힘을 다해 자신들의 순찰대장을 보호하려고 할 테니 정신을 바짝 차려야 합니다.‡Reúne un ejército y viaja a las Tierras de la Peste del Este. Lanza un asalto contra Nathanos Clamorinfecto y cualquier miembro de la Horda que pueda intentar protegerle.|nTienes que permanecer alerta, <nombre>. Los de la Horda defenderán al Señor de exploradores con su vida.‡Reúne un ejército y viaja a las Tierras de la Peste del Este. Lanza un asalto contra Nathanos Clamañublo y cualquier miembro de la Horda que pueda intentar protegerle.|nTienes que permanecer alerta, <nombre>. Los de la Horda defenderán al Señor forestal con su vida.‡Montez une armée et portez-vous vers les Maleterres de l’est. Lancez un assaut total sur Nathanos le Flétrisseur et détruisez tout misérable élément de la Horde qui tenterait de le défendre.|nGardez votre présence d’esprit, <nom> : la Horde le défendra jusqu’à la mort.‡组织一支部队，然后到东瘟疫之地去。向纳萨诺斯·凋零者和任何敢于保护他的部落成员发起攻击。|n你要倾尽全力，<name>。部落会不惜一切代价保护他们的游侠领主。‡組織壹支部隊，然後到東瘟疫之地去。向納薩諾斯·雕零者和任何敢於保護他的部落成員發起攻擊。|n妳要傾盡全力，<name>。部落會不惜壹切代價保護他們的遊俠領主。',
  }
},
[6261] = {
  {
    'Dungar Tragolongo‡Дунгар Долгопив‡Dungar Longdrink‡덩가 롱드링크‡Dungar Tragolargo‡Dungar Tragolargo‡Dungar Longdrink‡杜加尔·朗德瑞克‡杜加爾·朗德瑞克',
    nil,
    'Leve o Caixote de Larso para Dungar Tragolongo, o mestre de grifos.‡Отнесите ящик Озрика к укротителю грифонов Дунгару Долгопиву.‡Bringt Osrics Kiste zu Dungar Longdrink dem Greifenmeister.‡그리핀 조련사 덩가 롱드링크에게 오스릭의 상자를 가져가야 합니다.‡Lleva el Cajón de Osric a Dungar Tragolargo, el maestro de grifos.‡Lleva el cajón de Osric a Dungar Tragolargo, el maestro de grifos.‡Apportez la Caisse d\'Osric à Dungar Longdrink, le Maître des gryphons.‡将奥斯瑞克的箱子交给狮鹫管理员杜加尔·朗德瑞克。‡將奧斯瑞克的箱子交給獅鷲管理員杜加爾·朗德瑞克。',
  }
},
[6281] = {
  {
    'Siga para Ventobravo‡Продолжение пути в Штормград‡Weiter nach Stormwind‡스톰윈드로 이동‡Prosigue hasta Ventormenta‡Prosigue hasta Ventormenta‡Continuer vers Stormwind‡赶赴暴风城‡趕赴暴風城',
    nil,
    'Compre uma passagem de grifo do mestre de grifos Thor, e leve o Bilhete do Ludovico para Larso Norde na loja Imunidade Limitada, que fica na Cidade Velha, em Ventobravo.‡Оплатите укротителю грифонов Тору полет до Штормграда и принесите записку Льюиса Озрику Штрангу в магазинчик "Ограниченная неуязвимость", расположенный в районе Старого города.‡Bucht einen Greifenritt bei Greifenmeister Thor, dann bringt Lewis\' Notiz zu Osric Strang, im Laden Begrenzte Immunität, in Stormwind.‡그리핀 조련사 토르에게 요금을 지급하고 그리핀을 탄 다음 루이스의 쪽지를 스톰윈드에 있는 오스릭 스트랑에게 가져가야 합니다. 오스릭은 스톰윈드의 구 시가지에 있는 품질보증 갑옷 상점에 있습니다.‡Cómprale al maestro de grifos Thor un vuelo en grifo y lleva la Nota de Lewis a Osric Strang, en la tienda Inmunidad Limitada, en el Casco Antiguo de Ventormenta.‡Cómprale al maestro de grifos Thor un vuelo en grifo y lleva la Nota de Lewis a Osric Strang, en la tienda Inmunidad Limitada, en el Casco Antiguo de Ventormenta.‡Achetez un voyage en gryphon à Thor, Maître des gryphons, puis apportez la Note de Lewis à Osric Strang au magasin “Immunité limitée”, dans la vieille ville de Stormwind.‡从狮鹫管理员索尔那里租用一头狮鹫，然后把刘易斯的便笺交给暴风城的奥斯瑞克·斯图恩。‡從獅鷲管理員索爾那裏租用壹頭獅鷲，然後把劉易斯的便箋交給暴風城的奧斯瑞克·斯圖恩。',
  }
},
[6282] = {
  {
    'Harpias ameaçadoras‡Угроза со стороны гарпий‡Harpyien drohen‡하피의 위협‡La ameneza de la arpías‡La amenaza de las arpías‡La menace des harpies‡鹰身人的威胁‡鷹身人的威脅',
    nil,
    'Maggran Ata Terra, no Retiro Rocha do Sol, quer que você mate 7 Hapias Furissague, 7 Emboscadoras Furissangue, 7 Matadoras Furissangue e 7 Plumerrantes Furissangue.‡Землепряд Маггран из Приюта у Солнечного Камня просит вас убить 7 гарпий, 7 душительниц, 7 душегубок и 7 бродяжниц из стаи Кровавой Ярости.‡Maggran Earthbinder in Sonnenfels möchte, dass Ihr 7 Harpyien der Blutfurien, 7 Wegelagerinnen der Blutfurien, 7 Töterinnen der Blutfurien und 7 Wildfedern der Blutfurien erschlagt.‡해바위 야영지에 있는 마그그랜 어스바인더가 혈폭풍일족 하피, 복병, 암살자, 약탈자를 각각 7마리씩 처치해달라고 부탁했습니다.‡Maggran Ligaterra en el Refugio Roca del Sol quiere que mates 7 arpías Furia Sangrienta, 7 emboscadores Furia Sangrienta, 7 cazadores Furia Sangrienta y 7 Plumapícaros Furia Sangrienta.‡Maggran Vinculador Terrestre, en el Refugio Roca del Sol, quiere que mates 7 arpías Furia Sangrienta, 7 emboscadoras Furia Sangrienta, 7 destripadoras Furia Sangrienta y 7 malaplumas Furia Sangrienta.‡Maggran Earthbinder de la retraite de Roche-Soleil veut que vous anéantissiez sept Harpies, sept Embusquées, sept Tueuses et sept Volplumes Rougefuries.‡烈日石居的马格兰要你去杀掉7个血怒鹰身人、7个血怒伏击者、7个血怒杀戮者和7个血怒游荡者。‡烈日石居的馬格蘭要妳去殺掉7個血怒鷹身人、7個血怒伏擊者、7個血怒殺戮者和7個血怒遊蕩者。',
  }
},
[6283] = {
  {
    'O sangue das Furissangue‡Предводительница клана Кровавой Ярости‡Blutfuriengeschlecht‡혈폭풍일족의 혈통‡El linaje Furia Sangrienta‡El linaje Furia Sangrienta‡La lignée Rougefurie‡血怒一族‡血怒壹族',
    nil,
    'Maggram, no Retiro Rocha do Sol, quer que você mate a Estripadora Furissangue e traga os restos mortais dela como prova de seu feito.‡Маггран из Приюта у Солнечного Камня просит убить Потрошительницу из стаи Кровавой Ярости и принести ему ее останки в доказательство того, что она мертва.‡Maggran in Sonnenfels möchte, dass Ihr die Zerfetzerin der Blutfurien beseitigt und ihre sterblichen Überreste als Beweis für Eure Tat mitbringt.‡해바위 야영지에 있는 마그그랜 어스바인더가 혈폭풍일족 갈퀴발톱을 처치하고 그 증거로 그녀의 유해를 가져오라고 부탁했습니다.‡Maggran, en el Refugio Roca del Sol, quiere que mates a la Destripadora Furia Sangrienta y le lleves sus restos como prueba de tu hazaña.‡Maggran, en el Refugio Roca del Sol, quiere que mates a la desgarradora Furia Sangrienta y le lleves sus restos como prueba de tu hazaña.‡Maggran, à la Retraite de Roche-Soleil, vous demande de détruire la Déchiqueteuse Rougefurie et de rapporter son corps comme preuve de votre exploit.‡烈日石居的马格兰要你去杀掉血怒撕裂者，然后把她的遗体带回来作为证据。‡烈日石居的馬格蘭要妳去殺掉血怒撕裂者，然後把她的遺體帶回來作為證據。',
  }
},
[6284] = {
  {
    'Aracnofobia‡Арахнофобия‡Arachnophobie‡거미의 공포‡Aracnofobia‡Aracnofobia‡Arachnophobie‡贝瑟莱斯‡貝瑟萊斯',
    nil,
    'Mate Besseleth e leve a Presa de Besseleth a Maggran no Retiro Rocha do Sol.‡Убейте Бесселет и принесите клык Бесселет Магграну в Приют у Солнечного Камня.‡Tötet Besseleth und bringt Besseleths Fangzahn zu Maggran in Sonnenfels.‡베스셀레스를 처치하고 그 증거로 베스셀레스의 송곳니를 들고 해바위 야영지의 마그그랜에게 가져가야 합니다.‡Mata a Besseleth y lleva el colmillo de Besseleth a Maggran en el Refugio Roca del Sol.‡Mata a Besseleth y lleva el colmillo de Besseleth a Maggran en el Refugio Roca del Sol.‡Tuer Besseleth, et apporter le Croc de Besseleth à Maggran, dans la Retraite de Roche-Soleil.‡杀掉贝瑟莱斯，然后把贝瑟莱斯的牙齿交给烈日石居的马格兰。‡殺掉貝瑟萊斯，然後把貝瑟萊斯的牙齒交給烈日石居的馬格蘭。',
  }
},
[6285] = {
  {
    'Entrega para Ludovico‡Возвращение к Льюису‡Zurück zu Lewis‡루이스에게 돌아가기‡Regresa con Lewis‡Regresa junto a Lewis‡Aller voir Lewis‡返回西部荒野‡返回西部荒野',
    nil,
    'Compre uma passagem para o Morro da Sentinela do mestre de grifos Dungar Tragolongo. Em seguida, leve o Caixote de Larso para Ludovico, no Morro da Sentinela.‡Оплатите укротителю грифонов Дунгару Долгопиву полет до Сторожевого холма, а затем отнесите ящик Озрика Льюису.‡Bucht einen Greifenritt zur Späherkuppe bei Greifenmeister Dungar Longdrink, dann bringt Osrics Kiste zu Lewis an der Späherkuppe.‡그리핀 조련사 덩가 롱드링크에게 요금을 지급하고 감시의 언덕으로 가는 그리핀을 탄 다음 오스릭의 상자를 감시의 언덕에 있는 루이스에게 가져가야 합니다.‡Compra un vuelo en grifo hasta la Colina del Centinela al maestro de grifos Dungar Tragolargo y lleva el Cajón de Osric a Lewis de la Colina del Centinela.‡Compra un vuelo en grifo hasta la Colina del Centinela al maestro de grifos Dungar Tragolargo y lleva el cajón de Osric a Lewis de la Colina del Centinela.‡Achetez un voyage en gryphon pour la Colline des sentinelles à Dungar Longdrink, Maître des gryphons, puis apportez la Caisse d\'Olric à Lewis à la Colline des sentinelles.‡从狮鹫管理员杜加尔·朗德瑞克那里租用一头狮鹫飞到哨兵岭，然后将奥斯瑞克的箱子交给哨兵岭的刘易斯。‡從獅鷲管理員杜加爾·朗德瑞克那裏租用壹頭獅鷲飛到哨兵嶺，然後將奧斯瑞克的箱子交給哨兵嶺的劉易斯。',
  }
},
[6301] = {
  {
    'Ciclo de renascimento‡Цикл возрождения‡Zyklus der Wiedergeburt‡생태계의 순환‡El ciclo del renacimiento‡El ciclo del renacimiento‡Cycle de la renaissance‡生生不息‡生生不息',
    nil,
    'Tammra Campo de Vento, no Retiro Rocha do Sol, quer que você colete 10 Sementes de Gaia.‡Таммра Перекати-поле из Приюта у Солнечного Камня просит вас собрать 10 семян Геи.‡Tammra Windfield in Sonnenfels möchte, dass Ihr 10 Gaeasamenkörner sammelt.‡해바위 야영지에 있는 탐라 윈드필드가 가이아 씨앗 10개를 모아다 달라고 부탁했습니다.‡Tammra Windfield, en el Refugio Roca dle Sol, quiere que le consigas 10 semillas de Gaia.‡Tammra Campo de Viento, en el Refugio Roca del Sol, quiere que le consigas 10 semillas de Gaia.‡Tammra Windfield, de la retraite de Roche-Soleil, vous demande de rassembler 10 Graines de Gaea.‡烈日石居的塔姆拉·荒原想让你去收集10枚盖亚之种。‡烈日石居的塔姆拉·荒原想讓妳去收集10枚蓋亞之種。',
  }
},
[6321] = {
  {
    'Suprimentos para o Sepulcro‡Поставка оружия‡Nachschub für das Grabmal‡공동묘지 장비 조달‡Suministros para El Sepulcro‡Suministros para El Sepulcro‡Approvisionner le Sépulcre‡瑟伯切尔的补给‡瑟伯切爾的補給',
    nil,
    'Leve as Ordens do Rodrigo para Carlos Razok.‡Отнесите заказ Подрига Каросу Раззоку.‡Bringt Podrigs Liste zu Karos Razok.‡포드리그의 주문서를 가지고 박쥐 조련사 카로스 라조크에게 가야 합니다.‡Lleva el pedido de Podrig a Karos Razok.‡Lleva el pedido de Podrig a Karos Razok.‡Apporter l’Ordre de Podrig à Karos Razok.‡将博迪瑞格的订单交给卡洛斯·拉佐克。‡將博迪瑞格的訂單交給卡洛斯·拉佐克。',
  }
},
[6322] = {
  {
    'Miguel Garreta‡Майкл Гарретт‡Michael Garrett‡마이클 가레트‡Michael Garrett‡Michael Garrett‡Michael Garret‡迈克尔·加勒特‡邁克爾·加勒特',
    nil,
    'Leve o Caixote do Antônio até Miguel Garreta.‡Отправляйтесь к Майклу Гарретту с ящиком Гордона.‡Bringt Gordons Kiste zu Michael Garret.‡고든의 상자를 마이클 가레트에게 가져가야 합니다.‡Lleva la caja de Gordon a Michael Garrett.‡Lleva el cajón de Gordok a Michael Garrett.‡Apporter la Caisse de Gordon à Michael Garret.‡将高顿的箱子交给迈克尔·加勒特。‡將高頓的箱子交給邁克爾·加勒特。',
  }
},
[6323] = {
  {
    'Carona para a Cidade Baixa‡Полет в Подгород‡Flug nach Undercity‡언더시티로 이동‡Vuela a Entrañas‡Vuela a Entrañas‡Voyage vers Undercity‡飞往幽暗城‡飛往幽暗城',
    nil,
    'Adquira uma viagem de morcego até a Cidade Baixa com o tratador de morcegos Carlos Razok. Em seguida, leve as Ordens do Rodrigo para Antônio Nunes, na Cidade Baixa.‡Оплатите у дрессировщика летучих мышей Кароса Раззока полет до Подгорода, а затем отнесите заказ Подрига Гордону Уиндему в Подгороде.‡Bucht einen Fledermausritt zur Undercity bei Fledermausmeister Karos Razok und bringt dann Podrigs Anforderungsliste zu Gordon Wendham in Undercity.‡박쥐 조련사 카로스 라조크에게 돈을 지급하고 언더시티로 가는 박쥐를 탄 다음 포드리그의 주문서를 언더시티에 있는 고든 웬드헴에게 가져가야 합니다.‡Compra un viaje en murciélago a Entrañas al maestro de murciélagos Karos Razok. Después lleva el pedido de Podrig a Gordon Wendham en Entrañas.‡Pídele un viaje en murciélago a Entrañas a la cuidadora de murciélagos Anette. Después, lleva el pedido de Morris a Gordon Wendham en Entrañas.‡Acheter un voyage en chauve-souris pour Undercity, auprès du Maître des chauves-souris, Karos Razok, puis apporter l’Ordre de Podrig à Gordon Wendham, à Undercity.‡从蝙蝠管理员卡洛斯·拉佐克那里租一只蝙蝠飞往幽暗城，然后将博迪瑞格的订单交给幽暗城里的高顿·温德哈姆。‡從蝙蝠管理員卡洛斯·拉佐克那裏租壹只蝙蝠飛往幽暗城，然後將博迪瑞格的訂單交給幽暗城裏的高頓·溫德哈姆。',
  }
},
[6324] = {
  {
    'Fale novamente com Rodrigo‡Обратно к Подригу‡Rückkehr zu Podrig‡포드리그에게 돌아가기‡Vuelve con Podrig‡Vuelve con Podrig‡Retour vers Podrig‡向博迪瑞格回报‡向博迪瑞格回報',
    nil,
    'Adquira um voo de morcego para o Sepulcro do tratador de morcegos Miguel Garreta, depois entregue o Caixote do Antônio para o Necroguarda Rodrigo, no Sepulcro.‡Оплатите у дрессировщика летучих мышей Майкла Гарретта полет до Гробницы, а затем отдайте ящик Гордона стражу смерти Подригу в Гробнице.‡Bucht einen Fledermausritt zum Grabmal bei Fledermausmeister Michael Garret und bringt dann Gordons Kiste zu Todeswache Podrig beim Grabmal.‡박쥐 조련사 마이클 가레트에게 돈을 지급하고 공동묘지로 가는 박쥐를 탄 다음 고든의 상자를 공동묘지에 있는 죽음의경비병 포드리그에게 가져가야 합니다.‡Compra un viaje en murciélago a El Sepulcro al maestro de murciélagos Michael Garrett. Después lleva la caja de Gordon al guardia de la muerte Podrig en El Sepulcro.‡Compra un viaje en murciélago a El Sepulcro al maestro de murciélagos Michael Garrett. Después lleva el cajón de Gordok al Guardia de la Muerte Podrig en El Sepulcro.‡Acheter un voyage en chauve-souris pour le Sépulcre, auprès du Maître des chauves-souris Michael Garret, puis apporter la Caisse de Gordon au Garde noir Podrig, au Sépulcre.‡从蝙蝠管理员迈克尔·加勒特那儿租一只蝙蝠飞往瑟伯切尔，然后将高顿的箱子交给瑟伯切尔的亡灵卫兵博迪瑞格。‡從蝙蝠管理員邁克爾·加勒特那兒租壹只蝙蝠飛往瑟伯切爾，然後將高頓的箱子交給瑟伯切爾的亡靈衛兵博迪瑞格。',
  }
},
[6341] = {
  {
    'O butim de Teldrassil‡Изобилие Тельдрассила‡Die Arten von Teldrassil‡텔드랏실의 물고기‡La prodigalidad de Teldrassil‡A Darnassus‡Le don de Teldrassil‡泰达希尔的渔业‡泰達希爾的漁業',
    nil,
    'Leve a Coleção de Nessa para Vesprystus.‡Отнесите коллекцию Нессы к Веспристу.‡Bringt Nessas Sammlung zu Vesprystus.‡네사의 수집물을 베스프리스투스에게 가져가야 합니다.‡Lleva la colección de Nessa a Vesprystus.‡Habla con Fidelio para comprar un vuelo a Darnassus. Después, lleva el libro de recetas de Dolanaar a la hermana Aquinne en Darnassus.‡Apporter la Collection de Nessa à Vesprystus.‡将尼莎的货物交给维斯派塔斯。‡將尼莎的貨物交給維斯派塔斯。',
  }
},
[6342] = {
  {
    'Voo para Auberdine‡Полет в Аубердин‡Flug nach Auberdine‡아우버다인으로의 비행‡Vuela a Auberdine‡Vuela a Auberdine‡Vol vers Auberdine‡飞往奥伯丁‡飛往奧伯丁',
    nil,
    'Viaje de hipogrifo para Auberdine com o mestre de hipogrifos Vesprystus, depois leve a Coleção de Nessa para Laird.‡Совершите полет в Аубердин на гиппогрифе укротителя Весприста и отнесите коллекцию Нессы Лайрду.‡Bucht bei Hippogryphenmeister Vesprystus einen Hippogryphen nach Auberdine und bringt dann Nessas Sammlung zu Laird.‡히포그리프 조련사 베스프리스투스를 통해 아우버다인까지 날아간 다음 네사의 수집물을 레어드에게 전해줘야 합니다.‡Consigue un hipogrifo del maestro de hipogrifos Vesprystus, viaja a Auberdine y lleva la colección de Nessa a Laird.‡Consigue un hipogrifo del maestro de hipogrifos Vesprystus, viaja a Auberdine y lleva la colección de Nessa a Laird.‡Prenez un hippogryphe vers Auberdine chez le maître des hippogryphes Vesprystus, puis apportez la Collection de Nessa à Laird.‡从角鹰兽管理员维斯派塔斯那里租用一只角鹰兽飞到奥伯丁，然后将尼莎的货物交给莱尔德。‡從角鷹獸管理員維斯派塔斯那裏租用壹只角鷹獸飛到奧伯丁，然後將尼莎的貨物交給萊爾德。',
  }
},
[6343] = {
  {
    'Resposta para Nessa‡Возвращение к Нессе‡Rückkehr zu Nessa‡네사에게 돌아가기‡Vuelve con Nessa‡Regresa junto con Nyoma‡Retourner à Nessa‡飞回泰达希尔‡飛回泰達希爾',
    nil,
    'Leve a Resposta de Laird para Nessa Cantonegro.‡Принесите ответ Лайрда Нессе Песне Теней.‡Bringt Lairds Antwort zu Nessa Shadowsong.‡레어드의 답장을 네사 섀도송에게 전달해야 합니다.‡Lleva la respuesta de Laird a Nessa Cantosombrío.‡Habla con Leora para alquilar un hipogrifo y regresar a Dolanaar. Cuando llegues, entrégale la nota de la hermana Aquinne a Nyoma.‡Réponse de Laird à Nessa Shadowsong.‡将莱尔德的回信交给尼莎·影歌。‡將萊爾德的回信交給尼莎·影歌。',
  }
},
[6344] = {
  {
    'Nessa Cantonegro‡Несса Песня Теней‡Nessa Shadowsong‡네사 섀도송‡Nessa Cantosombrío‡Nessa Cantosombrío‡Nessa Shadowsong‡尼莎·影歌‡尼莎·影歌',
    nil,
    'Fale com Nessa Cantonegro.‡Поговорите с Нессой Песня Теней.‡Sprecht mit Nessa Shadowsong.‡네사 섀도송을 만나야 합니다.‡Habla con Nessa Cantosombrío.‡Habla con Nessa Cantosombrío.‡Parler à Nessa Shadowsong.‡与尼莎·影歌谈一谈。‡與尼莎·影歌談壹談。',
  }
},
[6361] = {
  {
    'Um pacote de peles‡Связка шкур‡Ein Bündel Bälge‡가죽 묶음‡Un fardo de pieles‡Un fardo de pellejos‡Un Tas de peaux‡一捆兽皮‡壹捆獸皮',
    nil,
    'Leve o Pacote de Peles para o mestre de mantícoras Devrak, na Encruzilhada.‡Отнесите связку шкур Зарга укротителю ветрокрылов Девраку из Перекрестка.‡Bringt das Bündel Bälge zu Windreitermeister Devrak in Crossroads.‡크로스로드에 있는 와이번 조련사 데브락에게 가죽 묶음을 가져가야 합니다.‡Llévale el fajo de pieles al maestro de jinetes del viento Devrak en El Cruce.‡Llévale el fardo de pellejos al maestro de jinetes del viento Devrak en El Cruce.‡Apporter le Tas de peaux au Maître des Cavaliers célestes, Devrak, à la Croisée.‡带着兽皮去找十字路口的迪弗拉克。‡帶著獸皮去找十字路口的迪弗拉克。',
  }
},
[6362] = {
  {
    'Voo para o Penhasco do Trovão‡Дорога до Громового Утеса‡Flug nach Thunder Bluff‡썬더 블러프로 날아가기‡Un viaje a Cima del Trueno‡Un viaje a Cima del Trueno‡Voyage vers Thunder Bluff‡飞往雷霆崖‡飛往雷霆崖',
    nil,
    'Pegue uma mantícora com o mestre de mantícoras Devrak e leve o Pacote de Peles para Ahanu, no Penhasco do Trovão.‡Оплатите перелет в Громовой Утес укротителю ветрокрылов Девраку и, оказавшись на месте, отнесите связку шкур Ахану.‡Bucht einen Windreiter nach Thunder Bluff bei Windreitermeister Devrak und bringt dann das Bündel Bälge zu Ahanu in Thunder Bluff.‡와이번 조련사 데브락에게 요금을 내고 썬더 블러프까지 날아간 다음 가죽 묶음을 아하누에게 전해줘야 합니다.‡Cómprale un jinete del viento para Cima del Trueno al maestro de jinetes del viento Devrak y llévale entonces el fajo de pieles a Ahanu en Cima del Trueno.‡Cómprale un trayecto en jinete del viento hasta Cima del Trueno al maestro de jinetes del viento Devrak y llévale entonces el fardo de pellejos a Ahanu en Cima del Trueno.‡Acheter un voyage pour Thunder Bluff, auprès du Maître des Cavaliers célestes, Devrak, puis apporter le Tas de peaux à Ahanu, à Thunder Bluff.‡从双足飞龙管理员迪弗拉克那里租一只驭风者飞往雷霆崖，然后将这捆兽皮交给雷霆崖的安哈努。‡從雙足飛龍管理員迪弗拉克那裏租壹只馭風者飛往雷霆崖，然後將這捆獸皮交給雷霆崖的安哈努。',
  }
},
[6363] = {
  {
    'Tal, o Mestre de Mantícoras‡Укротитель ветрокрылов Тал‡Tal der Windreitermeister‡와이번 조련사 탈‡Tal, maestro de jinetes del viento‡Tal, maestro de jinetes del viento‡Tal le Maître des Cavaliers célestes‡双足飞龙管理员塔尔‡雙足飛龍管理員塔爾',
    nil,
    'Leve os Artigos em Couro do Ahanu para Tal no Penhasco do Trovão.‡Отнесите кожаные вещи Ахану Талу из Громового Утеса.‡Bringt Ahanus Lederwaren zu Tal in Thunder Bluff.‡아하누의 가죽용품을 썬더 블러프에 있는 탈에게 가져가야 합니다.‡Lleva los artículos de piel de Ahanu a Tal en Cima del Trueno.‡Lleva los artículos de cuero de Ahanu a Tal en Cima del Trueno.‡Apporter les Marchandises en cuir d\'Ahanu à Tal, à Thunder Bluff.‡将安哈努的皮货交给雷霆崖的塔尔。‡將安哈努的皮貨交給雷霆崖的塔爾。',
  }
},
[6364] = {
  {
    'Fale novamente com Jahan‡Возвращение к Джахану‡Rückkehr zu Jahan‡자안에게 돌아가기‡Volver junto a Jahan‡Regresa con Jahan‡Retourner vers Jahan‡向加翰回复‡向加翰回復',
    nil,
    'Pegue uma mantícora para a Encruzilhada com o mestre de mantícoras Tal e leve os Artigos em Couro do Ahanu para Jahan Asa de Falcão.‡Оплатите перелет до Перекрестка у укротителя ветрокрылов Тала, а затем отнесите кожаные вещи Ахану Джахану Ястребиному Крылу.‡Bucht einen Windreiter nach Crossroads bei Windreitermeister Tal und bringt dann Ahanus Lederwaren zu Jahan Hawkwing.‡와이번 조련사 탈에게 요금을 치르고 크로스로드까지 날아간 다음 아하누의 가죽용품을 자안 호크윙에게 가져가야 합니다.‡Cómprale un jinete del viento para El Cruce al maestro de jinetes del viento Tal y llévale entonces los artículos de piel de Ahanu a Jahan Alalcón.‡Cómprale un jinete del viento para El Cruce al maestro de jinetes del viento Tal y llévale los artículos de cuero de Ahanu a Jahan Ala Halcón.‡Acheter un voyage pour la Croisée auprès du Maître des Cavaliers célestes Tal, puis apporter les Marchandises en cuir d’Ahanu à Jahan Hawkwing.‡从双足飞龙管理员塔尔那里租用一头飞往十字路口的双足飞龙，并把安哈努的皮货交给加翰·鹰翼。‡從雙足飛龍管理員塔爾那裏租用壹頭飛往十字路口的雙足飛龍，並把安哈努的皮貨交給加翰·鷹翼。',
  }
},
[6365] = {
  {
    'Encomenda para Gryshka‡Мясные продукты в Оргриммар‡Fleisch für Orgrimmar‡오그리마로 고기 배달‡Entrega de carne a Orgrimmar‡Entrega de carne a Orgrimmar‡Viandes vers Orgrimmar‡送往奥格瑞玛的肉‡送往奧格瑞瑪的肉',
    nil,
    'Leve as Carnes de Zargh para Devrak, na Encruzilhada.‡Отнесите мясные продукты Зарга Девраку из Перекрестка.‡Bringt Zarghs Fleisch zu Devrak in Crossroads.‡자르그의 고기를 크로스로드에 있는 데브락에게 가져가야 합니다.‡Llévale la carne de Zargh a Devrak en El Cruce.‡Llévale la carne de Grimtak a Burok en Cerrotajo.‡Apporter la Chair de Zargh à Devrak, à la Croisée.‡把扎尔夫的肉品交给十字路口的迪弗拉克。‡把紮爾夫的肉品交給十字路口的迪弗拉克。',
  }
},
[6381] = {
  {
    'Vida nova‡Новая жизнь‡Neues Leben‡새로운 생명‡Nueva vida‡Nueva vida‡Nouvelle vie‡新的生命‡新的生命',
    nil,
    'Plante 10 Sementes de Gaia em Montículos de Terra de Gaia e, então, devolva as Sementes Encantadas de Gaia restantes a Tammra, no Retiro Rocha do Sol.‡Посадите 10 семян Геи в земляные курганы Геи, а затем верните оставшиеся зачарованные семена Геи Таммре в Приют у Солнечного Камня.‡Pflanzt 10 Gaeasamenkörner in Gaeaerdhügel und sprecht dann mit Tammra in Sonnenfels.‡가이아 흙더미에 가이아 씨앗 10개를 심은 후, 마력 깃든 가이아 씨앗을 가지고 해바위 야영지에 있는 탐라에게 돌아가야 합니다.‡Planta 10 semillas de Gaia en los Túmulos y lleva las semillas de Gaia encantadas restantes a Tammra en el Refugio Roca del Sol.‡Planta 10 semillas de Gaia en los Túmulos y lleva las semillas de Gaia encantadas restantes a Tammra en el Refugio Roca del Sol.‡Planter 10 Graines de Gaea sur les Monticules de Gaea, puis parler à Tammra, à la Retraite de Roche-Soleil.‡将10枚盖亚之种种植在盖亚土堆中，然后与烈日石居的塔姆拉谈一谈。‡將10枚蓋亞之種種植在蓋亞土堆中，然後與烈日石居的塔姆拉談壹談。',
  }
},
[6382] = {
  {
    'A caçada do Vale Gris‡Большая охота‡Die Jagd in Ashenvale‡잿빛 골짜기 사냥 대회‡La Caza de Vallefresno‡La Caza de Vallefresno‡La Chasse d\'Ashenvale‡灰谷狩猎‡灰谷狩獵',
    nil,
    'Fale com Senani Coração Trovejante no Posto Machadada, que fica no Vale Gris.‡Поговорите с Сенани Громосерд на заставе Расщепленного Древа в Ясеневом лесу.‡Sprecht mit Seneni Thunderheart im Splintertreeposten in Ashenvale.‡잿빛 골짜기 토막나무 주둔지에 있는 세나니 썬더하트를 만나야 합니다.‡Habla con Senani Truenozón en el Puesto del Hachazo, Vallefresno.‡Habla con Senani Corazón Atronador en Puesto del Hachazo, en Vallefresno.‡Parler à Senani Thunderheart, au Poste de Bois-brisé, à Ashenvale.‡与灰谷碎木哨岗的塞娜尼·雷心谈一谈。‡與灰谷碎木哨崗的塞娜尼·雷心談壹談。',
  }
},
[6383] = {
  {
    'A Caçada do Vale Gris‡Большая охота‡Die Jagd in Ashenvale‡잿빛 골짜기 사냥 대회‡La Caza de Vallefresno‡La Caza de Vallefresno‡La Chasse d\'Ashenvale‡灰谷狩猎‡灰谷狩獵',
    nil,
    nil,
  }
},
[6384] = {
  {
    'Carona para Orgrimmar‡Дорога до Оргриммара‡Flug nach Orgrimmar‡오그리마로 날아가기‡Un viaje a Orgrimmar‡Un viaje a Orgrimmar‡Trajet vers Orgrimmar‡飞往奥格瑞玛‡飛往奧格瑞瑪',
    nil,
    'Pegue uma mantícora para a Orgrimmar com o mestre de mantícoras Devrak, depois leve as Carnes de Zargh para Orgrimmar.‡Оплатите полет в Оргриммар укротителю ветрокрылов Девраку и, оказавшись в Оргриммаре, отнесите мясные продукты Зарга Гришке.‡Bucht einen Windreiter nach Orgrimmar bei Windreitermeister Devrak und bringt dann Zarghs Fleisch zu Gryshka in Orgrimmar.‡와이번 조련사 데브락에게 요금을 치르고 오그리마까지 가서 자르그의 고기를 그리쉬카에게 배달해야 합니다.‡Cómprale un jinete del viento al maestro de jinetes del viento Devrak y llévale entonces la carne de Zargh a Gryshka en Orgrimmar.‡Cómprale un jinete del viento al maestro de jinetes del viento Burok y llévale entonces la carne de Grimtak a Gryshka en Orgrimmar.‡Acheter un voyage pour Orgrimmar, auprès du Maître des Cavaliers célestes, Devrak, puis apporter la Chair de Zargh à Gryshka, à Orgrimmar.‡从双足飞龙管理员迪弗拉克那里租一只驭风者飞往奥格瑞玛，然后将扎尔夫的肉品交给奥格瑞玛的格雷什卡。‡從雙足飛龍管理員迪弗拉克那裏租壹只馭風者飛往奧格瑞瑪，然後將紮爾夫的肉品交給奧格瑞瑪的格雷什卡。',
  }
},
[6385] = {
  {
    'Doraso, o mestre de mantícoras‡Укротитель ветрокрылов Дорас‡Doras der Windreitermeister‡와이번 조련사 도라스‡Doras, maestro de jinetes del viento‡Doras, maestro de jinetes del viento‡Doras le Maître des Cavaliers célestes‡双足飞龙管理员多拉斯‡雙足飛龍管理員多拉斯',
    nil,
    'Entregue a Carta de Gryshka para Doraso em Orgrimmar.‡Отнесите письмо Гришки Дорасу из Оргриммара.‡Bringt Gryshkas Brief zu Doras in Orgrimmar.‡그리쉬카의 편지를 오그리마에 있는 도라스에게 가져가야 합니다.‡Llévale la carta de Gryshka a Doras en Orgrimmar.‡Llévale la carta de Gryshka a Doras en Orgrimmar.‡Apporter la Lettre de Gryshka à Doras, à Orgrimmar.‡将格雷什卡的信交给奥格瑞玛的多拉斯。‡將格雷什卡的信交給奧格瑞瑪的多拉斯。',
  }
},
[6386] = {
  {
    'Retorno à Encruzilhada.‡Возвращение на Перекресток‡Kehrt nach Crossroads zurück‡크로스로드로 돌아가기‡El regreso a El Cruce‡El regreso a El Cruce‡Retour à la Croisée‡返回十字路口‡返回十字路口',
    nil,
    'Pegue uma mantícora para a Encruzilhada com o mestre de mantícoras Doraso e leve a Carta de Gryshka para Zargh, na Encruzilhada.‡Оплатите перелет в Перекресток укротителю ветрокрылов Доресу и, оказавшись на месте, передайте письмо Гришки Заргху из Перекрестка.‡Bucht einen Windreiter nach Crossroads bei Windreitermeister Doras und bringt dann Gryshkas Brief zu Zargh in Crossroads.‡와이번 조련사 도라스에게 요금을 치르고 크로스로드까지 간 다음 그리쉬카의 편지를 자르그에게 전달해야 합니다.‡Cómprale un jinete del viento para El Cruce al maestro de jinetes del viento Doras y llévale entonces la carta de Gryshka a Zargh a en El Cruce.‡Cómprale un jinete del viento para El Cruce al maestro de jinetes del viento Doras y llévale entonces la carta de Gryshka a Zargh en El Cruce.‡Acheter un voyage pour la Croisée auprès du Maître des Cavalier célestes, Doras, puis apporter la Lettre de Gryshka à Zargh, à la Croisée.‡从驭风者管理员多拉斯那里雇一只驭风者前往十字路口，然后将格雷什卡的信交给十字路口的扎尔夫。‡從馭風者管理員多拉斯那裏雇壹只馭風者前往十字路口，然後將格雷什卡的信交給十字路口的紮爾夫。',
  }
},
[6387] = {
  {
    'Alunos brilhantes‡Награды ученикам‡Ehrenstudenten‡명예의 곡괭이‡Estudiantes de honor‡Estudiantes de honor‡L\'honneur des étudiants‡荣誉学员‡榮譽學員',
    nil,
    'Leve a Lista de Brock para Thorgrum Borrelson, em Thelsamar.‡Отнесите список Брока Торгруму Боррелсону в Телcамаре.‡Bringt Brocks Liste zu Thorgrum Borrelson in Thelsamar.‡브록의 목록을 텔사마에 있는 토르그룸 보렐손에게 가져가야 합니다.‡Lleva la lista de Brock a Thorgrum Borrelson a Thelsamar.‡Llévale la lista de Brocks a Thorgrum Borrelson en Thelsamar.‡Apportez la Liste de Brock à Thorgrum Borrelson à Thelsamar.‡将布洛克的名单交给塞尔萨玛的索格拉姆·伯雷森。‡將布洛克的名單交給塞爾薩瑪的索格拉姆·伯雷森。',
  }
},
[6388] = {
  {
    'Grif Trovino‡Грит Турден‡Gryth Thurden‡그리스 서든‡Gryth Thurden‡Gryth Thurden‡Gryth Thurden‡格莱斯·瑟登‡格萊斯·瑟登',
    nil,
    'Entregue as Picaretas Honorárias para Grif Trovino em Altaforja.‡Отнесите почетные кирки Гриту Турдену в Стальгорне.‡Bringt die Ehrenhacken zu Gryth Thurden in Ironforge.‡명예의 곡괭이를 들고 아이언포지에 있는 그리스 서든에게 가야합니다.‡Lleva los picos honorarios a Gryth Thurden en Forjaz.‡Lleva los picos honorarios a Gryth Thurden en Forjaz.‡Apportez les Pioches d\'honneur à Gryth Thurden à Ironforge.‡将荣誉锄交给铁炉堡的格莱斯·瑟登。‡將榮譽鋤交給鐵爐堡的格萊斯·瑟登。',
  }
},
[6389] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Solte os Cupins das Terras Pestilentas na Serraria de Beiranorte, depois retorne com o Barril de Cupins das Terras Pestilentas até Nataniel Dumah, no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Выпустите термитов с Чумных земель на лесопилке Северного Кряжа и возвращайтесь к Натаниэлю Дамаху в Лагерь Промозглого Ветра в Западные Чумные земли.‡Befreit die Pestländer-Termiten im Sägewerk von Northridge, dann kehrt mit dem Fass Pestländer-Termiten zu Nathaniel Dumah im Chillwind-Posten in den westlichen Pestländern zurück.‡북마루 벌목지에 역병지대 흰개미를 놓아준 다음 역병지대 흰개미 통을 가지고 서부 역병지대 서리바람 야영지에 있는 너대니얼 두마에게 돌아가야 합니다.‡Libera las termitas de las Tierras de la Peste en la Serrería Crestanorte y luego vuelve con el barril de termitas a las Tierras de la Peste del Oeste y busca a Nathaniel Dumah en el Campamento del Orvallo.‡Libera las termitas de las Tierras de la Peste en el Aserradero Crestanorte y luego vuelve con la barrica de termitas de las Tierras de la Peste a Nathaniel Dumah en el Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Libérez les Termites des Maleterres dans la scierie de la Crête du nord, puis retournez voir Nathaniel Dumah, au camp du Noroît, dans les Maleterres de l\'ouest, avec le Tonneau de Termites des Maleterres.‡使用北山伐木场里的铁棍放出那里的瘟疫白蚁，然后向西瘟疫之地冰风岗的纳萨尼尔·杜马报告。‡使用北山伐木場裏的鐵棍放出那裏的瘟疫白蟻，然後向西瘟疫之地冰風崗的納薩尼爾·杜馬報告。',
  }
},
[6390] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Solte os Cupins das Terras Pestilentas na Serraria de Beiranorte, depois retorne com o Barril de Cupins das Terras Pestilentas até Guel Levine, no Baluarte, que fica nas Clareiras de Tirisfal.‡Выпустите термитов с Проклятых земель на лесопилке Северного Кряжа и возвращайтесь к Микки Левину в Бастион в Тирисфальских лесах.‡Befreit die Pestländer-Termiten im Sägewerk von Northridge, dann kehrt mit dem Fass Pestländer-Termiten zu Mickey Levine im Bollwerk in Tirisfal zurück.‡북마루 벌목지에 역병지대 흰개미를 놓아준 다음 역병지대 흰개미 통을 가지고 트리스팔 숲 보루에 있는 미키 레빈에게 돌아가야 합니다.‡Libera las termitas de las Tierras de la Peste en el Aserradero Crestanorte y luego vuelve con la barrica de termitas de las Tierras de la Peste a Mickey Levine en El Baluarte en los Claros de Tirisfal.‡Libera las termitas de las Tierras de la Peste en el Aserradero Crestanorte y luego vuelve con la barrica de termitas de las Tierras de la Peste a Mickey Levine en El Baluarte en los Claros de Tirisfal.‡Libérez les Termites des Maleterres dans la scierie de la Crête du nord, puis retournez voir Mickey Levine, à la Barricade, dans les Clairières de Tirisfal, avec le Tonneau de Termites des Maleterres.‡使用北山伐木场里的铁棍放出那里的瘟疫白蚁，然后向提瑞斯法林地亡灵壁垒的米克·莱文报告。‡使用北山伐木場裏的鐵棍放出那裏的瘟疫白蟻，然後向提瑞斯法林地亡靈壁壘的米克·萊文報告。',
  }
},
[6391] = {
  {
    'Carona para Altaforja‡Полет в Стальгорн‡Flug nach Ironforge‡아이언포지로 날아가기‡Vuela a Forjaz‡Vuela a Forjaz‡Voyage vers Ironforge‡飞往铁炉堡‡飛往鐵爐堡',
    nil,
    'Compre um voo de grifo para Altaforja do mestre de grifos Thorgrum Borrelson. Chegando lá, entregue a Lista de Brock para Golnir Topadão.‡Заплатите укротителю грифонов Торгруму Боррелсону, долетите на грифоне до Стальгорна и отдайте список Брока Голниру Твердопалу.‡Bucht einen Greifen nach Ironforge von Greifenmeister Thorgrum Borrelson, dann bringt Brocks Liste zu Golnir Bouldertoe in Ironforge.‡그리핀 조련사 토르그룸 보랠손에게 요금을 내고 아이언포지까지 간 다음 브록의 목록을 골니르 보울더토에게 가져가야 합니다.‡Contrata un vuelo en grifo a Forjaz con el maestro de grifos Thorgrum Borrelson para llevar la lista de Brock a Golnir Dedorroca.‡Contrata un vuelo en grifo a Forjaz con el maestro de grifos Thorgrum Borrelson y llévale la lista de Brock a Golnir Dedorroca, en Forjaz.‡Acheter un billet de gryphon pour Ironforge, auprès du Maître des gryphons, Thorgrum Borrelson, puis apporter la Liste de Brock à Golnir Bouldertoe, à Ironforge.‡从狮鹫管理员索格拉姆·伯雷森那里租一只狮鹫飞往铁炉堡，然后将布洛克的名单交给铁炉堡的高尼尔·石趾。‡從獅鷲管理員索格拉姆·伯雷森那裏租壹只獅鷲飛往鐵爐堡，然後將布洛克的名單交給鐵爐堡的高尼爾·石趾。',
  }
},
[6392] = {
  {
    'Fale novamente com Brock‡Возвращение к Броку‡Rückkehr zu Brock‡브록에게 돌아가기‡Vuelve con Brock‡Regresa con Brock‡Retourner vers Brock‡向布洛克回复‡向布洛克回復',
    nil,
    'Compre um voo de grifo para Thelsamar do mestre de grifos Grif Trovino. Chegando lá, entregue as Picaretas Honorárias para Brock Buscapedra.‡Заплатите укротителю грифонов Гриту Турдену, долетите на грифоне до Телcамара и отдайте почетные кирки Броку Камнекопу.‡Bucht einen Greifen nach Thelsamar bei Greifenmeister Gryth Thurden, dann bringt die Ehrenhacken zu Brock Stoneseeker in Thelsamar.‡그리핀 조련사 그리스 서든에게 요금을 치르고 텔사마로 간 다음 명예의 곡괭이를 브록 스톤시커에게 배달해야 합니다.‡Contrata un vuelo en grifo a Thelsamar con el maestro de grifos Gryth Thurden para llevar los picos honoríficos a Brock Buscapiedras.‡Contrata un vuelo en grifo a Thelsamar con el maestro de grifos Gryth Thurden para llevar los picos honorarios a Brock Buscapiedras en Thelsamar.‡Acheter un billet de gryphon pour Thelsamar, auprès du Maître des gyphons Gryth Thurden, puis apporter les Pioches d\'honneur à Brock Stoneseeker, à Thelsamar.‡从狮鹫管理员格莱斯·瑟登那里租用一头飞往塞尔萨玛的狮鹫，然后将荣誉锄交给塞尔萨玛的布洛克·寻石者。‡從獅鷲管理員格萊斯·瑟登那裏租用壹頭飛往塞爾薩瑪的獅鷲，然後將榮譽鋤交給塞爾薩瑪的布洛克·尋石者。',
  }
},
[6393] = {
  {
    'Guerra elemental‡Война элементалей‡Krieg der Elementare‡정령들의 전쟁‡Guerra elemental‡Guerra elemental‡Guerre élémentaire‡元素战争‡元素戰爭',
    nil,
    'Leve 10 Incenderitas a Tsunomem no Retiro Rocha do Sol.‡Принесите 10 Огненных кристаллов Цунаману в приют Солнечного Камня.‡Bringt 10 Pyrophore zu Tsunaman in Sonnenfels.‡해바위 야영지에 있는 츄나만에게 발화석 10개를 가져가야 합니다.‡Lleva 10 incendritas a Tsunaman en el Refugio Roca del Sol.‡Lleva 10 incendritas a Tsunaman en el Refugio Roca del Sol.‡Apporter 10 Incendrites à Tsunaman, dans la Retraite de Roche-Soleil.‡将10块焚火余烬交给烈日石居的苏纳曼。‡將10塊焚火余燼交給烈日石居的蘇納曼。',
  }
},
[6394] = {
  {
    'A picareta de Thazz\'ril‡Кирка Тазз\'рила‡Thazz\'rils Hacke‡타즈릴의 곡괭이‡Pico de Thazz\'ril‡Pico de Thazz\'ril‡La pioche de Thazz\'ril‡塔兹利尔的镐‡塔茲利爾的鎬',
    nil,
    'Leve a Picareta de Thazz\'ril para o Encarregado Thazz\'ril.‡Принесите штейгеру Тазз\'рилу его кирку.‡Bringt Thazz\'rils Hacke zu Großknecht Thazz\'ril.‡타즈릴의 곡괭이를 작업반장 타즈릴에게 돌려주어야 합니다.‡Lleva el pico de Thazz\'ril al supervisor Thazz\'ril.‡Lleva el pico de Thazz\'ril al supervisor Thazz\'ril.‡Apportez la Pioche de Thazz\'rill au contremaître Thazz\'rill.‡将塔兹利尔的镐还给塔兹利尔。‡將塔茲利爾的鎬還給塔茲利爾。',
  }
},
[6395] = {
  {
    'O último desejo de Marla‡Последнее желание Марлы‡Marlas letzter Wunsch‡말라의 마지막 소원‡El último deseo de Marla‡El último deseo de Marla‡La dernière volonté de Marla‡玛拉的遗愿‡瑪拉的遺願',
    nil,
    'Leve os Restos de Saulo Mitos para o Túmulo de Marla, depois fale novamente com a Noviça Elvira.‡Отнесите останки Самуэля Фиппса на могилу Марлы, а затем вернитесь к ученице Элрет.‡Bringt Samuel Fipps\' sterbliche Überreste zu Marlas Grab und kehrt dann zu Novize Elreth zurück.‡사무엘 핍스를 처치하고 그의 유골을 말라의 묘로 옮긴 다음 수련사제 엘레스에게 돌아가야 합니다.‡Lleva los restos de Samuel Fipps a la tumba de Marla y luego vuelve con la novicia Elreth.‡Lleva los restos de Samuel Fipps a la tumba de Marla y luego vuelve con la novicia Elreth.‡Apporter le Cadavre de Samuel Fipps sur la Tombe de Marla, puis retourner voir la novice Elreth.‡将塞缪尔·菲普斯的遗骸带到玛拉的坟墓去，然后回到新兵艾尔雷斯那里。‡將塞繆爾·菲普斯的遺骸帶到瑪拉的墳墓去，然後回到新兵艾爾雷斯那裏。',
  }
},
[6401] = {
  {
    'Kaya está viva‡Кайя жива!‡Kaya lebt‡카야의 생존 소식‡Kaya está viva‡Kaya está viva‡Kaya est en vie‡卡雅还活着‡卡雅還活著',
    nil,
    'Conte a boa notícia a Tammra Campo de Vento no Retiro Rocha do Sol.‡Передайте хорошие новости Таммре Перекати-поле, живущей в Приюте у Солнечного Камня.‡Teilt Tammra Windfield, die in Sonnenfels lebt, die gute Nachricht mit.‡해바위 야영지에 있는 탐라 윈드필드에게 기쁜 소식을 전해야 합니다.‡Da las buenas noticias a Tammra Campovento en el Refugio Roca del Sol.‡Da las buenas noticias a Tammra Campo de Viento en el Refugio Roca del Sol.‡Apprendre la bonne nouvelle à Tammra Windfield, dans la Retraite de Roche-Soleil.‡把这个好消息告诉烈日石居的塔姆拉·荒原。‡把這個好消息告訴烈日石居的塔姆拉·荒原。',
  }
},
[6402] = {
  {
    'Encontro marcado em Ventobravo‡Встреча в Штормграде‡Treffen in Stormwind‡스톰윈드 회합‡Tienes un cita en Ventormenta‡Tienes una cita en Ventormenta‡Le rendez-vous à Stormwind‡集合在暴风城‡集合在暴風城',
    nil,
    'Viaje a Ventobravo e vá até os portões da cidade. Fale com o Escudeiro Rui para que ele avise ao Marechal Vilasboas que você chegou.‡Отправьтесь в Штормград и подойдите к городским воротам. Поговорите с оруженосцем Роу, чтобы он сообщил маршалу Виндзору о вашем прибытии.‡Reist nach Stormwind und begebt Euch zu den Stadttoren. Sprecht mit Knappe Rowe, damit er Marshal Windsor über Eure Ankunft informiert.‡스톰윈드 도시 성문으로 가서, 수습기사 로우와 대화하면 그가 당신의 도착을 치안대장 윈저에게 알릴 것입니다.‡Viaja hasta Ventormenta y aventúrate tras las puertas de la ciudad. Habla con el escudero Rowe para que haga saber al alguacil Windsor sobre tu llegada.‡Viaja hasta la Ciudad de Ventormenta y aventúrate tras las puertas de la ciudad. Habla con el escudero Rowe para que haga saber al mariscal Windsor sobre tu llegada.‡Aller à la Cité de Stormwind et se rendre aux portes de la ville. Parlez à l\'écuyer Rowe, afin qu\'il informe le maréchal Windsor de votre arrivée.‡前往暴风城的城门。与侍卫洛文交谈，他会通知温德索尔元帅你已经到达了。‡前往暴風城的城門。與侍衛洛文交談，他會通知溫德索爾元帥妳已經到達了。',
  }
},
[6403] = {
  {
    'O grande baile de máscaras‡Великий Маскарад‡Die große Maskerade‡대단한 가장무도회‡La gran farsa‡La gran farsa‡La grande mascarade‡潜藏者‡潛藏者',
    nil,
    'Siga Reginaldo Vilasboas através de Ventobravo. Proteja-o de qualquer ataque!‡Сопроводите Реджинальда Виндзора через весь Штормград. Защитите его!‡Folgt Reginald Windsor durch Stormwind. Schützt ihn vor Gefahren!‡레지널드 윈저를 따라 스톰윈드를 통과해 왕궁으로 가야합니다. 윈저를 보호하십시오!‡Sigue a Reginald Windsor por Ventormenta. ¡Protégele del peligro!‡Sigue a Reginald Windsor por Ventormenta. ¡Protégele del peligro!‡Suivre Reginald Windsor dans Stormwind. Le protéger contre toute menace !‡跟随雷吉纳德·温德索尔元帅在暴风城中前进。保护他，别让他受到伤害！‡跟隨雷吉納德·溫德索爾元帥在暴風城中前進。保護他，別讓他受到傷害！',
  }
},
[6421] = {
  {
    'Ravina da Avalanche‡Ущелье Камнепадов‡Steinschlagklamm‡구릉바위 협곡‡Barranco del Alud‡Barranco del Alud‡Le ravin des Eboulis‡滚岩峡谷‡滾巖峽谷',
    nil,
    'Explore as profundezas da caverna na Ravina da Avalanche e colete 10 Cristais de Ressonita para que Mor\'rogal, no Retiro Rocha do Sol, os analise.‡Обследуйте глубины пещеры в ущелье Камнепадов и принесите 10 кристаллов резонита для исследования Мор\'рогалу в Приют у Солнечного Камня.‡Erkundet die Tiefen der Höhle in der Steinschlagklamm und bringt Mor\'rogal in Sonnenfels 10 Resonitkristalle, damit er sie untersuchen kann.‡구릉바위 협곡에 있는 동굴을 탐사한 다음 해바위 야영지에 있는 모르로갈에게 리조나이트 수정 10개를 가져가야 합니다.‡Explora las profundidades de la cueva del Barranco del Alud y lleva 10 cristales de resonita Mor\'rogal en el Refugio Roca del Sol para que los investigue.‡Explora las profundidades de la cueva del Barranco del Alud y lleva 10 cristales de resonita al Refugio Roca del Sol para que Mor\'rogal las estudie.‡Explorer la grotte du ravin des Eboulis, et apporter 10 Cristaux de résonite à Mor\'rogal, dans la Retraite de Roche-Soleil.‡深入滚岩峡谷的洞穴中，为烈日石居的摩罗加尔取回10块共鸣水晶以供研究。‡深入滾巖峽谷的洞穴中，為烈日石居的摩羅加爾取回10塊共鳴水晶以供研究。',
  }
},
[6441] = {
  {
    'Chifres de Sátiro‡Рога сатира‡Satyrhörner‡사티로스의 뿔‡Los cuernos de sátiro‡Los cuernos de sátiro‡Cornes de satyre‡萨特之角‡薩特之角',
    nil,
    'Consiga 16 Chifres de Sátiro para Pixel no Posto Machadada.‡Добудьте 16 рогов сатира для Пиксель на заставе Расщепленного Древа.‡Sammelt für Pixel im Splintertreeposten 16 Satyrhörner.‡사티로스의 뿔 16개를 모아 토막나무 주둔지에 있는 픽셀에게 가져가야 합니다.‡Reúne 16 cuernos de sátiro para Pixie en el Puesto del Hachazo.‡Reúne 16 cuernos de sátiro para Pixie en el Puesto del Hachazo.‡Collecter 16 Cornes de satyre pour Pixel, au Poste de Bois-brisé.‡为碎木哨岗的皮克希尔收集16只萨特的角。‡為碎木哨崗的皮克希爾收集16只薩特的角。',
  }
},
[6442] = {
  {
    'Nagas na Praia de Zoram‡Наги на Зорамском взморье‡Die Naga am Zoramstrand‡조람 해안의 나가‡Naga en la Ensenada de Zoram‡Nagas en la Ensenada de Zoram‡Des nagas sur la grève de Zoram‡佐拉姆海岸的纳迦‡佐拉姆海岸的納迦',
    nil,
    'Entregue 20 Cabeças de Iracauda a Marukai, na Praia de Zoram.‡Принесите 20 голов наг из клана Зловещего Хвоста Марукайе на Зорамское взморье.‡Bringt Marukai am Zoramstrand 20 Köpfe von Rächerflossen.‡조람 해안에 있는 마루카이에게 성난지느러미일족의 머리 20개를 가져가야 합니다.‡Llévale 20 cabezas de Colafuria a Marukai en La Ensenada de Zoram.‡Llévale 20 cabezas de Colafuria a Marukai en La Ensenada de Zoram.‡Apporter 20 Têtes d\'Irequeue à Marukai, le long de la grève de Zoram.‡将20颗怒尾纳迦的头颅交给佐拉姆海岸的玛鲁凯。‡將20顆怒尾納迦的頭顱交給佐拉姆海岸的瑪魯凱。',
  }
},
[6461] = {
  {
    'Fome sangrenta‡Кровопийцы‡Blutfresser‡식탐꾼들‡Chupasangres‡Chupasangres‡Suceurs de sang‡盗窃的蜘蛛‡盜竊的蜘蛛',
    nil,
    'Xen\'Zilla, em Malaka\'Jin, precisa que você mate 10 Rastejadoras de Fundolimo e 7 Cospeçonhas de Fundolimo.‡Ксен\'Зилла из Малака\'джина просит вас убить 10 ползун из густого мха и 7 моховых ядоплюев.‡Xen\'zilla am Malaka\'jin möchte, dass Ihr 10 Kluftmooskrabbler und 7 Kluftmoosgiftspucker tötet.‡말라카진에 있는 젠질라가 동굴이끼 땅거미 10마리와 동굴이끼 독거미 7마리를 처치해달라고 부탁했습니다.‡Xen\'zilla, en Malaka\'Jin, necesita que mates 10 trepadores musgondo y 7 escupevenenos musgondo.‡Xen\'zilla, en Malaka\'Jin, necesita que mates a 10 trepadores Musgondo y a 7 escupevenenos Musgondo.‡Xen\'zilla, à Malaka\'Jin, voudrait que vous tuiez 10 Rampants des mousses profondes et 7 Venimeux des mousses profondes.‡玛拉卡金的辛吉拉要求你杀死10只深苔爬行者和7只深苔毒蜘蛛。‡瑪拉卡金的辛吉拉要求妳殺死10只深苔爬行者和7只深苔毒蜘蛛。',
  }
},
[6462] = {
  {
    'Patuá troll‡Оберег троллей‡Troll-Glücksbringer‡트롤 부적‡Los talismanes trols‡El talismán trol‡Charme troll‡巨魔符咒‡巨魔符咒',
    nil,
    'Entregue 8 Patuás Troll para Mitsuwa, no Assentamento Zoram\'gar.‡Принесите 8 оберегов троллей Митсуве в форт Зорам\'гар.‡Bringt Mitsuwa im Zoram\'gar-Außenposten 8 Troll-Glücksbringer.‡조람가르 전초기지에 있는 미쑤와에게 트롤 부적 8개를 가져가야 합니다.‡Llévale 8 talismanes trols a Mitsuwa en la Avanzada de Zoram\'gar.‡Llévale 8 talismanes trols a Mitsuwa en la Avanzada de Zoram\'gar.‡Apporter 8 Charmes trolls à Mitsuwa, à l’Avant-poste de Zoram\'gar.‡将8个巨魔符咒交给佐拉姆加前哨站的米苏瓦。‡將8個巨魔符咒交給佐拉姆加前哨站的米蘇瓦。',
  }
},
[6481] = {
  {
    'O terrano se ergue‡Пробуждение земельника‡Der Irdene erhebt sich‡토석인이여 깨어나라‡El despertar del terráneo‡El despertar del terráneo‡Un Terrestre se lève‡土灵的觉醒‡土靈的覺醒',
    nil,
    'Abra o esquife de ressonita com o Cristal de Ressonita Encantado e, então, mate Goggeroc. Fale novamente com Mor\'rogal levando as notícias e o Cristal de Ressonita Encantado.‡Откройте резонитовую емкость при помощи зачарованного кристалла резонита и затем убейте Гоггерока. Вернитесь к Мор\'рогалу с новостями и зачарованным кристаллом резонита.‡Öffnet das Resonitfässlein mit dem verzauberten Resonitkristall und tötet Goggeroc. Kehrt mit der Vollzugsmeldung und dem verzauberten Resonitkristall zu Mor\'rogal zurück.‡마력 깃든 리조나이트 수정으로 리조나이트 광석을 연 다음 고게로크를 처치해야 합니다. 그를 처치했다는 소식과 마력 깃든 리조나이트 수정을 들고 모르로갈에게 돌아가십시오.‡Abre el barril de resonita con el cristal de resonita encantado y, a continuación, mata a Goggeroc. Vuelve a ver a Mor\'rogal para contarle lo ocurrido y entregarle el cristal de resonita encantado.‡Abre el barril de resonita con el cristal de resonita encantado y, a continuación, mata a Goggeroc. Vuelve a ver a Mor\'rogal para contarle lo ocurrido y entregarle el cristal de resonita encantado.‡Ouvrir la Gangue de résonite avec le Cristal de résonite enchanté, puis tuer Goggeroc. Retourner voir Mor\'rogal pour l\'informer et lui rapporter le Cristal de résonite enchanté.‡使用魔化共鸣水晶打开共鸣桶，然后杀死高戈罗克。将这个消息告诉摩罗加尔，并把魔化共鸣水晶还给他。‡使用魔化共鳴水晶打開共鳴桶，然後殺死高戈羅克。將這個消息告訴摩羅加爾，並把魔化共鳴水晶還給他。',
  }
},
[6482] = {
  {
    'Liberdade para Ruul!‡Свободу Руулу!‡Freiheit für Ruul‡루울에게 자유를‡Liberar a Ruul‡Liberar a Ruul‡Liberté pour Ruul‡鲁尔的自由‡魯爾的自由',
    nil,
    'Escolte Ruul e, em seguida, fale com Yama Casco de Neve, no Posto Machadada.‡Сопроводите Руула, затем поговорите с Ями Снежное Копыто на заставе Расщепленного Древа.‡Begleitet Ruul und sprecht dann mit Yama Snowhoof im Splintertreeposten.‡루울을 호위해 탈출한 후, 토막나무 주둔지에 있는 야마 스노우후프와 대화하십시오.‡Escolta a Ruul y después habla con Yama Pezuñablanca en el Puesto del Hachazo.‡Escolta a Ruul y después habla con Yama Pezuña Nevada en el Puesto del Hachazo.‡Escorter Ruul, puis parler à Yama Snowhoof, au Poste de Bois-brisé.‡护送鲁尔，然后与慰藉之林的雅玛·雪蹄谈一谈。‡護送魯爾，然後與慰藉之林的雅瑪·雪蹄談壹談。',
  }
},
[6501] = {
  {
    'O Olho do Dragão‡Око дракона‡Das Großdrachenauge‡용의 눈‡El Ojo del dragón‡El Ojo del Dragón‡L\'Œil de dragon‡巨龙之眼‡巨龍之眼',
    nil,
    'Você deve vasculhar o mundo em busca de uma criatura capaz de restaurar o poder do Fragmento do Olho do dragão. A única informação que você tem sobre essa criatura é que ela existe.‡Найдите существа, способные вернуть силу фрагменту амулета Ока дракона. Все, что об этих существах известно – это то, что они есть.‡Ihr müsst die Welt nach jemandem absuchen, der fähig ist, die Macht des Fragments des Großdrachenauges wieder herzustellen. Die einzige Information, die Ihr über ein solches Wesen besitzt ist, dass es existiert.‡전 세계를 뒤져 용의눈 조각의 힘을 복원할 수 있는 자를 찾아야 합니다. 이와 관련해 알고 있는 유일한 정보는 그러한 자들이 존재한다는 것뿐입니다.‡Debes buscar por todo el mundo y encontrar un ser capaz de restaurar el poder del fragmento del Ojo del dragón. La única información que tienes sobre dicho ser, es que existe.‡Debes buscar por todo el mundo y encontrar un ser capaz de restaurar el poder del fragmento del Ojo del Dragón. La única información que tienes sobre dicho ser es que existe.‡Vous devez écumer le monde pour pouvoir rétablir le pouvoir du Fragment de l\'Oeil de dragon. La seule information dont vous disposez à propos de cette chose, c’est qu’elle existe.‡你必须寻遍世界以找到一种能恢复龙眼碎片的能量的生物。你对这种生物的唯一了解就是：他们确实存在。‡妳必須尋遍世界以找到壹種能恢復龍眼碎片的能量的生物。妳對這種生物的唯壹了解就是：他們確實存在。',
  }
},
[6502] = {
  {
    'Amuleto da Chama Dracônica‡Амулет Пламени дракона‡Drachenfeueramulett‡비룡불꽃 아뮬렛‡Amuleto Pirodraco‡Amuleto Pirodraco‡Amulette drakefeu‡龙火护符‡龍火護符',
    nil,
    'Confronte o General Drakkisath e consiga o Sangue do Campeão dos Dragões Negros. Drakkisath está na sala do trono atrás dos Salões da Ascensão, no Pico da Rocha Negra.‡Добудьте кровь могучего черного дракона генерала Драккисата, которого можно найти сидящим на троне в залах Вознесения в Пике Черной горы.‡Ihr müsst das Blut des schwarzen Großdrachen-Helden von General Drakkisath bekommen. Ihr findet Drakkisath in seinem Thronsaal hinter den Hallen des Aufstiegs auf der Blackrockspitze.‡사령관 드라키사스에게서 검은용 용사의 피를 가져와야 합니다. 드라키사스는 검은바위 첨탑의 승천의 전당 뒤에 있는 알현실에 있습니다.‡Tienes que recuperar la sangre de dragón negro campeón, la tiene el general Drakkisath. Puedes encontrar a Drakkisath en su sala del trono, tras las Salas de la Ascensión, en la Cumbre de Roca Negra.‡Tienes que recuperar la sangre de dragón Negro Campeón, la tiene el general Drakkisath. Puedes encontrar a Drakkisath en su sala del trono, tras las Salas de la Ascensión, en la Cumbre de Roca Negra.‡Récupérer le Sang du Champion des dragons noirs sur le général Drakkisath. Il se trouve dans sa salle du trône, derrière les Halls d\'Ascension, sur le Pic Blackrock.‡你必须从达基萨斯将军身上取回黑龙勇士之血，你可以在黑石塔的晋升大厅后面的房间里找到他。‡妳必須從達基薩斯將軍身上取回黑龍勇士之血，妳可以在黑石塔的晉升大廳後面的房間裏找到他。',
  }
},
[6503] = {
  {
    'Vanguardeiros do Vale Gris‡Вестницы Ясеневого леса‡Die Kundschafter von Ashenvale‡잿빛골짜기 정찰꾼‡Avanzada de Vallefresno‡Avanzada de Vallefresno‡Les estafettes d\'Ashenvale‡灰谷先驱者‡灰谷先驅者',
    nil,
    'Mate 9 Vanguardeiros do Vale Gris, depois fale novamente com Koray\'bin, no Posto Machadada.‡Убейте 9 вестниц Ясеневого леса, а затем вернитесь к Курай\'бину на заставу Расщепленного Древа.‡Tötet 9 Kundschafter von Ashenvale und kehrt dann zu Kuray\'bin im Splintertreeaußenposten zurück.‡잿빛골짜기 정찰꾼 9명을 처치한 후 토막나무 주둔지에 있는 쿠레이빈에게 돌아가십시오.‡Mata a 9 avanzados de Vallefresno y vuelve junto a Kuray\'bin en el Puesto del Hachazo.‡Mata a 9 avanzadas de Vallefresno y regresa con Kuray\'bin en Puesto del Hachazo.‡Tuer 9 Estafettes d\'Ashenvale, puis retourner voir Kuray\'bin, à l’avant-poste de Bois-brisé.‡杀掉9个灰谷先驱者，然后回到碎木哨岗的库莱比那里。‡殺掉9個灰谷先驅者，然後回到碎木哨崗的庫萊比那裏。',
  }
},
[6504] = {
  {
    'As páginas perdidas‡Утраченные страницы‡Die verlorenen Seiten‡잃어버린 열 두쪽‡Las páginas perdidas‡Las páginas perdidas‡Les pages perdues‡丢失的书页‡丟失的書頁',
    nil,
    'Encontre as 12 páginas que voaram do Manual de Operações do Retalhador e organize-as nos capítulos 1, 2 e 3. Devolva o manual a Gurda Marcafúria, que está perto do Posto Machadada.‡Найдите 12 пропавших страниц руководства по использованию резака и соберите их по порядку глав 1, 2 и 3. Верните страницы Гурде Печати Гнева близ заставы Расщепленного Древа.‡Findet die 12 fehlenden Seiten der Schredderanleitung und fügt sie zu den Kapiteln 1, 2 und 3 zusammen.‡잃어버린 벌목기 조작설명서 열 두쪽을 찾아서 1장, 2장, 그리고 3장으로 합쳐야 합니다. 그런 다음 토막나무 주둔지 근처에 있는 구르다 레이지스카에게 돌려 주어야 합니다.‡Encuentra las 12 páginas que faltan del manual de instrucciones de la trituradora y vuelve a componer con ellas los 3 primeros capítulos. Devuélvele las páginas a Gurda Cicafuria cerca del Puesto del Hachazo.‡Encuentra las 12 páginas que faltan del manual de instrucciones de trituradora y vuelve a componer con ellas los 3 primeros capítulos. Devuélvele las páginas a Gurda Cicafuria cerca del Puesto del Hachazo.‡Trouver les 12 pages manquantes du Manuel d\'utilisation du Déchiqueteur, puis les rassembler pour constituer les Chapitres 1, 2, et 3. Ramener les pages à Gurda Ragescar près du poste de Bois-brisé.‡找到丢失的12页伐木机操作指南，把它们合并为第1、2、3章。然后带着这些书页回到碎木岗哨去找古尔达·怒痕。‡找到丟失的12頁伐木機操作指南，把它們合並為第1、2、3章。然後帶著這些書頁回到碎木崗哨去找古爾達·怒痕。',
  }
},
[6521] = {
  {
    'Uma aliança profana‡Нечестивый союз‡Eine unheilige Allianz‡사악한 동맹‡Una alianza nefasta‡Una alianza impía‡Une alliance impie‡邪恶的盟友‡邪惡的盟友',
    nil,
    'Leve a cabeça do Embaixador Malcin para Varimatras, na Cidade Baixa.‡Принести голову посла Малкина Вариматрасу в Подгород.‡Bringt den Kopf von Botschafter Malcin zu Varimathras nach Undercity.‡사절 말킨을 처치한 다음 언더시티에 있는 바리마트라스에게 그의 머리카락을 증거로 가져가야 합니다.‡Lleva la cabeza del embajador Malcin a Varimathras, que está en Entrañas.‡Lleva la cabeza del embajador Malcin a Varimathras en Entrañas.‡Apporter la Tête de l\'Ambassadeur Malcin à Varimathras, à Undercity.‡把玛克林大使的头颅交给幽暗城的瓦里玛萨斯。‡把瑪克林大使的頭顱交給幽暗城的瓦裏瑪薩斯。',
  }
},
[6522] = {
  {
    'Uma aliança profana‡Нечестивый союз‡Eine unheilige Allianz‡사악한 동맹‡Una alianza nefasta‡Una alianza impía‡Une alliance impie‡邪恶的盟友‡邪惡的盟友',
    nil,
    'Leve o Pergaminho Pequeno para Varimatras, na Cidade Baixa.‡Отнесите маленький свиток Вариматрасу в Подгород.‡Bringt die kleine Rolle zu Varimathras nach Undercity.‡작은 두루마리를 언더시티에 있는 바리마트라스에게 가져가야 합니다.‡Lleva el pergamino a Varimathras, que está en Entrañas.‡Lleva el pergamino pequeño a Varimathras en Entrañas.‡Apporter le Petit parchemin à Varimathras, à Undercity.‡把小卷轴交给幽暗城的瓦里玛萨斯。‡把小卷軸交給幽暗城的瓦裏瑪薩斯。',
  }
},
[6523] = {
  {
    'Proteja Kaya‡Защита Кайи‡Schützt Kaya‡카야 구출‡Proteje a Kaya‡Protege a Kaya‡Protéger Kaya‡保护卡雅‡保護卡雅',
    nil,
    'Escolte Kaya Casco Chato até a Aldeia Apareje e, então, fale novamente com Makaba Casco Chato perto da extremidade sudeste das Torres de Pedra.‡Проводите Кайю Плоское Копыто до Лагеря Апарахе, затем вернитесь к Макабе Плоскому Копыту, находящемуся поблизости от юго-восточного края Каменного Когтя.‡Begleitet Kaya Flathoof zum Camp Aparaje und kehrt dann zu Makaba Flathoof am südöstlichen Rand des Steinkrallengebirges zurück.‡카야 플랫후프를 아파라제 야영지까지 호위한 다음 돌발톱 산맥 남동쪽 가장자리에 있는 마카바 플랫후프에게 소식을 전하러 가야 합니다.‡Escolta a Kaya Patatleta hasta el Campamento Aparaje y ve a ver a Makaba Patatleta cerca del límite sureste de Espolón.‡Escolta a Kaya Pezuña Plana hasta el Campamento Aparaje y ve a ver a Makaba Pezuña Plana cerca del límite sureste de Espolón.‡Escorter Kaya Flathoof au Camp Aparaje, puis retourner voir Makaba Flathoof, à côté de la frontière sud-est des Serres-Rocheuses.‡护送卡雅·扁蹄回到阿帕拉耶营地，然后到石爪山东南边界附近的玛卡巴·扁蹄那里去复命。‡護送卡雅·扁蹄回到阿帕拉耶營地，然後到石爪山東南邊界附近的瑪卡巴·扁蹄那裏去復命。',
  }
},
[6541] = {
  {
    'Apresente-se a Kadrak‡Донесение Кадраку‡Meldung bei Kadrak‡카드라크에게 보고‡Preséntate ante Kadrak‡Preséntate ante Kadrak‡Rapport à Kadrak‡向卡德拉克报到‡向卡德拉克報到',
    nil,
    'Apresente-se a Kadrak na torre de vigia dos Sertões Setentrionais.‡Доложитесь Кадраку в сторожевой башне в северных Степях.‡Meldet Euch im Wachturm im Norden des Brachlands bei Kadrak.‡불모의 땅 북부의 감시탑에 있는 카드라크에게 보고하십시오.‡Preséntate ante Kadrak en la torre de vigilancia en los Baldíos del Norte.‡Preséntate ante Kadrak en la torre de vigilancia en Los Baldíos del Norte.‡Faire un rapport à Kadrak, dans la tour de guet, dans le nord des Tarides.‡到贫瘠之地北部的卡德拉克那里报到。‡到貧瘠之地北部的卡德拉克那裏報到。',
  }
},
[6542] = {
  {
    'Apresente-se a Kadrak‡Донесение Кадраку‡Meldung bei Kadrak‡카드라크에게 보고‡Preséntate ante Kadrak‡Preséntate ante Kadrak‡Rapport à Kadrak‡向卡德拉克报到‡向卡德拉克報到',
    nil,
    'Apresente-se a Kadrak na torre de vigia dos Sertões Setentrionais.‡Доложитесь Кадраку в сторожевой башне в северных Степях.‡Meldet Euch im Wachturm im Norden des Brachlands bei Kadrak.‡불모의 땅 북부의 감시탑에 있는 카드라크에게 보고하십시오.‡Abre el fajo de informes. Lleva los informes Grito de Guerra al explorador Grito de Guerra, al corredor Grito de Guerra y al escolta Grito de Guerra. Lleva los últimos informes que ellos te den a Kadrak en la torre de vigilancia norte en los Baldíos.‡Preséntate ante Kadrak en la torre de vigilancia en Los Baldíos del Norte.‡Faire un rapport à Kadrak, dans la tour de guet, dans le nord des Tarides.‡到贫瘠之地北部的卡德拉克那里报到。‡到貧瘠之地北部的卡德拉克那裏報到。',
  }
},
[6543] = {
  {
    'Os relatórios dos Brado Guerreiro‡Отчет Песни Войны‡Die Warsongberichte‡전쟁노래부족 보고서‡Los informes Grito de Guerra‡Los informes Grito de Guerra‡Les rapports Warsong‡战歌报告‡戰歌報告',
    nil,
    'Abra o Monte de Relatórios e entregue os Relatórios dos Brado Guerreiro ao Batedor do Brado Guerreiro, o Mensageiro do Brado Guerreiro e o Pioneiro do Brado Guerreiro. Em seguida, entregue o informe sobre a situação atual que você receberá de cada um deles para Kadrak, na torre de vigia do norte dos Sertões.‡Распакуйте связку донесений. Доставьте отчеты Песни Войны разведчику, гонцу и всаднику клана Песни Войны. Возьмите у них новые донесения для Кадрака и доставьте ему в северную сторожевую башню в Степях.‡Bringt die Warsongberichte dem Warsongspäher, dem Warsongläufer und der Warsongvorhut. Meldet die Neuigkeiten, die Ihr von ihnen erfahrt, Kadrak im nördlichen Wachturm des Brachlands.‡먼저 보고서 뭉치를 여십시오. 전쟁노래부족 길잡이, 전쟁노래부족 정찰병, 그리고 전쟁노래부족 척후병에게 전쟁노래부족 보고서를 가져가야 합니다. 그들의 보고 내용을 담고 있는 최신정보 3개를 받아서 불모의 땅 북부 감시탑에 있는 카드라크에게 돌아가십시오.‡Preséntate ante Kadrak en la torre de vigilancia en los Baldíos del Norte.‡Abre el fardo de informes. Lleva los informes Grito de Guerra al explorador Grito de Guerra, al corredor Grito de Guerra y al escolta Grito de Guerra. Preséntate ante Kadrak en la torre de vigilancia norte en los Baldíos con la información que te hayan dado.‡Apporter les Rapports du clan Warsong à l’Eclaireur Warsong, au Messager Warsong et au Voltigeur Warsong. Rapporter leurs comptes rendus mis à jour à Kadrak, dans la tour de guet nord, dans les Tarides.‡打开报告集，把战歌报告交给战歌斥候、战歌信使和战歌侦查骑兵。把他们的最新报告交给贫瘠之地北部哨塔上的卡德拉克。‡打開報告集，把戰歌報告交給戰歌斥候、戰歌信使和戰歌偵查騎兵。把他們的最新報告交給貧瘠之地北部哨塔上的卡德拉克。',
  }
},
[6544] = {
  {
    'Junte-se aos bons‡Налет Торека‡Toreks Angriff‡토렉의 공격‡El asalto de Torek‡El asalto de Torek‡L\'assaut de Torek‡托雷克的突袭‡托雷克的突襲',
    nil,
    'Acompanhe Torek no ataque ao Posto Avançado Asa de Prata e sua comandante, Duriel Flameluna. Em seguida, apresente-se a Ertog Raivatusco no Posto Machadada.‡Сопровождайте Торека при нападении на Аванпост Среброкрылых и в сражении с Дариэлем Лунным Пламенем, затем доложитесь Эртогу Лютоклыку на заставе Расщепленного Древа.‡Eskortiert Torek bei seinem Angriff auf den Außenposten der Silverwing und Duriel Moonfire. Erstattet dann Ertog Ragetusk im Splintertreeposten Bericht.‡은빛날개 전초기지와 두리엘 문파이어를 공격하는 토렉을 호위한 후, 토막나무 주둔지에 있는 에르톡 레이지터스크에게 보고하십시오.‡Escolta a Torek en su ataque sobre la Avanzada Ala de Plata contra Duriel Fuegolunar e informa después a Ertog Colmillorrabioso en el Puesto del Hachazo.‡Escolta a Torek en su ataque sobre la Avanzada Ala de Plata contra Duriel Fuegolunar e informa después a Ertog Colmillorrabioso en el Puesto del Hachazo.‡Escorter Torek lors de son attaque contre l’Avant-poste d\'Aile-argent et Duriel Moonfire, puis faire un rapport à Ertog Ragetusk, au Poste de Bois-brisé.‡保护在银翼哨站与杜瑞尔·月火作战的托雷克，然后向慰籍之林的埃尔托格·怒齿汇报胜利的消息。‡保護在銀翼哨站與杜瑞爾·月火作戰的托雷克，然後向慰籍之林的埃爾托格·怒齒匯報勝利的消息。',
  }
},
[6545] = {
  {
    'O informe do mensageiro Brado Guerreiro‡Сведения гонца клана Песни Войны‡Warsongläufer-Update‡전쟁노래부족 길잡이 최신정보‡Novedades del corredor Grito de Guerra‡Novedades de corredor Grito de Guerra‡Mise à jour du Messager Warsong‡战歌信使的报告‡戰歌信使的報告',
