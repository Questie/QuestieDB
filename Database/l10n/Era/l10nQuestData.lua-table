    nil,
  }
},
[6804] = {
  {
    'Água contaminada‡Отравленная вода‡Vergiftetes Wasser‡독이 든 물‡Agua envenenada‡Agua envenenada‡Eau empoisonnée‡被囚禁的水元素‡被囚禁的水元素',
    nil,
    'Use o Aspecto de Neptulon nos elementais contaminados das Terras Pestilentas Orientais. Leve 12 Braçadeiras Dissonantes e o Aspecto de Neptulon ao Duque Hidráxis em Azshara.‡Исцелите отравленных элементалей в Восточных Чумных землях с помощью аспекта Нептулона. Принесите 12 браслетов колыхающихся волноплесков и аспект Нептулона герцогу Гидраксису в Азшару.‡Wendet den Aspekt von Neptulon auf die vergifteten Elementare der östlichen Pestländer an. Bringt 12 disharmonische Armschienen, sowie den Aspekt von Neptulon zu Fürst Hydraxis in Azshara.‡동부 역병지대에 있는 역병에 걸린 정령들에게 넵튤론의 상을 사용하십시오. 아즈샤라에 있는 군주 히드락시스에게 불협의 팔보호구 12개와 넵튤론의 상을 가져가야 합니다.‡Aplica el aspecto de Neptulon a los elementales infectados de las Tierras de la Peste del Este. Lleva 12 de sus brazales de vínculo y el aspecto de Neptulon al duque Hydraxis a Azshara.‡Aplica el aspecto de Neptulon a los elementales infectados de las Tierras de la Peste del Este. Lleva 12 de sus brazales discordantes y el aspecto de Neptulon al duque Hydraxis a Azshara.‡Utiliser l’Aspect de Neptulon sur les élémentaires empoisonnés des Maleterres de l’est. Apporter 12 Bracelets discordants et l’Aspect de Neptulon au duc Hydraxis, en Azshara.‡对东瘟疫之地的被感染的水元素使用海神之水。把12副不谐护腕和海神之水交给艾萨拉的海达克西斯公爵。‡對東瘟疫之地的被感染的水元素使用海神之水。把12副不諧護腕和海神之水交給艾薩拉的海達克西斯公爵。',
  }
},
[6805] = {
  {
    'Tempestades e estrondores‡Буря в пустыне‡Stürmer und Rumpler‡먼지 폭풍과 우레의 모래정령‡Sirocosos y reptarenas‡Sirocosos y reptarenas‡Tempêtes‡雷暴和磐石‡雷暴和磐石',
    nil,
    'Mate 15 Tempestades de Poeira e 15 Estrondores do Deserto e fale novamente com o Duque Hidráxis em Azshara.‡Убейте 15 пылевихрей и 15 пустынных грохотунов, а затем возвращайтесь к герцогу Гидраксису в Азшару.‡Tötet 15 Staubstürmer und 15 Wüstenrumpler und kehrt dann zu Fürst Hydraxis in Azshara zurück.‡먼지 폭풍 15마리와 우레의 모래정령 15마리를 처치하고 아즈샤라에 있는 군주 히드락시스에게 돌아가야 합니다.‡Mata a 15 agitadores sirocosos y 15 estruendores del desierto y vuelve a ver al duque Hydraxis a Azshara.‡Mata a 15 agitadores sirocosos y 15 estruendores del desierto y vuelve a ver al duque Hydraxis a Azshara.‡Tuer 15 Tempétueux de poussière et 15 Grondeurs du désert, puis retourner voir le duc Hydraxis, en Azshara.‡杀死15个灰尘风暴和15个沙漠奔行者，然后回到艾萨拉的海达克西斯公爵那儿。‡殺死15個灰塵風暴和15個沙漠奔行者，然後回到艾薩拉的海達克西斯公爵那兒。',
  }
},
[6821] = {
  {
    'O Olho do Mirabrasa‡Око Углеглаза‡Auge des Glutsehers‡엠버시어의 눈‡Ojo de brasadivino‡Ojo del Brasadivino‡Oeil du Prophète ardent‡艾博希尔之眼‡艾博希爾之眼',
    nil,
    'Leve o Olho do Mirabrasa ao Duque Hidráxis em Azshara.‡Принесите глаз Созерцателя Углей герцогу Гидраксису в Азшару.‡Bringt das Auge des Glutsehers zu Fürst Hydraxis in Azshara.‡아즈샤라에 있는 군주 히드락시스에게 엠버시어의 눈을 가져가야 합니다.‡Lleva el ojo del Piroguardián brasadivino al duque Hydraxis a Azshara.‡Lleva el ojo del Brasadivino al duque Hydraxis a Azshara.‡Apporter l’Oeil du Prophète ardent au duc Hydraxis, en Azshara.‡将艾博希尔之眼交给艾萨拉的海达克西斯公爵。‡將艾博希爾之眼交給艾薩拉的海達克西斯公爵。',
  }
},
[6822] = {
  {
    'O Núcleo Derretido‡Огненные Недра‡Der geschmolzene Kern‡화산 심장부‡El Núcleo de Magma‡El Núcleo de Magma‡Le Cœur du Magma‡熔火之心‡熔火之心',
    nil,
    'Mate 1 Senhor do Fogo, 1 Gigante Derretido, 1 Cão-magma Antigo e 1 Irrompedor de Lava e depois fale novamente com o Duque Hidráxis em Azshara.‡Убейте 1 Повелителя огня, 1 лавового гиганта, 1 древнюю гончую бездны и 1 лавового волноплеска и возвращайтесь к герцогу Гидраксису в Азшару.‡Tötet 1 Feuerlord, 1 geschmolzenen Riesen, 1 uralten Kernhund sowie 1 Lavawoger und kehrt dann zu Fürst Hydraxis in Azshara zurück.‡불의 군주 1마리, 용암거인 1마리, 고대의 심장부 사냥개 1마리, 굽이치는 용암 정령 1마리를 처치한 후 아즈샤라에 있는 군주 히드락시스에게 돌아가야 합니다.‡Mata a 1 Señor del Fuego, 1 gigante fundido, 1 canino del Núcleo y 1 marea de lava y ve a ver al duque Hydraxis a Azshara.‡Mata a 1 señor del Fuego, 1 gigante fundido, 1 can del Núcleo anciano y 1 marea de lava y ve a ver al duque Hydraxis a Azshara.‡Tuer 1 Seigneur du feu, 1 Géant de lave, 1 Chien antique du Magma et 1 Surgisseur de lave, puis retourner voir le duc Hydraxis, à Azshara.‡杀死一个火焰之王、一个熔岩巨人、一个上古熔火恶犬和一个熔岩奔腾者，然后回到艾萨拉的海达克西斯公爵那里。‡殺死壹個火焰之王、壹個熔巖巨人、壹個上古熔火惡犬和壹個熔巖奔騰者，然後回到艾薩拉的海達克西斯公爵那裏。',
  }
},
[6823] = {
  {
    'Agente de Hidráxis‡Агент Гидраксиса‡Agent von Hydraxis‡히드락시스의 하수인‡Agente de Hydraxis‡Agente de Hydraxis‡Agent de Hydraxis‡海达克西斯的使者‡海達克西斯的使者',
    nil,
    'Alcance a reputação de <Honrado/Honrada> pelos Senhores das Águas Hidraxianos e depois fale com o Duque Hidráxis em Azshara.‡Добейтесь уважительного отношеия к себе со стороны Гидраксианских Повелителей Вод, затем отправляйтесь к герцогу Гидраксису в Азшару.‡Verdient Euch eine geehrte Fraktion bei den hydraxianischen Wasserlords und sprecht dann mit Fürst Hydraxis in Azshara.‡히드락시스 물의 군주들로부터 우호적인 평판을 얻은 후 아즈샤라에 있는 군주 히드락시스와 대화해야 합니다.‡Consigue una mención de honor de los Señores del Agua y habla con el duque Hydraxis en Azshara.‡Consigue una mención de honor de los Señores del Agua y habla con el duque Hydraxis en Azshara.‡Parvenir au niveau de réputation Honoré auprès des Hydraxiens, puis parler au duc Hydraxis, en Azshara.‡在海达希亚水元素中达到被尊敬的声望，然后与艾萨拉的海达克西斯公爵谈一谈。‡在海達希亞水元素中達到被尊敬的聲望，然後與艾薩拉的海達克西斯公爵談壹談。',
  }
},
[6824] = {
  {
    'Mãos do inimigo‡Руки врага‡Hände des Feindes‡적의 손‡Las manos de los enemigos‡Las manos de los enemigos‡Les mains de l\'ennemi‡敌人之手‡敵人之手',
    nil,
    'Leve as Mãos de Lúcifron, Sulfuron, Geena e Shazzrah ao Duque Hidráxis em Azshara.‡Принесите руки Люцифрона, Сульфурона, Гееннаса и Шаззраха герцогу Гидраксису в Азшару.‡Bringt die Hände von Lucifron, Sulfuron, Gehennas und Shazzrah zu Fürst Hydraxis in Azshara.‡아즈샤라에 있는 군주 히드락시스에게 루시프론, 설퍼론, 게헨나스, 샤즈라의 손을 가져가야 합니다.‡Lleva las manos de Lucifron, Sulfuron, Gehennas y Shazzrah al duque Hydraxis a Azshara.‡Lleva las manos de Lucifron, Sulfuron, Gehennas y Shazzrah al duque Hydraxis a Azshara.‡Apporter les Mains de Lucifron, de Sulfuron, de Gehennas et de Shazzrah au duc Hydraxis, en Azshara.‡将鲁西弗隆之手、萨弗隆之手、基赫纳斯之手和沙斯拉尔之手交给艾萨拉的海达克西斯公爵。‡將魯西弗隆之手、薩弗隆之手、基赫納斯之手和沙斯拉爾之手交給艾薩拉的海達克西斯公爵。',
  }
},
[6825] = {
  {
    'Clamor do Ar – Esquadrilha de Guse‡Воздух зовет – флот Гуса‡Ruf der Lüfte - Guses Luftflotte‡바람의 부름 - 구스의 편대‡La llamada del aire: flota de Guse‡La llamada del aire: flota de Guse‡L\'appel des airs - l\'escadrille de Guse‡天空的召唤 - 古斯的部队‡天空的召喚 - 古斯的部隊',
