    nil,
  }
},
[6546] = {
  {
    'O informe do pioneiro do Brado Guerreiro‡Сведения всадника из клана Песни Войны‡Warsongvorhut-Update‡전쟁노래부족 척후병 최신정보‡Novedades del escolta Grito de Guerra‡Novedades de escolta Grito de Guerra‡Mise à jour du voltigeur Warsong‡战歌侍从的报告‡戰歌侍從的報告',
    nil,
    nil,
  }
},
[6547] = {
  {
    'O informe do batedor Brado Guerreiro‡Сведения разведчика клана Песни Войны‡Warsongspäher-Update‡전쟁노래부족 정찰병 최신정보‡Novedades del explorador Grito de Guerra‡Novedades de explorador Grito de Guerra‡Mise à jour de l\'Eclaireur Warsong‡战歌斥候的报告‡戰歌斥候的報告',
    nil,
    nil,
  }
},
[6548] = {
  {
    'Vingue minha vila‡Отомсти за мою деревню‡Rächt mein Dorf‡침략에 대한 복수‡Venga mi aldea‡Venga mi aldea‡Vengez mon village !‡为我的村庄复仇‡為我的村莊復仇',
    nil,
    'Mate 8 Rufiões Temível Totem e 6 Mercenários Temível Totem para, então, voltar a falar com Makaba Casco Chato perto da extremidade sudoeste das Torres de Pedra.‡Убейте 8 бузотеров и 6 наемников из племени Зловещего Тотема, затем вернитесь к Макабе Плоскому Копыту, ожидающему вас на юго-восточной границе Когтистых гор.‡Tötet 8 Grobiane der Grimmtotem und 6 Söldner der Grimmtotem. Kehrt dann zu Makaba Flathoof am südöstlichen Rand des Steinkrallengebirges zurück.‡그림토템부족 약탈자 8명과 그림토템부족 용병 6명을 처치한 다음 돌발톱 산맥 동남쪽 가장자리에 있는 마카바 플랫후프에게 돌아가야 합니다.‡Mata 8 rufianes Tótem Siniestro y 6 mercenarios Tótem Siniestro. A continuación, ve a ver a Makaba Patatleta cerca del límite sureste de Espolón.‡Mata a 8 rufianes Tótem Siniestro y a 6 mercenarios Tótem Siniestro. A continuación, ve a ver a Makaba Pezuña Plana cerca del límite sureste de Espolón.‡Tuez 8 Forbans du Totem sinistre et 6 Mercenaires du Totem sinistre, puis retournez voir Makaba Flathoof, près de la lisière sud-est des Serres-Rocheuses.‡杀掉8个恐怖图腾恶徒和6个恐怖图腾佣兵，然后向石爪山脉东南边界处的玛卡巴·扁蹄复命。‡殺掉8個恐怖圖騰惡徒和6個恐怖圖騰傭兵，然後向石爪山脈東南邊界處的瑪卡巴·扁蹄復命。',
  }
},
[6561] = {
  {
    'Vilania das Profundezas‡Жестокость Черных Глубин‡Blackfathom-Schurkerei‡검은심연의 음모‡La vileza de Brazanegra‡La vileza de Brazanegra‡L\'infamie de Brassenoire‡黑暗深渊中的邪恶‡黑暗深淵中的邪惡',
    nil,
    'Leve a cabeça do Senhor do Crepúsculo Kelris para Bashana Runa Totem, no Penhasco do Trovão.‡Принесите голову Повелителя сумрака Келриса Башане Руническому Тотему в Громовой Утес.‡Bringt den Kopf des Twilight-Lords Kelris zu Bashana Runetotem in Thunder Bluff.‡황혼의 군주 켈리스를 처치하고 그 증거로 그의 머리카락을 썬더 블러프에 있는 바샤나 룬토템에게 가져가야 합니다.‡Llévale la cabeza del Señor Crepuscular Kelris a Bashana Runatótem en Cima del Trueno.‡Llévale la cabeza del señor crepuscular Kelris a Bashana Tótem de Runa en Cima del Trueno.‡Apporter la tête du Seigneur du crépuscule Kelris à Bashana Runetotem, à Thunder Bluff.‡把梦游者克尔里斯的头颅交给雷霆崖的巴珊娜·符文图腾。‡把夢遊者克爾裏斯的頭顱交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[6562] = {
  {
    'Problemas nas Profundezas‡Угроза из Глубин‡Ärger in der Tiefe‡검은심연의 나락으로...‡Problemas en las profundidades‡Problemas en las profundidades‡Problèmes dans les profondeurs‡帮助耶努萨克雷‡幫助耶努薩克雷',
    nil,
    'Fale com Je\'neu Sancrea no Vale Gris.‡Поговорите с Дже\'неу Санкри в Ясеневом лесу.‡Sprecht in Ashenvale mit Je\'neu Sancrea.‡잿빛 골짜기에 있는 제네우 생크리와 대화하십시오.‡Habla con Je\'neu Sancrea en Vallefresno.‡Habla con Je\'neu Sancrea en Vallefresno.‡Parler à Je\'neu Sancrea, à Ashenvale.‡与灰谷的耶努萨克雷谈一谈。‡與灰谷的耶努薩克雷談壹談。',
  }
},
[6563] = {
  {
    'A essência de Aku\'mai‡Сущность Аку\'май‡Die Essenz von Aku\'mai‡아쿠마이의 정수‡La esencia de Aku\'Mai‡La esencia de Aku\'Mai‡L\'Essence d\'Aku\'Mai‡阿库麦尔水晶‡阿庫麥爾水晶',
    nil,
    'Entregue 20 Safiras de Aku\'Mai a Je\'neu Sancrea no Vale Gris.‡Принесите 20 сапфиров Аку\'май Дже\'неу Санкри в Ясеневый лес.‡Bringt 20 Saphire von Aku\'mai zu Je\'neu Sancrea nach Ashenvale.‡잿빛 골짜기에 있는 제네우 생크리에게 아쿠마이의 사파이어 20개를 가져가야 합니다.‡Llévale 20 zafiros de Aku\'Mai a Je\'neu Sancrea en Vallefresno.‡Llévale 20 zafiros de Aku\'Mai a Je\'neu Sancrea en Vallefresno.‡Apporter 20 Saphirs d\'Aku\'Mai à Je\'neu Sancrea, à Ashenvale.‡收集20颗阿库麦尔蓝宝石，把它们交给灰谷的耶努萨克雷。‡收集20顆阿庫麥爾藍寶石，把它們交給灰谷的耶努薩克雷。',
  }
},
[6564] = {
  {
    'Lealdade aos Deuses Antigos‡Верность Древним богам‡Treue zu den Alten Göttern‡고대 신들에 대한 충성‡Lealtad a los dioses antiguos‡Lealtad a los dioses antiguos‡Allégeance aux Dieux très anciens‡上古之神的仆从‡上古之神的仆從',
    nil,
    'Leve o Bilhete Úmido para Je\'neu Sancrea, no Vale Gris.‡Принесите отсыревшую записку Дже\'неу Санкри в Ясеневый лес.‡Bringt die durchfeuchtete Notiz zu Je\'neu Sancrea nach Ashenvale.‡축축한 메모를 잿빛 골짜기의 제네우 생크리에게 가져가십시오.‡Llévale la nota humedecida a Je\'neu Sancrea en Vallefresno.‡Llévale la nota mojada a Je\'neu Sancrea en Vallefresno.‡Apporter la Note humide à Je\'neu Sancrea, à Ashenvale.‡把潮湿的便笺交给灰谷的耶努萨克雷。‡把潮濕的便箋交給灰谷的耶努薩克雷。',
  }
},
[6565] = {
  {
    'Lealdade aos Deuses Antigos‡Верность Древним богам‡Treue zu den Alten Göttern‡고대 신들에 대한 충성‡Lealtad a los dioses antiguos‡Lealtad a los dioses antiguos‡Allégeance aux Dieux très anciens‡上古之神的仆从‡上古之神的仆從',
    nil,
    'Mate Lorgus Jett nas Profundezas Negras e depois fale novamente com Je\'neu Sancrea no Vale Gris.‡Убейте Лоргуса Джетта в Непроглядной Пучине и вернитесь к Дже\'неу Санкри в Ясеневый лес.‡Tötet Lorgus Jett in der Blackfathom-Tiefe und kehrt dann zu Je\'neu Sancrea nach Ashenvale zurück.‡검은심연의 나락에 있는 로구스 제트를 처치한 후 잿빛 골짜기의 제네우 생크리에게 돌아가십시오.‡Mata a Lorgus Jett en las Cavernas de Brazanegra y vuelve junto a Je\'neu Sancrea en Vallefresno.‡Mata a Lorgus Jett en las Cavernas de Brazanegra y vuelve con Je\'neu Sancrea en Vallefresno.‡Tuer Lorgus Jett, dans les Profondeurs de Brassenoire et retourner voir Je\'neu Sancrea, à Ashenvale.‡杀掉黑暗深渊里的洛古斯·杰特，然后向灰谷的耶努萨克雷复命。‡殺掉黑暗深淵裏的洛古斯·傑特，然後向灰谷的耶努薩克雷復命。',
  }
},
[6566] = {
  {
    'O que o vento carrega‡Что принес ветер‡Was der Wind erzählt‡바람이 전해 온 소식‡Lo que trae el viento‡Lo que trae el viento‡Ce que le vent apporte‡风吹来的消息‡風吹來的消息',
    nil,
    'Ouça Thrall.‡Выслушайте Тралла.‡Hört Thrall zu.‡스랄의 이야기를 들어야 합니다.‡Escucha a Thrall.‡Escucha a Thrall.‡Écouter Thrall.‡听萨尔讲话。‡聽薩爾講話。',
  }
},
[6567] = {
  {
    'O campeão da Horda‡Защитник Орды‡Der Champion der Horde‡호드의 용사‡El Campeón de la Horda‡El Campeón de la Horda‡Le Champion de la Horde‡部落的勇士‡部落的勇士',
    nil,
    'Procure Rexxar. O Chefe Guerreiro <o/a> instruiu quanto ao paradeiro dele. Procure nos caminhos de Desolação, entre a Cordilheira das Torres de Pedra e Feralas.‡Найдите Рексара. Вождь сказал, что он бродит в Пустошах, по дороге, что ведет из Когтичтых гор в Фералас.‡Sucht Rexxar auf. Der Kriegshäuptling hat Euch erklärt, wo Ihr ihn finden könnt. Sucht die Wege von Desolace zwischen dem Steinkrallengebirge und Feralas ab.‡렉사르를 찾아야 합니다. 그의 행방은 대족장이 설명해 주었습니다. 돌발톱 산맥과 페랄라스 사이에 있는 잊혀진 땅의 길에서 찾아 보십시오.‡Busca a Rexxar. El jefe de guerra te ha indicado dónde encontrarlo. Recorre los caminos de Desolace, entre la Sierra Espolón y Feralas.‡Busca a Rexxar. El jefe de guerra te ha indicado dónde encontrarlo. Recorre los caminos de Desolace, entre la Sierra Espolón y Feralas.‡Chercher Rexxar. Le Chef de guerre vous a dit où il était. Chercher sur les chemins de Désolace, entre les Serres-Rocheuses et Feralas.‡按照酋长的指示找到雷克萨。他在石爪山和菲拉斯之间的凄凉之地游荡。‡按照酋長的指示找到雷克薩。他在石爪山和菲拉斯之間的淒涼之地遊蕩。',
  }
},
[6568] = {
  {
    'O testamento de Rexxar‡Завет Рексара‡Nachricht von Rexxar‡렉사르의 유언‡El testamento de Rexxar‡El testimonio de Rexxar‡Le testament de Rexxar‡雷克萨的证明‡雷克薩的證明',
    nil,
    'Leve o Testamento de Rexxar para Myranda, a Bruxa Velha, nas Terras Pestilentas Ocidentais.‡Доставьте письмо Рексара Миранде Колдунье в Западные Чумные земли.‡Überbringt Myranda der Vettel in den westlichen Pestländern Rexxars Nachricht.‡서부 역병지대에 있는 노파 미란다에게 렉사르의 유서를 전달해야 합니다.‡Entrega el testamento de Rexxar a Myranda la Fada. Está en las Tierras de la Peste del Oeste.‡Entrégale el testimonio de Rexxar a Myranda la Fada en las Tierras de la Peste del Oeste.‡Apporter le Testament de Rexxar à Myranda la Mégère, dans les Maleterres de l’ouest.‡把雷克萨的证明交给西瘟疫之地的巫女麦兰达。‡把雷克薩的證明交給西瘟疫之地的巫女麥蘭達。',
  }
},
[6569] = {
  {
    'Ilusões ópticas‡Иллюзии Ока‡Oculus-Illusionen‡눈동자의 환영‡Ilusiones oculares‡Ilusiones oculares‡Illusions d\'Occulus‡黑龙幻象‡黑龍幻象',
    nil,
    'Vá para o Pico da Rocha Negra e colete 20 Olhos de Dragomorfo Preto. Fale novamente com Myranda, a Bruxa Velha, depois que tiver terminado a tarefa.‡Отправляйтесь на пик Черной горы и добудьте 20 глаз черных драконидов. По выполнении задания вернитесь к Миранде Колдунье.‡Reist zur Blackrockspitze und sammelt 20 schwarze Drachenbrutaugen. Kehrt zu Myranda der Vettel zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 첨탑으로 가서 검은 용혈족의 눈동자 20개를 모아서 노파 미란다에게 돌아가야 합니다.‡Viaja a la Cumbre de Roca Negra y recoge 20 ojos de dragauro negro. Cuando hayas terminado tu tarea regresa con Myranda la Fada.‡Viaja a la Cumbre de Roca Negra y recoge 20 ojos de dragauro negro. Cuando hayas terminado tu tarea regresa con Myranda la Fada.‡Aller au Pic Blackrock et collecter 20 Yeux de draconide noir. Retourner voir Myranda la Mégère, quand la tâche sera terminée.‡到黑石塔去收集20颗黑色龙人的眼球，完成任务之后回到巫女麦兰达那里。‡到黑石塔去收集20顆黑色龍人的眼球，完成任務之後回到巫女麥蘭達那裏。',
  }
},
[6570] = {
  {
    'Ardeluta‡Огнебор‡Aschenschwinge‡엠버스트라이프‡Brasaliza‡Brasaliza‡Brandeguerre‡埃博斯塔夫‡埃博斯塔夫',
    nil,
    'Vá até o Pântano da Serpe, no Pântano Vadeoso, e procure o Covil de Ardeluta. Quando estiver lá, use o Amuleto de Subversão Dracônica e fale com Ardeluta.‡Отправляйтесь в Драконьи топи в Пылевых топях и найдите Логово Огнебора. Оказавшись внутри, наденьте амулет Обмана драконов и поговорите с Огнебором.‡Reist zum Drachensumpf in den Marschen von Dustwallow und begebt Euch in Aschenschwinges Bau. Sobald Ihr darin seid, tragt das Amulett der drachischen Subversion und sprecht mit Aschenschwinge.‡먼지진흙 습지대에 있는 용의 둥지로 가서 엠버스트라이프의 굴을 찾아야 합니다. 안으로 들어가서 용족 파멸의 아뮬렛을 착용하고 엠버스트라이프와 대화해야 합니다.‡Viaja a la Ciénaga de Fuego del Marjal Revolcafango y busca El Cubil de Brasaliza. Cuando estés dentro ponte el Amuleto de Subversión Dracónica y habla con Brasaliza.|n‡Viaja a la Ciénaga de Fuego del Marjal Revolcafango y busca El Cubil de Brasaliza. Cuando estés dentro ponte el Amuleto de Subversión Dracónica y habla con Brasaliza.‡Aller à la tourbière du Ver, dans le marécage d\'Âprefange, et chercher la tanière de Brandeguerre. Une fois à l’intérieur, porter l’Amulette de subversion draconique, et parler à Brandeguerre.‡到尘泥沼泽中的巨龙沼泽去，找到埃博斯塔夫的洞穴。进入洞穴之后戴上龙形护符，然后跟埃博斯塔夫交谈。‡到塵泥沼澤中的巨龍沼澤去，找到埃博斯塔夫的洞穴。進入洞穴之後戴上龍形護符，然後跟埃博斯塔夫交談。',
  }
},
[6571] = {
  {
    'Suprimentos do Brado Guerreiro‡Поставка для Песни Войны‡Warsongnachschub‡전쟁노래부족 보급품‡Suministros Grito de Guerra‡Suministros Grito de Guerra‡Fournitures Warsong‡战歌氏族的补给品‡戰歌氏族的補給品',
    nil,
    'Colete os seguintes Suprimentos do Brado Guerreiro: Lâminas Serrilhadas dos Brado Guerreiro, Corda para Transportar Toras, Óleo dos Brado Guerreiro e Carregamento de Machados dos Brado Guerreiro para Locke Okarr no Posto Machadada.‡Соберите полностью поставку Песни Войны: лезвия для пил, веревку для бревен, масло и партию топоров Песни Войны для Локе Окарра на заставе Расщепленного Древа.‡Tragt den Warsongnachschub zusammen: Warsongsägeblätter, Holzfäller-Seil, Warsongöl und die Warsongaxtlieferung für Locke Okarr im Splintertreeposten.‡토막나무 주둔지의 록케 오카르를 위해 전쟁노래부족 보급품을 모아 오십시오. 전쟁노래부족 톱날, 전쟁노래부족 도끼 상자, 전쟁노래부족 기름, 그리고 벌목용 밧줄을 가져와야 합니다.‡Reúne los suministros Grito de Guerra: las hojas de sierra Grito de Guerra, cabo de troncos, aceite de los Grito de Guerra y el envío de hachas de los Grito de Guerra para Locke Okarr en el Puesto del Hachazo.‡Reúne los suministros Grito de Guerra: las espadas dentadas Grito de Guerra, cuerda, aceite Grito de Guerra y el envío de hachas de los Grito de Guerra para Locke Okarr en el Puesto del Hachazo.‡Collecter les Fournitures Warsong : Lames du clan Warsong, Huile Warsong, et la Cargaison de Haches Warsong ayant pour destinataire Locke Okarr, au Poste de Bois-brisé.‡收集战歌氏族的补给品：战歌锯条、伐木绳、战歌之油，还有一箱战歌之斧。‡收集戰歌氏族的補給品：戰歌鋸條、伐木繩、戰歌之油，還有壹箱戰歌之斧。',
  }
},
[6581] = {
  {
    'Lâminas Serrilhadas dos Brado Guerreiro‡Пилы Песни Войны‡Warsongsägeblätter‡전쟁노래부족 톱날‡Las hojas de sierra Grito de Guerra‡Espadas dentadas Grito de Guerra‡Lames du clan Warsong‡战歌锯条‡戰歌鋸條',
    nil,
    nil,
  }
},
[6582] = {
  {
    'O teste dos crânios: Áugure‡Черепа: Провидец‡Die Prüfung der Schädel, Scryer‡해골 시험 - 스크라이어‡La prueba de las calaveras, Arúspice‡La prueba de los cráneos, Arúspice‡L\'épreuve des crânes, Clairvoyant‡龙骨试炼，斯克利尔‡龍骨試煉，斯克利爾',
    nil,
    'Encontre e mate o Áugure, o draco da Revoada Dragônica Azul. Arranque a cabeça do draco morto e leve-a para Ardeluta.|nVocê sabe que o Áugure se encontra em Hibérnia.‡Найдите в Зимних Ключах избранного бойца синих дракона по имени Провидец и убейте его. С его черепом вернитесь к Огнебору.‡Ihr müsst Scryer, den Champion der blauen Großdrachen, finden und ihn töten. Schlagt seinem Kadaver den Schädel ab und bringt ihn zu Aschenschwinge.|nIhr wisst, dass Scryer in Winterspring zu finden ist.‡여명의 설원에서 찾을 수 있는 푸른용군단의 용사 스크라이어를 찾아 처치해야 합니다. 그의 시체에서 해골을 수습해서 엠버스트라이프에게 돌아가야 합니다.‡Debes encontrar a Arúspice, el campeón draco del Vuelo Azul y matarlo. Separa su calavera de su cuerpo y llévasela a Brasaliza.|nSabes que puedes encontrar a Arúspice en Cuna del Invierno.‡Debes encontrar a Arúspice, el Campeón draco del Vuelo Azul y matarlo. Separa su cráneo de su cuerpo y llévaselo a Brasaliza.|nSabes que puedes encontrar a Arúspice en Cuna del Invierno.‡Vous devez trouver Clairvoyant, le drake champion du Vol bleu, et le tuer. Arracher son crâne à son cadavre, et le rapporter à Brandeguerre.|nClairvoyant se trouve au Berceau-de-l\'Hiver.‡找到蓝龙斯克利尔并杀掉他。从他的身上取下他的颅骨，然后将其交给埃博斯塔夫。|n你可以在冬泉谷找到斯克利尔。‡找到藍龍斯克利爾並殺掉他。從他的身上取下他的顱骨，然後將其交給埃博斯塔夫。|n妳可以在冬泉谷找到斯克利爾。',
  }
},
[6583] = {
  {
    'O teste dos crânios: Somnus‡Черепа: Сомнус‡Die Prüfung der Schädel, Somnus‡해골 시험 - 솜누스‡La prueba de las calaveras, Somnus‡La prueba de los cráneos, Somnus‡L\'épreuve des crânes, Somnus‡龙骨试炼，索姆努斯‡龍骨試煉，索姆努斯',
    nil,
    'Destrua Somnus, o draco campeão da Revoada Verde. Pegue seu crânio e leve-o para Ardeluta.‡Убейте вожака зеленых драконов Сомнуса и вернитесь с его черепом к Огнебору.‡Vernichtet den Drachenchampion des grünen Drachenschwarms, Somnus. Nehmt seinen Schädel und bringt ihn zu Aschenschwinge zurück.‡녹색용군단의 우두머리 솜누스를 처치한 후 그의 해골을 수습해서 엠버스트라이프에게 돌아가야 합니다.‡Destruye al campeón draco del Vuelo Verde, Somnus. Lleva su calavera a Brasaliza.‡Destruye al Campeón del Vuelo Verde, Somnus. Lleva su cráneo a Brasaliza.‡Détruire le Champion drake du Vol vert, Somnus. Arracher son crâne à son cadavre, puis le rapporter à Brandeguerre.‡杀掉绿龙索姆努斯，把他的颅骨交给埃博斯塔夫。‡殺掉綠龍索姆努斯，把他的顱骨交給埃博斯塔夫。',
  }
},
[6584] = {
  {
    'O teste dos crânios: Chronalis‡Черепа: Хроналис‡Die Prüfung der Schädel, Chronalis‡해골 시험 - 크로날리스‡La prueba de los cráneos, Chronalis‡La prueba de los cráneos, Chronalis‡L\'épreuve des crânes, Chronalis‡龙骨试炼，克鲁纳里斯‡龍骨試煉，克魯納裏斯',
    nil,
    'Guardando as Cavernas do Tempo no Deserto de Tanaris, encontra-se Chronalis, filho de Nozdormu. Destrua-o e leve seu crânio para Ardeluta.‡Убейте Хроналиса, охраняющего Пещеры Времени в Пустыне Танарис и вернитесь с его черепом к Огнебору.‡Chronalis, ein Kind Nozdormus, bewacht die Höhlen der Zeit in der Tanariswüste. Vernichtet ihn und bringt seinen Schädel zu Aschenschwinge.‡노즈도르무의 자손인 크로날리스가 타나리스 사막에 있는 시간의 동굴을 지키고 있습니다. 그를 처치한 후 그의 해골을 엠버스트라이프에게 가져가야 합니다.‡Chronalis, hijo de Nozdormu, custodia las Cavernas del Tiempo en el Desierto de Tanaris. Destrúyelo y lleva su cráneo a Brasaliza.‡Chronalis, hijo de Nozdormu, custodia las Cavernas del Tiempo en el Desierto de Tanaris. Destrúyelo y lleva su cráneo a Brasaliza.‡Chronalis, enfant de Nozdormu, garde les Grottes du temps, dans le Désert de Tanaris. Tuez-le et rapportez son crâne à Brandeguerre.‡诺兹多姆的孩子克鲁纳里斯在塔纳利斯沙漠守卫着时光之穴。杀了他，把他的颅骨交给埃博斯塔夫。‡諾茲多姆的孩子克魯納裏斯在塔納利斯沙漠守衛著時光之穴。殺了他，把他的顱骨交給埃博斯塔夫。',
  }
},
[6585] = {
  {
    'O teste dos crânios: Axtroz‡Черепа: Акстроз‡Die Prüfung der Schädel, Axtroz‡해골 시험 - 악트로즈‡La prueba de las calaveras, Axtroz‡La prueba de los cráneos, Axtroz‡L\'épreuve des crânes, Axtroz‡龙骨试炼，埃克托兹‡龍骨試煉，埃克托茲',
    nil,
    'Vá para Grim Batol e encontre Axtroz, o draco campeão da Revoada Vermelha. Destrua-o e arranque sua cabeça. Leve o crânio para Ardeluta.‡Отправьтесь в Грим Батол и убейте Акстроза, избранного бойца красных драконов. Принесите его череп Огнебору.‡Begebt Euch nach Grim Batol und spürt Axtroz auf, den Drachenchampion des Roten Drachenschwarms. Vernichtet ihn und nehmt seinen Schädel. Bringt den Schädel zu Aschenschwinge zurück.‡그림 바톨로 가서 붉은용군단의 우두머리 악트로즈를 찾아 그를 처치한 다음 그의 해골을 수습하여 엠버스트라이프에게 돌아가야 합니다.‡Viaja a Grim Batol y encuentra a Axtroz, el campeón draco del Vuelo Rojo. Destrúyelo y hazte con su calavera. Llévasela a Brasaliza.‡Viaja a Grim Batol y encuentra a Axtroz, el Campeón del Vuelo Rojo. Destrúyelo y hazte con su cráneo. Llévaselo a Brasaliza.‡Aller à Grim Batol et traquer Axtroz, le Champion drake du Vol rouge. Le tuer et arracher son crâne, puis l’apporter à Brandeguerre.‡到格瑞姆巴托去杀掉红龙埃克托兹，把他的颅骨交给埃博斯塔夫。‡到格瑞姆巴托去殺掉紅龍埃克托茲，把他的顱骨交給埃博斯塔夫。',
  }
},
[6601] = {
  {
    'Ascensão...‡Вознесение‡Aufstieg...‡진급‡El ascenso‡El ascenso‡Ascension...‡晋升……‡晉升……',
    nil,
    'Pelo jeito, a farsa chegou ao fim. Você já sabe que o Amuleto de Subversão Dracônica criado por Myranda, a Bruxa Velha, não vai funcionar no Pico da Rocha Negra. Você devia ir atrás de Rexxar e explicar a situação. Mostre a ele o Amuleto da Chama Dracônica Fraco. Pode ser que ele saiba o que fazer.‡Казалось бы, загадка разгадана. Вы знаете, что амулет Обмана Драконов, который сделала для вас Миранда Колдунья, не будет работать на пике Черной горы. Найдите Рокаро и расскажите о ваших затруднениях. Покажите ему амулет Угасающего Пламени Дракона. Будем надеяться, он знает что делать.‡Mir scheint, als sei die Charade jetzt vorüber. Ihr wisst, dass das Amulett der drachischen Unterwanderung, das Myranda die Vettel für Euch erschuf, auf der Blackrockspitze nicht funktioniert. Vielleicht solltet Ihr Rexxar aufsuchen und ihm Eure Notlage erklären. Zeigt ihm das glanzlose Drachenfeueramulett. Er wird hoffentlich wissen, was als Nächstes zu tun ist.‡이제 가면놀이는 끝난 것 같습니다. 노파 미란다가 만든 용족 파멸의 아뮬렛이 검은바위 첨탐 안에서 원래 구실을 하지 않는 것을 알고 있습니다. 아마도 렉사르를 찾아가 곤경에 처한 상황을 설명하는 것이 좋겠습니다. 렉사르에게 흐릿한 비룡불꽃 아뮬렛을 보여주면 아마도 필요한 게 무엇인지 알 수 있을 겁니다.‡Diría que se acabaron las charadas. Ya sabes que el Amuleto de Subversión Dracónica que Myranda la Fada creó para ti no funcionará en el interior de la Cumbre de Roca Negra. Quizás deberías buscar a Rexxar y explicarle el apuro en el que te encuentras. Enséñale el amuleto pirodraco apagado. Con un poco de suerte, él sabrá que hay que hacer ahora.‡Parece que la farsa se acabó. Sabes que el Amuleto de Subversión Dracónica que Myranda la Fada creó para ti no funcionará en la Cumbre de Roca Negra. Quizá debas buscar a Rexxar y explicarle tu situación. Muéstrale el Amuleto Pirodraco apagado. Con suerte, él sabrá qué hacer.‡Il semble que la comédie soit finie. Vous savez que l’Amulette de subversion draconique, créée par Myranda la Mégère, ne fonctionnera pas à l’intérieur du pic Blackrock. Peut-être devriez-vous trouver Rexxar et lui exposer votre fâcheuse situation. Montrez-lui l\'Amulette drakefeu terne. Avec un peu de chance, il saura quoi faire.‡看来这场假面舞会就要结束了。你知道麦兰达为你制作的龙形护符在黑石塔里面不会发挥作用，也许你应该去找雷克萨，将你的困境告诉他。把黯淡的龙火护符给他看看，也许他知道下一步该怎么做。‡看來這場假面舞會就要結束了。妳知道麥蘭達為妳制作的龍形護符在黑石塔裏面不會發揮作用，也許妳應該去找雷克薩，將妳的困境告訴他。把黯淡的龍火護符給他看看，也許他知道下壹步該怎麽做。',
  }
},
[6602] = {
  {
    'Sangue do Campeão dos Dragões Negros‡Кровь могучего черного дракона‡Blut des schwarzen Großdrachen-Helden‡검은용 용사의 피‡La sangre de dragón negro campeón‡La sangre de dragón Negro Campeón‡Le sang du champion des dragons noirs‡黑龙勇士之血‡黑龍勇士之血',
    nil,
    'Viaje para o Pico da Rocha Negra e mate o General Drakkisath. Recolha seu sangue e leve-o para Rexxar.‡Отправляйтесь к пику Черной горы и убейте генерала Драккисата. Соберите его кровь и вернитесь к Рокаро.‡Begebt Euch zur Blackrockspitze und tötet General Drakkisath. Sammelt sein Blut und bringt es zu Rexxar.‡검은바위 첨탑으로 가서 사령관 드라키사스를 처치하고 사령관의 피를 모아 렉사르에게 가져가야 합니다.‡Viaja a la Cumbre de Roca Negra y mata al general Drakkisath. Recoge su sangre y llévasela a Rexxar.‡Viaja a la Cumbre de Roca Negra y mata al general Drakkisath. Recoge su sangre y entrégasela a Rexxar.‡Aller au Pic Blackrock, et tuer le général Drakkisath. Récupérer son sang et retourner voir Rexxar.‡到黑石塔去杀掉达基萨斯将军，把它的血交给雷克萨。‡到黑石塔去殺掉達基薩斯將軍，把它的血交給雷克薩。',
  }
},
[6603] = {
  {
    'Problema em Hibérnia!‡Сложности в Зимних ключах!‡Probleme in Winterspring‡여명의 설원에 생긴 문제!‡Problemas en Cuna del Invierno‡Problemas en Cuna del Invierno‡Troubles au Berceau-de-l\'Hiver‡冬泉谷的麻烦！‡冬泉谷的麻煩！',
    nil,
    'Encontre Bruna Covaneve perto das fontes termais de Hibérnia.‡Найдите Донову Снегонору у горячего источника в Зимних ключах.‡Findet Donova Snowden bei den Thermalquellen in Winterspring.‡여명의 설원 간헐천 부근에 있는 도노바 스노우덴을 찾아가야 합니다.‡Encuentra a Donova Cubilnevado cerca de las fuentes termales de Cuna del Invierno.‡Encuentra a Donova Cubilnevado cerca de las fuentes termales de Cuna del Invierno.‡Trouver Donova Snowden, à côté des sources chaudes du Berceau-de-l\'Hiver.‡到冬泉谷的温泉附近去找到多诺瓦·雪山。‡到冬泉谷的溫泉附近去找到多諾瓦·雪山。',
  }
},
[6604] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Fale com Jaron Moldapedra na Aldeia Chuva Estelar.‡Поговорите с Джероном Гранильщиком в деревне Звездопада.‡Sprecht mit Jaron Stoneshaper in Starfall.‡별똥별 마을에 있는 야론 스톤셰이퍼를 만나야 합니다.‡Habla con Jaron Tallapiedras en Aldea Estrella Fugaz.‡Habla con Jaron Tallapiedras en Aldea Estrella Fugaz.‡Parler à Jaron Stoneshaper, au village de Pluie-d\'Etoiles.‡与坠星村的加隆·石矛谈一谈。‡與墜星村的加隆·石矛談壹談。',
  }
},
[6605] = {
  {
    'Sujeitinha esquisita‡Странная дамочка‡Eine seltsame Person‡엽기적인 그녀와의 만남‡Algo extraño‡Algo extraño‡Une étrange personne‡奇怪的家伙‡奇怪的家夥',
    nil,
    'Fale com Winna Perícon na Selva Maleva.‡Поговорите с Винной Хезард в Оскверненном лесу.‡Sprecht im Teufelswald mit Winna Hazzard.‡악령의 숲에 있는 위나 해저드를 만나야 합니다.‡Habla con Winna Hazzard en Frondavil.‡Habla con Winna Riessgo en Frondavil.‡Parler à Winna Hazzard, à Gangrebois.‡与费伍德森林的温娜·哈萨德谈一谈。‡與費伍德森林的溫娜·哈薩德談壹談。',
  }
},
[6606] = {
  {
    'Um pouquinho de sorte‡Немного удачи‡Ein bisschen Glück‡작은 행운‡Un poco de suerte‡Un poco de suerte‡Un peu de chance‡一点运气‡壹點運氣',
    nil,
    'Fale com a Mandingueira Mau\'ari em Visteterna.‡Поговорите со знахаркой Мау\'ари в Кругозоре.‡Sprecht in Everlook mit Hexendoktorin Mau\'ari.‡눈망루 마을에 있는 의술사 마우아리를 만나야 합니다.‡Habla con la médico bruja Mau\'ari en Vista Eterna.‡Habla con la médica bruja Mau\'ari en Vista Eterna.‡Parler à la Mau\'ari, à Long-guet.‡与冬泉谷永望镇的巫医玛艾里谈一谈。‡與冬泉谷永望鎮的巫醫瑪艾裏談壹談。',
  }
},
[6607] = {
  {
    'Nat Pagle, o pescador supremo‡Экстремальная рыбалка Ната Пэгла‡Nat Pagle, Extremangler‡낚시의 달인 내트 페이글‡Nat Pagle, pescador del extremo‡Nat Pagle, pescador extremo‡Nat Pagle, pêcheur de l\'extrême‡钓鱼专家纳特·帕格‡釣魚專家納特·帕格',
    nil,
    'Nat Pagle quer que você pesque os seguintes peixes:|nO Graçapé-brumalga, na Praia Brumalga, que fica no Pântano das Mágoas.|nA Piranha-de-sar\'theris, na Praia de Sar\'theris, que fica na Desolação.|nO Atum-amarelo-de-feralas, no Rio Verdantis, em Feralas.|nA Molinésia-azul-da-costa-selvagem, na Costa Selvagem, na Selva do Espinhaço.|nFale novamente com Nat Pagle quando já tiver fisgado todos!‡Поймайте для Ната Пэгла следующих рыб:|nМахи-махи с берега Туманных Тростников на Болоте Печали.|nУдарник Сартериса с побережья Сар\'Терис из Пустошей.|nФералас-ахи из реки Вердантис из Фераласа.|nСиний плавник Гибельного берега из Тернистой долины.|nПо выполнении вернитесь к Нату Пэглу.‡Nat Pagle möchte, dass Ihr folgende Fische fangt:|nNebelschilf-Mahi Mahi vom Nebelschilfstrand in den Sümpfen des Elends.|nEinen Sar\'theris-Barsch vom Sar\'theris-Strand in Desolace.|nFeralas-Ahi aus dem Verdantis in Feralas.|nBlauwimpel von der ungezähmten Küste im Schlingendorntal.|nKehrt zu Nat Pagle zurück, wenn Ihr alle an Land gezogen habt!‡아래 물고기들을 모두 잡아 내트 페이글에게 돌아가야 합니다.|n슬픔의 늪의 안개갈대 해안에 사는 안개갈대 황새치|n잊혀진 땅의 살데리스 해안에 사는 살데리스 아귀|n페랄라스의 베르단티스 강에 사는 페랄라스 참치|n가시덤불 골짜기의 폭풍 해안에 사는 폭풍 해안 푸른도루묵|n위 물고기를 모두 얻은 후 내트 페이글에게 돌아가십시오.‡Nat Pagle quiere que pesques los siguientes peces:|nMahi mahi juncobruma de la Playa Juncobruma del Pantano de las Penas.|n1 artillero Sar\'theris de la Playa de Sar\'theris de Desolace.|n1 Ahi de Feralas del Río Verdantis de Feralas.|nLatipinia azul de La Costa Salvaje de Vega de Tuercespina.|nCuando los tengas todos, vuelve a buscar a Nat Pagle.‡Nat Pagle quiere que pesques los siguientes peces:|nMahi mahi juncobruma de la Playa Juncobruma del Pantano de las Penas.|n1 artillero Sar\'theris de la Playa de Sar\'theris de Desolace.|n1 Ahi de Feralas del Río Verdantis de Feralas.|nLatipinia azul de La Costa Salvaje de Vega de Tuercespina.|nCuando los tengas todos, vuelve a buscar a Nat Pagle.‡Nat Pagle voudrait que vous attrapiez les poissons suivants :|nLe Mahi Mahi de Brumejonc, de la grève de Brumejonc, dans le marais des Chagrins.|nUn Frappeur Sar\'theris, de la grève de Sar\'theris en Désolace.|nL\'Ahi de Feralas, de la rivière Verdantis de Feralas.|nLe Sailfin bleu de la Côte sauvage, de la Côte sauvage de la vallée de Strangleronce.|nRetournez voir Nat Pagle quand la collecte sera terminée.‡纳特·帕格要你钓到以下几种鱼：|n悲伤沼泽芦苇海岸的芦苇海岸大马哈鱼。|n凄凉之地萨瑟里斯海岸的萨瑟里斯虎鱼。|n菲拉斯沃丹提斯河的菲拉斯草鱼。|n荆棘谷野人海岸的野人海岸蓝色叉牙鱼。|n当你钓到这些鱼之后，就可以回到纳特·帕格那里去了！‡納特·帕格要妳釣到以下幾種魚：|n悲傷沼澤蘆葦海岸的蘆葦海岸大馬哈魚。|n淒涼之地薩瑟裏斯海岸的薩瑟裏斯虎魚。|n菲拉斯沃丹提斯河的菲拉斯草魚。|n荊棘谷野人海岸的野人海岸藍色叉牙魚。|n當妳釣到這些魚之後，就可以回到納特·帕格那裏去了！',
  }
},
[6608] = {
  {
    'Você bom demais‡Больше учить нечему‡Ihr zu gut‡청출어람‡¡Qué bueno eres!‡¡Qué bueno eres!‡Vous êtes trop bon‡你真棒！‡妳真棒！',
    nil,
    'Você acha que Lumak está tentando dizer que ele já não pode mais ajudar a melhorar suas habilidades de pesca. Você pode tentar encontrar o amigo dele, Nat Pagle, um humano pescador, que fica em uma das ilhas ao sul de Theramore (pelo menos é isso o que você acha que Lumak disse).‡Похоже, Лумак хочет сказать, что ему больше нечему вас учить. Возможно, стоит найти его друга Ната Пэгла – человека, который удит рыбу на островах к югу от Терамора. Кажется, Лумак имеет в виду именно это.‡Ihr nehmt an, dass Lumak Euch zu erklären versucht, dass er nicht mehr tun kann, um Eure Angelfertigkeit zu verbessern. Ihr solltet seinen Freund aufsuchen, diesen Nat Pagle, einen Menschen, der auf einer der Inseln südlich von Theramore (jedenfalls glaubt Ihr, dass Lumak das gemeint hat) auf Fischfang geht.‡루막에 말에 의하면 그는 더 이상 당신의 낚시 실력 향상에 도움을 줄 수 없는 듯합니다. 아마 테라모어로 가라는 말인 것 같습니다. 남쪽에 있는 섬 어디엔가에서 낚시를 하고 있을 루막의 인간 친구 내트 페이글을 찾아 보십시오.‡Parece que Lumak piensa que ya no puede enseñarte nada más sobre la pesca. Ve a buscar a su amigo, Nat Pagle, un humano pescador que vive en una isla al sur de Theramore (o eso parece que ha dicho).‡Parece que Lumak piensa que ya no puede enseñarte nada más sobre la pesca. Ve a buscar a su amigo, Nat Pagle, un humano pescador que vive en una isla al sur de Theramore‡Vous pensez que Lumak essaie de vous dire qu’il ne peut plus vous aider à améliorer votre compétence de pêche. Vous devriez essayer de vous adresser maintenant à son ami, Nat Pagle, un pêcheur humain des îles au sud de Theramore (c’est du moins ce que vous croyez comprendre du discours de Lumak).‡你认为鲁玛克想要告诉你，他已经不能帮你提高钓鱼的技能了。也许你应该去找到他的朋友纳特·帕格，他居住在塞拉摩以南的某个岛屿上，他是一名人类渔夫（至少你认为鲁玛克是这么说的）。‡妳認為魯瑪克想要告訴妳，他已經不能幫妳提高釣魚的技能了。也許妳應該去找到他的朋友納特·帕格，他居住在塞拉摩以南的某個島嶼上，他是壹名人類漁夫（至少妳認為魯瑪克是這麽說的）。',
  }
},
[6609] = {
  {
    'Eu não sei nada!‡С меня больше нечего взять!‡Ich hab nix mehr!‡빈털터리!‡¡Me has dejado seco!‡¡Me has dejado seco!‡Il ne me reste rien !‡青出于蓝！‡青出於藍！',
    nil,
    'Vá até a cidade costeira de Theramore, em Kalimdor. A partir de lá, procure uma ilha a sul da capital. Nat Pagle <o/a> aguarda!‡Отправляйтесь на Калимдор, в приморский город Терамор. Там к югу от города найдите остров. Нат Пэгл уже ждет.‡Reist nach Kalimdor zur Küstenstadt Theramore. Dort müsst Ihr nach einer Insel suchen, die südlich der Hauptstadt liegt. Nat Pagle erwartet Euch!‡칼림도어로 가서 해안 도시인 테라모어로 가야 합니다. 그곳 마을에서 남쪽에 있는 섬을 찾아야 합니다. 내트 페이글이 당신을 기다리고 있습니다!‡Ve a Kalimdor, a la ciudad costera de Theramore. Busca una isla hacia el sur. ¡Nat Pagle te espera!‡Ve a Kalimdor, a la ciudad costera de Theramore. Busca una isla hacia el sur. ¡Nat Pagle te espera!‡Aller à Kalimdor, dans la ville côtière de Theramore. À partir de là, chercher une île au sud de la ville principale. Nat Pagle vous attend !‡到卡利姆多大陆的塞拉摩去。从那里向南方出发，找到一座岛屿。纳特·帕格就在岛上等待着你的到来！‡到卡利姆多大陸的塞拉摩去。從那裏向南方出發，找到壹座島嶼。納特·帕格就在島上等待著妳的到來！',
  }
},
[6610] = {
  {
    'Escondidinho Marisquete‡Мидии с сюрпризом‡Muschelette Surprise‡조개 별미‡Sorpresa de almejates‡Sorpresa de almejate‡Surprise de palourdes‡蚌肉大餐‡蚌肉大餐',
    nil,
    'Funesto Marrão quer que você consiga os seguintes itens:|n12 Ovos Gigantescos. Você os encontra nas rocas que vagueiam por Tanaris ou em qualquer pássaro grande.|n10 fatias de Carne de Marisco Condimentada. Você as encontra dentro dos mariscos, óbvio!|n20 pedaços de Queijo Furado de Alterac. Procure alguém que venda esse queijo!|nConsiga todos os itens e fale novamente com Funesto.‡Могиль Быстроруб поручил принести ему следующее:|n12 гигантских яиц. Их можно отыскать у рухов Танариса или других крупных птиц.|n10 кусков острого мяса моллюсков. Разумеется, его добывают у моллюсков!|n20 кусков альтеракского сыра. Из сыроварни!|nСобрав все составляющие, возвращайтесь к Диргу.‡Dirge Quikcleave möchte, dass Ihr folgende Dinge besorgt:|n12 Rieseneier. Ihr findet sie bei den Rocs, die Tanaris durchstreifen, oder anderen Großvogelarten.|n10 Stück scharfes Muschelfleisch. Die findet Ihr natürlich in Muscheln!|n20 Stück Alteraclochkäse. Begebt Euch zu einer Käserei!|nSammelt all diese Gegenstände und kehrt dann zu Dirge zurück.‡더지 퀵클레이브가 다음 재료를 구해 오라고 합니다.|n거대한 알 12개... 타나리스에 떠돌고 있는 로크와 같은 커다란 새에게서 구할 수 있습니다.|n고소한 조갯살 10개... 조개를 열어서 찾을 수 있습니다.|n알터랙 스위스 치즈 20개... 아무 상인이나 붙잡고 알아보십시오.|n모든 재료를 모아서 더지에게 돌아가야 합니다.‡Dirge Hojágil quiere que le consigas lo siguiente:|n12 huevos gigantes. Pueden ser huevos de los rocs que deambulan por Tanaris o de cualquier otro pájaro de grandes dimensiones.|n10 piezas de carne de almeja sabrosa. ¡Esta la podrás obtener de las almejas, por supuesto!|n20 piezas de queso suizo de Alterac. ¡Podrás encontrarlo en cualquier quesería!|nConsigue todo lo que Dirge necesita y llévaselo.‡Dirge Hojágil quiere que le consigas lo siguiente:|n12 huevos gigantes. Pueden ser huevos de los rocs que deambulan por Tanaris o de cualquier otro pájaro de grandes dimensiones.|n10 piezas de carne de almeja sabrosa. ¡Las puedes obtener de las almejas, por supuesto!|n20 piezas de queso curado de Alterac. ¡Podrás encontrarlo en cualquier quesería!|nConsigue todo lo que Dirge necesita y llévaselo.‡Dirge Quikcleave voudrait que vous lui apportiez les objets suivants :|n12 Oeufs géants. Vous les trouverez sur les Rocs qui hantent Tanaris ou sur toute autre espèce de grand oiseau.|n10 morceaux de Chair de palourde piquante. Vous pouvez trouver la chair de palourde sur... les palourdes, naturellement !|n20 Emmentals d\'Alterac. Vous les trouverez dans une fromagerie !|nCollectez tous ces objets, puis retournez voir Dirge.‡迪尔格·奎克里弗想要你收集这些原料：|n12只巨蛋。你可以在塔纳利斯的大鹏或是其它大型鸟类那里获得这种蛋。|n10块美味的蚌肉。你可以从任何蚌类身上获得这种原料！|n20块奥特兰克冷酪。去买就是了！|n收集好所有原料，然后把它们交给迪尔格。‡迪爾格·奎克裏弗想要妳收集這些原料：|n12只巨蛋。妳可以在塔納利斯的大鵬或是其它大型鳥類那裏獲得這種蛋。|n10塊美味的蚌肉。妳可以從任何蚌類身上獲得這種原料！|n20塊奧特蘭克冷酪。去買就是了！|n收集好所有原料，然後把它們交給迪爾格。',
  }
},
[6611] = {
  {
    'Para Geringontzan!‡Ступай в Прибамбасск!‡Ab mit Euch nach Gadgetzan!‡가젯잔으로 출발!‡Ve a Gadgetzan‡Ve a Gadgetzan‡Vers Gadgetzan vous allez !‡加基森之旅！‡加基森之旅！',
    nil,
    'Vá para Geringontzan, no Deserto de Tanaris, e fale com Funesto Marrão para progredir na carreira de <cozinheiro/cozinheira>.‡Отправляйтесь в Прибамбасск в пустыне Танарис и поговорите с Могилем Быстрорубом.‡Reist nach Gadgetzan in der Tanariswüste und sprecht mit Dirge Quikcleave über den Ausbau Eurer Kochkarriere.‡타나리스 사막에 있는 가젯잔으로 가서 더지 퀵클레이브를 만나 당신의 요리 실력 향상에 대해 대화를 나누어야 합니다.‡Ve a Gadgetzan, en el Desierto de Tanaris, y habla con Dirge Hojágil sobre tus habilidades culinarias.‡Ve a Gadgetzan, en el Desierto de Tanaris, y habla con Dirge Hojágil sobre tus habilidades culinarias.‡Aller à Gadgetzan, dans le Désert de Tanaris, et parler de votre carrière de cuisinier à Dirge Quikcleave.‡到塔纳利斯沙漠的加基森去，与迪尔格·奎克里弗谈谈你的厨师生涯。‡到塔納利斯沙漠的加基森去，與迪爾格·奎克裏弗談談妳的廚師生涯。',
  }
},
[6612] = {
  {
    'Eu sei de um cara...‡Я знаю одного парня...‡Ich kenne einen Typen...‡내가 아는 고블린‡Conozco a un tío…‡Conozco a un tío...‡Je connais un gars...‡我认识一个家伙…‡我認識壹個家夥…',
    nil,
    'Vá para Geringontzan, no deserto de Tanaris, e fale com Funesto Marrão sobre como se desenvolver na carreira de <cozinheiro/cozinheira>.‡Пойдите в Прибамбасск в пустыне Танарис и поговорите с Могилем Быстрорубом насчет продвижения в поварской карьере.‡Reist nach Gadgetzan in der Tanariswüste und sprecht mit Dirge Quikcleave über den Ausbau Eurer Kochkarriere.‡타나리스 사막에 있는 가젯잔으로 가서 더지 퀵클레이브를 만나 당신의 요리 실력 향상에 대해 대화를 나누어야 합니다.‡Ve a Gadgetzan, en el Desierto de Tanaris, y habla con Dirge Hojágil sobre tus habilidades culinarias.‡Ve a Gadgetzan, en el Desierto de Tanaris, y habla con Dirge Hojágil sobre tus habilidades culinarias.‡Aller à Gadgetzan, dans le Désert de Tanaris, et parler de votre carrière de cuisinier à Dirge Quikcleave.‡到塔纳利斯沙漠的加基森去，与迪尔格·奎克里弗谈谈你的厨师生涯。‡到塔納利斯沙漠的加基森去，與迪爾格·奎克裏弗談談妳的廚師生涯。',
  }
},
[6621] = {
  {
    'O rei dos Torpeflora‡Король Гиблой Чащи‡König der Fäulnisklauen‡썩은나무일족의 왕‡El rey de los Corrupto‡El rey de los Maderiza‡Le roi des Vile-sylve‡污林熊怪之王‡汙林熊怪之王',
    nil,
    'Finque o Estandarte de Karang no Montículo Totêmico dos Torpeflora. Não deixe que os pelursos destruam o estandarte. Derrote o Chefe Murgut e leve o Totem de Murgut para Karang Amakkar em Zoram\'gar.‡Водрузите знамя Каранга на тотемном кургане Гиблой Чащи. Не дайте фурболгам унитожить знамя. Одолейте вождя Мургута и принесите тотем Мургута Карангу Амаккару в Зорам\'гар.‡Platziert Karangs Banner auf dem Totemhügel der Fäulnisklauen. Die Furbolgs dürfen das Banner nicht zerstören. Besiegt Häuptling Murgut und bringt Murguts Totem zu Karang Amakkar in Zoram\'gar.‡썩은나무일족 토템고분에 카랑의 깃발을 꽂은 다음 펄볼그들이 깃발을 부수지 못하도록 막아야 합니다. 족장 머구트가 나타나면 그를 물리치고 머구트의 토템을 조람가르 전초기지의 카랑 아마카르에게 가져가야 합니다.‡Coloca el estandarte de Karang en el túmulo del tótem corrupto. No permitas que los furbolgs destruyan el estandarte. Derrota al jefe Murgut y lleva el tótem de Murgut a Karang Amakkar en Zoram\'gar.‡Coloca el estandarte de Karang en el montículo del tótem de los Maderiza. No permitas que los fúrbolgs destruyan el estandarte. Derrota al jefe Murgut y lleva el tótem de Murgut a Karang Amakkar en Zoram\'gar.‡Placer la Bannière de Karang sur le Monticule du totem Vile-sylve. Ne pas laisser les furbolgs détruire la Bannière. Tuer le chef Murgut, et apporter le Totem de Murgut à Karang Amakkar, à Zoram\'gar.‡把卡拉恩的旗子插到污林图腾堆中。不要让熊怪摧毁这面旗子。击败穆戈特酋长，将穆戈特的图腾交给佐拉姆加的卡拉恩·阿玛卡。‡把卡拉恩的旗子插到汙林圖騰堆中。不要讓熊怪摧毀這面旗子。擊敗穆戈特酋長，將穆戈特的圖騰交給佐拉姆加的卡拉恩·阿瑪卡。',
  }
},
[6622] = {
  {
    'Triagem‡Очередь на медобслуживание‡Triage‡응급 치료‡Orden de gravedad‡Orden de gravedad‡Triage‡救死扶伤‡救死扶傷',
    nil,
    'Use Bandagens de Triagem para salvar pacientes. Você precisa salvar 15 deles antes que 6 morram devido aos ferimentos.|nLembre-se da ordem da triagem! Os Soldados Mortalmente Feridos são os que morrem mais rápido, seguidos dos Soldados Gravemente Feridos. Os Soldados Feridos demoram mais a morrer e devem ser tratados após os outros terem passado pela triagem.‡Окажите помощь пациентам, используя для перевязки их ран очередные перевязочные бинты. Вы должны оказать помощь 15 пациентам прежде, чем 6 из них успеют умереть от ран.|nПомните о порядке оказания помощи! Находящиеся при смерти солдаты умирают быстрее, чем тяжелораненые. Легкораненые живут дольше всех, потому им надо оказывать помощь ПОСЛЕ того, как перевяжете тех, кто при смерти, и тяжелораненых.‡Rettet Patienten, indem Ihr deren Wunden mit Triagenverbänden versorgt. Ihr müsst 15 Patienten retten, bevor 6 von ihnen ihren Verletzungen erliegen.|nDenkt an die Einhaltung der Reihenfolge! Schwerstverletzte Soldaten sterben am schnellsten, dann die schwer verletzten Soldaten. Bei verletzten Soldaten dauert es etwas länger, bis sie sterben. Ihr solltet sie retten, NACHDEM Ihr die schwerstverletzten und schwer verletzten Soldaten selektiert habt.‡응급 붕대로 상처를 치료해서 환자를 구해야 합니다. 환자 6명이 죽기 전에 15명을 구해야 합니다.|n부상자 치료 우선 순위를 기억해야 합니다! 위독한 부상병이 가장 빨리 사망하고 그 다음으로 위태로운 부상병이 사망합니다. 부상병들이 제일 늦게 사망하므로 위독한 부상병과 위태로운 부상병을 먼저 구해야 합니다.‡Salva a pacientes asignando vendas identificativas para atender sus heridas por orden de gravedad. Debes salvar a 15 pacientes antes de que 6 mueran a consecuencia de sus heridas.|n¡Ten presente el orden de prioridad! Los soldados con heridas graves mueren antes que los soldados con heridas de gravedad media. Los soldados heridos leves son los que más tardan en morir y solo hay que salvarlos DESPUÉS de identificar y atender a los soldados con heridas graves y medias.‡Salva a pacientes asignando vendas identificativas para atender sus heridas por orden de gravedad. Debes salvar a 15 pacientes antes de que 6 mueran a consecuencia de sus heridas.|n¡Ten presente el orden de prioridad! Los soldados con heridas graves mueren antes que los soldados con heridas de gravedad media. Los soldados heridos leves son los que más tardan en morir y solo hay que salvarlos DESPUÉS de identificar y atender a los soldados con heridas graves y medias.‡Sauver des patients en utilisant des Bandages de Triage, afin de panser leurs blessures. Vous devez sauver 15 patients avant que 6 d’entre eux ne meurent de leurs blessures.|nRappelez-vous l’ordre du triage ! Les Soldats agonisants meurent les premiers, suivis des Soldats grièvement blessés. Les Soldats blessés sont ceux qui meurent les derniers, et ils doivent être soignés APRES ceux qui agonisent et ceux qui sont grièvement blessés ; selon le tri que vous avez fait.‡使用急救绷带来治疗病人。你必须在6个病人死亡之前拯救15个病人。|n一定要牢记治疗的顺序！受致命伤的病人会很快死亡，其次是重伤病人，受普通伤的病人死亡得最慢。所以你最好在治疗那些受致命伤和重伤的病人之后再去治疗受普通伤的病人。‡使用急救繃帶來治療病人。妳必須在6個病人死亡之前拯救15個病人。|n壹定要牢記治療的順序！受致命傷的病人會很快死亡，其次是重傷病人，受普通傷的病人死亡得最慢。所以妳最好在治療那些受致命傷和重傷的病人之後再去治療受普通傷的病人。',
  }
},
[6623] = {
  {
    'Pronto-socorro da Horda‡Травматология‡Traumachirurg der Horde‡호드 응급의학회‡Dispensario de la Horda‡Dispensario de la Horda‡Service de traumatologie de la Horde‡部落医疗队‡部落醫療隊',
    nil,
    'Vá para a Ruína do Martelo no Planalto Arathi e fale com o Doutor Victor Zerbini para entrar para a equipe do Pronto-socorro da Horda.‡Пойдите в Павший Молот на нагорье Арати и поговорите с доктором Грегори Виктором о том, чтобы стать травматологом.‡Reist nach Hammerfall im Arathihochland und sprecht mit Doktor Gregory Victor darüber, dass Ihr auch ein Traumachirurg der Horde werden wollt.‡아라시 고원에 있는 해머폴로 가서 호드 응급의학회의 일원이 되는 방법에 대해 의사 그레고리 빅터와 대화를 나누어야 합니다.‡Ve a Sentencia, en las Tierras Altas de Arathi, y habla con el doctor Gregory Victor sobre tu incorporación al Dispensario de la Horda.|n‡Ve a Sentencia, en las Tierras Altas de Arathi, y habla con el doctor Gregory Victor sobre tu incorporación al Dispensario de la Horda.‡Aller au Trépas-d\'Orgrim, dans les hautes-terres d\'Arathi, et évoquer avec le docteur Gregory Victor la possibilité de rejoindre les rangs des médecins de la Horde.‡到阿拉希高地的落锤镇去，与格里高利·维克托医生谈一谈关于加入部落外科医疗队的事宜。‡到阿拉希高地的落錘鎮去，與格裏高利·維克托醫生談壹談關於加入部落外科醫療隊的事宜。',
  }
},
[6624] = {
  {
    'Triagem‡Очередность перевязки‡Triage‡응급 치료‡Atenciones médicas‡Orden de gravedad‡Triage‡救死扶伤‡救死扶傷',
    nil,
    'Use Bandagens de Triagem para salvar pacientes. Você precisa salvar 15 deles antes que 6 morram devido aos ferimentos.|nLembre-se da ordem da triagem! Os Soldados Mortalmente Feridos são os que morrem mais rápido, seguidos dos Soldados Gravemente Feridos. Os Soldados Feridos demoram mais a morrer e devem ser tratados após os outros terem passado pela triagem.‡Окажите помощь пациентам, используя для перевязки их ран очередные перевязочные бинты. Вы должны оказать помощь 15 пациентам прежде, чем 6 из них успеют умереть от ран.|nПомните о порядке оказания помощи! Находящиеся при смерти солдаты умрут быстрее, чем тяжелораненые. Легкораненые могут прожить дольше всех, потому им надо оказывать помощь ПОСЛЕ того, как перевяжете тех, кто при смерти, и тяжелораненых.‡Rettet Patienten, indem Ihr deren Wunden mit Triagenverbänden versorgt. Ihr müsst 15 Patienten retten, bevor 6 von ihnen ihren Verletzungen erliegen.|nDenkt an die Einhaltung der Reihenfolge! Schwerstverletzte Soldaten sterben am schnellsten, dann die schwer verletzten Soldaten. Bei verletzten Soldaten dauert es etwas länger, bis sie sterben. Ihr solltet sie retten, NACHDEM Ihr die schwerstverletzten und schwer verletzten Soldaten selektiert habt.‡응급 붕대로 상처를 치료해서 환자를 구해야 합니다. 환자 6명이 죽기 전에 15명을 구해야 합니다.|n부상자 치료 우선 순위를 기억해야 합니다! 위독한 부상병이 가장 빨리 사망하고 그 다음으로 위태로운 부상병이 사망합니다. 가벼운 부상을 입은 부상병이 제일 늦게 사망하므로 위독한 부상병과 위태로운 부상병을 먼저 구해야 합니다.‡Salva a los pacientes utilizando vendas identificativas para ocuparte de sus heridas. Debes salvar a 15 pacientes antes de que 6 de ellos mueran a causa de sus heridas.|n¡Recuerda el orden en el que debes atender a los pacientes! Los soldados heridos graves mueren antes, seguidos de los soldados malheridos. Los soldados heridos leves tardan más en morir y deben ser salvados DESPUÉS de haber salvado a los soldados heridos graves y a los soldados malheridos.‡Salva a pacientes asignando vendas identificativas para atender sus heridas por orden de gravedad. Debes salvar a 15 pacientes antes de que 6 mueran a consecuencia de sus heridas.|n¡Ten presente el orden de prioridad! Los soldados con heridas graves mueren antes que los soldados con heridas de gravedad media. Los soldados heridos leves son los que más tardan en morir y solo hay que salvarlos DESPUÉS de identificar y atender a los soldados con heridas graves y medias.‡Sauver des patients en utilisant des Bandages de Triage, afin de panser leurs blessures. Vous devez sauver 15 patients avant que 6 d’entre eux ne meurent de leurs blessures.|nRappelez-vous l’ordre du triage ! Les Soldats agonisants meurent les premiers, suivis des Soldats grièvement blessés. Les Soldats blessés sont ceux qui meurent les derniers, et ils doivent être soignés APRES ceux qui agonisent et ceux qui sont grièvement blessés ; selon le tri que vous avez fait.‡使用急救绷带来治疗病人。你必须在6个病人死亡之前拯救15个病人。|n一定要牢记治疗的顺序！受致命伤的病人会很快死亡，其次是重伤病人，受普通伤的病人死亡得最慢。所以你最好在治疗那些受致命伤和重伤的病人之后再去治疗受普通伤的病人。‡使用急救繃帶來治療病人。妳必須在6個病人死亡之前拯救15個病人。|n壹定要牢記治療的順序！受致命傷的病人會很快死亡，其次是重傷病人，受普通傷的病人死亡得最慢。所以妳最好在治療那些受致命傷和重傷的病人之後再去治療受普通傷的病人。',
  }
},
[6625] = {
  {
    'Pronto-socorro da Aliança‡Травматологи Альянса‡Traumachirurg der Allianz‡얼라이언스 응급의학회‡El Dispensario de la Alianza‡El Dispensario de la Alianza‡Service de traumatologie de l\'Alliance‡联盟医疗队‡聯盟醫療隊',
    nil,
    'Vá para a cidade de Theramore, no Pântano Vadeoso, e fale com o Doutor Gregório Casagrande sobre entrar para a equipe do Pronto-socorro da Aliança.‡Отправляйтесь в Терамор в Пылевых топях и поговорите с доктором Густавом ван Схлиффом насчет зачисления в травматологи Альянса.‡Reist nach Theramore in den Marschen von Dustwallow und sprecht mit Doktor Gustaf van Howzen darüber, dass Ihr auch ein Traumachirurg der Allianz werden wollt.‡먼지진흙 습지대에 있는 테라모어로 가서 얼라이언스 응급의학회의 일원이 되는 방법에 대해 의사 구스타프 밴하우젠과 대화를 나누어야 합니다.‡Ve a Theramore, en el Marjal Revolcafango, y habla con el doctor Gustaf VanHowzen sobre incorporarte al Dispensario de la Alianza.‡Ve a Theramore, en el Marjal Revolcafango, y habla con el doctor Gustaf VanHowzen sobre tu incorporación al Dispensario de la Alianza.‡Aller à Theramore, dans le marécage d\'Âprefange, et parler au docteur Gustaf VanHowzen de la possibilité de rejoindre les rangs des médecins de l’Alliance.‡到尘泥沼泽的塞拉摩去，与古斯塔夫·范沃森医生谈一谈关于加入联盟外科医疗队的事宜。‡到塵泥沼澤的塞拉摩去，與古斯塔夫·範沃森醫生談壹談關於加入聯盟外科醫療隊的事宜。',
  }
},
[6626] = {
  {
    'A hoste do mal‡Воинство зла‡Ein Hort des Bösen‡악의 무리‡Un anfitrión del mal‡Un anfitrión del mal‡L\'hôte du mal‡邪恶之地‡邪惡之地',
    nil,
    'Mate 8 Guerreiros do Urzal, 8 Tecespinhos do Urzal e 8 Sectários da Cabeça da Morte, depois fale novamente com Mírian Lunacanto perto da entrada do Urzal dos Mortos.‡Убейте 8 боевых стражей и 8 терноплетов из племени Иглошкурых, а также 8 сектанток из племени Мертвой Головы и возвращайтесь к Мириам Лунной Певице на Курганы Иглошкурых.‡Tötet 8 Schlachtwachen von Razorfen, 8 Dornenwirker von Razorfen und 8 Kultistinnen der Totenköpfe und kehrt dann zu Myriam Moonsinger nahe dem Eingang zu den Hügeln von Razorfen zurück.‡가시덩굴일족 전투호위병과 가시덩굴일족 가시마술사, 그리고 죽음의 머리교 신도를 각각 8마리씩 죽인 후 가시덩굴 구릉 입구 근처에 있는 미리암 문싱어에게 돌아가야 합니다.‡Mata a 8 guardias de batalla y 8 tejespinas Rajacieno y 8 adeptos Caramuerte y ve a ver a Myriam Lunacanta cerca de la entrada a Zahúrda Rajacieno.‡Mata a 8 guardias de batalla de Rajacieno y 8 tejespinas Rajacieno y 8 cultores Caramuerte y ve a ver a Myriam Lunacanta cerca de la entrada a Zahúrda Rajacieno.‡Tuer 8 Gardes de guerre Tranchebauge, 8 Tisseurs d\'épines Tranchebauge et 8 Sectateur de la Tête de mort, puis retourner voir Myriam Moonsinger, à l’entrée des Souilles de Tranchebauge.‡杀掉8个剃刀沼泽护卫者、8个剃刀沼泽织棘者和8个亡首教徒，然后向剃刀高地入口处的麦雷姆·月歌复命。‡殺掉8個剃刀沼澤護衛者、8個剃刀沼澤織棘者和8個亡首教徒，然後向剃刀高地入口處的麥雷姆·月歌復命。',
  }
},
[6627] = {
  {
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Responda à pergunta de Braug Espírito Turvo corretamente, depois fale com ele novamente. Quando você estiver pront<o/a>, ele estará na Cordilheira das Torres de Pedra.‡Дайте верный ответ на вопрос Брауга Тусклого Духа и поговорите с ним еще раз. Брауга можно в любое время найти в Когтистых горах.‡Beantwortet Braug Dimspirits Frage richtig und sprecht dann erneut mit ihm. Er wird immer noch im Steinkrallengebirge sein, wenn Ihr bereit seid.‡브라우그 딤스피릿의 질문에 대한 정답을 맞춘 다음 그에게 다시 말을 걸어야 합니다. 준비가 될 때까지 브라우그 딤스피릿은 돌발톱 산맥에 있을 것입니다.‡Responde la pregunta de Braug Espiritoscuro con acierto y después habla con él de nuevo. Se quedará en Sierra Espolón hasta que estés <listo/lista>.‡Responde la pregunta de Braug Espíritu Tenue con acierto y después habla con él de nuevo. Se quedará en Sierra Espolón hasta que estés <listo/lista>.‡Réussir à répondre à la question de Braug Dimspirit, puis lui reparler. Il se trouve dans les Serres-Rocheuses.‡成功回答布劳格·幽魂的问题，然后和他再次对话。他会一直在石爪山等你回答问题。‡成功回答布勞格·幽魂的問題，然後和他再次對話。他會壹直在石爪山等妳回答問題。',
  }
},
[6628] = {
  {
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Responda à pergunta de Pasqual Fintallas corretamente, depois fale com ele novamente. Quando você estiver pront<o/a>, ele estará na Cidade Baixa.‡Дайте верный ответ на вопрос Парквела Финталласа и поговорите с ним еще раз. Парквелла можно в любое время найти в Подгороде.‡Beantwortet Parqual Fintallas\' Frage richtig und sprecht dann erneut mit ihm. Er wird immer noch in Undercity sein, wenn Ihr bereit seid.‡파쿠알 핀탈라스의 질문에 대한 정답을 맞춘 다음 그에게 다시 말을 걸어야 합니다. 준비가 될 때까지 파쿠알 핀탈라스는 언더시티에 있을 것입니다.‡Responde la pregunta de Parqual Fintallas con acierto y después habla con él de nuevo. Se quedará en Entrañas hasta que estés <listo/lista>.‡Responde la pregunta de Parqual Fintallas con acierto y después habla con él de nuevo. Se quedará en Entrañas hasta que estés <listo/lista>.‡Réussir à répondre à la question de Parqual Fintallas, puis lui reparler. Il se trouve à Undercity.‡成功回答帕科瓦·芬塔拉斯的问题，然后再次和他对话。他会一直在幽暗城等你回答问题。‡成功回答帕科瓦·芬塔拉斯的問題，然後再次和他對話。他會壹直在幽暗城等妳回答問題。',
  }
},
[6629] = {
  {
    'Mate Grundig Nuvem Negra‡Убить Грундига Темное Облако‡Tötet Grundig Finsterwolke‡그룬디히 다크클라우드 처치‡Mata a Grundig Nube Negra‡Mata a Grundig Nube Negra‡Tuer Grundig Darkcloud‡杀死格鲁迪格·暗云‡殺死格魯迪格·暗雲',
    nil,
    'Mate Grundig Nuvem Negra e 6 Brutos Temível Totem, e fale novamente com Makaba Casco Chato perto da extremidade sudeste das Torres de Pedra.‡Убейте Грундига Темное Облако и 6 громил из племени Зловещего Тотема и вернитесь к Макабе Плоскому Копыту, который ждет вблизи юго-восточного края Каменного Когтя.‡Tötet Grundig Finsterwolke und 6 Schläger der Grimmtotem und kehrt dann zu Makaba Flathoof am südöstlichen Rand des Steinkrallengebirges zurück.‡그룬디히 다크클라우드와 그림토템부족 투사 6명을 처치한 다음 돌발톱 산맥 남동쪽 끄트머리에 있는 마카바 플랫후프에게 돌아가야 합니다.‡Mata a Grundig Nube Negra y 6 toscos Tótem Siniestro. A continuación, ve a ver a Makaba Patatleta cerca del límite sureste de Espolón.‡Mata a Grundig Nube Negra y a 6 toscos Tótem Siniestro. A continuación, ve a ver a Makaba Pezuña Plana cerca del límite sureste de Espolón.‡Tuer Grundig Darkcloud et 6 Brutes du Totem sinistre, puis retourner voir Makaba Flathoof, à côté de la frontière sud-est des Serres Rocheuses.‡杀掉格鲁迪格·暗云和6个恐怖图腾蛮兵，然后向石爪山东南面的玛卡巴·扁蹄复命。‡殺掉格魯迪格·暗雲和6個恐怖圖騰蠻兵，然後向石爪山東南面的瑪卡巴·扁蹄復命。',
  }
},
[6641] = {
  {
    'Vorsha, a Açoitadora‡Ворша Хлестунья‡Vorsha die Peitscherin‡채찍꼬리 보르샤‡Vorsha la Azotadora‡Vorsha la Azotadora‡Vorsha la Flagellante‡鞭笞者沃尔沙‡鞭笞者沃爾沙',
    nil,
    'Escolte Muglash em segurança até o braseiro. Ajude-o a apagar o braseiro, e proteja-o na luta contra as nagas.|nSe cumprir a missão, volte ao Assentamento Zoram\'gar e informe o Mensageiro do Brado Guerreiro da morte de Vorsha, a Açoitadora.‡Охраняйте Муглаша на его пути к жаровне. Помогите ему погасить жаровню, а затем защищайте его, ведя бой с нагами.|nЕсли вам все удастся, возвращайтесь в форт Зорам\'гар и сообщите гонцу клана Песни Войны о смерти Ворши Хлестуньи.‡Beschützt Muglash, wenn er zu der Kohlenpfanne reist. Helft ihm, indem Ihr die Kohlenpfanne löscht, und beschützt ihn dann, während Ihr gegen die Naga kämpft.|nWenn Ihr erfolgreich gewesen seid, kehrt zum Zoram\'garposten zurück und informiert den Warsongläufer über den Tod von Vorsha der Peitscherin.‡머그래쉬가 화로로 접근하는 동안 안전하게 보호하고, 그를 도와 화로를 꺼야 합니다. 그런 다음 나가와 맞서 싸우는 동안 그를 보호하십시오.|n성공하면 조람가르 전초기지로 돌아와 전쟁노래부족 길잡이에게 채찍꼬리 보르샤의 죽음을 보고하십시오.‡Mantén a salvo a Muglash en su viaje hacia el blandón. Ayúdalo a apagar el blandón y entonces protégelo frente a los nagas.|nSi sales <airoso/airosa>, vuelve a la Avanzada de Zoram\'gar e informa al corredor Grito de Guerra sobre la muerte de Vorsha la Azotadora.‡Mantén a Muglash a salvo mientras viaja hacia el blandón. Apaga el blandón para ayudarlo y luego lucha contra los nagas para protegerlo|nSi tienes éxito, regresa a Avanzada de Zoram\'gar e informa al corredor Grito de Guerra sobre la muerte de Vorsha la Azotadora.‡Garantir la sécurité de Muglash tandis qu’il voyage vers le brasero. L’aider à éteindre le brasero, puis le protéger, en combattant les nagas.|nEn cas de réussite, retourner à l’avant-poste de Zoram\'gar et informer le messager Warsong de la mort de Vorsha la Flagellante.‡在穆格拉什寻找火盆的过程中保证他的安全。帮助他扑灭火盆，然后在与纳迦作战时保护他。|n如果你成功了，就回到佐拉姆加前哨站去，把鞭笞者沃尔沙的死讯通知给战歌信使。‡在穆格拉什尋找火盆的過程中保證他的安全。幫助他撲滅火盆，然後在與納迦作戰時保護他。|n如果妳成功了，就回到佐拉姆加前哨站去，把鞭笞者沃爾沙的死訊通知給戰歌信使。',
  }
},
