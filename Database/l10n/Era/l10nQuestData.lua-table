[5892] = {
  {
    'Suprimentos dos Ferrofundo‡Припасы Железного рудника‡Irondeep-Vorräte‡깊은무쇠 광산 보급품‡Suministros de Ferrohondo‡Suministros de Ferrohondo‡Fournitures de Gouffrefer‡深铁矿洞的补给‡深鐵礦洞的補給',
    nil,
    'Leve 10 Suprimentos de Ferrofundo para o Intendente da Aliança em Dun Baldar.‡Принесите 10 припасов Железного рудника интенданту Альянса в Дун Болдар.‡Bringt 10 Irondeep-Vorräte zum Rüstmeister der Allianz in Dun Baldar.‡던 발다르에 있는 얼라이언스 병참장교에게 깊은무쇠 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 cajas de suministros de Ferrohondo al intendente de la Alianza en Dun Baldar.‡Lleva 10 suministros de Ferrohondo al intendente de la Alianza en Dun Baldar.‡Apporter 10 Fournitures de Gouffrefer à l’Intendant de l\'Alliance de Dun Baldar.‡把10份深铁矿洞补给品交给丹巴达尔的联盟军需官。‡把10份深鐵礦洞補給品交給丹巴達爾的聯盟軍需官。',
  }
},
[5893] = {
  {
    'Suprimentos de Dentefrio‡Припасы Ледяного Зуба‡Coldtooth-Vorräte‡얼음이빨 광산 보급품‡Suministros de Dentefrío‡Suministros de Dentefrío‡Fournitures de Froide-dent‡冷齿矿洞的补给‡冷齒礦洞的補給',
    nil,
    'Leve 10 Suprimentos de Dentefrio para o Intendente da Horda na Bastilha Lobo do Gelo.‡Доставьте 10 припасов Ледяного Зуба интенданту Орды в крепость Северного Волка.‡Bringt 10 Coldtooth-Vorräte zum Rüstmeister der Horde in die Burg Frostwolf.‡서리늑대 요새에 있는 서리늑대 병참장교에게 얼음이빨 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 cajas de suministros de Dentefrío al intendente de la Horda en el Bastión Lobo Gélido.‡Lleva 10 suministros de Dentefrío al intendente de la Horda en el Bastión Lobo Gélido.‡Apporter 10 Fournitures de Froide-dent à l’intendant de la Horde, au donjon Frostwolf.‡把10份冷齿矿洞补给品交给霜狼要塞的部落军需官。‡把10份冷齒礦洞補給品交給霜狼要塞的部落軍需官。',
  }
},
[5901] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Use a Jarra de Cupins Vazia nos Cupinzeiros que há nas Terras Pestilentas Orientais. Após conseguir 100 Cupins das Terras Pestilentas, fale novamente com Guel Levine no Baluarte, nas Clareiras de Tirisfal.‡Возьмите пустую банку для термитов и отправляйтесь к большим термитникам в Восточных Чумных землях. Наберите 100 термитов Восточных Чумных земель и возвращайтесь к Микки Левину в Бастион в Тирисфальских лесах.‡Wendet den leeren Termitenkrug auf die Termitenhügel in den östlichen Pestländern an. Sobald Ihr 100 Pestland-Termiten gesammelt habt, kehrt zu Mickey Levine am Bollwerk in Tirisfal zurück.‡동부 역병지대의 흰개미집으로 가서 빈 흰개미 병을 사용하십시오. 역병지대 흰개미 100마리를 모아서 티리스팔 숲의 보루에 있는 미키 레빈에게 돌아가야 합니다.‡Utiliza la Jarra de termitas vacía en los Montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Mickey Levine, que está en El Baluarte, en Claros de Tirisfal.‡Utiliza el tarro de termitas vacío en los montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Mickey Levine, que está en El Baluarte, en Claros de Tirisfal.‡Utiliser le Pot de Termites vide sur la Termitière, dans les Maleterres de l’est. Après avoir récupéré 100 Termites des Maleterres, retourner voir Mickey Levine, à la Barricade, dans les Clairières de Tirisfal.‡在东瘟疫之地的蚁丘上使用空的白蚁瓶。当你收集了100只瘟疫白蚁之后，就回到提瑞斯法林地的亡灵壁垒去找米克·莱文。‡在東瘟疫之地的蟻丘上使用空的白蟻瓶。當妳收集了100只瘟疫白蟻之後，就回到提瑞斯法林地的亡靈壁壘去找米克·萊文。',
  }
},
[5902] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Encontre um lugar apropriado para pôr o Barril de Cupins das Terras Pestilentas no centro da Serraria de Beiranorte, que fica nas Terras Pestilentas Ocidentais.‡Найдите подходящее место на лесопилке Северного Кряжа в Западных Чумных землях и оставьте там бочонок термитов из Чумных земель.‡Sucht Euch einen geeigneten Ort in der Mitte des Northridge-Sägewerks in den Westlichen Pestländern, um das Fass mit den Pestland-Termiten abzustellen.‡서부 역병지대의 북마루 벌목지 중앙에 적당한 장소를 찾아 역병지대 흰개미 통을 놓아야 합니다.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Trouver un endroit judicieux, au centre de la scierie de la Crête du nord, dans les Maleterres de l’ouest, pour placer le Tonneau de Termites des Maleterres.‡到西瘟疫之地的北山伐木场去找个合适的地方，在那里放下一桶瘟疫白蚁。‡到西瘟疫之地的北山伐木場去找個合適的地方，在那裏放下壹桶瘟疫白蟻。',
  }
},
[5903] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Use a Jarra de Cupins Vazia nos Cupinzeiros que há nas Terras Pestilentas Orientais. Após conseguir 100 Cupins das Terras Pestilentas, fale novamente com Nataniel Dumah no Acampamento Ventogelante, em Terras Pestilentas Ocidentais.‡Возьмите пустую банку для термитов и отправляйтесь к большим термитникам в Восточных Чумных землях. Наберите 100 термитов Восточных Чумных земель и возвращайтесь к Натаниэлю Дамаху в Лагерь Промозглого Ветра в Восточные Чумные земли.‡Wendet den leeren Termitenkrug auf die Termitenhügel in den Östlichen Pestländern an. Sobald Ihr 100 Pestland-Termiten gesammelt habt, kehrt zu Nathaniel Dumah am Chillwindposten in den Westlichen Pestländern zurück.‡동부 역병지대에 있는 흰개미집으로 가서 빈 흰개미 병을 사용해야 합니다. 역병지대 흰개미 100마리를 모아 서부 역병지대의 서리바람 야영지에 있는 너대니얼 두마에게 돌아가야 합니다.‡Utiliza la Jarra de termitas vacía en los Montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Nathaniel Dumah al Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Utiliza el tarro de termitas vacío en los montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Nathaniel Dumah al Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Utiliser le Pot de Termites vide sur la Termitière, dans les Maleterres de l’est. Après avoir récupéré 100 Termites des Maleterres, retourner voir Nathaniel Dumah, au camp du Noroît, dans les Maleterres de l’ouest.‡在东瘟疫之地的蚁丘上使用空的白蚁瓶。当你收集了100只瘟疫白蚁之后，就回到西瘟疫之地的冰风岗去找纳萨尼尔·杜马。‡在東瘟疫之地的蟻丘上使用空的白蟻瓶。當妳收集了100只瘟疫白蟻之後，就回到西瘟疫之地的冰風崗去找納薩尼爾·杜馬。',
  }
},
[5904] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與妳',
    nil,
    'Encontre um lugar apropriado para pôr o Barril de Cupins das Terras Pestilentas no centro da Serraria de Beiranorte, que fica nas Terras Pestilentas Ocidentais.‡Найдите подходящее место в центре лесопилки Северного Кряжа в Западных Чумных землях и оставьте там бочонок термитов из Чумных земель.‡Sucht Euch einen geeigneten Ort in der Mitte des Northridge-Sägewerks in den Westlichen Pestländern, um das Fass mit den Pestland-Termiten abzustellen.‡서부 역병지대의 북마루 벌목지 중앙에 적당한 장소를 찾아 역병지대 흰개미 통을 놓아야 합니다.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Trouver un endroit propice, au centre de la scierie de la Crête du nord, dans les Maleterres de l’ouest, pour placer le Tonneau de Termites des Maleterres.‡到西瘟疫之地的北山伐木场去找个合适的地方，在那里放下一桶瘟疫白蚁。‡到西瘟疫之地的北山伐木場去找個合適的地方，在那裏放下壹桶瘟疫白蟻。',
  }
},
[5921] = {
  {
    'Clareira da Lua‡Лунная поляна‡Moonglade‡달의 숲‡Claro de la Luna‡Claro de la Luna‡Reflet-de-Lune‡月光林地‡月光林地',
    nil,
    'Use o feitiço "Teleporte: Clareira da Lua" para viajar para a Clareira da Lua. Ao chegar, fale com Dendrite Stellardor, no vilarejo de Refúgio Noturno.‡При помощи заклинания "Телепортация: Лунная поляна" перенеситесь в Лунную поляну. По прибытии поговорите с Дендритом Блеском Звезд в селении Ночная Гавань.‡Benutzt den Zauber \'Teleportation: Moonglade\', um nach Moonglade zu reisen. Wenn Ihr dort ankommt, sprecht mit Dendrite Starblaze in Nighthaven.‡"순간이동: 달의 숲" 주문을 이용하여 달의 숲으로 이동하십시오. 도착하면 나이트헤이븐의 덴드리트 스타블레이즈와 대화해야 합니다.‡Utiliza el hechizo "teletransportarse: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrite Rafagaestelar.‡Utiliza el hechizo "Teletransporte: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Utiliser le sort "Téléportation : Reflet-de-Lune" pour aller à Reflet-de-Lune. Une fois sur place, parler à Dendrite Starblaze, au village de Havrenuit.‡使用法术“传送：月光林地”抵达月光林地，在那里与永夜港的德迪利特·星焰谈一谈。‡使用法術“傳送：月光林地”抵達月光林地，在那裏與永夜港的德迪利特·星焰談壹談。',
  }
},
[5922] = {
  {
    'Clareira da Lua‡Лунная поляна‡Moonglade‡달의 숲‡Claro de la Luna‡Claro de la Luna‡Reflet-de-Lune‡月光林地‡月光林地',
    nil,
    'Use o feitiço "Teleporte: Clareira da Lua" para viajar para a Clareira da Lua. Ao chegar, fale com Dendrite Stellardor, no vilarejo de Refúgio Noturno.‡При помощи заклинания "Телепортация: Лунная поляна" перенеситесь в Лунную поляну. По прибытии поговорите с Дендритом Блеском Звезд в селении Ночная Гавань.‡Benutzt den Zauber \'Teleportation: Moonglade\', um nach Moonglade zu reisen. Wenn Ihr dort ankommt, sprecht mit Dendrite Starblaze in Nighthaven.‡"순간이동: 달의 숲" 주문을 이용하여 달의 숲으로 이동해야 합니다. 달의 숲에 도착하면 나이트헤이븐의 덴드리트 스타블레이즈와 대화해야 합니다.‡Utiliza el hechizo "Teletransporte: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrite Rafagaestelar.‡Utiliza el hechizo "Teletransporte: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Utiliser le sort "Téléportation : Reflet-de-Lune" pour aller à Reflet-de-Lune. Une fois sur place, parler à Dendrite Starblaze, au village de Havrenuit.‡使用法术“传送：月光林地”抵达月光林地，在那里与永夜港的德迪利特·星焰谈一谈。‡使用法術“傳送：月光林地”抵達月光林地，在那裏與永夜港的德迪利特·星焰談壹談。',
  }
},
[5923] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡響應召喚',
    nil,
    'Fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bearwalker in der Enklave von Cenarius in Darnassus.‡다르나서스 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Ve a Darnassus, al Enclave Cenarion y habla con Mathrengyl Garroso.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Parler à Mathrengyl Bearwalker, dans l’Enclave cénarienne, à Darnassus.‡与达纳苏斯塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯塞納裏奧區的瑪斯雷·馭熊者談壹談。',
  }
},
[5924] = {
  {
    'Atendendo o chamado‡Отклик на призыв‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡響應召喚',
    nil,
    'Fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bearwalker in der Enklave von Cenarius in Darnassus.‡다르나서스 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Habla con Mathrengyl Garroso en el Enclave Cenarion, en Darnassus.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Parler à Mathrengyl Bearwalker, dans l’Enclave cénarienne, à Darnassus.‡与达纳苏斯塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯塞納裏奧區的瑪斯雷·馭熊者談壹談。',
  }
},
[5925] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Atendiendo a la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡響應召喚',
    nil,
    'Fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bearwalker in der Enklave von Cenarius in Darnassus.‡다르나서스 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Parler à Mathrengyl Bearwalker, dans l’Enclave cénarienne, à Darnassus.‡与达纳苏斯塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯塞納裏奧區的瑪斯雷·馭熊者談壹談。',
  }
},
[5926] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡響應召喚',
    nil,
    'Fale com Turak Runa Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Тюраком Руническим Тотемом на Вершине Старейшин Громового Утеса.‡Sprecht mit Turak Runetotem auf der Anhöhe der Ältesten in Thunder Bluff.‡썬더 블러프의 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Habla con Turak Runatótem en el Alto de los Ancestros de Cima del Trueno.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Parler à Turak Runetotem, sur la Cime des Anciens de Thunder Bluff.‡与雷霆崖长者高地上的图拉克·符文图腾谈一谈。‡與雷霆崖長者高地上的圖拉克·符文圖騰談壹談。',
  }
},
[5927] = {
  {
    'Atendendo o chamado‡Ответ на призыв‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡響應召喚',
    nil,
    'Fale com Turak Runa Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Тюраком Руническим Тотемом на Вершине Старейшин в Громовом Утесе.‡Sprecht mit Turak Runetotem auf der Anhöhe der Ältesten in Thunder Bluff.‡썬더 블러프 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Habla con Turak Tótem Rúnico en Alto de los Ancestros, en Cima del Trueno.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Parler à Turak Runetotem, sur la Cime des Anciens de Thunder Bluff.‡与雷霆崖长者高地上的图拉克·符文图腾谈一谈。‡與雷霆崖長者高地上的圖拉克·符文圖騰談壹談。',
  }
},
[5928] = {
  {
    'Atendendo o chamado‡Услышанный зов‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡響應召喚',
    nil,
    'Fale com Turak Runa Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Тюраком Руническим Тотемом на Вершине Старейшин в Громовом Утесе.‡Sprecht mit Turak Runetotem auf der Anhöhe der Ältesten in Thunder Bluff.‡썬더 블러프의 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Parler à Turak Runetotem, sur la Cime des Anciens de Thunder Bluff.‡与雷霆崖长者高地上的图拉克·符文图腾谈一谈。‡與雷霆崖長者高地上的圖拉克·符文圖騰談壹談。',
  }
},
[5929] = {
  {
    'Espírito do Grande Urso‡Дух Великого Медведя‡Großer Bärengeist‡거대한 곰의 혼‡Espíritu del gran oso‡Espíritu del gran oso‡L\'esprit du Grand ours‡巨熊之灵‡巨熊之靈',
    nil,
    'Procure o Espírito do Grande Urso na região noroeste da Clareira da Lua e aprenda o que ele tem a compartilhar com você sobre a natureza do urso. Quando terminar, fale novamente com Dendrite Stellardor no Refúgio Noturno, que fica na Clareira da Lua.‡Найдите духа Великого Медведя на северо-западе Лунной поляны и усвойте все, что он расскажет вам о природе медведя. Когда уроки будут закончены, вернитесь к Дендриту Блеску Звезд в Ночную Гавань в Лунной поляне.‡Sucht den großen Bärengeist im nordwestlichen Moonglade auf und lernt alles, was er Euch über die Natur des Bären mitzuteilen hat. Wenn Ihr das erledigt habt, kehrt zu Dendrite Starblaze nach Nighthaven in Moonglade zurück.‡달의 숲 북서쪽에 사는 거대한 곰의 혼을 찾아가 드루이드라면 반드시 알아야 할 곰의 본성에 대해 배워야 합니다. 임무를 완수하면 달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 돌아가십시오.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrite Rafagaestelar a Amparo de la Noche.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Aller voir l\'esprit du Grand ours, au nord-ouest de Reflet-de-Lune et apprendre ce qu\'il peut vous enseigner sur la nature de l\'ours. Quand cela est fait, retourner voir Dendrite Starblaze, à Havrenuit, dans Reflet-de-Lune.‡到月光林地的西北部去寻找巨熊之灵，向它学习关于熊的知识，然后回到月光林地的永夜港去找德迪利特·星焰。‡到月光林地的西北部去尋找巨熊之靈，向它學習關於熊的知識，然後回到月光林地的永夜港去找德迪利特·星焰。',
  }
},
[5930] = {
  {
    'Espírito do Grande Urso‡Дух Великого Медведя‡Großer Bärengeist‡거대한 곰의 혼‡Espíritu del gran oso‡Espíritu del gran oso‡Esprit du Grand ours‡巨熊之灵‡巨熊之靈',
    nil,
    'Procure o Espírito do Grande Urso na região noroeste da Clareira da Lua e aprenda o que ele tem a compartilhar com você sobre a natureza do urso. Quando terminar, fale novamente com Dendrite Stellardor no Refúgio Noturno, que fica na Clareira da Lua.‡Найдите духа Великого Медведя на северо-западе Лунной поляны и усвойте все, что он расскажет вам о природе медведя. Когда уроки будут закончены, вернитесь к Дендриту Блеску Звезд в Ночную Гавань в Лунной поляне.‡Sucht den großen Bärengeist im nordwestlichen Moonglade auf und lernt alles, was er Euch über die Natur des Bären mitzuteilen hat. Wenn Ihr das erledigt habt, kehrt zu Dendrite Starblaze nach Nighthaven in Moonglade zurück.‡달의 숲 북서쪽에 사는 거대한 곰의 혼을 찾아가 드루이드라면 반드시 알아야 할 곰의 본성에 대해 배워야 합니다. 임무를 완수하면 달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 돌아가십시오.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrite Rafagaestelar a Amparo de la Noche.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Aller voir l\'esprit du Grand ours, au nord-ouest de Reflet-de-Lune et apprendre ce qu\'il peut vous enseigner sur la nature de l\'ours. Quand cela est fait, retourner voir Dendrite Starblaze, à Havrenuit, dans Reflet-de-Lune.‡到月光林地的西北部去寻找巨熊之灵，向它学习关于熊的知识，然后回到月光林地的永夜港去找德迪利特·星焰。‡到月光林地的西北部去尋找巨熊之靈，向它學習關於熊的知識，然後回到月光林地的永夜港去找德迪利特·星焰。',
  }
},
[5931] = {
  {
    'De volta a Darnassus‡Возвращение в Дарнасс‡Zurück nach Darnassus‡다르나서스로 돌아가기‡El regreso a Darnassus‡El regreso a Darnassus‡Retour à Darnassus‡返回达纳苏斯‡返回達納蘇斯',
    nil,
    'Volte a Darnassus e fale com Mathrengyl Ursivagus no Enclave Cenariano.‡Вернитесь в Дарнасс и поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария.‡Kehrt nach Darnassus zurück und sprecht mit Mathrengyl Bearwalker in der Enklave von Cenarius.‡다르나서스로 돌아가 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Vuelve a Darnassus para hablar con Mathrengyl Garroso en el Enclave Cenarion.‡Vuelve a Darnassus para hablar con Mathrengyl Garroso en el Enclave Cenarion.‡Retourner à Darnassus et parler à Mathrengyl Bearwalker, dans l’Enclave cénarienne.‡回到达纳苏斯，与塞纳里奥区的玛斯雷·驭熊者谈一谈。‡回到達納蘇斯，與塞納裏奧區的瑪斯雷·馭熊者談壹談。',
  }
},
[5932] = {
  {
    'De volta ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Zurück nach Thunder Bluff‡썬더 블러프로 돌아가기‡Vuelve a Cima del Trueno‡Vuelve a Cima del Trueno‡Retour vers Thunder Bluff‡返回雷霆崖‡返回雷霆崖',
    nil,
    'Volte ao Penhasco do Trovão e fale com Turak Runa Totem no Platô dos Anciãos.‡Вернитесь в Громовой Утес и поговорите с Тюраком Руническим Тотемом на Вершине Старейшин.‡Kehrt nach Thunder Bluff zurück und sprecht mit Turak Runetotem auf der Anhöhe der Ältesten.‡썬더 블러프로 돌아가 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Vuelve a Cima del Trueno para hablar con Turak Tótem Rúnico en Alto de los Ancestros.‡Vuelve a Cima del Trueno para hablar con Turak Tótem de Runa en Alto de los Ancestros.‡Retourner à Thunder Bluff, et parler à Turak Runetotem, sur la Cime des Anciens.‡回到雷霆崖，与长者高地的图拉克·符文图腾谈一谈。‡回到雷霆崖，與長者高地的圖拉克·符文圖騰談壹談。',
  }
},
[5941] = {
  {
    'De novo com Crona‡Возвращение к Хроми‡Rückkehr zu Chromie‡크로미에게 돌아가기‡Vuelve con Chromie‡Regresa junto a Cromi‡Retourner voir Chromie‡返回克罗米身边‡返回克羅米身邊',
    nil,
    'Leve a Coleção de Relíquias para Crona em Andorhal.‡Отнесите сумку с реликвиями Хроми в Андорал.‡Bringt das Reliktbündel zu Chromie nach Andorhal.‡안돌할의 크로미에게 유물 자루를 가져가야 합니다.‡Lleva el montón de reliquias a Chromie a Andorhal.‡Lleva el montón de reliquias a Cromi a Andorhal.‡Apporter la Liasse de reliques à Chromie, à Andorhal.‡将一包遗物交给安多哈尔的克罗米。‡將壹包遺物交給安多哈爾的克羅米。',
  }
},
[5942] = {
  {
    'Tesouros escondidos‡Спрятанные сокровища‡Versteckte Schätze‡숨겨진 보물‡Tesoros ocultos‡Tesoros ocultos‡Trésors cachés‡隐藏的宝藏‡隱藏的寶藏',
    nil,
    'Leve a Chave de Josefo ao Baú de Josefo.‡Откройте сундук Джозефа ключом Джозефа.‡Bringt Josephs Schlüssel zu Josephs Truhe.‡조셉의 상자가 있는 곳으로 조셉의 열쇠를 가져가야 합니다.‡Lleva la llave de Joseph al cofre de Joseph.‡Lleva la llave de Joseph al cofre de Joseph.‡Utiliser la Clé de Joseph sur le Coffre de Joseph.‡用约瑟夫的钥匙打开约瑟夫的箱子。‡用約瑟夫的鑰匙打開約瑟夫的箱子。',
  }
},
[5943] = {
  {
    'Caravana Gizelton‡Караван Гизлтона‡Gizeltons Karawane‡기젤톤 대상단‡La caravana Gizelton‡La caravana Gizelton‡La caravane de Gizelton‡基泽尔顿车队‡基澤爾頓車隊',
    nil,
    'Escolte a Caravana Gizelton pelas Ruínas de Mannoroc. Fale com o Smid no Acampamento do Rabiscafuso para receber a recompensa.‡Проводите караван Гизлтона через Поле Маннорок. О награде поговорите со Смидом: его можно найти в Лагере Заржавня.‡Geleitet Gizeltons Karawane durch Mannorocs Koven. Sprecht in Scrabblescrews Lager mit Smeed, um Eure Belohnung zu erhalten.‡만노로크 소굴을 지나가는 기젤톤 대상단을 호위하고 스크래블스크류의 야영지에 있는 스미드와 대화하여 보상을 받아야 합니다.‡Escolta la caravana Gizelton a través del Aquelarre Mannoroc. Habla con Smeed en el Campamento de los Mezclatornillos para recibir tu recompensa.‡Escolta la caravana Gizelton a través del Aquelarre Mannoroc. Habla con Smeed en el Campamento de los Mezclatornillos para recibir tu recompensa.‡Escorter la caravane de Gizelton à travers le convent de Mannoroc. Parler à Smeed, au camp de Scrabblescrew, pour toucher la récompense.‡护送基泽尔顿车队通过玛诺洛克集会所，然后与瑟卡布斯库的营地的斯米德谈一谈，领取你的奖励。‡護送基澤爾頓車隊通過瑪諾洛克集會所，然後與瑟卡布斯庫的營地的斯米德談壹談，領取妳的獎勵。',
  }
},
[5944] = {
  {
    'No mundo dos sonhos‡Во сне‡In den Träumen‡탤런의 꿈‡En sueños‡En sueños‡En rêves‡在梦中‡在夢中',
    nil,
    'Escolte Taelan Fordring para fora de Amparo.‡Вывести Таэлана Фордринга из Дольного Очага.‡Geleitet Taelan Fordring aus Hearthglen hinaus.‡탤런 폴드링을 하스글렌 밖으로 호위해야 합니다.‡Escolta a Taelan Fordring fuera de la Vega del Amparo.‡Escolta a Taelan Vadín fuera de la Vega del Amparo.‡Escortez Taelan Fordring jusqu\'à la sortie des Hearthglen.‡护送泰兰·弗丁走出壁炉谷。‡護送泰蘭·弗丁走出壁爐谷。',
  }
},
[5961] = {
  {
    'O campeão da Rainha Banshees‡Защитник королевы банши‡Der Champion der Bansheekönigin‡밴시 여왕의 용사‡Campeón de la Reina alma en pena‡Campeón de la Reina alma en pena‡Le champion de la reine banshee‡女妖之王的勇士‡女妖之王的勇士',
    nil,
    'Fale com Nathanos, o Arauto da Praga nas Terras Pestilentas Orientais. Dizem que ele fixou residência no Sítio dos Marris.‡Поговорите с Натаносом Гнилостенем в Восточных Чумных землях. Он живет в Поместье Маррисов.‡Sprecht mit Nathanos Blightcaller in den Östlichen Pestländern. Es heißt, dass er sich in Marris Siedlung niedergelassen hätte.‡동부 역병지대의 마리스 농장에 살고 있는 나타노스 블라이트콜러와 대화해야 합니다.‡Habla con Nathanos Clamañublo en las Tierras de la Peste del Este. Se dice que ahora vive en la Hacienda de Marris.|n‡Habla con Nathanos Clamañublo en las Tierras de la Peste del Este. Se dice que ahora vive en la Hacienda de Marris.‡Parler à Nathanos le Flétrisseur, dans les Maleterres de l’est. Il se trouve actuellement à la ferme des Marris.‡与东瘟疫之地的纳萨诺斯·凋零者谈一谈。据说他居住在玛瑞斯农场。‡與東瘟疫之地的納薩諾斯·雕零者談壹談。據說他居住在瑪瑞斯農場。',
  }
},
[5981] = {
  {
    'Gigantes descontrolados‡Истребление великанов‡Tobende Riesen‡광란의 거인‡Gigantes arrasadores‡Gigantes arrasadores‡Géants déchaînés‡狂暴的巨人‡狂暴的巨人',
    nil,
    'Ripárion Glaciares quer que você mate 4 Gigantes Friomalho e 4 Preservadores Friomalho.‡По просьбе Риверна Холодного Ветра убейте 4 великанов и 4 оберегателей ледяного молота.‡Rivern Frostwind möchte, dass Ihr 4 Frosthagelriesen und 4 Frosthagelbewahrer besiegt.‡리베른 프로스트윈드의 지시대로 서리망치거인 4명과 서리망치거인 수호자 4명을 없애야 합니다.‡Rivern Ventogélido quiere que mates 4 gigantes Machacahielo y 4 presertores Machacahielo.‡Rivern Ventogélido quiere que mates 4 gigantes Machacahielo y 4 valedores Machacahielo.‡Rivern Frostwind voudrait que vous tuiez 4 Géants Cognegivre et 4 Protecteurs Cognegivre.‡雷沃·霜翼要你去杀死4个霜槌巨人和4个霜槌保卫者。‡雷沃·霜翼要妳去殺死4個霜槌巨人和4個霜槌保衛者。',
  }
},
[6001] = {
  {
    'Corpo e coração‡Тело и дух‡Körper und Herz‡육체와 정신‡Cuerpo y corazón‡Cuerpo y corazón‡Corps et cœur‡身心之力‡身心之力',
    nil,
    'Aplique Poeira de Lua Cenariana na Pedra Luniscante de Auberdine para trazer Lunagarra. Então, enfrente Lunagarra e ganhe a força de corpo e coração que ele possui.|nFale com Mathrengyl Ursivagus em Darnassus quando você terminar.‡Посыпьте лунной пылью Кенария камень лунного совуха в Аубердине, чтобы вызвать Лунокогтя. Победите Лунокогтя, чтобы получить силу его тела и духа.|nЗатем поговорите с Матренгилом Медвежьей Лапой в Дарнассе.‡Benutzt den Mondstaub des Cenarius mit dem Moonkinstein, um Mondklaue herauszulocken. Danach müsst Ihr Euch Mondklaue stellen und Euch die Kraft des Körpers und des Herzens verdienen, die er besitzt.|nSprecht mit Mathrengyl Bearwalker in Darnassus, wenn Ihr fertig seid.‡아우버다인의 달빛야수 비석에 세나리온 달가루를 뿌려서 초승달발톱을 불러내야 합니다. 그런 다음 초승달발톱과 대면하여 그가 가진 육체와 정신의 힘을 얻어야 합니다.|n모든 일을 마치면 다르나서스에 있는 마스렌길 베어워커와 대화하십시오.‡Utiliza el polvo de luna Cenarion en la piedra de lechúcico lunar de Auberdine para invocar a Garraluna. Luego tendrás que enfrentarte a Garraluna y ganar la fuerza física y de corazón que posee.|nCuando hayas acabado, vuelve a Darnassus y habla con Mathrengyl Garroso.‡Utiliza el polvo de luna Cenarion en la piedra de lechúcico lunar de Auberdine para invocar a Garraluna. Luego tendrás que enfrentarte a Garraluna y ganar la fuerza física y de corazón que posee.|nCuando hayas acabado, vuelve a Darnassus y habla con Mathrengyl Garroso.‡Utiliser la Poussière de lune cénarienne sur la Pierre des séléniens d’Auberdine pour invoquer Lunegriffe. Affronter Lunegriffe, et gagner la force physique et spirituelle qu’il possède.|nQuand cela est fait, parler à Mathrengyl Bearwalker, à Darnassus.‡使用奥伯丁的月夜枭兽之石上面的塞纳里奥月尘引出月爪枭兽，然后击败月爪枭兽并吸取它所拥有的身心之力。|n任务完成之后，与达纳苏斯的玛斯雷·驭熊者谈一谈。‡使用奧伯丁的月夜梟獸之石上面的塞納裏奧月塵引出月爪梟獸，然後擊敗月爪梟獸並吸取它所擁有的身心之力。|n任務完成之後，與達納蘇斯的瑪斯雷·馭熊者談壹談。',
  }
},
[6002] = {
  {
    'Corpo e coração‡Тело и дух‡Körper und Herz‡육체와 정신‡Cuerpo y corazón‡Cuerpo y corazón‡Corps et cœur‡身心之力‡身心之力',
    nil,
    'Aplique Poeira Lunar Cenariana na Pedra Luniscante entre Mulgore e os Sertões para evocar Lunagarra. Então, enfrente Lunagarra e ganhe a força de corpo e coração que ele possui.|nFale com Turak Runa Totem no Penhasco do Trovão quando terminar.‡Посыпьте лунной пылью Кенария Камень Лунного совуха, что между Мулгором и Степями, чтобы вызвать Лунокогтя. Теперь вам надо побороть Лунокогтя, чтобы заслужить его силу духа и тела.|nКогда выполните это, поговорите с Тюраком Руническим Тотемом в Громовом Утесе.‡Benutzt den Lunarstaub des Cenarius mit dem Moonkinstein, um Mondklaue herauszulocken. Danach müsst Ihr Euch Mondklaue stellen und Euch die Kraft des Körpers und des Herzens verdienen, die er besitzt.|nSprecht mit Turak Runetotem in Thunder Bluff, wenn Ihr fertig seid.‡초승달발톱을 불러내려면 멀고어와 불모의 땅 사이에 있는 달빛야수 비석에 세나리온 달가루를 사용해야 합니다. 거기에서 초승달발톱과 대적하여 그가 가진 육체와 마음의 힘을 얻으십시오.|n임무를 마치면 썬더 블러프에 있는 투락 룬토템과 대화해야 합니다.‡Aplica el polvo de luna Cenarion a la piedra de lechúcico lunar que se encuentra entre Mulgore y Los Baldíos para provocar a Garraluna. Hecho esto, has de enfrentarte a Garraluna para obtener la fuerza física y de corazón que posee.|nHabla con Turak Runatótem en Cima del Trueno cuando hayas acabado.‡Aplica el polvo de luna Cenarion a la piedra de lechúcico lunar que se encuentra entre Mulgore y Los Baldíos para provocar a Garraluna. Hecho esto, has de enfrentarte a Garraluna para obtener la fuerza física y de corazón que posee.|nHabla con Turak Tótem de Runa en Cima del Trueno cuando hayas acabado.‡Utiliser la Poussière lunaire cénarienne sur la Pierre des séléniens, entre Mulgore et les Tarides, pour invoquer Lunegriffe. Affronter Lunegriffe, et gagner la force physique et spirituelle qu’il possède.|nQuand cela est fait, parler à Turak Runetotem, à Thunder Bluff.‡使用莫高雷与贫瘠之地交界处的月夜枭兽之石上面的塞纳里奥月尘引出月爪枭兽，然后击败月爪枭兽并吸取它所拥有的身心之力。|n任务完成之后，与雷霆崖的图拉克·符文图腾谈一谈。‡使用莫高雷與貧瘠之地交界處的月夜梟獸之石上面的塞納裏奧月塵引出月爪梟獸，然後擊敗月爪梟獸並吸取它所擁有的身心之力。|n任務完成之後，與雷霆崖的圖拉克·符文圖騰談壹談。',
  }
},
[6004] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡끝나지 않은 임무‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡未竟的事业‡未竟的事業',
    nil,
    'Mate 2 Socorristas Escarlate, 2 Caçadores Escarlate, 2 Magos Escarlate e 2 Cavaleiros Escarlate antes de voltar a Kirsta Sombrafunda, nas Terras Pestilentas Ocidentais.‡Убейте 2 медиков, 2 охотников, 2 волхвов и 2 рыцарей Алого ордена и вернитесь к Кристе Чернотени в Западных Чумных землях.‡Tötet 2 scharlachrote Sanitäter, 2 scharlachrote Jäger, 2 scharlachrote Magi und 2 scharlachrote Ritter, bevor Ihr zu Kirsta Deepshadow in den Westlichen Pestländern zurückkehrt.‡붉은십자군 의무병 2명, 붉은십자군 사냥꾼 2명, 붉은십자군 마법사 2명, 붉은십자군 기사 2명을 처치하고 서부 역병지대에 있는 키르스타 딥섀도에게 돌아가야 합니다.‡Mata a 2 médicos Escarlata, 2 cazadores Escarlata, 2 magos Escarlata y 2 caballeros Escarlata antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Mata a 2 médicos Escarlata, 2 cazadores Escarlata, 2 magos Escarlata y 2 caballeros Escarlata antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Tuer deux Médecins écarlates, deux Chasseurs écarlates, deux Magi écarlates et deux Chevaliers écarlates avant de revenir vers Krista Deepshadow dans les Maleterres de l\'ouest.‡杀死2个血色医护员、2个血色猎人、2个血色魔法师和2个血色骑士，然后回到西瘟疫之地的科尔斯塔·迪普沙东那儿。‡殺死2個血色醫護員、2個血色獵人、2個血色魔法師和2個血色騎士，然後回到西瘟疫之地的科爾斯塔·迪普沙東那兒。',
  }
},
[6021] = {
  {
    'Zaeldarr, o Proscrito‡Зельдарр Изгой‡Zaeldarr der Ausgestoßene‡추방자 잴다르‡Zaeldarr el Marginado‡Zaeldarr el Marginado‡Zaeldarr le Banni‡流亡者塞达尔‡流亡者塞達爾',
    nil,
    'Leve a Cabeça de Zaeldarr ao Zelador Alen na Capela Esperança da Luz.‡Принесите голову Зельдарра Управляющему Алену в Часовню Последней Надежды.‡Bringt Zaeldarrs Kopf zu Verwalter Alen in der Kapelle des hoffnungsvollen Lichts.‡잴다르를 처치하고 그 증거로 머리카락을 희망의 빛 예배당에 있는 관리인 알렌에게 가져가야 합니다.‡Mata al infiltrador Hameya. Utiliza su llave en el Túmulo que hay detrás de La Subgranja.‡Lleva la cabeza de Zaeldarr al custodio Alen a la Capilla de la Esperanza de la Luz.‡Apporter la Tête de Zaeldarr au Conservateur Alen, à la chapelle de l\'Espoir de Lumière.‡将塞达尔的头颅交给圣光之愿礼拜堂的护理者奥林。‡將塞達爾的頭顱交給聖光之願禮拜堂的護理者奧林。',
  }
},
[6022] = {
  {
    'Matar com propósito‡Преднамеренное убийство‡Töten zu einem bestimmten Zweck‡이유 있는 살육‡Matar con un propósito‡Matar con un propósito‡Tuer utile‡杀戮的理由‡殺戮的理由',
    nil,
    'Vá ao Cruzamento de Corin, a leste, e mate membros do Flagelo que habitam a cidade. Colete 7 pedaços de Putrefação Viva em menos de 10 minutos. Use o Almofariz e Pilão para moer a Putrefação Viva, de maneira a transformá-la em Putrefação Coagulada.‡Отправляйтесь на восток в Перекресток Корина и убейте несколько населяющих его созданий Плети. Соберите 7 кусков живой гнили менее, чем за 10 минут. С помощью ступки и пестика превратите живую гниль в сгущенную гниль.‡Begebt Euch zu Corins Kreuzung im Osten und besiegt die Mitglieder der Geißel, die in der Stadt leben. Sammelt 7 Stücke lebendige Fäulnis in unter 10 Minuten. Zerstoßt die lebendige Fäulnis mit Mörser und Stößel zu geronnener Fäulnis.‡동쪽의 코린 삼거리로 가서 마을에 사는 스컬지를 해치워 10분 안에 살아있는 부패물 7개를 모으십시오. 막자 사발을 사용해서 살아있는 부패물을 갈아 응고된 부패물로 만들어야 합니다.‡Viaja al Cruce de Corin al este y mata a los miembros de la Plaga que habitan allí. Recoge 7 piezas de putrefacción viva en 10 minutos. Utiliza el mortero y la mano de mortero para convertir la putrefacción viva en putrefacción coagulada.‡Viaja al Cruce de Corin al este y mata a los miembros de la Plaga que habitan allí. Recoge 7 piezas de putrefacción viva en 10 minutos. Utiliza el mortero y el majadero para convertir la putrefacción viva en putrefacción coagulada.‡Allez à l\'est à la Croisée de Corin et détruisez les membres du Fléau qui habitent la ville. Rassemblez sept morceaux de Pourriture vivante en moins de dix minutes. Utilisez le Mortier et le pilon pour réduire la Pourriture vivante en Pourriture coagulée.‡到东边的考林路口去屠杀镇里的亡灵天灾。在10分钟内收集7块生命腐质，使用研钵和捣杵将其研磨成凝固腐质。‡到東邊的考林路口去屠殺鎮裏的亡靈天災。在10分鐘內收集7塊生命腐質，使用研缽和搗杵將其研磨成凝固腐質。',
  }
},
[6023] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡끝나지 않은 임무‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡未完的任务‡未完的任務',
    nil,
    'Mate o Guarda-caça Eiras e o Fidalgo Durgen antes de voltar à Kirsta Sombrafunda, nas Terras Pestilentas Ocidentais.‡Убейте охотника Радли и кавалериста Даргена и вернитесь к Кристе Чернотени в Западные Чумные земли.‡Besiegt Jägerin Radley und Chevalier Durgen, bevor Ihr zu Kirsta Deepshadow in den Westlichen Pestländern zurückkehrt.‡사냥꾼 래들리와 기병 드루겐을 처치하고 서부 역병지대에 키르스타 딥섀도에게 돌아가야 합니다.‡Mata al cazador Radley y al hidalgo Durgen antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Mata al montero Radley y al hidalgo Durgen antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Tuer le veneur Radley et le cavalier Durgen, avant de retourner voir Kirsta Deepshadow, dans les Maleterres de l’ouest.‡杀掉猎人莱德雷和骑士杜尔根，然后向西瘟疫之地的科尔斯塔·迪普沙东复命。‡殺掉獵人萊德雷和騎士杜爾根，然後向西瘟疫之地的科爾斯塔·迪普沙東復命。',
  }
},
[6024] = {
  {
    'A súplica de Hameya‡Мольба Хамейи‡Hameyas Bitte‡하메야의 탄원서‡La súplica de Hameya‡La súplica de Hameya‡L\'appel d\'Hameya‡哈米亚的请求‡哈米亞的請求',
    nil,
    'Mate o Infiltrador Hameya. Use a chave dele no Monturo de Terra atrás da Chácara Secreta.‡Убейте секретного агента Хамейю. С помощью ключа извлеките сокровище из кучи грязи за Криптой.‡Tötet Spitzel Hameya. Benutzt seinen Schlüssel bei dem Erdhaufen hinter dem Tiefgewölbe.‡첩보원 하메야를 처치해야 합니다. 지하 납골당 뒤의 흙무더기에서 그의 열쇠를 사용하십시오.‡Lleva la cabeza de Zaeldarr al custodio Alen a la Capilla de la Esperanza de la Luz.‡Mata al infiltrador Hameya. Usa su llave en el túmulo detrás de La Subgranja.‡Tuer l’Infiltrateur Hameya. Utiliser sa clé sur le Monticule de poussière, derrière le caveau de Zaeldarr.‡杀了渗透者哈米亚，用他的钥匙开启墓室后的一堆泥土。‡殺了滲透者哈米亞，用他的鑰匙開啟墓室後的壹堆泥土。',
  }
},
[6025] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡끝나지 않은 임무‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡未完的任务‡未完的任務',
    nil,
    'Entre em Amparo e encontre um lugar alto de onde possa ver a cidade e avaliar as forças da Cruzada Escarlate. Então fale novamente com Kirsta Sombrafunda nas Terras Pestilentas Ocidentais.‡Проберитесь в Дольный Очаг и найдите возвышенность, с которой открывается вид на весь город. Оцените силы Алого ордена и вернитесь к Кристе Чернотени в Западных Чумных землях.‡Geht nach Hearthglen, sucht einen hohen Aussichtspunkt, von dem aus Ihr die Stadt überblicken könnt, schätzt die Streitkräfte des Scharlachroten Kreuzzugs und kehrt dann zu Kirsta Deepshadow in den Westlichen Pestländern zurück.‡하스글렌에 들어가 마을이 잘 보이는 높은 지대를 찾아 붉은십자군 병력 규모를 파악한 다음 서부 역병지대에 있는 키르스타 딥섀도에게 돌아가야 합니다.‡Entra en la Vega del Amparo y busca un punto elevado desde el que puedas ver la ciudad y calcular las fuerzas de la Cruzada Escarlata. Cuando lo hayas hecho regresa con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Entra en la Vega del Amparo y busca un punto elevado desde el que puedas ver la ciudad y calcular las fuerzas de la Cruzada Escarlata. Cuando lo hayas hecho regresa con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Aller dans Hearthglen, et trouver un poste d’observation élevé d’où voir la ville et jauger les forces de la Croisade écarlate, puis retourner voir Kirsta Deepshadow, dans les Maleterres de l’ouest.‡进入壁炉谷并找一处高地，你可以在那里观察整个城镇并估算血色十字军的兵力，然后向西瘟疫之地的科尔斯塔·迪普沙东回报。‡進入壁爐谷並找壹處高地，妳可以在那裏觀察整個城鎮並估算血色十字軍的兵力，然後向西瘟疫之地的科爾斯塔·迪普沙東回報。',
  }
},
[6026] = {
  {
    'Isso é pedir muito‡Работу пополам‡Das ist viel verlangt‡여러 가지 부탁‡Eso pide mucho‡Eso pide mucho‡Cela demande beaucoup‡狮子大开口‡獅子大開口',
    nil,
    'Leandro Leonardo quer que você pegue 2 Barras de Tório, 1 Bastão Dourado, 8 Bombas de Alto-explosivo e 8 Gatilhos Instáveis.|nVocê terá que encontrar um ferreiro e um engenheiro para esses itens.‡Принесите 2 ториевых слитка, 1 золотой жезл, 8 высоковзрывных бомб и 8 нестабильных пусковых устройств Дымку ЛаРу.|nДля этого вам придется найти кузнеца и инженера.‡Smokey LaRue möchte, dass Ihr 2 Thoriumbarren, 1 Goldrute, 8 hochexplosive Bomben und 8 instabile Auslöser beschafft.|nFür diese Gegenstände müsst Ihr einen Schmied und einen Ingenieur finden.‡토륨 주괴 2개, 금마법막대 1개, 고폭탄 8개, 유동성 제동장치 8개를 스모키 라루에게 가져가야 합니다.|n해당 물건을 모으려면 대장장이와 기계공학 기술자를 찾아야 합니다.‡Smokey LaRue quiere que consigas 2 barras de torio, 1 vara dorada, 8 bombas de gran carga y 8 disparadores inestables.|nTendrás que encontrar a un herrero y a un ingeniero para conseguir esos objetos.‡Smokey LaRue quiere que consigas 2 barras de torio, 1 vara dorada, 8 bombas de gran carga y 8 disparadores inestables.|nTendrás que encontrar a un herrero y a un ingeniero para conseguir esos objetos.‡Smokey LaRue veut que vous lui apportiez 2 Barres de thorium, 1 Bâtonnet doré, 8 Bombes explosives et 8 Déclencheurs instables.|nVous devrez trouver un forgeron et un ingénieur pour obtenir ces objets.‡烟鬼拉鲁恩要你拿来2块瑟银锭、1根金棒、8颗高爆炸弹和8个不牢固的扳机。|n你需要找铁匠和工程学技师帮忙制作这些东西。‡煙鬼拉魯恩要妳拿來2塊瑟銀錠、1根金棒、8顆高爆炸彈和8個不牢固的扳機。|n妳需要找鐵匠和工程學技師幫忙制作這些東西。',
  }
},
[6027] = {
  {
    'O Livro dos Anciãos‡Книга Древних‡Buch der Uralten‡고대의 책‡El Libro de los Ancestros‡El Libro de los Ancestros‡Le Livre des Anciens‡上古之书‡上古之書',
    nil,
    'Pegue o Livro dos Anciãos e entregue-o para Azore Albamorte na torre de Ethel Rethor.‡Отыщите Книгу Древних и принесите ее Азору Альдаморту в башню Этель-Ретор.‡Beschafft das \'Buch der Uralten\' und kehrt zu Azore Aldamort im Turm von Ethel Rethor zurück.‡고대의 책을 손에 넣은 다음 에텔 레소르의 탑에 있는 아조레 알다모트에게 가져가야 합니다.‡Consigue el Libro de los Ancestros y llévaselo a Azore Aldamort a la torre de Ethel Rethor.|n‡Consigue el Libro de los Ancestros y llévaselo a Azore Aldamort a la torre de Ethel Rethor.‡Obtenir le Livre des Anciens, puis le rapporter à Azore Aldamort, dans la tour d’Ethel Rethor.‡拿到上古之书，将其交给艾瑟雷索塔中的阿佐尔·奥达蒙特。‡拿到上古之書，將其交給艾瑟雷索塔中的阿佐爾·奧達蒙特。',
  }
},
[6028] = {
  {
    'O relatório de Visteterna‡Донесение из Круговзора‡Der Everlook-Bericht‡눈망루 마을 보고서‡El informe Vista Eterna‡El informe Vista Eterna‡Le rapport de Long-guet‡永望镇报告‡永望鎮報告',
    nil,
    'Entregue o Relatório de Visteterna à Oficial Argêntea Cândida no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Доставьте донесение из Круговзора офицеру Чистосердой из ордена Серебряного Рассвета в Лагерь Промозглого Ветра в Западных Чумных землях.‡Bringt den Everlook-Bericht zu Argentumoffizier Pureheart im Chillwind-Lager in den westlichen Pestländern.‡서부 역병지대, 서리바람 야영지에 있는 은빛장교 퓨어하트에게 눈망루 마을 보고서를 전달해야 합니다.‡Entrega el informe de Vista Eterna a la oficial Argenta Purocorazón en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Entrega el informe de Vista Eterna a la oficial Argenta Purocorazón en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apportez le Rapport de Long-guet à l\'officier de l\'Aube d\'argent Pureheart au Camp du Noroît, dans les Maleterres de l\'ouest.‡把永望镇报告送给西瘟疫地冰风岗的银色黎明军官普尔哈特。‡把永望鎮報告送給西瘟疫地冰風崗的銀色黎明軍官普爾哈特。',
  }
},
[6029] = {
  {
    'O relatório de Visteterna‡Донесение из Круговзора‡Der Everlook-Bericht‡눈망루 마을 보고서‡El informe Vista Eterna‡El informe Vista Eterna‡Le rapport de Long-guet‡永望镇报告‡永望鎮報告',
    nil,
    'Entregue o Relatório de Visteterna ao Oficial Argênteo Garush no Baluarte, nas Terras Pestilentas Ocidentais.‡Доставьте донесение из Круговзора офицеру Гарушу из ордена Серебряного Рассвета в Бастион в Западных Чумных землях.‡Bringt den Everlook-Bericht zu Argentumoffizier Garush im Bollwerk in den Westlichen Pestländern.‡서부 역병지대 보루에 있는 은빛장교 가루쉬에게 눈망루 마을 보고서를 전달해야 합니다.‡Entrega el informe de Vista Eterna al oficial Argenta Garush en El Baluarte, en las Tierras de la Peste del Oeste.‡Entrega el informe de Vista Eterna al oficial Argenta Garush en El Baluarte, en las Tierras de la Peste del Oeste.‡Livrer le Rapport de Long-guet à l’officier Garush de l\'Aube d\'argent, à la Barricade, dans les Maleterres de l’ouest.‡把永望镇报告送给西瘟疫地亡灵壁垒的银色黎明军官加鲁什。‡把永望鎮報告送給西瘟疫地亡靈壁壘的銀色黎明軍官加魯什。',
  }
},
[6030] = {
  {
    'Duque Nicolau Zverenhoff‡Герцог Николас Зверенхофф.‡Fürst Nicholas Zverenhoff‡공작 니콜라스 즈바른호프‡El duque Nicolas Zverenhoff‡El duque Nicolas Zverenhoff‡Le duc Nicholas Zverenhoff‡尼古拉斯·瑟伦霍夫公爵‡尼古拉斯·瑟倫霍夫公爵',
    nil,
    'Entregue o livro "Estudos sobre Comunicação com Espíritos" ao Duque Nicolau Zverenhoff na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Доставьте книгу "Исследования речи духов" Герцогу Николасу Зверенхоффу в Часовню Последней Надежды в Восточных Чумных землях.‡Bringt das Buch \'Studien zur Geistersuche\' zu Fürst Nicholas Zverenhoff in der Kapelle des hoffnungsvollen Lichts in den Östlichen Pestländern.‡동부 역병지대 희망의 빛 예배당에 있는 공작 니콜라스 즈바른호프에게 "영적인 대화에 대한 논문"이라는 책을 전해야 합니다.‡Entrega el libro, "Estudios sobre la Comunicación con los Espíritus", al duque Nicolas Zverenhoff en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega el libro, "Estudios sobre la Comunicación con los Espíritus", al duque Nicolas Zverenhoff en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le livre " Etudes sur la langue des Esprits " au duc Nicholas Zverenhoff, à la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est.‡将《灵语研究》这本书交给东瘟疫之地圣光之愿礼拜堂的尼古拉斯·瑟伦霍夫公爵。‡將《靈語研究》這本書交給東瘟疫之地聖光之願禮拜堂的尼古拉斯·瑟倫霍夫公爵。',
  }
},
[6031] = {
  {
    'Runatrama‡Рунная ткань‡Runenstoff‡룬매듭‡Paño rúnico‡Paño rúnico‡L\'étoffe runique‡符文布‡符文布',
    nil,
    'Leve 30 cortes de Runatrama para Meilosh no Domínio dos Presamatos.‡Принесите 30 отрезов рунной ткани Мелиошу в крепость Древобрюхов.‡Bringt 30 Runenstoff zu Meilosh in der Holzschlundfeste.‡나무구렁 요새에 있는 메일로쉬에게 룬매듭 30개를 가져가야 합니다.‡Llévale 30 retales de paño rúnico a Meilosh, que está en el Bastión de los Fauces de Madera.‡Llévale 30 paños rúnicos a Meilosh, que está en el Bastión Fauces de Madera.‡Apportez 30 pièces d\'étoffe runique à Meilosh au Repaire des Grumegueules.‡把30块符文布交给木喉要塞的梅罗什。‡把30塊符文布交給木喉要塞的梅羅什。',
  }
},
[6032] = {
  {
    'Tecido sagrado‡Священная ткань‡Hochheiliger Stoff‡신성한 옷감‡Tela sagrada‡Tela sagrada‡Le vêtement sacré‡神圣的月布‡神聖的月布',
    nil,
    'Leve 2 cortes de Lunatrama para Meilosh no Domínio dos Presamatos.‡Принесите 2 отреза луноткани Мелиошу в Крепость Древобрюхов.‡Bringt 2 Mondstoff zu Meilosh in der Holzschlundfeste.‡나무구렁 요새에 있는 메일로쉬에게 달빛매듭 2개를 갖다주어야 합니다.‡Llévale 2 retales de tela lunar a Meilosh, que está en el Bastión de los Fauces de Madera.‡Llévale 2 retales de tela lunar a Meilosh, que está en el Bastión Fauces de Madera.‡Apporter 2 pièces d’Etoffe lunaire à Meilosh, au Repaire des Grumegueules.‡把2块月布交给木喉要塞的梅罗什。‡把2塊月布交給木喉要塞的梅羅什。',
  }
},
[6041] = {
  {
    'Quando Leandro canta, eu fico violento‡Дымок над водою‡When Smokey Sings, I Get Violent‡짜증나는 스모키의 노래‡Cuando Smokey canta, me pongo violento‡Cuando Smokey canta, me pongo violento‡Quand Smokey chante, je deviens violent‡烟鬼的炸药‡煙鬼的炸藥',
    nil,
    'Viaje ao Bosque Pestilento, a noroeste da Esperança da Luz. Destrua 8 Estruturas do Flagelo usando o Composto Químico Especial do Leandro na Marca de Detonação plantada dentro de cada construção. Os Zigurates e Abatedouros foram marcados por instrução de Leandro.|nAssim que você plantar a bomba, deixe a estrutura e contemple seu trabalho.|nA propósito, o Composto Químico Especial do Leandro é bastante... instável.‡Отправляйтесь в Проклятый лес, к северо-западу от часовни Светлых надежд. Уничтожьте 8 строений Плети, отмеченных знаком взрыва, поместив особый состав Дымка внутрь строения. Дымок отметил зиккураты и бойни.|nРазместив бомбу внутри строения, немедленно выбирайтесь наружу и любуйтесь делом рук своих с безопасного расстояния.|nАх да, вот еще что, особый состав Дымка – вещество весьма нестабильное.‡Reist in den Pestwald, nordwestlich der Hoffnung des Lichts. Zerstört 8 Geißelbauwerke, indem Ihr Smokeys spezielles Präparat am Mal der Zerstörung in jedem Bauwerk benutzt. Smokey hat die Ziggurats und Schlachthäuser markieren lassen.|nWenn ihr die Bombe gelegt habt, dann verlasst das Bauwerk und staunt über Euer Geschick.|nÜbrigens, Smokeys spezielles Präparat ist recht ... instabil.‡희망의 빛 예배당 북서쪽에 있는 역병의 숲으로 가십시오. 스모키의 특수혼합물을 건물 안에 부착하여, 폭파 표시가 있는 스컬지 건물 8개를 파괴해야 합니다. 스모키가 지구라트와 도살장에 징표를 남겼습니다.|n폭탄을 부착한 후에는 건물에서 나와 폭발 광경을 지켜 보세요.|n그건 그렇고 스모키의 특수혼합물은 다소 불안정합니다.‡Viaja al Bosque de la Peste, al noroeste de la Esperanza de la Luz. Destruye 8 estructuras de la Plaga utilizando el compuesto especial de Smokey en la marca de detonación que hay en el interior de cada edificio. Smokey ha hecho marcar los zigurats y los degolladeros.|nCuando plantes la bomba, sal del edificio y disfruta del espectáculo.|nPor cierto, el compuesto especial de Smokey es... bastante inestable.‡Viaja al Bosque de la Peste, al noroeste de la Esperanza de la Luz. Destruye 8 estructuras de la Plaga utilizando el compuesto especial de Smokey en la marca de detonación que hay en el interior de cada edificio. Smokey ha hecho marcar los zigurats y los degolladeros.|nCuando plantes la bomba, sal del edificio y disfruta del espectáculo.|nPor cierto, el compuesto especial de Smokey es... bastante inestable.‡Aller à Pestebois, au nord-ouest de la chapelle de l\'Espoir de Lumière. Détruire 8 Bâtiments du Fléau en utilisant le Mélange spécial de Smokey sur les Marques de détonation que portent les bâtiments destinés à être détruits. Smokey a fait marquer les ziggourats et les abattoirs.|nUne fois la bombe placée, quitter le bâtiment et contempler le résultat de votre opération.|nGarder en tête que le Mélange spécial de Smokey est très... instable.‡到圣光之愿礼拜堂西北方的病木林去。在那些有爆炸标记的建筑物中对爆炸标记使用烟鬼的特殊混合物，以此来摧毁8座亡灵天灾建筑。烟鬼已经给通灵塔和屠宰房做上了标记。|n一旦你放置好炸弹，就离那些建筑物远一些，然后尽情欣赏你的杰作吧。|n顺便说一句，烟鬼的特殊混合物相当不稳定……‡到聖光之願禮拜堂西北方的病木林去。在那些有爆炸標記的建築物中對爆炸標記使用煙鬼的特殊混合物，以此來摧毀8座亡靈天災建築。煙鬼已經給通靈塔和屠宰房做上了標記。|n壹旦妳放置好炸彈，就離那些建築物遠壹些，然後盡情欣賞妳的傑作吧。|n順便說壹句，煙鬼的特殊混合物相當不穩定……',
  }
},
[6042] = {
  {
    'Pequenos transtornos da Morte-em-Vida‡Мелочи нежизни‡Die kleinen Ärgernisse des Un-Lebens‡성가신 녀석들‡Los pequeños problemas de la no-vida‡Los pequeños problemas de la no-vida‡Les petits soucis de la non-vie‡讨厌的蝙蝠‡討厭的蝙蝠',
    nil,
    'Mate 20 Quirópragos Nóxios e 10 Quirópragos Monstruosos. Fale novamente com Nathanos Arauto da Praga quando você tiver terminado.‡Истребите 20 пагубных нетопырей и 10 чудовищных чумных нетопырей. После возвращайтесь к Натаносу Гнилостеню.‡Erschlagt 20 giftige Seuchenfledermäuse und 10 monströse Seuchenfledermäuse. Kehrt zu Nathanos Blightcaller zurück, wenn Ihr fertig seid.‡맹독 역병박쥐 20마리와 기괴한 역병박쥐 10마리를 해치운 후 나타노스 블라이트 콜러에게 돌아가야 합니다.‡Mata a 20 murcipestes tóxicos y 10 murcipestes monstruosos. Vuelve con Nathanos Clamorinfecto cuando hayas acabado.‡Mata a 20 murcipestes tóxicos y 10 murcipestes monstruosos. Vuelve con Nathanos Clamañublo cuando hayas acabado.‡Tuer 20 Chauves-souris pestiférées nuisibles et 10 Chauves-souris pestiférées monstrueuses. Retourner voir Nathanos le Flétrisseur quand ce sera fait.‡杀掉20只毒性瘟疫蝙蝠和10只巨型瘟疫蝙蝠，然后回到纳萨诺斯·凋零者那里。‡殺掉20只毒性瘟疫蝙蝠和10只巨型瘟疫蝙蝠，然後回到納薩諾斯·雕零者那裏。',
  }
},
[6061] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Pinote Adulto. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Yaw Crina Cortante na Aldeia Casco Sangrento.‡Приручите взрослого равнинного долгонога при помощи хлыста приручения. Потренируйтесь и верните хлыст Йо Колкой Гриве в Деревне Кровавого Копыта.‡Benutzt die Zähmrute, um einen ausgewachsenen Ebenenschreiter zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Yaw Sharpmane in Bloodhoof.‡조련용 막대를 사용해 다자란 초원타조를 길들이고 기술을 연습한 후 블러드후프 마을에 있는 요 샤프메인에게 조련용 막대를 돌려줘야 합니다.‡Usa la fusta de domador para domar un zancudo de llanura adulto. Practica un poco y devuélvele la fusta a Yaw Trampa en el Poblado Pezuña de Sangre.‡Usa la fusta de doma para domar un zancudo de llanura adulto. Practica un poco y devuélvele la fusta a Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Utiliser le Bâtonnet de domptage pour dompter un trotteur des plaines adulte. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Yaw Sharpmane, au village Bloodhoof.‡使用驯兽棒驯服成年陆行鸟。练习你的技能，然后将驯兽棒还给血蹄村的雅文·刺鬃。‡使用馴獸棒馴服成年陸行鳥。練習妳的技能，然後將馴獸棒還給血蹄村的雅文·刺鬃。',
  }
},
[6062] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Mosquetusco Hediondo. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Thotar no Monte Navalha.‡Приручите лютого пятнистого вепря с помощью хлыста приручения. Потренируйтесь, потом верните хлыст приручения Тотару в Колючем Холме.‡Benutzt die Zähmrute, um einen scheckigen Terroreber zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Thotar in Klingenhügel.‡조련용 막대를 사용해 사나운 점박이멧돼지를 길들여야 합니다. 기술을 연습한 후 칼바위 언덕에 있는 소타르에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de domador para domar un jabalí salvaje jaspeado. Practica un poco y devuélvele la fusta a Thotar en Cerrotajo.‡Usa la fusta de doma para domar un jabalí jaspeado temible. Practica un poco y devuélvele la fusta a Thotar en Cerrotajo.‡Utiliser le Bâtonnet de domptage pour dompter un sanglier tacheté redoutable. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Thotar de Tranchecolline.‡使用驯兽棒驯服可怕的杂斑野猪。练习你的技能，然后将驯兽棒还给剃刀岭的索塔尔。‡使用馴獸棒馴服可怕的雜斑野豬。練習妳的技能，然後將馴獸棒還給剃刀嶺的索塔爾。',
  }
},
[6063] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Tocaieira Lenhateia. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Dazalar em Dolanaar.‡С помощью хлыста приручения приручите чащобного тенетника. Поупражняйтесь, затем верните хлыст приручения Дазалару в Доланаар.‡Benutzt die Zähmrute, um einen Waldweberlauerer zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Dazalar in Dolanaar.‡조련용 막대를 사용해 나무그물 늑대거미를 길들여야 합니다. 기술을 연습한 후 돌라나르에 있는 다잘라에게 조련용 막대를 돌려주어야 합니다.‡Utiliza la fusta de domador para domar a un rondador Tejemadera. Practica tus habilidades y después devuélvele la fusta de domador a Dazalar, que está en Dolanaar.‡Utiliza la fusta de doma para domar a un rondador Tejemadera. Practica tus habilidades y después devuélvele la fusta de doma a Dazalar, que está en Dolanaar.‡Utiliser le Bâtonnet de domptage pour dompter une Rôdeuse Tissebois. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Dazalar, à Dolanaar.‡使用驯兽棒驯服树林潜伏者。练习你的技能，然后将驯兽棒还给多兰纳尔的达扎拉。‡使用馴獸棒馴服樹林潛伏者。練習妳的技能，然後將馴獸棒還給多蘭納爾的達紮拉。',
  }
},
[6064] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Rochetusco Grande. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Grif Selvacuore em Kharanos.‡Приручите большого скального вепря с помощью хлыста приручения. Потренируйтесь со своим новым питомцем, а затем верните хлыст приручения Грифу Дикому Сердцу в Каранос.‡Benutzt die Zähmrute, um einen großen Klippeneber zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Grif Wildheart in Kharanos.‡조련용 막대를 사용해 큰 멧돼지를 길들여야 합니다. 기술을 연습한 후 카라노스에 있는 그리프 와일드하트에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de doma para domar a un jabalí del risco grande. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Usa la fusta de doma para domar a un jabalí del risco grande. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Utiliser le Bâtonnet de domptage pour dompter un Grand sanglier des rochers. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Grif Wildheart, à Kharanos.‡使用驯兽棒驯服大型峭壁野猪。练习你的技能，然后将驯兽棒还给卡拉诺斯的格瑞夫。‡使用馴獸棒馴服大型峭壁野豬。練習妳的技能，然後將馴獸棒還給卡拉諾斯的格瑞夫。',
  }
},
[6065] = {
  {
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Fale com Yaw Crina Cortante na Aldeia Casco Sangrento.‡Поговорите с Йо Колкой Гривой в Деревне Кровавого Копыта.‡Sprecht mit Yaw Sharpmane in Bloodhoof.‡블러드후프 마을에 있는 요 샤프메인과 대화해야 합니다.‡Habla con Yaw Trampa en el Poblado Pezuña de Sangre.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre, en Mulgore.‡Parler à Yaw Sharpmane, au village Bloodhoof.‡与血蹄村的雅文·刺鬃谈一谈。‡與血蹄村的雅文·刺鬃談壹談。',
  }
},
