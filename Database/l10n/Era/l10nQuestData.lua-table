[8148] = {
  {
    'A ira da Voragem‡Ярость Водоворота‡Maelstroms Zorn‡혼돈의 소용돌이의 격노‡Cólera de La Vorágine‡Cólera de La Vorágine‡Le courroux du maelström‡漩涡之怒‡漩渦之怒',
