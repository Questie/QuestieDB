[9299] = {
  {
    'Bilhete do front‡Записка с фронта‡Notiz von der Front‡전방에서 온 쪽지‡Una nota del frente‡Una nota del frente‡Une note du front‡潦草的便笺‡潦草的便箋',
    nil,
    'Leve o Bilhete Aflito para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите потертую записку хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die verblichene Notiz zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 근심 가득한 쪽지를 가져가야 합니다.‡Lleva la nota desgastada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la nota desgastada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Note détériorée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将潦草的便笺交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將潦草的便箋交給東瘟疫之地聖光之願禮拜堂的名單登記員。',
  }
},
[9300] = {
  {
    'Página do front‡Страничка с фронта‡Seite von der Front‡전방에서 온 찢어진 페이지‡Una página del frente‡Una página del frente‡Une page du front‡破旧的信‡破舊的信',
    nil,
    'Leve a Página Desalinhada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите разорванную страницу хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die zerfranste Seite zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 찢어진 페이지를 가져가야 합니다.‡Lleva la página desgarrada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la página desgarrada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Page abîmée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将破旧的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將破舊的信交給東瘟疫之地聖光之願禮拜堂的名單登記員。',
  }
},
[9301] = {
  {
    'Envelope do front‡Конверт с фронта‡Umschlag von der Front‡전방에서 온 봉투‡Un sobre del frente‡Un sobre del frente‡Une enveloppe du front‡浸血的信封‡浸血的信封',
    nil,
    'Leve o Envelope Manchado de Sangue para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите конверт, запятнанный кровью, хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den blutbefleckten Umschlag zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 피로 물든 봉투를 가져가야 합니다.‡Lleva el sobre ensangrentado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva el sobre ensangrentado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez l\'Enveloppe tachée de sang au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将浸血的信封交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將浸血的信封交給東瘟疫之地聖光之願禮拜堂的名單登記員。',
  }
},
[9302] = {
  {
    'Missiva do front‡Послание с фронта‡Schreiben von der Front‡전방에서 온 서한‡Una misiva del frente‡Una misiva del frente‡Une missive du front‡被弄皱的信‡被弄皺的信',
    nil,
    'Leve a Missiva Amassada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите смятое послание хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt das zerknitterte Schreiben zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 구겨진 서한을 가져가야 합니다.‡Lleva la misiva arrugada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la misiva arrugada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Missive froissée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将被弄皱的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將被弄皺的信交給東瘟疫之地聖光之願禮拜堂的名單登記員。',
  }
},
[9304] = {
  {
    'Documento do front‡Документ с фронта‡Dokument von der Front‡전방에서 온 문서‡Un documento del frente‡Un documento del frente‡Un document du front‡肮脏的信‡骯臟的信',
    nil,
    'Leve o Documento Borrado para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите испачканный документ хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt das verschmierte Dokument zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 흐릿해진 문서를 가져가야 합니다.‡Lleva el documento manchado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva el documento manchado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le Document taché au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将肮脏的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將骯臟的信交給東瘟疫之地聖光之願禮拜堂的名單登記員。',
  }
},
[9310] = {
  {
    'Cristal necrótico fugaz‡Тусклый некротический кристалл‡Schwacher nekrotischer Kristall‡희미한 죽음의 수정‡Cristal necrótico tenue‡Cristal necrótico tenue‡Cristal nécrotique voilé‡暗淡的死灵水晶‡暗淡的死靈水晶',
    nil,
    'Entregue o Cristal Necrótico Fugaz para o Tenente Rukag na pátio da Cidade Baixa.‡Отнесите тусклый некротический кристалл лейтенанту Рукагу во внутренний двор Подгорода.‡Bringt den schwachen nekrotischen Kristall zu Lieutenant Rukag im Hof von Undercity.‡언더시티의 안마당에 있는 부관 루카그에게 희미한 죽음의 수정을 가져가야 합니다.‡LLeva el cristal necrótico al general Rukag, que está fuera de las puertas de Entrañas.‡Lleva el cristal necrótico al teniente Rukag, que está fuera de las puertas de Entrañas.‡Apportez le Cristal nécrotique voilé au lieutenant Rukag dans la cour de Fossoyeuse.‡将暗淡的死灵水晶交给幽暗城庭院处的卢卡中尉。‡將暗淡的死靈水晶交給幽暗城庭院處的盧卡中尉。',
  }
},
[9317] = {
  {
    'Pedras de afiar consagradas‡Освященное точило‡Geweihte Wetzsteine‡신성한 숫돌‡Piedras de afilar consagradas‡Piedras de afilar consagradas‡Pierre à aiguiser consacrée‡神圣磨刀石‡',
    nil,
    nil,
  }
},
[9318] = {
  {
    'Óleo abençoado de teurgo‡Благословенное волшебное масло‡Gesegnetes Zauberöl‡축복받은 마술사 오일‡Aceite de zahorí bendito‡Aceite de zahorí bendito‡Huile de sorcier bénie‡神圣巫师之油‡受祝福的巫師之油',
