    nil,
  }
},
[6961] = {
  {
    'O Papai Inverno chegou!‡Здравствуй, Дедушка Зима!‡Altvater Winter ist hier!‡겨울 할아버지, 우리 마을에 오셨네!‡¡El Gran Padre Invierno está aquí!‡¡El Gran Padre Invierno está aquí!‡Grand-père Hiver est ici !‡暂无内容‡暫無內容',
    nil,
    'Fale com o Papai Inverno. Ele está perto dos vendedores da Fazenda Bosque Defumado, em Orgrimmar.‡Поговорите с Дедушкой Зимой. Он находится неподалеку от торговца из "Пастбищ Дымного Леса" в Оргриммаре.‡Sprecht mit Altvater Winter. Er befindet sich in der Nähe des Verkaufsbereichs von Kokelwälder in Orgrimmar.‡오그리마에 있는 굴뚝나무 목장조합상인 근처에 있는 겨울 할아버지를 만나 대화해야 합니다.‡Habla con el Gran Padre Invierno. Lo encontrarás cerca de la zona de comercio de los Pastos de Bosquehumeante, en Orgrimmar.‡Habla con el Gran Padre Invierno. Lo encontrarás cerca de la zona de comercio de los Pastos de Bosquehumeante, en Orgrimmar.‡Allez voir Grand-père Hiver. Il se trouve près des Gourmandises Fumebois à Orgrimmar.‡和冬天爷爷谈谈；他在奥格瑞玛Smokywood Pastures商人区旁边。‡和冬天爺爺談談；他在奧格瑞瑪Smokywood Pastures商人區旁邊。',
  }
},
[6962] = {
  {
    'Gostosuras para o Papai Inverno‡Угощение для Дедушки Зимы‡Leckereien für Altvater Winter‡겨울 할아버지 대접하기‡Golosinas para el Gran Padre Invierno‡Golosinas para el Gran Padre Invierno‡Des friandises pour Grand-père Hiver‡冬幕节的礼物‡冬幕節的禮物',
    nil,
    'Leve 5 Biscoitos de Gengibre e um Leite Gelado para o Papai Inverno em Orgrimmar.‡Принесите 5 имбирных пряников и ледяное молоко Дедушке Зиме в Оргриммар.‡Bringt 5 Lebkuchen und etwas eiskalte Milch zu Altvater Winter in Orgrimmar.‡오그리마의 겨울 할아버지에게 생강 과자빵 5개와 시원한 우유 한 잔을 갖다 주어야 합니다.‡Lleva 5 galletas de jengibre y leche fría como el hielo al Gran Padre Invierno en Orgrimmar.‡Lleva 5 galletas de jengibre y leche fría como el hielo al Gran Padre Invierno en Orgrimmar.‡Apporter 5 Biscuits au pain d\'épices et un Verre de lait glacé au Grand-père Hiver, à Orgrimmar.‡将5个小姜饼和一杯冰镇牛奶交给奥格瑞玛的冬天爷爷。‡將5個小姜餅和壹杯冰鎮牛奶交給奧格瑞瑪的冬天爺爺。',
  }
},
[6963] = {
  {
    'O roubo das gostosuras do Véu de Inverno‡Пропавшее угощение Зимнего Покрова‡Gestohlene Winterhauch-Leckereien‡도둑맞은 장난감‡El robo de las golosinas del Festival de Invierno‡El robo de las golosinas del Festival de Invierno‡Friandises volées de la fête du Voile d\'hiver‡被偷走的冬幕节礼物‡被偷走的冬幕節禮物',
    nil,
    'Encontre o investigador da Fazenda Bosque Defumado, que sumiu nas áreas nevadas das Montanhas de Alterac.‡Отыщите агента Пастбищ Дымного Леса, который затерялся в снегах Альтеракских гор.‡Sucht den Ermittler von Kokelwälder, der im Alteracgebirge vermisst wird.‡알터랙 산맥의 어딘가 눈 덮인 지역에서 실종된 굴뚝나무 목장조합의 수색 요원을 찾아야 합니다.‡Encuentra al investigador de los Pastos de Bosquehumeante que ha desaparecido en las regiones nevadas de las Montañas de Alterac.‡Encuentra al investigador de los Pastos de Bosquehumeante que ha desaparecido en las regiones nevadas de las Montañas de Alterac.‡Trouver l\'enquêteur des Gourmandises Fumebois qui est porté disparu dans les montagnes d\'Alterac.‡前往奥特兰克山脉雪域寻找失踪的烟林牧场密探。‡前往奧特蘭克山脈雪域尋找失蹤的煙林牧場密探。',
  }
},
[6964] = {
  {
    'Então é Véu de Inverno‡Повод для праздника‡Der Anlass für die Feiertage‡축제의 유래‡El espíritu de esta fiesta‡El espíritu de esta fiesta‡L\'esprit de cette fête‡冬幕节的意义‡冬幕節的意義',
    nil,
    'Fale com Sagorne Monta Crista no Vale da Sabedoria de Orgrimmar a respeito da Festa do Véu de Inverno.‡Поговорите с Сагорном Гривастым Странником в Аллее Мудрости Оргриммара о празднике Зимнего Покрова.‡Sprecht mit Sagorne Crestrider im Tal der Weisheit von Orgrimmar über das Winterhauchfest.‡오그리마의 지혜의 골짜기에 있는 사고른 크레스트스트라이더와 겨울맞이 축제에 대한 대화를 나누어야 합니다.‡Habla con Sagorne Zanca Cresta en el Valle de la Sabiduría de Orgrimmar sobre el festín del Festival de Invierno.‡Habla con Sagorne Zanca Cresta en el Valle de la Sabiduría de Orgrimmar sobre el festín del Festival de Invierno.‡Parler à Sagorne Crestrider, dans la Vallée de la Sagesse d\'Orgrimmar, au sujet de la fête du Voile d\'hiver.‡与奥格瑞玛智慧谷中的萨格尼谈谈关于冬幕节的情况。‡與奧格瑞瑪智慧谷中的薩格尼談談關於冬幕節的情況。',
  }
},
[6981] = {
  {
    'A lasca faiscante‡Светящийся осколок‡Der leuchtende Splitter‡빛나는 조각‡El fragmento brillante‡El fragmento resplandeciente‡L\'Eclat luminescent‡发光的碎片‡發光的碎片',
    nil,
    'Viaje para a Vila Catraca e procure alguém que possa contar mais alguma coisa sobre a lasca faiscante.|nDepois, entregue a lasca conforme as orientações.‡Отправляйтесь в Кабестан и найдите там кого-нибудь, кто сможет вам рассказать об этом светящемся осколке.|nЗатем отнесите осколок туда, куда вас направят.‡Begebt Euch nach Ratchet, um jemanden zu finden, der Euch mehr über den leuchtenden Splitter sagen kann.|nLiefert dann den Splitter ab, wie Ihr angewiesen wurdet.‡톱니항으로 가서 빛나는 조각에 대해 자세히 얘기해 줄 수 있는 이를 찾으십시오.|n그에게 지시를 받아, 빛나는 조각을 전달해야 합니다.‡Viaja a Trinquete y busca a alguien que pueda decirte algo más sobre el fragmento brillante.|nEntrega el fragmento como se te indique.‡Viaja a Trinquete y busca a alguien que pueda decirte algo más sobre el fragmento resplandeciente.|nEntrega el fragmento como se te indique.‡Allez à Ratchet pour trouver quelqu\'un qui puisse vous en dire plus sur l\'Eclat luminescent.|nPuis livrez l\'Eclat, selon les instructions.‡寻找更多有关这块噩梦碎片的信息。‡尋找更多有關這塊噩夢碎片的信息。',
  }
},
[6982] = {
  {
    'Suprimentos de Dentefrio‡Припасы из рудника Ледяного Зуба‡Coldtooth-Vorräte‡얼음이빨 광산 보급품‡Suministros de Dentefrío‡Suministros de Dentefrío‡Fournitures de Froide-dent‡冷齿矿洞的补给‡冷齒礦洞的補給',
    nil,
    'Leve 10 Suprimentos dos Dentefrio para o Intendente da Aliança em Dun Baldar.‡Принесите 10 ящиков с припасами Ледяного Зуба интенданту Альянса в Дун Болдар.‡Bringt 5 Coldtooth-Vorräte zum Rüstmeister der Allianz in Dun Baldar.‡던 발다르에 있는 얼라이언스 병참장교에게 얼음이빨 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 cajas de suministros de Dentefrío al intendente de la Alianza en Dun Baldar.‡Lleva 10 suministros de Dentefrío al intendente de la Alianza en Dun Baldar.‡Apporter 10 Fournitures de Froide-dent à l\'intendant de l’Alliance, à Dun Baldar.‡把10份冷齿矿洞补给品交给丹巴达尔的联盟军需官。‡把10份冷齒礦洞補給品交給丹巴達爾的聯盟軍需官。',
  }
},
[6983] = {
  {
    'Mau feito um pica-pau‡Прохладное чувство юмора‡So was Gemeines...‡고약한 녀석...‡¡Qué ruin!‡¡Qué ruin!‡La méchanceté vous habite...‡天寒地冻‡天寒地凍',
    nil,
    'Encontre as Gostosuras Roubadas e devolva-as a Polyxopo Pechisbeque, em Orgrimmar. Tudo indica que podem estar com o Abominável Greench, que fica em algum lugar das regiões nevadas das Montanhas de Alterac.‡Отыщите украденные лакомства и верните их Каймарду Меднокнопу в Оргриммар. Лакомства должны быть у Омерзительного Гринча, который бродит где-то среди заснеженных вершин Альтеракских гор.‡Sucht die gestohlenen Leckereien und bringt sie zu Kaymard Copperpinch nach Orgrimmar. Zuletzt befanden sie sich im Besitz des monströsen Griesgrams, der sich in den Schneegebieten der Arathi-Berge befindet.‡도둑맞은 장난감을 찾아 오그리마에 있는 케이말드 코퍼핀치에게 돌려주어야 합니다. 도둑맞은 장난감은 알터랙 산맥의 눈 덮인 지역 어딘가에서 목격된 썩은내 그린치가 마지막으로 가지고 있었던 것 같습니다.‡Encuentra los regalitos robados y devuélveselos a Kaymard Cobrellizco en Orgrimmar. Se cree que están en posesión de Grinch el Abominable, que se encuentra en algún lugar de las regiones nevadas de las Montañas de Alterac.‡Encuentra los dulces robados y devuélveselos a Kaynard Cobrellizco en Orgrimmar. Se cree que por última vez estuvieron en posesión de Grinch el Abominable, en algún lugar de la región nevada de las Montañas de Alterac.‡Localiser les friandises, et les ramener à Kaymard Copperpinch, à Orgrimmar. C\'est l\'abominable Grinche, vivant quelque part dans les régions enneigées des montagnes d\'Alterac, qui les détiendrait.‡寻找被偷走的礼品，把它交还给铁炉堡的凯玛德·考伯宾奇。看起来是格林奇偷走了礼品，他就在奥特兰克山脉雪域附近。‡尋找被偷走的禮品，把它交還給鐵爐堡的凱瑪德·考伯賓奇。看起來是格林奇偷走了禮品，他就在奧特蘭克山脈雪域附近。',
  }
},
[6984] = {
  {
    'Com os agradecimentos da Fazenda Bosque Defumado‡"Пастбища Дымного Леса" благодарны тебе!‡Ein Dankeschön von Kokelwälder!‡굴뚝나무 목장조합의 선물!‡Un agradecimiento de Pastos de Bosquehumeante‡Un agradecimiento de Pastos de Bosquehumeante‡Un grand merci des Gourmandises Fumebois !‡烟林牧场的感谢‡煙林牧場的感謝',
    nil,
    'Fale novamente com o Papai Inverno em Orgrimmar.‡Поговорите с Дедушкой Зимой в Оргриммаре.‡Sprecht mit Altvater Winter in Orgrimmar.‡오그리마의 겨울 할아버지와 대화해야 합니다.‡Habla con el Gran Padre Invierno en Orgrimmar.‡Habla con el Gran Padre Invierno en Orgrimmar.‡Parler à Grand-père Hiver à Orgrimmar.‡和奥格瑞玛的冬天爷爷谈一谈。‡和奧格瑞瑪的冬天爺爺談壹談。',
  }
},
[6985] = {
  {
    'Suprimentos dos Ferrofundo‡Припасы Железного рудника‡Irondeep-Vorräte‡깊은무쇠 광산 보급품‡Suministros de Ferrohondo‡Suministros de Ferrohondo‡Fournitures de Gouffrefer‡深铁矿洞的补给‡深鐵礦洞的補給',
    nil,
    'Leve 10 Suprimentos dos Ferrofundo para o Intendente da Horda na Bastilha Lobo do Gelo.‡Доставьте 10 ящиков припасов Железного рудника интенданту Орды в крепость Северного Волка.‡Bringt 10 Irondeep-Vorräte zum Rüstmeister der Horde in die Burg Frostwolf.‡서리늑대 요새에 있는 서리늑대 병참장교에게 깊은무쇠 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 cajas de suministros de Ferrohondo al intendente de la Horda en el Bastión Lobo Gélido.‡Lleva 10 suministros de Ferrohondo al intendente de la Horda en el Bastión Lobo Gélido.‡Apporter 5 Fournitures de Gouffrefer à l\'Intendant de la Horde, au donjon Frostwolf.‡把10份深铁矿洞补给品交给霜狼要塞的部落军需官。‡把10份深鐵礦洞補給品交給霜狼要塞的部落軍需官。',
  }
},
[7001] = {
  {
    'Estábulos vazios‡Пустые стойла‡Verwaiste Ställe‡빈 우리‡Establos vacíos‡Establos vacíos‡Ecuries vides‡补充坐骑‡補充坐騎',
    nil,
    'Localize um Lobo do Gelo no Vale Alterac. Use a Focinheira de Lobo do Gelo para "domar" a fera. Uma vez domado, o Lobo do Gelo seguirá você até o Mestre dos Estábulos dos Lobo do Gelo. Fale com o Mestre dos Estábulos para conseguir crédito pela captura.‡Найдите северного волка в Альтеракской долине. Подойдите к нему на достаточное расстояние, чтобы его "приручить", и используйте намордник Северного Волка. После приручения северный волк проследует за вами к смотрителю стойл из клана Северного Волка. Поговорите со смотрителем, чтобы получить награду за пойманных волков.‡Findet einen Frostwolf im Alteractal. Wenn Ihr Euch in der Nähe eines Frostwolfs befindet, benutzt den Frostwolfmaulkorb um das Tier einzufangen. Nach erfolgreicher Zähmung, folgt Euch der Frostwolf bis zum Stallmeister zurück. Sprecht mit dem Stallmeister um für Euren Fang belohnt zu werden.‡알터랙 계곡에서 서리늑대를 찾아야 합니다. 발견한 서리늑대 근처에서 서리늑대 재갈을 사용하십시오. 그러면 서리늑대는 당신을 따라다니기 시작할 것입니다. 서리늑대부족 야수관리인에게 돌아가 서리늑대를 포획한 공로를 인정받으십시오.‡Encuentra a un Lobo Gélido en el Valle de Alterac. Usa el collar Lobo Gélido cuando estés junto a él para domarlo. Cuando lo consigas, te seguirá hasta el maestro de establos de los Lobo Gélido. Habla con el maestro de establos para ganarte el crédito por la captura.‡Encuentra a un Lobo Gélido en el Valle de Alterac. Usa el bozal Lobo Gélido cuando estés junto a él para domarlo. Cuando lo consigas, te seguirá hasta el maestro de establos de los Lobo Gélido. Habla con el maestro de establos para ganarte el crédito por la captura.‡Trouvez un Loup des glaces dans la vallée d’Alterac. Servez-vous de la Muselière de loup des glaces pour « dompter » la bête. Lorsque ce sera fait, le loup des glaces vous suivra jusqu’au Maître des écuries Frostwolf. Parlez au Maître des écuries Frostwolf pour être crédité de cette capture.‡找到奥特兰克山谷中的霜狼。使用霜狼口套来驯服它们。被驯服的霜狼会跟随你回到兽栏管理员那里，然后与兽栏管理员谈话以获得你的奖励。‡找到奧特蘭克山谷中的霜狼。使用霜狼口套來馴服它們。被馴服的霜狼會跟隨妳回到獸欄管理員那裏，然後與獸欄管理員談話以獲得妳的獎勵。',
  }
},
[7002] = {
  {
    'Arneses de couro de carneiro‡Упряжь из бараньей кожи‡Widderledernes Zaumzeug‡산양 통가죽 고삐‡Arneses para carneros de montar‡Arneses de pellejo de carnero‡Harnais en cuir de bélier‡羊皮坐具‡羊皮坐具',
    nil,
    nil,
  }
},
[7003] = {
  {
    'Querida, encolhi os gigantes‡Ликвидация великанов‡Geschrumpfte Riesen‡변형된 거인‡Gigantes reducidos‡Gigantes reducidos‡Géants rétrécis‡被缩小的巨人‡被縮小的巨人',
    nil,
    'Use o Ultra-encolhedor de Zorbin para deixar qualquer tipo de gigante de Feralas com um tamanho mais compacto e manejável. Colete 15 Resíduos de Miniaturização encontrados nos gigantes encolhidos e leve para Zorbin Cegasvista, que fica nas docas da Costa Esquecida, em Feralas.‡Используйте ультрасжиматель Зорбина, чтобы уменьшить великанов любого вида, каких вы найдете в Фераласе. Принесите 15 остатков миниатюризации этих великанов Зорбину Дребезгуну в порт Забытого берега в Фераласе.‡Benutzt Zorbins Super-Schrumpfer um jegliche Art von Riesen in Feralas in eine handlichere Form zu schrumpfen. Bringt Zorbin Fandazzle 15 Schrumpf-Überreste von diesen Riesen. Ihr findet Ihn bei den Docks, an der vergessenen Küste in Feralas.‡페랄라스에서 눈에 띄는 아무 거인에게나 조브린의 형상축소기를 사용해 좀 더 다루기 쉬운 형태로 변환하십시오. 페랄라스의 잊혀진 해안 부두에 있는 조브린 팬대즐에게 변형된 거인들에게서 얻을 수 있는 축소화 잔류물 15개를 가져가야 합니다.‡Utiliza el Ultra-reductor de Zorbin para encoger a cualquier gigante que encuentres en Feralas a un tamaño más manejable. Lleva 15 residuos de miniaturización encontrados en las versiones encogidas de los gigantes a Zorbin Ventipnotizador, al embarcadero de La Costa Olvidada de Feralas.‡Utiliza el Ultra-reductor de Zorbin para encoger a cualquier gigante que encuentres en Feralas a un tamaño más manejable. Lleva 15 residuos de miniaturización encontrados en las versiones encogidas de los gigantes a Zorbin Hipnoviento, al embarcadero de La Costa Olvidada de Feralas.‡Utilisez l\'Ultra-réducteur de Zorbin sur des géants de n\'importe quel type en Feralas afin les rendre plus faciles à gérer. Apportez 15 Résidus de miniaturisation que vous trouverez sur les versions rétrécies des géants à Zorbin Fandazzle aux docks de la Côte oubliée en Feralas.‡使用索尔宾的超级压缩器来缩小菲拉斯的任意种类的巨人，将他们缩小到更容易控制的体积。从缩小过的巨人身上收集15份微缩残渣，把它们交给菲拉斯被遗忘的海岸码头的索尔宾·范达瑟。‡使用索爾賓的超級壓縮器來縮小菲拉斯的任意種類的巨人，將他們縮小到更容易控制的體積。從縮小過的巨人身上收集15份微縮殘渣，把它們交給菲拉斯被遺忘的海岸碼頭的索爾賓·範達瑟。',
  }
},
[7021] = {
  {
    'O Papai Inverno chegou!‡Здравствуй, Дедушка Зима!‡Altvater Winter ist hier!‡겨울 할아버지, 우리 마을에 오셨네!‡¡El Gran Padre Invierno está aquí!‡¡El Gran Padre Invierno está aquí!‡Grand-père Hiver est ici !‡冬天爷爷来了！‡冬天爺爺來了！',
    nil,
    'Fale com o Papai Inverno. Ele está perto dos vendedores da Fazenda Bosque Defumado, em Orgrimmar.‡Поговорите с Дедушкой Зимой – он находится рядом с торговцем из Пастбищ Дымного Леса в Оргриммаре.‡Sprecht mit Altvater Winter. Er befindet sich in der Nähe des Verkaufsbereichs von Kokelwälder in Orgrimmar.‡오그리마에 있는 굴뚝나무 목장조합상인 근처에 있는 겨울 할아버지를 만나 대화해야 합니다.‡Habla con el Gran Padre Invierno. Lo encontrarás cerca de la zona de comercio de los Pastos de Bosquehumeante, en Orgrimmar.‡Habla con el Gran Padre Invierno. Lo encontrarás cerca de la zona de comercio de los Pastos de Bosquehumeante, en Orgrimmar.‡Parler à Grand-père Hiver ; il se trouve près des Gourmandises Fumebois, à Orgrimmar.‡跟冬天爷爷谈一谈，他就在奥格瑞玛的烟林牧场零售店附近。‡跟冬天爺爺談壹談，他就在奧格瑞瑪的煙林牧場零售店附近。',
  }
},
[7022] = {
  {
    'O Papai Inverno chegou!‡Здравствуй, Дедушка Зима!‡Altvater Winter ist hier!‡겨울 할아버지, 우리 마을에 오셨네!‡¡El Gran Padre Invierno está aquí!‡¡El Gran Padre Invierno está aquí!‡Grandpère Hiver est ici !‡冬天爷爷来了！‡冬天爺爺來了！',
    nil,
    'Fale com o Papai Inverno, perto dos vendedores da Fazenda Bosque Defumado, em Altaforja.‡Поговорите с Дедушкой Зимой – он находится неподалеку от торговца из Пастбищ Дымного Леса в Стальгорне.‡Sprecht mit Altvater Winter. Er befindet sich in der Nähe des Verkaufsbereichs von Kokelwälder in Ironforge.‡아이언포지의 굴뚝나무 목장조합상인 근처에 있는 겨울 할아버지를 만나 대화해야 합니다.‡Habla con el Gran Padre Invierno. Está cerca de la zona de comercio de los Pastos de Bosquehumeante, en Forjaz.‡Habla con el Gran Padre Invierno. Está cerca de la zona de comercio de los Pastos de Bosquehumeante, en Forjaz.‡Parler à Grandpère Hiver ; il se trouve près des Gourmandises Fumebois, à Ironforge.‡跟冬天爷爷谈一谈，他就在铁炉堡的烟林牧场零售店附近。‡跟冬天爺爺談壹談，他就在鐵爐堡的煙林牧場零售店附近。',
  }
},
[7023] = {
  {
    'O Papai Inverno chegou!‡Здравствуй, Дедушка Зима!‡Altvater Winter ist hier!‡겨울 할아버지, 우리 마을에 오셨네!‡¡Papá Invierno está aquí!‡¡El Gran Padre Invierno está aquí!‡Grandpère Hiver est ici !‡冬天爷爷来了！‡冬天爺爺來了！',
    nil,
    'Fale com o Papai Inverno perto dos vendedores da Fazenda Bosque Defumado, que fica em Altaforja.‡Поговорите с Дедушкой Зимой – он находится неподалеку от торговца из Пастбищ Дымного Леса в Стальгорне.‡Sprecht mit Altvater Winter. Er befindet sich in der Nähe des Verkaufsbereichs von Kokelwälder in Ironforge.‡아이언포지 굴뚝나무 목장조합상인 근처에 있는 겨울 할아버지를 만나 대화해야 합니다.‡Habla con Papá Invierno. Está cerca de la zona de comercio de los Pastos de Bosquehumeante, en Forjaz.‡Habla con el Gran Padre Invierno. Está cerca de la zona de comercio de los Pastos de Bosquehumeante, en Forjaz.‡Parler à Grandpère Hiver ; il se trouve près des Gourmandises Fumebois, à Ironforge.‡跟冬天爷爷谈一谈，他就在铁炉堡的烟林牧场零售店附近。‡跟冬天爺爺談壹談，他就在鐵爐堡的煙林牧場零售店附近。',
  }
},
[7024] = {
  {
    'O Papai Inverno chegou!‡Здравствуй, Дедушка Зима!‡Altvater Winter ist hier!‡겨울 할아버지, 우리 마을에 오셨네!‡¡El Gran Padre Invierno está aquí!‡¡El Gran Padre Invierno está aquí!‡Grand-père Hiver est ici !‡冬天爷爷来了！‡冬天爺爺來了！',
    nil,
    'Fale com o Papai Inverno. Ele está perto dos vendedores da Fazenda Bosque Defumado, em Orgrimmar.‡Поговорите с Дедушкой Зимой. Он находится неподалеку от торговца из Пастбищ Дымного Леса в Оргриммаре.‡Sprecht mit Altvater Winter. Er befindet sich in der Nähe des Verkaufsbereichs von Kokelwälder in Orgrimmar.‡오그리마에 있는 굴뚝나무 목장조합상인 근처에 있는 겨울 할아버지를 만나 대화해야 합니다.‡Habla con el Gran Padre Invierno. Lo encontrarás cerca de la zona de comercio de los Pastos de Bosquehumeante, en Orgrimmar.‡Habla con el Gran Padre Invierno. Lo encontrarás cerca de la zona de comercio de los Pastos de Bosquehumeante, en Orgrimmar.‡Allez voir Grand-père Hiver. Il se trouve près des Gourmandises Fumebois à Orgrimmar.‡跟冬天爷爷谈一谈，他就在奥格瑞玛的烟林牧场零售店附近。‡跟冬天爺爺談壹談，他就在奧格瑞瑪的煙林牧場零售店附近。',
  }
},
[7025] = {
  {
    'Um agrado para o Papai Inverno‡Угощение для Дедушки Зимы‡Leckereien für Altvater Winter‡겨울 할아버지 대접하기‡Golosinas para el Gran Padre Invierno‡Golosinas para el Gran Padre Invierno‡Des friandises pour Grandpère Hiver‡冬幕节的礼物‡冬幕節的禮物',
    nil,
    'Leve 5 Biscoitos de Gengibre e um Leite Gelado para o Papai Inverno em Altaforja.‡Принесите 5 пряников и ледяного молока Дедушке Зиме в Стальгорн.‡Bringt 5 Lebkuchen und etwas eiskalte Milch zu Altvater Winter in Ironforge.‡아이언포지에 있는 겨울 할아버지에게 생강 과자빵 5개와 시원한 우유 한 잔을 갖다 주어야 합니다.‡Lleva 5 galletas de jengibre y leche fría como el hielo al Gran Padre Invierno a Forjaz.‡Lleva 5 galletas de jengibre y leche fría como el hielo al Gran Padre Invierno a Forjaz.‡Apporter 5 Biscuits au pain d\'épices et un verre de Lait glacé au Grandpère Hiver à Ironforge.‡将5个小姜饼和一杯冰镇牛奶交给铁炉堡的冬天爷爷。‡將5個小姜餅和壹杯冰鎮牛奶交給鐵爐堡的冬天爺爺。',
  }
},
[7026] = {
  {
    'Arneses de cavalgar carneiro‡Упряжь ездовых баранов‡Widderzaumzeug‡산양 통가죽 고삐‡Arneses para carneros de montar‡Arneses de pellejo de carnero‡Harnais pour béliers‡山羊坐具‡山羊坐具',
    nil,
    nil,
  }
},
[7027] = {
  {
    'Estábulos vazios‡Пустые стойла‡Verwaiste Ställe‡빈 우리‡Establos vacíos‡Establos vacíos‡Écuries vides‡补充坐骑‡補充坐騎',
    nil,
    'Localize um Carneiro de Alterac, no Vale Alterac. Use a Coleira de Treinamento de Lançatroz no Carneiro de Alterac para "domar" a fera. Uma vez domado, o Carneiro de Alterac seguirá você até o Mestre dos Estábulos. Fale com o Mestre dos Estábulos para conseguir crédito pela captura.‡Найдите в Альтеракской долине альтеракского барана. Чтобы приручить барана, используйте учебный ошейник Грозовой Вершины. Для этого надо подойти в барану поближе. Пойманный баран проследует за вами к смотрителю стойл. Поговорите со смотрителем стойл, чтобы получить вознаграждение за пойманных баранов.‡Findet einen Alteracwidder im Alteractal. Wenn Ihr Euch in der Nähe eines Alteracwidders befindet, benutzt das Stormpike Zähmungshalsband um das Tier einzufangen. Nach erfolgreicher Zähmung, folgt Euch der Alteracwidder bis zum Stallmeister zurück. Sprecht mit dem Stallmeister um für Euren Fang belohnt zu werden.‡알터랙 계곡에 돌아다니는 알터랙 산양을 찾아야 합니다. 알터랙 산양을 찾으면 그 근처에서 스톰파이크 조련용 목줄을 사용해 산양을 길들이십시오. 그러면 야수 관리인에게 돌아갈 때 따라올 것입니다. 알터랙 산양 포획을 인정받기 위해서는 야수 관리인과 대화해야 합니다.‡Encuentra un carnero de Alterac en el Valle de Alterac. Usa la collera de entrenamiento Pico Tormenta cuando estés junto al carnero de Alterac para domarlo. Cuando lo consigas, te seguirá hasta el maestro de establos. Habla con el maestro de establos para ganarte el crédito por la captura.|n‡Encuentra un carnero de Alterac en el Valle de Alterac. Usa la collera de entrenamiento Pico Tormenta cuando estés junto al carnero de Alterac para domarlo. Cuando lo consigas, te seguirá hasta el maestro de establos. Habla con el maestro de establos para ganarte el crédito por la captura.‡Trouvez un Bélier d\'Alterac dans la vallée d\'Alterac. Lorsque vous serez à proximité, servez-vous du Collier d\'entraînement Stormpike pour le "dompter". Une fois dompté, le Bélier d\'Alterac vous suivra jusqu\'au Maître des écuries. Parlez au Maître des écuries pour être crédité de cette capture.‡找到奥特兰克山谷中的山羊。使用雷矛训练颈圈来驯服它们。被驯服的山羊会跟随你回到兽栏管理员那里，然后与兽栏管理员谈话以获得你的奖励。‡找到奧特蘭克山谷中的山羊。使用雷矛訓練頸圈來馴服它們。被馴服的山羊會跟隨妳回到獸欄管理員那裏，然後與獸欄管理員談話以獲得妳的獎勵。',
  }
},
[7028] = {
  {
    'Raízes do mal‡Хрустальные орнаменты‡Dunkles Böses‡뒤틀린 악마‡Los males de Maraudón‡Los males de Maraudon‡Forces maléfiques retorses‡扭曲的邪恶‡扭曲的邪惡',
    nil,
    'Colete 25 Entalhes de Cristal Terádrico para Faia, na Desolação.‡Соберите 25 терадрических хрустальных орнаментов для Ивы из Пустошей.‡Sammelt 25 theradrische Kristallschnitzereien für Willow in Desolace.‡트라드릭 수정 조각상 25개를 모아서 잊혀진 땅에 있는 윌로우에게 가져가야 합니다.‡Recoge 25 tallas de cristal terádrico y llévaselas a Willow a Desolace.‡Recoge 25 tallas de cristal terádrico para Willow en Desolace.‡Collecter 25 Ciselures de Cristaux Théradriques pour Saule, en Désolace.‡为凄凉之地的维洛收集25个瑟莱德丝水晶雕像。‡為淒涼之地的維洛收集25個瑟萊德絲水晶雕像。',
  }
},
[7029] = {
  {
    'A corrupção de Torpelíngua‡Порча Злоязыкого‡Schlangenzunges Verderbnis‡바일텅의 타락‡La corrupción de Lenguavil‡La corrupción de Lenguavil‡La corruption de Vylelangue‡维利塔恩的污染‡維利塔恩的汙染',
    nil,
    'Encha a Ampola Cerúlea Tampada na poça de cristal laranja, em Maraudon.|nUse a Ampola Cerúlea Cheia nos Cipós Caule Torpe para forçar os Rebentos Tóxxicos corrompidos a emergir.|nCure 8 plantas ao matar os Rebentos Tóxxicos, depois fale novamente com Vark Chaga de Guerra, na Aldeia Pescassombra.‡Наполните церуленовый фиал с покрытием в оранжевом пруду Мародона.|nПолейте гнусь-лозу из полного церуленового фиала, выгнав ядовитую лозу.|nИсцелите 8 растений, убивая ядовитые лозы, и вернитесь к Варку Боевому Шраму в Деревню Ночных Охотников.‡Füllt die beschichtete himmelblaue Phiole am orangefarbenen Kristallteich in Maraudon.|nBenutzt die gefüllte himmelblaue Phiole mit den Schlangenstrunkranken, damit der verderbte Noxxious-Spross herausgezwungen wird.|nHeilt 8 Pflanzen, indem Ihr diesen Noxxious-Spross tötet und kehrt dann zu Vark Battlescar in Shadowprey zurück.‡마라우돈에 있는 주황색 수정 웅덩이에서 빈 감청석 약병을 채워야 합니다.|n오염된 녹시온의 후예가 나타나게 하려면 바일줄기 덩굴나무 위에 감청색 약병에 담긴 액체를 부어야 합니다.|n녹시온의 후예를 죽이는 방법으로 8개의 식물을 치료한 다음 그늘수렵 마을에 있는 바르크 배틀스카에게 돌아가야 합니다.‡Llena el vial cerúleo cubierto en el estanque naranja de Maraudon.|nAplica el vial cerúleo lleno a la hiedravil para que emerja el sucesor tóxico.|nCura 8 plantas eliminando su sucesor tóxico e informa a Vark Marca de Guerra en la Aldea Cazasombras.‡Llena el vial cerúleo cubierto en el estanque naranja de Maraudon.|nAplica el vial cerúleo lleno a la hiedravil para que emerja el sucesor tóxico.|nCura 8 plantas eliminando su sucesor tóxico e informa a Vark Marca de Guerra en la Aldea Cazasombras.‡Remplir la Fiole céruléenne renforcée, au Bassin de cristal orange, dans Maraudon.|nEn faire usage sur les Vignes de Vylevrille pour forcer les Engeances de Noxxious corrompues à en sortir.|nSoigner 8 plantes en tuant les Engeances de Noxxious, puis retourner voir Vark Battlescar, à Proie-de-l\'Ombre.‡在玛拉顿里用天蓝水瓶在橙色水晶池中装满水。|n在维利斯塔姆藤蔓上使用装满水的天蓝水瓶，使堕落的诺克赛恩幼体出现。|n治疗8株植物并杀死那些诺克赛恩幼体，然后向葬影村的瓦克·战痕复命。‡在瑪拉頓裏用天藍水瓶在橙色水晶池中裝滿水。|n在維利斯塔姆藤蔓上使用裝滿水的天藍水瓶，使墮落的諾克賽恩幼體出現。|n治療8株植物並殺死那些諾克賽恩幼體，然後向葬影村的瓦克·戰痕復命。',
  }
},
[7041] = {
  {
    'A corrupção de Torpelíngua‡Порча Злоязыкого‡Schlangenzunges Verderbnis‡바일텅의 타락‡La corrupción de Lenguavil‡La corrupción de Lenguavil‡La corruption de Vylelangue‡维利塔恩的污染‡維利塔恩的汙染',
    nil,
    'Encha a Ampola Cerúlea Tampada na poça de cristal laranja, em Maraudon.|nUse a Ampola Cerúlea Cheia nos Cipós Caule Torpe para forçar os Rebentos Tóxxicos corrompidos a emergir.|nCure 8 plantas ao matar os Rebentos Tóxxicos, depois fale novamente com Talendria, no Posto do Nijel.‡Наполните церуленовый фиал с покрытием в оранжевом пруду Мародона.|nПолейте гнусь-лозу из полного церуленового фиала, выгнав ядовитую лозу.|nИсцелите 8 растений, убивая ядовитые лозы, и вернитесь к Талендрии из Высоты Найджела.‡Füllt die beschichtete himmelblaue Phiole am orangefarbenen Kristallteich in Maraudon.|nBenutzt die gefüllte himmelblaue Phiole mit den Schlangenstrunkranken, damit der verderbte Noxxious-Spross herausgezwungen wird.|nHeilt 8 Pflanzen, indem Ihr diesen Noxxious-Spross tötet und kehrt dann zu Talendria an der Nijelspitze zurück.‡마라우돈에 있는 주황색 수정 웅덩이에서 빈 감청석 약병을 채워야 합니다.|n오염된 녹시온의 후예가 나타나게 하려면 바일줄기 덩굴나무 위에 감청색 약병에 담긴 액체를 부어야 합니다.|n녹시온의 후예를 죽이는 방법으로 8개의 식물을 치료한 다음 나이젤의 야영지에 있는 탈렌드리아에게 돌아가야 합니다.‡Llena el vial revestido en el estanque naranja de Maraudon.|nAplica el líquido a la hiedra tallovil para que emerja el vástago tóxico.|nCura 8 plantas eliminando su vástago tóxico e informa a Talendria en Punta de Nijel.‡Llena el vial cerúleo cubierto en el estanque naranja de Maraudon.|nAplica el vial cerúleo lleno a la hiedravil para que emerja el sucesor tóxico.|nCura 8 plantas eliminando su sucesor tóxico e informa a Talendria en Punta de Nijel.‡Remplir la Fiole céruléenne renforcée, au Bassin de cristal orange dans Maraudon.|nEn faire usage sur les vignes de Vylevrille pour forcer les Engeances de Noxxious corrompues à en sortir.|nSoigner 8 plantes en tuant les Engeances, puis retourner voir Taliendra, à la Combe de Nijel.‡在玛拉顿里用天蓝水瓶在橙色水晶池中装满水。|n在维利斯塔姆藤蔓上使用装满水的天蓝水瓶，使堕落的诺克赛恩幼体出现。|n治疗8株植物并杀死那些诺克赛恩幼体，然后向尼耶尔前哨站的塔琳德莉亚复命。‡在瑪拉頓裏用天藍水瓶在橙色水晶池中裝滿水。|n在維利斯塔姆藤蔓上使用裝滿水的天藍水瓶，使墮落的諾克賽恩幼體出現。|n治療8株植物並殺死那些諾克賽恩幼體，然後向尼耶爾前哨站的塔琳德莉亞復命。',
  }
},
[7042] = {
  {
    'O roubo das gostosuras do Véu de Inverno‡Кража угощения Зимнего Покрова‡Gestohlene Winterhauch-Leckereien‡도둑맞은 장난감‡El robo de las golosinas del Festival de Invierno‡El robo de las golosinas del Festival de Invierno‡Friandises volées de la fête du Voile d\'hiver‡被偷走的冬幕节礼物‡被偷走的冬幕節禮物',
    nil,
    'Encontre o investigador da Fazenda Bosque Defumado que sumiu nas áreas nevadas das Montanhas de Alterac.‡Найдите агента Пастбищ Дымного Леса, пропавшего в снежных районах Альтеракских гор.‡Sucht den Ermittler von Kokelwälder, der im Alteracgebirge vermisst wird.‡알터랙 산맥의 어딘가 눈 덮인 지역에서 실종된 굴뚝나무 목장조합의 수색 요원을 찾아야 합니다.‡Encuentra al investigador de los Pastos de Bosquehumeante que ha desaparecido en las regiones nevadas de las Montañas de Alterac.‡Localiza al agente de Pastos de Bosquehumeante desaparecido en las zonas nevadas de las Laderas de Trabalomas.‡Localiser l\'enquêteur des Gourmandises Fumebois qui a été porté disparu dans les montagnes d\'Alterac.‡前往奥特兰克山脉雪域寻找失踪的烟林牧场密探。‡前往奧特蘭克山脈雪域尋找失蹤的煙林牧場密探。',
  }
},
[7043] = {
  {
    'Mau feito um pica-pau‡Прохладное чувство юмора‡So was Gemeines...‡고약한 녀석...‡¡Qué ruin!‡¡Qué ruin!‡La méchanceté vous habite…‡天寒地冻‡天寒地凍',
    nil,
    'Encontre as Gostosuras Roubadas e devolva-as a Wulmort "Dindim" Goubel, em Altaforja. Tudo indica que podem estar com o Abominável Greench, que fica em algum lugar das regiões nevadas das Montanhas de Alterac.‡Отыщите украденные лакомства и верните их Кардену Деньгозвону в Стальгорн. Лакомства должны быть у Омерзительного Гринча, который бродит где-то среди заснеженных вершин Альтеракских гор.‡Sucht die gestohlenen Leckereien und bringt sie zu Wulmort Jinglepocket nach Ironforge. Zuletzt befanden sie sich im Besitz des monströsen Griesgrams, der sich in den Schneegebieten der Arathi-Berge befindet.‡도둑맞은 장난감을 찾아 아이언포지에 있는 훌몰트 징글포켓에게 돌려주어야 합니다. 도둑맞은 장난감은 알터랙 산맥의 눈 덮인 지역 어딘가에서 목격된 썩은내 그린치가 마지막으로 가지고 있었던 것 같습니다.‡Recupera los dulces robados y libera a Metzen el Reno después de derrotar a Grinch el Abominable, que se esconde cerca de la Caverna Estrecha en las Laderas de Trabalomas.‡Recupera los dulces robados y libera a Metzen el Reno después de derrotar a Grinch el Abominable, que se esconde cerca de la Caverna Estrecha en las Laderas de Trabalomas.‡Trouver les Friandises volées, et les ramener à Wumort Jinglepocket, à Ironforge. C\'est l\'Abominable Grinche qui aurait le chargement en sa possession, il résiderait dans les régions neigeuses des montagnes d\'Alterac.‡寻找被偷走的礼品，把它交还给铁炉堡的乌莫尔特。看起来是格林奇偷走了礼品，他就在奥特兰克山脉雪域附近。‡尋找被偷走的禮品，把它交還給鐵爐堡的烏莫爾特。看起來是格林奇偷走了禮品，他就在奧特蘭克山脈雪域附近。',
  }
},
[7044] = {
  {
    'Lendas de Maraudon‡Легенды Мародона‡Legenden von Maraudon‡마라우돈의 전설‡Leyendas de Maraudón‡Leyendas de Maraudon‡Légendes de Maraudon‡玛拉顿的传说‡瑪拉頓的傳說',
    nil,
    'Recupere as duas partes do Cetro de Celebras: o Bastão de Celebras e o Diamante de Celebras.|nEncontre um jeito de falar com Celebras.‡Добудьте две части скипетра Келебраса – жезл Келебраса и бриллиант Келебраса.|nНайдите способ поговорить с Келебрасом.‡Beschafft die beiden Teile des Szepters von Celebras: den Celebriangriff und den Celebriandiamanten.|nFindet einen Weg, um mit Celebras zu sprechen.‡셀레브라스의 홀 조각인 셀레브리안 마법봉과 셀레브리안 다이아몬드를 찾아야 합니다.|n셀레브라스와 대화를 나눌 방법을 찾아야 합니다.‡Recupera las 2 partes del Cetro de Celebras: la vara y el diamante Celebrian.|nEncuentra el modo de hablar con Celebras.‡Recupera las 2 partes del cetro de Celebras: la vara y el diamante de Celebras.|nEncuentra el modo de hablar con Celebras.‡Retrouver les deux parties du Sceptre de Celebras : le Bâtonnet de Celebras et le Diamant de Celebras.|nTrouvez un moyen de parler à Celebras.‡找回塞雷布拉斯节杖的两个部分：塞雷布拉斯魔棒和塞雷布拉斯钻石。|n然后设法和塞雷布拉斯对话。‡找回塞雷布拉斯節杖的兩個部分：塞雷布拉斯魔棒和塞雷布拉斯鉆石。|n然後設法和塞雷布拉斯對話。',
  }
},
[7045] = {
  {
    'Com os agradecimentos da Fazenda Bosque Defumado‡Пастбища Дымного Леса благодарят тебя!‡Ein Dankeschön von Kokelwälder!‡굴뚝나무 목장조합의 선물!‡Un agradecimiento de Pastos de Bosquehumeante‡Un agradecimiento de Pastos de Bosquehumeante‡Un grand merci des Gourmandises Fumebois !‡烟林牧场的感谢‡煙林牧場的感謝',
    nil,
    'Fale com o Papai Inverno em Altaforja.‡Поговорите с Дедушкой Зимой в Стальгорне.‡Sprecht mit Altvater Winter in Ironforge.‡아이언포지의 겨울 할아버지와 대화를 해야 합니다.‡Habla con el Gran Padre Invierno en Forjaz.‡Habla con el Gran Padre Invierno en Forjaz.‡Parler à Grandpère Hiver à Ironforge.‡和铁炉堡的冬天爷爷谈一谈。‡和鐵爐堡的冬天爺爺談壹談。',
  }
},
[7046] = {
  {
    'O Cetro de Celebras‡Скипетр Келебраса‡Das Szepter von Celebras‡셀레브라스의 홀‡El cetro de Celebras‡El cetro de Celebras‡Le sceptre de Celebras‡塞雷布拉斯节杖‡塞雷布拉斯節杖',
    nil,
    'Ajude Celebras, o Redimido, a criar o Cetro de Celebras.|nFale com ele quando o ritual estiver concluído.‡Помогите Селебрасу Искупленному воссоздать скипетр Селебраса.|nПо завершении ритуала снова обратитесь к нему.‡Helft Celebras dem Erlösten, während er das Szepter von Celebras herstellt.|nSprecht mit ihm, nachdem das Ritual vollendet ist.‡회복된 셀레브라스가 셀레브라스의 홀을 만드는 동안 그를 도와야 합니다.|n의식을 마친 후 그와 대화하십시오.‡Ayuda a Celebras el Redimido mientras reconstruye el cetro de Celebras.|nHabla con él después del ritual.‡Ayuda a Celebras el Redimido mientras reconstruye el cetro de Celebras.|nHabla con él después del ritual.‡Aidez Celebras le Racheté pendant qu\'il recrée le Sceptre de Celebras.|nParlez-lui après la réussite du rituel.‡帮助赎罪的塞雷布拉斯制作塞雷布拉斯节杖。|n当仪式完成之后再和他谈谈。‡幫助贖罪的塞雷布拉斯制作塞雷布拉斯節杖。|n當儀式完成之後再和他談談。',
  }
},
[7061] = {
  {
    'A Festa do Véu de Inverno‡Праздник Зимнего Покрова‡Das Winterhauchfest‡겨울맞이 축제‡El festín del Festival de Invierno‡El festín del Festival de Invierno‡La fête du Voile d\'hiver‡冬幕节‡冬幕節',
    nil,
    'Se quiser, leia o livro "A Festa do Véu de Inverno" para saber mais sobre a celebração. Quando terminar de ler, entregue-o para Caerne Casco Sangrento no Penhasco do Trovão.‡Прочитайте книгу "Праздник Зимнего Покрова". Отнесите книгу Кэрну Кровавому Копыту в Громовой Утес.‡Ihr könnt gern das Buch \'Das Winterhauchfest\' lesen, um mehr über diesen Feiertag zu erfahren. Wenn Ihr das Buch gelesen habt, bringt es zu Cairne Bloodhoof in Thunder Bluff.‡겨울맞이 축제를 읽고 축제의 의미에 대해 좀 더 알아보십시오. 책을 다 읽은 후 썬더 블러프에 있는 케른 블러드후프에게 가져가야 합니다.‡Lee el libro "El festín del Festival de Invierno" si quieres saber más sobre esta fiesta. Cuando termines, entrégaselo a Baine Pezuña de Sangre en Cima del Trueno.‡Lee el libro "El festín del Festival de Invierno" si quieres saber más sobre esta fiesta. Cuando termines, entrégaselo a Baine Pezuña de Sangre en Cima del Trueno.‡Prenez le temps de lire ce livre, "La fête du Voile d\'hiver", pour en apprendre plus sur cette période de fête. Quand vous en aurez fini avec le livre, apportez-le à Cairne Bloodhoof, dans la ville de Thunder Bluff.‡阅读《冬幕节》学习更多关于该节日的知识。当你读完后，将书交给雷霆崖的凯恩·血蹄。‡閱讀《冬幕節》學習更多關於該節日的知識。當妳讀完後，將書交給雷霆崖的凱恩·血蹄。',
  }
},
[7062] = {
  {
    'Então é Véu de Inverno‡Повод для праздника‡Der Anlass für die Feiertage‡축제의 유래‡El espíritu de esta fiesta‡El espíritu de esta fiesta‡L\'esprit de cette fête‡冬幕节的意义‡冬幕節的意義',
    nil,
    'Fale com o Historiador Karnik na Liga dos Exploradores, em Altaforja, sobre a Festa do Véu de Inverno.‡Поговорите с историком Карником в лиге Исследователей в Стальгорне о празднике Зимнего Покрова.‡Sprecht mit dem Historiker Karnik in der Forscherliga von Ironforge über das Winterhauchfest.‡아이언포지에 있는 탐험가 조합의 역사학자 카르닉과 겨울맞이 축제에 대한 대화를 나누어야 합니다.‡Habla con el historiador Karnik del Festival de Invierno en la Liga de Exploradores de Forjaz.‡Habla con Karnik el Historiador sobre el festín del Festival de Invierno en la Liga de Expedicionarios de Forjaz.‡Parlez à l\'historien Karnik de la fête du Voile d\'hiver, en vous rendant à la Ligue des Explorateurs d\'Ironforge.‡与铁炉堡探险者协会的史学家卡尼克谈谈关于冬幕节的情况。‡與鐵爐堡探險者協會的史學家卡尼克談談關於冬幕節的情況。',
  }
},
[7063] = {
  {
    'A Festa do Véu de Inverno‡Праздник Зимнего Покрова‡Das Winterhauchfest‡겨울맞이 축제‡El festín del Festival de Invierno‡El festín del Festival de Invierno‡La fête du Voile d\'hiver‡冬幕节‡冬幕節',
    nil,
    'Se quiser, leia o livro "A Festa do Véu de Inverno" para saber mais sobre a celebração. Quando terminar de ler, entregue-o para o Rei Magni Barbabronze em Altaforja.‡Прочтите книгу "Праздник Зимнего Покрова", узнайте побольше о происхождении праздника. Закончив читать книгу, отнесите ее королю Магни Бронзобороду в Стальгорн.‡Ihr könnt gern das Buch \'Das Winterhauchfest\' lesen, um mehr über diesen Feiertag zu erfahren. Wenn Ihr das Buch gelesen habt, dann bringt es zu König Magni Bronzebeard nach Ironforge.‡겨울맞이 축제를 읽고 그 유래와 의미에 대해 좀 더 알아보십시오. 책을 다 읽은 후 아이언포지에 있는 국왕 마그니 브론즈비어드에게 가져가야 합니다.‡Lee el libro "El festín del Festival de Invierno" si quieres saber más sobre esta fiesta. Cuando termines, entrégaselo al rey Magni Barbabronce de Forjaz.‡Lee el libro "El festín del Festival de Invierno" si quieres saber más sobre esta fiesta. Cuando termines, entrégaselo al rey Magni Barbabronce de Forjaz.‡Prenez le temps de lire le livre « La fête du Voile d\'hiver » pour en apprendre plus sur cette période sainte. Quand vous en aurez fini avec le livre, apportez-le à Muradin Barbe-de-Bronze, à Forgefer.‡阅读《冬幕节》学习更多关于该节日的知识。当你读完后，将书交给铁炉堡国王麦格尼·铜须。‡閱讀《冬幕節》學習更多關於該節日的知識。當妳讀完後，將書交給鐵爐堡國王麥格尼·銅須。',
  }
},
[7064] = {
  {
    'Corrupção da terra e dos grãos‡Яблочко от яблоньки...‡Verderbnis von Erde und Samenkorn‡대지와 씨앗의 오염‡Corrupción de la tierra y de la semilla‡Corrupción de la tierra y de la semilla‡Corruption de la terre et de la graine‡大地的污染‡大地的汙染',
    nil,
    'Mate a Princesa Theradras e fale novamente com Selendra perto da Aldeia Pescassombra, na Desolação.‡Убейте принцессу Терадрас и вернитесь к Селендре неподалеку от Деревни Ночных Охотников в Пустошах.‡Tötet Prinzessin Theradras und kehrt zu Selendra in der Nähe von Shadowprey in Desolace zurück.‡공주 테라드라스를 해치우고 잊혀진 땅의 그늘수렵 마을 근처에 있는 셀렌드라에게 돌아가야 합니다.‡Mata a la princesa Theradras y ve a ver a Selendra cerca de la Aldea Cazasombras, en Desolace.‡Mata a la princesa Theradras y ve a ver a Selendra cerca de la Aldea Cazasombras, en Desolace.‡Anéantir la princesse Theradras et retourner voir Selendra près de Proie-de-l\'Ombre, en Désolace.‡杀死瑟莱德丝公主，然后回到凄凉之地葬影村附近的瑟琳德拉那里复命。‡殺死瑟萊德絲公主，然後回到淒涼之地葬影村附近的瑟琳德拉那裏復命。',
  }
},
[7065] = {
  {
    'Corrupção da terra e dos grãos‡Яблочко от яблоньки...‡Verderbnis von Erde und Samenkorn‡대지와 씨앗의 오염‡Corrupción de la tierra y de la semilla‡Corrupción de la tierra y de la semilla‡Corruption de la terre et de la Graine‡大地的污染‡大地的汙染',
    nil,
    'Mate a Princesa Theradras e fale novamente com o Guardião Marandis no Posto do Nijel, na Desolação.‡Убейте принцессу Терадрас и вернитесь к хранителю Марандису на Высоту Найджела в Пустоши.‡Erschlagt Prinzessin Theradras und kehrt zum Bewahrer Marandis an der Nijelspitze in Desolace zurück.‡공주 테라드라스를 해치우고 잊혀진 땅의 나이젤의 야영지에 있는 수호자 마란디스를 찾아가야 합니다.‡Mata a la princesa Theradras y ve a ver al guardián Marandis a Punta de Nijel, en Desolace.‡Mata a la princesa Theradras y ve a ver al vigilante Marandis a Punta de Nijel, en Desolace.‡Tuer la princesse Theradras, et retourner voir le Gardien Marandis, à la Combe de Nijel en Désolace.‡杀死瑟莱德丝公主，然后回到凄凉之地尼耶尔前哨站的守护者玛兰迪斯那里复命。‡殺死瑟萊德絲公主，然後回到淒涼之地尼耶爾前哨站的守護者瑪蘭迪斯那裏復命。',
  }
},
[7066] = {
  {
    'A semente da vida‡Семя Жизни‡Samenkorn des Lebens‡생명의 씨앗‡La semilla de la vida‡La semilla de vida‡Graine de vie‡生命之种‡生命之種',
    nil,
    'Procure Remulos, na Clareira da Lua, e entregue a ele a Semente da Vida.‡Найдите в Лунной поляне Ремулоса и отдайте ему Семя Жизни.‡Sucht Remulos in Moonglade auf und gebt ihm das Samenkorn des Lebens.‡달의 숲에 있는 수호자 레물로스를 찾아 생명의 씨앗을 전해 주어야 합니다.‡Busca a Remulos en Claro de la Luna y dale la semilla de la vida.‡Busca a Remulos en Claro de la Luna y dale la semilla de vida.‡Chercher Remulos à Reflet-de-Lune, et lui donner la Graine de vie.‡到月光林地去找到雷姆洛斯，将生命之种交给他。‡到月光林地去找到雷姆洛斯，將生命之種交給他。',
  }
},
[7067] = {
  {
    'As instruções do pária‡Инструкции кентавра-парии‡Die Anweisungen des Pariahs‡추방자의 지시서‡Las instrucciones del Paria‡Las instrucciones del Paria‡Les instructions du paria‡贱民的指引‡賤民的指引',
    nil,
    'Leia as Instruções do Pária. Depois, obtenha em Maraudon o Amuleto da União e devolva-o ao Centauro Pária, na parte sul de Desolação.‡Прочтите инструкции кентавра-парии, добудьте из Мародона амулет Соединения и верните его кентавру-парии из южной части Пустошей.‡Lest die Anweisungen des Pariahs. Beschafft Euch danach das Amulett der Vereinigung von Maraudon und bringt es dem Zentaurenpariah im südlichen Desolace.‡추방자의 지시서를 읽은 다음 마라우돈에서 결속의 아뮬렛을 획득해서 잊혀진 땅 남부에 있는 켄타우로스 추방자에게 가져가야 합니다.‡Lee las instrucciones del Paria. Busca el Amuleto de Unidad en Maraudon y llévaselo al sur de Desolace.‡Lee las instrucciones del Paria. Busca el Amuleto de Unidad en Maraudon y llévaselo al sur de Desolace.‡Lire les instructions du paria. Après cela, obtenir l\'Amulette d\'union de Maraudon et la ramener au centaure renégat, dans le sud de Désolace.‡阅读贱民的指引，然后从玛拉顿得到联合坠饰，将其交给凄凉之地南部的半人马贱民。‡閱讀賤民的指引，然後從瑪拉頓得到聯合墜飾，將其交給淒涼之地南部的半人馬賤民。',
  }
},
[7068] = {
  {
    'Fragmentos de lascanegra‡Фрагменты осколка сумрака‡Schattensplitter‡음영석 조각‡Fragmentos Oscuros‡Trozos Oscuros‡Fragments d\'Ombréclat‡暗影残片‡暗影殘片',
    nil,
    'Colete 10 Fragmentos de Lascanegra em Maraudon e leve-os para Uthel\'nay, em Orgrimmar.‡Соберите в Мародоне 10 фрагментов осколков сумрака и отнесите их Утель\'наю в Оргриммар.‡Sammelt 10 Schattensplitter aus Maraudon und bringt sie zu Uthel\'nay nach Orgrimmar.‡마라우돈에서 음영석 조각 10개를 모아서 오그리마에 있는 우텔나이에게 가져가야 합니다.‡Recoge 10 fragmentos oscuros en Maraudon y llévaselos a Uthel\'nay a Orgrimmar.‡Recoge 10 fragmentos oscuros en Maraudon y llévaselos a Uthel\'nay a Orgrimmar.‡Collecter 10 Fragments d\'Ombréclats dans Maraudon, et les ramener à Uthel\'nay, à Orgrimmar.‡从玛拉顿收集10块暗影残片，然后把它们交给奥格瑞玛的尤塞尔奈。‡從瑪拉頓收集10塊暗影殘片，然後把它們交給奧格瑞瑪的尤塞爾奈。',
  }
},
[7069] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    nil,
  }
},
[7070] = {
  {
    'Fragmentos de lascanegra‡Фрагменты осколка сумрака‡Schattensplitter‡음영석 조각‡Fragmentos Oscuros‡Trozos Oscuros‡Fragments d\'Ombréclat‡暗影残片‡暗影殘片',
    nil,
    'Colete 10 Fragmentos de Lascanegra em Maraudon e leve-os para o Arquimago Tervosh, em Theramore, na costa do Pântano Vadeoso.‡Соберите в Мародоне 10 фрагментов осколков сумрака и отнесите их верховному магу Тервошу в Терамор на побережье Пылевых топей.‡Sammelt 10 Schattensplitter in Maraudon und bringt sie zu Erzmagier Tervosh in den Marschen von Dustwallow.‡마라우돈에서 음영석 조각 10개를 모아서 먼지진흙 습지대의 해안에 위치한 테라모어에 있는 대마법사 테르보쉬에게 가져가야 합니다.‡Recoge 10 fragmentos oscuros en Maraudon y llévaselos al archimago Tervosh a Theramore, en la costa de Marjal Revolcafango.‡Recoge 10 fragmentos oscuros en Maraudon y llévaselos al archimago Tervosh a Theramore, en la costa de Marjal Revolcafango.‡Collecter 10 Fragments d\'Ombréclats, et les porter à l\'archimage Tervosh, dans le marécage d\'Âprefange.‡从玛拉顿收集10块暗影残片，然后把它们交给尘泥沼泽塞拉摩岛上的大法师特沃什。‡從瑪拉頓收集10塊暗影殘片，然後把它們交給塵泥沼澤塞拉摩島上的大法師特沃什。',
  }
},
[7081] = {
  {
    'Cemitérios do Vale Alterac‡Кладбища Альтеракской долины‡Die Friedhöfe im Alteractal‡알터랙 계곡의 무덤‡Los cementerios del Valle de Alterac‡Los cementerios del Valle de Alterac‡Les cimetières de la vallée d\'Alterac‡奥特兰克山谷的墓地‡奧特蘭克山谷的墓地',
    nil,
    'Ataque um cemitério e, então, apresente-se ao Sargento Durgen Lançatroz nas Montanhas de Alterac.‡Захватите кладбище, затем возвращайтесь к сержанту Даргену Грозовой Вершине в Альтеракские горы.‡Erobert einen Friedhof und kehrt zu Sergeant Durgen Stormpike im Alteracgebirge zurück.‡호드의 무덤을 공격한 다음 알터랙 산맥에 있는 하사관 두르겐 스톰파이크에게 돌아가야 합니다.‡Asalta un cementerio y vuelve con el sargento Durgen Pico Tormenta en las Montañas de Alterac.‡Asalta un cementerio y vuelve con el sargento Durgen Pico Tormenta en las Montañas de Alterac.‡Attaquez un cimetière, puis présentez-vous au caporal Noreg Stormpike à Dun Baldar.‡占领一座墓地，然后向丹巴达尔的诺雷格·雷矛中尉复命。‡占領壹座墓地，然後向丹巴達爾的諾雷格·雷矛中尉復命。',
  }
},
[7082] = {
  {
    'Os cemitérios de Alterac‡Кладбища долины Альтерака‡Die Friedhöfe von Alterac‡알터랙 계곡의 무덤‡Los cementerios de Alterac‡Los cementerios de Alterac‡Les cimetières d\'Alterac‡奥特兰克的墓地‡奧特蘭克的墓地',
    nil,
    'Ataque um cemitério e depois apresente-se à Cabo Tika Rosnassangue nas Montanhas de Alterac.‡Захватите кладбище, затем возвращайтесь к капралу Тике Кровавому Рыку в Альтеракские горы.‡Erobert einen Friedhof und kehrt zu Corporal Teeka Bloodsnarl im Alteracgebirge zurück.‡얼라이언스가 점령하고 있는 무덤을 공격한 다음 알터랙 산맥에 있는 하사관 티카 블러드스날에게 돌아가야 합니다.‡Asalta un cementerio y vuelve con el cabo Teeka Gruñido Sangriento en las Montañas de Alterac.‡Asalta un cementerio y vuelve con el cabo Teeka Gruñido Sangriento en las Montañas de Alterac.‡Attaquez un cimetière, puis présentez-vous au caporal Teeka Bloodsnarl dans les montagnes d\'Alterac.‡占领一座墓地，然后向霜狼村的亚斯拉复命。‡占領壹座墓地，然後向霜狼村的亞斯拉復命。',
  }
},
[7101] = {
  {
    'Torres e Casamatas‡Башни и бункеры‡Türme und Bunker‡보초탑과 참호‡Las torres y los búnkeres‡Las torres y los búnkeres‡Tours et fortins‡哨塔和碉堡‡哨塔和碉堡',
    nil,
    'Capture uma casamata inimiga e então apresente-se à Cabo Tika Rosnassangue nas Montanhas de Alterac.‡Захватите башню врага и возвращайтесь к капралу Тике Кровавому Рыку в Альтеракские горы.‡Erobert einen gegnerischen Turm und kehrt anschließend zu Corporal Teeka Bloodsnarl in Frostwolf zurück.‡적군의 보초탑을 점령한 다음 알터랙 산맥에 있는 하사관 티카 블러드스날에게 돌아가야 합니다.‡Captura una torre enemiga y vuelve con el cabo Teeka Gruñido Sangriento en las Montañas de Alterac.‡Captura una torre enemiga y vuelve con el cabo Teeka Gruñido Sangriento en las Montañas de Alterac.‡Prenez une tour ennemie, puis présentez-vous au caporal Teeka Bloodsnarl dans les montagnes d\'Alterac.‡占领敌方的某座哨塔，然后向霜狼村的提卡·血牙复命。‡占領敵方的某座哨塔，然後向霜狼村的提卡·血牙復命。',
  }
},
[7102] = {
  {
    'Torres e Casamatas‡Башни и бункеры‡Türme und Bunker‡보초탑과 참호‡Las torres y los búnkeres‡Las torres y los búnkeres‡Tours et fortins‡哨塔和碉堡‡哨塔和碉堡',
    nil,
    'Destrua o estandarte em uma torre ou casamata inimiga, e então fale novamente com o Sargento Durgen Lançatroz nas Montanhas de Alterac.‡Уничтожьте вымпел на вражеской башне или бункере и возвращайтесь к сержанту Даргену Грозовой Вершине в Альтеракские горы.‡Zerstört das Banner im Inneren eines gegnerischen Bunkers oder Turms. Kehrt anschließend zu Sergeant Durgen Stormpike im Alteracgebirge zurück.‡적군의 보초탑이나 참호에 있는 깃발을 파괴한 후 알터랙 산맥에 있는 하사관 두르겐 스톰파이크에게 돌아가야 합니다.‡Destruye el estandarte de una torre enemiga o de un búnker y vuelve junto al sargento Durgen Pico Tormenta en las Montañas de Alterac.‡Destruye el estandarte de una torre enemiga o de un búnker y vuelve junto al sargento Durgen Pico Tormenta en las Montañas de Alterac.‡Détruisez la bannière d\'une tour ou d\'un fortin ennemi, puis présentez-vous au sergent Durgen Stormpike à Dun Baldar.‡摧毁敌方的某座哨塔或者碉堡中的旗帜，然后向丹巴达尔的杜尔根·雷矛复命。‡摧毀敵方的某座哨塔或者碉堡中的旗幟，然後向丹巴達爾的杜爾根·雷矛復命。',
  }
},
[7121] = {
  {
    'O Intendente‡Интендант‡Der Rüstmeister‡병참장교‡El intendente‡El intendente‡L\'intendant‡军需官‡軍需官',
    nil,
    'Fale com o Intendente dos Lançatroz.‡Поговорите с интендантом клана Грозовой Вершины.‡Sprecht mit dem Rüstmeister der Stormpike.‡스톰파이크 병참장교와 대화해야 합니다.‡Habla con el intendente de Pico Tormenta.‡Habla con el intendente Pico Tormenta.‡Parlez à l’Intendant Stormpike.‡与雷矛军需管谈一谈。‡與雷矛軍需管談壹談。',
  }
},
[7122] = {
  {
    'Capture uma mina‡Захват рудника‡Mine besetzen‡광산 점령‡Conquistar una mina‡Capturar una mina‡Prendre une mine‡占领矿洞‡占領礦洞',
    nil,
    'Capture uma mina não controlada pelos Lançatroz e, a seguir, apresente-se ao Sargento Durgen Lançatroz nas Montanhas de Alterac.‡Захватите рудник, который не принадлежит Грозовой Вершине, и возвращайтесь к сержанту Даргену Грозовой Вершине в Альтеракские горы.‡Erobert eine Mine, die die Stormpike noch nicht kontrollieren, und kehrt dann zu Sergeant Durgen Stormpike im Alteracgebirge zurück.‡스톰파이크 경비대가 점령하지 않은 광산을 점령한 후 알터랙 산맥에 있는 하사관 두르겐 스톰파이크에게 돌아가야 합니다.‡Captura una mina que no esté bajo control de los Pico Tormenta y vuelve junto al sargento Durgen Pico Tormenta en las Montañas de Alterac.‡Captura una mina que no esté bajo control de los Pico Tormenta y vuelve junto al sargento Durgen Pico Tormenta en las Montañas de Alterac.‡Prenez une mine que les Stormpike ne contrôlent pas, puis présentez-vous à l’intendant Stormpike à Dun Baldar.‡占领一座还没有被雷矛部族控制的矿洞，然后向丹巴达尔的雷矛军需官复命。‡占領壹座還沒有被雷矛部族控制的礦洞，然後向丹巴達爾的雷矛軍需官復命。',
  }
},
[7123] = {
  {
    'Fale com nosso Intendente‡Разговор с интендантом‡Sprecht mit unserem Rüstmeister‡병참장교와의 대화‡Habla con nuestro intendente‡Habla con nuestro intendente‡Parlez à notre Intendant‡霜狼军需官‡霜狼軍需官',
    nil,
    'Fale com o Intendente dos Lobo do Gelo.‡Поговорите с интендантом клана Северного Волка.‡Sprecht mit dem Rüstmeister der Frostwolf.‡서리늑대 병참장교와 대화하십시오.‡Habla con el intendente de Lobo Gélido.‡Habla con el intendente de Lobo Gélido.‡Parlez à l’Intendant Frostwolf.‡与霜狼军需官谈一谈。‡與霜狼軍需官談壹談。',
  }
},
[7124] = {
  {
    'Capture uma mina‡Захват рудника‡Eine Mine besetzen‡광산 점령‡Conquistar una mina‡Capturar una mina‡Prendre une mine‡占领矿洞‡占領礦洞',
    nil,
    'Capture uma mina e, a seguir, apresente-se à Cabo Tika Rosnassangue nas Montanhas de Alterac.‡Захватите рудник и возвращайтесь к капралу Тике Кровавому Рыку в Альтеракские горы.‡Erobert eine Mine und kehrt zu Corporal Teeka Bloodsnarl im Alteracgebirge zurück.‡광산 하나를 점령한 후 알터랙 산맥에 있는 하사관 티카 블러드스날에게 돌아가야 합니다.‡Captura una mina y vuelve con el cabo Teeka Gruñidosangriento en las Montañas de Alterac.‡Captura una mina y vuelve con el cabo Teeka Gruñido Sangriento en las Montañas de Alterac.‡Prenez une mine, puis présentez-vous au caporal Teeka Bloodsnarl dans les montagnes d\'Alterac.‡占领一座矿洞，然后向霜狼村的霜狼军需官报告。‡占領壹座礦洞，然後向霜狼村的霜狼軍需官報告。',
  }
},
[7141] = {
  {
    'A Batalha de Alterac‡Битва за Альтерак‡Die Schlacht um Alterac‡알터랙의 전투‡La batalla de Alterac‡La batalla de Alterac‡La bataille d\'Alterac‡奥特兰克的战斗‡奧特蘭克的戰鬥',
    nil,
    'Siga para o Vale Alterac, derrote Drek\'thar, o general da Horda, e volte a falar com o Prospector Entalharrocha nas Montanhas de Alterac.‡Отправляйтесь в Альтеракскую долину, сразитесь с генералом Орды Дрек\'Таром и возвращайтесь к проспектору Камнетерке в Альтеракские горы.‡Betretet das Alteractal, bezwingt den Hordegeneral Drek\'thar und kehrt dann zu Ausgrabungsleiter Stonehewer im Alteracgebirge zurück.‡알터랙 계곡으로 진입하여 호드 사령관인 드렉타르를 처치하고, 알터랙 산맥에 있는 발굴조사단장 스톤휴어에게 돌아가야 합니다.‡Adéntrate en el Valle de Alterac, derrota al general Drek\'thar de la Horda y vuelve junto a la prospectora Tallapiedra en las Montañas de Alterac.‡Adéntrate en el Valle de Alterac, derrota al general Drek\'thar de la Horda y vuelve junto a la prospectora Tallapiedra en las Montañas de Alterac.‡Entrez dans la vallée d\'Alterac, tuez Drek\'thar, le général de la Horde, puis retournez voir la Prospectrice Stonehewer dans les montagnes d\'Alterac.‡进入奥特兰克山谷，击败部落将军德雷克塔尔。然后回到勘查员塔雷·石镐那里。‡進入奧特蘭克山谷，擊敗部落將軍德雷克塔爾。然後回到勘查員塔雷·石鎬那裏。',
  }
},
[7142] = {
  {
    'A Batalha por Alterac‡Битва за Альтерак‡Die Schlacht um Alterac‡알터랙의 전투‡La batalla por Alterac‡La batalla por Alterac‡La bataille pour Alterac‡为奥特兰克而战‡為奧特蘭克而戰',
    nil,
    'Siga para o Vale Alterac, derrote Vanndar Lançatroz, o general anão, e fale novamente com Voggah Garramort, nas Montanhas de Alterac.‡Отправляйтесь в Альтеракскую долину и убейте генерала дворфов, Вандара Грозовую Вершину. После этого возвращайтесь к Вогге Смертной Хватке в Альтеракские горы.‡Betretet das Alteractal und bezwingt den Zwergengeneral, Vanndar Stormpike. Kehrt anschließend zu Voggah Deathgrip im Alteracgebirge zurück.‡알터랙 계곡으로 진입하여 얼라이언스 사령관인 반다르 스톰파이크를 처치하고, 알터랙 산맥에 있는 보그가 데스그립에게 돌아가야 합니다.‡Adéntrate en el Valle de Alterac y derrota al general enano Vanndar Pico Tormenta. Vuelve entonces junto a Voggah Agarre Letal en las Montañas de Alterac.‡Adéntrate en el Valle de Alterac y derrota al general enano Vanndar Pico Tormenta. Vuelve entonces junto a Voggah Agarre Letal en las Montañas de Alterac.‡Entrez dans la vallée d\'Alterac, tuez Vanndar Stormpike, le général nain, puis retournez voir Voggah Deathgrip dans les montagnes d\'Alterac‡进入奥特兰克山谷，击败矮人将军范达尔·雷矛。然后回到沃加·死爪那里。‡進入奧特蘭克山谷，擊敗矮人將軍範達爾·雷矛。然後回到沃加·死爪那裏。',
  }
},
[7161] = {
  {
    'Campo de testes‡Испытательные земли‡Flaggenjagd‡신병 계급장‡Terreno de pruebas‡Terreno de pruebas‡Montrer sa valeur‡试炼场‡試煉場',
    nil,
    'Vá até a caverna dos Garragreste, a sudeste da base principal no Vale Alterac, e encontre o Estandarte dos Lobo do Gelo. Entregue o Estandarte dos Lobo do Gelo para o Mestre Guerreiro Laggrond.‡Отправляйтесь в пещеры Дикой Лапы, расположенные на юго-востоке от основной базы в Альтеракской долине, и добудьте вымпел клана Северного Волка. Отнесите выпмел клана Северного Волка воеводе Лаггронду.‡Begebt euch in die Höhle der Wildpfoten südöstlich vom Hauptstützpunkt und findet das Banner der Frostwolf. Bringt anschließend Kriegsmeister Laggrond das Banner.‡알터랙 계곡의 서리늑대 요새 남동쪽에 위치한 자갈발 동굴로 가서 서리늑대부족 깃발을 찾아 전투대장 락그론드에게 가져가야 합니다.‡Viaja hasta la cueva Zarpa Salvaje ubicada al sureste del campamento base en el Valle de Alterac y encuentra el estandarte de los Lobo Gélido. Devuélvele el estandarte al maestro de guerra Laggrond.‡Viaja hasta la Caverna Zarpa Salvaje ubicada al sureste del campamento base en el Valle de Alterac y encuentra el estandarte Lobo Gélido. Devuélvele el estandarte al maestro de guerra Laggrond.‡Rendez-vous dans les cavernes des Follepattes, au sud-est de la base principale, et récupérez la Bannière Frostwolf qui s’y trouve. Ramenez-la au Maître de guerre Laggrond.‡到主基地东南边的蛮爪洞穴中去找到霜狼军旗，然后把它交给拉格隆德。‡到主基地東南邊的蠻爪洞穴中去找到霜狼軍旗，然後把它交給拉格隆德。',
  }
},
[7162] = {
  {
    'Campo de testes‡Испытательные земли‡Flaggenjagd‡신병 계급장‡Terreno de pruebas‡Terreno de pruebas‡Montrer sa valeur‡试炼场‡試煉場',
    nil,
    'Viaje para a Caverna Asálgida a sudoeste de Dun Baldar, no Vale Alterac, e recupere o Estandarte dos Lançatroz. Entregue o Estandarte dos Lançatroz para o Tenente Haggerdin nas Montanhas de Alterac.‡Отправляйтесь в Пещеру Ледяного Крыла, которые расположены в Альтеракской долине, на юго-западе от Дун Болдара, и добудьте вымпел Грозовой Вершины. Отдайте вымпел лейтенанту Мурпу в Альтеракских горах.‡Begebt euch in die Icewinghöhle südwestlich von Dun Baldar und findet das Banner der Stormpike. Bringt anschließend Lieutenant Haggerdin im Alteracgebirge das Banner.‡알터랙 계곡에 있는 던 발다르에서 남서쪽에 위치한 얼음날개 동굴로 가서 스톰파이크 깃발을 찾아 알터랙 산맥에 있는 부관 해거딘에게 돌아가야 합니다.‡Viaja hasta la cueva Ala Gélida ubicada al suroeste de Dun Baldar en el Valle de Alterac y recupera el estandarte de Pico Tormenta. Devuélveselo al teniente Haggerdin en las Montañas de Alterac.‡Viaja hasta la cueva Ala Gélida ubicada al suroeste de Dun Baldar en el Valle de Alterac y recupera el estandarte Pico Tormenta. Devuélveselo al teniente Haggerdin en las Montañas de Alterac.‡Rendez-vous dans les cavernes de l\'Aile de glace, au sud-ouest de la base principale, et récupérez la Bannière Stormpike qui s’y trouve. Ramenez-la au lieutenant Haggerdin.‡到主基地东南边的冰翼洞穴中去找到雷矛军旗，然后把它交给哈格丁中尉。‡到主基地東南邊的冰翼洞穴中去找到雷矛軍旗，然後把它交給哈格丁中尉。',
  }
},
