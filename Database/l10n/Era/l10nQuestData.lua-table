[4808] = {
  {
    'Felnok Molaço‡Фелнок Сталлист‡Felnok Steelspring‡펠노크 스틸스프링‡Felnok Acerovera‡Felnok Acerovera‡Felnok Steelspring‡菲诺克‡菲諾克',
    nil,
    'Leve a Carta de Vera para Felnok Molaço.‡Отнесите письмо Тинки Фелноку Сталлисту.‡Gebt Felnok Steelspring Tinkees Brief.‡팅키의 편지를 펠노크 윈터스프링에게 가져다주어야 합니다.‡Entrégale la carta de Tinkee a Felnok Acerovera.‡Entrega la carta de Tinkee a Felnok Acerovera.‡Donner la Lettre de Tinkee à Felnok Steelspring.‡把丁奇的信交给菲诺克。‡把丁奇的信交給菲諾克。',
  }
},
[4809] = {
  {
    'Chifres de ventogelante‡Рога стылодыхов‡Hörner der Eiswindschimären‡서리바람 키메라의 뿔‡Cuernos de quimera venfresco‡Cuernos de Orvallo‡Cornes de Noroît‡冰风奇美拉角‡冰風奇美拉角',
    nil,
    'Leve 8 Chifres Inteiriços de Quimera Ventogelante para Felnok Molaço.‡Принесите 8 безупречных рогов стылодыха Фелноку Сталлисту.‡Bringt Felnok Steelspring 8 unbeschädigte Hörner einer Eiswindschimäre.‡펠노크 윈터스프링에게 온전한 서리바람 키메라의 뿔 8개를 가져가야 합니다.‡Llévale 8 cuernos de quimera venfresco sin fisuras a Felnok Acerovera.‡Lleva 8 cuernos de Orvallos intactos a Felnok Acerovera.‡Apporter 8 Cornes intactes de Noroît à Felnok Steelspring.‡将8支完整的冰风奇美拉角交给菲诺克。‡將8支完整的冰風奇美拉角交給菲諾克。',
  }
},
[4810] = {
  {
    'Fale novamente com Vera‡Возвращение к Тинки‡Rückkehr zu Tinkee‡팅키에게 돌아가는 길‡Vuelve con Tinkee‡Regresa junto a Tinkee‡Retourner voir Tinkee‡返回丁奇身边‡返回丁奇身邊',
    nil,
    'Leve o Pacote do Felnok para Vera Brequim, nas Estepes Ardentes.‡Отнесите ящик Фелнока Тинки Кипеллер в Пылающие степи.‡Bringt Tinkee Steamboil in der brennenden Steppe Felnoks Päckchen.‡불타는 평원의 팅키 스팀보일에게 펠노크의 소포를 가져가야 합니다.‡Llévale el paquete de Felnok a Tinkee Vaporio en Las Estepas Ardientes.‡Llévale la talega de Felnok a Tinkee Vaporio en Las Estepas Ardientes.‡Apporter le Paquet de Felnok à Tinkee Steamboil dans les Steppes ardentes.‡把菲诺克的包裹交给燃烧平原的丁奇·斯迪波尔。‡把菲諾克的包裹交給燃燒平原的丁奇·斯迪波爾。',
  }
},
[4811] = {
  {
    'O cristal vermelho‡Красный кристалл‡Der rote Kristall‡붉은 수정‡El cristal rojo‡El cristal rojo‡Le cristal rouge‡红色水晶‡紅色水晶',
    nil,
    'Viaje para o leste de Auberdine e procure por um grande cristal vermelho na montanha leste da Costa Negra. Relate o que você descobriu à Sentinela Glynda Nal\'Shea, em Auberdine.‡Направляйтесь на восток от Аубердина и поищите большой красный кристалл в горной гряде на востоке Темного Берега. Вернитесь с докладом к часовому Глинде Нал\'Шие в Аубердин.‡Reist von Auberdine nach Osten und sucht nach einem großen, roten Kristall entlang der östlichen Bergkette von Dunkelküste. Informiert Schildwache Glynda Nal\'Shea in Auberdine über Eure Erkenntnisse.‡어둠의 해안의 동쪽 산맥을 따라 아우버다인 동쪽으로 가서 거대한 붉은 수정을 찾은 다음 아우버다인에 있는 파수꾼 글린다 날셰에게 보고해야 합니다.‡Viaja al este de Auberdine y busca un gran cristal rojo en la zona montañosa que hay al este de Costa Oscura. Vuelve a Auberdine e informa de lo que has encontrado a la centinela Glynda Nal\'Shea.‡Viaja al este de Auberdine y busca un gran cristal rojo en la zona montañosa que hay al este de Costa Oscura. Vuelve a Auberdine e informa de lo que has encontrado a la centinela Glynda Nal\'Shea.‡Voyager en direction de l’est en partant d\'Auberdine et chercher un gros cristal rouge le long de la chaîne de montagne est de Sombrivage. Aller faire un rapport de ce que vous avez trouvé à la Sentinelle Glynda Nal\'Shea à Auberdine.‡到奥伯丁的东边去，沿着黑海岸东部边界的山脉寻找一颗巨大的红色水晶，然后向奥伯丁的哨兵戈琳达·纳希恩汇报你的发现。‡到奧伯丁的東邊去，沿著黑海岸東部邊界的山脈尋找壹顆巨大的紅色水晶，然後向奧伯丁的哨兵戈琳達·納希恩匯報妳的發現。',
  }
},
[4812] = {
  {
    'Como cascatas‡Пока струится вода...‡Wenn das Wasser fließt‡수정에 물이 흐르면‡Agua en cascada‡Agua en cascada‡Comme l\'eau tombe en cascade‡清洗水晶‡清洗水晶',
    nil,
    'Encha o Tubo de Água Vazio no poço lunar de Auberdine, e depois investigue o cristal vermelho na encosta da montanha leste da Costa Negra.‡Наполните пустую колбу для воды в лунном колодце Аубердина, а затем исследуйте красный кристалл, находящийся в горной гряде на востоке Темного Берега.‡Füllt die leere Wasserröhre am Mondbrunnen von Auberdine und untersucht dann den roten Kristall an der östlichen Bergkette von Dunkelküste.‡빈 시험관에 아우버다인의 달샘 물을 채운 후 어둠의해안의 동쪽 산에 있는 붉은 수정을 찾아 조사하십시오.‡Llena el vial de agua vacío en la poza de la luna de Auberdine y luego examina el cristal rojo a lo largo de la pared montañosa oriental de Costa Oscura.‡Llena el tubo de agua vacío en la Poza de la Luna de Auberdine y luego examina el cristal rojo a lo largo de la pared montañosa oriental de Costa Oscura.‡Remplir le Tube d\'eau vide au Puits de lune d’Auberdine, puis chercher le cristal rouge le long des falaises des montagnes à l’est de Sombrivage.‡在奥伯丁月亮井中把空水瓶装满，然后调查黑海岸东部山脉的红水晶。‡在奧伯丁月亮井中把空水瓶裝滿，然後調查黑海岸東部山脈的紅水晶。',
  }
},
[4813] = {
  {
    'Fragmentos incrustados‡Скрытые фрагменты‡Die Fragmente im Inneren‡수정 안의 뼈‡Los fragmentos del interior‡Los trozos del interior‡Les fragments à l\'intérieur‡水晶中的碎骨‡水晶中的碎骨',
    nil,
    'Relate o que você descobriu à Sentinela Glynda Nal\'Shea, em Auberdine.‡Доложите о результатах ваших изысканий часовому Глинде Нал\'Шие в Аубердине.‡Informiert Schildwache Glynda Nal\'Shea in Auberdine über Eure Erkenntnisse.‡아우버다인에 있는 파수꾼 글린다 날셰에게 알아 낸 사실을 보고해야 합니다.‡Vuelve a Auberdine e informa de lo que has averiguado a la centinela Glynda Nal\'Shea.‡Vuelve a Auberdine e informa de lo que has averiguado a la centinela Glynda Nal\'Shea.‡Aller faire un rapport de ce que vous avez trouvé à la Sentinelle Glynda Nal\'Shea à Auberdine.‡向奥伯丁的哨兵哨兵戈琳达·纳希恩报告你的发现。‡向奧伯丁的哨兵哨兵戈琳達·納希恩報告妳的發現。',
  }
},
[4821] = {
  {
    'Ovo alienígena‡Странное яйцо‡Fremdartiges Ei‡괴상한 알‡Un huevo extraño‡Un huevo extraño‡L\'oeuf étrange‡异型卵‡異型卵',
    nil,
    'Leve o Ovo Alienígena a Hagar Casco de Raio, na Aldeia Vento Livre.‡Принесите неизвестное яйцо Хагару Грозовому Копыту на Заставу Вольного Ветра.‡Bringt Hagar Lightninghoof am Freiwindposten das fremdartige Ei.‡높새바람 봉우리에 있는 하가르 라이트닝후프에게 괴상한 알을 가져가야 합니다.‡Devuélvele el huevo extraño a Hagar Pezuña del Rayo, que está en el Poblado Viento Libre.‡Devuélvele el huevo extraño a Hagar Pezuña del Rayo, que está en el Poblado Viento Libre.‡Rapporter l\'Oeuf étrange à Hagar Lightninghoof au Poste de Librevent.‡把异型卵交给乱风岗的哈加尔·雷蹄。‡把異型卵交給亂風崗的哈加爾·雷蹄。',
  }
},
[4822] = {
  {
    'Olha o sorvete!‡Женщинам – цветы, детям -...‡Lecker Eis‡아이스크림, 아이스크림‡¡Quiero un heladooooo!‡¡Quiero un heladooooo!‡Je veux une glaaaaace !‡草莓冰激凌‡',
    nil,
    'Consiga um pouco de Sorvete de Morango para o órfão. Ele parece gostar de sorvete da marca Tigule e Foror.‡Купите своему подопечному клубничное мороженое. Кажется, мальчик предпочитает мороженое Тигуле и Форора.‡Besorgt für Euren Schützling etwas Erdbeereis. Der kleine scheint die Marke \'Skippis und Gunnis Eiscreme\' zu bevorzugen.‡돌보고 있는 아이에게 딸기 아이스크림을 가져다줘야 합니다. 랜디스는 티굴의 딸기 아이스크림을 좋아하는 것 같습니다.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Allez chercher de la glace à la fraise pour votre protégé. Le gamin semble préférer la marque de glace Aguilor & Dagharn.‡为你看护的孩子买一些草莓冰激凌。这个孩子似乎最喜欢“提古勒和弗洛尔”牌的草莓冰激凌。‡',
  }
},
[4841] = {
  {
    'Pacifique o Centauro‡Упокоение кентавров‡Befriedung der Zentauren‡켄타우로스 처치‡Apaciguar al centauro‡Apaciguar al centauro‡Pacifier les centaures‡清除半人马‡清除半人馬',
    nil,
    'Mate 12 Batedores Galath, 10 Cavalgantes Galath e 6 Ventilhões Galath, depois fale novamente com o Vigia do Rochedo Chifre Longo na Aldeia Vento Livre.‡Убейте 12 разведчиков, 10 пастухов и 6 ветроловок из племени Галак, после чего вернитесь к дозорному утесов Долгорогу на Заставу Вольного Ветра.‡Tötet 12 Späher der Galak, 10 Zänker der Galak sowie 6 Windjäger der Galak und kehrt dann zu Klippenbehüter Longhorn am Freiwindposten zurück.‡갈라크일족 척후병 12명, 갈라크일족 사냥꾼 10명, 갈라크일족 바람전사 6명을 처치한 후, 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 돌아가야 합니다.‡Mata a 12 exploradores Galak, 10 retadores Galak y 6 cazavientos Galak, y después ve a ver de nuevo al vigiarrisco Cuerno Largo al Poblado Viento Libre.‡Mata a 12 exploradores Galak, 10 retadores Galak y 6 cazavientos Galak, y después ve a ver de nuevo al vigiarrisco Cuerno Largo al Poblado Viento Libre.‡Tuer 12 Eclaireurs galak, 10 Querelleurs galak, et 6 Chasse-vent galak, puis retourner auprès du garde-falaise Longhorn au Poste de Librevent.‡杀掉12个加拉克斥候、10个加拉克争斗者和6个加拉克逐风者，然后向乱风岗的峭壁卫兵图林·长角复命。‡殺掉12個加拉克斥候、10個加拉克爭鬥者和6個加拉克逐風者，然後向亂風崗的峭壁衛兵圖林·長角復命。',
  }
},
[4842] = {
  {
    'Fontes estranhas‡Выяснение причин‡Sonderbare Quellen‡이상한 근원‡Fuentes extrañas‡Fuentes extrañas‡Sources étranges‡奇怪的源头‡奇怪的源頭',
    nil,
    'Siga as instruções de Bruna Covaneve, depois fale novamente com ela.‡Последуйте указаниям Доновы Снегоноры, а затем вернитесь к ней.‡Befolgt Donova Snowdens Anweisungen und meldet Euch dann wieder bei ihr.‡도노바 스노우덴의 지시를 따라 탐색을 한 후 되돌아오십시오.‡Sigue las indicaciones de Donova Cubilnevado y vuelve a informarle.‡Sigue las indicaciones de Donova Cubilnevado y vuelve a informarle.‡Suivre les instructions de Donova Snowden, puis faire un rapport.‡根据多诺瓦·雪山的指示行动，然后回到她那里报告。‡根據多諾瓦·雪山的指示行動，然後回到她那裏報告。',
  }
},
[4861] = {
  {
    'Coruscante enfurecido‡Разъяренные дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre o acampamento destruído e os suprimentos de Jaron Moldapedra na parte sul de Hibérnia.‡Найдите разоренный лагерь Джерона Гранильщика и его припасы на юге Зимних Ключей.‡Findet Jaron Stoneshapers ruiniertes Lager samt dessen Vorräte im südlichen Winterspring.‡여명의 설원 남부 지역에서 야론 스톤셰이퍼의 야영지를 찾아서 부서진 보급품 상자를 되찾아 와야 합니다.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiser le camp démoli et les fournitures de Jaron Stoneshaper, au sud du Berceau-de-l\'Hiver.‡在冬泉谷的南部寻找加隆·石矛的被破坏的营帐，以及他的补给物资。‡在冬泉谷的南部尋找加隆·石矛的被破壞的營帳，以及他的補給物資。',
  }
},
[4862] = {
  {
    'Nojento!‡Товар на любителя‡Be-Öh-Es-Eh‡더러운 거미알‡Bestia amaestrada‡Bestia amaestrada‡Mauvais‡蜘蛛卵‡蜘蛛卵',
    nil,
    'Vá para o Pico da Rocha Negra e colete 15 Ovos de Aranha do Pináculo para Kibler.|nPelo nome, é de se pensar que eles fiquem perto das aranhas.‡Отправьтесь на пик Черной горы и принесите Киблеру 15 яиц скального паука.|nСудя по всему, яйца надо искать недалеко от пауков.‡Reist zur Blackrockspitze und sammelt 15 Spitzenspinnen-Eier für Kibler.|nLogischerweise müsstet Ihr diese Eier in der Nähe von Spinnen finden.‡검은바위 첨탑으로 가서 키블러를 위해 첨탑 거미알 15개를 수집해야 합니다.|n들리는 소문으로는 그 알들은 거미들이 서식하는 근처에서 찾을 수 있다고 합니다.‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|nYo diría que se pueden encontrar estos huevos cerca de arañas.‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|nYo diría que se pueden encontrar estos huevos cerca de arañas.‡Aller au Pic Blackrock et ramasser 15 Oeuf d\'araignée du pic pour Kibler.|nCes oeufs peuvent être trouvés à proximité des araignées.‡到黑石塔去为基布雷尔收集15枚尖塔蜘蛛卵。|n听说那些蜘蛛周围有许多这样的卵。‡到黑石塔去為基布雷爾收集15枚尖塔蜘蛛卵。|n聽說那些蜘蛛周圍有許多這樣的卵。',
  }
},
[4863] = {
  {
    'Coruscante enfurecido‡Разъяренные дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre a carroça destruída de Jaron Moldapedra.‡Найдите опрокинутый фургон Джерона Гранильщика.‡Sucht Jaron Stoneshapers zerstörten Wagen.‡야론 스톤셰이퍼의 부서진 마차를 찾아야 합니다.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Trouver le chariot saccagé de Jaron Stoneshaper.‡找到加隆·石矛的马车。‡找到加隆·石矛的馬車。',
  }
},
[4864] = {
  {
    'Coruscante enfurecido‡Разъяренные дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Pegue os Suprimentos do Jaron na neve, depois encontre o coruscante que roubou o amuleto de que Jaron falou.|nEntregue os Suprimentos do Jaron e o Amuleto de Penas Azuis para Jaron Moldapedra na cabana, em Hibérnia.‡Подберите припасы Джерона из снега, и найдите дикого совуха, похитившего амулет, о котором говорил Джерон.|nПринесите припасы и ожерелье миних перьев Джерону Гранильщику в его дом в Зимних Ключах.‡Klaubt Jarons Vorräte aus dem Schnee und sucht dann die Wildekin, die das Amulett gestohlen haben, von dem Jaron gesprochen hatte.|nBringt Jaron Stoneshaper in der Lodge in Winterspring dessen Vorräte und das blaugefiederte Amulett.‡눈 속에서 야론의 보급품을 회수한 다음, 야론이 찾는 아뮬렛을 훔친 올빼미야수들을 찾아야 합니다.|n여명의 설원, 별똥별 마을에 있는 야론 스톤셰이퍼에게 야론의 보급품과 푸른 깃털달린 아뮬렛을 갖다주어야 합니다.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico que robó el amuleto del que te habló Jaron.|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico salvaje que robó el amuleto del que te habló Jaron.|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Ramasser les Fournitures de Jaron dans la neige, puis trouver l\'Indomptable qui a volé l\'amulette dont Jaron a parlé.|nRapporter les fournitures de Jaron et l\'Amulette de la plume bleue à Jaron Stoneshaper au pavillon, dans le Berceau-de-l\'Hiver.‡从雪地中拾起加隆的补给物资，然后寻找盗取加隆所说的护符的枭兽。|n将加隆的补给物资和蓝色羽毛护符交给冬泉谷的加隆·石矛。‡從雪地中拾起加隆的補給物資，然後尋找盜取加隆所說的護符的梟獸。|n將加隆的補給物資和藍色羽毛護符交給冬泉谷的加隆·石矛。',
  }
},
[4865] = {
  {
    'Selva da serpente‡Змеиная дикость‡Wilde Schlange‡뱀의 복수‡Venganza‡Venganza‡Serpent sauvage‡狂热之蛇‡狂熱之蛇',
    nil,
    'Relate suas descobertas a Motega Barba de Fogo.‡Расскажите о найденном Мотеге Огненной Гриве.‡Berichtet Motega Firemane von Euren Entdeckungen.‡발견한 사실을 모테가 파이어메인에게 보고해야 합니다.‡Cuéntale a Motega Pirocabello lo que has descubierto.‡Infórmale de tus hallazagos a Motega Pirocabello.‡Faire un rapport de vos trouvailles à Motega Firemane.‡向莫特加·火鬃汇报你的发现。‡向莫特加·火鬃匯報妳的發現。',
  }
},
[4866] = {
  {
    'Leite materno‡Материнское молоко‡Muttermilch‡여왕 거미의 독‡La leche de la madre‡La leche de la madre‡Le lait matriarcal‡蛛后的乳汁‡蛛後的乳汁',
    nil,
    'No coração do Pico da Rocha Negra você vai encontrar a Mãe Queimateia. Chame a atenção dela e deixe-a envenenar você. É bem provável que você precise matá-la também. Fale novamente com João Roto depois que for envenenad<o/a> para que ele possa "ordenhar" você.‡Найдите в самом сердце пика Черной горы мать Дымную Паутину. Сражайтесь с ней, пока она не введет вам свой яд. Скорее всего ее также придется убить. Когда яд будет в вас, вернитесь к Джону-Оборванцу, чтобы он смог добыть яд.‡Ihr findet Mutter Glimmernetz im Herzen der Blackrockspitze. Kämpft mit ihr und bringt sie dazu, Euch zu vergiften. Es kann gut sein, dass Ihr sie sogar töten müsst. Kehrt zum struppigen John zurück, sobald Ihr vergiftet seid, damit er Euch \'melken\' kann.‡검은바위 첨탑 중심부에서 여왕 불그물거미를 찾을 수 있습니다. 여왕 불그물거미를 공격하거나 접근하여 그 독에 중독되어야 합니다. 독에 걸릴 확률을 높이기 위해서는 거미를 죽여야 할 수도 있습니다. 중독되면 털보 존에게 돌아가서 그가 그 독을 추출하게 해야 합니다.‡En el corazón de la Cumbre de Roca Negra encontrarás a Madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡En el corazón de la Cumbre de Roca Negra encontrarás a la madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡Vous trouverez la Matriarche Couveuse au coeur du pic Blackrock. Attaquez-la et poussez-la à vous empoisonner. Vous devrez sans doute la tuer. Une fois <empoisonné/empoisonnée>, trouvez John le Loqueteux afin qu\'il puisse prélever un échantillon.‡你可以在黑石塔的中心地带找到烟网蛛后。与她战斗，让她在你体内注入毒汁。如果你有能力的话，就杀死她吧。当你中毒之后，回到狼狈不堪的约翰那儿，他会从你的身体里抽取这些“蛛后的乳汁”。‡妳可以在黑石塔的中心地帶找到煙網蛛後。與她戰鬥，讓她在妳體內註入毒汁。如果妳有能力的話，就殺死她吧。當妳中毒之後，回到狼狽不堪的約翰那兒，他會從妳的身體裏抽取這些“蛛後的乳汁”。',
  }
},
[4867] = {
  {
    'Urok Uivo-da-ruína‡Аррок Смертный Вопль‡Urok Schreckensbote‡우로크 둠하울‡Urok Aullasino‡Urok Aullasino‡Urok Hurleruine‡乌洛克‡烏洛克',
    nil,
    'Leia o Pergaminho do Warosh. Traga o Mojo do Warosh para Warosh.‡Прочитайте записку Вароша. Принесите Варошу его амулет.‡Lest Waroshs Rolle. Bringt Waroshs Mojo zu Warosh.‡와로쉬의 두루마리를 읽어야 합니다. 와로쉬에게 그의 부적을 가져가야 합니다.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lire le Parchemin de Warosh. Apporter le Mojo de Warosh à Warosh.‡阅读瓦罗什的卷轴。将瓦罗什的蟑螂交给他。‡閱讀瓦羅什的卷軸。將瓦羅什的蟑螂交給他。',
  }
},
[4881] = {
  {
    'Plano de assassinato‡Убийственный заговор‡Auftragsmordplan‡암살 음모‡Complot de asesinato‡Complot de asesinato‡Complot d\'assassinat‡暗杀计划‡暗殺計劃',
    nil,
    'Alerte Kanati Nuvem Cinzenta, no Posto Confinalvo, do plano para assassiná-lo.‡Предупредите Канати Серое Облако на заставе Белого Плеса, что на него готовится покушение.‡Warnt Kanati Greycloud am Weißgipfelposten, dass man vorhat, ihn zu töten.‡백사장 야영지에 있는 카나티 그레이클라우드에게 가서 암살 음모에 대해 경고해 주어야 합니다.‡Avisa a Kanati Nubegris, que está en el Campamento del Tramo Blanco, acerca de la conspiración para acabar con su vida.‡Avisa a Kanati Nube Gris, en el Campamento del Tramo Blanco, acerca de la conspiración para acabar con su vida.‡Prévenir Kanati Greycloud au Poste de Blanc-relais qu\'un complot le menace.‡将暗杀计划通知给白沙岗哨的卡纳提·灰云。‡將暗殺計劃通知給白沙崗哨的卡納提·灰雲。',
  }
},
[4882] = {
  {
    'Segredos guardados‡Умение хранить секреты‡Geheimnisse bewachen‡수호에 대한 비밀‡Guardar un secreto‡Guardar un secreto‡Secrets gardés‡守护秘密‡守護秘密',
    nil,
    'Leve o Colar de Penas Azuis para Trull Ruinazar, no Posto Peçonha.‡Отнесите ожерелье синих перьев Труллу Баловню Судьбы на Заставу Отравленной Крови.‡Bringt Trull Failbane beim Blutgiftposten das blaugefiederte Amulett.‡피멍울 초소에 있는 트룰 페일베인에게 푸른 깃털달린 목걸이를 갖다주어야 합니다.‡Lleva el Collar de plumas azules a Trull Fallarruina en el Puesto del Veneno.‡Lleva el Collar de plumas azules a Trull Fallarruina en el Puesto del Veneno.‡Apporter le Collier de plumes bleues à Trull Failbane au Poste de la Vénéneuse.‡把蓝羽项链交给血毒岗哨的特鲁尔·法贝恩。‡把藍羽項鏈交給血毒崗哨的特魯爾·法貝恩。',
  }
},
[4883] = {
  {
    'Segredos guardados‡Умение хранить секреты‡Geheimnisse bewahren‡수호에 대한 비밀‡Guardar un secreto‡Guardar un secreto‡Secrets gardés‡守护秘密‡守護秘密',
    nil,
    'Leve o Colar de Penas Azuis para Nara Juba Agreste.‡Отнесите ожерелье синих перьев Наре Буйногривой.‡Bringt Nara Wildmane das blaugefiederte Amulett.‡푸른 깃털달린 목걸이를 나라 와일드메인에게 갖다주어야 합니다.‡Lleva el Collar de plumas azules a Nara Bravacrín.‡Lleva el Collar de plumas azules a Nara Ferocrín.‡Apporter le Collier de plumes bleues à Nara Wildmane.‡把蓝羽项链交给纳拉·蛮鬃。‡把藍羽項鏈交給納拉·蠻鬃。',
  }
},
[4901] = {
  {
    'Guardiões do altar‡Стражи алтаря‡Wächter des Altars‡제단의 수호자‡Guardianes del altar‡Guardianes del altar‡Les gardiens de l\'autel‡祭坛守护者‡祭壇守護者',
    nil,
    'Proteja Ranshalla enquanto ela tenta reativar o Altar de Eluna. Relate suas descobertas a Erelas Ambarcéu, na Vila de Rut\'theran.‡Защитите Раншаллу, пока она пытается активировать алтарь Элуны. Сообщите о ваших находках Эреласу Янтарному Небу в деревне Рут\'теран.‡Schützt Ranshalla, während sie versucht, den Altar von Elune wieder zu aktivieren. Berichtet Erelas Ambersky in Rut\'theran von Eurem Fund.‡엘룬의 제단을 여는 과정에서 란샬라를 보호해야 합니다. 성공하면 루테란 마을에 있는 에렐라스 앰버스카이에게 발견한 내용을 보고해야 합니다.‡Protege a Ranshalla mientras intenta reactivar el Altar de Elune. Informa sobre tus descubrimientos a Eralas Cieloámbar de Aldea Rut\'theran.‡Protege a Ranshalla mientras intenta reactivar el Altar de Elune. Informa sobre tus descubrimientos a Erelas Cieloámbar de Aldea Rut\'theran.‡Protéger Ranshalla pendant qu’elle s’efforce de réactiver l’Autel d’Elune. Faire un rapport de vos découvertes à Erelas Ambersky, au village de Rut\'theran.‡在兰莎尔拉尝试激活艾露恩祭坛的过程中保护她。然后将你的发现报告给鲁瑟兰村的艾瑞拉斯·琥珀。‡在蘭莎爾拉嘗試激活艾露恩祭壇的過程中保護她。然後將妳的發現報告給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[4902] = {
  {
    'Coruscante de Eluna‡Питомцы Элуны‡Wildekin von Elune‡엘룬의 올빼미야수‡Lechúcico de Elune‡Lechúcico salvaje de Elune‡Les Indomptables d\'Elune‡艾露恩的枭兽‡艾露恩的梟獸',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Staghelm in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada de Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l’archidruide Fandral Staghelm, à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊範達爾·鹿盔談壹談。',
  }
},
[4903] = {
  {
    'O comando do Senhor da Guerra‡Приказ полководца‡Befehl des Kriegsherrn‡장군의 명령‡La orden del Señor de la Guerra‡La orden del Señor de la Guerra‡Ordre du chef de guerre‡高图斯的命令‡高圖斯的命令',
    nil,
    'Mate o Grão-lorde Omokk, o Senhor da Guerra Voone e o Lorde Supremo Wyrmthalak. Recupere Documentos Importantes dos Rocha Negra. Fale novamente com o Senhor da Guerra Trincador, em Karrath, quanto a missão tiver sido cumprida.‡Убейте вождя Омокка, воеводу Вуна и повелителя Змейталака. Найденные при них важные бумаги Черной горы доставьте полководцу Клинозубу в Каргат.‡Tötet Hochlord Omokk, Kriegsmeister Voone und Oberanführer Wyrmthalak. Findet die wichtigen Blackrockdokumente. Kehrt zum Kriegsherrn Goretooth nach Kargath zurück, sobald Ihr diese Mission erledigt habt.‡대군주 오모크와 대장군 부네, 대군주 웜타라크를 처단해야 합니다. 검은바위의 중요한 문서들을 확보해야 합니다. 임무를 완수하는 대로 카르가스의 장군 고어투스에게로 돌아가야 합니다.‡Mata al alto señor Omokk, al maestro de guerra Voone y al señor supremo Vermiothalak. Recupera importantes documentos Roca Negra. Vuelve junto al señor de la guerra Dientegore en Kargath cuando hayas cumplido la misión.‡Mata al alto señor Omokk, al maestro de guerra Voone y al señor supremo Vermiothalak. Recupera importantes documentos Roca Negra. Vuelve junto al señor de la guerra Dientegore en Kargath cuando hayas cumplido la misión.‡Tuer le généralissime Omokk, le maître de guerre Voone et le seigneur Wyrmthalak. Récupérer les Importants documents Blackrock. Retourner voir le chef de guerre Goretooth à Kargath une fois la mission accomplie.‡杀死欧莫克大王、指挥官沃恩和维姆萨拉克。找到重要的黑石文件，然后向卡加斯的军官高图斯汇报。‡殺死歐莫克大王、指揮官沃恩和維姆薩拉克。找到重要的黑石文件，然後向卡加斯的軍官高圖斯匯報。',
  }
},
[4904] = {
  {
    'Liberdade, liberdade‡Долгожданная свобода‡Endlich frei‡마침내 자유를‡Al fin libre‡Al fin libre‡Libre, enfin !‡终获自由‡終獲自由',
    nil,
    'Escolte Lakota Cantéolo para fora do Pináculo da Nuvem Negra e depois fale com Thalia Couro Âmbar, na Aldeia Vento Livre.‡Выведите Лакоту Песню Ветра с Пика Темного Облака, а потом поговорите с Талией Янтарной Шкурой на Заставе Вольного Ветра.‡Geleitet Lakota Windsong vom Düsterwolkengipfel hinab und sprecht dann im Freiwindposten mit Thalia Amberhide.‡라코타 윈드송을 먹구름 봉우리에서 구출한 후, 높새바람 봉우리에 있는 탈리아 앰버하이드와 대화하십시오.‡Saca a Lakota Canzalvaje de Cumbre de la Nube Negra y después habla con Thalia Pielámbar, que está en el Poblado Viento Libre.‡Saca a Lakota Son del Viento de Cumbre de la Nube Negra y después habla con Thalia Ocultaámbar, que está en el Poblado Viento Libre.‡Escorter Lakota Windsong hors de la Cime de Noir-nuage, puis parler à Thalia Amberhide au Poste de Librevent.‡护送拉克塔·风歌离开恐怖图腾营地，然后与乱风岗的萨利亚谈一谈。‡護送拉克塔·風歌離開恐怖圖騰營地，然後與亂風崗的薩利亞談壹談。',
  }
},
[4905] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    '‡‡‡‡‡Defend Kanati Greycloud‡‡‡',
  }
},
[4906] = {
  {
    'Mais corrupção‡Снова порча!‡Weitere Verderbnis‡오염의 확산‡Más corrupción‡Más corrupción‡Plus de corruption‡更深重的堕落‡更深重的墮落',
    nil,
    'Eridan Brisazul, na Selva Maleva, quer que você mate 8 Infernarautos Flamejade, 8 Traidores Flamejade, 8 Trapaceiros Flamejade e Xavaric. Fale novamente com Eridan quando a tarefa estiver concluída.‡Эридана Грусть Ветра из Оскверненного леса просит вас убить 8 призывателей огня, 8 предателей и 8 плутов из племени Нефритового огня, а также Ксаварика. По выполнении задания возвращайтесь к Эридане.‡Eridan Bluewind im Teufelswald möchte, dass Ihr Xavaric sowie 8 Jadefeuerhöllenrufer, 8 Jadefeuerverräter und 8 Jadefeuerschwindler tötet. Kehrt zu Eridan zurück, sobald Ihr die Aufgabe erfüllt habt.‡에리단 블루윈드를 위해 비취불꽃 지옥소환사 8명과 배반자 8명, 그리고 요술사 8명과 사바릭을 처단해야 합니다. 임무가 완수되는 대로 에리단에게 돌아가십시오.‡Eridan Vientoazul de Frondavil quiere que mates a 8 clamainfernos Fuego de Jade, 8 traidores Fuego de Jade, 8 timadores Fuego de Jade y a Xavaric. Vuelve con Eridan cuando lo hayas hecho.‡Eridan Vientoazul de Frondavil quiere que mates a 8 clamainfernos Fuego de Jade, 8 traidores Fuego de Jade, 8 timadores Fuego de Jade y a Xavaric. Vuelve con Eridan cuando lo hayas hecho.‡Eridan Bluewind de Gangrebois veut que vous tuiez 8 Implorateurs de l\'enfer Jadefeu, 8 Traîtres Jadefeu, 8 Entourloupeurs Jadefeu, et Xavaric. Revenir auprès d’Eridan quand la tâche est accomplie.‡费伍德森林的艾瑞丹·蓝风要你去杀掉8个碧火唤魔者、8个碧火背叛者、8个碧火欺诈者和萨瓦里克。任务完成之后回到艾瑞丹那里复命。‡費伍德森林的艾瑞丹·藍風要妳去殺掉8個碧火喚魔者、8個碧火背叛者、8個碧火欺詐者和薩瓦裏克。任務完成之後回到艾瑞丹那裏復命。',
  }
},
[4907] = {
  {
    'Vera Brequim‡Тинки Кипеллер‡Tinkee Steamboil‡팅키 스팀보일‡Tinkee Vaporino‡Tinkee Vaporio‡Tinkee Steamboil‡丁奇·斯迪波尔‡丁奇·斯迪波爾',
    nil,
    'Fale com Vera Brequim.‡Поговорите с Тинки Кипеллер.‡Sprecht mit Tinkee Steamboil.‡팅키 스팀보일과 대화해야 합니다.‡Habla con Tinkee Vaporio.‡Habla con Tinkee Vaporio.‡Parler à Tinkee Steamboil.‡与丁奇·斯迪波尔谈一谈。‡與丁奇·斯迪波爾談壹談。',
  }
},
[4921] = {
  {
    'Perdida em combate‡Пропавшая без вести‡In der Schlacht vermisst‡전쟁으로 잃은 아내‡Perdida en la batalla‡Perdida en la batalla‡Disparition au combat‡在战斗中失踪‡在戰鬥中失蹤',
    nil,
    'Encontre a Mulher de Mankrik e depois fale novamente com ele na Encruzilhada.‡Отыщите жену Манкрика и возвращайтесь к нему в Перекресток.‡Sucht Mankriks Frau und kehrt dann zu ihm nach Crossroads zurück.‡크로스로드에 있는 만크릭을 위해 그의 아내의 흔적을 찾아 돌아가야 합니다.‡Encuentra a la esposa de Mankrik y llévala a El Cruce.‡Encuentra a la esposa de Mankrik y llévala a El Cruce.‡Trouver la femme de Mankrik puis retourner le voir à la Croisée.‡找到曼科里克的妻子，然后回到十字路口找他。‡找到曼科裏克的妻子，然後回到十字路口找他。',
  }
},
[4941] = {
  {
    'A sabedoria de Eitrigg‡Мудрость Эйтригга‡Eitriggs Weisheit‡아이트리그의 지혜‡La sabiduría de Eitrigg‡La sabiduría de Eitrigg‡Sagesse d\'Eitrigg‡伊崔格的智慧‡伊崔格的智慧',
    nil,
    'Fale com Eitrigg em Orgrimmar. Quando tiver discutido o assunto com Eitrigg, busque o conselho de Thrall.|nVocê se lembra de ter visto Eitrigg nos aposentos de Thrall.‡Поговорите с Эйтриггом в Оргриммаре. После этого обратитесь к вождю Траллу.|nВ последний раз Эйтригг был в в зале приемов Тралла.‡Sprecht mit Etrigg in Orgrimmar. Wenn Ihr die Angelegenheit mit Etrigg besprochen habt, bittet Thrall um Rat.|nIhr erinnert Euch, dass Ihr Etrigg in Thralls Gemächern gesehen habt.‡오그리마의 스랄의 요새에 있는 아이트리그와 대화해야 합니다. 아이트리그의 얘기를 듣고 난 후에는 대족장 스랄과 상의해야 합니다.‡Habla con Eitrigg en Orgrimmar. Cuando hayas tratado unos asuntos con Eitrigg, busca el consejo de Thrall.|nRecuerdas haber visto a Eitrigg en la Cámara de Thrall.‡Habla con Eitrigg en Orgrimmar. Cuando hayas tratado unos asuntos con Eitrigg, busca el consejo de Thrall.|nRecuerdas haber visto a Eitrigg en la Cámara de Thrall.‡Parler à Eitrigg, à Orgrimmar. Après avoir discuté avec Eitrigg, demander conseil à Thrall.|nVous avez déjà vu Eitrigg dans les Appartements de Thrall.‡和奥格瑞玛的伊崔格谈一谈。讨论完毕后，咨询萨尔的意见。|n你回忆起曾在萨尔的大厅中见过伊崔格。‡和奧格瑞瑪的伊崔格談壹談。討論完畢後，咨詢薩爾的意見。|n妳回憶起曾在薩爾的大廳中見過伊崔格。',
  }
},
[4961] = {
  {
    'A purificação do Orbe de Orahil‡Очищение шара Орахила‡Die Säuberung der Kugel von Orahil‡오라힐 보주의 정화‡La purificación del orbe de Orahil‡La purificación del orbe de Orahil‡Purifie l\'Orbe d\'Orahil‡奥拉赫宝珠的净化‡奧拉赫寶珠的凈化',
    nil,
    'Mate o Demônio do Orbe, depois fale com Tabetha.‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡보주의 악마를 물리치고 타베사와 대화하십시오.‡Mata al demonio del orbe y luego habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuer le Démon de l’Orbe, puis parler à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡殺死寶珠之魔，然後與塔貝薩談壹談。',
  }
},
[4962] = {
  {
    'Estilhaço de canisvil‡Осколок гончей Скверны‡Splitter eines Teufelshundes‡지옥사냥개의 영혼‡Fragmento de can manáfago‡Fragmento de can manáfago‡Un éclat de gangrechien‡地狱犬的灵魂‡地獄犬的靈魂',
    nil,
    'Pegue o Rubi de Felhas e use-o em um dos Canisvis encontrados em Desolação. Depois de conseguir, leve o Rubi de Felhas e o Espírito de Canisvil Aprisionado de volta a Menara Nihila, nos Sertões.‡Возьмите рубин Сквернолова и поймайте в него одну из гончих скверны в Пустошах. Добившись успеха, отнесите плененный дух Гончей Скверны и рубин Сквернолова Менаре Расщепительнице Бездны из Степей.‡Nehmt den Felhas-Rubin und benutzt ihn bei einem der Teufelshunde von Desolace. Wenn Ihr Erfolg hattet, bringt Menara Voidrender im Brachland den eingekerkerten Teufelshundgeist und den Felhas-Rubin.‡지옥의 루비를 가지고 가서 잊혀진 땅에 서식하는 지옥사냥개 중 한 마리에게 사용해야 합니다. 성공하면 지옥의 루비와 사로잡은 지옥사냥개의 영혼을 불모의 땅에 있는 미네라에게 가져가야 합니다.‡Coge el rubí de Felhas y úsalo en uno de los canes manáfagos de Desolace. Cuando lo consigas, llévale el rubí de Felhas y el espíritu del can manáfago capturado a Menara Nadiz en Los Baldíos.‡Coge el rubí de Felhas y úsalo en uno de los canes manáfagos de Desolace. Cuando lo consigas, llévale el rubí de Felhas y el espíritu del can manáfago encarcelado a Menara Nadiz en Los Baldíos.‡Prendre le Rubis de Felhas et l’utiliser sur l’un des gangrechiens de Désolace. Quand vous aurez réussi, rapporter le Rubis de Felhas et l’Esprit de gangrechien emprisonné à Menara Voidrender, dans les Tarides.‡带上地狱犬红宝石到凄凉之地去，用它捕获一只地狱犬的灵魂。成功之后，将地狱犬红宝石和被禁锢的地狱犬灵魂交给贫瘠之地的梅纳拉·沃伦德。‡帶上地獄犬紅寶石到淒涼之地去，用它捕獲壹只地獄犬的靈魂。成功之後，將地獄犬紅寶石和被禁錮的地獄犬靈魂交給貧瘠之地的梅納拉·沃倫德。',
  }
},
[4963] = {
  {
    'Estilhaço de infernal‡Осколок инфернала‡Splitter einer Höllenbestie‡지옥불정령의 영혼‡Fragmento de infernal‡Fragmento de infernal‡Eclat d\'Infernal‡地狱火的灵魂‡地獄火的靈魂',
    nil,
    'Pegue a Esmeralda Infusa e use-a em um dos Infernais encontrados em Desolação. Depois de conseguir, leve a Esmeralda Infusa e o Espírito de Infernal Aprisionado de volta a Menara Nihila, nos Sertões.‡Возьмите Пылающий изумруд и поймайте в него одного из инферналов в Пустошах. Добившись успеха, отнесите плененный дух инфернала и пылающий изумруд Менаре Расщепительнице Бездны из Степей.‡Nehmt den Infus-Smaragd und benutzt ihn bei einer der Höllenbestien von Desolace. Wenn Ihr Erfolg hattet, bringt Menara Voidrender im Brachland den eingekerkerten Höllenbestiengeist und den Infus-Smaragd.‡지옥불 에메랄드를 가지고 가서 잊혀진 땅의 지옥불정령 중 하나에게 사용해 영혼을 사로 잡아야 합니다. 성공하면 지옥불 에메랄드와 사로잡은 지옥불정령의 영혼을 불모의 땅에 있는 미네라에게 가져가야 합니다.‡Coge la esmeralda de Infus y úsala en uno de los infernales de Desolace. Cuando lo consigas, llévale la esmeralda de Infus y el espíritu del infernal capturado a Menara Nadiz en Los Baldíos.‡Coge la esmeralda de Infus y úsala en uno de los infernales de Desolace. Cuando lo consigas, llévale la esmeralda de Infus y el espíritu del infernal encarcelado a Menara Nadiz en Los Baldíos.‡Prendre l’Emeraude d\'Infus et l’utiliser sur les Infernaux qui se trouvent en Désolace. Quand vous aurez réussi, rapporter l’Emeraude d\'Infus et l’Esprit d\'Infernal emprisonné à Menara Voidrender, dans les Tarides.‡带上地狱火绿宝石到凄凉之地去，用它捕获一个地狱火的灵魂。成功之后，将地狱火绿宝石和被禁锢的地狱火灵魂交给贫瘠之地的梅纳拉·沃伦德。‡帶上地獄火綠寶石到淒涼之地去，用它捕獲壹個地獄火的靈魂。成功之後，將地獄火綠寶石和被禁錮的地獄火靈魂交給貧瘠之地的梅納拉·沃倫德。',
  }
},
[4964] = {
  {
    'Orbe de Dar\'Orathil concluído‡Завершение шара Дар\'орахила‡Die fertig gestellte Kugel von Dar\'Orahil‡완성된 다르오라힐의 보주‡El orbe completo de Dar\'Orahil‡El orbe completo de Dar\'Orahil‡L\'Orbe complet de Dar\'Orahil‡达奥拉赫宝珠‡達奧拉赫寶珠',
    nil,
    'Espere Menara Nihila completar o Orbe de Dar\'Orathil e fale com ela novamente.‡Дождитесь, пока Менара Расщепительница Бездны закончит работу над шаром Дар\'орахила, и еще раз поговорите с ней.‡Wartet, bis Menara Voidrender die Kugel von Dar\'Orahil fertig gestellt hat, und sprecht dann noch einmal mit ihr.‡미네라 보이드렌더가 다르오라힐의 보주를 완성시킬 때까지 기다렸다가 그녀에게 말을 걸어야 합니다.‡Espera a Menara Nadiz para completar el orbe de Dar\'Orahil y vuelve entonces a hablar con ella.‡Espera a Menara Nadiz para completar el orbe de Dar\'Orahil y vuelve entonces a hablar con ella.‡Attendre que Menara Voidrender termine l’Orbe de Dar\'Orahil, puis lui reparler.‡等待梅纳拉·沃伦德完成达奥拉赫宝珠，然后再与她谈一谈。‡等待梅納拉·沃倫德完成達奧拉赫寶珠，然後再與她談壹談。',
  }
},
[4965] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Voidrender im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Voidrender dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·沃倫德談壹談。',
  }
},
[4966] = {
  {
    'Proteja Kanati Nuvem Cinzenta‡Защитить Канати Серое Облако‡Kanati Greycloud schützen‡카나티 그레이클라우드 보호‡Defensa de Kanati Nube Gris‡Defensa de Kanati Nube Gris‡Protéger Kanati Greycloud‡保护卡纳提·灰云‡保護卡納提·灰雲',
    nil,
    'Proteja Kanati Nuvem Cinzenta do ataque dos centauros.‡Защитите Канати Серое Облако от нападения кентавров.‡Beschützt Kanati Greycloud vor den Angriffen der Zentauren.‡켄타우로스의 공격으로부터 카나티 그레이클라우드를 보호해야 합니다.‡Defiende a Kanati Nube Gris contra el ataque de los centauros.‡Defiende a Kanati Nube Gris contra el ataque de los centauros.‡Protéger Kanati Greycloud contre l’attaque centaure.‡保护卡纳提·灰云免受半人马的袭击。‡保護卡納提·灰雲免受半人馬的襲擊。',
  }
},
[4967] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Voidrender im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Voidrender dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·沃倫德談壹談。',
  }
},
[4968] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Voidrender im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Voidrender dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·沃倫德談壹談。',
