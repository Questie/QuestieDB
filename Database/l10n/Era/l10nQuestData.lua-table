[5676] = {
  {
    'Fluxo arcano‡Волшебное искажение‡Arkane Rückkopplung‡비전 역순환‡La reacción Arcana‡La reacción Arcana‡Retour d\'information de l\'Arcane‡奥术回馈‡奧術回饋',
    nil,
    '‡Поговорите с Верховной жрицей Лореной в Штормграде.‡Sprecht mit der Hohepriesterin Laurena in Sturmwind.‡스톰윈드에 있는 대여사제 로레나와 대화해야 합니다.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Parler à la grande prêtresse Laurena à Hurlevent.‡与暴风城的高阶牧师劳瑞娜谈一谈。‡',
  }
},
[5677] = {
  {
    'Fluxo Arcano‡Волшебное искажение‡Arkane Rückkopplung‡비전 역순환‡La reacción Arcana‡La reacción Arcana‡Retour d\'information de l\'Arcane‡奥术回馈‡奧術回饋',
    nil,
    'Fale com a Alta-sacerdotisa Laurena em Ventobravo.‡Поговорите с Верховной жрицей Лореной в Штормграде.‡Sprecht mit der Hohepriesterin Laurena in Stormwind.‡스톰윈드에 있는 대여사제 로레나와 대화해야 합니다.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Parler à la grande prêtresse Laurena à Stormwind.‡与暴风城的高阶牧师劳瑞娜谈一谈。‡與暴風城的高階牧師勞瑞娜談壹談。',
  }
},
