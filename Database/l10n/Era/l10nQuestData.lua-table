},
[6761] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Volte a Darnassus e fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bearwalker in der Enklave des Cenarius von Darnassus.‡다르나서스의 세나리온 자치령에 있는 마스렌길 베어워커와 대화하십시오.‡Ve a Darnassus, al Enclave Cenarion y habla con Mathrengyl Garroso.‡Ve a Darnassus, al Enclave Cenarion y habla con Mathrengyl Garroso.‡Parler à Mathrengyl Bearwalker, dans l’Enclave cénarienne de Darnassus.‡与达纳苏斯的塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯的塞納裏奧區的瑪斯雷·馭熊者談壹談。',
  }
},
[6762] = {
  {
    'Ravine Saturna‡Рабин Сатурна‡Rabine Saturna‡라빈 사투르나‡Rabine Saturna‡Rabine Saturna‡Rabine Saturna‡拉比恩·萨图纳‡拉比恩·薩圖納',
    nil,
    'Fale com Ravine Saturna no Refúgio Noturno, que fica na Clareira da Lua. A Clareira da Lua fica entre a Selva Maleva e Hibérnia. Uma estrada que sai do Domínio dos Presamatos leva até lá.‡Поговорите с Рабином Сатурной в селении Ночная Гавань на Лунной поляне. Лунная поляна находится между Оскверненным лесом и Зимними Ключами, туда можно добраться по дороге, идущей от крепости Древобрюхов.‡Sprecht mit Rabine Saturna im Dorf Nighthaven in Moonglade. Moonglade liegt zwischen dem Teufelswald und Winterspring, und Ihr erreicht es über den Pfad, der aus der Holzschlundfeste herausführt.‡달의 숲, 나이트헤이븐에 있는 라빈 사투르나와 대화하십시오. 달의 숲은 악령의 숲과 여명의 설원 사이에 있으며 나무구렁 요새에서 나가는 길을 따라가면 됩니다.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión de los Fauces de Madera.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión Fauces de Madera.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune. Reflet-de-Lune se trouve entre Gangrebois et le Berceau-de-l\'Hiver. Le chemin qui y mène traverse le Repaire des Grumegueules.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。月光林地在费伍德森林和冬泉谷之间，可以从木喉要塞中的一条通道抵达那里。‡與月光林地永夜港的拉比恩·薩圖納談壹談。月光林地在費伍德森林和冬泉谷之間，可以從木喉要塞中的壹條通道抵達那裏。',
  }
},
[6781] = {
  {
    'Mais sobras de armadura‡Больше обломков брони‡Mehr Rüstungsfetzen‡방어구 조각‡Más restos de armadura‡Más restos de armadura‡Plus de morceaux d\'armure !‡护甲碎片‡護甲碎片',
