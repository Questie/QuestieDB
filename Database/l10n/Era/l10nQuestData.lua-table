},
[1948] = {
  {
    'Itens do poder‡Волшебные предметы‡Gegenstände der Macht‡강력한 물건‡Objetos de poder‡Objetos de poder‡Les Objets de Puissance‡强大的物品‡強大的物品',
    nil,
    'Traga 1 Jade e a Morácea Carregada por Raio para Tabetha no Pântano Vadeoso.‡Принесите 1 нефрит и шипастый жезл Молний Табете в Пыльную трясину.‡Bringt 1 Stück Jade und den vom Blitz aufgeladenen Dornbusch zu Tabetha in den Marschen von Dustwallow.‡먼지진흙 습지대에 있는 타베사에게 비취 1개와 벼락 맞은 나뭇가지를 가져가야 합니다.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Apporter un Jade et le Roncier de foudre à Tabetha, dans le marécage d\'Âprefange.‡将电能草莓和1颗翡翠交给尘泥沼泽的塔贝萨。‡將電能草莓和1顆翡翠交給塵泥沼澤的塔貝薩。',
  }
},
[1949] = {
  {
    'Segredos ocultos‡Великие тайны‡Verborgene Geheimnisse‡숨겨진 비밀‡Secretos escondidos‡Secretos escondidos‡Des secrets cachés‡隐藏的秘密‡隱藏的秘密',
    nil,
    'Fale com Tirth, o Mago, no Salar Cintilante.‡Поговорите с волхвом Тиртом на Мерцающей равнине.‡Sprecht mit Magus Tirth in der schimmernden Ebene.‡소금 평원에 있는 학자 틸스와 대화하십시오.‡Habla con Magus Tirth en El Desierto de Sal.‡Habla con Magus Tirth en El Desierto de Sal.‡Parler au magus Tirth dans les Salines.‡和闪光平原的大法师提尔斯谈一谈。‡和閃光平原的大法師提爾斯談壹談。',
  }
},
[1950] = {
  {
    'Tente a sorte‡Волшебное слово‡Der Knüller schlechthin‡주문 알아오기‡Santo y seña‡Santo y seña‡Trouver le Scoop‡解封咒语‡解封咒語',
    nil,
    'Encontre a frase que abre o cofre de Tirth e fale novamente com ele.‡Узнайте волшебные слова, отпирающие сейф Тирта и вернитесь к Тирту.‡Bringt den Satz für Tirths Geldkassette in Erfahrung und kehrt zu Tirth zurück.‡틸스의 금고를 여는 주문을 알아서 틸스에게 돌아가야 합니다.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Trouver l\'Incantation pour ouvrir le coffre-fort de Tirth puis retourner voir Tirth.‡找到提尔斯保险箱的解封咒语，然后向提尔斯复命。‡找到提爾斯保險箱的解封咒語，然後向提爾斯復命。',
  }
},
[1951] = {
  {
    'Rituais do Poder‡Обряды силы‡Rituale der Macht‡마력의 의식‡Rituales de poder‡Rituales de poder‡Rituels du Pouvoir‡能量仪祭‡能量儀祭',
    nil,
    'Leve o livro Rituais do Poder para Tabetha no Pântano Vadeoso.‡Принесите книгу "Обряды силы" Табете в Пыльную трясину.‡Bringt das Buch \'Rituale der Macht\' zu Tabetha in den Marschen von Dustwallow.‡먼지진흙 습지대에 있는 타베사에게 마력의 의식을 가져가야 합니다.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Apporter le livre des « Rituels du pouvoir » à Tabetha dans le marécage d\'Âprefange.‡将《能量仪祭》交给尘泥沼泽的塔贝萨。‡將《能量儀祭》交給塵泥沼澤的塔貝薩。',
  }
},
[1952] = {
  {
    'Varinha do Mago‡Магический жезл‡Der Zauberstab des Magiers‡마법사의 마법봉‡Varitas de mago‡Varitas de mago‡La baguette du mage‡法师的魔杖‡法師的魔杖',
    nil,
    'Fale com Tabetha depois do ritual.‡Поговорите с Табетой по завершении ритуала.‡Sprecht nach ihrem Ritual mit Tabetha.‡의식이 끝나면 타베사와 대화하십시오.‡Habla con Tabetha cuando termine su ritual.‡Habla con Tabetha cuando termine su ritual.‡Aller voir Tabetha après son rituel.‡等塔贝萨的仪式完成后，和她谈一谈。‡等塔貝薩的儀式完成後，和她談壹談。',
  }
},
[1953] = {
  {
    'Retorno ao pântano‡Назад в болото‡Rückkehr in die Marschen‡다시 습지대로‡Regreso al pantano‡Regresa a la Marisma‡Retourner dans le Marais‡返回沼泽‡返回沼澤',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화하십시오.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談壹談。',
  }
},
[1954] = {
  {
    'O Orbe Infernal‡Сфера Подземного огня‡Die Höllenkugel‡지옥의 보주‡El orbe infernal‡El orbe infernal‡L\'orbe infernal‡地狱火宝珠‡地獄火寶珠',
    nil,
    'Leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Принесите сферу Подземного огня Табете из Пылевых топей.‡Bringt eine Höllenkugel zu Tabetha in den Marschen von Dustwallow.‡먼지진흙 습지대에 있는 타베사에게 지옥의 보주를 가져가야 합니다.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Apporter un Orbe infernal à Tabetha dans le marécage d\'Âprefange.‡将一颗地狱火宝珠交给尘泥沼泽的塔贝萨。‡將壹顆地獄火寶珠交給塵泥沼澤的塔貝薩。',
  }
},
[1955] = {
  {
    'O Exorcismo‡Поединок с демоном‡Die Austreibung‡악마 퇴치‡El exorcismo‡El exorcismo‡L\'Exorcisme‡驱除魔鬼‡驅除魔鬼',
    nil,
    'Mate o Demônio do Orbe, depois fale com Tabetha.‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡보주의 악마를 물리치고 타베사와 대화하십시오.‡Mata al demonio del orbe y luego habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuer le démon de l\'Orbe puis parler à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡殺死寶珠之魔，然後與塔貝薩談壹談。',
  }
},
[1956] = {
  {
    'Poder em Uldaman‡Сила Ульдамана‡Macht in Uldaman‡울다만의 마력원천‡Poder en Uldaman‡Poder en Uldaman‡L\'Energie d\'Uldaman‡奥达曼的能量源‡奧達曼的能量源',
    nil,
    'Recupere uma Fonte de Energia de Obsidiana e leve-a para Tabetha no Pântano Vadeoso.‡Добудьте обсидиановый источник силы и принесите его Табете в Пыльную трясину.‡Beschafft Euch eine Obsidiankraftquelle und bringt sie in die Marschen von Dustwallow zu Tabetha.‡흑요석 마력원천을 구해서 먼지진흙 습지대에 있는 타베사에게 가져가야 합니다.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Récupérer une Source d\'énergie en obsidienne et la rapporter à Tabetha dans le marécage d\'Âprefange.‡找到一个黑曜石能量源，将其交给尘泥沼泽的塔贝萨。‡找到壹個黑曜石能量源，將其交給塵泥沼澤的塔貝薩。',
  }
},
[1957] = {
  {
    'Surtos de mana‡Волнолов маны‡Manawogen‡마력의 폭풍‡Oleadas de maná‡Oleadas de maná‡Les éruptions de mana‡法力怒灵‡法力怒靈',
    nil,
    'Mate 12 Surtos de Mana no tempo limite permitido.‡Убейте 12 волноловов маны за отведенное время.‡Vernichtet 12 Manawogen innerhalb des Zeitlimits.‡주어진 시간 안에 마력의 폭풍 12마리를 물리쳐야 합니다.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Tuer 12 Eruptions de mana dans la limite de temps imposée.‡在限定时间内杀死12只法力怒灵。‡在限定時間內殺死12只法力怒靈。',
  }
},
[1958] = {
  {
    'Poder celestial‡Небесная сила‡Himmlische Macht‡천공의 힘‡Poder celestial‡Poder celestial‡L\'Energie céleste‡苍穹之力‡蒼穹之力',
