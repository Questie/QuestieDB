},
[8250] = {
  {
    'Magiaria‡Магическое искусство‡Geschick der Magier‡마법 공예‡Pura magia‡Pura magia‡L\'art du mage‡法师的会见‡法師的會見',
    nil,
    'Procure Sanath Lim-yo e consiga o transporte para ver o Arquimago Tauriel.‡Найдите Саната Лим-Йо и добейтесь, чтобы он доставил вас к верховному магу Ксилему.‡Sucht nach Sanath Lim-yo und verschafft Euch Zugang zu Erzmagier Xylem.‡대마법사 실렘을 만나기 위한 허가를 얻기 위해 사나스 림요를 찾아야 합니다.‡Busca a Sanath Lim-yo y obtén permiso para ver al archimago Xylem.‡Busca a Sanath Lim-yo y obtén permiso para ver al archimago Xylem.‡Trouvez Sanath Lim-Yo et obtenez d\'être <mené/menée> à l\'archimage Xylem.‡找到萨纳斯，让他将你传送到大法师克希雷姆那儿。‡找到薩納斯，讓他將妳傳送到大法師克希雷姆那兒。',
  }
},
[8251] = {
  {
    'Pó Mágico‡Волшебная пыль‡Magischer Staub‡마법의 티끌‡El polvo mágico‡El polvo mágico‡La poussière magique‡魔法的尘埃‡魔法的塵埃',
    nil,
    'Leve 10 Poeiras Reluzentes para o Arquimago Tauriel.‡Принесите 10 горстей сияющей пыли верховному магу Ксилему.‡Bringt Erzmagier Xylem in Azshara 10 glitzernde Staubproben.‡대마법사 실렘에게 반짝이는 가루 10개를 가져가야 합니다.‡Llévale 10 puñados de polvo relumbrante al archimago Xylem.‡Llévale 10 puñados de polvo relumbrante al archimago Xylem.‡Procurer 10 doses de Poussière lumineuse à l’archimage Xylem.‡为大法师克希雷姆收集10份闪光尘埃。‡為大法師克希雷姆收集10份閃光塵埃。',
  }
},
[8252] = {
  {
    'Coral de sirenas‡Кораллы сирен‡Die Koralle der Sirenen‡세이렌의 산호‡El coral de las sirenas‡El coral de las sirenas‡Le corail des sirènes‡纳迦的珊瑚‡納迦的珊瑚',
    nil,
    'Obtenha 6 Corais Encantados e entregue-os ao Arquimago Tauriel.‡Соберите 6 заколдованных кораллов и принесите их верховному магу Ксилему.‡Sammelt 6 verzauberte Korallen und bringt sie zum Erzmagier Xylem.‡대마법사 실렘에게 마력 깃든 산호 6개를 가져가야 합니다.‡Reúne 6 corales encantados y llévaselos al archimago Xylem.‡Reúne 6 corales encantados y llévaselos al archimago Xylem.‡Récupérer 6 Coraux enchantés et les apporter à l’archimage Xylem.‡收集6块魔化珊瑚，然后把它们交给大法师克希雷姆。‡收集6塊魔化珊瑚，然後把它們交給大法師克希雷姆。',
  }
},
[8253] = {
  {
    'A destruição de Morphaz‡Уничтожить Морфаза‡Vernichtet Morphaz‡몰파즈 처치‡Destruye a Morphaz‡Destruye a Morphaz‡Détruire Morphaz‡毁灭摩弗拉斯‡毀滅摩弗拉斯',
    nil,
    'Recupere o Estilhaço Arcano de posse de Morphaz e fale novamente com o Arquimago Tauriel.‡Добудьте кристалл тайной магии из брюха Морфаза и принесите его верховному магу Ксилему.‡Beschafft den arkanen Splitter von Morphaz\' Leichnam und kehrt mit ihm zu Erzmagier Xylem zurück.‡몰파즈에게서 신비의 결정을 되찾아 대마법사 실렘에게 가져가야 합니다.‡Recupera el fragmento arcano de Morphaz y llévaselo al archimago Xylem.‡Recupera el fragmento arcano de Morphaz y llévaselo al archimago Xylem.‡Récupérer le Fragment d’arcane sur Morphaz et le rendre à l’archimage Xylem.‡从摩弗拉斯身上取回奥术碎片，然后返回大法师克希雷姆那儿。‡從摩弗拉斯身上取回奧術碎片，然後返回大法師克希雷姆那兒。',
  }
},
[8254] = {
  {
    'Ajuda aos cenarianos‡Помощь Кенарию‡Cenarische Hilfe‡세나리온 의회 지원‡Ayuda a Cenarion‡Ayuda a Cenarion‡Aider le Cercle‡塞纳里奥议会的求助‡塞納裏奧議會的求助',
    nil,
    'Encontre Ogtinc em Azshara.‡Отыщи Огтинка в Азшаре.‡Sucht Ogtinc in Azshara auf.‡아즈샤라에서 오그틴크를 찾아야 합니다.‡Busca a Ogtinc en Azshara.‡Busca a Ogtinc en Azshara.‡Chercher Ogtinc en Azshara.‡找到艾萨拉的奥汀克。‡找到艾薩拉的奧汀克。',
  }
},
[8255] = {
  {
    'Ginetes sagrados‡Охота на беговых оленей‡Renner für einen höheren Zweck‡순록을 찾아서‡Los trotadores Pezuñamusgo‡Los trotadores Pezuñamusgo‡Courser les coursiers‡苔蹄快步者‡苔蹄快步者',
    nil,
    'Obtenha 4 Glândulas de Ginete Saudável leve-as para Ogtinc em Azshara. Ogtinc vive no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Добудьте 4 железы здорового мохоногого оленя и принесите их Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Beschafft 4 gesunde Rennerdrüsen und bringt sie zu Ogtinc in Azshara. Ihr findet ihn auf den Klippen, nordöstlich der Ruinen von Eldarath.‡건강한 순록의 분비샘 4개를 찾아 아즈샤라의 오그틴크에게 가져가야 합니다. 오그틴크는 엘다라스 폐허의 북동쪽 절벽 꼭대기에 있습니다.‡Consigue 4 glándulas de trotadores sanos y llévaselas a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Consigue 4 glándulas de trotadores sanos y llévaselas a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Récupérer 4 Glandes de coursier en bonne santé et les apporter à Ogtinc en Azshara. Ogtinc réside au sommet des falaises, au nord-est des ruines d’Eldarath.‡收集4份健康的野鹿腺体，把它们交给艾萨拉的奥汀克。奥汀克住在埃达拉斯废墟东北部悬崖的顶部。‡收集4份健康的野鹿腺體，把它們交給艾薩拉的奧汀克。奧汀克住在埃達拉斯廢墟東北部懸崖的頂部。',
  }
},
[8256] = {
  {
    'A linfa de morte-viva‡Лимфа нежити‡Sekret des Untodes‡불사의 영액‡El icor de los no-muertos‡El icor de los no-muertos‡L\'ichor de non-mort‡亡灵的腐液‡亡靈的腐液',
    nil,
    'Obtenha uma Linfa de Morte-viva para Ogtinc em Azshara. Ogtinc mora no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Принесите лимфу нежити Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Beschafft ein Sekret des Untodes für Ogtinc in Azshara. Ihr findet ihn auf den Klippen, nordöstlich der Ruinen von Eldarath.‡아즈샤라의 오그틴크에게 불사의 영액을 가져다주어야 합니다. 오그틴크는 엘다라스 폐허 북동쪽 절벽 꼭대기에 있습니다.‡Consigue un icor de los no-muertos para Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Consigue un icor de no-muerto para Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Récupérer une dose d’Ichor de non-mort pour le compte d’Ogtinc en Azshara. Ogtinc réside au sommet des falaises, au nord-est des ruines d’Eldarath.‡为艾萨拉的奥汀克带回一份亡灵腐液。奥汀克住在埃达拉斯废墟东北部悬崖的顶端。‡為艾薩拉的奧汀克帶回壹份亡靈腐液。奧汀克住在埃達拉斯廢墟東北部懸崖的頂端。',
  }
},
[8257] = {
  {
    'Sangue de Morphaz‡Кровь Морфаза‡Morphaz\' Blut‡몰파즈의 피‡La sangre de Morphaz‡La sangre de Morphaz‡Le sang de Morphaz‡摩弗拉斯之血‡摩弗拉斯之血',
    nil,
    'Mate Morphaz no templo submerso de Atal\'Hakkar e leve o sangue dele para Greta Musgo no Casco na Selva Maleva. A entrada do templo submerso fica no Pântano das Mágoas.‡Убейте Морфаза в затонувшем храме Атал\'Хаккара и принесите его кровь Грете Замшелому Копыту в Оскверненный лес. Вход в храм сокрыт на болоте Печали.‡Tötet Morphaz im versunkenen Tempel von Atal\'Hakkar und bringt Greta Mosshoof im Teufelswald sein Blut. Der Eingang zum versunkenen Tempel liegt in den Sümpfen des Elends.‡아탈학카르 신전에서 몰파즈를 처치하고 그의 피를 악령의 숲에 있는 그레타 모스후프에게 가져다주어야 합니다. 가라앉은 신전의 입구는 슬픔의 늪에 있습니다.‡Mata a Morphaz en El Templo Sumergido de Atal\'Hakkar y lleva su sangre a Greta Pezuñamusgo en Frondavil. Encontrarás la entrada al Templo Sumergido en el Pantano de las Penas.‡Mata a Morphaz en El Templo Sumergido de Atal\'Hakkar y lleva su sangre a Greta Pezuñamusgo en Frondavil. Encontrarás la entrada al Templo Sumergido en el Pantano de las Penas.‡Tuez Morphaz dans le temple englouti d’Atal\'Hakkar, et ramenez son sang à Greta Sabot-de-mousse à Gangrebois. L’entrée du temple englouti se trouve dans le marais des Chagrins.‡前往沉没的阿塔哈卡神庙，杀死绿龙摩弗拉斯，将他的血液交给费伍德森林中的格雷塔·苔蹄。沉没的神庙的入口就在悲伤沼泽中。‡前往沈沒的阿塔哈卡神廟，殺死綠龍摩弗拉斯，將他的血液交給費伍德森林中的格雷塔·苔蹄。沈沒的神廟的入口就在悲傷沼澤中。',
  }
},
[8258] = {
  {
    'A ameaça de Noctilatrus‡Угроза Темного Губителя‡Die Bedrohung durch Schattensichel‡다크리버의 위협‡La amenaza de Atracoscuro‡La amenaza de Atracoscuro‡La menace de Ravassombre‡达克雷尔的威胁‡達克雷爾的威脅',
    nil,
    'Use o Cristal Divinatório no coração do porão do Grande Ossário, em Scolomântia. Isso invocará espíritos que você precisará enfrentar. A derrota dos espíritos evocará o Cavaleiro da Morte Noctilatrus. Derrote-o.|nLeve a Cabeça de Noctilatrus para Sagorne Monta Crista, no Vale da Sabedoria, em Orgrimmar.‡Используйте кристальный предсказатель в Главном склепе в Некроситете. Сразитесь с духами. Когда появится Темный Терзатель, убейте его.|nПринесите голову Темного Терзателя Сагорну Гривастому Страннику в Аллею Мудрости Оргриммара.‡Wendet das Orakel der Anrufung inmitten des Kellergewölbes des großen Ossuariums in Scholomance an. Ihr werdet damit Geister herbeirufen, die es zu bekämpfen gilt. Nach Vernichtung dieser Geister wird der Todesritter Schattensichel auftauchen; besiegt ihn.|nBringt Schattensichels Kopf zu Sagorne Creststrider im Tal der Weisheit in Orgrimmar.‡스칼로맨스 대형 납골당 지하실 가운데에 예언의 탐지기를 놓으십시오. 그러면 영혼들이 나타날 것입니다. 모두 물리치면 죽음의 기사 다크리버가 나타납니다. 그를 쓰러뜨리십시오.|n오그리마 지혜의 골짜기에 있는 사고른 크레스트스트라이더에게 다크리버가 죽었다는 증거로 그의 머리카락을 가져가야 합니다.‡Usa el cristal de adivinación en el corazón del sótano de El Gran Osario en Scholomance. Al hacerlo se presentarán los espíritus a los que tienes que enfrentarte. La derrota de estos espíritus invoca al caballero de la Muerte Atracoscuro, derrótalo.|nLlévale la cabeza de Atracoscuro a Sagorne Zanca Cresta en el Valle de la Sabiduría, en Orgrimmar.‡Usa el cristal de adivinación en el corazón del sótano de El Gran Osario en Scholomance. Al hacerlo se presentarán los espíritus a los que tienes que enfrentarte. La derrota de estos espíritus invoca al caballero de la Muerte Atracoscuro, derrótalo.|nLlévale la cabeza de Atracoscuro a Sagorne Zanca Cresta en el Valle de la Sabiduría, en Orgrimmar.‡Servez-vous du Clairvoyant au centre du sous-sol du Grand ossuaire de la Scholomance. Cela attirera des esprits que vous devrez combattre. Les vaincre fera apparaître le Chevalier de la mort Ravassombre. Tuez-le.|nRapportez la Tête de Ravassombre à Sagorne Rôdeur-des-crêtes de la Vallée de la Sagesse, à Orgrimmar.‡在斯坦索姆地下室的尸骨储藏所的中心使用预言水晶球。然后你必须与被召唤出来的幽灵作战。击败这些幽灵之后，死亡骑士达克雷尔才会出现，你的任务就是击败他。|n把死亡骑士达克雷尔的头颅交给奥格瑞玛智慧谷的萨格尼。‡在通靈學院地下室的屍骨儲藏所的中心使用預言水晶球，然後與被召喚出來的幽靈作戰。擊敗這些幽靈之後，死亡騎士達克雷爾才會出現，妳的任務就是擊敗他。|n把死亡騎士達克雷爾的徽記交給奧格瑞瑪智慧谷的薩格尼。',
  }
},
