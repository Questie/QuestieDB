},
[1884] = {
  {
    'Pilhas de ju-ju‡Груды джуджу‡Jujuhaufen‡주주 해골‡Montones de Ju-Ju‡Montones de Ju-Ju‡Les Tas de Ju-Ju‡魂能骨堆‡魂能骨堆',
    nil,
    'Destrua 4 Pilhas de Ju-Ju, depois fale novamente com Un\'Thuwa na Aldeia Sen\'jin.‡Уничтожьте 4 груды джуджу и вернитесь к Ун\'Туве из деревни Сен\'джин.‡Zerstört 4 Jujuhaufen und kehrt dann zu Un\'thuwa in Sen\'jin zurück.‡주주 해골 4개를 파괴하고 센진 마을에 있는 운투와에게 돌아가야 합니다.‡Destruye 4 montones de Juju y vuelve con Un\'thuwa en Poblado Sen\'jin.‡Destruye 4 montones de Juju y vuelve con Un\'thuwa en Poblado Sen\'jin.‡Détruire 4 Tas de Ju-Ju, puis retourner voir Un\'thuwa au village de Sen\'jin.‡摧毁4个魂能骨堆，然后向森金村的安苏瓦汇报。‡摧毀4個魂能骨堆，然後向森金村的安蘇瓦匯報。',
  }
},
[1885] = {
  {
    'Júnio Aquino‡Меннит Каркад‡Mennet Carkad‡메넷 칼카드‡Mennet Carkad‡Mennet Carkad‡Mennet Carkad‡米奈特·卡加德‡米奈特·卡加德',
    nil,
    'Fale com Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Поговорите с Меннитом Каркадом в Квартале Разбойников Подгорода.‡Sprecht mit Mennet Carkad im Schurkenviertel von Undercity.‡언더시티의 도적 지구에 있는 메넷 칼카드와 대화해야 합니다.‡Habla con Mennet Carkad en el Barrio de los Pícaros de Entrañas.‡Habla con Mennet Carkad en el Barrio de los Pícaros de Entrañas.‡Aller voir Mennet Carkad dans le Quartier des voleurs d\'Undercity.‡与幽暗城潜行者区的米奈特·卡加德谈一谈。‡與幽暗城潛行者區的米奈特·卡加德談壹談。',
  }
},
[1886] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Obtenha a Carta de Apresentação do Astolfo e leve até Júnio Aquino no Distrito dos Ladinos.‡Принесите рекомендательное письмо Астора Менниту Каркаду в Квартал Разбойников Подгорода.‡Beschafft Astors Empfehlungsschreiben und bringt es zu Mennet Carkad im Schurkenviertel.‡도적 지구에 있는 메네세 칼카드에게 아스토르의 소개장을 가져가야 합니다.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, que está en el Barrio de los Pícaros.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, en el Barrio de los Pícaros.‡Trouver la Lettre de recommandation d\'Astor et l\'apporter à Mennet Carkad dans le Quartier des voleurs.‡得到阿斯托的介绍信，并将其交给潜行者区的米奈特·卡加德。‡得到阿斯托的介紹信，並將其交給潛行者區的米奈特·卡加德。',
  }
},
[1898] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Fale com Andron Gante na Cidade Baixa.‡Поговорите с Андроном Гантом в Подгороде.‡Sprecht mit Andron Gant in Undercity.‡언더시티에 있는 안드론 건트와 대화해야 합니다.‡Habla con Andron Gant en Entrañas.‡Habla con Andron Gant en Entrañas.‡Aller voir Andron Gant à Undercity.‡与幽暗城的安德隆·甘特交谈。‡與幽暗城的安德隆·甘特交談。',
  }
},
[1899] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Entregue o Livro-caixa de Astor a Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Отнесите гроссбух Андрона Менниту Каркаду в Квартал Разбойников Подгорода.‡Bringt Astors Geschäftsbuch zu Mennet Carkad im Schurkenviertel von Undercity.‡언더시티에 있는 메넷 칼카드에게 안드론의 장부를 가져가야 합니다.‡Llévale el libro de contabilidad de Astor a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Apporter le Grand Livre d\'Astor à Mennet Carkad dans le Quartier des voleurs d\'Undercity.‡将阿斯托的的账本交给幽暗城潜行者区的米奈特·卡加德。‡將阿斯托的的賬本交給幽暗城潛行者區的米奈特·卡加德。',
  }
},
[1918] = {
  {
    'O elemento conspurcado‡Оскверненная стихия‡Das beschmutzte Element‡타락한 정령‡El elemento podrido‡El elemento contaminado‡Les éléments souillés‡被污染的水元素‡被汙染的水元素',
    nil,
    'Entregue o Globo d\'Água Conspurcado a Mastok Wrilehiss no Posto Machadada, no Vale Gris.‡Отнесите оскверненную водяную сферу Мистоку Райльшипу на заставу Расщепленного Древа в Ясеневый лес.‡Bringt die beschmutzte Wasserkugel zu Mastok Wrilehiss im Splintertreeposten in Ashenvale.‡잿빛 골짜기 토막나무 주둔지에 있는 마스토크 윌리히스에게 더럽혀진 물구슬을 가져가야 합니다.‡Llévale el globo de agua podrida a Mastok Sibilante en el Puesto del Hachazo, Vallefresno.‡Llévale el globo de agua contaminada a Mastok Bufido en el Puesto del Hachazo, Vallefresno.‡Apporter le Globe d\'eau souillée à Mastok Wrilehiss, au Poste de Bois-brisé, à Ashenvale.‡将被污染的水球交给灰谷碎木哨岗的马斯托克·维尔西斯。‡將被汙染的水球交給灰谷碎木哨崗的馬斯托克·維爾西斯。',
  }
},
[1919] = {
  {
    'Jana tem uma missão‡Задание Джиннии‡Meldung bei Jennea‡제니아에게 보고‡Preséntate ante Jennea‡Preséntate ante Jennea‡Rendre compte à Jennea‡向詹妮亚报告‡向詹妮亞報告',
    nil,
    'Fale com Jana Catão em Ventobravo.‡Поговорите с Джиннией Пушкой в Штормграде.‡Sprecht in Stormwind mit Jennea Cannon.‡스톰윈드에 있는 제니아 캐논과 대화하십시오.‡Habla con Jennea Cannon en Ventormenta.‡Habla con Jennea Cañón en Ventormenta.‡Parler à Jennea Cannon à Stormwind.‡和暴风城的詹妮亚·坎农谈一谈。‡和暴風城的詹妮亞·坎農談壹談。',
  }
},
[1920] = {
  {
    'Investigue o Recôndito Azulego‡Синий Отшельник‡Untersuchungen im Blauen Eremiten‡고독한 은둔자 선술집 조사‡Investiga lo que pasa en El Ermitaño Azul‡Investiga lo que pasa en El Ermitaño Taciturno‡Trouver le Solitaire bleu‡调查蓝色隐士‡調查藍色隱士',
    nil,
    'Obtenha um Cantochão da Manifestação e um Baú de Cofres de Contenção atrás de Jana Catão. Leve 3 Cofres de Contenção Cheios para Jana no Sacrário dos Teurgos.‡Возьмите свиток заклинания Проявления и ящик с шкатулками-духоловками за спиной у Джиннии Пушки. Принесите 3 заполненных шкатулки-духоловки Джиннии в Башню магов.‡Nehmt Euch die Inkantation der Manifestation und die Truhe mit Verwahrungskästen vom Tisch, hinter Jennea Cannon. Bringt 3 gefüllte Verwahrungskästen zu Jennea im Magiersanktum.‡제니아 캐논의 뒤에 있는 현신의 주문서와 속박의 상자를 집으십시오. 마법사의 성소에 있는 제이나에게 채워진 속박의 상자 3개를 가져가야 합니다.‡Detrás de Jennea Cannon encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva las arcas de contención llenas a Jennea, en el Sagrario del Mago.‡Detrás de Jennea Cañón encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas a Jennea, en el Sagrario del Mago.‡Obtenir une Incantation de manifestation et une Caisse de coffres de retenue placée derrière Jennea Cannon. Apporter 3 Coffres de retenue remplis à Jennea Cannon au Sanctuaire du sorcier.‡从詹妮亚·坎农身后拿取一根显形卷轴以及一盒封灵箱。将3个装满的封灵箱交给巫师圣殿里的詹妮亚·坎农。‡從詹妮亞·坎農身後拿取壹根顯形卷軸以及壹盒封靈箱。將3個裝滿的封靈箱交給巫師聖殿裏的詹妮亞·坎農。',
  }
},
[1921] = {
  {
    'Em busca de materiais‡Сбор материалов‡Materialsammlung‡재료 수집‡Recolección de materiales‡Recolección de materiales‡Rassembler les matériaux‡收集原料‡收集原料',
    nil,
    'Leve 10 Linhos e 6 Gemas Energizadas da Fenda para Manoela Galante em Ventobravo.‡Отнесите 10 кусков льна и 6 заряженных самоцветов Расселины Уинн Ларсон в Штормград.‡Bringt 10 Leinentücher und 6 aufgeladene Rissedelsteine zu Wynne Larson in Stormwind.‡스톰윈드에 있는 위니 라슨에게 리넨 10개와 충만한 균열석 6개를 가져가야 합니다.‡Lleva 10 piezas de lino y 6 gemas cargadas de la falla a Wynne Larson en Ventormenta.‡Consigue 10 paños de lino y 6 gemas cargadas de la falla para Wynne Larson en Ventormenta.‡Apporter 10 unités de Lin et 6 Gemmes chargées de la faille à Wynne Larson à Stormwind.‡把10匹亚麻布和6颗充能裂隙宝石交给暴风城的维恩·拉尔森。‡把10匹亞麻布和6顆充能裂隙寶石交給暴風城的維恩·拉爾森。',
  }
},
[1938] = {
  {
    'Tratado de Ur sobre Umbromancia‡Трактат Ура по темной магии‡Urs Abhandlung über Schattenmagie‡우르의 흑마법 논문‡Tratado de Ur sobre la Magia de las Sombras‡Tratado de Ur sobre la Magia de las Sombras‡Traité d\'Ur sur la Magie des Ombres‡乌尔的暗影魔法研究论文‡烏爾的暗影魔法研究論文',
    nil,
    'Entregue o Tratado de Ur sobre Umbromancia ao Grão-feiticeiro Andromath em Ventobravo.‡Принесите Трактат Ура по темной магии верховному колдуну Андромату из Штормграда.‡Bringt \'Urs Abhandlung über Schattenmagie\' zu Zaubermeister Andromath in Stormwind.‡스톰윈드에 있는 고위마술사 안드로매스에게 우르의 흑마법 논문을 가져가야 합니다.‡Lleva el Tratado de Ur sobre la Magia de las Sombras al sumo hechicero Andromath en Ventormenta.‡Lleva el Tratado de Ur sobre la Magia de las Sombras al sumo hechicero Andromath en Ventormenta.‡Apporter le « Traité d\'Ur sur la magie de l\'Ombre » au Grand Sorcier Andromath à Stormwind.‡将《乌尔的暗影魔法研究论文》交给暴风城的高阶巫师安多玛斯。‡將《烏爾的暗影魔法研究論文》交給暴風城的高階巫師安多瑪斯。',
  }
},
[1939] = {
  {
    'Grão-feiticeiro Andromath‡Верховный колдун Андромат‡Zaubermeister Andromath‡고위마술사 안드로매스‡Alto Hechicero Andromath‡Sumo Hechicero Andromath‡Grand sorcier Andromath‡高阶巫师安多玛斯‡高階巫師安多瑪斯',
    nil,
    'Fale com o Grão-Feiticeiro Andromath.‡Поговорите с верховным колдуном Андроматом.‡Sprecht mit Zaubermeister Andromath.‡고위마술사 안드로매스와 대화하십시오.‡Habla con el sumo hechicero Andromath.‡Habla con el sumo hechicero Andromath.‡Aller voir le Grand Sorcier Andromath.‡和高阶巫师安多玛斯谈一谈。‡和高階巫師安多瑪斯談壹談。',
  }
},
[1940] = {
  {
    'Seda pura de aranha‡Безупречная паутина‡Makellose Spinnenseide‡온전한 거미줄‡Seda prístina de araña‡Seda prístina de araña‡Soie d\'araignée en parfait état‡新鲜的蜘蛛丝‡新鮮的蜘蛛絲',
    nil,
    'Leve 8 Sedas Puras de Aranha para Manoela Galante em Ventobravo.‡Принесите 8 кусков безупречной паутины Уинн Ларсон в Штормград.‡Bringt 8 Rollen makelloser Spinnenseide zu Wynne Larson in Stormwind.‡스톰윈드에 있는 위니 라슨에게 온전한 거미줄 8개를 가져가야 합니다.‡Lleva 8 sedas prístinas de araña a Wynne Larson en Ventormenta.‡Lleva 8 sedas prístinas de araña a Wynne Larson en Ventormenta.‡Apporter 8 Soies d\'araignée en parfait état à Wynne Larson à Stormwind.‡找到8束新鲜的蜘蛛丝，把它们交给暴风城的维恩·拉尔森。‡找到8束新鮮的蜘蛛絲，把它們交給暴風城的維恩·拉爾森。',
  }
},
