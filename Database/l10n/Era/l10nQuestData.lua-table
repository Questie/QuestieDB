    nil,
    nil,
  }
},
[8051] = {
  {
    'O Olho de Zuldazar‡Око Зулдазара‡Das Auge von Zuldazar‡줄다자르의 눈‡El ojo de Zuldazar‡El ojo de Zuldazar‡L\'œil de Zuldazar‡祖达萨之眼‡祖達薩之眼',
    nil,
    nil,
  }
},
[8052] = {
  {
    'O olho-que-tudo-vê de Zuldazar‡Всевидящее Око Зулдазара‡Das allsehende Auge von Zuldazar‡줄다자르의 천리안‡El ojo de Zuldazar que todo lo ve‡El Ojo que todo lo ve de Zuldazar‡L\'Oeil omnivoyant de Zuldazar‡祖达萨全视之眼‡祖達薩全視之眼',
    nil,
    nil,
  }
},
[8053] = {
  {
    'Epítomes de poder: as braçadeiras do livre-pensador‡Знаки Силы: боевые наручи вольнодумца‡Symbole der Macht: Die Armschützer des Freidenkers‡마력의 보물: 자유사상가의 손목보호대‡Dechados de Poder: los Guardabrazos de librepensador‡Dechados de Poder: los Guardabrazos de librepensador‡Parangons de puissance : les garde-bras de libre-penseur‡权力珍宝：思考者护臂‡權力珍寶：思考者護臂',
    nil,
    'Leve as Braçadeiras Hakkari Primevas a Jin\'rokh, o Rebentador, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Джин\'року Разрушителю изначальные поручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt urzeitliche Hakkaribindungen zu Jin\'rokh dem Zerstörer. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nJin\'rokh der Zerstörer befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 팔보호구를 구해 가시덤불 골짜기의 요잠바 섬에 있는 파괴자 진로크에게 가져가야 합니다.|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Cercenador: una pretina Hakkari primigenia. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nJin\'rokh el Cercenador está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Jin\'rokh el Rompedor unas ataduras Hakkari primigenias. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nJin\'rokh el Rompedor está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez des Manchettes primordiales hakkari à Jin\'rokh le Briseur. La tribu Zandalar doit aussi être Amicale envers vous (au minimum).|nJin\'rokh le Briseur se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给击碎者金罗克：1条原始哈卡莱护腕。你还必须在赞达拉部族中达到友善或更高的声望。|n击碎者金罗克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給擊碎者金羅克：1條原始哈卡萊護腕。妳還必須在贊達拉部族中達到友善或更高的聲望。|n擊碎者金羅克在荊棘谷的尤亞姆巴島上。',
  }
},
[8054] = {
  {
    'Epítomes de poder: o cinto do livre-pensador‡Знаки силы: пояс вольнодумца‡Symbole der Macht: Der Gürtel des Freidenkers‡마력의 보물: 자유사상가의 허리띠‡Dechados de Poder: el Cinturón de librepensador‡Dechados de Poder: el Cinturón de librepensador‡Parangons de puissance : la ceinture de libre-penseur‡权力珍宝：思考者腰带‡權力珍寶：思考者腰帶',
    nil,
    'Leve um Xale Hakkari Primevo a Jin\'rokh, o Rebentador, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Джин\'року Разрушителю изначальную лацерну Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarischal zu Jin\'rokh dem Zerstörer. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nJin\'rokh der Zerstörer befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 어깨걸이를 구해 가시덤불 골짜기의 요잠바 섬에 있는 파괴자 진로크에게 가져가야 합니다.|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Cercenador: un chal Hakkari primigenio. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nJin\'rokh el Cercenador está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Rompedor: un chal Hakkari primigenio. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nJin\'rokh el Rompedor está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Châle primordial hakkari à Jin’rokh le Briseur. La tribu Zandalar doit aussi vous Honorer (au minimum).|nJin’rokh le Briseur se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给击碎者金罗克：1条原始哈卡莱披肩。你还必须在赞达拉部族中达到尊敬或更高的声望。|n击碎者金罗克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給擊碎者金羅克：1條原始哈卡萊披肩。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n擊碎者金羅克在荊棘谷的尤亞姆巴島上。',
  }
},
[8055] = {
  {
    'Epítomes de poder: o peitoral do livre-pensador‡Знаки Силы: кираса вольнодумца‡Symbole der Macht: Die Brustplatte des Freidenkers‡마력의 보물: 자유사상가의 흉갑‡Dechados de Poder: el Peto de librepensador‡Dechados de Poder: la coraza de librepensador‡Parangons de puissance : la cuirasse de libre-penseur‡权力珍宝：思考者胸甲‡權力珍寶：思考者胸甲',
    nil,
    'Leve um Tabardo Hakkari Primevo a Jin\'rokh, o Rebentador, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Джин\'року Разрушителю Изначальную гербовую накидку Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkariwappenrock zu Jin\'rokh dem Zerstörer. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nJin\'rokh der Zerstörer befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 휘장을 구해 가시덤불 골짜기의 요잠바 섬에 있는 파괴자 진로크에게 가져가야 합니다.|n잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Cercenador: un tabardo Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nJin\'rokh el Cercenador está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Rompedor: un tabardo Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nJin\'rokh el Rompedor está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Tabard primordial hakkari à Jin\'rokh le Briseur. La tribu Zandalar doit aussi vous Révérer (au minimum).|nJin\'rokh le Briseur se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给击碎者金罗克：1条原始哈卡莱徽章。你还必须在赞达拉部族中达到崇敬或更高的声望。|n击碎者金罗克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給擊碎者金羅克：1條原始哈卡萊徽章。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n擊碎者金羅克在荊棘谷的尤亞姆巴島上。',
  }
},
[8056] = {
  {
    'Epítomes de poder: as braçadeiras do áugure‡Знаки Силы: наручи авгура‡Symbole der Macht: Die Armschienen des Weissagers‡마력의 보물: 점술가의 팔보호구‡Dechados de Poder: los Brazales de augur‡Dechados de Poder: los Brazales de augur‡Parangons de puissance : les brassards d\'augure‡权力珍宝：预言者护腕‡權力珍寶：預言者護腕',
    nil,
    'Leve uma Tala Hakkari Primeva a Maywiki de Zuldazar, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Майвики Зулдазарской Изначальные обручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nМайвики Зулдазарская живет на острове Йоджамба, в Тернистой долине.‡Bringt urzeitliche Hakkariarmsplinte zu Maywiki von Zuldazar. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nMaywiki von Zuldazar befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 어깨갑옷을 구해 가시덤불 골짜기의 요잠바 섬에 있는 줄다자르의 메이위키에게 가져가야 합니다.B|n또한 잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Maywiki de Zuldazar: un cabestrillo Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Maywiki de Zuldazar un cabestrillo Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez des Brachiales primordiales hakkari à Maywiki de Zuldazar. La tribu Zandalar doit aussi être Amicale envers vous (au minimum).|nMaywiki de Zuldazar se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给祖达萨的梅维克：1条原始哈卡莱护臂。你还必须在赞达拉部族中达到友善或更高的声望。|n祖达萨的梅维克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給祖達薩的梅維克：1條原始哈卡萊護臂。妳還必須在贊達拉部族中達到友善或更高的聲望。|n祖達薩的梅維克在荊棘谷的尤亞姆巴島上。',
  }
},
[8057] = {
  {
    'Epítomes de Poder: as braçadeiras do harúspice‡Знаки Силы: наручи гаруспика‡Symbole der Macht: Die Haruspexarmschienen‡마력의 보물: 제사장의 팔보호구‡Dechados de Poder: los Brazales de adivino‡Dechados de Poder: los brazales de haruspex‡Parangons de puissance : les brassards d\'haruspice‡权力珍宝：占卜师护腕‡權力珍寶：占蔔師護腕',
    nil,
    'Leve um Pilar Hakkari Primevo a Maywiki de Zuldazar, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Майвики Зулдазарской изначальный браслет Хаккари. Кроме того, вам необходимо заслужить как минимум дружественное отношение племени Зандалар.|nМайвики Зулдазарская находится на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Hakkaristütze zu Maywiki von Zuldazar. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nMaywiki von Zuldazar befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 손목갑옷을 구해 가시덤불 골짜기의 요잠바 섬에 있는 줄다자르의 메이위키에게 가져가야 합니다.|n잔달라 부족의 평판이 우호적 이상이어야만 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Maywiki de Zuldazar: un puntal Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Maywiki de Zuldazar un puntal Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Rapportez un Étançon primordial hakkari à Maywiki de Zuldazar. La tribu Zandalar doit aussi être Amicale (au minimum).|nMaywiki de Zuldazar se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给祖达萨的梅维克：1条原始哈卡莱直柱。你还必须在赞达拉部族中达到友好或更高的声望。|n祖达萨的梅维克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給祖達薩的梅維克：1條原始哈卡萊直柱。妳還必須在贊達拉部族中達到友好或更高的聲望。|n祖達薩的梅維克在荊棘谷的尤亞姆巴島上。',
  }
},
[8058] = {
  {
    'As epítomes do poder: as braçadeiras do vindicante‡Знаки Силы: боевые наручи блюстителя‡Symbole der Macht: Die Armschützer des Vollstreckers‡마력의 보물: 구원자의 손목보호대‡Dechados de Poder: los Guardabrazos de vindicador‡Dechados de Poder: los Guardabrazos de vindicador‡Parangons de puissance : les garde-bras de redresseur de torts‡权力珍宝：辩护者护臂‡權力珍寶：辯護者護臂',
    nil,
    'Leve uma Tala Hakkari Primeva a Jin\'rokh, o Rebentador. Sua reputação com a Tribo Zandalar precisa ser igual ou superior a <Amistoso/Amistosa>.|nJin\'rokh, o Rebentador, se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.‡Принесите Джин\'року Разрушителю изначальные обручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt urzeitliche Hakkariarmsplinte zu Jin\'rokh dem Zerstörer. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nJin\'rokh der Zerstörer befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 어깨갑옷을 구해 가시덤불 골짜기의 요잠바 섬에 있는 파괴자 진로크에게 가져가야 합니다.|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Cercenador: un cabestrillo Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nJin\'rokh el Cercenador está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Jin\'rokh el Rompedor un cabestrillo Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nJin\'rokh el Rompedor está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez des Brachiales primordiales hakkari à Jin\'rokh le Briseur. La tribu Zandalar doit aussi être Amicale envers vous (au minimum).|nJin\'rokh le Briseur se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给击碎者金罗克：1条原始哈卡莱护臂。你还必须在赞达拉部族中达到友善或更高的声望。|n击碎者金罗克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給擊碎者金羅克：1條原始哈卡萊護臂。妳還必須在贊達拉部族中達到友善或更高的聲望。|n擊碎者金羅克在荊棘谷的尤亞姆巴島上。',
  }
},
[8059] = {
  {
    'Epítomes de poder: as braçadeiras do demoníaco‡Знаки Силы: напульсники бесноватого‡Symbole der Macht: Die Handlappen des Besessenen‡마력의 보물: 악령술사의 손목띠‡Dechados de Poder: los Brazaletes de endemoniado‡Dechados de Poder: los Brazaletes de endemoniado‡Parangons de puissance : les couvre-bras de démoniaque‡权力珍宝：恶魔师裹带‡權力珍寶：惡魔師裹帶',
    nil,
    'Leve um Pilar Hakkari Primevo a Al\'tabim, que Tudo Vê. Sua reputação com a Tribo Zandalar precisa ser igual ou superior a <Amistoso/Amistosa>.|nAl\'tabim, que Tudo Vê, se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.‡Принесите Джин\'року Разрушителю изначальные обручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Hakkaristütze zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 손목갑옷을 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: un puntal Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve un puntal Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Etançon primordial hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi être Amicale (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1条原始哈卡莱直柱。你还必须在赞达拉部族中达到友善或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1條原始哈卡萊直柱。妳還必須在贊達拉部族中達到友善或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8060] = {
  {
    'Epítomes de poder: os braceletes do ilusionista‡Знаки Силы: напульсники мастера иллюзий‡Symbole der Macht: Die Handlappen des Illusionisten‡마력의 보물: 환영술사의 손목띠‡Dechados de Poder: los Brazaletes de ilusionista‡Dechados de Poder: los Brazaletes de ilusionista‡Parangons de puissance : les couvre-bras d’illusionniste‡权力珍宝：幻术师裹布‡權力珍寶：幻術師裹布',
    nil,
    'Leve as Braçadeiras Hakkari Primevas a Al\'tabim, que Tudo Vê, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Джин\'року Разрушителю изначальные обручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt urzeitliche Hakkaribindungen zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 팔보호구를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: una pretina Hakkari primigenia. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve unas ataduras Hakkari primigenias. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez des Manchettes primordiales hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi être Amicale (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给全知者阿塔比姆：1条原始哈卡莱护腕。你还必须在赞达拉部族中达到友善或更高的声望。|n全知者阿塔比姆克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給全知者阿塔比姆：1條原始哈卡萊護腕。妳還必須在贊達拉部族中達到友善或更高的聲望。|n全知者阿塔比姆克在荊棘谷的尤亞姆巴島上。',
  }
},
[8061] = {
  {
    'Epítomes de poder: as braçadeiras do confessor‡Знаки Силы: напульсники исповедника‡Symbole der Macht: Die Handlappen des Glaubenshüters‡마력의 보물: 성자의 손목띠‡Dechados de Poder: los Brazaletes de confesor‡Dechados de Poder: los Brazaletes de confesor‡Parangons de puissance : les couvre-bras de confesseur‡权力珍宝：忏悔者裹布‡權力珍寶：懺悔者裹布',
    nil,
    'Leve um Pilar Hakkari Primevo a Al\'tabim, que Tudo Vê, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Джин\'року Разрушителю изначальные обручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Hakkaristütze zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 손목갑옷을 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: un puntal Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve un puntal Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Etançon primordial hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi être Amicale (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1条原始哈卡莱直柱。你还必须在赞达拉部族中达到友善或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1條原始哈卡萊直柱。妳還必須在贊達拉部族中達到友善或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8062] = {
  {
    'Epítomes de poder: as braçadeiras do predador‡Знаки Силы: наручи хищника‡Symbole der Macht: Die Armschienen des Raubtiers‡마력의 보물: 수렵꾼의 팔보호구‡Dechados de Poder: los Brazales de depredador‡Dechados de Poder: los Brazales de depredador‡Parangons de puissance : les brassards de prédateur‡权力珍宝：捕猎者护腕‡權力珍寶：捕獵者護腕',
    nil,
    'Leve as Braçadeiras Hakkari Primevas a Falthir, o Cego, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Фальтиру Слепому из Зул\'Гуруба изначальные наручники Хаккари. Кроме того, вам необходимо заслужить как минимум дружественное отношение племени Зандалар.|nФальтир Слепой живет на острове Йоджамба, в Тернистой долине.‡Bringt das folgende Symbol der Macht aus Zul\'Gurub zu Falthir dem Blinden: Urzeitliche Hakkaribindungen. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nFalthir der Blinde befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 다음의 마력의 보물을 가시덤불 골짜기의 요잠바 섬에 있는 장님 팔디르에게 가져가야 합니다: 고대 학카리 팔보호구 1개|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: una pretina Hakkari primigenia. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar. Falthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: unas ataduras Hakkari primigenias. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez des Manchettes primordiales hakkari à Falthir le Sans-vue. La tribu Zandalar doit aussi être Amicale envers vous (au minimum).|nFalthir le Sans-vue se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给盲眼法希尔克：1条原始哈卡莱护腕。你还必须在赞达拉部族中达到友善或更高的声望。|n盲眼法希尔克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給盲眼法希爾克：1條原始哈卡萊護腕。妳還必須在贊達拉部族中達到友善或更高的聲望。|n盲眼法希爾克在荊棘谷的尤亞姆巴島上。',
  }
},
[8063] = {
  {
    'Epítomes de poder: as braçadeiras do lunático‡Знаки Силы: наручи безумца‡Symbole der Macht: Die Armschienen des Wildfangs‡마력의 보물: 개혁가의 팔보호구‡Dechados de Poder: los Brazales de sinconcierto‡Dechados de Poder: los Brazales de sinconcierto‡Parangons de puissance : les brassards d\'insensé‡权力珍宝：狂妄者护腕‡權力珍寶：狂妄者護腕',
    nil,
    'Leve uma Tala Hakkari Primeva a Falthir, o Cego, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Respeitado/Respeitada> pela Tribo Zandalar.‡Принесите Фальтиру Слепому изначальные обручья Хаккари. Кроме того, вам необходимо заслужить как минимум дружелюбное отношение племени Зандалар.|nФальтир Слепой живет на острове Йоджамба, в Тернистой долине.‡Bringt urzeitliche Hakkariarmsplinte zu Falthir dem Blinden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens freundlich oder höher sein.|nFalthir der Blinde befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 어깨갑옷을 구해 가시덤불 골짜기의 요잠바 섬에 있는 장님 팔디르에게 가져가야 합니다.|n잔달라 부족에게 약간 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: un cabestrillo Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: un cabestrillo Hakkari primigenio. También debes tener una reputación mínima de <amistoso/amistosa> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez des Brachiales primordiales hakkari à Falthir le Sans-vue. La tribu Zandalar doit aussi être Amicale envers vous (au minimum).|nFalthir le Sans-vue se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给盲眼法希尔：1条原始哈卡莱护腕。你还必须在赞达拉部族中达到友善或更高的声望。|n盲眼法希尔在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給盲眼法希爾：1條原始哈卡萊護腕。妳還必須在贊達拉部族中達到友善或更高的聲望。|n盲眼法希爾在荊棘谷的尤亞姆巴島上。',
  }
},
[8064] = {
  {
    'Epítomes de poder: o cinto do harúspice‡Знаки Силы: пояс гаруспика‡Symbole der Macht: Der Haruspexgürtel‡마력의 보물: 제사장의 허리띠‡Dechados de Poder: el Cinturón de adivino‡Dechados de Poder: el Cinturón de haruspex‡Parangons de puissance : la ceinture d\'haruspice‡权力珍宝：占卜师腰带‡權力珍寶：占蔔師腰帶',
    nil,
    'Leve uma Faixa Hakkari Primeva a Maywiki de Zuldazar, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Майвики Зулдазарской изначальный кушак Хаккари. Майвики Зулдазарская находится на острове Йоджамба, в Тернистой долине. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.‡Bringt eine urzeitliche Hakkarischärpe zu Maywiki von Zuldazar. Maywiki von Zuldazar befindet sich auf der Insel Yojamba im Schlingendorntal. Die Einstellung des Stammes der Zandalar muss Euch gegenüber außerdem wohlwollend sein.‡줄구룹에서 고대 학카리 장식띠를 구해 가시덤불 골짜기의 요잠바 섬에 있는 줄다자르의 메이위키에게 가져가야 합니다. 또한 잔달라 부족에게 우호적 이상의 평판을 얻어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Maywiki de Zuldazar: una banda Hakkari primigenia. Maywiki de Zuldazar está en Isla Yojamba, en Vega de Tuercespina. También debes tener una reputación de <honrado/honrada> con Zandalar.‡Lleva a Maywiki de Zuldazar un fajín hakkari primigenio. Maywiki de Zuldazar está en Isla Yojamba, en Vega de Tuercespina. También debes tener una reputación de honorable con Zandalar.‡Rapportez une Écharpe primordiale hakkari à Maywiki de Zuldazar. Maywiki de Zuldazar se trouve sur l’île de Yojamba, dans la vallée de Strangleronce. La tribu Zandalar doit aussi vous Honorer (au minimum).‡从祖尔格拉布把以下权力珍宝带给祖达萨的梅维克：1条原始哈卡莱腰带。你还必须在赞达拉部族中达到尊敬或更高的声望。|n祖达萨的梅维克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給祖達薩的梅維克：1條原始哈卡萊腰帶。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n祖達薩的梅維克在荊棘谷的尤亞姆巴島上。',
  }
},
[8065] = {
  {
    'Epítomes de poder: a túnica do harúspice‡Знаки Силы: мундир гаруспика‡Symbole der Macht: Die Haruspextunika‡마력의 보물: 제사장의 튜닉‡Dechados de Poder: la guerrera de haruspex‡Dechados de Poder: la guerrera de haruspex‡Parangons de puissance : la tunique d\'haruspice‡权力珍宝：占卜师外套‡權力珍寶：占蔔師外套',
    nil,
    'Leve um Tabardo Hakkari Primevo a Maywiki de Zuldazar, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Майвики Зулдазарской Изначальную гербовую накидку Хаккари.|nМайвики Зулдазарская находится на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkariwaffenrock zu Maywiki von Zuldazar. Maywiki von Zuldazar befindet sich auf der Insel Yojamba im Schlingendorntal. Die Einstellung des Stammes der Zandalar muss Euch gegenüber außerdem respektvoll sein.‡줄구룹에서 고대 학카리 휘장을 구해 가시덤불 골짜기의 요잠바 섬에 있는 줄다자르의 메이위키에게 가져가야 합니다. 또한 잔달라 부족에게 매우 우호적 이상의 평판을 얻어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Maywiki de Zuldazar: un tabardo Hakkari primigenio. Maywiki de Zuldazar está en Isla Yojamba, en Vega de Tuercespina. También debes tener una reputación de <venerado/venerada> con Zandalar.‡Lleva a Maywiki de Zuldazar un tabardo Hakkari primigenio. Maywiki de Zuldazar está en Isla Yojamba, en Vega de Tuercespina. También debes tener una reputación de <venerado/venerada> con Zandalar.‡Rapportez un Tabard primordial hakkari à Maywiki de Zuldazar. Maywiki de Zuldazar se trouve sur l’île de Yojamba, dans la vallée de Strangleronce. La tribu Zandalar doit aussi vous Révérer (au minimum).‡从祖尔格拉布把以下权力珍宝带给祖达萨的梅维克：1条原始哈卡莱徽章。你还必须在赞达拉部族中达到崇敬或更高的声望。|n祖达萨的梅维克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給祖達薩的梅維克：1條原始哈卡萊徽章。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n祖達薩的梅維克在荊棘谷的尤亞姆巴島上。',
  }
},
[8066] = {
  {
    'Epítomes de poder: o cinto do predador‡Знаки Силы: пояс хищника‡Symbole der Macht: Der Gürtel des Raubtiers‡마력의 보물: 수렵꾼의 허리띠‡Dechados de Poder: el Cinturón de predador‡Dechados de Poder: el Cinturón de depredador‡Parangons de puissance : la ceinture de prédateur‡权力珍宝：捕猎者腰带‡權力珍寶：捕獵者腰帶',
    nil,
    'Leve um Xale Hakkari Primevo a Falthir, o Cego, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Фальтиру Слепому из Зул\'Гуруба изначальную лацерну Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nФальтир Слепой живет на острове Йоджамба, в Тернистой долине.‡Bringt das folgende Symbol der Macht aus Zul\'Gurub zu Falthir dem Blinden: Einen urzeitlichen Hakkarischal. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nFalthir der Blinde befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 다음의 마력의 보물을 구해 가시덤불 골짜기의 요잠바 섬에 있는 장님 팔디르에게 가져가야 합니다: 고대 학카리 어깨걸이 1개|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: un chal Hakkari primigenio. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: un chal Hakkari primigenio. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Châle primordial hakkari à Falthir le Sans-vue. La tribu Zandalar doit aussi vous Honorer (au minimum).|nFalthir le Sans-vue se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给盲眼法希尔：1条原始哈卡莱披肩。你还必须在赞达拉部族中达到尊敬或更高的声望。|n盲眼法希尔在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給盲眼法希爾：1條原始哈卡萊披肩。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n盲眼法希爾在荊棘谷的尤亞姆巴島上。',
  }
},
[8067] = {
  {
    'Epítomes de poder: as dragonas do predador‡Знаки Силы: оплечье хищника‡Symbole der Macht: Der Mantel des Raubtiers‡마력의 보물: 수렵꾼의 어깨보호대‡Dechados de Poder: el Manto de depredador‡Dechados de Poder: el Manto de depredador‡Parangons de puissance : le mantelet de prédateur‡权力珍宝：捕猎者衬肩‡權力珍寶：捕獵者襯肩',
    nil,
    'Leve a Égide Hakkari Primeva a Falthir, o Cego, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Фальтиру Слепому из Зул\'Гуруба изначальную эгиду Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nФальтир Слепой живет на острове Йоджамба, в Тернистой долине.‡Bringt das folgende Symbol der Macht aus Zul\'Gurub zu Falthir dem Blinden: Eine urzeitliche Aegis der Hakkari. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nFalthir der Blinde befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 다음의 마력의 보물을 구해 가시덤불 골짜기의 요잠바 섬에 있는 장님 팔디르에게 가져가야 합니다: 고대 학카리 아이기스 1개|n잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: unos auspicios Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar. Falthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: una égida Hakkari primigenia. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Egide primordiale hakkari à Falthir le Sans-vue. La tribu Zandalar doit aussi vous Révérer (au minimum).|nFalthir le Sans-vue se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给盲眼法希尔：1块原始哈卡莱盾牌。你还必须在赞达拉部族中达到崇敬或更高的声望。|n盲眼法希尔在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給盲眼法希爾：1塊原始哈卡萊盾牌。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n盲眼法希爾在荊棘谷的尤亞姆巴島上。',
  }
},
[8068] = {
  {
    'Epítomes de poder: as dragonas do ilusionista‡Знаки Силы: оплечье мастера иллюзий‡Symbole der Macht: Der Mantel des Illusionisten‡마력의 보물: 환영술사의 어깨보호대‡Dechados de Poder: el Manto de ilusionista‡Dechados de Poder: el Manto de ilusionista‡Parangons de puissance : le mantelet d’illusionniste‡权力珍宝：幻术师衬肩‡權力珍寶：幻術師襯肩',
    nil,
    'Leve um Xale Hakkari Primevo a Al\'tabim, que Tudo Vê, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Ал\'табиму Всевидящему изначальную лацерну Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nАльтабим Всевидящий живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarischal zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 어깨걸이를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: un chal Hakkari primigenio. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve un chal Hakkari primigenio. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Châle primordial hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi vous Honorer (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1条原始哈卡莱披肩。你还必须在赞达拉部族中达到尊敬或更高的声望。|n全知者阿塔比姆克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1條原始哈卡萊披肩。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n全知者阿塔比姆克在荊棘谷的尤亞姆巴島上。',
  }
},
[8069] = {
  {
    'Epítomes de poder: a veste do ilusionista‡Знаки Силы: одеяние мастера иллюзий‡Symbole der Macht: Die Roben des Illusionisten‡마력의 보물: 환영술사의 로브‡Dechados de Poder: la Toga de ilusionista‡Dechados de Poder: la Toga de ilusionista‡Parangons de puissance : la robe d’illusionniste‡权力珍宝：幻术师长袍‡權力珍寶：幻術師長袍',
    nil,
    'Leve um Gibão Hakkari Primevo a Al\'tabim, que Tudo Vê, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Ал\'табиму Всевидящему изначальную рубашку Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nАльтабим Всевидящий живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarikosak Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 조끼를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: un cosaco Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve una casaca hakkari primigenia. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Casaque primordiale hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi vous Révérer (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1块原始哈卡莱套索。你还必须在赞达拉部族中达到崇敬或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1塊原始哈卡萊套索。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8070] = {
  {
    'Epítomes de poder: o cinturão do confessor‡Знаки Силы: пояс исповедника‡Symbole der Macht: Die Bindungen des Glaubenshüters‡마력의 보물: 성자의 허리띠‡Dechados de Poder: las Ataduras de confesor‡Dechados de Poder: las Ataduras de confesor‡Parangons de puissance : le cordon de confesseur‡权力珍宝：忏悔者腰带‡權力珍寶：懺悔者腰帶',
    nil,
    'Leve uma Faixa Hakkari Primeva a Al\'tabim, que Tudo Vê, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Ал\'табиму Всевидящему изначальный кушак Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nАл\'табим Всевидящий живет на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Hakkarischärpe zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 장식띠를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: una banda Hakkari primigenia. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve un fajín hakkari primigenio. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Echarpe primordiale hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi vous Honorer (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1条原始哈卡莱腰带。你还必须在赞达拉部族中达到尊敬或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1條原始哈卡萊腰帶。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8071] = {
  {
    'Epítomes de poder: as dragonas do confessor‡Знаки Силы: оплечье исповедника‡Symbole der Macht: Der Mantel des Glaubenshüters‡마력의 보물: 성자의 어깨보호대‡Dechados de Poder: el Manto de confesor‡Dechados de Poder: el Manto de confesor‡Parangons de puissance : le mantelet de confesseur‡权力珍宝：忏悔者衬肩‡權力珍寶：懺悔者襯肩',
    nil,
    'Leve uma Égide Hakkari Primeva a Al\'tabim, que Tudo Vê, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Ал\'табиму Всевидящему изначальную эгиду Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nАл\'табим Всевидящий живет на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Aegis der Hakkari zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 아이기스를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: unos auspicios Hakkari primigenios. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve una égida Hakkari primigenia. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Egide primordiale hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi vous Révérer (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1块原始哈卡莱之盾。你还必须在赞达拉部族中达到崇敬或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1塊原始哈卡萊之盾。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8072] = {
  {
    'Epítomes de poder: as dragonas do lunático‡Знаки Силы: оплечье безумца‡Symbole der Macht: Der Mantel des Wildfangs‡마력의 보물: 개혁가의 어깨보호대‡Dechados de Poder: el Manto de sinconcierto‡Dechados de Poder: el Manto de sinconcierto‡Parangons de puissance : le mantelet d\'insensé‡权力珍宝：狂妄者衬肩‡權力珍寶：狂妄者襯肩',
    nil,
    'Leve um Cinturão Hakkari Primevo a Falthir, o Cego, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Фальтиру Слепому изначальный ремень Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nФальтир Слепой живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarigurt zu Falthir dem Blinden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nFalthir der Blinde befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 벨트를 구해 가시덤불 골짜기의 요잠바 섬에 있는 장님 팔디르에게 가져가야 합니다.|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: una faja Hakkari primigenia. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: una faja Hakkari primigenia. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Ceinturon primordial hakkari à Falthir le Sans-vue. La tribu Zandalar doit aussi vous Honorer (au minimum).|nFalthir le Sans-vue se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给盲眼法希尔：1条原始哈卡莱束带。你还必须在赞达拉部族中达到尊敬或更高的声望。|n盲眼法希尔在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給盲眼法希爾：1條原始哈卡萊束帶。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n盲眼法希爾在荊棘谷的尤亞姆巴島上。',
  }
},
[8073] = {
  {
    'Epítomes de poder: a túnica do lunático‡Знаки Силы: мундир безумца‡Symbole der Macht: Die Tunika des Wildfangs‡마력의 보물: 개혁가의 튜닉‡Dechados de Poder: la guerrera de sinconcierto‡Dechados de Poder: la guerrera de sinconcierto‡Parangons de puissance : la tunique d\'insensé‡权力珍宝：狂妄者外套‡權力珍寶：狂妄者外套',
    nil,
    'Leve uma Égide Hakkari Primeva a Falthir, o Cego, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Фальтиру Слепому из Зул-Гуруба изначальную эгиду Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nФальтир Слепой живет на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Aegis der Hakkari zu Falthir dem Blinden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nFalthir der Blinde befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 아이기스를 구해 가시덤불 골짜기의 요잠바 섬에 있는 장님 팔디르에게 가져가야 합니다.|n잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Falthir el Ciego: unos auspicios Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar. Falthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Falthir el Ciego una égida Hakkari primigenia. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nFalthir el Ciego está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Egide primordiale hakkari à Falthir le Sans-vue. La tribu Zandalar doit aussi vous Révérer (au minimum).|nFalthir le Sans-vue se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给盲眼法希尔：1块原始哈卡莱之盾。你还必须在赞达拉部族中达到崇敬或更高的声望。|n盲眼法希尔在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給盲眼法希爾：1塊原始哈卡萊之盾。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n盲眼法希爾在荊棘谷的尤亞姆巴島上。',
  }
},
[8074] = {
  {
    'Epítomes de poder: o cinto do áugure‡Знаки Силы: пояс авгура‡Symbole der Macht: Der Gürtel des Weissagers‡마력의 보물: 점술가의 허리띠‡Dechados de Poder: el Cinturón de augur‡Dechados de Poder: el Cinturón de augur‡Parangons de puissance : la ceinture d\'augure‡权力珍宝：预言者腰带‡權力珍寶：預言者腰帶',
    nil,
    'Leve um Cinturão Hakkari Primevo a Maywiki de Zuldazar, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Honrado/Honrada> pela Tribo Zandalar.‡Принесите Майвики Зулдазарской изначальный ремень Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nМайвики Зулдазарская находится на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarigurt zu Maywiki von Zuldazar. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nMaywiki von Zuldazar befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 벨트를 구해 가시덤불 골짜기의 요잠바 섬에 있는 줄다자르의 메이위키에게 가져가야 합니다.|n또한 잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Maywiki de Zuldazar: una faja Hakkari primigenia. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Maywiki de Zuldazar una faja Hakkari primigenia. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Ceinturon primordial hakkari à Maywiki de Zuldazar. La tribu Zandalar doit aussi vous Honorer (au minimum).|nMaywiki de Zuldazar se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给祖达萨的梅维克：1条原始哈卡莱束带。你还必须在赞达拉部族中达到尊敬或更高的声望。|n祖达萨的梅维克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給祖達薩的梅維克：1條原始哈卡萊束帶。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n祖達薩的梅維克在荊棘谷的尤亞姆巴島上。',
  }
},
[8075] = {
  {
    'Epítomes de poder: a cota do áugure‡Знаки Силы: хауберк авгура‡Symbole der Macht: Die Halsberge des Weissagers‡마력의 보물: 점술가의 갑옷‡Dechados de Poder: el Camisote de augur‡Dechados de Poder: el Camisote de augur‡Parangons de puissance : le haubert d\'augure‡权力珍宝：预言者外套‡權力珍寶：預言者外套',
    nil,
    'Leve um Tabardo Hakkari Primevo a Maywiki de Zuldazar, que se encontra na Ilha Yojamba, que fica na Selva do Espinhaço. Você precisa ser no mínimo <Reverenciado/Reverenciada> pela Tribo Zandalar.‡Принесите Майвики Зулдазарской изначальную гербовую накидку Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nМайвики Зулдазарская находится на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkariwaffenrock zu Maywiki von Zuldazar. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nMaywiki von Zuldazar befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 휘장을 구해 가시덤불 골짜기의 요잠바 섬에 있는 줄다자르의 메이위키에게 가져가야 합니다.|n또한 잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Maywiki de Zuldazar: un tabardo Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Maywiki de Zuldazar un tabardo Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nMaywiki de Zuldazar está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Tabard primordial hakkari à Maywiki de Zuldazar. La tribu Zandalar doit aussi vous Révérer (au minimum).|nMaywiki de Zuldazar se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给祖达萨的梅维克：1条原始哈卡莱徽章。你还必须在赞达拉部族中达到崇敬或更高的声望。|n祖达萨的梅维克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給祖達薩的梅維克：1條原始哈卡萊徽章。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n祖達薩的梅維克在荊棘谷的尤亞姆巴島上。',
  }
},
[8076] = {
  {
    'Epítomes de poder: as dragonas do demoníaco‡Знаки Силы: оплечье бесноватого‡Symbole der Macht: Der Mantel des Besessenen‡마력의 보물: 악령술사의 어깨보호대‡Dechados de Poder: el Manto de endemoniado‡Dechados de Poder: el Manto de endemoniado‡Parangons de puissance : le mantelet de démoniaque‡权力珍宝：恶魔师衬肩‡權力珍寶：惡魔師襯肩',
    nil,
    'Leve uma Faixa Hakkari Primeva a Al\'tabim, que Tudo Vê. Sua reputação com a Tribo Zandalar precisa ser igual ou superior a <Honrado/Honrada>.|nAl\'tabim, que Tudo Vê, se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.‡Принесите Ал\'табиму Всевидящему изначальный кушак Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nАл\'табим Всевидящий живет на острове Йоджамба, в Тернистой долине.‡Bringt eine urzeitliche Hakkarischärpe zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 장식띠를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: una banda Hakkari primigenia. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve un fajín hakkari primigenio. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Echarpe primordiale hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi vous Honorer (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1条原始哈卡莱腰带。你还必须在赞达拉部族中达到尊敬或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1條原始哈卡萊腰帶。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8077] = {
  {
    'Epítomes de poder: a veste do demoníaco‡Знаки Силы: одеяние бесноватого‡Symbole der Macht: Die Roben des Besessenen‡마력의 보물: 악령술사의 로브‡Dechados de Poder: la Toga de endemoniado‡Dechados de Poder: la Toga de endemoniado‡Parangons de puissance : la robe de démoniaque‡权力珍宝：恶魔师长袍‡權力珍寶：惡魔師長袍',
    nil,
    'Leve um Gibão Hakkari Primevo a Al\'tabim, que Tudo Vê. Sua reputação com a Tribo Zandalar precisa ser igual ou superior a <Reverenciado/Reverenciada>.|nAl\'tabim, que Tudo Vê, se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.‡Принесите Ал\'табиму Всевидящему изначальную рубашку Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nАл\'табим Всевидящий живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarikosak zu Al\'tabim dem Allsehenden. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nAl\'tabim der Allsehende befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 조끼를 구해 가시덤불 골짜기의 요잠바 섬에 있는 천리안 알타빔에게 가져가야 합니다.|n잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Al\'tabim el que todo lo ve: un cosaco Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Al\'tabim el que todo lo ve una casaca hakkari primigenia. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nAl\'tabim el que todo lo ve está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Casaque primordiale hakkari à Al’tabim Qui-voit-tout. La tribu Zandalar doit aussi vous Révérer (au minimum).|nAl’tabim Qui-voit-tout se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝交给全知者阿塔比姆：1块原始哈卡莱套索。你还必须在赞达拉部族中达到崇敬或更高的声望。|n全知者阿塔比姆在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶交給全知者阿塔比姆：1塊原始哈卡萊套索。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n全知者阿塔比姆在荊棘谷的尤亞姆巴島上。',
  }
},
[8078] = {
  {
    'Epítomes de poder: o cinto do vindicante‡Знаки Силы: пояс блюстителя‡Symbole der Macht: Der Gürtel des Vollstreckers‡마력의 보물: 구원자의 허리띠‡Dechados de Poder: el Cinturón de vindicador‡Dechados de Poder: el Cinturón de vindicador‡Parangons de puissance : la ceinture de redresseur de torts‡权力珍宝：辩护者腰带‡權力珍寶：辯護者腰帶',
    nil,
    'Leve um Cinturão Hakkari Primevo a Jin\'rokh, o Rebentador. Sua reputação com a Tribo Zandalar precisa ser igual ou superior a <Honrado/Honrada>.|nJin\'rokh, o Rebentador, se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.‡Принесите Джин\'року Разрушителю изначальный ремень Хаккари. Кроме того, вам необходимо заслужить как минимум уважительное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarigurt zu Jin\'rokh dem Zerstörer. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens wohlwollend oder höher sein.|nJin\'rokh der Zerstörer befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 벨트를 구해 가시덤불 골짜기의 요잠바 섬에 있는 파괴자 진로크에게 가져가야 합니다.|n잔달라 부족에게 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Cercenador: una faja Hakkari primigenia. También debes tener una reputación mínima de <honrado/honrada> con la tribu Zandalar.|nJin\'rokh el Cercenador está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Jin\'rokh el Rompedor una faja Hakkari primigenia. También debes tener una reputación mínima de honorable con la tribu Zandalar.|nJin\'rokh el Rompedor está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez un Ceinturon primordial hakkari à Jin’rokh le Briseur. La tribu Zandalar doit aussi vous Honorer (au minimum).|nJin’rokh le Briseur se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给击碎者金罗克：1条原始哈卡莱束带。你还必须在赞达拉部族中达到尊敬或更高的声望。|n击碎者金罗克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給擊碎者金羅克：1條原始哈卡萊束帶。妳還必須在贊達拉部族中達到尊敬或更高的聲望。|n擊碎者金羅克在荊棘谷的尤亞姆巴島上。',
  }
},
[8079] = {
  {
    'Epítomes de poder: o peitoral do vindicante‡Знаки Силы: кираса блюстителя‡Symbole der Macht: Die Brustplatte des Vollstreckers‡마력의 보물: 구원자의 흉갑‡Dechados de Poder: el Peto de vindicador‡Dechados de Poder: la coraza de vindicador‡Parangons de puissance : la cuirasse de redresseur de torts‡权力珍宝：辩护者胸甲‡權力珍寶：辯護者胸甲',
    nil,
    'Leve um Gibão Hakkari Primevo a Jin\'rokh, o Rebentador. Sua reputação com a Tribo Zandalar precisa ser igual ou superior a <Reverenciado/Reverenciada>.|nJin\'rokh, o Rebentador, se encontra na Ilha Yojamba, que fica na Selva do Espinhaço.‡Принесите Джин\'року Разрушителю изначальную рубашку Хаккари. Кроме того, вам необходимо заслужить как минимум почтительное отношение племени Зандалар.|nДжин\'рок Разрушитель живет на острове Йоджамба, в Тернистой долине.‡Bringt einen urzeitlichen Hakkarikosak zu Jin\'rokh dem Zerstörer. Die Einstellung des Stammes der Zandalar muss Euch gegenüber wenigstens respektvoll oder höher sein.|nJin\'rokh der Zerstörer befindet sich auf der Insel Yojamba im Schlingendorntal.‡줄구룹에서 고대 학카리 조끼를 구해 가시덤불 골짜기의 요잠바 섬에 있는 파괴자 진로크에게 가져가야 합니다.|n또한 잔달라 부족에게 매우 우호적 이상의 평판이어야 합니다.‡Lleva los siguientes Dechados de Poder de Zul\'Gurub a Jin\'rokh el Cercenador: un cosaco Hakkari primigenio. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nJin\'rokh el Cercenador está en Isla Yojamba, en la Vega de Tuercespina.‡Lleva a Jin\'rokh el Rompedor una casaca hakkari primigenia. También debes tener una reputación mínima de <venerado/venerada> con la tribu Zandalar.|nJin\'rokh el Rompedor está en Isla Yojamba, en la Vega de Tuercespina.‡Ramenez une Casaque primordiale hakkari à Jin’rokh le Briseur. La tribu Zandalar doit aussi vous Révérer (au minimum).|nJin’rokh le Briseur se trouve sur l’île de Yojamba, dans la vallée de Strangleronce.‡从祖尔格拉布把以下权力珍宝带给击碎者金罗克：1条原始哈卡莱套索。你还必须在赞达拉部族中达到崇敬或更高的声望。|n击碎者金罗克在荆棘谷的尤亚姆巴岛上。‡從祖爾格拉布把以下權力珍寶帶給擊碎者金羅克：1條原始哈卡萊套索。妳還必須在贊達拉部族中達到崇敬或更高的聲望。|n擊碎者金羅克在荊棘谷的尤亞姆巴島上。',
  }
},
[8080] = {
  {
    'Recursos da Bacia Arathi!‡Ресурсы Низины Арати‡Die Ressourcen des Arathibeckens‡아라시 분지 자원!‡Los recursos de la Cuenca de Arathi‡Los recursos de la Cuenca de Arathi‡Les ressources du bassin d\'Arathi‡阿拉希盆地的资源！‡阿拉希盆地的資源！',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com a Sargento Martina na Ponta do Refúgio.‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Макчисту в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Sergeant Maclear in der Zuflucht.‡아라시 분지의 전투를 승리로 이끌고 아라시 보급품 상자를 구해 임시 주둔지에 있는 하사관 매클리어에게 가져가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一只阿拉希资源箱，然后向避难谷地的玛克里尔中士复命。‡獲得阿拉希盆地戰鬥的勝利，獲取壹只阿拉希資源箱，然後向避難谷地的瑪克裏爾中士復命。',
  }
},
[8081] = {
  {
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Макчисту в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Unteroffizier Maclear in der Zuflucht.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一个阿拉希资源木箱，然后向避难谷地的玛克里尔中士覆命。‡',
  }
},
