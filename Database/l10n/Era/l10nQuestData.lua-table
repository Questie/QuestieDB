},
[2859] = {
  {
    'Perneiras de couro silvestre‡Дикарские кожаные поножи‡Wildledergamaschen‡야생 가죽 다리보호구‡Leotardos de cuero salvaje‡Leotardos de cuero salvaje‡Les jambières en cuir sauvage‡蛮皮护腿‡蠻皮護腿',
    nil,
    'Leve 2 Elmos de Escama de Tartaruga, 2 Braçadeiras de Escama de Tartaruga e 2 Vinhas Selvagens para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите два шлема из черепашьего панциря, две пары черепашьих чешуйчатых наручей и два экземпляра дикого винограда Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Swiftstrider im Camp Mojache 2 Schildkrötenschuppenhelme, 2 Schildkrötenschuppenarmschienen und 2 Wildranken.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 거북 껍질 투구 2개, 거북 껍질 팔보호구 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Casques en écailles de tortue, 2 Brassards en écailles de tortue et 2 Sauvageonnes à Jangdor Swiftstrider au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2顶龟鳞头盔、2副龟鳞护腕和2株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2頂龜鱗頭盔、2副龜鱗護腕和2株野葡萄。',
  }
},
[2860] = {
  {
    'Mestre do couro silvestre‡Мастер школы Дикаря‡Meister des Wildleders‡야생 가죽 세공의 대가‡Maestro de cuero salvaje‡Maestro de cuero salvaje‡Maître du cuir sauvage‡蛮皮护甲大师‡蠻皮護甲大師',
    nil,
    'Entregue a Carta de Jangdor para Una, a mestre coureira do Penhasco do Trovão.‡Отдайте письмо Джангора Уне, главному кожевнику Громового Утеса.‡Gebt Una, der Lederverarbeitungsmeisterin von Thunder Bluff, Jangdors Schreiben.‡썬더 블러프에 있는 가죽 세공의 대가인 우나에게 장도르의 편지를 가져가야 합니다.‡Entrega la carta de Jangdor a Una, el maestro curtidor de Cima del Trueno.‡Entrega la carta de Jangdor a Una, el maestro curtidor de Cima del Trueno.‡Donner la Lettre de Jangdor à Una, le Maître tanneur de Thunder Bluff.‡将杉多尔的信交给雷霆崖的制皮大师犹纳。‡將杉多爾的信交給雷霆崖的制皮大師猶納。',
  }
},
[2861] = {
  {
    'A tarefa de Tabetha‡Миссия Табеты‡Tabethas Aufgabe‡타베사의 임무‡La tarea de Tabetha‡La tarea de Tabetha‡La mission de Tabetha‡塔贝萨的任务‡塔貝薩的任務',
    nil,
    'Fale com Tabetha no Pântano Vadeoso.‡Поговорите с Табетой в Пылевых топях.‡Sprecht mit Tabetha in den Marschen von Dustwallow.‡먼지진흙 습지대에 있는 타베사와 대화하십시오.‡Habla con Tabetha en el Marjal Revolcafango.‡Habla con Tabetha en el Marjal Revolcafango.‡Parler à Tabetha dans le marécage d\'Âprefange.‡与尘泥沼泽的塔贝萨谈一谈。‡與塵泥沼澤的塔貝薩談壹談。',
  }
},
[2862] = {
  {
    'Patábua mole em guerra dura‡Война с племенем Древолапов‡Krieg gegen die Waldpfoten‡덩굴발일족과의 전투‡En guerra con los Zarpaleña‡En guerra con los Zarpaleña‡La guerre avec les Griffebois‡与豺狼人开战‡與豺狼人開戰',
    nil,
    'Leve 10 Jubas de Gnoll Patábua para Hadoken Passo Veloz na Aldeia Mojache.‡Принесите 10 грив гноллов-древолапов Хадокену Быстрому Страннику в Лагере Мохаче.‡Bringt Hadoken Swiftstrider im Camp Mojache 10 Mähnen eines Waldpfotengnolls.‡모자케 야영지에 있는 아도겐 스위프트스트라이더에게 덩굴발일족 갈기 10개를 가져가야 합니다.‡Lleva 10 cabelleras de los gnolls Zarpaleña a Hadoken Zancoveloz al Campamento Mojache.‡Lleva 10 cabelleras de gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Rapporter 10 Crinières de gnolls Griffebois à Hadoken Swiftstrider au Camp Mojache.‡将10份木爪豺狼人的鬃毛交给莫沙彻营地的哈杜肯·迅蹄。‡將10份木爪豺狼人的鬃毛交給莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[2863] = {
  {
    'Golpe Alfa‡Истребление вожаков‡Schlag gegen die Alphas‡우두머리 공격‡Ataca a los Alfas‡Ataca a los Alfas‡Frappe sur les Alphas‡突然袭击‡突然襲擊',
    nil,
    'Mate 5 Machos Alfa Patábua e fale novamente com Hadoken Passo Veloz em uma hora.‡Убейте в течение часа 5 вожаков стаи Древолапов и вернитесь к Хадокену Быстрому Страннику.‡Tötet 5 Alphas der Waldpfoten und kehrt innerhalb einer Stunde zu Hadoken Swiftstrider zurück.‡1시간 안에 덩굴발일족 우두머리 5마리를 처치하고 아도겐 스위프트스트라이더에게 되돌아와야 합니다.‡Mata a 5 Alfas Zarpaleña y vuelve con Hadoken Zancoveloz en 1 hora.‡Mata a 5 Alfas Zarpaleña y vuelve con Hadoken Zanco Veloz en 1 hora.‡Tuer 5 Alphas Griffebois et retourner voir Hadoken Swiftstrider en moins d\'une heure.‡在1个小时内杀死5个木爪突击队员，并向哈杜肯·迅蹄汇报。‡在1個小時內殺死5個木爪突擊隊員，並向哈杜肯·迅蹄匯報。',
  }
},
[2864] = {
  {
    'Tran\'rek‡Тран\'рек‡Tran\'rek‡트란렉‡Tran\'rek‡Tran\'rek‡Tran\'rek‡特兰雷克‡特蘭雷克',
    nil,
    'Fale com Tran\'rek em Geringontzan.‡Поговорите с Тран\'реком в Прибамбасске.‡Sprecht mit Tran’rek in Gadgetzan.‡가젯잔에 있는 트란렉과 대화해야 합니다.‡Habla con Tran\'rek en Gadgetzan.‡Habla con Tran\'rek en Gadgetzan.‡Parler à Tran\'rek à Gadgetzan.‡与加基森的特兰雷克谈一谈。‡與加基森的特蘭雷克談壹談。',
  }
},
[2865] = {
  {
    'Couraças de escaravelho‡Панцири скарабеев‡Skarabäuspanzerschalen‡왕쇠똥구리 껍질‡Caparazones de escarabajo‡Caparazones de escarabajo‡Les carapaces de Scarabées‡圣甲虫的壳‡聖甲蟲的殼',
    nil,
    'Leve 5 Couraças de Escaravelho Fechadas para Tran\'rek em Geringontzan.‡Принести 5 целых панцирей скарабея Тран\'реку в Прибамбасск.‡Bringt Tran’rek in Gadgetzan 5 unbeschädigte Skarabäuspanzerschalen.‡가젯잔에 있는 트란렉에게 온전한 왕쇠똥구리 껍질 5개를 가져가야 합니다.‡Lleva 5 caparazones de escarabajos sin grietas a Tran\'rek en Gadgetzan.‡Lleva 5 caparazones de escarabajo sin rajar a Tran\'rek en Gadgetzan.‡Rapporter 5 Carapaces de scarabée intactes à Tran\'rek à Gadgetzan.‡给加基森的特兰雷克带去5个完整的圣甲虫壳。‡給加基森的特蘭雷克帶去5個完整的聖甲蟲殼。',
  }
},
[2866] = {
  {
    'As Ruínas de Solarsal‡Руины Соларсаля‡Die Ruinen von Solarsal‡솔라살 폐허‡Las Ruinas de Solarsal‡Las Ruinas de Solarsal‡Les ruines de Solarsal‡索兰萨尔废墟‡索蘭薩爾廢墟',
    nil,
    'Explore as Ruínas de Solarsal e investigue a presença das nagas.‡Обследуйте руины Соларсаля на предмет присутствия наг.‡Erforscht die Ruinen von Solarsal und findet etwas über die Anwesenheit der Naga dort heraus.‡솔라살 폐허를 탐사하고 그곳에 있는 나가의 실태를 조사해야 합니다.‡Explora las Ruinas de Solarsal e investiga la presencia de los nagas allí.‡Explora las Ruinas de Solarsal e investiga la presencia de los nagas allí.‡Explorer les ruines de Solarsal et enquêter sur la présence des nagas dans le secteur.‡探索索兰萨尔废墟，并调查纳迦在那个地区的情况。‡探索索蘭薩爾廢墟，並調查納迦在那個地區的情況。',
  }
},
[2867] = {
  {
    'Regresso ao Domínio de Plumaluna‡Возвращение в Крепость Оперенной Луны‡Kehrt zur Festung Feathermoon zurück‡페더문 요새로 돌아가기‡Regresa al Bastión Plumaluna‡Regresa al Bastión Plumaluna‡Retourner au bastion de Feathermoon‡返回羽月要塞‡返回羽月要塞',
    nil,
    'Fale novamente com Shandris Plumaluna no Domínio de Plumaluna e relate suas descobertas.‡Вернитесь в Крепость Оперенной Луны к Шандрисе Оперенной Луне и доложите о находке.‡Kehrt zu Shandris Feathermoon in der Festung Feathermoon zurück und berichtet von Euren Entdeckungen.‡페더문 요새에 있는 샨드리스 페더문에게 돌아가 발견한 것에 대해 보고해야 합니다.‡Vuelve al Bastión Plumaluna e informa a Shandris Plumaluna del resultado de tu exploración.‡Vuelve al Bastión Plumaluna e informa a Shandris Plumaluna del resultado de tu exploración.‡Retourner voir Shandris Feathermoon au bastion de Feathermoon et lui rendre compte de vos découvertes.‡向羽月要塞的珊蒂斯·羽月汇报你的发现。‡向羽月要塞的珊蒂斯·羽月匯報妳的發現。',
  }
},
[2868] = {
  {
    '‡‡‡‡‡<TXT> The Shriveled Heart‡‡‡',
    nil,
    nil,
  }
},
[2869] = {
  {
    'Cruzada contra as Cristafúrias‡Борьба с Гребнем Ненависти‡Gegen die Hasskämme‡증오의갈기일족과의 전투‡En contra de los Crestafuria‡En contra de los Crestafuria‡Contre les Hainecrête‡憎世纳迦之战‡憎世納迦之戰',
    nil,
    'Leve 10 Escamas de Naga Cristafúria para Latrônicus Lunalança no Domínio de Plumaluna.‡Принесите 10 штук чешуи наг из клана Гребня Ненависти Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Bringt Latronicus Moonspear in der Festung Feathermoon 10 Nagaschuppen der Hasskämme.‡페더문 요새에 있는 라트로니쿠스 문스피어에게 증오의갈기 나가 비늘 10개를 가져가야 합니다.‡Consigue 10 escamas de naga Crestafuria para Latronicus Lanzaluna en el Bastión Plumaluna.‡Consigue 10 escamas de naga Crestafuria para Latronicus Lanzaluna en el Bastión Plumaluna.‡Rapporter 10 Ecailles de naga Hainecrête à Latronicus Moonspear au bastion de Feathermoon.‡收集10块憎世纳迦的鳞片，把它们交给羽月要塞的拉托尼库斯·月矛。‡收集10塊憎世納迦的鱗片，把它們交給羽月要塞的拉托尼庫斯·月矛。',
  }
},
[2870] = {
  {
    'Contra o Lorde Shalzaru‡Борьба с лордом Шалзару‡Gegen Lord Shalzaru‡군주 샬자루와의 전투‡En contra del Señor Shalzaru‡En contra de Lord Shalzaru‡Contre le Seigneur Shalzaru‡击败沙尔扎鲁‡擊敗沙爾紮魯',
    nil,
    'Elimine o Lorde Shalzaru, e depois leve a Relíquia Misteriosa que ele desencavou a Latrônicus Lunalança no Domínio de Plumaluna.‡Убейте лорда Шалзару и принесите обнаруженную им таинственную реликвию Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Vernichtet Lord Shalzaru und bringt dann Latronicus Moonspear in der Festung Feathermoon das geheimnisvolle Relikt, das er entdeckt hat.‡군주 샬자루를 처치하고 그가 찾아낸 신비한 유물을 페더문 요새에 있는 라트로니쿠스 문스피어에게 가져가야 합니다.‡Elimina a Señor Shalzaru y luego lleva la reliquia misteriosa que desenterró a Latronicus Lanzaluna al Bastión Plumaluna.‡Elimina a Lord Shalzaru y luego lleva la reliquia misteriosa que desenterró a Latronicus Lanzaluna al Bastión Plumaluna.‡Eliminer le seigneur Shalzaru et rapporter la mystérieuse relique qu\'il a découverte à Latronicus Moonspear au bastion de Feathermoon.‡消灭沙尔扎鲁，然后把神秘遗物交给羽月要塞的拉托尼库斯·月矛。‡消滅沙爾紮魯，然後把神秘遺物交給羽月要塞的拉托尼庫斯·月矛。',
  }
},
[2871] = {
  {
    'A entrega da relíquia‡Доставка реликвии‡Überbringung des Relikts‡유물 전달‡Entrega la reliquia‡Entrega la reliquia‡Livraison de la relique‡递送遗物‡遞送遺物',
    nil,
    'Entregue a Relíquia Misteriosa a Véstia Lançaluna no Domínio de Plumaluna.‡Доставьте таинственную реликвию Вестии Лунное Копье в Крепость Оперенной Луны.‡Bringt das geheimnisvolle Relikt zu Vestia Moonspear in der Festung Feathermoon.‡페더문 요새에 있는 베스티아 문스피어에게 신비한 유물을 가져가야 합니다.‡Entrega la reliquia misteriosa a Vestia Lanzaluna que está en el Bastión Plumaluna.‡Entrega la reliquia misteriosa a Vestia Lanzaluna que está en el Bastión Plumaluna.‡Porter la Relique mystérieuse à Vestia Moonspear au bastion de Feathermoon.‡将神秘遗物交给羽月要塞的维斯提亚·月矛。‡將神秘遺物交給羽月要塞的維斯提亞·月矛。',
  }
},
[2872] = {
  {
    'A dívida de Esmirno‡Долг Столи‡Stoleys Schuld‡스톨리의 빚‡La deuda de Stoley‡La deuda de Stoley‡Les dettes de Stoley‡斯杜雷的债务‡斯杜雷的債務',
    nil,
    'Fale com Esmirno no Porto de Bondebico.‡Поговорите со Столи из Порта Картеля.‡Sprecht mit Stoley in Steamwheedle.‡스팀휘들 항구에 있는 스톨리와 대화해야 합니다.‡Habla con Stoley en el Puerto Bonvapor.‡Habla con Stoley en el Puerto Bonvapor.‡Parler à Stoley, à Port Gentepression.‡与热砂港的斯杜雷谈一谈。‡與熱砂港的斯杜雷談壹談。',
  }
},
[2873] = {
  {
    'Carregamento do Esmirno‡Посылка Столи‡Stoleys Lieferung‡스톨리의 뱃짐‡el Cargamento de Stoley‡El envío de Stoley‡Chargement de Stoley‡斯杜雷的货物‡斯杜雷的貨物',
    nil,
    'Leve o Carregamento do Esmirno para Esmirno no Porto de Bondebico.‡Отыщите партию товара Столи и возвратите ее хозяину в Порт Картеля.‡Bringt Stoleys Lieferung zu Stoley nach Steamwheedle.‡스팀휘들 항구에 있는 스톨리에게 뱃짐을 찾아다 주어야 합니다.‡Llévale el cargamento de Stoley a Stoley, que está en el Puerto Bonvapor.‡Llévale el envío de Stoley a Stoley, que está en el Puerto Bonvapor.‡Apporter le Chargement de Stoley à Port Gentepression et remettez-le à Stoley.‡将斯杜雷的货物交给热砂港的斯杜雷。‡將斯杜雷的貨物交給熱砂港的斯杜雷。',
  }
},
[2874] = {
  {
    'Entrega para MacKinley‡Ром для Маккинли‡Lieferung für MacKinley‡맥킨리에게 배달‡Un envío para MacKinley‡Un envío para MacKinley‡Livraison à MacKinley‡给马克基雷的货物‡給馬克基雷的貨物',
    nil,
    'Leve uma Garrafa do Esmirno para MacKinley "Lobo do Mar" na Angra do Butim.‡Отнесите бутылку Столи "Морскому волку" МакКинли в Пиратскую бухту.‡Bringt Stoleys Flasche zu "Seewolf” MacKinley in Booty Bay.‡무법항에 있는 "바다늑대" 맥킨리에게 칼림도어산 럼주가 든 스톨리의 병을 가져가야 합니다.‡Llévale la botella de Stoley a "Lobo de Mar" MacKinley, que está en Bahía del Botín.‡Llévale la botella de Stoley a "Lobo de Mar" MacKinley, en Bahía del Botín.‡Porter la Bouteille de Stoley à MacKinley "Loup des mers" à Baie-du-Butin.‡将斯杜雷的瓶子交给藏宝海湾的“海狼”马克基雷。‡將斯杜雷的瓶子交給藏寶海灣的“海狼”馬克基雷。',
  }
},
[2875] = {
  {
    'PROCURA-SE: André Barbarruiva‡РАЗЫСКИВАЕТСЯ: Андре Огнебородый‡GESUCHT: Andre Feuerbart‡현상수배: 앙드레 파이어비어드‡SE BUSCA: Andre Barbafuego‡SE BUSCA: Andre Barbafuego‡ON RECHERCHE : André Barbe-en-feu‡通缉：安德雷·费尔比德‡通緝：安德雷·費爾比德',
    nil,
    'Leve a Cabeça do André ao Chefe de Segurança Silvadágua no Porto de Bondebico.‡Принесите голову Андре Огнебородого начальнику отдела безопасности Чепухастеру в Порт Картеля.‡Bringt Sicherheitschef Bilgewhizzle in Steamwheedle Andres Kopf.‡앙드레를 처치하고 그 증거로 그의 머리카락을 스팀휘들 항구에 있는 보안과장 빌지위즐에게 가져가야 합니다.‡Llévale la cabeza de Andre al jefe de seguridad Silvaina, que está en el Puerto Bonvapor.‡Llévale la cabeza de Andre al jefe de seguridad Pasaquillas, que está en el Puerto Bonvapor.‡Rapporter la tête d\'André au Chef de la sécurité Bilgewhizzle à Port Gentepression.‡将安德雷的头颅交给热砂港的安全主管吉罗姆·比格维兹。‡將安德雷的頭顱交給熱砂港的安全主管吉羅姆·比格維茲。',
  }
},
[2876] = {
  {
    'Cronograma de Navios‡Расписание кораблей‡Schiffzeitpläne‡선적 일정표‡El registro náutico‡El registro náutico‡Horaires des bateaux‡船运时刻表‡船運時刻表',
    nil,
    'Apresente o Cronograma de Navios a uma autoridade do Porto de Bondebico.‡Сообщите о корабельном расписании руководству Порта Картеля.‡Berichtet den Behörden in Steamwheedle von den Schiffzeitplänen.‡스팀휘들 항구의 관계자에게 선적 일정표에 대해 보고하십시오.‡Informa del registro de envíos a alguna autoridad del Puerto Bonvapor.‡Informa del registro de envíos a alguna autoridad del Puerto Bonvapor.‡Rapporter le Planning des expéditions aux autorités de Port Gentepression.‡把船运时刻表交给热砂港的某个官员。‡把船運時刻表交給熱砂港的某個官員。',
  }
},
[2877] = {
  {
    'Limpeza na Rocha Oculta‡Зачистка Осклизлой скалы‡Skulk Rock-Aufräumen‡굼벵이 바위굴 청소‡La limpieza de Roca Oculta‡La limpieza de Roca Oculta‡Nettoyer le rocher de l\'Affût‡清理隐匿石‡清理隱匿石',
    nil,
    'Mate 10 Lodos Verdes e 10 Gosmas Jade, depois apresente-se novamente a Explodar Mantrovejante no Ninho da Águia.‡Убейте 10 зеленых слякочей и 10 нефритовых слизнюков, после чего доложитесь Фраггару Громовой Мантии на Заоблачном Пике.‡Tötet 10 grüne Schlämme sowie 10 jadegrüne Brühschlammer und meldet Euch dann wieder bei Fraggar Thundermantle in Aerie Peak.‡녹색 녹괴물 10마리와 비취 수액괴물 10마리를 처치한 후 맹금의 봉우리에 있는 프라가르 썬더맨틀에게 돌아와 보고하십시오.‡Mata 10 barrosos verdes y 10 mocos verde jade e informa a Fraggar Mantrueno en Pico Nidal.‡Mata 10 lodos verdes y 10 mocos de jade e informa a Fraggar Mantrueno en Pico Nidal.‡Tuer 10 Limaces vertes et 10 Limons de jade puis faire votre rapport à Fraggar Thundermantle au Nid-de-l\'Aigle‡杀掉10个绿色淤泥怪和10个玉石软泥怪，然后回到鹰巢山向弗拉加尔报告。‡殺掉10個綠色淤泥怪和10個玉石軟泥怪，然後回到鷹巢山向弗拉加爾報告。',
  }
},
[2878] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    nil,
  }
},
[2879] = {
  {
    'O Báculo de Equinex‡Посох равноденствия‡Der Stock von Equinex‡에퀴넥스의 지팡이‡El Bastón de Equinex‡El báculo de Equinex‡Le Bâton d\'Equinex‡艾奎尼克斯法杖‡艾奎尼克斯法杖',
    nil,
    'Energize o Báculo de Troya e encontre o Monolito de Equinex.‡Зарядите посох Трояса и отыщите Монолит Равноденствия.‡Aktiviert Troyas Stock und findet den Equinex-Monolithen.‡트로야스의 지팡이에 힘을 불어넣고 에퀴넥스 비석탑을 찾아야 합니다.‡Energiza el bastón de Troyas y encuentra el Monolito de Equinex.‡Energiza el báculo de Troyas y encuentra el Monolito de Equinex.‡Dynamiser le Bâton de Troyas et trouver le Monolithe d\'Equinex.‡给特洛亚斯的法杖注入能量，并找到艾奎尼克斯石碑。‡給特洛亞斯的法杖註入能量，並找到艾奎尼克斯石碑。',
  }
},
[2880] = {
  {
    'Recompensa dos colares trólicos‡Ожерелья троллей‡Kopfgeld für Trollhalsketten‡트롤 목걸이 현상금‡Los collares de trols‡Los collares de trols‡Chasse au collier troll‡巨魔部族项链‡巨魔部族項鏈',
    nil,
    'Leve 5 Colares Tribais Troll para Explodar Mantrovejante no Ninho da Águia.‡Принесите 5 тролльих ожерелий Фраггару Громовой Мантии на Заоблачный пик.‡Bringt Fraggar Thundermantle in Aerie Peak 5 Troll-Stammeshalsketten.‡맹금의 봉우리에 있는 프라가르 썬더맨틀에게 트롤 전통 목걸이 5개를 가져다주어야 합니다.‡LLeva 5 collares tribales trol a Fraggar Mantrueno a Pico Nidal.‡Lleva 5 collares tribales trol a Fraggar Mantrueno a Pico Nidal.‡Rapporter 5 Colliers tribaux trolls à Fraggar Thundermantle au Nid-de-l\'Aigle‡给鹰巢山的弗拉加尔带去5条巨魔部族项链。‡給鷹巢山的弗拉加爾帶去5條巨魔部族項鏈。',
  }
},
[2881] = {
  {
    'Recompensa dos colares trólicos‡Ожерелья троллей‡Kopfgeld für Trollhalsketten‡트롤 목걸이 현상금‡Los collares de trols‡Los collares de trols‡Chasse aux colliers trolls‡巨魔部族项链‡巨魔部族項鏈',
    nil,
    nil,
  }
},
[2882] = {
  {
    'Cuergo Ouro‡Золото Куэрго‡Cuergos Gold‡쿠에르고 골드‡El oro de Cuergo‡El oro de Cuergo‡L\'or de Cuergo‡科尔戈的黄金‡科爾戈的黃金',
    nil,
    'Encontre o ouro de Cuergo!‡Найдите золото Куэрго!‡Findet Cuergos Gold!‡쿠에르고 골드를 찾으십시오.‡¡Encuentra el oro de Cuergo!‡¡Encuentra el oro de Cuergo!‡Trouvez l\'or de Cuergo !‡找到科尔戈的黄金！‡找到科爾戈的黃金！',
  }
},
[2902] = {
  {
    'Investigação Patábua‡Разведка планов Древолапов‡Waldpfotennachforschung‡덩굴발일족 조사‡Investiga a los Zarpaleña‡Investiga a los Zarpaleña‡Enquête chez les Griffebois‡调查木爪岭‡調查木爪嶺',
    nil,
    'Encontre os Planos de Batalha Gnoll no acampamento dos Gnolls ao sul da Aldeia Mojache.‡Найдите гноллские боевые планы в гноллских лагерях к югу от Лагеря Мохаче.‡Findet die Gnoll-Schlachtpläne irgendwo in den Gnoll-Lagern südlich vom Camp Mojache.‡모자케 야영지 남쪽에 있는 놀 야영지에서 덩굴발일족 전투계획서를 찾아야 합니다.‡Encuentra los planes de batalla de los gnolls por los campamentos que hay al sur del Campamento Mojache.‡Encuentra los planes de batalla de los gnolls por los campamentos que hay al sur del Campamento Mojache.‡Trouver les Plans de bataille des gnolls dans les camps gnolls du sud du Camp Mojache.‡在莫沙彻营地以南的豺狼人营地中寻找豺狼人的战斗计划。‡在莫沙徹營地以南的豺狼人營地中尋找豺狼人的戰鬥計劃。',
  }
},
[2903] = {
  {
    'Os planos de batalha‡Планы битвы‡Die Schlachtpläne‡전투 계획서‡Los planes de batalla de los Zarpaleña‡Los planes de batalla‡Les plans de bataille‡作战计划‡作戰計劃',
    nil,
    'Leve os Planos de Batalha de Patábua para Hadoken Passo Veloz na Aldeia Mojache.‡Отнесите планы битвы Древолапов Хадокену Быстрому Страннику в Лагерь Мохаче.‡Bringt die Schlachtpläne der Waldpfoten zu Hadoken Swiftstrider ins Camp Mojache.‡모자케 야영지에 있는 아도겐 스위프트스트라이더에게 덩굴발일족 전투계획서를 가지고 가야 합니다.‡Lleva los planes de batalla de los gnolls Zarpaleña a Hadoken Zancoveloz al Campamento Mojache.‡Lleva los planes de batalla de los gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Rapporter les Plans de bataille des Griffebois à Hadoken Swiftstrider au Camp Mojache.‡把木爪豺狼人的作战计划交给莫沙彻营地的哈杜肯·迅蹄。‡把木爪豺狼人的作戰計劃交給莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[2904] = {
  {
    'Uma bela bagunça‡Катавасия‡Eine schöne Bescherung‡곤경에 빠진 케르노비‡Un buen lío‡Un buen lío‡Une jolie pagaille‡一团混乱‡壹團混亂',
    nil,
    'Escolte Kernobill até a saída do Corredor dos Mecanismos, depois apresente-se a Scooty na Angra do Butim.‡Отведите Керноби к Часовому ходу. Затем отправляйтесь с донесением к Скути в Пиратскую бухту.‡Begleitet Kernobee zur Uhrwerkgasse und meldet Euch dann wieder bei Scooty in Booty Bay.‡태엽장치 통로 입구까지 케르노비를 호위한 후 무법항에 있는 스쿠티에게 가서 보고해야 합니다.‡Acompaña a Kernobee a La rampa del engranaje y luego ve a ver a Scooty a Bahía del Botín.‡Acompaña a Kernobee a La Rampa del Engranaje y luego ve a ver a Scooty a Bahía del Botín.‡Escorter Kernobee jusqu’à la sortie de la Fuite du temps, puis faire un rapport à Scooty, à Baie-du-Butin.‡将克努比护送到出口，然后向藏宝海湾的斯库提汇报。‡將克努比護送到出口，然後向藏寶海灣的斯庫提匯報。',
  }
},
[2922] = {
  {
    'Salve o cérebro do Tecnobô!‡Промыть мозг Техботу‡Rettet Techbots Hirn!‡고장난 첨단로봇 수리‡¡Salva el cerebro de Techrobot!‡¡Salva el cerebro de Tecnobot!‡Sauver le cerveau de Techbot !‡拯救尖端机器人！‡拯救尖端機器人！',
    nil,
    'Leve o Núcleo de Memória do Tecnobô para o Mestre-faz-tudo Superchispa em Altaforja.‡Принесите ядро памяти Техбота мехмастеру Замыкальцу в Стальгорн.‡Bringt Techbots Speicherkern zu Tüftlermeister Overspark nach Ironforge.‡아이언포지에 있는 수석땜장이 오버스파크에게 첨단로봇의 기억회로를 가져가야 합니다.‡Lleva el procesador central de memoria del techrobot al maestro manitas Sobrechispa a Forjaz.‡Lleva el procesador central de memoria del Tecnobot al maestro manitas Sobrechispa a Forjaz.‡Rapporter la Mémoire principale de Techbot au maître-artisan Overspark à Ironforge.‡将尖端机器人的存储器核心交给铁炉堡的工匠大师欧沃斯巴克。‡將尖端機器人的存儲器核心交給鐵爐堡的工匠大師歐沃斯巴克。',
  }
},
[2923] = {
  {
    'Mestre-faz-tudo Superchispa‡Мехмастер Замыкалец‡Tüftlermeister Overspark‡수석땜장이 오버스파크‡Maestro manitas Sobrechispa‡Maestro manitas Sobrechispa‡Maître-artisan Overspark‡工匠大师欧沃斯巴克‡工匠大師歐沃斯巴克',
    nil,
    'Fale com o Mestre-faz-tudo Superchispa em Altaforja.‡Поговорите с механомастером Большой Искрой.‡Sprecht mit Tüftlermeister Overspark in Ironforge.‡아이언포지에 있는 수석땜장이 오버스파크와 대화하십시오.‡Habla con el maestro manitas Sobrechispa en Forjaz.‡Habla con el maestro manitas Sobrechispa en Forjaz.‡Parler au maître-artisan Overspark à Ironforge.‡与铁炉堡的工匠大师欧沃斯巴克谈一谈。‡與鐵爐堡的工匠大師歐沃斯巴克談壹談。',
  }
},
[2924] = {
  {
    'Artifícios Essenciais‡Базовый элемент‡Grundlegende Artifixe‡필수 인공장치‡Esencias artificiales‡Esencias artificiales‡Les cerveaux mécaniques‡基础模组‡基礎模組',
    nil,
    'Leve 12 Artifícios Essenciais para Cronomorfus Espanafuso em Altaforja.‡Принесите 12 базовых элементов Клацморту Гайкокруту в Стальгорн.‡Bringt Klockmort Spannerspan in Ironforge 12 grundlegende Artifixe.‡아이언포지에 있는 클락몰트 스패너스판에게 필수 인공장치 12개를 가져가야 합니다.‡Lleva 12 esencias artificiales a Klockmort Palmalicate a Forjaz.‡Lleva 12 esencias artificiales a Klockmort Palmalicate a Forjaz.‡Rapporter 12 Cerveaux mécaniques à Klockmort Spannerspan à Ironforge.‡收集12个基础模组，把它们交给铁炉堡的科劳莫特·钢尺。‡收集12個基礎模組，把它們交給鐵爐堡的科勞莫特·鋼尺。',
  }
},
[2925] = {
  {
    'Os artifícios do Cronomorfus‡Базовые элементы Клацморта‡Klockmorts Grundlagen‡클락몰트에게 꼭 필요한 것‡Klockmort Palmalicate‡Klockmort Palmalicate‡Les cerveaux mécaniques de Klockmort‡帮助科劳莫特‡幫助科勞莫特',
    nil,
    'Fale com Cronomorfus Espanafuso em Altaforja.‡Поговорите с Клацмортом Гайкокрутом в Стальгорне.‡Sprecht mit Klockmort Spannerspan in Ironforge.‡아이언포지에 있는 클락몰트 스패너스판과 대화하십시오.‡Habla con Klockmort Palmalicate en Forjaz.‡Habla con Klockmort Palmalicate en Forjaz.‡Parler à Klockmort Spannerspan à Ironforge.‡与铁炉堡的科劳莫特·钢尺谈一谈。‡與鐵爐堡的科勞莫特·鋼尺談壹談。',
  }
},
[2926] = {
  {
    'Gnogaína‡Новая формула‡Gnogaine‡폐기물 수집‡Gnogaine‡Gnogaine‡Gnogaine‡诺恩‡諾恩',
    nil,
    'Use o Coletor de Chumbo Vazio nos Invasores Irradiados ou nos Pilhadores Irradiados para recolher resíduos radioativos. Depois que ele ficar cheio, leve-o de volta para Ozzie Mudavolt em Kharanos.‡Соберите радиоактивный осадок, оставляемый облученными захватчиками и облученными погромщиками в пустой свинцовый фиал для образцов. Принесите полный фиал Оззи Триггервольту в Каранос.‡Sammelt mit der leeren bleiernen Sammelphiole radioaktive Ablagerungen bestrahlter Eindringlinge oder Plünderer. Sobald sie voll ist, bringt Ihr sie zu Ozzie Togglevolt nach Kharanos zurück.‡빈 가연채집병에 오염된 침략꾼이나 오염된 약탈자에게서 얻은 방사성 폐기물을 담아야 합니다. 채집병이 가득 차면 카라노스에 있는 오지 토글볼트에게 가지고 가야 합니다.‡Usa la ampolla de plomo con invasores o saqueadores radiactivos para recoger restos radiactivos. Cuando esté llena, llévasela a Ozzie Voltiflop a Kharanos.‡Usa la ampolla de plomo con invasores o saqueadores radiactivos para recoger restos radiactivos. Cuando esté llena, llévasela a Ozzie Voltiflop a Kharanos.‡Utiliser la Fiole de collecte plombée vide sur les Envahisseurs ou les Pilleurs irradiés pour recueillir des retombées radioactives. Une fois pleine, rapportez-la à Ozzie Togglevolt à Kharanos.‡用空铅瓶对着辐射入侵者或者辐射抢劫者，从它们身上收集放射尘。瓶子装满之后，把它交给卡拉诺斯的奥齐·电环。‡用空鉛瓶對著輻射入侵者或者輻射搶劫者，從它們身上收集放射塵。瓶子裝滿之後，把它交給卡拉諾斯的奧齊·電環。',
  }
},
[2927] = {
  {
    'O dia seguinte‡На другой день‡Der Tag danach‡그날 이후‡Al día siguiente‡Al día siguiente‡Le jour d\'après‡灾难之后‡災難之後',
    nil,
    'Fale com Ozzie Mudavolt em Kharanos.‡Поговорите с Оззи Триггервольтом в Караносе.‡Sprecht mit Ozzie Togglevolt in Kharanos.‡카라노스에 있는 오지 토글볼트와 대화하십시오.‡Ve a hablar con Ozzie Voltiflop en Kharanos.‡Ve a hablar con Ozzie Voltiflop en Kharanos, en Dun Morogh.‡Parler à Ozzie Togglevolt à Kharanos.‡与卡拉诺斯的奥齐·电环谈一谈。‡與卡拉諾斯的奧齊·電環談壹談。',
  }
},
[2928] = {
  {
    'Escavacionadores girobrocamáticos‡Сооружение автогиробуророек‡Gyrobohrmatische Exkavation‡회전천공식 발굴기‡Gyrodrillmatic Excavationators‡Excavadoras gyroagujereamáticas‡Excavateurs gyrodrilmatiques‡陀螺式挖掘机‡陀螺式挖掘機',
    nil,
    'Leve 24 Tripas Mecanobóticas para Shoni em Ventobravo.‡Принесите Шони в Штормград 24 горсти механических внутренностей роботов.‡Bringt 24 robomechanische Innereien zu Shoni nach Stormwind.‡스톰윈드에 있는 쇼니에게 기계장치 부속품 24개를 가져가야 합니다.‡Lleva veinticuatro entrañas robomecánicas a Shoni en Ventormenta.‡Lleva veinticuatro entrañas robomecánicas a Shoni en Ventormenta.‡Rapporter 24 Entrailles mécaniques de robot à Shoni à Stormwind.‡收集24副机械内胆，把它们交给暴风城的舒尼。‡收集24副機械內膽，把它們交給暴風城的舒尼。',
  }
},
[2929] = {
  {
    'A grande traição‡Великое предательство‡Der große Verrat‡대배반‡La gran traición‡La gran traición‡La grande trahison‡大叛徒‡大叛徒',
    nil,
    'Vá para Gnomeregan e mate o Mecangenheiro Termaplugue. Fale novamente com o Grão-faz-tudo Mekkatorque depois que tiver terminado a tarefa.‡Отправляйтесь в Гномреган и убейте Мекжинера Термоштепселя. Вернитесь к Главному Механику Меггакруту.‡Reist nach Gnomeregan und tötet Robogenieur Thermaplugg. Kehrt zu Hochtüftler Mekkatorque zurück, wenn der Auftrag ausgeführt ist.‡놈리건으로 가서 멕기니어 텔마플러그를 처치해야 합니다. 임무가 끝나면 땜장이왕 멕카토크에게 돌아와야 합니다.‡Ve a Gnomeregan y mata al mekigeniero Termochufe. Ve a ver al Manitas Mayor Mekkatorque cuando hayas terminado.‡Ve a Gnomeregan y mata al mekigeniero Termochufe. Ve a ver al Manitas Mayor Mekkatorque cuando hayas terminado.‡Aller à Gnomeregan et tuer le mekgénieur Thermaplugg. Puis retourner voir le Grand Bricoleur Mekkatorque.‡到诺莫瑞根去杀掉麦克尼尔·瑟玛普拉格。完成任务之后向大工匠梅卡托克报告。‡到諾莫瑞根去殺掉麥克尼爾·瑟瑪普拉格。完成任務之後向大工匠梅卡托克報告。',
  }
},
[2930] = {
  {
    'O resgate dos dados‡Спасение данных‡Datenrettung‡자료 회수‡Rescatar los datos‡Rescatar los datos‡Sauvetage de données‡抢救数据‡搶救數據',
    nil,
    'Leve o Cartão Perfurado Prismático para o Mestre Mecânico Fundecano em Altaforja.‡Принесите призматическую перфокарту главному механику Чугунотрубзу в Стальгорн.‡Bringt Mechanikermeister Castpipe in Ironforge eine Prismalochkarte.‡아이언포지에 있는 수석수리공 캐스트파이프에게 오색 천공 카드를 가져가야 합니다.‡Lleva una tarjeta perforada prismática al maestro mecánico Funditubo a Forjaz.‡Lleva una tarjeta perforada prismática al maestro mecánico Funditubo a Forjaz.‡Apporter une Carte perforée prismatique au Maître mécanicien Castpipe, à Ironforge.‡将彩色穿孔卡片交给铁炉堡的大机械师卡斯派普。‡將彩色穿孔卡片交給鐵爐堡的大機械師卡斯派普。',
  }
},
[2931] = {
  {
    'A tarefa do Fundecano‡Поручение Чугонотрубза‡Castpipes Auftrag‡캐스트파이프의 임무‡Trabajar para Funditubo‡Trabajar para Funditubo‡Du travail pour Castpipe‡卡斯派普的任务‡卡斯派普的任務',
    nil,
    'Fale com o Mestre Mecânico Fundecano em Altaforja.‡Поговорите с главным механиком Чугунотрубзом в Стальгорне.‡Sprecht mit Mechanikermeister Castpipe in Ironforge.‡아이언포지에 있는 수석수리공 캐스트파이프와 대화하십시오.‡Habla con el maestro mecánico Funditubo en Forjaz.‡Habla con el maestro mecánico Funditubo en Forjaz.‡Parler au Maître mécanicien Castpipe, à Ironforge.‡与铁炉堡的大机械师卡斯派普谈一谈。‡與鐵爐堡的大機械師卡斯派普談壹談。',
  }
},
[2932] = {
  {
    'Recado sinistro‡Предупреждение‡Grausige Botschaft‡준엄한 메시지‡Un macabro mensaje‡Un mensaje siniestro‡Sinistre message‡可怕的消息‡可怕的消息',
    nil,
    'Recolha Crânios de Cascasseca e leve o Pique de Nimboya. Finque o Pique de Nimboya Repleto em uma das Aldeias Cascasseca nas Terras Agrestes, depois fale novamente com Nimboya na Selva do Espinhaço.‡Соберите черепа троллей из клана Сухокожих и насадите их на пику Нимбойи, после чего установите пику с тролльими черепами в центре тролльей деревни и возвращайтесь к Нимбойе в Тернистую долину.‡Sammelt Schädel der Witherbark und hängt sie an Nimboyas Pike. Platziert Nimboyas behängte Pike in einem der Witherbarkdörfer im Hinterland und kehrt dann zu Nimboya ins Schlingendorntal zurück.‡동부 내륙지에서 마른나무껍질부족 해골을 모은 후, 님보야의 창을 동부 내륙지에 있는 마른나무껍질 마을 중 한곳에 박아 놓아야 합니다. 그런 다음 가시덤불 골짜기에 있는 님보야에게 돌아가십시오.‡Recoge calaveras de Secacorteza y clava la pica de Nimboya en unos de los poblados Secacorteza, en las Tierras del Interior. Luego ve a ver a Nimboya a Tuercespina.‡Recoge cráneos Secacorteza y luego clava la pica cargada de Nimboya en uno de los poblados Secacorteza, en las Tierras del Interior. Luego ve a ver a Nimboya a Tuercespina.‡Collecter les Crânes de Witherbark, et les mettre en place sur la Pique de Nimboyae. Placer la Pique de Nimboya préparée dans l’un des Villages Witherbark, dans les Hinterlands, puis retourner voir Nimboya, à Strangleronce.‡在辛特兰收集枯木巨魔的头皮，把它们串在尼姆布亚之矛上。将尼姆布亚的长矛插在辛特兰的某个枯木巨魔村庄中，然后回到荆棘谷的尼姆布亚那里。‡在辛特蘭收集枯木巨魔的頭皮，把它們串在尼姆布亞之矛上。將尼姆布亞的長矛插在辛特蘭的某個枯木巨魔村莊中，然後回到荊棘谷的尼姆布亞那裏。',
  }
},
[2933] = {
  {
    'Garrafas de peçonha‡Бутыли с ядом‡Giftflaschen‡독병‡Botellas de veneno‡Botellas de veneno‡Bouteilles de venin‡毒液瓶‡毒液瓶',
    nil,
    'Leve uma Garrafa de Peçonha para um boticário na Serraria Tarren.‡Принесите бутылку яда аптекарю на Мельницу Таррен.‡Bringt eine Giftflasche zu einem Apotheker nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사에게 독병을 가져가야 합니다.‡Lleva una botella de veneno a algún boticario de Molino Tarren.‡Lleva una botella de veneno a algún boticario de Molino Tarren.‡Apporter une Bouteille de venin à un apothicaire, au Moulin-de-Tarren.‡将毒药瓶交给塔伦米尔的某个药剂师。‡將毒藥瓶交給塔倫米爾的某個藥劑師。',
  }
},
[2934] = {
  {
    'Vesícula de peçonha intacta‡Неповрежденная ядовитая железа‡Unbeschädigter Giftbeutel‡온전한 독주머니‡Glándula de veneno intacta‡Glándula de veneno intacta‡Glande à venin intacte‡完好无损的毒囊‡完好無損的毒囊',
    nil,
    'Leve a Vesícula de Peçonha Intacta para o Boticário Lindolfo na Serraria Tarren.‡Принесите неповрежденную ядовитую железу аптекарю Лидону на Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle einen unbeschädigten Giftbeutel.‡타렌 밀농장에 있는 연금술사 라이던에게 온전한 독주머니를 가져가야 합니다.‡Lleva una glándula de veneno intacta al boticario Lydon de Molino Tarren.‡Lleva una glándula de veneno intacta al boticario Lydon de Molino Tarren.‡Rapporter une Glande à venin intacte à l\'Apothicaire Lydon, au Moulin-de-Tarren.‡将完好无损的毒囊交给塔伦米尔的药剂师林度恩。‡將完好無損的毒囊交給塔倫米爾的藥劑師林度恩。',
  }
},
[2935] = {
  {
    'Consulte o Mestre Gadrin‡Разговор с мастером Гадрином‡Konsultiert Meister Gadrin‡가드린 장로와 상의‡Consulta al maestro Gadrin‡Consulta al maestro Gadrin‡Consulter Maître Gadrin‡请教加德林大师‡請教加德林大師',
    nil,
    'Fale com o Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Sprecht mit Meister Gadrin in Sen\'jin.‡센진 마을에 있는 가드린 장로와 대화하십시오.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Parler à Maître Gadrin au Village de Sen\'jin.‡与森金村的加德林大师谈一谈。‡與森金村的加德林大師談壹談。',
  }
},
[2936] = {
  {
    'A deusa aranha‡Паучья богиня‡Der Spinnengott‡거미 신‡Diosa araña‡Diosa araña‡Le dieu-araignée‡蜘蛛之神‡蜘蛛之神',
    nil,
    'Leia a Tabuleta de Theka para descobrir o nome da deusa aranha dos Cascasseca, depois fale novamente com o Mestre Gadrin.‡Прочитайте надписи на табличке Теки, узнайте имя паучьей богини, которой поклоняются тролли Сухокожих, а потом возвращайтесь к мастеру Гадрину.‡Lest von der Schrifttafel des Theka, um den Namen des Spinnengottes der Witherbark zu erfahren, und kehrt dann zu Meister Gadrin zurück.‡데카의 서판을 읽고 마른나무껍질부족 거미 신의 이름을 알아낸 후, 가드린 장로에게 돌아가십시오.‡Lee el nombre de la diosa araña de los Secacorteza en la tablilla de Theka y vuelve a ver al maestro Gadrin.‡Lee el nombre de la diosa araña de los Secacorteza en la tablilla de Theka y vuelve a ver al maestro Gadrin.‡Lire la Tablette de Theka pour connaître le véritable nom du dieu-araignée des Witherbark, puis retourner voir Maître Gadrin.‡阅读塞卡石板，了解枯木巨魔的蜘蛛之神的名字，然后回到加德林大师那里。‡閱讀塞卡石板，了解枯木巨魔的蜘蛛之神的名字，然後回到加德林大師那裏。',
  }
},
[2937] = {
  {
    'Evocando Shadra‡Призыв Шадры‡Die Beschwörung von Shadra‡샤드라 소환‡Invocar a Shadra‡Invocar a Shadra‡L\'invocation de Shadra‡召唤沙德拉‡召喚沙德拉',
    nil,
    'Derrote Shadra no altar de Shadra\'Alor, depois leve o veneno para o Boticário Lindolfo na Serraria Tarren.‡Убейте Шадру у алтаря Шадра\'Алора и принесите ее яд аптекарю Лидону на Мельницу Таррен.‡Besiegt Shadra am Altar von Shadra’Alor und bringt sein Gift zu Apotheker Lydon nach Tarrens Mühle.‡샤드라알로 제단에서 샤드라를 물리친 후, 그녀의 독을 타렌 밀농장에 있는 연금술사 라이던에게 가져가야 합니다.‡Derrota a Shadra en el altar de Shadra\'Alor y lleva su veneno al boticario Lydon de Molino Tarren.‡Derrota a Shadra en el altar de Shadra\'Alor y lleva su veneno al boticario Lydon de Molino Tarren.‡Terrasser Shadra, à l\'autel de Shadra\'Alor, puis rapporter son venin à l\'Apothicaire Lydon, au Moulin-de-Tarren.‡在沙德拉洛祭坛上击败沙德拉，把它的毒液交给塔伦米尔的药剂师林度恩。‡在沙德拉洛祭壇上擊敗沙德拉，把它的毒液交給塔倫米爾的藥劑師林度恩。',
  }
},
[2938] = {
  {
    'Veneno para a Cidade Baixa‡Яд в Подгород‡Gift für Undercity‡언더시티로 독 가져가기‡Veneno para Entrañas‡Veneno para Entrañas‡Du venin pour Undercity‡送往幽暗城的毒药‡送往幽暗城的毒藥',
    nil,
    'Leve o Embrulho do Faranello para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите сверток мастеру-аптекарю Фаранеллу в Подгород.‡Bringt Faranells Päckchen zu Apothekermeister Faranell nach Undercity.‡언더시티에 있는 수석 연금술사 파라넬에게 파라넬의 소포를 가져가야 합니다.‡Lleva el paquete al maestro boticario Faranell a Entrañas.‡Lleva el paquete al maestro boticario Faranell a Entrañas.‡Apporter le Colis de Faranell au maître apothicaire Faranell, à Undercity.‡将法拉尼尔的包裹交给幽暗城的大药剂师法拉尼尔。‡將法拉尼爾的包裹交給幽暗城的大藥劑師法拉尼爾。',
  }
},
[2939] = {
  {
    'Em busca de conhecimento‡В поисках знаний‡Auf der Suche nach Wissen‡지식을 찾아서‡La búsqueda del conocimiento‡La búsqueda del conocimiento‡En savoir plus‡寻找知识‡尋找知識',
    nil,
    'Fale com Daryn Aelumnis na Vila de Rut\'theran.‡Поговорите с Дарин Добрый Ветер в деревне Рут\'теран.‡Sprecht mit Daryn Lightwind im Dorf Rut\'theran.‡루테란 마을에 있는 다린 라이트윈드와 대화해야 합니다.‡Habla con Daryn Brisela de la Aldea Rut\'theran.‡Habla con Daryn Brisela de la Aldea Rut\'theran.‡Parler à Daryn Lightwind, au village de Rut\'theran.‡与鲁瑟兰村的达蕾恩·轻风谈一谈。‡與魯瑟蘭村的達蕾恩·輕風談壹談。',
  }
},
[2940] = {
  {
    'Feralas: uma história‡"История Фераласа"‡Feralas: Ein historischer Abriss‡페랄라스의 역사‡Feralas: una historia‡Feralas: una historia‡Feralas : une histoire‡菲拉斯的历史‡菲拉斯的歷史',
    nil,
    'Peça o livro emprestado a Daryn Aelumnis.‡Попросите Дарин Добрый Ветер одолжить вам книгу.‡Fragt Daryn Lightwind, ob Ihr Euch ihr Buch ausleihen dürft.‡다린 라이트윈드에게 책을 빌려도 좋은지 물어봐야 합니다.‡Pide a Daryn Brisela que te preste su libro.‡Pide a Daryn Brisela que te preste su libro.‡Demander à Daryn Lightwind si vous pouvez emprunter son livre.‡如果你想借达蕾恩·轻风的书，要先得到她的允许。‡如果妳想借達蕾恩·輕風的書，要先得到她的允許。',
  }
},
[2941] = {
  {
    'O empréstimo‡В обмен на книгу‡Der Borger‡사진기 대여‡El préstamo‡El préstamo‡Le prêt‡海龟照片‡海龜照片',
    nil,
    'Leve a carta para Crista Dapinote em Tanaris.‡Отнесите письмо Кургль Поскакушке в Танарис.‡Bringt den Brief zu Curgle Cranklehop nach Tanaris.‡타나리스에 있는 커글 크랭크홉에게 짧은 쪽지를 가져가야 합니다.‡Lleva esta carta a Curgle Saltamanivela a Tanaris.‡Lleva esta carta a Curgle Saltamanivela a Tanaris.‡Apporter la lettre à Curgle Cranklehop, à Tanaris.‡把信交给塔纳利斯的克格尔·曲藤。‡把信交給塔納利斯的克格爾·曲藤。',
  }
},
[2942] = {
  {
    'A pedra matinal‡Завтрашний камень‡Der Morgenstein‡반짝이는 돌‡La Piedra del mañana‡La Piedra del mañana‡La Pierre du matin‡晨光石‡晨光石',
    nil,
    'Traga a Pedra Rutilante e o Báculo de Equinex para Troyas Brisaluna no Domínio de Plumaluna.‡Верните искрящийся камень и посох Равноденствия Троясу Лунному Бризу в Крепость Оперенной Луны.‡Bringt den funkelnden Stein und den Stock von Equinex zu Troyas Moonbreeze in die Festung Feathermoon.‡페더문 요새에 있는 트로야스 문브리즈에게 반짝이는 돌과 에퀴넥스의 지팡이를 가져가야 합니다.‡Devuelve la piedra refulgente y el Bastón de Equinex a Troyas Brisaluna que está en el Bastión Plumaluna.‡Devuelve la piedra refulgente y el báculo de Equinex a Troyas Brisaluna que está en el Bastión Plumaluna.‡Rapporter la Pierre étincelante et le Bâton d\'Equinex à Troyas Moonbreeze, dans le bastion de Feathermoon.‡将闪光的石头和艾奎尼克斯法杖交给羽月要塞的特洛亚斯·月风。‡將閃光的石頭和艾奎尼克斯法杖交給羽月要塞的特洛亞斯·月風。',
  }
},
[2943] = {
  {
    'O retorno a Troyas‡Возвращение к Троясу‡Rückkehr zu Troyas‡트로야스에게 돌아가기‡Vuelva con Troyas‡Regresa junto a Troyas‡Troyas‡向特洛亚斯回复‡向特洛亞斯回復',
    nil,
    'Leve o livro para Troyas Brisaluna no Domínio de Plumaluna.‡Доставьте книгу Троясу Лунному Бризу в Крепость Оперенной Луны.‡Liefert das Buch bei Troyas Moonbreeze in der Festung Feathermoon ab.‡페더문 요새에 있는 트로야스 문브리즈에게 책을 가져가야 합니다.‡Entrega el libro a Troyas Brisaluna en el Bastión Plumaluna.‡Entrega el libro a Troyas Brisaluna en el Bastión Plumaluna.‡Apporter le livre à Troyas Moonbreeze, dans le bastion de Feathermoon.‡把书交给羽月要塞的特洛亚斯·月风。‡把書交給羽月要塞的特洛亞斯·月風。',
  }
},
[2944] = {
  {
    'A Superinstantânea FX‡Супер-хвататель ФХ‡Der Superschnapper FX‡슈퍼 찰칵이 FX‡Superistánea FX‡La Superinstantánea FX‡Le Preneur d\'images FX‡超级摄影器FX‡超級攝影器FX',
    nil,
    'Use a Superinstantânea FX para tirar uma foto da Gammerita, depois fale novamente com Daryn Aelumnis na Vila de Rut\'theran.‡Сделайте снимок Гаммериты с помощью супер-хватателя ФХ и вернитесь к Дарин Добрый Ветер в деревне Рут\'теран.‡Benutzt den Superschnapper FX, um einen Schnappschuss von Gammerita zu machen, und kehrt dann zu Daryn Lightwind nach Rut\'theran zurück.‡슈퍼 찰칵이 FX로 감메리타의 즉석사진을 찍은 후, 루테란 마을에 있는 다린 라이트윈드에게 돌아가야 합니다.‡Utiliza la Superistánea FX para sacar una instantánea de Gammerita y luego vuelve a la Aldea Rut\'theran con Daryn Brisela.‡Utiliza la Superinstantánea FX para sacar una instantánea de Gammerita y luego vuelve a la Aldea Rut\'theran con Daryn Brisela.‡Utiliser le Preneur d\'images FX pour prendre un cliché de Gammerita, puis retourner voir Daryn Lightwind à Rut\'theran.‡用超级摄影器FX给加莫里塔拍张照片，然后把它交给鲁瑟兰村的达蕾恩·轻风。‡用超級攝影器FX給加莫裏塔拍張照片，然後把它交給魯瑟蘭村的達蕾恩·輕風。',
  }
},
[2945] = {
  {
    'Anel Encardido‡Кольцо, покрытое грязью‡Schmutzverkrusteter Ring‡꼬질꼬질한 반지‡Un anillo sucio‡Un anillo sucio‡Anneau sali‡脏兮兮的戒指‡臟兮兮的戒指',
    nil,
    'Descubra uma maneira de remover a crosta de sujeira do Anel Encardido.‡Придумайте, как отчистить кольцо, покрытое грязью.‡Findet einen Weg, den schmutzverkrusteten Ring zu säubern.‡꼬질꼬질한 반지에서 찌꺼기를 제거할 방법을 찾아야 합니다.‡Encuentra la manera de limpiar el anillo sucio.‡Encuentra la manera de limpiar el anillo sucio.‡Trouver un moyen de nettoyer l\'Anneau sali.‡想方法把脏兮兮的戒指弄干净。‡想方法把臟兮兮的戒指弄幹凈。',
  }
},
[2946] = {
  {
    'Ver o que acontece‡Посмотрим, что будет дальше‡Mal sehen, was passiert...‡위험한 시도‡A ver qué pasa‡A ver qué pasa‡Questions sans réponses‡拭目以待‡拭目以待',
    nil,
    'Leve os discos de platina em miniatura até os portões de Uldum, em Tanaris, e procure descobrir qual é a conexão entre essas duas coisas.‡Принесите миниатюрные платиновые диски к воротам Ульдума в Танарисе и проверьте, имеют ли диски отношение к воротам.‡Bringt die Miniaturplatinscheiben zu den Toren von Uldum in Tanaris und sucht nach Hinweisen auf die Verbindung zwischen beidem.‡소형 백금 원반을 타나리스에 있는 울둠의 문으로 가져가서 이 둘 사이의 연관성에 대한 단서를 찾아야 합니다.‡Lleva los minidiscos de platino a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Porter les Disques de platine miniatures aux Portes d\'Uldum, à Tanaris et chercher les indices de la connexion qui existe entre eux.‡将迷你白金圆盘拿到塔纳利斯的奥丹姆大门去，找出两者之间的联系。‡將迷妳白金圓盤拿到塔納利斯的奧丹姆大門去，找出兩者之間的聯系。',
  }
},
[2947] = {
  {
    'Ficar ou não ficar... eis a questão!‡Возвращение кольца‡Die Rückkehr des Rings‡반지의 귀환‡La devolución del anillo‡La devolución del anillo‡Le retour de l\'anneau‡戒指归来‡戒指歸來',
    nil,
    'Você pode ficar com o anel ou achar a pessoa que faz a gravação no interior dele.‡Вы можеть оставить кольцо себе, а можете попытаться найти того, чьи инициалы выгравированы на внутренней стороне кольца.‡Ihr könnt den Ring entweder behalten oder die Person finden, die für die Prägung und Gravuren auf der Innenseite des Rings verantwortlich ist.‡반지를 그냥 가지거나, 반지 안쪽 부분에 새겨진 인장 자국의 주인을 찾아야 합니다.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Garder l\'anneau ou retrouver la personne qui y a gravé les lettres.‡你要么自己留着这枚戒指，要么就按照戒指内侧刻着的名字找到它的主人。‡妳要麽自己留著這枚戒指，要麽就按照戒指內側刻著的名字找到它的主人。',
  }
},
[2948] = {
  {
    'Aperfeiçoamento gnômico‡Гномское усовершенствование‡Gnomen-Verbesserungen‡노움의 실력 향상‡Mejora gnómica‡Mejora gnómica‡Amélioration gnomique‡侏儒的手艺‡侏儒的手藝',
    nil,
    'Entregue o Anel de Ouro Brilhante, uma Barra de Prata, uma Ágata Musgosa e 30 moedas de prata para Didiê Du Mocó, em Altaforja.‡Принесите блестящее золотое кольцо, слиток серебра, моховой агат и 30 серебряных монет Талвашу де Кисселю в Стальгорн.‡Bringt Talvash del Kissel in Ironforge den glänzenden Goldring, einen Silberbarren, einen Moosachat und 30 Silbermünzen.‡아이언포지에 있는 탈바쉬 델 키젤에게 은괴 1개, 태마노 1개와 반짝이는 금반지와 30실버를 주어야 합니다.‡Lleva tu anillo de oro, 1 lingote de plata, 1 ágata musgosa y 30 monedas de plata a Talvash del Kissel a Forjaz.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Talvash del Kissel a Forjaz.‡Apporter l’Anneau d\'or brillant, une Barre d\'argent, une Agate mousse et 30 pièces d’argent à Talvash del Kissel, à Ironforge.‡将闪亮的金戒指、1块银锭、1块绿玛瑙和30个银币交给铁炉堡的塔瓦斯德·基瑟尔。‡將閃亮的金戒指、1塊銀錠、1塊綠瑪瑙和30個銀幣交給鐵爐堡的塔瓦斯德·基瑟爾。',
  }
},
[2949] = {
  {
    'Ficar ou não ficar... eis a questão!‡Возвращение кольца‡Die Rückkehr des Rings‡반지의 귀환‡La devolución del anillo‡La devolución del anillo‡Le retour de l\'anneau‡戒指归来‡戒指歸來',
    nil,
    'Você pode ficar com o anel ou achar a pessoa que faz a gravação no interior dele.‡Вы можеть оставить кольцо себе, а можете попытаться найти того, чьи инициалы выгравированы на внутренней стороне кольца.‡Ihr könnt den Ring entweder behalten oder die Person finden, die für die Prägung und Gravuren auf der Innenseite des Rings verantwortlich ist.‡반지를 그냥 가지거나, 반지 안쪽 부분에 새겨진 인장 자국의 주인을 찾아야 합니다.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Garder l\'anneau ou retrouver la personne qui y a gravé les lettres.‡你要么自己留着这枚戒指，要么就按照戒指内侧刻着的名字找到它的主人。‡妳要麽自己留著這枚戒指，要麽就按照戒指內側刻著的名字找到它的主人。',
  }
},
[2950] = {
  {
    'Recauchutagem do anel do Nogg‡Переделка кольца‡Noggs Ringerneuerung‡노그의 반지 수리‡Nogg mejora el anillo‡Nogg mejora el anillo‡Nogg améliore l\'anneau‡诺格的手艺‡諾格的手藝',
    nil,
    'Leve o Anel de Ouro Brilhante, uma Barra de Prata, uma Ágata Musgosa e 30 moedas de Prata para Nogg em Orgrimmar.‡Принесите блестящее золотое кольцо, слиток серебра, моховой агат и 30 серебряных монет Ноггу в Огргиммар.‡Bringt Nogg in Orgrimmar den glänzenden Goldring, einen Silberbarren, einen Moosachat und 30 Silbermünzen.‡오그리마에 있는 노그에게 반짝이는 금반지, 은괴 1개, 태마노 1개, 그리고 30실버를 가져다주어야 합니다.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Nogg a Orgrimmar.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Nogg a Orgrimmar.‡Apporter l’Anneau d\'or brillant, une Barre d\'argent, une Agate mousse et 30 pièces d’argent à Nogg, à Orgrimmar.‡将闪亮的金戒指、1块银锭、1块绿玛瑙和30个银币交给奥格瑞玛的诺格。‡將閃亮的金戒指、1塊銀錠、1塊綠瑪瑙和30個銀幣交給奧格瑞瑪的諾格。',
  }
},
[2951] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Décapeur 5200 !‡超级清洁器5200型！‡超級清潔器5200型！',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡삐까뻔쩍세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto sucio en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Insérer un Objet sali dans le Décapeur 5200, sans oublier de jeter trois pièces d\'argent dans la fente, pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將臟兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[2952] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Décapeur 5200 !‡超级清洁器5200型！‡超級清潔器5200型！',
    nil,
    nil,
  }
},
[2953] = {
  {
    'Brastematic FTW!‡Работа для Чистера‡Mehr Spaß mit dem Funkelmaten‡삐까뻔쩍세척기 재사용‡El Destellamatic en acción‡El Destellamatic en acción‡Le Décapeur décape encore‡再次使用超级清洁器‡再次使用超級清潔器',
    nil,
    nil,
  }
},
[2954] = {
  {
    'O vigia pétreo‡Каменный Страж‡Der Steinbehüter‡바위감시자‡El guardapiedras‡El vigía de piedra‡Le Gardien des pierres‡石头卫士‡石頭衛士',
    nil,
    'Descubra qual é o propósito do Vigia Pétreo de Norgannon, depois interaja com o Pedestal de Uldum no deserto de Tanaris.‡Узнайте назначение Каменного Стража Норганнона, затем коснитесь пьедестала Ульдума в пустыне Танарис.‡Findet den Zweck des Steinbehüters von Norgannon heraus und interagiert dann mit dem Uldum-Sockel in der Tanariswüste.‡타나리스 사막에 있는 노르간논의 바위감시자와 대화한 후 울둠 대좌를 건드리십시오.‡Averigua qué quiere el guardapiedras de Norgannon y después interactúa con el pedestal de Uldum en el Desierto de Tanaris.‡Averigua qué quiere el vigía de piedra de Norgannon y después interactúa con el pedestal de Uldum en el Desierto de Tanaris.‡Apprendre le but du Gardien des pierres de Norgannon, puis interagir avec le Socle d\'Uldum, dans le désert de Tanaris.‡询问诺甘农的石头卫士，搞清楚它要让你干什么，然后再次点击它脚下的奥丹姆石座。‡詢問諾甘農的石頭衛士，搞清楚它要讓妳幹什麽，然後再次點擊它腳下的奧丹姆石座。',
  }
},
[2962] = {
  {
    'A única cura é mais brilho verde‡Сильное зеленое свечение‡Das einzige Heilmittel ist mehr grünes Leuchten‡유일한 치료법‡Necesitamos más material verdoso‡Necesitamos más material verdoso‡Encore plus de Lueur verte !‡更多的辐射尘！‡更多的輻射塵！',
    nil,
    'Vá até Gnomeregan e traga o Resíduo Radioativo de Alta Potência. Tome cuidado, pois a radiação é instável e pode se esvair rapidamente.|nOzzie também vai precisar do seu Coletor de Chumbo Pesado quando tiver terminado.‡Отправляйтесь в Гномреган и принесите высокорадиоактивные образцы. Внимание: отходы нестабильны и довольно быстро разрушаются.|nВерните Оззи тяжелую освинцованную склянку для проб, когда задача будет выполнена.‡Reist nach Gnomeregan und bringt etwas von der hoch konzentrierten radioaktiven Ablagerung zurück. Seid gewarnt, die Ablagerung ist instabil und wird ziemlich schnell zerfallen.|nOzzie wird außerdem Eure schwere bleierne Phiole benötigen, nachdem die Aufgabe erledigt ist.‡놈리건으로 가서 고농축 방사성 폐기물을 가져와야 합니다. 이 폐기물은 불안정하여 성분이 금방 변할 수 있으니 주의하십시오.|n임무를 완수한 후 빈 대형 가연채집병을 오지에게 돌려줘야 합니다.‡Viaja hasta Gnomeregan y recupera los restos radiactivos de gran potencia. Pero ten cuidado, ya que es inestable y podría explotar en cualquier momento.|nOzzie también quiere que traigas la ampolla pesada de plomo una vez que hayas terminado el trabajo.‡Viaja hasta Gnomeregan y recupera los restos radiactivos de gran potencia. Pero ten cuidado, ya que es inestable y podría explotar en cualquier momento.|nOzzie también quiere que traigas la ampolla pesada de plomo una vez que hayas terminado el trabajo.‡Voyager à Gnomeregan et rapporter de la Matière radioactive à haut potentiel. Attention, la matière radioactive est instable et se désactive rapidement.|nAprès le travail, conserver la Flasque plombée lourde, pour Ozzie.‡到诺莫瑞根去收集高强度辐射尘。要多加小心，这种辐射尘非常不稳定，很快就会分解。|n奥齐要求你把沉重的铅瓶也交给他。‡到諾莫瑞根去收集高強度輻射塵。要多加小心，這種輻射塵非常不穩定，很快就會分解。|n奧齊要求妳把沈重的鉛瓶也交給他。',
  }
},
[2963] = {
  {
    'Os portentos de Uldum‡Ульдумские чудеса‡Omen von Uldum‡울둠의 전조‡Presagios de Uldum‡Presagios de Uldum‡Prodiges d\'Uldum‡奥丹姆的线索‡奧丹姆的線索',
    nil,
    'Fale com o Historiador Karnik no Salão dos Exploradores em Altaforja.‡Поговорите с историком Карником в Зале Исследователей в Стальгорне.‡Sprecht mit Historiker Karnik in der Halle der Forscher in Ironforge.‡아이언포지의 탐험가의 전당에 있는 역사학자 카르닉과 대화하십시오.‡Habla con el historiador Karnik en la Sala de los Exploradores de Forjaz.‡Habla con Karnik el Historiador en la Sala de los Expedicionarios de Forjaz.‡Parler à l\'Historien Karnik dans le Hall des explorateurs, à Ironforge.‡与铁炉堡探险者大厅中的史学家卡尼克谈一谈。‡與鐵爐堡探險者大廳中的史學家卡尼克談壹談。',
  }
},
[2964] = {
  {
    'Uma tarefa futura‡Новое задание‡Eine zukünftige Aufgabe‡미래의 임무‡Un tarea futura‡Una tarea futura‡Travail imminent‡进一步的任务‡進壹步的任務',
    nil,
    'Fale com o Alto-explorador Magellas em Altaforja.‡Поговорите со старшим исследователем Магелласом в Стальгорне.‡Sprecht mit Hochforscher Magellas in Ironforge.‡아이언포지에 있는 선임탐험가 마겔라스와 대화하십시오.‡Habla con el alto expedicionario Magellas de Forjaz.‡Habla con el alto expedicionario Magellas de Forjaz.‡Parler au Grand Explorateur Magellas, à Ironforge.‡与铁炉堡的资深探险家麦格拉斯谈一谈。‡與鐵爐堡的資深探險家麥格拉斯談壹談。',
  }
},
[2965] = {
  {
    'Os portentos de Uldum‡Ульдумские чудеса‡Omen von Uldum‡울둠의 전조‡Presagios de Uldum‡Presagios de Uldum‡Prodiges d\'Uldum‡奥丹姆的线索‡奧丹姆的線索',
    nil,
    'Fale com Nara Juba Agreste no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Нарой Буйногривой на Вершине Старейшин Громового Утеса.‡Sprecht mit Nara Wildmane auf der Anhöhe der Ältesten in Thunder Bluff.‡썬더 블러프의 장로의 봉우리에 있는 나라 와일드메인과 대화해야 합니다.‡Habla con Nara Bravacrín en el Alto de los Ancestros de Cima del Trueno.‡Habla con Nara Ferocrín en el Alto de los Ancestros de Cima del Trueno.‡Aller à la Cime des Anciens, dans Thunder Bluff et parler à Nara Wildmane.‡与雷霆崖长者高地的纳拉·蛮鬃谈一谈。‡與雷霆崖長者高地的納拉·蠻鬃談壹談。',
  }
},
[2966] = {
  {
    'Ver o que acontece‡Посмотрим, что будет дальше‡Mal sehen, was passiert...‡위험한 시도‡A ver qué pasa‡A ver qué pasa‡Questions sans réponses‡拭目以待‡拭目以待',
    nil,
    'Leve os discos de platina em miniatura até os portões de Uldum, em Tanaris, e procure descobrir qual é a conexão entre essas duas coisas.‡Принесите миниатюрные платиновые диски к воротам Ульдума в Танарисе и проверить, имеют ли диски отношение к воротам.‡Bringt die Miniaturplatinscheiben zu den Toren von Uldum in Tanaris und sucht nach Hinweisen auf die Verbindung zwischen beidem.‡소형 백금 원반을 타나리스에 있는 울둠의 문으로 가져가서 이 둘 사이의 연관성에 대한 단서를 찾아야 합니다.‡Lleva los minidiscos de platino a las puertas de Uldum en Tanaris y busca pistas de la relación que existe entre ambos.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Porter les Disques de platine miniatures aux Portes d\'Uldum, à Tanaris et chercher les indices de la connexion qui existe entre eux.‡将迷你白金圆盘拿到塔纳利斯的奥丹姆大门去，找出两者之间的联系。‡將迷妳白金圓盤拿到塔納利斯的奧丹姆大門去，找出兩者之間的聯系。',
  }
},
[2967] = {
  {
    'Volte ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Rückkehr nach Thunder Bluff‡썬더 블러프로의 귀환‡El regreso a Cima del Trueno‡Regresa a Cima del Trueno‡Le retour à Thunder Bluff‡返回雷霆崖‡返回雷霆崖',
    nil,
    'Fale com Nara Juba Agreste no Penhasco do Trovão.‡Поговорите с Нарой Буйногривой в Громовом Утесе.‡Sprecht mit Nara Wildmane in Thunder Bluff.‡썬더 블러프에 있는 나라 와일드메인과 대화해야 합니다.‡Habla con Nara Bravacrín en Cima del Trueno.‡Habla con Nara Ferocrín en Cima del Trueno.‡Parler à Nara Wildmane, dans Thunder Bluff.‡与雷霆崖的纳拉·蛮鬃谈一谈。‡與雷霆崖的納拉·蠻鬃談壹談。',
  }
},
[2968] = {
  {
    'Uma tarefa futura‡Новое задание‡Eine zukünftige Aufgabe‡미래의 임무‡Una tarea futura‡Una tarea futura‡Travail imminent‡进一步的任务‡進壹步的任務',
    nil,
    'Fale com o Sábio Devoto da Verdade no Penhasco do Trovão.‡Поговорите с Ведуном Искателем Истины в Громовом Утесе.‡Sprecht mit Sage Truthseeker in Thunder Bluff.‡썬더 블러프에 있는 현자 트루스시커와 대화해야 합니다.‡Habla con Sabio Buscaverdad en Cima del Trueno.‡Habla con Sabio Buscador de la Verdad en Cima del Trueno.‡Parler au Sage Truthseeker, à Thunder Bluff.‡与雷霆崖的圣者图希克谈一谈。‡與雷霆崖的聖者圖希克談壹談。',
  }
},
[2969] = {
  {
    'Liberdade para todas as criaturas‡Свободу всем живым существам!‡Freiheit für alle Kreaturen‡모든 생명에 자유를‡Libertad para todas las criaturas‡Libertad para todas las criaturas‡Liberté pour toutes les créatures‡精灵龙的自由‡精靈龍的自由',
    nil,
    'Com a Chave da Gaiola de Bambu, liberte os Dardejantes do cercado no acampamento dos Temível Totem. Pelo menos 6 Dardejantes e Kindal Teceluna devem sobreviver.|nVocê tem 6 minutos antes que Kindal resolva recuar e você fracasse na missão.‡Освободите летучих хамелеонов из вольера в лагере Зловещего Тотема с помощью ключа от бамбуковой клетки. Необходимо, чтобы Кайдел Лунный Ткач и как минимум 6 хамелеонов остались живы.|nУ вас в запасе 6 минут. После этого Кайдел решит, что пора отступать, и задание останется невыполненным.‡Befreit mit dem Bambuskäfigschlüssel die Grimmlingflitzer aus dem Pferch im Grimmtotemlager. Kindal Moonweaver sowie mindestens 6 Grimmlingflitzer müssen überleben.|nIhr habt 6 Minuten, bis Kindal beschließt, dass es Zeit zum Rückzug und Eure Aufgabe gescheitert ist.‡대나무 우리 열쇠를 사용하여 그림토템부족 야영지의 우리에 갇힌 화살요정용들을 풀어 줘야 합니다. 최소 6마리의 화살요정용과 킨달 문위버가 살아남아야 합니다.|n6분이 지나면 킨달이 후퇴할 때가 되었다고 할 것이며 임무에 실패하게 됩니다.‡Utiliza la llave de jaula de bambú para liberar a los duendes dardo del campamento Tótem Siniestro. Deben sobrevivir al menos 6 duendes dardo y Kindal Tejeluna.|nTienes 6 minutos antes de que Kindal decida que es hora de retirarse, entonces tu misión fracasará.‡Utiliza la llave de jaula de bambú para liberar a los duendes dardo del campamento Tótem Siniestro. Deben sobrevivir al menos 6 duendes dardo y Kindal Tejeluna.|nTienes 6 minutos antes de que Kindal decida que es hora de retirarse, entonces tu misión fracasará.‡A l’aide de la Clé de la cage en bambou, libérer les Fées fléchetteuses de l’enclos dans le Camp du Totem sinistre. Au moins 6 Fées fléchetteuses et Kindal Moonweaver doivent survivre.|nVous avez 6 minutes avant que Kindal décide qu’il est temps de battre en retraite et que vous échouiez dans votre quête.‡从恐怖图腾营地的围栏里释放被俘获的小精龙。至少6个小精龙和辛达尔·月纹必须活着。|n如果6分钟之内你还没能达成这个目标，辛达尔就会决定撤退，任务也会随即失败。‡從恐怖圖騰營地的圍欄裏釋放被俘獲的小精龍。至少6個小精龍和辛達爾·月紋必須活著。|n如果6分鐘之內妳還沒能達成這個目標，辛達爾就會決定撤退，任務也會隨即失敗。',
  }
},
[2970] = {
  {
    'Distribuindo a justiça‡Небольшое возмездие‡Gerechtigkeit üben‡정의의 실현‡La justicia del castigo‡La justicia del castigo‡Justice de châtiment‡菲拉斯的正义‡菲拉斯的正義',
    nil,
    'Mate 12 Naturalistas Temível Totem, 10 Saqueadores dos Temível Totem e 6 Xamãs Temível Totem antes reencontrar Jer\'kai Teceluna em Feralas.‡Убейте 12 натуралистов из племени Зловещего Тотема, 10 налетчиков из племени Зловещего Тотема и 6 шаманов из племени Зловещего Тотема, а затем вернитесь к Джер\'Кай Лунный Ткач в Фераласе.‡Tötet 12 Naturalisten der Grimmtotem, 10 Räuber der Grimmtotem sowie 6 Schamanen der Grimmtotem und kehrt dann zu Jer’kai Moonweaver nach Feralas zurück.‡그림토템부족 식물학자 12명, 그림토템부족 침략자 10명, 그리고 그림토템부족 주술사 6명을 처치한 후, 페랄라스에 있는 제르카이 문위버에게 돌아가야 합니다.‡Mata a 12 naturalistas Tótem Siniestro, 10 asaltantes Tótem Siniestro y 6 chamanes Tótem Siniestro antes de volver con Jer\'kai Tejeluna a Feralas.‡Mata a 12 naturalistas Tótem Siniestro, 10 asaltantes Tótem Siniestro y 6 chamanes Tótem Siniestro antes de volver con Jer\'kai Tejeluna a Feralas.‡Tuer 12 Naturalistes du Totem sinistre, 10 Ecumeurs du Totem sinistre et 6 Chamans du Totem sinistre avant de retourner voir Jer\'kai Moonweaver, en Feralas.‡杀掉12个恐怖图腾博学者、10个恐怖图腾袭击者和6个恐怖图腾萨满祭司，然后向菲拉斯的耶尔卡·月纹汇报。‡殺掉12個恐怖圖騰博學者、10個恐怖圖騰襲擊者和6個恐怖圖騰薩滿祭司，然後向菲拉斯的耶爾卡·月紋匯報。',
  }
},
[2972] = {
  {
    'Distribuindo a justiça‡Небольшое возмездие‡Gerechtigkeit üben‡정의의 실현‡La justicia del castigo‡La justicia del castigo‡Justice de châtiment‡菲拉斯的正义‡菲拉斯的正義',
    nil,
    'Leve o Anel-sinete de Jer\'kai para a Alta-sacerdotisa Tyrande Murmuréolo em Darnassus.‡Отнесите перстень-печатку Джер\'Кай верховной жрице Тиранде Шелест Ветра в Дарнассе.‡Bringt Jer’kais Siegelring zu Hohepriesterin Tyrande Whisperwind nach Darnassus.‡다르나서스에 있는 대여사제 티란데 위스퍼윈드에게 제르카이의 인장 반지를 가져가야 합니다.‡Lleva el anillo con sello de Jer\'kai a la suma sacerdotisa Tyrande Susurravientos a Darnassus.‡Lleva el sello de Jer\'kai a la suma sacerdotisa Tyrande Susurravientos a Darnassus.‡Apporter la Chevalière de Jer\'kai\'s à la Grande prêtresse Tyrande Whisperwind, à Darnassus.‡将耶尔卡的徽记之戒交给达纳苏斯的高阶女祭司泰兰德·语风。‡將耶爾卡的徽記之戒交給達納蘇斯的高階女祭司泰蘭德·語風。',
  }
},
[2973] = {
  {
    'Dando um trato na capa‡Новый сверкающий плащ‡Schimmer für einen neuen Umhang‡화려한 새 망토‡Una capa nueva‡El lustre de una nueva capa‡Une nouvelle cape‡新斗篷的光辉‡新鬥篷的光輝',
    nil,
    'Traga 10 Asas Iridescentes de Dardejantes para Krueg Rachacrânio na Aldeia Mojache.‡Принесите 10 радужных крыльев летучих хамелеонов Кригу Головорубу в Лагерь Мохаче.‡Bringt 10 regenbogenfarbene Grimmlingflitzerflügel zu Krueg Skullsplitter nach Camp Mojache.‡모자케 야영지에 있는 크루엑 스컬스플리터에게 오색 화살요정용 날개 10개를 가져가야 합니다.‡Lleva 10 alas iridiscentes de duende dardo a Krueg Machacacráneos al Campamento Mojache.‡Lleva 10 alas de duende dardo iridiscente a Krueg Machacacráneos al Campamento Mojache.‡Rapporter 10 Ailes iridescentes de Fées fléchetteuses à Krueg Skullsplitter à Camp Mojache.‡给莫沙彻营地的克鲁伊格·碎颅带去10个闪光的小精灵翅膀。‡給莫沙徹營地的克魯伊格·碎顱帶去10個閃光的小精靈翅膀。',
  }
},
[2974] = {
  {
    'Uma temível descoberta‡Зловещее открытие‡Eine grausige Entdeckung‡불길한 발견‡Un descubrimiento siniestro‡Un descubrimiento siniestro‡Une découverte sinistre‡可怕的发现‡可怕的發現',
    nil,
    'Traga 20 Chifres de Temível Totem para Krueg Rachacrânio na Aldeia Mojache.‡Принесите 20 рогов Зловещего Тотема Кригу Головорубу в Лагерь Мохаче.‡Bringt 20 Grimmtotemhörner zu Krueg Skullsplitter nach Camp Mojache.‡모자케 야영지에 있는 크루엑 스컬스플리터에게 그림토템일족 뿔 20개를 가져가야 합니다.‡Lleva 20 cuernos Tótem Siniestro a Krueg Machacacráneos al Campamento Mojache.‡Lleva 20 cuernos de Tótem Siniestro a Krueg Machacacráneos en el Campamento Mojache.‡Apporter 20 Cornes de Totem sinistre à Krueg Skullsplitter à Camp Mojache.‡收集20支恐怖图腾之角，把它们交给千针石林的克鲁伊格·碎颅。‡收集20支恐怖圖騰之角，把它們交給千針石林的克魯伊格·碎顱。',
  }
},
[2975] = {
  {
    'Os ogros de Feralas‡Огры Фераласа‡Die Oger von Feralas‡페랄라스의 오우거‡Los ogros de Feralas‡Los ogros de Feralas‡Les ogres de Feralas‡菲拉斯的食人魔‡菲拉斯的食人魔',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você mate 10 Ogros Gordunni, 10 Ogros-magos e 5 Brutamontes Gordunni.‡Убейте 10 огров из клана Гордунни, 10 огров-магов из клана Гордунни и 5 громил из клана Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr 10 Oger der Gordunni, 10 Magier der Gordunni und 5 Schläger der Gordunni tötet.‡모자케 야영지에 있는 로크 올한이 골두니 오우거 10명, 골두니일족 오우거 마법사 10명, 골두니일족 투사 5명을 처치해달라고 부탁했습니다.‡Rok Orhan del Campamento Mojache quiere que mates a 10 ogros Gordunni, 10 ogros-magi Gordunni y 5 brutos Gordunni.‡Rok Orhan del Campamento Mojache quiere que mates a 10 ogros Gordunni, 10 magi ogro Gordunni y 5 toscos Gordunni.‡Tuer 10 Ogres gordunni, 10 Ogre-magi gordunni et 5 Brutes gordunni pour Rok Orhan, à Camp Mojache.‡莫沙彻营地的洛卡·奥赫要你杀掉10个戈杜尼食人魔、10个戈杜尼食人魔法师和5个戈杜尼蛮兵。‡莫沙徹營地的洛卡·奧赫要妳殺掉10個戈杜尼食人魔、10個戈杜尼食人魔法師和5個戈杜尼蠻兵。',
  }
},
[2976] = {
  {
    'Uma temível descoberta‡Зловещее открытие‡Eine grausige Entdeckung‡불길한 발견‡Un descubrimiento siniestro‡Un descubrimiento siniestro‡Une découverte sinistre‡可怕的发现‡可怕的發現',
    nil,
    'Leve a Caixa de Chifres Temível Totem para Belgrom Pedramalho em Orgrimmar.‡Отнесите ящик с рогами клана Зловещего Тотема Белгрому Каменной Булавы в Оргриммар.‡Bringt die Kiste mit Grimmtotemhörnern zu Belgrom Rockmaul nach Orgrimmar.‡오그리마에 있는 벨그롬 록마울에게 그림토템일족 뿔 상자를 가져가야 합니다.‡Lleva el cajón de cuernos Tótem Siniestro a Belgrom Destrozarroca a Orgrimmar.‡Lleva el cajón de cuernos de Tótem Siniestro a Belgrom Destrozarroca a Orgrimmar.‡Apporter la Caisse de Cornes de Totem sinistre à Belgrom Rockmaul, Orgrimmar.‡将一箱恐怖图腾之角交给奥格瑞玛的贝尔戈洛姆·石槌。‡將壹箱恐怖圖騰之角交給奧格瑞瑪的貝爾戈洛姆·石槌。',
  }
},
[2977] = {
  {
    'Retorno a Altaforja‡Возвращение в Стальгорн‡Rückkehr nach Ironforge‡아이언포지로의 귀환‡El regreso a Forjaz‡Regresa a Forjaz‡Retour à Ironforge‡返回铁炉堡‡返回鐵爐堡',
    nil,
    'Fale com o Historiador Karnik em Altaforja.‡Поговорите с историком Карником из Стальгорна.‡Sprecht mit Historiker Karnik in Ironforge.‡아이언포지에 있는 역사학자 카르닉과 대화하십시오.‡Habla con Karnik el Historiador de Forjaz.‡Habla con Karnik el Historiador de Forjaz.‡Parler à l\'Historien Karnik, à Ironforge.‡与铁炉堡的史学家卡尼克谈一谈。‡與鐵爐堡的史學家卡尼克談壹談。',
  }
},
[2978] = {
  {
    'O Pergaminho Gordunni‡Свиток Гордунни‡Die Gordunnischriftrolle‡골두니 두루마리‡El pergamino Gordunni‡El pergamino Gordunni‡Le parchemin Gordunni‡戈杜尼卷轴‡戈杜尼卷軸',
    nil,
    'Leve o Pergaminho Gordunni para Rok Orhan na Aldeia Mojache.‡Отнести свиток Гордунни Роке Орхан в Лагерь Мохаче.‡Bringt die Gordunnischriftrolle zu Rok Orhan ins Camp Mojache.‡모자케 야영지에 있는 로크 올한에게 골두니 두루마리를 가져가야 합니다.‡Lleva el pergamino Gordunni a Rok Orhan al Campamento Mojache.‡Lleva el pergamino Gordunni a Rok Orhan al Campamento Mojache.‡Apporter le Parchemin Gordunni à Rok Orhan, à Camp Mojache.‡将戈杜尼卷轴交给莫沙彻营地的洛克·奥汉。‡將戈杜尼卷軸交給莫沙徹營地的洛克·奧漢。',
  }
},
[2979] = {
  {
    'Cerimônia sombria‡Темный обряд‡Dunkle Zeremonie‡암흑의 의식‡Una ceremonia oscura‡Una ceremonia oscura‡Sombre cérémonie‡黑暗仪式‡黑暗儀式',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você encontre um Orbe Gordunni.‡Добудьте сферу Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr eine Gordunnikugel findet.‡모자케 야영지에 있는 로크 올한이 골두니 수정구를 찾아 와 달라고 부탁했습니다.‡Rok Orhan del Campamento Mojache quiere que encuentres 1 orbe Gordunni.‡Rok Orhan del Campamento Mojache quiere que encuentres 1 orbe Gordunni.‡Rapporter un Orbe Gordunni à Rok Orhan, à Camp Mojache.‡莫沙彻营地的洛卡·奥赫希望你找到一颗戈杜尼之宝珠。‡莫沙徹營地的洛卡·奧赫希望妳找到壹顆戈杜尼之寶珠。',
  }
},
[2980] = {
  {
    'Os ogros de Feralas‡Огры Фераласа‡Die Oger von Feralas‡페랄라스의 오우거‡Los ogros de Feralas‡Los ogros de Feralas‡Les ogres de Feralas‡菲拉斯的食人魔‡菲拉斯的食人魔',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você mate 10 Xamãs Gordunni, 10 Bruxos Gordunni e 5 Espancadores Gordunni.‡Убейте 10 шаманов из клана Гордунни, 10 чернокнижников из клана Гордунни и 5 извергов из клана Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr 10 Schamanen der Gordunni, 10 Hexenmeister der Gordunni und 5 Raufer der Gordunni tötet.‡모자케 야영지에 있는 로크 올한이 골두니일족 주술사 10명, 골두니일족 흑마법사 10명, 그리고 골두니일족 싸움꾼 5명을 처치해 달라고 부탁했습니다.‡Rok Orhan del Campamento Mojache quiere que mates a 10 chamanes Gordunni, 10 brujos Gordunni y 5 destructores Gordunni.‡Rok Orhan del Campamento Mojache quiere que mates a 10 chamanes Gordunni, 10 brujos Gordunni y 5 aplastadores Gordunni.‡Tuer 10 Chamans Gordunni, 10 Démonistes Gordunni et 5 Marteleurs Gordunni pour Rok Orhan, à Camp Mojache.‡莫沙彻营地的洛卡·奥赫要你去杀掉十个戈杜尼萨满祭司、10个戈杜尼术士和5个戈杜尼虐待者。‡莫沙徹營地的洛卡·奧赫要妳去殺掉十個戈杜尼薩滿祭司、10個戈杜尼術士和5個戈杜尼虐待者。',
  }
},
[2981] = {
  {
    'Uma ameaça em Feralas‡Опасность в Фераласе‡Eine Bedrohung in Feralas‡페랄라스의 위협‡Una amenaza en Feralas‡Una amenaza en Feralas‡Menace sur Feralas‡菲拉斯的危机‡菲拉斯的危機',
    nil,
    'Belgrom Pedramalho quer que você fale com Rok Orhan, da Aldeia Mojache.‡Поговорите с Рокой Орхан в Лагере Мохаче.‡Belgrom Rockmaul will, dass Ihr mit Rok Orhan im Camp Mojache sprecht.‡벨그롬 록마울이 모자케 야영지에 있는 로크 올한과 대화해 달라고 부탁했습니다.‡Belgrom Destrozarroca quiere que hables con Rok Orhan, del Campamento Mojache.‡Belgrom Destrozarroca quiere que hables con Rok Orhan, del Campamento Mojache.‡Comme le veut Belgrom Rockmaul, aller parler à Rok Orhan, à Camp Mojache.‡贝尔戈洛姆·石槌想让你去和莫沙彻营地的洛卡·奥赫谈一谈。‡貝爾戈洛姆·石槌想讓妳去和莫沙徹營地的洛卡·奧赫談壹談。',
  }
},
[2982] = {
  {
    'A Selva Alta‡Высокогорные дебри‡Die obere Wildnis‡높은벌‡Las Altas Tierras Salvajes‡Las Altas Tierras Salvajes‡Les Plateaux sauvages‡高原荒野‡高原荒野',
    nil,
    'Ângela Brisaluna quer que você mate 8 Bruxos Gordunni, 8 Xamãs Gordunni e 8 Brutamontes Gordunni.‡Убейте 8 чернокнижников из клана Гордунни, 8 шаманов из клана Гордунни и 8 громил из клана Гордунни по просьбе Ангелас Лунный Бриз.‡Angelas Moonbreeze will, dass Ihr 8 Hexenmeister der Gordunni, 8 Schamanen der Gordunni und 8 Schläger der Gordunni tötet.‡안젤라스 문브리즈가 골두니일족 흑마법사 8명, 골두니일족 주술사 8명, 골두니일족 투사 8명을 퇴치해 달라고 부탁했습니다.‡Ángelas Brisaluna quiere que mates a 8 brujos Gordunni, 8 chamanes Gordunni y 8 brutos Gordunni.‡Angelas Brisaluna quiere que mates a 8 brujos Gordunni, 8 chamanes Gordunni y 8 toscos Gordunni.‡Tuer 8 Démonistes Gordunni, 8 Chamans Gordunni et 8 Brutes Gordunni pour Angelas Moonbreeze.‡安吉拉斯·月风要求你杀死8个戈杜尼术士、8个戈杜尼萨满祭司和8个戈杜尼蛮兵。‡安吉拉斯·月風要求妳殺死8個戈杜尼術士、8個戈杜尼薩滿祭司和8個戈杜尼蠻兵。',
  }
},
[2983] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[2984] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[2985] = {
  {
    'Clamor da Água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Waterseer im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Waterseer dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[2986] = {
  {
    'Clamor da Água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Waterseer im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Waterseer dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[2987] = {
  {
    'Cobalto Gordunni‡Кобальт Гордунни‡Gordunnikobalt‡골두니 코발트‡El cobalto Gordunni‡El cobalto Gordunni‡Cobalt Gordunni‡戈杜尼钴矿石‡戈杜尼鈷礦石',
    nil,
    'Orwin Sheiduztruc, na Aldeia Mojache, quer 12 amostras de Cobalto Gordunni.‡Добудьте 12 образцов кобальта Гордунни для Орвина Гиззмика из Лагеря Мохаче.‡Orwin Gizzmick im Camp Mojache will 12 Proben Gordunnikobalt.‡모자케 야영지에 있는 올윈 기즈믹이 골두니 코발트 12개를 가져다 달라고 부탁했습니다.‡Orwin Gizzmick, del Campamento Mojache, quiere 12 muestras de cobalto Gordunni.‡Orwin Cacharrejos, del Campamento Mojache, quiere 12 muestras de cobalto Gordunni.‡Collecter 12 échantillons de Cobalt Gordunni pour Orwin Gizzmick, à Camp Mojache.‡莫沙彻营地的奥尔文·吉兹米克需要12块戈杜尼钴矿石的样本。‡莫沙徹營地的奧爾文·吉茲米克需要12塊戈杜尼鈷礦石的樣本。',
  }
},
[2988] = {
  {
    'Jaulas Cascasseca‡Тролльи клетки‡Käfige der Witherbark‡마른나무껍질부족 우리‡Las jaulas de Secacorteza‡Las jaulas de Secacorteza‡Les cages Witherbark‡枯木巨魔的牢笼‡枯木巨魔的牢籠',
    nil,
    'Verifique as jaulas nas duas aldeias Cascasseca, depois fale novamente com o Mestre de Grifos Garra-de-acha.‡Проверьте клетки в двух деревнях Сухокожих и возвращайтесь к дрессировщику грифонов Разящему Когтю.‡Durchsucht die Käfige in den beiden Dörfern der Witherbark und kehrt dann zu Greifenmeister Talonaxe zurück.‡마른나무껍질 마을 두 곳에 있는 우리들을 확인한 후, 그리핀 조련사 탈론액스에게 돌아가십시오.‡Mira en las jaulas de los poblados Secacorteza y vuelve a ver al maestro de grifos Garracha.‡Mira en las jaulas de los poblados Secacorteza y vuelve a ver al maestro de grifos Garracha.‡Inspecter les cages dans les deux villages Witherbark, puis retourner auprès du Maître des gryphons Talonaxe.‡检查两个枯木巨魔村落里的笼子，然后向狮鹫管理员沙拉克·鹰斧回复。‡檢查兩個枯木巨魔村落裏的籠子，然後向獅鷲管理員沙拉克·鷹斧回復。',
  }
},
[2989] = {
  {
    'Altar de Zul‡Алтарь Зула‡Der Altar von Zul‡줄의 제단‡El Altar de Zul‡El Altar de Zul‡L\'autel de Zul‡祖尔祭坛‡祖爾祭壇',
    nil,
    'Verifique o topo do Altar de Zul, depois fale novamente com o Mestre de Grifos Garra-de-acha.‡Осмотрите вершину Алтаря Зула и возвращайтесь к укротителю грифонов Разящему Когтю.‡Überprüft die Oberfläche des Altars von Zul und kehrt dann zu Greifenmeister Talonaxe zurück.‡줄의 제단 위를 확인한 후, 그리핀 조련사 탈론액스에게 돌아가십시오.‡Mira en el Altar de Zul y vuelve a ver al maestro de grifos Garracha.‡Mira en el Altar de Zul y vuelve a ver al maestro de grifos Garracha.‡Regarder sur le dessus de l\'autel de Zul, puis retourner auprès du Maître des gryphons Talonaxe.‡检查祖尔祭坛的顶部，然后向狮鹫管理员沙拉克·鹰斧报告。‡檢查祖爾祭壇的頂部，然後向獅鷲管理員沙拉克·鷹斧報告。',
  }
},
[2990] = {
  {
    'Tádius Sombraustera‡Тадиус Мрачная Тень‡Thadius Grimshade‡샤디우스 그림섀이드‡Thadius Sombramacabra‡Thadius Sombramacabra‡Thadius Grimshade‡萨迪斯·格希德‡薩迪斯·格希德',
    nil,
    'Leve a Pena de Bicoafiado para Tádius Sombraustera na Barreira do Inferno.‡Принесите перо Остроклюва Тадиусу Мрачной Тени в Выжженные земли.‡Bringt Scharfschnabels Feder zu Thadius Grimshade in die verwüsteten Lande.‡뾰족부리의 깃털을 저주받은 땅에 있는 샤디우스 그림섀이드에게 가져가야 합니다.‡Lleva la pluma de Picoafilado a Thadius Sombramacabra a Las Tierras Devastadas.‡Lleva la pluma de Picoafilado a Thadius Sombramacabra a Las Tierras Devastadas.‡Apporter la Plume de Bec-tranchant à Thadius Grimshade, dans les Terres foudroyées.‡将沙普比克的羽毛交给诅咒之地的萨迪斯·格希德。‡將沙普比克的羽毛交給詛咒之地的薩迪斯·格希德。',
  }
},
[2991] = {
  {
    'Medalhão de Nekrum‡Медальон Некрума‡Nekrums Medaillon‡네크룸의 메달‡Medallón de Nekrum‡Medallón de Nekrum‡Médaillon de Nekrum‡耐克鲁姆的徽章‡耐克魯姆的徽章',
    nil,
    'Leve o Medalhão de Nekrum para Tádius Sombraustera na Barreira do Inferno.‡Отнесите медальон Некрума Тадиусу Мрачной Тени в Выжженные земли.‡Bringt Thadius Grimshade in den verwüsteten Landen Nekrums Medaillon.‡네크룸의 메달을 저주받은 땅에 있는 샤디우스 그림섀이드에게 가져가야 합니다.‡Lleva el medallón de Nekrum a Thadius Sombramacabra a Las Tierras Devastadas.‡Lleva el medallón de Nekrum a Thadius Sombramacabra a Las Tierras Devastadas.‡Apporter le Médaillon de Nekrum à Thadius Grimshade, dans les Terres foudroyées.‡将耐克鲁姆的徽章交给诅咒之地的萨迪斯·格希德。‡將耐克魯姆的徽章交給詛咒之地的薩迪斯·格希德。',
  }
},
[2992] = {
  {
    'A divinação‡Прорицание‡Der Rutengang‡점치기‡El ritual de adivinación‡El ritual de adivinación‡La Divination‡占卜‡占蔔',
    nil,
    'Espere até que Sombraustera termine o ritual de divinação.‡Дождитесь, пока Мрачная Тень не закончит ритуал прорицания.‡Wartet, bis Grimshade das Rutengangritual durchgeführt hat.‡그림섀이드가 점치기 의식을 행하는 동안 기다리십시오.‡Espera a que Sombramacabra realice el ritual de adivinación.‡Espera a que Sombramacabra realice el ritual de adivinación.‡Attendre que Grimshade ait fini de pratiquer son rituel de divination.‡等待萨迪斯完成占卜仪式。‡等待薩迪斯完成占蔔儀式。',
  }
},
[2993] = {
  {
    'Retorno às Terras Agrestes‡Назад во Внутренние земли‡Rückkehr ins Hinterland‡동부 내륙지로 돌아가기‡Vuelve a las Tierras del Interior‡Regresa a las Tierras del Interior‡Retour dans les Hinterlands‡返回辛特兰‡返回辛特蘭',
    nil,
    'Fale com o Mestre de Grifos Garra-de-acha.‡Поговорите с укротителем грифонов Разящим Когтем.‡Sprecht mit Greifenmeister Talonaxe.‡그리핀 조련사 탈론액스와 대화하십시오.‡Habla con el maestro de grifos Garracha.‡Habla con el maestro de grifos Garracha.‡Parler au Maître des gryphons Talonaxe.‡与辛特兰的狮鹫管理员沙拉克·鹰斧谈一谈。‡與辛特蘭的獅鷲管理員沙拉克·鷹斧談壹談。',
  }
},
[2994] = {
  {
    'Salvando Bicoafiado‡Спасение Остроклюва‡Scharfschnabels Rettung‡뾰족부리 구출‡Salvar a Picoafilado‡Salvar a Picoafilado‡Sauver Bec-tranchant‡拯救沙普比克‡拯救沙普比克',
    nil,
    'Lute até o topo de Jintha\'Alor, mate a Sacerdotisa Torpe Bagata para pegar a chave da jaula de Bicoafiado e salvá-lo.‡Пробейтесь в верхнюю часть Джинта\'Алора, убейте коварную жрицу Ведьмису, возьмите у нее ключ от клетки и освободите Остроклюва.‡Kämpft Euch bis zum Gipfel von Jintha’Alor durch, tötet die üble Priesterin Hexx, um an den Schlüssel zu Scharfschnabels Käfig zu kommen, und rettet Scharfschnabel.‡진타알로의 꼭대기까지 올라가 타락한 여사제 헥스를 처치하고 뾰족부리가 갇혀 있는 우리의 열쇠를 빼앗은 다음 뾰족부리를 구출해야 합니다.‡Llega hasta la cima de Jintha\'Alor, mata a la Sacerdotisa Vil Hexx, consigue la llave de la jaula y rescata a Picoafilado.‡Llega hasta la cima de Jintha\'Alor, mata a la sacerdotisa vil Hexx, consigue la llave de la jaula y rescata a Picoafilado.‡Combattre jusqu’au sommet de Jintha\'Alor, tuer la vile prêtresse Maléficia pour obtenir la clé de la cage de Bec-tranchant, et sauver Bec-tranchant.‡到辛萨罗山顶去，杀掉邪恶祭司海克斯，找到沙普比克笼子的钥匙，然后救出沙普比克。‡到辛薩羅山頂去，殺掉邪惡祭司海克斯，找到沙普比克籠子的鑰匙，然後救出沙普比克。',
  }
},
[2995] = {
  {
    'Linhas de comunicação‡Линии связи‡Nachrichtenwege‡연락망‡Líneas de comunicación‡Líneas de comunicación‡Lignes de communication‡联络中心‡聯絡中心',
    nil,
    'Urraca Convulserpe, da Cidade Baixa, quer que você viaje até as Terras Agrestes e queime os Arquivos do Altovale, os Relatórios do Altovale e as Cartas do Altovale.‡Оран Змеиные Кольца из Подгорода просит вас отправиться во Внутренние земли и сжечь отчет Высокодолья, заметки Высокодолья и записи Высокодолья.‡Oran Snakewrithe in Undercity will, dass Ihr ins Hinterland reist und die Hochtalaufzeichnungen, Hochtalberichte und Hochtalnotizen verbrennt.‡언더시티에 있는 오란 스네이크레이드가 동부 내륙지로 가서 깊은골짜기 기록문, 깊은골짜기 보고서, 그리고 깊은골짜기 쪽지를 태워달라고 부탁했습니다.‡Oran Cortopiente de Entrañas quiere que viajes a las Tierras del Interior y que quemes las actas de Vallealto, el informe de Vallealto y las notas de Vallealto.‡Oran Snakewrithe en Entrañas quiere que viajes a Tierras del Interior y quemes los registros de Vallealto, el informe de Vallealto y las notas de Vallealto.‡Voyager dans les Hinterlands et brûler les Registres du Haut-val, le Rapport du Haut-val et les Notes du Haut-val, pour Oran Snakewrithe, à Undercity‡幽暗城的奥兰·斯内克威瑟让你到辛特兰去烧毁高原精灵记录、高原精灵报告和高原精灵信件。‡幽暗城的奧蘭·斯內克威瑟讓妳到辛特蘭去燒毀高原精靈記錄、高原精靈報告和高原精靈信件。',
  }
},
[2996] = {
  {
    'Procurando Strahad‡На поиски Страхада‡Die Suche nach Strahad‡스트라드를 찾아서‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите со Страхадом Фарсаном в Кабестане.‡Sprecht mit Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Ratchet.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談壹談。',
  }
},
[2997] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Battleforge in Ironforge.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Battleforge à Ironforge.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談壹談。',
  }
},
[2998] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Найдите Даториана Ралла в Штормграде и поговорите с ним.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[2999] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Battleforge in Ironforge.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Battleforge, à Ironforge.‡和铁炉堡的蒂萨·热炉谈一谈。‡和鐵爐堡的蒂薩·熱爐談壹談。',
  }
},
[3000] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Battleforge in Ironforge.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Battleforge à Ironforge.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談壹談。',
  }
},
[3001] = {
  {
    'Procurando Strahad‡На поиски Страхада‡Die Suche nach Strahad‡스트라드를 찾아‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Procure Strahad Farsan na Vila Catraca.‡Поговорите со Страхадом Фарсаном в Кабестане.‡Findet Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선을 찾아가야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Trouver Strahad Farsan, à Ratchet.‡在棘齿城找到斯坦哈德·法尔杉。‡在棘齒城找到斯坦哈德·法爾杉。',
  }
},
[3002] = {
  {
    'O orbe Gordunni‡Сфера Гордунни‡Die Gordunnikugel‡골두니 수정구‡El orbe Gordunni‡El orbe Gordunni‡L\'Orbe Gordunni‡戈杜尼宝珠‡戈杜尼寶珠',
    nil,
    'Leve o Orbe Gordunni para Uthel\'nay no Salão Agulhas Negras, em Orgrimmar.‡Отнести сферу Гордунни Утель\'наю в Пристанище Темнотерна в Оргриммаре.‡Bringt die Gordunnikugel zu Uthel’nay in die Dunkeldornen-Lodge in Orgrimmar.‡오그리마의 검은장미 오두막에 있는 우텔나이에게 골두니 수정구를 가져가야 합니다.‡Lleva el orbe Gordunni a Uthel\'nay, que está en el Refugio Zarzaoscura de Orgrimmar.‡Lleva el orbe Gordunni a Uthel\'nay, que está en la Cabaña de Brezo de Orgrimmar.‡Apporter l\'Orbe Gordunni à Uthel\'nay, au pavillon de Buissombre, à Orgrimmar.‡将戈杜尼宝珠交给奥格瑞玛暗木小屋里的尤塞尔奈。‡將戈杜尼寶珠交給奧格瑞瑪暗木小屋裏的尤塞爾奈。',
  }
},
[3022] = {
  {
    'Manuseie com cuidado‡Не кантовать!‡Vorsichtig behandeln‡취급 주의‡Un envío frágil‡Un envío frágil‡À manipuler avec soin‡小心运送‡小心運送',
    nil,
    'Leve o Caixote Cuidadosamente Embalado para Erelas Ambarcéu, na Vila de Rut\'theran.‡Отнесите тщательно упакованный ящик Эреласу Янтарному Небу в деревню Рут\'теран.‡Bringt die sorgfältig verpackte Kiste zu Erelas Ambersky in das Dorf Rut\'theran.‡루테란 마을에 있는 에렐라스 앰버스카이에게 조심스럽게 포장된 상자를 가져가야 합니다.‡Llévale la caja cuidadosamente empaquetada a Erelas Cieloámbar, que está en Aldea Rut\'theran.‡Llévale la caja cuidadosamente empaquetada a Erelas Cieloámbar, que está en Aldea Rut\'theran.‡Apporter la Caisse soigneusement empaquetée à Erelas Ambersky, au village de Rut\'theran.‡把仔细包装过的箱子交给鲁瑟兰村的艾瑞拉斯·琥珀。‡把仔細包裝過的箱子交給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[3042] = {
  {
    'Têmpera de troll‡Троллье месиво‡Trollaushärter‡트롤 경화제‡Temple trol‡Temple trol‡Agent durcissant troll‡巨魔调和剂‡巨魔調和劑',
    nil,
    'Leve 20 Frascos de Têmpera de Troll para Trenton Lumartelo em Geringontzan.‡Принесите 20 фиалов с Тролльим месивом.‡Bringt 20 Phiolen Trollaushärter zu Trenton Lighthammer in Gadgetzan.‡가젯잔에 있는 트렌튼 라이트해머에게 트롤 경화제 20병을 가져가야 합니다.‡Lleva 20 viales de temple trol a Trenton Mazaligera en Gadgetzan.‡Lleva 20 viales de temple trol a Trenton Mazaligera en Gadgetzan.‡Apporter 20 Fioles d\'agent durcissant troll à Trenton Lighthammer, dans Gadgetzan.‡收集20瓶巨魔调和剂，把它们交给加基森的特伦顿·轻锤。‡收集20瓶巨魔調和劑，把它們交給加基森的特倫頓·輕錘。',
  }
},
[3062] = {
  {
    'Coração sombrio‡Темное сердце‡Dunkles Herz‡검은 심장‡Negro corazón‡Corazón oscuro‡Coeur noir‡黑暗之心‡黑暗之心',
    nil,
    'Talo Casco de Espinhos, da Aldeia Mojache, quer o Coração Sombrio de Edana Iragarra.‡Принесите темное сердце Эданы Коготь Ненависти Тало Терновому Копыту.‡Talo Thornhoof im Camp Mojache will das dunkle Herz von Edana Hasskralle.‡모자케 야영지에 있는 탈로 쏜후프가 에다나의 검은 심장을 가져다 달라고 부탁했습니다.‡Talo Pezuñahendida, del Campamento Mojache quiere el corazón oscuro de Edana Garraodio.‡Talo Pezuñahendida, del Campamento Mojache quiere el corazón oscuro de Edana Garfaodio.‡Rapporter le Coeur noir d\'Edana Serrehaine à Talo Thornhoof, à Camp Mojache.‡莫沙彻营地的塔罗·刺蹄要你给他拿去艾丹娜·邪爪的黑心。‡莫沙徹營地的塔羅·刺蹄要妳給他拿去艾丹娜·邪爪的黑心。',
  }
},
[3063] = {
  {
    'Vingança em Nascente Norte‡Месть стае Студеных Ключей‡Rache an den Nordschwingen‡바람계곡일족에 대한 복수‡Vengarse de las Nortearroyo‡Venganza contra Nortearroyo‡Se venger des Ruissenord‡对鹰身人的复仇‡對鷹身人的復仇',
    nil,
    'Talo Casco de Espinhos quer que você mate 4 Harpias da Nascente Norte, 4 Plumerrantes da Nascente Norte, 4 Arautos do Vento da Nascente Norte e 4 Matadoras da Nascente Norte.‡Убейте 4 гарпий из стаи Студеных Ключей, 4 разбойниц из стаи Студеных Ключей, 4 зовущих из стаи Студеных Ключей и 4 убийц из стаи Студеных Ключей по просьбе Тало Тернового Копыта.‡Talo Thornhoof möchte, dass Ihr 4 Harpyien der Nordschwingen, 4 Wildfedern der Nordschwingen, 4 Windruferinnen der Nordschwingen und 4 Töter der Nordschwingen erschlagt.‡탈로 쏜후프가 바람계곡일족 하피 4마리, 바람계곡일족 약탈자 4마리, 바람계곡일족 바람마녀 4마리, 그리고 바람계곡일족 암살자 4마리를 처치해 달라고 부탁했습니다.‡Talo Pezuñahendida quiere que mates a 4 harpías Nortearroyo, 4 plumapícaros Nortearroyo, 4 clamavientos Nortearroyo y 4 destripadores Nortearroyo.‡Talo Pezuñahendida quiere que mates a 4 arpías Nortearroyo, 4 Malaplumas Nortearroyo, 4 clamavientos Nortearroyo y 4 destripadoras Nortearroyo.‡Tuer 4 Harpies Ruissenord, 4 Volplumes Ruissenord, 4 Imploratrices célestes Ruissenord et 4 Pourfendeuses Ruissenord pour Talo Thornhoof.‡塔罗·刺蹄让你杀掉4个北泉鹰身人、4个北泉游荡者、4个北泉唤风者和4个北泉杀戮者。‡塔羅·刺蹄讓妳殺掉4個北泉鷹身人、4個北泉遊蕩者、4個北泉喚風者和4個北泉殺戮者。',
  }
},
[3064] = {
  {
    '‡‡‡‡‡<NYI> <TXT> Pirate Hats‡‡‡',
    nil,
    '‡‡‡‡‡Bring 20 Untorn Pirate Hats to Yorba Screwspigot.‡‡‡',
  }
},
[3065] = {
  {
    'Tabuleta Simples‡Простая табличка‡Einfache Schrifttafel‡간결한 서판‡Tablilla sencilla‡Tablilla simple‡Tablette simple‡普通石板‡普通石板',
    nil,
    'Leia a Tabuleta Simples e fale com Frang no Vale das Provações.‡Прочтите простую табличку и поговорите с Франгом в долине Испытаний.‡Lest die einfache Schrifttafel und sprecht mit Frang im Tal der Prüfungen.‡간결한 서판을 읽어보고 시험의 골짜기에 있는 프랑과 대화하십시오.‡Lee la Tablilla sencilla y habla con Frang en el Valle de los Retos.‡Lee la Tablilla simple y habla con Frang en el Valle de los Retos.‡Lire la Tablette simple, et parler à Frang, dans la Vallée des épreuves.‡阅读普通石板，然后和试炼谷的弗朗恩谈一谈。‡閱讀普通石板，然後和試煉谷的弗朗恩談壹談。',
  }
},
[3082] = {
  {
    'Tabuleta cinzelada‡Каменная табличка‡Geätzte Schrifttafel‡글이 새겨진 서판‡Tablilla con grabados‡Tablilla con grabados‡Tablette gravée‡风蚀石板‡風蝕石板',
    nil,
    'Encontre Jen\'shan no Vale das Provações.‡Поговорите с Джен\'шан в долине Испытаний.‡Sprecht mit Jen\'shan im Tal der Prüfungen.‡글이 새겨진 서판을 읽어보고 시험의 골짜기에 있는 젠샨과 대화하십시오.‡Habla con Jen\'shan en el Valle de los Retos.‡Habla con Jen\'shan en el Valle de los Retos.‡Parler à Jen\'shan dans la Vallée des épreuves‡和试炼谷的基沙谈一谈。‡和試煉谷的基沙談壹談。',
  }
},
[3083] = {
  {
    'Tabuleta cifrada‡Табличка с письменами‡Verschlüsselte Schrifttafel‡암호화된 서판‡Tablilla encriptada‡Tablilla encriptada‡Tablette codée‡密文石板‡密文石板',
    nil,
    'Leia a Tabuleta Cifrada e fale com Rwag no Vale das Provações.‡Прочтите табличку с письменами и поговорите с Руагом в долине Испытаний.‡Lest die verschlüsselte Schrifttafel und sprecht mit Rwag im Tal der Prüfungen.‡암호화된 서판을 읽어보고 시험의 골짜기에 있는 르와그와 대화하십시오.‡Lee la Tablilla encriptada y habla con Rwag en el Valle de los Retos.‡Lee la Tablilla encriptada y habla con Rwag en el Valle de los Retos.‡Lire la Tablette codée, et parler à Rwag, dans la Vallée des épreuves.‡阅读密文石板，然后和试炼谷的鲁瓦格谈一谈。‡閱讀密文石板，然後和試煉谷的魯瓦格談壹談。',
  }
},
[3084] = {
  {
    'Tabuleta inscrita em runas‡Руническая табличка‡Mit Runen beschriftete Schrifttafel‡룬으로 새겨진 서판‡Tablilla inscrita con runas‡La tablilla con runas grabadas‡Tablette runique‡符文石板‡符文石板',
    nil,
    'Fale com Shikrik no Vale das Provações.‡Поговорите с Шикрик в долине Испытаний.‡Sprecht mit Shikrik im Tal der Prüfungen.‡룬으로 새겨진 서판을 읽어보고 시험의 골짜기에 있는 시크리크와 대화하십시오.‡Habla con Shikrik en el Valle de los Retos.‡Habla con Shikrik en el Valle de los Retos.‡Parler à Shikrik dans la Vallée des épreuves.‡和试炼谷的史克里克谈一谈。‡和試煉谷的史克裏克談壹談。',
  }
},
[3085] = {
  {
    'Tabuleta consagrada‡Освященная табличка‡Geheiligte Schrifttafel‡성스러운 서판‡Tablilla Sagrada‡Tablilla sacralizada‡Tablette bénie‡神圣石板‡神聖石板',
    nil,
    'Leia a Tabuleta Consagrada e fale com Ken\'jai, do lado de fora do Covil, no Vale das Provações.‡Прочтите освященную табличку и поговорите с Кен\'джаем у Логова в долине Испытаний.‡Lest die geheiligte Schrifttafel und sprecht mit Ken\'jai außerhalb des Höhlenbaus im Tal der Prüfungen.‡성스러운 서판을 읽어보고 시험의 골짜기의 동굴 막사 밖에 있는 켄자이와 대화하십시오.‡Lee la Tablilla sagrada y habla con Ken\'jai a las puertas de El Cubil en el Valle de los Retos.‡Lee la tablilla sacralizada y habla con Ken\'jai a las puertas de El Cubil en el Valle de los Retos.‡Lire la Tablette bénie, et parler à Ken\'jai, à l’extérieur de l’Antre, dans la Vallée des épreuves.‡阅读神圣石板，然后和试炼谷大兽穴外的肯杰谈一谈。‡閱讀神聖石板，然後和試煉谷大獸穴外的肯傑談壹談。',
  }
},
[3086] = {
  {
    'Tabuleta glífica‡Табличка с тайными знаками‡Glyphen-Schrifttafel‡상형 문자로 된 서판‡Tablilla con glifos‡Tablilla glífica‡Tablette glyphée‡雕文石板‡雕文石板',
    nil,
    'Leia a Tabuleta Glífica e fale com Mai\'ah perto do Covil, no Vale das Provações.‡Прочтите табличку с тайными знаками и поговорите с Май\'ах у входа в Логово в долине Испытаний.‡Lest die mit Glyphen versehene Schrifttafel und sprecht mit Mai\'ah beim Eingang zum Höhlenbau im Tal der Prüfungen.‡상형 문자로 된 서판을 읽어보고 시험의 골짜기의 동굴 막사 입구 근처에 있는 마이아와 대화하십시오.‡Lee la Tablilla con glifos y habla con Mai\'ah junto a la entrada a El Cubil, en el Valle de los Retos.‡Lee la tablilla glífica y habla con Mai\'ah junto a la entrada a El Cubil, en el Valle de los Retos.‡Lire la Tablette glyphée, et parler à Mai\'ah, près de l’entrée de l’Antre, dans la Vallée des épreuves.‡阅读雕文石板，然后和试炼谷里大兽穴入口附近的迈安谈一谈。‡閱讀雕文石板，然後和試煉谷裏大獸穴入口附近的邁安談壹談。',
  }
},
[3087] = {
  {
    'Pergaminho cinzelado‡Пергамент с письменами‡Geätztes Pergament‡글이 새겨진 양피지‡Pergamino con grabados‡Papiro con grabados‡Parchemin gravé‡风蚀羊皮纸‡風蝕羊皮紙',
    nil,
    'Leia o Pergaminho Cinzelado e fale com Jen\'shan no Vale das Provações.‡Прочтите пергамент с письменами и поговорите с Джен\'шан в долине Испытаний.‡Lest das geätzte Pergament und sprecht mit Jen\'shan im Tal der Prüfungen.‡글이 새겨진 양피지를 읽어보고 시험의 골짜기에 있는 젠샨과 대화하십시오.‡Lee el Pergamino con grabados y habla con Jen\'shan en el Valle de los Retos.‡Lee el papiro con grabados y habla con Jen\'shan en el Valle de los Retos.‡Lire le Parchemin gravé, et parler à Jen\'shan, dans la Vallée des épreuves.‡阅读风蚀羊皮纸，然后和试炼谷的基沙谈一谈。‡閱讀風蝕羊皮紙，然後和試煉谷的基沙談壹談。',
  }
},
[3088] = {
  {
    'Pergaminho cifrado‡Исписанный пергамент‡Verschlüsseltes Pergament‡암호화된 양피지‡Pergamino encriptado‡Papiro encriptado‡Parchemin codé‡密文羊皮纸‡密文羊皮紙',
    nil,
    'Leia o Pergaminho Cifrado e fale com Rwag no Vale das Provações.‡Прочтите исписанный пергамент и поговорите с Руагом в долине Испытаний.‡Lest das verschlüsselte Pergament und sprecht mit Rwag im Tal der Prüfungen.‡암호화된 양피지를 읽어보고 시험의 골짜기에 있는 르와그와 대화하십시오.‡Lee el Pergamino encriptado y habla con Rwag en el Valle de los Retos.‡Lee el papiro encriptado y habla con Rwag en el Valle de los Retos.‡Lire le Parchemin codé, et parler à Rwag, dans la Vallée des épreuves.‡阅读密文羊皮纸，然后和试炼谷的鲁瓦格谈一谈。‡閱讀密文羊皮紙，然後和試煉谷的魯瓦格談壹談。',
  }
},
[3089] = {
  {
    'Pergaminho inscrito em runas‡Рунический пергамент‡Mit Runen beschriftetes Pergament‡룬으로 새겨진 양피지‡Pergamino inscrito con runas‡El papiro con runas grabadas‡Parchemin runique‡符文羊皮纸‡符文羊皮紙',
    nil,
    'Leia o Pergaminho Inscrito em Runas e fale com Shikrik no Vale das Provações.‡Прочтите рунический пергамент и поговорите с Шикрик в долине Испытаний.‡Lest das mit Runen beschriebene Pergament und sprecht mit Shikrik im Tal der Prüfungen.‡룬으로 새겨진 양피지를 읽어보고 시험의 골짜기에 있는 시크리크와 대화하십시오.‡Lee el Pergamino inscrito con runas y habla con Shilkrik en el Valle de los Retos.‡Lee el papiro con runas grabadas y habla con Shikrik en el Valle de los Retos.‡Lire le Parchemin runique, et parler à Shikrik, dans la Vallée des épreuves.‡阅读符文羊皮纸，然后和试炼谷的史克里克谈一谈。‡閱讀符文羊皮紙，然後和試煉谷的史克裏克談壹談。',
  }
},
[3090] = {
  {
    'Pergaminho maculado‡Гниющий пергамент‡Besudeltes Pergament‡오래된 양피지‡Pergamino corrupto‡Papiro corrupto‡Parchemin contaminé‡被污染的羊皮纸‡被汙染的羊皮紙',
    nil,
    'Leia o Pergaminho Conspurcado e fale com Nartok dentro do Covil, no Vale das Provações.‡Прочтите гниющий пергамент и поговорите с Нартоком в Логове в долине Испытаний.‡Lest das besudelte Pergament und sprecht mit Nartok im Höhlenbau im Tal der Prüfungen.‡오래된 양피지를 읽어보고 시험의 골짜기의 동굴 막사에 있는 나르톡과 대화하십시오.‡Lee el Pergamino corrupto y habla con Nartok en El Cubil en el Valle de los Retos.‡Lee el papiro corrupto y habla con Nartok en el Cubil del Valle de los Retos.‡Lire le Parchemin contaminé, et parler à Nartok, à l’intérieur de l’Antre, dans la Vallée des épreuves.‡阅读被污染的羊皮纸，然后到试炼谷的大兽穴里去和纳托克谈一谈。‡閱讀被汙染的羊皮紙，然後到試煉谷的大獸穴裏去和納托克談壹談。',
  }
},
[3091] = {
  {
    'Bilhete‡Простая записка‡Einfache Notiz‡간결한 쪽지‡La nota simple‡La nota simple‡Note simple‡简易便笺‡簡易便箋',
    nil,
    'Leia o Bilhete e fale com Harutt Chifre Troante, na Aldeia Narache.‡Прочтите простую записку и поговорите с Харуттом Громовым Рогом в Лагере Нараче.‡Lest die einfache Nachricht und sprecht mit Harutt Thunderhorn im Camp Narache.‡간결한 쪽지를 읽고 나라체 야영지에 있는 하루트 썬더혼과 대화해야 합니다.‡Lee la nota simple y habla con Harutt Astatrueno en el Campamento Narache.‡Lee la nota simple y habla con Harutt Tronacuerno en el Campamento Narache.‡Lire la Note simple, et parler à Harutt Thunderhorn, à Camp Narache.‡阅读简易便笺，然后与纳拉其营地的哈鲁特·雷角谈一谈。‡閱讀簡易便箋，然後與納拉其營地的哈魯特·雷角談壹談。',
  }
},
[3092] = {
  {
    'Bilhete cinzelado‡Нацарапанная записка‡Geätzte Notiz‡글이 새겨진 쪽지‡La nota con grabados‡La nota con grabados‡Note gravée‡风化便笺‡風化便箋',
    nil,
    'Leia o Bilhete Cinzelado e fale com Lanka Tiro Distante na Chapada Nuvem Vermelha.‡Прочтите нацарапанную записку и поговорите с Ланко Дальнострелом на Плато Красного Облака.‡Lest die geätzte Nachricht und sprecht mit Lanka Farshot in Red Cloud Mesa.‡글이 새겨진 쪽지를 읽고 붉은구름 고원에 있는 랑카 파샷과 대화해야 합니다.‡Lee la nota con grabados y habla con Lanka Tirolargo en Mesa de la Nube Roja.‡Lee la nota con grabados y habla con Lanka Tirolejano en la Mesa de la Nube Roja.‡Lire la Note gravée, et parler à Lanka Farshot, sur la Mesa de Nuage rouge.‡阅读风化便笺，然后与红云台地的兰卡·远箭谈一谈。‡閱讀風化便箋，然後與紅雲臺地的蘭卡·遠箭談壹談。',
  }
},
[3093] = {
  {
    'Bilhete inscrito em runas‡Руническая записка‡Mit Runen beschriftete Notiz‡룬으로 새겨진 쪽지‡La nota con runas‡La nota con runas grabadas‡Note runique‡符文便笺‡符文便箋',
    nil,
    'Leia o Bilhete Inscrito em Runas e fale com Meela Anda com a Aurora na Aldeia Narache.‡Прочтите руническую записку и поговорите с Милой Рассветной Странницей в Лагере Нараче.‡Lest die mit Runen beschriftete Nachricht und sprecht mit Meela Dawnstrider im Camp Narache.‡룬으로 새겨진 쪽지를 읽고 나라체 야영지에 있는 밀라 던스트라이더와 대화해야 합니다.‡Lee la nota con runas y habla con Meela Caminocaso en el Campamento Narache.‡Lee la nota con runas y habla con Meela Caminalba en el Campamento Narache.‡Lire la Note runique, et parler à Meela Dawnstrider, à Camp Narache.‡阅读符文便笺，然后与纳拉其营地的米拉·晨行者谈一谈。‡閱讀符文便箋，然後與納拉其營地的米拉·晨行者談壹談。',
  }
},
[3094] = {
  {
    'Bilhete verdejante‡Зеленая записка‡Tiefgrüne Notiz‡푸른 쪽지‡La nota verde‡La nota verdeante‡Note verdoyante‡绿色便笺‡綠色便箋',
    nil,
    'Leia o Bilhete Verdejante e fale com Gart Corre com a Névoa, na Aldeia Narache.‡Прочтите зеленую записку и поговорите с Гартом Вестником Туманов в Лагере Нараче.‡Lest die tiefgrüne Notiz und sprecht mit Gart Mistrunner im Camp Narache.‡푸른 쪽지를 읽고 나라체 야영지에 있는 가트 미스트러너와 대화해야 합니다.‡Lee la nota verde y habla con Gart Correbruma en el Campamento Narache.‡Lee la nota verdeante y habla con Gart Correbruma en el Campamento Narache.‡Lire la Note verdoyante, et parler à Gart Mistrunner, à Camp Narache.‡阅读绿色便笺，然后与纳拉其营地的加尔特·迷雾行者谈一谈。‡閱讀綠色便箋，然後與納拉其營地的加爾特·迷霧行者談壹談。',
  }
},
[3095] = {
  {
    'Pergaminho simples‡Простой свиток‡Einfache Rolle‡간결한 두루마리‡Un pergamino simple‡Un pergamino simple‡Parchemin simple‡简易卷轴‡簡易卷軸',
    nil,
    'Leia o Pergaminho Simples e fale com Dannal Stern em Plangemortis.‡Прочитайте простой свиток и поговорите с Данналом Штерном в Могильнике.‡Lest die einfache Schriftrolle und sprecht mit Dannal Stern in Deathknell.‡간결한 두루마리를 읽고 데스넬에 있는 다날 스턴과 대화해야 합니다.‡Lee el pergamino simple, luego ve a Camposanto y habla con Dannal Stern.‡Lee el pergamino simple, luego ve a Camposanto y habla con Dannal Stern.‡Lire le Parchemin simple, et parler à Dannal Stern, au Glas.‡阅读简易卷轴，然后和丧钟镇的丹纳尔·斯特恩谈一谈。‡閱讀簡易卷軸，然後和喪鐘鎮的丹納爾·斯特恩談壹談。',
  }
},
[3096] = {
  {
    'Pergaminho cifrado‡Зашифрованный свиток‡Verschlüsselte Rolle‡암호화된 두루마리‡Un pergamino encriptado‡Un pergamino codificado‡Parchemin codé‡密文卷轴‡密文卷軸',
    nil,
    'Leia o Pergaminho Cifrado e fale com o Davi Trias em Plangemortis.‡Прочитайте зашифрованный свиток и поговорите с Давидом Триасом в Могильнике.‡Lest die verschlüsselte Schriftrolle und sprecht mit David Trias in Deathknell.‡암호화된 두루마리를 읽고 데스넬에 있는 데이비드 트리아스와 대화해야 합니다.‡Lee el pergamino encriptado, luego ve a Camposanto y habla con David Trias.‡Lee el pergamino encriptado, luego ve a Camposanto y habla con David Trias.‡Lire le Parchemin codé, et parler à David Trias, au Glas.‡阅读密文卷轴，然后和丧钟镇的大卫·提亚斯谈一谈。‡閱讀密文卷軸，然後和喪鐘鎮的大衛·提亞斯談壹談。',
  }
},
[3097] = {
  {
    'Pergaminho consagrado‡Священный свиток‡Geheiligte Rolle‡성스러운 두루마리‡Un pergamino sagrado‡Un pergamino sacralizado‡Parchemin béni‡神圣卷轴‡神聖卷軸',
    nil,
    'Leia o Pergaminho Consagrado e fale com o Clérigo das Trevas Duesten, na igreja em Plangemortis.‡Прочитайте священный свиток и поговорите с темным священником Дьюстеном в церкви Могильника.‡Lest die geheiligte Schriftrolle und sprecht mit dem dunklen Kleriker Duesten in der Kirche von Deathknell.‡성스러운 두루마리를 읽고 데스넬의 교회에 있는 어둠의사제 듀스텐과 대화해야 합니다.‡Lee el pergamino sagrado, luego ve a la iglesia de Camposanto y habla con el clérigo oscuro Duesten.‡Lee el pergamino sagrado, luego ve a la iglesia de Camposanto y habla con el clérigo oscuro Duesten.‡Lire le Parchemin béni, et parler au sombre clerc Duesten, dans l’église du Glas.‡阅读神圣卷轴，然后和丧钟镇教堂的黑暗牧师杜斯滕谈一谈。‡閱讀神聖卷軸，然後和喪鐘鎮教堂的黑暗牧師杜斯滕談壹談。',
  }
},
[3098] = {
  {
    'Pergaminho glífico‡Свиток, покрытый письменами‡Glyphen-Rolle‡상형 문자로 된 두루마리‡Un pergamino con glifos‡Un pergamino glífico‡Parchemin glyphé‡雕文卷轴‡雕文卷軸',
    nil,
    'Leia o Pergaminho Glífico e fale com Isabella na igreja em Plangemortis.‡Прочитайте свиток, покрытый письменами, и поговорите с Изабеллой в церкви Могильника.‡Lest die mit Glyphen versehene Schriftrolle und sprecht mit Isabella in der Kirche von Deathknell.‡상형 문자로 된 두루마리를 읽고 데스넬 교회에 있는 이자벨라와 대화해야 합니다.‡Lee el pergamino con glifos, luego ve a la iglesia de Camposanto y habla con Isabella.‡Lee el pergamino glífico, luego ve a la iglesia de Camposanto y habla con Isabella.‡Lire le Parchemin glyphé, et parler à Isabella, dans l’église du Glas.‡阅读雕文卷轴，然后和丧钟镇教堂的伊莎贝拉谈一谈。‡閱讀雕文卷軸，然後和喪鐘鎮教堂的伊莎貝拉談壹談。',
  }
},
[3099] = {
  {
    'Pergaminho conspurcado‡Нечистый свиток‡Besudelte Rolle‡오래된 두루마리‡Un pergamino manchado‡Un pergamino corrupto‡Rouleau contaminé‡被污染的卷轴‡被汙染的卷軸',
    nil,
    'Leia o Pergaminho Conspurcado e fale com Maximillion em Plangemortis.‡Прочитайте нечистый свиток и поговорите с Максимиллионом в Могильнике.‡Lest die besudelte Schriftrolle und sprecht mit Maximillion in Deathknell.‡오래된 두루마리를 읽고 데스넬에 있는 맥시밀리언과 대화해야 합니다.‡Lee el pergamino manchado, luego ve a Camposanto y habla con Maximillion.‡Lee el pergamino corrupto, luego ve a Camposanto y habla con Maximillion.‡Lire le Rouleau contaminé, et parler à Maximillion, au Glas.‡阅读被污染的卷轴，然后和丧钟镇的马克希米林谈一谈。‡閱讀被汙染的卷軸，然後和喪鐘鎮的馬克希米林談壹談。',
  }
},
[3100] = {
  {
    'Carta simples‡Обычное письмо‡Einfacher Brief‡간결한 편지‡Una carta simple‡Una carta simple‡Lettre simple‡简要的信件‡簡要的信件',
    nil,
    'Leia a Carta Simples e fale com Hipólito Valentim na Abadia de Vila Norte.‡Прочитайте обычное письмо и поговорите с Лланом Бишером в Аббатстве Североземья.‡Lest den einfachen Brief und sprecht mit Llane Beshere in der Abtei von Nordhain.‡간결한 편지를 읽고 노스샤이어 수도원에 있는 레인 비셰어와 대화해야 합니다.‡Lee la carta simple y habla con Llane Beshere en la Abadía de Villanorte.‡Lee la carta simple y habla con Llane Beshere en la Abadía de Villanorte.‡Lire la Lettre simple et parler à Llane Beshere, à l’Abbaye de Northshire.‡阅读简要的信件，然后与北郡修道院的莱尼·拜舍尔谈一谈。‡閱讀簡要的信件，然後與北郡修道院的萊尼·拜舍爾談壹談。',
  }
},
[3101] = {
  {
    'Carta consagrada‡Благословенное письмо‡Geweihter Brief‡신성한 편지‡Una carta consagrada‡Una carta consagrada‡Lettre consacrée‡圣洁信件‡聖潔信件',
    nil,
    'Leia a Carta Consagrada e fale com o Irmão Samuel na Abadia de Vila Norte.‡Прочитайте благословенное письмо и поговорите с братом Самуэлем в Аббатстве Североземья.‡Lest den geweihten Brief und sprecht mit Bruder Sammuel in der Abtei von Nordhain.‡신성한 편지를 읽고 노스샤이어 수도원에 있는 수사 사무엘과 대화해야 합니다.‡Lee la carta consacrada y habla con el hermano Sammuel en la Abadía de Villanorte.‡Lee la carta consagrada y habla con el hermano Sammuel en la Abadía de Villanorte.‡Lire la Lettre consacrée, et parler à Frère Sammuel, à l’Abbaye de Northshire.‡阅读圣洁信件，然后和北郡修道院的萨缪尔修士谈一谈。‡閱讀聖潔信件，然後和北郡修道院的薩繆爾修士談壹談。',
  }
},
[3102] = {
  {
    'Carta cifrada‡Зашифрованное письмо‡Verschlüsselter Brief‡암호화된 편지‡Una carta cifrada‡Una carta cifrada‡Lettre codée‡密文信件‡密文信件',
    nil,
    'Leia a Carta Cifrada e fale com Rufino Raposo no estábulo atrás da Abadia de Vila Norte.‡Прочитайте зашифрованное письмо и поговорите с Джориком Керриданом в стойлах за Аббатством Североземья.‡Lest den verschlüsselten Brief und sprecht mit Jorik Kerridan im Stall hinter der Abtei von Nordhain.‡암호화된 편지를 읽고 노스샤이어 수도원 뒤 마구간에 있는 요리크 케리던과 대화해야 합니다.‡Lee la carta cifrada y habla con Jorik Kerridan en el establo que hay tras la Abadía de Villanorte.‡Lee la carta cifrada y habla con Jorik Kerridan en el establo que hay tras la Abadía de Villanorte.‡Lire la Lettre codée, et parler à Jorik Kerridan, dans l’écurie, derrière l’Abbaye de Northshire.‡阅读密文信件，然后与北郡修道院的乔里克·克里丹谈一谈。‡閱讀密文信件，然後與北郡修道院的喬裏克·克裏丹談壹談。',
  }
},
[3103] = {
  {
    'Carta santificada‡Святое письмо‡Geheiligter Brief‡성스러운 편지‡Una carta sacralizada‡Una carta sacralizada‡Lettre bénie‡神圣信件‡神聖信件',
    nil,
    'Lei a Carta Santificada e fale com a Sacerdotisa Anita na Abadia de Vila Norte.‡Прочитайте святое письмо и поговорите с жрицей Анеттой в Аббатстве Североземья.‡Lest den geheiligten Brief und sprecht mit Priesterin Anetta in der Abtei von Nordhain.‡성스러운 편지를 읽고 노스샤이어 수도원에 있는 여사제 아네타와 대화해야 합니다.‡Lee la carta sacralizada y habla con la sacerdotisa Anetta en la Abadía de Villanorte.‡Lee la carta sacralizada y habla con la sacerdotisa Anetta en la Abadía de Villanorte.‡Lire la Lettre bénie, et parler à la prêtresse Anetta, à l’abbaye de Northshire.‡阅读神圣信件，然后与北郡修道院的牧师安妮塔谈一谈。‡閱讀神聖信件，然後與北郡修道院的牧師安妮塔談壹談。',
  }
},
[3104] = {
  {
    'Carta glífica‡Символьное письмо‡Glyphen-Brief‡상형 문자로 된 편지‡Una carta con glifos‡Una carta glífica‡Lettre glyphée‡雕文信件‡雕文信件',
    nil,
    'Leia a Carta Glífica e fale com Gaspar Melchior dentro da Abadia de Vila Norte.‡Прочитайте символьное письмо и поговорите с Кельденом Бременом в Аббатстве Североземья.‡Lest den mit Glyphen versehenen Brief und sprecht mit Kheldon Bremen in der Abtei von Nordhain.‡상형 문자로 된 편지를 읽고 노스샤이어 수도원 안에 있는 켈덴 브레멘과 대화해야 합니다.‡Lee la carta con glifos y habla con Khelden Bremen en la Abadía de Villanorte.‡Lee la carta glífica y habla con Khelden Bremen en la Abadía de Villanorte.‡Lire la Lettre glyphée, et parler à Kheldon Bremen, à l’intérieur de l’Abbaye de Northshire.‡阅读雕文信件，然后与北郡修道院的凯尔东·布雷曼谈一谈。‡閱讀雕文信件，然後與北郡修道院的凱爾東·布雷曼談壹談。',
  }
},
[3105] = {
  {
    'Carta maculada‡Тайное письмо‡Besudelter Brief‡오래된 편지‡Una carta manchada‡Una carta manchada‡Lettre contaminée‡被污染的信件‡被汙染的信件',
    nil,
    'Leia a Carta Maculada e fale com Drusilla La Salle perto da Abadia de Vila Norte.‡Прочитайте тайное письмо и поговорите с Друзиллой ла Салле возле Аббатства Североземья.‡Lest den besudelten Brief und sprecht mit Drusilla La Salle nahe der Abtei von Nordhain.‡오래된 편지를 읽고 노스샤이어 수도원 옆에 있는 드루실라 라 살르와 대화해야 합니다.‡Lee la carta impía y habla con Drusilla La Salle junto a la Abadía de Villanorte.‡Lee la carta impía y habla con Drusilla La Salle junto a la Abadía de Villanorte.‡Lire la Lettre contaminée, et parler à Drusilla La Salle, à proximité de l’Abbaye de Northshire.‡阅读被污染的信件，然后与北郡修道院旁边的杜希拉·拉萨雷谈一谈。‡閱讀被汙染的信件，然後與北郡修道院旁邊的杜希拉·拉薩雷談壹談。',
  }
},
[3106] = {
  {
    'Runa simples‡Простая руна‡Einfache Rune‡간결한 룬‡Runa simple‡Runa simple‡Rune simple‡简易符文‡簡易符文',
    nil,
    'Leia a Runa Simples e fale com Thran Khorman no Vale Cristálgida.‡Изучите простую руну. Найдите в Холодной долине Трана Кормана и поговорите с ним.‡Lest die einfache Rune und sprecht mit Thran Khorman im Coldridgetal.‡간결한 룬을 읽어보고 눈마루 골짜기에 있는 스란 코르만과 대화하십시오.‡Lee la runa simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lee la runa simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lire la Rune simple, et parler à Thran Khorman, dans la Vallée des Frigères.‡阅读简易符文，然后与寒脊山谷的斯兰·库尔曼谈一谈。‡閱讀簡易符文，然後與寒脊山谷的斯蘭·庫爾曼談壹談。',
  }
},
[3107] = {
  {
    'Runa consagrada‡Священная руна‡Geweihte Rune‡신성한 룬‡Runa consagrada‡Runa consagrada‡Rune consacrée‡神圣符文‡神聖符文',
    nil,
    'Leia a Runa Consagrada e fale com Bromos Grummner no Vale Cristálgida.‡Изучите священную руну. Найдите в Холодной долине Бромоса Груммнера и поговорите с ним.‡Lest die geweihte Rune und sprecht mit Bromos Grummner im Coldridgetal.‡신성한 룬을 읽어보고 눈마루 골짜기에서 브로모스 그럼너를 찾아 대화해야 합니다.‡Lee la runa consacrada, luego ve al Valle de Crestanevada y habla con Bromos Grummner.‡Lee la runa consagrada, luego ve al Valle de Crestanevada y habla con Bromos Grummner.‡Lire la Rune consacrée, et parler à Bromos Grummner, dans la Vallée des Frigères.‡阅读神圣符文，然后与寒脊山谷的布罗莫斯·格鲁诺尔谈一谈。‡閱讀神聖符文，然後與寒脊山谷的布羅莫斯·格魯諾爾談壹談。',
  }
},
[3108] = {
  {
    'Runa cinzelada‡Гравированная руна‡Geätzte Rune‡글이 새겨진 룬‡Runa con grabados‡Runa con grabados‡Rune gravée‡风蚀符文‡風蝕符文',
    nil,
    'Leia a Runa Cinzelada e fale com Thorgas Grimson no Vale Cristálgida.‡Изучите гравированную руну. Найдите в Холодной долине Торгаса Мрачнона и поговорите с ним.‡Lest die geätzte Rune und sprecht mit Thorgas Grimson im Coldridgetal.‡글이 새겨진 룬을 읽어보고 눈마루 골짜기에 있는 토르가스 그림슨과 대화하십시오.‡Lee la runa con grabados, luego ve al Valle de Crestanevada y habla con Thorgas Grimson.‡Lee la runa con grabados y luego habla con Thorgas Grimson en Valle de Crestanevada.‡Lire la Rune gravée, et parler à Thorgas Grimson, dans la Vallée des Frigères.‡阅读风蚀符文，然后与寒脊山谷的索加斯·格瑞姆森谈一谈。‡閱讀風蝕符文，然後與寒脊山谷的索加斯·格瑞姆森談壹談。',
  }
},
[3109] = {
  {
    'Runa cifrada‡Зашифрованная руна‡Verschlüsselte Rune‡암호화된 룬‡Runa encriptada‡Runa codificada‡Rune codée‡密文符文‡密文符文',
    nil,
    'Leia a Runa Cifrada e fale com Solm Hargrin no Vale Cristálgida.‡Изучите зашифрованную руну. Найдите в Холодной долине Сольма Харгрина и поговорите с ним.‡Lest die verschlüsselte Rune und sprecht mit Solm Hargrin im Coldridgetal.‡암호화된 룬을 읽어보고 눈마루 골짜기에 있는 솔름 하르그린과 대화하십시오.‡Lee la runa encriptada, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lee la runa codificada, luego ve a Yunquemar y habla con Solm Hargrin.‡Lire la Rune codée, et parler à Solm Hargrin, dans la Vallée des Frigères.‡阅读密文符文，然后与寒脊山谷的索姆·哈格林谈一谈。‡閱讀密文符文，然後與寒脊山谷的索姆·哈格林談壹談。',
  }
},
[3110] = {
  {
    'Runa santificada‡Благословенная руна‡Geheiligte Rune‡성스러운 룬‡Runa sagrada‡Runa sacralizada‡Rune bénie‡神圣符文‡神聖符文',
    nil,
    'Leia a Runa Santificada e fale com Branstock Khalder em Sidermar.‡Изучите благословенную руну. Найдите в Старой Наковальне Бранстока Халдера и поговорите с ним.‡Lest die geheiligte Rune und sprecht mit Branstock Khalder in Anvilmar.‡성스러운 룬을 읽어보고 앤빌마에 있는 브란스토크 칼더와 대화하십시오.‡Lee la runa sagrada, luego ve a Yunquemar y habla con Branstock Khalder.‡Lee la runa sacralizada, luego ve a Yunquemar y habla con Silo Khalder.‡Lire la Rune bénie, et parler à Branstock Khalder, à Anvilmar.‡阅读神圣符文，然后与安威玛尔的布兰斯托·卡尔德谈一谈。‡閱讀神聖符文，然後與安威瑪爾的布蘭斯托·卡爾德談壹談。',
  }
},
[3112] = {
  {
    'Memorando simples‡Записка‡Einfaches Memorandum‡간결한 쪽지‡Memorándum simple‡Memorándum simple‡Note de service simple‡简易备忘录‡簡易備忘錄',
    nil,
    'Leia o Memorando Simples e fale com Thran Khorman no Vale Cristálgida.‡Прочитайте записку и поговорите с Траном Корманом в Старой Наковальне.‡Lest das einfache Memorandum und sprecht mit Thran Khorman im Coldridgetal.‡간결한 쪽지를 읽어보고 눈마루 골짜기에 있는 스란 코르만과 대화하십시오.‡Lee el memorándum simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lee el memorándum simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lire la Note de service simple, et parler à Thran Khorman, dans la Vallée des Frigères.‡阅读简易备忘录，然后与寒脊山谷的斯兰·库尔曼谈一谈。‡閱讀簡易備忘錄，然後與寒脊山谷的斯蘭·庫爾曼談壹談。',
  }
},
[3113] = {
  {
    'Memorando cifrado‡Зашифрованная записка‡Verschlüsseltes Memorandum‡암호화된 쪽지‡Memorándum encriptado‡Memorándum encriptado‡Note de service codée‡密文备忘录‡密文備忘錄',
    nil,
    'Leia o Memorando Cifrado e fale com Solm Hargrin no Vale Cristálgida.‡Прочтите зашифрованную записку. Найдите Сольма Харгрина в Старой Наковальне и поговорите с ним.‡Lest das verschlüsselte Memorandum und sprecht mit Solm Hargrin im Coldridgetal.‡암호화된 쪽지를 읽어보고 눈마루 골짜기에 있는 솔름 하르그린과 대화하십시오.‡Lee el memorándum encriptado, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lee el memorándum encriptado, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lire la Note de service codée, et parler à Solm Hargrin, dans la Vallée des Frigères.‡阅读密文备忘录，然后与寒脊山谷的索姆·哈格林谈一谈。‡閱讀密文備忘錄，然後與寒脊山谷的索姆·哈格林談壹談。',
  }
},
[3114] = {
  {
    'Memorando Glífico‡Таинственная записка‡Glyphen-Memorandum‡상형 문자로 된 쪽지‡Memorándum con inscripciones‡Memorándum glífico‡Note de service glyphée‡雕文备忘录‡雕文備忘錄',
    nil,
    'Leia o Memorando Glífico e fale com Marryk Nurribit em Sidermar, no alto do Vale Cristálgida.‡Прочитайте таинственную записку. Найдите в Старой Наковальне Маррайка Нуррибита и поговорите с ним.‡Lest das mit Glyphen versehene Memorandum und sprecht mit Marryk Nurribit in Anvilmar oberhalb des Coldridgetals.‡상형 문자로 된 쪽지를 읽어보고 눈마루 골짜기 위 앤빌마에 있는 마릭 너리빗과 대화하십시오.‡Lee el memorándum con inscripciones, luego ve a hablar con Marryk Nurribit, dentro de Yunquemar, sobre el Valle de Crestanevada.‡Lee el memorándum glífico, luego ve a hablar con Marryk Nurribit, dentro de Yunquemar, sobre el Valle de Crestanevada.‡Lire la Note de service glyphée, et parler à Marryk Nurribit, dans Anvilmar, au-dessus de la Vallée des Frigères.‡阅读雕文备忘录，然后与寒脊山谷上的安威玛尔镇里的玛瑞克·斯托纳尔谈一谈。‡閱讀雕文備忘錄，然後與寒脊山谷上的安威瑪爾鎮裏的瑪瑞克·斯托納爾談壹談。',
  }
},
[3115] = {
  {
    'Memorando Maculado‡Гниющая записка‡Besudeltes Memorandum‡오래된 쪽지‡Memorándum corrupto‡Memorándum corrupto‡Note de service contaminée‡被污染的备忘录‡被汙染的備忘錄',
    nil,
    'Leia o Memorando Maculado e fale com Alamar Carranca em Sidermar, no alto do Vale Cristálgida.‡Прочтите гниющую записку. Найдите в Старой Наковальне Аламара Мрачнна и поговорить с ним.‡Lest das besudelte Memorandum und sprecht mit Alamar Grimm in Anvilmar oberhalb des Coldridgetals.‡오래된 쪽지를 읽고 눈마루 골짜기 위의 앤빌마에 있는 알라마 그림과 대화하십시오.‡Lee el memorándum corrupto, luego ve a hablar con Alamar Grimm que está en Yunquemar, sobre el Valle de Crestanevada.‡Lee el memorándum corrupto y habla con Alamar Grimm en Yunquemar, sobre el Valle de Crestanevada.‡Lire la Note de service contaminée, et parler à Alamar Grimm, dans Anvilmar, au-dessus de la Vallée des Frigères.‡阅读被污染的备忘录，然后寒脊山谷上的安威玛尔镇里的阿拉玛尔·格里姆谈一谈。‡閱讀被汙染的備忘錄，然後寒脊山谷上的安威瑪爾鎮裏的阿拉瑪爾·格裏姆談壹談。',
  }
},
[3116] = {
  {
    'O selo simples‡Простой знак‡Einfaches Siegelzeichen‡간결한 도장‡El sigilo simple‡El sigilo simple‡Sceau simple‡简易符记‡簡易符記',
    nil,
    'Leia o Selo Simples e fale com Alyissia em Umbravale.‡Изучите простой знак и поговорите с Алайссией в Тенистой долине.‡Lest das einfache Siegelzeichen und sprecht mit Alyissia in Shadowglen.‡간결한 도장을 읽어보고 그늘 협곡에 있는 알리시아와 대화하십시오.‡Lee el sigilo simple y habla con Alyissia en Cañada Umbría.‡Lee el sigilo simple y habla con Alyssia en Cañada Umbría.‡Lire le Sceau simple, et parler à Alyissia, à Sombrevallon.‡阅读简易符记，然后与幽影谷的奥莉希亚谈一谈。‡閱讀簡易符記，然後與幽影谷的奧莉希亞談壹談。',
  }
},
[3117] = {
  {
    'O selo cinzelado‡Выгравированный знак‡Geätztes Siegelzeichen‡글이 새겨진 도장‡El sigilo con grabados‡El sigilo con grabados‡Sceau gravé‡风化符记‡風化符記',
    nil,
    'Leia o Selo Cinzelado e fale com Ayanna Perenanda no topo de Aldrassil, em Umbravale.‡Изучите выгравированный знак и поговорите с Аянной Вечнобродкой на верхушке Альдрассила в Тенистой долине.‡Lest das geätzte Siegelzeichen und sprecht mit Ayanna Everstride oben auf Aldrassil in Shadowglen.‡글이 새겨진 도장을 읽어보고 그늘 협곡 알드랏실 꼭대기에 있는 아얀나 에버스트라이드와 대화하십시오.‡Lee el sigilo con grabados y habla con Ayanna Semprerguida en Aldrassil, en Cañada Umbría.‡Lee el sigilo con grabados y habla con Ayanna Semprerguida en la cima de Aldrassil en Cañada Umbría.‡Lire le Sceau gravé, et parler à Ayanna Everstride, au sommet d\'Aldrassil, dans Sombrevallon.‡阅读风化符记，然后与奥达希尔里和阿亚娜·远途谈一谈。‡閱讀風化符記，然後與奧達希爾裏和阿亞娜·遠途談壹談。',
  }
},
[3118] = {
  {
    'O selo cifrado‡Зашифрованный знак‡Verschlüsselte Siegelzeichen‡암호화된 도장‡El sigilo cifrado‡El sigilo cifrado‡Sceau codé‡密文符记‡密文符記',
    nil,
    'Leia o Selo Cifrado e fale com Frahun Umbrurmúrio em Umbravale.‡Прочтите зашифрованный знак и поговорите с Фрагуном Шепотом Тени в Тенистой долине.‡Lest das verschlüsselte Siegelzeichen und sprecht mit Frahun Shadwhisper in Shadowglen.‡암호화된 도장을 읽어보고 그늘 협곡에 있는 프라훈 섀이드위스퍼와 대화하십시오.‡Lee el sigilo cifrado y habla con Frahun Sombrusurro en Cañada Umbría.‡Lee el sigilo cifrado y habla con Frahun Sombrusurro en Cañada Umbría.‡Lire le Sceau codé et parler à Frahun Shadewhisper, à Sombrevallon.‡阅读密文符记，然后与幽影谷的弗拉胡恩·影语者谈一谈。‡閱讀密文符記，然後與幽影谷的弗拉胡恩·影語者談壹談。',
  }
},
[3119] = {
  {
    'O selo sagrado‡Благословенный знак‡Geheiligtes Siegelzeichen‡성스러운 도장‡El sigilo sagrado‡Sigilo sacralizado‡Sceau béni‡神圣符记‡神聖符記',
    nil,
    'Leia o Selo Sagrado e fale com Shanda em Aldrassil.‡Прочтите благословенный знак и поговорите с Шандой в Альдрассиле.‡Lest das geheiligte Siegel und sprecht mit Shanda in Aldrassil.‡성스러운 도장을 읽어보고 알드랏실에 있는 샨다와 대화하십시오.‡Lee el sigilo sagrado y habla con Shanda en Aldrassil.‡Lee el sigilo sacralizado y habla con Shanda dentro en Aldrassil.‡Lire le Sceau béni, et parler à Shanda, à Aldrassil.‡阅读神圣符记，然后与奥达希尔的珊达谈一谈。‡閱讀神聖符記，然後與奧達希爾的珊達談壹談。',
  }
},
[3120] = {
  {
    'O selo verdejante‡Зеленый знак‡Tiefgrünes Siegelzeichen‡푸른 도장‡El sigilo verdeante‡El sigilo verdeante‡Sceau verdoyant‡绿色符记‡綠色符記',
    nil,
    'Leia o Selo Verdejante e fale com Mardant Carvalhaço na ávore Aldrassil, em Umbravale.‡Прочтите зеленый знак и поговорите с Мардантом Крепким Дубом на древе Альдрассил в Тенистой долине.‡Lest das tiefgrüne Siegel und sprecht mit Mardant Strongoak im großen Baum Aldrassil in Shadowglen.‡푸른 도장을 읽어보고 그늘 협곡, 알드랏실에 있는 마르단트 스트롱오크와 대화하십시오.‡Lee el sigilo verdeante y habla con Mardant Fuerterroble, en el árbol Aldrassil de Cañada Umbría.‡Lee el sigilo verdeante y habla con Mardant Fuerterroble, en el árbol Aldrassil de Cañada Umbría.‡Lire le Sceau verdoyant, et parler à Mardant Strongoak, dans l\'arbre Aldrassil de Sombrevallon.‡阅读绿色符记，然后与幽影谷中的奥达希尔顶端的玛丹特·硬木谈一谈。‡閱讀綠色符記，然後與幽影谷中的奧達希爾頂端的瑪丹特·硬木談壹談。',
  }
},
[3121] = {
  {
    'Um pedido estranho‡Странная просьба‡Eine seltsame Anforderung‡이상한 부탁‡Una extraña petición‡Una extraña petición‡Une Requête étrange‡奇怪的要求‡奇怪的要求',
    nil,
    'Leve a Cabeça Encolhida para Neeru Cortafogo em Orgrimmar.‡Отнесите сушеную голову Нииру Огненному Клинку в Оргриммар.‡Bringt den Schrumpfkopf zu Neeru Fireblade in Orgrimmar.‡오그리마에 있는 네루 파이어블레이드에게 구겨진 가면을 가져가야 합니다.‡Lleva la cabeza reducida a Neeru Hojafuego a Orgrimmar.‡Lleva la cabeza reducida a Neeru Hojafuego en Orgrimmar.‡Porter la tête réduite à Neeru Fireblade à Orgrimmar.‡将皱缩的头颅交给奥格瑞玛的尼尔鲁·火刃。‡將皺縮的頭顱交給奧格瑞瑪的尼爾魯·火刃。',
  }
},
[3122] = {
  {
    'Fale novamente com Mandingueiro Uzer\'i.‡Возвращение к знахарю Узер\'и‡Kehrt zu Hexendoktor Uzer\'i zurück‡의술사 우제리에게 돌아가기‡Regresa junto al médico brujo Uzer\'i‡Regresa junto al médico brujo Uzer\'i‡Retourner voir le sorcier-docteur Uzer\'i‡向巫医尤克里回复‡向巫醫尤克裏回復',
    nil,
    'Entregue a Bolsa de Herborismo de Neeru para Mandingueiro Uzer\'i em Feralas.‡Отнесите знахарю Узер\'и в Фералас мешочек для трав Нииру.‡Bringt Neerus Kräuterbeutel zu Hexendoktor Uzer\'i in Feralas.‡페랄라스에 있는 의술사 우제리에게 네루의 약초 주머니를 가져가야 합니다.‡Entrega la faltriquera de hierbas de Neeru al médico brujo Uzer\'i en Feralas.‡Entrega la faltriquera de hierbas de Neeru al médico brujo Uzer\'i en Feralas.‡Livrer une Poche d\'herbes de Neeru au Sorcier docteur Uzer\'i, en Feralas.‡将尼尔鲁的草药包送给菲拉斯的巫医尤克里。‡將尼爾魯的草藥包送給菲拉斯的巫醫尤克裏。',
  }
},
[3123] = {
  {
    'O teste do recipiente‡Испытание сосуда‡Das Gefäß wird getestet‡단지 실험‡Probar la vasija‡Probar la vasija‡Test du récipient‡测试容器‡測試容器',
    nil,
    'Viaje até as Terras Agrestes e localize os Coruscantes. Mate 10 e use o Recipiente de Muisec para encolher e capturar os Coruscantes abatidos.|nLeve 10 Muisecs de Coruscante e o Recipiente de Muisec para Mandingueiro Uzer\'i em Feralas.‡Отправляйтесь во Внутренние земли, найдите диких совухов, убейте 10 особей и используйте сосуд уменьшения, чтобы уменьшить и пленить павших диких совухов.|nОтнесите 10 уменьшенных диких совухов знахарю Узер\'и в Фералас.‡Reist ins Hinterland und spürt die Wildekin auf. Schaltet 10 davon aus und benutzt dann das Muisekgefäß, um die gefallenen Wildekin zu schrumpfen und einzufangen.|nBringt anschließend 10 Einheiten Muisek von Wildekins und das Muisekgefäß zu Hexendoktor Uzer\'i in Feralas.‡동부 내륙지로 가서 올빼미야수를 찾아 10마리를 처치하고 뮤세크 단지를 사용해 죽은 올빼미야수를 갈무리해서 담아와야 합니다.|n페랄라스에 있는 의술사 우제리에게 올빼미야수 뮤세크 10개와 올빼미야수 뮤세크 단지를 가져가야 합니다.‡Viaja a las Tierras del Interior y localiza a los lechúcicos. Mata a 10 de ellos y utiliza la vasija de muisek para reducir y capturar a los lechúcicos caídos.|nLleva 10 muiseks de lechúcico y la vasija de muisek al médico brujo Uzer\'i a Feralas.‡Viaja a las Tierras del Interior y encuentra a los lechúcicos. Mata a 10 y usa la vasija de muisek para encoger y capturar a los lechúcicos caídos.|nLleva 10 muiseks de lechúcico y la vasija de muisek al médico brujo Uzer\'i en Feralas.‡Partez pour les Hinterlands et localisez les Indomptables. Tuez-en 10, puis utilisez le Récipient de muisek pour faire rétrécir et capturer les Indomptables vaincus.|nRamenez 10 Indomptables miniaturisés et le Récipient d\'Indomptables miniaturisés au sorcier-docteur Uzer\'i, en Feralas.‡到辛特兰去杀掉10头枭兽，然后使用灵魂精华容器捕获它们的灵魂。|n将灵魂精华容器和10个枭兽灵魂精华交给菲拉斯的巫医尤克里。‡到辛特蘭去殺掉10頭梟獸，然後使用靈魂精華容器捕獲它們的靈魂。|n將靈魂精華容器和10個梟獸靈魂精華交給菲拉斯的巫醫尤克裏。',
  }
},
[3124] = {
  {
    'Muisec de hipogrifo‡Уменьшенный гиппогриф‡Muisek von Hippogryphen‡히포그리프 뮤세크‡Hipogrifos muisek‡Muisek de hipogrifo‡Hippogryphe miniaturisé‡角鹰兽灵魂精华‡角鷹獸靈魂精華',
    nil,
    'Mate 10 Hipogrifos Esfiapluma de qualquer tipo e use o Recipiente de Muisec para encolhê-los e capturá-los.‡Убейте 10 блеклоперых гиппогрифов любого вида, затем используйте сосуд уменьшения, чтобы уменьшить и пленить их.‡Schaltet 10 Fransenfederhippogryphen eines beliebigen Typs aus und benutzt dann das Muisekgefäß, um sie zu schrumpfen und einzufangen.‡종에 상관없이 공작날개 히포그리프 10마리를 처치한 다음 뮤세크 단지를 사용해 갈무리해서 담아와야 합니다.‡ACaba con 10 hipogrifos Plumavieja de cualquier tipo y utiliza la vasija de muisek para encogerlos y capturarlos.‡Acaba con 10 hipogrifos Plumavieja de cualquier tipo y utiliza la vasija de muisek para encogerlos y capturarlos.‡Tuer 10 Hippogryphes Aigreplume de n\'importe quel type, puis utiliser le Vaisseau de muisek pour les faire rétrécir et les capturer.‡杀掉10只任意种类的乱羽角鹰兽，然后用灵魂精华容器捕获它们的灵魂。‡殺掉10只任意種類的亂羽角鷹獸，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3125] = {
  {
    'Muisec de Dragoleta‡Уменьшенный лесной дракончик‡Muisek von Feendrachen‡요정용 뮤세크‡Dragones feéricos muisek‡Muisek de dragón feérico‡Dragon féérique miniaturisé‡精灵龙灵魂精华‡精靈龍靈魂精華',
    nil,
    'Mate 8 Dardejantes ou Dragões-íris. Use o Recipiente de Muisec para encolher e capturar as Dragoletas abatidas.‡Убейте 8 летучих хамелеонов или радужных дракончиков. Используйте сосуд уменьшения, чтобы пленить павших лесных дракончиков.‡Schaltet 8 Grimmlingflitzer oder Grimmlingdrachen aus. Benutzt das Muisekgefäß, um die gefallenen Feendrachen zu schrumpfen und einzufangen.‡화살요정용이나 요정용 8마리를 처치하여 뮤세크 단지를 사용해 죽은 요정용을 갈무리해서 담아와야 합니다.‡Mata a 8 duendes dardo o duendes dragón. Utiliza la vasija de muisek para reducir y capturar a los dragones feéricos caídos.‡Mata a 8 duendes dardo o duendes dragón. Utiliza la vasija de muisek para reducir y capturar a los dragones feéricos caídos.‡Tuer 8 Fées fléchetteuses ou Petits dragons féeriques. Utiliser le Vaisseau de muisek pour faire rétrécir et capturer les dragons féeriques vaincus.‡杀掉8只精龙或小精龙，然后用灵魂精华容器捕获它们的灵魂。‡殺掉8只精龍或小精龍，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3126] = {
  {
    'Muisec de Arvoroso‡Уменьшенный древень‡Muisek von Treants‡나무정령 뮤세크‡Antárboles muisek‡Muisek de antárbol‡Tréant miniaturisé‡树人灵魂精华‡樹人靈魂精華',
    nil,
    'Mate 3 Andarilhos Errantes da Floresta. Use o Recipiente de Muisec para encolher e capturar os Arvorosos abatidos.‡Убейте 3 бродячих лесных древней. Используйте сосуд уменьшения, чтобы уменьшить и пленить павших древней.‡Schaltet 3 umherwandernde Waldgänger aus. Benutzt das Muisekgefäß, um die gefallenen Treants zu schrumpfen und einzufangen.‡떠도는 숲정령 3마리를 처치하여 뮤세크 단지를 사용해 죽은 숲정령을 갈무리해서 담아와야 합니다.‡Mata a 3 Caminabosques deambulantes. Utiliza la vasija de muisek para reducir y capturar a los Antárboles caídos.‡Mata a 3 caminabosques deambulantes. Utiliza la vasija de muisek de antárbol para reducir y capturar a los antárboles caídos.‡Tuer 3 Marcheurs des bois errants. Utiliser le Vaisseau de muisek pour faire rétrécir et pour capturer les tréants vaincus.‡杀掉3个森林漫游者，然后用灵魂精华容器捕获它们的灵魂。‡殺掉3個森林漫遊者，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3127] = {
  {
    'Muisec de Gigante da Montanha‡Уменьшенный горный великан‡Muisek von Bergriesen‡산악거인 뮤세크‡Gigantes de montaña muisek‡Muisek de gigante montés‡Géant des montagnes miniaturisé‡山岭巨人灵魂精华‡山嶺巨人靈魂精華',
    nil,
    'Mate 7 Terrâmbulos ou Gigantes do Penhasco. Use o Recipiente de Muisec para encolher e capturar os Gigantes da Montanha abatidos.‡Убейте 7 сухопутных бродяг или скальных великанов. Используйте сосуд уменьшения, чтобы уменьшить и пленить павших скальных великанов.‡Schaltet 7 Landgänger oder Klippenriesen aus. Benutzt das Muisekgefäß, um die gefallenen Bergriesen zu schrumpfen und einzufangen.‡평지거인이나 절벽거인 7마리를 처치하여 뮤세크 단지를 이용해 죽은 산악거인을 갈무리해서 담아와야 합니다.‡Mata a 7 caminantes de la tierra o gigantes del risco. Utiliza la vasija de muisek para reducir y capturar a los gigantes de montaña caídos.‡Mata a 7 caminantes de la tierra o gigantes del risco. Utiliza la vasija de muisek para reducir y capturar a los gigantes monteses caídos.‡Tuer 7 Marcheurs des terres ou Géants des falaises. Utiliser le Récipient de muisek pour faire rétrécir et pour capturer les Géants des montagnes.‡杀掉7个大地行者或者峭壁巨人，然后用灵魂精华容器捕获它们的灵魂。‡殺掉7個大地行者或者峭壁巨人，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3128] = {
  {
    'Caçadores de matérias-primas perdidas‡Природные материалы‡Natürliche Materialien‡천연 재료‡Materiales naturales‡Materiales naturales‡Matériaux Naturels‡天然材料‡天然材料',
    nil,
    'Leve 2 Pedaços de Lenha, 6 Minerais Incrustados, 20 pedaços de Tendão Resiliente e 40 Fragmentos Metálicos para Mandingueiro Uzer\'i na Aldeia Mojache.‡Принесите 2 расколотых бревна, 6 минералов, покрытых коркой, 20 кусков упругих сухожилий и 40 металлических фрагментов знахарю Узер\'и в Лагерь Мохаче.‡Bringt 2 abgesplitterte Baumstämme, 6 verkrustete Mineralien, 20 Stücke widerstandsfähige Sehne und 40 metallische Fragmente zu Hexendoktor Uzer\'i ins Camp Mojache.‡모자케 야영지에 있는 의술사 우제리에게 쪼개진 통나무 2개, 보석박힌 광석 6개, 질긴 힘줄 20개, 그리고 금속 파편 40개를 가져가야 합니다.‡Lleva 2 troncos astillados, 6 minerales taraceados, 20 tendones elásticos y 40 fragmentos metálicos al médico brujo Uzer\'i al Campamento Mojache.‡Lleva 2 troncos astillados, 6 minerales taraceados, 20 tendones resistentes y 40 trozos metálicos al médico brujo Uzer\'i al Campamento Mojache.‡Apporter 2 Bûches fendues, 6 Minerais incrustés, 20 Morceaux de tendons résistants et 40 Fragments métalliques au sorcier-docteur Uzer\'i au Camp Mojache.‡为莫沙彻营地的巫医尤克里收集2根断裂的原木、6颗包壳矿石、20片有弹性的肌腱和40块金属碎片。‡為莫沙徹營地的巫醫尤克裏收集2根斷裂的原木、6顆包殼礦石、20片有彈性的肌腱和40塊金屬碎片。',
  }
},
[3129] = {
  {
    'Armas de espírito‡Оружие духа‡Waffen des Geistes‡영혼의 무기‡Armas del espíritu‡Armas del espíritu‡Armes de l\'Esprit‡灵魂武器‡靈魂武器',
    nil,
    'O Mandingueiro Uzer\'i deseja que você aguarde por um instante enquanto ele prepara as armas.‡Подождите, пока знахарь Узер\'и готовит оружие.‡Hexendoktor Uzer\'i will, dass Ihr einen Moment wartet, während er die Waffen vorbereitet.‡의술사 우제리가 무기를 준비하는 동안 잠시 기다려야 합니다.‡El médico brujo Uzer\'i quiere que esperes mientras prepara las armas.‡El médico brujo Uzer\'i quiere que esperes mientras prepara las armas.‡Le sorcier-docteur Uzer\'i veut que vous patientez tandis qu\'il prépare les armes.‡巫医尤克里希望你在他准备武器的时候稍等一会儿。‡巫醫尤克裏希望妳在他準備武器的時候稍等壹會兒。',
  }
},
[3130] = {
  {
    'Cruzada contra as Cristafúrias‡Борьба с Гребнем Ненависти‡Gegen die Hasskämme‡증오의갈기일족과의 전투‡En contra de los Crestafuria‡En contra de los Crestafuria‡Contre les Hainecrête‡憎世纳迦之战‡憎世納迦之戰',
    nil,
    'Apresente-se para Latrônicus Lunalança no Domínio de Plumaluna.‡Явитесь к Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Meldet Euch bei Latronicus Moonspear in der Festung Feathermoon.‡페더문 요새에 있는 라트로니쿠스 문스피어에게 보고해야 합니다.‡Preséntate ante Latronicus Lanzaluna, en el Bastión Plumaluna.‡Preséntate ante Latronicus Lanzaluna, en el Bastión Plumaluna.‡Se présenter devant Latronicus Moonspear au bastion de Feathermoon.‡到羽月要塞的拉托尼库斯·月矛那里去报到。‡到羽月要塞的拉托尼庫斯·月矛那裏去報到。',
  }
},
[3141] = {
  {
    'Loramus‡Лорамус‡Loramus‡로라무스‡Loramus‡Loramus‡Loramus‡洛拉姆斯‡洛拉姆斯',
    nil,
    'Ouça Loramus Talípedes contar sua história.‡Послушайте, как Лорамус Многоног рассказывает свою историю.‡Lasst Loramus Thalipedes seine Geschichte erzählen.‡로라무스 탈리뻬데스의 이야기를 들으십시오.‡Escucha la historia de Loramus Thalipedes.‡Escucha la historia de Loramus Thalimedes.‡Écouter l\'histoire de Loramus Thalipedes.‡听洛拉姆斯·萨里比迪斯讲述他的故事。‡聽洛拉姆斯·薩裏比迪斯講述他的故事。',
  }
},
[3161] = {
  {
    'Gahz\'ridian‡Газ\'ридианские украшения‡Gahz\'ridian‡가즈리디안‡Gahz\'rilo‡Gahz\'rilo‡Gahz\'ridian‡加兹瑞迪安‡加茲瑞迪安',
    nil,
    'Marlon Catarrebite, em Tanaris, quer que você colete 30 Ornamentos de Gahz\'ridian.‡Марвон Клепальщик из Танариса поручил собрать 30 газ\'рилловых украшений.‡Marvon Rivetseeker in Tanaris möchte, dass Ihr 30 Gahz\'ridian-Ornamente sammelt.‡타나리스에 있는 마본 리벳시커가 가즈리디안 장신구 30개를 모아 달라고 부탁했습니다.‡Marvon Buscarroblones de Tanaris quiere que reúnas 30 adornos de gahz\'rilo.‡Marvon Buscarroblones de Tanaris quiere que reúnas 30 adornos de gahz\'rilo.‡Marvon Rivetseeker à Tanaris veut que vous collectiez 30 Ornements Gahz\'ridian.‡塔纳利斯的玛尔冯·瑞文斯克要你收集30件加兹瑞迪安饰物。‡塔納利斯的瑪爾馮·瑞文斯克要妳收集30件加茲瑞迪安飾物。',
  }
},
[3181] = {
  {
    'O chifre da fera‡Рог чудовища‡Das Horn der Bestie‡야수의 뿔‡El cuerno de la bestia‡El cuerno de la bestia‡La corne de la bête‡玛尔戈的巨角‡瑪爾戈的巨角',
    nil,
    'Leve o Chifre Gigante de Margol para a Montanhista Pedrabrita.‡Отнести гигантский рог Маргола горному пехотинцу Щебеночке.‡Bringt Margols gigantisches Horn zu Gebirgsjägerin Pebblebitty.‡산악경비대 페블비티에게 마르골의 거대한 뿔을 가져가야 합니다.‡Lleva el cuerno enorme de Margol a la montaraz Guijarro.|n‡Lleva el cuerno enorme de Margol a la montaraz Guijarro.‡Porter la Corne Gigantesque de Margol à la Montagnarde Pebblebitty.‡将玛尔戈的巨角交给巡山人贝波蒂。‡將瑪爾戈的巨角交給巡山人貝波蒂。',
  }
},
[3182] = {
  {
    'Certificado de realização‡Доказательство собственности‡Besitznachweis‡무훈의 증서‡Certificado de autenticidad‡Certificado de autenticidad‡Titre de propriété‡证明信‡證明信',
    nil,
    'Leve o Chifre Gigante de Margol para o Curador Tórius em Altaforja.‡Отнесите гигантский рог Маргола куратору Ториусу в Стальгорн.‡Bringt Margols gigantisches Horn zu Kurator Thorius in Ironforge.‡아이언포지에 있는 도서관장 소리우스에게 마르골의 거대한 뿔을 가져가야 합니다.‡Lleva el cuerno enorme de Margol al comisario Thorius a Forjaz.‡Lleva el cuerno enorme de Margol al comisario Torio a Forjaz.‡Porter la Corne gigantesque de Margol au conservateur en chef Thorius à Ironforge.‡把玛尔戈的巨角交给铁炉堡的索里奥斯馆长。‡把瑪爾戈的巨角交給鐵爐堡的索裏奧斯館長。',
  }
},
[3201] = {
  {
    'Finalmente!‡Наконец-то!‡Endlich!‡이글거리는 협곡의 열쇠‡¡Al fin!‡¡Al fin!‡Enfin !‡馆长的证明！‡館長的證明！',
    nil,
    'Leve o Certificado de Realização para a Montanhista Pedrabrita.‡Отнесите доказательство содеянного горному пехотинцу Щебеночке.‡Bringt die Urkunde für die Tat zurück zu Gebirgsjägerin Pebblebitty.‡산악경비대 페블비티에게 무훈의 증서를 가져가야 합니다.‡Lleva el certificado de autenticidad al montaraz Guijarro.‡Lleva el certificado de autenticidad a la montaraz Guijarro.‡Apporter le document de preuve à la Montagnarde Pebblebitty.‡把索里奥斯的证明信交给巡山人贝波蒂。‡把索裏奧斯的證明信交給巡山人貝波蒂。',
  }
},
[3221] = {
  {
    'Fale com Renferrel‡Беседа с Ренферрелом‡Sprecht mit Renferrel‡렌퍼럴과 대화‡Habla con Renferrel‡Habla con Renferrel‡Parler à Renferrel‡与伦弗利尔会面‡與倫弗利爾會面',
    nil,
    'Fale com o Boticário Renferrel no Sepulcro.‡Поговорите с аптекарем Ренферрелом в Гробнице.‡Sprecht mit Apotheker Renferrel in dem Grabmal.‡공동묘지에 있는 연금술사 렌퍼럴과 대화해야 합니다.‡Habla con el boticario Renferrel en El Sepulcro.‡Habla con el boticario Renferrel en El Sepulcro.‡Parler à l\'apothicaire Renferrel au Sépulcre.‡与瑟伯切尔的药剂师伦弗利尔谈一谈。‡與瑟伯切爾的藥劑師倫弗利爾談壹談。',
  }
},
[3261] = {
  {
    'Jorn Vidente do Céu‡Джорн Заклинатель Небес‡Jorn Skyseer‡조른 스카이시어‡Jorn Visioceleste‡Jorn Vidente del Cielo‡Jorn Skyseer‡乔恩·星眼‡喬恩·星眼',
    nil,
    'Fale com Jorn Vidente do Céu no Acampamento Taurajo.‡Поговорите с Джорном Заклинателем Небес в Лагере Таурахо.‡Sprecht im Camp Taurajo mit Jorn Skyseer.‡타우라조 야영지에 있는 조른 스카이시어와 대화하십시오.‡Habla con Jorn Visioceleste en el Campamento Taurajo.‡Habla con Jorn Vidente del Cielo en el Campamento Taurajo.‡Parler à Jorn Skyseer, à Camp Taurajo.‡与陶拉祖营地的乔恩·星眼谈一谈。‡與陶拉祖營地的喬恩·星眼談壹談。',
  }
},
[3281] = {
  {
    'Prata roubada‡Похищенное серебро‡Gestohlenes Silber‡도둑맞은 은화‡La plata robada‡Plata robada‡Argent volé‡被偷走的银币‡被偷走的銀幣',
    nil,
    'Leve a Prata Roubada para Gazrog na Encruzilhada.‡Принесите украденное серебро Газрогу в Перекресток.‡Bringt das gestohlene Silber zu Gazrog in Crossroads.‡크로스로드에 있는 가즈록에게 도둑맞은 은화를 가져가야 합니다.‡Llévale la plata robada a Gazrog en El Cruce.‡Llévale la plata robada a Gazrog en El Cruce.‡Rapportez l\'Argent volé à Gazrog à la Croisée.‡把被偷走的银币交给十字路口的加兹罗格。‡把被偷走的銀幣交給十字路口的加茲羅格。',
  }
},
[3301] = {
  {
    'Mura Runa Totem‡Муура Рунический Тотем‡Mura Runetotem‡무라 룬토템‡Mura Runatótem‡Mura Tótem de Runa‡Mura Runetotem‡茉拉·符文图腾‡茉拉·符文圖騰',
    nil,
    'Fale com Mura Runa Totem no Sepulcro.‡Поговорите с Муурой Руническим Тотемом в Гробнице.‡Sprecht mit Mura Runetotem in dem Grabmal.‡공동묘지에 있는 무라 룬토템과 대화하십시오.‡Habla con Mura Runatótem en El Sepulcro.‡Habla con Mura Tótem de Runa en El Sepulcro.‡Parler à Mura Runetotem au Sépulcre.‡和瑟伯切尔的茉拉·符文图腾谈一谈。‡和瑟伯切爾的茉拉·符文圖騰談壹談。',
  }
},
[3321] = {
  {
    'Perdeu alguma coisa?‡Не ее ли ищете?‡Habt Ihr das verloren?‡잃어버린 물건‡¿Has perdido esto?‡¿Has perdido esto?‡Est-ce que ceci est à vous ?‡秘银会的认可‡秘銀會的認可',
    nil,
    'Espere até que Trenton termine o trabalho.‡Дождитесь, пока Трентон закончит работу.‡Wartet, bis Trenton seine Arbeit erledigt hat.‡트렌튼이 일을 마칠 동안 기다리십시오.‡Espera a que Trenton acabe su trabajo.‡Espera a que Trenton acabe su trabajo.‡Attendre que Trenton ait terminé son travail.‡等待特伦顿完成他的工作。‡等待特倫頓完成他的工作。',
  }
},
[3341] = {
  {
    'Arauto do fim‡Да сгинет Хладовей‡Das Ende bringen‡암네나르 처치‡Acaba con la amenaza‡Acaba con la amenaza‡L\'anéantissement‡寒冰之王‡寒冰之王',
    nil,
    'André Rosado quer que você mate Amnennar, o Frigífero, e volte com a cabeça dele.‡Эндрю Браунелл поручил вам убить Амненнара Хладовея и принести его череп.‡Andrew Brownell will, dass Ihr Amnennar den Kältebringer tötet und ihm dessen Schädel bringt.‡앤드류 브로넬이 혹한의 암네나르를 처치하고 혹한의 해골을 가져다 달라고 부탁했습니다.‡Andrew Brownell quiere que mates a Amnennar el Gélido y que le lleves su calavera.‡Andrew Brownell quiere que mates a Amnennar el Gélido y que le lleves su cráneo.‡Andrew Brownell veut que vous tuiez Amnennar le Porte-froid et que vous lui rameniez son crâne.‡安德鲁·布隆奈尔要你杀了寒冰之王亚门纳尔并将其头骨带回来。‡安德魯·布隆奈爾要妳殺了寒冰之王亞門納爾並將其頭骨帶回來。',
  }
},
[3361] = {
  {
    'Um dia na vida de um refugiado‡Беда беженца‡Dilemma eines Flüchtlings‡망명자의 곤경‡Las penurias de un refugiado‡Las penurias de un refugiado‡Les malheurs d\'un réfugié‡逃难者的困境‡逃難者的困境',
    nil,
    'Leve a Caixa do Félix, o Baú do Félix e o Balde de Parafusos do Félix para Félix Reclamofuso em Sidermar.‡Принести в Старую Наковальню ларец Феликса, сундук Феликса и ведро с винтиками и вручить все это Феликсу.‡Bringt Felix Whindlebolt in Anvilmar den Kasten, die Truhe und den Bolzeneimer von Felix.‡앤빌마에 있는 펠릭스 윈들볼트에게 잃어버린 펠릭스의 상자, 펠릭스의 궤짝, 펠릭스의 나사통을 찾아줘야 합니다.‡Lleva la caja de Félix, el cofre de Félix, y el cubo de tornillos de Félix Rayaullido a Yunquemar.‡Llévale la caja de Félix, el cofre de Félix y el cubo de tornillos de Félix a Félix Rayaullido en Yunquemar.‡Apporter la Boîte de Felix, le Coffre de Felix et le Seau de boulons de Felix à Felix Whindlebolt, à Anvilmar.‡把菲利克斯的盒子、菲利克斯的箱子和菲利克斯的螺钉桶交给安威玛尔的菲利克斯。‡把菲利克斯的盒子、菲利克斯的箱子和菲利克斯的螺釘桶交給安威瑪爾的菲利克斯。',
  }
},
[3362] = {
  {
    'Vale Moitagulhas‡Долина Кактусов‡Disteltal‡덤불나무 골짜기‡El Valle Cardizal‡El Valle Cardizal‡La vallée des Chardonniers‡灌木谷‡灌木谷',
    nil,
    'Tran\'rek, em Geringontzan, quer que você mate 8 Moitagulhas Rotos e 8 Fazraízes Moitagulhas.‡Тран\'рек из Прибамбасска просит вас убить 8 бугристых шипошкуров и 8 корнеплетов из долины Кактусов.‡Tran\'rek in Gadgetzan möchte, dass Ihr 8 knorrige Distelwandler und 8 Distelwurzelformer erledigt.‡가젯잔에 있는 트란렉이 옹이진 덤불나무괴물 8마리와 억센뿌리 덤불나무괴물 8마리를 처치해달라고 부탁했습니다.‡Tran\'rek de Gadgetzan quiere que mates a 8 cardizales nudosos y a 8 enraizadores cardizales.‡Tran\'rek de Gadgetzan quiere que mates a 8 Cardizales nudosos y a 8 enraizadores Cardizales.‡Tran\'rek, à Gadgetzan, voudrait que vous tuiez 8 Chardonniers noueux et 8 Chardonniers taille-racines.‡加基森的特兰雷克要你杀掉8只长瘤的灌木兽和8只灌木塑根者。‡加基森的特蘭雷克要妳殺掉8只長瘤的灌木獸和8只灌木塑根者。',
  }
},
[3363] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    '‡‡Blah.‡‡‡‡‡‡',
  }
},
[3364] = {
  {
    'Rabo-de-galo em domicílio‡Жгучая бражка‡Lieferung des kochend heißen Morgengebräus‡뜨거운 새벽주 배달‡Entrega una infusión de albaza hirviendo‡Entrega una infusión de albaza hirviendo‡Une livraison de thé brûlant‡热酒快递‡熱酒快遞',
    nil,
    'Leve um Rabo-de-Galo Escaldante para Durnan Cortapelo em Sidermar em cinco minutos, antes que esfrie!‡Отнести жгучую бражку в Старую Наковальню и передать ее Дарнану Мехорезу. Это надо сделать за пять минут, пока бражка не остыла!‡Bringt ein kochend heißes Morgengebräu zu Durnan Furcutter ins Anvilmar hinein, bevor es innerhalb von fünf Minuten kalt wird!‡앤빌마의 두르난 퍼커터에게 뜨거운 새벽주를 전해줘야 합니다. 새벽주는 5분이 지나면 식어버리니 그전에 가져가야 합니다.‡Lleva la infusión de albaza hirviendo a Durnan Cortapieles a Yunquemar antes de que se enfríe, ¡tienes 5 minutos!‡Lleva la infusión de albaza hirviendo a Durnan Cortapieles a Yunquemar antes de que se enfríe, ¡tienes 5 minutos!‡Apporter un Thé brûlant à Durnan Furcutter, dans Anvilmar, dans les cinq minutes imparties avant qu\'il ne refroidisse !‡在5分钟内把热酒交给安威玛尔的德南·弗卡特。‡在5分鐘內把熱酒交給安威瑪爾的德南·弗卡特。',
  }
},
[3365] = {
  {
    'Devolva a caneca‡Возвращение кружки‡Den Becher zurückbringen‡빈 머그잔 가져가기‡Devuelve la taza‡Devuelve la taza‡Rapporter la Tasse‡归还酒杯‡歸還酒杯',
    nil,
    'Devolva a Caneca de Nóri para Nóri Fluiorgulho.‡Отнесите кружку хозяину – Нори по прозвищу Гордый Штрек.‡Bringt Nori Pridedrift den Becher zurück.‡노리 프라이드드리프트에게 노리의 머그잔을 가져가야 합니다.‡Devuelve la taza a Nori Rumborgullo.‡Devuélvele la taza de Nori a Nori Rumborgullo.‡Apporter la Chope de Nori à Nori Pridedrift.‡把诺里斯的杯子还给诺里斯·激流。‡把諾裏斯的杯子還給諾裏斯·激流。',
  }
},
[3367] = {
  {
    'Pedras de Suntara‡Камни Сунтары‡Suntara-Steine‡선타라 비석‡Piedras de Suntara‡Piedras de Suntara‡Les pierres de Suntara‡苏塔拉之石‡蘇塔拉之石',
    nil,
    'Ajude Dório a voltar a Altaforja.‡Помогите Дориусу вернуться в Стальгорн.‡Helft Dorius, zurück nach Ironforge zu kommen.‡도리우스가 아이언포지로 돌아가는 것을 도와야 합니다.‡Ayuda a Dorius a volver a Forjaz.‡Ayuda a Dorius a volver a Forjaz.‡Aider Dorius à retourner à Ironforge.‡帮助杜里奥斯回到铁炉堡。‡幫助杜裏奧斯回到鐵爐堡。',
  }
},
[3368] = {
  {
    'Pedras de Suntara‡Камни Сунтары‡Suntara-Steine‡선타라 비석‡Piedras de Suntara‡Piedras de Suntara‡Les pierres de Suntara‡苏塔拉之石‡蘇塔拉之石',
    nil,
    'Leve a Carta Chamuscada para Tórius em Altaforja. Ele fica no Salão dos Exploradores.‡Доставьте опаленное письмо Ториусу в Стальгорн. Его можно найти в Зале Исследователей.‡Bringt den angesengten Brief zu Thorius in Ironforge. Er befindet sich in der Halle der Forscher.‡아이언포지의 탐험가의 전당에 있는 소리우스에게 그을린 편지를 가져가야 합니다.‡Lleva la carta chamuscada a Thorius a Forjaz. Está en la Sala de los Exploradores.‡Lleva la carta chamuscada a Thorius a Forjaz. Está en la Sala de los Expedicionarios.‡Apporter la Lettre roussie à Thorius à Ironforge. Il se trouve dans le Hall des Explorateurs.‡把烧焦的信件交给铁炉堡的索里奥斯，他在探险者大厅里。‡把燒焦的信件交給鐵爐堡的索裏奧斯，他在探險者大廳裏。',
  }
},
[3369] = {
  {
    'Em pesadelos‡Кошмары‡Alptraum‡악몽‡En las pesadillas‡En las pesadillas‡Au coeur des cauchemars‡在噩梦中‡在噩夢中',
    nil,
    'Leve a Lasca de Pesadelo para Hamuul Runa Totem no Platô dos Anciãos.‡Принесите осколок кошмара Хамуулу Руническому Тотему на Вершине Старейшин.‡Bringt den Alptraum-Splitter zu Hamuul Runtetotem auf der Anhöhe der Ältesten.‡장로의 봉우리에 있는 하뮬 룬토템에게 악몽의 조각을 가져가야 합니다.‡Lleva el Fragmento de Pesadilla a Hamuul Runatótem en el Alto de los Ancestros.‡Lleva el Fragmento de Pesadilla a Hamuul Tótem de Runa en el Alto de los Ancestros.‡Apporter l\'Eclat de cauchemar à Hamuul Runetotem à la Cime des Anciens.‡把噩梦碎片交给长者高地的哈缪尔·符文图腾。‡把噩夢碎片交給長者高地的哈繆爾·符文圖騰。',
  }
},
[3370] = {
  {
    'Em pesadelos‡Кошмары‡Alptraum‡악몽‡En las pesadillas‡En las pesadillas‡Au coeur des cauchemars‡在噩梦中‡在噩夢中',
    nil,
    'Leve a Lasca de Pesadelo para Mathrengyl Ursivagus em Darnassus.‡Принесите осколок кошмара Матренгилу Медвежьей Лапе в Дарнасс.‡Bringt den Alptraum-Splitter zu Mathrengyl Bearwalker in Darnassus.‡다르나서스에 있는 마스렌길 베어워커에게 악몽의 조각을 가져가야 합니다.‡Lleva el Fragmento de Pesadilla a Mathrengyl Garroso de Darnassus.‡Lleva el Fragmento de Pesadilla a Mathrengyl Garroso de Darnassus.‡Apporter l\'Eclat de cauchemar à Mathrengyl Bearwalker à Darnassus.‡把噩梦碎片交给达纳苏斯的玛斯雷·驭熊者。‡把噩夢碎片交給達納蘇斯的瑪斯雷·馭熊者。',
  }
},
[3371] = {
  {
    'Justiça enânica‡Правосудие дворфов‡Zwergengerechtigkeit‡드워프식 정의‡La justicia de los enanos‡La justicia de los enanos‡La justice des nains‡矮人的正义‡矮人的正義',
    nil,
    'Volte para a Garganta Abrasadora e encontre a unidade de arqueologia de Dório.‡Вернитесь в Тлеющее ущелье и найдите археологов Дориуса.‡Kehrt zur sengenden Schlucht zurück und sucht Dorius\' Archäologenteam.‡이글거리는 협곡으로 돌아가서 도리우스의 발굴단 고고학자를 찾아야 합니다.‡Vuelve a La Garganta de Fuego y libera al equipo de Dorius.‡Vuelve a La Garganta de Fuego y encuentra a la unidad arqueológica de Dorius.‡Retourner à la Gorge des Vents brûlants et trouver l\'Equipe d\'archéologues de Dorius.‡回到灼热峡谷，找到杜里奥斯的考古队员。‡回到灼熱峽谷，找到杜裏奧斯的考古隊員。',
  }
},
[3372] = {
  {
    'Liberta os outros‡Отпусти их‡Erlöst sie‡해방‡Libéralos‡Libéralos‡La libération‡释放他们‡釋放他們',
    nil,
    'Encontre o Artefato Misterioso que está protegido pelos Idólatras do Martelo do Crepúsculo no quadrante noroeste da Garganta Abrasadora.‡Найдите таинственный артефакт, охраняемый идолослужителями Сумеречного Молота в северо-западной области Тлеющего ущелья.‡Sucht das mysteriöse Artefakt, das im Norden von den Twilight-Hammer bewacht wird.‡이글거리는 협곡의 북서쪽에 있는 황혼의망치단 우상숭배자들이 보호하고 있는 불가사의한 유물을 찾아야 합니다.‡Encuentra el artefacto misterioso que protegen los idólatras de Azote del Ocaso en el cuadrante noroeste de La Garganta de Fuego.‡Encuentra el artefacto misterioso que protegen los idólatras de Martillo Crepuscular en el cuadrante noroeste de La Garganta de Fuego y tráelo al altar de Suntara en la Fosa de la Escoria.‡Trouver l\'Artefact mystérieux gardé par le Marteau du crépuscule au nord.‡到北方去找到被暮光之锤守卫着的神秘的古器。‡到北方去找到被暮光之錘守衛著的神秘的古器。',
  }
},
[3373] = {
  {
    'A Essência de Erânicos‡Сущность Эраникуса‡Die Essenz des Eranikus‡에라니쿠스의 정수‡La esencia de Eranikus‡La esencia de Eranikus‡L\'Essence d\'Eranikus‡伊兰尼库斯精华‡伊蘭尼庫斯精華',
    nil,
    'Coloque a Essência de Erânicos na Fonte de Essência encontrada neste covil do Templo Submerso.‡Поместите сущность Эраникуса в купель сущности в его логове в затонувшем храме.‡Legt die Essenz von Eranikus in den Essenzborn, der sich in dem Versunkenen Tempel in seinem Unterschlupf befindet.‡가라앉은 사원의 이 안식처에 있는 정수의 샘에 에라니쿠스의 정수를 놓아야 합니다.‡Coloca la esencia de Eranikus en la fuente de esencia situada en su guarida del Templo Sumergido.‡Coloca la esencia de Eranikus en la fuente de esencia situada en su guarida del Templo Sumergido.‡Placer l\'Essence d\'Eranikus dans le Réceptacle d\'essence situé dans son antre dans le Temple englouti.‡把伊兰尼库斯精华放在精华之泉里，精华之泉就在沉没的神庙中，伊兰尼库斯的巢穴里。‡把伊蘭尼庫斯精華放在精華之泉裏，精華之泉就在沈沒的神廟中，伊蘭尼庫斯的巢穴裏。',
  }
},
[3374] = {
  {
    'A Essência de Erânicos‡Сущность Эраникуса‡Die Essenz des Eranikus‡에라니쿠스의 정수‡La esencia de Eranikus‡La esencia de Eranikus‡L\'Essence d\'Eranikus‡伊兰尼库斯精华‡伊蘭尼庫斯精華',
    nil,
    'Leve a Pedra do Juramento da Revoada de Ysera e a Essência Acorrentada de Erânicos para Itharius no Pântano das Mágoas. Lá, você decidirá se deseja ajudar a Revoada Dragônica de Ysera ou não.‡Принесите камень Клятвы драконьего выводка Изеры и скованную сущность Эраникуса на Болото Печали. Там вам придется сделать выбор: помогать Драконам Изеры или нет.‡Bringt den Schwurstein von Yseras Drachenschwarm sowie die gekettete Essenz von Eranikus zu Itharius in die Sümpfe des Elends. Dort werdet Ihr Eure Entscheidung treffen, ob Ihr Yseras Drachenschwarm helfen wollt oder nicht.‡슬픔의 늪에 있는 이타리우스에게 이세라 용군단의 서약의 돌과 속박된 에라니쿠스의 정수를 가져가야 합니다. 이세라의 용군단을 도울 것인지 돕지 않을 것인지는 그곳에서 결정하게 됩니다.‡Llévale la piedra de juramento del Vuelo de Ysera y la esencia encadenada de Eranikus a Itharius, que está en el Pantano de las Penas. Una vez allí, deberás decidir si quieres ayudar al Vuelo de Ysera o no.‡Llévale la piedra de juramento del Vuelo de Ysera y la esencia encadenada de Eranikus a Itharius, que está en el Pantano de las Penas. Una vez allí, deberás decidir si quieres ayudar al Vuelo de Ysera o no.‡Apporter la Pierre de voeu des dragons d\'Ysera et l\'Essence d\'Eranikus enchaînée à Itharius au marais des Chagrins. C\'est là que vous choisirez d\'aider ou non les dragons d\'Ysera.‡把伊瑟拉巨龙军团的誓言石和被禁锢的伊兰尼库斯精华交给悲伤沼泽的伊萨里奥斯。在那里你可以决定是否要帮助伊瑟拉的绿龙军团。‡把伊瑟拉巨龍軍團的誓言石和被禁錮的伊蘭尼庫斯精華交給悲傷沼澤的伊薩裏奧斯。在那裏妳可以決定是否要幫助伊瑟拉的綠龍軍團。',
  }
},
[3375] = {
  {
    'Frasco reserva‡Запасной фиал‡Ersatzphiole‡수정점의 유리병 다시 받기‡Otra ampolla‡Otra ampolla‡La fiole de remplacement‡占卜之瓶‡占蔔之瓶',
    nil,
    'Leve Carvão, Néctar Doce e uma Poção de Mana para Didiê Du Mocó, em Altaforja, para receber um Frasco de Vidência do Didiê.‡Принесите зелье маны, уголь и сладкий нектар Талвашу де Кисселю в Стальгорн. Получите запасной фиал виденья Талваша.‡Bringt einen Manatrank, Kohle und Süßen Nektar zu Talvash del Kissel in Ironforge, um einen Ersatz für Talvashs Wahrsagephiole zu bekommen.‡아이언포지에 있는 탈바쉬 델 키젤에게 마나 물약과 석탄, 달콤한 과즙을 가져다주고 새로운 수정점의 유리병을 얻어야 합니다.‡Lleva 1 poción de maná, 1 trozo de carbón y néctar dulce a Talvash del Kissel a Forjaz. Te dará una ampolla de adivinación.‡Lleva 1 poción de maná, 1 trozo de carbón y néctar dulce a Talvash del Kissel a Forjaz. Te dará una ampolla de adivinación.‡Apporter une Potion de mana, du Charbon, et du Nectar sucré à Talvash del Kissel à Ironforge pour remplacer la Fiole de divination de Talvash.‡把一瓶法力药水、一块煤和一瓶蜂蜜酒送到铁炉堡的塔瓦斯德·基瑟尔那里，用以换取塔瓦斯德的占卜之瓶。‡把壹瓶法力藥水、壹塊煤和壹瓶蜂蜜酒送到鐵爐堡的塔瓦斯德·基瑟爾那裏，用以換取塔瓦斯德的占蔔之瓶。',
  }
},
[3376] = {
  {
    'Quebra-presadura!‡Сразить Остроклыка!‡Tötet Spitzhauer!‡족장 뾰족어금니 처치!‡La cabeza de Cornapunta‡La cabeza de Cornapunta‡La fin de Brochaigu !‡刺鬃酋长‡刺鬃酋長',
    nil,
    'Leve a cabeça do Chefe Presadura Mantospinho para a Valente Pena ao Vento na Chapada Nuvem Vermelha.‡Принесите голову вождя Остроклыка Терновой Мантии Храбрецу Перу Ветра на плато Красного Облака.‡Bringt den Kopf von Häuptling Spitzhauer Dornenmantel zu Kriegerheld Windfeather nach Red Cloud Mesa.‡족장 뾰족어금니를 처치한 후 그 증거로 그의 머리카락을 붉은구름 고원에 있는 용사 윈드페더에게 가져가야 합니다.‡Lleva la cabeza del Jefe Cornapunta Mantospina a la Valiente Pluma de Viento en Mesa de la Nube Roja.‡Lleva la cabeza del Jefe Cornapunta Mantospina a la Valiente Pluma de Viento en Mesa de la Nube Roja.‡Apporter la Tête du chef Brochaigu Mantépine à Brave Windfeather à la mesa de Nuage rouge.‡把刺鬃酋长的头颅交给红云台地的卫兵维萨罗·风羽。‡把刺鬃酋長的頭顱交給紅雲臺地的衛兵維薩羅·風羽。',
  }
},
[3377] = {
  {
    'Oração a Eluna‡Молитва Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡Oración a Elune‡El rezo a Elune‡Prière à Elune‡艾露恩祷言‡艾露恩禱言',
    nil,
    'Ouça a história de Zamael.‡Выслушайте Зимаэля.‡Hört Zamaels Geschichte.‡잠마엘이 하는 이야기를 들으십시오.‡Escucha a Zamael.‡Escucha a Zamael.‡Écouter le récit de Zamael.‡听萨麦尔讲述他的故事。‡聽薩麥爾講述他的故事。',
  }
},
[3378] = {
  {
    'Oração a Eluna‡Молитва Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡Oración a Elune‡El rezo a Elune‡Prière à Elune‡艾露恩祷言‡艾露恩禱言',
    nil,
    'Encontre a Oração a Eluna e leve-a para Astarii Mirestela em Darnassus.‡Найдите молитву Элуне и принесите ее Астарии Ловцу Звезд в Дарнасс.‡Findet das Gebet an Elune und bringt es zu Astarii Starseeker in Darnassus.‡엘룬께 올리는 기도문을 찾아 다르나서스에 있는 아스타리 스타시커에게 가져가야 합니다.‡Lleva la oración a Elune a Astarii Buscaestelar a Darnassus.‡Lleva el rezo a Elune a Astarii Buscaestelar a Darnassus.‡Trouver la Prière à Elune et l\'apporter à Astarii Starseeker à Darnassus.‡找到艾露恩祷言，然后将其交给达纳苏斯的阿斯塔利·逐星。‡找到艾露恩禱言，然後將其交給達納蘇斯的阿斯塔利·逐星。',
  }
},
[3379] = {
  {
    'Tecessombras‡Мастер Тени‡Schattenweber‡그림자매듭‡Las tejedoras de sombra‡Las tejedoras de sombra‡Les tisseuses d\'ombre‡暗影蛛丝‡暗影蛛絲',
    nil,
    'Mate os Larápios de Seda Sombria que rondam a Garganta Abrasadora. Nilith acredita que cinco deles precisam ser exterminados. Fale com Nilith novamente na Garganta Abrasadora quando tiver cumprido essa tarefa.‡Убейте банду похитителей тенешелка, хозяйничающую в Тлеющем ущелье. Нилит полагает, что их пятеро. Вернитесь к Нилит по выполнению задания.‡Tötet die Gruppe der Schattenseidewilderer, die in der sengenden Schlucht umherstreifen. Nilith hat Grund zu der Annahme, dass es fünf von ihnen gibt, die ausgeschaltet werden müssen.‡이글거리는 협곡을 돌아다니는 그늘거미 밀렵꾼을 처치해야 합니다. 닐리스는 다섯 명 정도는 처치해야 한다고 생각하고 있습니다. 임무를 완수하면 이글거리는 협곡에 있는 닐리스에게 돌아가십시오.‡Mata a los furtivos Sedaumbría de La Garganta de Fuego. Nilith cree que son 5. Ve a ver a Nilith en La Garganta de Fuego cuando hayas terminado.|n‡Mata a los furtivos Sedaumbría de La Garganta de Fuego. Nilith cree que son 5. Ve a ver a Nilith en La Garganta de Fuego cuando hayas terminado.‡Tuer le groupe de braconniers Ombresoie qui rôde dans la gorge des Vents brûlants. Nilith a de bonnes raisons de croire qu\'ils doivent être exterminés tous les cinq. Retourner voir Nilith dans la gorge des Vents brûlants lorsque vous aurez terminé.‡杀死在灼热峡谷游荡的暗影蛛丝偷猎者小队。尼莉丝认为他们共有5名成员，你的任务就是把他们全都干掉。‡殺死在灼熱峽谷遊蕩的暗影蛛絲偷獵者小隊。尼莉絲認為他們共有5名成員，妳的任務就是把他們全都幹掉。',
  }
},
[3380] = {
  {
    'O Templo Submerso‡Затонувший храм‡Der versunkene Tempel‡가라앉은 사원‡El Templo Sumergido‡El Templo Sumergido‡Le Temple englouti‡沉没的神庙‡沈沒的神廟',
    nil,
    'Encontre Marlon Catarrebite em Tanaris.‡Найдите Марвона Клепальщика в Танарисе.‡Sucht Marvon Rivetseeker in Tanaris.‡타나리스에서 마본 리벳시커를 찾아야 합니다.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Trouver Marvon Rivetseeker à Tanaris.‡到塔纳利斯找到玛尔冯·瑞文斯克。‡到塔納利斯找到瑪爾馮·瑞文斯克。',
  }
},
[3382] = {
  {
    'Sob fogo cerrado‡На абордаж!‡Eine Mannschaft in Bedrängnis‡위험에 처한 선원‡Un equipo bajo el fuego enemigo‡Un equipo bajo el fuego enemigo‡Un équipage sous le feu ennemi‡危难中的船长‡危難中的船長',
    nil,
    'Defenda a Capitão Vanessa Beltis, sua tripulação e os passageiros do Batedor do Horizonte do ataque das nagas. A Capitão Vanessa Beltis deve sobreviver.‡Защитите капитана Ванессу Белтис, ее команду и пассажиров "Покорителя Горизонтов" от нападения наг. Капитан Ванесса Белтис должна выжить.‡Verteidigt Kapitän Vanessa Beltis, ihre Mannschaft und die Passagiere der HERRIN DES HORIZONTS gegen den Angriff der Naga. Captain Vanessa Beltis muss überleben.‡선장 바네사 벨티스와 그녀의 선원들, 그리고 지평선 정찰함의 승객들을 나가의 공격으로부터 보호해야 합니다. 적어도 선장 바네사 벨티스는 반드시 살아남아야 합니다.‡Defiende a la capitana Vanessa Beltis, su tripulación y los pasajeros del Explorador del horizonte frente al ataque de los nagas. La capitana Vanessa Beltis tiene que sobrevivir.‡Defiende a la capitana Vanessa Beltis, su tripulación y los pasajeros del Explorador del horizonte frente al ataque de los nagas. La capitana Vanessa Beltis tiene que sobrevivir.‡Défendre la capitaine Vanessa Beltis, son équipage et les passagers de “l’Horizon” contre l\'attaque des nagas. La capitaine Vanessa Beltis doit survivre.‡帮助瓦妮莎·贝蒂斯船长、她的船员和地平线轻帆号上的乘客抵御纳迦的攻击。瓦妮莎·贝蒂斯船长必须存活。‡幫助瓦妮莎·貝蒂斯船長、她的船員和地平線輕帆號上的乘客抵禦納迦的攻擊。瓦妮莎·貝蒂斯船長必須存活。',
  }
},
