[804] = {
  {
    'Sarkoth‡Саркот‡Sarkoth‡사르코스‡Sarkoth‡Sarkoth‡Sarkoth‡萨科斯‡薩科斯',
    nil,
    'Leve as notícias sobre os apuros de Hana\'zua a Gornek, no Covil.‡Расскажите Горнеку о том, что Хана\'зуа в беде.‡Informiert Gornek beim Höhlenbau über Hana\'zuas Notlage.‡동굴 막사에 있는 고르넥에게 하나주아의 현재 상황을 전해야 합니다.‡Informa de la situación de Hana\'zua a Gornek en El Cubil.‡Informa de la situación de Hana\'zua a Gornek en El Cubil.‡Informer Gornek, à l\'Antre, de la situation critique dans laquelle se trouve Hana\'zua.‡将哈纳祖目前的状况告诉大兽穴内的高内克。‡將哈納祖目前的狀況告訴大獸穴內的高內克。',
  }
},
[805] = {
  {
    'Apresente-se na Aldeia Sen\'jin‡Деревня Сен\'джин‡Bericht erstatten in Sen\'jin‡센진 마을에 보고‡Preséntate en el poblado Sen\'jin‡Preséntate en el Poblado Sen\'jin‡Faire un rapport au Village de Sen\'jin‡去森金村报到‡去森金村報到',
    nil,
    'Fale com o Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Sprecht mit Meister Gadrin in Sen\'jin.‡센진 마을에 있는 가드린 장로와 대화하십시오.‡Habla con el maestro Gadrin en Poblado Sen\'jin.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Parler à Maître Gadrin au village de Sen\'jin.‡与森金村的加德林大师谈一谈。‡與森金村的加德林大師談壹談。',
  }
},
[806] = {
  {
    'Tempestades sombrias‡Сгущаются черные тучи‡Dunkle Stürme‡다크스톰‡Oscuras tormentas‡Oscuras tormentas‡Noirs orages‡黑暗风暴‡黑暗風暴',
    nil,
    'Leve a Garra do Bulho para Orgnil Chaganalma no Monte Navalha.‡Принесите коготь Пшикса Оргнилу Душегрызу из Колючего Холма.‡Bringt Fizzles Klaue zu Orgnil Soulscar in Klingenhügel.‡칼바위 언덕에 있는 오르그닐 소울스카에게 피즐의 발톱을 가져가야 합니다.‡Lleva la zarpa de Fizzle a Orgnil Escaralma a Cerrotajo.‡Lleva la zarpa de Fizzle a Orgnil Escaralma a Cerrotajo.‡Apporter la Griffe de Fizzle à Orgnil Soulscar à Tranchecolline.‡把费索的爪子带给剃刀岭的奥戈尼尔·魂痕。‡把費索的爪子帶給剃刀嶺的奧戈尼爾·魂痕。',
  }
},
[808] = {
  {
    'O crânio de Minshina‡Череп Миншины‡Minshinas Schädel‡민시나의 해골‡La calavera de Minshina‡La calavera de Minshina‡Crâne de Minshina‡明希纳的颅骨‡明希納的顱骨',
    nil,
    'Recupere o Crânio de Minshina do círculo do poder nas Ilhas do Eco.|nLeve-o para o Mestre Gadrin na Aldeia Sen\'jin.‡Украдите череп Миншины из магического круга на островах Эха.|nПринесите его мастеру Гадрину в деревне Сен\'джин.‡Holt Minshinas Schädel aus dem Kreis der Macht auf den Echoinseln.|nBringt ihn Meister Gadrin in Sen\'jin.‡메아리 섬에 있는 힘의 마법진에서 민시나의 해골을 찾아와야 합니다.|n센진 마을에 있는 장로 가드린에게 민시나의 해골을 가져가야 합니다.‡Recupera la calavera de Minshina del círculo de poder de las Islas del Eco.|nLlévasela al maestro Gadrin al Poblado Sen\'jin.‡Recupera la calavera de Minshina del círculo de poder de las Islas del Eco.|nLlévasela al maestro Gadrin al Poblado Sen\'jin.‡Récupérer le Crâne de Minshina dans le Cercle de puissance, sur les îles de l\'Écho.|nLe rapporter à Maître Gadrin, au village de Sen\'jin.‡到回音群岛上去，将岛上法阵中的明希纳的颅骨带回来，交给森金村的加德林大师。‡到回音群島上去，將島上法陣中的明希納的顱骨帶回來，交給森金村的加德林大師。',
  }
},
[809] = {
  {
    'Ak\'Zeloth‡Ак\'Зелот‡Ak\'Zeloth‡아크젤로스‡Ak\'Zeloth‡Ak\'Zeloth‡Ak\'Zeloth‡雅克塞罗斯‡雅克塞羅斯',
    nil,
    'Fale com Ak\'Zeloth nos Sertões.‡Поговорите с Ак\'Зелотом в Степях.‡Sprecht im Brachland mit Ak\'Zeloth.‡불모의 땅에 있는 아크젤로스와 대화하십시오.‡Habla con Ak\'Zeloth en Los Baldíos.‡Habla con Ak\'Zeloth en Los Baldíos.‡Parler à Ak\'Zeloth, dans les Tarides.‡到贫瘠之地去和雅克塞罗斯谈一谈。‡到貧瘠之地去和雅克塞羅斯談壹談。',
  }
},
[812] = {
  {
    'Busca da cura‡Нужда в исцелении‡Heilmittel benötigt‡해독약 구하기‡Se necesita un remedio‡Se necesita un remedio‡Besoin d\'un remède‡救命如救火‡救命如救火',
    nil,
    'Encontre Kor\'ghan em Orgrimmar e pegue o Antídoto para Caudaçonha. Então leve o antídoto para Rhinag perto da fronteira noroeste de Durotar.‡Найдите в Оргриммаре Кор\'гхана и добудьте сыворотку от яда ядохвоста. Принесите сыворотку Ринагу на северо-западной границе Даротара.‡Sucht Kor\'ghan in Orgrimmar und besorgt das Siechstachelgegengift. Bringt das Gegengift dann zu Rhinag an der nordwestlichen Grenze von Durotar.‡오그리마에서 코간을 찾아서 해독약을 받은 다음, 불모의 땅과 인접한 듀로타 변두리에 있는 리나그에게 맹독전갈 해독약을 가져가야 합니다.‡Encuentra a Kor\'ghan en Orgrimmar y consigue el antídoto para venocola. Luego lleva el antídoto a Rhinag. Está cerca del límite noroeste de Durotar.‡Encuentra a Kor\'ghan en Orgrimmar y consigue el antídoto para venocola. Luego lleva el antídoto a Rhinag. Está cerca del límite noroeste de Durotar.‡Trouver Kor\'ghan à Orgrimmar et obtenir l\'Antidote du Queue-venin. L\'apporter ensuite à Rhinag près de la frontière nord-ouest de Durotar.‡找到毒尾蝎的解毒剂，把它交给杜隆塔尔西北边境的林纳格。‡找到毒尾蠍的解毒劑，把它交給杜隆塔爾西北邊境的林納格。',
  }
},
[813] = {
  {
    'Em busca do antídoto‡Поиски противоядия‡Suche nach dem Gegengift‡해독약 구하기‡En busca del antídoto‡En busca del antídoto‡La recherche de l\'antidote‡寻找解毒剂‡尋找解毒劑',
    nil,
    'Leve 4 Vesículas de Veneno de Caudaçonha para Kor\'ghan em Orgrimmar.‡Принесите 4 ядовитых железы ядохвоста Кор\'гхану в Оргриммаре.‡Bringt Kor\'ghan in Orgrimmar 4 Giftbeutel eines Siechstachelskorpiden.‡오그리마에 있는 코간에게 맹독전갈 독주머니 4개를 가져가야 합니다.‡Lleva 4 glándulas de veneno de venocola a Kor\'ghan a Orgrimmar.‡Lleva 4 glándulas de veneno de venocola a Kor\'ghan a Orgrimmar.‡Apporter 4 Glandes à venin de Queue-venin à Kor\'ghan à Orgrimmar.‡收集4个毒尾蝎的毒囊，把它们交给奥格瑞玛的考格汉。‡收集4個毒尾蠍的毒囊，把它們交給奧格瑞瑪的考格漢。',
  }
},
[815] = {
  {
    'Quebrar alguns ovos‡Хорошенький омлет‡Zerbrecht ein paar Eier‡알 요리‡Romper huevos‡Romper huevos‡Des oeufs pour l\'omelette‡恐龙蛋大餐‡恐龍蛋大餐',
    nil,
    'Leve 3 Ovos de Açoitacauda para o Cozinheiro Torka no Monte Navalha.‡Принесите 3 яйца кнутохвостов повару Торке в Колючий Холм.‡Bringt dem Koch Torka in Klingenhügel 3 Schwanzpeitscher-Eier.‡칼바위 언덕에 있는 요리사 토르카에게 붉은발톱랩터 알 3개를 가져가야 합니다.‡Lleva 3 huevos de colazote al cocinero Torka de Cerrotajo.‡Lleva 3 huevos de colazote al cocinero Torka de Cerrotajo.‡Rapporter 3 Oeufs de fouette-queue au cuisinier Torka, à Tranchecolline.‡收集3个鞭尾龙的蛋，并把它们带给剃刀岭的厨师托尔卡。‡收集3個鞭尾龍的蛋，並把它們帶給剃刀嶺的廚師托爾卡。',
  }
},
[816] = {
  {
    'Em memória‡Пропавший, но не забытый‡Verloren, aber nicht vergessen‡크론의 흔적‡Perdido, pero no olvidado‡Perdido, pero no olvidado‡L\'égaré‡丢失的孩子‡丟失的孩子',
    nil,
    'Leve uma prova do destino de Kron para Misha Tor\'kren na fazenda a noroeste do Monte Navalha.‡Принесите известие о судьбе, постигшей Крона, Майше Тор\'крен в усадьбу к северо-западу от Колючего Холма.‡Bringt Misha Tor\'kren auf dem Bauernhof nordwestlich von Klingenhügel einen Hinweis auf Krons Schicksal.‡칼바위 언덕의 북서쪽 농장에 있는 미샤 토크렌에게 크론의 흔적을 가져가야 합니다.‡Lleva un indicio del destino de Kron a Misha Tor\'kren, a la granja que hay al noroeste de Cerrotajo.‡Lleva un indicio del destino de Kron a Misha Tor\'kren, a la granja que hay al noroeste de Cerrotajo.‡Trouver un indice du sort de Kron et en informer Misha Tor\'kren, à la ferme, au nord-ouest de Tranchecolline.‡把关于克鲁恩的消息告诉剃刀岭西北部农场中的米莎·托克伦。‡把關於克魯恩的消息告訴剃刀嶺西北部農場中的米莎·托克倫。',
  }
},
[817] = {
  {
    'Presa prática‡Полезная добыча‡Praktische Beute‡유용한 사냥감‡Presa práctica‡Presa práctica‡Proie nécessaire‡生活所需的虎皮‡生活所需的虎皮',
    nil,
    'Leve 4 Peles de Tigre de Durotar para Vel\'rin Presa na Aldeia Sen\'jin.‡Принесите 4 шкуры дуротарских тигров Вель\'рину Клыку в деревне Сен\'джин.‡Bringt Vel\'rin Fang in Sen\'jin 4 Durotar-Tigerfelle.‡센진 마을에 있는 벨린 팡에게 듀로타 호랑이 가죽 4필을 가져가야 합니다.‡Lleva 4 pieles de tigres de Durotar a Colmillo Vel\'rin al Poblado Sen\'jin.‡Lleva 4 pelajes de tigres de Durotar a Vel\'rin Colmillo al Poblado Sen\'jin.‡Apporter 4 Peaux de tigres de Durotar à Vel\'rin Fang, au village de Sen\'jin.‡收集四张杜隆塔尔虎皮，并把它们交给森金村的维尔林·长牙。‡收集四張杜隆塔爾虎皮，並把它們交給森金村的維爾林·長牙。',
  }
},
[818] = {
  {
    'Um espírito solvente‡Растворитель‡Ein geistvolles Getränk‡나약한 정신‡Un espíritu responsable‡Un espíritu responsable‡Un esprit parfaitement éduqué‡沃纳尔大师‡沃納爾大師',
    nil,
    'Leve 4 Olhos de Makrura Intactos e 8 ampolas de Muco de Rastejante para Mestre Vornal na Aldeia Sen\'jin.‡Принесите 4 невредимых глаза макрур и 8 фиалов со слизью крабов мастеру Ворналу в деревне Сен\'джин.‡Bringt Meister Vornal in Sen\'jin 4 intakte Makruraaugen und 8 Phiolen Kriechersekret.‡센진 마을에 있는 장로 보르날에게 온전한 마크루라의 눈 4개와 붉은톱니게 점액 8병을 가져가야 합니다.‡Lleva 4 ojos de makrura intactos y 8 viales de moco de reptador al maestro Vornal al Poblado Sen\'jin.‡Lleva 4 ojos de makrura intactos y 8 viales de moco de reptador al maestro Vornal al Poblado Sen\'jin.‡Apporter 4 Yeux de makrura intacts et 8 Fioles de mucus de clampant à maître Vornal, au village de Sen\'jin.‡把4个龙虾人的眼睛和8小瓶蟹胶带到森金村，交给沃纳尔大师。‡把4個龍蝦人的眼睛和8小瓶蟹膠帶到森金村，交給沃納爾大師。',
  }
},
[819] = {
  {
    'Barril Vazio do Chen‡Пустой бочонок Чэня‡Chens leeres Fässchen‡첸의 빈 술통‡El barril vacío de Chen‡El barril vacío de Chen‡Tonneau vide de Chen‡老陈的空酒桶‡老陳的空酒桶',
    nil,
    'Encontre alguém que saiba sobre o Barril Vazio do Chen.‡Отыщите кого-нибудь, кто знает о пустом бочонке Чэня.‡Sucht jemanden, der etwas über Chens leeres Fässchen weiß.‡첸의 빈 술통에 대해 아는 이를 찾아야 합니다.‡Encuentra a alguien que sepa algo sobre el barril vacío de Chen.‡Encuentra a alguien que sepa algo sobre el barril vacío de Chen.‡Trouver quelqu\'un qui en sache davantage au sujet du Tonneau vide de Chen.‡找到对老陈的空酒桶有所了解的人。‡找到對老陳的空酒桶有所了解的人。',
  }
},
[821] = {
  {
    'Barril Vazio do Chen‡Пустой бочонок Чэня‡Chens leeres Fässchen‡첸의 빈 술통‡El barril vacío de Chen‡El barril vacío de Chen‡Tonneau vide de Chen‡老陈的空酒桶‡老陳的空酒桶',
    nil,
    'Leve 5 Presas de Leão da Savana, 5 Rins de Pinote e 1 Chifre de Lagarto Trovejante para o Cervejeiro Drohn, em Vila Catraca.‡Принесите 5 клыков равнинного льва, 5 почек долгонога и 1 рог рокочущей ящерицы пивовару Дрону в Кабестан.‡Bringt Braumeister Drohn in Ratchet 5 Savannenlöwenhauer, 5 Ebenenschreiternieren und 1 Donnerechsenhorn.‡톱니항에 있는 양조업자 드론에게 사바나 사자 어금니 5개, 초원타조 신장 5개와 천둥도마뱀의 뿔 1개를 가져가야 합니다.‡Llévale 5 colmillos de león de la sabana, 5 riñones de zancudo de llanura y 1 cuerno de truenagarto a Cebador Drohn en Trinquete.‡Llévale 5 colmillos de león de la sabana, 5 riñones de zancudo de llanura y 1 cuerno de truenagarto al maestro cervecero Drohn en Trinquete.‡Apporter 5 Canines de lion des savanes, 5 Rognons de trotteur des plaines, et 1 Corne de lézard-tonnerre au brasseur Drohn à Ratchet.‡收集5颗草原狮的獠牙、5个平原陆行鸟的肾脏和1根雷霆蜥蜴的角，把它们交给棘齿城的酿酒师德罗恩。‡收集5顆草原獅的獠牙、5個平原陸行鳥的腎臟和1根雷霆蜥蜴的角，把它們交給棘齒城的釀酒師德羅恩。',
  }
},
[822] = {
  {
    'Barril Vazio do Chen‡Пустой бочонок Чэня‡Chens leeres Fässchen‡첸의 빈 술통‡El barril vacío de Chen‡El barril vacío de Chen‡Tonneau vide de Chen‡老陈的空酒桶‡老陳的空酒桶',
    nil,
    'Leve 5 Glândulas Relampejantes, 1 Glândula Salivar de Falcotrom e 1 Fígado de Kodo para o Cervejeiro Drohn, em Vila Catraca.‡Принесите 5 грозовых желез, 1 слюнную железу грозового змея и 1 печень кодо пивовару Дрону в Кабестан.‡Bringt Braumeister Drohn in Ratchet 5 Blitzschlagdrüsen, 1 Donnerfalkenspeicheldrüse und 1 Kodoleber.‡톱니항에 있는 양조업자 드론에게 번개 분출선 5개, 천둥매 타액 분비선 1개, 코도 간 1개를 가져가야 합니다.‡Llévale 5 glándulas relampagueantes, 1 glándula de saliva de halcón trueno y 1 hígado de kodo a Cebador Drohn en Trinquete.‡Llévale 5 glándulas relampagueantes, 1 glándula salivaria de halcón trueno y 1 hígado de kodo al maestro cervecero Drohn en Trinquete.‡Apporter 5 Glandes de corne-éclair, 1 Glande salivaire de faucon-tonnerre et 1 Foie de kodo au brasseur Drohn à Ratchet.‡收集5个闪电腺、1个雷鹰的唾液腺和1个科多兽的肝脏，把它们交给棘齿城里的酿酒师德罗恩。‡收集5個閃電腺、1個雷鷹的唾液腺和1個科多獸的肝臟，把它們交給棘齒城裏的釀酒師德羅恩。',
  }
},
[823] = {
  {
    'Apresente-se a Orgnil‡Явиться к Оргнилу‡Bericht an Orgnil‡오르그닐에게 보고‡Informa a Orgnil‡Informa a Orgnil‡Un rapport à Orgnil‡向奥戈尼尔报告‡向奧戈尼爾報告',
    nil,
    'Fale com Orgnil Chaganalma no Monte Navalha.‡Поговорите с Оргнилом Душегрызом на Колючем Холме.‡Sprecht mit Orgnil Soulscar in Klingenhügel.‡칼바위 언덕에 있는 오르그닐 소울스카와 대화하십시오.‡Habla con Orgnil Escaralma de Cerrotajo.‡Habla con Orgnil Escaralma de Cerrotajo.‡Parler à Orgnil Soulscar à Tranchecolline.‡和剃刀岭的奥戈尼尔·魂痕谈一谈。‡和剃刀嶺的奧戈尼爾·魂痕談壹談。',
  }
},
[824] = {
  {
    'Je\'neu da Harmonia Telúrica‡Дже\'неу из Служителей Земли‡Je\'neu vom Irdenen Ring‡속세의 고리회 제네우‡Je\'neu del Anillo de la Tierra‡Je\'neu del Anillo de la Tierra‡Je\'neu du Cercle terrestre‡陶土议会的耶努萨克雷‡陶土議會的耶努薩克雷',
    nil,
    'Leve o Globo d\'Água Conspurcado para Je\'neu Sancrea no Assentamento Zoram\'gar, no Vale Gris.‡Отнесите оскверненную водяную сферу Дже\'неу Санкри в форт Зорам\'гар в Ясеневом лесу.‡Bringt die beschmutzte Wasserkugel zu Je\'neu Sancrea im Zoram\'gar-Außenposten in Ashenvale.‡잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 더럽혀진 물구슬을 가져가야 합니다.‡Llévale el globo de agua podrida a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el globo de agua contaminada a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apporter le Globe d\'eau souillée à Je\'neu Sancrea, à l’Avant-poste de Zoram\'gar, dans Ashenvale.‡将被污染的水球交给灰谷佐拉姆加前哨站的耶努萨克雷。‡將被汙染的水球交給灰谷佐拉姆加前哨站的耶努薩克雷。',
  }
},
[825] = {
  {
    'Dos destroços...‡Обломки кораблекрушения‡Aus den Wrackteilen geborgen...‡난파선‡Los restos del naufragio…‡Los restos del naufragio...‡Des épaves‡海底沉船‡海底沈船',
    nil,
    'Gar\'Thok, do Monte Navalha, quer que você recupere 3 Ferramentas Gnômicas dos destroços junto à costa.‡Га\'Ток с Колючего Холма просит вас принести ему 3 комплекта инструментов гномов, найти которые можно в обломках кораблей у побережья.‡Gar\'Thok von Klingenhügel möchte, dass Ihr 3 Gnomen-Werkzeuge aus den Wrackteilen vor der Küste holt.‡칼바위 언덕의 가르톡이 해안에 있는 난파선에서 노움 공구 3개를 찾아 달라고 지시했습니다.‡Gar\'Thok de Cerrotajo quiere que recuperes 3 herramientas gnómicas de los restos de naufragio de la costa.‡Gar\'Thok de Cerrotajo quiere que recuperes 3 herramientas gnómicas de los restos de naufragio de la costa.‡Gar\'Thok de Tranchecolline veut que vous retrouviez 3 Outils gnomes parmi les épaves près de la côte.‡剃刀岭的加索克要你从海岸边的舰队残骸中打捞出3件侏儒的工具。‡剃刀嶺的加索克要妳從海岸邊的艦隊殘骸中打撈出3件侏儒的工具。',
  }
},
[826] = {
  {
    'Zalazane‡Залазан‡Zalazane‡잘라제인‡Zalazane‡Zalazane‡Zalazane‡扎拉赞恩‡紮拉贊恩',
    nil,
    'Derrote Zalazane.|nMate 8 Trolls Vodu e 8 Trolls Bagateados.|nLeve a Cabeça do Zalazane para Gadrin.‡Убейте Залазана, убейте 8 троллей-вудуистов и 8 проклятых троллей.|nПринесите голову Залазана Гадрину.‡Besiegt Zalazane.|nTötet 8 Voodootrolle und 8 verhexte Trolle.|nBringt Gadrin Zalazanes Kopf.‡잘라제인을 처치해야 합니다.|n부두교 트롤 8명과 주술에 걸린 트롤 8명을 처치해야 합니다.|n가드린에게 잘라제인의 머리카락을 가져가야 합니다.‡Derrota a Zalazane.|nMata a 8 trols de vudú y 8 trols maléficos.|nLleva la cabeza de Zalazane a Gadrin.‡Derrota a Zalazane.|nMata a 8 trols vudú y 8 trols maléficos.|nLleva la cabeza de Zalazane a Gadrin.‡Battre Zalazane.|nTuer 8 Trolls vaudou et 8 Trolls maléficiés.|nApporter la Tête de Zalazane à Gadrin.‡打败扎拉赞恩。|n杀死8个巫毒巨魔和8个妖术巨魔。|n把扎拉赞恩的头颅带给加德林大师。‡打敗紮拉贊恩。|n殺死8個巫毒巨魔和8個妖術巨魔。|n把紮拉贊恩的頭顱帶給加德林大師。',
  }
},
[827] = {
  {
    'A Rocha da Caveira‡Скала Черепа‡Die Knochenhöhle‡해골 바위굴‡Roca del Cráneo‡Roca del Cráneo‡Rocher du crâne‡骷髅石‡骷髏石',
    nil,
    'Junte Colares Calcinantes dos sectários na Rocha da Caveira.|nLeve-os para Margoz no acampamento dele.‡Отберите у фанатиков из Скалы Черепа обжигающие ошейники.|nПринесите их в лагерь Маргозу.‡Besorgt von den Kultisten an der Knochenhöhle ein paar Senghalsbänder.|nBringt sie Margoz in seinem Lager.‡해골 바위굴에 있는 숭배자들을 처치하고 이글거리는 목걸이를 모아야 합니다.|n야영지에 있는 마르고즈에게 수집한 목걸이를 가져가야 합니다.‡Recoge los collares ardientes de los fieles de Roca del Cráneo.|nLlévaselos a Margoz a su campamento.‡Recoge los collares abrasadores de los cultores de Roca del Cráneo.|nLlévaselos a Margoz a su campamento.‡Prendre les Colliers brûlants des sectateurs au Rocher du crâne.|nLes apporter à Margoz à son camp.‡在骷髅石中的火刃祭司身上收集灼热项圈，|n然后交给玛高兹。‡在骷髏石中的火刃祭司身上收集灼熱項圈，|n然後交給瑪高茲。',
  }
},
[828] = {
  {
    'Margoz‡Маргоз‡Margoz‡마르고즈‡Margoz‡Margoz‡Margoz‡玛高兹‡瑪高茲',
    nil,
    'Fale com Margoz.‡Поговорите с Маргозом.‡Sprecht mit Margoz.‡마르고즈와 대화하십시오.‡Habla con Margoz.‡Habla con Margoz.‡Parler à Margoz.‡和玛高兹谈一谈。‡和瑪高茲談壹談。',
  }
},
[829] = {
  {
    'Neeru Cortafogo‡Нииру Огненный Клинок‡Neeru Fireblade‡네루 파이어블레이드‡Neeru Hojafuego‡Neeru Hojafuego‡Neeru Fireblade‡尼尔鲁·火刃‡尼爾魯·火刃',
    nil,
    'Leve um Colar de Amostra para Neeru Cortafogo em Orgrimmar.‡Отнесите один обжигающий ошейник Нииру Огненному Клинку в Оргриммаре.‡Bringt Neeru Fireblade in Orgrimmar ein Senghalsband-Muster.‡오그리마에 있는 네루 파이어블레이드에게 목걸이 견본을 가져가야 합니다.‡Lleva un collar de muestra a Neeru Hojafuego a Orgrimmar.‡Lleva un collar de muestra a Neeru Hojafuego a Orgrimmar.‡Apporter un Spécimen de collier à Neeru Fireblade à Orgrimmar.‡给奥格瑞玛的尼尔鲁·火刃带去一个项圈样本。‡給奧格瑞瑪的尼爾魯·火刃帶去壹個項圈樣本。',
  }
},
[830] = {
  {
    'As ordens do almirante‡Приказы адмирала‡Die Befehle des Admirals‡함장의 명령서‡Las órdenes del almirante‡Las órdenes del almirante‡Les ordres de l\'amiral‡将军的命令‡將軍的命令',
    nil,
    'Leve as Ordens do Almirante Proudmore para Gar\'Thok no Monte Navalha.‡Отнесите приказы адмирала Праудмура Га\'току на Колючий Холм.‡Bringt Gar\'Thok in Klingenhügel Admiral Proudmoores Befehle.‡칼바위 언덕에 있는 가르톡에게 함장 프라우드무어의 명령서를 가져가야 합니다.‡Lleva las órdenes del almirante Valiente a Gar\'Thok a Cerrotajo.‡Lleva las órdenes del almirante Valiente a Gar\'Thok a Cerrotajo.‡Apporter les Ordres de l\'amiral Proudmoore à Gar\'Thok de Tranchecolline.‡把普罗德摩尔将军的命令带给剃刀岭的加索克。‡把普羅德摩爾將軍的命令帶給剃刀嶺的加索克。',
  }
},
[831] = {
  {
    'As ordens do almirante‡Приказы адмирала‡Die Befehle des Admirals‡함장의 명령서‡Las órdenes del almirante‡Las órdenes del almirante‡Les ordres de l\'amiral‡将军的命令‡將軍的命令',
    nil,
    'Entregue as Ordens do Almirante Proudmore a Nazgrel nos aposentos de Thrall, em Orgrimmar.‡Доставьте приказы адмирала Праудмура Назгрелу в зал приемов Тралла в Оргриммаре.‡Bringt Nazgrel in Thralls Kammer in Orgrimmar Admiral Proudmoores Befehle.‡오그리마에 있는 스랄의 요새로 가서 함장 프라우드무어의 명령서를 나즈그렐에게 전달해야 합니다.‡Entrega las órdenes del almirante Valiente a Nazgrel, que está en la Cámara de Thrall en Orgrimmar.‡Entrégale las órdenes del almirante Valiente a Nazgrel en la Cámara de Thrall en Orgrimmar.‡Porter les Ordres de l\'amiral Proudmoore à Nazgrel, dans les appartements de Thrall à Orgrimmar.‡把普罗德摩尔将军的命令交给奥格瑞玛城中的纳兹格雷尔，他就在萨尔的大厅里。‡把普羅德摩爾將軍的命令交給奧格瑞瑪城中的納茲格雷爾，他就在薩爾的大廳裏。',
  }
},
[832] = {
  {
    'Sombras incandescentes‡Пылающие тени‡Brennende Schatten‡이글거리는 그림자‡Sombras Ardientes‡Sombras Ardientes‡Ombres ardentes‡燃影之眼‡燃影之眼',
    nil,
    'Leve esse olho para Neeru Cortafogo.‡Отнесите этот амулет Нииру Огненному Клинку.‡Bringt Neeru Fireblade dieses Auge.‡이 눈을 네루 파이어블레이드에게 가져가야 합니다.‡Lleva este ojo a Neeru Hojafuego.‡Lleva este ojo a Neeru Hojafuego.‡Apporter cet Oeil à Neeru Fireblade.‡把这颗燃影之眼带给尼尔鲁·火刃。‡把這顆燃影之眼帶給尼爾魯·火刃。',
  }
},
[833] = {
  {
    'Sepultamento sagrado‡Священное погребение‡Eine heilige Bestattung‡신성한 묘지‡Cementerio sagrado‡Cementerio sagrado‡Cimetière sacré‡神圣的墓地‡神聖的墓地',
    nil,
    'O Erudito Totem da Chuva quer que você mate 8 Traiçoeiros Costagulha no Rochedo Vermelho.‡Сказитель Тотем Дождя попросил вас убить 8 злоумышленников из племени Дыбогривов в Красных cкалах.‡Der Hüter des Wissens Raintotem möchte, dass Ihr bei den Teufelsfelsen 8 Eindringlinge der Borstennacken tötet.‡현자 레인토템이 붉은 바위 언덕에 있는 뾰족털일족 약탈자 8명을 처치해 달라고 부탁했습니다.‡El guardián del Conocimiento Totemlluvia quiere que mates a 8 intrusos Erizapúas en Roca Roja.‡El tradicionalista Tótem de Lluvia quiere que mates 8 intrusos erizapúas en Roca Roja.‡Le Gardien du savoir Raintotem veut que vous tuiez 8 Intrus Dos-hirsute aux Rochers rouges.‡博学者诺拉·暴雨图腾要你在赤色石杀掉8个刺背干涉者。‡博學者諾拉·暴雨圖騰要妳在赤色石殺掉8個刺背幹涉者。',
  }
},
[834] = {
  {
    'Ventos do deserto‡Ветра пустыни‡Wind in der Wüste‡사막의 바람‡Las arpías Viento Seco‡Las arpías Viento Seco‡Des vents dans le désert‡沙漠之风‡沙漠之風',
    nil,
    'Recupere 5 Sacos de Suprimentos e entregue-os a Rezlak perto de Orgrimmar.‡Добудьте 5 мешков припасов и верните их Резлаку близ Оргриммара.‡Holt 5 Säcke Vorräte und bringt sie Rezlak in der Nähe von Orgrimmar.‡보급품 부대 5개를 찾은 다음 오그리마 근처에 있는 레즐락에게 돌아가십시오.‡Recupera 5 sacos de suministros y llévaselos a Rezlak que está cerca de Orgrimmar.‡Consigue 5 sacos de suministros y regresa con Rezlak cerca de Orgrimmar.‡Retrouver 5 Sacs de marchandises et les rendre à Rezlak près d\'Orgrimmar.‡为奥格瑞玛城外的雷兹拉克取回5个装满货物的袋子。‡為奧格瑞瑪城外的雷茲拉克取回5個裝滿貨物的袋子。',
  }
},
[835] = {
  {
    'Faça o que eu digo...‡Обеспечение безопасного сообщения‡Sicherung der Linien‡보급로 확보‡Asegurar las rutas‡Asegurar las rutas‡Des lignes sécurisées‡保卫商路‡保衛商路',
    nil,
    'Mate 12 Selvagens Sopravento e 8 Bruxas da Tempestade Sopravento para Rezlak perto do Barranco da Ravina Seca.‡Убейте 12 дикарок из стаи Пыльного Ветра и 8 грозовых ведьм из стаи Пыльного Ветра, обитающих возле Сухой лощины, по просьбе Резлака.‡Tötet für Rezlak in der Nähe der Staubwindklamm 12 Wilde der Staubschwingen und 8 Sturmhexen der Staubschwingen.‡레즐락을 위해 모래바람 협곡 근처에 있는 먼지바람일족 여전사 12명과 먼지바람일족 폭풍마녀 8명을 처치해야 합니다.‡Mata a 12 salvajes Viento Seco y 8 brujas de la tormenta Viento Seco para Rezlak, que está cerca del Barranco Árido.‡Mata a 12 Salvajes Viento Seco y 8 Brujas de la Tormenta Viento Seco para Rezlak, cerca de Barranco Árido‡Tuer 12 Terrevent farouches et 8 Sorcières des tempêtes Terrevent pour Rezlak près du Ravin asséché.‡为奥格瑞玛附近的雷兹拉克杀掉12个尘风暴徒和8个尘风雷巫。‡為奧格瑞瑪附近的雷茲拉克殺掉12個塵風暴徒和8個塵風雷巫。',
  }
},
[836] = {
  {
    'Resgate OOX-09/HL!‡Спасти КПХ-9/HL!‡Rettet OOX-09/HL!‡OOX-09/HL 구출 작전‡¡Rescata a OOX-09/HL!‡¡Rescata a OOX-09/TI!‡À la rescousse de OOX-09/HL !‡拯救OOX-09/HL！‡拯救OOX-09/HL！',
    nil,
    'Escolte o OOX-09/HL até a costa além dos Penhascos Panorâmicos, então se apresente a Olhatorto Obnótico, na Angra do Butim.‡Сопроводите OOX-09/HL на побережье за Обзорными скалами, а потом доложитесь Карлсу Пропеллерзу в Пиратской бухте.‡Eskortiert OOX-09/HL zur Küste jenseits der Aussichtsklippen und meldet Euch dann bei Oglethorpe Obnoticus in Booty Bay.‡전망대 절벽 너머 해안까지 OOX-09/HL을 호위해 간 후 무법항에 있는 오글소프 오브노티쿠스에게 보고해야 합니다.‡Acompaña a OOX-09/HL a la orilla que hay pasados los Acantilados Dominantes e informa a Oglethorpe Obnoticus en Bahía del Botín.‡Escolta a OOX-09/TI a la costa pasando los Acantilados Dominantes, y preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escorter OOX-09/HL jusqu\'au littoral au-delà des Haut-Surplombs, puis rendre compte à Oglethorpe Obnoticus à Baie-du-Butin.‡将OOX-09/HL护送到被遗忘的海岸上的码头，然后向藏宝海湾的奥格索普·奥布诺提斯报告。‡將OOX-09/HL護送到被遺忘的海岸上的碼頭，然後向藏寶海灣的奧格索普·奧布諾提斯報告。',
  }
},
[837] = {
  {
    'Invasão‡Вторжение‡Übergriff‡영토 침범‡Invasión‡Invasión‡Empiètement‡野猪人的进犯‡野豬人的進犯',
    nil,
    'Mate 4 Javatuscos Crinavalha, 4 Batedores Crinavalha, 4 Levanta-poeira Crinavalha e 4 Guardas de Batalha Crinavalha para Gar\'Thok no Monte Navalha.‡Убейте 4 свинобразов из племени Иглогривых, 4 разведчиков из племени Иглогривых, 4 пылебегов из племени Иглогривых и 4 боевых стражей из племени Иглогривых по просьбе Га\'Тока из Колючего Холма.‡Tötet für Gar\'Thok in Klingenhügel 4 Stacheleber der Grimmhauer, 4 Späher der Grimmhauer, 4 Staubläufer der Grimmhauer und 4 Schlachtwachen der Grimmhauer.‡칼바위 언덕의 가르톡을 위해 서슬갈기 가시멧돼지 4 마리와 서슬갈기일족 정찰병 4 마리, 서슬갈기일족 사막길잡이 4 마리, 서슬갈기일족 전투호위병 4 마리를 처치해야 합니다.‡Mata a 4 jabaespines Crines de Acero, 4 rastreadores Crines de Acero, 4 correpolvos Crines de Acero y 4 guardias de batalla Crines de Acero para Gar\'Thok, de Cerrotajo.‡Mata a 4 jabaespines Crines de Acero, 4 exploradores Crines de Acero, 4 polvorosos Crines de Acero y 4 guardias de batalla Crines de Acero para Gar\'Thok, de Cerrotajo.‡Tuer 4 hurans Tranchecrin, 4 Eclaireurs Tranchecrin, 4 Lève-poussière Tranchecrin et 4 Gardes de guerre Tranchecrin pour Gar\'Thok de Tranchecolline.‡为剃刀岭的加索克杀掉4个钢鬃野猪人，4个钢鬃斥候，4个钢鬃传令兵和4个钢鬃卫兵。‡為剃刀嶺的加索克殺掉4個鋼鬃野豬人，4個鋼鬃斥候，4個鋼鬃傳令兵和4個鋼鬃衛兵。',
  }
},
[838] = {
  {
    'Scolomântia‡Некроситет‡Scholomance‡스칼로맨스‡Scholomance‡Scholomance‡Scholomance‡通灵学院‡通靈學院',
    nil,
    'Fale com o Boticário Trépido no Baluarte das Terras Pestilentas Ocidentais.‡Поговорите с аптекарем Дитерсом из Бастиона, что в Западных Чумных землях.‡Sprecht mit Apotheker Dithers am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 연금술사 디더스와 대화하십시오.‡Habla con el boticario Dithers en el Baluarte, en las Tierras de la Peste del Oeste.‡Habla con el boticario Dithers en el Baluarte, en las Tierras de la Peste del Oeste.‡Parler au Pharmacien Dithers à la Barricade, dans les Maleterres de l\'ouest.‡和西瘟疫之地亡灵壁垒的药剂师迪瑟斯谈一谈。‡和西瘟疫之地亡靈壁壘的藥劑師迪瑟斯談壹談。',
  }
},
[839] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    nil,
  }
},
[840] = {
  {
    'Recruta da Horda‡Новобранец Орды‡Freiwilliger der Horde‡호드의 징병‡Nuevo recluta de la Horda‡Nuevo recluta de la Horda‡Sous les drapeaux de la Horde‡部落的新兵‡部落的新兵',
    nil,
    'Siga a estrada a oeste, de Monte Navalha para os Sertões, passando por uma ponte.|nPare no posto avançado órquico do outro lado da ponte.|nEntregue sua carta de recrutamento para Kargal Chaga de Guerra, no posto avançado dos Sertões.‡Ступайте из Колючего Холма в Степи по западной дороге. Перейдите через мост.|nОстановитесь у орочьей заставы за мостом.|nОтдайте Каргалу Боевому Шраму ваше письмо о найме.‡Folgt der westlichen Straße aus Klingenhügel ins Brachland und über die Brücke.|nMacht bei dem Außenposten der Orcs auf der anderen Seite Halt.|nGebt Kargal Battlescar im Brachlandaußenposten Euren Anwerbungsbrief.‡칼바위 언덕에서 서쪽 길을 따라 다리 건너의 불모의 땅으로 가야 합니다.|n다리 건너에 있는 오크 전초 기지에 멈추십시오.|n불모의 땅 전초 기지에 있는 카르갈 배틀스카에게 징병 추천서를 전달하십시오.‡Sigue la carretera occidental de Cerrotajo a Los Baldíos. Pasa el puente.|nDetente en la avanzada orca que hay al otro lado del puente.|nEntrega tu carta de reclutamiento a Kargal Marcaguerra, en la Avanzada de Los Baldíos.‡Sigue el camino occidental desde Cerrotajo hasta los Baldíos, después del puente.|nVe a la avanzada orca que se encuentra cruzando el puente.|nEntrega tu carta de reclutamiento a Kargal Marca de Guerra, en la Avanzada de Los Baldíos.‡Suivre la route de l\'ouest, celle qui part de Tranchecolline, et qui arrive aux Tarides par un pont.|nS\'arrêter à l\'avant-poste orc sur le pont.|nDonner votre lettre de recrutement à Kargal Battlescar aux Tarides.‡沿着剃刀岭西部的小路一直前进，过桥之后就可以进入贫瘠之地。|n在桥对面的兽人前哨找到卡加尔·战痕，将你的募兵信交给他。‡沿著剃刀嶺西部的小路壹直前進，過橋之後就可以進入貧瘠之地。|n在橋對面的獸人前哨找到卡加爾·戰痕，將妳的募兵信交給他。',
  }
},
[841] = {
  {
    'Outra fonte de energia?‡Еще один источник энергии?‡Eine weitere Kraftquelle?‡추가 동력원 필요?‡¿Otra fuente de alimentación?‡¿Otra fuente de alimentación?‡Une autre Source d\'énergie ?‡另一个能量源？‡另壹個能量源？',
    nil,
    'Leve 10 Bolsas de Água do Errante para o Engenheiro-chefe Silvadágua em Geringontzan em troca de outra Fonte de Energia.‡Принесите 10 бурдюков с водой Скитальцев Пустыни главному инженеру Чепухастеру в Прибамбасск в обмен на еще один источник энергии.‡Bringt Chefingenieur Bilgewhizzle in Gadgetzan 10 Wasserbeutel eines Wüstenläufers im Austausch gegen eine weitere Kraftquelle.‡가젯잔에 있는 선임기술자 빌지위즐에게 사막유랑단 물주머니 10개를 가져가 다른 동력원과 맞바꿔야 합니다.‡Llévale 10 faltriquera de agua de Vagayermos al ingeniero jefe Pasaquillas, que está en Gadgetzan, para conseguir otra fuente de alimentación.‡Llévale 10 faltriquera de agua de Vagayermos al ingeniero jefe Pasaquillas, que está en Gadgetzan, para conseguir otra fuente de alimentación.‡Apporter 10 Outres de Bat-le-désert à l\'ingénieur en chef Bilgewhizzle à Gadgetzan pour qu\'il les échange contre une autre source d\'énergie.‡用10个废土水袋来和加基森的总工程师比格维兹换取另外一个能量源。‡用10個廢土水袋來和加基森的總工程師比格維茲換取另外壹個能量源。',
  }
},
[842] = {
  {
    'Recrutamento na Encruzilhada‡Рекрутский набор Перекрестка‡Crossroads-Wehrpflicht‡크로스로드의 징병‡Servicio militar en El Cruce‡Servicio militar en El Cruce‡Conscription à la Croisée‡十字路口征兵‡十字路口征兵',
    nil,
    'Siga a estrada a oeste a partir do Posto Remoto de Kargal.|nNa interseção em T, vire à esquerda e siga a estrada para o sul.|nEncontre Sergra Espinhonegro no cruzamento de estradas da Encruzilhada.‡Ступайте по западной дороге от форпоста Каргала.|nНа развилке поверните налево и ступайте на юг.|nНайдите Сергру Черный Шип у перекрестка дорог в Перекрестке.‡Folgt der Straße von Kargals fernem Farwatch-Außenposten nach Westen.|nWendet Euch bei der Einmündung nach links und folgt dann der Straße in südliche Richtung.|nSucht Sergra Darkthorn an der Kreuzung zweier Straßen in Crossroads auf.‡카르갈의 전초 기지로부터 서쪽 길을 따라가십시오.|nT자형 갈림길에서 왼쪽 길을 따라 남쪽으로 가십시오.|n크로스로드의 교차로에서 셀그라 다크쏜을 찾아야 합니다.‡Sigue la carretera occidental desde la Avanzada de Kargath .|nGira a la izquierda en la intersección y sigue la carretera hacia el sur.|nEncuentra a Sergra Espinoscura en el cruce de carreteras que hay en El Cruce.‡Sigue el camino al oeste de la Avanzada del Puente de Kargal.|nEn la bifurcación, gira a la izquierda y sigue el camino al sur.|nBusca a Sergra Espinoscura en la intersección de El Cruce.‡Suivre la route à l\'ouest à partir du Poste de garde extérieur de Kargal.|nA l\'intersection en T, tourner à gauche et suivre la route vers le sud.|nTrouver Sergra Darkthorn où les routes se croisent à l\'intérieur de la Croisée.‡从卡加尔的前沿哨所往西走。|n在丁字路口往左拐，然后朝南走。|n在十字路口的道路交汇处找到瑟格拉·黑棘。‡從卡加爾的前沿哨所往西走。|n在丁字路口往左拐，然後朝南走。|n在十字路口的道路交匯處找到瑟格拉·黑棘。',
  }
},
[843] = {
  {
    'Reivindicação de Gann‡Ответный удар Ганна‡Ganns Rekultivierung‡갠의 땅 회복‡La reclamación de Gann‡La reclamación de Gann‡La réclamation de Gann‡加恩的报复‡加恩的報復',
    nil,
    'Gann Agulha de Pedra quer que você mate 15 Escavadores de Bael\'Dun e 5 Capatazes de Bael\'dun.|nLeve o Diário de Khazgorm para Gann Agulha de Pedra.‡Ганн Каменное Копье попросил вас убить 15 бейл\'данских землекопов и 5 бейл\'данских старшин.|nПринесите Ганну Каменному Копью записи Хазгорма.‡Gann Stonespire möchte, dass Ihr 15 Ausgräber von Bael\'dun und 5 Großknechte von Bael\'dun tötet.|nBringt Gann Stonespire dann Khazgorms Tagebuch.‡갠 스톤스파이어가 바엘던 발굴인부 15명과 바엘던 현장감독 5명을 처치해 달라고 부탁했습니다.|n그리고 카즈고름의 보고서를 갠 스톤스파이어에게 가져가야 합니다.‡Gann Picopiedra quiere que mates a 15 excavadores de Bael\'dun y a 5 supervisores de Bael\'Dun.|nLlévale el diario de Khazgorm a Gann Picopiedra.‡Gann Picopiedra quiere que mates a 15 excavadores de Bael\'dun y a 5 supervisores de Bael\'dun.|nLlévale el diario de Khazgorm a Gann Picopiedra.‡Gann Stonespire veut que vous tuiez 15 Excavateurs de Bael\'dun et 5 Surveillants de Bael\'dun.|nApporter le Journal de Khazgorm à Gann Stonespire.‡加恩·石塔让你杀死15个巴尔丹挖掘者和5个巴尔丹工头。|n把卡兹戈姆的日记交给加恩·石塔。‡加恩·石塔讓妳殺死15個巴爾丹挖掘者和5個巴爾丹工頭。|n把卡茲戈姆的日記交給加恩·石塔。',
  }
},
[844] = {
  {
    'A ameaça pinote‡Равнинные долгоноги‡Ebenenschreiter-Bedrohung‡초원타조의 위협‡La amenaza de los zancudos de llanura‡La amenaza de los zancudos de llanura‡La menace des trotteurs des plaines‡平原陆行鸟的威胁‡平原陸行鳥的威脅',
    nil,
    'Colete 7 Bicos de Pinote e entregue-os a Sergra Espinhonegro na Encruzilhada.‡Принесите 7 клювов долгоногов Сергре Черный Шип в Перекресток.‡Besorgt 7 Ebenenschreiterschnäbel und bringt sie Sergra Darkthorn in Crossroads.‡초원타조 부리 7개를 모은 후 크로스로드에 있는 셀그라 다크쏜에게 돌아가십시오.‡Reúne 7 picos de zancudos de llanura y llévaselos a Sergra Espinoscura en El Cruce.‡Reúne 7 picos de zancudos de llanura y llévaselos a Sergra Espinoscura en El Cruce.‡Collecter 7 Becs de trotteurs des plaines et les apporter à Sergra Darkthorn à la Croisée.‡收集7个陆行鸟的喙，把它们交给十字路口的瑟格拉·黑棘。‡收集7個陸行鳥的喙，把它們交給十字路口的瑟格拉·黑棘。',
  }
},
[845] = {
  {
    'As zevras‡Жевры‡Die Zhevras‡얼룩말‡El astacebra‡La zhebra‡Les zhévras‡斑马的威胁‡斑馬的威脅',
    nil,
    'Mate Zevras Corredoras e leve 4 Cascos de Zevra para Sergra Espinhonegro na Encruzilhada.‡Убивайте жевр-бегунов, пока не наберете 4 пары копыт жевры для Сергры Черный Шип в Перекрестке.‡Erschlagt Zhevra-Läufer, um für Sergra Darkthorn in Crossroads 4 Zhevra-Hufe zu erhalten.‡굶주린 얼룩말이나 사나운 얼룩말을 처치하여 얼룩말 발굽 4개를 모아 크로스로드에 있는 셀그라 다크쏜에게 가져다주어야 합니다.‡Mata a corredores astacebras para reunir 4 pezuñas de astacebra para Sergra Espinoscura en El Cruce.‡Mata galopadores zhebras y recoge 4 pezuñas de zhebra para Sergra Espinoscura en El Cruce.‡Tuer des Messagers zhévras et apporter 4 Sabots de zhévra à Sergra Darkthorn à la Croisée.‡杀死快步斑马并收集4只斑马蹄，把它们交给十字路口的瑟格拉·黑棘。‡殺死快步斑馬並收集4只斑馬蹄，把它們交給十字路口的瑟格拉·黑棘。',
  }
},
[846] = {
  {
    'A vingança de Gann‡Месть Ганна‡Ganns Rache‡갠의 복수‡La venganza de Gann‡La venganza de Gann‡La revanche de Gann‡加恩的报复‡加恩的報復',
    nil,
    'Gann Agulha de Pedra quer que você leve para ele 6 ampolas de Nitroglicerina, 6 feixes de Polpa de Madeira e 6 amostras de Nitrato de Sódio.‡Ганн Каменное Копье попросил вас принести ему 6 сосудов с нитроглицерином, 6 пучков древесной сердцевины и 6 образцов натриевой селитры.‡Gann Stonespire möchte, dass Ihr ihm 6 Phiolen Nitroglyzerin, 6 Teile Holzbrei und 6 Proben Natriumnitrat bringt.‡갠 스톤스파이어가 니트로글리세린 6병, 나무 펄프 6묶음, 질산나트륨 표본 6개를 가져다 달라고 부탁했습니다.‡Gann Picopiedra quiere que le traigas 6 viales de nitroglicerina, 6 fajos de pulpa de madera y 6 muestras de nitrato de sodio.‡Gann Picopiedra quiere que le traigas 6 viales de nitroglicerina, 6 fajos de pulpa de madera y 6 muestras de nitrato sódico.‡Gann Stonespire veut que vous lui apportiez 6 Fioles de Nitroglycérine, 6 Paquets de Pulpe de bois, et 6 Echantillons de Nitrate de sodium.‡加恩·石塔要你将6瓶硝化甘油、6份木浆和6份硝酸钠交给他。‡加恩·石塔要妳將6瓶硝化甘油、6份木漿和6份硝酸鈉交給他。',
  }
},
[847] = {
  {
    'A astúcia dos raptores‡Коварство ящера‡Arglist des Raptors‡랩터의 기민함‡La astucia del raptor‡La astucia del raptor‡La ruse du raptor‡迅猛龙的狡诈‡迅猛龍的狡詐',
    nil,
    'Fale com Tor\'gan.‡Поговорите с Тор\'Ганом.‡Sprecht mit Tor\'gan.‡토건과 대화해야 합니다.‡Habla con Tor\'gan.‡Habla con Tor\'gan.‡Parler à Tor\'gan.‡和托尔甘谈一谈。‡和托爾甘談壹談。',
  }
},
[848] = {
  {
    'Esporos de Fungos‡Споры грибов‡Pilzsporen‡버섯 포자‡Esporas de hongos‡Esporas de hongos‡Spores fongiques‡菌类孢子‡菌類孢子',
    nil,
    'Leve 4 Esporos de Fungos ao Boticário Hermógenes na Encruzilhada.‡Принесите аптекарю Хелбриму в Перекресток 4 порции спор грибов.‡Bringt dem Apotheker Helbrim in Crossroads 4 Pilzsporen.‡크로스로드에 있는 연금술사 헬브림에게 버섯 포자 4개를 가져다주어야 합니다.‡Llévale las 4 esporas de hongos al boticario Helbrim en El Cruce.‡Llévale 4 esporas de hongos al boticario Helbrim en El Cruce.‡Apporter 4 Spores fongiques à l\'Apothicaire Helbrim à la Croisée.‡收集4个菌类孢子，把它们交给十字路口的药剂师赫布瑞姆。‡收集4個菌類孢子，把它們交給十字路口的藥劑師赫布瑞姆。',
  }
},
[849] = {
  {
    'A vingança de Gann‡Месть Ганна‡Ganns Rache‡갠의 복수‡La venganza de Gann‡La venganza de Gann‡La revanche de Gann‡加恩的报复‡加恩的報復',
    nil,
    'Destrua a máquina voadora em Bael Modan e fale novamente com Gann Agulha de Pedra.‡Уничтожьте ветролет в Бейл Модане и возвращайтесь к Ганну Каменному Копью.‡Zerstört den Flugapparat bei Beal Modan und kehrt dann zu Gann Stonespire zurück.‡바엘 모단에 있는 비행기를 파괴하고 갠 스톤스파이어에게 돌아가십시오.‡Destruye la máquina voladora de Bael Modan y regresa junto a Gann Picopiedra.‡Destruye la máquina voladora de Bael Modan y regresa junto a Gann Picopiedra.‡Détruire la Machine volante à Bael Modan et retourner voir Gann Stonespire.‡摧毁巴尔莫丹的飞行器，然后向加恩·石塔回复。‡摧毀巴爾莫丹的飛行器，然後向加恩·石塔回復。',
  }
},
[850] = {
  {
    'Os líderes Kolkar‡Главари племени Колкар‡Anführer der Kolkar‡콜카르 지도자‡Los jefes de Kolkar‡Los jefes Kolkar‡Les chefs des Kolkar‡科卡尔首领‡科卡爾首領',
    nil,
    'Leve a Cabeça do Barak para Regthar Portões-da-morte a oeste da Encruzilhada.‡Принесите Регтару Вратам Смерти, живущему на западе от Перекрестка, голову Барака.‡Bringt Regthar Deathgate westlich von Crossroads Baraks Kopf.‡바라크 코도베인을 처치하고 그 증거로 그의 머리띠를 크로스로드 서쪽에 있는 렉타르 데스게이트에게 가져가야 합니다.‡Llévale la cabeza de Barak a Regthar Portamorta, al oeste de El Cruce.‡Lleva la cabeza de Barak a Regthar Portamorta, al oeste de El Cruce.‡Apporter la Tête de Barak à Regthar Deathgate, à l\'ouest de la Croisée.‡把巴拉克的头颅交给十字路口的雷戈萨·死门。‡把巴拉克的頭顱交給十字路口的雷戈薩·死門。',
  }
},
[851] = {
  {
    'Verog, o Dervixe‡Верог Дервиш‡Verog der Derwisch‡광신자 베로그‡Verog el Derviche‡Verog el Derviche‡Verog le Derviche‡狂热的维罗戈‡狂熱的維羅戈',
    nil,
    'Leve a Cabeça do Verog para Regthar Portões-da-morte a oeste da Encruzilhada.‡Принесите Регтару Вратам Смерти, живущему на западе от Перекрестка, голову Верога.‡Bringt Regthar Deathgate westlich von Crossroads Verogs Kopf.‡베로그를 처치하고 그 증거로 그의 머리띠를 크로스로드 서쪽에 있는 렉타르 데스게이트에게 가져가야 합니다.‡Llévale la cabeza de Verog a Regthar Portamorta, al oeste de El Cruce.‡Lleva la cabeza de Verog a Regthar Portamorta, al oeste de El Cruce.‡Apporter la Tête de Verog à Regthar Deathgate, à l\'ouest de la Croisée.‡把维罗戈的头颅交给十字路口的雷戈萨·死门。‡把維羅戈的頭顱交給十字路口的雷戈薩·死門。',
  }
},
[852] = {
  {
    'Hezrul Marca de Sangue‡Хэрзул Кровавая Отметина‡Hezrul Blutmal‡헤즈룰 블러드마크‡Hezrul Marcasangre‡Hezrul Marcasangre‡Hezrul Marque-de-sang‡赫兹鲁尔·血印‡赫茲魯爾·血印',
    nil,
    'Leve a Cabeça do Hezrul para Regthar Portões-da-morte a oeste da Encruzilhada.‡Принесите Регтару Вратам Смерти, живущему к западу от Перекрестка, голову Хэрзула.‡Bringt Regthar Deathgate westlich von Crossroads Hezruls Kopf.‡헤즈룰을 처치하고 그 증거로 그의 머리띠를 크로스로드 서쪽에 있는 렉타르 데스게이트에게 가져가야 합니다.‡Llévale la cabeza de Hezrul a Regthar Portamorta, al oeste de El Cruce.‡Lleva la cabeza de Hezrul a Regthar Portamorta, al oeste de El Cruce.‡Apporter la Tête d\'Hezrul à Regthar Deathgate, à l\'ouest de la Croisée.‡把赫兹鲁尔的头颅交给十字路口的雷戈萨·死门。‡把赫茲魯爾的頭顱交給十字路口的雷戈薩·死門。',
  }
},
[853] = {
  {
    'Boticária Zaqueia‡Аптекарь Зама‡Apothekerin Zamah‡연금술사 자마‡Boticaria Zamah‡Boticaria Zamah‡Apothicaire Zamah‡药剂师扎玛‡藥劑師紮瑪',
    nil,
    'Leve os Esporos Entregues para a Boticária Zaqueia no Penhasco do Trovão antes que o tempo se esgote.‡Отнесите топленые споры аптекарю Заме в Громовой Утес за отведенное время.‡Bringt der Apothekerin Zamah in Thunder Bluff die weiterverarbeiteten Sporen, bevor die Zeit abgelaufen ist.‡제한 시간 내에 썬더 블러프에 있는 연금술사 자마에게 정제된 포자를 가져가야 합니다.‡Llévale las esporas convertidas a la boticaria Zamah en Cima del Trueno antes de que se agote el límite de tiempo.‡Llévale las esporas devueltas a la boticaria Zamah en Cima del Trueno antes de que se agote el límite de tiempo.‡Apporter les Spores fondues à l\'Apothicaire Zamah à Thunder Bluff, avant que la limite de temps ne soit dépassée.‡在药剂的效力消失之前，把提炼过的孢子交给雷霆崖的药剂师扎玛。‡在藥劑的效力消失之前，把提煉過的孢子交給雷霆崖的藥劑師紮瑪。',
  }
},
[854] = {
  {
    'Jornada para a Encruzilhada‡Путешествие в Перекресток‡Reise nach Crossroads‡크로스로드로의 여정‡Viaja a El Cruce‡Viaja a El Cruce‡Un voyage à la Croisée‡十字路口之旅‡十字路口之旅',
    nil,
    'Fale com Thork na Encruzilhada, nos Sertões.‡Поговорите с Торком на Перекрестке в Степях.‡Sprecht mit Thork in Crossroads im Brachland.‡불모의 땅에 있는 톨크과 대화해야 합니다.‡Habla con Thork en El Cruce, en Los Baldíos.‡Habla con Thork en El Cruce, en Los Baldíos.‡Parler à Thork, à la Croisée des Tarides.‡去十字路口和索克谈一谈。‡去十字路口和索克談壹談。',
  }
},
[855] = {
  {
    'Braçadeiras de centauro‡Наручи кентавров‡Zentaurenarmschienen‡켄타우로스의 팔보호구‡Los brazales de centauro‡Los brazales centauro‡Les bracelets de centaures‡半人马护腕‡半人馬護腕',
    nil,
    'Leve 15 Braçadeiras de Centauro para Regthar Portões-da-morte a oeste da Encruzilhada.‡Принесите Регтару Вратам Смерти, живущему к западу от Перекрестка, 15 наручей кентавров.‡Bringt Regthar Deathgate westlich von Crossroads 15 Zentaurenarmschienen.‡크로스로드 서쪽에 있는 렉타르 데스게이트에게 켄타우로스의 팔보호구 15개를 가져가야 합니다.‡Llévale 15 brazales de centauro a Regthar Portamorta, al oeste de El Cruce.‡Lleva 15 brazales centauro a Regthar Portamorta, al oeste de El Cruce.‡Apporter 15 Bracelets de centaures à Regthar Deathgate, à l\'ouest de la Croisée.‡收集15个半人马护腕，把他们交给十字路口的雷戈萨·死门。‡收集15個半人馬護腕，把他們交給十字路口的雷戈薩·死門。',
  }
},
[857] = {
  {
    'A Lágrima das Luas‡Слеза Лун‡Die Träne der Monde‡달의 눈물‡La Lágrima de las Lunas‡La Lágrima de las Lunas‡La larme des lunes‡众月之泪‡眾月之淚',
    nil,
    'Feegly, o Exilado, quer que você recupere a Lágrima das Luas para ele.‡Фриглай Изгнанник попросил вас вернуть ему слезу Лун.‡Feegly der Verbannte möchte, dass Ihr ihm die Träne der Monde zurückbringt.‡추방자 피글리가 달의 눈물을 되찾아 달라고 부탁했습니다.‡Feegly el Exiliado quiere que le consigas la Lágrima de las Lunas.‡Feegly el Exiliado quiere que le consigas la Lágrima de las Lunas.‡Feegly l’Exilé veut que vous retrouviez pour lui la Larme des lunes.‡被流放的费格雷要你取回他的众月之泪。‡被流放的費格雷要妳取回他的眾月之淚。',
  }
},
[858] = {
  {
    'Ignição‡Зажигание‡Zündung‡시동‡La llave de contacto‡La llave de contacto‡Contact‡打火钥匙‡打火鑰匙',
    nil,
    'Consiga a Chave de Ignição para Manivela.‡Добыв ключ зажигания, отнесите его Визлкранку.‡Holt den Zündschlüssel und bringt ihn Wizzlecrank.‡위즐크랭크에게 시동 열쇠를 가져다주어야 합니다.‡Consigue la llave de contacto y llévasela a Rabiaire.‡Consigue la llave de ignición y llévasela a Rabiaire.‡Récupérer la Clé de contact et l\'apporter à Wizzlecrank.‡取得打火钥匙，把它交给维兹克兰克。‡取得打火鑰匙，把它交給維茲克蘭克。',
  }
},
[860] = {
  {
    'Sergra Espinhonegro‡Сергра Черный Шип‡Sergra Darkthorn‡셀그라 다크쏜‡Sergra Espinoscura‡Sergra Espinoscura‡Sergra Darkthorn‡瑟格拉·黑棘‡瑟格拉·黑棘',
    nil,
    'Fale com Sergra Espinhonegro na Encruzilhada.‡Поговорите с Сергрой Черный Шип в Перекрестке.‡Sprecht in Crossroads mit Sergra Darkthorn.‡크로스로드에 있는 셀그라 다크쏜과 대화해야 합니다.‡Habla con Serga Espinoscura en El Cruce.‡Habla con Sergra Espinoscura en El Cruce.‡Parler à Sergra Darkthorn, à la Croisée.‡和十字路口的瑟格拉·黑棘谈一谈。‡和十字路口的瑟格拉·黑棘談壹談。',
  }
},
[861] = {
  {
    'A senda do caçador‡Путь охотника‡Der Weg der Jäger‡사냥꾼의 길‡Los hábitos del cazador‡Los hábitos del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Leve 4 Garras de Predador das Estepes para Melor Casco de Pedra no Penhasco do Trovão.‡Принесите 4 когтя хищника плоскогорья Мелору Каменному Копыту в Громовой Утес.‡Bringt Melor Stonehoof in Thunder Bluff 4 Flachlandstreunerklauen.‡썬더 블러프에 있는 멜로르 스톤후프에게 굶주린 평원퓨마 발톱 4개를 가져가야 합니다.‡Lleva 4 garras de merodeador de las estepas a Melor Pezuña Pétrea en Cima del Trueno.‡Lleva 4 garras de merodeador de las estepas a Melor Pezuña Pétrea en Cima del Trueno.‡Apporter 4 Griffes de Rôdeurs des basses plaines à Melor Stonehoof à Thunder Bluff.‡收集4只平原徘徊者的爪子，把它们带给雷霆崖的梅洛·石蹄。‡收集4只平原徘徊者的爪子，把它們帶給雷霆崖的梅洛·石蹄。',
  }
},
[862] = {
  {
    'Ensopado de ratoupeira‡Крысиная похлебка‡Grubenratteneintopf‡들쥐 고기 스튜‡Estofado de ratas de escavación‡Estofado de ratas de madriguera‡Brouet de rat‡掘地鼠炖肉‡掘地鼠燉肉',
    nil,
    'Leve 8 Ratoupeiras para Grude a leste da Encruzilhada.‡Принесите 8 пещерных крыс Грубу на востоке от Перекрестка.‡Bringt Grub östlich von Crossroads 8 Grubenratten.‡크로스로드 동쪽에 있는 그럽에게 들쥐 고기 8개를 가져가야 합니다.‡Llévale 8 ratas de madriguera a Grub al este de El Cruce.‡Llévale 8 ratas de madriguera a Larva al este de El Cruce.‡Apporter 8 Rats fouisseurs à Boustiff\' à l\'est de la Croisée.‡给十字路口的格拉布弄到8只掘地鼠。‡給十字路口的格拉布弄到8只掘地鼠。',
  }
},
[863] = {
  {
    'A fuga‡Бегство‡Die Flucht‡탈출‡La fuga‡La fuga‡La fuite‡逃跑‡逃跑',
    nil,
    'Escolte o Manivela e o retalhador goblínico roubado até Cobogó, na Vila Catraca.‡Охраняйте Зигзага и похищенный гоблинский резак по пути к Пароклапану в Кабестан.‡Schützt Wizzlecrank und den gestohlenen Goblinschredder auf dem Weg zu Sputtervalve in Ratchet.‡위즐크랭크와 그가 훔쳐 낸 고블린 벌목기를 톱니항에 있는 스퍼터밸브에게로 호위해 가야 합니다.‡Protege a Rabiaire y la trituradora goblin robada cuando los lleves a Petardol en Trinquete.‡Protege a Rabiaire y la trituradora goblin robada de camino a Petardol en Trinquete.‡Protéger Wizzlecrank et le Déchiqueteur gobelin volé jusqu\'à Sputtervalve à Ratchet.‡保护维兹克兰克以及他偷来的地精伐木机返回棘齿城的斯布特瓦夫那里。‡保護維茲克蘭克以及他偷來的地精伐木機返回棘齒城的斯布特瓦夫那裏。',
  }
},
[864] = {
  {
    'Fale novamente com a Boticária Zilda‡Возвращение к аптекарю Зинг‡Kehrt zu Apothekerin Zinge zurück‡연금술사 진게에게 돌아가기‡Regresa junto a la boticaria Zinge‡Regresa junto a la boticaria Zinge‡De retour vers l\'Apothicaire Zinge‡向药剂师金格回报‡向藥劑師金格回報',
    nil,
    'Leve o Kit de Teste de Campo Lacrado para a Boticária Zilda na Cidade Baixa.‡Отнесите запечатанный набор для полевых испытаний аптекарю Зинг в Подгород.‡Bringt das versiegelte Feldtestset nach Undercity zu Apothekerin Zinge.‡언더시티에 있는 연금술사 진게에게 봉인된 분석 도구를 가져가야 합니다.‡Llévale el equipo de prueba de campo sellado a la boticaria Zinge, que está en Entrañas.‡Llévale el equipo de prueba de campo sellado a la boticaria Zinge, que está en Entrañas.‡Apporter la Trousse d\'analyse de terrain verrouillée à l\'apothicaire Zinge à Undercity.‡把实验工具包带给幽暗城的药剂师金格。‡把實驗工具包帶給幽暗城的藥劑師金格。',
  }
},
[865] = {
  {
    'Chifres de raptor‡Рога ящера‡Raptorhörner‡랩터 뿔‡Los cuernos de raptor‡Cuernos de raptor‡Les cornes de raptors‡迅猛龙角‡迅猛龍角',
    nil,
    'Obtenha 5 Chifres Intactos de Raptor de Garrafoices Helióscamos e leve-os para Cáliper Porcatraca na Vila Catraca.‡Соберите 5 невредимых рогов ящера с ящерочешуйчатых смертехватов и отнесите их Мебоку Миззриксу в Кабестан.‡Sammelt 5 intakte Raptorhörner von Bluthornsensenklauen und bringt sie Mebok Mizzyrix in Ratchet.‡온전한 랩터 뿔 5개를 모아 톱니항에 있는 메보크 미지릭스에게 가져가야 합니다.‡Recolecta 5 cuernos de raptor intactos de los segadores solescama y llévaselos a Mebok Mizzyrix en Trinquete.‡Recoge 5 cuernos de raptor intactos de segadores Solescama y llévaselos a Mebok Mizzyrix en Trinquete.‡Collecter 5 Cornes de raptors intactes prises sur des Faucheurs solécaille, et les apporter à Mebok Mizzyrix à Ratchet.‡从赤鳞镰爪龙身上收集5根完整的迅猛龙角，把它们交给棘齿城的米希瑞克斯。‡從赤鱗鐮爪龍身上收集5根完整的迅猛龍角，把它們交給棘齒城的米希瑞克斯。',
  }
},
[866] = {
  {
    'Amostras de raiz‡Образцы корней‡Wurzelproben‡뿌리 표본‡Recoge muestras de raíces‡Recoge muestras de raíces‡Les échantillons de racines‡根须样本‡根須樣本',
    nil,
    'Leve 8 Amostras de Raiz para Cáliper Porcatraca na Vila Catraca.‡Принесите Мебоку Миззриксу из Кабестана 8 образцов корней.‡Bringt Mebok Mizzyrix in Ratchet 8 Wurzelproben.‡톱니항에 있는 메보크 미지릭스에게 뿌리 표본 8개를 가져가야 합니다.‡Llévale 8 muestras de raíces a Mebok Mizzyrix en Trinquete‡Llévale 8 muestras de raíces a Mebok Mizzyrix en Trinquete.‡Apporter 8 Echantillons de Racines à Mebok Mizzyrix, à Ratchet.‡把根须样本交给棘齿城的麦伯克·米希瑞克斯。‡把根須樣本交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[867] = {
  {
    'As harpias bandoleiras‡Гарпии-налетчики‡Räuberische Harpyien‡하피의 습격‡Arpías saqueadoras‡Arpías saqueadoras‡Les harpies pillardes‡鹰身强盗‡鷹身強盜',
    nil,
    'Obtenha 8 Garras de Asabruxa.|nLeve-as para Darsok Punhálacre na Encruzilhada.‡Соберите 8 когтей Зачарованного Крыла.|nПринесите их Дарсоку Точному Ножу на Перекресток.‡Sammelt 8 Krallen der Hexenschwingen.|nBringt sie Darsok Swiftdagger in Crossroads.‡칼날바람하피의 갈퀴발톱을 8개 모아야 합니다.|n크로스로드에 있는 달소크 스위프트대거에게 돌아가십시오.‡Reúne 8 talones de Alabruja.|nVuelve junto a Darsok Movedaga en El Cruce.‡Recoge 8 garras de alabruja.|nLlévaselas a Darsok Movedaga en El Cruce.‡Collecter 8 Griffes d\'Ensorçaile.|nLes apporter à Darsok Swiftdagger à la Croisée.‡收集8只巫翼鹰身人的爪子。|n把它们交给十字路口的达索克·快刀。‡收集8只巫翼鷹身人的爪子。|n把它們交給十字路口的達索克·快刀。',
  }
},
[868] = {
  {
    'Ovo tipo extra‡Охота за яйцами‡Eierjagd‡알 사냥‡¡A cazar huevos!‡¡A cazar huevos!‡La chasse aux œufs‡蝎卵‡蠍卵',
    nil,
    'Obtenha 12 Ovos de Silitídeo e devolva a Garra de Escavação para Korran na Encruzilhada.‡Принесите 12 яиц силитидов и вспарывающий коготь Коррану в Перекресток.‡Bringt Korran in Crossroads 12 Silithideneier und die Grabgabel.‡크로스로드에 있는 코란에게 실리시드의 알 12개와 갈퀴발톱 장갑을 가져가야 합니다.‡Llévale 12 huevos de silítido y la cuchara excavadora a Korran en El Cruce.‡Llévale 12 huevos de silítido y la garra de excavación a Korran en El Cruce.‡Apporter 12 Œufs de silithide et la Griffe d\'excavation à Korran, à la Croisée.‡把12枚异种蝎卵和掘地爪交给十字路口的科兰。‡把12枚異種蠍卵和掘地爪交給十字路口的科蘭。',
  }
},
[869] = {
  {
    'Raptores ladrões‡Ящеры-воры‡Raptorendiebe‡도둑 랩터‡Los raptores ladrones‡Raptores ladrones‡Les raptors voleurs‡偷钱的迅猛龙‡偷錢的迅猛龍',
    nil,
    'Leve 12 Cabeças de Raptor para Gazrog na Encruzilhada.‡Принесите 12 голов ящеров Газрогу в Перекресток.‡Bringt Gazrog in Crossroads 12 Raptorenköpfe.‡크로스로드에 있는 가즈록에게 랩터 머리 12개를 가져가야 합니다.‡Llévale 12 cabezas de raptor a Gazrog en El Cruce.‡Lleva 12 cabezas de raptor a Gazrog en El Cruce.‡Apporter 12 Têtes de raptor à Gazrog, à la Croisée.‡收集12颗迅猛龙的头颅，把它们交给十字路口的加兹罗格。‡收集12顆迅猛龍的頭顱，把它們交給十字路口的加茲羅格。',
  }
},
[870] = {
  {
    'Os Charcos Esquecidos‡Забытые пруды‡Die vergessenen Teiche‡잊혀진 웅덩이‡Las Charcas del Olvido‡Las Charcas del Olvido‡Les Bassins oubliés‡遗忘之池‡遺忘之池',
    nil,
    'Informe Tonga Runa Totem sobre as suas descobertas.‡Отыщите источник силы и доложите о нем Тонге Руническому Тотему.‡Berichtet Tonga Runetotem von Euren Entdeckungen.‡통가 룬토템에게 발견한 내용을 보고해야 합니다.‡Informa a Tonga Runatótem con tus hallazgos.‡Informa sobre tus descubrimientos a Tonga Tótem de Runa.‡Rendre compte de vos découvertes à Tonga Runetotem.‡向图加·符文图腾报告你的发现。‡向圖加·符文圖騰報告妳的發現。',
  }
},
[871] = {
  {
    'Cortando o ataque pela raiz‡Прекратить набеги‡Vereitelung der Angriffe‡공격 저지‡Acabar con los ataques de los Crines de Acero‡Interrupción de los ataques‡Stopper les attaques des hurans‡野猪人的袭击‡野豬人的襲擊',
    nil,
    'Da tribo dos Crinavalha, mate 8 Rabdomantes, 8 Tecespinhos e 3 Caçadores, depois fale novamente com Thork na Encruzilhada.‡Убейте 8 водоискателей, 8 терноплетов и 3 охотников племени Иглогривых и возвращайтесь к Торку с Перекрестка.‡Tötet 8 Wassersucher, 8 Dornwirker sowie 3 Jäger des Grimmhauerstamms und kehrt dann zu Thork in Crossroads zurück.‡서슬갈기일족 풍수사 8마리, 서슬갈기일족 가시마술사 8마리 및 서슬갈기일족 사냥꾼 3마리를 처치한 후에 크로스로드에 있는 톨크에게 돌아가십시오.‡De la tribu Crines de Acero, mata a 8 buscaquas, 8 tejespinas y 3 cazadores y vuelve junto a Thork en El Cruce.‡Mata a 8 buscaquas, 8 tejespinas y 3 cazadores de la tribu Crines de Acero y regresa con Thork en El Cruce.‡Dans la tribu Tranchecrin, tuer 8 Sourciers, 8 Tisseuses d’épines et 3 Chasseurs, puis retourner voir Thork.‡在钢鬃野猪人的营地里杀掉8个寻水者、8个织棘者和3个猎手，然后向十字路口的索克复命。‡在鋼鬃野豬人的營地裏殺掉8個尋水者、8個織棘者和3個獵手，然後向十字路口的索克復命。',
  }
},
[872] = {
  {
    'Adeus aos ataques‡Конец бесчинствам‡Das Ende der Unterbrechungen‡습격의 종결‡El fin de las hostilidades‡La perturbación termina‡La perturbation cesse‡野猪人的头目‡野豬人的頭目',
    nil,
    'Mate 8 Geomantes Crinavalha, 8 Defensores Crinavalha e Kreenig Rosnento.|nDepois leve a Presa de Kreenig Rosnento para Thork, na Encruzilhada.‡Убейте 8 геомантов и 8 защитников из племени Иглогривых и Кринига Грознорыла и возвращайтесь к Торку из Перекрестка.‡Tötet 8 Geomanten der Grimmhauer, 8 Verteidiger der Grimmhauer und Kreenig Grantelschnauze.|nBringt dann Thork in Crossroads Kreenig Grantelschnauzes Hauer.‡서슬갈기일족 흙점쟁이 8명과 서슬갈기일족 파수병 8명, 크리니그 스날스나웃을 처치해야 합니다.|n그런 다음 크로스로드에 있는 톨크에게 크리니그 스날스나웃의 어금니를 가져가야 합니다.‡Mata a 8 geománticos Crines de Acero, 8 defensores Crines de Acero y a Kreenig Gruñucico.|nLlévale entonces el colmillo de Kreenig Gruñucico a Thork en El Cruce.‡Mata a 8 geománticos Crines de Acero, 8 defensores Crines de Acero y a Kreenig Gruñucico.|nLuego llévale el colmillo de Kreenig Gruñucico a Thork en El Cruce.‡Tuer 8 Géomanciennes Tranchecrin, 8 Défenseurs Tranchecrin et Kreenig Grondegroin.|nPuis apporter la Défense de Kreenig Grondegroin à Thork à la Croisée.‡杀掉8个钢鬃地卜师、8个钢鬃防御者和他们的头目克里尼格·糟鼻。|n把克里尼格·糟鼻的獠牙交给十字路口的索克。‡殺掉8個鋼鬃地蔔師、8個鋼鬃防禦者和他們的頭目克裏尼格·糟鼻。|n把克裏尼格·糟鼻的獠牙交給十字路口的索克。',
  }
},
[873] = {
  {
    'Isha Awak‡Иша Авак‡Isha Awak‡이샤 아와크‡Isha Awak‡Isha Awak‡Isha Awak‡依沙瓦克‡依沙瓦克',
    nil,
    'Leve o Coração de Isha Awak para Mahren Vidente do Céu.‡Принесите сердце Иши Авака Марен Небесной Провидице.‡Bringt Mahren Skyseer das Herz von Isha Awak.‡마렌 스카이시어에게 이샤 아와크의 심장을 가져가야 합니다.‡Llévale el corazón de Isha Awak a Mahren Visioceleste.‡Llévale el corazón de Isha Awak a Mahren Vidente del Cielo.‡Apporter le Cœur d\'Isha Awak à Mahren Skyseer.‡把依沙瓦克的心脏交给玛伦·星眼。‡把依沙瓦克的心臟交給瑪倫·星眼。',
  }
},
[874] = {
  {
    'Mahren Vidente do Céu‡Марен Небесная Провидица‡Mahren Skyseer‡마렌 스카이시어‡Mahren Visioceleste‡Mahren Vidente del Cielo‡Mahren Skyseer‡玛伦·星眼‡瑪倫·星眼',
    nil,
    'Fale com Mahren Vidente do Céu.‡Поговорите с Марен Небесной Провидицей.‡Sprecht mit Mahren Skyseer.‡마렌 스카이시어와 대화하십시오.‡Habla con Mahren Visioceleste.‡Habla con Mahren Vidente del Cielo.‡Parler à Mahren Skyseer.‡和玛伦·星眼谈一谈。‡和瑪倫·星眼談壹談。',
  }
},
[875] = {
  {
    'Tenentes harpias‡Лейтенанты гарпий‡Offiziere der Harpyien‡하피 부대장‡Las tenientes arpías‡Las tenientes arpías‡Lieutenants harpies‡鹰身人首领‡鷹身人首領',
    nil,
    'Obtenha 6 Anéis de Tenente Harpia de Asabruxas Matadoras e leve-os para Darsok Punhálacre na Encruzilhada.‡Соберите 6 колец лейтенантов гарпий с душегубок из стаи Зачарованного Крыла и возвращайся к Дарсоку Быстрому Ножу.‡Sammelt 6 Harpyienoffiziersringe von den Tötern der Hexenschwingen und kehrt dann zu Darsok Swiftdagger in Crossroads zurück.‡칼날바람일족 암살자들에게서 하피 부대장의 반지 6개를 모아 크로스로드에 있는 달소크 스위프트대거에게 가져가야 합니다.‡Reúne 6 anillos de tenientes arpías de las destripadoras Alabruja y llévaselos a Darsok Movedaga en El Cruce.‡Recoge 6 anillos de tenientes arpías de destripadoras alabruja y regresa con Darsok Movedaga en El Cruce.‡Rassembler 6 Anneaux de lieutenant harpie sur des Tueuses Ensorçaile et les apporter à Darsok Swiftdagger à la Croisée.‡从巫翼杀戮者那里收集6枚鹰身人首领之戒，把它们交给十字路口的达索克·快刀。‡從巫翼殺戮者那裏收集6枚鷹身人首領之戒，把它們交給十字路口的達索克·快刀。',
  }
},
[876] = {
  {
    'Serena Plumassangue‡Серена Кровавое Перо‡Serena Blutfeder‡붉은깃털 세레나‡Serena Sangrepluma‡Serena Sangrepluma‡Serena Plumesang‡塞瑞娜·血羽‡塞瑞娜·血羽',
    nil,
    'Mate Serena Plumassangue e leve a cabeça dela para Darsok Punhálacre na Encruzilhada.‡Убейте Серену Кровавое Перо и принесите ее голову Дарсоку Точному Ножу на Перекресток.‡Erschlagt Serena Blutfeder und bringt Darsok Swiftdagger in Crossroads ihren Kopf.‡붉은깃털 세레나를 처치하고 그 증거로 그녀의 머리카락을 크로스로드에 있는 달소크 스위프트대거에게 가져가야 합니다.‡Mata a Serena Sangrepluma y llévale su cabeza a Darsok Movedaga en El Cruce.‡Mata a Serena Sangrepluma y lleva su cabeza a Darsok Movedaga en El Cruce.‡Tuer Serena Plumesang et apporter sa tête à Darsok Swiftdagger à la Croisée.‡杀掉塞瑞娜·血羽，把她的头颅交给十字路口的达索克·快刀。‡殺掉塞瑞娜·血羽，把她的頭顱交給十字路口的達索克·快刀。',
  }
},
[877] = {
  {
    'O Oásis Estagnado‡Застывший оазис‡Die brackige Oase‡죽은 오아시스‡El Oasis Estancado‡El Oasis Estancado‡L\'oasis stagnante‡死水绿洲‡死水綠洲',
    nil,
    'Fale novamente com Tonga na Encruzilhada depois de investigar o Oásis Estagnado.‡Внимательно осмотрите Застывший оазис и возвращайтесь к Тонге Рунному Тотему в Перекресток.‡Kehrt zu Tonga in Crossroads zurück, nachdem Ihr die brackige Oase untersucht habt.‡죽은 오아시스를 조사한 후 크로스로드에 있는 통가에게 돌아가야 합니다.‡Vuelve junto a Tonga en El Cruce después de investigar El Oasis Estancado.‡Investiga el Oasis Estancado y regresa con Tonga en El Cruce.‡Retourner voir Tonga Runetotem à la Croisée, après avoir enquêté à l\'Oasis stagnante.‡调查死水绿洲，然后返回十字路口向图加·符文图腾报告。‡調查死水綠洲，然後返回十字路口向圖加·符文圖騰報告。',
  }
},
[878] = {
  {
    'Tribos em guerra‡Воюющие племена‡Stämme im Krieg‡부족 간의 전쟁‡Tribus en guerra‡Tribus en guerra‡Tribus en guerre‡野猪人的内战‡野豬人的內戰',
    nil,
    'Mate 6 Rabdomantes Costagulha, 12 Tecespinhos Costagulha e 12 Geomantes Costagulha e fale novamente com Denterroto no Acampamento Taurajo, nos Sertões.‡Убейте 6 водоискателей, 12 терноплетов и 12 геомантов из племени Дыбогривов и возвращайтесь к Кривозубу в Лагерь Таурахо в Степях.‡Erledigt 6 Wassersucher der Borstennacken, 12 Dornenwirker der Borstennacken sowie 12 Geomanten der Borstennacken und kehrt zu Quetschzahn im Camp Taurajo im Brachland zurück.‡뾰족털일족의 풍수사 6명, 가시마술사 12명, 흙점쟁이 12명을 처치해야 합니다. 임무를 완수한 후 불모의 땅, 타우라조 야영지에 있는 뻐드렁니에게 돌아가십시오.‡Mata a 6 buscaquas Lomopelo, 12 tejespinas Lomopelo y 12 geománticos Lomopelo y vuelve junto a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Mata a 6 buscaquas Erizapúas, 12 tejespinas Erizapúas y 12 geománticas Erizapúas y vuelve junto a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Tuer 6 Sourciers Dos-hirsute, 12 Tisseurs d’épines Dos-hirsute et 12 Géomanciennes Dos-hirsute puis retourner auprès de Mangletooth au camp Taurajo dans les Tarides.‡杀掉6个刺背寻水者、12个刺背织棘者和12个刺背地卜师，然后到陶拉祖营地的碎牙那里复命。‡殺掉6個刺背尋水者、12個刺背織棘者和12個刺背地蔔師，然後到陶拉祖營地的碎牙那裏復命。',
  }
},
[879] = {
  {
    'Traição fatal‡Предан своими‡Verräter in den eigenen Reihen‡내부의 배반자‡Traidores‡Traidores‡Une trahison de l\'intérieur‡内奸‡內奸',
    nil,
    'Mate Nak, Kâz e Lok Mataorc e leve o crânio deles para Denterroto no Acampamento Taurajo, que fica nos Sertões.‡Убейте Нака, Куза и Лока Оркобоя и принесите их черепа Кривозубу в Лагерь Таурахо в Степях.‡Tötet Nak, Kuz und Lok Orcbane und bringt Quetschzahn im Camp Taurajo im Brachland ihre Schädel.‡나크와 쿠즈, 로크를 처단하여 그들의 해골을 불모의 땅의 타우라조 야영지에 있는 뻐드렁니에게 가져가야 합니다.‡Mata a Nak, Kuz y Lok Aterraorcos y lleva sus calaveras a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Mata a Nak, Kuz y Lok Aterraorcos y lleva sus calaveras a Quebrantadientes en el Campamento Taurajo en Los Baldíos.‡Tuer Nak, Kuz et Lok Plaie-des-orcs et apporter leurs crânes à Mangletooth au Camp Taurajo dans les Tarides.‡杀掉纳克、卡兹和洛克·奥克班恩，把它们的颅骨交给陶拉祖营地的碎牙。‡殺掉納克、卡茲和洛克·奧克班恩，把它們的顱骨交給陶拉祖營地的碎牙。',
  }
},
[880] = {
  {
    'Seres alterados‡Измененные существа‡Veränderte Wesen‡변화된 생물‡Fuentes de vida‡Seres alterados‡Source de vie‡变异的生物‡變異的生物',
    nil,
    'Leve 8 Cascos Alterados de Mordelisca para Tonga Runa Totem, na Encruzilhada.‡Принесите 8 измененных панцирей зубастых черепах Тонге Руническому Тотему в Перекресток.‡Bringt Tonga Runetotem in Crossroads 8 veränderte Schnappkieferschalen.‡크로스로드에 있는 통가 룬토템에게 변형된 무쇠턱거북 등껍질 8개를 가져다주어야 합니다.‡Llévale 8 caparazones de quijafortes alterados a Tonga Runatótem en El Cruce.‡Lleva 8 caparazones de quijaforte alterado a Tonga Runatótem en El Cruce.‡Apporter 8 Carapaces de Gueules d\'acier altérées à Tonga Runetotem à la Croisée.‡收集8块变异的钳嘴龟壳，把它们交给十字路口的图加。‡收集8塊變異的鉗嘴龜殼，把它們交給十字路口的圖加。',
  }
},
[881] = {
  {
    'Echeyaki‡Ичияки‡Echeyakee‡에체야키‡Echeyakee‡Echeyakee‡Echeyakee‡埃其亚基‡埃其亞基',
    nil,
    'Leve o Pelego de Echeyaki para Sergra Espinhonegro, na Encruzilhada.‡Принесите шкуру Ичияки Сергре Черный Шип на Перекресток.‡Bringt Sergra Darkthorn in Crossroads Echeyakees Balg.‡크로스로드에 있는 셀그라 다크쏜에게 에체야키의 통가죽을 가져가야 합니다.‡Llévale la piel de Echeyakee a Sergra Espinoscura en El Cruce.‡Lleva el pellejo de Echeyakee a Sergra Espinoscura en El Cruce.‡Apporter la Peau d\'Echeyakee à Sergra Darkthorn à la Croisée.‡把埃其亚基的皮交给十字路口的瑟格拉·黑棘。‡把埃其亞基的皮交給十字路口的瑟格拉·黑棘。',
  }
},
[882] = {
  {
    'Ishamuhale‡Ишамухал‡Ishamuhale‡이샤무헤일‡Ishamuhale‡Ishamuhale‡Ishamuhale‡伊沙姆哈尔‡伊沙姆哈爾',
    nil,
    'Leve a Presa de Ishamuhale para Jorn no Acampamento Taurajo.‡Принесите клык Ишамухала Джорну Искателю Неба в Лагерь Таурахо.‡Bringt Jorn Skyseer im Camp Taurajo Ishamuhales Fangzahn.‡타우라조 야영지에 있는 조른 스카이시어에게 이샤무헤일의 송곳니를 가져가야 합니다.‡Llévale el colmillo de Ishamuhale a Jorn en el Campamento Taurajo.‡Llévale el colmillo de Ishamuhale a Jorn en el Campamento Taurajo.‡Apporter le Croc d\'Ishamuhale à Jorn au Camp Taurajo.‡把伊沙姆哈尔的牙齿交给陶拉祖营地的乔恩。‡把伊沙姆哈爾的牙齒交給陶拉祖營地的喬恩。',
  }
},
[883] = {
  {
    'Lakota\'mani‡Лакота\'мани‡Lakota\'mani‡라코타마니‡Lakota\'mani‡Lakota\'mani‡Lakota\'mani‡拉克塔曼尼‡拉克塔曼尼',
    nil,
    'Leve o Casco de Lakota\'mani para Jorn no Acampamento Taurajo.‡Принесите копыто Лакота\'мани Джорну в Лагерь Таурахо.‡Bringt Jorn Skyseer im Camp Taurajo Lakota\'manis Huf.‡타우라조 야영지에 있는 조른 스카이시어에게 라코타마니의 발굽을 가져가야 합니다.‡Llévale la pezuña de Lakota\'mani a Jorn en el Campamento Taurajo.‡Llévale la pezuña de Lakota\'mani a Jorn en el Campamento Taurajo.‡Apporter le Sabot de Lakota\'mani à Jorn au Camp Taurajo.‡把拉克塔曼尼的蹄子交给陶拉祖营地的乔恩。‡把拉克塔曼尼的蹄子交給陶拉祖營地的喬恩。',
  }
},
[884] = {
  {
    'Owatanka‡Оватанка‡Owatanka‡오와탄카‡Owatanka‡Owatanka‡Owatanka‡奥瓦坦卡‡奧瓦坦卡',
    nil,
    'Leve a Ponta da Cauda de Owatanka para Jorn no Acampamento Taurajo.‡Принесите хвостовой зубец Оватанки Джорну Искателю Неба в Лагерь Таурахо.‡Bringt Jorn Skyseer im Camp Taurajo Owatankas Schwanzstachel.‡타우라조 야영지에 있는 조른 스카이시어에게 오와탄카의 꼬리가시를 가져가야 합니다.‡Llévale la espina caudal de Owatanka a Jorn en el Campamento Taurajo.‡Llévale la espina caudal de Owatanka a Jorn en el Campamento Taurajo.‡Apporter l\'Epine caudale d\'Owatanka à Jorn au Camp Taurajo.‡把奥瓦坦卡的尾刺交给陶拉祖营地的乔恩。‡把奧瓦坦卡的尾刺交給陶拉祖營地的喬恩。',
  }
},
[885] = {
  {
    'Anhan Guera‡Ваште Пауни‡Washte Pawne‡워시트 포우니‡Washte Pawne‡Washte Pawne‡Washte Pawne‡瓦希塔帕恩‡瓦希塔帕恩',
    nil,
    'Leve a Pena de Anhan Guera para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отнесите перо Ваште Пауни Джорну Заклинателю Небес в Лагерь Таурахо.‡Bringt Jorn Skyseer im Camp Taurajo Washte Pawnes Feder.‡타우라조 야영지에 있는 조른 스카이시어에게 워시트 포우니의 깃털을 가져가야 합니다.‡Llévale la pluma de Washte Pawne a Jorn Videncielo en el Campamento Taurajo.‡Llévale la pluma de Washte Pawne a Jorn Vidente del Cielo en el Campamento Taurajo.‡Apporter la Plume de Washte Pawne à Jorn Skyseer au Camp Taurajo.‡把瓦希塔帕恩的羽毛交给陶拉祖营地的乔恩·星眼。‡把瓦希塔帕恩的羽毛交給陶拉祖營地的喬恩·星眼。',
  }
},
[886] = {
  {
    'Oásis nos Sertões‡Оазисы Степей‡Die Oasen des Brachlandes‡불모의 땅 오아시스‡El oasis de Los Baldíos‡El oasis de Los Baldíos‡Les oasis des Tarides‡贫瘠之地的绿洲‡貧瘠之地的綠洲',
    nil,
    'Fale com Tonga Runa Totem na Encruzilhada.‡Поговорите на Перекрестке с Тонгой Руническим Тотемом.‡Sprecht in Crossroads mit Tonga Runetotem.‡크로스로드에 있는 통가 룬토템과 대화해야 합니다.‡Habla con Tonga Runatótem en El Cruce.‡Habla con Tonga Tótem de Runa en El Cruce.‡Parler à Tonga Runetotem à la Croisée.‡和十字路口的图加·符文图腾谈一谈。‡和十字路口的圖加·符文圖騰談壹談。',
  }
},
[887] = {
  {
    'Os Flibusteiros dos Mares do Sul‡Флибустьеры Южных морей‡Südmeerfreibeuter‡남쪽바다 해적단‡Los filibusteros del Mar del Sur‡Los filibusteros de los Mares del Sur‡Les flibustiers des Mers du sud‡南海海盗‡南海海盜',
    nil,
    'Mate 12 Bucaneiros dos Mares do Sul e 6 Canhoneiros dos Mares do Sul para Gasganete, que aguarda na Vila Catraca.‡Убейте 12 грабителей Южных морей и 6 канониров Южных морей по просьбе Газула из Кабестана.‡Tötet für Gazlowe in Ratchet 12 Briganten der Südmeerfreibeuter und 6 Kanoniere der Südmeerfreibeuter.‡톱니항에 있는 가즈로를 위해 남쪽바다 해적단 약탈자 12명과 남쪽바다 해적단 포병 6명을 처치해야 합니다.‡Mata a 12 brigadieres del Mar del Sur y a 6 cañoneros del Mar del Sur para Gazlowe en Trinquete.‡Mata 12 salteadores de los Mares del Sur y 6 cañoneros de los Mares del Sur para Gazlowe en Trinquete.‡Tuer 12 Brigands et 6 Canonniers des Mers du Sud pour Gazlowe de Ratchet.‡帮棘齿城的加兹鲁维杀死12个南海歹徒和6个南海炮兵。‡幫棘齒城的加茲魯維殺死12個南海歹徒和6個南海炮兵。',
  }
},
[888] = {
  {
    'Butim Roubado‡Украденное добро‡Gestohlene Beute‡도난당한 전리품‡El botín robado‡Botín robado‡Course à la lentille‡被窃的货物‡被竊的貨物',
    nil,
    'Recupere o Carregamento de Botas e a Lente Telescópica para Gasganete na Vila Catraca.‡Верните Газлоу из Кабестана посылку с сапогами и линзу от телескопа.‡Bringt Gazlowe in Ratchet die Stiefellieferung und die Teleskoplinse zurück.‡톱니항에 있는 가즈로를 위해 장화가 든 뱃짐과 망원경 렌즈를 찾아 와야 합니다.‡Recupera el envío de botas y los telescopios a Gazlowe en Gazlowe.‡Recupera el envío de botas y las lentes telescópicas a Gazlowe en Trinquete.‡Retrouver la Cargaison de bottes et la Lentille de télescope pour Gazlowe de Ratchet.‡帮棘齿城的加兹鲁维取回一箱靴子以及一块望远镜片。‡幫棘齒城的加茲魯維取回壹箱靴子以及壹塊望遠鏡片。',
  }
},
[889] = {
  {
    'Espírito do vento‡Дух Ветра‡Geist des Windes‡바람의 정기‡El espíritu del viento‡El espíritu del viento‡L\'esprit du vent‡风之魂‡風之魂',
    nil,
    '‡‡Bringt Tatternack Steelforge in Crossroads 20 Blutsplitter.‡‡‡‡‡‡',
  }
},
[890] = {
  {
    'Carregamento perdido‡Пропавший груз‡Die verloren gegangene Lieferung‡사라진 뱃짐‡El envío perdido‡El envío perdido‡La livraison perdue‡丢失的货物‡丟失的貨物',
    nil,
    'Leve o Livro-caixa do Gasganete para o Mestre Portuário Caruncho.‡Отнесите учетную книжку Газлоу управляющему пристанью Головокружилкинсу.‡Bringt Werftmeister Dizzywig Gazlowes Geschäftsbuch.‡부두주임 디지위그에게 가즈로의 장부를 가져가야 합니다.‡Llévale el libro de contabilidad de Gazlowe a Vertipeluca, el maestro de muelles.‡Llévale el libro de contabilidad de Gazlowe al maestro de muelles Vertipeluca.‡Apporter le Grand Livre de Gazlowe au Maître des quais Dizzywig.‡把加兹鲁维的账本交给棘齿城的码头管理员迪兹维格。‡把加茲魯維的賬本交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[891] = {
  {
    'Os canhões da Guardanorte‡Пушки крепости Северной Стражи‡Die Kanonen von Northwatch‡전초기지의 대포‡Las armas del Fuerte del Norte‡Las armas del Fuerte del Norte‡Sous le feu de l\'ennemi‡北方城堡的火炮‡北方城堡的火炮',
    nil,
    'O Capitão Thalo\'thas Solaz de Vila Catraca quer que você obtenha 10 Medalhas de Theramore e mate a Capitão Amazona, o Canhoneiro Ocastro e o Canhoneiro Smythe.‡Капитан Тало\'тас Сияющий поручил вам собрать 10 тераморских медалей и убить капитана Гордостанную, канонира Вессана и канонира Смайта.‡Kapitän Thalo\'thas Brightsun aus Ratchet möchte, dass Ihr 10 Medaillen von Theramore sammelt und Captain Hellstieg, Kanonier Knoch und Kanonier Hecksler tötet.‡톱니항에 있는 선장 탈로타스 브라이트썬이 테라모어 휘장 10개를 모으고 경비대장 페어마운트, 포병 훼산, 포병 스미스를 처치해 달라고 부탁했습니다.‡El capitán Thalo\'thas Solbrillante de Trinquete quiere que le consigas 10 medallasTheramore y que ejecutes a la capitán Justamonta, al cañonero Whessan y al cañonero Smythe.‡El capitán Thalo\'thas Solbrillante de Trinquete quiere que recojas 10 medallas de Theramore y mates a la capitana Justamonta, el cañonero Whessan y el cañonero Smythe.‡Le capitaine Thalo\'thas Brightsun de Ratchet veut que vous collectiez 10 Médailles de Theramore et que vous tuiez le Capitaine Fairmount, le Canonnier Whessan et le Canonnier Smythe.‡棘齿城中的沙罗萨斯船长要你收集10枚塞拉摩徽章并干掉法莫斯队长、炮兵维桑恩和炮兵斯密瑟。‡棘齒城中的沙羅薩斯船長要妳收集10枚塞拉摩徽章並幹掉法莫斯隊長、炮兵維桑恩和炮兵斯密瑟。',
  }
},
[892] = {
  {
    'Carregamento perdido‡Пропавший груз‡Die verloren gegangene Lieferung‡사라진 뱃짐‡El envío perdido‡El envío perdido‡La livraison perdue‡丢失的货物‡丟失的貨物',
    nil,
    'Leve o Livro-caixa do Gasganete para o Gasganete na Vila Catraca.‡Верните Газулу из Кабестана его регистр.‡Bringt Gazlowe in Ratchet sein Geschäftsbuch zurück.‡톱니항에 있는 가즈로에게 가즈로의 장부를 돌려주어야 합니다.‡Llévale el libro de contabilidad de Gazlowe a Gazlowe en Trinquete.‡Llévale el libro de contabilidad de Gazlowe a Gazlowe en Trinquete.‡Rapporter le Grand Livre de Gazlowe à Gazlowe à Ratchet.‡把加兹鲁维的账本交还给棘齿城的加兹鲁维。‡把加茲魯維的賬本交還給棘齒城的加茲魯維。',
  }
},
[893] = {
  {
    'Armas preferidas‡Предпочитаемое оружие‡Ausgewählte Waffen‡최고의 무기‡Una selección de armas‡Una selección de armas‡Des armes de choix‡野猪人的武器‡野豬人的武器',
    nil,
    'Leve um Punhal Crinavalha, uma Varinha de Crinavalha Carbonizada e um Escudo de Guerra Crinavalha ao Trapista Forjaço no Acampamento Taurajo, que fica nos Sertões.‡Принесите стилет Иглогривых, обгоревший жезл Иглогривых и боевой щит Иглогривых Таттернаку Стальному Горну в Лагерь Таурахо в Степях.‡Bringt Tatternack Steelforge im Camp Taurajo im Brachland einen Grimmhauerrückenstecher, einen verkohlten Grimmhauerzauberstab und einen Grimmhauerkriegsschild.‡불모의 땅, 타우라조 야영지에 있는 테터낵 스틸포지에게 서슬갈기일족의 기습용 단검, 불타는 마법봉, 그리고 전투용 방패를 가져가야 합니다.‡Llévale 1 puñal Crines de Acero, 1 varita Crines de Acero carbonizada y 1 escudo Crines de Acero a Tatternack Forjacero en Campamento Taurajo en Los Baldíos.‡Llévale 1 puñal Crines de Acero, 1 varita Crines de Acero carbonizada y 1 escudo de guerra Crines de Acero a Jironack Forjacero en Campamento Taurajo en Los Baldíos.‡Apporter un Poignard de Tranchecrin, une Baguette Tranchecrin carbonisée et un Bouclier Tranchecrin à Tatternack Steelforge au camp Taurajo dans les Tarides.‡给陶拉祖营地的塔特纳克·钢炉带去一把钢鬃背刺匕首、一根烧焦的钢鬃魔杖和一面钢鬃大盾。‡給陶拉祖營地的塔特納克·鋼爐帶去壹把鋼鬃背刺匕首、壹根燒焦的鋼鬃魔杖和壹面鋼鬃大盾。',
  }
},
[894] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麽什麽平衡器',
    nil,
    'Acesse o Painel de Controle no laboratório da Empreendimentos S.A.‡Получите доступ к терминалу в исследовательском центре Торговой Компании.‡Verschafft Euch Zugang zur Steuerkonsole in der Forschungseinrichtung der Venture Company.‡투자개발회사 연구 시설의 제어장치로 접근해야 합니다.‡Accede a la consola de control del laboratorio de investigación de Ventura y Cía..‡Accede a la consola de control del laboratorio de investigación de Ventura y Cía.‡Accéder à la Console de contrôle au Centre de recherches de la KapitalRisk.‡在风险投资公司研究基地里找到控制台。‡在風險投資公司研究基地裏找到控制臺。',
  }
},
[895] = {
  {
    'PROCURA-SE: Barão Longacosta‡РАЗЫСКИВАЕТСЯ: Барон Дольноберег‡GESUCHT: Baron Küstenschipper‡롱쇼어 남작 현상수배‡SE BUSCA: Barón Longavera‡SE BUSCA: Barón Longavera‡ON RECHERCHE : baron de Longrivage‡通缉：巴隆·朗绍尔‡通緝：巴隆·朗紹爾',
    nil,
    'Leve a cabeça do Barão Longacosta para Gasganete na Vila Catraca.‡Принесите Газулу в Кабестан голову барона Дольноберега.‡Bringt Gazlowe in Ratchet Baron Küstenschippers Kopf.‡롱쇼어 남작을 처치하고 그 증거로 그의 머리카락을 톱니항에 있는 가즈로에게 가져다주어야 합니다.‡Llévale la cabeza del barón Longavera a Gazlowe en Trinquete.‡Llévale la cabeza del barón Longavera a Gazlowe en Trinquete.‡Apporter la tête du baron de Longrivage à Gazlowe à Ratchet.‡把巴隆·朗绍尔的头颅交给棘齿城的加兹鲁维。‡把巴隆·朗紹爾的頭顱交給棘齒城的加茲魯維。',
  }
},
[896] = {
  {
    'A fortuna do mineiro‡Удача шахтера‡Des Minenarbeiters Vermögen‡광부의 행운‡La fortuna de un minero‡La fortuna de un minero‡La bonne fortune d\'un mineur pauvre‡矿工的宝贝‡礦工的寶貝',
    nil,
    'Consiga a Esmeralda Olho-de-gato de um dos feitores ou seguranças da Empreendimentos S.A. e leve para o Mestre Portuário Caruncho, em Vila Catraca.‡Заберите изумруд "Кошачий глаз" у одного из надзирателей или головорезов Торговой компании и отдайте его управляющему пристанью Головокружилкинсу в Кабестане.‡Beschafft Euch von einem der Vorarbeiter oder Vollstrecker der Venture Company den Katzenaugensmaragd und bringt ihn zu Dizzywig in Ratchet.‡톱니항에 있는 부두주임 디지위그가 투자개발회사 감독이나 투자개발회사 집행자로부터 고양이눈 에메랄드를 가져다 달라고 부탁했습니다.‡Recupera la esmeralda de ojo felino de un vigía de Ventura y Cía. o de uno de sus gorilas para Vertipeluca, el maestro de muelles, en Trinquete.‡Recupera la esmeralda ojo de gato de un sobrestante o un agente de Ventura y Cía para el maestro de muelles Vertipeluca en Triquete.‡Prendre l\'Emeraude œil-de-chat à l\'un des Surveillants ou l\'un des Massacreurs de la KapitalRisk pour le Maître des quais Dizzywig à Ratchet.‡从风险投资公司的某个监督或者执行者那里夺取猫眼翡翠，然后把它交给棘齿城的码头管理员迪兹维格。‡從風險投資公司的某個監督或者執行者那裏奪取貓眼翡翠，然後把它交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[897] = {
  {
    'O ceifador‡Жнец‡Der Ernter‡여왕 실리시드‡El Cosechador‡El Cosechador‡Le Moissonneur‡收割者‡收割者',
    nil,
    'Leve a Cabeça do Ceifador para Jorn Vidente do Céu.‡Принесите голову Жнеца Джорну Заклинателю Небес.‡Bringt den Ernterkopf zu Jorn Skyseer.‡조른 스카이시어에게 여왕 실리시드의 머리를 가져다주어야 합니다.‡Llévale la cabeza del Cosechador a Jorn Vidente del Cielo.‡Llévale la cabeza del Cosechador a Jorn Vidente del Cielo.‡Apporter la Tête du Moissonneur à Jorn Skyseer.‡把收割者的头颅交给乔恩·星眼。‡把收割者的頭顱交給喬恩·星眼。',
  }
},
[898] = {
  {
    'Ex-detento‡Свобода!‡Aus der Gefangenschaft befreit‡요새 탈출‡Escapar del fuerte‡Escapar del fuerte‡Hors du fort‡逃离监牢‡逃離監牢',
    nil,
    'Escolte Gilthares Galhareda em segurança até o Capitão Solaz, que está na Vila Catraca.‡Проводите Гилтареса Огненный Цветок к капитану Сияющему в Кабестан.‡Begleitet Gilthares Firebough sicher zurück zu Kapitän Brightsun in Ratchet.‡길사레즈 파이어바우를 톱니항에 있는 브라이트썬 선장에게 데려가야 합니다.‡Escolta a Gilthares Ramafuego de vuelta hasta Trinquete con el Capitán Solbrillante.‡Escolta a Gilthares Ramafuego de vuelta hasta Trinquete con el Capitán Solbrillante.‡Escorter en toute sécurité Gilthares Firebough jusqu\'au capitaine Brightsun à Ratchet.‡护送基尔萨瑞斯·火枝安全地返回棘齿城的沙罗萨斯船长那里。‡護送基爾薩瑞斯·火枝安全地返回棘齒城的沙羅薩斯船長那裏。',
  }
},
[899] = {
  {
    'Consumido pelo ódio‡Огонь ненависти‡Von Hass zerfressen‡타오르는 증오‡Consumido por el odio‡Consumido por el odio‡Consumé par la haine‡复仇的怒火‡復仇的怒火',
    nil,
    'Leve 60 Presas de Javatusco Costagulha para Mankrik na Encruzilhada.‡Принесите Манкрику с Перекрестка 60 клыков иглосвинов из племени Дыбогривых.‡Bringt Mankrik in Crossroads 60 Stacheleberhauer der Borstennacken.‡크로스로드에 있는 만크릭에게 뾰족털 가시멧돼지 어금니 60개를 가져가야 합니다.‡Llévale 60 colmillos de jabaespín Lomopelo a Mankrik en El Cruce.‡Lleva 60 colmillos de jabaespines a Mankrik en El Cruce.‡Apporter 60 Défenses de huran Dos-hirsute à Mankrik, à la Croisée.‡收集60根刺背野猪人的獠牙，把它们交给十字路口的曼科里克。‡收集60根刺背野豬人的獠牙，把它們交給十字路口的曼科裏克。',
  }
},
[900] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麽什麽平衡器',
    nil,
    'Feche a Válvula de Controle de Combustível, a Válvula de Regulagem e a Válvula Principal e, em seguida, use o Painel de Controle.‡Закройте топливный распределительный клапан, перепускной клапан и главный клапан управления, а потом снова попытайтесь воспользоваться панелью управления.‡Schließt das Treibstoffzufuhrventil, das Regelventil und das Hauptsteuerventil, und benutzt dann noch einmal die Steuerkonsole.‡연료 제어 밸브, 압력 조절 밸브, 주제어 밸브를 잠근 다음 제어장치로 돌아가십시오.‡Cierra la válvula de control de combustible, la válvula reguladora y la válvula de control principal y usa entonces de nuevo la consola de control.‡Cierra la válvula de control de combustible, la válvula reguladora y la válvula de control principal y usa entonces de nuevo la consola de control.‡Fermer la Valve de contrôle du carburant, la Valve de réglage et la Valve de contrôle principale, puis utiliser à nouveau la console de contrôle.‡关闭燃油控制阀、调节阀和主控制阀，然后再使用控制台。‡關閉燃油控制閥、調節閥和主控制閥，然後再使用控制臺。',
  }
},
[901] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麽什麽平衡器',
    nil,
    'Pegue a Chave do Painel do Engenhoqueiro Faísca para usar no painel de controle.‡Возьмите у ремонтника Угрелова ключ от терминала и отоприте им панель управления.‡Besorgt Euch bei Tüftler Sniggles den Konsolenschlüssel, um damit die Steuerkonsole zu öffnen.‡땜장이 스니글즈에게서 제어장치 열쇠를 구해야 합니다.‡Consigue la llave de la consola de Manitas Sniggles para usarla en la consola de control.‡Consigue la llave de la consola de manitas el Risitas para usarla en la consola de control.‡Obtenir la Clé de la console de l\'artisan Sniggles, puis l\'utiliser sur la console de contrôle.‡从工匠斯尼格斯那里拿到能打开控制台的钥匙。‡從工匠斯尼格斯那裏拿到能打開控制臺的鑰匙。',
  }
},
[902] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麽什麽平衡器',
    nil,
    'Leve a Rebimboca para Cobogó na Vila Catraca.‡Отнесите самофланж Пароклапану в Кабестан.‡Bringt das Samophlang zu Sputtervalve in Ratchet.‡톱니항에 있는 스퍼터밸브에게 사모플랜지를 가져가야 합니다.‡Llévale el churumbele a Petardol en Trinquete.‡Devuélvele el churumbele a Petardol en Trinquete.‡Rapporter le Samophlange à Sputtervalve à Ratchet.‡把主动式负载平衡器交给棘齿城的斯布特瓦夫。‡把主動式負載平衡器交給棘齒城的斯布特瓦夫。',
  }
},
[903] = {
  {
    'Predadores dos Sertões‡Хищники Степей‡Streuner des Brachlandes‡불모의 땅의 굶주린 사자‡Merodeadores de los Baldíos‡Merodeadores en Los Baldíos‡Les rôdeurs des Tarides‡草原上的徘徊者‡草原上的徘徊者',
    nil,
    'Colete 7 Garras de Predador de Predadores da Savana para Sergra Espinhonegro na Encruzilhada.‡Принесите 7 когтей хищников саванны Сергре Черный Шип на Перекресток.‡Besorgt für Sergra Darkthorn in Crossroads 7 Streunerklauen von den Savannenstreunern.‡불모의 땅의 굶주린 사바나 사자에게서 굶주린 사자의 발톱 7개를 모아 크로스로드에 있는 셀그라 다크쏜에게 돌아가십시오.‡Reúne 7 garras de merodeador de la sabana y llévaselas a Sergra Espinoscura en El Cruce.‡Recoge 7 garras de merodeadores de la sabana para Sergra Espinoscura en El Cruce.‡Collecter 7 Griffes de Rôdeur des savanes pour Sergra Darkthorn à la Croisée.‡帮十字路口的瑟格拉·黑棘收集7只徘徊者的爪子。‡幫十字路口的瑟格拉·黑棘收集7只徘徊者的爪子。',
  }
},
[905] = {
  {
    'Garrafoices furiosos‡Разъяренные смертехваты‡Die wütenden Sensenklauen‡성난 갈퀴발톱 열대초원랩터‡La ira de los segadores‡Los segadores furiosos‡Les Faucheurs furieux‡狂暴的镰爪龙‡狂暴的鐮爪龍',
    nil,
    'Mate raptores Helióscamos e colete as penas. Use as penas em 3 dos ninhos de Garrafoices. Fale novamente com Sergra Espinhonegro na Encruzilhada.‡Поохотьтесь на яркочешуйчатых ящеров и соберите с них перья. Отнесите перья в 3 гнезда когтедеров. Возвращайтесь к Сергре Черный Шип в Перекресток.‡Tötet Bluthornraptoren und nehmt ihre Federn mit. Benutzt die Federn bei den drei Sensenklauennestern. Kehrt zu Sergra Darkthorn in Crossroads zurück.‡열대초원랩터를 처치하고 그들의 깃털을 모아야 합니다. 이 깃털을 열대초원랩터 둥지 3개에 사용한 다음 크로스로드에 있는 셀그라 다크쏜에게 돌아가십시오.‡Mata a raptores solescama y recoge sus plumas. Usa estas plumas en los 3 nidos de segador. Vuelve junto a Sergra Espinoscura en El Cruce.‡Mata raptores solescama y recoge sus plumas. Usa las plumas en los 3 nidos de segadores. Vuelve con Sergra Espinoscura en El Cruce.‡Tuer des raptors solécaille et récupérer leurs plumes. Placer ces plumes dans les 3 nids de Faucheurs solécaille, puis retourner voir Sergra Darkthorn à la Croisée.‡杀死赤鳞迅猛龙并收集它们的羽毛，把这些羽毛放在3个赤鳞镰爪龙的巢穴里，然后返回十字路口的瑟格拉·黑棘那里。‡殺死赤鱗迅猛龍並收集它們的羽毛，把這些羽毛放在3個赤鱗鐮爪龍的巢穴裏，然後返回十字路口的瑟格拉·黑棘那裏。',
  }
},
[906] = {
  {
    'Traição intestina‡Предатель в наших рядах‡Verräter in den eigenen Reihen‡내부의 배반자‡Traidores‡Traidores‡Une trahison de l\'intérieur‡内奸‡內奸',
    nil,
    'Leve o Crânio de Lok para Thork na Encruzilhada, que fica nos Sertões.‡Отнесите череп Лока Торку на Перекресток.‡Bringt Loks Kopf zu Thork in Crossroads im Brachland.‡불모의 땅, 크로스로드에 있는 톨크에게 로크의 해골을 가져가야 합니다.‡Llévale la calavera de Lok a Thork en El Cruce, en Los Baldíos.‡Llévale la calavera de Lok a Thork en El Cruce, en Los Baldíos.‡Apporter le Crâne de Lok à Thork à la Croisée des Tarides.‡把洛克·奥克班恩的颅骨交给十字路口的索克。‡把洛克·奧克班恩的顱骨交給十字路口的索克。',
  }
},
[907] = {
  {
    'Lagartos trovejantes enfurecidos‡Разъяренные рокочущие ящерицы‡Wütende Donnerechsen‡분노한 천둥도마뱀‡La rabia de los truenagartos‡Los truenagartos iracundos‡Les lézards-tonnerre enragés‡被激怒的雷霆蜥蜴‡被激怒的雷霆蜥蜴',
    nil,
    'Leve 3 unidades de Sangue de Lagarto Trovejante para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отнесите 3 порции крови рокочущей ящерицы Джорну Искателю Неба в Лагерь Таурахо.‡Bringt das Blut von 3 Donnerechsen ins Camp Taurajo zu Jorn Skyseer.‡천둥도마뱀 피 3개를 모아 타우라조 야영지에 있는 조른 스카이시어에게 가져다주어야 합니다.‡Llévale 3 unidades de sangre de truenagarto a Jorn Visioceleste en el Campamento Taurajo.‡Llévale 3 unidades de sangre de truenagarto a Jorn Vidente del Cielo en el Campamento Taurajo.‡Apporter 3 doses de Sang de lézard-tonnerre à Jorn Skyseer, à Camp Taurajo.‡收集3瓶雷霆蜥蜴的血液，把它们交给陶拉祖营地的乔恩·星眼。‡收集3瓶雷霆蜥蜴的血液，把它們交給陶拉祖營地的喬恩·星眼。',
  }
},
[910] = {
  {
    'Lá nas docas‡В порту‡Unten an den Docks‡바다가 보고파요‡Un paseo por los embarcaderos‡Un paseo por los embarcaderos‡Un tour sur les quais‡降帆靠港‡降帆靠港',
    nil,
    'Leve seu protegido às docas da Vila Catraca, que fica nos Sertões.‡Отведите своего подопечного в порт Кабестана в Степях.‡Bringt Euren Schützling in die Docks von Ratchet im Brachland.‡돌보고 있는 고아를 불모의 땅에 있는 톱니항까지 데려다 주어야 합니다.‡Lleva a tu pupilo a los embarcaderos de Trinquete en Los Baldíos.‡Lleva a tu pupilo a los embarcaderos de Trinquete en Los Baldíos.‡Emmenez votre protégé sur les quais de Cabestan, dans les Tarides.‡带着你看护的孤儿去贫瘠之地的棘齿城码头。‡帶著你看護的孤兒去貧瘠之地的棘齒城碼頭。',
  }
},
[911] = {
  {
    'O portal da fronteira‡Врата пограничья‡Das Tor zur Grenze‡최전선으로 가는 관문‡El acceso a la frontera‡El acceso a la frontera‡L\'accès vers la frontière‡前线之门‡前線之門',
    nil,
    'Leve seu protegido até a Paliçada Mor\'shan, que fica ao norte dos Sertões, um pouco antes da entrada do Vale Gris.‡Отведите своего подопечного к Заставе Мор\'шан в северной части Степей на границе с Ясеневым лесом.‡Begleitet Euren Schützling zum Mor\'shan-Schutzwall im nördlichen Teil des Brachlands, kurz bevor man Ashenvale betritt.‡불모의 땅 북부에서 잿빛 골짜기로 들어가기 직전에 있는 몰샨의 망루까지 돌보고 있는 고아를 데려다 주어야 합니다.‡Lleva a tu pupilo a La Empalizada de Mor\'shan en la zona norte de Los Baldíos, antes de la entrada a Vallefresno.‡Lleva a tu pupilo a La Empalizada de Mor\'shan en la zona norte de Los Baldíos, antes de la entrada a Vallefresno.‡Emmenez votre protégé au Rempart de Mor\'shan dans la région nord des Tarides, juste à l\'entrée d\'Ashenvale.‡带着你看护的孤儿去贫瘠之地北部的摩尔沙农场，它就在靠近灰谷入口的地方。‡帶著你看護的孤兒去貧瘠之地北部的莫爾杉壁壘，它就在靠近梣谷入口的地方。',
  }
},
[913] = {
  {
    'O grito do Falcotrom‡Крик грозового змея‡Der Ruf des Donnerfalken‡천둥매의 울음 소리‡El chillido del halcón trueno‡El chillido del halcón trueno‡Le cri du faucon-tonnerre‡雷鹰的嘶鸣‡雷鷹的嘶鳴',
    nil,
    'Encontre e mate um falcotrom, depois leve as asas dele para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отыщите и убейте грозового змея. Принесите его крылья Джорну Заклинателю Небес в Лагерь Таурахо.‡Sucht und erschlagt einen Donnerfalken und bringt Jorn Skyseer in Taurajo seine Flügel.‡천둥매를 찾아 처치하고 천둥매 날개를 타우라조 야영지에 있는 조른 스카이시어에게 가져가야 합니다.‡Encuentra 1 halcón trueno, mátalo y llévale sus alas a Jorn Visioceleste en el Campamento Taurajo.‡Encuentra 1 halcón trueno, mátalo y llévale sus alas a Jorn Vidente del Cielo en el Campamento Taurajo.‡Trouver et tuer un faucon-tonnerre, et rapporter ses ailes à Jorn Skyseer, au Camp Taurajo.‡找到一只雷鹰，杀掉它，然后把它的翅膀交给陶拉祖营地的乔恩·星眼。‡找到壹只雷鷹，殺掉它，然後把它的翅膀交給陶拉祖營地的喬恩·星眼。',
  }
},
[914] = {
  {
    'Líderes da Presa‡Повелители Змей‡Anführer der Giftzähne‡송곳니의 드루이드 우두머리‡Líderes del Colmillo‡Líderes del Colmillo‡Les druides du Croc‡尖牙德鲁伊‡尖牙德魯伊',
    nil,
    'Leve as Gemas de Cobrahn, Sucurina, Pítias e Serpentis para Nara Juba Agreste no Penhasco do Trovão.‡Принесите камни Кобрана, Анакондры, Пифаса и Серпентиса Наре Буйногривой, на Громовой Утес.‡Bringt die Edelsteine von Kobrahn, Anacondra, Pythas und Serpentis nach Thunder Bluff zu Nara Wildmane.‡코브란, 아나콘드라, 피타스, 서펜티스의 보석을 모아 썬더 블러프에 있는 나라 와일드메인에게 돌아가야 합니다.‡Lleva las gemas de Cobrahn, Anacondra, Pythas y Serpentis a Nara Bravacrín en Cima del Trueno.‡Lleva las gemas de Cobrahn, Anacondra, Pythas y Serpentis a Nara Ferocrín en Cima del Trueno.‡Apporter les Gemmes de Cobrahn, d\'Anacondra, de Pythas et de Serpentis à Nara Wildmane à Thunder Bluff.‡将考布莱恩宝石、安娜科德拉宝石、皮萨斯宝石和瑟芬迪斯宝石交给雷霆崖的纳拉·蛮鬃。‡將考布萊恩寶石、安娜科德拉寶石、皮薩斯寶石和瑟芬迪斯寶石交給雷霆崖的納拉·蠻鬃。',
  }
},
[915] = {
  {
    'Olha o sorvete!‡Женщинам – цветы, детям -...‡Lecker Eis‡아이스크림! 아이스크림!‡¡Quiero un heladooooo!‡¡Quiero un heladooooo!‡Je veux une glaaaaace !‡草莓冰激凌‡草莓冰淇淋',
    nil,
    'Consiga um pouco de Sorvete de Morango para o órfão. Ele parece gostar de sorvete da marca Tigule e Foror.‡Купите своему подопечному клубничное мороженое. Кажется, мальчик предпочитает мороженое Тигуле и Форора.‡Besorgt für Euren Schützling etwas Erdbeereis. Der kleine scheint die Marke \'Skippis und Gunnis Eiscreme\' zu bevorzugen.‡돌보고 있는 고아에게 딸기 아이스크림을 사다 주어야 합니다. 티굴과 폴로르의 딸기 아이스크림을 아주 좋아하는 것 같습니다.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Allez chercher de la glace à la fraise pour votre protégé. Le gamin semble préférer la marque de glace Aguilor & Dagharn.‡为你看护的孩子买一些草莓冰激凌。这个孩子似乎最喜欢“提古勒和弗洛尔”牌的草莓冰激凌。‡為你看護的孩子買一些草莓冰淇淋。這個孩子似乎最喜歡提古勒的草莓冰淇淋。',
  }
},
[916] = {
  {
    'Peçonha de lenhateia‡Яд чащобного паука‡Waldwebergift‡나무그물거미의 독‡Veneno de tejemadera‡Veneno de tejemadera‡Le venin des Tissebois‡树林蜘蛛的毒囊‡樹林蜘蛛的毒囊',
    nil,
    'Leve 10 Vesículas de Peçonha de Lenhateia para Gilshalan Andavento em Aldrassil.‡Принесите 10 ядовитых желез чащобных тенетников Гилшалану Буйному Ветру, стоящему у Альдрассила.‡Bringt Gilshalan Windwalker in Aldrassil 10 Waldwebergiftbeutel.‡알드랏실에 있는 길스할란 윈드워커에게 나무그물거미의 독주머니 10개를 가져가야 합니다.‡Lleva 10 glándulas de veneno de tejemadera a Gilshalan Caminaviento en Aldrassil.‡Lleva 10 glándulas de veneno de tejemadera a Gilshalan Caminaviento en Aldrassil.‡Apporter 10 Glandes à venin Tissebois à Gilshalan Windwalker, à Aldrassil.‡给奥达希尔的基尔沙兰·风行者带回10个树林蜘蛛的毒囊。‡給奧達希爾的基爾沙蘭·風行者帶回10個樹林蜘蛛的毒囊。',
  }
},
[917] = {
  {
    'Ovo de Lenhateia‡Яйцо чащобного паука‡Waldweberei‡나무그물거미의 알‡Huevo de Tejemadera‡Huevo de Tejemadera‡L\'œuf d\'araignée Tissebois‡树林蜘蛛的卵‡樹林蜘蛛的卵',
    nil,
    'Leve um Ovo de Lenhateia para Gilshalan em Aldrassil.‡Принесите яйцо чащобного тенетника Гилшалану, стоящему у Альдрассила.‡Bringt Gilshalan in Aldrassil ein Waldweberei.‡알드랏실에 있는 길스할란에게 나무그물거미알을 가져가야 합니다.‡Llévale un huevo de tejemadera a Gilshalan en Aldrassil.‡Llévale un huevo de tejemadera a Gilshalan en Aldrassil.‡Apporter un Œuf d\'araignée Tissebois à Gilshalan à Aldrassil.‡给奥达希尔的基尔莎兰带回1枚树林蜘蛛的卵。‡給奧達希爾的基爾莎蘭帶回1枚樹林蜘蛛的卵。',
  }
},
[918] = {
  {
    'Sementes de muscoide‡Саженцы древесника‡Bäumlingssamenkörner‡나무괴물 씨앗‡Semillas de Brezomadera‡Semillas de Brezomadera‡Les graines de sylvain‡林精的种子‡林精的種子',
    nil,
    'Leve 8 Sementes de Muscoide para Denelan no Lago Al\'Ameth.‡Принесите 8 саженцев древесников Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee 8 Bäumlingssamenkörner.‡알아메스 호수에 있는데날란에게 나무괴물 씨앗 8개를 가져가야 합니다.‡Llévale 8 semillas de Brezomadera a Denalan, que está en el Lago Al\'Ameth.‡Lleva 8 semillas de brezomadera a Denalan en el Lago Al\'Ameth.‡Apporter 8 Graines de sylvain à Denalan au lac Al\'Ameth.‡给奥拉密斯湖边的德纳兰带去8粒林精的种子。‡給奧拉密斯湖邊的德納蘭帶去8粒林精的種子。',
  }
},
[919] = {
  {
    'Brotos de muscoide‡Ростки древесника‡Bäumlingssprossen‡나무괴물 씨눈‡Brotes de Brezomadera‡Brotes de Brezomadera‡Les pousses de sylvain‡林精的新芽‡林精的新芽',
    nil,
    'Leve 12 Brotos de Muscoide para Denalan no Lago Al\'Ameth.‡Принесите 12 ростков древесника Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee 12 Bäumlingssprossen.‡알아메스 호수에 있는 데날란에게 나무괴물 씨눈 12개를 가져가야 합니다.‡Llévale 12 brotes de Brezomadera a Denalan, que está en el Lago Al\'Ameth.‡Lleva 12 brotes de brezomadera a Denalan en el Lago Al\'Ameth.‡Apporter 12 Pousses de sylvain à Denalan au lac Al\'Ameth.‡给奥拉密斯湖边的德纳兰带去12个林精的新芽。‡給奧拉密斯湖邊的德納蘭帶去12個林精的新芽。',
  }
},
[920] = {
  {
    'O chamado de Tenaron‡Зов Тенарона‡Tenarons Einladung‡테나론의 부름‡Las invocaciones de Tenaron‡Las invocaciones de Tenaron‡Les appels de Tenaron‡特纳隆的召唤‡特納隆的召喚',
    nil,
    'Fale com Tenaron Fortagarras no topo de Aldrassil, em Umbravale.‡Поговорите с Тенароном Хваткой Бури. Он ждет вас на вершине Альдрассила в Тенистой долине.‡Sprecht in Shadowglen über den Dächern von Aldrassil mit Tenaron Stormgrip.‡그늘 협곡, 알드랏실 꼭대기에 있는 테나론 스톰그립과 대화하십시오.‡Habla con Tenaron Tormentagarre en Aldrassil, en Cañada Umbría.‡Habla con Tenaron Tormentagarre en Aldrassil, en Cañada Umbría.‡Parler à Tenaron Stormgrip au sommet d\'Aldrassil à Sombrevallon.‡与奥达希尔顶部的特纳隆·雷拳交谈。‡與奧達希爾頂部的特納隆·雷拳交談。',
  }
},
[921] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Cristal e leve-o de volta para Tenaron Fortagarras, no topo de Aldrassil.‡Наполните хрустальный фиал и отнесите его Тенарону Хватке Бури, обитающему на вершине Альдрассила.‡Füllt die Kristallphiole und bringt sie Tenaron Stormgrip über den Dächern von Aldrassil.‡수정 약병에 물을 채워서 알드랏실 꼭대기에 있는 테나론 스톰그립에게 돌아오십시오.‡Llena la ampolla de cristal y devuélvesela a Tenaron Tormentagarre en la cima de Aldrassil.‡Llena la ampolla de cristal y devuélvesela a Tenaron Tormentagarre en la cima de Aldrassil.‡Remplir la Fiole de cristal et la rapporter à Tenaron Stormgrip au sommet d\'Aldrassil.‡装满水晶瓶并将其带回给奥达希尔顶部的特纳隆·雷拳。‡裝滿水晶瓶並將其帶回給奧達希爾頂部的特納隆·雷拳。',
  }
},
[922] = {
  {
    'Rellian Spiraverde‡Релиан Зеленый Костер‡Rellian Greenspyre‡레엘리안 그린스파이어‡Rellian Verdeguja‡Rellian Verdeguja‡Rellian Greenspyre‡雷利亚·绿树‡雷利亞·綠樹',
    nil,
    'Leve uma Semente de Muscoide para Rellian Spiraverde, em Darnassus.‡Принесите росток древесника Релиану Зеленому Костру в Дарнасс.‡Bringt Rellian Greenspyre in Darnassus ein Bäumlingssamenkorn.‡다르나서스에 있는 레엘리안 그린스파이어에게 나무괴물 씨앗을 가져가야 합니다.‡Llévale 1 semilla de Brezomadera a Rellian Verdeguja, que está en Darnassus.‡Llévale una semilla de Brezomadera a Rellian Verdeguja en Darnassus.‡Apporter une Graine de sylvain à Rellian Greenspyre à Darnassus.‡给达纳苏斯的雷利亚·绿树带去一粒林精的种子。‡給達納蘇斯的雷利亞·綠樹帶去壹粒林精的種子。',
  }
},
[923] = {
  {
    'Tumores‡Опухоли‡Tumore‡종양‡Los tumores‡Tumores‡Tumeurs‡青苔之瘤‡青苔之瘤',
    nil,
    'Leve 5 Tumores Musguentos para Rellian Spiraverde, em Darnassus.‡Принесите 5 мшистых опухолей Релиану Зеленому Костру в Дарнасс.‡Bringt Rellian Greenspyre in Darnassus 5 moosartige Tumore.‡다르나서스에 있는 레엘리안 그린스파이어에게 이끼 낀 종양 5개를 가져가야 합니다.‡Lleva 5 tumores musgosos a Rellian Verdeguja a Darnassus.‡Lleva 5 tumores musgosos a Rellian Verdeguja en Darnassus.‡Apporter 5 Tumeurs moussues à Rellian Greenspyre à Darnassus.‡收集5个青苔之瘤，然后把它们交给达纳苏斯的雷利亚·绿树。‡收集5個青苔之瘤，然後把它們交給達納蘇斯的雷利亞·綠樹。',
  }
},
[924] = {
  {
    'A Semente Demoníaca‡Демоново семя‡Die Dämonensaat‡악마의 씨앗‡La Semilla del Demonio‡La Semilla del Demonio‡La Graine démoniaque‡恶魔之种‡惡魔之種',
    nil,
    'Pegue uma Pedra do Poder Defeituosa. Leve-a ao Altar de Fogo antes que ela expire e fale novamente com Ak\'Zeloth.‡Возьмите треснувший камень силы, возложите его на алтарь Огня до окончания его действия и возвращайтесь к Ак\'Зелоту.‡Nehmt einen fehlerhaften Kraftstein. Bringt ihn zum Altar des Feuers, bevor dessen Wirkung erlischt, und kehrt dann zu Ak\'Zeloth zurück.‡우선 혼란의 마법석을 손에 넣으십시오. 마법석의 힘이 다하기 전에 불의 제단에 가져다 놓은 후 아크젤로스에게 돌아가십시오.‡Coge 1 piedra de energía imperfecta. Llévalo al Altar de Fuego antes de caduque la piedra y vuelve entonces junto a Ak\'Zeloth.‡Coge 1 piedra de energía imperfecta. Llévala al Altar de Fuego antes de que su energía desaparezca y vuelve junto a Ak\'Zeloth.‡Prendre une Pierre de puissance imparfaite. L\'apporter à l\'autel de feu avant que le pouvoir de la pierre n\'expire, puis revenir à Ak\'Zeloth.‡取一块有瑕疵的能量石。在能量石失去魔法之前把它带到火焰祭坛去，然后向雅克塞罗斯复命。‡取壹塊有瑕疵的能量石。在能量石失去魔法之前把它帶到火焰祭壇去，然後向雅克塞羅斯復命。',
  }
},
[925] = {
  {
    'Impressão do casco de Caerne‡Отпечаток копыта Кэрна‡Cairnes Hufabdruck‡케른의 발굽도장‡Marca de la pezuña de Cairne‡Huella de Cairne‡L\'empreinte de Cairne‡凯恩的蹄印‡凱恩的蹄印',
    nil,
    'Vá ao Penhasco do Trovão para tentar conseguir a impressão do casco de Caerne Casco Sangrento para o seu protegido.‡Отправляйтесь в Громовой Утес и постарайтесь получить отпечаток копыта Кэрна Кровавого Копыта для своего подопечного.‡Reist nach Thunder Bluff und versucht für Euren Schützling einen Hufabdruck von Cairne Bloodhoof zu ergattern.‡돌보고 있는 고아를 위해 썬더 블러프로 가서 케른 블러드후프의 발굽도장을 받아야 합니다.‡Viaja a Cima del Trueno para intentar conseguir las huellas de pezuñas de Cairne Pezuña de Sangre para tu pupilo.‡Viaja a Cima del Trueno para intentar conseguir las huellas de pezuñas de Cairne Pezuña de Sangre para tu pupilo.‡Allez aux Pitons-du-Tonnerre pour tenter d\'obtenir l\'empreinte de sabot de Cairne pour votre protégé.‡到雷霆崖去，为你看护的孩子拿到一份凯恩·血蹄的蹄印。‡到雷霆崖去，為你看護的孩子拿到一份凱恩·血蹄的蹄印。',
  }
},
[926] = {
  {
    'Pedra do Poder Defeituosa‡Треснувший камень силы‡Fehlerhafter Kraftstein‡혼란의 마법석‡La piedra de energía con imperfecciones‡La piedra de energía con imperfecciones‡Pierre de puissance imparfaite‡有瑕疵的能量石‡有瑕疵的能量石',
    nil,
    nil,
  }
},
[927] = {
  {
    'O coração enroscado em musgo‡Сердце, поросшее мхом‡Das moosumschlungene Herz‡이끼로 덮인 심장‡El corazón musgoso‡El corazón musgoso‡Le cœur moussu‡布满苔藓的心脏‡布滿苔蘚的心臟',
    nil,
    'Leve o Coração Enroscado em Musgo para Denalan no Lago Al\'Ameth.‡Принесите поросшее мхом сердце Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee das moosumschlungene Herz.‡이끼로 덮인 심장을 알아메스 호수에 있는 데날란에게 가져가야 합니다.‡Llévale el corazón musgoso a Denalan, que está en el Lago Al\'Ameth.‡Llévale el corazón musgoso a Denalan, que está en el Lago Al\'Ameth.‡Apporter le Cœur moussu à Denalan au lac Al\'Ameth.‡将布满苔藓的心脏交给奥拉密斯湖畔的德纳兰。‡將布滿苔蘚的心臟交給奧拉密斯湖畔的德納蘭。',
  }
},
[928] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Leve o Recipiente Parcialmente Cheio a Corithras Lunafúria em Dolanaar.‡Отнесите частично наполненный сосуд Коритрасу Лунному Гневу в Доланаар.‡Bringt Corithras Moonrage in Dolanaar das teilweise gefüllte Gefäß.‡돌라나르에 있는 코리드라스 문레이지에게 반쯤 찬 유리병을 가져가십시오.‡Lleva la vasija casi llena a Corithras Furia Lunar a Dolanaar.‡Lleva la vasija casi llena a Corithras Furia Lunar a Dolanaar.‡Apporter le Récipient à moitié plein à Corithras Moonrage à Dolanaar.‡将装着半瓶水的瓶子交给多兰纳尔的科瑞萨斯·月怒。‡將裝著半瓶水的瓶子交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[929] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Jade e leve-o de volta para Corithras Lunafúria em Dolanaar.‡Наполните нефритовый фиал и принесите его Коритрасу Лунному Гневу в Доланаар.‡Füllt die Jadephiole und bringt sie Corithras Moonrage in Dolanaar zurück.‡비취 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de jade y devuélvesela a Corithras Furia Lunar, que está en Dolanaar.‡Llena la ampolla de jade y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Remplir la Fiole de jade et la rapporter à Corithras Moonrage à Dolanaar.‡用月亮井的水装满翡翠瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡用月亮井的水裝滿翡翠瓶，然後把它交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[930] = {
  {
    'A fruta brilhante‡Светящийся плод‡Die leuchtende Frucht‡빛나는 과일‡El fruto resplandeciente‡El fruto resplandeciente‡Le fruit luminescent‡发光的水果‡發光的水果',
    nil,
    'Leve a Fruta Brilhante para Denalan no Lago Al\'Ameth.‡Принесите светящийся плод Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee die leuchtende Frucht.‡알아메스 호수에 있는 데날란에게 빛나는 과일을 가져가야 합니다.‡Llévale el fruto resplandeciente a Denalan, que está en el Lago Al\'Ameth.‡Llévale el fruto resplandeciente a Denalan, que está en el Lago Al\'Ameth.‡Apporter le Fruit luminescent à Denalan au lac Al\'Ameth.‡把这颗发光的水果交给奥拉密斯湖的德纳兰。‡把這顆發光的水果交給奧拉密斯湖的德納蘭。',
  }
},
[931] = {
  {
    'A fronde cintilante‡Мерцающий росток‡Der schimmernde Wedel‡희미하게 빛나는 잎‡Flora luminosa‡Fronda fulgurante‡Les racines flamboyantes‡发光的树叶‡發光的樹葉',
    nil,
    'Leve uma Fronde Cintilante para Denalan no Lago Al\'Ameth‡Принесите мерцающий росток Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee einen der schimmernden Wedel.‡알아메스 호수에 있는 데날란에게 희미하게 빛나는 잎을 가져가야 합니다.‡Llévale una hoja brillante a Denalan, que está en el Lago Al\'Ameth.‡Lleva una fronda fulgurante a Denalan en el Lago Al\'Amethm‡Apporter les Racines flamboyantes à Denalan au lac Al\'Ameth.‡给奥拉密斯湖畔的德纳兰带去1片发光的树叶。‡給奧拉密斯湖畔的德納蘭帶去1片發光的樹葉。',
  }
},
[932] = {
  {
    'Aversão pervertida‡Извращенная ненависть‡Krankhafter Hass‡뒤틀린 증오‡Odio enraizado‡Odio enraizado‡Haine folle‡扭曲的仇恨‡扭曲的仇恨',
    nil,
    'Mate o Senhor Málinus e leve a cabeça dele para Tallonkai Radicélere, em Dolanaar.‡Убейте лорда Меленаса и принесите его голову Таллонкаю Гибкому Корню в Доланаар.‡Tötet Lord Melenas und bringt Tallonkai Swiftroot in Dolanaar seinen Kopf.‡제왕 멜레나스를 처치한 다음 돌라나르에 있는 탈론카이 스위프트루트에게 멜레나스의 머리띠를 가져가야 합니다.‡Mata a Lord Melenas y llévale su cabeza a Tallonkai Cruzarraíz, que está en Dolanaar.‡Mata a Lord Melenas y llévale su cabeza a Tallonkai Cruzarraíz en Dolanaar.‡Tuer le seigneur Melenas et apporter sa tête à Tallonkai Swiftroot à Dolanaar.‡杀掉迈雷纳斯，带他的头去见多兰纳尔的塔隆凯·捷根。‡殺掉邁雷納斯，帶他的頭去見多蘭納爾的塔隆凱·捷根。',
  }
},
[933] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Turmalina e leve-o de volta para Corithras Lunafúria em Dolanaar.‡Наполните турмалиновый фиал и вернитесь к Коритрасу Лунному Гневу в Доланаар.‡Füllt die Turmalinphiole und bringt sie Corithras Moonrage in Dolanaar.‡전기석 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de turmalina y devuélvesela a Corithras Furia Lunar, que está en Dolanaar.‡Llena la ampolla de turmalina y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Remplir la Fiole de tourmaline et la rapporter à Corithras Moonrage à Dolanaar.‡用月亮井的水装满红玉瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡用月亮井的水裝滿紅玉瓶，然後把它交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[934] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡Corona de la tierra‡Corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Ametista e leve-o de volta para Corithras Lunafúria em Dolanaar.‡Наполните аметистовый фиал и принесит его Коритрасу Лунному Гневу в Доланаар.‡Füllt die Amethystphiole und bringt sie Corithras Moonrage in Dolanaar.‡자수정 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de amatista y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Llena la ampolla de amatista y devuélvesela a Corithras Furia Lunar en Dolanaar.|nTeldrassil‡Remplir la Fiole d\'améthyste et la rapporter à Corithras Moonrage à Dolanaar.‡用月亮井的水装满紫水晶瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡用月亮井的水裝滿紫水晶瓶，然後把它交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[935] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Leve o Recipiente Cheio para o Arquidruida Fandral Guenelmo em Darnassus.‡Отнесите наполненный сосуд верховному друиду Фэндралу Оленьему Шлему в Дарнасс.‡Bringt dem Erzdruiden Fandral Staghelm in Darnassus das gefüllte Gefäß.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름에게 가득 찬 유리병을 가져가야 합니다.‡Llévale la vasija llena al archidruida Fandral Corzocelada de Darnassus.‡Llévale la vasija llena al archidruida Fandral Corzocelada de Darnassus.‡Apporter le Récipient plein à l\'archidruide Fandral Staghelm à Darnassus.‡将装满月亮井水的瓶子带给在达纳苏斯的大德鲁伊范达尔·鹿盔。‡將裝滿月亮井水的瓶子帶給在達納蘇斯的大德魯伊範達爾·鹿盔。',
  }
},
[936] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runetotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Runatótem‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Runetotem‡协助大德鲁伊‡協助大德魯伊',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом в Громовом Утесе.‡Sprecht in Thunder Bluff mit Erzdruide Hamuul Runetotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem Rúnico en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l\'archidruide Hamuul Runetotem à Thunder Bluff.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談壹談。',
  }
},
[937] = {
  {
    'A Clareira Encantada‡Зачарованная поляна‡Die verzauberte Lichtung‡마법의 터‡El claro encantado‡El claro encantado‡La clairière enchantée‡神谕林地‡神諭林地',
    nil,
    'Consiga 6 Cintos Plumassangue e leve-os para a Sentinela Arynia Rasganimbus, na Clareira do Oráculo.‡Соберите 6 поясов Кровавых перьев и принесите из часовому Арании Проблеску Солнца на Поляну Оракула.‡Beschafft 6 Blutfedergürtel und bringt sie der Schildwache Arynia Cloudsbreak in der Lichtung des Orakels.‡붉은깃털일족 허리띠 6개를 구해 신탁의 숲에 있는 파수꾼 아리니아 클라우드브레이크에게 가져가야 합니다.‡Consigue 6 cinturones Sangrepluma y llévaselos a la centinela Arynia Quiebranubes de El Claro del Oráculo.‡Consigue 6 cinturones Sangrepluma y llévaselos a la centinela Arynia Quiebranubes de El Claro del Oráculo.‡Acquérir 6 Ceintures plumesang et les apporter à la Sentinelle Arynia Cloudsbreak à la clairière de l\'Oracle.‡收集6条血羽腰带，把它们交给神谕林地里的哨兵阿瑞尼亚·碎云。‡收集6條血羽腰帶，把它們交給神諭林地裏的哨兵阿瑞尼亞·碎雲。',
  }
},
[938] = {
  {
    'Bruma‡Туманна‡Nebel‡미스트‡Niebla‡Niebla‡Brume‡密斯特‡密斯特',
    nil,
    'Escolte Bruma para a Sentinela Arynia Rasganimbus no poço lunar, perto da Árvore dos Oráculos.‡Проводите Туманну к Стражу Арании Проблеску Солнца к лунному колодцу близ Древа-оракула.‡Begleitet Nebel zur Schildwache Arynia Cloudsbreak beim Mondbrunnen in der Nähe des Orakelbaums.‡신탁의 나무 근처의 달샘에 있는 파수꾼 아리니아 클라우드브레이크에게 미스트를 데려가야 합니다.‡Lleva a Niebla ante la centinela Arynia Quiebranubes que se encuentra en la poza de la luna situada cerca del Árbol del Oráculo.‡Lleva a Niebla ante la centinela Arynia Quiebranubes que se encuentra en la Poza de la Luna situada cerca del Árbol del Oráculo.‡Escorter Brume vers la Sentinelle Arynia Cloudsbreak au puits de lune, près de l\'arbre-oracle.‡护送密斯特去神谕之树附近的月亮井旁找哨兵阿瑞尼亚·碎云。‡護送密斯特去神諭之樹附近的月亮井旁找哨兵阿瑞尼亞·碎雲。',
  }
},
[939] = {
  {
    'Flauta de Xavaric‡Флейта Ксаварика‡Flöte des Xavaric‡사바릭의 플룻‡La Flauta de Xavaric‡La Flauta de Xavaric‡Flûte de Xavaric‡萨瓦里克长笛‡薩瓦裏克長笛',
    nil,
    'Leve a Flauta de Xavaric e 5 amostras de Ligavil de Flamejade para Eridan Brisazul, na parte sul da Selva Maleva.‡Принесите флейту Ксаварика и 5 образцов уз Скверны нефритового огня Эридане Грусти Ветра в южную часть Оскверненного леса.‡Bringt die Flöte von Xavaric und 5 Jadefeuerteufelsbinder zu Eridan Bluewind im südlichen Teil des Teufelswalds.‡사바릭의 플룻과 악의 비취불꽃 매듭 5개를 악령의 숲 남쪽의 에리단 블루윈드에게 가져가야 합니다.‡Lleva la Flauta de Xavaric y 5 muestras de lazo maldito de Fuego de Jade a Eridan Vientoazul al Frondavil meridional.‡Lleva la Flauta de Xavaric y 5 muestras de lazo vil de fuego de jade a Eridan Vientoazul al Frondavil meridional.‡Apporter la Flûte de Xavaric et 5 échantillons de Lien maudit Jadefeu à Eridan Bluewind, dans le sud de Gangrebois.‡将萨瓦里克长笛和5个碧火魔符交给费伍德森林南部的艾瑞丹·蓝风。‡將薩瓦裏克長笛和5個碧火魔符交給費伍德森林南部的艾瑞丹·藍風。',
  }
},
[940] = {
  {
    'Teldrassil‡Тельдрассил‡Teldrassil‡텔드랏실‡Teldrassil‡Teldrassil‡Teldrassil‡泰达希尔‡泰達希爾',
    nil,
    'Entregue o relatório da Árvore dos Oráculos para o Arquidruida Fandral Guenelmo em Darnassus.‡Передайте отчет древа-оракула верховному друиду Фэндралу Оленьему Шлему в Дарнасс.‡Überbringt dem Erzdruiden Fandral Staghelm in Darnassus den Bericht des Orakelbaums.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름에게 글씨가 새겨진 나무껍질을 전해야 합니다.‡Llévale el informe del Árbol del Oráculo al archidruida Fandral Corzocelada de Darnassus.‡Llévale el informe del Árbol del Oráculo al archidruida Fandral Corzocelada de Darnassus.‡Remettre le rapport de l\'arbre-oracle à l\'archidruide Fandral Staghelm à Darnassus.‡把神谕之树的报告交给达纳苏斯的大德鲁伊范达尔·鹿盔。‡把神諭之樹的報告交給達納蘇斯的大德魯伊範達爾·鹿盔。',
  }
},
[941] = {
  {
    'Plantando coração‡Сердце-семя‡Das Einpflanzen des Herzens‡오염된 심장 재배‡Plantar el corazón‡Plantar el corazón‡Une belle plante‡培养心脏‡培養心臟',
    nil,
    'Plante o Coração Maculado na Sementeira do Denalan.‡Посадите запятнанное сердце в кадку Деналана.‡Pflanzt das besudelte Herz in Denalans Blumentopf ein.‡데날란의 화분에 오염된 심장을 심어야 합니다.‡Coloca el corazón máculo en la maceta de Denalan.‡Coloca el corazón máculo en la maceta de Denalan.‡Planter le Cœur corrompu dans le Pot de Denalan.‡把被污染的心脏放到德纳兰的培养槽里。‡把被汙染的心臟放到德納蘭的培養槽裏。',
  }
},
[942] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Leve o fóssil misterioso ao Arqueólogo Pançacheia no Porto de Menethil.‡Отвезите таинственную окаменелость археологу Бутылопузу в Гавань Менетилов.‡Bringt das rätselhafte Fossil zum Archäologen Flagongut im Hafen von Menethil.‡메네실 항구에 있는 고고학자 플라곤구트에게 신비로운 화석을 가져가야 합니다.‡Lleva el fósil misterioso al arqueólogo Gargavino al Puerto de Menethil.‡Lleva el fósil misterioso al arqueólogo Gargavino al Puerto de Menethil.‡Apporter le mystérieux Fossile à l\'Archéologue Flagongut au Port de Menethil.‡把神秘的化石交给米奈希尔港的考古学家弗拉冈特。‡把神秘的化石交給米奈希爾港的考古學家弗拉岡特。',
  }
},
[943] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Arqueólogo Pançacheia, no Porto de Menethil, quer que você traga a Pedra de Relu e o Fóssil do Pançacheia para ele.‡Археолог Бутылопуз в Гавани Менетилов хочет, чтобы вы принесли ему камень Релу и окаменелость Бутылопуза.‡Der Archäologe Flagongut im Hafen von Menethil möchte, dass Ihr ihm den Stein von Relu und Flagonguts Fossil bringt.‡메네실 항구에 있는 고고학자 플라곤구트가 렐루의 돌과 플라곤구트의 화석을 가져다 달라고 부탁했습니다.‡El arqueólogo Gargavino, del Puerto de Menethil, quiere que le lleves la Piedra de Relu y el fósil de Gargavino.‡El arqueólogo Gargavino, del Puerto de Menethil, quiere que le lleves la Piedra de Relu y el fósil de Gargavino.‡L\'archéologue Flagongut au Port de Menethil veut que vous lui apportiez la Pierre de Relu et le Fossile de Flagongut.‡米奈希尔港的考古学家弗拉冈特要你把雷鲁之石带给他。‡米奈希爾港的考古學家弗拉岡特要妳把雷魯之石帶給他。',
  }
},
[944] = {
  {
    'Glaive do Mestre‡Меч Властителя‡Die Meistergleve‡지배자의 무덤‡El Glaive del Maestro‡La Espada del Maestro‡Le Glaive du Maître‡主宰之剑‡主宰之劍',
    nil,
    'Reúna informações, depois use o Frasco de Vidência para criar uma Bacia de Vidência. Use a bacia para falar com Onu.‡Соберите информацию, а затем используйте фиал виденья для создания гадальной чаши. С помощью чаши поговорите с Ону.‡Tragt Informationen zusammen und benutzt dann die Wahrsagephiole, um eine Wahrsageschale zu erschaffen. Benutzt die Schale, um mit Onu zu sprechen.‡정보를 수집한 다음 수정점의 유리병을 사용하여 수정점 그릇을 만드십시오. 만들어진 그릇을 사용하여 오누와 대화하십시오.‡Reúne información y luego utiliza una ampolla de adivinación para crear un cuenco de visión. Utiliza el cuenco para hablar con Onu.‡Reúne información y luego utiliza una ampolla de adivinación para crear un cuenco de visión. Utiliza el cuenco para hablar con Onus.‡Trouver des informations, puis utiliser la Fiole de divination pour créer une Coupe de divination. Utiliser la coupe pour parler à Onu.‡收集信息，然后使用占卜之水创造出一个占卜之碗，并利用这个碗和安努通话。‡收集信息，然後使用占蔔之水創造出壹個占蔔之碗，並利用這個碗和安努通話。',
  }
},
[945] = {
  {
    'A fuga de Therylune‡Спасение Тирелин‡Therylunes Flucht‡테리루네의 탈출‡La fuga de Therylune‡La fuga de Therylune‡L\'évasion de Therylune‡护送瑟瑞露尼‡護送瑟瑞露尼',
    nil,
    'Ajude Therylune a escapar e, depois, conte a Therysil, no Altar de Aessina, que a irmã dela está a salvo.‡Помогите Тирелин спастись, а потом сообщите Тересиль у святилища Эссины, что ее сестра в безопасности.‡Verhelft Therylune zur Flucht und teilt dann Therysil beim Schrein von Aessina mit, dass ihre Schwester in Sicherheit ist.‡테리루네의 탈출을 도운 다음 아에시나의 제단에 있는 테리실에게 그녀가 무사하다는 사실을 알려야 합니다.‡Ayuda a escapar a Therylune y luego dile a Therysil, que está en el Santuario de Aessina, que su hermana está a salvo.‡Ayuda a escapar a Therylune y luego dile a Therysil, en el Santuario de Aessina, que su hermana está a salvo.‡Aider Therylune à s\'échapper, puis dire à Therysil au Sanctuaire d\'Aessina que sa sœur est saine et sauve.‡帮助瑟瑞露尼逃跑，然后告诉在艾森娜神殿的瑟瑞希尔，她的妹妹目前很安全。‡幫助瑟瑞露尼逃跑，然後告訴在艾森娜神殿的瑟瑞希爾，她的妹妹目前很安全。',
  }
},
[946] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    nil,
  }
},
[947] = {
  {
    'Cogumelos da caverna‡Грибы из пещеры‡Höhlenpilze‡동굴 버섯‡La cueva de los champiñones‡La cueva de las setas‡La caverne aux champignons‡洞中的蘑菇‡洞中的蘑菇',
    nil,
    'Leve 5 Galhos de Piolho e 1 Cogumelo-cicuta para Barithras Sombraluna, em Auberdine.‡Принесите 5 ножек струпника и 1 мертвянку Баритасу Лунному Сумраку в Аубердин.‡Bringt Barithras Moonshade in Auberdine 5 Schorfstänglinge und 1 Todeskappe.‡아우버다인에 있는 바리스라스 문셰이드에게 껄껄이그물버섯 5개와 알광대버섯 1개를 가져가야 합니다.‡Lleva 5 Lecinums y 1 seta mortal a Barithras Sombraluna a Auberdine.‡Lleva 5 boletos rudos y 1 oronja verde a Barithras Sombra Lunar a Auberdine.‡Apporter 5 Pédoncules d\'Amanite et 1 Amanite phalloïde à Barithras Moonshade à Auberdine.‡收集5个粗柄蘑菇和1个毒帽蘑菇，把它们交给奥伯丁的巴瑞萨斯·月影。‡收集5個粗柄蘑菇和1個毒帽蘑菇，把它們交給奧伯丁的巴瑞薩斯·月影。',
  }
},
[948] = {
  {
    'Onu‡Ону‡Onu‡오누‡Onus‡Onus‡Onu‡安努‡安努',
    nil,
    'Fale com Onu no Bosque dos Ancientes.‡Поговорите с Ону в Роще Древних.‡Sprecht im Hain der Uralten mit Onu.‡고대정령의 숲에서 오누와 대화하십시오.‡Ve al Páramo de los Ancestros y habla con Onu.‡Ve al Páramo de los Ancianos y habla con Onus.‡Parler à Onu au Bosquet des Anciens.‡和古树之林的安努谈一谈。‡和古樹之林的安努談壹談。',
  }
},
[949] = {
  {
    'O Acampamento do Crepúsculo‡Лагерь Сумеречного Молота‡Das Twilight-Lager‡황혼의망치단 야영지‡El campamento del Azote del Ocaso‡El campamento del Martillo Crepuscular‡Le camp du Marteau du crépuscule‡暮光之锤的营地‡暮光之錘的營地',
    nil,
    'Encontre uma pista no acampamento do Martelo do Crepúsculo, que fica na Glaive do Mestre.‡Найдите подсказку в лагере клана Сумеречного Молота, расположенном у Меча Властителя.‡Sucht im Lager des Klans der Twilight-Hammer in der Meistergleve nach einem Hinweis.‡지배자의 무덤에 있는 황혼의망치단 야영지에서 단서를 찾아야 합니다.‡Encuentra una pista en el campamento del Azote del Ocaso en El Glaive del Maestro.‡Encuentra una pista en el campamento del Martillo Crepuscular en La Espada del Maestro.‡Trouver un indice au Camp du Marteau du crépuscule au Glaive du Maître.‡到位于主宰之剑的暮光之锤营地去寻找线索。‡到位於主宰之劍的暮光之錘營地去尋找線索。',
  }
},
[950] = {
  {
    'A volta a Onu‡Возвращение к Ону‡Rückkehr zu Onu‡오누에게로의 귀환‡Vuelve con Onus‡Regresa junto a Onus‡La page qui rend fou‡向安努回复‡向安努回復',
    nil,
    'Leve para Onu os Rabiscos Malucos.‡Принесите Ону лист с безумными письменами.‡Bringt Onu das irrsinnige Gekritzel, das Ihr gefunden habt.‡오누에게 광기의 양피지 문서를 가져가야 합니다.‡Lleva a Onu los Insane Scribbles que has encontrado.‡Lleva a Onus los garabatos incomprensibles que has encontrado.‡Apporter les Gribouillages déments à Onu.‡把令人发狂的书页交给安努。‡把令人發狂的書頁交給安努。',
  }
},
[951] = {
  {
    'Relíquias de Mathistra‡Реликвии Матистры‡Mathystra-Relikte‡마시스트라의 유물‡Las reliquias de Mathystra‡Las reliquias de Mathystra‡Les Reliques de Mathystra‡玛塞斯特拉遗物‡瑪塞斯特拉遺物',
    nil,
    'Leve 6 Relíquias de Mathistra para Onu no Bosque dos Ancientes.‡Принесите Ону в Рощу Древних 6 реликвий Матистры.‡Bringt 6 Mathystra-Relikte zu Onu in den Hain der Uralten.‡고대정령의 숲에 있는 오누에게 마시스트라 유물 6개를 가져가야 합니다.‡Lleva 6 reliquias de Mathystra a Onu al Páramo de los Ancestros.‡Lleva 6 reliquias de Mathystra a Onus al Páramo de los Ancianos.‡Apporter 6 Reliques de Mathystra à Onu, au Bosquet des Anciens.‡收集6个黑暗深渊遗物，把它们交给古树之林的安努。‡收集6個黑暗深淵遺物，把它們交給古樹之林的安努。',
  }
},
[952] = {
  {
    'Bosque dos Ancientes‡Роща Древних‡Der Hain der Uralten‡고대정령의 숲‡El Páramo de los Ancestros‡El Páramo de los Ancianos‡Bosquet des Anciens‡古树之林‡古樹之林',
    nil,
    'Entregue a mensagem de Fandral para Onu no Bosque dos Ancientes, que fica na Costa Negra, ao sul de Auberdine.‡Доставьте письмо Фэндрала Ону в Рощу Древних на Темные берега к югу от Аубердина.‡Bringt Fandrals Nachricht zu Onu in den Hain der Uralten in Dunkelküste, südlich von Auberdine.‡어둠의 해안, 고대정령의 숲에 있는 오누에게 판드랄의 전갈을 전해야 합니다.‡Entrégale el mensaje de Fandral a Onu en el Páramo de los Ancestros en Costa Oscura, al sur de Auberdine.‡Entrégale el mensaje de Fandral a Onus en el Páramo de los Ancianos en Costa Oscura, al sur de Auberdine.‡Livrer le message de Fandral à Onu, au bosquet des Anciens, à Sombrivage, au sud d’Auberdine.‡把范达尔的信交给黑海岸古树之林里的安努。‡把範達爾的信交給黑海岸古樹之林裏的安努。',
  }
},
[953] = {
  {
    'A queda de Ameth\'Aran‡Падение Амет\'Арана‡Der Untergang von Ameth\'Aran‡아메스아란의 멸망‡La caída de Ameth\'Aran‡La caída de Ameth\'Aran‡La chute d\'Ameth\'Aran‡亚米萨兰的毁灭‡亞米薩蘭的毀滅',
    nil,
    'Estude as tabuletas que contam sobre Ameth\'Aran e sua queda, depois fale novamente com a Sentinela Tysha Lamiluna na Costa Negra.‡Изучите таблички, рассказывающие об Амет\'Аране и его падении, а затем возвращайтесь к часовому Тише Лунный Клинок, находящейся на Темных берегах.‡Studiert die Schrifttafeln, die von Ameth\'Aran und ihrem Untergang erzählen, und kehrt dann zur Schildwache Tysha Moonblade in Dunkelküste zurück.‡멸망한 아메스아란의 역사가 기록되어 있는 서판의 내용을 알아낸 다음 어둠의 해안에 있는 파수꾼 티샤 문블레이드에게 돌아가십시오.‡Estudia las tablillas que hablan de Ameth\'Aran y de su caída y reúnete con la centinela Tysha Filoluna en Costa Oscura.‡Estudia las tablillas que hablan de Ameth\'Aran y de su caída y reúnete con la centinela Tysha Filoluna en Costa Oscura.‡Étudier les tablettes qui parlent d\'Ameth\'Aran et de sa chute, puis retourner voir la Sentinelle Tysha Moonblade à Sombrivage.‡研究刻有亚米萨兰的故事及其被毁经过的石碑，然后回到黑海岸的哨兵坦莎·月刃那里。‡研究刻有亞米薩蘭的故事及其被毀經過的石碑，然後回到黑海岸的哨兵坦莎·月刃那裏。',
  }
},
[954] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Encontre a fonte da estranha aura azul nas ruínas de Bashal\'Aran.‡Найдите источник странного синего свечения в руинах Башал\'Арана.‡Sucht in den Ruinen von Bashal\'Aran nach der Quelle der seltsamen blauen Aura.‡바샬아란의 폐허에 감도는 이상한 푸른 기운의 근원을 찾아야 합니다.‡Encuentra la fuente de la extraña aura azul en las Ruinas de Bashal\'Aran.‡Encuentra la fuente de la extraña aura azul en las Ruinas de Bashal\'Aran.‡Trouver la source de l’aura bleue dans les Ruines de Bashal\'Aran.‡到巴莎兰废墟去找到奇怪蓝光的源头。‡到巴莎蘭廢墟去找到奇怪藍光的源頭。',
  }
},
[955] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Consiga 8 Brinco de Capeta para Astérion em Bashal\'Aran.‡Соберите 8 серег греллей для Астериона в Башал\'Аране.‡Beschafft für Asterion in Bashal\'Aran 8 Grell-Ohrringe.‡바샬아란에 있는 아스테리온을 위해 그렐족 귀걸이 8개를 구해야 합니다.‡Consigue 8 pendientes de grell y llévaselos a Asterion a Bashal\'Aran.‡Consigue 8 pendientes de grell y llévaselos a Asterion a Bashal\'Aran.‡Acquérir 8 Boucles d\'oreilles de grell pour Asterion à Bashal\'Aran.‡帮巴莎兰的阿斯特利安收集8只劣魔耳环。‡幫巴莎蘭的阿斯特利安收集8只劣魔耳環。',
  }
},
[956] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Obtenha o Selo Antigo de Pedra-da-lua e leve-o para Astérion em Bashal\'Aran.‡Добудьте древнюю печать из лунного камня и принесите ее Астериону в Башал\'Аран.‡Beschafft das alte Mondstein-Siegel und bringt es Asterion in Bashal\'Aran.‡고대 월장석 봉인을 찾아 바샬아란에 있는 아스테리온에게 가져가야 합니다.‡Consigue el lacre de piedra lunar antiguo y llévaselo a Asterion a Bashal\'Aran.‡Consigue el sello de piedra lunar antiguo y llévaselo a Asterion a Bashal\'Aran.‡Obtenir l\'Ancien sceau de pierre de lune et l\'apporter à Asterion à Bashal\'Aran.‡获取远古月亮石封印，把它交给巴莎兰的阿斯特利安。‡獲取遠古月亮石封印，把它交給巴莎蘭的阿斯特利安。',
  }
},
[957] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Destrua o Selo Antigo de Pedra-da-lua na chama ancestral em Ameth\'Aran, depois fale novamente com Astérion em Bashal\'Aran.‡Уничтожьте древнюю печать из лунного камня у древнего огня в Амет\'Аране, затем вернитесь к Астериону в Башал\'Аран.‡Zerstört das alte Mondstein-Siegel in der uralten Flamme in Ameth\'Aran und kehrt dann zu Asterion in Bashal\'Aran zurück.‡아메스아란에 있는 고대의 불꽃으로 고대 월장석 봉인을 파괴한 다음 바샬아란에 있는 아스테리온에게 돌아가십시오.‡Destruye el lacre de piedra lunar antiguo en la antigua llama de Ameth\'Aran y vuelve a reunirte con Asterion en Bashal\'Aran.‡Destruye el sello de piedra lunar antiguo en la antigua llama de Ameth\'Aran y vuelve a reunirte con Asterion en Bashal\'Aran.‡Détruire l\'Ancien sceau de pierre de lune à la flamme antique qui se trouve dans Ameth\'Aran, puis retourner voir Asterion à Bashal\'Aran.‡用亚米萨兰废墟中的远古火焰摧毁远古月亮石封印，然后回到巴莎兰的阿斯特利安那里。‡用亞米薩蘭廢墟中的遠古火焰摧毀遠古月亮石封印，然後回到巴莎蘭的阿斯特利安那裏。',
  }
},
[958] = {
  {
    'Ferramentas dos Altaneiros‡Инструменты высокорожденных‡Werkzeuge der Hochgeborenen‡명가의 도구‡Las herramientas de los altonatos‡Las herramientas de los Altonato‡Les outils des Bien-nés‡上层精灵的工具‡上層精靈的工具',
    nil,
    'Resgate 7 Relíquias dos Altaneiros para Trovejius Tecevento, em Auberdine.‡Добудьте 7 реликвий высокорожденных для Тандриса Ветропряда в Аубердине.‡Sucht sieben Hochgeborenenrelikte und bringt sie Thundris Windwirker in Auberdine.‡아우버다인에 있는 툰드리스 윈드위버를 위해 명가의 유물 7개를 찾아 와야 합니다.‡Reúne 7 reliquias de los altonatos y llévaselas a Thundris Tejevientos a Auberdine.‡Reúne 7 reliquias de los Altonato y llévaselas a Thundris Tejevientos a Auberdine.‡Retrouver 7 Reliques de Bien-né pour Thundris Windweaver à Auberdine.‡帮奥伯丁的桑迪斯·织风取回7个上层精灵的遗物。‡幫奧伯丁的桑迪斯·織風取回7個上層精靈的遺物。',
  }
},
[959] = {
  {
    'Encrencas nas docas‡Неприятности в порту‡Ärger auf den Docks‡99년 묵은 와인‡¡A por la botella!‡¡A por la botella!‡Fuite de porto aux docks‡港口的麻烦‡港口的麻煩',
    nil,
    'O Operador de Grua Mafuá, em Vila Catraca, quer que você recupere a garrafa de Xerez de 99 Anos com Maluc Insano, que se refugiou na Caverna Ululante.‡Оператор крана Биггльфузз из Кабестана попросил вас отнять бутылку портвейна 99-летней выдержки у Безумного Магглиша, который прячется в Пещерах Стенаний.‡Kranführer Bigglefuzz in Ratchet möchte, dass Ihr Zausel dem Verrückten, der sich in den Höhlen des Wehklagens versteckt, die Flasche mit 99-jährigem Portwein wieder abnehmt.‡톱니항에 있는 기중기 기사 비글퍼즈가 통곡의 동굴에 숨어 있는 광기의 매글리시에게서 99년 숙성된 포트 와인을 되찾아 달라고 부탁했습니다.‡El operador de grúa Pelardo de Trinquete quiere que le consigas una botella de porto de 99 años de Magglish el Loco que se esconde en las Cuevas de los Lamentos.‡El operador de grúa Pelardo de Trinquete quiere que le consigas una botella de Oporto con 99 años de antigüedad de Loco Magglish, que se esconde en las Cuevas de los Lamentos.‡Le grutier Bigglefuzz de Ratchet veut que vous repreniez la Bouteille de porto vieille de 99 ans à Magglish le Dingue, qui se cache dans les Cavernes des lamentations.‡棘齿城的起重机操作员比戈弗兹让你从疯狂的马格利什那儿取回一瓶99年波尔多陈酿，疯狂的马格利什就藏在哀嚎洞穴里。‡棘齒城的起重機操作員比戈弗茲讓妳從瘋狂的馬格利什那兒取回壹瓶99年波爾多陳釀，瘋狂的馬格利什就藏在哀嚎洞穴裏。',
  }
},
[961] = {
  {
    'A meditação de Onu‡Размышление Ону‡Onu meditiert‡생각 중인 오누‡Onus lo está meditando‡Onus lo está meditando‡Onu réfléchit‡正在冥想的安努‡正在冥想的安努',
    nil,
    nil,
  }
},
[962] = {
  {
    'Ofídeas‡Змеецвет‡Schlangenflaum‡불뱀꽃‡Repitilia‡Reptilia‡Fleur de serpent‡毒蛇花‡毒蛇花',
    nil,
    'A Boticária Zaqueia, no Penhasco do Trovão, quer que você colete 10 Ofídeas.‡Аптекарша Зама из Громового Утеса просит вас принести ей 10 змеецветов.‡Die Apothekerin Zamah in Thunder Bluff möchte, dass Ihr zehn Schlangenflaum für sie sammelt.‡썬더 블러프에 있는 연금술사 자마가 불뱀꽃 10개를 모아 달라고 부탁했습니다.‡La boticaria Zamah de Cima del Trueno quiere que recojas 10 reptilias.‡La boticaria Zamah de Cima del Trueno quiere que recojas 10 reptilias.‡L\'Apothicaire Zamah à Thunder Bluff veut que vous récoltiez 10 Fleurs de serpent.‡为雷霆崖的药剂师扎玛收集10朵毒蛇花。‡為雷霆崖的藥劑師紮瑪收集10朵毒蛇花。',
  }
},
[963] = {
  {
    'Amor eterno‡Во имя вечной любви‡In ewiger Liebe‡영원한 사랑‡Un amor eterno‡Un amor eterno‡Un amour éternel‡永志不渝‡永誌不渝',
    nil,
    'Liberte o espírito de Anaya Correalba e leve seu pingente para Cerellean Garralva em Auberdine.‡Освободите дух Анайи Вестницы Рассвета и принесите ее подвеску Кириллиану Белому Когтю в Аубердин.‡Befreit den Geist von Anaya Dawnrunner und bringt ihren Anhänger zu Cerellean Whiteclaw in Auberdine.‡아나야 돈러너의 영혼을 자유롭게 한 다음 그녀의 펜던트를 아우버다인에 있는 셀렐리안 화이트클로에게 가져가야 합니다.‡Libera el espíritu de Anaia Correalba y lleva su colgante a Cerellean Zarpablanca a Auberdine.‡Libera el espíritu de Anaia Correalba y lleva su colgante a Cerellean Zarpablanca a Auberdine.‡Libérer l\'esprit d\'Anaya Dawnrunner et rapporter son pendentif à Cerellean Whiteclaw à Auberdine.‡释放安娜雅·晨路的灵魂，把她的坠饰交给奥伯丁的塞瑞利恩·白爪。‡釋放安娜雅·晨路的靈魂，把她的墜飾交給奧伯丁的塞瑞利恩·白爪。',
  }
},
[964] = {
  {
    'Fragmentos de Ossos‡Фрагменты скелетов‡Skelettfragmente‡뼈조각‡Fragmentos esqueléticos‡Trozos esqueléticos‡Fragments de squelette‡骸骨碎片‡骸骨碎片',
    nil,
    'Leve 15 Fragmentos de Ossos para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите 15 фрагментов скелетов аптекарю Дитерсу в Бастион в Западных Чумных землях.‡Bringt 15 Skelettfragmente zu Apotheker Dithers am Bollwerk, Westliche Pestländer.‡서부 역병지대의 보루에 있는 연금술사 디더스에게 뼈조각 15개를 가져가야 합니다.‡Lleva 15 fragmentos esqueléticos al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva 15 trozos esqueléticos al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter 15 Fragments de squelette au Pharmacien Dithers à la Barricade, dans les Maleterres de l\'ouest.‡将15块骸骨碎片交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡將15塊骸骨碎片交給西瘟疫之地亡靈壁壘的藥劑師迪瑟斯。',
  }
},
[965] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Encontre Balthule Umbrataque perto da Torre de Althalaxx, que fica na Costa Negra.‡Найдите Балтула Удар Тени возле башни Алталакса на Темном Берегу.‡Sucht Balthule Shadowstrike in der Nähe des Turms von Althalaxx in Dunkelküste.‡어둠의 해안에 있는 알살락스의 탑 근처에서 발툴 섀도스트라이크를 찾아야 합니다.‡Encuentra a Balthule Golpesombra cerca de La torre de Althalaxx en Costa Oscura.‡Encuentra a Balthule Tenebroso cerca de La Torre de Althalaxx en Costa Oscura.‡Trouver Balthule Shadowstrike près de la Tour d\'Althalaxx à Sombrivage.‡在黑海岸的奥萨拉克斯之塔附近找到巴苏尔·影击。‡在黑海岸的奧薩拉克斯之塔附近找到巴蘇爾·影擊。',
  }
},
[966] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Colete 4 Pergaminhos Gastos para Balthule Umbrataque, perto da Torre de Althalaxx.‡Соберите 4 свитка истрепанного пергамента для Балтула Удара Тени возле башни Алталакса.‡Sammelt 4 abgenutzte Pergamentfetzen für Balthule Shadowstrike in der Nähe des Turms von Althalaxx.‡알살락스의 탑 근처에 있는 발툴 섀도스트라이크를 위해 낡은 양피지 문서 4개를 모아야 합니다.‡Reúne 4 pliegos gastados para Balthule Golpesombra acerca de La torre de Althalaxx.‡Reúne 4 papiros desgastados para Balthule Golpesombra acerca de La Torre de Althalaxx.‡Collecter 4 Parchemins passés pour Balthule Shadowstrike près de la Tour d\'Althalaxx.‡在奥萨拉克斯之塔附近帮巴苏尔·影击收集4块破旧的羊皮纸。‡在奧薩拉克斯之塔附近幫巴蘇爾·影擊收集4塊破舊的羊皮紙。',
  }
},
[967] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Entregue a carta de Balthule a Dinis, o Purificador, na Floresta do Vale Gris.‡Доставьте письмо Балтула Делгрену Очистителю в Ясеневый лес.‡Überbringt Delgren dem Läuterer in Ashenvale Balthules Brief.‡잿빛 골짜기 숲에 있는 수호자 델그렌에게 발툴의 편지를 전해야 합니다.‡Entrega la carta de Balthule a Delgren el Purificador que está en el Bosque de Vallefresno.‡Entrega la carta de Balthule a Delgren el Purificador que está en el Bosque de Vallefresno.‡Remettre la Lettre de Balthule à Delgren le Purificateur dans la forêt d\'Ashenvale.‡把巴苏尔的信送给灰谷森林中的净化者德尔格伦。‡把巴蘇爾的信送給灰谷森林中的凈化者德爾格倫。',
  }
},
[968] = {
  {
    'Os Poderes de Baixo‡"Подземные Силы"‡Die Macht in der Tiefe‡힘의 저편‡Los Poderes Subyacentes‡Los Poderes Subyacentes‡Les puissances d\'en-bas‡深渊之神‡深淵之神',
    nil,
    'Leve o Livro: Os Poderes de Baixo para Gerrig Agarrosso na Caverna Esquecida, em Altaforja.‡Принесите книгу "Подземные Силы" Геррику Костохвату в Заброшенный грот в Стальгорне.‡Bringt das Buch: \'Die Macht in der Tiefe\' zu Gerrig Bonegrip im düsteren Viertel in Ironforge.‡아이언포지에 있는 게릭 본그립에게 \'힘의 저편\'이라는 책을 가져가야 합니다.‡Lleva el libro Los Poderes Subyacentes a Gerrig Agarrahueso a La Caverna Abandonada, en Forjaz.‡Lleva el libro Los Poderes Subyacentes a Gerrig Agarrahueso a La Caverna Abandonada, en Forjaz.‡Apporter le Livre : Les puissances d\'en bas à Gerrig Bonegrip, dans la caverne lugubre d\'Ironforge.‡把《深渊之神》交给铁炉堡的葛利·硬骨。‡把《深淵之神》交給鐵爐堡的葛利·硬骨。',
  }
},
[969] = {
  {
    'Que a sorte esteja contigo‡Да пребудет с тобой удача!‡Das Glück sei mit Euch‡행운이 함께하기를‡Que la suerte sea contigo‡Que la suerte sea contigo‡Que la chance soit avec vous‡祝你好运‡祝妳好運',
    nil,
    'Colete 10 Lascas de Friomalho para Mandingueira Mau\'ari, em Visteterna.‡Соберите 10 кристаллов великанов Ледяного Молота для знахарки Мау\'ари из Круговзора.‡Sammelt 10 Frosthagelsplitter für die Hexendoktorin Mau\'ari in Everlook.‡눈망루 마을의 의술사 마우아리에게 서리망치거인조각 10개를 가져가야 합니다.‡Recoge 10 esquirlas de machacahielo para la médica bruja Mau\'ari en Vista Eterna.‡Recoge 10 esquirlas de machacahielo para la médica bruja Mau\'ari en Vista Eterna.‡Collecter 10 Eclats cognegivre pour le sorcier-docteur Mau\'ari à Long-guet.‡收集10块霜槌碎片，把它们交给永望镇的巫医玛艾里。‡收集10塊霜槌碎片，把它們交給永望鎮的巫醫瑪艾裏。',
  }
},
[970] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Colete uma Gema Anímica Faiscante e fale novamente com Dinis, o Purificador, no Entreposto de Maestra.‡Добудьте светящийся самоцвет Души и вернитесь к Делгрену Очистителю на заставу Мейстры.‡Beschafft einen leuchtenden Seelenedelstein und bringt ihn Delgren dem Läuterer in Maestras Posten.‡빛나는 영혼의 보석을 모아 마에스트라 주둔지에 있는 수호자 델그렌에게 가져가야 합니다.‡Reúne una gema de alma brillante y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Reúne una gema de alma resplandeciente y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Trouver une Gemme d\'âme luminescente et la rapporter à Delgren le Purificateur au poste de Maestra.‡搜集一枚发光的灵魂宝石，并把它交给迈斯特拉岗哨的净化者德尔格伦。‡搜集壹枚發光的靈魂寶石，並把它交給邁斯特拉崗哨的凈化者德爾格倫。',
  }
},
[971] = {
  {
    'Conhecimento nas Profundezas‡Знание в пучине‡Wissen in der Tiefe‡심연의 지식‡El conocimiento de las profundidades‡Conocimiento en las Cavernas‡La connaissance des profondeurs‡深渊中的知识‡深淵中的知識',
    nil,
    'Leve o Manuscrito de Lorgalis para Gerrig Agarrosso na Caverna Esquecida, em Altaforja.‡Принесите манускрипт Лоргалиса Геррику Костохвату в Заброшенный грот в Стальгорне.‡Bringt das \'Lorgalis-Manuskript\' zu Gerrig Bonegrip in Ironforge.‡아이언포지, 쓸쓸한 뒷골목에 있는 게릭 본그립에게 로르갈리스 초본을 가져가야 합니다.‡Lleva el manuscrito de Lorgalis a Gerrig Agarrahueso, que está en la Caverna Abandonada en Forjaz.‡Lleva el manuscrito de Lorgalis a Gerrig Agarrahueso en la Caverna Abandonada de Forjaz.‡Apporter le « Manuscrit de Lorgalis » à Gerrig Bonegrip à Ironforge.‡把洛迦里斯手稿带给铁炉堡的葛利·硬骨。‡把洛迦裏斯手稿帶給鐵爐堡的葛利·硬骨。',
  }
},
[972] = {
  {
    'Sapta da Água‡Сапта воды‡Wassersapta‡물의 정기‡La sapta de agua‡La sapta de agua‡Le sapta d\'eau‡水之灵契‡水之靈契',
    nil,
    nil,
  }
},
[973] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Leve o Tomo de Ilkrud Magthrull para Dinis, o Purificador, no Entreposto de Maestra.‡Принесите фолиант Илкруда Магтрулла Делгрену Очистителю на заставу Мейстры.‡Bringt Delgren dem Läuterer in Maestras Posten Ilkrud Magthrulls Folianten.‡마에스트라 주둔지에 있는 수호자 델그렌에게 일크루드 마그스룰의 마법책을 가져가야 합니다.‡Llévale el Libro de Ilkrud Magthrull a Delgren el Purificador en la Atalaya de Maestra.‡Llévale el Libro de Ilkrud Magthrull a Delgren el Purificador en la Atalaya de Maestra.‡Apporter le Tome d\'Ilkrud Magthrull à Delgren le Purificateur au Poste de Maestra.‡把伊克鲁德·玛格苏尔之书交给迈斯特拉岗哨的净化者德尔格伦。‡把伊克魯德·瑪格蘇爾之書交給邁斯特拉崗哨的凈化者德爾格倫。',
  }
},
[974] = {
  {
    'Morno... morno... quente!‡Найти источник‡Die Quelle finden‡앗! 뜨거!‡Busca la fuente‡Busca la fuente‡À la recherche de la source‡究根问底‡究根問底',
    nil,
    'Gualter, na Cratera Un\'Goro, quer que você encontre a área mais quente do Pico Penacho de Fogo.|nAo se deparar com um ponto de calor, clique com o botão direito no termômetro para medir a temperatura. Procure até encontrar o mais quente de todos.‡Выясните, где находится точка самой высокой температуры на Вулкане Огненного Венца, по просьбе Кракла из Кратера Ун\'Горо.|nДля измерения температуры щелкните по термометру правой кнопкой мыши. Проверяйте все жаркие точки, пока не будет обнаружена точка с самой высокой температурой.‡Krakle im Un\'Goro Krater möchte, dass Ihr den heißesten Bereich des Feuerfedergrats findet.|nImmer, wenn Ihr eine heiße Stelle findet, klickt Ihr das Thermometer mit der rechten Maustaste an, um die Temperatur zu überprüfen. Sucht, bis Ihr die heißeste Stelle gefunden habt.‡운고로 분화구에 있는 크래클이 불기둥 마루에서 가장 뜨거운 자리를 찾도록 요청했습니다.|n뜨거운 열점을 찾을 때마다 온도계측장치를 오른쪽 클릭해 온도를 재십시오. 가장 뜨거운 열점을 찾을 때까지 계속 재야 합니다.‡Krakle, en el Cráter de Un\'Goro, quiere que encuentres la zona más caliente de la Cresta del Penacho en Llamas.|nSiempre que des con una zona caliente, pulsa con el botón derecho sobre el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el punto más caliente.‡Krakle, en el Cráter de Un\'Goro, quiere que encuentres la zona más caliente de la Cresta del Penacho en Llamas.|nSiempre que des con un punto caliente, pulsa con el botón derecho sobre el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el punto más caliente.‡Découvrir la zone la plus chaude de la crête de la Fournaise, pour Krakle, au cratère d\'Un\'Goro.|nQuand vous trouvez une zone de chaleur, cliquez avec le bouton droit de la souris sur le thermomètre afin de prendre la température. Continuez vos recherches jusqu’à avoir trouvé la zone la plus chaude.‡安戈洛尔环形山的克拉兰克要你去找到火羽山中温度最高的地方。|n当你找到一个看上去很热的地方时，就右键点击温度计来测量当地的温度。不断尝试，直到你找到温度最高的地方。‡安戈洛爾環形山的克拉蘭克要妳去找到火羽山中溫度最高的地方。|n當妳找到壹個看上去很熱的地方時，就右鍵點擊溫度計來測量當地的溫度。不斷嘗試，直到妳找到溫度最高的地方。',
  }
},
[975] = {
  {
    'Provisões de Mau\'ari‡Сокровище Мау\'ари‡Behälter von Mau\'ari‡마우아리의 부적‡Alijo de Mau\'ari‡Alijo de Mau\'ari‡Cache de Mau\'ari‡玛艾里的容器‡瑪艾裏的容器',
    nil,
    'Fale novamente com a Mandingueira Mau\'ari em alguns instantes para receber o patuá da sorte.‡Еще раз поговорите со знахаркой Мау\'ари через минуту, чтобы получить счастливый оберег.‡Wartet einen Moment und sprecht dann erneut mit Hexendoktorin Mau\'ari, um den Glücksbringer zu erhalten.‡행운의 부적을 얻기 위해 다시 한번 의술사 마우아리에게 말을 걸어야 합니다.‡Vuelve a hablar en un momento con la médico bruja Mau\'ari para recibir el talismán de la suerte.‡Vuelve a hablar en un momento con la médica bruja Mau\'ari para recibir el talismán de la suerte.‡Attendre un instant, puis reparler au sorcier-docteur Mau\'ari pour recevoir le Charme de chance.‡与巫医玛艾里再次谈话，然后拿到好运符。‡與巫醫瑪艾裏再次談話，然後拿到好運符。',
  }
},
[976] = {
  {
    'Suprimentos para Auberdine‡Поставка для Аубердина‡Nachschub für Auberdine‡아우버다인으로의 보급품‡Suministros a Auberdine‡Suministros a Auberdine‡De l’approvisionnement pour Auberdine‡奥伯丁的补给品‡奧伯丁的補給品',
    nil,
    'Fale com Dinis, o Purificador, no Entreposto de Maestra, após escoltar Firo pela Floresta do Vale Gris.‡Поговорите с Делгреном Очистителем на заставе Мейстры после того, как проводите Фиро через Ясеневый лес.‡Sprecht mit Delgren dem Läuterer bei Maestras Posten, nachdem Ihr Feero sicher durch Ashenvale geführt habt.‡피로가 안전하게 잿빛 골짜기를 통과하도록 경호한 뒤 마에스트라 주둔지에 있는 수호자 델그렌과 대화하십시오.‡Habla con Delgren el Purificador en la Atalaya de Maestra después ayudar a Feero a cruzar el Bosque de Vallefresno y dejarlo a buen recaudo.‡Habla con Delgren el Purificador en la Atalaya de Maestra después ayudar a Feero a cruzar el Bosque de Vallefresno y dejarlo a buen recaudo.‡Parler à Delgren le Purificateur, au Poste de Maestra, après avoir escorté Feero à travers la Forêt d\'Ashenvale.‡护送费罗·艾隆汉安全地穿越灰谷森林，然后和迈斯特拉岗哨的净化者德尔格伦谈一谈。‡護送費羅·艾隆漢安全地穿越灰谷森林，然後和邁斯特拉崗哨的凈化者德爾格倫談壹談。',
  }
},
[977] = {
  {
    'Eu yeti falar uma coisa...‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡Yeti... ¿ya hemos llegado?‡Yeti... ¿ya hemos llegado?‡Yéti ? Y es-tu ?‡雪怪计划！‡雪怪計劃！',
    nil,
    'Colete 2 Chifres Impolutos de Yeti para Umi Zombarruga em Visteterna.‡Добудьте 2 безупречных рога Йети для Юми Румпельшникер из Круговзора.‡Sammelt 2 makellose Yetihörner für Umi Rumplesnicker in Everlook.‡눈망루 마을에 있는 우미 럼플스니커에게 온전한 설인 뿔 2개를 가져가야 합니다.‡Reúne 2 cuernos prístinos de yeti para Umi Risitas en Vista Eterna.‡Reúne 2 cuernos prístinos de yeti para Umi Risitas en Vista Eterna.‡Collecter 2 Cornes de yéti en parfait état pour Umi Rumplesnicker, à Long-guet‡为永望镇的乌米收集2支完美的雪人角。‡為永望鎮的烏米收集2支完美的雪人角。',
  }
},
[978] = {
  {
    'Coruscantes Lunamarca‡Осененные луной дикие совухи‡Mondbestrahltes Wildekin‡달빛의 올빼미야수‡Lechúcico Lunadón‡Lechúcico Lunadón‡Les Indomptables lunaires‡月光羽毛‡月光羽毛',
    nil,
    'Colete 10 Penas Lunamarca de Hibérnia, depois fale novamente com Erelas Ambarcéu, na Vila de Rut\'theran.‡Соберите в Зимних Ключах 10 светолунных перьев, принести их Эреласу Янтарному Небу в деревню Рут\'теран.‡Sammelt 10 mondbestrahlte Federn aus Winterspring und kehrt dann zu Erelas Ambersky in Rut\'theran zurück.‡여명의 설원에서 달빛 깃든 깃털을 10개 모아서 루테란 마을의 에릴라스 엠버스카이에게 가져와야 합니다.‡Recoge 10 plumas Lunadón de Cuna del Invierno y regresa con Eralas Cieloámbar en Aldea Rut\'theran.‡Recoge 10 plumas Lunadón de Cuna del Invierno y regresa con Erelas Cieloámbar en Aldea Rut\'theran.‡Collecter 10 Plumes de Chouettard lunaire, dans le Berceau-de-l\'Hiver, puis retourner voir Erelas Ambersky, à Rut\'theran.‡从冬泉谷收集10片月光羽毛，然后将它们带给鲁瑟兰村的艾瑞拉斯·琥珀。‡從冬泉谷收集10片月光羽毛，然後將它們帶給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[979] = {
  {
    'Encontrando Ranshalla‡В поисках Раншаллы‡Ranshalla suchen‡란샬라 찾기‡Encuentra a Ranshalla‡Encuentra a Ranshalla‡Trouver Ranshalla‡兰莎尔拉‡蘭莎爾拉',
    nil,
    'Encontre Ranshalla em Hibérnia oriental.‡Найдите Раншаллу в восточной части Зимних Ключей.‡Sucht nach Ranshalla im östlichen Winterspring.‡여명의 설원 동부에 있는 란샬라를 찾아야 합니다.‡Encuentra a Ranshalla en la zona oriental de Cuna del Invierno.‡Encuentra a Ranshalla en la zona oriental de Cuna del Invierno.‡Trouver Ranshalla dans l’est du Berceau-de-l\'Hiver.‡在冬泉谷找到兰莎尔拉。‡在冬泉谷找到蘭莎爾拉。',
  }
},
[980] = {
  {
    'As novas fontes‡Новые источники‡Die neuen Quellen‡새로운 온천‡Nuevos manantiales‡Nuevos manantiales‡Les nouvelles sources‡新的泉水‡新的泉水',
    nil,
    'Vá a Hibérnia e fale com Bruna Covaneve.‡Отправьтесь в Зимние Ключи и побеседуйте с Доновой Снегонорой.‡Reist nach Winterspring und sprecht mit Donova Snowden.‡여명의 설원으로 가서 도노바 스노우덴과 대화하십시오.‡Viaja hasta Cuna del Invierno y habla con Donova Cubilnevado.‡Viaja hasta Cuna del Invierno y habla con Donova Cubilnevado.‡Se rendre au Berceau-de-l\'Hiver et parler à Donova Snowden.‡到冬泉谷去和多诺瓦·雪山谈一谈。‡到冬泉谷去和多諾瓦·雪山談壹談。',
  }
},
[981] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Fale com Dinis, o Purificador, no Entreposto de Maestra.‡Поговорите с Делгреном Очистителем на Заставе Мейстры.‡Sprecht mit Delgren dem Läuterer in Maestras Posten.‡마에스트라 주둔지에 있는 수호자 델그렌과 대화하십시오.‡Habla con Delgren el Purificador en la Atalaya de Maestra.‡Habla con Delgren el Purificador en la Atalaya de Maestra.‡Aller voir Delgren le Purificateur au Poste de Maestra.‡和迈斯特拉岗哨的净化者德尔格伦谈一谈。‡和邁斯特拉崗哨的凈化者德爾格倫談壹談。',
  }
},
[982] = {
  {
    'Nas profundezas do mar‡Безбрежное море, глубокий океан‡Tiefer Ozean, weites Meer‡깊고 푸른 바다‡Profundo océano, mar inmenso‡Profundo océano, mar inmenso‡Océan profond, mer immense‡深不可测的海洋‡深不可測的海洋',
    nil,
    'Recupere o Baú do Aurora de Prata e o Baú do Véu das Brumas para Gorbold Manácero em Auberdine. Os dois itens podem ser encontrados nos destroços dos navios, a norte da vila.‡Добудьте денежный ящик "Серебряной Зари" и денежный ящик "Туманной Пелены" для Горбольда Стальной Руки в Аубердине. Оба предмета можно найти в останках потерпевших крушение кораблей к северу от деревни.‡Beschafft die Schließkassette der SILBERMORGEN und die Schließkassette der NEBELSCHLEIER für Gorbold Steelhand in Auberdine. Beide Gegenstände findet Ihr an Bord der Schiffswracks nördlich des Dorfes.‡아우버다인에 있는 골볼트 스틸핸드에게 은빛 새벽호의 금고와 안개 장막호의 금고를 가져가야 합니다. 모두 마을의 북쪽에 있는 난파선에서 찾을 수 있을 것입니다.‡Recupera la caja fuerte del Amanecer de plata y la caja fuerte del Halo de bruma para Gorbold Mano de Acero de Auberdine. Ambos objetos deberían estar en los cascos de los navíos naufragados al norte de la aldea.‡Recupera el arcón del Amanecer de Plata y la caja fuerte del Halo de Bruma para Gorbold Mano de Acero de Auberdine. Ambos objetos deberían estar en los cascos de los navíos naufragados al norte de la aldea.‡Récupérer le Coffret de l’Aube argentée et le Coffret du Voile de brume, pour Gorbold Steelhand, à Auberdine. Ces deux objets se trouvent à bord des épaves des navires respectifs, au nord du village.‡找到银色清晨号的保险箱和迷雾之纱号的保险箱，把它们交给奥伯丁的高尔博德·钢手。你可以在村庄北部遇难的船只里找到这两只箱子。‡找到銀色清晨號的保險箱和迷霧之紗號的保險箱，把它們交給奧伯丁的高爾博德·鋼手。妳可以在村莊北部遇難的船只裏找到這兩只箱子。',
  }
},
[983] = {
  {
    'Caixazorra 827‡Жужжалка 827‡Dröhnkiste 827‡버즈박스 827‡La caja mecánica 827‡La caja mecánica 827‡Bigobox 827‡传声盒827号‡傳聲盒827號',
    nil,
    'Colete 6 Patas de Rastejante e coloque-as na Caixazorra 827.‡Добудьте 6 ножек крабов и поместите их в Жужжалку 827.‡Sammelt 6 Kriecherbeine und baut sie in Dröhnkiste 827 ein.‡집게다리 6개를 모아 버즈박스 827에 넣어야 합니다.‡Reúne 6 piernas de reptador y colócalas en la caja mecánica 827.‡Reúne 6 patas de reptador y colócalas en la caja mecánica 827.‡Réunir 6 Pattes de clampants et les mettre dans la bigobox 827.‡收集6只蟹腿，把它们放进传声盒827号。‡收集6只蟹腿，把它們放進傳聲盒827號。',
  }
},
[984] = {
  {
    'Uma grande ameaça?‡Насколько велика угроза?‡Wie groß ist die Bedrohung?‡거대한 위협‡La extensión de la amenaza‡La extensión de la amenaza‡Quelle est l\'ampleur de la menace ?‡熊怪的威胁‡熊怪的威脅',
    nil,
    'Encontre um acampamento de pelursos corrompidos na Costa Negra e fale novamente com Terenthis em Auberdine.‡Найдите оскверненный лагерь фурболгов на Темном Берегу и вернитесь к Терентису в Аубердин.‡Sucht in Dunkelküste nach einem verderbten Furbolglager und kehrt dann zu Terenthis in Auberdine zurück.‡어둠의 해안에서 오염된 펄볼그 야영지를 찾은 다음 아우버다인에 있는 테렌디스에게 돌아가십시오.‡Encuentra el campamento de furbolgs corruptos en Costa Oscura, vuelve a Auberdine y busca a Terenthis.‡Encuentra el campamento de fúrbolgs corruptos en Costa Oscura, vuelve a Auberdine y busca a Terenthis.‡Trouver un camp de furbolgs corrompus à Sombrivage et retourner voir Terenthis dans Auberdine.‡在黑海岸找到一处堕落熊怪的营地，然后向奥伯丁的特伦希斯报告。‡在黑海岸找到壹處墮落熊怪的營地，然後向奧伯丁的特倫希斯報告。',
  }
},
[985] = {
  {
    'Uma grande ameaça‡Насколько велика угроза?‡Wie groß ist die Bedrohung?‡거대한 위협‡La extensión de la amenaza‡La extensión de la amenaza‡Quelle est l\'ampleur de la menace ?‡熊怪的威胁‡熊怪的威脅',
    nil,
    'Mate 8 Desbravadores Bosquenero e 5 Vozes-do-vento, depois fale novamente com Terenthis, em Auberdine.‡Убейте 8 следопытов и 5 заклинателей ветра из клана Чернолесья, а затем вернитесь к Терентису в Аубердин.‡Tötet 8 Pfadfinder der Schwarzfelle und 5 Windsprecher und kehrt dann zu Terenthis in Auberdine zurück.‡검은나무일족 길잡이 8마리와 풍수사 5마리를 처치한 다음 아우버다인에 있는 테렌디스에게 돌아가십시오.‡Mata a 5 soplavientos y a 8 abrecaminos Bosque Negro y vuelve a Auberdine a buscar a Terenthis.‡Mata a 5 soplavientos y a 8 abrecaminos Bosque Negro y vuelve a Auberdine a buscar a Terenthis.‡Tuer 8 Guides et 5 Messagers du vent Noirbois puis retourner voir Terenthis à Auberdine.‡杀掉8个黑木探路者和5个黑木风语者，然后回到奥伯丁向特伦希斯汇报。‡殺掉8個黑木探路者和5個黑木風語者，然後回到奧伯丁向特倫希斯匯報。',
  }
},
[986] = {
  {
    'Um mestre perdido‡Пропавший хозяин‡Ein verirrter Meister‡사라진 주인‡El maestro perdido‡El maestro perdido‡Un maître perdu‡丢失的主人‡丟失的主人',
    nil,
    'Encontre 5 Pelagens de Espreitaluna Finas e leve-as para Terenthis, em Auberdine.‡Найдите 5 прекрасных шкур лунопарда и принесите их Терентису в Аубердин.‡Sucht 5 feine Mondpirscherpelze und bringt sie Terenthis in Auberdine.‡고급 달표범 모피 5필을 찾아 아우버다인에 있는 테렌디스에게 가져가야 합니다.‡Encuentra 5 pieles de Acechalunas y llévaselas a Terenthis a Auberdine.‡Encuentra 5 pelambres de Acechalunas refinadas y llévaselas a Terenthis a Auberdine.‡Trouver 5 Belles peaux de traquelune et les apporter à Terenthis, à Auberdine.‡收集5张优质月夜猛虎毛皮，把它们交给奥伯丁的特伦希斯。‡收集5張優質月夜猛虎毛皮，把它們交給奧伯丁的特倫希斯。',
  }
},
[990] = {
  {
    'Viagem ao Vale Gris‡Путь в Ясеневый лес‡Marsch nach Ashenvale‡잿빛 골짜기로의 여정‡El camino de Vallefresno‡El camino de Vallefresno‡Voyage vers Ashenvale‡灰谷之旅‡灰谷之旅',
    nil,
    'Encontre Raene Correlobos, no Vale Gris.‡Найдите в Ясеневом лесу Раэну Волкопас.‡Sucht Raene Wolfrunner in Ashenvale auf.‡잿빛 골짜기에 있는 레이네 울프러너를 찾아가야 합니다.‡Encuentra a Raene Correlobo en Vallefresno.‡Encuentra a Raene Correlobo en Vallefresno.‡Trouver Raene Wolfrunner dans Ashenvale.‡在灰谷中找到莱恩·狼行者。‡在灰谷中找到萊恩·狼行者。',
  }
},
[991] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Procure Teronis no Vale Gris.‡Найдите в Ясеневом лесу Терониса.‡Sucht in Ashenvale nach Teronis.‡잿빛 골짜기에서 테로니스를 찾아야 합니다.‡Encuentra a Teronis en Vallefresno.‡Busca a Teronis en Vallefresno.‡Trouver Teronis dans Ashenvale.‡在灰谷找到泰洛尼斯。‡在灰谷找到泰洛尼斯。',
  }
},
[992] = {
  {
    'Levantamento das águas de Geringontzan‡Исследование воды‡Gadgetzan Wassersondierung‡가젯잔 수자원 측량‡Un estudio de agua de Gadgetzan‡Un estudio de agua de Gadgetzan‡Étude des eaux de Gadgetzan‡加基森水业公司‡加基森水業公司',
    nil,
    'Use o treco de coleta vazio junto à poça d\'água perto do Posto Silitriste. Depois que você coletar a amostra, leve o treco de coleta cheio para o Topógrafo Sênior Secamolha em Geringontzan.‡Воспользуйтесь нетронутым устройством для поиска воды возле пруда на Заставе Скорбных Песков. Забрав пробу, отнесите устройство старшему геодезисту Рудознатцу в Прибамбасск.‡Benutzt den unangezapften Wünschelrutenapparat in der Nähe des Teichs bei der Sandsorrow-Wache. Bringt den angezapften Wünschelrutenapparat zum Leitenden Feldmesser Fizzledowser nach Gadgetzan zurück, wenn Ihr die Probe entnommen habt.‡슬픈모래 감시탑의 물 웅덩이 부근에서 추출 전의 탐사장치를 사용하십시오. 다 채웠으면 가젯잔에 있는 선임측량사 피즐도저에게 추출한 탐사장치를 가져가야 합니다.‡Utiliza la pipeta de muestras abierta en la poza de agua de Vigía Penas de Arena. Cuando hayas recogido la muestra, llévale la pipeta de muestras cerrada al perito jefe Picoflojo, que está en Gadgetzan.‡Utiliza la pipeta de muestras abierta en la poza de agua de Vigía Penas de Arena. Cuando hayas recogido la muestra, llévale la pipeta de muestras cerrada al perito jefe Picoflojo, que está en Gadgetzan.‡Utiliser la Fiole de sourcier vide à la mare près du Guet de Tristesable. Une fois l\'échantillon récolté, remettre la Fiole de sourcier pleine au grand géomètre Fizzledowser à Gadgetzan.‡用未使用的寻水器在流沙岗哨旁边的池中采集水样。一旦你收集到水样，就尽快将其交给加基森的高级勘探员菲兹杜瑟。‡用未使用的尋水器在流沙崗哨旁邊的池中采集水樣。壹旦妳收集到水樣，就盡快將其交給加基森的高級勘探員菲茲杜瑟。',
  }
},
[993] = {
  {
    'Um mestre perdido‡Пропавший хозяин‡Ein verirrter Meister‡사라진 주인‡El maestro perdido‡El maestro perdido‡Un maître perdu‡丢失的主人‡丟失的主人',
    nil,
    'Encontre Volcor na Costa Negra e entregue a ele o Manto Encantado de Espreitaluna.‡Найдите Волкора на Темных берегах и отдайте ему зачарованный плащ лунопарда.‡Sucht Volcor in Dunkelküste und gebt ihm den verzauberten Mondpirscherumhang.‡어둠의 해안에 있는 볼코르를 찾아서 마법 달표범 망토를 주어야 합니다.‡Encuentra a Volcor en Costa Oscura y dale la capa de Acechalunas encantada.‡Encuentra a Volcor en Costa Oscura y dale la capa de Acechalunas encantada.‡Trouver Volcor, à Sombrivage, et lui donner la Cape enchantée de traquelune.‡找到沃科尔。‡找到沃科爾。',
  }
},
[994] = {
  {
    'Fuga difícil‡Спасение с помощью силы‡Flucht durch Gewalt‡무력 탈출‡Escaparse por la fuerza‡Escaparse por la fuerza‡Évasion par la force‡杀出重围‡殺出重圍',
    nil,
    'Proteja Volcor até vocês alcançarem a estrada, então fale com Terenthis em Auberdine.‡Защищайте Волкора, пока не доберетесь до дороги, а затем поговорите с Терентисом в Аубердине.‡Beschützt Volcor, bis Ihr die Straße erreicht habt und sprecht dann mit Terenthis in Auberdine.‡길에 이를 때까지 볼코르를 보호한 다음 아우버다인에 있는 테렌디스와 대화하십시오.‡Protege a Volcor hasta que lleguéis al camino y luego ve a Auberdine a hablar con Terenthis.‡Protege a Volcor hasta que lleguéis al camino y luego ve a Auberdine a hablar con Terenthis.‡Protéger Volcor jusqu\'à la route puis aller voir Terenthis à Auberdine.‡保护沃科尔离开，然后去和奥伯丁的特伦希斯谈一谈。‡保護沃科爾離開，然後去和奧伯丁的特倫希斯談壹談。',
  }
},
[995] = {
  {
    'Fuga furtiva‡Спасение с помощью скрытности‡Flucht durch Verstohlenheit‡은밀한 탈출‡Escaparse furtivamente‡Escaparse furtivamente‡Évasion par la ruse‡偷偷溜走‡偷偷溜走',
    nil,
    'Fuja da caverna do Pelurso e encontre Terenthis em Auberdine.‡Совершите побег из пещеры фурболгов и встретьтесь в Аубердине с Терентисом.‡Flieht aus der Furbolghöhle und trefft Euch in Auberdine mit Terenthis.‡펄볼그 동굴을 탈출한 다음 아우버다인에 있는 테렌디스를 만나십시오.‡Escapa de la cueva fúrbolg y reúnete con Terenthis en Auberdine.‡Escapa de la cueva fúrbolg y reúnete con Terenthis en Auberdine.‡S\'échapper de la grotte des furbolgs et aller voir Terenthis à Auberdine.‡离开熊怪洞穴，然后去见奥伯丁的特伦希斯。‡離開熊怪洞穴，然後去見奧伯丁的特倫希斯。',
  }
},
[996] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    nil,
  }
},
[997] = {
  {
    'A terra de Denalan‡Земля Деналана‡Denalans Erde‡데날란의 흙‡Las tierras de Denalan‡Las tierras de Denalan‡La terre de Denalan‡德纳兰的泥土‡德納蘭的泥土',
    nil,
    'Leve o pacote de Terra Rara para Denalan no Lago Al\'Ameth.‡Отнесите горсть редкой земли Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee das Gebinde rarer Erde.‡알아메스 호수에 있는 데날란에게 귀한 흙을 가져가야 합니다.‡Llévale el paquete con tierras especiales a Denalan, que está en el Lago Al\'Ameth.‡Llévale el paquete con tierras raras a Denalan, que está en el Lago Al\'Ameth.‡Rapporter le paquet de Terre rare à Denalan au lac Al\'Ameth.‡把稀土交给奥拉密斯湖畔的德纳兰。‡把稀土交給奧拉密斯湖畔的德納蘭。',
  }
},
[998] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    nil,
  }
},
[1000] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Platô dos Anciãos, no Penhasco do Trovão, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Обратитесь к верховному друиду Хамуулу Руническому Тотему на Вершине Старейшин Громового Утеса по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht auf der Anhöhe der Ältesten in Thunder Bluff mit dem Erzdruiden Hamuul Runetotem über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡썬더 블러프의 장로의 봉우리에 있는 대드루이드 하뮬 룬토템을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대해 얘기를 나눠야 합니다.‡Habla con el archidruida Hamuul Runatótem en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Hamuul Runetotem, sur la Cime des Anciens de Thunder Bluff. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与雷霆崖长者高地的大德鲁伊哈缪尔·符文图腾谈一谈关于议会号召部落成员探索卡利姆多大陆的事情。‡與雷霆崖長者高地的大德魯伊哈繆爾·符文圖騰談壹談關於議會號召部落成員探索卡利姆多大陸的事情。',
  }
},
[1001] = {
  {
    'Caixazorra 411‡Жужжалка 411‡Dröhnkiste 411‡버즈박스 411‡La caja mecánica 411‡La caja mecánica 411‡Bigobox 411‡传声盒411号‡傳聲盒411號',
    nil,
    'Recolha 3 Olhos de Mangual dos Manguais da Costa Negra no fundo do mar, perto da Caixazorra 411.‡Добудьте 3 глаза крепкозуба с крепкозубов Темного Берега, которые водятся в море неподалеку от Жужжалки 411.‡Besorgt Euch 3 Drescheraugen von den Dunkelküstendreschern im tiefen Meer in der Nähe der Dröhnkiste 411.‡버즈박스 411 근처 깊은 바다에 있는 어둠의해안 트레샤돈에게서 트레샤돈의 눈 3개를 모아야 합니다.‡Consigue 3 ojos de trillador de los trilladores de Costa Oscura en las profundidades del mar, cerca de la caja mecánica 411.‡Consigue 3 ojos de trillador de los trilladores de Costa Oscura en las profundidades del mar, cerca de la caja mecánica 411.‡Rassembler 3 Yeux de batteur de Sombrivage au fond de la mer, près de la bigobox 411.‡从位于传声盒411号附近的深海中收集3颗黑海岸蛇颈龙的眼球。‡從位於傳聲盒411號附近的深海中收集3顆黑海岸蛇頸龍的眼球。',
  }
},
[1002] = {
  {
    'Caixazorra 323‡Жужжалка 323‡Dröhnkiste 323‡버즈박스 323‡La caja mecánica 323‡La caja mecánica 323‡Bigobox 323‡传声盒323号‡傳聲盒323號',
    nil,
    'Recolha 6 Presas de Espreitaluna e deposite-as na Caixazorra 323.‡Добудьте 6 клыков лунупарда и поместите их в Жужжалку 323.‡Sammelt 6 Mondpirscherfangzähne und baut sie in Dröhnkiste 323 ein.‡달표범 송곳니 6개를 모아 버즈박스 323에 넣어야 합니다.‡Reúne 6 colmillos de Acechalunas y colócalos en la caja mecánica 323.‡Reúne 6 colmillos de Acechalunas y colócalos en la caja mecánica 323.‡Trouver 6 Crocs de traquelune et les mettre dans la bigobox 323.‡收集6颗月夜猛虎的牙齿，把它们放进传声盒323号。‡收集6顆月夜猛虎的牙齒，把它們放進傳聲盒323號。',
  }
},
[1003] = {
  {
    'Caixazorra 525‡Жужжалка 525‡Dröhnkiste 525‡버즈박스 525‡La caja mecánica 525‡La caja mecánica 525‡Bigobox 525‡传声盒525号‡傳聲盒525號',
    nil,
    'Recolha 4 Escalpos Grisalhos dos Ursocardos Grisalhos ao sul de Auberdine e deposite-os na Caixazorra 525.‡Соберите 4 седых скальпа с седых колючешерстных медведей к югу от Аубердина и положите их в Жужжалку 525.‡Sammelt 4 ergraute Skalps von ergrauten Distelbären südlich von Auberdine und legt sie in die Dröhnkiste 525.‡아우버다인 남쪽에 있는 엉겅퀴불곰에게서 불곰 가죽 4개를 모아 버즈박스 525에 집어넣어야 합니다.‡Consigue 4 pellejos canosos de los grisosos cardo del sur de Auberdine y colócalos en la caja mecánica 525.‡Consigue 4 cueros cabelludos grisáceos de los osos cardo grisáceos del sur de Auberdine y colócalos en la caja mecánica 525.‡Se procurer 4 Scalps vieillis sur de Vieux ours des chardons au sud d\'Auberdine et les placer dans la Bigobox 525.‡收集4块灰色头皮，然后把它们放在传声盒525号中。‡收集4塊灰色頭皮，然後把它們放在傳聲盒525號中。',
  }
},
[1004] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Platô dos Anciãos, no Penhasco do Trovão, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Вершине Старейшин Громового Утеса об исследовании пограничья Калимдора.‡Sprecht auf der Anhöhe der Ältesten in Thunder Bluff mit dem Erzdruiden Hamuul Runetotem über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡썬더 블러프, 장로의 봉우리에 있는 대드루이드 하뮬 룬토템을 찾아가 세나리온 의회의 칼림도어 개척 지원자 모집에 대한 얘기를 나눠야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Hamuul Runetotem, sur la Cime des Anciens de Thunder Bluff. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与雷霆崖长者高地的大德鲁伊哈缪尔·符文图腾谈一谈关于议会号召部落成员探索卡利姆多大陆的事情。‡與雷霆崖長者高地的大德魯伊哈繆爾·符文圖騰談壹談關於議會號召部落成員探索卡利姆多大陸的事情。',
  }
},
[1007] = {
  {
    'A estatueta ancestral‡Древняя статуэтка‡Die antike Statuette‡고대 조각상‡La antigua estatuilla‡La estatuilla antigua‡L\'ancienne statuette‡远古雕像‡遠古雕像',
    nil,
    'Leve a Estatueta Ancestral para Talen, no acampamento perto da Praia de Zoram.‡Принесите древнюю статуэтку Талену в его лагерь близ Зорамского взморья.‡Bringt Talen im Lager in der Nähe des Zoramstrands die antike Statuette.‡조람 해안 근처에서 야영하고 있는 탈렌에게 고대 조각상을 가져가야 합니다.‡Llévale la antigua estatuilla a Talen, en su campamento cerca de La Ensenada de Zoram.‡Lleva la estatuilla antigua a Talen en su campamento cerca de la Ensenada de Zoram.‡Apporter l\'Ancienne Statuette à Talen, dans son camp près de la grève de Zoram.‡把远古雕像交给塔尔伦，他的营地就在佐拉姆海岸附近。‡把遠古雕像交給塔爾倫，他的營地就在佐拉姆海岸附近。',
  }
},
[1008] = {
  {
    'Praia de Zoram‡Зорамское взморье‡Der Zoramstrand‡조람 해안‡La Ensenada de Zoram‡La Ensenada de Zoram‡La grève de Zoram‡佐拉姆海岸‡佐拉姆海岸',
    nil,
    'Entregue 20 Cabeças de Iracauda para Shindrell Fogofugaz em Astranaar.‡Принесите 20 голов наг из клана Зловещего Хвоста Шиндрелл Огненный Всполох в Астранаар.‡Bringt Shindrell Swiftfire in Astranaar 20 Köpfe von Rächerflossen.‡아스트라나르에 있는 신드렐 스위프트파이어에게 성난지느러미일족의 머리 20개를 가져가야 합니다.‡Llévale 20 cabezas de Colafuria a Shindrell Fuegoveloz en Astranaar.‡Llévale 20 cabezas de Colafuria a Shindrell Fuegoveloz en Astranaar.‡Apporter 20 Têtes d\'Irequeue à Shindrell Swiftfire, à Astranaar.‡收集20颗怒尾纳迦的头颅，把它们交给阿斯特兰纳的辛德瑞尔。‡收集20顆怒尾納迦的頭顱，把它們交給阿斯特蘭納的辛德瑞爾。',
  }
},
[1009] = {
  {
    'Ruuzel‡Руузель‡Ruuzel‡루젤‡Ruuzel‡Ruuzel‡Ruuzel‡卢泽尔‡盧澤爾',
    nil,
    'Leve o Anel de Zoram para Talen, perto da Praia de Zoram.‡Принесите кольцо Зорама Талену на Зорамское взморье.‡Bringt Talen im Lager in der Nähe des Zoramstrands den Ring von Zoram.‡조람 해안 근처에 있는 탈렌에게 조람의 반지를 가져가야 합니다.‡Llévale el Anillo de Zoram a Talen, cerca de La Ensenada de Zoram.‡Lleva el anillo de Zoram a Talen cerca de la Ensenada de Zoram.‡Apporter l\'Anneau de Zoram à Talen près de la grève de Zoram.‡找到佐拉姆之戒，把它交给佐拉姆海岸边的塔尔伦。‡找到佐拉姆之戒，把它交給佐拉姆海岸邊的塔爾倫。',
  }
},
[1010] = {
  {
    'Cabelo-de-bathran‡Батранов волос‡Bathranshaar‡배스랜초‡Cabello de Bathran‡Cabello de Bathran‡Les Cheveux de Bathran‡巴斯兰的头发‡巴斯蘭的頭發',
    nil,
    'Leve 5 Cabelos-de-bathran para Orendil Folharga no Vale Gris.‡Принесите 5 стеблей Батранова волоса Орендилу Широколисту в Ясеневый лес.‡Bringt Orendil Broadleaf in Ashenvale 5 Bathranshaar-Pflanzen.‡잿빛 골짜기에 있는 오렌딜 브로드리프에게 배스랜초 5개를 가져가야 합니다.‡Llévale 5 cabellos de Bathran a Orendil Hojasangre en Vallefresno.‡Consigue 8 cabellos de Bathran.‡Rapporter 5 Cheveux de Bathran à Orendil Broadleaf dans Ashenvale.‡收集5份巴斯兰的头发，把它们带给灰谷的奥雷迪尔·阔叶。‡收集5份巴斯蘭的頭發，把它們帶給灰谷的奧雷迪爾·闊葉。',
  }
},
[1011] = {
  {
    'Moléstias renegadas‡Чума Отрекшихся‡Verlassenenkrankheit‡포세이큰의 역병‡Los males de los Renegados‡Los males de los Renegados‡Les maladies des Réprouvés‡被遗忘者的病菌‡被遺忘者的病菌',
    nil,
    'Leve uma Garrafa de Moléstia para Kainet Brisacalma em Cantilenda.‡Принесите бутыль заразы Кайнету Штилю в Лесную Песнь.‡Bringt Kayneth Stillwind in Forest Song eine Krankheitsflasche.‡숲의 노래에 있는 케이네스 스틸윈드에게 역병 견본 하나를 가져가야 합니다.‡Llévale una botella de enfermedad a Kayneth Ventoleve en Canción del Bosque.‡Llévale una botella de enfermedad a Kayneth Ventoleve en Canción del Bosque.‡Apporter une Bouteille des maladies à Kayneth Stillwind au Chant des Forêts.‡找到一瓶病毒，把它交给慰藉之林中的凯尼斯·静风。‡找到壹瓶病毒，把它交給慰藉之林中的凱尼斯·靜風。',
  }
},
[1012] = {
  {
    'Druidas insanos‡Безумные друиды‡Irrsinnige Druiden‡미쳐버린 드루이드‡Druidas dementes‡Druidas dementes‡Les druides fous‡疯狂的德鲁伊‡瘋狂的德魯伊',
    nil,
    'Mate os druidas Taneel Lenhanegra, Uthil Chamaluna e Mavoris Rasganimbus. Depois fale novamente com Kainet Brisacalma em Cantilenda.‡Убейте друидов: Таниэля Темный Лес, Этиля Зов Луны и Мавориса Проблеск Солнца, затем возвращайтесь к Кайнету Штилю в Лесную Песнь.‡Tötet die Druiden Taneel Darkwood, Uthil Mooncall und Mavoris Cloudsbreak und kehrt dann zu Kayneth Stillwind in Forest Song zurück.‡드루이드 지도자인 타닐 다크우드, 우실 문콜, 마보리스 클라우즈브레이크를 처치한 다음 숲의 노래에 있는 케이네스 스틸윈드에게 돌아가십시오.‡Mata a los druidas Taneel Leñoscuro, Uthil Llamaluna y Mavoris Quiebranubes y vuelve junto a Kayneth Ventoleve en Canción del Bosque.‡Mata a los druidas Taneel Leñoscuro, Uthil Llamaluna y Mavoris Quiebranubes y regresa con Kayneth Ventoleve en Canción del Bosque.‡Tuer les druides : Taneel Darkwood, Uthil Mooncall, Mavoris Cloudsbreak ; puis retourner auprès de Kayneth Stillwind au Chant des Forêts.‡杀死这些德鲁伊：坦尼尔·黑木、尤希尔·唤月和玛沃里斯·裂云，然后向慰藉之林中的凯尼斯·静风复命。‡殺死這些德魯伊：坦尼爾·黑木、尤希爾·喚月和瑪沃裏斯·裂雲，然後向慰藉之林中的凱尼斯·靜風復命。',
  }
},
[1013] = {
  {
    'O Livro de Ur‡Книга Ура‡Das Buch von Ur‡우르의 책‡El Libro de Ur‡El Libro de Ur‡Le Livre d\'Ur‡乌尔之书‡烏爾之書',
    nil,
    'Leve o Livro de Ur para o Guardião Bel\'dugur no Boticarium da Cidade Baixa.‡Принесите книгу Ура хранителю Бел\'дугуру в Район Фармацевтов в Подгород.‡Bringt dem Bewahrer Bel\'dugur im Apothekarium in Undercity das Buch von Ur.‡언더시티의 연금술 실험실에 있는 관리인 벨두거에게 우르의 책을 가져가야 합니다.‡Lleva el Libro de Ur al guardián Bel\'dugur al Apothecarium de Entrañas.‡Lleva el Libro de Ur al vigilante Bel\'dugur al Apothecarium de Entrañas.‡Apporter le "Livre d\'Ur" au Gardien Bel\'dugur à l\'Apothicarium à Undercity.‡把乌尔之书交给幽暗城炼金区里的看守者贝尔杜加。‡把烏爾之書交給幽暗城煉金區裏的看守者貝爾杜加。',
  }
},
[1014] = {
  {
    'Arugal tem que morrer‡Смерть Аругалу!‡Arugal muss sterben‡아루갈의 최후‡Arugal debe morir‡Arugal debe morir‡Arugal doit mourir‡除掉阿鲁高‡除掉阿魯高',
    nil,
    'Mate Arugal e leve sua cabeça para Dalar Tessalba no Sepulcro.‡Убейте Аругала и принесите его голову Далару Ткачу Рассвета в Гробницу.‡Tötet Arugal und bringt Dalar Dawnweaver in dem Grabmal seinen Kopf.‡아루갈을 처치하고 그 증거로 그의 머리카락을 공동묘지에 있는 달라 던위버에게 가져가야 합니다.‡Mata a Arugal y lleva su cabeza a Dalar Tejalba en El Sepulcro.‡Mata a Arugal y lleva su cabeza a Dalar Tejealba en El Sepulcro.‡Tuer Arugal et apporter sa Tête à Dalar Dawnweaver au Sépulcre.‡杀死阿鲁高，把他的头带给瑟伯切尔的达拉尔·道恩维沃尔。‡殺死阿魯高，把他的頭帶給瑟伯切爾的達拉爾·道恩維沃爾。',
  }
},
[1015] = {
  {
    'Uma nova fronteira‡Новые границы‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом из дарнасского анклава Кенария относительно призыва Круга Кенария к изучению окраин Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Staghelm über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대한 얘기를 나눠야 합니다.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Fandral Staghelm, dans l\'Enclave cénarienne, à Darnassus. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納裏奧區的大德魯範達爾·鹿盔談壹談關於議會號召聯盟成員探索卡利姆多大陸的事情。',
  }
},
[1016] = {
  {
    'Braçadeiras Elementais‡Браслеты элементалей‡Elementararmschienen‡정령의 족쇄‡Brazales elementales‡Brazales elementales‡Les bracelets d\'élémentaire‡元素护腕‡元素護腕',
    nil,
    'Recolha 5 Braçadeiras Elementais Intactas e use o Pergaminho Divinatório nelas. Depois, leve o Pergaminho Vaticinado para a Sentinela Velene Golpestela no Refúgio Brisaprata.‡Соберите 5 неповрежденных браслетов элементалей, а затем задействуйте на них гадальный свиток. После отнесите разгаданный свиток Стражу Велене Звездный Всполох в Приют Серебряного Ветра.‡Sammelt 5 intakte Elementararmschienen und wendet die Rolle der Bestimmung darauf an. Bringt danach der Schildwache Velene Starstrike in der Silberwindzuflucht die Rolle der Bestimmung.‡온전한 정령의 족쇄 5개를 모아서 예언의 두루마리를 사용한 후, 실바람 산장에 있는 파수꾼 벨레네 스타스트라이크에게 예언된 두루마리를 가져가야 합니다.‡Reúne 5 brazales elementales intactos y aplícales el pergamino de adivinación. A continuación, llévale el pergamino adivinado a la centinela Velene Estrella en el Refugio Brisa de Plata.‡Recoge 5 brazales elementales intactos y usa el pergamino de adivinación sobre ellos. Después, llévaselo a la centinela Velene Golpe Estelar en el Refugio Brisa de Plata.‡Récolter 5 Bracelets élémentaires intacts et utiliser le Parchemin de divination sur eux. Ensuite, apporter le Parchemin de divination à la Sentinelle Velene Starstrike au Refuge de Vent-argent.‡收集5个完整的元素护腕，并对它们使用占卜卷轴。然后把使用过的占卜卷轴带给银风避难所的哨兵维尔莉妮·星坠。‡收集5個完整的元素護腕，並對它們使用占蔔卷軸。然後把使用過的占蔔卷軸帶給銀風避難所的哨兵維爾莉妮·星墜。',
  }
},
[1017] = {
  {
    'O mago evocador‡Маг-призыватель‡Magier-Beschwörer‡물의 정령 배후의 마법사‡Mago invocador‡Mago invocador‡Mage invocateur‡召唤者‡召喚者',
    nil,
    'Mate Sarilus Malnato e leve a cabeça dele para a Sentinela Velene Golpestela no Refúgio Brisaprata.‡Убейте Сарилуса Грязнорожденного и принесите его голову часовому Велене Звездный Всполох в Приют Серебряного Ветра.‡Erschlagt Sarilus Foulborne und bringt Schildwache Velene Starstrike in der Silberwindzuflucht seinen Kopf.‡사릴루스 파울본을 처치하고 그 증거로 그의 머리카락을 실바람 산장에 있는 파수꾼 벨레네 스타스트라이크에게 가져가야 합니다.‡Mata a Sarilus Fuenteviciosa y lleva su cabeza a la centinela Velene Estrella en el Refugio Brisa de Plata.‡Mata a Sarilus Fuenteviciosa y lleva su cabeza a la centinela Velene Golpe Estelar en el Refugio Brisa de Plata.‡Tuer Sarilus Foulborne et apporter sa Tête à la Sentinelle Velene Starstrike au Refuge de Vent-argent.‡干掉萨瑞鲁斯·法伯尼，把他的首级交给银风避难所的哨兵维尔莉妮·星坠。‡幹掉薩瑞魯斯·法伯尼，把他的首級交給銀風避難所的哨兵維爾莉妮·星墜。',
  }
},
[1018] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Platô dos Anciãos, no Penhasco do Trovão, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Вершине Старейшин Громового Утеса об исследовании пограничья Калимдора.‡Sprecht auf der Anhöhe der Ältesten in Thunder Bluff mit dem Erzdruiden Hamuul Runetotem über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡썬더 블러프의 장로의 봉우리에 있는 대드루이드 하뮬 룬토템을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대해 얘기를 나눠야 합니다.‡Habla con el archidruida Hamuul Tótem Rúnico en Alto de los Ancestros, en Cima del Trueno, sobre la llamada del Círculo Cenarion a explorar las fronteras de Kalimdor.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Hamuul Runetotem, sur la Cime des Anciens de Thunder Bluff. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与雷霆崖长者高地的大德鲁伊哈缪尔·符文图腾谈一谈关于议会号召部落成员探索卡利姆多大陆的事情。‡與雷霆崖長者高地的大德魯伊哈繆爾·符文圖騰談壹談關於議會號召部落成員探索卡利姆多大陸的事情。',
  }
},
[1019] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Обратитесь в дарнасский анклав Кенария к верховному друиду Фэндралу Оленьему Шлему по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Staghelm über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대해 얘기를 나눠야 합니다.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion a explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Fandral Staghelm, dans l\'Enclave cénarienne, à Darnassus. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納裏奧區的大德魯範達爾·鹿盔談壹談關於議會號召聯盟成員探索卡利姆多大陸的事情。',
  }
},
[1020] = {
  {
    'Cura de Orendil‡Лекарство Орендила‡Orendils Heilmittel‡오렌딜의 치료제‡El remedio de Orendil‡Cura de Orendil‡Jouvence d\'Orendil‡奥雷迪尔的药剂‡奧雷迪爾的藥劑',
    nil,
    'Entregue a Cura de Orendil a Pelturas Lunalva em Astranaar.‡Принесите лекарство Орендила Пельтуру Белой Луне в Астранаар.‡Bringt Pelturas Whitemoon in Astranaar Orendils Heilmittel.‡아스트라나르에 있는 펠투러스 화이트문에게 오렌딜의 치료제를 가져가야 합니다.‡Llévale el remedio de Orendil a Pelturas en Astranaar.‡Llévale la cura de Orendil a Pelturas Lunablanca en Astranaar.‡Apporter la Jouvence d\'Orendil à Pelturas Whitemoon dans Astranaar.‡把奥雷迪尔的药剂交给阿斯特兰纳的皮尔图拉斯·怀特姆恩。‡把奧雷迪爾的藥劑交給阿斯特蘭納的皮爾圖拉斯·懷特姆恩。',
  }
},
[1021] = {
  {
    'Malditos sátiros! Dríades em perigo!‡Сатиры коварны! Дриады в опасности!‡Elende Satyrn! Die Dryaden sind in Gefahr!‡사악한 사티로스와 위험에 처한 드리아드‡¡Vil sátiro! ¡Dríade en peligro!‡¡Vil sátiro! ¡Dríades en peligro!‡Vil satyre ! dryades en danger !‡身陷危险的树妖！‡身陷危險的樹妖！',
    nil,
    'Encontre Anilia em Xavian.‡Найдите в Ксавиане Анилию.‡Sucht in Xavian nach Anilia.‡잿빛 골짜기 북동쪽에 있는 사비안에서 아닐리아를 찾아야 합니다.‡Encuentra a Anilia en Xavian.‡Busca a Anilia en Xavian.‡Trouver Anilia dans Xavian.‡到萨维亚去找到安妮莉亚。‡到薩維亞去找到安妮莉亞。',
  }
},
[1022] = {
  {
    'Vale Uivante‡Воющая Долина‡Das heulende Tal‡울부짖는 골짜기‡La Vega del Aullido‡La Vega del Aullido‡Le Val hurlant‡狼嚎谷‡狼嚎谷',
    nil,
    'Vá para o Vale Uivante estudar o Tomo de Mel\'Thandris, depois fale novamente com a Sentinela Melyria Algissombra no Altar de Aessina.‡Отправляйтесь в Воющую Долину, изучите фолиант Мел\'Тандрис, затем возвращайтесь к часовому Мелирии Ледяной Тени святилище Эссины.‡Begebt Euch ins heulende Tal, studiert den Folianten von Mel\'Thandris und kehrt dann zur Schildwache Melyria Frostshadow beim Schrein von Aessina zurück.‡울부짖는 골짜기로 가서 멜탄드리스의 마법책을 찾아 읽어 본 다음 아에시나의 제단에 있는 파수꾼 멜리리아 프로스트섀도에게 돌아가십시오.‡Ve a La Vega del Aullido y estudia el Libro de Mel\'Thandris, vuelve entonces junto a la Centinela Melyria Sombrigélida en el Santuario de Aessina.‡Ve a La Vega del Aullido y estudia el Libro de Mel\'Thandris. Luego, regresa con la centinela Melyria Sombrigélida en el Santuario de Aessina.‡Se rendre au Val hurlant et étudier le « Tome de Mel\'Thandris », puis retourner voir la Sentinelle Melyria Frostshadow au Sanctuaire d\'Aessina.‡到狼嚎谷去，研究一下麦尔莎迪丝之书，然后向艾森娜神殿的哨兵梅丽瑞亚·霜影复命。‡到狼嚎谷去，研究壹下麥爾莎迪絲之書，然後向艾森娜神殿的哨兵梅麗瑞亞·霜影復命。',
  }
},
[1023] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Encontre a Gema Faiscante e fale novamente com Raene Correlobos em Astranaar, em posse do Diário de Teronis.‡Найдите светящийся самоцвет и вернитесь к Раэне Волкопас в Астранаар с дневником Терониса.‡Sucht den leuchtenden Edelstein und bringt ihn zusammen mit Teronis\' Tagebuch zu Raene Wolfrunner in Astranaar.‡빛나는 보석을 찾아 테로니스의 일지와 함께 아스트라나르에 있는 레이네 울프러너에게 가져가야 합니다.‡Encuentra la gema resplandeciente y llévasela a Raene Correlobo en Astranaar junto con el diario de Teronis.‡Busca la gema resplandeciente y regresa a ver Raene Correlobo en Astranaar con el diario de Teronis.‡Trouver la Gemme luminescente et retourner voir Raene Wolfrunner dans Astranaar avec le Journal de Teronis.‡找到发光的宝石，连同泰洛尼斯的日记一起交给阿斯特兰纳的莱恩·狼行者。‡找到發光的寶石，連同泰洛尼斯的日記壹起交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1024] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Encontre Shael\'dryn no poço lunar a nordeste.‡Найдите Шаэлдрин у лунного колодца на северо-востоке.‡Sucht Shael\'dryn beim Mondbrunnen im Nordosten auf.‡북동쪽에 있는 달샘에서 셸드린을 찾아야 합니다.‡Encuentra a Shael\'dryn en la poza de la luna al noreste.‡Busca a Shael\'dryn en la poza de la luna al noreste.‡Trouver Shael\'dryn, au Puits de lune, au nord-est.‡在东北方的月亮井旁找到莎尔蒂恩。‡在東北方的月亮井旁找到莎爾蒂恩。',
  }
},
[1025] = {
  {
    'Uma defesa agressiva‡Лучшая защита – нападение‡Eine aggressive Verteidigung‡공격적 방어‡Una defensa agresiva‡Una defensa agresiva‡Une défense agressive‡先发制人‡先發制人',
    nil,
    'Mate 1 Vigia do Covil, 2 Ursinos, 10 Totêmicos e 12 Guerreiros da tribo Torpeflora, depois fale novamente com Raene Correlobos em Astranaar.‡Убейте 1 дозорного, 2 ведмедей, 10 тотемистов и 12 воинов из племени Гиблой Чащи, а затем вернитесь к Раэне Волкопас в Астранаар.‡Tötet 1 Höhlenbehüter, 2 Ursa, 10 Totemiker sowie 12 Krieger der Fäulnisklauen und kehrt dann zu Raene Wolfrunner in Astranaar zurück.‡썩은나무일족 보초 1마리, 썩은나무일족 펄볼그 2마리, 썩은나무일족 토템술사 10마리 및 썩은나무일족 전사 12마리를 처치한 다음 아스트라나르에 있는 레이네 울프러너에게 돌아가십시오.‡Mata a 1 vigilante del cubil, 2 ursas, 10 totémicos y 12 guerreros de la tribu de los Corruptos y vuelve junto a Raene Correlobo en Astranaar.‡Mata a 1 vigía del cubil, 2 ursas, 10 totémicos y 12 guerreros de la tribu de los Maderiza y vuelve junto a Raene Correlobo en Astranaar.‡Tuer 1 Protecteur, 2 Ursas, 10 Totemiques et 12 Guerriers de la tribu Vile-sylve, puis retourner voir Raene Wolfrunner, à Astranaar.‡杀掉污林部族里的1个污林卫兵、2个污林巨熊、2个污林萨满祭司和2个污林战士，然后回到阿斯特兰纳向莱恩·狼行者复命。‡殺掉汙林部族裏的1個汙林衛兵、2個汙林巨熊、2個汙林薩滿祭司和2個汙林戰士，然後回到阿斯特蘭納向萊恩·狼行者復命。',
  }
},
[1026] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Encontre a Chave de Madeira e uma parte do Bastão de Dartol antes de falar novamente com Shael\'dryn no poço lunar.‡Найдите деревянный ключ и обломок жезла Дартола прежде, чем вернуться к Шаэлдрин у Лунного колодца.‡Sucht den hölzernen Schlüssel und das Teil von Dartols Rute, bevor Ihr zu Shael\'dryn beim Mondbrunnen zurückkehrt.‡나무 열쇠와 다르톨의 변신마법봉의 조각을 찾아 달샘에 있는 셸드린에게 돌아가십시오.‡Encuentra la llave de madera y una pieza de la vara de Dartol antes de volver junto a Shael\'dryn en la poza de la luna.‡Encuentra la llave de madera y una pieza de la vara de Dartol antes de regresar con Shael\'dryn en la poza de la luna.‡Trouver la Clé en bois et un morceau du Bâtonnet de Dartol avant de retourner voir Shael\'dryn au Puits de lune.‡找到木制钥匙和一段达图尔的魔棒，然后回到月亮井的莎尔蒂恩那里。‡找到木制鑰匙和壹段達圖爾的魔棒，然後回到月亮井的莎爾蒂恩那裏。',
  }
},
[1027] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Encontre a última peça do Bastão de Dartol e fale novamente com Shael\'dryn no poço lunar.‡Найдите последний фрагмент жезла Дартола и вернитесь к Шаэлдрин у лунного колодца.‡Sucht das letzte Teil von Dartols Rute und bringt es Shael\'dryn beim Mondbrunnen.‡다르톨의 마법봉을 만들기 위한 마지막 조각을 찾아 달샘에 있는 셸드린에게 돌아가십시오.‡Encuentra la última pieza de la vara de Dartol y vuelve junto a Shael\'dryn en la poza de la luna.‡Encuentra la última pieza de la vara de Dartol y regresa con Shael\'dryn en la poza de la luna.‡Trouver le dernier morceau du Bâtonnet de Dartol et retourner voir Shael\'dryn au puits de lune.‡找到达图尔的魔棒的最后一段，然后回到月亮井旁的莎尔蒂恩那里。‡找到達圖爾的魔棒的最後壹段，然後回到月亮井旁的莎爾蒂恩那裏。',
  }
},
[1028] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Encontre o santuário oculto e encante o Bastão de Dartol.‡Найдите потаенное святилище и снова наполните чарами жезл Дартола.‡Sucht den verborgenen Schrein und verzaubert Dartols Rute erneut.‡숨겨진 제단을 찾아 다르톨의 마법봉에 다시 마력을 불어 넣어야 합니다.‡Encuentra el Santuario Oculto y encanta de nuevo la vara de Dartol.‡Encuentra el Santuario Oculto y encanta de nuevo la vara de Dartol.‡Trouver l\'Autel caché et recharger le Bâtonnet de Dartol.‡找到隐藏的神殿并给达图尔的魔棒重新注入魔力。‡找到隱藏的神殿並給達圖爾的魔棒重新註入魔力。',
  }
},
[1029] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Fale novamente com Raene Correlobos em Astranaar.‡Вернитесь к Раэне Волкопас в Астранаар.‡Kehrt zu Raene Wolfrunner in Astranaar zurück.‡아스트라나르에 있는 레이네 울프러너에게 돌아가십시오.‡Vuelve junto a Raene Correlobo en Astranaar.‡Vuelve junto a Raene Correlobo en Astranaar.‡Retourner voir Raene Wolfrunner à Astranaar.‡回到阿斯特兰纳的莱恩·狼行者那里。‡回到阿斯特蘭納的萊恩·狼行者那裏。',
  }
},
[1030] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Encontre um pelurso não corrompido e use o poder do Bastão de Transformação de Dartol para falar com ele.‡Найдите не затронутого порчей фурболга и поговорите с ним при помощи жезла преображения Дартола.‡Sucht einen nicht verderbten Furbolg und benutzt die Macht von Dartols Rute der Transformation, um mit ihm zu sprechen.‡오염되지 않은 펄볼그를 찾아 다르톨의 변신마법봉의 힘을 사용하여 그와 대화하십시오.‡Busca un fúrbolg sin corromper y usa el poder de la vara de transformación de Dartol para hablarle.‡Busca un fúrbolg sin corromper y usa el poder de la vara de transformación de Dartol para hablarle.‡Trouver un furbolg non corrompu et lui parler en utilisant le pouvoir du Bâtonnet de transformation de Dartol.‡找到一个尚未堕落的熊怪，利用达图尔的变形魔棒的能力与其交谈。‡找到壹個尚未墮落的熊怪，利用達圖爾的變形魔棒的能力與其交談。',
  }
},
[1031] = {
  {
    'O ramo de Cenarius‡Ветвь Кенария‡Der Zweig des Cenarius‡세나리우스의 가지‡La Rama de Cenario‡La Rama de Cenarius‡La branche de Cénarius‡塞纳留斯的树枝‡塞納留斯的樹枝',
    nil,
    'Mate Geltharis e leve o Ramo de Cenarius para Iliana no Altar de Aessina.‡Убейте Гелтариса и верните Ветвь Кенария Иллиане в святилище Эссины.‡Tötet Geltharis und bringt Illiyana beim Schrein von Aessina den Zweig des Cenarius.‡겔타리스를 처치하고 아에시나의 제단에 있는 일리야나에게 세나리우스의 가지를 돌려줘야 합니다.‡Mata a Geltharis y llévale la Rama de Cenario a Illiyana en el Santuario de Aessina.‡Mata a Geltharis y vuelve a ver a Illiyana con la rama de Cenarius en el Santuario de Aessina.‡Tuer Geltharis et rendre la Branche de Cénarius à Illiyana au Sanctuaire d\'Aessina.‡杀掉加萨里斯，把塞纳留斯的树枝交给艾森娜神殿的伊莉亚娜。‡殺掉加薩裏斯，把塞納留斯的樹枝交給艾森娜神殿的伊莉亞娜。',
  }
},
[1032] = {
  {
    'Temporada de caça aos sátiros‡Убийство сатиров!‡Satyrn schlachten!‡사티로스 처치‡¡Muerte a los sátiros!‡¡Muerte a los sátiros!‡Mort aux satyres !‡猎杀萨特！‡獵殺薩特！',
    nil,
    'Leve 16 Chifres de Sátiro para Iliana no Altar de Aessina.‡Принесите 16 рогов сатиров Иллиане в святилище Эссины.‡Bringt Illiyana im Schrein von Aessina 16 Satyrhörner.‡아에시나의 제단에 있는 일리야나에게 사티로스의 뿔 16개를 가져다주어야 합니다.‡Llévale 16 cuernos de sátiro a Illiyana en el Santuario de Aessina.‡Lleva 16 cuernos de sátiro a Illiyana en el Santuario de Aessina.‡Apporter 16 Cornes de satyre à Illiyana, au Sanctuaire d\'Aessina.‡收集16支萨特的角，把它们交给艾森娜神殿的伊莉亚娜。‡收集16支薩特的角，把它們交給艾森娜神殿的伊莉亞娜。',
  }
},
[1033] = {
  {
    'Lágrima de Eluna‡Слеза Элуны‡Elunes Träne‡엘룬의 눈물‡Lágrima de Elune‡Lágrima de Elune‡Larme d\'Elune‡月神之泪‡月神之淚',
    nil,
    'Leve a Lágrima de Eluna para Pelturas em Astranaar.‡Принесите Слезу Элуны Пельтуру в Астранаар.‡Bringt Pelturas in Astranaar die Träne von Elune.‡아스트라나르에 있는 펠투러스에게 엘룬의 눈물을 가져가야 합니다.‡Llévale la lágrima de Elune a Pelturas en Astranaar.‡Lleva la lágrima de Elune a Pelturas en Astranaar.‡Apporter une Larme d\'Elune à Pelturas Whitemoon à Astranaar.‡找到月神之泪，把它交给阿斯特兰纳的皮尔图拉斯·怀特姆恩。‡找到月神之淚，把它交給阿斯特蘭納的皮爾圖拉斯·懷特姆恩。',
  }
},
[1034] = {
  {
    'Ruínas de Poeira Estelar‡Руины Звездной Пыли‡Die Sternenstaubruinen‡별가루의 폐허‡Las ruinas del Polvo Estelar‡Las Ruinas del Polvo Estelar‡Les ruines de Chimétoile‡星尘废墟‡星塵廢墟',
    nil,
    'Leve 5 Punhados de Poeira Estelar para Pelturas em Astranaar.‡Принесите 5 горстей звездной пыли Пельтуру в Астранаар.‡Bringt Pelturas in Astranaar 5 Hand voll Sternenstaub.‡아스트라나르에 있는 펠투러스에게 별가루 5줌을 가져가야 합니다.‡Llévale 5 puñados de polvo estelar a Pelturas en Astranaar.‡Llévale 5 puñados de polvo estelar a Pelturas en Astranaar.‡Rapporter 5 Poignées de Poussière d\'étoile à Pelturas Whitemoon à Astranaar.‡收集5份星尘，把它们交给灰谷的皮尔图拉斯·怀特姆恩。‡收集5份星塵，把它們交給灰谷的皮爾圖拉斯·懷特姆恩。',
  }
},
[1035] = {
  {
    'Lago Céu Caído‡Зеркало Небес‡Fallenskysee‡유성 호수‡Lago Cielo Estrellado‡Lago Cielo Estrellado‡Le lac Tombeciel‡坠星湖‡墜星湖',
    nil,
    'Recolha uma Pedra-da-lua Caída do Oráculo Umbrárvore, depois leve-a para Pelturas em Astranaar.‡Отнимите лунный камень Упавшего Неба у Чащобного Оракула и принесите его Пельтуру в Астранаар.‡Holt von dem Schattendickichtorakel einen gefallenen Mondstein und bringt ihn Pelturas in Astranaar.‡그늘덤불 나무현자에게서 유성 월장석을 빼앗아서 아스트라나르에 있는 펠투러스에게 가져가야 합니다.‡Recupera una piedra lunar caída del Oráculo Sombramatorral y llévasela a Pelturas en Astranaar.‡Recupera una piedra lunar caída del Oráculo Sombramatorral y llévasela a Pelturas en Astranaar.‡Reprendre une Pierre de lune tombée à l\'Oracle Sombretaillis puis l\'apporter à Pelturas Whitemoon à Astranaar.‡从沼泽兽智者那里取回一枚陨落的月亮石，并把它带给阿斯特兰纳的皮尔图拉斯·怀特姆恩。‡從沼澤獸智者那裏取回壹枚隕落的月亮石，並把它帶給阿斯特蘭納的皮爾圖拉斯·懷特姆恩。',
  }
},
[1036] = {
  {
    'Ioho, cão sarnento!‡Суши весла, сухопутная крыса‡Hierher, Taugenichts‡붉은해적단과의 만남‡¡Adelante, pillín!‡¡Adelante, pillín!‡En avant toutes, jeune mariole !‡嘿，水手！‡嘿，水手！',
    nil,
    'Fale com o Mestre de Frota Firalião a bordo do Véu Carmesim na costa da Selva do Espinhaço.‡Поговорите с командиром флота Фираллоном на борту "Кровавой завесы" на побережье Тернистой долины.‡Sprecht mit Flottenmeister Firallon an Bord der CRIMSON VEIL vor der Küste des Schlingendorntals.‡가시덤불 골짜기 해안에 정박해 있는 크림슨 베일호에서 함장 피랠론과 대화해야 합니다.‡Habla con el maestro de flota Firallon a bordo de El Velo Carmesí cerca de la costa de la Vega de Tuercespina.‡Habla con el maestro de flota Firallon a bordo de El Velo Carmesí cerca de la costa de la Vega de Tuercespina.‡Parlez à l’amiral Firallon, à bord de la Voile cramoisie, au large de la côte de la vallée de Strangleronce.‡登上停泊在荆棘谷海岸边的红雾号，与船里的舰队指挥官菲尔拉伦谈一谈。‡登上停泊在荊棘谷海岸邊的紅霧號，與船裏的艦隊指揮官菲爾拉倫談壹談。',
  }
},
[1037] = {
  {
    'Velinde Stelacanto‡Велинда Песнь Звезд‡Velinde Starsong‡벨린데 스타송‡Velinde Cantoestelar‡Velinde Cantoestelar‡Velinde Starsong‡维琳德·星歌‡維琳德·星歌',
    nil,
    'Fale com Thyn\'tel Tecelâmina no Terraço dos Guerreiros, em Darnassus.‡Поговорите с Тин\'тель Танцем Клинка на террасе Воинов в Дарнассе.‡Sprecht auf der Terrasse der Krieger in Darnassus mit Thyn\'tel Bladeweaver.‡다르나서스의 전사의 정원에 있는 신텔 블레이드위버와 대화하십시오.‡Habla con Thyn\'tel Tejespada en el Bancal del Guerrero en Darnassus.‡Habla con Thyn\'tel Tejespada en el Bancal del Guerrero en Darnassus.‡Parler à Thyn\'tel Bladeweaver à la Terrasse des guerriers de Darnassus.‡在达纳苏斯的战士区与塞恩提尔·刃纹谈一谈。‡在達納蘇斯的戰士區與塞恩提爾·刃紋談壹談。',
  }
},
[1038] = {
  {
    'Os efeitos de Velinde‡Эффекты Велинды‡Velindes Besitztümer‡벨린데의 영향‡Las pertenencias de Velinde‡Las pertenencias de Velinde‡Les effets personnels de Velinde‡维琳德的日记‡維琳德的日記',
    nil,
    'Vasculhe o baú de Velinde atrás do seu diário, depois leve-o junto com a chave para Thyn\'tel Tecelâmina em Darnassus.‡Поищите в сундуке Велинды ее дневник, затем принесите его вместе с ключом Тинтэль Танцующий Клинок в Дарнасс.‡Durchsucht Velindes Truhe nach ihrem Tagebuch und bringt es zusammen mit dem Schlüssel nach Darnassus zu Thyn\'tel Bladeweaver.‡벨린데의 상자에서 일지를 찾은 다음 열쇠와 함께 다르나서스에 있는 신텔 블레이드위버에게 돌려주어야 합니다.‡Busca en diario de Velinde en su cofre y llévaselo, junto con la llave, a Thyn\'tel Tejespada a Darnassus.‡Busca el diario de Velinde en su cofre y llévaselo, junto con la llave, a Thyn\'tel Tejespada a Darnassus.‡Fouiller le coffre de Velinde pour trouver son Journal et le rendre ensuite avec la clé à Thyn\'tel Bladeweaver à Darnassus.‡在维琳德的箱子里搜寻她的日记，把日记连同钥匙一起交给达纳苏斯的塞恩提尔·刃纹。‡在維琳德的箱子裏搜尋她的日記，把日記連同鑰匙壹起交給達納蘇斯的塞恩提爾·刃紋。',
  }
},
[1039] = {
  {
    'O porto dos Sertões‡Порт в Степях‡Der Brachlandhafen‡불모의 땅 항구‡El puerto de Los Baldíos‡El puerto de Los Baldíos‡Le port des Tarides‡贫瘠之地的港口‡貧瘠之地的港口',
    nil,
    'Fale com o Mestre Portuário Caruncho na Vila Catraca.‡Поговорите с управляющим пристанью Головокружилкинсом в Кабестане.‡Sprecht in Ratchet mit Werftmeister Dizzywig.‡톱니항에 있는 부두주임 디지위그와 대화하십시오.‡Ve a Trinquete y habla con Vertipeluca, el maestro de muelles.‡Ve a Trinquete y habla con el maestro de muelles Vertipeluca.‡Aller voir le Maître des docks Dizzywig à Ratchet.‡和棘齿城的码头管理员迪兹维格谈一谈。‡和棘齒城的碼頭管理員迪茲維格談壹談。',
  }
},
[1040] = {
  {
    'Um barco para a Angra do Butim‡Дорога до Пиратской бухты‡Passage nach Booty Bay‡무법항으로의 여정‡Pasaje a Bahía del Botín‡Pasaje a Bahía del Botín‡Passage à Baie-du-Butin‡藏宝海湾的航道‡藏寶海灣的航道',
    nil,
    'Pegue um barco para Angra do Butim e fale com Caravaneiro Russote.‡Плывите в Пиратскую бухту и поговорите с караванщиком Раззготом.‡Nehmt ein Schiff nach Booty Bay und sprecht dort mit dem Karawanenführer Ruzzgot.‡무법항으로 배를 타고 가서 행상 러즈고트와 대화하십시오.‡Lleva un barco a Bahía del Botín y habla con el caravanero Ruzzgot.‡Coge un barco a Bahía del Botín y habla con el caravanero Ruzzgot.‡Prendre un bateau pour Baie-du-Butin et aller voir le Caravanier Ruzzgot.‡坐船去藏宝海湾，和旅行者拉兹戈特谈一谈。‡坐船去藏寶海灣，和旅行者拉茲戈特談壹談。',
  }
},
[1041] = {
  {
    'Na estrada com a Caravana‡Путь каравана‡Die Karawanenstraße‡행상길‡La ruta de la caravana‡La ruta de la caravana‡La route de la caravane‡商队通路‡商隊通路',
    nil,
    'Fale com o Tabelião Azambuja na Vila Sombria.‡Поговорите с клерком Далтри из Темнолесья.‡Sprecht in Dunkelhain mit Amtmann Daltry.‡다크샤이어에 있는 서기관 달트리와 대화하십시오.‡Habla con el dependiente Daltry en Villa Oscura.‡Habla con el secretario Daltry en Villa Oscura.‡Aller voir le greffier Daltry à Darkshire.‡与夜色镇的书记员达尔塔谈一谈。‡與夜色鎮的書記員達爾塔談壹談。',
  }
},
[1042] = {
  {
    'A família Carevino‡Семья Карвин‡Die Familie Carevin‡카레빈 일가‡La familia Carevin‡La familia Carevin‡La famille Carevin‡卡尔文家族‡卡爾文家族',
    nil,
    'Fale com João Carevino na Vila Sombria.‡Поговорите с Джонатаном Карвином в Темнолесье.‡Sprecht mit Jonathan Carevin in Dunkelhain.‡다크샤이어에 있는 조나단 카레빈과 대화해야 합니다.‡Habla con Jonathan Carevin en Villa Oscura.‡Habla con Jonathan Carevin en Villa Oscura.‡Aller voir Jonathan Carevin à Darkshire.‡去和夜色镇的乔纳森·卡尔文谈谈。‡去和夜色鎮的喬納森·卡爾文談談。',
  }
},
[1043] = {
  {
    'A foice de Eluna‡Коса Элуны‡Die Sense von Elune‡엘룬의 낫‡La Guadaña de Elune‡La Guadaña de Elune‡La Faux d\'Elune‡月神的镰刀‡月神的鐮刀',
    nil,
    'Procure sinais da Foice de Eluna, e depois fale novamente com João Carevino na Vila Sombria.‡Отыщите признаки местонахождения Косы Элуны и вернитесь к Джонатану Карвину в Темнолесье.‡Sucht nach Hinweisen auf die Sense von Elune und kehrt dann zu Jonathan Carevin in Dunkelhain zurück.‡엘룬의 낫의 흔적을 찾은 다음 다크샤이어에 있는 조나단 카레빈에게 돌아가야 합니다.‡Busca signos de la Guadaña de Elune y regresa a Villa Oscura, con Jonathan Carevin.‡Busca signos de la Guadaña de Elune y regresa a Villa Oscura, con Jonathan Carevin.‡Chercher les signes de la Faux d\'Elune puis retourner voir Jonathan Carevin à Darkshire.‡去找关于月神镰刀的消息，然后回到夜色镇见乔纳森·卡尔文。‡去找關於月神鐮刀的消息，然後回到夜色鎮見喬納森·卡爾文。',
  }
},
[1044] = {
  {
    'Perguntas esclarecidas‡Полученные ответы‡Beantwortete Fragen‡해결된 의문‡La respuesta a las preguntas‡La respuesta a las preguntas‡Réponses aux questions‡回复珊蒂斯‡回復珊蒂斯',
    nil,
    'Fale novamente com Thyn\'tel Tecelâmina em Darnassus.‡Вернитесь к Тин\'тель Танцу Клинка в Дарнасс.‡Kehrt nach Darnassus zu Thyn\'tel Bladeweaver zurück.‡다르나서스에 있는 신텔 블레이드위버에게 돌아가야 합니다.‡Regresa a Darnassus y habla con Thyn\'tel Tejespada.‡Regresa a Darnassus y habla con Thyn\'tel Tejespada.‡Retourner vers Thyn\'tel Bladeweaver à Darnassus.‡回到达纳苏斯去见珊蒂斯·羽月。‡回到達納蘇斯去見珊蒂斯·羽月。',
  }
},
[1045] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Mate Ran Dente Sangrento e 4 Guardas Dente Sangrento e fale novamente com Krolg perto do Lago Mistral.‡Убейте Рэна Кровавого Клыка, 4 кровозубых стражей и вернитесь к Кролгу у озера Мистраль.‡Tötet Ran Blutreißer sowie 4 Wachen von Blutreißer und kehrt dann zu Krolg in der Nähe des Mystralsees zurück.‡랜 블러드투스와 붉은송곳니 경비병 4명을 처치하고 미스트랄 호수 근처에 있는 크롤그에게 돌아가십시오.‡Mata a Ran Sangradientes y 4 guardias Sangradientes. Después regresa con Krolg cerca del Lago Mystral.‡Mata a Ran Sangradientes y 4 guardias Sangradientes y regresa con Krolg cerca del Lago Mystral.‡Tuer Ran Dent-rouge et 4 Gardes de Dent-rouge, puis retourner voir Krolg près du lac Mystral.‡杀死兰恩·血牙和4个血牙保镖，然后向密斯特拉湖附近的克罗格复命。‡殺死蘭恩·血牙和4個血牙保鏢，然後向密斯特拉湖附近的克羅格復命。',
  }
},
[1046] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Leve o Crânio de Ran Dente Sangrento e o Bastão de Transformação de Dartol para Raene Correlobos em Astranaar.‡Принесите череп Рэна Кровавого Клыка и жезл Преображения Дартола Раэне Волкопас в Астранаар.‡Bringt Raene Wolfrunner in Astranaar Ran Blutreißers Schädel und Dartols Rute der Transformation.‡아스트라나르에 있는 레이네 울프러너에게 랜 블러드투스의 해골과 다르톨의 변신마법봉을 가져가야 합니다.‡Llévale la calavera de Ran Dentesangre y la vara de la Transformación de Dartol a Raene Correlobo en Astranaar.‡Lleva calavera de Ran Sangradientes y la vara de transformación de Dartol a Raene Correlobo en Astranaar.‡Apporter le Crâne de Ran Dent-rouge et le Bâtonnet de transformation de Dartol à Raene Wolfrunner à Astranaar.‡把兰恩·血牙的颅骨和达图尔的变形魔棒交给阿斯特兰纳的莱恩·狼行者。‡把蘭恩·血牙的顱骨和達圖爾的變形魔棒交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1047] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Обратитесь в дарнасский анклав Кенария к верховному друиду Фэндралу Оленьему Шлему по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Staghelm über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대한 얘기를 나눠야 합니다.‡Ve a Darnassus, al Enclave Cenarion y habla con el archidruida Fandral Corzocelada sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l’archidruide Fandral Staghelm, dans l\'Enclave cénarienne, à Darnassus. Evoquer l’appel du Cercle cénarien concernant l’exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納裏奧區的大德魯範達爾·鹿盔談壹談關於議會號召聯盟成員探索卡利姆多大陸的事情。',
  }
},
[1048] = {
  {
    'Adentrando o Monastério Escarlate‡В монастырь Алого ордена‡In das Scharlachrote Kloster‡붉은십자군 수도원으로‡En el Monasterio Escarlata‡En el Monasterio Escarlata‡Au monastère écarlate‡深入血色修道院‡深入血色修道院',
    nil,
    'Mate a Alta-inquisidora Cristalba, o Comandante Escarlate Mograine, Herodes, o Campeão Escarlate e o Mestre de Matilha Lobato, depois volte a falar com Varimatras na Cidade Baixa.‡Убейте Верховного инквизитора Вайтмейн, командира Могрейна из Алого ордена, воителя Герода из Алого ордена и псаря Локси. Затем возвращайтесь к Вариматрасу в Подгород.‡Tötet Hochinquisitor Whitemane, den Scharlachroten Kommandant Mograine, Herod, den Scharlachroten Helden sowie den Hundemeister Loksey und meldet Euch dann wieder bei Varimathras in Undercity.‡종교재판관 화이트메인, 붉은십자군 사령관 모그레인, 붉은십자군 용사 헤로드와 사냥개조련사 록시를 처치한 후 언더시티에 있는 바리마트라스에게 돌아가 보고해야 합니다.‡Mata a la alta inquisidora Melenablanca, al comandante Escarlata Mograine, a Herod el campeón Escarlata y al domador de jaurías Loksey, y después ve a ver de nuevo a Varimathras a Entrañas.‡Mata a la alta inquisidora Melenablanca, al comandante Escarlata Mograine, a Herod el Campeón Escarlata y al maestro de canes Loksey, y después ve a ver de nuevo a Varimathras a Entrañas.‡Tuer le grand inquisiteur Whitemane, le commandant Mograine de la Croisade, le champion Herod et le maître-chien Loksey, et retourner faire son rapport à Varimathras à Undercity.‡杀掉大检察官怀特迈恩、血色十字军指挥官莫格莱尼、血色十字军勇士赫洛德和驯犬者洛克希，然后向幽暗城的瓦里玛萨斯回报。‡殺掉大檢察官懷特邁恩、血色十字軍指揮官莫格萊尼、血色十字軍勇士赫洛德和馴犬者洛克希，然後向幽暗城的瓦裏瑪薩斯回報。',
  }
},
[1049] = {
  {
    'O Compêndio dos Caídos‡"Компендиум павших"‡Kompendium der Gefallenen‡타락의 개요‡El Compendio de los Caídos‡El Compendio de los Caídos‡Compendium des Déchus‡堕落者纲要‡墮落者綱要',
    nil,
    'Recupere o Compêndio dos Caídos no Monastério nas Clareiras de Tirisfal e volte a falar com o Sábio Devoto da Verdade no Penhasco do Trovão.‡Добудьте "Компендиум павших" из монастыря в Тирисфальских лесах и возвращайтесь к Ведуну Искателю Истины в Громовой Утес.‡Holt das \'Kompendium der Gefallenen\' aus dem Kloster in Tirisfal und bringt es zu Sage Truthseeker in Thunder Bluff.‡티리스팔 숲의 붉은십자군 수도원에서 타락의 개요를 찾아 썬더 블러프에 있는 현자 트루스시커에게 가져가야 합니다.‡Recupera el Compendio de los Caídos del Monasterio que se encuentra en los Claros de Tirisfal y regresa ante Sabio Buscaverdad, que está en Cima del Trueno.‡Recupera el Compendio de los Caídos del Monasterio que se encuentra en los Claros de Tirisfal y regresa ante Sabio Buscador de la Verdad, que está en Cima del Trueno.‡Trouver le « Compendium des Déchus » au Monastère dans les Clairières de Tirisfal et retourner voir le Sage Truthseeker à Thunder Bluff.‡从血色修道院里找到《堕落者纲要》，把它交给雷霆崖的圣者图希克。‡從血色修道院裏找到《墮落者綱要》，把它交給雷霆崖的聖者圖希克。',
  }
},
[1050] = {
  {
    'Mitologia dos Titãs‡"Мифология Титанов"‡Mythologie der Titanen‡티탄 신화‡Mitología de los Titanes‡Mitología de los titanes‡Mythologie des Titans‡泰坦神话‡泰坦神話',
    nil,
    'Recupere o livro Mitologia dos Titãs no Monastério e leve-o para a Bibliotecária Maé Palidopó em Altaforja.‡Добудьте "Мифологию Титанов" из монастыря и принесите ее библиотекарю Мае Белокожке в Стальгорн.‡Holt die \'Mythologie der Titanen\' aus dem Kloster und bringt die der Bibliothekarin Mae Paledust in Ironforge.‡수도원에서 티탄 신화라는 책을 찾아 아이언포지에 있는 사서 메이 페일더스트에게 가져가야 합니다.‡Coge Mitología de los Titanes en el monasterio y llévaselo a la bibliotecaria Mae Palipolvo a Forjaz.‡Coge Mitología de los titanes en el monasterio y llévaselo a la bibliotecaria Mae Palipolvo a Forjaz.‡Reprendre « la Mythologie des Titans » au Monastère et le rapporter au Bibliothécaire Mae Paledust à Ironforge.‡从修道院拿回《泰坦神话》，把它交给铁炉堡的图书馆员麦伊·苍尘。‡從修道院拿回《泰坦神話》，把它交給鐵爐堡的圖書館員麥伊·蒼塵。',
  }
},
[1051] = {
  {
    'A vingança de Vorrel‡Месть Воррела‡Vorrels Rache‡보렐의 복수‡La venganza de Vorrel‡La venganza de Vorrel‡La vengeance de Vorrel‡沃瑞尔的复仇‡沃瑞爾的復仇',
    nil,
    'Leve a aliança de Vorrel Sentripaz para Mônica Sentripaz na Serraria Tarren.‡Верните обручальное кольцо Воррела Сенгутца Монике Сенгутц в Мельнице Таррен.‡Bringt Monika Sengutz in Tarrens Mühle den Ehering von Vorrel Sengutz.‡타렌 밀농장에 있는 모니카 센구츠에게 보렐의 결혼반지를 가져가야 합니다.‡Lleva la alianza de Vorrel Sengutz a Monika Sengutz de Molino Tarren.‡Lleva la alianza de Vorrel Sengutz a Monika Sengutz de Molino Tarren.‡Rapporter l\'anneau de mariage de Vorrel Sengutz à Monica Sengutz à Moulin-de-Tarren.‡把沃瑞尔·森加斯的结婚戒指还给塔伦米尔的莫尼卡·森古特斯。‡把沃瑞爾·森加斯的結婚戒指還給塔倫米爾的莫尼卡·森古特斯。',
  }
},
[1052] = {
  {
    'No caminho Escarlate‡По пути Алых‡Auf dem Scharlachroten Pfad‡붉은십자군의 길‡El sendero Escarlata‡El sendero Escarlata‡Sur le chemin écarlate‡血色之路‡血色之路',
    nil,
    'Leve a Carta de Comenda de Anton para Raul, o Devotado, na Costa Sul.‡Отнесите рекомендательное письмо брата Антона Ролею Благочестивому в Южнобережье.‡Bringt Raleigh dem Andächtigen in Southshore Bruder Antons Empfehlungsschreiben.‡사우스쇼어에 있는 경건한 신자 랄레이에게 수사 안톤의 추천서를 가져가야 합니다.‡Lleva la carta de mención honorífica del hermano Antón a Raleigh el Devoto, en Costasur.‡Lleva la carta de mención honorífica del hermano Anton a Raleigh el Devoto, en Costasur.‡Apporter la Lettre de recommandation du Frère Anton à Raleigh le Dévot à Southshore.‡将安东修士的表彰信带给南海镇的虔诚的莱雷恩。‡將安東修士的表彰信帶給南海鎮的虔誠的萊雷恩。',
  }
},
[1053] = {
  {
    'Em nome da Luz‡Во имя Света!‡Im Namen des Lichts‡빛의 이름으로!‡En el nombre de la Luz‡En el nombre de la Luz‡Au nom de la Lumière‡以圣光之名‡以聖光之名',
    nil,
    'Mate a Alta-inquisidora Cristalba, o Comandante Escarlate Mograine, Herodes, o Campeão Escarlate e o Mestre de Matilha Lobato, depois volte a falar com Raul, o Devotado na Costa Sul.‡Убейте Верховного инквизитора Вайтмейн, командира Могрейна из Алого ордена, воителя Герода из Алого ордена и псаря Локси, после этого вернитесь с докладом к Ролею Благочестивому в Южнобережье.‡Tötet Hochinquisitor Whitemane, den Scharlachroten Kommandant Mograine, Herod, den Scharlachroten Helden sowie den Hundemeister Loksey und meldet Euch dann wieder bei Raleigh dem Andächtigen in Southshore.‡종교재판관 화이트메인, 붉은십자군 사령관 모그레인, 붉은십자군 용사 헤로드와 사냥개조련사 록시를 처치한 후 사우스쇼어에 있는 경건한 신자 랄레이에게 돌아가 보고하십시오.‡Mata a la alta inquisidora Melenablanca, al Comandante Escarlata Mograine, a Herod, el Campeón Escarlata y al domador de jaurías Loksey. A continuación, preséntate ante Raleigh el Devoto, en Costasur.‡Mata a la alta inquisidora Melenablanca, al Comandante Escarlata Mograine, a Herod, el Campeón Escarlata y al maestro de canes Loksey. A continuación, preséntate ante Raleigh el Devoto, en Costasur.‡Tuer le grand inquisiteur Whitemane, le commandant Mograine de la Croisade, le champion Herod de la Croisade et le maître-chien Loksey, et retourner faire un rapport à Raleigh le Dévot à Southshore.‡杀死大检察官怀特迈恩，血色十字军指挥官莫格莱尼，十字军的勇士赫洛德和驯犬者洛克希并向南海镇的莱雷恩复命。‡殺死大檢察官懷特邁恩，血色十字軍指揮官莫格萊尼，十字軍的勇士赫洛德和馴犬者洛克希並向南海鎮的萊雷恩復命。',
  }
},
[1054] = {
  {
    'Contendo a ameaça‡Устранение угрозы‡Die Auswahl der Bedrohung‡위협 제거‡Matanza selectiva‡Matanza selectiva‡Diminution de la menace‡解除威胁‡解除威脅',
    nil,
    'Leve o Crânio de Dal Sangarra para Raene Correlobos em Astranaar.‡Принесите череп Дала Жилотяга Раэне Волкопас в Астранаар.‡Bringt Raene Wolfrunner in Astranaar Dal Blutklaues Schädel.‡아스트라나르에 있는 레이네 울프러너에게 달 블러드클로의 해골을 가져가야 합니다.‡Llévale la calavera de Dal Zarpasangrante a Raene Correlobo en Astranaar.‡Llévale la calavera de Dal Zarpasangrante a Raene Correlobo en Astranaar.‡Apporter le Crâne de Dal Griffesang à Raene Wolfrunner à Astranaar.‡把达尔·血爪的颅骨交给阿斯特兰纳的莱恩·狼行者。‡把達爾·血爪的顱骨交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1055] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的凈化',
    nil,
    'Fale novamente com Shael\'dryn no poço lunar.‡Вернитесь к Шаэлдрин у лунного колодца.‡Kehrt zu Shael\'dryn beim Mondbrunnen zurück.‡달샘에 있는 셸드린에게 돌아가십시오.‡Vuelve junto a Shael\'dryn en la poza de la luna.‡Vuelve junto a Shael\'dryn en la Poza de la Luna.‡Retourner voir Shael\'dryn au puits de lune.‡回到月亮井旁的莎尔蒂恩那里。‡回到月亮井旁的莎爾蒂恩那裏。',
  }
},
[1056] = {
  {
    'A jornada para o Morro das Torres de Pedra‡Путешествие к Пику Каменного Когтя‡Reise zum Steinkrallengipfel‡돌발톱 봉우리로의 여정‡Viaje a Cima del Espolón‡Viaje a Cima del Espolón‡Voyage au pic des Serres-Rocheuses‡石爪峰之旅‡石爪峰之旅',
    nil,
    'Vá até o Guardião Albagorm no Morro das Torres de Pedra.‡Отправляйтесь к хранителю Албагорму на Пик Каменного Когтя.‡Reist zu Bewahrer Albagorm auf dem Steinkrallengipfel.‡돌발톱 봉우리에 있는 수호자 알바고름을 찾아가십시오.‡Ve junto al vigilante Albagorm en la Cima del Espolón.‡Ve junto al vigilante Albagorm en la Cima del Espolón.‡Voyager pour aller voir le Gardien Albagorm au pic des Serres-Rocheuses.‡拜访石爪峰的看守者奥巴格姆。‡拜訪石爪峰的看守者奧巴格姆。',
  }
},
[1057] = {
  {
    'Reivindicando o Vale Carbonizado‡Возвращение Обугленной долины‡Die Rückeroberung des verbrannten Tals‡잿더미 계곡 복원‡La reconquista de La Vega Carbonizada‡La reconquista de La Vega Carbonizada‡À la reconquête du Val calciné‡夺回焦炭谷‡奪回焦炭谷',
    nil,
    'O Guardião Albagorm, no Morro das Torres de Pedra, quer que você mate 7 Harpias Furissangue, 7 Emboscadoras Furissangue e 7 Plumerrantes Furissangue.‡Хранитель Албагорм с Пика Каменного Когтя просит вас убить 7 гарпий, 7 душительниц, 7 душегубок и 7 бродяжниц из стаи Кровавой Ярости.‡Bewahrer Albagorm auf dem Steinkrallengipfel möchte, dass Ihr 7 Harpyien der Blutfurien, 7 Wegelagerinnen der Blutfurien, 7 Töterinnen der Blutfurien und 7 Wildfedern der Blutfurien erschlagt.‡돌발톱 봉우리에 있는 수호자 알바고름이 혈폭풍하피 7마리, 혈폭풍일족 복병 7마리, 혈폭풍일족 암살자 7마리, 그리고 혈폭풍일족 약탈자 7마리를 처치해 달라고 부탁했습니다.‡El vigilante Albagorm en la Cima del Espolón quiere que mates 7 arpías Furia Sangrienta, 7 emboscadores Furia Sangrienta, 7 cazadores Furia Sangrienta y 7 Plumapícaros Furia Sangrienta.‡El vigilante Albagorm en la Cima del Espolón quiere que mates a 7 arpías Furia Sangrienta, a 7 emboscadoras Furia Sangrienta, a 7 destripadoras Furia Sangrienta y a 7 malaplumas Furia Sangrienta.‡Le Gardien Albagorm du pic des Serres-Rocheuses veut que vous tuiez 7 Harpies, 7 Embusqués, 7 Tueuses et 7 Volplumes Rougefuries.‡石爪峰的守护者奥巴格姆要求你杀死7个血怒鹰身人、7个血怒伏击者、7个血怒杀戮者和7个血怒游荡者。‡石爪峰的守護者奧巴格姆要求妳殺死7個血怒鷹身人、7個血怒伏擊者、7個血怒殺戮者和7個血怒遊蕩者。',
  }
},
[1058] = {
  {
    'A magia florestal de Jin\'Zil‡Лесная магия Джин\'Зила‡Jin\'Zils Waldmagie‡진질의 숲의 마법‡Magia del bosque de Jin\'Zil‡Magia del bosque de Jin\'Zil‡Magie de la forêt de Jin\'Zil‡金吉尔的森林魔法‡金吉爾的森林魔法',
    nil,
    'O Mandingueiro Jin\'Zil, em Malaka\'jin, quer 5 porções de Seiva das Torres de Pedra, 5 Bigodes de Felino do Crepúsculo, 30 Olhos de Corcel e uma Escama de Dragão Encantado.‡Знахарь Джин\'Зил из Малака\'джина требует принести 5 порций слизи Каменного когтя, 5 сумеречных усиков, 30 глаз бегового оленя и чешуйку волшебного дракончика.‡Hexendoktor Jin\'Zil in Malaka\'jin möchte 5 Portionen Steinkrallensaft, 5 Schnurrhaare eines Mondlichtläufers, 30 Renner-Augen und die Schuppe eines Siechdrachen.‡말라카진에 있는 의술사 진질이 돌발톱 수액 5개, 황혼의 수염 5개, 순록의 눈 30개와 마룡 비늘 1개를 가져다 달라고 부탁했습니다.‡El médico brujo Jin\'Zil en Malaka\'jin quiere 5 porciones de savia Espolón, 5 mostachias Crepusculares, 30 ojos de corcel y una escama de dragón Fey.‡El médico brujo Jin\'Zil en Malaka\'jin quiere 5 porciones de savia del Espolón, 5 mostachos Crepusculares, 30 ojos de trotadores y una escama de dragón hada.‡Le sorcier-docteur Jin\'Zil à Malaka\'jin veut 5 doses de Sève des Serres-Rocheuses, 5 Moustaches crépusculaires, 30 Yeux de coursier et une Ecaille de dragon-faë.‡玛拉卡金的巫医金吉尔需要5瓶石爪苔液、5根夜行虎须、30颗巨角鹿的眼球和1块灵龙的鳞片。‡瑪拉卡金的巫醫金吉爾需要5瓶石爪苔液、5根夜行虎須、30顆巨角鹿的眼球和1塊靈龍的鱗片。',
  }
},
[1059] = {
  {
    'Reivindicando o Vale Carbonizado‡Возвращение Горелой Долины‡Die Rückeroberung des verbrannten Tals‡잿더미 계곡 복원‡La reconquista de La Vega Carbonizada‡La reconquista de La Vega Carbonizada‡À la reconquête du Val calciné‡夺回焦炭谷‡奪回焦炭谷',
    nil,
    'Viaje até Falfindel Trilhemas na fronteira entre Mil Agulhas e Feralas.‡Отправляйтесь к Фалфиндеру Хранителю Дорог, живущему на границе Тысячи Игл и Фераласа.‡Reist zu Falfindel Waywarder an der Grenze zwischen Tausend Nadeln und Feralas.‡버섯구름 봉우리와 페랄라스의 경계에 있는 팔핀델 웨이워더를 찾아가야 합니다.‡Ve a ver al Díscolo Falfindel en la frontera entre Las Mil Agujas y Feralas.‡Ve a ver al Díscolo Falfindel en la frontera entre Las Mil Agujas y Feralas.‡Trouver Falfindel Waywarder à la frontière entre les Mille pointes et Feralas.‡在千针石林与菲拉斯的边境上找到法芬德尔。‡在千針石林與菲拉斯的邊境上找到法芬德爾。',
  }
},
[1060] = {
  {
    'Uma carta para Jin\'Zil‡Письмо Джин\'Зилу‡Brief an Jin\'Zil‡진질에게 보내는 편지‡Una carta para Jin\'Zil‡Carta para Jin\'Zil‡Lettre à Jin\'Zil‡写给金吉尔的信‡寫給金吉爾的信',
    nil,
    'Entregue a carta de Darsok a Jin\'Zil em sua caverna em Malaka\'jin, nas Torres de Pedra.‡Отнесите письмо Дарсока Джин\'Зилу в пещеру Малака\'джин в Когтистых горах.‡Überbringt Jin\'Zil in seiner Höhle im Steinkrallengebirge Darsoks Brief.‡돌발톱 산맥의 동굴에서 야영을 하는 진질에게 달소크의 편지를 전달하십시오.‡Entrégale la carta de Darsok a Jin\'Zil en su cueva de Malaka\'jin, en Espolón.‡Entrégale la carta de Darsok a Jin\'Zil en su cueva de Malaka\'jin, en Espolón.‡Remettre la lettre de Darsok à Jin\'Zil dans sa caverne des Serres-Rocheuses.‡把达索克的亲笔信交给金吉尔，他住在石爪山的洞穴中。‡把達索克的親筆信交給金吉爾，他住在石爪山的洞穴中。',
  }
},
[1061] = {
  {
    'Os espíritos das Torres de Pedra‡Духи Каменного Когтя‡Die Geister des Steinkrallengebirges‡돌발톱 산맥의 정령‡Los espíritus del Espolón‡Los espíritus del Espolón‡Les esprits des Serres-Rocheuses‡石爪之灵‡石爪之靈',
    nil,
    'Fale com Seereth Quebra-pedra na Cordilheira das Torres de Pedra.‡Поговорите с Сирит Камнелом в Когтистых горах.‡Sprecht im Steinkrallengebirge mit Seereth Stonebreak.‡돌발톱 산맥에 있는 시리스 스톤브레이크와 대화하십시오.‡Habla con Seereth Rompepedras en Sierra Espolón.‡Habla con Seereth Petrajada en Sierra Espolón.‡Parler à Seereth Stonebreak dans les Serres-Rocheuses.‡找到石爪山的希雷斯·碎石并和她谈一谈。‡找到石爪山的希雷斯·碎石並和她談壹談。',
  }
},
[1062] = {
  {
    'Invasores goblins‡Вторжение гоблинов‡Goblin-Eindringlinge‡고블린 침략자‡Los invasores goblin‡Los invasores goblin‡Les invasions gobelines‡地精侵略者‡地精侵略者',
    nil,
    'Mate 15 Madeireiros da Empreendimentos S.A. e, então, fale novamente com Seereth Quebra-pedra na fronteira entre as Torres de Pedra e os Sertões.‡Убейте 15 лесорубов Торговой компании, затем вернитесь к Сирет Камнелом на границу Каменного Когтя и Степей.‡Tötet 15 Holzfäller der Venture Co. und kehrt dann zu Seereth Stonebreak an der Grenze des Steinkrallengebirges und dem Brachland zurück.‡투자개발회사 나무꾼 15명을 처치한 다음 돌발톱 산맥과 불모의 땅의 경계에 있는 시리스 스톤브레이크에게 돌아가십시오.‡Mata 15 leñeros de Ventura y Cía. y vuelve a ver a Seereth Rompepedras, en la frontera entre Espolón y Los Baldíos.‡Mata a 15 leñadores de Ventura y Cía. y vuelve a ver a Seereth Petrajada, en la frontera entre Espolón y Los Baldíos.‡Tuer 15 Déboiseurs de la KapitalRisk, puis retourner auprès de Seereth Stonebreak à la frontière des Serres-Rocheuses et des Tarides.‡杀死15个风险投资公司樵夫，然后向石爪山与贫瘠之地交界处的希雷斯·碎石复命。‡殺死15個風險投資公司樵夫，然後向石爪山與貧瘠之地交界處的希雷斯·碎石復命。',
  }
},
[1063] = {
  {
    'A Bruxa Anciã‡Мудрая старуха‡Die Ältestengreisin‡원로 마가타‡La vieja bruja‡La bruja anciana‡L\'Ancienne‡长者‡長者',
    nil,
    'Fale com Magatha no Penhasco do Trovão.‡Поковорите с Магатой в Громовом Утесе.‡Sprecht in Thunder Bluff mit Magatha.‡썬더 블러프에 있는 마가타와 대화하십시오.‡Habla con Magatha en Cima del Trueno.‡Habla con Magatha en Cima del Trueno.‡Parler à Magatha à Thunder Bluff.‡与雷霆崖的玛加萨谈一谈。‡與雷霆崖的瑪加薩談壹談。',
  }
},
[1064] = {
  {
    'Ajuda Renegada‡Помощь Отрекшихся‡Die Hilfe der Verlassenen‡포세이큰의 원조‡La ayuda de los Renegados‡Ayuda de los Renegados‡L\'aide des Réprouvés‡被遗忘者的援助‡被遺忘者的援助',
    nil,
    'Fale com a Boticária Zaqueia nos Poços das Visões, que ficam no Penhasco do Trovão.‡Поговорите с аптекаршей Замой у Прудов Видений в Громовом Утесе.‡Sprecht bei den Teichen der Visionen mit der Apothekerin Zamah.‡썬더 블러프의 예언의 웅덩이에 있는 연금술사 자마와 대화해야 합니다.‡Habla con la boticaria Zamah en las Pozas de las Visiones de Cima del Trueno.‡Habla con la boticaria Zamah en las Pozas de las Visiones de Cima del Trueno.‡Parler à l\'Apothicaire Zamah aux Bassins de la vision.‡和预见之池的药剂师扎玛谈一谈。‡和預見之池的藥劑師紮瑪談壹談。',
  }
},
[1065] = {
  {
    'A jornada para Serraria Tarren‡Путешествие на Мельницу Таррен‡Reise nach Tarrens Mühle‡타렌 밀농장으로의 모험‡Viaja a Molino Tarren‡Viaje a Molino Tarren‡Un voyage vers Moulin-de-Tarren‡塔伦米尔之旅‡塔倫米爾之旅',
    nil,
    'Leve o Bilhete de Zaqueia para o Boticário Lindolfo na Serraria Tarren.‡Принесите записку Замы аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle Zamahs Notiz.‡타렌 밀농장에 있는 연금술사 라이던에게 자마의 쪽지를 가져가야 합니다.‡Entrégale la nota de Zamah al boticario Lydon, que está en Molino Tarren.‡Entrégale la nota de Zamah al boticario Lydon, que está en Molino Tarren.‡Apporter la Note de Zamah à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把扎玛的信带给塔伦米尔的林度恩。‡把紮瑪的信帶給塔倫米爾的林度恩。',
  }
},
[1066] = {
  {
    'Sangue dos Inocentes‡Невинная кровь‡Das Blut Unschuldiger‡순결한 피‡Sangre de inocentes‡Sangre inocente‡Le sang des innocents‡无辜者之血‡無辜者之血',
    nil,
    'Leve 5 Ampolas de Sangue Inocente para o Boticário Lindolfo na Serraria Tarren.‡Принесите 5 фиалов крови невинных аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle 5 Phiolen mit dem Blut Unschuldiger.‡타렌 밀농장에 있는 연금술사 라이던에게 순결한 피가 든 유리병 5병을 가져가야 합니다.‡Lleva 5 viales de sangre de los inocentes al boticario Lydon de Molino Tarren.‡Lleva 5 viales de sangre inocente al boticario Lydon de Molino Tarren.‡Apporter 5 Fioles de Sang d\'innocent à l\'apothicaire Lydon à Moulin-de-Tarren.‡为塔伦米尔的药剂师林度恩收集5瓶无辜者之血。‡為塔倫米爾的藥劑師林度恩收集5瓶無辜者之血。',
  }
},
[1067] = {
  {
    'Volte ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Rückkehr nach Thunder Bluff‡썬더 블러프로의 귀환‡Vuelve a Cima del Trueno‡Regreso a Cima del Trueno‡Le retour à Thunder Bluff‡返回雷霆崖‡返回雷霆崖',
    nil,
    'Leve a Toxina do Lindolfo para a Boticária Zaqueia no Penhasco do Trovão.‡Отнесите отраву Лидона аптекарю Заме в Громовой Утес.‡Bringt Apothekerin Zamah in Thunder Bluff Lydons Toxin.‡썬더 블러프에 있는 연금술사 자마에게 라이던의 독약을 가져가야 합니다.‡Lleva la toxina de Lydon al boticario Zamah de Cima del Trueno.‡Lleva la toxina de Lydon a la boticaria Zamah de Cima del Trueno.‡Apporter la Toxine de Lydon à l\'Apothicaire Zamah à Thunder Bluff.‡把林度恩的毒药交给雷霆崖的药剂师扎玛。‡把林度恩的毒藥交給雷霆崖的藥劑師紮瑪。',
  }
},
[1068] = {
  {
    'Retalhando as máquinas retalhadoras‡Механические измельчители‡Schreddermaschinen‡벌목기‡Las sierras XT:4 y XT:9‡Las sierras XT:4 y XT:9‡Les machines à déchiqueter‡伐木机‡伐木機',
    nil,
    'Destrua os retalhadores XT:4 e XT:9 e, então, fale novamente com Seereth Quebra-pedra na fronteira entre a Cordilheira das Torres de Pedra e os Sertões.‡Уничтожьте шреддеры XT:4 и XT:9, затем вернитесь к Сирит Камнелом на границу Когтистых гор и Степи.‡Vernichtet die Schredder XT:4 und XT:9 und kehrt dann zu Seereth Stonebreak an der Grenze zwischen dem Steinkrallengebirge und dem Brachland zurück.‡벌목기 XT:4와 XT:9를 파괴한 다음 돌발톱 산맥과 불모의 땅의 경계에 있는 시리스 스톤브레이크에게 돌아가십시오.‡Destruye las sierras XT:4 y XT:9, a continuación vuelve a ver a Seereth Rompepedras, en la frontera entre Sierra Espolón y Los Baldíos.‡Destruye las sierras XT:4 y XT:9, a continuación vuelve a ver a Seereth Petrajada, en la frontera entre Sierra Espolón y Los Baldíos.‡Détruire les Déchiqueteurs XT4 et XT9, puis retourner voir Seereth Stonebreak à la frontière entre les Serres-Rocheuses et les Tarides.‡杀死伐木机XT:4和XT:9，然后向石爪山与贫瘠之地交界处的希雷斯·碎石复命。‡殺死伐木機XT:4和XT:9，然後向石爪山與貧瘠之地交界處的希雷斯·碎石復命。',
  }
},
[1069] = {
  {
    'Ovos de Aranha de Fundolimo‡Яйца мохового паука‡Eier der Kluftmoosspinnen‡동굴이끼거미알‡Huevos de arañas musgondo‡Huevos de araña musgondo‡Omelette à la mousse profonde‡深苔蜘蛛的卵‡深苔蜘蛛的卵',
    nil,
    'Leve 15 Ovos de Fundolimo para Cáliper Porcatraca em Vila Catraca.‡Принесите Мебоку Миззриксу из Кабестана 15 яиц мохового паука.‡Bringt Mebok Mizzyrix in Ratchet 15 Kluftmooseier.‡톱니항에 있는 메보크 미지릭스에게 동굴이끼거미알 15개를 가져가야 합니다.‡Llévale 15 huevos de Musgondo a Mebok Mizzyrix en Trinquete‡Llévale 15 huevos de Musgondo a Mebok Mizzyrix en Trinquete.‡Apporter 15 Œufs des mousses profondes à Mebok Mizzyrix à Ratchet.‡收集15颗深苔蜘蛛的卵，把它们交给棘齿城的麦伯克·米希瑞克斯。‡收集15顆深苔蜘蛛的卵，把它們交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[1070] = {
  {
    'Em guarda nas Torres de Pedra‡На страже в Когтистых горах‡Wache halten im Steinkrallengebirge‡돌발톱 산맥에서의 임무‡Estar de guardia en Espolón‡Estar de guardia en Espolón‡De garde dans les Serres-Rocheuses‡守卫石爪山‡守衛石爪山',
    nil,
    'Encontre Kaela Umbralança, que está de frente para o vale que adentra o Rochedo Cortavento, na Cordilheira das Torres de Pedra.‡Найдите Келу Копье Тени, которая наблюдает за долиной, выходящей к Утесу Ветрорезов в Когтистых горах.‡Sucht Kaela Shadowspear, die auf der Scherwindklippe im Steinkrallengebirge den Taleingang beobachtet.‡돌발톱 산맥에 있는 칼바람 바위산 입구에 계곡이 내려다보이는 곳에 캘라 섀도스피어를 찾아야 합니다.‡Encuentra a Kaela Lanzasombra contemplando la vista del valle a la entrada del Risco Cortaviento, en Sierra Espolón.‡Encuentra a Kaela Lanzasombra contemplando la vista del valle a la entrada del Risco Cortaviento, en Sierra Espolón.‡Retrouver Kaela Shadowspear qui surveille la vallée à l\'entrée de la combe des Cisailles dans les Serres-Rocheuses.‡找到位于石爪山脉狂风峭壁旁的山谷中的凯拉·影矛。‡找到位於石爪山脈狂風峭壁旁的山谷中的凱拉·影矛。',
  }
},
[1071] = {
  {
    'Adiamento gnômico‡Отсрочка для гнома‡Der Aufschub des Gnoms‡노움의 부탁‡Una tregua para el gnomo‡Una tregua para el gnomo‡Du répit pour un gnome‡侏儒学者‡侏儒學者',
    nil,
    'Mate 10 Madeireiros da Empreendimentos S.A. e 10 Desmatadores da Empreendimentos S.A. e fale novamente com Gaxim Deuxabu nas Torres de Pedra.‡Убейте 10 лесорубов и 10 лесозаготовителей Торговой Компании и вернитесь к Гаксиму Ржавошиппи в Каменный Коготь.‡Tötet 10 Holzfäller der Venture Co. und 10 Roder der der Venture Co. und kehrt dann zu Gaxim Rustfizzle im Steinkrallengebirge zurück.‡투자개발회사 나무꾼 10명 및 투자개발회사 벌채꾼 10명을 처치하고 돌발톱 산맥에 있는 각심 러스트피즐에게 돌아가십시오.‡Mata 10 leñeros de Ventura y Cía. y 10 deforestadores de Ventura y Cía. A continuación, vuelve a ver a Gaxim Silvóxido en Espolón.‡Mata a 10 leñadores de Ventura y Cía. y a 10 deforestadores de Ventura y Cía. A continuación, vuelve a ver a Gaxim Silvóxido en Espolón.‡Tuer 10 Déboiseurs de la KapitalRisk et 10 Défricheurs de la KapitalRisk, puis retourner voir Gaxim Rustfizzle dans les Serres-Rocheuses.‡杀掉10名风险投资公司樵夫和10名风险投资公司砍树工，然后向石爪山的加克希姆·尘链复命。‡殺掉10名風險投資公司樵夫和10名風險投資公司砍樹工，然後向石爪山的加克希姆·塵鏈復命。',
  }
},
[1072] = {
  {
    'Um velho colega‡Старый коллега‡Ein alter Kollege‡오랜 동료‡Un viejo colega‡Un viejo colega‡Un vieux collègue‡老同事‡老同事',
    nil,
    'Fale com Lomac Motopista em Altaforja.‡Поговорите с Ломаком Демонтирсом в Стальгорне.‡Sprecht mit Lomac Gearstrip in Ironforge.‡아이언포지에 있는 로막 기어스트립과 대화하십시오.‡Habla con Lomac Destrabaengranajes en Forjaz.‡Habla con Lomac Destrabaengranajes en Forjaz.‡Parler à Lomac Gearstrip à Ironforge.‡与铁炉堡的洛玛克·链带谈一谈。‡與鐵爐堡的洛瑪克·鏈帶談壹談。',
  }
},
[1073] = {
  {
    'Inaptidão + Reagentes = Diversão‡Неумение + реактивы = потеха!‡Stümperhaftigkeit + Chemikalien = Riesenspaß!‡어리석음 + 화학 물질 = 재미‡Ineptitud + Productos químicos = Diversión‡Ineptitud + Productos químicos = Diversión‡Inaptitude + Produits chimiques = Rigolo‡失职+药剂=快乐‡失職+藥劑=快樂',
    nil,
    'Leve 4 Poções Menores de Mana e 2 Elixires de Fortitude para Lomac Motopista em Altaforja.‡Принесите 4 слабых зелья маны и 2 эликсира стойкости Ломаку Демонтирсу в Стальгорн.‡Bringt Lomac Gearstrip in Ironforge 4 schwache Manatränke und 2 Elixire der Seelenstärke.‡아이언포지에 있는 로막 기어스트립에게 최하급 마나 물약 4개와 인내의 비약 2개를 가지고 가십시오.‡Lleva 4 pociones menores de maná y 2 elixires de fortaleza a Lomac Destrabaengranajes en Forjaz.‡Lleva 4 pociones de maná menores y 2 elixires de entereza menor a Lomac Destrabaengranajes en Forjaz.‡Apporter 4 Potions de mana mineures et 2 Elixirs de Robustesse mineure à Lomac Gearstrip à Ironforge.‡给铁炉堡的洛玛克·链带拿去4瓶初级法力药水和2瓶坚韧药剂。‡給鐵爐堡的洛瑪克·鏈帶拿去4瓶初級法力藥水和2瓶堅韌藥劑。',
  }
},
[1074] = {
  {
    'Inaptidão + Reagentes = Diversão‡Неумение + реактивы = потеха!‡Stümperhaftigkeit + Chemikalien = Riesenspaß!‡어리석음 + 화학 물질 = 재미‡Ineptitud + Productos químicos = Diversión‡Ineptitud + Productos químicos = Diversión‡Inaptitude + Produits chimiques = Rigolo‡失职+药剂=快乐‡失職+藥劑=快樂',
    nil,
    'Leve o Nitromirglicerônio para Gaxim Deuxabu nas Torres de Pedra.‡Отнесите нитромирглицероний Гаксиму Ржавошиппи в Каменный Коготь.‡Bringt Gaxim Rustfizzle im Steinkrallengebirge das Nitromirglyceronium.‡돌발톱산맥에 있는 각심 러스트피즐에게 니트로미르글리세로니움을 가져가야 합니다.‡Lleva el nitromirgliceronio de vuelta a Gaxim Silvóxido en Espolón.‡Lleva el nitromirgliceronio de vuelta a Gaxim Silvóxido en Espolón.‡Rapporter le Nitromirglyceronium à Gaxim Rustfizzle, dans les Serres-Rocheuses.‡将硝酸甘油炸药带回石爪山，交给加克希姆·尘链。‡將硝酸甘油炸藥帶回石爪山，交給加克希姆·塵鏈。',
  }
},
[1075] = {
  {
    'Um pergaminho de Mauren‡Свиток от Маурена‡Eine Rolle von Mauren‡마우렌의 두루마리‡Un pergamino de Mauren‡Un pergamino de Mauren‡Un parchemin de Collin Mauren‡马伦的卷轴‡馬倫的卷軸',
    nil,
    'Encontre Collin Mauren em Ventobravo.‡Найдите в Штормграде Коллина Маурена.‡Sucht Collin Mauren in Stormwind auf.‡스톰윈드에 있는 콜린 마우렌을 찾아야 합니다.‡Encuentra a Collin Mauren en Ventormenta.‡Encuentra a Collin Mauren en Ventormenta.‡Trouver Collin Mauren à Stormwind.‡找到暴风城的科林·马伦。‡找到暴風城的科林·馬倫。',
  }
},
[1076] = {
  {
    'Redemoinhos no Cerro Oeste‡Демоны в Западном Крае‡Teufel in Westfall‡서부 몰락지대의 악령‡Demonios en Páramos de Poniente‡Demonios en los Páramos de Poniente‡Des diables dans la marche de l\'Ouest‡西部荒野中的恶魔‡西部荒野中的惡魔',
    nil,
    'Leve os Destroços do Redemoinho de Poeira para Álvaro Columba em Ventobravo.‡Принесите прах Пыледемона Коллину Маурену в Штормград.‡Bringt Collin Mauren in Stormwind die Überreste eines Staubteufels.‡스톰윈드에 있는 콜린 마우렌에게 먼지 악령의 파편을 가져가야 합니다.‡Lleva restos de demonio de polvo a Collin Mauren en Ventormenta.‡Lleva restos de demonio de polvo a Collin Mauren en Ventormenta.‡Apporter des Débris de Diable de poussière à Collin Mauren à Stormwind.‡将尘魔的残骸带回给暴风城的科林·玛林。‡將塵魔的殘骸帶回給暴風城的科林·瑪林。',
  }
},
[1077] = {
  {
    'Entrega especial para Gaxim‡Особая посылка для Гаксима‡Speziallieferung für Gaxim‡각심을 위한 특별한 선물‡Entrega especial para Gaxim‡Entrega especial para Gaxim‡Livraison spéciale pour Gaxim‡给加克希姆的特快专递‡給加克希姆的特快專遞',
    nil,
    'Leve o Pergaminho de Mensagem para Gaxim Deuxabu nas Torres de Pedra.‡Отнесите свиток с посланием Гаксиму Ржавошиппи в Каменный Коготь.‡Bringt Gaxim Rustfizzle im Steinkrallengebirge die Rolle der Nachrichtenübermittlung.‡돌발톱 산맥에 있는 각심 러스트피즐에게 교신의 두루마리를 가져가야 합니다.‡Lleva el Pergamino de mensajes de vuelta a Gaxim Silvóxido en Espolón.‡Lleva el Pergamino de mensajes de vuelta a Gaxim Silvóxido en Espolón.‡Apporter le Parchemin de contrôle à Gaxim Rustfizzle dans les Serres-Rocheuses.‡将通讯卷轴交给石爪山的加克希姆·尘链。‡將通訊卷軸交給石爪山的加克希姆·塵鏈。',
  }
},
[1078] = {
  {
    'Coleta para Columba‡Поиск для Маурена‡Suche für Mauren‡마우렌 돕기‡Escamas cristalizadas para Mauren‡Escamas cristalizadas para Mauren‡Des retrouvailles pour Mauren‡完鳞归玛伦‡完鱗歸瑪倫',
    nil,
    'Leve 8 Escamas Cristalizadas para Álvaro Columba em Ventobravo.‡Принесите 8 кристаллических чешуй Коллину Маурену в Штормград.‡Bringt Collin Mauren in Stormwind 8 kristallisierte Schuppen.‡스톰윈드에 있는 콜린 마우렌에게 비늘 결정체 8개를 가져가야 합니다.‡Lleva 8 escamas cristalizadas a Collin Mauren en Ventormenta.‡Lleva 8 escamas cristalizadas a Collin Mauren en Ventormenta.‡Apporter 8 Ecailles de cristal à Collin Mauren à Stormwind.‡给暴风城的科林·玛伦带回8片水晶鳞片。‡給暴風城的科林·瑪倫帶回8片水晶鱗片。',
  }
},
[1079] = {
  {
    'Operações secretas – Alfa‡Секретная операция – Альфа‡Geheimoperation Alpha‡비밀 작전 - 1단계‡Operaciones secretas: plan A‡Operaciones secretas: plan A‡Opérations secrètes – Plan A‡隐秘行动：A‡隱秘行動：A',
    nil,
    'Consiga os Planos de Engenharia da Empreendimentos S.A. na serraria, no Rochedo Cortavento.‡Добудьте технические чертежи Торговой компании с лесопилки на Утесе Ветрорезов.‡Holt die Ingenieurspläne der Venture Company aus dem Sägewerk auf der Scherwindklippe.‡칼바람 바위산에 있는 제재소에서 투자개발회사의 토목 공사 계획서를 찾아 와야 합니다.‡Recupera los planos de ingeniería de Ventura y Cía. de la serrería en el Risco Cortaviento.‡Recupera los planos de ingeniería de Ventura y Cía. de la serrería en el Risco Cortaviento.‡Récupérer les Plans d\'ingénierie de la KapitalRisk dans la scierie de la Combe des Cisailles.‡将风险投资公司工程计划书从峭壁湖的伐木场中偷出来。‡將風險投資公司工程計劃書從峭壁湖的伐木場中偷出來。',
  }
},
[1080] = {
  {
    'Operações secretas - Beta‡Секретная операция – Бета‡Geheimoperation Beta‡비밀 작전 - 2단계‡Operaciones secretas: plan B‡Operaciones secretas: plan B‡Opérations secrètes – Plan B‡隐秘行动：B‡隱秘行動：B',
    nil,
    'Consiga as Cartas da Empreendimentos S.A. na Mina Cortavento, que fica no extremo leste do Rochedo Cortavento.‡Добудьте документы Торговой компании из Рудника Ветрорезов у восточного края Утеса Ветрорезов.‡Holt die Dokumente der Venture Company aus der Scherwindmine am Ostende der Scherwindklippe.‡칼바람 바위산의 동쪽 끝에 있는 칼바람 광산에서 투자개발회사의 편지를 찾아와야 합니다.‡Recupera las cartas de Ventura y Cía. de la Mina Cortaviento, en el extremo este del Risco Cortaviento.‡Recupera las cartas de Ventura y Cía. de la Mina Cortaviento, en el extremo este del Risco Cortaviento.‡Récupérer les Notes de la KapitalRisk dans la mine des Cisailles à l\'extrémité est de la Combe des Cisailles.‡将风险投资公司函件从峭壁湖最东面的风剪矿洞中偷出来。‡將風險投資公司函件從峭壁湖最東面的風剪礦洞中偷出來。',
  }
},
[1081] = {
  {
    'A recepção de Tyrande‡Приглашение от Тиранды‡Tyrandes Empfang‡티란데의 환대‡El recibimiento de Tyrande‡El recibimiento de Tyrande‡Réception par Tyrande‡泰兰德的接待‡泰蘭德的接待',
    nil,
    'Encontre Tyrande Murmuréolo em Darnassus.‡Найдите в Дарнассе Тиранду Шелест Ветра.‡Sucht Tyrande Whisperwind in Darnassus auf.‡다르나서스에서 티란데 위스퍼윈드를 찾아야 합니다.‡Encuentra a Tyrande Susurravientos en Darnassus.‡Encuentra a Tyrande Susurravientos en Darnassus.‡Trouver Tyrande Whisperwind à Darnassus.‡到达纳苏斯去找到泰兰德·语风。‡到達納蘇斯去找到泰蘭德·語風。',
  }
},
[1082] = {
  {
    'Deixando a Sentinela Tenysil a par de tudo‡Новости для часового Тенисил‡Neuigkeiten für Schildwache Thenysil‡파수꾼 테니실‡Noticias para Centinela Thenysil‡Noticias para Centinela Thenysil‡Une mise à jour pour la Sentinelle Thenysil‡向塞恩希尔报告‡向塞恩希爾報告',
    nil,
    'Fale novamente com a Sentinela Tenysil no Vale Gris.‡Вернитесь к часовому Тенисил в Ясеневый лес.‡Kehrt zu Schildwache Thenysil in Ashenvale zurück.‡잿빛 골짜기에 있는 파수꾼 테니실에게 돌아가십시오.‡Ve a ver a la centinela Thenysil en Vallefresno.‡Ve a ver a la centinela Thenysil en Vallefresno.‡Retourner voir la Sentinelle Tara Thenysil en Ashenvale.‡向灰谷的哨兵塞恩希尔复命。‡向灰谷的哨兵塞恩希爾復命。',
  }
},
[1083] = {
  {
    'Espíritos enfurecidos‡Разъяренные духи‡Wütende Geister‡분노한 정령들‡Los espíritus enfurecidos‡Los espíritus iracundos‡Esprits enragés‡怒灵‡怒靈',
    nil,
    'Leve 8 Brasas Fumegantes de quaisquer elementais do fogo do Vale Carbonizado a Kaela Umbralança nas Torres de Pedra.‡Принесите 8 тлеющих углей от любых элементалей огня из Обугленной долины Келе Копье Тени в Когтистые горы.‡Bringt Kaela Shadowspear im Steinkrallengebirge 8 glimmende Überreste der Feuerelementare des verbrannten Tals.‡돌발톱 산맥에 있는 캘라 섀도스피어에게 잿더미 계곡에 있는 불의 정령들로부터 얻은 꺼져 가는 불씨 8개를 가져가야 합니다.‡Lleva 8 ascuas ardientes de cualquiera de los elementales de fuego de la Vega Carbonizada a Kaela Lanzasombra, en Espolón.‡Lleva 8 ascuas ardientes de cualquiera de los elementales de fuego de la Vega Carbonizada a Kaela Lanzasombra, en Espolón.‡Apporter 8 Braises ardentes provenant de n\'importe quel élémentaire de feu du Val calciné à Kaela Shadowspear, dans les Serres-Rocheuses.‡从焦炭谷中的任意火元素身上收集8个闷烧余烬，把它们交给石爪山的凯拉·影矛。‡從焦炭谷中的任意火元素身上收集8個悶燒余燼，把它們交給石爪山的凱拉·影矛。',
  }
},
[1084] = {
  {
    'Ancientes feridos‡Раны Дерев‡Verletzte Urtume‡상처 입은 고대정령‡Los antárboles corruptos‡Los antárboles corruptos‡Les Anciens blessés‡受伤的古树‡受傷的古樹',
    nil,
    'Leve alguns Estilhaços Corroídos para Kaela Umbralança nas Torres de Pedra.‡Принесите образец ржавой шрапнели Келе Копье Тени в Каменный Коготь.‡Bringt Kaela Shadowspear im Steinkrallengebirge ein Stück eines zerfressenen Spans.‡돌발톱 산맥에 있는 캘라 섀도스피어에게 부식된 파편 1개를 가져가야 합니다.‡Lleva una pieza de metralla corroída a Kaela Lanzasombra en Espolón.‡Lleva una pieza de metralla corroída a Kaela Lanzasombra en Espolón.‡Apporter un morceau de Shrapnel abîmé à Kaela Shadowspear, dans les Serres-Rocheuses.‡给石爪山的凯拉·影矛带回一块被腐蚀的弹片。‡給石爪山的凱拉·影矛帶回壹塊被腐蝕的彈片。',
  }
},
[1085] = {
  {
    'Em guarda nas Torres de Pedra‡На страже в Когтистых горах‡Wache halten im Steinkrallengebirge‡돌발톱 산맥에서의 임무‡Estar de guardia en Espolón‡Estar de guardia en Espolón‡De garde dans les Serres-Rocheuses‡守卫石爪山‡守衛石爪山',
    nil,
    'Fale com Gaxim.‡Поговорите с Гаксимом.‡Sprecht mit Gaxim.‡각심과 대화하십시오.‡Habla con Gaxim.‡Habla con Gaxim.‡Parler à Gaxim.‡与加克希姆谈一谈。‡與加克希姆談壹談。',
  }
},
[1086] = {
  {
    'Aeroporto de máquinas voadoras‡Аэропорт ветролетов‡Der Flugapparathafen‡비행장‡El minipuerto‡El aeropuerto de máquinas voladoras‡L\'aéroport de la machine volante‡地精空港‡地精空港',
    nil,
    'Leve o Vaporizador Tóxico até o aeródromo da Empreendimentos S.A. e depois fale com a Boticária Zaqueia.‡Отнесите распылитель ядовитого тумана в аэропорт Торговой компании и вернуться к аптекарю Заме.‡Bringt den Toxinvernebler zum Flugplatz der Venture Company und kehrt dann zu Apothekerin Zamah zurück.‡투자개발회사의 비행장에 독가스통을 갖다 놓고 연금술사 자마에게 돌아와야 합니다.‡Lleva la niebla tóxica al minipuerto de Ventura y Cía. e informa al boticario Zamah.‡Lleva el nublador tóxico al aeropuerto de Ventura y Cía. e informa a la boticaria Zamah.‡Apporter le Brouillard toxique à l\'aéroport de la KapitalRisk, puis retourner voir l\'Apothicaire Zamah.‡把剧毒粮草带到风险投资公司的空港去，然后向药剂师扎玛复命。‡把劇毒糧草帶到風險投資公司的空港去，然後向藥劑師紮瑪復命。',
  }
},
[1087] = {
  {
    'O legado de Cenarius‡Наследие Кенария‡Cenarius\' Vermächtnis‡세나리우스의 유산‡El legado de Cenario‡El legado de Cenarius‡L\'héritage de Cénarius‡塞纳留斯的遗产‡塞納留斯的遺產',
    nil,
    'Mate 4 Filhos de Cenarius, 4 Filhas de Cenarius e 4 Botânicos Cenarianos para Braelyn Manígnea, no Retiro Rocha do Sol.‡Убейте 4 сыновей Кенария, 4 дочерей Кенария и 4 кенарийских ботаников по поручению Брайлин Огненной Длани из Приюта у Солнечного Камня.‡Tötet für Brealyn Firehand in Sonnenfels 4 Söhne des Cenarius, 4 Töchter des Cenarius und 4 cenarische Botaniker.‡해바위 야영지 근처에 있는 브랠린 파이어핸드를 위해 세나리우스의 후예, 세나리우스의 딸, 그리고 세나리온 식물학자들을 각각 4명씩 처치해야 합니다.‡Mata 4 Hijos de Cenario, 4 Hijas de Cenario y 4 botánicos Cenarion para Braelyn Manofuego, cerca del Refugio Roca del Sol.‡Mata a 4 Hijos de Cenarius, 4 Hijas de Cenarius y 4 botánicas Cenarion para Braelyn Manofuego, cerca del Refugio Roca del Sol.‡Tuer 4 Fils de Cénarius, 4 Filles de Cénarius et 4 Botanistes cénariens pour Braelyn Firehand, près de la retraite de Roche-Soleil.‡为石爪峰附近的布莱林·火拳杀死4名塞纳留斯的儿子，4名塞纳留斯的女儿以及4名塞纳里奥植物学家。‡為石爪峰附近的布萊林·火拳殺死4名塞納留斯的兒子，4名塞納留斯的女兒以及4名塞納裏奧植物學家。',
  }
},
[1088] = {
  {
    'Ornanos‡Гордан‡Ordanus‡오르다누스‡Ordanus‡Ordanus‡Ordanus‡奥达努斯‡奧達努斯',
    nil,
    'Leve a Cabeça de Ornanos a Braelyn Manígnea no Retiro Rocha do Sol.‡Принесите голову Хорданиуса Брайлин Огненной Длани к Приюту у Солнечного Камня.‡Bringt Braelyn Firehand in der Nähe von Sonnenfels Ordanus\' Kopf.‡오르다누스를 처치하고 그 증거로 그의 머리 장식을 해바위 야영지 근처에 있는 브랠린 파이어핸드에게 가져가야 합니다.‡Lleva la cabeza de Ordanus a Braelyn Manofuego cerca del Refugio Roca del Sol.‡Lleva la cabeza de Ordanus a Braelyn Manofuego cerca del Refugio Roca del Sol.‡Apporter la Tête d\'Ordanus à Braelyn Firehand, près de la Retraite de Roche-Soleil.‡将奥达努斯的头颅带给石爪峰的布莱林·火拳。‡將奧達努斯的頭顱帶給石爪峰的布萊林·火拳。',
  }
},
[1089] = {
  {
    'O Retiro‡Логово‡Der Höhlenbau‡갈퀴발톱굴‡El Cubil‡El Cubil‡L\'Antre‡大兽穴‡大獸穴',
    nil,
    'Vá ao Retiro da Garra no Morro das Torres de Pedra. Usando a Chave do Guardião do Portal, obtenha os itens escondidos pelos druidas. Use esses itens para abrir o Tesouro do Retiro da Garra.‡Отправляйтесь к пещере на Пике Каменного Когтя. При помощи Ключа Хранителя Врат добудьте предметы, спрятанные друидами. Используйте эти предметы для того, чтобы открыть Сокровищницу Пещеры Когтей.‡Begebt Euch zum Höhlenbau auf den Steinkrallengipfel. Benutzt den Torhüterschlüssel, um Euch die versteckten Gegenstände der Druiden zu besorgen. Benutzt diese Gegenstände, um den Hort des Krallenbaus zu öffnen.‡돌발톱 봉우리에 있는 갈퀴발톱굴로 가야 합니다. 문지기의 열쇠를 이용해 드루이드의 숨겨진 물건을 얻어야 합니다. 그 물건을 이용해 갈퀴발톱굴 저장고를 여십시오.‡Ve a El Cubil, en la Cima del Espolón. Utiliza la llave del Guardián y consigue los objetos ocultos del druida. Utiliza esos objetos para abrir el tesoro de El Cubil del Espolón.‡Ve a El Cubil, en la Cima del Espolón. Utiliza la llave del Guardián y consigue los objetos ocultos del druida. Utiliza esos objetos para abrir el tesoro de El Cubil del Espolón.‡Aller dans l’Antre, sur le Pic des Serres-Rocheuses. En utilisant la Clé du gardien, obtenir les objets cachés des druides. Utiliser ces objets pour ouvrir le Trésor de l\'Antre des Serres.‡到石爪峰上的洞穴中去，使用守门人的钥匙拿到能打开石爪峰顶的猛禽洞穴储藏室的物品。‡到石爪峰上的洞穴中去，使用守門人的鑰匙拿到能打開石爪峰頂的猛禽洞穴儲藏室的物品。',
  }
},
[1090] = {
  {
    'Ordens de Hanfritz‡Приказы Геренцо‡Gerenzos Befehle‡게렌조의 지시‡Órdenes de Gerenzo‡Órdenes de Gerenzo‡Les ordres de Gerenzo‡格雷苏的要求‡格雷蘇的要求',
    nil,
    'Pegue o minério misterioso com Piznik depois que ele terminar de minerá-lo.‡Возьмите образец загадочной руды у Пузника после того, как он ее добудет.‡Nehmt das rätselhafte Erz, nachdem Piznik es fertig abgebaut hat.‡피즈닉이 미확인 광석을 캐내면 그 광석을 받아야 합니다.‡Consigue el misterioso mineral de Piznik cuando termine de extraerlo.‡Consigue el misterioso mineral de Piznik cuando termine de extraerlo.‡Obtenir le minerai mystérieux de Piznik après qu\'il l’aura extrait.‡在匹兹尼克完成开采之后拿到神秘矿石。‡在匹茲尼克完成開采之後拿到神秘礦石。',
  }
},
[1091] = {
  {
    'Deixando Kaela a par de tudo‡Новости для Каэлы‡Kaelas Update‡캘라를 위한 새로운 정보‡Noticias para Kaela‡Noticias para Kaela‡Des nouvelles pour Kaela‡向凯拉回报‡向凱拉回報',
    nil,
    'Leve as Cartas da Empreendimentos S.A. para Kaela Umbralança.‡Отнесите документы Торговой компании Келе Копье Тени.‡Bringt Kaela Shadowspear die Dokumente der Venture Company.‡캘라 섀도스피어에게 투자개발회사의 편지를 가져가야 합니다.‡Lleva las cartas de Ventura y Cía. a Kaela Lanzasombra.‡Lleva las cartas de Ventura y Cía. a Kaela Lanzasombra.‡Apporter les Notes de la KapitalRisk à Kaela Shadowspear.‡将风险投资公司函件带给凯拉·影矛。‡將風險投資公司函件帶給凱拉·影矛。',
  }
},
[1092] = {
  {
    'Ordens de Hanfritz‡Приказы Геренцо‡Gerenzos Befehle‡게렌조의 지시‡Órdenes de Gerenzo‡Órdenes de Gerenzo‡Les ordres de Gerenzo‡格雷苏的要求‡格雷蘇的要求',
    nil,
    'Entregue o Minério Não Identificado a Zé Fízzica na Cordilheira das Torres de Pedra.‡Доставьте Неопознанную Руду Зизу Физзиксу в Когтистые горы.‡Bringt Ziz Fizziks im Steinkrallengebirge das unbekannte Erz.‡돌발톱 산맥에 있는 지즈 피직스에게 미확인 광석을 가져가야 합니다.‡Lleva el mineral sin identificar a Ziz Fizziks en Sierra Espolón.‡Lleva la mena sin identificar a Ziz Fizziks, en Sierra Espolón.‡Remettre le Minerai non identifié à Ziz Fizziks dans les Serres-Rocheuses.‡将未经化验的矿石送到石爪山的菲兹克斯那里。‡將未經化驗的礦石送到石爪山的菲茲克斯那裏。',
  }
},
[1093] = {
  {
    'Super Ceifador 6000‡Супер-дровосек 6000‡Superschnitter 6000‡슈퍼 절단기 6000‡Súper Leñadora 6000‡Súper Segadora 6000‡Super-Découpeur 6000‡超级收割机6000‡超級收割機6000',
    nil,
    'Consiga os Diagramas do Super Ceifador 6000 e entregue-os a Zé Fízzica na Cordilheira das Torres de Pedra.‡Добудьте чертежи "Супер-дровосека 6000" для Зиза Физзикса с Когтистых гор.‡Besorgt für Ziz Fizziks im Steinkrallengebirge die Blaupausen für den Superschnitter 6000.‡돌발톱 산맥에 있는 지즈 피직스를 위해 슈퍼 절단기 6000 설계도를 입수해야 합니다.‡Consigue los planos de la Súper Leñadora 6000 para Ziz Fizziks de Sierra Espolón.‡Consigue los planos de la Súper Segadora 6000 para Ziz Fizziks en Sierra Espolón.‡Trouver le Plan du Super-Découpeur 6000 pour Ziz Fizziks dans les Serres-Rocheuses.‡为石爪山的菲兹克斯偷来超级收割机6000型的设计图。‡為石爪山的菲茲克斯偷來超級收割機6000型的設計圖。',
  }
},
[1094] = {
  {
    'Instruções adicionais‡Дальнейшие указания‡Weitere Instruktionen‡또 다른 지시 사항‡Más instrucciones‡Más instrucciones‡D\'autres instructions‡新的指示‡新的指示',
    nil,
    'Entregue o Envelope Selado para Cobogó nos Sertões.‡Доставьте запечатанный конверт Пароклапану в Степи.‡Bringt Sputtervalve im Brachland den versiegelten Umschlag.‡불모의 땅에 있는 스퍼터밸브에게 봉인된 편지를 전달해야 합니다.‡Lleva el sobre sellado a Petardol en Los Baldíos.‡Entrega el sobre lacrado a Petardol en Los Baldíos.‡Remettre l\'Enveloppe scellée à Sputtervalve dans les Tarides.‡将密封的信封交给贫瘠之地的斯布特瓦夫。‡將密封的信封交給貧瘠之地的斯布特瓦夫。',
  }
},
[1095] = {
  {
    'Instruções adicionais‡Дальнейшие указания‡Weitere Instruktionen‡추가 지령‡Más instrucciones‡Nuevas instrucciones‡D\'autres instructions‡新的指示‡新的指示',
    nil,
    'Leve as novas ordens a Zé Fízzica na Cordilheira das Torres de Pedra.‡Отнесите Зизу Физзиксу в Когтистых горах новые приказы.‡Bringt Ziz Fizziks im Steinkrallengebirge die neuen Befehle.‡돌발톱 산맥에 있는 지즈 피직스에게 새로운 명령을 전해야 합니다.‡Lleva las nuevas órdenes a Ziz Fizziks en Sierra Espolón.‡Lleva las nuevas órdenes a Ziz Fizziks en Sierra Espolón.‡Apporter les nouveaux ordres à Ziz Fizziks dans les Serres-Rocheuses.‡把新的指令带给石爪山的菲兹克斯。‡把新的指令帶給石爪山的菲茲克斯。',
  }
},
[1096] = {
  {
    'Hanfritz Schaventorck‡Геренцо Терминатрикс‡Gerenzo Wrenchwhistle‡게렌조 렌치휘슬‡Gerenzo Silbillave‡Gerenzo Silbillave‡Gerenzo Wrenchwhistle‡格雷苏‡格雷蘇',
    nil,
    'Leve o Braço Mecânico do Hanfritz a Zé Fízzica na Cordilheira das Torres de Pedra.‡Принесите механическую руку Геренцо Терминатрикса Зиззу Физзиксу в Когтистые горы.‡Bringt Ziz Fizziks im Steinkrallengebirge Gerenzo Wrenchwhistles mechanischen Arm.‡돌발톱 산맥에 있는 지즈 피직스에게 게렌조의 기계팔을 가져가야 합니다.‡Lleva el brazo mecánico de Gerenzo Silbillave a Ziz Fizziks en Sierra Espolón.‡Lleva el brazo mecánico de Gerenzo Silbillave a Ziz Fizziks, en Sierra Espolón.‡Apporter le Bras mécanique de Gerenzo Wrenchwhistle à Ziz Fizziks dans les Serres-Rocheuses.‡将格雷苏的机械臂带给石爪山脉的菲兹克斯。‡將格雷蘇的機械臂帶給石爪山脈的菲茲克斯。',
  }
},
[1097] = {
  {
    'Tarefa de Elmore‡Просьба Элмора‡Elmores Aufgabe‡엘모어의 임무‡La tarea de Elmore‡La tarea de Elmore‡La quête d\'Elmore‡艾尔默的任务‡艾爾默的任務',
    nil,
    'Fale com Grimand Elmore.‡Поговорите с Гримандом Элмором.‡Sprecht mit Grimand Elmore.‡그리만트 엘모어와 대화해야 합니다.‡Habla con Grimand Elmore.‡Habla con Grimand Elmore.‡Parler à Grimand Elmore.‡与格瑞曼德·艾尔默谈一谈。‡與格瑞曼德·艾爾默談壹談。',
  }
},
[1098] = {
  {
    'Sicários na Presa Negra‡Пропавшие стражи смерти‡Todespirscher in Shadowfang‡그림자송곳니 성채의 죽음의추적자‡Mortacechadores en Colmillo Oscuro‡Mortacechadores en Colmillo Oscuro‡Des Traqueurs noirs à Ombrecroc‡影牙城堡里的亡灵哨兵‡影牙城堡裏的亡靈哨兵',
    nil,
    'Encontre o Sicário Admeto e o Sicário Vicente.‡Найдите стражей смерти Адаманта и Винсента.‡Sucht die Todespirscher Adamant und Vincent.‡죽음의추적자 아다만트와 죽음의추적자 빈센트를 찾아야 합니다.‡Encuentra a los mortacechadores Adamant y Vincent.‡Encuentra a los mortacechadores Adamant y Vincent.‡Trouver les Traqueurs noirs Adamant et Vincent.‡找到亡灵哨兵阿达曼特和亡灵哨兵文森特。‡找到亡靈哨兵阿達曼特和亡靈哨兵文森特。',
  }
},
