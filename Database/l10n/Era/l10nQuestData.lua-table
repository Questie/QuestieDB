[8882] = {
  {
    'Lançador de salva de fogos de artifício‡Пусковая установка для фейерверков‡Zünder für Raketenbündel‡연발탄 발사대‡Lanzacohetes‡Lanzatracas‡Le lanceur de chapelets‡烟花束发射器‡煙花束發射器',
