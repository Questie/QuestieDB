[1301] = {
  {
    'James Hyal‡Джеймс Хьяль‡James Hyal‡제임스 하이얄‡James Hyal‡James Hyal‡James Hyal‡詹姆斯·海厄尔‡詹姆斯·海厄爾',
    nil,
    'Fale com Vincent Hyal no Porto de Menethil.‡Поговорите с Винсентом Хьялом в Гавани Менетилов.‡Sprecht mit Vincent Hyal im Hafen von Menethil.‡메네실 항구에 있는 빈센트 하이얄과 대화해야 합니다.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Discuter avec Vincent Hyal au Port de Menethil.‡和米奈希尔港的文森特·海厄尔谈一谈。‡和米奈希爾港的文森特·海厄爾談壹談。',
  }
},
[1302] = {
  {
    'James Hyal‡Джеймс Хьяль‡James Hyal‡제임스 하이얄‡James Hyal‡James Hyal‡James Hyal‡詹姆斯·海厄尔‡詹姆斯·海厄爾',
    nil,
    'Fale com o Tabelião Lendry em Theramore.‡Поговорите с клерком Лендри в Тераморе.‡Sprecht mit Amtmann Lendry in Theramore.‡테라모어에 있는 서기관 렌드리와 대화해야 합니다.‡Ve a Theramore y habla con el dependiente Lendry.‡Habla con Clerk Lendry en Theramore.‡Parler au greffier Lendry à Theramore.‡和塞拉摩的书记员伦德瑞谈一谈。‡和塞拉摩的書記員倫德瑞談壹談。',
  }
},
[1318] = {
  {
    'Negócios pendentes‡Кое-какие дела с Гордоками‡Die offene Rechnung der Gordok‡고르독 일 마무리‡Asunto Gordok sin finiquitar‡Asuntos Pendientes con Gordok‡Affaires inachevées chez les Gordok‡戈多克食人魔的事务‡戈多克食人魔的事務',
    nil,
    'Encontre as Manoplas do Poder de Gordok e devolva-as para o Capitão Kebrapaw no Gládio Cruel.|nDe acordo com Kebrapaw, a "história de ancião diz que Tortheldrin — um elfo "medonho" que se diz príncipe — roubou as manoplas de um dos reis Gordok.‡Добудьте латную рукавицу Мощи Гордока и вернитесь с ней к капитану Давигрому в Забытом Городе.|nПо словам Давигрома, в "старых байках" говорится, что Тортелдрин – "страшный эльф", называющий себя принцем, – похитил эту рукавицу у одного из королей Гордоков.‡Findet die Stulpen der Gordokmacht und bringt sie zu Captain Kromcrush in Düsterbruch.|nKromcrush zufolge sagen die "Alte Zeit Geschichten", dass Tortheldrin - ein "gruseliger" Elf, der sich selbst als Prinz bezeichnet- sie einem der Gordokkönige gestohlen hat.‡권력의 고르독 건틀릿을 찾아 혈투의 전장에 있는 대장 크롬크러쉬에게 가져가야 합니다.|n크롬크러쉬의 "옛날 얘기"에 따르면 자칭 왕자라는 토르텔드린이라는 이름의 "기분 나쁜" 엘프가 고르독 왕에게서 빼앗아갔다고 합니다.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre.|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre.|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Trouvez le Gantelet de Puissance Gordok et rendez-le au capitaine Kromcrush à Hache-tripes.|nSelon Kromcrush, les histoires des « vieux » racontent que Tortheldrin – un « vilain » elfe qui se fait appeler prince – l’a volé à l’un des rois gordok.‡找到戈多克力量护手，并将它交给厄运之槌的克罗卡斯。|n根据克罗卡斯所说的，“传说”自称是王子的精灵托塞德林从一名戈多克食人魔手中偷走了那件神器。‡找到戈多克力量護手，並將它交給厄運之槌的克羅卡斯。|n根據克羅卡斯所說的，“傳說”自稱是王子的精靈托塞德林從壹名戈多克食人魔手中偷走了那件神器。',
  }
},
[1319] = {
  {
    'O escudo negro‡Черный Щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Caz Doismancal em Theramore.‡Покажите потемневший железный Щит Казу Дваждыдвацу из Терамора.‡Zeigt den geschwärzten Eisenschild Caz Twosprocket in Theramore.‡테라모어에 있는 카즈 투스프로켓에게 타락의 철제 방패를 보여줘야 합니다.‡Ve a Theramore y enseña el escudo de hierro ennegrecido a Caz Dosdientes.‡Ve a Theramore y enseña el escudo de hierro ennegrecido a Caz Dosdientes.‡Montrer le Bouclier en fer noirci à Caz Twosprocket à Theramore.‡把被熏黑的铁盾牌拿给塞拉摩的卡兹·双链看一看。‡把被熏黑的鐵盾牌拿給塞拉摩的卡茲·雙鏈看壹看。',
  }
},
[1320] = {
  {
    'O escudo negro‡Черный Щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Fale com o Capitão Garrido Valente em Theramore.‡Поговорите с капитаном Гарраном Ваймсом в Тераморе.‡Sprecht mit Captain Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스와 대화해야 합니다.‡Ve a Theramore y habla con el capitán Garran Vimes.‡Ve a Theramore y habla con el capitán Garran Vimes.‡Discuter avec le capitaine Garran Vimaire à Theramore.‡与塞拉摩的盖兰·维米斯队长谈一谈。‡與塞拉摩的蓋蘭·維米斯隊長談壹談。',
  }
},
[1321] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Do\'gol na Aldeia Muralha Verde.‡Покажите потемневший железный щит До\'голу из Деревни Гиблотопь.‡Zeigt den geschwärzten Eisenschild Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골에게 타락의 철제 방패를 보여 주십시오.‡Muestra el escudo de hierro ennegrecido a Do\'gol del Poblado Murohelecho.‡Muestra el escudo de hierro ennegrecido a Do\'gol en el Poblado Murohelecho.‡Montrer le Bouclier en fer noirci à Do\'gol au village de Mur-de-Fougères.‡把被熏黑的铁盾牌拿给蕨墙村的杜高尔看一看。‡把被熏黑的鐵盾牌拿給蕨墻村的杜高爾看壹看。',
  }
},
[1322] = {
  {
    'O escudo negro‡Черный Щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Obtenha 6 Vesículas de Peçonha Ácida para Do\'gol na Aldeia Muralha Verde.‡Добудьте 6 ядовитых желез Паука Черного Тумана для До\'гола из Деревни Гиблотопь.‡Bringt 6 säurehaltige Giftbeutel zu Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골을 위해 산성 독주머니 6개를 구해야 합니다.‡Consigue 6 glándulas de veneno ácido para Do\'gol del Poblado Murohelecho.‡Obtén 6 glándulas de veneno ácido para Do\'gol en Poblado Murohelecho.‡Trouver 6 Sacs de Venin acide pour Do\'gol de Mur-de-Fougères.‡为蕨墙村的杜高尔收集6个酸性毒囊。‡為蕨墻村的杜高爾收集6個酸性毒囊。',
  }
},
[1323] = {
  {
    'O escudo negro‡Черный Щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Fale com Krog na Aldeia Muralha Verde.‡Поговорите с Крогом в Деревне Гиблотопь.‡Sprecht mit Krog in Brackenwall.‡담쟁이 마을에 있는 크로그와 대화해야 합니다.‡Ve al Poblado Murohelecho y habla con Krog.‡Ve al Poblado Murohelecho y habla con Krog.‡Parler à Krog au village de Mur-de-Fougères.‡和蕨墙村的克罗格谈一谈。‡和蕨墻村的克羅格談壹談。',
  }
},
[1324] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Derrota o Recruta Remos in Pântano Vadeoso.‡Победите рядового Хендела в Пылевых топях.‡Besiegt den Gefreiten Hendel in den Marschen von Dustwallow.‡먼지진흙 습지대에 있는 병사 헨델과 싸워서 이겨야 합니다.‡Derrota al soldado Hendel en el Marjal Revolcafango.‡Derrota al soldado Hendel en el Marjal Revolcafango.‡Battre le soldat Hendel dans le marécage d\'Âprefange.‡击败尘泥沼泽的亨德尔下士。‡擊敗塵泥沼澤的亨德爾下士。',
  }
},
[1338] = {
  {
    'Ordens dos Lançatroz‡Заказ Грозовой Вершины‡Stormpikes Bestellung‡스톰파이크의 주문서‡Un pedido de Pico Tormenta‡Un pedido de Pico Tormenta‡La mission de Stormpike‡卡尔·雷矛的订单‡卡爾·雷矛的訂單',
    nil,
    'Entregue o Pedido de Lançatroz para Furen Barbalonga em Ventobravo.‡Отнесите заказ Грозовой Вершины Фьюрену Длиннобороду в Штормград.‡Bringt Stormpikes Bitte zu Furen Longbeard in Stormwind.‡스톰윈드에 있는 푸렌 롱비어드에게 스톰파이크의 주문서를 가져가야 합니다.‡Lleva el pedido de Pico Tormenta a Furen Barbalarga a Ventormenta.‡Lleva el pedido de Pico Tormenta a Furen Barbalarga a Ventormenta.‡Porter la commande de Stormpike à Furen Longbeard à Stormwind.‡把卡尔·雷矛的订单交给暴风城的弗伦·长须。‡把卡爾·雷矛的訂單交給暴風城的弗倫·長須。',
  }
},
[1339] = {
  {
    'Uma tarefa do Montanhista Lançatroz‡Задание Грозовой Вершины‡Gebirgsjäger Stormpikes Aufgabe‡산악경비대 스톰파이크의 임무‡La tarea del montaraz Pico Tormenta‡La tarea del montaraz Pico Tormenta‡La mission du Montagnard Stormpike‡巡山人卡尔·雷矛的任务‡巡山人卡爾·雷矛的任務',
    nil,
    'Fale com o Montanhista Lançatroz.‡Поговорите с горным пехотинцем Грозовой Вершиной.‡Sprecht mit Gebirgsjäger Stormpike.‡산악경비대 스톰파이크와 대화하십시오.‡Habla con el montaraz Pico Tormenta.‡Habla con el montaraz Pico Tormenta.‡Parler au Montagnard Stormpike.‡和巡山人卡尔·雷矛谈一谈。‡和巡山人卡爾·雷矛談壹談。',
  }
},
[1358] = {
  {
    'Uma amostra para Hermógenes‡Образец для Хелбрима‡Probe für Helbrim‡헬브림에게 가져갈 견본‡Muestra para Helbrim‡Muestra para Helbrim‡Un échantillon pour Helbrim‡给赫布瑞姆的样本‡給赫布瑞姆的樣本',
    nil,
    'Leve a Amostra de Coração de Lobo para Boticário Hermógenes nos Sertões.‡Принесите препарат сердца волка аптекарю Хелбриму в Степи.‡Bringt die Wolfherzprobe zu Apotheker Helbrim ins Brachland.‡불모의 땅에 있는 연금술사 헬브림에게 늑대 심장 견본을 가져가야 합니다.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Apporter l\'échantillon de coeur de loup à l\'Apothicaire Helbrim dans les Tarides.‡把一箱蜘蛛毒带给贫瘠之地的药剂师赫布瑞姆。‡把壹箱蜘蛛毒帶給貧瘠之地的藥劑師赫布瑞姆。',
  }
},
[1359] = {
  {
    'Entrega para Zilda‡Посылка для Зинг‡Zinges Lieferung‡진게의 소포‡Una entrega de Zinge‡Una entrega de Zinge‡Une livraison pour Zinge‡给金格的货物‡給金格的貨物',
    nil,
    'Leve a Amostras de Coração de Lobo para Boticária Zilda na Cidade Baixa.‡Отнесите препараты сердца волка аптекарю Зинг в Подгород.‡Bringt die Wolfherzproben zu Apothekerin Zinge nach Undercity.‡언더시티에 있는 연금술사 진게에게 늑대 심장 견본을 가져가야 합니다.‡Lleva las muestras de corazón de lobo al boticario Zinge en Entrañas.‡Lleva las muestras de corazón de lobo a la boticaria Zinge en Entrañas.‡Apporter les Echantillons de coeurs de loups à l\'apothicaire Zinge à Undercity.‡将狼心样本交给幽暗城的药剂师金格。‡將狼心樣本交給幽暗城的藥劑師金格。',
  }
},
[1360] = {
  {
    'Tesouros recuperados‡Возвращенное сокровище‡Wiederbeschaffte Schätze‡보물 찾기‡Los tesoros reclamados‡Los tesoros reclamados‡Des Trésors à recouvrer‡失而复得‡失而復得',
    nil,
    'Pegue a posse querida de Krom Braçoforte em seu baú no Saguão Norte de Uldaman e leve-a para ele na Altaforja.‡Достаньте сокровище Крома Крепкорука из сундука в северном зале Ульдамана и принесите ему в Стальгорн.‡Holt Krom Stoutarms wertvollen Besitz aus seiner Truhe in der nördlichen Bankenhalle von Uldaman und bringt den Schatz zu ihm nach Ironforge.‡울다만의 북쪽 대전당에 있는 궤짝에서 크롬 스타우트암의 보물을 찾아서 아이언포지에 있는 크롬 스타우트암에게 가져다주어야 합니다.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Récupérer les biens de Krom Stoutarm dans son coffre dans le hall commun nord d\'Uldaman et les lui rapporter à Ironforge.‡到奥达曼的北部大厅去找到克罗姆·粗臂的箱子，从里面拿出他的宝贵财产，然后回到铁炉堡把东西交给他。‡到奧達曼的北部大廳去找到克羅姆·粗臂的箱子，從裏面拿出他的寶貴財產，然後回到鐵爐堡把東西交給他。',
  }
},
[1361] = {
  {
    'Regthar Portões-da-morte‡Регтар Врата Смерти‡Regthar Deathgate‡렉타르 데스게이트‡Regthar Portamorta‡Regthar Portamorta‡Regthar Deathgate‡雷戈萨·死门‡雷戈薩·死門',
    nil,
    'Fale com Regthar Portões-da-morte.‡Поговорите с Регтаром Врата Смерти.‡Sprecht mit Regthar Deathgate.‡렉타르 데스게이트와 대화해야 합니다.‡Habla con Regthar Portamorta.‡Habla con Regthar Portamorta.‡Discuter avec Regthar Deathgate.‡和雷戈萨·死门谈一谈。‡和雷戈薩·死門談壹談。',
  }
},
[1362] = {
  {
    'Os Kolkar de Desolação‡Кентавры Пустошей‡Die Kolkar von Desolace‡잊혀진 땅의 콜카르‡Los Kolkar de Desolace‡Los Kolkar de Desolace‡Les Kolkar de Désolace‡凄凉之地的科卡尔部族‡淒涼之地的科卡爾部族',
    nil,
    'Fale com o Felgur Doiscortes no Entreposto do Espírito que Anda, em Desolação.‡Найдите на Заставе Скитающихся Духов в Пустошах Фелгура Бью-Двоих и поговорите с ним.‡Sprecht mit Felgur Twocuts beim Geistwandlerposten in Desolace.‡잊혀진 땅의 침묵의 초소에 있는 펠굴 투커츠와 대화해야 합니다.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Discuter avec Felgur Twocuts au poste de Rôdeur-fantôme en Désolace.‡和凄凉之地幽灵岗哨的费古尔·双刃谈一谈。‡和淒涼之地幽靈崗哨的費古爾·雙刃談壹談。',
  }
},
[1363] = {
  {
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Fale com o Acólito Dellis em Ventobravo.‡Поговорите с послушником Деллисом в Штормграде.‡Sprecht mit Akolyt Dellis in Stormwind.‡스톰윈드에 있는 수행사제 델리스와 대화해야 합니다.‡Habla con el acólito Dellis en Ventormenta.‡Habla con el acólito Dellis en Ventormenta.‡Parler à l\'acolyte Dellis à Stormwind.‡与暴风城里的助手迪利斯谈一谈。‡與暴風城裏的助手迪利斯談壹談。',
  }
},
[1364] = {
  {
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Recupere os Ensaios de Hadggar sobre Convergência Dimensional e entregue-os para Vigia Mahar Ba, na Bastilha de Etergarde.‡Верните "Рассуждения Кадгара о пространственной сходимости" и доставьте сочинение дозорному Махару Ба в Крепость Стражей Пустоты.‡Rettet Khadgars \'Abhandlungen über dimensionale Konvergenz\' und bringt sie zu Behüter Mahar Ba in der Burg Nethergarde.‡차원의 집합점에 대한 카드가의 평론을 찾아 네더가드 요새에 있는 감시자 마할 바에게 전해야 합니다.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Retrouver les Essais de Khadgar sur la convergence dimensionnelle et les porter au Gardien Mahar Ba au Rempart-du-Néant.‡夺回《卡德加的空间收敛研究笔记》，将它送给守望堡的看守者马哈尔巴。‡奪回《卡德加的空間收斂研究筆記》，將它送給守望堡的看守者馬哈爾巴。',
  }
},
[1365] = {
  {
    'Khan Dez\'hepah‡Вождь Дез\'хеп‡Khan Dez\'hepah‡칸 데즈헤파‡Khan Dez\'hepah‡Khan Dez\'hepah‡Khan Dez\'hepah‡戴兹帕可汗‡戴茲帕可汗',
    nil,
    'Leve a Cabeça de Khan Dez\'hepah para Felgur Doiscortes na Desolação.‡Принесиет Фелгуру Бью-Двоих голову вождя Дез\'хепа.‡Bringt Khan Dez\'hepahs Kopf zu Felgur Twocuts in Desolace.‡칸 데즈헤파를 처치하고 그 증거로 그의 머리카락을 잊혀진 땅에 있는 펠굴 투커츠에게 가져가야 합니다.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Rapporter la Tête du khan Dez\'hepah à Felgur Twocuts en Désolace.‡把戴兹帕可汗的头颅交给凄凉之地的费古尔·双刃。‡把戴茲帕可汗的頭顱交給淒涼之地的費古爾·雙刃。',
  }
},
[1366] = {
  {
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Felgur Doiscortes em Desolação.‡Принесите в Пустоши 15 ушей кентавров и отдайте Фелгуру Бью-Двоих.‡Bringt 15 Zentaurenohren zu Felgur Twocuts in Desolace.‡잊혀진 땅의 펠굴 투커츠에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Apporter 15 Oreilles de centaure à Felgur Twocuts, en Désolace.‡收集15只半人马的耳朵，把它们交给凄凉之地的费古尔·双刃。‡收集15只半人馬的耳朵，把它們交給淒涼之地的費古爾·雙刃。',
  }
},
[1367] = {
  {
    'Aliança com os Magram‡Союз с племенем Маграм‡Allianz mit den Magram‡마그람 동맹‡La alianza con los Magram‡La alianza con los Magram‡L\'alliance avec les Magram‡玛格拉姆部族‡瑪格拉姆部族',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게서 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux envers vous, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆部族建立良好的關系，然後和瓦魯格談壹談。',
  }
},
[1368] = {
  {
    'Aliança com os Gelkis‡Союз с племенем Гелкис‡Allianz mit den Gelkis‡겔키스 동맹‡La alianza con los Gelkis‡La alianza con los Gelkis‡L\'alliance avec les Gelkis‡吉尔吉斯部族‡吉爾吉斯部族',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut Euch einen Ruf als freundliche Person bei den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게서 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Faire en sorte que les Gelkis deviennent Amicaux envers vous, puis aller parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯部族建立良好的關系，然後和智者烏泰克談壹談。',
  }
},
[1369] = {
  {
    'Lágrimas partidas‡Россыпи Слез‡Zerbrochene Tränen‡눈물의 파편‡Lágrimas rotas‡Lágrimas rotas‡Larmes brisées‡破碎之泪‡破碎之淚',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Lágrimas Partidas para Warug na Aldeia Magram.‡Для поддержания отношений с племенем Маграм принесите 3 кристалла Россыпи Слез Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt 3 zerbrochene Tränen zu Warug im Dorf Magram.‡마그람에게 우호적인 평판을 유지하면서 마그람 마을에 있는 와루그에게 눈물의 파편 3개를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Maintenir votre réputation auprès des Magram et ramener 3 Larmes brisées à Warug au village des Magram.‡继续和玛格拉姆部族保持良好的关系，把3块破碎之泪交给玛格拉姆村庄的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關系，把3塊破碎之淚交給瑪格拉姆村莊的瓦魯格。',
  }
},
[1370] = {
  {
    'Assalto à dispensa‡Похищение припасов‡Diebstahl von Vorräten‡보급품 훔치기‡¡A robar provisiones!‡¡A robar provisiones!‡Voleur de viande‡偷取物资‡偷取物資',
    nil,
    'Entregue 6 sacos de Carne Mal Desidratada para Uthek, a Sábia, na Aldeia Gelkis.‡Принесите 6 мешков недосушенного мяса в деревню Гелкис и отдайте Уте Мудрой.‡Bringt 6 Taschen primitiv getrocknetes Fleisch zu Uthek der Weisen im Dorf Gelkis.‡겔키스 마을에 있는 현자 우텍에게 말린 고기 6개를 가져가야 합니다.‡Lleva 6 bolsas de Crudely Dried Meat a Uthek la Sabia al Poblado Gelkis.‡Lleva 6 bolsas de carne secada de forma rudimentaria a Uthek la Sabia al Poblado Gelkis.‡Rapporter 6 Sacs de viande grossièrement séchée à Uthek la Sage au village des Gelkis.‡把6包粗制干肉交给吉尔吉斯村的智者乌泰克。‡把6包粗制幹肉交給吉爾吉斯村的智者烏泰克。',
  }
},
[1371] = {
  {
    'Engenhoca para Warug‡Игрушка для Варуга‡Gizmo für Warug‡와루그의 물건‡Un cacharro para Warug‡Un cacharro para Warug‡Un Bidule pour Warug‡瓦鲁格的玩具‡瓦魯格的玩具',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Bonecos-alvo Avançado para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите усовершенствованный манекен-мишень Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt eine hochentwickelte Zielattrappe zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 고급 표적 허수아비를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzada a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzado a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram et rapporter un Leurre perfectionné à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，给玛格拉姆村的瓦鲁格找到一个高级假人。‡繼續和瑪格拉姆部族保持良好的關系，給瑪格拉姆村的瓦魯格找到壹個高級假人。',
  }
},
[1372] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Fale com Boticário Faustino no Refúgio dos Mendigos.‡Поговорите с аптекарем Фаустином в Приюте Бродяги.‡Sprecht mit Apotheker Faustin im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 연금술사 파우스틴과 대화해야 합니다.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Parler à l’Apothicaire Faustin, au Repaire des mendiants.‡到乞丐鬼屋去和药剂师法奥斯丁谈一谈。‡到乞丐鬼屋去和藥劑師法奧斯丁談壹談。',
  }
},
[1373] = {
  {
    'Ongekan‡Онгеку‡Ongeku‡온게쿠‡Ongeku‡Ongeku‡Ongeku‡盎格库尔‡盎格庫爾',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue um Estilhaço de Draenetista para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите осколок дренейского аметиста Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt einen Draenethystsplitter zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 드레니시스트 파편 하나를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento de draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento de draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis et rapporter un Eclat de draenéthyste à Uthek la Sage au village des Gelkis, en Désolace.‡继续和吉尔吉斯部族保持良好的关系，并把德莱尼水晶碎片交给凄凉之地吉尔吉斯村的智者乌泰克。‡繼續和吉爾吉斯部族保持良好的關系，並把德萊尼水晶碎片交給淒涼之地吉爾吉斯村的智者烏泰克。',
  }
},
[1374] = {
  {
    'Khan Jehn‡Вождь Джен‡Khan Jehn‡칸 젠‡Khan Jehn‡Khan Jehn‡Khan Jehn‡杰恩可汗‡傑恩可汗',
    nil,
    'Entregue a Cabeça de Khan Jehn para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Принесите голову вождя Джехна Уте Мудрой в деревню Гелкис.‡Bringt Khan Jehns Kopf zu Uthek der Weisen im Dorf Gelkis in Desolace.‡칸 젠을 처치하고 그 증거로 그의 머리띠를 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 가져가야 합니다.‡Lleva la cabeza del khan Jehn a Uthek la Sabia al Poblado Gelkis de Desolace.‡Lleva la cabeza del khan Jehn a Uthek la Sabia al Poblado Gelkis de Desolace.‡Rapporter la Tête du khan Jehn à Uthek la Sage au village des Gelkis, en Désolace.‡把杰恩可汗的头颅交给凄凉之地吉尔吉斯村的智者乌泰克。‡把傑恩可汗的頭顱交給淒涼之地吉爾吉斯村的智者烏泰克。',
  }
},
[1375] = {
  {
    'Khan Shaka‡Вождь Шак‡Khan Shaka‡칸 샤카‡Khan Shaka‡Khan Shaka‡Khan Shaka‡沙卡可汗‡沙卡可汗',
    nil,
    'Mantenha alta sua reputação junto aos Magram e entregue a Cabeça de Khan Shaka para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите голову вождя Шака Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt den Kopf von Khan Shaka zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 칸 샤카를 처치하고 그 증거로 그의 머리띠를 잊혀진 땅의 마그람 마을에 있는 와루그에게 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva la cabeza del khan Shaka a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva la cabeza de Khan Shaka a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation parmi les Magram et rapporter la Tête du khan Shaka à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，把沙卡可汗的头颅交给凄凉之地玛格拉姆村的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關系，把沙卡可汗的頭顱交給淒涼之地瑪格拉姆村的瓦魯格。',
  }
},
[1380] = {
  {
    'Khan Hratha‡Вождь Храта‡Khan Hratha‡칸 흐라사‡Khan Hratha‡Khan Hratha‡Khan Hratha‡赫鲁萨可汗‡赫魯薩可汗',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue o Fragmento de Chave dos Maraudinos para Uthek, a Sábia, na Aldeia Gelkis.‡Для поддержания отношений с племенем Гелкис принесите фрагмент Ключа Мародина Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt das Schlüsselfragment der Maraudine zu Uthek der Weisen im Dorf Gelkis.‡겔키스에게 우호적인 평판을 유지하면서 겔키스 마을에 있는 현자 우텍에게 마라우돈 열쇠 파편을 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva el fragmento de llave Maraudine a Uthek la Sabia al Poblado Gelkis.‡Mantén tu reputación con los Gelkis y lleva el trozo de llave Maraudine a Uthek la Sabia al Poblado Gelkis.‡Maintenir votre réputation auprès des Gelkis, et apporter le Fragment de clé des Maraudine à Uthek la Sage au village des Gelkis.‡继续和吉尔吉斯部族保持良好的关系，把玛洛迪钥匙碎片交给吉尔吉斯村的智者乌泰克。‡繼續和吉爾吉斯部族保持良好的關系，把瑪洛迪鑰匙碎片交給吉爾吉斯村的智者烏泰克。',
  }
},
[1381] = {
  {
    'Khan Hratha‡Вождь Храта‡Khan Hratha‡칸 흐라사‡Khan Hratha‡Khan Hratha‡Khan Hratha‡赫鲁萨可汗‡赫魯薩可汗',
    nil,
    'Mantenha alta sua reputação junto aos Magram e entregue o Fragmento de Chave dos Maraudinos para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите фрагмент Ключа Мародина Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt das Schlüsselfragment der Maraudine zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 마라우돈 열쇠 파편을 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva el fragmento de llave Maraudine a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva el trozo de llave Maraudine a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram, et apporter le Fragment de clé des Maraudine à Warug au village des Magram en Désolace.‡和玛格拉姆保持良好的关系，把玛洛迪钥匙碎片交给凄凉之地玛格拉姆村的瓦鲁格。‡和瑪格拉姆保持良好的關系，把瑪洛迪鑰匙碎片交給淒涼之地瑪格拉姆村的瓦魯格。',
  }
},
[1382] = {
  {
    'Aliança inusitada‡Странный союз‡Seltsame Allianz‡이상한 동맹‡Extraña alianza‡Extraña alianza‡Une étrange alliance‡奇怪的联盟‡奇怪的聯盟',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut eine freundliche Beziehung zu den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게서 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Obtenir que les Gelkis se montrent Amicaux, puis parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯部族建立良好的關系，然後和智者烏泰克談壹談。',
  }
},
[1383] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Boticário Faustino no Refúgio dos Mendigos precisa de 5 Corações de Pantera das Sombras, Fungo do Senhor do Brejo e um Tumor Passofundo.‡Принесите аптекарю Фаустину в Приют Бродяги 5 сердец пантер тени, мох хозяина болота и опухоль странника глубин.‡Apotheker Faustin im Bettlerschlupfwinkel braucht 5 Schattenpantherherzen, Morastlordfungus und einen Tiefschreitertumor.‡부랑자 소굴에 있는 연금술사 파우스틴에게 흑표범 심장 5개, 우두머리 늪괴물 곰팡이, 그리고 깊은바다거인의 종양을 가져가야 합니다.‡El boticario Faustin del Refugio de los Mendigos necesita 5 corazones de pantera sombría, hongos de Señor del Lodo y un tumor de zancudo de las profundidades.‡El boticario Faustin en Refugio de los Mendigos necesita 5 corazones de panteras sombrías, hongos del Señor del Lodo y un tumor zancaprofunda.‡L\'apothicaire Faustin, du repaire des mendiants, a besoin de 5 Cœurs de panthère des ombres, d\'un Champignon de Boueux et d\'une Tumeur d\'Arpentefonds.‡乞丐鬼屋的药剂师法奥斯丁需要5颗暗影黑豹的心脏、1颗泥沼之王的蘑菇和1个深海巨人的肿瘤。‡乞丐鬼屋的藥劑師法奧斯丁需要5顆暗影黑豹的心臟、1顆泥沼之王的蘑菇和1個深海巨人的腫瘤。',
  }
},
[1384] = {
  {
    'Onde os fracos não têm vez‡Набег на племя Колкар‡Überfall auf die Kolkar‡콜카르 습격‡Asalta a los Kolkar‡Asalta a los Kolkar‡Raid sur les Kolkar‡突袭科卡尔‡突襲科卡爾',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue 10 Patuás Grosseiros para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите 10 грубых оберегов Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt 10 kunstlose Glücksbringer zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게서 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 조잡한 부적 10개를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 10 talismanes rudimentarios a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 10 talismanes rudimentarios a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis, et apporter 10 Charmes bruts à Uthek la Sage dans le village des Gelkis, en Désolace.‡和吉尔吉斯部族保持良好的关系，把10个粗制咒符交给凄凉之地吉尔吉斯村的智者乌泰克。‡和吉爾吉斯部族保持良好的關系，把10個粗制咒符交給淒涼之地吉爾吉斯村的智者烏泰克。',
  }
},
[1385] = {
  {
    'Política feroz‡Политика силы‡Brutale Politik‡야비한 정책‡Políticas brutales‡Políticas brutales‡Une violente politique‡野蛮外交‡野蠻外交',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게서 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux à votre égard, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆部族建立良好的關系，然後和瓦魯格談壹談。',
  }
},
[1386] = {
  {
    'Ataque aos Kolkar!‡Нападение на племя Колкар‡Angriff auf die Kolkar‡콜카르 공격‡Ataca a los Kolkar‡Ataca a los Kolkar‡Assaut sur les Kolkar‡突袭科卡尔部族‡突襲科卡爾部族',
    nil,
    'Mantenha alta sua reputação junto aos Magram. Mate 12 Centauros Kolkar, 12 Batedores Kolkar e 6 Espancadores Kolkar. Em seguida, fale novamente com Warug, na Vila Magram, em Desolação.‡Для поддержания отношений с племенем Маграм вы должны убить 12 кентавров из племени Колкар, 12 разведчиков из племени Колкар и 6 извергов из племени Колкар, а затем вернуться к Варугу в деревню Маграм.‡Haltet Euren Ruf bei den Magram aufrecht. Tötet 12 Zentauren der Kolkar, 12 Späher der Kolkar sowie 6 Raufer der Kolkar und kehrt dann zu Warug ins Magramdorf in Desolace zurück.‡마그람에게서 우호적인 평판을 유지하면서 콜카르 켄타우로스 12명, 콜카르일족 척후병 12명, 콜카르일족 투사 6명을 처치한 다음 잊혀진 땅의 마그람 마을에 있는 와루그에게 돌아가야 합니다.‡Mantén tu reputación con los Magram. Mata a 12 centauros Kolkar, 12 rastreadores Kolkar y 6 destructores Kolkar y luego busca a Warug en el Poblado Magram en Desolace.‡Mantén tu reputación con los Magram. Mata a 12 centauros Kolkar, 12 exploradores Kolkar y 6 destructores Kolkar y luego busca a Warug en el Poblado Magram en Desolace.‡Maintenir votre réputation auprès des Magram, tuer 12 Centaures kolkar, 12 Eclaireurs kolkar, 6 Marteleurs kolkar, puis retourner voir Warug, dans le village des Magram, en Désolace.‡继续保持和玛格拉姆部族的良好关系，杀掉12个科卡尔半人马，12个科卡尔斥候和6个科卡尔虐待者，然后回到凄凉之地向玛格拉姆部族的瓦鲁格报告。‡繼續保持和瑪格拉姆部族的良好關系，殺掉12個科卡爾半人馬，12個科卡爾斥候和6個科卡爾虐待者，然後回到淒涼之地向瑪格拉姆部族的瓦魯格報告。',
  }
},
[1387] = {
  {
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Cabo Melquias no Posto do Nijel em Desolação.‡Принесите в город Высота Найджела 15 ушей кентавров и отдайте их капралу Мелкису.‡Bringt 15 Zentaurenohren zu Corporal Melkins bei der Nijelspitze in Desolace.‡잊혀진 땅의 나이젤의 야영지에 있는 하사관 멜킨스에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro al cabo Melkins que está en Punta de Nijel, en Desolace.‡Lleva 15 orejas de centauro al cabo Melkins que está en Punta de Nijel, en Desolace.‡Apporter 15 Oreilles de centaures au caporal Melkins, à la combe de Nijel, en Désolace.‡收集15个半人马耳朵，把它们交给尼耶尔前哨站的麦尔金斯下士。‡收集15個半人馬耳朵，把它們交給尼耶爾前哨站的麥爾金斯下士。',
  }
},
[1388] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Entregue o Soro da Verdade do Faustino para Sicário Zaqueu no Refúgio dos Mendigos.‡Отдайте сыворотку правды Фаустина стражу смерти Зредусу в Приюте Бродяги.‡Gebt Faustins Wahrheitsserum dem Todespirscher Zraedus im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 죽음의추적자 즈레더스에게 파우스틴의 진실의 물약을 가져가야 합니다.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Remettre le Sérum de vérité de Faustin au traqueur noir Zraedus au Repaire des mendiants.‡把法奥斯丁的真言药水交给乞丐鬼屋的亡灵哨兵莱度斯。‡把法奧斯丁的真言藥水交給乞丐鬼屋的亡靈哨兵萊度斯。',
  }
},
[1389] = {
  {
    'Cristais de draenetista‡Кристаллы дренейского аметиста‡Draenethystkristalle‡드레니시스트 수정‡Cristales draenetistas‡Cristales draenetistas‡Les cristaux de draenéthyste‡德莱尼水晶‡德萊尼水晶',
    nil,
    'Leve 6 Cristais de Draenetista para Magtoor no Pântano das Mágoas.‡Принесите 6 кристаллов дренейского аметиста Магтуру в Убежище в Болоте Печали.‡Bringt 6 Draenethystkristalle zu Magtoor im sicheren Hafen in den Sümpfen des Elends.‡슬픔의 늪의 피난처에 있는 막투르에게 드레니시스트 수정 6개를 가져가야 합니다.‡Llévale 6 cristales draenetistas a Magtoor que está en El Malecón del Pantano de las Penas.‡Llévale 6 cristales draenetistas a Magtoor que está en El Puerto del Pantano de las Penas.‡Apporter 6 Cristaux de draenéthyste à Magtoor au Havre boueux du marais des Chagrins.‡给悲伤沼泽避难营地里的玛格图尔带去6块德莱尼水晶。‡給悲傷沼澤避難營地裏的瑪格圖爾帶去6塊德萊尼水晶。',
  }
},
[1391] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Leve a Cerveja de Zaerdus para Infiltrador Marksen no Pedregal.‡Отнесите бражку Зредуса секретному агенту Марксену в Каменор.‡Bringt Zraedus\' Bräu zu Spitzel Marksen in Stonard.‡스토나드에 있는 첩보원 마크슨에게 즈레더스의 맥주를 가져가야 합니다.‡Lleva el brebaje de Zraedus al infiltrador Marksen a Rocal.‡Lleva el brebaje de Zraedus al infiltrado Marksen a Rocal.‡Apporter la Bière de Zraedus à l\'Infiltrateur Marksen à Stonard.‡把莱度斯的酒带给斯通纳德的间谍玛克森。‡把萊度斯的酒帶給斯通納德的間諜瑪克森。',
  }
},
[1392] = {
  {
    'Noboru, a Borduna‡Нобору Дубина‡Noboru der Knüppel‡곤봉잡이 노보루‡Noboru el Garrote‡Noboru el Garrote‡Noboru le Gourdin‡木棒诺博鲁‡木棒諾博魯',
    nil,
    'Leve a Clava de Noboru ao líder do Refúgio no Pântano das Mágoas.‡Принесите дубину Нобору главе Убежища на Болото Печали.‡Bringt Noborus Knüppel zum Anführer des sicheren Hafens in den Sümpfen des Elends.‡슬픔의 늪에 있는 피난처의 우두머리에게 노보루의 곤봉을 가져가야 합니다.‡Llévale el garrote de Noboru al líder de El Malecón del Pantano de las Penas.‡Llévale el garrote de Noboru al líder de El Puerto del Pantano de las Penas.‡Apporter le Gourdin de Noboru au Chef du Havre boueux dans le marais des Chagrins.‡把诺博鲁的木棒交到悲伤沼泽中的避难营领导人手中。‡把諾博魯的木棒交到悲傷沼澤中的避難營領導人手中。',
  }
},
[1393] = {
  {
    'A fuga de Galen‡Побег Галена‡Galens Flucht‡갈렌 구출‡La huida de Galen‡La huida de Galen‡L\'évasion de Galen‡加林的逃亡‡加林的逃亡',
    nil,
    'Escolte Galen até a segurança para, então, encontrar seu acampamento no Pântano das Mágoas e abrir seu cofre.‡Выведите Галена из опасного места, затем найдите его лагерь на Болоте Печали и откройте его сейф.‡Eskortiert Galen, bis er außer Gefahr ist, sucht dann sein Lager in den Sümpfen des Elends und öffnet seine Geldkassette.‡갈렌이 위험에서 벗어나도록 호위한 다음 슬픔의 늪에 있는 그의 야영지를 찾아 갈렌의 금고를 열어야 합니다.‡Pon a salvo a Galen, y después encuentra su campamento en el Pantano de las Penas y abre su caja fuerte.‡Pon a salvo a Galen, y después encuentra su campamento en el Pantano de las Penas y abre su caja fuerte.‡Escorter Galen jusqu\'à ce qu\'il soit hors de danger, puis trouver son camp dans le marais des Chagrins et ouvrir son coffre.‡护送加林逃出困境，然后打开他放在悲伤沼泽营地里的保险箱。‡護送加林逃出困境，然後打開他放在悲傷沼澤營地裏的保險箱。',
  }
},
[1394] = {
  {
    'Passagem final‡Финальное испытание‡Letzte Überfahrt‡최후의 시험‡La recta final‡La recta final‡Le dernier voyage‡通过试炼‡通過試煉',
    nil,
    'Fale com Dorn Espreitaprados em Mil Agulhas.‡Поговорите с Дорном Вольным Ловчим в Тысяче Игл.‡Sprecht mit Dorn Plainstalker in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커와 대화하십시오.‡Habla con Dorn Acechaprados en Las Mil Agujas.‡Habla con Dorn Acechallanos en Las Mil Agujas.‡Parler au traqueur des plaines Dorn aux Mille pointes.‡和千针石林的多恩·平原行者谈一谈。‡和千針石林的多恩·平原行者談壹談。',
  }
},
[1395] = {
  {
    'Suprimentos para Etergarde‡Поставки для Стражей Пустоты‡Vorräte für Nethergarde‡네더가드 요새 보급품‡Suministros para Nethergarde‡Suministros para Nethergarde‡Fournitures pour Rempart-du-Néant‡守望堡的物资‡守望堡的物資',
    nil,
    'Leve o Caixote de Pedras de Poder para Intendente Lungertz antes que expirem.‡Отнесите ящик камней силы интенданту Лунгерцу прежде, чем камни утратят силу.‡Bringt die Kiste mit den Kraftsteinen zu Rüstmeister Lungertz, bevor die Kraft verbraucht ist.‡마법석의 힘이 다하기 전에 병참장교 룬겔츠에게 마법석 상자를 가져가야 합니다.‡Llévale caja de piedras de potencia al intendente Lungertz antes de que caduquen.‡Llévale caja de piedras de potencia al intendente Lungertz antes de que caduquen.‡Apporter la Caisse de Pierres de puissance à l\'Intendant Lungertz, avant que le pouvoir des pierres n\'expire.‡在能量石的魔法效果消失以前，把它们带给守望堡的军需官朗格尔斯。‡在能量石的魔法效果消失以前，把它們帶給守望堡的軍需官朗格爾斯。',
  }
},
[1396] = {
  {
    'Invasão da vida selvagem‡Атака тварей‡Lauernde Tierwelt‡야생 짐승의 공격‡Contra la fauna feroz‡Naturaleza invasora‡Des créatures sauvages rôdent‡逼近的野兽‡逼近的野獸',
    nil,
    'Mate 8 Crocoliscos Dentesserras Jovens, 10 Tece-mágoas e 10 Jaguares do Pântano, então fale novamente com Vigia Biggs no Pântano das Mágoas.‡Убейте 8 молодых острозубых кроколисков, 10 ткачей скорби и 10 болотных ягуаров и потом вернитесь к дозорному Биггсу на Болоте Печали.‡Tötet 8 junge Sägezahnkrokilisken, 10 Trauerspinner sowie 10 Sumpfjaguare und kehrt dann zu Behüter Biggs in den Sümpfen des Elends zurück.‡새끼 톱니악어 8마리, 늪그물거미 10마리, 늪지재규어 10마리를 처치한 다음 슬픔의 늪에 있는 파수병 비그스에게 돌아가야 합니다.‡Mata a 8 crocoliscos Denteserra jóvenes, 10 girapenas y 10 jaguares del pantano, y después ve a ver al vigilante Biggs al Pantano de las Penas.‡Mata a 8 crocoliscos Denteserra jóvenes, 10 hilapenas y 10 jaguares del pantano, y después ve a ver al vigía Biggs al Pantano de las Penas.‡Tuer 8 Jeunes crocilisques Dents-de-scie, 10 Tisseuses des pleurs et 10 Jaguars du marécage, puis retourner voir le Gardien Biggs, dans le marais des Chagrins.‡杀死8只小盐齿鳄鱼、10只沼泽纺丝蛛和10只沼泽虎，然后向悲伤沼泽的卫兵比格斯报告。‡殺死8只小鹽齒鱷魚、10只沼澤紡絲蛛和10只沼澤虎，然後向悲傷沼澤的衛兵比格斯報告。',
  }
},
[1398] = {
  {
    'Madeira Flutuante‡Плавник‡Treibholz‡유목‡Madera a la deriva‡Madera a la deriva‡Bois flotté‡晒干的流木‡曬幹的流木',
    nil,
    'Leve 8 peças de Madeira Flutuante Seca ao Sol para Vigia Biggs no Pântano das Mágoas.‡Принести 8 кусков сухого плавника дозорному Биггсу на Болоте Печали.‡Bringt 8 Stücke sonnengetrocknetes Treibholz zu Behüter Biggs in den Sümpfen des Elends.‡슬픔의 늪에 있는 파수병 비그스에게 볕에 말린 유목 8개를 가져가야 합니다.‡Llévale 8 piezas de madera a la deriva desecada al vigilante Biggs en el Pantano de las Penas.‡Llévale 8 piezas de madera a la deriva desecada al vigilante Biggs en el Pantano de las Penas.‡Apporter 8 Morceaux de Bois séché au soleil au Gardien Biggs dans le marais des Chagrins.‡给悲伤沼泽的卫兵比格斯带回8块晒干的流木。‡給悲傷沼澤的衛兵比格斯帶回8塊曬幹的流木。',
  }
},
[1418] = {
  {
    'Nika Cicatriz-de-sangue‡Ника Алый Шрам‡Neeka Bloodscar‡니카 블러드스카‡Neeka Marca de Sangre‡Neeka Marca de Sangre‡Neeka Bloodscar‡尼卡·血痕‡尼卡·血痕',
    nil,
    'Fale com Nika Cicatriz-de-sangue.‡Поговорите с Никой Алый Шрам.‡Sprecht mit Neeka Bloodscar.‡니카 블러드스카와 대화해야 합니다.‡Habla con Neeka Marca de Sangre.‡Habla con Neeka Marca de Sangre.‡Parler à Neeka Bloodscar.‡和尼卡·血痕谈一谈。‡和尼卡·血痕談壹談。',
  }
},
[1419] = {
  {
    'Coiotes ladrões‡Койоты-воры‡Kojoten-Diebe‡도둑 코요테‡Ladrones coyote‡Ladrones coyote‡Les coyotes voleurs‡捕猎山狗‡捕獵山狗',
    nil,
    'Leve 30 Mandíbulas de Coiote para Nika Cicatriz-de-sangue em Karrath.‡Принесите 30 челюстей койотов Нике Алый Шрам в Каргат.‡Bringt 30 Kojotenkieferknochen zu Neeka Bloodscar in Kargath.‡카르가스에 있는 니카 블러드스카에게 코요테 턱뼈 30개를 가져가야 합니다.‡Llévale 30 mandíbulas de coyote a Neeka Marca de Sangre, que está en Kargath.‡Llévale 30 mandíbulas de coyote a Neeka Marca de Sangre, que está en Kargath.‡Apporter 30 Mâchoires de coyotes à Neeka Bloodmark à Kargath.‡带30块山狗的颚骨去见卡加斯的尼卡·血痕。‡帶30塊山狗的顎骨去見卡加斯的尼卡·血痕。',
  }
},
[1420] = {
  {
    'Relatório para Helgrum‡Донесение Хелгруму‡Bericht für Helgrum‡헬그럼에게 보고‡Un informe para Helgrum‡Un informe para Helgrum‡Le rapport à Helgrum‡向赫格拉姆报到‡向赫格拉姆報到',
    nil,
    'Leve o Relatório de Nika para Helgrum, o Ligeiro em Pedregal.‡Отнесите донесение Ники Хелгруму Быстроногому в Каменор.‡Bringt Neekas Bericht zu Helgrum dem Hurtigen in Stonard.‡스토나드에 있는 날쌘돌이 헬그럼에게 니카의 보고서를 가져가야 합니다.‡Llévale el informe de Neeka a Helgrum el Veloz, que está en Rocal.‡Llévale el informe de Neeka a Helgrum el Veloz, que está en Rocal.‡Apporter le Rapport de Neeka à Helgrum l\'Agile à Stonard.‡把尼卡的报告带给斯通纳德的赫格拉姆。‡把尼卡的報告帶給斯通納德的赫格拉姆。',
  }
},
[1421] = {
  {
    'A caravana perdida‡Пропавший караван‡Die verlorene Karawane‡사라진 짐마차‡La caravana perdida‡La caravana perdida‡Le chariot perdu‡丢失的货物‡丟失的貨物',
    nil,
    'Encontre o Baú da Caravana no Retiro Alqueivado, obtenha os Reagentes do Teurgo e leve-os para Vigia Biggs.‡Найдите похищенный из каравана сундук в Болотном пристанище, добудьте реактивы магов и принесите их дозорному Биггсу.‡Sucht die Karawanentruhe im Fallow Heiligtum, beschafft Euch die Reagenzien der Hexer und bringt sie zu Behüter Biggs.‡드레노어 성역에서 마법사들의 재료가 들어 있는 짐마차 상자를 찾아 파수병 비그스에게 가져가야 합니다.‡Encuentra el cofre de la caravana en Retiro Fangoso, consigue los componentes de zahorí y llévaselos al vigilante Biggs.‡Encuentra el cofre de la caravana en Retiro Fangoso, consigue los componentes de zahorí y llévaselos al vigía Biggs.‡Trouver le Coffre de la Caravane, dans le Sanctuaire des friches, obtenir les Composants pour les sorciers, et les apporter au Gardien Biggs.‡在农田避难所中找到商队的货物，并拿到巫师的材料，把它交给卫兵比格斯。‡在農田避難所中找到商隊的貨物，並拿到巫師的材料，把它交給衛兵比格斯。',
  }
},
[1422] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡海中的威脅',
    nil,
    'Fale com Katar no Pântano das Mágoas.‡Поговорите с Катором на Болоте Печали.‡Sprecht mit Katar in den Sümpfen des Elends.‡슬픔의 늪에 있는 카타르와 대화해야 합니다.‡Habla con Katar en el Pantano de las Penas.‡Habla con Katar en el Pantano de las Penas.‡Parler à Katar, dans le marais des Chagrin.‡与悲伤沼泽的卡塔尔谈一谈。‡與悲傷沼澤的卡塔爾談壹談。',
  }
},
[1423] = {
  {
    'Os suprimentos perdidos‡Потерянные припасы‡Die verlorenen Vorräte‡잃어버린 보급품‡Los suministros perdidos‡Los suministros perdidos‡Les marchandises perdues‡遗失的补给品‡遺失的補給品',
    nil,
    'Leve os Suprimentos Perdidos para Intendente Lungertz.‡Принесите потерянные припасы интенданту Лунгерцу.‡Bringt die verlorenen Vorräte zu Rüstmeister Lungertz.‡병참장교 룬겔츠에게 잃어버린 보급품을 가져가야 합니다.‡Llévale los suministros perdidos al intendente Lungertz.‡Llévale los suministros perdidos al intendente Lungertz.‡Apporter les Marchandises perdues à l\'Intendant Lungertz.‡把遗失的货物交给军需官朗格尔斯。‡把遺失的貨物交給軍需官朗格爾斯。',
  }
},
[1424] = {
  {
    'Poço de Lágrimas‡Озеро Слез‡Tränenteich‡눈물의 연못‡Charca de Lágrimas‡Charca de Lágrimas‡Le bassin des larmes‡泪水之池‡淚水之池',
    nil,
    'Vil\'zerul, no Pedregal, quer que você colete 10 Artefatos Atal\'ai.‡Соберите 10 артефактов Атал\'ай для Фелзерула из Каменора.‡Fel\'Zerul in Stonard möchte, dass Ihr 10 Artefakte der Atal\'ai sammelt.‡스토나드에 있는 펠제룰이 아탈라이 유물 10개를 모아 달라고 부탁했습니다.‡Fel\'zerul, en Rocal, quiere que consigas 10 artefactos Atal\'ai.‡Fel\'zerul en Rocal quiere que recojas 10 artefactos Atal\'ai.‡Fel’zerul à Stonard veut que vous rassembliez 10 Artefacts atal\'ai.‡斯通纳德的费泽鲁尔要求你收集10件阿塔莱神器。‡斯通納德的費澤魯爾要求妳收集10件阿塔萊神器。',
  }
},
[1425] = {
  {
    'Entregue a remessa‡Доставка груза‡Überbringen der Lieferung‡보급품 전달‡Envío de suministros‡Entrega el cargamento‡La remise du chargement‡运送货物‡運送貨物',
    nil,
    'Leve a Remessa para Etergarde ao Intendente Lungertz na Bastilha de Etergarde.‡Доставьте груз в Крепость Стражей Пустоты интенданту Лунгерцу.‡Bringt die Ladung für Nethergarde zu Rüstmeister Lungertz in der Burg Nethergarde.‡네더가드 요새에 있는 병참장교 룬겔츠에게 네더가드 뱃짐을 가져가야 합니다.‡Entrégale los suministros al intendente Lungertz del Castillo de Nethergarde.‡Entrégale los suministros al intendente Lungertz del Castillo de Nethergarde.‡Apporter la Cargaison pour Rempart-du-Néant à l\'Intendant Lungertz au Rempart-du-Néant.‡把货物带给守望堡的军需官朗格尔斯。‡把貨物帶給守望堡的軍需官朗格爾斯。',
  }
},
[1426] = {
  {
    'Ameaça do mar‡Угроза с моря.‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡海中的威脅',
    nil,
    'Mate 10 Murlocs do Pântano, 10 Jogatintas do Pântano e 10 Comecarnes do Pântano. Depois, fale novamente com Katar, no Pântano das Mágoas.‡Убейте 10 болотных мурлоков, 10 болотных чернильщиков и 10 болотных трупоедов, затем вернитесь к Котору в Болото Печали.‡Tötet 10 Marschenmurlocs, 10 Marschentintenspucker und 10 Marschenfleischfresser und kehrt dann zu Katar in den Sümpfen des Elends zurück.‡늪지멀록 10마리, 늪지멀록 먹물쟁이 10마리, 늪지멀록 청소부 10마리를 처치한 다음 슬픔의 늪에 있는 카타르에게 돌아가십시오.‡Mata a 10 murlocs del pantano, 10 vomitatintas del pantano y 10 comecarnes del pantano, y después ve a ver a Katar al Pantano de las Penas.‡Mata a 10 múrlocs de marisma, 10 vomitatintas de marisma y 10 comecarnes de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Tuer 10 Murlocs des marais, 10 Cracheurs des marais, 10 Dévoreurs des marais, puis retourner voir Katar dans le marais des Chagrins.‡杀掉10个沼泽鱼人、10个沼泽喷墨鱼人和10个沼泽食腐鱼人，然后向悲伤沼泽的卡塔尔回报。‡殺掉10個沼澤魚人、10個沼澤噴墨魚人和10個沼澤食腐魚人，然後向悲傷沼澤的卡塔爾回報。',
  }
},
[1427] = {
  {
    'Ameaça do mar‡Угроза с моря.‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡海中的威脅',
    nil,
    'Fale com Tok\'Kar no Pântano das Mágoas.‡Поговорите с Ток\'Каром в Болоте Печали.‡Sprecht mit Tok\'Kar in den Sümpfen des Elends.‡슬픔의 늪에 있는 톡카르와 대화해야 합니다.‡Habla con Tok\'Kar en el Pantano de las Penas.‡Habla con Tok\'Kar en el Pantano de las Penas.‡Parler à Tok\'Kar dans le marais des Chagrins.‡与悲伤沼泽的托克卡尔谈一谈。‡與悲傷沼澤的托克卡爾談壹談。',
  }
},
[1428] = {
  {
    'Ameaça contínua‡Продолжающаяся угроза‡Fortwährende Gefahr‡계속되는 위협‡La amenaza continua‡Amenaza constante‡Le danger permanent‡海中的威胁‡海中的威脅',
    nil,
    'Mate 10 Jogatintas do Pântano, 10 Comecarnes do Pântano e 10 Oráculos do Pântano. Depois, fale novamente com Katar, no Pântano das Mágoas.‡Убейте 10 болотных чернильщиков, 10 болотных трупоедов и 10 болотных оракулов, затем вернитесь к Котору в Болоте Печали.‡Tötet 10 Marschentintenspucker, 10 Marschenfleischfresser und 10 Marschenorakel und kehrt dann zu Katar in den Sümpfen des Elends zurück.‡늪지멀록 먹물쟁이 10마리, 늪지멀록 청소부 10마리, 늪지멀록 점쟁이 10마리를 처치한 다음 슬픔의 늪에 있는 카타르에게 돌아가야 합니다.‡Mata a 10 vomitatintas del pantano, 10 comecarnes del pantano y 10 oráculos del pantano, y después ve a ver a Katar al Pantano de las Penas.‡Mata a 10 vomitatintas de marisma, 10 comecarnes de marisma y 10 oráculos de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Tuer 10 Cracheurs des marais, 10 Dévoreurs des marais, 10 Oracles des marais, puis retourner voir Katar dans le marais des Chagrins.‡杀掉10名沼泽喷墨鱼人、10名沼泽食腐鱼人和10名沼泽鱼人智者，然后向悲伤沼泽的卡塔尔回报。‡殺掉10名沼澤噴墨魚人、10名沼澤食腐魚人和10名沼澤魚人智者，然後向悲傷沼澤的卡塔爾回報。',
  }
},
[1429] = {
  {
    'O exilado Atal\'ai‡Изгнанник Атал\'ай‡Der Verbannte der Atal\'ai‡추방된 아탈라이 트롤‡El exiliado Atal\'ai‡El exilio de los Atal\'ai‡L\'Exilé atal\'ai‡阿塔莱流放者‡阿塔萊流放者',
    nil,
    'Leve o Saco de Artefatos Atal\'ai para o Exilado Atal\'ai nas Terras Agrestes.‡Принесите сверток с артефактами Атал\'ай к изгнаннику Атал\'ай во Внутренние земли.‡Bringt das Artefaktbündel der Atal\'ai zu dem Verbannten der Atal\'ai ins Hinterland.‡동부 내륙지에 있는 추방된 아탈라이트롤에게 아탈라이 유물 자루를 가져가야 합니다.‡Lleva los artefactos Atal\'ai al exiliado Atal\'ai en las Tierras del Interior.‡Lleva los artefactos Atal\'ai al exiliado Atal\'ai en las Tierras del Interior.‡Apporter les Artefacts atal\'ai à l\'Exilé atal\'ai dans les Hinterlands.‡将一捆阿塔莱神器交给辛特兰的阿塔莱流放者。‡將壹捆阿塔萊神器交給辛特蘭的阿塔萊流放者。',
  }
},
[1430] = {
  {
    'Carne fresca‡Свежее мясо‡Frischfleisch‡싱싱한 고기‡Carne fresca‡Carne fresca‡Viande fraîche‡新鲜的螃蟹腿‡新鮮的螃蟹腿',
    nil,
    'Leve 10 Pernas de Rastejante Monstruoso para Dar no Pântano das Mágoas.‡Принесите 10 ног чудовищного краба Дару на Болото Печали.‡Bringt 10 monströse Kriecherbeine zu Dar in den Sümpfen des Elends.‡슬픔의 늪에 있는 다르에게 괴물게 집게발 10개를 가져가야 합니다.‡Lleva 10 patas de reptadores monstruosos a Dar en el Pantano de las Penas.‡Lleva 10 patas de reptadores monstruosos a Dar en el Pantano de las Penas.‡Apporter 10 Pattes de clampants monstrueux à Dar dans le marais des Chagrins.‡给悲伤沼泽的达尔带去10条巨大的螃蟹腿。‡給悲傷沼澤的達爾帶去10條巨大的螃蟹腿。',
  }
},
[1431] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianz-Beziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關系',
    nil,
    'Fale com Keldran em Orgrimmar.‡Поговорите с Кельдрином в Оргриммаре.‡Sprecht mit Keldran in Orgrimmar.‡오그리마에 있는 켈드란과 대화하십시오.‡Habla con Keldran en Orgrimmar.‡Habla con Keldran en Orgrimmar.‡Parler à Keldran à Orgrimmar.‡与奥格瑞玛的科尔丹谈一谈。‡與奧格瑞瑪的科爾丹談壹談。',
  }
},
[1432] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianz-Beziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關系',
    nil,
    'Fale com Takta Laminaço em Desolação.‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Steelblade in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화하십시오.‡Habla con Takata Hojacero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parler à Takata Steelblade en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡與淒涼之地的塔卡塔·鋼刃談壹談。',
  }
},
[1433] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianz-Beziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關系',
    nil,
    'Fale com Maurin Rachaosso em Desolação.‡Поговорите с Маурином Костоломом в Пустошах.‡Sprecht mit Maurin Bonesplitter in Desolace.‡잊혀진 땅에 있는 마우린 본스플리터와 대화하십시오.‡Habla con Maurin Partehuesos en Desolace.‡Habla con Maurin Partehuesos en Desolace.‡Parler à Maurin Bonesplitter en Désolace.‡去找凄凉之地的玛乌林·碎骨谈一谈。‡去找淒涼之地的瑪烏林·碎骨談壹談。',
  }
},
[1434] = {
  {
    'Mácula dos sátiros‡Опоганенные сатиры‡Beschmutzt durch Satyrn‡사티로스의 출몰‡La contaminación del sátiro‡La contaminación del sátiro‡Souillé par les satyres‡萨特的威胁‡薩特的威脅',
    nil,
    'Mate 7 Errantes Furiódios, 7 Devotos Vis Furiódios, 7 Traidores Furiódios e 7 Arautos Infernais Furiódios. Depois fale com Takta Laminaço em Desolação.‡Убейте 7 разбойников из племени Ярой Ненависти, 7 скверноподданных из племени Ярой Ненависти, 7 предателей из племени Ярой Ненависти и 7 адских сатиров из племени Ярой Ненависти и вернуться к Такате Стальному Клинку в Пустоши.‡Besiegt 7 Schurken der Zornsäer, 7 Teufelsanbeter der Zornsäer, 7 Verräter der Zornsäer sowie 7 Höllenrufer der Zornsäer und kehrt zu Takata Steelblade in Desolace zurück.‡서릿발분노의 암살자 7명, 서릿발분노의 악마추종자 7명, 서릿발분노의 배반자 7명, 그리고 서릿발분노의 지옥소환사 7명을 처치한 후 잊혀진 땅에 있는 타카타 스틸블레이드에게 돌아가십시오.‡Mata a 7 pícaros, 7 jurapenas, 7 traidores y 7 clamainfernos Odio Feroz y ve a ver a Takata Hojacero a Desolace.‡Mata a 7 pícaros, 7 jurapenas, 7 traidores y 7 clamainfernos Odio Feroz y ve a ver a Takata Hoja de Acero a Desolace.‡Massacrer 7 Voleurs Fielfurie, 7 Liges de la corruption Fielfurie, 7 Traîtres Fielfurie et 7 Implorateurs de l’enfer Fielfurie, puis retourner voir Takata Steelblade en Désolace.‡杀死7只怨怒潜行者、7只怨怒魔仆、7只怨怒背叛者和7只怨怒唤魔者，然后向凄凉之地的塔卡塔·钢刃复命。‡殺死7只怨怒潛行者、7只怨怒魔仆、7只怨怒背叛者和7只怨怒喚魔者，然後向淒涼之地的塔卡塔·鋼刃復命。',
  }
},
[1435] = {
  {
    'A queima dos espíritos‡Сжигание душ‡Brennender Geist‡불타는 영혼‡Los espíritus ardientes‡Los espíritus ardientes‡Esprits consumés‡灵魂的燃烧‡靈魂的燃燒',
    nil,
    'Devolva a Gema Ardente e leve 15 Gemas Ardentes Infusas para Maurin Rachaosso na Desolação.‡Верните пылающий самоцвет и 15 одушевленных самоцветов Маурину Костолому в Пустошах.‡Bringt den brennenden Edelstein und 15 erfüllte brennende Edelsteine nach Desolace zu Maurin Bonesplitter.‡잊혀진 땅에 있는 마우린 본스플리터에게 빌린 불타는 보석 하나와 영혼이 깃든 불타는 보석 15개를 가져가야 합니다.‡LLeva la gema ardiente y 15 gemas ardientes imbuidas a Maurin Partehuesos a Desolace.‡Lleva la gema ardiente y 15 gemas ardientes imbuidas a Maurin Partehuesos a Desolace.‡Apporter une Gemme ardente et 15 Gemmes ardente canalisées à Maurin Bonesplitter en Désolace.‡将15块燃烧宝石转变为灌入灵魂的燃烧宝石，然后把它们交给凄凉之地的玛乌林·碎骨。‡將15塊燃燒寶石轉變為灌入靈魂的燃燒寶石，然後把它們交給淒涼之地的瑪烏林·碎骨。',
  }
},
[1436] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianz-Beziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關系',
    nil,
    'Fale com Keldran em Orgrimmar.‡Поговорите с Кельдраном в Оргриммаре.‡Sprecht mit Keldran in Orgrimmar.‡오그리마에 있는 켈드란과 대화하십시오.‡Habla con Keldran en Orgrimmar.‡Habla con Keldran en Orgrimmar.‡Parler à Keldran à Orgrimmar.‡与奥格瑞玛的科尔丹谈一谈。‡與奧格瑞瑪的科爾丹談壹談。',
  }
},
[1437] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando a Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉裏爾的搜尋',
    nil,
    'Procure a carroça de Tyranis e Dalinda Malem na Desolação.‡Отправляйтесь в Пустоши и попытайтесь отыскать повозку Тираниса и Далинды Малем.‡Sucht und findet den Wagen von Tyranis und Dalinda Malem in Desolace.‡잊혀진 땅에서 티라니스 말렘과 달린다 말렘의 마차를 찾아 조사해야 합니다.‡Busca y registra el carro de Tyranis y Dalinda Malem en Desolace.‡Busca y registra el carro de Tyranis y Dalinda Malem en Desolace.‡Rechercher le chariot de Tyranis et de Dalinda Malem en Désolace.‡去凄凉之地寻找泰拉尼斯·玛雷姆和黛琳达·玛雷姆的马车。‡去淒涼之地尋找泰拉尼斯·瑪雷姆和黛琳達·瑪雷姆的馬車。',
  }
},
[1438] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando a Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉裏爾的搜尋',
    nil,
    'Encontre Dalinda Malem na Desolação.‡Найдите в Пустошах Далинду Малем.‡Sucht Dalinda Malem in Desolace.‡잊혀진 땅에서 달린다 말렘을 찾아야 합니다.‡Encuentra a Dalinda Malem en Desolace.‡Encuentra a Dalinda Malem en Desolace.‡Trouver Dalinda Malem en Désolace.‡去凄凉之地找到黛琳达·玛雷姆。‡去淒涼之地找到黛琳達·瑪雷姆。',
  }
},
[1439] = {
  {
    'A busca por Tyranis‡Поиски Тираниса‡Suche nach Tyranis‡티라니스 수색‡Buscando a Tyranis‡Buscando a Tyranis‡À la recherche de Tyranis‡寻找泰拉尼斯‡尋找泰拉尼斯',
    nil,
    'Encontre Tyranis Malem na Desolação.‡Разыщите в безлюдье Тираниса Малема.‡Sucht Tyranis Malem in Desolace.‡잊혀진 땅에서 티라니스 말렘을 찾아야 합니다.‡Encuentra a Tyranis Malem en Desolace.‡Encuentra a Tyranis Malem en Desolace.‡Trouver Tyranis Malem en Désolace.‡去凄凉之地找到泰拉尼斯·玛雷姆。‡去淒涼之地找到泰拉尼斯·瑪雷姆。',
  }
},
[1440] = {
  {
    'O retorno a Vahlarriel‡Возвращение к Валарриэлю‡Rückkehr nach Vahlarriel‡발라리엘에게 돌아가기‡Vuelve con Vahlarriel‡Regresa junto a Vahlarriel‡Le retour vers Vahlarriel‡回复瓦拉里尔‡回復瓦拉裏爾',
    nil,
    'Escolte Dalinda Malem a partir da Fortaleza Machado do Trovão e fale novamente com Vahlarriel Matademônios na Desolação.‡Выведите Далинду Малем из Крепости Громового Топора, а затем вернитесь в Пустоши к Валлариелю Истребителю Демонов.‡Begleitet Dalinda Malem aus der Festung Thunder Axe und kehrt zu Vahlarriel Demonslayer nach Desolace zurück.‡천둥도끼 요새에서 달린다 말렘을 호위해 잊혀진 땅에 있는 발라리엘 데몬슬레이어에게 돌아가야 합니다.‡Escolta a Dalinda Malem fuera de la Fortaleza del Hacha de Trueno y vuelve a Desolace a hablar con Vahlarriel Destripademonios.‡Escolta a Dalinda Malem fuera de la Fortaleza del Hacha de Trueno y vuelve a Desolace a hablar con Vahlarriel Destripademonios.‡Escorter Dalinda Malem depuis la forteresse de Hache-Tonnerre et retourner voir Vahlarriel Demonslayer, en Désolace.‡护送黛琳达·玛雷姆离开雷斧堡垒，然后回到凄凉之地的瓦拉里尔·屠魔者那里。‡護送黛琳達·瑪雷姆離開雷斧堡壘，然後回到淒涼之地的瓦拉裏爾·屠魔者那裏。',
  }
},
[1442] = {
  {
    'Em busca da Gema Kor‡Поиск самоцвета Кора‡Suche nach dem Kor-Edelstein‡코르석을 찾아서‡La búsqueda de la gema Kor‡La búsqueda de la gema Kor‡À la recherche de la gemme de Kor‡寻找科尔宝石‡尋找科爾寶石',
    nil,
    'Leve a Gema Kor para Trovejius Tecevento, na Costa Negra.‡Принесите самоцвет Кора Тандрису Ветропряду на Темных берегах.‡Bringt einen Kor-Edelstein zu Thundris Windwirker in Dunkelküste.‡어둠의 해안에 있는 툰드리스 윈드위버에게 코르석을 하나 가져가야 합니다.‡Lleva una gema Kor a Thundris Tejevientos a Costa Oscura.‡Lleva una gema Kor a Thundris Tejevientos a Costa Oscura.‡Apporter une Gemme de Kor à Thundris Windweaver à Sombrivage.‡给黑海岸的桑迪斯·织风带去一块科尔宝石。‡給黑海岸的桑迪斯·織風帶去壹塊科爾寶石。',
  }
},
[1444] = {
  {
    'Retorno a Vil\'zerul‡Возвращение к Фел\'зерулу‡Rückkehr zu Fel\'Zerul‡펠제룰에게 돌아가기‡Vuelve con Fel\'Zerul‡Regresa junto a Fel\'Zerul‡De retour vers Fel’Zerul‡向费泽鲁尔复命‡向費澤魯爾復命',
    nil,
    'Fale novamente com Vil\'Zerul em Pedregal.‡Вернитесь в Каменор к Фел\'зерулу.‡Kehrt zu Fel\'Zerul in Stonard zurück.‡스토나드에 있는 펠제룰에게 돌아가야 합니다.‡Vuelve a ver a Fel\'Zerul en Rocal.‡Vuelve a ver a Fel\'Zerul en Rocal.‡Retourner voir Fel’Zerul à Stonard.‡向斯通纳德的费泽鲁尔回报。‡向斯通納德的費澤魯爾回報。',
  }
},
[1445] = {
  {
    'O templo de Atal\'Hakkar‡Храм Атал\'Хаккара‡Der Tempel von Atal\'Hakkar‡아탈학카르 신전‡El Templo de Atal\'Hakkar‡El Templo de Atal\'Hakkar‡Le temple d\'Atal\'Hakkar‡阿塔哈卡神庙‡阿塔哈卡神廟',
    nil,
    'Obtenha 20 Fetiches de Hakkar e leve-os para Vil\'Zerul em Pedregal.‡Соберите 20 фетишей Хаккара и принесите их Фел\'зерулу в Каменор.‡Sammelt 20 Fetische von Hakkar und bringt sie zu Fel\'Zerul in Stonard.‡스토나드에 있는 펠제룰에게 학카르의 우상 20개를 가져가야 합니다.‡Reúne 20 fetiches de Hakkar y llévaselos a Fel\'Zerul en Rocal.‡Reúne 20 fetiches de Hakkar y llévaselos a Fel\'Zerul en Rocal.‡Rassembler 20 Fétiches d\'Hakkar et les apporter à Fel’Zerul à Stonard.‡收集20个哈卡神像，把它们带给斯通纳德的费泽鲁尔。‡收集20個哈卡神像，把它們帶給斯通納德的費澤魯爾。',
  }
},
[1446] = {
  {
    'Jammal\'an, o Profeta‡Джаммал\'ан Пророк‡Jammal\'an der Prophet‡예언자 잠말란‡El profeta Jammal\'an‡Jammal\'an el Profeta‡Jammal\'an le Prophète‡预言者迦玛兰‡預言者迦瑪蘭',
    nil,
    'O Exilado Atal\'ai nas Terras Agrestes quer a Cabeça de Jammal\'an.‡Принесите изгнаннику Атал\'ай из Внутренних земель голову Джаммал\'ана.‡Der Verbannte der Atal\'ai im Hinterland möchte den Kopf von Jammal\'an.‡잠말란을 처치하고 그 증거로 그의 머리카락을 동부 내륙지에 있는 추방된 아탈라이트롤에게 가져가야 합니다.‡El exiliado de Atal\'ai, en las Tierras del Interior, quiere la cabeza de Jammal\'an.‡El exiliado Atal\'ai, en las Tierras del Interior, quiere la cabeza de Jammal\'an.‡L\'Exilé atal\'ai des Hinterlands veut la Tête de Jammal\'an.‡辛特兰的阿塔莱流放者要你给他带回迦玛兰的头。‡辛特蘭的阿塔萊流放者要妳給他帶回迦瑪蘭的頭。',
  }
},
[1447] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Derrote Dashel Punhopétreo em Ventobravo.‡Победите Дашеля Каменного Кулака в Штормграде.‡Besiegt Dashel Stonefist in Stormwind.‡스톰윈드에 있는 다셸 스톤피스트와 싸워 이겨야 합니다.‡Derrota a Dashel Puñopiedra en Ventormenta.‡Derrota a Dashel Puñopiedra en Ventormenta.‡Battre Dashel Stonefist à Stormwind.‡击败暴风城的达舍尔·石拳。‡擊敗暴風城的達舍爾·石拳。',
  }
},
[1448] = {
  {
    'Em busca do templo‡В поисках Храма‡Auf der Suche nach dem Tempel‡신전을 찾아서‡En búsqueda del templo‡En búsqueda del templo‡À la recherche du temple‡调查神庙‡調查神廟',
    nil,
    'Brohann Barrilga, em Ventobravo, quer que você saia à procura do Templo de Atal\'Hakkar.‡Найдите Храм Атал\'Хаккара и сообщите о его местонахождении Брохану Бочкопузу из Штормграда.‡Brohann Caskbelly in Stormwind möchte, dass Ihr den Tempel von Atal\'Hakkar sucht.‡스톰윈드에 있는 브로한 캐스크벨리가 아탈학카르 신전을 찾아 달라고 부탁했습니다.‡Brohann Barriliga, en Ventormenta, quiere que busques el Templo de Atal\'Hakkar.‡Brohann Barriliga, en Ventormenta, quiere que busques El Templo de Atal\'Hakkar.‡Brohann Caskbelly à Stormwind veut que vous recherchiez le temple d\'Atal\'Hakkar.‡暴风城的布罗哈恩·铁桶要求你去找到阿塔哈卡神庙。‡暴風城的布羅哈恩·鐵桶要求妳去找到阿塔哈卡神廟。',
  }
},
[1449] = {
  {
    'Rumo às Terras Agrestes‡Во Внутренние земли‡Ins Hinterland‡동부 내륙지로‡A las Tierras del Interior‡A las Tierras del Interior‡Vers les Hinterlands‡去辛特兰的旅程‡去辛特蘭的旅程',
    nil,
    'Fale com o Alto Thane Falstad Martelo Feroz no Ninho da Águia nas Terras Agrestes.‡Поговорите с Верховным таном Фалстадом Громовым Молотом на Заоблачном Пике во Внутренних землях.‡Sprecht mit dem obersten Than, Falstad Wildhammer, in Aerie Peak im Hinterland.‡동부 내륙지 맹금의 봉우리에 있는 대영주 폴스타트 와일드해머와 대화해야 합니다.‡Habla con el Gran señor feudal Falstad Martillo Salvaje en el Pico Nidal, en las Tierras del Interior.‡Habla con el Gran señor feudal Falstad Martillo Salvaje en el Pico Nidal, en las Tierras del Interior.‡Parler au haut-thane Falstad Wildhammer, au Nid-de-l\'Aigle des Hinterlands.‡找到辛特兰的弗斯塔德·蛮锤。‡找到辛特蘭的弗斯塔德·蠻錘。',
  }
},
[1450] = {
  {
    'Mestre de Grifos Garra-de-acha‡Укротитель грифонов Разящий Коготь‡Greifenmeister Talonaxe‡그리핀 조련사 탈론액스‡Maestro de grifos Garracha‡Maestro de grifos Garracha‡Le Maître des gryphons Talonaxe‡狮鹫管理员‡獅鷲管理員',
    nil,
    'Fale com o Mestre de Grifos Garra-de-acha no Aviário do Ninho da Águia.‡Поговорите с укротителем грифонов Разящим Когтем в питомнике на Заоблачном Пике.‡Sprecht mit Greifenmeister Talonaxe im Horst bei Aerie Peak.‡맹금의 봉우리 출격장 안에 있는 그리핀 조련사 탈론액스와 대화해야 합니다.‡Habla con el maestro de grifos Garracha dentro de la pajarera del Pico Nidal.‡Habla con el maestro de grifos Garracha dentro de la pajarera del Pico Nidal.‡Parler au Maître des gryphons Talonaxe dans la Volière de Nid-de-l\'Aigle‡与辛特兰的鹰巢山狮鹫饲养场里的狮鹫管理员沙拉克·鹰斧谈一谈。‡與辛特蘭的鷹巢山獅鷲飼養場裏的獅鷲管理員沙拉克·鷹斧談壹談。',
  }
},
[1451] = {
  {
    'Rapsódico Festanjeiro‡Рапсод Землекоп‡Rhapsody-Shindigger‡랩소디 신디거‡Rapsodio Machacacanillas‡Rapsodio Machacacanillas‡Rhapsody Shindigger‡拉普索迪·铁铲‡拉普索迪·鐵鏟',
    nil,
    'Procure Rapsódico Festanjeiro nas Terras Agrestes.‡Найдите Рапсода Землекопа во Внутренних землях.‡Sucht Rhapsody Shindigger im Hinterland.‡동부 내륙지에서 랩소디 신디거를 찾아야 합니다.‡Busca a Rapsodio Machacacanillas en las Tierras del Interior.‡Busca a Rapsodio Machacacanillas en las Tierras del Interior.‡Chercher Rhapsody Shindigger dans les Hinterlands.‡去辛特兰找到拉普索迪·铁铲。‡去辛特蘭找到拉普索迪·鐵鏟。',
  }
},
[1452] = {
  {
    'O Coquetel de Kalimdor do Rapsódico‡Калимдорский коктейль‡Rhapsodys Kalimdor-Cocktail‡랩소디의 칼림도어 칵테일‡El cubata de Kalimdor de Rapsodio‡El cubata de Kalimdor de Rapsodio‡Le Kocktail Kalimdor de Rhapsody‡拉普索迪的卡利姆多鸡尾酒‡拉普索迪的卡利姆多雞尾酒',
    nil,
    'Rapsódico Festanjeiro, nas Terras Agrestes, quer que você consiga 3 Moelas de Roca, 3 Fígados de Groddoc e 3 Fígados de Veloférreo.‡Принесите Рапсоду Землекопу 3 куска потрохов руха, 3 печени гроддока и 3 печени железномеха.‡Rhapsody Shindigger im Hinterland möchte, dass Ihr ihm 3 Muskelmägen eines Roc, 3 Groddoc-Lebern und 3 Eisenfelllebern bringt.‡동부 내륙지에 있는 랩소디 신디거가 로크 모래주머니 3개, 그로독 고릴라 간 3개, 무쇠곰 간 3개를 가져다 달라고 부탁했습니다.‡Rapsodio Machacacanillas, en las Tierras del Interior, quiere que le lleves 3 mollejas de Roc, 3 hígados de Groddoc y 3 hígados de piel pétrea.‡Rapsodio Machacacanillas, en las Tierras del Interior, quiere que le lleves 3 mollejas de roc, 3 hígados de Groddoc y 3 hígados de Cueracero.‡Rhapsody Shindigger dans les Hinterlands veut que vous lui rameniez 3 Gésiers de roc, 3 Foies de Groddoc et 3 Foies de Ferpoil.‡辛特兰的拉普索迪·铁铲要求你带给他3块大鹏的砂囊、3块格罗多克猩猩的肝脏和3块铁鬃熊的肝脏。‡辛特蘭的拉普索迪·鐵鏟要求妳帶給他3塊大鵬的砂囊、3塊格羅多克猩猩的肝臟和3塊鐵鬃熊的肝臟。',
  }
},
[1453] = {
  {
    'Trago qualquer coisa em três dias‡Дела Поисковой корпорации в Пустошах‡Die Geschäfte der Wiederholer in Desolace‡잊혀진 땅에서의 회수 임무‡Los negocios de los Reivindicadores en Desolace‡Los negocios de los Recuperadores en Desolace‡Les affaires de Récupérateurs SA en Désolace‡寻物公司的业务‡尋物公司的業務',
    nil,
    'Fale com Kreldig Ungor, em Desolação.‡Поговорите с Крелдигом Унгором в Пустошах.‡Sprecht mit Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르와 대화해야 합니다.‡Habla con Kreldig Ungor en Desolace.‡Habla con Kreldig Ungor en Desolace.‡Parler à Kreldig Ungor en Désolace.‡和凄凉之地的克雷迪格·安戈尔谈一谈。‡和淒涼之地的克雷迪格·安戈爾談壹談。',
  }
},
[1454] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Encontre o Baú de Karnitol em Desolação.‡Найдите в Пустошах сундук Карнитола.‡Sucht Karnitols Truhe in Desolace.‡잊혀진 땅에서 카니톨의 궤짝을 찾아야 합니다.‡Encuentra el cofre de Karnitol en Desolace.‡Encuentra el cofre de Karnitol en Desolace.‡Retrouver le Coffre de Karnitol en Désolace.‡在凄凉之地找到卡尼托的箱子。‡在淒涼之地找到卡尼托的箱子。',
  }
},
[1455] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Fale novamente com Kreldig Ungor em Desolação.‡Вернитесь в Пустоши к Крелдигу Унгору.‡Kehrt zu Kreldig Ungor in Desolace zurück.‡잊혀진 땅에 있는 크렐디그 운고르에게 돌아가야 합니다.‡Vuelve a Desolace a hablar con Kreldig Ungor.‡Vuelve a Desolace a hablar con Kreldig Ungor.‡Retourner voir Kreldig Ungor en Désolace.‡回到凄凉之地的克雷迪格·安戈尔那里。‡回到淒涼之地的克雷迪格·安戈爾那裏。',
  }
},
[1456] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Encontre a Algibeira de Karnitol e leve-a de volta para Kreldig Ungor em Desolação.‡Найдите сумку для книг, принадлежащую Карнитолу, и отнесите ее в Пустоши Крелдигу Унгору.‡Sucht Karnitols Ranzen und bringt ihn zu Kreldig Ungor in Desolace zurück.‡카니톨의 가방을 찾아 잊혀진 땅에 있는 크렐디그 운고르에게 가져가야 합니다.‡Encuentra la cartera de Karnitol y devuélvesela a Kreldig Ungor, que está en Desolace.‡Encuentra la cartera de Karnitol y devuélvesela a Kreldig Ungor, que está en Desolace.‡Retrouver la Sacoche de Karnitol et la rapporter à Kreldig Ungor en Désolace.‡找到卡尼托的背包，把它交给凄凉之地的克雷迪格·安戈尔。‡找到卡尼托的背包，把它交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1457] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的背包‡卡尼托的背包',
    nil,
    'Leve a Algibeira de Karnitol para Putren Rochamalho em Altaforja.‡Отнесите сумку для книг, принадлежащую Карнитолу, в Стальгорн, и отдайте ее Ройттену Камнемолоту.‡Bringt Karnitols Ranzen zu Roetten Stonehammer in Ironforge.‡아이언포지에 있는 로이튼 스톤해머에게 카니톨의 가방을 가져가야 합니다.‡Lleva la cartera de Karnitol a Roetten Rocamartillo a Forjaz.‡Lleva la cartera de Karnitol a Roetten Rocamartillo a Forjaz.‡Apporter la Sacoche de Karnitol à Roetten Stonehammer à Ironforge.‡把卡尼托的背包交给铁炉堡的罗顿·石锤。‡把卡尼托的背包交給鐵爐堡的羅頓·石錘。',
  }
},
[1458] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委托',
    nil,
    'Leve 10 Garras Furiódio e 10 Chifres Furiódio para Kreldig Ungor na Desolação.‡Принесите 10 когтей и 10 рогов сатиров Ярой Ненависти в Пустоши Крелдигу Унгору.‡Bringt 10 Zornsäerklauen und 10 Zornsäerhörner zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 서릿발분노의 사티로스 발톱 10개와 서릿발분노의 사티로스 뿔 10개를 가져가야 합니다.‡Lleva 10 zarpas de Odio Feroz y 10 cuernos de Odio Feroz a Kreldig Ungor a Desolace.‡Lleva 10 zarpas de Odio Feroz y 10 cuernos de Odio Feroz a Kreldig Ungor a Desolace.‡Apporter 10 Griffes de Fielfurie et 10 Cornes de Fielfurie à Kreldig Ungor en Désolace.‡收集10只怨怒萨特的爪子和10根怨怒萨特的角，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10只怨怒薩特的爪子和10根怨怒薩特的角，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1459] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委托',
    nil,
    'Leve 7 ampolas de Peçonha de Scorpachi e 3 Pelegos Envelhecidos de Kodo para Kreldig Ungor na Desolação.‡Принесите 7 фиалов скорпионьего яда и 3 шкуры старого кодо в Пустоши Крелдигу Унгору.‡Bringt 7 Phiolen Skorpashigift und 3 Bälge von gealterten Kodos zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 스콜파시 독 7병과 늙은 코도 통가죽 3개를 가져가야 합니다.‡Lleva 7 viales de veneno de escórpido y 3 pieles de kodo maduro a Kreldig Ungor a Desolace.‡Lleva 7 viales de veneno de Scorpashi y 3 pellejos de kodo envejecido a Kreldig Ungor a Desolace.‡Apporter 7 Fioles de venin de scorpashi et 3 Peaux de vieux kodo à Kreldig Ungor, en Désolace.‡收集7瓶鞭尾蝎的毒液和3块老迈科多兽的毛皮，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集7瓶鞭尾蠍的毒液和3塊老邁科多獸的毛皮，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1462] = {
  {
    'Sapta da Terra‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Le sapta de terre‡大地灵契‡大地靈契',
    nil,
    'Fale com a Vidente Pena do Corvo para obter outra Sapta da Terra.‡Попросите у провидицы Воронье Перо еще одну сапту земли.‡Sprecht mit der Seherin Ravenfeather wegen eines weiteren Erdsaptas.‡예언자 레이븐페더에게 대지의 정기를 하나 더 부탁해야 합니다.‡Pide otra sapta de tierra a la profetisa Plumacuervo.‡Pide otra sapta de tierra a la vidente Plumacuervo.‡Parler à la Prophétesse Ravenfeather pour obtenir un autre Sapta de terre.‡向鸦羽先知要另一瓶大地灵契。‡',
  }
},
[1463] = {
  {
    'Sapta da Terra‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Le sapta de terre‡大地灵契‡大地靈契',
    nil,
    'Fale com Ranago Arauto da Terra para obter outra Sapta da Terra.‡Поговорите с Канагой заклинателем земли, чтобы получить еще один сапту земли.‡Sprecht mit Canaga Earthcaller wegen eines weiteren Erdsaptas.‡카나가 어스콜러에게 대지의 정기를 하나 더 달라고 부탁하십시오.‡Pide a Clamor de Tierra Canaga otra Sapta de tierra.‡Pide a Canaga Clamatierra otra Sapta de tierra.‡Parler à Canaga Earthcaller pour obtenir un autre Sapta de terre.‡向坎纳甘·地鸣要另一瓶大地灵契。‡',
  }
},
[1464] = {
  {
    'Sapta do Fogo‡Сапта огня‡Feuersapta‡불의 정기‡La sapta de fuego‡La sapta de fuego‡Le sapta de feu‡火焰灵契‡火焰靈契',
    nil,
    'Fale com Telf Joolam para obter outra Sapta do Fogo.‡Поговорите с Телфом Джоламом, чтобы получить еще одну сапту огня.‡Sprecht mit Telf Joolam wegen eines weiteren Feuersaptas.‡텔프 줄람에게 불의 정기를 하나 더 부탁하십시오.‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Parler à Telf Joolam pour obtenir un autre Sapta de feu.‡向泰尔夫·祖拉姆再要一个 火焰灵契。‡',
  }
},
[1465] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando a Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉裏爾的搜尋',
    nil,
    'Entregue o Pingente de Malem a Vahlarriel Matademônios na Desolação.‡Принесите подвеску Малемов в Пустоши Валарриелю Истребителю Демонов.‡Kehrt mit dem Malem-Anhänger zu Vahlarriel Demonslayer in Desolace zurück.‡잊혀진 땅에 있는 발라리엘 데몬슬레이어에게 말렘 펜던트를 가져가야 합니다.‡Lleva el colgante Malem a Vahlarriel Destripademonios a Desolace.‡Lleva el colgante Malem a Vahlarriel Destripademonios a Desolace.‡Rapporter le Pendentif de Malem à Vahlarriel Demonslayer en Désolace.‡向凄凉之地的瓦拉里尔·屠魔者回复。‡向淒涼之地的瓦拉裏爾·屠魔者回復。',
  }
},
[1466] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委托',
    nil,
    'Leve 10 Cérebros de Canisvil, 10 Asas Etéreas e 10 ampolas de Sangue do Guardião da Ruína para Kreldig Ungor na Desolação.‡Принесите 10 мозгов гончих Скверны, 10 крыльев пустоты и 10 фиалов крови Тюремщика Судеб в Пустоши Крелдигу Унгору.‡Bringt 10 Teufelshundgehirne, 10 Netherflügel und 10 Phiolen Verdammniswächterblut zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 지옥사냥개 뇌 10개, 황천의 날개 10개, 파멸의경비대 혈액 10병을 가져가야 합니다.‡Lleva 10 cerebros de can manáfago, 10 alas infernales y 10 viales de sangre de guardiavil a Kreldig Ungor a Desolace.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de guardiavil a Kreldig Ungor a Desolace.‡Apporter 10 Cervelles de gangrechiens, 10 Ailes du Néant et 10 Fioles de Sang de garde funeste à Kreldig Ungor, en Désolace.‡收集10个地狱犬的脑子、10对魔女之翼和10瓶末日看守之血，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10個地獄犬的腦子、10對魔女之翼和10瓶末日看守之血，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1467] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG.‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour Récupérateurs SA‡寻物公司的委托‡尋物公司的委托',
    nil,
    'Leve a Encomenda de Sinismago para Putren Rochamalho em Altaforja.‡Доставьте коробку Скрытного Кудесника в Стальгорн Ройттену Камнемолоту.‡Bringt Leftwitchs Päckchen zu Roetten Stonehammer in Ironforge zurück.‡아이언포지에 있는 로이튼 스톤해머에게 레프트위치의 소포를 가져가야 합니다.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Rapporter la Caisse de Leftwitch à Roetten Stonehammer à Ironforge.‡把莱弗维奇的包裹交给铁炉堡的罗顿·石锤。‡把萊弗維奇的包裹交給鐵爐堡的羅頓·石錘。',
  }
},
[1468] = {
  {
    'A Semana das Crianças‡Детская неделя‡Die Kinderwoche‡어린이 주간‡Semana de los Niños‡Semana de los Niños‡La Semaine des enfants‡儿童周‡兒童周',
    nil,
    'Use o Apito de Órfão Humano para conversar com a criança de quem você vai cuidar durante a Semana da Criança.‡Чтобы поговорить с ребенком, за которым вы будете присматривать, используйте сиротский свисток.‡Benutzt die Pfeife des menschlichen Waisenkindes um während der Kinderwoche mit Eurem Schützling zu sprechen.‡인간 고아 호루라기를 사용해 어린이 주간 동안 돌보게 될 아이와 대화하십시오.‡Utiliza el silbato de huérfano humano para hablar con el niño a quien tienes que cuidar durante la Semana de los Niños.‡Usa el silbato de huérfano humano para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Utilisez le Sifflet d\'orphelin humain pour parler à l\'enfant que vous protégerez pendant la Semaine des enfants.‡使用人类孤儿哨与你即将在儿童周期间照顾的孩子进行对话。‡使用人類孤兒哨與妳即將在兒童周期間照顧的孩子進行對話。',
  }
},
[1469] = {
  {
    'O caso do Rapsódico‡Рапсодия о болоте‡Rhapsodys Geschichte‡랩소디의 이야기‡El relato de Rapsodio‡El relato de Rapsodio‡L\'histoire de Rhapsody‡拉普索迪的故事‡拉普索迪的故事',
    nil,
    'Leve o Fragmento de Tabuleta Atal\'ai para Brohann Barrilga em Ventobravo.‡Отнесите фрагмент таблички Атал\'ай Брохану Бочкопузу в Штормград.‡Bringt das Schrifttafelfragment der Atal\'ai zu Brohann Caskbelly in Stormwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 조각을 가져가야 합니다.‡Lleva el fragmento de la tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Lleva el fragmento de la tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Apporter le Fragment de tablette atal\'ai à Brohann Caskbelly à Stormwind.‡将阿塔莱石板碎片交给暴风城的布罗哈恩·铁桶。‡將阿塔萊石板碎片交給暴風城的布羅哈恩·鐵桶。',
  }
},
[1470] = {
  {
    'Perfurando o véu‡Приоткрывая завесу‡Der zerrissene Schleier‡저 너머의 세계‡Descubrir el misterio‡Descubrir el misterio‡Lever le voile‡控制小鬼‡控制小鬼',
    nil,
    'Leve 3 Crânios de Range-ossos para Vênia Martingil.‡Принесите Вении Мартанд 3 черепа скелетов-костетрясов.‡Bringt Venya Marthand 3 Schädel eines klappernden Skeletts.‡벤야 말선드에게 덜그럭거리는 해골 3개를 가져가야 합니다.‡Lleva 3 calaveras de armadóseos a Venya Martmani.‡Lleva 3 calaveras de armadóseos a Venya Marthand.‡Apporter 3 Crânes de Cliquethorax à Venya Marthand.‡收集3个断骨骷髅的颅骨，把它们交给温雅·玛山德。‡收集3個斷骨骷髏的顱骨，把它們交給溫雅·瑪山德。',
  }
},
[1471] = {
  {
    'A vinculação‡Оковы‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando as Runas de Evocação, evoque e subjugue um Emissário do Caos. Depois, devolva os Glifos de Evocação para Silvério Hidalgo no Distrito da Magia na Cidade Baixa.‡При помощи Рун Призыва вызовите и подчините себе демона Бездны, а потом верните Руны Призыва Карендину Халгару в Квартале Магов Подгорода.‡Beschwört mit Hilfe der Runen der Beschwörung einen Leerwandler, unterwerft ihn und bringt die Runen der Beschwörung dann zu Carendin Halger im Tempel der Verdammten zurück.‡소환의 룬을 사용하여 보이드워커를 소환하여 제압한 다음 언더시티의 마법 지구에 있는 카렌딘 할가르에게 소환의 룬을 가지고 돌아가야 합니다.‡Utilizando las Runas de invocación, invoca y domina a un abisario, y después devuélvele las Runas de invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando las Runas de invocación, invoca y domina a un abisario, y después devuélvele las Runas de invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Runes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Runes d’invocation à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只虚空行者，然后将召唤符文还给诅咒神庙中的凯伦丁·哈加尔。‡召喚並征服壹只虛空行者，然後將召喚符文還給詛咒神廟中的凱倫丁·哈加爾。',
  }
},
[1472] = {
  {
    'Devoradora de almas‡Пожирательница душ‡Verschlinger der Seelen‡영혼에 굶주린 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Godofredo Fasano no Templo dos Malditos.‡Поговорите с Годриком Фарсаном в Храме Проклятых.‡Sprecht mit Godrick Farsan im Tempel der Verdammten.‡저주의 사원에 있는 고드릭 파선과 대화해야 합니다.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Parler à Godrick Farsan au Temple des damnés.‡与诅咒神殿中的高德瑞克·法杉谈一谈。‡與詛咒神殿中的高德瑞克·法杉談壹談。',
  }
},
[1473] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 피조물‡Criatura abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛空中的生物',
    nil,
    'Recupere o Grimório de Egalin e leve-o para Silvério Hidalgo no Templo dos Malditos.‡Найдите гримуар Эгалина и отнесите его Карендину Халгару в Храм Проклятых.‡Beschafft Egalins Zauberfolianten und bringt ihn zu Carendin Halgar in den Tempel der Verdammten.‡에갈린의 흑마법서를 되찾아 저주의 사원에 있는 카렌딘 할가르에게 가져가야 합니다.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Retrouver le Grimoire d\'Egalin et l\'apporter à Carendin Halgar au Temple des damnés.‡夺回埃加林的魔典，把它交给诅咒神庙中的凯伦丁·哈加尔。‡奪回埃加林的魔典，把它交給詛咒神廟中的凱倫丁·哈加爾。',
  }
},
[1474] = {
  {
    'A vinculação‡Оковы‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Corações Puros, evoque e subjugue uma súcubo. Depois, devolva os Corações Puros para Silvério Hidalgo no Distrito da Magia na Cidade Baixa.‡При помощи Чистых Сердец призовите и подчините себе суккуба, а потом верните Чистые Сердца Карендину Халгару в Квартале Магов Подгорода.‡Beschwört mit Hilfe der reinen Herzen einen Sukkubus, unterwerft ihn und bringt die reinen Herzen dann zu Carendin Halger im Tempel der Verdammten zurück.‡순수한 심장을 사용하여 서큐버스를 소환하여 제압한 다음, 언더시티에 있는 마법 지구에 있는 카렌딘 할가르에게 순수한 심장을 가져가야 합니다.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Coeurs purs pour invoquer et soumettre une succube, puis rapporter les Coeurs purs à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只魅魔，然后将纯洁的心还给诅咒神庙里的凯伦丁·哈加尔。‡召喚並征服壹只魅魔，然後將純潔的心還給詛咒神廟裏的凱倫丁·哈加爾。',
  }
},
[1475] = {
  {
    'No templo de Atal\'Hakkar‡В Храме Атал\'Хаккара‡Im Tempel von Atal\'Hakkar‡아탈학카르 신전으로‡En El Templo de Atal\'Hakkar‡En El Templo de Atal\'Hakkar‡Dans le temple d\'Atal\'Hakkar‡进入阿塔哈卡神庙‡進入阿塔哈卡神廟',
    nil,
    'Leve 10 Tabuletas Atal\'ai para Brohann Barrilga em Ventobravo.‡Соберите 10 табличек Атал\'ай для Брохана Бочкопуза из Штормграда.‡Sammelt 10 Schrifttafeln der Atal\'ai für Brohann Caskbelly in Stormwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 10개를 가져가야 합니다.‡Consigue 10 tablillas de Atal\'ai para Brohann Barriliga, en Ventormenta.‡Consigue 10 tablillas de Atal\'ai para Brohann Barriliga en Ventormenta.‡Rassembler 10 Tablettes atal\'ai pour Brohann Caskbelly à Stormwind.‡为暴风城的布罗哈恩·铁桶收集10块阿塔莱石板。‡為暴風城的布羅哈恩·鐵桶收集10塊阿塔萊石板。',
  }
},
[1476] = {
  {
    'Corações dos Puros‡Чистые сердца‡Herzen der Reinen‡선한 자의 유품‡Corazones puros‡Corazones puros‡Des cœurs purs‡纯洁者之心‡純潔者之心',
    nil,
    'Leve os corações de Dalin Forjífice e Comar Villard para Silvério Hidalgo no Templo dos Malditos.‡Принесите сердца Далина Искусника и Комера Вилларда Карендину Халгару в Храм Проклятых.‡Bringt die Herzen von Dalin Forgewright und Comar Villard zu Carendin Halgar im Tempel der Verdammten.‡저주의 사원에 있는 카렌딘 할가르에게 달린의 유품과 코마의 유품을 가져가야 합니다.‡Llévale los corazones de Dalin Forjafina y Comar Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Llévale los corazones de Dalin Forjador y Comar Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Apporter les Cœurs de Dalin Forgewright et de Comar Villard à Carendin Halgar dans le Temple des Damnés.‡将达林和科马的心脏交给诅咒神殿里的凯伦丁·哈加尔。‡將達林和科馬的心臟交給詛咒神殿裏的凱倫丁·哈加爾。',
  }
},
[1477] = {
  {
    'Suprimentos Vitais‡Важные поставки‡Überaus wichtige Vorräte‡중요한 보급품‡Suministros de vital importancia‡Suministros de vital importancia‡Fournitures vitales‡重要的补给‡重要的補給',
    nil,
    'Fale com Mestre-Vigia Sorigal.‡Поговорите с начальником стражи Соригелом.‡Sprecht mit Wachhauptmann Sorigal.‡순찰대장 소리갈을 만나 이야기를 나눠야 합니다.‡Habla con el maestro de vigilantes Sorigal.‡Habla con el maestro de vigilantes Sorigal en Villa Oscura, en el Bosque del Ocaso.‡Parler au Maître de guet Sorigal.‡和守卫队长索里加尔谈一谈。‡和守衛隊長索裏加爾談壹談。',
  }
},
[1478] = {
  {
    'Convocação de Hidalgo‡Призыв Халгара‡Halgars Beschwörung‡할가르의 부름‡Las invocaciones de Halgar‡Las invocaciones de Halgar‡Les invocations de Halgar‡哈加尔的召唤‡哈加爾的召喚',
    nil,
    'Fale com Silvério Hidalgo na Cidade Baixa.‡Поговорите с Карендином Халгаром в Подгороде.‡Sprecht mit Carendin Halgar in Undercity.‡언더시티에 있는 카렌딘 할가르와 대화해야 합니다.‡Habla con Carendin Halgar en Entrañas.‡Habla con Carendin Halgar en Entrañas.‡Parler à Carendin Halgar à Undercity.‡与幽暗城的凯伦丁·哈加尔谈一谈。‡與幽暗城的凱倫丁·哈加爾談壹談。',
  }
},
[1479] = {
  {
    'O Ramo dos Eternos‡Купина Вечности‡Der Baum der Ewigen‡영원의 줄기‡La Rama de los Eternos‡La Rama de los Eternos‡Le Rameau des Éternels‡永恒之树‡永恒之樹',
    nil,
    'Leve o órfão ao banco de Darnassus. O banco foi esculpido dentro de uma árvore, conhecida como o Ramo dos Eternos.‡Отведите сироту к банку Дарнасса. Банк находится в дупле дерева, которое называется Купина Вечности.‡Begleitet Euren Schützling zur Bank in Darnassus. Die dortige Bank ist in einen Baum gebaut, welcher als der Baum der Ewigen bekannt ist.‡랜디스를 다르나서스 은행에 데려다 주어야 합니다. 은행 자체는 영원의 줄기라고 알려진 나무 안에 있습니다.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Conduire l\'orphelin à la banque de Darnassus. La banque est creusée dans le tronc d\'un arbre connu sous le nom du Rameau des Éternels.‡带着你看护的孤儿去达纳苏斯的银行。银行就坐落在一棵中空的树里，它被称为永恒之树。‡帶著妳看護的孤兒去達納蘇斯的銀行。銀行就坐落在壹棵中空的樹裏，它被稱為永恒之樹。',
  }
},
[1480] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve a Pele de Demônio Esfolada a Maurin Rachaosso na Desolação.‡Отнесите рваную демонскую кожу Майрину Костолому в Пустоши.‡Bringt die geschundene Dämonenhaut nach Desolace zu Maurin Bonesplitter.‡잊혀진 땅에 있는 마우린 본스플리터에게 악마의 가죽을 가져다주십시오.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Apporter une Peau de démon écorché à Maurin Bonesplitter en Désolace.‡把恶魔之皮拿给凄凉之地的玛乌林·碎骨看看。‡把惡魔之皮拿給淒涼之地的瑪烏林·碎骨看看。',
  }
},
[1481] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Escalpo de Assombrante para Maurin Rachaosso na Desolação.‡Принесите скальп тенелова Маурину Костолому в Пустошах.‡Bringt Maurin Bonesplitter in Desolace einen Schattenpirscherskalp.‡잊혀진 땅에 있는 마우린 본스플리터에게 그림자추적자 머릿가죽을 가져가야 합니다.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Apporter un Scalp de Traqueur des ténèbres à Maurin Bonesplitter en Désolace.‡给凄凉之地的玛乌林·碎骨带回一张巡影者的头皮。‡給淒涼之地的瑪烏林·碎骨帶回壹張巡影者的頭皮。',
  }
},
[1482] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Cristal de Oráculo para Maurin Rachaosso em Desolação.‡Принесите кристалл оракула Маурину Костолому в Пустоши.‡Bringt Maurin Bonesplitter in Desolace einen Orakelkristall.‡잊혀진 땅에 있는 마우린 본스플리터에게 예언의 수정구를 가져가야 합니다.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Apporter un Cristal d\'oracle à Maurin Bonesplitter, en Désolace.‡给凄凉之地的玛乌林·碎骨带回一块神谕水晶。‡給淒涼之地的瑪烏林·碎骨帶回壹塊神諭水晶。',
  }
},
[1483] = {
  {
    'Zé Fízzica‡Зиз Физзикс‡Ziz Fizziks‡지즈 피직스‡Ziz Fizziks‡Ziz Fizziks‡Ziz Fizziks‡菲兹克斯‡菲茲克斯',
    nil,
    'Fale com Zé Fízzica em Rochedo Cortavento.‡Поговорите с Зизом Физзиксом на Утесе Ветрорезов.‡Sprecht mit Ziz Fizziks bei der Scherwindklippe.‡칼바람 바위산에 있는 지즈 피직스와 대화하십시오.‡Habla con Ziz Fizziks en Risco Cortaviento.‡Habla con Ziz Fizziks en Risco Cortaviento.‡Parler à Ziz Fizziks dans la Combe des Cisailles.‡和狂风峭壁的菲兹克斯谈一谈。‡和狂風峭壁的菲茲克斯談壹談。',
  }
},
[1484] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Fale com Takta Laminaço em Desolação.‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Steelblade in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화하십시오.‡Habla con Takata Hojacero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parler à Takata Steelblade en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡與淒涼之地的塔卡塔·鋼刃談壹談。',
  }
},
[1485] = {
  {
    'Familiares Vis‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Leve 6 Cabeças de Demônios Familiares Vis para Ruzan.‡Принесите Рузану 6 голов злобных фамильяров.‡Bringt 6 Köpfe schändlicher Familiare zu Ruzan.‡루잔에게 악마의 하수인 머리 6개를 가져가야 합니다.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Apporter 6 Têtes de vils quasits à Ruzan.‡给鲁赞带回6颗邪灵劣魔的头颅。‡給魯贊帶回6顆邪靈劣魔的頭顱。',
  }
},
[1486] = {
  {
    'Pelegos anormais‡Шкуры загадочных существ‡Deviatbälge‡돌연변이 통가죽‡Pellejo de los descarriados‡Pellejos descarriados‡Les peaux communes‡变异皮革‡變異皮革',
    nil,
    'Nalpak na Caverna Ululante quer 20 Pelegos Anormais.‡Принесите 20 искаженных шкур Налпаку в Пещерах Стенаний.‡Nalpak in den Höhlen des Wehklagens möchte 20 Deviatbälge.‡통곡의 동굴에 있는 날팍이 돌연변이 통가죽 20개를 가져다 달라고 부탁했습니다.‡Nalpak de las Cuevas de los Lamentos quiere 20 cueros descarriados.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos descarriados.‡Napalk dans les Cavernes des lamentations veut 20 Peaux communes.‡哀嚎洞穴的纳尔帕克想要20张变异皮革。‡哀嚎洞穴的納爾帕克想要20張變異皮革。',
  }
},
[1487] = {
  {
    'Erradicação de Anormais‡Искоренение Скверны‡Ausrottung der Deviat‡돌연변이 짐승 섬멸‡Erradicación de descarriados‡Erradicación de descarriados‡L\'éradication des Déviants‡清除变异者‡清除變異者',
    nil,
    'Ebru, na Caverna Ululante, quer que você mate 7 Assoladores Anormais, 7 Víboras Anormais, 7 Trôpegos Anormais e 7 Presáteras Anormais.‡Убейте для Эбру 7 загадочных опустошителей, 7 загадочных гадюк, 7 загадочных шаркунов и 7 загадочных страхозубов.‡Ebru in den Höhlen des Wehklagens möchte, dass Ihr 7 Deviatverheerer, 7 Deviatvipern, 7 Deviatschlurfer und 7 Deviatschreckensfange tötet.‡통곡의 동굴에 있는 에브루가 돌연변이 약탈자랩터 7마리, 돌연변이 독사 7마리, 돌연변이 늪괴물 7마리, 돌연변이 송곳니천둥매 7마리를 처치해 달라고 부탁했습니다.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrados descarriados y 7 colminfernos descarriados.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrapiés descarriados y 7 colminfernos descarriados.‡Ebru, des Cavernes des lamentations, veut que vous tuiez 7 Ravageurs Déviant, 7 Vipères Déviant, 7 Glacials Déviant et 7 Crocs-d\'effroi Déviant.‡哀嚎洞穴的厄布鲁要求你杀掉7只变异破坏者、7只剧毒飞蛇、7只变异蹒跚者和7只变异尖牙风蛇。‡哀嚎洞穴的厄布魯要求妳殺掉7只變異破壞者、7只劇毒飛蛇、7只變異蹣跚者和7只變異尖牙風蛇。',
  }
},
[1488] = {
  {
    'O corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Mate Lorde Azrethoc e Jugkar Grim\'rod e fale novamente com Takta Laminaço em Desolação.‡Убейте лорда Азретока и Джуккара Грим\'рода и вернитесь к Такате Стальному Клинку в Пустоши.‡Besiegt Lord Azrethoc und Jugkar Grim\'rod. Kehrt dann zu Takata Steelblade in Desolace zurück.‡제왕 아즈레토크와 죽카르 그림로드를 처치하고 잊혀진 땅에 있는 타카타 스틸블레이드에게 돌아가십시오.‡Mata a Lord Azrethoc y a Jugkar Grim\'rod y ve a ver a Takata Hojacero a Desolace.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hoja de Acero a Desolace.‡Tuer le seigneur Azrethoc et Jugkar Grim\'rod puis retourner voir Takata Steelblade en Désolace.‡杀掉魔王阿兹雷索克和祖格卡，然后向凄凉之地的塔卡塔·钢刃复命。‡殺掉魔王阿茲雷索克和祖格卡，然後向淒涼之地的塔卡塔·鋼刃復命。',
  }
},
[1489] = {
  {
    'Hamuul Runa Totem‡Хамуул Рунический Тотем‡Hamuul Runetotem‡하뮬 룬토템‡Hamuul Runatótem‡Hamuul Tótem de Runa‡Hamuul Runetotem‡哈缪尔·符文图腾‡哈繆爾·符文圖騰',
    nil,
    'Fale com Hamuul Runa Totem‡Поговорите с Хамуулом Руническим Тотемом.‡Sprecht mit Hamuul Runetotem.‡하뮬 룬토템과 대화하십시오.‡Habla con Hamuul Runatótem.‡Habla con Hamuul Tótem de Runa.‡Parler à Hamuul Runetotem.‡和哈缪尔·符文图腾谈一谈。‡和哈繆爾·符文圖騰談壹談。',
  }
},
[1490] = {
  {
    'Nara Juba Agreste‡Нара Буйногривая‡Nara Wildmane‡나라 와일드메인‡Nara Bravacrín‡Nara Ferocrín‡Nara Wildmane‡纳拉·蛮鬃‡納拉·蠻鬃',
    nil,
    'Fale com Nara Juba Agreste.‡Поговорите с Нарой Буйногривой.‡Sprecht mit Nara Wildmane.‡나라 와일드메인과 대화하십시오.‡Habla con Nara Bravacrín.‡Habla con Nara Ferocrín.‡Parler à Nara Wildmane.‡和纳拉·蛮鬃谈一谈。‡和納拉·蠻鬃談壹談。',
  }
},
[1491] = {
  {
    'Bebidas inteligentes‡Умный напиток‡Klugheitstränke‡영리해지는 음료‡Las bebidas astutas‡Bebidas de inteligencia‡Les potions d\'intelligence‡智慧饮料‡智慧飲料',
    nil,
    'Leve 6 porções de Essência Ululante para Cáliper Porcatraca na Vila Catraca.‡Принесите 6 порций воющей субстанции Мебоку Миззриксу в Кабестан.‡Bringt 6 Portionen Klageessenz zu Mebok Mizzyrix in Ratchet.‡톱니항에 있는 메보크 미지릭스에게 통곡의 정수 6병을 가져가야 합니다.‡Llévale 6 unidades de esencia de lamentos a Mebok Mizzyrix en Trinquete‡Llévale 6 porciones de esencia de lamentos a Mebok Mizzyrix en Trinquete.‡Apporter 6 doses d\'Essence de lamentation à Mebok Mizzyrix, à Ratchet.‡收集6份哀嚎香精，把它们交给棘齿城的麦伯克·米希瑞克斯。‡收集6份哀嚎香精，把它們交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[1492] = {
  {
    'Mestre Portuário Caruncho‡Управляющий пристанью Головокружилкинc‡Werftmeister Dizzywig‡부두주임 디지위그‡Vertipeluca, el maestro de muelles‡Maestro de muelles Vertipeluca‡Maître des quais Dizzywig‡码头管理员迪兹维格‡碼頭管理員迪茲維格',
    nil,
    'Leve o Caixote Fechado para o Mestre Portuário Caruncho na Vila Catraca.‡Отнесите надежный ящик управляющему пристанью Головокружилкинcу в Кабестан.‡Bringt die gesicherte Kiste zu Werftmeister Dizzywig in Ratchet.‡톱니항에 있는 부두주임 디지위그에게 단단히 잠긴 상자를 가져가야 합니다.‡Llévale el cajón de seguridad a Vertipeluca, el maestro de muelles, en Trinquete.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Apporter la Caisse sûre au Maître des quais Dizzywig à Ratchet.‡把保险箱交给棘齿城的码头管理员迪兹维格。‡把保險箱交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[1498] = {
  {
    'Caminho da defesa‡Путь защиты‡Weg der Verteidigung‡수호자의 길‡Camino de defensa‡Camino de defensa‡La voie de la défense‡防御之道‡防禦之道',
    nil,
    'Leve 5 Escamas Chamuscadas para Uzzek no Posto Remoto, nos Sertões.‡Принесите 5 оплавленных чешуек Уззеку на Дальнюю заставу в Степях.‡Bringt 5 versengte Schuppen zu Uzzek im Farwatch-Posten im Brachland.‡불모의 땅의 전초 기지에 있는 우제크에게 그슬린 비늘 5개를 가져가야 합니다.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Apporter 5 Ecailles roussies à Uzzek au Poste de garde extérieur dans les Tarides.‡给贫瘠之地前沿哨所的犹塞克带回5块烧焦的鳞片。‡給貧瘠之地前沿哨所的猶塞克帶回5塊燒焦的鱗片。',
  }
},
[1499] = {
  {
    'Familiares torpes‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Fale com Zureta Vista-longa.‡Поговорите с Зуритой Востроглазой.‡Sprecht mit Zureetha Fargaze.‡주리타 파게이즈와 대화하십시오.‡Habla con Zureetha Vistalonga.‡Habla con Zureetha Vistalonga.‡Parler à Zureetha Fargaze.‡与祖雷萨谈一谈。‡與祖雷薩談壹談。',
  }
},
[1501] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 존재‡Criatura abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛空中的生物',
    nil,
    'Recupere a Tabuleta de Verga para Gan\'rul Olho de Sangue em Orgrimmar.‡Добудьте табличку Верги для Ган\'рула Кровавого Глаза в Оргриммаре.‡Holt die Schrifttafel der Verga für Gan\'rul Bloodeye in Orgrimmar.‡오그리마에 있는 간룰 블러드아이가 베르가의 서판을 되찾아 오라고 부탁했습니다.‡Lleva la tablilla de Vergua a Gan\'rul Ojo sangriento a Orgrimmar.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Récupérer la Tablette de Verga pour Gan\'rul Bloodeye à Orgrimmar.‡为奥格瑞玛的甘鲁尔·血眼找回维尔加石板。‡為奧格瑞瑪的甘魯爾·血眼找回維爾加石板。',
  }
},
[1502] = {
  {
    'Thun\'grim Olhafogo‡Тун\'грим Огневзор‡Thun\'grim Firegaze‡툰그림 파이어게이즈‡Thun\'grim Vistafuego‡Thun\'grim Vistafuego‡Thun\'grim Firegaze‡索恩格瑞姆·火眼‡索恩格瑞姆·火眼',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Firegaze im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화하십시오.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Firegaze dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡與貧瘠之地的索恩格瑞姆·火眼談壹談。',
  }
},
[1503] = {
  {
    'Aço forjado‡Стальные слитки‡Geschmiedeter Stahl‡단조된 강철‡Acero fundido‡Acero fundido‡Acier forgé‡锻造好的钢锭‡鍛造好的鋼錠',
    nil,
    'Leve as Barras de Aço Forjado para Thun\'grim Olhafogo nos Sertões.‡Принесите стальные слитки Тун\'гриму Огневзору из Степей.‡Bringt die Schmiedestahlbarren zu Thun\'grim Firegaze im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈에게 단조된 강철 주괴를 가져가야 합니다.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Apporter les Barres d\'Acier forgé à Thun\'grim Firegaze dans les Tarides.‡把锻造好的钢锭带给贫瘠之地的索恩格瑞姆·火眼。‡把鍛造好的鋼錠帶給貧瘠之地的索恩格瑞姆·火眼。',
  }
},
[1504] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Glifos de Evocação, evoque e subjugue um Emissário do Caos; depois, devolva os Glifos de Evocação para Gan\'rul Olho de Sangue em Orgrimmar.‡Используя знаки Призыва, призовите и подчините своей воле демона Бездны. Верните знаки Призыва Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mit Hilfe der Glyphen der Beschwörung einen Leerwandler, unterwerft ihn und bringt dann die Glyphen der Beschwörung zu Gan\'rul Bloodeye in Orgrimmar zurück.‡소환의 문양을 사용해 보이드워커를 소환하여 굴복시킨 다음 오그리마에 있는 간룰 블러드아이에게 사용한 소환의 문양을 가지고 돌아가십시오.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojo sangriento a Orgrimmar.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser les Glyphes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Glyphes d\'invocation à Gan\'rul Bloodeye, à Orgrimmar.‡召唤并征服一只虚空行者，然后带着召唤铭文向奥格瑞玛的甘鲁尔·血眼回报。‡召喚並征服壹只虛空行者，然後帶著召喚銘文向奧格瑞瑪的甘魯爾·血眼回報。',
  }
},
[1505] = {
  {
    'Veterano Uzzek‡Ветеран Уззек‡Veteran Uzzek‡노련한 우제크‡Uzzek, el veterano‡Uzzek, el veterano‡Le vétéran Uzzek‡老兵犹塞克‡老兵猶塞克',
    nil,
    'Fale com Uzzek no Posto Remoto.‡Поговорите с Уззеком на Дальней заставе.‡Sprecht mit Uzzek im Farwatch-Posten.‡전초 기지에 있는 우제크과 대화하십시오.‡Habla con Uzzek en Avanzada del Puente.‡Habla con Uzzek en Avanzada del Puente.‡Parler à Uzzek au Poste de garde extérieur.‡和前沿哨所的犹塞克谈一谈。‡和前沿哨所的猶塞克談壹談。',
  }
},
[1506] = {
  {
    'Convocação de Gan\'rul‡Призыв от Ган\'рула‡Gan\'ruls Beschwörung‡간룰의 소환‡Las invocaciones de Gan\'rul‡Las invocaciones de Gan\'rul‡Les invocations de Gan\'rul‡甘鲁尔的召唤‡甘魯爾的召喚',
    nil,
    'Fale com Gan\'rul Olho de Sangue em Orgrimmar.‡Найдите Ган\'рула Кровавого Глаза в Оргриммаре и поговорите с ним.‡Sprecht mit Gan\'rul Bloodeye in Orgrimmar.‡오그리마에 있는 간룰 블러드아이와 대화하십시오.‡Habla con Gan\'rul Ojo sangriento en Orgrimmar.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Parler à Gan\'rul Bloodeye à Orgrimmar.‡去奥格瑞玛和甘鲁尔·血眼谈一谈。‡去奧格瑞瑪和甘魯爾·血眼談壹談。',
  }
},
[1507] = {
  {
    'Devoradora de almas‡Пожирательница душ‡Verschlinger der Seelen‡영혼을 삼키는 존재‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Cazul no Antro das Sombras.‡Поговорите с Казулом в расселине Теней.‡Sprecht mit Cazul in der Kluft der Schatten.‡어둠의 틈에 있는 카줄과 대화하십시오.‡Habla con Cazul en el Circo de las Sombras.‡Habla con Cazul en el Circo de las Sombras.‡Parlez à Cazul à la Faille de l\'ombre.‡和暗影裂口的卡祖尔谈一谈。‡和暗影裂口的卡祖爾談壹談。',
  }
},
[1508] = {
  {
    'Cazul cego‡Слепой Казул‡Der blinde Cazul‡눈 먼 카줄‡Cazul, el ciego‡Cazul, el ciego‡Cazul l\'aveugle‡盲眼卡祖尔‡盲眼卡祖爾',
    nil,
    'Fale com Zankaja em Orgrimmar.‡Поговорите с Занкайей в Оргриммаре.‡Sprecht mit Zankaja in Orgrimmar.‡오그리마에 있는 잔카자와 대화하십시오.‡Habla con Zankaja en Orgrimmar.‡Habla con Zankaja en Orgrimmar.‡Parler à Zankaja à Orgrimmar.‡和奥格瑞玛的赞卡沙谈一谈。‡和奧格瑞瑪的贊卡沙談壹談。',
  }
},
[1509] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Gazrog na Encruzilhada.‡Поговорите с Газрогом в Перекрестке.‡Sprecht mit Gazrog in Crossroads.‡크로스로드에 있는 가즈록과 대화하십시오.‡Habla con Gazrog en El Cruce.‡Habla con Gazrog en El Cruce.‡Parler à Gazrog à la Croisée.‡找到十字路口的加兹罗格并和他谈一谈。‡找到十字路口的加茲羅格並和他談壹談。',
  }
},
[1510] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Ken\'zigla em Malaka\'jin.‡Поговорите с Кен\'зиглой в Малака\'джине.‡Sprecht mit Ken\'zigla am Malaka\'jin.‡말라카진에 있는 켄지글라와 대화하십시오.‡Habla con Ken\'zigla en Malaka\'jin.‡Habla con Ken\'zigla en Malaka\'jin.‡Parler à Ken\'zigla, au village de Malaka\'jin.‡找到玛拉卡金的肯兹格拉并和他谈一谈。‡找到瑪拉卡金的肯茲格拉並和他談壹談。',
  }
},
[1511] = {
  {
    'Trago do Ken\'zigla‡Зелье Кен\'зиглы‡Ken\'ziglas Trunk‡켄지글라의 술‡Poción de Ken\'zigla‡Jarabe de Ken\'zigla‡Breuvage de Ken\'zigla‡肯兹格拉的伤药‡肯茲格拉的傷藥',
    nil,
    'Leve o Trago do Ken\'zigla para o Bruto Logmar no Acampamento Taurajo.‡Отнесите зелье Кен\'зиглы рубаке Логмару в Лагерь Таурахо.‡Bringt Ken\'ziglas Trunk zu Grunzer Logmar im Camp Taurajo.‡타우라조 야영지에 있는 그런트 로그마르에게 켄지글라의 술을 가져가야 합니다.‡Lleva la poción de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Apporter le Breuvage de Ken\'zigla au grunt Logmar, à Camp Taurajo.‡将肯兹格拉的伤药交给陶拉祖营地的步兵劳格玛。‡將肯茲格拉的傷藥交給陶拉祖營地的步兵勞格瑪。',
  }
},
[1512] = {
  {
    'Presente do amor‡Дар любви‡Die Liebesgabe‡사랑의 선물‡Un regalo de amor‡Un regalo de amor‡Le cadeau de l\'amour‡爱的礼物‡愛的禮物',
    nil,
    'Leve o Pingente Coberto de Terra para Gan\'rul Olho de Sangue em Orgrimmar.‡Отнесите подвеску, испачканную грязью, Ган\'рулу Кровавому Глазу в Оргриммар.‡Bringt den schmutzverkrusteten Anhänger zu Gan\'rul Bloodeye in Orgrimmar.‡오그리마에 있는 간룰 블러드아이에게 진흙투성이 목걸이를 가져가야 합니다.‡Lleva el colgante sucio a Gan\'rul Ojo sangriento a Orgrimmar.‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Rapporter le Pendentif de poussière à Gan\'rul Bloodeye à Orgrimmar.‡把沾满泥土的坠饰带给奥格瑞玛的甘鲁尔·血眼。‡把沾滿泥土的墜飾帶給奧格瑞瑪的甘魯爾·血眼。',
  }
},
[1513] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Com o Pingente de Dogran, evoque e subjugue uma Súcubo; depois, devolva o Pingente de Dogran a Gan\'rul Olho de Sangue, em Orgrimmar.‡Призовите и подчините суккуба с помощью подвески Дограна. Вернуть подвеску Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mit Hilfe von Dograns Anhänger einen Sukkubus, unterwerft ihn und bringt dann Dograns Anhänger zu Gan\'rul Bloodeye in Orgrimmar zurück.‡도그란의 목걸이를 사용해 서큐버스를 소환하여 처치한 다음 오그리마에 있는 간룰 블러드아이에게 도그란의 목걸이를 가지고 돌아가십시오.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser le Pendentif de Dogran pour invoquer et soumettre une succube, puis rapporter le Pendentif de Dogran à Gan\'rul Bloodeye, à Orgrimmar.‡召唤并征服一只魅魔，然后将多格兰的坠饰还给奥格瑞玛的甘鲁尔·血眼。‡召喚並征服壹只魅魔，然後將多格蘭的墜飾還給奧格瑞瑪的甘魯爾·血眼。',
  }
},
[1514] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    nil,
  }
},
[1515] = {
  {
    'O cativeiro de Dogran‡Догран в плену‡Dograns Gefangenschaft‡포로가 된 도그란‡El cautiverio de Dogran‡El cautiverio de Dogran‡La captivité de Dogran‡多格兰之囚‡多格蘭之囚',
    nil,
    'Leve o Trago do Ken\'zigla para Dogran nos Sertões.‡Отнесите зелье Кен\'зиглы Дограну в Степях.‡Bringt Ken\'ziglas Trunk zu Dogran im Brachland.‡불모의 땅에 있는 도그란에게 켄지글라의 술을 가져가야 합니다.‡Lleva la poción de Ken\'zigla a Dogran a Los Baldíos.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Apporter le Breuvage de Ken\'zigla à Dogran dans les Tarides.‡把肯兹格拉的伤药带给贫瘠之地的多格兰。‡把肯茲格拉的傷藥帶給貧瘠之地的多格蘭。',
  }
},
[1516] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Clamor de Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡大地的召喚',
    nil,
    'Leve 2 Cascos de Espreitador Vil para Ranago Arauto da Terra no Vale das Provações.‡Принесите Канаге заклинателю земли 2 копыта ловцов Скверны.‡Bringt 2 Teufelspirscherhufe zu Canaga Earthcaller im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 하급 지옥사냥개 발굽 2개를 가져가야 합니다.‡Lleva 2 pezuñas de acechador vil a Clamor de Tierra Canaga en el Valle de los Retos.‡Lleva 2 pezuñas de acechador vil a Canaga Clamatierras en el Valle de los Retos.‡Apporter 2 Sabots de traqueur corrompu à Canaga Earthcaller dans la Vallée des épreuves.‡给试炼谷的坎纳甘·地鸣带去2只地狱捕猎者的蹄子。‡給試煉谷的坎納甘·地鳴帶去2只地獄捕獵者的蹄子。',
  }
},
[1517] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Clamor de Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡大地的召喚',
    nil,
    'Encontre a Rocha dos Espíritos e beba o Sapta da Terra.‡Найдите Священный Камень и выпейте рядом с ним сапту Земли.‡Sucht den Geisterfelsen und trinkt das Erdsapta.‡정기 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Trouver le Rocher des esprits et boire le Sapta de terre.‡找到灵魂石地，在那里喝下大地灵契。‡找到靈魂石地，在那裏喝下大地靈契。',
  }
},
[1518] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Clamor de Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡大地的召喚',
    nil,
    'Leve o Quartzo Grosseiro para Ranago Arauto da Terra no Vale das Provações.‡Отнесите необработанный кварц Канаге заклинателю земли в долину Испытаний.‡Bringt den Rohquarz zu Canaga Earthcaller im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 천연 석영을 가져가야 합니다.‡Lleva el Cuarzo en bruto a Clamor de Tierra Canaga en el Valle de los Retos.‡Lleva el cuarzo en bruto a Canaga Clamatierras en el Valle de los Retos.‡Apporter le Quartz brut à Canaga Earthcaller dans la Vallée des épreuves.‡把粗石英交给试炼谷的坎纳甘·地鸣。‡把粗石英交給試煉谷的坎納甘·地鳴。',
  }
},
[1519] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡La llamada de la tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡大地的召喚',
    nil,
    'Leve 2 aplicações de Unguento de Ritual à Vidente Pena do Corvo na Aldeia Narache.‡Принесите 2 порции ритуальной мази провидице Воронье Перо в Лагерь Нараче.‡Bringt 2 Dosen Ritualsalbe zu der Seherin Ravenfeather im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 의식의 물약 2개를 가져가야 합니다.‡LLeva 2 dosis de bálsamo ritual a la profetisa Plumacuervo al Campamento Narache.‡Lleva 2 dosis de bálsamo ritual a la vidente Pluma de Cuervo al Campamento Narache.‡Apporter 2 Applications de Baume rituel au Prophète Ravenfeather au Camp Narache.‡给纳拉其营地的鸦羽先知带回2份仪式药膏。‡給納拉其營地的鴉羽先知帶回2份儀式藥膏。',
  }
},
[1520] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡La llamada de la tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡大地的召喚',
    nil,
    'Encontre a Rocha dos Kodos e beba o Sapta da Terra.‡Найдите Дольмен Кодо и выпейте сапту земли.‡Sucht den Kodofels und trinkt das Erdsapta.‡코도 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Trouver le Rocher des kodos et boire le Sapta de terre.‡找到科多石并喝下大地灵契。‡找到科多石並喝下大地靈契。',
  }
},
[1521] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡La llamada de la tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡大地的召喚',
    nil,
    'Leve o Quartzo Grosseiro à Vidente Pena do Corvo na Aldeia Narache.‡Отнесите грубый кварц провидице Воронье Перо в Лагерь Нараче.‡Bringt den Rohquarz zu der Seherin Ravenfeather im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 천연 석영을 가져가야 합니다.‡Lleva el cuarzo en bruto a la profetisa Plumacuervo al Campamento Narache.‡Lleva el cuarzo en bruto a la vidente Pluma de Cuervo al Campamento Narache.‡Apporter le Quartz brut à la prophétesse Ravenfeather au Camp Narache.‡将粗石英带给纳拉其营地的鸦羽先知。‡將粗石英帶給納拉其營地的鴉羽先知。',
  }
},
[1522] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1523] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1524] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Leve a Tocha da Chama Latente para Telf Joolam em Durotar.‡Отнесите факел Дремлющего Пламени Телфу Джуламу в Дуротаре.‡Bringt die Fackel der schlafenden Flamme zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 희미한 불씨의 횃불을 가져가야 합니다.‡Lleva la antorcha de la Llama Latente a Telf Joolam a Durotar.‡Lleva la antorcha de la Llama Latente a Telf Joolam a Durotar.‡Apporter la Torche de la flamme dormante à Telf Joolam en Durotar.‡把眠炎火炬带给杜隆塔尔的泰尔夫·祖拉姆。‡把眠炎火炬帶給杜隆塔爾的泰爾夫·祖拉姆。',
  }
},
[1525] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Traga 1 Piche Ígneo e 1 Bornal de Reagentes para Telf Joolam em Durotar.‡Принесите 1 порцию огненной смолы и 1 мешочек с реагентами Телфу Джуламу в Дуротаре.‡Bringt 1 Feuerteerstück und 1 Reagenzienbeutel zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 불붙인 타르 1개와 시약 주머니 1개를 가져가야 합니다.‡Lleva 1 alquitrán y 1 bolsa de componentes a Telf Joolam a Durotar.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Apporter 1 Goudron de feu et 1 Bourse de réactifs à Telf Joolam en Durotar.‡找到1个火焰焦油和1个试剂袋，把它们交给杜隆塔尔的泰尔夫·祖拉姆。‡找到1個火焰焦油和1個試劑袋，把它們交給杜隆塔爾的泰爾夫·祖拉姆。',
  }
},
[1526] = {
  {
    'Clamor do fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Derrote a Manifestação Menor do Fogo e coloque a Brasa Faiscante no braseiro do Altar da Chama Eterna.‡Сразитесь с низшим воплощением огня и поместите светящийся уголек в жаровню в святилище Неугасимого Пламени.‡Besiegt die geringe Feuermanifestation und legt Glut in die Kohlenpfanne auf dem Schrein der ewigen Flamme.‡하급 불의 현신을 물리친 다음 희미한 불꽃의 화로에 타오르는 불꽃을 넣어야 합니다.‡Derrota a la Manifestación de fuego menor y coloca las ascuas ardientes sobre el altar de la llama eterna.‡Derrota a la Manifestación de fuego menor y coloca las ascuas ardientes sobre el altar de la llama eterna.‡Vaincre la Manifestation de feu mineure, et placer sa Braise rougeoyante dans le brasero, en haut de l\'Autel de la flamme éternelle.‡击败火焰之魂，将余烬放在恒焰圣殿屋顶的火盆里。‡擊敗火焰之魂，將余燼放在恒焰聖殿屋頂的火盆裏。',
  }
},
[1527] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Leve a Tocha da Chama Eterna a Kranal Fiss nos Sertões.‡Принесите факел Неугасимого Пламени Краналу Фиссу в Степи.‡Bringt die Fackel der ewigen Flamme zu Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스에게 영원한 불꽃의 횃불을 가져가야 합니다.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Apporter la Torche de la flamme éternelle à Kranal Fiss dans les Tarides.‡将恒焰火炬交给贫瘠之地的卡纳尔·菲斯。‡將恒焰火炬交給貧瘠之地的卡納爾·菲斯。',
  }
},
[1528] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Waterseer im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Waterseer dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1529] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Waterseer im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Waterseer dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1530] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Salma nos Sertões Meridionais.‡Отыщите Брин в южной части Степей.‡Sucht Brine im südlichen Brachland.‡불모의 땅 남쪽에 있는 브린을 찾아야 합니다.‡Encuentra a Salmuera en los Baldíos del Sur.‡Encuentra a Salmuera en los Baldíos del Sur.‡Trouver Brine dans les Tarides du sud.‡到南贫瘠之地去找到布瑞恩。‡到南貧瘠之地去找到布瑞恩。',
  }
},
[1531] = {
  {
    'Clamor do ar‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡空氣的召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Cloudseer in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Cloudseer aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·白雲。',
  }
},
[1532] = {
  {
    'Clamor do ar‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡空氣的召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Cloudseer in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Nubeprofeta en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Cloudseer aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·白雲。',
  }
},
[1534] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Azul Vazio nas Ruínas de Poeira Estelar, que fica no Vale Gris, e devolva-o para Salma nos Sertões.‡Наполните пустой синий бурдюк для воды в руинах Звездной Пыли и отнесите воду Брин из Степей.‡Füllt den leeren blauen Wasserschlauch bei den Sternenstaubruinen in Ashenvale und kehrt zu Brine im Brachland zurück.‡잿빛 골짜기에 있는 별가루의 폐허에서 빈 파란색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre bleue vide aux Ruines de Chimétoile à Ashenvale et la rapporter à Brine dans les Tarides.‡到灰谷的星辰废墟去，将空的蓝色水囊盛满泉水，然后把它交给贫瘠之地的布瑞恩。‡到灰谷的星辰廢墟去，將空的藍色水囊盛滿泉水，然後把它交給貧瘠之地的布瑞恩。',
  }
},
[1535] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Marrom Vazio no laguinho abaixo da cabana de Salma e leve para ela nos Sertões.‡Наполните пустой коричневый бурдюк для воды в источнике ниже хижины Брин и отнесите ей воду.‡Füllt den leeren braunen Wasserschlauch im Wasserloch unterhalb von Brines Hütte und kehrt damit zu Brine im Brachland zurück.‡브린의 거처 아래에 있는 물 구멍으로 가서 빈 갈색 물주머니에 물을 채우십시오. 그런 다음 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena la bota de agua marrón vacía en el surtidor que está debajo de la cabaña de Salmuera y llévasela a Los Baldíos.‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Remplir l\'Outre marron vide au trou d’eau, derrière la hutte de Brine, puis rapportez-lui la, dans les Tarides.‡到野猪人的水池去，用井中的水装满空的棕色水囊，然后把水囊交给贫瘠之地的布瑞恩。‡到野豬人的水池去，用井中的水裝滿空的棕色水囊，然後把水囊交給貧瘠之地的布瑞恩。',
  }
},
[1536] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Vermelho Vazio no poço da Serraria Tarren e entregue-o para Salma nos Sertões.‡Наполните пустой красный бурдюк для воды в Мельнице Таррен и отнесите воду Брин в Степи.‡Füllt den leeren roten Wasserschlauch am Brunnen in Tarrens Mühle und kehrt zu Brine im Brachland zurück.‡타렌 밀농장에 있는 우물에서 빈 빨간색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena la bota de agua roja vacía en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre rouge vide au puits de Moulin-de-Tarren et retourner voir Brine dans les Tarides.‡用塔伦米尔的井水装满空的红色水囊，然后把它交给贫瘠之地的布瑞恩。‡用塔倫米爾的井水裝滿空的紅色水囊，然後把它交給貧瘠之地的布瑞恩。',
  }
},
[1558] = {
  {
    'O Dique Lapidado‡Каменная дамба‡Der Stonewroughtdamm‡돌다지 댐‡Presa de las Tres Cabezas‡Presa de las Tres Cabezas‡Le barrage de Formepierre‡巨石水坝‡巨石水壩',
    nil,
    'Leve o órfão ao Dique Lapidado em Loch Modan. Vá com ele até o meio do dique para que ele possa ver por cima da cachoeira.‡Отведите сироту к Каменной дамбе у озера Лок Модан. Пусть постоит в центре дамбы и полюбуется огромным водопадом.‡Begleitet Euren Schützling zum Stonewroughtdamm in Loch Modan. Geht mit ihm zur Mitte des Damms, damit er auf den riesigen Wasserfall heruntersehen kann.‡랜디스를 모단 호수에 있는 돌다지 댐에 데려다 줘야 합니다. 거대한 폭포를 볼 수 있도록 댐 중간까지 데려다 주십시오.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Conduire l\'orphelin au barrage de Formepierre au Loch Modan. Vous devez le conduire au milieu du barrage pour qu\'il puisse voir par-dessus l\'immense chute d\'eau.‡带着你看护的孤儿去洛克莫丹的巨石水坝。你应该带他去水坝的中间，然后让他俯瞰巨大的瀑布。‡帶著你看護的孤兒去洛克莫丹的巨石水壩。你應該帶他去水壩的中間，然後讓他俯瞰巨大的瀑布。',
  }
},
[1559] = {
  {
    'Receita de bomba de clarão‡Секрет изготовления световой бомбы‡Blitzstrahlbombenanleitung‡섬광탄 제조법‡Receta de bomba cegadora‡Receta de bomba cegadora‡La recette de la bombe éclairante‡闪光弹的制法‡閃光彈的制法',
    nil,
    nil,
  }
},
[1560] = {
  {
    'A missão de Tuga‡Задание Тооги‡Toogas Bitte‡길 잃은 투가‡La misión de Tooga‡La misión de Tooga‡La quête de Tooga‡图加的任务‡圖加的任務',
    nil,
    'Leve Tuga até a mulher dele, Tarta.‡Сопроводите Тоогу к его жене, Торте.‡Zeigt Tooga den Weg zurück zu seiner Frau Torta.‡투가를 아내 토르타에게 데려다 주어야 합니다.‡Muéstrale a Tooga el camino de vuelta con su esposa, Torta.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Montrer à Tooga le chemin du retour vers sa femme, Torta.‡把图加带回到他的妻子托尔塔身边。‡把圖加帶回到他的妻子托爾塔身邊。',
  }
},
[1578] = {
  {
    'Suprimentos para o front‡Помощь фронту‡Nachschub für die Front‡전방 보급품 조달‡Abastecer al frente‡Abastecer al frente‡Rééquiper le front‡前线的补给‡前線的補給',
    nil,
    'Entregue 6 Machados de Cobre e 6 Cintos Encadeados de Cobre para Thorvald, na torre de vigia sul de Loch Modan‡Отнесите 6 медных топоров и 6 медных плетеных поясов Торвальду в южную сторожевую башню озера Лок Модан.‡Bringt 6 Kupferäxte und 6 Kupferne Kettengürtel zu Thorvald im südlichen Wachturm des Loch Modan.‡모단 호수 남쪽 방어탑에 있는 토발트에게 가서 구리 도끼 6개와 구리 사슬 허리띠 6개를 주어야 합니다.‡Lleva 6 hachas y 6 cinturones de malla de cobre a Thorvald a la torre de vigilancia sur de Loch Modan‡Llévale 6 hachas de cobre y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Apporter 6 Haches en cuivre et 6 Ceintures en anneaux de cuivre à Thorvald dans la Tour de garde méridionale du Loch Modan.‡给洛克莫丹南部警戒塔的索瓦尔德带去6把铜斧和6条铜质链甲腰带。‡給洛克莫丹南部警戒塔的索瓦爾德帶去6把銅斧和6條銅質鏈甲腰帶。',
  }
},
[1579] = {
  {
    'Deschanfradores‡Суперразъемы‡Klemm-Muffen‡개퍼 잭‡Mecanismos eléctricos‡Mecanismos eléctricos‡Rouages électriques‡小齿轮‡小齒輪',
    nil,
    'Entregue 8 Deschanfradores para Xafetim Manigiro em Auberdine.‡Принесите Бацбаху Кривошипу в Аубердин 8 суперразъемов.‡Bringt 8 Klemm-Muffen zu Wizbang Cranktoggle in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 개퍼 잭 8개를 가져가야 합니다.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Apporter 8 Rouages électriques à Wizbang Cranktoggle à Auberdine.‡收集8个小齿轮，把它们交给奥伯丁的维兹班恩·曲针。‡收集8個小齒輪，把它們交給奧伯丁的維茲班恩·曲針。',
  }
},
[1580] = {
  {
    'Eletromolas‡Электропеллеры‡Elektropeller‡전력추진기‡Los electromuelles‡Los electromuelles‡Pêche aux Electropellers‡导电器‡導電器',
    nil,
    'Entregue 12 Eletromolas para o Xafetim Manigiro em Auberdine.‡Принесите 12 электропеллеров Бацбаху Кривошипу в Аубердин.‡Bringt 12 Elektropeller zu Wizbang Cranktoggle in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 전력추진기 12개를 가져가야 합니다.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Apporter 12 Electropellers à Wizbang Cranktoggle à Auberdine.‡收集12个导电器，把它们交给奥伯丁的维兹班恩·曲针。‡收集12個導電器，把它們交給奧伯丁的維茲班恩·曲針。',
  }
},
[1581] = {
  {
    'Elixires para os Folhâminas‡Эликсиры для клана Режущего Листа‡Elixiere für die Bladeleafs‡블레이드리프를 위한 비약‡Elixires para Filohoja‡Elixires para Filohoja‡Les élixirs pour les Bladeleaf‡刃叶的药剂‡刃葉的藥劑',
    nil,
    'Traga 6 Elixires de Força de Leão e 2 Elixires de Defesa Menor para Syral Folhâmina, em Dolanaar.‡Доставьте 6 эликсиров Львиной силы и 2 слабых эликсира защиты Сирел Остролист в Доланаар.‡Bringt 6 Elixiere Löwenkraft und 2 Elixiere der schwachen Verteidigung zu Syral Bladeleaf in Dolanaar.‡돌라나르에 있는 시랄 블레이드리프에게 사자의 힘 비약 6개와 최하급 방어의 비약 2개를 가져가야 합니다.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Apporter 6 Elixirs de force du lion et 2 Elixirs de défense mineure à Syral Bladeleaf à Dolanaar.‡给在多兰纳尔的塞拉尔·刃叶带去6瓶狮王之力药剂和2瓶初级防御药剂。‡給在多蘭納爾的塞拉爾·刃葉帶去6瓶獅王之力藥劑和2瓶初級防禦藥劑。',
  }
},
[1582] = {
  {
    'O colete brilho da lua‡Жилет Лунного сияния‡Mondscheinweste‡달빛 조끼‡El jubón de brillo lunar‡El jubón resplandor lunar‡Veste de Moonglow‡月光外衣‡月光外衣',
    nil,
    'Leve 1 par de Luvas de Couro com Relevo, 5 pares de Botas de Couro com Relevo e 5 Mantos de Couro com Relevo para Lotherias em Darnassus.‡Принесите 1 пару тисненых кожаных перчаток, 5 пар тисненых кожаных сапог и 5 тисненых кожаных плащей Лотериас в Дарнасс.‡Bringt 1 geprägten Lederhandschuh, 5 geprägte Lederstiefel und 5 geprägte Lederumhänge zu Lotherias in Darnassus.‡다르나서스에 있는 로서리아스에게 새김무늬 가죽 장갑 1개, 새김무늬 가죽 장화 5개, 새김무늬 가죽 망토 5개를 가져가야 합니다.‡Lleva 1 guante de cuero estampado, 5 botas de cuero estampado y 5 capas de cuero estampado a Lotherias a Darnassus.‡Trae 1 par de guantes de cuero estampados, 5 botas de cuero estampadas y 5 capas de cuero estampadas para Lotherias en Darnassus.‡Apporter 1 Gant en cuir estampé, 5 Bottes en cuir estampé et 5 Capes en cuir estampé à Lotherias à Darnassus.‡把1双雕花皮手套、5双雕花皮靴和5件雕花皮质披风交给达纳苏斯的洛瑟里亚斯。‡把1雙雕花皮手套、5雙雕花皮靴和5件雕花皮質披風交給達納蘇斯的洛瑟裏亞斯。',
  }
},
[1598] = {
  {
    'Ladrão que rouba ladrão...‡Украденная книга‡Der gestohlene Foliant‡도난 당한 책‡El libro robado‡El libro robado‡Le Tome dérobé‡失窃的典籍‡失竊的典籍',
    nil,
    'Tome Poderes do Caos para Drusilla La Salle.‡Принесите книгу "Силы Бездны" Друзилле ла Салле.‡Holt "Die Macht der Leere" für Drusilla La Salle zurück.‡드루실라 라 살르를 위해 공허의 힘을 찾아 와야 합니다.‡LLeva los Poderes del vacío a Drusilla La Salle.‡Lleva los Poderes del Vacío a Drusilla La Salle.‡Retrouver la Puissance du Vide pour Drusilla La Salle.‡为杜希拉·拉萨雷找回《虚空灵能》。‡為杜希拉·拉薩雷找回《虛空靈能》。',
  }
},
[1599] = {
  {
    'Primeiros passos‡В начале славных дел‡Anfänge‡시작‡Novato‡Novato‡Les débuts‡开端‡開端',
    nil,
    'Leve 3 Patuás de Penas para Alamar Carranca em Sidermar.‡Добудьте 3 оберега из перьев и отнесите их Аламару Мрачнну в Старую Наковальню.‡Bringt 3 Federglücksbringer zu Alamar Grimm in Anvilmar.‡앤빌마에 있는 알라마 그림에게 깃털 부적 3개를 가져가야 합니다.‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Apporter 3 Charmes de plume à Alamar Grimm à Anvilmar.‡给安威玛尔的阿拉玛尔·格里姆带回3个羽毛咒符。‡給安威瑪爾的阿拉瑪爾·格裏姆帶回3個羽毛咒符。',
  }
},
[1618] = {
  {
    'Armamentos para Cristarrubra‡Экипирование Красногорья‡Die Aufrüstung im Rotkammgebirge‡붉은마루산맥 무기 조달‡Equipar a los Crestagrana‡Equipar Crestagrana‡Le rééquipement des Carmines‡赤脊山的补给‡赤脊山的補給',
    nil,
    'Tormus Baixaforja quer que você dê 4 Cintos Rúnicos de Cobre e 4 Malhos Pesados de Cobre para Vervo Obom, em Cristarrubra.‡Отнесите 4 рунных медных пояса и 4 тяжелых медных кувалды Вернеру Осгуду в Красногорье.‡Tormus Deepforge möchte, dass Ihr 4 runenverzierte Kupfergürtel und 4 schwere Kupferschlägel zu Verner Osgood ins Rotkammgebirge bringt.‡토르무스 딥포지가 붉은마루 산맥에 있는 베르너 오스구드에게 구리 룬문자 허리띠 4개와 무거운 구리 마울 4개를 가져다 달라고 부탁했습니다.‡Tormus Forjahonda quiere que le lleves 4 cinturones de cobre con runas y 4 almádenas pesadas de cobre a Verner Osgood a Crestagrana.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 grandes mazas de cobre pesadas a Verner Osbien, en Crestagrana.‡Tormus Deepforge veut que vous apportiez 4 Ceintures runiques en cuivre et 4 Grands maillets en cuivre à Verner Osgood, dans les Carmines.‡托姆斯·深炉要你给赤脊山的弗纳·奥斯古带去4条铜质符文腰带和4把铜质大锤。‡托姆斯·深爐要妳給赤脊山的弗納·奧斯古帶去4條銅質符文腰帶和4把銅質大錘。',
  }
},
[1638] = {
  {
    'Treinamento de guerreiro‡Обучение воина‡Die Ausbildung eines Kriegers‡전사 훈련‡Instrucción de guerrero‡Instrucción de guerrero‡L\'entraînement du guerrier‡战士的训练‡戰士的訓練',
    nil,
    'Fale com Ari Barbotina.‡Поговорите с Гарри Берлгардом.‡Sprecht mit Harry Burlguard.‡해리 벌가드와 대화하십시오.‡Habla con Harry Burlguard.‡Habla con Harry Burlguard en Ventormenta.‡Parler à Harry Burlguard.‡和哈里·伯加德谈一谈。‡和哈裏·伯加德談壹談。',
  }
},
[1639] = {
  {
    'Bartolino, o bebum‡Бартлби Пьянь‡Bartleby der Trunkenbold‡주정뱅이 바틀비‡Bartleby, el borracho‡Bartleby, el borracho‡Bartleby le poivrot‡醉鬼巴特莱比‡醉鬼巴特萊比',
    nil,
    'Fale com Bartolino.‡Поговорите с Бартлби.‡Sprecht mit Bartleby.‡바틀비와 대화하십시오.‡Habla con Bartleby.‡Habla con Bartleby.‡Parler à Bartleby.‡和巴特莱比谈一谈。‡和巴特萊比談壹談。',
  }
},
[1640] = {
  {
    'Que surra, Bartolino!‡Побить Бартлби‡Besiegt Bartleby‡바틀비와의 대결‡Vence a Bartleby‡Vence a Bartleby‡Battre Bartleby‡击败巴特莱比‡擊敗巴特萊比',
    nil,
    'Vença o Bartolino e converse com ele.‡Побейте Бартлби и снова поговорите с ним.‡Besiegt Bartleby und redet dann mit ihm.‡바틀비와 싸워 이긴 후 그와 대화하십시오.‡Golpea a Bartleby y habla con él.‡Golpea a Bartleby y habla con él.‡Battre Bartleby, puis lui parler.‡打败巴特莱比，然后再和他谈一谈。‡打敗巴特萊比，然後再和他談壹談。',
  }
},
[1641] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡El Libro de la Divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    nil,
  }
},
[1642] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡El Libro de la Divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[1643] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Procure Stephanie Turner no Distrito Comercial de Ventobravo.‡Обыщите Торговый квартал и найдите Стефани Тернер.‡Sucht im Handelsdistrikt von Stormwind nach Stephanie Turner.‡스톰윈드의 상업 지구에서 스테파니 터너를 찾아야 합니다.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Chercher Stephanie Turner dans le Quartier commerçant de Stormwind.‡在暴风城的贸易区找到斯蒂芬妮·特纳。‡在暴風城的貿易區找到斯蒂芬妮·特納。',
  }
},
[1644] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve 10 pedaços de Linho para Stephanie Turner em Ventobravo.‡Принесите 10 отрезов льна в Штормград и отдайте Стефани Тернер.‡Bringt 10 Stück Leinenstoff zu Stephanie Turner in Stormwind.‡스톰윈드에 있는 스테파니 터너에게 리넨 옷감 10개를 가져가야 합니다.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Apporter 10 morceaux d\'étoffe de lin à Stephanie Turner à Stormwind.‡给暴风城的斯蒂芬妮·特纳收集10块亚麻布。‡給暴風城的斯蒂芬妮·特納收集10塊亞麻布。',
  }
},
[1645] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡El Libro de la Divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    nil,
  }
},
[1646] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Battleforge in Ironforge.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Battleforge à Ironforge.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談壹談。',
  }
},
[1647] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Vasculhe o anel externo de Altaforja para João Turner.‡Найдите во внешнем круге Стальгорна Джона Тернера.‡Sucht im äußeren Ring von Ironforge nach John Turner.‡아이언포지의 외곽 지역에 있는 존 터너를 찾아야 합니다.‡Busca a John Turner en el anillo exterior de Forjaz.‡Busca a John Turner en el anillo exterior de Forjaz.‡Chercher John Turner à la périphérie d\'Ironforge.‡在铁炉堡的外环区域找到约翰·特纳。‡在鐵爐堡的外環區域找到約翰·特納。',
  }
},
[1648] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve 10 peças de Linho para João Turner em Altaforja.‡Принесите 10 отрезов льняной ткани Джону Тернеру в Стальгорн.‡Bringt 10 Stück Leinenstoff zu John Turner in Ironforge.‡아이언포지에 있는 존 터너에게 리넨 옷감 10개를 가져가 기부해야 합니다.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Apporter 10 morceaux d\'étoffe de lin à John Turner à Ironforge.‡收集10块亚麻布，把它们交给铁炉堡的约翰·特纳。‡收集10塊亞麻布，把它們交給鐵爐堡的約翰·特納。',
  }
},
[1649] = {
  {
    'Tomo da Bravura‡Фолиант Отваги‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[1650] = {
  {
    'Tomo da Bravura‡Фолиант Отваги‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Encontre Dafne Calmafonte no Cerro Oeste.‡Найдите Дафну Стилвелл в Западном Крае.‡Sucht Daphne Stilwell in Westfall.‡서부 몰락지대에 있는 대프니 스틸웰을 찾아야 합니다.‡Encuentra a Daphne Fontana en Páramos del Poniente.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Trouver Daphne Stilwell dans la marche de l\'Ouest‡在西部荒野找到达芙妮·斯迪威尔。‡在西部荒野找到達芙妮·斯迪威爾。',
  }
},
[1651] = {
  {
    'Tomo da Bravura‡Фолиант Отваги‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Proteja Dafne Calmafonte do ataque dos Défias.|nPara obter êxito, seus espíritos não podem ser despidos do lodo mortal.|nQuando você conseguir, fale novamente com Dafne Calmafonte.‡Защитите Дафну Стилвелл от нападения Братства Справедливости. Проследите, чтобы ни ее, ни ваша душа в случае смерти не покинули свои тела, иначе испытание не будет засчитано.|nПосле победы поговорите с Дафной Стилвелл.‡Verteidigt Daphne Stilwell vor dem Angriff der Defias.|nKeiner Eurer Geister darf aus seinen irdischen Fesseln befreit werden, wenn Ihr erfolgreich sein wollt.|nSprecht erneut mit Daphne Stilwell, wenn Ihr erfolgreich wart.‡데피아즈단의 공격으로부터 대프니 스틸웰을 보호하십시오.|n둘 중 하나라도 죽으면 실패하게 됩니다.|n성공한 후에 대프니 스틸웰과 다시 대화해야 합니다.‡Defiende a Daphne Fontana del ataque de los Defias.|nSi quieres tener éxito, vuestros espíritus no pueden salir de sus espirales mortales.|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Defiende a Daphne Fontana del ataque de los Defias.|nSi quieres tener éxito, sus espíritus no pueden salir de sus espirales mortales.|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Défendez Daphne Stilwell contre les attaques des Défias.|nAucun de vous deux ne doit mourir, si vous voulez réussir la quête.|nQuand vous aurez réussi, reparlez à Daphne Stilwell.‡在迪菲亚兄弟会进攻时保护达芙妮·斯迪威尔的安全。|n如果你想成功的话，你和达芙妮都不能死在他们的剑下。‡在迪菲亞兄弟會進攻時保護達芙妮·斯迪威爾的安全。|n如果妳想成功的話，妳和達芙妮都不能死在他們的劍下。',
  }
},
[1652] = {
  {
    'Tomo da Bravura‡Фолиант Отваги‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[1653] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Fale com Jardel Calmafonte em Altaforja.‡Поговорите с Джорданом Стилвеллом в Стальгорне.‡Sprecht mit Jordan Stilwell in Ironforge.‡아이언포지에 있는 조던 스틸웰과 대화해야 합니다.‡Habla con Jordan Fontana en Forjaz.‡Habla con Jordan Fontana en Forjaz.‡Parler à Jordan Stilwell à Ironforge‡去和铁炉堡的乔丹·斯迪威尔谈一谈。‡去和鐵爐堡的喬丹·斯迪威爾談壹談。',
  }
},
[1654] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Usando as Anotações do Jardel sobre Armas, encontre Madeira de Carvalho de Pedralva, o Carregamento de Minério Refinado do Bailor, o Martelo de Ferreiro de Jardel e uma Gema Kor. Depois, entregue tudo a Jardel Calmafonte em Altaforja.‡Возьмите список Джордана, добудьте немного древесины белокаменного дуба, партию очищенной руды Бэйлора, кузнечный молот Джордана и самоцвет Кора и отдайте их Джордану Стилвеллу в Стальгорне.‡Sucht mit Jordans Waffennotizen etwas Weißsteineichenholz, Bailors aufbereitete Erzlieferung, Jordans Schmiedehammer und einen Kor-Edelstein und bringt alles zusammen zu Jordan Stilwell in Ironforge.‡조던의 쪽지를 참고해 흰돌참나무 재목, 조던의 제련된 광석 상자, 조던의 대장장이 망치, 그리고 코르석을 찾아 아이언포지에 있는 조던 스틸웰에게 가져가야 합니다.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siquiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siguiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Utiliser les Notes sur les armes de Jordan, trouver du Bois de chêne de blanchepierre, la Cargaison de Minerai raffiné de Bailor, le Marteau de forge de Jordan et une Gemme de Kor, puis revenir voir Jordan Stilwell à Ironforge.‡按照乔丹的武器材料单上的说明去寻找一些白石橡木、精炼矿石、乔丹的铁锤和一块科尔宝石，然后回到铁炉堡去见乔丹·斯迪威尔。‡按照喬丹的武器材料單上的說明去尋找壹些白石橡木、精煉礦石、喬丹的鐵錘和壹塊科爾寶石，然後回到鐵爐堡去見喬丹·斯迪威爾。',
  }
},
[1655] = {
  {
    'Carregamento de minério do Bailor‡Партия руды Балора‡Bailors Erzlieferung‡조던의 광석 상자‡Envío de minerales de Bailor‡Envío de mena de Bailor‡Cargaison de minerai de Bailor‡白洛尔的矿石‡白洛爾的礦石',
    nil,
    'Leve o Carregamento de Minério do Jardel até Bailor Manopedra, em Loch Modan.‡Доставьте партию руды для Джордана Балору Крепкоруку к озеру Лок Модан.‡Bringt Jordans Erzlieferung zu Bailor Stonehand am Loch Modan.‡모단 호수에 있는 베일러 스톤핸드에게 조던의 광석 상자를 가져가야 합니다.‡Lleva el envío de Jordan a Bailor Manopétrea a Loch Modan.‡Lleva el envío de Jordan a Bailor Petramano a Loch Modan.‡Apporter la Cargaison de minerai de Jordan à Bailor Stonehand au Loch Modan.‡把乔丹的矿石带给洛克莫丹的白洛尔·石手。‡把喬丹的礦石帶給洛克莫丹的白洛爾·石手。',
  }
},
[1656] = {
  {
    'Serviço pela metade‡Незаконченное задание‡Eine unvollendete Aufgabe‡완수하지 못한 임무‡Una tarea por terminar‡Una tarea por terminar‡Une tâche inachevée‡未完的任务‡未完的任務',
    nil,
    'Leve a Trouxa de Peles para o Estalajadeiro Kauth na Aldeia Casco Sangrento.‡Отнесите сверток мехов хозяину таверны Кауту в Деревню Кровавого Копыта.‡Bringt das Bündel Felle zu Gastwirt Kauth in Bloodhoof.‡블러드후프 마을에 있는 여관주인 카우스에게 모피 묶음을 가져가야 합니다.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Livrer le Ballot de fourrures à l\'aubergiste Kauth au village Bloodhoof.‡将一捆毛皮带给血蹄村的旅店老板考乌斯。‡將壹捆毛皮帶給血蹄村的旅店老板考烏斯。',
  }
},
[1657] = {
  {
    'Fedor na Costa Sul‡Чем пахнет в Южнобережье‡Die Verpestung von Southshore‡사우스쇼어에 구린내 폭탄 투하‡Apesta Costasur‡Apesta Costasur‡Empuantir Southshore‡臭气熏天的南海镇‡臭氣熏天的南海鎮',
    nil,
    'Atire três Bombas Fedidas dos Renegados no coração da Costa Sul, em Eira dos Montes, e fale novamente com a Invoca-trevas Yanka no Festival do Homem de Palha, nas Clareiras de Tirisfal.‡Бросить три бомбы-вонючки Отрекшихся в центр Южнобережья в Хилсбраде и вернитесь к Янке Зовущей Тьму на фестиваль Плетеного человека на Тирисфальских лугах.‡Werft drei Stinkbomben der Verlassenen ins Herz von Southshore in Hillsbrad und kehrt zu Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡힐스브래드에 있는 사우스쇼어 한가운데에 3개의 포세이큰 구린내 폭탄을 던진 후, 티리스팔 숲의 밀짚인형 축제가 열리는 곳에 있는 암흑의 소환사 얀카에게 돌아가야 합니다.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a Llamasombra Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lancer trois Boules puantes des Réprouvés au milieu de Southshore en Hillsbrad, puis revenez voir la sombre imploratrice Yanka à la Fête de l’homme d’osier, aux Clairières de Tirisfal.‡将三颗亡灵臭气弹放置在希尔斯布莱德丘陵的南海镇中心，完成任务之后回到提瑞斯法林地的黑暗召唤者雅恩卡那里。‡將三顆亡靈臭氣彈放置在希爾斯布萊德丘陵的南海鎮中心，完成任務之後回到提瑞斯法林地的黑暗召喚者雅恩卡那裏。',
  }
},
[1658] = {
  {
    'Penetra no Festival do Homem de Palha‡Сорвать праздник Плетеного человека‡Bespitzelt das Fest des Weidenmanns‡밀짚인형 축제 정탐‡Controlar el Festival del Hombre de Mimbre‡Arruinar el Festival del Hombre de Mimbre‡Un intrus à la Fête de l\'homme d\'osier‡稻草人的节日‡稻草人的節日',
    nil,
    'Localize o Festival do Homem de Palha nas Clareiras de Tirisfal. Fale novamente com o Sargento Hartman quando tiver feito isso.‡Отыщите место проведения фестиваля Плетеного человека в Тирисфальских лугах и возвращайтесь в Южнобережье к сержанту Дыгалу.‡Macht das Fest des Weidenmanns der Verlassenen in Tirisfal ausfindig. Kehrt zu Sergeant Hartman in Southshore zurück, sobald Ihr Eure Mission erfüllt habt.‡티리스팔 숲에서 포세이큰의 밀짚인형 축제가 열리고 있는 곳을 찾아 정탐한 후 사우스쇼어에 있는 하사관 허트만에게 돌아가야 합니다.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Allez voir la Fête de l\'homme d\'osier des Réprouvés dans les clairières de Tirisfal. Revenez voir le sergent Hartman à Southshore quand ce sera fait.‡在提瑞斯法林地找到被遗忘者的稻草人节日举办地点。任务完成之后回到南海镇的哈特曼中士那里。‡在提瑞斯法林地找到被遺忘者的稻草人節日舉辦地點。任務完成之後回到南海鎮的哈特曼中士那裏。',
  }
},
[1661] = {
  {
    'O Tomo de Nobreza‡Фолиант Благородства‡Der Foliant des Adels‡고결함의 고서‡Libro de la nobleza‡Escrito sobre nobleza‡Le Tome de noblesse‡高贵之书‡高貴之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall, à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[1665] = {
  {
    'A caneca do Bartolino‡Кружка Бартлби‡Bartlebys Becher‡바틀비의 술잔‡La jarra de Bartleby‡La jarra de Bartleby‡Tasse de Bartleby‡巴特莱比的酒杯‡巴特萊比的酒杯',
    nil,
    'Leve a Caneca do Bartolino para o Barbotina‡Отнесите кружку Бартлби Баргарду.‡Bringt Bartlebys Becher zu Burlguard.‡벌가드에게 바틀비의 술잔을 가져가야 합니다.‡Lleva la jarra de Bartleby a Burlguard.‡Lleva la jarra de Bartleby a Burlguard.‡Apporter la Tasse de Bartleby à Burlguard.‡把巴特莱比的酒杯交给伯加德。‡把巴特萊比的酒杯交給伯加德。',
  }
},
[1666] = {
  {
    'Delegado Fadigas‡Маршал Хаггард‡Marshal Haggard‡치안대장 해거드‡El alguacil Haggard‡El mariscal Haggard‡Le maréchal Haggard‡治安官哈迦德‡治安官哈迦德',
    nil,
    'Fale com o Delegado Fadigas.‡Поговорите с маршалом Хаггардом.‡Sprecht mit Marshal Haggard.‡치안대장 해거드와 대화하십시오.‡Habla con el alguacil Haggard.‡Habla con el mariscal Haggard.‡Parler au maréchal Haggard.‡和治安官哈迦德谈一谈。‡和治安官哈迦德談壹談。',
  }
},
[1667] = {
  {
    'Diogo Dente-podre‡Джек Мертвозуб‡Stumpfzahn Jack‡썩은니 잭‡Jack Dentomuerto‡Jack Dentomuerto‡Jack Dent-Morte‡蛀牙杰克‡蛀牙傑克',
    nil,
    'Recupere o Distintivo do Fadigas que está no acampamento de Diogo Dente-podre e fale novamente com o Delegado Fadigas.‡Добыть знак маршала Хаггарда из лагеря Джека Мертвозуба и вернуться к маршалу Хаггарду.‡Holt Marshal Haggards Abzeichen aus Stumpfzahn Jacks Lager und kehrt zu Marshal Haggard zurück.‡썩은니 잭의 야영지에서 치안대장 헤거드의 휘장을 찾아 치안대장 해거드에게 돌아가십시오.‡Recupera la insignia de Haggar del campamento de Jack Dentomuerto y regresa con el alguacil Haggard.‡Recupera la insignia de Haggar del campamento de Jack Dentomuerto y regresa con el mariscal Haggard.‡Retrouver la Plaque du maréchal Haggard au Camp de Jack Dent-Morte, et la rapporter au maréchal Haggard.‡从蛀牙杰克的营地里取回治安官哈迦德的徽章，把它交给治安官哈迦德。‡從蛀牙傑克的營地裏取回治安官哈迦德的徽章，把它交給治安官哈迦德。',
  }
},
[1678] = {
  {
    'Vejrek‡Веджрек‡Vejrek‡베즈렉‡Vejrek‡Vejrek‡Vejrek‡维吉雷克‡維吉雷克',
    nil,
    'Leve a Cabeça de Vejrek para Muren Lançatroz em Altaforja.‡Принесите голову Веджрека Марену Грозовой Вершине в Стальгорн.‡Bringt Vejreks Kopf zu Muren Stormpike in Ironforge.‡베즈렉을 처치하고 그 증거로 그의 머리카락을 아이언포지에 있는 무렌 스톰파이크에게 가져가야 합니다.‡Lleva la Cabeza de Vejrek\'s a Muren Pico Tormenta en Forjaz.‡Lleva la Cabeza de Vejrek a Muren Pico Tormenta en Forjaz.‡Apporter la Tête de Vejrek à Muren Stormpike à Ironforge.‡将维吉雷克的头颅交给铁炉堡的穆伦·雷矛。‡將維吉雷克的頭顱交給鐵爐堡的穆倫·雷矛。',
  }
},
[1679] = {
  {
    'Muren Lançatroz‡Марен Грозовая Вершина‡Muren Stormpike‡무렌 스톰파이크‡Muren Pico Tormenta‡Muren Pico Tormenta‡Muren Stormpike‡穆伦·雷矛‡穆倫·雷矛',
    nil,
    'Fale com Muren Lançatroz.‡Поговорите с Мареном Грозовой Вершиной.‡Sprecht mit Muren Stormpike.‡무렌 스톰파이크와 대화하십시오.‡Habla con Muren Pico Tormenta.‡Habla con Muren Pico Tormenta.‡Parler à Muren Stormpike.‡和穆伦·雷矛谈一谈。‡和穆倫·雷矛談壹談。',
  }
},
[1680] = {
  {
    'Tormus Baixaforja‡Тормус Подземная Кузня‡Tormus Deepforge‡토르무스 딥포지‡Tormus Forjahonda‡Tormus Forjahonda‡Tormus Deepforge‡托姆斯·深炉‡托姆斯·深爐',
    nil,
    'Fale com Tormus Baixaforja.‡Поговорите с Тормусом Подземной Кузней.‡Sprecht mit Tormus Deepforge.‡토르무스 딥포지와 대화하십시오.‡Habla con Tormus Forjahonda.‡Habla con Tormus Forjahonda.‡Parler à Tormus Deepforge.‡和托姆斯·深炉谈一谈。‡和托姆斯·深爐談壹談。',
  }
},
[1681] = {
  {
    'Complexo do Bandaferro‡Мастерская Сталекрута‡Ironbands Truppenlager‡아이언밴드 야영지‡Complejo Vetaferro‡Complejo Vetaferro‡Base d\'Ironband‡铁环营地‡鐵環營地',
    nil,
    'Leve um pouco de Minério Umbrático para Tormus Baixaforja em Altaforja.‡Принесите мрачную руду Тормусу Подземной Кузне в Стальгорн.‡Bringt eine Ladung Umbralerz zu Tormus Deepforge in Ironforge.‡아이언포지에 있는 토르무스 딥포지에게 움브랄 광석을 가져가야 합니다.‡Lleva una pieza de mineral umbrío a Tormus Forjahonda en Forjaz.‡Lleva una pieza de mena umbría a Tormus Forjahonda en Forjaz.‡Rapporter du Minerai d\'Umbral à Tormus Deepforge à Ironforge.‡把暗影矿石交给铁炉堡的托姆斯·深炉。‡把暗影礦石交給鐵爐堡的托姆斯·深爐。',
  }
},
[1682] = {
  {
    'Armas de ferro cinza‡Оружие из серой стали‡Waffen aus grauem Eisen‡움브랄 광석 무기‡Armas de hierro gris‡Armas de hierro gris‡Armes en fer gris‡灰铁武器‡灰鐵武器',
    nil,
    nil,
  }
},
[1683] = {
  {
    'Vorlus Cascruel‡Ворлус Подлое Копыто‡Vorlus Elendshuf‡볼루스 바일후프‡Vorlus Pezuñavil‡Vorlus Pezuñavil‡Vorlus Vilehoof‡沃鲁斯·邪蹄‡沃魯斯·邪蹄',
    nil,
    'Leve a Trompa de Vorlus para Elanaria em Darnassus.‡Принесите рог Ворлуса Эланарии из Дарнасса.‡Bringt das Horn von Vorlus zu Elanaria in Darnassus.‡다르나서스에 있는 엘라나리아에게 볼루스의 뿔을 가져가야 합니다.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Rapporter la Corne de Vorlus Vilehoof à Elanaria à Darnassus.‡将沃鲁斯的角交给达纳苏斯的艾兰娜瑞。‡將沃魯斯的角交給達納蘇斯的艾蘭娜瑞。',
  }
},
[1684] = {
  {
    'Elanaria‡Эланария‡Elanaria‡엘라나리아‡Elanaria‡Elanaria‡Elanaria‡艾兰娜瑞‡艾蘭娜瑞',
    nil,
    'Fale com Elanaria.‡Поговорите с Эланарией.‡Sprecht mit Elanaria.‡엘라나리아와 대화하십시오.‡Habla con Elanaria.‡Habla con Elanaria.‡Parler à Elanaria.‡和艾兰娜瑞谈一谈。‡和艾蘭娜瑞談壹談。',
  }
},
[1685] = {
  {
    'Convocação de Gakin‡Приглашение Гакина‡Gakins Beschwörung‡게이킨의 부름‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡加科因的召喚',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Встретьтесь с Гакином Темнопрядом в квартале магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Stormwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고해야 합니다.‡Preséntate ante Gakin Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Stormwind.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向黑暗縛靈者加科因報到。',
  }
},
[1686] = {
  {
    'O vulto de Elura‡Тень Элуры‡Eluras Schemen‡엘룰라의 유령‡La sombra de Elura‡La sombra de Elura‡L\'Ombre d\'Elura‡艾鲁拉的阴影‡艾魯拉的陰影',
    nil,
    'Leve 8 cargas de Minério de Elunita e o Medalhão de Elura para Elanaria em Darnassus.‡Принесите 8 партий элунитовой руды и медальон Элуры Эланарии из Дарнасса.‡Bringt 8 Ladungen Eluniterz und das Medaillon von Elura zu Elanaria in Darnassus.‡다르나서스에 있는 엘라나리아에게 엘루니트 광석 상자 8개와 엘루라의 메달을 가져가야 합니다.‡Lleva 8 piezas de mineral de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Lleva 8 piezas de mineral de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Apporter 8 Caisses de Minerai d\'Elunite et le Médaillon d\'Elura à Elanaria à Darnassus.‡将艾鲁拉的徽章和8块月神矿石交给达纳苏斯的艾兰娜瑞。‡將艾魯拉的徽章和8塊月神礦石交給達納蘇斯的艾蘭娜瑞。',
  }
},
[1687] = {
  {
    'Farol assombrado‡Маяк с привидениями‡Der gruselige Leuchtturm‡무서운 등대‡El faro fantasma‡El faro fantasma‡Le phare hanté‡幽灵灯塔‡幽靈燈塔',
    nil,
    'Leve o órfão ao Farol, na costa de Cerro Oeste.‡Отведите сироту к маяку на побережье Западного Края.‡Besucht mit Eurem Schützling den Leuchtturm an der Küste von Westfall.‡랜디스를 서부 몰락지대 해안에 있는 등대로 데려가야 합니다.‡Lleva al huérfano a ver el faro de la cosa de los Páramos de Poniente.‡Lleva al huérfano a ver el faro de la cosa de los Páramos de Poniente.‡Emmenez l\'orphelin voir le phare sur la côte de la marche de l\'Ouest.‡带着你看护的孤儿去西部荒野海岸边的灯塔。‡帶著你看護的孤兒去西部荒野海岸邊的燈塔。',
  }
},
[1688] = {
  {
    'Surena Caledon‡Сурена Каледон‡Surena Caledon‡슈레나 캘리돈‡Surena Caledon‡Surena Caledon‡Surena Caledon‡苏伦娜·凯尔东‡蘇倫娜·凱爾東',
    nil,
    'Recupere a Gargantilha de Surena e entregue-a a Gakin, o Neromante, em Ventobravo.‡Верните колье Кровавого камня Гакину Темной Вязи в Штормград.‡Beschafft Surenas Halsschmuck für Gakin den Dunkelbinder in Stormwind.‡슈레나의 목걸이를 찾아 스톰윈드에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Retrouver l’Écharpe de Surena pour Gakin le Tisse-noir à Stormwind.‡为暴风城的黑暗缚灵者加科因夺回苏伦娜的项圈。‡為暴風城的黑暗縛靈者加科因奪回蘇倫娜的項圈。',
  }
},
[1689] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando a Gargantilha de Pedra-sangrenta, evoque e sobrepuje um emissário do caos. Depois, devolva a Gargantilha de Pedra-sangrenta a Gakin, o Neromante, em Ventobravo.‡С помощью колье Кровавого камня призовите и подчините демона Бездны, затем верните колье Кровавого камня Гакину Темнопряду.‡Beschwört mit Hilfe des Blutsteinhalsschmucks einen Leerwandler, unterwerft ihn und bringt dann den Blutsteinhalsschmuck zu Gakin dem Dunkelbinder in Stormwind zurück.‡혈석 목걸이를 사용하여 보이드워커를 소환해 제압한 후, 스톰윈드에 있는 대흑마법사 게이킨에게 혈석 목걸이를 돌려주어야 합니다.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Utiliser l’Echarpe de Pierre de sang pour invoquer et soumettre un marcheur du Vide, puis la rapporter à Gakin le Tisse-noir, à Stormwind.‡召唤并制服一个虚空行者，然后将血石颈环还给暴风城的黑暗缚灵者加科因。‡召喚並制服壹個虛空行者，然後將血石頸環還給暴風城的黑暗縛靈者加科因。',
  }
},
[1690] = {
  {
    'O erro dos Errantes‡Расправа над Скитальцами Пустыни‡Wüstenläufergerechtigkeit‡사막유랑단 처단‡Justicia para bandidos‡Justicia para los Vagayermos‡Châtier les Bat-le-désert‡废土的公正‡廢土的公正',
    nil,
    'Elimine 10 Bandidos e Ladrões Errantes a leste de Geringontzan, depois fale novamente com o Engenheiro-chefe Silvadágua.‡Убейте 10 бандитов и 10 воров из шайки Скитальцев Пустыни на востоке от Прибамбасска и возвращайтесь к главному инженеру Чепухастеру.‡Erledigt 10 Banditen und Diebe der Wüstenläufer östlich von Gadgetzan und meldet Euch dann wieder bei Chefingenieur Bilgewhizzle.‡가젯잔의 동쪽에서 10명의 사막유랑단 약탈자와 좀도둑을 처치한 후, 선임기술자 빌지위즐에게 돌아와 보고하십시오.‡Acaba con 10 bandidos y ladrones Deambuladores al este de Gadgetzan y después vuelve a ver al ingeniero jefe Silvaina.‡Acaba con 10 bandidos y ladrones Vagayermos al este de Gadgetzan y después vuelve a ver al ingeniero jefe Pasaquillas.‡Abattre 10 Bandits et 10 Larrons Bat-le-désert à l\'est de Gadgetzan, puis revenir au rapport auprès de l\'ingénieur en chef Bilgewhizzle.‡去加基森的东面杀掉10个废土窃贼和10个废土强盗，然后向总工程师比格维兹复命。‡去加基森的東面殺掉10個廢土竊賊和10個廢土強盜，然後向總工程師比格維茲復命。',
  }
},
[1691] = {
  {
    'O enterro dos Errantes‡Еще одна расправа над Скитальцами Пустыни‡Noch mehr Wüstenläufergerechtigkeit‡사막유랑단 추가 처단‡Más justicia para bandidos‡Más justicia para los Vagayermos‡Continuer à châtier les Bat-le-désert‡废土的公正‡廢土的公正',
    nil,
    'Elimine 10 Magos das Sombras Errantes, 8 Ladinos Errantes e 6 Assassinos Errantes para o Engenheiro-chefe Silvadágua em Geringontzan.‡Убейте 10 темных магов, 8 разбойников и 6 убийц из шайки Скитальцев Пустыни по поручению главного инженера Чепухастера из Прибамбасска.‡Erledigt 10 Schattenmagier der Wüstenläufer, 8 Schurken der Wüstenläufer und 6 Auftragsmörder der Wüstenläufer für Chefingenieur Bilgewhizzle in Gadgetzan.‡가젯잔에 있는 선임기술자 빌지위즐을 위해 사막유랑단 도적 8명, 사막유랑단 암살자 6명, 그리고 사막유랑단 어둠마법사 10명을 처치해야 합니다.‡Acaba con 10 magos oscuros Deambuladores, 8 pícaros Deambuladores y 6 asesinos Deambuladores para el ingeniero jefe Silvaina de Gadgetzan.‡Acaba con 10 magos oscuros Vagayermos, 8 pícaros Vagayermos y 6 asesinos Vagayermos para el ingeniero jefe Pasaquillas de Gadgetzan.‡Tuer 10 Mages de l\'ombre Bat-le-désert, 8 Voleurs Bat-le-désert et 6 Assassins Bat-le-désert pour l\'ingénieur en chef Bilgewhizzle à Gadgetzan.‡杀死10个废土暗法师、8个废土游荡者和6个废土刺客，然后向加基森的总工程师比格维兹报告。‡殺死10個廢土暗法師、8個廢土遊蕩者和6個廢土刺客，然後向加基森的總工程師比格維茲報告。',
  }
},
[1692] = {
  {
    'Mathiel, o ferreiro‡Кузнец Матиль‡Schmied Mathiel‡대장장이 메시엘‡Mathiel, el herrero‡Mathiel, el herrero‡Forgeron Mathiel‡铁匠玛希尔‡鐵匠瑪希爾',
    nil,
    'Leve o Caixote de Elunita para Mathiel, o Ferreiro.‡Отнесите сундук элунита кузнецу Матилю.‡Bringt das Behältnis mit Elunit zu Schmied Mathiel.‡엘루니트 상자를 대장장이 메시엘에게 가져가야 합니다.‡Lleva el estuche de elunita al herrero Mathiel.‡Lleva el estuche de elunita al herrero Mathiel.‡Apporter la Caisse d\'Elunite au Forgeron Mathiel.‡把这箱月神矿石交给铁匠玛希尔。‡把這箱月神礦石交給鐵匠瑪希爾。',
  }
},
[1693] = {
  {
    'Armas de elunita‡Оружие из элунита‡Waffen aus Elunit‡엘루니트의 무기‡Armas de Elunita‡Armas de Elunita‡Armes en Elunite‡月神武器‡月神武器',
    nil,
    nil,
  }
},
[1698] = {
  {
    'Yorus Cervevada‡Йорус Ячменовар‡Yorus Gerstenbräu‡요루스 발리브루‡Yorus Cebadiz‡Yorus Cebadiz‡Yorus Barleybrew‡犹鲁斯·麦酒‡猶魯斯·麥酒',
    nil,
    'Fale com Yorus Cervevada.‡Поговорите с Йорусом Ячменоваром.‡Sprecht mit Yorus Gerstenbräu.‡요루스 발리브루와 대화하십시오.‡Habla con Yorus Cebadiz.‡Habla con Yorus Cebadiz.‡Parler à Yorus Barleybrew.‡与犹鲁斯·麦酒谈一谈。‡與猶魯斯·麥酒談壹談。',
  }
},
[1699] = {
  {
    'Desafio da Retibana‡Ретбанский вызов‡Der Rethban-Spießrutenlauf‡레스밴 도전‡El guantelete de Rethban‡El guantelete de Rethban‡Le défi de Rethban‡往返瑞斯班洞穴‡往返瑞斯班洞穴',
    nil,
    'Entre nas Cavernas Retibanas, chegue à primeira bifurcação e volte até Yorus Cervevada no tempo estipulado.|nMorrer e libertar o espírito não é permitido.‡Войдите в пещеры Ретбана, доберитесь до первой развилки и вернитесь к Йорусу Ячменовару за отведенное время.|nВы не должны умирать и освобождать свой дух.‡Betretet die Rethbanhöhlen, geht bis zur ersten Gabelung und kehrt innerhalb der zulässigen Zeit zu Yorus Gerstenbräu zurück.|nIhr dürft nicht sterben und Euren Geist befreien.‡주어진 시간 내에 레스밴 동굴의 첫번째 분기점까지 들어갔다가 요루스 발리브루에게로 되돌아와야 합니다.|n죽어서 영혼이 빠져나가서는 안 됩니다.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|nNo debes morir y liberar tu espíritu.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|nNo debes morir y liberar tu espíritu.‡Entrer dans les Cavernes de Rethban jusqu\'à la première fourche, et revenir voir Barleybrew dans le temps imparti.|nVous ne devez pas mourir.‡进入瑞斯班洞穴，然后在规定的时间内回到犹鲁斯·麦酒那里。|n在整个过程中你都不能死掉或者释放灵魂，否则任务就宣告失败。‡進入瑞斯班洞穴，然後在規定的時間內回到猶魯斯·麥酒那裏。|n在整個過程中妳都不能死掉或者釋放靈魂，否則任務就宣告失敗。',
  }
},
[1700] = {
  {
    'Grimand Elmore‡Гриманд Элмор‡Grimand Elmore‡그리만트 엘모어‡Grimand Elmore‡Grimand Elmore‡Grimand Elmore‡格瑞曼德·艾尔默‡格瑞曼德·艾爾默',
    nil,
    'Leve as Notas de Furen para Grimand Elmore.‡Отнесите записки Фьюрена Гриманду Элмору.‡Bringt Furens Notizen zu Grimand Elmore.‡그리만트 엘모어에게 푸렌의 쪽지를 가져가야 합니다.‡Lleva las notas de Furen a Grimand Elmore.‡Lleva las notas de Furen a Grimand Elmore.‡Porter les Notes de Furen à Grimand Elmore.‡把弗伦的笔记交给格瑞曼德·艾尔默。‡把弗倫的筆記交給格瑞曼德·艾爾默。',
  }
},
[1701] = {
  {
    'Malha endurecida a fogo‡Закаленный доспех‡Feuergehärteter Panzer‡불에 달궈 만든 갑옷‡Armadura de mallas endurecida con fuego‡Armadura de malla endurecida con fuego‡Une cotte de mailles en acier trempé‡弗伦的铠甲‡弗倫的鎧甲',
    nil,
    'Colete as matérias-primas pedidas por Furen Barbalonga e leve-as para ele em Ventobravo.‡Соберите все необходимые материалы для Фьюрена Длинноборода и отнесите их в Штормград.‡Sammelt die Materialien, die Furen Longbeard benötigt, und bringt sie zu ihm nach Stormwind.‡스톰윈드에 있는 푸렌 롱비어드에게 그가 필요로 하는 재료들을 모아서 가져가야 합니다.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Réunir les matériaux dont Furen Longbeard a besoin et lui apporter à Stormwind.‡收集必需的材料，将它们交给暴风城的弗伦·长须。‡收集必需的材料，將它們交給暴風城的弗倫·長須。',
  }
},
[1702] = {
  {
    'O fabricante de escudos‡Щитник‡Der Schildschmied‡방패 상인‡El forjador de escudos‡El forjador de escudos‡Fabricant de bouclier‡铸盾师‡鑄盾師',
    nil,
    'Leve o Barril de Grogue para Furen Barbalonga.‡Отнесите бочонок жгучего пива Фьюрену Длиннобороду.‡Bringt das Fässlein mit Gerstenbräu zu Furen Longbeard.‡푸렌 롱비어드에게 스칼더 술통을 가져가야 합니다.‡Lleva el barril de brebaje a Furen Barbalarga.‡Lleva el barril de brebaje a Furen Barbalarga.‡Apporter le Tonneau de Scalder à Furen Longbeard.‡将这桶热酒交给弗伦·长须。‡將這桶熱酒交給弗倫·長須。',
  }
},
[1703] = {
  {
    'Mathiel‡Матиль‡Mathiel‡메시엘‡Mathiel‡Mathiel‡Mathiel‡玛希尔‡瑪希爾',
    nil,
    'Leve as Notas de Furen para Mathiel.‡Отнесите Матилю записки Фьюрена.‡Bringt Furens Notizen zu Mathiel.‡메시엘에게 푸렌의 쪽지를 가져가야 합니다.‡Lleva las notas de Furen a Mathiel.‡Lleva las notas de Furen a Mathiel.‡Apporter les Notes de Furen à Mathiel.‡把弗伦的笔记交给玛希尔。‡把弗倫的筆記交給瑪希爾。',
  }
},
[1704] = {
  {
    'Cronomorfus Espanafuso‡Клацморт Гайкокрут‡Klockmort Spannerspan‡클락몰트 스패너스판‡Klockmort Palmalicate‡Klockmort Palmalicate‡Klockmort Spannerspan‡科罗莫特·钢尺‡科羅莫特·鋼尺',
    nil,
    'Leve as Notas de Furen para Cronomorfus Espanafuso.‡Отнесите записки Фьюрена Клацморту Гайкокруту.‡Bringt Furens Notizen zu Klockmort Spannerspan.‡클락몰트 스패너스판에게 푸렌의 쪽지를 가져가야 합니다.‡Lleva las notas de Furen a Klockmort Palmalicate.‡Lleva las notas de Furen a Klockmort Palmalicate.‡Apporter les Notes de Furen à Klockmort Spannerspan.‡把弗伦的笔记交给科罗莫特·钢尺。‡把弗倫的筆記交給科羅莫特·鋼尺。',
  }
},
[1705] = {
  {
    'Sangue Ardente‡Пылающая кровь‡Brennendes Blut‡불타는 혈액‡Sangre ardiente‡Sangre ardiente‡Le sang ardent‡燃烧之血‡燃燒之血',
    nil,
    'Leve 20 ampolas de Sangue Ardente e 1 Pedra Ardente para Grimand Elmore em Ventobravo.‡Принесите 20 сосудов горящей крови и 1 горящий камень Гриманду Элмору из Штормграда.‡Bringt 20 Phiolen brennendes Blut und 1 brennenden Fels zu Grimand Elmore in Stormwind.‡스톰윈드에 있는 그리만트 엘모어에게 불타는 혈액 20개와 불타는 보석 1개를 가져가야 합니다.‡Lleva 20 viales de sangre ardiente y 1 roca ardiente a Grimand Elmore en Ventormenta.‡Lleva 20 viales de sangre ardiente y 1 roca ardiente a Grimand Elmore en Ventormenta.‡Rapporter 20 Fioles de sang ardent et 1 Roc ardent à Grimand Elmore à Stormwind.‡把20瓶燃烧之血和1块燃烧之石交给暴风城的格瑞曼德·艾尔默。‡把20瓶燃燒之血和1塊燃燒之石交給暴風城的格瑞曼德·艾爾默。',
  }
},
[1706] = {
  {
    'Armadura de Grimand‡Доспехи Гриманда‡Grimands Rüstung‡그리먼트의 갑옷‡La armadura de Grimand‡La armadura de Grimand‡L\'armure de Grimand‡格瑞曼德的铠甲‡格瑞曼德的鎧甲',
    nil,
    nil,
  }
},
[1707] = {
  {
    'Bolsas de água pra refrescar‡Награда за воду‡Wasserbeutelkopfgeld‡물주머니 현상금‡Cazador de bolsas de agua‡Cazador de faltriqueras de agua‡Prime de la poche à eau‡收集水袋‡收集水袋',
    nil,
    'Leve 5 Bolsas de Água do Errante para o Operador de Torneira Rastamala em Geringontzan.‡Принесите 5 бурдюков Скитальцев Пустыни оператору крана Тормозиллеру в Прибамбасск.‡Bringt Leitungshahnmaschinist Luglunket in Gadgetzan 5 Wasserbeutel eines Wüstenläufers.‡가젯잔에 있는 양수기기사 루글룬켓에게 사막유랑단 물주머니 5개를 가져가야 합니다.‡Llévale 5 bolsas de agua de los Deambuladores al grifoperador Luglunket, que está en Gadgetzan.‡Llévale 5 faltriqueras de agua de Vagayermos al grifoperador Llantalunket, que está en Gadgetzan.‡Apporter 5 Outres de Bat-le-désert à l\'Opérateur de robinet Luglunket à Gadgetzan.‡收集5只废土水袋，把它们交给加基森的鲁格伦克。‡收集5只廢土水袋，把它們交給加基森的魯格倫克。',
  }
},
[1708] = {
  {
    'Coral de Ferro‡Железный коралл‡Eisenkoralle‡철산호‡Coral férreo‡Coral férreo‡Le corail de fer‡铁珊瑚‡鐵珊瑚',
    nil,
    'Leve 20 peças de Coral Causticante para Cronomorfus Espanafuso em Altaforja.‡Принесите 20 партий выжженного коралла Клацморту Гайкокруту в Стальгорн.‡Bringt 20 Ladungen Sengkoralle zu Klockmort Spannerspan in Ironforge.‡아이언포지에 있는 클락몰트 스패너스판에게 철산호 20개를 가져가야 합니다.‡Lleva 20 piezas de coral férreo a Klockmort Palmalicate en Forjaz.‡Lleva 20 piezas de coral férreo a Klockmort Palmalicate en Forjaz.‡Apporter 20 Coraux torrides à Klockmort Spannerspan à Ironforge.‡收集20块灼热珊瑚，把它们交给铁炉堡的科罗莫特·钢尺。‡收集20塊灼熱珊瑚，把它們交給鐵爐堡的科羅莫特·鋼尺。',
  }
},
[1709] = {
  {
    'Criação do Cronomorfus‡Творение Клацморта‡Klockmorts Kreation‡클락몰트의 창작품‡La creación de Klockmort‡La creación de Klockmort‡La création de Klockmort‡科罗莫特的成果‡科羅莫特的成果',
    nil,
    nil,
  }
},
[1710] = {
  {
    'Cascas queimadas de sol‡Высохшая скорлупа‡Sonnenverbrannte Schalen‡바짝 마른 알껍질‡Cáscaras asoladas‡Cáscaras asoladas‡Coquilles desséchées au soleil‡晒焦的蛋壳‡曬焦的蛋殼',
    nil,
    'Leve 20 Cascas Queimadas de Sol para Mathiel em Darnassus.‡Принесите 20 кусков высохшей на солнце скорлупы Матилю из Дарнасса.‡Bringt 20 sonnenverbrannte Schalen zu Mathiel in Darnassus.‡다르나서스에 있는 메시엘에게 바짝 마른 알껍질 20개를 가져가야 합니다.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Apporter 20 Coquilles desséchées au soleil à Mathiel à Darnassus.‡把20个晒焦的蛋壳交给达纳苏斯的玛希尔。‡把20個曬焦的蛋殼交給達納蘇斯的瑪希爾。',
  }
},
[1711] = {
  {
    'A armadura de Mathiel‡Доспехи Матиля‡Mathiels Rüstung‡메시엘의 방어구‡La armadura de Mathiel‡La armadura de Mathiel‡L\'armure de Mathiel‡玛希尔的铠甲‡瑪希爾的鎧甲',
