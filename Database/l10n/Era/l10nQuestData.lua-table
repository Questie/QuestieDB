[8275] = {
  {
    'A retomada de Silithus‡Отвоевание Силитуса‡Die Rückeroberung von Silithus‡실리더스 탈환‡La reconquista de Silithus‡La reconquista de Silithus‡La reconquête de Silithus‡夺回希利苏斯‡奪回希利蘇斯',
    nil,
    'Apresente-se à Arauto do Vento Chifre Altivo no Forte Cenariano, em Silithus.‡Поговорите с призывательницей ветров Гордый Рог в крепости Кенария.‡Sprecht mit Windruferin Proudhorn auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼과 대화해야 합니다.‡Habla con Astaorgullo Clamavientos en el Fuerte Cenarion, en Silithus.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Parler à l\'imploratrice céleste Proudhorn au Fort cénarien, en Silithus.‡与希利苏斯塞纳里奥要塞的唤风者梅恩·长角谈一谈。‡與希利蘇斯塞納裏奧要塞的喚風者梅恩·長角談壹談。',
  }
},
[8276] = {
  {
    'A retomada de Silithus‡Отвоевание Силитуса‡Die Rückeroberung von Silithus‡실리더스 탈환‡La reconquista de Silithus‡La reconquista de Silithus‡La reconquête de Silithus‡夺回希利苏斯‡奪回希利蘇斯',
    nil,
    'Apresente-se à Arauto do Vento Chifre Altivo no Forte Cenariano, em Silithus.‡Поговорите с призывательницей ветров Гордый Рог в крепости Кенария.‡Sprecht mit Windruferin Proudhorn auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼과 대화해야 합니다.‡Habla con Astaorgullo Clamavientos en el Fuerte Cenarion, en Silithus.‡Habla con Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus.‡Parler à l\'imploratrice céleste Proudhorn au Fort cénarien, en Silithus.‡与希利苏斯塞纳里奥要塞的唤风者梅恩·长角谈一谈。‡與希利蘇斯塞納裏奧要塞的喚風者梅恩·長角談壹談。',
  }
},
[8277] = {
  {
    'Peçonha mortal do deserto‡Смертельный яд‡Tödliches Wüstengift‡치명적인 사막의 맹독‡Veneno mortal del desierto‡Veneno mortal del desierto‡Venin mortel du désert‡沙漠中的剧毒‡沙漠中的劇毒',
    nil,
    'Belhatriz Corredente, no Forte Cenariano em Silithus, quer que você traga 8 Aguilhões de Escorpídeo Petraçoite e 8 Presas de Rastejante da Areia. Fale com ela quando tiver completado a tarefa.‡Принесите Битиссе Шаткобрус из крепости Кенария 8 жал камнехвостых скорпидов и 8 жвал песчаных пауков-быстроногов.‡Beetix Ficklespragg von der Burg Cenarius in Silithus möchte, dass Ihr 8 Stachel von Steinpanzerskorpiden und 8 Giftzähne von Sandhuschern für sie sammelt. Kehrt zu ihr zurück, sobald Ihr diese Aufgabe erfüllt habt.‡실리더스에서 돌꼬리전갈 독침 8개와 모래그물 바위거미 송곳니 8개를 모은 후, 세나리온 요새에 있는 비틱스 픽클스프라그에게 돌아가야 합니다.‡Beetix Castaneo en el Fuerte Cenarion, en Silithus, quiere que consigas 8 aguijoneros escórpidos Latigosólido y 8 colmillos de arácnidos de arena. Vuelve a verla cuando hayas cumplido tu misión.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus, quiere que consigas 8 aguijones de escórpido Latipiedra y 8 colmillos de arácnidos de arena. Vuelve a verla cuando hayas cumplido tu misión.‡Beetix Ficklespragg au Fort cénarien en Silithus veut que vous ramassiez 8 Dards de scorpide Cinglepierre et 8 Crocs de Glisseuse du sable. Retournez la voir quand vous aurez terminé.‡希利苏斯塞纳里奥要塞的比提克斯·斯巴格要求你带8个石鞭蝎之刺和8个掠沙蜘蛛的牙齿给他。‡希利蘇斯塞納裏奧要塞的比提克斯·斯巴格要求妳帶8個石鞭蠍之刺和8個掠沙蜘蛛的牙齒給他。',
  }
},
[8278] = {
  {
    'A última esperança de Noggel‡Последняя надежда Ноггла‡Noggles letzte Hoffnung‡노글의 마지막 희망‡La última esperanza de Noggle‡La última esperanza de Noggle‡Le dernier espoir de Noggle‡诺格的最后一线希望‡諾格的最後壹線希望',
    nil,
    'Belhatriz Corredente, no Forte Cenariano em Silithus, quer que você consiga 3 Aguilhões de Tenaz Petraçoite, 3 Aguilhões de Esfolador Petraçoite e 3 Presas de Espreitadora de Rocha.‡Принесите Битиссе Шаткобрус из крепости Кенария 3 жала камнехвостых клешневиков, 3 жала камнехвостых живодеров и 3 клыка скальных пауков-скакунов.‡Beetix Ficklespragg von der Burg Cenarius in Silithus möchte, dass Ihr je 3 Stachel von Steinpanzerzangen und Steinpanzerschindern, sowie 3 Felspirschergiftzähne für sie sammelt.‡실리더스에서 돌꼬리집게전갈 독침 3개, 돌꼬리채찍전갈 독침 3개, 긴다리 바위거미 송곳니 3개를 모은 후, 세나리온 요새에 있는 비틱스 픽클스프라그에게 돌아가야 합니다.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus quiere que consigas 3 aguijoneros de tenazario Latipiedra, 3 aguijoneros de despellejador Latipiedra y 3 colmillos de acecharrocas.‡Beetix Castañeta en el Fuerte Cenarion, en Silithus quiere que consigas 3 aguijoneros de tenazario Latipiedra, 3 aguijoneros de despellejador Latipiedra y 3 colmillos de acecharrocas.‡Beetix Ficklespragg, du Fort cénarien en Silithus, veut que vous ramassiez 3 Dards de pinceurs Cinglepierre, 3 Dards d\'écorcheur Cinglepierre et 3 Crocs de traqueuse des rochers.‡希利苏斯塞纳里奥要塞的比提克斯·斯巴格要求你给他带去3个石鞭巨钳蝎之刺、3个石鞭掠夺者之刺和3个石行蜘蛛的牙齿。‡希利蘇斯塞納裏奧要塞的比提克斯·斯巴格要求妳給他帶去3個石鞭巨鉗蠍之刺、3個石鞭掠奪者之刺和3個石行蜘蛛的牙齒。',
  }
},
[8279] = {
  {
    'O dicionário do crepúsculo‡Сумеречный словарь‡Das Lexikon der Twilight‡황혼의 사전‡El Lexicón del Crepúsculo‡El Lexicón Crepuscular‡Le lexique du Crépuscule‡暮光词典‡暮光詞典',
    nil,
    'Traga os três capítulos do Dicionário do Crepúsculo para o Eremita Ortell em Silithus.‡Принесите три главы Сумеречного словаря отшельнику Ортеллу из Силитуса.‡Bringt Ortell dem Einsiedler in Silithus die drei Kapitel des Lexikons der Twilight.‡실리더스에 있는 은둔자 오르텔에게 황혼의 사전 1,2,3 장을 가져가야 합니다.‡Lleva los tres capítulos del Lexicón del Crepúsculo a Hermit Ortell en Silithus.‡Lleva los tres capítulos del Lexicón Crepuscular al Ermitaño Ortell en Silithus.‡Apportez les trois chapitres du Lexique du Crépuscule à l\'ermite Ortell, en Silithus.‡把暮光词典的三个章节交给希利苏斯的隐士奥泰尔。‡把暮光詞典的三個章節交給希利蘇斯的隱士奧泰爾。',
  }
},
[8280] = {
  {
    'Defendendo as linhas de suprimento‡Надежные поставки‡Sicherung der Versorgungslinien‡보급로 확보‡Asegurar las rutas de suministros‡Asegurar las rutas de suministros‡Sécuriser les lignes d\'approvisionnement‡保护补给线‡保護補給線',
    nil,
    'O Arauto do Vento Chifre Altivo, no Forte Cenariano, quer que você mate 15 Dragatacas.‡Убейте 15 землечерпов по поручению призывательницы ветров Гордый Рог.‡Windruferin Proudhorn auf Burg Cenarius in Silithus möchte, dass Ihr 15 Baggerschläger tötet.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼이 작살미늘벌레 15마리를 처치해 달라고 부탁했습니다.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 15 golpeadores deslizantes.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 15 golpeadores deslizantes.‡L\'Imploratrice céleste Proudhorn au Fort cénarien en Silithus veut que vous tuiez 15 Frappeurs térébrants.‡希利苏斯塞纳里奥要塞的唤风者梅恩·长角要求你去杀死15只掘泥打击者。‡希利蘇斯塞納裏奧要塞的喚風者梅恩·長角要求妳去殺死15只掘泥打擊者。',
  }
},
[8281] = {
  {
    'Aumentando a segurança‡Обеспечение безопасности‡Verstärkte Sicherheit‡보급로 안전 강화‡Intensificar la seguridad‡Intensificar la seguridad‡Améliorer la sécurité‡确保安全‡確保安全',
    nil,
    'O Arauto do Vento Chifre Altivo, no Forte Cenariano, quer que você mate 20 Dragasmagas.‡Убейте 20 земляных сокрушителей по поручению призывательницы ветров Гордый Рог.‡Windruferin Proudhorn auf Burg Cenarius in Silithus möchte, dass Ihr 20 Baggerbrecher tötet.‡실리더스의 세나리온 요새에 있는 바람소환사 프라우드혼이 망치미늘벌레 20마리를 처치해 달라고 부탁했습니다.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 20 trituradores deslizantes.‡Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus, quiere que mates a 20 trituradores deslizantes.‡L\'Imploratrice céleste Corne-fière au Fort cénarien en Silithus veut que vous tuiez 20 Écraseurs térébrants.‡希利苏斯塞纳里奥要塞的唤风者梅恩·长角要求你去杀死20只掘泥摧毁者。‡希利蘇斯塞納裏奧要塞的喚風者梅恩·長角要求妳去殺死20只掘泥摧毀者。',
  }
},
[8282] = {
  {
    'Algibeira perdida do Noggel‡Потерянная сумка Ноггла‡Noggles verlorener Ranzen‡노글의 잃어버린 가방‡La cartera perdida de Noggle‡La cartera perdida de Noggle‡La sacoche perdue de Noggle‡诺格的背包‡諾格的背包',
    nil,
    'Vá para as montanhas na parte sul de Silithus e recupere a Algibeira do Noggel. Devolva-a no Forte Cenariano.‡Принесите сумку Ноггля из гор в южной части Силитуса и верните ее хозяину в крепость Кенария.‡Spürt Noggles Ranzen im südlichen Gebirge von Silithus auf und bringt ihn zu ihm, auf Burg Cenarius, zurück.‡실리더스의 남부 산맥에서 노글의 자루를 찾아 세나리온 요새에 있는 노글에게 가져가야 합니다.‡Recupera la Cartera de Noggle en las montañas al sur de Silithus y devuélvesela en el Fuerte Cenarion.‡Recupera la Cartera de Noggle en las montañas al sur de Silithus y devuélvesela en el Fuerte Cenarion.‡Récupérez la Sacoche de Noggle dans les montagnes au sud de Silithus et rapportez-la-lui au Fort cénarien.‡从希利苏斯南部山中找到诺格的背包，然后将它交给塞纳里奥要塞中的诺格。‡從希利蘇斯南部山中找到諾格的背包，然後將它交給塞納裏奧要塞中的諾格。',
  }
},
[8283] = {
  {
    'Procura-se: Agarramata, o Terror das Areias‡РОЗЫСК: Смертехват, гроза пустыни‡GESUCHT: Totenstachel, Terror der Wüste‡현상수배: 사막의 난폭자 죽음의 갈고리‡Se busca: Pinzamorten el Terror de las arenas‡Se busca: Pinzamorten el Terror de las arenas‡On recherche : Poigne-de-mort, Terreur des sables‡通缉：死亡弯钩‡通緝：死亡彎鉤',
    nil,
    'Leve a Tenaz da Agarramata para Vish Kozus, Capitão da Guarda.‡Принесите хелицеры Смертехвата Вишу Коцусу, капитану стражи.‡Bringt die Zange Totenstachels zu Vish Kozus, Captain der Wache.‡경비대장 비쉬 코주스에게 죽음의 갈고리 집게발을 가져가야 합니다.‡Lleva la pinza de Pinzamorten a Vish Kozus, Capitán de la guardia.‡Lleva la pinza de Pinzamorten a Vish Kozus, Capitán de la guardia.‡Apporter la Pince de Poigne-de-mort à Vish Kozus, capitaine de la garde.‡将死亡弯钩的蝎钳交给卫兵队长维斯·库鲁兹。‡將死亡彎鉤的蠍鉗交給衛兵隊長維斯·庫魯茲。',
  }
},
[8284] = {
  {
    'O mistério do crepúsculo‡Сумеречная тайна‡Das Geheimnis der Twilight-Hammer‡황혼의망치단의 비밀‡El misterio del Crepúsculo‡El misterio Crepuscular‡Le mystère du Crépuscule‡暮光的秘密‡暮光的秘密',
    nil,
    'A Geóloga Matarriso, no Forte Cenariano, quer que você recolha 8 Fragmentos de Tabuleta do Crepúsculo.‡Геолог Ехидная из крепости Кенария просит вас собрать 8 фрагментов сумеречной таблички.‡Geologin Larksbane auf Burg Cenarius möchte, dass Ihr ihr 8 Schrifttafelfragmente der Twilight bringt.‡실리더스의 세나리온 요새에 있는 지질학자 락스베인이 황혼의 서판 조각 8개를 모아 달라고 부탁했습니다.‡La Geóloga Trotuina en el Fuerte Cenarion, en Silithus, quiere que consigas 8 fragmentos de tablilla Crepuscular.‡La Geóloga Trotuina en el Fuerte Cenarion, en Silithus, quiere que consigas 8 fragmentos de tablilla Crepuscular.‡La géologue Larksbane du Fort cénarien en Silithus veut que vous rassembliez 8 Fragments de Tablette du crépuscule.‡希利苏斯塞纳里奥要塞的地质学家拉克斯班要你去收集8块暮光石板碎片。‡希利蘇斯塞納裏奧要塞的地質學家拉克斯班要妳去收集8塊暮光石板碎片。',
  }
},
[8285] = {
  {
    'O desertor‡Дезертир‡Der Deserteur‡황혼의망치단 탈영병‡El desertor‡El desertor‡Le déserteur‡沙漠隐士‡沙漠隱士',
    nil,
    'Leve a tabuleta restaurada para o Eremita Ortell em Silithus.‡Отнесите восстановленную табличку отшельнику Ортеллу в Силитус.‡Bringt die wiederhergestellte Schrifttafel zu Ortell dem Einsiedler in Silithus.‡실리더스에 있는 은둔자 오르텔에게 복원한 서판을 가져다줘야 합니다.‡Lleva la tablilla restaurada al ermitaño Ortell en Silithus.|n‡Lleva la tablilla restaurada a Ermitaño Ortell en Silithus.‡Apportez la Tablette réparée à l\'ermite Ortell en Silithus.‡把复原的石板带给希利苏斯的隐士奥泰尔。‡把復原的石板帶給希利蘇斯的隱士奧泰爾。',
  }
},
[8286] = {
  {
    'O que nos traz o dia de amanhã‡Что ждет нас завтра‡Was uns morgen erwartet‡미래의 운명‡Lo que nos depara el futuro‡Lo que nos depara el futuro‡Ce que demain apportera‡明天的希望‡明天的希望',
    nil,
    'Adentre as Cavernas do Tempo, em Tanaris, e encontre Anacronos, Prole de Nozdormu.‡Отправляйтесь в Пещеры Времени в Танарисе и найдите Анахроноса, из рода Ноздорму.‡Reist zu den Höhlen der Zeit in Tanaris und findet Anachronos, Nachkomme Nozdormus.‡타나리스에 있는 시간의 동굴로 가서 노즈도르무 혈족인 아나크로노스를 찾아야 합니다.‡Ve a las Cavernas del Tiempo en Tanaris y encuentra a Anacronos, del Linaje de Nozdormu.‡Ve a las Cavernas del Tiempo en Tanaris y encuentra a Anacronos, del Linaje de Nozdormu.‡Rendez vous dans les grottes du Temps en Tanaris et trouvez Anachronos, la progéniture de Nozdormu.‡前往塔纳利斯的时光之穴寻找诺兹多姆的子嗣，阿纳克洛斯。‡前往塔納利斯的時光之穴尋找諾茲多姆的子嗣，阿納克洛斯。|n完成任務後回到希利蘇斯塞納裏奧要塞的流沙守望者巴裏斯托爾斯那兒。',
  }
},
[8287] = {
  {
    'Intenção terrível‡Ужасная цель‡Ein teuflischer Plan‡황혼의망치단의 존재‡Un propósito terrible‡Un propósito terrible‡Un terrible but‡摆脱困境‡擺脫困境',
    nil,
    'Leve a Transcrição Decodificada da Tabuleta para o Comandante Mar\'alith.‡Отнесите переписанный с таблички расшифрованный текст командиру Мар\'алиту.‡Bringt Kommandant Mar\'alith die entschlüsselte Abschrift der Schrifttafel.‡지휘관 마랄리스에게 해독된 서판 탁본을 가져가야 합니다.‡Lleva la trascripción de tablilla decodificada al comandante Mar\'alith.‡Lleva la trascripción de tablilla decodificada al comandante Mar\'alith.‡Remettez la Transcirption décodée de la tablette au commandant Mar\'alith.‡把解密石板碑文交给指挥官玛尔利斯。‡把解密石板碑文交給指揮官瑪爾利斯。',
  }
},
[8288] = {
  {
    'Só pode ascender um‡Кто будет избран?‡Nur einer kann sich erheben‡최후의 한 명‡Solo uno puede alzarse‡Solo uno puede alzarse‡Il ne peut y en avoir qu\'un‡唯一的领袖‡唯壹的領袖',
    nil,
    'Leve a Cabeça do Prolemestre Flagelador para Baristolth das Areias Cambiantes no Forte Cenariano, em Silithus.‡Принесите голову предводителя драконов Разящего Бича Баристольфу из Зыбучих Песков в крепость Кенария в Силитусе.‡Bringt Brutwächter Dreschbringers Kopf zu Baristolth der Sandstürme in die Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 흐르는 모래의 바리스톨스에게 용기대장 래쉬레이어의 머리를 가져가야 합니다.‡Lleva la cabeza del Señor de linaje Capazote a Baristolth del Mar de Dunas al Fuerte Cenarion en Silithus.‡Lleva la cabeza del Señor de linaje Capazote a Baristolth del Mar de Dunas al Fuerte Cenarion en Silithus.‡Rapportez la Tête du seigneur des couvées Lanistaire à Baristolth des Sables changeants, au Fort cénarien en Silithus.‡到黑石山中的奈法利安巢穴去，杀死勒什雷尔，并带回它的头颅。|n将勒什雷尔的头颅交给希利苏斯塞纳里奥要塞的流沙守望者巴里斯托尔斯。‡到黑石山中的奈法利安巢穴去，殺死勒什雷爾，並帶回它的徽記。|n將勒什雷爾的徽記交給希利蘇斯塞納裏奧要塞的流沙守望者巴裏斯托爾斯。',
  }
},
[8289] = {
  {
    'Talismãs de Mérito‡Талисманы заслуг‡Verdienstabzeichen‡‡Talismanes del mérito‡Talismanes del mérito‡Les talismans de vaillance‡功勋奖章‡功勳獎章',
    nil,
    nil,
  }
},
[8290] = {
  {
    'Aniquile os invasores‡Долой захватчиков!‡Besiegt die Eindringlinge!‡침략자 처단!‡Expulsa al invasor‡Expulsa al invasor‡Triomphez des envahisseurs !‡击败入侵者‡擊敗入侵者',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Horda, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue à Sentinela Cantálgures no Bosque Asa de Prata.‡Войдите в Ущелье Песни Войны, одержите победу над Ордой, получите почетный знак Ущелья Песни Войны и вернитесь с ним к часовому Дальней Песня в рощу Среброкрылых.‡Betretet die Warsongschlucht und besiegt die Streitkräfte der Horde. Verdient Euch ein Ehrenabzeichen der Warsongschlucht und kehrt zur Schildwache Farsong am Hain der Silverwing zurück.‡전쟁노래 협곡으로 들어가 호드를 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 은빛날개 숲에 있는 파수꾼 파송에게 돌아가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de honor de Grito de Guerra y vuelve con la centinela Cantolongo en el Claro Ala de la Plata.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entrez dans le goulet des Warsong, triomphez de la Horde et gagnez une Marque d\'honneur du goulet des Warsong. Puis revenez voir la sentinelle Farsong au bosquet d\'Aile-argent.‡进入战歌峡谷抵御部落小队的攻击，获得一枚银翼功勋奖章，然后向银翼树林中的哨兵艾蒂亚·轻歌回复。‡進入戰歌峽谷抵禦部落小隊的攻擊，獲得壹枚銀翼功勛獎章，然後向銀翼樹林中的哨兵艾蒂亞·輕歌回復。',
  }
},
[8291] = {
  {
    'Aniquile os invasores!‡Долой захватчиков!‡Besiegt die Eindringlinge!‡침략자 처단!‡¡Expulsa al invasor!‡¡Expulsa al invasor!‡Triomphez des envahisseurs !‡击败入侵者！‡擊敗入侵者！',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Horda, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue à Sentinela Cantálgures no Bosque Asa de Prata.‡Войдите в Ущелье Песни Войны, одержите победу над Ордой, получите почетный знак Ущелья Песни Войны и вернитесь с ним к часовому Дальней Песне в рощу Среброкрылых.‡Betretet die Warsongschlucht und besiegt die Streitkräfte der Horde. Verdient Euch ein Ehrenabzeichen der Warsongschlucht und kehrt zur Schildwache Farsong am Hain der Silverwing zurück.‡전쟁노래 협곡으로 들어가 호드를 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 은빛날개 숲에 있는 파수꾼 파송에게 돌아가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de honor de Grito de Guerra y vuelve con la centinela Cantolongo en el Claro Ala de la Plata.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entrez dans le goulet des Warsong, triomphez de la Horde et gagnez une Marque d\'honneur du goulet des Warsong. Puis revenez voir la sentinelle Farsong au bosquet d\'Aile-argent.‡进入战歌峡谷抵御部落小队的攻击，获得一枚银翼功勋奖章，然后向银翼树林中的哨兵艾蒂亚·轻歌回复。‡進入戰歌峽谷抵禦部落小隊的攻擊，獲得壹枚銀翼功勛獎章，然後向銀翼樹林中的哨兵艾蒂亞·輕歌回復。',
  }
},
[8292] = {
  {
    'Talismãs de Mérito‡Талисманы заслуг‡Verdienstabzeichen‡‡Talismanes del mérito‡Talismanes del mérito‡Les talismans de vaillance‡功勋奖章‡功勳獎章',
    nil,
    '‡‡‡‡‡‡‡您为上一个任务获得了银翼功勋奖章，再次与我交谈，您将获得奖励。‡',
  }
},
[8293] = {
  {
    'Marca de Honra‡Почетный знак‡Ehrenabzeichen‡‡Marca de Honor‡Marca de Honor‡La marque d\'honneur‡荣誉奖章‡榮譽獎章',
    nil,
    '‡‡‡‡‡‡‡您为上一个任务获得了战歌荣誉奖章，再次与我交谈，您将获得奖励。‡',
  }
},
[8294] = {
  {
    'Domine os usurpadores da Asa de Prata‡Громи захватчиков-Среброкрылых!‡Bezwingt die Eindringlinge der Silverwing‡은빛날개 분쟁 진압‡Acaba con los usurpadores Ala de Plata‡Acaba con los usurpadores Ala de Plata‡Écrasez les usurpateurs d\'Aile-argent‡镇压银翼部队‡鎮壓銀翼部隊',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Aliança, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue ao Capitão Estilhaça-crânio no Campo-base Mor\'shan.‡Войдите в Ущелье Песни Войны, одержите победу над Альянсом, получите почетный знак Ущелья Песни Войны и вернитесь с ним к капитану Лободробу в лагерь Мор\'шан.‡Betretet die Warsongschlucht und besiegt die Streitkräfte der Allianz. Erwerbt ein Ehrenabzeichen der Warsongschlucht und kehrt anschließend zu Captain Shatterskull im Mor\'shan-Stützpunkt zurück.‡전쟁노래 협곡으로 진입하여 얼라이언스 진영을 무찌르고 전쟁노래 협곡 명예 훈장을 얻으십시오. 몰샨 주둔지에 있는 부대장 쉐터스컬에게 가져가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entrez dans le goulet des Warsong, triomphez de l\'Alliance et obtenez une Marque d\'honneur du goulet des Warsong. Puis revenez voir le capitaine Shatterskull au campement de Mor\'shan.‡进入战歌峡谷击败联盟小队，获得一枚战歌荣誉奖章，然后向莫尔杉营地的沙塔尔·碎颅复命。‡進入戰歌峽谷擊敗聯盟小隊，獲得壹枚戰歌榮譽獎章，然後向莫爾杉營地的沙塔爾·碎顱復命。',
  }
},
[8295] = {
  {
    'Domine os usurpadores da Asa de Prata‡Громи захватчиков-Среброкрылых!‡Bezwingt die Eindringlinge der Silverwing‡은빛날개 분쟁 진압‡Acaba con los usurpadores Ala de Plata‡Acaba con los usurpadores Ala de Plata‡Écrasez les usurpateurs d\'Aile-argent‡镇压银翼部队‡鎮壓銀翼部隊',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Aliança, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue ao Capitão Estilhaça-crânio no Campo-base Mor\'shan.‡Войдите в Ущелье Песни Войны, одержите победу над Альянсом, получите почетный знак Ущелья Песни Войны и вернитесь с ним к капитану Лободробу в лагерь Мор\'шан.‡Betretet die Warsongschlucht und besiegt die Streitkräfte der Allianz. Erwerbt ein Ehrenabzeichen der Warsongschlucht und kehrt anschließend zu Captain Shatterskull im Mor\'shan-Stützpunkt zurück.‡전쟁노래 협곡으로 진입하여 얼라이언스 진영을 무찌르고 전쟁노래 협곡 명예 훈장을 얻으십시오. 몰샨 주둔지에 있는 부대장 쉐터스컬에게 가져가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de honor de Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entrez dans le goulet des Warsong, triomphez de l\'Alliance et obtenez une Marque d\'honneur du goulet des Warsong. Puis revenez voir le capitaine Shatterskull au campement de Mor\'shan.‡进入战歌峡谷击败联盟小队，获得一枚战歌荣誉奖章，然后向莫尔杉营地的沙塔尔·碎颅复命。‡進入戰歌峽谷擊敗聯盟小隊，獲得壹枚戰歌榮譽獎章，然後向莫爾杉營地的沙塔爾·碎顱復命。',
  }
},
[8296] = {
  {
    'Marca de Honra‡Почетный знак‡Ehrenabzeichen‡‡Marca de Honor‡Marca de Honor‡La marque d\'honneur‡荣誉奖章‡榮譽獎章',
    nil,
    nil,
  }
},
[8297] = {
  {
    'Recursos da Bacia Arathi!‡Ресурсы Низины Арати‡Die Ressourcen des Arathibeckens‡아라시 분지 자원!‡Los recursos de la Cuenca de Arathi‡Los recursos de la Cuenca de Arathi‡Les ressources du bassin d\'Arathi‡阿拉希盆地的资源！‡阿拉希盆地的資源！',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com a Sargento Martina na Ponta do Refúgio.‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Макчисту в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Sergeant Maclear in der Zuflucht.‡아라시 분지의 전투를 승리로 이끌고 아라시 보급품 상자를 가지고 임시 주둔지에 있는 하사관 매클리어에게 돌아가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一只阿拉希资源箱，然后向避难谷地的玛克里尔中士复命。‡獲得阿拉希盆地戰鬥的勝利，獲取壹只阿拉希資源箱，然後向避難谷地的瑪克裏爾中士復命。',
  }
},
[8298] = {
  {
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Макчисту в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Unteroffizier Maclear in der Zuflucht.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一个阿拉希资源木箱，然后向避难谷地的玛克里尔中士覆命。‡',
  }
},
[8299] = {
  {
    'Quebra da rota de suprimentos de Arathor‡Перекрыть линии поставок Аратора‡Zerschlagt die Versorgungslinien Arathors‡아라소르 보급선 끊기‡Córtale el suministro a la Liga de Arathor‡Córtale el suministro a la Liga de Arathor‡Couper les voies de ravitaillement d\'Arathor‡切断阿拉索补给线‡切斷阿拉索補給線',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com o Sicário Mortis na Ruína do Martelo.‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡아라시 분지 전투를 승리로 이끌고 아라시 보급품 상자를 구해 해머폴에 있는 죽음의추적자 몰티스에게 가져가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au Traqueur noir Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡進入阿拉希盆地，獲得壹箱阿拉希資源箱，然後將它交給落錘鎮的亡靈哨兵莫提斯。',
  }
},
[8300] = {
  {
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au nécrotraqueur Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡',
  }
},
[8301] = {
  {
    'O caminho do íntegros‡Путь правых‡Der Pfad des Gerechten‡정의의 길‡El buen camino‡El camino del honrado‡Le Chemin des Justes‡正义之路‡正義之路',
    nil,
    'Colete 200 Fragmentos de Carapaça Silitídea e fale novamente com Baristolth.‡Принесите Баристолфу 200 фрагментов силитидских панцирей.‡Kehrt zu Baristolth zurück, sobald Ihr 200 Silithidenknochenpanzerfragmente gesammelt habt.‡실리시드 등껍질 조각 200개를 모아 바리스톨스에게 가져가야 합니다.‡Lleva 200 fragmentos de caparazón de silítido a Baristolth.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Récupérez 200 Fragments de carapaces de silithides et retournez voir Baristolth.‡为流沙守望者巴里斯托尔斯收集200块异种蝎壳碎片。‡希利蘇斯塞納裏奧要塞的流沙守望者巴裏斯托爾斯想要妳殺死亞什蟲巢、佐拉蟲巢和雷戈蟲巢中的異種蟲類。從死去的蟲子屍體上收集異種蠍殼碎片。當妳收集到200塊異種蠍殼碎片時，回到巴裏斯托爾斯那兒去。|n作為壹名諾茲多姆的特使，只有妳和妳的副官可以從異種蟲類的屍體上拾取異種蠍殼碎片。請註意保持妳的包裹空間足夠多。',
  }
},
[8302] = {
  {
    'A mão do íntegro‡Рука Правого‡Die Hand der Gerechtigkeit‡정의의 손길‡Una buena mano‡La mano del honrado‡La Main des Justes‡正义之手‡正義之手',
    nil,
    'Colete 200 Fragmentos de Carapaça Silitídea e fale novamente com Baristolth.‡Принесите Баристолфу 200 фрагментов силитидских панцирей.‡Kehrt zu Baristolth zurück, sobald Ihr 200 Silithidenknochenpanzerfragmente gesammelt habt.‡실리시드 등껍질 조각 200개를 모아 바리스톨스에게 가져가야 합니다.‡Lleva 200 fragmentos de caparazón de silítido a Baristolth.‡Lleva 200 trozos de caparazón de silítido a Baristolth.‡Récupérez 200 Fragments de carapaces de silithides et retournez voir Baristolth.‡为流沙守望者巴里斯托尔斯收集200块异种蝎壳碎片。‡為流沙守望者巴里斯托爾斯收集200塊異種蠍殼碎片。',
  }
},
[8303] = {
  {
    'Anacronos‡Анахронос‡Anachronos‡아나크로노스‡Anacronos‡Anacronos‡Anachronos‡阿纳克洛斯‡阿納克洛斯',
    nil,
    'Encontre Anacronos nas Cavernas do Tempo, em Tanaris.‡Отыщите Анахроноса в Пещерах Времени в Танарисе.‡Sucht nach Anachronos bei den Höhlen der Zeit in Tanaris.‡타나리스의 시간의 동굴에 있는 아나크로노스를 찾아가야 합니다.‡Busca a Anacronos en las Cavernas del Tiempo de Tanaris.‡Busca a Anacronos en las Cavernas del Tiempo de Tanaris.‡Chercher Anachronos dans les Grottes du temps à Tanaris.‡到塔纳利斯的时光之穴去寻找阿纳克洛斯。‡到塔納利斯的時光之穴去尋找阿納克洛斯。',
  }
},
[8304] = {
  {
    'Querida Natália‡Дражайшая Наталиа‡Liebste Natalia‡사랑하는 여군주 나탈리아‡Queridísima Natalia‡Queridísima Natalia‡Chère Natalia‡亲爱的纳塔莉亚‡親愛的納塔莉亞',
    nil,
    'O Comandante Mar\'alith, no Forte Cenariano, em Silithus, quer que você interrogue os ocupantes do Acampamento Barbabronze. Ele fica diretamente ao sul do Forte Cenariano.|nUma vez obtidas as informações solicitadas, fale novamente com o Comandante Mar\'alith.‡Допросите обитателей лагеря Бронзоборода по поручению командира Мар\'алита из крепости Кенария. Этот лагерь находится южнее крепости Кенария.|nСобрав необходимые сведения, вернитесь к командиру Мар\'алиту.‡Kommandant Mar\'alith auf Burg Cenarius in Silithus möchte, dass Ihr die Bewohner von Bronzebeards Lager befragt. Das Lager befindet sich südlich von Burg Cenarius.|nKehrt zu Kommandant Mar\'alith zurück, wenn Ihr die benötigten Informationen gesammelt habt.‡실리더스의 세나리온 요새에 있는 지휘관 마랄리스가 브론즈비어드 야영지에 있는 드워프들에게 부인의 행방을 조사해봐 달라고 부탁했습니다.|n브론즈비어드 야영지는 세나리온 요새의 남쪽에 있습니다.|n정보를 수집한 후 지휘관 마랄리스에게 돌아가야 합니다.‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que interrogues a los habitantes del campamento Barbabronce, que está al sur del fuerte.|nCuando consigas la información ve a ver al comandante Mar\'alith.‡El comandante Mar\'alith de Fuerte Cenarion, en Silithus, quiere que interrogues a los habitantes de Campamento Barbabronce. Encontrarás el Campamento Barbabronce al sur de Fuerte Cenarion.|nUna vez que hayas obtenido la información solicitada, regresa a ver al comandante Mar\'alith.‡Le commandant Mar’alith, du Fort cénarien en Silithus, veut que vous interrogiez les habitants du Campement de Bronzebeard, qui se trouve au sud du Fort cénarien.|nLorsque vous aurez réuni les informations demandées, retournez voir le commandant Mar’alith.‡希利苏斯塞纳里奥要塞的指挥官玛尔利斯想要你询问铜须营地的矮人。你可以在塞纳里奥要塞以南找到铜须营地。|n一旦你收集到有用的信息，就回到指挥官玛尔利斯那儿。‡希利蘇斯塞納裏奧要塞的指揮官瑪爾利斯想要妳詢問銅須營地的矮人。妳可以在塞納裏奧要塞以南找到銅須營地。|n壹旦妳收集到有用的信息，就回到指揮官瑪爾利斯那兒。',
  }
},
[8305] = {
  {
    'Relembranças longínquas‡Давно забытые воспоминания‡Lang Vergessenes‡잊혀진 오랜 기억‡Recuerdos olvidados‡Recuerdos olvidados‡Des souvenirs oubliés depuis longtemps‡久远的记忆‡久遠的記憶',
    nil,
    'Localize a Lágrima Cristalina em Silithus, e contemple suas profundezas.‡Отыщите в Силитусе хрустальную слезу и загляните в ее глубины.‡Sucht die Kristallträne und blickt in ihr Innerstes.‡실리더스에서 눈물의 결정의 위치를 찾아 그 안을 응시하십시오.‡Encuentra la lágrima cristalina en Silithus y mira en sus profundidades.‡Encuentra la lágrima cristalina en Silithus y mira en sus profundidades.‡Trouvez la Larme cristalline, en Silithus, et contemplez ses profondeurs.‡找到希利苏斯的水晶之泪，并凝视它。‡希利蘇斯時光之穴的阿納克洛斯想要妳前往位於希利蘇斯南部沙漠的甲蟲之臺。|n當妳學習完畢後再回到他那兒去。',
  }
},
[8306] = {
  {
    'No ventre da loucura‡В бездне безумия‡Der Schlund des Wahnsinns‡광란의 하이브레갈로‡En las fauces de la locura‡En las fauces de la locura‡L\'antre de la folie‡深入疯狂之口‡深入瘋狂之口',
    nil,
    'O Comandante Mar\'alith do Forte Cenariano em Silithus quer que você encontre Natália. A informação que conseguiu aponta para Colme\'Régia, ao sul, como sendo a área em que você encontrará a Senhora Natália Mar\'alith.|nNão se esqueça de falar com os anões no acampamento do Barbabronze antes de se aventurar na colmeia. Eles podem ter algum trabalho e conselhos para você.|nE, <name>, lembre-se das palavras do Comandante: "Faça o que for necessário..."‡Найдите возлюбленную командира Мар\'алита из крепости Кенария в Силитусе. По имеющим сведениям, госпожу Наталию Мар\'алит можно найти в улье Регал.|nПрежде чем отправляться в улей, не забудьте поговорить с гномами из лагеря Бронзоборода. Они могут дать пару советов и подкинуть дополнительную работу.|nСледует помнить слова командира: "Сделай, что должно..."‡Kommandant Mar\'alith auf Burg Cenarius in Silithus möchte, dass Ihr seine geliebte Natalia wiederfindet. Die von Euch gesammelten Informationen deuten darauf hin, dass Ihr sie im Bau des Regalschwarms im Süden finden könntet.|nSprecht noch einmal mit den Zwergen in Bronzebeards Lager, bevor Ihr Euch in den Schwarmbau begebt. Ihr Wissen könnte sich als hilfreich erweisen und sicherlich, haben sie noch einige Aufgaben für Euch.|nUnd <Name>, denkt an die Worte des Kommandanten: "Tut, was Ihr tun müsst..."‡실리더스의 세나리온 요새에 있는 지휘관 마랄리스가 여군주 나탈리아를 찾아 달라고 부탁했습니다. 수집된 정보에 의하면 남쪽에 있는 하이브레갈에서 여군주 나탈리아 마랄리스를 찾을 수 있을 겁니다.|n곤충 집에 들어가기 전에 브론즈비어드 야영지에 있는 드워프들을 찾아가야 합니다. 드워프들이 조언과 함께 다른 일을 줄 것입니다.|n마지막으로 마랄리스가 했던 말 "그대가 해야 할 일을 하라."를 기억해야 합니다.‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que encuentres a su amada Natalia. Parece que podría estar en Colmen\'Regal, hacia el sur.|nNo olvides ir a ver a los enanos del campamento Barbabronce antes de ir a la colmena; puede que tengan otras tareas o consejos que darte.|nY recuerda lo que dijo el comandante: "Haz lo que tengas que hacer."‡El comandante Mar\'alith del Fuerte Cenarion de Silithus quiere que encuentres a su amada Natalia. Parece que podría estar en Colmen\'Regal, hacia el sur.|nNo olvides ir a ver a los enanos del campamento Barbabronce antes de ir a la colmena; puede que tengan otras tareas o consejos que darte.|nY, <nombre>, recuerda lo que dijo el comandante: "Haz lo que tengas que hacer."‡Le commandant Mar\'alith au Fort cénarien en Silithus veut que vous retrouviez sa bien-aimée, Natalia. Selon les informations que vous avez réunies, la Ruche\'Regal au sud serait l\'endroit où vous pourriez trouver dame Natalia Mar\'alith.|nN\'oubliez pas de rendre visite aux nains au camp de Bronzebeard avant de vous aventurer dans la ruche. Ils ont peut-être d\'autres tâches à vous confier et des conseils pour vous.|nEt <nom>, souvenez-vous des mots du commandant : "Faites votre devoir..."‡希利苏斯塞纳里奥要塞的指挥官玛尔利斯想要你找到他心爱的纳塔莉亚。你收集到的信息表明纳塔莉亚·玛尔利斯可能在南面的雷戈虫巢。|n在你赶往虫巢之前，记得去铜须营地拜访一下那儿的矮人，他们或许会给你提些建议。|n<name>，记住指挥官的话：做你应该做的……‡希利蘇斯塞納裏奧要塞的指揮官瑪爾利斯想要妳找到他心愛的納塔莉亞。妳收集到的信息表明納塔莉亞·瑪爾利斯可能在南面的雷戈蟲巢。|n在妳趕往蟲巢之前，記得去銅須營地拜訪壹下那兒的矮人，他們或許會給妳提些建議。|n<name>，記住指揮官的話：做妳應該做的……',
  }
},
[8307] = {
  {
    'Receita do deserto‡Блюдо из червей‡Wüstenrezept‡사막의 조리법‡Receta del desierto‡Receta del desierto‡Recette du désert‡沙漠食谱‡沙漠食譜',
    nil,
    'Procure informações sobre como cozinhar Carne de Verme da Areia no acampamento do Martelo do Crepúsculo, a oeste do Forte Cenariano.‡Поищите в лагере Сумеречного Молота на западе от крепости Кенария сведения о приготовлении мяса песчаных червей.‡Haltet beim Lager der Twilight-Hammer westlich von Burg Cenarius nach Informationen zum Zubereiten von Sandwurmfleisch Ausschau.‡세나리온 요새 서쪽에 있는 황혼의망치단 주둔지로 가서 미늘벌레 고기 조리법에 대한 정보를 알아내야 합니다.‡Busca información sobre cómo cocinar carne de gusano de arena en el Campamento del Martillo Crepuscular, al oeste del Fuerte Cenarion.‡Busca información sobre cómo cocinar carne de gusano de arena en el Campamento del Martillo Crepuscular, al oeste del Fuerte Cenarion.‡Cherchez des informations sur la façon de cuisiner la Chair de ver de sable, au camp du Marteau du crépuscule à l\'ouest du Fort cénarien.‡前往塞纳里奥要塞以西的暮光之锤营地，调查沙虫的烹饪方法。‡前往塞納裏奧要塞以西的暮光之錘營地，調查沙蟲的烹飪方法。',
  }
},
[8308] = {
  {
    'A carta perdida de Brann Barbabronze‡Потерянное письмо Бранна Бронзоборода‡Der verlorene Brief von Brann Bronzebeard‡브란 브론즈비어드의 잃어버린 편지‡La carta perdida de Brann Barbabronce‡La carta perdida de Brann Barbabronce‡La lettre perdue de Brann Bronzebeard‡布莱恩·铜须的信‡布萊恩·銅須的信',
    nil,
    'Leve a Carta de Brann Barbabronze para o Acampamento do Barbabronze na região sul de Silithus.‡Отнесите письмо Бранна Бронзоборода в лагерь Бронзоборода в южной части Силитуса.‡Liefert Brann Bronzebeards verlorenen Brief in Bronzebeards Lager im südlichen Silithus ab.‡실리더스 남쪽에 있는 브론즈비어드 야영지에 브란 브론즈비어드의 잃어버린 편지를 가져가야 합니다.‡Lleva la carta de Brann Barbabronce al campamento Barbabronce al sur de Silithus.‡Lleva la carta de Brann Barbabronce al campamento Barbabronce al sur de Silithus.‡Apporter la Lettre de Brann Bronzebeard au Campement de Bronzebeard dans le sud de Silithus.‡将布莱恩·铜须的信件带往希利苏斯南部的铜须营地。‡將布萊恩·銅須的信件帶往希利蘇斯南部的銅須營地。',
  }
},
[8309] = {
  {
    'À procura de glifos‡Поиски рун‡Glyphenjagd‡상형 문자 추적‡Los grabados de los glifos‡Los grabados de los glifos‡À la poursuite des glyphes‡追查雕文‡追查雕文',
    nil,
    'Rutgar Formaglifo, no Acampamento Barbabronze, em Silithus, quer que você vá a Colme\'Ashi, Colme\'Zora e Colme\'Régia e decalque os Cristais Entalhados de Glifos em cada colmeia.|nUse o Kit de Transcrição do Geólogo para tirar um decalque razoável dos glifos antigos. Fale novamente com Rutgar Formaglifo quando terminar a tarefa.‡Рутгар Знакописец из лагеря Бронзеборода в Силитусе просит отправиться в улья Аши, Зора и Регал и сделать оттиски со всех покрытых письменами кристаллов.|nЧтобы сделать приличные копии древних рун, можно воспользоваться копирующим устройством геолога. По выполнении задания вернуться к Рутгару Знакописцу.‡Rutgar Glyphshaper in Bronzebeards Lager in Silithus möchte, dass Ihr in den Bau des Ashischwarms, Bau des Zoraschwarms und Bau des Regalschwarms eindringt und dort Abpausbilder von den glyphenverzierten Kristallen anfertigt.|nBenutzt das Abschriftenset für Geologen, um Abpausbilder der uralten Glyphen herzustellen. Kehrt nach Abschluss der Aufgabe zu Rutgar Glyphshaper zurück.‡실리더스의 브론즈비어드 야영지에 루트거 글립쉐이퍼가 하이브아쉬, 하이브조라, 하이브레갈로 가서 각 곤충 집에 있는 문자가 새겨진 수정의 상형 문자 탁본을 구해 달라고 부탁했습니다.|n지질학자의 탁본 도구를 사용하여 고대 상형 문자의 탁본을 만든 후 루트거 글립쉐이퍼에게 돌아가야 합니다.‡Rutgar Glifoforma del campamento Barbabronce en Silithus quiere que vayas a Colmen\'Ashi, Colmen\'Regal y Colmen\'Zora y calques cristales en cada colmena.|nUsa el juego de calco para copiar los glifos antiguos. Vuelve a ver a Rutgar cuando hayas terminado la tarea.‡Rutgar Glifoforma del Campamento Barbabronce de Silithus quiere que recorras Colmen\'Ashi, Colmen\'Zora y Colmen\'Regal, y recuperes calcos con inscripciones de los cristales con inscripciones de cada colmena.|nUsa el estuche de transcripción de geólogo para crear una imitación verosímil de los glifos ancestrales. Habla con Rutgar Glifoforma cuando termines.‡Rutgar Glyphshaper, du campement de Bronzebeard en Silithus, veut que vous entriez dans Ruche’Ashi, Ruche’Zora et Ruche’Regal et que vous récupériez des reproductions des Cristaux ornés de glyphes dans chaque ruche.|nUtilisez la Trousse de transcription du géologue pour obtenir une copie correcte de ces glyphes antiques. Lorsque vous aurez terminé, retournez voir Rutgar Glyphshaper.‡希利苏斯铜须营地的鲁特加尔·雕石想要你前往亚什虫巢、佐拉虫巢和雷戈虫巢，从虫巢中的雕文水晶上取下拓文。|n使用地质学家的抄录工具包获取古老雕文的摹本。完成任务后回到鲁特加尔·雕石那儿。‡希利蘇斯銅須營地的魯特加爾·雕石想要妳前往亞什蟲巢、佐拉蟲巢和雷戈蟲巢，從蟲巢中的雕文水晶上取下拓文。|n使用地質學家的抄錄工具包獲取古老雕文的摹本。完成任務後回到魯特加爾·雕石那兒。',
  }
},
[8310] = {
  {
    'Quebrando o código‡Расшифровка‡Knackt den Kode‡상형 문자 판독‡Descifrar el código‡Descifrar el código‡Déchiffrer le code‡破译密码‡破譯密碼',
    nil,
    'Frankal Pontepedra, no Acampamento Barbabronze, em Silithus, quer que você obtenha um Cérebro de Silitídeo de Colme\'Zora, um Cérebro de Silitídeo de Colme\'Ashi e um Cérebro de Silitídeo de Colme\'Régia. Fale novamente com Frankal quando tiver concluído a tarefa.‡Добудьте для Франкала Каменного Моста из лагеря Бронзоборода в Силитусе мозг силитидов из ульев Зора, Аши и Регал. По выполнении задания вернитесь к Франкалу.‡Frankal Stonebridge in Bronzebeards Lager möchte, dass Ihr ihm jeweils ein Silithidengehirn des Zoraschwarms, Ashischwarms und des Regalschwarms bringt. Kehrt nach der Erfüllung Eurer Aufgabe zu Frankal zurück.‡실리더스의 브론즈비어드 야영지에 있는 프랭칼 스톤브리지가 하이브조라 실리시드 뇌, 하이브아쉬 실리시드 뇌, 하이브레갈 실리시드 뇌를 가져가야 합니다.‡Frankal Petraponte del campamento Barbabronce en Silithus quiere que le lleves 1 cerebro de silítido de Colmen\'Zora, 1 de Colmen\'Ashi y 1 de Colmen\'Regal. Vuelve a ver a Frankal cuando hayas terminado la tarea.‡Frankal Petraponte del Campamento Barbabronce de Silithus quiere que consigas un cerebro silítido de Colmen\'Zora, un cerebro silítido de Colmen\'Ashi y un cerebro silítido de Colmen\'Regal. Habla con Frankal cuando termines.‡Obtenez un Cerveau de silithide intact provenant de la Ruche’Regal. N’importe quel silithide de cette ruche fera l’affaire.‡希利苏斯铜须营地的弗兰卡·石桥想让你取回一个亚什异种虫脑、一个佐拉异种虫脑和一个雷戈异种虫脑。完成任务后回到弗兰卡那儿。‡希利蘇斯銅須營地的弗蘭卡·石橋想讓妳取回壹個亞什異種蟲腦、壹個佐拉異種蟲腦和壹個雷戈異種蟲腦。完成任務後回到弗蘭卡那兒。',
  }
},
[8311] = {
  {
    'Gostosuras da Noturnália para Jacinto!‡Тыквовинские вкусности для Джеспера!‡Schlotternachtssüßigkeiten für Jesper!‡제스퍼를 위해 할로윈 축제 사탕 모으기!‡Golosinas de Halloween para Jesper‡Golosinas de Halloween para Jesper‡Des bonbons de la Sanssaint pour Jesper !‡耶斯帕尔的万圣节糖果！‡耶斯帕爾的萬聖節糖果！',
    nil,
    'Fale com os estalajadeiros de Ventobravo, Altaforja e Darnassus, e também com Didiê Du Mocó, em Altaforja. Pague as prendas que eles pedirem em troca de gostosuras.|nLeve um Marzipã de Darnassus, uma Jujuba de Gnomeregan, um Nougat de Ventobravo e uma Balinha de Altaforja para Jacinto, que está no Orfanato de Ventobravo.‡Поговорите с хозяевами таверн в Штормграде, Стальгорне и Дарнассе, а также с Талвашом де Кисселем в Стальгорне. Выполните то, что они потребуют за предлагамые ими сладости.|nВернитесь к Джесперу в сиротский приют Штормграда и принесите ему марципан из Дарнасса, леденец из Гномрегана, нугу из Штормграда и конфету из Стальгорна.‡Sprecht mit den Gastwirten in Stormwind, Ironforge und Darnassus, sowie mit Talvash del Kissel in Ironforge. Führt ihnen vor, nach was sie im Gegenzug für die Süßigkeiten verlangen.|nKehrt zu Jesper ins Waisenhaus von Stormwind mit einem Marzipan aus Darnassus, einer Kaugummikugel aus Gnomeregan, Nugat aus Stormwind und einem Pfefferminzbonbon aus Ironforge zurück.‡스톰윈드, 아이언포지, 다르나서스의 여관 주인들, 그리고 아이언포지에 있는 탈바쉬 델 키젤과 얘기해 보십시오. 그들이 원하는 행동을 보여 주면 상으로 사탕을 받을 수 있습니다.|n스톰윈드 보육원의 제스퍼에게 스톰윈드 초코바, 놈리건 젤리, 아이언포지 박하사탕, 다르나서스 양갱을 가지고 돌아가야 합니다.‡Habla con los taberneros de Ventormenta, Forjaz y Darnassus, así como con Talvash del Kissel en Forjaz. Realiza los trucos que te pidan a cambio de tratos.|nVuelve a ver a Jesper en el orfanato de Ventormenta con un mazapán de Darnassus, una gominola de Gnomeregan un almendrado de Ventormenta y una menta de Forjaz.‡Habla con los taberneros de Ventormenta, Forjaz y Darnassus, así como con Talvash del Kissel en Forjaz. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|nVuelve a ver a Jesper frente a Ventormenta con un mazapán de Darnassus, una gominola de Gnomeregan, un almendrado de Ventormenta y una menta de Forjaz.‡Parler aux aubergistes de Stormwind, d\'Ironforge, de Darnassus, et à Talvash del Kissel à Ironforge. Accomplissez les blagues qu\'ils vous demanderont de faire en échange de bonbons.|nRetournez voir Jesper à l\'orphelinat de Stormwind avec un Massepain de Darnassus, une Boule de gomme de Gnomeregan, du Nougat de Stormwind et un Bonbon à la menthe d\'Ironforge.‡与暴风城、铁炉堡和达纳苏斯的旅店老板以及铁炉堡的塔瓦斯德·基瑟尔谈一谈。按照他们的要求做出动作，并获得他们的礼物。|n把达纳苏斯水果糖、诺莫瑞根橡皮糖、暴风城杏仁糖和铁炉堡薄荷糖交给暴风城孤儿院的耶斯帕尔。‡與暴風城、鐵爐堡和達納蘇斯的旅店老板以及鐵爐堡的塔瓦斯德·基瑟爾談壹談。按照他們的要求做出動作，並獲得他們的禮物。|n把達納蘇斯水果糖、諾莫瑞根橡皮糖、暴風城杏仁糖和鐵爐堡薄荷糖交給暴風城孤兒院的耶斯帕爾。',
  }
},
[8312] = {
  {
    'Gostosuras de Noturnália para Assustosa!‡Тыквовинские вкусности для Мальца!‡Schlotternachtssüßigkeiten für Spoops!‡스풉스를 위해 할로윈 축제 사탕 모으기!‡Golosinas de Halloween para Pupas‡Golosinas de Halloween para Pupas‡Des bonbons de la Sanssaint pour Spoops !‡斯波普斯的万圣节糖果！‡斯波普斯的萬聖節糖果！',
    nil,
    'Fale com os estalajadeiros de Orgrimmar, da Cidade Baixa e do Penhasco do Trovão, e também com Kali Remik, na Aldeia Sen\'jin. Pague as prendas que eles pedirem e receba doces como recompensa.|nLeve um Marzipã do Penhasco do Trovão, uma Jujuba Lançanegra, um Nougat de Orgrimmar e uma Balinha da Cidade Baixa para Assustosa, no Orfanato de Orgrimmar.‡Поговорите с хозяевами таверн в Оргриммаре, Подгороде и Громовом Утесе и с Кали Ремик из деревни Сен\'джин. Выполните то, что они потребуют за предлагамые ими сладости.|nВернитесь к Мальцу в сиротский приют Оргриммара и принесите ей марципан Громового Утеса, леденец племени Черного Копья, нугу из Оргриммара и конфету Подгорода.‡Sprecht mit den Gastwirten in Orgrimmar, Undercity und Thunder Bluff, sowie mit Kali Remik in Sen\'jin. Führt ihnen vor, nach was sie im Gegenzug für die Süßigkeiten verlangen.|nKehrt zu Spoops ins Waisenhaus von Orgrimmar mit einem Marzipan aus Thunder Bluff, einer Kaugummikugel der Darkspear, Nugat aus Orgrimmar und einem Pfefferminzbonbon aus Undercity zurück.‡오그리마, 언더시티, 썬더 블러프의 여관 주인들, 그리고 센진 마을에 있는 칼리 레믹과 얘기해 보십시오. 그들이 원하는 행동을 보여 주면 사탕을 받을 수 있습니다.|n오그리마 보육원에 있는 스풉스에게 썬더 블러프 양갱, 검은창 젤리, 오그리마 초코바, 언더시티 박하사탕을 가지고 돌아가야 합니다.‡Habla con los taberneros de Orgrimmar, Entrañas y Cima del Trueno, y también con Kali Remik en Poblado Sen\'jin. Realiza los trucos que te piden a cambio de las golosinas que ofrecen. Vuelve a ver a Pupas en el Orfanato de Orgrimar con un mazapán de Cima del Trueno, una gominola Lanza Negra, un almendrado de Orgrimmar y una menta de Entrañas.‡Habla con los taberneros de Orgrimmar, Entrañas y Cima del Trueno y con Kali Remik en el Valle de los Espíritus de Orgrimmar. Realiza los trucos que te pidan a cambio de los tratos que ofrecen.|nVuelve a ver a Pupas en las Ruinas de Lordaeron con un mazapán de Cima del Trueno, una gominola de Lanza Negra, un almendrado de Orgrimmar y una menta de Entrañas.‡Parler aux aubergistes d\'Orgrimmar, d\'Undercity, de Thunder Bluff, et à Kali Remik au village de Sen\'jin. Accomplissez les blagues qu\'ils vous demanderont de faire en échange de bonbons.|nRetournez voir Spoops à l\'orphelinat d\'Orgrimmar avec un Massepain de Thunder Bluff, une Boule de gomme de Darkspear, du Nougat d\'Orgrimmar et un Bonbon à la menthe d\'Undercity.‡与奥格瑞玛、幽暗城和雷霆崖的旅店老板以及森金村的卡利·雷米克谈一谈。按照他们的要求做出动作，并获得他们的礼物。|n把雷霆崖奶糖、暗矛橡皮糖、奥格瑞玛软糖和幽暗城薄荷糖交给奥格瑞玛孤儿院的斯波普斯。‡與奧格瑞瑪、幽暗城和雷霆崖的旅店老板以及森金村的卡利·雷米克談壹談。按照他們的要求做出動作，並獲得他們的禮物。|n把雷霆崖奶糖、暗矛橡皮糖、奧格瑞瑪軟糖和幽暗城薄荷糖交給奧格瑞瑪孤兒院的斯波普斯。',
  }
},
[8313] = {
  {
    'Compartilhando o conhecimento‡Наделение знаниями‡Geteiltes Wissen‡지식 공유‡Compartir el conocimiento‡Compartir el conocimiento‡Partager la connaissance‡分享知识‡分享知識',
    nil,
    'Leve a Página Rasgada de Receita para Calandrath na estalagem do Forte Cenariano.‡Принесите вырванную страницу с рецептом Каландрате в таверну крепости Кенария.‡Bringt die ausgerissene Rezeptseite zu Calandrath ins Gasthaus der Burg Cenarius.‡세나리온 요새 여관에 있는 캘랜드라스에게 찢어낸 조리법 페이지를 가져다 줘야 합니다.‡Lleva la Página de receta rasgada a Calandrath en la taberna del Fuerte Cenarion.‡Lleva la página de receta rota a Calandrath en la taberna del Fuerte Cenarion.‡Apportez la Page de recette déchirée à Calandrath, à l’auberge du Fort cénarien.‡将破碎的食谱交给塞纳里奥要塞旅店中的卡兰德拉斯。‡將破碎的食譜交給塞納裏奧要塞旅店中的卡蘭德拉斯。',
  }
},
[8314] = {
  {
    'Desvendando o mistério‡Разгадка тайны‡Des Rätsels Lösung‡밝혀지는 비밀‡Desentrañar el misterio‡Desentrañar el misterio‡Dévoiler le mystère‡揭开秘密‡揭開秘密',
    nil,
    'Rutgar Formaglifo, no Acampamento Barbabronze, quer que você entregue o Prisma de Cristal com Glifos para a Geóloga Matarriso no Forte Cenariano, que fica em Silithus.‡Рутгар Знакописец из лагеря Бронзоборода в Силитусе просит вас отнести покрытую письменами хрустальную призму геологу Ехидной в крепость Кенария.‡Rutgar Glyphshaper in Bronzebeards Lager möchte, dass Ihr Geologin Larksbane auf Burg Cenarius in Silithus das glyphenverzierte Kristallprisma bringt.‡브론즈비어드 야영지에 있는 루트거 글립쉐이퍼가 실리더스의 세나리온 요새에 있는 지질학자 락스베인에게 문자가 새겨진 수정 프리즘을 가져가 달라고 부탁했습니다.‡Rutgar Glifoforma del campamento Barbabronce quiere que lleves el prisma cristalino con glifos a la geóloga Trotuina al Fuerte Cenarion de Silithus.‡Rutgar Glifoforma en Campamento Barbabronce quiere que le entregues el prisma de cristal con inscripciones a la geóloga Trotaruina en el Fuerte Cenarion en Silithus.‡Rutgar Glyphshaper, du campement de Bronzebeard, veut que vous remettiez le Prisme cristallin orné de glyphes à la géologue Larksbane, au Fort cénarien en Silithus.‡铜须营地的鲁特加尔·雕石想让你将雕文水晶棱柱交给希利苏斯塞纳里奥要塞的地质学家拉克斯班。‡銅須營地的魯特加爾·雕石想讓妳將雕文水晶棱柱交給希利蘇斯塞納裏奧要塞的地質學家拉克斯班。',
  }
},
[8315] = {
  {
    'O chamado‡Зов‡Die Anrufung‡소환‡La llamada‡La llamada‡L\'appel‡召唤‡召喚',
    nil,
    'Geóloga Larksbane, no Forte Cenariano em Silithus, quer que você pegue o Mecanismo de Destrancamento de Cristal do Emissário Qiraji.|nVocê foi instruído a levar os Glifos de Evocação até os Ossos de Grakkarond ao sul do Forte Cenariano e desenhá-los na areia. Caso o Emissário Qiraji apareça, mate-o e recupere o Mecanismo de Destrancamento de Cristal. Fale novamente com a Geóloga Matarriso caso tenha sucesso.|nReúna uma tropa para esta missão, <name>!‡Геолог Ехидная из крепости Кенария просит добыть открыватель кристаллов у киражского посланника.|nВам следует отнести письмена зова к Костям Граккаронда, на юг от крепости Кенария, и нарисовать их на песке. Если появится киражский посланник, убейте его и заберите открыватель кристаллов. При успехе вернитесь к геологу Ехидной.|nДля выполнения задания понадобится целая армия!‡Geologin Larksbane auf Burg Cenarius in Silithus möchte, dass Ihr ihr den Kristallentriegelungsmechanismus vom Abgesandten der Qiraji beschafft.|nNehmt die Glyphen der Anrufung, begebt Euch zu den Knochen von Grakkarond südlich von Burg Cenarius und zeichnet sie dort in den Sand. Sollte der Abgesandte der Qiraji erscheinen, tötet ihn und nehmt den Kristallentriegelungsmechanismus an Euch. Kehrt anschließend zu Geologin Larksbane zurück.|nFür diese Aufgabe werdet Ihr eine kleine Armee benötigen, <Name>!‡실리더스의 세나리온 요새에 있는 지질학자 락스베인이 퀴라지 밀사에게서 수정 해독 장치를 되찾아 달라고 부탁했습니다.|n세나리온 요새 남쪽에 있는 그락카론드의 무덤에 부름의 상형 문자를 가지고 간 후 사막에서 대군주를 소환해야 합니다. 퀴라지 밀사가 나타나면 밀사를 해치우고 수정 해독 장치를 회수한 후 지질학자 락스베인에게 돌아가야 합니다.|n이 일을 완료하려면 군대를 소집해야 합니다!‡La Geóloga Trotuina del Fuerte Cenarion de Silithus quiere que consigas el mecanismo de desbloqueo de los cristales del emisario Qiraji.|nTienes que llevar los glifos a Huesos de Grakkarond, al sur del Fuerte Cenarion, y dibujarlos en la arena. Si aparece el emisario Qiraji, mátalo y coge el mecanismo de desbloqueo de los cristales. Si lo consigues, ve a ver a la geóloga Trotuina.|n¡Lleva un ejército contigo, <nombre>!‡La Geóloga Trotuina del Fuerte Cenarion de Silithus quiere que consigas el mecanismo de desbloqueo de los cristales del emisario qiraji.|nTienes que llevar los glifos a Huesos de Grakkarond, al sur del Fuerte Cenarion, y dibujarlos en la arena. Si aparece el emisario qiraji, mátalo y coge el mecanismo de desbloqueo de los cristales. Si lo consigues, ve a ver a la geóloga Trotuina.|n¡Lleva un ejército contigo, <nombre>!‡La géologue Larksbane, au Fort cénarien en Silithus, veut que vous récupériez le Mécanisme de déverrouillage du cristal sur le Maître des clés.|nElle vous a demandé de vous rendre près des Restes de Grakkarond, au sud du Fort cénarien, et d’y dessiner les glyphes d\'appel dans le sable. Si le Maître des clés apparaît, tuez-le et récupérez le Mécanisme de déverrouillage du cristal. Ensuite, si vous avez réussi, retournez voir la géologue Larksbane.|nElle vous a conseillé d’emmener une armée, <nom>.‡希利苏斯塞纳里奥要塞的地质学家拉克斯班想让你从其拉虫人使者那里取回水晶分解装置。|n你已经奉命将召唤雕文带往塞纳里奥要塞以南的格拉卡洛之骨处，将它们从沙中引出。一旦其拉虫人使者露面，就杀死它，获得水晶分解装置。成功之后回到地质学家拉克斯班那儿去。|n你必须召集一支强大的军队来完成这项任务，<name>！‡希利蘇斯塞納裏奧要塞的地質學家拉克斯班想讓妳從其拉蟲人使者那裏取回水晶分解裝置。|n妳已經奉命將召喚雕文帶往塞納裏奧要塞以南的格拉卡洛之骨處，將它們從沙中引出。壹旦其拉蟲人使者露面，就殺死它，獲得水晶分解裝置。成功之後回到地質學家拉克斯班那兒去。|n妳必須召集壹支強大的軍隊來完成這項任務，<name>！',
  }
},
[8316] = {
  {
    'Armamentos de Guerra‡Оружие войны‡Kriegsausrüstung‡전쟁 장비‡Armamentos de guerra‡Armamentos de guerra‡Armes de guerre‡军备物资‡軍備物資',
    nil,
    nil,
  }
},
[8317] = {
  {
    'Assistência culinária‡Помощь по кухне‡Küchengehilfe‡주방 보조‡Echar una mano en la cocina‡Echar una mano en la cocina‡Un coup de main à la cuisine‡下厨‡下廚',
    nil,
    'Calandrath, no Forte Cenariano, precisa de uma porção de 10 Bolinhos Defumados do Deserto.‡Каландрате из крепости Кенария необходимы 10 копченых пустынных клецок.‡Calandrath von der Burg Cenarius braucht 10 geräucherte Wüstenknödel.‡세나리온 요새의 캘랜드라스가 훈제 사막 경단 10개를 부탁했습니다.‡Calandrath, en el Fuerte Cenarion, necesita una entrega de 10 bolas de masa del desierto ahumadas.‡Calandrath, en el Fuerte Cenarion, necesita una entrega de 10 albóndigas del desierto ahumadas.‡Calandrath, du Fort cénarien, a besoin d’une fournée de 10 Boulettes du desert fumées.‡塞纳里奥要塞的卡兰德拉斯需要制作10只沙漠肉丸子。‡塞納裏奧要塞的卡蘭德拉斯需要制作10只沙漠肉丸子。',
  }
},
[8318] = {
  {
    'Comunicação secreta‡Тайные послания‡Geheime Nachrichten‡비밀 교신‡Mensajes secretos‡Mensajes secretos‡Communications secrètes‡秘密交流‡秘密交流',
    nil,
    'Traga 10 Textos Cifrados do Crepúsculo para Bor Juba Agreste no Forte Cenariano.‡Принесите 10 зашифрованных Сумрачных текстов Бору Буйногривому в крепость Кенария.‡Bringt Bor Wildmane auf Burg Cenarius 10 verschlüsselte Texte der Twilight.‡세나리온 요새에 있는 보르 와일드메인에게 암호화된 황혼의 문서 10개를 가져가야 합니다.‡Lleva 10 textos Crepusculares encriptados a Bor Bravacrín en el Fuerte Cenarion.‡Lleva 10 textos Crepusculares codificados a Bor Ferocrín en el Fuerte Cenarion.‡Apporter 10 Textes du crépuscule cryptés à Bor Wildmane au Fort cénarien.‡把10片暮光密文信交给塞纳里奥要塞的鲍尔·蛮鬃。‡把10片暮光密文信交給塞納裏奧要塞的鮑爾·蠻鬃。',
  }
},
[8319] = {
  {
    'Textos codificados do Crepúsculo‡Зашифрованные Сумеречные тексты‡Verschlüsselte Texte der Twilight‡암호화된 황혼의 문서‡Textos Crepusculares encriptados‡Textos Crepusculares codificados‡Les textes du crépuscule cryptés‡暮光密文信‡暮光密文信',
    nil,
    nil,
  }
},
[8320] = {
  {
    'Geolordes do Crepúsculo‡Геолорды из культа Сумеречного Молота‡Geolords der Twilight‡황혼의 대지술사‡Geoseñores Crepusculares‡Geoseñores Crepusculares‡Les géoseigneurs du crépuscule‡暮光地王‡暮光地王',
    nil,
    'Mate 10 Geolordes do Crepúsculo, então fale novamente com Huum Juba Agreste no Forte Cenariano.‡Убейте 10 геолордов из культа Сумеречного Молота и вернитесь к Хууму Буйногривому в крепость Кенария.‡Tötet 10 Geolords der Twilight und kehrt anschließend zu Huum Wildmane auf Burg Cenarius zurück.‡황혼의 대지술사 10명을 처치하고 세나리온 요새에 있는 후움 와일드메인에게 돌아가십시오.‡Mata 10 geoseñores Crepusculares y, a continuación, ve a ver a Huum Bravacrín en el Fuerte Cenarion.‡Mata 10 geoseñores Crepusculares y, a continuación, ve a ver a Huum Ferocrín en el Fuerte Cenarion.‡Tuer 10 Géoseigneurs du crépuscule, puis retourner voir Huum Wildmane au Fort cénarien.‡杀死10个暮光地王，然后向塞纳里奥要塞的霍姆·蛮鬃复命。‡殺死10個暮光地王，然後向塞納裏奧要塞的霍姆·蠻鬃復命。',
  }
},
[8321] = {
  {
    'Viral, o Vil‡Вайрал Подлый‡Vyral der Üble‡타락의 바이랄‡Vyral el Vil‡Vyral el Vil‡Vyral le Vil‡邪恶的维拉尔‡邪惡的維拉爾',
    nil,
    'Leve o Anel-sinete do Viral para Huum Juba Agreste no Forte Cenariano.‡Принесите перстень-печатку Вайрала Хууму Буйногривому в крепость Кенария.‡Bringt Vyrals Siegelring zu Huum Wildmane auf Burg Cenarius.‡세나리온 요새에 있는 후움 와일드메인에게 바이랄의 인장 반지를 가져다 주어야 합니다.‡Lleva el anillo con sello de Vyral a Huum Bravacrín en el Fuerte Cenarion.‡Llévale el sello de Vyral a Huum Ferocrín en el Fuerte Cenarion.‡Remettre la Chevalière de Vyral à Huum Wildmane au Fort cénarien.‡把维拉尔的徽记之戒交给塞纳里奥要塞的霍姆·蛮鬃。‡把維拉爾的徽記之戒交給塞納裏奧要塞的霍姆·蠻鬃。',
  }
},
[8322] = {
  {
    'Ovos podres‡Тухлые яйца‡Faule Eier‡썩은 달걀‡Huevos podridos‡Huevos podridos‡Les œufs pourris‡腐烂的鸡蛋‡腐爛的雞蛋',
    nil,
    'Coloque os Ovos Podres no barril de cerveja principal dentro da Estalagem da Costa Sul.‡Бросьте тухлые яйца в главную бочку с пивом в таверне Южнобережья.‡Werft die faulen Eier in den großen Braukessel im Gasthaus von Southshore.‡사우스쇼어 여관 안에 있는 맥주통에 썩은 달걀을 집어넣어야 합니다.‡Introduce los huevos podridos en el barril principal que se encuentra en la Taberna Costasur.‡Introduce los huevos podridos en el barril principal que se encuentra en la Taberna Costasur.‡Placez les Oeufs pourris dans le tonneau de bière principal de l’auberge de Southshore.‡将腐烂的鸡蛋放在南海镇旅店的主酿酒桶里。‡將腐爛的雞蛋放在南海鎮旅店的主釀酒桶裏。',
  }
},
[8323] = {
  {
    'Crentes Fiéis‡Истинно верующие‡Wahrer Glauben‡진정한 신봉자‡El creyente verdadero‡El creyente verdadero‡Les vrais croyants‡真正的信徒‡真正的信徒',
    nil,
    'O Eremita Ortell quer que você lhe traga 10 Textos Codificados do Crepúsculo.‡Принесите 10 зашифрованных Сумеречных текстов отшельнику Ортеллу.‡Ortell der Einsiedler möchte, dass Ihr ihm 10 verschlüsselte Texte der Twilight beschafft.‡은둔자 오르텔이 암호화된 황혼의 문서 10개를 가져다 달라고 부탁했습니다.‡Hermit Ortell quiere que le lleves 10 textos Crepusculares encriptados.‡Ermitaño Ortell quiere que le lleves 10 textos Crepusculares codificados.‡L\'ermite Ortell veut que vous lui apportiez 10 Textes du crépuscule cryptés.‡隐士奥泰尔要你带回10张暮光密文信。‡隱士奧泰爾要妳帶回10張暮光密文信。',
  }
},
[8324] = {
  {
    'Crendo fielmente‡Не теряя веры‡Fester Glauben‡문서 수집‡Seguir creyendo‡Seguir creyendo‡Je crois encore…‡更多的读物‡更多的讀物',
    nil,
    nil,
  }
},
[8331] = {
  {
    'Aurel Folháurea‡Аурель Золотой Лист‡Aurel Goldleaf‡오렐 골드리프‡Aurel Hojaurea‡Aurel Hojaurea‡Aurel Feuilledor‡奥蕾尔·金叶‡奧蕾爾·金葉',
    nil,
    'Fale com Aurel Folháurea no Forte Cenariano.‡Поговорите с Аурель Золотой Лист в крепости Кенария.‡Sprecht mit Aurel Goldleaf auf Burg Cenarius.‡세나리온 요새에 있는 오렐 골드리프와 얘기해야 합니다.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥要塞的奥蕾尔·金叶谈一谈。‡與塞納裏奧要塞的奧蕾爾·金葉談壹談。',
  }
},
[8332] = {
  {
    'Duques do Conselho‡Герцоги Совета‡Fürsten des Rates‡심연의 군주‡Duques del Consejo‡Los Duques del Consejo‡Les ducs du Conseil‡议会的公爵‡議會的公爵',
    nil,
    'Leve 1 Estilhaço Brilhante Grande e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 1 большой сияющий осколок и 3 талисмана Бездны.‡Bringt Aurel Goldleaf auf Burg Cenarius 1 großen glänzenden Splitter und 3 abyssische Wappen.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 1개, 심연의 문장 3개를 가져다 주어야 합니다.‡Lleva 1 fragmento grande brillante y 3 emblemas Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 1 fragmento luminoso grande y 3 blasones Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 1 Grand éclat brillant et 3 Blasons abyssaux à Aurel Goldleaf, au Fort cénarien.‡把1个大块魔光碎片和3顶深渊纹章交给塞纳利奥要塞的奥蕾尔·金叶。‡把1個大塊魔光碎片和3頂深淵紋章交給塞納利奧要塞的奧蕾爾·金葉。',
  }
},
[8333] = {
  {
    'O medalhão de posto‡Станционный медальон‡Das Standesmedallion‡황혼의 신도 계급장‡Medallón de estatus‡Medallón de estatus‡Le médaillon de statut‡身份勋章‡身份勛章',
    nil,
    nil,
  }
},
[8341] = {
  {
    'Lordes do Conselho‡Лорды Совета‡Lords des Rates‡심연의 군주 속이기‡Señores del Consejo‡Señores del Consejo‡Les seigneurs du conseil‡议会的领主‡議會的領主',
    nil,
    'Leve 5 Estilhaços Brilhantes Grandes e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 5 больших сияющих осколков и 3 перстня Бездны.‡Bringt Aurel Goldleaf auf Burg Cenarius 5 große glänzende Splitter und 3 abyssische Siegel.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 5개, 심연의 인장 3개를 가져다 주어야 합니다.‡Lleva 5 fragmentos grandes brillantes y 3 emblemas Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 5 fragmentos luminosos grandes y 3 sellos abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 5 Grands éclats brillants et 3 Chevalières abyssales à Aurel Feuilledor, au Fort cénarien.‡把5个大块魔光碎片和3个深渊徽记交给塞纳里奥要塞的奥蕾尔·金叶。‡把5個大塊魔光碎片和3個深淵徽記交給塞納裏奧要塞的奧蕾爾·金葉。',
  }
},
[8342] = {
  {
    'Anel de Suserania do Crepúsculo‡Кольцо Власти служителя Сумрака‡Herrschaftsring der Twilight‡황혼의 신도 지휘관 반지‡Anillo de nobleza Crepuscular‡Anillo de nobleza Crepuscular‡L\'anneau d\'autorité du crépuscule‡暮光徽记之戒‡暮光徽記之戒',
