    nil,
  }
},
[6801] = {
  {
    'Lokholar, o Senhor do Gelo‡Локолар Владыка Льда‡Lokholar der Eislord‡얼음군주 로크홀라‡Lokholar, el Señor del Hielo‡Lokholar, el Señor del Hielo‡Lokholar le Seigneur des Glaces‡冰雪之王洛克霍拉‡冰雪之王洛克霍拉',
