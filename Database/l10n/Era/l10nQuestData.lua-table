},
[8343] = {
  {
    'A descoberta de Folháurea‡Открытие Золотого Листа‡Goldleafs Entdeckung‡골드리프의 발견‡El descubrimiento de Hojaurea‡El descubrimiento de Hojaurea‡La découverte de Feuilledor‡金叶的发现‡金葉的發現',
    nil,
    'Fale com Aurel Folháurea no Forte Cenariano.‡Поговорите с Аурель Золотой Лист в крепости Кенария.‡Sprecht mit Aurel Goldleaf auf Burg Cenarius.‡세나리온 요새에 있는 오렐 골드리프와 얘기해야 합니다.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥要塞的奥蕾尔·金叶谈一谈。‡與塞納裏奧要塞的奧蕾爾·金葉談壹談。',
  }
},
[8348] = {
  {
    'O sinete dos duques‡Перстень герцогов‡Siegel der Fürsten‡군주의 인장‡Sellos de los Duques‡Sellos de los Duques‡La chevalière des ducs‡公爵的徽记‡公爵的徽記',
    nil,
    'Leve o Sinete Abissal para Bor Juba Agreste no Forte Cenariano.‡Принесите перстень Бездны Бору Буйногривому из крепости Кенария.‡Bringt Bor Wildmane auf Burg Cenarius das abyssische Siegel.‡세나리온 요새에 있는 보르 와일드메인에게 심연의 인장을 가져다 주어야 합니다.‡Lleva el sello Abisal a Bor Bravacrín en el Fuerte Cenarion.‡Lleva el sello abisal a Bor Ferocrín en el Fuerte Cenarion.‡Apportez la Chevalière abyssale à Bor Crin-sauvage, au Fort cénarien.‡将深渊徽记交给塞纳里奥要塞中的鲍尔·蛮鬃。‡將深淵徽記交給塞納裏奧要塞中的鮑爾·蠻鬃。',
  }
},
[8349] = {
  {
    'Bor Juba Agreste‡Бор Буйногривый‡Bor Wildmane‡보르 와일드메인‡Bor Bravacrín‡Bor Ferocrín‡Bor Crin-sauvage‡鲍尔·蛮鬃‡鮑爾·蠻鬃',
    nil,
    'Fale com Bor Juba Agreste no Forte Cenariano.‡Поговорите с Бором Буйногривым из крепости Кенария.‡Sprecht mit Bor Wildmane auf Burg Cenarius.‡세나리온 요새에 있는 보르 와일드메인과 얘기해야 합니다.‡Habla con Bor Bravacrín en el Fuerte Cenarion.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Parlez à Bor Crin-sauvage au Fort cénarien.‡与塞纳里奥要塞的鲍尔·蛮鬃谈一谈。‡與塞納裏奧要塞的鮑爾·蠻鬃談壹談。',
  }
},
[8351] = {
  {
    'Bor quer lhe falar‡Разговор с Бором‡Bor möchte Euch sprechen‡보르와의 대화‡Bor quiere hablar contigo‡Bor quiere hablar contigo‡Bor souhaite vous parler‡与鲍尔谈话‡與鮑爾談話',
    nil,
    'Fale com Bor Juba Agreste no Forte Cenariano.‡Поговорите с Бором Буйногривым из крепости Кенария.‡Sprecht mit Bor Wildmane auf Burg Cenarius.‡세나리온 요새에 있는 보르 와일드메인과 얘기해야 합니다.‡Habla con Bor Bravacrín en el Fuerte Cenarion.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Parlez à Bor Crin-sauvage au Fort cénarien.‡与塞纳里奥要塞的鲍尔·蛮鬃谈一谈。‡與塞納裏奧要塞的鮑爾·蠻鬃談壹談。',
  }
},
[8352] = {
  {
    'Cetro do conselho‡Скипетр Совета‡Szepter des Rates‡심연의 홀‡Cetro del Consejo‡Cetro del Consejo‡Le sceptre du Conseil‡议会的节杖‡議會的節杖',
    nil,
    'Leve um Cetro Abissal para Bor Juba Agreste no Forte Cenariano.‡Принесите скипетр Бездны Бору Буйногривому из крепости Кенария.‡Bringt Huum Wildmane auf Burg Cenarius ein abyssisches Szepter.‡세나리온 요새에 있는 보르 와일드메인에게 심연의 홀을 가져다 주어야 합니다.‡Lleva un Cetro Abisal a Bor Bravacrín en el Fuerte Cenarion.‡Lleva un cetro abisal a Bor Ferocrín en el Fuerte Cenarion.‡Apportez un Sceptre abyssal à Bor Crin-sauvage, au Fort cénarien.‡将一柄深渊节杖交给塞纳里奥要塞的鲍尔·蛮鬃。‡將壹柄深淵節杖交給塞納裏奧要塞的鮑爾·蠻鬃。',
  }
},
[8353] = {
  {
    'Imito uma galinha por uma balinha‡Курочка с мятой‡Hühnchengegacker für ein Pfefferminzbonbon‡닭 흉내 내고 박하사탕 얻기‡Una menta por cacarear como un pollo‡Una menta por cacarear como un pollo‡Caqueter pour un bonbon à la menthe‡学小鸡，换糖果‡學小雞，換糖果',
    nil,
    'Use a expressão /galinha diante do Estalajadeiro Aguardente e, em troca, ele lhe dará uma Balinha de Altaforja!‡Изобразите курицу для хозяина таверны Огневара.‡Spielt Gastwirt Firebrew ein Huhn vor, er wird Euch dafür ein Pfefferminzbonbon aus Ironforge geben!‡여관주인 파이어브루를 위해 닭 흉내를 내야 합니다. 그러면 아이언포지 박하사탕을 받을 수 있습니다!‡¡Cacarea como un pollo para el tabernero Brebefuego y te dará una menta de Forjaz!‡¡Cacarea como un pollo para el tabernero Brebefuego y te dará una menta de Forjaz!‡Utilisez l\'emote /poulet devant l\'aubergiste Firebrew, et vous recevrez en échange un bonbon à la menthe d\'Ironforge !‡为旅店老板洛雷·火酒模仿小鸡的动作，作为交换，你将得到一颗铁炉堡薄荷糖！‡為旅店老板洛雷·火酒模仿小雞的動作，作為交換，妳將得到壹顆鐵爐堡薄荷糖！',
  }
},
[8354] = {
  {
    'Imito uma galinha por uma balinha‡Курочка с мятой‡Hühnchengegacker für ein Pfefferminzbonbon‡닭 흉내 내고 박하사탕 얻기‡Una menta por cacarear como un pollo‡Una menta por cacarear como un pollo‡Caqueter pour un bonbon à la menthe‡学小鸡，换糖果‡學小雞，換糖果',
    nil,
    'Use a expressão /galinha diante do Estalajadeiro Ronan e, em troca, ele lhe dará uma Balinha da Cidade Baixa!‡Изобразите курицу для хозяина таверны Нормана и получите за это конфету Подгорода!‡Spielt Gastwirt Norman ein Huhn vor, er wird Euch dafür ein Pfefferminzbonbon aus Undercity geben!‡여관주인 노먼을 위해 닭 흉내를 내면 언더시티 박하사탕을 받을 수 있습니다!‡¡Cacarea como un pollo para el tabernero Norman y a cambio recibirás una menta de Entrañas!‡¡Cacarea como un pollo para el tabernero Norman y a cambio recibirás una menta de Entrañas!‡Utilisez l\'emote /poulet devant l\'aubergiste Norman, et vous recevrez en échange un bonbon à la menthe d\'Undercity !‡为旅店老板诺曼模仿小鸡的动作，作为交换，你将得到一颗幽暗城薄荷糖！‡為旅店老板諾曼模仿小雞的動作，作為交換，妳將得到壹顆幽暗城薄荷糖！',
  }
},
[8355] = {
  {
    'Café com pão, café com pão‡Плата за мармеладки‡Kaugummikugelexpress‡젤리를 주세요‡¡Truco o trato!‡¡Truco o trato!‡Boule de gomme en approche‡学火车，换糖果‡學火車，換糖果',
    nil,
    'Use a expressão /trem ao falar com Didiê Du Mocó para ganhar uma Jujuba de Gnomeregan!‡Изобразите паровозик для Талваша де Кисселя.‡Ahmt für Talvash del Kissel einen Zug nach und er wird Euch dafür eine Kaugummikugel aus Gnomeregan geben!‡탈바쉬 델 키젤을 위해 기차 소리를 내야 합니다. 그러면 놈리건 젤리를 받을 수 있습니다!‡Haz el tren para Talvash del Kissel y te dará una gominola de Gnomeregan.‡Haz el tren para Talvash del Kissel y te dará una gominola de Gnomeregan.‡Utilisez l\'emote /tchou devant Talvash del Kissel, et vous recevrez en échange une boule de gomme de Gnomeregan !‡为塔瓦斯德·基瑟尔模仿火车的声音，作为交换，你将得到一颗诺莫瑞根橡皮糖！‡為塔瓦斯德·基瑟爾模仿火車的聲音，作為交換，妳將得到壹顆諾莫瑞根橡皮糖！',
  }
},
[8356] = {
  {
    'Mamãe, sou forte!‡Поиграй мускулами!‡Muskelspiel für Nugat‡힘자랑하고 초코바 얻기‡Saca músculo a cambio de almendrados‡Saca músculo a cambio de almendrados‡Montrer ses muscles pour du nougat‡显肌肉，换糖果‡顯肌肉，換糖果',
    nil,
    'Use a expressão /muque na frente da estalajadeira Cristine para ganhar um Nougat de Ventobravo!‡Поиграйте мышцами для хозяйки таверны Аллисон и получите от нее за это нугу из Штормграда.‡Ihr müsst vor Gastwirtin Allison angeben, damit sie Euch im Gegenzug etwas vom Nugat aus Stormwind gibt!‡여관주인 앨리슨에게 힘자랑을 해야 합니다. 그러면 스톰윈드 초코바를 받을 수 있습니다!‡Saca músculos para la tabernera Allison y, a cambio, recibirás un almendrado de Ventormenta.‡Saca músculos para la tabernera Allison y, a cambio, recibirás un almendrado de Ventormenta.‡Utilisez l\'emote /frime devant l\'aubergiste Allison, et vous recevrez en échange du nougat de Stormwind !‡向旅店老板奥里森炫耀自己强壮的肌肉，作为交换，你将得到一颗暴风城杏仁糖！‡向旅店老板奧裏森炫耀自己強壯的肌肉，作為交換，妳將得到壹顆暴風城杏仁糖！',
  }
},
[8357] = {
  {
    'Tudo por um marzipã‡Танец за марципан‡Tanzen für Marzipan‡춤추고 양갱 얻기‡Un baile a cambio de mazapán‡Bailando por mazapanes‡Danser pour du massepain‡跳跳舞，换糖果‡跳跳舞，換糖果',
    nil,
    'Dance para a Estalajadeira Saliennte e, em troca, ela lhe dará Marzipã de Darnassus!‡Потанцуйте для хозяйки таверны Салиенны, и за это вы получите дарнасский марципан!‡Tanzt für Gastwirtin Saelienne und Ihr werdet im Gegenzug etwas von dem Marzipan aus Darnassus bekommen!‡여관주인 셀리에네를 위해 춤을 추어야 합니다. 그러면 다르나서스 양갱을 받을 수 있습니다!‡Baila para el tabernero Saelienne, y, a cambio, recibirás mazapán de Darnassus.‡Baila para la tabernera Saelienne, y, a cambio, recibirás mazapán de Darnassus.‡Utilisez l\'emote /danser devant l\'aubergiste Saelienne, et vous recevrez en échange du massepain de Darnassus !‡为旅店老板塞琳尼模仿跳舞动作，作为交换，你将得到一颗达纳苏斯水果糖！‡為旅店老板塞琳尼模仿跳舞動作，作為交換，妳將得到壹顆達納蘇斯水果糖！',
  }
},
[8358] = {
  {
    'Café com pão, café com pão‡Плата за леденец‡Kaugummikugelexpress‡기차소리 내고 젤리 얻기‡¡Truco o trato!‡¡Truco o trato!‡Boule de gomme en approche‡学火车，换糖果‡學火車，換糖果',
    nil,
    'Use a expressão /trem diante de Kali Remik para ganhar uma Jujuba Lançanegra!‡Изобразите паровозик перед Кали Ремик (команда /train) и получите в награду леденец племени Черного Копья!‡Ahmt für Kali Remik einen Zug nach und er wird Euch dafür eine Kaugummikugel der Darkspear geben!‡칼리 레믹을 위해 기차소리를 내면 검은창 젤리를 받을 수 있습니다!‡Haz el tren para Kali Remik y a cambio recibirás una gominola Lanza Negra.‡Haz el tren para Kali Remik y a cambio recibirás una gominola Lanza Negra.‡Utilisez l\'emote /tchou devant Kali Remik, et vous recevrez en échange une boule de gomme de Darkspear !‡为卡利·雷米克模仿火车的声音，作为交换，你将得到一颗暗矛橡皮糖！‡為卡利·雷米克模仿火車的聲音，作為交換，妳將得到壹顆暗矛橡皮糖！',
  }
},
[8359] = {
  {
    'Mamãe, sou forte!‡Поиграй мускулами!‡Muskelspiel für Nugat‡힘자랑하고 초코바 얻기‡Saca músculo a cambio de almendrados‡Saca músculo a cambio de almendrados‡Montrer ses muscles pour du nougat‡显肌肉，换糖果‡顯肌肉，換糖果',
    nil,
    'Use a expressão /muque na frente da Estalajadeira Gryshka para ganhar um Nougat de Orgrimmar!‡Поиграйте мускулами (команда /мускулы) перед хозяйкой таверны Гришкой.‡Ihr müsst vor Gastwirtin Gryshka angeben, damit sie Euch im Gegenzug etwas vom Nugat aus Stormwind gibt!‡여관주인 그리쉬카를 위해 힘자랑을 하면 오그리마 초코바를 받을 수 있습니다!‡Saca músculo para el tabernero Gryshka y te dará unos almendrados de Orgrimmar.‡Saca músculo para la tabernera Gryshka y te dará unos almendrados de Orgrimmar.‡Utilisez l\'emote /frime devant l\'aubergiste Gryshka, et vous recevrez en échange du nougat d\'Orgrimmar !‡向旅店老板格雷什卡炫耀自己强壮的肌肉，作为交换，你将得到一颗奥格瑞玛软糖！‡向旅店老板格雷什卡炫耀自己強壯的肌肉，作為交換，妳將得到壹顆奧格瑞瑪軟糖！',
  }
},
[8360] = {
  {
    'Tudo por um marzipã‡Танец за марципан‡Tanzen für Marzipan‡춤추고 양갱 얻기‡Bailando por mazapanes‡Bailando por mazapanes‡Danser pour du massepain‡跳跳舞，换糖果‡跳跳舞，換糖果',
    nil,
    'Use a expressão /dançar na frente da Estalajadeira Pala e ela lhe dará um Marzipã do Penhasco do Trovão em troca!‡Потанцуйте для хозяйки таверны Палы, и за это вы получите марципан Громового Утеса!‡Tanzt für Gastwirtin Pala und Ihr werdet im Gegenzug etwas von dem Marzipan aus Thunder Bluff bekommen!‡여관주인 팔라를 위해 춤을 추면 썬더 블러프 양갱을 받을 수 있습니다!‡Baila para la tabernera Pala y, a cambio, recibirás mazapán de Cima del Trueno.‡Baila para la tabernera Pala y, a cambio, recibirás mazapán de Cima del Trueno.‡Utilisez l\'emote /danser devant l\'aubergiste Pala, et vous recevrez en échange du massepain de Thunder Bluff !‡为旅店老板帕拉曼模仿跳舞动作，作为交换，你将得到一颗雷霆崖奶糖！‡為旅店老板帕拉曼模仿跳舞動作，作為交換，妳將得到壹顆雷霆崖奶糖！',
  }
},
[8361] = {
  {
    'Contatos abissais‡Связь с Бездной‡Abyssische Kontakte‡심연의 의회와의 교신‡Contactos Abisales‡Contactos Abisales‡Des contacts abyssaux‡深渊联络‡深淵聯絡',
    nil,
    'Bor Juba Agreste no Forte Cenariano, em Silithus, quer que você acabe com um Templário Abissal e leve um Escudo Abissal para ele como prova.‡Убейте храмовника Бездны по поручению Бора Буйногривого из крепости Кенария, что в Силитусе, и принесите в доказательство талисман Бездны.‡Bor Wildmane auf Burg Cenarius in Silithus möchte, dass Ihr einen abyssischen Templer vernichtet und ihm dessen abyssisches Wappen als Beweis für Eure Tat bringt.‡실리더스의 세나리온 요새에 있는 보르 와일드메인이 심연의 기사단을 처치하고 그 증거로 심연의 인장을 가져다 달라고 부탁했습니다.‡Bor Bravacrín, en el Fuerte Cenarion, en Silithus, quiere que destruyas a un Templario Abisal y le lleves un emblema Abisal como prueba de tu logro.‡Bor Ferocrín, del Fuerte Cenarion, en Silithus, quiere que destruyas a un Templario Abisal y le lleves un blasón Abisal como prueba de tu logro.‡Bor Wildmane, du Fort cénarien en Silithus, veut que vous détruisiez un Templier abyssal et que vous lui rameniez un Blason abyssal comme preuve de votre exploit.‡希利苏斯塞纳里奥要塞的鲍尔·蛮鬃要求你击败一名深渊圣殿骑士，并将一个深渊纹章带回来作为证明。‡希利蘇斯塞納裏奧要塞的鮑爾·蠻鬃要求妳擊敗壹名深淵聖殿騎士，並將壹個深淵紋章帶回來作為證明。',
  }
},
[8362] = {
  {
    'Escudos abissais‡Талисманы Бездны‡Abyssische Wappen‡심연의 문장‡Emblemas Abisales‡Blasones Abisales‡Les blasons abyssaux‡深渊纹章‡深淵紋章',
    nil,
    nil,
  }
},
[8363] = {
  {
    'Sinetes abissais‡Перстни Бездны‡Abyssische Siegel‡심연의 인장‡Sellos Abisales‡Sellos abisales‡Les chevalières abyssales‡深渊徽记‡深淵徽記',
    nil,
    nil,
  }
},
[8364] = {
  {
    'Cetros abissais‡Скипетры Бездны‡Abyssische Szepter‡심연의 홀‡Cetros Abisales‡Cetros Abisales‡Les sceptres abyssaux‡深渊节杖‡深淵權杖',
    nil,
    nil,
  }
},
[8365] = {
  {
    'Chapéus de pirata, io-hô!‡Пиратские шляпы‡Piratenhüte Ahoy!‡최신 유행 해적 모자‡¡Sombreros de pirata da babor!‡¡Sombreros de pirata a babor!‡Ohé, des chapeaux de pirate !‡海盗的帽子！‡海盜的帽子！',
    nil,
    'Sissi Ashando quer que você colete 20 Chapéus de Pirata dos Mares do Sul e leve-os para ela no Porto de Bondebico, em Tanaris.‡Добудьте 20 шляп пиратов Южных Морей и отнесите их Отти Кутюри в Порт Картеля в Танарисе.‡Sammelt 20 Südmeerpiratenhüte und bringt sie zurück zur eingebildeten Modeschöpferin nach Steamwheedle in Tanaris.‡타나리스의 스팀휘들 항구에 있는 거만한 의류상의 부탁으로 남쪽바다 해적 모자 20개를 모아서 가져가야 합니다.‡La modista Jonti quiere que reúnas 20 sombreros de pirata del Mar del Sur y que se los lleves al Puerto Bonvapor de Tanaris.‡La modista Jactancia quiere que reúnas 20 sombreros de pirata de los Mares del Sur y que se los lleves al Puerto Bonvapor de Tanaris.‡La Modiste arrogante veut que vous lui rapportiez 20 Chapeaux de pirate des Mers du sud au port Gentepression, en Tanaris.‡塔纳利斯热砂港的傲慢的店主要你去帮他收集20顶南海海盗帽。‡塔納利斯熱砂港的傲慢的店主要妳去幫他收集20頂南海海盜帽。',
  }
},
[8366] = {
  {
    'Recadinho dos Mares do Sul‡Покажи этим пиратам‡Gaunerei und Erpressung im Südmeer‡남쪽바다해적단 처리반‡Mamporros en el Mar del Sur‡Mamporros en los Mares del Sur‡Le racket des Mers du sud‡南海复仇‡南海復仇',
    nil,
    'O Chefe de Segurança Silvadágua do Porto de Bondebico, em Tanaris, quer que você mate 10 Piratas dos Mares do Sul, 10 Flibusteiros dos Mares do Sul, 10 Estivadores dos Mares do Sul e 10 Espadachins dos Mares do Sul.‡Начальник отдела безопасности Чепухастер из Порта Картеля в Танарисе просит убить 10 пиратов, 10 флибустьеров, 10 рабочих и 10 висельников Южных морей.‡Sicherheitschef Bilgewhizzle aus Steamwheedle in Tanaris beauftragt Euch, 10 Piraten der Südmeerfreibeuter, 10 Seeräuber der Südmeerfreibeuter, 10 Dockarbeiter der Südmeerfreibeuter und 10 Schwadroneure der Südseefreibeuter zu töten.‡타나리스의 스팀휘들 항구에 있는 보안과장 빌지위즐이 남쪽바다해적단 무법자, 약탈자, 부두일꾼, 칼잡이를 각각 10명씩 처치해 달라고 부탁했습니다.‡El jefe de seguridad Silvaina del Puerto Bonvapor de Tanaris quiere que mates a 10 piratas del Mar del Sur, 10 filibusteros del Mar del Sur, 10 portuarios del Mar del Sur y 10 aventureros del Mar del Sur.‡El jefe de seguridad Pasaquillas del Puerto Bonvapor de Tanaris quiere que mates a 10 piratas de los Mares del Sur, 10 filibusteros de los Mares del Sur, 10 portuarios de los Mares del Sur y 10 espadachines de los Mares del Sur.‡Le chef de la sécurité Bilgewhizzle du port Gentepression, en Tanaris, veut que vous tuiez 10 Pirates des Mers du sud, 10 Flibustiers des Mers du sud, 10 Portefaix des Mers du sud et 10 Bretteurs des Mers du sud.‡塔纳利斯热砂港的安全主管吉罗姆·比格维兹要你去干掉10个南海海盗、10个南海劫掠者、10个南海码头工人和10个南海流氓。‡塔納利斯熱砂港的安全主管吉羅姆·比格維茲要妳去幹掉10個南海海盜、10個南海劫掠者、10個南海碼頭工人和10個南海流氓。',
  }
},
[8367] = {
  {
    'Por grande honra‡Ради славы‡Große Ehre‡커다란 영광을 위하여‡Por Gran Honor‡Cuestión de honor‡Pour un grand honneur‡无上的荣耀‡無上的榮耀',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac, 3 Marcas de Honra da Bacia Arathi e 3 Marcas de Honra da Ravina Brado Guerreiro a um Armipotente da Horda fora dos campo de batalha.‡Принесите 3 почетных знака Альтеракской долины, 3 почетных знака Низины Арати и 3 почетных знака Ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Bring je 3 Ehrenabzeichen des Alteractals, des Arathibeckens und der Warsongschlucht zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 전쟁노래 협곡 명예 훈장, 아라시 분지 명예 훈장, 알터랙 계곡 명예 훈장을 각각 3개씩 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac, 3 marcas de Honor de la Cuenca de Arathi y 3 marcas de honor de Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Lleva 3 marcas de honor del Valle de Alterac, 3 marcas de honor de la Cuenca de Arathi y 3 marcas de honor de la Garganta Grito de Guerra a un belisario de la Horda afuera de los campos de batalla.‡Apportez 3 Marques d’honneur de la vallée d’Alterac, 3 Marques d’honneur du bassin d’Arathi et 3 Marques d’honneur du goulet des Warsong à l’un des porteguerre de la Horde, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章，3枚阿拉希盆地荣誉奖章和3枚战歌峡谷荣誉奖章交给战场外的部落战争使者。‡把3枚奧特蘭克山谷榮譽獎章，3枚阿拉希盆地榮譽獎章和3枚戰歌峽谷榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8368] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за Ущелье Песни Войны‡Schlacht der Warsongschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Warsong‡峡谷中的战斗‡峽谷中的戰鬥',
    nil,
    'Leve 3 Marcas de Honra do Brado Guerreiro a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Warsong zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d’honneur Warsong à l’un des porteguerres de la Horde, devant les champs de bataille.‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡將3枚戰歌榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8369] = {
  {
    'Invasores do Vale Alterac‡Вторжение в Альтеракскую долину‡Die Invasoren des Alteractals‡알터랙 계곡의 침략자‡Invasores del Valle de Alterac‡Invasores del Valle de Alterac‡Les envahisseurs de la vallée d\'Alterac‡奥特兰克的入侵者‡奧特蘭克的入侵者',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Альтеракской долины ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d’honneur de la vallée d’Alterac à l’un des porteguerres de la Horde, devant les champs de bataille.‡把1枚奥特兰克山谷荣誉奖章交给战场外的部落战争使者。‡把1枚奧特蘭克山谷榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8370] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라지 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d’honneur du bassin d’Arathi à l’un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8371] = {
  {
    'Esforços combinados‡В едином порыве‡Gemeinsames Bestreben‡공동의 노력‡Esfuerzos concertados‡Esfuerzos concertados‡Des efforts concertés‡共同的努力‡共同的努力',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac, 3 Marcas de Honra da Bacia Arathi e 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança fora dos campos de batalha.‡Принесите 3 почетных знака Альтеракской долины, 3 почетных знака Низины Арати и 3 почетных знака Ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Alteractals, 3 Ehrenabzeichen des Arathibeckens und 3 Ehrenabzeichen der Warsongschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장, 아라시 분지 명예 훈장, 알터랙 계곡 명예 훈장을 각각 3개씩 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac, 3 marcas de Honor de la Cuenca de Arathi y 3 marcas de honor de Grito de Guerra a un Brigadier general de la Alianza fuera de los campos de batalla.‡Entrega 1 marca de Honor de cada campo de batalla a un general de brigada de la Alianza en cualquiera de las capitales de la Alianza, Dalaran o Shattrath.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac, 3 Marques d\'honneur du bassin d\'Arathi et 3 Marques d\'honneur du goulet des Warsong à un général de brigade de l\'Alliance, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章，3枚阿拉希盆地荣誉奖章和3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡把3枚奧特蘭克山谷榮譽獎章，3枚阿拉希盆地榮譽獎章和3枚戰歌峽谷榮譽獎章交給戰場外的聯盟準將。',
  }
},
[8372] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за Ущелье Песни Войны‡Kampf um die Warsongschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Warsong‡战歌峡谷之战‡戰歌峽谷之戰',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Warsongschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de Grito de Guerra a un Brigadier general de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Warsong à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡將3枚戰歌峽谷榮譽獎章交給戰場外的聯盟準將。',
  }
},
[8373] = {
  {
    'O poder do pinho‡Сила сосен‡Die Kraft der Pinie‡소나무의 힘‡El poder del pino‡El poder del pino‡La puissance du pin‡松木的力量‡松木的力量',
    nil,
    'Use o Limpador de Bomba Fedida para remover qualquer Bomba Fedida dos Renegados atirada na Costa Sul. Fale novamente com o Sargento Hartman, na Costa Sul, quando você tiver terminado.‡Уберите любую бомбу-вонючку Отрекшихся, брошенную в Южнобережье, при помощи очистителя бомб-вонючек. По выполнении задания возвращайтесь к сержанту Дыгалу.‡Verwendet einen Stinkbombenreiniger, um alle Stinkbomben der Verlassenen zu vernichten, die hier in Southshore losgelassen wurden. Kehrt zu Sergeant Hartman in Southshore zurück, wenn Ihr fertig seid.‡구린내 폭탄 탈취제를 사용하여 사우스쇼어에 떨어진 포세이큰 구린내 폭탄을 제거한 후 하사관 허트만에게 돌아가야 합니다.‡Usa un limpiador de bombas fétidas para borrar los restos de las que los Renegados hayan lanzado en Costasur. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Usa un limpiador de bombas fétidas para borrar los restos de las que los Renegados hayan lanzado en Costasur. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Utilisez le Nettoyeur de boules puantes pour retirer les Boules puantes que les Réprouvés ont lancées sur Southshore. Retournez voir le sergent Hartman à Southshore quand vous aurez terminé.‡使用臭气弹清洁器来把散落在南海镇的亡灵臭气弹处理掉。当任务完成之后，回到南海镇的哈特曼中士那里。‡使用臭氣彈清潔器來把散落在南海鎮的亡靈臭氣彈處理掉。當任務完成之後，回到南海鎮的哈特曼中士那裏。',
  }
},
[8374] = {
  {
    'Reivindicando a Bacia Arathi‡Завоевание Низины Арати‡Inbesitznahme des Arathibeckens‡아라시 분지 공격‡Reclamo por la Cuenca de Arathi‡Reclamo por la Cuenca de Arathi‡La revendication du bassin d\'Arathi‡占领阿拉希盆地‡占領阿拉希盆地',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Brigadier general de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin d\'Arathi à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的联盟准将。‡將3枚阿拉希盆地榮譽獎章交給戰場外的聯盟準將。',
  }
},
[8375] = {
  {
    'Lembrem-se do Vale Alterac!‡Помни Альтеракскую долину!‡Vergesst das Alteractal nicht!‡잊지 말자, 알터랙 계곡!‡¡Recuerda el Valle de Alterac!‡¡Recuerda el Valle de Alterac!‡Souvenez-vous de la vallée d\'Alterac !‡铭记奥特兰克！‡銘記奧特蘭克！',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Альтеракской долины бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un Brigadier general de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à un général de brigade de l\'Alliance, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章交给战场外的联盟准将。‡把3枚奧特蘭克山谷榮譽獎章交給戰場外的聯盟準將。',
  }
},
