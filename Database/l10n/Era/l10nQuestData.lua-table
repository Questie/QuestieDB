    nil,
  }
},
[1712] = {
  {
    'Ciclonium‡Циклониан‡Cyclonian‡사이클로니안‡Cicloniano‡Ciclonio‡Cyclonien‡塞克隆尼亚‡塞克隆尼亞',
    nil,
    'Leve os itens listados no Pergaminho de Bath\'rah para Bath\'rah, o Vigia dos Ventos, em Alterac.‡Принесите Бат\'ра Ветростражу все предметы из его списка.‡Bringt die Gegenstände auf Bath\'rahs Pergament zu Bath\'rah dem Windbehüter in Alterac.‡알터랙에 있는 바람의감시자 바스라에게 바스라의 양피지에 적혀 있는 물건들을 가져가야 합니다.‡Lleva los objetos sobre el pergamino de Bath\'rah a Bath\'rah el Cazavientos en Alterac.‡Lleva los objetos sobre el papiro de Bath\'rah a Bath\'rah el Vigía del viento en Alterac.‡Apporter les objets du Parchemin de Bath\'rah à Bath\'rah la Vigie des vents à Alterac.‡把巴斯拉的羊皮纸上列出的东西交给奥特兰克的捕风者巴斯拉。‡把巴斯拉的羊皮紙上列出的東西交給奧特蘭克的捕風者巴斯拉。',
  }
},
[1713] = {
  {
    'A evocação‡Призыв‡Die Beschwörung‡소환‡La invocación‡La invocación‡L\'invocation‡召唤‡召喚',
    nil,
    'Leve o Coração Rodopiante para Bath\'rah, o Vigia dos Ventos.‡Отнести сердце Вихря Бат-ра Ветростражу.‡Bringt das Wirbelherz zu Bath\'rah dem Windbehüter.‡바람의감시자 바스라에게 소용돌이의 눈을 가져가야 합니다.‡Lleva el corazón de espirálico a Bath\'rah el Cazavientos.‡Lleva el corazón de espirálico a Bath\'rah el Vigía del viento.‡Rapporter le Cœur de tourbillon à Bath\'rah la Vigie des vents.‡将旋风之心带给捕风者巴斯拉。‡將旋風之心帶給捕風者巴斯拉。',
  }
},
[1714] = {
  {
    'Essência dos exilados‡Субстанция Изгнанников‡Essenz der Verbannung‡떠도는 정령의 정수‡Esencia del exilio‡Esencia del exilio‡Essence d\'exil‡流放精华‡流放精華',
    nil,
    nil,
  }
},
[1715] = {
  {
    'O Cordeiro Imolado‡Забитый ягненок‡Zum Geschlachteten Lamm‡어둠의 희생양‡El Cordero Degollado‡El Cordero Degollado‡L\'Agneau assassiné‡已宰的羔羊‡已宰的羔羊',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Stormwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고하십시오.‡Preséntate ante Gakin Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Stormwind.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向黑暗縛靈者加科因報到。',
  }
},
[1716] = {
  {
    'Devoradora de almas‡Пожирательница душ‡Verschlinger der Seelen‡영혼에 굶주린 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Takar, o Vidente, nos Sertões.‡Поговорите с Такаром Провидцем в Степях.‡Sprecht mit Takar dem Seher im Brachland.‡불모의 땅에 있는 현자 타카르와 대화하십시오.‡Habla con Takar el Profeta en Los Baldíos.‡Habla con Takar el Vidente en Los Baldíos.‡Parler à Takar le Prophète dans les Tarides.‡与贫瘠之地的先知塔卡尔交谈。‡與貧瘠之地的先知塔卡爾交談。',
  }
},
[1717] = {
  {
    'Convocação de Gakin‡Приглашение Гакина‡Gakins Beschwörung‡게이킨의 부름‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡加科因的召喚',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Stormwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고하십시오.‡Preséntate ante Gakin Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Stormwind.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向黑暗縛靈者加科因報到。',
  }
},
[1718] = {
  {
    'O ilhéu‡Островитянин‡Der Inselbewohner‡섬 사람‡El isleño‡El isleño‡L\'île mortelle‡岛民‡島民',
    nil,
    'Fale com Klannoc Macleod.‡Поговорите с Кланноком Маклеодом.‡Sprecht mit Klannoc Macleod.‡클라녹 맥클라우드와 대화하십시오.‡Habla con Klannoc Macleod.‡Habla con Klannoc Macleod.‡Parler à Klannoc Macleod.‡和克兰诺克·马克雷德谈一谈。‡和克蘭諾克·馬克雷德談壹談。',
  }
},
[1719] = {
  {
    'A contenda‡Побоище‡Der Ringkampf‡격투장‡La Reyerta‡La Reyerta‡La Dispute‡格斗考验‡格鬥考驗',
    nil,
    'Mate o Grande Gui. Em seguida, fale com Klannoc Macleod na Ilha da Peleja.‡Убейте Большого Билла и поговорите с Кланноком Маклеодом на Острове Битв.‡Tötet Big Will und sprecht mit Klannoc Macleod auf dem Prügel-Eiland.‡싸움꾼 윌을 꺾고 격투의 섬에 있는 클라녹 맥클라우드과 대화하십시오.‡Mata a Will el Grande y habla con Klannoc Macleod en Isla de Batalla.‡Mata a Will el Grande y habla con Klannoc Macleod en Isla de Batalla.‡Tuer le Grand Will et parler à Klannoc Macleod sur l\'île de la Dispute.‡杀掉比格维尔，然后向勇士岛的克兰诺克·马克雷德回复。‡殺掉比格維爾，然後向勇士島的克蘭諾克·馬克雷德回復。',
  }
},
[1738] = {
  {
    'Palocórdio‡Сердцедрево‡Herzholz‡사랑나무‡Duramen‡Duramen‡Le cœur du bois‡同心树‡同心樹',
    nil,
    'Obtenha o Palocórdio no Vale Gris e leve-o a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Раздобудьте в Ясеневом лесу сердцедрево и принесите его Гакину Темнопряду в Квартал магов Штормграда.‡Holt das Herzholz aus Ashenvale und bringt es zu Gakin dem Dunkelbinder im Magierviertel von Stormwind.‡잿빛 골짜기에서 사랑나무를 찾아 스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Recupera el duramen de Vallefresno y llévaselo a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Recupera el duramen de Vallefresno y llévaselo a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Trouver le Cœur du bois en Ashenvale et le porter à Gakin le Tisse-noir dans le quartier des mages de Stormwind.‡从灰谷取回同心树，把它交给暴风城法师区里的黑暗缚灵者加科因。‡從灰谷取回同心樹，把它交給暴風城法師區裏的黑暗縛靈者加科因。',
  }
},
[1739] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando o Cerne de Palocórdio, evoque e sobrepuje uma súcubo. Em seguida, devolva o Cerne de Palocórdio a Gakin, o Neromante, no Cordeiro Imolado.‡Призовите и подчините суккуба, используя сердцевину сердцедрева, затем верните сердцевину сердцедрева Гакину Темнопряду. Он будет ждать вас в "Забитом ягненке".‡Beschwört mit Hilfe des Herzholzkerns einen Sukkubus, unterwerft ihn und bringt dann den Herzholzkern zu Gakin dem Dunkelbinder im geschlachteten Lamm zurück.‡사랑나무 줄기를 사용하여 서큐버스를 소환해 제압한 후, 어둠의 희생양 선술집에 있는 대흑마법사 게이킨에게 사랑나무 줄기를 가져가야 합니다.‡Utilizando el corazón del duramen, invoca y somete a un súcubo. Después devuelve el corazón del duramen a Gakin el Presotenebra en El Cordero Degollado.‡Utilizando el corazón del duramen, invoca y somete a un súcubo. Después devuelve el corazón del duramen a Gakin el Presotenebra en El Cordero Degollado.‡Utiliser le Noyau du cœur du bois pour invoquer et soumettre une succube, puis rapporter le Noyau de cœur du bois à Gakin le Tisse-noir, à l\'Agneau assassiné.‡召唤并制服一个魅魔，然后将同心树之核还给已宰的羔羊旅店的黑暗缚灵者加科因。‡召喚並制服壹個魅魔，然後將同心樹之核還給已宰的羔羊旅店的黑暗縛靈者加科因。',
  }
},
[1740] = {
  {
    'O orbe de Soran\'ruk‡Шар Соран\'рука‡Die Kugel von Soran\'ruk‡소랜루크 수정구‡El orbe de Soran\'ruk‡El orbe de Soran\'ruk‡L\'Orbe de Soran\'ruk‡索兰鲁克宝珠‡索蘭魯克寶珠',
    nil,
    'Encontre 3 Fragmentos de Soran\'ruk e 1 Fragmento Grande de Soran\'ruk e entregue-os a Doan Karhan nos Sertões.‡Соберите 3 фрагмента Соран\'рука и 1 большой фрагмент Соран\'рука и принесите их Доану Кархану в Степи.‡Sucht 3 Soran\'ruk-Fragmente und 1 großes Soran\'ruk-Fragment und bringt sie zu Doan Karhan im Brachland.‡소랜루크 조각 3개와 큰 소랜루크 조각 1개를 찾아 불모의 땅에 있는 도안 카르한에게 가져가야 합니다.‡Encuentra 3 fragmentos de Soran\'ruk y 1 fragmento grande de Soran\'ruk y llévaselos a Doan Karhan en Los Baldíos.‡Encuentra 3 fragmentos de Soran\'ruk y 1 fragmento grande de Soran\'ruk y llévaselos a Doan Karhan en Los Baldíos.‡Trouver 3 Fragments de Soran\'ruk et 1 Grand Fragment de Soran\'ruk et les rapporter à Doan Karhan dans les Tarides.‡找到3块索兰鲁克宝珠的碎片和1块索兰鲁克宝珠的大碎片，把它们交给贫瘠之地的杜安·卡汉。‡找到3塊索蘭魯克寶珠的碎片和1塊索蘭魯克寶珠的大碎片，把它們交給貧瘠之地的杜安·卡漢。',
  }
},
[1758] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡El Libro del Conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Fale com Krom Braçoforte em Altaforja.‡Поговорите с Кромом Крепкоруком в Стальгорне.‡Sprecht mit Krom Stoutarm in Ironforge.‡아이언포지에 있는 크롬 스타우트암과 대화해야 합니다.‡Habla con Krom Brazorrecio en Forjaz.‡Habla con Krom Brazorrecio en Forjaz.‡Parler à Krom Stoutarm à Ironforge.‡与铁炉堡的克罗姆·粗臂谈一谈。‡與鐵爐堡的克羅姆·粗臂談壹談。',
  }
},
[1778] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Battleforge in Ironforge.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Battleforge à Ironforge.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談壹談。',
  }
},
[1779] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Pegue o Símbolo da Vida e fale com Muiredon Beloforja em Altaforja.‡Возьмите знак жизни и поговорите с Майридоном Кузнебоем в Стальгорне.‡Nehmt das Symbol des Lebens und sprecht mit Muiredon Battleforge in Ironforge.‡생명의 징표를 가지고 가서 아이언포지에 있는 뮈레돈 배틀포지와 대화하십시오.‡Coge el Símbolo de la Vida y habla con Muiredon Forjabatalla. Está en Forjaz.‡Coge el Símbolo de la Vida y habla con Muiredon Forjabatalla. Está en Forjaz.‡Prendre le Symbole de vie et parler à Muiredon Battleforge à Ironforge.‡带上生命符记，和铁炉堡的穆里顿·热炉谈一谈。‡帶上生命符記，和鐵爐堡的穆裏頓·熱爐談壹談。',
  }
},
[1780] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[1781] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida para Gazin Tenorm em Ventobravo.‡Отнесите знак Жизни Газину Тенорму в Штормград.‡Bringt das Symbol des Lebens zu Gazin Tenorm in Stormwind.‡스톰윈드에 있는 가쟁 테놈에게 생명의 징표를 가져가야 합니다.‡Lleva el Símbolo de la Vida a Gazin Tenorm a Ventormenta.‡Lleva el Símbolo de la Vida a Gazin Tenorm a Ventormenta.‡Porter le Symbole de vie à Gazin Tenorm à Stormwind.‡把生命符记带给暴风城的贾森·坦诺姆。‡把生命符記帶給暴風城的賈森·坦諾姆。',
  }
},
[1782] = {
  {
    'A armadura do Furen‡Доспехи Фьюрена‡Furens Rüstung‡푸렌의 갑옷‡La armadura de Furen‡La armadura de Furen‡L\'armure de Furen‡弗伦的铠甲‡弗倫的鎧甲',
    nil,
    nil,
  }
},
[1783] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida e ressuscite Narm Faulk em Dun Morogh.‡Возьмите знак Жизни и воскресите Нарма Фолка в Дун Мороге.‡Nehmt das Symbol des Lebens und erweckt Narm Faulk in Dun Morogh wieder zum Leben.‡생명의 징표를 가져가서 던 모로에 있는 나름 폴크를 되살려야 합니다.‡Coge el Símbolo de la Vida y resucita a Narm Faulk en Dun Morogh.‡Coge el Símbolo de la Vida y resucita a Narm Faulk en Dun Morogh.‡Prendre le Symbole de vie et ressusciter Narm Faulk dans Dun Morogh.‡使用生命符记复活丹莫罗的纳姆·法奥克。‡使用生命符記復活丹莫羅的納姆·法奧克。',
  }
},
[1784] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Obtenha uma Carta de Ferro Negro com os anões Ferro Negro perto do Lago Helm e fale novamente com Muiredon Beloforja em Altaforja.‡Добудьте приказ клана Черного Железа у дворфов из клана Черного Железа возле Хельмова Ложа и вернитесь к Майридону Кузнебою в Стальгорн.‡Beschafft ein Dunkeleisenmanuskript von den Dunkeleisenzwergen beim Helmsbedsee und kehrt zu Muiredon Battleforge in Ironforge zurück.‡투구바닥 호수 근처에 있는 검은무쇠단 드워프들에게서 검은무쇠단 문서를 빼앗아 아이언포지에 있는 뮈레돈 배틀포지에게 돌아가십시오.‡Consigue un guión Hierro Negro de los enanos Hierro Negro que están cerca de Helm y luego vuelve a Forjaz y busca a Muiredon Forjabatalla.‡Consigue una misiva Hierro Negro de los enanos Hierro Negro que están cerca de Helm y luego vuelve a Forjaz y busca a Muiredon Forjabatalla.‡Récupérer un Script des nains Sombrefer près du lac du Lit d\'Helm et le rapporter à Muiredon Battleforge à Ironforge.‡从盔枕湖附近的黑铁矮人那里取回一份黑铁手稿，把它交给铁炉堡的穆里顿·热炉。‡從盔枕湖附近的黑鐵矮人那裏取回壹份黑鐵手稿，把它交給鐵爐堡的穆裏頓·熱爐。',
  }
},
[1785] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡El Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Battleforge in Ironforge.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Battleforge à Ironforge.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談壹談。',
  }
},
[1786] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida e ressuscite Henze Faulk em Elwynn.‡Возьмите знак Жизни, пойдите в Элвиннский лес и воскресите Хенза Фолка.‡Nehmt das Symbol des Lebens und erweckt Henze Faulk in Elwynn wieder zum Leben.‡생명의 징표를 가져가서 엘윈에 있는 헨즈 폴크를 되살려야 합니다.‡Coge el Símbolo de la Vida y resucita a Henze Faulk en Elwynn.‡Coge el Símbolo de la Vida y resucita a Henze Faulk en Elwynn.‡Apporter le Symbole de vie et ressusciter Henze Faulk à Elwynn.‡把生命符记带到艾尔文森林的英烈碑去，复活亨兹·法奥克。‡把生命符記帶到艾爾文森林的英烈碑去，復活亨茲·法奧克。',
  }
},
[1787] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Obtenha uma Carta de Défias dos Teurgos Proscritos em Elwynn e fale novamente com Gazin Tenorm em Ventobravo.‡Найдите волшебников из Братства Справедливости в Элвиннском лесу, заберите у них бумаги и отнести Газину Тенорму в Штормград.‡Beschafft ein Manuskript der Defias von den abtrünnigen Hexern der Defias in Elwynn und kehrt zu Gazin Tenorm in Stormwind zurück.‡엘윈 숲에 있는 데피아즈단 견습마술사들에게서 데피아즈단 문서를 빼앗아 스톰윈드에 있는 가쟁 테놈에게 가져가야 합니다.‡Recupera 1 pergamino Defias de los zahoríes bribones Defias de Elwynn y vuelve con Gazin Tenorm a Ventormenta.‡Recupera 1 misiva Defias de los zahoríes bribones Defias de Elwynn y vuelve con Gazin Tenorm a Ventormenta.‡Retrouver un Script Défias sur les Sorciers-voleurs défias d\'Elwynn et le rapporter à Gazin Tenorm à Stormwind.‡从石碑湖小岛上的迪菲亚巫师手中拿到迪菲亚手稿，把它交给暴风城的贾森·坦诺姆。‡從石碑湖小島上的迪菲亞巫師手中拿到迪菲亞手稿，把它交給暴風城的賈森·坦諾姆。',
  }
},
[1788] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Найдите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[1789] = {
  {
    'O símbolo da vida‡Знак Жизни‡Das Symbol des Lebens‡생명의 징표‡El Símbolo de la Vida‡El Símbolo de la Vida‡Le Symbole de vie‡生命符记‡生命符記',
