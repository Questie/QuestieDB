[2751] = {
  {
    'Muralhas bárbaras‡Варварские доспехи‡Barbarische Waffenschmiedekunst‡야만전사의 갑옷‡Almenas barbáricas‡Almenas barbáricas‡Remparts barbares‡野人装甲‡野人裝甲',
    nil,
    'Leve duas Braçadeiras Decoradas de Bronze, duas Montantes de Bronze e duas Garras Afiadas para Orokk Omosh em Orgrimmar.‡Принесите 2 узорчатых бронзовых боевых браслета, 2 бронзовых больших меча и 2 острых когтя Орокку Омошу в Оргриммар.‡Bringt 2 gemusterte bronzene Armschienen, 2 bronzene Großschwerter und 2 scharfe Klauen zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 청동 무늬 팔보호구 2개, 청동 대검 2개, 날카로운 발톱 2개를 가져다주어야 합니다.‡Lleva 2 brazales de bronce estampados, 2 espadas magnas de bronce y 2 garras afiladas a Orokk Omosh a Orgrimmar.|n‡Lleva 2 brazales de bronce estampados, 2 espadas magnas de bronce y 2 garras afiladas a Orokk Omosh a Orgrimmar.‡Apporter 2 Brassards guillochés en bronze, 2 Glaives en bronze et 2 Griffes aiguisées à Orokk Omosh à Orgrimmar.‡将2副青铜花纹护腕、2把青铜巨剑和2只锋利的爪子交给奥格瑞玛的奥罗克·沃姆什。‡將2副青銅花紋護腕、2把青銅巨劍和2只鋒利的爪子交給奧格瑞瑪的奧羅克·沃姆什。',
  }
},
[2752] = {
  {
    'Em brafoneiras de ferro‡За железными наплечниками‡Über Eisenschulterstücke‡강철 어깨갑옷‡Espaldares de hierro‡Espaldares de hierro‡Épaulettes en fer‡铁肩铠‡鐵肩鎧',
    nil,
    'Leve quatro Machados de Batalha de Bronze e quatro Martelos de Guerra de Bronze para Orokk Omosh em Orgrimmar.‡Принесите Орокку Омошу в Оргриммар 4 бронзовых боевых топора и 4 бронзовых боевых молота.‡Bringt 4 bronzene Streitäxte und 4 bronzene Kriegshämmer zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 청동 전투도끼 4개와 청동 전투해머 4개를 가져다주어야 합니다.‡Lleva 4 hachas de batalla de bronce y 4 martillos de guerra de bronce a Orokk Omosh a Orgrimmar.‡Lleva 4 hachas de batalla de bronce y 4 martillos de guerra de bronce a Orokk Omosh a Orgrimmar.‡Apporter 4 Haches de guerre en bronze et 4 Marteaux de guerre en bronze à Orokk Omosh à Orgrimmar.‡将4把青铜战斧和4把青铜战锤交给奥格瑞玛的奥罗克·沃姆什。‡將4把青銅戰斧和4把青銅戰錘交給奧格瑞瑪的奧羅克·沃姆什。',
  }
},
[2753] = {
  {
    'Esmagado sob os calcanhares‡Тяжелая поступь‡In den Boden getrampelt‡발 밑의 적‡¡Aplástalos!‡¡Aplástalos!‡Piétinés‡踩在脚下‡踩在腳下',
    nil,
    'Leve quatro Elmos Verdes de Ferro, quatro Braçadeiras Verdes de Ferro e duas Perneiras Verdes de Ferro para Orokk Omosh em Orgrimmar.‡Принесите 4 зеленых железных шлема, 4 пары зеленых железных наручей и 2 пары зеленых железных поножей Орокку Омошу в Оргриммар.‡Bringt 4 grüne Eisenhelme, 4 grüne Eisenarmschienen und 2 grüne Eisengamaschen zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 녹색 철제 투구 4개, 녹색 철제 팔보호구 4개, 녹색 철제 다리보호구 2개를 가져다주어야 합니다.‡Lleva 4 yelmos de hierro verde, 4 brazales de hierro verdes y 2 pares de leotardos de hierro verdes a Orokk Omosh a Orgrimmar.‡Lleva 4 yelmos de hierro verde, 4 brazales de hierro verdes y 2 pares de leotardos de hierro verdes a Orokk Omosh a Orgrimmar.‡Apporter 4 Heaumes en fer émeraude, 4 Bracelets en fer émeraude et 2 Jambières en fer émeraude à Orokk Omosh à Orgrimmar.‡将4顶绿铁头盔、4副绿铁护腕和4副绿铁护腿交给奥格瑞玛的奥罗克·沃姆什。‡將4頂綠鐵頭盔、4副綠鐵護腕和4副綠鐵護腿交給奧格瑞瑪的奧羅克·沃姆什。',
  }
},
[2754] = {
  {
    'Trompas de frenesi‡Рога безумия‡Hörner der Raserei‡광란의 뿔‡Cuernos de frenesí‡Cuernos de frenesí‡Les cornes de Frénésie‡疯狂之角‡瘋狂之角',
    nil,
    'Leve dois Malhos de Ferro Maciço, duas Botas de Bronze Prateado e duas Manoplas de Bronze Prateado para Orokk Omosh em Orgrimmar.‡Принесите Орокку Омошу в Оргриммар 2 твердых железных кувалды, 2 пары посеребренных бронзовых сапог и 2 пары посеребренных бронзовых рукавиц.‡Bringt 2 robuste Eisenschlägel, 2 bronzene Stiefel mit Versilberung und 2 bronzene Stulpen mit Versilberung zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 튼튼한 철제 마울 2개, 은도금한 청동 장화 2개, 그리고 은도금한 청동 장갑 2개를 가져다주어야 합니다.‡Lleva 2 grandes mazas de hierro sólido, 2 botas de bronce bañadas en plata y 2 guanteletes de bronce bañados en plata a Orokk Omosh en Orgrimmar.‡Lleva 2 grandes mazas de hierro sólido, 2 botas de bronce bañadas en plata y 2 guanteletes de bronce bañados en plata a Orokk Omosh en Orgrimmar.‡Apporter 2 Solides maillets en fer, 2 Bottes en bronze argenté et 2 Gantelets en bronze argenté à Orokk Omosh à Orgrimmar.‡将2只结实的铁锤、2双镀银青铜战靴和2副镀银青铜手套交给奥格瑞玛的奥罗克·沃姆什。‡將2只結實的鐵錘、2雙鍍銀青銅戰靴和2副鍍銀青銅手套交給奧格瑞瑪的奧羅克·沃姆什。',
  }
},
[2755] = {
  {
    'Alegria dos Omosh‡Радости Омоша‡Freude der Omoshs‡오모쉬의 기쁨‡Las alegrías de los Omosh‡Las alegrías de los Omosh‡Les joies des Omosh‡沃姆什的喜悦‡沃姆什的喜悅',
    nil,
    'Observe e aprenda a Dancinha da Alegria dos Omosh.‡Научитесь танцу Радости Омошей.‡Seht zu und lernt den Freudentanz der Omoshs.‡오모쉬가 추는 기쁨의 춤을 보고 배워야 합니다.‡Mira la danza de la alegría de los Omosh.‡Mira la danza de la alegría de los Omosh.‡Regarder et apprendre la Danse de joie des Omosh.‡观察并学习沃姆什的喜悦之舞。‡觀察並學習沃姆什的喜悅之舞。',
  }
},
[2756] = {
  {
    'Como antigamente‡Старые обычаи‡Die alten Traditionen‡과거의 방식‡Los viejos hábitos‡Los viejos hábitos‡Les vieilles voies‡古老的技艺‡古老的技藝',
    nil,
    'Leve 4 Peitorais de Aço e 4 Elmos de Placa de Aço para Aturk, o Bigorna, em Orgrimmar.‡Принесите 4 стальные кирасы и 4 стальных латных шлема Атурку Наковальне в Оргриммар.‡Bringt 4 Stahlbrustplatten und 4 Stahlplattenhelme zu Aturk dem Amboss in Orgrimmar.‡오그리마에 있는 무쇠모루 아투르크에게 강철 흉갑 4개와 강철 판금 투구 4개를 가져다주어야 합니다.‡Lleva 4 corazas de acero y 4 yelmos de placas de acero a Aturk el Yunque a Orgrimmar.|n‡Lleva 4 corazas de acero y 4 yelmos de placas de acero a Aturk el Yunque a Orgrimmar.‡Apporter 4 Cuirasses en acier et 4 Heaumes en plaques d\'acier à Aturk l\'Enclume à Orgrimmar.‡将4套钢质胸甲和4顶钢质头盔交给奥格瑞玛的铁砧阿图尔克。‡將4套鋼質胸甲和4頂鋼質頭盔交給奧格瑞瑪的鐵砧阿圖爾克。',
  }
},
[2757] = {
  {
    'Angra do Butim ou Mina de Mithril?‡Вперед, в Пиратскую бухту!‡Auf nach Booty Bay!‡무법항으로!‡¡Bahía del Botín o nada!‡¡Bahía del Botín o nada!‡Baie-du-Butin ou la mort !‡藏宝海湾之旅！‡藏寶海灣之旅！',
    nil,
    'Fale com McGavan na Angra do Butim.‡Поговорите с Макгеваном в Пиратской бухте.‡Sprecht mit McGavan in Booty Bay.‡무법항에 있는 맥개번과 대화하십시오.‡Habla con MacGavan en Bahía del Botín.‡Habla con McGavan en Bahía del Botín.‡Aller voir McGavan à Baie-du-Butin.‡与藏宝海湾的马克迦文谈一谈。‡與藏寶海灣的馬克迦文談壹談。',
  }
},
[2758] = {
  {
    'As origens da ferraria‡Происхождение кузнечного искусства‡Die Herkunft der Schmiedekunst‡대장기술의 근원‡El origen de la herrería‡El origen de la herrería‡Les origines de la forge‡锻造的本源‡鍛造的本源',
    nil,
    'Leve 6 Braçadeiras de Escama Dourada para Marcelo, o Martelo em Ventobravo.‡Принесите 6 пар золотых чешуйчатых наручей Ханку Молоту в Штормград.‡Bringt 6 goldene Schuppenarmschienen zu Hank dem Hammer in Stormwind.‡스톰윈드에 있는 쇠망치 행크에게 황금 미늘 팔보호구 6개를 가져가야 합니다.‡Lleva seis brazales de escamas doradas a Hank el Martillo en Ventormenta.‡Lleva seis brazales de escamas doradas a Hank el Martillo en Ventormenta.‡Apporter 6 Brassards en écailles dorées à Hank le Marteau à Stormwind.‡将6副金鳞护腕交给暴风城的巨锤汉克。‡將6副金鱗護腕交給暴風城的巨錘漢克。',
  }
},
[2759] = {
  {
    'Em busca de Galvan‡В поисках Гальвана‡Auf der Suche nach Galvan‡갈반을 찾아서‡Buscando a Galvan‡Buscando a Galvan‡À la recherche de Galvan‡寻找加尔文‡尋找加爾文',
    nil,
    'Fale com McGavan na Angra do Butim.‡Поговорите с Макгеваном в Пиратской бухте.‡Sprecht in Booty Bay mit McGavan.‡무법항에 있는 맥개번과 대화해야 합니다.‡Habla con McGavan en la Bahía del Botín.‡Habla con McGavan en Bahía del Botín.‡Aller voir McGavan à Baie-du-Butin.‡与藏宝海湾的马克迦文谈一谈。‡與藏寶海灣的馬克迦文談壹談。',
  }
},
[2760] = {
  {
    'A Ordem do Mithril‡Орден Мифрила‡Der Mithrilorden‡미스릴 대장조합‡El pedido de mitril‡La Orden del mitril‡L\'Ordre du mithril‡秘银会‡秘銀會',
    nil,
    'Fale com Galvan, o Antigo, na Selva do Espinhaço.‡Поговорите с Гальваном Древним в Тернистой долине.‡Sprecht mit Galvan dem Alten im Schlingendorntal.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반과 대화해야 합니다.‡Habla con Galvan el Ancestro en la Vega de Tuercespina.‡Habla con Galvan el Antiguo en la Vega de Tuercespina.‡Aller voir Galvan l\'Ancien dans la vallée de Strangleronce.‡和荆棘谷的加尔文谈一谈。‡和荊棘谷的加爾文談壹談。',
  }
},
[2761] = {
  {
    'Fundido e desfundido‡Плавим, не плавим, плавим, не плавим…‡Hier verhütten, da verhütten‡대장기술과 채광‡Funde o no funde‡Funde o no funde‡Ça fond, ça ne fond pas‡铁匠必修课‡鐵匠必修課',
    nil,
    'Leve 40 Barras de Mithril e 40 Barras de Ferro para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок железных слитков Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 40 Eisenbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴와 철 주괴를 각각 40개씩 가져가야 합니다.‡Lleva cuarenta lingotes de mitril y cuarenta lingotes de veraplata a Galvan el Ancestro en Tuercespina.‡Lleva cuarenta barras de mitril y cuarenta barras de hierro a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 40 Barres de fer à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和40块铁锭交给荆棘谷的加尔文。‡將40塊秘銀錠和40塊鐵錠交給荊棘谷的加爾文。',
  }
},
[2762] = {
  {
    'O grande embuste prateado‡Обманное серебро‡Der große silberne Betrüger‡훌륭한 가짜배기 은‡La veraplata no es verídica‡La veraplata no es verídica‡Le vif-argent n’est pas de l\'argent‡白花花的银子‡白花花的銀子',
    nil,
    'Leve 40 Barras de Mithril e 5 Barras de Veraprata para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок слитков истинного серебра Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 5 Echtsilberbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 진은 주괴 5개를 가져가야 합니다.‡Lleva cuarenta lingotes de mitril y cinco lingotes de veraplata a Galvan el Ancestro en Tuercespina.‡Lleva cuarenta barras de mitril y cinco barras de veraplata a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 5 Barres de vrai-argent à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和5块真银锭交给荆棘谷的加尔文。‡將40塊秘銀錠和5塊真銀錠交給荊棘谷的加爾文。',
  }
},
[2763] = {
  {
    'A arte de imbuir‡Могущество камней‡Die Kunst der Magieerfüllung‡보석 채취‡El arte de imbuir‡El arte de imbuir‡L\'art de l\'imprégnation‡灌魔工艺‡灌魔工藝',
    nil,
    'Leve 40 Barras de Mithril e 4 Citrinos para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и 4 цитрина Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 4 Citrine.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 황수정 4개를 가져가야 합니다.‡Lleva cuarenta lingotes de mitril y cuatro citrinos a Galvan el Ancestro en Tuercespina.‡Lleva cuarenta barras de mitril y cuatro citrinos a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 4 Citrines à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和4块黄水晶交给荆棘谷的加尔文。‡將40塊秘銀錠和4塊黃水晶交給荊棘谷的加爾文。',
  }
},
[2764] = {
  {
    'O melhor pupilo de Galvan‡Лучший ученик Гальвана‡Galvans bester Schüler‡갈반의 수제자‡El mejor alumno de Galvan‡El mejor alumno de Galvan‡Le meilleur disciple de Galvan‡加尔文的得意门生‡加爾文的得意門生',
    nil,
    'Fale com Trenton Lumartelo em Geringontzan.‡Поговорите с Трентоном Молотом Света из Прибамбасска.‡Sprecht in Gadgetzan mit Trenton Lighthammer.‡가젯잔에 있는 트렌튼 라이트해머와 대화해야 합니다.‡Habla con Trenton Mazaligera en Gadgetzan.‡Habla con Trenton Mazaligera en Gadgetzan, en Tanaris.‡Parler à Trenton Lighthammer à Gadgetzan.‡和加基森的特伦顿·轻锤谈一谈。‡和加基森的特倫頓·輕錘談壹談。',
  }
},
[2765] = {
  {
    'Ferreiro perito!‡Кузнец-умелец!‡Schmiedkunstexperte!‡고급 대장기술‡¡Experto herrero!‡¡Experto herrero!‡Maître Forgeron !‡锻造专家!‡鍛造專家!',
    nil,
    'Pegue sua recompensa com Galvan, o Antigo!‡Получите награду у Гальвана Древнего!‡Fordert Eure Belohnung von Galvan dem Alten ein!‡전설의 대장장이 갈반에게서 보상을 받으십시오.‡Reclama tu recompensa a Galvan el Ancestro.‡Reclama tu recompensa a Galvan el Antiguo.‡Réclamez votre récompense à Galvan l\'Ancien !‡到加尔文那里拿取报酬！‡到加爾文那裏拿取報酬！',
  }
},
[2766] = {
  {
    'Encontre o OOX-22/FE!‡Найти ККX-22/FE!‡Findet OOX-22/FE!‡OOX-22/FE 수색‡¡Encuentra a OOX-22/FE!‡¡Encuentra a OOX-22/FE!‡Trouvez OOX-22/FE !‡寻找OOX-22/FE！‡尋找OOX-22/FE！',
    nil,
    'Pegue o transmissor de emergência para o robô teleguiado de Olhatorto na caverna próxima ao Vale dos Abomináveis.‡Отнесите аварийный маяк к автономному роботу Карлса, в пещеру рядом с Долиной Свирепого Утеса.‡Bringt das Notrufsignal zu Oglethorpes Leitroboter in einer Höhle in der Nähe des Wildschrammtals.‡거친흉터 골짜기에 있는 오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Lleva el localizador de emergencia al robot mensajero de Oglethorpe a una cueva que hay cerca de Vega Cicatriz Feral.‡Lleva el localizador de emergencia al robot mensajero de Oglethorpe a una cueva que hay cerca de Vega Cicatriz Feral.‡Placer la balise de détresse dans le robot d\'Oglethorpe qui se trouve dans une caverne près du val des Griffes farouches.‡把定位器带到深痕谷附近山洞中的奥格索普的导航机器人旁边。‡把定位器帶到深痕谷附近山洞中的奧格索普的導航機器人旁邊。',
  }
},
[2767] = {
  {
    'Resgate o OOX-22/FE!‡Спасти ККX-22/FE!‡Die Rettung von OOX-22/FE‡OOX-22/FE 구출!‡¡Escolta a OOX-22/FE!‡¡Escolta a OOX-22/FE!‡Sauvez OOX-22/FE !‡拯救OOX-22/FE！‡拯救OOX-22/FE！',
    nil,
    'Escolte o OOX-22/FE até a doca ao longo da Costa Esquecida, depois apresente-se a Olhatorto Obnótico na Angra do Butim.‡Проводите OOX-22/FE в порт на Забытом Берегу, затем сообщите об этом Карлсу Пропеллерзу в Пиратской бухте.‡Eskortiert OOX-22/FE zum Dock an der Vergessenen Küste und meldet Euch dann bei Oglethorpe Obnoticus in Booty Bay.‡잊혀진 해안에 있는 부두까지 OOX-22/FE를 호위해 간 후 무법항에 있는 오글소프 오브노티쿠스에게 보고해야 합니다.‡Escolta a OOX-22/FE al embarcadero de La Costa Olvidada y preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escolta a OOX-22/FE hasta el muelle de La Costa Olvidada, y preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escorter OOX-22/FE au dock le long de la Côte oubliée, puis faire votre rapport à Oglethorpe Obnoticus à Baie-du-Butin.‡将OOX-22/FE护送到被遗忘的海岸上的码头，然后向藏宝海湾的奥格索普·奥布诺提斯报告。‡將OOX-22/FE護送到被遺忘的海岸上的碼頭，然後向藏寶海灣的奧格索普·奧布諾提斯報告。',
  }
},
[2768] = {
  {
    'Bastão divinomático‡Изыскательский стержень‡Wünschel-mato-Rute‡자동 탐사막대‡Cetro Divinomático‡Vara divinomática‡Le bâtonnet divino-matic‡探水棒‡探水棒',
    nil,
    'Leve o Bastão Divinomático ao Engenheiro-chefe Silvadágua em Geringontzan.‡Принесите изыскательский cтержень главному инженеру Чепухастеру в Прибамбасск.‡Bringt die Wünschel-mato-Rute nach Gadgetzan zu Chefingenieur Bilgewhizzle.‡가젯잔에 있는 선임기술자 빌지위즐에게 자동 탐사막대를 가져가야 합니다.‡Lleva el Cetro Divinomático al ingeniero jefe Silvaina en Gadgetzan.‡Lleva la vara divinomática al ingeniero jefe Pasaquillas en Gadgetzan.‡Rapporter le Bâtonnet divino-matic à l\'Ingénieur en chef Bilgewhizzle, à Gadgetzan.‡把探水棒交给加基森的首席工程师沙克斯·比格维兹。‡把探水棒交給加基森的首席工程師沙克斯·比格維茲。',
  }
},
[2769] = {
  {
    'Os irmãos Latafuso‡Братья Латунный Болт‡Die Brüder Brassbolt‡브라스볼츠 형제‡Los hermanos Pernolatón‡Los hermanos Pernolatón‡Les frères Brassbolts‡铜栓兄弟‡銅栓兄弟',
    nil,
    'Fale com Capu Latafuso no Salar Cintilante.‡Поговорите с Виззлом Медноштифом на Мерцающей равнине.‡Sprecht mit Wizzle Brassbolts in der schimmernden Ebene.‡소금 평원에 있는 위즐 브라스볼츠와 대화하십시오.‡Habla con Wizzle Pernolatón en El Desierto de Sal.‡Habla con Wizzle Pernolatón en El Desierto de Sal.‡Parler à Wizzle Brassbolts dans les Salines.‡和闪光平原的维兹尔·铜栓谈一谈。‡和閃光平原的維茲爾·銅栓談壹談。',
  }
},
[2770] = {
  {
    'Gahz\'rilla‡Газ\'рилла‡Gahz\'rilla‡가즈릴라‡Gahz\'rilla‡Gahz\'rilla‡Gahz\'rilla‡加兹瑞拉‡加茲瑞拉',
    nil,
    'Leve a Escama Eletrificada de Gahz\'rilla para Capu Latafuso no Salar Cintilante.‡Принесите искрящую чешую Газ\'риллы Виззлу Медноштифу на Мерцающую равнину.‡Bringt Wizzle Brassbolts in der schimmernden Ebene Gahz\'rillas energiegeladene Schuppe.‡소금 평원에 있는 위즐 브라스볼츠에게 가즈릴라의 전기 비늘을 가져가야 합니다.‡Llévale la escama electrificada de Gahz\'rilla a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale la escama electrificada de Gahz\'rilla a Wizzle Pernolatón, que está en El Desierto de Sal.‡Rapporter les Ecailles électrifiées de Gahz\'rilla à Wizzle Brassbolts dans les Salines.‡把加兹瑞拉的鳞片交给闪光平原的维兹尔·铜栓。‡把加茲瑞拉的鱗片交給閃光平原的維茲爾·銅栓。',
  }
},
[2771] = {
  {
    'A ótima cabeça sobre os ombros‡Голова на плечах‡Ein schlauer Kopf auf den Schultern‡지혜로운 스승‡La cabeza sobre los hombros‡La cabeza sobre los hombros‡Une tête bien faite sur les épaules‡罩帽和护肩‡罩帽和護肩',
    nil,
    'Leve 2 Coifas de Mithril e 1 Ombreira Ornada de Mithril para Trenton Lumartelo.‡Принесите два мифриловых капюшона и один изысканный мифриловый наплечник Трентону Молоту Света.‡Bringt Trenton Lighthammer 2 Mithrilhelmkappen und 1 verschnörkelte Mithrilschulter.‡트렌튼 라이트해머에게 미스릴 코이프 2개와 화려한 미스릴 어깨보호구 1개를 가져가야 합니다.‡Llévale un par de almófares de mitril y unos sobrehombros de mitril ornamentado a Trenton Mazaligera.‡Llévale un par de almófares de mitril y unos sobrehombros de mitril ornamentado a Trenton Mazaligera.‡Rapporter deux Camails en mithril et une paire d\'Epaulières ornées en mithril à Trenton Lighthammer.‡将2顶秘银罩帽和1副精制秘银护肩带秘银护肩交给特伦顿·轻锤。‡將2頂秘銀罩帽和1副精制秘銀護肩帶秘銀護肩交給特倫頓·輕錘。',
  }
},
[2772] = {
  {
    'O mundo a seus pés‡Мир у твоих ног‡Die Welt zu Euren Füßen‡화려한 미스릴 장화‡El mundo a tus pies‡El mundo a tus pies‡Le monde à vos pieds‡世界在你脚下‡世界在妳腳下',
    nil,
    'Leve 2 Botas Pesadas de Mithril e 1 Calça Ornada de Mithril para Trenton Lumartelo.‡Принесите две пары тяжелых мифриловых сапог и одни изысканные мифриловые штаны Трентону Молоту Света.‡Bringt Trenton Lighthammer 2 schwere Mithrilstiefel und 1 verschnörkelte Mithrilhose.‡트렌튼 라이트해머에게 견고한 미스릴 장화 2개와 화려한 미스릴 바지 1개를 가져가야 합니다.‡Llévale un par de botas de mitril pesado y unos pantalones de mitril ornamentado a Trenton Mazaligera.|n‡Llévale un par de botas de mitril pesado y unos pantalones de mitril ornamentado a Trenton Mazaligera.‡Rapporter deux paires de Bottes en mithril lourd et des Jambières ornées en mithril à Trenton Lighthammer.‡将2双秘银重靴和1条精制秘银短裤交秘银短裤交给特伦顿·轻锤。‡將2雙秘銀重靴和1條精制秘銀短褲交秘銀短褲交給特倫頓·輕錘。',
  }
},
[2773] = {
  {
    'Kid Mithril‡Мифриловый парень‡Mithril-Kid‡미스릴 천재‡El chico de mitril‡El chico de mitril‡Le gars du mithril‡秘银小子‡秘銀小子',
    nil,
    'Leve 2 Peitorais Pesados de Mithril e 1 Luva Ornada de Mithril para Trenton Lumartelo.‡Принесите две тяжелых мифриловых кирасы и одни изысканные мифриловые перчатки Трентону Молоту Света.‡Bringt Trenton Lighthammer 2 schwere Mithrilbrustplatten und 1 verschnörkelten Mithrilhandschuh.‡트렌튼 라이트해머에게 견고한 미스릴 흉갑 2개와 화려한 미스릴 장갑 1개를 가져가야 합니다.‡Llévale un par de corazas de mitril pesado y unos guantes de mitril ornamentado a Trenton Mazaligera.‡Llévale un par de corazas de mitril pesado y unos guantes de mitril ornamentado a Trenton Mazaligera.‡Rapporter deux Cuirasses lourdes en mithril et une paire de Gants ornés en mithril à Trenton Lighthammer.‡将2件重型秘银胸甲和1副精制秘银手套带给特秘银手套交给特伦顿·轻锤。‡將2件重型秘銀胸甲和1副精制秘銀手套帶給特秘銀手套交給特倫頓·輕錘。',
  }
},
[2781] = {
  {
    'PROCURA-SE: Califa Escorpicada‡РАЗЫСКИВАЕТСЯ: Калиф Жало Скорпида‡GESUCHT: Kalif Skorpidstich‡현상수배: 칼리프 스콜피드스팅‡SE BUSCA: Caliph Escorpijón‡SE BUSCA: Califa Escorpijón‡ON RECHERCHE : Caliph Dard-de-scorpide‡通缉：卡利夫·斯科比斯汀‡通緝：卡利夫·斯科比斯汀',
    nil,
    'Leve a cabeça de Califa Escorpicada ao Engenheiro-chefe Silvadágua em Geringontzan.‡Принесите голову Калифа Жало Скорпида главному инженеру Чепухастеру в Прибамбасск.‡Bringt Chefingenieur Bilgewhizzle in Gadgetzan den Kopf von Kalif Skorpidstich.‡칼리프 스콜피드스팅을 처치하고 그 증거로 그의 머리카락을 칼리프 스콜피드스팅의 머리카락을 가져다주어야 합니다.‡Llévale la cabeza de Caliph Escorpijón al ingeniero jefe Silvaina, que está en Gadgetzan.‡Llévale la cabeza de Califa Escorpijón al ingeniero jefe Pasaquillas, que está en Gadgetzan.‡Apporter la tête de Caliph Dard-de-scorpide à l\'Ingénieur en chef Bilgewizzle à Gadgetzan.‡将卡利夫·斯科比斯汀的头颅交给加基森的首席工程师沙克斯·比格维兹。‡將卡利夫·斯科比斯汀的頭顱交給加基森的首席工程師沙克斯·比格維茲。',
  }
},
[2782] = {
  {
    'O segredo de Rin\'ji‡Секрет Рин\'джи‡Rin\'jis Geheimnis‡린지의 비밀‡El secreto de Rin\'ji‡El secreto de Rin\'ji‡Secret de Rin\'ji‡林吉的秘密‡林吉的秘密',
    nil,
    'Urraca Convulserpe, uma acadêmica bastante reconhecida em assuntos relacionados às trolesas Cascasseca, pode ser capaz de decifrar a tabuleta. Ela mora no Distrito da Magia da Cidade Baixa.‡Отнесите табличку Оран Змеиные Кольца в Квартал Магов Подгорода. Оран – известная ученая, изучающая троллей из племени Сухокожих, и она наверняка сумеет прочесть надписи на табличке.‡Oran Snakewrithe, eine bekannte Gelehrte auf dem Gebiet der Witherbarktrolle, könnte die Tafel vielleicht übersetzen. Normalerweise hält sie sich im Magierviertel von Undercity auf.‡마른나무껍질 트롤에 관해서 누구보다 잘 알고 있는 저명한 학자인 오란 스네이크레이드라면 이 서판을 해독할 수 있을지도 모릅니다. 그녀는 언더시티의 마법 지구에 살고 있다고 합니다.‡Oran Contorpiente es una conocida erudita en los trols Secacorteza; quizá pueda descifrar la tablilla. Vive en el Barrio de la Magia de Entrañas.‡Oran Snakewrithe es una conocida erudita en los trols Secacorteza; quizás pueda descifrar la tablilla. Vive en el Barrio de la Magia de Entrañas.‡Oran Snakewrithe, une érudite réputée pour sa connaissance des us et coutumes des trolls Witherbark, pourrait peut-être déchiffrer la tablette. Elle habite le Quartier de la magie à Undercity.‡奥兰·斯内克威瑟是个学者，她对枯木巨魔很有研究，也许她可以帮你看看这块石板。奥兰就住在幽暗城的魔法区里。‡奧蘭·斯內克威瑟是個學者，她對枯木巨魔很有研究，也許她可以幫妳看看這塊石板。奧蘭就住在幽暗城的魔法區裏。',
  }
},
[2783] = {
  {
    'Brigas mesquinhas‡Мелкие раздоры‡Kleinliches Gezänk‡사소한 말다툼‡Peleas mezquinas‡Peleas mezquinas‡Querelles mesquines‡争论‡爭論',
    nil,
    'Fale com o Herói Caído da Horda na fronteira entre Barreira do Inferno e o pântano.‡Поговорите с павшим героем Орды на границе Выжженных земель и болот.‡Sprecht mit dem gefallenen Helden der Horde im Grenzgebiet zwischen den verwüsteten Landen und dem Sumpf.‡저주받은 땅과 늪의 경계에 있는 호드 영웅의 넋과 대화하십시오.‡Habla con el Héroe Caído de la Horda donde Las Tierras Devastadas lindan con El pantano.‡Habla con el héroe caído de la Horda donde Las Tierras Devastadas lindan con El pantano.‡Parler au Héros déchu de la Horde à la frontière des Terres foudroyées et du marais.‡与诅咒之地和悲伤沼泽交界处的部落英雄的灵魂谈一谈。‡與詛咒之地和悲傷沼澤交界處的部落英雄的靈魂談壹談。',
  }
},
[2784] = {
  {
    'Caindo em desgraça‡Попавший в немилость‡In Ungnade fallen‡명예 실추‡Pérdida de honor‡Pérdida de honor‡Perte d\'honneur‡失落的荣耀‡失落的榮耀',
    nil,
    'Ouça o Herói Caído da Horda contando a história dele.‡Послушайте, как павший герой Орды рассказывает свою историю.‡Lauscht der Geschichte des gefallenen Helden der Horde.‡호드 영웅의 넋이 하는 이야기를 들어야 합니다.‡Escucha la historia del Héroe Caído de la Horda.‡Escucha la historia del héroe caído de la Horda.‡Écouter le Héros déchu de la Horde raconter son histoire.‡聆听部落英雄的灵魂讲述他的故事。‡聆聽部落英雄的靈魂講述他的故事。',
  }
},
[2801] = {
  {
    'Uma história de tristeza‡Горестная повесть‡Eine Geschichte voller Leid‡슬픈 이야기‡Una historia triste‡Una historia triste‡Une histoire de chagrin‡悲伤的故事‡悲傷的故事',
    nil,
    'Ouça o Herói Caído da Horda contando a história dele.‡Послушайте, как павший герой Орды рассказывает свою историю.‡Lauscht der Geschichte des gefallenen Helden der Horde.‡호드 영웅의 넋이 하는 이야기를 들어야 합니다.‡Escucha la historia del héroe caído de la Horda.‡Escucha la historia del héroe caído de la Horda.‡Écouter le Héros déchu de la Horde raconter son histoire.‡聆听部落英雄的灵魂讲述他的故事。‡聆聽部落英雄的靈魂講述他的故事。',
  }
},
[2821] = {
  {
    'Marca de qualidade‡Знак качества‡Das Zeichen der Qualität‡최고의 품질‡La marca de la calidad‡La marca de la calidad‡La marque de la qualité‡质量的保证‡質量的保證',
    nil,
    'Leve 10 peças de Pelego Grosso de Yeti para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 10 толстых шкур йети Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 10 dicke Yetibälge.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos gruesos de yeti a Pratt McGrubben al Bastión Plumaluna.‡Lleva 10 pellejos de yeti gruesos a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 10 Peaux de yéti épaisses à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁比带去10张厚重的雪人皮。‡給羽月要塞的普拉特·馬克格魯比帶去10張厚重的雪人皮。',
  }
},
[2822] = {
  {
    'Marca de qualidade‡Знак качества‡Das Zeichen der Qualität‡품질 표시‡La marca de la calidad‡La marca de la calidad‡La marque de la qualité‡质量的保证‡質量的保證',
    nil,
    'Leve 10 peças de Pelego Grosso de Yeti para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 10 толстых шкур йети Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Swiftstrider im Camp Mojache 10 dicke Yetibälge.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos gruesos de yeti a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 10 pellejos de yeti gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Apporter 10 Peaux de yéti épaisses à Jangdor Swiftstrider au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去十张厚重的雪人皮。‡給莫沙徹營地的杉多爾·迅蹄帶去十張厚重的雪人皮。',
  }
},
[2841] = {
  {
    'Guerra dos robôs‡Техновойны‡Maschinenkriege‡기술 전쟁‡Las guerras de la plataforma‡Las guerras de la plataforma‡Guerre des plates-formes‡设备之战‡設備之戰',
    nil,
    'Pegue a Combinação do Cofre do Termaplugue e o Projeto de Mecatraje e leve-os para Nogg em Orgrimmar.‡Добудьте в Гномрегане чертежи боевой машины и код от сейфа Термоштепселя в Гномрегане и принесите их Ноггу в Оргриммар.‡Besorgt die Maschinenblaupausen und Thermapluggs Safekombination aus Gnomeregan und bringt sie zu Nogg nach Orgrimmar.‡놈리건에서 장치 설계도와 텔마플러그의 금고 암호를 찾아서 오그리마에 있는 노그에게 가져다주어야 합니다.‡Consigue la combinación de la caja fuerte de Termochufe en Gnomeregan y lleva los planos de la plataforma a Nogg a Orgrimmar.‡Consigue la combinación de la caja fuerte de Termochufe en Gnomeregan y lleva los planos de la plataforma a Nogg a Orgrimmar.‡Obtenir la Combinaison du coffre de Thermaplugg, prendre les Plans de la plate-forme et les apporter à Nogg à Orgrimmar.‡从诺莫瑞根拿到钻探设备蓝图和麦克尼尔的保险箱密码，把它们交给奥格瑞玛的诺格。‡從諾莫瑞根拿到鉆探設備藍圖和麥克尼爾的保險箱密碼，把它們交給奧格瑞瑪的諾格。',
  }
},
[2842] = {
  {
    'Engenheiro-chefe Scooty‡Главный инженер Скути‡Chefingenieur Scooty‡선임기술자 스쿠티‡Scooty, ingeniero jefe‡Scooty, ingeniero jefe‡L\'ingénieur en chef Scooty‡主工程师斯库提‡主工程師斯庫提',
    nil,
    'Fale com Scooty na Angra do Butim.‡Поговорите со Скути в Пиратской бухте.‡Sprecht mit Scooty in Booty Bay.‡무법항에 있는 스쿠티와 대화하십시오.‡Habla con Scooty en Bahía del Botín.‡Habla con Scooty en Bahía del Botín.‡Parler à Scooty à Baie-du-Butin.‡和藏宝海湾的斯库提谈一谈。‡和藏寶海灣的斯庫提談壹談。',
  }
},
[2843] = {
  {
    'E lá vamos nós!‡Поехалиии!‡Gnomer-weeeeg!‡놈리거어어어언!‡¡Gnomer-yaaaaa!‡¡Gnomer-yaaaaa!‡Gnomer-paaarti !‡出发！诺莫瑞根！‡出發！諾莫瑞根！',
    nil,
    'Esperar até Scooty calibrar o Transponder Goblínico.‡Дождитесь, пока Скути настроит гоблинский импульсный повторитель.‡Wartet, bis Scooty den Goblin-Transponder kalibriert hat.‡스쿠티가 고블린 응답장치를 조절하는 동안 기다려야 합니다.‡Espera a que Scooty calibre el transpondedor goblin.‡Espera a que Scooty calibre el transpondedor goblin.‡Attendre que Scooty calibre le transpondeur des gobelins.‡等斯库提调整好地精传送器。‡等斯庫提調整好地精傳送器。',
  }
},
[2844] = {
  {
    'O guardião gigante‡Великан-опекун‡Der Riesenwächter‡거대한 수호자‡El guardián gigante‡El guardián gigante‡Le garde géant‡大保姆‡大保姆',
    nil,
    'Encontre a elfa noturna desaparecida.‡Найдите потерявшуюся ночную эльфийку.‡Findet das verlorene Nachtelfen-Mädchen.‡길 잃은 나이트 엘프 소녀를 찾아야 합니다.‡Localiza a la elfa de la noche perdida.‡Localiza a la elfa de la noche perdida.‡Retrouver la jeune elfe de la nuit perdue.‡寻找走丢了的精灵小姑娘。‡尋找走丟了的精靈小姑娘。',
  }
},
[2845] = {
  {
    'Shay distraída‡Шай-бродяжница‡Streunende Shay‡방황하는 샤이‡Las andanzas de Shay‡Las andanzas de Shay‡Shay l\'égarée‡迷路的沙恩‡迷路的沙恩',
    nil,
    'Pegue o Sino de Shay do baú.|nEscolte Shay Velifrondes até o acampamento de Trinca-pedra.‡Достаньте из сундучка колокольчик Шай.|nПроводите Шай Листогон в лагерь Камнедробителя.‡Nehmt Shays Glocke aus der Truhe.|nBegleitet Shay Leafrunner zu Felsbeißers Lager.‡궤짝에서 샤이의 종을 집어야 합니다.|n샤이 리프러너를 무쇠이빨의 야영지까지 호휘해야 합니다.‡Coge la campana de Shay del cofre.|nEscolta a Shay Correhoja al campamento de Muerdepiedras.‡Coge la campana de Shay del cofre.|nEscolta a Shay Correhoja al campamento de Muerdepiedras.‡Prendre la Cloche de Shay dans le coffre.|nEscorter Shay Leafrunner au Camp de Croque-roc.‡从箱子里拿取沙恩的铃铛，然后护送沙恩·飘叶回到罗克比特的营地。‡從箱子裏拿取沙恩的鈴鐺，然後護送沙恩·飄葉回到羅克比特的營地。',
  }
},
[2846] = {
  {
    'Tiara das Profundezas‡Тиара глубин‡Tiara der Tiefen‡심연의 티아라‡Tiara de la Profundidad‡Tiara de las profundidades‡La tiare des abysses‡深渊皇冠‡深淵皇冠',
    nil,
    'Leve a Tiara das Profundezas para Tabetha no Pântano Vadeoso.‡Принесите Тиару Глубин Табете в Пыльную Трясину.‡Bringt die Tiara der Tiefen zu Tabetha in den Marschen von Dustwallow.‡먼지진흙 습지대에 있는 타베사에게 심연의 티아라를 가져가야 합니다.‡Lleva la Tiara de la Profundidad a Tabetha en el Marjal Revolcafango.‡Lleva la tiara de las profundidades a Tabetha en el Marjal Revolcafango.‡Rapporter la Tiare des abysses à Tabetha au marécage d\'Âprefange.‡将深渊皇冠交给尘泥沼泽的塔贝萨。‡將深淵皇冠交給塵泥沼澤的塔貝薩。',
  }
},
[2847] = {
  {
    'Armadura de couro silvestre‡Дикарские кожаные доспехи‡Wildlederrüstung‡야생 가죽 방어구‡Armadura de cuero salvaje‡Armadura de cuero salvaje‡L\'armure en cuir sauvage‡蛮皮护甲‡蠻皮護甲',
    nil,
    'Leve 10 peças de Couro Grosso para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 10 кусков плотной кожи Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 10 Stücke dickes Leder.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 가죽 10개를 가져가야 합니다.‡Lleva 10 cueros gruesos a Pratt McGrubben al Bastión Plumaluna.‡Lleva 10 cueros gruesos a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 10 Cuirs épais à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁比带去10块厚皮。‡給羽月要塞的普拉特·馬克格魯比帶去10塊厚皮。',
  }
},
[2848] = {
  {
    'Omoplatas de couro silvestre‡Дикарские кожаные наплечники‡Wildlederschultern‡야생 가죽 어깨보호구‡Hombreras de cuero salvaje‡Sobrehombros de cuero salvaje‡Les épaulières en cuir sauvage‡蛮皮护肩‡蠻皮護肩',
    nil,
    'Leve 6 Kits de Armadura Grossa e uma Vinha Selvagem para Pradal McGrubben, que fica no Domínio de Plumaluna.‡Принесите 6 наборов для усиления брони из толстой кожи и дикий виноград Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 6 dicke Rüstungssets und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 방어구 키트 6개와 야생덩굴 1개를 가져가야 합니다.‡Lleva 6 complementos gruesos para armadura y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Apporter 6 Renforts d\'armure épais et 1 Sauvageonne à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁带去6片厚重护甲片和1株野葡萄。‡給羽月要塞的普拉特·馬克格魯帶去6片厚重護甲片和1株野葡萄。',
  }
},
[2849] = {
  {
    'Colete de couro silvestre‡Дикарский кожаный жилет‡Wildlederweste‡야생 가죽 조끼‡Jubones de cuero salvaje‡El Jubón de cuero salvaje‡Le gilet en cuir sauvage‡蛮皮外衣‡蠻皮外衣',
    nil,
    'Leve 2 Peitorais de Escama de Tartaruga, 2 Luvas de Escama de Tartaruga e uma Vinha Selvagem para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 черепашьих чешуйчатых кирасы, 2 пары черепашьих чешуйчатых перчаток и дикий виноград Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 2 Schildkrötenschuppenbrustplatten, 2 Paar Schildkrötenschuppenhandschuhe und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 거북 껍질 흉갑 2개, 거북 껍질 장갑 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 petos de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Cuirasses en écailles de tortue, 2 paires de Gants en écailles de tortue et 1 Sauvageonne à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁带去2件龟鳞胸甲、2副龟鳞手套和1株野葡萄。‡給羽月要塞的普拉特·馬克格魯帶去2件龜鱗胸甲、2副龜鱗手套和1株野葡萄。',
  }
},
[2850] = {
  {
    'Capacete de couro silvestre‡Дикарский кожаный шлем‡Wildlederhelm‡야생 가죽 투구‡Casco de cuero salvaje‡Casco de cuero salvaje‡Le casque en cuir sauvage‡蛮皮头盔‡蠻皮頭盔',
    nil,
    'Leve 2 Túnicas da Escapada Noturna, 2 Bandanas da Escapada Noturna e uma Vinha Selvagem para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 ночных мундира, 2 ночных головных повязки и дикий виноград Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 2 Tuniken des Nachtschleichers, 2 Stirnbänder des Nachtschleichers und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 밤하늘 튜닉 2개, 밤하늘 머리띠 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 túnicas Nochefugaz, 2 cintas de pelo Nochefugaz y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 guerreras Nochefugaz, 2 cintas de pelo Nochefugaz y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Tuniques de la nuit, 2 Bandeaux de la nuit et 1 Sauvageonne à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁比带去2件夜色外套、2条夜色头巾和一株野葡萄。‡給羽月要塞的普拉特·馬克格魯比帶去2件夜色外套、2條夜色頭巾和壹株野葡萄。',
  }
},
[2851] = {
  {
    'Botas de couro silvestre‡Дикарские кожаные сапоги‡Wildlederstiefel‡야생 가죽 장화‡Botas de cuero salvaje‡Botas de cuero salvaje‡Les bottes en cuir sauvage‡蛮皮战靴‡蠻皮戰靴',
    nil,
    'Leve 2 Calças da Escapada Noturna, 2 Botas da Escapada Noturna e 2 Vinhas Selvagens para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 пары ночных штанов, 2 пары ночных сапог и 2 экземпляра дикого винограда Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 2 Hosen des Nachtschleichers, 2 Stiefel des Nachtschleichers und 2 Wildranken.‡페더문 요새에 있는 프랫 맥그루벤에게 밤하늘 바지 2개, 밤하늘 장화 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Pantalons de la nuit, 2 paires de Bottes de la nuit et 2 Sauvageonnes à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁带去2条夜色裤、2双夜色靴和2株野葡萄。‡給羽月要塞的普拉特·馬克格魯帶去2條夜色褲、2雙夜色靴和2株野葡萄。',
  }
},
[2852] = {
  {
    'Perneiras de couro silvestre‡Дикарские кожаные поножи‡Wildledergamaschen‡야생 가죽 다리보호구‡Leotardos de cuero salvaje‡Leotardos de cuero salvaje‡Les jambières en cuir sauvage‡蛮皮护腿‡蠻皮護腿',
    nil,
    'Leve 2 Elmos de Escama de Tartaruga, 2 Braçadeiras de Escama de Tartaruga e 2 Vinhas Selvagens para Pradal McGrubben no Domínio de Plumaluna.‡Принесите два шлема из черепашьего панциря, две пары черепашьих чешуйчатых наручей и два экземпляра дикого винограда Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Festung Feathermoon 2 Schildkrötenschuppenhelme, 2 Schildkrötenschuppenarmschienen und 2 Wildranken.‡페더문 요새에 있는 프랫 맥그루벤에게 거북 껍질 투구 2개, 거북 껍질 팔보호구 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Casques en écailles de tortue, 2 Brassards en écailles de tortue et 2 Sauvageonnes à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁比带去2顶龟鳞头盔、2副龟鳞护腕和2株野葡萄。‡給羽月要塞的普拉特·馬克格魯比帶去2頂龜鱗頭盔、2副龜鱗護腕和2株野葡萄。',
  }
},
[2853] = {
  {
    'Mestre do couro silvestre‡Мастер школы Дикаря‡Meister des Wildleders‡야생 가죽 세공의 대가‡Maestro de cuero salvaje‡Maestro de cuero salvaje‡Maître du cuir sauvage‡蛮皮护甲大师‡蠻皮護甲大師',
    nil,
    'Entregue a Carta de Pradal para Telonis, o mestre coureiro de Darnassus.‡Отдайте письмо Пратта Телонису, главному кожевнику Дарнасса.‡Gebt Telonis, dem Lederverarbeitungsmeister von Darnassus, Pratts Brief.‡다르나서스에 있는 가죽 세공의 대가인 텔로니스에게 프랫의 편지를 가져가야 합니다.‡Entrega la carta de Pratt a Telonis, el maestro curtidor de Darnassus.‡Entrega la carta de Pratt a Telonis, el maestro curtidor de Darnassus.‡Donner la Lettre de Pratt à Telonis, le Maître tanneur de Darnassus.‡将普拉特的信交给达纳苏斯的制皮大师泰龙尼斯。‡將普拉特的信交給達納蘇斯的制皮大師泰龍尼斯。',
  }
},
[2854] = {
  {
    'Armadura de couro silvestre‡Дикарские кожаные доспехи‡Wildlederrüstung‡야생 가죽 방어구‡Armadura de cuero salvaje‡Armadura de cuero salvaje‡L\'armure en cuir sauvage‡蛮皮护甲‡蠻皮護甲',
    nil,
    'Leve 10 peças de Couro Grosso para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 10 кусков плотной кожи Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Swiftstrider im Camp Mojache 10 Stücke dickes Leder.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 가죽 10개를 가져가야 합니다.‡Lleva 10 cueros gruesos a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 10 cueros gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 10 Cuirs épais à Jangdor Swiftstrider au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去10块厚皮。‡給莫沙徹營地的杉多爾·迅蹄帶去10塊厚皮。',
  }
},
[2855] = {
  {
    'Omoplatas de couro silvestre‡Дикарские кожаные наплечники‡Wildlederschultern‡야생 가죽 어깨보호구‡Sobrehombros de cuero salvaje‡Sobrehombros de cuero salvaje‡Les épaulières en cuir sauvage‡蛮皮护肩‡蠻皮護肩',
    nil,
    'Leve 6 Kits de Armadura Grossa e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 6 наборов для усиления брони из толстой кожи и дикий виноград Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Swiftstrider im Camp Mojache 6 dicke Rüstungssets und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 방어구 키트 6개와 야생덩굴 1개를 가져가야 합니다.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Apporter 6 Renforts d\'armure épais et 1 Sauvageonne à Jangdor Swiftstrider au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去6块厚重护甲片和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去6塊厚重護甲片和1株野葡萄。',
  }
},
[2856] = {
  {
    'Colete de couro silvestre‡Дикарский кожаный жилет‡Wildlederweste‡야생 가죽 조끼‡Jubones de cuero salvaje‡El Jubón de cuero salvaje‡Le gilet en cuir sauvage‡蛮皮外衣‡蠻皮外衣',
    nil,
    'Leve 2 Peitorais de Escama de Tartaruga, 2 Luvas de Escama de Tartaruga e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 черепашьих чешуйчатых кирасы, 2 пары черепашьих чешуйчатых перчаток и дикий виноград Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Swiftstrider im Camp Mojache 2 Schildkrötenschuppenbrustplatten, 2 Schildkrötenschuppenhandschuhe und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 거북 껍질 흉갑 2개, 거북 껍질 장갑 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 petos de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Cuirasses en écailles de tortue, 2 paires de Gants en écailles de tortue et une Sauvageonne à Jangdor Swiftstrider au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2件龟鳞胸甲、2副龟鳞手套和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2件龜鱗胸甲、2副龜鱗手套和1株野葡萄。',
  }
