[8231] = {
  {
    'Furando onda‡Охота на волномета‡Wellenjagd‡폭풍히드라 사냥‡Los vándalos marinos‡Los vándalos marinos‡Vandales des flots‡碎浪多头怪‡碎浪多頭怪',
    nil,
    'Leve 6 Escamas de Fura-ondas para Ogtinc em Azshara. Ogtinc mora no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Принесите 6 чешуй волношлепа Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Bringt 6 Wellenhauerschuppen zu Ogtinc in Azshara. Ogtinc wohnt oberhalb des Kliffs, nordöstlich der Ruinen von Eldarath.‡아즈샤라에 엘다라스 폐허의 북동쪽 절벽 꼭대기에 있는 오그틴크에게 폭풍히드라 비늘 6개를 가져가야 합니다.‡Llévale 6 escamas de descarnador marino a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Llévale 6 escamas de descarnador marino a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Apporter 6 Ecailles de vandale des flots à Ogtinc en Azshara. Ogtinc demeure au sommet des falaises au nord-est des ruines d\'Eldarath.‡将6块碎浪多头怪的鳞片交给艾萨拉的奥汀克。奥汀克居住在埃达拉斯废墟东北部的悬崖顶部。‡將6塊碎浪多頭怪的鱗片交給艾薩拉的奧汀克。奧汀克居住在埃達拉斯廢墟東北部的懸崖頂部。',
  }
},
[8232] = {
  {
    'O draco verde‡Зеленый дракон‡Der grüne Drache‡녹색 비룡 몰파즈‡El draco verde‡El draco verde‡Le drake vert‡神庙中的绿龙‡神廟中的綠龍',
    nil,
    'Leve o Dente de Morphaz para Ogtinc em Azshara. Ogtinc mora no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Принесите зуб Морфаза Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Bringt Morphaz\' Zahn zu Ogtinc in Azshara. Ogtinc wohnt oberhalb des Kliffs, nordöstlich der Ruinen von Eldarath.‡아즈샤라에 엘다라스 폐허의 북동쪽 절벽 꼭대기에 있는 오그틴크에게 몰파즈의 이빨을 가져가야 합니다.‡Llévale el colmillo de Morphaz a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Llévale el diente de Morphaz a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Apporter la Dent de Morphaz à Ogtinc en Azshara. Ogtinc demeure au sommet des falaises au nord-est des ruines d\'Eldarath.‡将摩弗拉斯的牙齿交给艾萨拉的奥汀克。他住在埃达拉斯废墟东北部悬崖的顶端。‡將摩弗拉斯的牙齒交給艾薩拉的奧汀克。他住在埃達拉斯廢墟東北部懸崖的頂端。',
  }
},
[8233] = {
  {
    'Um pedido simples‡Приглашение‡Ein simples Anliegen‡간단한 부탁‡Un pedido sencillo‡Un pedido sencillo‡Une requête toute simple‡简单的要求‡簡單的要求',
    nil,
    'Fale com Lorde Jorach Corvoforte na Mansão de Corvoforte.‡Поговорите с лордом Джорахом Черным Вороном в его поместье.‡Sprecht mit Lord Jorach Ravenholdt im Ravenholdt-Anwesen.‡라벤홀트 장원에 있는 조라크 라벤홀트 경과 대화해야 합니다.‡Habla con Lord Jorach Ravenholdt en la Mansión Ravenholdt.‡Habla con Lord Jorach Ravenholdt en la Mansión Ravenholdt.‡Parlez au seigneur Jorach Ravenholdt, au manoir de Ravenholdt.‡前往拉文霍德庄园，和乔拉齐·拉文霍德公爵谈一谈。‡前往拉文霍德莊園，和喬拉齊·拉文霍德公爵談壹談。',
  }
},
[8234] = {
  {
    'Saco lazúli lacrado‡Запечатанная лазурная сумка‡Die versiegelte azurblaue Tasche‡봉인된 하늘색 자루‡Bolsa azur sellada‡Bolsa azur sellada‡Sac azur scellé‡密封的蓝袋子‡密封的藍袋子',
    nil,
    'Recupere o Saco Lazúli Lacrado com o Xamã Presamatos, em Azshara. Então o leve para o Arquimago Tauriel, também em Azshara.‡Добудьте запечатанную лазурную сумку у шамана из племени Древобрюхов в Азшаре. Затем отнесите сумку верховному магу Ксилему в Азшаре.‡Erlangt die versiegelte azurblaue Tasche von dem Schamanen der Holzschlundfeste in Azshara zurück. Bringt sie anschließend zum Erzmagier Xylem, der ebenfalls in Azshara zu finden ist.‡아즈샤라에 있는 나무구렁일족 주술사에게서 봉인된 하늘색 자루를 되찾은 후, 그 가방을 아즈샤라에 있는 대마법사 실렘에게 가져가야 합니다.‡Recupera la bolsa azur sellada del chamán Fauces de Madera en Azshara. Llévale entonces la bolsa al archimago Xylem, que también se encuentra en Azshara.‡Recupera la bolsa azur sellada del chamán Fauces de Madera en Azshara. Llévale entonces la bolsa al archimago Xylem, que también se encuentra en Azshara.‡Récupérer le Sac azur scellé auprès du chaman Grumegueule en Azshara. Puis apportez le sac à l\'archimage Xylem, également en Azshara.‡从艾萨拉的木喉萨满祭司那儿取回密封的蓝袋子，将它交给艾萨拉的大法师克希雷姆。‡從艾薩拉的木喉薩滿祭司那兒取回密封的藍袋子，將它交給艾薩拉的大法師克希雷姆。',
  }
},
[8235] = {
  {
    'Fragmentos codificados‡Зашифрованные фрагменты‡Verschlüsselte Fragmente‡암호화된 페이지‡Los fragmentos codificados‡Los trozos codificados‡Les fragments codés‡密文碎片‡密文碎片',
    nil,
    'Leve 10 Fragmentos Codificados para o Arquimago Tauriel em Azshara.‡Принесите 10 зашифрованных фрагментов верховному магу Ксилему в Азшару.‡Bringt Erzmagier Xylem in Azshara 10 verschlüsselte Fragmente.‡아즈샤라에 있는 대마법사 실렘에게 암호화 된 페이지 10개를 가져가야 합니다.‡Llévale 10 fragmentos codificados al archimago Xylem en Azshara.‡Llévale 10 fragmentos codificados al archimago Xylem en Azshara.‡Apporter 10 Fragments codés à l\'archimage Xylem à Azshara.‡将10块密文碎片交给艾萨拉的大法师克希雷姆。‡將10塊密文碎片交給艾薩拉的大法師克希雷姆。',
  }
},
[8236] = {
  {
    'A chave lazúli‡Лазурный ключ‡Der azurblaue Schlüssel‡하늘색 열쇠‡La llave azur‡La llave azur‡La clé d’azur‡碧蓝钥匙‡碧藍鑰匙',
    nil,
    'Leve a Chave Lazúli para o Lorde Jorach Corvoforte.‡Принесите лазурный ключ лорду Черному Ворону.‡Bringt den azurblauen Schlüssel zu Lord Jorach Ravenholdt.‡조라크 라벤홀트 경에게 하늘색 열쇠를 가져가야 합니다.‡Devuélvele la llave azur a Lord Jorach Ravenholdt.‡Devuélvele la llave azur a Lord Jorach Ravenholdt.‡Rendre la Clé d\'azur au seigneur Jorach Ravenholdt.‡将碧蓝钥匙交给乔拉齐·拉文霍德公爵。‡將碧藍鑰匙交給喬拉齊·拉文霍德公爵。',
  }
},
