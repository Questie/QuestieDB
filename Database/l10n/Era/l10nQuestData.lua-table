},
[5241] = {
  {
    'Tio Carlin‡Дядюшка Карлин‡Onkel Carlin‡카를린 삼촌‡Tío Carlin‡Tío Carlin‡Oncle Carlin‡卡林叔叔‡卡林叔叔',
    nil,
    'Encontre Carlin Trilharrubra.‡Найдите Карлина Редпата.‡Sucht Carlin Redpath.‡카를린 레드패스를 찾아야 합니다.‡Encuentra a Carlin Rutagrana.‡Encuentra a Carlin Rutagrana.‡Trouver Carlin Redpath.‡找到卡林·瑞德巴思。‡找到卡林·瑞德巴思。',
  }
},
[5242] = {
  {
    'O golpe final‡Окончательный удар‡Der endgültige Schlag‡마지막 일격‡El golpe final‡El golpe final‡Un coup final‡最终一击‡最終壹擊',
    nil,
    'Mate Moora e Salia, e leve a Cabeça do Lorde das Sombras Fel\'dan para Greta Musgo no Casco em Selva Maleva.‡Убейте Моору и Салию и принесите голову владыки теней Скверн\'дана Грете Замшелому Копыту в Оскверненный лес.‡Tötet Moora und Salia und bringt den Kopf von Schattenlord Fel\'dan zu Greta Mosshoof im Teufelswald.‡무라와 살리라, 그리고 어둠의 군주 펠단을 처치하십시오. 그리고 그 증거로 펠단의 머리카락을 악령의 숲에 있는 그레타 모스후프에게 가져가야 합니다.‡Mata a Moora y Salia y lleva la cabeza del Señor de las Sombras Fel\'dan a Greta Pezuñamusgo a Frondavil.‡Mata a Moora y Salia y lleva la cabeza de Señor de las Sombras Fel\'dan a Greta Pezuñamusgo a Frondavil.‡Tuer Moora et Salia, et rapporter la Tête du Seigneur des ténèbres Fel\'dan à Greta Mosshoof dans Gangrebois.‡杀掉米莱恩和萨莉亚，并把暗影领主费尔丹的头颅交给费伍德森林的格雷塔·苔蹄。‡殺掉米萊恩和薩莉亞，並把暗影領主費爾丹的頭顱交給費伍德森林的格雷塔·苔蹄。',
  }
},
[5243] = {
  {
    'Casas do sagrado‡Святая вода‡Häuser der Heiligen‡성스러운 집‡Las casas de lo sagrado‡Las casas de lo sagrado‡Les demeures du Sacré‡神圣之屋‡神聖之屋',
    nil,
    'Viaje para Stratholme, ao norte. Procure os caixotes de suprimentos que cobrem a cidade e recupere 5 Águas Bentas de Stratholme. Fale novamente com Leonid Bartolomeu, o Venerado, quando coletar fluido abençoado suficiente.‡Отправляйтесь на север, в Стратхольм. Обыщите брошенные ящики с припасами и соберите 5 мер святой воды Стратхольма. Возвращайтесь к Леониду Бартоломею Чтимому, как только воды будет достаточно.‡Begebt Euch nach Stratholme im Norden. Durchsucht die Vorratskisten, die über die Stadt verstreut sind, und holt 5 Einheiten Heiliges Wasser von Stratholme. Kehrt zu Leonid Barthalomew dem Geachteten zurück, wenn Ihr genug der gesegneten Flüssigkeit gesammelt habt.‡북쪽에 있는 스트라솔름으로 가서 도시 어딘가에 흩어진 보급품 상자를 찾아 스트라솔름 성수 5병을 가져와야 합니다. 성수를 충분히 모으고 나면 존경받는 리어니드 바돌로매에게 돌아가야 합니다.‡Viaja al norte, a Stratholme. Registra los cajones de provisiones que hay por toda la ciudad y recupera 5 de agua bendita de Stratholme. Vuelve junto a Leonid Barthalomew el Venerado cuando hayas reunido suficiente líquido bendecido.‡Viaja al norte, a Stratholme. Registra los cajones de provisiones que hay por toda la ciudad y recupera 5 de agua bendita de Stratholme. Vuelve junto a Leonid Barthalomew el Venerado cuando hayas reunido suficiente líquido bendecido.‡Se rendre à Stratholme, au nord. Fouiller les caisses de fournitures qui encombrent la cité et récupérer 5 Eaux sacrées de Stratholme. Retourner auprès de Leonid Barthalomew le Révéré quand vous avez récolté assez de liquide béni.‡到北方的斯坦索姆去，寻找散落在城市中的补给箱，并收集5瓶斯坦索姆圣水。当你找到足够的圣水之后就回去向莱尼德·巴萨罗梅复命。‡到北方的斯坦索姆去，尋找散落在城市中的補給箱，並收集5瓶斯坦索姆聖水。當妳找到足夠的聖水之後就回去向萊尼德·巴薩羅梅復命。',
  }
},
[5244] = {
  {
    'Ruínas de Kel\'Theril‡Руины Кел\'Терила‡Die Ruinen von Kel\'Theril‡켈테릴의 폐허‡Las ruinas de Kel\'Theril‡Las Ruinas de Kel\'Theril‡Les ruines de Kel\'Theril‡凯斯利尔废墟‡凱斯利爾廢墟',
    nil,
    'Fale com Jaron Moldapedra na Aldeia Chuva Estelar.‡Поговорите с Джероном Гранильщиком в деревне Звездопада.‡Sprecht mit Jaron Stoneshaper in Starfall.‡별똥별 마을에 있는 야론 스톤셰이퍼와 대화하십시오.‡Habla con Jaron Tallapiedras en Aldea Estrella Fugaz.‡Habla con Jaron Tallapiedras en Aldea Estrella Fugaz.‡Parler à Jaron Stoneshaper au village de Pluie-d\'Etoiles‡与坠星村的加隆·石矛谈一谈。‡與墜星村的加隆·石矛談壹談。',
  }
},
[5245] = {
  {
    'Espíritos atormentados de Kel\'Theril‡Беспокойные духи Кел\'Терила‡Die gequälten Seelen von Kel\'Theril‡켈테릴의 고통받는 영혼‡Espíritus condenados de Kel\'Theril‡Espíritus condenados de Kel\'Theril‡Les Esprits troublés de Kel\'Theril‡凯斯利尔的怨灵‡凱斯利爾的怨靈',
    nil,
    'Use a Picareta do Jaron para encontrar os quatro Fragmentos da Relíquia dos Altaneiros. Leve-os para Aurora Clamacéus nas Terras Pestilentas Orientais.‡Используйте кирку Джерона, чтобы добыть фрагменты реликвии высокорожденных, Принесите их Авроре Зову Небес в Восточные Чумные земли.‡Benutzt Jarons Hacke, um die vier Fragmente des Hochgeborenenrelikts zu suchen. Bringt sie zu Aurora Skycaller in den Östlichen Pestländern.‡야론의 곡괭이를 사용해 귀족 유물 조각 4개를 찾아 동부 역병지대에 있는 아우로라 스카이콜러에 갖다주어야 합니다.‡Utiliza el pico de Jaron para encontrar los cuatro fragmentos de reliquia de los altonatos. Llévaselas a Aurora Llamacielo en las Tierras de la Peste del Este.‡Utiliza el pico de Gormir para encontrar los cuatro trozos de reliquia de los Altonato.‡Utiliser la Pique de Jaron pour trouver les quatre Fragments de relique des Bien-nés. Les apporter à Aurora Skycaller dans les Maleterres de l’est.‡使用加隆的镐来寻找四块上层精灵遗物的碎片，把它们交给东瘟疫之地的奥萝拉。‡使用加隆的鎬來尋找四塊上層精靈遺物的碎片，把它們交給東瘟疫之地的奧蘿拉。',
  }
},
[5246] = {
  {
    'Fragmentos do passado‡Фрагменты прошлого‡Fragmente der Vergangenheit‡과거의 조각들‡Fragmentos del pasado‡Trozos del pasado‡Fragments du passé‡历史的残片‡歷史的殘片',
    nil,
    'Encontre os Escritos Sagrados dos Altaneiros no Templo de Zin-Malor, em Azshara, e leve-os para Aurora Clamacéus, perto da Torre do Passo Norte nas Terras Pestilentas Orientais.‡Найдите Священные письмена высокорожденных в Храме Зин-Малор, в Азшаре и принесите их Авроре Зову Небес к Башне Северного перевалa, в Восточных Чумных землях.‡Sucht die hochheiligen Schriften der Hochgeborenen im Tempel von Zin-Malor in Azshara und bringt sie zu Aurora Skycaller beim Nordpassturm in den östlichen Pestländern.‡아즈샤라에 있는 진말로의 신전에서 귀족의 성서를 찾아야 합니다. 동부 역병지대의 북부관문 경비탑 근처에 있는 아우로라 스카이콜러에게 가져가십시오.‡Encuentra las escrituras altonatas sagradas del templo de Zin-Malor en Azshara y tráelas para Aurora Llamacielo, en la Torre del Paso Norte en las Tierras de la Peste del Este.‡Encuentra las Sagradas escrituras de los Altonato del Templo de Zin-Malor en Azshara y tráelas para Aurora Clamacielos en la Torre del Paso Norte en las Tierras de la Peste del Este.‡Trouver les Ecrits sacrés des Bien-nés dans le temple de Zin-Malor à Azshara et les apporter à Aurora Skycaller à la tour du Col du nord, dans les Maleterres de l\'est.‡在艾萨拉的辛玛洛神殿里找到神圣的上层精灵笔迹，并将它带给位于东瘟疫之地的北地哨塔附近的奥萝拉。‡在艾薩拉的辛瑪洛神殿裏找到神聖的上層精靈筆跡，並將它帶給位於東瘟疫之地的北地哨塔附近的奧蘿拉。',
  }
},
[5247] = {
  {
    'Fragmentos do passado‡Фрагменты прошлого‡Fragmente der Vergangenheit‡과거의 조각‡Fragmentos del pasado‡Trozos del pasado‡Fragments du passé‡历史的残片‡歷史的殘片',
    nil,
    'Leve uma Barra de Tório Encantado, 5 Restaurações de Cristal e uma Ampola de Água Hedionda para Aurora Clamacéus perto da Torre do Passo Norte nas Terras Pestilentas Orientais.‡Принесите зачарованный слиток тория, 5 кристаллов Восстановления и фиал пугающей воды Авроре Зову Небес к башне Северного Перевала, в Восточных Чумных землях.‡Bringt einen verzauberten Thoriumbarren, 5 Kristallflicker und eine Phiole mit Düsterwasser zu Aurora Skycaller beim Nordpassturm in den östlichen Pestländern.‡마력 깃든 토륨 주괴 1개와 회복의 수정 5개, 그리고 혈투의 웅덩이 물병을 동부 역병지대의 북부관문 경비탑 근처에 있는 아우로라 스카이콜러에게 가져가야 합니다.‡Consigue una barra encantada de torio, 5 cristales de restauración y un vial de agua funesta para Aurora Llamacielo, en la Torre del Paso Norte, en las Tierras de la Peste del Este.‡Consigue una barra de torio encantado, 5 cristales de restauración y un vial de agua funesta para Aurora Clamacielos en la Torre del Paso Norte, en las Tierras de la Peste del Este.‡Apporter une Barre de thorium enchanté, 5 Cristaux de restauration et une Fiole d\'eau redoutable à Aurora Skycaller à la tour du Col du nord, dans les Maleterres de l’est.‡给东瘟疫之地的奥萝拉带去一块魔化瑟银锭、5块恢复水晶，以及一小瓶恐怖之水。‡給東瘟疫之地的奧蘿拉帶去壹塊魔化瑟銀錠、5塊恢復水晶，以及壹小瓶恐怖之水。',
  }
},
[5248] = {
  {
    'Atormentada pelo passado‡Измученный воспоминаниями о прошлом‡Gequält von der Vergangenheit‡인과응보‡Atormentados por el pasado‡Atormentados por el pasado‡Tourmentée par le passé‡记忆的折磨‡記憶的折磨',
    nil,
    'Leve o Cristal de Zin-Malor ao Lago Kel\'Theril, em Hibérnia, e encontre o espírito de um altaneiro que fale com você.‡Отнесите кристалл Зин-Малора к озеру Кел\'Терил в Зимних Ключах и найдите духа высокорожденного, который согласится с вами поговорить.‡Bringt den Kristall von Zin-Malor zum Kel\'Therilsee in Winterspring und sucht einen Geist eines Hochgeborenen, der mit Euch sprechen will.‡진말로의 수정을 여명의 설원에 있는 켈테릴 호수로 갖고 가서 당신과 대화를 하고자 하는 명가의 영혼을 찾아야 합니다.‡Lleva el Cristal de Zin-Malor a Lago Kel\'Theril en Cuna del Invierno y encuentra un espíritu altonato que hable contigo.‡Lleva el Cristal de Zin-Malor a Lago Kel\'Theril en Cuna del Invierno y encuentra un espíritu Altonato que hable contigo.‡Amener le Cristal de Zin-Malor au lac Kel\'Theril dans le Berceau-de-l\'Hiver et trouver un esprit Bien-né qui veuille bien vous parler.‡把辛玛洛水晶带回冬泉谷的凯斯利尔湖，在那里寻找一个会与你讲话的上层精灵。‡把辛瑪洛水晶帶回冬泉谷的凱斯利爾湖，在那裏尋找壹個會與妳講話的上層精靈。',
  }
},
[5249] = {
  {
    'Rumo a Hibérnia!‡В Зимние Ключи!‡Nach Winterspring!‡여명의 설원으로!‡¡A la Cuna del Invierno!‡¡A la Cuna del Invierno!‡Au Berceau-de-l\'Hiver‡前往冬泉谷！‡前往冬泉谷！',
    nil,
    'Encontre a Aldeia Chuva Estelar, em Hibérnia, e fale com Eol Correnoite.‡Найдите в Зимних Ключах деревню Звездопада и поговорите там с Вундом Ночным Охотником.‡Sucht Starfall in Winterspring und sprecht mit Wynd Nightchaser.‡여명의 설원에 있는 별똥별 마을에서 윈드 나이트체이서와 대화하십시오.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Trouver le village de Pluie-d\'Etoiles dans le Berceau-de-l\'Hiver, et parler à Wynd Nightchaser.‡找到冬泉谷的坠星村，在那里与维恩德·夜风谈一谈。‡找到冬泉谷的墜星村，在那裏與維恩德·夜風談壹談。',
  }
},
[5250] = {
  {
    'Chuva Estelar‡Звездопад‡Starfall‡별똥별 마을‡Estrella Fugaz‡Estrella Fugaz‡Pluie-d\'Etoiles‡坠星村‡墜星村',
    nil,
    'Encontre a Chuva Estelar, em Hibérnia, e fale com Eol Correnoite.‡Найдите в Зимних Ключах деревню Звездопада и поговорите там с Вундом Ночным Охотником.‡Sucht Starfall in Winterspring und sprecht mit Wynd Nightchaser.‡여명의 설원에서 별똥별 마을을 찾아 윈드 나이트체이서와 대화하십시오.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Trouver le village de Pluie-d\'Etoiles dans le Berceau-de-l\'Hiver et parler à Wynd Nightchaser.‡找到冬泉谷的坠星村，在那里与维恩德·夜风谈一谈。‡找到冬泉谷的墜星村，在那裏與維恩德·夜風談壹談。',
  }
},
[5251] = {
  {
    'O arquivista‡Архивариус‡Der Archivar‡기록관‡El archivista‡El archivista‡L\'archiviste‡档案管理员‡檔案管理員',
    nil,
    'Viaje até Stratholme e encontre o Arquivista Galford da Cruzada Escarlate. Destrua-o e queime o Arquivo Escarlate.‡Отправляйтесь в Стратхольм и отыщите архивариуса Галфорда из Алого ордена. Убейте его и сожгите архив Алых.‡Reist nach Stratholme und sucht Archivar Galford vom Scharlachroten Kreuzzug. Vernichtet ihn und verbrennt das Scharlachrote Archiv.‡스트라솔름으로 가서 붉은십자군의 기록관, 갈포드를 찾아서 그를 처치하고 붉은십자군 기록을 불태워 버려야 합니다.‡Viaja a Stratholme y encuentra al archivista Galford de La Cruzada Escarlata. Acaba con él y quema el Archivo Escarlata.‡Viaja a Stratholme y encuentra al archivista Galford de La Cruzada Escarlata. Acaba con él y quema el Archivo Escarlata.‡Voyager jusqu’à Stratholme et trouver l’Archiviste Galford de la Croisade écarlate. L’abattre et brûler les Archives écarlates.‡在斯坦索姆城中找到血色十字军的档案管理员加尔福特，杀掉他，然后烧毁血色十字军档案。‡在斯坦索姆城中找到血色十字軍的檔案管理員加爾福特，殺掉他，然後燒毀血色十字軍檔案。',
  }
},
[5252] = {
  {
    'Altaneira arrependida‡Раскаявшийся высокорожденный‡Reuevolle Hochgeborene‡한 맺힌 명가의 원혼‡Altonato arrepentido‡Altonato arrepentido‡Une Bien-née pleine de remords‡悔恨的上层精灵‡悔恨的上層精靈',
    nil,
    'Fale com Eol Correnoite na Aldeia Chuva Estelar e pergunte qual é o lugar mais apropriado para o Cristal de Zin-Malor.‡Поговорите с Вундом Ночным Охотником в деревне Звездопада и узнайте у него, куда нужно поместить кристалл Зин-Малора.‡Sprecht mit Wynd Nightchaser in Starfall und fragt nach dem richtigen Ort für den Kristall von Zin-Malor.‡별똥별 마을에 있는 윈드 나이트체이서와 대화해 진말로의 수정을 어디에 두어야 하는지 물어보십시오.‡Habla con Wynd Cazanoche en Aldea Estrella Fugaz y pregúntale por el lugar adecuado para el Cristal de Zin-Malor.‡Habla con Wynd Cazanoche en Aldea Estrella Fugaz y pregúntale por el lugar adecuado para el Cristal de Zin-Malor.‡Parler à Wynd Nightchaser au village de Pluie-d\'Etoiles et lui demander quel est le bon endroit pour le Cristal de Zin-Malor.‡和坠星村的维恩德·夜风谈一谈，了解到辛玛洛水晶所在的位置。‡和墜星村的維恩德·夜風談壹談，了解到辛瑪洛水晶所在的位置。',
  }
},
[5253] = {
  {
    'O cristal de Zin-Malor‡Кристалл Зин-Малора‡Der Kristall von Zin-Malor‡진말로의 수정‡El cristal de Zin-Malor‡El cristal de Zin-Malor‡Le Cristal de Zin-Malor‡辛玛洛水晶‡辛瑪洛水晶',
    nil,
    'Leve o Cristal de Zin-Malor para o Arquidruida Fandral Guenelmo em Darnassus.‡Доставьте Кристалл Зин-Малора верховному друиду Фэндралу Оленьему Шлему в Дарнасс.‡Überbringt dem Erzdruiden Fandral Staghelm in Darnassus den Kristall von Zin-Malor.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름에게 진말로의 수정을 갖다주어야 합니다.‡Entrega el Cristal de Zin-Malor al archidruida Fandral Corzocelada de Darnassus.‡Entrega el Cristal de Zin-Malor al archidruida Fandral Corzocelada de Darnassus.‡Apporter le Cristal de Zin-Malor à l’archidruide Fandral Staghelm à Darnassus.‡将辛玛洛水晶送到达纳苏斯的大德鲁伊范达尔·鹿盔那里。‡將辛瑪洛水晶送到達納蘇斯的大德魯伊範達爾·鹿盔那裏。',
  }
},
[5261] = {
  {
    'Enzo Peleteiro‡Иган Меховщик‡Eagan Peltskinner‡이건 펠트스키너‡Eagan Desollapieles‡Eagan Desollapelambres‡Eagan le tanneur‡伊根·派特斯金纳‡伊根·派特斯金納',
    nil,
    'Fale com Enzo Peleteiro.‡Поговорите с Иганом Меховщиком.‡Sprecht mit Eagan Peltskinner.‡이건 펠트스키너와 얘기해야 합니다.‡Habla con Eagan Desollapieles.‡Habla con Eagan Desollapelambres.‡Parler à Eagan Peltskinner.‡与伊根·派特斯金纳谈一谈。‡與伊根·派特斯金納談壹談。',
  }
},
[5262] = {
  {
    'A verdade desaba sobre todos‡Ошеломляющая истина‡Die Wahrheit zeigt sich mit Macht‡밝혀지는 진실‡La verdad cae del cielo‡La verdad cae del cielo‡La vérité vient du ciel‡可怕的真相‡可怕的真相',
    nil,
    'Leve a Cabeça do Balnazzar para o Duque Nicolau Zverenhoff nas Terras Pestilentas Orientais.‡Отнесите голову Бальназара герцогу Николасу Зверенхоффу в Восточные Чумные земли.‡Bringt den Kopf von Balnazzar zu Fürst Nicholas Zverenhoff in den Östlichen Pestländern.‡동부 역병지대에 있는 공작 니콜라스 즈바른호프에게 발나자르의 혼을 가져가야 합니다.‡Lleva la cabeza de Balnazzar al Duque Nicholas Zverenhoff en las Tierras de la Peste del Este.‡Lleva la cabeza de Balnazzar al duque Nicolas Zverenhoff en las Tierras de la Peste del Este.‡Apporter la Tête de Balnazzar au duc Nicholas Zverenhoff dans les Maleterres de l’est.‡将巴纳扎尔的头颅交给东瘟疫之地的尼古拉斯·瑟伦霍夫公爵。‡將巴納紮爾的頭顱交給東瘟疫之地的尼古拉斯·瑟倫霍夫公爵。',
  }
},
[5263] = {
  {
    'Acima e além‡Быстрее, выше, сильнее‡Übertroffen‡뛰어난 존재‡Por encima y más allá‡Por encima y más allá‡Au-dessus et au-delà‡超越‡超越',
    nil,
    'Desbrave Stratholme e destrua o Barão Rivendare. Corte sua cabeça e leve-a de volta para o Duque Nicolau Zverenhoff.‡Отправляйтесь в Стратхольм и убейте барона Ривендера. Принесите его голову герцогу Николасу Зверенхоффу.‡Zieht nach Stratholme und vernichtet Baron Rivendare. Nehmt seinen Kopf und kehrt zu Fürst Nicholas Zverenhoff zurück.‡스트라솔름으로 가서 남작 리븐데어를 처치하고 그의 혼을 공작 니콜라스 즈바른호프에게 가져가야 합니다.‡Viaja a Stratholme y acaba con el barón Osahendido. Coge su cabeza y vuelve con el duque Nicolas Zverenhoff.‡Viaja a Stratholme y acaba con el barón Osahendido. Coge su cabeza y vuelve con el duque Nicolas Zverenhoff.‡S’aventurer dans Stratholme et tuer le baron Rivendare. Prendre sa tête et retourner auprès du duc Nicholas Zverenhoff.‡到斯坦索姆去杀掉瑞文戴尔男爵，把他的头颅交给尼古拉斯·瑟伦霍夫公爵。‡到斯坦索姆去殺掉瑞文戴爾男爵，把他的頭顱交給尼古拉斯·瑟倫霍夫公爵。',
  }
},
[5264] = {
  {
    'Lorde Maximiliano Tyrosus‡Лорд Максвелл Тиросс‡Lord Maxwell Tyrosus‡맥스웰 티로서스 경‡Lord Maxwell Neófitus‡Lord Maxwell Neófitus‡Seigneur Maxwell Tyrosus‡玛克斯韦尔·泰罗索斯男爵‡瑪克斯韋爾·泰羅索斯男爵',
    nil,
    'Fale com o Lorde Maximiliano Tyrosus. Ele está dentro da igreja.‡Поговорите с лордом Максвеллом Тироссом. Вы найдете его внутри храма.‡Sprecht mit Lord Maxwell Tyrosus. Er befindet sich in der Kirche.‡교회 안에 있는 맥스웰 티로서스 경과 대화해야 합니다.‡Habla con Lord Maxwell Neófitus. Está en el interior de la iglesia.‡Habla con Lord Maxwell Neófitus. Está en el interior de la iglesia.‡Parler au seigneur Maxwell Tyrosus. Il est à l’intérieur de l’église.‡和玛克斯韦尔·泰罗索斯男爵谈一谈。他就在教堂里面。‡和瑪克斯韋爾·泰羅索斯男爵談壹談。他就在教堂裏面。',
  }
},
[5265] = {
  {
    'O Castelo Violeta‡Серебряный Оплот‡Der Argentumtresor‡여명회의 궤‡El Bastión Argenta‡El Bastión Argenta‡Siège de l’Aube d\'argent‡银色黎明宝箱‡銀色黎明寶箱',
    nil,
    'Abra o Castelo Violeta e reivindique sua recompensa.‡Откройте Серебряный Оплот и получите награду.‡Öffnet den Argentumtresor und nehmt Euch Eure Belohnung.‡여명회의 궤를 열고 보상을 받아야 합니다.‡Abre el Bastión Argenta y reclama tu recompensa.‡Abre el Bastión Argenta y reclama tu recompensa.‡Ouvrir le Coffre prendre votre récompense.‡打开银色黎明宝箱，拿取你应得的奖励。‡打開銀色黎明寶箱，拿取妳應得的獎勵。',
  }
},
[5281] = {
  {
    'As almas inquietas‡Мятущиеся души‡Die ruhelosen Seelen‡잠 못드는 영혼‡Espíritus inquietos‡Espíritus inquietos‡Âmes tourmentées‡永不安息的灵魂‡永不安息的靈魂',
    nil,
    'Encontre Egan. Ele foi visto pela última vez nos arredores de Stratholme.‡Найдите Эгана. В последний раз его видели недалеко от Стратхольма.‡Sucht Egan. Ihr wisst nur, dass er zuletzt in der Nähe von Stratholme gesehen wurde.‡스트라솔름 주변에서 목격된다고 알려진 에간을 찾아야 합니다.‡Encuentra a Egan. Solo sabes que fue visto por última vez en los alrededores de Stratholme.‡Encuentra a Egan. Solo sabes que fue visto por última vez en los alrededores de Stratholme.‡Trouver Egan. Vous savez seulement qu’on l’a vu pour la dernière fois aux alentours de Stratholme.‡找到埃根。你只知道他在斯坦索姆附近。‡找到埃根。妳只知道他在斯坦索姆附近。',
  }
},
[5282] = {
  {
    'As almas inquietas‡Мятущиеся души‡Die ruhelosen Seelen‡잠 못드는 영혼‡Espíritus inquietos‡Espíritus inquietos‡Âmes tourmentées‡永不安息的灵魂‡永不安息的靈魂',
    nil,
    'Use o Canhão de Ectoplasma do Egan nos moradores fantasmagóricos e espectrais de Stratholme. Depois de livrá-los da forma de fantasma, use o canhão de novo e BLAU: liberdade!|nLiberte 15 Almas Inquietas, depois fale novamente com Egan.‡Стреляйте в призраков и неупокоенных на улицах Стратхольма из излучателя Эгана. Когда душа вырвется из призрачной оболочки, выстрелите в нее еще раз, и она обретет свободу.|nОсвободите 15 неупокоенных душ и возвращайтесь к Эгану.‡Wendet Egans Blaster auf die geisterhaften und spektralen Bürger von Stratholme an. Wenn die ruhelosen Geister ihre geisterhaften Hüllen sprengen, wendet den Blaster erneut an - dann sind sie endlich frei!|nBefreit 15 ruhelose Seelen und kehrt zu Egan zurück.‡스트라솔름 시민의 영혼과 원혼들에게 에간의 제령포를 사용해야 합니다. 원혼들이 그들을 가두고 있던 감옥에서 풀려나면 다시 총을 사용하여 그들에게 자유를 선사하십시오!|n15명의 잠 못드는 영혼을 자유롭게 하고 에간에게 돌아가야 합니다.‡Utiliza el libertador de Egan en los ciudadanos espectrales y fantasmas de Stratholme. Cuando las almas se liberen de sus recipientes fantasmales, vuelve a usarlo y lograrás liberarlos para siempre.|nLibera 15 almas y regresa a Egan.‡Utiliza el libertador de Egan en los ciudadanos espectrales y fantasmas de Stratholme. Cuando las almas se liberen de sus recipientes fantasmales, vuelve a usarlo y lograrás liberarlos para siempre.|nLibera 15 almas y regresa a Egan.‡Se servir du Libérateur d\'Egan sur les citoyens fantomatiques et spectraux de Stratholme. Quand les esprits sans repos se libèrent de leur enveloppes fantomatiques, utiliser de nouveau le Libérateur – ils seront enfin libres !|nLibérer 15 Esprits sans repos puis retourner auprès d’Egan.‡对斯坦索姆城中的鬼魂使用埃根的冲击器。当那些永不安息的灵魂挣脱他们的外壳时，再次使用埃根的冲击器——他们就可以获得自由了！|n解放15个永不安息的灵魂，然后回到埃根那里去。‡對斯坦索姆城中的鬼魂使用埃根的沖擊器。當那些永不安息的靈魂掙脫他們的外殼時，再次使用埃根的沖擊器——他們就可以獲得自由了！|n解放15個永不安息的靈魂，然後回到埃根那裏去。',
  }
},
[5283] = {
  {
    'A arte de forjar armaduras‡Искусство изготовления брони‡Die Kunst des Rüstungsschmiedes‡방어구제작자의 길‡El arte del forjador de armaduras‡El arte del forjador de armaduras‡L\'art de l\'armurier‡铸造护甲的艺术‡鑄造護甲的藝術',
    nil,
    'Para virar Ferreir<o/a> de Armaduras, tu vai ter que forjar os seguintes itens e levá-los pro Grumnus: quatro Elmos Ornados de Mithril, duas Botas Ornadas de Mithril e um Peitoral Ornado de Mithril.‡Изготовьте и отдайте Грумнусу 4 узорчатых мифриловых шлема, 2 узорчатых мифриловых сапога и 1 узорчатую мифриловую кирасу.‡Um Rüstungsschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Grumnus bringen: 4 verschnörkelte Mithrilhelme, 2 verschnörkelte Mithrilstiefel, 1 verschnörkelte Mithrilbrustplatte.‡방어구제작자가 되려면 화려한 미스릴 투구 4개, 화려한 미스릴 장화 2켤레, 화려한 미스릴 흉갑 1벌을 만들어 그룸누스에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Grumnus: 4 cascos, 2 botas y 1 peto de mitril ornamentado.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Grumnus: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Pour devenir un fabricant d\'armures, il faut fabriquer les éléments suivants et les rapporter à Grumnus : 4 Heaumes ornés en mithril, 2 Bottes ornées en mithril, 1 Cuirasse ornée en mithril.‡要想成为一名护甲铸造师的话，你必须将下列物品交给格鲁努斯：4顶精制秘银头盔、2双精制秘银战靴和1副精制秘银胸甲。‡要想成為壹名護甲鑄造師的話，妳必須將下列物品交給格魯努斯：4頂精制秘銀頭盔、2雙精制秘銀戰靴和1副精制秘銀胸甲。',
  }
},
[5284] = {
  {
    'O caminho do armeiro‡Путь оружейника‡Der Weg des Waffenschmieds...‡무기제작자의 길‡El arte del forjador de armas‡El arte del forjador de armas‡La voie du Forgeron d\'armes‡武器铸造师之道‡武器鑄造師之道',
    nil,
    'Para te tornares Armeir<o/a>, tu terás que forjar os seguintes itens e trazer para o Ironus: 4 Espadas Largas de Lunaço, 4 Machados Sólidos de Ferro, 2 Machados Pesados de Mithril e 2 Grandes Maças Pretas.‡Сделайте и отдайте Железнусу 4 палаша лунной стали, 4 массивных железных топора, 2 тяжелых мифриловых топора и 2 большие черные палицы.‡Um Waffenschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Ironus bringen: 4 Mondstahlbreitschwerter, 4 massive Eisenäxte, 2 schwere Mithriläxte und 2 große schwarze Streitkolben.‡무기제작자가 되려면 달의 강철 브로드소드 4자루, 큰 철제 도끼 4자루, 견고한 미스릴 도끼 2자루, 검은 대형 철퇴 2자루를 만들어 이로누스에게 가져가야 합니다.‡Para convertirte en <armero/armera> tienes que fabricar lo siguiente y llevárselo a Ironus: 4 espadas de acero lunar, 4 hachas macizas de hierro, 2 hachas de mitril pesado y 2 grandes mazas negras.‡Para convertirte en <armero/armera> tienes que fabricar lo siguiente y llevárselo a Ironus: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.‡Pour devenir un Fabricant d\'armes, il faut fabriquer les éléments suivants et les rapporter à Ironus : 4 Epées d\'acier lunaire, 4 Gigantesques haches en fer, 2 Haches en mithril lourd, et 2 Grandes masses noires.‡要想成为一名武器铸造师的话，你必须将下列物品交给埃隆努斯·冷钢：4把月钢宽剑、4把巨型铁斧、2把秘银重斧和2把巨型黑色锤。‡要想成為壹名武器鑄造師的話，妳必須將下列物品交給埃隆努斯·冷鋼：4把月鋼寬劍、4把巨型鐵斧、2把秘銀重斧和2把巨型黑色錘。',
  }
},
[5301] = {
  {
    'A arte de forjar armaduras‡Искусство школы Брони‡Die Kunst des Rüstungsschmiedes‡방어구제작자의 길‡El arte del forjador de armaduras‡El arte del forjador de armaduras‡L\'art de l\'armurier‡铸造护甲的艺术‡鑄造護甲的藝術',
    nil,
    'Para virar Ferreir<o/a> de Armaduras, você vai ter que forjar os seguintes itens e levá-los para Okothos: quatro Elmos Ornados de Mithril, duas Botas Ornadas de Mithril e um Peitoral Ornado de Mithril.‡Чтобы присоединиться к школе Брони, изготовьте и отдайте Окотосу 4 изысканных мифриловых шлема, 2 пары изысканных мифриловых сапог и 1 изысканную мифриловую кирасу.‡Um Rüstungsschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Okothos bringen: 4 verschnörkelte Mithrilhelme, 2 verschnörkelte Mithrilstiefel, 1 verschnörkelte Mithrilbrustplatte.‡방어구제작자가 되려면 화려한 미스릴 투구 4개, 화려한 미스릴 장화 2켤레, 화려한 미스릴 흉갑 1벌을 만들어 오코토스에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Okothos: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Okothos: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Pour devenir un fabricant d\'armures, il faut fabriquer les éléments suivants puis les apporter à Okothos : 4 Heaumes ornés en mithril, 2 Bottes ornées en mithril, 1 Cuirasse ornée en mithril.‡要想成为一名护甲铸造师的话，你必须将下列物品交给奥克索斯：4顶精制秘银头盔、2双精制秘银战靴和1副精制秘银胸甲。‡要想成為壹名護甲鑄造師的話，妳必須將下列物品交給奧克索斯：4頂精制秘銀頭盔、2雙精制秘銀戰靴和1副精制秘銀胸甲。',
  }
},
[5302] = {
  {
    'O caminho do armeiro‡Путь оружейника‡Der Weg des Waffenschmieds...‡무기제작자의 길‡El arte del forjador de armas‡El arte del forjador de armas‡La voie du Forgeron d\'armes‡武器铸造师之道‡武器鑄造師之道',
    nil,
    'Para se tornar <um Armeiro/uma Armeira>, você precisa fazer os seguintes itens e levá-los para Borgosh: 4 Espadas Largas de Lunaço, 4 Machados Sólidos de Ferro, 2 Machados Pesados de Mithril e 2 Grandes Maças Pretas.‡Изготовьте и отдайте Боргошу 4 палаша лунной стали, 4 массивных железных топора, 2 тяжелых мифриловых топора и 2 больших черных палицы.‡Um Waffenschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Borgosh bringen: 4 Mondstahlbreitschwerter, 4 massive Eisenäxte, 2 schwere Mithriläxte und 2 große schwarze Streitkolben.‡무기제작자가 되려면 달의 강철 브로드소드 4자루, 큰 철제 도끼 2자루, 견고한 미스릴 도끼 2자루, 검은 대형 철퇴 2자루를 만들어 보르고쉬에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armas tienes que fabricar lo siguiente y llevárselo a Borgosh: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.|n‡Para convertirte en <forjador/forjadora> de armas tienes que fabricar lo siguiente y llevárselo a Borgosh: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.‡Pour devenir un Fabricant d\'armes, vous devez fabriquer les éléments suivants et les rapporter à Borgosh : 4 Epées d\'acier lunaire, 4 Gigantesques haches en fer, 2 Haches en mithril lourd, et 2 Grandes masses noires.‡要想成为一名武器铸造师的话，你必须将下列物品交给伯古什：4把月钢宽剑、4把巨型铁斧、2把秘银重斧和2把巨型黑色锤。‡要想成為壹名武器鑄造師的話，妳必須將下列物品交給伯古什：4把月鋼寬劍、4把巨型鐵斧、2把秘銀重斧和2把巨型黑色錘。',
  }
},
[5305] = {
  {
    'Doce serenidade‡Секрет безмятежности‡Süße Beschaulichkeit‡진홍십자군 작업복‡Dulce serenidad‡Dulce serenidad‡Douce sérénité‡甜美的平静‡甜美的平靜',
    nil,
    'Vá para Stratholme e mate o Forjador de Martelos Carmesim. Recolha o Avental do Forjador de Martelos Carmesim e leve-o para Lilith.‡Отправляйтесь в Стратхольм и убейте Молотобойца из Багрового легиона. Возьмите его фартук и возвращайтесь к Лилит.‡Begebt Euch nach Stratholme und tötet den purpurroten Hammerschmied. Nehmt die Schürze des purpurroten Hammerschmiedes und kehrt zu Lilith zurück.‡스트라솔름으로 가서 진홍십자군 대장장이를 처치하고 진홍십자군 대장장이의 작업복을 가지고 릴리스에게 돌아가야 합니다.‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.|n‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.‡Aller jusqu’à Stratholme et tuer le Forgeur de marteaux cramoisi. Récupérer son Tablier et le ramener à Lilith.‡到斯坦索姆去杀死红衣铸锤师。将红衣铸锤师的围裙交给莉莉丝。‡到斯坦索姆去殺死紅衣鑄錘師。將紅衣鑄錘師的圍裙交給莉莉絲。',
  }
},
[5306] = {
  {
    'A litofídia da caçadora sombria‡Змеекамень Пленяющей Духов‡Schlangenstein der Schattenjägerin‡어둠사냥꾼의 뱀돌‡Piedra Serpiente de la Cazadora de las Sombras‡Piedra culebra de la cazadora de las Sombras‡Pierre du serpent de la chasseresse des ombres‡沃什加斯的菊石‡沃什加斯的菊石',
    nil,
    'Vá para o Pico da Rocha Negra e mate a Caçadora Sombria Vosh\'gajin. Recolha a Litofídia de Vosh\'gajin e fale novamente com Kilram.‡Отправляйтесь на Пик Черной горы, убейте Темную охотницу Вос\'гаджин. Заберите у нее змеекамень и принесите Килраму.‡Begebt Euch zur Blackrockspitze und erschlagt Schattenjägerin Vosh\'gajin. Holt Vosh\'gajins Schlangenstein und kehrt zu Kilram zurück.‡검은바위 첨탑으로 가서 어둠사냥꾼 보쉬가진을 처치하고 보쉬가진의 뱀돌을 킬램에게 갖다주어야 합니다.‡Viaja a la Cumbre de Roca Negra y mata a la cazadora de las Sombras Vosh\'gajin. Recupera la piedra serpiente de Vosh\'gajin y vuelve con Kilram.‡Viaja a la Cumbre de Roca Negra y mata a la cazadora de las Sombras Vosh\'gajin. Recupera la piedra culebra de Vosh\'gajin y vuelve con Kilram.‡Aller jusqu’au Pic Blackrock et abattre la chasseresse des ombres Vosh\'gajin. Récupérer la Pierre du serpent de Vosh\'gajin et la ramener à Kilram.‡到黑石塔去杀死暗影猎手沃什加斯，将沃什加斯的菊石交给基尔拉姆。‡到黑石塔去殺死暗影獵手沃什加斯，將沃什加斯的菊石交給基爾拉姆。',
  }
},
[5307] = {
  {
    'Corrupção‡Порча‡Verderbnis‡부패의 검‡Corrupción‡Corrupción‡Corruption‡腐蚀‡腐蝕',
    nil,
    'Encontre o Cuteleiro da Guarda Negra em Stratholme e destrua-o. Recolha a Insígnia da Guarda Negra e fale novamente com Seril Flagelicida.‡Найдите в Стартхольме оружейника Черной Стражи и уничтожьте его. Возьмите его Знак Черной Стражи и принесите Сирилу Плетебою.‡Findet den Schwertschmied der schwarzen Wache in Stratholme und vernichtet ihn. Holt die Insignien der schwarzen Wache und kehrt zu Seril Scourgebane zurück.‡스트라솔름에서 검은호위대 검제작자를 찾아 그를 처치하고 검은호위대 휘장을 회수한 후, 세릴 스컬지베인에게 갖다주어야 합니다.‡Encuentra al armero Guardia Negra en Stratholme y acaba con él. Recupera la Insignia de La Guardia Negra y regresa con Seril Finiquiplaga.‡Encuentra al armero Guardia Negra en Stratholme y acaba con él. Recupera la Insignia de La Guardia Negra y regresa con Seril Finiquiplaga.‡Trouver le Fabricant d\'épées de la Garde noire à Stratholme et le tuer. Récupérer l’Insigne de la Garde noire et retourner auprès de Seril Scourgebane.‡在斯坦索姆找到黑衣守卫铸剑师，然后杀死他。将黑色卫士徽记交给亡灵杀手瑟里尔。‡在斯坦索姆找到黑衣守衛鑄劍師，然後殺死他。將黑色衛士徽記交給亡靈殺手瑟裏爾。',
  }
},
[5321] = {
  {
    'A adormecida despertou‡Спящий пробудился‡Der Schläfer ist erwacht‡잠에서 깨어난 드루이드‡El despertar‡El despertar‡Le dormeur s\'est éveillé‡昏昏欲睡‡昏昏欲睡',
    nil,
    'Escolte Kerlonian Perenumbra até Liladris Luneflúvia no Entreposto de Maestra, situado no Vale Gris.‡Сопроводите Керлониана Вечный Сумрак к Лиладрис Лунной Реке на Заставу Мейстры в Ясеневом лесу.‡Begleitet Kerlonian Evershade zu Liladris Moonriver in Maestras Posten in Ashenvale.‡케를로니안 에버섀이드를 잿빛 골짜기의 마에스트라 주둔지에 있는 릴라드리스 문리버에게 호위해 가야 합니다.‡Escolta a Kerlonian Semprumbrío a la Atalaya de Maestra de Vallefresno.‡Escolta a Kerlonian Semprumbrío hasta Liladris Rioluna en la Atalaya de Maestra de Vallefresno.‡Escorter Kerlonian Evershade jusqu’à Liladris Moonriver au Poste de Maestra à Ashenvale.‡护送克罗尼亚·恒影到灰谷迈斯特拉岗哨的利拉迪斯·月河那里去。‡護送克羅尼亞·恒影到灰谷邁斯特拉崗哨的利拉迪斯·月河那裏去。',
  }
},
[5341] = {
  {
    'A fortuna da família Barov‡Сокровище Баровых‡Das Familienvermögen der Barovs‡바로브 가의 유산‡La fortuna de la familia Barov‡La fortuna de la familia Barov‡Fortune de la famille Barov‡巴罗夫家族的宝藏‡巴羅夫家族的寶藏',
    nil,
    'Desbrave Scolomântia e recupere a fortuna da família Barov. A fortuna é composta por quatro escrituras: A Escritura de Castro das Flechas, A Escritura de Montalvo, A Escritura da Serraria Tarren e A Escritura de Costa Sul. Fale novamente com Alexei Barov quando tiver terminado a tarefa.‡Отправляйтесь в Некроситет и добудьте сокровище семьи Баровых. Оно состоит из четырех документов: на Каэр Дарроу, на Брилл, на Мельницу Таррен и на Южнобережье. После выполнения задания вернитесь к Алексию Барову.‡Begebt Euch zur Scholomance und holt das Familienvermögen der Barovs zurück. Dieses Vermögen besteht aus vier Besitzurkunden: Es sind die Besitzurkunde für Caer Darrow, die Besitzurkunde für Brill, die Besitzurkunde für Tarrens Mühle und die Besitzurkunde für Southshore. Kehrt zu Alexi Barov zurück, sobald die Aufgabe erledigt ist.‡스칼로맨스로 가서 바로브 가의 유산을 회수해야 합니다. 이 재산은 카엘 다로우 증서, 브릴 증서, 타렌 밀농장 증서, 사우스쇼어 증서의 4개 땅문서로 이루어져 있습니다. 임무를 완수한 후 알렉시 바로브에게 돌아가야 합니다.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras del Molino Tarren y Las escrituras de Costasur. Regresa con Alexi Barov cuando hayas terminado esta tarea.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras de Molino Tarren y Las escrituras de Costasur. Regresa con Alexi Barov cuando hayas terminado esta tarea.‡S’aventurer jusqu’à Scholomance et récupérer la fortune de la famille Barov. Cette fortune se compose de quatre titres de propriété : le titre de propriété de Caer Darrow ; le titre de propriété de Brill ; le titre de propriété de Moulin-de-Tarren ; et le titre de propriété de Southshore. Revenir auprès d’Alexi Barov quand la tâche est accomplie.‡到通灵学院中去取得巴罗夫家族的宝藏。这份宝藏包括四份地契：凯尔达隆地契、布瑞尔地契、塔伦米尔地契，还有南海镇地契。完成任务之后就回到阿莱克斯·巴罗夫那儿去。‡到通靈學院中去取得巴羅夫家族的寶藏。這份寶藏包括四份地契：凱爾達隆地契、布瑞爾地契、塔倫米爾地契，還有南海鎮地契。完成任務之後就回到阿萊克斯·巴羅夫那兒去。',
  }
},
[5342] = {
  {
    'O último Barov‡Последний из Баровых‡Der letzte Barov‡최후의 상속자‡El último de los Barov‡El último de los Barov‡Le dernier Barov‡巴罗夫的继承人‡巴羅夫的繼承人',
    nil,
    'Vá para o Acampamento Ventogelante, no território da Aliança, e assassine Weldon Barov. Recolha a cabeça dele e fale novamente com Alexei Barov.|nEsteja avisad<o/a>: Weldon provavelmente estará muito bem protegido pela escória da Aliança.‡Отправляйтесь в Лагерь Промозглого Ветра – на земли Альянса – и убейте Велдона Барова. Отнесите его голову Алексию Барову.|nСоблюдайте осторожность – скорее всего, Велдона охраняет мразь Альянса.‡Begebt Euch zum Chillwind-Lager - Territorium der Allianz - und ermordet Weldon Barov. Nehmt seinen Kopf und kehrt zu Alexi Barov zurück.|nSeid gewarnt, Weldon wird wahrscheinlich gut von Abschaum der Allianz geschützt.‡얼라이언스 영토인 서리바람 야영지로 가서 웰던 바로브를 암살해야 합니다. 그 증거로 그의 머리카락을 가지고 알렉시 바로브에게 돌아가십시오.|n얼라이언스 쓰레기들이 웰던을 보호하고 있을 테니 조심해야 합니다.‡Viaja al Campamento del Orvallo, territorio de la Alianza, y asesina a Weldon Barov. Coge su cabeza y regresa con Alexi Barov.|nTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Alianza.‡Viaja al Campamento del Orvallo, territorio de la Alianza, y asesina a Weldon Barov. Coge su cabeza y regresa con Alexi Barov.|nTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Alianza.‡Voyagez jusqu’au Camp du Noroît, dans le territoire de l’Alliance, et y assassiner Weldon Barov. Prenez sa tête et revenez auprès d’Alexi Barov.|nAttention : Weldon sera probablement bien protégé par la racaille de l’Alliance.‡到冰风岗——联盟的领地——去暗杀维尔顿·巴罗夫。把他的脑袋交给阿莱克斯·巴罗夫。|n要多加小心，联盟也许对维尔顿实施了严密的保护。‡到冰風崗——聯盟的領地——去暗殺維爾頓·巴羅夫。把他的腦袋交給阿萊克斯·巴羅夫。|n要多加小心，聯盟也許對維爾頓實施了嚴密的保護。',
  }
},
[5343] = {
  {
    'A fortuna da família Barov‡Сокровище Баровых‡Das Familienvermögen der Barovs‡바로브 가의 유산‡La fortuna de la familia Barov‡La fortuna de la familia Barov‡Fortune de la famille Barov‡巴罗夫家族的宝藏‡巴羅夫家族的寶藏',
    nil,
    'Desbrave Scolomântia e recupere a fortuna da família Barov. A fortuna é composta por quatro escrituras: A Escritura de Castro das Flechas, a Escritura de Montalvo, a Escritura da Serraria Tarren e a Escritura de Costa Sul. Fale novamente com Weldon Barov quando tiver terminado a tarefa.‡Отправляйтесь в Некроситет и добудьте сокровище семьи Баровых. Оно состоит из четырех документов: на Каэр Дарроу, на Брилл, на Мельницу Таррен и на Южнобережье. После выполнения задания вернитесь к Велдону Барову.‡Begebt Euch zur Scholomance und holt das Familienvermögen der Barovs zurück. Dieses Vermögen besteht aus vier Besitzurkunden: Es sind die Besitzurkunde für Caer Darrow, die Besitzurkunde für Brill, die Besitzurkunde für Tarrens Mühle und die Besitzurkunde für Southshore. Kehrt zu Weldon Barov zurück, sobald die Aufgabe erledigt ist.‡스칼로맨스로 가서 바로브 가의 유산을 회수해야 합니다. 이 유산은 카엘 다로우 증서, 브릴 증서, 타렌 밀농장 증서, 사우스쇼어 증서의 4개 땅문서로 이루어져 있습니다. 이 임무를 완수한 후 웰던 바로브에게 돌아가야 합니다.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras del Molino Tarren y Las escrituras de Costasur. Regresa con Weldon Barov cuando hayas terminado esta tarea.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras de Molino Tarren y Las escrituras de Costasur. Regresa con Weldon Barov cuando hayas terminado esta tarea.‡S’aventurer jusqu’à la Scholomance et récupérer la fortune de la famille Barov. Cette fortune se compose de quatre titres de propriété : le titre de propriété de Caer Darrow ; le titre de propriété de Brill ; le titre de propriété de Moulin-de-Tarren ; et le titre de propriété de Southshore. Revenir auprès de Weldon Barov quand la tâche est accomplie.‡到通灵学院中去取得巴罗夫家族的宝藏。这份宝藏包括四份地契：凯尔达隆地契、布瑞尔地契、塔伦米尔地契，还有南海镇地契。完成任务之后就回到维尔顿·巴罗夫那儿去。‡到通靈學院中去取得巴羅夫家族的寶藏。這份寶藏包括四份地契：凱爾達隆地契、布瑞爾地契、塔倫米爾地契，還有南海鎮地契。完成任務之後就回到維爾頓·巴羅夫那兒去。',
  }
},
[5344] = {
  {
    'O último Barov‡Последний из Баровых‡Der letzte Barov‡최후의 바로브‡El último de los Barov‡El último de los Barov‡Le dernier Barov‡巴罗夫的继承人‡巴羅夫的繼承人',
    nil,
    'Vá para o Baluarte, no território da Horda, e assassine Alexei Barov. Recolha a cabeça dele e fale novamente com Weldon Barov.|nEsteja avisad<o/a>: Alexei provavelmente estará muito bem protegido pela escória da Horda.‡Отправляйтесь в Бастион – на земли Орды – и убейте Алексия Барова. Отнесите его голову Велдону Барову.|nСоблюдайте осторожность – скорее всего, Алексия охраняет ордынская мразь.‡Begebt Euch zum Bollwerk - Territorium der Horde - und ermordet Alexi Barov. Nehmt seinen Kopf und kehrt zu Weldon Barov zurück.|nSeid gewarnt, Alexi wird wahrscheinlich gut durch Abschaum der Horde geschützt.‡호드의 영토인 보루로 가서 알렉시 바로브를 암살하십시오. 그 증거로 그의 머리카락을 가지고 웰던 바로브에게 돌아가십시오.|n더러운 호드가 알렉시를 보호하고 있을 테니 조심해야 합니다.‡Viaja a El Baluarte, territorio de la Horda, y asesina a Alexi Barov. Coge su cabeza y regresa con Weldon Barov.|nTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Horda.‡Viaja a El Baluarte, territorio de la Horda, y asesina a Alexi Barov. Coge su cabeza y regresa con Weldon Barov.|nTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Horda.‡Voyager jusqu’à la Barricade - territoire de la Horde - et assassiner Alexi Barov. Prendre sa tête et revenir auprès de Weldon Barov.|nAttention : Alexi sera probablement bien protégé par les vandales de la Horde.‡去亡灵壁垒——部落的领地——去暗杀阿莱克斯·巴罗夫。把他的脑袋交给维尔顿·巴罗夫。|n要小心，部落也许对阿莱克斯实施了严密的保护。‡去亡靈壁壘——部落的領地——去暗殺阿萊克斯·巴羅夫。把他的腦袋交給維爾頓·巴羅夫。|n要小心，部落也許對阿萊克斯實施了嚴密的保護。',
  }
},
[5361] = {
  {
    'Árvore genealógica‡Семейное древо‡Stammbaum‡형제애‡Árbol genealógico‡Árbol genealógico‡Arbre familial‡兄弟‡兄弟',
    nil,
    'Leve o Relatório de Vigia do Rochedo Chifre Longo para Nataoka Chifre Longo no Entreposto do Espírito que Anda, situado em Desolação.‡Доставьте отчет стража утеса Долгорога Натаке Длинному Рогу на Заставу Скитающихся Духов в Пустоши.‡Bringt den Bericht von Klippenbehüter Longhorn zu Nataka Longhorn am Geistwandlerposten in Desolace.‡절벽파수꾼 롱혼의 보고서를 잊혀진 땅의 침묵의 초소에 있는 나타카 롱혼에게 가져가야 합니다.‡Entrégale el informe de Vigiarisco Cuernolargo a Nataka Cuernolargo que se encuentra en el Campamento del Espíritu Errante de Desolace.‡Entrégale el informe de Vigiarisco Cuerno Largo a Nataka Cuerno Largo que se encuentra en el Campamento del Espíritu Errante de Desolace.‡Apporter le Rapport du garde-falaise Longhorn à Nataka Longhorn au poste de Rôdeur-fantôme en Désolace.‡将峭壁卫兵图林·长角的报告交给凄凉之地幽灵岗哨的纳塔卡·长角。‡將峭壁衛兵圖林·長角的報告交給淒涼之地幽靈崗哨的納塔卡·長角。',
  }
},
[5381] = {
  {
    'Mão da Iruxos‡Рука Ируксоса‡Hand von Iruxos‡이룩소스의 손‡La Mano de Iruxos‡La Mano de Iruxos‡La Main d\'Iruxos‡埃鲁索斯之手‡埃魯索斯之手',
    nil,
    'Recolha a Caixa Demoníaca na Fortaleza Machado do Trovão e leve-a, junto com a Picareta do Diabo, para Taiga Crina Sábia na Aldeia Pescassombra.‡Добудьте в Крепости Громового Топора Демоническую шкатулку, а затем принесите ее и кирку демонов Тайге Мудрой Гриве в Деревню Ночных Охотников.‡Holt den Dämonenkasten aus der Festung Thunder Axe und kehrt damit zu Taiga Wisemane nach Shadowprey zurück.‡천둥도끼 요새에서 악마의 상자를 찾아서 그늘수렵 마을에 있는 타이가 와이즈메인에게 가져가십시오. 악마의 곡괭이도 함께 돌려줘야 합니다.‡Extrae la caja de demonio de la Fortaleza del Hacha de Trueno y llévasela a Taiga Crin Sabia a la Aldea Cazasombras junto con el pico de demonio.|n‡Extrae la caja de demonio de la Fortaleza del Hacha de Trueno y llévasela a Taiga Crin Sabia a la Aldea Cazasombras junto con el pico de demonio.‡Récupérer la Boîte démoniaque dans la forteresse de Hache-Tonnerre, puis la rapporter à Taiga Wisemane, à Proie-de-l\'Ombre.‡在雷斧堡垒中找到恶魔之盒，把它和恶魔之锄一起交给葬影村的泰迦·慧鬃。‡在雷斧堡壘中找到惡魔之盒，把它和惡魔之鋤壹起交給葬影村的泰迦·慧鬃。',
  }
},
[5382] = {
  {
    'Doutor Theolen Krastinov, o Carniceiro‡Доктор Теолен Крастинов – Мясник‡Doktor Theolen Krastinov, der Schlächter‡도살자, 테올렌 크라스티노브‡Doctor Theolen Krastinov, el Carnicero‡Doctor Theolen Krastinov, el Carnicero‡Docteur Theolen Krastinov, le boucher‡瑟尔林·卡斯迪诺夫教授‡瑟爾林·卡斯迪諾夫教授',
    nil,
    'Encontre o Doutor Theolen Krastinov em Scolomântia. Destrua-o, depois queime os Restos Mortais de Eva Sarkhoff e os Restos Mortais de Lucien Sarkhoff. Fale novamente com Eva Sarkhoff depois que tiver terminado a tarefa.‡Найдите в Некроситете доктора Теолена Крастинова. Убейте его, затем сожгите останки Евы и Люсьена Саркофф. Выполнив задание, возвращайтесь к Еве Саркофф.‡Sucht Doktor Theolen Krastinov in der Scholomance. Vernichtet ihn, verbrennt dann die Überreste von Eva Sarkhoff und die Überreste von Lucien Sarkhoff. Kehrt zu Eva Sarkhoff zurück, sobald Ihr die Aufgabe erfüllt habt.‡스칼로맨스 내에서 학자 테올렌 크라스티노브를 찾아 처치한 후 에바 사크호프의 유해와 루시엔 사크호프의 유해를 불태우십시오. 임무를 완수하면 에바 사크호프에게 돌아가야 합니다.‡Busca al doctor Theolen Krastinov en el interior de Scholomance. Acaba con él y quema los restos de Eva Sarkhoff y los restos de Lucien Sarkhoff. Cuando hayas terminado tu tarea regresa con Eva Sarkhoff.|n‡Busca al doctor Theolen Krastinov en el interior de Scholomance. Acaba con él y quema los restos de Eva Sarkhoff y los restos de Lucien Sarkhoff. Cuando hayas terminado tu tarea regresa con Eva Sarkhoff.‡Trouver le docteur Theolen Krastinov à l’intérieur de la Scholomance. Le tuer, puis brûler le Cadavre d’Eva Sarkhoff et le Cadavre de Lucien Sarkhoff. Retourner auprès d’Eva Sarkhoff quand la tâche est accomplie.‡在通灵学院中找到瑟尔林·卡斯迪诺夫教授。杀死他，并烧毁艾瓦·萨克霍夫和卢森·萨克霍夫的遗体。任务完成后就回到艾瓦·萨克霍夫那儿。‡在通靈學院中找到瑟爾林·卡斯迪諾夫教授。殺死他，並燒毀艾瓦·薩克霍夫和盧森·薩克霍夫的遺體。任務完成後就回到艾瓦·薩克霍夫那兒。',
  }
},
[5384] = {
  {
    'Kirtonos, o Arauto‡Киртонос Глашатай‡Kirtonos der Herold‡사자 키르토노스‡Kirtonos el Heraldo‡Kirtonos el Heraldo‡Kirtonos le héraut‡传令官基尔图诺斯‡傳令官基爾圖諾斯',
    nil,
    'Volte a Scolomântia com o Sangue dos Inocentes em mãos. Encontre a varanda e derrame o Sangue dos Inocentes no braseiro. Kirtonos virá na intenção de devorar sua alma.|nLute com bravura, não dê nenhuma brecha! Destrua Kirtonos e fale novamente com Eva Sarkhoff.‡Вернитесь в Некроситет с кровью невинных. Найдите балкон и вылейте кровь в жаровню. На зов явится Киртонос.|nСражайтесь как герой, не сдавайтесь! Уничтожьте Киртоноса и возвращайтесь к Еве Саркофф.‡Kehrt mit dem Blut Unschuldiger zur Scholomance zurück. Sucht die Veranda und legt das Blut der Unschuldigen in die Kohlenpfanne. Kirtonos wird kommen, um sich von Eurer Seele zu nähren.|nKämpft tapfer, gebt keinen Fußbreit nach! Vernichtet Kirtonos und kehrt zu Eva Sarkhoff zurück.‡순결한 피를 가지고 스칼로맨스로 돌아가야 합니다. 사자의 창을 찾아 사자의 화롯불에 순결한 피를 올려 놓으면 키르토노스가 영혼을 차지하기 위해 나타납니다.|n용맹하게 싸우고 단 한 발짝도 물러서지 마십시오! 키르토노스를 처치한 후 에바 사크호프에게 돌아가야 합니다.‡Vuelve a Scholomance con la Sangre de los inocentes. Busca el Porche y coloca la Sangre de los inocentes en el blandón. Kirtonos acudirá a devorar tu alma.|nLucha con valentía, ¡no cedas ni una pulgada! Destruye a Kirtonos y vuelve con Eva Sarkhoff.‡Vuelve a Scholomance con la sangre inocente. Busca el Porche y coloca la Sangre de los inocentes en el blandón. Kirtonos acudirá a devorar tu alma.|nLucha con valentía, ¡no cedas ni una pulgada! Destruye a Kirtonos y vuelve con Eva Sarkhoff.‡Revenir à Scholomance avec le Sang des innocents. Trouver le porche et placer le Sang des innocents dans le brasero. Kirtonos viendra dévorer votre âme.|nCombattre vaillamment, sans perdre un pouce de terrain ! Détruire Kirtonos et revenir auprès d’Eva Sarkhoff.‡带着无辜者之血回到通灵学院，将它放在门廊的火盆下面，基尔图诺斯会前来吞噬你的灵魂。|n勇敢地战斗吧，不要退缩！杀死基尔图诺斯，然后回到艾瓦·萨克霍夫那儿。‡帶著無辜者之血回到通靈學院，將它放在門廊的火盆下面，基爾圖諾斯會前來吞噬妳的靈魂。|n勇敢地戰鬥吧，不要退縮！殺死基爾圖諾斯，然後回到艾瓦·薩克霍夫那兒。',
  }
},
[5385] = {
  {
    'Os Restos Mortais de Trey Forjaleve‡Останки Трея Светогорна‡Die Überreste von Trey Lightforge‡트레이 라이트포지의 유해‡Restos de Trey Forjaluz‡Los restos de Trey Forjaluz‡Les restes de Trey Lightforge‡特雷·莱弗治的残骸‡特雷·萊弗治的殘骸',
    nil,
    'Entregue os Restos Mortais de Trey Forjaleve a Jessir Lunarco, em Selva Maleva.‡Принесите останки Трея Светогорна Джессире Лунной Радуге в Оскверненный лес.‡Bringt die Überreste von Trey Lightforge zu Jessir Moonbow im Teufelswald.‡트레이 라이트포지의 유해를 악령의 숲에 있는 제시 문보우에게 가져다주어야 합니다.‡Lleva los Restos de Trey Forjaluz a Jessir Arcolunar a Frondavil.‡Lleva los Restos de Trey Forjaluz a Jessir Arcolunar a Frondavil.‡Rapporter le Cadavre de Trey Lightforge à Jessir Moonbow dans Gangrebois.‡将特雷·莱弗治的残骸交给费伍德森林的杰希尔·月弓。‡將特雷·萊弗治的殘骸交給費伍德森林的傑希爾·月弓。',
  }
},
[5386] = {
  {
    'Peixe do dia‡Дорога рыбка к обеду‡Der Fang des Tages‡낚시하는 날‡La pesca del día‡La pesca del día‡La prise du jour‡食鱼度日‡食魚度日',
    nil,
    'Converse com Jinar\'Zillen, na Aldeia Pescassombra, e depois leve 2 peixes pança-sangrenta para Nataoka Chifre Longo.‡Отправляйтесь в Деревню Ночных Охотников и поговорите с Джинар\'Зилленом, а затем принесите Натаке Длинному Рогу 2 рыбы-кровобрюха.‡Sprecht mit Jinar\'Zillen in Shadowprey und bringt Nataka Longhorn dann 2 Blutbauchfische.‡그늘수렵 마을에 있는 지나르질렌과 대화한 후 나타카 롱혼에게 붉은복어 2마리를 가져가야 합니다.‡Habla con Jinar\'Zillen, en la Aldea Cazasombras, y luego lleva 2 panzasangres a Nataka Cuerno Largo.‡Habla con Jinar\'Zillen, en la Aldea Cazasombras, y luego lleva 2 panzasangres a Nataka Cuerno Largo.‡Parler à Jinar\'Zillen à Proie-de-l\'Ombre, puis amener 2 poissons Ventre-rouge à Nataka Longhorn.‡与葬影村的吉纳泽林谈话，然后将2条血肚鱼交给纳塔卡·长角。‡與葬影村的吉納澤林談話，然後將2條血肚魚交給納塔卡·長角。',
  }
},
[5401] = {
  {
    'Ordem da Aurora Argêntea‡Жетон Серебряного Рассвета‡Anstecknadel der Argentumdämmerung‡은빛 여명회 위임봉‡Comisión del Alba Argenta‡Comisión de El Alba Argenta‡Brevet de l\'Aube d\'argent‡银色黎明委任徽章‡銀色黎明委任徽章',
