},
[17] = {
  {
    'Busca pelos reagentes de Uldaman‡В Ульдаман за реагентами‡Reagenzsuche in Uldaman‡울다만에서 재료 찾기‡Componentes de Uldaman‡Componentes de Uldaman‡Rechercher les composants à Uldaman‡奥达曼的蘑菇‡奧達曼的蘑菇',
    nil,
    'Leve 12 Campânulas de Fungo Magenta para Ghak Toquecura em Thelsamar.‡Принесите 12 грибов-малиновиков Гхаку Целителю в Телcамар.‡Bringt zwölf magenta Funguskappen nach Thelsamar zu Ghak Healtouch.‡텔사마에 있는 가크 힐터치에게 자홍버섯 12개를 가져가야 합니다.‡Lleva 12 setas moradas a Ghak Sanadón a Thelsamar.‡Lleva 12 setas magenta a Ghak Sanadón a Thelsamar.‡Apporter 12 Champignons magenta à Ghak Healtouch à Thelsamar.‡收集12颗紫色蘑菇，把它们交给塞尔萨玛的加克。‡收集12顆紫色蘑菇，把它們交給塞爾薩瑪的加克。',
  }
},
[18] = {
  {
    'Irmandade dos Ladrões‡Братство воров‡Bruderschaft der Diebe‡도둑 떼 소탕‡Hermandad de ladrones‡Hermandad de ladrones‡La confrérie des voleurs‡潜行者兄弟会‡潛行者兄弟會',
    nil,
    'Leve 12 Bandanas de Lona Vermelha para o Cabo Vilém diante da Abadia de Vila Norte.‡Принесите 12 красных холщовых бандан заместителю судьи Виллему к Аббатству Североземья.‡Bringt 12 rote Sackleinenkopftücher zu Deputy Willem in der Nähe der Abtei von Nordhain.‡노스샤이어 수도원 외부에 있는 부관 윌렘에게 붉은 삼베 복면 12개를 가져가야 합니다.‡Lleva 12 pañuelos de tela de saco rojo al ayudante Willem cerca de la Abadía de Villanorte.‡Lleva 12 pañuelos de arpillera roja al ayudante de alguacil Willem en las afueras de la Abadía de Villanorte.‡Apporter 12 Masques rouges à l’Adjoint Willem à l’extérieur de l’Abbaye de Northshire.‡给北郡的维里副队长带回12个红色粗麻面罩。‡給北郡的維裏副隊長帶回12個紅色粗麻面罩。',
  }
},
[19] = {
  {
    'Tharil\'zun‡Тарил\'зун‡Tharil\'zun‡타릴준‡Tharil\'zun‡Tharil\'zun‡Tharil\'zun‡萨瑞尔祖恩‡薩瑞爾祖恩',
    nil,
    'Leve a Cabeça do Tharil\'zun ao Oficial Marris em Cristarrubra.‡Принесите маршалу Маррису в Красногорье голову Тарил\'зуна.‡Bringt den Kopf von Tharil\'zun ins Rotkammgebirge zu Marshal Marris.‡붉은마루 산맥에 있는 치안대장 매리스에게 타릴준을 처치한 증거로 타릴준의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Tharil\'zun al alguacil Marris a Crestagrana.‡Lleva la cabeza de Tharil\'zun al alguacil Marris a Crestagrana.‡Rapporter la Tête de Tharil\'zun au maréchal Marris, dans les Carmines.‡将萨瑞尔祖恩的头颅带给湖畔镇的治安官马瑞斯。‡將薩瑞爾祖恩的頭顱帶給湖畔鎮的治安官馬瑞斯。',
  }
},
[20] = {
  {
    'Ameaça dos Rochas Negras‡Угроза Черной горы‡Bedrohung durch die Blackrock‡검은바위부족의 위협‡La amenaza de los Roca Negra‡La amenaza de los Roca Negra‡La menace des Blackrock‡黑石氏族的威胁‡黑石氏族的威脅',
    nil,
    'Traga 10 Machados Gastos em Batalha para o Oficial Marris na Vila Plácida.‡Принесите маршалу Маррису в Приозерье 10 иззубренных топоров.‡Bringt 10 kampferprobte Äxte nach Seenhain zu Marshal Marris.‡레이크샤이어에 있는 치안대장 매리스에게 마모된 도끼 10개를 가져가야 합니다.‡Lleva 10 restos de hacha de guerra al alguacil Marris a Villa del Lago.‡Lleva 10 hachas desgastadas por la batalla al alguacil Marris a Villa del Lago.‡Rapporter 10 Haches détériorées au maréchal Marris de Lakeshire.‡给湖畔镇的治安官马瑞斯带回10把破斧。‡給湖畔鎮的治安官馬瑞斯帶回10把破斧。',
  }
},
[21] = {
  {
    'Escaramuça na Serra do Eco‡Схватка у рудника Горного эха‡Scharmützel in der Echokammmine‡메아리 광산 전투‡Escarmuza en la Mina del eco‡Refriega en el Eco‡La bataille de la Crête aux échos‡回音山清剿行动‡回音山清剿行動',
    nil,
    'Mate 12 Operários Kobold, depois fale novamente com o Major Belmonte na Abadia de Vila Norte.‡Уничтожьте 12 кобольдов-работников и вернитесь к маршалу Макбрайду.‡Tötet 12 Koboldhilfsarbeiter und kehrt dann zu Marshal McBride in der Abtei von Nordhain zurück.‡코볼트 일꾼 12마리를 처치한 다음 노스샤이어 수도원에 있는 치안대장 맥브라이드에게 돌아가야 합니다.‡Mata 12 peones kobold y ve a hablar con el alguacil McBride a la Abadía de Villanorte.‡Mata 12 obreros kóbolds y luego regresa con el alguacil McBride en la Abadía de Villanorte.‡Tuer 12 Travailleurs kobold, puis revenir voir le maréchal McBride, à l’Abbaye de Northshire.‡杀死12只狗头人苦力，然后向北郡修道院里的治安官玛克布莱德复命。‡殺死12只狗頭人苦力，然後向北郡修道院裏的治安官瑪克布萊德復命。',
  }
},
[22] = {
  {
    'Empadão de Fígado de Goretusco‡Пирог из печени жутеклыка‡Pastete aus Geiferzahnleber‡뿔엄니멧돼지 간 파이‡Pastel de hígado de dentosangre‡Pastel de hígado de dentosangre‡La tourte au foie de Broche-tripes‡猪肝馅饼‡豬肝餡餅',
    nil,
    'Salma Saldanha precisa de 8 Fígados de Goretusco para fazer um Empadão de Fígado de Goretusco.‡Принесите Сальме Сальден 8 кусков печени жутеклыка, чтобы она могла испечь пирог.‡Salma Saldean braucht 8 Geiferzahnlebern für ihre Pastete aus Geiferzahnleber.‡뿔엄니멧돼지 간 파이를 만들 수 있도록 살마 살딘에게 뿔엄니멧돼지 간 8개를 가져가야 합니다.‡Salma Saldean necesita 8 hígados de dentosangre para hacer un pastel de hígado de dentosangre.‡Salma Saldean necesita 8 hígados de dentosangre para hacer un pastel de hígado de dentosangre.‡Salma Saldean a besoin de 8 Foies de Broche-tripes pour faire une Tourte au foie de Broche-tripes.‡萨尔玛·萨丁需要8片血牙野猪的肝来烹制猪肝馅饼。‡薩爾瑪·薩丁需要8片血牙野豬的肝來烹制豬肝餡餅。',
  }
},
[23] = {
  {
    'Pata de Ursangous‡Лапа Топтыжня‡Ursangus\' Tatze‡우르산고우스의 앞발‡La zarpa de Ursangous‡La pata de Ursangous‡La patte d\'Ursangous‡乌萨苟斯的爪子‡烏薩茍斯的爪子',
    nil,
    'Leve a Pata de Ursangous para Senani Coração Trovejante no Posto Machadada, Vale Gris.‡Принесите лапу Топтыжня Сенани Громовое Сердце на заставу Расщепленного Древа в Ясеневом лесу.‡Bringt Ursangus\' Tatze zu Senani Thunderheart im Splintertreeposten in Ashenvale.‡우르산고우스의 앞발을 잿빛 골짜기 토막나무 주둔지에 있는 세나니 썬더하트에게 가져가야 합니다.‡Llévale la zarpa de Ursangous a Senani Truenozón en el Puesto del Hachazo, Vallefresno.‡Llévale la pata de Ursangous a Senani Corazón Atronador en el Puesto del Hachazo, Vallefresno.‡Apporter la Patte d\'Ursangous à Senani Thunderheart, au Poste de Bois-brisé, à Ashenvale.‡将乌萨苟斯的爪子交给灰谷碎木哨岗的的塞娜尼·雷心。‡將烏薩茍斯的爪子交給灰谷碎木哨崗的的塞娜尼·雷心。',
  }
},
[24] = {
  {
    'Cabeça de Shadumbra‡Голова Тенумбры‡Schattumbras Kopf‡샤둠브라의 머리‡La cabeza de Shadumbra‡La cabeza de Shadumbra‡La tête de Shadumbra‡萨杜布拉的头颅‡薩杜布拉的頭顱',
    nil,
    'Leve a Cabeça de Shadumbra para Senani Coração Trovejante no Posto Machadada, Vale Gris.‡Принесите голову Тенумбры Сенани Громовое Сердце на заставу Расщепленного Древа в Ясеневом лесу.‡Bringt Schattumbras Kopf zu Senani Thunderheart im Splintertreeposten in Ashenvale.‡샤둠브라의 머리를 잿빛 골짜기 토막나무 주둔지에 있는 세나니 썬더하트에게 가져가야 합니다.‡Llévale la cabeza de Shadumbra a Senani Truenozón en el Puesto del Hachazo, Vallefresno.‡Lleva la cabeza de Shadumbra a Senani Corazón Atronador en el Puesto del Hachazo, Vallefresno.‡Apporter la Tête de Shadumbra à Senani Thunderheart, au Poste de Bois-brisé, dans Ashenvale.‡将萨杜布拉的头颅交给灰谷碎木哨岗的的塞娜尼·雷心。‡將薩杜布拉的頭顱交給灰谷碎木哨崗的的塞娜尼·雷心。',
  }
},
[25] = {
  {
    'Paralisação nas Torres de Pedra‡Остановка у Каменного Когтя‡Stillstand am Steinkrallenpfad‡돌발톱 산맥의 정체 해결‡Paso del Espolón bloqueado‡Paralización en Espolón‡Impasse aux Serres-Rocheuses‡石爪山的困境‡石爪山的困境',
    nil,
    'Liquide 12 Elementais da Água Contaminados no Lago Mistral, a leste do Túnel Garracava e a sudoeste de Posto Machadada.|nFaça o reconhecimento do gazebo do Lago Mistral, que fica de frente para o Entreposto da Aliança mais próximo.|nFale novamente com Mastok Wrilehiss em Posto Machadada, no Vale Gris.‡Истребите 12 злобных элементалей воды на озере Мистраль, что к востоку от Туннеля Когтя и к юго-западу от заставы Расщепленного Древа.|nИсследуйте беседку на озере Мистраль, из которой открывается вид на соседний форт Альянса.|nВернитесь к Мастоку Райльшипу на заставу Расщепленного Древа в Ясеневом лесу.‡Erledigt 12 beschmutzte Wasserelementare am Mystralsee östlich vom Steinkrallenpfad und südwestlich vom Splintertreeposten.|nErkundet den Pavillon am Mystralsee, der den nahen Außenposten der Allianz überblickt.|nKehrt zu Mastok Wrilehiss im Splintertreeposten in Ashenvale zurück.‡돌발톱 토굴길에서 동쪽으로, 그리고 토막나무 주둔지에서 남서쪽으로 있는 미스트랄 호수에서 타락한 물의 정령 12마리를 처치해야 합니다.|n미스트랄 호수에 있는 전망대로 가서 얼라이언스 전초기지를 살펴봐야 합니다.|n그런 다음 잿빛 골짜기 토막나무 주둔지에 있는 마스토크 윌리히스에게 돌아가십시오.‡Envía 12 elementales de agua podrida al Lago Mystral que esperan al este de El Paso del Espolón y al suroeste del Puesto del Hachazo.|nExplora la glorieta que está en el Lago Mystral y que domina la cercana avanzada de la Alianza.|nVuelve junto a Mastok Sibilante en el Puesto del Hachazo, Vallefresno.‡Elimina a 12 elementales de agua podrida en el Lago Mystral, hacia el este del Paso del Espolón y al sudoeste de Puesto del Hachazo.|nExplora la glorieta del Lago Mystral por encima de la avanzada de la Alianza cercana.|nVuelve con Mastok Bufido en Puesto Hachazo, Vallefresno.‡Tuer 12 Elémentaires d’eau corrompus au lac Mystral, à l’est de la Perce des Serres, et au sud-ouest du poste de Bois-brisé.|nFaire une reconnaissance sur le kiosque du lac Mystral ; celui qui a vue sur l’avant-poste de l’Alliance.|nRetourner voir Mastok Wrilehiss, au poste de Bois-brisé, dans Ashenvale.‡清除位于碎木哨岗西南和石爪小径正东的密斯特拉湖一带的12个污浊的水元素。|n在密斯特拉湖上的眺望台中侦查联盟的前哨站。|n返回灰谷慰藉之林的碎木哨岗，向马斯托克·维尔西斯报告。‡清除位於碎木哨崗西南和石爪小徑正東的密斯特拉湖壹帶的12個汙濁的水元素。|n在密斯特拉湖上的眺望臺中偵查聯盟的前哨站。|n返回灰谷慰藉之林的碎木哨崗，向馬斯托克·維爾西斯報告。',
  }
},
[26] = {
  {
    'Uma lição a aprender‡Необходимый урок‡Eine wertvolle Lektion‡귀중한 교훈‡Una lección que aprender‡Una lección que aprender‡Une leçon à apprendre‡必修的课程‡必修的課程',
    nil,
    'Fale com Dendrite Stellardor no vilarejo de Refúgio Noturno, na Clareira da Lua.‡Поговорите с Дендритом Блеском Звезд в селении Ночная Гавань на Лунной поляне.‡Sprecht mit Dendrite Starblaze im Dorf Nighthaven in Moonglade.‡달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈와 대화하십시오.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Dendrite Rafagaestelar.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Parler à Dendrite Starblaze, au village de Havrenuit, à Reflet-de-Lune.‡与月光林地永夜港的德迪利特·星焰谈一谈。‡與月光林地永夜港的德迪利特·星焰談壹談。',
  }
},
[27] = {
  {
    'Uma lição a aprender‡Необходимый урок‡Eine wertvolle Lektion‡꼭 배워야 할 교훈‡Una lección que aprender‡Una lección que aprender‡Une leçon à apprendre‡必修的课程‡必修的課程',
    nil,
    'Fale com Dendrite Stellardor no vilarejo de Refúgio Noturno, na Clareira da Lua.‡Поговорите с Дендритом Блеском Звезд в селении Ночная Гавань на Лунной поляне.‡Sprecht mit Dendrite Starblaze im Dorf Nighthaven in Moonglade.‡달의 숲의 나이트헤이븐에 있는 덴드리트 스타블레이즈와 대화해야 합니다.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Dendrite Rafagaestelar.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Parler à Dendrite Starblaze, au village de Havrenuit, à Reflet-de-Lune.‡与月光林地永夜港的德迪利特·星焰谈一谈。‡與月光林地永夜港的德迪利特·星焰談壹談。',
  }
},
[28] = {
  {
    'A prova do lago‡Испытание озера‡Prüfung des Sees‡엘룬아라 호수의 시험‡La prueba del lago‡La prueba del lago‡L\'épreuve du lac‡湖中试炼‡湖中試煉',
    nil,
    'Encontre um Adorno de Altar no Lago Eluna\'ara e leve-o para o Santuário de Remulos, na parte noroeste da Clareira da Lua. Use o Adorno de Altar lá dentro.|nVocê terá que falar com Tajarri, lá no santuário mesmo, para concluir a prova.‡Найдите безделушку святилища в озере Элуны и отнесите ее в святилище Ремулоса на северо-западе Лунной Поляны. Оказавшись там, воспользуйтесь безделушкой.|nПотом вам будет нужно поговорить с Таджарри в святилище, чтобы завершить испытание.‡Sucht ein Schreinschmuckstück im Elune\'ara See und bringt es zum Schrein von Remulos im Nordwesten von Moonglade. Wenn Ihr dort seid, benutzt das Schrein-Schmuckstück.|nIhr müsst anschließend mit Tajarri am Schrein sprechen, um die Prüfung abzuschließen.‡엘룬아라 호수에서 제단 구슬을 찾은 후, 달의 숲 북서부에 있는 레물로스의 제단으로 가져가야 합니다. 그곳에 이르면 제단 구슬을 사용하십시오.|n그런 다음 제단에 있는 타자리와 대화해야 시험이 끝나게 됩니다.‡Lleva un adorno de altar del Lago Elune\'ara al Santuario de Remulos, al noroeste de Claro de la Luna. Usa el adorno en el santuario.|nDespués, habla con Tajarri en el santuario para completar la prueba.‡Lleva un adorno de altar del Lago Elune\'ara al Santuario de Remulos, al noroeste de Claro de la Luna. Usa el adorno en el santuario.|nDespués, habla con Tajarri en el santuario para completar la prueba.‡Trouver un Colifichet du sanctuaire dans le Lac Elune\'ara, et l’apporter au sanctuaire de Remulos, au nord-ouest de Reflet-de-Lune. Une fois sur place, utiliser le Colifichet du sanctuaire.|nVous devez parler à Tajarri, au sanctuaire, afin de terminer l’épreuve.‡在月神湖寻找神殿灵珠，把它带到月光林地西北部的雷姆洛斯神殿去。在神殿中使用神殿灵珠，然后与神殿中的塔加里谈话来完成试炼。‡在月神湖尋找神殿靈珠，把它帶到月光林地西北部的雷姆洛斯神殿去。在神殿中使用神殿靈珠，然後與神殿中的塔加裏談話來完成試煉。',
  }
},
[29] = {
  {
    'A prova do lago‡Испытание озера‡Prüfung des Sees‡엘룬아라 호수의 시험‡La prueba del lago‡La prueba del lago‡L\'épreuve du lac‡湖中试炼‡湖中試煉',
    nil,
    'Encontre um Adorno de Altar no Lago Eluna\'ara e leve-o para o Santuário de Remulos, na parte noroeste da Clareira da Lua. Use o Adorno de Altar lá dentro.|nVocê terá que falar com Tajarri, lá no santuário mesmo, para concluir a prova.‡Найдите безделушку святилища в озере Элуны и отнесите ее в святилище Ремулоса на северо-западе Лунной Поляны. Оказавшись там, воспользуйтесь безделушкой.|nПотом вам будет нужно поговорить с Таджарри в святилище, чтобы завершить испытание.‡Sucht ein Schreinschmuckstück im Elune\'ara See und bringt es zum Schrein von Remulos im Nordwesten von Moonglade. Wenn Ihr dort seid, benutzt das Schrein-Schmuckstück.|nIhr müsst anschließend mit Tajarri am Schrein sprechen, um die Prüfung abzuschließen.‡엘룬아라 호수에서 제단 구슬을 찾은 후 달의 숲 북서부에 있는 레물로스의 제단으로 가져가야 합니다. 그곳에 이르면 제단 구슬을 사용하십시오.|n그런 다음 제단에 있는 타자리와 대화를 하면 이 시험을 통과하게 됩니다.‡Lleva un adorno de altar del Lago Elune\'ara al Santuario de Remulos, al noroeste de Claro de la Luna. Usa el adorno en el santuario.|nDespués, habla con Tajarri en el santuario para completar la prueba.‡Lleva un adorno de altar del Lago Elune\'ara al Santuario de Remulos, al noroeste de Claro de la Luna. Usa el adorno en el santuario.|nDespués, habla con Tajarri en el santuario para completar la prueba.‡Trouver un Colifichet du sanctuaire dans le Lac Elune\'ara, et l’apporter au sanctuaire de Remulos, au nord-ouest de Reflet-de-Lune. Une fois sur place, utiliser le Colifichet du sanctuaire.|nVous devez parler à Tajarri, au sanctuaire, afin de terminer l’épreuve.‡在月神湖寻找神殿灵珠，把它带到月光林地西北部的雷姆洛斯神殿去。在神殿中使用神殿灵珠，然后与神殿中的塔加里谈话来完成试炼。‡在月神湖尋找神殿靈珠，把它帶到月光林地西北部的雷姆洛斯神殿去。在神殿中使用神殿靈珠，然後與神殿中的塔加裏談話來完成試煉。',
  }
},
[30] = {
  {
    'Missão do leão marinho‡Испытание Морского Льва‡Prüfung des Seelöwen‡바다표범의 시험‡La prueba del león marino‡La prueba del león marino‡L\'épreuve du lion de mer‡海狮试炼‡海獅試煉',
    nil,
    'Encontre o Meio-pingente da Agilidade Aquática e o Meio-pingente da Resistência Aquática. Fale com os residentes da Clareira da Lua para obter pistas de onde esse itens podem estar.|nForme o Pingente do Leão Marinho a partir das duas metades. Você precisa estar perto do Santuário de Remulos para fazer isso.|nLeve o pingente reunido ao Dendrite Stellardor na vila de Refúgio Noturno, que fica na Clareira da Lua.‡Найдите половинку подвески Ловкости водяного облика и половинку подвески Выносливости водяного облика. Поговорите с жителями Лунной поляны, чтобы узнать, где могут находиться эти предметы.|nСложите из половинок подвеску Морского Льва. Для этого вам надо находиться рядом со святилищем Ремулоса.|nОтнесите собранную подвеску Дендриту Блеску Звезд в деревню Ночная Гавань что на Лунной поляне.‡Sucht die Anhängerhälfte der Wasserbeweglichkeit und die Anhängerhälfte der Wasserausdauer. Sprecht mit den Einwohnern von Moonglade, um Hinweise darauf zu erhalten, wo sich diese Gegenstände befinden könnten.|nFormt den Anhänger des Seelöwen aus den beiden Anhängerhälften. Ihr müsst in der unmittelbaren Nähe des Schreins von Remulos sein, um dies zu tun.|nBringt den zusammengefügten Anhänger zu Dendrite Starblaze nach Nighthaven in Moonglade.‡민첩성의 바다 펜던트 반쪽과 인내의 바다 펜던트 반쪽을 찾아야 합니다. 달의 숲 주민들과 얘기하여 이 물건들이 있을 만한 곳에 대한 단서를 얻으십시오.|n두 개의 반쪽을 찾아 바다표범의 펜던트를 만들어야 합니다. 반드시, 레물로스의 제단 근처에서만 하나로 합칠 수 있습니다.|n완성된 펜던트를 달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 가져가십시오.‡Busca el colgante de Agilidad acuática y el colgante de Resistencia acuática. Habla con la gente de Claro de la Luna para conseguir pistas sobre la ubicación de los colgantes.|nForma el colgante del león marino con los otros dos cuando estés cerca del Santuario de Remulos.|nLleva el colgante completo a Dendrite Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Busca el colgante de Agilidad acuática y el colgante de Resistencia acuática. Habla con la gente de Claro de la Luna para conseguir pistas sobre la ubicación de los colgantes.|nForma el colgante del león marino con los otros dos cuando estés cerca del Santuario de Remulos.|nLleva el colgante completo a Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Trouver le Demi-pendentif d\'agilité aquatique et le Demi-pendentif d\'endurance aquatique. Parler aux habitants de Reflet-de-Lune pour obtenir des indices quant à l’endroit où ces objets se trouvent.|nReformer le Pendentif du lion de mer à partir des deux moitiés. Vous devez vous trouver à proximité du sanctuaire de Remulos pour faire cela.|nApporter le Pendentif reformé à Dendrite Starblaze, au village de Havrenuit, à Reflet-de-Lune.‡寻找水兽耐力坠饰和水兽敏捷坠饰。与月光林地的居民谈一谈，找出这些东西可能被放在哪里。|n在雷姆洛斯神殿附近将海狮坠饰的两部分合而为一。|n将合并好的坠饰交给月光林地永夜港中的德迪利特·星焰。‡尋找水獸耐力墜飾和水獸敏捷墜飾。與月光林地的居民談壹談，找出這些東西可能被放在哪裏。|n在雷姆洛斯神殿附近將海獅墜飾的兩部分合而為壹。|n將合並好的墜飾交給月光林地永夜港中的德迪利特·星焰。',
  }
},
[31] = {
  {
    'Forma aquática‡Водный облик‡Wassergestalt‡바다표범 변신‡Forma acuática‡Forma acuática‡Forme aquatique‡水栖形态‡水棲形態',
    nil,
    'Volte ao Penhasco do Trovão e mostre a Turak Runa Totem o Pingente do Leão Marinho.‡Возвращайтесь в Громовой Утес и покажите Тюраку Руническому Тотему подвеску Морского Льва.‡Kehrt nach Thunder Bluff zurück und zeigt Turak Runetotem den Anhänger des Seelöwen.‡썬더 블러프로 돌아가 투락 룬토템에게 바다표범의 펜던트를 보여 주어야 합니다.‡Vuelve a Cima del Trueno y enséñale el colgante del león marino a Turak Tótem Rúnico.‡Vuelve a Cima del Trueno y enséñale el colgante del león marino a Turak Tótem de Runa.‡Retourner à Thunder Bluff et montrer le Pendentif du lion de mer à Turak Runetotem.‡回到雷霆崖，让图拉克·符文图腾看看你的海狮坠饰。‡回到雷霆崖，讓圖拉克·符文圖騰看看妳的海獅墜飾。',
  }
},
[32] = {
  {
    'A ascensão dos silitídeos‡Восхождение силитидов‡Aufstieg der Silithid‡실리시드의 전조‡La sublevación de los silítidos‡La sublevación de los silítidos‡L\'ascension des silithides‡异种蝎的威胁‡異種蠍的威脅',
    nil,
    'Leve o relatório para Zilzibin Tamborleiro em Orgrimmar.‡Отнесите отчет Зилзибину Барабанному Бою в Оргриммар.‡Bringt den Bericht nach Orgrimmar zu Zilzibin Drumlore.‡오그리마에 있는 질지빈 드럼로어에게 보고서를 가져가야 합니다.‡Entrégale el informe a Zilzibin Tambor Sabio en Orgrimmar.‡Entrégale el informe a Zilzibin Tambor Sabio en Orgrimmar.‡Apporter le rapport à Zilzibin Drumlore à Orgrimmar.‡把报告带给奥格瑞玛的基尔兹宾·鼓眼。‡把報告帶給奧格瑞瑪的基爾茲賓·鼓眼。',
  }
},
[33] = {
  {
    'Só louco não come lobo‡Волки на границе‡Wölfe an der Grenze‡변경의 늑대들‡Los lobos cruzan la frontera‡Lobos en la frontera‡Les loups derrière la frontière‡林中的群狼‡林中的群狼',
    nil,
    'Leve 8 pedaços de Carne Dura de Lobo para Enzo Peleteiro nos arredores da Abadia de Vila Norte.‡Принесите 8 кусков жесткой волчатины Игану Меховщику к Аббатству Североземья.‡Bringt Eagan Peltskinner, den Ihr vor der Abtei von Nordshire findet, 8 Stücke zähes Wolfsfleisch.‡노스샤이어 수도원 바깥에 있는 이건 펠트스키너에게 질긴 늑대 고기 8덩이를 가져가야 합니다.‡Lleva 8 piezas de carne dura de lobo a Eagan Desollapieles junto a la Abadía de Villanorte.‡Traéle 8 piezas de carne de lobo dura a Eagan Desollapelambres fuera de la Abadía de Villanorte.‡Apporter 8 pièces de Viande de loup coriace à Eagan Peltskinner, à l’extérieur de l’Abbaye de Northshire.‡给北郡修道院外的伊根·派特斯金纳带回8块硬狼肉。‡給北郡修道院外的伊根·派特斯金納帶回8塊硬狼肉。',
  }
},
[34] = {
  {
    'O penetra‡Незваный гость‡Ein ungebetener Gast‡불청객‡Una visita poco grata‡Una visita poco grata‡Un indésirable‡不速之客‡不速之客',
    nil,
    'Martie Jainrose, de Vila Plácida, quer que você mate Ronquifuça. Traga a presa dele como prova.‡Убейте Грубобрюха. Принесите Марти Джанроз клык вепря.‡Martie Jainrose aus Seenhain möchte, dass Ihr Stopfwanst tötet. Bringt ihr den Hauer des Ebers zum Beweis.‡레이크샤이어의 마티 제인로즈가 서리먹보를 처치해 달라고 부탁했습니다. 마티 제인로즈에게 서리먹보의 어금니를 증거로 가져가야 합니다.‡Martie Jainrose de Villa del Lago quiere que mates a Panzallena. LLévale un colmillo como prueba.‡Martie Jainrose de Villa del Lago quiere que mates a Panzallena. Llévale un colmillo como prueba.‡Martie Jainrose de Lakeshire veut que vous tuiez Fouailleventre. Ramenez-lui ses défenses comme preuve.‡湖畔镇的玛蒂·詹罗斯要求你杀死贝利格拉布，并带回它的獠牙作为证明。‡湖畔鎮的瑪蒂·詹羅斯要求妳殺死貝利格拉布，並帶回它的獠牙作為證明。',
  }
},
[35] = {
  {
    'Mais preocupações‡Новые заботы‡Weitere Sorgen‡소문의 진상‡Más preocupaciones‡Más preocupaciones‡Inquiétudes supplémentaires‡卫兵托马斯‡衛兵托馬斯',
    nil,
    'O Delegado Durão quer que você fale com o Guarda Tomás.‡Поговорите со стражником Томасом.‡Marshal Dughan möchte, dass Ihr mit Wache Thomas sprecht.‡치안대장 더그한이 경비병 토마스와 대화해 달라고 부탁했습니다.‡El alguacil Dughan quiere que hables con el guardia Thomas.‡El alguacil Dughan quiere que hables con el guardia Thomas.‡Le maréchal Dughan veut que vous parliez au garde Thomas.‡治安官杜汉要你和卫兵托马斯谈一谈。‡治安官杜漢要妳和衛兵托馬斯談壹談。',
  }
},
[36] = {
  {
    'Ensopado de Cerro Oeste‡Похлебка Западного Края‡Westfall-Eintopf‡서부정통 스튜‡Estofado de los Páramos de Poniente‡Estofado de los Páramos de Poniente‡Le ragoût de la marche de l\'Ouest‡杂味炖肉‡雜味燉肉',
    nil,
    'Vera Taturana quer que você entregue a receita de Ensopado de Cerro Oeste dela a Salma Saldanha.‡Отнесите Сальме Сальден рецепт похлебки Западного Края.‡Verna Furlbrow möchte, dass Ihr ihr Rezept für Westfall-Eintopf bei Salma Saldean abliefert.‡베르나 펄브로우가 살마 살딘에게 서부정통 스튜 조리법을 전해 달라고 부탁했습니다.‡Verna Furlbrow quiere que le entregues su receta del estofado de los Páramos de Poniente a Salma Saldean.‡Verna Cejade quiere que le entregues su receta del estofado de los Páramos de Poniente a Salma Saldean.‡Verna Furlbrow veut que vous apportiez la Recette du ragoût de la marche de l\'Ouest à Salma Saldean.‡弗娜·法布隆要求你将她的杂味炖肉食谱交给萨尔玛·萨丁。‡弗娜·法布隆要求妳將她的雜味燉肉食譜交給薩爾瑪·薩丁。',
  }
},
[37] = {
  {
    'Encontre os guardas perdidos‡Пропавшие стражи‡Suche nach den vermissten Wachen‡사라진 경비병 수색‡Encuentra a los guardias perdidos‡Encuentra a los guardias perdidos‡Trouver les gardes disparus‡失踪的卫兵‡失蹤的衛兵',
    nil,
    'O Guarda Tomás quer que você vá para o norte, seguindo o rio, e encontre os dois guardas perdidos, Rodolfo e Malaquias.‡Отправляйтесь на север по реке и отыщите следы пропавших стражников – Рольфа и Малакаи.‡Wache Thomas möchte, dass Ihr den Fluss in Richtung Norden nach Rolf und Malakai, den beiden vermissten Wachen, absucht.‡경비병 토마스가 강 북쪽으로 가서 사라진 두 경비병, 롤프와 말라카이를 찾아달라고 부탁했습니다.‡El guardia Thomas quiere que viajes al norte, río arriba, y busques a sus dos guardias, Rolf y Malakai.‡El guardia Thomas quiere que viajes al norte, río arriba, y busques a sus dos guardias, Rolf y Malakai.‡Le garde Thomas veut que vous alliez vers le nord, le long de la rivière, à la recherche de deux gardes disparus, Rolf et Malakai.‡卫兵托马斯要你沿着河岸向北走，寻找两个失踪的卫兵罗尔夫和马拉凯。‡衛兵托馬斯要妳沿著河岸向北走，尋找兩個失蹤的衛兵羅爾夫和馬拉凱。',
  }
},
[38] = {
  {
    'Ensopado de Cerro Oeste‡Похлебка Западного Края‡Westfall-Eintopf‡서부정통 스튜 조리‡Estofado de los Páramos de Poniente‡Estofado de los Páramos de Poniente‡Le ragoût de la marche de l\'Ouest‡杂味炖肉‡雜味燉肉',
    nil,
    'Salma Saldanha quer 3 nacos de Acém de Abutre, 3 Focinhos de Goretusco, 3 Olhos de Murloc e 3 Quiabos.‡Принесите Сальме Сальден 3 куска жилистого мяса стервятника, 3 рыла жутеклыка, 3 глаза мурлока и 3 окры.‡Salma Saldean möchte 3 Stücke sehniges Geierfleisch, 3 Geiferzahnschnauzen, 3 Murlocaugen und 3 Okraschoten.‡살마 살딘이 식인독수리 고기 3개, 뿔엄니멧돼지 주둥이 3개, 멀록 눈알 3개, 그리고 오크라 3개를 구해 달라고 부탁했습니다.‡Salma Saldean quiere 3 carnes fibrosas de buitre, 3 morros de dentosangre, 3 ojos de múrloc y 3 okras.‡Salma Saldean quiere 3 carnes fibrosas de buitre, 3 morros de dentosangre, 3 ojos de múrloc y 3 okras.‡Salma Saldean veut 3 morceaux de Viande filandreuse de vautour, 3 Groins de Broche-tripes, 3 Yeux de murloc et 3 Okras.‡萨尔玛·萨丁需要3块秃鹫肉条、3只血牙野猪的头、3颗鱼人的眼睛和3棵秋葵。‡薩爾瑪·薩丁需要3塊禿鷲肉條、3只血牙野豬的頭、3顆魚人的眼睛和3棵秋葵。',
  }
},
[39] = {
  {
    'O relatório de Tomás‡Донесение Томаса‡Zustellung von Thomas\' Bericht‡토마스의 보고 전달‡Entrega el informe de Thomas‡Entrega el informe de Thomas‡Remettre le rapport de Thomas‡托马斯的报告‡托馬斯的報告',
    nil,
    'Apresente-se ao Delegado Durão na Vila d\'Ouro.‡Доставьте донесение в Златоземье маршалу Дугхану.‡Erstattet Marshal Dughan in Goldhain Bericht.‡골드샤이어에 있는 치안대장 더그한에게 보고해야 합니다.‡Preséntate ante el alguacil Dughan en Villadorada.‡Preséntate ante el alguacil Dughan en Villadorada.‡Avertir le maréchal Dughan de Goldshire.‡到闪金镇去向治安官杜汉报告。‡到閃金鎮去向治安官杜漢報告。',
  }
},
[40] = {
  {
    'Perigo anfíbio‡Водяная нечисть‡Gefahr aus dem Wasser‡멀록의 위협‡Un peligro con olor a pescado‡Un peligro con olor a pescado‡Péril en la rivière‡鱼人的威胁‡魚人的威脅',
    nil,
    'Remy "Duas Vezes" quer que você fale com o Delegado Durão em Vila d\'Ouro.‡Реми Повторюх просит вас найти в Златоземье маршала Дугхана и поговорить с ним.‡Remy "Zweifach" möchte, dass Ihr in Goldhain mit Marshal Dughan sprecht.‡말더듬이 레미가 골드샤이어에 있는 치안대장 더그한과 대화해 달라고 부탁했습니다.‡Remy Dos Veces quiere que hables con el alguacil Dughan de Villadorada.‡Remy "Dos Veces" quiere que hables con el alguacil Dughan de Villadorada.‡Remy "Deux fois" veut que vous parliez au maréchal Dughan à Goldshire.‡雷米要你去和闪金镇的治安官杜汉谈一谈。‡雷米要妳去和閃金鎮的治安官杜漢談壹談。',
  }
},
[45] = {
  {
    'Descubra o destino de Rodolfo‡Судьба Рольфа‡Rolfs Schicksal‡롤프의 생사 확인‡Descubre el destino de Rolf‡Descubre el destino de Rolf‡La destinée de Rolf‡罗尔夫的下落‡羅爾夫的下落',
    nil,
    'Vasculhe o vilarejo murloc e tente encontrar Rodolfo ou vestígios de sua morte.‡Обыщите поселение мурлоков и найдите Рольфа – или подтверждение его смерти.‡Durchsucht das Murlocdorf nach Rolf - oder nach Anzeichen für seinen Tod.‡멀록 마을에서 롤프의 생사를 확인해야 합니다.‡Busca a Rolf o alguna prueba de su muerte en el poblado múrloc.‡Busca a Rolf o alguna prueba de su muerte en el poblado múrloc.‡Fouiller le village des murlocs pour trouver Rolf ou des traces de sa mort.‡到鱼人村去寻找罗尔夫，或是他死亡的消息。‡到魚人村去尋找羅爾夫，或是他死亡的消息。',
  }
},
[46] = {
  {
    'Barbatanas de molho‡Награда за мурлоков‡Kopfgeld auf die Murlocs‡멀록 현상금‡Recompensas por los murlocs‡Recompensas por los múrlocs‡Des primes pour les murlocs‡悬赏鱼人‡懸賞魚人',
    nil,
    'Leve 8 Barbatanas Rasgadas de Murloc para o Guarda Tomás na ponte leste de Elwynn.‡Принесите 8 плавников мурлоков к восточному мосту Элвиннского леса и отдайте их стражнику Томасу.‡Bringt 8 zerrissene Murlocflossen zu Wache Thomas, den ihr an der östlichen Elwynn-Brücke findet.‡엘윈 숲 다리 동쪽에 있는 경비병 토마스에게 찢어진 멀록 지느러미 8개를 가져가야 합니다.‡Lleva 8 aletas de múrloc rotas al guardia Thomas al puente oriental de Elwynn.‡Lleva 8 aletas de múrloc rotas al guardia Thomas al puente oriental de Elwynn.‡Ramener 8 Ailerons de murloc au garde Thomas au Pont est d\'Elwynn.‡给艾尔文森林东部的桥边的卫兵托马斯带去8个破损的鱼人鳞片。‡給艾爾文森林東部的橋邊的衛兵托馬斯帶去8個破損的魚人鱗片。',
  }
},
[47] = {
  {
    'Trocando Pó de Ouro‡Золотая пыль‡Tauschhandel mit Goldstaub‡금가루 거래‡Intercambio de polvo de oro‡Intercambio de polvo de oro‡L\'échange de poussière d\'or‡金砂交易‡金砂交易',
    nil,
    'Traga 10 Pós de Ouro para Remy "Duas Vezes" em Vila d\'Ouro. O Pó de Ouro é coletado dos Kobolds na Floresta de Elwynn.‡Принесите 10 порций Золотой пыли в Златоземье Реми Повторюху. Золотую пыль можно добыть у кобольдов в Элвиннском лесу.‡Bringt 10 Einheiten Goldstaub nach Goldhain zu Remy "Zweifach". Goldstaub findet Ihr bei den Kobolden im Wald von Elwynn.‡골드샤이어에 있는 말더듬이 레미에게 금가루 10개를 가져가야 합니다. 금가루는 엘윈 숲에 있는 코볼트로부터 얻을 수 있습니다.‡Lleva 10 unidades de polvo de oro a Remy Dos Veces a Villadorada. Puedes obtener polvo de oro de los kobolds del Bosque de Elwynn.‡Lleva 10 unidades de polvo de oro a Remy "Dos Veces" a Villadorada. Puedes obtener polvo de oro de los kóbolds del Bosque de Elwynn.‡Rapporter 10 Poussières d\'or à Remy "Deux fois" à Goldshire. La Poussière d\'or se récupère sur les kobolds dans la forêt d\'Elwynn.‡为闪金镇的雷米收集10袋金砂，这种东西可以从艾尔文森林的狗头人身上找到。‡為閃金鎮的雷米收集10袋金砂，這種東西可以從艾爾文森林的狗頭人身上找到。',
  }
},
[48] = {
  {
    'Doce âmbar‡Янтарное сладкое‡Goldbrauner Samt‡달콤한 황색 맥주‡Dulce ámbar‡Dulce ámbar‡Doux whisky‡琥珀酒‡琥珀酒',
    nil,
    'Leve Água da Fonte Abençoada para Canabraba Cervaforte.‡Принесите Мрачнобуху Громовару воду святого источника.‡Bringt Grimbooze Donnerbräu Wasser von der Heiligen Quelle.‡그림부즈 썬더브루에게 신성한 샘물을 가져가야 합니다.‡Lleva agua sagrada de manantial a Tragoamargo Cebatruenos.‡Lleva agua del manantial sagrado a Tragoamargo Cebatruenos.‡Rapporter de l\'Eau de source sacrée à Grimbooze Thunderbrew.‡把圣泉之水带给葛瑞姆·雷酒。‡把聖泉之水帶給葛瑞姆·雷酒。',
  }
},
[49] = {
  {
    'Doce âmbar‡Янтарное сладкое‡Goldbrauner Samt‡달콤한 황색 맥주‡Dulce ámbar‡Dulce ámbar‡Doux whisky‡琥珀酒‡琥珀酒',
    nil,
    'Canabraba Cervaforte quer um Saco de Cevada, um Saco de Centeio e um Saco de Milho.‡Принесите Мрачнобуху Громовару мешок ячменя, мешок ржи и мешок кукурузы.‡Grimbooze Donnerbräu möchte einen Sack Gerste, einen Sack Roggen und einen Sack Korn haben.‡그림부즈 썬더브루에게 보리, 호밀, 옥수수 부대를 가져가야 합니다.‡Tragoamargo Cebatruenos quiere un saco de cebada, un saco de centeno y un saco de maíz.‡Tragoamargo Cebatruenos quiere un saco de cebada, un saco de centeno y un saco de maíz.‡Grimbooze Thunderbrew veut un Sac d\'orge, un Sac de seigle et un Sac de maïs.‡葛瑞姆·雷酒需要大麦、黑麦和玉米各一袋。‡葛瑞姆·雷酒需要大麥、黑麥和玉米各壹袋。',
  }
},
[50] = {
  {
    'Doce âmbar‡Янтарное сладкое‡Goldbrauner Samt‡달콤한 황색 맥주‡Dulce ámbar‡Dulce ámbar‡Doux whisky‡琥珀酒‡琥珀酒',
    nil,
    'Canabraba Cervaforte quer Veraprata.‡Принесите Мрачнобуху Громовару истинное серебро.‡Grimbooze Donnerbräu braucht Echtsilber.‡그림부즈 썬더브루에게 진은 주괴를 가져가야 합니다.‡Tragoamargo Cebatruenos quiere veraplata.‡Tragoamargo Cebatruenos quiere veraplata.‡Grimbooze Thunderbrew veut du Vrai-argent.‡葛瑞姆·雷酒需要一些真银。‡葛瑞姆·雷酒需要壹些真銀。',
  }
},
[51] = {
  {
    'Doce âmbar‡Янтарное сладкое‡Goldbrauner Samt‡달콤한 황색 맥주‡Dulce ámbar‡Dulce ámbar‡Doux whisky‡琥珀酒‡琥珀酒',
    nil,
    'Leve um Galho de Plátano para Canabraba Cervaforte.‡Принесите Мрачнобуху Громовару ветку смоковницы.‡Bringt Grimbooze Donnerbräu den Ast eines Bergahorns.‡그림부즈 썬더브루에게 플라타너스 가지 하나를 가져가야 합니다.‡Lleva una rama de sicomoro a Tragoamargo Cebatruenos.‡Lleva una rama de sicomoro a Tragoamargo Cebatruenos.‡Apporter une Branche de sycomore à Grimbooze Thunderbrew.‡带给葛瑞姆·雷酒一枝枫树枝。‡帶給葛瑞姆·雷酒壹枝楓樹枝。',
  }
},
[52] = {
  {
    'Proteja a fronteira‡Защита границы‡Grenzschutz‡변경 방어‡Proteger la frontera‡Proteger la frontera‡Protéger la frontière‡保卫边境‡保衛邊境',
    nil,
    'Mate 8 Predadores e 5 Jovens Ursos da Floresta, e fale novamente com o Guarda Tomás na ponte leste de Elwynn.‡Убейте 8 лесных хищников и 5 молодых лесных медведей. Затем вернитесь к стражнику Томасу у восточного моста Элвиннского леса.‡Tötet 8 Streuner und 5 junge Waldbären und kehrt dann zu Wache Thomas an der östlichen Elwynn-Brücke zurück.‡굶주린 늑대 8마리와 새끼곰 5마리를 사냥한 다음 엘윈 숲 동쪽 다리에 있는 경비병 토마스에게 돌아가십시오.‡Mata a 8 merodeadores y a 5 osos del bosque jóvenes y vuelve con el guardia Thomas al puente oriental de Elwynn.‡Mata a 8 merodeadores y a 5 osos del bosque jóvenes y vuelve a ver al guardia Thomas al puente oriental de Elwynn.‡Tuer 8 Rôdeurs et 5 Jeunes ours des forêts, et revenir voir le garde Thomas au pont, à l\'est d’Elwynn.‡杀掉8只觅食的灰狼和5只森林熊幼崽，然后回到艾尔文森林东部的桥边去见卫兵托马斯。‡殺掉8只覓食的灰狼和5只森林熊幼崽，然後回到艾爾文森林東部的橋邊去見衛兵托馬斯。',
  }
},
[53] = {
  {
    'Doce âmbar‡Янтарное сладкое‡Goldbrauner Samt‡달콤한 황색 맥주‡Dulce ámbar‡Dulce ámbar‡Doux whisky‡琥珀酒‡琥珀酒',
    nil,
    'Leve uma braçada de Carvalho Calcinado para Canabraba Cervaforte.‡Принесите Мрачнобуху Громовару вязанку обуглившихся дубовых поленьев.‡Bringt Grimbooze Donnerbräu ein verkohltes Eichenbündel.‡그림부즈 썬더브루에게 참나무 숯 한 묶음을 가져가야 합니다.‡Lleva un fajo de roble quemado a Tragoamargo Cebatruenos.‡Lleva un montón de roble carbonizado a Tragoamargo Cebatruenos.‡Apporter un Fagot de chêne à Grimbooze Thunderbrew.‡给葛瑞姆·雷酒带去一捆烧焦的橡木。‡給葛瑞姆·雷酒帶去壹捆燒焦的橡木。',
  }
},
[54] = {
  {
    'Apresente-se em Vila d\'Ouro‡Донесение в Златоземье‡Meldung in Goldhain‡골드샤이어로의 전갈‡Informa en Villadorada‡Informa en Villadorada‡Rapport pour Goldshire‡去闪金镇报到‡去閃金鎮報到',
    nil,
    'Entregue os Documentos do Major Belmonte para o Delegado Durão em Vila d\'Ouro.‡Отнесите документы маршала Макбрайда маршалу Дугхану в Златоземье.‡Liefert Marshal McBrides Unterlagen bei Marshal Dughan in Goldhain ab.‡골드샤이어에 있는 치안대장 더그한에게 치안대장 맥브라이드의 문서를 가져가야 합니다.‡Lleva los documentos del alguacil McBride al alguacil Dughan a Villadorada.‡Llévale los documentos del alguacil McBride al alguacil Dughan en Villadorada.‡Apporter les documents du maréchal McBride au maréchal Dughan de Goldshire.‡将治安官玛克布莱德的文件带给闪金镇的治安官杜汉。‡將治安官瑪克布萊德的文件帶給閃金鎮的治安官杜漢。',
  }
},
[55] = {
  {
    'Morbídio Vil‡Морбент Скверн‡Morbent Fel‡모벤트 펠‡Morbent Vil‡Morbent Vil‡Morbent Fel‡摩本特·费尔‡摩本特·費爾',
    nil,
    'Use a Desgraça de Morbídio em Morbídio Vil, mate Morbídio Vil, depois devolva a Desgraça de Morbídio a Noel, que está em seu acampamento.‡Примените Проклятье Морбента против Морбента Скверна, убейте его и верните Проклятье Морбента в лагерь Свена.‡Verwendet Morbents Bann gegen Morbent Fel, tötet Morbent Fel und bringt Morbents Bann anschließend zu Sven in dessen Lager zurück.‡모벤트 파멸의 불꽃을 사용하여 모벤트 펠을 처치하고 스벤의 야영지에 있는 스벤에게 모벤트 파멸의 불꽃을 돌려줘야 합니다.‡Utiliza la Pesadilla de Morbent contra Morbent Vil, mata a Morbent Vil y luego ve al campamento de Sven y devuélvele la Pesadilla de Morbent.‡Utiliza la pesadilla de Morbent contra Morbent Vil, mata a Morbent Vil y luego ve al campamento de Sven y devuélvele la pesadilla de Morbent.‡Utiliser le Fléau de Morbent sur Morbent Fel, tuer Morbent Fel, puis rapporter le Fléau de Morbent à Sven, dans son camp.‡对摩本特·费尔使用摩本特的克星，杀掉他，然后把摩本特的克星交给斯温。‡對摩本特·費爾使用摩本特的克星，殺掉他，然後把摩本特的克星交給斯溫。',
  }
},
[56] = {
  {
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡Vigilancia nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
    nil,
    'A Comandante Aldora Ebanez da Vila Sombria quer que você mate 8 Guerreiros Descarnados e 6 Magos Descarnados.‡Убейте 8 скелетов-воинов и 6 магов-скелетов по просьбе командира Алтеи Чернодрев.‡Kommandantin Althea Ebonlocke aus Dunkelhain möchte, dass Ihr 8 Skelettkrieger und 6 Skelettmagier tötet.‡다크샤이어의 사령관 알시아 이본로크가 해골 전사 8마리와 해골 마법사 6마리를 처치해 달라고 부탁했습니다.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 8 guerreros esqueléticos y 6 magos esqueléticos.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 8 guerreros esqueléticos y a 6 magos esqueléticos.‡Le commandant Althea Ebonlocke de Darkshire veut que vous tuiez 8 Guerriers squelettes et 6 Mages squelettes.‡夜色镇的指挥官指挥官阿尔泰娅·埃伯洛克要你去杀掉8个骷髅战士和6个骷髅法师。‡夜色鎮的指揮官指揮官阿爾泰婭·埃伯洛克要妳去殺掉8個骷髏戰士和6個骷髏法師。',
  }
},
[57] = {
  {
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡Vigilancia nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
    nil,
    'A Comandante Aldora Ebanez da Vila Sombria quer que você mate 15 Malévolos Descarnados e 15 Horrores Descarnados.‡Убейте 15 скелетов-губителей и 15 ужасных скелетов по просьбе командира Алтеи Чернодрев.‡Kommandantin Althea Ebonlocke aus Dunkelhain möchte, dass Ihr 15 Skelettsatanskreaturen und 15 Skelettschrecken tötet.‡다크샤이어의 사령관 알시아 이본로크가 해골 악령 15마리와 해골 병사 15마리를 처치해 달라고 부탁했습니다.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 15 mefistos esqueléticos y 15 horrores esqueléticos.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 15 malignos esqueléticos y a 15 horrores esqueléticos.‡Le commandant de Darkshire, Althea Ebonlocke, veut que vous tuiez 15 Démons squelettes et 15 Squelettes infernaux.‡指挥官阿尔泰娅·埃伯洛克要你去杀掉15个骸骨魔和15个恐怖骸骨。‡指揮官阿爾泰婭·埃伯洛克要妳去殺掉15個骸骨魔和15個恐怖骸骨。',
  }
},
[58] = {
  {
    'A Vigília Noturna‡Ночной дозор‡Die Nachtwache‡어둠의 순찰대‡Vigilancia nocturna‡La Guardia Nocturna‡Les Veilleurs‡守夜人‡守夜人',
    nil,
    'A Comandante Aldora Ebanez da Vila Sombria quer que você mate 20 vetores da peste no mausoléu leste do Monte Corvo.‡Убейте 20 распространителей чумы в восточном мавзолее Вороньего холма по просьбе командира Алтеи Чернодрев.‡Kommandantin Althea Ebonlocke aus Dunkelhain möchte, dass Ihr im östlichen Mausoleum von Rabenflucht 20 Seuchenverbreiter tötet.‡다크샤이어의 사령관 알시아 이본로크가 까마귀 언덕 묘지 동쪽에 있는 역병걸린 시체 20마리를 처치해 달라고 부탁했습니다.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 20 propagadores de la Peste en el mausoleo oriental de Cerro del Cuervo.‡La comandante Althea Cerranegro de Villa Oscura quiere que mates a 20 propagadores de peste en el mausoleo oriental de Cerro del Cuervo.‡Le commandant de Darkshire, Althea Ebonlocke, veut que vous tuiez 20 Répandeurs de peste dans le mausolée est de Colline-aux-Corbeaux.‡夜色镇的指挥官阿尔泰娅·埃伯洛克要你到乌鸦岭的东部陵墓去杀20个瘟疫食尸鬼。‡夜色鎮的指揮官阿爾泰婭·埃伯洛克要妳到烏鴉嶺的東部陵墓去殺20個瘟疫食屍鬼。',
  }
},
[59] = {
  {
    'Armadura de pano e couro‡Броня из кожи и ткани‡Rüstung aus Tuch und aus Leder‡천 갑옷과 가죽 갑옷‡Armadura de tela y cuero‡Armadura de paño y cuero‡Les armures de cuir et d\'étoffe‡布甲和皮甲‡布甲和皮甲',
    nil,
    'Dê o Vale-armadura de Ventobravo para Sara Albernaz.‡Отдайте Саре Тимберлейн знак брони Штормграда.‡Gebt Sara Timberlain den Rüstungsgutschein der Armee von Stormwind.‡사라 팀버레인에게 스톰윈드 갑옷 문장을 주어야 합니다.‡Entrega a Sara Timberlain el marcador de armaduras de Ventormenta.‡Entrega a Sara Timberlain el marcador de armaduras de Ventormenta.‡Donner le Bon pour une pièce d\'armure de Stormwind à Sara Timberlain.‡把暴风城护甲标记交给萨拉·迪博雷恩。‡把暴風城護甲標記交給薩拉·迪博雷恩。',
  }
},
[60] = {
  {
    'Velas dos kobolds‡Свечи кобольдов‡Koboldkerzen‡코볼트 양초‡Las velas de los kóbolds‡Las velas de los kóbolds‡Les bougies de kobolds‡狗头人的蜡烛‡狗頭人的蠟燭',
    nil,
    'Leve 8 Velas Grandes para Durval Pilão em Vila d\'Ouro.‡Принесите 8 больших свечей в Златоземье Вильяму Песту.‡Bringt 8 große Kerzen nach Goldhain zu William Pestle.‡큰 양초 8개를 모아 골드샤이어에 있는 윌리엄 페슬에게 가져가야 합니다.‡Lleva 8 velas grandes a William Mortero a Villadorada.‡Lleva 8 velas grandes a William Mortero a Villadorada.‡Rapporter 8 Grandes bougies à William Pestle de Goldshire.‡为闪金镇的威廉·匹斯特收集8支大蜡烛。‡為閃金鎮的威廉·匹斯特收集8支大蠟燭。',
  }
},
[61] = {
  {
    'Frete para Ventobravo‡Посылка в Штормград‡Lieferung nach Stormwind‡스톰윈드로의 배달‡Un envío para Ventormenta‡Un envío para Ventormenta‡Une cargaison pour Stormwind‡送往暴风城的货物‡送往暴風城的貨物',
    nil,
    'Leve o Carregamento do Guilherme para Morgado Pilão no Distrito Comercial de Ventobravo.‡Доставьте посылку Вильяма Моргану Песту в Торговый квартал Штормграда.‡Bringt Williams Lieferung in den Handelsdistrikt von Stormwind zu Morgan Pestle.‡스톰윈드 상업 지구에 있는 모건 페슬에게 윌리엄의 뱃짐을 가져가야 합니다.‡Lleva el envío de William a Morgan Mortero al Distrito de Mercaderes de Ventormenta.‡Lleva el envío de William a Morgan Mortero al Distrito de Mercaderes de Ventormenta.‡Livrer la Cargaison de William à Morgan Pestle dans le Quartier commerçant de Stormwind.‡把威廉的货物交给暴风城贸易区的摩根·匹斯特。‡把威廉的貨物交給暴風城貿易區的摩根·匹斯特。',
  }
},
[62] = {
  {
    'A Mina Vailafundo‡Рудник Подземных глубин‡Die Tiefenschachtmine‡개미굴 광산‡La Mina Abisal‡La Mina Abisal‡La mine de Fargodeep‡法戈第矿洞‡法戈第礦洞',
    nil,
    'Explore a Mina Vailafundo e depois fale novamente com o Delegado Durão em Vila d\'Ouro.‡Исследуйте рудник Подземных глубин и вернитесь в Златоземье с докладом для маршала Дугхана.‡Erforscht die Tiefenschachtmine und kehrt dann nach Goldhain zu Marshal Dughan zurück.‡개미굴 광산을 조사하고 골드샤이어에 있는 치안대장 더그한에게 돌아가야 합니다.‡Explora la Mina Abisal y vuelve junto al alguacil Dughan a Villadorada.‡Explora la Mina Abisal y vuelve junto al alguacil Dughan a Villadorada.‡Explorer la mine de Fargodeep, puis revenir voir le maréchal Dughan de Goldshire.‡调查法戈第矿洞，然后回到闪金镇去见治安官杜汉。‡調查法戈第礦洞，然後回到閃金鎮去見治安官杜漢。',
  }
},
[63] = {
  {
    'Clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Derrote a Manifestação da Água Corrompida e deposite as Braçadeiras da Manifestação Corrompida junto com as Gotas Restantes da Mais Pura Água no Braseiro da Fonteterna, que fica na Floresta de Pinhaprata.‡Одолейте оскверненное воплощение воды и поместите в жаровню Вечного источника в Серебряном бору его браслеты и оставшиеся капли чистейшей воды.‡Besiegt die verderbte Wassermanifestation und legt die Armschienen der verderbten Manifestation und die verbleibenden Tropfen reinsten Wassers im Silberwald auf die Kohlenpfanne von Everfount.‡은빛소나무 숲에서 타락한 하급 물의 현신을 물리치고 영원의 샘 제단 위에 타락한 현신의 팔보호구와 얼마 남지 않은 순수한 물을 함께 올려놓아야 합니다.‡Derrota la manifestación de agua corrupta y coloca los brazales de manifestación corrupta con las gotas restantes del agua más pura en el Blandón de Siemprefuente en el Bosque de Argénteos.‡Derrota a la manifestación de agua corrupta y coloca los brazales de manifestación corrupta con las gotas restantes del agua más pura en el blandón de Siemprefuente en el Bosque de Argénteos.‡Vaincre la Manifestation d\'eau corrompue et placer les Bracelets de manifestation corrompue avec le reste d\'eau pure sur le brasero d\'Everfount dans la forêt des Pins argentés.‡击败堕落的水之魂，把堕落水之魂的护腕和剩余的最纯净的水放在银松森林的圣泉火盆上。‡擊敗墮落的水之魂，把墮落水之魂的護腕和剩余的最純凈的水放在銀松森林的聖泉火盆上。',
  }
},
[64] = {
  {
    'Herança esquecida‡Забытая вещь‡Das vergessene Erbstück‡두고 온 회중시계‡La reliquia olvidada‡La reliquia olvidada‡Le cadeau oublié‡遗失的怀表‡遺失的懷表',
    nil,
    'O Fazendeiro Taturana quer que você recupere o relógio de bolso dele no guarda-roupa da sede de sua fazenda de abóboras, a oeste.‡Верните фермеру Хмуроброву его карманные часы, которые находятся в платяном шкафу в его доме на тыквенной ферме на западе.‡Bauer Furlbrow möchte, dass Ihr seine Taschenuhr holt. Sie befindet sich im Kleiderschrank des Bauernhauses auf der Kürbisfarm im Westen.‡농부 펄브로우가 서쪽의 호박밭에 있는 그의 농가로 가서 옷장 안에 있는 회중시계를 가져다 달라고 부탁했습니다.‡El granjero Furlbrow quiere que recuperes el reloj de bolsillo que dejó olvidado en el armario de su granja en la plantación de calabazas del Oeste.‡El granjero Cejade quiere que recuperes el reloj de bolsillo que dejó olvidado en el guardarropa de su granja en la plantación de calabazas del Oeste.‡Le fermier Furlbrow désire que vous retrouviez sa Montre qui se trouve dans la penderie de sa ferme près du champ de citrouilles à l\'ouest.‡农夫法布隆希望你能帮他找回他的怀表。怀表在西边南瓜田旁边的农舍的衣柜里。‡農夫法布隆希望妳能幫他找回他的懷表。懷表在西邊南瓜田旁邊的農舍的衣櫃裏。',
  }
},
[65] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Miguel Mantoforte quer que você converse com Wiley, em Vila Plácida.‡Поговорите с Вилли в Приозерье по просьбе Гриана Камнегрива.‡Gryan Stoutmantle möchte, dass Ihr in Seenhain mit Wiley sprecht.‡그라이언 스타우트맨틀이 레이크샤이어의 와일리와 대화하라고 부탁했습니다.‡Gryan Mantorrecio quiere que hables con Wiley en Villa del Lago.‡Gryan Mantorrecio quiere que hables con Wiley en Villa del Lago.‡Gryan Stoutmantle veut que vous parliez à Wiley à Lakeshire.‡格里安·斯托曼要求你去和湖畔镇的威利谈一谈。‡格裏安·斯托曼要求妳去和湖畔鎮的威利談壹談。',
  }
},
[66] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Encontre o Tabelião Azambuja na Prefeitura de Vila Sombria.‡Найдите клерка Далтри в ратуше Темнолесья.‡Sucht Amtmann Daltry im Rathaus von Dunkelhain auf.‡다크샤이어 마을 회관에서 서기관 달트리를 찾아야 합니다.‡Busca al dependiente Daltry en el Concejo de Villa Oscura.‡Busca al secretario Daltry en el Concejo de Villa Oscura.‡Aller voir le Greffier Daltry à la mairie de Darkshire.‡去夜色镇大厅找到书记员达尔塔。‡去夜色鎮大廳找到書記員達爾塔。',
  }
},
[67] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Vá ao Liceu do Arroio da Lua e relate qualquer informação atualizada sobre Galvão ao Tabelião Azambuja.‡Отправьтесь в Лунореченскую школу и сообщите все сведения о Сталване клерку Далтри.‡Begebt Euch zur Schule in Moonbrook und bringt Amtmann Daltry alle neuen Informationen über Stalvan Mistmantle.‡문브룩 학교로 가서 스탈반에 대한 최신 정보를 다크샤이어에 있는 서기관 달트리에게 전해줘야 합니다.‡Viaja a la escuela de Arroyo de la Luna y lleva cualquier información que descubras sobre Stalvan al dependiente Daltry.‡Viaja a la Escuela de Arroyo de la Luna y lleva cualquier información que descubras sobre Stalvan al secretario Daltry.‡Voyager jusqu\'à l\'école de Ruisselune et rapporter des informations récentes sur Stalvan au Greffier Daltry.‡到月溪镇的学校去寻找关于斯塔文的新信息，回来告诉书记员达尔塔。‡到月溪鎮的學校去尋找關於斯塔文的新信息，回來告訴書記員達爾塔。',
  }
},
[68] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Leve a Carta Não Enviada e Empoeirada para o Tabelião Azambuja.‡Отнесите пыльное неотосланное письмо клерку Далтри.‡Bringt Amtmann Daltry den verstaubten, nie abgeschickten Brief.‡다크샤이어에 있는 서기관 달트리에게 먼지 투성이의 부치지 않은 편지를 가져가야 합니다.‡Lleva la carta polvorienta sin enviar al dependiente Daltry.‡Lleva la carta polvorienta sin enviar al secretario Daltry.‡Rapporter la lettre poussiéreuse au greffier Daltry.‡把覆满灰尘的信交给书记员达尔塔。‡把覆滿灰塵的信交給書記員達爾塔。',
  }
},
[69] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Vá à Estalagem do Leão Orgulhoso para ver se alguém ouviu falar de Galvão.‡Отправляйтесь в таверну "Гордость льва" и спросите, не слышал ли кто о Сталване.‡Begebt Euch zum Gasthaus Zur Höhle des Löwen und fragt dort nach, ob jemand schon einmal den Namen Stalvan gehört hat.‡사자무리 여관으로 가서 스탈반에 대해 아는 사람이 있는지 확인해야 합니다.‡Ve a la Posada Orgullo de León a ver si alguien ha oído el nombre de Stalvan.‡Ve a la Posada Orgullo de León a ver si alguien ha oído el nombre de Stalvan.‡Aller à l\'Auberge de la Fierté du lion pour apprendre si quelqu\'un a entendu parler de Stalvan.‡到狮王之傲旅店去问问那里的人，看看他们是否听说过斯塔文这个人。‡到獅王之傲旅店去問問那裏的人，看看他們是否聽說過斯塔文這個人。',
  }
},
[70] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Pegue a Carta Não Entregue de Galvão no baú entregue-a no Distrito do Canal, em Ventobravo.‡Возьмите недоставленное письмо Сталвана из сундука и доставьте его в район каналов Штормграда.‡Holt Stalvans niemals zugestellten Brief aus der Truhe und liefert ihn im Kanaldistrikt von Stormwind ab.‡상자에서 스탈반의 배달되지 않은 편지를 찾아 스톰윈드의 대운하에 있는 누군가에게 전해줘야 합니다.‡Recupera la carta sin enviar de Stalvan del cofre y entrégala en el distrito de Los Canales de Ventormenta.‡Recupera la carta sin enviar de Stalvan del cofre y entrégala en el distrito de Los Canales de Ventormenta.‡Retrouver la Vieille lettre de Stalvan dans le coffre et la remettre au quartier du Canal à Stormwind.‡从箱子中拿出斯塔文的未寄出的信，把它送到暴风城的运河区。‡從箱子中拿出斯塔文的未寄出的信，把它送到暴風城的運河區。',
  }
},
[71] = {
  {
    'Apresente-se a Tomás‡Доклад для Томаса‡Meldung an Thomas‡토마스에게 보고‡Informa a Thomas‡Informa a Thomas‡Faire son rapport au garde Thomas‡回复托马斯‡回復托馬斯',
    nil,
    'Entregue os Medalhões de Rodolfo e Malaquias para o Guarda Tomás na ponte leste de Elwynn.‡Отдайте стражнику Томасу у восточного моста Элвиннского леса медальоны стражей Рольфа и Малакаи.‡Bringt die Medaillons von Rolf und Malakai zu Wache Thomas an die östliche Elwynn-Brücke.‡엘윈 숲 동쪽 다리에 있는 경비병 토마스에게 롤프와 말라카이의 목걸이를 가져가야 합니다.‡Entrega los medallones de Rolf y Malakai al guardia Thomas. Lo encontrarás en el puente oriental de Elwynn.‡Entrega los medallones de Rolf y Malakai al guardia Thomas. Lo encontrarás en el puente oriental de Elwynn.‡Rapporter les Médaillons de Rolf et Malakai au garde Thomas au pont est d’Elwynn.‡把罗尔夫和马拉凯的铭牌交给艾尔文森林东部桥边的卫兵托马斯。‡把羅爾夫和馬拉凱的銘牌交給艾爾文森林東部橋邊的衛兵托馬斯。',
  }
},
[72] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Procure alguma pista nos pertences guardados.‡Найдите улики в пожитках управляющего Фольсома.‡Durchsucht die verpackten Besitztümer nach Hinweisen.‡뒤에 있는 짐 꾸러미에서 단서를 찾아봐야 합니다.‡Busca una pista entre los objetos empaquetados.‡Busca una pista entre los objetos empaquetados.‡Rechercher un indice dans le tas d\'affaires.‡在打包的东西里寻找线索。‡在打包的東西裏尋找線索。',
  }
},
[73] = {
  {
    '‡‡‡‡‡<TXT> No hay recompensa‡‡‡',
    nil,
    nil,
  }
},
[74] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'A Página de Diário Rasgada que você descobriu lhe dá a próxima pista.‡Отнесите страницу из дневника маршалу Хаггарду.‡Die zerrissene Tagebuchseite, die Ihr gefunden habt, gibt Euch den nächsten Hinweis.‡발견한 찢어진 일지 페이지에 다음 단서가 들어 있습니다.‡La página arrancada del diario que descubriste es tu siguiente pista.‡La página arrancada del diario que descubriste es tu siguiente pista.‡La Page de journal déchirée que vous avez découverte est votre deuxième indice.‡你找到的这张被撕破的日记书页给你提供了又一个线索。‡妳找到的這張被撕破的日記書頁給妳提供了又壹個線索。',
  }
},
[75] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'O Delegado Fadigas quer que você procure a Página de Diário Esmaecida no baú no andar de cima.‡Найдите в сундуке на втором этаже выцветшую страницу с записями.‡Marshal Haggard möchte, dass Ihr in der Kiste oben nach der verblassten Tagebuchseite sucht.‡치안대장 해거드가 위층의 상자에서 색 바랜 일지 페이지를 가져와 달라고 부탁했습니다.‡El alguacil Haggard quiere que busques la página del diario descolorida en el cofre que hay arriba.‡El mariscal Haggard quiere que busques la página del diario descolorida en el cofre que hay arriba.‡Le maréchal Haggard veut que vous alliez chercher la Vieille page de journal dans le coffre à l\'étage.‡治安官哈迦德要你从楼上的箱子里找出一张褪色的日记书页。‡治安官哈迦德要妳從樓上的箱子裏找出壹張褪色的日記書頁。',
  }
},
[76] = {
  {
    'A Mina de Jaspe‡Яшмовая шахта‡Die Jaspismine‡석영 광산‡La Cantera de Jaspe‡La Cantera de Jaspe‡La mine de Jasperlode‡玉石矿洞‡玉石礦洞',
    nil,
    'Explore a Mina de Jaspe e, depois, fale com o Delegado Durão em Vila d\'Ouro.‡Обследуйте Яшмовую шахту и вернитесь с докладом в Златоземье к маршалу Дугхану.‡Erforscht die Jaspismine und kehrt dann nach Goldhain zu Marshal Dughan zurück, um ihm Bericht zu erstatten.‡석영 광산을 탐색한 후 골드샤이어에 있는 치안대장 더그한에게 보고해야 합니다.‡Explora la Cantera de Jaspe y vuelve a informar al alguacil Dughan a Villadorada.‡Explora la Cantera de Jaspe y vuelve a informar al alguacil Dughan a Villadorada.‡Explorer la Mine de Jasperlode, puis faites votre rapport au maréchal Dughan de Goldshire.‡查看玉石矿洞，然后回到闪金镇去向治安官杜汉报告。‡查看玉石礦洞，然後回到閃金鎮去向治安官杜漢報告。',
  }
},
[77] = {
  {
    'Pega a joça!‡Грязное дело‡Eine schwierige Situation‡까다로운 임무‡Una situación peliaguda‡Una situación peliaguda‡Une situation délicate‡收集蜜糖‡收集蜜糖',
    nil,
    'Recupere 10 garrafas de Suco Gami das Terras Agrestes dos caixotes localizados na base abandonada da Horda na Rocha Oculta.‡Найдите заброшенную базу Орды на Осклизлой скале и заберите из ящиков 10 бутылок "Медовой зыби из Внутренних земель".‡Holt 10 Flaschen Hinterland-Honigwelle aus den Kisten, die sich rund um den verlassenen Stützpunkt der Horde in Skulk Rock befinden.‡굼벵이 바위굴의 버려진 호드 기지 근처에서 상자에 든 동부내륙지 벌꿀 리플 10병을 회수해야 합니다.‡Recoge 10 botellas de calimocho de miel de las Tierras del Interior de las cajas de la base abandonada de la Horda en Roca Oculta.‡Recoge 10 botellas de calimocho dulce de las Tierras del Interior de las cajas de la base abandonada de la Horda en Roca Oculta.‡Récupérer 10 bouteilles de Houle au miel des Hinterlands dans des caisses se trouvant aux environs de la base abandonnée de la Horde, au rocher de l\'Affût.‡从隐匿石一带被部落废弃的基地中的箱子里找到10瓶辛特兰蜜糖。‡從隱匿石壹帶被部落廢棄的基地中的箱子裏找到10瓶辛特蘭蜜糖。',
  }
},
[78] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Leve a Página do Diário Esmaecido para o Taberneiro Oseias.‡Отнесите выцветшую страницу записей хозяину таверны Смиттсу.‡Bringt die verblasste Tagebuchseite zu Schankwart Smitts.‡선술집주인 스미츠에게 색 바랜 일지 페이지를 가져가야 합니다.‡Lleva la página de diario descolorida al tabernero Smitts.‡Llévale la página de diario borrada al tabernero Smitts.‡Prendre la Vieille page de journal et la montrer à Smitts l\'aubergiste.‡把褪色的日记书页带给旅店老板斯密茨。‡把褪色的日記書頁帶給旅店老板斯密茨。',
  }
},
[79] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Leve a página enlameada para a Comandante Ebonlocke.‡Отнесите грязную страницу командиру Альтее Чернодрев.‡Bringt Kommandant Ebonlocke die schlammverschmierte Seite.‡사령관 알시아 이본로크에게 진흙투성이의 일지 페이지를 가져가야 합니다.‡Lleva la página embarrada a la comandante Cerranegro.‡Lleva la página embarrada a la comandante Cerranegro.‡Porter les pages au commandant Ebonlocke.‡把沾满泥污的日记书页交给指挥官阿尔泰娅·埃伯洛克。‡把沾滿泥汙的日記書頁交給指揮官阿爾泰婭·埃伯洛克。',
  }
},
[80] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Mostre ao Tabelião Azambuja a Página do Diário Manchado de Sangue.‡Покажите запятнанную кровью страницу записей клерку Далтри.‡Zeigt Amtmann Daltry die blutbefleckte Tagebuchseite.‡서기관 달트리에게 피투성이의 일지 페이지를 보여 주어야 합니다.‡Enseña la página del diario manchada de sangre al dependiente Daltry.‡Enseña la página del diario manchada de sangre al secretario Daltry.‡Montrer au Greffier Daltry la Page de journal maculée de sang.‡把染血的日记书页交给书记员达尔塔。‡把染血的日記書頁交給書記員達爾塔。',
  }
},
[81] = {
  {
    'Entrega de suco gami‡Груз медовухи‡Wellenlieferung‡리플 배달‡Entrega el calimocho‡Entrega el calimocho‡La livraison de Houle‡送回蜜酒‡送回蜜酒',
    nil,
    'Entregue o Barril para Dran Droffers em Orgrimmar.‡Доставьте бочонок в Оргриммар Драну Дрофферсу.‡Liefert das Fass nach Orgrimmar an Dran Droffers.‡오그리마에 있는 드란 드로퍼스에게 술통을 가져가야 합니다.‡Entrega el barril a Dran Droffers en Orgrimmar.‡Entrega el barril a Dran Droffers en Orgrimmar.‡Livrer le tonneau à Dran Droffers à Orgrimmar.‡把桶交给奥格瑞玛的德兰·杜佛斯。‡把桶交給奧格瑞瑪的德蘭·杜佛斯。',
  }
},
[82] = {
  {
    'Investigação no Covil Nóxio‡Исследование Ядовитого улья‡Erkundung des Giftigen Unterschlupfes‡맹독의 둥지 조사‡Investigación en la Guarida Ponzoñosa‡Investigación en la Guarida Ponzoñosa‡Enquête au Repaire nuisible‡腐化之巢‡腐化之巢',
    nil,
    'Leve cinco Pedaços de Inseto Centiparte do Covil Nóxio para o Alquimista Almofarrista em Geringontzan.‡Принесите 5 частей тел насекомых Сентипаар из Ядовитого улья алхимику Пестычинсу в Прибамбасск.‡Bringt fünf Centipaarinsektenteile vom Giftigen Unterschlupf nach Gadgetzan zum Alchimisten Pestlezugg.‡맹독의 둥지에서 센티파르 곤충 기관 5개를 구해 가젯잔에 있는 연금술사 페슬저그에게 가져가야 합니다.‡Llévale 5 trozos de insectos centipaar de La Guarida Ponzoñosa al alquimista Morterozugg de Gadgetzan.‡Llévale 5 trozos de insectos centipaar de La Guarida Ponzoñosa al alquimista Morterozugg de Gadgetzan.‡Apporter cinq morceaux de Centipaars du Repaire nuisible à l\'Alchimiste Pestlezugg à Gadgetzan.‡从腐化之巢找5个森提帕尔昆虫肢体，把它们交给加基森的炼金师匹斯特苏格。‡從腐化之巢找5個森提帕爾昆蟲肢體，把它們交給加基森的煉金師匹斯特蘇格。',
  }
},
[83] = {
  {
    'Além do linho vermelho‡Красный лен‡Rote Leinenwaren‡붉은 리넨 복면‡Artículos rojos de lino‡Artículos rojos de lino‡Articles rouges en lin‡红色亚麻布‡紅色亞麻布',
    nil,
    'Leve 6 Bandanas de Linho Vermelhas para Sara Albernaz na Madeireira Vale do Leste.‡Принесите 6 красных льняных повязок на Лесопилку Восточной долины и отдайте их Саре Тимберлейн.‡Bringt 6 rote Leinenkopftücher ins Holzfällerlager des Osttals zu Sara Timberlain.‡동부 벌목지에 있는 사라 팀버레인에게 붉은 리넨 복면 6개를 가져가야 합니다.‡Llévale 6 pañuelos de lino rojo a Sara Timberlain en el Aserradero de la Vega del Este.‡Llévale 6 pañuelos de lino rojo a Sara Timberlain en el Aserradero de la Vega del Este.‡Apporter 6 Masques rouge en lin à Sara Timberlain au Camp de bûcherons du Val d\'est.‡给东谷伐木场的萨拉·迪博雷恩带去6块红色亚麻布面罩。‡給東谷伐木場的薩拉·迪博雷恩帶去6塊紅色亞麻布面罩。',
  }
},
[84] = {
  {
    '...com a vontade de comer‡Назад к Билли‡Zurück zu Billy‡빌리에게 돌아가기‡Vuelve con Billy‡Vuelve con Billy‡Revenir voir Billy‡比利的馅饼‡比利的餡餅',
    nil,
    'Leve a Torta de Barriga de Porco para Guinho Madruga nos Vinhedos dos Madruga.‡Отнесите пирог со свининой на Виноградники Маклура и отдайте его Билли.‡Bringt die Schweinebauchpastete zu Billy Maclure in den Weinbergen der Maclures.‡맥클루어 포도밭에 있는 빌리 맥클루어에게 돼지 삼겹살 파이를 가져가야 합니다.‡Lleva el pastel de tripa de cerdo a Billy Maclure a Los Viñedos de Maclure.‡Lleva el pastel de tripa de cerdo a Billy Maclure a Los Viñedos de Maclure.‡Porter la Tourte de panse de porc à Billy Maclure aux Vignes des Maclure.‡把猪肉馅饼带给马科伦农场的比利·马科伦。‡把豬肉餡餅帶給馬科倫農場的比利·馬科倫。',
  }
},
[85] = {
  {
    'O colar perdido‡Потерянное ожерелье‡Die verlorene Halskette‡잃어버린 목걸이‡El collar perdido‡El collar perdido‡Le collier perdu‡丢失的项链‡丟失的項鏈',
    nil,
    'Fale com Guinho Madruga.‡Поговорите с Билли Маклюром.‡Sprecht mit Billy Maclure.‡빌리 맥클루어와 대화하십시오.‡Habla con Billy Maclure.‡Habla con Billy Maclure.‡Parler à Billy Maclure.‡和比利·马科伦谈一谈。‡和比利·馬科倫談壹談。',
  }
},
[86] = {
  {
    'Juntando a fome...‡Пирог для Билли‡Pastete für Billy‡빌리를 위한 파이‡Un pastel para Billy‡Un pastel para Billy‡Une tourte pour Billy‡比利的馅饼‡比利的餡餅',
    nil,
    'Leve 4 Nacos de Carne de Javali Macia para a "Titia" Berenice Campedra na Fazenda dos Campedra.‡Принесите 4 куска кабаньего мяса на ферму Стоунфилд и отдайте тетушке Бернис.‡Bringt 4 Brocken Eberfleisch zu Tantchen Bernice Stonefield auf den Hof der Stonefields.‡스톤필드 농장에 있는 보모 버니스 스톤필드에게 멧돼지 고기 4개를 가져가야 합니다.‡Lleva 4 trozos de carne de jabalí a la tía Bernice Pedregosa a La Granja Pedregosa.‡Lleva 4 trozos de carne de jabalí a la tía Bernice Pedregosa en la Granja Pedregosa.‡Apporter 4 morceaux de Viande de sanglier à Tatie Bernice Stonefield à la ferme des Stonefield.‡给斯通菲尔德农场的波尼斯·斯通菲尔德带去4块野猪肉。‡給斯通菲爾德農場的波尼斯·斯通菲爾德帶去4塊野豬肉。',
  }
},
[87] = {
  {
    'Dentadouro‡Фикс‡Goldzahn‡황금니 코볼트‡Dientes de oro‡Dientes de Oro‡Dent-d\'or‡金牙‡金牙',
    nil,
    'Leve o Colar de Berenice para "Titia" Berenice Campedra na Fazenda dos Campedra, que fica na Floresta de Elwynn.‡Верните ожерелье тетушке Бернис на ферму Стоунфилдов.‡Bringt Berenices Halskette auf den Hof der Stonefields zu "Tantchen" Berenice Stonefield.‡버니스의 목걸이를 스톤필드 농장에 있는 보모 버니스 스톤필드에게 가져가야 합니다.‡Lleva el collar de Bernice a tía Bernice Pedregosa a La Granja Pedregosa.‡Lleva el collar de Bernice a tía Bernice Pedregosa a La Granja Pedregosa.‡Rapporter le Collier de Bernice à "Tatie" Bernice Stonefield à la ferme des Stonefield.‡把波尼斯的项链带给斯通菲尔德农场的波尼斯·斯通菲尔德。‡把波尼斯的項鏈帶給斯通菲爾德農場的波尼斯·斯通菲爾德。',
  }
},
[88] = {
  {
    'Princesa tem que morrer!‡Принцесса должна умереть!‡Prinzessin muss sterben!‡공주를 없애라!‡¡Princesa debe morir!‡¡Princesa debe morir!‡Princesse doit mourir !‡公主必须死！‡公主必須死！',
    nil,
    'Mate Princesa, pegue a coleira dela e leve-a para Mama Campedra na Fazenda dos Campedra.‡Убейте Принцессу, заберите ее ошейник и отнесите на ферму мамаше Стоунфилд.‡Tötet Prinzessin, nehmt ihr Halsband an Euch und bringt es zu Mutter Stonefield auf den Hof der Stonefields.‡공주를 해치운 후 스톤필드 농장에 있는 스톤필드 부인에게 놋쇠 목걸이를 가져가야 합니다.‡Mata a Princesa, agarra su collera y llévasela a la vieja Pedregosa a La Granja Pedregosa.‡Mata a Princesa, agarra su collera y llévasela a la vieja Pedregosa a La Granja Pedregosa.‡Tuer Princesse, prendre son collier, puis le porter à Maman Stonefield à la ferme des Stonefield.‡杀掉公主，把它的项圈带给斯通菲尔德农场的斯通菲尔德妈妈。‡殺掉公主，把它的項圈帶給斯通菲爾德農場的斯通菲爾德媽媽。',
  }
},
[89] = {
  {
    'A ponte do Lago Plácido‡Мост Безмолвия‡Die Immerruhbrücke‡영원의 다리‡La reconstrucción del puente‡El puente sempiterno‡Le pont sur le lac‡止水湖上的桥‡止水湖上的橋',
    nil,
    'Leve 5 Piques de Ferro e 5 Rebites de Ferro para o Encarregado Oslow, na Vila Plácida.‡Принесите 5 железных пик и 5 железных клепок штейгеру Ослоу в Приозерье.‡Bringt 5 Eisenspitzen und 5 Eisennieten nach Seenhain zu Großknecht Oslow.‡레이크샤이어에 있는 현장감독 오슬로우에게 철제 파이크 5개와 철제 리벳 5개를 가져가야 합니다.‡Lleva 5 picas y 5 roblones de hierro al supervisor Oslow a Villa del Lago.‡Lleva 5 picas y 5 remaches de hierro al supervisor Olento a Villa del Lago.‡Apporter 5 Clous en fer et 5 Vis en fer au contremaître Oslow à Lakeshire.‡给湖畔镇的工头奥斯洛带回5根铁矛和5个铁铆钉。‡給湖畔鎮的工頭奧斯洛帶回5根鐵矛和5個鐵鉚釘。',
  }
},
[90] = {
  {
    'Kebab Temperado de Lobo‡Пряные котлеты из волчатины‡Gewürzter Wolfskebab‡늑대 양념 케밥‡Kebab de lobo salpimentado‡Kebab de lobo sazonado‡Kébab de loup assaisonné‡干烤狼肉串‡幹烤狼肉串',
    nil,
    'Colete 10 Lombos de Lobo Magro e Tempero de Ventobravo. Depois, fale novamente com o Chef Goroba, na Vila Sombria.‡Принесите 10 постных волчьих боков и травяные приправы Штормграда шеф-повару Груалю в Темнолесье.‡Beschafft Euch 10 magere Wolfflanken und Würzkräuter aus Stormwind und kehrt dann zu Küchenchef Grual nach Dunkelhain zurück.‡늑대 살코기 10개와 스톰윈드 향초를 모아 다크샤이어의 주방장 그루얼에게 돌아가야 합니다.‡Reúne 10 ijadas magras de lobo y hierbas aromáticas de Ventormenta y vuelve a Villa Oscura, a ver al Chef Grual.‡Reúne 10 ijadas magras de lobo y hierbas aromáticas de Ventormenta y vuelve a Villa Oscura, a ver al Chef Grual.‡Récupérer 10 Steaks de loup et des Herbes aromatiques de Stormwind, puis retourner voir le chef Grual à Darkshire.‡收集10块狼肋排和1份暴风城特产调料，再回夜色镇去找厨师格鲁奥。‡收集10塊狼肋排和1份暴風城特產調料，再回夜色鎮去找廚師格魯奧。',
  }
},
[91] = {
  {
    'A lei de Salomão‡Закон Соломона‡Das Gesetz des Solomon‡솔로몬의 법‡Ley de Salomón‡Ley de Solomon‡La loi de Solomon‡所罗门的律法‡所羅門的律法',
    nil,
    'Leve 10 Pingentes Umbrapele para o Meirinho Conacher na Prefeitura de Vila Plácida.‡Принесите 10 подвесок Темношкуров помощнику судьи Конаху в ратушу Приозерья.‡Bringt 10 Schattenfellanhänger ins Rathaus von Seenhain zu Büttel Conacher.‡레이크샤이어 마을 회관에 있는 집행관 코나처에게 잿빛가죽일족 펜던트 10개를 가져가야 합니다.‡Lleva 10 colgantes Pellejo Negro a Bailiff Conacher al Concejo de Villa del Lago.‡Lleva 10 colgantes Pielsombra a Bailiff Conacher al Concejo de Villa del Lago.‡Apporter 10 Pendentifs sombrepoil au Bailli Conacher à l\'Hôtel de ville de Lakeshire.‡给湖畔镇大厅的拜里弗·科纳彻尔带回10个暗皮坠饰。‡給湖畔鎮大廳的拜裏弗·科納徹爾帶回10個暗皮墜飾。',
  }
},
[92] = {
  {
    'Gulache de Cristarrubra‡Гуляш по-красногорски‡Rotkammgulasch‡붉은마루산 굴라시 스튜‡Estofado de Crestagrana‡Estofado Crestagrana‡Goulash des Carmines‡赤脊山炖肉‡赤脊山燉肉',
    nil,
    'A Mestre-cuca Breanna de Vila Plácida quer 5 peças de carne dura de condor, 5 focinhos de grande goretusco e 5 porções de carne crocante de aranha.‡Принесите Бреанне пять кусков жесткого мяса кондора, пять рыл больших сквернохряков и пять порций хрустящего паучьего мяса.‡Küchenchefin Breanna aus Seenhain möchte 5 Stücke zähes Kondorfleisch, 5 große Geiferzahnschnauzen und 5 Portionen knuspriges Spinnenfleisch.‡레이크샤이어의 주방장 브리나가 질긴 독수리 고기 5개, 큰 뿔엄니멧돼지 주둥이 5개, 파삭파삭한 거미 고기 5개를 가져다 달라고 부탁했습니다.‡El chef Breanna de Villa del Lago quiere 5 piezas de carne dura de cóndor, 5 morros de dentosangre grandes y 5 raciones de carne de araña crujiente.‡El chef Breanna de Villa del Lago quiere 5 piezas de carne de cóndor dura, 5 morros de dentosangre grandes y 5 raciones de carne de araña crujiente.‡Le chef Breanna de Lakeshire veut 5 morceaux de Viande de condor coriace, 5 Groins de grands Broche-tripes et 5 portions de Chair croustillante d\'araignée.‡湖畔镇的厨师布雷纳想要5块硬秃鹫肉，5个巨型血牙野猪头和5份香脆蜘蛛肉。‡湖畔鎮的廚師布雷納想要5塊硬禿鷲肉，5個巨型血牙野豬頭和5份香脆蜘蛛肉。',
  }
},
[93] = {
  {
    'Bolinhos de Caranguejo Crepuscular‡Темные пирожки с крабами‡Schwärzliche Krebsküchlein‡갈색 게살 케이크‡Las croquetas de cangrejo‡Los pasteles de cangrejo oscuro‡Gâteaux au crabe brun‡黑蟹蛋糕‡黑蟹蛋糕',
    nil,
    'Colete 6 Pernas de Aranhas Pegajosas e leve para o Chef Goroba, na Vila Sombria.‡Добудьте 6 липких паучьих лапок и принесите их шеф-повару Груалю в Темнолесье.‡Beschafft 6 klebrige Spinnenbeine und bringt sie nach Dunkelhain zu Küchenchef Grual.‡끈끈한 거미 다리 6개를 모아 다크샤이어에 있는 주방장 그루얼에게 가져가야 합니다.‡Reúne 6 patas pegajosas de araña y llévaselas al Chef Grual a Villa Oscura.‡Reúne 6 patas pegajosas de araña y llévaselas al Chef Grual a Villa Oscura.‡Récupérer 6 Pattes d\'araignée fondantes et les porter au chef Grual de Darkshire.‡收集6条粘糊的蜘蛛腿，把它们交给夜色镇的厨师格鲁奥。‡收集6條粘糊的蜘蛛腿，把它們交給夜色鎮的廚師格魯奧。',
  }
},
[94] = {
  {
    'Olho vigilante‡Недремлющее Око‡Ein wachsames Auge‡감시의 눈동자‡Un ojo vigilante‡Un ojo vigilante‡L\'œil attentif‡法师的眼线‡法師的眼線',
    nil,
    'Ponha o Glifo de Azora na Estátua de Leão perto da Torre de Ilgalar em Cristarrubra.‡Отнесите амулет Азоры к статуе льва, стоящей рядом с башней Илгалара в Красногорье.‡Bringt die Glyphe von Azora zur Löwenstatue in der Nähe des Turms von Ilgalar im Rotkammgebirge.‡아조라의 조각상을 붉은마루 산맥에 있는 일갈라의 탑 근처의 오래된 사자상으로 가져가야 합니다.‡Lleva el Glifo de Azora a la Estatua Leonida, cerca de la Torre de Ilgalar, en Crestagrana.‡Lleva el Glifo de Azora a la Estatua Leonida, cerca de la Torre de Ilgalar, en Crestagrana.‡Placer le Glyphe d\'Azora sur la Statue de lion près de la Tour d\'Ilgalar dans les Carmines.‡把阿祖拉的铭文饰品放置到赤脊山伊尔加拉之塔旁边的狮子雕像身上。‡把阿祖拉的銘文飾品放置到赤脊山伊爾加拉之塔旁邊的獅子雕像身上。',
  }
},
[95] = {
  {
    'A vingança de Noel‡Месть Свена‡Svens Rache‡스벤의 복수‡La venganza de Sven‡La venganza de Sven‡La vengeance de Sven‡斯温的复仇‡斯溫的復仇',
    nil,
    'Vá até a Fazenda do Noel e descubra o que foi enterrado atrás do velho cepo de madeira.‡Выясните, что зарыто за старым пнем на ферме, где работал Свен.‡Begebt Euch zu Svens Hof und findet heraus, was hinter dem alten Baumstumpf vergraben wurde.‡요르겐 농장으로 가서 오래된 그루터기 뒤에 묻힌 물건을 찾아야 합니다.‡Ve a la granja de Sven y averigua qué había enterrado detrás del viejo tocón.‡Ve a la granja de Sven y averigua qué había enterrado detrás del viejo tocón.‡Aller à la ferme de Sven et trouver ce qui a été enterré derrière la vieille souche d\'arbre.‡到斯温的农场去找出埋在老树桩后面的是什么东西。‡到斯溫的農場去找出埋在老樹樁後面的是什麽東西。',
  }
},
[96] = {
  {
    'Clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve o Estilhaço de Água para Islen Vidente da Água nos Sertões.‡Отнесите осколок Воды Заклинательнице Воды Ислен в Степи.‡Bringt den Splitter des Wassers in das Brachland zu Islen Waterseer.‡불모의 땅에 있는 이슬렌 워터시어에게 물의 결정을 가져가야 합니다.‡Llévale el fragmento de agua a Islen Vident\'aqua en Los Baldíos.‡Lleva el fragmento de agua a Islen Vidente del Agua en los Baldíos.‡Apporter l\'Éclat d\'eau à Islen Waterseer dans les Tarides.‡把水灵碎片交给贫瘠之地的水之先知伊斯伦。‡把水靈碎片交給貧瘠之地的水之先知伊斯倫。',
  }
},
[97] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Vá dar a notícia à Comandante Ebonlocke.‡Сообщите новости командиру Альтее Чернодрев.‡Berichtet Kommandant Ebonlocke die Neuigkeiten.‡사령관 이본로크 경에게 필체가 일치한다는 소식을 보고해야 합니다.‡Informa a la comandante Cerranegro.‡Informa a la comandante Cerranegro.‡Prévenir le commandant Ebonlocke.‡把这个消息告诉指挥官阿尔泰娅·埃伯洛克。‡把這個消息告訴指揮官阿爾泰婭·埃伯洛克。',
  }
},
[98] = {
  {
    'A lenda de Galvão‡Легенда о Сталване‡Die Legende von Stalvan‡스탈반의 전설‡La leyenda de Stalvan‡La leyenda de Stalvan‡La légende de Stalvan‡斯塔文的传说‡斯塔文的傳說',
    nil,
    'Mate Galvão Brumanto e mostre o anel da família dele para Madame Eva.‡Убейте Сталвана Мистмантла и принесите мадам Эве его фамильное кольцо.‡Tötet Stalvan Mistmantle und zeigt Madame Eva den Ring seiner Familie.‡스탈반 미스트맨틀을 처치하고 에바 부인에게 미스트맨틀 가문의 반지를 보여 줘야 합니다.‡Mata a Stalvan Mantoniebla y muestra a Lady Eva su anillo familiar.‡Mata a Stalvan Mantoniebla y muestra a Lady Eva su anillo familiar.‡Tuer Stalvan Mistmantle et montrer son anneau familial à Madame Eva.‡干掉斯塔文·密斯特曼托，把他的家族戒指带给伊瓦夫人看看。‡幹掉斯塔文·密斯特曼托，把他的家族戒指帶給伊瓦夫人看看。',
  }
},
[99] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡阿魯高的愚行',
    nil,
    'Leve 6 Grilhas de Lenhardente para Dalar Tessalba, no Sepulcro.‡Принесите 6 кандалов из деревни Погребальных Костров Далару Ткачу Рассвета в Гробницу.‡Bringt Dalar Dawnweaver 6 Pyrewood-Fesseln zum Grabmal.‡공동묘지에 있는 달라 던위버에게 장작나무 족쇄 6개를 가져가야 합니다.‡Lleva 6 grilletes piroleños a Dalar Tejalba en El Sepulcro.‡Lleva 6 grilletes de Piroleña a Dalar Tejealba en El Sepulcro.‡Rapporter 6 Chaînes enchantées de Bois-du-Bûcher à Dalar Dawnweaver au Sépulcre.‡给瑟伯切尔的达拉尔·道恩维沃尔带回6副焚木镣铐。‡給瑟伯切爾的達拉爾·道恩維沃爾帶回6副焚木鐐銬。',
  }
},
[100] = {
  {
    'O clamor da Água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com a Manifestação Menor da Água na Floresta de Pinhaprata.‡Поговорите с Низшим воплощением воды в Серебряном бору.‡Sprecht mit der schwachen Wassermanifestation im Silberwald.‡은빛소나무 숲에 있는 하급 물의 현신과 대화하십시오.‡Habla con la manifestación de agua menor en el Bosque de Argénteos.‡Habla con la manifestación de agua menor en Bosque de Argénteos.‡Parler à la Manifestation d\'eau inférieure dans la forêt des Pins argentés.‡和银松森林的水之魂谈一谈。‡和銀松森林的水之魂談壹談。',
  }
},
[101] = {
  {
    'O totem do castigo‡Тотем наказания‡Das Totem des Gegenschlages‡시련의 토템‡El Tótem de castigo‡El Tótem de castigo‡Le Totem d\'affliction‡惩罚图腾‡懲罰圖騰',
    nil,
    'Leve 10 Presas de Carniçal, 10 Dedos Descarnados e 5 Ampolas de Peçonha de Aranha para a Madame Eva na Vila Sombria.‡Принесите 10 клыков вурдалаков, 10 пальцев скелетов и 5 фиалов паучьего яда мадам Еве в Темнолесье.‡Bringt 10 Ghulfangzähne, 10 Skelettfinger und 5 Phiolen Spinnengift nach Dunkelhain zu Madame Eva.‡다크샤이어의 에바 부인에게 구울 송곳니 10개, 해골 손가락 10개와 거미독 약병 5개를 가져가야 합니다.‡Consigue 10 colmillos de necrófago, 10 dedos de esqueleto y 5 viales de veneno arácnido para Madame Eva en Villa Oscura.‡Consigue 10 colmillos de necrófago, 10 dedos de esqueleto y 5 viales de veneno arácnido para Lady Eva en Villa Oscura.‡Apporter 10 Crocs de goule, 10 Doigts de Squelette et 5 Fioles de venin d\'araignée à Madame Eva à Darkshire.‡收集10颗食尸鬼的牙齿、10根骷髅的手指和5瓶蜘蛛毒液，把它们交给夜色镇的伊瓦夫人。‡收集10顆食屍鬼的牙齒、10根骷髏的手指和5瓶蜘蛛毒液，把它們交給夜色鎮的伊瓦夫人。',
  }
},
[102] = {
  {
    'A patrulha do Cerro Oeste‡Патрулирование Западного Края‡Auf Patrouille durch Westfall‡서부 몰락지대 순찰‡En patrulla por Páramos de Poniente‡En patrulla por los Páramos de Poniente‡Patrouilles dans la marche de l\'Ouest‡西部荒野的豺狼人‡西部荒野的豺狼人',
    nil,
    'Leve 8 Patas de Gnoll para o Capitão Danuvin no Morro da Sentinela.‡Принесите капитану Данувину на Сторожевой холм 8 лап гноллов.‡Bringt 8 Gnolltatzen auf die Späherkuppe zu Captain Danuvin.‡감시의 언덕에 있는 정찰대장 다누빈에게 놀의 앞발 8개를 가져가야 합니다.‡Lleva 8 zarpas de gnoll al capitán Danuvin en la Colina del Centinela.‡Lleva 8 garras de gnoll al capitán Danuvin en la Colina del Centinela.‡Rapportez 8 Pattes de gnolls au capitaine Danuvin à la Colline des sentinelles.‡给哨兵岭的丹努文队长带回8只豺狼人的爪子。‡給哨兵嶺的丹努文隊長帶回8只豺狼人的爪子。',
  }
},
[103] = {
  {
    'A chama não pode apagar‡Хранитель пламени‡Bewahrer der Flamme‡불꽃을 지키는 자‡Guardián de la Llama‡Guardián de la Llama‡Le gardien de la flamme‡长明的灯塔‡長明的燈塔',
    nil,
    'Entregue 5 Frascos de Óleo para o Capitão Calvino no Farol de Cerro Oeste.‡Принесите капитану Грейсону на Маяк в Западном Крае 5 бурдюков с маслом.‡Bringt 5 Fläschchen Öl zu Captain Grayson beim Leuchtturm von Westfall.‡서부 몰락지대 등대에 있는 그레이슨 선장에게 기름 주머니 5개를 가져가야 합니다.‡Lleva 5 botellas de aceite al capitán Grisillo en el Faro de los Páramos de Poniente.‡Lleva 5 botellas de aceite al capitán Grisillo en el Faro de Poniente.‡Apporter 5 Flasques d\'huile au capitaine Grayson, au phare de l\'Ouest‡给西部荒野灯塔中的葛瑞森船长带回5瓶灯油。‡給西部荒野燈塔中的葛瑞森船長帶回5瓶燈油。',
  }
},
[104] = {
  {
    'O mar não está para peixe‡Опасность на побережье‡Bedrohung an der Küste‡해안의 위협‡La amenaza costera‡La amenaza costera‡Menace sur la côte‡海岸上的威胁‡海岸上的威脅',
    nil,
    'Leve uma escama do Velho Olho-turvo para o Capitão Calvino no Farol de Cerro Oeste.‡Принесите чешую Старого Мрачноглаза капитану Грейсону к Маяку в Западном Крае.‡Bringt Captain Grayson am Leuchtturm von Westfall eine Schuppe von Old Murk-Eye.‡서부 몰락지대 등대에 있는 그레이슨 선장에게 늙은 거먹눈 멀록의 비늘을 가져가야 합니다.‡Lleva una escama del Viejo Ojosombrío al capitán Grisillo en el Faro de los Páramos de Poniente.‡Lleva una escama del Viejo Ojosombrío al capitán Grisillo en el Faro de Poniente.‡Rapporter une Ecaille du Vieux Troubloeil au capitaine Grayson au phare de l\'Ouest.‡将老瞎眼的鳞片交给西部荒野灯塔旁的葛瑞森船长。‡將老瞎眼的鱗片交給西部荒野燈塔旁的葛瑞森船長。',
  }
},
[105] = {
  {
    'Adeus, Andorhal‡Увы тебе, Андорал‡Weh dir, Andorhal‡리치의 최후‡Ah, Andorhal‡Ah, Andorhal‡Hélas, Andorhal‡啊，安多哈尔！‡啊，安多哈爾！',
    nil,
    'Leve o Fragmento de Filactério de Araj para o Alto-executor Arcabuz no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите осколок оберега Араджа верховному палачу Деррингтону в Бастион в Западных Чумных землях.‡Bringt den Splitter von Arajs Phylakterium zu Hochexekutor Derrington ins Bollwerk in den westlichen Pestländern.‡서부 역병지대의 보루에 있는 고위집행관 델링턴에게 아라즈의 성물함 조각을 가져가야 합니다.‡Lleva el Fragmento de Filacteria de Araj al sumo ejecutor Derrington en El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva el trozo de filacteria de Araj al sumo ejecutor Derrington en El Baluarte en las Tierras de la Peste del Oeste.‡Apporter l’Eclat phylactère d\'Araj au Grand exécuteur Derrington à la Barricade, dans les Maleterres de l’ouest.‡把阿拉基的护符匣碎片交给西瘟疫之地亡灵壁垒的高级执行官德灵顿。‡把阿拉基的護符匣碎片交給西瘟疫之地亡靈壁壘的高級執行官德靈頓。',
  }
},
[106] = {
  {
    'Jovens amantes‡Юные влюбленные‡Junge Liebende‡젊은 연인들‡Jóvenes enamorados‡Jóvenes enamorados‡Jeunes amoureux‡年轻的恋人‡年輕的戀人',
    nil,
    'Entregue a Carta de Amor de Mabel para Tomasino Campedra.‡Отдайте любовное послание Мэйбелл Томми Джо Стоунфилду.‡Gebt Tommy Joe Stonefield Maybells Liebesbrief.‡토미 조 스톤필드에게 메이벨의 연애 편지를 가져가야 합니다.‡Entrega a Tommy Joe Pedregosa la carta de amor de Maybell.‡Entrega a Tommy Joe Pedregosa la carta de amor de Maybell.‡Donner la Lettre d\'amour de Maybell à Tommy Joe Stonefield.‡把梅贝尔的情书带给托米·乔·斯通菲尔德。‡把梅貝爾的情書帶給托米·喬·斯通菲爾德。',
  }
},
[107] = {
  {
    'Bilhete para Durval‡Записка для Вильяма‡Nachricht an William‡윌리엄에게 보내는 쪽지‡Una nota para William‡Una nota para William‡Note pour William‡给威廉·匹斯特的信‡給威廉·匹斯特的信',
    nil,
    'Leve o Bilhete da Vó Campedra para Durval Pilão.‡Отнесите записку бабули Стоунфилд Вильяму Песту.‡Bringt Oma Stonefields Nachricht zu William Pestle.‡윌리엄 페슬에게 스톤필드 할머니의 쪽지를 전달해야 합니다.‡Lleva la nota de la Abuela Pedregosa a William Mortero.‡Lleva la nota de la Abuela Pedregosa a William Mortero.‡Porter la Note de Mamie Stonefield à William Pestle.‡把斯通菲尔德老奶奶的便笺交给威廉·匹斯特。‡把斯通菲爾德老奶奶的便箋交給威廉·匹斯特。',
  }
},
[108] = {
  {
    '‡‡‡‡‡<TXT> Mystery Reward‡‡‡',
    nil,
    nil,
  }
},
[109] = {
  {
    'Fale com Miguel Mantoforte‡Доклад Гриану Камнегриву‡Meldung bei Gryan Stoutmantle‡그라이언 스타우트맨틀에게 보고‡Habla con Gryan Mantorrecio‡Habla con Gryan Mantorrecio‡Aller voir Gryan Stoutmantle‡向格里安·斯托曼报到‡向格裏安·斯托曼報到',
    nil,
    'Fale com Miguel Mantoforte. Ele costuma ficar na torre de pedras do Morro da Sentinela, perto da estrada central do Cerro Oeste.‡Поговорите с Грианом Камнегривом. Обычно его можно найти в башне, что на Сторожевом холме, у дороги, в самом сердце Западного Края.‡Sprecht mit Gryan Stoutmantle. Normalerweise findet man ihn im Steinturm auf der Späherkuppe, ein kleines Stückchen von der Straße weg, mitten in Westfall.‡그라이언 스타우트맨틀과 대화해야 합니다. 서부 몰락지대의 중심부에서 길을 약간 벗어난 곳에 있는 감시의 언덕 돌탑으로 가면 그를 만날 수 있습니다.‡Habla con Gryan Mantorrecio. Puedes encontrarlo en la torre de piedra de la Colina del Centinela, saliendo de la carretera que cruza los Páramos de Poniente.‡Habla con Gryan Mantorrecio. Puedes encontrarlo en la torre de piedra de la Colina del Centinela, saliendo de la carretera que cruza los Páramos de Poniente.‡Parler à Gryan Stoutmantle. Il se trouve à la Tour de pierre sur la Colline des sentinelles, près la route au centre de la marche de l\'Ouest.‡去和格里安·斯托曼谈一谈，他一般就在哨兵岭的石塔旁，这座石塔位于西部荒野中部地区的路边。‡去和格裏安·斯托曼談壹談，他壹般就在哨兵嶺的石塔旁，這座石塔位於西部荒野中部地區的路邊。',
  }
},
[110] = {
  {
    'Análise de pedaços de inseto‡Анализ частей насекомых‡Insektenteil-Analyse‡곤충 기관 분석‡Análisis de trozos de insecto‡Análisis de trozos de insecto‡Analyse des morceaux d\'insectes‡昆虫研究‡昆蟲研究',
    nil,
    'Veja se o Alquimista Almofarrista em Geringontzan já terminou a análise dos pedaços de inseto.‡Найдите в Прибамбасске алхимика Пестычинса и получите результаты анализа частей насекомых.‡Begebt Euch nach Gadgetzan zu Alchimist Pestlezugg und erkundigt Euch nach der Analyse der Insektenteile.‡가젯잔에 가서 연금술사 페슬저그를 만나 곤충 기관의 분석이 끝났는지 알아보아야 합니다.‡Busca al alquimista Morterozugg en Gadgetzan y comprueba su análisis de los trozos de insecto.‡Busca al alquimista Morterozugg en Gadgetzan y comprueba su análisis de los trozos de insecto.‡Aller voir à Gadgetzan si l\'Alchimiste Pestlezugg a terminé d\'analyser les morceaux d\'insectes.‡到加基森的炼金师匹斯特苏格那里去了解关于昆虫的研究有没有新的进展。‡到加基森的煉金師匹斯特蘇格那裏去了解關於昆蟲的研究有沒有新的進展。',
  }
},
[111] = {
  {
    'Fale com a vovó‡Разговор с бабулей‡Gespräch mit Oma‡할머니와 대화‡Habla con la abuelita‡Habla con la abuelita‡Discuter avec Mamie‡托米的祖母‡托米的祖母',
    nil,
    'Fale com a Vovó Campedra.‡Поговорите с бабулей Стоунфилд.‡Sprecht mit Oma Stonefield.‡스톤필드 할머니와 대화해야 합니다.‡Habla con la Abuela Pedregosa.‡Habla con la Abuela Pedregosa.‡Parler à Mamie Stonefield.‡和斯通菲尔德农场的米斯通菲尔德老奶奶谈一谈。‡和斯通菲爾德農場的米斯通菲爾德老奶奶談壹談。',
  }
},
[112] = {
  {
    'Coletando alga‡Хрустальный фукус‡Die Suche nach dem Tang‡해초 수집‡La recolección de Kelp‡La recolección de algas‡À la recherche du varech‡收集海藻‡收集海藻',
    nil,
    'Leve 4 Folhas de Cristalga para Durval Pilão em Vila d\'Ouro.‡Принесите Уильяму Песту в Златоземье 4 побега хрустального фукуса.‡Bringt 4 Kristalltangwedel nach Goldhain zu William Pestle.‡투명한 해초 잎 4개를 골드샤이어의 윌리엄 페슬에게 가져가야 합니다.‡Lleva 4 hojas de kelp cristalino William Mortero a Villadorada.‡Lleva 4 hojas de alga de cristal a William Mortero a Villadorada.‡Apporter 4 Feuilles de Varech cristallin à William Pestle de Goldshire.‡收集4片水晶藻叶，把它们带给闪金镇的威廉·匹斯特。‡收集4片水晶藻葉，把它們帶給閃金鎮的威廉·匹斯特。',
  }
},
[113] = {
  {
    'Análise de pedaços de inseto‡Анализ частей насекомых‡Insektenteil-Analyse‡곤충 기관 분석‡Análisis de trozos de insecto‡Análisis de trozos de insecto‡Analyse des morceaux d\'insectes‡昆虫研究‡昆蟲研究',
    nil,
    'Leve o relatório para o Topógrafo Sênior Secamolha em Geringontzan. Certifique-se de que ele lhe dê uma cópia, conforme solicitado pelo Alquimista Almofarrista.‡Отнесите отчет старшему исследователю Рудознатцу в Прибамбасск. Получите копию отчета, как просил алхимик Пестычинс.‡Bringt den Bericht nach Gadgetzan zum Leitenden Feldmesser Fizzledowser. Lasst Euch von ihm eine Kopie des Berichts geben, wie Alchimist Pestlezugg gefordert hat.‡가젯잔에 있는 선임측량사 피즐도저에게 곤충 분석 보고서를 가져가야 합니다. 연금술사 페슬저그가 요청한 대로 피즐도저로부터 보고서의 사본을 꼭 받아야 합니다.‡Entrégale el informe al perito jefe Picoflojo de Gadgetzan. Asegúrate de que te da una copia del informe, tal y como el alquimista Morterozugg ha pedido.‡Entrégale el informe al perito jefe Picoflojo de Gadgetzan. Asegúrate de que te da una copia del informe, tal y como el alquimista Morterozugg ha pedido.‡Porter le rapport au grand géomètre Fizzledowser à Gadgetzan. Obtenir une copie de ce rapport, comme l\'alchimiste Pestlezugg l\'a demandé.‡把这份报告带给加基森的高级勘探员菲兹杜瑟，让他按照炼金师匹斯特苏格的要求为你复制一份报告。‡把這份報告帶給加基森的高級勘探員菲茲杜瑟，讓他按照煉金師匹斯特蘇格的要求為妳復制壹份報告。',
  }
},
[114] = {
  {
    'A fuga‡Вылазка‡Die Flucht‡탈출‡La fuga‡La fuga‡La fuite‡梅贝尔的隐形水‡梅貝爾的隱形水',
    nil,
    'Leve o Elixir de Invisibilidade para Mabel Madruga.‡Отнесите напиток невидимости Мэйбелл Маклюр.‡Bringt Maybell Maclure den Unsichtbarkeitsschnaps.‡메이벨 맥클루어에게 투명 물약을 가져가야 합니다.‡Lleva el licor de invisibilidad a Maybell Maclure.‡Lleva el licor de invisibilidad a Maybell Maclure.‡Porter la Potion d\'invisibilité à Maybell Maclure.‡把隐形水带给梅贝尔·马科伦。‡把隱形水帶給梅貝爾·馬科倫。',
  }
},
[115] = {
  {
    'Magia Sombria‡Темная магия‡Schattenmagie‡어둠의 마법‡Magia de las Sombras‡Magia de las Sombras‡Magie des Ténèbres‡暗影魔法‡暗影魔法',
    nil,
    'Leve 3 Orbes da Meia-noite para o Oficial Marris em Vila Plácida.‡Принесите 3 полуночных сферы маршалу Маррису в Приозерье.‡Bringt 3 Mitternachtskugeln nach Seenhain zu Marshal Marris.‡레이크샤이어에 있는 치안대장 매리스에게 암흑의 수정구 3개를 가져가야 합니다.‡Lleva 3 orbes de medianoche al alguacil Marris a Villa del Lago.‡Lleva 3 orbes de medianoche al alguacil Marris a Villa del Lago.‡Apporter 3 Orbes de minuit au maréchal Marris à Lakeshire.‡给湖畔镇的治安官马瑞斯带回3颗午夜宝珠。‡給湖畔鎮的治安官馬瑞斯帶回3顆午夜寶珠。',
  }
},
[116] = {
  {
    'Tempos de seca‡Засуха‡Trockene Zeiten‡떨어져 가는 술‡Tiempos de sequía‡Tiempos de sequía‡Régime sec‡旱季‡旱季',
    nil,
    'O Taberneiro Daniel da Vila Plácida precisa de um barril de Cervaforte, um barril de vinho Merlot, uma garrafa de Pinga e um odre de Rum Doce.‡Принесите кабатчику Дэниэлсу из Озер бочонок громоварского светлого из Западного края, бочонок "Мерло" из Штормграда, бутылку самогона из Темнолесья и бурдюк со сладким ромом из Златоземья.‡Barkeeper Daniels aus Seenhain braucht ein Fässchen Donnerbräu Lagerbier, ein Fässlein Merlot, eine Flasche Fusel und einen Schlauch mit süßem Rum.‡레이크샤이어의 바텐더 대니얼스가 썬더브루 맥주통과 멀롯 술통, 문샤인 병, 향기로운 럼주 주머니를 가져다 달라고 부탁했습니다.‡Lleva 1 barril de cerveza Cebatruenos, 1 barril de vino dulce, 1 botella de licor de luna y 1 botella de ron dulce al posadero Daniels a Villa del Lago.‡Lleva 1 barril de cerveza Cebatruenos, 1 barril de vino dulce, 1 botella de licor de luna y 1 botella de ron dulce al posadero Daniels a Villa del Lago.‡Le tavernier Daniels de Lakeshire a besoin d\'un Tonneau de Thunderbrew, d\'un Tonneau de merlot, d\'une Bouteille de tord-boyaux et d\'une Outre de rhum doux.‡湖畔镇的酒吧老板丹尼尔需要一桶雷霆啤酒，一桶葡萄酒，一瓶月光酒，还有一袋蜂蜜酒。‡湖畔鎮的酒吧老板丹尼爾需要壹桶雷霆啤酒，壹桶葡萄酒，壹瓶月光酒，還有壹袋蜂蜜酒。',
  }
},
[117] = {
  {
    'Cervaforte‡Громоварское‡Donnerbräu‡썬더브루 맥주‡Cebatruenos‡Cerveza Cebatruenos‡La Tonnebière‡雷霆啤酒‡雷霆啤酒',
    nil,
    'Leve 5 lúpulos para Canabraba Cervaforte fazer sua cerveja especial.‡Принесите Мрачнобуху Громовару 5 шишек хмеля.‡Bringt Grimbooze Donnerbräu 5 Hopfen, damit er sein besonderes Bier brauen kann.‡특별한 맥주를 완성할 수 있도록 그림부즈 썬더브루에게 홉 열매 5개를 가져가야 합니다.‡Entrega a Tragoamargo Cebatruenos 5 lúpulos para que pueda terminar su cerveza especial.‡Entrega a Tragoamargo Cebatruenos 5 lúpulos para que pueda terminar su cerveza especial.‡Apporter 5 Pieds de Houblon à Grimbooze Thunderbrew pour qu\'il prépare son breuvage spécial.‡给葛瑞姆·雷酒带去5捆蛇麻草以完成他的特酿。‡給葛瑞姆·雷酒帶去5捆蛇麻草以完成他的特釀。',
  }
},
[118] = {
  {
    'O preço da ferradura‡Цена подков‡Der Preis für Hufeisen‡편자의 가격‡El precio de unas herraduras‡El precio de unas herraduras‡Le prix des fers‡马掌‡馬掌',
    nil,
    'Leve o Bilhete de Vervo para o Ferreiro Argus em Vila d\'Ouro.‡Отнесите записку Вернера кузнецу Аргусу в Златоземье.‡Bringt Verners Nachricht zu Schmied Argus nach Goldhain.‡골드샤이어에 있는 대장장이 아거스에게 베르너의 쪽지를 전달해야 합니다.‡Lleva la nota de Verner al herrero Argus a Villadorada.‡Llévale la nota de Verner al herrero Argus en Villadorada.‡Porter la Note de Verner à Argus le forgeron de Goldshire.‡把弗纳的便笺交给闪金镇的铁匠阿古斯。‡把弗納的便箋交給閃金鎮的鐵匠阿古斯。',
  }
},
[119] = {
  {
    'Fale novamente com Vervo‡Доставка подков‡Zurück zu Verner‡베르너에게 돌아가기‡Vuelve con Verner‡Regresa junto a Verner‡Le retour chez Verner‡回复弗纳‡回復弗納',
    nil,
    'Fale novamente com Vervo Obom em Cristarrubra e entregue o Caixote de Ferraduras.‡Вернитесь к Вернеру Осгуду в Красногорье. Отдайте ему ящик с подковами.‡Kehrt zu Verner Osgood ins Rotkammgebirge zurück. Gebt ihm die Kiste mit Hufeisen.‡붉은마루 산맥에 있는 베르너 오스구드에게 돌아가 편자 상자를 전해 주십시오.‡Vuelve a Crestagrana y entrega la caja de herraduras a Verner Osgood.‡Regresa con Verner Osbien en Crestagrana y entrégale el cajón de herraduras.‡Retourner chez Verner Osgood dans les Carmines et lui donner la caisse de Fers à cheval.‡回去找赤脊山的弗纳·奥斯古，把铁匠阿古斯的一箱马掌交给他。‡回去找赤脊山的弗納·奧斯古，把鐵匠阿古斯的壹箱馬掌交給他。',
  }
},
[120] = {
  {
    'Mensagem para Ventobravo‡Гонец в Штормград‡Botschaft nach Stormwind‡스톰윈드로의 전갈‡Mensajero a Páramos de Poniente‡Mensajero a Ventormenta‡Un message pour Stormwind‡送往暴风城的信‡送往暴風城的信',
    nil,
    'O Magistrado Salomão lhe entregou um relatório que deve ser entregue ao General Marcus Jonas em Ventobravo. O juiz quer que você fale novamente com ele assim que a entrega for feita.‡Мировой судья Соломон просит вас отнести отчет генералу Маркусу Джонатану в Штормград.‡Magistrat Solomon hat Euch einen Bericht übergeben, der bei General Marcus Jonathan in Stormwind abgeliefert werden muss. Der Richter möchte, dass Ihr zu ihm zurückkehrt, sobald Ihr die Nachricht zugestellt habt.‡집정관 솔로몬이 스톰윈드에 있는 장군 마커스 조나단에게 보고서를 전달해 달라고 부탁했습니다. 또한 전달한 후에 즉시 돌아가야 합니다.‡El magistrado Solomon te ha dado un informe para el general Marcus de Ventormenta. Quiere que vuelvas en cuanto lo hayas entregado.‡El magistrado Solomon te ha dado un informe para el general Marcus Jonathan de Ventormenta. Quiere que vuelvas en cuanto lo hayas entregado.‡Le magistrat Solomon vous a remis un rapport qui doit être transmis au général Marcus Jonathan de Stormwind. Il exige que vous reveniez vers lui aussitôt que vous aurez donné le message.‡所罗门镇长要求你给暴风城的马库斯·乔纳森将军送一封信，并且在完成任务之后尽快回报。‡所羅門鎮長要求妳給暴風城的馬庫斯·喬納森將軍送壹封信，並且在完成任務之後盡快回報。',
  }
},
[121] = {
  {
    'Mensagem para Ventobravo‡Посланец в Штормград‡Botschaft nach Stormwind‡스톰윈드로의 전갈‡Mensajero a Páramos de Poniente‡Mensajero a Ventormenta‡Un message pour Stormwind‡送往暴风城的信‡送往暴風城的信',
    nil,
    'Leve a resposta do General Marcus Jonas para o Magistrado Salomão em Vila Plácida.‡Отнесите ответ генерала Маркуса Джонатана мировому судье Соломону в Приозерье.‡Bringt General Marcus Jonathans Antwortschreiben nach Seenhain zu Magistrat Solomon.‡레이크샤이어의 집정관 솔로몬에게 장군 마커스 조나단의 답장을 전달해 주어야 합니다.‡Lleva la respuesta del general Marcus Jonathan al magistrado Solomon a Villa del Lago.‡Lleva la respuesta del general Marcus Jonathan al magistrado Solomon a Villa del Lago.‡Porter la réponse du général Marcus Jonathan au magistrat Solomon, à Lakeshire.‡将暴风城的马库斯·乔纳森将军的回信带给湖畔镇的所罗门镇长。‡將暴風城的馬庫斯·喬納森將軍的回信帶給湖畔鎮的所羅門鎮長。',
  }
},
[122] = {
  {
    'Escamas do ventre‡Брюшная чешуя‡Bauchschuppen‡얇은 새끼용 비늘‡Escamas de barriga‡Escamas de barriga‡Les écailles de dragonnet‡雏龙的鳞片‡雛龍的鱗片',
    nil,
    'Colete 6 Escamas de Ventre de Dragonete Negro e leve-as para Vervo Obom em Cristarrubra.‡Добудьте 6 лоскутов чешуи с брюха черных дракончиков и отнесите их Вернеру Осгуду в Красногорье.‡Sammelt 6 Welpenbauchschuppen von schwarzen Großdrachenwelpen ein und bringt sie ins Rotkammgebirge zu Verner Osgood.‡얇은 새끼용 비늘을 6개 모아 붉은마루 산맥에 있는 베르너 오스구드에게 가져가야 합니다.‡Lleva 6 escamas de barriga de cachorro de dragón Negro a Verner Osbien a Crestagrana.‡Lleva 6 escamas de barriga de cachorro de dragón Negro a Verner Osbien a Crestagrana.‡Rassembler 6 Ecailles ventrales de dragonnet noir et les apporter à Verner Osgood dans les Carmines.‡从黑龙雏龙身上收集6片雏龙的腹鳞，把它们交给赤脊山的弗纳·奥斯古。‡從黑龍雛龍身上收集6片雛龍的腹鱗，把它們交給赤脊山的弗納·奧斯古。',
  }
},
[123] = {
  {
    'O Coletor‡Вымогатель‡Der Sammler‡징세관‡El Coleccionista‡El Coleccionista‡Le collecteur‡收货人‡收貨人',
    nil,
    'Fale com o Delegado Durão na Vila d\'Ouro e lhe entregue a Escala do Coletor.‡Пойдите в Златоземье к маршалу Дугхану и отдайте ему расписание Вымогателя.‡Begebt Euch zu Marshal Dughan nach Goldhain und gebt ihm den Zeitplan des Sammlers.‡골드샤이어의 치안대장 더그한에게 가서 징세관의 수금 일정표를 건네 주어야 합니다.‡Busca al alguacil Dughan en Villadorada y dale la lista de coleccionista.‡Ve a ver al alguacil Dughan en Villadorada y entrégale la lista del coleccionista‡Aller voir le maréchal Dughan, à Goldshire, et lui donner le Plan de route du Collecteur.‡去闪金镇找治安官杜汉，把收货人的交易日程表交给他。‡去閃金鎮找治安官杜漢，把收貨人的交易日程表交給他。',
  }
},
[124] = {
  {
    'Gnoll que ladra também morde‡Лай гноллов‡Das Bellen der Gnolle‡놀의 울음소리‡El aullido de los gnolls‡El aullido de los gnolls‡Le hurlement des gnolls‡豺狼人的乱吠‡豺狼人的亂吠',
    nil,
    'Mate 10 Brutamontes de Cristarrubra e 8 Místicos de Cristarrubra e fale novamente com Vervo Obom.‡Убейте 10 громил из стаи Красногорья и 8 мистиков из стаи Красногорья. Вернитесь к Вернеру Осгуду.‡Tötet 10 Schläger der Rotkammgnolle und 8 Mystiker der Rotkammgnolle und kehrt anschließend zu Verner Osgood zurück.‡붉은마루일족 투사 10마리와 붉은마루일족 비술사 8마리를 처치한 다음 베르너 오스구드에게 돌아가십시오.‡Mata a 10 brutos y 8 místicos Crestagrana y ve a ver a Verner Osgood.‡Mata a 10 toscos y 8 místicos Crestagrana y ve a ver a Verner Osbien.‡Tuer 10 Brutes des Carmines et 8 Mystiques des Carmines, puis retourner chez Verner Osgood.‡杀掉10只赤脊山蛮兵和8只赤脊山秘法师，然后向弗纳·奥斯古复命。‡殺掉10只赤脊山蠻兵和8只赤脊山秘法師，然後向弗納·奧斯古復命。',
  }
},
[125] = {
  {
    'As ferramentas perdidas‡Утраченные инструменты‡Die verlorenen Werkzeuge‡잃어버린 연장통‡Las herramientas perdidas‡Las herramientas perdidas‡Les outils perdus‡丢失的工具‡丟失的工具',
    nil,
    'O Encarregado Oslow quer que você recupere sua caixa de ferramentas no fundo do Lago Plácido.‡Достаньте ящик с инструментами штейгера Ослоу со дна Озера Безмолвия.‡Großknecht Oslow aus Seenhain möchte, dass Ihr seinen Werkzeugkasten vom Grunde des Immerruhsees heraufholt.‡레이크샤이어의 현장감독 오슬로가 영원의 호수의 밑바닥에서 그의 연장통을 찾아다 달라고 부탁했습니다.‡El supervisor Oslow de Villa del Lago quiere que recojas su caja de herramientas del fondo del Lago Sempiterno.‡El supervisor Olento de Villa del Lago quiere que recojas su caja de herramientas del fondo del Lago Sempiterno.‡Le contremaître Oslow de Lakeshire veut que vous récupériez sa Boîte d\'outils au fond du lac Placide.‡湖畔镇的工头奥斯洛希望你帮他找回沉入止水湖底的工具箱。‡湖畔鎮的工頭奧斯洛希望妳幫他找回沈入止水湖底的工具箱。',
  }
},
[126] = {
  {
    'O gnoll de Vila Plácida‡Вой в холмах‡Geheul in den Hügeln‡언덕에서 들려 오는 울음소리‡El aullido de las colinas‡El aullido de las colinas‡Les collines aux hurlements‡群山中的嚎叫‡群山中的嚎叫',
    nil,
    'Leve a Pata de Berrante para Vervo Obom na Vila Plácida.‡Принесите лапу Изувоя Вернеру Осгуду в Приозерье.‡Bringt Jaulers Tatze nach Seenhain zu Verner Osgood.‡레이크샤이어에 있는 베르너 오스구드에게 요울러의 앞발을 가져가야 합니다.‡Lleva la zarpa de Ululante a Verner Osgood a Villa del Lago.‡Lleva la zarpa de Ululante a Verner Osbien a Villa del Lago.‡Rapporter la patte de Couineur à Verner Osgood à Lakeshire.‡将犹勒的爪子带回给湖畔镇的弗纳·奥斯古。‡將猶勒的爪子帶回給湖畔鎮的弗納·奧斯古。',
  }
},
[127] = {
  {
    'O lago está para peixe‡Продажа рыбы‡Fischhandel‡물고기 매매‡Pescado a la venta‡Pescado a la venta‡Criée aux poissons‡卖鱼‡賣魚',
    nil,
    'Leve 10 Peixes-lua Malhados para o Mestre de Doca Baren na Vila Plácida.‡Принесите 10 тушек пятнистой рыбы-луны портовому начальнику Барену в Приозерье.‡Bringt 10 gefleckte Sonnenfische nach Seenhain zu Dockmeister Baren.‡레이크샤이어에 있는 항구주임 바렌에게 점박이 개복치 10마리를 가져가야 합니다.‡Lleva 10 peces luna moteados al maestro de embarcadero Baren a Villa del Lago.‡Lleva 10 peces luna moteados al maestro de embarcadero Baren a Villa del Lago.‡Rapporter 10 Poissons-lunes au Chef des docks Baren à Lakeshire.‡给湖畔镇的码头管理员巴伦带去10条斑点太阳鱼。‡給湖畔鎮的碼頭管理員巴倫帶去10條斑點太陽魚。',
  }
},
[128] = {
  {
    'Recompensa pelos Rocha Negra‡Награда за головы орков Черной горы‡Kopfgeld auf die Blackrocks‡검은바위부족 현상금‡La recompensa de Roca Negra‡La recompensa de Roca Negra‡La prime Blackrock‡悬赏：黑石氏族‡懸賞：黑石氏族',
    nil,
    'Mate 15 Campeões Rocha Negra e o Guarda Howe vai recompensar você na Vila Plácida.‡Убейте 15 воителей из клана Черной горы.‡Tötet 15 Helden der Blackrock, dann erhaltet Ihr von Wache Howe aus Seenhain eine Belohnung.‡검은바위부족 용사 15명을 처치하십시오. 그러면 레이크샤이어의 경비병 하우가 보상을 해줄 것입니다.‡Mata a 15 campeones Roca Negra y el guardia Howe te recompensará en Villa del Lago.‡Mata a 15 campeones Roca Negra y el guardia Howe te recompensará en Villa del Lago.‡Tuez 15 Champions Blackrock et le garde Howe de Lakeshire vous récompensera.‡杀死15名黑石勇士，并向湖畔镇的卫兵豪维复命。‡殺死15名黑石勇士，並向湖畔鎮的衛兵豪維復命。',
  }
},
[129] = {
  {
    'Almoço grátis‡Бесплатный обед‡Ein geschenktes Mittagessen‡공짜 점심‡Una comida gratis‡Una comida gratis‡Un repas gratuit‡免费的午餐‡免費的午餐',
    nil,
    'Leve o Almoço do Florestan para o Guarda Florestan. Ele patrulha a estrada que leva à Vila Sombria.‡Отнесите обед стражнику Паркеру. Он патрулирует дорогу, ведущую в Темнолесье.‡Bringt Parkers Mittagessen zu Wache Parker. Er ist auf der Straße nach Dunkelhain auf Patrouille.‡다크샤이어로 가는 도로를 순찰하고 있는 경비병 파커의 도시락을 가져가야 합니다.‡Llévale su comida al guardia Parker. Está de patrulla en el camino a Villa Oscura.‡Llévale su comida al guardia Parker. Está de patrulla en el camino a Villa Oscura.‡Apporter son déjeuner au Garde Parker. Il patrouille sur la route qui mène au Darkshire.‡将卫兵帕克的午餐带给他，他就在通向夜色镇的路上巡逻。‡將衛兵帕克的午餐帶給他，他就在通向夜色鎮的路上巡邏。',
  }
},
[130] = {
  {
    'Visita à herborista‡Визит к травнице‡Besuch im Kräuterladen‡약초채집가 방문‡Una visita al herborista‡Una visita al herborista‡Une visite chez l\'herboriste‡寻访草药师‡尋訪草藥師',
    nil,
    'Falar com a Herborista de Cristarrubra, Martie Jainrose.‡Поговорите с травницей Красногорья Марти Джайнроз.‡Sprecht mit der Kräuterkundigen des Rotkammgebirges, Martie Jainrose.‡붉은마루 산맥 약초채집가, 마티 제인로즈와 대화하십시오.‡Habla con Martie Jainrose, la herborista de Crestagrana.‡Habla con Martie Jainrose, la herborista de Crestagrana.‡Parler à Martie Jainrose, l\'Herboriste des Carmines.‡找到草药师玛蒂·詹罗斯，和她谈一谈。‡找到草藥師瑪蒂·詹羅斯，和她談壹談。',
  }
},
[131] = {
  {
    'Narcisos para entrega‡Доставка нарциссов‡Narzissen für eine Dame‡나팔수선화 배달‡Un ramo de narcisos‡Un ramo de narcisos‡Bouquet de jonquilles‡水仙诉衷情‡水仙訴衷情',
    nil,
    'Dê para Darcy o Buquê de Narcisos.‡Отнесите Дарси букет нарциссов.‡Gebt Darcy den Narzissenstrauß.‡달시에게 나팔수선화 꽃다발을 주어야 합니다.‡Dale el ramo de narcisos a Darcy.‡Dale el ramo de narcisos a Darcy.‡Donner à Darcy le bouquet de jonquilles.‡将水仙花送给达希。‡將水仙花送給達希。',
  }
},
[132] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Leve o Bilhete do Wiley para Miguel Mantoforte no Cerro Oeste.‡Отнесите записку Вилли Гриану Камнегриву в Западный Край.‡Bringt Wileys Nachricht nach Westfall zu Gryan Stoutmantle.‡서부 몰락지대에 있는 그라이언 스타우트맨틀에게 와일리의 쪽지를 전달해야 합니다.‡Lleva la Nota de Wiley a Gryan Mantorrecio en los Páramos de Poniente.‡Lleva la Nota de Wiley a Gryan Mantorrecio en los Páramos de Poniente.‡Apporter la Note de Wiley à Gryan Stoutmantle, dans la marche de l\'Ouest‡将威利的便笺交给西部荒野的格里安·斯托曼。‡將威利的便箋交給西部荒野的格裏安·斯托曼。',
  }
},
[133] = {
  {
    'Boneco de carniçal‡Фигурка вурдалака‡Ein Ghulbildnis‡구울 허수아비‡Un espantapájaros para necrófagos‡Un espantapájaros para necrófagos‡L\'épouvantail à goules‡食尸鬼假人‡食屍鬼假人',
    nil,
    'Colete 7 Costelas de Carniçal e leve-as para Abercrombie na cabana dele.‡Добудьте 7 ребер вурдалаков и принесите их в хижину Аберкромби.‡Sammelt 7 Ghulrippen und bringt sie zu Calvinius in seiner Hütte.‡구울 해골 7개를 모아 통나무집에 있는 에이버크롬비에게 가져가야 합니다.‡Reúne 7 costillas de necrófago y llévaselas a Abercrombie a su cabaña.‡Reúne 7 costillas de necrófago y llévaselas a Abercrombie a su cabaña.‡Trouver 7 Côtes de goule. Les apporter à Abercrombie dans sa cabane.‡收集7个食尸鬼的肋骨，然后把它们交给亚伯克隆比。‡收集7個食屍鬼的肋骨，然後把它們交給亞伯克隆比。',
  }
},
[134] = {
  {
    'Ogros ladrões‡Нападение огров‡Ogerdiebe‡오우거 도적 떼‡Ladrones ogros‡Ladrones ogros‡Les ogres voleurs‡食人魔潜行者‡食人魔潛行者',
    nil,
    'Devolva o Caixote do Abercrombie para o Abercrombie.‡Вернуть ящик Аберкромби владельцу.‡Bringt Calvinius\' Kiste zu Calvinius.‡에이버크롬비에게 에이버크롬비의 상자를 되찾아 주어야 합니다.‡Devuelve a Abercrombie la caja de Abercrombie.‡Devuelve a Abercrombie el cajón de Abercrombie.‡Rapporter sa caisse à Abercrombie.‡把亚伯克隆比的箱子拿回来交给他。‡把亞伯克隆比的箱子拿回來交給他。',
  }
},
[135] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Leve o Bilhete do Wiley para Mathias Shaw em Ventobravo.‡Отнесите записку Вилли Матиасу Шоу в Штормград.‡Bringt Wileys Nachricht nach Stormwind zu Mathias Shaw.‡스톰윈드에 있는 마티아스 쇼에게 와일리의 쪽지를 가져가야 합니다.‡Lleva la Nota de Wiley a Mathias Shaw de Ventormenta.‡Lleva la Nota de Wiley a Mathias Shaw de Ventormenta.‡Apporter la Note de Wiley à Mathias Shaw à Stormwind.‡将威利的便笺交给暴风城的马迪亚斯·肖尔。‡將威利的便箋交給暴風城的馬迪亞斯·肖爾。',
  }
},
[136] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders Versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Encontre o baú do Capitão Albernaz e procure a próxima pista dentro dele.‡Найдите сундучок капитана Сандерса и поищите в нем следующую подсказку.‡Findet Käpt\'n Sanders Schließkiste und durchsucht sie, um den nächsten Hinweis zu erhalten.‡샌더 선장의 사물함에서 다음 단서를 찾아야 합니다.‡Encuentra el baúl del capitán Sanders y busca la siguiente pista.‡Encuentra el baúl del capitán Sanders y busca la siguiente pista.‡Trouver le Coffre du capitaine Sanders. Le fouiller pour trouver l\'indice suivant.‡找到杉德尔船长的手提箱，在箱子中寻找下一条线索。‡找到杉德爾船長的手提箱，在箱子中尋找下壹條線索。',
  }
},
[138] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Encontre o velho barril perto da chaminé em ruínas e procure a próxima pista dentro dele.‡Найдите старую бочку рядом с разрушенным очагом и поищите в ней следующий ключ.‡Findet das alte Fass in der Nähe des verfallenen Kamins und durchsucht es nach Eurem nächsten Hinweis.‡다음 단서를 얻기 위해 굴뚝 잔해 근처에서 낡은 통을 찾아야 합니다.‡Busca el viejo barril junto a la chimenea en ruinas y busca la siguiente pista.‡Busca el viejo barril junto a la chimenea en ruinas y busca la siguiente pista.‡Trouver le Tonneau à côté des cheminées en ruine. Le fouiller pour trouver l\'indice suivant.‡找到废弃烟囱旁的老木桶，在桶里寻找下一条线索。‡找到廢棄煙囪旁的老木桶，在桶裏尋找下壹條線索。',
  }
},
[139] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders Versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Procure a próxima pista dentro do garrafão vazio perto do moinho de vento.‡Найдите следующую подсказку в пустом кувшине, найденном рядом с ветряной мельницей.‡Durchsucht den leeren Henkelkrug neben der Windmühle nach dem nächsten Hinweis.‡다음 단서를 찾기 위해 풍차 옆에 있는 빈 단지를 살펴봐야 합니다.‡Busca la jarra vacía junto al molino de viento para encontrar la siguiente pista.‡Busca la jarra vacía junto al molino de viento para encontrar la siguiente pista.‡Chercher la Cruche vide à côté du moulin à vent pour trouver le prochain indice.‡在风车旁的一个空水罐里寻找下一条线索。‡在風車旁的壹個空水罐裏尋找下壹條線索。',
  }
},
[140] = {
  {
    'O tesouro escondido do Capitão Albernaz‡Спрятанное сокровище капитана Сандерса‡Käpt\'n Sanders Versteckter Schatz‡샌더 선장의 숨겨진 보물‡El tesoro escondido del capitán Sanders‡El tesoro escondido del capitán Sanders‡Le trésor caché du capitaine Sanders‡杉德尔船长的宝藏‡杉德爾船長的寶藏',
    nil,
    'Encontre o baú do Capitão Albernaz e abra-o para receber sua recompensa.‡Установите местонахождение сундука капитана Сандерса и откройте его.‡Findet Käpt\'n Sanders Truhe und öffnet sie. Darin befindet sich Eure Belohnung.‡보물을 얻기 위해 샌더 선장의 보물 상자를 찾아 열어야 합니다.‡Localiza la arqueta del capitán Sanders y ábrela para obtener tu recompensa.‡Localiza la arqueta del capitán Sanders y ábrela para obtener tu recompensa.‡Localiser le Coffre au trésor du capitaine Sanders et prendre votre récompense.‡找到杉德尔船长的箱子并打开它，取得你的奖励。‡找到杉德爾船長的箱子並打開它，取得妳的獎勵。',
  }
},
[141] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Leve o Relatório do Shaw para Miguel Mantoforte no Cerro Oeste.‡Передайте документ, написанный Шоу, Гриану Камнегриву в Западный Край.‡Bringt Shaws Bericht nach Westfall zu Gryan Stoutmantle.‡서부 몰락지대의 그라이언 스타우트맨틀에게 쇼의 보고서를 가져가야 합니다.‡Lleva el informe de Shaw a Gryan Mantorrecio de los Páramos de Poniente.‡Lleva el informe de Shaw a Gryan Mantorrecio de los Páramos de Poniente.‡Apporter le Rapport de Shaw à Gryan Stoutmantle, dans la marche de l\'Ouest.‡将肖尔的报告交给西部荒野的格里安·斯托曼。‡將肖爾的報告交給西部荒野的格裏安·斯托曼。',
  }
},
[142] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Rastreie o Mensageiro Défias no Cerro Oeste e leve sua mensagem para Mantoforte.‡Выследите вестника из Братства Справедливости в Западном Крае и принесите отнятое у него сообщение Гриану Камнегриву.‡Spürt den Boten der Defias in Westfall auf und bringt die Nachricht, die er bei sich hat, zu Stoutmantle.‡서부 몰락지대에서 데피아즈단 전령을 추적하여 그가 전하려던 전갈을 스타우트맨틀에게 전해야 합니다.‡Localiza al mensajero Defias de los Páramos de Poniente y lleva su mensaje a Mantorrecio.‡Localiza al mensajero Defias de los Páramos de Poniente y lleva su mensaje a Mantorrecio.‡Traquer le Messager défias dans la marche de l\'Ouest et apporter les documents qu\'il transporte à Stoutmantle.‡追捕西部荒野的迪菲亚信使，并将他身上携带着的信件交给斯托曼。‡追捕西部荒野的迪菲亞信使，並將他身上攜帶著的信件交給斯托曼。',
  }
},
[143] = {
  {
    'Mensagem para Cerro Oeste‡Гонец в Западный Край‡Botschaft nach Westfall‡서부 몰락지대로의 전갈‡Mensajero a Páramos de Poniente‡Mensajero a los Páramos de Poniente‡Un message pour la marche de l\'Ouest‡送往西部荒野的信‡送往西部荒野的信',
    nil,
    'O Magistrado Salomão quer que você leve a súplica dele a Miguel Mantoforte em Cerro Oeste.‡Отнесите просьбу о помощи Гриану Камнегриву в Западный Край.‡Magistrat Solomon möchte, dass Ihr sein Hilfegesuch nach Westfall zu Gryan Stoutmantle bringt.‡집정관 솔로몬이 서부 몰락지대에 있는 그라이언 스타우트맨틀에게 자신이 직접 작성한 탄원서를 전달해 달라고 부탁했습니다.‡El magistrado Solomon quiere que lleves su petición a Gryan Mantorrecio a Páramos de Poniente.‡El magistrado Solomon quiere que lleves su petición a Gryan Mantorrecio a los Páramos de Poniente.‡Le Magistrat Solomon veut que vous portiez sa Demande d\'aide à Gryan Stoutmantle dans la marche de l\'Ouest.‡所罗门镇长要求你给西部荒野的格里安·斯托曼送一封信。‡所羅門鎮長要求妳給西部荒野的格裏安·斯托曼送壹封信。',
  }
},
[144] = {
  {
    'Mensagem para Cerro Oeste‡Гонец в Западный Край‡Botschaft nach Westfall‡서부 몰락지대로의 전갈‡Mensajero a Villa Oscura‡Mensajero a los Páramos de Poniente‡Un message pour la marche de l\'Ouest‡送往西部荒野的信‡送往西部荒野的信',
    nil,
    'Fale novamente com o Magistrado Salomão e relate a resposta de Miguel Mantoforte.‡Вернитесь к чиновнику Соломону с ответом Гриана Камнегрива.‡Kehrt mit Gryan Stoutmantles Antwort zu Magistrat Solomon zurück.‡그라이언 스타우트맨틀의 답장을 가지고 집정관 솔로몬에게 돌아가십시오.‡Lleva la respuesta de Gryan Mantorrecio al magistrado Solomon.‡Lleva la respuesta de Gryan Mantorrecio al magistrado Solomon.‡Retourner voir le Magistrat Solomon avec la Réponse de Stoutmantle.‡将格里安·斯托曼的回信带给所罗门镇长。‡將格裏安·斯托曼的回信帶給所羅門鎮長。',
  }
},
[145] = {
  {
    'Mensagem para Vila Sombria‡Гонец в Темнолесье‡Botschaft nach Dunkelhain‡다크샤이어로의 전갈‡Mensajero a Villa Oscura‡Mensajero a Villa Oscura‡Un message pour Darkshire‡送往夜色镇的信‡送往夜色鎮的信',
    nil,
    'O Magistrado Salomão quer que você entregue uma carta ao senhor Ebanez na Vila Sombria.‡Отнесите письмо лорду Чернодреву в Темнолесье.‡Magistrat Solomon möchte, dass Ihr einen Brief zu Lord Ebonlocke nach Dunkelhain bringt.‡집정관 솔로몬이 다크샤이어에 있는 이본로크 경에게 탄원서를 전달해 달라고 부탁했습니다.‡El magistrado Solomon quiere que lleves una carta a Lord Ebonlocke a Villa Oscura.‡El magistrado Solomon quiere que lleves una carta a Lord Cerranegro a Villa Oscura.‡Le magistrat Solomon veut que vous apportiez une lettre au seigneur Ebonlocke de Darkshire.‡所罗门镇长要求你给夜色镇的艾尔罗·埃伯洛克公爵送一封信。‡所羅門鎮長要求妳給夜色鎮的艾爾羅·埃伯洛克公爵送壹封信。',
  }
},
[146] = {
  {
    'Mensagem para Vila Sombria‡Гонец в Темнолесье‡Botschaft nach Dunkelhain‡다크샤이어로의 전갈‡Mensajero a Villa Oscura‡Mensajero a Villa Oscura‡Un message pour Darkshire‡送往夜色镇的信‡送往夜色鎮的信',
    nil,
    'Fale novamente com o Magistrado Salomão e relate a resposta do senhor Ebanez.‡Вернитесь к мировому судье Соломону с ответом лорда Элло Чернодрева.‡Kehrt mit Lord Ebonlockes Antwortschreiben zu Magistrat Solomon zurück.‡이본로크 경의 답장을 가지고 집정관 솔로몬에게 돌아가야 합니다.‡Lleva la respuesta de Lord Cerranegro al magistrado Solomon.‡Lleva la respuesta de Lord Cerranegro al magistrado Solomon.‡Retourner voir le Magistrat Solomon avec la Lettre en réponse du Seigneur Ebonlocke.‡将埃伯洛克公爵的回信带给所罗门镇长。‡將埃伯洛克公爵的回信帶給所羅門鎮長。',
  }
},
[147] = {
  {
    'Perseguição implacável‡Охота на человека‡Menschenjagd‡징세관 수사‡La persecución‡La persecución‡Chasse à l\'homme‡猎杀收货人‡獵殺收貨人',
    nil,
    'Encontre e mate "o Coletor". Depois, entregue o Anel do Coletor para o Delegado Durão.‡Найдите и убейте Вымогателя, а затем принесите его кольцо маршалу Дугхану.‡Findet den "Sammler" und tötet ihn, dann kehrt mit dem Ring des Sammlers zu Marshal Dughan zurück.‡징세관을 찾아서 처치한 다음 징세관의 반지를 가지고 치안대장 더그한에게 돌아가야 합니다.‡Encuentra y mata al Coleccionista y vuelve junto al alguacil Dughan con la sortija de coleccionista.‡Encuentra y mata al Coleccionista y vuelve junto al alguacil Dughan con el anillo del coleccionista.‡Trouver et tuer le "Collecteur" puis rapporter son Anneau au maréchal Dughan.‡找到“收货人”并将他杀掉，然后带着收货人的戒指回来见治安官杜汉。‡找到“收貨人”並將他殺掉，然後帶著收貨人的戒指回來見治安官杜漢。',
  }
},
[148] = {
  {
    'Suprimentos da Vila Sombria‡Припасы из Темнолесья‡Lieferung aus Dunkelhain‡다크샤이어로부터의 보급품‡Suministros de Villa Oscura‡Suministros de Villa Oscura‡Fournitures en provenance de Darkshire‡来自夜色镇的货物‡來自夜色鎮的貨物',
    nil,
    'Fale com Madame Eva.‡Поговорите с мадам Евой.‡Sprecht mit Madame Eva.‡에바 부인과 대화해야 합니다.‡Habla con Lady Eva.‡Habla con Lady Eva.‡S’adresser à Madame Eva.‡去和伊瓦夫人谈一谈。‡去和伊瓦夫人談壹談。',
  }
},
[149] = {
  {
    'Linha de Cabelo de Fantasma‡Прядь призрачных волос‡Geisterhaarfaden‡유령의 머리 가닥‡Hilo de pelo de fantasma‡Hilo de cabello de fantasma‡Mèche de cheveux fantômes‡幽灵的发丝‡幽靈的發絲',
    nil,
    'Leve o Pente Espectral para a Maria Cega.‡Отнесите Слепой Мэри призрачный гребень.‡Bringt der blinden Mary den spektralen Kamm.‡눈 먼 매리에게 유령의 빗을 가져가야 합니다.‡Lleva el peine espectral a Mary la Ciega.‡Lleva el peine espectral a Mary la Ciega.‡Apporter le Peigne spectral à Marie l\'Aveugle.‡把鬼梳带给盲眼玛丽。‡把鬼梳帶給盲眼瑪麗。',
  }
},
[150] = {
  {
    'Caçadores de murlocs‡Мурлоки-браконьеры‡Murlocwilderer‡침입자 멀록‡Cazadores furtivos‡Cazadores furtivos‡Les braconniers murlocs‡鱼人偷猎者‡魚人偷獵者',
    nil,
    'Leve 8 Barbatanas de Murloc para o Mestre de Doca Baren em Vila Plácida.‡Принесите 8 плавников мурлоков портовому начальнику Барену в Приозерье.‡Bringt 8 Murlocflossen nach Seenhain zu Dockmeister Baren.‡레이크샤이어에 있는 항구주임 바렌에게 멀록 지느러미 8개를 가져가야 합니다.‡Lleva 8 ancas múrloc al maestro de embarcadero Baren a Villa del Lago.‡Lleva 8 aletas múrloc al maestro de embarcadero Baren a Villa del Lago.‡Apporter 8 Ailerons de murloc au Chef des docks Baren à Lakeshire‡给湖畔镇的码头管理员巴伦带回8片鱼人的鳍。‡給湖畔鎮的碼頭管理員巴倫帶回8片魚人的鰭。',
  }
},
[151] = {
  {
    'Pobre Velha Brancurinha‡Бедная старая Савраска‡Die arme Graumähne‡늙은말 블랑쉬‡La pobre y vieja Blanchy‡La pobre y vieja Blanchy‡Pauvre Vieille Blanchy !‡老马布兰契‡老馬布蘭契',
    nil,
    'Vera Taturana quer que você leve 8 Punhados de Aveia para ela em Cerro Oeste.‡Принесите 8 горстей овса Верне Хмуробров.‡Verna Furlbrow in Westfall möchte, dass Ihr ihr 8 Hände voll Hafer bringt.‡서부 몰락지대의 베르나 펄브로우가 귀리 한 줌 8개를 가져다 달라고 부탁했습니다.‡Verna Furlbrow de los Páramos de Poniente quiere que le lleves 8 puñados de avena.‡Verna Cejade de los Páramos de Poniente quiere que le lleves 8 puñados de avena.‡Verna Furlbrow de la marche de l\'Ouest veut que vous lui apportiez 8 Poignées d\'avoine.‡西部荒野的弗娜·法布隆要求你带给她8捧燕麦。‡西部荒野的弗娜·法布隆要求妳帶給她8捧燕麥。',
  }
},
[152] = {
  {
    'Há perigo na costa‡Зачистка побережья‡Ärger an der Küste‡남아 있는 위험‡Hay moros en la costa‡Hay moros en la costa‡La côte n\'est pas sûre‡清理海岸‡清理海岸',
    nil,
    'Mate 7 Caçamarés, 7 Guerreiros, 7 Oráculos e 7 Correcostas e fale novamente om o Capitão Calvino no Farol de Cerro Oeste.‡Убейте 7 волноловов, 7 воинов, 7 оракулов и 7 береговиков-мурлоков и вернитесь к капитану Грейсону на Маяк в Западном Крае.‡Tötet 7 Gezeitenjäger, 7 Krieger, 7 Orakel sowie 7 Küstenläufer und kehrt dann zu Captain Grayson beim Leuchtturm von Westfall zurück.‡멀록 바다사냥꾼 7마리, 멀록 전사 7마리, 멀록 점쟁이 7마리, 멀록 길잡이 7마리를 처치하고 서부 몰락지대 등대에 있는 그레이슨 선장에게 돌아가야 합니다.‡Mata 7 cazamareas, 7 guerreros, 7 oráculos y 7 correcostas y vuelve con el capitán Grisillo en el Faro de los Páramos de Poniente.‡Mata 7 cazamareas, 7 guerreros, 7 oráculos y 7 correcostas y vuelve con el capitán Grisillo en el Faro de Poniente.‡Tuer 7 Chasse-marées, 7 Guerriers, 7 Oracles et 7 Cours-la-côte, puis retourner voir le capitaine Grayson au Phare de l\'Ouest.‡杀死7只鱼人潮行者、7只鱼人战士、7只鱼人智者，还有7只鱼人滩行者，然后向西部荒野灯塔中的葛瑞森船长复命。‡殺死7只魚人潮行者、7只魚人戰士、7只魚人智者，還有7只魚人灘行者，然後向西部荒野燈塔中的葛瑞森船長復命。',
  }
},
[153] = {
  {
    'Bandanas vermelhas de couro‡Красные кожаные банданы‡Rote Lederkopftücher‡붉은 가죽 복면‡Pañuelos rojos de cuero‡Pañuelos rojos de cuero‡Les masques en cuir rouge‡红色皮质面罩‡紅色皮質面罩',
    nil,
    'Leve 15 Bandanas Vermelhas de Couro para o Batedor Galiaan no Morro da Sentinela.‡Принесите разведчику Галиану на Сторожевой холм 15 красных кожаных бандан.‡Bringt 15 rote Lederkopftücher auf die Späherkuppe zu Späher Galiaan.‡감시의 언덕의 정찰병 갈리안에게 붉은 가죽 복면 15개를 가져가야 합니다.‡Lleva 15 pañuelos de cuero rojo al explorador Galiaan en la Colina del Centinela.‡Lleva 15 pañuelos de cuero rojo al explorador Galiaan en la Colina del Centinela.‡Apporter 15 Masques en cuir rouge à l\'éclaireur Galiaan à la Colline des sentinelles.‡给哨兵岭的哨兵加里安带回15条红色皮质面罩。‡給哨兵嶺的哨兵加裏安帶回15條紅色皮質面罩。',
  }
},
[154] = {
  {
    'Devolva o pente‡Гребень для Эвы‡Rückkehr mit dem Kamm‡유령의 빗 돌려주기‡Devuelve el peine‡Devuelve el peine‡Rendre le peigne‡归还梳子‡歸還梳子',
    nil,
    'Devolva o Pente de Fantasma para Madame Eva na Vila Sombria.‡Верните гребень для призрачных волос мадам Еве в Темнолесье.‡Bringt den Geisterhaarkamm zu Madame Eva nach Dunkelhain.‡다크샤이어의 에바 부인에게 유령의 머리빗을 다시 가져가야 합니다.‡Lleva el peine de fantasma a Lady Eva a Villa Oscura.‡Lleva el peine de fantasma a Lady Eva a Villa Oscura.‡Rapporter le Peigne spectral à Madame Eva à Darkshire.‡把幽灵的梳子拿回去交给夜色镇的伊瓦夫人。‡把幽靈的梳子拿回去交給夜色鎮的伊瓦夫人。',
  }
},
[155] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Escolte o Traidor Défias ao esconderijo secreto da Irmandade Défias. Quando o Traidor Défias mostrar onde VanCleef e seus comparsas estão escondidos, retorne a Miguel Mantoforte com a informação.‡Сопроводите предателя к тайному убежищу Братства Справедливости. Когда он покажет, где прячутся ван Клиф и его люди, вернитесь к Гриану Камнегриву.‡Eskortiert den Verräter der Defias zum Geheimversteck der Defiasbruderschaft. Sobald der Verräter der Defias Euch gezeigt hat, wo sich van Cleef und seine Männer aufhalten, kehrt Ihr mit der Information zu Gryan Stoutmantle zurück.‡데피아즈단의 비밀 은신처까지 데피아즈단 변절자를 호위해 가야 합니다. 데피아즈단의 변절자가 밴클리프와 그의 동료가 숨어 있는 곳까지 안내한 이후에 그라이언 스타우트맨틀에게 돌아가 그 위치를 알려야 합니다.‡Escolta al Traidor de los Defias a la ladronera secreta de la Hermandad Defias. Cuando el Traidor de los Defias te enseñe dónde se esconden VanCleef y sus hombres, regresa con Gryan Mantorrecio con toda la información.‡Escolta al Traidor de los Defias a la ladronera secreta de la Hermandad Defias. Cuando el Traidor de los Defias te enseñe dónde se esconden VanCleef y sus hombres, regresa con Gryan Mantorrecio con toda la información.‡Escortez le Traître défias jusqu\'à la cache secrète de la Confrérie défias. Lorsque vous saurez où se cachent VanCleef et ses hommes, rapportez l\'information à Gryan Stoutmantle.‡护送迪菲亚叛徒前往迪菲亚兄弟会的秘密藏身处。迪菲亚叛徒把你带到范克里夫和他的手下的巢穴之后，尽快回去向格里安·斯托曼汇报相关信息。‡護送迪菲亞叛徒前往迪菲亞兄弟會的秘密藏身處。迪菲亞叛徒把妳帶到範克裏夫和他的手下的巢穴之後，盡快回去向格裏安·斯托曼匯報相關信息。',
  }
},
[156] = {
  {
    'Coleta de flores do mal‡Сбор цветков гнили‡Das Sammeln von Faulblüten‡시든 꽃 모으기‡Busca flores podridas‡Busca flores podridas‡Cueillette de Racines pourries‡收集腐败之花‡收集腐敗之花',
    nil,
    'Colete 8 Flores do Mal e entregue-as ao Taberneiro Oseias em Vila Sombria.‡Соберите 8 цветков гнили и отнесите их хозяину таверны Смиттсу.‡Sammelt 8 Faulblüten und bringt sie nach Dunkelhain zu Schankwart Smitts.‡시든 꽃 8송이를 모아 다크샤이어의 선술집주인 스미츠에게 가져가야 합니다.‡Recoge 8 flores podridas y llévaselas al tabernero Smitts a Villa Oscura.‡Recoge 8 flores podridas y llévaselas al tabernero Smitts a Villa Oscura.‡Rapporter 8 Racines pourries à Smitts l\'aubergiste de Darkshire.‡收集8个腐败之花，交给夜色镇的旅店店主斯密茨。‡收集8個腐敗之花，交給夜色鎮的旅店店主斯密茨。',
  }
},
[157] = {
  {
    'Entregue a linha‡Доставка ниток‡Abliefern des Fadens‡머리 가닥 전달‡Devolver el pelo‡Devolver el pelo‡Apporter la mèche‡幽灵的发丝‡幽靈的發絲',
    nil,
    'Leve a Linha de Cabelo de Fantasma para Abercrombie na cabana dele, que fica ao norte do Cemitério de Monte Corvo.‡Принесите нить из призрачных волос в хижину на севере от кладбища Вороньего холма и отдайте ее Аберкромби.‡Bringt Calvinius den Geisterhaarfaden in seine Hütte nördlich des Friedhofs von Rabenflucht.‡까마귀 언덕 묘지 북쪽의 통나무집에 있는 에이버크롬비에게 유령의 머리 가닥을 가져가야 합니다.‡Lleva el hilo de pelo de fantasma a Abercrombie, a su choza al norte del Cementerio del Cerro del Cuervo.‡Lleva el hilo de cabello de fantasma a Abercrombie, a su choza al norte del Cementerio del Cerro del Cuervo.‡Apporter la Mèche de cheveux fantômes à Abercrombie, dans sa cabane, au nord du cimetière de Colline-aux-Corbeaux.‡把幽灵的发丝交给亚伯克隆比，他住在乌鸦岭墓地北边的房子里。‡把幽靈的發絲交給亞伯克隆比，他住在烏鴉嶺墓地北邊的房子裏。',
  }
},
[158] = {
  {
    'Suco de zumbi‡Сок зомби‡Zombiesaft‡좀비 독주‡Zumo de zombi‡Zumo de zombi‡Suc de zombie‡僵尸‡僵屍',
    nil,
    'Fale com o Taberneiro Oseias.‡Поговорите с хозяином таверны Смиттсом.‡Sprecht mit Schankwart Smitts.‡선술집주인 스미츠와 대화해야 합니다.‡Havla con el tabernero Smitts.‡Habla con el tabernero Smitts.‡S’adresser à Smitts l\'aubergiste.‡去和旅店店主斯密茨谈一谈。‡去和旅店店主斯密茨談壹談。',
  }
},
[159] = {
  {
    'Alguém pediu um suco?‡Доставка сока‡Saftlieferung‡좀비 독주 배달‡Entrega de zumo‡Entrega de zumo‡Livrer le Suc‡僵尸酒‡僵屍酒',
    nil,
    'Leve o Suco de Zumbi para o Abercrombie na cabana dele.‡Отнесите сок зомби в хижину Аберкромби.‡Bringt Calvinius den Zombiesaft in seine Hütte.‡통나무집에 있는 에이버크롬비에게 좀비 독주를 가져가야 합니다.‡Lleva el zumo de zombi a Abercrombie a su choza.‡Lleva el zumo de zombi a Abercrombie a su choza.‡Apporter le Suc de Zombie à Abercrombie, dans sa cabane.‡把僵尸酒交给乌鸦岭墓地北方小屋里的亚伯克隆比。‡把僵屍酒交給烏鴉嶺墓地北方小屋裏的亞伯克隆比。',
  }
},
[160] = {
  {
    'Carta ao prefeito‡Записка для мэра‡Ein Brief für den Bürgermeister‡시장에게 보내는 편지‡Nota para el alcalde‡Nota para el alcalde‡Une lettre pour le Maire‡给镇长的信‡給鎮長的信',
    nil,
    'Entregue a Carta para Malaquias Ebanez, Prefeito de Vila Sombria, a pedido de Abercrombie.‡Отнесите письмо Аберкромби Элло Чернодреву, мэру Темнолесья.‡Bringt Calvinius\' Brief zu Ello Ebonlocke, dem Bürgermeister von Dunkelhain.‡다크샤이어의 시장 엘로 이본로크 경에게 엘로에게 보내는 편지를 전해야 합니다.‡Lleva la carta de Abercrombie a Ello Cerranegro, el alcalde de Villa Oscura.‡Lleva la carta de Abercrombie a Ello Cerranegro, el alcalde de Villa Oscura.‡Apporter la Lettre d\'Abercrombie à Ello Ebonlocke, Maire de Darkshire.‡把亚伯克隆比的信交给夜色镇的艾尔罗·埃伯洛克镇长。‡把亞伯克隆比的信交給夜色鎮的艾爾羅·埃伯洛克鎮長。',
  }
},
[161] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'O Engenheiro-chefe Vedaçude quer que você leve o pó com cheiro estranho para Ashlan Risadura, o perito em explosivos, em Dun Modr.‡Отнесите странно пахнущий порошок в Дун Модр Ашлану Камнехмылу, специалисту по взрывчатым веществам.‡Chefingenieur Hinderweir möchte, dass Ihr das sonderbar riechende Pulver nach Dun Modr zu Ashlan Stonesmirk, dem Sprengstoffexperten, bringt.‡선임기술자 힌더바이르가 이상한 향기의 가루를 던 모드르에 있는 폭파 전문가 애실런 스톤스머크에게 전달해 달라고 부탁했습니다.‡El ingeniero jefe Hinderweir quiere que lleves las partículas con olor extraño a Ashlan Risapétrea, el experto en explosivos en Dun Modr.‡El ingeniero jefe Hinderweir quiere que lleves las partículas con olor extraño a Ashlan Risapétrea, el experto en explosivos en Dun Modr.‡L\'Ingénieur en chef Hinderweir veut que vous apportiez cette étrange poudre à Stonesmirk l\'Artificier à Dun Modr.‡主工程师辛德维尔七世要你把怪味粉末交给丹莫德的炸药专家阿什兰·暗石。‡主工程師辛德維爾七世要妳把怪味粉末交給丹莫德的炸藥專家阿什蘭·暗石。',
  }
},
[162] = {
  {
    'A ascensão dos silitídeos‡Возвышение силитидов‡Aufstieg der Silithid‡실리시드의 출현‡La sublevación de los silítidos‡La sublevación de los silítidos‡L\'ascension des silithides‡异种蝎的威胁‡異種蠍的威脅',
    nil,
    'Leve o Relatório de Análise de Insetos para Gracinha Forçânima em Darnassus.‡Отнесите отчет о наблюдении за насекомыми Грацине Силе Духа в Дарнасс.‡Bringt den Insektenanalysebericht nach Darnassus zu Gracina Spiritmight.‡다르나서스에 있는 그라시나 스피릿마이트에게 곤충 분석 보고서를 가져가야 합니다.‡Dirígete a Darnassus y entrégale el informe del análisis del insecto a Gracina Poderespíritu.‡Dirígete a Darnassus y entrégale el informe del análisis del insecto a Gracina Poderespíritu.‡Apporter le Rapport d\'analyse des insectes à Gracina Spiritmight à Darnassus.‡把报告带给达纳苏斯的格拉希娜·灵风。‡把報告帶給達納蘇斯的格拉希娜·靈風。',
  }
},
[163] = {
  {
    'Monte Corvo‡Вороний холм‡Rabenflucht‡까마귀 언덕‡Cerro del Cuervo‡Cerro del Cuervo‡Colline-aux-Corbeaux‡乌鸦岭‡烏鴉嶺',
    nil,
    'Descubra o que está assombrando o Monte Corvo.‡Выясните, кто поселился на Вороньем холме.‡Findet heraus, was in Rabenflucht umgeht.‡까마귀 언덕에 출몰하는 것이 무엇인지 확인해야 합니다.‡Averigua qué está acechando Cerro del Cuervo.‡Averigua qué está acechando Cerro del Cuervo.‡Découvrir ce qui hante Colline-aux-Corbeaux.‡查出是什么东西在乌鸦岭神出鬼没。‡查出是什麽東西在烏鴉嶺神出鬼沒。',
  }
},
[164] = {
  {
    'Entrega para Noel‡Припасы для Свена‡Lieferung an Sven‡스벤에게 보급품 전달‡Entrega a Sven‡Entrega a Sven‡Livraison à Sven‡斯温的货物‡斯溫的貨物',
    nil,
    'Entregue os suprimentos a Noel.‡Отнесите Свену припасы.‡Liefert die Vorräte an Sven.‡스벤에게 보급품을 가져가야 합니다.‡Entrega los suministros a Sven.‡Entrega los suministros a Sven.‡Ravitailler Sven.‡把补给物资带给斯温。‡把補給物資帶給斯溫。',
  }
},
[165] = {
  {
    'O eremita‡Отшельник‡Der Einsiedler‡은둔자‡El ermitaño‡El ermitaño‡L\'ermite‡隐士‡隱士',
    nil,
    'Confira se o velho que vive na choupana perto do cemitério do Monte Corvo está bem.‡Навестите старика в хижине рядом с кладбищем Вороньего холма.‡Schaut in der Nähe des Friedhofs von Rabenflucht nach dem alten Mann in der Hütte.‡까마귀 언덕 묘지 근처 통나무집에 있는 노인이 잘 있는지 확인해야 합니다.‡Ve a ver cómo está el anciano de la choza que hay cerca del Cementerio del Cerro del Cuervo.‡Ve a ver cómo está el anciano de la choza que hay cerca del Cementerio del Cerro del Cuervo.‡Aller voir le vieil homme dans sa cabane près du cimetière de Colline-aux-Corbeaux.‡去乌鸦岭墓地附近的小屋查看老人的情况。‡去烏鴉嶺墓地附近的小屋查看老人的情況。',
  }
},
[166] = {
  {
    'A Irmandade Défias‡Братство Справедливости‡Die Bruderschaft der Defias‡데피아즈단‡La hermandad de los Defias‡La hermandad de los Defias‡La Confrérie défias‡迪菲亚兄弟会‡迪菲亞兄弟會',
    nil,
    'Mate Edwin VanCleef e leve a cabeça dele para Miguel Mantoforte.‡Убейте Эдвина ван Клифа и принесите его голову Гриану Камнегриву.‡Tötet Edwin van Cleef und bringt seinen Kopf zu Gryan Stoutmantle.‡에드윈 밴클리프를 처치하고 그 증거로 그의 가면을 그라이언 스타우트맨틀에게 가져가야 합니다.‡Mata a Edwin VanCleef y lleva su cabeza a Gryan Mantorrecio.‡Mata a Edwin VanCleef y lleva su cabeza a Gryan Mantorrecio.‡Tuer Edwin VanCleef et apporter sa Tête à Gryan Stoutmantle.‡杀死艾德温·范克里夫，把他的头交给格里安·斯托曼。‡殺死艾德溫·範克裏夫，把他的頭交給格裏安·斯托曼。',
  }
},
[167] = {
  {
    'Meu irmão...‡О, брат мой...‡Oh Bruder...‡형제여...‡Oh hermano. . .‡Oh, hermano...‡Adieu mon frère…‡我的兄弟……‡我的兄弟……',
    nil,
    'Leve a Insígnia da Liga dos Exploradores do Encarregado Urtigão para Wilder Urtigão em Ventobravo.‡Принесите значок Лиги Исследователей, принадлежавший штейгеру Чертополоху в Штормград.‡Bringt Großknecht Thistlenettles Forscherliga-Abzeichen nach Stormwind zu Wilder Thistlenettle.‡스톰윈드에 있는 빌더 시슬네틀에게 시슬네틀의 배지를 가져가야 합니다.‡Lleva la insignia de la Liga de Exploradores del supervisor Cardortiga a Wilder Cardortiga, en Ventormenta.‡Lleva la insignia de la Liga de Expedicionarios del supervisor Cardortiga a Wilder Cardortiga, en Ventormenta.‡Apporter l\'Insigne de la Ligue des Explorateurs du contremaître Crispechardon à Wilder Crispechardon à Stormwind.‡将工头希斯耐特的探险者协会徽章交给暴风城的维尔德·蓟草。‡將工頭希斯耐特的探險者協會徽章交給暴風城的維爾德·薊草。',
  }
},
[168] = {
  {
    'Lembranças dos que se foram‡Сбор воспоминаний‡Die Suche nach Andenken‡기억을 더듬어...‡La recolección de Tarjetas del Sindicato Minero‡Recolección de recuerdos‡À la recherche de Cartes du Syndicat des Mineurs‡收集记忆‡收集記憶',
    nil,
    'Recupere 4 Carteiras do Sindicato dos Mineradores e leve-as para Wilder Urtigão em Ventobravo.‡Добудьте 4 карточки Союза шахтеров и верните их Дикому Чертополохху в Штормград.‡Beschafft 4 Gewerkschaftsausweise und bringt sie nach Stormwind zu Wilder Thistlenettle.‡스톰윈드에 있는 빌더 시슬네틀에게 광부 조합의 명함 4장을 가져가야 합니다.‡Recupera 4 Tarjetas del Sindicato Minero y llévaselas a Wilder Cardortiga, en Ventormenta.‡Recupera 4 Tarjetas del Sindicato Minero y llévaselas a Wilder Cardortiga, en Ventormenta.‡Récupérer 4 Cartes du Syndicat des mineurs et les apporter à Wilder Crispechardon à Stormwind.‡给暴风城的维尔德·蓟草带回4张矿业工会会员卡。‡給暴風城的維爾德·薊草帶回4張礦業工會會員卡。',
  }
},
[169] = {
  {
    'Procura-se: Gath\'Ilzogg‡Розыск: Гат\'Илзогг‡GESUCHT: Gath\'Ilzogg‡가스일조그 현상수배‡Se busca: Gath\'Ilzogg‡Se busca: Gath\'Ilzogg‡On recherche : Gath\'Ilzogg‡通缉：加塞尔佐格‡通緝：加塞爾佐格',
    nil,
    'Mate Gath\'Ilzogg e leve a cabeça dele para o Magistrado Salomão na Vila Plácida para receber a recompensa.‡Убейте Гат\'Илзогга и принесите его голову мировому судье Соломону в Приозерье.‡Erledigt Gath\'llzogg und bringt seinen Kopf zu Magistrat Solomon in Seenhain, um die Belohnung zu erhalten.‡가스일조그를 처치하고 그 증거로 그의 머리카락을 레이크샤이어에 있는 집정관 솔로몬에게 가져가십시오. 보상을 받을 수 있을 것입니다.‡Mata a Gath\'Ilzogg y lleva su cabeza al magistrado Solomon a Villa del Lago para recibir tu recompensa.‡Mata a Gath\'Ilzogg y lleva su cabeza al magistrado Solomon a Villa del Lago para recibir tu recompensa.‡Tuer Gath\'Ilzogg et apporter sa Tête au magistrat Solomon de Lakeshire pour toucher la récompense.‡杀死加塞尔佐格并把他的头颅割下，向湖畔镇的所罗门镇长复命。‡殺死加塞爾佐格並把他的頭顱割下，向湖畔鎮的所羅門鎮長復命。',
  }
},
[170] = {
  {
    'Uma nova ameaça‡Новая угроза‡Eine neue Bedrohung‡새로운 위협‡Una nueva amenaza‡Una nueva amenaza‡Une nouvelle menace‡新的威胁‡新的威脅',
    nil,
    'Balir Gelomarra quer que você mate 6 Troggs Pedraqueixo e 6 Troggs Pedraqueixo Parrudos.‡Убейте 6 троггов из племени Каменной Челюсти и 6 сильных троггов из племени Каменной Челюсти.‡Balir Frosthammer möchte, dass Ihr 6 Troggs der Felsenkiefer und 6 bullige Troggs der Felsenkiefer tötet.‡발리르 프로스트해머가 바위턱트로그 6마리와 힘센 바위턱트로그 6마리를 처치해 달라고 부탁했습니다.‡Balir Martilloescarcha quiere que mates a 6 troggs Comepiedras y a 6 troggs Comepiedras fornidos.‡Balir Martilloescarcha quiere que mates a 6 troggs Comepiedras y a 6 troggs Comepiedras fornidos.‡Balir Frosthammer veut que vous tuiez 6 Troggs Mâcheroc et 6 Troggs Mâcheroc forcenés.‡巴尔林·霜锤让你去杀死6个石腭穴居人和6个壮实的石腭怪。‡巴爾林·霜錘讓妳去殺死6個石腭穴居人和6個壯實的石腭怪。',
  }
},
[171] = {
  {
    'Um protegido da Aliança‡Опекун Альянса‡Tageseltern der Allianz‡얼라이언스 보육원‡Alcaide de la Alianza‡Alcaide de la Alianza‡Un surveillant de l\'Alliance‡联盟孤儿的看护者‡聯盟孤兒的看護者',
    nil,
    'Compre um Cavalete para Espada de Espuma de Crango Tiratampa e leve seu protegido de volta ao orfanato de Ventobravo. Basta falar com a Matriarca Ananéri no Distrito da Catedral.‡Проводите своего подопечного в приют Штормграда, вернув свисток ребенка-сироты попечительнице сирот Найтингейл в Храмовый квартал.‡Bringt Euren Schützling in das Waisenhaus von Stormwind zurück, indem Ihr die Pfeife des menschlichen Waisenkindes an Waisenmatrone Nightingale im Kathedralenviertel übergebt.‡대성당 광장에 있는 보육원 원장님 나이팅게일에게 인간 고아 호루라기를 건네주면서 아이를 스톰윈드 보육원에 다시 데려가야 합니다.‡Compra un expositor para espadas de gomaespuma a Chichón Perinola y después habla con la supervisora de huérfanos Ruiseñor en el Distrito de la Catedral para llevar a tu pupilo de vuelta al orfanato de Ventormenta.‡Compra un expositor para espadas de gomaespuma a Chichón Perinola y después habla con la supervisora de huérfanos Ruiseñor en el Distrito de la Catedral para llevar a tu pupilo de vuelta al orfanato de Ventormenta.‡Achetez un Râtelier d’épées en mousse à Foltiff Tremblhoupette. Puis ramenez votre protégé à l’orphelinat de Hurlevent, en parlant à la directrice de l’orphelinat, Rossignol, dans le Quartier de la Cathédrale.‡回到暴风城的教堂区，把人类孤儿哨交还给孤儿院的孤儿监护员奈丁加尔。‡從克拉格·搖塞那裏購買泡沫塑料劍架，然後將妳的孤兒送回暴風城孤兒院，同教堂區的孤兒監護員奈丁加爾交談，送妳的孤兒回家。',
  }
},
[172] = {
  {
    'A Semana das Crianças‡Детская неделя‡Die Kinderwoche‡어린이 주간‡Semana de los Niños‡Semana de los Niños‡La Semaine des enfants‡儿童周‡兒童周',
    nil,
    'Use o Apito de Órfão Orc para conversar com a criança de quem você vai cuidar durante a Semana da Criança.‡Используйте свисток орка-сироты. Присматривайте за сиротой в течение всей Детской недели.‡Benutzt die Pfeife des orcischen Waisenkindes um während der Kinderwoche mit Eurem Schützling zu sprechen.‡오크 고아 호루라기를 사용해 어린이 주간에 돌볼 아이와 대화하십시오.‡Usa el silbato de huérfano orco para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Usa el silbato de huérfano orco para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Utiliser le sifflet d\'orphelin orc pour parler à l\'enfant que vous protégez durant la Semaine des enfants.‡使用兽人孤儿哨与你即将在儿童周期间照顾的孩子进行对话。‡使用獸人孤兒哨與妳即將在兒童周期間照顧的孩子進行對話。',
  }
},
[173] = {
  {
    'Worgens na floresta‡Воргены в лесу‡Worgs in den Wäldern‡숲 속의 늑대인간‡Ferocanis en el bosque‡Huargen en el bosque‡Worgens dans les bois‡森林里的狼人‡森林裏的狼人',
    nil,
    'Mate 6 worgens Tece-sombras Nocturnos para Petrônio na Vila Sombria.‡Калор из Темнолесья просит вас убить 6 тенеткачей Ночной Погибели.‡Tötet für Calor aus Dunkelhain 6 Schattenwirker der Nachtheuler.‡다크샤이어의 칼로를 위해 파멸의어둠일족 흑마술사 6마리를 처치해야 합니다.‡Mata a 6 ferocanis Tejesombras nocturno para Calor de Villa Oscura.‡Mata a 6 huargen Tejesombras Penumbría para Calor de Villa Oscura.‡Tuer 6 worgens Tisseurs d\'ombre Plaie-de-nuit pour Calor de Darkshire.‡为夜色镇的卡洛尔杀掉6个夜行织影狼人。‡為夜色鎮的卡洛爾殺掉6個夜行織影狼人。',
  }
},
[174] = {
  {
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Vitório Prismado, da Vila Sombria, quer que você lhe providencie um tubo de bronze.‡Принесите Виктору Призм\'Антрасу бронзовую трубку.‡Viktori Prism\'Antras aus Dunkelhain möchte, dass Ihr ihm eine Bronzeröhre bringt.‡다크샤이어의 빅토리 프리즘안트라스가 청동관을 가져다 달라고 부탁했습니다.‡Viktori Prism\'Antras de Villa Oscura quiere que le lleves un tubo de bronce.‡Viktori Prism\'Antras de Villa Oscura quiere que le lleves un tubo de bronce.‡Viktori Prism\'Antras de Darkshire veut que vous lui apportiez un Tube en bronze.‡夜色镇的维克托·安特拉斯要你给他找一根青铜管。‡夜色鎮的維克托·安特拉斯要妳給他找壹根青銅管。',
  }
},
[175] = {
  {
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Encontre Maria e convença-a a fornecer uma superfície refletora para o projeto de Vitório.‡Найдите Мэри и уговорите ее пожертвовать зеркало для проекта Виктора.‡Findet Mary und überredet sie, einen Gegenstand mit reflektierender Oberfläche zu Viktoris Projekt beizusteuern.‡매리를 찾아 빅토리의 작업에 사용할 반사면을 빌려 와야 합니다.‡Localiza a Mary y convéncela de que te dé una superficie reflectora para el proyecto de Viktori.‡Localiza a Mary y convéncela de que te dé una superficie reflectora para el proyecto de Viktori.‡Trouver Marie et la persuader de prêter une surface réfléchissante pour le projet de Viktori.‡找到玛丽，说服她借给你一个反光镜，用于维克托的计划。‡找到瑪麗，說服她借給妳壹個反光鏡，用於維克托的計劃。',
  }
},
[176] = {
  {
    'Procura-se: "Hogger"‡Разыскивается: "Дробитель"‡GESUCHT: "Hogger"‡들창코 현상수배‡Se busca: Hogger‡Se busca: Hogger‡On recherche : "Lardeur"‡通缉：霍格‡通緝：霍格',
    nil,
    'Mate o gnoll Hogger e leve sua Enorme Garra de Gnoll para o Delegado Durão.‡Убейте Дробителя и принесите маршалу Дугхану большой коготь гнолла.‡Erschlagt den Gnoll Hogger und bringt seine gewaltige Gnoll-Klaue zu Marshal Dughan.‡들창코라는 놀을 처치하고 치안대장 더그한에게 그 놀의 큰 발톱을 가져가야 합니다.‡Mata al gnoll Hogger y trae su enorme garra gnoll al alguacil Dughan.‡Mata al gnoll Hogger y llévale su garra de gnoll enorme al alguacil Dughan.‡Liquider le gnoll Lardeur et apporter sa Grande griffe au maréchal Dughan.‡杀死豺狼人霍格，把他那巨大的豺狼人爪带给治安官杜汉。‡殺死豺狼人霍格，把他那巨大的豺狼人爪帶給治安官杜漢。',
  }
},
[177] = {
  {
    'Ora (direis) ouvir estrelas!‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Recupere o Espelho de Maria do Carniçal Insano e entregue-o a Vitório na Vila Sombria.‡Заберите зеркало Слепой Мэри у Невменяемого Вурдалака и отдайте его Виктору в Темнолесье.‡Nehmt dem irrsinnigen Ghul den Handspiegel der blinden Mary ab und gebt ihn Viktori in Dunkelhain.‡광기어린 구울에게서 매리의 거울을 찾아 다크샤이어에 빅토리 프리즘안트라스에게 가져가야 합니다.‡Quita el espejo de Mary la Ciega al necrófago demente y llévaselo a Viktori a Villa Oscura.‡Quita el espejo de Mary la Ciega al necrófago demente y llévaselo a Viktori a Villa Oscura.‡Prendre le miroir de Marie l\'Aveugle à la Goule folle et l’apporter à Viktori de Darkshire.‡从疯狂的食尸鬼那里拿回盲眼玛丽的眼镜，把它交给夜色镇的维克托。‡從瘋狂的食屍鬼那裏拿回盲眼瑪麗的眼鏡，把它交給夜色鎮的維克托。',
  }
},
[178] = {
  {
    'A resposta de Teócrito‡Поручение Теокрита‡Wiederbeschaffung für Theocritus‡테오크리투스의 역공‡Theocritus recupera el colgante‡Theocritus recupera el colgante‡Theocritus récupère son Pendentif‡塞欧克瑞图斯的坠饰‡塞歐克瑞圖斯的墜飾',
    nil,
    'Leve o Pingente Umbrapele Esmaecido para Teócrito, o Mago.‡Принесите выцветшую подвеску Темношкуров верховному магу Теокриту.‡Bringt den verblassten Schattenfellanhänger zu Theocritus, dem Magier.‡마법사 테오크리투스에게 잿빛가죽 놀의 빛바랜 펜던트를 가져가야 합니다.‡Lleva el colgante Pielsombra descolorido a Theocritus el mago.‡Lleva el colgante Pielsombra descolorido a Theocritus el mago.‡Apporter l\'Ancien pendentif sombrepoil à Theocritus le Mage.‡将不再发光的暗皮坠饰带给法师塞欧克瑞图斯。‡將不再發光的暗皮墜飾帶給法師塞歐克瑞圖斯。',
  }
},
[179] = {
  {
    'Provedores enânicos‡Дворфские экипировщики‡Zwergenausstatter‡드워프 장갑‡Los enanos modistos‡Los enanos modistos‡Tailleur chez les nains‡矮人的交易‡矮人的交易',
    nil,
    'Sten Braçoforte quer 8 pedaços de Carne Dura de Lobo.‡Принесите Стену Крепкоруку 8 кусков жесткого волчьего мяса.‡Sten Stoutarm hätte gern 8 Stücke zähes Wolfsfleisch.‡스텐 스타우트암이 질긴 늑대 고기 8조각을 구해 달라고 부탁했습니다.‡Sten Brazorrecio quiere 8 piezas de carne dura de lobo.‡Sten Brazorrecio quiere 8 piezas de carne de lobo dura.‡Sten Stoutarm voudrait 8 Morceaux de Viande de loup coriace.‡斯登·粗臂想要8块硬狼肉。‡斯登·粗臂想要8塊硬狼肉。',
  }
},
[180] = {
  {
    'Procura-se: Tenente Mordente‡Разыскивается: лейтенант Фангор‡GESUCHT: Lieutenant Fangor‡부대장 붉은송곳니 현상수배‡Se busca: teniente Fangore‡Se busca: Teniente Fangore‡On recherche : lieutenant Fangore‡通缉：范高雷中尉‡通緝：範高雷中尉',
    nil,
    'Mate o Tenente Mordente e leve a pata dele para o Magistrado Salomão em Vila Plácida.‡Убейте лейтенанта Фангора и принесите его лапу мировому судье Соломону в Приозерье.‡Tötet Lieutenant Fangor und kehrt mit seiner Tatze zu Magistrat Solomon nach Seenhain zurück.‡부대장 붉은송곳니를 처치한 후 그의 앞발을 가지고 레이크샤이어의 집정관 솔로몬에게 돌아가야 합니다.‡Mata al teniente Fangore y lleva su zarpa al magistrado Solomon a Villa del Lago.‡Mata al teniente Fangore y lleva su zarpa al magistrado Solomon a Villa del Lago.‡Tuer le lieutenant Fangore et rapporter sa patte au magistrat Solomon de Lakeshire.‡杀死范高雷并将他的手掌割下，向湖畔镇的所罗门镇长复命。‡殺死範高雷並將他的手掌割下，向湖畔鎮的所羅門鎮長復命。',
  }
},
[181] = {
  {
    'Ora (direis) ouvir estrelas‡Взгляни на звезды‡Der Blick zu den Sternen‡별 관측‡Mira las estrellas‡Mira las estrellas‡Les yeux dans les étoiles‡仰望星空‡仰望星空',
    nil,
    'Encontre Zzarc\'Vul no morro ôgrico ao sul da Floresta do Crepúsculo, pegue com ele o monóculo e leve para Vitório na Vila Sombria.‡Отыщите Ззарк\'Вула в кургане на юге Сумеречного леса и принесите его монокль Виктору в Темнолесье.‡Findet Zzarc\'Vul im südlichen Ogerhort des Dämmerwalds und bringt sein Monokel zu Viktori nach Dunkelhain.‡그늘숲 남쪽의 오우거 언덕에서 짜르크불을 찾아 오우거의 외눈안경을 다크샤이어에 있는 빅토리에게 가져와야 합니다.‡Localiza a Zzarc\'Vul en el montículo meridional del Bosque del Ocaso y llévale su monóculo a Viktori a Villa Oscura.‡Localiza a Zzarc\'Vul en el montículo meridional del Bosque del Ocaso y llévale su monóculo a Viktori a Villa Oscura.‡Localiser Zzarc\'Vul dans le tertre des ogres au sud du bois de la Pénombre et rapporter son Monocle à Viktori de Darkshire.‡在暮色森林南部的食人魔土丘上找到扎克乌尔，把他的单片眼镜带回夜色镇交给维克托。‡在暮色森林南部的食人魔土丘上找到紮克烏爾，把他的單片眼鏡帶回夜色鎮交給維克托。',
  }
},
[182] = {
  {
    'A caverna dos trolls‡Пещера троллей‡Die Trollhöhle‡트롤 동굴‡La cueva de los trols‡La cueva de los trols‡La caverne des trolls‡巨魔洞穴‡巨魔洞穴',
    nil,
    'Grolin Barbabranca quer que você mate 14 Jovens Trolls Jubafria.‡Убейте 14 троллей-подростков из племени Мерзлогривов.‡Grelin Whitebeard möchte, dass Ihr 14 Trollwelpen der Frostmane tötet.‡그렐린 화이트비어드가 어린 서리갈기트롤 14마리를 처치해 달라고 부탁했습니다.‡Grelin Barbablanca quiere que mates a 14 crías de trol Peloescarcha.‡Grelin Barbablanca quiere que mates 14 crías de trol Peloescarcha.‡Grelin Whitebeard aimerait que vous tuiez 14 Jeunes trolls Frostmane.‡格瑞林·白须要你去杀掉14个霜鬃巨魔幼崽。‡格瑞林·白須要妳去殺掉14個霜鬃巨魔幼崽。',
  }
},
[183] = {
  {
    'Caçando javali‡Охотник на вепрей‡Der Eberjäger‡멧돼지 사냥‡Cazador de jabalíes‡Cazador de jabalíes‡Chasseur de sangliers‡猎杀野猪‡獵殺野豬',
    nil,
    'Talin Olhobom quer que você mate 12 Rochetuscos Pequenos.‡Убейте 12 малых скальных вепрей по просьбе Талина Остроглаза.‡Talin Keeneye möchte, dass Ihr 12 kleine Klippeneber tötet.‡탈린 킨아이가 작은 멧돼지 12마리를 처치해 달라고 부탁했습니다.‡Talin Ojoagudo quiere que mates a 12 jabalíes del risco pequeños.‡Talin Ojo Ávido quiere que mates a 12 jabalíes del risco pequeños.‡Talin Keeneye aimerait que vous tuiez 12 Petits sangliers des rochers.‡塔林·锐眼让你去杀掉12只小型峭壁野猪。‡塔林·銳眼讓妳去殺掉12只小型峭壁野豬。',
  }
},
[184] = {
  {
    'Escritura do Taturana‡Документ Хмуроброва‡Furlbrows Urkunde‡펄브로우의 땅문서‡La escritura de Furlbrow‡Las escrituras de Cejade‡Titre de propriété de Furlbrow‡法布隆的地契‡法布隆的地契',
    nil,
    'Leve a Escritura do Taturana para o Fazendeiro Taturana.‡Доставьте фермеру Хмуроброву документ на ферму.‡Bringt Furlbrows Besitzurkunde zu Bauer Furlbrow.‡농부 펄브로우에게 펄브로우의 땅문서를 가져가야 합니다.‡Lleva al granjero Furlbrow su escritura.‡Lleva las escrituras de Cejade al granjero Cejade.‡Rapporter son titre de propriété au Fermier Furlbrow.‡把法布隆的地契交给农夫法布隆。‡把法布隆的地契交給農夫法布隆。',
  }
},
[185] = {
  {
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Domina el tigre‡Domina el tigre‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate 10 Tigres-do-espinhaço Jovens.‡Ажек Руак из экспедиции Эрнестуэя попросила вас убить 10 молодых тигров Тернистой долины.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr 10 junge Schlingendorntiger tötet.‡네싱워리 원정대의 아제크 루아크가 새끼 가시덤불 호랑이 10마리를 처치해 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres jóvenes de Tuercespina.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres jóvenes de Tuercespina.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous chassiez 10 Jeunes tigres de Strangleronce.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死10只荆棘谷猛虎幼崽。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死10只荊棘谷猛虎幼崽。',
  }
},
[186] = {
  {
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Maestría en tigres‡Maestría en tigres‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate 10 Tigres-do-Espinhaço.‡Ажек Руак из экспедиции Эрнестуэя попросила вас убить 10 тигров Тернистой долины.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr 10 Schlingendorntiger tötet.‡네싱워리 원정대의 아제크 루아크가 가시덤불 호랑이 10마리를 처치해 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres de Tuercespina.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres de Tuercespina.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous chassiez 10 Tigres de Strangleronce.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死10只荆棘谷猛虎。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死10只荊棘谷猛虎。',
  }
},
[187] = {
  {
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Domina el tigre‡Domina el tigre‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate 10 Tigres-do-espinhaço Anciãos.‡Ажек Руак из экспедиции Эрнестуэя попросила вас убить 10 старых тигров Тернистой долины.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr 10 alte Schlingendorntiger tötet.‡네싱워리 원정대의 아제크 루아크가 덩치큰 가시덤불 호랑이 10마리를 처치해 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary, quiere que mates 10 tigres de Tuercespina mayores.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates 10 tigres de Tuercespina mayores.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous chassiez 10 Anciens tigres de Strangleronce.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死10只老年荆棘谷猛虎。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死10只老年荊棘谷猛虎。',
  }
},
[188] = {
  {
    'Maestria em tigres‡Схватка с тигром‡Beherrschen der Tigerjagd‡호랑이 사냥법 익히기‡Domina el tigre‡Domina el tigre‡Maîtrise de la chasse au tigre‡猎虎‡獵虎',
    nil,
    'Merília Ceireles da Expedição do Rosarães quer que você mate Sin\'Dall e lhe traga a pata dela.‡Ажек Руак из экспедиции Эрнестуэя просит вас убить Син\'Далл и принеси ее лапу.‡Ajeck Rouack von Nesingwarys Expedition möchte, dass Ihr Sin\'Dall tötet und mit ihrer Tatze zurückkehrt.‡네싱워리 원정대의 아제크 루아크가 신달을 처치하고 그 앞발을 가져다 달라고 부탁했습니다.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates a Sin\'Dall y vuelvas con su zarpa.‡Ajeck Rouack de la Expedición de Nesingwary quiere que mates a Sin\'Dall y le lleves su pata.‡Ajeck Rouack de l\'Expédition Nesingwary veut que vous tuiez Sin’Dall et que vous rapportiez sa Patte.‡奈辛瓦里远征队的艾耶克·罗欧克要求你杀死辛达尔并带回它的爪子。‡奈辛瓦裏遠征隊的艾耶克·羅歐克要求妳殺死辛達爾並帶回它的爪子。',
  }
},
[189] = {
  {
    'Orelhas de Sanguescalpo‡Уши троллей Кровавого Скальпа‡Ohren der Bloodscalp‡붉은머리부족의 귀‡Orejas de Sangrapellejo‡Orejas de Sangrapellejo‡Oreilles de Bloodscalp‡血顶巨魔的耳朵‡血頂巨魔的耳朵',
    nil,
    'Consiga 15 Orelhas de Sanguescalpo e entregue-as a Kebok na Angra do Butim.‡Добудьте 15 ушей троллей из племени Кровавого Скальпа и принесите их Кебоку в Пиратскую бухту.‡Verschafft Euch 15 Ohren der Bloodscalp und bringt sie Kebok in Booty Bay.‡붉은머리부족의 귀 15개를 모아 무법항에 있는 케복에게 가져가야 합니다.‡Consigue 15 orejas Sangrapellejo y llévaselas a Kebok en la Bahía del Botín.‡Consigue 15 orejas Sangrapellejo y llévaselas a Kebok en la Bahía del Botín.‡Obtenir 15 Oreilles de trolls Bloodscalp et les apporter à Kebok, à Baie-du-Butin.‡给藏宝海湾的科博克带回15只血顶巨魔的耳朵。‡給藏寶海灣的科博克帶回15只血頂巨魔的耳朵。',
  }
},
[190] = {
  {
    'Maestria em panteras‡Схватка с пантерой‡Beherrschen der Pantherjagd‡퓨마 사냥법 익히기‡Domina la pantera‡Domina la pantera‡Maîtrise de la chasse à la panthère‡猎豹‡獵豹',
    nil,
    'Raciliano Gramos da Expedição do Rosarães quer que você mate 10 Panteras Jovens.‡Сэр С. Дж. Эрлгедин из экспедиции Эрнестуэя попросил вас убить 10 молодых пантер.‡Sire S. J. Erlgadin von Nesingwarys Expedition möchte, dass Ihr 10 junge Panther tötet.‡네싱워리 원정대의 얼가딘 경이 새끼 퓨마 10마리를 처치해 달라고 부탁했습니다.‡Sir S. J. Erlgadin de la Expedición de Nesingwary quiere que mates 10 panteras jóvenes.‡Sir S. J. Erlgadin de la Expedición de Nesingwary quiere que mates 10 panteras jóvenes.‡Le sire S. J. Erlgadin de l\'Expédition Nesingwary veut que vous tuiez 10 Jeunes panthères.‡奈辛瓦里远征队的埃尔加丁爵士要求你杀死10只猎豹幼崽。‡奈辛瓦裏遠征隊的埃爾加丁爵士要求妳殺死10只獵豹幼崽。',
  }
},
[191] = {
  {
    'Maestria em panteras‡Схватка с пантерой‡Beherrschen der Pantherjagd‡퓨마 사냥법 익히기‡Domina la pantera‡Domina la pantera‡Maîtrise de la chasse à la panthère‡猎豹‡獵豹',
    nil,
    'Raciliano Gramos, da Expedição do Rosarães, quer que você mate 10 Panteras.‡Сэр С. Дж. Эрлгедин из экспедиции Эрнестуэя попросил вас убить 10 пантер.‡Sire S. J. Erlgadin von Nesingwarys Expedition möchte, dass Ihr 10 Panther tötet.‡네싱워리 원정대의 얼가딘 경이 퓨마 10마리를 처치해 달라고 부탁했습니다.‡Sir S. J. Erlgadin de la Expedición de Nesingwary, quiere que mates 10 panteras.‡Sir S. J. Erlgadin de la Expedición de Nesingwary quiere que mates 10 panteras.‡Le sire S. J. Erlgadin de l\'Expédition Nesingwary veut que vous tuiez 10 Panthères.‡奈辛瓦里远征队的埃尔加丁爵士要求你杀死10只黑豹。‡奈辛瓦裏遠征隊的埃爾加丁爵士要求妳殺死10只黑豹。',
  }
},
[192] = {
  {
    'Maestria em panteras‡Схватка с пантерой‡Beherrschen der Pantherjagd‡퓨마 사냥법 익히기‡Domina la pantera‡Maestría en panteras‡Maîtrise de la chasse à la panthère‡猎豹‡獵豹',
    nil,
    'Raciliano Gramos, da Expedição do Rosarães, quer que você mate 10 Panteras Umbragorja.‡Сэр С. Дж. Эрлгедин из экспедиции Эрнестуэя попросил вас убить 10 тенебрюхих пантер.‡Sire S. J. Erlgadin von Nesingwarys Expedition möchte, dass Ihr 10 Schattentatzenpanther tötet.‡네싱워리 원정대의 얼가딘 경이 그림자퓨마 10마리를 처치해 달라고 부탁했습니다.‡Sir S. J. Erlgadin de la Expedición de Nesingwary, quiere que mates 10 panteras Faucesombrías.‡Sir S. J. Erlgadin de la Expedición de Nesingwary quiere que mates 10 panteras faucesombría.‡Le sire S. J. Erlgadin de l\'Expédition Nesingwary veut que vous tuiez 10 panthères Ombregueule.‡奈辛瓦里远征队的埃尔加丁爵士要求你杀死10只深喉猎豹。‡奈辛瓦裏遠征隊的埃爾加丁爵士要求妳殺死10只深喉獵豹。',
  }
},
[193] = {
  {
    'Maestria em panteras‡Схватка с пантерой‡Beherrschen der Pantherjagd‡퓨마 사냥법 익히기‡Domina la pantera‡Domina la pantera‡Maîtrise de la chasse à la panthère‡猎豹‡獵豹',
    nil,
    'Raciliano Gramos, da Expedição do Rosarães, quer que você traga para ele a Presa de Bhag\'thera.‡Сэр С. Дж. Эрлгедин из экспедиции Эрнестуэя попросил принести ему клык Баг\'тиры.‡Sire S. J. Erlgadin von Nesingwarys Expedition möchte, dass Ihr ihm den Fangzahn von Bhag\'thera bringt.‡네싱워리 원정대의 얼가딘 경이 바그테라의 송곳니를 가져다 달라고 부탁했습니다.‡Sir S. J. Erlgadin de la Expedición de Nesingwary, quiere que le lleves el colmillo de Bhag\'thera.‡Sir S. J. Erlgadin de la Expedición de Nesingwary quiere que le lleves el colmillo de Bhag\'thera.‡Le sire S. J. Erlgadin de l\'Expédition Nesingwary veut que vous lui rapportiez un Croc de Bhag\'thera.‡奈辛瓦里远征队的埃尔加丁爵士要求你杀死巴尔瑟拉，并带回它的牙。‡奈辛瓦裏遠征隊的埃爾加丁爵士要求妳殺死巴爾瑟拉，並帶回它的牙。',
  }
},
[194] = {
  {
    'Maestria em raptores‡Схватка с ящером‡Beherrschen der Raptorenjagd‡랩터 사냥법 익히기‡Domina el raptor‡Domina el raptor‡Contrôler la population des raptors‡猎龙‡獵龍',
    nil,
    'Rosarães Guima quer que você mate 10 Raptores-do-Espinhaço.‡Хеминг Эрнестуэй просит вас убить 10 ящеров Тернистой долины.‡Hemet Nesingwary möchte, dass Ihr 10 Schlingendornraptoren tötet.‡헤멧 네싱워리가 가시덤불랩터 10마리를 처치해 달라고 부탁했습니다.‡Hemet Decautela quiere que mates 10 raptores de Tuercespina.‡Hemet Nesingwary quiere que mates 10 raptores de Tuercespina.‡Hemet Nesingwary veut que vous tuiez 10 Raptors de Strangleronce.‡赫米特·奈辛瓦里要求你杀死10只荆棘谷迅猛龙。‡赫米特·奈辛瓦裏要求妳殺死10只荊棘谷迅猛龍。',
  }
},
[195] = {
  {
    'Maestria em raptores‡Схватка с ящером‡Beherrschen der Raptorenjagd‡랩터 사냥법 익히기‡Domina el raptor‡Domina el raptor‡Contrôler la population des raptors‡猎龙‡獵龍',
    nil,
    'Rosarães Guima quer que você mate 10 Raptores Batecauda.‡Хеминг Эрнестуэй просит вас убить 10 ящеров-кнутохвостов.‡Hemet Nesingwary möchte, dass Ihr 10 Schmetterschwanzraptoren tötet.‡헤멧 네싱워리가 채찍꼬리랩터 10마리를 처치해 달라고 부탁했습니다.‡Hemet Decautela quiere que mates 10 raptores colazote.‡Hemet Nesingwary quiere que mates 10 raptores colazote.‡Hemet Nesingwary veut que vous tuiez 10 Raptors flagellants.‡赫米特·奈辛瓦里要求你杀死10只鞭尾迅猛龙。‡赫米特·奈辛瓦裏要求妳殺死10只鞭尾迅猛龍。',
  }
},
[196] = {
  {
    'Maestria em raptores‡Схватка с ящером‡Beherrschen der Raptorenjagd‡랩터 사냥법 익히기‡Domina el raptor‡Domina el raptor‡Contrôler la population des raptors‡猎龙‡獵龍',
    nil,
    'Rosarães Guima quer que você mate 10 Espreitadores da Selva.‡Хеминг Эрнестуэй попросил вас убить 10 тропических ловцов.‡Hemet Nesingwary möchte, dass Ihr 10 Dschungelpirscher tötet.‡헤멧 네싱워리가 줄무늬정글랩터 10마리를 처치해 달라고 부탁했습니다.‡Hemet Decautela quiere que mates 10 acechadores de la selva.‡Hemet Nesingwary quiere que mates 10 acechadores de la selva.‡Hemet Nesingwary veut que vous tuiez 10 Traqueurs de la jungle.‡赫米特·奈辛瓦里要求你杀死10只丛林捕猎者。‡赫米特·奈辛瓦裏要求妳殺死10只叢林捕獵者。',
  }
},
[197] = {
  {
    'Maestria em raptores‡Схватка с ящером‡Beherrschen der Raptorenjagd‡랩터 사냥법 익히기‡Domina el raptor‡Domina el raptor‡Contrôler la population des raptors‡猎龙‡獵龍',
    nil,
    'Rosarães Guima quer que você mate Tethis, um raptor perigoso e esquivo, na Selva do Espinhaço.‡Хеминг Эрнестуэй попросил вас убить Тетиса, хитрого, опасного ящера Тернистой долины.‡Hemet Nesingwary möchte, dass Ihr Tethis tötet, einen schwer fassbaren, gefährlichen Raptoren des Schlingendorntals.‡헤멧 네싱워리가 가시덤불 골짜기에 있는 잡기 힘들고 위험한 랩터인 테디스를 처치해 달라고 부탁했습니다.‡Hemet Decautela quiere que mates a Tethis, un esquivo y peligroso raptor de Tuercespina.‡Hemet Nesingwary quiere que mates a Tethis, un raptor peligroso y elusivo de Tuercespina.‡Hemet Nesingwary veut que vous tuiez Téthis, un raptor farouche et dangereux de Strangleronce.‡赫米特·奈辛瓦里要求你杀死荆棘谷中最危险最狡猾的迅猛龙泰希斯。‡赫米特·奈辛瓦裏要求妳殺死荊棘谷中最危險最狡猾的迅猛龍泰希斯。',
  }
},
[198] = {
  {
    'Suprimentos para o Recruta Turgo‡Припасы для рядового Торсена‡Vorräte für den Gefreiten Thorsen‡병사 토르센을 위한 보급품‡Suministros para el soldado Thorsen‡Suministros para el soldado Thorsen‡Les marchandises du soldat Thorsen‡列兵索尔森的补给物资‡列兵索爾森的補給物資',
    nil,
    'Entregue os Suprimentos Goblin Sortidos ao Recruta Turgo.‡Доставьте различные припасы гоблинов рядовому Торсену.‡Liefert die verschiedenen Goblin-Vorräte bei dem Gefreiten Thorsen ab.‡병사 토르센에게 고블린의 잡다한 보급품을 전달해야 합니다.‡Entrega los suministros goblin variados al soldado Thorsen.‡Entrega los suministros goblin variados al soldado Thorsen.‡Remettre les marchandises des gobelins au soldat Thorsen.‡将杂七杂八的地精补给物资带给列兵索尔森。‡將雜七雜八的地精補給物資帶給列兵索爾森。',
  }
},
[199] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'Fale novamente com o Engenheiro-chefe Vedaçude e mostre a ele a pista que você descobriu.‡Вернитесь к главному инженеру Плотине и покажите ему найденную улику.‡Kehrt zu Chefingenieur Hinderweir zurück und zeigt ihm den Hinweis, den Ihr entdeckt habt.‡선임기술자 힌더바이르에게 돌아가 발견한 단서를 보여 주어야 합니다.‡Enséñale la pista al ingeniero jefe Hinderweir.‡Enséñale la pista al ingeniero jefe Hinderweir.‡Retourner voir l\'ingénieur en chef Hinderweir et lui montrer l\'indice que vous avez découvert.‡回去见主工程师辛德维尔七世，把你找到的线索交给他。‡回去見主工程師辛德維爾七世，把妳找到的線索交給他。',
  }
},
[200] = {
  {
    'Contador Herodes‡Букмекер Герод‡Buchmacher Herod‡사서 헤로드‡Bookie Herod‡Corredor Herod‡Herod la Paperasse‡书呆子赫罗德‡書呆子赫羅德',
    nil,
    'Encontre os Registros do Contador Herodes.‡Найдите записи букмекера Герода.‡Findet Buchhalter Herods Aufzeichnungen.‡사서 헤로드의 기록을 찾아야 합니다.‡Encuentra los registros de Bookie Herod.‡Encuentra los registros del corredor Herod.‡Trouver les registres de Herod la Paperasse.‡找到书呆子赫罗德的档案。‡找到書呆子赫羅德的檔案。',
  }
},
[201] = {
  {
    'Investigue o acampamento‡Поиск лагеря‡Untersuchung des Lagers‡야영지 조사‡Investiga el campamento‡Investiga el campamento‡L\'enquête au camp‡调查营地‡調查營地',
    nil,
    'Encontre o acampamento de caçadores e relate a localização para Krazek na Angra do Butim.‡Найдите лагерь охотников и сообщите о его местонахождении Кразеку из Пиратской бухты.‡Lokalisiert das Jägerlager und teilt dann Krazek in Booty Bay mit, wo es sich befindet.‡사냥꾼 야영지를 찾은 다음 무법항에 있는 크라젝에게 그 위치를 보고해야 합니다.‡Encuentra el campamento de los cazadores e informa sobre su ubicación a Krazek en la Bahía del Botín.‡Encuentra el campamento de los cazadores e informa sobre su ubicación a Krazek en la Bahía del Botín.‡Trouver le camp des chasseurs et communiquer sa position à Krazek à Baie-du-Butin.‡找到猎人营地并向藏宝海湾的克拉兹克报告这个营地的位置。‡找到獵人營地並向藏寶海灣的克拉茲克報告這個營地的位置。',
  }
},
[202] = {
  {
    'Coronel Kurzen‡Полковник Курцен‡Colonel Kurzen‡대령 쿠르젠‡Coronel Kurzen‡Coronel Kurzen‡Le colonel Kurzen‡库尔森上校‡庫爾森上校',
    nil,
    'Mate 6 Elites de Kurzen, 4 Subchefes de Kurzen e traga a Cabeça do Kurzen para o Tenente Doren no Acampamento dos Rebeldes.‡Убейте 6 гвардейцев и 4 заместителей Курцена и принесите голову Курцена лейтенанту Дорену в Лагерь повстанцев.‡Tötet 6 von Kurzens Elitesoldaten, 4 von Kurzens Stabschefs und bringt Kurzens Kopf ins Rebellenlager zu Lieutenant Doren.‡쿠르젠 정예병 6명, 쿠르젠 부대장 4명을 처치하고 그 증거로 쿠르젠의 머리카락을 반란군 야영지에 있는 부관 도렌에게 가져가야 합니다.‡Mata 6 unidades de élite Kurzen y 4 subjefes Kurzen. Lleva la cabeza de Kurzen al teniente Doren en el Asentamiento Rebelde.‡Mata 6 unidades de élite de Kurzen y 4 subjefes de Kurzen. Lleva la cabeza de Kurzen al teniente Doren en el Asentamiento Rebelde.‡Tuer 6 Troupes d\'élite, 4 Lieutenants et rapporter la tête de Kurzen au lieutenant Doren au camp rebelle.‡杀掉6名库尔森精英和4名库尔森副首领，并将库尔森的头颅交给反抗军营地里的多伦上尉。‡殺掉6名庫爾森精英和4名庫爾森副首領，並將庫爾森的頭顱交給反抗軍營地裏的多倫上尉。',
  }
},
[203] = {
  {
    'A segunda rebelião‡Второе восстание‡Die zweite Rebellion‡제 2의 반란‡La segunda rebelión‡La segunda rebelión‡La seconde rébellion‡以彼之道还施彼身‡以彼之道還施彼身',
    nil,
    'Mate 15 Guerrilheiros da Selva de Kurzen.|nFale novamente com o Sargento Yohwa no Acampamento dos Rebeldes.‡Убейте 15 партизан Курцена.|nВернитесь к сержанту Йохве в Лагерь повстанцев.‡Tötet 15 von Kurzens Dschungelkämpfern.|nKehrt ins Rebellenlager zu Sergeant Yohwa zurück.‡쿠르젠 밀림전사 15명을 처치해야 합니다.|n반란군 야영지에 있는 하사관 요화에게 돌아가십시오.‡Mata 15 combatientes de la jungla Kurzen.|nVuelve a ver al sargento Yohwa en al Asentamiento Rebelde.‡Mata a 15 jíbaros de Kurzen.|nVuelve a ver a la sargento Yohwa en el Asentamiento Rebelde.‡Tuer 15 Guerriers de la jungle.|nRetourner voir le sergent Yohwa au camp rebelle.‡杀死15名库尔森丛林战士，然后向反抗军营地的尤瓦中士复命。‡殺死15名庫爾森叢林戰士，然後向反抗軍營地的尤瓦中士復命。',
  }
},
[204] = {
  {
    'Remédio do mal‡Дурное лекарство‡Schlechte Medizin‡나쁜 약‡Mala medicina‡Mala medicina‡Mauvaise médecine‡库尔森的药物‡庫爾森的藥物',
    nil,
    'Traga 7 Remédios da Mata e 1 Extrato de Samambaia Peçonhenta para o Sargento Yohwa no Acampamento dos Rebeldes.‡Принесите сержанту Йохве из Лагеря повстанцев 7 порций зелья из джунглей и 1 порцию экстракта ядовитого папоротника.‡Bringt Sergeant Yohwa im Rebellenlager 7 Dschungelarzneien und 1 Giftfarnextrakt.‡반란군 야영지에 있는 하사관 요화에게 밀림 치료제 7개와 독고사리 즙 1개를 가져가야 합니다.‡Lleva 7 remedios de la jungla y 1 extracto de veneno de helecho al sargento Yohwa en el Asentamiento Rebelde.‡Lleva 7 pócimas de la selva y 1 extracto de helecho venenoso a la sargento Yohwa en el Asentamiento Rebelde.‡Apporter 7 Remèdes tropicaux et 1 Extrait de fougère vénéneuse au sergentYohwa au Camp rebelle.‡给反抗军营地里的尤瓦中士带回7份密林药剂和1份毒草汁液。‡給反抗軍營地裏的尤瓦中士帶回7份密林藥劑和1份毒草汁液。',
  }
},
[205] = {
  {
    'Bruxaria trólica‡Тролльское колдовство‡Troll-Hexerei‡트롤의 마법‡Brujería trol‡Brujería trol‡Sorcellerie troll‡巨魔巫术‡巨魔巫術',
    nil,
    'Leve 4 Fetiches Rachacrânio para o Irmão Nimetz no Acampamento dos Rebeldes.‡Принесите 4 фетиша троллей из племени Дробителей Черепов брату Нимезу в лагерь Повстанцев.‡Bringt Bruder Nimetz 4 Fetische der Skullsplitter ins Rebellenlager.‡반란군 야영지에 있는 수사 니메츠에게 백골가루부족 우상 4개를 가져가야 합니다.‡Lleva 4 fetiches Machacacráneos al hermano Nimetz en el Asentamiento Rebelde.‡Lleva 4 fetiches Machacacráneos al hermano Nimetz en el Asentamiento Rebelde.‡Apporter 4 Fétiches Skullsplitter à frère Nimetz au camp rebelle.‡给叛军营地的尼麦兹修士带回4只劈颅巨魔的神像。‡給叛軍營地的尼麥茲修士帶回4只劈顱巨魔的神像。',
  }
},
[206] = {
  {
    'Mai\'Zoth‡Май\'Зот‡Mai\'Zoth‡마이조스‡Mai\'Zoth‡Mai\'Zoth‡Mai\'Zoth‡麦佐斯‡麥佐斯',
    nil,
    'Leve o Olho da Mente para o Irmão Nimetz no Acampamento dos Rebeldes.‡Принесите Око Разума брату Нимезу в лагерь Повстанцев.‡Bringt das Gedankenauge zu Bruder Nimetz ins Rebellenlager.‡반란군 야영지에 있는 수사 니메츠에게 마음의 눈을 가져가야 합니다.‡Lleva el Ojo de la Mente al hermano Nimetz en el Asentamiento Rebelde.‡Lleva el Ojo de la mente al hermano Nimetz en el Asentamiento Rebelde.‡Apporter la Vue de l\'Esprit au frère Nimetz au camp rebelle.‡将心灵之眼交给反抗军营地里的尼麦兹修士。‡將心靈之眼交給反抗軍營地裏的尼麥茲修士。',
  }
},
[207] = {
  {
    'O mistério de Kurzen‡Тайна Курцена‡Das Geheimnis um Kurzen‡쿠르젠의 비밀‡El misterio de Kurzen‡El misterio de Kurzen‡Le mystère de Kurzen‡库尔森的秘密‡庫爾森的秘密',
    nil,
    'Encontre as 4 tabuletas e leve as lendas para o Irmão Nimetz.‡Найдите 4 таблички, перерисуйте их и принесите их брату Нимезу.‡Findet die 4 Schrifttafeln und bringt ihre Legenden zu Bruder Nimetz zurück.‡4개의 서판을 찾아 거기에 기록된 전설을 수사 니메츠에게 가져가야 합니다.‡Encuentra las 4 tablillas y lleva las leyendas al hermano Nimetz.‡Encuentra las 4 tablillas y lleva las leyendas al hermano Nimetz.‡Trouver les 4 tablettes et rapporter ces légendes au frère Nimetz.‡找到4块石板并将上面的内容带回去交给尼麦兹修士。‡找到4塊石板並將上面的內容帶回去交給尼麥茲修士。',
  }
},
[208] = {
  {
    'A grande caçada‡Охотник на крупную дичь‡Großwildjagd‡대단한 사냥꾼‡Caza mayor‡Caza mayor‡La chasse au gros gibier‡王牌猎人‡王牌獵人',
    nil,
    'Rosarães Guima quer que você lhe traga a cabeça do Rei Bangalash, o grande tigre branco.‡Хеминг Эрнестуэй попросил вас принести ему голову короля Бангалаша, огромного белого тигра.‡Hemet Nesingwary möchte, dass Ihr ihm den Kopf von König Bangalash, dem großen weißen Tiger, bringt.‡헤멧 네싱워리가 거대한 백색 호랑이인 야수왕 뱅갈라시의 머리를 가져다 달라고 부탁했습니다.‡Hemet Decautela quiere que le lleves la cabeza del rey Bangalash, el gran tigre blanco.‡Hemet Nesingwary quiere que le lleves la cabeza del rey Bangalash, el gran tigre blanco.‡Hemet Nesingwary veut que vous lui rameniez la tête du roi Bangalash, le grand tigre blanc.‡赫米特·奈辛瓦里要求你将虎王邦加拉什的头带回来给他。‡赫米特·奈辛瓦裏要求妳將虎王邦加拉什的頭帶回來給他。',
  }
},
[209] = {
  {
    'Presas Rachacrânio‡Клыки троллей‡Hauer der Skullsplitter‡백골가루부족 어금니‡Colmillos de Machacacráneos‡Colmillos Machacacráneos‡Les défenses Skullsplitter‡劈颅巨魔的獠牙‡劈顱巨魔的獠牙',
    nil,
    'Consiga 18 Presas Rachacrânio e traga-as de volta para Kebok.‡Добудьте 18 клыков троллей из клана Дробителей Черепов и принесите их Кебоку в Бухту Контрабандистов.‡Besorgt 18 Hauer der Skullsplitter und bringt sie zu Kebok.‡백골가루부족 어금니 18개를 모아 케복에게 돌아가야 합니다.‡Consigue 18 colmillos de Machacacráneos y llévaselos a Kebok.‡Consigue 18 colmillos Machacacráneos y llévaselos a Kebok.‡Acquérir 18 Défenses de trolls Skullsplitter et les apporter à Kebok.‡给藏宝海湾的科博克带回18根劈颅巨魔的獠牙。‡給藏寶海灣的科博克帶回18根劈顱巨魔的獠牙。',
  }
},
[210] = {
  {
    'A cozinha de Krazek‡Горшок Кразека‡Kochen mit Krazek‡크라젝의 요리 냄비‡La cocina de Krazek‡La cocina de Krazek‡La cuisine de Krazeck‡克拉兹克的烹调锅‡克拉茲克的烹調鍋',
    nil,
    'Leve a Caçarola Meia-boca do Krazek para Krazek, o goblin.‡Отнесите разбитый горшок Кразека гоблину Кразеку.‡Bringt Krazeks Spezialtopf zu Krazek, dem Goblin.‡고블린 크라젝에게 크라젝의 고물 냄비를 가져가야 합니다.‡Lleva la olla mecánica de Krazek al goblin Krazek.‡Lleva la olla mecánica de Krazek al goblin Krazek.‡Apporter la Cocotte ébréchée de chez Krazeck à Krazeck le gobelin.‡把克拉兹克的烹调锅带给藏宝海湾的地精克拉兹克。‡把克拉茲克的烹調鍋帶給藏寶海灣的地精克拉茲克。',
  }
},
[211] = {
  {
    'Adeus, Andorhal‡Увы тебе, Андорал‡Weh dir, Andorhal‡리치의 최후‡Ah, Andorhal‡Ah, Andorhal‡Hélas, Andorhal‡啊，安多哈尔！‡啊，安多哈爾！',
    nil,
    'Leve o Fragmento de Filactério de Araj ao Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите осколок оберега Араджа командиру Ашламу Отважному Кулаку в лагерь Промозглого Ветра в Западных Чумных землях.‡Bringt den Splitter von Arajs Phylakterium zu Kommandant Ashlam Valorfist auf der Chillwindspitze in den westlichen Pestländern.‡서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 아라즈의 성물함 조각을 가져다 주어야 합니다.‡Lleva el Fragmento de Filacteria de Araj al comandante Ashlam Puñovalor del Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva el trozo de filacteria de Araj al comandante Ashlam Puñovalor del Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter l’Eclat phylactère d\'Araj au commandant Ashlam Valorfist, au camp du Noroît, dans les Maleterres de l’ouest.‡把阿拉基的护符匣碎片交给西瘟疫之地冰风岗的指挥官阿什拉姆·瓦罗菲斯特。‡把阿拉基的護符匣碎片交給西瘟疫之地冰風崗的指揮官阿什拉姆·瓦羅菲斯特。',
  }
},
[212] = {
  {
    'A festança é um prato que se come frio‡Холодный обед‡Eine kalte Mahlzeit‡식은 음식‡Un plato bien frío‡Un plato bien frío‡Un repas servi froid‡冷餐会‡冷餐會',
    nil,
    'Mate um Basilisco Olho Frio, pegue uma Anca Fria de Basilisco e leve até Angelo Severo no Recôndito Azulego.|n<Você não pode liberar o seu espírito para conseguir realizar esta missão>‡Убейте ледоглазого василиска и принесите его охлажденный окорок Ангусу Штерну в "Синий Отшельник".|n*В этом задании запрещено в случае гибели освобождать свой дух.*‡Tötet einen Kaltaugenbasilisken, beschafft Euch einen gekühlten Basiliskenschenkel und bringt ihn Angus Stern im Blauen Eremiten.|n<Um diese Aufgabe erfolgreich abschließen zu können, dürft Ihr Euren Geist nicht freigeben.>‡얼음눈 바실리스크를 처치하고 얼린 바실리스크 다리를 얻은 다음 고독한 은둔자 선술집에 있는 앵거스 스턴에게 돌아가야 합니다.|n퀘스트 진행 도중 한번이라도 죽게 되면 이 퀘스트를 완수할 수 없습니다.‡Mata un Basilisco Ojogélido, consigue un anca de basilisco helado y llévasela a Angus Stern en El Ermitaño Azul.|n<Para tener éxito en esta misión, no puedes soltar tu espíritu.>‡Mata a un basilisco ojogélido, obtén una anca de basilisco fría y llévasela a Angus Stern en El Ermitaño Taciturno.‡Tuer un basilic Œil-de-glace, collecter un Cuissot de basilic glacé, et le rapporter à Angus Stern, au Solitaire bleu.|n<Pour réussir cette quête vous devez la terminer sans libérer votre esprit.>‡杀死一只冷眼蜥蜴，取一块冷蜥蜴肉并把它带给“蓝色隐士”旅店里的安古斯·斯特恩。|n<如果你在任务过程中死亡则任务失败>‡殺死壹只冷眼蜥蜴，取壹塊冷蜥蜴肉並把它帶給“藍色隱士”旅店裏的安古斯·斯特恩。|n<如果妳在任務過程中死亡則任務失敗>',
  }
},
[213] = {
  {
    'Abordagem hostil‡Недружественное поглощение‡Feindliche Übernahme‡적대적 탈취‡OPA hostil‡OPA hostil‡Une ponction musclée‡恶性竞争‡惡性競爭',
    nil,
    'Recupere 8 Cristais Rolados e entregue-os a Kebok na Angra do Butim.‡Добудьте 8 упавших кристаллов и принесите их Кебоку в Пиратскую бухту.‡Beschafft 8 gerommelte Kristalle und bringt sie nach Booty Bay zu Kebok.‡연마된 수정 8개를 찾아 무법항에 있는 케복에게 가져가야 합니다.‡Consigue 8 cristales girados y llévaselos a Kebok en la Bahía del Botín.‡Consigue 8 cristales caídos y llévaselos a Kebok en la Bahía del Botín.‡Retrouver 8 Cristaux réduits et les apporter à Kebok à Baie-du-Butin.‡给藏宝海湾的科博克带回8块打磨过的水晶。‡給藏寶海灣的科博克帶回8塊打磨過的水晶。',
  }
},
[214] = {
  {
    'Bandana de seda vermelha‡Красные шелковые банданы‡Rote Seidenkopftücher‡붉은 비단 복면‡Pañuelos rojos de seda‡Pañuelos rojos de seda‡Les masques rouges en soie‡红色丝质面罩‡紅色絲質面罩',
    nil,
    'A Batedora Riell, da Torre do Morro da Sentinela, quer que você lhe traga 10 Bandanas de Seda Vermelha.‡Принесите 10 красных шелковых бандан разведчице Риэле к башне на Сторожевом холме.‡Späherin Riell am Turm auf der Späherkuppe möchte, dass Ihr ihr 10 rote Seidenkopftücher bringt.‡감시의 언덕 탑의 정찰병 리엘이 붉은 비단 복면 10개를 가져다 달라고 부탁했습니다.‡La exploradora Riell de la Colina del Centinela quiere que le lleves 10 pañuelos de seda roja.‡La exploradora Riell de la Colina del Centinela quiere que le lleves 10 pañuelos de seda roja.‡L\'Eclaireur Riell de la tour de la Colline des sentinelles veut que vous lui rameniez 10 masques rouges en soie.‡给哨兵岭哨塔的哨兵瑞尔带回10条红色丝质面罩。‡給哨兵嶺哨塔的哨兵瑞爾帶回10條紅色絲質面罩。',
  }
},
[215] = {
  {
    'Segredos da selva‡Тайны джунглей‡Geheimnisse im Dschungel‡정글의 비밀‡Los secretos de la jungla‡Los secretos de la jungla‡Les secrets de la jungle‡丛林中的秘密‡叢林中的秘密',
    nil,
    'Fale com o Tenente Doren no Acampamento dos Rebeldes.‡Поговорите с лейтенантом Дореном в Лагере повстанцев.‡Sprecht im Rebellenlager mit Lieutenant Doren.‡반란군 야영지에 있는 부관 도렌과 대화해야 합니다.‡Habla con el teniente Doren en el Asentamiento Rebelde.‡Habla con el teniente Doren en el Asentamiento Rebelde.‡Parler au lieutenant Doren au camp rebelle.‡与反抗军营地里的多伦上尉谈一谈。‡與反抗軍營地裏的多倫上尉談壹談。',
  }
},
[216] = {
  {
    'No meio do caminho tinha uma pedra... e um pelocardo...‡Между молотом и Колючим Мехом‡Hart auf hart‡엉겅퀴 마을 침공‡Entre una roca y un Piel de Cardo‡Entre una roca y un Piel de Cardo‡Entre un roc et un Crin-de-Chardon‡蓟皮熊怪的麻烦‡薊皮熊怪的麻煩',
    nil,
    'Mate 12 Vingadores Pelocardo e 12 Xamãs Pelocardo; a maioria se localiza a leste da Praia de Zoram, na Aldeia dos Pelocardo. Uma vez concluído, fale novamente com Karang Amakkar no Assentamento Zoram\'gar, Vale Gris.‡Убейте 12 мстителей из племени Колючего Меха и 12 шаманов из племени Колючего Меха. Большинство из них находятся к востоку от Зорамского взморья в деревне Колючего Меха. Выполнив задачу, возвращайтесь к Карангу Амаккару в форт Зорам\'гар, что в Ясеневом лесу.‡Schaltet 12 Rächer der Distelfelle und 12 Schamanen der Distelfelle aus. Man findet sie am häufigsten östlich vom Zoramstrand im Distelfelllager. Wenn das erledigt ist, kehrt zu Karang Amakkar in den Zoram\'gar-Außenposten in Ashenvale zurück.‡엉겅퀴일족 복수자와 주술사를 각각 12마리씩 처치해야 합니다. 조람 해안 동쪽에 있는 엉겅퀴 마을에 몰려 있을 것입니다. 임무를 마치면 잿빛 골짜기 조람가르 호드 전초기지로 가서 카랑 아마카르를 만나야 합니다.‡Ejecuta a 12 vengadores Piel de Cardo y a 12 chamanes Piel de Cardo; la mayoría se encuentran al este de La Ensenada de Zoram en el Poblado Piel de Cardo. Cuando lo hayas logrado, vuelve junto a Karang Amakkar en la Avanzada de Zoram\'gar, Vallefresno.‡Elimina 12 vengadores Piel de Cardo y 12 chamanes Piel de Cardo; la mayoría están ubicados al este de Ensenada de Zoram en Poblado Piel de Cardo. Una vez que hayas terminado, regresa con Karang Amakkar en Avanzada de Zoram\'gar, Vallefresno.‡Tuer 12 Vengeurs Crins-de-Chardon et 12 Chamans Crins-de-Chardon ; la plupart d’entre eux se trouvent à l’est de la grève de Zoram, dans le village des Crins-de-Chardon. Retourner voir Karang Amakkar, à l’avant-poste de Zoram\'gar, à Ashenvale, une fois que vous aurez terminé.‡杀死12个蓟皮复仇者和12个蓟皮萨满祭司。他们大部分都位于佐拉姆海岸东部的蓟皮村里。任务完成后回到灰谷佐拉姆加前哨站的卡拉恩·阿玛卡那里复命。‡殺死12個薊皮復仇者和12個薊皮薩滿祭司。他們大部分都位於佐拉姆海岸東部的薊皮村裏。任務完成後回到灰谷佐拉姆加前哨站的卡拉恩·阿瑪卡那裏復命。',
  }
},
[217] = {
  {
    'Em defesa das terras do Rei‡Защита королевских земель‡Verteidigung der Länder des Königs‡왕국 수호‡En defensa de las tierras del rey‡En defensa de las tierras del rey‡À la défense des terres du roi‡保卫国王的领土‡保衛國王的領土',
    nil,
    'Mate o líder dos troggs, Gromug, e seus dois guardas, Triscadente e Brigão, e então fale novamente com o Capitão Balbúrdia na torre de guarda sul.‡Убейте предводителя троггов Громага и его охранников, Скрежетуна и Буяна. Сообщите об этом капитану Ругельфассу в южной сторожевой башне.‡Tötet den Anführer der Troggs, Grawmug, sowie seine beiden Wachen, Knirscher und Muskelprotz, und erstattet dann Captain Rugelfuss im südlichen Wachturm Bericht.‡트로그의 우두머리인 그로우머그와 그의 경비병인 내셔와 브롤러를 처치하고 남쪽 경비탑으로 돌아와 경비대장 루겔퍼스에게 보고하십시오.‡Mata al jefe trol, Grawmug, y a sus dos matones, Rechín y Camorrista. Informa al capitán Rugelfuss en la torre de vigilancia sur.‡Mata al líder trogg, Gromug, y a sus dos guardias, Rechín y Camorrista y preséntate ante el capitán Rugelfuss en la torre de vigilancia sur.‡Tuer le chef des troggs, Grawmug, et ses deux gardes, Grinceur et Bagarreur, puis rendre compte de la situation au capitaine Rugelfuss à la Tour de garde méridionale.‡杀掉穴居人首领格劳姆格及他的两个护卫，纳什尔和布劳勒尔。然后回到南部警戒塔向拉格弗斯上尉报告。‡殺掉穴居人首領格勞姆格及他的兩個護衛，納什爾和布勞勒爾。然後回到南部警戒塔向拉格弗斯上尉報告。',
  }
},
[218] = {
  {
    'O diário roubado‡Украденные записи‡Das gestohlene Tagebuch‡도둑맞은 일지‡El diario robado‡El diario robado‡Le journal volé‡被窃取的日记‡被竊取的日記',
    nil,
    'Grolin Barbabranca quer que você mate Grik\'nir, o Frio, e recupere seu diário.‡Убейте Грик\'нира Холодного и верните Грелину его записи.‡Grelin Whitebeard möchte, dass Ihr Grik\'nir den Kalten tötet und ihm sein Tagebuch wiederbeschafft.‡그렐린 화이트비어드가 냉혈한 그리크니르를 처치하고 일지를 되찾아 달라고 부탁했습니다.‡Grelin Barbablanca quiere que mates a Grik\'nir el Frío y que recuperes su diario.‡Grelin Barbablanca quiere que mates a Grik\'nir el Frío y que recuperes su diario.‡Grelin Whitebeard veut que vous tuiez Grik\'nir le Froid et que vous lui rapportiez son journal.‡格瑞林·白须要你去杀掉冷酷的格瑞克尼尔，并取回他的日记。‡格瑞林·白須要妳去殺掉冷酷的格瑞克尼爾，並取回他的日記。',
  }
},
[219] = {
  {
    'Desaparecidos em ação‡Пропавший без вести‡Vermisst‡교전 중 실종‡Desaparecido en combate‡Desaparecido en combate‡Porté disparu‡失踪人员‡失蹤人員',
    nil,
    'Proteja o Cabo Keeshan em sua jornada de volta a Cristarrubra.‡Проводите капрала Кеешана до Красногорья.‡Beschützt Corporal Keeshan auf dem Rückweg ins Rotkammgebirge.‡하사관 키샨이 붉은마루 산맥으로 돌아갈 수 있도록 보호하십시오.‡Protege al cabo Keeshan en el camino a Crestagrana.‡Protege al cabo Keeshan en el camino a Crestagrana.‡Protéger le caporal Keeshan sur le chemin des Carmines.‡保护基沙恩下士回到赤脊。‡保護基沙恩下士回到赤脊。',
  }
},
[220] = {
  {
    'O clamor da Água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve a Ampola da Mais Pura Água para Islen Vidente da Água nos Sertões.‡Отнесите фиал с чистейшей водой Ислен Заклинательнице Воды в Степи.‡Bringt die Phiole mit reinstem Wasser in das Brachland zu Islen Waterseer.‡불모의 땅에 있는 이슬렌 워터시어에게 가득 찬 순수한 물을 가져가야 합니다.‡Llévale el vial del agua más pura a Islen Vident\'aqua en Los Baldíos.‡Llévale el vial del agua pura a Islen Vident\'aqua en Los Baldíos.‡Apporter la Fiole d\'eau la plus pure à Islen Waterseer dans les Tarides.‡把最纯净的水交给贫瘠之地的伊斯伦。‡把最純凈的水交給貧瘠之地的伊斯倫。',
  }
},
[221] = {
  {
    'Worgens na floresta‡Воргены в лесу‡Worgs in den Wäldern‡숲 속의 늑대인간‡Ferocanis en el bosque‡Huargen en el bosque‡Worgens dans les bois‡森林里的狼人‡森林裏的狼人',
    nil,
    'Mate 12 Worgens Corretrevas Nocturnos para Petrônio na Vila Sombria.‡Убейте 12 вестников Тьмы из стаи Ночной Погибели.‡Tötet für Calor aus Dunkelhain 12 Dunkelläufer der Nachtheuler.‡다크샤이어의 칼로를 위해 파멸의어둠일족 암흑길잡이 12마리를 처치해야 합니다.‡Mata a 12 ferocanis correoscuros nocturnos para Calor de Villa Oscura.‡Mata a 12 huargen sombracechadores Penumbría para Calor de Villa Oscura.‡Tuer 12 worgens Messagers Plaie-de-nuit pour Calor en Darkshire.‡为夜色镇的卡洛尔杀掉12个夜行黑暗狼人。‡為夜色鎮的卡洛爾殺掉12個夜行黑暗狼人。',
  }
},
[222] = {
  {
    'Worgens na floresta‡Воргены в лесу‡Worgs in den Wäldern‡숲 속의 늑대인간‡Ferocanis en el bosque‡Huargen en el bosque‡Worgens dans les bois‡森林里的狼人‡森林裏的狼人',
    nil,
    'Mate 8 Presas Torpes Nocturnos e 8 Maculados Nocturnos para Petrônio na Vila Sombria.‡Калор просит вас убить 8 Ярых Клыков из стаи Ночной Погибели и 8 нечистых воргенов из стаи Ночной Погибели.‡Tötet für Calor aus Dunkelhain einige Worgs, und zwar 8 Faulreißer der Nachtheuler und 8 besudelte Nachtheuler.‡다크샤이어의 칼로를 위해 파멸의어둠일족 송곳니투사 8마리와 파멸의어둠일족 타락전사 8마리를 처치해야 합니다.‡Mata 8 Colmillovil nocturnos y 8 ferocanis corruptos nocturnos para Calor de Villa Oscura.‡Mata 8 Colmillovil nocturnos y 8 huargen corruptos Penumbría para Calor de Villa Oscura.‡Tuer 8 Crocs noirs Plaie-de-nuit et 8 Contaminés Plaie-de-nuit pour Calor en Darkshire.‡为夜色镇的卡洛尔杀掉8个夜行邪齿狼人和8个夜行堕落狼人。‡為夜色鎮的卡洛爾殺掉8個夜行邪齒狼人和8個夜行墮落狼人。',
  }
},
[223] = {
  {
    'Worgens na floresta‡Воргены в лесу‡Worgs in den Wäldern‡숲 속의 늑대인간‡Ferocanis en el bosque‡Huargen en el bosque‡Worgens dans les bois‡森林里的狼人‡森林裏的狼人',
    nil,
    'Entregue o bilhete do Petrônio para João Carevino.‡Отнесите записку Калора Джонатану Карвину.‡Bringt Calors Notiz zu Jonathan Carevin.‡조나단 카레빈에게 칼로의 쪽지를 가져가야 합니다.‡Lleva la nota de Calor a Jonathan Carevin.‡Lleva la nota de Calor a Jonathan Carevin.‡Apporter la lettre de Calor à Jonathan Carevin.‡把卡洛尔的便笺交给乔纳森·卡尔文。‡把卡洛爾的便箋交給喬納森·卡爾文。',
  }
},
[224] = {
  {
    'Em defesa das terras do Rei‡Защита королевских земель‡Verteidigung der Länder des Königs‡왕국 수호‡En defensa de las tierras del rey‡En defensa de las tierras del rey‡À la défense des terres du roi‡保卫国王的领土‡保衛國王的領土',
    nil,
    'O Montanhista Sapatorro, da torre de guarda sul, quer que você mate 10 Troggs Lascapedra e 10 Batedores Lascapedra.‡Горный пехотинец Кремневик просит вас убить 10 троггов из племени Камнедробов и 10 разведчиков из племени Камнедробов.‡Gebirgsjäger Cobbleflint vom südlichen Wachturm möchte, dass Ihr 10 Stonesplitter-Troggs und 10 Stonesplitter-Späher tötet.‡남쪽 경비탑의 산악경비대 코블플린트가 가루바위 트로그와 가루바위일족 정찰병을 각각 10마리씩 처치해 달라고 부탁했습니다.‡El montaraz Pedernal en la torre de vigilancia sur quiere que mates a 10 troggs Rompecantos y 10 exploradores Rompecantos.‡El montaraz Pedernal en la torre de vigilancia sur quiere que mates a 10 troggs Rompecantos y 10 exploradores Rompecantos.‡Le Montagnard Cobbleflint de la Tour de garde méridionale veut que vous tuiez 10 Troggs et 10 Eclaireurs Brisepierre.‡南部警戒塔的巡山人库伯弗林特要你杀掉10个碎石穴居人和10个碎石怪斥候。‡南部警戒塔的巡山人庫伯弗林特要妳殺掉10個碎石穴居人和10個碎石怪斥候。',
  }
},
[225] = {
  {
    'A velha lápide‡Заброшенная могила‡Das verwitterte Grab‡오래된 무덤‡La lápida desgastada‡La lápida desgastada‡La tombe effritée‡饱经风霜的墓碑‡飽經風霜的墓碑',
    nil,
    'Fale com Sirra Von\'Indi na Vila Sombria.‡Поговорите с Широй Фон-Инди в Темнолесье.‡Sprecht in Dunkelhain mit Sirra Von\'Indi.‡다크샤이어의 시라 본인디와 대화해야 합니다.‡Ve a Villa Oscura y habla con Sirra Von\'Indi.‡Ve a Villa Oscura y habla con Sirra Von\'Indi.‡Parler à Sirra Von\'Indi à Darkshire.‡去和夜色镇的希拉·沃宁迪谈一谈。‡去和夜色鎮的希拉·沃寧迪談壹談。',
  }
},
[226] = {
  {
    'Lobos nos nossos calcanhares‡Волки идут по пятам‡Wölfe auf den Fersen‡늑대의 위협‡Con los lobos en los talones‡Con los lobos en los talones‡Des loups aux trousses‡恶狼成群‡惡狼成群',
    nil,
    'Mate 12 Lobos Hediondos Famintos e 8 Lobos Hediondos Raivosos e fale novamente com Lars no Acampamento do Noel, na fronteira oeste da Floresta do Crepúsculo.‡Убейте 12 голодных лютых волков и 8 бешеных лютых волков. Вернитесь к Ларсу в лагерь Свена на западной границе Сумеречного леса.‡Tötet 12 verhungernde Terrorwölfe und 8 tollwütige Terrorwölfe und kehrt dann zu Lars in Svens Lager an der westlichen Grenze des Dämmerwalds zurück.‡굶주린 그늘숲늑대 12마리와 광포한 그늘숲늑대 8마리를 처치한 다음 그늘숲의 서쪽 변경의 스벤의 야영지에 있는 라스에게 돌아가야 합니다.‡Mata a 12 lobos feroces hambrientos y a 8 lobos feroces rabiosos y vuelve al campamento de Sven en la frontera oeste de Bosque del Ocaso a buscar a Lars.‡Mata a 12 lobos feroces hambrientos y a 8 lobos feroces rabiosos y vuelve al campamento de Sven en la frontera oeste de Bosque del Ocaso a buscar a Lars.‡Tuer 12 Loups redoutables affamés et 8 Loups redoutables enragés, puis retourner auprès de Lars au camp de Sven à la frontière ouest du bois de la Pénombre.‡杀掉12只饥饿的恐狼和8只疯狂的恐狼，然后到斯温的营地中向拉尔斯交差。‡殺掉12只饑餓的恐狼和8只瘋狂的恐狼，然後到斯溫的營地中向拉爾斯交差。',
  }
},
[227] = {
  {
    'Morgan Ladimore‡Морган Ладимор‡Morgan Ladimore‡모건 래디모어‡Morgan Ladimor‡Morgan Ladimor‡Morgan Ladimore‡摩根·拉迪莫尔‡摩根·拉迪莫爾',
    nil,
    'Fale com a Comandante Aldora Ebanez na Vila Sombria.‡Поговорите с командиром Альтеей Чернодрев в Темнолесье.‡Sprecht in Dunkelhain mit Kommandantin Althea Ebonlocke.‡다크샤이어의 사령관 알시아 이본로크와 대화해야 합니다.‡Ve a Villa Oscura y habla con la comandante Althea Cerranegro.‡Ve a Villa Oscura y habla con la comandante Althea Cerranegro.‡Parler au commandant Althea Ebonlocke à Darkshire.‡去和夜色镇的指挥官阿尔泰娅·埃伯洛克谈一谈。‡去和夜色鎮的指揮官阿爾泰婭·埃伯洛克談壹談。',
  }
},
[228] = {
  {
    'Mor\'Ladim‡Мор\'Ладим‡Mor\'Ladim‡모르라딤‡Mor\'Ladim‡Mor\'Ladim‡Mor\'Ladim‡摩拉迪姆‡摩拉迪姆',
    nil,
    'Mate Mor\'Ladim e entregue a caveira dele para a Comandante Aldora Ebanez na Vila Sombria.‡Убейте Мор\'Ладима и отнесите его череп командиру Альтее Чернодрев в Темнолесье.‡Tötet Mor\'Ladim und bringt seinen Schädel nach Dunkelhain zu Kommandantin Althea Ebonlocke.‡모르라딤을 처치한 다음 그의 해골을 다크샤이어의 사령관 알시아 이본로크에게 가져가야 합니다.‡Mata a Mor\'Ladim y luego lleva su calavera a la comandante Althea Cerranegro a Villa Oscura.‡Mata a Mor\'Ladim y luego lleva su calavera a la comandante Althea Cerranegro a Villa Oscura.‡Tuer Mor\'Ladim, puis rapporter son crâne au commandant Althea Ebonlocke à Darkshire.‡杀掉摩拉迪姆，把他的头骨交给夜色镇的指挥官阿尔泰娅·埃伯洛克。‡殺掉摩拉迪姆，把他的頭骨交給夜色鎮的指揮官阿爾泰婭·埃伯洛克。',
  }
},
[229] = {
  {
    'A filha sobrevivente‡Выжившая дочь‡Die überlebende Tochter‡살아 남은 딸‡La hija superviviente‡La hija superviviente‡La fille qui survécut‡幸存的女儿‡幸存的女兒',
    nil,
    'Fale com a Vigia Sarah Ladimore na Vila Sombria.‡Поговорите с Сарой Ладимор в Темнолесье.‡Sprecht in Dunkelhain mit Behüterin Sarah Ladimore.‡다크샤이어의 순찰대원 사라 래디모어와 대화해야 합니다.‡Ve a Villa Oscura y habla con la vigilante Sarah Ladimor.‡Ve a Villa Oscura y habla con la vigilante Sarah Ladimor.‡Parler au Gardien Sarah Ladimore à Darkshire.‡去和夜色镇的守夜人莎拉·拉迪莫尔谈一谈。‡去和夜色鎮的守夜人莎拉·拉迪莫爾談壹談。',
  }
},
[230] = {
  {
    'Acampamento do Noel‡Лагерь Свена‡Svens Lager‡스벤의 야영지‡El campamento de Sven‡El campamento de Sven‡Le camp de Sven‡斯温的营地‡斯溫的營地',
    nil,
    'Leve o Livro da Fazenda de Noel para Noel.‡Принесите Свену книгу, найденную на ферме Свена.‡Bringt das Buch von Svens Hof zu Sven.‡스벤에게 스벤 농장의 책을 가져가야 합니다.‡Lleva el libro de la granja de Sven a Sven.‡Lleva el libro de la granja de Sven a Sven.‡Apporter à Sven le Livre de la ferme de Sven.‡把你从斯温的农场找到的书交给他。‡把妳從斯溫的農場找到的書交給他。',
  }
},
[231] = {
  {
    'Amor de filha‡Дочерняя любовь‡Die Liebe einer Tochter‡딸의 사랑‡El amor de una hija‡El amor de una hija‡L\'amour d\'une fille‡女儿的爱‡女兒的愛',
    nil,
    'Leve o anel de Sarah Ladimore até o túmulo de Morgan Ladimore.‡Отнесите кольцо Сары Ладимор на могилу Моргана Ладимора.‡Bringt Sarah Ladimores Ring zu Morgan Ladimores Grab.‡사라 래디모어의 반지를 모건 래디모어의 무덤으로 가져가야 합니다.‡Lleva el anillo de Sarah Ladimor a la tumba de Morgan Ladimor.‡Lleva el anillo de Sarah Ladimor a la tumba de Morgan Ladimor.‡Déposer la bague de Sarah Ladimore sur la tombe de Morgan Ladimore.‡把莎拉·拉迪莫尔的戒指拿到摩根·拉迪莫尔的坟墓上去。‡把莎拉·拉迪莫爾的戒指拿到摩根·拉迪莫爾的墳墓上去。',
  }
},
[232] = {
  {
    'Tarefa para a Boticária Zilda‡Посылка для аптекаря Зинг‡Kurierdienst für Apothekerin Zinge‡연금술사 진게의 심부름‡Una recado para la boticaria Zinge‡Un recado para la boticaria Zinge‡Course pour l\'Apothicaire Zinge‡金格的货物‡金格的貨物',
    nil,
    'Leve a ordem de compra para Alessandro Luca na Cidade Baixa.‡Отнесите заказ на товары Алессандро Луке в Подгород.‡Bringt die Bestellung nach Undercity zu Alessandro Luca.‡언더시티에 있는 알렉산드로 루카에게 진게의 구입주문서를 가져가야 합니다.‡Llévale la orden de compra a Alessandro Luca, que está en Entrañas.‡Llévale la orden de compra a Alessandro Luca en Entrañas.‡Apporter le bon de commande à Alessandro Luca dans Undercity.‡把订货单交给幽暗城的奥雷萨多·卢卡。‡把訂貨單交給幽暗城的奧雷薩多·盧卡。',
  }
},
[233] = {
  {
    'Correio de Vale Cristálgida‡Почта Холодной долины‡Postbeförderung im Coldridgetal‡눈마루 골짜기 편지 배달‡Entrega de correo en el Valle de Crestanevada‡Entrega de correo en el Valle de Crestanevada‡La distribution du courrier de la Vallée des Frigères‡寒脊山谷的送信任务‡寒脊山谷的送信任務',
    nil,
    'Entregue a Pilha de Cartas para Talin Olhobom.‡Доставьте письма Талину Остроглазу.‡Liefert den Stapel Briefe bei Talin Keeneye ab.‡편지 뭉치를 탈린 킨아이에게 배달해야 합니다.‡Entrega el fajo de cartas a Talin Ojoagudo.‡Entrega el fajo de cartas a Talin Ojo Ávido.‡Apporter la pile de lettres à Talin Keeneye.‡把这一摞信件送给塔林·锐眼。‡把這壹摞信件送給塔林·銳眼。',
  }
},
[234] = {
  {
    'Correio de Vale Cristálgida‡Почта Холодной долины‡Postbeförderung im Coldridgetal‡눈마루 골짜기 편지 배달‡Entrega de correo en el Valle de Crestanevada‡Entrega de correo en el Valle de Crestanevada‡La distribution du courrier de la Vallée des Frigères‡寒脊山谷的送信任务‡寒脊山谷的送信任務',
    nil,
    'Entregue a Carta para Grolin Barbabranca.‡Доставьте письмо Грелину Белобороду.‡Liefert den Brief bei Grelin Whitebeard ab.‡편지를 그렐린 화이트비어드에게 배달해야 합니다.‡Entrega la carta a Grelin Barbablanca.‡Entrégale la carta a Grelin Barbablanca.‡Remettre la lettre à Grelin Whitebeard.‡把这封信送给格瑞林·白须。‡把這封信送給格瑞林·白須。',
  }
},
[235] = {
  {
    'A caçada do Vale Gris‡Большая охота‡Die Jagd in Ashenvale‡잿빛 골짜기 사냥 대회‡La Caza de Vallefresno‡La Caza de Vallefresno‡La Chasse d\'Ashenvale‡灰谷狩猎‡灰谷狩獵',
    nil,
    'Fale com Senani Coração Trovejante no Posto Machadada, que fica no Vale Gris.‡Поговорите с Сенани Громосерд на заставе Расщепленного Древа в Ясеневом лесу.‡Sprecht mit Seneni Thunderheart im Splintertreeposten in Ashenvale.‡잿빛 골짜기 토막나무 주둔지에 있는 세나니 썬더하트를 만나야 합니다.‡Habla con Senani Truenozón en Puesto del Hachazo, en Vallefresno.‡Habla con Senani Corazón Atronador en Puesto del Hachazo, en Vallefresno.‡Parler à Senani Thunderheart, au Poste de Bois-brisé, à Ashenvale.‡与灰谷碎木哨岗的塞娜尼·雷心谈一谈。‡與灰谷碎木哨崗的塞娜尼·雷心談壹談。',
  }
},
[237] = {
  {
    'Em defesa das terras do Rei‡Защита королевских земель‡Verteidigung der Länder des Königs‡왕국 수호‡En defensa de las tierras del rey‡En defensa de las tierras del rey‡À la défense des terres du roi‡保卫国王的领土‡保衛國王的領土',
    nil,
    'O Montanhista Cascalhaça, da torre de guarda sul, quer que você mate 10 Batecrânios Lascapedra e 10 Videntes Lascapedra e fale novamente com ele.‡Горный пехотинец Булыжный Карьер просит вас убить 10 головоломов из племени Камнедробов и 10 ясновидцев из племени Камнедробов.‡Gebirgsjäger Gravelgaw im südlichen Wachturm möchte, dass Ihr 10 Stonesplitter-Schädelhauer und 10 Stonesplitter-Seher tötet und ihm anschließend Bericht erstattet.‡남쪽 경비탑의 산악경비대 그레이블고가 가루바위일족 망치잡이와 가루바위일족 점쟁이를 각각 10마리씩 처치한 후 그에게 돌아와 보고해 달라고 부탁했습니다.‡El montaraz Gravagau, de la torre de vigilancia sur, quiere que mates a 10 aplastacráneos y 10 profetas Rompecantos. Luego ve a informarle.‡El montaraz Gravagau, de la torre de vigilancia sur, quiere que mates a 10 aplastacráneos y 10 videntes Rompecantos. Luego ve a informarle.‡Le Montagnard Gravelgaw de la Tour de garde méridionale veut que vous tuiez 10 Brise-crâne et 10 Prophètes Brisepierre, puis que vous retourniez le voir.‡南部警戒塔的巡山人格拉维戈要你杀掉10个碎石怪击颅者和10个碎石怪先知，然后回去向他汇报。‡南部警戒塔的巡山人格拉維戈要妳殺掉10個碎石怪擊顱者和10個碎石怪先知，然後回去向他匯報。',
  }
},
[238] = {
  {
    'Tarefa para a Boticária Zilda‡Посылка для аптекаря Зинг‡Kurierdienst für Apothekerin Zinge‡연금술사 진게의 심부름‡Una recado para la boticaria Zinge‡Un recado para la boticaria Zinge‡Course pour l\'Apothicaire Zinge‡金格的货物‡金格的貨物',
    nil,
    'Leve o Kit de Amostra de Campo para Boticária Zilda na Cidade Baixa.‡Отнесите набор для проведения полевых испытаний аптекарю Зинг в Подгород.‡Bringt das Feldprobenset nach Undercity zu Apothekerin Zinge.‡언더시티에 있는 연금술사 진게에게 휴대용 분석 도구를 가져가야 합니다.‡Llévale el equipo de recogida de muestras de campo a la boticaria Zinge, que está en Entrañas.‡Llévale el equipo de prueba de campo a la boticaria Zinge en Entrañas.‡Apportez une Trousse d\'analyse de terrain à l\'Apothicaire Zinge à Undercity.‡把采样工具包交给幽暗城的药剂师金格。‡把采樣工具包交給幽暗城的藥劑師金格。',
  }
},
[239] = {
  {
    'Ribeira d\'Oeste precisa de ajuda!‡Гарнизон у Западного ручья просит помощи!‡Hilfe für die Weststromgarnison‡서부 주둔지 지원‡El Cuartel de Arroyoeste necesita ayuda‡El Cuartel de Arroyoeste necesita ayuda‡Au secours de la garnison du ruisseau de l\'ouest !‡西泉要塞‡西泉要塞',
    nil,
    'Vá até a Guarnição da Ribeira d\'Oeste e fale com o Delegado Ranieri.‡Отправляйтесь в Гарнизон у Западного ручья и поговорите с заместителем судьи Рейнером.‡Begebt Euch zur Weststromgarnison und sprecht mit Deputy Rainer.‡서부 주둔지로 가서 부관 레이너와 대화해야 합니다.‡Ve al Cuartel de Arroyoeste y habla con el ayudante de alguacil Rainer.‡Ve al Cuartel de Arroyoeste y habla con el ayudante de alguacil Rainer.‡Se rendre à la garnison du ruisseau de l\'ouest et parler à l’Adjoint Rainer.‡到西泉要塞去和瑞尼尔副队长谈一谈。‡到西泉要塞去和瑞尼爾副隊長談壹談。',
  }
},
[240] = {
  {
    'Fale novamente com Medrisco‡Возвращение к Трясунчику‡Rückkehr zu Jitters‡지터스에게 돌아가기‡Entrega para Gato‡Regresa junto a Alterio‡Retour vers la Tremblotte‡基特斯的美餐‡基特斯的美餐',
    nil,
    'Fale novamente com Medrisco levando Bolinhos de Caranguejo Crepuscular.‡Отнесите Трясунчику темные пирожки с крабами.‡Kehrt mit den schwärzlichen Krebsküchlein zu Jitters zurück.‡갈색 게살 케이크를 가지고 지터스에게 돌아가야 합니다.‡Vuelve a donde Alterio con las croquetas de cangrejo.‡Vuelve a donde Alterio con los pasteles de cangrejo oscuro.‡Retourner voir la Tremblotte avec des Gâteaux au crabe brun.‡把黑蟹蛋糕拿回去交给基特斯。‡把黑蟹蛋糕拿回去交給基特斯。',
  }
},
[241] = {
  {
    '‡‡‡‡‡<TEST> HEY MISTER WILSON!‡‡‡',
    nil,
    '‡‡‡‡‡Log‡‡‡',
  }
},
[243] = {
  {
    'Trabalho de campo‡Поход в пустыню‡Auf ins Feld‡사막으로‡In situ‡In situ‡Sur le terrain‡进入沙漠‡進入沙漠',
    nil,
    'Fale com o Engenheiro-chefe Silvadágua em Geringontzan sobre obter uma fonte de energia para o kit de testes.‡Поговорите с главным инженером Чепухастером из Прибамбасска насчет источника энергии для набора для полевых испытаний.‡Sprecht in Gadgetzan mit Chefingenieur Bilgewhizzle über eine Kraftquelle für das Testset.‡분석 도구에 사용할 동력원을 얻기 위해 가젯잔에 있는 선임기술자 빌지위즐과 대화해야 합니다.‡Ve a Gadgetzan y encuentra al ingeniero jefe Silvaina para que te explique cómo obtener una fuente de energía para el equipo de estudio.‡Ve a Gadgetzan y encuentra al ingeniero jefe Pasaquillas para que te explique cómo obtener una fuente de energía para el equipo de estudio.‡Parler à l\'Ingénieur en chef Bilgewhizzle à Gadgetzan afin d\'obtenir une source d\'énergie pour la trousse d\'analyse.‡和加基森的首席工程师沙克斯·比格维兹谈一谈，请他为实验工具包提供能量源。‡和加基森的首席工程師沙克斯·比格維茲談壹談，請他為實驗工具包提供能量源。',
  }
},
[244] = {
  {
    'Invasão de gnolls‡Вторжение гноллов‡Eindringende Gnolle‡놀 침략자‡Gnolls invasores‡Gnolls invasores‡Des gnolls encombrants‡豺狼人的入侵‡豺狼人的入侵',
    nil,
    'Fale com o Subdelegado David.‡Поговорите с заместителем судьи Фелдоном.‡Erstattet Deputy Feldon Bericht.‡부관 펠던에게 보고해야 합니다.‡Preséntate ante el ayudante Feldon.‡Preséntate ante el ayudante de alguacil Feldon.‡Informer l’Adjoint Feldon.‡找到菲尔顿副队长。‡找到菲爾頓副隊長。',
  }
},
[245] = {
  {
    'Ameaças de oito patas‡Восьминогая угроза‡Gefahr auf acht Beinen‡거미의 위협‡Las amenazas de ocho patas‡Las amenazas de ocho patas‡Les plaies à huit pattes‡蜘蛛的威胁‡蜘蛛的威脅',
    nil,
    'Mate 15 Veneracnas Pigmeias, e depois apresente-se novamente ao Vigia Gouveia na Floresta do Crepúsculo.‡Убейте 15 карликовых ядовитых кругопрядов и доложите об этом дозорному Додсу в Сумеречном лесу.‡Erledigt 15 Zwerggiftweberspinnen und meldet Euch dann wieder bei Behüter Dodds im Dämmerwald.‡새끼 그물독거미 15마리를 처치한 후 그늘숲에 있는 순찰대원 도즈에게 보고해야 합니다.‡Mata a 15 telarácnidas pigmeovenenosas y vuelve al Bosque del Ocaso a informar al vigilante Dodds.‡Mata a 15 telarácnidas pigmeovenenosas y vuelve al Bosque del Ocaso a informar al vigía Dodds.‡Tuer 15 Araignées Tisse-venin pygmées, puis rendre compte à la Sentinelle Dodds au bois de la Pénombre.‡守夜人道茨要你杀15只小型结网毒蜘蛛。‡守夜人道茨要妳殺15只小型結網毒蜘蛛。',
  }
},
[246] = {
  {
    'Avaliando a ameaça‡Подсчет врагов‡Einschätzung der Gefahr‡탐색전‡Evaluar la amenaza‡Evaluar la amenaza‡L\'appréciation du danger‡审时度势‡審時度勢',
    nil,
    'Mate 10 Mestiços de Cristarrubra e 6 Caçadores Ilegais de Cristarrubra, e então apresente-se novamente ao Subdelegado David em Vila Plácida.‡Убейте 10 полукровок из стаи Красногорья и 6 браконьеров из стаи Красногорья и сообщить об этом заместителю судьи Фелдону в Приозерье.‡Tötet 10 Bastarde der Rotkammgnolle und 6 Wilderer der Rotkammgnolle und meldet Euch anschließend wieder bei Deputy Feldon in Seenhain.‡붉은마루일족 싸움꾼 10마리, 붉은마루일족 밀렵꾼 6마리를 처치하고 레이크샤이어에 있는 부관 펠던에게 돌아가 보고해야 합니다.‡Mata a 10 bastardos y 6 furtivos Crestagrana e informa al ayudante Feldon en Villa del Lago.‡Mata a 10 bastardos y 6 furtivos Crestagrana e informa al ayudante de alguacil Feldon en Villa del Lago.‡Tuer 10 Bâtards des Carmines et 6 Braconniers des Carmines, et aller faire un rapport à l’Adjoint Feldon à Lakeshire.‡杀死10个混血赤脊山豺狼人和6个赤脊山偷猎者，然后向湖畔镇的菲尔顿副队长复命。‡殺死10個混血赤脊山豺狼人和6個赤脊山偷獵者，然後向湖畔鎮的菲爾頓副隊長復命。',
  }
},
[247] = {
  {
    'Caçada do Vale Gris terminada‡Завершение охоты‡Die Jagd ist abgeschlossen‡사냥 대성공‡El fin de la Caza‡El fin de la Caza‡La chasse achevée‡完成狩猎‡完成狩獵',
    nil,
    nil,
  }
},
[248] = {
  {
    'Vendo além‡Пронизывающий взор‡Weitere Beobachtungen‡자세한 조사‡Ver más allá‡Ver más allá‡En regardant plus loin‡监视‡監視',
    nil,
    'Suba ao topo da torre de vigia intacta ao lado da Bastilha Mirante de Pedra.|nEncontre um recipiente adequado para colocar o Glifo de Azora.‡Поднимитесь на уцелевшую башню рядом с крепостью Каменной Стражи.|nОтыщите подходящее место и спрячьте там амулет Азоры.‡Steigt in den unversehrten Wachturm neben der Burg Steinwacht hinauf.|nFindet einen passenden Behälter für die Glyphe von Azora und legt diese dort ab.‡돌망루 요새 옆에 있는 감시탑에 올라가야 합니다.|n그곳에서 아조라의 조각상을 넣어 두기에 적합한 용기를 찾아야 합니다.‡Sube a la atalaya intacta que hay junto al Fuerte de Petravista.|nEncuentra un objeto en el que esconder el Glifo de Azora.‡Trepa la torre de vigilancia intacta junto a Fuerte de Petravista.|nEncuentra un contenador apropriado para colocar el Glifo de Azora.‡Monter au sommet de la Tour de garde intacte près du Donjon de Guet-de-pierre, puis trouver dans quoi placer le Glyphe d\'Azora.‡爬上石堡要塞一旁的哨塔。|n为阿祖拉的铭文饰品找一个合适的容器。‡爬上石堡要塞壹旁的哨塔。|n為阿祖拉的銘文飾品找壹個合適的容器。',
  }
},
[249] = {
  {
    'Morganth‡Моргант‡Morganth‡모건스‡Morganth‡Morganth‡Morganth‡莫甘斯‡莫甘斯',
    nil,
    'Derrote Morgan.|nLeve o Pingente das Sombras dele para Teócrito na Torre de Azora, na Floresta de Elwynn.‡Победите Морганта.|nПринесите его подвеску Тени Теокриту в башню Азоры в Элвиннском лесу.‡Besiegt Morganth.|nBringt seinen Schattenanhänger zu Theocritus am Turm von Azora im Wald von Elwynn.‡모건스를 처치하십시오.|n엘윈 숲의 아조라의 탑에 있는 테오크리투스에게 그림자 펜던트를 가져가야 합니다.‡Derrota a Morganth.|nLleva el colgante de la Sombra a Theocritus a la Torre de Azora, en el Bosque de Elwynn.‡Derrota a Morganth.|nLleva el colgante de las Sombras a Theocritus a la Torre de Azora, en el Bosque de Elwynn.‡Tuer Morganth, puis rapporter son Pendentif des ombres à Théocritus, à la Tour d\'Azora dans la forêt d\'Elwynn.‡击败莫甘斯。|n将他的阴影坠饰带给塞欧克瑞图斯，他就在艾尔文森林内的阿祖拉之塔中。‡擊敗莫甘斯。|n將他的陰影墜飾帶給塞歐克瑞圖斯，他就在艾爾文森林內的阿祖拉之塔中。',
  }
},
[250] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'Investigue a área próxima à rampa leste do Dique e dê ao Engenheiro-chefe Vedaçude uma pista que possa indicar o que os Anões Ferro Negro estão tramando.‡Осмотрите область вокруг восточной части Дамбы и отыщите для главного инженера Плотины улику, указывающую на замыслы дворфов Черного Железа.‡Untersucht den Bereich um die östliche Dammrampe und bringt Chefingenieur Hinderweir einen Hinweis, der Auskunft darüber geben könnte, was die Dunkeleisenzwerge vorhaben.‡댐의 동쪽 사면 근처를 정찰하고 검은무쇠단 드워프의 음모를 밝힐만한 단서를 찾아 선임기술자 힌더바이르에게 가져가야 합니다.‡Investiga los alrededores de la rampa este de la Presa y lleva al ingeniero jefe Hinderweir alguna pista sobre lo que traman los Hierro Negro.‡Investiga los alrededores de la rampa este de la Presa y lleva al ingeniero jefe Hinderweir alguna pista sobre lo que traman los Hierro Negro.‡Enquêter près de la rampe est du barrage et rapporter à l\'ingénieur en chef Hinderweir un indice qui permettrait de deviner les intentions des nains Sombrefer.‡查看水坝东边斜坡附近的区域，调查一下黑铁矮人准备做什么，然后把线索带给主工程师辛德维尔七世．‡查看水壩東邊斜坡附近的區域，調查壹下黑鐵矮人準備做什麽，然後把線索帶給主工程師辛德維爾七世．',
  }
},
[251] = {
  {
    'Tradução da carta de Abercrombie‡Перевод записки Аберкромби‡Übersetzung von Calvinius\' Notiz‡에이버크롬비의 편지 번역‡Traduce la nota de Abercrombie‡Traduce la nota de Abercrombie‡La traduction de la lettre d\'Abercrombie‡翻译亚伯克隆比的信‡翻譯亞伯克隆比的信',
    nil,
    'Leve a Carta para Malaquias até Sirra Von\'Indi.‡Отнесите письмо, адресованное Элло, Шире Фон-Инди.‡Bringt den Brief an Ello zu Sirra Von\'Indi.‡시라 본인디에게 엘로에게 보내는 편지를 가져가야 합니다.‡Lleva la carta de Ello a Sirra Von\'Indi.‡Lleva la carta de Ello a Sirra Von\'Indi.‡Apporter la lettre à Ello, à Sirra Von\'Indi.‡把写给艾尔罗的信拿给希拉·沃宁迪。‡把寫給艾爾羅的信拿給希拉·沃寧迪。',
  }
},
[252] = {
  {
    'Tradução para Malaquias‡Перевод для Элло‡Übersetzung für Ello‡엘로 이본로크 경에게 편지 전달‡Una traducción para Ello‡Una traducción para Ello‡La traduction pour Ello‡翻译好的信件‡翻譯好的信件',
    nil,
    'Leve a Carta Traduzida para Lorde Malaquias Ebanez.‡Отнесите переведенное письмо лорду Элло Чернодреву.‡Bringt Lord Ello Ebonlocke den übersetzten Brief.‡엘로 이본로크 경에게 번역된 편지를 가져가야 합니다.‡Lleva la carta traducida a Lord Ello Cerranegro.‡Lleva la carta traducida a Lord Ello Cerranegro.‡Remettre la lettre traduite au seigneur Ello Ebonlocke.‡把翻好的信带给艾尔罗·埃伯洛克公爵。‡把翻好的信帶給艾爾羅·埃伯洛克公爵。',
  }
},
[253] = {
  {
    'A noiva do Embalsamador‡Невеста Бальзамировщика‡Braut des Einbalsamierers‡장의사의 신부‡La novia del embalsamador‡La novia del embalsamador‡La fiancée de l\'Embaumeur‡藏尸者的妻子‡藏屍者的妻子',
    nil,
    'Encontre o túmulo de Elisa. Retire dela o Coração do Embalsamador, então fale novamente com Malaquias Ebanez.‡Отыщите могилу Элизы. Извлеките из нее сердце Бальзамировщика и вернитесь к Элло Чернодреву.‡Findet Elizas Grab. Beschafft das Herz des Einbalsamierers, das sie in sich trägt, und kehrt zu Ello Ebonlocke zurück.‡엘리자의 무덤을 찾아 그녀의 몸에서 장의사의 심장을 찾아 엘로 이본로크 경에게 가져가야 합니다.‡Encuentra la tumba de Eliza. Quítale el corazón del embalsamador y luego vuelve a Ello Cerranegro.‡Encuentra la tumba de Eliza. Quítale el corazón del embalsamador y luego vuelve a Ello Cerranegro.‡Trouver la tombe d\'Eliza, retrouver le cœur de l\'Embaumeur, puis retourner voir Ello Ebonlocke.‡找到伊莉莎的坟墓，从她的身上取回藏尸者的心脏，把它交给艾尔罗·埃伯洛克。‡找到伊莉莎的墳墓，從她的身上取回藏屍者的心臟，把它交給艾爾羅·埃伯洛克。',
  }
},
[254] = {
  {
    'Escavando a terra‡Копание земли‡Graben in der Erde‡무덤 파기‡Escavar la tierra‡Excavar la tierra‡En creusant la terre‡掘墓‡掘墓',
    nil,
    nil,
  }
},
[255] = {
  {
    'Mercenários‡Наемники‡Söldner‡용병‡Mercenarios‡Mercenarios‡Mercenaires‡雇佣兵‡雇傭兵',
    nil,
    'O Magistrado Grã-narina de Thelsamar contratou você para matar 4 Ogros Mo\'grosh, 4 Brutamontes Mo\'grosh e 4 Impositores Mo\'grosh.‡Мировой судья Тупонос просит вас убить 4 огров из клана Мо\'грош, 4 громил из клана Мо\'грош и 4 головорезов из клана Мо\'грош.‡Magistrat Bluntnose aus Thelsamar hat Euch angeheuert, um 4 Oger der Mo\'grosh, 4 Schläger der Mo\'grosh und 4 Vollstrecker der Mo\'grosh zu töten.‡텔사마의 집정관 블런트노즈가 모그로쉬 오우거 4마리, 모그로쉬일족 투사 4마리와 모그로쉬일족 집행자 4마리를 처치하기 위해 당신을 고용했습니다.‡El magistrado Romonariz de Thelsamar te ha contratado para matar a 4 ogros, 4 brutos y 4 gorilas Mo\'grosh.‡El magistrado Narizroma de Thelsamar te ha contratado para matar 4 ogros Mo\'grosh, 4 brutos Mo\'grosh y 4 déspotas Mo\'grosh.‡Le magistrat Bluntnose de Thelsamar vous a <embauché/embauchée> pour tuer 4 Ogres, 4 Brutes et 4 Massacreurs Mo\'grosh.‡塞尔萨玛的镇长埃罗恩·钝鼻雇你去杀掉4个莫格罗什食人魔、4个莫格罗什蛮兵和4个莫格罗什执行者。‡塞爾薩瑪的鎮長埃羅恩·鈍鼻雇妳去殺掉4個莫格羅什食人魔、4個莫格羅什蠻兵和4個莫格羅什執行者。',
  }
},
[256] = {
  {
    'PROCURA-SE: Chok\'sul‡Разыскивается: Чок\'сул‡GESUCHT: Chok\'sul‡초크술 현상수배‡SE BUSCAN: Chok\'sul‡SE BUSCA: Chok\'sul‡ON RECHERCHE : Chok\'sul‡通缉令：卓克苏尔‡通緝令：卓克蘇爾',
    nil,
    'Mate Chok\'sul e entregue a cabeça para o Magistrado Grã-narina, em Thelsamar.‡Убейте Чок\'сула и принесите его голову чиновнику Тупоносу в Телcамар.‡Tötet Chok\'sul und bringt Magistrat Bluntnose seinen Kopf.‡초크술을 처치하고 그 증거로 그의 머리카락을 텔사마의 집정관 블런트노즈에게 가져가야 합니다.‡Mata a Chok\'sul y lleva su cabeza al magistrado Romonariz a Thelsamar.‡Mata a Chok\'sul y lleva su cabeza al magistrado Narizroma a Thelsamar.‡Tuer Chok\'sul et rapporter sa tête au Magistrat Bluntnose de Thelsamar.‡杀了卓克苏尔，把他的头颅带给塞尔萨玛的镇长埃罗恩·钝鼻。‡殺了卓克蘇爾，把他的頭顱帶給塞爾薩瑪的鎮長埃羅恩·鈍鼻。',
  }
},
[257] = {
  {
    'Modéstia de Caçador‡Похвальба охотника‡Das Prahlen eines Jägers‡사냥꾼의 허세‡La fanfarronada de un cazador‡La fanfarronada de un cazador‡La fanfaronnade d\'un chasseur‡自豪的猎人‡自豪的獵人',
    nil,
    'Mate 6 Urubus Montanheses e fale novamente com Dário, o Novato, no Pavilhão dos Andarilhos, dentro de 15 minutos.‡Убейте 6 горных канюков и вернитесь к Дэрилу Юному в Приют странников. На выполнение задания отводится 15 минут.‡Tötet 6 Bergbussarde und kehrt innerhalb von 15 Minuten zu Daryl dem Jüngling in die Weitschreiter-Lodge zurück.‡산악대머리수리 6마리를 처치한 후 순찰자의 오두막에 있는 풋내기 다릴에게 15분 안에 돌아와야 합니다.‡Mata 6 águilas ratoneras montesas y regresa a la Cabaña del Errante con Daryl el Jovenzuelo en menos de 15 minutos.‡Mata 6 águilas ratoneras montesas y regresa a la Cabaña del Errante con Daryl el Jovenzuelo en menos de 15 minutos.‡Tuer 6 Busards des montagnes et retourner auprès de Daryl le Jeune au pavillon des pérégrins en moins de 15 minutes.‡杀死6只山鹫，然后回到旅行者营地见年轻的达瑞尔，时限为15分钟。‡殺死6只山鷲，然後回到旅行者營地見年輕的達瑞爾，時限為15分鐘。',
  }
},
[258] = {
  {
    'Desafio de caçador‡Вызов охотнику‡Die Herausforderung eines Jägers‡사냥꾼의 도전‡El reto de un cazador‡El reto de un cazador‡Le défi d\'un chasseur‡猎人的挑战‡獵人的挑戰',
    nil,
    'Mate 5 Javalis Montanheses Anciãos e fale novamente com Dário, o Novato, no Pavilhão dos Andarilhos, dentro de 12 minutos.‡Убейте 5 старых горных вепрей и вернитесь к Дэрилу Юному в Приют странников. На выполнение задания отводится 12 минут.‡Tötet 5 alte Bergeber und kehrt innerhalb von 12 Minuten zu Daryl dem Jüngling in die Weitschreiter-Lodge zurück.‡덩치큰 산돼지 5마리를 처치한 후 순찰자의 오두막에 있는 풋내기 다릴에게 12분 내에 돌아와야 합니다.‡Mata 5 jabalís monteses mayores y ve a ver a Daryl el Jovenzuelo a la Cabaña del Errante en menos de 12 minutos.‡Mata 5 jabalíes monteses mayores y regresa a la Cabaña del Errante con Daryl el Jovenzuelo en menos de 12 minutos.‡Tuer 5 Anciens sangliers des montagnes et retourner auprès de Daryl le Jeune au pavillon des pérégrins en 12 minutes.‡杀掉5只老山猪，然后回到旅行者营地去见年轻的达瑞尔，时限为12分钟。‡殺掉5只老山豬，然後回到旅行者營地去見年輕的達瑞爾，時限為12分鐘。',
  }
},
[259] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    '‡‡‡‡‡Talk to Kelt Thomasin.‡‡‡',
  }
},
[261] = {
  {
    'No caminho Escarlate‡Путями Алого ордена‡Auf dem Scharlachroten Pfad‡붉은십자군의 길‡El sendero Escarlata‡El sendero Escarlata‡Sur le chemin écarlate‡血色之路‡血色之路',
    nil,
    'Destrua 30 Assoladores Mortos-vivos, depois fale novamente com o Irmão Anton no Posto do Nijel.‡Убейте 30 опустошителей-отрекшихся и вернитесь к брату Антону на Высоте Найджела.‡Vernichtet 30 untote Verheerer und kehrt dann zu Bruder Anton auf die Nijelspitze zurück.‡언데드 약탈자 30마리를 처치한 후 나이젤의 야영지에 있는 수사 안톤에게 돌아가야 합니다.‡Destruye 30 devastadores no-muertos y luego ve a buscar al hermano Antón a Punta de Nijel.‡Aniquila 30 devastadores no-muertos y luego ve a buscar al hermano Anton a Punta de Nijel.‡Détruire 30 Ravageurs morts-vivants, puis retourner voir Frère Anton, à la Combe de Nijel.‡杀掉30个亡灵劫掠者，然后向尼耶尔前哨站的安东修士复命。‡殺掉30個亡靈劫掠者，然後向尼耶爾前哨站的安東修士復命。',
  }
},
[262] = {
  {
    'O vulto sombrio‡Таинственный незнакомец‡Die Schattengestalt‡의문의 남자‡La figura en las sombras‡La figura en las sombras‡L\'obscure silhouette‡模糊的人影‡模糊的人影',
    nil,
    'Leve o livro que encontrou na fazenda de Noel e mostre-o aos cidadãos da Vila Sombria.‡Отнесите книгу, обнаруженную на ферме Свена, в Темнолесье и покажите ее горожанам.‡Nehmt das Buch, das Ihr auf Svens Hof gefunden habt, und zeigt es den Einwohnern von Dunkelhain.‡다크샤이어의 마을 주민들에게 스벤의 농장에서 발견한 책을 보여 줘야 합니다.‡Llévate el libro que encontraste en la granja de Sven a Villa Oscura y enséñaselo a sus habitantes.‡Llévate el libro que encontraste en la granja de Sven a Villa Oscura y enséñaselo a sus habitantes.‡Montrer le livre que vous avez trouvé à la ferme de Sven aux habitants de Darkshire.‡带着你从斯温的农场找到的书，把它拿给夜色镇上的人看看。‡帶著妳從斯溫的農場找到的書，把它拿給夜色鎮上的人看看。',
  }
},
[263] = {
  {
    'Em defesa das terras do Rei‡Защита королевских земель‡Verteidigung der Länder des Königs‡왕국 수호‡En defensa de las tierras del rey‡En defensa de las tierras del rey‡À la défense des terres du roi‡保卫国王的领土‡保衛國王的領土',
    nil,
    'Montanhista Batemuro na torre de vigia sul quer que você mate 10 Xamãs Lascapedra and 10 Quebraossos Lascapedra.‡Горный пехотинец Стенолом просит вас убить 10 шаманов из племени Камнедробов и 10 костегрызов из племени Камнедробов.‡Gebirgsjäger Wallbang im südlichen Wachturm möchte, dass Ihr 10 Schamanen der Splittersteintroggs und 10 Knochenknacker der Splittersteintroggs tötet.‡남쪽 경비탑의 산악경비대 월뱅이 가루바위일족 주술사 10명과 가루바위일족 뼈다귀싸움꾼 10명을 처치해 달라고 부탁했습니다.‡El montaraz Pedernal, de la torre de vigilancia sur, quiere que mates a 10 chamanes y 10 quebrantahuesos Rompecantos.‡Montaraz Muroplof en la torre de vigilancia sur quiere que mates 10 chamanes Rompecantos y 10 cascahuesos Rompecantos.‡Le Montagnard Wallbang de la Tour de garde méridionale veut que vous tuiez 10 Chamans et 10 Briseurs d\'Os Brisepierre.‡南部警戒塔的巡山人沃尔班要你杀掉10个碎石怪萨满祭司和10个碎石怪断骨者。‡南部警戒塔的巡山人沃爾班要妳殺掉10個碎石怪薩滿祭司和10個碎石怪斷骨者。',
  }
},
[264] = {
  {
    'Até que a morte nos separe‡Покуда смерть не разлучит нас‡Bis dass der Tod uns scheidet‡영원한 이별‡Hasta que la muerte nos separe‡Hasta que la muerte nos separe‡Jusqu\'à ce que la mort nous sépare‡至死方休‡至死方休',
    nil,
    'Coloque o Pingente da Clarice no Túmulo de Yuriv em Pinhaprata.‡Положите подвеску Кларисы на могилу Юрива в Серебролесье.‡Legt Clarices Anhänger auf Yurivs Grab in Silberwald.‡은빛소나무 숲에 있는 유리브의 무덤에 클라리스의 펜던트를 가져다 놓아야 합니다.‡Coloca el colgante de Clarice sobre la tumba de Yuriv en Argénteos.‡Coloca el colgante de Clarice sobre la tumba de Yuriv en Argénteos.‡Placer le pendentif de Clarice sur la tombe de Yuriv, dans la forêt des Pins argentés.‡把克拉莉斯的坠饰放在银松森林尤瑞夫的坟墓上。‡把克拉莉斯的墜飾放在銀松森林尤瑞夫的墳墓上。',
  }
},
[265] = {
  {
    'A busca sombria continua‡Продолжение поисков незнакомца‡Die Schattensuche geht weiter‡계속되는 조사‡La búsqueda de la figura continúa‡La búsqueda de la figura continúa‡L\'obscure recherche se poursuit‡继续搜寻‡繼續搜尋',
    nil,
    'Tente encontrar outras pistas sobre o vulto sombrio entre os aldeões.‡Поговорите с горожанами о таинственном незнакомце.‡Überprüft, ob andere Einwohner Hinweise auf die schattenhafte Gestalt haben.‡다른 마을 주민에게서 의문의 남자에 대한 정보를 알아봐야 합니다.‡Averigua si otros habitantes tienen pistas sobre la figura misteriosa.‡Averigua si otros habitantes tienen pistas sobre la figura misteriosa.‡Voir si d\'autres habitants ont des indices concernant l\'obscure silhouette.‡看看其他的镇民有没有关于模糊的人影的线索。‡看看其他的鎮民有沒有關於模糊的人影的線索。',
  }
},
[266] = {
  {
    'Perguntas na estalagem‡Расспросы в таверне‡Nachforschungen im Gasthaus‡여관에서의 조사‡Busqueda en la posada‡Preguntas en la posada‡Une enquête à l\'auberge‡调查旅店‡調查旅店',
    nil,
    'Procure pistas sobre o vulto sombrio na estalagem‡Найдите в таверне улики, связанные с таинственным незнакомцем.‡Sucht im Gasthaus nach Hinweisen auf die schattenhafte Gestalt.‡여관에서 의문의 남자에 대한 정보를 얻으십시오.‡Busca pistas sobre la figura misteriosa en la posada.‡Busca pistas sobre la figura misteriosa en la posada.‡Chercher à l\'auberge des indices concernant l\'obscure silhouette.‡到旅店去查一查关于模糊人影的线索。‡到旅店去查壹查關於模糊人影的線索。',
  }
},
[267] = {
  {
    'A ameaça dos troggs‡Троггская угроза‡Die Bedrohung durch die Troggs‡트로그의 위협‡La amenaza trogg‡La amenaza trogg‡La menace trogg‡穴居人的威胁‡穴居人的威脅',
    nil,
    'Leve 8 Dentes de Pedra de Trogg para o Capitão Balbúrdia na torre de vigia sul.‡Принесите 8 каменных зубов троггов капитану Ругельфассу.‡Bringt Captain Rugelfuss im südlichen Wachturm 8 Trogg-Steinzähne.‡남쪽 경비탑에 있는 경비대장 루겔퍼스에게 트로그의 단단한 이빨 8개를 가져가야 합니다.‡Lleva 8 petrodientes de trogg al capitán Rugelfuss a la torre de vigilancia sur.‡Lleva 8 dientes de trogg de piedra al capitán Rugelfuss a la torre de vigilancia sur.‡Apporter 8 Dents de pierre de troggs au capitaine Rugelfuss à la Tour de garde méridionale.‡给南部警戒塔的拉格弗斯上尉带去8颗穴居人的石牙。‡給南部警戒塔的拉格弗斯上尉帶去8顆穴居人的石牙。',
  }
},
[268] = {
  {
    'Respostas a Noel‡Возвращение к Свену‡Rückkehr zu Sven‡스벤에게 돌아가기‡Entrega para Sven‡Entrega para Sven‡Retourner voir Sven‡回复斯温‡回復斯溫',
    nil,
    'Leve o diário completo de Medrisco para Noel.‡Отнесите Свену законченные записи Трясунчика.‡Kehrt mit Jitters\' vollständigem Tagebuch zu Sven zurück.‡완성된 지터스의 일지를 가지고 스벤에게 돌아가야 합니다.‡Lleva a Sven el diario completo de Alterio.‡Lleva a Sven el diario completo de Alterio.‡Retourner voir Sven avec le journal complété de la Tremblotte.‡把基特斯的日记交给斯温。‡把基特斯的日記交給斯溫。',
  }
},
[269] = {
  {
    'Em busca da sabedoria‡В поисках мудрости‡Auf der Suche nach Weisheit‡지혜의 추구‡En busca de sabiduría‡En busca de sabiduría‡À la recherche de la sagesse‡寻求指引‡尋求指引',
    nil,
    'Entregue o Diário Completo de Medrisco para o Bispo Palhares em Ventobravo.‡Отдайте законченные записи Трясунчика епископу Фартингу в Штормграде.‡Gebt Bischof Farthing in Stormwind Jitters\' vollständiges Tagebuch.‡스톰윈드에 있는 주교 파딩에게 완성된 지터스의 일지를 보여 줘야 합니다.‡Entrega el diario completo de Alterio al obispo Lontananza de Ventormenta.‡Entrega el diario completo de Alterio al obispo Lontananza de Ventormenta.‡Donner le journal complété de la Tremblotte à l\'évêque Farthing à Stormwind.‡把基特斯的日记交给暴风城的主教法席恩。‡把基特斯的日記交給暴風城的主教法席恩。',
  }
},
[270] = {
  {
    'A esquadra naufragada‡Обреченный флот‡Die verlorene Flotte‡저주받은 함대‡La flota maldita‡La flota maldita‡La Flotte perdue‡被诅咒的舰队‡被詛咒的艦隊',
    nil,
    'Vá até o Porto de Menethil, no Pantanal, e fale com Glorin Testaço.‡Отправляйтесь в Гавань Менетилов в Болотине и поговорите с дворфом по имени Глорин Стальной Лоб.‡Geht zum Hafen von Menethil im Sumpfland und sprecht mit Glorin Steelbrow.‡저습지에 있는 메네실 항구로 가서 글로린 스틸브로우와 대화해야 합니다.‡Vete al Puerto de Menethil en Los Humedales y habla con Glorin Frenteacerada.‡Vete al Puerto de Menethil en Los Humedales y habla con Glorin Frenteacerada.‡Aller au port de Menethil, dans les Paluns, et parler à Glorin Steelbrow.‡到湿地的米奈希尔港去，找戈罗林·钢眉谈一谈。‡到濕地的米奈希爾港去，找戈羅林·鋼眉談壹談。',
  }
},
[271] = {
  {
    'A vingança de Vyrin‡Месть Вайрины‡Vyrins Rache‡바이린의 복수‡La venganza de Vyrin‡La venganza de Vyrin‡La vengeance de Vyrin‡维林的报复‡維林的報復',
    nil,
    'Mate o Velho Fumaça e mostre sua proeza a Dário, o Novato, no Pavilhão dos Andarilhos.‡Убейте Старину Черношкура и принесите его голову Дэрилу Юному в Приюте странников.‡Tötet Old Sooty und zeigt Daryl dem Jüngling in der Weitschreiter-Lodge dann Euer Werk.‡늙은곰 수티를 처치하고 그 결과를 순찰자의 오두막에 있는 풋내기 다릴에게 보여 주어야 합니다.‡Mata al viejo Tiznado y llévale una prueba a Daryl el Jovenzuelo en la Cabaña del Errante.‡Mata al viejo Tiznado y llévale una prueba a Daryl el Jovenzuelo en la Cabaña del Errante.‡Tuer le Vieux Noiraud puis montrer le résultat à Daryl le Blanc-bec au pavillon des pérégrins.‡杀掉奥尔苏迪，把它的头颅带给旅行者营地里的达瑞尔。‡殺掉奧爾蘇迪，把它的頭顱帶給旅行者營地裏的達瑞爾。',
  }
},
[272] = {
  {
    'Missão do leão marinho‡Испытание Морского Льва‡Prüfung des Seelöwen‡바다표범의 시험‡La prueba del león marino‡La prueba del león marino‡L\'épreuve du lion de mer‡海狮试炼‡海獅試煉',
    nil,
    'Encontre o Meio-pingente da Agilidade Aquática e o Meio-pingente da Resistência Aquática. Fale com os residentes da Clareira da Lua para obter pistas de onde esse itens podem estar.|nForme o Pingente do Leão Marinho a partir das duas metades. Você precisa estar perto do Santuário de Remulos para fazer isso.|nLeve o pingente reunido ao Dendrite Stellardor na vila de Refúgio Noturno, que fica na Clareira da Lua.‡Найдите половинку подвески Ловкости водяного облика и половинку подвески Выносливости водяного облика. Поговорите с жителями Лунной поляны, чтобы узнать, где могут находиться эти предметы.|nСложите из половинок подвеску Морского Льва. Для этого вам надо находиться рядом со святилищем Ремулоса.|nОтнесите собранную подвеску Дендриту Блеску Звезд в деревню Ночная Гавань, что на Лунной поляне.‡Sucht die Anhängerhälfte der Wasserbeweglichkeit und die Anhängerhälfte der Wasserausdauer. Sprecht mit den Einwohnern von Moonglade, um Hinweise darauf zu erhalten, wo sich diese Gegenstände befinden könnten.|nFormt den Anhänger des Seelöwen aus den beiden Anhängerhälften. Ihr müsst in der unmittelbaren Nähe des Schreins von Remulos sein, um dies zu tun.|nBringt den zusammengefügten Anhänger zu Dendrite Starblaze nach Nighthaven in Moonglade.‡민첩성의 바다 펜던트 반쪽과 인내의 바다 펜던트 반쪽을 찾아야 합니다. 달의 숲 주민들에게서 이 물건들이 있을 만한 위치에 대한 단서를 얻으십시오.|n두 개의 반쪽을 찾아 바다표범의 펜던트를 만들어야 합니다. 반드시 레물로스의 제단 근처로 와야만 하나로 합칠 수 있습니다.|n완성된 바다표범의 펜던트를 달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 가져가십시오.‡Busca el colgante de Agilidad acuática y el colgante de Resistencia acuática. Habla con la gente de Claro de la Luna para conseguir pistas sobre la ubicación de los colgantes.|nForma el colgante del león marino con los otros dos cuando estés cerca del Santuario de Remulos.|nLleva el colgante completo a Dendrite Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Busca el colgante de Agilidad acuática y el colgante de Resistencia acuática. Habla con la gente de Claro de la Luna para conseguir pistas sobre la ubicación de los colgantes.|nForma el colgante del león marino con los otros dos cuando estés cerca del Santuario de Remulos.|nLleva el colgante completo a Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Trouver le Demi-pendentif d\'agilité aquatique et le Demi-pendentif d\'endurance aquatique. Parler aux habitants de Reflet-de-Lune pour obtenir des indices quant à l’endroit où ces objets se trouvent.|nReformer le Pendentif du lion de mer à partir des deux moitiés. Vous devez vous trouver à proximité du sanctuaire de Remulos pour faire ceci.|nApporter le Pendentif reformé à Dendrite Starblaze, au village de Havrenuit, à Reflet-de-Lune.‡寻找水兽耐力坠饰和水兽敏捷坠饰。与月光林地的居民谈一谈，找出这些东西可能被放在哪里。|n在雷姆洛斯神殿附近将海狮坠饰的两部分合而为一。|n将合并好的坠饰交给月光林地永夜港中的德迪利特·星焰。‡尋找水獸耐力墜飾和水獸敏捷墜飾。與月光林地的居民談壹談，找出這些東西可能被放在哪裏。|n在雷姆洛斯神殿附近將海獅墜飾的兩部分合而為壹。|n將合並好的墜飾交給月光林地永夜港中的德迪利特·星焰。',
  }
},
[273] = {
  {
    'Suprimentos para o sítio‡Снабжение экспедиции‡Nachschub für die Ausgrabungsstätte‡물자 공급 재개‡Aprovisionar la excavación‡Aprovisionar la excavación‡Approvisionnement du site de fouilles‡挖掘场的补给品‡挖掘場的補給品',
    nil,
    'Fale com Huldar‡Поговорите с Хальдаром.‡Sprecht mit Huldar.‡훌다르와 대화하십시오.‡Habla con Huldar.‡Habla con Huldar.‡Aller voir Huldar.‡和胡达尔谈一谈。‡和胡達爾談壹談。',
  }
},
[274] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'Ashlan Risadura quer que você fale novamente com o Engenheiro-chefe Vedaçude e avise-o sobre a nova descoberta.‡Сообщите главному инженеру Камнехмылу о нейтрализующем коллоиде.‡Ashlan Stonesmirk möchte, dass Ihr zum Chefingenieur Hinderweir zurückkehrt und ihn von der neuen Entdeckung in Kenntnis setzt.‡애실런 스톤스머크가 선임기술자 힌더바이르에게 돌아가 새로 발견한 사실을 알려 줄 것을 부탁했습니다.‡Ashlan Risapétrea quiere que regreses con el ingeniero jefe Hinderweir y le informes sobre el nuevo descubrimiento.‡Ashlan Risapétrea quiere que regreses con el ingeniero jefe Hinderweir y le informes sobre el nuevo descubrimiento.‡Sur ordre d\'Ashlan Stonesmirk, retourner voir l\'Ingénieur en chef Hinderweir pour l\'informer de la nouvelle découverte.‡阿什兰·暗石要你回去见主工程师辛德维尔七世，把有关这种炸药的新发现告诉他。‡阿什蘭·暗石要妳回去見主工程師辛德維爾七世，把有關這種炸藥的新發現告訴他。',
  }
},
[275] = {
  {
    'Pústulas na terra‡Нарывы на теле земли‡Schwärendes Land‡대지의 상처‡Ampollas en la tierra‡Ampollas en la tierra‡Fièvre sur le pays‡大地上的脓疱‡大地上的膿皰',
    nil,
    'Mate 12 Rastejantes do Pântano, depois fale novamente com Rethiel, o Verdião no Pantanal.‡Убейте 12 трясинных ползунов и вернитесь к Ретилю Стражу Природы в Болотину.‡Tötet 12 Moorkrabbler und kehrt dann zu Rethiel dem Sumpfhüter im Sumpfland zurück.‡수렁이끼괴물 12마리를 처치한 다음 저습지에 있는 신록의수호자 레시엘에게 돌아가야 합니다.‡Mata 12 Trepadores del cubil y regresa con Rethiel el Guardaverde en Los Humedales.‡Mata a 12 trepadores del pantano y regresa con Rethiel el Guardaverde en Los Humedales.‡Tuer 12 Rampants des tourbières, puis retourner voir Rethiel, le Gouverneur vert, dans les Paluns.‡杀死12只沼泽爬行者，然后向湿地的绿色守卫者雷希耶尔复命。‡殺死12只沼澤爬行者，然後向濕地的綠色守衛者雷希耶爾復命。',
  }
},
[276] = {
  {
    'Patas pisoteantes‡Вытоптанные луга‡Stapfende Pfoten‡파괴의 손길‡Patas sucias‡Patas sucias‡Piétinements de pattes‡践踏之爪‡踐踏之爪',
    nil,
    'Mate 15 Gnolls Pelemusgo e 10 Mestiços Pelemusgo, depois fale novamente com Rethiel, o Verdião no Pantanal.‡Убейте 15 гноллов из стаи Мохошкуров и 10 полукровок из стаи Мохошкуров. Вернитесь к Ретилю Стражу Природы в Болотину.‡Tötet 15 Gnolle der Moosfelle sowie 10 Bastarde der Moosfelle und kehrt dann zu Rethiel dem Sumpfhüter im Sumpfland zurück.‡이끼가죽 놀 15마리와 이끼가죽일족 싸움꾼 10마리를 처치한 다음 저습지에 있는 신록의수호자 레시엘에게 돌아가야 합니다.‡Mata 15 gnolls Pellejomusgo y 10 bastardos Pellejomusgo y regresa con Rethiel el Guardaverde en Los Humedales.‡Mata 15 gnolls Pellejomusgo y 10 bastardos Pellejomusgo y regresa con Rethiel el Guardaverde en Los Humedales.‡Tuer 15 Gnolls Poils-moussus et 10 Bâtards Poils-moussus puis retourner voir Rethiel, le Gouverneur vert, dans les Paluns.‡杀死15名藓皮豺狼人和10名混血藓皮豺狼人，然后向湿地的绿色守卫者雷希耶尔复命。‡殺死15名蘚皮豺狼人和10名混血蘚皮豺狼人，然後向濕地的綠色守衛者雷希耶爾復命。',
  }
},
[277] = {
  {
    'Tabu do fogo‡Запрет на огонь‡Feuer-Tabu‡화재 예방‡No al fuego‡No al fuego‡Feu interdit‡火焰管制‡火焰管制',
    nil,
    'Leve 9 Pederneiras Grotescas para Rethiel, o Verdião.‡Принесите Ретилю Стражу Природы 9 необработанных кремней.‡Bringt Rethiel dem Sumpfhüter 9 kunstlose Feuersteine.‡신록의수호자 레시엘에게 조잡한 부싯돌 9개를 가져가야 합니다.‡Lleva 9 pedernales primitivos a Rethiel el Guardaverde.‡Lleva 9 sílex rudimentarios a Rethiel el Guardaverde.‡Rapporter à Rethiel, le Gouverneur vert, 9 Silex bruts.‡给绿色守卫者雷希耶尔带回9块粗制打火石。‡給綠色守衛者雷希耶爾帶回9塊粗制打火石。',
  }
},
[278] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'O Engenheiro-chefe Vedaçude quer que você colete Peçonha de Tocaieiro, um Cristal Mo\'grosh e uma Lágrima de Crocolisco.‡Принесите паучий яд, мо\'грошский кристалл и слезу кроколиска главному инженеру Плотине.‡Chefingenieur Hinderweir möchte, dass Ihr Lauerergift, einen Kristall der Mo\'grosh und eine Krokiliskenträne besorgt.‡선임기술자 힌더바이르가 럴커의 독액, 모그로쉬 수정, 악어 눈물을 모아 달라고 부탁했습니다.‡El ingeniero jefe Hinderweir quiere que le lleves veneno de rondador, 1 cristal de Mo\'grosh y 1 lágrima de crocolisco.‡El ingeniero jefe Hinderweir quiere que recojas veneno de rondador, un cristal Mo\'grosh y una lágrima de crocolisco.‡Collecter du Venin de rôdeuse, un Cristal Mo\'grosh et une Larme de crocilisque pour l\'Ingénieur en chef Hinderweir.‡主工程师辛德维尔七世要你收集一份潜伏者的毒液，一块莫格罗什水晶和一滴鳄鱼的眼泪。‡主工程師辛德維爾七世要妳收集壹份潛伏者的毒液，壹塊莫格羅什水晶和壹滴鱷魚的眼淚。',
  }
},
[279] = {
  {
    'Garras das profundezas‡Угроза из глубин‡Klauen aus der Tiefe‡멀록과 고블러‡Zarpas de las profundidades‡Zarpas de las profundidades‡Griffes des profondeurs‡海中的鱼人‡海中的魚人',
    nil,
    'Mate 12 Murlocs Guelrazul.|nMate o Comilão e pegue a cabeça dele.|nLeve a Cabeça de Comilão para Carlos Borba no Porto de Menethil.‡Убейте 12 мурлоков из племени Синежабрых.|nПрикончите Жруна и принесите его голову Карлу Борану в Гавань Менетилов.‡Tötet 12 Murlocs der Blaukiemen.|nErschlagt Gobbler und nehmt Euch seinen Kopf.|nBringt Gobblers Kopf zu Karl Boran in den Hafen von Menethil‡푸른아가미멀록 12마리와 고블러를 처치하고 그 머리를 손에 넣어야 합니다.|n메네실 항구의 칼 보란에게 고블러의 머리를 가져가야 합니다.‡Mata a 12 murlocs Branquiazul.|nMata a Engullidor y coge su cabeza.|nLleva la cabeza de Engullidor a Karl Boran en Puerto de Menethil.‡Mata a 12 múrlocs Branquiazul.|nMata a Engullidor y coge su cabeza.|nLleva la cabeza de Engullidor a Karl Boran en Puerto de Menethil.‡Tuer 12 murlocs Branchies-bleues.|nTuer Enfourneur et prendre sa tête.|nL\'apporter à Karl Boran au port de Menethil.‡杀掉12个蓝腮鱼人。|n杀掉高布勒尔并砍下它的头。|n将高布勒尔的头颅交给米奈希尔港的卡尔·波兰。‡殺掉12個藍腮魚人。|n殺掉高布勒爾並砍下它的頭。|n將高布勒爾的頭顱交給米奈希爾港的卡爾·波蘭。',
  }
},
[280] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'O Engenheiro-chefe Vedaçude quer que você nade até a base da represa, localize o barril de pólvora e espalhe a Mistura de Desarme para evitar uma explosão.‡Проплывите по реке к основанию дамбы, отыщите бочку с порохом и влейте в нее нейтрализующую смесь, чтобы предотвратить взрыв.‡Chefingenieur Hinderweir will, dass Ihr zum Fuß des Dammes hinunterschwimmt, das Pulverfässchen ausfindig macht und die Entschärfungsmixtur hineinrührt, um eine Explosion zu verhindern.‡선임기술자 힌더바이르가 댐 밑바닥으로 헤엄쳐 가서 화약통에 중화제를 넣어 섞어 달라고 부탁했습니다.‡El ingeniero jefe Hinderweir quiere que nades hasta la base de la presa, localices el barril de pólvora y disuelvas en él la mezcla neutralizadora para evitar que explote.‡El ingeniero jefe Hinderweir quiere que nades hasta la base de la presa, localices el barril de pólvora y disuelvas en él la mezcla neutralizadora para evitar que explote.‡Sur ordre de l\'Ingénieur en chef Hinderweir, nager jusqu\'à la base du barrage pour localiser le tonnelet de poudre et y verser la mixture de désamorçage pour empêcher une explosion.‡主工程师辛德维尔七世要你游到水坝底部，找到装着炸药的木桶，然后把拆弹剂放进去，阻止将要发生的爆炸。‡主工程師辛德維爾七世要妳遊到水壩底部，找到裝著炸藥的木桶，然後把拆彈劑放進去，阻止將要發生的爆炸。',
  }
},
[281] = {
  {
    'O que é nosso de direito‡Украденные товары‡Waren-Wiederbeschaffung‡뱃짐 되찾기‡Recuperación de bienes‡Recuperación de bienes‡Récupération de marchandises‡夺回雕像‡奪回雕像',
    nil,
    'Vasculhe os caixotes e barris nos acampamentos dos murlocs na costa.‡Обыщите сундуки, бочки и ящики в поселениях мурлоков на побережье.‡Durchsucht die Kisten und Fässer in den Murloclagern an der Küste.‡해안가의 멀록 소굴에서 상자와 통을 찾아 열어봐야 합니다.‡Busca los cajones y barriles en los campamentos múrloc de la costa.‡Busca los cajones y barriles en los campamentos múrloc de la costa.‡Rechercher les caisses et les barils dans les camps murlocs le long de la côte.‡搜索海边鱼人村落中的木箱和木桶。‡搜索海邊魚人村落中的木箱和木桶。',
  }
},
[282] = {
  {
    'Observações de Senir‡Наблюдения Сенира‡Senirs Beobachtungen‡그렐린의 보고서‡Las observaciones de Senir‡Las observaciones de Senir‡Les observations de Senir‡森内尔的观察站‡森內爾的觀察站',
    nil,
    'Fale com o Montanhista Thalos.‡Поговорите с горным пехотинцем Талосом.‡Sprecht mit Gebirgsjäger Thalos.‡산악경비대 탈로스와 얘기를 나누십시오.‡Habla con el montaraz Thalos.‡Habla con el montaraz Thalos.‡Aller voir le Montagnard Thalos.‡和巡山人萨鲁斯谈一谈。‡和巡山人薩魯斯談壹談。',
  }
},
[283] = {
  {
    'Uma ameaça sombria à espreita‡Прямая и черная угроза‡Eine dunkle Bedrohung‡어둠의 전조‡Se aproxima una oscura amenaza‡Se aproxima una oscura amenaza‡Une sombre menace se dessine‡水坝危机‡水壩危機',
    nil,
    'A Mistura de Desarme parece ter surtido efeito. Fale novamente com o Engenheiro-chefe Vedaçude para dar a boa notícia.‡Кажется, нейтрализующая смесь сработала. Вернитесь к главному инженеру Плотине – принесите ему добрые вести.‡Die Entschärfungsmixtur scheint gewirkt zu haben. Kehrt zu Chefingenieur Hinderweir zurück und berichtet ihm die guten Neuigkeiten.‡중화제의 효과가 나타나는 것 같습니다. 선임기술자 힌더바이르에게 돌아가 이 기쁜 소식을 알려 주십시오.‡Parece que la mezcla neutralizadora funciona. Ve a darle la buena noticia al ingeniero jefe Hinderweir.‡Parece que la mezcla neutralizadora funciona. Ve a darle la buena noticia al ingeniero jefe Hinderweir.‡La Mixture de désamorçage semble avoir fonctionné. Retourner voir l\'Ingénieur en chef Hinderweir pour lui annoncer la bonne nouvelle.‡拆弹剂看来已经产生了效果。你可以回去向主工程师辛德维尔七世汇报这个好消息了。‡拆彈劑看來已經產生了效果。妳可以回去向主工程師辛德維爾七世匯報這個好消息了。',
  }
},
[284] = {
  {
    'A busca continua‡Поиски продолжаются‡Die Suche geht weiter‡계속되는 수색‡La búsqueda continúa‡La búsqueda continúa‡La recherche continue‡继续搜寻‡繼續搜尋',
    nil,
    'Procure a Estatueta de Menethil.‡Найдите статуэтку Менетила.‡Sucht nach der Menethil-Statuette.‡메네실 조각상을 찾아야 합니다.‡Busca la Estatuilla de Menethil.‡Busca la Estatuilla de Menethil.‡Rechercher la Statuette de Menethil.‡搜索米奈希尔雕塑。‡搜索米奈希爾雕塑。',
  }
},
[285] = {
  {
    'Vasculhe mais cabanas‡Поиски в поселениях мурлоков‡Suche in weiteren Hütten‡다른 소굴 수색‡Inspecciona más casuchas‡Inspecciona más casuchas‡À la recherche d\'autres taudis‡搜寻雕像‡搜尋雕像',
    nil,
    'Continue vasculhando as cabanas dos Murlocs em busca da Estatueta de Menethil.‡Продолжите поиски статуэтки Менетила в поселении мурлоков.‡Sucht weiter in den Hütten der Murlocs nach der Menethil-Statuette.‡멀록 소굴에서 메네실 조각상을 계속 찾아봐야 합니다.‡Sigue buscando la Estatuilla de Menethil en las casuchas de los murlocs.‡Sigue buscando la Estatuilla de Menethil en las casuchas de los múrlocs.‡Continuer à fouiller les taudis des murlocs pour retrouver la Statuette de Menethil.‡继续在鱼人村落中搜寻米奈希尔雕像的踪迹。‡繼續在魚人村落中搜尋米奈希爾雕像的蹤跡。',
  }
},
[286] = {
  {
    'Devolva a estatueta‡Возвращение статуэтки‡Rückgabe der Statuette‡조각상 돌려주기‡Devuelve la Estatuilla‡Devuelve la Estatuilla‡Rapporter la statuette‡归还雕像‡歸還雕像',
    nil,
    'Entregue a Estatueta de Menethil para Carlos Borba.‡Верните статуэтку Менетила Карлу Борану.‡Bringt Karl Boran die Menethil-Statuette.‡칼 보란에게 메네실 조각상을 가져가야 합니다.‡Lleva la Estatuilla de Menethil a Karl Boran.‡Llevále la estatuilla de Menethil a Karl Boran.‡Apporter la Statuette de Menethil à Karl Boran.‡将米奈希尔雕像还给卡尔·波兰。‡將米奈希爾雕像還給卡爾·波蘭。',
  }
},
[287] = {
  {
    'A Fortaleza Jubafria‡Форт Мерзлогривов‡Höhle der Frostmane‡서리갈기 소굴‡Poblado Peloescarcha‡Poblado Peloescarcha‡Le repaire des Frostmane‡霜鬃巨魔要塞‡霜鬃巨魔要塞',
    nil,
    'Percorra a Fortaleza Jubafria e mate 5 Caçadores de Cabeças Jubafria a pedido de Senir Barbabranca em Kharanos.‡Обследуйте форт Мерзлогривов и убейте 5 охотников за головами из племени Мерзлогривов по просьбе Сенира Белоборода из Караноса.‡Erforscht die Höhle der Frostmane und tötet 5 Kopfjäger der Frostmane für Senir Whitebeard in Kharanos.‡서리갈기 소굴을 찾아 서리갈기부족 인간사냥꾼 5마리를 처치한 후 카라노스에 있는 세니르 화이트비어드에게 돌아와야 합니다.‡Explora el Poblado Peloescarcha y mata a 5 rebanacabezas Peloescarcha para Senir Barbablanca de Kharanos.‡Explora el Poblado Peloescarcha y mata a 5 rebanacabezas Peloescarcha para Senir Barbablanca de Kharanos.‡Explorer le repaire des Frostmane et tuer 5 Chasseurs de tête Frostmane pour Senir Whitebeard à Kharanos.‡侦查霜鬃巨魔要塞，替卡拉诺斯的森内尔·白须杀掉5个霜鬃猎头者。‡偵查霜鬃巨魔要塞，替卡拉諾斯的森內爾·白須殺掉5個霜鬃獵頭者。',
  }
},
[288] = {
  {
    'A terceira frota‡Третья флотилия‡Die Dritte Flotte‡제 3함대‡La Tercera Flota‡La Tercera Flota‡La IIIe flotte‡第三舰队‡第三艦隊',
    nil,
    'Compre uma Jarra de Hidromel para o Primeiro Oficial Simonez.‡Купите первому помощнику Фитсиммонсу кружку медовухи.‡Spendiert dem ersten Maat Fitzsimmons einen Krug Met.‡일등항해사 피츠시몬즈에게 벌꿀술을 한 병 사 줘야 합니다.‡Compra un cántaro de hidromiel para el primer oficial Fistimos.‡Compra un cántaro de hidromiel para el contramaestre Fistimos.‡Acheter une Cruche d\'hydromel pour le Premier Officier Fitzsimmons.‡为大副菲兹莫斯买一份壶装蜜酒。‡為大副菲茲莫斯買壹份壺裝蜜酒。',
  }
},
[289] = {
  {
    'A tripulação amaldiçoada‡Проклятая команда‡Die verfluchte Crew‡저주받은 선원‡La tripulación maldita‡La tripulación maldita‡L\'équipage maudit‡被诅咒的船员‡被詛咒的船員',
    nil,
    'Mate 13 Marinheiros Amaldiçoados, 5 Fuzileiros Amaldiçoados e o Primeiro Oficial Expedito. Leve a Caixa de Rapé do Expedito para o Primeiro Oficial Simonez no Porto de Menethil.‡Убейте 13 проклятых матросов, 5 проклятых стражей бухты и первого помощника Снеллига. Принесите табакерку Снеллига первому помощнику Фитсиммонсу в Гавань Менетилов.‡Vernichtet 13 verfluchte Seeleute, 5 verfluchte Matrosen und den ersten Maat Snellig. Bringt Snelligs Schnupftabakdose zum ersten Maat Fitzsimmons im Hafen von Menethil.‡저주받은 선원 13명, 저주받은 해병 5명, 그리고 일등항해사 스넬리그를 처치해야 합니다. 메네실 항구에 있는 일등항해사 피츠시몬즈에게 스넬리그의 연초상자를 가져가야 합니다.‡Mata 13 marineros malditos, 5 marinos malditos y al primer oficial Esnelim. Lleva la caja de tabaco de Enelim al primer oficial Fistimos en Puerto de Menethil.‡Mata 13 marineros malditos, 5 marinos malditos y al contramaestre Snellig. Lleva la tabaquera de Snellig al contramaestre Fistimos en Puerto de Menethil.‡Tuer 13 Marins maudits, 5 Soldats de marine maudits et le Premier Officier Snellig. Rapporter la Tabatière de Snellig au Premier Officier Fitzsimmons au port de Menethil.‡杀死13个被诅咒的水手、5个被诅咒的水兵和大副斯涅利格。把斯涅利格的鼻烟盒交给米奈希尔的大副菲兹莫斯。‡殺死13個被詛咒的水手、5個被詛咒的水兵和大副斯涅利格。把斯涅利格的鼻煙盒交給米奈希爾的大副菲茲莫斯。',
  }
},
[290] = {
  {
    'O fim da maldição‡Очищение‡Brechen des Fluchs‡저주 풀기‡Purga de la maldición‡Purga de la maldición‡Levée de la malédiction‡解除诅咒‡解除詛咒',
    nil,
    'Obtenha a Chave do Cofre do Intrépido do Capitão Halyndor.|nUse a chave para abrir o Cofre Trancado do Intrépido.‡Возьмите ключ от сейфа на "Отважном" у капитана Халиндора.|nОткройте сейф на "Отважном".‡Besorgt den Geldkassettenschlüssel der INTREPID von Kapitän Halyndor.|nVerwendet den Schlüssel, um die Geldkassette der INTREPID zu öffnen.‡할린도르 선장을 처치한 후 인트레피드호의 금고 열쇠를 손에 넣어야 합니다.|n그 열쇠를 사용하여 인트레피드호의 잠긴 금고를 열어야 합니다.‡Obtén la caja de la caja fuerte de El intrépido del capitán Halyndor.|nUtiliza la llave para abrir la caja fuerte de El intrépido.‡Obtén la llave de la caja fuerte de El Intrépido del capitán Halyndor.|nUtiliza la llave para abrir la caja fuerte de El Intrépido.‡Obtenir du capitaine Halyndor la Clé du coffre-fort de "l\'Intrépide".|nUtiliser la clé pour ouvrir le Coffre verrouillé de l\'Intrépide.‡从哈林多尔船长那里拿到无畏号的保险箱钥匙。|n用钥匙打开无畏号上的保险箱。‡從哈林多爾船長那裏拿到無畏號的保險箱鑰匙。|n用鑰匙打開無畏號上的保險箱。',
  }
},
[291] = {
  {
    'Os relatórios‡Донесения‡Die Berichte‡보고‡Los informes‡Los informes‡Les rapports‡森内尔的报告‡森內爾的報告',
    nil,
    'Entregue o relatório de Senir ao Senador Barin Itarrubra em Altaforja.‡Отнесите донесение Сенира сенатору Бэрину Краснокамню в Стальгорн.‡Überbringt Senator Barin Redstone in Ironforge Senirs Bericht.‡아이언포지에 있는 원로원의원 바린 레드스톤에게 세니르의 보고서를 전달해야 합니다.‡Entrega el informe de Senir al senador Barin Rocarroja de Forjaz.‡Entrega el informe de Senir al senador Barin Rocarroja de Forjaz.‡Livrer le rapport de Senir au Sénateur Barin Redstone à Ironforge.‡把森内尔的报告交给铁炉堡的参议员巴林·红石。‡把森內爾的報告交給鐵爐堡的參議員巴林·紅石。',
  }
},
[292] = {
  {
    'Olho de Paleth‡Око Палета‡Das Auge von Paleth‡팔레스의 눈‡El ojo de Paleth‡El ojo de Paleth‡L\'Oeil de Paleth‡帕雷斯之眼‡帕雷斯之眼',
    nil,
    'Leve o Olho Maldito de Paleth para Glorin Testaço.‡Отнесите проклятое Око Палета Глорину Стальному Лбу.‡Bringt Glorin Steelbrow das verfluchte Auge von Paleth.‡글로린 스틸브로우에게 팔레스의 저주받은 눈을 가져가야 합니다.‡Lleva el Ojo maldito de Paleth a Glorin Frenteacerada.‡Llévale el ojo maldito de Paleth a Glorin Frenteacerada.‡Apporter l\'Oeil maudit de Paleth à Glorin Steelbrow.‡把被诅咒的帕雷斯之眼交给戈罗林·钢眉。‡把被詛咒的帕雷斯之眼交給戈羅林·鋼眉。',
  }
},
[293] = {
  {
    'A purificação do olho‡Проклятое Око‡Die Reinigung des Auges‡팔레스의 눈 정화‡Limpieza del ojo‡Limpieza del ojo‡Purifier l\'Oeil‡净化帕雷斯之眼‡凈化帕雷斯之眼',
    nil,
    'Leve o Olho Maldito de Paleth para o Arcebispo Benedictus. Benedictus se encontra na Catedral da Luz, na cidade de Ventobravo.‡Отнесите Око Палета архиепископу Бенедикту. Его можно найти в Соборе Света в Штормграде.‡Bringt Erzbischof Benedictus das verfluchte Auge von Paleth. Ihr findet Benedictus in der Kathedrale des Lichts, in der Stadt Stormwind.‡대주교 베네딕투스에게 팔레스의 저주받은 눈을 가져가야 합니다. 베네딕투스는 스톰윈드의 빛의 대성당에 있습니다.‡Lleva el Ojo maldito de Paleth al arzobispo Benedictus. Benedictus se encuentra en la Catedral de la Luz, en la ciudad de Ventormenta.‡Lleva el Ojo maldito de Paleth al arzobispo Benedictus. Benedictus se encuentra en la Catedral de la Luz, en la ciudad de Ventormenta.‡Apporter l\'Oeil maudit de Paleth à l\'archevêque Benedictus, à la cathédrale de la Lumière de la ville de Stormwind.‡把被诅咒的帕雷斯之眼交给大主教本尼迪塔斯，他就在暴风城的光明大教堂里。‡把被詛咒的帕雷斯之眼交給大主教本尼迪塔斯，他就在暴風城的光明大教堂裏。',
  }
},
[294] = {
  {
    'A revanche de Ormer‡Месть Ормера‡Ormers Rache‡오머의 복수‡La venganza de Ormer‡La venganza de Ormer‡La vengeance d\'Ormer‡奥莫尔的复仇‡奧莫爾的復仇',
    nil,
    'Ormer Trançaferro, no Sítio de Escavação Whelgar, quer que você mate 10 Guinchadores Mosqueados e 10 Raptores Mosqueados.‡Убейте 10 крапчатых ящеров и 10 крапчатых крикунов.‡Ormer Ironbraid von der Whelgars Ausgrabungsstätte möchte, dass Ihr 10 scheckige Kreischer und 10 scheckige Raptoren tötet.‡웰가르의 발굴현장에 있는 오머 아이언브레이드가 긴송곳니 줄무늬랩터 10마리와 줄무늬랩터 10마리를 처치해 달라고 부탁했습니다.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates 10 estridadores jaspeados y 10 raptores jaspeados.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates 10 estridadores jaspeados y 10 raptores jaspeados.‡Sur ordre d\'Ormer Ironbraid à l\'Excavation de Whelgar, tuer 10 Hurleurs tachetés et 10 Raptors tachetés.‡维尔加挖掘场的奥莫尔·铁衣要求你杀死10只杂斑迅猛龙和10只杂斑尖啸龙。‡維爾加挖掘場的奧莫爾·鐵衣要求妳殺死10只雜斑迅猛龍和10只雜斑尖嘯龍。',
  }
},
[295] = {
  {
    'A revanche de Ormer‡Месть Ормера‡Ormers Rache‡오머의 복수‡La venganza de Ormer‡La venganza de Ormer‡La vengeance d\'Ormer‡奥莫尔的复仇‡奧莫爾的復仇',
    nil,
    'Ormer Trançaferro quer que você mate 10 Garrafoices Mosqueados e 10 Rasgaqueixos Mosqueados, depois fale novamente com ele no Sítio de Escavação Whelgar.‡Убейте 10 крапчатых смертехватов и 10 крапчатых острозубов. Вернитесь к Ормеру Сталеплету на раскоп Вельгара.‡Ormer Ironbraid möchte, dass Ihr 10 scheckige Sensenklauen- und 10 scheckige Scharfzahnraptoren tötet und dann zu ihm zu Whelgars Ausgrabungsstätte zurückkommt.‡웰가르의 발굴현장에 있는 오머 아이언브레이드가 갈퀴발톱 줄무늬랩터 10마리, 무쇠턱 줄무늬랩터 10마리를 처치해 달라고 부탁했습니다.‡Ormer Trenzaferro quiere que mates 10 raptores segadores jaspeados y 10 raptores tajobuches jaspeados y que vuelvas a verle en la Excavación de Whelgar.‡Ormer Trenzaferro quiere que mates 10 raptores segadores jaspeados y 10 raptores tajobuches jaspeados y que vuelvas a verle en la Excavación de Whelgar.‡Tuer 10 Faucheurs tachetés et 10 Tranchegueules tachetés pour Ormer Ironbraid, puis aller le voir à l\'excavation de Whelgar.‡奥莫尔·铁衣要求你杀死10只杂斑刺喉龙和10只杂斑锯齿龙，然后回到维尔加挖掘场向他复命。‡奧莫爾·鐵衣要求妳殺死10只雜斑刺喉龍和10只雜斑鋸齒龍，然後回到維爾加挖掘場向他復命。',
  }
},
[296] = {
  {
    'A revanche de Ormer‡Месть Ормера‡Ormers Rache‡오머의 복수‡La venganza de Ormer‡La venganza de Ormer‡La vengeance d\'Ormer‡奥莫尔的复仇‡奧莫爾的復仇',
    nil,
    'Ormer Trançaferro, no Sítio de Escavação Whelgar, quer que você mate o Sarilodonte e leve uma de suas garras até ele depois que tiver cumprido a tarefa.‡Убейте Зарлозуба и принесите Ормеру Сталеплету один из когтей чудовища.‡Ormer Ironbraid von der Whelgars Ausgrabungsstätte möchte, dass Ihr Sarlatan tötet und mit einer seiner Krallen zu ihm zurückkehrt, sobald Ihr die Aufgabe erledigt habt.‡웰가르의 발굴현장에 있는 오머 아이언브레이드가 살투스를 처치한 후 발톱을 가져다 달라고 부탁했습니다.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates a Sarldente y que le lleves una de sus garras cuando completes la tarea.‡Ormer Trenzaferro de la Excavación de Whelgar quiere que mates a Sarldente y que le lleves una de sus garfas cuando completes la tarea.‡Sur ordre d\'Ormer Ironbraid, de l\'Excavation de Whelgar, tuer Grondecroc et revenir avec l\'une de ses serres une fois la tâche accomplie.‡维尔加挖掘场的奥莫尔·铁衣要求你杀死萨尔图斯，并在任务完成之后带着它的一只爪子向他复命。‡維爾加挖掘場的奧莫爾·鐵衣要求妳殺死薩爾圖斯，並在任務完成之後帶著它的壹只爪子向他復命。',
  }
},
[297] = {
  {
    'Juntando ídolos‡Сбор идолов‡Götzen sammeln‡조각상 모으기‡Recoger ídolos‡Recoger ídolos‡Réunir les idoles‡收集石像‡收集石像',
    nil,
    'Leve 8 Ídolos Esculpidos em Pedra para Magmar Machadeiro.‡Принесите Магмару Рудоколу 8 резных каменных идолов.‡Bringt Magmar Fellhew 8 verzierte Steingötzen.‡마그마 펠휴에게 돌 조각상 8개를 가져가야 합니다.‡Lleva 8 ídolos de piedra tallada a Magmar Tallavil.‡Llévale 8 ídolos de piedra grabados a Magmar Ceñimal.‡Apporter 8 Idoles de pierre sculptée à Magmar Fellhew.‡收集8个小石像，把它们交给麦格玛尔·落斧。‡收集8個小石像，把它們交給麥格瑪爾·落斧。',
  }
},
[298] = {
  {
    'Relatório de progresso da escavação‡Отчет о ходе раскопок‡Bericht über den Fortschritt der Ausgrabungen‡발굴 상황 보고서‡Un informe sobre el avance de la excavación‡Un informe sobre el avance de la excavación‡Compte rendu d\'avancement des fouilles‡挖掘进度报告‡挖掘進度報告',
    nil,
    'Entregue o Relatório de Progresso de Bandaferro para Jern Elmocorno em Thelsamar.‡Отнесите отчет о ходе работ Джерну Шлеморогу в Телcамар.‡Bringt Ironbands Fortschrittsbericht zu Jern Hornhelm in Thelsamar.‡텔사마의 예른 혼헬름에게 아이언밴드의 상황 보고서를 가져가야 합니다.‡Lleva el informe de Vetaferro a Jern Cornamenta a Thelsamar.‡Lleva el informe de Vetaferro a Jern Cornamenta a Thelsamar.‡Apporter le Compte rendu d\'avancement d\'Ironband à Jern Hornhelm à Thelsamar.‡把铁环挖掘场的进度报告带给塞尔萨玛的吉恩·角盔。‡把鐵環挖掘場的進度報告帶給塞爾薩瑪的吉恩·角盔。',
  }
},
[299] = {
  {
    'Desvendando o passado‡Тайны прошлого‡Enthüllung der Vergangenheit‡드러난 과거‡Desvelando el pasado‡Desvelando el pasado‡Découverte du passé‡发现历史‡發現歷史',
    nil,
    'O Prospector Whelgar quer que você revire o sítio de escavação em busca dos 4 fragmentos perdidos da tabuleta: Ados, Modr, Golm e Neru.‡Обыщите раскопки и найдите четыре недостающих фрагмента скрижали: Адос, Модр, Голм и Неру. Принесите их геологу Вельгару.‡Ausgrabungsleiter Whelgar wünscht, dass Ihr die Ausgrabungsstätte nach den 4 fehlenden Tafel-Fragmenten durchkämmt, Ados, Modr, Golm und Neru.‡발굴조사단장 웰가르가 발굴현장을 정리하고 사라진 아도스 조각, 모드르 조각, 골름 조각, 네루 조각을 가져다 달라고 부탁했습니다.‡El prospector Whelgar quiere que te adentres en la excavación en busca de los 4 fragmentos de tablilla perdidos: Ados, Modr, Golm y Neru.‡El prospector Whelgar quiere que te adentres en la excavación en busca de los 4 fragmentos de tablilla perdidos: Ados, Modr, Golm y Neru.‡À la demande du prospecteur Whelgar, parcourir l\'Excavation à la recherche des 4 fragments de tablette : Ados, Modr, Golm et Neru.‡勘察员维尔加要求你在挖掘场中搜索4块石板的碎片，它们是阿度斯碎片、莫德尔碎片、高尔姆碎片和奈尔鲁碎片。‡勘察員維爾加要求妳在挖掘場中搜索4塊石板的碎片，它們是阿度斯碎片、莫德爾碎片、高爾姆碎片和奈爾魯碎片。',
  }
},
[301] = {
  {
    'Apresente-se a Altaforja‡Отчет в Стальгорн‡Meldung in Ironforge‡아이언포지에 보고‡Informe a Forjaz‡Informe a Forjaz‡Rapport à Ironforge‡向铁炉堡报告‡向鐵爐堡報告',
    nil,
    'Entregue o Relatório de Progresso de Bandaferro para o Prospector Lançatroz.‡Отнесите отчет Сталекрута о ходе работ геологу Грозовой Вершине.‡Bringt Ironbands Fortschrittsbericht zu Ausgrabungsleiter Stormpike.‡발굴조사단장 스톰파이크에게 아이언밴드의 상황 보고서를 가져가야 합니다.‡Lleva el informe de Vetaferro al prospector Pico Tormenta.‡Lleva el informe de Vetaferro al prospector Pico Tormenta.‡Porter le Compte rendu d\'avancement d\'Ironband au Prospecteur Stormpike.‡把铁环挖掘场的进度报告交给勘察员塔伯斯·雷矛。‡把鐵環挖掘場的進度報告交給勘察員塔伯斯·雷矛。',
  }
},
[302] = {
  {
    'Pólvora para Bandaferro‡Порох для Сталекрута‡Pulver für Ironband‡아이언밴드에게 화약 지원‡Pólvora para Vetaferro‡Pólvora para Vetaferro‡De l\'explosif pour Ironband‡铁环的火药‡鐵環的火藥',
    nil,
    'Fale com Jern Elmocorno em Thelsamar.‡Поговорите с Джерном Шлеморогом в Телcамаре.‡Sprecht in Thelsamar mit Jern Hornhelm.‡텔사마의 예른 혼헬름과 대화하십시오.‡Habla con Jern Cornamenta en Thelsamar.‡Habla con Jern Cornamenta en Thelsamar.‡Parler à Jern Hornhelm à Thelsamar.‡和塞尔萨玛的吉恩·角盔谈一谈。‡和塞爾薩瑪的吉恩·角盔談壹談。',
  }
},
[303] = {
  {
    'A guerra dos Ferro Negro‡Война с Черным Железом‡Der Dunkeleisenkrieg‡검은무쇠단과의 전투‡La guerra contra los Hierro Negro‡La guerra contra los Hierro Negro‡La guerre contre les Sombrefer‡黑铁战争‡黑鐵戰爭',
    nil,
    'Rocio Garmason, de Dun Modr, quer que você mate 15 Anões Ferro Negro, 5 Escavadores Ferro Negro, 5 Sabotadores Ferro Negro e 5 Demolidores Ferro Negro.‡Мотли Каменщик в Дун Модре просит вас убить 15 дворфов, 5 проходчиков, 5 саботажников и 5 подрывников из клана Черного Железа.‡Motley Garmason in Dun Modr möchte, dass Ihr 15 Dunkeleisenzwerge, 5 Tunnelgräber der Dunkeleisenzwerge, 5 Saboteure der Dunkeleisenzwerge und 5 Demolierer der Dunkeleisenzwerge tötet.‡던 모드르의 모틀리 가마슨이 검은무쇠단 드워프 15명, 검은무쇠단 채굴꾼 5명, 검은무쇠단 투사 5명, 검은무쇠단 폭파병 5명을 처치해 달라고 부탁했습니다.‡Motley Garmason de Dun Modr quiere que mates 15 enanos Hierro Negro, 5 tuneladores Hierro Negro, 5 saboteadores Hierro Negro y 5 demoledores Hierro Negro.‡Motley Garmason de Dun Modr quiere que mates 15 enanos Hierro Negro, 5 tuneladores Hierro Negro, 5 saboteadores Hierro Negro y 5 demoledores Hierro Negro.‡Sur ordre de Motley Garmason à Dun Modr, tuer 15 nains Sombrefer : 5 Tunneliers Sombrefer, 5 Saboteurs Sombrefer et 5 Démolisseurs Sombrefer.‡丹莫德的莫特雷·加玛森要求你杀死15名黑铁矮人、5名黑铁隧道工、5名黑铁破坏者和5名黑铁爆破手。‡丹莫德的莫特雷·加瑪森要求妳殺死15名黑鐵矮人、5名黑鐵隧道工、5名黑鐵破壞者和5名黑鐵爆破手。',
  }
},
[304] = {
  {
    'Uma tarefa cruel‡Мрачное поручение‡Eine grausige Aufgabe‡위험한 임무‡Una misión hedionda‡Una misión hedionda‡Une tâche sinistre‡艰巨的任务‡艱巨的任務',
    nil,
    'Mate Balgaras, o Asqueroso e leve a orelha dele para Trançalonga, o Austero, que está do lado de fora de Dun Modr.‡Убейте Балгараса Нечистого и принесите его ухо Гриму Длинной Косе в Дун Модр.‡Tötet Balgaras den Niederträchtigen und bringt Longbraid dem Grimmigen vor Dun Modr sein Ohr.‡불한당 발가라스를 처치하고 그의 귀걸이를 던 모드르 외곽에 있는 결의의 롱브레이드에게 가져가야 합니다.‡Mata a Balgaras el Hediondo y lleva su oreja a Largatrenza el Nefasto a las afueras de Dun Modr.‡Mata a Balgaras el Hediondo y lleva su oreja a Largatrenza el Nefasto a las afueras de Dun Modr.‡Tuer Balgaras le Crasseux et rapporter son oreille à Longbraid le Macabre à Dun Modr.‡杀死邪恶的巴尔加拉斯，把他的耳朵带给丹莫德外的布莱德·长须。‡殺死邪惡的巴爾加拉斯，把他的耳朵帶給丹莫德外的布萊德·長須。',
  }
},
[305] = {
  {
    'Em busca da equipe de escavação‡Пропавшие ученые‡Auf der Suche nach dem Ausgrabungstrupp‡발굴단을 찾아서‡La búsqueda del equipo de excavación‡La búsqueda del equipo de excavación‡À la recherche de l\'équipe de fouilles‡寻找挖掘队‡尋找挖掘隊',
    nil,
    'Tarrel Tecepedra quer que você viaje até o Sítio de Escavação e contate Marina Tecepedra.‡Таррел Камнепряд просит отыскать Меррин Камнепряд на раскопках.‡Tarrel Rockweaver möchte, dass Ihr zur Ausgrabungsstätte reist und dort Kontakt mit Merrin Rockweaver aufnehmt.‡타렐 록위버가 발굴 현장으로 가서 메린 록위버를 찾아 달라고 부탁했습니다.‡Tarrel Tejepiedra quiere que viajes a la Excavación y que contactes con Merrin Tejepiedra.‡Tarrel Tejepiedra quiere que viajes a la Excavación y que contactes con Merrin Tejepiedra.‡À la demande de Tarrel Rockweaver, aller jusqu\'à l\'Excavation et contacter Merrin Rockweaver.‡塔雷尔·石纹要求你到挖掘场里去找到麦琳·石纹。‡塔雷爾·石紋要求妳到挖掘場裏去找到麥琳·石紋。',
  }
},
[306] = {
  {
    'Em busca da equipe de escavação‡Пропавшие ученые‡Auf der Suche nach dem Ausgrabungstrupp‡발굴단을 찾아서‡La búsqueda del equipo de excavación‡La búsqueda del equipo de excavación‡À la recherche de l\'équipe de fouilles‡寻找挖掘队‡尋找挖掘隊',
    nil,
    'Leve o bilhete de Marina para Tarrel Tecepedra.‡Отнесите Таррелу Камнепряду записку от Меррин.‡Kehrt mit Merrins Nachricht zu Tarrel Rockweaver zurück.‡타렐 록위버에게 메린의 편지를 가져가야 합니다.‡Lleva a Tarrel Tejepiedra la nota de Merrin.‡Regresa con Tarrel Tejepiedra y entrégale la nota de Merrin.‡Retourner voir Tarrel Rockweaver avec la lettre de Merrin.‡把麦琳的信件交给塔雷尔·石纹复命。‡把麥琳的信件交給塔雷爾·石紋復命。',
  }
},
[307] = {
  {
    'Patas nojentas‡Грязные лапы‡Schmutzige Pfoten‡더러운 손‡Zarpas asquerosas‡Zarpas asquerosas‡Bas les pattes !‡肮脏的爪子‡骯臟的爪子',
    nil,
    'Vá até a Mina da Prata e recolha 4 cargas de Equipamento de Mineração.|nFale novamente com o Montanhista Lançatroz.‡Принесите из Рудника у Серебряного ручейка 4 ящика оборудования горному пехотинцу Грозовой Вершине.‡Geht zur Silberbachmine und sucht 4 Sätze Bergarbeiter-Ausstattung zusammen.|nKehrt dann zu Gebirgsjäger Stormpike zurück.‡은여울 광산에서 광부의 도구 4개를 모아야 합니다.|n그런 다음 산악경비대 스톰파이크에게 돌아가십시오.‡Ve a la Mina de Fuenteplata y recoge 4 cargas de equipamiento de minero.|nLuego ve a ver al montaraz Pico Tormenta.‡Dirígete a la Mina de Fuenteplata y recoge 4 cargas de equipamiento de minero.|nRegresa con el montaraz Pico Tormenta.‡Aller à la Mine du Ru d\'argent pour prendre 4 lots d\'Equipement de mineur.|nRetourner voir le Montagnard Stormpike.‡到银泉矿洞去收集4套矿工装备，然后向巡山人卡尔·雷矛复命。‡到銀泉礦洞去收集4套礦工裝備，然後向巡山人卡爾·雷矛復命。',
  }
},
[308] = {
  {
    'Distraindo Jarven‡Отвлечь Ярвена‡Jarvens Ablenkung‡맥주를 좋아하는 야벤‡Distraer a Jarven‡Distraer a Jarven‡Distraire Jarven‡加文的爱好‡加文的愛好',
    nil,
    nil,
  }
},
[309] = {
  {
    'Em defesa do carregamento‡Охрана груза‡Beschützen der Fracht‡화약 운반‡Proteger el envío‡Proteger el envío‡Protection de la cargaison‡护送货物‡護送貨物',
    nil,
    'Garanta que Miran e o carregamento cheguem ao sítio de escavação, depois informe ao Prospector Bandaferro.‡Убедитесь, что Миран и его груз добрались до раскопа, и сообщите об этом геологу Сталекруту.‡Stellt sicher, dass sowohl Miran als auch seine Warenlieferung sicher an der Ausgrabungsstätte ankommen und setzt dann Ausgrabungsleiter Ironband davon in Kenntnis.‡미란이 발굴 지역까지 무사히 도착할 수 있도록 경호하고 발굴조사단장 아이언밴드에게 가십시오.‡Asegúrate de que Miran y la pólvora llegan a la excavación y luego informa al prospector Vetaferro.‡Asegúrate de que Miran y el cargamento lleguen al sitio de excavación; luego infórmale al Prospector Vetaferro.‡S\'assurer que Miran et la cargaison parviennent au Site de fouilles puis en informer le Prospecteur Ironband.‡确保把米兰和货物送到挖掘场，然后通知勘察员基恩萨·铁环。‡確保把米蘭和貨物送到挖掘場，然後通知勘察員基恩薩·鐵環。',
  }
},
[310] = {
  {
    'A guerra das cervejas‡Злейшие соперники‡Bittere Rivalen‡숙명의 경쟁자‡Cerveza rivales‡Rivales acérrimos‡Bières rivales‡针锋相对‡針鋒相對',
    nil,
    'Troque um barril de Cerveja do Trovão por um barril de Grogue Cervevada no porão da Destilaria Cervaforte, que fica em Kharanos.‡Замените один бочонок громового эля бочонком жгучего пива Ячменоваров в подвале "Громоварки" в Караносе.‡Vertauscht im Keller der Brauerei Donnerbräu in Kharanos ein Fass Donnerbier mit einem Fass Gerstenbräu.‡카라노스에 있는 썬더브루 양조장의 지하실로 가서 썬더 에일 맥주통을 발리브루 스칼더 맥주통으로 바꿔 놓아야 합니다.‡Ve al sótano de la Destilería Cebatruenos de Kharanos y sustituye un barril de cerveza del Trueno con uno de brebaje de Cebadiz.‡Ve al sótano de la Destilería Cebatruenos de Kharanos y sustituye un barril de cerveza del Trueno con uno de brebaje de Cebadiz.‡Aller au sous-sol de la distillerie Thunderbrew à Kharanos et remplacer un Tonneau de Thunder Ale par un Tonneau de Barleybrew Scalder.‡到卡拉诺斯的雷酒酿造厂酒窖里去，把一桶雷霆啤酒换成热麦酒。‡到卡拉諾斯的雷酒釀造廠酒窖裏去，把壹桶雷霆啤酒換成熱麥酒。',
  }
},
[311] = {
  {
    'Fale novamente com Marleth‡Возвращение к Марлетте‡Rückkehr zu Marleth‡말레스에게 돌아가기‡Vuleve con Marleth‡Regresa junto a Marleth‡Retour chez Marleth‡向马莱斯回报‡向馬萊斯回報',
    nil,
    'Entregue o barril de Cerveja do Trovão para Marleth Cervevada na Aldeia da Cevada.‡Принесите бочонок громового эля Марлетте Ячменовар в Поселок Пивоваров.‡Bringt Marleth Gerstenbräu in Brewnall das Fass mit Donnerbier.‡브루날 마을에 있는 말레스 발리브루에게 썬더 에일 맥주통을 가져다주어야 합니다.‡Lleva el barril de cerveza del Trueno a Marleth Cebadiz a Las Birras.‡Lleva el barril de cerveza del Trueno a Marleth Cebadiz a Las Birras.‡Apporter le Tonneau de Thunder Ale à Marleth Barleybrew au Village de Brassetout.‡把雷霆麦酒交给烈酒村的马莱斯·麦酒。‡把雷霆麥酒交給烈酒村的馬萊斯·麥酒。',
  }
},
[312] = {
  {
    'Por baixo da carne-seca‡Ограбление тайника Тундры Макгранна‡Tundra MacGranns gestohlene Vorräte‡툰드라 맥그란의 고기 상자‡La reserva robada de Tundra MacGrann‡La reserva robada de Tundra MacGrann‡La réserve volée de Tundra MacGrann‡马克格拉恩的干肉‡馬克格拉恩的幹肉',
    nil,
    'Pegue de volta a carne-seca do Tundra MacGrann do armário de carnes roubado, na caverna do Velho Barbafria.‡Добудьте из пещеры Старого Ледоборода вяленое мясо из краденого ларя Тундры Макгранна.‡Holt Tundra MacGranns Trockenfleisch aus dem gestohlenen Fleisch-Spind in der Höhle von Eisbart dem Alten.‡늙은 얼음수염의 동굴에 있는 잃어버린 고기 상자에서 툰드라 맥그란의 말린 고기를 되찾아 와야 합니다.‡Ve a la cueva del Viejo Barbahielo y recupera la carne seca de Tundra MacGrann de la caja fuerte robada.‡Ve a la cueva del Viejo Barbahielo y recupera la carne seca de Tundra MacGrann de la caja fuerte robada.‡Récupérer la caisse de viande séchée de Tundra MacGrann dans la Caverne du Vieux Barbeglace.‡从冰须的洞穴里拿回装有马克格拉恩的干肉的储藏柜。‡從冰須的洞穴裏拿回裝有馬克格拉恩的幹肉的儲藏櫃。',
  }
},
[313] = {
  {
    'O Covil Cinzento‡Серая берлога‡Der altgediente Bau‡은빛 동굴‡El Cubil Pardo‡El Cubil Pardo‡L\'antre Gris‡灰色洞穴‡灰色洞穴',
    nil,
    'Colete 8 Crinas de Wendigo e leve-as para Piloto Marchapedra.‡Принесите 8 грив вендиго пилоту Камнекожцу.‡Sammelt 8 Wendigomähnen und bringt sie Pilot Stonegear.‡웬디고 갈기 8개를 모아 조종사 스톤기어에게 가져다주어야 합니다.‡Reúne 8 crines de wendigo y llévaselas al piloto Roscapiedra.‡Recoge 8 crines de wendigo y llévaselas al piloto Roscapiedra.‡Réunir 8 Peaux de Wendigo et les apporter au Pilote Stonegear.‡收集8束雪怪的鬃毛，把它们交给驾驶员迪恩·石轮。‡收集8束雪怪的鬃毛，把它們交給駕駛員迪恩·石輪。',
  }
},
[314] = {
  {
    'Amarre sua cabra pois Ragash está solto‡Защита стада‡Die Herde beschützen‡가축 보호‡La protección del rebaño‡La protección del rebaño‡Protection du troupeau‡保护牲畜‡保護牲畜',
    nil,
    'Rudra Ambarmanso quer que você mate Ragash e leve sua presa para ela no rancho dos carneiros.‡Убейте Вагаша и принесите его клык Рудре Янтарлен на Бараний выгон.‡Rudra Amberstill möchte, dass Ihr Vagash erschlagt und einen seiner Fangzähne zu ihr auf die Widder-Ranch bringt.‡루드라 앰버스틸이 바가쉬를 처치한 후 산양 농장으로 바가쉬의 송곳니를 가지고 오라고 부탁했습니다.‡Rudra Semperámbar quiere que mates a Vagash y le lleves su colmillo a la granja de carneros.‡Rudra Semperámbar quiere que mates a Vagash y le lleves su colmillo a la granja de carneros.‡Sur demande de Rudra Amberstill, tuer Vagash et rapporter un de ses crocs à la ferme des Amberstill.‡山羊农场的鲁德拉·冻石要你杀了瓦加什，并且把它的牙齿给她带回去。‡山羊農場的魯德拉·凍石要妳殺了瓦加什，並且把它的牙齒給她帶回去。',
  }
},
[315] = {
  {
    'Em busca da cerveja perfeita‡Всем портерам портер‡Das Perfekte Starkbier‡최고급 스타우트 맥주‡La cerveza perfecta‡La cerveza perfecta‡La bière parfaite‡完美烈酒‡完美烈酒',
    nil,
    'Entregue 6 ramos de Tremulerva para Rejold Cervevada na Aldeia da Cevada.‡Принесите 6 порций звездолиста Регольду Ячменовару из Поселка Пивоваров.‡Bringt Rejold Gerstenbräu in Brewnall 6 Schimmerkräuter.‡브루날 마을에 있는 레욜트 발리브루에게 쉼머위드 6개를 가져다주어야 합니다.‡Trae 6 cardaluz a Rejold Cebadiz en Las Birras.‡Llévale 6 cardaluz a Rejold Cebadiz en Las Birras.‡Apporter 6 Brins de chatoyante à Rejold Barleybrew au village de Brassetout.‡收集6束微光草，把它们交给烈酒村的雷杰德·麦酒。‡收集6束微光草，把它們交給烈酒村的雷傑德·麥酒。',
  }
},
[316] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    '‡‡‡‡‡Requisitos:‡‡‡',
  }
},
[317] = {
  {
    'Provisões para a Vaporeta‡Заготовка продовольствия‡Vorräte für Jetsteam‡증기 전차 공급품 비축‡Los suministros del reactor a vapor‡Los suministros del reactor a vapor‡Ravitailler le Crache-vapeur‡贝尔丁的补给‡貝爾丁的補給',
    nil,
    'Junte 4 Nacos de Carne de Javali e 2 Pelames Grossos de Urso e entregue tudo para o Piloto Urrabolha na Garagem do Gradaço.‡Принесите 4 куска кабанины и 2 толстых медвежьих шкуры пилоту Брюхинсу в Поселок Сталежара.‡Sammelt 4 Brocken Eberfleisch und 2 dicke Bärenfelle und liefert sie bei Pilot Bellowfiz in Steelgrills Depot ab.‡멧돼지 고기 4개와 두꺼운 곰 모피 2개를 모아서 스틸그릴의 정비소에 있는 조종사 벨로우피즈에게 가져다주어야 합니다.‡Reúne 4 piezas de carne de jabalí y 2 pieles gruesas de oso y llévaselas al piloto Bramiz al Almacén de Brasacerada.‡Reúne 4 trozos de carne de jabalí y 2 pelajes de oso grueso y llévaselas al piloto Bramiz al Almacén de Brasacerada.‡Réunir 4 morceaux de Viande de sanglier et 2 Fourrures d\'ours épaisses et les livrer au pilote Bellowfiz au dépôt de Steelgrill.‡收集4大块野猪肉和2张厚熊皮，把它们交给钢架补给站的驾驶员贝隆·风箱。‡收集4大塊野豬肉和2張厚熊皮，把它們交給鋼架補給站的駕駛員貝隆·風箱。',
  }
},
[318] = {
  {
    'Sempre-aceso‡"Вечное сияние"‡Immerschimmer‡에버샤인‡La tajada‡La tajada‡L’Evershine‡艾沃沙酒‡艾沃沙酒',
    nil,
    'Pegue um barril de Sempre-aceso com o Rejold Cervevada na Aldeia da Cevada.‡Возьмите бочонок "Вечного сияния" у Регольда Ячменовара в Поселке Пивоваров.‡Besorgt von Rejold Gerstenbräu in Brewnall ein Fässlein Immerschimmer.‡브루날 마을에 있는 레욜트 발리브루에게서 에버샤인 술통을 얻으십시오.‡Consigue un barril de tajada de Rejold Cebadiz de Las Birras.‡Consigue un tonel de tajada de Rejold Cebadiz de Las Birras.‡Demander un tonneau d\'Evershine à Rejold Barleybrew au village de Brassetout.‡从烈酒村的雷杰德·麦酒那里弄到一桶艾沃沙酒。‡從烈酒村的雷傑德·麥酒那裏弄到壹桶艾沃沙酒。',
  }
},
[319] = {
  {
    'Tudo pela Sempre-aceso‡Услуга за "Вечное сияние"‡Ein Gefallen für etwas Immerschimmer‡에버샤인 얻기‡Un favor a cambio de un barril de tajada‡Un favor a cambio de un barril de tajada‡Une faveur pour un tonneau d’Evershine‡艾沃沙酒‡艾沃沙酒',
    nil,
    'Mate 6 Ursos Garra de Gelo, 8 Rochetuscos Adultos e 8 Leopardos da Neve. Em seguida, fale novamente com Rejold Cervevada na Aldeia da Cevada.‡Убейте 6 медведей-ледолапов, 8 старых скальных вепрей и 8 снежных леопардов. Вернитесь к Регольду Ячменовару в Поселок Пивоваров.‡Tötet 6 Eisklauenbären, 8 alte Klippeneber sowie 8 Schneeleoparden und kehrt dann zu Rejold Gerstenbräu nach Brewnall zurück.‡얼음발톱흰곰 6마리, 덩치큰 멧돼지 8마리, 눈표범 8마리를 사냥한 다음 브루날 마을에 있는 레욜트 발리브루에게 돌아가십시오.‡Mata a 6 osos zarpahelada, 8 jabalíes del risco mayores y 8 leopardos de la nieve y luego vuelve a Las Birras con Rejold Cebadiz.‡Mata a 6 osos zarpahelada, 8 jabalíes del risco mayores y 8 leopardos de la nieve y luego vuelve a Las Birras con Rejold Cebadiz.‡Tuer 6 Ours Griffeglace, 8 Anciens sangliers des rochers et 8 Léopards des neiges, puis retourner voir Rejold Barleybrew à Brassetout.‡杀掉6头冰爪熊、8只老峭壁野猪和8只雪豹，然后回到烈酒村的雷杰德·麦酒那里。‡殺掉6頭冰爪熊、8只老峭壁野豬和8只雪豹，然後回到烈酒村的雷傑德·麥酒那裏。',
  }
},
[320] = {
  {
    'Fale novamente com Urrabolha‡Возвращение к Толстопузу‡Rückkehr zu Bellowfiz‡벨로우피즈에게 돌아가기‡Vuelve con Bramiz‡Regresa junto a Bramiz‡Retour vers Bellowfiz‡艾沃沙酒‡艾沃沙酒',
    nil,
    'Entregue o barrilete de Sempre-aceso para o Piloto Urrabolha na Garagem do Gradaço.‡Отдайте бочонок "Вечного сияния" пилоту Толстопузу в Поселке Сталежара.‡Gebt Pilot Bellowfiz in Steelgrills Depot das Fässlein mit Immerschimmer.‡스틸그릴의 정비소에 있는 조종사 벨로우피즈에게 에버샤인 술통을 가져다주어야 합니다.‡Entrega el barril de tajada al piloto Bramiz que está en el Almacén de Brasacerada.‡Entrega el tonel de tajada al piloto Bramiz en el Almacén de Brasacerada.‡Donner le Tonneau d\'Evershine au Pilote Bellowfiz au Dépôt de Steelgrill.‡把这桶艾沃沙酒交给钢架补给站的驾驶员贝隆·风箱。‡把這桶艾沃沙酒交給鋼架補給站的駕駛員貝隆·風箱。',
  }
},
[321] = {
  {
    'Ferro da Forja de Luz‡Светлосталь‡Lichtgeschmiedetes Eisen‡라이트포지 철‡Hierro Forjaluz‡Hierro Forjaluz‡Le fer de sancteforge‡光铸铁‡光鑄鐵',
    nil,
    'Vasculhe os destroços do Águia-pesqueira no Pantanal.‡Найдите груз с затонувшего корабля "Орлик" в Болотине.‡Durchsucht das Wrack der FLYING OSPREY im Sumpfland.‡저습지에 있는 난파된 창공의 물수리호를 찾아야 합니다.‡Busca los restos del Pigargo volador en Los Humedales.‡Busca los restos del Pigargo volador en Los Humedales.‡Fouiller l\'épave de l\'Albatros, dans les Paluns.‡搜索飞翔鱼鹰号的残骸。‡搜索飛翔魚鷹號的殘骸。',
  }
},
[322] = {
  {
    'Braço abençoado‡Достойное оружие‡Gesegnete Waffe‡신성한 무기‡Brazo bendito‡Brazo bendito‡Béni soit ce bras‡格瑞曼德·艾尔默‡格瑞曼德·艾爾默',
    nil,
    'Leve o Caixote de Lingotes de Forja de Luz para Grimand Elmore em Ventobravo.‡Отнесите сундук со слитками светлостали Гриманду Элмору в Штормград.‡Bringt Grimand Elmore in Stormwind die Kiste mit Lichtschmiedeblöcken.‡스톰윈드에 있는 그리만트 엘모어에게 라이트포지 주괴가 든 상자를 가져가야 합니다.‡Lleva el cajón de lingotes Forjaluz a Grimand Elmore en Ventormenta.‡Lleva el cajón de lingotes Forjaluz a Grimand Elmore en Ventormenta.‡Apporter la Caisse de lingots de sancteforge à Grimand Elmore, à Stormwind.‡将这箱光铸铁锭交给格瑞曼德·艾尔默。‡將這箱光鑄鐵錠交給格瑞曼德·艾爾默。',
  }
},
[323] = {
  {
    'Prova de valor‡Доказательство силы‡Bewährungsprobe‡영웅의 진가‡Prueba de valor‡Pon a prueba tu valor‡Prouver votre valeur‡证明你的实力‡證明妳的實力',
    nil,
    'Mate 15 Saqueadores Descarnados, 3 Curandeiros Descarnados e 3 Guardadores Descarnados, e depois fale novamente com Noel.‡Убейте 15 скелетов-налетчиков, 3 скелетов-лекарей и 3 скелетов-хранителей и вернитесь к Свену.‡Vernichtet 15 Skeletträuber, 3 Skelettheiler sowie 3 Skelettwärter und kehrt danach zu Sven zurück.‡해골 약탈자 15마리, 해골 치료사 3마리, 해골 문지기 3마리를 처치한 다음 스벤에게 돌아가야 합니다.‡Mata a 15 asaltantes esqueléticos, 3 sanadores esqueléticos y 3 guardas esqueléticos y vuelve a donde Sven.‡Mata a 15 asaltantes esqueléticos, 3 sanadores esqueléticos y 3 depositarios esqueléticos y vuelve a donde Sven.‡Tuer 15 Ecumeurs squelettes, 3 Soigneurs squelettes et 3 Gardiens squelettes puis retourner voir Sven.‡杀掉15个骷髅袭击者、3个骷髅医师和3个骷髅看守，然后回来见斯温。‡殺掉15個骷髏襲擊者、3個骷髏醫師和3個骷髏看守，然後回來見斯溫。',
  }
},
[324] = {
  {
    'Os lingotes perdidos‡Утерянные слитки‡Die verlorenen Blöcke‡사라진 주괴‡Los lingotes perdidos‡Los lingotes perdidos‡Les lingots perdus‡丢失的铁锭‡丟失的鐵錠',
    nil,
    'Colete 5 Lingotes da Forja de Luz e fale novamente com Glorin Testaço no Pantanal.‡Соберите 5 слитков светлостали и вернитесь к Глорину Стальному Лбу в Болотину.‡Sammelt 5 Lichtschmiedeblöcke und kehrt dann zu Glorin Steelbrow im Sumpfland zurück.‡라이트포지 주괴 5개를 모은 다음 저습지에 있는 글로린 스틸브로우에게 돌아가야 합니다.‡Reúne 5 lingotes Forjaluz y vuelve con Glorin Frenteacerada en Los Humedales.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Collecter 5 Lingots de sancteforge puis retourner voir Glorin Steelbrow, dans les Paluns.‡收集5块光铸铁锭，把它们交给湿地的戈罗林·钢眉。‡收集5塊光鑄鐵錠，把它們交給濕地的戈羅林·鋼眉。',
  }
},
[325] = {
  {
    'Com bala na agulha‡Вооружен и особо опасен‡Bewaffnet und bereit‡무기 완성‡Armado y listo‡Armado y listo‡En armes et prêt‡整装待发‡整裝待發',
    nil,
    'Leve a Desgraça de Morbídio até Noel, na Floresta do Crepúsculo.‡Принесите Проклятье Морбента Свену в Сумеречный лес.‡Bringt Morbents Bann zu Sven im Dämmerwald.‡모벤트 파멸의 불꽃을 그늘숲에 있는 스벤에게 가져가야 합니다.‡Lleva la Pesadilla de Morbent a Sven en el Bosque del Ocaso.‡Lleva la Pesadilla de Morbent a Sven en el Bosque del Ocaso.‡Apporter le Fléau de Morbent à Sven, dans le bois de la Pénombre.‡现在你已经得到了强大的武器，去向暮色森林的斯温复命吧。‡現在妳已經得到了強大的武器，去向暮色森林的斯溫復命吧。',
  }
},
[328] = {
  {
    'A chave oculta‡Спрятанный ключ‡Der versteckte Schlüssel‡숨겨진 열쇠‡La llave oculta‡La llave oculta‡La clé cachée‡隐藏的钥匙‡隱藏的鑰匙',
    nil,
    'Use a Pequena Chave de Latão para abrir o Cofre do Contador Herodes.‡Откройте сейф букмекера Герода маленьким латунным ключом.‡Verwendet den kleinen Messingschlüssel, um Buchhalter Herods Geldkassette zu öffnen.‡작은 놋쇠 열쇠로 사서 헤로드의 금고를 열어야 합니다.‡Utiliza la pequeña llave de latón para abrir la caja fuerte de Bookie Herod.‡Utiliza la pequeña llave de latón para abrir la caja fuerte del corredor Herod.‡Utiliser la Petite Clé en cuivre pour ouvrir le Coffre-fort de Herod la Paperasse.‡使用黄铜钥匙打开书呆子赫罗德的保险箱。‡使用黃銅鑰匙打開書呆子赫羅德的保險箱。',
  }
},
[329] = {
  {
    'O espião é revelado!‡Шпион найден!‡Der entlarvte Spion‡드러나는 첩자의 정체‡¡Espía descubierto!‡¡Espía descubierto!‡L\'espion découvert !‡找出内鬼！‡找出內鬼！',
    nil,
    'Leve o Bilhete Lamacento para Tenente Doren no Acampamento dos Rebeldes.‡Отнесите грязную записку лейтенанту Дорену в Лагерь повстанцев.‡Bringt die schlammverschmierte Notiz zu Lieutenant Doren im Rebellen-Lager.‡반란군 야영지에 있는 부관 도렌에게 진흙투성이 쪽지를 가져가야 합니다.‡Lleva la nota sucia al teniente Doren en el Asentamiento Rebelde.‡Lleva la nota sucia al teniente Doren en el Asentamiento Rebelde.‡Apporter la Note maculée de boue au lieutenant Doren, au camp rebelle.‡将沾泥的便笺交给叛军营地里的多伦上尉。‡將沾泥的便箋交給叛軍營地裏的多倫上尉。',
  }
},
[330] = {
  {
    'Itinerário das patrulhas‡Расписание дежурств‡Patrouillen-Pläne‡정찰 일정‡Horarios de patrulla‡Horarios de patrulla‡Composition des patrouilles‡巡逻时间表‡巡邏時間表',
    nil,
    'Fale com o Cabo Malta.‡Поговорите с капралом Сетманом.‡Sprecht mit Corporal Sethman.‡하사관 세스먼과 대화해야 합니다.‡Habla con el cabo Sethman.‡Habla con el cabo Sethman.‡Parler au caporal Sethman.‡与塞斯曼下士谈一谈。‡與塞斯曼下士談壹談。',
  }
},
[331] = {
  {
    'Relatório para Doren‡Доклад Дорену‡Meldung bei Doren‡도렌에게 보고하기‡Informa a Doren‡Informa a Doren‡Rapport au Lieutenant Doren‡向多伦报告‡向多倫報告',
    nil,
    'Fale com o Tenente Doren.‡Поговорите с лейтенантом Дореном в Лагере повстанцев.‡Sprecht mit Lieutenant Doren.‡부관 도렌과 대화해야 합니다.‡Habla con el teniente Doren.‡Habla con el teniente Doren.‡Parler au Lieutenant Doren.‡与多伦上尉谈一谈。‡與多倫上尉談壹談。',
  }
},
[332] = {
  {
    'A propaganda é a alma do negócio‡Реклама винного магазина‡Weinladen-Werbung‡와인 가게 광고‡Publicidad de la bodega‡Publicidad de la bodega‡Publicité pour la cave à vins Gallina‡酒店的广告‡酒店的廣告',
    nil,
    'Vá até a Vinícola Callina e entregue o Vale-vinho para Suzette Callina para ganhar uma garrafa de vinho.‡Отправляйтесь на винокурню Галлины и принесите Сюзетте Галлине талон на вино, чтобы получить бутылку вина бесплатно.‡Geht zum Weingut Gallina und gebt Suzetta Gallina den Wein-Gutschein, um eine kostenlose Flasche Wein zu erhalten.‡갈리나 와인 상점으로 가서 수제타 갈리나에게 와인 티켓을 주고 와인 한 병을 무료로 얻으십시오.‡Ve a la Bodega Gallina y lleva a Suzetta Gallina el cupón de vino para una botella gratis.‡Ve a la Bodega Galina y lleva a Suzetta Galina el cupón de vino para una botella gratis.‡Aller à la Cave à vins des Gallina et apporter à Suzetta Gallina le Bon pour une bouteille de vin gratuite.‡到加林纳酒店去, 将酒票交给苏泽塔·加林纳以换一瓶免费的酒。‡到加林納酒店去, 將酒票交給蘇澤塔·加林納以換壹瓶免費的酒。',
  }
},
[333] = {
  {
    'A lista de material do Fialho‡Харлан нуждается в помощи‡Harlan braucht Nachschub‡할란의 새 공급품‡Harlan necesita un nuevo suministro‡Harlan necesita un nuevo suministro‡Harlan a besoin d\'être approvisionné‡哈兰需要供货‡哈蘭需要供貨',
    nil,
    'Vá até a loja Ao Molde Moderno e entregue o Pedido de Tecido de Timóteo Fialho para Isabel Armarinho.‡Отправляйтесь в магазин одежды в районе каналов и принесите Реме Шнайдер заказ на ткани от Харлана Багли.‡Geht zur Schneiderei und Anpasserei am Kanal und bringt Rema Schneider Harlan Bagleys Kleidungs-Auftrag.‡대운하 의류점으로 가서 레마 슈나이더에게 할란 바글리가 보내는 옷감 주문서를 전해줘야 합니다.‡Ve a Trajes y Arreglos a Medida y lleva a Rema Schneider el paño que ha pedido Harlan Bagley.‡Ve a Trajes y Arreglos a Medida y lleva a Rema Schneider el paño que ha pedido Harlan Bagley.‡Aller à la Boutique de tailleur du canal et donner à Rema Schneider la Demande de tissu, pour Harlan Bagley.‡找到运河裁缝店，并将哈兰·巴格雷的布料订单带给雷玛·施涅德。‡找到運河裁縫店，並將哈蘭·巴格雷的布料訂單帶給雷瑪·施涅德。',
  }
},
[334] = {
  {
    'Entrega para Antônio Armarinho‡Посылка для Турмана‡Eine Lieferung für Thurman‡투르만의 준비물‡Un paquete para Thurman‡Un paquete para Thurman‡Un paquet pour Thurman‡萨尔曼的针线包‡薩爾曼的針線包',
    nil,
    'Vá até a Alfaiataria Galante, no Distrito dos Magos de Ventobravo, e entregue a caixa de costura para Antônio Armarinho.‡Отправляйтесь в суконную лавку Ларсона в квартал магов Штормграда, и передайте Турману Шнайдеру его набор для шитья.‡Geht zum Konfektionsgeschäft Larson im Magierviertel von Stormwind und gebt Thurman Schneider sein Nähkästchen.‡스톰윈드 마법사 지구에 있는 라슨의 옷가게로 가서 투르만 슈나이더에게 바느질 도구를 주어야 합니다.‡Ve a Diseños Larson en el Barrio de los Magos de Ventormenta y entrega a Thurman Schneider sus herramientas de coser.‡Ve a Diseños Larson en el Barrio de los Magos de Ventormenta y entrega a Thurman Schneider sus herramientas de coser.‡Aller chez les Couturiers Larson, dans le quartier des mages de Stormwind, pour donner à Thurman Schneider son Matériel de couture.‡到暴风城法师区的拉尔森服装店去，将针线包带给萨尔曼·斯涅德。‡到暴風城法師區的拉爾森服裝店去，將針線包帶給薩爾曼·斯涅德。',
  }
},
[335] = {
  {
    'Uma bebida para poucos‡Благородный напиток‡Ein nobles Bräu‡귀족을 위한 술‡Una noble cerveza‡Una noble cerveza‡Un noble brassage‡名酿‡名釀',
    nil,
    'O Malvino da Garra Preta quer que você lhe traga uma Lágrima de Tirsa da Vila Sombria e uma Raiz Almiscarada do Pantanal.‡Принесите Зардету Черному Когтю слезу Тиллоа из Темнолесья и мускусный корень из Болотины.‡Zardeth Blackclaw möchte, dass Ihr ihm eine Tilloaträne aus Dunkelhain und eine Bisamwurzel aus dem Sumpfland bringt.‡검은발톱 자데스가 다크샤이어에서 틸로아의 눈물과 저습지에서 사향쥐 뿌리를 가져다 달라고 부탁했습니다.‡Zardeth de los Zarpanegra, quiere que le lleves una lágrima de Tilloa de Villa Oscura y una zibética de Los Humedales.‡Zardeth de los Zarpanegra, quiere que le lleves una lágrima de Tilloa de Villa Oscura y una zibética de Los Humedales.‡Sur ordre de Zardeth de la Griffe noire, rapporter une Larme de Tilloa de Darkshire et une Racine de Musquash des Paluns.‡黑爪加尔德斯要求你从夜色镇给他摘1朵蒂罗亚之泪，再从湿地给他采一块麝鼠根。‡黑爪加爾德斯要求妳從夜色鎮給他摘1朵蒂羅亞之淚，再從濕地給他采壹塊麝鼠根。',
  }
},
[336] = {
  {
    'Uma bebida para poucos‡Благородный напиток‡Ein nobles Bräu‡귀족을 위한 술‡Una noble cerveza‡Una noble cerveza‡Un noble brassage‡名酿‡名釀',
    nil,
    'Sirva o Chope Garra Negra para o Barão Quadranilha na Sala de Audiência.‡Отнесите портер "Черный коготь" лорду Вишлоку в Зал просителей.‡Bringt Lord Wishock in der Halle der Bittsteller das Blackclaw-Starkbier.‡왕국 민원실에 있는 보울즈 K. 위쇼크 경에게 검은발톱 스타우트 맥주를 주어야 합니다.‡Lleva la cerveza Zarpanegra a Lord Wishock en la Sala de los Ruegos.‡Lleva la cerveza Zarpanegra a Lord Wishock en la Sala de los Ruegos.‡Apporter la Bière brune de la Griffe noire au seigneur Wishock dans la Chambre du requérant.‡将黑爪烈酒带给祈愿厅里的维沙克公爵。‡將黑爪烈酒帶給祈願廳裏的維沙克公爵。',
  }
},
[337] = {
  {
    'Um velho livro de história‡Старый учебник истории‡Ein altes Geschichtsbuch‡오래된 역사책‡Un libro de Historia viejo‡Un libro viejo de Historia‡Un vieux livre d\'histoire‡一本破旧的历史书‡壹本破舊的歷史書',
    nil,
    'Devolva o livro "A História de Ventobravo" para a Biblioteca de Ventobravo.‡Вернуть книгу "История Штормграда" в библиотеку Штормграда.‡Bringt das Buch: "Die Geschichte von Stormwind" in die Bibliothek von Stormwind zurück.‡스톰윈드 도서관에 스톰윈드의 역사 책을 돌려줘야 합니다.‡Devuelve el libro: La Historia de Ventormenta a La Biblioteca de Ventormenta.‡Devuelve el libro: La Historia de Ventormenta a La Biblioteca de Ventormenta.‡Rendre le livre « l\'Histoire de Stormwind » à la Bibliothèque de Stormwind.‡把《暴风城的历史》这本书还给暴风城图书馆。‡把《暴風城的歷史》這本書還給暴風城圖書館。',
  }
},
[338] = {
  {
    'Grande Espinhaço: Veredas‡Зеленые холмы Тернистой долины‡Die Grünen Hügel des Schlingendorntals‡가시덤불 골짜기의 푸른 언덕‡Las verdes colinas de Tuercespina‡Las verdes colinas de Tuercespina‡« Les vertes collines de Strangleronce »‡荆棘谷的青山‡荊棘谷的青山',
    nil,
    'Reúna as páginas que faltam do manuscrito de Grande Espinhaço: Veredas. Quando todos os quatro capítulos estiverem completos, devolva-os a Eucunha.‡Соберите все недостающие страницы романа "Зеленые холмы Тернистой долины". Когда у вас на руках окажутся все четыре главы, верните их Барнилу.‡Sammelt die fehlenden Seiten des Manuskripts von "Die Grünen Hügel des Schlingendorntals”. Wenn alle vier Kapitel vollständig sind, bringt sie zu Barnil zurück.‡가시덤불 골짜기의 푸른 언덕 원고의 잃어버린 페이지들을 모아야 합니다. 네 개의 장이 모두 완성되면 바닐 스톤팟에게 가져가십시오.‡Reúne las páginas perdidas del manuscrito Las verdes colinas de Tuercespina. Cuando los cuatro capítulos estén completos, llévaselos a Barnil.‡Reúne las páginas perdidas del manuscrito Las verdes colinas de Tuercespina. Cuando los cuatro capítulos estén completos, llévaselos a Barnil.‡Rassembler les pages manquantes du manuscrit des « Vertes collines de Strangleronce ». Une fois les quatre chapitres complétés, les rendre à Barnil.‡收集《荆棘谷的青山》的手稿中丢失的页面。在集齐四章书之后，将它们还给巴尼尔·石罐。‡收集《荊棘谷的青山》的手稿中丟失的頁面。在集齊四章書之後，將它們還給巴尼爾·石罐。',
  }
},
[339] = {
  {
    'Capítulo I‡Глава I‡Kapitel I‡제 1 장‡Capítulo I‡Capítulo I‡Chapitre I‡荆棘谷的青山 - 第一章‡荊棘谷的青山 - 第壹章',
    nil,
    'Leve as páginas 1, 4, 6 e 8 de Grande Espinhaço: Veredas, de Rosarães, até Eucunha de Clides para completar o Capítulo I.‡Принесите 1, 4, 6 и 8 страницы книги "Зеленые холмы Тернистой долины" Барнилу Каменному Кубку, чтобы собрать всю первую главу.‡Bringt Barnil Steinkrug die Seiten 1, 4, 6 und 8 von Nesingwarys Die Grünen Hügel des Schlingendorntals, um Kapitel I zu vervollständigen.‡바닐 스톤팟이 네싱워리의 소설 가시덤불 골짜기의 푸른 언덕의 1장을 완성할 수 있도록 1, 4, 6, 8 쪽을 가져가야 합니다.‡Lleva las páginas 1, 4, 6 y 8 de Las verdes colinas de Tuercespina de Decautela a Barnil Jarropetra para completar el capítulo I.‡Lleva las páginas 1, 4, 6 y 8 de Las verdes colinas de Tuercespina de Nesingwary a Barnil Jarropetra para completar el capítulo I.‡Rapporter les pages 1, 4, 6 et 8 des Vertes collines de Strangleronce de Nesingwary à Barnil Stonepot pour achever le Chapitre I.‡将奈辛瓦里的小说《荆棘谷的青山》的第1页，第4页，第6页和第8页带给巴尼尔·石罐以凑齐第一章。‡將奈辛瓦裏的小說《荊棘谷的青山》的第1頁，第4頁，第6頁和第8頁帶給巴尼爾·石罐以湊齊第壹章。',
  }
},
[340] = {
  {
    'Capítulo II‡Глава II‡Kapitel II‡제 2 장‡Capítulo II‡Capítulo II‡Chapitre II‡荆棘谷的青山 - 第二章‡荊棘谷的青山 - 第二章',
    nil,
    'Leve as páginas 10, 11, 14 e 16 de Grande Espinhaço: Veredas, de Rosarães, até Eucunha de Clides para completar o Capítulo II.‡Принесите 10, 11, 14 и 16 страницы книги "Зеленые холмы Тернистой долины" Барнилу Каменному Кубку, чтобы собрать всю вторую главу.‡Bringt Barnil Stonepot die Seiten 10, 11, 14 und 16 von Nesingwarys "Die Grünen Hügel des Schlingendorntals", um Kapitel II zu vervollständigen.‡바닐 스톤팟이 네싱워리의 소설 가시덤불 골짜기의 푸른 언덕의 2장을 완성할 수 있도록 10, 11, 14, 16 쪽을 가져가야 합니다.‡Lleva las páginas 10, 11, 14 y 16 de Las verdes colinas de Tuercespina de Decautela a Barnil Jarropetra para completar el capítulo II.‡Lleva las páginas 10, 11, 14 y 16 de Las verdes colinas de Tuercespina de Nesingwary a Barnil Jarropetra para completar el capítulo II.‡Rapporter les pages 10, 11, 14 et 16 des « Vertes collines de Strangleronce » de Nesingwary à Barnil Stonepot pour achever le Chapitre II.‡将奈辛瓦里的小说《荆棘谷的青山》的第10页，第11页，第14页和第16页带给巴尼尔·石罐以凑齐第二章。‡將奈辛瓦裏的小說《荊棘谷的青山》的第10頁，第11頁，第14頁和第16頁帶給巴尼爾·石罐以湊齊第二章。',
  }
},
[341] = {
  {
    'Capítulo III‡Глава III‡Kapitel III‡제 3 장‡Capítulo III‡Capítulo III‡Chapitre III‡荆棘谷的青山 - 第三章‡荊棘谷的青山 - 第三章',
    nil,
    'Leve as páginas 18, 20, 21 e 24 de Grande Espinhaço: Veredas, de Rosarães, até Eucunha de Clides para completar o Capítulo III.‡Принесите 18, 20, 21 и 24 страницы книги "Зеленые холмы Тернистой долины" Барнилу Каменному Горшку, чтобы собрать всю третью главу.‡Bringt Barnil Stonepot die Seiten 18, 20, 21 und 24 von Nesingwarys "Die Grünen Hügel des Schlingendorntals”, um Kapitel III zu vervollständigen.‡바닐 스톤팟이 네싱워리의 소설 가시덤불 골짜기의 푸른 언덕의 3장을 완성할 수 있도록 18, 20, 21, 24 쪽을 가져가야 합니다.‡Lleva las páginas 18, 20, 21 y 24 de Las verdes colinas de Tuercespina de Decautela a Barnil Jarropetra para completar el capítulo III.‡Lleva las páginas 18, 20, 21 y 24 de Las verdes colinas de Tuercespina de Nesingwary a Barnil Jarropetra para completar el capítulo III.‡Rapporter les pages 18, 20, 21 et 24 des « Vertes collines de Strangleronce » de Nesingwary à Barnil Stonepot pour achever le Chapitre III.‡将奈辛瓦里的小说《荆棘谷的青山》的第18页，第20页，第21页和第24页带给巴尼尔·石罐以凑齐第三章。‡將奈辛瓦裏的小說《荊棘谷的青山》的第18頁，第20頁，第21頁和第24頁帶給巴尼爾·石罐以湊齊第三章。',
  }
},
[342] = {
  {
    'Capítulo IV‡Глава IV‡Kapitel IV‡제 4 장‡Capítulo IV‡Capítulo IV‡Chapitre IV‡荆棘谷的青山 - 第四章‡荊棘谷的青山 - 第四章',
    nil,
    'Leve as páginas 25, 26 e 27 de Grande Espinhaço: Veredas, de Rosarães, até Eucunha de Clides para completar o Capítulo IV.‡Принесите 25, 26 и 27 страницы книги "Зеленые холмы Тернистой долины" Барнилу Каменному Кубку, чтобы собрать всю четвертую главу.‡Bringt Barnil Stonepot die Seiten 25, 26 und 27 von Nesingwarys "Die Grünen Hügel des Schlingendorntals", um Kapitel IV zu vervollständigen.‡바닐 스톤팟이 네싱워리의 소설 가시덤불 골짜기의 푸른 언덕의 4장을 완성할 수 있도록 25, 26, 27 쪽을 가져가야 합니다.‡Lleva las páginas 25, 26, y 27 de Las verdes colinas de Tuercespina de Decautela a Barnil Jarropetra para completar el capítulo IV.‡Lleva las páginas 25, 26, y 27 de Las verdes colinas de Tuercespina de Nesingwary a Barnil Jarropetra para completar el capítulo IV.‡Rapporter les pages 25, 26 et 27 des « Vertes collines de Strangleronce » de Nesingwary à Barnil Stonepot pour achever le Chapitre IV.‡将奈辛瓦里的小说《荆棘谷的青山》的第25页，第26页和第27页带给巴尼尔·石罐以凑齐第四章。‡將奈辛瓦裏的小說《荊棘谷的青山》的第25頁，第26頁和第27頁帶給巴尼爾·石罐以湊齊第四章。',
  }
},
[343] = {
  {
    'Falando sobre fortitude‡Кстати, о стойкости духа‡Reden über Kraft‡불굴의 의지에 대한 연설‡Hablando de fortaleza‡Hablando de entereza‡En parlant de fermeté‡关于坚韧的演讲‡關於堅韌的演講',
    nil,
    'Vá à Biblioteca Real na Bastilha Ventobravo e fale com Milton Resma. Ele pode encontrar para você o livro sobre metalurgia que o Irmão Kristoff precisa para o discurso.‡Отправляйтесь в Королевскую библиотеку Крепости Штормграда и поговорите с Милтоном Снопом. Он даст вам книгу по металлургии, которая интересует брата Кристофа.‡Geht in die königliche Bibliothek der Feste von Stormwind und sprecht mit Milton Sheaf. Er kann das Buch über Metallurgie für Euch finden, das Bruder Kristoff für seine Rede benötigt.‡스톰윈드 왕궁에 있는 왕실 도서관으로 가서 밀턴 시프와 대화해야 합니다. 그는 수사 크리스토프가 연설에 필요로 하는 야금술에 대한 책을 찾아 줄 수 있습니다.‡Ve al Archivo Real en el Castillo de Ventormenta y habla con Milton Gavilla. Podrá encontrar el libro sobre metalurgia que el hermano Kristoff necesita para su charla.‡Ve al Archivo Real en el Castillo de Ventormenta y habla con Milton Gavilla. Podrá encontrar el libro sobre metalurgia que el hermano Kristoff necesita para su charla.‡Allez à la Bibliothèque royale dans le Donjon de Stormwind pour parler à Milton Sheaf. Il trouvera le livre sur la métallurgie dont Frère Kristoff a besoin pour son discours.‡到暴风城堡的皇家图书馆去与米尔顿·西弗交谈，他将会为你找到克里斯托弗修士所需要的关于冶金学的书。‡到暴風城堡的皇家圖書館去與米爾頓·西弗交談，他將會為妳找到克裏斯托弗修士所需要的關於冶金學的書。',
  }
},
[344] = {
  {
    'Irmão Paxeco‡Брат Пакстон‡Bruder Paxton‡수사 팩스턴‡Hermano Paxton‡Hermano Paxton‡Frère Paxton‡帕克斯顿修士‡帕克斯頓修士',
    nil,
    'Fale com o Irmão Paxeco na Abadia de Vila Norte.‡Поговорите с братом Пакстоном из Аббатства Североземья.‡Sprecht mit Bruder Paxton in der Abtei von Nordhain.‡노스샤이어 수도원에 있는 수사 팩스턴과 대화해야 합니다.‡Habla con el hermano Paxton en la Abadía de Villanorte.‡Habla con el hermano Paxton en la Abadía de Villanorte.‡Parler au frère Paxton, à l\'Abbaye du Northshire.‡与北郡修道院的帕克斯顿修士谈一谈。‡與北郡修道院的帕克斯頓修士談壹談。',
  }
},
[345] = {
  {
    'Estoque de tinta‡Запас чернил‡Tinten-Zutaten‡잉크 공급‡Suministros de tinta‡Suministros de tinta‡Provisions d\'encre‡墨水短缺‡墨水短缺',
    nil,
    'Fale com o Encarregado Oslow em Vila Plácida e peça-lhe Minério de Ferro Retibano.‡Поговорите со штейгером Ослоу из Озер и расспросите его о ретбанской руде.‡Sprecht mit Großknecht Oslow in Seenhain und fragt ihn nach Rethbaneisenerz.‡레이크샤이어에 있는 현장감독 오슬로우와 대화하여 레스밴 철광석을 달라고 부탁해야 합니다.‡Habla con el supervisor Oslow en Villa del Lago y pregúntale sobre el mineral de hierro de Rethban.‡Habla con el supervisor Olento en Villa del Lago y pregúntale sobre el mineral de hierro de Rethban.‡Aller voir le contremaître Oslow de Lakeshire et lui demander du minerai de rethban.‡与湖畔镇的工头奥斯洛交谈，并向他要一些瑞斯班矿石。‡與湖畔鎮的工頭奧斯洛交談，並向他要壹些瑞斯班礦石。',
  }
},
[346] = {
  {
    'De novo com Kristoff‡Возвращение к Кристофу‡Rückkehr zu Kristoff‡수사 크리스포트에게로‡Vuelve con Kristoff‡Regresa junto a Kristoff‡Retourner voir Frère Kristoff‡克里斯托弗的书‡克裏斯托弗的書',
    nil,
    'Fale novamente com Irmão Kristoff na Praça da Catedral. Dê a ele o livro Fadigas do Ferro.‡Вернитесь к брату Кристофу на Соборную площадь. Отдайте ему книгу "Как закалялось железо".‡Kehrt zu Bruder Kristoff auf den Kathedralenplatz zurück. Gebt ihm das Buch: "Belastbarkeit von Eisen".‡대성당 광장에 있는 수사 크리스토프에게 돌아가서 \'철강의 중요성\'을 전달해야 합니다.‡Vuelve a hablar con el hermano Kristoff en la Plaza de la Catedral. Entrégale el libro La tensión del hierro.‡Vuelve a hablar con el hermano Kristoff en la Plaza de la Catedral. Entrégale el libro La tensión del hierro.‡Retourner voir Frère Kristoff sur la Place de la Cathédrale. Lui donner le livre « les Tensions du fer ».‡回到教堂广场，将《金属的延展性》交给克里斯托弗修士。‡回到教堂廣場，將《金屬的延展性》交給克裏斯托弗修士。',
  }
},
[347] = {
  {
    'Minério Retibano‡Ретбанская руда‡Rethbanerz‡레스밴 광석‡Mineral de Rethban‡La mena de Rethban‡Minerai de rethban‡瑞斯班矿石‡瑞斯班礦石',
    nil,
    'Colete 5 porções de Minério Retibano e leve-as para o Irmão Paxeco na biblioteca de Vila Norte.‡Добудьте 5 кусков ретбанской руды и принесите их брату Пакстону в библиотеку Североземского аббатства.‡Sammelt 5 Fuhren Rethbanerz und bringt sie Bruder Paxton in der Bibliothek von Nordhain.‡레스밴 광석 5개를 모아서 노스샤이어 도서관에 있는 수사 팩스턴에게 가져가야 합니다.‡Reúne 5 montones de mineral de hierro de Rethban y llévaselos al hermano Paxton en la biblioteca de Villanorte.‡Reúne 5 montones de mineral de hierro de Rethban y llévaselos al hermano Paxton en la biblioteca de Villanorte.‡Réunir 5 charges de Minerai de rethban et les apporter à Frère Paxton à la bibliothèque du Northshire.‡收集5袋瑞斯班矿石，把它们带给北郡图书馆的帕克斯顿修士。‡收集5袋瑞斯班礦石，把它們帶給北郡圖書館的帕克斯頓修士。',
  }
},
[348] = {
  {
    'Febre da Selva do Espinhaço‡Лихорадка Тернистой долины‡Schlingendornfieber‡가시덤불 골짜기의 열병‡La fiebre de Tuercespina‡La fiebre de Tuercespina‡La fièvre de Strangleronce‡荆棘谷热疫‡荊棘谷熱疫',
    nil,
    'Procure o Mandingueiro Unbagwa e faça-o evocar Mokk, o Selvagem. Leve o Coração de Mokk para Fino Algazarro.‡Найдите знахаря Унбагва и попросите его вызвать Мокка Дикаря. Принесите сердце Мокка Фину Горемыку.‡Sucht Hexendoktor Unbagwa und lasst ihn Mokk den Wilden beschwören. Bringt das Herz von Mokk zu Fin Fizracket.‡의술사 운바그와를 찾아 흉포한 모크를 불러내도록 해야 합니다. 핀 피즈라켓에게 모크의 심장을 가져가야 합니다.‡Busca al médico brujo Unbagwa y haz que invoque a Mokk el Salvaje. Lleva el corazón de Mokk a Fin Fizqueta.‡Busca al médico brujo Unbagwa y haz que invoque a Mokk el Salvaje. Lleva el corazón de Mokk a Fin Fizqueta.‡Chercher le Sorcier-docteur Unbagwa pour qu\'il invoque Mokk le Sauvage. Apporter le Cœur de Mokk à Fizracket.‡找到巫医安巴格瓦并要求他召唤出野人莫克，然后将野人莫克的心脏交给芬·菲兹拉克。‡找到巫醫安巴格瓦並要求他召喚出野人莫克，然後將野人莫克的心臟交給芬·菲茲拉克。',
  }
},
[349] = {
  {
    'Febre da Selva do Espinhaço‡Лихорадка Тернистой долины‡Schlingendornfieber‡가시덤불 골짜기의 열병‡La fiebre de Tuercespina‡La fiebre de Tuercespina‡La fièvre de Strangleronce‡荆棘谷热疫‡荊棘谷熱疫',
    nil,
    '‡врем текст 02 – протокол‡Sprecht mit Hexendoktor Unbagwa.‡‡temp text 02 - registro‡temp text 02 - registro‡temp text 02 - log‡与巫医安巴格瓦交谈。‡',
  }
},
[350] = {
  {
    'Procurando um velho amigo‡Помощь старого друга‡Auf einen alten Freund verlassen‡오랜 친구 찾기‡Mira por un viejo amigo‡Mira por un viejo amigo‡Le point de vue d\'un vieil ami‡老朋友‡老朋友',
    nil,
    'Fale com Elling Trias em Ventobravo.‡Поговорите с Иллингом Триасом в Штормграде.‡Sprecht mit Elling Trias in Stormwind.‡스톰윈드에 있는 엘링 트리아스와 대화해야 합니다.‡Habla con Elling Trias en Ventormenta.‡Habla con Elling Trias en Ventormenta.‡Parler à Elling Trias à Stormwind.‡与暴风城的埃林·提亚斯谈一谈。‡與暴風城的埃林·提亞斯談壹談。',
  }
},
[351] = {
  {
    'Encontre OOX-17/TN!‡Найди КПХ-17/TN!‡Findet OOX-17/TN!‡OOX-17/TN 수색‡¡Encontrar a OOX-17/TN!‡¡Encontrar a OOX-17/TN!‡Trouver OOX-17/TN !‡寻找OOX-17/TN！‡尋找OOX-17/TN！',
    nil,
    'Leve o transmissor de emergência até o robô teleguiado de Olhatorto.‡Отнесите аварийный маяк к автономному роботу Карлса.‡Bringt das Notsignal zum Leitroboter von Oglethorpe.‡오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Llévale el localizador de emergencia al robot mensajero de Oglethorpe.‡Llévale el localizador de emergencia al robot mensajero de Oglethorpe.‡Apporter la balise de détresse au robot guidé d\'Oglethorpe.‡把定位器带到奥格索普的母体机器人那里。‡把定位器帶到奧格索普的母體機器人那裏。',
  }
},
[352] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    nil,
  }
},
[353] = {
  {
    'Entrega para Lançatroz‡Посылка для Грозовой Вершины‡Stormpikes Lieferung‡스톰파이크에게 소포 배달‡Una entrega a Pico Tormenta‡Una entrega a Pico Tormenta‡Livraison pour Stormpike‡雷矛的包裹‡雷矛的包裹',
    nil,
    'Entregue o Pacote para Lançatroz para o Montanhista Lançatroz em Loch Modan.‡Доставьте посылку горному пехотинцу Грозовой Вершине в Лок Модан.‡Bringt das Päckchen für Stormpike zu Gebirgsjäger Stormpike am Loch Modan.‡모단 호수에 있는 산악경비대 스톰파이크에게 스톰파이크의 소포를 배달해야 합니다.‡Entrega el paquete Pico Tormenta al montaraz Pico Tormenta en Loch Modan.‡Entrega el paquete Pico Tormenta al montaraz Pico Tormenta en Loch Modan.‡Livrer le Paquet au montagnard Stormpike au Loch Modan.‡把给卡尔·雷矛的包裹交给洛克莫丹北部哨塔里的巡山人卡尔·雷矛。‡把給卡爾·雷矛的包裹交給洛克莫丹北部哨塔裏的巡山人卡爾·雷矛。',
  }
},
[354] = {
  {
    'Mortes na família‡Смерти в семье‡Todesfälle in der Familie‡가문의 몰살‡Muertes en la familia‡Muertes en la familia‡Morts dans la Famille‡阿加曼德家族‡阿加曼德家族',
    nil,
    'Obtenha os Restos Mortais de Gregor, os Restos Mortais de Nissa, os Restos Mortais de Timóteo para Eurico Palhares em Montalvo.‡Принесите останки Грегора, останки Ниссы и останки Турмана Колману Фартингу в Брилл.‡Bringt Coleman Farthing in Brill Gregors Überreste, Nissas Überreste und Thurmans Überreste.‡브릴에 있는 콜만 파딩에게 그레고르의 유골, 니사의 유해, 투르만의 유골을 가져가야 합니다.‡Llévale los restos de Gregor, los restos de Nissa y los restos de Thurman a Coleman Lontananza, que está en Rémol.‡Llévale los restos de Gregor, los restos de Nissa y los restos de Thurman a Coleman Farthing, que está en Rémol.‡Rapporter les restes de Gregor, de Nissa et de Thurman à Coleman Farthing, à Brill.‡把格里高的遗骸、妮萨的残骸和萨尔曼的遗骸交给布瑞尔的库勒曼·法席恩。‡把格裏高的遺骸、妮薩的殘骸和薩爾曼的遺骸交給布瑞爾的庫勒曼·法席恩。',
  }
},
[355] = {
  {
    'Fale com Sevren‡Разговор с Севреном‡Gespräch mit Sevren‡세브렌과의 대화‡Habla con Sevren‡Habla con Sevren‡Parler à Sevren‡与塞弗伦交谈‡與塞弗倫交談',
    nil,
    'Fale com o Magistrado Sevren em Montalvo.‡Поговорите с мировым судьей Севреном в Брилле.‡Sprecht mit Magistrat Sevren in Brill.‡브릴에 있는 집정관 세브렌과 대화해야 합니다.‡Habla con el magistrado Sevren de Rémol.‡Habla con el magistrado Sevren de Rémol.‡Parler au magistrat Sevren à Brill.‡与布瑞尔的执政官塞弗伦谈一谈。‡與布瑞爾的執政官塞弗倫談壹談。',
  }
},
[356] = {
  {
    'Patrulha da retaguarda‡Патруль в арьергарде‡Patrouille zur Rückendeckung‡후방 경비‡Patrulla de la retaguardia‡Patrulla de la retaguardia‡Patrouille d\'arrière-garde‡巡查后方‡巡查後方',
    nil,
    'Mate 8 Horrores Sangrentos e 8 Espíritos Errantes. Depois, apresente seu relatório a Linnea no acampamento.‡Убейте 8 кровоточащих ужасов и 8 странствующих духов, а потом доложите о своих успехах Линнее в ее лагере.‡Tötet 8 blutende Schrecken und 8 wandernde Geister und meldet Euch dann wieder bei Linnea in ihrem Lager.‡피투성이 좀비 8명과 떠도는 영혼 8명을 처치한 다음 초소로 돌아가 리니아에게 보고해야 합니다.‡Mata a 8 horrores sangrantes y a 8 espíritus deambulantes, y ve a informar a Linnea a su campamento.‡Mata 8 horrores sangrantes y 8 espíritus deambulantes, y preséntate ante Linnea en su campamento.‡Tuer 8 Horreurs sanguinolentes et 8 Esprits vagabonds, puis revenez voir Linnea, à son camp.‡杀死8个可怕的血僵尸和8个游荡的幽灵，然后向亡灵卫兵林奈汇报。‡殺死8個可怕的血僵屍和8個遊蕩的幽靈，然後向亡靈衛兵林奈匯報。',
  }
},
[357] = {
  {
    'A identidade do lich‡Личность лича‡Die Identität des Lichs‡마술사의 정체‡La identidad del exánime‡La identidad del exánime‡Le Nom de la Liche‡巫妖的身份‡巫妖的身份',
    nil,
    'Leve o Grimório do Lich para Boanerges Stalactus na Cidade Baixa.‡Принесите книгу лича Бетору Ледострелу в Подгород.‡Bringt das Zauberbuch des Lichs zu Bethor Iceshard in Undercity.‡언더시티에 있는 베소르 아이스샤드에게 마술사의 마법책을 가져가야 합니다.‡Llévale el libro de hechizos del exánime a Bethor Duroyelo, que está en Entrañas.‡Llévale el libro de hechizos del exánime a Bethor Duroyelo en Entrañas.‡Rapporter le livre de sorts de la Liche et le donner à Bethor Iceshard à Undercity.‡把巫妖的法术书带给幽暗城的比索·埃斯沙德。‡把巫妖的法術書帶給幽暗城的比索·埃斯沙德。',
  }
},
[358] = {
  {
    'Roubacovas‡Грабители могил‡Grabräuber‡묘지 도굴꾼‡Profanadores‡Profanadores‡Les Profanateurs‡盗墓贼‡盜墓賊',
    nil,
    'Mate Roubacovas Putricouro e Mestiços Putricouro.|nLeve 8 frascos de Linfa Embalsamadora para o Magistrado Sevren, em Montalvo.‡Убивайте грабителей могил и полукровок из стаи Гнилошкуров.|nПринесите мировому судье Севрену 8 образцов бальзамирующей лимфы.‡Tötet Grabräuber der Moderfelle und Bastarde der Moderfelle.|nBringt Magistrat Sevren in Brill 8 Einbalsamierungssekrete.‡썩은가죽일족 도굴꾼 8마리와 썩은가죽일족 싸움꾼 5마리를 처치해야 합니다.|n이들에게서 불변의 영액 8개를 모은 후 브릴에 있는 집정관 세브렌에게 가져가야 합니다.‡Mata a los asaltatumbas Putrepellejo y a los bastardos Putrepellejo.|nLlévale 8 icores de embalsamar al magistrado Sevren de Rémol.‡Mata a los asaltatumbas Putrepellejo y a los bastardos Putrepellejo.|nLlévale 8 icores embalsamantes al magistrado Sevren de Rémol.‡Tuer des Profanateurs Poils-putrides et des Gnolls Poils-putrides.|nRapporter les Ichors d\'embaumement au magistrat Sevren à Brill.‡杀死腐皮盗墓贼和混血腐皮豺狼人。|n给布瑞尔的执政官塞弗伦带回8瓶防腐剂。‡殺死腐皮盜墓賊和混血腐皮豺狼人。|n給布瑞爾的執政官塞弗倫帶回8瓶防腐劑。',
  }
},
[359] = {
  {
    'Deveres Renegados‡Обязанности Отрекшихся‡Verlassenen-Pflichten‡포세이큰의 의무‡Las obligaciones de los Renegados‡Las obligaciones de los Renegados‡Mission des Réprouvés‡亡灵卫兵的职责‡亡靈衛兵的職責',
    nil,
    'Fale com a Necroguarda Lina.‡Поговорите со стражем смерти Линнеей.‡Sprecht mit Todeswache Linnea.‡죽음의경비병 리니아와 대화해야 합니다.‡Habla con la guardia de la muerte Linnea.‡Habla con la guardia de la muerte Linnea.‡Parler à la Garde noire Linnea.‡与亡灵卫兵林奈谈一谈。‡與亡靈衛兵林奈談壹談。',
  }
},
[360] = {
  {
    'De volta ao Magistrado‡Возвращение к чиновнику‡Rückkehr zum Magistrat‡집정관에게 돌아가기‡Regresa junto al magistrado‡Regresa junto al magistrado‡Retourner voir le Magistrat‡向塞弗伦回报‡向塞弗倫回報',
    nil,
    'Fale novamente com o Magistrado Sevren em Montalvo.‡Вернитесь к мировому судье Севрену в Брилл.‡Kehrt zu Magistrat Sevren nach Brill zurück.‡브릴에 있는 집정관 세브렌에게 돌아가야 합니다.‡Ve a ver de nuevo al magistrado Sevren de Rémol.‡Ve a ver de nuevo al magistrado Sevren de Rémol.‡Retourner voir le Magistrat Sevren à Brill.‡向布瑞尔的执政官塞弗伦报告。‡向布瑞爾的執政官塞弗倫報告。',
  }
},
[361] = {
  {
    'A carta que nunca chegou‡Недоставленное письмо‡Ein nie zugestellter Brief‡배달되지 않은 편지‡Una carta sin entregar‡Una carta sin entregar‡Une lettre perdue‡未寄出的信件‡未寄出的信件',
    nil,
    'Encontre Ivete Palhares e entregue a carta de Timóteo Agamand.‡Найдите Иветту Фартинг и вручите ей письмо от Турмана Агамонда.‡Findet Yvette Farthing und bringt Ihr den Brief von Thurman Agamand.‡이베트 파딩을 찾아서 투르만 아가만드가 쓴 편지를 전해줘야 합니다.‡Encuentra a Yvette Lontananza y entrégale la carta de Thurman Agamand.‡Encuentra a Yvette Farthing y entrégale la carta de Thurman Agamand.‡Trouver Yvette Farthing. Lui donner la lettre de Thurman Agamand.‡找到伊维特·法席恩，将萨尔曼·阿加曼德的信交给她。‡找到伊維特·法席恩，將薩爾曼·阿加曼德的信交給她。',
  }
},
[362] = {
  {
    'Os moinhos assombrados‡Мельницы с привидениями‡Die Spuk-Mühle‡밀농장의 유령‡Los molinos fantasma‡Los molinos fantasma‡Les Moulins Hantés‡闹鬼的磨坊‡鬧鬼的磨坊',
    nil,
    'Mate Delmiro Agamand e leve os Restos Mortais de Delmiro para Eurico Palhares em Montalvo.‡Убейте Девлина Агамонда и принесите его останки Колману Фартингу в Брилл.‡Erschlagt Devlin Agamand und bringt Devlins Überreste zu Coleman Farthing nach Brill.‡데블린을 처치한 후 그 유골을 브릴에 있는 콜만 파딩에게 가져가야 합니다.‡Acaba con Devlin Agamand y llévale los restos de Devlin a Coleman Lontananza, que está en Rémol.‡Acaba con Devlin Agamand y llévale los restos de Devlin a Coleman Farthing en Rémol.‡Tuer Devlin Agamand et ramener ses restes à Coleman Farthing à Brill.‡杀死代弗林·阿加曼德，然后将代弗林的遗骸交给布瑞尔的库勒曼·法席恩。‡殺死代弗林·阿加曼德，然後將代弗林的遺骸交給布瑞爾的庫勒曼·法席恩。',
  }
},
[363] = {
  {
    'Despertar bruto‡Резкое пробуждение‡Unsanftes Erwachen‡각성의 시간‡Desvelo brutal‡Desvelo brutal‡Réveil brutal‡突然醒来‡突然醒來',
    nil,
    'Fale com o Sacerdote Sombrio Sarvis.‡Поговорите с жрецом Тьмы Сарвисом.‡Sprecht mit Schattenpriester Sarvis.‡어둠의사제 사비스와 대화해야 합니다.‡Habla con el sacerdote de las Sombras Sarvis.‡Habla con el sacerdote de las Sombras Sarvis.‡Parler au prêtre des ombres Sarvis.‡和暗影牧师萨维斯谈一谈。‡和暗影牧師薩維斯談壹談。',
  }
},
[364] = {
  {
    'Os desmiolados‡Безмозглые твари‡Die Hirnlosen‡넋 나간 좀비‡Los autómatas‡Los autómatas‡Les Déchus‡无脑的僵尸‡無腦的僵屍',
    nil,
    'O Sacerdote Sombrio Sarvis quer que você mate 8 Zumbis Desmiolados e 8 Zumbis Atormentados.‡Жрец Тьмы Сарвис хочет, чтобы вы убили 8 безмозглых зомби и 8 презренных зомби.‡Schattenpriester Sarvis will, dass Ihr 8 hirnlose Zombies und 8 elende Zombies tötet.‡어둠의사제 사비스가 넋 나간 좀비 8명과 흉측한 좀비 8명을 처치해 달라고 부탁했습니다.‡El sacerdote de las sombras Sarvis quiere que mates 8 zombis descerebrados y 8 zombis espantosos.‡El sacerdote de las sombras Sarvis quiere que mates 8 zombis descerebrados y 8 zombis espantosos.‡Le prêtre des ombres Sarvis veut que vous tuiez 8 Zombies lunatiques et 8 Zombies décharnés.‡暗影牧师萨维斯让你杀掉8个无脑的僵尸和8个丑陋的僵尸。‡暗影牧師薩維斯讓妳殺掉8個無腦的僵屍和8個醜陋的僵屍。',
  }
},
[365] = {
  {
    'Campos de mágoa‡Поля горя‡Felder des Kummers‡오염된 농장‡Campos de pena‡Campos de pena‡Les Champs du Chagrin‡悲伤之地‡悲傷之地',
    nil,
    'Roube 10 abóboras da fazenda a oeste, que fica ao norte de Plangemortis, e leve-as para o Boticário Joaquino em Montalvo.‡Украдите 10 тыкв с западной фермы, к северу от Могильника. Потом отнесите эти тыквы аптекарю Юхану в Брилл.‡Stehlt 10 Kürbisse vom Gehöft im Westen, direkt nördlich von Deathknell und bringt sie zu Apotheker Johann nach Brill.‡데스넬 북쪽에 있는 농장에서 티리스팔 호박을 10개 훔친 다음 브릴에 있는 연금술사 요한에게 가져가야 합니다.‡Roba 10 calabazas de la plantación que encontrarás en dirección oeste, justo al norte de Camposanto, y llévaselas al boticario Johaan a Rémol.‡Roba 10 calabazas de la plantación que encontrarás en dirección oeste, justo al norte de Camposanto, y llévaselas al boticario Johaan a Rémol.‡Volez 10 Potirons dans la ferme à l\'ouest, juste au nord du Glas, et apportez-les à l\'Apothicaire Johaan à Brill.‡从位于布瑞尔西边、丧钟镇北边的农场中偷10颗南瓜来，把它们交给布瑞尔的药剂师乔汉。‡從位於布瑞爾西邊、喪鐘鎮北邊的農場中偷10顆南瓜來，把它們交給布瑞爾的藥劑師喬漢。',
  }
},
[366] = {
  {
    'Devolva o livro‡Книга Гюнтера‡Rückgabe des Buches‡마법책 반납‡Devuelve el libro‡Devuelve el libro‡Ramener le livre‡归还书籍‡歸還書籍',
    nil,
    'Devolva o Grimório de Tertuliano a ele, na ilha do Refúgio de Tertuliano.‡Верните Гюнтеру книгу заклинаний. Его можно найти на острове, в приюте Гюнтера.‡Bringt Gunthers Zauberbuch zu ihm auf die "Gunthers Zufluchtsort" genannte Insel zurück.‡군터의 은거지로 가서 군터의 마법책을 돌려주어야 합니다.‡Devuélvele el libro de hechizos de Gunther a su dueño, que se encuentra en la isla del Refugio de Gunther.‡Devuélvele el libro de hechizos de Gunther a su dueño, que se encuentra en la isla del Refugio de Gunther.‡Ramener son livre de sorts à Gunther, dans sa retraite sur son île.‡到冈瑟尔居住的小岛去归还他的法术书。‡到岡瑟爾居住的小島去歸還他的法術書。',
  }
},
[367] = {
  {
    'A nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'O Boticário Joaquino na cidade de Montalvo quer que você colete 5 Ampolas de Sangue de Cão das Trevas.‡Принесите аптекарю Юхану 5 склянок крови псов тьмы.‡Apotheker Johaan in der Stadt Brill möchte, dass Ihr 5 Phiolen Schattenhundblut sammelt.‡브릴에 있는 연금술사 요한이 암흑사냥개 피 5병을 가져다 달라고 부탁했습니다.‡El boticario Johaan de Rémol quiere que recojas 5 viales de sangre de can oscuro.‡El boticario Johaan de Rémol quiere que recojas 5 viales de sangre de can oscuro.‡Collecter 5 fioles de Sang de sombredogues pour l\'Apothicaire Johaan de la ville de Brill.‡布瑞尔镇里的药剂师乔汉要求你收集5瓶黑暗犬的血液。‡布瑞爾鎮裏的藥劑師喬漢要求妳收集5瓶黑暗犬的血液。',
  }
},
[368] = {
  {
    'A nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'O Boticário Joaquino na cidade de Montalvo precisa de 5 Escamas de Pinavil dos Murlocs das Clareiras de Tirisfal.‡Принесите аптекарю Юхану из Брилла 5 чешуек мурлоков из племени Злобного Плавника из Тирисфальских лесов.‡Apotheker Johaan in der Stadt Brill benötigt 5 Finsterflossenschuppen von den Murlocs in Tirisfal.‡브릴에 있는 연금술사 요한이 티리스팔 숲에 있는 썩은지느러미멀록 비늘 5개를 가져다 달라고 부탁했습니다.‡El boticario Johaan de Rémol necesita 5 escamas de Anca Vil de los murlocs de los Claros de Tirisfal.‡El boticario Johaan de Rémol necesita 5 escamas de Anca Vil de los múrlocs de los Claros de Tirisfal.‡L\'Apothicaire Johaan de la ville de Brill a besoin de 5 Ecailles d\'Aileron noir prises sur les murlocs des Clairières de Tirisfal.‡布瑞尔镇里的药剂师乔汉要求你收集5片提瑞斯法林地的邪鳍鱼人的鳞片。‡布瑞爾鎮裏的藥劑師喬漢要求妳收集5片提瑞斯法林地的邪鰭魚人的鱗片。',
  }
},
[369] = {
  {
    'A nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'O Boticário Joaquino na cidade de Montalvo quer que você leve 4 amostras de peçonha da Trevateia Malévola para ele.‡Принесите аптекарю Юхану из Брилла 4 образца яда злобного ночного кругопряда.‡Apotheker Johaan in der Stadt Brill möchte, dass Ihr ihm 4 Proben vom Gift eines heimtückischen Nachtwebers bringt.‡브릴에 있는 연금술사 요한이 흉포한 검은그물거미의 독 4개를 가져다 달라고 부탁했습니다.‡El boticario Johaan de Rémol quiere que le lleves 4 muestras de veneno de nocturácnida sanguinaria.‡El boticario Johaan de Rémol quiere que le lleves 4 muestras de veneno de nocturácnida sañosa.‡L\'Apothicaire Johaan de la ville de Brill désire que vous lui rameniez 4 échantillons de Venin de Tisse-nuit vicieuse.‡布瑞尔镇里的药剂师乔汉要你去收集4份邪恶的夜行蜘蛛的毒液样本。‡布瑞爾鎮裏的藥劑師喬漢要妳去收集4份邪惡的夜行蜘蛛的毒液樣本。',
  }
},
[370] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Im Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En Guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano em Montalvo quer que você mate o Capitão Perrine, 3 Zelotes Escarlates e 3 Missionários Escarlates.‡Убейте капитана Перрина, 3 ревнителей и 3 миссионеров из Алого ордена по просьбе палача Зуганда.‡Exekutor Zygand in Brill möchte, dass Ihr Captain Perrine, 3 Scharlachrote Zeloten und 3 Scharlachrote Missionare tötet.‡브릴에 있는 집행관 자이건드가 대장 페린, 붉은십자군 광신도 3명, 붉은십자군 선교사 3명을 처치해 달라고 부탁했습니다.‡El ejecutor Zygand de Rémol quiere que mates al capitán Perrine, 3 integristas Escarlata y 3 misioneros Escarlata.‡El ejecutor Zygand de Rémol quiere que mates al capitán Perrine, a 3 zelotes Escarlata y a 3 misioneros Escarlata.‡Tuer le capitaine Perrine ainsi que 3 Zélotes écarlates et 3 Missionnaires écarlates.‡布瑞尔的执行官塞加德要求你杀掉派瑞恩队长、3名血色狂热者和3名血色传教士。‡布瑞爾的執行官塞加德要求妳殺掉派瑞恩隊長、3名血色狂熱者和3名血色傳教士。',
  }
},
[371] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En Guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano em Montalvo ordenou que você mate o Capitão Vidálio e 5 Frades Escarlates.‡Убейте капитана Вакона и пятерых келейников из Алого ордена по заданию палача Зуганда.‡Exekutor Zygand in Brill hat Euch damit beauftragt, Captain Vachon und 5 Scharlachrote Ordensmitglieder zu erschlagen.‡브릴에 있는 집행관 자이건드가 대장 바콘과 붉은십자군 수사 5명을 처치하라고 명령했습니다.‡El ejecutor Zygand de Rémol te ha encargado que mates al capitán Vachon y a 5 frailes Escarlata.‡El ejecutor Zygand de Rémol te ha encargado que mates al capitán Vachon y a 5 frailes Escarlata.‡L\'Exécuteur Zygand de Brill vous a chargé de liquider le capitaine Vachon et 5 Frères écarlates.‡布瑞尔的执行官塞加德要求你杀掉瓦松队长和5名血色苦行修士。‡布瑞爾的執行官塞加德要求妳殺掉瓦松隊長和5名血色苦行修士。',
  }
},
[372] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En Guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano na cidade de Montalvo quer que você mate o Capitão Metrache e seus dois seguranças.‡По просьбе палача Зуганда убейте капитана Мелраша и двух его телохранителей.‡Exekutor Zygand in der Stadt Brill möchte, dass Ihr Captain Melrache und seine beiden Leibwachen ermordet.‡브릴 마을에 있는 집행관 자이건드가 대장 멜라케와 붉은십자군 경호원 2명을 처치해 달라고 부탁했습니다.‡El ejecutor Zygand de Rémol quiere que asesines al capitán Melrache y a sus dos guardaespaldas.‡El ejecutor Zygand de Rémol quiere que asesines al capitán Melrache y a sus dos guardaespaldas.‡Assassiner le capitaine Melrach et ses deux gardes du corps pour l\'Exécuteur Zygand de la ville de Brill.‡布瑞尔的执行官塞加德要求你刺杀麦拉其队长及他的两名保镖。‡布瑞爾的執行官塞加德要求妳刺殺麥拉其隊長及他的兩名保鏢。',
  }
},
[373] = {
  {
    'Uma carta não enviada‡Неотправленное письмо‡Der nie verschickte Brief‡부치지 않은 편지‡La carta sin enviar‡La carta sin enviar‡La lettre non envoyée‡未寄出的信‡未寄出的信',
    nil,
    'Entregue a Carta para o Arquiteto da Cidade a Baros Aleixo em Ventobravo.‡Доставьте письмо городскому архитектору Баросу Алекстону в Штормград.‡Bringt den Brief nach Stormwind zum Stadtarchitekten Baros Alexston.‡스톰윈드에 있는 도시 건축가 바로스 알렉스턴에게 편지를 전달해야 합니다.‡Entrega la carta destinada al arquitecto jefe a Baros Alexston en Ventormenta.‡Entrega la carta destinada al arquitecto jefe a Baros Alexston en Ventormenta.‡Livrer la lettre pour l\'Architecte de la Cité à Baros Alexston à Stormwind.‡将艾德温·范克里夫的信交给巴隆斯·阿历克斯顿。‡將艾德溫·範克裏夫的信交給巴隆斯·阿歷克斯頓。',
  }
},
[374] = {
  {
    'Prova da morte‡Доказательство верности‡Beweise des Ablebens‡죽음의 증거‡Prueba de la muerte‡Prueba de defunción‡Preuves de la mort‡死亡证明‡死亡證明',
    nil,
    '‡Принесите 10 алых перстней стражу смерти Берджесу в Брилл.‡Bringt Todeswache Burgess in Brill 10 scharlachrote Insignienringe.‡브릴에 있는 죽음의경비병 버제스에게 붉은십자군 반지 10개를 가져가야 합니다.‡Llévale 10 anillos con la insignia escarlata al guardia de la muerte Burgess de Rémol.‡Llévale 10 anillos con la insignia escarlata al Guardia de la Muerte Burgess de Rémol.‡Apporter 10 Anneaux de la Croisade écarlate au Garde noir Burgess à Brill.‡给布瑞尔的亡灵卫兵伯吉斯带回10枚血色十字军徽记之戒。‡給布瑞爾的亡靈衛兵伯吉斯帶回10枚血色十字軍徽記之戒。',
  }
},
[375] = {
  {
    'O frio da morte‡Смертельный холод‡Die Kälte des Todes‡죽음의 한기‡El frío de la muerte‡El frío de la muerte‡Le Frisson de la mort‡死亡之寒‡死亡之寒',
    nil,
    'Leve 5 Pelagens de Quiropúsculo e um pouco de Fio Grosso para Gretchen Dedamar em Montalvo.‡Принесите 5 шкурок сумеречницы и грубую нить Гретхен Дедмар в Брилл.‡Bringt Gretchen Dedmar in Brill fünf Nachtsaugerpelze und etwas groben Faden.‡브릴에 있는 그레첸 데드마에게 그늘박쥐 모피 5개와 굵은 실타래 1개를 가져가야 합니다.‡Llévale 5 pieles de murciumbrío y algunos hilos gruesos a Gretchen Dedmar, que está en Rémol.‡Llévale 5 pelambres de Murciumbrío y un hilo burdo a Gretchen Dedmar, que está en Rémol.‡Rapporter 5 Peaux de chauve-souris du crépuscule et une Bobine de fil grossier à Gretchen Dedmar à Brill.‡给布瑞尔的格雷森·戴德马带回5张夜行蝙蝠的毛皮和一些粗线。‡給布瑞爾的格雷森·戴德馬帶回5張夜行蝙蝠的毛皮和壹些粗線。',
  }
},
[376] = {
  {
    'Os malditos‡Проклятые‡Die Verdammten‡저주받은 존재‡Los Malditos‡Los Malditos‡Les Maudits‡被诅咒者‡被詛咒者',
    nil,
    'A Noviça Elvira precisa de 6 Patas de Carniceiro e 6 Asas de Quiropúsculo.‡Ученице Элрет нужно 6 лап падальщика и 6 крыльев сумеречницы.‡Novize Elreth benötigt 6 Aasfressertatzen und 6 Nachtsaugerflügel.‡수련사제 엘레스가 승냥이 앞발 6개와 그늘박쥐 날개 6개를 구해다 달라고 부탁했습니다.‡La novicia Elreth requiere 6 garras de carroñero y 6 alas de murciumbrío.‡La novicia Elreth requiere 6 garras de carroñero y 6 alas de murciumbrío.‡La novice Elreth a besoin de 6 Pattes de charognard et de 6 Ailes de chauve-souris du crépuscule.‡新兵艾尔雷斯需要6只食腐狼的爪子和6只夜行蝙蝠翼。‡新兵艾爾雷斯需要6只食腐狼的爪子和6只夜行蝙蝠翼。',
  }
},
[377] = {
  {
    'Crime e castigo‡Преступление и наказание‡Verbrechen und Strafe‡죄와 벌‡Crimen y castigo‡Crimen y castigo‡Crime et Châtiments‡罪与罚‡罪與罰',
    nil,
    'O Conselheiro Millstipe da Vila Sombria quer que você leve a mão de Flávio Lúcio para ele.‡Принесите советнику Миллстайпу руку Декстрена Варда.‡Ratsherr Millstipe von Dunkelhain will, dass Ihr ihm die Hand von Dextren Ward bringt.‡다크샤이어의 원로 밀스타이프가 덱스트렌 워드를 처치한 후 그의 장갑을 가져다 달라고 부탁했습니다.‡El consejero Tallolino de Villa Oscura quiere que le lleves la mano de Dextren Tutor.‡El consejero Tallolino de Villa Oscura quiere que le lleves la mano de Dextren Ward.‡Le conseiller Millstipe de Darkshire désire que vous lui rameniez la main de Dextren Ward.‡夜色镇的米尔斯迪普议员要你杀死迪克斯特·瓦德，并把他的手带回来作为证明。‡夜色鎮的米爾斯迪普議員要妳殺死迪克斯特·瓦德，並把他的手帶回來作為證明。',
  }
},
[378] = {
  {
    'Fúria profunda‡Успокоить гневливого‡Tief empfundener Zorn‡격노‡La furia mora en las profundidades‡La furia mora en las profundidades‡Fureur dans les Profondeurs‡卡姆·深怒‡卡姆·深怒',
    nil,
    'Rocio Garmason quer que você leve a cabeça de Kam Fundafúria para ele em Dun Modr.‡Принесите голову Кама Гневливого Мотли Каменщику в Дун Модр.‡Motley Garmason in Dun Modr verlangt Kam Deepfurys Kopf.‡딥퓨리를 처치하고 그 증거로 그의 머리카락을 던 모드르에 있는 모틀리 가마슨에게 가져가야 합니다.‡Motley Garmason quiere que le lleves la cabeza de Kam Furiahonda a Dun Modr.‡Motley Garmason quiere que le lleves la cabeza de Kam Furiahonda a Dun Modr.‡Rapportez la tête de Kam Deepfury à Motley Garmason à Dun Modr.‡丹莫德的莫特雷·加玛森要求你把卡姆·深怒的头颅交给他。‡丹莫德的莫特雷·加瑪森要求妳把卡姆·深怒的頭顱交給他。',
  }
},
[379] = {
  {
    'Mate a sede‡Утолить жажду‡Durstlöscher‡갈증 해소‡Aplacar esa sed‡Aplacar esa sed‡Etancher cette soif‡口渴的比格维兹‡口渴的比格維茲',
    nil,
    'Leve 5 Bolsas de Água do Errante para o Engenheiro-chefe Silvadágua em Geringontzan.‡Найдите 5 бурдюков с водой Скитальцев Пустыни главному инженеру Чепухастеру в Прибамбасск.‡Bringt Chefingenieur Bilgewhizzle in Gadgetzan 5 Wasserbeutel eines Wüstenläufers.‡가젯잔에 있는 선임기술자 빌지위즐에게 사막유랑단 물주머니 5개를 가져가야 합니다.‡Llévale 5 bolsas de agua de los Deambuladores al ingeniero jefe Silvaina, que está en Gadgetzan.‡Llévale 5 faltriqueras de agua de Vagayermos al ingeniero jefe Pasaquillas, en Gadgetzan.‡Rapporter 5 Outres de Bat-le-désert à l\'ingénieur en chef Bilgewhizzle à Gadgetzan.‡给加基森的首席工程师沙克斯·比格维兹带去五只废土水袋。‡給加基森的首席工程師沙克斯·比格維茲帶去五只廢土水袋。',
  }
},
[380] = {
  {
    'Vale Teia da Noite‡Паучья низина‡Nachtweber‡검은그물 거미굴‡Hoya Nocturácnidas‡Hoya Nocturácnidas‡Les grottes des Tisse-nuit‡夜行蜘蛛洞穴‡夜行蜘蛛洞穴',
    nil,
    'O Executor Arren quer que você mate 10 Trevateias Jovens e 8 Trevateias.‡Палач Аррен хочет, чтобы вы убили 10 молодых ночных кругопрядов и 8 ночных кругопрядов.‡Exekutor Arren will, dass Ihr 10 junge Nachtweber und 8 Nachtweber tötet.‡집행관 아렌이 새끼 검은그물거미 10마리와 검은그물거미 8마리를 처치해 달라고 부탁했습니다.‡El ejecutor Arren quiere que mates 10 nocturánidas jóvenes y 8 arañas nocturánidas.‡El ejecutor Arren quiere que mates 10 nocturácnidas jóvenes y 8 arañas nocturácnidas.‡L’Exécuteur Arren veut que vous tuiez 10 Jeunes Tisse-nuit et 8 Araignées Tisse-nuit.‡执行官阿伦要你去杀掉10只小夜行蜘蛛和8只夜行蜘蛛。‡執行官阿倫要妳去殺掉10只小夜行蜘蛛和8只夜行蜘蛛。',
  }
},
[381] = {
  {
    'A Cruzada Escarlate‡Алый орден‡Der Scharlachrote Kreuzzug‡붉은십자군‡La Cruzada Escarlata‡La Cruzada Escarlata‡La Croisade écarlate‡血色十字军‡血色十字軍',
    nil,
    'Leve 12 Braçadeiras Escarlates de Neófitos Escarlates e Iniciados Escarlates para o Executor Arren.‡Принесите палачу Аррену 12 алых поручей, сняв их с новообращенных и посвященных из Алого ордена.‡Bringt Exekutor Arren insgesamt 12 scharlachrote Armbinden von scharlachroten Konvertiten und scharlachroten Initianden.‡집행관 아렌에게 붉은십자군 순례자와 붉은십자군 견습마법사에게서 붉은십자군 완장 12개를 가져가야 합니다.‡Lleva al ejecutor Arren 12 brazaletes Escarlata de convertidos Escarlata y de iniciados Escarlata.‡Lleva al ejecutor Arren 12 bandas Escarlata de conversos Escarlata y de iniciados Escarlata.‡Apporter à l’Exécuteur Arren 12 Bracelets écarlates, que vous trouverez sur des Convertis écarlates et des Initiés écarlates.‡从血色信徒和血色新兵身上收集12枚血色十字军臂章，把它们交给执行官阿伦。‡從血色信徒和血色新兵身上收集12枚血色十字軍臂章，把它們交給執行官阿倫。',
  }
},
[382] = {
  {
    'O mensageiro escarlate‡Красный гонец‡Der Rote Bote‡붉은십자군 전령‡El mensajero rojo‡El mensajero rojo‡Le messager rouge‡十字军信使‡十字軍信使',
    nil,
    'Mate Meven Korgal, o mensageiro, no acampamento da Cruzada, e leve as informações que encontrar para o Executor Arren.‡Убейте гонца Мевена Коргала в лагере Алого ордена, а потом передайте перехваченные известия палачу Аррену.‡Tötet Meven Korgal, den Boten, im Lager der Kreuzzügler und kehrt danach mit allen Informationen, die Ihr findet, zu Exekutor Arren zurück.‡붉은십자군 야영지에 있는 전령 메븐 코갈을 처치한 다음 입수한 정보를 집행관 아렌에게 가져가야 합니다.‡Mata a Meven Korgal, el mensajero, en el campamento de los Cruzados y vuelve a comunicar al ejecutor Arren cualquier información que encuentres.‡Mata a Meven Korgal, el mensajero, en el campamento de los Cruzados y vuelve a comunicar al ejecutor Arren cualquier información que encuentres.‡Tuer Meven Korgal, le messager, au camp de la Croisade, puis ramener toutes les informations trouvées à l\'Exécuteur Arren.‡到十字军营地去杀掉信使迈文·考加尔，将你发现的情报交给执行官阿伦。‡到十字軍營地去殺掉信使邁文·考加爾，將妳發現的情報交給執行官阿倫。',
  }
},
[383] = {
  {
    'Informações cruciais‡Важные разведданные‡Entscheidende Informationen‡중요한 정보‡Información decisiva‡Información decisiva‡Informations décisives‡重要情报‡重要情報',
    nil,
    'Entregue os Documentos da Cruzada Escarlate ao Executor Zigano, em Montalvo.‡Отнесите бумаги Алого ордена палачу Зуганду в Брилл.‡Bringt die Dokumente des Scharlachroten Kreuzzugs zu Exekutor Zygand nach Brill.‡브릴에 있는 집행관 자이건드에게 붉은십자군 문서를 전달해야 합니다.‡Ve a Rémol y entrega los documentos de la Cruzada Escarlata al ejecutor Zygand.‡Ve a Rémol y entrega los documentos de la Cruzada Escarlata al ejecutor Zygand.‡Livrer les documents de la Croisade écarlate à l\'Exécuteur Zygand à Brill.‡把血色十字军文件交给布瑞尔的执行官塞加德。‡把血色十字軍文件交給布瑞爾的執行官塞加德。',
  }
},
[384] = {
  {
    'Costelinhas de javali na cerveja‡Кабаньи ребрышки в пиве‡Eberrippchen in Biersauce‡맥주로 양념한 멧돼지 갈비‡Costillas de jabalí a la cerveza‡Costillas de jabalí a la cerveza‡Côtes de sanglier à la bière‡啤酒烤猪排‡啤酒烤豬排',
    nil,
    'Ragnar Cervaforte, em Kharanos, quer que você lhe traga 6 Costeletas de Rochetusco e uma caneca de Malte Rapsódia.‡Принесите 6 ребер скального вепря и кружку "Болтливого пива" Рагнару Громовару в Караносе.‡Ragnar Donnerbräu in Kharanos benötigt 6 Klippeneberrippchen und einen Krug Rhapsody-Malzbier.‡카라노스에 있는 라그나르 썬더브루가 멧돼지 갈비 6개와 랩소디 몰트 한 병을 구해다 달라고 부탁했습니다.‡Ragnar Cebatruenos de Kharanos quiere 6 costillas de jabalí del risco y una jarra de malta rapsódica.‡Ragnar Cebatruenos de Kharanos quiere 6 costillas de jabalí del risco y una jarra de malta rapsódica.‡Ragnar Thunderbrew à Kharanos veut 6 Côtes de sangliers des rochers et une Chope de bière au malt Rhapsody.‡卡拉诺斯的拉格纳·雷酒需要6块峭壁野猪肋排和1杯狂想麦酒。‡卡拉諾斯的拉格納·雷酒需要6塊峭壁野豬肋排和1杯狂想麥酒。',
  }
},
[385] = {
  {
    'Crocoliscos na mira‡Охота на кроколисков‡Krokiliskenjagd‡악어 사냥‡La caza de crocoliscos‡La caza de crocoliscos‡Chasse aux crocilisques‡捕猎鳄鱼‡捕獵鱷魚',
    nil,
    'Obtenha 5 peças de Carne de Crocolisco e 6 Peles de Crocolisco para Marek Ferrocordis no Pavilhão dos Andarilhos.‡Принесите Мареку Железносерду в Приют Странников 5 кусков мяса кроколиска и 6 шкур кроколиска.‡Besorgt 5 Stücke Krokiliskenfleisch und 6 Krokiliskenhäute für Marek Ironheart in der Weitschreiter-Lodge.‡순찰자의 오두막에 있는 마렉 아이언하트에게 악어 고기 5개와 악어 가죽 6개를 가져다주어야 합니다.‡Lleva 5 piezas de carne de crocolisco y 6 pieles de crocolisco a Marek Coracero, que está en la Cabaña del Errante.‡Lleva 5 piezas de carne de crocolisco y 6 pieles de crocolisco a Marek Coracero, en la Cabaña del Errante.‡Trouver 5 morceaux de Viande de cocilisque et 6 Peaux de crocilisque pour Marek Ironheart au pavillon des pérégrins.‡收集5块鳄鱼肉和6张鳄鱼皮，把它们交给旅行者营地里的马雷克·铁心。‡收集5塊鱷魚肉和6張鱷魚皮，把它們交給旅行者營地裏的馬雷克·鐵心。',
  }
},
[386] = {
  {
    'Tudo que vai...‡Что происходит?‡Verbrechen lohnt sich nicht‡사필귀정‡Lo que sucece alrededor…‡Lo que sucede alrededor...‡Ce qui se passait ailleurs…‡伸张正义‡伸張正義',
    nil,
    'Leve a cabeça de Targorr, o Horror para o Guarda Berto em Vila Plácida.‡Принесите голову Таргорра Ужасного стражнику Бертону в Приозерье.‡Bringt Wache Berton in Seenhain den Kopf von Targorr dem Schrecklichen.‡흉악범 타고르를 처치한 후 그 증거로 그의 머리카락을 레이크샤이어에 있는 경비병 베르턴에게 가져가야 합니다.‡Lleva la cabeza de Targor el Horror al guardia Berton a Villa del Lago.‡Lleva la cabeza de Targorr el Pavoroso al guardia Berton a Villa del Lago.‡Ramener la tête de Targorr le Terrifiant au Garde Berton à Lakeshire.‡把塔格尔的头颅带给湖畔镇的卫兵伯尔顿。‡把塔格爾的頭顱帶給湖畔鎮的衛兵伯爾頓。',
  }
},
[387] = {
  {
    'Sufoque a rebelião‡Подавление бунта‡Niederschlagung des Aufstandes‡폭동 진압‡Detener el motín‡Detener el motín‡Écraser la rébellion‡镇压暴动‡鎮壓暴動',
    nil,
    'O Carcereiro-chefe Thelágua de Ventobravo quer que você mate 10 Défias Prisioneiros, 8 Défias Condenados e 8 Défias Insurgentes em O Cárcere.‡Тюремщик Телвотер просит вас убить в тюрьме 10 узников из Братства Справедливости, 8 каторжников из Братства Справедливости и 8 мятежников из Братства Справедливости.‡Aufseher Thelwater aus Stormwind will, dass Ihr im Verlies 10 gefangene Defias, 8 eingekerkerte Defias und 8 Aufrührer der Defias tötet.‡스톰윈드에 있는 교도소장 델워터가 지하감옥에서 데피아즈단 복역수 10명, 데피아즈단 무기징역수 8명, 데피아즈단 반역자 8명을 처치해 달라고 부탁했습니다.‡El alcaide Thelagua de Ventormenta quiere que mates 10 prisioneros Defias, 8 presidiarios Defias y 8 insurgentes Defias en las Mazmorras.‡El celador Thelagua de Ventormenta quiere que mates 10 prisioneros Defias, 8 presidiarios Defias y 8 insurgentes Defias en Las Mazmorras.‡Tuer 10 Prisonniers défias, 8 Détenus défias et 8 Insurgés défias dans la Prison pour le Gardien Thelwater de Stormwind.‡暴风城的典狱官塞尔沃特要求你杀死监狱中的10名迪菲亚囚徒、8名迪菲亚罪犯和8名迪菲亚叛军。‡暴風城的典獄官塞爾沃特要求妳殺死監獄中的10名迪菲亞囚徒、8名迪菲亞罪犯和8名迪菲亞叛軍。',
  }
},
[388] = {
  {
    'A cor do sangue‡Цвет крови‡Die Farbe von Blut‡피의 색‡El color de la sangre‡El color de la sangre‡La couleur du Sang‡鲜血的颜色‡鮮血的顏色',
    nil,
    'Nikova Raskol, de Ventobravo, quer que você colete 10 Bandanas Vermelhas de Lã.‡Принесите Никове Раскол 10 красных шерстяных бандан.‡Nikova Raskol von Stormwind will, dass Ihr 10 rote Wollkopftücher für sie sammelt.‡스톰윈드에 있는 니코바 라스콜이 붉은 양모 복면을 10개를 모아 달라고 부탁했습니다.‡Nikova Raskol, de Ventormenta, quiere que consigas 10 pañuelos de lana roja.‡Nikova Raskol, de Ventormenta, quiere que consigas 10 pañuelos de lana roja.‡Rapporter 10 foulards en laine rouge à Nikova Raskol de Stormwind.‡暴风城的尼科瓦·拉斯克要你取得10条红色毛纺面罩。‡暴風城的尼科瓦·拉斯克要妳取得10條紅色毛紡面罩。',
  }
},
[389] = {
  {
    'Basílio Taborda‡Базиль Тредд‡Bazil Thredd‡바질 스레드‡Bazil Thredd‡Bazil Thredd‡Bazil Thredd‡巴吉尔·特雷德‡巴吉爾·特雷德',
    nil,
    'Fale com o Carcereiro-chefe Thelágua no Cárcere.‡Поговорите с надзирателем Телвотером в тюрьме.‡Sprecht mit Aufseher Thelwater im Verlies.‡감옥에 있는 교도소장 델워터와 대화해야 합니다.‡Habla con el alcaide Thelagua en las Mazmorras.‡Habla con el celador Thelagua en las Mazmorras.‡Parler au gardien Thelwater à la prison.‡与监狱的典狱官塞尔沃特谈一谈。‡與監獄的典獄官塞爾沃特談壹談。',
  }
},
[390] = {
  {
    '‡‡‡‡‡<UNUSED>‡‡‡',
    nil,
    nil,
  }
},
[391] = {
  {
    'Rebelião no Cárcere‡Бунтовщики в тюрьме‡Aufstand im Verlies‡감옥 폭동‡El motín de las Mazmorras‡El motín de Las Mazmorras‡Les Emeutes de la Prison‡监狱暴动‡監獄暴動',
    nil,
    'Mate Basílio Taborda e leve a cabeça dele para o Carcereiro-chefe Thelágua no Cárcere.‡Убейте Базиля Тредда и принесите его голову Телвотеру в тюрьму Штормграда.‡Tötet Bazil Thredd und bringt seinen Kopf mit zurück zu Aufseher Thelwater im Verlies.‡바질 스레드를 처치하고 그 증거로 그의 머리카락을 감옥에 있는 교도소장 델워터에게 가져가야 합니다.‡Mata a Bazil Thredd y lleva su cabeza al alcaide Thelagua en las Mazmorras.‡Mata a Bazil Thredd y lleva su cabeza al celador Thelagua en las Mazmorras.‡Tuer Bazil Thredd et ramener sa tête au Gardien Thelwater à la Prison.‡杀死巴基尔·斯瑞德，把他的头带给监狱的典狱官塞尔沃特。‡殺死巴基爾·斯瑞德，把他的頭帶給監獄的典獄官塞爾沃特。',
  }
},
[392] = {
  {
    'Visitante suspeito‡Таинственный посетитель‡Der seltsame Besucher‡수상한 면회인‡Extraño visitante‡Extraño visitante‡Un curieux visiteur‡好奇的访客‡好奇的訪客',
    nil,
    'Leve a Descrição da Visita do Taborda Lacrada para Baros Aleixo em Ventobravo.‡Отнесите запечатанное описание посетителя Тредда Баросу Алекстону в Штормград.‡Bringt die versiegelte Beschreibung von Thredds Besucher nach Stormwind zu Baros Alexston.‡스톰윈드에 있는 바로스 알렉스턴에게 스레드의 방문객에 대한 봉인된 인상서를 전해줘야 합니다.‡Lleva la descripción sellada del visitante de Thredd al Baros Alexton en Ventormenta.‡Lleva la descripción del visitante de Thredd lacrada a Baros Alexston en Ventormenta.‡Apporter la description du visiteur de Thredd à Baros Alexston à Stormwind.‡将神秘访客的资料交给暴风城的巴隆斯·阿历克斯顿。‡將神秘訪客的資料交給暴風城的巴隆斯·阿歷克斯頓。',
  }
},
[393] = {
  {
    'Sombra do passado‡Тень прошлого‡Schatten der Vergangenheit‡과거의 그림자‡Sombras del pasado‡Sombras del pasado‡Les Ombres du Passé‡往日的阴影‡往日的陰影',
    nil,
    'Leve a Descrição da Visita do Taborda Lacrada para o Mestre Mathias Shaw em Ventobravo.‡Отнесите запечатанное описание посетителя Тредда Матиасу Шоу в Штормград.‡Bringt die versiegelte Beschreibung von Thredds Besucher nach Stormwind zu Meister Mathias Shaw.‡스톰윈드에 있는 단장 마티아스 쇼에게 스레드의 방문객에 대한 봉인된 인상서를 전해줘야 합니다.‡Lleva la descripción sellada del visitante de Thredd al maestro Mathias Shaw en Ventormenta.‡Lleva la descripción del visitante de Thredd lacrada al maestro Mathias Shaw en Ventormenta.‡Apporter la Description scellée du visiteur de Thredd au Maître Mathias Shaw à Stormwind.‡与旧城区的马迪亚斯·肖尔谈一谈。‡與舊城區的馬迪亞斯·肖爾談壹談。',
  }
},
[394] = {
  {
    'A cabeça da fera‡Голова чудовища‡Der Kopf des Ganzen‡잔인한 자의 최후‡La cabeza de la bestia‡La cabeza de la bestia‡La tête de la bête‡禽兽的首级‡禽獸的首級',
    nil,
    'Fale com Mathias Shaw em Ventobravo.‡Поговорите с Матиасом Шоу в Штормграде.‡Sprecht mit Mathias Shaw in Stormwind.‡스톰윈드에 있는 마티아스 쇼와 대화해야 합니다.‡Habla con Mathias Shaw en Ventormenta.‡Habla con Mathias Shaw en Ventormenta.‡Parler à Mathias Shaw, à Stormwind.‡去见暴风城旧城区的马迪亚斯·肖尔。‡去見暴風城舊城區的馬迪亞斯·肖爾。',
  }
},
[395] = {
  {
    'Fim da irmandade‡Гибель братства‡Das Ende der Bruderschaft‡데피아즈단의 종말‡El fin de la Hermandad‡El fin de la Hermandad‡La fin de la Confrérie‡兄弟会的灭亡‡兄弟會的滅亡',
    nil,
    'Fale com Baros Aleixo em Ventobravo.‡Поговорите с Баросом Алекстоном в Штормграде.‡Sprecht mit Baros Alexston in Stormwind.‡스톰윈드에 있는 바로스 알렉스턴과 대화하십시오.‡Habla con Baros Alexton en Ventormenta.‡Habla con Baros Alexston en Ventormenta.‡Parler à Baros Alexston à Stormwind.‡与暴风城的巴隆斯·阿历克斯顿谈一谈。‡與暴風城的巴隆斯·阿歷克斯頓談壹談。',
  }
},
[396] = {
  {
    'Uma audiência com o rei‡Аудиенция у короля‡Eine Audienz beim König‡국왕 알현‡Una audiencia con el Rey‡Una audiencia con el Rey‡Une audience avec le roi‡觐见国王‡覲見國王',
    nil,
    'Entregue o Relatório sobre a Irmandade Défias de Baros Aleixo ao Rei Varian Wrynn na Bastilha Ventobravo.‡Доставьте доклад Бароса Алекстона из Братства Справедливости королю Вариану Ринну в Крепость Штормграда.‡Liefert Baros Alexstons Bericht über die Bruderschaft der Defias bei König Varian Wrynn in der Burg Stormwind ab.‡스톰윈드 왕궁으로 가서 국왕 바리안 린에게 올릴 알렉스턴의 데피아즈단에 대한 보고서를 전달해야 합니다.‡Lleva el informe de Baros Alexston sobre la Hermandad Defias al rey Varian Wrynn en el Castillo de Ventormenta.‡Lleva el informe de Baros Alexston sobre la Hermandad Defias al rey Varian Wrynn en el Castillo de Ventormenta.‡Apporter le rapport de Baros Alexston sur la Confrérie Défias au Roi Varian Wrynn au Donjon de Stormwind.‡将有关迪菲亚兄弟会的报告送给暴风要塞里的国王瓦里安·乌瑞恩。‡將有關迪菲亞兄弟會的報告送給暴風要塞裏的國王瓦裏安·烏瑞恩。',
  }
},
[397] = {
  {
    'Atendimento nota 10‡За достойную службу‡Ihr habt uns gut gedient‡수고의 대가‡Nos has hecho un gran servicio‡Nos has hecho un gran servicio‡Vous nous avez bien servi‡干得好‡幹得好',
    nil,
    'Fale com Pingo, o lacaio de Malvino da Garra Preta, para receber sua recompensa.‡Поговорите с Згги, слугой Зардета Черного Когтя, чтобы получить награду.‡Sprecht mit Zggi, dem Diener von Zardeth von den Blackclaw, um Eure Belohnung zu erhalten.‡검은발톱 자데스의 하인인 즈기와 대화하여 보상을 받으십시오.‡Habla con Zggi, el sirviente de Zardeth de los Zarpanegra, para pedir tu recompensa.‡Habla con Zggi, el sirviente de Zardeth de los Zarpanegra, para pedir tu recompensa.‡Aller demander votre récompense en parlant à Zggi, le serviteur de Zardeth de Black Claw.‡去找黑爪加尔德斯的仆人兹吉谈一谈，并向他索要你的酬劳。‡去找黑爪加爾德斯的仆人茲吉談壹談，並向他索要妳的酬勞。',
  }
},
[398] = {
  {
    'Procura-se: Olho de Verme‡Разыскивается: Червеглаз‡GESUCHT: Madenauge‡구더기눈 현상수배‡Se busca: Ojo de gusano‡Se busca: Ojo de cresa‡On recherche : Œil-de-ver‡悬赏：蛆眼‡懸賞：蛆眼',
    nil,
    'Mate e leve a pata de Olho de Verme para o Executor Zigano em Montalvo para receber a recompensa.‡Убейте Червеглаза и отнесите палачу Зуганду в Брилл его лапу.‡Tötet Madenauge und kehrt dann mit seiner Tatze zu Exekutor Zygand nach Brill zurück, um eine Belohnung zu erhalten.‡구더기눈을 처치한 후 브릴에 있는 집행관 자이건드에게 돌아가 구더기눈의 앞발을 증거로 제출하고 보상을 받으십시오.‡Mata a Ojo de gusano y llévale su garra al ejecutor Zygand de Rémol para obtener una recompensa.‡Mata a Ojo de cresa y llévale su garra al ejecutor Zygand de Rémol para obtener una recompensa.‡Tuer Œil-de-ver et rapporter ses griffes à l\'Exécuteur Zygand pour toucher la récompense.‡杀死蛆眼，并将他的爪子交给布瑞尔的执行官塞加德以换取酬劳。‡殺死蛆眼，並將他的爪子交給布瑞爾的執行官塞加德以換取酬勞。',
  }
},
[399] = {
  {
    'Origens humildes‡Скромные дары прошлого‡Ein bescheidener Anfang‡초라한 시작‡Principios humildes‡Principios humildes‡Débuts modestes‡童年的记忆‡童年的記憶',
    nil,
    'Vá até a casa de Baros Aleixo em Cerro Oeste e procure sua bússola, então a entregue para ele na Praça da Catedral de Ventobravo.‡Обыщите дом Бароса Алекстона в Западном Крае, найдите компас и вернитесь на Соборную площадь Штормграда.‡Begebt Euch zu Baros Alexstons Haus in Westfall und sucht nach seinem Kompass. Übergebt ihm diesen dann am Kathedralenplatz von Stormwind.‡서부 몰락지대에 있는 바로스 알렉스턴의 집으로 가서 나침반을 찾은 다음 스톰윈드의 대성당 광장에 있는 바로스 알렉스턴에게 가져가야 합니다.‡Ve a la casa de Baros Alexston en Páramos del Poniente y busca su brújula. A continuación, llévasela al Distrito de la Catedral, en Ventormenta.‡Ve a la casa de Baros Alexston en los Páramos de Poniente y busca su brújula. A continuación, llévasela al Distrito de la Catedral, en Ventormenta.‡Aller à la maison de Baros Alexston dans la marche de l\'Ouest pour chercher sa boussole et lui rapporter à la place de la Cathédrale de Stormwind.‡到巴隆斯·阿历克斯顿在西部荒野的房子里去找到他的指南针，并将它带回暴风城的教堂广场交给他。‡到巴隆斯·阿歷克斯頓在西部荒野的房子裏去找到他的指南針，並將它帶回暴風城的教堂廣場交給他。',
  }
},
[400] = {
  {
    'Ferramentas para Gradaço‡Инструменты для Сталежара‡Werkzeuge für Steelgrill‡스틸그릴이 주문한 공구‡Herramientas para Brasacerada‡Herramientas para Brasacerada‡Des outils pour Steelgrill‡贝尔丁的工具‡貝爾丁的工具',
    nil,
    'Entregue as Ferramentas do Gradaço para Beldin Gradaço.‡Доставьте инструменты Белдину Сталежару.‡Liefert Beldin Steelgrill seine Werkzeuge.‡벨딘 스틸그릴에게 스틸그릴의 공구를 배달해야 합니다.‡Entrega las herramientas de Brasacerada a Beldin Brasacerada.‡Entrega las herramientas de Brasacerada a Beldin Brasacerada.‡Rapporter les outils de SteelGrill à Beldin Steelgrill.‡把贝尔丁的工具交给贝尔丁·钢架。‡把貝爾丁的工具交給貝爾丁·鋼架。',
  }
},
[401] = {
  {
    'Espere Sirra terminar‡Ожидание перевода‡Wartet, bis Sirra fertig ist‡시라의 번역 기다리기‡Espera a que Sirra acabe‡Espera a que Sirra acabe‡Attendre la fin des travaux de Sirra‡等待希拉完工‡等待希拉完工',
    nil,
    'Espere um pouco e então fale novamente com Sirra Von\'Indi.‡Подождите немного и снова поговорите с Широй Фон-Инди.‡Wartet einen Moment und sprecht dann erneut mit Sirra Von\'Indi.‡잠시 기다렸다가 시라 본인디와 다시 대화해야 합니다.‡Espera un momento y luego vuelve a hablar con Sirra Von\'Indi.‡Espera un momento y luego vuelve a hablar con Sirra Von\'Indi.‡Attendre un moment puis parler de nouveau avec Sirra Von\'Indi.‡稍等片刻，然后再和希拉·沃宁迪交谈。‡稍等片刻，然後再和希拉·沃寧迪交談。',
  }
},
[403] = {
  {
    'Cuidado com o barril‡Охраняемый бочонок громопойла‡Das bewachte Fass mit Donnerbier‡썬더브루 맥주통‡El barril de Cebatruenos custodiado‡El barril de Cebatruenos custodiado‡La garde du tonneau de Thunderbrew‡戒备森严‡戒備森嚴',
    nil,
    nil,
  }
},
[404] = {
  {
    'Uma tarefa podre‡Грязная работа‡Eine eitrige Aufgabe‡더러운 임무‡Una tarea pútrida‡Una tarea pútrida‡Une tâche putride‡腐烂的爪子‡腐爛的爪子',
    nil,
    'Traga 7 Garras Pútridas para o Necroguarda Dinis em Montalvo.‡Принесите 7 гнилых когтей стражу смерти Диллинжеру в Брилл.‡Bringt Todeswache Dillinger in Brill 7 eitrige Klauen.‡브릴에 있는 죽음의경비병 딜링거에게 썩은 발톱 7개를 가져가야 합니다.‡Llévale 7 garras pútridas al guardia de la muerte Dillinger de Rémol.‡Llévale 7 garras podridas al Guardia de la Muerte Dillinger de Rémol.‡Rapporter 7 Griffes putrides au Garde noir Dillinger à Brill.‡给布瑞尔的亡灵卫兵迪林格尔带回7只腐烂的爪子。‡給布瑞爾的亡靈衛兵迪林格爾帶回7只腐爛的爪子。',
  }
},
[405] = {
  {
    'O Lich pródigo‡Блудный лич‡Der abtrünnige Lich‡회개한 마술사‡El exánime pródigo‡El exánime pródigo‡La Liche prodigue‡流浪的巫妖‡流浪的巫妖',
    nil,
    'Apresente as Ordens de Sevren a Boanerges Stalactus na Cidade Baixa.‡Отнесите приказы Севрена Бетору Ледострелу в Подгород.‡Zeigt Bethor Iceshard in Undercity Sevrens Befehle.‡언더시티에 있는 베소르 아이스샤드에게 세브렌의 명령서를 보여 줘야 합니다.‡Comunícale las órdenes de Sevren a Bethor Duroyelo, que está en Entrañas.‡Comunícale las órdenes de Sevren a Bethor Duroyelo en Entrañas.‡Présenter les ordres de Sevren à Bethor Iceshard à Undercity.‡将塞弗伦的命令交给幽暗城的比索·埃斯沙德。‡將塞弗倫的命令交給幽暗城的比索·埃斯沙德。',
  }
},
