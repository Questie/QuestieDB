    nil,
  }
},
[7494] = {
  {
    'Domínio de Plumaluna‡Крепость Оперенной Луны‡Die Festung Feathermoon‡페더문 요새‡Bastión Plumaluna‡Bastión Plumaluna‡Le bastion de Feathermoon‡羽月要塞‡羽月要塞',
    nil,
    'Fale com Latrônicus Lunalança no Domínio de Plumaluna, em Feralas.‡Поговорите с Латроникусом Лунным Копьем в Крепости Оперенной Луны в Фераласе.‡Sprecht mit Latronicus Moonspear in der Festung Feathermoon, in Feralas.‡페랄라스의 페더문 요새에 있는 라트로니쿠스 문스피어와 대화하십시오.‡Habla con Latronicus Lanzaluna. Lo encontrarás en el Bastión Plumaluna de Feralas.‡Habla con Latronicus Lanzaluna. Lo encontrarás en el Bastión Plumaluna de Feralas.‡Parlez à Latronicus Moonspear au bastion de Feathermoon en Feralas.‡和菲拉斯羽月要塞的拉托尼库斯·月矛谈一谈。‡和菲拉斯羽月要塞的拉托尼庫斯·月矛談壹談。',
  }
},
[7495] = {
  {
    'Vitória pela Aliança‡Славная победа Альянса‡Sieg für die Allianz‡얼라이언스의 승리‡Victoria para la Alianza‡Victoria para la Alianza‡Victoire pour l\'Alliance !‡联盟的胜利‡聯盟的勝利',
    nil,
    'Leve a Cabeça da Onyxia ao Grão-lorde Bolvar Fordragon em Ventobravo.‡Отнесите голову Ониксии Верховному лорду Болвару Фордрагону в Штормград.‡Bringt Onyxias Kopf zu Hochlord Bolvar Fordragon in Stormwind.‡오닉시아의 머리를 스톰윈드로 갖고 가서 대영주 볼바르 폴드라곤에게 보여주어야 합니다.‡Lleva la cabeza de Onyxia al Alto Señor Bolvar Fordragon, en Ventormenta.‡Llévale la cabeza de Onyxia al alto señor Bolvar Fordragón en Ventormenta.‡Apportez la Tête d’Onyxia au généralissime Bolvar Fordragon à Stormwind.‡将奥妮克希亚的头颅交给暴风城的伯瓦尔·弗塔根公爵。‡將奧妮克希亞的頭顱交給暴風城的伯瓦爾·弗塔根公爵。',
  }
},
[7496] = {
  {
    'Celebrar os bons tempos‡Праздник добрых времен‡Gute Zeiten feiern‡대축제‡Celebrar los buenos momentos‡Celebrar los buenos momentos‡Célébrer le triomphe‡英雄庆典‡英雄慶典',
    nil,
    'Procure o Major Valadão no Vale dos Heróis.‡Найдите майора Маттингли в Аллее Героев.‡Sucht Major Mattingly im Tal der Helden auf.‡영웅의 계곡에서 상사 매팅글리를 찾으십시오.‡Busca al mayor Mattingly en el Valle de los Héroes.‡Busca al mayor Mattingly en el Valle de los Héroes.‡Allez voir le major Mattingly dans la vallée des Héros.‡在英雄谷找到玛丁雷少校。‡在英雄谷找到瑪丁雷少校。',
  }
},
[7497] = {
  {
    'A jornada está apenas começando‡Это только начало пути‡Die Reise beginnt erst‡모험은 이제부터‡El viaje acaba de empezar‡El viaje acaba de empezar‡Le voyage commence à peine‡一切才刚刚开始‡壹切才剛剛開始',
