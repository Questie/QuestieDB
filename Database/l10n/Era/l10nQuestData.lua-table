},
[1273] = {
  {
    'O interrogatório de Reethe‡Допрос Рита‡Befragt Reethe‡리테 심문‡El interrogatorio de Reethe‡El interrogatorio de Reethe‡Questionner Reethe‡盘问雷瑟‡盤問雷瑟',
    nil,
    'Vá com Ogron falar com Reethe, e então fale novamente com Krog na Aldeia Muralha Verde.‡Пойдите с Огроном и поговорите с Ритом, потом вернитесь к Крогу в Деревню Гиблотопь.‡Geht mit Ogron und sprecht mit Reethe, dann kehrt zu Krog in Brackenwall zurück.‡오그론과 함께 가서 리테를 심문한 다음 담쟁이 마을에 있는 크로그에게 돌아가야 합니다.‡Ve con Ogron a hablar con Reethe y luego vuelve al Poblado Murohelecho a hablar con Krog.‡Ve con Ogron a hablar con Reethe y luego vuelve al Poblado Murohelecho a hablar con Krog.‡Aller avec Ogron pour parler à Reethe puis retourner voir Krog à Mur-de-Fougères.‡和奥格隆一起去和雷瑟谈一谈，然后回到蕨墙村见克罗格。‡和奧格隆壹起去和雷瑟談壹談，然後回到蕨墻村見克羅格。',
  }
},
[1274] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Encontre o Bispo DeLavey na Bastilha Ventobravo.‡Найдите епископа Делавея в Крепости Штормграда.‡Sucht Bischof DeLavey in der Burg Stormwind.‡스톰윈드 성에서 주교 드라베이를 찾아야 합니다.‡Encuentra al Obispo DeLavey en el Castillo de Ventormenta.‡Encuentra al Obispo DeLavey en el Castillo de Ventormenta.‡Trouver l\'évêque DeLavey au Donjon de Stormwind.‡找到暴风要塞的德拉维主教。‡找到暴風要塞的德拉維主教。',
  }
},
[1275] = {
  {
    'Pesquisar a corrupção‡Исследование порчи‡Erforschung der Verderbnis‡타락에 대한 연구‡Investigaciones acerca de la corrupción‡Investigaciones acerca de la corrupción‡Recherches sur la corruption‡研究堕落‡研究墮落',
    nil,
    'Gershala Umbrurmúrio em Auberdine quer 8 Troncos Encefálicos Corrompidos.‡Гершал Шепот Ночи в Аубердине хочет, чтобы вы принесли ему 8 оскверненных стволов мозга.‡Gershala Nightwhisper in Auberdine möchte 8 verderbte Hirnstämme.‡아우버다인에 있는 게르샬라 나이트위스퍼가 변이된 뇌간 8개를 가져다 달라고 부탁했습니다.‡Gershala Noctusurro de Auberdine quiere 8 bulbos raquídeos corruptos.‡Gershala Susurro Nocturno en Auberdine quiere 8 bulbos raquídeos corruptos.‡Gershala Nightwhisper d\'Auberdine veut 8 Souches de cerveau corrompu.‡奥伯丁的戈沙拉·夜语需要8块堕落者的脑干。‡奧伯丁的戈沙拉·夜語需要8塊墮落者的腦幹。',
  }
},
[1276] = {
