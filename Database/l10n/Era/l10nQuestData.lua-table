[1795] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    '‡Призовите и одолейте охотника скверны при помощи фолианта Заговора и верните фолиант Страхаду Фарсану из Кабестана.‡Beschwört mit Hilfe des \'Folianten der Kabale\' einen Teufelsjäger, unterwerft ihn und bringt den \'Folianten der Kabale\' zu Strahad Farsan in Ratchet zurück.‡비밀의 고서를 사용해 지옥사냥개를 소환해 제압한 다음 톱니항에 있는 스트라드 파선에게 사용한 고서를 돌려주어야 합니다.‡Mediante el Libro del Conciliábulo invoca y subyuga a un manáfago y luego devuélvele el Libro del Conciliábulo a Strahad Farsan en Trinquete.‡Mediante el libro del conciliábulo invoca y subyuga a un manáfago y luego devuélvele el Libro del Conciliábulo a Strahad Farsan en Trinquete.‡Utiliser le Tome de la Cabale pour invoquer et soumettre un Chasseur corrompu, puis rapporter le Tome de la Cabale à Strahad Farsan, à Ratchet.‡召唤地狱猎犬并打败它，然后把阴谋之书交给棘齿城的斯坦哈德·法尔杉。‡召喚地獄獵犬並打敗它，然後把陰謀之書交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1796] = {
  {
    'Componentes para um Robessangre Dourado Encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡魔化金線血袍',
    nil,
    'Leve Vestes de Arcana para Menara Nihila nos Sertões.‡Принесите одеяния Аркана Менаре Расщепительнице Бездны в Степи.‡Bringt die Roben von Arcana zu Menara Voidrender im Brachland.‡불모의 땅에 있는 미네라 보이드렌더에게 아카나의 로브를 가져가야 합니다.‡Llévale las túnicas arcanas a Menara Nadiz en Los Baldíos.‡Llévale las togas de Arcana a Menara Nadiz en Los Baldíos.‡Apporter des Robes d’Arcana à Menara Voidrender dans les Tarides.‡将奥法之袍交给贫瘠之地的梅纳拉·沃伦德。‡將奧法之袍交給貧瘠之地的梅納拉·沃倫德。',
  }
},
[1798] = {
  {
    'Procurando Strahad‡В поисках Страхада‡Die Suche nach Strahad‡스트라드를 찾아서‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Fale com Strahad Farsan nos Sertões.‡Поговорите со Страхадом Фарсаном в Степях.‡Sprecht mit Strahad Farsan im Brachland.‡불모의 땅에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Los Baldíos.‡Habla con Strahad Farsan en Los Baldíos.‡Parler à Strahad Farsan dans les Tarides.‡与贫瘠之地的斯坦哈德·法尔杉谈一谈。‡與貧瘠之地的斯坦哈德·法爾杉談壹談。',
  }
},
[1799] = {
  {
    'Fragmentos do Orbe de Orahil‡Части шара Орахила‡Fragmente der Kugel von Orahil‡오라힐 보주의 파편‡Los fragmentos del orbe de Orahil‡Los trozos del orbe de Orahil‡Fragments de l\'Orbe d\'Orahil‡宝珠碎片‡寶珠碎片',
    nil,
    'Fale com os acólitos de Menara dentro da torre acima da Vila Catraca e escolha um caminho a seguir.|nDepois, leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Поговорите с послушниками Менары в башне над Кабестаном и изберите свой путь.|nПосле этого принесите Табете в Пыльную трясину сферу Подземного огня.‡Sprecht mit Menaras Akolyten im Inneren des Turms über Ratchet und wählt einen ihrer Wege, um ihm zu folgen.|nBringt danach eine Höllenkugel zu Tabetha in den Marschen von Dustwallow.‡톱니항이 내려다보이는 탑 안에 살고 있는 미네라의 조수들과 대화하고 그들이 제시하는 길 중 하나를 따라가야 합니다.|n그 후엔 지옥의 보주를 구해 먼지진흙 습지대의 타베사에게 가져가야 합니다.‡Habla con los acólitos de Menara que están en el interior de la torre que domina Trinquete y elige uno de sus caminos para seguirlo.|nDespués, llévale un orbe infernal a Tabetha en Marjal Revolcafango.‡Habla con los acólitos de Menara que están en el interior de la torre que domina Trinquete y elige uno de sus caminos para seguirlo.|nDespués, llévale un orbe infernal a Tabetha en Marjal Revolcafango.‡Parler aux acolytes de Menara dans la tour qui domine Ratchet et choisir de suivre l’une de leurs voies.|nEnsuite, apporter un Orbe infernal à Tabetha, dans le marécage d\'Âprefange.‡在棘齿城外的塔里与梅纳拉的侍僧们谈话，选择自己修行的方式。|n然后给尘泥沼泽的塔贝萨带去一颗地狱火珠。‡在棘齒城外的塔裏與梅納拉的侍僧們談話，選擇自己修行的方式。|n然後給塵泥沼澤的塔貝薩帶去壹顆地獄火珠。',
  }
},
[1800] = {
  {
    'Sala do Trono de Lordaeron‡Тронный зал Лордерона‡Der Thronsaal von Lordaeron‡로데론의 왕실‡Sala del Trono de Lordaeron‡Sala del Trono de Lordaeron‡La salle du trône de Lordaeron‡洛丹伦的王座‡羅德隆的王座廳',
    nil,
    'Leve o seu protegido para a antiga Sala do Trono de Lordaeron, que fica logo antes da entrada subterrânea para a Cidade Baixa.‡Отведите своего подопечного в старый тронный зал Лордерона, который находится как раз у входа в Подгород.‡Besucht mit Eurem Schützling den alten Thronsaal in Lordaeron. Er befindet sich kurz vor dem Abgang nach Undercity.‡언더시티로 내려가기 바로 전에 있는 고대 로데론의 왕실로 돌보고 있는 고아를 데리고 가야 합니다.‡Lleva a tu pupilo a la antigua Sala del Trono de Lordaeron. La encontrarás justo antes de llegar al acceso a Entrañas.|n‡Lleva a tu pupilo a la antigua Sala del Trono de Lordaeron. La encontrarás justo antes de llegar al acceso a Entrañas.‡Emmenez votre protégé à la vieille salle du trône de Lordaeron, qui se trouve juste avant l\'endroit où il faut descendre pour aller à Fossoyeuse.‡带着你看护的孤儿去幽暗城电梯外的王座大厅。‡帶著你看護的孤兒去幽暗城升降梯外的王座廳。',
  }
},
[1801] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡El Libro del Conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Fale com Jonas Anísio na Cidade Baixa.‡Поговорите с Джорахом Аннисоном в Подгороде.‡Sprecht mit Jorah Annison in Undercity.‡언더시티에 있는 조라 애니슨과 대화해야 합니다.‡Habla con Jorah Annison en Los Baldíos.‡Habla con Jorah Annison en Entrañas.‡Parler à Jorah Annison à Undercity.‡和幽暗城的约拉·安尼森谈一谈。‡和幽暗城的約拉·安尼森談壹談。',
  }
},
[1802] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del Conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Recupere o Tomo Mofado e o Manuscrito Rasgado para Krom Braçoforte em Altaforja.‡Добудьте заплесневелый фолиант и потрепанный манускрипт для Крома Крепкорука из Стальгорна.‡Beschafft den schimmeligen Folianten und das zerlumpte Manuskript für Krom Stoutarm in Ironforge.‡아이언포지에 있는 크롬 스타우트암에게 곰팡이 슨 고서와 너덜너덜한 필사본을 가져가야 합니다.‡Lleva el tomo mohoso y el manuscrito maltrecho a Krom Brazorrecio a Forjaz.‡Lleva el escrito mohoso y el manuscrito maltrecho a Krom Brazorrecio a Forjaz.‡Retrouver le Tome moisi et le Manuscrit en lambeaux pour Krom Stoutarm à Ironforge.‡为铁炉堡的克罗姆·粗臂找回发霉的书籍和破损的手稿。‡為鐵爐堡的克羅姆·粗臂找回發黴的書籍和破損的手稿。',
  }
},
[1803] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Recupere o Tomo Mofado e o Manuscrito Rasgado para Jonas Anísio na Cidade Baixa.‡Отыщите заплесневелый фолиант и потрепанный манускрипт для Йораха Аннисона из Подгорода.‡Beschafft den schimmeligen Folianten und das zerlumpte Manuskript für Jorah Annison in Undercity.‡곰팡이 슨 고서와 너덜너덜한 필사본을 찾아 언더시티에 있는 조라 애니슨에게 가져가야 합니다.‡Recupera el escrito mohoso y el manuscrito andrajoso para Jorah Annison de Entrañas.‡Recupera el escrito mohoso y el manuscrito andrajoso para Jorah Annison de Entrañas.‡Retrouver le Tome moisi et le Manuscrit en lambeaux pour Jorah Annison à Undercity.‡给幽暗城的约拉·安尼森带回发霉的书籍和破损的手稿。‡給幽暗城的約拉·安尼森帶回發黴的書籍和破損的手稿。',
  }
},
[1804] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del Conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Leve o Tomo Reformado e 3 Bastões de Canalização para Strahad Farsan na Vila Catraca.‡Принесите восстановленный Фолиант Заговора и три жезла направления Страхаду Фарсану в Кабестан.‡Bringt den rekonstruierten Folianten und 3 Kanalisierungsruten zu Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선에게 복원된 고서와 정신 집중의 마법봉 3개를 가져가야 합니다.‡Lleva el tomo restaurado y 3 varas de mediación a Strahad Farsan a Trinquete.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Apporter le Tome recomposé et 3 Bâtonnet de canalisation à Strahad Farsan à Ratchet.‡将翻修过的书籍和3根导能魔棒交给棘齿城的斯坦哈德·法尔杉。‡將翻修過的書籍和3根導能魔棒交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1805] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del Conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Leve o Tomo Reformado e 3 Bastões de Canalização para Strahad Farsan na Vila Catraca.‡Принесите восстановленный фолиант и три жезла направления Страхаду Фарсану в Кабестан.‡Bringt den rekonstruierten Folianten und 3 Ruten des Kanalisierens zu Strahad Farsan in Ratchet.‡톱니항에 있는 스트라드 파선에게 복원된 고서와 정신 집중의 마법봉 3개를 가져가야 합니다.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Apporter le Tome recomposé et 3 Bâtonnets de canalisation à Strahad Farsan à Ratchet.‡将翻修过的书籍和3根导能魔棒交给棘齿城的斯坦哈德·法尔杉。‡將翻修過的書籍和3根導能魔棒交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1806] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Espere que Jardel Calmafonte termine de forjar uma arma para você.‡Подождите, пока Джордан Стилвелл не закончит изготовление оружия.‡Wartet, bis Jordan Stilwell eine Waffe für Euch geschmiedet hat.‡조던 스틸웰이 무기를 다 만들 때까지 기다려야 합니다.‡Espera mientras Jordan Fontana te forja un arma.‡Espera mientras Jordan Fontana te forja un arma.‡Attendre que Jordan Stilwell finisse de forger votre arme.‡等待乔丹·斯迪威尔为你铸造武器。‡等待喬丹·斯迪威爾為妳鑄造武器。',
  }
},
[1818] = {
  {
    'Uma conversa com Dinis‡Разговор с Диллинджером‡Gespräch mit Dillinger‡딜링거와의 대화‡Habla con Dillinger‡Habla con Dillinger‡Parler à Dillinger‡迪林格尔‡迪林格爾',
    nil,
    'Fale com o Necroguarda Dinis em Montalvo.‡Поговорите со стражем смерти Диллинджером в Брилле.‡Sprecht mit Todeswache Dillinger in Brill.‡브릴에 있는 죽음의경비병 딜링거와 대화하십시오.‡Habla con el guardia de la muerte Dillinger en Rémol.‡Habla con el Guardia de la Muerte Dillinger en Rémol.‡Parler au Garde noir Dillinger à Brill.‡和布瑞尔的亡灵卫兵迪林格尔谈一谈。‡和布瑞爾的亡靈衛兵迪林格爾談壹談。',
  }
},
[1819] = {
  {
    'Ulag, o Cutelo‡Улаг Колун‡Ulag der Spalter‡학살자 울라그‡Ulag, el cuchillero‡Ulag el Cuchilla‡Ulag le Fendeur‡切割者奥拉格‡切割者奧拉格',
    nil,
    'Mate Ulag, o Cutelo, depois fale com Necroguarda Dinis.‡Убейте Улага Колуна и поговорите со стражем смерти Диллинджером.‡Tötet Ulag den Spalter und sprecht dann mit Todeswache Dillinger.‡학살자 울라그를 처치한 후 죽음의경비병 딜링거와 대화하십시오.‡Mata a Ulag el Cuchillero y ve a hablar con el guardia de la muerte Dillinger.‡Mata a Ulag el Cuchilla y ve a hablar con el Guardia de la Muerte Dillinger.‡Tuer Ulag le Fendeur, puis parler au Garde noire Dillinger.‡杀死切割者奥拉格，然后和亡灵卫兵迪林格尔谈一谈。‡殺死切割者奧拉格，然後和亡靈衛兵迪林格爾談壹談。',
  }
},
[1820] = {
  {
    'Encontrando Eurico‡Разговор с Колманом‡Gespräch mit Coleman‡콜만과의 대화‡Habla con Coleman‡Habla con Coleman‡Parler à Coleman‡库勒曼‡庫勒曼',
    nil,
    'Fale com Eurico Palhares.‡Поговорите с Колманом Фартингом.‡Sprecht mit Coleman Farthing.‡콜만 파딩과 대화하십시오.‡Habla con Coleman Lontananza.‡Habla con Coleman Farthing.‡Parler à Coleman Farthing.‡和库勒曼·法席恩谈一谈。‡和庫勒曼·法席恩談壹談。',
  }
},
[1821] = {
  {
    'A herança dos Agamand‡Наследие Агамондов‡Agamand-Erbstücke‡아가만드 가문의 가보‡Reliquias Agamand‡Reliquias Agamand‡L\'héritage des Agamand‡阿加曼德家传武器‡阿加曼德家傳武器',
    nil,
    'Leve para Eurico Palhares o Machado da Família Agamand, a Espada da Família Agamand, a Maça da Família Agamand e a adaga da Família Agamand.‡Принесите Колману Фартингу фамильный топор Агамондов, фамильный меч Агамондов, фамильную палицу Агамондов, фамильный кинжал Агамондов.‡Bringt Coleman Farthing die Axt, das Schwert, den Streitkolben und den Dolch der Familie Agamand.‡콜만 파딩에게 아가만드 가문의 도끼, 아가만드 가문의 검, 아가만드 가문의 철퇴, 그리고 아가만드 가문의 단검을 가져가야 합니다.‡Lleva a Coleman Lontananza el hacha de la familia Agamand, la espada de la familia Agamand, la maza de la familia Agamand y la daga de la familia Agamand.‡Lleva a Coleman Farthing el hacha de la familia Agamand, la espada de la familia Agamand, la maza de la familia Agamand y la daga de la familia Agamand.‡Rapporter à Coleman Farthing la Hache de la famille Agamand, l\'Epée de la famille Agamand, la Masse de la famille Agamand et la Dague de la famille Agamand.‡把阿加曼德家传长剑、阿加曼德家传战斧、阿加曼德家传钉锤和阿加曼德家传匕首交给库勒曼·法席恩。‡把阿加曼德家傳長劍、阿加曼德家傳戰斧、阿加曼德家傳釘錘和阿加曼德家傳匕首交給庫勒曼·法席恩。',
  }
},
[1822] = {
  {
