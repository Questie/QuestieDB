[1823] = {
  {
    'Fale com Ruga‡Разговор с Ругой‡Gespräch mit Ruga‡루가와의 대화‡Habla con Ruga‡Habla con Ruga‡Parler à Ruga‡和鲁迦交谈‡和魯迦交談',
    nil,
    'Fale com Ruga Totem da Fúria.‡Поговорите с Ругой Тотемом Гнева.‡Sprecht mit Ruga Ragetotem.‡루가 레이지토템과 대화하십시오.‡Habla con Ruga Furiatótem.‡Habla con Ruga Tótem de Ira.‡Parler à Ruga Ragetotem.‡和鲁迦·狂暴图腾谈一谈。‡和魯迦·狂暴圖騰談壹談。',
  }
},
[1824] = {
  {
    'Provação no Campo dos Gigantes‡Испытание на Полях Великанов‡Prüfung auf dem Feld der Riesen‡거인의 들판에서의 시험‡Prueba en Tierra de Gigantes‡Prueba en Tierra de Gigantes‡L\'épreuve du Champ des géants‡巨人旷野的试炼‡巨人曠野的試煉',
    nil,
    'Leve 5 antenas tremelicantes para Ruga Totem da Fúria no Acampamento Taurajo‡Принесите 5 дергающихся усиков Руге Тотему Гнева в Лагерь Таурахо.‡Bringt 5 zuckende Fühler zu Ruga Ragetotem im Camp Taurajo.‡타우라조 야영지에 있는 루가 레이지토템에게 꿈틀거리는 더듬이 5개를 가져가야 합니다.‡Lleva 5 antenas agitadas a Ruga Furiatótem de Campamento Taurajo.‡Lleva 5 antenas agitadas a Ruga Tótem de Ira de Campamento Taurajo.‡Apporter 5 Antennes mobiles à Ruga Ragetotem au Camp Taurajo.‡收集5根颤抖的触角，把它们带给贫瘠之地陶拉祖营地的鲁迦。‡收集5根顫抖的觸角，把它們帶給貧瘠之地陶拉祖營地的魯迦。',
  }
},
[1825] = {
  {
    'Fale com Thun\'grim‡Разговор с Тун\'гримом‡Gespräch mit Thun\'grim‡툰그림과의 대화‡Habla con Thun\'grim‡Habla con Thun\'grim‡Parler à Thun\'grim‡和索恩格瑞姆交谈‡和索恩格瑞姆交談',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Firegaze im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화하십시오.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Firegaze dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡與貧瘠之地的索恩格瑞姆·火眼談壹談。',
  }
},
[1838] = {
  {
    'Armadura brutal‡Доспехи Жестокости‡Brutale Rüstung‡투사의 방어구‡Armadura brutal‡Armadura brutal‡Armure de brutalité‡野蛮护甲‡野蠻護甲',
    nil,
    'Leve para Thun\'grim Olhafogo 15 Lingotes Fumegantes de Ferro, 10 Azuritas Pulverizadas, 10 Barras de Ferro e a Ampola de Flogisto.‡Принесите Тун\'гриму Огневзору 15 закопченных железных слитков, 10 мер толченого азурита, 10 железных слитков и сосуд флогистона.‡Bringt Thun\'grim Firegaze 15 rauchige Eisenblöcke, 10 pulverisierte Azurite, 10 Eisenbarren und 1 Phiole Phlogiston.‡툰그림 파이어게이즈에게 연기나는 철제 주괴 15개, 아주라이트 가루 10개, 철 주괴 10개, 연소 약병 1개를 가져가야 합니다.‡Lleva 15 lingotes de hierro humeantes, 10 azuritas en polvo, 10 lingotes de hierro y un vial de flogisto a Thun\'grim Vistafuego.‡Lleva 15 lingotes de hierro humeantes, 10 azuritas en polvo, 10 barras de hierro y un vial de flogisto a Thun\'grim Vistafuego.‡Apporter à Thun\'grim Firegaze 15 Lingots de Fer cendré, 10 Azurites en poudre, 10 Barres de Fer et une Fiole de Phlogiston.‡为索恩格瑞姆收集15根烟雾铁锭、10份蓝铜粉、10块铁锭和1瓶燃素。‡為索恩格瑞姆收集15根煙霧鐵錠、10份藍銅粉、10塊鐵錠和1瓶燃素。',
  }
},
[1839] = {
  {
    'Ula\'elek e as Manoplas Brutais‡Ула\'елек и рукавицы Жестокости‡Ula\'elek und die brutalen Stulpen‡울라엘레크와 투사 건틀릿‡Ula\'elek y los guanteletes brutales‡Ula\'elek y los guanteletes brutales‡Ula\'elek et les Gantelets de brutalité‡尤拉莱克和野蛮护手‡尤拉萊克和野蠻護手',
    nil,
    'Fale com Ula\'elek em Durotar.‡Поговорите с Ула\'елеком из Дуротара.‡Sprecht mit Ula\'elek in Durotar.‡듀로타에 있는 울라엘레크와 대화하십시오.‡Habla con Ula\'elek en Durotar.‡Habla con Ula\'elek en Durotar.‡Parler à Ula\'elek en Durotar.‡与杜隆塔尔的尤拉莱克谈一谈。‡與杜隆塔爾的尤拉萊克談壹談。',
  }
},
[1840] = {
  {
    'Orm Casco de Pedra e o Elmo Brutal‡Орм Каменное Копыто и шлем Жестокости‡Orm Stonehoof und der brutale Helm‡오름 스톤후프와 투사 투구‡Orm Pezuñapétrea y el yelmo brutal‡Orm Pezuña Pétrea y el yelmo brutal‡Orm Stonehoof et le Camail de brutalité‡奥姆·石蹄和野蛮头盔‡奧姆·石蹄和野蠻頭盔',
    nil,
    'Fale com Orm Casco de Pedra no Penhasco do Trovão.‡Обратитесь к Орму Каменному Копыту из Громового Утеса.‡Sprecht mit Orm Stonehoof in Thunder Bluff.‡썬더 블러프에서 오름 스톤후프와 대화하십시오.‡Habla con Orm Pezuñapétrea en Cima del Trueno.‡Habla con Orm Pezuña Pétrea en Cima del Trueno.‡Parler à Orm Stonehoof à Thunder Bluff.‡和雷霆崖的奥姆·石蹄谈一谈。‡和雷霆崖的奧姆·石蹄談壹談。',
  }
},
[1841] = {
  {
    'Velora Noitile e as Guarda-pernas Brutais‡Велора Нители и Набедренники Жестокости‡Velora Nitely und die brutalen Beinschützer‡벨로라 나이틀리와 투사 다리보호구‡Velora Noctis y las musleras brutal‡Velora Noctis y las musleras brutal‡Velora Nitely et les Jambières de brutalité‡维罗拉·奈特雷和野蛮腿甲‡維羅拉·奈特雷和野蠻腿甲',
    nil,
    'Fale com Velora Noitile na Cidade Baixa.‡Поговорите с Велорой Нители из Подгорода.‡Sprecht in Undercity mit Velora Nitely.‡언더시티에 있는 벨로라 나이틀리와 대화하십시오.‡Habla con Velora Noctis en Entrañas.‡Habla con Velora Noctis en Entrañas.‡Parler à Velora Nitely à Undercity.‡与幽暗城的维罗拉·奈特雷谈一谈。‡與幽暗城的維羅拉·奈特雷談壹談。',
  }
},
[1842] = {
  {
    'Cascos de Sátiro‡Копыта сатиров‡Satyrhufe‡사티로스 발굽‡Pezuñas de sátiro‡Pezuñas de sátiro‡Les sabots de satyre‡萨特之蹄‡薩特之蹄',
    nil,
    'Leve 7 Cascos Não-fendidos de Sátiro para Ula\'elek na Aldeia Sen\'jin em Durotar‡Принесите 7 нераздвоенных копыт сатиров Ула\'елеку в Дуротар, в деревню Сен\'джин.‡Bringt 7 ungespaltene Satyrhufe zu Ula\'elek in Sen\'jin in Durotar.‡듀로타의 센진 마을에 있는 울라엘레크에게 사티로스 통발굽 7개를 가져가야 합니다.‡Lleva 7 pezuñas unguladas de sátiro a Ula\'elek de Poblado Sen\'jin en Durotar.‡Lleva 7 pezuñas de sátiro sin rajar a Ula\'elek de Poblado Sen\'jin en Durotar.‡Rapporter 7 Sabots fendus de satyre à Ula\'elek au village de Sen\'jin en Durotar.‡收集7只完整的萨特之蹄，把它们交给杜隆塔尔森金村的尤拉莱克。‡收集7只完整的薩特之蹄，把它們交給杜隆塔爾森金村的尤拉萊克。',
  }
},
[1843] = {
