[5644] = {
  {
    'Peste Devoradora‡Всепожирающая чума‡Verschlingende Seuche‡파멸의 역병‡Peste devoradora‡Peste devoradora‡Peste dévorante‡噬灵瘟疫‡噬靈瘟疫',
    nil,
    'Fale com Aelthalyste na Cidade Baixa.‡Поговорите с Эльталисте в Подгороде.‡Sprecht mit Aelthalyste in Undercity.‡언더시티에 있는 애살리스테와 대화해야 합니다.‡Habla con Aelthalyste en Entrañas.‡Habla con Aelthalyste en Entrañas.‡Parler à Aelthalyste à Undercity.‡与幽暗城的艾萨莱斯特谈一谈。‡與幽暗城的艾薩萊斯特談壹談。',
  }
},
[5645] = {
  {
    'O medo é para os fracos‡Бесстрашие‡Furchtlos‡두려움 없는 용기‡Sin miedo‡Sin miedo‡Un manque de peur‡毫无畏惧‡毫無畏懼',
    nil,
    'Fale com o Sumo Sacerdote Rohan em Altaforja.‡Поговорите с верховным жрецом Роханом в Стальгорне.‡Sprecht mit Hohepriester Rohan in Ironforge.‡아이언포지에 있는 대사제 로한과 대화하십시오.‡Habla con el alto sacerdote Rohan en Forjaz.‡Habla con el sumo sacerdote Rohan en Forjaz.‡Parler au grand prêtre Rohan à Ironforge.‡与铁炉堡的高阶牧师洛汉谈一谈。‡與鐵爐堡的高階牧師洛漢談壹談。',
  }
},
[5646] = {
  {
    'Peste Devoradora‡Всепожирающая чума‡Verschlingende Seuche‡파멸의 역병‡Peste devoradora‡Peste devoradora‡Peste dévorante‡噬灵瘟疫‡噬靈瘟疫',
    nil,
    'Fale com Aelthalyste na Cidade Baixa.‡Поговорите с Эльталисте в Подгороде.‡Sprecht mit Aelthalyste in Undercity.‡언더시티에 있는 애살리스테와 대화해야 합니다.‡Habla con Aelthalyste en Entrañas.‡Habla con Aelthalyste en Entrañas.‡Parler à Aelthalyste à Undercity.‡与幽暗城的艾萨莱斯特谈一谈。‡與幽暗城的艾薩萊斯特談壹談。',
