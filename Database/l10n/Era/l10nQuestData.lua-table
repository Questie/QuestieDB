[3661] = {
  {
    'Protegidos de Eluna?‡Любимцы Элуны?‡Elunes Lieblinge?‡엘룬의 피조물‡¿Creados por Elune?‡¿Creados por Elune?‡Dans les faveurs d\'Elune ?‡月神之兽？‡月神之獸？',
    nil,
    'Pegue 15 Penas de Coruscante nas Terras Agrestes para Erelas Ambarcéu na Vila de Rut\'theran.‡Собрерите во Внутренних землях 15 перьев диких совухов и отнесите их Эреласу Янтарному Небу в деревню Рут\'теран.‡Sammelt 15 Wildekinfedern aus dem Hinterland für Erelas Ambersky in Rut\'theran.‡에렐라스 앰버스카이를 위해 동부 내륙지에서 올빼미야수 깃털 15개를 모아야 합니다.‡Recoge 15 plumas de lechúcico de las Tierras del Interior y llévaselas a Erelas Cieloámbar a la Aldea Rut\'theran.‡Recoge 15 plumas de lechúcico salvaje de las Tierras del Interior y llévaselas a Erelas Cieloámbar a la Aldea Rut\'theran.‡Collecter 15 Plumes d\'Indomptable dans les Hinterlands, pour Erelas Ambersky au village de Rut\'theran.‡为鲁瑟兰村的艾瑞拉斯·琥珀收集15支枭兽羽毛。‡為魯瑟蘭村的艾瑞拉斯·琥珀收集15支梟獸羽毛。',
  }
},
[3681] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Libro de la Divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Разыщите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Stormwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Ve a Ventormenta y habla con Duthorian Rall.‡Parler à Duthorian Rall à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談壹談。',
  }
},
[3701] = {
  {
    'As fumegantes Ruínas de Thaurissan‡Дымящиеся руины Тауриссана‡Die glimmenden Ruinen von Thaurissan‡불타는 타우릿산의 폐허‡Las humeantes Ruinas de Thaurissan‡Las humeantes Ruinas de Thaurissan‡Les ruines fumantes de Thaurissan‡索瑞森废墟‡索瑞森廢墟',
    nil,
    'Vá até as Ruínas de Thaurissan, nas Estepes Ardentes, e descubra informações sobre as Relíquias de Thaurissan. Fale novamente com a Historiadora Real Arquefilis quando terminar.‡Пойдите в руины Тауриссана в Пылающих степях и добудьте информацию из таурисанских реликвий. Вернитесь к королевскому историку Аркессону.‡Begebt Euch zu den Ruinen von Thaurissan in der brennenden Steppe und sammelt Informationen über die Thaurissan-Relikte. Kehrt zur königlichen Historikerin Archesonus zurück, wenn Ihr die Informationen besorgt habt.‡불타는 평원, 타우릿산의 폐허에 있는 타우릿산 유물에서 정보를 얻어야 합니다. 정보를 발견하면 왕실사학자 아케소누스에게 돌아가야 합니다.‡Ve a las Ruinas de Thaurissan, en Las Estepas Ardientes, y recopila información sobre los tesoros de Thaurissan. Informa a la historiadora real Archesonus.‡Ve a las Ruinas de Thaurissan, en Las Estepas Ardientes, y recopila información sobre los tesoros de Thaurissan. Informa a la historiadora real Archesonus.‡Aller dans les ruines de Thaurissan, dans les Steppes ardentes. Récupérer des informations sur les Reliques de Thaurissan, puis retourner auprès de l’Historienne royale Archesonus.‡到燃烧平原的索瑞森废墟中去，从索瑞森遗物上搜集信息。当你收集到足够的信息之后，就回到皇家历史学家阿克瑟努斯那里。‡到燃燒平原的索瑞森廢墟中去，從索瑞森遺物上搜集信息。當妳收集到足夠的信息之後，就回到皇家歷史學家阿克瑟努斯那裏。',
  }
},
[3702] = {
  {
    'As fumegantes Ruínas de Thaurissan‡Дымящиеся руины Тауриссана‡Die glimmenden Ruinen von Thaurissan‡불타는 타우릿산의 폐허‡Las ruinas humeantes de Thaurissan‡Las humeantes Ruinas de Thaurissan‡Les ruines fumantes de Thaurissan‡索瑞森废墟‡索瑞森廢墟',
    nil,
    'Escute a Historiadora Real Arquefilis recontar a história de Thaurissan.‡Узнайте от королевского историка Аркессона историю Тауриссана.‡Hört die Erzählung der königlichen Historikerin Archesonus über die Geschichte von Thaurissan.‡왕실사학자 아케소누스가 들려 주는 타우릿산의 역사를 들어야 합니다.‡Escucha al historiador regio Archesonus relatar la historia de Thaurissan.‡Escucha a la historiadora real Archesonus relatar la historia de Thaurissan.‡Écouter l\'historienne royale Archesonus raconter l\'histoire de Thaurissan.‡听皇家历史学家阿克瑟努斯讲述索瑞森的历史。‡聽皇家歷史學家阿克瑟努斯講述索瑞森的歷史。',
  }
},
[3721] = {
  {
    'Um OOX para chamar de meu‡Собственный ККХ‡Ein eigener OOX‡선물로 받은 OOX‡Tu propio OOX‡Tu propio OOX‡Un OOX rien que pour vous‡你自己的OOX‡妳自己的OOX',
    nil,
    nil,
  }
},
[3741] = {
  {
    'Colar da Hilária‡Ожерелье Хилари‡Hilarys Halskette‡힐러리의 목걸이‡El collar de Hilary‡El collar de Hilary‡Le collier d\'Hilary‡希拉里的项链‡希拉裏的項鏈',
    nil,
    'Encontre e devolva o Colar da Hilária na Vila Plácida.‡Найдите ожерелье Хилари и верните его Хилари в Приозерье.‡Sucht Hilarys Halskette und bringt sie Hilary in Seenhain zurück.‡힐러리의 목걸이를 찾아 레이크샤이어에 있는 힐러리에게 가져가야 합니다.‡Encuentra el collar de Hilary y llévaselo a Villa del Lago.‡Encuentra el collar de Hilary y llévaselo a Villa del Lago.‡Trouver le Collier d\'Hilary et le rapporter à Hilary au Lakeshire.‡找到希拉里的项链，将其还给湖畔镇的希拉里。‡找到希拉裏的項鏈，將其還給湖畔鎮的希拉裏。',
  }
},
[3761] = {
  {
    'Solo de Un\'Goro‡Почва Ун\'Горо‡Un\'Goro-Erde‡운고로 토양‡Tierra de Un\'Goro‡Tierra de Un\'Goro‡La terre d\'Un\'Goro‡安戈洛的泥土‡安戈洛的泥土',
    nil,
    'Leve 20 amostras de Solo de Un\'Goro para Ghede no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Принесите 20 образцов земли из Кратера Ун\'Горо Геду на Вершину Старейшин Громового Утеса.‡Bringt 20 Un\'Goro-Erdproben zu Ghede in Thunder Bluff.‡썬더 블러프에 장로의 봉우리 있는 게드에게 운고로 토양 20개를 가져가야 합니다.‡Llévale 20 muestras de la tierra de Un\'Goro a Ghede, que está en el Alto de los Ancestros de Cima del Trueno.‡Llévale 20 muestras de la tierra de Un\'Goro a Ghede, en el Alto de los Ancestros de Cima del Trueno.‡Apporter 20 Echantillons d\'Humus d\'Un\'Goro à Ghede, à Thunder Bluff.‡收集20份安戈洛的泥土，把它们交给雷霆崖的格德。‡收集20份安戈洛的泥土，把它們交給雷霆崖的格德。',
  }
},
[3762] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runetotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Tótem de Runa‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Runetotem‡协助大德鲁伊‡協助大德魯伊',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом в Громовом Утесе.‡Sprecht in Thunder Bluff mit Erzdruide Hamuul Runetotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l\'archidruide Hamuul Runetotem à Thunder Bluff.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談壹談。',
  }
},
[3763] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Staghelm helfen‡대드루이드 스테그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡L\'aide à l\'archidruide Staghelm‡协助大德鲁伊‡協助大德魯伊',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Staghelm in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화하십시오.‡Ve a Darnassus y habla con el archidruida Fandral Corzocelada.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Staghelm à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊範達爾·鹿盔談壹談。',
  }
},
[3764] = {
  {
    'Solo de Un\'Goro‡Почва Ун\'Горо‡Un\'Goro-Erde‡운고로 흙‡La tierra de Un\'Goro‡Tierra de Un\'Goro‡La terre d\'Un\'Goro‡安戈洛的泥土‡安戈洛的泥土',
    nil,
    'Leve 20 amostras do Solo de Un\'Goro para Jenal no Enclave Cenariano, que fica em Darnassus.‡Принесите 20 образцов земли из кратера Ун\'Горо Дженалю в дарнасский анклав Кенария.‡Bringt 20 Un\'Goro-Erdproben zu Jenal in Darnassus.‡다르나서스의 세나리온 자치령에 있는 제날에게 운고로 토양 20개를 가져가야 합니다.‡Lleva 20 muestras de tierra de Un\'Goro Soil a Jenal, que está en el Enclave Cenarion de Darnassus.‡Lleva 20 muestras de tierra de Un\'Goro Soil a Jenal, en el Enclave Cenarion de Darnassus.‡Apporter 20 Echantillons d\'Humus d\'Un\'Goro à Jenal, à Darnassus.‡收集20份安戈洛的泥土，把它们交给达纳苏斯的耶纳尔。‡收集20份安戈洛的泥土，把它們交給達納蘇斯的耶納爾。',
  }
},
[3765] = {
  {
    'A corrupção estrangeira‡Проблема за морем‡Verderbnis in der Fremde‡먼 곳에 퍼진 타락‡Lejana corrupción‡Lejana corrupción‡La dépravation au loin‡遥远的旅途‡遙遠的旅途',
    nil,
    'Fale com Gershala Umbrurmúrio em Auberdine.‡Отправляйтесь в Аубердин к Гершалу Шепоту Ночи.‡Reist zu Gershala Nightwhisper in Auberdine.‡아우버다인에 있는 게르샬라 나이트위스퍼를 찾아가야 합니다.‡Ve a ver a Gershala Susurro Nocturno en Auberdine.‡Ve a ver a Gershala Susurro Nocturno en Auberdine.‡Aller voir Gershala Nightwhisper à Auberdine.‡到奥伯丁的戈沙拉·夜语那儿去。‡到奧伯丁的戈沙拉·夜語那兒去。',
  }
},
[3781] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡La recherche sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Leve o Vale-sementes do arquidruida para Mathrengyl Ursivagus no Enclave Cenariano, que fica em Darnassus.‡Отнесите расписку верховного друида в получении семян Матренгилу Медвежьей Лапе в дарнасский анклав Кенария.‡Bringt den Samenkorngutschein des Erzdruiden zu Mathrengyl Bearwalker in der Enklave des Cenarius von Darnassus.‡다르나서스의 세나리온 자치령에 있는 마스렌길 베어워커에게 대드루이드의 씨앗 교환권을 가져가야 합니다.‡Lleva el vale para semillas del archidruida a Mathrengyl Garroso al Enclave Cenarion de Darnassus.‡Lleva el vale para semillas del archidruida a Mathrengyl Garroso al Enclave Cenarion de Darnassus.‡Apporter le Bon pour des graines de l\'archidruide à Mathrengyl Bearwalker dans l\'enclave cénarienne à Darnassus.‡将大德鲁伊的草种购买券交给达纳苏斯城塞纳里奥区的玛斯雷·驭熊者。‡將大德魯伊的草種購買券交給達納蘇斯城塞納裏奧區的瑪斯雷·馭熊者。',
  }
},
[3782] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡La recherche sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Leve o Vale-sementes para Bashana Runa Totem no Penhasco do Trovão.‡Отнесите расписку в получении семян Башане Руническому Тотему в Громовой Утес.‡Bringt den Samenkorngutschein zu Bashana Runetotem in Thunder Bluff.‡썬더 블러프에 있는 바샤나 룬토템에게 씨앗 교환권을 가져가야 합니다.‡Llévale este vale para semillas a Bashana Runatótem, que está en Cima del Trueno.‡Llévale este vale para semillas a Bashana Tótem de Runa en Cima del Trueno.‡Apporter le Bon pour des graines à Bashana Runetotem à Thunder Bluff.‡将草种购买券交给雷霆崖的巴珊娜·符文图腾。‡將草種購買券交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[3783] = {
  {
    'Eu yeti falar uma coisa...‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡Yeti... ¿ya hemos llegado?‡Yeti... ¿ya hemos llegado?‡Yéti ? Y es-tu ?‡雪怪计划！‡雪怪計劃！',
    nil,
    'Colete 10 Peles Grossas de Yeti para Umi Zombarruga em Visteterna.‡Соберите 10 толстых кусков меха йети для Юми Румпельшникер из Круговзора.‡Sammelt 10 dicke Yetifelle für Umi Rumplesnicker in Everlook.‡두꺼운 설인 모피 10개를 모아 눈망루 마을에 있는 우미 럼플스니커에게 갖다주어야 합니다.‡Reúne 10 pieles gruesas de yeti para Umi Risitas en Vista Eterna.‡Reúne 10 pelajes de yeti gruesos para Umi Risitas en Vista Eterna.‡Collecter 10 Fourrures épaisses de yéti pour Umi Rumplesnicker, à Long-guet.‡为永望镇的乌米收集10张厚雪人毛皮。‡為永望鎮的烏米收集10張厚雪人毛皮。',
  }
},
[3784] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runetotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Runatótem‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Runetotem‡协助大德鲁伊‡協助大德魯伊',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Thunder Bluff mit Erzdruide Hamuul Runetotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Runatótem en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l\'archidruide Hamuul Runetotem à Thunder Bluff.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談壹談。',
  }
},
[3785] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Use o Bornal de Sempre-viva com um pacote de Sementes de Tharlendis e duas amostras de Solo de Un\'Goro para tentar cultivar mudas de grão-matinal.|nLeve 10 Grãos-matinais para Mathrengyl Ursivagus em Darnassus.‡При помощи сумы вечного цветения, пакетика семян Тарлендриса и двух порций земли Ун\'Горо попытайтесь прорастить рассветницу.|nПринесите 10 рассветниц Матренгилу Медвежьей Лапе в Дарнасс.‡Benutzt einen Immergrünbeutel mit einem Paket Tharlendrissamenkörner sowie zwei Un\'Goro-Erdproben, um Morgenkorn zu kultivieren.|nBringt 10 Einheiten Morgenkorn zu Mathrengyl Bearwalker in Darnassus.‡탈렌드리스 씨앗 꾸러미와 늘푸른 주머니를 운고로 토양 2개에 사용하여 여명초 견본을 재배하십시오.|n다르나서스에 있는 마스렌길 베어워커에게 여명초 10개를 가져가야 합니다.‡Utiliza una bolsa de siempreverde con 1 paquete de semillas de Tharlendris y 2 muestras de tierra de Un\'Goro para intentar cultivar mañagrana.|nLleva 10 plantas de mañagrana a Mathrengyl Garroso a Darnassus.‡Utiliza una faltriquera de siempreverde con 1 paquete de semillas de Tharlendris y 2 muestras de tierra de Un\'Goro para intentar cultivar mañagrana.|nLleva 10 plantas de mañagrana a Mathrengyl Garroso a Darnassus.‡Utiliser une Sacoche de printemps avec une pochette de graines de Tharlendis et deux Echantillons d\'Humus d\'Un\'Goro pour essayer de cultiver des Fibres d\'aurore.|nApporter 10 Fibres d\'aurore à Mathrengyl Bearwalker à Darnassus.‡用一个常青袋、一包萨伦迪斯种子以及两份安戈洛的泥土来尝试种植晨光麦。|n将10株晨光麦交给达纳苏斯的玛斯雷·驭熊者。‡用壹個常青袋、壹包薩倫迪斯種子以及兩份安戈洛的泥土來嘗試種植晨光麥。|n將10株晨光麥交給達納蘇斯的瑪斯雷·馭熊者。',
  }
},
[3786] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Use o Bornal de Sempre-viva com um pacote de Sementes de Tharlendis e duas amostras de Solo de Un\'Goro para tentar cultivar mudas de grão-matinal.|nLeve 10 Grãos-matinais para Bashana Runa Totem no Penhasco do Trovão.‡При помощи сумы вечного цветения, пакетика семян Тарлендриса и двух порций земли Ун\'Горо попытайтесь прорастить рассветницу.|nПринесите 10 рассветниц Башане Руническому Тотему в Громовой Утес.‡Benutzt einen Immergrünbeutel mit einem Paket Tharlendrissamenkörner sowie zwei Un\'Goro-Erdproben, um Morgenkorn zu kultivieren.|nBringt 10 Einheiten Morgenkorn zu Bashana Runetotem in Thunder Bluff.‡탈렌드리스 씨앗 꾸러미와 늘푸른 주머니를 운고로 토양 2개에 사용하여 여명초 견본을 재배하십시오.|n썬더 블러프에 있는 바샤나 룬토템에게 여명초 10개를 가져가야 합니다.‡Mete en la faltriquera de siempreverde un paquete de Tharlendris y dos muestras de tierra de Un\'Goro para cultivar muestras de mañagrana.|nLlévale 10 mañagranas a Bashana Tótem de Runa, que está en Cima del Trueno.‡Mete en la faltriquera de siempreverde un paquete de Tharlendris y dos muestras de tierra de Un\'Goro para cultivar muestras de mañagrana.|nLlévale 10 mañagranas a Bashana Tótem de Runa, que está en Cima del Trueno.‡Utiliser une Sacoche de printemps avec une pochette de graines de Tharlendis et deux Echantillons d\'Humus d\'Un\'Goro pour essayer de cultiver des Fibres d\'aurore.|nApporter 10 Fibres d\'aurore à Bashana Runetotem à Thunder Bluff.‡用一个常青袋、一包萨伦迪斯种子以及两份安戈洛的泥土来尝试种植晨光麦。|n将10株晨光麦交给雷霆崖的巴珊娜·符文图腾。‡用壹個常青袋、壹包薩倫迪斯種子以及兩份安戈洛的泥土來嘗試種植晨光麥。|n將10株晨光麥交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[3787] = {
  {
    'O pedido de Jonespyre‡Просьба друида‡Jonespyres Bitte‡존스피레의 요청‡La petición de Jonguja‡La petición de Jonguja‡La requête de Jonespyre‡奎恩提斯的请求‡奎恩提斯的請求',
    nil,
    'Fale com Quintis Jonespyre no Domínio de Plumaluna.‡Поговорите с Квинтисом Ночным Костром в Крепости Оперенной Луны.‡Sprecht mit Quintis Jonespyre in der Festung Feathermoon.‡페더문 요새에 있는 쿠인티스 존스피레와 대화해야 합니다.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Parler à Quintis Jonespyre dans le bastion de Feathermoon.‡与羽月要塞的奎恩提斯谈一谈。‡與羽月要塞的奎恩提斯談壹談。',
  }
},
[3788] = {
  {
    'O pedido de Jonespyre‡Кинтис Пламень‡Jonespyres Bitte‡존스피레의 요청‡La petición de Jonguja‡La petición de Jonguja‡La requête de Jonespyre‡奎恩提斯的请求‡奎恩提斯的請求',
    nil,
    'Fale com Quintis Jonespyre no Domínio de Plumaluna.‡Поговорите с друидом по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Sprecht mit Quintis Jonespyre in der Festung Feathermoon.‡페더문 요새에 있는 쿠인티스 존스피레와 대화하십시오.‡Habla con Quintis Jonguja del Bastión Plumaluna.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Parler à Quintis Jonespyre dans le bastion de Feathermoon.‡与羽月要塞的奎恩提斯谈一谈。‡與羽月要塞的奎恩提斯談壹談。',
  }
},
[3789] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Staghelm helfen‡대드루이드 스테그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡Assister l\'archidruide Staghelm‡协助大德鲁伊‡協助大德魯伊',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Staghelm in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Staghelm à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊範達爾·鹿盔談壹談。',
  }
},
[3790] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Staghelm helfen‡대드루이드 스테그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡Assister l\'archidruide Staghelm‡协助大德鲁伊‡協助大德魯伊',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Staghelm in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화하십시오.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Staghelm à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊範達爾·鹿盔談壹談。',
  }
},
[3791] = {
  {
    'O mistério do grão-matinal‡Тайна рассветницы‡Das Geheimnis des Morgenkorns‡여명초의 비밀‡El misterio de mañagrana‡El misterio de mañagrana‡Le Mystère des Fibres d\'aurore‡晨光麦的秘密‡晨光麥的秘密',
    nil,
    'Leve 10 Grãos-matinais para Quintis Jonespyre no Domínio de Plumaluna.‡Принесите 10 рассветниц друиду по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Bringt 10 Einheiten Morgenkorn zu Quintis Jonespyre in der Festung Feathermoon.‡페더문 요새에 있는 쿠인티스 존스피레에게 여명초 10개를 가져가야 합니다.‡Lleva 10 plantas de mañagrana a Quintis Jonguja al Bastión Plumaluna.‡Lleva 10 plantas de mañagrana a Quintis Jonguja al Bastión Plumaluna.‡Apporter 10 Fibres d\'aurore à Quintis Jonespyre au bastion de Feathermoon.‡将10株晨光麦交给羽月要塞的奎恩提斯。‡將10株晨光麥交給羽月要塞的奎恩提斯。',
  }
},
[3792] = {
  {
    'Grãos-matinais para o Domínio de Plumaluna‡Рассветница для Крепости Оперенной Луны‡Morgenkorn für die Festung Feathermoon‡페더문 요새로 여명초 가져가기‡Mañagrana a Bastión Plumaluna‡Mañagrana a Bastión Plumaluna‡De la Fibre d\'aurore au bastion de Feathermoon‡羽月要塞的晨光麦‡羽月要塞的晨光麥',
    nil,
    nil,
  }
},
[3801] = {
  {
    'Legado dos Ferro Negro‡Наследие Черного Железа‡Dunkeleisenerbe‡검은무쇠단 유물‡El legado de los Hierro Negro‡El legado de los Hierro Negro‡Héritage Sombrefer‡黑铁的遗产‡黑鐵的遺產',
    nil,
    'Fale com Franclorn Forjífice se tiver interesse em obter uma chave para a parte principal da cidade.‡Чтобы получить ключ от города, поговорите с Франклорном Искусником.‡Sprecht mit Franclorn Forgewright, wenn Ihr daran interessiert seid, einen Schlüssel für die Hauptstadt zu erhalten.‡도시 주요 지역으로 통하는 열쇠를 얻고 싶다면 프랑클론 포지라이트와 대화하십시오.‡Habla con Franclorn Forjafina si te interesa obtener una llave de la ciudad.‡Habla con Franclorn Forjador si quieres obtener una llave de la ciudad.‡Parler à Franclorn Forgewright si obtenir une clé de la Cité majeure vous intéresse.‡如果你想要得到进入这座城市主城区的钥匙，就去和弗兰克罗恩·铸铁谈一谈。‡如果妳想要得到進入這座城市主城區的鑰匙，就去和弗蘭克羅恩·鑄鐵談壹談。',
  }
},
[3802] = {
  {
    'Legado dos Ferro Negro‡Наследие Черного Железа‡Dunkeleisenerbe‡검은무쇠단 유물‡El legado de los Hierro Negro‡El legado de los Hierro Negro‡Héritage Sombrefer‡黑铁的遗产‡黑鐵的遺產',
    nil,
    'Mate Fineous Forçanegra e recupere o grande martelo Ferrovil. Leve-o para o Santuário de Thaurissan e coloque-o na estátua de Franclorn Forjífice.‡Убейте Точеня Темностроя и добудьте великий молот, Железный Друг. Отнесите Железного Друга в святилище Тауриссана и вложите его в руки статуи Франклорна Искусника.‡Erschlagt Fineous Darkvire und bergt den großen Hammer Ironfel. Bringt Ironfel zum Schrein von Thaurissan und legt ihn auf die Statue von Franclorn Forgewright.‡파이너스 다크바이어를 처치하고 거대한 망치, 무쇠지옥을 회수해야 합니다. 무쇠지옥을 타우릿산의 제단으로 가져가서 프랑클론 포지라이트의 석상에 두어야 합니다.‡Mata a Finoso Virunegro y recupera el gran martillo, Ferrovil. Lleva a Ferrovil al Santuario de Thaurissan y coloca el martillo en la estatua de Franclorn Forjador.|n‡Mata a Finoso Virunegro y recupera el gran martillo, Ferrovil. Lleva a Ferrovil al Santuario de Thaurissan y coloca el martillo en la estatua de Franclorn Forjador.‡Tuer Fineous Darkvire et récupérer le grand marteau, Souillefer. Apporter Souillefer au sanctuaire de Thaurissan et le placer sur la statue de Franclorn Forgewright.‡杀掉弗诺斯·达克维尔并拿回战锤铁胆。把铁胆之锤拿到索瑞森神殿去，将其放在弗兰克罗恩·铸铁的雕像上。‡殺掉弗諾斯·達克維爾並拿回戰錘鐵膽。把鐵膽之錘拿到索瑞森神殿去，將其放在弗蘭克羅恩·鑄鐵的雕像上。',
  }
},
[3803] = {
  {
    'Grãos-matinais para Darnassus‡Рассветница для Дарнасса‡Morgenkorn nach Darnassus‡다르나서스로 여명초 가져가기‡Mañagrana para Darnassus‡Mañagrana para Darnassus‡Des Fibres d\'aurore pour Darnassus‡达纳苏斯的晨光麦‡達納蘇斯的晨光麥',
    nil,
    nil,
  }
},
[3804] = {
  {
    'Grãos-matinais para o Penhasco do Trovão‡Рассветница для Громового Утеса‡Morgenkorn nach Thunder Bluff‡썬더 블러프로 여명초 가져가기‡Mañagrana para Cima del Trueno‡Mañagrana para Cima del Trueno‡Des Fibres d\'aurore pour Thunder Bluff‡雷霆崖的晨光麦‡雷霆崖的晨光麥',
    nil,
    nil,
  }
},
[3821] = {
  {
    'Rochedo Malhorrendo‡Скала Молота Ужаса‡Schreckensfels‡우레망치 바위굴‡Roca Machacamiedo‡Roca Machacamiedo‡Le Rocher des Cognepeurs‡巨槌石‡巨槌石',
    nil,
    'Explore as Estepes Ardentes e descubra o que aconteceu com Sha\'ni Altapresa.‡Отправляйтесь в Пылающие степи и выясните, что сталось с Ша\'ни Гордым Клыком.‡Begebt Euch in die brennende Steppe und findet heraus, was aus Sha\'ni Proudtusk geworden ist.‡불타는 평원으로 가서 샤니 프라우드터스크에게 무슨 일이 있었는지 확인해야 합니다.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colminilludo.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colmillo Orgulloso.‡S\'aventurer dans les Steppes ardentes et découvrir ce qu\'il est advenu de Sha\'ni Proudtusk.‡到燃烧平原去找到沙妮·长齿。‡到燃燒平原去找到沙妮·長齒。',
  }
},
[3822] = {
  {
    'Krom\'Grul‡Кром\'Грул‡Krom\'Grul‡크롬그룰‡Krom\'Grul‡Krom\'Grul‡Krom\'Grul‡克罗格鲁尔‡克羅格魯爾',
    nil,
    'Recupere a Argola Nasal de Sha\'ni de Krom\'Grul e leve-a para Thal\'trak em Karrath. Procure nas várias cavernas e minas do Rochedo Malhorrendo.‡Заберите ноздревое кольцо Ша\'ни у Кром\'Грула и верните его Тал\'траку из Каргата. Обыщите различные пещеры и рудники скалы Молота Ужаса.‡Holt Sha\'nis Nasenring von Krom\'Grul zurück und bringt ihn zu Thal\'trak in Kargath. Durchsucht die verschiedenen Höhlen und Minen im Schreckensfels.‡크롬그룰에게서 샤니의 코걸이를 찾아 카르가스에 있는 탈트라크에게 가져가야 합니다. 우레망치 바위굴에 있는 여러 광산과 동굴을 찾아봐야 합니다.‡Recupera la alianza de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.‡Recupera el aro de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.‡Récupérer l’Anneau de nez de Sha\'ni sur Krom\'Grul, et le rapporter à Thal\'trak, à Kargath. Fouiller les différentes grottes et mines du Rocher des Cognepeurs.‡从克罗格鲁尔手中拿回沙妮的鼻环，把它还给卡加斯的萨特拉克。搜寻巨槌石的每一处山洞和矿井。‡從克羅格魯爾手中拿回沙妮的鼻環，把它還給卡加斯的薩特拉克。搜尋巨槌石的每壹處山洞和礦井。',
  }
},
[3823] = {
  {
    'Extinção dos Pirobuchos‡Угасание Огненного Чрева‡Die Feuermagenoger auslöschen‡불자루 오우거 처치‡El exterminio de los Ardentrañas‡El exterminio de los Pirontraña‡Exterminer les Brûlentrailles‡消灭火腹食人魔‡消滅火腹食人魔',
    nil,
    'Mate 15 Ogros-magos Pirobucho, 7 Ogros Pirobucho e 7 Brutamontes Ogros Pirobucho e fale novamente com Oralius quando terminar.‡Убейте 15 огров-магов, 7 огров и 7 громил из клана Огненного Чрева. По выполнении задания вернитесь к Орелиусу.‡Tötet 15 Ogermagier der Feuermägen, 7 Oger der Feuermägen sowie 7 Schläger der Feuermägen und kehrt zu Oralius zurück, wenn Ihr fertig seid.‡불자루일족 오우거마법사 15마리, 불자루 오우거 7마리, 불자루일족 투사 7마리를 처치한 후 랄리우스에게 돌아가야 합니다.‡Mata a 15 ogros magos Pirontraña, 7 ogros Pirontraña y 7 ogros brutos Pirontraña y vuelve junto a Oralius cuando hayas acabado.‡Mata a 15 magos ogros Pirontraña, 7 ogros Pirontraña y 7 ogros toscos Pirontraña.‡Tuer 15 Ogres-mages Brûlentrailles, 7 Ogres Brûlentrailles et 7 Brutes Brûlentrailles, puis retourner voir Oralius.‡杀掉15个火腹食人魔法师、7个火腹食人魔和7个火腹蛮兵，完成任务之后向奥拉留斯报告。‡殺掉15個火腹食人魔法師、7個火腹食人魔和7個火腹蠻兵，完成任務之後向奧拉留斯報告。',
  }
},
[3824] = {
  {
    'Gor\'tesh, o lorde dos brutamontes‡Гор\'теш Жестокий‡Gor\'tesh der Schläger-Lord‡포악한 군주 고르테쉬‡Gor\'tesh, el Señor bruto‡Gor\'tesh, el Señor de los toscos‡Le seigneur-brute Gor\'tesh‡蛮王戈泰什‡蠻王戈泰什',
    nil,
    'Encontre Gor\'tesh em algum lugar a oeste do Rochedo Malhorrendo. Mate Gor\'tesh e depois leve a Cabeça Decepada do Gor\'tesh de volta a Oralius nas Estepes Ardentes.‡Найдите Гор\'теша на западе от скалы Молота Ужаса. Убейте Гор\'теша и отнесите его голову Орелиусу в Пылающие степи.‡Sucht Gor\'tesh irgendwo im Westen des Schreckensfelsens. Tötet Gor\'tesh und bringt dann seinen abgehackten Kopf zu Oralius in der brennenden Steppe zurück.‡우레망치 바위굴의 서쪽 어딘가에서 고르테쉬를 찾아 처치하고 고르테쉬의 가면을 얻어 불타는 평원에 있는 랄리우스에게 가져가야 합니다.‡Encuentra a Gor\'tesh, en el algún lugar al oeste de la Roca Machacamiedo. Mata a Gor\'tesh y llévale entonces la cabeza cortada de Gor\'tesh a Oralius en Las Estepas Ardientes.‡Recoge la cabeza cortada de Gor\'tesh.‡Trouver Gor\'tesh, quelque part à l’ouest du rocher des Cognepeurs. Le tuer et rapporter la Tête coupée de Gor\'tesh à Oralius, dans les Steppes ardentes.‡找到戈泰什，他应该在巨槌石西面的某处。杀掉戈泰什并把他的头颅交给燃烧平原的奥拉留斯。‡找到戈泰什，他應該在巨槌石西面的某處。殺掉戈泰什並把他的頭顱交給燃燒平原的奧拉留斯。',
  }
},
[3825] = {
  {
    'A festa da cabeça cortada‡Голова огра на палочке = вечеринка‡Ogerkopf auf einem Pfahl = Party‡창에 꽂은 오우거 가면‡Una cabeza ogro empalada = FIESTA‡Una cabeza ogro empalada = FIESTA‡Une tête d\'ogre au bout d\'une pique = une fête‡枭首示众‡梟首示眾',
    nil,
    'Pegue a Cabeça Decepada do Gor\'Tesh e coloque no topo do Rochedo Malhorrendo. Procure um montinho de terra macia para espetar a estaca.‡Отнесите голову Гор\'теша на вершину скалы Молота Ужаса. Поищите кучу рыхлой земли и воткните в нее пику.‡Nehmt Gor\'teshs abgehackten Kopf und platziert ihn auf dem Gipfel des Schreckensfelsens. Sucht nach einem weichen Erdhügel, um den Pfahl aufzustellen.‡고르테쉬의 가면을 가지고 가서 우레망치 바위굴의 꼭대기에 꽂아야 합니다. 창을 꽂을 부드러운 흙으로 덮인 고분을 찾도록 하십시오.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Prendre la Tête coupée de Gor\'tesh et la placer au sommet du Rocher des Cognepeurs. Chercher un monticule de terre meuble pour planter la pique.‡把戈泰什的头颅放在巨槌石的山顶上。找一块软土堆把串着头颅的长矛插上去就可以了。‡把戈泰什的頭顱放在巨槌石的山頂上。找壹塊軟土堆把串著頭顱的長矛插上去就可以了。',
  }
},
[3841] = {
  {
    'Um órfão em busca de um lar‡Бездомный сиротка‡Waise sucht Zuhause‡집을 찾고 있는 고아‡Un huérfano que busca un hogar‡Un huérfano que busca un hogar‡Un orphelin à la recherche d\'un foyer‡领养孤儿‡領養孤兒',
    nil,
    'Fale com Quentin em Mil Agulhas.‡Поговорите с Квентином в Тысяче Игл.‡Sprecht mit Quentin in Tausend Nadeln.‡버섯구름 봉우리에 있는 켄튼과 대화해야 합니다.‡Ve a Las Mil Agujas y habla con Quentin.‡Ve a Las Mil Agujas y habla con Quentin.‡Parler à Quentin aux Mille pointes.‡与千针石林的奎恩丁谈一谈。‡與千針石林的奎恩丁談壹談。',
  }
},
[3842] = {
  {
    'Uma incubação curta‡Инкубатор‡Kurz vor dem Schlüpfen‡짧은 부화‡Una corta incubación‡Una corta incubación‡Une courte incubation‡即将孵化‡即將孵化',
    nil,
    'Entregue 2 Elixires de Fortitude para Quentin em Mil Agulhas.‡Принесите 2 эликсира стойкости Квентину в Тысячу Игл.‡Bringt 2 Elixiere der Seelenstärke zu Quentin in Tausend Nadeln.‡버섯구름 봉우리에 있는 켄튼에게 인내의 비약 2개를 가져가야 합니다.‡Lleva 2 elixires de la entereza a Quentin a Las Mil Agujas.‡Lleva 2 elixires de entereza a Quentin a Las Mil Agujas.‡Apporter 2 Elixirs de Robustesse à Quentin, aux Mille pointes.‡将2份坚韧药剂交给千针林的奎恩丁。‡將2份堅韌藥劑交給千針林的奎恩丁。',
  }
},
[3843] = {
  {
    'O mais novo integrante da família‡Новый член семьи‡Das neueste Mitglied der Familie‡새로운 가족의 탄생‡Un nuevo miembro en la familia‡Un nuevo miembro en la familia‡Un tout nouveau membre dans la famille‡新的生命‡新的生命',
    nil,
    'Leve o Ovo Frágil de Dardejante às Terras Agrestes e fale com Agnar Domaferas, mas corra, você só tem uma hora para encontrá-lo antes que o filhote dentro do ovo morra.‡Отнесите хрупкое яйцо летучего хамелеона во Внутренние земли и поговорите с Агнаром Зверопасом. У вас есть на это всего 1 час. В противном случае детеныш в яйце умрет.‡Bringt Euer empfindliches Grimmlingflitzerei ins Hinterland und sprecht mit Agnar Beastamer, aber beeilt Euch. Ihr habt nur eine Stunde Zeit, ihn zu finden. Dann stirbt das Jungtier in dem Ei.‡동부 내륙지로 깨지기 쉬운 화살요정용 알을 가져가서 아그나르 비스테이머와 대화하십시오. 1시간 내에 아그나르를 찾지 못하면 알 속의 새끼가 죽게 되니 서둘러야 합니다.‡Lleva tu huevo de duende dardo frágil a las Tierras del Interior y habla con Agnar Domabestias, pero date prisa: si tardas más de 1 hora en encontrarlo, la cría que hay en el huevo morirá.‡Lleva tu huevo de duende dardo frágil a las Tierras del Interior y habla con Agnar Domabestias, pero date prisa: si tardas más de 1 hora en encontrarlo, la cría que hay en el huevo morirá.‡Emmenez votre Oeuf fragile de Fée fléchetteuse dans les Hinterlands et parlez à Agnar Beastamer. Dépêchez-vous, vous n’avez qu’une heure pour le trouver avant que le petit ne meure dans l’oeuf.‡带着这枚脆弱的小精龙卵去辛特兰，与阿格纳谈一谈，但是你一定要在它还有生命力的时候赶到，在蛋里的小生命夭折之前，你只有1小时的时间。‡帶著這枚脆弱的小精龍卵去辛特蘭，與阿格納談壹談，但是妳壹定要在它還有生命力的時候趕到，在蛋裏的小生命夭折之前，妳只有1小時的時間。',
  }
},
[3844] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un Secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Olhe em volta da lagoa para descobrir uma pista sobre quem pode ser o dono do bote destruído.‡Осмотритесь и попытайтесь выяснить, кому мог бы принадлежать разбитый плот.‡Sucht in dem Tümpel nach einem Hinweis darauf, wem dieses havarierte Floß gehören könnte.‡연못을 둘러보고 이 난파된 나룻배의 주인에 대한 단서를 찾아야 합니다.‡Busca alrededor del estanque alguna pista sobre a quién perteneció la balsa destrozada.‡Busca alrededor del estanque alguna pista sobre a quién perteneció la balsa destrozada.‡Rechercher dans l\'étang un indice sur l\'identité du propriétaire du radeau brisé.‡在池塘附近查找与搁浅的小艇有关的线索。‡在池塘附近查找與擱淺的小艇有關的線索。',
  }
},
[3845] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Examine os itens dentro da bolsa e leve até o dono.‡Изучите найденное в сумке и верните владельцу.‡Untersucht die Gegenstände in dem Bündel und bringt sie zu ihrem Besitzer.‡가방 안에 든 물건을 조사해 그 주인에게 되돌려주어야 합니다.‡Examina los objetos de la talega y devuélveselos a su propietario.‡Examina los objetos de la talega y devuélveselos a su propietario.‡Examiner les objets du paquet et les apporter à leur propriétaire.‡查看袋子里的东西，然后将它们交给物主。‡查看袋子裏的東西，然後將它們交給物主。',
  }
},
[3861] = {
  {
    'COCORICÓ!‡Куд-кудаааа!‡GLUCK!‡꼬꼬댁!!!‡¡CLOQUEA!‡¡CLOQUEA!‡COT-COT-CODEC !‡咕咕嘎！‡咕咕嘎！',
    nil,
    'Procure a Ração Especial de Galinha e volte até sua nova amiga galinácea. Em seguida, use a expressão /incentivar diante dela e lhe dê a Ração Especial de Galinha.‡Найдите немного цыплячьего корма и вернитесь к вашей курочке-подружке. Когда найдете ее, /поклонитесь ей прежде, чем накормить ее специальным цыплячьим кормом.‡Beschafft Euch etwas Spezial-Hühnerfutter und kehrt zu dem Huhn zurück, das sich mit Euch angefreundet hat. Wenn Ihr es gefunden habt, dann benutzt erst /cheer, ehe Ihr dem Huhn das Spezial-Hühnerfutter gebt.‡특별 닭모이를 찾아 친구가 된 닭에게 돌아가야 합니다. 특별 닭모이를 주기 전에 닭을 찾으면 /환호해야 합니다.‡Consigue comida para pollos y ve con el pollo que has conocido. Cuando lo encuentres, /dórale la píldora antes de darle la comida.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Trouver de la Nourriture spéciale pour poulet et l\'apporter à la poule que vous voulez aider. Lorsque vous l\'aurez trouvée, encouragez-la (/acclame) avant d\'essayer de lui donner la Nourriture spéciale pour poulet.‡找一些特殊的鸡饲料，把它交给友好的小鸡。当你找到小鸡的时候，在喂食它之前对它做出高兴的表情。（使用/cheer命令）‡找壹些特殊的雞飼料，把它交給友好的小雞。當妳找到小雞的時候，在餵食它之前對它做出高興的表情。（使用/cheer命令）',
  }
},
[3881] = {
  {
    'A salvação da expedição‡Спасение экспедиции‡Rettungsexpedition‡원정대 구조‡Expedición Salvación‡Salvar a la expedición‡Le sauvetage de l\'expédition‡抢救物资‡搶救物資',
    nil,
    'Leve um Caixote de Comestíveis e o Equipamento de Pesquisa para Williden Marshal in Cratera Un\'Goro.‡Принесите ящик с провизией и исследовательское оборудование Виллидену Маршалу в Кратер Ун\'Горо.‡Bringt eine Kiste mit Nahrungsmitteln und Forscherausrüstung zu Williden Marshal im Un\'Goro Krater.‡운고로 분화구에 있는 윌리덴 마샬에게 식량 상자와 탐사 장비를 가져가야 합니다.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Apporter une Caisse de nourriture et de l\'Equipement de recherche à Williden Marshal dans le Cratère d\'Un\'Goro.‡将食物箱和研究设备交给安戈洛环形山的威利德·马绍尔。‡將食物箱和研究設備交給安戈洛環形山的威利德·馬紹爾。',
  }
},
[3882] = {
  {
    'Osso duro de roer‡Игра в кости‡Knochenklappern‡뼈 수집‡Choca esos huesos‡Choca esos huesos‡Faites rouler les os‡挖骨头‡挖骨頭',
    nil,
    'Leve 8 Ossos de Dinossauro para Chispa Minanilo na Cratera Un\'Goro.‡Принесите 8 костей динозавра Искру Пустокопу в Кратер Ун\'Горо.‡Bringt 8 Dinosaurierknochen zu Spark Nilminer im Un\'Goro Krater.‡운고로 분화구에 있는 스파크 닐마이너에게 공룡 뼈 8개를 가져가야 합니다.‡Lleva 8 huesos de dinosaurio a Chispik Nilminer en el Cráter de Un\'Goro.‡Lleva 8 huesos de dinosaurio a Chispik Minamal en el Cráter de Un\'Goro.‡Apporter 8 Os de dinosaure à Spark Nilminer, au cratère d\'Un\'Goro.‡将8根恐龙骨头交给安戈洛环形山的斯巴克·尼米尔。‡將8根恐龍骨頭交給安戈洛環形山的斯巴克·尼米爾。',
  }
},
[3883] = {
  {
    'Ecologia forânea‡Экология чужих‡Eine fremdartige Ökologie‡외래 생태계‡Ecología alienígena‡Ecología alienígena‡Ecologie étrangère‡异型的生态‡異型的生態',
    nil,
    'Use a Ampola de Amostra para coletar uma Amostra de Parede de Colmeia de uma das incubadoras Gorishi na Cratera Un\'Goro. Procure as câmaras com larvas.|nLeve a Amostra de Parede de Colmeia para Hol\'anyee Marshal na Cratera Un\'Goro.‡Воспользуйтесь фиалом для образцов, чтобы взять образец материала стены улья из одного из инкубаторов Гориши в Кратере Ун\'Горо. Ищите в ульях комнаты со свисающими гроздьями личинок.|nПринесите образец материала стены улья Холании Маршал в Кратер Ун\'Горо.‡Verwendet die Kratzphiole, um damit eine Schwarmbauwandprobe von einer der Schwarmbrutstätten der Gorishi im Un\'Goro Krater zu holen. Sucht nach den Kammern mit der hängenden Larvenbrut.|nBringt die Schwarmbauwandprobe zu Hol\'anyee Marshal im Un\'Goro Krater.‡운고로 분화구에 있는 고리쉬 부화장에서 채집 약병을 사용해 고리쉬집 벽면 견본을 채취하십시오. 유충알이 매달려 있는 방을 찾아야 합니다.|n운고로 분화구에 있는 홀라니에 마샬에게 고리쉬집 벽면 견본을 가져가야 합니다.‡Utiliza el vial raspador para recoger una Muestra de pared de la colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|nLleva la Muestra de pared de la colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliza el vial de raspadura para recoger una Muestra de pared de colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|nLleva la Muestra de pared de colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliser la Fiole de raclement pour récolter un Echantillon de paroi de la ruche dans une des nurseries de la ruche Gorishi, à l’intérieur du cratère d\'Un\'Goro. Chercher les chambres qui contiennent des larves suspendues.|nApporter l’Echantillon de paroi de la ruche à Hol\'anyee Marshal dans le cratère d\'Un\'Goro.‡使用采集瓶从安戈洛环形山的某个格里什虫巢的孵化室中收集一份巢穴侧壁的样本，在有悬挂着的虫卵的房间里收集样本。|n将虫穴内壁样本交给安戈洛环形山的霍莱伊·马绍尔。‡使用采集瓶從安戈洛環形山的某個格裏什蟲巢的孵化室中收集壹份巢穴側壁的樣本，在有懸掛著的蟲卵的房間裏收集樣本。|n將蟲穴內壁樣本交給安戈洛環形山的霍萊伊·馬紹爾。',
  }
},
[3884] = {
  {
    'Diário de Williden‡Дневник Вилидена‡Willidens Tagebuch‡윌리덴의 일지‡Diario de Williden‡Diario de Williden‡Le journal de Williden‡威利德的日记‡威利德的日記',
    nil,
    'Devolva o diário a Williden Marshal na Cratera Un\'Goro.‡Верните дневник Виллидену Маршалу, который находится где-то в Кратере Ун\'Горо.‡Bringt das Tagebuch zu Williden Marshal zurück. Er befindet sich irgendwo im Un\'Goro Krater.‡운고로 분화구 어딘가에 있는 윌리덴 마샬에게 일지를 돌려줘야 합니다.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Rapporter le Journal à Williden Marshal quelque part dans le Cratère d\'Un\'Goro.‡将日记还给安戈洛环形山中的威利德·马绍尔。‡將日記還給安戈洛環形山中的威利德·馬紹爾。',
  }
},
[3901] = {
  {
    'Desossando alguns Range-ossos‡Игрушки-погремушки‡Klappernde Skelette‡덜그럭거리는 해골 처치‡Sacudir esqueletos‡Sacudir esqueletos‡Faites cliqueter les thorax !‡断骨骷髅‡斷骨骷髏',
    nil,
    'Mate 12 Esqueletos Range-ossos e fale novamente com o Sacerdote Sombrio Sarvis em Plangemortis quando terminar.‡Убейте 12 скелетов-костетрясов, а затем вернитесь к жрецу Тьмы Сарвису в Могильник.‡Tötet 12 klappernde Skelette und kehrt zu Schattenpriester Sarvis in Deathknell zurück, wenn Ihr fertig seid.‡덜그럭거리는 해골 12명을 처치한 후, 데스넬에 있는 어둠의사제 사비스에게 돌아가야 합니다.‡Mata a 12 esqueletos armadóseos y cuando lo hayas hecho, vuelve a buscar al sacerdote de las Sombras Sarvis a Camposanto.‡Mata a 12 esqueletos armadóseos, y vuelve con el sacerdote de las sombras Sarvis en Camposanto cuando termines.‡Tuez 12 Squelettes Cliquethorax, puis retournez voir le prêtre des ombres Sarvis au Glas.‡杀掉12个断骨骷髅，然后回到丧钟镇的暗影牧师萨维斯那里。‡殺掉12個斷骨骷髏，然後回到喪鐘鎮的暗影牧師薩維斯那裏。',
  }
},
[3902] = {
  {
    'Vasculhando Plangemortis‡Поиски старой одежды‡Beutesuche in Deathknell‡데스넬에서의 폐품 수집‡Hurgar en Camposanto‡Hurgar en Camposanto‡La chasse aux trésors‡捡破烂‡撿破爛',
    nil,
    'Procure 6 peças de Material Reaproveitado nas redondezas de Plangemortis e fale novamente com o Necroguarda Saulo.‡Обыщите Могильник и его окрестности и найдите 6 ящиков с добычей и передайте их стражу смерти Салтену.‡Durchsucht Deathknell und Umgebung nach 6 Stücken aufgestöberter Ware und bringt sie zu Todeswache Saltain zurück.‡데스넬과 그 주변에서 쓸만한 물건 6개를 찾아 죽음의경비병 살테인에게 돌아가야 합니다.‡Busca 6 piezas de mercancías extraviadas por Camposanto y los alrededores y llévaselas al guardia de la muerte Saltain.‡Busca 6 piezas de mercancías extraviadas por Camposanto y los alrededores y llévaselas al Guardia de la Muerte Saltain.‡Fouiller Le Glas et ses alentours pour trouver 6 pièces de fournitures de récupération, et les ramener au Garde noir Saltain.‡在丧钟镇及临近地区搜寻6件破烂装备，把它们交给亡灵卫兵萨尔坦。‡在喪鐘鎮及臨近地區搜尋6件破爛裝備，把它們交給亡靈衛兵薩爾坦。',
  }
},
[3903] = {
  {
    'Madel Quintana‡Милли Осворт‡Milly Osworth‡밀리 오스워드‡Milly Osworth‡Milly Osworth‡Milly Osworth‡米莉·奥斯沃斯‡米莉·奧斯沃斯',
    nil,
    'Fale com Madel Quintana.‡Поговорите с Милли Осворт.‡Sprecht mit Milly Osworth.‡밀리 오스워드와 대화해야 합니다.‡Habla con Milly Osworth.‡Habla con Milly Osworth.‡Parler à Milly Osworth.‡与米莉·奥斯沃斯谈一谈。‡與米莉·奧斯沃斯談壹談。',
  }
},
[3904] = {
  {
    'Colheita da Madel‡Урожай Милли‡Millys Ernte‡밀리의 수확물‡La cosecha de Milly‡La cosecha de Milly‡Les vendanges de Milly‡米莉的葡萄‡米莉的葡萄',
    nil,
    'Leve 8 caixotes da Colheita da Madel para Madel Quintana na Abadia de Vila Norte.‡Принесите 8 корзин с виноградом Милли Осворт в Аббатство Североземья.‡Bringt 8 Kisten mit Millys Ernte zu Milly Osworth in der Nähe der Abtei von Nordhain.‡노스샤이어 수도원에 있는 밀리 오스워드에게 밀리의 수확물 8 상자를 가져가야 합니다.‡Lleva 8 cajas de uva recogida a Milly Osworth a la Abadía de Villanorte.‡Lleva 8 cajas de cosecha a Milly Osworth a la Abadía de Villanorte.‡Apporter 8 seaux de la récolte de Milly à Milly Osworth à l\'Abbaye de Northshire.‡收集8箱米莉的葡萄，把它们交给北郡修道院的米莉·奥斯沃斯。‡收集8箱米莉的葡萄，把它們交給北郡修道院的米莉·奧斯沃斯。',
  }
},
[3905] = {
  {
    'Manifesto da Uva‡Уведомление о поставке винограда‡Traubenliste‡포도 수확 목록‡Informe de la vendimia‡Informe de la vendimia‡Manifeste des vendanges‡葡萄出货单‡葡萄出貨單',
    nil,
    'Leve o Manifesto da Uva para o Irmão Neals na Abadia de Vila Norte.‡Отнесите уведомление о поставке винограда брату Нилзу в Аббатство Североземья.‡Bringt die Traubenliste zu Bruder Neals in der Abtei von Nordhain.‡노스샤이어 수도원에 있는 수사 닐스에게 포도 수확 목록을 가져가야 합니다.‡Lleva el Informe de la vendimia al hermano Neals a la Abadía de Villanorte.‡Lleva el Informe de la vendimia al hermano Neals a la Abadía de Villanorte.‡Apporter le Manifeste des vendanges à Frère Neals dans l\'Abbaye de Northshire.‡将葡萄出货单交给北郡修道院的尼尔斯修士。‡將葡萄出貨單交給北郡修道院的尼爾斯修士。',
  }
},
[3906] = {
  {
    'Desarmonia das chamas‡Дисгармония пламени‡Disharmonie der Flamme‡화염의 부조화‡La discordia de las llamas‡La discordia de las llamas‡Discordance des flammes‡不和谐的烈焰‡不和諧的烈焰',
    nil,
    'Vá até a pedreira da Montanha Rocha Negra e mate o Mestre Supremo Piro. Fale novamente com Coração Trovejante quando tiver cumprido essa tarefa.‡Отправьтесь в карьер у Черной горы и уничтожьте Подчинителя Пирона. По выполнению вернитесь к Громосерду.‡Reist zum Steinbruch am Blackrock und tötet Übermeister Pyron. Kehrt zu Thunderheart zurück, sobald Ihr den Auftrag erledigt habt.‡검은바위 산에 있는 채석장으로 가서 멸망의 파이론을 처치해야 합니다. 이 임무를 완수한 후 썬더하트에게 돌아가십시오.‡Ve a la cantera de la Montaña Roca Negra y ejecuta al gran maestro Pyron. Vuelve junto a Truenozón cuando hayas completado este encargo.‡Ve a la cantera de la Montaña Roca Negra y ejecuta al Maestro Supremo Pyron. Vuelve junto a Corazón Atronador cuando hayas completado este encargo.‡Partir pour la carrière dans le mont Blackrock et tuer le Grand maître Pyron. Retourner voir Thunderheart une fois votre mission accomplie.‡到黑石山脉的采石场去干掉征服者派隆，然后向桑德哈特回报。‡到黑石山脈的采石場去幹掉征服者派隆，然後向桑德哈特回報。',
  }
},
[3907] = {
  {
    'Desarmonia do fogo‡Дисгармония пламени‡Disharmonie des Feuers‡불의 부조화‡La discordia de las llamas‡La discordia del fuego‡Discordance des flammes‡不和谐的火焰‡不和諧的火焰',
    nil,
    'Entre no Abismo Rocha Negra e encontre o Lorde Incendius. Mate-o e leve todas as informações que puder para o Coração Trovejante.‡Ступайте в глубины Черной горы и выследите лорда Опалителя. Убейте его и принесите Громосерду все, что может дать какую-то информацию.‡Betretet die Blackrocktiefen und spürt Lord Incendius auf. Tötet ihn und bringt jegliche Informationsquelle, die Ihr finden könnt, zu Thunderheart.‡검은바위 나락에 들어가 불의군주 인센디우스를 찾아, 그를 처치한 후 얻게 되는 모든 정보를 썬더하트에게 가져가야 합니다.‡Adéntrate en las Profundidades de Roca Negra y localiza a Lord Incendius. Mátalo y llévale toda la información que encuentres a Truenozón.‡Adéntrate en las Profundidades de Roca Negra y localiza a Lord Incendius. Mátalo y llévale toda la información que encuentres a Corazón Atronador.‡Pénétrer dans les Profondeurs de Blackrock et traquer le Seigneur Incendius. Le tuer puis donner tous les renseignements que vous pouvez trouver à Thunderheart.‡进入黑石深渊并找到伊森迪奥斯。杀掉它，然后把你找到的信息汇报给桑德哈特。‡進入黑石深淵並找到伊森迪奧斯。殺掉它，然後把妳找到的信息匯報給桑德哈特。',
  }
},
[3908] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un Secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Leve a Espada de Linken para Bruna Covaneve em Hibérnia.‡Отнесите меч Линкена Донове Снегоноре.‡Bringt Linkens Schwert zu Donova Snowden in Winterspring.‡여명의 설원에 있는 도노바 스노우덴에게 링쿠의 훈련용 검을 가져가야 합니다.‡Lleva la Espada de Linken a Donova Cubilnevado en Cuna del Invierno.‡Lleva la Espada de Linken a Donova Cubilnevado en Cuna del Invierno.‡Apporter l’Epée de Linken à Donova Snowden dans le Berceau-de-l\'Hiver.‡把林克的剑交给冬泉谷的多诺瓦·雪山。‡把林克的劍交給冬泉谷的多諾瓦·雪山。',
  }
},
[3909] = {
  {
    'O elixir Videre‡Эликсир Видере‡Das Videre-Elixier‡앞날의 비약‡El Elixir de Videre‡El Elixir de Videre‡L\'élixir de Videre‡视灵药剂‡視靈藥劑',
    nil,
    'Procure Gregan Cospechope ao norte de Feralas. Descubra com ele como obter o elixir Videre, depois fale novamente com Bruna Covaneve em Hibérnia.‡Найдите Грегана Пивоплюя на севере Фераласа. Выясните у него, как получить эликсир Видере, и вернитесь к Донове Снегоноре.‡Sucht nach Gregan Brewspewer im nördlichen Feralas. Lasst Euch von ihm erklären, wie Ihr Euch das Videre-Elixier beschaffen könnt, und kehrt dann zu Donova Snowden nach Winterspring zurück.‡페랄라스 북쪽에서 그레간 브루스퓨를 찾아야 합니다. 그에게서 앞날의 비약을 얻는 방법을 배워 여명의 설원에 있는 도노바 스노우덴에게 돌아가야 합니다.‡Busca a Gregan Vomitabrebaje en el norte de Feralas. Con él, aprende cómo puedes obtener el Elixir de Videre. Cuando lo sepas, vuelve con Donova Cubilnevado en Cuna del Invierno.‡Busca a Gregan Tirabirras en el norte de Feralas. Con él, aprende cómo puedes obtener el Elixir de Videre. Cuando lo sepas, vuelve con Donova Cubilnevado en Cuna del Invierno.‡Rechercher Gregan Brewspewer au nord de Feralas. Apprendre de lui comment vous pouvez acquérir l\'élixir de Videre, puis retourner voir Donova Snowden, au Berceau-de-l\'Hiver.‡去菲拉斯找格雷甘·山酒。从他那里问到获取视灵药剂的方法，然后向冬泉谷的多诺瓦·雪山复命。‡去菲拉斯找格雷甘·山酒。從他那裏問到獲取視靈藥劑的方法，然後向冬泉谷的多諾瓦·雪山復命。',
  }
},
[3912] = {
  {
    'Encontro na sepultura‡Встречаемся на кладбище‡Treffen am Grab‡무덤에서의 만남‡Encuentro en la tumba‡Encuentro en la tumba‡Rendez-vous à la tombe‡墓地相见‡墓地相見',
    nil,
    'Vá até o cemitério perto de Geringontzan e use o Elixir Videre. Siga as outras instruções de Bruna para achar Gaeriyan.‡Отправляйтесь на кладбище на окраине Прибамбасска и выпейте там эликсир Видере. Далее, следуя инструкциям Доновы, найдите Гаэриана.‡Geht zum Friedhof außerhalb von Gadgetzan und benutzt dort das Videre-Elixier. Befolgt Donovas übrige Anweisungen, um Gaeriyan zu finden.‡가젯잔 밖에 있는 무덤으로 가서 앞날의 비약을 사용하십시오. 도노바의 지시에 따라 개리얀을 찾아야 합니다.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Se rendre au cimetière au-dehors de Gadgetzan et boire l\'élixir de Videre. Suivre le reste des instructions de Donova pour trouver Gaeriyan.‡在加基森镇外的墓地中使用视灵药剂，然后按照多诺瓦的指示找到加里杨。‡在加基森鎮外的墓地中使用視靈藥劑，然後按照多諾瓦的指示找到加裏楊。',
  }
},
[3913] = {
  {
    'A sepultura‡Замогильная история‡Grabesstille‡무덤의 상태‡Una situación mortal‡Una situación mortal‡Une situation grave‡寻找墓碑‡尋找墓碑',
    nil,
    'Ressuscite, depois procure a lápida que Gaeriyan disse para você encontrar.‡Воскресните, найдите могильный камень, о котором говорил Гаэриан.‡Wenn Ihr auferstanden seid, sucht nach dem Grabstein, von dem Gaeriyan Euch erzählt hat.‡부활한 후, 개리얀이 말한 묘비를 찾아야 합니다.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Ressusciter, puis rechercher la pierre tombale que Gaeriyan vous a demandé de trouver.‡复活，然后寻找加里杨让你去找的那块墓碑。‡復活，然後尋找加裏楊讓妳去找的那塊墓碑。',
  }
},
[3914] = {
  {
    'Espada de Linken‡Меч Линкена‡Linkens Schwert‡링쿠의 검‡La Espada de Linken‡La Espada de Linken‡L\'épée de Linken‡林克的剑‡林克的劍',
    nil,
    'Leve a Espada Superior de Linken para Linken na Cratera Un\'Goro.‡Доставьте превосходный меч Линкена Линкену в Кратер Ун\'Горо.‡Liefert Linkens überragendes Schwert bei Linken im Un\'Goro Krater ab.‡운고로 분화구에 있는 링쿠에게 링쿠의 명검을 가져가야 합니다.‡Entrega la Espada superior a Linken en el Cráter de Un\'Goro.‡Entrega la Espada superior a Linken en el Cráter de Un\'Goro.‡Remettre l\'Epée excellente de Linken à Linken dans le cratère d\'Un\'Goro.‡把林克的强化之剑交给安戈洛尔环形山的林克。‡把林克的強化之劍交給安戈洛爾環形山的林克。',
  }
},
[3921] = {
  {
    'Juntatudy Jogafora‡Венаки Бенике‡Wenikee Boltbucket‡웨니키 볼트버킷‡Wenikee Tuercasmil‡Wenikee Tuercasmil‡Wenikee Boltbucket‡维妮·布特巴克‡維妮·布特巴克',
    nil,
    'Leve a Rebimboca Quebrada para Juntatudy Jogafora.‡Отнесите сломанный самофланж Венаки Бенике.‡Bringt das zerbrochene Samophlang zu Wenikee Boltbucket.‡웨니키 볼트버킷에게 부서진 사모플랜지를 가져가야 합니다.‡Llévale el churumbele roto a Wenikee Tuercasmil.‡Llévale el churumbele roto a Wenikee Tuercasmil.‡Apporter le Samophlange cassé à Wenikee Boltbucket.‡将损坏的主动式负载平衡器交给维妮·布特巴克。‡將損壞的主動式負載平衡器交給維妮·布特巴克。',
  }
},
[3922] = {
  {
    'Chumbalheiras‡Металлические заготовки‡Nugget-Patronen‡용접용 철괴‡Engranajes‡Engranajes‡Les Petites pièces‡高强度齿轮‡高強度齒輪',
    nil,
    'Leve 15 Chumbalheiras para Juntatudy Jogafora nos Sertões.‡Принесите 15 металлических заготовок для деталей Венаки Бенике в Степи.‡Bringt 15 Nugget-Patronen zu Wenikee Boltbucket im Brachland.‡불모의 땅에 있는 웨니키 볼트버킷에게 용접용 철괴 15개를 가져가야 합니다.‡Llévale 15 engranajes a Wenikee Tuercasmil en Los Baldíos.‡Lleva 15 engranajes a Wenikee Tuercasmil en Los Baldíos.‡Apporter 15 Rondelles de métal à Wenikee Boltbucket dans les Tarides.‡把15个高强度齿轮交给贫瘠之地的维妮·布特巴克。‡把15個高強度齒輪交給貧瘠之地的維妮·布特巴克。',
  }
},
[3923] = {
  {
    'Rilli Passomal‡Рилли Грязегоб‡Rilli Greasygob‡릴리 그리지가브‡Rilli Gapegajoso‡Rilli Gapegajoso‡Rilli Greasygob‡雷里·格里斯高布‡雷裏·格裏斯高布',
    nil,
    'Leve a Rebimboca Quebrada e Surrada para o Rilli Passomal em Orgrimmar.‡Отнесите разбитый и сломанный самофланж Рилли Грязегобу в Оргриммар.‡Bringt das zerbrochene Samophlang nach Orgrimmar zu Rilli Greasygob.‡오그리마에 있는 릴리 그리지가브에게 부서지고 찌그러진 사모플랜지를 가져가야 합니다.‡Llévale el churumbele roto y maltrecho a Rilli Gapegajoso en Orgrimmar.‡Llévale el churumbele roto y maltrecho a Rilli Gapegajoso en Orgrimmar.‡Apporter le Samophlange cassé à Rilli Greasygob à Orgrimmar.‡把破碎的主动式负载平衡器交给奥格瑞玛的雷里·格里斯高布。‡把破碎的主動式負載平衡器交給奧格瑞瑪的雷裏·格裏斯高布。',
  }
},
[3924] = {
  {
    'Manual da rebimboca‡Руководство по самофланжу‡Samophlang-Handbuch‡사모플랜지 설명서‡El manual de churumbele‡El manual del churumbele‡Manuel du Samophlange‡主动式负载平衡器说明书‡主動式負載平衡器說明書',
    nil,
    'Leve o Manual da Rebimboca para Rilli Passomal em Orgrimmar.‡Отнесите руководство по самофланжу Рилли Грязегобу в Оргриммар.‡Bringt das Samophlang-Handbuch nach Orgrimmar zu Rilli Greasygob.‡오그리마에 있는 릴리 그리지가브에게 사모플랜지 설명서를 가져가야 합니다.‡Llévale el manual del churumbele a Rilli Gapegajoso en Orgrimmar.‡Llévale el manual del churumbele a Rilli Gapegajoso en Orgrimmar.‡Apporter le Manuel du Samophlange à Rilli Greasygob à Orgrimmar.‡把主动式负载平衡器说明书交给奥格瑞玛的雷里·格里斯高布。‡把主動式負載平衡器說明書交給奧格瑞瑪的雷裏·格裏斯高布。',
  }
},
[3941] = {
  {
    'Ajuda gnômica‡Помощь гномов‡Die Hilfe des Gnoms‡노움의 도움‡La ayuda de una gnoma‡La ayuda de una gnoma‡Un gnome dans le besoin‡侏儒的援助‡侏儒的援助',
    nil,
    'Encontre J.D. Neri na caverna do Refúgio do Marshal.‡Найдите Джей Ди Колли в Укрытии Маршалла.‡Sucht J.D. Collie in der Höhle in Marshals Zuflucht auf.‡마샬의 야영지에 있는 동굴에서 J.D. 콜리를 찾아야 합니다.‡Encuentra a J.D. Collie en la cueva del Refugio de Marshal.‡Encuentra a J.D. Collie en la cueva del Refugio de Marshal.‡Trouver J.D. Collie dans la caverne du refuge des Marshal.‡到马绍尔营地那里的山洞中去找科琳。‡到馬紹爾營地那裏的山洞中去找科琳。',
  }
},
[3942] = {
  {
    'Memória de Linken‡Память Линкена‡Linkens Andenken‡링쿠의 기억‡Recuerdos de Linken‡Recuerdos de Linken‡Les souvenirs de Linken‡林克的记忆‡林克的記憶',
    nil,
    'Encontre Eridan Brisazul no sul da Selva Maleva.‡Найдите Эридану Грусть Ветра на юге Оскверненного леса.‡Sucht Eridan Bluewind im südlichen Teil des Teufelswalds.‡악령의 숲 남부에 있는 에리단 블루윈드를 찾아가야 합니다.‡Encuentra a Eridan Vientoazul en el sur de Frondavil.‡Encuentra a Eridan Vientoazul en el sur de Frondavil.‡Trouver Eridan Bluewind dans le sud de Gangrebois.‡到费伍德森林去找艾瑞丹·蓝风。‡到費伍德森林去找艾瑞丹·藍風。',
  }
},
[3961] = {
  {
    'A aventura de Linken‡Приключения Линкена‡Linkens Abenteuer‡링쿠의 모험‡La aventura de Linken‡La aventura de Linken‡L\'aventure de Linken‡林克的冒险‡林克的冒險',
    nil,
    'Leve o Totem de Prata de Aquementas para Linken no Refúgio do Marshal.‡Отнесите серебряный тотем Аквамонтоса Линкену в Укрытие Маршалла.‡Bringt das Silbertotem von Aquementas zu Linken in Marshals Zuflucht.‡마샬의 야영지에 있는 링쿠에게 아쿠에멘타스의 은토템을 가져가야 합니다.‡Lleva el Tótem plateado de Aquementas a Linken, en el Refugio de Marshal.‡Lleva el Tótem plateado de Aquamentas a Linken, en el Refugio de Marshal.‡Apporter le Totem d\'argent d\'Aquementas à Linken au refuge des Marshal.‡把亚奎门塔斯的银图腾交给马绍尔营地里的林克。‡把亞奎門塔斯的銀圖騰交給馬紹爾營地裏的林克。',
  }
},
[3962] = {
  {
    'É perigoso ir sozinho‡Один в поле не воин‡Allein ist es gefährlich‡혼자서 가기 무서운 곳‡Ir solo es peligroso‡Ir solo es peligroso‡C\'est dangereux d\'y aller seul‡结伴而行‡結伴而行',
    nil,
    'Vá para o Pico Penacho de Fogo, ao sul do Refúgio do Marshal.|nEncontre Agni e use o totem para remover sua aura de proteção. Uma vez que for derrotado, pegue a Chama Dourada na caverna.‡Отправляйтесь к Вулкану Огненного Венца, к югу от Укрытия Маршалла.|nНайдите Яропламеня и разрушьте его защитную ауру с помощью тотема. Когда дух будет сражен, заберите из пещеры Золотое пламя.‡Begebt Euch zum Feuerfedergrat südlich von Marshals Zuflucht.|nSucht Sturmflamme und verwendet das Totem, um die schützende Aura, die ihn umgibt, zu entfernen. Sobald er besiegt ist, holt die Goldene Flamme aus der Höhle.‡마샬의 야영지 남쪽에 있는 불기둥 마루로 가야 합니다.|n불바람을 찾아 토템을 이용해 오라를 제거하십시오. 정령을 물리친 후, 동굴에서 황금 불길을 손에 넣어야 합니다.‡Viaja a Cresta del Penacho en Llamas, al sur del Refugio de Marshal.|nBusca a Correfuego y utiliza el Tótem para eliminar su aura protectora. Cuando le hayas derrotado, coge la Llama Dorada de la cueva.‡Viaja a Cresta del Penacho en Llamas, al sur del Refugio de Marshal.|nBusca a Correfuego y utiliza el Tótem para eliminar su aura protectora. Cuando le hayas derrotado, coge la Llama Dorada de la cueva.‡Partir pour la crête de la Fournaise, au sud du refuge des Marshal.|nTrouver Blazerunner et utiliser le Totem pour dissiper son aura protectrice. Une fois Blazerunner vaincu, se procurer la Flamme dorée.‡到马绍尔营地南边的火羽山去。|n找到火焰使者，并使用图腾除掉它的防护光环。在击败它之后从洞中取得金色火焰。‡到馬紹爾營地南邊的火羽山去。|n找到火焰使者，並使用圖騰除掉它的防護光環。在擊敗它之後從洞中取得金色火焰。',
  }
},
[3981] = {
  {
    'Comandante Gor\'shak‡Командир Гор\'шак‡Kommandant Gor\'shak‡사령관 고르샤크‡Comandante Gor\'shak‡Comandante Gor\'shak‡Le commandant Gor\'shak‡指挥官哥沙克‡指揮官哥沙克',
    nil,
    'Encontre o Comandante Gor\'shak no Abismo Rocha Negra.|nVocê se lembra que o tosco desenho incluía barras rabiscadas sobre o orc. Talvez você devesse procurar algum tipo de prisão.‡Найдите командира Гор\'шака в Глубинах Черной горы.|nСудя по рисунку в записке, искать следует в темнице где-то вроде того.‡Sucht Kommandant Gor\'shak in den Blackrocktiefen.|nIhr erinnert Euch, dass auf dem primitiv gezeichneten Bild des Orcs auch Gitter vor dem Gesicht zu sehen waren. Vielleicht solltet Ihr nach einer Art Gefängnis suchen.‡검은바위 나락에서 사령관 고르샤크를 찾아야 합니다.|n조잡하게 그려진 오크 그림에 쇠창살이 그려져 있던 것이 생각납니다. 감옥 같은 곳을 찾아봐야 할 것 같습니다.‡Encuentra al comandante Gor\'shak en las Profundidades de Roca Negra.|nRecuerdas que en el dibujo burdo había rejas sobre el rostro del orco. Quizás deberías buscar una cárcel o algo similar.‡Encuentra al comandante Gor\'shak en las Profundidades de Roca Negra.|nRecuerdas que en el dibujo burdo había rejas sobre el rostro del orco. Quizás deberías buscar una cárcel o algo similar.‡Trouver le commandant Gor\'shak dans les Profondeurs de Blackrock.|nLe dessin grossier représentait également des barreaux. Peut-être devriez-vous rechercher un genre de prison.‡在黑石深渊里找到指挥官哥沙克。|n在那幅草图上画着的是一个铁栏后面的兽人，也许你应该到某个类似监狱的地方去找找看。‡在黑石深淵裏找到指揮官哥沙克。|n在那幅草圖上畫著的是壹個鐵欄後面的獸人，也許妳應該到某個類似監獄的地方去找找看。',
  }
},
[3982] = {
  {
    'O que está acontecendo?‡Что происходит?‡Was ist los?‡사태 파악‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡出了什麽事？',
    nil,
    'Defenda Gor\'shak.‡Защитите Горшака.‡Verteidigt Gor\'shak.‡고르샤크를 보호해야 합니다.‡Defiende a Gor\'shak.‡Defiende a Gor\'shak.‡Défendre Gor\'shak.‡保护哥沙克。‡保護哥沙克。',
  }
},
[4001] = {
  {
    'O que está acontecendo?‡Что происходит?‡Was ist los?‡사태 파악‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡出了什麽事？',
    nil,
    'Fale com Kharan Feromalho para obter informações sobre o sequestro da Princesa Moira Barbabronze. Leve as informações para Thrall em Orgrimmar.|nGor\'shak mencionou que Kharan estava preso em uma cela próxima.‡Поговорите с дворфом по имени Каран Могучий Молот и соберите информацию о похищении принцессы Мойры Бронзобород. Передайте информацию Траллу в Оргриммар.|nКарана держат в темнице напротив.‡Sprecht mit Kharan Mighthammer und sammelt Informationen über die Entführung von Prinzessin Moira Bronzebeard. Bringt diese Informationen dann zu Thrall nach Orgrimmar.|nIhr erinnert Euch, dass Gor\'shak gesagt hat, Kharan werde in einer Zelle in seiner Nähe festgehalten.‡카란 마이트해머와 대화하여 공주 모이라 브론즈비어드의 납치에 대한 정보를 모은 후, 그 정보를 오그리마에 있는 스랄에게 가져가야 합니다.|n고르샤크가 카란이 근처 감방에 갇혀 있다고 말했던 것이 기억납니다.‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar. Recuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.|n‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar.|nRecuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.‡Parler à Kharan Mighthammer et obtenir autant de renseignements que possible sur l\'enlèvement de la princesse Moira Bronzebeard. Apporter ces renseignements à Thrall à Orgrimmar.|nGor\'shak a dit que Kharan était détenu dans une cellule proche.‡与卡兰·巨锤谈一谈，收集关于绑架公主铁炉堡公主茉艾拉·铜须这一事件的情报。将情报反馈给奥格瑞玛城里的萨尔。|n哥沙克提到过卡兰被关在附近的某个牢房中。‡與卡蘭·巨錘談壹談，收集關於綁架公主鐵爐堡公主茉艾拉·銅須這壹事件的情報。將情報反饋給奧格瑞瑪城裏的薩爾。|n哥沙克提到過卡蘭被關在附近的某個牢房中。',
  }
},
[4002] = {
  {
    'Os Reinos do Leste‡Восточные королевства‡Das östliche Königreich‡동부 왕국‡Los Reinos del Este‡Los Reinos del Este‡Les Royaumes de l\'est‡东部王国‡東部王國',
    nil,
    'Fale com Thrall se estiver <preparado/preparada> para assumir a missão que ele planejou.‡Поговорите с Траллом.‡Sprecht mit Thrall, wenn Ihr bereit seid, die von ihm geplante Mission zu übernehmen.‡스랄이 계획한 임무를 맡을 준비가 되었으면 스랄과 다시 한번 대화하십시오.‡Si aceptas la misión, habla con Thrall.‡Si aceptas la misión, habla con Thrall.‡Parler à Thrall si vous êtes <prêt/prête> à vous charger de la mission qu\'il a prévue.‡如果你准备好要接受萨尔所安排的任务，就去找他谈一谈。‡如果妳準備好要接受薩爾所安排的任務，就去找他談壹談。',
  }
},
[4003] = {
  {
    'O resgate real‡Спасение принцессы‡Die königliche Rettung‡공주 구출‡El rescate real‡El rescate real‡Un sauvetage royal‡拯救公主‡拯救公主',
    nil,
    'Mate o Imperador Dagran Thaurissan e liberte a Princesa Moira Barbabronze do feitiço maligno.‡Убейте императора Даграна Тауриссана и освободите принцессу Мойру Бронзобород от его черного заклятия.‡Tötet Imperator Dagran Thaurissan und befreit Prinzessin Moira Bronzebeard von seinem bösen Zauber.‡제왕 다그란 타우릿산을 처치하고 그의 사악한 마법에서 공주 모이라 브론즈비어드를 해방시켜야 합니다.‡Mata al emperador Dagran Thaurissan para liberar a la princesa Barbabronce del hechizo.‡Mata al emperador Dagran Thaurissan para liberar a la princesa Moira Barbabronce del hechizo.‡Tuer l\'Empereur Thaurissan et libérer la princesse Moira Bronzebeard de son sort maléfique.‡杀掉达格兰·索瑞森大帝，然后将铁炉堡公主茉艾拉·铜须从他的邪恶诅咒中拯救出来。‡殺掉達格蘭·索瑞森大帝，然後將鐵爐堡公主茉艾拉·銅須從他的邪惡詛咒中拯救出來。',
  }
},
[4004] = {
  {
    'A princesa foi resgatada?‡Спасенная принцесса‡Ist die Prinzessin gerettet?‡구출된 공주?‡¿Princesa salvada?‡¿Princesa salvada?‡La Princesse sauvée ?‡拯救公主？‡拯救公主？',
    nil,
    'Fale novamente com Thrall!‡Вернитесь к Траллу.‡Kehrt zu Thrall zurück!‡스랄에게 돌아가야 합니다!‡¡Vuelve junto a Thrall!‡¡Vuelve con Thrall!‡Retourner voir Thrall !‡向萨尔报告！‡向薩爾報告！',
  }
},
[4005] = {
  {
    'Aquementas‡Аквамонтос‡Aquementas‡아쿠에멘타스‡Aquementas‡Aquamentas‡Aquementas‡亚奎门塔斯‡亞奎門塔斯',
    nil,
    'Leve o Livro de Aquor, as Garras Prateadas e o Coração de Ferrárbol até Tanaris.|nUse o Livro de Aquor para evocar Aquementas.|nApós ter completado o totem, leve-o para J.D. Neri no Refúgio do Marshal.‡Отнесите книгу Аквора, серебристые когти и сердце Железнолесья в Танарис.|nВоспользуйтесь книгой для призыва Аквамонтоса.|nПо получении тотема, отнести его Джей Ди Колли в Укрытие Маршалла.‡Bringt das Buch von Aquor, die silbrigen Klauen und das Eisenstammherz nach Tanaris.|nBenutzt das Buch von Aquor, um Aquementas zu beschwören.|nWenn Ihr das vollständige Totem habt, bringt es zu J.D. Collie in Marshals Zuflucht zurück.‡아쿠오르의 책, 은백색 발톱, 그리고 강철나무 심장을 가지고 타나리스로 가십시오.|n아쿠오르의 책을 사용해 아쿠에멘타스를 소환해야 합니다.|n토템을 완성하면 마샬의 야영지에 있는 J.D. 콜리에게 가져가야 합니다.‡Lleva el Libro de Aquor, las zarpas plateadas y el corazón de Troncoferro a Tanaris.|nUtiliza el Libro de Aquor para invocar Aquementas.|nCuando tengas el tótem completo llévaselo a J.D. Collie en el Refugio de Marshal.‡Lleva el Libro de Aquor, las zarpas plateadas y el corazón de Troncoferro a Tanaris.|nUtiliza el Libro de Aquor para invocar Aquamentas.|nCuando tengas el tótem completo llévaselo a J.D. Collie en el Refugio de Marshal.‡Apporter le Livre d\'Aquor, les Griffes argentées et le Coeur d\'Arbrefer à Tanaris.|nUtiliser le Livre d\'Aquor pour invoquer Aquementas.|nAprès avoir terminé le totem, l’apporter à J.D. Collie au refuge des Marshal.‡把阿奎尔之书、银爪和铁树之心带到塔纳利斯去。|n使用这本书召唤亚奎门塔斯。|n在图腾完成之后，把它交给马绍尔营地的科琳。‡把阿奎爾之書、銀爪和鐵樹之心帶到塔納利斯去。|n使用這本書召喚亞奎門塔斯。|n在圖騰完成之後，把它交給馬紹爾營地的科琳。',
  }
},
[4021] = {
  {
    'Contra-ataque!‡Контратака!‡Gegenangriff!‡반격!‡¡Contraataca!‡¡Contraataca!‡La contre-attaque !‡人马无双！‡人馬無雙！',
    nil,
    'Leve um Pedaço do Estandarte de Krom\'zar para Regthar Portões-da-morte, a oeste da Encruzilhada.‡Принесите кусок знамени Кром\'зара Регтару Вратам Смерти. Его можно найти на западе от Перекрестка.‡Bringt ein Teil von Krom\'zars Flagge zu Regthar Deathgate, westlich von Crossroads.‡크로스로드 서쪽에 있는 렉타르 데스게이트에게 크롬자르의 깃발 조각을 가져가야 합니다.‡Llévale una pieza del estandarte de Krom\'zar a Regthar Portamorta, al oeste de El Cruce.‡Llévale un trozo del estandarte de Krom\'zar a Regthar Portamorta, al oeste de El Cruce.‡Apporter un Morceau de la bannière de Krom\'zar à Regthar Deathgate, à l\'ouest de la Croisée.‡将克罗姆扎军旗的碎片交给十字路口西边的雷戈萨·死门。‡將克羅姆紮軍旗的碎片交給十字路口西邊的雷戈薩·死門。',
  }
},
[4022] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Mostre a Ciro Terepento a Muda de Pele da Revoada Negra que você recebeu de Kalaran Finalâmina.‡Покажите Цирусу Раскаивателю сброшенную кожу черного дракона, полученную от Каларана Ветрореза.‡Zeigt Cyrus Therepentous die abgestreifte Haut des schwarzen Drachenschwarms, die Ihr von Kalaran Windblade erhalten habt.‡칼라란 윈드블레이드에게서 받은 검은용군단 허물을 키루스 테레펜터스에게 보여줘야 합니다.‡Enséñale a Cyrus Therepentio la escama de Vuelo Negro que recibiste de Kalaran Espada del Viento.|n‡Enséñale a Cyrus Therepentio la escama de Vuelo Negro que recibiste de Kalaran Espada del Viento.‡Montrer à Cyrus Therepentous l\'Ecaille des dragons noirs que vous avez reçue de Kalaran Windblade.‡向塞勒斯·萨雷芬图斯展示你从卡拉然·温布雷那里得到的黑龙皮。‡向塞勒斯·薩雷芬圖斯展示妳從卡拉然·溫布雷那裏得到的黑龍皮。',
  }
},
[4023] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Mostre a Ciro Terepento uma prova de seu valor.|nVocê tem a impressão de que Ciro já sabe que você não é <digno/digna>.‡Покажите Цирусу Раскаивателю доказательство своих деяний.|nВозникает чувство, что Цирус заранее сомневается в ваших качествах.‡Zeigt Cyrus Therepentous einen Beweis für Eure Nützlichkeit.|nIhr habt so ein Gefühl, dass Cyrus bereits weiß, dass Ihr unwürdig seid.‡키루스 테레펜터스에게 자신의 가치를 증명해 보여야 합니다.|n키루스가 이미 당신이 가치가 없다는 사실을 알고 있는 것 같은 느낌이 듭니다.‡Demuéstrale a Cyrus Therepentio lo que vales.|nTe da la impresión de que Cyrus ya sabe que no eres digno.‡Demuéstrale a Cyrus Therepentio lo que vales.|nTe da la impresión de que Cyrus ya sabe que no eres digno.‡Montrer à Cyrus Therepentous une preuve de votre valeur.|nVous avez le sentiment que Cyrus sait déjà que vous êtes indigne.‡向塞勒斯·萨雷芬图斯证明你的价值。|n你感觉到塞勒斯似乎对你不屑一顾。‡向塞勒斯·薩雷芬圖斯證明妳的價值。|n妳感覺到塞勒斯似乎對妳不屑壹顧。',
  }
},
[4024] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Vá para o Abismo Rocha Negra e mate Bael\'gar.|nA única coisa que você sabe é que o gigante mora no Abismo Rocha Negra. Lembre-se de usar a Muda de Pele Alterada da Revoada Negra nos restos mortais de Bael\'gar para capturar a Essência Abrasadora.|nLeve a Essência Abrasadora Aprisionada para Ciro Terepento.‡Отправьтесь в глубины Черной горы и убейте Бейл\'Гора.|nИзвестно лишь то, что великан живет в глубинах. Воспользуйтесь измененной сброшенной шкурой черного дракона и возьмите из останков Бейл\'Гора сущность Огня.|nОтнесите пойманную сущность Огня Цирусу Раскаивателю.‡Begebt Euch in die Blackrocktiefen und tötet Bael\'Gar.|nIhr wisst lediglich, dass der Riese irgendwo in den Blackrocktiefen haust. Vergesst nicht, die veränderte Haut des schwarzen Drachenschwarms mit Bael\'Gars Überresten zu benutzen und damit die feurige Essenz einzufangen.|nBringt die eingeschlossene feurige Essenz zu Cyrus Therepentous zurück.‡검은바위 나락으로 가서 밸가르를 처치하십시오.|n이 거인이 검은바위 나락 내에 살고 있다는 것만 알고 있으며 밸가르의 시체에 변형된 검은용군단 허물을 사용해 불의 정수를 추출해야만 합니다.|n키루스 테레펜터스에게 담겨진 불의 정수를 가져가야 합니다.‡Viaja hasta las Profundidades de Roca Negra y mata a Bael\'Gar.|nSolo sabes que el gigante vive en las Profundidades de Roca Negra. Acuérdate de usar la escama alterada de Vuelo Negro sobre los restos de Bael\'Gar para capturar la esencia fiera.|nLlévale la esencia fiera recubierta a Cyrus Therepentio.‡Viaja hasta las Profundidades de Roca Negra y mata a Bael\'Gar.|nSolo sabes que el gigante vive en las Profundidades de Roca Negra. Acuérdate de usar la escama alterada de Vuelo Negro sobre los restos de Bael\'Gar para capturar la esencia ígnea.|nLlévale la esencia ígnea encerrada a Cyrus Therepentio.‡Partir pour les Profondeurs de Blackrock et tuer Bael\'Gar.|nVous savez seulement que le géant demeure à l\'intérieur des Profondeurs de Blackrock. Se souvenir d\'utiliser l\'Ecaille des dragons noirs altérée pour capturer l\'Essence ardente.|nApporter l\'Essence ardente recouverte à Cyrus Therepentous.‡到黑石深渊去杀掉贝尔加。|n你只知道这个巨型怪物住在黑石深渊的最深处。记住你要使用特殊的黑龙皮从贝尔加的尸体上采集烈焰精华。|n将你采集到的烈焰精华交给塞勒斯·萨雷芬图斯。‡到黑石深淵去殺掉貝爾加。|n妳只知道這個巨型怪物住在黑石深淵的最深處。記住妳要使用特殊的黑龍皮從貝爾加的屍體上采集烈焰精華。|n將妳采集到的烈焰精華交給塞勒斯·薩雷芬圖斯。',
  }
},
[4041] = {
  {
    'O elixir Videre‡Эликсир Видере‡Das Videre-Elixier‡앞날의 비약‡El Elixir de Videre‡El Elixir de Videre‡L\'élixir de Videre‡视灵药剂‡視靈藥劑',
    nil,
    nil,
  }
},
[4061] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Vá para as Estepes Ardentes e recupere 10 Estilhaços Elementais Fraturados para a Hierofante Theodora Malvadania.|nVocê se lembra que Theodora mencionou que os golens e elementais dessa região são uma fonte desses estilhaços.‡Отправляйтесь в Пылающие степи и соберите 10 осколков элементалей для верховной жрицы Теодоры Мальвадании.|nТеодора упоминала, что осколки можно найти у элементалей и големов.‡Begebt Euch in die brennende Steppe und beschafft für Theodora Mulvadania 10 gerissene Elementarsplitter.|nEuch fällt ein, dass Theodora gesagt hat, die Golems und Elementare in der Gegend seien eine gute Quelle für solche Splitter.‡불타는 평원으로 가서 제사장 테오도라 뮬바다니아에게 가져갈 부서진 원소 파편 10개를 모아야 합니다.|n그 지역의 골렘과 정령들에게서 이 파편을 구할 수 있을 거라고 테오도라가 말했던 것이 기억납니다.‡Adéntrate en Las Estepas Ardientes y recupera 10 fragmentos de elemental agrietado para Hierofante Theodora Mulvadania.|nRecuerdas que Theodora mencionó que los golems y elementales de esa región eran la fuente de estos fragmentos.‡Adéntrate en Las Estepas Ardientes y recupera 10 fragmentos elementales fracturados para Hierofante Theodora Mulvadania.|nRecuerdas que Theodora mencionó que los gólems y elementales de esa región eran la fuente de estos fragmentos.‡S\'aventurer dans les Steppes ardentes et récupérer 10 Fragments d\'élémentaires cassés pour la Hiérophante Theodora Mulvadania.|nTheodora vous a indiqué que les golems et les élémentaires étaient la source de ces fragments.‡到燃烧平原去为塞朵拉·穆瓦丹尼收集10块断裂的元素碎片。|n塞朵拉曾经说过，那里的机械傀儡和元素生物是这种碎片的主要来源。‡到燃燒平原去為塞朵拉·穆瓦丹尼收集10塊斷裂的元素碎片。|n塞朵拉曾經說過，那裏的機械傀儡和元素生物是這種碎片的主要來源。',
  }
},
[4062] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Leve a Amostra de Estilhaço Elemental para Lotwil Viriato.|nSegundo Theodora, Lotwil estava escalado em um acampamento ao leste.‡Отнесите образец осколка элементаля Лотвилю Вериатусу.|nТеодора упоминала, что его лагерь находится на востоке.‡Bringt die Elementarsplitterprobe zu Lotwil Veriatus.|nIhr erinnert Euch, dass Theodora sagte, Lotwil sei in einem Lager im Osten stationiert.‡로트윌 베리아투스에게 원소 파편 견본을 가져가야 합니다.|n테오도라가 로트윌은 동쪽 야영지에 있다고 얘기했던 것이 기억납니다.‡Lleva el ejemplar de fragmento de Elemental a Lotwil Veriatus.|nRecuerdas que Theodora dijo que Lotwil se encontraba en un campamento hacia el este.‡Lleva el ejemplar de fragmento elemental a Lotwil Veriatus.|nRecuerdas que Theodora dijo que Lotwil se encontraba en un campamento hacia el este.‡Apporter l\'Echantillon de fragment d\'élémentaire à Lotwil Veriatus.|nTheodora vous a dit qu\'il se trouvait au camp à l\'est.‡将元素碎片样本交给鲁特维尔·沃拉图斯。|n塞朵拉说鲁特维尔就在东边的一处营地里。‡將元素碎片樣本交給魯特維爾·沃拉圖斯。|n塞朵拉說魯特維爾就在東邊的壹處營地裏。',
  }
},
[4063] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Encontre e mate Lorde Golem Argelmach. Leve a cabeça dele para Lotwil. Você também precisará coletar 10 Núcleos de Elemental Intactos dos Golens Rasgafúria e Constructos Armipotentes que protegem Argelmach. Você sabe disso porque é paranormal.‡Найдите и убейте повелителя големов Аргелмаха. Принесите его голову Лотвилу. Также соберите 10 невредимых ядер стихий с беспощадных големов и созданий-завоевателей, охраняющих Аргелмаха. Информация передана посредством телепатии.‡Sucht und tötet Golemlord Argelmach. Bringt Lotwil seinen Kopf. Außerdem müsst Ihr 10 intakte Elementarkerne von den Wuthäschergolems und Kriegshetzerkonstrukten, die Argelmach beschützen, beschaffen. Das wisst Ihr, weil Ihr übernatürliche Fähigkeiten habt.‡골렘 군주 아젤마크를 찾아 처치하고 그 증거로 그의 머리카락을 로트윌에게 가져가야 합니다. 그리고 아젤마크를 호위하는 재앙의 피조물과 맹위의 전투골렘들에게서 온전한 원소핵 10개도 모아야 합니다.‡Encuentra al Señor Gólem Argelmach y mátalo. Llévale su cabeza a Lotwil. Asimismo tendrás que reunir 10 núcleos de elemental intactos de los gólems Furiatracadores y de los ensamblajes belisario que protegen a Argelmach. Lo sabes porque eres <un adivino/una adivina>.‡Encuentra al Señor Gólem Argelmach y mátalo. Llévale su cabeza a Lotwil. Asimismo tendrás que reunir 10 núcleos de elemental intactos de los gólems Furiatracadores y de los ensamblajes belisario que protegen a Argelmach. Lo sabes porque eres <un adivino/una adivina>.‡Trouver et tuer le seigneur des golems Argelmach. Rapporter sa tête à Lotwil. Collecter également 10 Noyaux d\'élémentaire intacts sur les Golems ravarage et les Assemblages porteguerre qui protègent Argelmach. Vous savez cela car vous êtes médium.‡找到并杀掉傀儡统帅阿格曼奇，将他的头交给鲁特维尔。你还需要从守卫着阿格曼奇的狂怒傀儡和战斗傀儡身上收集10块完整的元素核心。‡找到並殺掉傀儡統帥阿格曼奇，將他的頭交給魯特維爾。妳還需要從守衛著阿格曼奇的狂怒傀儡和戰鬥傀儡身上收集10塊完整的元素核心。',
  }
},
[4081] = {
  {
    'SE VIR, MATE: Anões Ferro Negro‡УНИЧТОЖИТЬ НА МЕСТЕ: Дворфы Черного Железа‡SOFORT TÖTEN: Dunkeleisenzwerge‡죽음의 본보기: 검은무쇠단 드워프‡MATAR INMEDIATAMENTE: enanos Hierro Negro‡MATAR INMEDIATAMENTE: enanos Hierro Negro‡TUER A VUE : nains Sombrefer‡格杀勿论：黑铁矮人‡格殺勿論：黑鐵矮人',
    nil,
    'Desbrave o Abismo Rocha Negra e destrua aqueles invasores degenerados!|nO Senhor da Guerra Trincador quer que você mate 15 Guardas Furiadastra, 10 Carcereiros Furiadastra e 5 Soldados Rasos Furiadastra. Fale novamente com ele quando o trabalho estiver terminado.‡Отправляйтесь в Глубины Черной горы и уничтожьте подлых агрессоров!|nПо приказу полководца Клинозуба уничтожьте 15 охранников, 10 надсмотрщиков и 5 пехотинцев из клана Ярости Горна. Вернитесь сразу по выполнении задания.‡Begebt Euch in die Blackrocktiefen und vernichtet die üblen Aggressoren!|nKriegsherr Goretooth möchte, dass Ihr 15 Gardisten der Zorneshämmer, 10 Aufseher der Zorneshämmer und 5 Fußsoldaten der Zorneshämmer tötet. Kehrt zu ihm zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 나락으로 가서 사악한 침략자들을 쳐부수십시오!|n장군 고어투스가 성난모루단 보초 15명, 성난모루단 교도관 10명, 성난모루단 보병 5명을 처치해 달라고 부탁했습니다. 임무를 완수하면 장군 고어투스에게 돌아가십시오.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|nEl señor de la guerra Dientegore quiere que mates a 15 custodios de Yunque Colérico, 10 alcaides de Yunque Colérico y 5 lacayos de Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|nEl señor de la guerra Dientegore quiere que mates a 15 celadores Yunque Colérico, 10 alcaides Yunque Colérico y 5 lacayos Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Pénétrer dans les Profondeurs de Blackrock et tuer les vils agresseurs !|nLe chef de guerre Goretooth veut que vous tuiez 15 Gardes Ragenclumes, 10 Gardiens Ragenclumes et 5 Fantassins Ragenclumes. Retourner le voir une fois votre mission accomplie.‡到黑石深渊去消灭那些邪恶的侵略者！|n军官高图斯要你去杀死15个铁怒卫士、10个铁怒狱卒和5个铁怒步兵。完成任务之后回去向他复命。‡到黑石深淵去消滅那些邪惡的侵略者！|n軍官高圖斯要妳去殺死15個鐵怒衛士、10個鐵怒獄卒和5個鐵怒步兵。完成任務之後回去向他復命。',
  }
},
[4082] = {
  {
    'SE VIR, MATE: Oficiais Ferro Negro de Alta Patente‡УНИЧТОЖИТЬ НА МЕСТЕ: Высокопоставленные чины Черного Железа‡SOFORT TÖTEN: Hochrangige Führungskräfte der Dunkeleisenzwerge‡죽음의 본보기: 검은무쇠단 고위 관리‡MATAR INMEDIATAMENTE: oficiales Hierro Negro de alto rango‡MATAR INMEDIATAMENTE: oficiales Hierro Negro de alto rango‡TUER A VUE : Officiers de haut rang Sombrefer‡格杀勿论：高阶黑铁军官‡格殺勿論：高階黑鐵軍官',
    nil,
    'Vá até o Abismo Rocha Negra e destrua aqueles invasores degenerados!|nO Senhor da Guerra Trincador quer que você mate 10 Socorristas Furiadastra, 10 Soldados Furiadastra e 10 Oficiais Furiadastra. Fale novamente com ele quando o trabalho for concluído.‡Отправляйтесь в Глубины Черной горы и уничтожьте подлых агрессоров!|nПо приказу полководца Клинозуба уничтожьте 10 медиков, 10 солдат и 10 офицеров из клана Ярости Горна. Вернитесь сразу по выполнении задания.‡Begebt Euch in die Blackrocktiefen und vernichtet die üblen Aggressoren!|nKriegsherr Goretooth möchte, dass Ihr 10 Sanitäter der Zorneshämmer, 10 Soldaten der Zorneshämmer und 10 Offiziere der Zorneshämmer tötet. Kehrt zu ihm zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 나락으로 가서 사악한 침략자들을 쳐부수십시오!|n장군 고어투스가 성난모루단 간호병 10명, 성난모루단 병사 10명, 그리고 성난모루단 장교 10명을 처치해 달라고 부탁했습니다. 임무를 완수하면 고어투스에게 돌아가십시오.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|nEl señor de la guerra Dientegore quiere que mates a 10 médicos de Yunque Colérico, 10 soldados de Yunque Colérico y 10 oficiales de Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|nEl señor de la guerra Dientegore quiere que mates a 10 médicos Yunque Colérico, 10 soldados Yunque Colérico y 10 oficiales Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Pénétrer dans les Profondeurs de Blackrock et tuer les vils agresseurs !|nLe Chef de guerre Goretooth veut que vous tuiez 10 Médecins Ragenclumes, 10 Soldats Ragenclumes et 10 Officiers Ragenclumes. Retourner le voir une fois votre mission accomplie.‡到黑石深渊去消灭那些邪恶的侵略者！|n高图斯军阀要你杀死10个铁怒医师,、10个铁怒士兵和10个铁怒军官。完成任务之后回去向他复命。‡到黑石深淵去消滅那些邪惡的侵略者！|n高圖斯軍閥要妳殺死10個鐵怒醫師,、10個鐵怒士兵和10個鐵怒軍官。完成任務之後回去向他復命。',
  }
},
[4083] = {
  {
    'Cálice Espectral‡Призрачный кубок‡Der spektrale Kelch‡유령의 성배‡El cáliz espectral‡El cáliz espectral‡Le Calice spectral‡鬼魂之杯‡鬼魂之杯',
    nil,
    nil,
  }
},
[4084] = {
  {
    'Coração de prata‡Серебряное сердце‡Silberherz‡은색 심장‡Corazón de plata‡Corazón de plata‡Coeur d\'argent‡银爪铁心‡銀爪鐵心',
    nil,
    'Colete 11 Garras Prateadas e 1 Coração de Ferrárbol para Eridan Brisazul na Selva Maleva.‡Добудьте 11 серебристых когтей и 1 сердце Железнолесья для Эриданы Грусти Ветра.‡Beschafft 11 silbrige Klauen und 1 Eisenstammherz für Eridan Bluewind im Teufelswald.‡악령의 숲에 있는 에리단 블루윈드에게 은백색 발톱 11개와 강철나무 심장 1개를 가져가야 합니다.‡Recoge 11 zarpas plateadas y 1 corazón de Troncoferro para Eridan Vientoazul de Frondavil.‡Recoge 11 zarpas plateadas y 1 corazón de Troncoferro para Eridan Vientoazul de Frondavil.‡Trouver 11 Griffes d\'argent et 1 Cœur d\'Arbrefer pour Eridan Bluewind à Gangrebois.‡为费伍德森林的艾瑞丹·蓝风收集11只银爪和1颗铁树之心。‡為費伍德森林的艾瑞丹·藍風收集11只銀爪和1顆鐵樹之心。',
  }
},
[4101] = {
  {
    'Purificar Selva Maleva‡Очищение Оскверненного леса‡Den Teufelswald säubern‡악령의 숲 정화‡Limpiar Frondavil‡Purificación de Frondavil‡Purifie Gangrebois‡净化费伍德‡凈化費伍德',
    nil,
    'Leve 15 Âmbares de Sangue para Arathandris Argencélio na Selva Maleva.‡Принесите 15 кровавых янтарей Аратандис Серебряному Небу в Оскверненный лес.‡Bringt 15 Einheiten Blutharz zu Arathandris Silversky im Teufelswald.‡악령의 숲에 있는 아라탄드리스 실버스카이에게 핏빛 호박석 15개를 가져가야 합니다.‡Lleva 15 unidades de sangre ámbar a Arathandris Cielargente a Frondavil.‡Lleva 15 unidades de ámbar de sangre a Arathandris Cielargento a Frondavil.‡Apporter 15 Ambres de sang à Arathandris Silversky à Gangrebois.‡收集15颗血琥珀，把它们交给费伍德森林的阿拉珊蒂丝·银空。‡收集15顆血琥珀，把它們交給費伍德森林的阿拉珊蒂絲·銀空。',
  }
},
[4102] = {
  {
    'Purificar Selva Maleva‡Очищение Оскверненного леса‡Den Teufelswald säubern‡악령의 숲 정화‡Limpiar Frondavil‡Purificación de Frondavil‡Purifie Gangrebois‡净化费伍德‡凈化費伍德',
    nil,
    'Leve 15 Âmbares de Sangue para Maibess Brisa do Rio em Selva Maleva.‡Принесите 15 кровавых янтарей Майбессе Речному Ветру в Оскверненный лес.‡Bringt 15 Einheiten Blutharz zu Maybess Riverbreeze im Teufelswald.‡악령의 숲에 있는 메이베스 리버브리즈에게 핏빛 호박석 15개를 가져가야 합니다.‡Lleva 15 unidades de sangre ámbar a Maybess Brisafluvial a Frondavil.‡Lleva 15 unidades de ámbar de sangre a Maybess Brisa de Río a Frondavil.‡Apporter 15 Ambres de sang à Maybess Riverbreeze à Gangrebois.‡收集15颗血琥珀，把它们交给费伍德森林的梅贝丝·河风。‡收集15顆血琥珀，把它們交給費伍德森林的梅貝絲·河風。',
  }
},
[4103] = {
  {
    'Bálsamo via caça‡Лекарство из охотничьих трофеев‡Salbe durch Jagd‡사냥을 통한 고약 확보‡Bálsamo por caza‡Bálsamo por caza‡Du baume en chassant‡狩猎换药膏‡狩獵換藥膏',
    nil,
    nil,
  }
},
[4104] = {
