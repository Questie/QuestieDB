[1848] = {
  {
    'Cota brutal‡Хауберк Жестокости‡Brutale Halsberge‡투사 갑옷‡Camisote brutal‡Camisote brutal‡Le haubert de brutalité‡野蛮锁甲‡野蠻鎖甲',
