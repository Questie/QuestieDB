[209765] = {
  '‡Музыка и фейерверки – и ночь полна огня!‡Musik & Feuerwerk erhellen die Nacht!‡음악과 불꽃놀이로 이밤을 불태우십시오!‡¡Música y fuegos artificiales para iluminar la noche!‡¡Música y fuegos artificiales para iluminar la noche!‡Sons et lumières pour illuminer votre nuit !‡让音乐与焰火点亮夜空！‡音樂、煙火照亮整個夜晚!'
},
[209766] = {
  '‡Не останавливайтесь! Не мешкайте! Вы почти на месте!‡Haltet nicht ein! Ihr seid fast am Ziel!‡멈추지 마십시오! 거의 다 오셨습니다!‡¡No te detengas! ¡Ya casi has llegado!‡¡No te detengas! ¡Ya casi has llegado!‡Ne vous arrêtez pas ! Vous y êtes presque !‡别停下！就要到了！‡別停下來!你快到了!'
},
[209767] = {
  '‡Пред вашими глазами – ЯРМАРКА НОВОЛУНИЯ!‡Seht her, Freunde: DER DUNKELMOND-JAHRMARKT!‡다크문 축제에 오신 것을 환영합니다!‡Observad todos: ¡LA FERIA DE LA LUNA NEGRA!‡Observen todos: ¡LA FERIA DE LA LUNA NEGRA!‡Contemplez, l\'ami : LA FOIRE DE SOMBRELUNE !‡看呐，我的朋友：暗月马戏团！‡看吶，我的朋友，暗月馬戲團到了!'
},
[209768] = {
