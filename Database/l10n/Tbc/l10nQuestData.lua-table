[8680] = {
  {
    'Totem do Vento, a Anciã‡Харкен Тотем Ветра‡Urahnin Windtotem‡장로 윈드토템‡Vientótem el Ancestro‡Tótem de Viento el Ancestro‡L\'Ancienne Windtotem‡风之图腾长者‡風之圖騰長者',
