[12420] = {
  {
    '‡‡‡‡‡‡‡‡每月啤酒俱樂部',
    nil,
    '‡‡‡‡‡‡‡‡把「每月啤酒」俱樂部會員表格帶給拉金·雷酒，他就在鐵爐堡的石火旅店中。',
  }
},
[12491] = {
  {
    'A Cerva Atroz do Cervatroz‡Худое варево Худовара‡Düsterbräus Düsterbräu‡다이어브루의 독한 맥주‡La cerveza temible de Cerveza Temible‡La cerveza temible de Cerveza Temible‡La navre-bière de Navrebière‡科林的烈酒‡恐酒的恐酒',
    nil,
    'Entregue a Cerva Atroz do Cervatroz para Ipfelkofer Barrildechope na CervaFest, perto de Altaforja.‡Отнесите худое варево Худовара Ипфелькоферу Железному Бочонку в лагерь Хмельного фестиваля возле Стальгорна.‡Bringt Düsterbräus Düsterbräu zu Ipfelkofer Eisenfass im Braufestlager in der Nähe von Eisenschmiede.‡다이어브루의 독한 맥주를 아이언포지 근처의 가을 축제 광장에 있는 이펠코퍼 아이언케그에게 전달해야 합니다.‡Dale la cerveza temible de Cerveza Temible a Ipfelkofer Barril de Hierro en el campamento de la Fiesta de la cerveza cerca de Forjaz.‡Dale la cerveza temible de Cerveza Temible a Ipfelkofer Barril de Hierro en el campamento de la Fiesta de la Cerveza cerca de Forjaz.‡Donnez la Navre-bière de Navrebière à Ipfelkofer Baril-de-fer au camp de la fête des Brasseurs près de Forgefer.‡将科林的烈酒交给铁炉堡附近美酒节营地的埃菲库格·铁桶。‡將恐酒的恐酒帶到鐵爐堡附近的啤酒節營地交給易菲克佛·鐵桶。',
  }
},
[12492] = {
  {
    'A Cerva Atroz do Cervatroz‡Худое варево Худовара‡Düsterbräus Düsterbräu‡다이어브루의 독한 맥주‡La cerveza temible de Cerveza Temible‡La cerveza temible de Cerveza Temible‡La navre-bière de Navrebière‡科林的烈酒‡恐酒的恐酒',
    nil,
    'Entregue a Cerva Atroz do Cervatroz para Torneiro Barrilantra na CervaFest, perto de Orgrimmar.‡Отнесите худое варево Худовара Слухарю Жмухли в лагерь Хмельного фестиваля возле Оргриммара.‡Bringt Düsterbräus Düsterbräu zu Zapfus Schwindelfass im Braufestlager in der Nähe von Orgrimmar.‡다이어브루의 독한 맥주를 오그리마 근처의 가을 축제 광장에 있는 급사 스윈들케그에게 전달해야 합니다.‡Dale la cerveza temible de Cerveza Temible al espitador Barritimo en el campamento de la Fiesta de la cerveza cerca de Orgrimmar.‡Dale la cerveza temible de Cerveza Temible al espitador Barritimo en el campamento de la Fiesta de la Cerveza cerca de Orgrimmar.‡Donnez la navre-bière de Navrebière à Perce Fauchebaril au camp de la fête des Brasseurs près d\'Orgrimmar.‡将科林的烈酒交给奥格瑞玛附近美酒节营地的塔波尔·斯威雷格。‡將恐酒的恐酒帶到奧格瑪附近的啤酒節營地交給泰伯·詐桶。',
  }
},
[12513] = {
  {
    'Belo chapéu...‡Милая шляпка...‡Netter Hut...‡멋진 모자군요...‡Bonito sombrero...‡Bonito sombrero...‡Un joli chapeau...‡好帽子......‡漂亮的帽子……',
    nil,
    'Dom Ramón desafiou você dizendo que você não é capaz de derrotá-lo no passado, na Antiga Eira dos Montes. Depois disso, traga o Chapéu do Dom Ramón para ele mesmo, como prova, em Tanaris.‡Сам того не желая, Дон Карлос сподвиг вас сразиться с ним молодым в Старом Хилсбраде. Принесите ему шляпу Дона Карлоса в доказательство вашей победы. Он будет ждать вас в Танарисе.‡Don Carlos hat Euch versehentlich dazu herausgefordert, sein jüngeres Ich im Alten Hügelland zu besiegen. Bringt ihm anschließend seinen Hut als Beweis. Er befindet sich in Tanaris.‡돈 카를로스가 무심결에 옛 언덕마루에 있는 젊은 돈 카를로스를 이겨보라고 제안했습니다. 싸움에 이긴 증거로 돈 카를로스의 모자를 타나리스에 있는 그에게 가져가야 합니다.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Donc Carlos vous a malencontreusement défié de vaincre son jeune alter ego de la Hautebrande d\'antan. Lorsque ce sera fait, apportez le Chapeau de don Carlos à Don Carlos, à Tanaris, comme preuve de votre victoire.‡卡洛斯要你进入旧希尔斯布莱德，击败年轻时候的卡洛斯。然后将他的帽子交给塔纳利斯的卡洛斯。‡唐卡洛斯不小心對你發出挑戰，去希爾斯布萊德丘陵舊址擊敗年輕時的他。完成後，將唐卡洛斯之帽帶回塔納利斯交給他做為證明。',
  }
},
[12515] = {
  {
    'Belo chapéu...‡Милая шляпка...‡Netter Hut...‡멋진 모자군요...‡Bonito sombrero...‡Bonito sombrero...‡Un joli chapeau...‡好帽子......‡漂亮的帽子……',
    nil,
    'Dom Ramón desafiou você dizendo que você não é capaz de derrotá-lo no passado, na Antiga Eira dos Montes. Depois disso, traga o Chapéu do Dom Ramón para ele mesmo, como prova, em Tanaris.‡Сам того не желая, Дон Карлос сподвиг вас сразиться с ним молодым в Старом Хилсбраде. Принесите ему шляпу Дона Карлоса в доказательство вашей победы. Он будет ждать вас в Танарисе.‡Don Carlos hat Euch versehentlich dazu herausgefordert, sein jüngeres Ich im Alten Hügelland zu besiegen. Bringt ihm anschließend seinen Hut als Beweis. Er befindet sich in Tanaris.‡돈 카를로스가 무심결에 옛 힐스브래드에 있는 젊은 돈 카를로스를 이겨보라고 제안했습니다. 싸움에 이긴 증거로 돈 칼로스의 모자를 타나리스에 있는 그에게 가져가야 합니다.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Donc Carlos vous a malencontreusement défié de vaincre son jeune alter ego de la Hautebrande d\'antan. Lorsque ce sera fait, apportez le Chapeau de don Carlos à Don Carlos, à Tanaris, comme preuve de votre victoire.‡卡洛斯要你进入旧希尔斯布莱德，击败年轻时候的卡洛斯。然后将他的帽子交给塔纳利斯的卡洛斯。‡唐卡洛斯不小心對你發出挑戰，去希爾斯布萊德丘陵舊址擊敗年輕時的他。完成後，將唐卡洛斯之帽帶回塔納利斯交給他做為證明。',
  }
},
[63866] = {
  {
    'Poder sobre a Luz‡Получение силы Света‡Die Beherrschung des Lichts‡빛을 추구하다‡Buscando la Luz‡‡‡驾驭圣光‡',
    nil,
    'Use o Recipiente Cintilante em M\'uru para enchê-lo e fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Примените мерцающий сосуд к М\'ууру, чтобы наполнить его магической силой, и возвращайтесь к предводителю рыцарей по имени Доблестная Кровь в Луносвет.‡Füllt das schimmernde Gefäß bei M\'uru und kehrt anschließend zu Ritterfürst Heldenblut in Silbermond zurück.‡희미하게 빛나는 용기 안에 므우루의 힘을 가득 채운 다음 실버문의 기사군주 블러드밸러와 다시 대화해야 합니다.‡Llena la vasija refulgente en M\'uru y llévasela al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡‡‡对穆鲁使用微光容器以装满它，然后向银月城的骑士领主布拉德瓦罗复命。‡',
  }
},
[63978] = {
  {
    '‡‡‡‡‡‡‡‡Cloak and Daggers',
    nil,
    '‡‡‡‡‡‡‡‡Use Stealth to sneak around.',
  }
},
[64028] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de <class> em Ventobravo.‡Встретьтесь с наставником |3-8(<класс>) в Штормграде.‡Besucht einen Trainer in Sturmwind, der Euch als <Klasse> ausbilden kann.‡스톰윈드에서 <class> 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase <clase> en Ventormenta.‡‡Trouvez un Maître pour <classe> à Hurlevent.‡在暴风城与一名<class>训练师会面。‡在暴風城內找到<class>訓練師。',
  }
},
[64031] = {
  {
    'Ferramentas de sobrevivência‡Инструменты для выживания‡Das Zeug zum Überleben‡생존을 위한 도구‡Herramientas de supervivencia‡‡Les outils de la survie‡生存工具‡生存工具',
    nil,
    'Abra o kit de sobrevivência e equipe uma arma.‡Откройте набор для выживания и вооружитесь.‡Öffnet das Überlebenspaket und legt eine Waffe an.‡구호 물자를 열어 무기를 장착해야 합니다.‡Abre el material de supervivencia y equípate con un arma.‡‡Ouvrez le Kit de survie et équipez-vous d’une Arme.‡打开生存包，装备一把武器。‡打開求生包，裝備其中的武器。',
  }
},
[64034] = {
  {
    'Treino de combate‡Боевые учения‡Kampftraining‡전투 훈련‡Entrenamiento de combate‡‡Entraînement au combat‡战斗训练‡戰鬥訓練',
    nil,
    'Treine um feitiço falando com um treinador de <class>.‡Поговорите с наставником |3-8(<класс>) и изучите заклинание.‡Erlernt eine Fähigkeit, indem Ihr mit einem Trainer sprecht, der Euch als <Klasse> ausbilden kann.‡<class> 상급자와 대화하여 주문을 훈련해야 합니다.‡Practica un hechizo hablando con un instructor de la clase <clase>.‡‡Parlez à un Maître pour <classe> pour vous entraîner à lancer un Sort.‡和一名<class>训练师谈一谈，接受一个法术的训练。‡與<class>訓練師交談學習法術。',
  }
},
[64035] = {
  {
    'Talento é para quem tem‡Талантливый герой‡Talentiert‡특성‡Tienes talento‡‡Quel talent !‡天赋异禀‡天賦異稟',
    nil,
    'Ative a interface de Talentos e atribua 5 Pontos de Talento.‡Откройте интерфейс талантов и вложите 5 очков талантов.‡Öffnet das Talentfenster und verteilt 5 Talentpunkte.‡특성 창을 열고 특성 포인트 5점을 분배해야 합니다.‡Activa la interfaz de talentos y asigna 5 puntos de talento.‡‡Activez l’interface des Talents et dépensez 5 Points de talent.‡打开天赋界面并分配五个天赋点数。‡打開天賦介面，使用天賦點數。',
  }
},
[64037] = {
  {
    'Terras Pestilentas Orientais‡Восточные Чумные земли‡Östliche Pestländer‡동부 역병지대‡Las Tierras de la Peste del Este‡‡Maleterres de l’est‡东瘟疫之地‡東瘟疫之地',
    nil,
    'Vá até as Terras Pestilentas Orientais e fale com Leonid Bartolomeu. Ele aguarda sua chegada na Capela Esperança da Luz.‡Отправляйтесь в Восточные Чумные земли и поговорите с лордом Барталомеем. Он ждет вас в часовне Последней Надежды.‡Reist in die Östlichen Pestländer und macht Leonidas Bartholomäus ausfindig. Er wartet in der Kapelle des Hoffnungsvollen Lichts.‡동부 역병지대로 이동한 뒤 희망의 빛 예배당에서 당신의 도착을 기다리고 있는 리어니드 바돌로매를 찾아야 합니다.‡Viaja a las Tierras de la Peste del Este y busca a Leonid Barthalomew. Te está esperando en la Capilla de la Esperanza de la Luz.‡‡Rendez-vous dans les Maleterres de l’Est et trouvez Leonid Barthalomew. Il vous attend à la Chapelle de l’Espoir de Lumière.‡前往东瘟疫之地，找到莱尼德·巴萨罗梅。他在圣光之愿礼拜堂等你。‡前往東瘟疫之地找到萊尼德·巴薩羅梅。他在聖光之願禮拜堂等候你的到來。',
  }
},
[64038] = {
  {
    'Portal Negro‡Темный портал‡Das Dunkle Portal‡어둠의 문‡El Portal Oscuro‡‡La Porte des ténèbres‡黑暗之门‡黑暗之門',
    nil,
    'Encontre o Comandante da Guarda Relthorn Declinéter na Barreira do Inferno. Ele aguarda você junto ao Portal Negro.‡Поговорите с командиром стражи Релторном Пустомаром в Выжженных землях. Он ждет вас у Темного портала.‡Macht Wachkommandant Reldorn Netherschwund in den Verwüsteten Landen ausfindig. Er erwartet Eure Ankunft vor dem Dunklen Portal.‡저주받은 땅으로 이동한 뒤 어둠의 문 앞에서 당신의 도착을 기다리고 있는 경비대 사령관 렐손 네더웨인을 찾아야 합니다.‡Busca al comandante de vigilancia Relthorn Menguabisal en Las Tierras Devastadas. Espera tu llegada frente al Portal Oscuro.‡‡Trouvez le Commandant de la garde Vroncier Déclin-du-Néant dans les Terres Foudroyées. Il attend votre arrivée devant la Porte des ténèbres.‡找到诅咒之地的守望堡指挥官雷索恩·奈瑟维。他就在黑暗之门前等你。‡到詛咒之地向警備隊長勒松·尼德溫報到。他在黑暗之門前等你。',
  }
},
[64046] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de <class> em Orgrimmar.‡Встретьтесь с наставником |3-8(<класс>) в Оргриммаре.‡Besucht einen Trainer in Orgrimmar, der Euch als <Klasse> ausbilden kann.‡오그리마에서 <class> 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase <clase> en Orgrimmar.‡‡Allez voir un Maître pour <classe> à Orgrimmar.‡在奥格瑞玛与一名<class>训练师会面。‡在奧格瑪內找到<class>訓練師。',
  }
},
[64047] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Fale com um treinador de <class> no Penhasco do Trovão.‡Встретьтесь с наставником |3-8(<класс>) в Громовом Утесе.‡Besucht einen Trainer in Donnerfels, der Euch als <Klasse> ausbilden kann.‡썬더 블러프에서 <class> 상급자를 만나야 합니다.‡Reúnete con un instructor de la clase <clase> en Cima del Trueno.‡‡Allez voir un Maître pour <classe> aux Pitons-du-Tonnerre.‡在雷霆崖与一名<class>训练师会面。‡在雷霆崖內找到<class>訓練師。',
  }
},
[64048] = {
  {
    'Ferramentas de sobrevivência‡Инструменты для выживания‡Das Zeug zum Überleben‡생존을 위한 도구‡Herramientas de supervivencia‡‡Les outils de la survie‡生存工具‡生存工具',
    nil,
    'Abra o kit de sobrevivência e equipe uma arma.‡Откройте набор для выживания и вооружитесь.‡Öffnet das Überlebenspaket und legt eine Waffe an.‡구호 물자를 열어 무기를 장착해야 합니다.‡Abre el material de supervivencia y equípate con un arma.‡‡Ouvrez le Kit de survie et équipez-vous d’une Arme.‡打开生存包，装备一把武器。‡打開求生包，裝備其中的武器。',
  }
},
[64049] = {
  {
    'Ferramentas de sobrevivência‡Инструменты для выживания‡Das Zeug zum Überleben‡생존을 위한 도구‡Herramientas de supervivencia‡‡Les outils de la survie‡生存工具‡生存工具',
    nil,
    'Abra o kit de sobrevivência e equipe uma arma.‡Откройте набор для выживания и вооружитесь.‡Öffnet das Überlebenspaket und legt eine Waffe an.‡구호 물자를 열어 무기를 장착해야 합니다.‡Abre el material de supervivencia y equípate con un arma.‡‡Ouvrez le Kit de survie et équipez-vous d’une Arme.‡打开生存包，装备一把武器。‡打開求生包，裝備其中的武器。',
  }
},
