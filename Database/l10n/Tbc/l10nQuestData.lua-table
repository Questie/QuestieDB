[8938] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡정당한 보상‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡公平的補償',
    nil,
    'Leve um Cinto do Espreitador de Feras e um par de Luvas do Espreitador de Feras para Mokvar em Orgrimmar.‡Принесите Моквару в Оргриммар пояс Загонщика и перчатки Загонщика.‡Bringt Mokvar in Orgrimmar einen Bestienjägergürtel und ein Paar Bestienjägerhandschuhe.‡오그리마에 있는 모크바르에게 야수추적자 허리띠와 야수추적자 장갑을 가져가야 합니다.‡Lleva 1 cinturón y 1 par de guantes de acechabestias a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes de acechabestias a Mokvar a Orgrimmar.‡Apportez une Ceinture de bestiaire et une paire de Gants de bestiaire à Mokvar à Orgrimmar.‡将一条野兽追猎者腰带和一副野兽追猎者手套交给奥格瑞玛的莫克瓦尔。‡將馭獸者腰帶和1套馭獸者手套帶給奧格瑪的莫克瓦。',
  }
},
[8939] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡정당한 보상‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡',
    nil,
    'Leve um Cinto do Magíster e um par de Luvas do Magíster para Mokvar em Orgrimmar.‡Принесите Моквару в Оргриммар пояс Магистра и перчатки Магистра.‡Bringt Mokvar in Orgrimmar einen Gürtel des Magisters und ein Paar Handschuhe des Magisters.‡오그리마에 있는 모크바르에게 원소술사 허리띠와 원소술사 장갑을 가져가야 합니다.‡Lleva 1 cinturón y 1 par de guantes magistrales a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes de magister a Mokvar a Orgrimmar.‡Apportez une Ceinture de magistère et une paire de Gants de magistère à Mokvar à Orgrimmar.‡将一条博学者腰带和一副博学者手套交给奥格瑞玛的莫克瓦尔。‡',
