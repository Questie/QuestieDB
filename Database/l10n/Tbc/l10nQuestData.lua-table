[8943] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡정당한 보상‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡',
    nil,
    'Leve um Cinto de Brumedo e um par de Guarda-braços de Brumedo para Mokvar, em Orgrimmar.‡Принесите Моквару в Оргриммар пояс Багрового Тумана и повязки Багрового Тумана.‡Bringt Mokvar in Orgrimmar einen Gürtel der Furcht und ein Paar Wickeltücher der Furcht.‡오그리마에 있는 모크바르에게 공포의안개 허리띠와 공포의안개 장갑을 가져가야 합니다.‡Lleva 1 cinturón y 1 par de brazaletes Calígine a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes calígine a Mokvar a Orgrimmar.‡Apportez une Ceinture de Brume-funeste et des Gants de Brume-funeste à Mokvar à Orgrimmar.‡将一条鬼雾腰带和一副鬼雾手套交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8944] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡정당한 보상‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡',
    nil,
    'Leve um Cinto do Valor e um par de Manoplas do Valor para Mokvar, em Orgrimmar.‡Принесите Моквару в Оргриммар пояс Доблести и рукавицы Доблести.‡Bringt Mokvar in Orgrimmar einen Gürtel der Ehre und ein Paar Stulpen der Ehre.‡오그리마에 있는 모크바르에게 용맹의 허리띠와 용맹의 건틀릿을 가져가야 합니다.‡Lleva 1 cinturón y 1 par de guanteletes del valor a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guanteletes de valor a Mokvar a Orgrimmar.‡Apportez une Ceinture de vaillance et une paire de Gantelets de vaillance à Mokvar à Orgrimmar.‡将一条勇气腰带和一副勇气护手交给奥格瑞玛的莫克瓦尔。‡',
  }
},
[8945] = {
  {
    'Súplica de um morto‡Просьба мертвеца‡Die letzte Bitte eines toten Mannes‡죽은 자의 부탁‡La súplica de un muerto‡La súplica de un muerto‡La supplique du mort‡死人的请求‡逝者的請求',
    nil,
    'Entre em Stratholme e resgate Ysida Harmon do Barão Rivendare.‡Отправляйтесь в Стратхольм и спасите Исиду Хармон от барона Ривендера.‡Geht nach Stratholme und befreit Ysida Harmon aus den Fängen von Baron Totenschwur.‡스트라솔름으로 가서 남작 리븐데어로부터 이시다 하몬을 구해야 합니다.‡Ve a Stratholme y rescata a Ysida Harmon del Barón Osahendido.‡Ve a Stratholme y rescata a Ysida Harmon del Barón Osahendido.‡Entrez à Stratholme et sauvez Ysida Harmon du baron Vaillefendre.‡进入斯坦索姆，从瑞文戴尔男爵手中救出伊思达。‡前往斯坦索姆從瑞文戴爾男爵那裡救出亞希達·哈莫。',
  }
},
[8946] = {
  {
    'Prova de vida‡Доказательство жизни‡Lebensbeweis‡생존의 증거‡Prueba de vida‡Prueba de vida‡Une preuve de vie‡生命的证据‡生命的證據',
    nil,
    'Leve o Medalhão de Ysida para Anthion Harmon nas Terras Pestilentas Orientais.‡Отнесите медальон Исиды Антиону Хармону в Восточные Чумные земли.‡Bringt Anthion Harmon in den östlichen Pestländern Ysidas Medaillon.‡동부 역병지대에 있는 안시온 하몬에게 이시다의 펜던트를 가져가야 합니다.‡Lleva el Guardapelo de Ysida a Anthion Harmon a las Tierras de la Peste del Este.‡Lleva el Guardapelo de Ysida a Anthion Harmon a las Tierras de la Peste del Este.‡Remettre le Médaillon d’Ysida à Anthion Harmon, dans les Maleterres de l’est.‡将伊思达的盒子交给东瘟疫之地的安泰恩·哈尔蒙。‡將亞希達的小墜子帶給東溫疫之地的安希恩·哈莫。',
  }
},
[8947] = {
  {
    'O estranho pedido de Anthion‡Странная просьба Антиона‡Anthions merkwürdige Anforderung‡안시온의 이상한 부탁‡La extraña petición de Anthion‡La extraña petición de Anthion‡L\'étonnante requête d\'Anthion‡安泰恩的奇怪请求‡安希恩奇怪的要求',
    nil,
    'Leve 3 Barras de Ferro Negro, 20 Couros Encantados, 3 Lunatramas e 4 Pelegos Rústicos Curados para Anthion Harmon nas Terras Pestilentas Orientais.‡Принести три слитка черного железа, 20 кусков зачарованной кожи, 3 куска луноткани и 4 обработанные грубые шкуры Антиону Хармону в Восточные Чумные земли.‡Bringt Anthion Harmon in den östlichen Pestländern 3 Dunkeleisenbarren, 20 verzaubertes Leder, 3 Mondstoff und 4 geschmeidige unverwüstliche Bälge‡동부 역병지대에 있는 안시온 하몬에게 검은무쇠 주괴 3개, 마력 깃든 가죽 20개, 달빛 옷감 3개, 거친 경화 가죽 4개를 가져가야 합니다.‡Lleva 3 barras de hierro negro, 20 retales de cuero encantado, 3 de tela lunar y 4 pieles bastas curtidas a Anthion Harmon a las Tierras de la Peste del Este.‡Lleva 3 barras de hierro negro, 20 retales de cuero encantado, 3 de tela lunar y 4 pellejos bastos curtidos a Anthion Harmon a las Tierras de la Peste del Este.‡Remettre 3 Barres de sombrefer, 20 Cuirs enchantés, 3 Etoffes lunaires et 4 Peaux robustes traitées à Anthion Harmon dans les Maleterres de l\'est.‡将3块黑铁锭、20张魔化皮、3块月布和4块熟化毛皮交给东瘟疫之地的安泰恩·哈尔蒙。‡將3塊黑鐵錠，20塊附魔皮，3塊月布和4塊熟化毛皮帶給東溫疫之地的安希恩·哈莫。',
  }
},
[8948] = {
  {
    'Um velho amigo de Anthion‡Старый приятель Антиона‡Anthions alter Freund‡안시온의 오랜 친구‡Un viejo amigo de Anthion‡Un viejo amigo de Anthion‡Le vieil ami d\'Anthion‡安泰恩的老朋友‡安希恩的老朋友',
    nil,
    'Leve o Estandarte Incompleto da Provocação para Falrin Arboril na biblioteca do Gládio Cruel.‡Отнесите незаконченное Знамя Вызова Фалрину Садовнику в библиотеку Забытого Города.‡Bringt Falrin Rankenweber in der Bibliothek von Düsterbruch das unvervollständigte Banner der Provokation.‡혈투의 전장의 도서관에 있는 팔린 트리셰이퍼에게 미완성된 도전의 깃발을 가져가야 합니다.‡Lleva el estandarte de Provocación incompleto a Falrin Tallarbol que está en la biblioteca de La Masacre.‡Lleva el estandarte de Provocación incompleto a Falrin Tallarbol que está en la biblioteca de La Masacre.‡Apportez la Bannière de provocation incomplète à Falrin Sculpteflore, dans la bibliothèque de Hache-tripes.‡将未完成的挑战之旗交给厄运之槌图书馆内的法尔林·树影。‡將不完整的挑釁旗幟帶到厄運之槌的圖書館給法琳·樹形者。',
  }
},
[8949] = {
  {
    'A vendeta de Falrin‡Кровная месть Фарлина‡Falrins Rachefeldzug‡팔린의 피의 복수‡La vendetta de Falrin‡La vendetta de Falrin‡La vendetta de Falrin‡法尔林的复仇‡法琳的仇恨',
    nil,
    'Colete 25 Colares de Guerra dos Ogros dos Ogros no Gládio Cruel ou no Pico da Rocha Negra e fale novamente com Falrin Arboril no Ateneu do Gládio Cruel.‡Соберите 25 боевых ожерелий огров с огров Забытого Города или пика Черной горы и вернитесь в Читальню Забытого Города к Фалрину Садовнику.‡Nehmt den Ogern in der Schwarzfelsspitze oder in Düsterbruch 25 Ogerkriegsperlen ab und bringt sie zu Falrin Rankenweber im Athenaeum, der Bibliothek von Düsterbruch.‡혈투의 전장이나 검은바위 첨탑의 오우거로부터 오우거 전투 목걸이 25개를 모은 후 도서관 안에 있는 팔린 트리셰이퍼에게 돌아가야 합니다.‡Reúne 25 abalorios de guerra de ogro de los ogros de La Masacre o de la Cumbre de Roca Negra y vuelve a El Athenaeum de La Masacre a hablar con Falrin Tallarbol.‡Reúne 25 abalorios de guerra de ogro de los ogros de La Masacre o de la Cumbre de Roca Negra y vuelve a El Athenaeum de La Masacre a hablar con Falrin Tallarbol.‡Collecter 25 Perles de guerre ogres à l\'intérieur de Hache-tripes ou du Pic Rochenoire, puis revenir voir Falrin Sculpteflore, à l\'intérieur de l\'Athenaeum à Hache-tripes.‡在厄运之槌和黑石塔的食人魔身上收集25串食人魔珠串，然后回去向厄运之槌图书馆内的法尔林·树影复命。‡從厄運之槌或黑石塔的巨魔身上收集25個巨魔戰爭串珠再回到厄運之槌圖書館找法琳·樹形者。',
  }
},
[8950] = {
  {
    'O encantamento do instigador‡Чары подстрекателя‡Die Verzauberung des Aufhetzers‡주동자의 마법‡El encantamiento del provocador‡El encantamiento del provocador‡L\'enchantement du provocateur‡旗帜上的附魔‡教唆者的附魔',
    nil,
    'Leve os seguintes materiais para Falrin Arboril no Gládio Cruel: 1 Essência de Espírito Zombeteiro, 4 Runas Negras e 8 Estilhaços Brilhantes Grandes.‡Принесите 1 сущность язвительного призрака, 4 черных руны и 8 больших сияющих осколков Фалрину Садовнику в Забытом Городе.‡Bringt Falrin Rankenweber in Düsterbruch 1 Essenz eines spöttischen Geisterwesens, 4 Dunkelrunen und 8 große glänzende Splitter.‡혈투의 전장 안 도서관에 있는 팔린 트리셰이퍼에게 다음 재료를 가져가야 합니다: 도깨비 정수 1개, 암흑의 룬 4개, 눈부신 큰 결정 8개‡Lleva a Falrin Tallarbol a La Masacre, lo siguiente: 1 esencia de espectro bufón, 4 runas oscuras y 8 fragmentos luminosos grandes.‡Lleva a Falrin Tallarbol a La Masacre, lo siguiente: 1 esencia de espectro bufón, 4 runas oscuras y 8 fragmentos luminosos grandes.‡Apportez les choses suivantes à Falrin Sculpteflore dans Hache-tripes : 1 Essence de spectre railleur, 4 Runes ténébreuses et 8 Grands éclats brillants.‡将1份游荡鬼灵的精华、4个黑暗符文和8个大块魔光碎片交给厄运之槌图书馆内的法尔林·树影。‡將以下的物品帶給厄運之槌的法琳·樹形者:1份嘲弄幽靈精華，4個黑暗符文和8個大塊魔光裂片。',
  }
},
[8951] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Deliana, em Altaforja, com um conjunto de Botas do Coração Selvagem, Kilt do Coração Selvagem e Dragonas do Coração Selvagem.‡Вернитесь в Стальгорн к Делиане с сапогами Буйного Сердца, килтом Буйного Сердца и наплечем Буйного Сердца.‡Kehrt mit einem Paar Stiefel des Wildherzens, einem Kilt des Wildherzens und einer Schiftung des Wildherzens zu Deliana in Eisenschmiede zurück.‡자연의정수 장화, 자연의정수 킬트, 자연의정수 어깨갑옷을 가지고 아이언포지에 있는 델리아나에게 돌아가야 합니다.‡Lleva 1 par de botas, 1 falda escocesa y 1 par de hombreras Corazón Salvaje a Deliana a Forjaz.‡Lleva 1 par de botas, 1 falda y 1 par de bufas Corazón Salvaje a Deliana a Forjaz.‡Retournez voir Deliana à Ironforge avec des bottes du Cœur-sauvage, un Kilt du Cœur-sauvage et des Spallières du Cœur-sauvage.‡带上一双野性之心长靴、一条野性之心褶裙和一副野性之心肩甲，回去向铁炉堡的德莉亚娜复命。‡帶著野性之心長靴，野性之心褶裙和野性之心肩甲回到鐵爐堡的德莉娜那裡。',
  }
},
[8952] = {
  {
    'Anthion\'s Parting Words‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    'Return to Deliana in Ironforge with a set of Beaststalker\'s Boots, Beaststalker\'s Pants and Beaststalker\'s Mantle.‡Принесите в Стальгорн Делиане сапоги загонщика, штаны загонщика и оплечье загонщика.‡Kehrt mit einem Paar Bestienjägerstiefeln, einer Bestienjägerhose und einem Bestienjägermantel zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 pantalón y 1 manto del Acechador a Deliana a Forjaz.‡Lleva 1 par de botas, 1 pantalón y 1 manto de acechabestias a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de bestiaire, un Pantalon de bestiaire et un Mantelet de bestiaire.‡带上一双野兽追猎者长靴、一条野兽追猎者短裤和一副野兽追猎者衬肩，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8953] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    'Fale novamente com Deliana em Altaforja, levando um par de Botas do Magíster, um par de Perneiras do Magíster e Dragonas do Magíster.‡Вернитесь в Стальгорн к Делиане с сапогами Магистра, поножами Магистра и мантией Магистра.‡Kehrt mit einem Paar Stiefel des Magisters, Gamaschen des Magisters und einem Mantel des Magisters zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 manto y 1 par de leotardos Magister a Deliana a Forjaz.‡Lleva 1 par de botas, 1 manto y 1 par de leotardos de magister a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de magistère, des Jambières de magistère et un Mantelet de magistère.‡带上一双博学者长靴、一条博学者护腿和一副博学者衬肩，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8954] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    'Fale novamente com Deliana, em Altaforja, com um conjunto de Botas da Forja de Luz, Coxotes da Forja de Luz e Espaldares da Forja de Luz.‡Принесите в Стальгорн Делиане сапоги из светлостали, ножные латы из светлостали и наплеч из светлостали.‡Kehrt mit einem Paar Stiefel des Lichts, Beinplatten des Lichts, und einer Schiftung des Lichts zu Deliana in Eisenschmiede zurück.‡성전사 장화, 성전사 다리갑옷, 성전사 어깨갑옷을 가지고 아이언포지에 있는 델리아나에게 돌아가야 합니다.‡Lleva 1 par de botas, 1 par de musleras y 1 par de hombreras Forjaluz a Deliana a Forjaz.‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas Forjaluz a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de Sancteforge, des Cuissards de Sancteforge et des Spallières de Sancteforge.‡带上一双光铸战靴、一条光铸腿铠和一副光铸肩铠，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8955] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    'Fale novamente com Deliana, em Altaforja, com um conjunto de Sandálias do Devoto, Saia do Devoto e Dragonas do Devoto.‡Принесите в Стальгорн Делиане сандалии Преданности, юбку Преданности и оплечье Преданности.‡Kehrt mit einem Paar Sandalen des Gläubigen, einem Rock des Gläubigen und einem Mantel des Gläubigen zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de sandalias, 1 falda y 1 manto de Devoción a Deliana a Forjaz.‡Lleva 1 par de zapatos, 1 saya y 1 manto de devoto a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Sandales de dévot, une Jupe de dévot et un Mantelet de dévot.‡带上一双虔诚软鞋、一条虔诚长裙和一副虔诚衬肩，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8956] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Deliana em Altaforja com um conjunto de Botas da Arte Sombria, Calças da Arte Sombria e Espaldares da Arte Sombria.‡Принесите в Стальгорн Делиане сапоги Незаметности, штаны Незаметности и наплеч Незаметности.‡Kehrt mit einem Paar Stiefel der Schattenkunst, einer Hose der Schattenkunst und einer Schiftung der Schattenkunst zu Deliana in Eisenschmiede zurück.‡어둠추적자 장화, 어둠추적자 바지, 어둠추적자 어깨갑옷을 가지고 아이언포지에 있는 델리아나에게 돌아가야 합니다.‡Lleva 1 par de botas, 1 pantalón y 1 par de hombreras Oficioscuro a Deliana a Forjaz.‡Lleva 1 par de botas, 1 pantalón y 1 par de bufas arte sombrío a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes Sombreruse, un Pantalon Sombreruse et des Spallières Sombreruse.‡带上一双迅影长靴、一条迅影短裤和一副迅影肩甲，回去向铁炉堡的德莉亚娜复命。‡帶著迅影長靴，迅影便褲和迅影肩甲回到鐵爐堡的德莉娜那裡。',
  }
},
[8957] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    'Fale novamente com Mokvar, em Orgrimmar, com um conjunto de Botas dos Elementos, Kilt dos Elementos e Brafoneiras dos Elementos.‡Отдайте Моквару в Оргриммаре сапоги Стихий, килт Стихий и наплечье Стихий.‡Kehrt mit einem Paar Stiefel der Elemente, einem Kilt der Elemente und Schulterstücken der Elemente zu Mokvar in Orgrimmar zurück.‡정령의 장화, 정령의 킬트, 정령의 어깨갑옷을 가지고 오그리마에 있는 모크바르에게 돌아가십시오.‡Lleva 1 par de botas, 1 par de musleras y 1 espaldar de los elementos a Mokvar a Orgrimmar.‡Lleva 1 par de botas, 1 falda y unos espaldares de elementos a Mokvar a Orgrimmar.‡Retournez voir Mokvar à Orgrimmar avec des Bottes des éléments, un Kilt des éléments et des Espauliers des éléments.‡带上一双元素长靴、一条元素护腿和一副元素护肩，回去向奥格瑞玛的莫克瓦尔复命。‡',
  }
},
[8958] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡',
    nil,
    'Fale novamente com Deliana em Altaforja, com um conjunto de Sandálias de Brumedo, Perneiras de Brumedo e Dragonas de Brumedo.‡Принесите в Стальгорн Делиане сандалии Багрового Тумана, поножи Багрового Тумана и оплечье Багрового Тумана.‡Kehrt mit einem Paar Sandalen der Furcht, Gamaschen der Furcht und einem Mantel der Furcht zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de sandalias, 1 par de leotardos y 1 manto Calígine a Deliana a Forjaz.‡Lleva 1 par de sandalias, 1 par de leotardos y 1 manto calígine a Deliana a Forjaz.‡Retournez voir Deliana à Ironforge avec des Sandales de Brume-funeste, des Jambières de Brume-funeste et un Mantelet de Brume-funeste.‡带上一双鬼雾便鞋、一条鬼雾护腿和一副鬼雾衬肩，回去向铁炉堡的德莉亚娜复命。‡',
  }
},
[8959] = {
  {
    'As últimas palavras de Anthion‡Прощальные слова Антиона‡Anthions Abschiedsworte‡안시온의 작별 인사‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡告别安泰恩‡安希恩的離別感言',
    nil,
    'Fale novamente com Deliana em Altaforja, com um conjunto de Botas do Valor, Coxotes do Valor e Espaldares do Valor.‡Принесите в Стальгорн Делиане сапоги Доблести, ножные латы Доблести и наплеч Доблести.‡Kehrt mit einem Paar Stiefel der Ehre, Beinplatten der Ehre und einer Schiftung der Ehre zu Deliana in Eisenschmiede zurück.‡용맹의 장화, 용맹의 다리갑옷, 용맹의 어깨갑옷을 가지고 아이언포지에 있는 델리아나에게 돌아가야 합니다.‡Lleva 1 par de botas, 1 par de musleras y 1 par de hombreras de Valor a Deliana a Forjaz.‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas de valor a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes de vaillance, des Cuissards de vaillance et des Spallières de vaillance.‡带上一双勇气战靴、一条勇气腿铠和一副勇气肩甲，回去向铁炉堡的德莉亚娜复命。‡帶著勇氣之靴，勇氣腿鎧和勇氣肩甲回到鐵爐堡的德莉娜那裡。',
  }
},
[8960] = {
  {
    'O infeliz destino de Bodley‡Злосчастная доля Бодли‡Bodleys trauriges Schicksal‡보들리의 불행한 운명‡El triste destino de Bodley‡El triste destino de Bodley‡Le triste destin de Bodley‡伯德雷的不幸‡布德利不幸的命運',
    nil,
    'Vá até a Montanha Rocha Negra e use o Revelador Extradimensional de Fantasmas para encontrar Bodley próximo ao Pico da Rocha Negra.‡Отыщите Бодли у Пика Черной горы с помощью спектрального сканера иных измерений.‡Reist zum Schwarzfels und benutzt den extradimensionalen Geisterdetektor, um Bodley nahe der Schwarzfelsspitze zu finden.‡검은바위 산으로 가 검은바위 첨탑 근처에서 4차원 유령 탐색기를 사용하여 보들리를 찾아야 합니다.‡Viaja hasta la Montaña Roca Negra y usa el detector de fantasmas extradimensionales para encontrar a Bodley cerca de la Cumbre de Roca Negra.‡Viaja hasta la Montaña Roca Negra y usa el detector de fantasmas extradimensionales para encontrar a Bodley cerca de la Cumbre de Roca Negra.‡Rendez-vous au mont Blackrock, près du pic Blackrock, et utilisez le Révélateur de fantômes extradimensionnel pour trouver Bodley.‡到黑石山去，使用超维度幽灵显形器找到伯德雷。‡到黑石山並使用超空間鬼魂顯像機，去黑石塔附近尋找布德利。',
  }
},
[8961] = {
  {
    'Três reis das chamas‡Три властелина огня‡Die drei Könige der Flammen‡세 고위 정령의 불꽃‡Tres reyes de Fuego‡Tres reyes de Fuego‡Les trois rois des flammes‡烈焰之王‡烈焰三巨頭',
    nil,
    'Colete a Incendicita de Incendius, a Brasa do Mirabrasa e a Cinza das Cinzas, além de um Braseiro Santificado, e fale novamente com Bodley na Montanha Rocha Negra.‡Добыть огневит Огнеуса, уголь Пиростража и пепел Герцога и принести их Бодли в Черную гору вместе с жаровней Благословения.‡Bringt Bodley im Schwarzfels Incendius\' Pyrophor, Glutsehers Glut, die Asche des Fürsten und ein geheiligtes Räuchergefäß.‡인센디우스의 발연석, 불꽃 군주의 불꽃, 엠버시어의 불씨를 얻은 후, 성스러운 화로를 함께 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Recolecta la incendicita de Incendius, el ascua del Brasadivino y el rescoldo de las brasas junto con el blandón sagrado y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Recolecta la incendicita de Incendius, el ascua del Brasadivino y el rescoldo de las brasas junto con el blandón sagrado y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Récupérez l\'Incendicite d\'Incendius, la Braise du prophète ardent sur le pyrogarde Prophète ardent et les Cendres de Cendres, ainsi qu\'un Brasero béni, puis retournez voir Bodley au mont Rochenoire.‡收集伊森迪奥斯的余炭、艾博希尔灰烬和灰烬公爵的残渣，并从银色黎明军需官那儿购买一只空火盆，然后将这些东西交给黑石山的伯德雷。‡收集伊森迪奧斯的煤渣，艾博希爾的煤炭和辛德爾的煤渣，並帶著神聖火盆回到黑石山找布德利。',
  }
},
[8962] = {
  {
    'Componentes importantes‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡중요한 요소‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡重要的材料',
    nil,
    'Obtenha Restos Mortais Druídicos e os leve para Bodley na Montanha Rocha Negra.‡Найдите останки друидов и принести их Бодли в Черную гору.‡Bringt Bodley im Schwarzfels einige Druidenüberreste.‡드루이드의 유골을 구한 후 검은바위 산에 있는 보들리에게 가져가야 합니다.‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Consigue restos de druida y llévaselos a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous des Restes druidiques et rapportez-les à Bodley, à l\'intérieur du mont Rochenoire.‡收集德鲁伊的遗骸，把它们交给黑石山的伯德雷。‡取得德魯伊的遺體，再回到黑石山找布德利。',
  }
},
[8963] = {
  {
    'Componentes importantes‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡중요한 요소‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡',
    nil,
    'Obtenha uma Relíquia do Vilarejo Brisastral e leve-a para Bodley na Montanha Rocha Negra.‡Найдите реликвию Деревни Звездного Ветра и принести ее Бодли в Черную гору.‡Bringt Bodley im Schwarzfels ein Relikt von Sternenhauch.‡별바람 마을 유물을 구해서 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una reliquia de la Aldea Brisa Estelar y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Relique de Brise-stellaire et rapportez-la à Bodley, à l\'intérieur du mont Rochenoire.‡收集一个星风村遗物，把它交给黑石山的伯德雷。‡',
  }
},
[8964] = {
  {
    'Componentes importantes‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡중요한 요소‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡重要的材料',
    nil,
    'Obtenha uma Espada Brilhante do Fanatismo e leve-a para Bodley na Montanha Rocha Negra.‡Добудьте сверкающий меч фанатизма и принесите его Бодли в Черную гору.‡Bringt Bodley im Schwarzfels ein gleißendes Schwert des Zeloten.‡번쩍이는 열광의 검을 얻은 후 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Consigue una espada luminosa de zelote y llévasela a Bodley en el interior de la Montaña Roca Negra.‡Procurez-vous une Epée brillante de fanatisme, puis rapportez-la à Bodley, à l\'intérieur du mont Rochenoire.‡找到一把狂热光芒之剑，把它交给黑石山的伯德雷。‡取得光亮的狂熱之劍，再回到黑石山找布德利。',
  }
},
[8965] = {
  {
    'Componentes importantes‡Важная составляющая заклинания‡Komponenten von großer Wichtigkeit‡‡Componentes importantes‡Componentes importantes‡Des composants importants‡重要的材料‡重要的材料',
    nil,
    'Obtenha Cinzas de Alma Banida e leve-as para Bodley, dentro da Montanha Rocha Negra.‡Добыть пепел душ Изгнанников и принести его Бодли в Черную гору.‡Bringt Bodley im Schwarzfels etwas Seelenasche der Verbannten.‡‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Consigue cenizas de almas de los Desterrados y llévaselas a Bodley en el interior de la Montaña Roca Negra.‡Prélevez des Cendres d’âme de banni, puis retournez voir Bodley à l’intérieur du mont Blackrock.‡拿到放逐者的灵魂灰烬，把它交给黑石山的伯德雷。‡取得流放者的靈魂灰燼，再回到黑石山找布德利。',
  }
},
[8966] = {
  {
    'A parte esquerda do amuleto do Lorde Valthalak‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 왼쪽 조각‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的左瓣‡瓦薩拉克領主護符的左半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Mor Casco Gris e então mate-o. Fale novamente com Bodley na Montanha Rocha Negra, com a Parte Esquerda do Amuleto do Lorde Valthalak e o Braseiro de Sinalização.‡Вызвать дух Мора Серого Копыта с помощью жаровни Призыва, прикончить его и забрать недостающую часть амулета Лорда Вальтхалака. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Mor Grauhuf zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡부름의 화로를 사용하여 모르 그레이후프의 영혼을 소환한 후 처치하십시오. 군주 발타라크의 아뮬렛 왼쪽 조각과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Mor Ruciapezuña y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Mor Pezuña Gris y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit de Mor Sabot-gris, puis tuez-le. Ensuite, retournez voir Bodley à l\'intérieur du mont Rochenoire avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出莫尔·灰蹄的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给黑石山的伯德雷。‡使用召喚火盆來召喚莫爾·灰蹄的靈魂並殺了他。帶著瓦薩拉克領主護符的左半塊和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8967] = {
  {
    'A parte esquerda do amuleto do Lorde Valthalak‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 왼쪽 조각‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的左瓣‡',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Isalien e então mate-o. Fale novamente com Bodley na Montanha Rocha Negra, com a Parte Esquerda do Amuleto do Lorde Valthalak restaurado e o Braseiro de Sinalização.‡С помощью жаровни Призыва вызвать дух Изалиен и убить ее. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Лорда Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Isalien zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡부름의 화로를 사용하여 이살리엔의 영혼을 소환한 후 처치하십시오. 군주 발타라크의 아뮬렛 왼쪽 조각과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Isalien y mátala. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit d\'Isalien, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出伊萨利恩的灵魂，然后杀掉她。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给伯德雷。‡',
  }
},
[8968] = {
  {
    'A parte esquerda do amuleto do Lorde Valthalak‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 왼쪽 조각‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的左瓣‡瓦薩拉克領主護符的左半塊',
    nil,
    'Use o Braseiro de Sinalização para evocar os espíritos de Jil e Soeiro e então mate os dois. Fale novamente com Bodley na Montanha Rocha Negra, com a Parte Esquerda do Amuleto do Lorde Valthalak e o Braseiro de Sinalização.‡Вызвать духов Джариен и Сотоса с помощью жаровни Призыва и убить их обоих. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Лорда Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um die Geister von Jarien und Sothos zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡부름의 화로를 사용하여 자리엔과 소노스의 영혼을 소환한 후 처치하십시오. 군주 발타라크의 아뮬렛 왼쪽 조각과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Jarien y Sothos y mátalos. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer Jarien et Sothos et les tuer. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出亚雷恩和索托斯的灵魂，然后杀掉他们。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给黑石山的伯德雷。‡使用召喚火盆來召喚賈林和索索斯並殺了他們。帶著瓦薩拉克領主護符的左半塊和召喚火盆回到黑石山的布德利那裡。',
  }
},
[8969] = {
  {
    'A parte esquerda do amuleto do Lorde Valthalak‡Левая часть амулета Лорда Вальтхалака‡Das linke Stück von Lord Valthalaks Amulett‡군주 발타라크의 아뮬렛 왼쪽 조각‡La parte izquierda del amuleto de Lord Valthalak‡La parte izquierda del amuleto de Lord Valthalak‡Le morceau gauche de l\'amulette du seigneur Valthalak‡瓦塔拉克饰品的左瓣‡',
    nil,
    'Use o Braseiro de Sinalização para evocar o espírito de Kormok e então mate-o. Fale novamente com Bodley, na Montanha Rocha Negra, com a Parte Esquerda do Amuleto do Lorde Valthalak e o Braseiro de Sinalização.‡С помощью жаровни Призыва вызвать дух Кормока и убить его. Вернуться к Бодли в Черную гору, отдать ему левую часть амулета Лорда Вальтхалака и жаровню Призыва.‡Benutzt das Räuchergefäß der Beschwörung, um den Geist von Kormok zu beschwören und zu vernichten. Kehrt dann mit dem linken Stück von Lord Valthalaks Amulett und dem Räuchergefäß der Beschwörung zu Bodley im Schwarzfels zurück.‡부름의 화로를 사용하여 코르모크의 영혼을 소환한 후 처치하십시오. 군주 발타라크의 아뮬렛 왼쪽 조각과 부름의 화로를 가지고 검은바위 산 안에 있는 보들리에게 돌아가야 합니다.‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Usa el Blandón de Señalización para invocar al espíritu de Kormok y mátalo. Vuelve junto a Bodley en el interior de la Montaña Roca Negra con la parte izquierda del amuleto de Lord Valthalak y el Blandón de Señalización.‡Utilisez le Brasero de signal pour invoquer l\'esprit de Kormok, puis tuez-le. Retournez voir Bodley, à l\'intérieur du mont Rochenoire, avec le Morceau gauche de l\'amulette du seigneur Valthalak et le Brasero de signal.‡使用召唤火盆召唤出库尔莫克的灵魂，然后杀掉他。完成之后，将召唤火盆与瓦塔拉克饰品的左瓣还给黑石山的伯德雷。‡',
  }
},
[8970] = {
  {
    'Eu vejo a Ilha Alcaz no seu futuro...‡Я вижу остров Алькац...‡Ich sehe die Insel Alcaz in Eurer Zukunft‡예언 속의 알카즈 섬‡En tu destino veo la Isla de Alcaz...‡En tu destino veo la Isla de Alcaz...‡Votre avenir passe par l\'île d\'Alcaz‡奥卡兹岛在你前方......‡我看見你的未來有奧卡茲島……',
    nil,
    'Colete 20 Algassangues das nagas Strashaz e fale novamente com Bodley na Montanha Rocha Negra.‡Собрать 20 порций кровавой ламинарии у наг из клана Страшаз и принести их Бодли в Черную гору.‡Bringt Bodley im Schwarzfels 20 Einheiten Bluttang von den Naga der Strashaz.‡붉은물풀 20개를 모은 후 검은바위 산에 있는 보들리에게 돌아가야 합니다.‡Reúne 20 kelps de sangre de los nagas de Strashaz y regresa junto a Bodley en el interior de la Montaña Roca Negra.‡Reúne 20 algas de sangre de los nagas de Strashaz y regresa junto a Bodley en el interior de la Montaña Roca Negra.‡Récupérez 20 Varechs de sang sur les nagas Strashaz, puis retournez voir Bodley au mont Rochenoire.‡前往尘泥沼泽的奥卡兹岛，从斯塔莎兹纳迦身上收集20份血藻，然后返回黑石山的伯德雷那儿。‡在斯塔沙茲納迦身上收集20份血巨藻再回到黑石山的布德利那裡。',
  }
},
