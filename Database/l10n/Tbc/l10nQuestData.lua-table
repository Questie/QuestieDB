[1267] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Fale com Jaina Proudmore no Pântano Vadeoso.‡Поговорите с леди Джайной Праудмур из Пыльной трясины.‡Sprecht mit Jaina Prachtmeer im Sumpf der Düstermarschen.‡먼지진흙 습지대에 있는 제이나 프라우드무어와 대화해야 합니다.‡Habla con Jaina Valiente en el Pantano Revolcafango.‡Habla con Jaina Valiente en el Pantano Revolcafango.‡Parler à Jaina Portvaillant au marécage d\'Âprefange.‡与尘泥沼泽的吉安娜·普罗德摩尔谈一谈。‡與塵泥沼澤的珍娜·普勞德摩爾談話。',
  }
},
[1268] = {
  {
    'Pegadas em forma de casco‡Подозрительные следы копыт‡Verdächtige Hufabdrücke‡수상한 발굽 자국‡Huellas de pezuñas sospechosas‡Huellas de pezuñas sospechosas‡Des empreintes de sabots suspectes‡可疑的蹄印‡可疑的蹄印',
    nil,
    'Informe Krog, na Aldeia Muralha Verde, sobre as pegadas suspeitas na Estalagem Pouso do Umbral.‡Доложите о подозрительных следах возле таверны "Последний привал" Крогу в Деревне Гиблотопь.‡Berichtet Krog in Brackenwall von den verdächtigen Abdrücken beim Gasthaus Zur süßen Ruh.‡담쟁이 마을에 있는 크로그에게 그늘 쉼터 여관의 수상한 흔적에 대해 보고해야 합니다.‡Informa a Krog, del Poblado Murohelecho, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informa a Krog en el Poblado Murohelecho sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Faire votre rapport sur les empreintes suspectes de l\'auberge du repos ombragé à Krog, au village de Mur-de-Fougères.‡把树荫旅店的可疑蹄印报告给蕨墙村的克罗格。‡把樹蔭旅店的可疑蹄印報告給蕨牆村的克羅格。',
  }
},
[1269] = {
  {
    'Tenente Paval Reethe‡Лейтенант Павал Рит‡Leutnant Paval Reethe‡부관 파발 리테‡Teniente Paval Reethe‡Teniente Paval Reethe‡Lieutenant Paval Reethe‡帕瓦尔·雷瑟上尉‡帕瓦爾·雷瑟上尉',
    nil,
    'Leve o Distintivo de Reethe para Krog na Aldeia Muralha Verde.‡Принесите бляху Рита Крогу в деревню Гиблотопь.‡Bringt Reethes Abzeichen zu Krog in Brackenwall.‡담쟁이 마을에 있는 크로그에게 리테의 배지를 가져가야 합니다.‡Lleva el distintivo de Reethe a Krog al Poblado Murohelecho.‡Lleva el distintivo de Reethe a Krog al Poblado Murohelecho.‡Rapporter l\'insigne de Reethe à Krog à Mur-de-Fougères.‡把雷瑟的徽章带给蕨墙村的克罗格。‡把雷瑟的徽章帶給蕨牆村的克羅格。',
  }
},
[1270] = {
  {
    'A fuga do Cascão‡Побег Вонючки‡Stinkis Flucht‡말썽꾼의 탈출‡La fuga de Apestoso‡La fuga de Apestoso‡Sauvetage du Puant‡伊格纳兹的逃亡‡伊格納茲的逃亡',
    nil,
    'Escolte Inácio "Cascão" e, em seguida, fale com Cáliper Porcatraca na Vila Catraca.‡Сопроводите "Вонючку" Игнаца, затем пообщайтесь с Мебоком Миззриксом в Кабестане.‡Begleitet "Stinki" Ignatz und sprecht dann mit Mebok Mizzyrix in Ratschet.‡"말썽꾼" 이그나츠를 호위한 다음 톱니항에 있는 메보크 미지릭스와 대화해야 합니다.‡Escolta a "Apestoso" Ignatz y luego ve a Trinquete a hablar con Mebok Mizzyrix.‡Escolta a "Apestoso" Ignatz y luego ve a Trinquete a hablar con Mebok Mizzyrix.‡Escorter Ignatz "Puant" puis parler à Mebok Mizzyrix à Cabestan.‡护送伊格纳兹，然后和棘齿城的麦伯克·米希瑞克斯谈一谈。‡護送伊格納茲，然後和棘齒城的麥伯克·米希瑞克斯談話。',
  }
},
[1271] = {
  {
    'O banquete do Recôndito Azulego‡Праздник в "Голубом Отшельнике"‡Festmahl im Blauen Eremiten‡고독한 은둔자 선술집에서의 잔치‡¡Una fiesta en tu honor!‡¡Una fiesta en tu honor!‡Fête au Solitaire Bleu‡盛筵‡盛筵',
    nil,
    '‡Мой племянник сказал, что ты помог ему с его поисками в Пыльной трясине, а заодно и вытащил его компаньона из неслабой передряги. Мы, Штерны, держимся друг дружки и не забываем наших друзей!nnТак что мой руки, Бронетазик, сегодня пируем в твою честь!‡Mein Neffe sagte, Ihr habt ihn bei seiner Suche in Dustwallow unterstützt und seinem Assistenten aus der Klemme geholfen. Also wir Sterns halten zusammen und vergessen unsere Freunde nicht!nnAlso wascht Eure Hände, <Name>, denn wir geben Euch zu Ehren eine Party!‡제 조카 말이, 당신이 먼지진흙 습지대에서 조카의 요리 연구를 도왔다고 하더군요. 또 조카의 동료들을 힘든 상황에서 구해 내 주셨다고요? 음, 우리 스턴 가문은 결속력이 대단합니다. 그리고 결코 우릴 도와준 친구를 푸대접하는 일이 없지요!nn그래서 당신을 위한 잔치를 준비했으니 와서 손을 씻고 마음껏 즐기시기 바랍니다.‡Mi sobrino me dijo que le habías ayudado en su investigación en Revolcafango y que sacaste a su socio de un buen apuro. ¡Pues los Stern estamos muy unidos y atendemos a nuestros amigos!nnAsí que lávate las manos, <nombre>, ¡porque estamos a punto de montar una fiesta en tu honor!‡‡Mon neveu m\'a dit que vous l\'aviez aidé dans ses recherches à Âprefange et que vous aviez sorti son associé d’une situation difficile. Bien, nous les Stern, nous nous serrons les coudes et nous nous souvenons de nos amis !nnAlors lavez-vous les mains, <nom>, parce que nous allons faire la fête en votre honneur !‡‡',
  }
},
[1272] = {
  {
    'Procurando Reethe‡Найти Рита <CHANGE INTO GOSSIP>‡Sucht Reethe <ZU TRATSCH WECHSELN>‡리테 찾기‡Encontrar a Reethe <CHANGE INTO GOSSIP>‡‡Trouver Reethe <CHANGE INTO GOSSIP>‡‡尋找雷瑟',
    nil,
