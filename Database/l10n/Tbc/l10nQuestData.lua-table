},
[10454] = {
  {
    'BANDEIRA – SAINDO DO TRILHO‡FLAG – OFF THE RAILS‡FLAG - OFF THE RAILS‡ FLAG - OFF THE RAILS‡FLAG - SIN RAÍLES‡FLAG - SIN RAÍLES‡DRAPEAU - HORS DES RAILS‡FLAG - OFF THE RAILS‡',
    nil,
    nil,
  }
},
[10455] = {
  {
    'A selva agressiva‡Угроза хищников‡Die nahende Wildnis‡야생동물의 침범‡La naturaleza cercenada‡La naturaleza invasora‡Une nature envahissante‡危险的荒野‡失控的侵略',
    nil,
    'Mate 12 Linces Espreita-mata.‡Рина Лунный Родник хочет, чтобы вы как можно скорее убили 12 рысей рощи и вернулись к ней в Сильванаар в Острогорье.‡Rina Mondquell möchte, dass Ihr so schnell wie möglich 12 Hainpirscherluchse erlegt und dann zu ihr in Sylvanaar im Schergrat zurückkehrt.‡최대한 빨리 긴발톱 숲스라소니 12마리를 처치한 다음 칼날 산맥의 실바나르에 있는 리나 문스프링에게 돌아가야 합니다.‡Rina Lunabril quiere que mates 12 linces acecharboleda rápidamente y vuelvas a verla a Sylvanaar, en las Montañas Filospada.‡‡Rina Sourcelune souhaite que vous tuiez 12 Lynx traquebosquet en toute hâte puis que vous retourniez la voir à Sylvanaar dans les Tranchantes.‡莉娜·月泉希望你能以最快的速度杀死12只林地山猫，并回到刀锋山的希尔瓦纳向她复命。‡琳娜·月泉要你以最快的速度殺掉12隻森林山貓後回到劍刃山脈的希爾瓦納找她。',
  }
},
[10456] = {
  {
    'Lobos saqueadores‡Волчья напасть‡Marodierende Wölfe‡늑대의 습격‡Lobos merodeadores‡Lobos merodeadores‡Les loups en maraude‡徘徊的恶狼‡巡邏的狼群',
    nil,
    'Colete 4 Caudas de Lobo Hediondo Senhor do Trovão.‡Рина Лунный Родник просит вас принести ей 4 хвоста лютых волков клана Громоборцев. По выполнении задания вернитесь к ней в Сильванаар в Острогорье.‡Rina Mondquell möchte, dass Ihr 4 Schwänze eines Terrorwolfs der Donnerfürsten beschafft. Kehrt danach zu ihr in Sylvanaar im Schergrat zurück.‡광포한 천둥군주 늑대 꼬리 4개를 모아야 합니다.‡Consigue 4 colas de lobos temibles Señor del Trueno.‡‡Rapportez 4 Queues de loup redoutable sire-tonnerre.‡莉娜·月泉要求你给她带回4条雷神恶狼的尾巴，完成之后回到刀锋山的希尔瓦纳向她复命。‡琳娜·月泉要你帶給她4根雷霆王恐狼尾。完成後，回到劍刃山脈的希爾瓦納找她。',
  }
},
[10457] = {
  {
    'A proteção dos nossos‡Защитить свой дом‡Die Eigenen schützen‡생명의 숲 수호‡Proteger a los nuestros‡Proteger a los nuestros‡Pour protéger les nôtres‡自我保护‡保護我們自己',
    nil,
    'Use o Ramo de Rina em 5 das Mudas do Bosque para evocar defesas para o Bosque Vicejante.‡Взмахните ветвью Рины над 5 саженцами рощи, чтобы призвать на защиту Живой рощи силы природы. Затем вернитесь к Рине Лунный Родник в Сильванаар в Острогорье.‡Benutzt Rinas Zweig bei 5 Hainsetzlingen, um Verteidigung für den lebenden Hain herbeizurufen. Kehrt dann zu Rina Mondquell in Sylvanaar im Schergrat zurück.‡숲의 묘목 5개에 리나의 나뭇가지를 사용하여 생명의 숲에 수호정령을 불러내야 합니다.‡Utiliza la rama de Rina en 5 semillas de la arboleda para invocar defensas para La Arboleda Viviente.‡‡Utilisez le Rameau de Rina sur 5 Boutures du Bosquet pour faire apparaître des défenseurs du Bosquet vivant.‡在5处活木林树苗上使用莉娜的树枝，召唤生物保卫活木林。完成任务之后回到刀锋山的希尔瓦纳，向莉娜·月泉复命。‡在5株果樹幼苗身上使用琳娜的樹枝以召喚今後生命之林的防護者。完成後回到劍刃山脈的希爾瓦納找琳娜·月泉。',
  }
},
[10458] = {
  {
    'Espíritos do fogo e da terra enfurecidos‡Разъяренные бесы пламени и земли‡Wütende Geister des Feuers und der Erde‡분노한 불과 대지의 정령들‡Espíritus de fuego y tierra iracundos‡Espíritus de fuego y tierra iracundos‡Esprits de feu et de terre enragés‡愤怒的火灵和地灵‡火與大地的暴怒之靈',
    nil,
    'O Reparador da Terra Torlok, no Altar da Danação do Vale da Lua Negra, quer que você use o Totem dos Espíritos para capturar 8 Almas da Terra e 8 Almas do Fogo.‡Поймайте с помощью тотема духов 8 бесов земли и 8 бесов пламени для целителя земли Торлока из Алтаря Проклятия.‡Erdheiler Torlok beim Altar der Verdammnis im Schattenmondtal möchte, dass Ihr das Totem der Geister benutzt, um 8 Erdenseelen und 8 Feuerseelen einzufangen.‡어둠달 골짜기 저주의 제단에 있는 대지의 치유사 토르록이 정기의 토템을 사용해 분노한 대지의 영혼 8명과 분노한 불의 영혼 8명을 사로잡아 달라고 부탁했습니다.‡El ensalmador de la tierra Torlok en El Altar de Condenación, en el Valle Sombraluna, quiere que utilices el Tótem de espíritus para capturar 8 almas de terráneos y 8 almas de ígneos.‡El ensalmador de la tierra Torlok en El Altar de Condenación, en el Valle Sombraluna, quiere que utilices el Tótem de espíritus para capturar 8 almas de terráneos y 8 almas de ígneos.‡Le soigneterre Torlok à l\'Autel de la damnation dans la vallée d\'Ombrelune veut que vous utilisiez le Totem des esprits pour capturer 8 Âmes terrestres et 8 Âmes flamboyantes.‡使用灵魂图腾俘获8个土之魂和8个火之魂，然后向影月谷诅咒祭坛的大地治愈者托洛克复命。‡影月谷裡詛咒祭壇的大地治癒者托爾洛克要你使用靈魂圖騰捕捉8個土靈之魂及8個熾熱之魂。',
  }
},
[10459] = {
  {
    'Reverenciado na Expedição Cenariana‡Почтительное отношение Кенарийской экспедиции‡Von der Expedition des Cenarius verehrt‡세나리온 원정대의 매우 우호적 평판‡Venerado por la Expedición Cenarion‡Venerado por la Expedición Cenarion‡Révéré par l\'Expédition cénarienne‡塞纳里奥远征队的崇敬‡得到塞納里奧遠征隊的尊敬',
    nil,
    'Ysiel Cantavento, no Refúgio Cenariano, quer que você se torne <reverenciado/reverenciada> na Expedição Cenariana.‡Исиэль Песнь Ветра из Кенарийского приюта хочет, чтобы вы добились почтительного отношения Кенарийской экспедиции.‡Ysiel Windsänger bei der Zuflucht des Cenarius möchte, dass Euch einen respektvollen Ruf bei der Expedition des Cenarius verdient.‡세나리온 야영지에 있는 이시엘 윈드싱어가 세나리온 원정대에 대한 매우 우호적 평판을 얻어야 한다고 했습니다.‡Ysiel Vientocantor del Refugio Cenarion quiere que logres que los miembros de la Expedición Cenarion te veneren.‡Ysiel Vientocantor del Refugio Cenarion quiere que logres que los miembros de la expedición de Cenarius te veneren.‡Ysiel Chantelevent du Refuge cénarien veut que vous deveniez <Révéré/Révérée> par l\'Expédition cénarienne.‡塞纳里奥庇护所的伊谢尔·风歌要求你在塞纳里奥远征队中达到崇敬声望。‡塞納里奧避難所的伊斯歐·風歌要你贏得塞納里奧遠征隊的尊敬。',
  }
},
[10460] = {
  {
    'Jura do defensor‡Посвящение в защитники‡Das Versprechen des Verteidigers‡수호자의 약속‡El juramento de defensor‡El juramento de defensor‡Le serment du défenseur‡防御者的契约‡',
    nil,
    'Tem certeza de que é este o caminho de sua escolha, <name>? Esta não é uma decisão fácil.nnEste anel está imbuído na gota da Nascente da Eternidade. O poder dele crescerá conforme você provar sua lealdade à Escama das Areias.‡Ты уверен, что хочешь избрать этот путь, Тириш? Он будет нелегким, так что трижды подумай, прежде чем примешь решение.nnВ этом кольце заключена капля воды из Источника Вечности. Его сила возрастет, когда ты заслужишь доверие драконов Песчаной Чешуи.‡‡‡‡‡‡‡',
  }
},
[10461] = {
  {
    'Jura do restaurador‡Посвящение в целители‡Das Versprechen des Bewahrers‡구원자의 약속‡El juramento del restaurador‡El juramento del restaurador‡Le serment du guérisseur‡治愈者的契约‡',
    nil,
    nil,
  }
},
[10462] = {
  {
    'Jura do campeão‡Посвящение в герои‡Das Versprechen des Helden‡용사의 약속‡El juramento de campeón‡El juramento de campeón‡Le serment du champion‡勇士的契约‡',
    nil,
    'Tem certeza de que é este o caminho de sua escolha, <name>? Esta não é uma decisão fácil.nnEste anel está imbuído na gota da Nascente da Eternidade. O poder dele crescerá conforme você provar sua lealdade à Escama das Areias.‡Ты уверен, что хочешь избрать этот путь, Тыж? Он будет нелегким, так что трижды подумай, прежде чем примешь решение.nnВ этом кольце заключена капля воды из Источника Вечности. Его сила возрастет, когда ты заслужишь доверие драконов Песчаной Чешуи.‡Seid Ihr sicher, dass Ihr diesen Pfad gehen wollt, <Name>? Das ist keine Entscheidung, die leichtfertig getroffen werden sollte.nnDieser Ring wurde mit einem Tropfen aus dem Brunnen der Ewigkeit verstärkt. Wenn Ihr Euch den Wächtern der Sande gegenüber beweist, wird er an Macht gewinnen.‡‡‡‡‡‡',
  }
},
[10463] = {
  {
    'Jura do sábio‡Посвящение в мудрецы‡Das Versprechen des Weisen‡현자의 약속‡El juramento del sabio‡El juramento del sabio‡Le serment du sage‡先知的契约‡',
    nil,
    '‡Ты уверен, что хочешь избрать этот путь, Монд? Он будет нелегким, так что трижды подумай, прежде чем примешь решение.nnВ этом кольце заключена капля воды из Источника Вечности. Его сила возрастет, когда ты заслужишь доверие драконов Песчаной Чешуи.‡Seid Ihr sicher, dass Ihr diesen Pfad gehen wollt, <Name>? Das ist keine Entscheidung, die leichtfertig getroffen werden sollte.nnDieser Ring wurde mit einem Tropfen aus dem Brunnen der Ewigkeit verstärkt. Wenn Ihr Euch den Wächtern der Sande gegenüber beweist, wird er an Macht gewinnen.‡그대가 가고자 하는 길이 현자의 길인가요, <name>? 가볍게 내릴 결정이 아니라는 건 아시겠지요.nn이 반지는 영원의 샘의 물방울이 녹아들어 있답니다. 그대가 시간의 중재자들에 능력을 입증해 보일 때 이 반지의 힘은 더욱 강해질 것입니다.‡‡‡‡‡',
  }
},
[10464] = {
  {
    'Voto do sábio‡Обет мудреца‡Das Gelöbnis des Weisen‡현자의 맹세‡La promesa del sabio‡La promesa del sabio‡Le vœu du sage‡先知的誓约‡',
    nil,
    'Leve seu Elo da Eternidade para Soridormi nas Cavernas do Tempo após tornar-se <Honrado/Honrada> pela Escama das Areias.‡Принесите кольцо Вечности Соридорми в пещеры Времени после того, как сумеете заслужить уважительное отношение драконов Песчаной Чешуи.‡Bringt Euer Band der Ewigkeit zu Soridormi in den Höhlen der Zeit, wenn Ihr einen wohlwollenden Ruf bei den Wächtern der Sande erlangt habt.‡시간의 중재자에 우호적 평판을 얻은 다음 시간의 동굴에 있는 소리도르미에게 영원의 고리를 가져가야 합니다.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Devuelve tu sortija de eternidad a Soridormi en las Cavernas del Tiempo después de alcanzar la reputación de honorable ante La Escama de las Arenas.‡Apportez votre Bague d\'éternité à Soridormi, aux Grottes du temps, après être <devenu Honoré/devenue Honorée> auprès de la Balance des sables.‡当你在流沙之鳞中的声望达到尊敬后，将永恒之戒交给时空之穴的索莉多米。‡',
  }
},
[10465] = {
  {
    'Voto do restaurador‡Обет целителя‡Das Gelöbnis des Bewahrers‡구원자의 맹세‡La promesa del restaurador‡La promesa del restaurador‡Le vœu du guérisseur‡治愈者的誓约‡',
