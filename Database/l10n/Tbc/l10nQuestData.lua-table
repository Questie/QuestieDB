},
[5672] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Elune‡艾露恩的赐福‡',
    nil,
    '‡Посвятив себя служению Элуне и нашему народу, ты достигла такого положения, которое не всякому из нас доступно. По традиции за великую твою преданность тебя полагается обучить более могучим способностям. Согласна ли ты?‡Indem Ihr Euch Elune und unserem Volk widmet, habt Ihr einen Status erreicht, den nicht alle von uns erlangen können. Es ist Tradition, dass Euch nun noch größere Fähigkeiten für Eure Hingabe gelehrt werden sollen. Nehmt Ihr an?‡‡‡‡‡‡',
  }
},
[5673] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Elune‡艾露恩的赐福‡伊露恩的賜福',
    nil,
    'Fale com a Sacerdotisa Alathea em Darnassus.‡Поговорите в Дарнассе со жрицей Алатеей.‡Sprecht mit der Priesterin Alathea in Darnassus.‡다르나서스에 있는 여사제 알라시아와 대화하십시오.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Parler à la prêtresse Alathea à Darnassus.‡与达纳苏斯的女祭司阿兰希雅谈一谈。‡與達納蘇斯的女祭司阿蘭希雅談話。',
  }
},
[5674] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Elune‡艾露恩的赐福‡',
    nil,
    'Fale com a Sacerdotisa Alathea em Darnassus.‡Поговорите в Дарнассе со жрицей Алатеей.‡Sprecht mit der Priesterin Alathea in Darnassus.‡다르나서스에 있는 여사제 알라시아와 대화하십시오.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Parler à la prêtresse Alathea à Darnassus.‡与达纳苏斯的女祭司阿兰希雅谈一谈。‡',
  }
},
[5675] = {
  {
    'A graça de Eluna‡Благодать Элуны‡Elunes Anmut‡엘룬의 은총‡La Gracia de Elune‡La Gracia de Elune‡Grâce d\'Elune‡艾露恩的赐福‡',
    nil,
    'Fale com a Sacerdotisa Alathea em Darnassus.‡Поговорите в Дарнассе со жрицей Алатеей.‡Sprecht mit der Priesterin Alathea in Darnassus.‡다르나서스에 있는 여사제 알라시아와 대화하십시오.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Ve a Darnassus y habla con la sacerdotisa Alathea.‡Parler à la prêtresse Alathea à Darnassus.‡与达纳苏斯的女祭司阿兰希雅谈一谈。‡',
  }
},
[5676] = {
  {
    'Fluxo arcano‡Волшебное искажение‡Arkane Rückkopplung‡비전 역순환‡La reacción Arcana‡La reacción Arcana‡Retour d\'information de l\'Arcane‡奥术回馈‡',
    nil,
    '‡Чтобы защититься от тайной магии, которая является нашим основным врагом, мы должны знать некоторые заклинания.nnЯ научу тебя заклинаниям, которые помогут защитить себя и спутников от вредоносного воздействия тайной магии.‡Wir waren gezwungen, einige Magien zu lernen, um uns vor dem zu schützen, was üblicherweise unser stärkster Feind genannt wird: dem Arkanen.nnIch würde Euch einen Zauber beibringen, um Euch und Euren Kameraden bei der Verteidigung gegen diejenigen zu helfen, die diese Macht einsetzen.‡‡‡‡Nous avons été obligés d\'apprendre un peu de magie pour nous protéger de ce que nous appelons communément notre plus grand ennemi : l\'Arcane.nnJe vous enseignerai un sort qui vous aidera à vous protéger, vous et vos compagnons, contre ceux qui détiennent ce genre de pouvoir.‡‡',
  }
},
[5677] = {
  {
    'Fluxo Arcano‡Волшебное искажение‡Arkane Rückkopplung‡비전 역순환‡La reacción Arcana‡La reacción Arcana‡Retour d\'information de l\'Arcane‡奥术回馈‡',
    nil,
    'Fale com a Alta-sacerdotisa Laurena em Ventobravo.‡Поговорите с Верховной жрицей Лореной в Штормграде.‡Sprecht mit der Hohepriesterin Laurena in Sturmwind.‡스톰윈드에 있는 대여사제 로레나와 대화해야 합니다.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Parler à la grande prêtresse Laurena à Hurlevent.‡与暴风城的高阶牧师劳瑞娜谈一谈。‡',
  }
},
[5678] = {
  {
    '‡Волшебное искажение‡Arkane Rückkopplung‡‡La reacción Arcana‡‡Retour d\'information de l\'Arcane‡‡',
    nil,
    '‡Поговорите с Верховной жрицей Лореной в Штормграде.‡Sprecht mit der Hohepriesterin Laurena in Sturmwind.‡스톰윈드에 있는 대여사제 로레나와 대화해야 합니다.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Habla con la suma sacerdotisa Laurena en Ventormenta.‡Parler à la grande prêtresse Laurena à Hurlevent.‡与暴风城的高阶牧师劳瑞娜谈一谈。‡',
  }
},
[5679] = {
  {
    'Peste Devoradora‡Всепожирающая чума‡Verschlingende Seuche‡파멸의 역병‡Peste devoradora‡Peste devoradora‡Peste dévorante‡噬灵瘟疫‡',
    nil,
    '‡‡Ich würde Euch \'Verschlingende Seuche\' beibringen, wenn Ihr Euch bereit dazu fühlt, <Name>. Dieser Spruch ist nicht gerade von kleiner Macht und wird Euch in den kommenden Schlachten helfen. Übt damit - es wird später Prüfungen dazu geben.‡‡‡‡Si vous le désirez, je peux vous apprendre la Peste dévorante, <nom>. Un sort puissant, utile dans vos prochains combats. Entraînez-vous, vous serez mise à l\'épreuve plus tard.‡‡',
  }
},
[5680] = {
  {
    'Guarda Sombria‡Страж Тьмы‡Schattenwache‡어둠의 수호‡Guardia de las Sombras‡Guardia de las Sombras‡Garde des ténèbres‡暗影守卫‡暗影守衛',
    nil,
    '‡Время обряда уже близко. Теперь я научу тебя заклинанию, которое очень пригодится тебе в битвах с врагами.‡Eure Riten werden bald kommen. Fürs Erste lehre ich Euch einen Zauber, der Euch von großem Nutzen sein wird, wenn Ihr mit Euren Feinden kämpft.‡‡‡‡Vos rites arriveront bien assez tôt. Pour l\'instant je vais vous enseigner un sort qui vous sera très utile pendant les combats.‡‡',
  }
},
[5713] = {
  {
    'Tiro e queda‡Каждый выстрел – в цель‡Ein Schuss, ein Treffer‡백발백중‡Un tiro. Un muerto.‡Un disparo, una baja‡Un tir. Un tué.‡一击必杀‡一擊必殺',
    nil,
    'Proteja a Sentinela Aynasha. Em seguida, fale com Onaeya no Entreposto de Maestra, que fica no Vale Gris.‡Защитите жизнь часового Айнаши, а потом поговорите с Ойнеей на Заставе Мейстры в Ясеневом лесу.‡Schützt die Schildwache Aynasha und sprecht dann mit Onaeya bei Maestras Posten im Eschental.‡파수꾼 아이나샤를 보호한 다음 잿빛 골짜기의 마에스트라 주둔지에 있는 오나에야에게 사고 소식을 알려 주어야 합니다.‡Protege a la centinela Aynasha y luego ve a Vallefresno, a la Atalaya de Maestra, y habla con Onaeya.‡Protege a la centinela Aynasha y luego ve a Vallefresno, a la Atalaya de Maestra, y habla con Onaeya.‡Protéger la Sentinelle Aynasha, puis parler à Onaeya au poste de Maestra, en Orneval.‡保护哨兵阿娜莎，然后向灰谷迈斯特拉岗哨的奥奈雅报告。‡保護哨兵阿娜莎，然後向梣谷邁斯特拉崗哨的奧奈雅報告。',
  }
},
[5721] = {
  {
    'A batalha pela Vila das Flechas‡Битва при Дарроушире‡Die Schlacht um Darroheim‡다로우샤이어 전투‡La Batalla de Villa Darrow‡La Batalla de Villa Darrow‡La bataille de Comté-de-Darrow‡达隆郡的战斗‡達隆郡的戰鬥',
    nil,
    'Coloque o Saco de Relíquias na praça da Vila das Flechas.nnImpeça que Davil Luminoso morra antes de Horgus.nnImpeça que o Capitão Trilharrubra morra antes que Trilharrubra, o Corrompido, surja.nnDerrote Trilharrubra, o Corrompido.nnFale com o espírito de Josefo Trilharrubra quando ele aparecer na praça, depois fale com Pâmela na casa dela.‡Положите сверток с реликвиями на городскую площадь Дарроушира.nnПредотвратите смерть Дейвила Яркосвета от рук Хоргуса.nnНе допустите смерти капитана Редпата до появления Редпата Падшего. nnУбейте Редпата Падшего. nnПоговорите с духом Джозефа Редпата, когда он вновь появится на городской площади, затем отправляйтесь к Памеле и поговорите с ней.‡Legt das Reliktbündel auf den Marktplatz von Darroheim.nnVerhindert Davil Lichterscheins Tod, bis Horgus stirbt.nnVerhindert Hauptmann Rotpfads Tod, bis Rotpfad der Verderbte erscheint.nnBesiegt Rotpfad den Verderbten.nnSprecht mit dem Geist von Joseph Rotpfad, sobald er auf dem Marktplatz erscheint, und sprecht dann mit Pamela in ihrem Zuhause.‡다로우샤이어 마을 광장에 유물 더미를 가져다 놓아야 합니다.nn호르구스보다 다빌 라이트파이어가 먼저 죽지 않도록 다빌을 보호해야 합니다.nn레드패스는 오염되기 전까지 처치하면 안 됩니다.nn레드패스가 오염되면 처치해야 합니다.nn마을 광장에 조셉 레드패스의 영혼이 나타나면 대화를 나눈 후 집에 있는 파멜라와 대화를 나누십시오.‡Coloca el Fardo de reliquias en la plaza de Villa Darrow.nnImpide que Davil Fuegoluz muera antes que Horgus.nnImpide que el capitán Rutagrana muera hasta que aparezca Rutagrana el Corrompido.nnDerrota a Rutagrana el Corrompido.nnHabla con el espíritu de Joseph Rutagrana cuando aparezca en la Plaza de la Ciudad y luego habla con Pamela en su casa.‡Coloca el fardo de reliquias en la plaza de Villa Darrow.|nImpide que Davil Fuegoluz muera antes que Horgus.|nImpide que el capitán Rutagrana muera hasta que aparezca Rutagrana el Corrompido.|nDerrota a Rutagrana el Corrompido.|nHabla con el espíritu de Joseph Rutagrana cuando aparezca en la Plaza de la Ciudad y luego habla con Pamela en su casa.‡Placer la paquet de reliques sur la place centrale de Comté-de-Darrow.nnEmpêcher la mort de Davil Lumefeu, jusqu\'à la mort de Horgus.nnEmpêcher la mort du capitaine Senterouge, jusqu\'à ce que Senterouge le Corrompu apparaisse.nnVaincre Senterouge le Corrompu.nnParler à l\'esprit de Joseph Senterouge, quand il apparaîtra sur la place centrale, puis parler à Pamela, dans sa maison.‡将遗物包裹放在达隆郡的广场中。nn在霍古斯死亡之前，达维必须存活。nn在雷德帕斯队长堕落之前保证他存活。nn击败堕落的雷德帕斯。nn当约瑟夫·雷德帕斯出现在广场中时，与他的灵魂进行交谈，然后回到帕米拉的家中去找帕米拉。‡將聖物包裹放在達隆郡的廣場中。|n在霍古斯死亡之前，達維必須存活。|n在雷德帕斯隊長墮落之前保證他存活。|n擊敗墮落的雷德帕斯。|n當約瑟夫·雷德帕斯出現在廣場中時，與他的靈魂進行交談，然後回到帕米拉的家中去找帕米拉。',
  }
},
[5722] = {
  {
    'Em busca da algibeira perdida‡В поисках потерянного ранца‡Die Suche nach dem verloren gegangenen Ranzen‡잃어버린 가방 찾기‡Buscando la cartera perdida‡Buscando la cartera perdida‡À la recherche de la sacoche perdue‡寻找背包‡尋找背包',
    nil,
    'Investigue as Cavernas Ígneas em busca do corpo de Mauren Temível Totem e procure quaisquer itens de interesse.‡Обыщите Огненную пропасть в поисках тела Маура Зловещего Тотема и найдите все необычные предметы.‡Sucht im Flammenschlund nach Maur Grimmtotems Leiche und durchsucht sie nach interessanten Gegenständen.‡성난불길 협곡에서 마우르 그림토템의 시체를 찾아 도움이 될 만한 것들을 찾아야 합니다.‡Inspecciona la Sima Ígnea en busca del cuerpo de Maur Tótem Siniestro y comprueba si porta algún objeto de interés.‡Inspecciona la Sima Ígnea en busca del cuerpo de Maur Tótem Siniestro y comprueba si porta algún objeto de interés.‡Fouiller le Gouffre de Ragefeu pour trouver le cadavre de Maur Totem-sinistre et tout élément intéressant.‡在怒焰裂谷搜寻玛尔·恐怖图腾的尸体以及他留下的东西。‡在怒焰裂谷搜尋瑪爾·恐怖圖騰的屍體以及他留下的東西。',
  }
},
[5723] = {
  {
    'Testando a força do inimigo‡Испытание силы врага‡Die Kraft des Feindes wird auf die Probe gestellt‡성난불길 협곡의 트로그‡Midiendo fuerzas con el enemigo‡Midiendo fuerzas con el enemigo‡Tester la force de l\'ennemi‡试探敌人‡試探敵人',
    nil,
    'Procure as Cavernas Ígneas em Orgrimmar e mate 8 Troggs Iraflama e 8 Xamãs Iraflama, depois fale novamente com Rahauro no Penhasco do Trovão.‡Найдите в Оргриммаре Огненную пропасть, убейте 8 троггов и 8 шаманов Огненной пропасти и возвращайтесь к Рахауро в Громовой Утес.‡Sucht in Orgrimmar nach dem Flammenschlund, tötet dann 8 Flammenschlundtroggs und 8 Schamanen der Flammenschlundtroggs und kehrt anschließend zu Rahauro in Donnerfels zurück.‡오그리마에 있는 성난불길 협곡을 찾아 성난불길 트로그 8마리와 성난불길일족 주술사 8마리를 처치하고 썬더 블러프에 있는 라하우로에게 돌아가야 합니다.‡Localiza la Sima Ígnea en Orgrimmar y después mata a 8 troggs Furia Ardiente y 8 chamanes Furia Ardiente y después ve a ver de nuevo a Rahauro a Cima del Trueno.‡Localiza la Sima Ígnea en Orgrimmar y después mata a 8 troggs Furia Ardiente y 8 chamanes Furia Ardiente y después ve a ver de nuevo a Rahauro a Cima del Trueno.‡Chercher le gouffre de Ragefeu dans Orgrimmar, puis tuer 8 Troggs Ragefeu et 8 Chamans Ragefeu avant de revenir auprès de Rahauro aux Pitons du Tonnerre.‡在奥格瑞玛找到怒焰裂谷，杀掉8个怒焰穴居人和8个怒焰萨满祭司，然后向雷霆崖的拉哈罗复命。‡在奧格瑪找到怒焰裂谷，殺掉8個怒焰穴居人和8個怒焰薩滿，然後向雷霆崖的拉哈羅覆命。',
  }
},
[5724] = {
  {
    'Devolvendo a algibeira perdida‡Возвращение потерянной сумки‡Wiederbeschaffung des verloren gegangenen Ranzens‡잃어버린 가방 돌려주기‡La vuelta de la cartera perdida‡La vuelta de la cartera perdida‡Rapporter la sacoche perdue‡归还背包‡歸還背包',
    nil,
    'Leve a Algibeira do Temível Totem para Rahauro no Penhasco do Trovão.‡Отнесите сумку Маура Зловещего Тотема Рахауро в Громовой Утес.‡Bringt den Grimmtotemranzen zu Rahauro nach Donnerfels.‡썬더 블러프에 있는 라하우로에게 그림토템 가방을 가져가야 합니다.‡Lleva la cartera de Tótem Siniestro hasta Rahauro, en Cima del Trueno.‡Lleva la cartera de Tótem Siniestro hasta Rahauro, en Cima del Trueno.‡Apporter la Sacoche du Totem-sinistre à Rahauro aux Pitons du Tonnerre.‡将恐怖图腾背包交给雷霆崖的拉哈罗。‡將恐怖圖騰背包交給雷霆崖的拉哈羅。',
  }
},
[5725] = {
  {
    'O poder de destruir...‡Силы разрушения...‡Die Macht der Zerstörung...‡파괴해야 할 힘‡Poder destructivo‡Poder destructivo‡Le pouvoir de détruire...‡毁灭之力‡毀滅之力',
    nil,
    'Leve os livros "Feitiços da Sombra" e "Encantamentos do Éter" para Varimatras na Cidade Baixa.‡Принесите книги "Заклинания Тьмы" и "Заклятия Пустоты" Вариматрасу в Подгород.‡Bringt die Bücher \'Schattenzauber\' und \'Zauberformeln aus dem Nether\' zu Varimathras nach Unterstadt.‡언더시티에 있는 바리마트라스에게 어둠의 주문서와 황천의 마법서를 가져가야 합니다.‡Llévale los libros Hechizos de las Sombras y Encantamientos desde el infierno a Varimathras, que está en Entrañas.‡Llévale los libros Hechizos de las Sombras y Encantamientos desde el infierno a Varimathras, que está en Entrañas.‡Apporter les livres de Sorts des Ombres et d\'Incantations du Néant à Varimathras, à Fossoyeuse.‡将《暗影法术研究》和《扭曲虚空的魔法》这两本书交给幽暗城的瓦里玛萨斯。‡將《暗影法術研究》和《扭曲虛空的魔法》這兩本書交給幽暗城的瓦里瑪薩斯。',
  }
},
[5726] = {
  {
    'Inimigos ocultos‡Тайные враги‡Verborgene Feinde‡내부의 배신자‡Enemigos ocultos‡Enemigos ocultos‡Ennemis cachés‡隐藏的敌人‡隱藏的敵人',
    nil,
    'Leve uma Insígnia do Tenente para Thrall em Orgrimmar.‡Принесите лейтенантский знак отличия Траллу в Оргриммар.‡Bringt das Insigne eines Offiziers zu Thrall nach Orgrimmar.‡오그리마에 있는 스랄에게 부관의 휘장을 가져가야 합니다.‡Lleva una insignia de Teniente a Thrall a Orgrimmar.‡Lleva una insignia de Teniente a Thrall a Orgrimmar.‡Apporter un Insigne de lieutenant à Thrall à Orgrimmar.‡将军官的徽章交给奥格瑞玛的萨尔。‡將軍官的徽記交給奧格瑪的索爾。',
  }
},
[5727] = {
  {
    'Inimigos ocultos‡Тайные враги‡Verborgene Feinde‡내부의 배신자‡Enemigos ocultos‡Enemigos ocultos‡Ennemis cachés‡隐藏的敌人‡隱藏的敵人',
    nil,
    'Leve a Insígnia do Tenente para Neeru Cortafogo e fale com ele. Avalie se ele acredita que você é um membro da Lâmina Ardente e, depois, fale novamente com Thrall em Orgrimmar.‡Отнесите лейтенантский знак отличия Ниру Огненному Клинку. Убедите его в своей преданности клану Пылающего Клинка. Вернитесь к Траллу в Оргриммар.‡Bringt Neeru Feuerklinge das Insigne des Offiziers und sprecht mit ihm. Seht, ob er Euch glaubt, dass Ihr ein Mitglied der Brennenden Klinge seid, und kehrt dann zu Thrall nach Orgrimmar zurück.‡부관의 휘장을 네루 파이어블레이드에게 가져간 다음 대화를 해야 합니다. 네루 파이어블레이드가 당신을 불타는 칼날단의 일원으로 믿고 있는지 확인한 다음 오그리마에 있는 스랄에게 돌아가야 합니다.‡Lleva la insignia de Teniente a Neeru Hojafuego. Averigua si cree que eres miembro de Filo Ardiente; luego ve a ver a Thrall a Orgrimmar.‡Lleva la insignia de Teniente a Neeru Hojafuego. Averigua si cree que eres miembro de Filo Ardiente; luego ve a ver a Thrall a Orgrimmar.‡Apporter l\'Insigne du Lieutenant à Neeru Lamefeu et lui parler. Essayer de déterminer s\'il vous croit membre de la Lame ardente puis retourner voir Thrall à Orgrimmar.‡将军官的徽章交给尼尔鲁·火刃并与他谈一谈，看看他是否相信你是火刃氏族中的一员，然后回到奥格瑞玛的萨尔那里。‡將軍官的徽記交給尼爾魯·火刃並與他談話，看看他是否相信你是火刃氏族中的一員，然後回到奧格瑪的索爾那裡。',
  }
},
[5728] = {
  {
    'Inimigos ocultos‡Тайные враги‡Verborgene Feinde‡내부의 배신자‡Enemigos ocultos‡Enemigos ocultos‡Ennemis cachés‡隐藏的敌人‡隱藏的敵人',
    nil,
    'Mate Bazzalan e Jergosh, o Invocador e fale novamente com Thrall em Orgrimmar.‡Убейте Баззалана и Жергоша Призывателя Духов и вернитесь в Оргриммар к Траллу.‡Tötet Bazzalan und Jergosh den Herbeirufer, bevor Ihr zu Thrall nach Orgrimmar zurückkehrt.‡바잘란과 기원사 제로쉬를 제거한 다음 오그리마에 있는 스랄에게 돌아가야 합니다.‡Mata a Bazzalan y a Jergosh el Convocador y ve a ver a Thrall a Orgrimmar.‡Mata a Bazzalan y a Jergosh el Convocador y ve a ver a Thrall a Orgrimmar.‡Tuer Bazzalan et Jergosh l\'Invocateur avant de retourner voir Thrall à Orgrimmar.‡杀死巴扎兰和祈求者耶戈什，然后回到奥格瑞玛的萨尔那里。‡殺死巴札蘭和『塑能師』耶戈什，然後回到奧格瑪的索爾那裡。',
  }
},
[5729] = {
  {
    'Inimigos ocultos‡Тайные враги‡Verborgene Feinde‡내부의 배신자‡Enemigos ocultos‡Enemigos ocultos‡Ennemis cachés‡隐藏的敌人‡',
    nil,
    'Fale com Neeru Cortafogo em Orgrimmar.‡Поговорите с Нииру Огненным Клинком в Оргриммаре.‡Sprecht mit Neeru Feuerklinge in Orgrimmar.‡오그리마에 있는 네루 파이어블레이드와 대화해야 합니다.‡Habla con Neeru Hojafuego en Orgrimmar.‡Habla con Neeru Hojafuego en Orgrimmar.‡Parler à Neeru Lamefeu à Orgrimmar.‡与奥格瑞玛的尼尔鲁·火刃谈一谈。‡',
  }
},
[5730] = {
  {
    'Inimigos ocultos‡Тайные враги‡Verborgene Feinde‡내부의 배신자‡Enemigos ocultos‡Enemigos ocultos‡Ennemis cachés‡隐藏的敌人‡',
    nil,
    'Fale com Thrall em Orgrimmar e conte a ele o que você descobriu.‡Поговорите с Траллом в Оргриммаре.‡Sprecht in Orgrimmar mit Thrall und berichtet ihm, was Ihr erfahren habt.‡오그리마에 있는 스랄에게 알아낸 것을 보고해야 합니다.‡Habla con Thrall en Orgrimmar y cuéntale lo que has averiguado.‡Habla con Thrall en Orgrimmar y cuéntale lo que has averiguado.‡Parler à Thrall à Orgrimmar et lui dire ce que vous avez appris.‡与奥格瑞玛的萨尔谈一谈，告诉他你了解到的东西。‡',
  }
},
[5741] = {
  {
    'O Cetro de Luz‡Скипетр Света‡Szepter des Lichts‡빛의 홀‡El Cetro de Luz‡El Cetro de Luz‡Sceptre de lumière‡圣光节杖‡聖光權杖',
    nil,
    'Pegue o Cetro de Luz e devolva-o para Azore Albamorte na torre de Ethel Rethor.‡Отыщите Скипетр Света и принесите его Азору Альдаморту в башню Этель-Ретор.‡Besorgt das Szepter des Lichts und bringt es zurück zu Azore Aldamort am Turm in Ethel Rethor.‡빛의 홀을 얻은 후 에텔 레소르의 탑에 있는 아조레 알다모트에게 돌아가야 합니다.‡Consigue el Cetro de Luz y llévaselo a Azore Aldamort a la torre de Ethel Rethor.|n‡Consigue el Cetro de Luz y llévaselo a Azore Aldamort a la torre de Ethel Rethor.‡Prendre le Sceptre de lumière et le rapporter à Azore Aldamort, dans la tour d\'Ethel Rethor.‡拿到圣光节杖，并将它交给艾瑟雷索塔里的阿佐尔·奥达蒙特。‡拿到聖光權杖，並將它交給艾瑟雷索高塔的阿佐爾·奧達蒙特。',
  }
},
[5742] = {
  {
    'Redenção‡Искупление‡Erlösung‡구원‡Redención‡Redención‡Rédemption‡救赎‡救贖',
    nil,
    'Escute o que Tirion Fordring tem a dizer.‡Выслушайте Тириона Фордринга.‡Hört Euch an, was Tirion Fordring zu sagen hat.‡티리온 폴드링이 하려고 하는 말이 무엇인지 들어야 합니다.‡Escucha lo que Tirion Vadín tiene que contarte.‡Escucha lo que Tirion Vadín tiene que contarte.‡Écouter ce que Tirion Fordring a à dire.‡听听提里奥·弗丁要说什么。‡聽聽提里恩·弗丁要說什麼。',
  }
},
[5761] = {
  {
    'Mate a besta‡Убить тварь‡Vernichtung der Bestie‡야수 처단‡Matar a la bestia‡Matar a la bestia‡Tuer la bête‡饥饿者塔拉加曼‡饑餓者塔拉加曼',
    nil,
    'Entre nas Cavernas Ígneas e mate Taragaman, o Famélico, depois leve o coração dele para Neeru Cortafogo em Orgrimmar.‡Спуститесь в Огненную пропасть, убейте Тарагамана Ненасытного и принесите его сердце Нииру Огненному Клинку в Оргриммаре.‡Begebt Euch in den Flammenschlund und erschlagt Taragaman den Hungerleider. Bringt anschließend dessen Herz zu Neeru Feuerklinge nach Orgrimmar.‡성난불길 협곡으로 가서 욕망의 타라가만을 제거한 다음 그의 심장을 오그리마에 있는 네루 파이어블레이드에게 가져가야 합니다.‡Ve a la Sima Ígnea, mata a Taragaman el Hambriento y llévale su corazón a Neeru Hojafuego a Orgrimmar.‡Ve a la Sima Ígnea, mata a Taragaman el Hambriento y llévale su corazón a Neeru Hojafuego a Orgrimmar.‡Pénétrer dans le Gouffre de Ragefeu et tuer Taragaman l\'Affameur, puis rapporter son coeur à Neeru Lamefeu à Orgrimmar.‡进入怒焰裂谷，杀死饥饿者塔拉加曼，然后把他的心脏交给奥格瑞玛的尼尔鲁·火刃。‡進入怒焰裂谷，殺死『飢餓者』塔拉加曼，然後把他的心臟交給奧格瑪的尼爾魯·火刃。',
  }
},
[5762] = {
  {
    'Rosarães Guima Jr.‡Хеминг Эрнестуэй-младший‡Hemet Nesingwary Jr.‡헤멧 네싱워리 2세‡Hemet Nesingwary Jr.‡Hemet Nesingwary Jr.‡Hemet Nesingwary‡赫米特·奈辛瓦里二世‡小赫米特·奈辛瓦里',
    nil,
    'Leve o Caixote de Kravel para Rosarães Guima Jr. na Selva do Espinhaço.‡Отнесите ящик Крейвела Хемингу Эрнестуэю младшему в Тернистую долину.‡Bringt Kravels Kiste zu Hemet Nesingwary Jr. ins Schlingendorntal.‡가시덤불 골짜기에 있는 헤멧 네싱워리 2세에게 크레이블의 상자를 가져가야 합니다.‡Lleva el cajón de Kravel a Hemet Nesingwary Jr. a Tuercespina.‡Lleva el cajón de Kravel a Hemet Nesingwary Jr. a Tuercespina.‡Apporter la Caisse de Kravel à Hemet Nesingwary Jr. à Strangleronce.‡将克拉维尔的箱子送到荆棘谷的赫米特·奈辛瓦里二世那里。‡將克拉維爾的木箱送到荊棘谷給小赫米特·奈辛瓦里。',
  }
},
[5763] = {
  {
    'Caçada na Selva do Espinhaço‡Охота в Тернистой долине‡Jagd im Schlingendorntal‡가시덤불 골짜기의 사냥꾼‡La caza en Tuercespina‡La caza en Tuercespina‡Chasse à Strangleronce‡荆棘谷狩猎‡荊棘谷狩獵',
    nil,
    'Leve o Chifre de Kodo de Roon para Rosarães Guima Jr. na Selva do Espinhaço.‡Отнесите рог кодо, принадлежащий Руну, Хемингу Эрнестуэю младшему в Тернистую долину.‡Bringt Roons Kodohorn zu Hemet Nesingwary Jr. ins Schlingendorntal.‡가시덤불 골짜기에 있는 헤멧 네싱워리 2세에게 룬의 코도 뿔을 가져가야 합니다.‡Lleva el cuerno de kodo de Roon a Hemet Nesingwary Jr. a Tuercespina.‡Lleva el cuerno de kodo de Roon a Hemet Nesingwary Jr. a Tuercespina.‡Apporter la Corne de kodo de Roon à Hemet Nesingwary Jr. à Strangleronce.‡将鲁恩的科多兽角送到荆棘谷的赫米特·奈辛瓦里二世那里。‡將魯恩的科多獸角送到荊棘谷的小赫米特·奈辛瓦里那裡。',
  }
},
[5781] = {
  {
    'Elixir de memórias esquecidas‡Символ ушедших дней‡Von vergessenen Erinnerungen‡잃어버린 기억들‡De recuerdos olvidados‡De recuerdos olvidados‡Aux mémoires perdues‡遗忘的记忆‡遺忘的記憶',
    nil,
    'Viaje para a Chácara Secreta, no extremo sul das Terras Pestilentas Orientais, e recupere o Martelo de Taelan. Fale novamente com Tirion Fordring ao completar seu objetivo.‡Отправляйтесь в Крипту – в самой южной части Восточных Чумных земель – и добудьте молот Телана. Отнесите его Тириону Фордрингу.‡Begebt Euch zum Tiefgewölbe im südlichsten Abschnitt der östlichen Pestländer und sucht nach Taelans Hammer. Kehrt zu Tirion Fordring zurück, sobald Ihr Eure Mission abgeschlossen habt.‡동부 역병지대의 최남쪽에 있는 지하 납골당으로 가서 탤런의 망치를 되찾은 후 티리온 폴드링에게 돌아가서 임무를 완수해야 합니다.‡Viaja a La Subgranja, en la sección más meridional de las Tierras de la Peste del Este, y recupera el Martillo de Taelan. Cuando hayas cumplido tu objetivo regresa con Tirion Vadín.‡Viaja a La Subgranja, en la sección más meridional de las Tierras de la Peste del Este, y recupera el Martillo de Taelan. Cuando hayas cumplido tu objetivo regresa con Tirion Vadín.‡Aller au caveau de Zaeldarr - situé dans la section la plus au sud des Maleterres de l\'est - et récupérer le Marteau de Taelan. Retourner auprès de Tirion Fordring après avoir accompli la mission.‡到东瘟疫之地最南端的墓室去找回泰兰之锤。完成目标之后，返回提里奥-弗丁那里。‡到東瘟疫之地最南端的墓室去找回泰蘭之錘。完成目標之後，返回提里恩·弗丁那裡。',
  }
},
[5801] = {
  {
    'A forja do Pico Penacho de Fogo‡Кузня Пламенного хребта‡Feuersäulen geschmiedet‡불기둥 용광로‡La forja del Penacho en Llamas‡La forja del Penacho en Llamas‡Forgée dans la Fournaise‡火羽山‡火羽山',
    nil,
    'Leve o Molde de Chave-mestra e 2 Barras de Tório para o topo do Pico Penacho de Fogo, na Cratera Un\'Goro. Use o Molde de Chave-mestra no lago de lava para forjar a Chave-mestra Inacabada.nnLeve a Chave-mestra Inacabada para o Alquimista Arvignon no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Отнесите форму для отливки отмычек и 2 ториевых слитка на вершину вулкана Огненного Венца в кратере Ун\'Горо. Окуните форму для отливки отмычки в озеро лавы. Получится недоделанная отмычка.nnОтнесите недоделанную отмычку алхимику Арбингтону на берег Промозглого Ветра в Западные Чумные земли.‡Bringt die Skelettschlüsselform und 2 Barren Thorium zur Spitze des Feuersäulengrats im Krater von Un\'Goro. Benutzt die Skelettschlüsselform am Lavasee, um den unvollendeten Skelettschlüssel zu schmieden.nnBringt den unvollendeten Skelettschlüssel dann zum Alchimisten Arbington an der Zugwindspitze in den westlichen Pestländern.‡운고로 분화구에 있는 불기둥 마루의 꼭대기로 해골 열쇠 거푸집과 토륨 주괴 2개를 가져가야 합니다. 용암의 강에서 해골 열쇠 거푸집을 이용해서 불완전한 해골 열쇠를 만들어야 합니다.nn불완전한 해골 열쇠를 서부 역병지대의 서리바람 거점에 있는 연금술사 알빙턴에게 가져가야 합니다.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.nnLlévale la llave esqueleto sin terminar al alquimista Arbington al Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.|nLlévale la llave esqueleto sin terminar al alquimista Arbington al Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Emporter le Moule de Clé squelette et 2 Barres de thorium au sommet de la crête de la Fournaise dans le cratère d’Un\'Goro. Utiliser le Moule de Clé squelette au lac de lave pour forger la Clé squelette inachevée.nnApporter la Clé squelette inachevée à l’alchimiste Arbington à la pointe du Noroît, dans les Maleterres de l’ouest.‡把骷髅钥匙模具和2块瑟银锭带到安戈洛尔环形山地区的火羽山顶部。在熔岩湖旁使用骷髅钥匙模具，铸造出一把未完工的骷髅钥匙。nn把未完工的骷髅钥匙交给西瘟疫之地冰风岗的化学家阿尔比顿。‡把骷髏鑰匙模具和2塊瑟銀錠帶到安戈洛環形山地區的火羽山頂部。在熔岩湖旁使用骷髏鑰匙模具，鑄造出一把未完工的骷髏鑰匙。|n把未完工的骷髏鑰匙交給西瘟疫之地冰風崗的鍊金師阿爾比頓。',
  }
},
[5802] = {
  {
    'A forja do Pico Penacho de Fogo‡Кузня Пламенного хребта‡Feuersäulen geschmiedet‡불기둥 용광로‡La forja del Penacho en Llamas‡La forja del Penacho en Llamas‡Forgée dans la Fournaise‡火羽山‡火羽山',
    nil,
    'Leve o Molde de Chave-mestra e 2 Barras de Tório para o topo do Pico Penacho de Fogo, na Cratera Un\'Goro. Use o Molde de Chave-mestra no lago de lava para forjar a Chave-mestra Inacabada.nnLeve a Chave-mestra Inacabada para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Отнесите форму для отливки отмычек и 2 ториевых слитка на вершину вулкана Огненного Венца в кратере Ун\'Горо. Окуните форму для отливки отмычки в озеро лавы. Получится недоделанная отмычка.nnОтнесите недоделанную отмычку аптекарю Дитерсу в Бастион, что в Западных Чумных землях.‡Bringt die Skelettschlüsselform und 2 Barren Thorium zur Spitze des Feuersäulengrats im Krater von Un\'Goro. Benutzt die Skelettschlüsselform am Lavasee, um den unvollendeten Skelettschlüssel zu schmieden.nnBringt den unvollendeten Skelettschlüssel zu Apotheker Zitters im Bollwerk, westliche Pestländer.‡운고로 분화구에 있는 불기둥 마루 꼭대기로 해골 열쇠 거푸집과 토륨 주괴 2개를 가져가야 합니다. 용암의 강에서 해골 열쇠 거푸집으로 불완전한 해골 열쇠를 만들어야 합니다.nn불완전한 해골 열쇠를 서부 역병지대의 보루에 있는 연금술사 디더스에게 가져가야 합니다.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.nnLlévale la llave esqueleto sin terminar al boticario Dithers a El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva el molde para llave esqueleto y 2 barras de torio a la cima de la Cresta del Penacho en Llamas en el Cráter de Un\'Goro. Utiliza el molde para llave esqueleto en el lago de lava para forjar la llave esqueleto sin terminar.|nLlévale la llave esqueleto sin terminar al boticario Dithers a El Baluarte, en las Tierras de la Peste del Oeste.‡Prendre le moule de la Clé squelette et deux barres de thorium au sommet de la crête de la Fournaise dans le cratère d\'Un\'Goro. Se servir du moule de la Clé squelette pour forger la Clé squelette inachevée.nnApporter la Clé squelette inachevée à l\'Apothicaire Dithers à la Barricade, dans les Maleterres de l\'ouest.‡把骷髅钥匙模具和2块瑟银锭带到安戈洛尔环形山地区的火羽山顶部。在熔岩湖旁使用骷髅钥匙模具，铸造出一把未完工的骷髅钥匙。nn把未完工的骷髅钥匙交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡把骷髏鑰匙模具和2塊瑟銀錠帶到安戈洛環形山地區的火羽山頂部。在熔岩湖旁使用骷髏鑰匙模具，鑄造出一把未完工的骷髏鑰匙。|n把未完工的骷髏鑰匙交給西瘟疫之地亡靈壁壘的藥劑師迪瑟斯。',
  }
},
[5803] = {
  {
    'O escaravelho de Araj‡Скарабей Араджи‡Arajs Skarabäus‡아라즈의 스카라베‡El escarabeo de Araj‡El escarabeo de Araj‡Le Scarabée d\'Araj‡阿拉基的圣甲虫‡阿拉基的聖甲蟲',
    nil,
    'Destrua Araj, o Evocador e leve o Escaravelho de Araj para o Alquimista Arvignon no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Убейте Аража Призывателя отнесите его скарабея алхимику Арбингтону на Берег Промозглого Ветра, что в Западных Чумных землях.‡Zerstört Araj den Beschwörer und bringt Arajs Skarabäus zum Alchimisten Arbington an der Zugwindspitze in den westlichen Pestländern.‡소환사 아라즈를 처치하고 아라즈의 스카라베를 서부 역병지대의 서리바람 거점에 있는 연금술사 알빙턴에게 가져가야 합니다.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al alquimista Arbington en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al alquimista Arbington en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Vaincre Araj l\'Invocateur et apporter le Scarabée d\'Araj à l’alchimiste Arbington à la pointe du Noroît, dans les Maleterres de l’ouest.‡杀掉召唤者阿拉基，并将阿拉基的圣甲虫交给西瘟疫之地冰风岗的化学家阿尔比顿。‡殺掉『召喚者』阿拉基，並將阿拉基的聖甲蟲交給西瘟疫之地冰風崗的鍊金師阿爾比頓。',
  }
},
[5804] = {
  {
    'O escaravelho de Araj‡Скарабей Араджи‡Arajs Skarabäus‡아라즈의 스카라베‡El escarabeo de Araj‡El escarabeo de Araj‡Le Scarabée d\'Araj‡阿拉基的圣甲虫‡阿拉基的聖甲蟲',
    nil,
    'Destrua Araj, o Evocador e leve o Escaravelho de Araj para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Убейте Аража Призывателя и отнесите его скарабея аптекарю Дитерсу в Бастион, что в Западных Чумных землях.‡Vernichtet Araj den Beschwörer und bringt Arajs Skarabäus zum Apotheker Zitters im Bollwerk, in den westlichen Pestländern.‡소환사 아라즈를 처치하고 아라즈의 스카라베를 서부 역병지대에 보루에 있는 연금술사 디더스에게 돌아가야 합니다.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Destruye a Araj el Invocador y lleva el Escarabeo de Araj al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Vaincre Araj l\'Invocateur et apporter le Scarabée d\'Araj à l\'apothicaire Dithers à la Barricade, dans les Maleterres de l\'ouest.‡杀掉召唤者阿拉基，并将阿拉基的圣甲虫交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡殺掉『召喚者』阿拉基，並將阿拉基的聖甲蟲交給西瘟疫之地亡靈壁壘的藥劑師迪瑟斯。',
  }
},
[5805] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Bienvenido!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Leve o Vale-brinde de Vila d\'Ouro para Melissa Calmafonte em Vila d\'Ouro.‡Передайте подарочный сертификат Златоземья Мериссе Стилвелл.‡Bringt Merissa Stillbrunn in Goldhain den Goldhaingeschenkgutschein.‡메리사 스틸웰에게 골드샤이어 선물교환권을 가져가야 합니다.‡Lleva el vale regalo de Villadorada a Merissa Fontana en Villadorada.‡Lleva el vale regalo de Villadorada a Merissa Fontana en Villadorada.‡Apporter le Bon-cadeau de Comté-de-l\'or à Merissa Morpuits, à Comté-de-l\'or.‡将北郡礼品券交给梅里萨·斯蒂维尔。‡將閃金鎮禮品券交給閃金鎮的梅里薩·斯蒂維爾。',
  }
},
[5821] = {
  {
    'Procura-se guarda-costas‡Наемный телохранитель‡Leibwache zu mieten‡경호원 고용‡Guardaespaldas de alquiler‡Guardaespaldas de alquiler‡Garde du corps à recruter‡雇佣保镖‡雇傭保鏢',
    nil,
    'Escolte a Caravana Gizelton pela aldeia dos Centauros Kolkar. Fale com o Smid no Acampamento do Rabiscafuso para receber a recompensa.‡Охраняйте караван Гизлтона на пути мимо деревни кентавров из племени Колкар. О награде поговорите со Смидом в Лагере Заржавня.‡Bringt Gizeltons Karawane am Dorf der Kolkarzentauren vorbei. Sprecht in Schraubenbuddels Lager mit Smeed, um Eure Belohnung zu erhalten.‡콜카르 켄타우로스 마을을 지나가는 기젤톤 대상단을 호위하고 스크래블스크류의 야영지에 있는 스미드와 대화하여 보상을 받아야 합니다.‡Escolta la caravana Gizelton a través del poblado de los centauros Kolkar. Habla con Smeed en el Campamento de los Mezclatornillos para recibir tu recompensa.‡Escolta la caravana Gizelton a través del poblado de los centauros Kolkar. Habla con Smeed en el Campamento de los Mezclatornillos para recibir tu recompensa.‡Escorter la Caravane de Gizelton et l\'aider à passer le village des centaures Kolkar. Parler à Smeed, au camp de Fouillevis, pour toucher la récompense.‡护送基泽尔顿商队通过科卡尔半人马村，然后与瑟卡布斯库的营地中的斯米德谈话以领取你的奖赏。‡護送基澤爾頓商隊通過科卡爾半人馬村，然後與瑟卡布斯庫的營地中的斯米德談話以領取你的獎賞。',
  }
},
[5841] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Bienvenido!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Entregue o Vale-brinde de Kharanos para Yori Rachelmo, em Kharanos.‡Принести Йори Шлемолому подарочный сертификат Караноса.‡Bringt Yori Bruchhelm in Kharanos den Geschenkgutschein von Kharanos.‡카라노스에 있는 요리 크랙헬름에게 카라노스 선물교환권을 가져가야 합니다.‡Lleva el vale regalo de Kharanos a Yori Yelmopartido en Kharanos.‡Lleva el vale regalo de Kharanos a Yori Yelmopartido en Kharanos.‡Apporter le Bon-cadeau de Kharanos à Yori Craqueheaume, à Kharanos.‡将寒脊山谷礼品券交给尤里·碎盔。‡將卡拉諾斯禮品券交給卡拉諾斯的尤里·碎盔。',
  }
},
[5842] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Bienvenido!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Leve o Vale-brinde de Dolanaar para Orenthil Murmuréolo em Dolanaar.‡Отнесите подарочный серитификат Доланаара Орентилу Шепоту Ветра.‡Bringt Orenthil Wisperwind in Dolanaar den Geschenkgutschein von Dolanaar.‡돌라나르에 있는 오렌실 위스퍼윈드에게 돌라나르 선물교환권을 가져가야 합니다.‡Lleva el vale regalo de Dolanaar a Orenthil Susurravientos en Dolanaar.‡Lleva el vale regalo de Dolanaar a Orenthil Susurravientos en Dolanaar.‡Apporter le Bon-cadeau de Dolanaar à Orenthil Murmevent.‡将幽影谷礼品券交给奥雷希尔·语风。‡將多蘭納爾禮品券交給多蘭納爾的奧雷希爾·語風。',
  }
},
[5843] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Te damos la bienvenida!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Entregue o Vale-brinde de Monte Navalha para Magga no Monte Navalha.‡Передайте подарочный сертификат Колючего Холма Магге в Колючем Холме.‡Bringt Magga auf dem Klingenhügel den Geschenkgutschein des Klingenhügels.‡칼바위 언덕에 있는 마가에게 칼바위 언덕 선물 교환권을 가져가야 합니다.‡Lleva el vale regalo de Cerrotajo a Magga en Cerrotajo.‡Lleva el vale regalo de Cerrotajo a Magga en Cerrotajo.‡Apporter le Bon-cadeau de Tranchecolline à Magga.‡将试炼谷礼品券交给玛卡尔。‡將剃刀嶺禮品券交給剃刀嶺的瑪卡爾。',
  }
},
[5844] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Bienvenido!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Entregue o Vale-brinde da Aldeia Casco Sangrento para Vorn Vidente do Céu na Aldeia Casco Sangrento.‡Отнесите подарочный сертификат деревни Кровавого Копыта Ворну Небесному Провидцу.‡Bringt Vorn Himmelsdeuter im Dorf der Bluthufe den Geschenkgutschein der Bluthufe.‡블러드후프 마을에 있는 보른 스카이시어에게 블러드후프 마을 선물교환권을 가져가야 합니다.‡Lleva el vale regalo del Poblado Pezuña de Sangre a Vorn Videncielo en el Poblado Pezuña de Sangre.‡Lleva el vale regalo del Poblado Pezuña de Sangre a Vorn Vidente del Cielo en el Poblado Pezuña de Sangre.‡Apporter le Bon-cadeau de Sabot-de-sang à Vorn Oeil-des-cieux au village de Sabot-de-sang.‡将纳拉其营地礼品券交给沃恩·星眼。‡將血蹄村禮品券交給血蹄村的沃恩·星眼。',
  }
},
[5845] = {
  {
    'Da honra perdida‡Символ утраченной чести‡Von verlorener Ehre‡명예의 상징‡Del honor perdido‡Del honor perdido‡De l\'honneur perdu‡失落的荣耀‡失落的榮耀',
    nil,
    'Viaje para o Vilarejo do Norte, na região nordeste das Terras Pestilentas Orientais, e recupere o Símbolo da Honra Perdida. Fale novamente com Tirion Fordring ao completar seu objetivo.‡Отправляйтесь в Северный дол, что в северо-восточной части Восточных Чумных земель и найдите там символ утраченной чести. После этого вернитесь к Тириону Фордрингу.‡Reist ins Nordtal im nordöstlichsten Gebiet der östlichen Pestländer und sucht nach dem Symbol der verlorenen Ehre. Kehrt zu Tirion Fordring zurück, sobald Ihr Eure Mission abgeschlossen habt.‡동부 역병지대의 북동쪽에 있는 노스데일로 가서 실추된 명예의 상징을 되찾은 후 티리온 폴드링에게 돌아가서 임무를 완수해야 합니다.‡Viaja a Vallenorte, en la zona noreste de las Tierras de la Peste del Este, y recupera el Símbolo de Honor perdido. Cuando hayas cumplido tu objetivo regresa con Tirion Vadín.‡Viaja a Vallenorte, en la zona noreste de las Tierras de la Peste del Este, y recupera el Símbolo de Honor perdido. Cuando hayas cumplido tu objetivo regresa con Tirion Vadín.‡Se rendre à Valnord, dans la région nord-est des Maleterres de l\'est, et récupérer le Symbole de l\'honneur perdu. Revenir auprès de Tirion Fordring quand la tâche est accomplie.‡到东瘟疫之地东北部的北谷去，找到失落荣耀的象征。完成目标之后向提里奥·弗丁复命。‡到東瘟疫之地東北部的北谷去，找到失落榮耀的象徵。完成目標之後向提里奧·弗丁覆命。',
  }
},
[5846] = {
  {
    'Do amor e da família‡Символ семейной любви‡Von Liebe und Familie‡가족과 사랑‡Del amor y la familia‡Del amor y la familia‡L\'amour et la famille‡爱与家庭‡愛與家庭',
    nil,
    'Viaje para a ilha de Castro das Flechas, na região centro-sul das Terras Pestilentas, e procure pistas sobre o paradeiro da pintura.‡Отправляйтесь на остров Каэр Дарроу в центральной части Чумных земель и поищите там картину.‡Begebt Euch zur Insel Darrowehr im südlich-zentralen Bereich der Pestländer und sucht nach Hinweisen, wo sich das Gemälde befinden könnte.‡역병지대의 남쪽 중앙에 있는 카엘 다로우로 가서 초상화가 어디쯤 있는지에 대한 단서를 찾아야 합니다.‡Viaja a la isla de Castel Darrow, en la región sur del centro de las Tierras de la Peste. Allí, busca pistas sobre el paradero del cuadro.‡Viaja a la isla de Castel Darrow, en la región sur del centro de las Tierras de la Peste. Allí, busca pistas sobre el paradero del cuadro.‡Voyager jusqu\'à l\'île de Caer Darrow, dans la région centre-sud des Maleterres, et chercher un indice de l\'emplacement du tableau.‡到凯尔达隆岛去，寻找关于那副画的线索。凯尔达隆岛在瘟疫之地南部的湖中央。‡到凱爾達隆島去，尋找關於那副畫的線索。凱爾達隆島在瘟疫之地南部的湖中央。',
  }
},
[5847] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Bienvenido!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Leve o Vale-Brinde de Montalvo para Claire Salgueiro em Montalvo.‡Отнесите подарочный сертификат Брилла Клэр Вилловер.‡Bringt Claire Weidner in Brill den Geschenkgutschein von Brill.‡브릴에 있는 클레어 윌로워에게 브릴 선물교환권을 가져가야 합니다.‡Lleva el vale regalo de Rémol a Claire Sauzal en Rémol.‡Lleva el vale regalo de Rémol a Claire Willower en Rémol.‡Apporter le Bon-cadeau de Brill à Claire Willower, au Glas.‡将丧钟镇礼品券交给克莱尔·韦洛。‡將布瑞爾禮品券交給布瑞爾的克雷爾·韋洛。',
  }
},
[5848] = {
  {
    'Do amor e da família‡Символ семейной любви‡Von Liebe und Familie‡가족과 사랑‡Del amor y la familia‡Del amor y la familia‡De l\'amour et de la famille‡爱与家庭‡愛與家庭',
    nil,
    'Viaje para Stratholme, na parte norte das Terras Pestilentas. No Bastião Escarlate, você encontrará a pintura "Do Amor e da Família", escondida atrás de outro quadro que retrata as luas gêmeas do nosso mundo.nnLeve a pintura de volta para Tirion Fordring.‡Отправляйтесь в Статхольм в северную часть Чумных земель. Найдите в бастионе Алого ордена картину "Символ семейной любви", спрятанную за другой, изображающей две луны нашего мира.nnОтнесите картину Тириону Фордрингу.‡Begebt Euch nach Stratholme im nördlichen Teil der Pestländer. In der scharlachroten Bastion findet Ihr das Gemälde \'Von Liebe und Familie\', das zwischen anderen Gemälden versteckt ist und auf dem die Zwillingsmonde unserer Welt abgebildet sind.nnBringt das Gemälde zu Tirion Fordring.‡역병지대의 북쪽, 스트라솔름에 있는 붉은십자군 성채로 가서 쌍둥이 달 그림을 찾으십시오.nn그 뒤에 숨겨진 \'가족과 사랑\'이라는 그림을 찾아 티리온 폴드링에게 가져가야 합니다.‡Viaja a Stratholme, en la zona norte de las Tierras de la Peste. En El Bastión Escarlata encontrarás el cuadro \'Del amor y la familia\', oculto tras otra pintura que representa las lunas gemelas de nuestro mundo.nnDevuelve la pintura a Tirion Vadín.‡Viaja a Stratholme, en la zona norte de las Tierras de la Peste. En El Bastión Escarlata encontrarás el cuadro \'Del amor y la familia\', oculto tras otra pintura que representa las lunas gemelas de nuestro mundo.|nDevuelve la pintura a Tirion Vadín.‡Se rendre à Stratholme, dans la partie nord des Maleterres. C\'est dans le Bastion écarlate que se trouve le tableau De l\'amour et de la famille, caché derrière une autre peinture représentant les lunes jumelles.nnRapporter le tableau à Tirion Fordring.‡到瘟疫之地北部的斯坦索姆去。你可以在血色十字军堡垒中找到"爱与家庭"这幅画，它被隐藏在另一幅描绘两个月亮的画之后。nn把这幅画还给提里奥·弗丁。‡到瘟疫之地北部的斯坦索姆去。你可以在血色十字軍堡壘中找到「愛與家庭」這幅畫，它被隱藏在另一幅描繪兩個月亮的畫之後。|n把這幅畫還給提里恩·弗丁。',
  }
},
[5861] = {
  {
    'Encontrando Myranda‡Найти Миранду‡Myranda suchen‡미란다 찾기‡Encuentra a Myranda‡Encuentra a Myranda‡Trouver Myranda‡寻找麦兰达‡尋找米蘭達',
    nil,
    'Viaje para a Tumba de Uther, que fica nas Terras Pestilentas meridionais. Mostre a Dádiva de Tirion para Myranda, a Bruxa Velha.‡Отправляйтесь к гробнице Утера, которая находится в южных Чумных землях. Покажите Миранде Колдунье подарок Тириона.‡Begebt Euch zu Uthers Grabmal in den Südlichen Pestländern. Zeigt Myranda der Vettel Tirions Geschenk.‡역병지대의 남쪽에 위치한 우서 경의 무덤으로 가서 티리온의 선물을 노파 미란다에게 보여줘야 합니다.‡Viaja a la Tumba de Uther, en el sur de las Tierras de la Peste. Enseña a Myranda la Fada el obsequio de Tirion.‡Viaja a la Tumba de Uther, en el sur de las Tierras de la Peste. Enseña a Myranda la Fada el obsequio de Tirion.‡Se rendre au tombeau d’Uther, au sud des Maleterres. Montrer à Myranda la Mégère le Don de Tirion.‡到瘟疫之地南部的乌瑟尔之墓去，将提里奥的礼物交给巫女麦兰达。‡到瘟疫之地南部的烏瑟之墓去，將提里恩的禮物交給巫女米蘭達。',
  }
},
[5862] = {
  {
    'Subterfúgio Escarlate‡Уловка против Алого ордена‡Scharlachrote Täuschung‡붉은십자군의 핑계‡El subterfugio Escarlata‡El subterfugio Escarlata‡Le subterfuge écarlate‡血色幻象‡血色幻象',
    nil,
    'Fale com Myranda para receber a Ilusão Escarlate. Viaje para Amparo sob o efeito de Ilusão Escarlate e entregue a Dádiva de Tirion para o Grão-lorde Taelan Fordring.nnAmparo fica ao norte e Taelan estará dentro da Bastilha Mardenforte.‡Поговорите с Мирандой, пусть она наложит на вас алую иллюзию. Отправляйтесь в Дольный Очаг, покуда она действует, и отнесите подарок Тириона верховному лорду Телану Фордрингу.nnДольный Очаг на севере, а Телан должен быть внутри крепости Марденхольд.‡Sprecht mit Myranda, um die scharlachrote Illusion zu erhalten. Begebt Euch nach Herdweiler, während Ihr unter dem Einfluss der scharlachroten Illusion steht, und übergebt dem Hochlord Taelan Fordring Tirions Geschenk.nnHerdweiler liegt im Norden, Taelan dürfte sich in der Burg Mardenholde aufhalten.‡붉은십자군 환영을 얻어 노파 미란다와 대화해야 합니다. 붉은십자군 환영을 보유하고 있는 동안 하스글렌으로 가서 티리온의 선물을 대영주 탤런 폴드링에게 전해야 합니다.nn하스글렌은 북쪽에 있으며 탤런은 마르덴홀드 요새 내부에서 찾을 수 있을 겁니다.‡Habla con Myranda para conseguir la Ilusión Escarlata. Bajo el poder de la Ilusión Escarlata viaja a la Vega del Amparo y entrega el Regalo de Tirion al alto señor Taelan Vadín.nnLa Vega del Amparo está al Norte, Taelan seguramente estará en el interior de la Fortaleza de Mardenholde.‡Habla con Myranda para conseguir la Ilusión Escarlata. Bajo el poder de la Ilusión Escarlata viaja a la Vega del Amparo y entrega el obsequio de Tirion al alto señor Taelan Vadín.|nLa Vega del Amparo está al Norte, Taelan seguramente estará en el interior de la Fortaleza de Mardenholde.‡Parlez à Myranda pour obtenir l\'Illusion écarlate. Allez à Âtreval pendant que vous êtes sous l\'effet de l\'Illusion écarlate, et apportez le Don de Tirion au généralissime Taelan Fordring.nnÂtreval se trouve au nord, et Taelan devrait se trouver à l\'intérieur du Donjon de Mardenholde.‡和巫女麦兰达交谈以获得血色幻象的效果。在血色幻象的掩护下深入壁炉谷，将提里奥的礼物交给大领主泰兰·弗丁。nn壁炉谷在北方，泰兰应该在玛登霍尔德城堡里面。‡和巫女米蘭達交談以獲得血色幻影的效果。在血色幻影的掩護下深入壁爐谷，將提里恩的禮物交給大領主泰蘭·弗丁。|n壁爐谷在北方，泰蘭應該在瑪登霍爾德城堡裡面。',
  }
},
[5863] = {
  {
    'O Complexo Dunamalho‡Поселение Песчаного Молота‡Das Truppenlager der Dünenbrecher‡모래망치 주둔지‡La Base Machacaduna‡La Base Machacaduna‡La base des Cognedunes‡砂槌食人魔‡砂槌巨魔',
    nil,
    'Andi Lynn em Geringontzan quer que você destrua o Complexo Dunamalho. Para isso, deve matar 10 Brutamontes Dunamalho, 10 Impositores Dunamalho e Gor\'marok, o Assolador.‡Анди Линн из Прибамбасска просит уничтожить поселение Песчаного Молота, убив 10 громил и 10 мародеров из клана Песчаного Молота и Гор\'марока Опустошителя.‡Andi Lynn in Gadgetzan möchte, dass Ihr das Truppenlager der Dünenbrecher vernichtet, indem Ihr 10 Schläger der Dünenbrecher 10 Vollstrecker der Dünenbrecher sowie Gor\'marok den Verheerer tötet.‡가젯잔에 있는 앤디 린이 모래망치일족 투사, 모래망치일족 집행자를 각각 10명씩 처치하고 파괴자 고르마로크를 처단하여 모래망치 주둔지를 처치해 달라고 부탁했습니다.‡Andi Lynn de Gadgetzan quiere que destruyas la Base Machacaduna y para conseguirlo tendrás que matar 10 toscos Machacadunas, 10 déspotas Machacadunas y a Gor\'marok el Devastador.‡Andi Lynn de Gadgetzan quiere que destruyas la Base Machacaduna y para conseguirlo tendrás que matar 10 toscos Machacadunas, 10 déspotas Machacadunas y a Gor\'marok el Devastador.‡Andi Lynn de Gadgetzan veut que vous détruisiez la Base des Cognedunes en tuant 10 Brutes Cognedunes, 10 Massacreurs Cognedunes, et Gor\'marok le Ravageur.‡加基森的安迪·利恩想要你攻入砂槌营地，杀死10个砂槌蛮兵、10个砂槌执行者，以及掠夺者格玛洛克。‡加基森的安迪·利恩想要你攻入砂槌營地，殺死10個砂槌蠻卒、10個砂槌執行者，以及『劫毀者』格瑪洛克。',
  }
},
[5881] = {
  {
    'Chamando as reservas‡Смена караула‡Hinzurufen der Reserve‡휴가 통지서‡La sustitución‡La sustitución‡Puiser dans les réserves‡召回卫兵‡召回衛兵',
    nil,
    'Maggran quer que você entregue uma carta a Grish Pisaléguas no Grande Elevador, que fica nos Sertões.‡Маггран просит вас передать письмо Гришу Выносливому Гонцу у Великого подъемника в Степи.‡Maggran möchte, dass Ihr Grish Fernläufer am großen Aufzug im Brachland einen Brief zustellt.‡마그그랜이 불모의 땅 구름 승강장에 있는 그리쉬 롱러너에게 통지서를 전해달라고 부탁했습니다.‡Maggran quiere que le entregues una carta a Grish Largocamino en El Gran Elevador, en Los Baldíos.‡Maggran quiere que le entregues una carta a Grish Largo Camino en El Gran Elevador, en Los Baldíos.‡Maggran voudrait que vous apportiez une lettre à Grish Long-coureur, à la Grande élévation, dans les Tarides.‡马格兰希望你将信送到贫瘠之地升降梯的瑞什·远行者手中。‡馬格蘭希望你將信送到貧瘠之地升降梯的瑞什·長跑者手中。',
  }
},
[5882] = {
  {
    'Bálsamo via caça‡Лекарство из охотничьих трофеев‡Salbe durch Jagd‡사냥을 통한 고약 확보‡Bálsamo por caza‡Bálsamo por caza‡Du baume en chassant‡狩猎换药膏‡狩獵換藥膏',
    nil,
    'Os lampiões cenarianos permitem que o portador enxergue estilhaços de alma corrompida nas feras que são abatidas por um bem maior. Esses estilhaços são triturados para fazer um reagente com o qual preparo o bálsamo vegetal cenariano. Usaremos esse bálsamo para devolver a saúde a plantas corrompidas.nnEm troca desses estilhaços, darei a você um pouco do bálsamo vegetal cenariano que já preparei.‡Тот, кто имеет при себе Маяк Кенария, может оскверненные осколки души затронутых порчей животных, убитых ради вящего блага. Я измельчаю эти осколки и делаю из них реактив, который идет на изготовление кенарийского бальзама исцеления растений. Мы используем это средство для исцеления пораженных порчей растений.nnЗа эти осколки я дам тебе немного уже готового бальзама.‡Wer ein cenarisches Leuchtfeuer besitzt, kann mit diesem die verderbten Seelensplitter in den besudelten Bestien sehen, die zum Wohl der Allgemeinheit vernichtet werden. Ich schleife Splitter zu einem nutzbaren Reagenz, das für die Herstellung von cenarischer Pflanzensalbe verwendet wird. Wir werden diese Salbe benutzen, um verderbte Pflanzen wieder in gesunde zu verwandeln.nnIm Austausch für diese Splitter werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡이 세나리온 등불을 숲으로 지니고 가세요. 정의를 위해 타락한 짐승을 처치하고 오염된 영혼의 조각을 찾아오세요. 저는 그 조각을 갈아서 세나리온 식물 고약을 만드는 재료로 쓴답니다. 그 고약이면 오염된 식물들을 다시 건강하게 되살릴 수 있을 거예요.nn오염된 영혼의 조각을 가져다주면 제가 미리 준비해둔 세나리온 식물 고약을 드리겠어요.‡Una antorcha Cenarion te permite ver un fragmento de alma corrupto en esas bestias corruptas que deben ser sacrificadas por un bien mayor. Yo pulverizo los fragmentos y los convierto en un componente con el que se crea el bálsamo de planta de Cenarion. Y es lo que utilizaremos para sanar a las plantas corruptas.nnA cambio de esos fragmentos, te daré algunos bálsamos de planta de Cenarion que ya tengo preparados.‡‡Si vous possédez une Balise cénarienne, vous pourrez discerner un fragment d\'esprit corrompu sur les bêtes souillées que nous supprimons pour le plus grand bien de tous. Je broie ces fragments jusqu\'à obtenir un réactif dont je me sers pour confectionner le Baume végétal cénarien qui permet de rendre santé et vigueur à ces plantes corrompues.nnEn échange de ces fragments, je vous donnerai du Baume que j\'ai déjà préparé.‡只要你拿着塞纳里奥信标，你就能从那些堕落的野兽身上找到被污染的灵魂碎片，为了费伍德森林的未来，你一定要要拿到那些碎片。我会对碎片进行研磨加工，将其制成塞纳里奥植物药膏。我们可以用这种药膏拯救那些奄奄一息的堕落植物。nn如果你能给我弄些碎片来，我就可以给你几份植物药膏。‡',
  }
},
[5883] = {
  {
    'Bálsamo via mineração‡Лекарство из минералов‡Salbe durch Bergbau‡채광을 통한 고약 확보‡Bálsamo por minería‡Bálsamo por minería‡Du baume par la pioche‡采矿换药膏‡採礦換藥膏',
    nil,
    '‡Если во время поиска ископаемых в Оскверненном лесу у тебя будет с собой Маяк Кенария, ты сможешь найти порченый купорос, проникающий в жилы металлов. Я знаю, как очищать этот купорос и превращать его в реактив, который идет на изготовление кенарийского бальзама исцеления растений. Затем этим бальзамом можно исцелять пораженные растения.nnЕсли ты принесешь мне порченого купороса, я дам тебе уже готового кенарийского бальзама исцеления растений.‡Wenn Ihr im Besitz eines cenarischen Leuchtfeuers seid, während Ihr im Teufelswald Bergbau betreibt, könnt Ihr das besudelte Vitriol sehen, von dem eine Ader Rohmetall verderbt wird. Ich weiß, wie man dieses Vitriol läutert und zu einem Reagenz verarbeitet, aus dem cenarische Pflanzensalbe hergestellt wird. Diese Salbe verwendet Ihr dann an Pflanzen, die Ihr draußen in der Wildnis findet und die gerettet werden müssen.nnWenn Ihr verderbtes Vitriol gesammelt habt, werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡악령의 숲에서 채광할 때 세나리온 등불을 들고 있으면 광맥을 오염시키는 황산을 볼 수 있어요. 저는 그 황산을 정화해 세나리온 식물 고약의 재료로 바꾸는 방법을 알고 있어요. 그 고약이면 숲의 오염된 식물을 정화할 수 있답니다.nn오염된 황산을 모아오면 그 대가로 제가 미리 준비해둔 세나리온 식물 고약을 드리겠어요.‡‡‡Si vous avez une Balise cénarienne et que vous minez dans Gangrebois, peut-être trouverez-vous du Vitriol contaminé dans un filon de minerai brut. Je sais comment purifier ce vitriol et le transformer en un composant qui sert à faire du Baume végétal cénarien. Vous pourrez ensuite l\'utiliser pour libérer les plantes corrompues que vous rencontrerez.nnSi vous avez collecté du Vitriol contaminé, je vous l\'échange contre du Baume végétal cénarien que j\'ai déjà préparé.‡‡',
  }
},
[5884] = {
  {
    'Bálsamo via coleta‡Лекарство из оскверненных трав‡Salbe durch Sammlung‡약초채집을 통한 고약 확보‡Bálsamo por recolección‡Bálsamo por recolección‡Du baume contre une récolte‡采集换药膏‡採集換藥膏',
    nil,
    '‡Маяк Кенария позволяет опрытному травнику замечать коварный зародыш Скверны – мерзостный результат поразившей Оскверненный лес порчи. В результате долгих моих трудов здесь мне удалось научиться преврашать зародыш Скверны в очищающее вещество... которое мы используем для приготовления так называемого кенарийского бальзама исцеления растений.nnВо время сбора растений в Оскверненном лесу ты сможешь замечать зародыш Скверны, пока на тебе лежит заклятие Маяк Кенария. За то, что ты мне принесешь, я дам тебе уже готового бальзама Кенария.‡Mit einem cenarischen Leuchtfeuer können erfahrene Kräuterkundige die heimtückische Teufelsranke erkennen, ein bösartiges Produkt der Verderbnis des Teufelswalds. Dank meiner Arbeit verfüge ich über das Wissen, die Teufelsranke zu einem Säuberungsreagenz verarbeiten zu können. Dieses verwenden wir für etwas, das wir jetzt cenarische Pflanzensalbe nennen.nnWenn Ihr im Teufelswald Kräuter sammelt, dann solltet Ihr, solange Ihr das Leuchtfeuer bei Euch habt, auf Teufelsranken stoßen. Im Austausch gegen das, was Ihr mir bringt, werde ich Euch fertige cenarische Pflanzensalbe geben.‡‡‡‡Une Balise cénarienne permet aux herboristes expérimentés de repérer les créatures corrompues de Gangrebois. Mon travail ici m\'a appris à les purifier avec un réactif... utilisé dans ce que nous appelons le Baume végétal cénarien.nnLorsque vous cueillerez des herbes à Gangrebois, vous devriez remarquer les créatures corrompues si vous avez la Balise cénarienne. En échange je vous donnerai du Baume cénarien que j\'ai déjà préparé.‡‡',
  }
},
[5885] = {
  {
    'Bálsamo via esfolamento‡Лекарство из оскверненных шкур‡Salbe durch Kürschnerei‡무두질을 통한 고약 확보‡Bálsamo por desuello‡Bálsamo por desuello‡Du baume contre des peaux‡剥皮换药膏‡剝皮換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному специалисту по снятию шкур находить куски пораженных порчей шкур среди добытого в Оскверненном лесу добра. Я перерабатываю эти вроде бы бесполезные обрывки в густую пасту, которая ускоряет действие кенарийского бальзама исцеления растений. Когда ты будешь свежевать туши убитых в Оскверненном лесу животных, позаботься, чтобы на тебе лежало заклятие Маяка Кенария!nnКогда соберешь порченые клочки, принеси их мне, и я дам тебе немного готового кенарийского бальзама исцеления растений.‡Mit einem cenarischen Leuchtfeuer können gut ausgebildete Kürschner die Flecken besudelter Haut auf den im Teufelswald erbeuteten Fellen erkennen. Ich wandle diese scheinbar nutzlosen Flecken in eine dicke Paste um, mit der die cenarische Pflanzensalbe aktiviert wird. Wenn Ihr hier im Teufelswald Eure Beute häutet, dann solltet Ihr unbedingt immer ein Leuchtfeuer bei Euch haben.nnSobald Ihr besudelte Flecken gesammelt habt, bringt sie mir. Ich gebe Euch etwas cenarische Pflanzensalbe dafür, die ich bereits hergestellt habe.‡‡‡‡Une balise cénarienne permet à un dépeceur bien entraîné de repérer des morceaux de peau contaminée dans le butin ramassé à Gangrebois. Je transforme ces morceaux apparemment inutiles en pâte épaisse qui sert d\'agent accélérateur au baume végétal cénarien. Quand vous dépecez vos prises ici à Gangrebois, assurez-vous d\'avoir toujours une balise sur vous !nnLorsque vous ramassez des morceaux de peau contaminée, apportez-les-moi et je vous donnerai des doses de baume végétal cénarien que j\'ai en réserve.‡训练有素的剥皮匠可以用塞纳里奥信标从费伍德森林里的生物身上找到被污染的毛皮，我可以把这些皮制作成塞纳里奥植物药膏。nn当你在这里采集兽皮的时候，记得带上信标。给我弄些被污染的毛皮来，我就可以给你几份药膏。‡',
  }
},
[5886] = {
  {
    'Bálsamo via desencantamento‡Лекарство из распыленных предметов‡Salbe durch Entzauberung‡마력 추출을 통한 고약 확보‡Bálsamo por desencantamiento‡Bálsamo por desencantamiento‡Du baume contre des désenchantements‡分解换药膏‡分解換藥膏',
    nil,
    '‡Сила магического предмета соответствует силе эссенций, получающихся в результате его распыления. Мной изобретен способ переработки сырой субстанции, используемой зачаровывателями, в реактив, пригодный для создания кенарийского бальзама исцеления растений. Для этого тебе не нужен Маяк Кенария. Подойдет любой предмет, с которого сняты чары, и который выделяет простую субстанцию Пустоты.nnМне нужна всего одна порция простой субстанции Пустоты, а за это я тебе дам бальзама исцеления Кенария. Эта субстанция чрезвычайно сильна – даже малого количества хватит надолго!‡Die Macht eines entzauberten magischen Gegenstandes ist in der von ihm geschaffenen Essenz spürbar. Ich habe einen Weg gefunden, um die rohe Essenz, die von Verzauberern verwendet wird, in ein geeignetes Reagenz für die cenarische Pflanzensalbe umzuwandeln. Dazu braucht Ihr kein cenarisches Leuchtfeuer; jeder angemessen entzauberte Gegenstand, der geringe Netheressenzen abgibt, ist dafür geeignet.nnIch brauche nur eine einzige geringe Netheressenz; im Austausch dafür werde ich Euch cenarische Pflanzensalben geben. Die Essenz ist hochwirksam - ganz wenig davon genügt, um viel zu erreichen.‡‡‡‡Le pouvoir d\'un objet magique désenchanté est éprouvé par l\'essence qu\'il crée. J\'ai conçu un moyen de transformer l\'essence brute utilisée par les enchanteurs en un réactif qui permet de créer du Baume végétal cénarien. Vous n\'avez pas besoin de Balise cénarienne dans ce cas. N\'importe quel objet désenchanté qui produit des essences inférieures fera parfaitement l\'affaire.nnJe n\'ai besoin que d\'une seule essence inférieure. En échange, je vous donnerai du Baume végétal cénarien. L\'essence est très puissante. Il en faut peu pour faire beaucoup !‡‡',
  }
},
[5887] = {
  {
    'Bálsamo via caça‡Лекарство из охотничьих трофеев‡Salbe durch Jagd‡사냥을 통한 고약 확보‡Bálsamo por caza‡Bálsamo por caza‡Du baume en chassant‡狩猎换药膏‡狩獵換藥膏',
    nil,
    '‡Обладание Маяком Кенария позволяет увидеть оскверненные осколки души затронутых порчей животных, убитых ради вящего блага. Я измельчаю эти осколки и делаю из них реактив, который идет на изготовление кенарийского бальзама исцеления растений. Мы используем это средство для исцеления пораженных порчей растений.nnЗа эти осколки я дам тебе немного уже готового кенарийского бальзама исцеления растений.‡Wer ein cenarisches Leuchtfeuer besitzt, kann mit diesem die verderbten Seelensplitter in den besudelten Bestien sehen, die zum Wohl der Allgemeinheit vernichtet werden. Ich schleife Splitter zu einem nutzbaren Reagenz, das für die Herstellung von cenarischer Pflanzensalbe verwendet wird. Wir werden diese Salbe benutzen, um verderbte Pflanzen wieder in gesunde zu verwandeln.nnIm Austausch für diese Splitter werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡이 세나리온 등불을 들고 숲으로 가세요. 정의를 위해 타락한 짐승을 처치하고 오염된 영혼의 조각을 찾아오세요. 그 조각을 갈아서 세나리온 식물 고약을 만들 수 있답니다. 그 고약이면 오염된 식물을 다시 건강하게 정화할 수 있을 거예요.nn오염된 영혼의 조각을 가져다주면 제가 미리 준비해둔 세나리온 식물 고약을 나눠드리겠어요.‡Una antorcha Cenarion te permite ver un fragmento de alma corrupto en esas bestias corruptas que deben ser sacrificadas por un bien mayor. Yo pulverizo los fragmentos y los convierto en un componente con el que se crea el bálsamo de planta Cenarion. Y es lo que utilizaremos para sanar a las plantas corruptas.nnA cambio de esos fragmentos, te daré algunos bálsamos de planta Cenarion que ya tengo preparados.‡‡Si vous possédez une Balise cénarienne, vous pourrez discerner un fragment d\'esprit corrompu sur les bêtes souillées que nous supprimons pour le plus grand bien de tous. Je broie ces fragments jusqu\'à obtenir un réactif dont je me sers pour confectionner le Baume végétal cénarien qui permet de rendre santé et vigueur à ces plantes corrompues.nnEn échange de ces fragments, je vous donnerai du Baume cénarien que j\'ai déjà préparé.‡‡',
  }
},
[5888] = {
  {
    'Bálsamo via mineração‡Лекарство из минералов‡Salbe durch Bergbau‡채광을 통한 고약 확보‡Bálsamo por minería‡Bálsamo por minería‡Du baume par la pioche‡采矿换药膏‡採礦換藥膏',
    nil,
    '‡Если во время поиска ископаемых в Оскверненном лесу у тебя будет с собой Маяк Кенария, ты сможешь найти порченый купорос, проникающий в жилы металлов. Я знаю, как очищать этот купорос и превращать его в реактив, который идет на изготовление кенарийского бальзама исцеления растений. Затем этим бальзамом можно исцелять пораженные растения.nnЕсли ты принесешь мне порченого купороса, я дам тебе уже готового кенарийского бальзама исцеления растений.‡Wenn Ihr im Besitz eines cenarischen Leuchtfeuers seid, während Ihr im Teufelswald Bergbau betreibt, könnt Ihr das besudelte Vitriol sehen, von dem eine Ader Rohmetall verderbt wird. Ich weiß, wie man dieses Vitriol läutert und zu einem Reagenz verarbeitet, aus dem cenarische Pflanzensalbe hergestellt wird. Diese Salbe verwendet Ihr dann an Pflanzen, die Ihr draußen in der Wildnis findet und die gerettet werden müssen.nnWenn Ihr verderbtes Vitriol gesammelt habt, werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡악령의 숲에서 채광할 때 세나리온 등불을 들고 있으면 광맥을 오염시키는 황산을 볼 수 있어요. 저는 그 황산을 정화해 세나리온 식물 고약의 재료로 바꾸는 방법을 알고 있어요. 숲에서 오염된 식물을 찾으면 이 고약으로 정화할 수 있답니다.nn오염된 황산을 모아오면 그 대가로 제가 미리 준비해둔 세나리온 식물 고약을 나눠드리겠어요.‡‡‡Si vous avez une Balise cénarienne et que vous minez dans Gangrebois, peut-être trouverez-vous du Vitriol contaminé dans un filon de minerai brut. Je sais comment purifier ce vitriol et le transformer en un composant qui sert à faire du Baume végétal cénarien. Vous pourrez ensuite l\'utiliser pour libérer les plantes corrompues que vous rencontrerez.nnSi vous avez collecté du Vitriol contaminé, je vous l\'échange contre du Baume végétal cénarien que j\'ai déjà préparé.‡‡',
  }
},
[5889] = {
  {
    'Bálsamo via coleta‡Лекарство из оскверненных трав‡Salbe durch Sammlung‡약초채집을 통한 고약 확보‡Bálsamo por recolección‡Bálsamo por recolección‡Du baume contre une récolte‡采集换药膏‡採集換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному травнику замечать коварный зародыш Скверны – мерзостный результат поразившей Оскверненный лес порчи. В результате долгих моих трудов здесь мне удалось научиться превращать зародыш Скверны в очищающее вещество... которое мы используем для приготовления так называемого кенарийского бальзама исцеления растений.nnВо время сбора растений в Оскверненном лесу ты сможешь замечать зародыш Скверны, пока на тебе лежит заклятие "Маяк Кенария". За то, что ты мне принесешь, я дам тебе уже готового бальзама Кенария.‡Mit einem cenarischen Leuchtfeuer können erfahrene Kräuterkundige die heimtückische Teufelsranke erkennen, ein bösartiges Produkt der Verderbnis des Teufelswalds. Dank meiner Arbeit verfüge ich über das Wissen, die Teufelsranke zu einem Säuberungsreagenz verarbeiten zu können. Dieses verwenden wir für etwas, das wir jetzt cenarische Pflanzensalbe nennen.nnWenn Ihr im Teufelswald Kräuter sammelt, dann solltet Ihr, solange Ihr das Leuchtfeuer bei Euch habt, auf Teufelsranken stoßen. Im Austausch gegen das, was Ihr mir bringt, werde ich Euch fertige cenarische Pflanzensalbe geben.‡‡Una antorcha Cenarion permite a un herborista experimentado detectar cualquier agente máculo insidioso, ese criminal producto de la corrupción de Frondavil. Trabajando aquí he aprendido a purificar el agente máculo y convertirlo en un agente purificador... uno que se usa en lo que ahora llamamos bálsamo de planta de Cenarion.nnSi llevas la antorcha contigo mientras recoges hierbas en Frondavil, deberías poder ver el agente máculo. A cambio de lo que me traigas, te daré un poco de bálsamo de planta de Cenarion que tengo ya preparado.‡‡Une Balise cénarienne permet aux herboristes expérimentés de repérer les créatures corrompues de Gangrebois. Mon travail ici m\'a appris à les purifier avec un réactif... utilisé dans ce que nous appelons le Baume végétal cénarien.nnLorsque vous cueillerez des herbes à Gangrebois, vous devriez remarquer les créatures corrompues si vous avez la Balise cénarienne. En échange je vous donnerai du Baume cénarien que j\'ai déjà préparé.‡‡',
  }
},
[5890] = {
  {
    'Bálsamo via esfolamento‡Лекарство из оскверненных шкур‡Salbe durch Kürschnerei‡무두질을 통한 고약 확보‡Bálsamo por desuello‡Bálsamo por desuello‡Du baume contre des peaux‡剥皮换药膏‡剝皮換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному специалисту по снятию шкур находить куски пораженных порчей шкур среди добытого в Оскверненном лесу добра. Я перерабатываю эти вроде бы бесполезные обрывки в густую пасту, которая ускоряет действие кенарийского бальзама исцеления растений. Когда ты будешь свежевать туши убитых в Оскверненном лесу животных, позаботься, чтобы на тебе лежало заклятие Маяк Кенария!nnКогда соберешь испорченные куски, принеси их мне, и я дам тебе немного готового кенарийского бальзама исцеления растений.‡Mit einem cenarischen Leuchtfeuer können gut ausgebildete Kürschner die Flecken besudelter Haut auf den im Teufelswald erbeuteten Fellen erkennen. Ich wandle diese scheinbar nutzlosen Flecken in eine dicke Paste um, mit der die cenarische Pflanzensalbe aktiviert wird. Wenn Ihr hier im Teufelswald Eure Beute häutet, dann solltet Ihr unbedingt immer ein Leuchtfeuer bei Euch haben.nnSobald Ihr besudelte Flecken gesammelt habt, bringt sie mir. Ich gebe Euch etwas cenarische Pflanzensalbe dafür, die ich bereits hergestellt habe.‡‡‡‡Une balise cénarienne permet à un dépeceur bien entraîné de repérer des morceaux de peau contaminée dans le butin ramassé à Gangrebois. Je transforme ces morceaux apparemment inutiles en pâte épaisse qui sert d\'agent accélérateur au baume végétal cénarien. Quand vous dépecez vos prises ici à Gangrebois, assurez-vous d\'avoir toujours une balise sur vous !nnLorsque vous ramassez des morceaux de peau contaminée, apportez-les-moi et je vous donnerai des doses de baume végétal cénarien que j\'ai en réserve.‡‡',
  }
},
[5891] = {
  {
    'Bálsamo via desencantamento‡Лекарство из распыленных предметов‡Salbe durch Entzauberung‡마력 추출을 통한 고약 확보‡Bálsamo por desencanto‡Bálsamo por desencantamiento‡Du baume contre des désenchantements‡分解换药膏‡分解換藥膏',
    nil,
    '‡Сила магического предмета соответствует силе эссенций, получающихся в результате его распыления. Мной изобретен способ переработки сырой субстанции, используемой зачаровывателями, в реактив, пригодный для создания кенарийского бальзама исцеления растений. Для этого тебе не нужен Маяк Кенария. Подойдет любой предмет, с которого сняты чары, и который выделяет простую субстанцию Пустоты.nnМне нужна всего одна порция простой субстанции Пустоты, а за это я тебе дам бальзама исцеления Кенария. Эта субстанция чрезвычайно сильна – даже малого количества хватит надолго!‡Die Macht eines entzauberten magischen Gegenstandes ist in der von ihm geschaffenen Essenz spürbar. Ich habe einen Weg gefunden, um die rohe Essenz, die von Verzauberern verwendet wird, in ein geeignetes Reagenz für die cenarische Pflanzensalbe umzuwandeln. Dazu braucht Ihr kein cenarisches Leuchtfeuer; jeder angemessen entzauberte Gegenstand, der geringe Netheressenzen abgibt, ist dafür geeignet.nnIch brauche nur eine einzige geringe Netheressenz; im Austausch dafür werde ich Euch cenarische Pflanzensalben geben. Die Essenz ist hochwirksam - ganz wenig davon genügt, um viel zu erreichen.‡‡‡‡Le pouvoir d\'un objet magique désenchanté est éprouvé par l\'essence qu\'il crée. J\'ai conçu un moyen de transformer l\'essence brute utilisée par les enchanteurs en un réactif qui permet de créer du Baume végétal cénarien. Vous n\'avez pas besoin de Balise cénarienne dans ce cas. N\'importe quel objet désenchanté qui produit des essences inférieures fera parfaitement l\'affaire.nnJe n\'ai besoin que d\'une seule essence inférieure. En échange, je vous donnerai du Baume végétal cénarien. L\'essence est très puissante. Il en faut peu pour faire beaucoup !‡‡',
  }
},
[5892] = {
  {
    'Suprimentos dos Ferrofundo‡Припасы Железного рудника‡Vorräte der Eisenschachtmine‡깊은무쇠 광산 보급품‡Suministros de Ferrohondo‡Suministros de Ferrohondo‡Fournitures de Gouffrefer‡深铁矿洞的补给‡深鐵礦坑補給品',
    nil,
    'Leve 10 Suprimentos de Ferrofundo para o Intendente da Aliança em Dun Baldar.‡Принесите 10 ящиков припасов Железного рудника интенданту Альянса в Дун Болдар.‡Bringt 10 Vorräte der Eisenschachtmine zum Rüstmeister der Allianz in Dun Baldar.‡던 발다르에 있는 얼라이언스 병참장교에게 깊은무쇠 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 suministros de Ferrohondo al intendente de la Alianza en Dun Baldar.‡Lleva 10 suministros de Ferrohondo al intendente de la Alianza en Dun Baldar.‡Apporter 10 Fournitures de Gouffrefer à l\'Intendant de l\'Alliance de Dun Baldar.‡把10份深铁矿洞补给品交给丹巴达尔的联盟军需官。‡把10份深鐵礦坑補給品交給丹巴達爾的聯盟軍需官。',
  }
},
[5893] = {
  {
    'Suprimentos de Dentefrio‡Припасы из рудника Ледяного Зуба‡Vorräte der Eisbeißermine‡얼음이빨 광산 보급품‡Suministros de Dentefrío‡Suministros de Dentefrío‡Fournitures de Froide-dent‡冷齿矿洞的补给‡冷齒礦坑補給品',
    nil,
    'Leve 10 Suprimentos de Dentefrio para o Intendente da Horda na Bastilha Lobo do Gelo.‡Доставьте 10 припасов Ледяного Зуба интенданту Орды в крепость Северного Волка.‡Bringt 10 Vorräte der Eisbeißermine zum Rüstmeister der Horde in die Burg Frostwolf.‡서리늑대 요새에 있는 서리늑대 병참장교에게 얼음이빨 광산 보급품 10개를 가져가야 합니다.‡Lleva 10 suministros de Dentefrío al intendente de la Horda en el Bastión Lobo Gélido.‡Lleva 10 suministros de Dentefrío al intendente de la Horda en el Bastión Lobo Gélido.‡Apporter 10 Fournitures de Froide-dent à l\'intendant de la Horde, au donjon Loup-de-givre.‡把10份冷齿矿洞补给品交给霜狼要塞的部落军需官。‡把10份冷齒礦坑補給品交給霜狼要塞的部落軍需官。',
  }
},
[5901] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與你',
    nil,
    'Use a Jarra de Cupins Vazia nos Cupinzeiros que há nas Terras Pestilentas Orientais. Após conseguir 100 Cupins das Terras Pestilentas, fale novamente com Guel Levine no Baluarte, nas Clareiras de Tirisfal.‡Возьмите пустую банку для термитов и отправляйтесь к большим термитникам в Восточных Чумных землях. Наберите 100 термитов Восточных Чумных земель и возвращайтесь к Микки Левину в Бастион в Тирисфальских лесах.‡Wendet den leeren Termitenkrug auf die Termitenhügel in den östlichen Pestländern an. Sobald Ihr 100 Pestlandtermiten gesammelt habt, kehrt zu Mickey Levine am Bollwerk in Tirisfal zurück.‡동부 역병지대의 흰개미집으로 가서 빈 흰개미 병을 사용하십시오. 역병지대 흰개미 100마리를 모아서 티리스팔 숲의 보루에 있는 미키 레빈에게 돌아가야 합니다.‡Utiliza la Jarra de termitas vacía en los Montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Mickey Levine, que está en El Baluarte, en Claros de Tirisfal.‡Utiliza el tarro de termitas vacío en los montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Mickey Levine, que está en El Baluarte, en Claros de Tirisfal.‡Utiliser le Pot de Termites vide sur la Termitière, dans les Maleterres de l\'est. Après avoir récupéré 100 Termites des Maleterres, retourner voir Mickey Levine, à la Barricade, dans les Clairières de Tirisfal.‡在东瘟疫之地的蚁丘上使用空的白蚁瓶。当你收集了100只瘟疫白蚁之后，就回到提瑞斯法林地的亡灵壁垒去找米克·莱文。‡在東瘟疫之地的蟻丘上使用空的白蟻瓶。當你收集了100隻瘟疫白蟻之後，就回到提里斯法林地的亡靈壁壘去找米克·萊文。',
  }
},
[5902] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與你',
    nil,
    'Encontre um lugar apropriado para pôr o Barril de Cupins das Terras Pestilentas no centro da Serraria de Beiranorte, que fica nas Terras Pestilentas Ocidentais.‡Найдите подходящее место в центре лесопилки Северного Кряжа в Западных Чумных землях и оставьте там бочонок термитов из Чумных земель.‡Sucht Euch einen geeigneten Ort in der Mitte des Sägewerk des Nordkamms in den westlichen Pestländern, um das Fass mit den Pestlandtermiten abzustellen.‡서부 역병지대의 북마루 벌목지 중앙에 적당한 장소를 찾아 역병지대 흰개미 통을 놓아야 합니다.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Trouver un endroit judicieux au centre de la scierie de la Crête du nord, dans les Maleterres de l\'ouest, pour placer le Tonneau de Termites des Maleterres.‡到西瘟疫之地的北山伐木场去找个合适的地方，在那里放下一桶瘟疫白蚁。‡到西瘟疫之地的北山伐木場去找個合適的地方，在那裡放下一桶瘟疫白蟻。',
  }
},
[5903] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與你',
    nil,
    'Use a Jarra de Cupins Vazia nos Cupinzeiros que há nas Terras Pestilentas Orientais. Após conseguir 100 Cupins das Terras Pestilentas, fale novamente com Nataniel Dumah no Acampamento Ventogelante, em Terras Pestilentas Ocidentais.‡Возьмите пустую банку для термитов и отправляйтесь к большим термитникам в Восточных Чумных землях. Наберите 100 термитов Восточных Чумных земель и возвращайтесь к Натаниэлю Дамаху в Лагерь Промозглого Ветра в Восточные Чумные земли.‡Wendet den leeren Termitenkrug auf die Termitenhügel in den östlichen Pestländern an. Sobald Ihr 100 Pestlandtermiten gesammelt habt, kehrt zu Nathaniel Dumah im Zugwindlager in den westlichen Pestländern zurück.‡동부 역병지대에 있는 흰개미집으로 가서 빈 흰개미 병을 사용해야 합니다. 역병지대 흰개미 100마리를 모아 서부 역병지대의 서리바람 야영지에 있는 너대니얼 두마에게 돌아가야 합니다.‡Utiliza la Jarra de termitas vacía en los Montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Nathaniel Dumah al Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Utiliza el tarro de termitas vacío en los montones de termitas de las Tierras de la Peste del Este. Cuando hayas reunido 100 termitas de las Tierras de la Peste, vuelve con Nathaniel Dumah al Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Utiliser le Pot de Termites vide sur la Termitière, dans les Maleterres de l\'est. Après avoir récupéré 100 Termites des Maleterres, retourner voir Nathaniel Dumah, au camp du Noroît, dans les Maleterres de l\'ouest.‡在东瘟疫之地的蚁丘上使用空的白蚁瓶。当你收集了100只瘟疫白蚁之后，就回到西瘟疫之地的冰风岗去找纳萨尼尔·杜马。‡在東瘟疫之地的蟻丘上使用空的白蟻瓶。當你收集了100隻瘟疫白蟻之後，就回到西瘟疫之地的冰風營地去找納薩尼爾·杜馬。',
  }
},
[5904] = {
  {
    'Praga de cupins!‡Чума на вашу лесопилку!‡Eine Plage komme über Euch‡역병 퍼뜨리기‡Una Peste en la Cruzada‡Una Peste en la Cruzada‡Une Plaie sur la Croisade‡瘟疫与你‡瘟疫與你',
    nil,
    'Encontre um lugar apropriado para pôr o Barril de Cupins das Terras Pestilentas no centro da Serraria de Beiranorte, que fica nas Terras Pestilentas Ocidentais.‡Найдите подходящее место в центре лесопилки Северного Кряжа в Западных Чумных землях и оставьте там бочонок термитов из Чумных земель.‡Sucht Euch einen geeigneten Ort in der Mitte des Sägewerk des Nordkamms in den westlichen Pestländern, um das Fass mit den Pestlandtermiten abzustellen.‡서부 역병지대의 북마루 벌목지 중앙에 적당한 장소를 찾아 역병지대 흰개미 통을 놓아야 합니다.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Encuentra un lugar adecuado en el centro del Aserradero Crestanorte, en las Tierras de la Peste del Oeste, para colocar la barrica de termitas de las Tierras de la Peste.‡Trouver un endroit propice, au centre de la scierie de la Crête du nord, dans les Maleterres de l\'ouest, pour placer le Tonneau de Termites des Maleterres.‡到西瘟疫之地的北山伐木场去找个合适的地方，在那里放下一桶瘟疫白蚁。‡到西瘟疫之地的北山伐木場去找個合適的地方，在那裡放下一桶瘟疫白蟻。',
  }
},
[5921] = {
  {
    'Clareira da Lua‡Лунная поляна‡Mondlichtung‡달의 숲‡Claro de la Luna‡Claro de la Luna‡Reflet-de-Lune‡月光林地‡月光林地',
    nil,
    'Use o feitiço "Teleporte: Clareira da Lua" para viajar para a Clareira da Lua. Ao chegar, fale com Dendrite Stellardor, no vilarejo de Refúgio Noturno.‡При помощи заклинания "Телепортация: Лунная поляна" перенеситесь на Лунную поляну. По прибытии поговорите с Дендритом Блеском Звезд в селении Ночная Гавань.‡Benutzt den Zauber \'Teleportieren: Mondlichtung\', um zur Mondlichtung zu reisen. Wenn Ihr dort ankommt, sprecht mit Dendrite Sternenschauer in Nachthafen.‡"순간이동: 달의 숲" 주문을 이용하여 달의 숲으로 이동하십시오. 도착하면 나이트헤이븐의 덴드리트 스타블레이즈와 대화해야 합니다.‡Utiliza el hechizo "teletransportarse: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Utiliza el hechizo "Teletransporte: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Utiliser le sort "Téléportation : Reflet-de-Lune" pour aller à Reflet-de-Lune. Une fois sur place, parler à Dendrite Brasétoile, au village de Havrenuit.‡使用法术"传送：月光林地"抵达月光林地，在那里与永夜港的德迪利特·星焰谈一谈。‡使用法術「傳送:月光林地」抵達月光林地，在那裡與永夜港的德迪利特·星焰談話。',
  }
},
[5922] = {
  {
    'Clareira da Lua‡Лунная поляна‡Mondlichtung‡달의 숲‡Claro de la Luna‡Claro de la Luna‡Reflet-de-Lune‡月光林地‡月光林地',
    nil,
    'Use o feitiço "Teleporte: Clareira da Lua" para viajar para a Clareira da Lua. Ao chegar, fale com Dendrite Stellardor, no vilarejo de Refúgio Noturno.‡При помощи заклинания "Телепортация: Лунная поляна" перенеситесь на Лунную поляну. По прибытии поговорите с Дендритом Блеском Звезд в селении Ночная Гавань.‡Benutzt den Zauber \'Teleportieren: Mondlichtung\', um zur Mondlichtung zu reisen. Wenn Ihr dort ankommt, sprecht mit Dendrite Sternenschauer in Nachthafen.‡"순간이동: 달의 숲" 주문을 이용하여 달의 숲으로 이동해야 합니다. 달의 숲에 도착하면 나이트헤이븐의 덴드리트 스타블레이즈와 대화해야 합니다.‡Utiliza el hechizo "Teletransporte: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Utiliza el hechizo "Teletransporte: Claro de la Luna" para viajar a Claro de la Luna. Cuando llegues, ve al poblado Amparo de la Noche y habla con Dendrita Rafagaestelar.‡Utiliser le sort "Téléportation : Reflet-de-Lune" pour aller à Reflet-de-Lune. Une fois sur place, parler à Dendrite Brasétoile, au village de Havrenuit.‡使用法术"传送：月光林地"抵达月光林地，在那里与永夜港的德迪利特·星焰谈一谈。‡使用法術「傳送:月光林地」前去月光林地，在那裡與永夜港的德迪利特·星焰談話。',
  }
},
[5923] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡回應召喚',
    nil,
    'Fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bärenfährte in der Enklave des Cenarius in Darnassus.‡다르나서스 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Ve a Darnassus, al Enclave Cenarion y habla con Mathrengyl Garroso.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Parler à Mathrengyl Pasdelours, dans l\'Enclave cénarienne, à Darnassus.‡与达纳苏斯塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯塞納里奧區的瑪斯雷·馭熊者談話。',
  }
},
[5924] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡回應召喚',
    nil,
    'Fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bärenfährte in der Enklave des Cenarius in Darnassus.‡다르나서스 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Habla con Mathrengyl Garroso en el Enclave Cenarion, en Darnassus.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Parler à Mathrengyl Pasdelours, dans l\'Enclave cénarienne, à Darnassus.‡与达纳苏斯塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯塞納里奧區的瑪斯雷·馭熊者談話。',
  }
},
[5925] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Atendiendo a la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡回應召喚',
    nil,
    'Fale com Mathrengyl Ursivagus no Enclave Cenariano, em Darnassus.‡Поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария в Дарнассе.‡Sprecht mit Mathrengyl Bärenfährte in der Enklave des Cenarius in Darnassus.‡다르나서스 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Habla con Mathrengyl Garroso en el Enclave Cenarion de Darnassus.‡Parler à Mathrengyl Pasdelours, dans l\'Enclave cénarienne, à Darnassus.‡与达纳苏斯塞纳里奥区的玛斯雷·驭熊者谈一谈。‡與達納蘇斯塞納里奧區的瑪斯雷·馭熊者談話。',
  }
},
[5926] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡',
    nil,
    'Fale com Turak Runa Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Тюраком Руническим Тотемом на Вершине Старейшин в Громовом Утесе.‡Sprecht mit Turak Runentotem auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프의 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Habla con Turak Runatótem en el Alto de los Ancestros de Cima del Trueno.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Parler à Turak Totem-runique, sur la Cime des Anciens des Pitons du Tonnerre.‡与雷霆崖长者高地上的图拉克·符文图腾谈一谈。‡',
  }
},
[5927] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡',
    nil,
    'Fale com Turak Runa Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Тюраком Руническим Тотемом на Вершине Старейшин в Громовом Утесе.‡Sprecht mit Turak Runentotem auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Habla con Turak Tótem Rúnico en Alto de los Ancestros, en Cima del Trueno.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Parler à Turak Totem-runique, sur la Cime des Anciens des Pitons du Tonnerre.‡与雷霆崖长者高地上的图拉克·符文图腾谈一谈。‡',
  }
},
[5928] = {
  {
    'Atendendo o chamado‡Зов Природы‡Dem Ruf folgen‡부름에 응하기‡Escucha la llamada‡Escucha la llamada‡Écouter l\'appel‡响应召唤‡回應召喚',
    nil,
    'Fale com Turak Runa Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Тюраком Руническим Тотемом на Вершине Старейшин в Громовом Утесе.‡Sprecht mit Turak Runentotem auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프의 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Habla con Turak Tótem Rúnico en Alto de los Ancestros, en Cima del Trueno.‡Habla con Turak Tótem de Runa en Alto de los Ancestros, en Cima del Trueno.‡Parler à Turak Totem-runique, sur la Cime des Anciens des Pitons du Tonnerre.‡与雷霆崖长者高地上的图拉克·符文图腾谈一谈。‡與雷霆崖長者高地上的圖拉克·符文圖騰談話。',
  }
},
[5929] = {
  {
    'Espírito do Grande Urso‡Дух Великого Медведя‡Großer Bärengeist‡거대한 곰의 혼‡Espíritu del gran oso‡Espíritu del gran oso‡L\'esprit du Grand ours‡巨熊之灵‡巨熊之靈',
    nil,
    'Procure o Espírito do Grande Urso na região noroeste da Clareira da Lua e aprenda o que ele tem a compartilhar com você sobre a natureza do urso. Quando terminar, fale novamente com Dendrite Stellardor no Refúgio Noturno, que fica na Clareira da Lua.‡Найдите духа Великого Медведя на северо-западе Лунной поляны и усвойте все, что он расскажет вам о природе медведя. Когда уроки будут закончены, вернитесь к Дендриту Блеску Звезд на Ночную Гавань в Лунной поляне.‡Sucht den großen Bärengeist im nordwestlichen Teil der Mondlichtung auf und lernt alles, was er Euch über die Natur des Bären mitzuteilen hat. Wenn Ihr das erledigt habt, kehrt zu Dendrite Sternenschauer nach Nachthafen auf der Mondlichtung zurück.‡달의 숲 북서쪽에 사는 거대한 곰의 혼을 찾아가 드루이드라면 반드시 알아야 할 곰의 본성에 대해 배워야 합니다. 임무를 완수하면 달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 돌아가십시오.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Aller voir l\'esprit du Grand ours, au nord-ouest de Reflet-de-Lune et apprendre ce qu\'il peut vous enseigner sur la nature de l\'ours. Quand cela est fait, retourner voir Dendrite Brasétoile, à Havrenuit, dans Reflet-de-Lune.‡到月光林地的西北部去寻找巨熊之灵，向它学习关于熊的知识，然后回到月光林地的永夜港去找德迪利特·星焰。‡',
  }
},
[5930] = {
  {
    'Espírito do Grande Urso‡Дух Великого Медведя‡Großer Bärengeist‡거대한 곰의 혼‡Espíritu del gran oso‡Espíritu del gran oso‡Esprit du Grand ours‡巨熊之灵‡巨熊之靈',
    nil,
    'Procure o Espírito do Grande Urso na região noroeste da Clareira da Lua e aprenda o que ele tem a compartilhar com você sobre a natureza do urso. Quando terminar, fale novamente com Dendrite Stellardor no Refúgio Noturno, que fica na Clareira da Lua.‡Найдите духа Великого Медведя на северо-западе Лунной поляны и усвойте все, что он расскажет вам о природе медведя. Когда уроки будут закончены, вернитесь к Дендриту Блеску Звезд в Ночную Гавань на Лунной поляне.‡Sucht den großen Bärengeist im nordwestlichen Teil der Mondlichtung auf und lernt alles, was er Euch über die Natur des Bären mitzuteilen hat. Wenn Ihr das erledigt habt, kehrt zu Dendrite Sternenschauer nach Nachthafen auf der Mondlichtung zurück.‡달의 숲 북서쪽에 사는 거대한 곰의 혼을 찾아가 드루이드라면 반드시 알아야 할 곰의 본성에 대해 배워야 합니다. 임무를 완수하면 달의 숲, 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 돌아가십시오.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Busca al espíritu del gran oso al noroeste de Claro de la Luna y aprende lo que tenga que enseñarte sobre la naturaleza del oso. Después ve a hablar con Dendrita Rafagaestelar a Amparo de la Noche, en Claro de la Luna.‡Aller voir l\'esprit du Grand ours, au nord-ouest de Reflet-de-Lune et apprendre ce qu\'il peut vous enseigner sur la nature de l\'ours. Quand cela est fait, retourner voir Dendrite Brasétoile, à Havrenuit, dans Reflet-de-Lune.‡到月光林地的西北部去寻找巨熊之灵，向它学习关于熊的知识，然后回到月光林地的永夜港去找德迪利特·星焰。‡',
  }
},
[5931] = {
  {
    'De volta a Darnassus‡Возвращение в Дарнасс‡Zurück nach Darnassus‡다르나서스로 돌아가기‡El regreso a Darnassus‡El regreso a Darnassus‡Retour à Darnassus‡返回达纳苏斯‡',
    nil,
    'Volte a Darnassus e fale com Mathrengyl Ursivagus no Enclave Cenariano.‡Вернитесь в Дарнасс и поговорите с Матренгилом Медвежьей Лапой в анклаве Кенария.‡Kehrt nach Darnassus zurück und sprecht mit Mathrengyl Bärenfährte in der Enklave des Cenarius.‡다르나서스로 돌아가 세나리온 자치령에 있는 마스렌길 베어워커와 대화해야 합니다.‡Vuelve a Darnassus para hablar con Mathrengyl Garroso en el Enclave Cenarion.‡Vuelve a Darnassus para hablar con Mathrengyl Garroso en el Enclave Cenarion.‡Retourner à Darnassus et parler à Mathrengyl Pasdelours, dans l\'Enclave cénarienne.‡回到达纳苏斯，与塞纳里奥区的玛斯雷·驭熊者谈一谈。‡',
  }
},
[5932] = {
  {
    'De volta ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Zurück nach Donnerfels‡썬더 블러프로 돌아가기‡Vuelve a Cima del Trueno‡Vuelve a Cima del Trueno‡Retour vers les Pitons du Tonnerre‡返回雷霆崖‡',
    nil,
    'Volte ao Penhasco do Trovão e fale com Turak Runa Totem no Platô dos Anciãos.‡Вернитесь в Громовой Утес и поговорите с Тюраком Руническим Тотемом на Вершине Старейшин.‡Kehrt nach Donnerfels zurück und sprecht mit Turak Runentotem auf der Anhöhe der Ältesten.‡썬더 블러프로 돌아가 장로의 봉우리에 있는 투락 룬토템과 대화해야 합니다.‡Vuelve a Cima del Trueno para hablar con Turak Tótem Rúnico en Alto de los Ancestros.‡Vuelve a Cima del Trueno para hablar con Turak Tótem de Runa en Alto de los Ancestros.‡Retourner aux Pitons du Tonnerre, et parler à Turak Totem-runique, sur la Cime des Anciens.‡回到雷霆崖，与长者高地的图拉克·符文图腾谈一谈。‡',
  }
},
[5941] = {
  {
    'De novo com Crona‡Возвращение к Хроми‡Rückkehr zu Chromie‡크로미에게 돌아가기‡Vuelve con Cromi‡Regresa junto a Cromi‡Retourner voir Chromie‡返回克罗米身边‡返回克羅米身邊',
    nil,
    'Leve a Coleção de Relíquias para Crona em Andorhal.‡Отнесите сумку с реликвиями Хроми в Андорал.‡Bringt das Reliktbündel zu Chromie nach Andorhal.‡안돌할의 크로미에게 유물 자루를 가져가야 합니다.‡Lleva el montón de reliquias a Cromi a Andorhal.‡Lleva el montón de reliquias a Cromi a Andorhal.‡Apporter la Liasse de reliques à Chromie, à Andorhal.‡将一包遗物交给安多哈尔的克罗米。‡將一包聖物交給安多哈爾的克羅米。',
  }
},
[5942] = {
  {
    'Tesouros escondidos‡Спрятанные сокровища‡Versteckte Schätze‡숨겨진 보물‡Tesoros ocultos‡Tesoros ocultos‡Trésors cachés‡隐藏的宝藏‡隱藏的寶藏',
    nil,
    'Leve a Chave de Josefo ao Baú de Josefo.‡Откройте сундук Джозефа ключом Джозефа.‡Bringt Josephs Schlüssel zu Josephs Truhe.‡조셉의 상자가 있는 곳으로 조셉의 열쇠를 가져가야 합니다.‡Lleva la llave de Joseph al cofre de Joseph.‡Lleva la llave de Joseph al cofre de Joseph.‡Utiliser la Clé de Joseph sur le Coffre de Joseph.‡用约瑟夫的钥匙打开约瑟夫的箱子。‡用約瑟夫的鑰匙打開約瑟夫的箱子。',
  }
},
[5943] = {
  {
    'Caravana Gizelton‡Караван Гизлтона‡Gizeltons Karawane‡기젤톤 대상단‡La caravana Gizelton‡La caravana Gizelton‡La caravane de Gizelton‡基泽尔顿车队‡基澤爾頓車隊',
    nil,
    'Escolte a Caravana Gizelton pelas Ruínas de Mannoroc. Fale com o Smid no Acampamento do Rabiscafuso para receber a recompensa.‡Проводите караван Гизлтона через Поле Маннорок. О награде поговорите со Смидом: его можно найти в Лагере Заржавня.‡Geleitet Gizeltons Karawane am Zirkel der Mannoroc vorbei. Sprecht in Schraubenbuddels Lager mit Smeed, um Eure Belohnung zu erhalten.‡만노로크 소굴을 지나가는 기젤톤 대상단을 호위하고 스크래블스크류의 야영지에 있는 스미드와 대화하여 보상을 받아야 합니다.‡Escolta la caravana Gizelton a través del Aquelarre Mannoroc. Habla con Smeed en el Campamento de los Mezclatornillos para recibir tu recompensa.‡Escolta la caravana Gizelton a través del Aquelarre Mannoroc. Habla con Smeed en el Campamento de los Mezclatornillos para recibir tu recompensa.‡Escorter la caravane de Gizelton à travers le convent de Mannoroc. Parler à Smeed, au camp de Fouillevis, pour toucher la récompense.‡护送基泽尔顿车队通过玛诺洛克集会所，然后与瑟卡布斯库的营地的斯米德谈一谈，领取你的奖励。‡護送基澤爾頓車隊通過瑪諾洛克集會所，然後與瑟卡布斯庫的營地的斯米德談一談，領取你的獎勵。',
  }
},
[5944] = {
  {
    'No mundo dos sonhos‡Во сне‡In den Träumen‡탤런의 꿈‡En sueños‡En sueños‡En rêves‡在梦中‡在夢中',
    nil,
    'Escolte Taelan Fordring para fora de Amparo.‡Вывести Телана Фордринга из Дольного Очага.‡Geleitet Taelan Fordring aus Herdweiler hinaus.‡탤런 폴드링을 하스글렌 밖으로 호위해야 합니다.‡Escolta a Taelan Vadín fuera de la Vega del Amparo.‡Escolta a Taelan Vadín fuera de la Vega del Amparo.‡Escortez Taelan Fordring jusqu\'à la sortie d\'Âtreval.‡护送泰兰·弗丁走出壁炉谷。‡護送泰蘭·弗丁走出壁爐谷。',
  }
},
[5961] = {
  {
    'O campeão da Rainha Banshees‡Защитник королевы банши‡Der Champion der Bansheekönigin‡밴시 여왕의 용사‡Campeón de la reina alma en pena‡Campeón de la Reina alma en pena‡Le champion de la reine banshee‡女妖之王的勇士‡女妖之王的勇士',
    nil,
    'Fale com Nathanos, o Arauto da Praga nas Terras Pestilentas Orientais. Dizem que ele fixou residência no Sítio dos Marris.‡Поговорите с Натаносом Гнилостенем в Восточных Чумных землях. Он живет в Поместье Маррисов.‡Sprecht mit Nathanos Pestrufer in den östlichen Pestländern. Es heißt, dass er sich in Marris Siedlung niedergelassen hätte.‡동부 역병지대의 마리스 농장에 살고 있는 나타노스 블라이트콜러와 대화해야 합니다.‡Habla con Nathanos Clamorinfecto en las Tierras de la Peste del Este. Se dice que ahora vive en la Hacienda de Marris.|n‡Habla con Nathanos Clamañublo en las Tierras de la Peste del Este. Se dice que ahora vive en la Hacienda de Marris.‡Parler à Nathanos le Flétrisseur, dans les Maleterres de l\'est. Il se trouve actuellement à la ferme des Marris.‡与东瘟疫之地的纳萨诺斯·凋零者谈一谈。据说他居住在玛瑞斯农场。‡與東瘟疫之地的納薩諾斯·凋零者談一談。據說他居住在瑪瑞斯農場。',
  }
},
[5981] = {
  {
    'Gigantes descontrolados‡Истребление великанов‡Tobende Riesen‡광란의 거인‡Gigantes arrasadores‡Gigantes arrasadores‡Géants déchaînés‡狂暴的巨人‡狂暴的巨人',
    nil,
    'Ripárion Glaciares quer que você mate 4 Gigantes Friomalho e 4 Preservadores Friomalho.‡По просьбе Риверна Холодного Ветра убейте 4 великанов и 4 оберегателей ледяного молота.‡Rivern Frostwind möchte, dass Ihr 4 Frosthagelriesen und 4 Frosthagelbewahrer besiegt.‡리베른 프로스트윈드의 지시대로 서리망치거인 4명과 서리망치거인 수호자 4명을 없애야 합니다.‡Rivern Ventogélido quiere que mates 4 gigantes Machacahielo y 4 valedores Machacahielo.‡Rivern Ventogélido quiere que mates 4 gigantes Machacahielo y 4 valedores Machacahielo.‡Rivern Givrevent voudrait que vous tuiez 4 Géants Cognegivre et 4 Protecteurs Cognegivre.‡雷沃·霜翼要你去杀死4个霜槌巨人和4个霜槌保卫者。‡雷沃·霜風要你殺4個霜槌巨人和4個霜槌保護者。',
  }
},
[6001] = {
  {
    'Corpo e coração‡Тело и дух‡Körper und Herz‡육체와 정신‡Cuerpo y corazón‡Cuerpo y corazón‡Corps et cœur‡身心之力‡',
    nil,
    'Aplique Poeira de Lua Cenariana na Pedra Luniscante de Auberdine para trazer Lunagarra. Então, enfrente Lunagarra e ganhe a força de corpo e coração que ele possui.nnFale com Mathrengyl Ursivagus em Darnassus quando você terminar.‡Посыпьте лунной пылью Кенария камень лунного совуха в Аубердине, чтобы вызвать Лунокогтя. Победите Лунокогтя, чтобы получить силу его тела и духа.nnЗатем поговорите с Матренгилом Медвежьей Лапой в Дарнассе.‡Benutzt den Mondstaub des Cenarius mit dem Mondkinstein von Auberdine, um Mondklaue herauszulocken. Danach müsst Ihr Euch Mondklaue stellen und Euch die Kraft des Körpers und des Herzens verdienen, die er besitzt.nnSprecht mit Mathrengyl Bärenfährte in Darnassus, wenn Ihr fertig seid.‡아우버다인의 달빛야수 비석에 세나리온 달가루를 뿌려서 초승달발톱을 불러내야 합니다. 그런 다음 초승달발톱과 대면하여 그가 가진 육체와 정신의 힘을 얻어야 합니다.nn모든 일을 마치면 다르나서스에 있는 마스렌길 베어워커와 대화하십시오.‡Utiliza el polvo de luna Cenarion en la piedra de lechúcico lunar de Auberdine para invocar a Garraluna. Luego tendrás que enfrentarte a Garraluna y ganar la fuerza física y de corazón que posee. nnCuando hayas acabado, vuelve a Darnassus y habla con Mathrengyl Garroso.‡Utiliza el polvo de luna Cenarion en la piedra de lechúcico lunar de Auberdine para invocar a Garraluna. Luego tendrás que enfrentarte a Garraluna y ganar la fuerza física y de corazón que posee.|nCuando hayas acabado, vuelve a Darnassus y habla con Mathrengyl Garroso.‡Utiliser la Poussière de lune cénarienne sur la Pierre des séléniens d\'Auberdine pour invoquer Lunegriffe. Affronter Lunegriffe, et gagner la force physique et spirituelle qu\'il possède.nnQuand cela est fait, parler à Mathrengyl Pasdelours, à Darnassus.‡使用奥伯丁的月夜枭兽之石上面的塞纳里奥月尘引出月爪枭兽，然后击败月爪枭兽并吸取它所拥有的身心之力。nn任务完成之后，与达纳苏斯的玛斯雷·驭熊者谈一谈。‡',
  }
},
[6002] = {
  {
    'Corpo e coração‡Тело и дух‡Körper und Herz‡육체와 정신‡Cuerpo y corazón‡Cuerpo y corazón‡Corps et cœur‡身心之力‡身心之力',
    nil,
    'Aplique Poeira Lunar Cenariana na Pedra Luniscante entre Mulgore e os Sertões para evocar Lunagarra. Então, enfrente Lunagarra e ganhe a força de corpo e coração que ele possui.nnFale com Turak Runa Totem no Penhasco do Trovão quando terminar.‡Посыпьте лунной пылью Кенария Камень Лунного совуха, что между Мулгором и Степями, чтобы вызвать Лунокогтя. Теперь вам надо побороть Лунокогтя, чтобы заслужить его силу духа и тела.nnКогда выполните это, поговорите с Тюраком Руническим Тотемом в Громовом Утесе.‡Benutzt den Lunarstaub des Cenarius mit dem Mondkinstein zwischen Mulgore und dem Brachland, um Mondklaue herauszulocken. Danach müsst Ihr Euch Mondklaue stellen und Euch die Kraft des Körpers und des Herzens verdienen, die er besitzt.nnSprecht mit Turak Runentotem in Donnerfels, wenn Ihr fertig seid.‡초승달발톱을 불러내려면 멀고어와 불모의 땅 사이에 있는 달빛야수 비석에 세나리온 달가루를 사용해야 합니다. 거기에서 초승달발톱과 대적하여 그가 가진 육체와 마음의 힘을 얻으십시오.nn임무를 마치면 썬더 블러프에 있는 투락 룬토템과 대화해야 합니다.‡Aplica el polvo de luna Cenarion a la piedra de lechúcico lunar que se encuentra entre Mulgore y Los Baldíos para provocar a Garraluna. Hecho esto, has de enfrentarte a Garraluna para obtener la fuerza física y de corazón que posee.nnHabla con Turak Runatótem en Cima del Trueno cuando hayas acabado.‡Aplica el polvo de luna Cenarion a la piedra de lechúcico lunar que se encuentra entre Mulgore y Los Baldíos para provocar a Garraluna. Hecho esto, has de enfrentarte a Garraluna para obtener la fuerza física y de corazón que posee.|nHabla con Turak Tótem de Runa en Cima del Trueno cuando hayas acabado.‡Utiliser la Poussière lunaire cénarienne sur la Pierre des séléniens, entre Mulgore et les Tarides, pour invoquer Lunegriffe. Affronter Lunegriffe, et gagner la force physique et spirituelle qu\'il possède.nnQuand cela est fait, parler à Turak Totem-runique, aux Pitons du Tonnerre.‡使用莫高雷与贫瘠之地交界处的月夜枭兽之石上面的塞纳里奥月尘引出月爪枭兽，然后击败月爪枭兽并吸取它所拥有的身心之力。nn任务完成之后，与雷霆崖的图拉克·符文图腾谈一谈。‡使用莫高雷與貧瘠之地交界處的月夜梟獸之石上面的塞納里奧月塵引出月爪梟獸，然後擊敗月爪梟獸並吸取它所擁有的身心之力。|n任務完成之後，與雷霆崖的圖拉克·符文圖騰談話。',
  }
},
[6004] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡끝나지 않은 임무‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡未竟的事业‡未完成的任務',
    nil,
    'Mate 2 Socorristas Escarlate, 2 Caçadores Escarlate, 2 Magos Escarlate e 2 Cavaleiros Escarlate antes de voltar a Kirsta Sombrafunda, nas Terras Pestilentas Ocidentais.‡Убейте 2 медиков, 2 охотников, 2 волхвов и 2 рыцарей из Алого ордена и вернитесь к Кристе Чернотени в Западных Чумных землях.‡Tötet 2 scharlachrote Sanitäter, 2 scharlachrote Jäger, 2 scharlachrote Magier und 2 scharlachrote Ritter, bevor Ihr zu Kirsta Grubenschatten in den westlichen Pestländern zurückkehrt.‡붉은십자군 의무병 2명, 붉은십자군 사냥꾼 2명, 붉은십자군 마법사 2명, 붉은십자군 기사 2명을 처치하고 서부 역병지대에 있는 키르스타 딥섀도에게 돌아가야 합니다.‡Mata a 2 médicos Escarlata, 2 cazadores Escarlata, 2 magos Escarlata y 2 caballeros Escarlata antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Mata a 2 médicos Escarlata, 2 cazadores Escarlata, 2 magos Escarlata y 2 caballeros Escarlata antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Tuer deux Médecins écarlates, deux Chasseurs écarlates, deux Magi écarlates et deux Chevaliers écarlates avant de revenir vers Kirsta Fondombre dans les Maleterres de l\'ouest.‡杀死2个血色医护员、2个血色猎人、2个血色魔法师和2个血色骑士，然后回到西瘟疫之地的科尔斯塔·迪普沙东那儿。‡殺死2個血色醫護員、2個血色獵人、2個血色魔法師和2個血色騎士，然後回到西瘟疫之地的科爾斯塔·迪普沙東那兒。',
  }
},
[6021] = {
  {
    'Zaeldarr, o Proscrito‡Зельдарр Изгой‡Zaeldarr der Ausgestoßene‡추방자 잴다르‡Zaeldarr el Marginado‡Zaeldarr el Marginado‡Zaeldarr le Banni‡流亡者塞达尔‡『流亡者』塞達爾',
    nil,
    'Leve a Cabeça de Zaeldarr ao Zelador Alen na Capela Esperança da Luz.‡Принесите голову Зельдарра Управляющему Алену в Часовню Последней Надежды.‡Bringt Zaeldarrs Kopf zu Verwalter Alen in der Kapelle des hoffnungsvollen Lichts.‡잴다르를 처치하고 그 증거로 머리카락을 희망의 빛 예배당에 있는 관리인 알렌에게 가져가야 합니다.‡Lleva la cabeza de Zaeldarr al custodio Alen a la Capilla de la Esperanza de la Luz.‡Lleva la cabeza de Zaeldarr al custodio Alen a la Capilla de la Esperanza de la Luz.‡Apporter la Tête de Zaeldarr au Conservateur Alen, à la chapelle de l\'Espoir de Lumière.‡将塞达尔的头颅交给圣光之愿礼拜堂的护理者奥林。‡將塞達爾的頭顱交給聖光之願禮拜堂的護理者奧林。',
  }
},
[6022] = {
  {
    'Matar com propósito‡Преднамеренное убийство‡Töten zu einem bestimmten Zweck‡이유 있는 살육‡Matar con un propósito‡Matar con un propósito‡Tuer utile‡杀戮的理由‡殺戮的理由',
    nil,
    'Vá ao Cruzamento de Corin, a leste, e mate membros do Flagelo que habitam a cidade. Colete 7 pedaços de Putrefação Viva em menos de 10 minutos. Use o Almofariz e Pilão para moer a Putrefação Viva, de maneira a transformá-la em Putrefação Coagulada.‡Отправляйтесь на восток в Перекресток Корина и убейте несколько населяющих его созданий Плети. Соберите 7 кусков живой гнили менее, чем за 10 минут. С помощью ступки и пестика превратите живую гниль в сгущенную гниль.‡Begebt Euch zu Corins Kreuzung im Osten und besiegt die Mitglieder der Geißel, die in der Stadt leben. Sammelt 7 Stücke lebendige Fäulnis in unter 10 Minuten. Zerstoßt die lebendige Fäulnis mit Mörser und Stößel zu geronnener Fäulnis.‡동쪽의 코린 삼거리로 가서 마을에 사는 스컬지를 해치워 10분 안에 살아있는 부패물 7개를 모으십시오. 막자 사발을 사용해서 살아있는 부패물을 갈아 응고된 부패물로 만들어야 합니다.‡Viaja al Cruce de Corin al este y mata a los miembros de la Plaga que habitan allí. Recoge 7 piezas de putrefacción viva en 10 minutos. Utiliza el mortero y el majadero para convertir la putrefacción viva en putrefacción coagulada.‡Viaja al Cruce de Corin al este y mata a los miembros de la Plaga que habitan allí. Recoge 7 piezas de putrefacción viva en 10 minutos. Utiliza el mortero y el majadero para convertir la putrefacción viva en putrefacción coagulada.‡Allez à l\'est à la Croisée de Corin et détruisez les membres du Fléau qui habitent la ville. Rassemblez 7 morceaux de Pourriture vivante en moins de 10 minutes. Utilisez le Mortier et le Pilon pour réduire la Pourriture vivante en Pourriture coagulée.‡到东边的考林路口去屠杀镇里的亡灵天灾。在10分钟内收集7块生命腐质，使用研钵和捣杵将其研磨成凝固腐质。‡到東邊的考林路口去屠殺鎮裡的天譴軍團。在10分鐘內收集7塊生命腐質，使用研缽和搗杵將其研磨成凝固腐質。',
  }
},
[6023] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡끝나지 않은 임무‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡未完的任务‡未完成的任務',
    nil,
    'Mate o Guarda-caça Eiras e o Fidalgo Durgen antes de voltar à Kirsta Sombrafunda, nas Terras Pestilentas Ocidentais.‡Убейте охотника Радли и кавалериста Даргена и вернитесь к Кристе Чернотени в Западные Чумные земли.‡Besiegt Jägerin Radley und Chevalier Durgen, bevor Ihr zu Kirsta Grubenschatten in den westlichen Pestländern zurückkehrt.‡사냥꾼 래들리와 기병 드루겐을 처치하고 서부 역병지대에 키르스타 딥섀도에게 돌아가야 합니다.‡Mata al montero Radley y al hidalgo Durgen antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Mata al montero Radley y al hidalgo Durgen antes de regresar con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Tuer le veneur Radley et le cavalier Durgen, avant de retourner voir Kirsta Fondombre, dans les Maleterres de l\'ouest.‡杀掉猎人莱德雷和骑士杜尔根，然后向西瘟疫之地的科尔斯塔·迪普沙东复命。‡殺掉獵人萊德雷和騎士杜爾根，然後向西瘟疫之地的科爾斯塔·迪普沙東覆命。',
  }
},
[6024] = {
  {
    'A súplica de Hameya‡Мольба Хамейи‡Hameyas Bitte‡하메야의 탄원서‡La súplica de Hameya‡La súplica de Hameya‡L\'appel d\'Hameya‡哈米亚的请求‡哈米亞的請求',
    nil,
    'Mate o Infiltrador Hameya. Use a chave dele no Monturo de Terra atrás da Chácara Secreta.‡Убейте секретного агента Хамейю. С помощью ключа извлеките сокровище из кучи грязи за Криптой.‡Tötet Spitzel Hameya. Benutzt seinen Schlüssel bei dem Erdhaufen hinter dem Tiefgewölbe.‡첩보원 하메야를 처치해야 합니다. 지하 납골당 뒤의 흙무더기에서 그의 열쇠를 사용하십시오.‡Mata al infiltrador Hameya. Usa su llave en el túmulo detrás de La Subgranja.‡Mata al infiltrador Hameya. Usa su llave en el túmulo detrás de La Subgranja.‡Tuer l\'Infiltrateur Hameya. Utiliser sa clé sur le Monticule de poussière, derrière le caveau de Zaeldarr.‡杀了渗透者哈米亚，用他的钥匙开启墓室后的一堆泥土。‡殺了滲透者哈米亞，用他的鑰匙開啟墓室後的一堆泥土。',
  }
},
[6025] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnungen‡끝나지 않은 임무‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡未完的任务‡未完成的任務',
    nil,
    'Entre em Amparo e encontre um lugar alto de onde possa ver a cidade e avaliar as forças da Cruzada Escarlate. Então fale novamente com Kirsta Sombrafunda nas Terras Pestilentas Ocidentais.‡Проберитесь в Дольный Очаг и найдите возвышенность, с которой открывается вид на весь город. Оцените силы Алого ордена и вернитесь к Кристе Чернотени в Западных Чумных землях.‡Geht nach Herdweiler, sucht einen hohen Aussichtspunkt, von dem aus Ihr die Stadt überblicken könnt, schätzt die Streitkräfte des Scharlachroten Kreuzzugs und kehrt dann zu Kirsta Grubenschatten in den westlichen Pestländern zurück.‡하스글렌에 들어가 마을이 잘 보이는 높은 지대를 찾아 붉은십자군 병력 규모를 파악한 다음 서부 역병지대에 있는 키르스타 딥섀도에게 돌아가야 합니다.‡Entra en la Vega del Amparo y busca un punto elevado desde el que puedas ver la ciudad y calcular las fuerzas de la Cruzada Escarlata. Cuando lo hayas hecho regresa con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Entra en la Vega del Amparo y busca un punto elevado desde el que puedas ver la ciudad y calcular las fuerzas de la Cruzada Escarlata. Cuando lo hayas hecho regresa con Kirsta Sombraprofunda en las Tierras de la Peste del Oeste.‡Aller à Âtreval, et trouver un poste d\'observation élevé d\'où voir la ville et jauger les forces de la Croisade écarlate, puis retourner voir Kirsta Fondombre, dans les Maleterres de l\'ouest.‡进入壁炉谷并找一处高地，你可以在那里观察整个城镇并估算血色十字军的兵力，然后向西瘟疫之地的科尔斯塔·迪普沙东回报。‡進入壁爐谷並找一處高地，你可以在那裡觀察整個城鎮並估算血色十字軍的兵力，然後向西瘟疫之地的科爾斯塔·迪普沙東回報。',
  }
},
[6026] = {
  {
    'Isso é pedir muito‡Работу пополам‡Das ist viel verlangt‡여러 가지 부탁‡Eso pide mucho‡Eso pide mucho‡Voilà qui est beaucoup demander‡狮子大开口‡獅子大開口',
    nil,
    'Leandro Leonardo quer que você pegue 2 Barras de Tório, 1 Bastão Dourado, 8 Bombas de Alto-explosivo e 8 Gatilhos Instáveis.nnVocê terá que encontrar um ferreiro e um engenheiro para esses itens.‡Принесите 2 ториевых слитка, 1 золотой жезл, 8 высоковзрывчатых бомб и 8 нестабильных детонаторов Смоки Ля Рю.nnДля этого вам придется найти кузнеца и инженера.‡Smokey LaRue möchte, dass Ihr 2 Thoriumbarren, 1 Goldrute, 8 hochexplosive Bomben und 8 instabile Auslöser beschafft.nnFür diese Gegenstände müsst Ihr einen Schmied und einen Ingenieur finden.‡토륨 주괴 2개, 금마법막대 1개, 고폭탄 8개, 유동성 제동장치 8개를 스모키 라루에게 가져가야 합니다.nn해당 물건을 모으려면 대장장이와 기계공학 기술자를 찾아야 합니다.‡Smokey LaRue quiere que consigas 2 barras de torio, 1 vara dorada, 8 bombas de gran carga y 8 disparadores inestables.nnTendrás que encontrar a un herrero y a un ingeniero para conseguir esos objetos.‡Smokey LaRue quiere que consigas 2 barras de torio, 1 vara dorada, 8 bombas de gran carga y 8 disparadores inestables.|nTendrás que encontrar a un herrero y a un ingeniero para conseguir esos objetos.‡Smokey LaRue veut que vous lui apportiez 2 Barres de thorium, 1 Bâtonnet doré, 8 Bombes explosives et 8 Déclencheurs instables.nnVous devrez trouver un forgeron et un ingénieur pour obtenir ces objets.‡烟鬼拉鲁恩要你拿来2块瑟银锭、1根金棒、8颗高爆炸弹和8个不牢固的扳机。nn你需要找铁匠和工程学技师帮忙制作这些东西。‡煙鬼拉魯恩要你拿來2塊瑟銀錠、1根金棒、8顆高爆爆裂物和8個不牢固的扳機。|n你需要找鐵匠和工程師幫忙製作這些東西。',
  }
},
[6027] = {
  {
    'O Livro dos Anciãos‡Книга Древних‡Buch der Uralten‡고대의 책‡El Libro de los Ancestros‡El Libro de los Ancestros‡Le Livre des Anciens‡上古之书‡上古之書',
    nil,
    'Pegue o Livro dos Anciãos e entregue-o para Azore Albamorte na torre de Ethel Rethor.‡Отыщите Книгу Древних и принесите ее Азору Альдаморту в башню Этель-Ретор.‡Beschafft das \'Buch der Uralten\' und kehrt zu Azore Aldamort im Turm von Ethel Rethor zurück.‡고대의 책을 손에 넣은 다음 에텔 레소르의 탑에 있는 아조레 알다모트에게 가져가야 합니다.‡Consigue el Libro de los Ancestros y llévaselo a Azore Aldamort a la torre de Ethel Rethor.|n‡Consigue el Libro de los Ancestros y llévaselo a Azore Aldamort a la torre de Ethel Rethor.‡Obtenir le Livre des Anciens, puis le rapporter à Azore Aldamort, dans la tour d\'Ethel Rethor.‡拿到上古之书，将其交给艾瑟雷索塔中的阿佐尔·奥达蒙特。‡拿到上古之書，將其交給艾瑟雷索高塔的阿佐爾·奧達蒙特。',
  }
},
[6028] = {
  {
    'O relatório de Visteterna‡Донесение из Круговзора‡Der Bericht der Ewigen Warte‡눈망루 마을 보고서‡El informe Vista Eterna‡El informe Vista Eterna‡Le rapport de Long-guet‡永望镇报告‡永望鎮報告',
    nil,
    'Entregue o Relatório de Visteterna à Oficial Argêntea Cândida no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Доставьте донесение из Круговзора офицеру Чистосердой из ордена Серебряного Рассвета в Лагерь Промозглого Ветра в Западных Чумных землях.‡Bringt den Bericht der Ewigen Warte zu Argentumoffizier Reinherz im Zugwindlager in den westlichen Pestländern.‡서부 역병지대, 서리바람 야영지에 있는 은빛장교 퓨어하트에게 눈망루 마을 보고서를 전달해야 합니다.‡Entrega el informe de Vista Eterna a la oficial Argenta Purocorazón en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Entrega el informe de Vista Eterna a la oficial Argenta Purocorazón en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apportez le Rapport de Long-guet à l\'officier de l\'Aube d\'argent Purecarde au Camp du Noroît, dans les Maleterres de l\'ouest.‡把永望镇报告送给西瘟疫地冰风岗的银色黎明军官普尔哈特。‡把永望鎮報告送給西瘟疫地冰風營地的銀色黎明軍官普爾哈特。',
  }
},
[6029] = {
  {
    'O relatório de Visteterna‡Донесение из Круговзора‡Der Bericht der Ewigen Warte‡눈망루 마을 보고서‡El informe Vista Eterna‡El informe Vista Eterna‡Le rapport de Long-guet‡永望镇报告‡永望鎮報告',
    nil,
    'Entregue o Relatório de Visteterna ao Oficial Argênteo Garush no Baluarte, nas Terras Pestilentas Ocidentais.‡Доставьте донесение из Круговзора офицеру Гарушу из ордена Серебряного Рассвета в Бастион в Западных Чумных землях.‡Bringt den Bericht der Ewigen Warte zu Argentumoffizier Garush im Bollwerk in den westlichen Pestländern.‡서부 역병지대 보루에 있는 은빛장교 가루쉬에게 눈망루 마을 보고서를 전달해야 합니다.‡Entrega el informe de Vista Eterna al oficial Argenta Garush en El Baluarte, en las Tierras de la Peste del Oeste.‡Entrega el informe de Vista Eterna al oficial Argenta Garush en El Baluarte, en las Tierras de la Peste del Oeste.‡Livrer le Rapport de Long-guet à l\'officier Garush de l\'Aube d\'argent, à la Barricade, dans les Maleterres de l\'ouest.‡把永望镇报告送给西瘟疫地亡灵壁垒的银色黎明军官加鲁什。‡把永望鎮報告送給西瘟疫地亡靈壁壘的銀色黎明軍官加魯什。',
  }
},
[6030] = {
  {
    'Duque Nicolau Zverenhoff‡Герцог Николас Зверенхофф.‡Fürst Nicholas Zverenhoff‡공작 니콜라스 즈바른호프‡Duque Nicolas Zverenhoff‡El duque Nicolas Zverenhoff‡Le duc Nicholas Zverenhoff‡尼古拉斯·瑟伦霍夫公爵‡尼古拉斯·瑟倫霍夫公爵',
    nil,
    'Entregue o livro "Estudos sobre Comunicação com Espíritos" ao Duque Nicolau Zverenhoff na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Доставьте книгу "Исследования речи духов" Герцогу Николасу Зверенхоффу в Часовню Последней Надежды в Восточных Чумных землях.‡Bringt das Buch \'Studien über das Geistsprechen\' zu Fürst Nicholas Zverenhoff in der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대 희망의 빛 예배당에 있는 공작 니콜라스 즈바른호프에게 "영적인 대화에 대한 논문"이라는 책을 전해야 합니다.‡Entrega el libro, "Estudios sobre la Comunicación con los Espíritus", al duque Nicolas Zverenhoff en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Entrega el libro, "Estudios sobre la Comunicación con los Espíritus", al duque Nicolas Zverenhoff en la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le livre " Etudes sur la langue des Esprits " au duc Nicholas Zverenhoff, à la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est.‡将《灵语研究》这本书交给东瘟疫之地圣光之愿礼拜堂的尼古拉斯·瑟伦霍夫公爵。‡將《靈語研究》這本書交給東瘟疫之地聖光之願禮拜堂的尼古拉斯·瑟倫霍夫公爵。',
  }
},
[6031] = {
  {
    'Runatrama‡Руническая ткань‡Runenstoff‡룬매듭‡Paño rúnico‡Paño rúnico‡L\'étoffe runique‡符文布‡符文布',
    nil,
    'Leve 30 cortes de Runatrama para Meilosh no Domínio dos Presamatos.‡Принесите 30 отрезов рунической ткани Мелиошу в крепость Древобрюхов.‡Bringt 30 Runenstoff zu Meilosh in der Holzschlundfeste.‡나무구렁 요새에 있는 메일로쉬에게 룬매듭 30개를 가져가야 합니다.‡Llévale 30 paños rúnicos a Meilosh, que está en el Bastión Fauces de Madera.‡Llévale 30 paños rúnicos a Meilosh, que está en el Bastión Fauces de Madera.‡Apportez 30 pièces d\'étoffe runique à Meilosh au Repaire des Grumegueules.‡把30块符文布交给木喉要塞的梅罗什。‡把30塊符文布交給木喉要塞的梅羅西。',
  }
},
[6032] = {
  {
    'Tecido sagrado‡Священная ткань‡Hochheiliger Stoff‡신성한 옷감‡Tela sagrada‡Tela sagrada‡Le vêtement sacré‡神圣的月布‡神聖的月布',
    nil,
    'Leve 2 cortes de Lunatrama para Meilosh no Domínio dos Presamatos.‡Принесите 2 отреза луноткани Мелиошу в крепость Древобрюхов.‡Bringt 2 Mondstoff zu Meilosh in der Holzschlundfeste.‡나무구렁 요새에 있는 메일로쉬에게 달빛매듭 2개를 갖다주어야 합니다.‡Llévale 2 retales de tela lunar a Meilosh, que está en el Bastión Fauces de Madera.‡Llévale 2 retales de tela lunar a Meilosh, que está en el Bastión Fauces de Madera.‡Apporter 2 pièces d\'Etoffe lunaire à Meilosh, au Repaire des Grumegueules.‡把2块月布交给木喉要塞的梅罗什。‡把2塊月布交給木喉要塞的梅羅西。',
  }
},
[6041] = {
  {
    'Quando Leandro canta, eu fico violento‡Дымок над водою‡When Smokey Sings, I Get Violent‡짜증나는 스모키의 노래‡Cuando Smokey canta, me pongo violento‡Cuando Smokey canta, me pongo violento‡Quand Smokey chante, je deviens violent‡烟鬼的炸药‡煙鬼的炸藥',
    nil,
    'Viaje ao Bosque Pestilento, a noroeste da Esperança da Luz. Destrua 8 Estruturas do Flagelo usando o Composto Químico Especial do Leandro na Marca de Detonação plantada dentro de cada construção. Os Zigurates e Abatedouros foram marcados por instrução de Leandro.nnAssim que você plantar a bomba, deixe a estrutura e contemple seu trabalho.nnA propósito, o Composto Químico Especial do Leandro é bastante... instável.‡Отправляйтесь в Проклятый лес, к северо-западу от часовни Светлых надежд. Уничтожьте 8 строений Плети, отмеченных знаком взрыва, поместив особый состав Дымка внутрь строения. Дымок отметил зиккураты и бойни.nnРазместив бомбу внутри строения, немедленно выбирайтесь наружу и любуйтесь делом рук своих с безопасного расстояния. nnАх да, вот еще что, особый состав Дымка – вещество весьма нестабильное.‡Reist in den Pestwald, nordwestlich der Hoffnung des Lichts. Zerstört 8 Geißelbauwerke, indem Ihr Smokeys spezielles Präparat am Mal der Zerstörung in jedem Bauwerk benutzt. Smokey hat die Ziggurats und Schlachthäuser markieren lassen.nnWenn ihr die Bombe gelegt habt, dann verlasst das Bauwerk und staunt über Euer Geschick.nnÜbrigens, Smokeys spezielles Präparat ist recht...instabil.‡희망의 빛 예배당 북서쪽에 있는 역병의 숲으로 가십시오. 스모키의 특수혼합물을 건물 안에 부착하여, 폭파 표시가 있는 스컬지 건물 8개를 파괴해야 합니다. 스모키가 지구라트와 도살장에 징표를 남겼습니다.nn폭탄을 부착한 후에는 건물에서 나와 폭발 광경을 지켜 보세요.nn그건 그렇고 스모키의 특수혼합물은 다소 불안정합니다.‡Viaja al Bosque de la Peste, al noroeste de la Esperanza de la Luz. Destruye 8 estructuras de la Plaga utilizando el compuesto especial de Smokey en la marca de detonación que hay en el interior de cada edificio. Smokey ha hecho marcar los zigurats y los degolladeros.nnCuando plantes la bomba, sal del edificio y disfruta del espectáculo.nnPor cierto, el compuesto especial de Smokey es... bastante inestable.‡Viaja al Bosque de la Peste, al noroeste de la Esperanza de la Luz. Destruye 8 estructuras de la Plaga utilizando el compuesto especial de Smokey en la marca de detonación que hay en el interior de cada edificio. Smokey ha hecho marcar los zigurats y los degolladeros.|nCuando plantes la bomba, sal del edificio y disfruta del espectáculo.|nPor cierto, el compuesto especial de Smokey es... bastante inestable.‡Aller à Pestebois, au nord-ouest de la chapelle de l\'Espoir de Lumière. Détruire 8 Bâtiments du Fléau en utilisant le Mélange spécial de Smokey sur les Marques de détonation que portent les bâtiments destinés à être détruits. Smokey a fait marquer les ziggourats et les abattoirs.nnUne fois la bombe placée, quitter le bâtiment et contempler le résultat de votre opération.nnGarder en tête que le Mélange spécial de Smokey est très... instable.‡到圣光之愿礼拜堂西北方的病木林去。在那些有爆炸标记的建筑物中对爆炸标记使用烟鬼的特殊混合物，以此来摧毁8座亡灵天灾建筑。烟鬼已经给通灵塔和屠宰房做上了标记。nn一旦你放置好炸弹，就离那些建筑物远一些，然后尽情欣赏你的杰作吧。nn顺便说一句，烟鬼的特殊混合物相当不稳定......‡到聖光之願禮拜堂西北方的病木林去。在那些有爆炸標記的建築物中對爆炸標記使用煙鬼的特殊混合物，以此來摧毀8座天譴軍團建築。煙鬼已經給通靈塔和屠宰房做上了標記。|n一旦你放置好炸彈，就離那些建築物遠一些，然後盡情欣賞你的傑作吧。|n順便說一句，煙鬼的特殊混合物相當……不穩定。',
  }
},
[6042] = {
  {
    'Pequenos transtornos da Morte-em-Vida‡Мелочи нежизни‡Die kleinen Ärgernisse des Un-Lebens‡성가신 녀석들‡Los pequeños problemas de la no-vida‡Los pequeños problemas de la no-vida‡Les petits soucis de la non-vie‡讨厌的蝙蝠‡討厭的蝙蝠',
    nil,
    'Mate 20 Quirópragos Nóxios e 10 Quirópragos Monstruosos. Fale novamente com Nathanos Arauto da Praga quando você tiver terminado.‡Истребите 20 пагубных нетопырей и 10 чудовищных чумных нетопырей. После возвращайтесь к Натаносу Гнилостеню.‡Erschlagt 20 giftige Seuchenfledermäuse und 10 monströse Seuchenfledermäuse. Kehrt zu Nathanos Pestrufer zurück, wenn Ihr fertig seid.‡맹독 역병박쥐 20마리와 기괴한 역병박쥐 10마리를 해치운 후 나타노스 블라이트 콜러에게 돌아가야 합니다.‡Mata a 20 murcipestes tóxicos y 10 murcipestes monstruosos. Vuelve con Nathanos Clamorinfecto cuando hayas acabado.‡Mata a 20 murcipestes tóxicos y 10 murcipestes monstruosos. Vuelve con Nathanos Clamañublo cuando hayas acabado.‡Tuer 20 Chauves-souris pestiférées nuisibles et 10 Chauves-souris pestiférées monstrueuses. Retourner voir Nathanos le Flétrisseur quand ce sera fait.‡杀掉20只毒性瘟疫蝙蝠和10只巨型瘟疫蝙蝠，然后回到纳萨诺斯·凋零者那里。‡殺掉20隻毒性瘟疫蝙蝠和10隻巨型瘟疫蝙蝠，然後回到納薩諾斯·凋零者那裡。',
  }
},
[6061] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡',
    nil,
    'Use o Bastão de Adestramento para domar um Pinote Adulto. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Yaw Crina Cortante na Aldeia Casco Sangrento.‡Приручите взрослого равнинного долгонога при помощи хлыста приручения. Потренируйтесь и верните хлыст Йо Колкой Гриве в Деревне Кровавого Копыта.‡Benutzt die Zähmrute, um einen ausgewachsenen Ebenenschreiter zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Yaw Scharfmähne ins Dorf der Bluthufe.‡조련용 막대를 사용해 다자란 초원타조를 길들이고 기술을 연습한 후 블러드후프 마을에 있는 요 샤프메인에게 조련용 막대를 돌려줘야 합니다.‡Usa la fusta de doma para domar un zancudo de llanura adulto. Practica un poco y devuélvele la fusta a Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Usa la fusta de doma para domar un zancudo de llanura adulto. Practica un poco y devuélvele la fusta a Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Utiliser le Bâtonnet de domptage pour dompter un trotteur des plaines adulte. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Yaw Crin-tranchant, à Sabot-de-sang.‡使用驯兽棒驯服成年陆行鸟。练习你的技能，然后将驯兽棒还给血蹄村的雅文·刺鬃。‡',
  }
},
[6062] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡',
    nil,
    'Use o Bastão de Adestramento para domar uma Mosquetusco Hediondo. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Thotar no Monte Navalha.‡Приручите лютого пятнистого вепря с помощью хлыста приручения. Потренируйтесь, потом верните хлыст приручения Тотару в Колючем Холме.‡Benutzt die Zähmrute, um einen scheckigen Terroreber zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Thotar in Klingenhügel.‡조련용 막대를 사용해 사나운 점박이멧돼지를 길들여야 합니다. 기술을 연습한 후 칼바위 언덕에 있는 소타르에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de doma para domar un jabalí jaspeado temible. Practica un poco y devuélvele la fusta a Thotar en Cerrotajo.‡Usa la fusta de doma para domar un jabalí jaspeado temible. Practica un poco y devuélvele la fusta a Thotar en Cerrotajo.‡Utiliser le Bâtonnet de domptage pour dompter un sanglier tacheté redoutable. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Thotar de Tranchecolline.‡使用驯兽棒驯服可怕的杂斑野猪。练习你的技能，然后将驯兽棒还给剃刀岭的索塔尔。‡',
  }
},
[6063] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar uma Tocaieira Lenhateia. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Dazalar em Dolanaar.‡С помощью хлыста приручения приручите чащобного тенетника. Поупражняйтесь, затем верните хлыст приручения Дазалару в Доланаар.‡Benutzt die Zähmrute, um einen Waldweberlauerer zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Dazalar in Dolanaar.‡조련용 막대를 사용해 나무그물 늑대거미를 길들여야 합니다. 기술을 연습한 후 돌라나르에 있는 다잘라에게 조련용 막대를 돌려주어야 합니다.‡Utiliza la fusta de doma para domar a un rondador Tejemadera. Practica tus habilidades y después devuélvele la fusta de doma a Dazalar, que está en Dolanaar.‡Utiliza la fusta de doma para domar a un rondador Tejemadera. Practica tus habilidades y después devuélvele la fusta de doma a Dazalar, que está en Dolanaar.‡Utiliser le Bâtonnet de domptage pour dompter une Rôdeuse Tissebois. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Dazalar, à Dolanaar.‡使用驯兽棒驯服树林潜伏者。练习你的技能，然后将驯兽棒还给多兰纳尔的达扎拉。‡使用馴獸棒馴服樹林潛伏者。練習你的技能，然後將馴獸棒還給多蘭納爾的達札拉。',
  }
},
[6064] = {
  {
    'Domando a fera‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡',
    nil,
    'Use o Bastão de Adestramento para domar uma Rochetusco Grande. Pratique sua habilidade e depois devolva o Bastão de Adestramento a Grif Selvacuore em Kharanos.‡Приручите большого скального вепря с помощью хлыста приручения. Потренируйтесь со своим новым питомцем, а затем верните хлыст приручения Грифу Дикому Сердцу в Каранос.‡Benutzt die Zähmrute, um einen großen Klippeneber zu zähmen. Übt Eure Fertigkeiten und bringt die Zähmrute dann zu Grif Wildherz in Kharanos.‡조련용 막대를 사용해 큰 멧돼지를 길들여야 합니다. 기술을 연습한 후 카라노스에 있는 그리프 와일드하트에게 조련용 막대를 돌려주어야 합니다.‡Usa la fusta de doma para domar a un gran jabalí del risco. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Usa la fusta de doma para domar a un jabalí del risco grande. Practica un poco y devuélvele la fusta a Grif Corazón Salvaje en Kharanos.‡Utiliser le Bâtonnet de domptage pour dompter un Grand sanglier des rochers. S\'entraîner à combattre à ses côtés, puis rapporter le Bâtonnet de domptage à Grif Cœur-sauvage, à Kharanos.‡使用驯兽棒驯服大型峭壁野猪。练习你的技能，然后将驯兽棒还给卡拉诺斯的格瑞夫。‡',
  }
},
[6065] = {
  {
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡',
    nil,
    'Fale com Yaw Crina Cortante na Aldeia Casco Sangrento.‡Поговорите с Йо Колкой Гривой в Деревне Кровавого Копыта.‡Sprecht mit Yaw Scharfmähne im Dorf der Bluthufe.‡블러드후프 마을에 있는 요 샤프메인과 대화해야 합니다.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre, en Mulgore.‡Parler à Yaw Crin-tranchant, à Sabot-de-sang.‡与血蹄村的雅文·刺鬃谈一谈。‡',
  }
},
[6066] = {
  {
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡',
    nil,
    'Fale com Yaw Crina Cortante na Aldeia Casco Sangrento.‡Поговорите с Йо Колкой Гривой в Деревне Кровавого Копыта.‡Sprecht mit Yaw Sharpmane in Bloodhoof.‡블러드후프 마을에 있는 요 샤프메인과 대화해야 합니다.‡Habla con Yaw Trampa en el Poblado Pezuña de Sangre.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre, en Mulgore.‡Parler à Yaw Sharpmane, au village Bloodhoof.‡与血蹄村的雅文·刺鬃谈一谈。‡',
  }
},
[6067] = {
  {
    'O caminho do caçador‡Путь охотника‡Der Weg des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡',
    nil,
    'Fale com Yaw Crina Cortante na Aldeia Casco Sangrento.‡Поговорите с Йо Колкой Гривой в Деревне Кровавого Копыта.‡Sprecht mit Yaw Scharfmähne im Dorf der Bluthufe.‡블러드후프 마을에 있는 요 샤프메인과 대화해야 합니다.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre.‡Habla con Yaw Crinafilada en el Poblado Pezuña de Sangre, en Mulgore.‡Parler à Yaw Crin-tranchant, à Sabot-de-sang.‡与血蹄村的雅文·刺鬃谈一谈。‡',
