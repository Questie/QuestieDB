[5658] = {
  {
    'Toque de Fraqueza‡Прикосновение слабости‡Berührung der Schwäche‡무력의 손길‡Toque de debilidad‡Toque de debilidad‡Toucher de faiblesse‡虚弱之触‡',
    nil,
    '‡А, юный жрец снова здесь. Я хочу преподать тебе урок, который ты не скоро забудешь. Готов ли ты?‡Ah, junger <Klasse>, ich bin froh, dass Ihr hierher zurückgekehrt seid. Ich würde Euch gerne eine Lektion lehren, die Ihr besser nicht vergessen solltet. Seid Ihr bereit?‡‡‡‡Ah jeune <classe> ! Je suis ravie de vous revoir. Je vais vous enseigner quelque chose que vous n\'êtes pas près d\'oublier. D\'accord ?‡‡',
  }
},
[5660] = {
  {
    'Toque de Fraqueza‡Прикосновение слабости‡Berührung der Schwäche‡무력의 손길‡Toque de debilidad‡Toque de debilidad‡Toucher de faiblesse‡虚弱之触‡',
