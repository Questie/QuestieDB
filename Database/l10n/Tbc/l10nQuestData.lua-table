},
[11875] = {
  {
    'Tomando a dianteira‡Обретение преимущества‡Einen Vorteil gewinnen‡공격대 지원‡Lograr ventaja‡Lograr ventaja‡Prendre l\'avantage‡占据上风‡',
    nil,
    'Leve 8 Resíduos de Éter ao Emissário Mordin em Shattrath.‡Принесите 8 горстей пыли Пустоты эмиссару Мордину в Шаттрат.‡Bringt dem Abgesandten Mordin in Shattrath 8 Netherrückstände.‡샤트라스에 있는 사절 모르딘에게 황천의 잔류물 8개를 가져가야 합니다.‡Llévale 8 residuos abisales al emisario Mordin en la Ciudad de Shattrath.‡Llévale 8 residuos abisales al emisario Mordin en la Ciudad de Shattrath.‡Apportez 8 Résidus de Néant à l’Émissaire Mordin, à Shattrath.‡给沙塔斯城的摩尔丁特使带去8份虚空残渣。‡',
  }
},
[11877] = {
  {
    'Plano de Ataque dos Solfúria‡План нападения клана Ярости Солнца‡Angriffspläne des Sonnenzorns‡성난태양 공격 계획서‡Planes de ataque de Furia del Sol‡Planes de ataque de Furia del Sol‡Les plans d\'attaque solfurie‡日怒攻击计划‡日怒攻擊計畫',
    nil,
    'Lorde Torvos, em Shattrath, quer que você obtenha o Plano de Ataque dos Solfúria.‡Лорд Торвос из Шаттрата хочет, чтобы вы захватили планы нападения клана Ярости Солнца.‡Lord Torvos in Shattrath möchte, dass Ihr die Angriffspläne des Sonnenzorns beschafft.‡샤트라스에 있는 토르보스 경이 성난태양 공격 계획서를 가져다 달라고 했습니다.‡Lord Torvos en la Ciudad de Shattrath quiere que consigas los planes de ataque Furia del Sol.‡Lord Torvos en la Ciudad de Shattrath quiere que consigas los planes de ataque Furia del Sol.‡Le Seigneur Torvos, à Shattrath, veut que vous vous empariez des Plans d’attaque solfurie.‡沙塔斯城的托沃斯男爵希望你能缴获日怒攻击计划。‡撒塔斯的托沃斯領主要你前去取得日怒攻擊計畫。',
  }
},
[11880] = {
  {
    'Sondagem multifásica‡Мультифазовый подход‡Die Multiphasen-Vermessung‡다상 소용돌이 조사‡La investigación multifase‡La investigación multifase‡L’examen multiphase‡多相数据调查‡多相測量',
    nil,
    'O Precursor Haronem, em Shattrath, quer que você use os Óculos Espectrográficos Multifásicos para obter 6 Leituras Multifásicas.‡Предвестник Харонем из Шаттрата просит вас при помощи мультифазовых спектрографических очков 6 раз провести считывание мультифазовых данных.‡Herold Haronem in Shattrath möchte, dass Ihr die spektrografische Multiphasenbrille benutzt, um 6 Multiphasenmessungen durchzuführen.‡샤트라스에 있는 선구자 하로넴이 다상분광 고글을 사용해 다상 도수를 6번 측정해 달라고 했습니다.‡El presagista Haronem de la Ciudad de Shattrath quiere que uses las gafas espectrográficas multifase para obtener 6 lecturas multifase.‡El presagista Haronem de la Ciudad de Shattrath quiere que uses las gafas espectrográficas multifase para obtener 6 lecturas multifase.‡Le Messager Haronem, à Shattrath, veut que vous utilisiez les Lunettes spectographiques multiphases pour prendre 6 Relevés multiphases.‡沙塔斯城的先驱者哈隆奈姆希望你使用多相光谱护目镜去获取6份多相数据。‡撒塔斯城的先驅者哈洛尼恩希望你使用多相光譜護目鏡來取得6個多相讀數。',
  }
},
[11882] = {
  {
    'Brincando com fogo‡Игра с огнем‡Spiel mit dem Feuer‡불장난‡Jugando con fuego‡Jugando con fuego‡Jouer avec le feu‡玩火‡玩火',
    nil,
    'Fale com um Mestre Engolidor de Fogo em qualquer capital da Aliança.‡Поговорите с мастером-огнеглотателем в любой из столиц Альянса.‡Sprecht mit einem Feuerschluckmeister in einer der Hauptstädte.‡얼라이언스 대도시에 있는 불꽃마술의 대가와 대화해야 합니다.‡Habla con un maestro tragafuegos en cualquiera de las capitales de la Alianza.‡Habla con un maestro tragafuegos en cualquiera de las capitales de la Alianza.‡Parlez à un Maître cracheur de feu dans n\'importe quelle capitale de l\'Alliance.‡与任意联盟主城的吞火大师谈一谈。‡跟任一個何聯盟主城的吞火者大師談談。',
  }
},
[11883] = {
  {
    'Dança do Fogo?‡Танцы с огнем?‡Feuertanzen?‡불춤?‡¿Danza con fuego?‡¿Danza con fuego?‡La danse de feu‡火焰的舞蹈？‡火舞?',
    nil,
    'Fale com uma Mestre Dançarina do Fogo em qualquer capital da Horda.‡Поговорите с мастером огненного танца в любой из столиц Орды.‡Sprecht mit einem Feuertanzmeister in einer der Hauptstädte.‡호드 주요 도시에 있는 불춤의 대가와 대화해야 합니다.‡Habla con un maestro de danza del fuego en cualquier capital de la Horda.‡Habla con un maestro de danza del fuego en cualquier capital de la Horda.‡Parlez à un Maître danseur de feu dans n\'importe quelle capitale de la Horde.‡与任意部落主城的火舞大师谈一谈。‡跟任一個何部落主城的火舞者大師談談。',
  }
},
[11885] = {
  {
    'Sangue adversário‡Кровные враги‡Feindesblut‡적의 피‡Sangre adversaria‡Sangre adversaria‡Lignées antagonistes‡仇敌的血脉‡',
    nil,
    'Encontre as Pilhas de Crânios no meio dos círculos de evocação em Skettis. Evoque e derrote cada um dos descendentes usando 10 Pergaminhos perdidos no tempo na Pilha de Crânios. Fale novamente com Hazzik no Campo de Pouso Ventonegro.‡Найдите груды черепов в середине кругов призыва Скеттиса. С помощью 10 свитков затерянных во времени призовите каждого потомка Скеттиса, уничтожьте их и отнесите трофеи Хаззику в лагерь Черного Ветра.‡Findet die Schädelhaufen innerhalb der Beschwörungskreise in Skettis. Beschwört die Nachfahren, indem Ihr 10 zeitverlorene Schriftrollen am Schädelhaufen benutzt und bezwingt sie. Kehrt mit einem Beweisstück von jedem zu Hakkiz am Schattenwindlager zurück.‡스케티스에서 소환 마법진과 해골 더미를 찾은 후, 잃어버린 시간의 두루마리 10개씩을 해골더미에 사용하여 자손들을 소환해야 합니다. 자손들을 처치하고 검은바람 비행기지에 있는 하지크에게 가야 합니다.‡Encuentra los montones de cráneos en el centro de los círculos de invocación de Skettis. Invoca y derrota a cada uno de los descendientes usando 10 Pergaminos perdidos en el Tiempo en el montón de cráneos. Vuelve a ver a Hazzik al Alto de los Vientonegro.‡Encuentra los montones de cráneos en el centro de los círculos de invocación de Skettis. Invoca y derrota a cada uno de los descendientes usando 10 Pergaminos perdidos en el Tiempo en el montón de cráneos. Vuelve a ver a Hazzik al Alto de los Vientonegro.‡Trouvez les Piles de crânes au milieu des cercles d\'invocation de Skettis. Invoquez et vainquez chacun des descendants des adversaires de Terokk en utilisant 10 Parchemins perdus dans le temps à la Pile de crâne. Retournez ensuite auprès de Hazzik au Raie\'odrome de Noirvent.‡在斯克提斯寻找召唤法阵中的徽记堆，用10张迷时卷轴召唤出一个泰罗克仇敌的后裔，并击败总共四个泰罗克仇敌的后裔。完成任务之后回去向黑风码头的哈吉克复命。‡',
  }
},
[11886] = {
  {
    'Atividade incomum‡Необычная активность‡Ungewöhnliche Aktivitäten‡이상한 활동‡Actividad sospechosa‡Actividad sospechosa‡Une activité inhabituelle‡反常的活动‡不尋常的活動',
    nil,
    'Vá para o novo Acampamento do Crepúsculo, ao sul da Entrada das Profundezas Negras, na Praia de Zoram - a qual fica no Vale Gris - e pegue a Correspondência do Crepúsculo dos sectários. Depois, convoque o Guia da Harmonia Telúrica usando a Lanterna Totêmica.‡Отправляйтесь в новый лагерь культа Сумеречного Молота к югу от входа в Непроглядную Пучину на Зорамском взморье, что в Ясеневом лесу, и добудьте сумеречную корреспонденцию, затем при помощи тотема-маяка свяжитесь с проводником из Служителей Земли.‡Geht zum Lager des Schattenhammers südlich des Eingangs zur Tiefschwarzen Grotte am Zoramstrand im Eschental und sucht nach Briefen des Schattenhammers. Die Kultisten werden sie voraussichtlich bei sich tragen. Benutzt anschließend das totemische Leuchtfeuer, um einen Führer des Irdenen Rings zu beschwören.‡잿빛 골짜기의 조람 해안, 검은심연의 나락의 남쪽에 있는 새로운 황혼의 야영지로 가서, 신도들에게서 암호화된 황혼의 서신을 입수한 후 신호 토템을 사용하여 속세의 고리회 인도자를 불러야 합니다.‡Ve hasta el nuevo Campamento Crepúsculo al sur de la entrada a las Cavernas de Brazanegra en La Ensenada de Zoram de Vallefresno y recupera la correspondencia Crepuscular de los fieles. Después, pide la ayuda del guía Anillo de la Tierra mediante la baliza totémica.‡Ve hasta el nuevo Campamento Crepuscular, al sur de la entrada a las Cavernas de Brazanegra en La Ensenada de Zoram de Vallefresno, y recupera la correspondencia Crepuscular de los cultores. Después, invoca al guía del Anillo de la Tierra mediante la baliza totémica.‡Rendez-vous au nouveau Camp du Crépuscule, au sud de l\'entrée des Profondeurs de Brassenoire sur la grève de Zoram, dans Orneval, et récupérez la Correspondance du crépuscule sur les sectateurs. Puis appelez le Guide du Cercle terrestre en utilisant la Balise totémique.‡前往灰谷的佐拉姆海岸，在黑暗深渊入口以南寻找新建的暮光营地，从该处的暮光教徒身上搜寻暮光信件，然后使用图腾信标召唤大地之环幽灵狼。‡前往位於梣谷，佐拉姆海岸的黑暗深淵入口南邊新成立的暮光營地。為陶土議會找出答案，然後使用圖騰信號召喚陶土議會嚮導。',
  }
},
[11891] = {
  {
    'Um disfarce inocente‡Невинный маскарад‡Eine unschuldige Verkleidung‡단순한 변장‡Un disfraz inofensivo‡Un disfraz inofensivo‡Un déguisement innocent‡人畜无害‡',
    nil,
    'Use o Orbe do Caranguejo para espionar o novo Acampamento do Crepúsculo a oeste da Entrada das Profundezas Negras na Praia de Zoram do Vale Gris. Depois, evoque o Guia da Harmonia Telúrica usando a Lanterna Totêmica.‡При помощи сферы Краба проникните в новый Сумеречный лагерь к западу от входа в Непроглядную Пучину на Зорамском взморье в Ясеневом лесу, затем вызовите проводника из Служителей Земли при помощи тотема-маяка.‡Benutzt die Krabbenkugel und spioniert das neue Lager des Schattenhammers aus. Es befindet sich westlich des Eingangs zur Tiefschwarzen Grotte auf dem Zoramstrand im Eschental. Benutzt anschließend das totemische Leuchtfeuer, um den Führer des Irdenen Rings zu beschwören.‡잿빛 골짜기의 조람 해안, 검은심연 나락의 서쪽에 있는 새로운 황혼의 야영지로 가서 딸각게의 수정구를 사용하여 대화를 엿듣고, 신호 토템을 사용하여 대지 고리회 인도자를 소환해야 합니다.‡Utiliza el orbe del reptador para espiar en el nuevo Campamento Crepuscular al oeste de la entrada de las Cavernas de Brazanegra en La Ensenada de Zoram en Vallefresno, luego invoca al guía del Anillo de la Tierra usando la baliza totémica.‡Utiliza el orbe del reptador para espiar en el nuevo Campamento Crepúsculo al oeste de la entrada de las Cavernas de Brazanegra en La Ensenada de Zoram en Vallefresno.‡Servez-vous de l’Orbe du clampant pour espionner le nouveau Camp du Crépuscule, à l’ouest des Profondeurs de Brassenoire, sur la grève de Zoram, en Orneval. Ensuite, invoquez le Guide du Cercle terrestre à l\'aide de la Balise totémique.‡在灰谷佐拉姆海岸的黑暗深渊入口以西寻找新建的暮光营地，使用螃蟹宝珠打探情报，然后使用图腾信标召唤大地之环幽灵狼。‡',
  }
},
[11915] = {
  {
    'Brincando com fogo‡Игра с огнем‡Spiel mit dem Feuer‡불놀이‡Jugando con fuego‡Jugando con fuego‡Jouer avec le feu‡玩火‡玩火',
    nil,
    'Fale com um Mestre Engolidor de Chamas em qualquer capital da Horda.‡Поговорите с пламеглотателем-виртуозом в любой из столиц Орды.‡Sprecht mit einem Feuerschluckmeister in einer der Hordehauptstädte.‡호드 대도시에 있는 불꽃 마술의 대가와 대화해야 합니다.‡Habla con un maestro tragallamas en cualquiera de las capitales de la Horda.‡Habla con un maestro tragallamas en cualquiera de las capitales de la Horda.‡Parlez à un Maître avaleur de flammes dans n\'importe quelle capitale de la Horde.‡与任意部落主城的食焰大师谈一谈。‡跟任一個何部落主城的吞火者大師談談。',
  }
},
[11917] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡',
    nil,
    'Mate o Tenente Frentálgida evocado pela Pedra de Gelo, localizada na Praia de Zoram no Vale Gris. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте лейтенанта Хладоволна, помощника Ахуна, вызвав его при помощи Камня Льда на Зорамском взморье в Ясеневом лесу, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens auf dem Zoramstrand im Eschental den Leutnant der Frostwelle, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡잿빛 골짜기에 있는 조람 해안에서 얼음 기둥을 사용하여 서리파도 부관을 소환한 다음 처치하고, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Olaescarcha que invoques desde la piedra de hielo situada en La Ensenada de Zoram en Vallefresno. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Olaescarcha que invoques desde la piedra de hielo situada en La Ensenada de Zoram en Vallefresno. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant Vaguegivre invoqué par la Pierre de glace située sur la grève de Zoram, en Orneval, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往灰谷的佐拉姆海岸，杀死从寒冰之石中召唤出来的冰浪上尉，然后返回任意主城中的大地之环长者处复命。‡',
  }
},
[11921] = {
  {
    'Mais arremessos de tochas‡Опять бросаем факелы‡Noch einmal Fackeln werfen‡횃불을 더 많이 던져라!‡Más lanzamiento de antorchas‡Más lanzamiento de antorchas‡Lancer plus de torches‡继续扔火炬‡',
    nil,
    'Vença o jogo de arremessar as tochas e então fale com o Mestre Engolidor de Fogo.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 던지기 시험을 통과하고 불꽃마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragafuegos.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragafuegos.‡Gagnez le jeu de lancer de torches, puis parlez au Maître cracheur de feu.‡赢得一场扔火炬游戏，然后与吞火大师谈一谈。‡',
  }
},
[11922] = {
  {
    'Arremesso de tochas‡Жонглирование факелами‡Fackelwurf‡횃불을 던져라!‡Lanzamiento de antorchas‡Lanzamiento de antorchas‡Lancer des torches‡扔火炬‡投擲火炬',
    nil,
    'Vença o jogo de arremessar tochas e então fale com o Mestre Engolidor de Chamas.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister des Sonnenwendfests.‡횃불 던지기 시험을 통과하고 불꽃 마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gagnez le jeu de lancer de torches, puis parlez au Maître avaleur de flammes.‡赢得一场扔火炬游戏，然后与食焰大师谈一谈。‡在火炬投擲遊戲中獲勝，然後跟吞火者大師談話。',
  }
},
[11923] = {
  {
    'Piromalabarismo‡Поймай факел!‡Fackeln fangen‡횃불을 잡아라!‡Caza de antorchas‡Caza de antorchas‡Attraper des torches‡接火炬‡',
    nil,
    'Pegue 4 tochas seguidas e então fale com o Mestre Engolidor de Chamas.‡Поймайте подряд 4 факела, затем поговорите с пламеглотателем-виртуозом.‡Fangt nacheinander 4 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 4개를 연달아 던졌다 잡고 나서, 불꽃 마술의 대가와 대화해야 합니다.‡Atrapa 4 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Atrapa 4 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Attrapez 4 torches de suite, puis parlez au Maître avaleur de flammes.‡连续接住火炬4次，然后与食焰大师谈一谈。‡',
  }
},
[11924] = {
  {
    'Mais piromalabarismo‡Опять жонглирование факелами‡Noch einmal Fackeln fangen‡횃불을 더 많이 잡아라!‡Más caza de antorchas‡Más caza de antorchas‡Attraper plus de torches‡继续接火炬‡',
    nil,
    'Pegue 10 tochas seguidas e então fale com o Mestre Engolidor de Fogo.‡Поймайте 10 факелов подряд, затем поговорите с пламеглотателем-виртуозом.‡Fangt nacheinander 10 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 10개를 연달아 던졌다 잡고 나서, 불꽃마술의 대가와 대화해야 합니다.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragafuegos.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragafuegos.‡Attrapez 10 torches de suite, puis parlez au Maître cracheur de feu.‡连续接住火炬10次，然后与吞火大师谈一谈。‡',
  }
},
[11925] = {
  {
    'Mais piromalabarismo‡Опять жонглирование факелами‡Noch einmal Fackeln fangen‡횃불을 더 많이 잡아라!‡Más caza de antorchas‡Más caza de antorchas‡Attraper plus de torches‡继续接火炬‡',
    nil,
    'Pegue 10 tochas seguidas e então fale com o Mestre Engolidor de Chamas.‡Поймайте 10 факелов подряд, затем поговорите с пламеглотателем-виртуозом.‡Fangt nacheinander 10 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 10개를 연달아 던졌다 잡고 나서, 불꽃 마술의 대가와 대화해야 합니다.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Attrapez 10 torches de suite, puis parlez au Maître avaleur de flammes.‡连续接住火炬10次，然后与食焰大师谈一谈。‡',
  }
},
[11926] = {
  {
    'Mais arremessos de tochas‡Опять бросаем факелы‡Noch einmal Fackeln werfen‡횃불을 더 많이 던져라!‡Más lanzamiento de antorchas‡Más lanzamiento de antorchas‡Lancer plus de torches‡继续扔火炬‡',
    nil,
    'Vença o jogo de arremessar tochas e então fale com o Mestre Engolidor de Chamas.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 던지기 경기에서 이긴 다음, 불꽃 마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gagnez le jeu de lancer de torches, puis parlez au Maître avaleur de flammes.‡赢得一场扔火炬游戏，然后与食焰大师谈一谈。‡',
  }
},
[11933] = {
  {
    'Roubando a chama da Exodar‡Похищение пламени Экзодара‡Raubt die Flamme der Exodar‡엑소다르의 불꽃 훔치기‡Robar la llama de El Exodar‡Robar la llama de El Exodar‡Voler la flamme de l\'Exodar‡盗取埃索达的烈焰‡盜取艾克索達之焰',
    nil,
    'Entregue a Chama da Exodar para o Contador de Histórias do Festival.‡Верните Пламя Экзодара Праздничному сказителю.‡Bringt die Flamme der Exodar zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 엑소다르의 불꽃을 돌려줘야 합니다.‡Devuelve la Llama de El Exodar al cuentacuentos del Festival.‡Devuelve la Llama de El Exodar al cuentacuentos del Festival.‡Rapportez la Flamme de l\'Exodar au Conteur de la fête.‡将埃索达烈焰交给节日诗人。‡將艾克索達之焰帶回去給節慶故事使者。',
  }
},
[11935] = {
  {
    'Roubando a chama de Luaprata‡Похищение пламени Луносвета‡Raubt die Flamme von Silbermond‡실버문 불꽃 훔치기‡Robar la llama de Lunargenta‡Robar la llama de Lunargenta‡Voler la flamme de Lune-d\'argent‡盗取银月城的烈焰‡盜取銀月之焰',
    nil,
    'Entregue a Chama de Luaprata para o Historiador do Festival.‡Верните пламя Луносвета хранителю мудрости Праздника.‡Bringt die Flamme von Silbermond zum Meister der Lehren.‡한여름 축제 현자에게 실버문 불꽃을 가져다 줘야 합니다.‡Devuelve la Llama de Lunargenta al maestro cultural del Festival.‡Devuelve la Llama de Lunargenta al maestro cultural del Festival.‡Rapportez la Flamme de Lune-d\'argent au Maître des traditions de la fête.‡将银月城烈焰交给节日博学者。‡將銀月之焰帶回去給節慶傳說大師。',
  }
},
[11937] = {
  {
    'FLAG - all torch return quests are complete‡УКАЗАТЕЛЬ – все факелы возвращены, задание выполнено‡FLAG - all torch return quests are complete‡FLAG-횃불 반환 퀘스트 모두 완료‡FLAG - all torch return quests are complete‡‡MARQUEUR - Toutes les quêtes des torches sont terminées‡FLAG - all torch return quests are complete‡',
    nil,
    nil,
  }
},
[11947] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡',
    nil,
    'Mate o Tenente Granizo evocado pela Pedra de Gelo, localizada em Ethel Rethor, que fica em Desolação. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте лейтенанта Градня, помощника Ахуна, вызвав его при помощи Камня Льда к Этель-Ретор в Пустошах, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens am Ethel Rethor in Desolace den Leutnant des Eishagels, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡잊혀진 땅의 에텔 레소르에서 얼음 기둥을 사용하여 우박의 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Granizo que invoques desde la piedra de hielo situada en Ethel Rethor en Desolace. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Granizo que invoques desde la piedra de hielo situada en Ethel Rethor en Desolace. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant Grêlon invoqué par la Pierre de glace située à Ethel rethor en Désolace, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往凄凉之地的艾瑟雷索，杀死从寒冰之石中召唤出来的冰雹上尉，然后返回任意主城中的大地之环长者处复命。‡',
  }
},
[11948] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡',
    nil,
    'Mate o Tenente de Ventogelante evocado pela Pedra de Gelo, localizada na ilha dos elementais da água, que fica na parte oeste da Selva do Espinhaço. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте лейтенанта Промозглый Ветер, помощника Ахуна, вызвав его при помощи Камня Льда на островке элементалей воды к западу от Тернистой долины, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens auf der Insel der Wasserelementare im Westen des Schlingendorntals den Leutnant des Eiswinds, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡가시덤불 골짜기 서쪽, 물의 정령들이 있는 섬에서 얼음 기둥을 사용하여 서리바람 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Viento Gélido que invoques desde la piedra de hielo situada en la isla de los elementales de agua en la zona oeste de Vega de Tuercespina. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Viento Gélido que invoques desde la piedra de hielo situada en la isla de los elementales de agua en la zona oeste de Vega de Tuercespina. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant Noroît invoqué par la Pierre de glace située sur l’île de l’élémentaire d’eau à l’ouest de la Vallée de Strangleronce, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡‡',
  }
},
[11952] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡',
    nil,
    'Mate o Tenente Álgido evocado pela Pedra de Gelo, localizada na caverna sob o Cerro da Sentinela de Fogo, na parte noroeste da Garganta Abrasadora. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте лейтенанта Лютостужу, помощника Ахуна, вызвав его при помощи Камня Льда в пещере под горами Огненной стражи на северо-западе от Тлеющего ущелья, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens in der Höhle unter dem Feuerwachtgrat im Nordwesten der Sengenden Schlucht den Leutnant des Eises, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡이글거리는 협곡 북서쪽, 불망루 마루 아래쪽에 있는 동굴에서 얼음 기둥을 사용하여 극한의 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Frígido que invoques desde la piedra de hielo situada en la cueva bajo Cresta Vigía en el noroeste de La Garganta de Fuego. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Frígido que invoques desde la piedra de hielo situada en la cueva bajo Cresta Vigía en el noroeste de La Garganta de Fuego. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant algide invoqué par la Pierre de glace située dans la caverne sous la Crête de Guet-du-feu, au nord-ouest de la Gorge des Vents brûlants, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往灼热峡谷西北部观火岭下的洞穴，杀死从寒冰之石中召唤出来的严寒上尉，然后返回任意主城中的大地之环长者处复命。‡',
  }
},
[11953] = {
  {
    'Contra-ataque‡Ответный удар‡Gegenschlag‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡',
    nil,
    'Mate o Tenente Glacial evocado pela Pedra de Gelo, localizada no Passeio do Crepúsculo que fica na parte norte de Silithus. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте лейтенанта Хладноглыба, помощника Ахуна, вызвав его при помощи Камня Льда в Сумеречной пещере в северном Силитусе, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens in den Kavernen des Schattenhammers im Norden von Silithus den Leutnant des Gletschers, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡실리더스 북쪽 황혼의 터에서 얼음 기둥을 사용하여 빙하의 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Glacial que invoques desde la piedra de hielo situada en el Paseo Crepúsculo en la zona norte de Silithus. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Glacial que invoques desde la piedra de hielo situada en el Paseo Crepúsculo en la zona norte de Silithus. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant glaciaire invoqué par la Pierre de glace située dans le défilé du Crépuscule, au nord de Silithus, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往希利苏斯北部的暮光小径，杀死从寒冰之石中召唤出来的冰川上尉，然后返回任意主城中的大地之环长者处复命。‡',
  }
},
[11954] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡',
    nil,
    'Mate o Templário Glacial evocado pela Pedra de Gelo, localizada perto do Portal Negro, que fica na Península Fogo do Inferno. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте Ледяного Храмовника, помощника Ахуна, вызвав его при помощи Камня Льда к Темному порталу на полуострове Адского Пламени, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens in der Nähe des Dunklen Portals auf der Höllenfeuerhalbinsel den eisigen Templer, zerstört ihn und kehrt anschließend zu einem der Urahnen des Irdenen Rings zurück. Letztere befinden sich in den Hauptstädten.‡지옥불 반도의 어둠의 문 근처에서 얼음 기둥을 사용하여 빙하의 기사를 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al templario glacial que invoques desde la piedra de hielo situada cerca del Portal Oscuro en la Península del Fuego Infernal. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al templario glacial que invoques desde la piedra de hielo situada cerca de El Portal Oscuro en la Península del Fuego Infernal. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Templier glaciaire invoqué par la Pierre de glace située près de la Porte des ténèbres dans la Péninsule des flammes infernales, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往地狱火半岛的黑暗之门，杀死从寒冰之石中召唤出来的冰川圣殿骑士，然后返回任意主城中的大地之环长者处复命。‡',
  }
},
[11955] = {
  {
    'Ahune, o Senhor do Gelo‡Ахун, Повелитель Холода‡Ahune der Frostfürst‡서리 군주 아훈‡Ahune, el Señor de la Escarcha‡Ahune, el Señor de la Escarcha‡Ahune, le seigneur du Givre‡冰霜之王埃霍恩‡',
    nil,
    'Viaje para o Pátio dos Escravos no Reservatório Presacurva, que fica no Pântano Zíngaro e fale com Numa Irmã das Nuvens‡Отправляйтесь в Узилище в Резервуар Кривого Клыка, что в Зангартопи и поговорите с Нумой Сестрой Облаков.‡Begebt Euch in die Sklavenunterkünfte im Echsenkessel in den Zangarmarschen und sprecht mit Numa Wolkenschwester.‡장가르 습지대 지역에 있는 갈퀴송곳니 저수지의 강제 노역소로 가서 누마 클라우드시스터와 대화해야 합니다.‡Viaja hasta el Recinto de los Colmillo Torcido en Marisma de Zangar y habla con Numa Nubesoror.‡Viaja hasta el Recinto de los Colmillo Torcido en Marisma de Zangar y habla con Numa Nubesoror.‡Voyagez jusqu\'à l\'Enclos aux esclaves, dans le Réservoir de Glissecroc, au Marécage de Zangar, et parlez à Numa Sœur-des-nuages.‡前往赞加沼泽盘牙水库的奴隶围栏，与努玛·云女谈一谈。‡',
  }
},
[11964] = {
  {
    'Incenso para as faíscas de verão‡Благовония для летних пламеней‡Rauchwerk für die Sommerflämmlinge‡한여름 불덩이에게 향료를‡Incienso para los agostizos de verano‡Incienso para los agostizos de verano‡De l\'encens pour les brûletins de l\'été‡夏季的焚香‡夏日小焦焰的薰香',
    nil,
    'O Historiador do Festival quer que você ofereça um Incenso Estival para uma Faísca de Verão do lado de fora de qualquer acampamento da Aliança.‡Хранитель мудрости Праздника хочет, чтобы вы отнесли благовония Лета летнему пламеню к любому поселению Альянса.‡Der Meister der Lehren möchte, dass Ihr einem Sommerflämmling Rauchwerk des Sommers bringt. Die Flämmlinge befinden sich außerhalb jeder Siedlung der Allianz.‡한여름 축제 현자가 얼라이언스 마을 바깥에 있는 한여름 불덩이에게 한여름 향료를 가져가 달라고 부탁했습니다.‡El maestro cultural del Festival quiere que le lleves incienso de verano a algún agostizo de verano a las afueras de cualquier asentamiento de la Alianza.‡El maestro cultural del Festival quiere que le lleves incienso de verano a algún agostizo de verano a las afueras de cualquier asentamiento de la Alianza.‡Le maître des traditions de la fête vous demande d\'apporter de l\'Encens estival à un Brûletin d\'été à l\'extérieur de n\'importe quelle ville de l\'Alliance.‡节日博学者希望你带着夏季焚香前往任意联盟营地外的篝火旁，将焚香交给该处的夏季火元素。‡節慶傳說大師要你把夏日薰香帶給任何一座聯盟據點外的夏日小焦焰。',
  }
},
[11966] = {
  {
    'Incenso para as faíscas do festival‡Благовония для праздничных сполохов‡Rauchwerk für die Festflämmlinge‡축제 불덩이에게 향료를‡Incienso para los agostizos del Festival‡Incienso para los agostizos del Festival‡De l\'encens pour les brûletins de la fête‡节日的焚香‡節慶小焦焰薰香',
    nil,
    'O Contador de Histórias do Festival quer que você ofereça um Incenso Estival para uma Faísca do Festival do lado de fora de qualquer acampamento da Horda.‡Праздничный сказитель хочет, чтобы вы отнесли благовония Лета праздничному сполоху к любому поселению Орды.‡Der Geschichtenerzähler möchte, dass Ihr einem Festflämmling Rauchwerk des Sommers bringt. Die Flämmlinge befinden sich außerhalb jeder Siedlung der Horde.‡한여름 축제 이야기꾼이 한여름 향료를 호드 마을 외곽지역에 있는 축제 불덩이에게 가져다주라고 했습니다.‡El cuentacuentos del Festival quiere que le lleves incienso de verano a algún agostizo del Festival a las afueras de cualquier asentamiento de la Horda.‡El cuentacuentos del Festival quiere que le lleves incienso de verano a algún agostizo del Festival a las afueras de cualquier asentamiento de la Horda.‡Le conteur de la fête vous demande d\'apporter de l\'Encens estival à un Brûletin de la fête à l’extérieur de n’importe quelle ville de la Horde.‡节日诗人希望你带着夏季焚香前往任意部落营地外的篝火旁，将焚香交给该处的夏季火元素。‡節慶故事使者要你把夏日薰香帶給任何一座部落據點外的節慶小焦焰。',
  }
},
[11970] = {
  {
    'O mestre do folclore de verão‡Хранитель мудрости праздника Середины Лета‡Der Meister der Sommerlehre‡한여름 불꽃축제의 의미‡El maestro en tradición de verano‡El maestro en tradición de verano‡Le maître des traditions estivales‡节日博学者‡夏日傳說大師',
    nil,
    'Fale com um Catedrático do Festival em qualquer capital da Aliança.‡Поговорите с Хранителем мудрости Празднества в любой из столиц Альянса.‡Sprecht mit einem Meister der Lehren in einer der Hauptstädte.‡얼라이언스 대도시에 있는 한여름 축제 현자와 대화해야 합니다.‡Habla con el maestro cultural del Festival en cualquiera de las capitales de la Alianza.‡Habla con el maestro cultural del Festival en cualquiera de las capitales de la Alianza.‡Parlez au Maître des traditions de la fête dans n\'importe quelle capitale de l\'Alliance.‡与任意联盟主城的节日博学者谈一谈。‡和聯盟主城的任何一位節慶傳說大師談談。',
  }
},
[11971] = {
  {
    'O contador de histórias de verão‡Сказитель Летнего праздника‡Der Erzähler der Sommergeschichten‡여름 이야기꾼‡El tejedor de historias de verano‡El tejedor de historias de verano‡Le conteur des légendes estivales‡节日诗人‡夏日故事使者',
    nil,
    'Fale com um Contador de Histórias do Festival em qualquer capital da Horda.‡Поговорите с праздничным сказителем в любой из столиц Орды.‡Sprecht mit einem Geschichtenerzähler in einer der Hordehauptstädte.‡호드 대도시 중 한 곳으로 가서 한여름 축제 이야기꾼과 대화해야 합니다.‡Habla con el cuentacuentos del Festival en cualquiera de las capitales de la Horda.‡Habla con el cuentacuentos del Festival en cualquiera de las capitales de la Horda.‡Parlez au Conteur de la fête dans n\'importe quelle capitale de la Horde.‡与任意部落主城的节日诗人谈一谈。‡和部落主城的任何一位節慶故事使者談談。',
  }
},
[11972] = {
  {
    'Fragmentos de Ahune‡Осколки Ахуна‡Splitter von Ahune‡아훈이 남긴 파편‡Fragmentos de Ahune‡Fragmentos de Ahune‡Éclats d\'Ahune‡埃霍恩的碎片‡艾胡恩裂片',
    nil,
    'Entregue os Estilhaços de Gelo para Luma Mãe dos Céus.‡Принесите ледяные осколки Луме Матери Небес.‡Bringt die Eissplitter zu Luma Himmelsmutter.‡얼음 파편을 루마 스카이마더에게 가져가야 합니다.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Apportez les Eclats de glace à Luma Mère-des-cieux.‡将寒冰碎片交给鲁玛·天母。‡將寒冰裂片交給魯瑪·天空之母。',
  }
},
[11975] = {
  {
    'Quando eu crescer...‡Когда я вырасту...‡Nun, wenn ich einmal groß bin...‡이제, 어른이 되면...‡Después, cuando sea mayor...‡Después, cuando sea mayor...‡Et maintenant, quand je serai grande...‡等我长大了……‡',
    nil,
    'Leve a sua órfã Salandria para ver a banda Chefe Tauren Elite no Passeio dos Anciãos, que fica em Luaprata. Não se esqueça de chamá-la, caso ela não esteja com você ao chegar lá.‡Отведите свою подопечную, сиротку Саландрию, посмотреть на группу "Вожди тауренов" в Луносвет на Путь Старейшин. Обязательно позовите Саландрию, если по прибытии ее не окажется рядом.‡Geht mit Eurem Waisenkind Salandria zur Straße der Urahnen in Silbermond, um die Elite Tauren Chieftain zu sehen. Ruft sie zu Euch, falls sie nicht bei Euch ist, wenn Ihr ankommt.‡고아 살란드리아를 데리고 실버문 장로의 거리에 있는 정예 타우렌 족장을 만나야 합니다. 도착했을 때 살란드리아가 보이지 않으면 호루라기로 다시 불러내십시오.‡Lleva a tu huérfana, Salandria, a ver a los Tauren Chieftains al Camino de los Ancestros en Ciudad de Lunargenta. Tendrás que ir a buscarla si no está allí cuando llegues.‡Lleva a tu huérfana, Salandria, a ver a los Tauren Chieftains al Camino de los Ancestros en Ciudad de Lunargenta. Tendrás que ir a buscarla si no está allí cuando llegues.‡Conduisez votre orpheline, Salandria, à la promenade des Anciens de Lune-d\'argent pour voir les Elite Tauren Chieftains. Si elle n\'est pas présente lorsque vous serez sur place, n\'oubliez pas de l\'appeler.‡带上孤儿萨兰蒂亚，前往银月城的长者步道拜访牛头人酋长乐队。如果你抵达时发现她不在身边，记得要先召唤她。‡',
  }
},
[11976] = {
  {
    'Ice Shards‡Ледяные осколки‡Eissplitter‡얼음 파편‡Fragmentos de hielo‡Fragmentos de hielo‡Éclats de glace‡Ice Shards‡寒冰裂片',
    nil,
    'Bring the Ice Shards to Luma Skymother.‡Принесите ледяные осколки Луме Матери Небес.‡Bringt die Eissplitter zu Luma Himmelsmutter.‡얼음 파편을 루마 스카이마더에게 가져가야 합니다.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Apportez les Eclats de glace à Luma Mère-des-cieux.‡将Ice Shards交给Luma Skymother。‡將寒冰裂片交給魯瑪·天空之母。',
  }
},
[12012] = {
  {
    'Informe o ancião‡Сообщи старейшинам‡Den Urahnen benachrichtigen‡장로에게 소식 전달‡Informa al anciano‡Informa al anciano‡Informez l\'Ancien‡通知长者‡',
    nil,
    'Vá para a capital e fale com o Ancião da Harmonia Telúrica.‡Отправляйтесь в столицу и поговорите со старейшиной Служителей Земли.‡Reist in eine der Hauptstädte und sprecht mit dem Urahnen des Irdenen Rings.‡대도시로 가서 대지 고리회 장로와 대화해야 합니다.‡Viaja a una capital y habla con el anciano del Anillo de la Tierra.‡‡Voyagez jusqu\'à une capitale et parlez à un Ancien du Cercle terrestre.‡返回任意主城，同大地之环长者交谈。‡',
  }
},
[12020] = {
  {
    'Certa vez, quando eu estava bêbado...‡Однажды, напившись в...‡Dieses eine Mal, als ich betrunken war...‡가을 축제를 즐기는 자세‡Ese día, que estaba borracho...‡Ese día que estaba borracho...‡Et une fois, quand j\'étais ivre…‡那次，我喝醉了之后……‡就這麼一次，在我酒醉的時候…',
    nil,
    'Fale com Caxias Girafuso na CervaFest.‡Поговорите с Бокси Болтокрутом в лагере Хмельного фестиваля.‡Sprecht mit Boxi Bolzdreher im Braufestlager.‡가을 축제 천막에 있는 복시 볼트스피너와 이야기해야 합니다.‡Habla con Boxey Bolahuso en el campamento de la Fiesta de la cerveza.‡Habla con Boxey Bolahuso en el campamento de la Fiesta de la Cerveza.‡Parlez à Boxey Tournécrou au campement de la fête des Brasseurs.‡与美酒节营地的波克希·博斯宾谈一谈。‡與啤酒節營地的博克西·栓旋者交談。',
  }
},
[12022] = {
  {
    'Caneco no boneco!‡Пей до дна!‡Haut weg das Zeug!‡아자! 가자! 나가자!‡¡Traga y tira!‡¡Traga y tira!‡Buvez, éliminez !‡扔酒杯！‡乾了再砸!',
    nil,
    'Use a Amostra de Cortesia da CervaFest para acertar o B.I.R.I.T.A. 5 vezes. Em seguida, fale com Caxias Girafuso.‡Попадите кружкой с бесплатным пивом в С.С.М. 5 раз, затем поговорите с Бокси Болтокрутом.‡Benutzt den Freibierkrug, um A.L.K. fünfmal zu treffen, und sprecht dann mit Boxi Bolzdreher.‡시음용 가을 축제 맥주를 사용하여 주.정.뱅.이.를 5번 맞힌 후 복시 볼트스피너와 대화해야 합니다.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utiliza la jarra de degustación de la Fiesta de la Cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utilisez le Tastebière-cadeau pour toucher la C.E.R.V.O.I.S.E. 5 fois, puis revenez parler à Boxey Tournécrou.‡用美酒节试喝软饮料击中掷杯训练器5次，然后与波克希·博斯宾谈一谈。‡使用免費招待的啤酒節樣品並丟中S.T.O.U.T.5次，然後和博克西·栓旋者談談。',
  }
},
[12062] = {
  {
    'Insulte Coren Cervatroz‡Оскорбить Корена Худовара‡Beleidigt Coren Düsterbräu‡코렌 다이어브루와의 싸움‡Insulta a Coren Cerveza Temible‡Insulta a Coren Cerveza Temible‡Insulter Coren Navrebière‡侮辱科林·烈酒‡羞辱寇仁·恐酒',
    nil,
    'Fale com Coren Cervatroz.‡Поговорите с Кореном Худоваром.‡Geht und fangt Streit mit Coren Düsterbräu an.‡코렌 다이어브루와 대화해야 합니다.‡Habla con Coren Cerveza Temible.‡Habla con Coren Cerveza Temible.‡Parlez à Coren Navrebière.‡与科林·烈酒谈一谈。‡與寇仁·恐酒交談。',
  }
},
[12133] = {
  {
    '‡‡‡‡‡‡‡‡砸碎南瓜',
    nil,
    '‡‡‡‡‡‡‡‡將燒焦的聖徽交給變裝的孤兒監護員。',
  }
},
[12191] = {
  {
    'Caneco no boneco!‡Пей до дна!‡Haut weg das Zeug!‡아자가자 나가자!‡¡Traga y tira!‡¡Traga y tira!‡Buvez, éliminez !‡扔酒杯！‡乾了再砸!',
    nil,
    'Use a Amostra sem Álcool da CervaFest para acertar o B.I.R.I.T.A. 5 vezes.‡Попадите кружкой из-под безалкогольного пробного напитка Хмельного фестиваля в ССМ 5 раз.‡Trefft A.L.K. fünfmal mit dem Krug alkoholfreies Braufestbier.‡시음용 가을 축제 무알콜 맥주를 사용하여 주.정.뱅.이.를 5번 맞혀야 합니다.‡Utiliza la jarra de degustación de la Fiesta de la Cerveza sin alcohol para golpear a DAME 5 veces.‡Utiliza la jarra de degustación sin alcohol de la Fiesta de la Cerveza para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Bizzle Birlotutti.‡Utilisez le Tastebière sans alcool de la fête des Brasseurs pour toucher la C.E.R.V.O.I.S.E. à 5 reprises.‡用美酒节试喝软饮料击中掷杯训练器5次，然后与比兹尔·奎利弗谈一谈。‡使用免費招待的啤酒節樣品並丟中S.T.O.U.T.5次，然後和比索·迅提談談。',
  }
},
[12193] = {
  {
    'Então, será que por acaso também tem suvenir este ano, hein?‡А не будет ли сувенирчика в нынешнем году?‡Sagt mal, es gibt dieses Jahr nicht zufällig ein Souvenir?‡‡Oye, ¿no habrá por casualidad un souvenir este año?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Dites, il n\'y aurait pas un souvenir cette année ?‡‡',
    nil,
    'Troque o Vale-caneco da CervaFest com Bebel Trocarrápida na CervaFest.‡Отоварьте свой купон на праздничную кружку у Белби Быстросмен в лагере Хмельного фестиваля.‡Löst Euren Gutschein für einen Braufestkrug bei Belbi Blitzknips im Braufestlager ein.‡가을 축제 광장 뒤쪽에 있는 벨비 퀵스위치에게 가을 축제 잔 상품권을 가져가서 축제 잔으로 교환해야 합니다.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la Cerveza.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la Cerveza.‡Échangez le bon-cadeau à Belbi Coupecircuit dans le campement de la fête des Brasseurs.‡去美酒节营地的贝尔比那里兑换美酒节礼品券。‡',
  }
},
[12194] = {
  {
    'Então, será que por acaso também tem suvenir este ano, hein?‡А не будет ли сувенирчика в нынешнем году?‡Sagt mal, es gibt dieses Jahr nicht zufällig ein Souvenir?‡아니, 올해는 기념품이 없다는 게 말이 돼?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Dites, il n\'y aurait pas un souvenir, cette année ?‡‡',
    nil,
    'Troque o Vale-caneco da CervaFest com Blix Consertatreco nos fundos da área do festival.‡Отоварьте свой купон на праздничную кружку у Бликса Чиништукса в лагере Хмельного фестиваля.‡Löst Euren Gutschein für einen Braufestkrug bei Blix Fixtand im hinteren Teil des Braufestlagers ein.‡가을 축제 천막에 있는 블릭스 픽스위젯에게 가을 축제 잔 상품권을 가져가야 합니다.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la Cerveza.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la Cerveza.‡Échangez le Bon pour un bock de la fête des Brasseurs à Blix Réparouage à l\'arrière du campement de la fête des Brasseurs.‡‡',
  }
},
[12278] = {
  {
    'Clube da Cerveja do Mês‡Клуб "Пиво месяца"‡Bier des Monats e.V.‡맥주 사랑 동호회‡Club de la Cerveza del Mes‡Club de la Cerveza del Mes‡Le club de la Bière du mois‡本月美酒俱乐部‡每月啤酒俱樂部',
    nil,
    'Entregue a ficha de inscrição do clube "Cerveja do Mês" para Larkin Cervaforte na Taberna Pedra de Fogo, em Altaforja.‡Отнесите членскую карточку "Лучшего пивовара месяца" Ларкину Громовару в таверну "Горючий камень" в Стальгорне.‡Bringt Euren Mitgliedschaftsantrag für den "Bier des Monats e.V." zu Larkin Donnerbräu in der Steinfeuertaverne in Eisenschmiede.‡"맥주 사랑 동호회" 가입 신청서를 아이언포지의 부싯돌 선술집에 있는 라르킨 썬더브루에게 가져가야 합니다.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Larkin Cebatruenos en la Taberna Roca de Fuego en Forjaz.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Larkin Cebatruenos en la Taberna Roca de Fuego en Forjaz.‡Apporter le bulletin d\'adhésion du club de la « Bière du mois » à Larkin Tonnebière à la taverne de Brûlepierre à Forgefer.‡将“本月美酒”俱乐部会员资料表交给铁炉堡石火旅店的拉尔金·雷酒。‡把「每月啤酒」俱樂部會員表格帶給拉金·雷酒，他就在鐵爐堡的石火旅店中。',
  }
},
[12286] = {
  {
    '‡‡‡‡‡‡‡‡糖果桶',
    nil,
    nil,
  }
},
[12306] = {
  {
    'Clube da Cerveja do Mês‡Клуб "Пиво месяца"‡Bier des Monats e.V.‡맥주 사랑 동호회‡Club de la Cerveza del Mes‡Club de la Cerveza del Mes‡Le club de la Bière du mois‡本月美酒俱乐部‡每月啤酒俱樂部',
    nil,
    'Entregue a ficha de inscrição do clube "Cerveja do Mês" para Ray\'ma na Salão Agulhas Negras, que fica no Vale dos Espíritos de Orgrimmar.‡Отнесите заполненную членскую карточку "Лучшего пивовара месяца" Рай\'ме в Пристанище Темнотерна. Оно находится в Оргриммаре, в Аллее Духов.‡Bringt Euren Mitgliedschaftsantrag für den "Bier des Monats e.V." zu Ray\'ma in der Dunkeldornenlodge im Tal der Geister in Orgrimmar.‡"맥주 사랑 동호회" 가입 신청서를 오그리마 정기의 골짜기에 있는 검은장미 오두막의 레이마에게 가져가야 합니다.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Ray\'ma en Cabaña de Brezo en el Valle de los Espíritus de Orgrimmar.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Ray\'ma en Orgrimmar.‡Apporter le bulletin d\'adhésion du club de la « Bière du mois » à Ray\'ma au pavillon de Buissombre dans la vallée des Esprits d\'Orgrimmar.‡将"本月美酒"俱乐部会员资料表交给奥格瑞玛精神谷黑石南小屋的莱玛。‡帶著「每月啤酒」俱樂部會員表格交給雷瑪，他就在奧格瑪精神谷的暗木小屋裡。',
  }
},
[12318] = {
  {
    'Salve a CervaFest!‡Спасем Хмельной фестиваль!‡Rettet das Braufest!‡가을 축제를 구해라!‡¡Salva la Fiesta de la Cerveza!‡¡Salva la Fiesta de la Cerveza!‡Sauvez la fête des Brasseurs !‡拯救美酒节！‡',
    nil,
    'Fale com o Espião da CervaFest no Glutão Implacável, que fica no Abismo Rocha Negra.‡Поговорите со шпионом Хмельного фестиваля в трактире "Угрюмый обжора" в Глубинах Черной горы.‡Sprecht mit dem Spion des Braufests im Grimmigen Säufer in den Schwarzfelstiefen.‡검은바위 나락의 험상궂은 주정뱅이 선술집에 있는 가을 축제 비밀요원과 대화해야 합니다.‡Habla con el espía de la Fiesta de la Cerveza en el Tragapenas de las Profundidades de Roca Negra.‡Habla con el espía de la Fiesta de la Cerveza en el Tragapenas de las Profundidades de Roca Negra.|n‡Parlez avec l’Espion de la fête des Brasseurs, au Sinistre écluseur dans les Profondeurs de Rochenoire.‡进入黑石深渊，与黑铁酒吧的美酒节间谍谈一谈。‡',
  }
},
