[8681] = {
  {
    'Chifre Troante, o Ancião‡Старейшина Громовой Рог‡Urahne Donnerhorn‡장로 썬더혼‡Tronacuerno el Ancestro‡Tronacuerno el Ancestro‡L\'Ancien Corne-tonnerre‡雷角长者‡雷角長者',
