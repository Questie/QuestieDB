[8165] = {
  {
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    '‡Выиграйте битву за Низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le Bassin Arathi, obtenez une Caisse de ressources arathies et rapportez-la au nécrotraqueur Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡',
  }
},
[8166] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Ataque a mina, a serraria, a ferraria, a fazenda e então fale com o Marechal-de-campo Oslight na Ponta do Refúgio.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Lichtmark in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가십시오.‡Asalta la mina, la serrería, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦坑、伐木場、鐵匠舖和農場，然後向避難谷地的奧斯萊特元帥覆命。',
  }
},
[8167] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Ataque a mina, a serraria, a ferraria, a fazenda e então fale com o Marechal-de-campo Oslight na Ponta do Refúgio.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Lichtmark in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가십시오.‡Asalta la mina, la serrería, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦坑、伐木場、鐵匠舖和農場，然後向避難谷地的奧斯萊特元帥覆命。',
  }
},
[8168] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Ataque a mina, a serraria, a ferraria, a fazenda e então fale com o Marechal-de-campo Oslight na Ponta do Refúgio.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Lichtmark in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가십시오.‡Asalta la mina, la serrería, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦坑、伐木場、鐵匠舖和農場，然後向避難谷地的奧斯萊特元帥覆命。',
  }
},
[8169] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe im Arathibecken und kehrt dann zu Todesmeister Dunkels in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Asalta la mina de la Cuenca de Arathi, la serrería, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l\'écurie du bassin d\'Arathi, puis revenez voir le Maître de la mort Dwire, au Trépas-d\'Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦坑、伐木場、鐵匠舖和獸欄，然後向落錘鎮的屠殺者杜維爾覆命。',
  }
},
[8170] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe im Arathibecken und kehrt dann zu Todesmeister Dunkels in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Asalta la mina de la Cuenca de Arathi, la serrería, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l\'écurie du bassin d\'Arathi, puis revenez voir le Maître de la mort Dwire, au Trépas-d\'Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦坑、伐木場、鐵匠舖和獸欄，然後向落錘鎮的屠殺者杜維爾覆命。',
  }
},
[8171] = {
  {
    'A batalha pela Bacia Arathi!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Vá até a Bacia Arathi e ataque a mina, a serraria, a ferraria e os estábulos. Então, fale novamente com a Senhora da Morte Dwire na Ruína do Martelo.‡Захватите рудник, лесопилку, кузницу и стойла и возвращайтесь к повелительнице смерти Двайр в Павший Молот.‡Erobert die Mine, das Sägewerk, die Schmiede, die Farm und die Ställe im Arathibecken und kehrt dann zu Todesmeister Dunkels in Hammerfall zurück.‡아라시 분지의 금광, 제재소, 대장간, 그리고 마구간을 공격한 다음 해머폴에 있는 죽음의경비대장 드와이어에게 돌아가십시오.‡Asalta la mina de la Cuenca de Arathi, la serrería, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Asalta la mina de la Cuenca de Arathi, el aserradero, la herrería y el establo y vuelve entonces junto a la maestra de la muerte Duire en Sentencia.‡Attaquez la mine, la scierie, la forge et l\'écurie du bassin d\'Arathi, puis revenez voir le Maître de la mort Dwire, au Trépas-d\'Orgrim.‡进攻阿拉希盆地的矿洞、伐木场、铁匠铺和兽栏，然后向落锤镇的屠杀者杜维尔复命。‡進攻阿拉希盆地的礦坑、伐木場、鐵匠舖和獸欄，然後向落錘鎮的屠殺者杜維爾覆命。',
  }
},
[8181] = {
  {
    'Confronte Yeh\'kinya‡Сопротивление Йекинье‡Konfrontiert Yeh\'kinya‡예킨야와의 대면‡La confrontación con Yeh\'kinya‡La confrontación con Yeh\'kinya‡La confrontation avec Yeh\'kinya‡面对叶基亚‡面對葉基亞',
    nil,
    'Fale com Yeh\'kinya.‡Поговорите с Йе\'киньей.‡Sprecht mit Yeh\'kinya.‡예킨야와 대화해야 합니다.‡Habla con Yeh\'kinya.‡Habla con Yeh\'kinya.‡Parlez à Yeh\'kinya.‡跟叶基亚谈一谈。‡跟葉基亞談一談。',
  }
},
[8182] = {
  {
    'A Mão de Rastakhan‡Длань Растахана‡Die Hand von Rastakhan‡라스타칸의 대리인‡La mano de Rastakhan‡La mano de Rastakhan‡La main de Rastakhan‡拉斯塔哈之手‡拉斯塔哈之手',
    nil,
    'Fale com Molthor na Selva do Espinhaço.‡Поговорите с Молтором из Тернистой долины.‡Sprecht mit Molthor im Schlingendorntal.‡가시덤불 골짜기에 있는 몰소르와 대화해야 합니다.‡Habla con Molthor en Tuercespina.‡Habla con Molthor en Tuercespina.‡Parlez à Molthor à Strangleronce.‡跟荆棘谷的莫托尔谈一谈。‡跟荊棘谷的莫托爾談話。',
  }
},
[8183] = {
  {
    'O coração de Hakkar‡Сердце Хаккара‡Das Herz von Hakkar‡학카르의 심장‡El corazón de Hakkar‡El corazón de Hakkar‡Le cœur d\'Hakkar‡哈卡之心‡哈卡之心',
    nil,
    'Leve o Coração de Hakkar a Molthor na Ilha Yojamba.‡Принесите сердце Хаккара Молтору на остров Йоджамба.‡Bringt das Herz von Hakkar zu Molthor auf die Insel Yojamba.‡요잠바 섬에 있는 몰소르에게 학카르의 심장을 가져가야 합니다.‡Lleva el corazón de Hakkar a Molthor en Isla Yojamba.‡Lleva el corazón de Hakkar a Molthor en Isla Yojamba.‡Donnez le Cœur d\'Hakkar à Molthor sur l\'île de Yojamba.‡把哈卡之心交给尤亚姆巴岛上的莫托尔。‡把哈卡之心交給尤亞姆巴島上的莫托爾。',
  }
},
[8184] = {
  {
    'A presença de Poder‡Явление Силы‡Präsenz der Macht‡힘의 문장‡Presencia de poderío‡Presencia de poderío‡La présence de la puissance‡力量的证明‡力量的證明',
    nil,
    '‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8185] = {
  {
    'O signo do sincretista‡Печать синкретиста‡Siegelzeichen des Synkretisten‡자비의 인장‡Sigilo de Sincretista‡Sigilo de Sincretista‡Le signe du syncrétiste‡调和的徽记‡調和的徽記',
    nil,
    'Com os ingredientes certos, o Zanza aqui consegue preparar os antigos encantamentos trólicos.nnO primeiro ingrediente é um ídolo Hakkari primevo, que deve ser obtido de um dos dois tenentes Hakkari mais poderosos – o Jin\'do ou o Sangrelorde.nnO segundo é uma boneca vodu perfurada – há varias bonecas jogadas nas pilhas de dejetos que cobrem este lugar imundo. Procure nos amontoados de mandingas azarentas.nnMe traz os ingredientes que eu vou preparar um poderoso encantamento pra tu!‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8186] = {
  {
    'O abraço da morte‡Объятия Смерти‡Umarmung des Todes‡죽음의 은총‡Abrazo de la Muerte‡Abrazo de la Muerte‡La caresse de la mort‡死亡的拥抱‡死亡的擁抱',
    nil,
    '‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8187] = {
  {
    'O chamado do falcão‡Зов Сокола‡Ruf des Falken‡매의 부름‡Llamada del falcón‡Llamada del falcón‡L\'appel de l\'épervier‡猎鹰的召唤‡獵鷹的召喚',
    nil,
    '‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡Zanza puede crear los antiguos encantamientos <raza> si dispone de los componentes adecuados.nnEl primero es un ídolo Hakkari primigenio que debe obtenerse de los más poderosos de los tenientes Hakkari: Jin\'do y el Señor sangriento.nnEl segundo es una Muñeca vudú perforada. Las podrás encontrar en las pilas de desechos que cubren ese maldito lugar. Mira en los montones de residuos.nn¡Tráeme estas cosas y te crearé un poderoso encantamiento!‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8188] = {
  {
    'O abraço protetor do voduzeiro‡Неусыпные узы вуду‡Vodouisants wachsame Umarmung‡선견의 은총‡Abrazo del vigilante de Vodouisant‡Abrazo del vigilante de Vodouisant‡L\'étreinte vigilante du vaudouisan‡巫毒的警觉‡巫毒的警覺',
    nil,
    '‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8189] = {
  {
    'A presença de visão‡Явление Прозрения‡Allgegenwärtige Sicht‡총명의 기운‡Presencia de vista‡Presencia de vista‡La présence de la vision‡魔法的视域‡魔法的視域',
    nil,
    'Com os ingredientes certos, o Zanza aqui consegue preparar os antigos encantamentos trólicos.nnO primeiro ingrediente é um ídolo Hakkari primevo, que deve ser obtido de um dos dois tenentes Hakkari mais poderosos – o Jin\'do ou o Sangrelorde.nnO segundo é uma boneca vodu perfurada – há varias bonecas jogadas nas pilhas de dejetos que cobrem este lugar imundo. Procure nos amontoados de mandingas azarentas.nnMe traz os ingredientes que eu vou preparar um poderoso encantamento pra tu!‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8190] = {
  {
    'A mandinga azarenta‡Наговор худу‡Verhexung des Hoodoo‡어둠의 마력‡Maleficio de mala suerte‡Maleficio hudú‡Le maléfice porte-guigne‡不祥的妖术‡不祥的妖術',
    nil,
    'Com os ingredientes certos, o Zanza aqui consegue preparar os antigos encantamentos trólicos.nnO primeiro ingrediente é um ídolo Hakkari primevo, que deve ser obtido de um dos dois tenentes Hakkari mais poderosos – o Jin\'do ou o Sangrelorde.nnO segundo é uma boneca vodu perfurada – há varias bonecas jogadas nas pilhas de dejetos que cobrem este lugar imundo. Procure nos amontoados de mandingas azarentas.nnMe traz os ingredientes que eu vou preparar um poderoso encantamento pra tu!‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡Zanza puede crear los antiguos encantamientos trol si dispone de los componentes adecuados.nnEl primero es un ídolo Hakkari primigenio que debe obtenerse de los más poderosos de los tenientes Hakkari: Jin\'do y el Señor sangriento.nnEl segundo es una Muñeca vudú perforada. Las podrás encontrar en las pilas de desechos que cubren ese maldito lugar. Mira en los montones de residuos.nn¡Tráeme estas cosas y te crearé un poderoso encantamiento!‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8191] = {
  {
    'A aura profética‡Пророческая аура‡Prophetische Aura‡예언의 기운‡Aura profética‡Aura profética‡L\'aura prophétique‡预言的光环‡預言的光環',
    nil,
    '‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡Zanza puede crear los antiguos encantamientos trol si dispone de los componentes adecuados.nnEl primero es un ídolo Hakkari primigenio que debe obtenerse de los más poderosos de los tenientes Hakkari: Jin\'do y el Señor sangriento.nnEl segundo es una Muñeca vudú perforada. Las podrás encontrar en las pilas de desechos que cubren ese maldito lugar. Mira en los montones de residuos.nn¡Tráeme estas cosas y te crearé un poderoso encantamiento!‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8192] = {
  {
    'A carícia do animista‡Прикосновение анимиста‡Liebkosung des Animisten‡자연의 은총‡Caricia del animista‡Caricia del animista‡La caresse de l\'animiste‡灵魂的安抚‡靈魂的安撫',
    nil,
    '‡Занза владеет искусством древних троллей и может сделать множество полезных вещей.nnПринеси мне изначального идола Хаккари. Его можно отнять у двух самых могучих лейтенантов Хаккара – Джин\'до и Повелителя Крови.nnЕще мне нужна исколотая кукла вуду. Она наверняка найдется среди отбросов в Зул-Гурубе. Поройся в заколдованных грудах мусора, скорее всего, ты отыщешь то, что нужно.nnПринеси мне все компоненты, и я сделаю для тебя могущественный амулет!‡Zanza kann die antiken Trollverzauberungen mit den richtigen Komponenten herstellen.nnDie erste Zutat ist ein urzeitlicher Hakkarigötze, der von den mächtigsten Hakkari erlangt werden muss, von Jin\'do und dem Blutfürsten.nnDie zweite Zutat ist eine durchstochene Voodoopuppe. Beide Komponenten findet Ihr in den Abfallhaufen, die diesen verdorbenen Ort bedecken. Schaut in den verwunschenen Hoodoohaufen nach.nnBringt mir diese Dinge und ich erschaffe eine mächtige Verzauberung für Euch!‡‡‡‡Zanza peut créer les anciens enchantements des trolls s’il dispose des composants appropriés.nnLe premier est une idole primordiale hakkari qui doit être prise sur les plus puissants des lieutenants Hakkari : Jin’do et le Seigneur sanglant.nnLe second est une poupée vaudou percée. On peut en trouver dans les piles d’ordures qui jonchent cet endroit ignoble. Cherchez dans les piles de déchets.nnRamenez-moi ces choses et je vous façonnerai un enchantement puissant !‡‡',
  }
},
[8193] = {
  {
    'Mestre Pescador‡Лучший удильщик‡Anglermeister‡낚시왕 선발 대회‡Maestro pescador‡Gran premio‡Maître pêcheur‡钓鱼大师‡釣魚大師',
    nil,
    '‡‡‡아제로스의 모든 낚시꾼은 들으십시오! 오늘 오후 2시부터 4시까지 최고의 낚시왕을 선발하는 대회가 열립니다! 가시덤불 해안에 출몰하는 맛둥어 떼에서 낚아올린 맛둥어 40마리를 제일 먼저 가져오는 이에게 낚시왕이라는 영광스러운 칭호를 내리겠습니다!nn아쉽게 우승은 놓치더라도 여기 우리 견습생이 맛둥어 5마리마다 제값을 두둑이 쳐줄 겁니다.nn맛둥어는 금방 상하니까 어서 가져오세요!‡‡‡‡‡',
  }
},
[8194] = {
  {
    'Aprendiz de pescador‡Начинающий удильщик‡Anglerlehrling‡수습 낚시꾼‡Aprendiz pescador‡Aprendiz pescador‡Apprenti pêcheur‡钓鱼学徒‡釣魚學徒',
    nil,
    'Nós já temos um vencedor do concurso, mas ainda assim vou continuar comprando Papas-finas de você por um preço razoável.‡Хотя мы уже определили победителя соревнований, я все равно готов купить у тебя вкуснорыбу по сходной цене. Что скажешь?‡Wir haben zwar schon einen Gewinner ermittelt, aber ich kaufe Euch dennoch Eure restlichen Leckerfische ab. Ich zahl\' Euch einen angemessenen Preis, na, was sagt Ihr!‡이미 대회에 우승자가 나왔다고 해도 관계없어요. 전 시세대로 계속 맛둥어를 살 거랍니다. 그 누가 뭐라고 하든지요!‡Aunque ya tenemos un ganador del concurso, aún quiero comprarte el pezrico a un precio razonable. ¿Qué dices?‡‡Bon, nous avons déjà un gagnant, mais je continue à acheter vos courbines à un prix raisonnable. Ça vous va ?‡‡',
  }
},
[8195] = {
  {
    'As moedas Hakkari, Zulian e Razzashi‡Монеты племен Зулиан, Раззаши и Хаккари‡Münzen der Razzashi, Hakkari und zulianische Münzen‡줄리안, 래즈자쉬, 학카리부족 주화‡Las monedas Zulian, Razzashi y Hakkari‡Las monedas Zulian, Razzashi y Hakkari‡Pièces zuliennes, razzashi et hakkari‡祖利安、拉扎什和哈卡莱硬币‡祖利安、拉札希和哈卡萊硬幣',
    nil,
    'Procuro as Epítomes de Poder conhecidos como Moedas das Tribos. São usadas por todos os moradores de Zul\'Gurub, e todas elas são imbuídas de um mojo que, embora sutil, é bem forte.nnHá nove tipos diferentes de moeda. Algumas são procuradas pelos meus compatriotas por várias armaduras que oferecem aos heróis de Zandalar. Se tiver algumas sobrando, posso trocas três por uma das nossas Insígnias de Honra. Você pode levar as insígnias para Rin\'wosho, o Comerciante. Ele oferece aos nossos heróis itens especiais em troca delas.‡Мне нужны Знаки Силы, более известные как Монеты племен. Это ходовые монеты различных племен Зул\'Гуруба, и на каждую из них наложено незаметное, но могущественное заклятие.nnСуществует девять видов таких монет. За некоторые из них мои компаньоны готовы поделиться с тобой снаряжением. Будут лишние – обращайся и ко мне, я обменяю три монеты на знак отличия. А ты эти знаки уже сможешь обменять у Рин\'вошо Торговца на нечто особенное.‡Ich suche nach den Symbolen der Macht, bekannt als Münzen der Stämme. Sie sind die Währung unterschiedlichster Bewohner Zul\'Gurubs und eine jede ist mit subtilem, aber mächtigem Mojo erfüllt.nnEs gibt neun bestimmte Arten, die es zu finden gilt. Manche werden von meinen Landsmänner für unterschiedliche Rüstungen begehrt, die sie zandalarianischen Helden anbieten. Solltet Ihr welche über haben, werde ich Euch eine unserer Ehrenmünzen im tausch gegen drei davon geben. Ihr könnt die Münzen bei Rin\'wosho dem Händler verwenden; er bietet unseren Helden spezielle Gegenstände dafür an.‡나는 트롤 부족 주화라고 불리는 마력의 보물을 찾고 있다네. 줄구룹의 다양한 부족들이 사용하는 통화로, 각각 신비로우면서도 강력한 모조가 부여되어 있지.nn그 주화는 서로 다른 아홉 가지 종류가 있는데, 어떤 것은 내 동료들이 잔달라 영웅들에게 줄 다양한 보호구를 제작하는 데 쓰려고 찾고 있다네. 혹시 여분이 생기거든 세 개당 우리 부족의 잔달라 명예 징표 하나로 교환해 주겠네. 그 징표들은 우리 영웅들에게 특별한 물건들을 제공하는 상인 린워쇼에게 쓸 수 있을 걸세.‡Necesito los Dechados de Poder conocidos como Monedas de las Tribus. Son la moneda que utilizan los distintos habitantes de Zul\'Gurub y todas ellas están imbuidas con un sutil pero potente mojo.nnHay nueve tipos diferentes. Mis compatriotas buscan algunas de ellas para las distintas armaduras que ofrecen a los héroes Zandalar. Si tuvieras alguna de sobra te la cambiaré tres de ellas por una de nuestras marcas de honor. Puedes utilizar las marcas con Rin\'wosho el Mercader, a cambio te ofrecerá objetos especiales.‡‡Je cherche les Parangons de puissance connus sous le nom de Pièces des Tribus. Il s\'agit de la monnaie utilisée par les différents habitants de Zul\'Gurub, et chacune est imprégnée d\'un subtil mais puissant mojo.nnIl y en existe neuf types distincts. Certaines sont recherchées par mes compatriotes pour différentes armures qu\'ils proposent aux héros des Zandalar. Si vous en avez, je vous les échangerai contre une de nos marques d\'honneur par série de trois. Vous pouvez utiliser les marques chez Rin\'wosho le marchand : il propose à nos héros des articles spéciaux en échange.‡‡',
  }
},
[8196] = {
  {
    'As mangaromas‡Экстракт манго‡Essenzmangos‡알짜 망고‡Mangos de esencia‡Mangos de esencia‡Mangues d\'essence‡芒果精华‡美味芒果',
    nil,
    '‡Манго, из которых можно изготовить могучий экстракт, растут на островах Южных морей. Одно-единственное манго придает и физические и душевные силы тому, кто его съест. Тебе когда-нибудь приходилось пробовать манго? Если нет, то ты много потерял!nnУ нас есть запасы манго, и мы охотно обменяем плоды на Почетный знак Зандалара. Если ты не знаешь, где достать знаки, поговори с Винчаксой. Приступим к обмену?‡Die extrem wirksamen Essenzmangos wachsen auf vielen Inseln der südlichen Meere. Eine einzelne Mango erfrischt denjenigen, der davon isst, körperlich wie auch geistig. Solltet Ihr noch nie eine gekostet haben, dann erweist Ihr Euch damit keinen Dienst!nnHier auf der Insel verfügen wir über einen ausreichend großen Vorrat, um Euch ein paar davon im Austausch gegen eine zandalarianische Ehrenmünze geben zu können. Sprecht mit Vinchaxa, wenn Ihr wissen wollt, wie Ihr an Ehrenmünzen gelangt; ansonsten, lasst uns gleich Geschäfte machen!‡남쪽 바다에 있는 섬들 중 많은 곳에서는 극히 강력한 알짜 망고가 자라지요. 그 망고 하나만 먹으면 육체와 정신이 모두 팔팔하게 되살아나게 된답니다. 한 번도 먹어 본 적이 없다면 손해 보고 있는 거예요!nn우리가 이 섬에 재고를 충분히 보유하고 있으니 잔달라 명예 징표 하나당 망고 몇 개를 주도록 하지요. 징표를 어떻게 얻는지 모른다면 빈차샤와 얘기해 보도록 하고, 그렇지 않다면 당장 거래를 합시다!‡‡‡La mangue d\'essence, extrêmement puissante, pousse sur nombre des îles des Mers du sud. Une seule mangue rafraîchit celui qui la mange à la fois physiquement et mentalement. Si vous n\'en avez jamais mangé, vous ne savez pas ce que vous manquez !nnNous en avons suffisamment sur l\'île pour vous en proposer quelques-unes en échange d\'une marque d\'honneur zandalar. Parlez à Vinchaxa si vous ne savez pas comment obtenir les marques d\'honneur ; sinon, faisons affaire immédiatement !‡‡',
  }
},
[8201] = {
  {
    'Uma coleção de cabeças‡Коллекция голов‡Die Schädelsammlung‡머리카락 수집‡Una colección de cabezas‡Una colección de cabezas‡Une collection de têtes‡祭司的头颅‡收集頭顱',
    nil,
    'Amarre 5 Cabeças de Médium no cordão. Em seguida, volte com Coleção de Cabeças de Troll a Exzhal, na Ilha Yojamba.‡Соберите ожерелье из голов пятерых жрецов и вернитесь с ним к Экзалу на остров Йоджамба.‡Reiht die Köpfe der 5 Kanalisierer auf der heiligen Kordel aneinander. Bringt dann die Trollschädelsammlung zu Exzhal auf der Insel Yojamba.‡역술사의 머리카락 5개를 신성한 굴레에 묶은 후, 요잠바 섬에 있는 엑잘에게 구루바시 부족 머리카락으로된 전리품을 가져가야 합니다.‡Ata 5 cabezas de los canalizadores y regresa con ellas a Exzhal en la isla Yojamba.‡Ata 5 cabezas de canalizadores y regresa con ellas a Exzhal en la Isla Yojamba.‡Attachez 5 Têtes de canalistes, puis ramenez la Collection de têtes de Gurubashi à Exzhal sur l\'île des Zandalar.‡将神圣之索穿上5颗导魔师的头颅，然后把这一串头颅交给尤亚姆巴岛上的伊克萨尔。‡穿上5顆導魔師的頭顱，然後把這串食人妖頭顱交給尤亞姆巴島上的伊克薩爾。',
  }
},
[8221] = {
  {
    'Peixe raro – Acará-bandeira‡Редкая рыба – Рыба-ангел Кифера‡Besonderer Fisch - Kiefers Engelfisch‡희귀한 키퍼의 천사돔‡Pez raro: pez ángel de Keefer‡Pez raro: pez ángel de Keefer‡Poisson rare : le scalaire de Keefer‡稀有鱼类 - 基佛天使鱼‡稀有魚類 - 基佛天使魚',
    nil,
    '‡*ЖЖЖ**Щелк*nnЯ разыскиваю редкие сорта рыбы по поручению рыбака Синежаброго. Если вы принесете мне рыбу-ангела Кифера, то получите награду.nn*Щелк**Жжж*‡*Surrr* *PLIIING*nnIch suche besondere Fische, um sie für Fischereimeister Bluegill zu katalogisieren. Bringt mir einen Keefers Engelfisch und ich werde Euch eine feine Belohnung zuteil werden lassen. nn*KLING**Bzzzz*‡*위잉* *딸깍*nn낚시로봇 5000은 낚시의 대가이신 블루길님이 목록에 올릴 희귀한 물고기를 찾도록 설계되어 있습니다. 키퍼의 천사돔을 제출하시면 아주 훌륭한 보상을 드리도록 하겠습니다.nn *찌이익* *위잉*‡‡‡‡‡',
  }
},
[8222] = {
  {
    'Sangue Luminescente de Escorpídeo‡Светящаяся кровь скорпида‡Leuchtendes Skorpidblut‡붉은 전갈 피‡Sangre de escórpido resplandeciente‡Sangre de escórpido resplandeciente‡Sang de scorpide luminescent‡闪光的蝎血‡發光的蠍血',
    nil,
    '‡За все время, что я работаю на ярмарке, я усвоил множество истин. Поделюсь полезным знанием: публика обожает блестящие безделушки! Это может быть что угодно – возьми, скажем, ножку от стула и покрась ее золотой краской. За эту штуковину будет драться детвора со всей округи!nnИтак, Великийгром, мне нужна светящаяся кровь скорпида. Скорпидов можно найти в Силитусе, Выжженных землях или Пылающих степях.‡In all der Zeit, in der ich nun mit dem Jahrmarkt reise, habe ich viel über unsere Kunden gelernt. Eine Kostprobe meiner Weisheit gefällig? Kunden lieben alles, was leuchtet. Es ist völlig egal was! Ihr könntet ein abgebrochenes Stuhlbein nehmen und es zum Leuchten bringen und schon würde jedes Kind von egal wieweit her kommen, nur um darauf einen Blick werfen zu können!nnTja <Name>, ich brauche also leuchtendes Skorpidblut. Bei den Skorpiden in Silithus, in den verwüsteten Landen oder der brennenden Steppe solltet Ihr fündig werden.‡다크문 축제에서 일하면서 고객들에 대해 많은 것을 배웠지요. 지혜가 담긴 조언 하나 해 드리죠. 고객들은 반짝반짝 빛나는 물건을 아주 좋아합니다! 뭐든 상관없어요. 부서진 의자 다리라도 반짝반짝 빛나게만 해 놓으면 아이들이 저마다 하나씩 사려고 먼 곳에서 찾아오곤 한답니다!nn그래서 말인데, 붉은 전갈 피가 필요합니다. 실리더스나 저주받은 땅, 불타는 평원 같은 곳에 서식하는 전갈들에게서 구할 수 있을 겁니다.‡‡‡Tout ce temps passé à la foire m’a beaucoup appris sur nos clients. Voici l’un de mes axiomes : si ça brille, ça plaît ! Et peu importe ce que c’est en réalité. Vous pouvez prendre des pieds de chaises cassés, s’ils brillent, tous les gamins à des lieues à la ronde feront la queue pour en acheter un !nnBref, tout cela pour dire qu’il me faut du sang de scorpide luminescent, <nom>. Vous pourrez en trouver sur les scorpides de Silithus, des Terres foudroyées ou des Steppes ardentes.‡‡',
  }
},
[8223] = {
  {
    'Mais sangue luminescente de escorpídeo‡Обмен: светящаяся кровь скорпида‡Mehr leuchtendes Skorpidblut‡더 많은 붉은 전갈 피‡Más sangre de escórpido resplandeciente‡Más sangre de escórpido resplandeciente‡Encore du sang de scorpide luminescent‡更多闪光的蝎血‡',
    nil,
    '‡А знаешь, Кхалдун, кровь скорпидов – отличное средство! Удивительно, как с помощью блесток можно любой мусор превратить в изысканную поделку. Клиентам полюбились безделушки, а любовь правит миром, так ведь?nnТвоя помощь неоценима, Кхалдун. Если вдруг ты раздобудешь еще светящейся крови скорпида, принеси ее мне, и я дам тебе ярмарочные купоны!‡‡‡‡‡Ce sang de scorpide fait des merveilles, <nom> ! C’est fou ce qu’un peu de brillant peut faire – cela suffit à transformer un détritus en objet de valeur. Les clients aiment ça, et vous savez, au fond, tout cela est une question d’amour…nnVous m’avez rendu un grand service, <nom>, et même si je n’ai pas un besoin urgent de plus de sang de scorpide luminescent, si vous m’en ramenez davantage, je vous l’échangerai contre des bons.‡‡',
  }
},
[8224] = {
  {
    'Peixe raro – Peixe-rainha Deziano‡Редкая рыба – дезийская ставрида‡Besonderer Fisch - Dezianischer Königinnenfisch‡희귀한 데지안 여왕물고기‡Pez raro: pez reina de Dezian‡Pez raro: pez reina de Dezian‡Poisson rare : le talang dezien‡稀有鱼类 - 迪森皇后鱼‡稀有魚類 - 迪森皇后魚',
    nil,
    '‡*ЖЖЖ**Щелк*nnЯ разыскиваю редкие сорта рыбы по поручению рыбака Синежаброго. Если вы принесете мне дезийскую ставриду, то получите награду.nn*Щелк**Жжж*‡‡‡‡‡‡‡',
  }
},
[8225] = {
  {
    'Peixe raro – Veloso-azul-listrado‡Редкая рыба – Синий полосатик Браунелла‡Besonderer Fisch - Braunells blaugestreifter Flitzerfisch‡희귀한 브로넬의 푸른줄무늬날치‡Pez raro: azulín a rayas de Brownell‡Pez raro: corredor a rayas azules de Brownell‡Poisson rare : le tassergal à dos rayé‡稀有鱼类 - 布隆奈尔蓝斑鱼‡稀有魚類 - 布隆奈爾藍斑魚',
    nil,
    nil,
  }
},
[8227] = {
  {
    'A fita métrica do Nat‡Измерительная лента Ната‡Nats Maßband‡내트의 줄자‡Cinta métrica de Nat‡Cinta métrica de Nat‡Le mètre ruban de Nat‡纳特的卷尺‡納特的捲尺',
    nil,
    'Leve a Fita Métrica do Nat de volta para Nat Pagle no Pântano Vadeoso.‡Верните измерительную ленту Нату Пэглу. Найти Пэгла можно в Пылевых топях.‡Bringt Nats Maßband zu Nat Pagle in den Düstermarschen zurück.‡먼지진흙 습지대에 있는 내트 페이글에게 내트의 줄자를 돌려줘야 합니다.‡Devuelve la Cinta métrica de Nat a Nat Pagle en el Marjal Revolcafango.‡Devuelve la Cinta métrica de Nat a Nat Pagle en el Marjal Revolcafango.‡Rendre le Mètre ruban de Nat à Nat Pagle, au marécage d\'Âprefange.‡将纳特的卷尺交给尘泥沼泽的纳特·帕格。‡將納特的捲尺交給塵泥沼澤的納特·帕格。',
  }
},
[8228] = {
  {
    'Me dá um panfleto da pescaria!‡Путевка на рыбалку‡Könnte ich einen Flugzettel für den Angelwettbewerb bekommen?‡낚시왕 선발대회!‡¿Puedo tener un folleto de pesca?‡¿Puedo tener un folleto de pesca?‡Puis-je avoir un prospectus sur la pêche ?‡能给我一张宣传单吗？‡',
    nil,
    '‡В это воскресенье в Пиратской бухте будет рыболовецкое состязание! Если хочешь принять участие, вот, почитай правила!‡Es wird diesen Sonntag einen Angelwettbewerb in Booty Bay geben! Hier sind die Regeln für den Wettbewerb, falls Ihr daran teilnehmen möchtet!‡이번 일요일에 무법항에서 낚시왕 선발대회가 열린다네! 여기 선발대회 규칙을 꼭 읽어 보시고 대회에 참여하라고!‡‡‡Il y aura un concours de pêche à Baie-du-Butin ce dimanche ! Voici ses règles si vous souhaitez y participer !‡‡',
  }
},
[8229] = {
  {
    'Me dá um panfleto da pescaria!‡Путевка на рыбалку‡Könnte ich einen Flugzettel für den Angelwettbewerb bekommen?‡낚시왕 선발대회!‡¿Puedo tener un folleto de pesca?‡¿Puedo tener un folleto de pesca?‡Puis-je avoir un prospectus sur la pêche ?‡能给我一张宣传单吗？‡',
    nil,
    '‡В это воскресенье в Пиратской бухте будет рыболовецколе состязание! А вот и правила!‡Es wird einen Angelwettbewerb in Booty Bay geben, diesen Sonntag! Hier sind die Regeln für Euch!‡이번 일요일에 무법항에서 낚시왕 선발대회가 열립니다! 여기 선발대회 규칙을 꼭 읽어 보시고 대회에 참여하세요!‡‡‡Concours de pêche à Baie-du-Butin ce dimanche ! Voilà les règles !‡‡',
  }
},
[8230] = {
  {
    'Collin\'s Test Quest‡Пробное задание Коллина‡Collins Test Quest‡‡La misión de prueba de Collin‡La misión de prueba de Collin‡Quête de test de Collin‡‡',
    nil,
    nil,
  }
},
[8231] = {
  {
    'Furando onda‡Охота на волномета‡Wellenjagd‡폭풍히드라 사냥‡Los vándalos marinos‡Los vándalos marinos‡Vandales des flots‡碎浪多头怪‡獵殺碎浪多頭蛇',
    nil,
    'Leve 6 Escamas de Fura-ondas para Ogtinc em Azshara. Ogtinc mora no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Принесите 6 чешуй волношлепа Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Bringt 6 Wellenhauerschuppen zu Ogtinc in Azshara. Ogtinc wohnt oberhalb des Kliffs, nordöstlich der Ruinen von Eldarath.‡아즈샤라에 엘다라스 폐허의 북동쪽 절벽 꼭대기에 있는 오그틴크에게 폭풍히드라 비늘 6개를 가져가야 합니다.‡Llévale 6 escamas de vándalo marino a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Llévale 6 escamas de descarnador marino a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Apporter 6 Écailles de vandale des flots à Ogtinc en Azshara. Ogtinc demeure au sommet des falaises au nord-est des ruines d\'Eldarath.‡将6块碎浪多头怪的鳞片交给艾萨拉的奥汀克。奥汀克居住在埃达拉斯废墟东北部的悬崖顶部。‡帶回6個碎浪多頭蛇的鱗片給艾薩拉的奧汀克。奧汀克居住在埃達拉斯廢墟東北部的懸崖頂部。',
  }
},
[8232] = {
  {
    'O draco verde‡Зеленый дракон‡Der grüne Drache‡녹색 비룡 몰파즈‡El draco verde‡El draco verde‡Le drake vert‡神庙中的绿龙‡神廟中的綠龍',
    nil,
    'Leve o Dente de Morphaz para Ogtinc em Azshara. Ogtinc mora no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Принесите зуб Морфаза Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Bringt Morphaz\' Zahn zu Ogtinc in Azshara. Ogtinc wohnt oberhalb des Kliffs, nordöstlich der Ruinen von Eldarath.‡아즈샤라에 엘다라스 폐허의 북동쪽 절벽 꼭대기에 있는 오그틴크에게 몰파즈의 이빨을 가져가야 합니다.‡Llévale el diente de Morphaz a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Llévale el diente de Morphaz a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Apporter la Dent de Morphaz à Ogtinc en Azshara. Ogtinc demeure au sommet des falaises au nord-est des ruines d\'Eldarath.‡将摩弗拉斯的牙齿交给艾萨拉的奥汀克。他住在埃达拉斯废墟东北部悬崖的顶端。‡將摩弗拉斯的牙齒交給艾薩拉的奧汀克。他住在埃達拉斯廢墟東北部懸崖的頂端。',
  }
},
[8233] = {
  {
    'Um pedido simples‡Приглашение‡Ein simples Anliegen‡간단한 부탁‡Un pedido sencillo‡Un pedido sencillo‡Une requête toute simple‡简单的要求‡簡單的要求',
    nil,
    'Fale com Lorde Jorach Corvoforte na Mansão de Corvoforte.‡Поговорите с лордом Джорахом Черным Вороном в его поместье.‡Sprecht mit Lord Jorach Rabenholdt im Rabenholdtanwesen.‡라벤홀트 장원에 있는 조라크 라벤홀트 경과 대화해야 합니다.‡Habla con Lord Jorach Ravenholdt en la Mansión Ravenholdt.‡Habla con Lord Jorach Ravenholdt en la Mansión Ravenholdt.‡Parler au seigneur Jorach Ravenholdt, au manoir de Ravenholdt.‡前往拉文霍德庄园，和乔拉齐·拉文霍德公爵谈一谈。‡前往拉文霍德莊園，和喬拉齊·拉文霍德領主談一談。',
  }
},
[8234] = {
  {
    'Saco lazúli lacrado‡Запечатанная лазурная сумка‡Die versiegelte azurblaue Tasche‡봉인된 하늘색 자루‡Bolsa azur sellada‡Bolsa azur sellada‡Sac azur scellé‡密封的蓝袋子‡密封的藍袋子',
    nil,
    'Recupere o Saco Lazúli Lacrado com o Xamã Presamatos, em Azshara. Então o leve para o Arquimago Tauriel, também em Azshara.‡Добудьте запечатанную лазурную сумку у шамана из племени Древобрюхов в Азшаре. Затем отнесите сумку верховному магу Ксилему в Азшаре.‡Erlangt die versiegelte azurblaue Tasche von dem Schamanen der Holzschlundfeste in Azshara zurück. Bringt sie anschließend zum Erzmagier Xylem, der ebenfalls in Azshara zu finden ist.‡아즈샤라에 있는 나무구렁일족 주술사에게서 봉인된 하늘색 자루를 되찾은 후, 그 가방을 아즈샤라에 있는 대마법사 실렘에게 가져가야 합니다.‡Recupera la bolsa azur sellada del chamán Fauces de Madera en Azshara. Llévale entonces la bolsa al archimago Xylem, que también se encuentra en Azshara.‡Recupera la bolsa azur sellada del chamán Fauces de Madera en Azshara. Llévale entonces la bolsa al archimago Xylem, que también se encuentra en Azshara.‡Récupérez le Sac azur scellé auprès du chaman Grumegueule en Azshara. Puis apportez le sac à l\'archimage Xylem, également en Azshara.‡从艾萨拉的木喉萨满祭司那儿取回密封的蓝袋子，将它交给艾萨拉的大法师克希雷姆。‡從艾薩拉的木喉薩滿那兒取回密封的藍袋子，將它交給艾薩拉的大法師克希雷姆。',
  }
},
[8235] = {
  {
    'Fragmentos codificados‡Зашифрованные фрагменты‡Verschlüsselte Fragmente‡암호화된 페이지‡Los trozos codificados‡Los trozos codificados‡Les fragments codés‡密文碎片‡密碼碎片',
    nil,
    'Leve 10 Fragmentos Codificados para o Arquimago Tauriel em Azshara.‡Принесите 10 зашифрованных фрагментов верховному магу Ксилему в Азшару.‡Bringt Erzmagier Xylem in Azshara 10 verschlüsselte Fragmente.‡아즈샤라에 있는 대마법사 실렘에게 암호화된 페이지 10개를 가져가야 합니다.‡Llévale 10 fragmentos codificados al archimago Xylem en Azshara.‡Llévale 10 fragmentos codificados al archimago Xylem en Azshara.‡Apporter 10 Fragments codés à l\'archimage Xylem en Azshara.‡将10块密文碎片交给艾萨拉的大法师克希雷姆。‡將10片密碼碎片交給艾薩拉的大法師克希雷姆。',
  }
},
[8236] = {
  {
    'A chave lazúli‡Лазурный ключ‡Der azurblaue Schlüssel‡하늘색 열쇠‡La llave azur‡La llave azur‡La clé d\'azur‡碧蓝钥匙‡碧藍鑰匙',
    nil,
    'Leve a Chave Lazúli para o Lorde Jorach Corvoforte.‡Принесите лазурный ключ лорду Черному Ворону.‡Bringt den azurblauen Schlüssel zu Lord Jorach Rabenholdt.‡조라크 라벤홀트 경에게 하늘색 열쇠를 가져가야 합니다.‡Devuélvele la llave azur a Lord Jorach Ravenholdt.‡Devuélvele la llave azur a Lord Jorach Ravenholdt.‡Rendre la Clé d\'azur au seigneur Jorach Ravenholdt.‡将碧蓝钥匙交给乔拉齐·拉文霍德公爵。‡將碧藍鑰匙交給喬拉齊·拉文霍德領主。',
  }
},
[8238] = {
  {
    'As moedas Cascasseca, Ramatorpe e Gurubashi‡Монеты племен Гурубаши, Порочной Ветви и Сухокожих‡Münzen der Gurubashi, Blutfratzen und Bleichborken‡구루바시, 썩은가지, 마른나무껍질부족 주화‡Las monedas Gurubashi, Vilrama y Secacorteza‡Las monedas Gurubashi, Vilrama y Secacorteza‡Pièces Gurubashi, Vilebranche et Fânécorce‡古拉巴什、邪枝和枯木硬币‡古拉巴什、邪枝和枯木硬幣',
    nil,
    'Procuro os Epítomes de Poder conhecidos como Moedas das Tribos. São usadas por todos os moradores de Zul\'Gurub, e todas elas são imbuídas de um mojo que, embora sutil, é bem forte.nnHá nove tipos diferentes de moeda. Algumas são procuradas pelos meus compatriotas por várias armaduras que oferecem aos heróis de Zandalar. Se tiver algumas sobrando, posso trocas três por uma das nossas Insígnias de Honra. Você pode levar as insígnias para Rin\'wosho, o Comerciante. Ele oferece aos nossos heróis itens especiais em troca delas.‡Мне нужны Знаки Силы, более известные как Монеты племен. Это ходовые монеты различных племен Зул\'Гуруба, и на каждую из них наложено незаметное, но могущественное заклятие.nnСуществует девять видов таких монет. За некоторые из них мои компаньоны готовы поделиться с тобой снаряжением. Будут лишние – обращайся и ко мне, я обменяю три монеты на знак отличия. А ты эти знаки уже сможешь обменять у Рин\'вошо Торговца на нечто особенное.‡Ich suche nach den Symbolen der Macht, bekannt als Münzen der Stämme. Sie sind die Währung unterschiedlichster Bewohner Zul\'Gurubs und eine jede ist mit subtilem, aber mächtigem Mojo erfüllt.nnEs gibt neun bestimmte Arten, die es zu finden gilt. Manche werden von meinen Landsmänner für unterschiedliche Rüstungen begehrt, die sie zandalarianischen Helden anbieten. Solltet Ihr welche über haben, werde ich Euch eine unserer Ehrenmünzen im tausch gegen drei davon geben. Ihr könnt die Münzen bei Rin\'wosho dem Händler verwenden; er bietet unseren Helden spezielle Gegenstände dafür an.‡나는 트롤 부족 주화라고 불리는 마력의 보물을 찾고 있다네. 줄구룹의 다양한 부족들이 사용하는 통화로, 각각 신비로우면서도 강력한 모조가 부여되어 있지.nn그 주화는 서로 다른 아홉 가지 종류가 있는데, 어떤 것은 내 동료들이 잔달라 영웅들에게 줄 다양한 보호구를 제작하는 데 쓰려고 찾고 있다네. 혹시 여분이 생기거든 세 개당 우리 잔달라 명예 징표 하나로 교환해 주겠네. 그 징표는 우리 영웅들에게 특별한 물건들을 제공하는 상인 린워쇼에게 쓸 수 있을 걸세.‡Necesito los Dechados de Poder conocidos como Monedas de las Tribus. Son la moneda que utilizan los distintos habitantes de Zul\'Gurub y todas ellas están imbuidas con un sutil pero potente mojo.nnHay nueve tipos diferentes. Mis compatriotas buscan algunas de ellas para las distintas armaduras que ofrecen a los héroes Zandalar. Si tuvieras alguna de sobra te la cambiaré tres de ellas por una de nuestras marcas de honor. Puedes utilizar las marcas con Rin\'wosho el Mercader, a cambio te ofrecerá objetos especiales.‡‡Je cherche les Parangons de puissance connus sous le nom de Pièces des Tribus. Il s\'agit de la monnaie utilisée par les différents habitants de Zul\'Gurub, et chacune est imprégnée d\'un subtil mais puissant mojo.nnIl y en existe neuf types distincts. Certaines sont recherchées par mes compatriotes pour différentes armures qu\'ils proposent aux héros des Zandalar. Si vous en avez, je vous les échangerai contre une de nos marques d\'honneur par ensemble de trois. Vous pouvez utiliser les marques chez Rin\'wosho le marchand : il propose à nos héros des articles spéciaux en échange.‡‡',
  }
},
[8239] = {
  {
    'As moedas Sanguescalpo, Rachacrânio e Zangareia‡Монеты племен: Песчаная Буря, Дробители Черепов и Кровавый Скальп‡Münzen der Sandwüter, Schädelspalter und Blutskalpe‡성난모래, 백골가루, 붉은머리부족 주화‡Las monedas Furiarena, Machacacráneos y Sangrapellejo‡Las monedas Furiarena, Machacacráneos y Sangrapellejo‡Pièces Furie-des-sables, Casse-crâne et Scalp-rouge‡沙怒、碎颅和血顶硬币‡沙怒、劈顱和血頂硬幣',
    nil,
    'Procuro os Epítomes de Poder conhecidos como Moedas das Tribos. São usadas por todos os moradores de Zul\'Gurub, e todas elas são imbuídas de um mojo que, embora sutil, é bem forte.nnHá nove tipos diferentes de moeda. Algumas são procuradas pelos meus compatriotas por várias armaduras que oferecem aos heróis de Zandalar. Se tiver algumas sobrando, posso trocas três por uma das nossas Insígnias de Honra. Você pode levar as insígnias para Rin\'wosho, o Comerciante. Ele oferece aos nossos heróis itens especiais em troca delas.‡Мне нужны Знаки Силы, более известные как Монеты племен. Это ходовые монеты различных племен Зул\'Гуруба, и на каждую из них наложено незаметное, но могущественное заклятие.nnСуществует девять видов таких монет. За некоторые из них мои компаньоны готовы поделиться с тобой снаряжением. Будут лишние – обращайся и ко мне, я обменяю три монеты на знак отличия. А ты эти знаки уже сможешь обменять у Рин\'вошо Торговца на нечто особенное.‡Ich suche nach den Symbolen der Macht, bekannt als Münzen der Stämme. Sie sind die Währung unterschiedlichster Bewohner Zul\'Gurubs und eine jede ist mit subtilem, aber mächtigem Mojo erfüllt.nnEs gibt neun bestimmte Arten, die es zu finden gilt. Manche werden von meinen Landsmänner für unterschiedliche Rüstungen begehrt, die sie zandalarianischen Helden anbieten. Solltet Ihr welche über haben, werde ich Euch eine unserer Ehrenmünzen im Tausch gegen drei davon geben. Ihr könnt die Münzen bei Rin\'wosho dem Händler verwenden; er bietet unseren Helden spezielle Gegenstände dafür an.‡나는 트롤 부족 주화라고 불리는 마력의 보물을 찾고 있다네. 줄구룹의 다양한 부족들이 사용하는 통화로, 각각 신비로우면서도 강력한 모조가 부여되어 있지.nn그 주화는 서로 다른 아홉 가지 종류가 있는데, 어떤 것은 내 동료들이 잔달라 영웅들에게 줄 다양한 보호구를 제작하는 데 쓰려고 찾고 있다네. 혹시 여분이 생기거든 세 개당 우리 부족의 명예 징표 하나로 교환해 주겠네. 그 징표들은 우리 영웅들에게 특별한 물건들을 제공하는 상인 린워쇼에게 쓸 수 있을 걸세.‡Necesito los Dechados de Poder conocidos como Monedas de las Tribus. Son la moneda que utilizan los distintos habitantes de Zul\'Gurub y todas ellas están imbuidas con un sutil pero potente mojo.nnHay nueve tipos diferentes. Mis compatriotas buscan algunas de ellas para las distintas armaduras que ofrecen a los héroes Zandalar. Si tuvieras alguna de sobra te la cambiaré tres de ellas por una de nuestras marcas de honor. Puedes utilizar las marcas con Rin\'wosho el Mercader, a cambio te ofrecerá objetos especiales.‡‡Je cherche les Parangons de puissance connus sous le nom de Pièces des Tribus. Il s\'agit de la monnaie utilisée par les différents habitants de Zul\'Gurub, et chacune est imprégnée d\'un subtil mais puissant mojo.nnIl y en existe neuf types distincts. Certaines sont recherchées par mes compatriotes pour différentes armures qu\'ils proposent aux héros des Zandalar. Si vous en avez, je vous les échangerai contre une de nos marques d\'honneur par ensemble de trois. Vous pouvez utiliser les marques chez Rin\'wosho le marchand : il propose à nos héros des articles spéciaux en échange.‡‡',
  }
},
[8240] = {
  {
    'Uma joia para Zanza‡Драгоценности для Занзы‡Ein Schmuckstück für Zanza‡잔자를 위한 장신구‡Una presea para Zanza‡Una joya para Zanza‡Un Bijou pour Zanza‡赞扎的宝石‡贊札的寶石',
    nil,
    'Destrua as Joias Hakkari encontradas em Zul\'Gurub no Altar de Zanza, que fica na Ilha Yojamba. Quando terminar, fale com Vinchaxa.‡Найдите в Зул\'Гурубе драгоценности племени Хаккари и уничтожьте их на алтаре Занзы на острове Йоджамба. Затем поговорите с Винчаксой.‡Zerstört jedes Schmuckstück der Hakkari, das Ihr in Zul\'Gurub findet, am Altar von Zanza auf der Insel Yojamba. Sobald Ihr dies getan habt, sprecht ganz in der Nähe mit Vinchaxa.‡줄구룹에서 찾은 학카리 장신구 중 아무거나 가져와 요잠바 섬에 있는 잔자의 제단에서 파괴한 후, 제단 근처에 있는 빈차샤와 대화해야 합니다.‡Destruye una de las preseas Hakkari que hayas encontrado en Zul\'Gurub en el Altar de Zanza en Isla Yojamba. Cuando lo hayas hecho ve a hablar con Vinchaxa.‡Destruye una de las Joyas Hakkari que hayas encontrado en Zul\'Gurub en el Altar de Zanza en Isla Yojamba. Cuando lo hayas hecho ve a hablar con Vinchaxa.‡Détruisez n\'importe lequel des Bijoux hakkari trouvé à Zul\'Gurub à l\'Autel de Zanza, sur l\'Ile de Yojamba. Quand ce sera fait, parlez à Vinchaxa qui se trouve à côté.‡将你在祖尔格拉布找到的哈卡莱宝石带往尤亚姆巴岛的赞扎祭坛进行销毁，然后跟祭坛旁边的温卡萨谈一谈。‡將你在祖爾格拉布找到的哈卡萊寶石帶往尤亞姆巴島的贊札祭壇進行銷毀。一旦成功，跟附近的溫卡薩談談。',
  }
},
[8241] = {
  {
    'Restaurando suprimentos de fluxo ígneo via ferro‡Пополнить запасы огненного плавня с помощью железа‡Nachschub an feurigem Fluxus: Eisen‡불꽃 융해촉진제 재고 재비축 - 철‡Fabricar flujo ígneo con hierro‡Fabricar flujo ígneo con hierro‡Réapprovisionnement en flux embrasé (Fer)‡炽热助熔剂的补给：铁锭‡熾熱助熔劑的補給:鐵錠',
    nil,
    'Barbaridade, não vamos mais perder meu precioso tempo com bobagem, <race>. É hora de nos concentramos em reabastecer nosso suprimento cada vez mais baixo de fluxo ígneo.nnVou precisar que tu me traga as seguintes coisas:nn*Escamas de incendossauro.nn*Barras de ferro.nn*Carvão.nnVou levar todos que tu puder me oferecer!nnE tu tem que fazer isso rápido se quiser conquistar pontos com a Irmandade, guri.‡Не будем тратить драгоценное время на ерунду, |3-6(дворф). Пора пополнить запасы огненного плавня – они уже совсем на исходе. nnВот что мне от тебя нужно: nn*Чешуя пламезавра nn*Железные слитки nn*Уголь.nnМне нужно все, что ты сможешь предложить! И поторопись, если хочешь угодить Братству.‡Lasst uns nicht noch mehr meiner kostbaren Zeit mit Geplapper verschwenden, <Volk>. Wir müssen unseren schwindenden Vorrat an feurigen Fluxus wieder aufstocken.nnIch brauche Euch, um mir folgendes zu beschaffen:nn*Incendosaurierschuppen.nn*Eisenbarren.nn*Kohle.nnIch nehme alles was Ihr kriegen könnt!nnUnd seid besser schnell! Ihr wollt es Euch doch nicht mit der Bruderschaft verderben, oder?‡아까운 내 시간을 잡담이나 하면서 더 낭비하지는 마시게. 줄어들고 있는 불꽃 융해촉진제 재고를 다시 비축하는 데 주력해야 할 때니까 말이야.nn내가 자네에게 부탁할 물건은 다음과 같네.nn*인센도사우루스 비늘nn*철 주괴nn*석탄nn당신이 가져올 수 있는 건 모두 다 받지!nn대장조합의 눈에 들려면 서두르는 게 좋을 걸세.‡Mi tiempo es demasiado valioso para perderlo con charlas, <raza>. Quiero fabricar más flujo ígneo.nnPara eso, necesito que me traigas lo siguiente:nn*Escamas de incendosaurio.nn*Barras de hierro.nn*Carbón.nn¡Tráeme tanto como puedas!nnY tan rápido como puedas, si es que quieres ganarte el favor de la Hermandad.‡‡Assez perdu de temps à bavarder, <race>. Il est temps de nous concentrer sur le réapprovisionnement de nos réserves de flux embrasé qui s\'amenuisent.nnVoici ce que je veux que vous me rapportiez :nn*Ecailles d\'incendosaure.nn*Barres de fer.nn*Charbon.nnJe prendrai tout ce que vous me donnerez !nnEt vous le ferez vite si vous voulez bien vous entendre avec la Confrérie.‡‡',
  }
},
[8242] = {
  {
    'Restaurando suprimentos de fluxo ígneo via couro pesado‡Пополнить запасы огненного плавня с помощью толстой кожи‡Nachschub an feurigem Fluxus: Schweres Leder‡불꽃 융해촉진제 재고 재비축 - 질긴 가죽‡Fabricar flujo ígneo con cuero pesado‡Fabricar flujo ígneo con cuero pesado‡Réapprovisionnement en flux embrasé (Cuir lourd)‡炽热助熔剂的补给：重皮‡熾熱助熔劑的補給:重皮',
    nil,
    'Chega de desperdiçar o meu precioso tempo com bobagem, <race>. A prioridade agora é reabastecer o nosso suprimento cada vez mais baixo de fluxo ígneo.nnVou precisar que você me traga o seguinte:nn*Escamas de incendossauro.nn*Couro pesado.nn*Carvão.nnQuanto mais você trouxer, melhor!nnMas se quiser conquistar pontos com a Irmandade, tem que ser rápido.‡Не будем тратить драгоценное время на ерунду, |3-6(дворф). Пора пополнить запасы огненного плавня – они уже совсем на исходе. nnВот что мне от тебя нужно: nn*Чешуя пламезавра nn*Тяжелая кожа nn*Уголь nnМне нужно все, что ты сможешь предложить! И поторопись, если хочешь угодить Братству.‡Lasst uns nicht noch mehr meiner kostbaren Zeit mit Geplapper verschwenden, <Volk>. Wir müssen unseren schwindenden Vorrat an feurigen Fluxus wieder aufstocken.nnIch brauche Euch, um mir folgendes zu beschaffen:nn*Incendosaurierschuppen.nn*Schweres Leder.nn*Kohle.nnIch nehme alles was Ihr kriegen könnt!nnUnd seid besser schnell! Ihr wollt es Euch doch nicht mit der Bruderschaft verderben, oder?‡이보라고, 아까운 내 시간을 잡담이나 하면서 더 낭비하지는 마세나. 줄어들고 있는 불꽃 융해촉진제 재고를 다시 비축하는 데 주력해야 할 때니까 말이야.nn내게 자네에게 부탁할 물건은 다음고 같네.nn*인센도사우루스 비늘nn*질긴 가죽nn*석탄nn자네가 가져올 수 있는 건 모두 다 받도록 하지!nn우리 토륨 대장조합의 눈에 들려면 서두르는 게 좋을 거라고.‡Mi tiempo es demasiado valioso para perderlo con charlas, <raza>. Quiero fabricar más flujo ígneo.nnPara eso, necesito que me traigas lo siguiente:nn*Escamas de incendosaurio.nn*Cuero pesado.nn*Carbón.nn¡Tráeme tanto como puedas!nnY tan rápido como puedas, si es que quieres ganarte el favor de la Hermandad.|n‡‡Assez perdu de temps à bavarder, <race>. Il est temps de nous concentrer sur le réapprovisionnement de nos réserves de flux embrasé qui s\'amenuisent.nnVoici ce que je veux que vous me rapportiez :nn*Ecailles d\'incendosaure.nn*Cuir lourd.nn*Charbon.nnJe prendrai tout ce que vous me donnerez !nnEt vous le ferez vite si vous voulez bien vous entendre avec la Confrérie.‡‡',
  }
},
[8243] = {
  {
    'As poderosas misturas de Zanza‡Напиток могущества Занзы‡Zanzas wirksame Tränke‡잔자의 강력한 음료‡Los mejunjes potentes de Zanza‡Los mejunjes potentes de Zanza‡Puissants breuvages de Zanza‡赞扎的饮料‡贊札的飲料',
    nil,
    'Agora que você ganhou o respeito da tribo, ganhou também acesso às nossas poderosas misturas. Vê só... é uma bebida puxada no mojo, com a bênção do Zanza aqui!nnVocê pode escolher uma das três que eu tenho e, em troca, quero um Emblema Honorífico de Zandalar. Só precisa beber um desses pros efeitos atingirem o seu espírito.nnQuando estiver a fim de fazer a troca, é só falar comigo novamente.‡Теперь, когда племя тебе доверяет, ты можешь воспользоваться нашими зельями. Вот, смотри. Этот напиток несет на себе благословение Занзы, и любой искатель приключений будет счастлив обладать им.nnУ меня в запасе три таких напитка, и я дам тебе один из них, но взамен мне нужен почетный знак Зандалара. Запомни: пока ты находишься под действием одного из напитков, ты не сможешь принять другой.nnВозвращайся, когда у тебя появится то, что нужно для обмена.‡Mit Eurem verbesserten Ruf innerhalb unseres Stammes, bekommt Ihr auch Zugang zu einigen unserer wirksamsten Tränke. Nehmt Euch in Acht... diese Gebräue sind stark im Mojo - gesegnet von Zanza und für Abenteurer jeglicher Herkunft gemacht!nnIch lasse Euch einen aus den drei Tränken, die ich anbiete, auswählen; im Gegenzug verlange ich eine zandalarianische Ehrenmünze. Seid Euch im Klaren, dass nur jeweils die Effekte eines Tranks zu einer beliebigen Zeit durch Euren Geist jagen können.nnLasst mich wissen, wenn Ihr zum Tauschhandel bereit seid!‡부족에게 명성이 높아졌으니 당신은 이제 우리의 더 강력한 음료 몇 가지를 이용할 수 있게 됐습니다. 잘 보세요... 이것들에는 강한 모조가 깃들어 있답니다. 잔자께서 축복을 내리신 것으로, 모든 모험가들이 마실 수 있지요!nn세 가지 종류 중에서 하나를 고를 수 있도록 해 줄테니 그 대가로 잔달라 명예 징표 하나를 가져다 주세요. 참고로 동시에 이 중 하나의 효과만이 당신의 영혼에 흐를 수 있다는 사실을 명심하세요.nn자, 거래할 준비가 되거든 내게 알려 주십시오!‡Gracias a tu estatus entre los de la tribu puedes acceder a algunos de nuestros mejunjes potentes. Mira... estos brebajes reciben su fuerza del mojo, están bendecidos por Zanza y se preparan para los aventureros de todo tipo y procedencia.nnTe permitiré elegir uno de los tres tipos de bebida que preparo pero a cambio necesito tres muestras de honor Zandalar. Ten en cuenta que solo pueden fluir por tu espíritu los efectos de un solo brebaje al mismo tiempo.nn¡Avísame cuando estés listo para el trueque!‡‡Votre nouveau statut au sein de la tribu vous donne accès à certains de nos breuvages plus puissants. Regardez... ces mixtures sont fortes en mojo, bénies par Zanza et conviennent aux aventuriers de tous horizons !nnJe vais vous permettre de choisir l\'une des trois que je propose. En échange, je demande une marque d\'honneur zandalar. Veuillez noter que les effets d\'un seul breuvage à la fois peuvent habiter votre esprit.nnDites-moi quand vous serez prêt à faire l\'échange !‡‡',
  }
},
[8246] = {
  {
    'Sinetes dos zandalarianos‡Перстни Зандалара‡Das Siegel der Zandalar‡잔달라 모조의 인장‡Las sortijas de Zandalar‡Las sortijas de Zandalar‡Cachets des Zandalar‡赞达拉的徽记‡贊達拉的徽記',
    nil,
    '<name>, eu tenho exatamente o que um camarada exaltado como você aqui em Zandalar merece. Direto do nosso lar, lá nos Mares do Sul: os Sinetes Zandalarianos! Eles servem pra melhorar qualquer equipamento de ombro que você tiver. É só você dizer o quer – eu tenho! Pode ser força, mojo, tranquilidade...nnEm troca de um sinete quero quinze Emblemas Honoríficos de Zandalar. Se você tem o que eu preciso, estou pronto para fazermos a troca!‡Для друзей нашего племени, Лорегон, у меня есть особый подарок прямо из нашего дома в Южных морях... Перстни Зандалара! Они усиливают любые наплечники и влияют на силу нападения или заклинаний.nnВ обмен на каждое кольцо мне нужно 15 почетных знаков Зандалара.‡Für jemanden, der bei den Zandalar so angesehen ist wie Ihr <Name>, habe ich etwas sehr Besonderes. Direkt aus unserer Heimat in den südlichen Meeren... die Siegel der Zandalar! Diese Siegel werden zum Aufwerten eines beliebigen Schultergegenstands, den Ihr besitzt, verwendet. Solltet Ihr nach Macht, Mojo oder Gelassenheit suchen - dann habe ich genau das, was Ihr braucht!nnIch gebe Euch ein Siegel Eurer Wahl im Austausch gegen fünfzehn zandalarianische Ehrenmünzen. Sobald Ihr die Münzen habt, können wir Geschäfte machen!‡당신처럼 잔달라 부족 사이에서 명성이 높은 이에게 필요한 아주 특별한 걸 내가 가지고 있지요. 바로 남쪽 바다에 있는 우리 고향에서 곧장 가져온... 잔달라 모조의 인장이랍니다! 이 인장은 당신이 소유한 어떤 어깨보호대라도 강하게 만들어 줄겁니다. 힘, 모조 그리고 평온 중 어떤 걸 찾고 있든지 당신에게 필요한 게 내게 있답니다!nn원하는 인장 하나 당 잔달라 명예 징표 15개를 받겠습니다. 징표가 준비되면 즉시 거래를 하도록 하죠!‡<nombre>, tengo algo muy especial para un exaltado como tú entre los Zandalar. Venido directamente desde nuestro hogar en los Mares del Sur... ¡las sortijas de Zandalar! Estas sortijas se utilizan para mejorar cualquier hombrera. Si deseas fuerza, mojo o serenidad, ¡tengo lo que necesitas!nnA cambio de una sortija a tu elección solo te pido 15 muestras de honor Zandalar. Si ya tienes las muestras, ¡podemos pasar al trato!‡‡Pour quelqu\'un d\'aussi honoré parmi les Zandalar que vous, <nom>, j\'ai quelque chose de très spécial. Venus tout droit de notre patrie dans les Mers du sud... les cachets des Zandalar ! Ils permettent d\'améliorer tout objet porté sur les épaules. Que vous cherchiez la puissance, le mojo ou la sérénité, j\'ai ce qu\'il vous faut !nnJe demande quinze marques d\'honneur zandalar en échange d\'un cachet de votre choix. Si vous avez les marques, faisons affaire immédiatement !‡‡',
  }
},
[8249] = {
  {
    'Precisa-se de caixas de tralhas‡Принести лари‡Plunderkisten benötigt‡보관함 수집‡Se necesitan cajas de trastos‡Se necesitan cajas de trastos‡Demande de coffrets‡垃圾箱‡垃圾箱',
    nil,
    '‡Моим разбойникам необходимо потренироваться во вскрытии замков, и мне нужны соответствующие замки. Зан делает такие, что они только зеленым новичкам годятся.nnВот что, принеси-ка мне 5 тяжелых ларей, а я дам тебе несколько лучших метательных ножей, какие только бывают у разбойников.nnТы можешь отпереть лари и порыться в них, но оставь там хотя бы несколько монеток... даже разбойнику-ученику нужна мотивация.‡Meine Schurken müssen ihre Fertigkeiten im Schlossknacken noch verbessern und ich brauche dafür noch Schlösser mit entsprechendem Schwierigkeitsgrad -- das Zeug, das Zan für uns herstellt, taugt lediglich für totale Anfänger.nnIch sag\' Euch was, wenn Ihr mir 5 schwere Plunderkisten besorgt, dann gebe ich Euch dafür die feinsten Wurfmesser, die in Schurkenkreisen bekannt sind.nnIhr könnt die Kisten öffnen und durchstöbern, aber lasst wenigstens ein paar Münzen übrig... auch ein <Klasse>, der sich in Ausbildung befindet, braucht etwas Motivation.‡‡‡‡Mes voleurs ont besoin de s\'exercer en crochetage et il me faut des serrures d\'un niveau de difficulté adéquat. Ce que Zan nous fabrique ne convient qu\'aux plus modestes néophytes.nnVous savez quoi, si vous m\'apportez 5 Coffrets lourds, je vous procurerai des couteaux de lancer parmi les meilleurs qu\'un <classe> ait jamais eu.nnVous pouvez ouvrir les coffrets et les piller, mais laissez au moins quelques pièces dedans... même un apprenti <classe> a besoin de motivation.‡我们的<class>需要练习开锁技能，因此我需要有足够挑战性的上锁的箱子——不过我们手头上的箱子难度太低，只适合那些初学者们练手。nn如果你能给我5只重垃圾箱，我就送你一把品质极佳的飞刀。nn你可以打开箱子，取出里面的东西，但是至少你得留下一点硬币……即使对训练中的<class>来说，他们也需要动力的。‡',
  }
},
[8250] = {
  {
    'Magiaria‡Магическое искусство‡Geschick der Magier‡마법 공예‡Pura magia‡Pura magia‡L\'art du mage‡法师的会见‡法師公會',
    nil,
    'Procure Sanath Lim-yo e consiga o transporte para ver o Arquimago Tauriel.‡Найдите Саната Лим-Йо и добейтесь, чтобы он доставил вас к верховному магу Ксилему.‡Sucht nach Sanath Lim-yo und verschafft Euch Zugang zu Erzmagier Xylem.‡대마법사 실렘을 만나기 위한 허가를 얻기 위해 사나스 림요를 찾아야 합니다.‡Busca a Sanath Lim-yo y obtén permiso para ver al archimago Xylem.‡Busca a Sanath Lim-yo y obtén permiso para ver al archimago Xylem.‡Trouver Sanath Lim-yo et obtenir d\'être mené à l\'archimage Xylem.‡找到萨纳斯，让他将你传送到大法师克希雷姆那儿。‡尋找薩納斯並獲得見到大法師克希雷姆的通路。',
  }
},
[8251] = {
  {
    'Pó Mágico‡Волшебная пыль‡Magischer Staub‡마법의 티끌‡El polvo mágico‡El polvo mágico‡La poussière magique‡魔法的尘埃‡魔法粉末',
    nil,
    'Leve 10 Poeiras Reluzentes para o Arquimago Tauriel.‡Принесите 10 горстей сияющей пыли верховному магу Ксилему.‡Bringt Erzmagier Xylem in Azshara 10 glitzernde Staubproben.‡대마법사 실렘에게 반짝이는 가루 10개를 가져가야 합니다.‡Llévale 10 puñados de polvo relumbrante al archimago Xylem.‡Llévale 10 puñados de polvo relumbrante al archimago Xylem.‡Procurer 10 doses de Poussière lumineuse à l\'archimage Xylem.‡为大法师克希雷姆收集10份闪光尘埃。‡為大法師克希雷姆收集10份閃光粉末。',
  }
},
[8252] = {
  {
    'Coral de sirenas‡Кораллы сирен‡Die Koralle der Sirenen‡세이렌의 산호‡El coral de las sirenas‡El coral de las sirenas‡Le corail des sirènes‡纳迦的珊瑚‡海妖的珊瑚',
    nil,
    'Obtenha 6 Corais Encantados e entregue-os ao Arquimago Tauriel.‡Соберите 6 заколдованных кораллов и принесите их верховному магу Ксилему.‡Sammelt 6 verzauberte Korallen und bringt sie zum Erzmagier Xylem.‡대마법사 실렘에게 마력 깃든 산호 6개를 가져가야 합니다.‡Reúne 6 corales encantados y llévaselos al archimago Xylem.‡Reúne 6 corales encantados y llévaselos al archimago Xylem.‡Récupérer 6 Coraux enchantés et les apporter à l\'archimage Xylem.‡收集6块魔化珊瑚，然后把它们交给大法师克希雷姆。‡收集6塊附魔珊瑚，然後把它們帶給大法師克希雷姆。',
  }
},
[8253] = {
  {
    'A destruição de Morphaz‡Уничтожить Морфаза‡Vernichtet Morphaz‡몰파즈 처치‡Destruye a Morphaz‡Destruye a Morphaz‡Détruire Morphaz‡毁灭摩弗拉斯‡消滅摩弗拉斯',
    nil,
    'Recupere o Estilhaço Arcano de posse de Morphaz e fale novamente com o Arquimago Tauriel.‡Добудьте кристалл тайной магии из брюха Морфаза и принесите его верховному магу Ксилему.‡Beschafft den arkanen Splitter von Morphaz\' Leichnam und kehrt mit ihm zu Erzmagier Xylem zurück.‡몰파즈에게서 신비의 결정을 되찾아 대마법사 실렘에게 가져가야 합니다.‡Recupera el fragmento arcano de Morphaz y llévaselo al archimago Xylem.‡Recupera el fragmento arcano de Morphaz y llévaselo al archimago Xylem.‡Récupérer le Fragment d\'arcane sur Morphaz et le rendre à l\'archimage Xylem.‡从摩弗拉斯身上取回奥术碎片，然后返回大法师克希雷姆那儿。‡從摩弗拉斯身上取回秘法裂片並返回大法師克希雷姆那兒。',
  }
},
[8254] = {
  {
    'Ajuda aos cenarianos‡Помощь Кенарию‡Cenarische Hilfe‡세나리온 의회 지원‡Ayuda a Cenarion‡Ayuda a Cenarion‡Aider le Cercle‡塞纳里奥议会的求助‡幫助塞納里奧',
    nil,
    'Encontre Ogtinc em Azshara.‡Отыщи Огтинка в Азшаре.‡Sucht Ogtinc in Azshara auf.‡아즈샤라에서 오그틴크를 찾아야 합니다.‡Busca a Ogtinc en Azshara.‡Busca a Ogtinc en Azshara.‡Chercher Ogtinc en Azshara.‡找到艾萨拉的奥汀克。‡尋找艾薩拉的奧汀克。',
  }
},
[8255] = {
  {
    'Ginetes sagrados‡Охота на беговых оленей‡Renner für einen höheren Zweck‡순록을 찾아서‡Los trotadores Pezuñamusgo‡Los trotadores Pezuñamusgo‡Courser les coursiers‡苔蹄快步者‡打獵者',
    nil,
    'Obtenha 4 Glândulas de Ginete Saudável leve-as para Ogtinc em Azshara. Ogtinc vive no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Добудьте 4 железы здорового мохоногого оленя и принесите их Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Beschafft 4 gesunde Rennerdrüsen und bringt sie zu Ogtinc in Azshara. Ihr findet ihn auf den Klippen, nordöstlich der Ruinen von Eldarath.‡건강한 순록의 분비샘 4개를 찾아 아즈샤라의 오그틴크에게 가져가야 합니다. 오그틴크는 엘다라스 폐허의 북동쪽 절벽 꼭대기에 있습니다.‡Consigue 4 glándulas de trotadores sanos y llévaselas a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Consigue 4 glándulas de trotadores sanos y llévaselas a Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Récupérer 4 Glandes de coursier en bonne santé et les apporter à Ogtinc en Azshara. Ogtinc réside au sommet des falaises, au nord-est des ruines d\'Eldarath.‡收集4份健康的野鹿腺体，把它们交给艾萨拉的奥汀克。奥汀克住在埃达拉斯废墟东北部悬崖的顶部。‡收集4份健康的野鹿腺體並把它們帶給艾薩拉的奧汀克。奧汀克住在埃達拉斯廢墟東北部懸崖的頂部。',
  }
},
[8256] = {
  {
    'A linfa de morte-viva‡Лимфа нежити‡Sekret des Untodes‡불사의 영액‡El icor de los no-muertos‡El icor de los no-muertos‡L\'ichor de non-mort‡亡灵的腐液‡亡靈腐液',
    nil,
    'Obtenha uma Linfa de Morte-viva para Ogtinc em Azshara. Ogtinc mora no alto dos penhascos a nordeste das Ruínas de Eldarath.‡Принесите лимфу нежити Огтинку в Азшару. Огтинк обитает среди скал в северо-востоку от руин Эльдарата.‡Beschafft ein Sekret des Untodes für Ogtinc in Azshara. Ihr findet ihn auf den Klippen, nordöstlich der Ruinen von Eldarath.‡아즈샤라의 오그틴크에게 불사의 영액을 가져다주어야 합니다. 오그틴크는 엘다라스 폐허 북동쪽 절벽 꼭대기에 있습니다.‡Consigue un icor de los no-muertos para Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Consigue un icor de no-muerto para Ogtinc en Azshara. Ogtinc vive en lo alto del precipicio al noreste de las Ruinas de Eldarath.‡Récupérer une dose d\'Ichor de non-mort pour le compte d\'Ogtinc en Azshara. Ogtinc réside au sommet des falaises, au nord-est des ruines d\'Eldarath.‡为艾萨拉的奥汀克带回一份亡灵腐液。奥汀克住在埃达拉斯废墟东北部悬崖的顶端。‡為艾薩拉的奧汀克帶回1份亡靈腐液。奧汀克住在埃達拉斯廢墟東北部懸崖的頂端。',
  }
},
[8257] = {
  {
    'Sangue de Morphaz‡Кровь Морфаза‡Morphaz\' Blut‡몰파즈의 피‡La sangre de Morphaz‡La sangre de Morphaz‡Le sang de Morphaz‡摩弗拉斯之血‡摩弗拉斯之血',
    nil,
    'Mate Morphaz no templo submerso de Atal\'Hakkar e leve o sangue dele para Greta Musgo no Casco na Selva Maleva. A entrada do templo submerso fica no Pântano das Mágoas.‡Убейте Морфаза в затонувшем храме Атал\'Хаккар и принесите его кровь Грете Замшелое Копыто в Оскверненный лес. Вход в храм сокрыт на болоте Печали.‡Tötet Morphaz im Versunkenen Tempel von Atal\'Hakkar und bringt Greta Mooshuf im Teufelswald sein Blut. Der Eingang zum Versunkenen Tempel liegt in den Sümpfen des Elends.‡아탈학카르 신전에서 몰파즈를 처치하고 그의 피를 악령의 숲에 있는 그레타 모스후프에게 가져다주어야 합니다. 가라앉은 신전의 입구는 슬픔의 늪에 있습니다.‡Mata a Morphaz en El Templo de Atal\'Hakkar anegado y lleva su sangre a Greta Pezuñamusgo en Frondavil. Encontrarás la entrada al Templo Sumergido en el Pantano de las Penas.‡Mata a Morphaz en El Templo Sumergido de Atal\'Hakkar y lleva su sangre a Greta Pezuñamusgo en Frondavil. Encontrarás la entrada al Templo Sumergido en el Pantano de las Penas.‡Tuez Morphaz dans le temple englouti d\'Atal\'Hakkar, et ramenez son sang à Greta Sabot-de-mousse à Gangrebois. L\'entrée du temple englouti se trouve dans le marais des Chagrins.‡前往沉没的阿塔哈卡神庙，杀死绿龙摩弗拉斯，将他的血液交给费伍德森林中的格雷塔·苔蹄。沉没的神庙的入口就在悲伤沼泽中。‡前往沉沒的神廟阿塔哈卡，殺死摩弗拉斯，將他的血液交給費伍德森林中的格雷塔·苔蹄。沉沒的神廟的入口就在悲傷沼澤。',
  }
},
[8258] = {
  {
    'A ameaça de Noctilatrus‡Угроза Темного Губителя‡Die Bedrohung durch Schattensichel‡다크리버의 위협‡La amenaza de Atracoscuro‡La amenaza de Atracoscuro‡La menace de Ravassombre‡达克雷尔的威胁‡達克雷爾的威脅',
    nil,
    'Use o Cristal Divinatório no coração do porão do Grande Ossário, em Scolomântia. Isso invocará espíritos que você precisará enfrentar. A derrota dos espíritos evocará o Cavaleiro da Morte Noctilatrus. Derrote-o.nnLeve a Cabeça de Noctilatrus para Sagorne Monta Crista, no Vale da Sabedoria, em Orgrimmar.‡Используйте кристальный предсказатель в Великом оссуарии в Некроситете. Сразитесь с духами. Когда появится Темный Терзатель, убейте его.nnПринесите голову Темного Терзателя Сагорну Гривастому Страннику на аллею Мудрости Оргриммара.‡Wendet das Orakel der Anrufung inmitten des Kellergewölbes des großen Ossuariums in Scholomance an. Ihr werdet damit Geister herbeirufen, die es zu bekämpfen gilt. Nach Vernichtung dieser Geister wird der Todesritter Schattensichel auftauchen; besiegt ihn.nnBringt Schattensichels Kopf zu Sagorne Gratläufer im Tal der Weisheit in Orgrimmar.‡스칼로맨스 대형 납골당 지하실 가운데에 예언의 탐지기를 놓으십시오. 그러면 영혼들이 나타날 것입니다. 모두 물리치면 죽음의 기사 다크리버가 나타납니다. 그를 쓰러뜨리십시오.nn오그리마 지혜의 골짜기에 있는 사고른 크레스트스트라이더에게 다크리버가 죽었다는 증거로 그의 머리카락을 가져가야 합니다.‡Usa el cristal de adivinación en el Gran Osario de Scholomance. Aparecerán espíritus con los que tendrás que luchar. Al derrotarlos se invocará el Caballero de la Muerte Atracoscuro; derrótalo. nnLleva su cabeza a Sagorne Zancresta al Valle de la Sabiduría, en Orgrimmar.‡Usa el cristal de adivinación en el corazón del sótano de El Gran Osario en Scholomance. Al hacerlo se presentarán los espíritus a los que tienes que enfrentarte. La derrota de estos espíritus invoca al caballero de la Muerte Atracoscuro, derrótalo.|nLlévale la cabeza de Atracoscuro a Sagorne Zanca Cresta en el Valle de la Sabiduría, en Orgrimmar.‡Servez-vous du Clairvoyant au centre du sous-sol du Grand ossuaire de la Scholomance. Cela attirera des esprits que vous devrez combattre. Les vaincre fera apparaître le Chevalier de la mort Ravassombre. Tuez-le.nnRamenez la Tête de Ravassombre à Sagorne Rôdeur-des-crêtes de la vallée de la Sagesse, à Orgrimmar.‡在斯坦索姆地下室的尸骨储藏所的中心使用预言水晶球。然后你必须与被召唤出来的幽灵作战。击败这些幽灵之后，死亡骑士达克雷尔才会出现，你的任务就是击败他。nn把死亡骑士达克雷尔的头颅交给奥格瑞玛智慧谷的萨格尼。‡在斯坦索姆地下室的屍骨儲藏所的中心使用預言水晶球。然後你必須與被召喚出來的幽靈作戰。擊敗這些幽靈之後，死亡騎士達克雷爾才會出現，你的任務就是擊敗他。|n把死亡騎士達克雷爾的頭顱交給奧格瑪智慧穀的薩格尼。',
  }
},
[8259] = {
  {
    'Uma recompensa mais adequada‡Более достойная награда‡Eine angemessenere Belohnung‡보다 적절한 보상‡Una digna recompensa‡Una digna recompensa‡Une récompense à la hauteur‡更合适的奖励‡更合適的獎勵',
    nil,
    nil,
  }
},
[8260] = {
  {
    'Kit de sobrevivência básico de Arathor‡Полевой комплект Лиги Аратора‡Basisüberlebenspaket von Arathor‡기본 아라소르 구급품‡Botiquín básico de Arathor‡Botiquín básico de Arathor‡Paquetage de base d\'Arathor‡阿拉索基本医疗包‡阿拉索基本醫療包',
    nil,
    '‡Ты хорошо зарекомендовала себя, Главалкаш, тут сомнений нет! В награду возьми этот пакет! В нем паек и бинты, которые можно использовать только в низине Арати.nnКогда в низине тебя еще больше зауважают, тебе их тут даже продадут. Паек мы выдаем, если относимся к кому-то дружественно, а бинты – когда уважаем.‡‡‡‡‡‡‡',
  }
},
[8261] = {
  {
    'Kit de sobrevivência padrão de Arathor‡Стандартный полевой комплект Лиги Аратора‡Standardüberlebenspaket von Arathor‡일반 아라소르 구급품‡Botiquín estándar de Arathor‡Botiquín normal de Arathor‡Paquetage ordinaire d\'Arathor‡阿拉索标准医疗包‡阿拉索標準醫療包',
    nil,
    nil,
  }
},
[8262] = {
  {
    'Kit de sobrevivência avançado de Arathor‡Улучшенный полевой комплект Лиги Аратора‡Verbessertes Überlebenspaket von Arathor‡고급 아라소르 구급품‡Botiquín avanzado de Arathor‡Botiquín avanzado de Arathor‡Paquetage amélioré d\'Arathor‡阿拉索高级医疗包‡阿拉索高級醫療包',
    nil,
    '‡Ты хорошо зарекомендовал себя, Олин, тут сомнений нет! В награду возьми этот пакет! В нем паек и бинты, которые найдешь только в лощине Боевого Клича.nnКогда в лощине тебя еще больше зауважают, тебе их тут даже продадут. Паек мы выдаем, если относимся к кому-то дружественно, а бинты – когда уважаем.‡Ihr habt zweifellos begonnen, Euch bei uns als würdig zu erweisen, <Name>. Bitte, nehmt dieses Überlebenspaket als Gegenleistung an! Ihr findet darin Rationen und Verbände, die nur innerhalb des Arathibecken verwendet werden können.nnBewährt Ihr Euch noch weiter im Arathibecken, werdet Ihr auch mehr dieser Gegenstände erwerben können. Ihr erhaltet die Rationen, wenn unsere Einstellung Euch gegenüber freundlich ist, sowie Verbände, wenn Ihr unser Wohlwollen erlangt habt.‡‡‡‡Vous avez commencé à faire vos preuves à nos yeux, <nom>. En récompense, prenez ce paquetage ! Vous y trouverez des rations et des bandages, dont vous ne pourrez vous servir que dans le bassin d\'Arathi.nnSi vous restez dans le bassin, vous finirez par avoir la possibilité d’acheter ces objets. Les rations vous seront proposées lorsque nous serons Amicaux à votre égard, et les bandages lorsque vous serez Honoré.‡‡',
  }
},
[8263] = {
  {
    'Kit de sobrevivência básico de Profanador‡Полевой комплект Осквернителей‡Basisüberlebenspaket der Entweihten‡기본 파멸단 구급품‡Botiquín básico de Rapiñador‡Botiquín básico de Rapiñador‡Le paquetage de base de profanateur‡污染者基本医疗包‡污染者基本醫療包',
    nil,
    nil,
  }
},
[8264] = {
  {
    'Kit de sobrevivência padrão de Profanador‡Стандартный полевой комплект Осквернителей‡Standardüberlebenspaket der Entweihten‡일반 파멸단 구급품‡Botiquín estándar de Rapiñador‡Botiquín normal de Rapiñador‡Le paquetage ordinaire de profanateur‡污染者标准医疗包‡污染者標準醫療包',
    nil,
    nil,
  }
},
[8265] = {
  {
    'Kit de sobrevivência avançado do profanador‡Улучшенный полевой комплект Осквернителей‡Verbessertes Überlebenspaket der Entweihten‡고급 파멸단 구급품‡Botiquín avanzado de Rapiñador‡Botiquín avanzado de Rapiñador‡Le paquetage amélioré de Profanateur‡污染者高级医疗包‡污染者高級醫療包',
    nil,
    '‡‡Ihr habt zweifellos begonnen, Euch bei uns als würdig zu erweisen, <Name>. Bitte, nehmt dieses Überlebenspaket als Gegenleistung an! Ihr findet darin Rationen und Verbände, die nur innerhalb des Arathibecken verwendet werden können.nnBewährt Ihr Euch noch weiter im Arathibecken, werdet Ihr auch mehr dieser Gegenstände erwerben können. Ihr erhaltet die Rationen, wenn Ihr unser Wohlwollen erlangt habt, sowie Verbände, wenn Ihr Euch unseren Respekt verdient habt.‡‡‡‡Vous avez commencé à faire vos preuves à nos yeux, <nom>. En récompense, prenez ce paquetage ! Vous y trouverez des rations et des bandages, dont vous ne pourrez vous servir que dans le bassin d\'Arathi.nnSi vous restez dans le bassin, vous finirez par avoir la possibilité d’acheter ces objets. Les rations vous seront proposées lorsque nous serons Amicaux à votre égard, et les bandages lorsque vous serez Honoré.‡‡',
  }
},
[8266] = {
  {
    'Fita do sacrifício‡Ленты жертвоприношения‡Aufopferungsabzeichen‡희생의 기장‡Galón de sacrificio‡Galón de sacrificio‡Les rubans de sacrifice‡奉献绶带‡奉獻綬帶',
